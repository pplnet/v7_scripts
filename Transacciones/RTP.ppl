VCAN3       : 'Retiros no Ej.' ;13;1;2;NO;;;;;;IIF(NOVACIO(ESPECIE) Y NOVACIO(CLIENTE1) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) Y NOVACIO(CUENTA1) THEN Query("SELECT SUM(Cantidad) FROM "~DBO~".MOVPENDIENTES M WHERE Cantidad<0 AND Cliente='"~CLIENTE1~"' AND Especie='"~ESPECIE~"' AND Cuenta='"~CUENTA1~"' AND Mercado='"~MERCADO1~"' AND EnteCustodia='"~VEHICULO1~"' AND "~IF(NoVacio(CUPON1),"Cupon = '"~CUPON1~"' AND","")~" NrSaldo="~FStr(VCAN1,3,0)~" and NrOperacion NOT IN (SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 T WHERE T.NrTrans=M.NrOperacion and T.CB6=1)") ELSE 0 ENDIF);;;;;'###,###,###,###.####'
VCAN7       : 'Saldo Confirm'  ;  ; ;2;NO;;;;;;IIF(NOVACIO(ESPECIE) Y NOVACIO(CLIENTE1) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) Y NOVACIO(CUENTA1) THEN SaldoC(CLIENTE1,ESPECIE,,,,MERCADO1,VEHICULO1,CUENTA1,VCAN1,FECHA1,CUPON1) ELSE 0 ENDIF) ;;;;;'###,###,###,###.####'
