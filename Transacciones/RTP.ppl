VCan4       : 'Lamina Minima'  ; ; ;2;NO;;;;;IIF(NOVACIO(ESPECIE) THEN BuscarCampo('Especies','LaminaMinima','Codigo',ESPECIE) ELSE 0 ENDIF);IIF(NOVACIO(ESPECIE) THEN BuscarCampo('Especies','LaminaMinima','Codigo',ESPECIE) ELSE 0 ENDIF)
