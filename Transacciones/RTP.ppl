Mercado1    : 'Ubicacion'      ; 4;1; ;CB6=0 y CB1=0;  ;NoVacio(MERCADO1) y [[CB1=1 y EqStr(MERCADO1,VAR('CLHODEFA'))] o CB1=0];'Debe Ingresar Un Mercado';NO;;IF(CB1=1,VAR('CLHODEFA'),MERCADO1)
Book1       : 'Book'           ; 4;2; ;;EQSTR(CLIENTE1, VAR('VEHICULODE'));Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' ")) o Not EQSTR(VEHICULO1,CLIENTE1);'Book Invalido.';NO;;;;;;;;" Vehiculo = '"~VEHICULO1~"' ";
Cliente1    : 'Cliente'        ;  ;1; ;CB6=0;  ;NoVacio(CLIENTE1);'Debe Ingresar un Cliente';NO;;
Cuenta1     : 'Cuenta'         ;  ;1; ;CB6=0;  ;NoVacio(CUENTA1) y EqStr(BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1),MERCADO1);'Debe Ingresar el Numero de Cuenta';NO;IIF(NOVACIO(CLIENTE1) Y NOVACIO(ESPECIE) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) THEN  IF(EqStr(BuscarCampo('CLIENTES','Alias1','Codigo',CLIENTE1),'CP') y EqStr(MERCADO1,'CV'),Var('CTAVEHIC'),Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and (Especies Like '%TITULO%' or Especies='"~ESPECIE~"|') and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~MERCADO1~"' and Comitente='"~VEHICULO1~"' and (Transacciones Like '%RTP%' or Transacciones is NULL or Transacciones='') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")) ELSE ' ' ENDIF);IIF(NOVACIO(CLIENTE1) Y NOVACIO(ESPECIE) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) THEN IF(INCLUIDO(CAMPOMODIFICADO,'CLIENTE1|ESPECIE|VEHICULO1|MERCADO1'),IF(EqStr(BuscarCampo('CLIENTES','Alias1','Codigo',CLIENTE1),'CP') y EqStr(MERCADO1,'CV'),Var('CTAVEHIC'),Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and (Especies Like '%TITULO%' or Especies='"~ESPECIE~"|') and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~MERCADO1~"' and Comitente='"~VEHICULO1~"' and (Transacciones Like '%RTP%' or Transacciones is NULL or Transacciones='') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")),CUENTA1)  ELSE ' ' ENDIF);;;;;;"Estado='HAB' and TipoCuenta  In ('CUS','CCO') and (Comitente='"~VEHICULO1~"' or Cliente='"~VEHICULO1~"') and Cliente='"~CLIENTE1~"' and Mercado='"~MERCADO1~"' "
VTXT10      : 'Ctas Emision'   ; 7;2; ;NO ;NO;;;;VAR('CTASEMISIO');VAR('CTASEMISIO');

Cliente3    : 'Deposit. Orig.' ; 8;1; ;CB6=0 y CB1=1;CB1=1;[CB1=1 y [EqStr(CLIENTE3,VEHICULO1) o [NoVacio(BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',CLIENTE3)) y EqStr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE3),'HAB')]]] o [CB1=0 y Vacio(CLIENTE3)];'Debe Ingresar un Depositante valido';NO;;IF(CB1=1,CLIENTE3,'');;;;;;"Status='HAB' and CodDepCajaValores IS NOT NULL"
Cliente4    : 'Depositante'    ; 9;1; ;NO;NoVacio(CLIENTE3) y EqStr(MERCADO2,VAR('CLHODEFA'));;;;IIF(NOVACIO(CLIENTE3) y EqStr(MERCADO2,VAR('CLHODEFA')) THEN BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',CLIENTE3) ELSE ' ' ENDIF) ;IIF(NOVACIO(CLIENTE3) y EqStr(MERCADO2,VAR('CLHODEFA')) THEN BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',CLIENTE3) ELSE ' ' ENDIF)
Mercado2    : 'Ubicacion'      ;10;1; ;CB1=1;CB1=1;[CB1=1 Y NoVacio(MERCADO2)] O CB1=0;'Debe Ingresar un Mercado Valido Para Transferencia';NO;VAR('CLHODEFA');;;;;;;"Observaciones Like '%T%' and IsNull(EsLiquidacion,'NO') = 'SI' "
Cliente2    : 'Cliente Destino';11;1; ;CB6=0 y CB1=1 y EqStr(CLIENTE3,VEHICULO1);[CB1=1 y EqStr(CLIENTE3,VEHICULO1)] o NoVacio(CLIENTE2);[CB1=1 Y CB2=1 Y NoVacio(CLIENTE2)] O [CB1=0 y Vacio(CLIENTE2)] o [CB1=1 y CB2=0 y Vacio(CLIENTE2)];'Debe Ingresar el Cliente ORIGEN';NO;IF(CB1=1 y CB2=1,CLIENTE2,'');IF(CB1=1 y CB2=1,CLIENTE2,'');;;;;;
Cuenta2     : 'Cuenta'         ;12;1; ;CB6=0 y CB1=1 y EqStr(CLIENTE3,VEHICULO1);[CB1=1 y EqStr(CLIENTE3,VEHICULO1)] o NoVacio(CUENTA2);[CB1=1 Y CB2=1 Y NoVacio(CUENTA2) y EqStr(BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2),MERCADO2)] O [CB1=0 y Vacio(CUENTA2)] o [CB1=1 y CB2=0 y Vacio(CUENTA2)];"Debe Ingresar el Numero de Cuenta ORIGEN de "~VAR('CLHODEFA')~" !!!";NO;IIF(NOVACIO(CLIENTE2) Y NOVACIO(CLIENTE3) Y NOVACIO(ESPECIE) THEN IF(CB1=1 y CB2=1,Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE2~"' and (Especies Like '%TITULO%' or Especies='"~IF(NoVacio(VTXT9) y Not Incluido(CUENTA1,VTXT10) y CB1=1 y CB2=1,VTXT9,ESPECIE)~"|')  and Estado='HAB' and TipoCuenta  In ('CUS','CCO') and Mercado='"~MERCADO2~"' and Comitente='"~CLIENTE3~"' and (Transacciones Like '%RTP%' or Transacciones is NULL) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "),'')   ELSE '' ENDIF);IIF(NOVACIO(CLIENTE2) Y NOVACIO(CLIENTE3) Y NOVACIO(ESPECIE) THEN IF(CB1=1 y CB2=1,IF(INCLUIDO(CAMPOMODIFICADO,'CLIENTE2|ESPECIE|MERCADO2'),Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE2~"' and (Especies Like '%TITULO%' or Especies='"~IF(NoVacio(VTXT9) y Not Incluido(CUENTA1,VTXT10) y CB1=1 y CB2=1,VTXT9,ESPECIE)~"|')  and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~MERCADO2~"' and Comitente='"~CLIENTE3~"' and (Transacciones Like '%RTP%' or Transacciones is NULL) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "),CUENTA2),'')  ELSE '' ENDIF);;;;;;"Estado='HAB' and TipoCuenta  In ('CUS','CCO') and Mercado='"~MERCADO2~"' and Cliente='"~CLIENTE2~"' and (Comitente='"~CLIENTE3~"' or Cliente='"~CLIENTE3~"') "
ComitenteExt: 'No Comit./Cta.' ;13;1; ;CB6=0 y CB1=1 y Not EqStr(CLIENTE3,VEHICULO1);CB1=1 y Not EqStr(CLIENTE3,VEHICULO1);;;;IF(CB1=1 y CB2=0,ComitenteExt,'');IF(CB1=1 y CB2=0,ComitenteExt,'');;;;;'##########';

RB1         : 'Tipo|Conformada|Diferida|Inmediata' ;18;1; ;CB6=0 y EqStr(CB1,'1') y Not EqStr(CB2,'1') y Not EqStr(VTXT1,VTXT2) y NoVacio(VTXT1) y NoVacio(VTXT2) y EqStr(MERCADO2,VAR('CLHODEFA'));EqStr(CB1,'1') y Not EqStr(CB2,'1') y Not EqStr(VTXT1,VTXT2) y NoVacio(VTXT1) y NoVacio(VTXT2) y EqStr(MERCADO2,VAR('CLHODEFA'));[Not EqStr(CB1,'1') o EqStr(CB2,'1')] o RB1>=0 o Not EqStr(MERCADO2,VAR('CLHODEFA'));'Debe Ingresar el TIPO DE TRANSFERENCIA !!!';NO;IF(EqStr(MERCADO1,VAR('CLHODEFA')),0,-1);IF(CB1=1 y CB2=0,RB1,-1)

Fecha2      : 'F.Matching'     ;14;1; ;CB6=0 y EqStr(CB1,'1') y Incluido(RB1,'1|2');EqStr(CB1,'1') y Incluido(RB1,'1|2');[Incluido(RB1,'1|2') y NoVacio(FECHA2) y FECHA2>=FECHA1 y FECHA2<=FECHA1+Var('MAXFECMATC') y EsHabil(FECHA2,'ARG')] o Vacio(FECHA2);'Error en la Fecha de Matching';NO;0;IF(RB1=1 o RB1=2, FECHA2, 0)
Fecha3      : 'F.Ejecucion'    ;14;2; ;CB6=0 y EqStr(CB1,'1') y Incluido(RB1,'1');EqStr(CB1,'1') y Incluido(RB1,'1');[Incluido(RB1,'1') y NoVacio(FECHA3) y FECHA3>=FECHA2 y FECHA3<=FECHA2+Var('MAXFECEJEC') y EsHabil(FECHA3,'ARG')] o Vacio(FECHA3);'Error en la Fecha de Ejecuci#n';NO;0;IF(RB1=1, FECHA3, 0)

Cantidad1   : 'Cantidad V.N.'  ;16;1; ;CB6=0;  ;CANTIDAD1>0;'La Cantidad en Valor Nominal debe ser Positiva';NO;CANTIDAD2/VPRE10;IF(INCLUIDO(CAMPOMODIFICADO,'CANTIDAD2'),CANTIDAD2/VPRE10,CANTIDAD1)
Cantidad2   : 'Cantidad V.R.'  ;17;1; ;CB6=0;  ;CANTIDAD2>0;'La Cantidad en Valor Residual debe ser Positiva';NO;CANTIDAD1*VPRE10;CANTIDAD1*VPRE10;;;;;'##,###,###,###.#######'

