VCAN16      : 'Can.Cpa'        ;2; ;2;NO;NO;;;;;IIF(NOVACIO(ESPECIE) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) THEN QUERY("SELECT -SUM(M.Cantidad) FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK INDEX = INDME1), "~DBO~".OPERACIONES O WHERE O.TipoOp IN ('TIC','TIFC') AND O.NrOperacion = M.NrOperacion AND M.Especie = '"~ESPECIE~"' AND M.Mercado = '"~MERCADO1~"' AND M.EnteCustodia = '"~VEHICULO1~"' AND M.NrSaldo = 31 ") ELSE 0 ENDIF);;;;;'###,###,###,###.####'
VCAN17      : 'Can.Vta'        ;4;1;2;NO;NO;;;;;IIF(NOVACIO(ESPECIE) Y NOVACIO(MERCADO1) Y NOVACIO(VEHICULO1) THEN QUERY("SELECT -SUM(M.Cantidad) FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK INDEX = INDME1), "~DBO~".OPERACIONES O WHERE O.TipoOp IN ('TIV','TIFV') AND O.NrOperacion = M.NrOperacion AND M.Especie = '"~ESPECIE~"' AND M.Mercado = '"~MERCADO1~"' AND M.EnteCustodia = '"~VEHICULO1~"' AND M.NrSaldo = 31 ") ELSE 0 ENDIF);;;;;'###,###,###,###.####'
