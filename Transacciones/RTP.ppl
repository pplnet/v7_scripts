Vehiculo1   : 'Vehiculo '      ; 2;2; ;CB6=0;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
CB1         : 'Transferencia'  ; 3;1; ;CB6=0;;;;;0
