CONDICIONES
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ESPECIE),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA1),'HAB');'La Cuenta de Retiro No esta Habilitada';NO
EqStr(BuscarCampo('Cuentas','Comitente','Codigo',CUENTA1),VEHICULO1) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA1),VEHICULO1);'La Cuenta de Retiro No Pertenece al Vehiculo';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA1),'CUS|CCO|');'La Cuenta de Retiro Debe ser una Cuenta de Custodia';NO
VACIO(CUENTA2) o EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA2),'HAB');'La Cuenta Destino No esta Habilitada';NO
VACIO(CUENTA2) o Incluido(BuscarCampo('Cuentas','TipoCuenta','Codigo',Cuenta2),'CUS|CCO|');'La Cuenta Destino Debe ser una Cuenta de Custodia';NO
Not Eqstr(CUENTA1,CUENTA2);'Las Cuentas Son Iguales';NO;
Fecha1 > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(Fecha1,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(Fecha1);SI;SI;FSYS;'FECHAVAL'
DifDias(Fecha1,Fsys,'ARG',SI)<=Var('FVALORMAX');'Fecha Valor No Puede Superar '~Var('FVALORMAX')~' Dias';NO;
[VCAN12=1 y VCAN18>=CANTIDAD1] o VCAN12=0;'Se excede el saldo de cartera propia';NO
VCAN2>=CANTIDAD1;'Cantidad de Titulos Supera el Saldo '~PYC(VCAN2,0,2);NO;
VCAN11>=CANTIDAD1;'Cantidad de Titulos Supera el Saldo '~PYC(VCAN11,0,2)~' a la fecha de hoy';NO;
