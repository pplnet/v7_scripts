CAMPOS:1; ;404
Especie        : 'Especie Orig.'       ;2;1;;NO;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y No DesciendeDeEspecie(ESPECIE,'ON');'Debe Ingresar una Especie Valida';NO;
Fecha1         : 'Record Date'         ;2;2;;NO;;FECHA1<=FSYS y EsHabil(FECHA1,'ARG');'Fecha Incorrecta';NO;FSYS;
Fecha2         : 'Fecha Pago'          ;3;2;;NO;;FECHA2 >=FECHA1 y EsHabil(FECHA2,'ARG');'Fecha Incorrecta';NO;FSYS;
Cliente1       : 'Cliente'             ;4;1;;NO;;NOVACIO(CLIENTE1) y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE), 'HAB');'Cliente Invalido';NO;
Cantidad1      : 'V.Nominal'           ;6;1;;NO;;CANTIDAD1>0;'La Cantidad debe ser Positiva';NO;
Cantidad2      : 'Total'               ;7;1;;NO;;;;;;CANTIDAD1*PRECIO1/100;
Especie1       : 'Moneda'              ;6;2;;NO;;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA');'Debe Ingresar una Moneda Valida';NO;
Precio1        : 'Porcentaje'          ;7;2;;NO;
RB1            : 'Tipo|Exterior|Local|';9;1;;NO;;;;;;0
Cuenta1        : 'Cta.Especie'        ;11;1;;NO
Cuenta2        : 'Cta.Moneda'         ;12;1;;NO
Cliente2       : 'Custodio'           ;11;2;;NO;Eqstr(CLIENTE1,VEHICULO1)

Vehiculo1      : 'Vehiculo '          ;12;2;;NO;;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')

Cantidad6      : 'W.H.T.'              ;1;1;2;NO;
Cantidad4      : 'Gastos'              ;2; ;2;NO;
Cambio1        : 'IVA Gastos'          ;3; ;2;NO;;;;;;;;;;;'##,###,###,###,###.##';
Cantidad8      : 'Total Gastos'        ;4; ;2;NO;
Especie4       : 'Moneda Arancel'      ;1;2;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cantidad5      : 'Arancel'             ;2; ;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cantidad7      : 'IVA Arancel'         ;3; ;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
TotalImpuesto1 : 'Per.Ing.Bru.'        ;4; ;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)

Cuenta3        : 'Cta.Arancel'         ;7;1;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cuenta4        : 'Cta.Pesos'           ;8;1;2;NO;
Cliente3       : 'Custodio Pesos'      ;7;2;2;NO;Eqstr(CLIENTE1,VEHICULO1)

RB8            : 'Marca Reimpresion'   ;5;1;2;NO;NO;
VTXT1: 'Oficial' ;1;1;2;NO;NO;;;;BuscarCampo('CLIENTES','OficialCuenta','Codigo',CLIENTE1);BuscarCampo('CLIENTES','OficialCuenta','Codigo',CLIENTE1)

CONDICIONES
Precio1 > 0;'El Porcentaje debe ser mayor que cero';NO
CotizacionC(Especie1,,,,Fecha1,1,SI,CotizaEn(Especie1)) <> 0;'El Precio de la Posicion de la ContraEspecie No Puede Ser Cero';NO

MOVIMIENTOS
Fecha2;Cliente1 ;Especie ;;;;BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1);IF(Not Eqstr(CLIENTE1, VEHICULO1), VEHICULO1);1;-Cantidad1;;IF(RB1=0, 'Debito de '~Especie~' por Tender Offer de '~Especie, 'Debito de '~Especie~' por Rescate de '~Especie)    ;SI;NO;;NOVACIO(CUENTA1);;Cuenta1;;1;;;NrCupon2(Especie,Fecha2);
Fecha2;Cliente1 ;Especie1;;;;BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2);IF(Not Eqstr(CLIENTE1, VEHICULO1), VEHICULO1, CLIENTE2);1; Cantidad2;;IF(RB1=0, 'Credito de '~Especie1~' por Tender Offer de '~Especie, 'Credito de '~Especie1~' por Rescate de '~Especie);SI;NO;;NOVACIO(CUENTA2);;Cuenta2;;2;
Fecha2;Cliente1 ;Especie4;;;;BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2);IF(Not Eqstr(CLIENTE1, VEHICULO1), VEHICULO1, CLIENTE2);1;-Cantidad5;;IF(RB1=0, 'Arancel por Tender Offer de '~Especie, 'Arancel por Rescate de '~Especie);;NO;;;;Cuenta3;;3;;;;;;NrTrans;

Fecha2;Cliente1 ;Var('MONELOCA');;;;BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2);IF(Not Eqstr(CLIENTE1, VEHICULO1), VEHICULO1, CLIENTE2);1;      -Cantidad6-Cantidad8;;IF(RB1=0, 'Gastos - Tender Offer '~Especie, 'Gastos - Rescate '~Especie)                        ;;NO;;;99;Cuenta4;;4;;;;;;NrTrans;
Fecha2;Cliente1 ;Var('MONELOCA');;;;BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2);IF(Not Eqstr(CLIENTE1, VEHICULO1), VEHICULO1, CLIENTE2);1; -Cantidad7-TotalImpuesto1;;IF(RB1=0, 'IVA e I.B. Arancel - Tender Offer '~Especie, 'IVA e I.B. Arancel - Rescate '~Especie);;NO;;;  ;Cuenta4;;5;;;;;;NrTrans;

POSICION
Fecha1;Cliente1 ;Especie        ;;;;Vehiculo1;;;;;1; -Cantidad1;                         Precio1;;;;VTXT1;;;NrCupon2(Especie,Fecha1);;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE);
Fecha1;Cliente1 ;Especie1       ;;;;Vehiculo1;;;;;1;  Cantidad2;Cotizacion(Especie1,,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE1);
Fecha1;Cliente1 ;Especie4       ;;;;Vehiculo1;;;;;1; -Cantidad5;Cotizacion(Especie4,,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE4);
Fecha1;Cliente1 ;VAR('MONELOCA');;;;Vehiculo1;;;;;1;      -(Cantidad6+Cantidad8);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));
Fecha1;Cliente1 ;VAR('MONELOCA');;;;Vehiculo1;;;;;1; -(TotalImpuesto1+Cantidad7);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));

Fecha2;Cliente1 ;Especie        ;;;;Vehiculo1;;;;;2;  -Cantidad1;                         Precio1;;;;VTXT1;;;NrCupon2(Especie,Fecha2);;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE);
Fecha2;Cliente1 ;Especie1       ;;;;Vehiculo1;;;;;2;   Cantidad2;Cotizacion(Especie1,,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE1);
Fecha2;Cliente1 ;Especie4       ;;;;Vehiculo1;;;;;2;  -Cantidad5;Cotizacion(Especie4,,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE4);
Fecha2;Cliente1 ;VAR('MONELOCA');;;;Vehiculo1;;;;;2;      -(Cantidad6+Cantidad8);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));
Fecha2;Cliente1 ;VAR('MONELOCA');;;;Vehiculo1;;;;;2; -(TotalImpuesto1+Cantidad7);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));

Fecha1;Vehiculo1;Especie4 ;;;;Vehiculo1;;;;;1; -Cantidad5;Cotizacion(Especie4,,,,Fecha1,1);;;;VTXT1;;Not Eqstr(Cliente1,Vehiculo1);;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE4);
Fecha2;Vehiculo1;Especie4 ;;;;Vehiculo1;;;;;2; -Cantidad5;Cotizacion(Especie4,,,,Fecha1,1);;;;VTXT1;;Not Eqstr(Cliente1,Vehiculo1);;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE4);

Fecha1;Vehiculo1;VAR('MONELOCA');;;;Vehiculo1;;;;;1; -(TotalImpuesto1+Cantidad7);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;Not Eqstr(Cliente1,Vehiculo1);;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));
Fecha2;Vehiculo1;VAR('MONELOCA');;;;Vehiculo1;;;;;2; -(TotalImpuesto1+Cantidad7);Cotizacion(VAR('MONELOCA'),,,,Fecha1,1);;;;VTXT1;;Not Eqstr(Cliente1,Vehiculo1);;;;BuscarCampo('ESPECIES','Tipo','Codigo',VAR('MONELOCA'));

CASHFLOW
Fecha2;Vehiculo1;;;       Especie1;TipoOp;;              Cantidad2;14;Eqstr(Cliente1, Vehiculo1)
Fecha2;Vehiculo1;;;VAR('MONELOCA');TipoOp;; -(Cantidad6+Cantidad8);14;Eqstr(Cliente1, Vehiculo1)

