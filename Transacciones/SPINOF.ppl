Cambio1   : 'IVA Gastos'        ;7;1;2;NO;;;;;;;;;;;'##,###,###,###,###.##';
Cantidad8 : 'Total Gastos'      ;8;1;2;NO;
Cuenta4   : 'Cta. Pesos'        ;9;1;2;NO;
Cliente3  : 'Cust. Pesos'      ;10;1;2;NO;Eqstr(CLIENTE1,VEHICULO1)

Especie4  : 'Moneda Arancel' ;4;2;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cantidad5 : 'Arancel'        ;5;2;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cantidad7 : 'IVA Arancel'    ;6;2;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)
Cuenta3   : 'Cta. Arancel'   ;9;2;2;NO;Not Eqstr(CLIENTE1,VEHICULO1)

RB8       : 'Marca Reimpresion'; ; ;2;NO;NO;

VTXT1: 'Oficial' ;1;1;2;NO;NO;;;;BuscarCampo('CLIENTES','OficialCuenta','Codigo',CLIENTE1);BuscarCampo('CLIENTES','OficialCuenta','Codigo',CLIENTE1)


LISTA:SI;5;
   Cantidad2 : 'Rel.Esp.Origen' ;;;;;;;90 ;  ;Numero;'###,###,###';
   Cantidad3 : 'Rel.Esp.Nueva'  ;;;;;;;90 ;  ;Numero;'###,###,###';
   Especie1  : 'Esp.Nueva'      ;;;;;;;90 ;SI;Tabla;'Especies';'Codigo';'Codigo;Numero';
   Cantidad1 : 'Saldo Esp.Nueva';;;;;;;100;  ;Numero;'###,###,###,###.##';
   Cliente1  : 'Custodio'       ;;;;;;;90 ;SI;Tabla;'Clientes';'Codigo';'Codigo;RazonSocial';
   Mercado1  : 'Mercado'        ;;;;;;;90 ;SI;Tabla;'Mercados';'Codigo';'Codigo;Descripcion';
   Cuenta1   : 'Cuenta'         ;;;;;;;90 ;SI;Tabla;'Cuentas' ;'Codigo';'Codigo;Numero';

MOVIMIENTOS
Fecha1 ;Cliente1 ;Especie4       ;;;;BuscarCampo('CUENTAS','Mercado','Codigo',Cuenta3);VEHICULO1                                           ;1; -Cantidad5            ;;'Arancel por Spin Off '~ESPECIE           ;SI;NO;1;;  ;Cuenta3;;2;
Fecha1 ;Cliente1 ;Var('MONELOCA');;;;BuscarCampo('CUENTAS','Mercado','Codigo',Cuenta4);IF(Not Eqstr(CLIENTE1,VEHICULO1),VEHICULO1,CLIENTE3);1; -Cantidad6-Cantidad8  ;;'Gastos por Spin Off '~ESPECIE            ;SI;NO;1;;99;Cuenta4;;3;
Fecha1 ;Cliente1 ;Var('MONELOCA');;;;BuscarCampo('CUENTAS','Mercado','Codigo',Cuenta4);IF(Not Eqstr(CLIENTE1,VEHICULO1),VEHICULO1,CLIENTE3);1; -Cantidad7            ;;'IVA e I.B. Arancel por Spin Off '~ESPECIE;SI;NO;1;;  ;Cuenta4;;4;

MOVCUOTAS
Fecha1;Cliente1;CuotasL.Especie1[Fila];CuotasL.Mercado1[Fila];If(Eqstr(Cliente1, Vehiculo1),CuotasL.Cliente1[Fila],Vehiculo1);1;CuotasL.Cantidad1[Fila];'Spin Off '~Especie1~' - '~CuotasL.Especie1[Fila];SI;NO;1;;;CuotasL.Cuenta1[Fila];;Fila+10;;;IF(Not DesciendeDeEspecie(CuotasL.Especie1[Fila],'MONEDA'),NrCupon2(CuotasL.Especie1[Fila],Fecha1))


POSCUOTAS
Fecha2;Cliente1;CuotasL.Especie1[Fila];;;;Vehiculo1;;;;;1;CuotasL.Cantidad1[Fila];CotizacionC(CuotasL.Especie1[Fila],,,,Fecha1,1,SI,CotizaEn(CuotasL.Especie1[Fila]));;;;VTXT1;;;IF(Not DesciendeDeEspecie(CuotasL.Especie1[Fila],'MONEDA'),NrCupon2(CuotasL.Especie1[Fila],Fecha1));;;BuscarCampo('ESPECIES','Tipo','Codigo',CuotasL.Especie1[Fila]);
Fecha1;Cliente1;CuotasL.Especie1[Fila];;;;Vehiculo1;;;;;2;CuotasL.Cantidad1[Fila];CotizacionC(CuotasL.Especie1[Fila],,,,Fecha1,1,SI,CotizaEn(CuotasL.Especie1[Fila]));;;;VTXT1;;;IF(Not DesciendeDeEspecie(CuotasL.Especie1[Fila],'MONEDA'),NrCupon2(CuotasL.Especie1[Fila],Fecha1));;;BuscarCampo('ESPECIES','Tipo','Codigo',CuotasL.Especie1[Fila]);


