Mercado1  : 'Casa_Custodia'  ;7;1;;NO

Vehiculo1 : 'Vehiculo'       ;9;1;1;NO
CB10      : 'Disponible'     ;9;1;1;NO;NO

Especie3  : 'Moneda Gastos'     ;4;1;2;NO;
Cantidad6 : 'W.H.T.'            ;5;1;2;NO;
