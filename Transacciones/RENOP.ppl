CAMPOS:2;;23
Fecha2           : 'Fecha Op.'       ;1;1;;NO;;FECHA2=FSYS y EsHabil(FECHA2,'ARG');'Fecha invalida';NO;FSYS
Fecha1           : 'Fecha Valor'     ;1;2;;VerificaAcceso('OPFVALOR');;FECHA1<=FSYS y EsHabil(FECHA1,'ARG');'Fecha invalida';NO;FSYS
Cantidad10       : 'Plazo Liquidacion'; ; ;;;;CANTIDAD10>=0 ;'Plazo Invalido';NO;;;;;;;'###';

Especie          :'Moneda'           ;3;1;;;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE,Especie);'Especie invalida';NO;;;;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ";
Cantidad1        :'Cantidad'         ;4;1;;;;CANTIDAD1>0 ;'Cantidad Invalida';NO

Vehiculo1        : 'Vehiculo '       ;6;1;;;  ;NoVacio(VEHICULO1);'Vehiculo invalido'     ;NO;VAR('VEHICULODE')
Mercado1         : 'Mercado '        ;6;2;;;  ;NOVACIO(MERCADO1) ;'Debe indicar Merc.Dep' ;NO;BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE);BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE);;;;;;"Observaciones like '%M%' "
Cliente1         : 'Cliente '        ;7;1;;SI;;                  ;                        ;  ;VAR('VEHICULODE'));;;;;;;
Cuenta1          : 'Cuenta  '        ;7;2;;  ;;NOVACIO(CUENTA1) Y Eqstr(BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1),MERCADO1) ;'Cuenta Destino invalida';NO;;;;;;;;" Estado='HAB' and (Especies LIKE '%"~ESPECIE~"%' or Especies LIKE '%MONEDA%') and Mercado = '"~MERCADO1~"'  and Cliente = '"~CLIENTE1~"'  "
%%ifdef MLASA
    CuentaContable1: 'Cta.Contable';8;1;;NO;NO;;;;;IF(Incluido(VTXT11,'VIS|CUS'),IF(Eqstr(ESPECIE,VAR('MONELOCA')),BuscarCampo('CUENTAS','CuentaContable1','Codigo',CUENTA1),BuscarCampo('CUENTAS','CuentaContable2','Codigo',CUENTA1)),BuscarCampo('CUENTAS','CuentaContable1','Codigo',CUENTA1));;;;;;;
%%endif
Book1: 'Book Ret';9;1;;;Eqstr(Cliente1, VAR('VEHICULODE'));NoVacio(BOOK1) o [Not Eqstr(Cliente1, VAR('VEHICULODE'))];'Book Invalido ';if(Eqstr(Cliente1, VAR('VEHICULODE')), NO, SI);VAR('BOOKCONTRA');if(Eqstr(Cliente1, VAR('VEHICULODE')),if(Vacio(BOOK1), VAR('BOOKCONTRA'), BOOK1), '');;;;;;;


ConceptoPago     :'Concepto'         ;11;1;;;;NOVACIO(CONCEPTOPAGO) ;'Concepto invalido';NO;;;;;;;;;
%%ifdef MLASA
    CuentaContable2: 'Cta.Cont.Ret';11;2;;NO;NO;;;;;BuscarCampo('CNCONCEPTOSPAGOCOBRO','CuentaContable','Codigo',CONCEPTOPAGO);;;;;;;
%%endif
CB4              :'Afecta Posicion'  ;12;1;;INCLUIDO(VTXT2,'SIE|NOE');;;;;;IF(INCLUIDO(VTXT2,'SI|SIE'),1,0) o IF(Eqstr(Cliente1, VAR('VEHICULODE')),1,0)
CB7              :'No Contabiliza'   ;  ; ;;NO;;;;;;IF(INCLUIDO(BuscarCampo('CNCONCEPTOSPAGOCOBRO','NoCont','Codigo',CONCEPTOPAGO),'SI|SIE|'),1,0);
CB10             :'Liquida MULC'     ;  ; ;;;;;;;0;

Book2: 'Book Dep';13;2;;;Eqstr(Cliente1, VAR('VEHICULODE'));NoVacio(BOOK2) o [Not Eqstr(Cliente1, VAR('VEHICULODE'))];'Book Invalido ';if(Eqstr(Cliente1, VAR('VEHICULODE')), NO, SI);VAR('BOOKCONTRA');if(Eqstr(Cliente1, VAR('VEHICULODE')),if(Vacio(BOOK2), VAR('BOOKCONTRA'), BOOK2), '');;;;;;;

CB5              :'Confirmada'       ; 3;1;2;NO;;
CB6              :'Autorizada'       ; 4;1;2;NO;;
Fecha3           :'Fecha Confirm.'   ; 3;2;2;NO;CB5=1;
Vtxt1            :'EstadoCustodia'   ; 5;1;2;NO;NO;;;;;BuscarCampo('CNCONCEPTOSPAGOCOBRO','EstadosCustodia','Codigo',CONCEPTOPAGO);;;;;;;;
Vcan1            :'EstadONrSaldo '   ;  ; ;2;NO;NO;;;;;BuscarCampo('ESTADOSCUSTODIA','NrSaldo','Codigo',VTXT1)                    ;;;;;;;;
Vcan2            :'NrSaldo '         ;  ; ;2;NO;NO;;;;;IF(VCAN1>100,VCAN1+100,1)                                                 ;;;;;;;;
Vtxt2            :'afecta'           ;  ; ;2;NO;NO;;;;;BuscarCampo('CNCONCEPTOSPAGOCOBRO','AfectaPosicion','Codigo',CONCEPTOPAGO);;;;;;;;
Precio1          : 'PrecioPos.'      ;  ; ;2;Not Eqstr(ESPECIE,VAR('MONELOCA'));;;;;;If(Not Eqstr(ESPECIE,VAR('MONELOCA')),COTIZACION(ESPECIE,,,,FECHA1-1,5,SI),1)

Vtxt11           :'Tipo Cta1'        ;  ; ;2;NO;NO;;;;;BuscarCampo('CUENTAS','TipoCuenta','Codigo',CUENTA1);;;;;;;;


CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
EspecieCuenta(ESPECIE, CUENTA1)  ;'La Moneda No Corresponde con la Cuenta de Deposito ';NO
ClienteCuenta(CLIENTE1, CUENTA1) ;'La Cuenta Deposito no corresponde al Cliente '~CLIENTE1~'.';NO
SaldoC(CLIENTE1,Especie,,,,,,Cuenta1,VCAN2,FSYS)>=Cantidad1;'Cantidad a Retirar es superior al saldo en la cuenta origen.';SI


POSTEDICION
SI;'ASIRO2';Vehiculo1=VEHICULO1;Fecha1=FECHA1;NrTrans1=NRTRANS
FECHA1<FECHA2 y CB4=1;'REVAL4';Fecha1=FECHA1;Especie1=ESPECIE

MOVIMIENTOS
Fecha1;CLIENTE1;Especie;;;;Mercado1;Vehiculo1 ;VCAN2;  -Cantidad1;;'Retiro de '~Especie~' NO OPERATIVO ';SI;NO;26;  ;;Cuenta1;;1;;;;;;;Book1

POSICION
Fecha1;Vehiculo1;Especie;;;;Vehiculo1;;;;;31;  -Cantidad1;Precio1;;;Book1;;;CB4=1;
Fecha1;Vehiculo1;Especie;;;;Vehiculo1;;;;;51;  -Cantidad1;Precio1;;;Book1;;;CB4=1;


