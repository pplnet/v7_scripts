%%endif 
Book1: 'Book Dep';12;2;;;Eqstr(Cliente1, VAR('VEHICULODE'));NoVacio(BOOK1) o [Not Eqstr(Cliente1, VAR('VEHICULODE'))];'Book Invalido ';if(Eqstr(Cliente1, VAR('VEHICULODE')), NO, SI);VAR('BOOKCONTRA');if(Eqstr(Cliente1, VAR('VEHICULODE')),if(Vacio(BOOK1), VAR('BOOKCONTRA'), BOOK1), '');;;;;;;

