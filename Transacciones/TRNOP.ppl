Mercado1         : 'Mercado Dep.'    ;10;2;;  ;  ;NOVACIO(MERCADO1) ;'Debe indicar Merc.Dep' ;NO;BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE);BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE);;;;;;"Observaciones like '%M%' "
