    SaldoC(CLIENTE2,Especie,,,,,,Cuenta2,VCAN2,FSYS)>=Cantidad1;'Cantidad a transferir es superior al saldo en la cuenta origen.';NO
%%else
    SaldoC(CLIENTE2,Especie,,,,,,Cuenta2,VCAN2,FSYS)>=Cantidad1;'Cantidad a transferir es superior al saldo en la cuenta origen.';SI
