    Cantidad11        :'Monto capital' ;15;2;;Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Cantidad11 >=0;
    Cantidad12        :'Monto comisiones' ;16;2;;Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Cantidad12 >=0;
    Cantidad13        :'Monto derechos' ;17;2;;Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Cantidad13 >=0;
