    Cantidad15        :'IVA derechos ' ;19;2;;Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Eqstr(Mercado2, VAR('MERVISTA')) Y Eqstr(Mercado1, VAR('MERCADOBT'));Cantidad15 >=0;
%%endif 
CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
