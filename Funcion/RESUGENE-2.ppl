SQL.ADD(" Select 0 ")
Recorrer&k 1, Elementos(Val(TR:1))
    SQL.ADD(" + Sum(" ~ItemLista(Val(TR:1), &k)~Val(MI:2)~'DAY'~ ") ")
Proximo
SQL.ADD(" As Day  ")
SQL.ADD(" From "~DBO~".RESULTADOS2 R ")
SQL.ADD(" Where R.Especie = '"~Val(ES:1)~"' ") 
SQL.ADD(" AND R.NrSaldo = "~Val(NR:1)~" ")
***---SQL.ADD(" AND R.TipoResultado IN ("~Pipe2Comillas(Val(TR:1))~") ")
SQL.ADD(" AND R.TipoNegocio = '"~Val(TN:1)~"' ")
SQL.ADD(" AND R.Book = '"~Val(BK:1)~"' ")
SQL.ADD(" AND R.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND R.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
*IF EQstr(Val(ES:1), 'DBGLOB')
*SQL.ADD(" Order by 1, ")
*ENDIF
Recorrer SQL
    DFA
    ACN(RS:1, fbn('Day'))
Proximo
