
* Verifico que tenga Minutas Diarias y no Minutas Mensuales
*-- Parametros de la Funcion AV1: Vehiculo1 AV2: Cliente1 AF1: Fecha AE1: Especie
SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.Cliente1,O.Especie  ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where ((O.TipoOp='TEMD' and O.FechaOp='"~IdxDate(val(af1))~"') or (O.TipoOp='TEMIND' and O.FechaVto='"~IdxDate(val(af1))~"' ) or (O.TipoOp='TEMINM' and O.FechaVto='"~IdxDate(val(af1))~"' )) ")
SQL.ADD("and O.Vehiculo1='"~VAL(AV1)~"'  and O.Cliente1='"~VAL(AV2)~"' ")
SQL.ADD("and O.Especie='"~Val(ae1)~"' ")
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT * ")
SQL.ADD("from "~DBO~".OPERACIONES Op ")
SQL.ADD("where Op.TipoOp='TEMIND' and Op.FechaOp='"~IdxDate(val(af1))~"'  ")
SQL.ADD("      and Op.Vehiculo1=O.Vehiculo1 and Op.Cliente1=O.Cliente1  and Op.Especie=O.Especie) ")
SQL.ADD("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

acn(ar1,0)
    
Recorrer SQL       
  DFA
  ACN(AH1,1)
  Message('Saldo TEMIND para Collateral Acumulado Vehiculo: '~FBN['Vehiculo1']~' ContraParte '~FBN['Cliente1']~' Especie:'~FBN['Especie']~' ...')

  *-- Parametros de la Funcion AV1: Vehiculo1 AV2: Cliente1 AF1: Fecha AE1: Especie
  (.'SALDIATER'.)

  IF Round(VAL(Z1),2)<>0
     ACN(ar1, VAL(Z1))
  Else
     ACD(AH1,0)
  EndIf
Proximo

* No encontro el Mov. Diario => Busco el Mov. Mensual
IF VAL(AH1)=0
   SQL.ADD("SELECT * ")
   SQL.ADD("from "~DBO~".OPERACIONES ")
   SQL.ADD("where TipoOp='TEMIND'  and Vehiculo1='"~VAL(AV1)~"'  and Cliente1='"~VAL(AV2)~"' ")
   SQL.ADD("and Especie='"~Val(ae1)~"' ")
   SQL.ADD("and FechaOp='"~IdxDate(Val(af1))~"'  ")
   SQL.ADD("Order By Vehiculo1,Cliente1,Especie ")

   Recorrer SQL
      DFA
      ACN(ar1, IIF(FBN['MB3']=0,-1,1)*FBN['Cantidad'])
   Proximo
EndIf
