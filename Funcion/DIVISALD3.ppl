*****************************************************************************************
** CUSTDIVI05
*****************************************************************************************
* SQL.ADD("  and  Mercado = '"~Dialogo.Vehiculo1~"'  ")


SQL.ADD(" Select S.Cliente, S.EnteCustodia, S.NrSaldo, S.Book, Sum(S.Saldo) as Saldo, S.Cuenta ")
SQL.ADD(" from "~DBO~".SALDOSDIA S")
SQL.ADD("where  S.Especie = '"~Dialogo.Especie1~"'  ")
SQL.ADD("  and  S.NrSaldo<>1 ")
***---SQL.ADD(" AND S.Saldo <> 0 ")
SQL.ADD("  and  S.Fecha=(Select Max(Fecha) as Fe from "~DBO~".SALDOSDIA S1")
SQL.ADD("                where  S1.Especie = S.Especie  and ")
SQL.ADD("                S1.Cliente = S.Cliente  and ")
***---SQL.ADD("                S1.EnteCustodia = S.EnteCustodia  and ")
SQL.ADD("                ((S1.EnteCustodia = S.EnteCustodia) OR (S1.EnteCustodia is null AND S.EnteCustodia is null) OR(S1.EnteCustodia = '' AND S.EnteCustodia = '')) AND ")
SQL.ADD("                ((S1.Book = S.Book) OR (S1.Book is null AND S.Book is null) OR(S1.Book = '' AND S.Book = '')) AND ")
SQL.ADD("                S1.NrSaldo = S.NrSaldo  and ")
SQL.ADD("                Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("group by Cliente, EnteCustodia, NrSaldo, Book, Cuenta")
SQL.ADD("order by Cliente, EnteCustodia, NrSaldo, Book")
Recorrer SQL

  Message('Saldos '~fbn['Cliente']~' '~fbn['EnteCustodia']~' '~Fstr(fbn['NrSaldo'],0,0))

  act(a:fac,fbn['Cliente'])
  act(b:fac,'SALDO '~Fstr(fbn['NrSaldo'],0,0))
  act(c:fac,Fbn['Cliente'])
  acn(d:fac, fbn['Saldo'])
  acn(n:fac,fbn['NrSaldo'])
  act(l:fac,fbn['Book'])
  ACT(CC:fac, fbn('Cuenta'))

  If val(d:fac)<>0
     *** Calcula imoprtes de dividendos ***
     (."CALCDIVI2".)
     acn(e:fac,val(ae:fac))
     acn(f:fac,val(af:fac))
  Else 
     dfa
  Endif
Proximo