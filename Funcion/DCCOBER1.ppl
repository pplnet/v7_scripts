*--- DPCOBER1
***--- Chequeo las barreras 
IF EqStr(val(z8),'0')
   *---- CALL
   IF Eqstr(Val(z14),'3')
      *-- Down&Out -> PrecioReal >=Knock
      IF val(pc2)>=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'2')
      *-- Down&In -> PrecioReal<=Knock
      IF val(pc2)<=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'1')
      *-- Up&Out -> PrecioReal <=Knock
      IF val(pc2)<=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'0')
      *-- Up&In -> PrecioReal >=Knock
      IF val(pc2)>=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
ELSE 
   *---- PUT
   IF Eqstr(Val(z14),'3')
      *-- Down&Out -> PrecioReal >=Knock
      IF val(pc2)>=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'2')
      *-- Down&In -> PrecioReal<=Knock
      IF val(pc2)<=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'1')
      *-- Up&Out -> PrecioReal <=Knock
      IF val(pc2)<=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
   IF Eqstr(Val(z14),'0')
      *-- Up&In -> PrecioReal >=Knock
      IF val(pc2)>=val(z12)
         acn(&j+1:fac,val(z9))
      ENDIF
   ENDIF
ENDIF
