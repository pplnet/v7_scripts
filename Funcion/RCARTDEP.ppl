ACT(da:0, 'DA Oper Vig.')
ACT(de:0, 'DE NMV')
ACT(df:0, 'DF P&L R')
ACT(dg:0, 'DG P&L NR')

ACT(dm:0, 'DM Oper Venc.')
ACT(ds:0, 'DS P&L R')

************************************
* Time Deposits Vigentes
************************************
SQL.ADD("Select O.NrOperacion, O.TipoOp,   O.Especie,  O.FechaOp,   ")
SQL.ADD("       O.FechaVto,    O.Cantidad, O.Cliente1, O.Vehiculo1, ")
SQL.ADD("       CASE O.Especie When 'ARP'   Then '0' Else '1' End Tipo1, ")
SQL.ADD("       CASE O.TipoOp  When 'MMCPM' Then '0' Else '1' End Tipo2, ")
SQL.ADD("       '0' Tipo3 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B")
SQL.ADD(" where O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.Book1     =  B.Codigo ")
SQL.ADD("   and O.TipoOp    In ('MMCPM','MMCCR') ")
SQL.ADD("   and O.Especie   in ('ARP','USD') ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie    = '"~Dialogo.Especie1~"' ")
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif

SQL.ADD(" Union ALL ")

************************************
* Time Deposits Vencidos
************************************
SQL.ADD("Select O.NrOperacion, O.TipoOp,   O.Especie,  O.FechaOp,   ")
SQL.ADD("       O.FechaVto,    O.Cantidad, O.Cliente1, O.Vehiculo1, ")
SQL.ADD("       CASE O.Especie When 'ARP'   Then '0' Else '1' End Tipo1, ")
SQL.ADD("       CASE O.TipoOp  When 'MMCPM' Then '0' Else '1' End Tipo2, ")
SQL.ADD("       '1' Tipo3 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B")
SQL.ADD(" where O.FechaVto  < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto  >=  '"~IdxDate(Val(r:7))~"' ")
SQL.ADD("   and O.Book1     =  B.Codigo ")
SQL.ADD("   and O.TipoOp    In ('MMCPM','MMCCR') ")
SQL.ADD("   and O.Especie   in ('ARP','USD') ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie    = '"~Dialogo.Especie1~"' ")
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif

SQL.ADD(" order by Tipo1, Tipo2, Tipo3, O.NrOperacion ")
recorrer SQL
  if Val(z:4)=0
    if EqStr(fbn('Tipo1'),'0')
      ACT(a:FAC, 'TIME DEPOSIT ARP')
      ACT(p:FAC, 'ARP')
    else
      ACT(a:FAC, 'TIME DEPOSIT USD')
      ACT(p:FAC, 'USD')
    endif
    ACN(q:FAC, 0)
    ACN(r:FAC, 3)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 1)
    ACN(y:4, FAC)
    ACN(s:1, FAC)
    IFA
    if EqStr(fbn('Tipo2'),'0')
      ACT(a:FAC, Pad('',5)~'Plazo Fijo')
      ACT(i:FAC, 'MMCPM')
      ACN(q:FAC, 1)
    else
      ACT(a:FAC, Pad('',5)~'Remuneradas')
      ACT(i:FAC, 'MMCCR')
      ACN(q:FAC, 2)
    endif
    ACT(p:FAC, Val(p:FAC-1))
    ACN(r:FAC, 3)
    ACN(s:FAC, 1)
    ACN(t:FAC, 2)
    ACN(v:FAC, 2)
    ACN(z:FAC, 1)
    ACN(l:FAC, Val(s:1))
    IFA
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, fbn('Tipo2'))
  endif
  if Not EqStr(fbn('Tipo1'),Val(v:2))
    if EqStr(fbn('Tipo1'),'0')
      ACT(a:FAC, 'TIME DEPOSIT ARP')
      ACT(p:FAC, 'ARP')
    else
      ACT(a:FAC, 'TIME DEPOSIT USD')
      ACT(p:FAC, 'USD')
    endif
    ACN(q:FAC, 0)
    ACN(r:FAC, 3)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 1)
    ACN(s:1, FAC)
    IFA
    if EqStr(fbn('Tipo2'),'0')
      ACT(a:FAC, Pad('',5)~'Plazo Fijo')
      ACT(i:FAC, 'MMCPM')
      ACN(q:FAC, 1)
    else
      ACT(a:FAC, Pad('',5)~'Remuneradas')
      ACT(i:FAC, 'MMCCR')
      ACN(q:FAC, 2)
    endif
    ACT(p:FAC, Val(p:FAC-1))
    ACN(r:FAC, 3)
    ACN(s:FAC, 1)
    ACN(t:FAC, 2)
    ACN(v:FAC, 2)
    ACN(z:FAC, 1)
    ACN(l:FAC, Val(s:1))
    IFA
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, fbn('Tipo2'))
  endif
  if EqStr(fbn('Tipo2'),Val(v:3))
    DFA
  else
    if EqStr(fbn('Tipo2'),'0')
      ACT(a:FAC, Pad('',5)~'Plazo Fijo')
      ACT(i:FAC, 'MMCPM')
      ACN(q:FAC, 1)
    else
      ACT(a:FAC, Pad('',5)~'Remuneradas')
      ACT(i:FAC, 'MMCCR')
      ACN(q:FAC, 2)
    endif
    ACT(p:FAC, Val(p:FAC-1))
    ACN(r:FAC, 3)
    ACN(s:FAC, 1)
    ACN(t:FAC, 2)
    ACN(v:FAC, 2)
    ACN(z:FAC, 1)
    ACN(l:FAC, Val(s:1))
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, fbn('Tipo2'))
  endif

  SCN(z:4, 1)
  if EqStr(fbn('Tipo3'),'0')
    SCN(z:5, 1)

    ACT(da:Val(z:5), fbn('NrOperacion'))
    ACT(db:Val(z:5), fbn('TipoOp'))
    ACT(dc:Val(z:5), fbn('Especie'))
    LinkearHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
    ACN(dd:Val(z:5), LinkH(1,az:6))
    ACN(de:Val(z:5), LinkH(1,k:Val(dd:Val(z:5))))
    ACN(df:Val(z:5), LinkH(1,m:Val(dd:Val(z:5))))
    ACN(dg:Val(z:5), LinkH(1,l:Val(dd:Val(z:5))))
*    CerrarHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)

    * Net Market Value
    SCN(b:FAC, Val(de:Val(z:5)))
    * Res. Realizado
    SCN(d:FAC, Val(df:Val(z:5)))
    * Res. NO Realizado
    SCN(e:FAC, Val(dg:Val(z:5)))
    * Totales
    SCN(t:1,   Val(de:Val(z:5)))
    SCN(t:2,   Val(df:Val(z:5)))
    SCN(t:3,   Val(dg:Val(z:5)))

    * Aculuma Nivel 1
    SCN(b:Val(l:FAC), Val(de:Val(z:5)))
    SCN(d:Val(l:FAC), Val(df:Val(z:5)))
    SCN(e:Val(l:FAC), Val(dg:Val(z:5)))

    SCN(j:FAC, 1)
    SCN(k:FAC, fbn('Cantidad'))
  else
    SCN(z:6, 1)
    ACT(dm:Val(z:6), fbn('NrOperacion'))
    ACT(dn:Val(z:6), fbn('TipoOp'))
    ACT(do:Val(z:6), fbn('Especie'))
    ACD(dp:Val(z:6), fbn('FechaOp'))
    ACD(dq:Val(z:6), fbn('FechaVto'))
    if Incluido(fbn('TipoOp'),'MMCCR|MMCP')
      ACN(dr:Val(z:6), BuscarCampo('OPERACIONES','TotalIntereses','NrOperacion',fbn('NrOperacion')))
      ACN(ds:Val(z:6), BuscarCampo('OPERACIONES','TotalIntereses','NrOperacion',fbn('NrOperacion'))*CotizacionC(Val(do:Val(z:6)),,,,fbn('FechaVto')-1,1,SI,Val(r:2)))
    else
      SQL.ADD("SELECT Cantidad3 as Interes, Fecha2 ")
      SQL.ADD("  FROM "~DBO~".CUOTAS ")
      SQL.ADD(" WHERE NrOperacion =  '"~val(dm:Val(z:6))~"' ")
      SQL.ADD("   and Fecha2      >= '"~IdxDate(Val(r:7))~"' ")
      Recorrer SQL
         dfa
         SCN(dr:Val(z:6), FBN['Interes'])
         SCN(ds:Val(z:6), FBN['Interes']*CotizacionC(Val(do:Val(z:6)),,,,FBN['Fecha2']-1,1,SI,Val(r:2)))
         SCN(dt:Val(z:6), 1)
      Proximo
    endif

    * Res. Realizado
    SCN(d:FAC, Val(ds:Val(z:6)))
    * Totales
    SCN(t:2,   Val(ds:Val(z:6)))
    * Aculuma Nivel 1
    SCN(d:Val(l:FAC), Val(ds:Val(z:6)))
  endif

proximo

if Val(z:5)>0
  SetFont(da:1..dg:Val(z:5),1)
  FormatoCeldas(de:1..dg:Val(z:5),Exe('F2'))
endif
if Val(z:6)>0
  SetFont(dm:1..dz:Val(z:6),1)
  FormatoCeldas(dd:1..df:Val(z:4),Exe('F2'))
endif
