ACT(a:fac, 'Codigo de persona')
ACT(a:fac+1, '  F. Fisica          ')
ACT(a:fac+2, '  J. Juridica        ')
If EqStr(val(z1),'F')
   ACT(a:fac+1,val(a:fac+1)~val(z1))
else
   ACT(a:fac+2,val(a:fac+2)~val(z1))
endif

ACT(a:fac+3, 'Numero de ')
ACT(a:fac+4, 'condomino a     '~IIF(val(az3)=0,'',FStr(val(az3),0,0)))
ACT(a:fac+5, 'modificar')
SetFont(a:fac..a:fac+5,2)
AgregarMarco(a:fac..a:fac,2,0)
AgregarMarco(a:fac..a:fac+2,2,0)
AgregarMarco(a:fac+3..a:fac+5,2,0)

ACT(b:fac, 'Apellido (s) y Nombre (s) o Razon Social')
ACT(b:fac+1, val(z2))

ACT(b:fac+3, '           Calle                     Numero       ')
ACT(c:fac+3, '           Piso                      Dpto ')
ACT(b:fac+4, '           '~val(z3)~'                                  '~val(z17))

ACT(a:fac+6, 'Localidad')
ACT(b:fac+6, '           Pcia       Pais       Codigo Postal')
ACT(c:fac+6, 'Codigo de Nacionalidad')
ACT(d:fac+6, 'CUIT')

ACT(a:fac+7, val(z4))
ACT(b:fac+7,'             '~val(z16)~'           '~val(z5)~'              '~val(z8))
ACT(c:fac+7, val(z18))
ACT(d:fac+7, val(z6))

SetFont(b:fac..b:fac,2)
SetFont(b:fac+3..c:fac+3,2)
SetFont(a:fac+6..d:fac+6,2)
SetFont(a:fac+7..d:fac+7,1)
AgregarMarco(b:fac..d:fac,2,0)
AgregarMarco(b:fac..d:fac+3,2,0)
AgregarMarco(b:fac+3..d:fac+3,2,0)
AgregarMarco(b:fac+3..d:fac+6,2,0)
AgregarMarco(a:fac+6..d:fac+6,2,0)
AgregarMarco(a:fac+7..d:fac+7,2,0)

SetFilaActual(fac+8)

ACT(a:fac, 'Documento de Identidad')
ACT(a:fac+1, 'Tipo      Numero        Exp')
ACT(a:fac+2, val(z14)~'         '~val(z15))

ACT(b:fac, 'Inscripcion Registro Publico de Comercio')
ACT(b:fac+1, 'Numero              Folio      ')
ACT(b:fac+2, '   '~val(z9)~'                        '~val(z10))

ACT(c:fac+1, 'Libro     T         Lugar')
ACT(c:fac+2, '   '~val(z11)~'         '~val(z12)~'           '~val(z13))

SetFont(a:fac..c:fac+2,2)
SetFont(a:fac+2..c:fac+2,1)
AgregarMarco(a:fac..a:fac+2,2,0)
AgregarMarco(b:fac..d:fac,2,0)
AgregarMarco(a:fac..d:fac+2,2,0)
AlinearCeldas(b:fac..b:fac,'C')

SetFilaActual(fac+3)
ACT(a:fac, 'Dato')
ACT(a:fac+1, 'Registral')
ACT(b:fac, 'Tipo               Numero')

SetFont(a:fac..b:fac+1,2)
AgregarMarco(a:fac..a:fac+1,2,0)
AgregarMarco(b:fac..b:fac,2,0)
AgregarMarco(a:fac..d:fac+1,2,0)

SetFilaActual(fac+3)
ACN(t1,fac+3)