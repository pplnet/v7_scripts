   ****** NO MUESTRA SALDO DE TITULOS CLAUDIA 07.12
SQL.ADD(" UNION ALL ")

*--- Saldos de Bonos Propios 
SQL.ADD("SELECT 2 as Orden,'TIT_EMITIDOS_'+S.Especie As NrOperacion,SUM(S.Saldo) as CapIni,E.FEmision as FechaIni,E.Fecha as VtoFinal,S.Cliente as Cliente1,S.Cliente+' '+S.Book as Vehiculo1,S.Especie,A.FechaCorte as FechaVto,A.FechaCorte as FechaOp,'Titulo' as TipoOp,")
SQL.ADD(" (SUM(S.Saldo)*A.PorAmCapital/100) as Importe, (SUM(S.Saldo)*(A.PorAmCapital+A.PorRenta)/100)  as  ImporteVto, ")
SQL.ADD(" SUM(S.Saldo) as Cantidad,0 as Spread,  ")
SQL.ADD(" A.PorRenta Tasa, CASE E.DiasAnio WHEN 360 THEN 0 ELSE 1 END as RB8, 0 as Plazo,E.SType as TipoTasa,A.PorAmCapital PorAmor,E.Issue as PrecioRef,0 as TotalIntereses,0 as PlazoTot") 
SQL.ADD("FROM "~DBO~".SALDOSDIA S,"~DBO~".ESPECIES E,"~DBO~".AGENDACUPONES A ")
SQL.ADD("WHERE A.Especie = E.Codigo AND  A.FechaCorte >= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(val(li1))
  SQL.ADD(" and  S.EnteCustodia In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
  SQL.ADD(" and  S.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
SQL.ADD("AND S.Especie = E.Codigo and E.Alias7=S.Book ")
SQL.ADD("AND S.NrSaldo =3 AND A.TipoCupon In ('REN','RYA','AMO')  ")
SQL.ADD("AND S.Fecha=( ")
SQL.ADD("SELECT Max(S1.Fecha)  ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1")
SQL.ADD("WHERE S1.Cliente = S.Cliente ")
SQL.ADD("AND S1.Especie = S.Especie ")
SQL.ADD("AND S1.Book  = S.Book   ")
SQL.ADD("AND S1.Mercado = S.Mercado ")  
SQL.ADD("AND S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("AND S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("AND S1.Cuenta  = S.Cuenta")
SQL.ADD("AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")  
SQL.ADD("AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
SQL.ADD("AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))")
SQL.ADD("AND S1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("GROUP BY S.Especie,E.FEmision,E.Fecha,S.Cliente,S.Cliente+' '+S.Book,S.Especie,A.FechaCorte,A.PorRenta,E.DiasAnio,E.SType,A.PorAmCapital,E.Issue")
SQL.ADD("HAVING SUM(S.Saldo)<>0")
IF val(ra6)>0
   SQL.ADD("Union All")
   * Titulos por Mark To Model
   *--- Saldos de Bonos de Terceros que no sean Emisiones
   SQL.ADD("SELECT 2 as Orden,'TIT_TERC_'+S.Especie As NrOperacion,SUM(S.Saldo) as CapIni,E.FEmision as FechaIni,E.Fecha as VtoFinal,S.Cliente as Cliente1,S.Cliente+' '+S.Book as Vehiculo1,S.Especie,A.FechaCorte as FechaVto,A.FechaCorte as FechaOp,'Titulo' as TipoOp,")
   SQL.ADD(" (SUM(S.Saldo)*A.PorAmCapital/100) as Importe, (SUM(S.Saldo)*(A.PorAmCapital+A.PorRenta)/100)  as  ImporteVto, ")
   SQL.ADD(" SUM(S.Saldo) as Cantidad,0 as Spread,  ")
   SQL.ADD(" A.PorRenta Tasa, CASE E.DiasAnio WHEN 360 THEN 0 ELSE 1 END as RB8, 0 as Plazo,E.SType as TipoTasa,A.PorAmCapital PorAmor,E.Issue as PrecioRef,0 as TotalIntereses,0 as PlazoTot") 
   SQL.ADD("FROM "~DBO~".SALDOSDIA S,"~DBO~".ESPECIES E,"~DBO~".AGENDACUPONES A  ")
   SQL.ADD("WHERE A.Especie = E.Codigo AND  A.FechaCorte >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("AND S.Especie = E.Codigo and  (E.Alias7<>S.Book   OR E.Alias7 is null or E.Alias7='' or E.Alias7=' ')")
   If NoVacio(val(li1))
      SQL.ADD(" and  S.EnteCustodia In ("~Pipe2Comillas(val(li1))~") ")
   EndIf
   If NoVacio(val(li3))
      SQL.ADD(" and  S.Especie In ("~Pipe2Comillas(val(li3))~") ")
   EndIF
   SQL.ADD("AND S.Especie = E.Codigo ")
   SQL.ADD("AND S.NrSaldo =3 AND A.TipoCupon In ('REN','RYA','AMO')  ")
   SQL.ADD("AND S.Fecha=( ")
   SQL.ADD("SELECT Max(S1.Fecha)  ")
   SQL.ADD("FROM "~DBO~".SALDOSDIA S1")
   SQL.ADD("WHERE S1.Cliente = S.Cliente ")
   SQL.ADD("AND   S1.Especie = S.Especie ")
   SQL.ADD("AND   S1.Mercado = S.Mercado ")
   SQL.ADD("AND   S1.EnteCustodia = S.EnteCustodia ")
   SQL.ADD("AND   S1.NrSaldo = S.NrSaldo  ")
   SQL.ADD("AND   S1.Cuenta  = S.Cuenta   ")
   SQL.ADD("AND   S1.Book  = S.Book   ")
   SQL.ADD("AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
   SQL.ADD("AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
   SQL.ADD("AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))") 
   SQL.ADD("AND   S1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("GROUP BY S.Especie,E.FEmision,E.Fecha,S.Cliente,S.Cliente+' '+S.Book,S.Especie,A.FechaCorte,A.PorRenta,E.DiasAnio,E.SType,A.PorAmCapital,E.Issue")
   SQL.ADD("HAVING SUM(S.Saldo)<>0")
Else 
   SQL.ADD("Union All")
   *--- Mark to Market y Otros
   *--- Saldos de Bonos de Terceros que no sean Emisiones
   SQL.ADD("SELECT 2 as Orden,'TIT_TERC_'+S.Especie As NrOperacion,SUM(S.Saldo) as CapIni,E.FEmision as FechaIni,E.Fecha as VtoFinal,S.Cliente as Cliente1,S.Cliente+' '+S.Book as Vehiculo1,S.Especie,E.Fecha  as FechaVto,E.FEmision as FechaOp,'Titulo' as TipoOp,")
   SQL.ADD(" SUM(S.Saldo)*E.VTeorico as Importe, SUM(S.Saldo)*E.VTeorico  as  ImporteVto, ")
   SQL.ADD(" SUM(S.Saldo) as Cantidad,0 as Spread,  ")
   SQL.ADD(" 0 Tasa, CASE E.DiasAnio WHEN 360 THEN 0 ELSE 1 END as RB8, 0 as Plazo,E.SType as TipoTasa,0 PorAmor,E.Issue as PrecioRef,0 as TotalIntereses,0 as PlazoTot") 
   SQL.ADD("FROM "~DBO~".SALDOSDIA S,"~DBO~".ESPECIES E, "~DBO~".BOOKS B")
   SQL.ADD("WHERE S.Especie = E.Codigo  ")
   SQL.ADD(" AND S.Especie = E.Codigo and  (E.Alias7<>S.Book   OR E.Alias7 is null or E.Alias7='' or E.Alias7=' ') ")
   If NoVacio(val(li1))
      SQL.ADD(" and  S.EnteCustodia In ("~Pipe2Comillas(val(li1))~") ")
   EndIf
   If NoVacio(val(li3))
      SQL.ADD(" and  S.Especie In ("~Pipe2Comillas(val(li3))~") ")
   EndIF
   SQL.ADD("AND S.NrSaldo =3   ")
   SQL.ADD("AND S.Fecha=( ")
   SQL.ADD("SELECT Max(S1.Fecha)  ")
   SQL.ADD("FROM "~DBO~".SALDOSDIA S1")
   SQL.ADD("WHERE S1.Cliente = S.Cliente ")
   SQL.ADD("AND   S1.Especie = S.Especie ")
   SQL.ADD("AND   S1.Mercado = S.Mercado ")
   SQL.ADD("AND   S1.EnteCustodia = S.EnteCustodia ")
   SQL.ADD("AND   S1.NrSaldo = S.NrSaldo  ")
   SQL.ADD("AND   S1.Cuenta  = S.Cuenta   ")
   SQL.ADD("AND   S1.Book  = S.Book   ")
   SQL.ADD("AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
   SQL.ADD("AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
   SQL.ADD("AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))") 
   SQL.ADD("AND   S1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("GROUP BY E.VTeorico,S.Especie,E.FEmision,E.Fecha,S.Cliente,S.Cliente+' '+S.Book,S.Especie,E.FEmision,E.Fecha,E.DiasAnio,E.SType,E.Issue")
   SQL.ADD("HAVING SUM(S.Saldo)<>0")
EndIf
ENDIF
