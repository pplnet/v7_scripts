SQL.ADD("Select  1 as Orden,             O.NrOperacion, ")
SQL.ADD("        O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END as CapIni, ")
SQL.ADD("        O.FechaOp as FechaIni, ")
SQL.ADD("        O.FechaEx4 as VtoFinal, O.Cliente1, O.Vehiculo1, O.Contrato as Especie, ")
*SQL.ADD("        O.FechaEx4 , O.FechaOp, O.TipoOp, ")
SQL.ADD("        O.FechaEx4 as FechaVto, O.FechaOp,  O.TipoOp, ")
SQL.ADD("        O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END  Importe, ")
SQL.ADD("        O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END  AS ImporteVto, ")
SQL.ADD("        O.Cantidad as Cantidad, 0 as Spread, O.Precio1 Tasa, ")
SQL.ADD("        O.RB8,                  O.Plazo, ")
SQL.ADD("        CASE O.MB4 WHEN 0 THEN 'Equities' WHEN 1 THEN 'Commodities' WHEN 2 THEN 'Fix Income' WHEN 3 THEN 'Currencies' WHEN 4 THEN 'Indices' WHEN 5 THEN 'Tasas' ELSE 'EuroDolar' END as TipoTasa, ")
SQL.ADD("        100 as PorAmor, ")
SQL.ADD("        O.PrecioRef,            O.TotalIntereses, O.Plazo AS PlazoTot")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
SQL.ADD(" where O.Cliente1 = CL.Codigo ")
SQL.ADD(" AND O.PrecioRef Is Not Null ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaEx4>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoOp='MRF' ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

