CONDICIONES

EV o [FECHAOP>= Habiles(FSys,-Var('FVALORACC'),'ARG')];'Operacion Ingresada con Fecha Valor';NO;SI;FSYS;'FVALOR'
EV o EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La especie No esta Habilitada';NO
EV o Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EV o Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO
EV o [BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)<>0 y [CANTIDAD  Mod2(BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0]] o BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)=0;'La Cantidad debe ser Multiplo de Lamina Minima';NO
EV o PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Precio Fuera de Rango: '~FSTR((PRECIO4*(1-VAR('RPRECIO2')/100)),1,7)~' y '~FSTR((PRECIO4*(1+VAR('RPRECIO2')/100)),1,7);NO
EV o VCAN1=0 o [Not Incluido(Mercado,VAR('MERCARGC')) y VCAN1=1];'No Puede Liquidar por ArgenClear un Cliente !!!';NO
BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'La Cartera seleccionada no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO

EV o PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'PRECIO FUERA DE RANGO: '~FSTR((PRECIO4*(1-VAR('RPRECIO') /100)),1,7)~' y '~FSTR((PRECIO4*(1+VAR('RPRECIO') /100)),1,7);SI;SI;FSYS;'RANGOPRECI'
