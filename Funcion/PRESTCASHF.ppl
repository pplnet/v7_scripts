MostrarCuadroDeMensajes
Message('Prestamos CashFlow F ')
SCN(f:200,1)
ACT(ck2,VAR('MONEEXTR'))

SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD(" C.Cantidad4/1000 Cant, C.Cantidad3/1000 Int, (C.Cantidad5 - C.Cantidad3)/1000 Imp, ")
SQL.ADD(" C.NrCuota,C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMONM','MMFIMV') ")
SQL.ADD(" and  O.MB2 = '1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD(" Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN O.TotalComisiones/1000 ELSE 0 END Imp, ")
SQL.ADD(" C.NrCuota,C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMONM', 'MMFIMV') ")
SQL.ADD(" and  O.MB2 = '1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN O.Cantidad/1000 ELSE  O.TotalBrutoCli2/1000 END Cant, O.TotalIntereses/1000 Int, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN (O.TotalComisiones + O.TotalAux3 + O.ImporteImp) ELSE (O.TotalNetoCli2 - O.TotalIntereses) END/1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') and O.MB2='1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD(" Cantidad/1000 Cant, 0 as Int, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN TotalComisiones/1000 ELSE 0 END Imp, 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') ")
SQL.ADD(" and  O.MB2 = '1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD(" C.Cantidad4/1000 Cant, C.Cantidad3/1000 Int, (C.Cantidad5 - C.Cantidad3)/1000 Imp, ")
   SQL.ADD(" C.NrCuota,C.Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMONM','MMFIMV') ")
   SQL.ADD(" and  O.MB2 = '1' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN O.TotalComisiones/1000 ELSE 0 END Imp, ")
   SQL.ADD(" C.NrCuota,C.Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMONM', 'MMFIMV') ")
   SQL.ADD(" and  O.MB2 = '1' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN O.Cantidad/1000 ELSE O.TotalBrutoCli2/1000 END Cant, O.TotalIntereses/1000 Int, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN (O.TotalComisiones + O.TotalAux3 + O.ImporteImp)/1000 ELSE (O.TotalNetoCli2 - O.TotalIntereses)/1000 END Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD(" where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') and O.MB2='1' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD(" Cantidad/1000 Cant, 0 as Int, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN TotalComisiones/1000 ELSE 0 END Imp, 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD(" where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') ")
   SQL.ADD(" and  O.MB2 = '1' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif

SQL.ADD(" Union All ")
SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD(" 0 as Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN (C.Importe1 + C.Importe3 + C.Precio2) ELSE C.Importe4 END/1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" O.TipoOp In ('MMONM','MMFIMV','MMON','MMFRNP') and  O.MB2='1' ")
SQL.ADD(" ) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD(" 0 as Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN (C.Importe1 + C.Importe3 + C.Precio2) ELSE C.Importe4 END/1000 Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ( ")
   SQL.ADD(" O.TipoOp In ('MMONM','MMFIMV','MMON','MMFRNP') and  O.MB2='1' ")
   SQL.ADD(" ) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
SQL.ADD("order by 1, 2,4,6 ")

Recorrer SQL
   * message(FBN('Tipo')~' '~Fstr(FBN['Cant'],0,2)~' '~FBN['Fecha'])
   *ACT(ck3,SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Val(ck2)~"' "))
    
*   If EqStr(Val(ck3),'INV')
*      ACN(ck2,1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))
*   Else 
*      ACN(ck2,Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))
*   Endif
     
   ACN(ck2, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   ACN(MT:11, 0)
   ACN(MT:1, FBN('Cant'))
   ACN(MT:2, FBN('Int'))
   ACN(MT:3, FBN('Imp'))
    
   If Dialogo.Radio10 = 1 y FBN['Precio2']=0 
      ACT(NT:1, fbn('NrOperacion'))
      (.'MONTOTOMV'.)
   Endif
   
   If Dialogo.Check1 = 1
      SCN(MT:11, Val(MT:1) * Val(CK:2))
   Endif
   If Dialogo.Check2 = 1
      SCN(MT:11, Val(MT:2) * Val(CK:2))
   Endif
   If Dialogo.Check3 = 1
      SCN(MT:11, Val(MT:3) * Val(CK:2))
   Endif
   If Dialogo.Radio2 = 0
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo       
         ACT(af:201,FBN['NrOperacion'])
      Else     
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
      Endif
   Else
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo       
         ACT(af:201,FBN['NrOperacion'])
      Else
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         If Val(o:200)>0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(f:200), Val(MT:11))
               SCN(Val(p:200)+1:Val(i:200), Val(MT:11))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(f:200), Val(MT:11))
            SCN(Val(g:200):Val(i:200), Val(MT:11))
         Endif
      Endif
   Endif
Proximo
