RB14      : 'Tipo Prest|Prestamo|Colocacion';19;1;1;NO    ;CB13=1;;;;;IF(CB13=1 y NoVacio(NROPERACION5),IF(EqStr(TIPOOP,'MMPCCM'),BuscarCampo('OPERACIONES','MB3','NrOperacion',NROPERACION5),0),-1)
VFEC7             : 'Fecha Vto Cta'         ;19;2;1;NO    ;CB13=1;;;;;IF(CB13=1 y NoVacio(NROPERACION5),QUERY("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion='"~NROPERACION5~"' and NrCuota="~FStr(CUOTAS1,1,0)~" "),0)
