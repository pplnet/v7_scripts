*- z10 Cliente
*- z11 Concepto
*- z12 NrMinuta
*- z13 Leyenda
*- z14 Especie
*- z16 NrOperacion

*- FLAGS z1,z2,z3,z4

recorrer SQL
  if Dialogo.radio8 = 1
       *- Uso az1 como flag, si az1 = 1 => Cambio de minuta
       *-                    si az1 = 0 => Sigue la misma minuta
       IF Not EqStr(FBN['NrMinuta'], Val(Z12))
           ACN(az1,1)
       else
           ACN(az1,0)
       endif
  endif

  If Not EqStr(FBN['Cliente'], Val(Z10)) o Not EqStr(FBN['Leyenda'], Val(Z13)) o Not EqStr(FBN['Especie'], Val(z14)) o Val(az1) = 1 o Not EqStr(FBN['NrOperacion'], Val(Z16))

     *if [[[Dialogo.radio8 = 0  y Dialogo.radio6 = 1] o [Dialogo.radio1 = 0 y Dialogo.radio6 = 0]] y [Not EqStr(FBN['Leyenda'], Val(Z13)) o Not EqStr(FBN['Especie'], Val(z14)) o Not EqStr(FBN['Cliente'], Val(Z10))]]
     if [[Dialogo.radio8 = 0  o Dialogo.radio9 = 0 o [Dialogo.radio1 = 0 y Dialogo.radio6 = 0]] y [Not EqStr(FBN['Leyenda'], Val(Z13)) o Not EqStr(FBN['Especie'], Val(z14)) o Not EqStr(FBN['Cliente'], Val(Z10))]]
         *- Consulta por Neto
         if Val(z1) <> 0
             ACT(f:FAC, 'Total Concepto')
             ACN(g:FAC, Val(z5))
             SCN(az3, Val(z5))
             FormatoCeldas(g:FAC,Exe('F2'))
             *SetFont(f:FAC,2)
             ACN(z5,0)
             ifa
         else
             ACN(z1,1)
         endif
     endif

     *if [Dialogo.radio9 = 1 o Dialogo.radio1 = 2 y Dialogo.radio6 = 0] y [Not EqStr(FBN['NrOperacion'], Val(Z16)) o Not EqStr(FBN['Especie'], Val(z14))]
      if [Dialogo.radio9 = 1 o [Dialogo.radio1 = 2 y Dialogo.radio6 = 0]] y [Not EqStr(FBN['NrOperacion'], Val(Z16)) o Not EqStr(FBN['Especie'], Val(z14))]
         *- Consulta por  Operacion - Cliente
         if Val(z2) <> 0
             ACT(f:FAC, 'Total Concepto')
             ACN(g:FAC, Val(z5))
             SCN(az3, Val(z5))
             *SetFont(f:FAC,2)
             FormatoCeldas(g:FAC,Exe('F2'))
             ACN(z5,0)
             ifa
         else
             ACN(z2,1)
         endif
     endif

     if Not EqStr(FBN['Cliente'], Val(Z10)) o Not EqStr(FBN['Especie'], Val(z14)) o Val(az1) = 1
         if Val(Z3)<>0
              ACT(f:FAC, 'Total '~IIF(Dialogo.radio8 = 1,Val(Z12),Val(z10)))
              ACN(g:FAC, IIF(Dialogo.radio8 = 1,Val(z5),Val(az3)))
              SetFont(a:FAC..h:FAC,2)
              FormatoCeldas(g:FAC,Exe('F2'))
              if Dialogo.radio8 = 1
                  *- Minuta
                  SCN(az4,Val(z5))
                  ACN(z5,0)
                  if Not EqStr(FBN['Cliente'], Val(Z10))
                          SetFilaActual(FAC+1)
                  endif
              else 
                  SetFilaActual(FAC+2)
                  SCN(az4,Val(az3))
                  ACN(az3,0)
              endif
         else
              ACN(Z3,1) 
         endif
     endif

     if Not EqStr(FBN['Especie'], Val(z14))
        ******** Corte por Especie
        if Val(z4) <> 0 
            if Dialogo.radio8 = 1
                 *- Minuta
                 ifa
                 ACT(e:FAC, ' TOTAL '~IIF(Val(az4) < 0,'Retirar','Depositar')~' '~Val(Z12)~' '~Val(z14)) 
             else
                 ACT(e:FAC, ' TOTAL '~IIF(Val(az4) < 0,'Retirar','Depositar')~' '~Val(z14))
             endif
            *** Imprimo total de especie
            ACN(g:FAC,Val(az4))
            SetFont(d:FAC..g:FAC,2)
            FormatoCeldas(g:FAC,Exe('F2'))
            ACN(az4,0)
            SetFilaActual(FAC+2)
        else
            ACN(z4,1)
        endif
        ACT(a:FAC,FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     endif
     SetFont(a:fac..d:FAC,2)


     if Not EqStr(FBN['Concepto'], Val(Z11)) o  Not EqStr(FBN['Cliente'], Val(Z10)) o Not EqStr(FBN['Especie'], Val(z14)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9)
        ACT(b:FAC, FBN['Cliente'])
        ACT(c:FAC,Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente']),1,28))
     endif
    
     *if Not EqStr(FBN['Concepto'], Val(Z11)) o Not EqStr(FBN['Cliente'], Val(Z10)) o Not EqStr(FBN['Especie'], Val(z14)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9)
     *   act(d:fac,'BOLSA' )
     *endif

     If Not Incluido('MONEDA',Ascendientes('ESPECIES',FBN['Especie'])) 
        if Dialogo.Radio10 = 1
           act(d:fac,'BOLSA')
        else
           act(d:fac,'EXTRA') 
        endif
     EndIf
     
     if Dialogo.radio6 = 1 y Dialogo.radio8 = 1
        *- Agente-Minuta
        if Not EqStr(FBN['NrMinuta'], Val(Z12)) o Not EqStr(FBN['Especie'], Val(z14))
               ACT(c:FAC+1,FBN['NrMinuta']~' '~FBN['TipoMinuta']~' '~FBN['EspecieMinuta']~' '~FBN['ContraEspecie'])
               SetFont(c:fac+1..d:FAC,2)
               ACLM(c:FAC+1,FBN['NrMinuta'])
               SetFilaActual(FAC+2)
        endif
     endif 

     ACT(z14,FBN['Especie'])
     ACD(Z8,FBN['FechaEj'])
     ACN(z9,FBN['PrecioEj'])
     ACT(Z10,FBN['Cliente'])
     ACT(Z11,FBN['Concepto'])
     if Dialogo.radio8 = 1
           ACT(Z12,FBN['NrMinuta'])
     endif
     ACT(Z13,FBN['Leyenda'])
     ACT(z16,FBN['NrOperacion'])
  endif

  If [Not Incluido('MONEDA',Ascendientes('ESPECIES',FBN['Especie'])) y Dialogo.Radio10=1] o Dialogo.Radio10<>1   
     ACT(e:FAC,Copy(BuscarCampo('Mercados','Descripcion','Codigo',FBN['Mercado']),1,15))
  EndIf
  ACN(f:fac, FBN['Cantidad'])
  ACT(h:FAC,FBN['Leyenda'])
  ACT(i:FAC,FBN['Cuenta2'])
  ACT(j:FAC,Copy(BuscarCampo('Cuentas','Nombre','Codigo',FBN['Cuenta2']),1,15))
  ACT(k:fac, FBN['TipoOp'])
  ACT(i:fac, FBN['NrOperacion'])
  ACLO(i:fac, FBN['NrOperacion'])
  ACD(j:FAC,FBN['FechaMov'])
  ACT(k:fac,iif([Incluido(FBN['Concepto'],'MMPF|MMPFCE') y EqStr(fbn['MB4'],'0') y fbn['FechaMov'] = fbn['FechaVto']],'Cert. en Poder del Cliente NO se Confirma',' '))
  ColorCeldas(k:fac,clBlue)
  SCN(z5,FBN['Cantidad'])
  SetFont(d:fac..k:FAC,1)
  FormatoCeldas(f:fac..f:FAC,Exe('F2')) 
proximo

IF VAL(Z3)<>0
    ifa
    ACT(f:FAC, 'Total Concepto')
    ACN(g:FAC, Val(z5))
    SCN(az3, Val(z5))
    FormatoCeldas(g:FAC,Exe('F2'))
    ifa
    
    ACT(f:FAC, 'Total '~IIF(Dialogo.radio8 = 1,Val(Z12),Val(z10)))
    ACN(g:FAC, IIF(Dialogo.radio8 = 1,Val(z5),Val(az3)))
    SetFont(a:FAC..h:FAC,2)
    FormatoCeldas(g:FAC,Exe('F2'))
    if Dialogo.radio8 = 1
         SCN(az4,Val(z5))
    else 
         SCN(az4,Val(az3))
    endif
    ifa
    if Dialogo.radio8 = 1
        ACT(e:FAC, ' TOTAL '~IIF(Val(az4) < 0,'Retirar','Depositar')~' '~Val(Z12)~' '~Val(z14)) 
    else
        ACT(e:FAC, ' TOTAL '~IIF(Val(az4) < 0,'Retirar','Depositar')~' '~Val(z14))
    endif
    ACN(g:FAC,Val(az4))
    SetFont(e:FAC..g:FAC,2)
    FormatoCeldas(g:FAC,Exe('F2'))
ENDIF



ACO(1,5)
ACO(2,7)
ACO(3,18)
ACO(4,6)
ACO(5,9)
ACO(6,9)
ACO(7,9)
ACO(8,15)
ACO(9,7)
ACO(10,7)
ACO(11,19)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
LimitesVision(k:FAC)
SetPrintFit(3,90)
RangoTitulo(a:1..k:fac+1, val(vx8))
