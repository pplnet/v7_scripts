*Codigo Robado a AleAlongi ...
** Generar Archivo Vacio si el proximo dia es feriado

acd(xx1,Dialogo.Fecha1)
acd(xx2, Habiles(Dialogo.Fecha1,1,'ARG'))
*
**** envejece hasta el proximo dia habil local
acd(xx1, val(xx1)+1)


ACT(ab1,'')

Repetir

 if val(xx1) < val(xx2)
             
 AbrirASCII(EXE('PATHX')~'XCP-'~Fecha(val(xx1),'yyyymmdd')~VAL(xx3),0)
    IF Not Ok
       Cancelar('No se pudo abrir el archivo '~EXE('PATHX')~'XCP-'~Fecha(val(xx1),'yyyymmdd')~VAL(xx3))
    Endif
    EscribirASCII(Val(ab1))       
    CerrarASCII
    acd(xx1, val(xx1)+1)
 else
   Break
 endif

Proximo
