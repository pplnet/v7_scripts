***---IT:1 Devuelve el interes
***---CT:1 Cotizacion de la especie, en $ si cotiza en $ o en U$S si no cotiza en $
***---CT:2 Cotizacion de la moneda en que cotiza la especie, en $ si cotiza en $ o en U$S si no
***---cotiza en $
***---SL:1 saldo de la especie
***---EA:2 especie

SQL.ADD(" Select P.PrecioFin ")
SQL.ADD(" From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Especie = '"~Val(EA:2)~"' ") 
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND P.NrSaldo = 101 ")
SQL.ADD(" AND P.TipoNegocio = 'FC' ")
SQL.ADD(" AND P.Fecha = (Select Max(Fecha) From "~DBO~".POSICIONES S ")
SQL.ADD("                Where S.Especie = P.Especie ")
SQL.ADD("                AND S.Vehiculo = P.Vehiculo ")
SQL.ADD("                AND S.NrSaldo = P.NrSaldo ")
SQL.ADD("                AND S.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                AND S.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")

Recorrer SQL
    ACN(PF:1, fbn('PrecioFin'))
Proximo
*messagebox(Val(sl1)~'* ('~Val(ct1)~'- ('~Val(pf1)~'*'~Val(ct2)~'))')
ACN(IT:1, Abs(Val(SL:1) * (Val(CT:1) - (Val(PF:1)*Val(CT:2)))))
*messagebox(Val(IT1))