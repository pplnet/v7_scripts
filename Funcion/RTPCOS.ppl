acn(u:fac,IIF(FBN['RB6']=0,((val(j:fac)*FBN['OPrecio2']*FBN['Plazo'])/IIF(FBN['RB5']=0,36000,36500)),0))
acn(t:fac,IIF(FBN['RB6']=0, FBN['ImpComCor1']+val(u:fac), 0))
acn(p:fac,val(j:fac)*(val(aw:fac)/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)*(FBN['TotalAux1']/100))
acn(o:fac,val(j:fac)*((FBN['Spread']+val(l:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1) )
acn(q:fac,(val(j:fac)*(val(av:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)*(FBN['ImpGastos2']/100))
acn(ad:fac,val(t:fac)^IIF(EqStr(FBN['Check1'],'1'),1,-1)*FBN['TCComCor1'])
acn(v:fac,IIF(FBN['RB6']=0,val(o:fac)*(FBN['TasaImp1']/100),0) )
acn(x:fac,val(t:fac)*(FBN['IntDevengados1']/100))
acn(ab:fac,val(p:fac)+val(o:fac)+val(t:fac)+val(v:fac))
acn(z:fac,val(j:fac)+val(o:fac))
acn(aa:fac,val(j:fac)+val(ab:fac))


*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')

