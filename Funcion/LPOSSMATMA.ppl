*- Limites de Posicion MATURITY MAXIMA
SQL.ADD("Select Sum(P.CantidadFin) as Cantidad from "~DBO~".POSICIONES P")
SQL.ADD("where P.NrSaldo ="~VAL(ab1)~" ")
SQL.ADD("and P.Especie = '"~fbn('Codigo')~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and P.Vehiculo in ("~Val(z11)~")")
endif
SQL.ADD("and P.Fecha = (Select Max(O.Fecha) from "~DBO~".POSICIONES O")
SQL.ADD("    where O.Especie = '"~fbn('Codigo')~"'")
SQL.ADD("    and O.NrSaldo = P.NrSaldo ")
SQL.ADD("    and O.Vehiculo = P.Vehiculo")
SQL.ADD("    and O.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("group by Vehiculo")
SQL.ADD("Having Round(Sum(P.CantidadFin),2)<>0 ")
Recorrer SQL
  dfa
  SCN(z1, fbn('Cantidad'))
Proximo

Message('Saldo '~fbn('Codigo')~' '~Fstr(val(z1),0,0) )