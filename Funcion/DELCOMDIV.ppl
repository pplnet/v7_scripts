IF Incluido('EJE',Dialogo.String1) Y Incluido('PEN',Dialogo.String1)
    ***---Borro todas las comisiones
    SQL.ADD(" Delete From "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Where NrOperacion = '"~Val(N:&i)~"' ")
    SQL.ADD(" AND Cliente = '"~Val(G:&i)~"' ")
    SQL.ADD(" AND Concepto= '"~Val(Z:6)~"' ")
    SQL.ADD(" AND Mercado = '"~Val(P:&i)~"' ")
    SQL.ADD(" AND NrSaldo = 4 ")
    SQL.NEW
    SQL.ADD(" Delete From "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion = '"~Val(N:&i)~"' ")
    SQL.ADD(" AND Cliente = '"~Val(G:&i)~"' ")
    SQL.ADD(" AND Concepto= '"~Val(Z:6)~"' ")
    SQL.ADD(" AND Mercado = '"~Val(P:&i)~"' ")
    SQL.ADD(" AND NrSaldo = 4 ")
    SQL.NEW
ENDIF
IF Incluido('EJE',Dialogo.String1) Y Not Incluido('PEN',Dialogo.String1)
    ***---Paso comisiones a pendientes
    SQL.ADD(" Insert Into "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Select * From "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion = '"~Val(N:&i)~"' ")
    SQL.ADD(" AND Cliente = '"~Val(G:&i)~"' ")
    SQL.ADD(" AND Concepto= '"~Val(Z:6)~"' ")
    SQL.ADD(" AND Mercado = '"~Val(P:&i)~"' ")
    SQL.ADD(" AND NrSaldo = 4 ")
    SQL.NEW
    SQL.ADD(" Update "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Set FechaEje = Null ")
    SQL.ADD(" Where NrOperacion = '"~Val(N:&i)~"' ")
    SQL.ADD(" AND Cliente = '"~Val(G:&i)~"' ")
    SQL.ADD(" AND Concepto= '"~Val(Z:6)~"' ")
    SQL.ADD(" AND Mercado = '"~Val(P:&i)~"' ")
    SQL.ADD(" AND NrSaldo = 4 ")
    SQL.NEW
    SQL.ADD(" Delete From "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion = '"~Val(N:&i)~"' ")
    SQL.ADD(" AND Cliente = '"~Val(G:&i)~"' ")
    SQL.ADD(" AND Concepto= '"~Val(Z:6)~"' ")
    SQL.ADD(" AND Mercado = '"~Val(P:&i)~"' ")
    SQL.ADD(" AND NrSaldo = 4 ")
    SQL.NEW
ENDIF