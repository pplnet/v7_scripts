SQL.ADD("SELECT M.FechaMov, M.NrMov, M.NrOperacion, M.Especie, M.EnteCustodia, M.Cantidad, M.Cliente, M.Leyenda, O.TipoOp, 'No Aplicado' Estado, ")
SQL.ADD(" C.RazonSocial, V.Descripcion, I.String23, I.Fecha3 ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".IMPUESTOS I")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion ") 
SQL.ADD(" AND C.Codigo = M.Cliente")
SQL.ADD(" AND V.Codigo = M.EnteCustodia") 
SQL.ADD(" AND O.NrOperacion = I.NrOperacion ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Var('OPEIMPUEST'))~") ")
SQL.ADD(" AND NrMov Not IN (SELECT Plazo4 FROM "~DBO~".IMPUESTOS I WHERE I.NrOperacion = M.NrOperacion)")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" And M.EnteCustodia In ("~Pipe2Comillas(val(xx:3))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and M.EnteCustodia in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  EndIf
EndIf

If NoVacio(Dialogo.Book1)
  SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"'")  
EndIf
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND M.Especie = '"~Dialogo.Especie1~"'")
EndIf
***---Excluyo los movimientos de impuestos
SQL.ADD(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
***---No se toma el alta del prestamo (NrMov=1)
SQL.ADD(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")

SQL.ADD(" UNION ")

SQL.ADD("SELECT M.FechaMov, M.NrMov, M.NrOperacion, M.Especie, M.EnteCustodia, M.Cantidad, M.Cliente, M.Leyenda, O.TipoOp, 'No Aplicado' Estado, ")
SQL.ADD(" C.RazonSocial, V.Descripcion, I.String23, I.Fecha3 ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".IMPUESTOS I")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND C.Codigo = M.Cliente")
SQL.ADD(" AND V.Codigo = M.EnteCustodia")  
SQL.ADD(" AND O.NrOperacion = I.NrOperacion ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Var('OPEIMPUEST'))~") ")
SQL.ADD(" AND M.NrMov Not IN (SELECT Plazo4 FROM "~DBO~".IMPUESTOS I WHERE I.NrOperacion = M.NrOperacion)")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" And M.EnteCustodia In ("~Pipe2Comillas(val(xx:3))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and M.EnteCustodia in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  EndIf
EndIf

If NoVacio(Dialogo.Book1)
  SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"'")  
EndIf

If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND M.Especie = '"~Dialogo.Especie1~"'")
EndIf
***---Excluyo los movimientos de impuestos
SQL.ADD(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
***---No se toma el alta del prestamo (NrMov=1)
SQL.ADD(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")