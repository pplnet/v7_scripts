SQL.ADD("Union")
SQL.ADD(" Select O.Vehiculo1 As Clave,O.Especie,C.Fecha1 Vto,C.Importe1 Importe,O.NrOperacion, ")
SQL.ADD(" Tipo,O.TipoOp,'COMISIONES' as DescImp,2 as BD1, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMP   ' THEN 'BUYERS' WHEN 'MMPORI' THEN 'PARTIDAS' WHEN 'MMSCMV' THEN 'PRESTAMOS SINDICADOS' ")
SQL.ADD(" WHEN 'MMFCMV' THEN 'F.R.N. / YANKEE' WHEN 'MMPSC ' THEN 'PRESTAMOS SINDICADOS' WHEN 'MMFRN ' THEN 'F.R.N. / YANKEE' END ")
SQL.ADD(" Grupo, O.Cliente1, O.FechaOp, O.FechaVto, ' ' as MarcaSwap,O.OperacionRef, O.FechaOp2, ")
SQL.ADD(" '' Inicio,'' Fin,O.TipoTasa,1 Tasa,0 NrCuota,' ' Pata ")
SQL.ADD("from "~DBO~".COMISIONES2 C,"~DBO~".OPERACIONES O ")
SQL.ADD("where O.NrOperacion=C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
 SQL.ADD("AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
 SQL.ADD("AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~")")
ENDIF
IF NoVacio(Dialogo.Lista2)
 SQL.ADD("AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~")")
ELSE
 SQL.ADD("AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~")")
ENDIF
if NoVacio(Dialogo.Cliente1)
 SQL.ADD("and O.Cliente1='"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
 SQL.ADD("and O.Especie='"~Dialogo.Especie1~"'")
endif
SQL.ADD("and O.TipoOp In ('MMP','MMPORI','MMSCMV','MMFCMV','MMPSC','MMFRN') ")
SQL.ADD("and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and C.Fecha1 >='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("AND C.Fecha1 >='"~IdxDate(Dialogo.Fecha2)~"'")
IF Dialogo.Fecha3 <> 0
 SQL.ADD("AND C.Fecha1<= '"~IdxDate(Dialogo.Fecha3)~"'")
ENDIF
***---Todas las Cabeceras toman las <> a 3 y 5 y los items todas las comisiones generadas menos
***--- las 5 (EF)
SQL.ADD(" and C.Tipo <> '5' ")
SQL.ADD(" and C.Tipo <> '3' ")
SQL.ADD("AND C.Importe1 > 0")
