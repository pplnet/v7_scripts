ACN(CK:1, 0)
IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
   ACN(CK:1, 1)
   IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrTrans2 = '"~val(NT:1)~"' AND Modelo = '"~&codAsi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~Val(VH:1)~"' "))
       ACN(CK:1, 0)
   ENDIF
ENDIF
IF Val(CK:1) = 0
    If No Vacio(VAL(NR:1))
      Message(val(NR:1)~' - Modelo: '~&codAsi)
    Else
      Message(val(NR:2)~' - Modelo: '~&codAsi)
    EndIf

    **Este bloque es para los fbn de las formulas del modelo
    SQL.ADD("Select '"~val(VH:1)~"' as Vehiculo1, '"~&cliente~"' as Cliente, '"~val(SL:1)~"' as NrSaldo, '"~val(CE:1)~"' as ContraEspecie, ")
    SQL.ADD("'"~val(ME:1)~"' as MonedaEmision, '"~val(TE:1)~"' as TipoEspecie, '"~val(EP:1)~"' as Especie, '"~val(IS:1)~"' as Issuer, ")
    SQL.ADD("'"~val(CL:1)~"' as Cliente1, '"~val(BK:1)~"' as Book1,'TIC' as TipoOp, '"~val(CU:1)~"' as CuentaCustodia,'"~val(CO:1)~"' as Concepto ")
    Recorrer SQL 
     SQL.GenerarAsientoOp(&codAsi, val(NR:1),'','',Val(NA:1),Val(FV:1),Val(VH:1),,,,,,val(TI:1),,val(NR:2),,,,,fsys,Dialogo.Fecha1)              
     SQL.EXEC
    Proximo
ENDIF