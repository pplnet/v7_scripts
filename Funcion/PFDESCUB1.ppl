*- vi1: Vigentes=1 , Todos los Settements=0
*- vf1: Los que no estan vigentes pero vencieron en ese mes

*- MMDC  Descubiertos en Cuenta Corriente
If Dialogo.Radio3 = 1 
   SQL.ADD("Select O.Vehiculo1, 'Descubiertos' Grupo, O.NrOperacion, O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
Else
   SQL.ADD("Select 'Consolidado' Vehiculo1, 'Descubiertos' Grupo, O.NrOperacion, O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
EndIf


SQL.ADD("O.RB8,O.FechaVto,O.FechaEx1 FechaSett,O.TipoTasa,O.PrecioRef,O.Spread,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,  ")
SQL.ADD("O.PrecioEj ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O Where ")
SQL.ADD(" O.TipoOp In ('MMDC') ")
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vf1)=1     
   *- Que Vencen en ese mes aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf

SQL.ADD(" ) ")

If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

If Dialogo.Radio1 = 1
  If NoVacio(Dialogo.Vehiculo1)   
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  Else
    IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
  EndIf
Else
  IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  ENDIF
EndIf

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
