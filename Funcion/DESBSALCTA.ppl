#ifdef BIND
    require '..\lib\IntegracionBIND.dll'

    import ServCuenta, 'IntegracionBIND.ServiciosBT'
    let &ServicioCuenta new ServCuenta(GetDataBase())


    let &Cuenta &ServicioCuenta.Desbloquear(""~Val(RR:12)~"",""~Val(RR:13)~"",""~Val(RR:15)~"")

    ACT(RR:117,&Cuenta.Respuesta)
    if EqStr(Val(RR:117),'OK')
        ACT(RR:1,'OK')
    else
        ACT(RR:1,'NOK')
        ACT(RR:2,&Cuenta.Error)
        MessageBox("No se pudo realizar desbloqueo de saldo Error: "~&Cuenta.Error)
    endif

    if  SQL("Select Count(*) from dbo.MOVCTASEXT where IdReferencia ='" ~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"'") = 0
        
        SQL.ADD("insert into dbo.MOVCTASEXT values('O','"~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"',")
        SQL.ADD("case when '"~Copy(TRIM(Val(rr:10))~TRIM(Val(rr:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41)),1,2)~"'='OR' then 'O' else 'V' end,")
        SQL.ADD("'"~Val(RR:12)~"','DB','"~&Cuenta.Respuesta~"','"~&Cuenta.Estado~"',")
        SQL.ADD("'"~&Cuenta.FechaRequerimiento~"','"~&Cuenta.HoraRequerimiento~"','"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("'"~&Cuenta.SucursalCuenta~"','"~&Cuenta.Moneda~"','"~&Cuenta.Modulo~"','"~&Cuenta.TipoOperacion~"',")
        SQL.ADD("'"~Val(RR:13)~"',"~Val(RR:15)~",'"~&Cuenta.IdProceso~"',NULL,'"~&Cuenta.Relacion~"','"~&Cuenta.Transaccion~"',")
        SQL.ADD("NULL,'"~&Cuenta.Error~"')")
    else
        SQL.ADD("update dbo.MOVCTASEXT set RespSistExt='"~&Cuenta.Respuesta~"',")
        SQL.ADD("Accion='DB',")
        SQL.ADD("Estado='"~&Cuenta.Estado~"',")
        SQL.ADD("FechaEnv='"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("HoraEnv='"~&Cuenta.HoraRequerimiento~"',")
        SQL.ADD("FechaValor='"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("Suscursal='"~&Cuenta.SucursalCuenta~"',")
        SQL.ADD("Moneda='"~&Cuenta.Moneda~"',")
        SQL.ADD("Modulo='"~&Cuenta.Modulo~"',")
        SQL.ADD("TipoOperacion='"~&Cuenta.TipoOperacion~"',")
        SQL.ADD("SubOperacion='"~Val(RR:13)~"',")
        SQL.ADD("IdRespuesta='"~&Cuenta.IdProceso~"',")
        SQL.ADD("Relacion='"~&Cuenta.Relacion~"',")
        SQL.ADD("Transaccion='"~&Cuenta.Transaccion~"',")
        SQL.ADD("DetalleError='"~&Cuenta.Error~"',")
        SQL.ADD("Importe="~Val(RR:15))
        SQL.ADD("Where IdReferencia='" ~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"'")
        
    endif
    SQL.NEW
    SQL.EXEC
#endif

