
SQL.ADD("SELECT Distinct M.NrSaldo, M.Cuenta, M.Mercado, M.EnteCustodia, M.CallPut, M.FechaEj, ")
SQL.ADD("       M.PrecioEj, M.Cliente, M.Cantidad, M.FechaMov,M.NrOperacion, ")
SQL.ADD("       C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
*SQL.ADD("WHERE M.EnteCustodia = '"~Dialogo.Vehiculo1~"' and M.NrSaldo=1 and ")
SQL.ADD("WHERE M.EnteCustodia IN ("~Pipe2Comillas(&vehiculos)~") and M.NrSaldo=1 and ")
SQL.ADD("      M.Especie='"~VAL(b2)~"' AND ")
SQL.ADD("      M.Cupon = '"~FSTR(VAL(c2),1,0)~"' AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.FechaMov > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("ORDER BY M.NrSaldo, M.Cliente ")

SetFilaActual(99)
ACN(z:1, 0)

Recorrer SQL
  ACN(x1, -fbn('Cantidad'))

  Message(fbn('Cliente')~' '~VAL(b2)~' '~FBN['Mercado']~' '~FBN['Cuenta']~' '~Fstr(val(x1),0,2)  )

  IF Val(x1)<>0
     ACT(a:fac, fbn('Cliente'))
     ACT(b:fac, Val(b2))
     ACT(c:fac, FStr(VAL(c2),1,0))
     ACT(d:fac, fbn('Mercado'))
     ACT(f:fac, fbn('Cuenta'))
     ACT(h:fac, fbn('NrOperacion'))
     ACN(g:fac, Val(x:1))
     ACN(k:fac, 1)
     ACT(l:fac, '')
     ACT(ve:fac, fbn('EnteCustodia'))
     ACN(z:1, 1)
     ***---Chequeo si paga con Pik
     ACN(PW:fac, SQL(" Select PorPIK From "~DBO~".AGENDACUPONES Where Especie = '"~Val(B:2)~"' AND NrCupon = "~Fstr(Val(C:2), 0, 0)~" "))
     IF Val(PW:fac) > 0
        ACN(PK:fac, Val(X:1) * Val(PW:fac) / 100)
     ENDIF
  ELSE
     dfa
  ENDIF
Proximo

IF Val(z:1)<>0
   CrearListBox ; 'Arial,8,';'Corte de Movimientos Pendientes'
      'OK'          ;k:100..k:fac;SI;;; 40;CHECK ;RGB(255,255,193)
      'Cliente'     ;a:100..a:FAC;NO;;; 70;STRING;;RGB(220,220,193)
      'Especie'     ;b:100..b:FAC;NO;;; 60;STRING;;RGB(220,220,193)
      'Cupon'       ;c:100..c:FAC;NO;;; 40;STRING;;RGB(220,220,193)
      'Cuenta'      ;f:100..f:FAC;NO;;;100;STRING;;RGB(220,220,193)
      'Cantidad'    ;g:100..g:FAC;NO;;;120;NUMERO;'##,###,###,###.##';RGB(220,220,193)
      'Cant.Pikeo'  ;PK:100..PK:FAC  ;NO;;;120;NUMERO;'###,###,###,###.##';RGB(220,220,193)
   FinListBox
   *  'Mercado'     ;d:100..d:FAC;NO;NO;; 60;STRING;;RGB(220,220,193)

   IF NOT OK 
      Cancelar
   ENDIF

   Recorrer&i 100,fac

      IF Val(k:&i)=1
         ***---ACT(Y1,GetNumerador(20))
         *ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', Val(J:2))))
         ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', Val(ve:&i))))
         *--------------- Insertar una transaccion para actualizar el saldo
         SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
         SQL.ADD(" Especie, Especie2, Cupon1 ,")
         SQL.ADD(" CB5, ")
         SQL.ADD(" Fecha1, Fecha2, Cliente1, ")
         SQL.ADD(" Cantidad1, Precio1, ")
         SQL.ADD(" Precio2, Precio3, Cambio1, ")
         SQL.ADD(" Cambio2, Vehiculo1, ")
         SQL.ADD(" TipoTr2, NrTrans, Mercado1, ")
         SQL.ADD(" Cuenta2, Cuenta6, Cuenta1, ")
         SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, Cupon2,CB2,NrOperacionRef1, Cantidad5 ")
         SQL.ADD(" ) VALUES ( ")
         SQL.ADD(" '"~Val(b2)~"', '"~Val(b4)~"', '"~FStr(Val(c2),1,0)~"',")
         If Round2(Val(e:3),3)=0
            SQL.ADD(" '1', ")
         Else
            SQL.ADD(" '0', ")
         Endif
         SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~IdxDate(Val(h4))~"', '"~Val(a:&i)~"', ")
         SQL.ADD(" "~FStr(Val(g:&i),1,2)~", "~FStr(Val(k2),1,8)~", ")    
         SQL.ADD(" "~FStr(Val(l2),1,8)~", "~FStr(Val(m2),1,8)~", "~FStr(Val(e2),1,8)~", ")
         *SQL.ADD(" "~FStr(Val(e3),1,8)~", '"~VAL(j2)~"', ")
         SQL.ADD(" "~FStr(Val(e3),1,8)~", '"~Val(ve:&i)~"', ")
         SQL.ADD(" 'CUPON', '"~Val(Y1)~"','"~Val(d:&i)~"', " )
         SQL.ADD(" '"~Val(f:&i)~"', '"~Val(f:&i)~"', '"~Val(m:&i)~"', ")
         SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', '"~FStr(Val(c4),1,0)~"','0','"~Val(h:&i)~"', "~Fstr(Val(PK:&i), 0, 2)~" ")
         SQL.ADD(" ) ")
         SQL.NEW 
  
         SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
         SQL.ADD("(NrBit, NrOperacion, Valor) ")
         SQL.ADD(" VALUES ")
         SQL.ADD("(20, '"~Val(y1)~"', '1') ")
         SQL.NEW
         SQL.EXEC

         SQL.ActualizarMovimientosT4(Val(y:1),SI,NO,NO,SI,NO,SI,0)
         SQL.EXEC
      ENDIF 
   Proximo
ELSE
   Message('Noy hay Movimientos Pendientes para cortar.')
ENDIF

SQL.ADD("SELECT O.Cliente1, O.TipoOp, O.Vehiculo1, O.Cantidad, O.TipoOp, O.NrOperacion ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("Where O.Especie = '"~VAL(b2)~"' ")
SQL.ADD("and Cupon1  = '"~FSTR(VAL(c2),1,0)~"'  ")
SQL.ADD("and O.TipoOp In ('SERA','SERP','SERAV','SERPV','SECT','SEVT','DSEO','SECS','SEVS') ")
SQL.ADD("and O.FechaOp <'"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.Vehiculo1 IN ("~Pipe2Comillas(&vehiculos)~") ") 
SQL.ADD("order by O.TipoOp, O.Especie")

Recorrer SQL
   Message(' Operaciones Vigentes  :'~FBN['TipoOp']~' '~FBN['NrOperacion'])   

   act(a:fac,fbn['Cliente1'])
   act(b:fac,fbn['TipoOp'])
   act(c:fac,fbn['Vehiculo1'] )
   acn(d:fac,fbn['Cantidad'] )
   act(e:fac,fbn['TipoOp'] )
   act(f:fac,fbn['NrOperacion'])

   Message('Actualiza Repos ....')
   SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
   SQL.ADD(" Set ")
   SQL.ADD(" FechaUltCupon='"~IdxDate(Dialogo.Fecha1)~"', ")
   SQL.ADD(" Cupon1='"~FSTR(VAL(c2)+1,1,0)~"' ")
   SQL.ADD("where NrOperacion = '"~Val(f:fac)~"' ")
   SQL.NEW
   SQL.EXEC

   SQL.ActualizarMovimientos2(Val(f:fac),SI,NO,NO,SI)
   SQL.EXEC

   ACT(i3,Val(f:fac))
 
   * Actualizo la Instancia de la Operacion a Supervision
   (.'MODIINSTAN'.)    
Proximo
