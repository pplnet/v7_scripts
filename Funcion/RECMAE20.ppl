*************************************************************
*  Msg 1520 Rechazo de alta
*************************************************************
* Filler                     Pic X(31).
* Cod. de mensaje rechazado  Pic X(04).
* Fecha rechazo              Pic X(06).
* Hora rechazo               Pic X(06).
* Secuencia rechazo	     Pic X(32).
* C¢digo de rechazo	     Pic X(02).
* Descripci¢n                Pic X(100).
*************************************************************
act(s:1,'Nro Orden Origen')
act(t:1,Copy(Val(a:2),48,32))
act(s:2,'Nro Orden FPA')
act(t:2,Copy(Val(a:2),72,8))
act(s:3,'Codigo Rechazo')
act(t:3,Copy(Val(a:2),80,2))
act(s:4,'Motivo')
act(t:4,Copy(Val(a:2),82,100))

if Eqstr(Copy(Val(a:2),32,4),'1521')
   act(s:5,'Instancia')
   acn(t:5,SQL("SELECT NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~val(t:2)~"' and  Valor = '1' "))

   SQL.ADD("UPDATE "~DBO~".ORDENES ")
   SQL.ADD(" SET AceptaMAE = 'NO', ")
   SQL.ADD(" RB3 = '"~val(t:3)~"', CodErrorMAE='"~val(t:3)~"' , ObsErrorMAE='"~val(t:4)~"' ")
   SQL.ADD(" Where NrOrden = '"~Val(t:2)~"' ")
   SQL.NEW
   * Pasa la Orden a la Inst. Baja
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '0' ")
   SQL.ADD(" Where  NrOperacion= '"~Val(t:2)~"' ")
   SQL.NEW
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '1' ")
   SQL.ADD(" Where  NrBit=4 and NrOperacion= '"~Val(t:2)~"' ")
   SQL.NEW
   SQL.EXEC
endif
