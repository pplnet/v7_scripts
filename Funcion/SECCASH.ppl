*MostrarCuadroDeMensajes
Message('Securities CashFlow ')

SCN(c:200,2)

***---Montos Futuros
SQL.ADD("SELECT O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaEj Fecha, ")
SQL.ADD("       Sum(O.TotalBrutoCli2)/1000 Cant, Sum(O.TotalDerechos)/1000 Int, O.ContraEspecie2 MonCom, ")
SQL.ADD("       Sum(O.ImpGastos2)/1000 Imp, Sum(O.ImpComCor2)/1000 Comision, O.MB1 Deducible ")
SQL.ADD("FROM   "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.Especie = E.Codigo ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaEj  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  E.Tipo = 'PUB' ")
If Dialogo.Radio1 = 1
   SQL.ADD("       and  O.TipoOp In ('SERP','SERPV') ")
   SQL.ADD("       and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD("       and  O.TipoOp In ('SERP') ")
Endif
SQL.ADD("GROUP BY  O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaEj, O.MB1, O.ContraEspecie2 ")
SQL.ADD("UNION ALL")
***---Montos Spot
SQL.ADD("SELECT O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaPago Fecha, ")
SQL.ADD("       Sum(-O.TotalBrutoCli1)/1000 Cant, Sum(-O.TotalIntereses)/1000 Int, O.ContraEspecie2 MonCom, ")
SQL.ADD("       Sum(-O.ImpGastos1)/1000 Imp, Sum(-O.ImpComCor1)/1000 Comision, O.RB7 Deducible ")
SQL.ADD("FROM   "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.Especie = E.Codigo ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  E.Tipo = 'PUB' ")
If Dialogo.Radio1 = 1
   SQL.ADD("       and  O.TipoOp In ('SERP','SERPV') ")
   SQL.ADD("       and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD("       and  O.TipoOp In ('SERP') ")
Endif
SQL.ADD("GROUP BY O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaPago, O.RB7, O.ContraEspecie2 ")
SQL.ADD(" UNION ALL ")
