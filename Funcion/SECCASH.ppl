SQL.ADD("order by 1, 2 ")

Recorrer SQL
  *** Diario o Mensual ***
  ACN(MT:11, 0)
  ACN(MT:12, 0)
  *ACN(MT:12, IIf(Eqstr(SQL(" SELECT Modo FROM "~DBO~".MODOESPECIES WHERE Especie1 = '"~FBN('Especie')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1)))
  ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))

  *ACN(MT:13, IIf(Eqstr(SQL("SELECT Modo FROM "~DBO~".MODOESPECIES WHERE Especie1 = '"~FBN('MonCom')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('MonCom'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('MonCom'),,,,Dialogo.Fecha1,1)))
  ACN(mt13, CotizacionC(FBN['MonCom'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))

  If Dialogo.Check1 = 1
      SCN(MT:11, FBN('Cant') * Val(MT:12))
  Endif
  If Dialogo.Check2 = 1
      SCN(MT:11, FBN('Int') * Val(MT:12))
  Endif
  If Dialogo.Check3 = 1 Y Not Incluido(FBN('TipoOp'), 'SEVSV|SEVTV|SECSV|SECTV')
      ***---Las Compras y Vtas. vinculadas no tienen impuestos
      SCN(MT:11, FBN('Imp') * Val(MT:12))
      If Eqstr(FBN('Deducible'), '0')
          SCN(MT:11, FBN('Comision') * Val(MT:13))
      Endif
  Endif
  If Dialogo.Radio2 = 0
     *** Diario ***
     Recorrer&i 2, Val(d:200)-1
       If FBN['Fecha'] = Val(&i:10)
          SCN(&i:Val(c:200), Val(MT:11))
          SCN(&i:Val(h:200), Val(MT:11))
       Endif
     Proximo
     Recorrer&i Val(d:200)+1, Val(g:200)-1
       If FBN['Fecha'] = Val(&i:10)
          SCN(&i:Val(c:200), Val(MT:11))
          SCN(&i:Val(h:200), Val(MT:11))
       Endif
     Proximo
  Else
     *** Mensual ***
     Recorrer&i Val(m:200), Val(n:200)
       If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
          SCN(&i:Val(c:200), Val(MT:11))
          SCN(&i:Val(h:200), Val(MT:11))
       Endif
     Proximo
     Recorrer&i Val(o:200), Val(p:200)
       If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
          SCN(&i:Val(c:200), Val(MT:11))
          SCN(&i:Val(h:200), Val(MT:11))
       Endif
     Proximo
     If Val(o:200) > 0
        If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
           SCN(Val(p:200)+1:Val(c:200), Val(MT:11))
           SCN(Val(p:200)+1:Val(h:200), Val(MT:11))
        Endif
     Endif
     Recorrer&i Val(d:200), Val(g:200)
       If Anio(FBN['Fecha']) = Val(&i:280)
          SCN(&i:Val(c:200), Val(MT:11))
          SCN(&i:Val(h:200), Val(MT:11))
       Endif
     Proximo
     If Anio(FBN['Fecha']) > Val(Val(g:200):280)
        SCN(Val(g:200):Val(c:200), Val(MT:11))
        SCN(Val(g:200):Val(h:200), Val(MT:11))
     Endif
  Endif
proximo

SCN(c:200,1)

SQL.ADD("SELECT O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaEj Fecha, ")
SQL.ADD(" Sum(O.TotalBrutoCli2)/1000 Cant, Sum(O.TotalDerechos)/1000 Int, O.ContraEspecie2 MonCom, ")
SQL.ADD(" Sum(O.ImpGastos2)/1000 Imp, Sum(O.ImpComCor2)/1000 Comision, O.MB1 Deducible ")
SQL.ADD(" FROM  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD(" WHERE O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaEj  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  E.Tipo = 'PRI' ")
