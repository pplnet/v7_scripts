If Val(hs:1) = Val(sl:1)
   * Saldo Libre
   ACT(cz:8, BuscarCampo('ESTADOSCUSTODIA', 'Codigo', 'NrSaldo', Val(hs:1)))
Else
   * Algun bloqueo o garantia
   ACN(cz:9, Val(hs:1)-100)
   ACT(cz:8, BuscarCampo('ESTADOSCUSTODIA', 'Codigo', 'NrSaldo', Val(cz:9)))
Endif

* --- Total renta
ACN(sa:1,val(cj:1))

ACN(ck:1,Round2(MontoArancelC(,fbn('Cliente'),fbn('Especie'),Dialogo.Vehiculo1,VAL(ct:1), VAL(sa:1) ,0,,fbn('TipoCliente'),SI,'',fbn('Mercado'),Val(cz:8),'MAN',SI,SI,,SI),2))
SCN(sa3,val(ck:1))