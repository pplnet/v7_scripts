*- e200:  Desde donde empieza el apartado

Recorrer&i 1,22 
  ACN(PP1,0)     
  ACN(PP1,SQL("Select 1 from "~DBO~".APARTADOS where Codigo = '"~Val(z:&i+val(e200))~"' and Fecha ='"~IdxDate(Dialogo.Fecha1)~"' and Comunicado = '"~Val(cc:1)~"' ")) 

  if Val(PP1) = 0
     SQL.ADD("Insert into "~DBO~".APARTADOS                                 ")
     SQL.ADD("(Fecha, Comunicado,  Cantidad, Codigo)                        ")
     SQL.ADD(" Values ('"~IdxDate(Dialogo.Fecha1)~"', '"~Val(cc:1)~"'       ")
     SQL.ADD("         ,"~Fstr(Val(b:&i+val(e200)),1,2)~" , '"~Val(z:&i+val(e200))~"')  ")
     SQL.NEW
  else
     SQL.ADD("Update "~DBO~".APARTADOS                                      ")
     SQL.ADD("set Cantidad = "~Fstr(Val(b:&i+val(e200)),1,2)~"                    ")
     SQL.ADD("where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Comunicado = '"~Val(cc:1)~"'  ")
     SQL.ADD("      and Codigo = '"~Val(z:&i+val(e200))~"'                        ")
     SQL.NEW
  endif
Proximo
SQL.EXEC


