*-LISTTASAS: Lista Flujos de Tasas
*- Dada una tasa de referencia existente en tipos tasas Ej: LIUS1Y Libor en usd de 
*- un año calculo 
*- Recibe en pe1: Precio de Referencia y fe1: Fecha de Referencia 
*- Listo a partir del ba:3
ACT(ba3, 'TipoTasa')
ACT(bb3, 'Fecha ')
ACT(bc3, 'Tasa')
ACT(bd3, 's -Per. a Cap')
ACT(be3, 'FDt')

SetFont(ba1..bh3,1)
AlinearCeldas(ba3..bh3, 'C')
AgregarMarco(ba3..bh3,2,0,Exe('COLOR6'))

SQL.ADD("Select TD.*,TT.DayCount from IRSA.TASASDIA TD, IRSA.TIPOSTASA TT Where ")
SQL.ADD("TD.TipoTasa=TT.Codigo  and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND")
SQL.ADD("TD.Fecha IN ")
SQL.ADD("( ")
SQL.ADD("Select Max(TD1.Fecha) from IRSA.TASASDIA TD1, IRSA.TIPOSTASA TT1 Where ")
SQL.ADD("TD1.TipoTasa=TT1.Codigo  and TT1.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND")
SQL.ADD("TD1.Fecha<='"~IdxDate(val(fe1))~"' AND TD1.TipoTasa=TD.TipoTasa AND")
SQL.ADD("TD1.PlazoHasta=TD.PlazoHasta AND TD1.PlazoDesde=TD.PlazoDesde and TD1.Especie=TD.Especie ")
SQL.ADD("GROUP BY TD1.TipoTasa  ")
SQL.ADD(") ORDER BY TD.PlazoHasta")
ACN(bx1,0)

SetFilaActual(4)

ACN(z3,3)

ACT(ba:fac,'Hoy')
ACD(bb:fac,val(fe1))
SetFont(ba:fac..bb:fac,1)

*-- Recorrer valores
Recorrer SQL
   SCN(bx1,1)

   ACT(ba:fac,FBN['TipoTasa'])

   Message(val(ba:fac))
  
   IF EqStr(FBN['DayCount'],'ACT')
      acn(dc10,0)
   EndIf
   IF EqStr(FBN['DayCount'],'365')
      acn(dc10,1)
   EndIf
   IF EqStr(FBN['DayCount'],'36A')
      acn(dc10,2)
   EndIf
   IF EqStr(FBN['DayCount'],'360')
      acn(dc10,3)
   EndIf
   IF EqStr(FBN['DayCount'],'30E')
      acn(dc10,4)
   EndIf

   *- Segun el plazo, fijo la fecha de vto
   IF Dia(val(fe1)+FBN['PlazoHasta'])=Dia(val(fe1)) o FBN['PlazoHasta']<=14
      ACD(fl2,val(fe1)+FBN['PlazoHasta'] )
   Else    

      acn(di1,Dia(val(fe1)))
      acn(me1,Mes(val(fe1)+FBN['PlazoHasta']))
      acn(an1,Anio(val(fe1)+FBN['PlazoHasta']))

      Repetir 
         ACT(fl1,Pad0(FSTR(val(di1),0,0),2)~'/'~Pad0(FSTR(val(me1),0,0),2)~'/'~Pad0(FSTR(val(an1),0,0),2) )
         ACD(fl2,Fecha(val(fl1)) )
         ACT(fl3,val(fl2))

         IF EqSTr(Copy(val(fl3),1,2),'00')
            *- Fecha invalida, busco el siguiente dia 
            scn(di1,1)
            If val(di1)>31
               acn(di1,1)               
               scn(me1,1)               
            EndIf
            If val(me1)>12            
               acn(me1,1)               
               scn(an1,1)               
            EndIf
         Else 
            Break
         EndIf
      Proximo
   EndIf

   ACD(bb:fac,val(fl2))
   ACN(bc:fac,FBN['Valor1'])

   *- s: Fecha de Vto - FechadeVAluacion/DayCount
   ACN(bd:fac,(val(bb:fac)-val(fe1))/IIF(val(dc10)>1,360,365))

   *- Cálculo de factores de descuentos para plazos con cotización
   ACN(be:fac,(1+(val(bc:fac)/100)*val(bd:fac))^-1)

   If val(bx1)>1
      ACN(bg:fac,val(be:fac-1)/val(be:fac) -1 )
      ACN(bh:fac,(val(bg:fac)/(val(bd:fac)-val(bd:fac-1)))*100 )
   EndIf

   SetFont(ba:fac..bh:fac,2)
Proximo

FormatoCeldas(bc1..bh:fac, Exe('F8'))
FormatoCeldas(bh1..bh:fac, Exe('F2'))
*- uf1:Ultima fila del flujo
ACN(uf1,fac)



