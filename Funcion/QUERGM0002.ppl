*------------------OPERACIONES REVERSADAS Solo se incluyen en el archivo de interface---------------------------*

 SQL.ADD("Select Case when O.TotalRetenciones=0 then O.Cantidad else O.Cantidad * O.TipoCambio2 end as CantOpeUSD ,")
 SQL.ADD("       Case when O.FechaOp <'"~IdxDate(Val(fe:1))~"'  ")
 SQL.ADD("            then O.Cantidad  ")
 SQL.ADD("                 / (Select Precio1 from  "~DBO~".COTIZACIONES                ")
 SQL.ADD("                  Where Fecha =(Select Max(Fecha) from  "~DBO~".COTIZACIONES ")
 SQL.ADD("                                Where Month(Fecha) =Month(O.FechaOp) and Year(Fecha) =Year(O.FechaOp) and Codigo = 'COMA35' )")
 SQL.ADD("                  and Codigo = 'COMA35')")
 SQL.ADD("                 * (Case when O.TipoOp in('FXCT','FXACT','FXCS','FXACS','FXPRC') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end) ")
 SQL.ADD("            else  O.Cantidad  ")
 SQL.ADD("                 /"~Val(co:2))
 SQL.ADD("                 * (Case when O.TipoOp in('FXCT','FXACT','FXCS','FXACS','FXPRC') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end) ")
 SQL.ADD("            end  as ResultadoUSD ,")
 SQL.ADD("   'Genuina' as TIPO, O.FechaOp as FECHAOP, O.Cliente1 as CLIENTE, O.TipoOp as TIPOOP, O.Especie, O.Cantidad as CANTIDAD, O.Plazo4 as PLAZO, Case when IsNull(O.Puesto,'')='' Then 'No Puesto' Else 'Puesto'  End as VALOR, Case when O.TotalRetenciones=0 then 1 Else O.TipoCambio2 End as TipoCambio2, O.PorDerechoMercado as COTUSD, O.Precio2, O.TipoCambio3, O.TotalBrutoCli2 as MONTOARP, O.TotalBrutoCli1 as MONTOUSD,O.Operador, O.Mercado3 as EQUIPO, O.Mercado4 as ORGANIZACION, O.ConceptoEmp as SEGMENTO, O.NrOperacion as NROPERACION, O.TotalRetenciones, O.Corredor as BROKER, O.TipoDoc as PRODUCTO, O.FechaVto, I.Nombre as Instancia, C.OficialCuenta as OFICIALCUENTA,")
 SQL.ADD(" 'FPA'as TIPOCLI, '' as NrOPEX, 'B' as ESTADO, O.ContraEspecie,  FechaPago, ")
 SQL.ADD(" C.TipoDocum , C.NrDocum , C.Alias7 as NrAltamira  , TotalGastos, Responsable1,  CASE when IsNull(O.Plaza1,'')='' Then 'OTROS' else O.Plaza1 end as ProdOPEX, ")
 *SQL.ADD(" CASE when O.RB10 = '1' or                                                                             ")
 *SQL.ADD("      O.TipoOp In ('FXAJUC','FXAJUV','FXCTC','FXVTC', 'FXIMPO','FXEXPO', 'FXMINU', 'FXOCTC', 'FXOCTV') ") 
 *SQL.ADD("      Then 'NO' else 'SI' end as Calzada                                                               ")
 SQL.ADD(" CASE when O.RB10 = '0' and                                                                             ")
 SQL.ADD("      O.TipoOp Not In ('FXAJUC','FXAJUV','FXCTC','FXVTC', 'FXIMPO','FXEXPO', 'FXMINU', 'FXOCTC', 'FXOCTV') ") 
 SQL.ADD("      Then 'SI' else 'NO' end as Calzada                                                                   ")
 
 SQL.ADD("from "~DBO~".OPERACIONES O , "~DBO~".CLIENTES C ,"~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I	")
 SQL.ADD("Where O.Cliente1 = C.Codigo                                                                           ")
 SQL.ADD("    and O.NrOperacion = B.NrOperacion                                 				")
 SQL.ADD("    and B.Valor = '1' 					 					")
 SQL.ADD("    and I.NrInstancia = B.NrBit 									")
 SQL.ADD("    and I.Tabla = 'OPERACIONES'									")
 SQL.ADD(" and O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
 SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
 SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"' ")
 SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha4)~"' ")

 SQL.ADD("and O.TipoOp like ('FX%') ")

 * REVERSADAS
 SQL.ADD("and 1 =(Select 1 from "~DBO~".OPERACIONES OO Where OO.NrOperacion =O.NrOperacion3 and IsNull(OO.CB10,'0')='1' and Month (OO.FechaOp) between "~FStr(Mes(Dialogo.Fecha1),1,0)~" and "~FStr(Mes(Dialogo.Fecha2),1,0)~")")


 *No Anulada
 SQL.ADD("    and Not Exists ( Select B.NrOperacion                        ")
 SQL.ADD("                     from   "~DBO~".OPERACIONESBITS B            ")
 SQL.ADD("                          where  O.NrOperacion = B.NrOperacion   ")
 SQL.ADD("                            and  B.Valor = '1'                   ")
 SQL.ADD("                            and  B.NrBit = 30    )               ")

 * No Op.Resumen OPEX/ALTAMIRA
 SQL.ADD("and (IsNull(O.MB6,'0') <> '1' and IsNull(O.MB6,'0') <>  '2' )")

 if NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("and O.Cliente1 In ("~Pipe2Comillas(Dialogo.ListaTabla1)~")")
 endif

 if NoVacio(Dialogo.Lista1)
  SQL.ADD("and C.TipoDocum In ("~Pipe2Comillas(Val(z1))~")")
 endif

 if NoVacio(Dialogo.String1)
   SQL.ADD("and C.NrDocum = '"~Pad0(Dialogo.String1,15)~"'")
 endif

 if NoVacio(Dialogo.Lista2)
  if Incluido(Dialogo.Lista2,'SALES')
    SQL.ADD("and C.ExperienciaInv in ('100','101','102')")
  else
    if Incluido(Dialogo.Lista2,'PYMES')
      SQL.ADD("and C.ExperienciaInv in ('104','105','106','107','109','110','111','112','113','114')")
    else
      if Incluido(Dialogo.Lista2,'INSTITUTIONALS')
        SQL.ADD("and C.ExperienciaInv in ('103') and C.Alias8 ='D01'")
      else
        if Incluido(Dialogo.Lista2,'FIN.INST')
          SQL.ADD("and C.ExperienciaInv in ('103') and C.Alias8 <> 'D01'")
        endif
      endif
    endif
  endif
 endif

 if NoVacio(Dialogo.Lista3)
  SQL.ADD("and O.TipoDoc In ("~Pipe2Comillas(Dialogo.Lista3)~")")
 endif

 if NoVacio(Dialogo.Lista4)
  SQL.ADD("and O.Operador In ("~Pipe2Comillas(Dialogo.Lista4)~")")
 endif

 if NoVacio(Dialogo.Lista5)
  SQL.ADD("and O.Mercado3 In ("~Pipe2Comillas(Dialogo.Lista5)~")")
 endif

 ****************AGUS*********************
 if NoVacio(Dialogo.Lista6)
  SQL.ADD("and O.Especie In ("~Pipe2Comillas(Dialogo.Lista6)~")")
 endif
 *****************************************

SQL.ADD("Union")

*------------------FWD Baja FValor----------------------*
SQL.ADD("Select Case when O.TotalRetenciones=0 then O.Cantidad else O.Cantidad * O.TipoCambio2 end as CantOpeUSD ,")
 SQL.ADD("       Case when O.FechaOp <'"~IdxDate(Val(fe:1))~"'  ")
 SQL.ADD("            then O.Cantidad  ")
 SQL.ADD("                 / (Select Precio1 from  "~DBO~".COTIZACIONES                ")
 SQL.ADD("                  Where Fecha =(Select Max(Fecha) from  "~DBO~".COTIZACIONES ")
 SQL.ADD("                                Where Month(Fecha) =Month(O.FechaOp) and Year(Fecha) =Year(O.FechaOp) and Codigo = 'COMA35' )")
 SQL.ADD("                  and Codigo = 'COMA35')")
 SQL.ADD("                 * (Case when O.TipoOp in('FWFXC','FWFXAC') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end) ")
 SQL.ADD("            else  O.Cantidad  ")
 SQL.ADD("                 /"~Val(co:2))
 SQL.ADD("                 * (Case when O.TipoOp in('FWFXC','FWFXAC') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end) ")
 SQL.ADD("            end  as ResultadoUSD ,")
 SQL.ADD("   'Genuina' as TIPO, O.FechaOp as FECHAOP, O.Cliente1 as CLIENTE, O.TipoOp as TIPOOP, O.Especie, O.Cantidad as CANTIDAD, O.Plazo4 as PLAZO, Case when IsNull(O.Puesto,'')='' Then 'No Puesto' Else 'Puesto'  End as VALOR, Case when O.TotalRetenciones=0 then 1 Else O.TipoCambio2 End as TipoCambio2, O.PorDerechoMercado as COTUSD, O.Precio2, O.TipoCambio3, O.TotalBrutoCli2 as MONTOARP, O.TotalBrutoCli1 as MONTOUSD,O.Operador, O.Mercado3 as EQUIPO, O.Mercado4 as ORGANIZACION, O.ConceptoEmp as SEGMENTO, O.NrOperacion as NROPERACION, O.TotalRetenciones, O.Corredor as BROKER, O.TipoDoc as PRODUCTO, O.FechaVto, I.Nombre as Instancia, C.OficialCuenta as OFICIALCUENTA,")
 SQL.ADD(" 'FPA'as TIPOCLI, '-' as NrOPEX, 'B' as ESTADO, O.ContraEspecie, O.FechaPago, ")
 SQL.ADD(" C.TipoDocum , C.NrDocum , C.Alias7 as NrAltamira  , TotalGastos, Responsable1,  CASE when IsNull(O.Plaza1,'')='' Then 'OTROS' else O.Plaza1 end as ProdOPEX,  ")
 SQL.ADD("  'NO' as Calzada                                                                                     ")
 SQL.ADD("from "~DBO~".OPERACIONES O , "~DBO~".CLIENTES C ,"~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I	")
 SQL.ADD("Where O.Cliente1 = C.Codigo                                                                           ")
 SQL.ADD("    and O.NrOperacion = B.NrOperacion                                 				")
 SQL.ADD("    and B.Valor = '1' 					 					")
 SQL.ADD("    and I.NrInstancia = B.NrBit 									")
 SQL.ADD("    and I.Tabla = 'OPERACIONES'									")
 SQL.ADD(" and O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
 SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
 SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"' ")
 SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha4)~"' ")

 SQL.ADD("and O.TipoOp in ('FWFXC','FWFXV','FWFXAC','FWFXAV') ")

 * bajas con fecha valor de los FWDs
 SQL.ADD(" and IsNull(NrOperacion3,'')<>''    ")
 SQL.ADD(" and Month(FechaBajaCV) between "~FStr(Mes(Dialogo.Fecha1),1,0)~" and "~FStr(Mes(Dialogo.Fecha2),1,0))

 * No Op.Resumen OPEX/ALTAMIRA
 SQL.ADD("and (IsNull(O.MB6,'0') <> '1' and IsNull(O.MB6,'0') <>  '2' )")

 if NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("and O.Cliente1 In ("~Pipe2Comillas(Dialogo.ListaTabla1)~")")
 endif

 if NoVacio(Dialogo.Lista1)
  SQL.ADD("and C.TipoDocum In ("~Pipe2Comillas(Val(z1))~")")
 endif

 if NoVacio(Dialogo.String1)
   SQL.ADD("and C.NrDocum = '"~Pad0(Dialogo.String1,15)~"'")
 endif

 if NoVacio(Dialogo.Lista2)
  if Incluido(Dialogo.Lista2,'SALES')
    SQL.ADD("and C.ExperienciaInv in ('100','101','102')")
  else
    if Incluido(Dialogo.Lista2,'PYMES')
      SQL.ADD("and C.ExperienciaInv in ('104','105','106','107','109','110','111','112','113','114')")
    else
      if Incluido(Dialogo.Lista2,'INSTITUTIONALS')
        SQL.ADD("and C.ExperienciaInv in ('103') and C.Alias8 ='D01'")
      else
        if Incluido(Dialogo.Lista2,'FIN.INST')
          SQL.ADD("and C.ExperienciaInv in ('103') and C.Alias8 <> 'D01'")
        endif
      endif
    endif
  endif
 endif

 if NoVacio(Dialogo.Lista3)
  SQL.ADD("and O.TipoDoc In ("~Pipe2Comillas(Dialogo.Lista3)~")")
 endif

 if NoVacio(Dialogo.Lista4)
  SQL.ADD("and O.Operador In ("~Pipe2Comillas(Dialogo.Lista4)~")")
 endif

 if NoVacio(Dialogo.Lista5)
  SQL.ADD("and O.Mercado3 In ("~Pipe2Comillas(Dialogo.Lista5)~")")
 endif

 ****************AGUS*********************
 if NoVacio(Dialogo.Lista6)
