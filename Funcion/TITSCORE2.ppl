Crearfont(1, 'Arial,8,B')
Crearfont(2, 'Arial,8,')

ACT(a1, 'Costos y Rendimientos Securities - Consolidado')
ACT(a2, Dialogo.Fecha1~' al '~Dialogo.Fecha2)

If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio6 = 0 
  ACT(a3,'Tipos Especies:  Todas' )   
Else
  if Dialogo.Radio6 = 1 
   ACT(a3,'Tipos Especies:  Publicas')
  else
   if Dialogo.Radio6 = 2
     ACT(a3,'Tipos Especies:  Privadas')
   else
     ACT(a3,'Tipos Especies:  Obligaciones Negociables')
   endif
  endif
endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(a4,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(a4,'Especies: Todas' )   
endif
ACT(a5, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo','USD') )


SetFilaActual(7)
ACT(b:fac, 'Spot')
ACT(a:fac+1, 'Dia')
ACT(b:fac+1, 'Concepto')
ACT(c:fac+1, 'Cob.Cupon')
ACT(d:fac+1, 'VN')
ACT(e:fac+1, 'Precio')
ACT(f:fac+1, 'Inic/cierre')
ACT(g:fac+1, 'F.Fondos')
ACT(h:fac, 'Opciones')
ACT(h:fac+1, 'Concepto')
ACT(i:fac+1, 'VN')
ACT(j:fac+1, 'Precio')
ACT(k:fac+1, 'Inic/cierre')
ACT(l:fac+1, 'F.Fondos')
ACT(m:fac, 'Futuros')
ACT(m:fac+1, 'Concepto')
ACT(n:fac+1, 'VN')
ACT(o:fac+1, 'Precio')
ACT(p:fac+1, 'Inic/cierre')
ACT(q:fac+1, 'F.Fondos')
ACT(r:fac, 'T.F.Fondos')
ACT(s:fac, 'Promedio Numerales')
ACT(s:fac+1, 'Flujo Acum.')
ACT(t:fac+1, 'Dias')
ACT(u:fac+1, 'Numerales')
ACT(a:fac+2, 'Inicio')

AgregarMarco(a:fac..a:fac,1,0,Exe('COLOR'))
AgregarMarco(b:fac..g:fac,1,0,Exe('COLOR'))
AgregarMarco(h:fac..l:fac,1,0,Exe('COLOR'))
AgregarMarco(m:fac..q:fac,1,0,Exe('COLOR'))
AgregarMarco(r:fac..r:fac,1,0,Exe('COLOR'))
AgregarMarco(s:fac..u:fac,1,0,Exe('COLOR'))
AgregarMarco(a:fac+1..u:fac+1,1,3,Exe('COLOR'))
ACN(x:fac+2, 0)

Recorrer&i Dialogo.Fecha1, Dialogo.Fecha2-1

  ACD(a:fac+3+&i-Dialogo.Fecha1, &i)
  ACN(g:fac+3+&i-Dialogo.Fecha1, 0)
  ACN(l:fac+3+&i-Dialogo.Fecha1, 0)
  ACN(q:fac+3+&i-Dialogo.Fecha1, 0)
  ACN(x:fac+3+&i-Dialogo.Fecha1, (Val(a:fac+3+&i-Dialogo.Fecha1)-Dialogo.Fecha1)/365)
Proximo

ACN(x:fac+3+Dialogo.Fecha2-Dialogo.Fecha1, (Dialogo.Fecha2-Dialogo.Fecha1)/365)
ACN(z1, Dialogo.Fecha2-Dialogo.Fecha1)
ACT(a:fac+3+Val(z1), 'Fin')
ACT(a:fac+4+Val(z1), 'P/L')
ACT(a:fac+5+Val(z1), 'TIR diaria')
ACT(a:fac+6+Val(z1), 'dias')
ACT(a:fac+7+Val(z1), 'Rendimiento de la tenencia (% p.a.) (Security+Opciones)')
ACT(a:fac+8+Val(z1), 'Capital Promedio Tenencia')
AgregarMarco(b:fac..g:fac+3+Val(z1),1)
AgregarMarco(h:fac..l:fac+3+Val(z1),1)
AgregarMarco(m:fac..q:fac+3+Val(z1),1)
AgregarMarco(r:fac..r:fac+3+Val(z1),1)
AgregarMarco(s:fac..u:fac+3+Val(z1),1)
AgregarMarco(a:fac+4+Val(z1)..r:fac+4+Val(z1),1)
AgregarMarco(a:fac+5+Val(z1)..r:fac+5+Val(z1),1)
AgregarMarco(a:fac+6+Val(z1)..r:fac+6+Val(z1),1)
AgregarMarco(a:fac+7+Val(z1)..r:fac+7+Val(z1),1,0,Exe('COLOR'))
AgregarMarco(a:fac+8+Val(z1)..r:fac+8+Val(z1),1,0,Exe('COLOR'))
AgregarMarco(u:fac+4+Val(z1)..u:fac+4+Val(z1),1)



* Armar una lista con los cupones asociados a las especies elegidas
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2) 
  SQL.ADD("Select Codigo from "~DBO~".ESPECIES where Codigo In ("~Pipe2Comillas(Dialogo.Lista2)~") order by Codigo ")
else
  If Dialogo.Radio6 > 0 
    If Dialogo.Radio6 = 1 
      SQL.ADD("Select Codigo from "~DBO~".ESPECIES where Tipo='PUB' order by Codigo ")   
    else
      If Dialogo.Radio6 = 2
        SQL.ADD("Select Codigo from "~DBO~".ESPECIES where Tipo='PRI' order by Codigo ")   
      else
        SQL.ADD("Select Codigo from "~DBO~".ESPECIES where Tipo='ONE' order by Codigo ")   
      endif
    endif
  else
    SQL.ADD("Select Codigo from "~DBO~".ESPECIES where Tipo in ('PUB','PRI','ONE') order by Codigo ")   
  endif
endif


Recorrer SQL 

 dfa
 ACT(y93, Val(y93)~Descendientes('ESPECIES',fbn('Codigo')))
Proximo

If Vacio(val(y93))
   act(y93,Dialogo.Lista2)    
EndIf
