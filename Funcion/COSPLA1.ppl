***---BY = Buyers
***---PS = Prestamos Sindicados
***---PF = Prestamos Financieros
***---PL = Prestamos Financieros Locales
***---TO = Totales ONs
***---TV = Tomas Vinculadas
***---ON = ONs por Especie.Guarda en ON11 y ON21 datos de la primer especie, despues ON21 y ON31
***---para la siguiente y asi sucesivamente
***---FM1 = Cantidad de Filas maximas de ONs que pueden haber en el informe OPFIAU
***---UO1 = Fila de ultima ON
***---EO = Especies de ONs, desde 11 en adelante sumando de a 10
***---TL = Tasa Promedio Locales
***---TF = Tasa Promedio Financieras
***---TY = Tasa Promedio Buyers
***---TS = Tasa Promedio Sindicados
***---TZ = Tasa Promedio Vinculadas
***---TN = Tasa Promedio ONs
***---TD = Detalle Tasa Promedio ONs
***---ZL = Plazo Promedio Locales
***---ZF = Plazo Promedio Financieras
***---ZY = Plazo Promedio Buyers
***---ZS = Plazo Promedio Sindicados
***---ZV = Plazo Promedio Vinculadas
***---ZN = Plazo Promedio ONs
***---ZD = Detalle Plazo Promedio ONs
***---TP = Suma de Plazo*Capital
***---TW = Suma de Tasa*Capital
***---OT = Suma de Tasa*Capital de ONs
***---OP = Suma de Pazo*Capital de ONs
***---PO = Fila del Total de ONs

ACN(FM:1, 30)
ACN(BD:2, 0)
ACN(TW:1, 0)

Recorrer&j 1, 3
    ACN(BY:&j, 0)
    ACN(PS:&j, 0)
    ACN(PF:&j, 0)
    ACN(PL:&j, 0)
    ACN(TO:&j, 0)
    ACN(TC:&j, 0)
    ACN(TV:&j, 0)
    ACN(TL:&j, 0)
    ACN(TF:&j, 0)
    ACN(TY:&j, 0)
    ACN(TS:&j, 0)
    ACN(TZ:&j, 0)
    ACN(TN:&j, 0)
    ACN(ZL:&j, 0)
    ACN(ZF:&j, 0)
    ACN(ZY:&j, 0)
    ACN(ZS:&j, 0)
    ACN(ZV:&j, 0)
    ACN(ZN:&j, 0)
    ACN(TP:&j, 0)
    ACN(TW:&j, 0)
    ACN(OT:&j, 0)
    ACN(OP:&j, 0)
    ACN(PO:&j, 0)
    ACN(UO:&j, 0)
Proximo

Recorrer&j 11, 103
    ACN(ON:&j, 0)
    ACN(TD:&j, 0)
    ACN(ZD:&j, 0)
Proximo
ACN(UO:1, 1)
Recorrer&j 0, 3
    ***---Corto, Largo y Corto + Largo
    LinkearHoja('OPFIA2',1, Fecha1 = Val(FE:1), Lista1 = ItemLista(Val(LS:1000), &k), Radio1 = 0, Precio1 = Val(CT:1), Radio2 = &j, Check1 = 0, Check2 = 0, Especie1 = ItemLista(Val(LS:100), &i), Vehiculo1= Dialogo.Vehiculo1)
    SCN(PL:&j+1, LinkH(1, O:Val(FP:1)+2))
    SCN(PF:&j+1, LinkH(1, O:Val(FP:1)+3))
    SCN(BY:&j+1, LinkH(1, O:Val(FP:1)+4))
    SCN(PS:&j+1, LinkH(1, O:Val(FP:1)+5))
    SCN(TV:&j+1, LinkH(1, O:Val(FP:1)+6))
    IF Val(CK:1) = 1
        ***---Interes solo en Corto Plazo
        SCN(PL:&j+1, LinkH(1, P:Val(FP:1)+2))
        SCN(PF:&j+1, LinkH(1, P:Val(FP:1)+3))
        SCN(BY:&j+1, LinkH(1, P:Val(FP:1)+4))
        SCN(PS:&j+1, LinkH(1, P:Val(FP:1)+5))
        SCN(TV:&j+1, LinkH(1, P:Val(FP:1)+6))
    ENDIF
    IF &j = 2
        ***---Tasas
        IF Eqstr(ItemLista(Val(LS:100), &i), Var('MONELOCA'))
            ACN(TL:&j+1, LinkH(1, E:Val(FP:1)+2))
            ACN(TF:&j+1, LinkH(1, E:Val(FP:1)+3))
            ACN(TY:&j+1, LinkH(1, E:Val(FP:1)+4))
            ACN(TS:&j+1, LinkH(1, E:Val(FP:1)+5))
            ACN(TZ:&j+1, LinkH(1, E:Val(FP:1)+6))
        ELSE
            ACN(TL:&j+1, LinkH(1, J:Val(FP:1)+2))
            ACN(TF:&j+1, LinkH(1, J:Val(FP:1)+3))
            ACN(TY:&j+1, LinkH(1, J:Val(FP:1)+4))
            ACN(TS:&j+1, LinkH(1, J:Val(FP:1)+5))
            ACN(TZ:&j+1, LinkH(1, J:Val(FP:1)+6))
        ENDIF
    ENDIF
    IF &j = 3
        ***---Plazos
        ACN(ZL:&j, LinkH(1, ZL:94))
        ACN(ZF:&j, LinkH(1, ZF:94))
        ACN(ZY:&j, LinkH(1, ZY:94))
        ACN(ZS:&j, LinkH(1, ZS:94))
        ACN(ZV:&j, LinkH(1, ZV:94))
    ENDIF
    ACN(BD:99, 0)
    Repetir
        ***---Busco las <> ONs
        SCN(BD:99, 1)
        ACN(BD:2, 0)
        IF NoVacio(LinkH(1, A:Val(FO:1)+Val(BD:99)))
            ***---Hay una especie de ON
            IF &j = 0
                ***---Corto Plazo
                ACT(EO:(&j+1)+(Val(BD:99)*10), LinkH(1, A:Val(FO:1)+Val(BD:99)))
                SCN(ON:(&j+1)+(Val(BD:99)*10), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                SCN(TO:(&j+1), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                IF Val(CK:1) = 1
                    ***---Incluye Interes
                    SCN(ON:(&j+1)+(Val(BD:99)*10), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                    SCN(TO:(&j+1), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                ENDIF
            ELSE
                ***---Largo Plazo
                Repetir
                    ***---Ciclo para buscar la fila de la especie en corto
                    SCN(BD:2, 1)
                    IF Eqstr(LinkH(1, A:Val(FO:1)+Val(BD:99)), Val(EO:1+(Val(BD:2)*10)))
                        ***---Corresponde a esta fila de ON
                        SCN(ON:(&j+1)+(Val(BD:2)*10), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                        SCN(TO:(&j+1), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                        IF Val(CK:1) = 1
                            ***---Incluye Interes
                            SCN(ON:(&j+1)+(Val(BD:2)*10), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                            SCN(TO:(&j+1), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                        ENDIF
                        IF &j = 2
                            ***---Tasas
                            IF Eqstr(ItemLista(Val(LS:100), &i), Var('MONELOCA'))
                                SCN(TN:&j+1, LinkH(1, E:Val(FO:1)+Val(BD:99)))
                                SCN(TD:(&j+1)+(Val(BD:2)*10), LinkH(1, E:Val(FO:1)+Val(BD:99)))
                            ELSE
                                SCN(TN:&j+1, LinkH(1, J:Val(FO:1)+Val(BD:99)))
                                SCN(TD:(&j+1)+(Val(BD:2)*10), LinkH(1, J:Val(FO:1)+Val(BD:99)))
                            ENDIF
                        ENDIF
                        IF &j = 3
                            ***---Plazos
                            ACN(ZN:&j, LinkH(1, ZD:Val(FO:1)+Val(BD:99)))
                            ACN(ZD:(&j)+(Val(BD:2)*10), LinkH(1, ZD:Val(FO:1)+Val(BD:99)))
                        ENDIF
                        Break
                    ENDIF
                    IF Val(BD:2) = Val(UO:1)
                        ***---No esta la especie en corto, => agrego fila para la nueva especie
                        SCN(UO:1, 1)
                        ACT(EO:&j+(Val(UO:1)*10), LinkH(1, A:Val(FO:1)+Val(BD:99)))
                        SCN(ON:(&j+1)+(Val(UO:1)*10), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                        SCN(TO:(&j+1), LinkH(1, O:Val(FO:1)+Val(BD:99)))
                        IF Val(CK:1) = 1
                            ***---Incluye Interes
                            SCN(ON:(&j+1)+(Val(UO:1)*10), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                            SCN(TO:(&j+1), LinkH(1, P:Val(FO:1)+Val(BD:99)))
                        ENDIF
                        Break
                    ENDIF
                Proximo
            ENDIF
        ELSE
            IF Val(BD:99)-1 > Val(UO:1)
                ACN(UO:1, Val(BD:99)-1)
            ENDIF
            Break
        ENDIF
    Proximo
    CerrarLink(1)
Proximo

ACN(FI:99, fac+2)

IF Val(BY:1) + Val(BY:2) > 0
    ***---Hay Buyers
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Buyers')
        ACN(B:fac, Val(BY:1))
        ACN(C:fac, Val(BY:2))
        ACN(D:fac, Val(BY:1) + Val(BY:2))
        ACN(E:fac, Val(TY:3))
        ACN(F:fac, Val(ZY:3))
        SetFont(A:fac, 2)
    ENDIF
    SCN(TC:1, Val(BY:1))
    SCN(TC:2, Val(BY:2))
    SCN(TC:3, Val(BY:1) + Val(BY:2))
    SCN(TW:1, (Val(BY:1) + Val(BY:2)) * Val(TY:3))
    SCN(TP:1, (Val(BY:1) + Val(BY:2)) * Val(ZY:3))
ENDIF
IF Val(TO:1) + Val(TO:2) > 0
    ***---Hay ONs
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Obligaciones Negociables')
        SetFont(A:fac, 2)
        ACN(B:fac, Val(TO:1))
        ACN(C:fac, Val(TO:2))
        ACN(D:fac, Val(TO:1) + Val(TO:2))
        ACN(E:fac, Val(TN:3))
        ACN(F:fac, Val(ZN:3))
        ACN(BD:88, 0)
        ACN(PO:1, fac)
        Repetir
            ***---Bajo el detalle de ONs
            SCN(BD:88, 1)
            SetFilaActual(fac+2)
            ACT(A:fac, Val(EO:(Val(BD:88)*10)+1))
            ACN(B:fac, Val(ON:(Val(BD:88)*10)+1))
            ACN(C:fac, Val(ON:(Val(BD:88)*10)+2))
            ACN(D:fac, Val(ON:(Val(BD:88)*10)+3))
            ACN(E:fac, Val(TD:(Val(BD:88)*10)+3))
            ACN(F:fac, Val(ZD:(Val(BD:88)*10)+3))
            SCN(TW:1, Val(D:fac) * Val(E:fac))
            SCN(TP:1, Val(D:fac) * Val(F:fac))
            SCN(OT:1, Val(D:fac) * Val(E:fac))
            SCN(OP:1, Val(D:fac) * Val(F:fac))
            IF Val(BD:88) = Val(UO:1)
                Break
            ENDIF
        Proximo
        ***---Tasa y Plazo Promedio del total de ONs
        ACN(E:Val(PO:1), Val(OT:1) / Val(D:Val(PO:1)))
        ACN(F:Val(PO:1), Val(OP:1) / Val(D:Val(PO:1)))
        SetFont(A:Val(PO:1)+2..A:fac, 1)
    ELSE
        ***---Consolidado
        ACN(BD:88, 0)
        Repetir
            ***---Bajo las Tasas y Plazos del detalle de ONs
            SCN(BD:88, 1)
            SCN(TW:1, Val(ON:(Val(BD:88)*10)+3) * Val(TD:(Val(BD:88)*10)+3))
            SCN(TP:1, Val(ON:(Val(BD:88)*10)+3) * Val(ZD:(Val(BD:88)*10)+3))
            IF Val(BD:88) = Val(UO:1)
                Break
            ENDIF
        Proximo
    ENDIF
    SCN(TC:1, Val(TO:1))
    SCN(TC:2, Val(TO:2))
    SCN(TC:3, Val(TO:1) + Val(TO:2))
ENDIF
IF Val(PF:1) + Val(PF:2) > 0
    ***---Hay Prestamos Financieros
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Prestamos Financieros')
        ACN(B:fac, Val(PF:1))
        ACN(C:fac, Val(PF:2))
        ACN(D:fac, Val(PF:1) + Val(PF:2))
        ACN(E:fac, Val(TF:3))
        ACN(F:fac, Val(ZF:3))
        SetFont(A:fac, 2)
    ENDIF
    SCN(TC:1, Val(PF:1))
    SCN(TC:2, Val(PF:2))
    SCN(TC:3, Val(PF:1) + Val(PF:2))
    SCN(TW:1, (Val(PF:1) + Val(PF:2)) * Val(TF:3))
    SCN(TP:1, (Val(PF:1) + Val(PF:2)) * Val(ZF:3))
ENDIF

IF Val(PL:1) + Val(PL:2) > 0
    ***---Hay Prestamos Financieros Locales
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Prestamos Financieros (Locales)')
        ACN(B:fac, Val(PL:1))
        ACN(C:fac, Val(PL:2))
        ACN(D:fac, Val(PL:1) + Val(PL:2))
        ACN(E:fac, Val(TL:3))
        ACN(F:fac, Val(ZL:3))
        SetFont(A:fac, 2)
    ENDIF
    SCN(TC:1, Val(PL:1))
    SCN(TC:2, Val(PL:2))
    SCN(TC:3, Val(PL:1) + Val(PL:2))
    SCN(TW:1, (Val(PL:1) + Val(PL:2)) * Val(TL:3))
    SCN(TP:1, (Val(PL:1) + Val(PL:2)) * Val(ZL:3))
ENDIF
IF Val(PS:1) + Val(PS:2) > 0
    ***---Hay Prestamos Sindicados
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Prestamos Sindicados')
        ACN(B:fac, Val(PS:1))
        ACN(C:fac, Val(PS:2))
        ACN(D:fac, Val(PS:1) + Val(PS:2))
        ACN(E:fac, Val(TS:3))
        ACN(F:fac, Val(ZS:3))
        SetFont(A:fac, 2)
    ENDIF
    SCN(TC:1, Val(PS:1))
    SCN(TC:2, Val(PS:2))
    SCN(TC:3, Val(PS:1) + Val(PS:2))
    SCN(TW:1, (Val(PS:1) + Val(PS:2)) * Val(TS:3))
    SCN(TP:1, (Val(PS:1) + Val(PS:2)) * Val(ZS:3))
ENDIF
IF Val(TV:1) + Val(TV:2) > 0
    ***---Hay Tomas Vinculadas
    IF Val(RA:1) = 0
        ***---No Consolidado
        SetFilaActual(fac+2)
        ACT(A:fac, 'Tomas Vinculadas')
        ACN(B:fac, Val(TV:1))
        ACN(C:fac, Val(TV:2))
        ACN(D:fac, Val(TV:1) + Val(TV:2))
        ACN(E:fac, Val(TZ:3))
        ACN(F:fac, Val(ZV:3))
        SetFont(A:fac, 2)
    ENDIF
    SCN(TC:1, Val(TV:1))
    SCN(TC:2, Val(TV:2))
    SCN(TC:3, Val(TV:1) +  Val(TV:2))
    SCN(TW:1, (Val(TV:1) + Val(TV:2)) * Val(TZ:3))
    SCN(TP:1, (Val(TV:1) + Val(TV:2)) * Val(ZV:3))
ENDIF

SetFilaActual(fac+2)
ACN(B:fac, Val(TC:1))
ACN(C:fac, Val(TC:2))
ACN(D:fac, Val(TC:3))
ACN(E:fac, Val(TW:1) / Val(D:fac))
ACN(F:fac, Val(TP:1) / Val(D:fac))

IF Val(RA:1) = 0
    ***---No Consolidado
    SetFont(B:Val(FI:55)..F:fac-1, 1)
    AgregarMarco(A:Val(FI:55)..F:fac, 1, 2)
    ACT(A:fac, 'Total DEUDAS '~ItemLista(Val(LS:100), &i))
    AgregarMarco(A:fac..F:fac, 0, 2, Exe('COLOR6'))
    SetFont(A:fac..F:fac, 2)
    FormatoCeldas(E:Val(FI:99)..E:fac, Exe('F8'))
    SCN(XX:1, Val(TC:1))
    SCN(XX:2, Val(TC:2))
    SCN(XX:3, Val(TC:3))
ELSE
    ACT(A:fac, 'Total '~ItemLista(Val(LS:1000), &k))
    SCN(TT:1, Val(TC:1))
    SCN(TT:2, Val(TC:2))
    SCN(TT:3, Val(TC:3))
    SCN(TT:4, Val(D:fac) * Val(E:fac))
    SCN(TT:5, Val(D:fac) * Val(F:fac))
ENDIF

