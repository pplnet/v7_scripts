If Incluido(Dialogo.TipoOp1,'SEABD|SEABP|SERA|SERAV|SECT|SECTV|SEVT|SEVTV|SERP|SERPV')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp2, O.FechaOp, O.Cliente1, O.Especie, O.Cantidad, O.Plazo, O.FechaVto,")
   SQL.ADD(" O.Precio1, O.FormaLiquidacion1, O.Cartera, O.TotalIntereses, O.InteresesCorr, O.Precio3, O.TotalNetoCli1,")
   SQL.ADD(" O.TotalBrutoCli1, O.ImpGastos1, O.Mercado, O.Mercado2, O.RB10, O.ContraEspecie, O.Plazo2, O.FechaPago, ")
   SQL.ADD(" O.PaseCB, O.Precio2, O.Precio3, O.TotalNetoCli2, O.TotalBrutoCli2, O.ImpGastos2, O.Plazo3, O.Plazo4, ")
   SQL.ADD(" O.FechaVto2, O.FechaEj ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If Incluido(Dialogo.TipoOp1,'SEABD|SEABP|SECT|SECTV|SEVT|SEVTV')
      SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   Else
      SQL.ADD("  and O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   Endif
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif
