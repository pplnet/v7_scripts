SQL.ADD(" AND O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
SQL.ADD(" AND O.FechaVto2 Between '"~IdxDate(Val(FE:2))~"' AND '"~IdxDate(Val(FE:3))~"' ")
SQL.ADD(" AND O.TotalAux3 > 0 ")

SQL.ADD(" UNION ")

