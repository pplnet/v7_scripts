SQL.ADD(" O.Observaciones, 'Imp' as BD1, TasaImp1 as Tasa, 'Impto.Int' as DescImp, O.Plazo ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMPLME') ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" AND O.TipoOp = '"~Dialogo.TipoOp1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
SQL.ADD(" AND O.FechaVto Between '"~IdxDate(Val(FE:2))~"' AND '"~IdxDate(Val(FE:3))~"' ")
SQL.ADD(" AND O.ImporteImp > 0 ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.Cliente1, O.Especie, C.Fecha1 Vto, ")
SQL.ADD(" C.Importe1/"~Fstr(Val(R:2), 0, 0)~" as Importe, O.NrOperacion, Tipo, O.Observaciones, ")
SQL.ADD(" 'Imp' as BD1, C.Tasa1 as Tasa, 'Comisiones' as DescImp, O.Plazo ")
SQL.ADD(" From "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" AND O.TipoOp = '"~Dialogo.TipoOp1~"' ")
ENDIF
SQL.ADD(" AND (O.TipoOp IN ('MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPLME','MMPSI','MMSIMV','MMFRNP','MMFIMV') ")
SQL.ADD(" OR (O.TipoOp IN ('MMP') AND Tipo='4')) ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha1  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Tipo <> '5' ")
SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
SQL.ADD(" AND C.Fecha1 Between '"~IdxDate(Val(FE:2))~"' AND '"~IdxDate(Val(FE:3))~"' ")
SQL.ADD(" AND C.Importe1 > 0 ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.Cliente1, O.Especie, C.Fecha1 Vto, ")
SQL.ADD(" C.Importe1/"~Fstr(Val(R:2), 0, 0)~" as Importe, O.NrOperacion, Tipo, O.Observaciones, ")
SQL.ADD(" 'Imp' as BD1, C.Tasa1 as Tasa, 'Comisiones' as DescImp, O.Plazo ")
SQL.ADD(" From "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" AND O.TipoOp = '"~Dialogo.TipoOp1~"' ")
ENDIF
SQL.ADD(" AND O.TipoOp In ('MMON','MMONM') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha1 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND  C.Tipo <> '5' ")
SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
SQL.ADD(" AND C.Fecha1 Between '"~IdxDate(Val(FE:2))~"' AND '"~IdxDate(Val(FE:3))~"' ")
SQL.ADD(" AND C.Importe1 > 0 ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.Cliente1, O.Especie, O.FechaVto2 Vto, ")
SQL.ADD(" O.TotalAux3/"~Fstr(Val(R:2), 0, 0)~" as Importe, O.NrOperacion, 'OPE' as Tipo, ")
SQL.ADD(" O.Observaciones, 'Imp' as BD1, O.TotalAux1 as Tasa, 'whith tax' as DescImp, O.Plazo ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMON') ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.TipoOp1)
