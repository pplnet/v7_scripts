CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')


*If Dialogo.Radio2 = 0
*    ACT(a:fac+5, 'P&L Precio de Transferencia - Detalle')
*Else
*    ACT(a:fac+5, 'P&L Tasa de Transferencia - Detalle')
*EndIf
*SetFont(a:fac+5, 3)

ACT(a:fac+7, 'Fecha P&L Desde: '~Dialogo.Fecha1)
ACT(a:fac+8, 'Fecha P&L Hasta: '~Dialogo.Fecha2)

If Vacio(Dialogo.Lista1)
    ACT(a:fac+9,'Tipo de operacion: '~VAR('PYLOPTASA'))
ELSE
    ACT(a:fac+9,'Tipo de operacion: '~Pipe2Coma(Dialogo.Lista1))
    
ENDIF

IF Vacio(Dialogo.Cliente1) 
    ACT(a:fac+10,'Cliente: Todos')
ELSE
    ACT(a:fac+10,'Cliente: '~Dialogo.Cliente1)
ENDIF

IF Vacio(Dialogo.OficialCuenta)
    ACT(a:fac+11,'Oficial: Todos')
ELSE
    ACT(a:fac+11,'Oficial: '~Dialogo.OficialCuenta  ~" "~ SQL("Select Descripcion FROM "~dbo~".OFICIALESCUENTA Where Codigo ='"~Dialogo.OficialCuenta~"'")~" ")
ENDIF

IF Vacio(Dialogo.Cuenta1)
    ACT(c:fac+7,'Cuenta: Todas')
ELSE 
    ACT(c:fac+7,'Cuenta: '~Dialogo.Cuenta1)
ENDIF

IF No Vacio(Dialogo.Cuenta3)
   ACT(c:fac+7,'Cuenta: '~Dialogo.Cuenta3)
endif

IF Vacio(Dialogo.GrupoEconomico)
    ACT(c:fac+8,'Grupo Economico: Todos')
ELSE
    ACT(c:fac+8,'Grupo Economico: '~Dialogo.GrupoEconomico)
ENDIF


If Dialogo.Radio3 =0
ACT(c:fac+9,'Moneda Origen: ARP')
    else if Dialogo.Radio3 =1
        ACT(c:fac+9,'Moneda Origen: USD')
    else
        ACT(c:fac+9,'Moneda Origen: TODAS')
        endif
endif

If Dialogo.Radio4 =0
    ACT(c:fac+10,'Moneda Resultado: ARP')
else 
    ACT(c:fac+10,'Moneda Resultado: USD')
endif

ACT(c:fac+11,'Cantidad de días para promedio: '~FStr(&DifDias))
ACT(a:fac+12,'Operaciones del dia: solo se incluyen operaciones en Instancias Terminal/Liquidación/Remuneradas Vigentes')
ACT(a:fac+13,'Se incluyen todas las operaciones vigentes entre las Fechas P&L definidas')
SetFont(a:fac+12..a:fac+13,1)
SetFilaActual(14)

