**RESULTADOS SEC Y FCI DEL DÍA
SQL.ADD(" Select Especie,Sum(VRMEDAY+RRMEDAY+CRMEDAY+INMEDAY) as 'Resultado' from "~DBO~".RESULTADOS2 Where Fecha ='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Vehiculo='"~&vehiculo~"' AND Book='"~&book~"' and NrSaldo=1 ")
SQL.ADD(" Group by Especie ")
Recorrer SQL
    **Se llama a funcion por bonos ajustados por índice
    let &espBonInd fbn('Especie')
    let &fechaBonInd1 Dialogo.Fecha1
    let &fechaBonInd2 Dialogo.Fecha1
    let &monto 0
    (.'BONAJUIND'.)
    **
    let &cotiza Buscarcampo('ESPECIES','Cotiza','Codigo',fbn('Especie'))
    let &monedaTC1 &cotiza
    If EqStr(&cotiza,&monedaLocal)
    let &dayML &dayML+fbn('Resultado')+&monto
        let &monedaTC2 &monedaExtr
        @TIPOCAMBIO
        let &dayME &dayME+((fbn('Resultado')+&monto)*&tc)
    Else
        let &dayME &dayME+fbn('Resultado')+&monto
        let &monedaTC2 &monedaLocal
        @TIPOCAMBIO
        let &dayML &dayML+((fbn('Resultado')+&monto)*&tc)
    Endif
Proximo


**RESULTADOS MM DEL DÍA
SQL.ADD(" Select Especie,Sum(Monto) as 'Resultado' from "~DBO~".MOVDEVENGADOS Where Fecha ='"~IdxDate(Dialogo.Fecha1)~"' and NrSaldo=140 and TipoDevengado='INTLEN' ")
SQL.ADD(" AND Vehiculo='"~&vehiculo~"' AND Book='"~&book~"' and Especie IN ('"~&monedaLocal~"','"~&monedaExtr~"') ")
SQL.ADD(" Group By Especie")
Recorrer SQL
    If EqStr(FBN('Especie'),&monedaLocal)
        let &monedaTC1 &monedaExtr
        let &dayML &dayML+fbn('Resultado')
        let &monedaTC2 &monedaLocal
        @TIPOCAMBIO
        let &dayME &dayME+(fbn('Resultado')*&tc)
    Else
        let &monedaTC1 &monedaLocal
        let &dayME &dayME+fbn('Resultado')
        let &monedaTC2 &monedaExtr
        @TIPOCAMBIO
        let &dayML &dayML+(fbn('Resultado')*&tc)
    Endif
Proximo

**DC (Suma en la tabla DayML El campo DC de la tabla DCMM)
let &dC SQL("Select Sum(DC) from "~DBO~".DCMM Where Vehiculo='"~&vehiculo~"' and Book='"~&book~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")
let &dayML &dayML+&dC
**

let &ayer Habiles(Dialogo.Fecha1,-1,'ARG',SI)
let &vCartMLAyer QUERY(" Select ValorCarteraML from "~DBO~".RENTABILIDAD Where Fecha ='"~IdxDate(&ayer)~"'  AND Vehiculo = '"~&vehiculo~"' AND Book='"~&book~"' ")

*Si al día de ayer no hay Valor Cartera, la rentabilidad del dia es 0
If Round(&vCartMLAyer,0)=0
    let &rentabilidad 0
Else
    **Calculo la rentabilidad
    let &rentabilidad &dayML/&vCartMLAyer
Endif  

*If &vCartMLAyer=0
*    let &vCartMLAyer 1
*Endif
*
*let &rentabilidad &dayML/&vCartMLAyer

SQL.ADD("UPDATE "~DBO~".RENTABILIDAD  ")
SQL.ADD("Set DayML = "~FStr(&dayML,0,2)~" ,DayME = "~FStr(&dayME,0,2)~" ,Rentabilidad="~FStr(&rentabilidad,0,8)~", ")
SQL.ADD("FechaCarga = "~SQLAhora~", FechaCargaSys = '"~IdxDate(FSYS)~"'  ") 
SQL.ADD("Where Fecha ='"~IdxDate(Dialogo.Fecha1)~"'  AND Vehiculo = '"~&vehiculo~"' AND Book='"~&book~"'  ") 
SQL.NEW
SQL.EXEC

