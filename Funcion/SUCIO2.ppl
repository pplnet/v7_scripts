*** ca:fac: Especie, ck:fac: Fecha de interes ***
IF Eqstr(Val(aa0),'CLE')

   IF EqStr(Val(ag0),'360')
      acn(cb:fac, 0)
   ELSE
      IF EqStr(Val(ag0),'365')
         acn(cb:fac, 1)
      ELSE
         acn(cb:fac, 2)
      ENDIF
   ENDIF
   IF EqStr(Val(ah0),'30')
      acn(cc:fac, 0)
   ELSE
      IF EqStr(Val(ah0),'REA')
         acn(cc:fac, 1)
      ELSE
         IF EqStr(Val(ah0),'30E')
            acn(cc:fac, 2)
         ELSE
            acn(cc:fac, 3)
         ENDIF
      ENDIF
   ENDIF
   acn(cd:fac,iif(val(cb:fac)=0 y val(cc:fac)=0,1,0))
   acn(ce:fac,Val(ab0))
   acd(cf:fac,Val(ac0))

   acd(cg:fac,UltCupon2(val(ca:fac),val(ck:fac)))
   ***acd(cg:fac, Val(cl:fac))

   If Not [Val(cc:fac)=0 o EsHabil(val(cg:fac),'USA')]
      acd(cg:fac,Habiles(val(cg:fac),Val(ad0),'USA'))
   Endif

   If Val(cf:fac) > Val(cg:fac) y Val(cf:fac) <= val(ck:fac)
      acn(ch:fac,((Val(ae0)*iif(Val(cd:fac)=1,Dif360(Val(cg:fac),Val(cf:fac)-1,2),DifDias(Val(cg:fac),Val(cf:fac)-1,'USA',NO)))+(Val(ce:fac)*(iif(Val(cd:fac)=1,Dif360(Val(cf:fac)-1,val(ck:fac),2),DifDias(Val(cf:fac)-1,val(ck:fac),'USA',NO)))))/(iif(Val(cd:fac)=1,Dif360(Val(cg:fac),val(ck:fac),2),DifDias(Val(cg:fac),val(ck:fac),'USA',NO)))*100)
   Else
      acn(ch:fac,Val(ce:fac)*100)
   Endif

   acn(cj:fac,Val(ch:fac)*iif(Val(cd:fac)=1,Dif360(Val(cg:fac),val(ck:fac),2),DifDias(Val(cg:fac),val(ck:fac),'USA',NO))/(DiasA(Val(cb:fac),FSYS,Val(af0))*100))

   acn(ci:fac,ValorTeorico2(val(ca:fac),val(ck:fac)))

   ***acn(ci:fac, Val(cm:fac))
Else
   acn(cj:fac,0)
   acn(ci:fac,1)
Endif
