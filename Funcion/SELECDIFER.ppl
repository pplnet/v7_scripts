
* Saldos  --------------------------------------------------------------------------------- *
* Alias5 de Especies muestra la cantidad de Decimales

*1- transferencias comunes pendientes (CLIENTE 1)--------------------------------------------------------
SQL.ADD("Select DISTINCT E.CodNumCajaValores, MP.Especie, MP.Cupon, T.Cliente1 as Cliente, 'PEND' Estado, ")
SQL.ADD("       T.TipoTr2, MP.Cuenta, MP.Cantidad, 'DIR' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, T.Fecha2, T.Fecha3, T.CB2, T.RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, MP.FechaMov, MP.FechaEje, '1' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T JOIN "~DBO~".MOVPENDIENTES MP WITH (NOLOCK) ON T.NrTrans = MP.NrOperacion ")
SQL.ADD(" JOIN "~DBO~".CUENTAS CT ON MP.Cuenta = CT.Codigo ")
SQL.ADD(" JOIN "~DBO~".ESPECIES E ON MP.Especie=E.Codigo  ")
SQL.ADD(" where  MP.FechaMov Between "~IdxDate2(Dialogo.Fecha2)~" and "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2 In ('DTP','RTP','DRT') ")
*- No internas
SQL.ADD("  and  T.CB2 <> '1' ")
SQL.ADD("  and  MP.NrMov < 3 ")
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and T.Cliente1 = MP.Cliente ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND MP.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND MP.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND MP.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

*2- transferencias comunes ejecutadas (CLIENTE 1)--------------------------------------------------------
SQL.ADD("UNION ALL ")

SQL.ADD("Select  DISTINCT E.CodNumCajaValores, ME.Especie, ME.Cupon, T.Cliente1 as Cliente, 'EJEC' Estado, ")
SQL.ADD("       T.TipoTr2, ME.Cuenta, ME.Cantidad, 'DIR' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, T.Fecha2, T.Fecha3, T.CB2, T.RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, ME.FechaMov, ME.FechaEje, '2' NrSel")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T JOIN "~DBO~".MOVEJECUTADOS ME WITH (NOLOCK) ON T.NrTrans = ME.NrOperacion ")
SQL.ADD(" JOIN "~DBO~".CUENTAS CT ON ME.Cuenta = CT.Codigo ")
SQL.ADD(" JOIN "~DBO~".ESPECIES E ON ME.Especie=E.Codigo  ")
*-SQL.ADD(" where  ME.FechaEje = "~IdxDate2(Dialogo.Fecha1)~" ")

*- matcheadas hoy
SQL.ADD(" where    ((ME.FechaEje = "~IdxDate2(Dialogo.Fecha1)~" AND T.RB2=1) ")
*- CONFORMADAS
**SQL.ADD(" or (ME.FechaEje = "~IdxDate2(Dialogo.Fecha1)~" AND T.RB2=0 AND T.RB1=0 and ME.FechaMov = ME.FechaEje)  ")
*- CONFORMADAS O COMUNES
SQL.ADD(" or (ME.FechaEje = "~IdxDate2(Dialogo.Fecha1)~" AND T.RB2=0 AND T.RB1<=0 and ME.FechaMov = ME.FechaEje)  ")

*- las fecha valor
SQL.ADD(" or (ME.FechaMov = "~IdxDate2(Dialogo.Fecha1)~" AND ME.FechaMov < ME.FechaEje AND T.RB2=0))  ")

*- No internas
SQL.ADD("  and  T.CB2 <> '1' ")
SQL.ADD("  and  ME.NrMov < 3 ")
SQL.ADD("  and  T.TipoTr2 In ('DTP','RTP','DRT') ")
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and T.Cliente1 = ME.Cliente ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND ME.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND ME.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND ME.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

*3 Transferencias Internas pendientes (CLIENTE 2)----------------------------------------------------------------------------------- *
SQL.ADD("UNION ALL ")

SQL.ADD("Select  DISTINCT E.CodNumCajaValores, MP.Especie, MP.Cupon, MP.Cliente, 'PEND' Estado, ")
SQL.ADD("       T.TipoTr2, MP.Cuenta, MP.Cantidad, 'INV' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, T.Fecha2, T.Fecha3, T.CB2, T.RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
** FJL 22/02/24 - Issue EXTBIND-5957
*SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, MP.FechaMov, MP.FechaEje, '3' NrSel ")
SQL.ADD("       T.CB1, T.Cliente4, ")
SQL.ADD("       CASE WHEN T.TipoTr2='DRT' THEN CASE WHEN MP.Cuenta=T.Cuenta1 THEN T.Cuenta2 ELSE T.Cuenta1 END ELSE T.Cuenta2 END Cuenta2, ")
SQL.ADD("       T.ComitenteExt, MP.FechaMov, MP.FechaEje, '3' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T JOIN "~DBO~".MOVPENDIENTES MP WITH (NOLOCK) ON T.NrTrans = MP.NrOperacion ")
SQL.ADD(" JOIN "~DBO~".CUENTAS CT ON MP.Cuenta = CT.Codigo ")
SQL.ADD(" JOIN "~DBO~".ESPECIES E ON MP.Especie=E.Codigo  ")
SQL.ADD(" where MP.NrSaldo = 101 ")
SQL.ADD("  and  MP.NrMov < 3 ")
SQL.ADD("  and  MP.FechaMov between "~IdxDate2(Dialogo.Fecha2)~" and "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2 In ('DTP','RTP','DRT') ")
SQL.ADD("  and  T.CB1 ='1' ")
SQL.ADD("  and  T.CB2 ='1' ")
if NoVacio(Dialogo.Mercado1)
*  SQL.ADD("  and  T.Mercado2 = '"~Dialogo.Mercado1~"' ")
  SQL.ADD("  and  MP.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND MP.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND MP.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND MP.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

