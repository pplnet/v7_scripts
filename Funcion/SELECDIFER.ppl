*7.1 CUPON Pendientes - Bonos
SQL.ADD("UNION ALL ")

SQL.ADD("select  DISTINCT E2.CodNumCajaValores, E.Codigo as Especie, M.Cupon, M.Cliente, 'PEND' Estado, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E2.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '7.1' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS CT,  ")
SQL.ADD(" "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E, "~DBO~".ESPECIES E2  ")
SQL.ADD(" where M.Especie   = E.Codigo      ")
SQL.ADD("  AND  T.NrTrans   = M.NrOperacion ")
SQL.ADD("  AND  M.Cuenta    = CT.Codigo ")
SQL.ADD("  AND  T.Cupon1    = A.NrCupon ") 
SQL.ADD("  and  E2.Codigo   = E.Codigo  ")
SQL.ADD("  and  E2.Codigo   = A.Especie ")
* El Movimiento es del bono
SQL.ADD("  and  T.Especie   = M.Especie ")
** FJL 21/02/24 - Issue EXTBIND-5957 - Solo si es el ultimo Cupon
SQL.ADD("  and  T.Cupon2    = 0 ")
SQL.ADD("  and  M.FechaMov between "~IdxDate2(Dialogo.Fecha2)~" and "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   = 'CUPON' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  M.Mercado   = 'CV' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

*8 CUPON Ejecutados - Cupònes ------------------------------------------------------------------------------------ *
** FJL 23/02/24 - Issue EXTBIND-5957 - Comentario del 22/02/24 - En el Excel se pide sacar los cupones
IF NO
SQL.ADD("UNION ALL ")

SQL.ADD("select  DISTINCT E2.CodNumCajaValores, E.Codigo as Especie, M.Cupon, M.Cliente, 'EJEC' Estado, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E2.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '8' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS CT, ")
SQL.ADD(" "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E, "~DBO~".ESPECIES E2 ")
SQL.ADD(" where M.Especie   = E.Codigo      ")
SQL.ADD("  and  T.NrTrans   = M.NrOperacion ")
SQL.ADD("  and  M.Cuenta    = CT.Codigo ")
SQL.ADD("  and  T.Cupon1    = A.NrCupon ")
SQL.ADD("  and  E2.Alias9   = E.Codigo  ")
SQL.ADD("  and  E2.Codigo   = A.Especie ")
* El Movimiento es de la especie Cupon
SQL.ADD("  and  T.Especie2  = M.Especie ")
SQL.ADD("  and  M.FechaEje  = "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   = 'CUPON' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  M.Mercado   = 'CV' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

ENDIF
