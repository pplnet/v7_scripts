*14 MAC 15/02/23 - Por pedido en Issue 5957
* saldos Vigentes que no fueron impactados por mov --------------------------------------------------------------------------- *

sql.add("union all")
sql.add("select e.CodNumCajaValores,sld.Especie,sld.Cupon,sld.cliente,'SALD' Estado,                                                                                                                      ")
sql.add(" 'SALD' TipoTr2,sld.Cuenta,sld.Saldo cantidad,'' Tipo,'' NrTrans, '' Cliente2,                                                                                                                   ")
sql.add(" sld.fecha fechamov, sld.fecha fechamov, null Fecha2, null Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre,                                                ")
sql.add(" '0' CB1, '' Cliente4, '' Cuenta2, '' ComitenteExt, sld.fecha FechaMov, sld.fecha FechaEje, '14' NrSel ")
sql.add(" --sld.*                                                                                                                                                                                         ")
sql.add(" from dbo.saldosdia sld join dbo.clientes cli on sld.cliente = cli.codigo                                                                                                                        ")
sql.add(" join dbo.especies e on sld.Especie = e.codigo                                                                                                                                                   ")
sql.add(" join dbo.cuentas ct on sld.Cuenta = ct.Codigo                                                                                                                                                   ")
sql.add(" where                                                                                                                                                                                           ")
sql.add(" sld.nrsaldo in (101)  ")
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  CT.Mercado = '"~Dialogo.Mercado1~"' ")
endif
IF NoVacio(Dialogo.ListaTabla1)
   *MAC cambio cliente
   *SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
   SQL.ADD("  AND cli.codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
sql.add(" and sld.Saldo <> 0 ")
SQL.ADD(" and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")
*SQL.ADD(" and sld.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
*MAC Se retira exclusion de movpendientes y movejecutados porque cuando se liquida desaparece el saldo
if dialogo.check1 = 1
    sql.add(" and exists (select 1 from dbo.movejecutados me where me.nrsaldo=sld.nrsaldo and me.Especie=sld.especie and me.cliente = sld.cliente and me.Cuenta = sld.cuenta and me.fechamov ="~IdxDate2(Dialogo.Fecha1)~")")
    *sql.add(" and exists (select 1 from dbo.movpendientes mp where mp.nrsaldo=sld.nrsaldo and mp.Especie=sld.especie and mp.cliente = sld.cliente and mp.Cuenta = sld.cuenta and mp.fechamov ="~IdxDate2(Dialogo.Fecha1)~")")
endif
sql.add(" and sld.fecha in (select max(fecha)              ")
sql.add(" from dbo.saldosdia sld2                          ")
sql.add(" where sld2.especie = sld.especie                 ")
sql.add(" and sld2.cliente=sld.cliente                     ")
sql.add(" and sld2.nrsaldo = sld.nrsaldo                   ")
sql.add(" and sld.cuenta = sld2.cuenta                     ")
*sql.add(" and sld2.fecha < "~IdxDate2(Dialogo.Fecha1)~")")
*MAC es el saldo de la fecha inical menos 1
sql.add(" and sld2.fecha < "~IdxDate2(Dialogo.Fecha1-1)~")")

SQL.ADD(" Order By 1,2,18,10 ")

