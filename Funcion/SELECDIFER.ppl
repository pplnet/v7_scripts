*5 LCUPON Pendientes ---------------------------------------------------------------------------------------------------- *
** FJL 23/02/24 - Issue EXTBIND-5957 - Comentario del 22/02/24 - En el Excel se pide sacar los cupones
IF NO
SQL.ADD("UNION ALL ")

*SQL.ADD("select  DISTINCT E.CodNumCajaValores, E.Codigo as Especie, M.Cupon, M.Cliente, 'PEND' Estado, ")
SQL.ADD("select  DISTINCT E.CodNumCajaValores, M.Especie as Especie, M.Cupon, M.Cliente, 'PEND' Estado, ")
*SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad*A.PorAmCapital/100 as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '5' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" JOIN "~DBO~".MOVPENDIENTES M WITH (NOLOCK) ON T.NrTrans = M.NrOperacion ")
SQL.ADD(" JOIN "~DBO~".CUENTAS CT ON M.Cuenta = CT.Codigo ")
SQL.ADD(" JOIN "~DBO~".AGENDACUPONES A  ON  T.Cupon1 = A.NrCupon ")
SQL.ADD(" JOIN "~DBO~".ESPECIES E  ON  E.Codigo = A.Especie ")
SQL.ADD(" where M.Especie   = E.Alias9 ")
SQL.ADD("  and  T.Especie   = M.Especie")
SQL.ADD("  and  M.FechaMov between "~IdxDate2(Dialogo.Fecha2)~" and "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   = 'LCUPON' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  M.Mercado   = 'CV' ")
SQL.ADD("  and  M.Cantidad*A.PorAmCapital/100 <> 0 ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 16/11/22 - Solo Cuentas con Depositante el Vehiculo
SQL.ADD("  and CT.Comitente = '"~Dialogo.Vehiculo1~"' ")

*6 LCUPON Ejecutados ---------------------------------------------------------------------------------------------------- *
SQL.ADD("UNION ALL ")

*SQL.ADD("select  DISTINCT E.CodNumCajaValores, E.Codigo as Especie, M.Cupon, M.Cliente, 'EJEC' Estado, ")
SQL.ADD("select  DISTINCT E.CodNumCajaValores, M.Especie as Especie, M.Cupon, M.Cliente, 'EJEC' Estado, ")
*SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad*A.PorAmCapital/100 as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, M.Cantidad as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '6' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" JOIN "~DBO~".MOVEJECUTADOS M WITH (NOLOCK) ON  T.NrTrans   = M.NrOperacion ")
SQL.ADD(" JOIN  "~DBO~".CUENTAS CT  ON  M.Cuenta    = CT.Codigo ")
SQL.ADD(" JOIN  "~DBO~".AGENDACUPONES A  ON  T.Cupon1    = A.NrCupon ")
SQL.ADD(" JOIN  "~DBO~".ESPECIES E  ON  E.Codigo    = A.Especie ")
SQL.ADD(" where M.Especie   = E.Alias9 ")
SQL.ADD("  and  T.Especie   = M.Especie ")
SQL.ADD("  and  M.FechaEje = "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   = 'LCUPON' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  M.Mercado   = 'CV' ")
*SQL.ADD("  and  M.Cantidad*A.PorAmCapital/100 <> 0 ")
SQL.ADD("  and  M.Cantidad*A.PorAmCapital/100 <> 0 ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
