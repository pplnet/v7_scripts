*12 LCUPON Ejecutados ---------------------------------------------------------------------------------------------------- *
** FJL 21/02/24 - Se sacan las monedas por issue EXTBIND-5957 - Informe Difer completo
IF NO
SQL.ADD("UNION ALL ")

SQL.ADD("select E.CodNumCajaValores, M.Especie as Especie, M.Cupon, M.Cliente, 'EJEC' Estado, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, Sum(M.Cantidad) as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '12' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" JOIN "~DBO~".MOVEJECUTADOS M WITH (NOLOCK) ON  T.NrTrans   = M.NrOperacion ")
SQL.ADD(" JOIN  "~DBO~".CUENTAS CT  ON  M.Book    = CT.Codigo ")
SQL.ADD(" JOIN  "~DBO~".ESPECIES E  ON  E.Codigo  = M.Especie ")
SQL.ADD(" where T.Especie1   = M.Especie ")
SQL.ADD("  and  M.FechaEje = "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   = 'LCUPON' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  AND  M.NrSaldo = 1 ")
SQL.ADD("  AND  M.NrGrupo in (1,2) ")
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  CT.Mercado = '"~Dialogo.Mercado1~"' ")
endif
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF

SQL.ADD("Group by E.CodNumCajaValores, M.Especie, M.Cupon, M.Cliente, ")  
SQL.ADD("         T.Fecha1, T.FechaCargaSys, CONVERT(int,CT.NrDepositante), E.Alias5, E.Nombre,  ")
SQL.ADD("         T.TipoTr2, M.Cuenta, T.NrTrans, T.Cliente2,  ")
SQL.ADD("         T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje ")

ENDIF
*** FIN IF NO ***

*13 FJL 21/12/22 - Por pedido en Issue 5957
* DENOP-RENOP-TRNOP Sobre la cuenta Vista --------------------------------------------------------------------------- *
** FJL 12/03/24 - Se sacan las monedas por issue EXTBIND-5957 - Informe Difer completo - Comentario del 4/3/24
IF NO
SQL.ADD("UNION ALL ")

SQL.ADD("select E.CodNumCajaValores, M.Especie as Especie, M.Cupon, M.Cliente, 'EJEC' Estado, ")
SQL.ADD("       T.TipoTr2, M.Cuenta, Sum(M.Cantidad) as Cantidad, '' Tipo, T.NrTrans, T.Cliente2 Cliente2, ")
SQL.ADD("       T.Fecha1, T.FechaCargaSys, 0 Fecha2, 0 Fecha3, '0' CB2, '0' RB1, CONVERT(int,CT.NrDepositante) Comitente, E.Alias5, E.Nombre, ")
SQL.ADD("       T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje, '13' NrSel ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" JOIN  "~DBO~".MOVEJECUTADOS M WITH (NOLOCK) ON  T.NrTrans   = M.NrOperacion ")
SQL.ADD(" JOIN  "~DBO~".CUENTAS CT  ON  M.Cuenta    = CT.Codigo ")
SQL.ADD(" JOIN  "~DBO~".ESPECIES E  ON  E.Codigo    = M.Especie ")
SQL.ADD(" where T.Especie   = M.Especie ")
SQL.ADD("  and  M.FechaEje = "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2   in ('DENOP','RENOP','TRNOP') ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  AND  M.NrSaldo = 1 ")
SQL.ADD("  AND  M.NrGrupo in (26) ")
SQL.ADD("  and  CT.Mercado = '"~VAR('MERAUXLIQ')~"' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("  AND M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("  AND E.Codigo Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF

SQL.ADD("Group by E.CodNumCajaValores, M.Especie, M.Cupon, M.Cliente, ")  
SQL.ADD("         T.Fecha1, T.FechaCargaSys, CONVERT(int,CT.NrDepositante), E.Alias5, E.Nombre,  ")
SQL.ADD("         T.TipoTr2, M.Cuenta, T.NrTrans, T.Cliente2,  ")
SQL.ADD("         T.CB1, T.Cliente4, T.Cuenta2, T.ComitenteExt, M.FechaMov, M.FechaEje ")

ENDIF
