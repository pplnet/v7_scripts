if Dialogo.Radio1=1
  SQL.ADD("Update "~DBO~".VARIABLES Set Valor='"~FStr(Val(y1),4,0)~"' where Codigo='ULPAGOPE' ")
  SQL.ADD("Update "~DBO~".VARIABLES Set Valor= '"~Val(y2)~"' where Codigo='ULOPEIMP' ")
else

  SQL.ADD("Update "~DBO~".VARIABLES Set Valor='"~FStr(Val(y1),4,0)~"' where Codigo='ULPAGORD' ")
  SQL.ADD("Update "~DBO~".VARIABLES Set Valor= '"~Val(y2)~"' where Codigo='ULORDIMP' ")

  SQL.ADD("Update "~DBO~".VARIABLES Set Valor='"~IdxDate(Val(y9))~"' where Codigo='ULFEORD' ")
  SQL.ADD("Update "~DBO~".VARIABLES Set Valor= '"~Val(y8)~"' where Codigo='ULITORD' ")
endif

SQL.NEW
SQL.EXEC

*ACT(a1, SQL("SELECT Valor FROM "~DBO~".VARIABLES Where Codigo= 'ULORDIMP' ") )
*ACT(a2, SQL("SELECT Valor FROM "~DBO~".VARIABLES Where Codigo= 'ULOPEIMP' ") )

*ACN(b1, SQL("SELECT Valor FROM "~DBO~".VARIABLES Where Codigo= 'ULPAGORD' ") +1)
*ACN(b2, SQL("SELECT Valor FROM "~DBO~".VARIABLES Where Codigo= 'ULPAGOPE' ") +1)





