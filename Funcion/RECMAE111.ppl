***********************************************************************************************
* Recibi un Registro 4447 y Completo la tabla COTIZACIONES * COTIZACIONESFUT    (OCT)                  *
***********************************************************************************************
** Procesa - 
** Poner en 0 para pruebas
** Poner en 1 para que genere
BorrarCeldas(t:1..s:25)
BorrarCeldas(az:1..bz:25)
BorrarCeldas(de:1..de:1)

ACN(t:19, 1)


*/Proceso el registro
ACT(ln1, Val(a:FAC))
**********************************************************
*/ 0175100000250108175643518334447OCT003G              FB00000000320000000020250108000O              FA00000010367500000020250108000Z              FH00000010700000000020250108000
*/ 0129100000250108175645518384447OCT002ODOLAR28FEB25$UOM00000012000000000020250108000ODOLAR31ENE25$UOM00000011105000000020250108000
**********************************************************

ACT(s:1, 'TipoNegocio')
ACT(s:2, 'Especie')
ACT(s:3, 'TipoPrecio')
ACT(s:4, 'Metodo')
ACT(s:5, 'Especie Full')
ACT(s:6, 'Especie MAE')
ACT(s:7, 'Variable')
ACT(s:8, 'Fecha Variable')
ACT(s:9, 'Fecha Fut')
ACT(s:10, 'Fecha Precio')
ACT(s:11, 'Precio') 
ACT(s:12, 'Trama') 
ACT(s:13, '# Cot') 

ACT(s:20, 'Origen')
ACT(s:22, '# Precios')
ACT(s:23, '# Precios')

recorrer&i 1,15
  ACT(az:&i, Val(s:&i))
proximo

ACT(t:20, Copy(Val(ln1),32,3))
ACT(t:22, Copy(Val(ln1),35,3))
ACN(t:23, Num(Val(t:22)))
ACN(t:25, 0)


if EqStr(Val(t:20),'OCT')
  ACT(t:21, 'SI')
  if Val(t:23)>0
    ACT(t:24, 'SI')
    ACT(b:FAC, 'OK')

    ACN(de:1,38)
    Recorrer&i 1,Val(t:23)
     
      ACN(z1,0)
      SCN(t:25, 1)  
      ACT(ln2, Copy(Val(ln1),Val(de:1),46))
      * Trama
      ACT(t:12, Copy(Val(ln1),Val(de:1),46))
      * TipoNegocio
      ACT(t:1, Trim(Copy(Val(ln2),1,1)))
      * Tipo Precio
      ACT(t:3, Copy(Val(ln2),16,1))
*       message(Val(s:3)~' '~Val(t:3))
      if NOT [Eqstr(Val(t:3),'O') o Eqstr(Val(t:3),'F')]
        ACT(er:4, Pad('Tipo de Precio Invalido '~Val(t:3),40))
        ACN(z1,1)
      endif
      * Metodo
      ACT(t:4, Copy(Val(ln2),17,1))
*      message(Val(s:4)~' '~Val(t:4))
      if NOT [Eqstr(Val(t:4),'A') o Eqstr(Val(t:4),'E') o Eqstr(Val(t:3),'O')]
        if Val(z1)=0
          ACT(er:4, Pad('Metodo Invalido '~Val(t:4),40))
        endif
        ACN(z1,1)
      endif
      If Eqstr(Val(t:1),'O')
        * Precios OCT
*        message(Val(s:1)~' '~Val(t:1))

        * Especie Full
        ACT(t:5, Trim(Copy(Val(ln2),1,15)))

        * Fecha
        ACN(t:10, 0)
        ACD(t:10, Fecha(Copy(Val(ln2),42,2)~'/'~Copy(Val(ln2),40,2)~'/'~Copy(Val(ln2),36,4)))
        if Val(t:10)=0
          if Val(z1)=0
            ACT(er:4, Pad('Fecha Precio Erronea',40))
          endif
          ACN(z1,1)
        endif
        * Precio
        ACN(t:11,Num(Copy(Val(ln2),18,10)) +(Num(Copy(Val(ln2),28,8))/100000000 ))

        if Eqstr(Val(t:3),'O')
          ****************************
          * Precio MTM
          ****************************
          * Especie MAE
          ACT(t:6, trim(Copy(Val(ln2),2,5)))
          if EqStr(Val(t:6),'DOLAR')
            ACT(t:2, 'USD')
          endif      
          if Vacio(Val(t:2))
            if Val(z1)=0
              ACT(er:4, Pad('Especie Inexistente (2)',40))
            endif
            ACN(z1,1)
          endif
          * Variable (Codigo Mercado)
          ACT(t:7, Copy(Val(ln2),2,12))
          if Eqstr(Val(t:7),'')
            if Val(z1)=0
              ACT(er:4, Pad('Campo Variable en NULL',40))
            endif
            ACN(z1,1)
          endif
*         message(Val(s:7)~' '~Val(t:7))

          * Fecha Variable
          ACT(t:8, trim(Copy(Val(ln2),7,6)))

          if NoVacio(Val(t:2)) y NoVacio(Val(t:1)) y NoVacio(Val(t:7))
            ACD(t:9, SQL("Select FechaVto from  "~DBO~".PLAZOSMERCADO Where RTrim(ltrim(MercadoNegociacion))= rtrim(ltrim('"~Val(t:20)~"')) and RTrim(ltrim(Especie))=rtrim(ltrim('"~Val(t:2)~"')) and rtrim(ltrim(CodigoMercado))= rtrim(ltrim('"~Val(t:7)~"'))"))
            if Val(t:9)=0
              if Val(z1)=0
                ACT(er:4, Pad('Registro no encontrado en PLAZOSMERCADO',40))
              endif
              ACN(z1,1)
            endif
          else
            ACD(t:9, '')
            if Val(z1)=0
              ACT(er:4, Pad('Error en parametros PLAZOSMERCADO',40))
            endif
            ACN(z1,1)
          endif
     
          if Val(z1)=0
            ACN(t:13,0)
            SQL.ADD("Select Count('*')  as Cuenta from  "~DBO~".COTIZACIONESFUT ")
            SQL.ADD(" Where Mercado  = '"~Val(t:20)~"' ")
            SQL.ADD("   and Codigo  = '"~Val(t:2)~"' ")
            SQL.ADD("   and Moneda  = 'ARP' ")
            SQL.ADD("   and CallPut = 'FUT' ")
            SQL.ADD("   and FechaFut = '"~IdxDate(Val(t:9))~"' ")
            SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
            Recorrer SQL 
              DFA
              ACN(t:13, fbn('Cuenta'))
            Proximo 

            */Actualizo la Tabla 
            if Val(t:13) <> 0
              ACT(t:14, 'Update Fut')
              if Val(t:19)=1
                * Procesa
                SQL.ADD(" Update "~DBO~".COTIZACIONESFUT ")
                SQL.ADD("    Set Precio1 = "~Val(t:11)~" ")
                SQL.ADD(" Where Mercado  = '"~Val(t:20)~"' ")
                SQL.ADD("   and Codigo  = '"~Val(t:2)~"' ")
                SQL.ADD("   and Moneda  = 'ARP' ")
                SQL.ADD("   and CallPut = 'FUT' ")
                SQL.ADD("   and FechaFut = '"~IdxDate(Val(t:9))~"' ")
                SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
                SQL.NEW         
                SQL.EXEC
              endif
            else
              ACT(t:14, 'Insert Fut')
              if Val(t:19)=1
                * Procesa
                SQL.ADD("Insert into "~DBO~".COTIZACIONESFUT ( ")
                SQL.ADD("  Mercado, Codigo, Moneda, CallPut, PrecioEj, FechaFut, Fecha, Precio1 ")
                SQL.ADD("  ) Values ( ")
                * Mercado
                SQL.ADD(" '"~Val(t:20)~"', ")
                * Codigo
                SQL.ADD(" '"~Val(t:2)~"', ")
                * Moneda
                SQL.ADD(" 'ARP', ")
                * CallPut
                SQL.ADD(" 'FUT', ")
                * PrecioEj
                SQL.ADD(" 0, ")
                * FechaFut
                SQL.ADD(" '"~IdxDate(Val(t:9))~"', ")
                * Fecha
                SQL.ADD(" '"~IdxDate(Val(t:10))~"', ")
                * Precio1
                SQL.ADD(" "~Val(t:11)~" ")
                SQL.ADD("  )  ")
                SQL.NEW         
                SQL.EXEC
              endif
            endif
          else
            ACT(t:14, 'Error')
            ACT(t:15, Val(er:4))
          endif
        else
          ****************************
          * Precio Fixing
          ****************************
          ACT(t:2, '')
          ACT(t:2, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen is NULL and TipoNegociacion = '"~Val(t:1)~"' and TipoCotizacion =  '"~Val(t:3)~"'  and Metodo =  '"~Val(t:4)~"' " ))  
          if Vacio(Val(t:2))
            if Val(z1)=0
              ACT(er:4, Pad('Especie Destino Inexistente (2)',40))
            endif
            ACN(z1,1)
          endif

          if Val(z1)=0
            ACN(t:13,0)
            SQL.ADD("Select Count('*') as Cuenta from  "~DBO~".COTIZACIONES ")
            SQL.ADD(" Where Codigo  = '"~Val(t:2)~"' ")
            SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
            SQL.ADD("   and CallPut = 'CON' ")
            SQL.ADD("   and Moneda = 'ARP' ")
            SQL.ADD("   and Mercado = '"~Val(t:20)~"' ")
            SQL.ADD("   and Fuente = 'MAE' ")
            Recorrer SQL 
              DFA
              SCN(t:13,fbn('Cuenta'))
            Proximo 
 
            */Actualizo la Tabla
            if Val(t:13) <> 0
              ACT(t:14, 'Update')
              if Val(t:19)=1
                * Procesa
                SQL.ADD("Update "~DBO~".COTIZACIONES ")
                SQL.ADD("   Set Precio1 = "~Val(t:11)~", ")
                SQL.ADD("       PrecioContable = "~Val(t:11)~" ")
                SQL.ADD(" Where Codigo  = '"~Val(t:2)~"' ")
                SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
                SQL.ADD("   and CallPut = 'CON' ")
                SQL.ADD("   and Moneda = 'ARP' ")
                SQL.ADD("   and Mercado = '"~Val(t:20)~"' ")
                SQL.ADD("   and Fuente = 'MAE' ")
                SQL.NEW         
                SQL.EXEC
              endif
            else
              ACT(t:14, 'Insert')
              if Val(t:19)=1
                * Procesa
                SQL.ADD("Insert into "~DBO~".COTIZACIONES ( ")
                SQL.ADD("  Codigo, Fecha, CallPut, Moneda, Mercado, Fuente, Precio1, PrecioContable ")
                SQL.ADD("  ) Values ( ")
                * Codigo
                SQL.ADD("  '"~Val(t:2)~"', ")
                * Fecha
                SQL.ADD("  '"~IdxDate(Val(t:10))~"', ")
                * CallPut
                SQL.ADD("  'CON', ")
                * Moneda
                SQL.ADD("  'ARP', ")
                * Mercado
                SQL.ADD("  '"~Val(t:20)~"', ")
                * Fuente
                SQL.ADD("  'MAE', ")
                * Precio1
                SQL.ADD("  "~Val(t:11)~", ")
                * PrecioContable
                SQL.ADD("  "~Val(t:11)~" ")
                SQL.ADD(") ")
                SQL.NEW         
                SQL.EXEC
              endif
            else  
              ACT(t:14, 'Error')
              ACT(t:15, Val(er:4))
            endif
          endif
        endif
      else
        ACT(t:14, 'Error 1')
      endif
      ACT((52+Val(t:25)):1,  Val(t:1))
      ACT((52+Val(t:25)):2,  Val(t:2))
      ACT((52+Val(t:25)):3,  Val(t:3))
      ACT((52+Val(t:25)):4,  Val(t:4))
      ACT((52+Val(t:25)):5,  Val(t:5))
      ACT((52+Val(t:25)):6,  Val(t:6))
      ACT((52+Val(t:25)):7,  Val(t:7))
      ACT((52+Val(t:25)):8,  Val(t:8))
      ACD((52+Val(t:25)):9,  Val(t:9))
      ACD((52+Val(t:25)):10, Val(t:10))
      ACN((52+Val(t:25)):11, Val(t:11))
      ACT((52+Val(t:25)):12, Val(t:12))
      ACN((52+Val(t:25)):13, Val(t:13))
      ACT((52+Val(t:25)):14, Val(t:14))
      ACT((52+Val(t:25)):15, Val(t:15))

      SCN(de:1, 46)
    Proximo
  else
    ACT(b:FAC, 'Error cant repeticiones')
  endif
else
  ACT(b:FAC, 'Error Origen')
endif

ACO(1,100)
