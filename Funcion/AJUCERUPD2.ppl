************************************************ U N I C O  V E N C I M I E N T O ******************************************

*--> (cp:1) = Coeficiente de ajuste CER <--*
*--> (cp:3) = Capital ajustado <--*

*--> (vu:3) = TotalComisiones---- <--*
*--> (vu:4) = PrecioEj----------- <--*
*--> (vu:5) = TotalIntereses----- <--*
*--> (vu:6) = TotalBrutoCli1----- <--*
*--> (vu:7) = ImpComCorEq2------- <--*
*--> (vu:8) = ImpComCor1--------- <--*
*--> (vu:9) = ImporteImp--------- <--*
*--> (vu:10) = TotalNetoCli2----- <--*
*--> (vu:11) = TotalNetoCli1----- <--*
*--> (vu:12) = TotalIVA---------- <--*  MMCP
*--> (vu:13) = PrecioMer--------- <--*
*--> (vu:14) = ResultadoIndice--- <--*
*--> (vu:15) = TotalRetenciones-- <--*
*--> (vu:16) = PeriodoInts------- <--*
*--> (vu:17) = TotalAux3--------- <--*  MMCP
*--> (vu:18) = TotalGanancias---- <--*
*--> (vu:19) = ImpComCorEq1------ <--*
*--> (vu:20) = PorComMer1-------- <--*
*--> (vu:21) = Precio2----------- <--*
*--> (vu:22) = TotalGastos------- <--*
*--> (vu:23) = TotalBrutoCli3---- <--*
*--> (vu:24) = TotalNetoCli3----- <--*
*--> (vu:25) = TotalDerechos----- <--*
*--> (vu:26) = TotalImpuestos---- <--*
*--> (vu:27) = TotalImpuesto1---- <--*
*--> (vu:28) = Cantidad---------- <--*
*--> (vu:29) = PeriodoInts X MMCP <--*
*--> (vu:30) = TotalAux1--------- <--*  MMCP
*--> (vu:31) = ImpGastos2-------- <--*  MMCP
*--> (vu:31) = TotalAux2--------- <--*  MMCP



If EqStr(FBN['Tipo'], 'MMCP')  
   Sql.Add(" Update "~DBO~".OPERACIONES Set ")
   Sql.Add(" Cantidad = "~FStr(Val(cp:3),0,2)~", ")
   Sql.Add(" Coeficiente = "~FStr(Val(cp:1),0,8)~", ")  
   Sql.Add(" TotalIntereses = "~FStr(Val(vu:5),0,2)~", ")
   Sql.Add(" TotalBrutoCli1 = "~FStr(Val(vu:6),0,2)~", ")
   Sql.Add(" TotalNetoCli2 = "~FStr(Val(vu:10),0,2)~", ")
   Sql.Add(" TotalNetoCli1 = "~FStr(Val(vu:11),0,2)~", ")
   Sql.Add(" TotalIVA = "~FStr(Val(vu:12),0,2)~", ")
   Sql.Add(" PrecioMer = "~FStr(Val(vu:13),0,8)~", ")
   Sql.Add(" ResultadoIndice = "~FStr(Val(vu:14),0,2)~", ")
   Sql.Add(" TotalRetenciones = "~FStr(Val(vu:15),0,2)~", ")
   Sql.Add(" TotalAux1 = "~FStr(Val(vu:30),0,2)~", ")
   Sql.Add(" TotalAux3 = "~FStr(Val(vu:17),0,2)~", ")
   Sql.Add(" PeriodoInts = "~FStr(Val(vu:29),0,2)~" ")  
   Sql.Add(" Where NrOperacion = '"~FBN['NrOp']~"' ")
   Sql.New
   Sql.Exec
EndIf


