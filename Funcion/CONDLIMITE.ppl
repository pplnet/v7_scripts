*-TIPOOP para el BOOK-* 
**Si existe TipoOp para el book, permito asignar
QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') ")=1;'El Book no puede invertir en FCI';NO

*-INSTRUCCION FIDUCIANTE-*
*(QUERY("Select CB1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') ") ='SI' Y CB11=1) O (CB11=0 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'")));'El Book no tiene Instruccion del Fiduciante';NO
*-OPERACION SI LIMITE SI - NO CONTROLA MAS NADA @OPLIMFIDU-*
*-OPERACION SI LIMITE NO - CONTROLA DESPUES RESTO CAMPOS @LIMSINFIDU-*
*-OPERACION NO LIMITE NO - CONTROLA DESPUES RESTO CAMPOS @LIMSINFIDU-*
*-OPERACION NO LIMITE SI - NO PERMITO-*
(CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI'"))) O (NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'")));'Este TipoOp solo puede operarse por Instruccion del Fiduciante';NO

*-PORCENTAJE DE LA CARTERA-*
*CB11 = 1 O (CB11 = 0 Y [Vacio("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' ") O QUERY("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO'") >= Precio5 ] ) ; 'El % invertido en FCI excede el % permitido de la cartera'; NO
(CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI'"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'"))) Y [Vacio("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' and CB1='NO'") O QUERY("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO'") >= Precio5 ] ) ; 'El % invertido en FCI excede el % permitido de la cartera';SI;SI;FSYS;'EXCPOR';

*-ESPECIE-*
(CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI'"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'"))) Y [Vacio(SQLSet("Select Especies FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO'")) O Incluido(ESPECIE,SQLSet("Select Especies FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO'")) O Incluido(SQLSet("Select Especies FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO'"),Ascendientes('ESPECIES',ESPECIE),1)]) ; 'El book no puede invertir en la Especie'; NO

*-Monto Maximo y Monto Minimo-*
(CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI'"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'"))) Y [Vacio(TotalNetoCli3) O TotalNetoCli3 = 0 O TotalAux8 = 0 O (TotalNetoCli3>=TotalNetoCli2+(TotalNetoCli1*Precio3) O TotalAux8<=TotalNetoCli2+(TotalNetoCli1*Precio3))] ) ; 'Excede el Monto del Limite';SI;SI;FSYS;'EXCLIM';
