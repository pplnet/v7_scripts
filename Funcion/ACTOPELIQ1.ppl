*** Toma todas las operaciones vencidas y pendientes y los contados, pases y cauciones ***
*** Marca las operaciones, cambia la especie en los movimientos y agrega los cupones ***

SQL.ADD("SELECT Distinct O.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrOperacion = O.NrOperacion ")
SQL.ADD("and   O.Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("and   O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and (((O.TipoOp In ('CFTC','CFTE','CFTP','VFTC','VFTE','VFTP') ")
SQL.ADD("      and O.PaseCB = 1)) ")
SQL.ADD("  or (O.TipoOp In ('CTE','VTE') and (CB6 = 0 or CB6 is Null)) ")
SQL.ADD("  or (O.TipoOp In ('CTP','VTP') and (CB10 = 0 or CB10 is Null)) ")
SQL.ADD("  or (O.TipoOp In ('CTC','VTC','CBL','VBL')) ")
SQL.ADD("  or (O.TipoOp In ('COT','CTT','PCA','PFT','PFTC','POT','PTA','PTT') ")
SQL.ADD("      and O.FechaVto <= '"~IdxDate(Val(g2))~"' )) ")
SQL.ADD("and  (O.RB4 = 0 or O.RB4 is Null) ") 
SQL.ADD("order by O.TipoOp, O.Especie ")

SetFilaActual(10)

