*--------Todas las cuentas con saldo por mercado de BNP para la especie que corta-----------*

SQL.ADD("SELECT Distinct M.NrSaldo, M.Cuenta, M.Mercado, M.EnteCustodia, M.CallPut, M.FechaEj, ")
SQL.ADD("       M.PrecioEj, M.Cliente, M.Cantidad, M.FechaMov, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      M.Especie='"~VAL(b2)~"' AND ")
SQL.ADD("      M.Cupon = '"~FSTR(VAL(c2),1,0)~"' AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.FechaMov > '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("and M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
endif
SQL.ADD("ORDER BY M.NrSaldo, M.Cliente ")

SetFilaActual(fac+100)
ACN(z1,fac)

ACN(ha1, fac+1)
Recorrer SQL
  ACN(x1, fbn('Cantidad'))

  Message(fbn('Cliente')~' '~VAL(b2)~' '~FBN['Mercado']~' '~FBN['Cuenta']~' '~Fstr(val(x1),0,2)  )

  IF Round(Val(x1),2)<>0
     IF FBN['NrSaldo'] >= Val(sl1) y Val(ha1) = 0
        ACN(ha1, fac)
     ENDIF
     ACT(a:fac, fbn('Cliente'))
     ACT(b:fac, Val(b2))
     ACT(c:fac, FStr(VAL(c2),1,0))
     ACT(d:fac, fbn('Mercado'))
     ACT(f:fac, fbn('Cuenta'))
     ACN(g:fac, Val(x:1))
     ACN(k:fac, 1)
     ACT(l:fac, '')
     ACN(m:fac, FBN['NrSaldo'])
     ACD(n:fac, FBN['FechaMov'])

     ACT(o:fac, fbn('CallPut'))
     ACD(p:fac, fbn('FechaEj'))
     ACN(q:fac, fbn('PrecioEj'))

     ACT(bl:fac, FBN['TipoCliente'])
     ACT(bm:fac, FBN['CondicionGan'])
     ACT(bn:fac, FBN['CondicionIVA'])
     ACT(bo:fac, FBN['Res3125'])
     ACT(bp:fac, FBN['InteresesC'])
     ACT(bq:fac, FBN['Cotiza'])
     ACN(br:fac, FBN['TasaIntVigente'])
     ACD(bs:fac, FBN['FechaCambioTasa'])
     ACT(bt:fac, FBN['Valor10'])
     ACN(bu:fac, FBN['TasaIntAnterior'])
     ACT(bv:fac, FBN['Valor9'])
     ACT(bw:fac, FBN['DiasAnio'])
     ACT(bx:fac, FBN['DiasMes'])

     IF Not Incluido(Val(o:fac), 'CAL|PUT')
        ACN(r:fac, 1)
     ENDIF

     ACT(lb:fac,'')
     ACN(lc:fac, 0)
     ACN(ld:fac, 0)
     ACT(le:fac, '')

     *- Si quiere cobrar el cupon y no es un saldo bloqueado por caja de valores 
     If val(jo1)=6 y Not Incluido(Fstr(val(m:fac),0,0),Val(dz6))
        *- Guardo los datos de la liquidacion 
        *- lb: Cuenta Efectivo lc:Precio ld: Monto en Efectivo

        *- Seleccion de la cuenta de efectivo
        ACT(lb:fac,'')

        SQL.ADD("SELECT Codigo,Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:fac)~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB'  ")
   
        Recorrer SQL
          dfa
          If Vacio(val(lb:fac)) y [Incluido(FBN['Especies'],Dialogo.Especie2) o Incluido(FBN['Especies'],'MONEDA') ] 
             ACT(lb:fac,FBN['Codigo'])
          EndIf
        Proximo
        If Vacio(val(lb:fac)) 
           ACT(lb:fac,Val(dz3))
        EndIf

        *-    
        ACN(lc:fac, val(aa5))
        ACN(ld:fac, Val(x:1)*Val(lc:fac))
        ACT(le:fac, Dialogo.Especie2)
     EndIf

  ELSE
     dfa
  ENDIF
Proximo

ACN(w1,fac)

IF Val(z:1)<>val(w1)
   ***** Val(ha1) indica desde donde estan los movimientos de custodia antes era Val(z1)+1 *****
   CrearListBox ; 'Arial,8,';'Movimientos Pendientes OK.'
       'OK'              ;k :Val(ha1)..k:val(w1);SI;;;40;CHECK
       'Cliente'         ;a :Val(ha1)..a:val(w1);NO;;;70;STRING
       'Especie'         ;b :Val(ha1)..b:val(w1);NO;;;60;STRING
       'Cupon'           ;c :Val(ha1)..c:val(w1);NO;;;40;STRING
       'Casa Cust.'      ;d :Val(ha1)..d:val(w1);NO;;;60;STRING
       'Cuenta'          ;f :Val(ha1)..f:val(w1);NO;;;100;STRING
       'Cantidad'        ;g :Val(ha1)..g:val(w1);NO;;;100;NUMERO;'##,###,###.##'
       'NrSaldo'         ;m :Val(ha1)..m:val(w1);NO;;;100;NUMERO;'###'
       'Precio del Cupon';lc:Val(ha1)..lc:val(w1);NO;;;90;NUMERO;'###.######'
       'Moneda'          ;le:Val(ha1)..le:val(w1);NO;;;50;STRING
       'Efectivo'        ;ld:Val(ha1)..ld:val(w1);NO;;;80;NUMERO;'###,###,###.##'
       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);NO;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(l:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA') AND (Especies LIKE '%"~val(m:fac)~"%' OR Especies LIKE '%"~IIf(EqStr(val(m:fac),Val(dz1)),Val(dz2),Val(dz1))~"%')  "
       'CallPut'         ;o :Val(ha1)..o:val(w1);NO;;;40;STRING
       'FechaEj'         ;p :Val(ha1)..p:val(w1);NO;;;50;FECHA
       'PrecioEj'        ;q :Val(ha1)..q:val(w1);NO;;;60;NUMERO;'###.########'
   FinListBox

   IF NOT OK 
      Cancelar
   ENDIF


   ACT(k0, 'SI')
   Recorrer&i val(z1)+1,val(w1)
      IF Val(k:&i)=1
         IF EqStr(Val(k0),'SI')
            ACT(k0, 'NO')
            If Vacio(val(y1))
               *- Genera la Transaccion de Cupon 
               (."GENCUPON".)
            EndIf

            *- Genera la Transaccion de Liquidacion Cupon 
            If Vacio(val(y2)) y val(jo1)=6 
               *- Parametros para llamar a la funcion
               *- b4: Especie Cupon c2: Nro. Cupon h4: Fecha Proximo Corte 
               *- m1: Moneda k2: % Amortizacion l2: % Renta m2: Interes Capitalizados j2: Vehiculo  
               ACT(lb4,val(b4))
               ACN(lc2,val(c2))
               ACD(lh4,Dialogo.Fecha2)
               ACT(lm1,Dialogo.Especie2)
               ACN(lk2,val(k2))
               ACN(ll2,val(l2))
               ACN(lm2,val(m2))
               ACT(lj2,val(j2))

               (."GENLCUPON".)
            EndIf
         ENDIF

         IF Eqstr(Val(o:&i), 'CAL')
            ACT(y:3,'0')
         ELSE
            IF Eqstr(Val(o:&i), 'PUT')
               ACT(y:3,'1')
            ELSE
               ACT(y:3,'')
            ENDIF
         ENDIF

         ACN(fi1,&i)

         If val(jo1)=6 
            Message('*---Calculo de Comisiones por CORTE DE CUPON')
            *- cl1: Cliente ce1: Especie Original del Saldo *- cv1: Vehiculo cy1: Mercado ct1: Tipo de Comision
            *- da: CallPut db: FechaEj dc: PrecioEj de:Cuenta sa2: Ultimo nro. de Cuota para insertar comisiones
            *- sa:3 Acumulador de Comisiones 

            act(cl1, Val(a:&i))
            act(cv1, Dialogo.Vehiculo1)
            act(cy1, Val(d:&i))
            act(da1, '')
            act(db1, '')
            acn(dc1, 0)
            act(de1, Val(lb:&i))
            act(ce1, Val(b:&i))

            acn(ci:2,0)
            acn(ci:1,0)
            acn(sa2,0)
            acn(sa3,0)
            acn(re1,0)
            acn(re2,0)

            *- Calculo la comision de la Renta solamente para los Saldos <> 201
            If val(aa:9)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz4))
               acn(cj:1,Val(g:&i)*val(aa:9))

               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)

               acn(re1, val(sa:3))
            EndIf

            *- Calculo la comision de la Amortizacion solamente para los Saldos <> 201
            If val(aa:8)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz5))
               acn(cj:1,Val(g:&i)*val(aa:8))
               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)
               acn(re2, val(sa:3)-val(re1))
            EndIf

            **** Si la moneda de la comision y la de la liq son diferente, paso a otra moneda la comis.
            ***IF NOT EqStr(Dialogo.Especie2,VAR('MONELOCA'))
            ***   ACN(ZA0, CotizacionC(VAR('MONELOCA'), , , , FSys, 1, SI,Dialogo.Especie2))
            ***   acn(sa3,val(sa3)*Val(za0))
            ***   ***ACT(ch1, Val(h:&i))
            ***ENDIF

            *- ci2: Calculo del % del Iva sobre comisiones
            acn(ci:2, Num(Val(dz10))+IIF(EQSTR(Val(bn:&i),'NOI'),Num(Val(dz11)),IIF(EQSTR(Val(bo:&i),'SI'),Num(Val(dz12)),0)))

            *- ci:1 Monto de Iva
            acn(ci:1,ROUND(Abs(val(sa:3))*Val(ci:2)/100,2))

            * si la comision es mayor que lo que pago
            IF Val(sa3)+Val(ci1)>Val(ld:&i)
               ACN(sa3, ROUND(val(ld:&i)/(1+Val(ci2)/100),2))
               ACN(ci1, Val(ld:&i)-Val(sa3))
            ENDIF
         EndIf
 
         Message('Generando Movimientos Nro. '~Val(a:&i)~' .... ')       

         *- fv1: Fecha Valida para Movimiento del Corte fv2: Fecha Valida para Movimiento del Pago 
         ACD(fv1,val(n:&i))
         ACD(fv2,Dialogo.Fecha2)

         *- Si FechaMov<FechaPago -> El pago de cupones se hace a la fecha de Pago
         *- Sino                  -> El pago de cupones se hace a la fecha de Movimiento
         If val(n:&i)>Dialogo.Fecha2
             ACD(fv2,val(n:&i) )
         EndIf

         (.'CUPINSMOV'.)
      ENDIF
   Proximo
ELSE
   MessageBox('Noy hay MOVIMIENTOS PENDIENTES para cortar.')
ENDIF

