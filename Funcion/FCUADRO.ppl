** funcion de informe INVFO1 "Detalle de Inversion de Fondos"
** imprime el cuadro principal y dibuja marcos

** PARAMETROS:
**             co2: cantidad de filas impresas
**             co3 = 0 indica que ya imprimi los titulos, entonces
**                   formateo celdas y pongo marcos 
**             co9: especie
**********************************************************************


if Val(co3)<>0

   ACT(a:fac, 'DETALLE DE OPERACIONES FINANCIERAS')
   AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR'))

   ACT(a:fac+2, 'INVERSION DE FONDOS EN '~IIF(EqStr(Dialogo.Especie1,'ARP'),'PESOS','MONEDA EXTRANJERA ('~Dialogo.Especie1~')') )
   ACT(g:fac+2, 'FECHA: '~Val(fe1) )
   AgregarMarco(a:fac+2..e:fac+2,2,0,Exe('COLOR'))
   AgregarMarco(g:fac+2..h:fac+2,2,0,Exe('COLOR'))
   SetFont(a:fac..g:fac+2,1)

   if NoVacio(Dialogo.Lista1)
      ACT(a:fac+4, 'Vehiculo : '~Dialogo.Lista1)
   else
      ACT(a:fac+4, 'Vehiculo : Todos')
   endif
   **- Hago que el marco sea variable, dependiendo de la cantidad de elementos de Lista1
   AgregarMarco(a:fac+4..elementos(Dialogo.Lista1)+1:fac+4,2,0,Exe('COLOR'))
   SetFont(a:fac+4..b:fac+4,1)

   SetFilaActual(fac+6)

   ACT(a:fac,'MINUTA')
   ACT(b:fac,'ENTIDAD')
   ACT(c:fac,'COD.')
   ACT(d:fac,'FECHA')
   ACT(d:fac+1,'ORIGEN')
   ACT(e:fac,'FECHA')
   ACT(e:fac+1,'  VTO')
   ACT(f:fac,'DIAS')
   ACT(f:fac+1,'OP.')
   ACT(g:fac,'IMPORTE')
   ACT(h:fac,'IMPORTE')
   ACT(h:fac+1,'AL VTO')
   ACT(i:fac,'TIPO OP')
   ACT(j:fac,'COD')
   ACT(k:fac,'T.E.M.')
   ACT(l:fac,'TNAV')
   ACT(m:fac,'TNAA')
   ACT(n:fac,'INTERESES')
   ACT(n:fac+1,'PERIODO')
   ACT(o:fac,'IMP.GIAS.')
   ACT(o:fac+1,'S/INT.')
   ACT(p:fac,'INT.TOT.')
   ACT(p:fac+1,'AL VTO')
   ACT(q:fac,'DIAS')
   ACT(q:fac+1,'VTO') 
   ACT(r:fac,'DIAS')
   ACT(r:fac+1,'TRANS.')
   ACT(s:fac,'DIAS')
   ACT(s:fac+1,'MES')
   ACT(t:fac,'INTERES')
   ACT(t:fac+1,'DIARIO')
   ACT(u:fac,'INTERESES')
   ACT(u:fac+1,'DEVENG.')
   ACT(v:fac,'NUMERALES')
   ACT(w:fac,'NUMERALES')
   ACT(w:fac+1,'T.E.M.')
   ACT(x:fac,'NUMERALES')
   ACT(x:fac+1,'VTO.')
   ACT(y:fac,'NUMERALES')
   ACT(y:fac+1,'TNA Venc')
   ACT(z:fac,'NUMERALES')
   ACT(z:fac+1,'TNA Adel')
  
   AgregarMarco(a:fac..z:fac+1,1,2,Exe('COLOR8'))
   AlinearCeldas(a:fac..z:fac+1,'C')
   SetFont(a:fac..z:fac+1,1)
   ifa
else
*ACN(au1,fac)
*messagebox(Val(au1))
   AgregarMarco(a:fac-Val(co2)+1..z:fac,1,2)
   SetFont(a:fac-Val(co2)+1..z:fac, 2)
   ACO(6,4)
   ACO(7,8)
   ACO(8,8)
   ACO(9,20)
   ACO(10,8)
   ACO(11,6)
   ACO(13,9)
   ACO(14,8)
   ACO(15,8)
   ACO(16,8)
   ACO(17,4)
   ACO(18,4)
   ACO(19,4)
   ACO(20,7)
   ACO(21,8)
   ACO(22,8)
   ACO(23,8)
   ACO(24,7)
   ACO(25,9)
endif
