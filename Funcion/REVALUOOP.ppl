  ACN(ce:1, Cotizacion(fbn('Especie'),,,,Val(FE:1),25,SI) )
  ACN(ce:2, Cotizacion(fbn('Especie'),,,,Habiles(Val(FE:1),-1,'ARG'),25,SI) )
  ACN(cc:1, Cotizacion(fbn('EspecieCupon'),,,,Val(FE:1),25,SI) )
  ACN(cc:2, Cotizacion(fbn('EspecieCupon'),,,,Habiles(Val(FE:1),-1,'ARG'),25,SI) )
  ACN(cm:1, Cotizacion(fbn('Cotiza'),,,,Val(FE:1),25,SI) )
  ACN(cm:2, Cotizacion(fbn('ContraEspecie'),,,,Val(FE:1),25,SI) )

  IF fbn('FechaOp')=Val(FE:1) y Incluido(fbn('TipoOp'),'TIC|CTC|CTP|TIV|VTC|VTP|TIFC|TIFV')
    ACN(rv:1, (fbn('Cantidad')*Val(ce:1))- (fbn('TotalNetoCli1')*iif(Eqstr(fbn('ContraEspecie'),fbn('Cotiza')),1,IIF(Not eqstr(fbn('Cotiza'),VAR('MONELOCA')),Val(cm:1),1/Val(cm:2)))) )
  Else
    ACN(rv:1,(fbn('Cantidad')*Val(ce:1))-(fbn('Cantidad')*Val(ce:2)))
  Endif
*  SCN(rv:1, IIF(Num(fbn('Cupon1'))=fbn('Cupon'),0,IIF(fbn('FechaOp')=Val(FE:1) y Incluido(fbn('TipoOp'),'TIC|CTC|CTP|TIV|VTC|VTP|TIFC|TIFV'),fbn('Cantidad')*Val(cc:1),fbn('Cantidad')*Val(cc:1)-fbn('Cantidad')*Val(cc:2))) )
  SCN(rv:1, IIF(Num(fbn('Cupon1'))=fbn('Cupon'),0,IIF(fbn('FechaOp')=Val(FE:1) y Incluido(fbn('TipoOp'),'TIC|CTC|CTP|TIV|VTC|VTP|TIFC|TIFV'),0,fbn('Cantidad')*Val(cc:1)-fbn('Cantidad')*Val(cc:2))) )


