*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:'F.Desde';;;;;;Dialogo.Fecha1>0;'Debe ingresar una fecha valida';NO;Fsys
  Fecha2:'F.Hasta';;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta debe ser mayor o igual a Fecha Desde';NO;Fsys
  Check2:'Exporta PDF'  ;;;;NO;NO;;;;0;
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:fac, 'FPA V6')
ACT(a:FAC+1, 'Desde Fecha : '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Hasta Fecha : '~Dialogo.Fecha2)
SetFont(a:fac..g:fac+2,2)

ACT(a:FAC+4, 'Operacion')
ACT(b:FAC+4, 'Fecha')
ACT(c:FAC+4, 'Hora')
ACT(d:FAC+4, 'Usuario')
ACT(e:FAC+4, 'Nombre')
ACT(f:FAC+4, 'Codigo')
ACT(g:FAC+4, 'Campo')
ACT(h:FAC+4, 'Valor Anterior')
ACT(i:FAC+4, 'Valor Actual')
