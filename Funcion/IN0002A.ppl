***********************************************
* IN0002A - ALTA DE MOVIMIENTO IN0002         *
*                                             *
* Invocada por el IN0002 - Interfase CAP-SIAF *
*                                             *
***********************************************

message( "ALTA  MOVIMIENTO")

ACT(zz:&i,SQL("SELECT /*+ RULE */ Estado FROM "~DBO~".CHEQUES WHERE Chequera='"~VAL(xo:&i)~"' AND NrCheque= "~Fstr(VAL(xd:&i),0,0) ) )

** -- Si encontr¢ el cheque ... aviso de advertencia
If NOT Vacio(VAL(zz:&i))
   ACT(p:val(zd:1), "AVISO: es alta y el cheque ya existe" )
   ACN(zj:1, 1)
Else
   ** -- Alta Proveedor (si no existe)
   ACT(zz:&i, SQL(" SELECT /*+ RULE */ Codigo FROM "~DBO~".CNPROVEEDORES WHERE Codigo = '"~TRIM(MIRT(VAL(xe:&i)))~"' ") )
   IF Vacio(VAL(zz:&i))
      message( 'Insert ndo en CNPROVEEDORES ...' )
      SQL.ADD(" INSERT INTO "~DBO~".CNPROVEEDORES ")
      SQL.ADD(" (Codigo, Nombre) ")
      SQL.ADD(" VALUES ")
      SQL.ADD(" ('"~VAL(xe:&i)~"', '"~VAL(xf:&i)~"' ) ")
      SQL.NEW
      SQL.EXEC
   EndIf
   ** -- Genera Transacciones
   message( 'Insert ndo en TRANSACCIONES2 ...' )
   ACT(nu:1, GETNUMERADOR(10101) )
   ACT(tt:1, 'DEVM')
   SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
   SQL.ADD(" ConceptoPago, Fecha1, Fecha2, ")
   SQL.ADD(" Especie, Cantidad1, Cliente2, ")
   SQL.ADD(" Cuenta2, Vehiculo1, UsrInput, ")
   SQL.ADD(" NrTrans, TipoTr2, FechaCarga, FechaCargaSys, ")
   SQL.ADD(" Proveedor, CNFormaPago, Chequera1, ")
   SQL.ADD(" Cantidad2, CB2, CB3, RB1 ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" '"~VAL(xn:&i)~"', "~IdxDate2(Fecha(VAL(xg:&i)))~", "~IdxDate2(Fecha(VAL(xh:&i)))~", ")
   SQL.ADD(" '"~VAL(xl:&i)~"', "~FSTR(VAL(xk:&i),15,2)~"      , '"~VAL(xv:&i)~"' , ")
   SQL.ADD(" '"~VAL(xu:&i)~"', '"~VAL(xa:&i)~"'               , '"~USUARIOACTIVO~"' , ")
   SQL.ADD(" '"~VAL(nu:1)~"' , '"~VAL(tt:1)~"'                , "~IdxDate2(AHORA)~", "~IdxDate2(FSYS)~", ")
   SQL.ADD(" '"~VAL(xe:&i)~"', '"~VAL(xm:&i)~"'               , '"~VAL(xo:&i)~"', ")
   SQL.ADD(" "~FSTR(VAL(xd:&i),0,0)~", '0', '1', "~FSTR(VAL(xs:&i),1,0)~" )" )
   SQL.NEW
   SQL.EXEC
   ** -- Genera OperacionesBits
   RECORRER&j 1,30
      ACT(jj:1, Fstr(&j,2,0))
      If Incluido(VAL(jj:1),'15|16|17|18|20|25')
         SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ")
         SQL.ADD(" (NrOperacion, NrBit, Valor) ")
         SQL.ADD(" VALUES ")
         SQL.ADD(" ('"~VAL(nu:1)~"',"~Fstr(&j,2,0)~",'0') ")
         SQL.NEW        
         SQL.EXEC
      Endif
   PROXIMO 
   message( 'Actualiz ndo estado en OPERACIONESBITS (Conciliaci¢n) ...' )
   SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='1' WHERE NrOperacion = '"~VAL(nu:1)~"' AND NrBit=18 ")
   SQL.NEW
   SQL.EXEC
   ** -- Genera Movimientos de la transaccion
   message( 'Actualiz ndo en MOVIMIENTOS ...' )
   SQL.ActualizarMovimientosT4(VAL(nu:1),SI,NO,NO,NO,NO,NO,0)
   SQL.EXEC
   ** -- Genera Cheques
   message( 'Insert ndo en CHEQUES ...' )
   If  Eqstr(VAL(xj:&i), "X")             
       ACT(zk:1, "ANU")
   Else
       If Eqstr(VAL(xj:&i), "A")             
          ACT(zk:1, "ASI")
       Else
          ACT(zk:1, "ENT")
       EndIf
   EndIf
   SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
   SQL.ADD(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
   SQL.ADD(" NrComprobante, Monto, Observaciones, Estado) ")
   SQL.ADD(" VALUES ")
   SQL.ADD(" ('"~VAL(xo:&i)~"', "~IdxDate2(Fecha(VAL(xg:&i)))~" , "~Fstr(VAL(xd:&i),0,0)~", "~IdxDate2(Fecha(VAL(xh:&i)))~", ")
   SQL.ADD("  '"~VAL(nu:1)~"' , "~Fstr(VAL(xk:&i),15,2)~"        , '"~VAL(OB:1)~"'        , '"~VAL(zk:1)~"') ")
   SQL.NEW
   SQL.EXEC
   ***---Actualizo los datos del cheque en los Movimientos
   message( 'Actualiz ndo en MOVPENDIENTES ...' )
   SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES ")
   SQL.ADD(" SET NrGrupo   = "~Fstr(NUM(VAL(xo:&i)), 0, 0)~", ")
   SQL.ADD("     NrComprob = "~Fstr(VAL(xd:&i), 0, 0)~" ")
   SQL.ADD(" WHERE NrOperacion = '"~VAL(nu:1)~"' ")
   SQL.NEW
   SQL.EXEC
   ** -- Mensaje de operacion exitosa 
   ACT(p:val(zd:1), "Registro procesado con exito !!!"  )
   SetFont(p:val(zd:1)..p:val(zd:1), 3)
EndIf