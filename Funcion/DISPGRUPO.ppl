      ACN(j:FAC, SUM(g:FAC..i:FAC))
      ACN(aj:FAC, SUM(ag:FAC..ai:FAC))
      ACN(k:FAC, Val(b:FAC)-Val(j:FAC))
      if Val(b:FAC)>Val(ab:FAC)
        ACN(bb:FAC, Val(b:FAC))
      else
        ACN(bb:FAC, Val(ab:FAC))
      endif
      ACN(bc:FAC, Val(bb:FAC)-Val(j:FAC)-Val(aj:FAC))
      if Val(bc:FAC)>=0
        if Val(k:FAC)>=0
          if Val(k:FAC)>Val(bc:FAC)
            ACN(k:FAC, Val(bc:FAC))
          endif
        endif
      else
        if Val(k:FAC)>=0
          ACN(k:FAC, 0)
        endif
      endif
      ACN(l:FAC, Val(c:FAC))
      ACN(m:FAC, Val(d:FAC)-Val(g:FAC))
      ACN(n:FAC, Val(e:FAC)-Val(h:FAC))
      ACN(o:FAC, Val(f:FAC)-Val(i:FAC))
      if Val(m:FAC)<0 y Val(l:FAC)>0 y Vacio(Val(d:FAC))
        if -Val(m:FAC)<Val(l:FAC)
          SCN(l:FAC, Val(m:FAC))
          ACN(m:FAC, 0)
        else
          SCN(m:FAC, Val(l:FAC))
          ACN(l:FAC, 0)
        endif
      endif
      if Val(n:FAC)<0 y Val(l:FAC)>0 y Vacio(Val(e:FAC))
        if -Val(n:FAC)<Val(l:FAC)
          SCN(l:FAC, Val(n:FAC))
          ACN(n:FAC, 0)
        else
          SCN(n:FAC, Val(l:FAC))
          ACN(l:FAC, 0)
        endif
      endif
      if Val(o:FAC)<0 y Val(l:FAC)>0 y Vacio(Val(f:FAC))
        if -Val(o:FAC)<Val(l:FAC)
          SCN(l:FAC, Val(o:FAC))
          ACN(o:FAC, 0)
        else
          SCN(o:FAC, Val(l:FAC))
          ACN(l:FAC, 0)
        endif
      endif
      if Val(l:FAC)>=0 y Val(l:FAC)>Val(k:FAC)
        if Val(k:FAC)>=0
          ACN(l:FAC, Val(k:FAC))
        else
          ACN(l:FAC, 0)
        endif
      endif
      if Val(m:FAC)>0 y Val(m:FAC)>Val(k:FAC)
        if Val(k:FAC)>=0
          ACN(m:FAC, Val(k:FAC))
        else
          ACN(m:FAC, 0)
        endif
      endif
      if Val(n:FAC)>0 y Val(n:FAC)>Val(k:FAC)
        if Val(k:FAC)>=0
          ACN(n:FAC, Val(k:FAC))
        else
          ACN(n:FAC, 0)
        endif
      endif
      if Val(o:FAC)>0 y Val(o:FAC)>Val(k:FAC)
        if Val(k:FAC)>=0
          ACN(o:FAC, Val(k:FAC))
        else
          ACN(o:FAC, 0)
        endif
      endif
      FormatoCeldas(b:FAC..o:FAC,EXE('F0R'))
      FormatoCeldas(ab:FAC..aj:FAC,EXE('F0R'))
      FormatoCeldas(bb:FAC..be:FAC,EXE('F0R'))
      SetFont(a:FAC..x:FAC,1)
      SetFont(ab:FAC..aj:FAC,1)
      SetFont(bb:FAC..be:FAC,1)
