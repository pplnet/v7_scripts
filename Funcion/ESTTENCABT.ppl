SetFilaActual(Val(ht0)+Val(co0))
IF EqStr(Val(y3),'T')
   ACT(h:fac, 'INFORME ESTADO DE TENENCIA')
   SetFont(h:fac, 3)
ELSE
   ACT(g:fac, 'LIQUIDACION DE COMISIONES POR CUSTODIA')
   SetFont(g:fac, 3)
ENDIF
ifa

IF EqStr(Val(y3),'T')
   ACT(a:fac, 'Fecha')
   SetFont(a:fac, 2)
ELSE
   ACT(a:fac, 'Fecha desde')
   SetFont(a:fac, 2)
   AgregarMarco(a:fac+1..c:fac+1,1,0,Exe('COLOR'))
   ifa
   ACT(a:fac+1, 'Fecha hasta')
   SetFont(a:fac+1, 2)
   ifa
ENDIF

ifa
ACN(dc0, fac)
AgregarMarco(a:fac..c:fac,1,0,Exe('COLOR'))
AFi(fac,Val(fl0))
ifa

ACT(a:fac, 'Nro. Sucursal')
ACT(d:fac, 'Nombre Sucursal')
SetFont(a:fac..w:fac, 1)
ifa
AgregarMarco(a:fac..b:fac,1,0)
AgregarMarco(d:fac..l:fac,1,0)
AFi(fac,Val(fl0))
ifa

ACT(a:fac, 'Cliente NRO.')
SetFont(a:fac..w:fac, 2)
ifa
AgregarMarco(a:fac..e:fac,1,0)
AFi(fac,Val(fl0))
ifa

ACT(a:fac, 'APELLIDO Y NOMBRE/S o RAZON SOCIAL')
ACT(r:fac, 'DOCUMENTO (Tipo y Numero)')
SetFont(a:fac..w:fac, 2)
ifa
AgregarMarco(a:fac..o:fac,1,0)
AgregarMarco(q:fac..v:fac,1,0)
AFi(fac,Val(fl0))
ifa

ACT(a:fac, 'C.U.I.T./C.U.I.L.')
ACT(k:fac, 'DOMICILIO')
SetFont(a:fac..w:fac, 2)
ifa
AgregarMarco(a:fac..i:fac,1,0)
AgregarMarco(k:fac..v:fac,1,0)
AFi(fac,Val(fl0))
ifa

ACT(a:fac, 'LOCALIDAD')
ACT(l:fac, 'CODIGO POSTAL')
ACT(p:fac, 'TELEFONOS')
SetFont(a:fac..w:fac, 2)
ifa
AgregarMarco(a:fac..j:fac,1,0)
AgregarMarco(l:fac..n:fac,1,0)
AgregarMarco(p:fac..v:fac,1,0)
AFi(fac,Val(fl0))
SetFilaActual(fac+2)
