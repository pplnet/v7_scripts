SQL.ADD("  SELECT M.FechaMov, 'Mov.Pendientes' Numero, 'A' CuentaFPA, 1 Op, T.Cliente1,")
SQL.ADD("  E.Nombre, E.Codigo MonedaFPA, T.NrOperacion NrTrans, T.TipoOp TipoTr2,      ")
SQL.ADD("  -M.Cantidad Cantidad, 'Pendiente' Estado, M.Leyenda                         ")
SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES T, "~DBO~".ESPECIES E     ")
SQL.ADD("  WHERE M.NrOperacion = T.NrOperacion                                         ")
SQL.ADD("  AND   M.Especie = E.Codigo                                                  ")
SQL.ADD("  AND   E.Tipo = 'MON'                                                        ")
SQL.ADD("  AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha1-1)~"                          ")
If Dialogo.Radio1=0
   SQL.ADD(" AND M.Cantidad > 0                                                        ")
Endif
If Dialogo.Radio1=1
   SQL.ADD(" AND M.Cantidad < 0                                                        ")
Endif
SQL.ADD("  UNION all ")
SQL.ADD("  SELECT M.FechaMov, C.Numero, C.Codigo CuentaFPA, 0 Op, ' ' Cliente1,       ")
SQL.ADD("  E.Nombre, E.Codigo MonedaFPA, T.NrTrans, T.TipoTr2,                        ")
*****SQL.ADD("  M.Cantidad, CASE M.NrSaldo WHEN 31 THEN 'Pendiente' ELSE 'Ejecutado' END Estado, M.Leyenda ")
SQL.ADD("  CASE WHEN T.TipoTr2 in ('DEP','RET','COMP') THEN -M.Cantidad ELSE M.Cantidad END, ")
SQL.ADD("  CASE M.NrSaldo WHEN 31 THEN 'Pendiente' ELSE 'Ejecutado' END Estado, M.Leyenda ")
SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C, ")
SQL.ADD("  "~DBO~".ESPECIES E                                                         ")
SQL.ADD("  WHERE M.NrTrans2 = T.NrTrans                                               ")
SQL.ADD("  AND   M.Especie = E.Codigo                                                 ")
SQL.ADD("  AND   E.Tipo = 'MON'                                                       ")
SQL.ADD("  AND  (((T.Cuenta2=C.Codigo) AND (T.TipoTr2 in ('DEP','RET','COMP')))       ")
SQL.ADD("                     OR                                                      ")
SQL.ADD("        ((M.Cuenta=C.Codigo) AND (C.Cliente=M.Cliente)                       ")
SQL.ADD("          AND (M.Cliente='"~VAR('VEHICULODE')~"')                            ")
SQL.ADD("          AND (T.TipoTr2 not in ('DEP','RET','COMP'))))                      ")
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~")                      ")
Endif
SQL.ADD("  AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha1-1)~"                         ")
SQL.ADD("  AND   C.Codigo = '"~fbn('CuentaFPA')~"'                                    ")
If Dialogo.Radio1=0
   SQL.ADD(" AND M.Cantidad < 0                                                       ")
Endif
If Dialogo.Radio1=1
   SQL.ADD(" AND M.Cantidad > 0                                                       ")
Endif
SQL.ADD("  UNION all")
SQL.ADD("  SELECT M.FechaMov, C.Numero, C.Codigo CuentaFPA, 0 Op, ' ' Cliente1,       ")
SQL.ADD("  E.Nombre, E.Codigo MonedaFPA, T.NrTrans, T.TipoTr2,                        ")
*****SQL.ADD("  M.Cantidad, 'Pendiente' Estado, M.Leyenda                                  ")
SQL.ADD("  CASE WHEN T.TipoTr2 in ('DEP','RET','COMP') THEN -M.Cantidad ELSE M.Cantidad END, ")
SQL.ADD("  'Pendiente' Estado, M.Leyenda                                              ")
SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C, ")
SQL.ADD("  "~DBO~".ESPECIES E                                                         ")
SQL.ADD("  WHERE M.NrTrans2 = T.NrTrans                                               ")
SQL.ADD("  AND   M.Especie = E.Codigo                                                 ")
SQL.ADD("  AND   E.Tipo = 'MON'                                                       ")
SQL.ADD("  AND  (((T.Cuenta2=C.Codigo) AND (T.TipoTr2 in ('DEP','RET','COMP')))       ")
SQL.ADD("                     OR                                                      ")
SQL.ADD("        ((M.Cuenta=C.Codigo) AND (C.Cliente=M.Cliente)                       ")
SQL.ADD("          AND (M.Cliente='"~VAR('VEHICULODE')~"')                            ")
SQL.ADD("          AND (T.TipoTr2 not in ('DEP','RET','COMP'))))                      ")
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~")                      ")
Endif
SQL.ADD("  AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha1-1)~"                         ")
SQL.ADD("  AND   C.Codigo = '"~fbn('CuentaFPA')~"'                                    ")
If Dialogo.Radio1=0
   SQL.ADD(" AND M.Cantidad < 0                                                       ")
Endif
If Dialogo.Radio1=1
   SQL.ADD(" AND M.Cantidad > 0                                                       ")
Endif
SQL.ADD("  ORDER BY CuentaFPA, MonedaFPA, FechaMov ")

