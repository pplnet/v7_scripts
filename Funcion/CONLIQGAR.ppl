
***---Liquidacion de Garantias
SQL.ADD(" SELECT T.NrTrans, T.Cantidad1, T.Especie EspecieLiq, O.NrOperacion, O.Especie, O.ContraEspecie, ")
SQL.ADD(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
SQL.ADD(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
SQL.ADD(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
SQL.ADD(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, ")
SQL.ADD(" O.MB2, O.FechaEx4, O.MB3, E.Cotiza, E.Cotiza Moneda, O.Observaciones, O.Precio1, O.Plazo, E.Alias8, V.Alias4, O.MB4, MA.Libro, O.Book1 Book ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, ")
SQL.ADD(" "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E,  ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND   O.Cliente1    =  C.Codigo   ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo   ")
SQL.ADD(" AND   T.Especie     =  E.Codigo   ")
SQL.ADD(" AND   T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" AND O.TipoOp IN ('GARANT') ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND T.Cantidad1 > 0 ")
SQL.ADD(" AND T.Cuenta2 = CU.Codigo ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILG'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
SQL.ADD(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
   If NoVAcio(Dialogo.Lista1)
      SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
SQL.ADD(" ORDER By O.NrOperacion, MA.Codigo, T.NrTrans ")
Recorrer SQL
    ACD(FV:1, fbn('Fecha2'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, val(FV:1))
    ACD(FO:2, Habiles(FinDeMes(val(FO:1),NO,'ARG')))
    let &book fbn('Book')
    ACD(FV:2, Val(FV:1))
    (.'FECHAVALOR'.)
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND (FechaValor > '"~IdxDate(Val(FO:2))~"' OR FechaValor =  '"~IdxDate(Val(FO:1))~"') AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
        let &modeloContable fbn('CodAsi')
        let &Moneda fbn('Moneda')
        SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo