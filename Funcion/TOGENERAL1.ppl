Impuestos   : 'IVA Com/100'    ;23;2;2;NO;NO;;;;0;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,MontoImpuesto('IVARGCOM',FECHAORDEN,3,VTXT16)/100,0);;;;;'############.####';
Cantidad10  : '%Comision'      ; 4;2;2;NO;SI;;;;;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,MontoArancelC('TIC',CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADTOTALORDEN*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1),4,,VTXT2,SI,,MERCADO3,,,SI,SI,,SI),0);;;;;'#,###.######';

MontoArancel: 'Monto Comision' ; 5;2;2;NO;  ;;;;0;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,MontoArancelC('TIC',CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADTOTALORDEN*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1),0,,VTXT2,SI,,MERCADO3,,,SI,SI,,SI),0);;;;;'###,###,###,###.##';
IvaArancel  : 'IVA Comision'   ; 6;2;2;NO;  ;;;;0;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,MontoArancel*IMPUESTOS,0);;;;;'###,###,###,###.##';

vCan44      : 'Derecho Merc'   ; 6;2;2;NO;NO;;;;;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,IvaGastos('TIC',ESPECIE,VEHICULO,'DMERC',0,,Mercado3));
MontoGastos : 'Derechos'       ; 7;2;2;NO;  ;;;;0;IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,CANTIDADTOTALORDEN*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1)*MontoGastos('TIC',ESPECIE,VEHICULO,'DMERC',0,4,,Mercado3)/100,0);;;;;'###,###,###,###.##';
IvaGastos   : 'IVA Derechos'   ; 8;2;2;NO;  ;;;;0;if(vCan44=1,IF(CANTIDADTOTALORDEN<>0 y PRECIOLIMITE<>0,MontoGastos*IMPUESTOS,0),0);;;;;'###,###,###,###.##';

