VTxt6      : 'Ctas/Saldos'     ; 4;2;2;NO;NO;;;;;SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~IF(EqStr(BuscarCampo('MERCADOS','Netea','Codigo',MERCADO),'SI'),VEHICULO,CLIENTE)~"' AND (Especies='"~ESPECIE~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') AND Mercado='"~MERCADO~"' and (TiposOperacion is NULL or TiposOperacion like '%"~VTXT30~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC");

