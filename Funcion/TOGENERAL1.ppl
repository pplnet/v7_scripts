** AA Cambio VTXT20 MONELOCA por CONTRAESPECIE, BZ la Comision debe tener misma funcionalidad que Cuenta Moneda
VTXT20   : 'Cta $/U$S'    ; 3;2;2;NO;NO;;;;;SQLSet("Select Codigo from "~DBO~".CUENTAS where Cliente='"~IF(EqStr(BuscarCampo('MERCADOS','Netea','Codigo',MERCADO),'SI'),BuscarCampo('MERCADOS','Cliente1','Codigo',MERCADO),CLIENTE)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and Mercado IN ('BCRA','SWIFT',"~Pipe2Comillas(VAR('MERCAACMC'))~") "~" and (TiposOperacion is NULL or TiposOperacion like '%"~VTXT30~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")
*Cuenta5  : 'Comisiones'   ; 3;1;2;  ;  ;NoVacio(Cuenta5) o EqStr(CUENTA5,VAR('CTAMOD23'));'Ingrese una cuenta de moneda Comisiones';NO;;IF(1<=IF(NoVacio(VTXT5),Elementos(VTXT5),0),ItemLista(VTXT5,1),VAR('CTAMOD23'));;;;;;"Cliente='"~IF(EqStr(BuscarCampo('MERCADOS','Netea','Codigo',MERCADO),'SI'),BuscarCampo('MERCADOS','Cliente1','Codigo',MERCADO),CLIENTE)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and "~" Mercado IN ('BCRA','SWIFT',"~Pipe2Comillas(VAR('MERCAACMC'))~")";
Cuenta5  : 'Cuenta Comisiones'; 3;1;2;EqStr(VTXT28,'NO');Not EqStr(CLIENTE,VEHICULO);NoVacio(Cuenta5) o EqStr(CUENTA5,VAR('CTAMOD23'));'Ingrese una cuenta de moneda Comisiones';NO;;IF(EqStr(VTXT28,'SI'),CUENTA4,IF(1<=IF(NoVacio(VTXT5),Elementos(VTXT5),0),ItemLista(VTXT5,1),VAR('CTAMOD23')));;;;;;"Cliente='"~IF(EqStr(BuscarCampo('MERCADOS','Netea','Codigo',MERCADO),'SI'),BuscarCampo('MERCADOS','Cliente1','Codigo',MERCADO),CLIENTE)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and "~IF(NOT EqStr(BuscarCampo('MERCADOS','Netea','Codigo',MERCADO),'SI')," Mercado='"~MERCADO2~"' "," Mercado IN ('BCRA','SWIFT',"~Pipe2Comillas(VAR('MERCAACMC'))~")");

