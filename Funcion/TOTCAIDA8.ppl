Recorrer&k 2, Val(CL:900)
    IF Dialogo.Radio3 = 0
        ***---Totalizo Filas Diario
        IF Not Eqstr(Val(&k:Val(FI:1)), 'Subtotal') Y Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
            SCN(TF:1000, Val(&k:fac-1))
            SCN(TF:2000, Val(&k:fac-1))
        ELSE
            IF Eqstr(Val(&k:Val(FI:1)), 'Subtotal')
                ACN(&k:fac-1, Val(TF:1000))
                ACN(TF:1000, 0)
            ELSE
                ACN(&k:fac-1, Val(TF:2000))
                ACN(TF:2000, 0)
            ENDIF
        ENDIF
    ENDIF
    IF Dialogo.Radio3 = 1
        ***---Totalizo Filas Mensual
        IF &k < Val(CL:900)
            SCN(TF:1000, Val(&k:fac-1))
        ENDIF
        ACN(Val(CL:900):fac-1, Val(TF:1000))
    ENDIF
    IF Dialogo.Radio3 = 2
        ***---Totalizo Filas Anual
        IF Not Eqstr(Val(&k:Val(FI:2)), 'TOTAL') Y Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
            SCN(TF:1000, Val(&k:fac-1))
        ELSE
            IF Eqstr(Val(&k:Val(FI:2)), 'TOTAL')
                ACN(&k:fac-1, Val(TF:1000))
                SCN(TF:2000, Val(TF:1000))
                ACN(TF:1000, 0)
            ELSE
                ACN(&k:fac-1, Val(TF:2000) + Val(TF:1000))
                ACN(TF:2000, 0)
            ENDIF
        ENDIF
    ENDIF
    IF Val(FU:1) = 1
        ***---Sumarizo Subtotales, Total Vehiculo y Total Gral. (Por Columna)
        ACN(&k:fac, Sum(&k:Val(FI:1000)..&k:fac-1))
        ACN(&k:fac+2, Val(16000:&k)+Val(&k:fac))
        SCN(16001:&k, Val(&k:fac+2))
        ACN(16000:&k, 0)
    ENDIF
    IF Val(FU:1) = 2
        ***---Sumarizo Subtotales por columna
        ACN(&k:fac, Sum(&k:Val(FI:1000)..&k:fac-1))
        SCN(16000:&k, Val(&k:fac))
    ENDIF
    IF Val(FU:1) = 3
        ***---Sumariza ultimo subtotal
        ACN(&k:fac, Sum(&k:Val(FI:1000)..&k:fac-1))
        ACN(&k:fac+2, Val(16000:&k)+Val(&k:fac))
        IF Dialogo.Radio4 = 0
            ACN(&k:fac+4, Val(16001:&k)+Val(&k:fac+2))
        ELSE
            ACT(BD:6, 'GENERAL')
            AFI(fac+2, 30)
        ENDIF
    ENDIF
Proximo
ACN(TF:1000, 0)
