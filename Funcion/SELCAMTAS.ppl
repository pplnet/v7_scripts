**Select evento CAMTAS
SQL.ADD(" Select DISTINCT O.NrOperacion,O.TipoOp,O.RB6 From ")
SQL.ADD(" "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion=C.NrOperacion ")
SQL.ADD(" and O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMONM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') ")
SQL.ADD(" and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
if Dialogo.Check1=1
  SQL.ADD("and O.TotalAux1 = "~Fstr(Dialogo.Precio6,0,7)~" ")
endif
if Dialogo.Check2=1
  SQL.ADD("and O.ImpGastos2 = "~Fstr(Dialogo.Precio7,0,7)~" ")
endif
if Dialogo.Check3=1
  SQL.ADD("and O.Precio3 = "~Fstr(Dialogo.Precio8,0,7)~" ")
endif
if Dialogo.Check4=1
  SQL.ADD("and O.Precio2 = "~Fstr(Dialogo.Cantidad3,0,7)~" ")
endif
if Dialogo.Check5=1
  SQL.ADD("and O.TasaPrecan = "~Fstr(Dialogo.Cantidad2,0,7)~" ")
endif
if Dialogo.Check6=1
  SQL.ADD("and O.ImpGastos1 = "~Fstr(Dialogo.Cantidad1,0,7)~" ")
endif
if Dialogo.Check7=1
  SQL.ADD("and O.TotalAux2 = "~Fstr(Dialogo.Cantidad4,0,7)~" ")
endif
if Dialogo.Check8=1
   If Dialogo.Cantidad5>0
      SQL.ADD(" and ((O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') and O.TasaImp1="~Fstr(Dialogo.Cantidad5,0,7)~")  ")
      SQL.ADD(" or (O.TipoOp In ('MMONM') and C.Tasa3="~Fstr(Dialogo.Cantidad5,0,7)~"))  ")
   Else 
      SQL.ADD(" and ((O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') and (O.TasaImp1 Is NULL or O.TasaImp1=0))  ")
      SQL.ADD(" or (O.TipoOp In ('MMONM') and (C.Tasa3 IS NULL or C.Tasa3=0)))  ")
   EndIf
Endif
if Dialogo.Check9=1
  SQL.ADD(" and O.IntDevengados1="~Fstr(Dialogo.Cantidad7,0,7)~" ")
endif
if Dialogo.Check10=1
  SQL.ADD(" and O.DeltaTasa="~Fstr(Dialogo.Cantidad9,0,7)~" ")
endif
if NOVACIO(Dialogo.NrOperacion1)
  SQL.ADD("and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
endif