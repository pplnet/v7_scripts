* H2 Contador de Sin Tasa
ACN(H2,0)


SQL.ADD("SELECT  P.Vehiculo1,P.Vehiculo2,P.ListaEspecies FROM  "~DBO~".PARESVEHICULO P ")
SQL.ADD("Where Estado='HAB' ")
SQL.ADD("Order By P.Vehiculo1,P.Vehiculo2")

Recorrer SQL

   DFA  
   Message('Pares de Vehiculos: '~FBN['Vehiculo1']~'/'~FBN['Vehiculo2']~'  ...')

   ACT(AV1,FBN['Vehiculo1'])
   ACT(AV2,FBN['Vehiculo2'])

   * Recupero las Especies contenidas en Pares de Vehiculo
   SQL.ADD("SELECT Codigo FROM  "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(FBN['ListaEspecies'])~") ") 

   * Displayo una vez cada Par de Vehiculos
   Recorrer SQL

       ACN(f:fac, SQL("SELECT Tasa    from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~VAL(AV1)~"' and Vehiculo2='"~VAL(AV2)~"') or (Vehiculo1='"~VAL(AV2)~"' and Vehiculo2='"~VAL(AV1)~"')) and Especie ='"~FBN['Codigo']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
 
       * No encontro el Mov. Diario => Busco el Mov. Mensual
       IF VAL(f:fac)=0
          Cancelar("La Tasa '"~VAL(AV1)~"'/'"~VAL(AV2)~"'-'"~FBN['Codigo']~"' Es Incorrecta")
          SCN(H2,1)
      EndIf 
   Proximo
Proximo
