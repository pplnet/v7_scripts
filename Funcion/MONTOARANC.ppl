*- Recupera el Minimo (va1), Fijo  (va3) y Maximo  (va2)
*- z7: Codigo de Cliente v5: TipoArancel z6: Vehiculo z5: Monto z8: Mercado z11: EstadosCustodia 
*- v4: TipoCliente 

SQL.ADD("Select A.Minimo MinAra, A.Fijo FijoAra, A.Maximo MaxAra,")
SQL.ADD("       B.Minimo MinCli, B.Fijo FijoCli, B.Maximo MaxCli,")
SQL.ADD("       C.Minimo MinTip, C.Fijo FijoTip, C.Maximo MaxTip ")
*-i
*SQL.ADD("FROM "~DBO~".ARANCELES A, "~DBO~".ARANCELESCLIENTE B,"~DBO~".ARANCELESTIPOSCLIENTE  C where ")
SQL.ADD("FROM "~DBO~".ARANCELES A LEFT OUTER JOIN "~DBO~".ARANCELESCLIENTE B ON A.Codigo *= B.Arancel LEFT OUTER JOIN "~DBO~".ARANCELESTIPOSCLIENTE  C ON A.Codigo = C.Arancel  where ")
*SQL.ADD("A.Codigo *= B.Arancel and ")
*SQL.ADD("A.Codigo *= C.Arancel and ")
*-f
SQL.ADD("B.Cliente = '"~VAL(z7)~"' and ")
If NoVacio(val(z4))
   SQL.ADD("C.TipoCliente='"~VAL(v4)~"' and ")
EndIf
SQL.ADD("A.TipoArancel = '"~VAL(v5)~"' and ")
SQL.ADD("A.Vehiculo = '"~VAL(z11)~"' and ")
SQL.ADD("(A.DesdeMonto <= "~Fstr(VAL(z5),0,2)~" or A.DesdeMonto is null)    and ")
SQL.ADD("(A.HastaMonto >= "~Fstr(VAL(z5),0,2)~" or A.HastaMonto is null)    and ")
SQL.ADD("(A.Mercado = '"~VAL(z8)~"' or A.Mercado is null or A.Mercado = '') and ")
SQL.ADD("(A.EstadosCustodia Like '"~VAL(z11)~"|%' or A.EstadosCustodia is Null or A.EstadosCustodia='' or A.EstadosCustodia=' ') and ")
SQL.ADD("(A.Movimiento= 'MAN' or A.Movimiento is null or A.Movimiento='' ) ")

*- Prioriza Cliente, TipoCliente o Arancel 
Recorrer SQL
  dfa

  *- Minimo 
  acn(va1,FBN['MinCli'])

  If val(va1)=0 o Vacio(val(va1))
     acn(va1,FBN['MinTip'])
  EndIf

  If val(va1)=0 o Vacio(val(va1))
     acn(va1,FBN['MinAra'])
  EndIf


  *- Maximo
  acn(va2,FBN['MaxCli'])

  If val(va2)=0 o Vacio(val(va2))
     acn(va2,FBN['MaxTip'])
  EndIf

  If val(va2)=0 o Vacio(val(va2))
     acn(va2,FBN['MaxAra'])
  EndIf

  *- Fijo
  acn(va3,FBN['FijoCli'])

  If val(va3)=0 o Vacio(val(va3))
     acn(va3,FBN['FijoTip'])
  EndIf

  If val(va3)=0 o Vacio(val(va3))
     acn(va3,FBN['FijoAra'])
  EndIf
