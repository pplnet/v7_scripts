*---   Forward de cambios
SQL.ADD(" Select 1 as Orden,             O.NrOperacion,          O.Cantidad as CapIni, ")
SQL.ADD("        O.FechaOp as FechaIni,  O.FechaVto as FechaVto, O.Cliente1,           ")
SQL.ADD("        O.Vehiculo1,            O.Especie,              O.TipoOp,             ")
SQL.ADD("        O.TotalBrutoCli1 Monto, O.Precio1,              O.PrecioRef,          ")
SQL.ADD("        O.Especie as EspecieOp, O.ContraEspecie,        null as FechaPago,    ")
SQL.ADD("        O.Plazo,                O.RB8                   ")
SQL.ADD("   from "~DBO~".OPERACIONES  O ")
SQL.ADD("  where O.PrecioRef Is Not Null ")
SQL.ADD("    and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' or O.FechaPago>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("    and O.TipoOp In ('FXCT','FXVT','FXAT') ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

SQL.ADD("Union All")

SQL.ADD(" Select 2 as Orden,             O.NrOperacion,              O.Cantidad as CapIni,      ")
SQL.ADD("        O.FechaOp as FechaIni,  O.FechaPago as FechaVto,    O.Cliente1,                ")
SQL.ADD("        O.Vehiculo1,            O.ContraEspecie as Especie, O.TipoOp,                  ")
SQL.ADD("        O.TotalBrutoCli1 Monto, O.Precio1,                  O.PrecioRef4 as PrecioRef, ")
SQL.ADD("        O.Especie as EspecieOp, O.ContraEspecie,            Null as FechaPago,         ")
SQL.ADD("        O.Plazo,                O.RB8                       ")
SQL.ADD("   from "~DBO~".OPERACIONES  O ")
SQL.ADD("  where O.PrecioRef Is Not Null ")
SQL.ADD("    and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' or O.FechaPago>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("    and O.TipoOp In ('FXCT','FXVT','FXAT') ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

SQL.ADD("Union All")

*--- FRA (Cargados como DTSFV)
SQL.ADD(" Select 1 as Orden,             O.NrOperacion,                                                       O.Cantidad as CapIni, ")
SQL.ADD("        O.FechaOp as FechaIni,  O.FechaOp2 as FechaVto,                                              O.Cliente1, ")
SQL.ADD("        O.Vehiculo1,            O.Especie,                                                           O.TipoOp, ")
SQL.ADD("        O.TotalBrutoCli1 Monto, CASE RB9 WHEN 0 THEN O.Precio3 ELSE O.TotalGanancias END as Precio1, O.PrecioRef, ")
SQL.ADD("        O.Especie as EspecieOp, O.ContraEspecie,                                                     O.FechaPago, ")
SQL.ADD("        O.Plazo,                O.RB8 ")
SQL.ADD("   from "~DBO~".OPERACIONES  O ")
SQL.ADD("  where O.PrecioRef Is Not Null ")
SQL.ADD("    and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and O.FechaEj>'"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("    and O.TipoOp In ('DTSFV') ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

SQL.ADD("Union All")

SQL.ADD(" Select 2 as Orden,             O.NrOperacion,                                                       O.Cantidad as CapIni, ")
SQL.ADD("        O.FechaOp as FechaIni,  O.FechaEj as FechaVto,                                               O.Cliente1, ")
SQL.ADD("        O.Vehiculo1,            O.ContraEspecie as Especie,                                          O.TipoOp, ")
SQL.ADD("        O.TotalBrutoCli1 Monto, CASE RB9 WHEN 0 THEN O.Precio3 ELSE O.TotalGanancias END as Precio1, O.PrecioRef4 as PrecioRef, ")
SQL.ADD("        O.Especie as EspecieOp, O.ContraEspecie,                                                     O.FechaPago, ")
SQL.ADD("        O.Plazo,                O.RB8 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("  where O.PrecioRef Is Not Null ")
SQL.ADD("    and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and O.FechaEj>'"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("    and O.TipoOp In ('DTSFV') ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

SQL.ADD("order by  2,1 ")
