SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

SQL.ADD("Select '4' Tipo, T.Fecha1 FechaOrd, T.Fecha1 FechaReal, ")
SQL.ADD("        T.NrTrans NrOperacion, T.Vehiculo1 Vehiculo, T.Cliente1 Cliente, '' Book, T.Especie, T.Cupon1 Cupon, 0 NrSaldo, ")
SQL.ADD("        T.Cantidad5 Cantidad, T.Precio2 Precio, -1 Signo, T.Especie1 Moneda ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.TipoTr2       =  'PCUPON' ")
SQL.ADD("   and T.Especie2      in  ("~Pipe2Comillas(Val(x:1))~") ")
*SQL.ADD("   and T.NrSaldo      =  "~Val(x:2)~" ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and T.Vehiculo1 in ("~Pipe2Comillas(val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and T.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
