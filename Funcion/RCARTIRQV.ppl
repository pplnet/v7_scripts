***********************
* Saldo Inicial
***********************
SQL.ADD("Select '1' Tipo, "~IdxDate2(Val(az:7))~" FechaOrd, P2.Fecha FechaReal, ")
SQL.ADD("        '' NrOperacion, P2.Vehiculo, P2.Cliente, P2.Book, P2.Especie, P2.Cupon, P2.NrSaldo, ")
SQL.ADD("        P2.CantidadFin Cantidad, P2.PrecioFin Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".POSICIONES P2 ")
SQL.ADD(" where P2.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("  and  P2.NrSaldo      =  "~Val(x:2)~" ")
SQL.ADD("  and  P2.CantidadFin  <> 0 ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P2.Vehiculo in ("~Pipe2Comillas(val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and P2.Vehiculo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("  and  P2.Book      = '"~Dialogo.Book1~"' ")
endif
SQL.ADD("  and  P2.Fecha     = (select Max(P3.Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P3 ")
SQL.ADD("                       where P3.Especie     =  P2.Especie ")
SQL.ADD("                        and  (P3.Cupon      =  P2.Cupon or (P3.Cupon IS NULL and P2.Cupon IS NULL)) ")
SQL.ADD("                        and  P3.Vehiculo    =  P2.Vehiculo ")
SQL.ADD("                        and  (P3.Book       =  P2.Book or (P3.Book IS NULL and P2.Book IS NULL)) ")
SQL.ADD("                        and  P3.NrSaldo     =  P2.NrSaldo ")
SQL.ADD("                        and  P3.TipoNegocio =  P2.TipoNegocio ")
SQL.ADD("                        and  P3.Fecha       <= "~IdxDate2(Val(az:7))~" ")
SQL.ADD("                   ) ")

SQL.ADD(" Union All ")

***********************
* Movimientos
***********************
SQL.ADD("Select '2' Tipo, M.FechaMov FechaOrd, M.FechaMov FechaReal, ")
SQL.ADD("        M.NrOperacion, M.Vehiculo, M.Cliente, M.Book, M.Especie, M.Cupon, M.NrSaldo, ")
SQL.ADD("        M.Cantidad, M.Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".MOVPOSEJE M ")
SQL.ADD(" where M.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("  and  M.NrSaldo      =  "~Val(x:2)~" ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and M.Vehiculo in ("~Pipe2Comillas(val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and M.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("  and  M.Book      = '"~Dialogo.Book1~"' ")
endif
SQL.ADD("  and  M.FechaMov    >= "~IdxDate2(Val(az:7))~" ")
SQL.ADD("  and  M.FechaMov    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

***********************
* Cupon Amortizacion
***********************
SQL.ADD("Select '3' Tipo, T.Fecha1 FechaOrd, T.Fecha1 FechaReal, ")
SQL.ADD("        T.NrTrans NrOperacion, T.Vehiculo1 Vehiculo, T.Cliente1 Cliente, '' Book, T.Especie, T.Cupon1 Cupon, 0 NrSaldo, ")
SQL.ADD("        T.Cantidad6 Cantidad, T.Precio3 Precio, 1 Signo, T.Especie1 Moneda ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.TipoTr2       =  'CCUPON' ")
SQL.ADD("   and T.Especie2      in  ("~Pipe2Comillas(Val(x:1))~") ")
*SQL.ADD("   and T.NrSaldo      =  "~Val(x:2)~" ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and T.Vehiculo1 in ("~Pipe2Comillas(val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and T.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Book1)
*  SQL.ADD("  and  T.Book1      = '"~Dialogo.Book1~"' ")
endif
SQL.ADD("  and  T.Cantidad6 > 0 ")
SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Val(az:7))~" ")
SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

SQL.ADD("Select '3' Tipo, T.Fecha1 FechaOrd, T.Fecha1 FechaReal, ")
SQL.ADD("        T.NrTrans NrOperacion, T.Vehiculo1 Vehiculo, T.Cliente1 Cliente, '' Book, T.Especie, T.Cupon1 Cupon, 0 NrSaldo, ")
SQL.ADD("        T.Cantidad6 Cantidad, T.Precio3 Precio, -1 Signo, T.Especie1 Moneda ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.TipoTr2       =  'PCUPON' ")
SQL.ADD("   and T.Especie2      in  ("~Pipe2Comillas(Val(x:1))~") ")
*SQL.ADD("   and T.NrSaldo      =  "~Val(x:2)~" ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and T.Vehiculo1 in ("~Pipe2Comillas(val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and T.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Book1)
*  SQL.ADD("  and  T.Book1      = '"~Dialogo.Book1~"' ")
endif
SQL.ADD("  and  T.Cantidad6 > 0 ")
SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Val(az:7))~" ")
SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

***********************
