*****************************************************************************************
**- GENDIVIDEN
*****************************************************************************************
**- Actualizo las Operaciones segun el tipo de operacion

**- Genera la transaccion pago de cupon ***
*-- AA1=MB3=> 1:Pago 0: Cobro
act(aa1,'0')

IF Incluido(VAL(b:val(w1)),'SERP|SERPV|')
   act(aa1,'1')
ENDIF
* MessageBox('1')
**-- Obtengo el numerador para la transaccion.
* if Val(d:val(w1))<>0 y [Incluido(VAL(b:val(w1)),'SERA|SERAV|SERP|SERPV') o VAL(n:val(w1))=101]

   Message('Generando Operacion de Dividendo '~VAL(b:val(w1))~' '~FStr(VAL(n:val(w1)),0,0))

   ACT(Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Val(c:val(w1))))) 

   * Z4: MB4 0:Spot 1: Posiciones 2: Repo 3: Saldos
   ACT(Z4,'0')
* MessageBox('2')
   IF Incluido(VAL(b:val(w1)),'SECT|SECTV|SEVT|SEVTV')
      ACT(Z4,'1')
   EndIf
* MessageBox('3')
   IF Incluido(VAL(b:val(w1)),'SERA|SERAV|SERP|SERPV')
      ACT(Z4,'2')
   EndIf
* MessageBox('4')
   IF Incluido(Copy(VAL(b:val(w1)),1,3),'SAL')
      ACT(Z4,'3')
   EndIf

* MessageBox('5')
   if Vacio(Dialogo.Especie2)
      act(aa5,'ARP')
   else
      act(aa5,Dialogo.Especie2)
   endif
