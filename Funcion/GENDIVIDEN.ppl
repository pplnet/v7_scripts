   ** Ingreso Transaccion2 **
   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, MB3, NrOperacion, Especie, ContraEspecie, Cliente1, ")
   SQL.ADD(" Cantidad, TotalBrutoCli1, TotalBrutoCli3, TotalBrutoCli2, TotalNetoCli1, TotalNetoCli2, TotalNetoCli3, ")
   SQL.ADD(" FechaOp, FechaPago, FechaCargaSys, FechaCarga, ")
   SQL.ADD(" Vehiculo1, ")
   SQL.ADD(" Precio1, Precio2, Precio3, Precio4, Spread, ")
   SQL.ADD(" TipoCambio2, RB1, RB2, RB4, RB5, Direccion, ")
   SQL.ADD(" OperacionRef,TipoCambio,RB3,MB4,TipoCambio3,MB2, Book1, Cuenta1, UsrInput, Operador) ")
   SQL.ADD("Values")
   SQL.ADD("('DIVIDE','"~Val(aa1)~"', '"~Val(Z3)~"', '"~Dialogo.Especie1~"', '"~Val(aa5)~"', '"~val(a:val(w1))~"',")
   SQL.ADD(" "~FStr(Val(d:val(w1)),0,4)~", "~FStr(Val(af:val(w1)),0,4)~", ")
   SQL.ADD(" "~FStr(Val(ah:val(w1)),0,4)~", "~FStr(Val(ai:val(w1)),0,4)~", ")
   SQL.ADD(" "~FStr(Val(al:val(w1)),0,4)~", "~FStr(Val(ak:val(w1)),0,4)~", "~FStr(Val(aj:val(w1)),0,4)~", ")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~IdxDate(FSYS)~"', "~SQLAhora~", ")
   SQL.ADD(" '"~VAL(c:val(w1))~"', ")
   SQL.ADD(" "~FStr(Dialogo.Precio1,0,7)~", "~FStr(Dialogo.Precio2,0,7)~", ")
   SQL.ADD(" "~FStr(Dialogo.Precio3,0,7)~", "~FStr(Dialogo.Precio4,0,8)~", ")
   SQL.ADD("  "~FStr(val(g:fac),0,7)~", "~FStr(Dialogo.Precio10,0,7)~", ")
   SQL.ADD(" '"~FStr(Dialogo.Check1,0,0)~"', '"~FStr(Dialogo.Check2,0,0)~"',  ")
   SQL.ADD(" '"~FStr(Dialogo.Check3,0,0)~"', '"~FStr(Dialogo.Check4,0,0)~"',2, ")
   SQL.ADD(" '"~VAL(k:val(w1))~"',"~FStr(Dialogo.Precio5,0,5)~",'1', ")
   SQL.ADD(" '"~Val(Z4)~"',"~FStr(VAL(n:val(w1)),0,0)~",'"~FStr(VAL(o:val(w1)),0,0)~"', '"~VAL(l:val(w1))~"', '"~Val(CC:Val(W:1))~"', '"~UsuarioActivo~"', '"~UsuarioActivo~"') ")
   SQL.NEW
   SQL.EXEC
