Message('         Asientos de Liquidacion Diferimentos AC')
***---Asiento ContraEspecie
SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.Cliente2, O.ContraEspecie, O.TotalAux5, ")
SQL.ADD(" O.Sucursal, O.TotalBrutoCli1, O.TotalGastos, O.TotalDerechos, ")
SQL.ADD(" O.TotalRetenciones, O.TotalImpuestos, O.TotalNetoCli1, O.TotalAux1, O.TotalAux2, ")
SQL.ADD(" O.TotalAux3, O.TotalIVA, O.PaseCB, O.Especie, O.Cliente1 Cliente, MA.Codigo CodAsi, ")
SQL.ADD(" O.Comision, C.Equipo, E2.Cotiza, E2.MonedaEmision, O.CB8, O.OperacionRef, ")
SQL.ADD(" O.Cartera, O.TotalBrutoCli2, O.TotalNetoCli2, O.Centro1, O.Plazo, O.FechaOp, ")
SQL.ADD(" O.FechaVto, O.TotalIntereses, O.Cantidad, O.Vehiculo1, O.Cliente1, O.NrOperacion2, ")
SQL.ADD(" O.CB5, O.NrOperacion2, E2.Tipo, O.NrOperacion3, C.CategDepositante, C.Sector, ")
SQL.ADD(" O.PorDerechoMercado, O.PorImpuestoBolsa, O.PorDerechoBolsa, O.InteresesCorr, O.Book1, ")
SQL.ADD(" O.Mercado2, O.CuentaContable1, O.CuentaContable2, O.Mercado, E2.InteresesC, ")
SQL.ADD(" O.ContraEspecie EspecieL, O.TotalCaucion, O.Cotizacion1, O.Cuenta2, O.Cuenta3, ")
SQL.ADD(" O.PrecioMer, O.Puesto, O.TotalAux6, O.Precio1, O.RB10, O.TotalAux4, 0 NrGrupo, ")
SQL.ADD(" O.FechaVto Fecha1, 'DIFER' TipoTr2, O.TotalGastos, O.TotalCaucion ")
SQL.ADD(" From "~DBO~".ESPECIES E2, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" Where E2.Codigo = O.Especie ")
SQL.ADD(" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
***---SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") ")
SQL.ADD(" AND ((MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") AND "~Fstr(fbn('NrCuota'), 0, 0)~" = 1) ")
SQL.ADD("        OR (MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILFA'))~") AND "~Fstr(fbn('NrCuota'), 0, 0)~" > 1)) ")
SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")
SQL.ADD(" AND O.FechaVto >= "~IdxDate2(Habiles(FSYS,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" Order By MA.Codigo, O.NrOperacion ")
Recorrer SQL
    Message('Asiento: '~fbn('CodAsi')~' '~fbn('NrOperacion'))
    ACN(NT:1, fbn('TotalNetoCli1'))
    ACT(AL:1, BuscarCampo('CUENTAS','CuentaContable1','Codigo', fbn('Cuenta3')))
    ACT(AL:2, Val(AL:1))
    ACT(BC:1, BuscarCampo('CUENTAS','Corresponsal','Codigo', fbn('Cuenta3')))
    ACT(BC:2, Val(BC:1))
    IF Val(NC:1) = 1
        ***---Es primer diferimento => Debo generar Liquidacion vto. original
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') "))
            ***---No tiene un asiento ya enviado y no reversado.
            SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,Fsys,Dialogo.Fecha1)
        Else
            message('La operacion ya tiene un asiento de liquidacion de fondos.')
        Endif
    ELSE
        ***---No es primer diferimento => Debo generar Liquidacion de falla del diferimento 
        ***---anterior
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'OK' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND FechaGeneracion = '"~IdxDate(Dialogo.Fecha1)~"' "))
            ***---No tiene un asiento ya enviado y no reversado.
            SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,Fsys,Dialogo.Fecha1)
        Else
            message('La operacion ya tiene un asiento de liquidacion de fondos.')
        Endif
    ENDIF
    SQL.EXEC
Proximo
***---Asiento Especie
SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.Cliente2, O.Especie, O.Sucursal, O.PaseCB, ")
SQL.ADD(" 'DIFER' TipoTr2, O.Cliente1 Cliente, O.Cantidad, MA.Codigo CodAsi, O.Comision, ")
SQL.ADD(" C.Equipo, E.Cotiza, E.MonedaEmision, E.VTeorico, O.OperacionRef, O.Cartera, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalDerechos, O.TotalAux1, O.TotalAux2, O.TotalAux3, O.TotalIVA, ")
SQL.ADD(" O.TotalGastos, O.ContraEspecie, O.TotalNetoCli1, O.TotalBrutoCli2, O.TotalAux1, ")
SQL.ADD(" O.TotalNetoCli2, O.Centro1, O.Plazo, O.FechaOp, O.FechaVto, O.TotalIntereses, ")
SQL.ADD(" O.TotalCaucion, O.Vehiculo1, O.Cliente1, O.CB5, O.NrOperacion2, E.Tipo, O.NrOperacion3, ")
SQL.ADD(" C.CategDepositante, C.Sector, O.PorDerechoMercado, O.PorImpuestoBolsa, O.FechaVto Fecha1, ")
SQL.ADD(" O.PorDerechoBolsa, O.InteresesCorr, O.Book1, O.Mercado2, O.CuentaContable1, ")
SQL.ADD(" O.CuentaContable2, O.Mercado, E.InteresesC, O.Especie EspecieL, O.Cotizacion1, ")
SQL.ADD(" O.Cuenta2, O.Cuenta3, O.Cuenta1, O.TotalAux5, O.PrecioMer, O.Puesto, O.TotalAux6, ")
SQL.ADD(" O.Precio1, O.RB10, 0 NrGrupo, O.TotalGastos, O.TotalCaucion ")
SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" Where E.Codigo  = O.Especie ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND C.Codigo  = O.Cliente1 ")
***---SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILT'))~") ")
SQL.ADD(" AND ((MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILT'))~") AND "~Fstr(fbn('NrCuota'), 0, 0)~" = 1) ")
SQL.ADD("        OR (MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILFA'))~") AND "~Fstr(fbn('NrCuota'), 0, 0)~" > 1)) ")
SQL.ADD(" AND O.FechaVto >= "~IdxDate2(Habiles(FSYS,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")
SQL.ADD(" Order By MA.Codigo, O.NrOperacion ")
Recorrer SQL
    Message('Asiento '~fbn['CodAsi']~' '~fbn['NrOperacion'])
    ACN(NT:1, fbn('TotalNetoCli1'))
    ACT(AL:1, BuscarCampo('CUENTAS','CuentaContable1','Codigo', fbn('Cuenta2')))
    ACT(AL:2, Val(AL:1))
    ACT(BC:1, BuscarCampo('CUENTAS','Corresponsal','Codigo', fbn('Cuenta2')))
    ACT(BC:2, Val(BC:1))
    IF Val(NC:1) = 1
        ***---Es primer diferimento => Debo generar Liquidacion vto. original
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') "))
           SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
           SQL.EXEC
        Else
           message('La operacion ya tiene un asiento de liquidacion de titulos.')
        Endif
    ELSE
        ***---No es primer diferimento => Debo generar Liquidacion de falla del diferimento 
        ***---anterior
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'OK' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND FechaGeneracion = '"~IdxDate(Dialogo.Fecha1)~"' "))
           SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
           SQL.EXEC
        Else
           message('La operacion ya tiene un asiento de liquidacion de titulos.')
        Endif
    ENDIF
Proximo

Message('          Asientos de Fallas Diferimentos AC')
***---Falla de Especie
SQL.ADD(" SELECT O.NrOperacion, E.Tipo, E.Cotiza, MA.Codigo CodAsi, MA.TipoAsiento, ")
SQL.ADD(" MA.TipoOp, O.TipoOp, O.PaseCB, O.Especie, O.ContraEspecie, O.Mercado, ")
SQL.ADD(" O.NrOperacion3, O.OperacionRef, O.CuentaContable1, O.Vehiculo1, O.PorDerechoBolsa, ")
SQL.ADD(" O.PorImpuestoBolsa, O.Book1, E.MonedaEmision, O.Cliente1 Cliente, E.InteresesC, ")
SQL.ADD(" O.Mercado2, O.CuentaContable2, O.PorDerechoMercado, O.InteresesCorr, O.Cantidad, ")
SQL.ADD(" O.Cuenta2, O.Cuenta3, O.Especie EspecieL, 0 BD1, O.FechaOp, O.FechaVto, O.Puesto, ")
SQL.ADD(" 0 BD1, O.TotalNetoCli1, O.TotalGastos, O.TotalCaucion ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" Where O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND E.Codigo = O.Especie ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIF'))~") ")
SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")

SQL.ADD(" UNION ")

***---Falla de ContraEspecie
SQL.ADD(" SELECT O.NrOperacion, E.Tipo, E.Cotiza, MA.Codigo CodAsi, MA.TipoAsiento, ")
SQL.ADD(" MA.TipoOp, O.TipoOp, O.PaseCB, O.Especie, O.ContraEspecie, O.Mercado, ")
SQL.ADD(" O.NrOperacion3, O.OperacionRef, O.CuentaContable1, O.Vehiculo1, O.PorDerechoBolsa, ")
SQL.ADD(" O.PorImpuestoBolsa, O.Book1, E.MonedaEmision, O.Cliente1 Cliente, E.InteresesC, ")
SQL.ADD(" O.Mercado2, O.CuentaContable2, O.PorDerechoMercado, O.InteresesCorr, O.Cantidad, ")
SQL.ADD(" O.Cuenta2, O.Cuenta3, O.ContraEspecie EspecieL, 1 BD1, O.FechaOp, O.FechaVto, ")
SQL.ADD(" O.Puesto, 1 BD1, O.TotalNetoCli1, O.TotalGastos, O.TotalCaucion ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" Where O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND E.Codigo = O.Especie ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIF'))~") ")
SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")
Recorrer SQL
    IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'OK' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND FechaGeneracion = '"~IdxDate(Dialogo.Fecha1)~"' "))
        ***---No tiene un asiento ya enviado y no reversado.
        Message(fbn('NrOperacion')~' '~fbn('CodAsi'))
        IF fbn('BD1') = 0
            ACT(AL:1, BuscarCampo('CUENTAS','CuentaContable1','Codigo', fbn('Cuenta2')))
            ACT(BC:1, BuscarCampo('CUENTAS','Corresponsal','Codigo', fbn('Cuenta2')))
            ACN(NT:1, fbn('Cantidad'))
        ELSE
            ACT(AL:1, BuscarCampo('CUENTAS','CuentaContable1','Codigo', fbn('Cuenta3')))
            ACT(BC:1, BuscarCampo('CUENTAS','Corresponsal','Codigo', fbn('Cuenta3')))
            ACN(NT:1, fbn('TotalNetoCli1'))
        ENDIF
        ACT(AL:2, Val(AL:1))
        ACT(BC:2, Val(BC:1))
        SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,Fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

