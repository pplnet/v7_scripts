*- Recibe como parametro ba1: Fecha Transaccion ba2: Codigo de Siscen ba3:Cta Contable
*- Devuelve ba11: Valor Contable ba12:Valor Residual
ACN(ba11,0)
ACN(ba12,0)

SQL.ADD(" SELECT Sum(T2.Cantidad1) VC,  Sum(T2.Cantidad2) VR")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T2 WITH (NOLOCK) INNER JOIN "~DBO~".ESPECIES E")
SQL.ADD("     WITH (NOLOCK) ON (T2.Especie = E.Codigo)")
SQL.ADD(" WHERE  T2.Fecha1 ='"~IdxDate(Val(ba1))~"'  AND T2.Ley1 = '"~Val(ba3)~"' and T2.TipoTr2='AJ3920' ")

