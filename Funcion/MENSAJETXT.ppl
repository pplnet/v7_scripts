If Val(tx:2) = 1
  EscribirAscii('La especie '~Val(es:1)~' no existe en FPA') 
Else
  If Val(tx:2) = 2
    EscribirAscii('Tipo Tasa '~Val(ta:2)~' no existe en FPA')
  Else
    If Val(tx:2) = 3
      EscribirAscii('Especie '~Val(es:1)~' con precio de compras y venta en cero') 
    Else
      If Val(tx:2) = 4
        EscribirAscii('Especie '~Val(es:1)~' con precios en cero')
      Else
        If Val(tx:2) = 5
          EscribirAscii('Tipo tasa '~Val(ta:2)~' con tasa en cero')
        Else
           If Val(tx:2) = 6
             EscribirAscii('No se pudo abrir la planilla '~Val(pn:2))
           Else
             If Val(tx:2) = 7
                EscribirAscii('Formato de fecha erronea para '~Val(A:fac)~Val(B:fac))
             Else
                If Val(tx:2) = 8
                   EscribirAscii('Fecha para Tasas Mayor que Fecha Proceso  '~Val(E:fac))
                Else
                   If Val(tx:2) = 9
                       EscribirAscii('Especie '~Val(es:1)~' con precio close en cero')
                   Else
                            If Val(tx:2) = 10
                            EscribirAscii('El plazo de la especie '~Val(a:Val(z5))~' es menor a cero ')
                            Else
                                If Val(tx:2) = 11
                                    EscribirAscii('Mercado de la especie '~Val(a:Val(z5))~' no registrado')
                                else
                                    If Val(tx:2) = 12
                                       EscribirAscii('Divisor de la cotizacion de la especie '~Val(a:Val(z5))~' Erroneo ')
                                    Endif
                                Endif
                            EndIf
                   Endif
                EndIf
             EndIf
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf
EndIf

ACN(tx:2, 0)