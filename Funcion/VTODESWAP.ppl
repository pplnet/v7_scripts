SQL.ADD("Union All ")
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'PS' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaVto2 FechaSett,O.TipoTasa,O.PrecioRef,O.Spread ,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt, ")
SQL.ADD("O.PrecioEj  ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('MMPSI') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("Union All ")
*- ON MVto.
SQL.ADD("Select ")
