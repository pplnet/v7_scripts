SQL.ADD(" Union All")
*- MMPCL,MMPE,MMPI,MMPCOS
*- MMFIMV Definitivos
SQL.ADD("Select O.Vehiculo1,'FRN' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Precio3 ImpWH,C.Total1 MontoNeto,O.TasaImp1 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad4 ImpAmort,O.Cotizacion1,O.PrecioEj as Cantidad,C.NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" and O.TipoOp In ('MMFIMV') and O.RB5='0' ")
SQL.ADD(" and C.Fecha3 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All")
*- MMFIMV No Definitivos
SQL.ADD("Select O.Vehiculo1,'FRN' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Precio3 ImpWH,C.Total1 MontoNeto,O.TasaImp1 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad4 ImpAmort,O.Cotizacion1,O.Cantidad,C.NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" and O.TipoOp In ('MMFIMV') and O.RB5='1' ")
SQL.ADD(" and O.FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All")
*- Prestamos Locales y OffShore, Postfinanciacion, PreFinanciacion
SQL.ADD("Select O.Vehiculo1,CASE TipoOp WHEN 'MMPCL ' THEN 'Prestamos Financieros' WHEN 'MMPCOS' THEN 'Prestamos Financieros' WHEN 'MMPI  ' THEN 'Importaciones' ELSE 'Exportaciones' END Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaPago FechaSett,O.TipoTasa,O.PrecioRef,O.Spread,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,  ")
SQL.ADD("O.PrecioEj ImpAmort,O.Cotizacion1,O.PrecioEj Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".OPERACIONES  O Where ")
SQL.ADD(" O.TipoOp In ('MMPCL','MMPCOS','MMPI','MMPE') ")
SQL.ADD(" and O.FechaPago Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" Union All")
*- MMFRNP
SQL.ADD("Select O.Vehiculo1,'FRN' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaEx1 FechaSett,O.TipoTasa,O.PrecioRef,O.Spread,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,  ")
SQL.ADD("O.Cantidad ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".OPERACIONES  O Where ")
SQL.ADD(" O.TipoOp In ('MMFRNP') ")
SQL.ADD(" and O.FechaEx1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
