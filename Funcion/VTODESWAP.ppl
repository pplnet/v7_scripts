SQL.ADD("0 TotalIntereses,0 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,C.Cantidad7 ImpInt,  ")
SQL.ADD("0 ImpAmort,0 Cotizacion1,CASE O.TipoOp WHEN 'MMPCLM' THEN C.Cantidad4 ELSE C.Total8 END+C.Cantidad5 Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,C.Fecha2 FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" WHERE O.NrOperacion=C.NrOperacion ")
SQL.ADD(" and O.TipoOp In ('MMPCLM','MMPIM','MMPEM') AND CASE O.TipoOp WHEN 'MMPCLM' THEN C.Cantidad4 ELSE C.Total8 END<>0 ")
