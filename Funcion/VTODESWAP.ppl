*- PS Mv
SQL.ADD("Union All ")
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'PS' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
