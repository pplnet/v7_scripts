*- MMPLME
SQL.ADD("Select O.Vehiculo1,'Prestamos Financieros' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaPago FechaSett,O.TipoTasa,O.PrecioRef,O.Spread,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalIntereses IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,  ")
SQL.ADD("O.Cantidad ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".OPERACIONES  O Where ")
SQL.ADD(" O.TipoOp In ('MMPLME') ")
SQL.ADD(" and O.FechaPago Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" Union All")
*- MMPCLM,MMPOSM,MMPEM,MMPIM
SQL.ADD("Select O.Vehiculo1,CASE TipoOp WHEN 'MMPCLM' THEN 'Prestamos Financieros' WHEN 'MMPOSM' THEN 'Prestamos Financieros' WHEN 'MMPIM ' THEN 'Importaciones' ELSE 'Exportaciones' END Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Precio3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Total3 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Total4 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Total7 ImpWH,C.Total1 MontoNeto,O.TasaImp1 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad1 ImpAmort,O.Cotizacion1,O.PrecioEj as Cantidad,C.NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo  ")
SQL.ADD("from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha3 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" and O.TipoOp In ('MMPCLM','MMPOSM','MMPIM','MMPEM') ")
SQL.ADD(" and C.Fecha3 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All ")
*- Adiciono las comisiones 
SQL.ADD("Select O.Vehiculo1,'Comisiones' Grupo,O.NrOperacion,O.FechaOp FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,C.Especie1 as Especie,C.Importe1 VResidual,")
SQL.ADD("O.RB8,C.Fecha1 FechaVto,C.Fecha1 FechaSett,'' TipoTasa,'' PrecioRef,0 Spread,0 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0 IntNeto,0 Monto,0 TasaIva,C.Importe2 ImpIva,0 TasaWH,")
SQL.ADD("C.Importe3 ImpWH,C.Importe1 MontoNeto,0 TasaImpInt,C.Precio2 ImpInt,  ")
SQL.ADD("C.Importe1 ImpAmort,O.Cotizacion1,C.Importe1 Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,C.Fecha1 FFin,O.Plazo  ")
SQL.ADD("from "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" and O.TipoOp In ('MMPCL','MMPCOS','MMPI','MMPE','MMPCLM','MMPOSM','MMPIM','MMPEM','MMPSI','MMON','MMONM','MMSIMV','MMFIMV') ")
SQL.ADD(" and C.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1,'CEC' Grupo,O.NrOperacion,O.FechaOp FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.ContraEspecie as Especie,0 VResidual,")
SQL.ADD("O.RB8,O.FechaVto2 FechaVto,O.FechaPago FechaSett,'' TipoTasa,'' PrecioRef,0 Spread,0 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,O.PeriodoInts ImpInt,  ")
SQL.ADD("0 ImpAmort,0 Cotizacion1,CASE O.TipoOp WHEN 'MMPCL ' THEN O.ImpComCorEq2 ELSE O.TotalGanancias END +O.ImpComCor2 Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto2 FFin,O.Plazo  ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE O.TipoOp In ('MMPCL','MMPI','MMPE') AND CASE O.TipoOp WHEN 'MMPCL ' THEN O.ImpComCorEq2 ELSE O.TotalGanancias END<>0 ")
SQL.ADD(" and O.FechaVto2 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
