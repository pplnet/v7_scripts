*Validación CantidadCompletada Órdenes (Alta)
IF((RB4=0 y Eqstr(ABM,'A')),(VCAN1 + BuscarCampo('ORDENES','CantidadCompletada','NrOrden',NRORDEN)) <= (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN) + (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN)/VAR('PORDESORD'))) Y VCAN1>0,VCAN1>=0);IF(VCAN1>0,'La Cantidad excede el total de la orden','La cantidad de la orden no puede ser 0');NO
*Validación CantidadCompletada Órdenes (Modificación)
IF((RB4=0 y Eqstr(ABM,'E')),(VCAN1 - (BuscarCampo('EJECUCIONES','Cantidad','NrOperacion',NROPERACION)) + BuscarCampo('ORDENES','CantidadCompletada','NrOrden',NRORDEN)) <= (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN) + (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN)/VAR('PORDESORD')))  Y VCAN1>0,VCAN1>=0);IF(VCAN1>0,'La nueva Cantidad excede el total de la orden','La nueva cantidad de la orden no puede ser 0');NO