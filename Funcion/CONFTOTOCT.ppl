SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
SQL.ADD("Where NrOperacion = '"~Val(NV:1)~"' ")
IF Eqstr(Val(TV:1), 'DEP')
   SQL.ADD("and NrInstancia = 3 ")
Else
   SQL.ADD("and NrInstancia = 6 ")
Endif
SQL.NEW
SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
SQL.ADD("NrOperacion, ")
SQL.ADD("NrInstancia, ")
SQL.ADD("Usuario, ")
SQL.ADD("Mensaje, ")
SQL.ADD("Fecha ")
SQL.ADD(") Values (")
SQL.ADD("'"~Val(NV:1)~"', ")
IF Eqstr(Val(TV:1), 'DEP')
   SQL.ADD("3, ")
Else
   SQL.ADD("6, ")
Endif
SQL.ADD("'"~UsuarioActivo~"', ")
SQL.ADD("'Confirmacion de Voucher', ")
SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
SQL.ADD(")")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
SQL.ADD("SET CB9 = '1', Fecha3 = '"~IdxDate(FSys)~"', Cantidad4 = "~Fstr(Abs(Val(F:&k)), 0, 0)~" ")
SQL.ADD("Where NrTrans = '"~Val(NV:1)~"' ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("SET Valor = '0' ")
SQL.ADD("where NrOperacion = '"~Val(NV:1)~"' ")
IF Eqstr(Val(TV:1), 'DEP')
   SQL.ADD("and NrBit = 3 ")
Else
   SQL.ADD("and NrBit = 6 ")
Endif
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("SET Valor = '1' ")
SQL.ADD("where NrOperacion = '"~Val(NV:1)~"' ")
SQL.ADD("and NrBit = 4 ")
SQL.NEW
SQL.EXEC