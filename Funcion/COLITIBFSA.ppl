**-Campos VARIABLES-**
*VTXT21: Jerarquia inmediata superior de Especie
*VTXT22: Monedas de Emision
*VFEC1:  Fecha Maduracion de la Especie
*VTXT23: Cliente Emisor
**********************

*-TIPOOP para el BOOK para la JERARQUIA inmediata superior-* 
*-Para FCI, Plazo Fijo y Cauciones usamos la funcion CONLIMBFSA-*
**-INSTRUCCION FIDUCIANTE-**
*-OPERACION SI LIMITE SI - NO CONTROLA MAS NADA-*
*-OPERACION SI LIMITE NO - CONTROLA DESPUES RESTO CAMPOS-*
*-OPERACION NO LIMITE NO - CONTROLA DESPUES RESTO CAMPOS-*
*-OPERACION NO LIMITE SI - NO PERMITO-*

**Si existe limite para TipoOp, book y jerarquia(VTXT21) o vacio, permito asignar
*((CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'"))) Y [Vacio(SQLSet("Select Especies FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') ")) O NoVacio(SQLSet("Select Especies FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')")) ])) ; 'El Book no puede invertir en SECS para la especie ' ~ESPECIE ; NO
((CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' AND ((Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') OR Especies is NULL)"))))) ; 'El Book no puede invertir en SECS para la especie ' ~ESPECIE ; NO

**-Moneda de Emision-**
((CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO'"))) Y [Vacio(SQLSet("Select Monedas FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')")) O Incluido(VTXT22,SQLSet("Select Monedas FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') ")))]) ; 'El book no puede invertir en SECS para la moneda de emision '~VTXT22; NO

**-Plazo Remanente-**
((CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') "))) Y ([DifDias(VFEC1,FECHAOP2,'',NO) < LimPlazo] O Vacio(LimPlazo) O LimPlazo = 0))); 'Plazo Remanente '~DifDias(VFEC1,FECHAOP2,'',NO)~ ', plazo permitido para operar ' ~LimPlazo;NO

**-PORCENTAJE GLOBAL-**
(CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%')  AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') "))) Y [QUERY("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' and CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')")=0 O QUERY("Select Porcentaje FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')") >= LimPorcConsum ] ) ; 'El % invertido en '~TIPOOP~' excede el %  global permitido de la cartera ';SI;SI;FSYS;'EXCPOR';

*-LIMITADO AL EMISOR - solo aplica para ACCIONES-**
NOT EqStr(VTXT21,'ACCION') O ((CB11 = 1 Y NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='SI' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) O ((NoVacio(QUERY("Select 1 FROM "~DBO~".LIMASIGNADOSBOOK where Codigo= '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')"))) Y [Vacio(SQLSet("Select Clientes FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')")) O Incluido(VTXT23,SQLSet("Select Clientes FROM "~DBO~".LIMASIGNADOSBOOK where (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND Codigo = '"~BOOK1~"' AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%') ")))]) ; 'El book no puede invertir en SECS para el Cliente Emisor de la especie '~ESPECIE; NO
