Mercado          : 'Mercado Liq.'               ;1;1;2; ; ;NoVacio(MERCADO) O SI;'Debe indicar mercado';NO;'CV';
ContraEspecie3   : 'Mon.Com.Mer'                ;2;2;2;Not Incluido(MERCADO,'OTC');;Incluido(MERCADO,'OTC') O NoVacio(CONTRAESPECIE3);'Moneda de Comision de Mercado INVALIDA';NO;;CONTRAESPECIE;
PorComMer1       : '% Comision'                 ;2;1;2;Not Incluido(MERCADO,'OTC') Y NoVacio(MERCADO);Not Incluido(MERCADO,'OTC') Y RB13=0;Incluido(MERCADO,'OTC') O PORCOMMER1>0 O RB13=1 O VACIO(MERCADO) O SI;'Debe INGRESAR  un % de COMISION DEL MERCADO';NO;;IF(RB13=1 O VACIO(MERCADO),0)
TCComMer1        : 'T.Cambio'                   ;3;2;2;Not Incluido(MERCADO,'OTC');Not Eqstr(CONTRAESPECIE, CONTRAESPECIE3) Y RB13=0;TCCOMMER1>=0;'Tipo de Cambio del Mercado INVALIDO';NO;;IF(Eqstr(CONTRAESPECIE, CONTRAESPECIE3), 1, IF(Eqstr(CONTRAESPECIE, Var('MONELOCA')), Cotizacion(CONTRAESPECIE3,,,,FECHAOP-1,1,SI), Cotizacion(CONTRAESPECIE,,,,FECHAOP-1,1,SI)))
ImpComMer1       : 'Imp.Com.Mer'                ;3;1;2;RB13=1 Y NoVacio(MERCADO);Not Incluido(MERCADO,'OTC');;;;;IF(VACIO(MERCADO),0,IF(RB13=0,IF(Eqstr(TIPOOP, 'DFXO'),TOTALAUX1,IF(Eqstr(TIPOOP, 'DSEO'),TOTALNETOCLI1,IF(Incluido(TIPOOP,'SEABD|SEABP'),TOTALBRUTOCLI1,(TOTALNETOCLI1+TOTALINTERESES))))*(PORCOMMER1/100)*(IF(Eqstr(CONTRAESPECIE, CONTRAESPECIE3), 1, IF(Eqstr(CONTRAESPECIE, Var('MONELOCA')), 1/TCCOMMER1, TCCOMMER1))), IMPCOMMER1))
ImpComMerEq1     : 'Importe Eq.'                ;3;2;2;NO;NO;;;;;IMPCOMMER1*IF(CB6=1,TCCOMMER1,IF(TCCOMMER1<>0,1/TCCOMMER1,0));

RB13             : ' Tipo|%|Fijo'               ;1;2;2;;;;;;;0; 

Corredor         : 'Corredor'                   ;5;1;2;;;
ContraEspecie2   : 'Mon.Com.Corr'               ;6;2;2;;;VACIO(CORREDOR) O [NoVacio(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;;CONTRAESPECIE
PorComCor1       : IF(RB12=1,'V x Unidad','% Comision') ;6;1;2;;RB12<>2;;;;;IF(RB12=2 O VACIO(CORREDOR),0,IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR)));
TCComCor1        : 'T.Cambio'                   ;7;2;2;;Not Eqstr(CONTRAESPECIE, CONTRAESPECIE2)Y RB12=0;VACIO(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;IF(Eqstr(CONTRAESPECIE, CONTRAESPECIE2), 1, IF(Eqstr(CONTRAESPECIE, Var('MONELOCA')), Cotizacion(CONTRAESPECIE2,,,,FECHAOP-1,1,SI), Cotizacion(CONTRAESPECIE,,,,FECHAOP-1,1,SI)))
ImpComCor1       : 'Imp.Com.Corr'               ;7;1;2;RB12=2;;;;;;IF(RB12=0,IF(Eqstr(TIPOOP, 'DFXO'),TOTALAUX1,IF(Eqstr(TIPOOP, 'DSEO'),TOTALNETOCLI1,IF(Incluido(TIPOOP,'SEABD|SEABP'),TOTALBRUTOCLI1,(TOTALNETOCLI1+TOTALINTERESES))))*(PORCOMCOR1/100)*(IF(Eqstr(CONTRAESPECIE, CONTRAESPECIE2), 1, IF(Eqstr(CONTRAESPECIE, Var('MONELOCA')), 1/TCCOMCOR1, TCCOMCOR1))), IMPCOMCOR1)
ImpComCorEq1     : 'Importe Eq.'                ;7;2;2;NO;NO;;;;;IMPCOMCOR1*IF(CB6=1,TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))

RB12             : ' Tipo|%|Unidad|Fijo'        ;5;2;2;;;;;;;0


ImpGastos2       : '%IVA Com.Mer'               ;1;3;2;;;Incluido(Fstr(IMPGASTOS2,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Mercado es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');;;;;;'#####.#####'
TotalIVA         : 'IVA Com.Mer'                ;2;3;2;NO;;[TOTALIVA<= ROUND((ImpComMer1*ImpGastos2/100)*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND((ImpComMer1*ImpGastos2/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Com.Mer Fuera de Rango: '~Fstr(ROUND((ImpComMer1*ImpGastos2/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((ImpComMer1*ImpGastos2/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(ImpComMer1*ImpGastos2)/100;;;;;'###,###,###,###,###.##'
TasaIVA1         : '% IVA Com.Corr'             ;5;3;2;;;Incluido(Fstr(TasaIVA1,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Corredor es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');;;;;;'#####.#####'
TotalIVA2        : 'IVA Com Corr'               ;6;3;2;NO;;[TOTALIVA2<= ROUND((ImpComCor1*TasaIVA1/100)*(1+Var('PORVAR')/100),2) y TOTALIVA2 >= ROUND((ImpComCor1*TasaIVA1/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Com Corr Fuera de Rango: '~Fstr(ROUND((ImpComCor1*TasaIVA1/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((ImpComCor1*TasaIVA1/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(ImpComCor1*TasaIVA1)/100;;;;;'###,###,###,###,###.##'