*** DIFUTU
*** Toma los Futuros. Modifica el Precio, el Notional y la Cantidad

Message('Procesando Futuros ...')

SQL.ADD("SELECT O.* ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("Where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and O.TipoOp In ('TIFC','TIFV') ")
SQL.ADD("and O.FechaOp <='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("order by O.TipoOp, O.Especie ")

Recorrer SQL

   Message('Futuros :'~FBN['TipoOp']~' '~FBN['NrOperacion'])   

   act(a:fac,fbn['Cliente1'])
   act(b:fac,fbn['TipoOp'])
   act(c:fac,fbn['Vehiculo1'] )
   act(k:fac,fbn['NrOperacion'])
   acn(d:fac,fbn['Cantidad'] )
 
   * e: Monto en Efectivo f: Monto en Acciones g: Precio Nuevo 
   * g: Precio h:TotalBrutoCli1

   * Calculo el Precio del Dividendo en Efectivo si esta protegida la opcion 
   If Dialogo.Check1=1
      acn(e:fac,FBN['Cantidad']*(Dialogo.Precio1/100))    
      acn(g:fac,FBN['Precio1']-(Dialogo.Precio1/100))    
  
      acn(h:fac,FBN['Cantidad']*VAL(g:fac))    
   EndIf
   If Dialogo.Check2=1
      acn(g:fac,FBN['Precio1'])    
      acn(h:fac,FBN['Cantidad']*VAL(g:fac))    

      * Calculo el Dividendo en Acciones.
      acn(f:fac,FBN['Cantidad']*(Dialogo.Precio1/100))

      * Calculo el Nuevo Precio
      acn(g:fac,VAL(h:fac)/(FBN['Cantidad']+VAL(f:fac)))       
   EndIf

   * Calculo el Importe a Liquidar Futuro
   acn(i:fac,VAL(h:fac)+FBN['TotalIntereses'])

   Message('Actualiza Operaciones a Termino')

   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set Cantidad       = "~Fstr(Val(d:fac)+Val(f:fac),0,2)~", ")
   SQL.ADD("    Precio1        = "~Fstr(Val(g:fac),0,7)~", ")
   SQL.ADD("    TotalBrutoCli1 = "~Fstr(Val(h:fac),0,2)~", ")
   SQL.ADD("    TotalNetoCli1  = "~Fstr(Val(i:fac),0,2)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(k:fac)~"' ")
   SQL.NEW
   SQL.EXEC  

   SQL.ActualizarMovimientos2(Val(k:fac),SI,NO,NO,SI)
   SQL.EXEC

