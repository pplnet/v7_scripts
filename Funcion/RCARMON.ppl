ACT(ca:0, 'CA')
ACT(ci:0, 'CI CanFin')
ACT(cl:0, 'CL Coti')
ACT(cm:0, 'CM V.Mer')
ACT(cn:0, 'CM V.Pos')
ACT(co:0, 'CO PL NR')
ACT(cq:0, 'CQ R.TRADE')
ACT(cs:0, 'CS R.REALIZ')
************************************
* Posiciones Spot de Monedas
************************************
SQL.ADD("Select P.Especie, P.Cupon, P.Vehiculo, P.Book, V.Descripcion, ")
SQL.ADD("       E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD("       E.Alias2, ")
SQL.ADD("       '0' Tipo1, ")
SQL.ADD("       E.PaisOrigen, ")
SQL.ADD("       '0' Tipo2, ")
SQL.ADD("       '0' Tipo3, ")
SQL.ADD("       P.Fecha, P.NrSaldo, P.FechaEj, ")
SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
SQL.ADD("       P.Cantidad1, P.Precio1, ")
SQL.ADD("       P.Cantidad2, P.Precio2, ")
SQL.ADD("       P.CantidadFin, P.PrecioFin ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, "~DBO~".BOOKS B ")
SQL.ADD(" where P.Especie      =  E.Codigo ")
SQL.ADD("   and P.Vehiculo     =  V.Codigo ")
SQL.ADD("   and P.Book         =  B.Codigo ")
SQL.ADD("   and NrSaldo        =  "~Val(q:3)~" ")
SQL.ADD("   and P.TipoNegocio  =  'FXS' ")
SQL.ADD("   and P.Especie      Not in ('USD','ARP') ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie    = '"~Dialogo.Especie1~"' ")
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and P.Book      in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
SQL.ADD("                        from  "~DBO~".POSICIONES P1 ")
SQL.ADD("                       where Especie             =  P.Especie ")
SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("                     ) ")

SQL.ADD(" Union All ")

************************************
* Posiciones Futuras de Monedas
************************************
SQL.ADD("Select P.Especie, P.Cupon, P.Vehiculo, P.Book, V.Descripcion, ")
SQL.ADD("       E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD("       E.Alias2, ")
SQL.ADD("       '0' Tipo1, ")
SQL.ADD("       E.PaisOrigen, ")
SQL.ADD("       '0' Tipo2, ")
SQL.ADD("       '1' Tipo3, ")
SQL.ADD("       P.Fecha, P.NrSaldo, P.FechaEj, ")
SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
SQL.ADD("       P.Cantidad1, P.Precio1, ")
SQL.ADD("       P.Cantidad2, P.Precio2, ")
SQL.ADD("       P.CantidadFin, P.PrecioFin ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, "~DBO~".BOOKS B  ")
SQL.ADD(" where P.Especie      =  E.Codigo ")
SQL.ADD("   and P.Vehiculo     =  V.Codigo ")
SQL.ADD("   and P.Book         =  B.Codigo ")
SQL.ADD("   and P.NrSaldo      =  "~Val(q:4)~" ")
SQL.ADD("   and P.FechaEj      >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and P.TipoNegocio  =  'FXF' ")
SQL.ADD("   and P.Especie      = 'USD' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie    = '"~Dialogo.Especie1~"' ")
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and P.Book      in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
SQL.ADD("                        from  "~DBO~".POSICIONES P1 ")
SQL.ADD("                       where P1.Especie             =  P.Especie ")
SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
SQL.ADD("                         and P1.FechaEj          =  P.FechaEj ")
SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("                     ) ")

SQL.ADD(" order by P.Especie, Tipo1,Tipo2,Tipo3,P.Cupon, P.Vehiculo, P.NrSaldo ")
Recorrer SQL
  if Val(z:3)=0
    ACT(a:FAC, 'MONEDAS')
    ACN(r:FAC, 2)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 1)
    ACN(y:2, FAC)
    ACN(s:1, FAC)
    IFA
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, fbn('Tipo2'))
  endif
  if Not EqStr(fbn('Especie'),Val(v:4))
    ACT(a:FAC, Pad('',5)~fbn('Especie'))
    ACN(r:FAC, 2)
    ACN(s:FAC, 1)
    ACN(t:FAC, 1)
    ACN(v:FAC, 2)
    ACN(l:FAC, Val(s:1))
    ACN(s:2, FAC)
    IFA
    ACT(v:4, fbn('Especie'))
    ACT(v:5, '')
  endif
  if EqStr(fbn('Tipo3'),Val(v:5))
    DFA
  else
    if EqStr(fbn('Tipo3'),'0')
      ACT(a:FAC, Pad('',10)~'SPOT')
      ACT(i:FAC, 'FXCS-FXVS-FXAS')
      ACN(s:FAC, 1)
    else
      if EqStr(fbn('Tipo3'),'1')
        ACT(a:FAC, Pad('',10)~'FUTURO')
        ACT(i:FAC, 'FXCT-FXVT-FXAT')
      else
        ACT(a:FAC, Pad('',10)~'YYYY')
      endif
      ACN(s:FAC, 0)
    endif
    ACN(r:FAC, 2)
    ACN(t:FAC, 2)
    if EqStr(fbn('Tipo3'),'0')
* Para no mostrar linea SPOT
      ACN(t:FAC, 3)
    endif
    ACN(v:FAC, 3)
    ACN(z:FAC, 1)
    ACN(l:FAC, Val(s:1))
    ACN(m:FAC, Val(s:2))
    ACT(v:5, fbn('Tipo3'))
  endif
  SCN(z:3, 1)

  * Solo Para SPOT
  if EqStr(fbn('Tipo3'),'0')
    ** Armado de lista de especies para TIR
    ACT(p:FAC, fbn('Especie'))
    if Vacio(Val(p:Val(l:FAC)))
      ACT(p:Val(l:FAC), fbn('Especie'))
    else
      if Not Incluido(fbn('Especie'),Val(p:Val(l:FAC)))
        ACT(p:Val(l:FAC), Val(p:Val(l:FAC))~'|'~fbn('Especie'))
      endif
    endif
    if Vacio(Val(p:Val(m:FAC)))
      ACT(p:Val(m:FAC), fbn('Especie'))
    else
      if Not Incluido(fbn('Especie'),Val(p:Val(m:FAC)))
        ACT(p:Val(m:FAC), Val(p:Val(m:FAC))~'|'~fbn('Especie'))
      endif
    endif
    ** Armado de lista de saldos para TIR
    ACN(q:FAC, fbn('NrSaldo'))
    ACN(q:Val(l:FAC), fbn('NrSaldo'))
    ACN(q:Val(m:FAC), fbn('NrSaldo'))
  endif
  ACT(ca:Val(z:3), fbn('Especie'))
  ACN(cb:Val(z:3), fbn('Cupon'))
  ACT(cc:Val(z:3), fbn('Cotiza'))

  ACT(ct:Val(z:3), fbn('Alias2'))
  ACT(cu:Val(z:3), fbn('Tipo1'))
  ACT(cv:Val(z:3), fbn('PaisOrigen'))
  ACT(cw:Val(z:3), fbn('Tipo2'))
  ACD(cx:Val(z:3), fbn('Fecha'))
  ACD(cy:Val(z:3), fbn('FechaEj'))

  ACT(cd:Val(z:3), fbn('Vehiculo'))
  ACT(ce:Val(z:3), fbn('Book'))
  ACN(cf:Val(z:3), fbn('NrSaldo'))
  ACN(cg:Val(z:3), fbn('CantidadIni'))
  ACN(ch:Val(z:3), fbn('PrecioIni'))
  ACN(ci:Val(z:3), fbn('CantidadFin'))
  ACN(cj:Val(z:3), fbn('PrecioFin'))
  ACN(ck:Val(z:3), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI))
  ACN(cl:Val(z:3), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,Val(r:2)))
  * Net Market Value
  ACN(cm:Val(z:3), fbn('CantidadFin')*Val(cl:Val(z:3)))
  ACN(cn:Val(z:3), fbn('CantidadFin')*Val(cj:Val(z:3)))
  * P&L NO Realizado
  ACN(co:Val(z:3), Val(cm:Val(z:3))-Val(cn:Val(z:3)))
  SQL.ADD("Select R1.TipoResultado,R1.YTD from "~DBO~".RESULTADOS R1 ")
  SQL.ADD(" where R1.TipoResultado   in ('TRADE','REALIZ') ")
  SQL.ADD("   and R1.Especie         =  '"~fbn('Especie')~"' ")
  SQL.ADD("   and R1.Vehiculo        =  '"~fbn('Vehiculo')~"' ")
  SQL.ADD("   and IsNull(R1.Book,'') =  '"~fbn('Book')~"' ")
  SQL.ADD("   and R1.NrSaldo         =  "~fbn('NrSaldo')~" ")
  if EqStr(fbn('Tipo3'),'1')
    SQL.ADD("   and R1.FechaEj      =  "~IdxDate2(fbn('FechaEj'))~" ")
  endif
  SQL.ADD("   and R1.Fecha           >= "~IdxDate2(Val(r:7))~" ")
  SQL.ADD("   and R1.Fecha           =  (select Max(Fecha) ")
  SQL.ADD("                                from "~DBO~".RESULTADOS R2 ")
  SQL.ADD("                               where R2.Especie         =  R1.Especie ")
  SQL.ADD("                                 and R2.Vehiculo        =  R1.Vehiculo ")
  SQL.ADD("                                 and IsNull(R2.Book,'') =  IsNull(R1.Book,'') ")
  SQL.ADD("                                 and R2.NrSaldo         =  R1.NrSaldo ")
  if EqStr(fbn('Tipo3'),'1')
    SQL.ADD("                               and R2.FechaEj         =  R1.FechaEj ")
  endif
  SQL.ADD("                                 and R2.TipoResultado   =  R1.TipoResultado ")
  SQL.ADD("                                 and R2.Fecha           <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
  recorrer SQL
    DFA
    if EqStr(fbn('TipoResultado'),'TRADE')
      SCN(cp:Val(z:3), 1)
      SCN(cq:Val(z:3), fbn('YTD'))
    else
      SCN(cr:Val(z:3), 1)
      SCN(cs:Val(z:3), fbn('YTD'))
    endif
  proximo

  if EqStr(fbn('Tipo3'),'0')
    *******************************************
    * Posiciones SPOT (Monedas distintas a USD)
    *******************************************
    * Net Market Value
    SCN(b:FAC, Val(cm:Val(z:3)))
    * Res. Realizado
    SCN(d:FAC, Val(cq:Val(z:3))+Val(cs:Val(z:3)))
    * Res. NO Realizado
    SCN(e:FAC, Val(co:Val(z:3)))
    * Totales
    SCN(t:1,   Val(cm:Val(z:3)))
    SCN(t:2,   Val(cq:Val(z:3))+Val(cs:Val(z:3)))
    SCN(t:3,   Val(co:Val(z:3)))

    * Aculuma Nivel 1
    SCN(b:Val(l:FAC), Val(cm:Val(z:3)))
    SCN(d:Val(l:FAC), Val(cq:Val(z:3))+Val(cs:Val(z:3)))
    SCN(e:Val(l:FAC), Val(co:Val(z:3)))
    * Aculuma Nivel 2
    SCN(b:Val(m:FAC), Val(cm:Val(z:3)))
    SCN(d:Val(m:FAC), Val(cq:Val(z:3))+Val(cs:Val(z:3)))
    SCN(e:Val(m:FAC), Val(co:Val(z:3)))
  else
    *****************************************
    * Posiciones Futuras (Moneda igual a USD)
    *****************************************
    if Vacio(Val(p:FAC))
      LinkearHoja('RFXF01',1,Vehiculo2=Dialogo.Vehiculo2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1='USD',Radio3=1)
      ACN(q:FAC, LinkH(1,aw:1))
      if Dialogo.Radio1=0
        * Expresado en Pesos
        * Net Market Value
        ACN(b:FAC, LinkH(1,d:Val(q:FAC)+1))
        * Res. Realizado
        ACN(d:FAC, LinkH(1,d:Val(q:FAC)+3))
        * Res. NO Realizado
        ACN(e:FAC, LinkH(1,d:Val(q:FAC)+2))
      else
        * Expresado en USD
        * Net Market Value
        ACN(b:FAC, LinkH(1,d:Val(q:FAC)))
        * Res. Realizado
        ACN(d:FAC, LinkH(1,d:Val(q:FAC)+6))
        * Res. NO Realizado
        ACN(e:FAC, LinkH(1,d:Val(q:FAC)+5))
      endif
      CerrarHoja('RFXF01',1,Vehiculo2=Dialogo.Vehiculo2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1='USD',Radio3=1)
      ACT(p:FAC, 'LISTO')
      * Totales
      SCN(t:1,   Val(b:FAC))
      SCN(t:2,   Val(d:FAC))
      SCN(t:3,   Val(e:FAC))
      * Aculuma Nivel 1
      SCN(b:Val(l:FAC), Val(b:FAC))
      SCN(d:Val(l:FAC), Val(d:FAC))
      SCN(e:Val(l:FAC), Val(e:FAC))
      * Aculuma Nivel 2
      SCN(b:Val(m:FAC), Val(b:FAC))
      SCN(d:Val(m:FAC), Val(d:FAC))
      SCN(e:Val(m:FAC), Val(e:FAC))
    endif
  endif

  SCN(j:FAC, 1)
  SCN(k:FAC, fbn('CantidadFin'))
proximo

if Val(z:3)>0
  SetFont(ca:1..cy:Val(z:3),1)
  FormatoCeldas(cg:1..cs:Val(z:3),Exe('F2'))
  FormatoCeldas(ch:1..ch:Val(z:3),Exe('F8'))
  FormatoCeldas(cj:1..cl:Val(z:3),Exe('F8'))
endif
