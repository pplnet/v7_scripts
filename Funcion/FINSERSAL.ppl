* Insertar saldos de Com.Ext. y sucursales
* Llamada por el evento CARSAL

***** Variables *******************************************************************
* a1 : Tipo de operacion
* a2 : nro. de saldo de posicion (segun tipo de operacion)
* a3 : moneda para expresar la posicion (segun tipo de operacion)
* a5 : monto de la especie expresado en USD
* a6 : Cantidad Comprada/Vendida
* a7 : PP compras/ventas
* a8 : Total Bruto Compras/Ventas
* v1 : fecha de liquidacion de la especie
* w1 : Cantidad de operaciones de un tipo,especie,valor y puesto para una fecha
* z1 : Nro. de Operacion
************************************************************************************

* busco si existe la operacion 
ACN(w1,SQL("Select Count(*) From "~DBO~".OPERACIONES Where TipoOp='"~Val(a1)~"' and FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ValorRB1='"~Fstr(Dialogo.Radio2,1,0)~"' and Puesto='"~Fstr(Dialogo.Check1,1,0)~"' and Especie = '"~Dialogo.Especie1~"' "))

if Val(w1)=1
  * guardo el nro. de operacion
  ACT(z1,SQL("Select NrOperacion From "~DBO~".OPERACIONES Where TipoOp='"~Val(a1)~"' and FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ValorRB1='"~Fstr(Dialogo.Radio2,1,0)~"' and Puesto='"~Fstr(Dialogo.Check1,1,0)~"' and Especie = '"~Dialogo.Especie1~"' "))

  * Existe la operacion - modifico
  SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET Cantidad = "~Fstr(ABS(Val(a6)),1,2)~", ")
  SQL.ADD("  Precio1 = "~FStr(val(a7),1,8)~", TotalBrutoCli1 = "~FStr(val(a8),1,2)~" ")
  SQL.ADD(" Where TipoOp='"~Val(a1)~"' and FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ValorRB1='"~Fstr(Dialogo.Radio2,1,0)~"' and Puesto='"~Fstr(Dialogo.Check1,1,0)~"' and Especie = '"~Dialogo.Especie1~"' ")
  SQL.NEW
  *SQL.EXEC
  * Borrar la posicion vieja e insertar la nueva

  SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE ")
  SQL.ADD(" Where NrOperacion = '"~val(z1)~"' ")
  SQL.NEW
  *SQL.EXEC

  * Actualizar tabla de movimientos de posicion
  Message('----- Actualizar Posici¦n Operaci¦n '~Val(z1))
  SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ")
  SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
  SQL.ADD(" FechaMov, Cliente, Vehiculo, NrSaldo, Precio, TipoNegocio )  ")
  SQL.ADD(" Values ( '"~Val(a3)~"', "~Fstr(val(a6),1,2)~", ")
  SQL.ADD(" '"~Val(z1)~"', '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD(" 'RIO' , '"~Dialogo.Vehiculo1~"', "~Fstr(val(a2),1,0)~" , "~FStr(Val(a5),1,8)~" , 'FX' )")
  SQL.NEW

  SQL.EXEC

else
  * No existe la operacion - inserto -
  Message('----- Generando Operacion '~Val(a1))
  SQL.ADD(" Insert Into "~DBO~".OPERACIONES ")
  SQL.ADD(" ( Especie, Cantidad, Precio1, TotalBrutoCli1, ContraEspecie, ")
  SQL.ADD(" FechaOp, FechaVto, FechaPago, Vehiculo1, ")
  SQL.ADD(" ValorRB1, Puesto, ")
  SQL.ADD(" NrOperacion, TipoOp ) ")
  SQL.ADD(" Values ( '"~Dialogo.Especie1~"', "~Fstr(ABS(val(a6)),1,2)~", ")
  SQL.ADD(" "~FStr(val(a7),1,8)~", "~FStr(val(a8),1,2)~", ")
  SQL.ADD(" '"~Dialogo.Especie2~"', '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD(" '"~IdxDate(Val(v1))~"', '"~IdxDate(val(v2))~"', ")
  SQL.ADD(" '"~Dialogo.Vehiculo1~"', ")
  SQL.ADD(" '"~FStr(Dialogo.Radio2,1,0)~"', '"~FStr(Dialogo.Check1,1,0)~"', ")  
  ACT(z1,GetNumerador(4)) 
  SQL.ADD(" '"~Val(z1)~"','"~Val(a1)~"' ) ")
  SQL.NEW
  *SQL.EXEC

  * Agrega las instancias en OPERACIONESBITS
  EjecutarEvento('OPSBIT',NrOperacion1=Val(z1))
  * pone a la operacion en instancia Terminal
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
  SQL.ADD(" Where (NrOperacion = '"~Val(z1)~"') and (NrBit = 70)  ")
  SQL.NEW
  *SQL.EXEC

  * Actualizar tabla de movimientos de posicion
  Message('----- Actualizar Posici¦n Operaci¦n '~Val(z1))
  SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ")
  SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
  SQL.ADD(" FechaMov, Cliente, Vehiculo, NrSaldo, Precio, TipoNegocio )  ")
  SQL.ADD(" Values ( '"~Val(a3)~"', "~Fstr(val(a6),1,2)~", ")
  SQL.ADD(" '"~Val(z1)~"', '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD(" 'RIO' , '"~Dialogo.Vehiculo1~"', "~Fstr(Val(a2),1,0)~" , "~FStr(Val(a5),1,8)~" , 'FX' )")
  SQL.NEW

  SQL.EXEC
endif

* Ejecutar evento para actualizar los limites de posicion
Message('----- Actualizar Limites de Posici¦n Operaci¦n '~Val(z1))
EjecutarEvento('LIPOSA',NrOperacion1=Val(z1))


