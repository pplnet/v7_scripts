*- j: VN k: Amor
ACN(m:fac,FBN['Precio4'])
acn(s:fac,IIF(FBN['RB6']=0,((val(j:fac)*FBN['Total5']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))*(FBN['OPrecio3']/100),0))
acn(r:fac,FBN['Cantidad5']+val(s:fac))
acn(u:fac,IIF(FBN['RB6']=1,val(j:fac)*FBN['OPrecio2']/100*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1),0))
acn(t:fac,val(u:fac)+FBN['Plazo3'])
acn(q:fac,(FBN['ImpGastos2']/100)*(val(r:fac)+(val(j:fac))*(val(av:fac)/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
acn(p:fac,IIF(FBN['RB6']=0,0,IIF(FBN['RB6']=2,val(j:fac)*(val(aw:fac)/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)*(FBN['TotalAux1']/100),val(j:fac)*Val(aw:fac)/100*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)*(FBN['TotalAux1']/100))))
acn(o:fac,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((FBN['Precio4']+val(l:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
acn(v:fac,IIF(FBN['RB6']=0,val(o:fac),IIf(FBN['RB6']=1,val(t:fac),0))*(FBN['TasaImp1']/100))
acn(y:fac,IIF(FBN['RB6']=0,val(r:fac)*(FBN['DeltaTasa']/100),0))
acn(x:fac,val(t:fac)*(FBN['IntDevengados1']/100))
acn(ab:fac,val(y:fac)+val(v:fac)+val(o:fac)+val(r:fac)+val(t:fac)+val(p:fac))
acn(z:fac,(val(k:fac)+val(o:fac)))
acn(aa:fac,(val(k:fac)+val(ab:fac)))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio3')
