ENDIF
If Dialogo.Radio5=0
   SQL.ADD(" AND O.InteresesCorr > 0 ")
EndIf
SQL.ADD(" AND P.TipoOp = 'MMPLME' ")
SQL.ADD(" AND P.Especie = '"~Var('MONEEXTR')~"' ")
*-SQL.ADD(" ,")