*- vi1: Vigentes=1 , Todos los Settements=0
*- vf1: Los que no estan vigentes pero vencieron en ese mes
*- ON Unico Vto
SQL.ADD("SELECT ")
If NoVacio(val(aa1))
   SQL.ADD("    "~val(aa1)~", ")
EndIf    
****************************************----
If Dialogo.Radio3 = 1  
   SQL.ADD(" O.Vehiculo1,'Obligaciones Negociables' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3, ")
Else
    SQL.ADD(" 'Consolidado' Vehiculo1,'Obligaciones Negociables' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3, ")
EndIf
****************************************-----   

SQL.ADD("       O.Especie,O.PrecioEj VResidual,O.RB8,O.FechaVto,O.FechaVto2 FechaSett,O.TipoTasa,O.PrecioRef,")
SQL.ADD("       O.Spread ,O.Precio1 Tasa,O.Precio4 TTN,O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto, ")
SQL.ADD("       O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,")
SQL.ADD("       O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,O.PrecioEj ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota, ")
SQL.ADD("       O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys,'' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD("       or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD("       and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
SQL.ADD(" ) ")
SQL.ADD("       and O.TipoOp In ('MMON') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
*- PS Unico Vto
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT ")
If NoVacio(val(aa1))
   SQL.ADD("    "~val(aa1)~", ")
EndIf

*******************-----------------------
If Dialogo.Radio3 = 1
SQL.ADD("       O.Vehiculo1,'Prestamos Sindicados' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,")
Else
SQL.ADD(" 'Consolidado' Vehiculo1,'Prestamos Sindicados' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,")
EndIf
*******************-----------------------

SQL.ADD("       O.Especie,O.Cantidad VResidual,O.RB8,O.FechaVto,O.FechaVto FechaSett,O.TipoTasa,O.PrecioRef,")
SQL.ADD("       O.Spread ,O.Precio1 Tasa,O.Precio4 TTN,O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto, ")
SQL.ADD("       O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,")
SQL.ADD("       O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,O.PrecioEj  ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota, ")
SQL.ADD("       O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys,'' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD("       or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD("       and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
SQL.ADD(" ) ")
SQL.ADD("       and O.TipoOp In ('MMPSI','MMPSC') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("       and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("UNION ALL ")
*- ON MVto.
SQL.ADD("SELECT ")
If NoVacio(val(aa1))
   SQL.ADD("    "~val(aa1)~", ")
EndIf

*******************-----------------------
If Dialogo.Radio3 = 1
SQL.ADD("       O.Vehiculo1,'Obligaciones Negociables' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,")
Else
SQL.ADD("'Consolidado' Vehiculo1,'Obligaciones Negociables' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,")
EndIf
*******************-----------------------

SQL.ADD("       O.Especie,C.Cantidad2 VResidual,O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,")
SQL.ADD("       C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN,C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto, ")
SQL.ADD("       C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,C.Precio3 ImpWH,")
SQL.ADD("       C.Total1 MontoNeto,C.Tasa3 TasaImpInt,C.Total9 ImpInt,C.Cantidad4 ImpAmort,O.Cotizacion1,O.Cantidad,  ")
SQL.ADD("       NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys,'' Swap, O.Observac3 ,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD("       or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD("       and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
SQL.ADD(" ) ")
SQL.ADD("       and O.TipoOp In ('MMONM') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("       and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If val(vi1)=1
   *- Solamente el periodo vigente
   SQL.ADD("       and ((C.Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and C.Fecha2> '"~IdxDate(Dialogo.Fecha1)~"') ")
   If val(vf1)=1     
      *- Que Vencen en ese mes y anio aunque no esten vigentes
      SQL.ADD("       or (Year(C.Fecha2)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
      SQL.ADD("       and Month(C.Fecha2)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
   EndIf
   SQL.ADD(" ) ")
EndIf
*- PS Mv
SQL.ADD("Union All ")
SQL.ADD("Select ")
If NoVacio(val(aa1))
   SQL.ADD(" "~val(aa1)~", ")
EndIf

*******************-----------------------
If Dialogo.Radio3 = 1
SQL.ADD("O.Vehiculo1,'Prestamos Sindicados' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
Else
SQL.ADD("'Consolidado' Vehiculo1,'Prestamos Sindicados' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente3 Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
EndIf
*******************-----------------------

SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Precio3 ImpWH,C.Total1 MontoNeto,O.TasaImp1 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad4 ImpAmort,O.Cotizacion1,O.Cantidad,NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")
If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
SQL.ADD(" ) ")
SQL.ADD("  and O.TipoOp In ('MMSIMV','MMSCMV') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If val(vi1)=1
   *- Solamente el periodo vigente
   SQL.ADD("  and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
   If val(vf1)=1     
      *- Que Vencen en ese mes y anio aunque no esten vigentes
      SQL.ADD(" or (Year(C.Fecha2)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
      SQL.ADD(" and Month(C.Fecha2)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
   EndIf
   SQL.ADD(" ) ")
EndIf
