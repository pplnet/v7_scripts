***---Posicion Inicial a Fecha
SQL.ADD(" SELECT E.Codigo, P1.Cupon, SUM(P1.CantidadFin) Cantidad, 'POSINI' TipoOp, 0 FechaVto, ")
SQL.ADD(" E.Cotiza, E.CodNumCajaValores, E.CodMAEContado, E.Tasa2, E.InteresesC ")
SQL.ADD("FROM "~DBO~".POSICIONES P1, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE P1.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      P1.Especie = E.Codigo AND ")
SQL.ADD("      P1.Fecha = (SELECT MAX(P2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                  WHERE P2.Cliente = P1.Cliente AND ")
SQL.ADD("                        P2.Especie = P1.Especie AND ")
SQL.ADD("                        P2.NrSaldo = P1.NrSaldo AND ")
SQL.ADD("                        P2.TipoNegocio = P1.TipoNegocio AND ")
SQL.ADD("                        P2.Sector = P1.Sector AND ")
SQL.ADD("                        P2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
IF Val(IV:1) = 0
    SQL.ADD(" AND P1.NrSaldo IN ('107','110') ")
    SQL.ADD(" AND E.Jerarquia Like '"~Val(JQ:1)~"%' ")
ELSE
    ***---Investment
    SQL.ADD(" AND P1.NrSaldo IN ('108','109') ")
ENDIF
SQL.ADD(" GROUP BY E.Codigo, P1.Cupon, E.Cotiza, E.CodNumCajaValores, E.CodMAEContado, E.Tasa2, ")
SQL.ADD(" E.InteresesC ")

***---Prestamos y Depositos Vigentes que tienen que netear la posicion inicial
SQL.ADD(" UNION ")
SQL.ADD(" Select E.Codigo, O.Cupon1 Cupon, O.Cantidad, O.TipoOp, O.FechaVto, E.Cotiza, ")
SQL.ADD(" E.CodNumCajaValores, E.CodMAEContado, E.Tasa2, E.InteresesC ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = O.Especie ")
SQL.ADD(" AND O.TipoOp IN ('TIDE', 'TIPO','TICT','TICO') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND E.Status='HAB' ")
   SQL.ADD(" AND E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
ENDIF
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF Val(IV:1) = 0
    SQL.ADD(" AND E.Jerarquia Like '"~Val(JQ:1)~"%' ")
    SQL.ADD(" AND O.Cartera Not IN ('1','2') ")
ELSE
    ***---Investment
    SQL.ADD(" AND O.Cartera IN ('1','2') ")
ENDIF

***---Compras y Ventas Bursatiles C.P. Spot y Futuro Vigentes que tienen que sumar/restar
***---la posicion inicial
SQL.ADD(" UNION ")
SQL.ADD(" Select E.Codigo, O.Cupon1 Cupon, O.Cantidad, O.TipoOp, O.FechaVto, E.Cotiza, ")
SQL.ADD(" E.CodNumCajaValores, E.CodMAEContado, E.Tasa2, E.InteresesC ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = O.Especie ")
SQL.ADD(" AND O.TipoOp IN ('CTP','CTC','VTC','VTP','CFTC','VFTC') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Cliente1 = O.Vehiculo1 ")
SQL.ADD(" AND O.PaseCB = '0' ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND E.Status='HAB' ")
   SQL.ADD(" AND E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
ENDIF
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF Val(IV:1) = 0
    SQL.ADD(" AND E.Jerarquia Like '"~Val(JQ:1)~"%' ")
    SQL.ADD(" AND O.Cartera Not IN ('1','2') ")
ELSE
    ***---Investment
    SQL.ADD(" AND O.Cartera IN ('1','2') ")
ENDIF

***---Compras y Ventas Extrabursatiles Spot y Futuros Vigentes que tienen que sumar/restar
***---la posicion inicial
SQL.ADD(" UNION ")
SQL.ADD(" Select E.Codigo, O.Cupon1 Cupon, O.Cantidad, O.TipoOp, O.FechaVto, E.Cotiza, ")
SQL.ADD(" E.CodNumCajaValores, E.CodMAEContado, E.Tasa2, E.InteresesC ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = O.Especie ")
SQL.ADD(" AND O.TipoOp IN ('TIC','TIV','TIFC','TIFV') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND E.Status='HAB' ")
   SQL.ADD(" AND E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
ENDIF
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF Val(IV:1) = 0
    SQL.ADD(" AND E.Jerarquia Like '"~Val(JQ:1)~"%' ")
    SQL.ADD(" AND O.Cartera Not IN ('1','2') ")
ELSE
    ***---Investment
    SQL.ADD(" AND O.Cartera IN ('1','2') ")
ENDIF
SQL.ADD(" Order By 1,2 ")
