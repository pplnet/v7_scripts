CONDICIONES

Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~VTXT8~"' ") <> 1;'Ya Ha Sido Liquidado el MTM del Dia';NO
Vacio(VTXT8);'Recuerde Procesar el MTM del Dia';SI

EV o [EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB')];'La Moneda No esta Habilitada';NO
EV o [Not EqStr(ESPECIE,'ARP')];'Debe ser Moneda Extranjera';NO

EV o [EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB')];'El Cliente No esta Habilitado';NO
EV o [Not EqStr(CLIENTE1,VEHICULO1)];'El Cliente no puede ser el Vehiculo';SI

EV o [Not FECHAOP<FSYS];'Es una Operacion FechaValor';NO;SI;FSYS;'FECHAVALOR'
EV o [FechaOp > Fecha(Var('FECHAVALOR'))];'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO

Eqstr(BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2), 'M');'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO

EV o [Incluido(Vehiculo1,'BKB|SBK')];'El Vehiculo no esta Habilitado para la Operacion';NO
EV o [Incluido(Vehiculo1, UsrVehiculos(Operador)) o Vacio(UsrVehiculos(Operador))];'El Operador no esta habilitado para operar con el Vehiculo';NO

EV o Cantidad >= ValidacionMonto(OficialCuenta,Especie,TipoOp,0);'La Cantidad debe ser Mayor o Igual al Monto Minimo';SI;SI;FSYS;'OPEWAR';
[Not EV] o Cantidad >= ValidacionMonto(OficialCuenta,Especie,TipoOp,0);'La Cantidad debe ser Mayor o Igual al Monto Minimo';SI;SI;FSYS;'OPEWAR';
EV o Cantidad <= ValidacionMonto(OficialCuenta,Especie,TipoOp,1);'La Cantidad debe ser Menor o Igual al Monto Maximo';SI;SI;FSYS;'OPEWAR';
[Not EV] o Cantidad <= ValidacionMonto(OficialCuenta,Especie,TipoOp,1);'La Cantidad debe ser Menor o Igual al Monto Maximo';SI;SI;FSYS;'OPEWAR';

EV o [[Incluido(TipoOp,'FXIMPO|FXEXPO')] o [Incluido(TipoOp,'FXOCTC|FXOCTV')] o VCAN5 <> 0 ];'Risk Management no ha ingresado valor PFE para este plazo. No puede ser cargada la operacion';NO;

Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)>LimConsumido(CLIENTE1,'RPCCLI','USD',0,VEHICULO1,,,NROPERACION)];'Patrimonio del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI')] o [DesciendeDeCliente(Cliente1,'VINCULADOS') y EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PVINC')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BLOCAL')] o [DesciendeDeCliente(Cliente1,'BLOCAL') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINAN')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BEXTER')] o [DesciendeDeCliente(Cliente1,'BEXTER') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINEXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'CORREXT')] o [DesciendeDeCliente(Cliente1,'CORREXT') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCORREXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [DesciendeDeCliente(Cliente1,'BANCOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS')] o [EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI')] o [DesciendeDeCliente(Cliente1,'CORRESP')] o [Not DesciendeDeCliente(Cliente1,'BANCOS') y Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI') y Not DesciendeDeCliente(Cliente1,'CORRESP') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCLIENTE')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('P25')>BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)*3];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1

ExisteLimite('78',CLIENTE1,'USD') o TOTALAUX2 = 0         o FechaOp > Fsys; 'Limite FXL No Asignado ';SI;SI;FSYS;'LINOAS';;;2
VtoLimite('78',CLIENTE1,'USD') >= FECHAOP o TOTALAUX2 = 0 o FechaOp > Fsys; 'Limite FXL Vencido '    ;SI;SI;FSYS;'LIVENC';;;2  
[LimAsignado(CLIENTE1,'78','USD',,,,,,,,,,,PLAZO)>=(LimConsumido(CLIENTE1,'78','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + LimConsumido(CLIENTE1,'320','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TOTALAUX2)] o TOTALAUX2 = 0 o FechaOp > Fsys;'Limite FXL Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,'78','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TOTALAUX2) - LimAsignado(Cliente1,'78','USD',,,,,,,,,,,PLAZO)),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;2
