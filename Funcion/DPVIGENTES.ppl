If Incluido(Dialogo.TipoOp1,'DPOS|DPFW|DPBOS')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Cliente1, O.MB1, O.MB3, O.MB4, O.Especie, O.FechaEj, O.PrecioEj, ")
   SQL.ADD(" O.Especie, O.Cantidad, O.PrecioRef, O.UMedida, O.TotalAux1, O.TipoCambio2 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O  ")
   SQL.ADD("where O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp    = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and O.FechaEj  > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DPBOD|DPOA|DPOAV|DPOD|DPRC|DPRRS|DPRS|DPS|DPBOA|DPC|DPF|DPOGA|DPOGD|DPOGS|DPSF|DPSV')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Cliente1, O.MB1, O.MB3, O.MB4, O.TipoCambio2, O.Especie, ")
   SQL.ADD(" O.PrecioEj, O.FechaOp2, O.FechaEj, O.Plazo, O.Cantidad, O.TotalAux2, O.Cuotas1, O.PrecioRef, O.UMedida, ")
   SQL.ADD(" O.TotalAux1, O.TipoCambio3, O.RB9, O.MB2, O.FechaEx1, O.TipoCambio, O.RB7, ") 
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Eqstr(Dialogo.TipoOp1,'DPSN')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Cliente1, O.MB1, O.MB3, O.Especie, O.FechaOp2, O.FechaEj, ")
   SQL.ADD(" O.Plazo, O.Cantidad, O.TotalAux2, O.Cuotas1, O.PrecioRef, O.UMedida, O.TotalAux1, O.PrecioEj, O.FechaPrecan, ")
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (CB8 is Null or CB8='0') ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DPDSO|DPDSS')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Cliente1, O.MB1, O.Especie, O.FechaOp2, O.FechaEj, O.Plazo, ")
   SQL.ADD(" O.Cantidad, O.TotalAux2, O.PrecioEj, O.PrecioRef, O.UMedida, O.TotalAux1, O.TipoOpcion, O.FechaPrecan, ")
   SQL.ADD(" O.Cuotas1, ") 
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3, T.Nombre ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C,  "~DBO~".TIPOSOPERACION T ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.TipoOp  = T.Codigo ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif