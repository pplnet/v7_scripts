* 6/8
* Funcion - AUTOAUTOMA - Autorizacipn Automatica de posicion

If [Val(AF6)>0] O [Val(AF7)>0] O [Val(AF8)>0] O [Val(AF9)>0] 
 * Selecciona aquellas operaciones que estan en Sup de Gerencias 
 SQL.ADD(" Select NrOperacion From  "~DBO~".OPERACIONESBITS O ")
 SQL.ADD(" Where Valor='1' and NrBit in (20,21,10,52) and exists ( ")
 SQL.ADD(" Select * from "~DBO~".EXCEPCIONES E where  E.NrOperacion=O.NrOperacion and ")
 SQL.ADD(" Tipo in ('EAR','EMISION','PROF','ISSUER') and Autorizado is Null ) ")
 SQL.ADD(" Order by NrOperacion ")
 Recorrer SQL
  BorrarCeldas(AC8..AC10)
  ACT(AC9,FBN['NrOperacion'])
  If Val(AF6)=1
   SQL.ADD(" UPDATE "~DBO~".EXCEPCIONES set Autorizado = 'Automatico' ")
   SQL.ADD(" where NrOperacion = '"~VAL(AC9)~"' and Tipo = 'EAR' ")
   Message('----- Autoriz. Autom. de EaR Operacion : '~FBN['NrOperacion'])
  EndIf
  If Val(AF9)=1  
   SQL.ADD(" UPDATE "~DBO~".EXCEPCIONES set Autorizado = 'Automatico' ")
   SQL.ADD(" where NrOperacion = '"~VAL(AC9)~"' and Tipo = 'EMISION' ")
   Message('----- Autoriz. Autom. de Emision Operacion : '~FBN['NrOperacion'])
  EndIf 
  If Val(AF8)=1  
   SQL.ADD(" UPDATE "~DBO~".EXCEPCIONES set Autorizado = 'Automatico' ")
   SQL.ADD(" where NrOperacion = '"~VAL(AC9)~"' and Tipo = 'PROF' ")
   Message('----- Autoriz. Autom. de Prof. Operacion : '~FBN['NrOperacion'])
  EndIf
  If Val(AF7)=1
   SQL.ADD(" UPDATE "~DBO~".EXCEPCIONES set Autorizado = 'Automatico' ")
   SQL.ADD(" where NrOperacion = '"~VAL(AC9)~"' and Tipo = 'ISSUER' ")
   Message('----- Autoriz. Autom. de Issuer Operacion : '~FBN['NrOperacion'])
  EndIf
  SQL.NEW
  SQL.EXEC
  * Si no tiene ninguna otra excepcion de posicion
  * pasa la operacion a las instancias siguientes
  SQL.ADD(" Select Count(*) From "~DBO~".EXCEPCIONES E Where ")
  SQL.ADD(" (Tipo in ('EAR','EMISION','PROF','ISSUER')) and ")
  SQL.ADD(" (NrOperacion = '"~VAL(AC9)~"') and ")
  SQL.ADD(" (Autorizado is NOT null) and exists (Select * from ")
  SQL.ADD(" "~DBO~".OPERACIONESBITS O where ((Valor='1' and NrBit =20) or (Valor='1' and NrBit =21)) ")
* SQL.ADD(" and (Valor='0' and NrBit =10) and (Valor='0' and NrBit=52) and O.NrOperacion=E.NrOperacion )")
  SQL.ADD(" and O.NrOperacion=E.NrOperacion )")
  Recorrer SQL
   ACN(AC8,Fields[0])
  Proximo
  If [Val(AC8)>0] y [SQL("Select Count(*) from "~DBO~".EXCEPCIONES Where Tipo in ('EAR','EMISION','PROF','ISSUER') and  NrOperacion = '"~VAL(AC9)~"' and Autorizado is  null ") = 0 ]
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' Where ")
   SQL.ADD(" NrOperacion = '"~FBN['NrOperacion']~"' and NrBit in (55,56) ")
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' Where ")
   SQL.ADD(" NrOperacion = '"~FBN['NrOperacion']~"' and NrBit in (20,21) ")
   SQL.NEW
   SQL.EXEC
  EndIf
  BorrarCeldas(AC6..AF10)
  Break
 Proximo
 BorrarCeldas(AC6..AF10)
EndIf

