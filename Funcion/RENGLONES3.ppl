   ACT(y:FAC, IIf(Eqstr(FBN['RB5'], '0'), 'Act Act',IIf(Eqstr(FBN['RB5'], '1'), 'Act 365F',IIf(Eqstr(FBN['RB5'], '2'), 'Act 360',IIf(Eqstr(FBN['RB5'], '3'), 'Act 360',IIf(Eqstr(FBN['RB5'], '4'), '360 360','30E 360'))))))
   ACN(z:FAC, FBN['PrecioRef3'])
