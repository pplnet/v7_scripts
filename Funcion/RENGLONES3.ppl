If Incluido(FBN['TipoOp'],'VIMIND|VIMINM|TEMIND|TEMINM')
   If Not [EqStr(val(ba5),FBN['Especie']) y EqStr(val(ba6),FBN['MB3'])] 
      If Val(pr:1)=1
         IfA 
         ACT(a:fac, 'Coloca - Totales en '~Val(ba5))
         If EqStr(val(ba6),'1')
            ACT(a:fac, 'Toma - Totales en '~Val(ba5))
         Endif
         AgregarMarco(a:fac..s:fac,1,0,EXE('COLOR6'))
         ACN(h:fac, Val(sh:1))
         ACN(i:fac, Val(sv:1))
         ACN(j:fac, Val(sj:1))
         ACN(m:fac, Val(sm:1))
         ACN(o:fac, Val(so:1))
         ACN(q:fac, Val(sq:1))
         ACN(r:fac, Val(sr:1))
         ACN(s:fac, Val(ss:1))
      Endif
      ACT(ba5, FBN('Especie'))
      ACT(ba6, FBN('MB3'))
      ACN(sw:1,0)
      SetFont(a:fac..z:FAC,2)

      ACN(sh:1, 0)
      ACN(sv:1, 0)
      ACN(sj:1, 0)
      ACN(sm:1, 0)
      ACN(so:1, 0)
      ACN(sq:1, 0)
      ACN(sr:1, 0)
      ACN(ss:1, 0)
      IfA
      IfA
   Endif
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ACD(c:FAC, FBN['FechaOp'])
   ACT(d:FAC, FBN['FechaOp'])
   ACT(e:FAC, FBN['Vehiculo1'])
   ACT(f:FAC, IIf(Eqstr(FBN['MB3'], '0'),'Coloca','Toma'))
   ACT(g:FAC, FBN['Especie'])
   ACN(h:FAC, IIf(Eqstr(FBN['MB3'],'0'),1,-1)*FBN['Cantidad'])
   ACN(j:FAC, IIf(Eqstr(FBN['MB3'],'0'),1,-1)*FBN['TotalBrutoCli1'])
   ACN(k:FAC, FBN['Plazo'])
   ACD(l:FAC, FBN['FechaVto'])
   ACN(i:FAC, 0)
   ACN(m:FAC, 0)
   If Incluido(FBN['TipoOp'],'VIMINM|TEMINM')
      ACN(i:FAC, FBN['TotalComisiones'])
      ACN(m:FAC, FBN['TasaPrecan'])
   Endif
   ACN(n:FAC, FBN['TotalAux1'])
   ACN(o:FAC, FBN['TotalAux3'])
   ACN(p:FAC, FBN['Precio1'])
   ACN(q:FAC, FBN['Cantidad']*(FBN['Precio1']+FBN['Spread'])*((Dialogo.Fecha1-FBN['FechaOp'])+1)/iIf(Eqstr(FBN['RB8'],'1'),36500,36000) )
   ACN(r:FAC, IIf(Eqstr(FBN['MB3'],'0'),1,-1)*FBN['TotalIntereses'])
   ACN(s:FAC, IIf(Eqstr(FBN['MB3'],'0'),1,-1)*(FBN['Cantidad']+FBN['TotalIntereses']))
   ACN(t:FAC, FBN['Precio4'])
   ACT(u:FAC, FBN['Cliente1'])
   SCN(sh:1, Val(h:fac))
   SCN(sv:1, Val(i:fac))
   SCN(sj:1, Val(j:fac))
   SCN(sm:1, Val(m:fac))
   SCN(so:1, Val(o:fac))
   SCN(sq:1, Val(q:fac))
   SCN(sr:1, Val(r:fac))
   SCN(ss:1, Val(s:fac))
   If Eqstr(FBN['MB3'],'0')
      * Coloca
      SCN(uh:1, Val(h:fac)*val(sz:1))
      SCN(ui:1, Val(i:fac)*val(sz:1))
      SCN(uj:1, Val(j:fac)*val(sz:1))
      SCN(um:1, Val(m:fac)*val(sz:1))
      SCN(uo:1, Val(o:fac)*val(sz:1))
      SCN(uq:1, Val(q:fac)*val(sz:1))
      SCN(ur:1, Val(r:fac)*val(sz:1))
      SCN(us:1, Val(s:fac)*val(sz:1)) 
   Else
      * Toma
      SCN(th:1, Val(h:fac)*val(sz:1))
      SCN(ti:1, Val(i:fac)*val(sz:1))
      SCN(tj:1, Val(j:fac)*val(sz:1))
      SCN(tm:1, Val(m:fac)*val(sz:1))
      SCN(to:1, Val(o:fac)*val(sz:1))
      SCN(tq:1, Val(q:fac)*val(sz:1))
      SCN(tr:1, Val(r:fac)*val(sz:1))
      SCN(ts:1, Val(s:fac)*val(sz:1))
   Endif
   FormatoCeldas(k:fac..k:fac, EXE('F0'))
   FormatoCeldas(n:fac..p:fac, EXE('F6'))
   FormatoCeldas(t:fac..t:fac, EXE('F6'))
   SetFont(a:fac..u:FAC,1)
   SCN(sw:1,1)
Endif

If Incluido(FBN['TipoOp'],'MMCDP|MMD|MMO')
   If Not EqStr(val(ba5),FBN['Especie']) y Val(pr:1)=1
      IfA 
      ACT(a:fac, 'Totales en '~Val(ba5))
      AgregarMarco(a:fac..s:fac,1,0,EXE('COLOR6'))
      ACN(g:fac, Val(sg:1))
      ACN(m:fac, Val(sm:1))
      ACN(n:fac, Val(sn:1))
      ACN(o:fac, Val(so:1))
      ACN(p:fac, Val(sp:1))
      ACN(r:fac, Val(sr:1))
      ACN(s:fac, Val(ss:1))
      SetFont(a:fac..z:FAC,2)
      ACN(sg:1, 0)
      ACN(sm:1, 0)
      ACN(sn:1, 0)
      ACN(so:1, 0)
      ACN(sp:1, 0)
      ACN(sr:1, 0)
      ACN(ss:1, 0)
      IfA
      IfA
   Endif
   ACT(ba5, FBN('Especie'))   
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ACD(c:FAC, FBN['FechaOp2'])
   ACD(d:FAC, FBN['FechaOp'])
   ACT(e:FAC, FBN['Vehiculo1'])
   ACT(f:FAC, FBN['Especie'])
   ACN(g:FAC, FBN['Cantidad'])
   If [Incluido(FBN['TipoOp'],'MMCDP') y FBN['Plazo2']=0] o Not Incluido(FBN['TipoOp'],'MMCDP')
      ACN(h:FAC, FBN['Plazo'])
      ACD(i:FAC, FBN['FechaVto'])
      ACN(k:FAC, FBN['Precio1'])
      ACN(l:FAC, FBN['Spread'])
      ACN(n:FAC, FBN['TotalIntereses'])
      ACN(r:FAC, FBN('TotalBrutoCli1'))
   Else 
      ACN(h:FAC, FBN['Plazo2'])
      ACD(i:FAC, FBN['FechaVto2'])     
      ACN(k:FAC, FBN['Precio2'])
      ACN(l:FAC, FBN['PrecioMer'])
      ACN(n:FAC, FBN['TotalAux1'])
      ACN(r:FAC, FBN['TotalAux3'])
   Endif
   ACT(j:FAC, FBN['TipoTasa'])
   ACN(m:FAC, FBN['Cantidad']*(val(k:fac)+val(l:fac))*((Dialogo.Fecha1-FBN['FechaOp'])+1)/IIf(Eqstr(FBN['RB8'],'1'),36500,36000) )
   ACT(o:FAC, ' ')
   ACN(p:FAC, FBN('TotalIva'))
   ACN(q:FAC, FBN('Precio4'))
   ACN(s:FAC, FBN('TotalNetoCli1'))
   ACT(t:FAC, FBN('Cliente1'))
   *Totales por moneda   
   SCN(sg:1, Val(g:fac))
   SCN(sm:1, Val(m:fac))
   SCN(sn:1, Val(n:fac))
   SCN(so:1, Val(o:fac))
   SCN(sp:1, Val(p:fac))
   SCN(sr:1, Val(r:fac))
   SCN(ss:1, Val(s:fac))
   * Si la especie no es USD convierte para sumar en el informe de totales por vehiculo
   ACN(tg:fac, Val(g:fac)*VAL(sz1))
   ACN(tm:fac, Val(m:fac)*VAL(sz1))
   ACN(tn:FAC, Val(n:fac)*VAL(sz1))
   ACN(to:FAC, Val(o:fac)*VAL(sz1))
   ACN(tp:FAC, Val(p:fac)*VAL(sz1))
   ACN(tr:FAC, Val(r:fac)*VAL(sz1))
   ACN(ts:FAC, Val(s:fac)*VAL(sz1))
   FormatoCeldas(k:fac..l:fac, EXE('F6'))
   FormatoCeldas(q:fac..q:fac, EXE('F6'))
   FormatoCeldas(h:fac..h:fac, EXE('F0'))
   SetFont(a:fac..t:FAC,1)
Endif

If Incluido(FBN['TipoOp'],'MMPLME')
   If Not EqStr(val(ba5),FBN['Especie']) y Val(pr:1)=1
      IfA 
      ACT(a:fac, 'Totales en '~Val(ba5))
      AgregarMarco(a:fac..q:fac,1,0,EXE('COLOR6'))
      ACN(g:fac, Val(sg:1))
      ACN(k:fac, Val(sk:1))
      ACN(l:fac, Val(sl:1))
      ACN(m:fac, Val(sm:1))
      ACN(n:fac, Val(sn:1))
      ACN(o:fac, Val(so:1))
      ACN(p:fac, Val(sp:1))
      ACN(q:fac, Val(sq:1))
      SetFont(a:fac..z:FAC,2)
      ACN(sg:1, 0)
      ACN(sk:1, 0)
      ACN(sl:1, 0)
      ACN(sm:1, 0)
      ACN(sn:1, 0)
      ACN(so:1, 0)
      ACN(sp:1, 0)
      ACN(sq:1, 0)
      IfA
      IfA
   Endif
   ACT(ba5, FBN('Especie'))   
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ACD(c:FAC, FBN['FechaOp2'])
   ACD(d:FAC, FBN['FechaOp'])
   ACT(e:FAC, FBN['Vehiculo1'])
   ACT(f:FAC, FBN['Especie'])
   ACN(g:FAC, FBN['Cantidad'])
   ACN(h:FAC, FBN['Plazo'])
   ACD(i:FAC, FBN['FechaVto'])
   ACN(j:FAC, FBN['Precio1'])
   ACN(di1, DiasA(2,Fsys))
   ACN(di1, Val(di1)*100)
   **ACN(k:FAC, FBN['Cantidad']*FBN['Precio1']*((Dialogo.Fecha1-FBN['FechaOp']))/iIf(Eqstr(FBN['RB8'],'1'),36500,iIf(Eqstr(FBN['RB8'],'0'),Val(di1),36000)))
   ACN(k:FAC, FBN['Cantidad']*FBN['Precio1']*(iIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('FechaOp'), Dialogo.Fecha1,2)+1, (Dialogo.Fecha1-FBN['FechaOp'])+1))/iIf(Eqstr(FBN['RB8'],'1'),36500,iIf(Eqstr(FBN['RB8'],'0'),Val(di1),36000)))
   *messagebox(val(k:FAC))
   **IIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('FechaOp'), Dialogo.Fecha1,2), (Dialogo.Fecha1-FBN['FechaOp']))
   ACN(l:FAC, FBN['TotalIntereses'])
   ACN(m:FAC, 0)
   ACN(n:FAC, FBN('TotalIva'))
   ACN(o:FAC, FBN('Precio4'))
   ACN(p:FAC, FBN('TotalBrutoCli1'))
   ACN(q:FAC, FBN('TotalNetoCli1'))
   ACT(r:FAC, FBN('Cliente1'))
   *Totales por moneda   
   SCN(sg:1, Val(g:fac))
   SCN(sl:1, Val(l:fac))
   SCN(sm:1, Val(m:fac))
   SCN(sn:1, Val(n:fac))
   SCN(so:1, Val(o:fac))
   SCN(sp:1, Val(p:fac))
   SCN(sq:1, Val(q:fac))
**** no estava para dev y se agrego el 14/11/01
   SCN(sk:1, Val(k:fac))
****
   * Si la especie no es USD convierte para sumar en el informe de totales por vehiculo
   ACN(tg:fac, Val(g:fac)*val(sz1))
**** no estava para dev y se agrego el 14/11/01
   ACN(tk:fac, Val(k:fac)*val(sz1))
****
   ACN(tl:fac, Val(l:fac)*val(sz1))
   ACN(tm:FAC, Val(m:fac)*val(sz1))
   ACN(tn:FAC, Val(n:fac)*val(sz1))
   ACN(to:FAC, Val(o:fac)*val(sz1))
   ACN(tp:FAC, Val(p:fac)*val(sz1))
   ACN(tq:FAC, Val(q:fac)*val(sz1))
   FormatoCeldas(j:fac..j:fac, EXE('F6'))
   FormatoCeldas(o:fac..o:fac, EXE('F6'))
   FormatoCeldas(q:fac..q:fac, EXE('F2'))
   FormatoCeldas(h:fac..h:fac, EXE('F0'))
   SetFont(a:fac..t:FAC,1)
Endif


If Incluido(FBN['TipoOp'],'MMFRN|MMFRNP|MMON|MMPCCV|MMPCL|MMPCOS|MMPE|MMPI|MMPSC|MMPSI|MMP|')
   If Not EqStr(val(ba5),FBN['Especie']) y Val(pr:1)=1
      IfA 
      ACT(a:fac, 'Totales en '~Val(ba5))
      AgregarMarco(a:fac..s:fac,1,0,EXE('COLOR6'))
      ACN(g:fac, Val(sg:1))
      ACN(m:fac, Val(sm:1))
      ACN(n:fac, Val(sn:1))
      ACN(o:fac, Val(so:1))
      ACN(p:fac, Val(sp:1))
      ACN(r:fac, Val(sr:1))
      ACN(s:fac, Val(ss:1))
      SetFont(a:fac..z:FAC,2)
      ACN(sg:1, 0)
      ACN(sm:1, 0)
      ACN(sn:1, 0)
      ACN(so:1, 0)
      ACN(sp:1, 0)
      ACN(sr:1, 0)
      ACN(ss:1, 0)
      IfA
      IfA
   Endif
   ACT(ba5, FBN('Especie'))   
   If Not EqStr(val(ba4),FBN['NrOperacion']) 
      IfA
      ACT(a:FAC, FBN['NrOperacion'])
      ACLO(a:FAC, FBN['NrOperacion'])
      ACT(b:FAC, FBN['TipoOp'])
      If Eqstr(FBN('TipoOp'), 'MMPCCV')
         ACT(b:fac, Val(b:fac)~' '~iIf(Eqstr(FBN('MB3'), '0'),'Prestamo','Colocacion')) 
      Endif
      ACD(c:FAC, FBN['FechaOp2'])
      ACD(d:FAC, FBN['FechaOp'])
      ACT(e:FAC, FBN['Vehiculo1'])
      ACT(f:FAC, FBN['Especie'])
      If Incluido(FBN('TipoOp'), 'MMPCCV|MMPSI')
         ACN(g:FAC, FBN['Cantidad'])
      ELSE
         ACN(g:FAC, FBN['PrecioEj'])
      Endif
      ACN(h:FAC, FBN['Plazo'])
      ACD(i:FAC, FBN['FechaVto'])
      ACT(j:FAC, FBN['TipoTasa'])
      ACN(k:FAC, FBN['Precio1'])
      ACN(l:FAC, FBN['Spread'])
      ACN(di1, DiasA(2,Fsys))
      ACN(di1, Val(di1)*100)
      If Incluido(FBN('TipoOp'), 'MMON|MMPCL|MMPCOS|MMPE|MMPI')
         ACN(m:FAC, FBN['PrecioEj']*(FBN['Precio1']+FBN['Spread'])*(iIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('FechaOp'), Dialogo.Fecha1,2)+1, (Dialogo.Fecha1-FBN['FechaOp'])+1))/iIf(Eqstr(FBN['RB8'],'1'),36500,IIf(Eqstr(FBN['RB8'],'0'),Val(di1),36000)))
      ELSE
         ACN(m:FAC, FBN['Cantidad']*(FBN['Precio1']+FBN['Spread'])*(iIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('FechaOp'), Dialogo.Fecha1,2)+1, (Dialogo.Fecha1-FBN['FechaOp'])+1))/iIf(Eqstr(FBN['RB8'],'1'),36500,IIf(Eqstr(FBN['RB8'],'0'),Val(di1),36000)))
      Endif
      If Eqstr(FBN('TipoOp'), 'MMON')
         ACN(n:FAC, FBN['TotalNetoCli2'])
      ELSE
         ACN(n:FAC, FBN['TotalIntereses'])
      Endif    
      If Incluido(FBN('TipoOp'), 'MMON|MMPCC|MMPI|MMPE|MMPCOS')
         ACN(o:FAC, FBN('TotalAux3'))
      ELSE
         ACN(o:FAC, FBN('Importe3'))
      Endif
*** cambio por importeiva
***      ACN(p:FAC, FBN('Importe2'))
***      If Incluido(FBN('TipoOp'), 'MMON|MMPCCV')
         ACN(p:FAC, FBN('TotalIva'))
***      Endif
      ACN(q:FAC, FBN('Precio4'))
      ACN(r:FAC, FBN('TotalBrutoCli1'))
      ACN(s:FAC, FBN('TotalNetoCli1'))
      If Incluido(FBN('TipoOp'), 'MMFRN|MMFRNP|MMPSC|MMPSI|')
         ACT(T:FAC, FBN('Cliente2'))
      ELSE
         ACT(T:FAC, FBN('Cliente1'))
      Endif
   ELSE
      dfa
      SCN(o:FAC, FBN('Importe3'))
      SCN(p:FAC, FBN('Importe2'))
   Endif
   *Totales por moneda   
   If Not EqStr(val(ba4),FBN['NrOperacion']) 
      SCN(sg:1, Val(g:fac))
      SCN(sl:1, Val(l:fac))
      SCN(sm:1, Val(m:fac))
      SCN(sn:1, Val(n:fac))
      SCN(sr:1, Val(r:fac))
      SCN(ss:1, Val(s:fac))
      * Si la especie no es USD convierte para sumar en el informe de totales por vehiculo
      ACN(tg:fac, Val(g:fac)*VAL(sz1))
      ACN(tm:FAC, Val(m:fac)*VAL(sz1))
      ACN(tn:FAC, Val(n:fac)*VAL(sz1))
      ACN(tr:fac, Val(r:fac)*VAL(sz1))
      ACN(ts:fac, Val(s:fac)*VAL(sz1))
      ACT(ba4,FBN['NrOperacion'])
   Endif
   SCN(so:1, FBN('Importe3'))
   SCN(sp:1, FBN('Importe2'))
   ACN(to:FAC, Val(o:fac)*VAL(sz1))
   ACN(tp:FAC, Val(p:fac)*VAL(sz1))
   FormatoCeldas(k:fac..l:fac, EXE('F6'))
   FormatoCeldas(q:fac..q:fac, EXE('F6'))
   FormatoCeldas(h:fac..h:fac, EXE('F0'))
   SetFont(a:fac..t:FAC,1)
Endif

If Incluido(FBN['TipoOp'],'MMCDIA|MMFCMV|MMFIMV|MMONM|MMPOCM|MMPCCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMSIMV')
   If Not EqStr(val(ba5),FBN['Especie']) y Val(pr:1)=1
      IfA 
      ACT(a:fac, 'Totales en '~Val(ba5))
      AgregarMarco(a:fac..u:fac,1,0,EXE('COLOR6'))
      ACN(j:fac, Val(sj:1))
      ACN(k:fac, Val(sk:1))
      ACN(o:fac, Val(so:1))
      ACN(p:fac, Val(sp:1))
      ACN(q:fac, Val(sq:1))
      ACN(r:fac, Val(sr:1))
      ACN(t:fac, Val(st:1))
      ACN(u:fac, Val(su:1))
      SetFont(a:fac..z:FAC,2)
      ACN(sj:1, 0)
      ACN(sk:1, 0)
      ACN(so:1, 0)
      ACN(sp:1, 0)
      ACN(sq:1, 0)
      ACN(sr:1, 0)
      ACN(st:1, 0)
      ACN(su:1, 0)
      IfA
   Endif
   ACT(ba5, FBN('Especie'))   
   If Not EqStr(val(ba4),FBN['NrOperacion'])
      IfA
      ACT(a:FAC, FBN['NrOperacion'])
      ACLO(a:FAC, FBN['NrOperacion'])
      ACT(b:FAC, FBN['TipoOp'])
      If Eqstr(FBN('TipoOp'), 'MMPCCM')
         ACT(b:fac, Val(b:fac)~' '~iIf(Eqstr(FBN('MB3'), '0'),'Prestamo','Colocacion')) 
      Endif
      ACD(c:FAC, FBN['FechaOp2'])
      ACT(d:FAC, FBN['Vehiculo1'])
      ACT(ba4,FBN['NrOperacion'])
      If Incluido(FBN('TipoOp'), 'MMCDIA')  
         SCN(tj4, FBN('Cantidad'))
      ELSE
         SCN(tj4, FBN('Cantidad2'))
      Endif
   Endif
   ACN(e:FAC, FBN['NrCuota'])
   ACD(f:FAC, FBN['Fecha1'])
   ACD(g:FAC, FBN['Fecha2'])
   ACN(h:FAC, FBN['Plazo1'])
   ACT(i:FAC, FBN['Especie'])
   If Incluido(FBN('TipoOp'), 'MMCDIA')  
      ACN(j:FAC, FBN['Cantidad'])   
   ELSE
      ACN(j:FAC, FBN['Cantidad2'])
   Endif
   If Incluido(FBN('TipoOp'), 'MMONM|MMFIMV')
      ACN(k:FAC, FBN['Cantidad4'])
   ELSE
      ACN(k:FAC, FBN['Cantidad1'])
   Endif
   ACT(l:FAC, FBN['TipoTasa'])
   ACN(m:FAC, FBN['Pr2'])
   If Incluido(FBN('TipoOp'), 'MMCDIA|')   
      ACN(m:FAC, FBN['Precio1'])
   Endif
   If Incluido(FBN('TipoOp'), 'MMCDP') 
      If FBN['Plazo2']=0
         ACN(m:FAC, FBN['Precio1'])
      Else 
         ACN(m:FAC, FBN['Precio2'])
      Endif  
   Endif
   ACN(n:FAC, FBN['Pr4'])
   *---Intereses Devengados solo para cuota vigente ---
   If Dialogo.Fecha1 >= FBN['Fecha1']  y Dialogo.Fecha1 < FBN['Fecha2']
      If Incluido(FBN('TipoOp'), 'MMCDIA|MMCDP')
         ACN(o:FAC, FBN['Cantidad']*(FBN['Precio1']+FBN['Spread'])*(iIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('FechaOp'), Dialogo.Fecha1,2), (Dialogo.Fecha1-FBN['Fecha1']))+1)/IIf(Eqstr(FBN['RB8'],'1'),36500,36000)  )
      ELSE
         ACN(di1, DiasA(2,Fsys))
         ACN(di1, Val(di1)*100)
         ACN(o:FAC, FBN['Cantidad2']*(FBN['Pr2']+FBN['Pr4'])*(iIf(Eqstr(FBN['RB8'],'3') o Eqstr(FBN['RB8'],'4'), DIf360(FBN('Fecha1'), Dialogo.Fecha1,2), (Dialogo.Fecha1-FBN['Fecha1']))+1)/IIf(Eqstr(FBN['RB8'],'1'),36500,IIf(Eqstr(FBN['RB8'],'0'),Val(di1),36000)))     
      Endif 
   Else
      ACN(o:FAC, 0)
   Endif
   ACN(p:FAC, FBN['Total3'])
   If Incluido(FBN('TipoOp'), 'MMONM|MMFIMV|MMSIMV')
      ACN(p:FAC, FBN['Cantidad5'])
   Endif
   If Incluido(FBN('TipoOp'), 'MMFCMV|MMSCMV|MMCDIA')
      ACN(p:FAC, FBN['Cantidad3'])
   Endif
   ACN(q:FAC, FBN['Total7'])
   ACN(r:FAC, FBN['Total4'])
   If Incluido(FBN('TipoOp'), 'MMONM|MMFIMV|MMSIMV')
      ACN(q:FAC, FBN['Pr3'])
      ACN(r:FAC, FBN['Pr1'])
   Endif
   ACN(s:FAC, FBN['Pr3'])
   If Incluido(FBN('TipoOp'), 'MMONM|MMFIMV|MMSIMV|MMFCMV|MMSCMV')
      ACN(s:FAC, FBN['Total3'])
   Endif
   If Incluido(FBN('TipoOp'), 'MMCDIA|MMCDP')   
      ACN(t:FAC, FBN['TotalBrutoCli1'])
      If Incluido(FBN('TipoOp'), 'MMCDP') y FBN['Plazo2']>0
         MessageBox('Pasa')
         ACN(t:FAC, FBN['TotalAux4'])
      Endif
      ACN(u:FAC, val(t:fac)) 
   Else 
      ACN(t:FAC, FBN['Total2'])
      ACN(u:FAC, FBN['Total1'])
   Endif
   If Incluido(FBN('TipoOp'), 'MMFCMV|MMSCMV|')
      ACT(v:FAC, FBN('Cliente2'))
   ELSE
      ACT(v:FAC, FBN('Cliente1'))
   Endif
   If Dialogo.Fecha1>=FBN('Fecha1') y Dialogo.Fecha1<FBN('Fecha2')
      *Totales por moneda   
      SCN(sj:1, Val(j:fac))
      SCN(sk:1, Val(k:fac))
      SCN(so:1, Val(o:fac))
      SCN(sp:1, Val(p:fac))
      SCN(sq:1, Val(q:fac))
      SCN(sr:1, Val(r:fac))
      SCN(st:1, Val(t:fac))
      SCN(su:1, Val(u:fac))
      * Si la especie no es USD convierte para sumar en el informe de totales por vehiculo
      ACN(tj:fac, Val(j:fac)*Val(sz1))
      ACN(tk:FAC, Val(k:fac)*Val(sz1))
      ACN(to:FAC, Val(o:fac)*Val(sz1))
      ACN(tp:FAC, Val(p:fac)*Val(sz1))
      ACN(tq:FAC, Val(q:fac)*Val(sz1))
      ACN(tr:FAC, Val(r:fac)*Val(sz1))
      ACN(tt:FAC, Val(t:fac)*Val(sz1))
      ACN(tu:FAC, Val(u:fac)*Val(sz1))
   Endif
   FormatoCeldas(e:fac..e:fac, EXE('F0'))
   FormatoCeldas(h:fac..h:fac, EXE('F0'))
   FormatoCeldas(m:fac..n:fac, EXE('F6'))
   FormatoCeldas(s:fac..s:fac, EXE('F6'))
   SetFont(a:fac..v:FAC,1)
Endif

If Incluido(FBN['TipoOp'],'DTO|DTOV')
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ACD(c:FAC, FBN['FechaOp2'])
   ACT(d:FAC, FBN['Vehiculo1'])
   If Incluido(FBN['TipoOp'],'DTO|DTOV')
      ACT(e:FAC, iIf(Eqstr(FBN['MB3'], '0'),'COMPRA ','VENTA '))
      ACT(e:FAC, Val(e:fac)~iIf(Eqstr(FBN['MB1'], '0'),'CALL','PUT'))
      ACT(g:FAC, iIf(Eqstr(FBN['TipoOpcion'], '0'), 'Europea',iIf(Eqstr(FBN['TipoOpcion'], '1'), 'Americana','Asiatica')))
   Endif
   ACT(h:FAC, iIf(Eqstr(FBN['RB8'], '0'), 'Act Act',iIf(Eqstr(FBN['RB8'], '1'), 'Act 365F',iIf(Eqstr(FBN['RB8'], '2'), 'Act 360',iIf(Eqstr(FBN['RB8'], '3'), 'Act 360',iIf(Eqstr(FBN['RB8'], '4'), '360 360','30E 360'))))))
   ACT(i:FAC, FBN['Cliente1'])
   ACT(j:FAC, FBN['Especie'])
   If Not Incluido(FBN['TipoOp'],'DTO|DTOV')
      ACT(f:FAC, iIf(Eqstr(FBN['RB9'], '0'), 'FIJA ','VARIABLE'))
   Endif
   ACT(k:FAC, FBN('TipoTasa'))
   ACN(m:FAC, FBN('PrecioEj'))
   ACN(n:FAC, FBN['Precio3'])
   ACN(o:FAC, FBN['Spread'])
   ACN(s:FAC, FBN['Cantidad'])
   ACD(p:FAC, FBN['FechaOp2'])
   ACN(q:FAC, FBN['Plazo'])
   ACD(r:FAC, FBN['FechaEj'])
   ACD(t:FAC, FBN['FechaEx1'])
   ACN(u:FAC, FBN['Plazo2'])
   ACD(v:FAC, FBN['FechaEx2'])
   ACN(w:FAC, FBN['Precio4'])
   FormatoCeldas(q:fac..q:fac, EXE('F0'))
   FormatoCeldas(u:fac..u:fac, EXE('F0'))
   FormatoCeldas(m:fac..o:fac, EXE('F6'))
   SetFont(a:fac..x:FAC,1)
Endif

