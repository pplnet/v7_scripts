ImpComMerEq1     : 'Importe Eq.'             ; 3;2;2;NO;NO;;;;;IMPCOMMER1*IF(CB6=1,TCCOMMER1,IF(TCCOMMER1<>0,1/TCCOMMER1,0))

Corredor         : 'Corredor'                ; 5;1;2;;;
ContraEspecie2   : 'Moneda Comision'         ; 5;2;2;NOVACIO(CORREDOR);NO;VACIO(CORREDOR) O [NOVACIO(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;'USD'
PorComCor1:IF(RB12=1,'V x Unidad','% Comision'); 6;1;2;NOVACIO(CORREDOR);RB12<>2;;;;;IF(RB12<>2,IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR)),0);
TCComCor1        : 'T.Cambio'                ; 6;2;2;NOVACIO(CORREDOR);NO;VACIO(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;
ImpComCor1       : 'Imp.Comision'            ; 7;1;2;RB12=2; ;;;;;IF(RB12=0, TOTALNETOCLI1*(PORCOMCOR1/100),IF(RB12=1, CANTIDAD*PORCOMCOR1))
ImpComCorEq1     : 'Importe Eq.'             ; 7;2;2;NO;NO;;;;;IMPCOMCOR1*IF(CB6=1,TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))

RB12             : ' Tipo|%|Unidad|Fijo'     ;5;2;2;;;;;;;0
