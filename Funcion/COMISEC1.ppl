PorComMer1       : '% Comision'              ; 2;1;2;NOT INCLUIDO(MERCADO,'OTC');NOT INCLUIDO(MERCADO,'OTC');INCLUIDO(MERCADO,'OTC') O PORCOMMER1>0;'Debe INGRESAR  un % de COMISION DEL MERCADO';NO;;
TCComMer1        : 'T.Cambio'                ; 2;2;2;NOT INCLUIDO(MERCADO,'OTC');NO;TCCOMMER1>=0;'Tipo de Cambio del Mercado INVALIDO';NO;;
