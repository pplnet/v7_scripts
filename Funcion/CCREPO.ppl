Message('Procesando Opciones ...')

SQL.ADD("SELECT O.* ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("Where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and Cupon1  = '"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and O.TipoOp In ('SERA','SERP','SERAV','SERPV') ")
SQL.ADD("and O.FechaOp <='"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and O.FechaVto2 >='"~IdxDate(Val(g2))~"'  ")
SQL.ADD("order by O.TipoOp, O.Especie ")

Recorrer SQL
   Message('Repo  :'~FBN['TipoOp']~' '~FBN['NrOperacion'])   

   act(a:fac,fbn['Cliente1'])
   act(b:fac,fbn['TipoOp'])
   act(c:fac,fbn['Vehiculo1'] )
   acn(d:fac,fbn['Cantidad'] )
   act(e:fac,fbn['TipoOp'] )
   act(f:fac,fbn['NrOperacion'])

   * o:fac 0: Spot no Vencido   1: Spot Vencido   
   acn(o:fac,0)

   IF FBN['FechaVto']<=Dialogo.Fecha1
      acn(o:fac,1)  
   EndIf
 
   * xLiquida o Financia
   act(x:fac,FBN['RB9'])

Proximo
