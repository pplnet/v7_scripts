ACT(zt:1, BuscarCampo('CLIENTES','Persona','Codigo',Dialogo.Cliente1))

SQL.ADD("SELECT C.Sucursal,C.RazonSocial,C.Direccion,C.Localidad,C.CodigoPostal,C.Telefono,C.CUIT ")
SQL.ADD("FROM "~DBO~".CLIENTES C ")
SQL.ADD("WHERE C.Codigo = '"~Dialogo.Cliente1~"' " )

SetFilaActual(Val(dc0)-1)
Recorrer SQL

   IF Not EqStr(Val(y3),'T')
      ACT(b:fac-2, Fecha(PriDeMes(Dialogo.Fecha1,NO)))
      SetFont(b:fac-2..w:fac, 4)
      AlinearCeldas(b:fac-2, "C")
*      SetFilaActual(fac+2)
   ENDIF

   ACT(b:fac, Dialogo.Fecha1)
   SetFont(b:fac..w:fac, 4)
   AlinearCeldas(b:fac, "C")
   SetFilaActual(fac+2)

   ACT(b:fac, FBN['Sucursal'])
   ACT(d:fac, BuscarCampo('SUCURSALES','Nombre','Codigo',FBN['Sucursal']) )
   SetFont(a:fac..w:fac, 4)
   AlinearCeldas(b:fac, "I")
   SetFilaActual(fac+2)

   ACT(a:fac, Dialogo.Cliente1)
   SetFont(a:fac..w:fac, 4)
   SetFilaActual(fac+2)

   ACT(a:fac, FBN['RazonSocial'])
   *- Si es una persona 
   ACN(zt2,fac)
   if EqStr(Val(zt:1),'SI')
      SQL.ADD(" SELECT P.TipoDocumento, P.NrDocumento, P.CUIL, P.CUIT ")
      SQL.ADD(" FROM  "~DBO~".PERSONAS P, "~DBO~".INTEGRANTESCLI I ")
      SQL.ADD(" WHERE I.Codigo = '"~Dialogo.Cliente1~"' AND ")
      SQL.ADD("      I.TipoDocumento = P.TipoDocumento AND ")
      SQL.ADD("      I.NrDocumento = P.NrDocumento AND ")
      SQL.ADD("      I.TipoPoder = 'TIT' ")
      Recorrer SQL
         ACT(r:Val(zt2), Trim(Mirt(FBN['TipoDocumento']))~' - '~Trim(Mirt(FBN['NrDocumento'])))
         SetFont(a:Val(zt2)..w:Val(zt2), 4)
         ACT(a:Val(zt2)+2, FBN['CUIT'])
         if Vacio(FBN['CUIT'])
            ACT(a:Val(zt2)+2, FBN['CUIL'])
         endif
      Proximo
   else
      ACT(a:fac+2, FBN['CUIT'])
   endif
   SetFilaActual(Val(zt2)+2)

   ACT(k:fac, FBN['Direccion'])
   SetFont(a:fac..w:fac, 4)
   SetFilaActual(fac+2)

   ACT(a:fac, FBN['Localidad'])
   ACT(m:fac, FBN['CodigoPostal'])
   ACT(p:fac, FBN['Telefono'])
   SetFont(a:fac..w:fac, 4)
   AlinearCeldas(m:fac, "C")
Proximo