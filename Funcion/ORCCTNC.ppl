*Validación CantidadCompletada Órdenes (Alta)
IF((RB4=0 y Eqstr(ABM,'A')),(TotalNetoCli1 + BuscarCampo('ORDENES','CantidadCompletada','NrOrden',NRORDEN)) <= (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN) + (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN)/VAR('PORDESORD'))) Y TotalNetoCli1>0,TotalNetoCli1>0);'La Cantidad excede el total de la orden';NO
*Validación CantidadCompletada Órdenes (Modificación)
IF((RB4=0 y Eqstr(ABM,'E')),(TotalNetoCli1 - (BuscarCampo('EJECUCIONES','Cantidad','NrOperacion',NROPERACION)) + BuscarCampo('ORDENES','CantidadCompletada','NrOrden',NRORDEN)) <= (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN) + (BuscarCampo('ORDENES','CantidadTotalOrden','NrOrden',NRORDEN)/VAR('PORDESORD')))  Y TotalNetoCli1>0,TotalNetoCli1>0);'La nueva Cantidad excede el total de la orden';NO