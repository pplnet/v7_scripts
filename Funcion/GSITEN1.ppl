
** AA 30-03-2026 se toma para cualquier moneda extranjera la valuacion contable en ARP
      if Not EqStr(fbn['ContraEspecie'],'ARP')
         if EqStr(fbn['ContraEspecie'],'USD')
*            ACN(tp20,Cotizacion('COMA35',,,,fbn['FechaVto'],1))
*            ACN(tp20,CotizacionBNA(fbn['ContraEspecie'],fbn['FechaVto'],1,NO,SI) )
            ACN(tp20,COTIZACIONC(fbn('ContraEspecie'),,,,fbn['FechaVto'],25,SI,VAR('MONELOCA')) )
         Else
         **ACN(tp20,Cotizacion(fbn('Contraespecie'),,,,fbn['FechaVto'],5))
            ACN(tp20,COTIZACIONC(fbn('ContraEspecie'),,,,fbn['FechaVto'],25,SI,VAR('MONELOCA')) )
         Endif
      else
          ACN(tp20,1)
      endif
      
      ACT(a:fac,Val(xy80))
      ACT(b:fac,fbn['TipoOPX'])
      ACT(c:fac,fbn['CodComitente'])
      ACT(d:fac,fbn['Posicion'])
      ACT(e:fac,fbn['Plazo'])
      ACT(f:fac,fbn['Moneda'])
      ACN(g:fac,FBN['Monto'])
      ACN(h:fac,FBN['Monto']*Val(tp20))
      ACT(i:fac,fbn['TipoCV'])
      ACT(j:fac,fbn['NrOperacion'])
      ACT(k:fac,fbn['Especie'])
      ACT(l:fac,fbn['Emision'])
      ACT(m:fac,fbn['Cliente'])
      if Vacio(FBN['Provincia']) o Vacio(fbn['CodComitente']) o Vacio(fbn['Pais']) o Vacio(fbn['PaisAFIP'])
         ACT(n:fac,'Verifique dato Pais/Provincia/CodComitente' )
      Endif
      
      SCN(po:1,FBN['Monto'])
      SCN(po:2,Val(h:fac))
      ACT(bl:fac,fbn['Pase'])
      *ACT(r:fac,fbn['Emision'])
      *ACT(s:fac,fbn['Exencion'])      
      ACT(aa:fac,FBN['RazonSocial'])
      ACT(ac:fac,ReemplazarStr(FBN('CUIT'),'-','',SI))
      #ifdef MLASA
         **CI:C.D.I|CIL:CUIL|CUI:CUIT|FCI:Fondo Comun De inv.CIE:C.I.E
         IF EqStr(FBN['TipoInscripcion'],'CDI')
            ACT(ab:fac,'87')
         else
            If EqStr(FBN['TipoInscripcion'],'CIL')   
               ACT(ab:fac,'86')
            else
            If EqStr(FBN['TipoInscripcion'],'CIT')   
                  ACT(ab:fac,'80')
               else
                  If EqStr(FBN['TipoInscripcion'],'CIE')   
                     ACT(ab:fac,'88')
                  else
                     If EqStr(FBN['TipoInscripcion'],'FCI')   
                        ACT(ab:fac,'91')
                     else   
                        ACT(ab:fac,'00')
                     endif
                  endif
               endif    
            endif   
         Endif   
         ACT(ad:fac,Copy(FBN['Direccion'],1,30))
         ACT(ae:fac,FBN['Puerta'])
         ACT(aj:fac,'')
      #else
         ACT(ab:fac,IIF(EqStr(FBN['TipoCli'],'FONDO'),'91','80'))
         ACT(ad:fac,FBN['Calle'])
         ACT(ae:fac,FBN['Altura'])
         ACT(aj:fac,FBN['Piso'])
      #endif                  
      ACT(af:fac,'')
      ACT(ag:fac,'')
      ACT(ah:fac,'')
      ACT(ai:fac,'')
      ACT(ak:fac,FBN['Localidad'])
      ACT(al:fac,FBN['Provincia'])
      ACT(am:fac,FBN['CodigoPostal'])
      ACT(an:fac,fbn['CodComitente'])
      ACT(ao:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')) o EqStr(FBN['Pais'],Var('PAISARG')),'1','0'))
      ACT(ap:fac,IIF(EqStr(FBN['Persona'],'NO'),'2','1'))
      ACT(aq:fac,IIF(EqStr(FBN['TipoCli'],'FONDO'),'91','80'))
      ACT(ar:fac,ReemplazarStr(FBN('CUIT'),'-','',SI))
      ACT(as:fac,IIF(EqStr(FBN['Persona'],'NO'),'000',FBN['PaisInsc']))
      ACT(at:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')),'',''))
      ACT(au:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')) o EqStr(FBN['Pais'],Var('PAISARG')) o EqStr(FBN['Persona'],'NO'),'00000000',''))
      ACT(av:fac,'03')
      ACT(aw:fac,'')
      ACT(ax:fac,FBN['PaisInsc'])
      ACT(ay:fac,Copy(FBN['FechaInsc'],7,4)~Copy(FBN['FechaInsc'],4,2)~Copy(FBN['FechaInsc'],1,2))
      ACT(az:fac,Copy(FBN['Direccion'],1,50))
      ACT(ba:fac,FBN['Localidad'])
      ACT(bb:fac,FBN['Provincia'])
      ACT(bc:fac,FBN['PaisAFIP'])
      ACT(bd:fac,FBN['NIF'])
      ACT(be:fac,FBN['PaisAFIP'])
      ACT(bf:fac,FBN['CategDepositante'])
