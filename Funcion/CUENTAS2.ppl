VTXT15  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT16  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)
Cuenta4 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito  en')  ;19;1;2;NOT INCLUIDO(TIPOOP,'FXVF|FXCF');Not EV Y NoVacio(NROPERACION3) Y NOT INCLUIDO(TIPOOP,'FXVF|FXCF');Vacio(NROPERACION3) O [[CLIENTECUENTA(VEHICULO1,CUENTA4) y ESPECIECUENTA(ESPECIE,CUENTA4) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA4),'HAB')] y NOVACIO(CUENTA4)];"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito A','Debito  En')~"' "~ESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA4);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT15,Elementos(VTXT15))~"%')"     
Cuenta5 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  en','Credito a')  ;19;2;2;NOT INCLUIDO(TIPOOP,'FXVF|FXCF');Not EV Y NoVacio(NROPERACION3) Y NoVacio(CONTRAESPECIE) Y NOT INCLUIDO(TIPOOP,'FXVF|FXCF');Vacio(NROPERACION3) O Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA5) y [[CLIENTECUENTA(VEHICULO1,CUENTA5) y ESPECIECUENTA(CONTRAESPECIE,CUENTA5) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA5),'HAB')]]];"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  En','Credito A')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA5);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT16,Elementos(VTXT16))~"%')"     
