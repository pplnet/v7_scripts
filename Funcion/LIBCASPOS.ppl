    SQL.ADD("select ESPECIE,nombre,SUM(saldo) Saldo from ( ")
    SQL.ADD("SELECT S1.Especie, E.Nombre, SUM(S1.CantidadFin) Saldo ")
    SQL.ADD("FROM "~DBO~".POSICIONES S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                        ")
    SQL.ADD("WHERE S1.Cliente = C.Codigo AND                                                                           ")
    SQL.ADD("      S1.Cliente='"~Dialogo.Vehiculo1~"' AND                                                              ")
    SQL.ADD("      E.Codigo  = S1.Especie AND                                                                          ")
    SQL.ADD("      E.Tipo   <> 'MON'      AND                                                                          ")
    SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND                                                      ")
    SQL.ADD("      Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                    ")
    SQL.ADD("      S1.Vehiculo = '"~Dialogo.Vehiculo1~"' AND                                                           ")
    SQL.ADD("      S1.NrSaldo  = 171 and                                                                               ")
    SQL.ADD("      S1.CantidadFin <> 0 AND                                                                             ")
    SQL.ADD("      (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
    SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha)                                                                    ")
    SQL.ADD("                  FROM "~DBO~".POSICIONES S2                                                              ")
    SQL.ADD("                   WHERE S2.Especie   = S1.Especie                                                        ")
    SQL.ADD("                   AND   S2.Vehiculo  = S1.Vehiculo                                                       ")
    SQL.ADD("                   AND   S2.Cliente   = S1.Cliente                                                        ")
    SQL.ADD("                   AND   S2.NrSaldo   = S1.NrSaldo                                                        ")
    SQL.ADD("                   AND   S2.Book      = S1.Book                                                           ")
    SQL.ADD("                   AND   (S2.Cupon    = S1.Cupon    OR ((S2.Cupon    IS NULL OR S2.Cupon   ='' OR S2.Cupon   =' ') AND (S1.Cupon    IS NULL OR S1.Cupon   ='' OR S1.Cupon   =' ' )) )  ")
    SQL.ADD("                   AND   (S2.Sector   = S1.Sector   OR ((S2.Sector   IS NULL OR S2.Sector  ='' OR S2.Sector  =' ') AND (S1.Sector   IS NULL OR S1.Sector  ='' OR S1.Sector  =' ' )) )  ")
    SQL.ADD("                   AND   (S2.CallPut  = S1.CallPut  OR ((S2.CallPut  IS NULL OR S2.CallPut ='' OR S2.CallPut =' ') AND (S1.CallPut  IS NULL OR S1.CallPut ='' OR S1.CallPut =' ' )) )  ")
    SQL.ADD("                   AND   (S2.FechaEj  = S1.FechaEj  OR ((S2.FechaEj  IS NULL OR S2.FechaEj ='' OR S2.FechaEj =' ') AND (S1.FechaEj  IS NULL OR S1.FechaEj ='' OR S1.FechaEj =' ' )) )  ")
    SQL.ADD("                   AND   (S2.PrecioEj = S1.PrecioEj OR ((S2.PrecioEj IS NULL OR S2.PrecioEj='' OR S2.PrecioEj=' ') AND (S1.PrecioEj IS NULL OR S1.PrecioEj='' OR S1.PrecioEj=' ' )) )  ")
    SQL.ADD("                   AND   S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' )                                    ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre ")
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, -SUM(S1.Cantidad) Saldo        ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TIPP')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaPago <= "~idxdate2(Dialogo.Fecha1-1)~"        ")
    *VTO FUT
    SQL.ADD(" AND   S1.FechaVto2  > "~idxdate2(Dialogo.Fecha1-1)~"        ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, SUM(S1.Cantidad) Saldo         ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TIPA')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaPago <= "~idxdate2(Dialogo.Fecha1-1)~"        ")
    *VTO FUT
    SQL.ADD(" AND   S1.FechaVto2  > "~idxdate2(Dialogo.Fecha1-1)~"        ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    ** AA 05/09/2024 se incorpora TIPO TIDE TICO TICT 
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, -SUM(S1.Cantidad) Saldo        ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TIPO')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaOp <= "~idxdate2(Dialogo.Fecha1-1)~"          ")
    *VTO VTO o Precancelacion
    SQL.ADD(" AND   IsNull(S1.FechaPrecan,S1.FechaVto)  > "~idxdate2(Dialogo.Fecha1-1)~"  ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, SUM(S1.Cantidad) Saldo         ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TIDE')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaOp <= "~idxdate2(Dialogo.Fecha1-1)~"          ")
    *VTO VTO o Precancelacion
    SQL.ADD(" AND   IsNull(S1.FechaPrecan,S1.FechaVto)  > "~idxdate2(Dialogo.Fecha1-1)~"  ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, -SUM(S1.Cantidad) Saldo        ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TICO')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaOp <= "~idxdate2(Dialogo.Fecha1-1)~"          ")
    *VTO VTO o Precancelacion
    SQL.ADD(" AND   IsNull(S1.FechaPrecan,S1.FechaVto)  > "~idxdate2(Dialogo.Fecha1-1)~"  ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    SQL.ADD("UNION ALL ")
    SQL.ADD(" SELECT S1.Especie, E.Nombre, SUM(S1.Cantidad) Saldo         ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".ESPECIES E             ")
    SQL.ADD(" WHERE S1.Especie   = E.Codigo                               ")
    SQL.ADD(" AND   E.Tipo      <> 'MON'                                  ")
    SQL.ADD(" AND   S1.TipoOp IN ('TICT')                                 ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaOp <= "~idxdate2(Dialogo.Fecha1-1)~"          ")
    *VTO VTO o Precancelacion 
    SQL.ADD(" AND   IsNull(S1.FechaPrecan,S1.FechaVto)  > "~idxdate2(Dialogo.Fecha1-1)~"  ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre                                ")
    ** AA 05/09/2024 se eliminan registros saldo 0 
    if no
    SQL.ADD("UNION ALL ")
    SQL.ADD("SELECT Distinct S1.Especie, E.Nombre,  '0' Saldo  ")
    SQL.ADD("FROM   "~DBO~".MOVPOSPEN S1, "~DBO~".ESPECIES E                                                 ")
    SQL.ADD("WHERE  S1.Cliente='"~Dialogo.Vehiculo1~"' AND                                                                       ")
    SQL.ADD("       E.Codigo = S1.Especie AND                                                                                    ")
    SQL.ADD("       E.Tipo      <> 'MON'               AND                                                                       ")
    SQL.ADD("       E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND                                                               ")
    SQL.ADD("       Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                             ")
    SQL.ADD("       S1.Vehiculo = '"~Dialogo.Vehiculo1~"' AND                                                                    ")
    SQL.ADD("       S1.NrSaldo  = 171 and                                                                                        ")
    SQL.ADD("       S1.Cantidad <> 0 AND                                                                                         ")
    SQL.ADD("       (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
    SQL.ADD("       S1.FechaMov = "~idxdate2(Dialogo.Fecha1)~"                                                                 ")
    SQL.ADD("UNION ALL ")
    SQL.ADD("SELECT Distinct S1.Especie, E.Nombre,  '0' Saldo ")
    SQL.ADD("FROM   "~DBO~".MOVPOSEJE S1, "~DBO~".ESPECIES E                                                 ")
    SQL.ADD("WHERE  S1.Cliente='"~Dialogo.Vehiculo1~"'           AND                                                             ")
    SQL.ADD("       E.Codigo = S1.Especie                        AND                                                             ")
    SQL.ADD("       E.Tipo      <> 'MON'                         AND                                                             ")
    SQL.ADD("       E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'    AND                                                             ")
    SQL.ADD("       Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                             ")
    SQL.ADD("       S1.Vehiculo = '"~Dialogo.Vehiculo1~"'        AND                                                             ")
    SQL.ADD("       S1.NrSaldo  = 171                            AND                                                             ")
    SQL.ADD("       S1.Cantidad <> 0                             AND                                                             ")
    SQL.ADD("       (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
    SQL.ADD("       S1.FechaMov = "~idxdate2(Dialogo.Fecha1)~"                                                                 ")
    SQL.ADD("UNION ALL ")
    SQL.ADD("Select Especie, E.Nombre, 0 Saldo ")
    SQL.ADD("from  "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E,  "~DBO~".OPERACIONESBITS OB ")
    SQL.ADD(" where O.NrOperacion = OB.NrOperacion ")
    SQL.ADD("    and Especie = E.Codigo ")
    SQL.ADD("   and OB.Valor = 1 and OB.NrBit not in (30,31) ")
    SQL.ADD("   AND   E.Tipo      <> 'MON'                    ")
    SQL.ADD("   and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
    IF EqStr(VAR('LICILIBROS'),'SI')
       SQL.ADD("   and (O.TipoOp  in ('TIC','TIV') or (O.TipoOp = 'TCOPRI' and O.Corporate = 1))  ")
    ELSE
       SQL.ADD("   and O.TipoOp  in ('TIC','TIV')  ")
    ENDIF    
    SQL.ADD("UNION ALL ")
    SQL.ADD("select  Especie, E.Nombre, 0 Saldo ")
    SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E where TipoTr2 in ('DTP','RTP','DRT') ")
    SQL.ADD("    and (NrOperacionRef1 = '' or NrOperacionRef1 is Null) and (NrOperacionRef2 = '' or NrOperacionRef2 is Null) ")
    SQL.ADD("    and T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("    and T.Especie = E.Codigo ")
    SQL.ADD("    AND E.Tipo      <> 'MON'                    ")
    SQL.ADD("UNION ALL ")
    SQL.ADD("select  T.Especie, E.Nombre, 0 Saldo  ")
    SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ")
    *SQL.ADD("where TipoTr2 in ('CANJE','STOCK','PDIVID') ")
    SQL.ADD("where TipoTr2 in ('CANJE') ")
    SQL.ADD("    and M.NrOperacion = T.NrTrans ")
    SQL.ADD("    and T.Cambio5 = 101 ")
    SQL.ADD("    and T.Cliente1 = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD("    and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")    
    SQL.ADD("    and T.Especie = E.Codigo ")
    SQL.ADD("    AND E.Tipo      <> 'MON'                    ")
    ENDIF
    SQL.ADD("  ) as aux ")
    SQL.ADD("group by Especie,Nombre ")
    SQL.ADD("ORDER BY Especie ")
    watch(SQL.BATCH())
