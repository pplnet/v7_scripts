MostrarCuadroDeMensajes
scn(c:200,2)
scn(f:200,4)

*---- Compras => Otros Activos Ventas=> Otros Pasivos
*---- Opciones por la Prima en Fecha de Prima
SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaVto Fecha, O.MB3, ")
SQL.ADD("Sum(CASE O.MB3 When '0' Then -O.TotalNetoCli1 Else O.TotalNetoCli1 End)/1000 Cant from  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('DSEO','DFXO') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaVto,O.MB3 ")
*-- Opciones Net por el Resultado en Fecha de Ejercicio

SQL.ADD(" Union All ")

SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaVto2 Fecha, O.MB3, ")
SQL.ADD("Sum(Precio4)/1000 Cant from  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('DSEO','DFXO') ")
SQL.ADD(" and  O.RB10='0' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaVto2,O.MB3 ")
*---
if Dialogo.Radio3 = 1

   SQL.ADD(" Union All ")

   *-- Opciones por la Prima en Fecha de Prima OPSEVENTUALES
   SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaVto Fecha, O.MB3, ")
   SQL.ADD("Sum(CASE O.MB3 When '0' Then -O.TotalNetoCli1 Else O.TotalNetoCli1 End)/1000 Cant from  "~DBO~".ESPECIES E, "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.Especie = E.Codigo ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('DSEO','DFXO') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaVto,O.MB3 ")
   *-- Opciones Net por el Resultado en Fecha de Ejercicio

   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaVto2 Fecha, O.MB3, ")
   SQL.ADD("Sum(Precio4)/1000 Cant from  "~DBO~".ESPECIES E, "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.Especie = E.Codigo ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('DSEO','DFXO') ")
   SQL.ADD(" and  O.RB10='0' ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaVto2,O.MB3 ")
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
  Message('Opciones CashFlow '~Fstr(FBN['Cant'],0,2))
  *** Diario o Mensual ***
  ACN(MT:11, 0)
  IF Dialogo.Check1 = 1
     ACN(MT:12, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(mt50)))
     SCN(MT:11, fbn('Cant') * Val(MT:12))
  ENDIF
  if Dialogo.Radio2 = 0
     *** Diario ***
     Recorrer&i 2, val(d:200)-1
       if fbn['Fecha'] = val(&i:10)
          if Incluido(fbn['MB3'],'0')
             scn(&i:val(c:200), Val(MT:11))
             scn(&i:val(h:200), Val(MT:11))
          Else 
             scn(&i:val(f:200), Val(MT:11))
             scn(&i:val(i:200), Val(MT:11))
          EndIf
       endif
     Proximo
     Recorrer&i val(d:200)+1, val(g:200)-1
       if fbn['Fecha'] = val(&i:10)
          if Incluido(fbn['MB3'],'0')
             scn(&i:val(c:200), Val(MT:11))
             scn(&i:val(h:200), Val(MT:11))
          Else 
             scn(&i:val(f:200), Val(MT:11))
             scn(&i:val(i:200), Val(MT:11))
          EndIf
       endif
     Proximo
  else
     *** Mensual ***
     Recorrer&i val(m:200), val(n:200)
       if Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
          if Incluido(fbn['MB3'],'0')
             scn(&i:val(c:200), Val(MT:11))
             scn(&i:val(h:200), Val(MT:11))
          Else 
             scn(&i:val(f:200), Val(MT:11))
             scn(&i:val(i:200), Val(MT:11))
          EndIf
       Endif
     Proximo
     Recorrer&i val(o:200), val(p:200)
       if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) = val(&i:281)
          if Incluido(fbn['MB3'],'0')
             scn(&i:val(c:200), Val(MT:11))
             scn(&i:val(h:200), Val(MT:11))
          Else 
             scn(&i:val(f:200), Val(MT:11))
             scn(&i:val(i:200), Val(MT:11))
          EndIf
       Endif
     Proximo
     if val(o:200) > 0
        If Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) > val(val(p:200):281)
           If Incluido(fbn['MB3'],'0')
              scn(val(p:200)+1:val(c:200), Val(MT:11))
              scn(val(p:200)+1:val(h:200), Val(MT:11))
           Else 
              scn(val(p:200)+1:val(f:200), Val(MT:11))
              scn(val(p:200)+1:val(i:200), Val(MT:11))
           EndIf
        Endif
     Endif
     Recorrer&i val(d:200), val(g:200)
       If Anio(fbn['Fecha']) = val(&i:280)
          If Incluido(fbn['MB3'],'0')
             scn(&i:val(c:200), Val(MT:11))
             scn(&i:val(h:200), Val(MT:11))
           Else 
             scn(&i:val(f:200), Val(MT:11))
             scn(&i:val(i:200), Val(MT:11))
           EndIf
       Endif
     Proximo
     If Anio(fbn['Fecha']) > val(val(g:200):280)
        If Incluido(fbn['MB3'],'0')
           scn(val(g:200):val(c:200), Val(MT:11))
           scn(val(g:200):val(h:200), Val(MT:11))
        Else 
           scn(val(g:200):val(f:200), Val(MT:11))
           scn(val(g:200):val(i:200), Val(MT:11))
        EndIf
     Endif
  Endif
Proximo


