scn(f:200,1)
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD("C.Total2/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")

*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD("O.PrecioEj/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*----
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD("TotalBrutoCli1/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*--
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("C.Total2/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *--- Capital si FechaInicio<>FechaConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("O.PrecioEj/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *---
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("TotalBrutoCli1/1000 Cant from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *--- Capital si FechaInicio<>FechaConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *---
endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("C.Importe4/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM','MMPCL') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp, ,'Com' as Tipo,")
   SQL.ADD("C.Importe4/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM','MMPCL') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
endif

SQL.ADD("order by 1, 2 ")

Recorrer SQL
  *** Diario o Mensual ***
  if Dialogo.Radio2 = 0
     *** Diario ***
     Recorrer&i 2, val(d:200)-1
       if fbn['Fecha'] = val(&i:10)
          if EqStr(fbn['Especie'],'ARP')
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
            else
             scn(&i:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
          scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     Recorrer&i val(d:200)+1, val(g:200)-1
       if fbn['Fecha'] = val(&i:10)
          if EqStr(fbn['Especie'],'ARP')
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
            else
             scn(&i:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
          scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
    else
     *** Mensual ***
     Recorrer&i val(m:200), val(n:200)
       if Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
          if EqStr(fbn['Especie'],'ARP')
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
            else
             scn(&i:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
          scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     Recorrer&i val(o:200), val(p:200)
       if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) = val(&i:281)
          if EqStr(fbn['Especie'],'ARP')
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
            else
             scn(&i:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
          scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     if val(o:200) > 0
        if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) > val(val(p:200):281)
           if EqStr(fbn['Especie'],'ARP')
              scn(val(p:200)+1:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             else
              scn(val(p:200)+1:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
           scn(val(p:200)+1:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
        endif
     endif
     Recorrer&i val(d:200), val(g:200)
       if Anio(fbn['Fecha']) = val(&i:280)
          if EqStr(fbn['Especie'],'ARP')
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
            else
             scn(&i:val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
          scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     if Anio(fbn['Fecha']) > val(val(g:200):280)
        if EqStr(fbn['Especie'],'ARP')
           scn(val(g:200):val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          else
           scn(val(g:200):val(f:200)+1,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
        endif
        scn(val(g:200):val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
     endif
  endif
proximo

scn(f:200,2)

SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo,")
SQL.ADD("C.Total2/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
**--- Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
**--
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo,")
SQL.ADD("TotalBrutoCli1/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp  <> O.FechaOp2 ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*--
SQL.ADD(" Union All ")
* Listo los SIMV que no son definitivos por el capital no amoritzado para la fecha de
* de Vto Final
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' Tipo, ")
SQL.ADD(" (O.Cantidad-SUM(C.Cantidad4))/1000 Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMSIMV') ")
SQL.ADD(" and  O.RB5='1' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Group By O.Vehiculo1, O.Especie, O.FechaVto, O.NrOperacion, O.TipoOp,O.Cantidad ")
SQL.ADD(" Union All ")
*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Vto' Tipo, ")
SQL.ADD(" PrecioEj/1000 Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp <> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMSIMV') ")
SQL.ADD(" and  O.RB5='1' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
*-----
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' Tipo, ")
   SQL.ADD("C.Total2/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *--- Capital si FInicio<>FConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *---
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("TotalBrutoCli1/1000 Cant from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   *--- Capital si FInicio<>FConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp2 <> O.FechaOp2 ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("C.Importe4/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" (O.TipoOp In ('MMPOSM','MMSIMV','MMPCOS','MMPSI')) or ")
SQL.ADD(" (O.TipoOp In ('MMSIMV') and O.RB5='1') ") 
SQL.ADD(" ) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD("C.Importe4/1000 Cant from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ( ")
   SQL.ADD(" (O.TipoOp In ('MMPOSM','MMSIMV','MMPCOS','MMPSI')) or ")
   SQL.ADD(" (O.TipoOp In ('MMSIMV') and O.RB5='1') ") 
   SQL.ADD(" ) ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
endif
SQL.ADD("order by 1,2,4,6 ")
act(m:201,'')

Recorrer SQL

  *** Diario o Mensual ***
  if Dialogo.Radio2 = 0
     *** Diario ***
     *-- Ajuste por Capital si FInicio<>FConcertacion
     IF EqStr(FBN['Tipo'],'Cap')
        Recorrer&i 2, val(d:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
        Proximo       
        *-- af201: Nro. de Operacion que Mostro Capital
        act(af:201,FBN['NrOperacion'])
     Else     
        Recorrer&i 2, val(d:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))

             *-- af201: Nro. de Operacion que Mostro Capital
             If EqStr(Val(af:201),FBN['NrOperacion'])
                scn(&i:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             EndIf
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             *-- af201: Nro. de Operacion que Mostro Capital
             If EqStr(Val(af:201),FBN['NrOperacion'])
                scn(&i:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             EndIf
          endif
        Proximo
     EndIf
  Else
     *-- Ajuste por Capital si FInicio<>FConcertacion
     IF EqStr(FBN['Tipo'],'Cap')
MessageBox('Capital')
        Recorrer&i 2, val(d:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
        Proximo       
        *-- m201: Nro. de Operacion que Mostro Capital
        act(af:201,FBN['NrOperacion'])
     Else
        *** Mensual ***
        Recorrer&i val(m:200), val(n:200)
          If Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))

             *-- af201: Nro. de Operacion que Mostro Capital
             If EqStr(Val(af:201),FBN['NrOperacion'])
                scn(&i:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             EndIf
          Endif
        Proximo
        Recorrer&i val(o:200), val(p:200)
          if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) = val(&i:281)
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))

             *-- af201: Nro. de Operacion que Mostro Capital
             If EqStr(Val(af:201),FBN['NrOperacion'])
                scn(&i:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             EndIf
          endif
        Proximo
        If val(o:200) > 0
           if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) > val(val(p:200):281)
              scn(val(p:200)+1:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(val(p:200)+1:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
    
              *-- af201: Nro. de Operacion que Mostro Capital
              If EqStr(Val(af:201),FBN['NrOperacion'])
                 scn(val(p:200)+1:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              EndIf
           endif
        Endif
        Recorrer&i val(d:200), val(g:200)
          if Anio(fbn['Fecha']) = val(&i:280)
             scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))

             *-- af201: Nro. de Operacion que Mostro Capital
             If EqStr(Val(af:201),FBN['NrOperacion'])
                scn(&i:val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             EndIf
          endif
        Proximo
        if Anio(fbn['Fecha']) > val(val(g:200):280)
           scn(val(g:200):val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           scn(val(g:200):val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))

           *-- af201: Nro. de Operacion que Mostro Capital
           If EqStr(Val(af:201),FBN['NrOperacion'])
              scn(val(g:200):val(af:200),-fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
           EndIf
        endif
     endif
  endif
proximo

