***---Operaciones a Plazo unico vto., Overnigths, Remuneradas y MMDCA-MMD-MMCDIA-MMCDP
SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaVto Vto, O.Cantidad Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa,  ")
SQL.ADD(" CASE O.TipoOp WHEN  'MMCP  ' THEN 'COLOC. PLAZO' WHEN  'MMO   ' THEN 'OVERNIGHTS' WHEN  'MMCCR ' THEN 'CTA CTE REMUNERADA' END Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMCP','MMDCA','MMO','MMD','MMCDIA','MMCCR','MMCDP') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND O.Cantidad > 0 ")

SQL.ADD(" UNION ")

***---Collaterals y Vinculadas
SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaVto Vto, O.Cantidad Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa,  ")
SQL.ADD(" CASE O.TipoOp WHEN 'TEMIND' THEN 'COLLATERAL' ELSE 'COLOCACIONES VINCULADAS' END Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where ((O.TipoOp = 'MMPCCV' AND O.MB3 = 1) ")
SQL.ADD("         OR O.TipoOp IN ('VIMIND','VIMINM','TEMIND') AND O.MB3=0) ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND O.Cantidad > 0 ")

SQL.ADD(" UNION ")

***---Plazo Multiple Vto.
SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaVto Vto, C.Cantidad2 Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMCPM ' THEN 'COLOC. PLAZO' ELSE  'COLOCACIONES VINCULADAS' END Grupo, ")
