SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND M.FechaMov <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND M.Cantidad <> 0 ")

SQL.ADD(" UNION ")

***---ContraEspecie Pendientes
SQL.ADD(" Select O.Vehiculo1 Clave, M.Especie, M.FechaMov Vto, M.Cantidad Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa, 'FX-CONTRAESPECIE' Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND ((O.TipoOp IN ('FXCS','FXCSV','FXVS','FXVSV','FXCT','FXVT') AND O.Especie Not IN ("~Pipe2Comillas(Var('BGOBNAC'))~")) ")
SQL.ADD("       OR (O.TipoOp IN ('FXAS','FXAT') AND O.Especie Not IN ("~Pipe2Comillas(Var('BGOBNAC'))~") AND O.ContraEspecie Not IN("~Pipe2Comillas(Var('BGOBNAC'))~"))) ")
SQL.ADD(" AND O.ContraEspecie = M.Especie ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND M.NrMov = 2 ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND M.FechaMov <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND M.Cantidad <> 0 ")

****************************************************************************************
***---Fondos

SQL.ADD(" UNION ")
***---CuotasPartes
SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaOp Vto, CASE O.TipoOp WHEN 'FCS   ' THEN -O.Cantidad ELSE  O.Cantidad END Importe, ")
SQL.ADD(" O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa,  ")
SQL.ADD(" 'FONDOS-CUOTASPARTE' Grupo, O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('FCS','FCR') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND O.Cantidad <> 0 ")

SQL.ADD(" UNION ")

***---Efectivo
SQL.ADD(" Select O.Vehiculo1 Clave, O.ContraEspecie Especie, O.FechaOp Vto, ")
SQL.ADD(" CASE O.TipoOp WHEN 'FCS   ' THEN O.TotalNetoCli1 ELSE -O.TotalNetoCli1 END Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa, 'FONDOS-MONEDA' Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('FCS','FCR') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND O.Cantidad <> 0 ")