SQL.ADD(" UNION ")
***---Securities
***---Titulos Ejecutados
SQL.ADD(" Select O.Vehiculo1 Clave, M.Especie, M.FechaMov Vto, M.Cantidad Importe, O.NrOperacion, ")
SQL.ADD(" O.TipoOp, ' ' as DescImp, 0 as BD1, O.Cliente1, O.TipoTasa, 'SE-TITULOS' Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND (O.TipoOp IN ('SECS','SEVS','SECT','SEVT','SERA','SERP') ")
SQL.ADD("      OR (O.TipoOp IN ('FXCS','FXCSV','FXVS','FXVSV','FXCT','FXVT') AND O.Especie IN ("~Pipe2Comillas(Var('BGOBNAC'))~")) ")
***---Si es arbitraje, puede tener el titulo Como especie o Contraespecie
SQL.ADD("      OR ((M.NrMov = 1 OR M.NrMov = 2) AND O.TipoOp IN ('FXAS','FXAT') AND (O.Especie IN ("~Pipe2Comillas(Var('BGOBNAC'))~") OR O.ContraEspecie IN ("~Pipe2Comillas(Var('BGOBNAC'))~")))) ")
***---Especie Titulo o Arbitrajes con ContraEspecie Titulo
SQL.ADD(" AND ((O.Especie = M.Especie AND (dbo.DESCIENDEDEESPECIE(O.Especie,'TITULO') = 1 OR O.Especie IN ("~Pipe2Comillas(Var('BGOBNAC'))~"))) ")
SQL.ADD("       OR (O.ContraEspecie = M.Especie AND O.ContraEspecie IN ("~Pipe2Comillas(Var('BGOBNAC'))~"))) ")
SQL.ADD(" AND M.NrSaldo = 1 ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND M.FechaMov <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND M.Cantidad <> 0 ")

SQL.ADD(" UNION ")

