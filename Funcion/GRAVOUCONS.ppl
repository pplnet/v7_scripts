if Round(Val(rr:17),2)<>0 o Round(Val(rr:18),2)<>0
   acn(xx:1,0)
   SQL.ADD("SELECT * FROM "~DBO~".VOUCONSOLIDADOS      ")
   SQL.ADD("WHERE Cliente='"~Val(rr:19)~"'             ")
   SQL.ADD("and Cuenta='"~Val(rr:20)~"'                ")
   SQL.ADD("and Especie='"~Val(rr:21)~"'               ")
   SQL.ADD("and Mercado='"~Val(rr:25)~"'               ")
*   SQL.ADD("and Tipo in('LIQNET','CUP','LIQEPA','LIQ','STOCK1','PDIVID','CANJE2','ACCION','CAMEST') ")
   SQL.ADD("and Tipo in('CUP','STOCK1','PDIVID','CANJE2','ACCION','CAMEST') ")
   if Eqstr(val(rr:26),'CUP')
      SQL.ADD("and RefCorte='"~Val(rr:34)~"'           ")
   endif
   SQL.ADD("and Estado='NOK'                           ")
   SQL.ADD("and Fecha="~IdxDate2(FSys)                  )
   SQL.ADD("and FechaValor="~IdxDate2(Dialogo.Fecha1)   )
   watch(SQL.BATCH())   
   Recorrer SQL
      acn(xx:1, FBN['Id'])
      act(xx:2, FBN['Accion'])
      if Eqstr(Val(xx:2),'CR')
         acn(xx:3,1)
      else
         acn(xx:3,-1)
      endif
      * Montos grabados previamente
      acn(xx:4, FBN['MontoABloquear'])
      acn(xx:5, FBN['MontoADebCred'] )
      
      acn(xx:6, FBN['MontoBloqueado'])
      acn(xx:7, FBN['MontoDebCred']  )
      * General
      acn(xx:8, FBN['Capital']       * val(xx:3))
*      acn(xx:9, FBN['Comisiones']    * val(xx:3))
*      acn(xx:10,FBN['Derechos']      * val(xx:3))
*      acn(xx:11,FBN['Iva']           * val(xx:3))
      acn(xx:9, ABS(FBN['Comisiones']))
      acn(xx:10,ABS(FBN['Derechos']))
      acn(xx:11,ABS(FBN['Iva']))
      acn(xx:12,FBN['Intereses']      * val(xx:3))
      * Accion
      acn(xx:18,FBN['CapAccion']     * val(xx:3))
*      acn(xx:19,FBN['ComAccion']     * val(xx:3))
*      acn(xx:20,FBN['DerAccion']     * val(xx:3))
*      acn(xx:21,FBN['IvaAccion']     * val(xx:3))
      acn(xx:19,ABS(FBN['ComAccion']))
      acn(xx:20,ABS(FBN['DerAccion']))
      acn(xx:21,ABS(FBN['IvaAccion']))
      acn(xx:22,FBN['IntAccion']     * val(xx:3))
      * Cupon
      acn(xx:28,FBN['CapCupon']      * val(xx:3))
*      acn(xx:29,FBN['ComCupon']      * val(xx:3))
*      acn(xx:30,FBN['DerCupon']      * val(xx:3))
*      acn(xx:31,FBN['IvaCupon']      * val(xx:3))
      acn(xx:29,ABS(FBN['ComCupon']))
      acn(xx:30,ABS(FBN['DerCupon']))
      acn(xx:31,ABS(FBN['IvaCupon']))
      acn(xx:32,FBN['IntCupon']      * val(xx:3))
      * Camest
      acn(xx:38,FBN['CapCamest']     * val(xx:3))
*      acn(xx:39,FBN['ComCamest']     * val(xx:3))
*      acn(xx:40,FBN['DerCamest']     * val(xx:3))
*      acn(xx:41,FBN['IvaCamest']     * val(xx:3))
      acn(xx:39,ABS(FBN['ComCamest']))
      acn(xx:40,ABS(FBN['DerCamest']))
      acn(xx:41,ABS(FBN['IvaCamest']))
      acn(xx:42,FBN['IntCamest']     * val(xx:3))
      
      act(xx:13,FBN['CodEvento'])
      act(xx:14,FBN['Referencia'])
      act(xx:15,FBN['RefCorte'])
      act(xx:16,FBN['RefAccion'])
      act(xx:17,FBN['RefCamest'])
      
      *Para poder ponderar el porducto
      acn(xx:304, ABS(FBN['MontoABloquear']))
      acn(xx:305, ABS(FBN['MontoADebCred'] ))
      acn(xx:306, ABS(FBN['MontoBloqueado']))
      acn(xx:307, ABS(FBN['MontoDebCred']  ))

      * Parámetro de salida
      acn(rr:9,FBN['Id'])
   Proximo   
   if Val(xx:1)=0
      if Vacio(rr:1)
         ACT(rr:1,'NOK')
      endif
      if Val(rr:18)<0
         * Debito de Saldo
         ACT(rr:24, 'DB')
      else   
         if Val(rr:18)>0
            * Credito de Saldo
            ACT(rr:24, 'CR')
         endif
      endif
      SQL.ADD("INSERT INTO "~DBO~".VOUCONSOLIDADOS (")
      SQL.ADD(" Cliente, Cuenta, DetalleError, IdRespuesta, RefCorte, RefAccion,")
      SQL.ADD(" Accion, Estado,")
      SQL.ADD(" Modulo, Sucursal, Transaccion, FechaCont, Relacion,             ")
      SQL.ADD(" Fecha, FechaValor, Especie, Referencia, Mercado, Tipo,          ")
      SQL.ADD(" MontoABloquear, MontoADebCred, MontoBloqueado, MontoDebCred,    ")
      SQL.ADD(" Capital, Comisiones, Derechos, Iva, Intereses, CodEvento,       ")
      SQL.ADD(" CapCupon, ComCupon, DerCupon, IvaCupon, IntCupon,               ")
      SQL.ADD(" CapAccion, ComAccion, DerAccion, IvaAccion, IntAccion,          ")
      ** FJL 03/08/22 - Campos CAMEST
      SQL.ADD(" RefCamest,  ")
      SQL.ADD(" CapCamest, ComCamest, DerCamest, IvaCamest, IntCamest ")
      SQL.ADD(" ) VALUES (  ")
      SQL.ADD("'"~Val(rr:19)~"','"~Val(rr:20)~"','"~Val(rr:2)~"','"~val(rr:3)~"','"~val(rr:34)~"', '"~val(rr:35)~"',")
      SQL.ADD("'"~Val(rr:24)~"','"~Val(rr:1)~"',")
      SQL.ADD("'"~Val(rr:4)~"','"~Val(rr:5)~"', '"~Val(rr:6)~"', '"~Val(rr:101)~"','"~Val(rr:8)~"',")
      SQL.ADD(IdxDate2(FSys)~", "~IdxDate2(Dialogo.Fecha1)~", '"~Val(rr:21)~"', '"~Val(rr:10)~"',  '"~Val(rr:25)~"',  '"~Val(rr:26)~"',")
      SQL.ADD(Fstr(Val(rr:17),0,2)~", "~Fstr(Val(rr:18),0,2)~", "~Fstr(Val(rr:22),0,2)~", "~Fstr(Val(rr:23),0,2)~",")
      SQL.ADD(Fstr(Val(rr:27),0,2)~", "~Fstr(Val(rr:28),0,2)~", "~Fstr(Val(rr:29),0,2)~", "~Fstr(Val(rr:30),0,2)~","~Fstr(Val(rr:31),0,2)~",'"~Val(rr:32)~"',")
      SQL.ADD(Fstr(Val(rr:57),0,2)~", "~Fstr(Val(rr:58),0,2)~", "~Fstr(Val(rr:59),0,2)~", "~Fstr(Val(rr:60),0,2)~","~Fstr(Val(rr:61),0,2)~", ")
      SQL.ADD(Fstr(Val(rr:47),0,2)~", "~Fstr(Val(rr:48),0,2)~", "~Fstr(Val(rr:49),0,2)~", "~Fstr(Val(rr:50),0,2)~","~Fstr(Val(rr:51),0,2)~", ")
      ** FJL 03/08/22 - Campos CAMEST
      SQL.ADD(" '"~Val(rr:41)~"', ")
      SQL.ADD(Fstr(Val(rr:67),0,2)~", "~Fstr(Val(rr:68),0,2)~", "~Fstr(Val(rr:69),0,2)~", "~Fstr(Val(rr:70),0,2)~","~Fstr(Val(rr:71),0,2)~" ")
      SQL.ADD(" ) ")
      SQL.NEW
      SQL.EXEC
      
      acn(rr:9,SQL("SELECT MAX(Id) FROM "~DBO~".VOUCONSOLIDADOS WHERE Fecha="~IdxDate2(FSys)))
      
   else
      if val(rr:18)>0
         acn(xx:33,1)
      else
         acn(xx:33,-1)
      endif   
      acn(xx:104, Val(rr:17))
      acn(xx:105, Val(rr:18))
      acn(xx:106, Val(rr:22))
      acn(xx:107, Val(rr:23))
      * General
      acn(xx:108, Num(Val(rr:27)) * val(xx:33))
*      acn(xx:109, Num(Val(rr:28)) * val(xx:33))
*      acn(xx:110, Num(Val(rr:29)) * val(xx:33))
*      acn(xx:111, Num(Val(rr:30)) * val(xx:33))
      acn(xx:109, Num(Val(rr:28)))
      acn(xx:110, Num(Val(rr:29)))
      acn(xx:111, Num(Val(rr:30)))
      acn(xx:112, Num(Val(rr:31)) * val(xx:33))
      * Accion
      acn(xx:118, Num(Val(rr:47)) * val(xx:33))
*      acn(xx:119, Num(Val(rr:48)) * val(xx:33))
*      acn(xx:120, Num(Val(rr:49)) * val(xx:33))
*      acn(xx:121, Num(Val(rr:50)) * val(xx:33))
      acn(xx:119, Num(Val(rr:48)))
      acn(xx:120, Num(Val(rr:49)))
      acn(xx:121, Num(Val(rr:50)))
      acn(xx:122, Num(Val(rr:51)) * val(xx:33))
      * Cupon
      acn(xx:128, Num(Val(rr:57)) * val(xx:33))
*      acn(xx:129, Num(Val(rr:58)) * val(xx:33))
*      acn(xx:130, Num(Val(rr:59)) * val(xx:33))
*      acn(xx:131, Num(Val(rr:60)) * val(xx:33))
      acn(xx:129, Num(Val(rr:58)))
      acn(xx:130, Num(Val(rr:59)))
      acn(xx:131, Num(Val(rr:60)))
      acn(xx:132, Num(Val(rr:61)) * val(xx:33))
      * Camest
      acn(xx:138, Num(Val(rr:67)) * val(xx:33))
*      acn(xx:139, Num(Val(rr:68)) * val(xx:33))
*      acn(xx:140, Num(Val(rr:69)) * val(xx:33))
*      acn(xx:141, Num(Val(rr:70)) * val(xx:33))
      acn(xx:139, Num(Val(rr:68)))
      acn(xx:140, Num(Val(rr:69)))
      acn(xx:141, Num(Val(rr:70)))
      acn(xx:142, Num(Val(rr:71)) * val(xx:33))

      acn(xx:204, val(xx:4)+val(xx:104))
      acn(xx:205, val(xx:5)+val(xx:105))
      acn(xx:206, val(xx:6)+val(xx:106))
      acn(xx:207, val(xx:7)+val(xx:107))
      
      acn(xx:208, ABS(val(xx:8)+val(xx:108)))
      acn(xx:209, ABS(val(xx:9)+val(xx:109)))
      acn(xx:210, ABS(val(xx:10)+val(xx:110)))
      acn(xx:211, ABS(val(xx:11)+val(xx:111)))
      acn(xx:212, ABS(val(xx:12)+val(xx:112)))
      * Accion
      acn(xx:218, ABS(val(xx:18)+val(xx:118)))
      acn(xx:219, ABS(val(xx:19)+val(xx:119)))
      acn(xx:220, ABS(val(xx:20)+val(xx:120)))
      acn(xx:221, ABS(val(xx:21)+val(xx:121)))
      acn(xx:222, ABS(val(xx:22)+val(xx:122)))
      * Cupon
      acn(xx:228, ABS(val(xx:28)+val(xx:128)))
      acn(xx:229, ABS(val(xx:29)+val(xx:129)))
      acn(xx:230, ABS(val(xx:30)+val(xx:130)))
      acn(xx:231, ABS(val(xx:31)+val(xx:131)))
      acn(xx:232, ABS(val(xx:32)+val(xx:132)))
      * Camest
      acn(xx:238, ABS(val(xx:38)+val(xx:138)))
      acn(xx:239, ABS(val(xx:39)+val(xx:139)))
      acn(xx:240, ABS(val(xx:40)+val(xx:140)))
      acn(xx:241, ABS(val(xx:41)+val(xx:141)))
      acn(xx:242, ABS(val(xx:42)+val(xx:142)))
      
      * Pondera el producto
      if val(xx:305)>abs(Val(rr:18))
         act(xx:213,val(xx:13))
      else
         act(xx:213,Val(rr:32))
      endif
      
      * Reasigna las variables para seguir como antes
      IF Not Eqstr(Trim(val(xx:14)),Trim(val(rr:10)))
         act(rr:10,val(xx:14)~val(rr:10))
      Endif   
      acn(rr:17,Val(xx:204))
      acn(rr:18,Val(xx:205))
      
      acn(rr:22,Val(xx:206))
      acn(rr:23,Val(xx:207))
      * General
      acn(rr:27,Val(xx:208))
      acn(rr:28,Val(xx:209))
      acn(rr:29,Val(xx:210))
      acn(rr:30,Val(xx:211))
      acn(rr:31,Val(xx:212))
      act(rr:32,Val(xx:213))
      IF Not Eqstr(Trim(val(xx:15)),Trim(val(rr:34)))
         act(rr:34,val(xx:15)~val(rr:34))
      endif   
      IF Not Eqstr(Trim(val(xx:16)),Trim(val(rr:35)))
         act(rr:35,val(xx:16)~val(rr:35))
      endif
      IF Not Eqstr(Trim(val(xx:17)),Trim(val(rr:41)))
         act(rr:41,val(xx:17)~val(rr:41))
      Endif   
      * Accion
      acn(rr:47,Val(xx:218))
      acn(rr:48,Val(xx:219))
      acn(rr:49,Val(xx:220))
      acn(rr:50,Val(xx:221))
      acn(rr:51,Val(xx:222))
      * Cupon
      acn(rr:57,Val(xx:228))
      acn(rr:58,Val(xx:229))
      acn(rr:59,Val(xx:230))
      acn(rr:60,Val(xx:231))
      acn(rr:61,Val(xx:232))
      * Camest
      acn(rr:67,Val(xx:238))
      acn(rr:68,Val(xx:239))
      acn(rr:69,Val(xx:240))
      acn(rr:70,Val(xx:241))
      acn(rr:71,Val(xx:242))
      
      
      SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS ")
      SQL.ADD("   SET                         ")
      SQL.ADD("       MontoABloquear= "~FSTR(val(rr:17),0,2)~", ")
      SQL.ADD("       MontoADebCred = "~FSTR(val(rr:18),0,2)~", ")
      SQL.ADD("       MontoBloqueado= "~FSTR(val(rr:22),0,2)~", ")
      SQL.ADD("       MontoDebCred  = "~FSTR(val(rr:23),0,2)~", ")
      SQL.ADD("       Capital       = "~FSTR(val(rr:27),0,2)~", ")
      SQL.ADD("       Comisiones    = "~FSTR(val(rr:28),0,2)~", ")
      SQL.ADD("       Derechos      = "~FSTR(val(rr:29),0,2)~", ")
      SQL.ADD("       Iva           = "~FSTR(val(rr:30),0,2)~", ")
      SQL.ADD("       Intereses     = "~FSTR(val(rr:31),0,2)~", ")
      SQL.ADD("       CapAccion     = "~FSTR(val(rr:47),0,2)~", ")
      SQL.ADD("       ComAccion     = "~FSTR(val(rr:48),0,2)~", ")
      SQL.ADD("       DerAccion     = "~FSTR(val(rr:49),0,2)~", ")
      SQL.ADD("       IvaAccion     = "~FSTR(val(rr:50),0,2)~", ")
      SQL.ADD("       IntAccion     = "~FSTR(val(rr:51),0,2)~", ")
      SQL.ADD("       CapCupon      = "~FSTR(val(rr:57),0,2)~", ")
      SQL.ADD("       ComCupon      = "~FSTR(val(rr:58),0,2)~", ")
      SQL.ADD("       DerCupon      = "~FSTR(val(rr:59),0,2)~", ")
      SQL.ADD("       IvaCupon      = "~FSTR(val(rr:60),0,2)~", ")
      SQL.ADD("       IntCupon      = "~FSTR(val(rr:61),0,2)~", ")
      SQL.ADD("       CapCamest     = "~FSTR(val(rr:67),0,2)~", ")
      SQL.ADD("       ComCamest     = "~FSTR(val(rr:68),0,2)~", ")
      SQL.ADD("       DerCamest     = "~FSTR(val(rr:69),0,2)~", ")
      SQL.ADD("       IvaCamest     = "~FSTR(val(rr:70),0,2)~", ")
      SQL.ADD("       IntCamest     = "~FSTR(val(rr:71),0,2)~", ")
      SQL.ADD("       Referencia    ='"~val(rr:10)~"', ")
      SQL.ADD("       RefCorte      ='"~val(rr:34)~"', ")
      SQL.ADD("       RefAccion     ='"~val(rr:35)~"', ")
      SQL.ADD("       RefCamest     ='"~val(rr:41)~"', ")
      SQL.ADD("       CodEvento     ='"~val(xx:213)~"' ")
      SQL.ADD("WHERE Id="~FSTR(val(xx:1),1,0))
      SQL.New
      SQL.Exec
   endif   
Endif
