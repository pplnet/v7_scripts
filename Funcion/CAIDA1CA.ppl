***---Operaciones MM
***********************************************************************************************
***---Imp. Interes y al Deposito en Caja de Ahorro
SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaVto Vto, O.TotalRetenciones Importe, ")
SQL.ADD(" O.NrOperacion, O.TipoOp, CASE O.TipoOp WHEN 'MMDCA ' THEN 'IMP.DEP.CAJA AHORRO' ELSE 'IMP. INTERES' END DescImp, ")
SQL.ADD(" 2 as BD1, O.Cliente1, O.TipoTasa, CASE O.TipoOp WHEN 'MMCP  '  THEN 'COLOC. PLAZO' WHEN  'MMCCR ' THEN 'CTA CTE REMUNERADA' END Grupo, ")
SQL.ADD(" O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMCP', 'MMCCR', 'MMDCA') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
SQL.ADD(" AND O.TotalRetenciones > 0 ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.Vehiculo1 Clave, O.Especie, O.FechaVto Vto, C.Cantidad4 Importe, ")
SQL.ADD(" O.NrOperacion, O.TipoOp, 'IMP. INTERES' as DescImp, 2 as BD1, O.Cliente1, O.TipoTasa, ")
SQL.ADD(" 'COLOC. PLAZO' Grupo, O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.TipoOp IN ('MMCPM') ")
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
