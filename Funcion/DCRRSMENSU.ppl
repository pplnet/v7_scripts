* DCRRSMENSUA - Resultado Reset Range Swap Mensual

Message("Calculando Resultado Reset Range Swap Mensual "~val(aa3)~" "~VAL(aa1)~"' al "~VAL(aa2))
  
SQL.ADD("SELECT * FROM "~DBO~".CURVAFUTUROSCOMM Where Especie='"~VAL(aa4)~"' and ")
SQL.ADD("Fecha>='"~IdxDate(VAL(aa1))~"' and Fecha<='"~IdxDate(VAL(aa2))~"' Order By Fecha")

*- pf1: Precio Promedio de dias que se ejercio a precio fijo
*- pr1: Precio Promedio de dias que se ejercio convirtiendose el FadeOut en Precio Fijo -> de Reset

acn(pf1,0)
acn(pr1,0)
acn(me1,0)
ACN(ab1,0)
ACN(ab2,0)
ACN(h:fac,0)

ACD(dm1,VAL(aa1))
ACD(dm2,VAL(aa1))

Recorrer SQL
   dfa
   If val(me1)<>Mes(FBN['Fecha'])
      If val(me1)>0
         *- ab1: Promedio de 1 mes 
         ACN(ab1,VAL(ab1)/VAL(ab2))

         Message('Promedio del Mes '~Fstr(val(me1),0,0)~' '~Fstr(val(ab1),0,2))

         *- Cuando Cambia el mes calculo el resultado
         If EqStr(val(z8),'1')   
            *- Producer 
            IF val(ab1)<val(z9) 
               acn(pr1,val(z9)-val(ab1))           
            Else 
               acn(pf1,val(z12)-val(ab1))            
            EndIf
         Else 
            *- Consumer
            IF val(ab1)>val(z9) 
               acn(pr1,val(ab1)-val(z9))            
            Else 
               acn(pf1,val(ab1)-val(z12))            
            EndIf
         EndIf

         acd(dm2,FinDeMes(val(dm1),SI))
         *- Calculo La ganancia Diaria : suma de resultados/Cantidad de Dias 
         If Incluido(val(z16),'BBLSD|BARRIL')
            ACN(Z2,(val(pr1)+val(pf1))*val(d:fac)*(val(dm2)-val(dm1)+1) )
         Else 
            ACN(Z2,(val(pr1)+val(pf1))*val(d:fac))
         EndIf

         Message('Resultado 1 '~Fstr(val(z2),0,2))
         SCN(h:fac,val(z2))

         ACN(ab1,0)
         ACN(ab2,0)
      EndIf

      acn(me1,Mes(FBN['Fecha']))
      acd(dm1,PriDeMes(FBN['Fecha'],SI))
   EndIf

   IF Not Incluido(VAL(aa3),VAR('PRECOMMFUT')) y FBN['PrecioCon']<>0 
      SCN(ab1,FBN['PrecioCon'])
   Else 
      SCN(ab1,FBN['PrecioFut'])
   EndIf

   SCN(ab2,1)
Proximo

If val(me1)>0
   *- ab1: Promedio de 1 mes 
   ACN(ab1,VAL(ab1)/VAL(ab2))
 
   *- Cuando Cambia el mes calculo el resultado
   If EqStr(val(z8),'1')   
      *- Producer 
      IF val(ab1)<val(z9) 
         acn(pr1,val(z9)-val(ab1))           
      Else 
         acn(pf1,val(z12)-val(ab1))            
      EndIf
   Else 
      *- Consumer
      IF val(ab1)>val(z9) 
         * Si el precio real esta por debajo del fade out 
         * el resultado por barril es = FadeOut - Precio Flotante
         acn(pr1,val(ab1)-val(z9))            
      Else 
         acn(pf1,val(ab1)-val(z12))            
      EndIf
   EndIf

   acd(dm2,FinDeMes(val(dm1),SI))

   *- Calculo La ganancia Diaria : suma de resultados/Cantidad de Dias 
   If Incluido(val(z16),'BBLSD|BARRIL')
      ACN(Z2,(val(pr1)+val(pf1))*val(d:fac)*(val(dm2)-val(dm1)+1) )
   Else 
      ACN(Z2,(val(pr1)+val(pf1))*val(d:fac))
   EndIf

   SCN(h:fac,val(z2))

   Message('Resultado 2 '~Fstr(val(z2),0,2))

   ACN(ab1,0)
   ACN(ab2,0)
EndIf
