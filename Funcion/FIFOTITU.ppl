*- ba:1 Suma de Cantidad ba2: Suma de intereses corridos para el saldo
*- sl1: Saldo a llegar 

ACN(ba:1,0)
ACN(bb:1,0)
ACN(bc:1,0)

ACN(as1,0)

*- Mov. de posiciones solo de operaciones
SQL.ADD("SELECT P.*,O.TotalIntereses,O.Precio1 FROM "~DBO~".MOVPOSEJE P, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  P.Especie = '"~VAL(es3)~"'  and O.NrOperacion=P.NrOperacion ")
SQL.ADD("       AND P.NrSaldo IN ('101','201') ")
SQL.ADD("       AND P.Cliente IN ("~Pipe2Comillas(val(ve1))~") ")
SQL.ADD("       AND P.FechaMov < '"~IdxDate(val(fp1))~"' ")
SQL.ADD("Union All ")
SQL.ADD("SELECT P.*,0 as TotalIntereses,P.Precio AS Precio1 FROM "~DBO~".MOVPOSEJE P, "~DBO~".TRANSACCIONES2 O ")
SQL.ADD("WHERE  P.Especie = '"~VAL(es3)~"'  and O.NrTrans=P.NrOperacion ")
SQL.ADD("       AND P.NrSaldo IN ('101','201') and O.TipoTr2 In ('PCUPON','CCUPON')")
SQL.ADD("       AND P.Cliente IN ("~Pipe2Comillas(val(ve1))~") ")
SQL.ADD("       AND P.FechaMov < '"~IdxDate(val(fp1))~"' ")
SQL.ADD("       Order By 1 DESC ")

Recorrer SQL
   DFA
   *- Descarto las ventas  hasta llegar al saldo
   If FBN['Cantidad']>0       
      If val(sl1)>=FBN['Cantidad']
         ACN(as1,FBN['Cantidad'])
         ACN(as2,FBN['TotalIntereses'])
      Else
         ACN(as1,val(sl1))
         ACN(as2,(val(sl1)*FBN['TotalIntereses'])/FBN['Cantidad'])
      EndIf
  
      SCN(ba:1,val(as1))
      SCN(bb:1,val(as2))
      SCN(bc:1,val(as1)*FBN['Precio1'])
      SCN(sl:1,-val(as1))
   EndIf

   If val(sl1)=0
      Break
   EndIf
Proximo
       
