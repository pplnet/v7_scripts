ACN(m:fac,FBN['Spread'])
acn(s:fac,IIF(FBN['RB6']=0,((val(j:fac)*FBN['ImpGastos1']*FBN['Plazo'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['OPrecio3']/100),0))
acn(r:fac,FBN['ImpComCor2']+val(s:fac))
acn(u:fac,IIF(FBN['RB6']=1,val(j:fac)*FBN['OPrecio2']*FBN['Plazo']/IIF(FBN['MB3']=0,36000,36500),0))
acn(t:fac,val(u:fac)+FBN['ImpComCor1'])
acn(q:fac,(FBN['ImpGastos2']/100)*(val(r:fac)+(val(j:fac)*val(av:fac)/100*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto2'],FBN['RB8']+1))))
acn(p:fac,IIF(FBN['RB6']=0,0,IIF(FBN['RB6']=2,val(j:fac)*((val(aw:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto2'],FBN['RB8']+1)*(FBN['TotalAux1']/100),val(j:fac)*(val(aw:fac)/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto2'],FBN['RB8']+1)*(FBN['TotalAux1']/100))))
acn(o:fac,val(j:fac)*((FBN['Spread']+val(l:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))
acn(v:fac,IIF(FBN['RB6']=0,val(o:fac),IIf(FBN['RB6']=1,val(t:fac),0))*(FBN['TasaImp1']/100))
acn(y:fac,IIF(FBN['RB6']=0,val(r:fac)*(FBN['DeltaTasa']/100),0))
acn(x:fac,val(t:fac)*(FBN['IntDevengados1']/100))
acn(ab:fac,val(y:fac)+val(v:fac)+val(o:fac)+val(r:fac)+val(t:fac)+val(p:fac))
acn(z:fac,(val(j:fac)+val(o:fac)))
acn(aa:fac,(val(j:fac)+val(ab:fac)))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')



