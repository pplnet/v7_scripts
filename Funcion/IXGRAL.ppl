If Dialogo.Radio3=1
   *- Actualiza
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set")
   SQL.ADD("Cantidad          = "~Fstr(val(ai:fac),0,2)~", ")
   If Not Incluido(val(c:fac),'MMPCCM|MMPCCV|MMPLME|')
      SQL.ADD("TotalComisiones   = "~Fstr(val(ak:fac),0,2)~", ")
      SQL.ADD("PrecioEj          = "~Fstr(val(am:fac),0,2)~", ")
   EndIf
   SQL.ADD("ResultadoIndice   = "~Fstr(val(am:fac)-val(al:fac),0,2)~", ")
   SQL.ADD("Coeficiente       = "~Fstr(val(ag:fac),0,8)~"  ")
   SQL.ADD("where NrOperacion = '"~val(d:fac)~"' ")
   SQL.NEW

   If val(af:fac)<>0     
      SQL.ADD("Update "~DBO~".CUOTAS ")
      SQL.ADD("Set")
      If Incluido(val(c:fac),'MMONM|MMSIMV|MMFIMV|')
         SQL.ADD("Cantidad4      = "~Fstr(val(ao:fac),0,2)~", ")
      Else      
         SQL.ADD("Cantidad1      = "~Fstr(val(ao:fac),0,2)~", ")
      EndIf


      SQL.ADD("Cantidad2      = "~Fstr(val(aq:fac),0,2)~", ")
      SQL.ADD("Coeficiente       = "~Fstr(val(ag:fac),0,8)~",  ")
      SQL.ADD("ResultadoIndice   = "~Fstr(val(ar:fac),0,2)~" ")
      SQL.ADD("where NrOperacion = '"~val(i3)~"' ")
      SQL.ADD("and NrCuota = "~Fstr(val(af:fac),2,0)~" ")
      SQL.NEW
   EndIF

   SQL.EXEC
EndIF

