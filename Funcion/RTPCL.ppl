acn(s:fac,IIF(FBN['RB6']=1,((val(j:fac)*FBN['Total5']*FBN['Plazo'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['OPrecio3']/100),0))
acn(r:fac,IIF(FBN['RB6']=1, FBN['ImpComCor2']+val(s:fac), 0))

