acn(q:fac,IIF(FBN['RB6']=1,((val(j:fac)*val(av:fac)/100*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))+val(r:fac))*(FBN['ImpGastos2']/100),((val(j:fac)*VAL(AV:FAC)/100*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))+val(r:fac))*(FBN['ImpGastos2']/100)))

ACN(m:fac,FBN['Spread'])
acn(o:fac,val(j:fac)*((FBN['Spread']+val(l:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1) )
