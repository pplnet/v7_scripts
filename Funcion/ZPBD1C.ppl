        If val(as:fac)=1
          * Si concilia pasa a la instancia conciliacion
          message('Pasa a Conciliacion.')
          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='0' ")
          SQL.ADD(" WHERE NrBit='17' AND NrOperacion='"~val(aw:fac)~"' ")
          SQL.NEW
          SQL.EXEC
          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='1' ")
          SQL.ADD(" WHERE NrBit='18' AND NrOperacion='"~val(aw:fac)~"' ")
          SQL.NEW
          SQL.EXEC
        Else
          message('No pasa a Conciliacion.')
          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='0' ")
          SQL.ADD(" WHERE NrBit='17' AND NrOperacion='"~val(aw:fac)~"' ")
          SQL.NEW
          SQL.EXEC
          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='1' ")
          SQL.ADD(" WHERE NrBit='20' AND NrOperacion='"~val(aw:fac)~"' ")
          SQL.NEW
          SQL.EXEC
          message('Pasan los movimientos a ejecutados.')
          SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS (SELECT /*+ RULE */ * FROM "~DBO~".MOVPENDIENTES ")
          SQL.ADD(" WHERE NrOperacion='"~val(aw:fac)~"') ")
          SQL.NEW
          SQL.EXEC
          SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion='"~val(aw:fac)~"' ")
          SQL.NEW
          SQL.EXEC 
        EndIf

        SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".INSTANCIASOP ")
        SQL.ADD(" WHERE NrOperacion='"~val(aw:fac)~"' ")
        SQL.ADD(" AND NrInstancia='17' ")
        SQL.ADD(" AND Usuario='"~USUARIOACTIVO~"' ")
        SQL.ADD(" AND Mensaje='ZPBD1' ")
        SQL.ADD(" AND Fecha="~idxdate2(Dialogo.Fecha1)~" ")
        SQL.NEW
        SQL.EXEC

        SQL.ADD(" INSERT INTO "~DBO~".INSTANCIASOP (NrOperacion,NrInstancia,Usuario,Mensaje,Fecha) ")
        SQL.ADD(" VALUES ('"~val(aw:fac)~"', '17', '"~USUARIOACTIVO~"', 'ZPBD1', "~idxdate2(Dialogo.Fecha1)~") ")
        SQL.NEW
        SQL.EXEC
