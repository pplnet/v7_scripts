**********************************************************
* Funcion que saca los intereses devengados              *
* Recibe los siguientes parametros                       *
*                                 eb1: TipoOp            *
*                                 eb2: NrOperacion       *
* Devuelve                                               *
*          eb10:Intereses Devengados de la cuota vigente *
**********************************************************

If Incluido(Val(eb1), 'MMCPM|MMPCCM|MMPCLM|MMPOSM|MMPIM|MMSCMV|MMONM|MMFCMV')
   SQL.ADD("SELECT C.Cantidad2 Cantidad, C.Precio2 Tasa, C.Precio4 SpreadC, C.Fecha1 FechaOp, ")
   SQL.ADD("       C.Fecha2 FechaVto, O.TipoOp, O.Spread, O.RB8, 0 TotalComisiones, ")
   SQL.ADD("       0 PeriodoInts, 'OPE' Tipo, O.NrOperacion, O.Especie,'' OpSwap ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and O.NrOperacion = '"~Val(eb2)~"' ")
   SQL.ADD("       and O.TipoOp = '"~Val(eb1)~"' ")
   *---Busco si tiene Swaps
   SQL.ADD(" UNION ")
   (.'SWAPOPEFII'.)
   *---Busco si tiene CAP/FLOOR
   SQL.ADD(" UNION ")
   (.'CAPFLOPEFI'.)
Else
   SQL.ADD("SELECT O.TipoOp, O.Cantidad, O.Precio1 Tasa, O.Spread, O.RB8, O.FechaOp, O.FechaVto, ")
   SQL.ADD("       TotalComisiones, 0 PeriodoInts, 'OPE' Tipo, O.NrOperacion, O.Especie,'' OpSwap  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.NrOperacion = '"~Val(eb2)~"' ")
   SQL.ADD("       and O.TipoOp = '"~Val(eb1)~"' ")
Endif
IF Incluido(Val(EB:1), 'MMCPM|MMPCCM|MMPCLM|MMPOSM|MMPIM|MMSCMV|MMONM|MMFCMV')
   SQL.ADD(" Order By 12, 14 Desc")
ENDIF

ACN(eb10,0)

*- Si ea2 es Pesos hay que transformar todo a $, sino a usd
Recorrer SQL
   IF Eqstr(val(ea2), Var('MONELOCA'))
      ACN(CT:1, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONELOCA')))
   ELSE
      ACN(CT:1, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONEEXTR')))
   ENDIF

   ACN(eb3, IIF(FBN['RB8']=1,365,360) )

   * Calculo T/UT
   If Incluido(FBN['TipoOp'],'MMPCCM|MMPCLM|MMPOSM|MMPIM|MMSCMV|MMPCCM|MMPCCV|MMPSC|MMPI|MMPCOS|MMPLME|MMPCL|MMONM|MMON|')
      ACN(eb4, FactorDias(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1) )
   Else
      ACN(eb4, Dialogo.Fecha1+1-FBN['FechaOp'] )
      ACN(eb4, Val(eb4)/Val(eb3) )
   Endif

   IF Incluido(fbn('Tipo'), 'SWAP|SCAP/FLOOR')
      ***---Paso el interes de la oper. orig. a la moneda en que se informa
      ACN(eb11, (FBN['Cantidad']+FBN['TotalComisiones'])*((FBN['Tasa']+FBN['Spread'])/100)*Val(eb4) )
      ACN(EB:11, Val(EB:11)*Val(CT:1))
      SCN(eb10,val(eb11))
   ELSE
       If Incluido(FBN['TipoOp'],'MMCPM|MMPCCM|MMPCLM|MMPOSM|MMPIM|MMSCMV|MMONM|MMFCMV')
          ACN(eb10, (FBN['Cantidad']+FBN['TotalComisiones'])*((FBN['Tasa']+FBN['SpreadC'])/100)*Val(eb4) )
       Else
          ACN(eb10, (FBN['Cantidad']+FBN['TotalComisiones'])*((FBN['Tasa']+FBN['Spread'])/100)*Val(eb4) )
       Endif
       ACN(EB:10, Val(EB:10)*Val(CT:1))
   ENDIF
Proximo

