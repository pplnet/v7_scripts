
ACT(at1, 'SI')

if Val(hs1) > 0
 BorrarCeldas(sa0..sg:Val(hs1))
endif

ACT(sd0, '')
ACT(at1, 'SI')

recorrer&j 4, Val(z1)  
 *** toma solo lo marcado ***
 if Val(ag:&j) = 1
  if DesciendeDeEspecie(Val(ab:&j),'TITULO')

   ACN(se0, BuscarLista(Val(ab:&j)~'/'~Dialogo.Mercado1,Val(sd0)))
   if Val(se0) = 0
      * en la variable sd0 pongo todos los mercados
      ACT(sd0, Val(sd0)~Val(ab:&j)~'/'~Dialogo.Mercado1~'|')
      ACN(se0, BuscarLista(Val(ab:&j)~'/'~Dialogo.Mercado1,Val(sd0)))
   endif

   * Coloco el Mercado
   ACT(se:Val(se0), Val(ab:&j)~'/'~Dialogo.Mercado1)

   * Cuando es deposito la cantidad esta positiva y cuando es retiro la cant.
   * esta negativa porque es deposito o retiro del cliente, en este caso con 
   * un signo negativo delante alcanza.... (creo)
   ***SCN(sd:Val(se0), -Val(af:&j))
   SCN(sd:Val(se0), Val(af:&j))

***MessageBox(Val(se:Val(se0))~' '~FStr(-Val(af:&j),0,5))

  endif
 endif
proximo

ACN(hs1, Elementos(Val(sd0)))
recorrer&k 1, Val(hs1)
 ACN(sa0, Posicion('/',ItemLista(Val(sd0),&k)))

 * Longitud
 ACN(sa1, Longitud(ItemLista(Val(sd0),&k)))

 * Especie
 ACT(sa2, COPY(ItemLista(Val(sd0),&k),1,Val(sa0)-1))

 * Mercado
 ACT(sa3, COPY(ItemLista(Val(sd0),&k),Val(sa0)+1,Val(sa0)-Longitud(Val(sa2))+1))

 * Cupon
 ACN(sa4, NrCupon2(Val(sa2),Dialogo.Fecha1))

 * Dependiendo del mercado, selecciono la cuenta propia
 * Si el mercado es 'CV'
 *if EqStr(Val(sa3), 'CLHODEFA')
 *   ACT(sa5, VAR('CTAEXT'))
 *else
 *   SQL.ADD("SELECT Codigo FROM "~DBO~".CUENTAS ")
 *   SQL.ADD(" WHERE Cliente    = '"~VAR('VEHICULODE')~"' ")
 *   SQL.ADD("  AND  Estado     = 'HAB' ")
 *   SQL.ADD("  AND  TipoCuenta = 'CUS' ")
 *   SQL.ADD("  AND  Mercado    = '"~Val(sa3)~"' ")
 *   recorrer SQL
 *     ACT(sa5, FBN['Codigo'])
 *   proximo
 *endif

 * Recupero el Saldo para la Cta Propia de un determ. mercado de una determ especie
 *
 * Cambie el Mercado por CV para que me encuentre la cuenta de local Sudameris y no la cuenta de Sudameris en ArgenClear
 * ACN(sf:&k, SaldoC(VAR('VEHICULODE'),Val(sa2),,,,Val(sa3),VAR('VEHICULODE'),Val(sa5),Val(sl0),Dialogo.Fecha1,FStr(Val(sa4),0,0)))
 *
 * sa4 = NrCupon (debe ser distinto de cero)
 *
 if Val(sa4) = 0
    ACN(sf:&k, SaldoC(Var('VEHICULODE'),Val(sa2),,,,'CV',Var('VEHICULODE'),val(y8),Val(sl0),Dialogo.Fecha1))
 else
    ACN(sf:&k, SaldoC(Var('VEHICULODE'),Val(sa2),,,,'CV',Var('VEHICULODE'),val(y8),Val(sl0),Dialogo.Fecha1,FStr(Val(sa4),0,0)))
 endif

* MESSAGEBOX('SALDO A '~Val(sf:&k))
*MESSAGEBOX('CUENTA '~val(y8))
*MESSAGEBOX('CUENTA '~val(y8))

 *- Solo descuenta tic/tiv si la cta seleccionada sigue siendo la propia
 If EqStr(val(y8),VAR('CTAVEHIC'))
    * Recupero los movimientos de las operaciones de Compra pendientes de liquidar 
    * para sumar al saldo, y luego hago lo mismo con ventas para restarlo al sldo
    SQL.ADD("SELECT -SUM(M.Cantidad) Cant ")
    SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK INDEX = INDME1) , "~DBO~".OPERACIONES O ")
    *** SQL.ADD("WHERE O.TipoOp IN ('TIC','TIFC','TIV','TIFV') AND ")
    * 20/10/2004
    SQL.ADD("WHERE O.TipoOp IN ('TIC','TIFC','TIV','TIFV','TICT','TICO','TIDE','TIPO','TCPCEM') AND ")
    SQL.ADD("  O.NrOperacion = M.NrOperacion  AND ")
    SQL.ADD("  M.Especie     = '"~Val(sa2)~"' AND ")
    * Tambien toma los movimientos de CV
    SQL.ADD("  (M.Mercado = '"~Val(sa3)~"' or M.Mercado = 'CV') AND ")
    SQL.ADD("  M.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
    SQL.ADD("  M.NrSaldo = 31 ")
    *MESSAGEBOX('Busca MovPend')
    Recorrer SQL
       dfa
       SCN(sf:&k, FBN['Cant'])
*       MESSAGEBOX('MOVPENDIENTES  -  '~fbn('Cant'))
    Proximo
 EndIf

* MESSAGEBOX('SALDO B '~Val(sf:&k))

 If (Val(sf:&k) + Val(sd:&k)) < 0
    MessageBox("Se excede el saldo de cartera propia: "~Val(sa2)~" / "~Val(sa3)~" Sldo: "~FStr(Val(sf:&k),1,2)~" a Liq.: "~FStr(Val(sd:&k),1,2))
    ACT(at1, 'NO')
 Endif
