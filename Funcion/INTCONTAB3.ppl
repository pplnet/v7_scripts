SQL.ADD(" Insert Into "~DBO~".MOVIMIENTOS ")
SQL.ADD(" (Tipo_Operacion_Codigo, Tipo_Movimiento_Codigo, NrOperacion, Movimiento_Numero, ")
SQL.ADD(" Compania_Codigo_PC3, Entidad_Codigo, Concepto, Moneda_Codigo, ")
SQL.ADD(" Movimiento_Fecha, Movimiento_Monto, Tipo_De_Cambio, Estado, ")
SQL.ADD(" Add_Uid, Add_Date, Update_Uid, Update_Date, ")
SQL.ADD(" FechaProceso, NrEnvio, Origen, Instante, ")
SQL.ADD(" SubInstante, Estado1, FechaContable, Concepto1, ")
SQL.ADD(" RB1, FechaAnulada,CuentaOrigen,CuentaDestino ")
IF Incluido(Val(TO:1), 'SECS|SEVS|SECT|SEVT|CUPON|MMON|MMONM')
    SQL.ADD(" , Estado2) ")
ELSE
    SQL.ADD(" ) ")
ENDIF
SQL.ADD(" Values ")
SQL.ADD(" ('"~Val(TO:1)~"', '"~Val(TR:2)~"', '"~Val(NP:1)~"', "~Fstr(Val(NM:1), 1, 0)~", ")
SQL.ADD(" '"~Val(VH:1)~"', '"~Val(ET:1)~"', '"~Val(LY:1)~"', '"~Val(MO:1)~"', ")
SQL.ADD(" '"~IdxDate(Val(MF:1))~"', "~Fstr(Val(CN:1)*Val(SG:1), 1, 2)~", "~Fstr(Val(CT:3), 1, 8)~", '"~Val(ED:1)~"', ")
SQL.ADD(" "~Val(UI:1)~", "~Val(AH:1)~", "~Val(UI:1)~", "~Val(AH:1)~", ")
SQL.ADD(" '"~IdxDate(Fsys)~"', '"~Fstr(Val(EV:1), 3, 0)~"', '"~Val(OG:1)~"', '"~Val(IT:1)~"', ")
SQL.ADD(" '"~Val(SS:1)~"', '"~Val(CP:1)~"','"~IdxDate(Val(FT:1))~"', '"~Val(CQ:1)~"', ")
SQL.ADD(" "~Val(BD:3)~",'"~IdxDate(Val(FA:1))~"','"~Val(cu:1)~"','"~Val(cu:2)~"' ")
IF Incluido(Val(TO:1), 'SECS|SEVS|SECT|SEVT|CUPON|')
    SQL.ADD(" , '"~Val(EO:1)~"') ")
ELSE
    IF Incluido(Val(TO:1), 'MMON|MMONM')
        SQL.ADD(" , '"~Val(SR:1)~"') ")
    ELSE
        SQL.ADD(" ) ")
    ENDIF
ENDIF
SQL.NEW
SQL.EXEC
