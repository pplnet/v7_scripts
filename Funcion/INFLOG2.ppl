SQL.ADD(" order by Fecha,Accion,Codigo ")
Recorrer SQL
  scn(x1,1)
  if Not EqStr(fbn['Fecha'],Val(v1)) o Not EqStr(fbn('Accion'),Val(v2)) o Not EqStr(fbn('Codigo'),Val(v3)) o EqStr(fbn('Campo'),Val(v4))
    act(a:fac, iif(EqStr(fbn['Accion'],'A'),'Alta',iif(EqStr(fbn['Accion'],'B'),'Baja','Modificacion')))
    ACD(b:fac, Fecha(fbn('Fecha')))
    ACT(c:fac, Hora(fbn('Fecha')))
    ACT(d:fac, fbn['Operador'])
    ACT(e:fac, BuscarCampo('USUARIOS','Nombre','Codigo',fbn('Operador')))
    ACT(f:fac, fbn['Codigo'])
    ACT(v1, fbn['Fecha'])
    ACT(v2, fbn['Accion'])
    ACT(v3, fbn['Codigo'])
    ACT(v4, fbn['Campo'])
    SetFont(a:FAC..f:FAC,2)
  endif
  act(g:fac, fbn['Campo'])
  act(h:fac, Copy(fbn['ValorAnterior'],1,33))
  act(i:fac, Copy(fbn['ValorActual'],1,33))
  SetFont(g:FAC..i:FAC,1)
Proximo

if Val(x1)=0
  SetFilaActual(FAC+2)
  ACT(f:FAC, 'N I L')
  AlinearCeldas(f:FAC,'C')
  SetFont(f:FAC,2)
endif

ACO(1,8)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,19)
ACO(6,9)
ACO(7,9)
ACO(8,20)
ACO(9,20)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)

SetFont(v:1..x:4,1)
AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))
*ACT(i:1, CodigoInforme)
*ACT(i:3, 'ISC : Confidencial')
*ACT(i:4, 'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
*SetFont(i:1..i:4,2)
*AlinearCeldas(i:1..i:4,'D') 
ACT(i:2, 'CONFIDENCIAL')
AlinearCeldas(i:2,'D') 
SetFont(i:2,2)
SetPrintFit(3, 90)
act(ar:1,VAR('PATHLOGAUD')~'Log_de_Modificaciones_a_Perfiles_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')

LimitesVision(i:FAC)
RangoTitulo(a:1..i:FAC, Val(w1)+4)

SetMargins(0.5,0.5,0.5,1.5)
Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,2)

if Dialogo.Check2=1
   HojaVisible(NO)
   *act(ho:1,Hora(AHORA))
   *act(ho:2,Copy(val(ho:1),1,2)~Copy(val(ho:1),4,2)~Copy(val(ho:1),7,2))
   *   act(ar:1,VAR('PATHLOGAUD')~'Log_de_Modificaciones_a_Perfiles_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')
   BorrarArchivo(val(ar:1))
   ExportarPdf(val(ar:1))
