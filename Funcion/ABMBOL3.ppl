    IF Dialogo.Radio1 = 2
        ***---Modificacion
        SQL.ADD(" Select Cliente1, Cantidad1, Fecha2, NrOperacionRef1, Cambio1, CEmpresa3, NrOfic, Ley1, Precio1, ")
        SQL.ADD(" Cambio3, Ley2, CEmpresa4, Ley5, Especie1, Cantidad2, Cantidad3, Ley3, Ley4, Especie, Fecha1 ")
        SQL.ADD(" From "~DBO~".TRANSACCIONES2 Where NrTrans = '"~Dialogo.NrTrans1~"' ")
        Recorrer SQL
            ACT(A:fac, Dialogo.NrTrans1)
            ACT(B:fac, fbn('Cliente1'))
            ACN(C:fac, fbn('Cantidad1'))
            ACN(D:fac, fbn('Precio1'))
            ACT(E:fac, fbn('Especie1'))
            IF NoVacio(fbn('NrOperacionRef1'))
               ACT(F:fac, fbn('NrOperacionRef1'))
               ACN(RG:1, 173)
               ACN(RG:2, 201)
               ACN(RG:3, 167)
            ELSE
               ACN(RG:1, 220)
               ACN(RG:2, 220)
               ACN(RG:3, 193)
            ENDIF
            ACD(G:fac, fbn('Fecha2'))
            ACT(H:fac, Fstr(fbn('Cambio1'), 0, 0))
            IF Dialogo.Radio2 = 0
               * --- Compras --- *
               ACT(I:fac, fbn('CEmpresa3'))
               ACT(J:fac, fbn('NrOfic'))
               ACT(K:fac, Pad0(fbn('Cambio3'), 2))
               ACT(R:fac, Pad0(fbn('Cantidad3'), 2))
            ELSE
               * --- Ventas ---- *
               ACT(I:fac, fbn('Ley3'))
               ACT(J:fac, Pad0(fbn('Cantidad2'), 2))
               ACT(K:fac, Pad0(fbn('Cantidad3'), 2))
            ENDIF
            ACT(L:fac, fbn('Ley2'))
            ACT(M:fac, fbn('Ley1'))
            ACT(N:fac, fbn('CEmpresa4'))
            ACT(O:fac, fbn('Ley5'))
            ACT(P:fac, fbn('Ley4'))
            ACD(Q:fac, fbn('Fecha1'))
        Proximo

        IF Dialogo.Radio2 = 0
            CrearListBox ; 'Arial,8,';'Modificion de Boleto BCRA Compra'
               'Boleto'             ;A:fac..A:fac;NO;;;80;STRING;;RGB(173,201,167);
               'Fecha'              ;Q:fac..Q:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(Q:FLB) <> 0;'Fecha Invalida.';80;FECHA;RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Cliente'            ;B:fac..B:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O [NoVacio(Val(B:FLB)) Y Incluido(Val(B:FLB), Val(LS:1))];'Cliente Invalido.';80;TABLA;'CLIENTES';'Codigo';'Codigo;RazonSocial';" Codigo IN ("~Pipe2Comillas(Val(LS:1))~") ";RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Cantidad'           ;C:fac..C:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(C:FLB) > 0;'Cantidad Invalida.';80;NUMERO;'###,###,###.##';RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'T.Cambio'           ;D:fac..D:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(D:FLB) > 0 ;'Tipo de Cambio Invalido.';80;NUMERO;'###,###.########';RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Moneda'             ;E:fac..E:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O [NoVacio(Val(E:FLB)) Y Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', Val(E:FLB)), 'MON') Y EsTerminal(Val(E:FLB), ESPECIES)];'Moneda Invalida';80;TABLA;'ESPECIES';'Codigo';'Codigo;Nombre';" Status = 'HAB' AND Tipo = 'MON' ";RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Oper. FX'           ;F:fac..F:fac;NO;;;80;STRING;;RGB(173,201,167);
               'Fecha Ingreso'      ;G:fac..G:fac;SI;;;80;FECHA;RGB(220,220,193);
               'Concepto'           ;H:fac..H:fac;SI;NoVacio(Val(H:FLB)) Y Eqstr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo', Val(H:FLB)), 'COMPRA');'Concepto BCRA Invalido.';80;TABLA;'CONCEPTOSBCRA';'Codigo';'Codigo;Descripcion';" Alias1 = 'COMPRA' ";RGB(220,220,193);
               'Pais Origen'        ;I:fac..I:fac;SI;;;80;TABLA;'PAISES';'Alias';'Alias;Codigo;Nombre';"Alias Is Not Null";RGB(220,220,193);
               'Nro.Ofic.'          ;J:fac..J:fac;SI;;;80;STRING;75;RGB(220,220,193);
               'Inst.Comprado'      ;K:fac..K:fac;SI;NoVacio(Val(K:FLB));'Codigo de Instrumento Comprado Invalido.';100;TABLA;'INSTRUMENTOS';'Codigo';'Codigo;Descripcion';;RGB(220,220,193);
               'Inst.Recibido'      ;r:fac..r:fac;SI;NoVacio(Val(r:FLB));'Codigo de Instrumento Comprado Recibido.';100;TABLA;'INSTRUMENTOS';'Codigo';'Codigo;Descripcion';;RGB(220,220,193);
               'Pagador      '      ;L:fac..L:fac;SI;NoVacio(Val(L:FLB));'Pagador Invalido.';200;STRING;;RGB(220,220,193);
               'Domicilio'          ;M:fac..M:fac;SI;NoVacio(Val(M:FLB));'Domicilio Invalido.';200;STRING;;RGB(220,220,193);
               'Cod.Pais Pagador'   ;N:fac..N:fac;SI;NoVacio(Val(N:FLB));'Codigo Pais Pagador Invalido.';90;TABLA;'PAISES';'Alias';'Alias;Codigo;Nombre';"Alias Is Not Null";RGB(220,220,193);
               'Swift-Bco.Pag.Ext'  ;O:fac..O:fac;SI;NoVacio(Val(O:FLB));'Cod. Swif Banco Pagador del Exterior Invalido.';200;STRING;;RGB(220,220,193);
               'Bco.Pagador Ext.'   ;P:fac..P:fac;SI;NoVacio(Val(P:FLB));'Banco Pagador del Exterior Invalido.';200;STRING;;RGB(220,220,193);
            FinListBox

            IF Not OK
               Cancelar
            ENDIF

            Recorrer&k 1, fac
                ACN(FE:1, Val(G:&k))
                ACN(FE:2, Val(Q:&k))
                ACT(SW:1, SQL("SELECT SWIFT FROM "~DBO~".ESPECIES WHERE Codigo = '"~Val(e:&k)~"' ") )

                message("Modificando Boleto "~Val(a:&k)~" ... ")
                SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
                SQL.ADD(" Set Cambio1 = "~Fstr(Num(Val(H:&k)), 0, 0)~", ")
                IF Val(FE:1) <> 0
                    SQL.ADD(" Fecha2 = '"~IdxDate(Val(G:&k))~"', ")
                ENDIF
                SQL.ADD(" CEmpresa3 = '"~Val(I:&k)~"', ")
                SQL.ADD(" NrOfic = '"~Val(J:&k)~"', ")
                SQL.ADD(" Cambio3 = "~Fstr(Num(Val(K:&k)), 0, 0)~", ")
                SQL.ADD(" Cantidad3 = "~Fstr(Num(Val(r:&k)),0,0)~", ")
                SQL.ADD(" Ley2 = '"~Copy(Val(L:&k), 1, 300)~"', ")
                SQL.ADD(" Ley1 = '"~Copy(Val(M:&k), 1, 300)~"', ")
                SQL.ADD(" CEmpresa4 = '"~Copy(Val(N:&k), 1, 10)~"', ")
                SQL.ADD(" Ley5 = '"~Copy(Val(O:&k), 1, 30)~"', ")
                SQL.ADD(" Ley4 = '"~Val(P:&k)~"', ")
                SQL.ADD(" Fecha3 = "~SQLAhora~" ")
                IF Vacio(Val(F:&k))
                   SQL.ADD(" ,Cliente1 = '"~Val(B:&k)~"', ")
                   SQL.ADD(" Especie1 = '"~Val(E:&k)~"', ")
                   SQL.ADD(" Especie = '"~Val(SW:1)~"', ")
                   SQL.ADD(" Cantidad1 = "~Fstr(Num(Val(C:&k)), 0, 2)~", ")
                   SQL.ADD(" Precio1 = "~Fstr(Num(Val(D:&k)), 0, 8)~" ")
                   IF Val(FE:2) <> 0
                      SQL.ADD(" ,Fecha1 = '"~IdxDate(Val(Q:&k))~"' ")
                   ENDIF
                ENDIF
                SQL.ADD(" Where NrTrans = '"~Val(A:&k)~"' ")
                SQL.NEW
            Proximo
        ELSE
            CrearListBox ; 'Arial,8,';'Modificion de Boleto BCRA Venta'
               'Boleto'                ;A:fac..A:fac;NO;;;80;STRING;;RGB(173,201,167);
               'Fecha'                 ;Q:fac..Q:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(Q:FLB) <> 0;'Fecha Invalida.';80;FECHA;RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Cliente'               ;B:fac..B:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O [NoVacio(Val(B:FLB)) Y Incluido(Val(B:FLB), Val(LS:1))];'Cliente Invalido.';80;TABLA;'CLIENTES';'Codigo';'Codigo;RazonSocial';" Codigo IN ("~Pipe2Comillas(Val(LS:1))~") ";RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Cantidad'              ;C:fac..C:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(C:FLB) > 0;'Cantidad Invalida.';80;NUMERO;'###,###,###.##';RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'T.Cambio'              ;D:fac..D:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O Val(D:FLB) > 0;'Tipo de Cambio Invalido.';80;NUMERO;'###,###.########';RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Moneda'                ;E:fac..E:fac;Vacio(Val(F:FLB));NoVacio(Val(F:FLB)) O [NoVacio(Val(E:FLB)) Y Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', Val(E:FLB)), 'MON') Y EsTerminal(Val(E:FLB), ESPECIES)];'Moneda Invalida';80;TABLA;'ESPECIES';'Codigo';'Codigo;Nombre';" Status = 'HAB' AND Tipo = 'MON' ";RGB(Val(RG:1),Val(RG:2),Val(RG:3));
               'Oper. FX'              ;F:fac..F:fac;NO;;;80;STRING;;RGB(173,201,167);
               'Fecha Embarque'        ;G:fac..G:fac;SI;;;80;FECHA;RGB(220,220,193);
               'Concepto'              ;H:fac..H:fac;SI;NoVacio(Val(H:FLB)) Y Eqstr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo', Val(H:FLB)), 'VENTA');'Concepto BCRA Invalido.';80;TABLA;'CONCEPTOSBCRA';'Codigo';'Codigo;Descripcion';" Alias1 = 'VENTA' ";RGB(220,220,193);
               'Cuenta'                ;I:fac..I:fac;SI;NoVacio(Val(I:FLB));'Nro. de Cuenta Invalido';200;STRING;;RGB(220,220,193);
               'Inst.Vendido'          ;J:fac..J:fac;SI;NoVacio(Val(J:FLB));'Codigo de Instrumento Vendido Invalido.';100;TABLA;'INSTRUMENTOS';'Codigo';'Codigo;Descripcion';;RGB(220,220,193);
               'Inst.Recibido'         ;K:fac..K:fac;SI;NoVacio(Val(K:FLB));'Codigo de Instrumento Recibido Invalido.';100;TABLA;'INSTRUMENTOS';'Codigo';'Codigo;Descripcion';;RGB(220,220,193);
               'Beneficiario'          ;L:fac..L:fac;SI;NoVacio(Val(L:FLB));'Beneficiario del Exterior Invalido.';200;STRING;200;RGB(220,220,193);
               'Domicilio'             ;M:fac..M:fac;SI;NoVacio(Val(M:FLB));'Domicilio Invalido.';200;STRING;;RGB(220,220,193);
               'Cod. Pais Benefic.'    ;N:fac..N:fac;SI;NoVacio(Val(N:FLB));'Cod.Pais Beneficiario Invalido.';100;TABLA;'PAISES';'Alias';'Alias;Codigo;Nombre';"Alias Is Not Null";RGB(220,220,193);
               'Cod.Swift Bco.Rec.Ext.';O:fac..O:fac;SI;NoVacio(Val(O:FLB));'Cod. Swif Banco Recibidor del Exterior Invalido.';200;STRING;;RGB(220,220,193);
               'Bco.Recibidor Ext.'    ;P:fac..P:fac;SI;NoVacio(Val(P:FLB));'Banco Recibidor del Exterior Invalido.';200;STRING;;RGB(220,220,193);
            FinListBox

            IF Not OK
               Cancelar
            ENDIF

            Recorrer&k 1, fac
                ACN(FE:1, Val(G:&k))
                ACN(FE:2, Val(Q:&k))
                ACT(SW:1, SQL("SELECT SWIFT FROM "~DBO~".ESPECIES WHERE Codigo = '"~Val(e:&k)~"' ") )

                message("Modificando Boleto "~Val(a:&k)~" ... ")
                SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
                SQL.ADD(" Set Cambio1 = "~Fstr(Num(Val(H:&k)), 0, 0)~", ")
                IF Val(FE:1) <> 0
                   SQL.ADD(" Fecha2 = '"~IdxDate(Val(G:&k))~"', ")
                ENDIF
                SQL.ADD(" Ley3 = '"~Copy(Val(I:&k), 1, 30)~"', ")
                SQL.ADD(" Cantidad2 = "~Fstr(Num(Val(J:&k)), 0, 0)~", ")
                SQL.ADD(" Cantidad3 = "~Fstr(Num(Val(K:&k)), 0, 0)~", ")
                SQL.ADD(" Ley2 = '"~Copy(Val(L:&k), 1, 300)~"', ")
                SQL.ADD(" Ley1 = '"~Copy(Val(M:&k), 1, 300)~"', ")
                SQL.ADD(" CEmpresa4 = '"~Copy(Val(N:&k), 1, 10)~"', ")
                SQL.ADD(" Ley5 = '"~Copy(Val(O:&k), 1, 30)~"', ")
                SQL.ADD(" Ley4 = '"~Val(P:&k)~"', ")
                SQL.ADD(" Fecha3 = "~SQLAhora~" ")
                IF Vacio(Val(F:&k))
                   IF Val(FE:2) <> 0
                      SQL.ADD(" ,Fecha1 = '"~IdxDate(Val(Q:&k))~"' ")
                   ENDIF
                   SQL.ADD(" ,Cliente1 = '"~Val(B:&k)~"', ")
                   SQL.ADD(" Especie1 = '"~Val(E:&k)~"', ")
                   SQL.ADD(" Especie = '"~Val(SW:1)~"', ")
                   SQL.ADD(" Cantidad1 = "~Fstr(Num(Val(C:&k)), 0, 2)~", ")
                   SQL.ADD(" Precio1 = "~Fstr(Num(Val(D:&k)), 0, 8)~" ")
                ENDIF
                SQL.ADD(" Where NrTrans = '"~Val(A:&k)~"' ")
                SQL.NEW
            Proximo
        ENDIF
        SQL.EXEC
    ENDIF
