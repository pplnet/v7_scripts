acn(m:fac,FBN['Precio4'])
acn(o:fac,val(j:fac) * ((val(l:fac) + val(m:fac))/100) * FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8'] +1))
acn(q:fac,val(j:fac)*(val(av:fac)/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8'] +1) * (FBN['ImpGastos2']/100))
acn(p:fac,val(j:fac)*(val(aw:fac)/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8'] +1) * (FBN['TotalAux1']/100))
acn(v:fac,val(o:fac)*(FBN['TasaImp1']/100))
acn(ab:fac,val(o:fac)+iif(FBN['CB10']=1,val(p:fac),0)+val(v:fac))
acn(z:fac,(val(k:fac)+val(o:fac)))
acn(aa:fac,val(k:fac)+val(ab:fac))

*-- ta1: Atributo de TTN 
ACT(ta1,'Total3')

