*- Funcion que recibe 2 listas ordenadas y las ordena y saca la variacion de las mismas.
* fi20: Cantidad de elementos de la primer lista
* fi21: Cantidad de elementos de la segunda lista
* fa20: Puntero a la primer lista
* fa21: Puntero a la segunda lista
* fa22: Puntero a la tercer lista 
* ea20: Especie de la primer lista
* ea21: Especie de la segunda lista
***************************************************************************************

Repetir
   ACT(ea20, LinkH(1, a:Val(fa20)))
   ACT(ea21, LinkH(2, a:Val(fa21)))
*   messagebox(Val(ea20)~' '~Val(ea21))
*   messagebox('Cantidad de elementos: '~Val(fi20)~' '~Val(fi21))
*   messagebox('Posicion: '~Val(fa20)~' '~Val(fa21)~' '~Val(fa22))

   If [Val(fa20)<=Val(fi20) y Val(fa21)<=Val(fi21)]  
      If EqStr(Val(ea20), Val(ea21) )
         ACT(a:Val(fa22), Val(ea20))
         Recorrer&j 2, 17
            ACN(&j:Val(fa22), LinkH(2, &j:Val(fa21))-LinkH(1, &j:Val(fa20)) )
         Proximo
         ACN(e:Val(fa22), 0)
         ACN(f:Val(fa22), 0)
         ACN(j:Val(fa22), 0)
         ACN(k:Val(fa22), 0)

         SetFont(a:Val(fa22), 2)
         SetFont(b:Val(fa22)..q:Val(fa22), 1)
         SCN(fa20, 1)
         SCN(fa21, 1)
         SCN(fa22, 1)
      Else
         If GtStr(Val(ea20), Val(ea21))
            ACT(a:Val(fa22), Val(ea21))
            Recorrer&j 2, 17
               ACN(&j:Val(fa22), LinkH(2, &j:Val(fa21)) )
            Proximo
            ACN(e:Val(fa22), 0)
            ACN(f:Val(fa22), 0)
            ACN(j:Val(fa22), 0)
            ACN(k:Val(fa22), 0)

            SetFont(a:Val(fa22), 2)
            SetFont(b:Val(fa22)..q:Val(fa22), 1)
            SCN(fa21, 1)
            SCN(fa22, 1)
         else
            ACT(c:Val(z3), Val(ea20))
            Recorrer&j 2, 17
               ACN(&j:Val(fa22), LinkH(1, &j:Val(fa20)) )
            Proximo
            ACN(e:Val(fa22), 0)
            ACN(f:Val(fa22), 0)
            ACN(j:Val(fa22), 0)
            ACN(k:Val(fa22), 0)

            SetFont(a:Val(fa22), 2)
            SetFont(b:Val(fa22)..q:Val(fa22), 1)
            SCN(fa20, 1)
            SCN(fa22, 1)
         Endif
      Endif
   Endif
     
   If Val(fa20)>Val(fi20)
      ACT(a:Val(fa22), Val(ea21))
      Recorrer&j 2, 17
         ACN(&j:Val(fa22), LinkH(2, &j:Val(fa21)) )
      Proximo
      ACN(e:Val(fa22), 0)
      ACN(f:Val(fa22), 0)
      ACN(j:Val(fa22), 0)
      ACN(k:Val(fa22), 0)

      SetFont(a:Val(fa22), 2)    
      SetFont(b:Val(fa22)..q:Val(fa22), 1)
      SCN(fa21, 1)
      SCN(fa22, 1)
   Endif
    
   If Val(fa21)>Val(fi21)
      ACT(a:Val(fa22), Val(ea20))
      Recorrer&j 2, 17
         ACN(&j:Val(fa22), LinkH(1, &j:Val(fa20)) )
      Proximo
      ACN(e:Val(fa22), 0)
      ACN(f:Val(fa22), 0)
      ACN(j:Val(fa22), 0)
      ACN(k:Val(fa22), 0)

      SetFont(a:Val(fa22), 2)    
      SetFont(b:Val(fa22)..q:Val(fa22), 1)
      SCN(fa20, 1)
      SCN(fa22, 1)
   Endif
    
   If [Val(fa20)>Val(fi20) y Val(fa21)>Val(fi21)]  
      Break
   Endif
Proximo