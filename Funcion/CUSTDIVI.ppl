* SQL.ADD("  and  Mercado = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("Select Cliente, Cuenta, Mercado, ")
SQL.ADD("       EnteCustodia, NrSaldo, Max(Fecha) as Fe from "~DBO~".SALDOSDIA ")
SQL.ADD("where  Especie = '"~Dialogo.Especie1~"'  ")
SQL.ADD("  and  Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  NrSaldo =1  ")
SQL.ADD("  and CallPut is Null ")
SQL.ADD("group by Cliente, Cuenta, Mercado, EnteCustodia, NrSaldo")
SQL.ADD("order by Cliente, Cuenta, Mercado, EnteCustodia, NrSaldo")

recorrer SQL

  act(a:fac,fbn['Cliente'])
  act(b:fac,'SALDOS')
  acn(d:fac, SaldoC(fbn['Cliente'],Dialogo.Especie1,,,,fbn['Mercado'],,fbn['Cuenta'],fbn['NrSaldo'],fbn['Fe']))
  act(k:fac,fbn['Mercado'])

  if val(d:fac) <> 0

     *** Calcula imoprtes de dividendos ***
     (."CALCDIVI".)
     acn(e:fac,val(ae:fac))
     acn(f:fac,val(af:fac))
  else 
     dfa
  endif

proximo
