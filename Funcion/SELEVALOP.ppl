***---Opciones Mercado Regulado
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal, ")
SQL.ADD(" O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.TipoOp, O.Cantidad Importe, ")
SQL.ADD(" O.Spread, O.Precio1 Tasa, O.RB8, O.Plazo, O.TipoTasa, 100 as PorAmor, O.PrecioRef, ")
SQL.ADD(" O.TotalIntereses,O.Plazo AS PlazoTot ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ,"~DBO~".TIPOSTASA TT ")
SQL.ADD(" Where O.Cliente1 = C.Codigo ")
SQL.ADD(" AND TT.Codigo = O.TipoTasa ")
SQL.ADD(" AND O.PrecioRef Is Not Null ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoOp IN ('NRO') ")
IF NoVacio(Val(LI:1))
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LI:1))~") ")
ENDIF
IF NoVacio(Val(LI:3))
    SQL.ADD(" AND O.Especie IN ("~Pipe2Comillas(Val(LI:3))~") ")
ENDIF
IF NoVacio(Val(OP:1))
    SQL.ADD(" AND O.NrOperacion = '"~Val(OP:1)~"' ")
ENDIF

SQL.ADD(" UNION ALL ")

***---Opciones Mercado NO Regulado
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal, ")
SQL.ADD(" O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.TipoOp, O.Cantidad Importe, ")
SQL.ADD(" O.Spread, O.Precio1 Tasa, O.RB8, O.Plazo, O.TipoTasa, 100 as PorAmor, O.PrecioRef, ")
SQL.ADD(" O.TotalIntereses,O.Plazo AS PlazoTot ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ,"~DBO~".TIPOSTASA TT ")
SQL.ADD(" Where O.Cliente1 = C.Codigo ")
SQL.ADD(" AND TT.Codigo = O.TipoTasa ")
SQL.ADD(" AND O.PrecioRef Is Not Null ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoOp IN ('DFXO|DSEO') ")
IF NoVacio(Val(LI:1))
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LI:1))~") ")
ENDIF
IF NoVacio(Val(LI:3))
    SQL.ADD(" AND O.Especie IN ("~Pipe2Comillas(Val(LI:3))~") ")
ENDIF
IF NoVacio(Val(OP:1))
    SQL.ADD(" AND O.NrOperacion = '"~Val(OP:1)~"' ")
ENDIF
