**

if NoVacio(Dialogo.String1)
  SQL.ADD("and O.ObsErrorMAE = '"~Pad0(Dialogo.String1,15)~"'")
endif

if NoVacio(Dialogo.Lista2)
  if Incluido(Dialogo.Lista2,'SALES')
    SQL.ADD("and O.Mercado4 in ('100','101','102')")
  else
    if Incluido(Dialogo.Lista2,'PYMES')
      SQL.ADD("and O.Mercado4 in ('104','105','106','107','109','110','111','112','113','114')")
    else
      if Incluido(Dialogo.Lista2,'INSTITUTIONALS')
        SQL.ADD("and O.Mercado4 in ('103') and  O.ConceptoEmp ='D01'")
      else
        if Incluido(Dialogo.Lista2,'FIN.INST')
          SQL.ADD("and O.Mercado4 in ('103') and  O.ConceptoEmp <> 'D01'")
        endif
      endif
    endif
  endif
endif
if NoVacio(Dialogo.Lista3)
  SQL.ADD("and O.TipoDoc In ("~Pipe2Comillas(Dialogo.Lista3)~")")
endif

if NoVacio(Dialogo.Lista4)
  SQL.ADD("and O.Operador In ("~Pipe2Comillas(Dialogo.Lista4)~")")
endif

if NoVacio(Dialogo.Lista5)
 SQL.ADD("and O.Mercado3 In ("~Pipe2Comillas(Dialogo.Lista5)~")")
endif

****************AGUS*********************
if NoVacio(Dialogo.Lista6)
 SQL.ADD("and O.Especie In ("~Pipe2Comillas(Dialogo.Lista6)~")")
endif
*****************************************

 * Oficio
 if Dialogo.Radio4=0
  SQL.ADD("and IsNull(O.Convenio,'')='OFI' ")
 else
  if Dialogo.Radio4=1
    SQL.ADD("and IsNull(O.Convenio,'')<>'OFI' ")
  endif
 endif

****************************************************************************************************
*Orden por
if Dialogo.Radio3=0
  SQL.ADD("Order by O.FECHAOP, O.NROPERACION")
else
  if Dialogo.Radio3=1
    SQL.ADD("Order by CantOpeUSD")
  else
    if Dialogo.Radio3=2
      SQL.ADD("Order by ResultadoUSD")
    endif
  endif
  if Dialogo.Radio2=0
    SQL.ADD("Asc")
  else
    SQL.ADD("Desc")
  endif
endif
