*Preboletos
 SQL.ADD("Select Case when O.TotalRetenciones=0 then O.Cantidad else O.Cantidad * O.TipoCambio2 end as CantOpeUSD ,")
 SQL.ADD("       Case when O.FecAprobPreBol <'"~IdxDate(Val(fe:1))~"'  ")
 SQL.ADD("            then O.Cantidad  ")
 SQL.ADD("                 / (Select Precio1 from  "~DBO~".COTIZACIONES             ")
 SQL.ADD("                  Where Fecha =(Select Max(Fecha) from  "~DBO~".COTIZACIONES ")
 SQL.ADD("                                Where Month(Fecha) =Month(O.FecAprobPreBol) and Year(Fecha) = Year(O.FecAprobPreBol) and Codigo = 'COMA35' )")
 SQL.ADD("                  and Codigo = 'COMA35')")
 SQL.ADD("                 * (Case when O.TipoOp in('FXCS','FXACS') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end ) ")
 SQL.ADD("            else O.Cantidad  ")
 SQL.ADD("                 /"~Val(co:2))
 SQL.ADD("                 * (Case when O.TipoOp in('FXCS','FXACS') then (O.TipoCambio3-O.Precio2) else  (O.Precio2-O.TipoCambio3) end ) ")
 SQL.ADD("            end  as ResultadoUSD ,")
 SQL.ADD("   'Preboletos' as TIPO, O.FecAprobPreBol as FECHAOP, O.NroAltaMAE as CLIENTE, O.TipoOp as TIPOOP, O.Especie, O.Cantidad as CANTIDAD, O.Plazo4 as PLAZO, Case When IsNull(O.Puesto,'')='' Then 'No Puesto' Else 'Puesto' End as VALOR,  Case when O.TotalRetenciones=0 then 1 Else O.TipoCambio2 End as TipoCambio2, O.PorDerechoBolsa as COTUSD, O.Precio2, O.TipoCambio3, O.TotalBrutoCli2 as MONTOARP, O.TotalBrutoCli1 as MONTOUSD, O.Operador, O.Mercado as EQUIPO, O.Mercado4 as ORGANIZACION, O.ConceptoEmp as SEGMENTO,  O.NrOperacion as NROPERACION, O.TotalRetenciones, O.Corredor as BROKER, O.TipoDoc as PRODUCTO, O.FechaVto, ")
 SQL.ADD("        (Case when Instancia = 1 then 'Cotizacion Manual' when Instancia = 2 then 'Supervision Mesa' when Instancia = 3 then 'Envio OPEX' when Instancia = 4 then 'Terminal' when Instancia = 6 then 'Supervision Trading' when Instancia = 5 then 'Anulacion' end) AS Instancia ,")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then (Select OficialCuenta from "~DBO~".CLIENTES where Codigo= O.NroAltaMAE) else '' end as OFICIALCUENTA,")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then 'FPA' else 'OPEX' end as TIPOCLI, O.ObservacDoc as NrOPEX, 'A' as ESTADO, O.ContraEspecie, O.FechaPago,")
 SQL.ADD(" O.OpSIOPEL as TipoDocum, O.ObsErrorMAE as NrDocum, ")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then (Select Alias7 from "~DBO~".CLIENTES where Codigo= O.NroAltaMAE) else '' end as NrAltamira, TotalGastos, Responsable1,  ")
 SQL.ADD(" CASE when IsNull(Origen,'') = 'TS' Then O.Plaza1 else CASE when IsNull(O.Observac3,'')='' Then 'OTROS' else O.Observac3 end end as ProdOPEX, ")
 SQL.ADD(" CASE when O.CB6 = '1' Then 'SI' else 'NO' end as Calzada ")
 
 SQL.ADD("from "~DBO~".PREBOLETOS O  ")
 SQL.ADD(" where O.FecAprobPreBol  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
 SQL.ADD(" and O.FecAprobPreBol  <= '"~IdxDate(Dialogo.Fecha2)~"' ")
 SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"' ")
 SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha4)~"' ")
 SQL.ADD("and O.TipoOp in ('FXCS','FXVS','FXACS','FXAVS') ")

 if NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("and O.NroAltaMAE In  ("~Pipe2Comillas(Dialogo.ListaTabla1)~")")
 endif
 if Dialogo.Radio1=0
    SQL.ADD("and 1 = (Select 1 from "~DBO~".CLIENTES where Codigo=O.NroAltaMAE )")
 else
   if Dialogo.Radio1=1
      SQL.ADD("and IsNull((Select 1 from "~DBO~".CLIENTES where Codigo=O.NroAltaMAE),0)=0 ")
   endif
 endif
 *No Anulado o sin Cotizar
 SQL.ADD("and O.Instancia <>1 and  O.Instancia <>5 ")
 if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.OpSIOPEL In  ("~Pipe2Comillas(Val(z1))~")")
 endif
 **
 if NoVacio(Dialogo.String1)
  SQL.ADD("and O.ObsErrorMAE = '"~Pad0(Dialogo.String1,15)~"'")
 endif
 if NoVacio(Dialogo.Lista2)
  if Incluido(Dialogo.Lista2,'SALES')
    SQL.ADD("and O.Mercado4 in ('100','101','102')")
  else
    if Incluido(Dialogo.Lista2,'PYMES')
      SQL.ADD("and O.Mercado4 in ('104','105','106','107','109','110','111','112','113','114')")
    else
      if Incluido(Dialogo.Lista2,'INSTITUTIONALS')
        SQL.ADD("and O.Mercado4 in ('103') and O.ConceptoEmp ='D01'")
      else
        if Incluido(Dialogo.Lista2,'FIN.INST')
          SQL.ADD("and O.Mercado4 in ('103') and  O.ConceptoEmp <> 'D01'")
        endif
      endif
    endif
  endif
 endif

 if NoVacio(Dialogo.Lista3)
  SQL.ADD("and O.TipoDoc In ("~Pipe2Comillas(Dialogo.Lista3)~")")
 endif

 if NoVacio(Dialogo.Lista4)
  SQL.ADD("and O.Operador In ("~Pipe2Comillas(Dialogo.Lista4)~")")
 endif

 if NoVacio(Dialogo.Lista5)
  *SQL.ADD("and O.Mercado3 In ("~Pipe2Comillas(Dialogo.Lista5)~")")
  SQL.ADD("and O.Mercado In ("~Pipe2Comillas(Dialogo.Lista5)~")")
 endif

 ****************AGUS*********************
 if NoVacio(Dialogo.Lista6)
  SQL.ADD("and O.Especie In ("~Pipe2Comillas(Dialogo.Lista6)~")")
 endif
 *****************************************

 * Oficio
 if Dialogo.Radio4=0
  SQL.ADD("and IsNull(O.Convenio,'')='OFI' ")
 else
  if Dialogo.Radio4=1
    SQL.ADD("and IsNull(O.Convenio,'')<>'OFI' ")
  endif
 endif

 SQL.ADD("UNION")
*OPMINORISTAS
 SQL.ADD("Select Case when O.TotalRetenciones=0 then O.Cantidad else O.Cantidad * O.TipoCambio2 end as CantOpeUSD ,")
 SQL.ADD("       Case when O.FechaOp <'"~IdxDate(Val(fe:1))~"'  ")
 SQL.ADD("            then O.Cantidad  ")
 SQL.ADD("                 * (Case when O.TipoOp in('FXCS','FXACS','FXPRC') then (O.TipoCambio3-O.Precio2) else (O.Precio2-O.TipoCambio3) end ) ")
 SQL.ADD("                 / (Select Precio1 from  "~DBO~".COTIZACIONES             ")
 SQL.ADD("                  Where Fecha =(Select Max(Fecha) from  "~DBO~".COTIZACIONES ")
 SQL.ADD("                                Where Month(Fecha) =Month(O.FechaOp) and Year(Fecha) = Year(O.FechaOp) and Codigo = 'COMA35' )")
 SQL.ADD("                  and Codigo = 'COMA35')")
 SQL.ADD("            else O.Cantidad ")
 SQL.ADD("                 * (Case when O.TipoOp in('FXCS','FXACS','FXPRC') then (O.TipoCambio3-O.Precio2) else (O.Precio2-O.TipoCambio3) end ) ")
 SQL.ADD("                 /"~Val(co:2))
 SQL.ADD("            end  as ResultadoUSD ,")
 SQL.ADD("   'Boletos' as TIPO, O.FechaOp as FECHAOP, O.NroAltaMAE as CLIENTE, O.TipoOp as TIPOOP, O.Especie, O.Cantidad as CANTIDAD, O.Plazo4 as PLAZO, Case When IsNull(O.Puesto,'')='' Then 'No Puesto' Else 'Puesto' End as VALOR,  Case when O.TotalRetenciones=0 then 1 Else O.TipoCambio2 End as TipoCambio2, O.PorDerechoBolsa as COTUSD, O.Precio2, O.TipoCambio3, O.TotalBrutoCli2 as MONTOARP, O.TotalBrutoCli1 as MONTOUSD, O.Operador, O.Mercado3 as EQUIPO, O.Mercado4 as ORGANIZACION, O.ConceptoEmp as SEGMENTO,  O.NrOperacion as NROPERACION, O.TotalRetenciones, O.Corredor as BROKER, O.TipoDoc as PRODUCTO, O.FechaVto, I.Nombre as Instancia,")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then (Select OficialCuenta from "~DBO~".CLIENTES where Codigo= O.NroAltaMAE) else '' end as OFICIALCUENTA,")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then 'FPA' else 'OPEX' end as TIPOCLI, O.ObservacDoc as NrOPEX, 'A' as ESTADO, O.ContraEspecie, O.FechaPago,")
 SQL.ADD(" O.OpSIOPEL as TipoDocum, O.ObsErrorMAE as NrDocum, ")
 SQL.ADD(" Case when 1 = (Select 1 from "~DBO~".CLIENTES CC WHERE CC.Codigo=O.NroAltaMAE) then (Select Alias7 from "~DBO~".CLIENTES where Codigo= O.NroAltaMAE) else '' end as NrAltamira, TotalGastos, Responsable1, ")
 SQL.ADD(" CASE when IsNull(Origen,'') = 'TS' Then O.Plaza1 else CASE when IsNull(O.Observac3,'')='' Then 'OTROS' else O.Observac3 end end as ProdOPEX, ")
 SQL.ADD(" CASE when O.CB6 = '1' Then 'SI' else 'NO' end as Calzada ")
 
 SQL.ADD("from "~DBO~".OPMINORISTAS O  ,"~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I	                        ")
 SQL.ADD("Where    O.NrOperacion = B.NrOperacion                                 				")
 SQL.ADD("    and B.Valor = '1' 					 					")
 SQL.ADD("    and I.NrInstancia = B.NrBit 									")
 SQL.ADD("    and I.Tabla = 'OPMINORISTAS'									")
 SQL.ADD(" and   O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
 SQL.ADD(" and   O.FechaOp  <= '"~IdxDate(Dialogo.Fecha2)~"' ")
 SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"' ")
 SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha4)~"' ")
 *SQL.ADD("and O.TipoOp like ('FX%') ")
 SQL.ADD("and O.TipoOp in ('FXCS','FXVS','FXACS','FXAVS','FXPRC','FXPRV') ")

 *No tomo las relacionadas a Prebol proque entran por PREBOLETOS-- Si tomo las de Prefi/Solic
 SQL.ADD("and ((O.NrOperacion4 not like ('OP%') and O.NrOperacion4 not like ('OS%')) or IsNull(O.NrOperacion4,'')='' )")

