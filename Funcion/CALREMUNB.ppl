                  scn(j:fac, (FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(x2,-(FBN['Monto2']-FBN['Monto1']))
                  acn(k:fac, 0)
               else
                  acn(k:fac, FBN['Tasa2'])
*FO 07/08                  scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  acn(x2,0)
                  acn(k:fac, 0)
                  Break
               endif
            endif

            if (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])>0
               if ABS(val(x2))>=FBN['Monto3']-FBN['Monto2']-FBN['Monto1']
                  acn(k:fac, FBN['Tasa3'])
*FO 07/08                  scn(j:fac, (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(j:fac, (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(x2,-(FBN['Monto3']-FBN['Monto2']-FBN['Monto1']))
