      *FO Esta es la primer busqueda, lo hace por CUENTA.
      *Hay que agregar BOOK en la tabla, recuperarlo y guardarlo en alguna variable para despues
      * poder insertar el MOVDEVENGADO CORRECTAMENTE.

      SQL.ADD("SELECT Monto1, Tasa1, Monto2, Tasa2, Monto3, Tasa3, Monto4, Tasa4, Monto5, Tasa5 ")
      SQL.ADD("  FROM "~DBO~".ACUERDOSCUENTA ")
      SQL.ADD(" WHERE Codigo='"~FBN['Cuenta']~"' ")
      SQL.ADD("   AND TipoAcuerdo='REM' ")
      SQL.ADD("   AND FechaAlta<="~IdxDate2(Dialogo.Fecha1))
      SQL.ADD("   AND FechaFin>="~IdxDate2(Dialogo.Fecha1))
      acn(x2, FBN['Saldo'])
      Recorrer SQL
         dfa
         if FBN['Monto1']>0
            *FO Si hay Monto1
            if ABS(val(x2))>=FBN['Monto1']
               acn(k:fac, FBN['Tasa1'])
*FO 07/08               scn(j:fac, FBN['Monto1']*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, FBN['Monto1']*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)) )
               *FO Va actualizando Saldo (x2) con el remanente 
               scn(x2,-FBN['Monto1'])
               acn(k:fac, 0)
            else
               acn(k:fac, FBN['Tasa1'])
*FO 07/08               scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               acn(x2,0)
               acn(k:fac, 0)
               Break
            endif
         endif

         if (FBN['Monto2']-FBN['Monto1'])>0
            *FO Si hay Monto2 y es mayor a Monto1. La definicion del acuerdo debe estar bien
            * definido con los montos en forma ascendente.
            if ABS(val(x2))>=FBN['Monto2']-FBN['Monto1']
               acn(k:fac, FBN['Tasa2'])
*FO 07/08               scn(j:fac, (FBN['Monto2']-FBN['Monto1'])*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, (FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               *FO Va actualizando Saldo (x2) con el remanente 
               scn(x2,-(FBN['Monto2']-FBN['Monto1']))
               acn(k:fac, 0)
            else
               acn(k:fac, FBN['Tasa2'])
*FO 07/08               scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               acn(x2,0)
               acn(k:fac, 0)
               Break
            endif
         endif

         if (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])>0
            if ABS(val(x2))>=FBN['Monto3']-FBN['Monto2']-FBN['Monto1']
               acn(k:fac, FBN['Tasa3'])
*FO 07/08               scn(j:fac, (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, (FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               scn(x2,-(FBN['Monto3']-FBN['Monto2']-FBN['Monto1']))
               acn(k:fac, 0)
            else
               acn(k:fac, FBN['Tasa3'])
*FO 07/08               scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               acn(x2,0)
               acn(k:fac, 0)
               Break
            endif
         endif

         if (FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])>0
            if ABS(val(x2))>=FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1']
               acn(k:fac, FBN['Tasa4'])
*FO 07/08               scn(j:fac, (FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, (FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               scn(x2,-(FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1']))
               acn(k:fac, 0)
            else
               acn(k:fac, FBN['Tasa4'])
*FO 07/08               scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               acn(x2,0)
               acn(k:fac, 0)
               Break
            endif
         endif

         if (FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])>0
            if ABS(val(x2))>=FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1']
               acn(k:fac, FBN['Tasa5'])
*FO 07/08               scn(j:fac, (FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, (FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               scn(x2,-(FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1']))
               acn(k:fac, 0)
            else
               acn(k:fac, FBN['Tasa5'])
*FO 07/08               scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
               scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
               acn(x2,0)
               acn(k:fac, 0)
               Break
            endif
         endif
      Proximo
