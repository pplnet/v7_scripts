                  scn(j:fac, (FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1'])*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(x2,-(FBN['Monto5']-FBN['Monto4']-FBN['Monto3']-FBN['Monto2']-FBN['Monto1']))
                  acn(k:fac, 0)
