         SQL.ADD("   AND TipoCliente='"~FBN['TipoCliente']~"' ")
         SQL.ADD("   AND FechaAlta<="~IdxDate2(Dialogo.Fecha1))
         SQL.ADD("   AND FechaFin>="~IdxDate2(Dialogo.Fecha1))
         Recorrer SQL
            dfa
            if FBN['Monto1']>0
               if ABS(val(x2))>=FBN['Monto1']
                  acn(k:fac, FBN['Tasa1'])
*FO 07/08                  scn(j:fac, FBN['Monto1']*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(j:fac, FBN['Monto1']*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(x2,-FBN['Monto1'])
                  acn(k:fac, 0)
               else
                  acn(k:fac, FBN['Tasa1'])
*FO 07/08                  scn(j:fac, val(x2)*val(k:fac)*(Dialogo.Fecha1-Habiles(Dialogo.Fecha1,-1,var('FERIDEF'),SI))/(100*Diasa(2,Dialogo.Fecha1)))
                  scn(j:fac, val(x2)*val(k:fac)*Val(z:4)/(100*Diasa(2,Dialogo.Fecha1)))
                  acn(x2,0)
                  acn(k:fac, 0)
                  Break
               endif
            endif

            if (FBN['Monto2']-FBN['Monto1'])>0
               if ABS(val(x2))>=FBN['Monto2']-FBN['Monto1']
                  acn(k:fac, FBN['Tasa2'])
