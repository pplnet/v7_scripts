def WordWrap(txt, cantCaracteres)

    *El primer parámetro debe ser string (texto) y el segundo debe ser número.
    *Le inserta saltos de línea al string pasado como 1º parámetro cada vez que llega a la cantidad de caracteres indicado en el segundo parámetro.
    *Siempre busca espacios en blanco para aplicar los saltos de línea.
    *La función devuelve el texto con los saltos de línea insertados.

    *************
    *VARIABLES
    *************

    *El &Largo es en realidad el ancho en cantidad de caracteres definido por quien usa la función
    let &Largo cantCaracteres

    *El texto pasado por el usuario se limpia de dobles espacios y saltos de línea
    let &Texto Reemplazar(txt,Chr(10)," ")
    let &Texto Reemplazar(&Texto,"  "," ")
    *Se le inserta un espacio al final para que el algoritmo funcione correctamente
    let &Texto (Mirt(Trim(&Texto)) ~ " ")

    *El texto final será el texto que la función retorne
    let &TextoFinal ""

    *Las posiciones retrocedidas y 'posiciones retrocedidas acumuladas' cuentan la cantidad de caracteres que se retrocedió buscando espacios en blanco
    let &PosRetrocedidas 0
    let &PosRetroAcum 0

    *La variable FilasAumentadas se irá incrementando en 1 cada vez que las posiciones retrocedidas igualen o superen a la cantidad de caracteres establecidos de ancho
    let &FilasAumentadas 0

    *La variable CantFilas representa la cantidad de filas que el ciclo debe recorrer. No es constante. Cada vez que la cantidad de caracteres retrocedidos
    *superan el largo de una línea, la variable CantFilas se incrementa en 1.
    let &CantFilas (Round2(Longitud(&Texto) / &Largo) + 1)

    *La variable &i representa la fila actual:
    let &i 1

    ****************************
    *INICIO DEL CICLO PRINCIPAL
    ****************************

    *Recorro desde la fila 1 hasta la última que necesito (esta última fila puede variar).
    
    while 
    
        if (&i <= &CantFilas)
            
            ***********************************************************************************************************
            *Si el caracter posicionado justo en el ancho definido es un espacio en blanco, se inserta un salto de línea
            ***********************************************************************************************************
            
            if (EqStr(Copy(&Texto, (&i * &Largo) - &PosRetroAcum + 1, 1), " "))
                
                *Se copia la parte de la cadena
                let(&TextoFinal, &TextoFinal ~ Mirt(Trim(Copy(&Texto, (((&i - 1) * &Largo) + 1) - &PosRetroAcum, &Largo))) ~ Chr(10))
                    
            else
                
                Recorrer&j 1, &Largo
                
                *************************************************************************************************************************************
                *Si el ultimo caracter de la linea no es un espacio en blanco, se retrocede hasta encontrar uno y se cuentan los lugares retrocedidos
                *************************************************************************************************************************************
                
                    if (EqStr(Copy(&Texto, (&i * &Largo) - &PosRetroAcum + 1 - &j, 1), " "))
                            
                        let(&PosRetrocedidas, &j - 1)

                        let(&TextoFinal, &TextoFinal ~ Mirt(Trim(Copy(&Texto, ((&i - 1) * &Largo) + 1 - &PosRetroAcum, &Largo - &PosRetrocedidas))) ~ Chr(10) ~ Chr(13))
                                
                        *Una vez que llegamos al caracter en blanco, guardamos cuántos caracteres retrocedimos y rompemos el ciclo interno
                        let(&PosRetroAcum, &PosRetroAcum + &PosRetrocedidas)
                        
                        break
                        
                    endif
                    
                Proximo
                
            endif
            
            
            **********************************************************************************************
            *Si las posiciones retrocedidas superan el largo de una fila, se incrementa el tope del ciclo
            **********************************************************************************************
            if (&PosRetroAcum >= &Largo * (&FilasAumentadas + 1))
            
                let(&FilasAumentadas, &FilasAumentadas + 1)
                let(&CantFilas, &CantFilas + 1)
                
            endif
            
            let(&i, &i + 1)
            
           
        *Si la fila actual supera la cantidad de filas totales, terminar el ciclo y retornar.
        else
            break
        endif
        
    next
    
    return &TextoFinal  
    
end