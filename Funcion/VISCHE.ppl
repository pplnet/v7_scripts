***---Funcion llamada desde el evento anulacion de Cheques 

IF Val(VI:1) = 1
    ***---Llamada desde Evento ANUCHE
    ACT(A:fac, fbn('Chequera'))
    IF Eqstr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo', fbn('CNFormaPago')), 'CAN') O Eqstr(fbn('Usado'), 'Tran')
        ACT(B:fac, fbn('Cliente2'))
        ACT(C:fac, fbn('Cuenta2'))
    ELSE
        ACT(B:fac, fbn('Cliente1'))
        ACT(C:fac, fbn('Cuenta1'))
    ENDIF
    ACT(D:fac, fbn('Proveedor'))
    ACD(E:fac, fbn('FechaEmision'))
    ACN(F:fac, fbn('NrCheque'))
    ACT(G:fac, fbn('NrComprobante'))
    ACN(H:fac, fbn('Monto'))
    ACT(I:fac, fbn('Observaciones'))
    IF Eqstr(fbn('Estado'), 'ASI')
        ACT(J:fac, 'Asignado')
    ENDIF
    IF Eqstr(fbn('Estado'), 'PEN')
        ACT(J:fac, 'Pendiente')
    ENDIF
    IF Eqstr(fbn('Estado'), 'ANU')
        ACT(J:fac, 'Anulado')
    ENDIF
    IF Eqstr(fbn('Estado'), 'ENT')
        ACT(J:fac, 'Entregado')
    ENDIF
ELSE
    ***---Cheque en Blanco
    ACT(A:fac, Dialogo.Chequera1)
*    ACT(C:fac, BuscarCampo('CNFORMASPAGOCOBRO','Cuenta','Codigo',Dialogo.CNFormaPago1))
    ACT(C:fac, Dialogo.Cuenta1)
    ACT(B:fac, BuscarCampo('CUENTAS','Comitente','Codigo',Val(C:fac)))
    ACT(D:fac, '')
    ACD(E:fac, Hoy)
    ACN(F:fac, Dialogo.Entero1)
    ACT(G:fac, '')
    ACN(H:fac, 0)
    ACT(I:fac, 'Cheque en Blanco')
    ACT(J:fac, '')
ENDIF


CrearListBox             ; 'Arial,8,'
    'NrChequera'         ;A:FAC..A:FAC;NO;;;70;STRING;;RGB(220,220,193);
    'Banco'              ;B:FAC..B:FAC;NO;;;70;STRING;;RGB(220,220,193);
    'Cuenta'             ;C:FAC..C:FAC;NO;;;70;STRING;;RGB(220,220,193);
    'Proveedor'          ;D:FAC..D:FAC;NO;;;70;STRING;;RGB(220,220,193);
    'Fecha Emision'      ;E:FAC..E:FAC;NO;;;100;FECHA;RGB(220,220,193);
    'NrCheque'           ;F:FAC..F:FAC;NO;;;80;NUMERO;'###,###,###,###,###';RGB(220,220,193);
    'Transaccion'        ;G:FAC..G:FAC;NO;;;60;STRING;;RGB(220,220,193);
    'Monto'              ;H:FAC..H:FAC;NO;;;80;NUMERO;'###,###,###,###,###.##';RGB(220,220,193);
    'Observaciones'      ;I:FAC..I:FAC;NO;;;100;STRING;;RGB(220,220,193);
    'Estado'             ;J:FAC..J:FAC;NO;;;70;STRING;;RGB(220,220,193);
FinListBox

IF Not Ok
    ACN(VI:1, 1)
ELSE
    ACN(VI:1, 0)
ENDIF
