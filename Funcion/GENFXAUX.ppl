    SQL.ADD("insert into "~dbo~".OPERACIONES (")
    SQL.ADD(" TipoOp, Especie, Cliente1, Cantidad,")
    SQL.ADD(" Precio1, TotalBrutoCli1, ContraEspecie, NrOperacion,")
    SQL.ADD(" FechaOp, FechaVto, FechaPago,")
    SQL.ADD(" Corredor, Comision,PorComision, TotalComisiones,")
    SQL.ADD(" Vehiculo1, ConceptoBCRA,")
    SQL.ADD(" Operador, TablaFeriados1, ValorRB1,")
    SQL.ADD(" Puesto, FormaLiquidacion1, Cuenta1,")
    SQL.ADD(" Arbitraje, PaseCB, Cotizacion1,")
    SQL.ADD(" TotalBrutoCli2, ")
    SQL.ADD(" FechaCarga, FechaCargaSys, NroAltaMAE, ")
    SQL.ADD(" Mercado, Mercado2 ")
    SQL.ADD(") values (")
    ACT(t61, GetNumerador(35))
    SQL.ADD(" '"~Val(t2)~"', '"~Val(t3)~"', '"~Val(t36)~"', "~FStr(Val(t15),0,2)~",")
    SQL.ADD(" "~FStr(Val(t12),0,8)~", "~FStr(Val(t15)*Val(t12),0,2)~", '"~Val(t4)~"', '"~Val(t61)~"',")
    SQL.ADD(" '"~IdxDate(Val(t5))~"', '"~IdxDate(Val(t10))~"', '"~IdxDate(Val(t11))~"',")
    SQL.ADD(" '"~Val(t75)~"', "~FStr(Val(t:76),0,8)~", "~FStr(Val(t:76),0,8)~", "~FStr(Val(t:77),0,2)~",")
    SQL.ADD(" '"~Val(t18)~"', '',")
    SQL.ADD(" '"~Val(t39)~"', '"~Val(t8)~"', '"~FStr(Val(t7),0)~"',")
    SQL.ADD(" '"~FStr(Val(t6),0)~"', '"~FStr(Val(t21),0)~"', '"~Val(t41)~"',")
    SQL.ADD(" '0', '0', "~FStr(Cotizacion(Val(t4),,,,Val(t5),1),0)~",")
    if Incluido(Val(t4),'USD|USB')
      ACN(x3, Val(t15))
    else
      ACN(x3, Val(t15)/Cotizacion(Val(t4),,,,Val(t5),1))
    endif
    SQL.ADD(" "~FStr(Val(x3),0,2)~",")
    SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~Val(t62)~"', ")
    SQL.ADD(" '"~Val(ME:1)~"', '"~Val(MC:1)~"') ")
    SQL.NEW
    recorrer&I 1,70
      ACT(x2, FStr(&I,1,0))
      if Incluido(Val(x2),'1|3|7|8|10|30|70')
        SQL.ADD(" Insert into "~dbo~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
        SQL.ADD(" Values ('"~Val(t61)~"',"~Fstr(&I,1,0)~",'0') ")
        SQL.NEW
      endif
    proximo
    SQL.ADD("Update "~dbo~".OPERACIONESBITS Set Valor='1' where NrBit=1 and NrOperacion='"~Val(t61)~"'")
    SQL.NEW
    SQL.EXEC
