***---Intereses Pte. con CER. RENTA PURA
SQL.ADD(" Select '' NrTrans, 'DEP' TipoTr2, T.NrTrans NrOperacionRef1, T.Vehiculo1, T.Cliente1, ")
SQL.ADD(" E.Cotiza Especie, T.Fecha1, CASE E.IndiceEnPrecio WHEN 'SI ' THEN ")
SQL.ADD("                                   ((T.Precio2+T.Precio3)/T.Cambio3)*T.Cantidad1/100 ELSE  ")
SQL.ADD("                                   (T.Precio2+T.Precio3)*T.Cantidad1/100 END Cantidad1, ")
SQL.ADD(" 0 Precio1, T.Especie EspOp, '' ContraEspecie, T.TipoTr2 TipoOp, 0 Spread, ")
SQL.ADD(" 0 TotalIntereses, "~Val(MC:1)~" NrMov, '"~Var('INTCUPONIN')~"' Leyenda, ")
SQL.ADD(" E.Cotiza EspecieMov, '' OpeMov, 0 as BD1, 1 as BD3, ")
SQL.ADD(" T.FechaCargaSys FechaContable, T.Fecha1 FechaValor, ")
SQL.ADD(" CASE O.Cartera WHEN "~Val(OT:3)~" THEN  '"~Val(OT:1)~"' ELSE '"~Val(OT:2)~"' END Origen, ")
SQL.ADD(" '' Instante, '' SubInstante, '' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, TL.Cuenta2 as CuentaDestino ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O,"~DBO~".TRANSACCIONES2 TL ")
SQL.ADD(" Where T.TipoTr2 IN ('CUPON') ")
SQL.ADD(" AND T.Especie = E.Codigo ")
SQL.ADD(" AND T.NrOperacionRef1 Is Not Null ")
SQL.ADD(" AND (T.Precio2 > 0 OR T.Precio3 > 0) ")
SQL.ADD(" AND T.Cantidad1 <> 0 ")
SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND TL.TipoTr2 ='CCUPON' and TL.Especie=T.Especie2 and TL.Cupon1=T.Cupon1 AND TL.Vehiculo1=T.Vehiculo1 ")
***---Busco Cartera en Operaciones
SQL.ADD(" AND T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND T.NrTrans Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = T.NrTrans ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:1)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If Vacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and T.TipoTr2 In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and E.Cotiza='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND E.Indexado = 'SI' ")

SQL.ADD(" UNION ")

***---Intereses Pte. con CER. INDICE PURO
SQL.ADD(" Select '' NrTrans, 'DEP' TipoTr2, T.NrTrans NrOperacionRef1, T.Vehiculo1, T.Cliente1, ")
SQL.ADD(" E.Cotiza Especie, T.Fecha1, ")
SQL.ADD(" CASE E.IndiceEnPrecio WHEN  'SI ' THEN ")
SQL.ADD(" ((T.Precio2+T.Precio3)*T.Cantidad1/100) - ((T.Precio2+T.Precio3)/T.Cambio3)*T.Cantidad1/100 ELSE ")
SQL.ADD(" T.Cambio3*T.Cantidad1/100 END Cantidad1, ")
SQL.ADD(" 0 Precio1, ")
SQL.ADD(" T.Especie EspOp, '' ContraEspecie, T.TipoTr2 TipoOp, 0 Spread, 0 TotalIntereses, ")
SQL.ADD(" "~Val(MC:1)~" NrMov, '"~Var('IDXRESULT')~"' Leyenda, E.Cotiza EspecieMov, '' OpeMov, ")
SQL.ADD(" 0 as BD1, 1 as BD3, T.FechaCargaSys FechaContable, T.Fecha1 FechaValor, ")
SQL.ADD(" CASE O.Cartera WHEN "~Val(OT:3)~" THEN '"~Val(OT:1)~"' ELSE '"~Val(OT:2)~"' END Origen, ")
SQL.ADD(" '' Instante, '' SubInstante, '' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, TL.Cuenta2 as CuentaDestino ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O,"~DBO~".TRANSACCIONES2 TL ")
SQL.ADD(" Where T.TipoTr2 IN ('CUPON') ")
SQL.ADD(" AND T.Especie = E.Codigo ")
SQL.ADD(" AND T.NrOperacionRef1 Is Not Null ")
SQL.ADD(" AND T.Cambio3 > 0 ")
SQL.ADD(" AND T.Cantidad1 <> 0 ")
SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND TL.TipoTr2 ='CCUPON' and TL.Especie=T.Especie2 and TL.Cupon1=T.Cupon1 AND TL.Vehiculo1=T.Vehiculo1 ")
***---Busco Cartera en Operaciones
SQL.ADD(" AND T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND T.NrTrans Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = T.NrTrans ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:1)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If Vacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and T.TipoTr2 In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and E.Cotiza='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND E.Indexado = 'SI' ")

