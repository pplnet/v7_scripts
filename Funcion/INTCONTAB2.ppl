SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:1)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If Vacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   If NoVacio(Dialogo.Lista2)
