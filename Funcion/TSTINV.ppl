Eqstr(VAR('TESTINVCTL'),'NO') o [[DesciendedeCliente(CLIENTE, 'CLIENTES') y [EqStr(BuscarCampo('Clientes','PerfilInv','Codigo',CLIENTE), 'Calificado') o [eqStr(BuscarCampo('Clientes','TestInv','Codigo',CLIENTE), 'SI') y NumF(BuscarCampo('Clientes','FechaVtoTest','Codigo',CLIENTE))+364 >= FECHAORDEN]]] o Not [DesciendedeCliente(CLIENTE, 'CLIENTES')]]; 'El perfil del inversor debe ser Calificado o tener un test vigente'; Not [VAR('PERFINVBLO')];SI;FSys;'TESTINV'
