*** Toma las cuentas con saldos 1 y de cartera propia de SaldosDia ***
*** No toma en cuenta los saldos en opciones de la especie ***
***  SQL.ADD("  and  Mercado = '"~Val(j2)~"'  ")

SQL.ADD("Select Especie, Cliente, Cuenta, Mercado, ")
SQL.ADD("       EnteCustodia, NrSaldo, Max(Fecha) as Fe from "~DBO~".SALDOSDIA ")
SQL.ADD("where  Especie = '"~Val(b2)~"'  ")
SQL.ADD("  and  Fecha <= '"~IdxDate(Val(g2))~"' ")
SQL.ADD("  and NrSaldo = 1 ")
SQL.ADD("  and CallPut is Null ")
SQL.ADD("group by  Especie, Cliente, Cuenta, Mercado, EnteCustodia, NrSaldo ")
SQL.ADD("order by  NrSaldo, Cliente, Cuenta ")

SetFilaActual(10)

Recorrer SQL
  act(a:fac,fbn['Cliente'])
  act(b:fac,BuscarCampo('Clientes','RazonSocial','Codigo',fbn['Cliente']))
  If fbn['NrSaldo'] = 5
     act(c:fac,fbn['Cuenta'])
    else
     act(c:fac,'Cartera')
  endif
  acn(d:fac,SaldoC(fbn['Cliente'],fbn['Especie'],,,,fbn['Mercado'],fbn['EnteCustodia'],fbn['Cuenta'],fbn['NrSaldo'],fbn['Fe']))
  acn(e:fac,fbn['NrSaldo'])
  act(f:fac,fbn['Especie'])
  act(g:fac,fbn['Cuenta'])
  act(h:fac,fbn['EnteCustodia'])
Proximo

ACN(aa1,0)

ACO(1,7)
ACO(2,32)
ACO(3,8)
ACO(4,11)

ListBox(a11..d:fac, 'Cliente                                     Tenencia')
AlinearCeldas(a11..d:fac,'I')

if Ok 
  RecorrerSel
    *** Genera la transaccion cupon *** 
    acn(aa1,1)
    act(z2,'CUPON')

    If val(e:FilaCiclo) = 1
       act(x2,'0')
      else
       act(x2,'1')
    endif

    if val(d:FilaCiclo) <> 
       ACT(z4,GetNumerador(BuscarCampo('VEHICULOS','Alias2','Codigo',FBN['Mercado']))) 

       ** Ingreso Transaccion2 **
       SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
       SQL.ADD("(TipoTr2, Especie, Cliente1, Cantidad1, ")
       SQL.ADD(" Fecha1, Fecha2, FechaCargaSys, Vehiculo1, NrTrans, Cuenta1, ")
       SQL.ADD(" Bit7, Especie2, Cambio1, RB1, Precio1, Precio2, CB1 ) ")
       SQL.ADD("Values")
       SQL.ADD("('"~Val(z2)~"', '"~val(f:FilaCiclo)~"', ")
       SQL.ADD(" '"~val(a:FilaCiclo)~"', "~FStr(val(d:FilaCiclo),0,4)~", ")
       SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~IdxDate(FSYS)~"', '"~IdxDate(FSYS)~"', ")
       SQL.ADD(" '"~FBN['Mercado']~"', '"~Val(z4)~"', '"~val(g:FilaCiclo)~"', ")
       SQL.ADD(" 1, '"~Val(b4)~"', "~FStr(Val(m2),0,0)~", '"~val(h:FilaCiclo)~"', ")
       SQL.ADD(" "~FStr(Val(k2),0,7)~", "~FStr(Val(l2),0,7)~", '"~Val(x2)~"' ) ")
       SQL.NEW
   
       *** Ingreso los movimientos ejecutados de suma del cupon: saldo 1, 2, y 5 *****
       if val(e:FilaCiclo) = 5
          SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
          SQL.ADD("(Especie, Cliente, Cantidad, ")
          SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
          SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan )")
          SQL.ADD("Values")
          SQL.ADD("( '"~Val(b4)~"', '"~val(a:FilaCiclo)~"', ")
          SQL.ADD("  "~FStr(val(d:FilaCiclo),0,4)~", '"~IdxDate(Val(g2))~"', ")
          SQL.ADD("  '"~Val(z4)~"', '"~val(g:FilaCiclo)~"', 'Corte de Cupon "~val(f:FilaCiclo)~"', ")
          SQL.ADD("  5, '"~FBN['Mercado']~"', ")
          SQL.ADD("  'MI', 0, '"~IdxDate(Fsys)~"', 0, 0, 0 )")
          SQL.NEW

          If EqStr(val(a:FilaCiclo),FBN['Mercado'])
             SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
             SQL.ADD("(Especie, Cliente, Cantidad, ")
             SQL.ADD(" FechaMov, NrOperacion, Leyenda, NrSaldo, Mercado, ")
             SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan )")
             SQL.ADD("Values")
             SQL.ADD("( '"~Val(b4)~"', '"~val(a:FilaCiclo)~"', ")
             SQL.ADD("  "~FStr(val(d:FilaCiclo),0,4)~", '"~IdxDate(Val(g2))~"', ")
             SQL.ADD("  '"~Val(z4)~"', 'Corte de Cupon "~val(f:FilaCiclo)~"', ")
             SQL.ADD("  2, '"~FBN['Mercado']~"', ")
             SQL.ADD("  'MI', 0, '"~IdxDate(Fsys)~"', 0, 0, 0 )")
             SQL.NEW
          endif
       endif

       SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
       SQL.ADD("(Especie, Cliente, Cantidad, ")
       SQL.ADD(" FechaMov, NrOperacion, Leyenda, NrSaldo, Mercado, ")
       SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia )")
       SQL.ADD("Values")
       SQL.ADD("('"~Val(b4)~"', '"~val(a:FilaCiclo)~"', ")
       SQL.ADD(" "~FStr(val(d:FilaCiclo),0,4)~", '"~IdxDate(Val(g2))~"', ")
       SQL.ADD(" '"~Val(z4)~"', 'Corte de Cupon "~val(f:FilaCiclo)~"', ")
       SQL.ADD("  1, '"~FBN['Mercado']~"', ")
       SQL.ADD("  'MI', 0, '"~IdxDate(Fsys)~"', 0, 0, 0, '"~val(h:FilaCiclo)~"' )")
       SQL.NEW
       SQL.EXEC
    endif
  Proximo  
endif


