act(a:val(cd3)+val(cf1)+10,'Total Entidad '~VAR('MONEEXTR'))
act(a:val(cd3)+val(cf1)+11,'Lim. Asignado '~VAR('MONEEXTR'))
act(a:val(cd3)+val(cf1)+12,'Disponible '~VAR('MONEEXTR'))
SetFont(a:val(cd3)+val(cf1)+10..a:val(cd3)+val(cf1)+12,3)
AgregarMarco(a:val(cd3)+val(cf1)+10..a:val(cd3)+val(cf1)+12,2,0,Exe('COLOR6'))

acn(cj1,3)
Recorrer&j 1, val(ci1)
  ACN(val(cj1):val(cd3)+val(cf1)+8, Val(ch:&j))
  **ACN(val(cj1)-1:val(cd3)+val(cf1)+8, Val(cw:&j))
  acn(val(cj1):val(cd3)+val(cf1)+10, LimConsumido(val(val(cj1)-1:val(cd1)),'COTOR',VAR('MONEEXTR'),0,,,,,Dialogo.Fecha1) )
  acn(val(cj1):val(cd3)+val(cf1)+10, SQL(" Select Sum(Monto) From "~DBO~".MOVLIMITES Where Cliente = '"~val(val(cj1)-1:val(cd1))~"' AND Limite = 'COTOR' AND FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' "))
  acn(val(cj1):val(cd3)+val(cf1)+11,LimAsignado(val(val(cj1)-1:val(cd1)),'COTOR',VAR('MONEEXTR')))
  acn(val(cj1):val(cd3)+val(cf1)+12,val(val(cj1):val(cd3)+val(cf1)+11)-val(val(cj1):val(cd3)+val(cf1)+10))
  SetFont(val(cj1)-1:val(cd3)+val(cf1)+8..val(cj1):val(cd3)+val(cf1)+12,3)
  FormatoCeldas(val(cj1)-1:val(cd3)+val(cf1)+8..val(cj1):val(cd3)+val(cf1)+8,Exe('F2'))
  FormatoCeldas(val(cj1):val(cd3)+val(cf1)+12..val(cj1):val(cd3)+val(cf1)+12,Exe('F2'))
  AgregarMarco(val(cj1)-1:val(cd3)+val(cf1)+10..val(cj1):val(cd3)+val(cf1)+12,2,0)
  scn(cj1,2)
Proximo


ACT(a:val(cd3)+val(cf1)+8, 'Consolidado Entidad:')
SetFont(a:val(cd3)+val(cf1)+8, 3)
AgregarMarco(a:val(cd3)+val(cf1)+8..Val(cj1)-2:val(cd3)+val(cf1)+8,2,0,Exe('COLOR8'))

SCN(cd3, 1)