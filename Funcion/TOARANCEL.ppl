TotalAux3              : 'Monto Comision'         ;10;2;;NO;  ;;;;0;IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,MontoArancelC(TIPOOP,CLIENTE,ESPECIE,VEHICULO,'AOPER',IF(RB1=0,CANTIDADENPROCESO,PRECIOEJERCICIO),0,,VTXT1,SI),0);;;;;'###,###,###,###.##';
TotalIVA               : 'Monto IVA'              ;11;2;;NO;  ;;;;0;IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,TOTALAUX3*IMPUESTOS,0);;;;;'###,###,###,###.##';

Aranceles              : 'Comision/100'           ;1;1;1;NO;NO;;;;IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,MontoArancelC(TIPOOP,CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADENPROCESO,4,,VTXT1,SI)/100,0);IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,MontoArancelC(TIPOOP,CLIENTE,ESPECIE,VEHICULO,'AOPER',IF(RB1=0,CANTIDADENPROCESO,PRECIOEJERCICIO),4,,VTXT1,SI)/100,0);;;;;'############.########';
Impuestos              : 'IVA Com/100'            ;;;;NO;NO;;;;IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,Var('IVA')+IF(EqStr(IVA(CLIENTE),'NOI'),VAR('RNI'),IF(EQSTR(BUSCARCAMPO('CLIENTES','RES3125','CODIGO',CLIENTE),'SI'),Var('RG3337'),0))/100,0);IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,Var('IVA')+IF(EqStr(IVA(CLIENTE),'NOI'),VAR('RNI'),IF(EQSTR(BUSCARCAMPO('CLIENTES','RES3125','CODIGO',CLIENTE),'SI'),Var('RG3337'),0)),Var('IVA'))/100,0);;;;;'############.####';
MinArancel             : 'Comision Minima'        ;;;;NO;NO;;;;0;IF(CANTIDADTOTALORDEN<>0 O PRECIOEJERCICIO<>0,MontoArancelC(TIPOOP,CLIENTE,ESPECIE,VEHICULO,'AOPER',IF(RB1=0,CANTIDADENPROCESO,PRECIOEJERCICIO),1,,VTXT1,SI),0);;;;;'############.####'; 
VCAN1                  : '% Comi. Minimo'         ;;;;NO;NO;;;;0;MINARANCEL/IF(RB1=0,CANTIDADTOTALORDEN*IF(PRECIOLIMITE=0,PRECIOREAL,PRECIOLIMITE),PRECIOEJERCICIO/VCAN3);;;;;'############.########'; 

