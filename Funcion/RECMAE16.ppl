*         1|111111|111222|22222|2233|333333|33444|44444445
*1234567890|123456|789012|34567|8901|234567|89012|34567890
*0048003801|060313|133736|37493|0302|060313|37421|093101
*0048000000|060313|133736|37493|0402|060313|37422|003801

Message('----- Mensaje de Baja Operacion Oferta MAE1')
ACT(t:1, 'OFEBAJ')
ACT(t:2, Copy(Val(a:FAC),11,6))
ACT(t:3, Copy(Val(a:FAC),17,6))
ACT(t:4, Copy(Val(a:FAC),23,5))
ACT(t:5, Copy(Val(a:FAC),28,4))
ACT(t:6, 'ING')
ACT(t:7, Copy(Val(a:FAC),1,250))
if Longitud(Val(a:FAC))>250
  ACT(t:8, Copy(Val(a:FAC),251,250))
endif
if Longitud(Val(a:FAC))>500
  ACT(t:9, Copy(Val(a:FAC),501,250))
endif
(.'GRAMENMAE'.)
