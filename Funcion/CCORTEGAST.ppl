ACN(SA:1, 0)
Recorrer&j 1, fac
    ***---Sumo las cantidades seleccionadas de los 'CLI'
    IF Val(A:&j) = 1 Y Not Eqstr(Val(l:&j), Val(aa:4))
        SCN(SA:1, Val(g:&j))
    ENDIF
Proximo

***---Distribuyo los Gastos
***---PP: WHT
***---QQ: Total Gastos
***---V: Gastos
***---WW: Iva Gastos
Recorrer&K 1, fac
    ***---Gastos para cada 'CLI'. Los del vehiculo no los voy a sacar de aca.
    ACN(PP:&K, Val(g:&K)*Val(CA:3)/Val(SA:1) )
    ACN(QQ:&K, Val(g:&K)*Val(CA:6)/Val(SA:1) )
    ACN(V:&K,  Val(g:&K)*Val(CA:4)/Val(SA:1) )
    ACN(WW:&K, Val(g:&K)*Val(CA:5)/Val(SA:1) )
Proximo