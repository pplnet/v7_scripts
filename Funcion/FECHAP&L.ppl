ACD(FF:FAC,FBN['FechaOp'])
ACD(GG:FAC,FBN['FechaVto'])

If EqStri(FBN['TipoOp'], 'MMCREM')
*Fecha Desde
    IF Val(FF:FAC) < Dialogo.Fecha1 
        ACD(CC:1, Dialogo.Fecha1)
    ELSE
        ACD(CC:1,Val(FF:FAC))
    ENDIF 
*Fecha Hasta
    IF Val(GG:FAC) < Dialogo.Fecha2 
        ACD(CC:2, Val(GG:FAC))
    ELSE
        ACD(CC:2,Dialogo.Fecha2 )         
    ENDIF
ELSE
    *Fecha Desde
    IF Val(FF:FAC) < Dialogo.Fecha1 
        ACD(CC:1, Dialogo.Fecha1)
    ELSE
        ACD(CC:1,Val(FF:FAC))
    ENDIF
    *Fecha Hasta
    IF Val(GG:FAC) < Dialogo.Fecha2 
        ACD(CC:2, Val(GG:FAC))
    ELSE
        IF Eqstr(Fecha(Val(GG:FAC),'yyyy/mm/dd'),Fecha(Dialogo.Fecha2,'yyyy/mm/dd'))
            ACD(CC:2, Val(GG:FAC))
        ELSE
            ACD(CC:2,Dialogo.Fecha2 + 1)
        ENDIF                
    ENDIF
ENDIF
    
&DifDias2 := DifDias(Val(CC:2),Val(CC:1),no,no)

