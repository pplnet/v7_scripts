SQL.ADD(" Select O.NrOperacion, O.Cantidad, O.Especie, O.Vehiculo1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp = 'MMCP' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND ((O.FechaVto > '"~IdxDate(Dialogo.Fecha2)~"') OR (O.FechaVto = '"~IdxDate(Dialogo.Fecha2)~"' AND O.RB4 Is Null)) ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.NrOperacion, Sum(C.Cantidad1) Cantidad, O.Especie, O.Vehiculo1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp = 'MMCPM' ")
***---SQL.ADD(" AND C.Fecha2 >= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND ((C.Fecha2 > '"~IdxDate(Dialogo.Fecha2)~"') OR (C.Fecha2 = '"~IdxDate(Dialogo.Fecha2)~"' AND O.RB4 Is Null)) ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")
SQL.ADD(" Group By O.NrOperacion, O.Especie, O.Vehiculo1 ")
SQL.ADD(" Order By 3 ")
