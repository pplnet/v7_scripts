*** DIOPCI
*** Toma las Opciones y modifica el Precio, el Notional y la Cantidad

Message('Procesando Opciones ...')

SQL.ADD("SELECT O.* ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and O.Cupon1  = '"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and O.FechaOp  <='"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and O.FechaVto > '"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and FechaEj > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and (CB8 is Null or CB8 = '0' ) ")
SQL.ADD("and (RB4 is Null or RB4 = '0' ) ")
SQL.ADD("and TipoOp='DSEO' ")

Recorrer SQL
 
   Message('Opciones  :'~FBN['TipoOp']~' '~FBN['NrOperacion'])   

   act(a:fac,fbn['Cliente1'])
   act(b:fac,fbn['TipoOp'])
   act(c:fac,fbn['Vehiculo1'] )   
   acn(d:fac,fbn['Cantidad'] )
   act(e:fac,fbn['TipoOp'])
   act(f:fac,fbn['NrOperacion'])

   *-- calcula e: Notional Amount      
   IF Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Dialogo.Especie1),'CLE')
      acn(g:fac,fbn['PrecioEj']*FBN['Cantidad']*Val(e3))
   EndIf
Proximo
	
