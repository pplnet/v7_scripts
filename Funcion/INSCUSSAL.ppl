           * FO 12/05/06 Numerador 28 reemplaza al 1
           ACT(z2,GetNumerador(28))

           Message('*- Elimino la transacciones CUSSAL Anterior ... ')

           SQL.ADD("SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 Where TipoTr2='CUSSAL' ")
           SQL.ADD("and Precio1="~Fstr(IIF(Dialogo.Radio2=0,Dialogo.Entero1,Dialogo.Entero4),0,0)~" ")
           SQL.ADD("and Precio2="~Fstr(Dialogo.Entero2,0,0)~" ")
           SQL.ADD("and (Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or (Fecha1<>'"~IdxDate(Dialogo.Fecha2)~"' and CB1='0') ) ") 
           SQL.ADD("and Cliente1='"~val(z7)~"' and Ley3='"~val(z21)~"' and RB2='"~Fstr(Dialogo.Radio2,0,0)~"' ")
           Recorrer SQL
              DFA
              SQL.ADD("DELETE "~DBO~".MOVPENDIENTES WHERE NrOperacion='"~FBN['NrTrans']~"' ")
              SQL.NEW           

              SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS  WHERE NrOperacion='"~FBN['NrTrans']~"' ")
              SQL.NEW           

              SQL.ADD("DELETE "~DBO~".TRANSACCIONES2 WHERE NrTrans='"~FBN['NrTrans']~"' ")
              SQL.NEW           
              SQL.EXEC
           Proximo

           *- Genero la Transaccion CUSSAL por cobro de comision de Saldos
           SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
           SQL.ADD("(Vehiculo1,Fecha1,Cliente1,Cantidad6,Cuenta1,Especie,")
           SQL.ADD(" NrTrans,TipoTr2,Precio1,Precio2,Ley1,Ley2,Cantidad2,Cambio5,Cantidad3,")
           SQL.ADD(" CB1,Ley3,RB2) Values ")
           SQL.ADD("('"~val(z6)~"','"~IdxDate(Dialogo.Fecha2)~"','"~val(z7)~"',"~Fstr(Abs(val(l:fac)),0,2)~",")
           SQL.ADD(" '"~val(z3)~"','"~VAL(ml1)~"','"~val(z2)~"','CUSSAL',"~Fstr(IIF(Dialogo.Radio2=0,Dialogo.Entero1,Dialogo.Entero4),0,0)~" ,"~Fstr(Dialogo.Entero2,0,0)~",'"~val(z9)~"','"~val(z10)~"',")
           SQL.ADD(" "~Fstr(Abs(val(l:fac)),0,2)~","~Fstr(Abs(val(p:fac)),0,2)~","~Fstr(Abs(val(q:fac)),0,2)~",")
           SQL.ADD(" '"~val(ft1)~"','"~val(z21)~"','"~Fstr(Dialogo.Radio2,0,0)~"') ")
           SQL.NEW
           SQL.EXEC

           *- Actualizo el Movimiento de la transaccion
           * SQL.ActualizarMovimientosT2(val(z2),SI,NO,NO,NO)
           * SQL.EXEC

           *- mp1: Nro. Transaccion mp2: Fecha Movimiento mp3: Cliente 
           *- mp4: Especie mp5: CallPut mp6: FechaEj mp7: PrecioEj mp8: Mercado
           *- mp9: EnteCustodia mp10: Cantidad mp11: Formula mp12: Leyenda mp13: Bits mp14: NrSaldo  mp15: NrGrupo
           *- mp16: Concepto (NrSaldo Original)
           *- mp19: Cuenta mp22: Nro. de Movimiento mp20: NrGrupo2
           *- mp27: Cupon  mp23: Com.Renta mp25: Com.Amortizacion
           *- mp50: Leyendo para ver si viene de movimientos pendientes

           *------------------------------------------------------------------------------------------------
           *--- Movimiento de COMISION DE CUSTODIA NRO 5 E IVA NRO. 6
           *- Fecha1;Cliente1;Especie;;;;;Vehiculo1;4; -Cantidad6;;'Comision CUSTODIA '    ;SI;RB3=1;41;;;Cuenta1;;5;;;;
           *- Fecha1;Cliente1;Especie;;;;;Vehiculo1;4; -Cantidad3;;'IVA Comision CUSTODIA ';SI;RB3=1;42;;;Cuenta1;;6;;;;

            *- Verifico condicion para cobrar movimiento de custodia => VCAN13
            IF Round2(Abs(val(l:fac)),2)<>0 
               ACT(mp1,val(z2))
               ACD(mp2,Dialogo.Fecha2)
               ACT(mp3,val(z7))
               ACT(mp4,val(ml1) )
               ACT(mp5,'')
               ACT(mp6,'')
               ACT(mp7,'')
               ACT(mp8,'')
               ACT(mp9,val(z6))
               ACN(mp10,-Num(Fstr(Abs(val(l:fac)),0,2)))
               ACT(mp11,'')
               ACT(mp12,'Comision CUSTODIA ')
  
               *- Condicion de Automatico
               ACT(mp13,'MV')
               ACT(mp17,'')
 
               *- mp14: Nr.Saldo
               ACN(mp14,4)

               *- mp15: NrGrupo Nada, mp16: Concepto nada, mp20: NrGrupo2 nada
               *- mp19: Cuenta
               ACN(mp15,41)
               ACT(mp19,val(z3))

               *- Nro.Mov.
               ACN(mp22,5)

               *- Cupon 
               ACT(mp27,'')
 
               *- mp25: NrLiq = ''
               ACT(mp25,'')

               *- Elimino el mov. previamente vc5: Tabla
               ACT(vc5,'MOVPENDIENTES' )
               IF EqStr(val(mp13),'AV')
                  ACT(vc5,'MOVEJECUTADOS' )
               ENDIF
      
               (.'IMMOVPEND'.)      
               *- De Comision
            EndIf

            IF Round2(Abs(val(q:fac)),2)<>0 
               ACT(mp1,val(z2))
               ACD(mp2,Dialogo.Fecha2)
               ACT(mp3,val(z7))
               ACT(mp4,val(ml1) )
               ACT(mp5,'')
               ACT(mp6,'')
               ACT(mp7,'')
               ACT(mp8,'')
               ACT(mp9,val(z6))
               ACN(mp10,-Abs(val(q:fac)))
               ACT(mp11,'')
               ACT(mp12,'IVA Comision CUSTODIA')
   
               *- Condicion de Automatico
               ACT(mp13,'MV')
               ACT(mp17,'')

               *- mp14: Nr.Saldo
               ACN(mp14,4)

               *- mp15: NrGrupo Nada, mp16: Concepto nada, mp20: NrGrupo2 nada
               *- mp19: Cuenta
               ACN(mp15,42)
               ACT(mp19,val(z3))
 
               *- Nro.Mov.
               ACN(mp22,6)

               *- Cupon 
               ACT(mp27,'')

               *- mp25: NrLiq = ''
               ACT(mp25,'')

               *- Elimino el mov. previamente vc5: Tabla
               ACT(vc5,'MOVPENDIENTES' )
               IF EqStr(val(mp13),'AV')
                  ACT(vc5,'MOVEJECUTADOS' )
               ENDIF    
               (.'IMMOVPEND'.)      
               *- De IVA
            EndIf

           *** graba en instancia Terminal ***
           SQL.ADD("Insert Into "~DBO~".OPERACIONESBITS ")
           SQL.ADD("  (NrOperacion, NrBit, Valor ) ")
           SQL.ADD(" Values ")
           SQL.ADD("  ('"~val(z2)~"','70','1') ")
           SQL.NEW
           SQL.EXEC
