***---ZZ:1 = 0 => relacion OK. Se envia
***---ZZ:1 = 1 => No se halla la relacion. Se envia y se informa
***---ZZ:1 = 2 => Relacion de movimientos que no se envian y no se informa
SCN(XT:1, 1)
ACT(NA:1, 'S'~Val(VH:2)~Copy(Fstr(Anio(Dialogo.Fecha1), 4, 0), 3, 2)~Copy(Val(FP:1), 4, 3)~ItemLista(Val(LS:4), Val(EV:1)))
IF ExisteArchivo(Var('PATHINTCON')~Val(NA:1)) Y Val(XT:1) = 1
    ***---Si existe archivo previo lo borro
    IF Dialogo.Radio1 = 0
        WinExec('COMMAND.COM /C DEL '~Var('PATHINTCON')~Val(NA:1), 0)
    ELSE
        WinExec('CMD.EXE /C DEL '~Var('PATHINTCON')~Val(NA:1), 0)
    ENDIF
    ***---A veces ejecuta lo que sigue y el S.O. todavia no borro el archivo
    Esperar(3)
ENDIF
IF Val(ZZ:1) = 0 O Val(ZZ:1) = 1
    ***---Registro valido
    SCN(CR:1, 1)
    AbrirASCII(Var('PATHINTCON')~Val(NA:1), 0)
    EscribirASCII(Val(ST:1))
    CerrarASCII
    ACT(LA:1, Val(LA:1)~Val(NA:1)~'|')
ENDIF
IF Val(ZZ:1) = 1
    ***---Registro Invalido => lo informo
    SCN(FW:1, 1)
    ACT(RF:Val(FW:1), Val(ST:1))
ENDIF
