Message('* LIQMINAGEN -Liquidacion de Agentes por Minutas')

   *- Selecciona los movimientos agrupandolos por nro.operacion
   SQL.ADD("SELECT DISTINCT MI.*  ")
   SQL.ADD("FROM  "~DBO~".MINORDOPS MO,"~DBO~".MINUTASBOLSA MI, "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M ")
   SQL.ADD(" WHERE M.NrOperacion=O.NrOperacion ")
   SQL.ADD("       and O.NrOperacion=MO.NrOperacion ")
   SQL.ADD("       and MO.NrMinuta=MI.NrMinuta ")
   SQL.ADD("       and M.Book=MI.NrMinuta and M.Transaccion = '"~val(a1)~"' ")
   SQL.ADD(" order by 1,2,3")

   *-- Con esta seleccion preparo un listbox complementario
   act(a0,'Marca')
   act(b0,'Agente')
   act(c0,'Tipo')
   act(d0,'Nro.')
   act(e0,'FechaOp')
   act(f0,'FechaVto')
   act(g0,'Especie')
   act(h0,'ContraEspecie')
   act(i0,'Precio')
   act(j0,'Cantidad VR')
   act(k0,'Cantidad VN')
   act(l0,'Monto')

   Recorrer SQL

      act(b:fac,fbn['Agente'])
      act(c:fac,fbn['TipoMinuta'])
      act(d:fac,fbn['NrMinuta'])
      acd(e:fac,fbn['FechaMinuta'])
      acd(f:fac,fbn['FechaVto'])
      act(g:fac,fbn['Especie'])
      act(h:fac,fbn['ContraEspecie'])
      acn(i:fac,fbn['Precio1'])
      acn(j:fac,fbn['Total4'])
      acn(k:fac,fbn['Cantidad'])
      acn(l:fac,fbn['Total1'])
      scn(b1,1)
   Proximo

   If Val(b1) >= 4
      CrearListBox      ; 'MS Sans Serif,8,'

         'Marca'         ;a4..a:val(b1);SI;;;30;CHECK;RGB(160,160,193)
         'Agente '       ;b4..b:val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'Tipo'          ;c4..c:val(b1);NO;;;60 ;STRING;;RGB(250,250,193)
         'Numero'        ;d4..d:val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'FechaOp'       ;e4..e:Val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'FechaVto'      ;f4..f:Val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'Especie'       ;g4..g:val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'ContraEspecie' ;h4..h:val(b1);NO;;;80 ;STRING;;RGB(250,250,193)
         'Precio     '   ;i4..i:val(b1);NO;;;80;NUMERO;'###.######';RGB(250,250,193)
         'Cantidad VR'   ;j4..j:val(b1);NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193)
         'Cantidad VN'   ;k4..k:val(b1);NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193)
         'Monto'         ;l4..l:val(b1);NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193)
      FinListBox

      If Ok 
         Recorrer&i 4, val(b1)
            If val(a:&i) = 1
               *- armo una lista con los nros. de operacion para aplicar a la seleccion del neteo
               act(ck1,val(ck1)~val(d:&i)~'|')
            EndIf
         Proximo
      Else
         ACT(co1, 'NO')
      EndIf
   EndIf

