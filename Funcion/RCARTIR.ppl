ACN(fa:1,0)
ACN(fa:3,0)
ACT(fa:4, 'OK')
(.'RCARTIRQ'.)
if Dialogo.Check1=0
  * Detallada
  recorrer SQL
    DFA
    SCN(fa:1, 1)
    ACN(fb:Val(fa:1), fbn('FechaOrd'))
    if Incluido(fbn('Tipo'),'1|2')
      ACN(fc:Val(fa:1), fbn('Cantidad')*fbn('Precio')*fbn('Signo'))
    endif
    if Incluido(fbn('Tipo'),'3|4')
      ACN(fc:Val(fa:1), fbn('Cantidad')*CotizacionC(fbn('Moneda'),,,,fbn('FechaOrd')-1,1,SI,Val(r:2))*fbn('Signo'))

    endif
    if EqStr(fbn('Tipo'),'5')
      ACN(fc:Val(fa:1), fbn('Cantidad')*fbn('Signo'))
    endif
    if EqStr(fbn('Tipo'),'9')
      ACN(fc:Val(fa:1), fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,Val(r:2))*fbn('Signo'))
    endif
  proximo
else
  * Resumida
  recorrer SQL
    DFA
    if fbn('FechaOrd')<>Val(fa:3)
      SCN(fa:1, 1)
      ACN(fb:Val(fa:1), fbn('FechaOrd'))
      ACN(fc:Val(fa:1), 0)
      ACN(fa:3, fbn('FechaOrd'))
    endif
    if Incluido(fbn('Tipo'),'1|2')
      SCN(fc:Val(fa:1), fbn('Cantidad')*fbn('Precio')*fbn('Signo'))
    endif
    if Incluido(fbn('Tipo'),'3|4')
      SCN(fc:Val(fa:1), fbn('Cantidad')*CotizacionC(fbn('Moneda'),,,,fbn('FechaOrd')-1,1,SI,Val(r:2))*fbn('Signo'))
    endif
    if EqStr(fbn('Tipo'),'5')
      SCN(fc:Val(fa:1), fbn('Cantidad')*fbn('Signo'))
    endif
    if EqStr(fbn('Tipo'),'9')
      SCN(fc:Val(fa:1), fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,Val(r:2))*fbn('Signo'))
    endif
  proximo
endif

if Val(fa:1)>0
  ACN(fa:2, Tir2(fb:1..fb:Val(fa:1),fc:1..fc:Val(fa:1))*100)
  if Val(fa:2)>1000 o Val(fa:2)<-1000
    ACN(fa:2, 0)
    ACT(fa:4, 'x Error')
  endif
else
  ACN(fa:2, 0)
endif
