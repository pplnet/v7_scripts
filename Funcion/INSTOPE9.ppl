INSTANCIA1
BITS
1 ;0;FW=1
5 ;1;FW=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not Incluido(Sector2,VAR('PERSUPFIN'))
10;1;FW=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"' and Tipo in ("~Pipe2Comillas(VAR('EXCESUP2'))~") ") = 1
19;1;FW=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"' and Tipo in ("~Pipe2Comillas(VAR('EXCESUP2'))~") ") <> 1
50;1;FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))

POSTEDICION
EqStr(ABM,'D') y NoVacio(OPERACIONREF);'UPOPRE';NrOperacion1=OPERACIONREF
EqStr(ABM,'D') Y Eqstr(TIPOOP, 'MMSIMV');'ACTDIS';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;Cantidad1=VCAN3;Radio1=1
EqStr(ABM,'D') Y EqStr(TIPOOP,'MMONRE');'ELIREE';NrOperacion1=OPERACIONREF;Fecha1=FECHAOP2;Cantidad1=TOTALBRUTOCLI1;
FW=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"' and Tipo in ("~Pipe2Comillas(VAR('EXCESUP2'))~") ") <> 1 y Not Incluido(TIPOOP,'FCR|FCS|') y Not EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',TipoOp),VAR('CLASEOPVIN'));'IMPOPE';NrOperacion1=NROPERACION;Radio1=1;

