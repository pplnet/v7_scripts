19;1;FW=1 y Not Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"' and Tipo in ("~Pipe2Comillas(VAR('EXCESUP2'))~") ") <> 1
