*-- Obtiene el resultado generado en titulos o fondos en un dia dado
SQL.ADD(" Select Day ")
SQL.ADD(" From "~DBO~".RESULTADOS R ")
SQL.ADD(" Where R.Especie = '"~Val(EA:2)~"' ") 
SQL.ADD(" AND R.Vehiculo  = '"~Val(VA:2)~"'")
SQL.ADD(" AND R.NrSaldo = 101 ")
SQL.ADD(" AND R.TipoNegocio = '"~Val(TN:2)~"' and TipoResultado='CONT' ")
SQL.ADD(" AND R.Fecha = (Select Max(Fecha) From "~DBO~".RESULTADOS S ")
SQL.ADD("                Where S.Especie = R.Especie ")
SQL.ADD("                AND S.Vehiculo = R.Vehiculo ")
SQL.ADD("                AND S.NrSaldo = R.NrSaldo ")
SQL.ADD("                AND S.TipoNegocio = R.TipoNegocio ")
SQL.ADD("                AND S.Fecha <= '"~IdxDate(val(fa:2))~"') ")
SQL.ADD(" Order By 1 ")
Recorrer SQL
    dfa
    ACN(re:1, fbn('Day'))
Proximo
