if EqStr(Val(b4),'DEP') y not Incluido(Val(b13), Var('MERCTITULO'))
  SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
  SQL.ADD("FechaMov, Cliente, Limite,")
  SQL.ADD("Especie, FechaLim, Monto,")
  SQL.ADD("NrOperacion, Descripcion, Usuario,")
  SQL.ADD("Bits, Vehiculo, Commited")
  SQL.ADD(") values (")
  IF Val(rd1) = 0
      SQL.ADD("'"~IdxDate(Val(FE:2))~"', ")
  ELSE
      SQL.ADD("'"~IdxDate(FSys)~"', ")
  ENDIF
*  SQL.ADD("'"~Val(b2)~"', 'SETTFAIL',")
  SQL.ADD("'"~Val(b2)~"', 'SETTLEMENT',")

  SQL.ADD("'"~Val(b3)~"', ")
  IF Val(rd1) = 0
      SQL.ADD("'"~IdxDate(Val(FE:1))~"', ")
  ELSE
      SQL.ADD("'"~IdxDate(FSys)~"', ")
  ENDIF
  IF Val(rd1) = 0
      SQL.ADD(" "~FStr(Val(b8)*CotizacionC(Val(b3),,,,Val(FE:1),1,SI,'USD'),0,2)~",")
  ELSE
      SQL.ADD(" "~FStr(Val(b8)*CotizacionC(Val(b3),,,,Fsys,1,SI,'USD'),0,2)~",")
  ENDIF
  SQL.ADD("'"~Val(b12)~"', 'Falla', '',")
  SQL.ADD("'P', '"~Val(b15)~"', 'NO')")
  SQL.NEW
endif
