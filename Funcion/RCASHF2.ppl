ACN(fl:2, fac)
SCN(fl:2,1)
SetFilaActual(Val(fl:2))
ACT(a:fac, "Total Activos Financieros")
SetFont(a:fac, 4)
AgregarMarco(a:fac..Val(cc:1990):fac, 2, 0, Exe('COLOR6'))

SCN(fl:2,1)
SetFilaActual(Val(fl:2))
ACT(B:fac, 'FPA')

*--> Fila para acumular el total 
ACN(h:2000, fac-1)
Recorrer&k 4, Val(LM:2)
    SCN(&k:Val(H:2000), 0)
Proximo

*--> Fila para acumular el diario
***---ACN(c:2000, fac)
ACN(c:2000, fac-1)
ACN(C:1999, fac-1)

*--> Marca para que ejecute solo los ACTIVOS financieros en las col. vinc. y ops. de cambio a term. venta y compra
ACN(mn:1000, 0)

     ***** COLOCACIONES VINCULADAS *****
(.'RVINCCASHF'.)

     ***** DEPOSITOS A PLAZO / DEPOSITOS OVERNIGHT *****
(.'RDEPOCASH'.)

     ***** OP. CAMBIO A TERM. VENTA / OP. CAMBIO A TERM. COMPRA *****
(.'RFXCASH'.)

     ***** TITULOS PUBLICOS Y PRIVADOS *****
(.'RSECCASH'.)

     ***** GARANTIA P / OP HEDGE FINANCIERO *****
(.'RGARPOPHF'.)

     ***** OPCIONES *****
(.'ROPCICASH'.)

     ***** OTROS ACTIVOS *****
(.'ROTACCASH'.)

*--> SUMA los Activos Financieros para el TOTAL
RECORRER&i Val(VT:1), Val(lm:2)
   SCN(&i:Val(kk:1), Val(&i:Val(h:2000)))
PROXIMO
Recorrer&i Val(C:1999), Val(C:2000)
    ***---Concepto FPA para orden de aparicion en los cuadros
    ACT(CX:&i, '7A+')
Proximo