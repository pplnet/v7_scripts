    **If fbn('CB4') = 1 o ((EqStr(fbn('Cliente1'),VAR('VEHICULODE')) o EqStr(fbn('Cliente1'),VAR('CLIENTEMAE'))) y NoVacio(fbn('NrOrden1')) y Not EqStr(fbn['TipoOp'],'TCOPRI') ) 
        
    If (fbn('CB4') = 1 o ((EqStr(fbn('Cliente1'),VAR('VEHICULODE')) o Incluido(fbn('Cliente1'),VAR('CLIEGARCP')) o EqStr(fbn('Cliente1'),VAR('CLIENTEMAE'))) y NoVacio(fbn('NrOrden1')) y Not Incluido(fbn['TipoOp'],'TCOPRI|CAUC')))y Not EqStr(BuscarCampo('UDNS','SenebiSistaco','Codigo',fbn['UDN2']),'SI')
      SQL.ADD("SELECT * from "~DBO~".EJECUCIONES where NrOperacion = '"~fbn['NrOperacion']~"' ")
      
      Recorrer SQL

        ** AA  02/07/2025 paginado
      
        (.'AXCPMAPAG'.)      
