        if Eqstr(Val(me:10),'BYMA')
          ACT(c:fac,'Reg: '~fbn['NrSecuencia']~' Orden: '~iif(Incluido(Val(xy100),'FIX|SDIB'),Val(xy2),iif(Incluido(Val(xy100),VAR('COPIATSNBG')),Val(xy4),fbn['NrSecuencia']))~'  '~fbn['Fecha'] )
