HojaVisible(SI)
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")
CrearFont(6,"Arial,8,BU")

SetFilaActual(2)

ACT(D:fac, 'Informe de Movimientos sin Relaciones')
SetFont(D:fac, 3)

SetFilaActual(fac+2)
ACT(A:fac, 'Fecha:')
ACT(B:fac, Dialogo.Fecha1)
AlinearCeldas(B:fac-1..B:fac, 'D')
SetFont(A:fac-1..A:fac, 2)
SetFont(B:fac-1..B:fac, 1)

SetFilaActual(fac+2)
ACT(A:fac, 'NrOperacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'Vehiculo')
ACT(D:fac, 'NrEnvio')
ACT(E:fac, 'Entidad')
ACT(F:fac, 'Especie')
ACT(G:fac, 'ConceptoFPA')
ACT(H:fac, 'Importe')
SetFont(A:fac..H:fac, 2)
AgregarMarco(A:fac..H:fac, 0, 0, Exe('COLOR'))
SetFilaActual(fac+2)
ACN(FI:1, fac)

Recorrer&k 1, Val(FW:1)
    ACT(A:fac, Copy(Val(RF:&k), 73, 8))
    ACLO(A:fac, Copy(Val(RF:&k), 73, 8))
    ACT(B:fac, Copy(Val(RF:&k), 32, 6))
    ACT(C:fac, Copy(Val(RF:&k), 81, 10))
    ACT(D:fac, Copy(Val(RF:&k), 11, 3))
    ACT(E:fac, Copy(Val(RF:&k), 63, 10))
    ACT(F:fac, Copy(Val(RF:&k), 195, 6))
    ACT(G:fac, Copy(Val(RF:&k), 226, 40))
    ACN(H:fac, Num(Copy(Val(RF:&k), 165, 13))+(Num(Copy(Val(RF:&k), 178, 2))/100))
    AlinearCeldas(D:fac, 'D')
    ifa
Proximo

FormatoCeldas(H:Val(FI:1)..H:fac, Exe('F2'))
SetFont(A:Val(FI:1)..A:fac, 1)
AgregarMarco(A:Val(FI:1)-1..H:fac, 0, 0)
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACN(FI:1, fac)
ACO(1, 8)
ACO(4, 5)
ACO(7, 25)
ACO(8, 8)
