***---Compra de CAP y FLOOR
SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Total2 Importe, O.NrOperacion, O.TipoOp, O.Cliente1, ")
SQL.ADD(" C.Fecha1 Inicio, C.Fecha2 Fin, C.NrCuota, C.Fecha4 Reset, C.Plazo1 Plazo, O.TipoTasa, ")
SQL.ADD(" C.Precio2 Tasa, C.Total3 Spread ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.MB3 = 0 ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:2))~") ")
SQL.ADD(" AND O.TipoOp IN ('DTCAP','DTFLO') ")
SQL.ADD(" AND C.Fecha4 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha4 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND C.Total2 > 0 ")
SQL.ADD(" AND O.OperacionRef = P.NrOperacion ")
SQL.ADD(" AND (P.TipoOp IN ('MMPE','MMPI','MMPEM','MMPIM','MMON','MMONM','MMFIMV','MMFRNP','MMSIMV','MMPSI','MMPCL','MMPCOS','MMPCLM','MMPOSM') ")
SQL.ADD("      OR (P.TipoOp = 'MMPLME' AND P.Especie <> '"~Var('MONEEXTR')~"')) ")
SQL.ADD(" AND ((O.TipoTasa Is Not Null AND O.TipoTasa<>'FIJA') OR (O.TipoTasa2 Is Not Null AND O.TipoTasa<>'FIJA')) ")
IF Dialogo.Radio1 = 1
    SQL.ADD(" AND (C.Precio2 = 0 OR C.Precio2 Is Null) ")
ENDIF

SQL.ADD(" UNION ")

