*- vi1: Vigentes=1 , Todos los Settements=0
*- vf1: Los que no estan vigentes pero vencieron en ese mes
SQL.ADD("Select ")
If NoVacio(val(aa1))
   SQL.ADD(" "~val(aa1)~", ")
EndIf


*************************-----------------------------------------------
If Dialogo.Radio3 = 1 
   SQL.ADD("O.Vehiculo1, 'Colocaciones a plazo' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
Else
   SQL.ADD(" 'Consolidado' Vehiculo1, 'Colocaciones a plazo' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
EndIf
*************************-----------------------------------------------

SQL.ADD("O.RB8, CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN O.FechaVto2 ELSE O.FechaVto END FechaVto, ")
SQL.ADD("CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN O.FechaVto ELSE O.FechaVto2 END FechaSett, O.TipoTasa, O.PrecioRef, ")
SQL.ADD("CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN 0 ELSE O.Spread END Spread, CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN O.Precio3 ELSE O.Precio1 END Tasa, ")
SQL.ADD("CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN O.Precio3 ELSE O.Precio4 END TTN, ")
SQL.ADD("CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN (O.TotalNetoCli2 - O.TotalNetoCli1) ELSE O.TotalIntereses END TotalIntereses, O.TotalNetoCli2 IntNeto, O.TotalBrutoCli1 Monto, ")
SQL.ADD("O.ImpGastos2 TasaIva, O.TotalIVA ImpIva, 0 TasaWH, 0 ImpWH, O.TotalNetoCli1 MontoNeto, 0 TasaImpInt, 0 ImpInt, O.PrecioEj ImpAmort, ")
SQL.ADD("O.Cotizacion1, O.Cantidad, 0 NrCuota, O.RB6, O.FechaOp FInicio, CASE WHEN  O.TipoOp in ('SERA','SERAV') THEN O.FechaVto2 ELSE O.FechaVto END FFin, ")
SQL.ADD("O.Plazo, O.ContraEspecie, O.FechaCargaSys, '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD("O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
SQL.ADD(" ) ")
SQL.ADD(" and  O.TipoOp In ('MMCP','MMDCA','MMO','MMD','MMCCR','SERA','SERAV','MMCAUA') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(zz6))~") ")   
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf


SQL.ADD(" UNION ")


SQL.ADD("Select ")
If NoVacio(val(aa1))
   SQL.ADD(" "~val(aa1)~", ")
EndIf

*************************-----------------------------------------------
If Dialogo.Radio3 = 1 
   SQL.ADD("O.Vehiculo1, 'Colocaciones a plazo' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
Else
   SQL.ADD(" 'Consolidado' Vehiculo1, 'Colocaciones a plazo' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
EndIf
*************************-----------------------------------------------

SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha2 FechaSett,O.TipoTasa,O.PrecioRef,O.Spread ,C.Precio2 Tasa,C.Precio4 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Total3 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Cantidad5 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,C.Total1 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("C.Cantidad1 ImpAmort,O.Cotizacion1,C.Cantidad2 Cantidad, C.NrCuota ,O.RB6,C.Fecha1 FInicio,C.Fecha2 FFin,C.Plazo1 Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD("O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vi1)=1
   SQL.ADD(" and (C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
EndIf

If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf

SQL.ADD(" ) ")
SQL.ADD("  and O.NrOperacion= C.NrOperacion ")
SQL.ADD(" and  O.TipoOp In ('MMCPM') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(zz6))~") ")   
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
