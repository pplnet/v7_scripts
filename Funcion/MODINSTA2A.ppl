** MODIINSTAN
** Modifica las Instancias para las Operaciones 
** i3= NrOperacion, Si Vacio utiliza Dialogo.NrOperacion1 
** Dialogo.NrOperacion1: Debe estar el Nro. de La Operacion 

If VACIO(VAL(i3))
   ACT(i3, Dialogo.NrOperacion1)
EndIf

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor = '0' ")
SQL.ADD(" Where NrOperacion = '"~VAL(i3)~"' ")
SQL.ADD("   and Valor       = '1' ")
SQL.NEW

ACT(ob1,BuscarCampo('OPERACIONES','Observaciones','NrOperacion',val(i3)) )
ACT(ob1,val(ob1)~" "~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~" ")

SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
SQL.ADD("   Set Observaciones = '"~Copy(val(ob1),1,100)~"' ")
SQL.ADD(" Where NrOperacion   = '"~Val(i3)~"' ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor = '1' ")
SQL.ADD(" Where NrOperacion = '"~VAL(i3)~"' ")
SQL.ADD("   and NrBit       = "~Fstr(Val(IN:88),2,0)~" ")
SQL.NEW        

SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ( ")
SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
SQL.ADD(" ) Values ( ")
SQL.ADD(" '"~Val(i3)~"', ")
SQL.ADD(" '"~IdxDate(FSYS)~"', ")
SQL.ADD(" 'MODEVENTO', ")
SQL.ADD(" 'Modificada Evento "~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~" - "~Hora(Ahora)~"' ")
SQL.ADD(" ) ")
SQL.NEW
SQL.EXEC

BorrarCeldas(i3..i3)
