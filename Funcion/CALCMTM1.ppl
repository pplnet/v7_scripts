ACN(CT:1, CotizacionC(val(ML:2),'FUT',Dialogo.Fecha2,,val(FE:1),1,,val(ML:1)))
ACN(CT:2, CotizacionC(val(ML:2),'FUT',Dialogo.Fecha2,,val(FE:1)-1,1,,val(ML:1)))

*MessageBox('FE '~Val(FE:1))
*MessageBox('VTO '~fbn('FechaVto'))
*MessageBox('COT1 '~Val(CT:1))
*MessageBox('COT2 '~Val(CT:2))
*Messagebox(fbn('Tipo'))

IF fbn('FechaOp') = val(FE:1)
   *Primer dia - CT2 debe ser precio1
   ACN(CT:2, fbn('Precio1'))
ELSE
   IF Dialogo.Fecha2 = val(FE:1)
      *Ultimo Dia - CT1 debe ser precio spot (USDFUT)
      ACN(CT:1, CotizacionC(VAR('USDFUT'),'CON',,,val(FE:1),1,,val(ML:1)))
      SQL.ADD(" Update "~DBO~".OPERACIONES ")
      SQL.ADD(" Set FechaEj = '"~IdxDate(FSys)~"', Precio2 = "~Fstr(Val(CT:1), 0, 2)~" ")
      SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.EXEC
   ELSE
      *En el medio - las cotizaciones quedan igual
   ENDIF
ENDIF

ACN(DF:1, Val(CT:1) - val(CT:2))

*MessageBox('Cot1. '~Val(CT:1)~' Y Cot2: '~val(CT:2)~' Para la fecha '~IdxDate(val(FE:1)))
IF val(CT:1)<>0 Y val(CT:2)<>0
 IF Eqstr(fbn('TipoOp'), 'FXCF')
   ACN(MM:1, fbn('Cantidad') * Val(DF:1))
 ELSE
   ACN(MM:1, -fbn('Cantidad') * Val(DF:1))
 ENDIF
 
 ACN(CU:1, SQL("Select Max(NrCuota)+1 From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"'"))
 IF Vacio(val(CU:1)) O Eqstr(val(CU:1),'') O val(CU:1) = 0
    ACN(CU:1,1)
 ENDIF

 IF Incluido (fbn('Cliente1'),var('BRLIQMTM'))
   ACD(FE:3, Habiles(val(FE:1),1,'ARG'))
 ELSE
   ACD(FE:3, val(FE:1))
 ENDIF
 IF SQL(" Select 1 From "~DBO~".CUOTAS Where Fecha1 = '"~IdxDate(val(FE:1))~"' AND NrOperacion = '"~fbn('NrOperacion')~"'") = 1
   ** Actualizo en CUOTAS los MTM
   SQL.ADD(" Update "~DBO~".CUOTAS ")
   SQL.ADD(" Set Precio1 = "~Fstr(Val(MM:1), 0, 2)~", ")
   SQL.ADD(" Cotizacion1 = "~Fstr(Val(CT:1), 0, 8)~", Cotizacion2 = "~Fstr(Val(CT:2), 0, 8)~" ")
   SQL.ADD(" Where Fecha1 = '"~IdxDate(Val(FE:1))~"' ")
   SQL.ADD(" AND NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.NEW
 ELSE
   ** Inserto en CUOTAS los MTM
   SQL.ADD(" Insert Into "~DBO~".CUOTAS ")
   SQL.ADD(" (NrCuota, NrOperacion, Fecha1, Fecha2, Fecha3, ")
   SQL.ADD(" Precio1, Cotizacion1, Cotizacion2) ")
   SQL.ADD(" Values ")
   SQL.ADD(" ("~Fstr(val(CU:1), 0, 0)~", '"~fbn('NrOperacion')~"', '"~IdxDate(val(FE:1))~"', '"~IdxDate(Habiles(Val(FE:1), -1, 'ARG'))~"', '"~IdxDate(val(FE:3))~"', ")
   SQL.ADD(" "~Fstr(Val(MM:1), 0, 2)~", "~Fstr(Val(CT:1), 0, 8)~", "~Fstr(Val(CT:2), 0, 8)~") ")
   SQL.ADD("  ")
   SQL.NEW
   SQL.ADD(" Update "~DBO~".OPERACIONES ")
   SQL.ADD(" Set Cuotas1 = "~Fstr(Val(CU:1), 0, 0)~", CB5 = 1 ")
   SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.NEW
   SQL.EXEC
 ENDIF
 ** Actualizo el total del MTM en la operacion
 SQL.ADD(" Update "~DBO~".OPERACIONES ")
 SQL.ADD(" Set TotalAux3 = TotalAux3 + "~Fstr(Val(MM:1), 0, 2)~" ")
 SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
 SQL.NEW
 SQL.EXEC
            
 ** Actualizo Movimientos de la operacion
 SQL.ActualizarMovimientos3(fbn('NrOperacion'),SI,SI,NO,SI,SI)
 SQL.EXEC
ELSE
 *messagebox('No hay cotizaciones')
ENDIF