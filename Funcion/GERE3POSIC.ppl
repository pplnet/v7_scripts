*---- Tomo de Posiciones el saldo de la especie a una fecha determinada
*---- Recibe  FP1: Fecha de Posicion Fp2: Fecha de Cotizacion
*---- Retorna PC1: Precio Clean 1
*----         PD1: Precio Dirty 1
*----         VS1: Valor Nominal Saldo Inicial
ACN(pc1,0)
ACN(pd1,0)
ACN(vs1,0)

Message('Recuperando Posicion Inicial de '~val(ee3)~' '~IdxDate(val(fp1))~' ...')

SQL.ADD("Select Especie,Fecha,Sum(CantidadFin) as CantidadFin, Sum(PrecioFin) as PrecioFin ")
SQL.ADD("from "~DBO~".POSICIONES S ")
SQL.ADD("where ")
If Dialogo.Radio2=0
   SQL.ADD("S.NrSaldo = 101")
Else
   SQL.ADD(" (S.NrSaldo=101 or S.NrSaldo=201) ")
EndIf
If Dialogo.Radio5=0
   SQL.ADD("and     S.Cliente  = '"~fbn['Vehiculo1']~"' ")
   SQL.ADD("and     S.Vehiculo = '"~fbn['Vehiculo1']~"' ")
EndIf
SQL.ADD("and     S.Especie = '"~Val(ee3)~"' ")
SQL.ADD("and    (S.CallPut is Null or S.CallPut = ' ') ")
SQL.ADD("and     S.Fecha = (Select Max(D.Fecha) from "~DBO~".POSICIONES D ")
SQL.ADD("                   where  D.Vehiculo = S.Vehiculo ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and   (D.CallPut is Null or D.CallPut = ' ') ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = S.NrSaldo ")
SQL.ADD("                   and    D.Fecha < '"~IdxDate(VAL(FP1))~"') ")
SQL.ADD("Group by S.Especie,Fecha ")
SQL.ADD("Order by S.Especie,Fecha Desc ")

*- Recupero todas las posiciones anteriores al dia del informe, ordenadas
*- en forma descendente, o sea la primera es la que el informe debe tomar.
Recorrer SQL
  dfa
  acn(vs1,fbn['CantidadFin'])

  if EqStr(val(v5),'DIR')
     acn(pd1,CotizacionC(fbn('Especie'),,,,VAL(FP2)-1,1,SI,'USD'))
     If Dialogo.Radio5=1
        acn(pd1,val(pd1)/FBN['CantidadFin'])
     EndIf
  else
     acn(pc1,CotizacionC(fbn('Especie'),,,,VAL(FP2)-1,1,SI,'USD'))

     If Dialogo.Radio5=1
        acn(pc1,val(pc1)/FBN['CantidadFin'])
     EndIf

     *** calcula precio sucio ***
     act(ca:fac,val(ee3))
     *acd(ck:fac,fbn['Fecha'])
     acd(ck:fac,VAL(FP2)-1)

     (.'SUCIO'.) 

     acn(pd1,val(ci:fac)*(val(pc1)+val(cj:fac))) 

  endif

  acn(i:fac,fbn['CantidadFin']*val(pd1)*(-1))

  * Recupero 1 Sola Fila
  Break
Proximo

*MessageBox(' Fecha de Cotizacion '~IdxDate(VAL(FP1))~' ')
*MessageBox(' Retorna PC1: Precio Clean 1 '~Fstr(val(pc1),0,5)~' ')
*MessageBox(' Retorna PD1: Precio Dirty 1 '~Fstr(val(pd1),0,5)~' ')
*MessageBox(' Retorna VS1:                '~Fstr(val(vs1),0,5)~' ')