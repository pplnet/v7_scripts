let &vehiculosDolBillete Var('VEHDOLBI')
SQL.ADD(" Select S.Fecha,S.Saldo,S.EnteCustodia as 'Vehiculo', S.Especie as 'Moneda' ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA S ")
SQL.ADD(" Where S.EnteCustodia = '"~&vehiculo~"' ") 
SQL.ADD(" and S.Cuenta = '"~&cuenta~"' ") 
SQL.ADD(" and S.NrSaldo = 50 ")
SQL.ADD(" and S.Especie = '"~&moneda~"'")
SQL.ADD(" AND S.Fecha IN (SELECT MAX(SD.Fecha) FROM "~DBO~".SALDOSDIA SD") 
SQL.ADD("                   WHERE SD.NrSaldo = S.NrSaldo  ")
SQL.ADD("                   AND SD.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   AND SD.Especie = S.Especie ")
SQL.ADD("                   AND SD.Cuenta = S.Cuenta ")
SQL.ADD("                   AND SD.Fecha  <= '"~IdxDate(&diaDC)~"') ")
***---SQL.ADD(" Order By Vehiculo,Fecha ")
Watch(sql.batch)
Recorrer SQL
*MessageBox('2')
    let &monto fbn('Saldo')
    *Message(Fstr(&monto, 0, 4))
    let &fechaDC Fecha(&diaDC)
    let &fechaDesde Fecha(&fechaDC-1)
    
    IF Eqstr(fbn('Moneda'), &monedaExtranjera)
        IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
            let &monedaCot &dolarBillete
        ELSE
            let &monedaCot &monedaExtranjera
        ENDIF
    ELSE
        let &monedaCot fbn('Moneda')
    ENDIF
    ***---tipoCotizacion BNA
    let &tipoCotizacion 0
    ***---Tipo de Cambio Vendedor
    let &tipoCambio 2 
    (.'DIFCAM'.)
*    IF &DC <> 0
*    MessageBox('2')
*    MessageBox(Fstr(&DC, 0, 8))
*    ENDIF
Proximo