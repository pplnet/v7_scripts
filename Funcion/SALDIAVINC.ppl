*-- Parametros de la Funcion AV1: Vehiculo1 AV2: Vehiculo2 AF1: Fecha AE1: Especie
* SALDIAVINC

SQL.ADD("SELECT O.* ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where ((TipoOp='VIMD' and FechaOp='"~IdxDate(VAL(AF1))~"') ")
SQL.ADD(" or (TipoOp='VIMIND' and FechaVto='"~IdxDate(VAL(AF1))~"') ")
SQL.ADD(" or (TipoOp='VIMINM' and FechaVto='"~IdxDate(VAL(AF1))~"')) ")
SQL.ADD(" and O.Especie='"~VAL(AE1)~"' ")
SQL.ADD(" and O.Vehiculo1='"~VAL(AV1)~"' and O.Vehiculo2='"~VAL(AV2)~"' ")
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT TipoOp ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where TipoOp='VIMIND' and FechaOp='"~IdxDate(VAL(AF1))~"' ")
SQL.ADD(" and O.Especie ='"~VAL(AE1)~"' ")
SQL.ADD(" and O.Vehiculo1='"~VAL(AV1)~"' and O.Vehiculo2='"~VAL(AV2)~"') ")
SQL.ADD(" Order By O.FechaOp,O.NrOperacion ")

ACN(Z1,0)

Recorrer SQL

   DFA

   * Se toma el Monto Capitalizable
   IF Eqstr(FBN['TipoOp'],'VIMINM')
      ACN(Z1, VAL(Z1)+(FBN['TotalBrutoCli1']*IIF(EqStr(FBN['MB3'],'0'),-1,1)))
   Else 
      *-- Acumula el Saldo
      ACN(Z1, VAL(Z1)+(FBN['Cantidad']*IIF(EqStr(FBN['MB3'],'0'),-1,1)))
   ENDIF

Proximo

ACN(Z1,Round(VAL(Z1),2))
 
