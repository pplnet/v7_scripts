*(.'CHECKPREBY'.)
*Checkeo de Precios
acn(z:10, 0)

SQL.ADD("SELECT CASE WHEN EXISTS (")
SQL.ADD("SELECT 1 ")
SQL.ADD("FROM "~DBO~".Operaciones")
SQL.ADD("WHERE Mercado4 = 'BYMA' ")
SQL.ADD(") THEN 1 ELSE 0 END AS ExisteBYMA")

Recorrer SQL
    IF FBN['ExisteBYMA']=1      
        
        SQL.ADD("SELECT CASE WHEN EXISTS ( ") 
        SQL.ADD("SELECT 1 ")
        SQL.ADD("FROM "~DBO~".IMEPRECIOSBYMA ") 
        SQL.ADD("WHERE FechaProcesamiento = '"~IdxDate(Dialogo.Fecha1)~"' ") 
        SQL.ADD(") THEN 1 ELSE 0 END AS Existe")        

        Recorrer SQL
           dfa
           if FBN['Existe']=0
           ACT(a:fac,'No se ejecuto correctamente la bajada de Precios de BYMA')
           ColorCeldas(a:fac, clRED)
           
                * No puede correr la contabilidad
                acn(z:10,1)
                if Val(z:5)=0
                    act(z:4,val(z:4) ~'PBY  ')
                    acn(z:5,1)
                endif   
              * MTM Erroneo
              acn(z:3,1)
           Endif
        Proximo

        if val(z:10)=0
           ACT(a:fac,'Se ejecuto correctamente la bajada de Precios de BYMA')
        endif
    ENDIF
Proximo
SetFont(a:fac,2)



