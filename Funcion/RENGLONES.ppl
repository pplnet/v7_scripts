if Incluido(fbn['TipoOp'],'MMDCA|MMCCR')
   IF Not EqStr(val(ba5),fbn['Especie']) y Val(pr:1)=1
      ifa 
      ACT(a:fac, 'Totales en '~Val(ba5))
      AgregarMarco(a:fac..t:fac,1,0,EXE('COLOR6'))
      ACN(f:fac, Val(sf:1))
      ACN(n:fac, Val(sn:1))
      ACN(o:fac, Val(so:1))
      ACN(p:fac, Val(sp:1))
      ACN(q:fac, Val(sq:1))
      ACN(s:fac, Val(ss:1))
      ACN(t:fac, Val(st:1))

      SetFont(a:fac..z:FAC,2)
      ACN(sf:1, 0)
      ACN(sN:1, 0)
      ACN(sO:1, 0)
      ACN(sp:1, 0)
      ACN(sq:1, 0)
      ACN(ss:1, 0)
      ACN(st:1, 0)
      ifa
      ifa
   EndIf

   ACT(ba5, fbn('Especie'))   
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACD(b:FAC, FBN['FechaOp2'])
   ACD(c:FAC, FBN['FechaOp'])
   ACT(d:FAC, FBN['Vehiculo1'])
   ACT(e:FAC, FBN['Especie'])
   ACN(f:FAC, FBN['Cantidad'])
   ACN(g:FAC, FBN['Plazo'])
   ACN(h:FAC, FBN['Plazo2'])
   ACD(i:FAC, FBN['FechaVto'])
   ACD(j:FAC, FBN['FechaPago'])
   ACT(k:FAC, FBN['TipoTasa'])
   ACN(l:FAC, FBN['Precio1'])
   ACN(m:FAC, FBN['Spread'])
   ACN(n:FAC, FBN['Cantidad']*(FBN['Spread']+FBN['Precio1'])*((Dialogo.Fecha1-fbn['FechaOp'])+1)/iif(Eqstr(FBN['RB8'],'1'),36500,36000))
   ACN(o:FAC, FBN['TotalIntereses'])
   ACN(p:FAC, FBN['TotalRetenciones'])
   ACN(q:FAC, FBN['ImpGastos1'])
   ACN(r:FAC, FBN['Precio4'])
   ACN(s:FAC, FBN['Cantidad']+FBN['TotalIntereses'])
   ACN(t:FAC, FBN['TotalNetoCli1'])
   ACT(u:FAC, FBN['Cliente1'])

   *--- Totales por moneda   
   SCN(sf:1, Val(f:fac))
   SCN(sn:1, Val(n:fac))
   SCN(so:1, Val(o:fac))
   SCN(sp:1, Val(p:fac))
   SCN(sq:1, Val(q:fac))
   SCN(ss:1, Val(s:fac))
   SCN(st:1, Val(t:fac))

   SCN(tf:1, (Val(f:fac)*VAL(sz:1)))
   SCN(tn:1, (Val(n:fac)*VAL(sz:1)))
   SCN(to:1, (Val(o:fac)*VAL(sz:1)))
   SCN(tp:1, (Val(p:fac)*VAL(sz:1)))
   SCN(tq:1, (Val(q:fac)*VAL(sz:1)))
   SCN(ts:1, (Val(s:fac)*VAL(sz:1)))
   SCN(tt:1, (Val(t:fac)*VAL(sz:1)))

   SetFont(a:FAC..w:FAC,1)

   FormatoCeldas(g:fac..h:fac,"0")
   FormatoCeldas(o:fac..t:fac,Exe('F2'))
   FormatoCeldas(l:fac..m:fac, EXE('F6'))
   FormatoCeldas(r:fac..r:fac, EXE('F6'))
   FormatoCeldas(f:fac..f:fac,Exe('F2'))

   scn(ab1,val(f:fac))
   scn(ac1,val(n:fac))
   scn(ad1,val(o:fac))
   scn(ae1,val(p:fac))
   scn(af1,val(r:fac))
   scn(ag1,val(t:fac))
endif

