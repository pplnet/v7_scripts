      FormatoCeldas(s:fac..t:fac,Exe('F2'))
   else
      ACN(q:FAC, FBN['Pr4'])
      ACN(r:FAC, FBN['Total2'])
      FormatoCeldas(q:fac..q:fac,Exe('F6'))
      FormatoCeldas(r:fac..r:fac,Exe('F2'))
   endif

