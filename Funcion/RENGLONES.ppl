   EndIf

   if Not EqStr(val(ba4),fbn['NrOperacion'])
      ifa
      ACT(a:FAC, FBN['NrOperacion'])
      ACLO(a:FAC, FBN['NrOperacion'])
      ACD(b:FAC, FBN['FechaOp2'])
      ACT(c:FAC, FBN['Vehiculo1'])
      ACT(h:FAC, FBN['Especie'])
      ACT(k:FAC, FBN['TipoTasa'])
      ACN(m:FAC, FBN['Spread'])

      if Incluido(fbn['TipoOp'],'MMCPM|MMCPMG')
         ACT(u:FAC, FBN['Cliente1'])
         FormatoCeldas(q:fac..q:fac, EXE('F6'))
        else
         ACT(s:FAC, FBN['Vehiculo2'])
         FormatoCeldas(p:fac..p:fac, EXE('F6'))
      endif

      ACT(ba4, FBN['NrOperacion'])
      ACT(ba5, fbn('Especie'))   
   endif

   acn(d:fac, fbn['NrCuota'])
   ACD(e:FAC, FBN['Fecha1'])
   ACD(f:FAC, FBN['Fecha2'])
   ACN(g:FAC, FBN['Plazo1'])
   if fbn['NrCuota'] > 1
      acn(i:fac, val(i:fac-1)-val(j:fac-1))
     else
      ACN(i:FAC, FBN['Cantidad'])
   endif
   ACN(j:FAC, FBN['Cantidad1'])
   ACN(l:FAC, FBN['Pr2'])

   *i*f Dialogo.Fecha1 >= fbn['Fecha1'] y Dialogo.Fecha1 <= fbn['Fecha2']
   if Dialogo.Fecha1 >= fbn['Fecha1'] y Dialogo.Fecha1 < fbn['Fecha2']
      ACN(n:FAC, FBN['Cantidad2']*(FBN['Spread']+FBN['Pr2'])*((Dialogo.Fecha1-fbn['Fecha1'])+1)/iif(Eqstr(FBN['RB8'],'1'),36500,36000))
   endif
