Message('Prestamos CashFlow A ')
SCN(f:200,1)

*- Cantidad1=Capital Cantidad3=Interes Total3-Cantidad3=Impuestos
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD("C.Cantidad1/1000 Cant,C.Cantidad3/1000 Int,(C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
**SQL.ADD("O.PrecioEj/1000 Cant,0 Int,0 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("O.Cantidad/1000 Cant,0 Int,O.TotalComisiones/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
**SQL.ADD("O.PrecioEj/1000 Cant,O.TotalIntereses/1000 Int,(O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
***SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int,(O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, ")
SQL.ADD("CASE TipoOp WHEN 'MMPCL ' THEN (O.TotalNetoCli2-O.TotalIntereses) ELSE (O.TotalIVA+ImporteImp) END/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
**SQL.ADD("PrecioEj/1000 Cant,0 Int,0 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
***SQL.ADD("O.Cantidad/1000 Cant,0 Int,O.TotalComisiones/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, ")
SQL.ADD("CASE TipoOp WHEN 'MMPCL ' THEN (O.TotalNetoCli2-O.TotalIntereses) ELSE (O.TotalIVA+ImporteImp) END/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("C.Cantidad1/1000 Cant,C.Cantidad3/1000 Int,(C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *--- Capital si FechaInicio<>FechaConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
**   SQL.ADD("O.PrecioEj/1000 Cant,0 Int,0 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("O.Cantidad/1000 Cant,0 Int,O.TotalComisiones/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, ")
   SQL.ADD("CASE TipoOp WHEN 'MMPCL ' THEN (O.TotalNetoCli2-O.TotalIntereses) ELSE (O.TotalIVA+O.ImporteImp) END/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("O.Cantidad/1000 Cant,0 Int,O.TotalComisiones Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("0 Cant,0 Int, C.Importe4/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCLM','MMPCL') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo,")
   SQL.ADD("0 Cant,0 Int, C.Importe4/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCLM','MMPCL') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
SQL.ADD("order by 1, 2,4,6 ")

Recorrer SQL
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp'])

   If FBN['Precio2']=0 y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   EndIf

   ACN(mt11,0)

   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   EndIf
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   EndIf
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   EndIf

   *ACN(mt12,IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
   ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))

   If Dialogo.Radio2 = 0
      *** Diario ***
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         act(af:201,FBN['NrOperacion'])
      Else     
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               If EqStr(FBN['Especie'],'ARP')
                  SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               Else
                  SCN(&i:Val(f:200)+1,Val(mt11)*Val(mt12))
               Endif
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               If EqStr(FBN['Especie'],'ARP')
                  SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               Else
                  SCN(&i:Val(f:200)+1,Val(mt11)*Val(mt12))
               Endif
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      EndIf
   Else
      *** Mensual ***
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         *-- m201: Nro. de Operacion que Mostro Capital
         act(af:201,FBN['NrOperacion'])
      Else
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               If EqStr(FBN['Especie'],'ARP')
                  SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               Else
                 SCN(&i:Val(f:200)+1,Val(mt11)*Val(mt12))
              endif
              SCN(&i:Val(i:200),Val(mt11)*Val(mt12))         
           endif
        Proximo
        Recorrer&i Val(o:200), Val(p:200)
           If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
              If EqStr(FBN['Especie'],'ARP')
                 SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
              Else
                 SCN(&i:Val(f:200)+1,Val(mt11)*Val(mt12))
              Endif
              SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
           Endif
        Proximo
        If Val(o:200) > 0
           If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
              If EqStr(FBN['Especie'],'ARP')
                 SCN(Val(p:200)+1:Val(f:200),Val(mt11)*Val(mt12))
              Else
                 SCN(Val(p:200)+1:Val(f:200)+1,Val(mt11)*Val(mt12))
              Endif
              SCN(Val(p:200)+1:Val(i:200),Val(mt11)*Val(mt12))
           Endif
        Endif
        Recorrer&i Val(d:200), Val(g:200)
           If Anio(FBN['Fecha']) = Val(&i:280)
              If EqStr(FBN['Especie'],'ARP')
                 SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
              Else
                 SCN(&i:Val(f:200)+1,Val(mt11)*Val(mt12))
              Endif
              SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
           Endif
        Proximo
        If Anio(FBN['Fecha']) > Val(Val(g:200):280)
           If EqStr(FBN['Especie'],'ARP')
              SCN(Val(g:200):Val(f:200),Val(mt11)*Val(mt12))
           Else
              SCN(Val(g:200):Val(f:200)+1,Val(mt11)*Val(mt12))
           Endif
           SCN(Val(g:200):Val(i:200),Val(mt11)*Val(mt12))
        Endif
     Endif
  EndIf
Proximo
