ACT(v:1, BuscarCampo('VARIABLES','Valor','Codigo','CONTMEM'))
if EqStr(Val(v:1),'SI')

  require '..\Lib\MemoryUtils.dll'
  Import HelperClass, 'MemoryUtils.Helper'
  let &memoryHelper new helperClass()

  *ACN(x:1, Var('MEMMINIMA'))
  ACN(x:1, BuscarCampo('VARIABLES','Valor','Codigo','MEMMINIMA'))
  ACN(x:2, &memoryHelper.AvailablePhysicalMemory())
  if Val(x:2)<Val(x:1)
    if MessageBox('La memoria disponible ('~PyC(Val(x:2),0,0)~' MB) es menor que la minima recomendada ('~PyC(Val(x:1),0,0)~' MB). Desea Continuar?',3,2)=7
      Cancelar('Evento cancelado')
    else
      ACT(x:3, 'Recomendada: '~PyC(Val(x:1),0,0)~' MB')
      ACT(x:4, 'Disponible: '~PyC(Val(x:2),0,0)~' MB')
      SQL.ADD(" INSERT INTO "~DBO~".PMAUDIT (Operador,Fecha,Accion,Tabla,Codigo,Campo,ValorAnterior,ValorActual) ")
      SQL.ADD(" VALUES ('"~USUARIOACTIVO~"',GETDATE(), 'M', 'EVENTOS', '"~Codigoinforme~"', 'Problema de Memoria','"~Val(x:3)~"','"~Val(x:4)~"') ")
      SQL.NEW
      SQL.EXEC
    endif
  endif
endif
BorrarCeldas(v:1..x:4)
