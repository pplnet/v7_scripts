*- bb4: Fila en Que se listan los datos en CORENB
acn(bb4,12)
Message(val(bb5)) 

* Activas
if Dialogo.Radio3=1
  * Terceros
  if Dialogo.Radio6=2
     *--- DEP A PLAZO Cap.Prom/Tasa/Plazo
     ACN(val(bb1):fac  , LinkH(1, b:val(bb4)))
     ACN(val(bb1):fac+1, LinkH(1, c:val(bb4)))
     ACN(val(bb1):fac+2, LinkH(1, d:val(bb4)))
 
     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+3, VAL(val(bb1):fac)*VAL(val(bb1):fac+1))             

     *--- Consolidado por DEP A PLAZO ------------------------
     SCN(bc:val(bb6)  , VAL(val(bb1):fac  ))
     SCN(bc:val(bb6)+1, VAL(val(bb1):fac  )*VAL(val(bb1):fac+1)*VAL(bb5))
     SCN(bc:val(bb6)+2, VAL(val(bb1):fac  )*VAL(bb5))
     SCN(bc:val(bb6)+3, VAL(val(bb1):fac  )*VAL(val(bb1):fac+2))
     *--------------------------------------------------------------

     *--- CTA.CTE. Cap.Prom/Tasa/Plazo
     ACN(val(bb1):fac+4, LinkH(1, e:val(bb4)))
     ACN(val(bb1):fac+5, LinkH(1, f:val(bb4)))
     ACN(val(bb1):fac+6, LinkH(1, g:val(bb4)))

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+7, VAL(val(bb1):fac+4)*VAL(val(bb1):fac+5))             

     *--- Consolidado por CTA.CTE.------------------------
     SCN(bc:val(bb6)+4, VAL(val(bb1):fac+4))
     SCN(bc:val(bb6)+5, VAL(val(bb1):fac+4)*VAL(val(bb1):fac+5)*VAL(bb5))
     SCN(bc:val(bb6)+6, VAL(val(bb1):fac+4)*VAL(bb5))
     SCN(bc:val(bb6)+7, VAL(val(bb1):fac+4)*VAL(val(bb1):fac+6))
     *--------------------------------------------------------------

     *-- T.PUBLICOS Cap.Prom/Tasa
     ACN(val(bb1):fac+8, LinkH(1, h:val(bb4)))
     ACN(val(bb1):fac+9, LinkH(1, i:val(bb4)))

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+10, VAL(val(bb1):fac+8)*VAL(val(bb1):fac+9))             

     *--- Consolidado por T.PUBLICOS        ------------------------
     SCN(bc:val(bb6)+8 , VAL(val(bb1):fac+8))
     SCN(bc:val(bb6)+9 , VAL(val(bb1):fac+8)*VAL(val(bb1):fac+9))         
     *--------------------------------------------------------------

     *-- T.PRIVADOS Cap.Prom/Tasa
     ACN(val(bb1):fac+11, LinkH(1, j:val(bb4)))
     ACN(val(bb1):fac+12, LinkH(1, k:val(bb4)))

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+13, VAL(val(bb1):fac+11)*VAL(val(bb1):fac+12))             

     *--- Consolidado por T.PRIVADOS       ------------------------
     SCN(bc:val(bb6)+11 , VAL(val(bb1):fac+11))
     SCN(bc:val(bb6)+12 , VAL(val(bb1):fac+11)*VAL(val(bb1):fac+12))         
     *--------------------------------------------------------------

     *-- SUBTOTAL Cap.Prom/Tasa/Plazo
     ACN(val(bb1):fac+14, LinkH(1, l:val(bb4)))
     ACN(val(bb1):fac+15, LinkH(1, m:val(bb4)))
     ACN(val(bb1):fac+16, LinkH(1, n:val(bb4)))

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+17, VAL(val(bb1):fac+14)*VAL(val(bb1):fac+15))             


     *--- Consolidado por SUBTOTAL          ------------------------
     SCN(bc:val(bb6)+14, VAL(val(bb1):fac+14))
     SCN(bc:val(bb6)+15, VAL(val(bb1):fac+14)*VAL(val(bb1):fac+15)*VAL(bb5))
     SCN(bc:val(bb6)+16, VAL(val(bb1):fac+14)*VAL(bb5))
     SCN(bc:val(bb6)+17, VAL(val(bb1):fac+14)*VAL(val(bb1):fac+16))
     *--------------------------------------------------------------

     *-- ACCIONES Cap.Prom/Tasa
     ACN(val(bb1):fac+18, LinkH(1, o:val(bb4)))
     ACN(val(bb1):fac+19, LinkH(1, p:val(bb4)))

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+20, VAL(val(bb1):fac+18)*VAL(val(bb1):fac+19))             

     *--- Consolidado por ACCIONES          ------------------------
     SCN(bc:val(bb6)+18 , VAL(val(bb1):fac+18))
     SCN(bc:val(bb6)+19 , VAL(val(bb1):fac+18)*VAL(val(bb1):fac+19))
     *--------------------------------------------------------------

     *-- TOTAL Cap.Prom/Tasa/Plazo
     ACN(val(bb1):fac+21, LinkH(1, q:val(bb4)))
     ACN(val(bb1):fac+22, LinkH(1, r:val(bb4)))
     ACN(val(bb1):fac+23, LinkH(1, s:val(bb4)))
     AgregarMarco(val(bb1):fac+21..val(bb1)+1:fac+23,1)

     *-- Calculo para Sacar la Tasa en Promedio Ponderado
     ACN(val(bb1):fac+24, VAL(val(bb1):fac+21)*VAL(val(bb1):fac+22))             

     *--- Consolidado por TOTAL          ------------------------
     SCN(bc:val(bb6)+21, VAL(val(bb1):fac+21))
     SCN(bc:val(bb6)+22, VAL(val(bb1):fac+21)*VAL(val(bb1):fac+22)*VAL(bb5))
     SCN(bc:val(bb6)+23, VAL(val(bb1):fac+21)*VAL(bb5))
     SCN(bc:val(bb6)+24, VAL(val(bb1):fac+21)*VAL(val(bb1):fac+23))
     *--------------------------------------------------------------

     SetFont(val(bb1):fac..val(bb1):fac+20, 1)
     SetFont(val(bb1):fac+21..val(bb1):fac+23, 2)
     SetFilaActual(fac+24)

  endif

