SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Val(LS:1000))~") ")
SQL.ADD(" AND C.Cantidad1 <> 0 ")
SQL.ADD(" AND O.Especie <> '"~Var('MONEEXTR')~"' ")
Recorrer SQL
    IF Eqstr(fbn('Especie'), Var('MONELOCA'))
        ***---Se muestra como USD la cotizacion del peso
        ACT(ZA:fac, Var('MONEEXTR'))
    ELSE
        ACT(ZA:fac, fbn('Especie'))
    ENDIF
    ACN(ZB:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1, 1))
    ACT(ZG:fac, fbn('Especie'))
Proximo

ACT(ZC:1, Dialogo.Lista1)
ACD(ZD:1, Dialogo.Fecha1)
ACN(ZE:1, Dialogo.Check1)
ACN(ZF:1, Dialogo.Radio1)
ACT(ZG:1, Dialogo.Vehiculo1)

IF fac > 1
    ***---Hay especies <> a USD para confirmar cotizacion
    CrearDialogo
      ListBox; 'Arial,8,N'; 250; 300
       'Especie'            ;ZA:2..ZA:fac;NO;;;;70;STRING;
       'Cotizacion'         ;ZB:2..ZB:fac;SI;Val(ZB:FLB)>0;'Precio Invalido';;80;NUMERO;'###,###,###.########';
      FinListBox
      Lista1: 'Vehiculo'          ;;;;NO;NO;;;;Val(ZC:1);
      Fecha1: 'Fecha Vig.'        ;;;;NO;NO;;;;Val(ZD:1);
      Check1: 'Interes'           ;;;;NO;NO;;;;Val(ZE:1);
      Radio1: 'Consolidado|NO|SI' ;;;;NO;NO;;;;Val(ZF:1);
      Vehiculo1: 'Grupo' ;;;;NO;NO;;;;Val(ZG:1);
    FinDialogo

    IF Not OK
        Cancelar
    ENDIF

    ACN(ZC:1, fac)
ENDIF

