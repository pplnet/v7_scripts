*----------------------------------------------------------------------------------------------
* Comitenete Origen               Pic X(18)
* Comitenete Contraparte          Pic X(18)
*----------------------------------------------------------------------------------------------
ACT(A2, Val(A2)~Pad0('0',5))
ACT(A2, Val(A2)~Pad0('0',5))
ACT(A2, Val(A2)~Pad0('0',1))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',9))
ACT(A2, Val(A2)~Pad0('0',6))
ACT(A2, Val(A2)~Pad0(' ',1))
*- Fecha YYYYMMDD
ACT(A2, Val(A2)~Val(Y4))

ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad0('0',3))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad0('0',3))
ACT(A2, Val(A2)~Pad0('0',2))
ACT(A2, Val(A2)~Pad0('0',2))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',8))
ACT(A2, Val(A2)~Pad0('0',8))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',11))
ACT(A2, Val(A2)~Pad(' ',11))
ACT(A2, Val(A2)~Pad(' ',11))
ACT(A2, Val(A2)~Pad(' ',15))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad(' ',1))
*- Hora
ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
ACT(A2, Val(A2)~Copy(Val(Y2),4,2))

ACT(A2, Val(A2)~Pad(' ',6))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad0('0',18))
ACT(A2, Val(A2)~Pad(' ',1))
ACT(A2, Val(A2)~Pad0('0',13))

if SI o Incluido(fbn['TipoOp'],'TIC|TIFC|')
   *** Comitente Origen
   ACT(A2, Val(A2)~Pad(' ',18))
   *** Comitente Contraparte
   If [Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))] y Not Incluido(val(TD1),'3')
      BorrarCeldas(xx:1..xx:1)
      ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
      If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
         Borrarceldas(yy:1..yy:1)
         ACT(yy:2,FBN['Cliente1'])
         (.'CUITMAE'.)        
         ACT(A2, Val(A2)~Pad(Val(yy:10),18))
      Else
         ACT(A2, Val(A2)~Pad(' ',18))
      Endif 
   Else
      ACT(A2, Val(A2)~Pad(' ',18))
   Endif 
else
   *** Comitente Origen
   If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
      BorrarCeldas(xx:1..xx:1)
      ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
      If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
         Borrarceldas(yy:1..yy:1)
         ACT(yy:2,FBN['Cliente1'])
         (.'CUITMAE'.)        
         ACT(A2, Val(A2)~Pad(Val(yy:10),18))
      Else
         ACT(A2, Val(A2)~Pad(' ',18))
      Endif 
   Else
      ACT(A2, Val(A2)~Pad(' ',18))
   Endif 
   *** Comitente Contraparte
   ACT(A2, Val(A2)~Pad(' ',18))
endif
