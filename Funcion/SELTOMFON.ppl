
** Selecciono MMPCCV de Tipo=Prestamo y VIMIND,VIMINM 
SQL.ADD(" Select 1 Orden, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cantidad Importe,   ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMPCCV' THEN O.TotalNetoCli1+O.TotalIVA ELSE CASE O.TipoOp WHEN 'VIMINM' THEN O.Cantidad+O.TotalIntereses+O.TotalIVA ELSE O.Cantidad+O.TotalIntereses END END ImporteVto, ")
SQL.ADD(" 0 ImpInt, O.TasaImp1, ")
SQL.ADD(" CASE O.TipoOp WHEN 'VIMINM' THEN 0 ELSE O.Cantidad END Cantidad , ")
SQL.ADD(" O.Spread , ")
SQL.ADD(" O.TotalComisiones Comision, ")
SQL.ADD(" O.Precio1 Tasa, ")
SQL.ADD(" O.RB8, O.TotalIVA IVA, O.Precio4 TasaTotal ")
SQL.ADD(" from "~DBO~".OPERACIONES  O  ")
SQL.ADD(" where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"'  ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD(" and  ( (O.TipoOp In ('MMPCCV') and O.MB3=0) or (O.TipoOp In ('VIMIND','VIMINM') and O.MB3=1) )  ")
SQL.ADD(" and  O.Especie In ('"~Dialogo.Especie1~"')  ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
endif

SQL.ADD(" UNION ALL  ")

** Selecciono MMPCCM de Tipo=Prestamo
SQL.ADD(" Select 1 Orden, O.Cliente1, O.Vehiculo1, O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.NrOperacion, O.TipoOp,  ")
SQL.ADD(" C.Cantidad1 Importe, C.Total1+C.Total4 ImporteVto,  ")
SQL.ADD(" 0 ImpInt, O.TasaImp1, ")
SQL.ADD(" C.Cantidad2 Cantidad,  ")
SQL.ADD(" C.Precio4 Spread, ")
SQL.ADD(" 0 Comision,  ")
SQL.ADD(" C.Precio2 Tasa, ")
SQL.ADD(" O.RB8, C.Total4 IVA, C.Precio3 TasaTotal ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C  ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion  ")
SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"'  ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD(" and  O.TipoOp In ('MMPCCM') and O.MB3=0   ")
SQL.ADD(" and  O.Especie In ('"~Dialogo.Especie1~"')  ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
endif

SQL.ADD(" UNION ALL ")

SQL.ADD(" Select  1 Orden, O.Cliente1, O.Vehiculo1, O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" C.Cantidad4 Importe, C.Total1+C.Precio1 ImporteVto,  ")
SQL.ADD(" C.Total9  ImpInt, O.TasaImp1, ")
SQL.ADD(" C.Cantidad2 Cantidad,  ")
SQL.ADD(" C.Precio4 Spread, ")
SQL.ADD(" 0 Comision,  ")
SQL.ADD(" C.Precio2 Tasa, ")
SQL.ADD(" O.RB8, C.Precio1 IVA, C.Total3 TasaTotal ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O  ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion  ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV')  ")
SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and  O.Especie In ('"~Dialogo.Especie1~"')  ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
endif
 
SQL.ADD(" UNION ALL  ")

** Selecciono tambien las MMFIMV, MMSIMV que no tienen cuotas asociadas
SQL.ADD(" Select  2 Orden, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp,  ")
