               *  Interfase Bantotal
               * Parámetros Salida
               * RR:1  'OK/NOK'  
               * RR:2  'Mensaje'  

               * Parámetros entrada
               * RR:10  'Referencia'  
               * RR:11  'Sucursal'  
               * RR:12  'Cuenta(1a7)'    
               * RR:13  'SubOperacion-Cuenta (9a10)'
               * RR:14  'Moneda'
               * RR:15  'Importe'
               * RR:16  'Observaciones'
               * RR:17  'Importe a Bloquear'
               * RR:18  'Importe a Debitar / Acreditar'
               * RR:19  'Cliente'
               * RR:20  'Cuenta'
               * RR:21  'Especie'
               * RR:22  'Importe Bloqueado'
               * RR:23  'Importe Debitado / Acreditado'
               * RR:24  'Tipo operacion'
               * RR:25  'Mercado'
               * RR:26  'Tipo Transferencia'
               * RR:27  'Capital'
               * RR:28  'Comisiones'
               * RR:29  'Derechos'
               * RR:30  'Iva'
               * RR:31  'Intereses'
               * RR:32  'Cod Evento (producto)'
               * RR:33  'Fecha Valor'
               * RR:34  'Referencia Corte'
               * RR:35  'Referencia Acciones'
               * RR:36  'Transaccion'
               * RR:37  'Fecha Cont'
               * RR:38  'Modulo' 
               * RR:39  'Relacion'
               * RR:40  'Tipo: 1 Resta_Liquidacion/'
               * RR:41  'Referencia CAMEST'

               * RR:47  'Capital Accion'
               * RR:48  'Comisiones Accion'
               * RR:49  'Derechos Accion'
               * RR:50  'Iva Accion'
               * RR:51  'Intereses Accion'

               * RR:57  'Capital Cupon'
               * RR:58  'Comisiones Cupon'
               * RR:59  'Derechos Cupon'
               * RR:60  'Iva Cupon'
               * RR:61  'Intereses Cupon'

               * RR:67  'Capital Camest'
               * RR:68  'Comisiones Camest'
               * RR:69  'Derechos Camest'
               * RR:70  'Iva Camest'
               * RR:71  'Intereses Camest'
               
               BorrarCeldas(rr:1..rr:50)
*               ACT(rr:10, FBN['NrOperacion']~'|')
               * Cuenta
               ACT(rr:12, Copy(Val(bh:&i),1,7))
               ACT(rr:13, Copy(Val(bh:&i),9,2))
               ACN(rr:17, 0)
               * Cantidad
               ACN(rr:18, Val(bf:&i))
               * Cliente
               ACT(rr:19, Val(ba:&i))
               * Cuenta
               ACT(rr:20, Val(bh:&i))
               * Especie
               ACT(rr:21, Val(bb:&i))
               * Mercado
               ACT(rr:25, Val(bg:&i))
               ACT(rr:26, 'CAMEST')
               ACT(rr:33, Dialogo.Fecha1)
               * Cantidad
               ACT(rr:27, Val(bf:&i))
               ACT(rr:28, '0')
               ACT(rr:29, '0')
               ACT(rr:30, '0')
               ACT(rr:31, '0')
               ACT(rr:32, '3')
               ACT(rr:35, '0')
               ACT(rr:37, '0')
               ACT(rr:38, '0')
               ACT(rr:39, '0')
               ACT(rr:40, '0')
               * NrTrans
               ACT(rr:41, Val(bi:&i)~'|')
               * Cantidad
               ACT(rr:67, '0')
               ACT(rr:68, '0')
               ACT(rr:69, '0')
               ACT(rr:70, '0')
               * Intereses
               ACT(rr:71, Val(bf:&i))
               
               act(rr:1,'OK')

               (.'GRAVOUCONS'.)

               If Eqstr(val(rr:1),'OK')
                  if val(rr:18)<0
                     * Debito de Saldo
                     ACN(rr:15, ABS(val(rr:18)))
                     ACT(rr:24, 'DB')
                     BorrarCeldas(rr:1..rr:2)
                     act(rr:1,'NOK')
                  else
                     if val(rr:18)>0
                     * Credito de Saldo
                        ACN(rr:15, ABS(val(rr:18)))
                        ACT(rr:24, 'CR')
                        BorrarCeldas(rr:1..rr:2)
                        act(rr:1,'NOK')
                     endif                                
                  endif
               else
                  if val(rr:18)<0
                     * Debito de Saldo
                     ACT(rr:24, 'DB')
                  else   
                     if val(rr:18)>0
                        * Credito de Saldo
                        ACT(rr:24, 'CR')
                     endif
                  endif
               endif

               (.'VOUCONSSTA'.)                      
