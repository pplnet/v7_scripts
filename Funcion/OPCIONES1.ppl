scn(c:200,1)
scn(d:200,1)
scn(f:200,6)
scn(g:200,6)


SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.MB3, O.FechaVto Fecha, ")
SQL.ADD("Sum(O.TotalNetoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('DPBOA','DPBOD','DPBOS','DPOA','DPOD','DPOGA','DPOGD','DPOGS','DPOS','DSEO','DTO','DTOM','DTOV','DPSN','DPBOD','DPOD','DPOA','DFXO') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.MB3, O.FechaVto ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif


  if Incluido(fbn['MB3'],'0')
     If Incluido(fbn['Especie'],'ARP')
        scn(val(e:200):val(f:200),fbn['Monto'])
        scn(val(e:200):val(i:200),fbn['Monto'])
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
     else
        scn(val(e:200):val(g:200),fbn['Monto']*Val(zz2))

        scn(val(e:200):val(l:200),fbn['Monto']*Val(zz2))

        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),fbn['Monto']*Val(zz2))
        scn(b:val(v:200),fbn['Monto']*Val(zz2))
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
       else
        scn(val(e:200):val(w:200),fbn['Monto']*Val(zz2))
        scn(b:val(w:200),fbn['Monto']*Val(zz2))
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
    else
     If Incluido(fbn['Especie'],'ARP')
        scn(val(e:200):val(c:200),fbn['Monto'])
        scn(val(e:200):val(h:200),fbn['Monto'])
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        scn(val(e:200):val(d:200),fbn['Monto']*Val(zz2))

        scn(val(e:200):val(k:200),fbn['Monto']*Val(zz2))

        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),fbn['Monto']*Val(zz2))
        scn(b:val(t:200),fbn['Monto']*Val(zz2))
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
       else
        scn(val(e:200):val(x:200),fbn['Monto']*Val(zz2))
        scn(b:val(x:200),fbn['Monto']*Val(zz2))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
proximo

*- Incremento los contadores
scn(c:200,4)
scn(d:200,4)
scn(f:200,1)
scn(g:200,1)

*-- Calculo del Trading para las Opciones de Securities
SQL.ADD("Select O.Vehiculo1,O.ContraEspecie Especie,O.Especie Titulo,O.MB3,O.MB1,O.FechaVto Fecha,O.PrecioEj,O.FechaEj, ")
SQL.ADD("Sum(O.Cantidad)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaEj   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('DSEO') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1,O.ContraEspecie,O.Especie,O.MB3,O.MB1,O.FechaVto,O.PrecioEj,O.FechaEj ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL

  Message('*-- Calculo del Trading para las Opciones de Securities  '~fbn['Especie']~' '~fbn['Titulo']~' '~Fstr(fbn['Monto'],0,2))

  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:201),fbn['Titulo']~iif(fbn['MB1']=0,'CAL','PUT')~Round(fbn['FechaEj'],6)~Fstr(fbn['PrecioEj'],0,8) )
     *- Obtengo la cotizacion del dia del titulo
     acn(ck1,Cotizacion(fbn['Titulo'],iif(fbn['MB1']=0,'CAL','PUT'),Round(fbn['FechaEj'],6),fbn['PrecioEj'],Fsys,1))
     ACT(aa:201, fbn['Titulo']~iif(fbn['MB1']=0,'CAL','PUT')~Round(fbn['FechaEj'],6)~Fstr(fbn['PrecioEj'],0,8)) 
  Endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  if Incluido(fbn['MB3'],'0')
     Message('*--- Compra ')
     Message('Cotizacion '~Fstr(val(ck1),0,2) )

     If Incluido(fbn['Especie'],'ARP') 
        *-- Call
        If EqStr(FBN['MB1'],'0') 
           *- Cotizacion>Strike -> Activo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf
        *-- Put
        If EqStr(FBN['MB1'],'1') 
           *- Cotizacion<Strike -> Activo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf

        scn(val(e:200):val(c:200),val(ck3))
        scn(val(e:200):val(h:200),val(ck3))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        *- Obtengo la cotizacion del dia del titulo
        Message('Cotizacion '~Fstr(val(ck1),0,2) )

        *-- Call
        If EqStr(FBN['MB1'],'0')
           *- Cotizacion>Strike -> Activo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf
        *-- Put
        If EqStr(FBN['MB1'],'1') 
           *- Cotizacion<Strike -> Activo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf

        Message('Monto  '~Fstr(val(ck3),0,2) )

        scn(val(e:200):val(d:200),val(ck3)*Val(zz2))
        scn(val(e:200):val(k:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif

     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),val(ck3)*Val(zz2))
        scn(b:val(t:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     else
        scn(val(e:200):val(x:200),val(ck3)*Val(zz2))
        scn(b:val(x:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  else    
     Message('*--- Venta')
     Message('Cotizacion '~Fstr(val(ck1),0,2) )

     If Incluido(fbn['Especie'],'ARP')

        *-- Call
        If EqStr(FBN['MB1'],'0') 
           *- Cotizacion>Strike -> Pasivo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf

        *-- Put
        If EqStr(FBN['MB1'],'1') 
           *- Cotizacion<Strike -> Pasivo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf

        Message('Monto  '~Fstr(val(ck3),0,2) )

        scn(val(e:200):val(f:200),val(ck3))
        scn(val(e:200):val(i:200),val(ck3))
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
     else
        *-- Call
        If EqStr(FBN['MB1'],'0') 
           *- Cotizacion>Strike -> Pasivo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf

        *-- Put
        If EqStr(FBN['MB1'],'1') 
           *- Cotizacion<Strike -> Pasivo
           acn(ck3,val(ck1)*FBN['Monto'])
        EndIf
    
        Message('Monto  '~Fstr(val(ck3),0,2) )

        scn(val(e:200):val(g:200),val(ck3)*Val(zz2))
        scn(val(e:200):val(l:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),val(ck3)*Val(zz2))
        scn(b:val(v:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
     else
        scn(val(e:200):val(w:200),val(ck3)*Val(zz2))
        scn(b:val(w:200),val(ck3)*Val(zz2))
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
  endif
proximo

*- Decremento los contadores para no modificar la fc. COBERTURA
scn(c:200,-4)
scn(d:200,-4)
scn(f:200,-1)
scn(g:200,-1)
