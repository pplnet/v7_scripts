*---- Titulos a Termino
scn(c:200,2)
scn(d:200,2)
SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, E.Cotiza, O.Vehiculo2,E.VTeorico,E.InteresesC, ")
SQL.ADD("Sum(O.Cantidad)/1000 Monto from "~DBO~".OPERACIONES  O, "~DBO~".ESPECIES E  ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('SECT','SEVT','SECTV','SEVTV') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, E.Cotiza, O.Vehiculo2,E.VTeorico,E.InteresesC ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  *- cs1: Obtengo el precio sucio 
  act(x96,FBN['Especie'])
  acd(x97,Dialogo.Fecha1)
  acn(x94,FBN['VTeorico'])
  acn(x93,FBN['Monto'])
  act(x92,FBN['InteresesC'])

  (.'SUCIOPOSFI'.)

  if Incluido(fbn['TipoOp'],'SEVT|SEVTV')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(f:200),fbn['Monto']*val(cs1))
        scn(val(e:200):val(i:200),fbn['Monto']*val(cs1))
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(f:200),fbn['Monto']*val(cs1))
              scn(b:val(i:200),fbn['Monto']*val(cs1))
           endif
        endif
       else
        scn(val(e:200):val(g:200),fbn['Monto']*val(cs1))
        scn(val(e:200):val(l:200),fbn['Monto']*val(cs1))
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(g:200),fbn['Monto']*val(cs1))
              scn(b:val(l:200),fbn['Monto']*val(cs1))
           endif
        endif
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),fbn['Monto']*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(v:200),fbn['Monto']*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
       else
        scn(val(e:200):val(w:200),fbn['Monto']*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(w:200),fbn['Monto']*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
    else
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200),fbn['Monto']*val(cs1))
        scn(val(e:200):val(h:200),fbn['Monto']*val(cs1))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(c:200),fbn['Monto']*val(cs1))
              scn(b:val(h:200),fbn['Monto']*val(cs1))
           endif
        endif
       else
        scn(val(e:200):val(d:200),fbn['Monto']*val(cs1))
        scn(val(e:200):val(k:200),fbn['Monto']*val(cs1))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(d:200),fbn['Monto']*val(cs1))
              scn(b:val(k:200),fbn['Monto']*val(cs1))
           endif
        endif
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),fbn['Monto']*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(t:200),fbn['Monto']*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     else
        scn(val(e:200):val(x:200),fbn['Monto']*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(x:200),fbn['Monto']*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
proximo

