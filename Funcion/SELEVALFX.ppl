**** FX SPOTS -> Solo mark to market
ifa
ACT(a:FAC  , 'DIVISAS')
SetFont(a:fac,1)

SetFilaActual(fac+2)
ACT(a:FAC  , 'Vehiculo')
ACT(b:FAC  , 'Tipo')
ACT(b:FAC+1, 'Operacion')
ACT(c:FAC  , 'F.Inicio')
ACT(d:FAC  , 'Entidad')
ACT(e:FAC  , 'Monto')
ACT(e:FAC+1, 'Inicial')
ACT(f:FAC  , 'Monto')
ACT(g:FAC  , 'NrOperacion')
ACT(h:FAC  , 'Criterio')
ACT(h:FAC+1, 'Valuac. ')
ACT(i:FAC  , 'TC Pactado')
ACT(j:FAC  , 'TC FVal')
ACT(k:FAC  , 'Net_Market')
ACT(k:FAC+1, 'Value')
ACT(l:FAC  , 'P&L  ')
ACT(m:FAC  , 'Especie ')
ACT(n:FAC  , 'ContraEspecie')
ACT(o:FAC  , 'Vto')
ACT(o:FAC+1, 'Sett')

AgregarMarco(a:fac..o:fac+1,2,2,Exe('COLOR6') )
SetFont(a:fac..z:FAC+1,1)
SetFilaActual(fac+1)

SQL.ADD(" Select 1 as Orden,             O.NrOperacion,          O.Cantidad as CapIni, O.FechaOp as FechaIni, ")
SQL.ADD("        O.FechaVto as FechaVto, O.Cliente1,             O.Vehiculo1,          O.Especie, ")
SQL.ADD("        O.TipoOp,               O.TotalBrutoCli1 Monto, O.Precio1,            O.PrecioRef, ")
SQL.ADD("        O.Especie as EspecieOp, O.ContraEspecie,        null as FechaPago,    O.Plazo, ")
SQL.ADD("        O.RB8 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.PrecioRef Is Not Null ")
SQL.ADD(" and  O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  (O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' or O.FechaPago>='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" and   O.TipoOp In ('FXCS','FXVS','FXAS') ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF
ifa 

ACT(np1,'')
Recorrer SQL
   Message(FBN['NrOperacion']~FBN['PrecioRef']~Fstr(val(dc1),0,0))
   ACT(np1,FBN['NrOperacion']) 
   ACT(to1,FBN['TipoOp']) 
 
   ACT(a:FAC  , FBN['Vehiculo1'])
   ACT(b:FAC  , FBN['TipoOp'])

   ACD(c:FAC  , FBN['FechaIni'])
   ACT(d:FAC  , FBN['Cliente1'])

   ACN(e:FAC  , FBN['CapIni'])
   ACN(f:FAC  , FBN['Monto'])

   ACT(g:FAC, FBN['NrOperacion'])
   ACLO(g:FAC, FBN['NrOperacion'])
   ACT(h:FAC  , 'MToMarket')
   ACN(i:FAC  , FBN['Precio1'])
   ACN(j:FAC  ,  CotizacionC(FBN['EspecieOp'],,,, Dialogo.Fecha1, 1, SI, FBN('ContraEspecie')) )
   if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['EspecieOp']~"' and Especie2='"~FBN('ContraEspecie')~"' "),'INV')
      ACN(j:fac,1/Val(j:fac))
      ACN(l:fac,1/Val(xl:fac))
   Endif
   ACT(m:FAC  , FBN['Especie'])
   ACT(n:FAC  , FBN['ContraEspecie'])
   ACD(o:FAC  , FBN['FechaVto'])

   ACN(k:FAC,val(e:FAC)*CotizacionC(FBN['EspecieOp'],,,, Dialogo.Fecha1, 1, SI, FBN('ContraEspecie')) )
   ACN(l:FAC,val(f:FAC)-val(e:FAC)*CotizacionC(FBN['EspecieOp'],,,, Dialogo.Fecha1, 1, SI, FBN('ContraEspecie')))

   If Not Incluido(FBN['TipoOp'],'FXVS|FXAS')
      ACN(k:FAC,val(k:FAC))
      ACN(l:FAC,-val(l:FAC))
   EndIf
   SetFont(a:FAC..v:FAC,2)

   SetFont(a:fac..v:fac,2)
   FormatoCeldas(p:fac..p:fac, Exe('F8'))


Proximo


SetFont(a:FAC..v:FAC,2)
