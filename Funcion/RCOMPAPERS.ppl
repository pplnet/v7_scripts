   SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, (CASE WHEN O.TipoOp='MMONM ' THEN O.TotalComisiones/1000 ELSE 0 END) Imp, ")
   SQL.ADD(" C.NrCuota,C.Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMONM', 'MMFIMV') ")
   SQL.ADD(" and  O.MB2 = '1' ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
*   SQL.ADD(" DECODE(O.TipoOp, 'MMON  ', O.Cantidad/1000, O.TotalBrutoCli2/1000) Cant, O.TotalIntereses/1000 Int, ")
*   SQL.ADD(" DECODE(O.TipoOp, 'MMON  ', (O.TotalComisiones + O.TotalAux3 + O.ImporteImp)/1000, (O.TotalNetoCli2 - O.TotalIntereses)/1000) Imp, ")
   SQL.ADD(" (CASE WHEN O.TipoOp='MMON  ' THEN O.Cantidad/1000 ELSE O.TotalBrutoCli2/1000 END) Cant, O.TotalIntereses/1000 Int, ")
   SQL.ADD(" (CASE WHEN O.TipoOp='MMON  ' THEN (O.TotalComisiones + O.TotalAux3 + O.ImporteImp)/1000 ELSE (O.TotalNetoCli2 - O.TotalIntereses)/1000 END) Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD(" where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') and O.MB2='1' ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD(" Cantidad/1000 Cant, 0 as Int, ")
*   SQL.ADD(" DECODE(O.TipoOp, 'MMON  ', TotalComisiones/1000, 0) Imp, 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" (CASE WHEN O.TipoOp='MMON  ' THEN TotalComisiones/1000 ELSE 0 END) Imp, 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD(" where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  O.TipoOp In ('MMON', 'MMFRNP') ")
   SQL.ADD(" and  O.MB2 = '1' ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
*SQL.ADD(" 0 as Cant, 0 as Int, DECODE(O.TipoOp, 'MMONM ', (C.Importe1 + C.Importe3 + C.Precio2), C.Importe4) /1000 Imp, ")
SQL.ADD(" 0 as Cant, 0 as Int, (CASE WHEN O.TipoOp='MMONM ' THEN (C.Importe1 + C.Importe3 + C.Precio2) ELSE C.Importe4 END) /1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" O.TipoOp In ('MMONM','MMFIMV','MMON','MMFRNP') and  O.MB2='1' ")
SQL.ADD(" ) ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
*   SQL.ADD(" 0 as Cant, 0 as Int, DECODE(O.TipoOp, 'MMONM ', (C.Importe1 + C.Importe3 + C.Precio2), C.Importe4) /1000 Imp, ")
   SQL.ADD(" 0 as Cant, 0 as Int, (CASE WHEN O.TipoOp='MMONM ' THEN (C.Importe1 + C.Importe3 + C.Precio2) ELSE C.Importe4 END) /1000 Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ( ")
   SQL.ADD(" O.TipoOp In ('MMONM','MMFIMV','MMON','MMFRNP') and  O.MB2='1' ")
   SQL.ADD(" ) ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf
Endif

SQL.ADD("order by 1, 2, 4, 6 ")

RECORRER SQL
   If FBN['Fecha'] >= Dialogo.Fecha1
      If Val(bb:2010) = 0
         ACT(c:fac, "Commercial papers")
         SetFont(c:fac, 2)
         ACN(bb:2010, 1)
         SCN(f:2000, 1)
           
         *--> Seteo en cero la fila
         RECORRER&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO
      EndIf   

      ACN(mt:1001, FBN('Cant'))
      ACN(mt:2002, FBN('Int'))
      ACN(mt:3003, FBN('Imp'))

      ACN(mt:1100, 0)
      SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003))
   
      *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
      If Val(cz:2) = 0
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)))
      Else
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)))
      EndIf
   
      If Dialogo.Radio10 = 0 y FBN['Precio2']=0 
         ACT(NT:1000, fbn('NrOperacion'))
         (.'RMONTOTOMV'.)
      Endif

      If EqStr(FBN['Tipo'],'Cap') 
         RECORRER&i Val(VT:1), Val(lm:1)
            If FBN['Fecha'] = Val(&i:Val(xx:2000))
               ACN(&i:Val(af:2000), Round(Val(&i:Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         PROXIMO

         RECORRER&i Val(lm:1)+1, Val(lm:2)
            If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
               ACN(&i:Val(af:2000), Round(Val(&i:Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            EndIf       
         PROXIMO

         *--> Para la ultima columna de meses
         If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
            ACN(Val(lm:2):Val(af:2000), Round(Val(Val(lm:2):Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         EndIf       

         *-- af2010: Nro. de Operacion que Mostro Capital
         ACT(af:2010,FBN['NrOperacion'])   
      Else
    
         RECORRER&i Val(VT:1), Val(lm:1)
            If FBN['Fecha'] = Val(&i:Val(xx:2000))
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         PROXIMO

         RECORRER&i Val(lm:1)+1, Val(lm:2)-1
            If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         PROXIMO

         *--> Para la ultima columna de meses
         If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
            ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         EndIf
      EndIf
   EndIf
PROXIMO


