*- FRN
SQL.ADD("SELECT O.Especie,Sum(O.Cantidad) as Cantidad  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT O.Especie,Sum(C.Cantidad1) as Cantidad  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie ")

*- Para que traiga todos los intereses en el Corto Plazo.
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, 0 as Cantidad  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("GROUP BY O.Especie ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.Especie, 0 as Cantidad  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("GROUP BY O.Especie ")
Endif

SQL.ADD("ORDER BY 1")

Recorrer SQL

   Message(' FRN '~FBN['Especie'])

   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
      
      *- fo1: Capital fo2:Interes + Impuestos fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo
      (.'TOTALRESU'.)

      If val(ra2)=0
         SCN(l:val(fa2),val(fo1))
         SCN(m:val(fa2),val(fo2))
         SCN(n:val(fa2),val(fo1)+val(fo2))
      Else
         SCN(o:val(fa2),val(fo1))
         SCN(p:val(fa2),val(fo2))
         SCN(q:val(fa2),val(fo1)+val(fo2))
      EndIf 

      ACN(fo1,0)
      SetFont(b:Val(fa1)..q:Val(fa1), 1)
      FormatoCeldas(e:Val(fa1), Exe('F5'))
      FormatoCeldas(j:Val(fa1), Exe('F5'))
      FormatoCeldas(f:Val(fa1), Exe('F2'))
      FormatoCeldas(k:Val(fa1), Exe('F2'))
      FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
      FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
      FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      *- Ubico la Linea a completar
      Recorrer&j Val(fi6)+10,val(fa11)
         If EqStr(FBN['Especie'],val(a:&j))
            ACN(fa1,&j)
            Break
         EndIf
      Proximo

      ACT(es1,FBN['Especie'])
  
      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      If Dialogo.Radio2<>1
         LinkearHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1='',Lista1= '',Lista2='MMFIMV|MMFRP|', Radio3=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)

         *- fo2: Interes fo3: WH devengado fo4: comisiones devengadas fo5:Tasa Promedio fo6:Plazo Promedio 
         ACN(fo2,LinkH(1,fo2)+LinkH(1,fo3)+LinkH(1,fo4))

         ACN(fo5,0)
         ACN(fo6,0)
         ACN(fo7,0)

         If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
            *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
            *- Tasa y plazo promedio solo para corto+largo
            ACN(fo5,LinkH(1,fo5)) 
            ACN(fo6,LinkH(1,fo6))
            ACN(fo7,LinkH(1,fo7))
         EndIf
         *CerrarHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1='',Lista1= '',Lista2='MMFIMV|MMFRP|')
      Endif
   EndIf

   SCN(fo1,FBN['Cantidad'])
Proximo

IF NoVacio(val(es1)) 
   *- fo1: Capital fo2:Interes + Impuestos fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo
   (.'TOTALRESU'.)


   *- Parte de TOTALRESU2
   ACN(e:val(fa1),val(e:val(fa1))/val(u:val(fa1)))
   ACN(f:val(fa1),val(f:val(fa1))/val(t:val(fa1)))

   ACN(j:val(fa1),val(j:val(fa1))/val(w:val(fa1)))
   ACN(k:val(fa1),val(k:val(fa1))/val(v:val(fa1)))

   *- Totales en Pesos (l,m,n) y Totales en USD (o,p,q).
   ACN(l:val(fa1),val(b:val(fa1))+(val(g:val(fa1))*Dialogo.Precio1))
   ACN(m:val(fa1),val(c:val(fa1))+(val(h:val(fa1))*Dialogo.Precio1))
   ACN(n:val(fa1),val(l:val(fa1))+val(m:val(fa1)))

   ACN(o:val(fa1),(val(b:val(fa1))/Dialogo.Precio1)+val(g:val(fa1)))
   ACN(p:val(fa1),(val(c:val(fa1))/Dialogo.Precio1)+val(h:val(fa1)))
   ACN(q:val(fa1),val(o:val(fa1))+val(p:val(fa1)))
   SetFont(b:Val(fa1)..q:Val(fa1), 1)

   If val(ra2)=0
      SCN(l:val(fa2),val(fo1))
      SCN(m:val(fa2),val(fo2))
      SCN(n:val(fa2),val(fo1)+val(fo2))
   Else
      SCN(o:val(fa2),val(fo1))
      SCN(p:val(fa2),val(fo2))
      SCN(q:val(fa2),val(fo1)+val(fo2))
   EndIf 
   SetFont(b:Val(fa2)..q:Val(fa2), 2)

   ACN(fo1,0)
EndIf

SetFont(b:Val(fa1)..q:Val(fa1), 1)
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

SCN(fa1, 1)

