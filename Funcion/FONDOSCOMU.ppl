ACN(fa1, Val(fi2)+3)
ACN(fa2, Val(fi4))


SQL.ADD("SELECT Distinct O.ContraEspecie FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('FCS','FCR') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
   SQL.ADD("       AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
   SQL.ADD("       AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" Order By 1 ")

ACT(es1,'')
ACN(fo1,0)
ACN(fo2,0)
ACN(fo3,0)
ACN(fo4,0)

Recorrer SQL
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['ContraEspecie']) y NoVacio(val(es1))
      (.'TOTALRESUA'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['ContraEspecie'])
      ACT(es1,FBN['ContraEspecie'])

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['ContraEspecie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['ContraEspecie']) y Not EqStr(VAR('MONEEXTR'),FBN['ContraEspecie'])
         ACN(pr1,CotizacionC(FBN['ContraEspecie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      *- Los intereses devengados los muestra solamente en el Corto
      If Dialogo.Radio2<>1      
         LinkearHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['ContraEspecie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=0, Lista2= '')
            
         *- fo1: Capital fo2: Interes  fo3:Tasa Promedio fo4:Plazo Promedio 
         ACN(fo1,LinkH(1,fo1))
         ACN(fo2,LinkH(1,fo2))
           
         ACN(fo3,0)
         ACN(fo4,0)

         *- Solo debe mostrar la tasa y el plazo promedio en el Corto+Largo
         If Dialogo.Radio2 = 2   
            ACN(fo3,LinkH(1,fo1)*LinkH(1,fo3))
            ACN(fo4,LinkH(1,fo1)*LinkH(1,fo4))
         Endif
         *CerrarHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['ContraEspecie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=0, Lista2= '')        
      Endif

   EndIf

Proximo

If NoVacio(val(es1))
   (.'TOTALRESUA'.)
   ACN(fo1,0)

   (.'TOTALRES2A'.)
EndIf


SetFont(b:Val(fa1)..q:Val(fa1), 1)
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))































if no

   ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['ContraEspecie']),1,0))
   ACN(pr1,1)

   If Not EqStr(VAR('MONELOCA'),FBN['ContraEspecie']) y Not EqStr(VAR('MONEEXTR'),FBN['ContraEspecie'])
      ACN(pr1,CotizacionC(FBN['ContraEspecie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
   EndIf

   LinkearHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['ContraEspecie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=0, Lista2= '')

   *- fo2: Capital fo1: Interes fo3: Dias Transcurridos fo4: Tasa Promedio
   ACN(fo2,LinkH(1,fo2))
   ACN(fo1,LinkH(1,fo1))
   If Dialogo.Radio2=2
      ACN(fo3,LinkH(1,fo2)*LinkH(1,fo3))
      ACN(fo4,LinkH(1,fo2)*LinkH(1,fo4))
   Endif

   *CerrarHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['ContraEspecie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=0, Lista2= '')

   If val(ra2)=0
      *- Expresado en Pesos -> Ubico las celdas en los valores de pesos
      *- b: Capital c: Interes d: Total e: TPromedio f: Plazo Promedio 
      SCN(b:val(fa1),val(fo2))
      SCN(c:val(fa1),val(fo1))
      SCN(d:val(fa1),val(fo2)+val(fo1))
      SCN(e:val(fa1),val(fo4))     
      SCN(f:val(fa1),val(fo3))

      *- Sumo Total de Activos
      SCN(b:val(fa2),val(fo2))
      SCN(c:val(fa2),val(fo1))
      SCN(d:val(fa2),val(fo2)+val(fo1))
      SCN(e:val(fa2),val(fo4))     
      SCN(f:val(fa2),val(fo3))
   Else
      *- Expresado en Dolares -> Ubico las celdas en los valores de Moneda Extranjera
      SCN(g:val(fa1),val(fo2))
      SCN(h:val(fa1),val(fo1))
      SCN(i:val(fa1),val(fo2)+val(fo1))
      SCN(j:val(fa1),val(fo4))     
      SCN(k:val(fa1),val(fo3))

      *- Sumo Total de Activos
      SCN(g:val(fa2),val(fo2))
      SCN(h:val(fa2),val(fo1))
      SCN(i:val(fa2),val(fo2)+val(fo1))
      SCN(j:val(fa2),val(fo4))     
      SCN(k:val(fa2),val(fo3))
   EndIf
   SetFont(b:Val(fa1)..q:Val(fa1), 1)
Proximo

*- Suma de Tasa Promedio y Plazo Promedio / Capital Promedio
ACN(e:val(fa1),val(e:val(fa1))/val(b:val(fa1)))
ACN(f:val(fa1),val(f:val(fa1))/val(b:val(fa1)))

ACN(j:val(fa1),val(j:val(fa1))/val(g:val(fa1)))
ACN(k:val(fa1),val(k:val(fa1))/val(g:val(fa1)))

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))

*- Totales en Pesos (l,m,n) y Totales en USD (o,p,q).
ACN(l:val(fa1),val(b:val(fa1))+(val(g:val(fa1))*Dialogo.Precio1))
ACN(m:val(fa1),val(c:val(fa1))+(val(h:val(fa1))*Dialogo.Precio1))
ACN(n:val(fa1),val(l:val(fa1))+val(m:val(fa1)))

ACN(o:val(fa1),(val(b:val(fa1))/Dialogo.Precio1)+val(g:val(fa1)))
ACN(p:val(fa1),(val(c:val(fa1))/Dialogo.Precio1)+val(h:val(fa1)))
ACN(q:val(fa1),val(o:val(fa1))+val(p:val(fa1)))

SetFont(b:Val(fa1)..q:Val(fa1), 1)
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

*- Totales de Activos
SCN(l:val(fa2),val(l:val(fa1)))
SCN(m:val(fa2),val(m:val(fa1)))
SCN(n:val(fa2),val(n:val(fa1)))

SCN(o:val(fa2),val(o:val(fa1)))
SCN(p:val(fa2),val(p:val(fa1)))
SCN(q:val(fa2),val(q:val(fa1)))

SetFont(b:Val(fa2)..q:Val(fa2), 2)
