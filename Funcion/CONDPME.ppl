CONDICIONES:

VACIO(CLIENTE1) o Not EqStr(Vehiculo1,VAR('VEHICULODE')) o VCAN18 >= VCAN5; 'Tope Maximo Graduacion excedido en ARP '~PYC(VCAN5-VCAN18,1,0)~'.-';SI;SI;FSYS;'GRAMAXEXCE'
VACIO(CLIENTE1) o Not EqStr(Vehiculo1,VAR('VEHICULODE')) o VCAN19 >= VCAN5; 'Tope Minimo Graduacion excedido en ARP '~PYC(VCAN5-VCAN19,1,0)~'.-';SI;SI;FSYS;'GRAMINEXCE'
VACIO(CLIENTE1) o Not EqStr(Vehiculo1,VAR('VEHICULODE')) o VCAN19 >= VCAN5 o VCAN20 >= (VCAN5-VCAN19); 'Exceso Tope Minimo Graduacion excede % RPC en ARP '~PYC((VCAN5-VCAN19)-VCAN20,1,0)~'.-';SI;SI;FSYS;'GRARPCEXCE'

VACIO(CLIENTE1) o Not EqStr(Vehiculo1,VAR('VEHICULODE')) o VCAN14 >= VCAN4; 'Asistencia Crediticia No Garantizada excedida en ARP '~PYC(VCAN4-VCAN14,1,0)~'.-';SI;SI;FSYS;'BCRANEXCE'
VACIO(CLIENTE1) o Not EqStr(Vehiculo1,VAR('VEHICULODE')) o VCAN15 >= VCAN5; 'Asistencia Crediticia Garantizada excedida en ARP '~PYC(VCAN5-VCAN15,1,0)~'.-'   ;SI;SI;FSYS;'BCRAGEXCE'

Precio1 >= 0;'La tasa debe ser mayor a cero';NO

SI o VACIO(CLIENTE1) o VCAN24 > 0; 'Cross Limit No Asignado'   ;SI;SI;FSYS;'CROSNOASIG'
SI o VACIO(CLIENTE1) o VCAN29 > 0; 'Facility Limit No Asignado';SI;SI;FSYS;'SUBLNOASIG'

SI o VACIO(CLIENTE1) o VCAN24 <= 0 o VPRE11 >= Plazo o RB2=1; 'Cross Limit Tenor excedido ('~FStr(VPRE11,1,0)~' dias)'   ;SI;SI;FSYS;'CROSTENOR'
SI o VACIO(CLIENTE1) o VCAN29 <= 0 o VPRE12 >= Plazo o RB2=1; 'Facility Limit Tenor excedido ('~FStr(VPRE12,1,0)~' dias)';SI;SI;FSYS;'SUBLTENOR'

SI o VACIO(CLIENTE1) o [VCAN24 <= 0 y NO] o VCAN24 >= VCAN23; 'Cross Limit excedido en USD '~PYC(VCAN23-VCAN24,1,0)~'.-';SI;SI;FSYS;'CROSEXCE'
SI o VACIO(CLIENTE1) o [VCAN29 <= 0 y NO] o VCAN29 >= VCAN28; 'Facility Limit excedido en '~Especie~' '~PYC(VCAN28-VCAN29,1,0)~'.-';SI;SI;FSYS;'SUBLEXCE'

SI; 'Facility Type Default no definido';SI;SI;FSYS;'FACIDEFA'

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO

Round(Sum(CUOTASL,6),2)=Round(CANTIDAD,2);     'Total Capital Amortizado en Cuotas no es igual al Capital';NO
Sum(CUOTASL,2)=PLAZO;        'Total Plazo en Cuotas no es igual al Plazo';NO
Vacio(NROPERACION2) o [NoVacio(NROPERACION2) y CUOTASL.FECHA2[1]>=FECHAVTO2];'La Fecha Vto. 1º cuota debe ser mayor o igual a la Fecha Vto. IMM';NO

SI o [RB2=1 o [RB2=0 y CUOTASL.CANTIDAD3[1]=BuscarCampo('OPERACIONES','Cantidad','NrOperacion',NrOperacion2)+TOTALRETENCIONES]];'El Saldo de Capital debe ser igual al total del Fondeo y Prevision';NO;

RB2=0 o [RB2=1 y NoVacio(NROPERACION3) y Query("Select count(*) from "~DBO~".OPERACIONES where NrOperacion = '"~NROPERACION3~"' and Cliente1='"~CLIENTE1~"' and Especie ='"~ESPECIE~"' and Cantidad = "~Fstr(CANTIDAD,0,0)~" and Plazo = "~PLAZO~" and Cuotas1 = "~CUOTAS1~" and FechaOp = '"~IdxDate(FECHAOP)~"' and Vehiculo1= 'INGCURA' ")=1];'El Prestamo de INGCURA no coincide con los datos ingresados';NO;

Not EqStr('DES',BuscarCampo('ESPECIES','Status','Codigo',ESPECIE));'La Especie esta deshabilitada';NO
Not EqStr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

RB2=1 o [RB2=0 y [MB2=1 o [MB2=0 y [EQSTR(ESPECIE,'ARP') y PRECIO1>=0 ] o [Not EQSTR(ESPECIE,'ARP') y PRECIO1>0]]]];'La Tasa NO puede ser negativa';

Eqstr(BuscarCampo('OPERACIONES','NrOperacion2','NrOperacion',NROPERACION2),NROPERACION) o Vacio(BuscarCampo('OPERACIONES','NrOperacion2','NrOperacion',NROPERACION2));'La IMM seleccionada esta vinculada con la operacion '~BuscarCampo('OPERACIONES','NrOperacion2','NrOperacion',NrOperacion2);NO
Vacio(NROPERACION2) o [NoVacio(NROPERACION2) y RB2=0 y EqStr(BuscarCampo('OPERACIONES','Especie','NrOperacion',NrOperacion2),Especie)];'La Especie debe ser igual a la Especie IMM';NO
Vacio(NROPERACION2) o [NoVacio(NROPERACION2) y RB2=0 y EqStr(BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',NrOperacion2),Vehiculo1)];'El Vehiculo debe ser igual al Vehiculo IMM';NO
Vacio(NROPERACION2) o [NoVacio(NROPERACION2) y RB2=0 y EqStr(BuscarCampo('OPERACIONES','Book1','NrOperacion',NrOperacion2),Book1)];'El Book debe ser igual al Book Prestador IMM';NO

[Eqstr(Especie,Opref.Especie)] o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto] o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO
[Not NoVacio(OperacionRef)] o [EqStr(BuscarCampo('OPERACIONES', 'RB6', 'NrOperacion', OPERACIONREF),'0')];'La operacion de referencia debe estar pendiente';NO

Vacio(Var('LE'~Copy(USUARIOACTIVO,1,8))) o Incluido(Ascendientes('ESPECIES',ESPECIE),Var('LE'~Copy(USUARIOACTIVO,1,8)),1);'El Operador no puede operar con la Especie elegida' ; NO

Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado));'Ingreso un Mercado de Titulos para el Mercado de Especie';NO 
Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2));'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO 

VACIO(CLIENTE1) o BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1) >= FechaOp; 'Review date Cliente vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1));SI;SI;FSYS;'RDATEVENC'
VACIO(VTXT11) o BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11) >= FechaOp; 'Review date Controlante '~VTXT11~' vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11));SI;SI;FSYS;'RDATEVENC'
