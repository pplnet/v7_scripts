**-- Saldo Inicial al d¡a anterior
SQL.ADD("SELECT S1.Cliente, S1.Especie, S1.NrSaldo, 1 Orden, '"~IdxDate(Dialogo.Fecha1-1)~"' FechaMov, Sum(S1.Saldo) as Cantidad, 0 NrGrupo,")
SQL.ADD("       'NO' CPC1, ")
SQL.ADD("       CASE when Sum(S1.Saldo)>0 then 1 else 2 end OrdenEntrada, ' ' Mercado, ")
SQL.ADD("       C.RazonSocial, 'SALINI' TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ") 
SQL.ADD("       E.Nombre, E.InteresesC, 'Saldo Inicial' Leyenda, EC.Descripcion, '00000000' NrOperacion, '' Auxiliar, ")
SQL.ADD("       0 as FechaOp, 0 as Plazo,  0 as Plazo2, '0' as ContraEspecie, ")
SQL.ADD("       0 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
SQL.ADD("       0 as TotalNetoCli1, 0 as TotalNetoCli2, 0 as TotalAux3, ")
SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'EC' Origen, 0 NrMov ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1,"~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESTADOSCUSTODIA EC ")
SQL.ADD("WHERE S1.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      ((S1.NrSaldo = "~Fstr(val(sl1),0,0)~" AND S1.NrSaldo = EC.NrSaldo) OR (S1.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND S1.NrSaldo-100 = EC.NrSaldo)) AND  " )
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Especie = E.Codigo AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente  AND ")
SQL.ADD("                        S2.Especie = S1.Especie  AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
SQL.ADD("                        S2.Cuenta  = S1.Cuenta   AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo) ")
***---Excluyo Saldos Bloqueados por venta
SQL.ADD(" AND S1.NrSaldo <> "~Val(SB:1)~"+100 ")
SQL.ADD("GROUP BY S1.Cliente, S1.Especie, S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, ")
SQL.ADD("         E.TasaIntAnterior, E.TasaIntVigente, E.Nombre, E.InteresesC, EC.Descripcion, E.Alias5  ")

SQL.ADD("UNION ALL ")

**-- Movs. Ejecutados de Transacciones de NrSaldo <> 107 no automaticos
SQL.ADD("SELECT M.Cliente, M.Especie, case when M.NrSaldo=1 then 101  WHEN M.NrSaldo=5 then 101 else M.NrSaldo end, 2 Orden, M.FechaMov, ")
SQL.ADD("       M.Cantidad, M.NrGrupo, ")
SQL.ADD("       'NO' CPC1, ")
SQL.ADD("       CASE when M.Cantidad>0 then 1 else 2 end  OrdenEntrada, M.Mercado,")
SQL.ADD("       C.RazonSocial, T.TipoTr2 as TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans as NrOperacion, 'EJE' Auxiliar, ")
SQL.ADD("       T.Fecha1 as FechaOp, 0 as Plazo,  0 as Plazo2, '' as ContraEspecie, ")
SQL.ADD("       T. Precio1 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
SQL.ADD("       T.Cambio1 as TotalNetoCli1, T.Cantidad2 as TotalNetoCli2, 0 as TotalAux3, ")
SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'TR' Origen, M.NrMov  ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)")
SQL.ADD(" OR (M.NrSaldo+100 =EC.NrSaldo  AND EC.NrSaldo="~Fstr(val(sl1),0,0)~") OR (M.NrSaldo=5 and T.TipoTr2='LCUPON' AND EC.NrSaldo=101) ) AND  "  )
SQL.ADD("      M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
*SQL.ADD("      (((T.TipoTr2 IN ('DTP', 'RTP') and T.CB6 = 0) or T.TipoTr2 IN ('DTP', 'RTP') and T.CB6 = 1 and M.Leyenda Like 'Desbloqueo%' ) or T.TipoTr2 In ('CAMEST','CUPON','LCUPON','PDIVID')) ")
***---Excluyo Saldos Bloqueados por venta
SQL.ADD("      (((T.TipoTr2 IN ('DTP', 'RTP', 'DRT') and (T.CB6 = 0 OR T.CB6 Is Null))) or T.TipoTr2 In ('CAMEST','CUPON','LCUPON','DENOP','RENOP','TRNOP')) ")
SQL.ADD(" AND M.NrSaldo <> "~Val(SB:1)~"+100 ")

IF NO
    SQL.ADD("UNION ALL ")
    **- Ordenes de Bloqueo por Ventas
    SQL.ADD("SELECT M.Cliente, M.Especie, M.NrSaldo, 2 Orden, M.FechaMov,")
    SQL.ADD("       M.Cantidad, M.NrGrupo, ")
    SQL.ADD("       'NO' CPC1, ")
    SQL.ADD("       CASE when M.Cantidad>0 then 1 else 2 end OrdenEntrada, M.Mercado,")
    SQL.ADD("       C.RazonSocial, O.TipoOrden as TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
    SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, O.NrOrden as NrOperacion, 'EJE' Auxiliar, ")
    SQL.ADD("       O.FechaOrden as FechaOp, 0 as Plazo,  0 as Plazo2, '' as ContraEspecie, ")
    SQL.ADD("       0 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
    SQL.ADD("       O.PrecioEjercicio as TotalNetoCli1, 0 as TotalNetoCli2, 0 as TotalAux3, ")
    SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'OR' Origen, M.NrMov  ")
    SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".ESPECIES E, "~DBO~".ORDENES O ")
    SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) AND ")
    SQL.ADD("      M.Cliente = C.Codigo AND ")
    SQL.ADD(" C.CategDepositante='CLI'  AND")
    IF NoVacio(Dialogo.Lista1)
       SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
    ENDIF
    IF NoVacio(Dialogo.ListaTabla2)
       SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
    ENDIF
    SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
    SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
    SQL.ADD("      M.Especie = E.Codigo AND ")
    SQL.ADD("      M.NrOperacion = O.NrOrden AND ")
    SQL.ADD("      O.TipoOrden In ('VTC','VTP','CBC','CBT','TIV','VTSUC') ")
ENDIF

SQL.ADD("UNION ALL")

**-- Movs. Ejecutados de Operaciones de NrSaldo 1,4,32,34 
SQL.ADD("SELECT M.Cliente, M.Especie, 101 NrSaldo, 2 Orden, M.FechaMov, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then M.Cantidad*-1 else M.Cantidad END Cantidad, M.NrGrupo, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then 'SI' else 'NO' end CPC1, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then (CASE when M.Cantidad>0 then 2 else 1 end) Else (CASE when M.Cantidad>0 then 1 else 2 end) END OrdenEntrada, M.Mercado,")
SQL.ADD("       C.RazonSocial, O.TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, 'Libre Disp' Descripcion, O.NrOperacion, 'EJE' Auxiliar, ")
SQL.ADD("       O.FechaOp as FechaOp, O.Plazo as Plazo, O.Plazo2 as Plazo2, O.ContraEspecie, ")
SQL.ADD("       O.Precio1 as Precio1, O.Precio2 as Precio2, O.TotalBrutoCli1 as TotalBrutoCli1, ")
SQL.ADD("       O.TotalNetoCli1 as TotalNetoCli1, O.TotalNetoCli2 as TotalNetoCli2, ")
SQL.ADD("       O.TotalAux3 as TotalAux3, O.TotalIVA as TotalIVA, O.Comision as Comision, ")
SQL.ADD("       O.TotalImpuestos as TotalImpuestos, O.TotalCaucion as TotalCaucion, E.Alias5, 'OP' Origen, M.NrMov  ") 
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  M.NrSaldo In (1, 4, 32, 34) AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF Dialogo.Check1=0
   SQL.ADD("   Not (M.NrMov in (11,12,13,14)) AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = O.NrOperacion  ")

SQL.ADD("UNION ALL ")

**-- Movs. Ejecutados de Operaciones de NrSaldo 31,
**-- es decir preliquidadas que estan pendientes de confirmaci¢n 
SQL.ADD("SELECT M.Cliente, M.Especie, 101 NrSaldo, 2 Orden, M.FechaMov, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then M.Cantidad*-1 else M.Cantidad END Cantidad, M.NrGrupo, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then 'SI' else 'NO' end CPC1, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then (CASE when M.Cantidad>0 then 2 else 1 end) Else (CASE when M.Cantidad>0 then 1 else 2 end) END OrdenEntrada, M.Mercado,")
SQL.ADD("       C.RazonSocial, O.TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, 'Libre Disp' Descripcion, O.NrOperacion, 'PEN' Auxiliar, ")
SQL.ADD("       O.FechaOp as FechaOp, O.Plazo as Plazo, O.Plazo2 as Plazo2, O.ContraEspecie, ")
SQL.ADD("       O.Precio1 as Precio1, O.Precio2 as Precio2, O.TotalBrutoCli1 as TotalBrutoCli1, ")
SQL.ADD("       O.TotalNetoCli1 as TotalNetoCli1, O.TotalNetoCli2 as TotalNetoCli2, ")
SQL.ADD("       O.TotalAux3 as TotalAux3, O.TotalIVA as TotalIVA, O.Comision as Comision, ")
SQL.ADD("       O.TotalImpuestos as TotalImpuestos, O.TotalCaucion as TotalCaucion, E.Alias5, 'EC' Origen, M.NrMov ") 
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  M.NrSaldo In (31) AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = O.NrOperacion  ")

SQL.ADD("UNION ALL ")

**-- Movs. Pendientes de Transacciones de NrSaldo <> 107 no automaticos
SQL.ADD("SELECT M.Cliente, M.Especie, case when M.NrSaldo=1 then 101  WHEN M.NrSaldo=5 then 101 else M.NrSaldo end, 3 Orden, M.FechaMov, M.Cantidad,  M.NrGrupo,")
SQL.ADD("       'NO' CPC1, ")
SQL.ADD("       CASE when M.Cantidad>0 then 1 else 2 end OrdenEntrada, M.Mercado, ")
SQL.ADD("       C.RazonSocial, T.TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans, 'PEN' Auxiliar, ")
SQL.ADD("       T.Fecha1 as FechaOp, 0 as Plazo,  0 as Plazo2, '' as ContraEspecie, ")
SQL.ADD("       T. Precio1 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
SQL.ADD("       T.Cambio1 as TotalNetoCli1, T.Cantidad2 as TotalNetoCli2, 0 as TotalAux3, ")
SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'TR' Origen, M.NrMov ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo) ")
SQL.ADD("         OR (M.NrSaldo=5 and T.TipoTr2='LCUPON' AND EC.NrSaldo=101) ) AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
*SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
*SQL.ADD("      (((T.TipoTr2 IN ('DTP', 'RTP') and T.CB6 = 0) or (T.TipoTr2 IN ('DTP', 'RTP') and T.CB6 = 1 and M.Leyenda Like 'Desbloqueo%') ) or T.TipoTr2 In ('CAMEST','CUPON','LCUPON','PDIVID')) ")
***---Excluyo Saldos Bloqueados por venta
SQL.ADD("      (((T.TipoTr2 IN ('DTP', 'RTP', 'DRT') and (T.CB6 = 0 OR T.CB6 Is Null))) or T.TipoTr2 In ('CAMEST','CUPON','LCUPON','DENOP','RENOP','TRNOP')) ")
SQL.ADD(" AND M.NrSaldo <> "~Val(SB:1)~"+100 ")

SQL.ADD(" UNION ALL")

**-- Movs. Pendientes de Operaciones de NrSaldo 1,4,32,34
SQL.ADD("SELECT M.Cliente, M.Especie, 101 NrSaldo, 3 Orden, M.FechaMov, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then M.Cantidad*-1 else M.Cantidad END Cantidad, M.NrGrupo, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then 'SI' else 'NO' end CPC1, ")
SQL.ADD("       CASE when (O.CB4=1 and NrOrden1 like 'OR%') then (CASE when M.Cantidad>0 then 2 else 1 end) Else (CASE when M.Cantidad>0 then 1 else 2 end) END OrdenEntrada, M.Mercado,")
SQL.ADD("       C.RazonSocial, O.TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, 'Libre Disp' Descripcion, O.NrOperacion, 'PEN' Auxiliar, ")
SQL.ADD("       O.FechaOp as FechaOp, O.Plazo as Plazo, O.Plazo2 as Plazo2, O.ContraEspecie, ")
SQL.ADD("       O.Precio1 as Precio1, O.Precio2 as Precio2, O.TotalBrutoCli1 as TotalBrutoCli1, ")
SQL.ADD("       O.TotalNetoCli1 as TotalNetoCli1, O.TotalNetoCli2 as TotalNetoCli2, ")
SQL.ADD("       O.TotalAux3 as TotalAux3, O.TotalIVA as TotalIVA, O.Comision as Comision, ")
SQL.ADD("       O.TotalImpuestos as TotalImpuestos, O.TotalCaucion as TotalCaucion, E.Alias5, 'OP' Origen, M.NrMov ") 
SQL.ADD("FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  M.NrSaldo In (1, 4, 32, 34)  AND ")
SQL.ADD("       M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF Dialogo.Check1=0
   SQL.ADD("   Not (M.NrMov in (11,12,13,14)) AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
*SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = O.NrOperacion  ")
*SQL.ADD("     and O.TipoOp in ('TIPO','TICO','TICT','TIDE')  ")
*SQL.ADD("     and O.Nroperacion = 'T0007646' ")
SQL.ADD(" UNION ALL")

**-- Movs. Ejecutados de Transacciones de NrSaldo 101 y Bloqueos
SQL.ADD("SELECT M.Cliente, M.Especie, case when M.NrSaldo=1 then 101  WHEN M.NrSaldo=5 then 101 else M.NrSaldo end, 2 Orden, M.FechaMov, ")
SQL.ADD("       M.Cantidad, M.NrGrupo, ")
SQL.ADD("       'NO' CPC1, ")
SQL.ADD("       CASE when M.Cantidad>0 then 1 else 2 end  OrdenEntrada, M.Mercado,")
SQL.ADD("       C.RazonSocial, T.TipoTr2 as TipoOp, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans as NrOperacion, 'EJE' Auxiliar, ")
SQL.ADD("       T.Fecha1 as FechaOp, 0 as Plazo,  0 as Plazo2, '' as ContraEspecie, ")
SQL.ADD("       T. Precio1 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
SQL.ADD("       T.Cambio1 as TotalNetoCli1, T.Cantidad2 as TotalNetoCli2, 0 as TotalAux3, ")
SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'TR' Origen, M.NrMov  ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C,"~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESTADOSCUSTODIA EC ")
SQL.ADD("WHERE M.Cliente = C.Codigo AND ")
SQL.ADD("((M.NrSaldo > 101+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = 101 AND M.NrSaldo = EC.NrSaldo) OR (M.NrSaldo=1  AND EC.NrSaldo=101)) and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   T.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF Dialogo.Check1=0
   SQL.ADD("    not (M.NrMov in (4,5,6,7,8,9)) AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
SQL.ADD("      T.TipoTr2 In ('CANJE','STOCK','PDIVID') AND ")
SQL.ADD(" (T.Cambio5 = 101 or  (T.Cambio5 > 203 and T.Cambio5 < 208)) ")

SQL.ADD(" UNION ALL")

**-- Movs. Pendientes de Transacciones de NrSaldo 101 y Bloqueos
SQL.ADD("SELECT M.Cliente, M.Especie, case when M.NrSaldo=1 then 101  WHEN M.NrSaldo=5 then 101 else M.NrSaldo end, 3 Orden, M.FechaMov, M.Cantidad,  M.NrGrupo,")
SQL.ADD("       'NO' CPC1, ")
SQL.ADD("       CASE when M.Cantidad>0 then 1 else 2 end OrdenEntrada, M.Mercado, ")
SQL.ADD("       C.RazonSocial, T.TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans, 'PEN' Auxiliar, ")
SQL.ADD("       T.Fecha1 as FechaOp, 0 as Plazo,  0 as Plazo2, '' as ContraEspecie, ")
SQL.ADD("       T. Precio1 as Precio1, 0 as Precio2, 0 as TotalBrutoCli1, ")
SQL.ADD("       T.Cambio1 as TotalNetoCli1, T.Cantidad2 as TotalNetoCli2, 0 as TotalAux3, ")
SQL.ADD("       0 as TotalIVA, 0 as Comision, 0 TotalImpuestos, 0 as TotalCuacion, E.Alias5, 'TR' Origen, M.NrMov ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESTADOSCUSTODIA EC ")
SQL.ADD("WHERE M.Cliente = C.Codigo AND ")
SQL.ADD("((M.NrSaldo > 101+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = 101 AND M.NrSaldo = EC.NrSaldo) OR (M.NrSaldo=1  AND EC.NrSaldo=101)) and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   T.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF Dialogo.Check1=0
   SQL.ADD("    not (M.NrMov in (4,5,6,7,8,9)) AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
SQL.ADD("      T.TipoTr2 In ('CANJE','STOCK','PDIVID') AND ")
SQL.ADD(" (T.Cambio5 = 101 or  (T.Cambio5 > 203 and T.Cambio5 < 208)) ")

SQL.ADD("ORDER BY 1, 2, 3, 4, 5, OrdenEntrada ")