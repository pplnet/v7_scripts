Message('Prestamos CashFlow E ')
SCN(f:200,1)

SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo, ")
SQL.ADD(" C.Cantidad4/1000 Cant, C.Cantidad3/1000 Int, (C.Cantidad5 - C.Cantidad3)/1000 Imp, ")
SQL.ADD(" C.NrCuota, C.Precio2 ")
SQL.ADD(" From "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion=C.NrOperacion and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMONM') and  O.MB2='0') or (O.TipoOp IN ('MMFIMV'))) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN O.TotalComisiones /1000 ELSE  0 END Imp, ")
SQL.ADD(" C.NrCuota, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMONM') and  O.MB2='0') or (O.TipoOp IN ('MMFIMV'))) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD(" O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2 - O.TotalIntereses)/1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaOp2 <='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select O.Vehiculo1, O.Especie,  O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, (O.TotalNetoCli2 - O.TotalIntereses)/1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select O.Vehiculo1,O.Especie,O.FechaVto Fecha,O.NrOperacion,O.TipoOp,'Vto' as Tipo, ")
SQL.ADD(" (O.Cantidad-SUM(C.Cantidad4))/1000 Cant, 0 Int, 0 Imp, C.NrCuota, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' and  C.Fecha2>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMFIMV') and  O.RB5='1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Group By O.Vehiculo1, O.Especie, O.FechaVto, O.NrOperacion, O.TipoOp,O.Cantidad,C.Cantidad1, C.NrCuota, C.Precio2 ")

SQL.ADD(" Union All ")

SQL.ADD(" Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, 0 as Imp, C.NrCuota, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion=C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMFIMV') and  O.RB5='1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1,O.Especie,C.Fecha2 Fecha,O.NrOperacion,O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD(" C.Cantidad4/1000 Cant, C.Cantidad3/1000 Int, (C.Cantidad5 - C.Cantidad3)/1000 Imp, ")
   SQL.ADD(" C.NrCuota, C.Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   SQL.ADD(" Union All ")

   SQL.ADD(" Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
   SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, CASE O.TipoOp WHEN 'MMONM ' THEN O.TotalComisiones/1000 ELSE 0 END Imp, ")
   SQL.ADD(" C.NrCuota, C.Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and ((O.TipoOp In ('MMONM') and  O.MB2='0') or (O.TipoOp IN ('MMFIMV'))) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD(" O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2 - O.TotalIntereses)/1000 Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD(" where O.FechaOp2 <='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 'Cap' as Tipo,")
   SQL.ADD(" O.Cantidad/1000 Cant, 0 as Int, (O.TotalNetoCli2 - O.TotalIntereses)/1000 Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES O ")
   SQL.ADD(" where O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 and  O.FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif

SQL.ADD(" Union All ")

SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo,  ")
SQL.ADD(" 0 as Cant, 0 as Int, C.Importe4/1000 Imp, ")
SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) or ")
SQL.ADD(" ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) or ")
SQL.ADD(" (O.TipoOp In ('MMFIMV') and  O.RB5='1') ")
SQL.ADD(" ) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1

   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD(" 0 as Cant, 0 as Int, C.Importe4/1000 Imp, ")
   SQL.ADD(" 0 as NrCuota, 1 Precio2 ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and O.FechaOp2 <='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha1>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and ( ")
   SQL.ADD(" ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) or ")
   SQL.ADD(" ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) or ")
   SQL.ADD(" (O.TipoOp In ('MMFIMV') and  O.RB5='1') ")
   SQL.ADD(" ) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif

SQL.ADD("order by 1, 2,4,6 ")

Recorrer SQL
   ACN(MT:1, FBN('Cant'))
   ACN(MT:2, FBN('Int'))
   ACN(MT:3, FBN('Imp')) 
   
   ACN(MT:12, 0)
   *ACN(MT:12, IIf(Eqstr(SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~FBN('Especie')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1)))
   ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   If Dialogo.Radio10 = 1 y FBN['Precio2']=0
      ACT(NT:1, fbn('NrOperacion'))
      (.'MONTOTOMV'.)
   Endif
   
   ACN(MT:11, 0) 
   
   If Dialogo.Check1 = 1
      SCN(MT:11, Val(MT:1) * Val(MT:12))
   Endif
   If Dialogo.Check2 = 1
      SCN(MT:11, Val(MT:2) * Val(MT:12))
   Endif
   If Dialogo.Check3 = 1
      SCN(MT:11, Val(MT:3) * Val(MT:12))
   Endif
    
   If Dialogo.Radio2 = 0
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo       
         ACT(af:201,FBN['NrOperacion'])
      Else     
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
      Endif
   Else
      If EqStr(FBN['Tipo'],'Cap')
         Recorrer&i 2, Val(d:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200), Val(MT:11))
            Endif
         Proximo       
         ACT(af:201,FBN['NrOperacion'])
      Else
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(f:200), Val(MT:11))
               SCN(Val(p:200)+1:Val(i:200), Val(MT:11))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(f:200), Val(MT:11))
            SCN(Val(g:200):Val(i:200), Val(MT:11))
         Endif
      Endif
   Endif
Proximo

