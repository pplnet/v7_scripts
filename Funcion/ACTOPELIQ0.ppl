*** Toma todas las operaciones pendientes de liquidacion que sean futuros o ejercicios *******
*** Estas operaciones vencen despues de hoy ***
*** Se modifican los precios pero no se generan cupones ***

SQL.ADD("SELECT Distinct O.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrOperacion = O.NrOperacion ")
SQL.ADD("and   O.Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("and   M.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and   O.FechaVto > '"~IdxDate(Val(g2))~"' ")
SQL.ADD("and ((O.TipoOp In ('CFTC','CFTE','CFTP','VFTC','VFTE','VFTP') ")
SQL.ADD("      and (O.PaseCB is Null or O.PaseCB = 0)) ")
SQL.ADD("  or (O.TipoOp In ('CTE','VTE') and CB6 = 1) ")
SQL.ADD("  or (O.TipoOp In ('CTP','VTP') and CB10 = 1)) ")
SQL.ADD("and  (RB4 is Null or RB4 = 0 ) ")
SQL.ADD("order by O.TipoOp, O.Especie ")

SetFilaActual(10)
Recorrer SQL
   act(a:fac,fbn['NrOperacion'])
   
   *** Toma los futuros que vencen despues de hoy ****
   If fbn['CB9'] = 0
      acn(b:fac,fbn['Precio1'] - ((Val(k2)+Val(l2))/100))
      acn(c:fac,Val(b:fac)*fbn['Cantidad'])
      acn(d:fac,Val(c:fac)+fbn['TotalIntereses'])
     else
      acn(d:fac,fbn['TotalNetoCli1']-fbn['Cantidad']*((Val(k2)+Val(l2))/100))
      acn(c:fac,Val(d:fac)-fbn['TotalIntereses'])
      acn(b:fac,Val(c:fac)/(fbn['Cantidad']*ValorTeorico(Dialogo.ContraEspecie1)))
   endif

   *** Marca las operaciones  ****
   *** cambia el precio y el monto ***
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set Mercado3 = '"~Dialogo.ContraEspecie2~"', RB4 = 1, ")
   SQL.ADD("    Precio1 = "~Fstr(Val(b:fac),0,7)~", ")
   SQL.ADD("    TotalBrutoCli1 = "~Fstr(Val(c:fac),0,7)~", ")
   SQL.ADD("    TotalNetoCli1  = "~Fstr(Val(d:fac),0,7)~"  ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW
   SQL.EXEC

   ActualizarMovimientos(Val(a:fac),SI)
   SQL.EXEC

Proximo


*** Toma todas las operaciones de opciones con fecha de ejercicio mayor a hoy ***
*** y les modifica el precio de ejercicio *******
SQL.ADD("SELECT Distinct * ")
SQL.ADD("from "~DBO~".OPERACIONES  ")
SQL.ADD("where Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("and   Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and   FechaEj >= '"~IdxDate(Val(g2))~"' ")
SQL.ADD("and  (CB6 is Null or CB6 = 0 ) ")
SQL.ADD("and  (RB4 is Null or RB4 = 0 ) ")
SQL.ADD("and   TipoOp In ('CCE','CCP','CPE','CPP','EJC','EJV','VCE','VCP','VPE','VPP') ")
SQL.ADD("order by TipoOp, Especie ")

SetFilaActual(10)
Recorrer SQL
   act(a:fac,fbn['NrOperacion'])
   
   *** calcula el precio de ejercicio ****
   acn(b:fac,fbn['PrecioEj'] - ((Val(k2)+Val(l2))/100))

   *** Marca las operaciones con las especies nuevas ****
   *** cambia el precio y el monto ***
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set Mercado3 = '"~Dialogo.ContraEspecie2~"', RB4 = 1, ")
   SQL.ADD("    PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW
   SQL.EXEC

   SQL.ADD("Update "~DBO~".MOVPENDIENTES ")
   SQL.ADD("Set PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD("and    Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD("and    PrecioEj <> 0 ")
   SQL.NEW

   SQL.ADD("Update "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("Set PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD("and    Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD("and    PrecioEj <> 0 ")
   SQL.NEW

   SQL.EXEC
Proximo

*** Toma todas las transacciones de falla de opciones con fecha de ejercicio mayor a FCorte ***
*** y les modifica el precio de ejercicio *******
SQL.ADD("SELECT Distinct T.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where M.NrOperacion = T.NrTrans ")
SQL.ADD("and   T.Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("and   M.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and   FechaEj >= '"~IdxDate(Val(g2))~"' ")
SQL.ADD("and   T.PrecioEj <> 0 ")
SQL.ADD("and   T.TipoTr2 In ('FDEP','FRET') ")
SQL.ADD("order by T.TipoTr, T.Especie ")

SetFilaActual(10)
Recorrer SQL
   act(a:fac,fbn['NrTrans'])
   
   *** calcula el precio de ejercicio ****
   acn(b:fac,fbn['PrecioEj'] - ((Val(k2)+Val(l2))/100))

   *** Marca las operaciones con las especies nuevas ****
   *** cambia el precio y el monto ***
   SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("Set CB10 = 1, ")
   SQL.ADD("    PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrTrans = '"~Val(a:fac)~"' ")
   SQL.NEW
   SQL.EXEC

   SQL.ADD("Update "~DBO~".MOVPENDIENTES ")
   SQL.ADD("Set PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD("and    Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD("and    PrecioEj <> 0 ")
   SQL.NEW

   SQL.ADD("Update "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("Set PrecioEj = "~Fstr(Val(b:fac),0,7)~" ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD("and    Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD("and    PrecioEj <> 0 ")
   SQL.NEW

   SQL.EXEC
Proximo



