ACN(af1,100)
ACN(ag1,100)
** Nuevo para calcular los indices por dia
recorrer&i 1,31
  ACN(104+&i:1,100)
  ACN(104+&i:2,100)
  ACN(104+&i:3,&i)
proximo

ACN(pp1,fac)

ACT(jj1,'ww')
ACN(pz1,0)

ACT(ar:2,'Exp NoGar')
ACT(as:2,'Exp Gar')
ACT(at:2,'Totales')
recorrer&k 3,33
  ACN(at:&k, 0)
proximo


SQL.ADD("SELECT GE.Controlante, C.Codigo, C.RazonSocial, C.Vinculado, CT.Sector as Sector, C.Alias7, C.ActComplementarias ")
*-I
*SQL.ADD("FROM "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS GE ")
SQL.ADD("FROM "~DBO~".CLIENTES C LEFT OUTER JOIN "~DBO~".GRUPOSECONOMICOS GE ON GE.Cliente = C.Codigo")
SQL.ADD("join "~DBO~".CATEGORIACLIENTES CT on C.CategDepositante = CT.Codigo")
*SQL.ADD("WHERE GE.Cliente =* C.Codigo and GE.TipoGrupo in ('BCRA','BCHO') ")
*SQL.ADD("WHERE GE.TipoGrupo in ('BCRA','BCHO') ")
*-F
SQL.ADD("Where 1=1 ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND C.Codigo='"~val(v1)~"' ")
endif
SQL.ADD("and exists(select 1 from "~DBO~".LIMCONSUMIDOS where Limite in ('BCRAN','ACIDN','ACCON','BCRAG','ACIDG','ACCOG','ACMAN') and Cliente=C.Codigo) ")
SQL.ADD("ORDER BY 1,2 ")

Recorrer SQL 
  if EsTerminal(fbn['Codigo'],Clientes)   
    ACT(z1, fbn['Codigo'])
    if not EqStr(fbn['Controlante'],val(jj1))
      if val(pz1)=1
         AgregarMarco(a:val(pp1)..aj:fac-1,1,3)
        if Vacio(val(jj1))
          ACT(a:FAC, 'Total Sin Grupo') 
        else
          ACT(a:FAC, 'Total Grupo') 
          ACT(b:FAC, val(jj1))
        endif

        recorrer&j val(z2),val(z4)
          ** Nuevo para calcular los indices por dia
          ACN(&j-val(z2)+105:fac, val(&j-val(z2)+105:1))
          ACN(&j-val(z2)+105:fac+20, val(&j-val(z2)+105:2))

*          ACN(av:fac, val(af1))
          ** Nuevo para calcular los indices por dia
          ACN(av:fac, val(&j-val(z2)+105:1))
          * Lim No garantizado
          ACN(aw:fac, val(al:val(w1))*val(av:fac)/100)

*          ACN(ax:fac, val(ag1))
          ** Nuevo para calcular los indices por dia
          ACN(ax:fac, val(&j-val(z2)+105:2))
          * Lim garantizado
          ACN(ay:fac, val(al:val(w1))*val(ax:fac)/100)

          *ah Total Exposicion No Garantizado diario
          *ai Total Exposicion Garantizado diario

*          ACN(ap:fac, val(ar:&j-val(z2)+1))
*          ACN(aq:fac, val(as:&j-val(z2)+1))
          ACN(ap:fac, val(ar:&j-val(z2)+3))
          ACN(aq:fac, val(as:&j-val(z2)+3))

          * Exceso NO Garantizado
          ACN(bk:fac,0)
          if val(ap:fac)>val(aw:fac)
            ACN(bk:fac, val(ap:fac)-val(aw:fac))
          endif      
          * Exceso Garantizado
          ACN(bl:fac,0)
          if val(aq:fac)>val(ay:fac)
            ACN(bl:fac, val(aq:fac)-val(ay:fac))
          endif

          *Muestro el Exceso Garantizado, sino el No Garantizado
*          if not EqStr(val(jj1),'')
            if val(bl:fac)>0
              ACN(&j-val(z2)+3:fac,val(bl:fac))
            else
              ACN(&j-val(z2)+3:fac,val(bk:fac))
            endif
*          endif
          if EqStr(Val(a:FAC),'Total Sin Grupo')
            ACN(&j-val(z2)+3:fac,Sum(&j-val(z2)+3:Val(pp1)+1..&j-val(z2)+3:fac-1))
          endif
        proximo

        ACN(af1,100)
        ACN(ag1,100)    
        ** Nuevo para calcular los indices por dia
        recorrer&i 1,31
          ACN(104+&i:1,100)
          ACN(104+&i:2,100)
        proximo

*        recorrer&j 1,34
*          ACN(ar:&j,0)
*          ACN(as:&j,0)
*        proximo  
        BorrarCeldas(ar:3..as:34)
                  
        recorrer&k 3,33
          SCN(at:&k, val(&k:fac))
        proximo
*        AgregarMarco(a:FAC..ah:FAC,2,1)  
        AgregarMarco(a:FAC..aj:FAC,2,1)  
        SetFont(a:fac..aj:fac,2)
        SetFont(av:fac..bl:fac,2)
        ifa
        ACN(pp1, fac)

      else
        ACN(pz1,1)
      endif
    endif   
    * Fin Cambio Controlante

    ACT(a:FAC, val(z1))
    ACT(b:fac, fbn['Controlante'])
    ACN(zz:1,0)
    recorrer&j val(z2),val(z4)
      
      ACN(bc:FAC, LimConsumido(val(z1),'BCRAN','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(bd:FAC, LimConsumido(val(z1),'ACIDN','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(be:FAC, LimConsumido(val(z1),'ACCON','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(bf:FAC, LimConsumido(val(z1),'BCRAG','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(bg:FAC, LimConsumido(val(z1),'ACIDG','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(bh:FAC, LimConsumido(val(z1),'ACCOG','ARP',0,VAR('VEHICULODE'),,,,&j))
      ACN(bi:FAC, LimConsumido(val(z1),'ACMAN','ARP',0,VAR('VEHICULODE'),,,,&j))

      ACN(bj:FAC, Sum(bc:FAC..bi:FAC))
      If Val(bj:fac) > 0.01
        ACN(zz:1,1)
        if EqStr(fbn['ActComplementarias'],'SI') y EqStr(fbn['Vinculado'],'SI')
          * Vinculados con Act. Complementarias
          ACT(au:fac,'VAC')
          ACN(av:fac, val(an:val(w1)))
          ACN(ax:fac, val(an:val(w1)+1))
        else
          if EqStr(fbn['Vinculado'],'SI')
            * Vinculados sin Act. Complementarias
            ACT(au:fac,'VIN')
            ACN(av:fac, val(an:val(w1)+2))
            ACN(ax:fac, val(an:val(w1)+3))
          else
            if EqStr(fbn['Alias7'],'CIG')
              * Corresponsales IGG
              ACT(au:fac,'CIG')
              ACN(av:fac, val(an:val(w1)+4))
              ACN(ax:fac, val(an:val(w1)+5))
            else
              if EqStr(fbn['Alias7'],'CNIG')
                * Corresponsales NO IGG
                ACT(au:fac,'NIG')
                ACN(av:fac, val(an:val(w1)+6))
                ACN(ax:fac, val(an:val(w1)+7))          
              else
                if EqStr(fbn['Sector'],'FIN') 
                  * Financiero
                  ACT(au:fac,'F')
                  ACN(av:fac, val(an:val(w1)+8))
                  ACN(ax:fac, val(an:val(w1)+9))
                else
                  * No Financiero
                  ACT(au:fac,'NF')
                  ACN(av:fac, val(an:val(w1)+10))
                  ACN(ax:fac, val(an:val(w1)+11))
                endif
              endif
            endif
          endif
        endif
        if val(av:fac)<val(af1)
          ACN(af1,val(av:fac))
        endif
        if val(ax:fac)<val(ag1)
          ACN(ag1,val(ax:fac))
        endif  
        ** Nuevo para calcular los indices por dia
        if val(av:fac)<val(&j-val(z2)+105:1)
          ACN(&j-val(z2)+105:1,val(av:fac))
        endif
        if val(ax:fac)<val(&j-val(z2)+105:2)
          ACN(&j-val(z2)+105:2,val(ax:fac))
        endif  
      EndIf
      * Lim No garantizado
      ACN(aw:fac, val(al:val(w1))*val(av:fac)/100)
      * Lim garantizado
      ACN(ay:fac, val(al:val(w1))*val(ax:fac)/100)

      * Exceso Garantizado
      ACN(bl:fac, 0)
      if val(bj:fac)>val(ay:fac)
        ACN(bl:fac, val(bj:fac)-val(ay:fac))
      endif
*      SCN(as:&j-val(z2)+1, val(bj:fac))
      SCN(as:&j-val(z2)+3, val(bj:fac))

      * Exceso NO Garantizado
      ACN(bk:fac, 0)
      if Sum(bc:fac..be:fac)+val(bi:fac)>val(aw:fac)
        ACN(bk:fac, Sum(bc:fac..be:fac)+val(bi:fac)-val(aw:fac))
      endif    
*      SCN(ar:&j-val(z2)+1,Sum(bc:fac..be:fac)+val(bi:fac))
      SCN(ar:&j-val(z2)+3, Sum(bc:fac..be:fac)+val(bi:fac))

      *Muestro el Exceso Garantizado, sino el No Garantizado
      if val(bl:fac)>0
        ACN(&j-val(z2)+3:fac, val(bl:fac))
      else
        ACN(&j-val(z2)+3:fac, val(bk:fac))
      endif

    proximo   
*    if not Sum(c:fac..ag:fac)> 0 y Vacio(fbn['Controlante'])  
    if not Sum(c:fac..ag:fac) > 0
      BorrarCeldas(a:fac..ah:fac)
      dfa
    endif
    
    ACT(jj1,fbn['Controlante'])   
*    If Val(ZZ:1) = 0
*      BorrarCeldas(A:fac..AJ:fac)
*      DFA
*    EndIf
  else
    * Else EsTerminal()
    dfa
  endif
proximo

ifa
*  AgregarMarco(a:val(pp1)..ah:fac-1,1,3)         
AgregarMarco(a:val(pp1)..aj:fac-1,1,3)

if Vacio(val(jj1))
  ACT(a:FAC, 'Total Sin Grupo') 
else
  ACT(a:FAC, 'Total Grupo') 
  ACT(b:FAC, val(jj1))    
endif

recorrer&j val(z2),val(z4)
  ** Nuevo para calcular los indices por dia
  ACN(&j-val(z2)+105:fac, val(&j-val(z2)+105:1))
  ACN(&j-val(z2)+105:fac+20, val(&j-val(z2)+105:2))

*  ACN(av:fac, val(af1))
  ** Nuevo para calcular los indices por dia
  ACN(av:fac, val(&j-val(z2)+105:1))
  ACN(aw:fac, val(al:val(w1))*val(av:fac)/100)
*  ACN(ax:fac, val(ag1))
  ** Nuevo para calcular los indices por dia
  ACN(ax:fac, val(&j-val(z2)+105:2))
  ACN(ay:fac, val(al:val(w1))*val(ax:fac)/100)

*  ACN(ap:fac, sum(bc:val(pp1)..be:fac-1)+sum(bi:val(pp1)..bi:fac-1))
*  ACN(aq:fac, sum(bj:val(pp1)..bj:fac-1))
  * 
  ACN(ap:fac, val(ar:&j-val(z2)+3))
  ACN(aq:fac, val(as:&j-val(z2)+3))

  * Exceso NO Garantizado
  ACN(bk:fac,0)
  if val(ap:fac)>val(aw:fac)
    ACN(bk:fac, val(ap:fac)-val(aw:fac))
  endif
  * Exceso Garantizado
  ACN(bl:fac,0)
  if val(aq:fac)>val(ay:fac)
    ACN(bl:fac, val(aq:fac)-val(ay:fac))    
  endif

  *Muestro el Exceso Garantizado, sino el No Garantizado
  if not EqStr(val(jj1),'')
    if val(bl:fac)>0
      ACN(&j-val(z2)+3:fac,val(bl:fac))
    else
      ACN(&j-val(z2)+3:fac,val(bk:fac))
    endif
  endif
  if EqStr(Val(a:FAC),'Total Sin Grupo')
    ACN(&j-val(z2)+3:fac, Sum(&j-val(z2)+3:Val(pp1)+1..&j-val(z2)+3:fac-1))
  endif

proximo 

*recorrer&k 3,34
recorrer&k 3,33
  SCN(at:&k, val(&k:fac))
proximo

*  AgregarMarco(a:FAC..ah:FAC,2,1)
*  SetFont(a:fac..ah:fac,2)
AgregarMarco(a:FAC..aj:FAC,2,1)
SetFont(a:fac..aj:fac,2)
SetFont(av:fac..bl:fac,2)

if FAC>=Val(w3)
  SetFilaActual(FAC+1)
  ACN(w4,FAC)
  ACT(a:fac, 'Totales')

  recorrer&k 3,33
    ACN(&k:fac, val(at:&k))
  proximo

  SetFont(a:fac..aq:fac,2)
  SetFont(av:fac..bl:fac,2)
*  FormatoCeldas(c:fac..aq:fac,Exe('F0R'))
  AgregarMarco(a:fac..aj:fac,2,1)

  ACT(ah:val(w3), 'Total')
  recorrer&k val(w3)+1,fac-1
    ACN(ah:&k,Sum(c:&k..ag:&k))
  proximo  
*  SetFont(ah:val(w3)+1..ah:fac-1,2)
  SetFont(aj:val(w3)+1..aj:fac-1,2)
endif 
