ACN(ac:fac,1)
ACN(ag:fac,1)
ACN(ah:fac,1)
If NoVacio(val(in3)) y EqStr(val(in5),'NO')
   *- Si tiene indice y no esta incluido en el precio
   *- Cer del dia de la liquidacion-1
   ACN(aa:fac,Cotizacion(val(in3),,,,IIF(Vacio(val(l:fac)),Dialogo.Fecha1-1,FBN['FechaVto']-1),1,SI) )
   ACN(ab:fac,val(in1)/val(aa:fac))
   ACN(ac:fac,val(ab:fac))
   ACN(ag:fac,Cotizacion(val(in3),,,,val(q:fac)-1,1,SI))
   ACN(ah:fac,val(in1))
EndIf

ACN(o:fac,val(o:fac)*val(ah:fac))

*- Interes total CER del dia anterior al vto. de cupon
ACN(t:fac,val(t:fac)*val(ag:fac) )

*- Interes devengado toma el cer de la tabla de cotizaciones
ACN(u:fac,val(u:fac)*val(ah:fac))



