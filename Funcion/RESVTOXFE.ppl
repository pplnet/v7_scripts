** funcion de informe "Detalle de Operaciones Financieras"

** PARAMETROS:
**             co1: es la columna inicial para comenzar a imprimir
**             co4: 900..Val(co4) es el rango de datos de vtos por fecha
**             fi1: fila actual (fila en la que empiezo a imprimir)
**
**********************************************************************

** Ordeno los datos por fecha
If Val(co4)>900
   OrdenarFilas(900,Val(co4),27,'A')
endif

** fila inicial de datos a recuperar de las celdas guardadas
ACN(co5,899)
ACN(co6,Val(co4)-Val(co5))
ACN(co8,0)

   ACT(Val(co1):Val(fi1), 'RESUMEN DE VENCIMIENTOS POR FECHA')
   ACT(Val(co1):Val(fi1)+1, 'FECHA')
   ACT(Val(co1)+1:Val(fi1)+1, 'CAPITAL')
   ACT(Val(co1)+2:Val(fi1)+1, 'INTERES TOTAL')
   ACT(Val(co1)+3:Val(fi1)+1, 'IMPORTE VTO')
   AlinearCeldas(Val(co1):Val(fi1)+1..Val(co1)+3:Val(fi1)+1,'C')
   SetFont(Val(co1):Val(fi1)..Val(co1)+3:Val(fi1)+1,1)
   SCN(fi1,1)

   ** Recorro el rango de datos
   Recorrer&i 1,Val(co6)
      ** Corte de control por fecha de vto
      if Not EqStr(Val(aa:Val(co5)+&i),Val(at1))
         SCN(fi1,1)
         SCN(co8,1)
         ACT(Val(co1):Val(fi1), Val(aa:Val(co5)+&i) )
         ACD(at1,Val(aa:Val(co5)+&i) )
      endif
      SCN(Val(co1)+1:Val(fi1), Val(ab:Val(co5)+&i) )
      SCN(Val(co1)+2:Val(fi1), Val(ac:Val(co5)+&i) )
      SCN(Val(co1)+3:Val(fi1), Val(ab:Val(co5)+&i)+Val(ac:Val(co5)+&i) )
      SCN(as1, Val(ab:Val(co5)+&i) )
      SCN(as2, Val(ac:Val(co5)+&i) )
      SCN(as3, Val(ab:Val(co5)+&i)+Val(ac:Val(co5)+&i) )
   Proximo
   ACT(Val(co1):Val(fi1)+1,'TOTAL '~Dialogo.Especie1 )
   ACN(Val(co1)+1:Val(fi1)+1,Val(as1) )
   ACN(Val(co1)+2:Val(fi1)+1,Val(as2) )
   ACN(Val(co1)+3:Val(fi1)+1,Val(as3) )
   ACN(fi2,1)
   if Not EqStr(Dialogo.Especie1,Dialogo.Especie2)
      ACT(Val(co1):Val(fi1)+2,'TOTAL '~Dialogo.Especie2 )
      if EqStr(Modo(Dialogo.Especie1,Dialogo.Especie2),'DIR')
         ACN(Val(co1)+1:Val(fi1)+2,Val(as1)*Dialogo.Precio1 )
         ACN(Val(co1)+2:Val(fi1)+2,Val(as2)*Dialogo.Precio1 )
         ACN(Val(co1)+3:Val(fi1)+2,Val(as3)*Dialogo.Precio1 )
      else
         ACN(Val(co1)+1:Val(fi1)+2,Val(as1)/Dialogo.Precio1 )
         ACN(Val(co1)+2:Val(fi1)+2,Val(as2)/Dialogo.Precio1 )
         ACN(Val(co1)+3:Val(fi1)+2,Val(as3)/Dialogo.Precio1 )
      endif
      SetFont(Val(co1):Val(fi1)+2..Val(co1)+3:Val(fi1)+2,1)
      ACN(fi2,2)
   endif
   SetFont(Val(co1):Val(fi1)+1..Val(co1)+3:Val(fi1)+1,1)

   ** marco de filas de resumen y nombres de columnas
   AgregarMarco(Val(co1):Val(fi1)-Val(co8)-1..Val(co1)+3:Val(fi1)-Val(co8),1,1)
   ** marco de columnas
   AgregarMarco(Val(co1):Val(fi1)-Val(co8)..Val(co1)+3:Val(fi1)+Val(fi2),1,2)
   ** marcos de totales
   AgregarMarco(Val(co1):Val(fi1)+1..Val(co1)+3:Val(fi1)+Val(fi2),1,3)

   ** Realizo el formato de todas las celdas
   FormatoCeldas(m:Val(fi1)-Val(co8)..o:Val(fi1)+Val(fi2),Exe('F2'))
   FormatoCeldas(m:Val(fi1)-Val(co8)..o:Val(fi1)+Val(fi2),Exe('F2'))
   SetFont(Val(co1):Val(fi1)-Val(co8)+1..Val(co1)+3:Val(fi1),2)