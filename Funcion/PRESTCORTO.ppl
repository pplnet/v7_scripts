endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Cliente1, O.Especie, O.FechaVto ,  O.TipoOp, O.NrOperacion,")
SQL.ADD(" O.FechaOp, O.Plazo, CASE O.TipoOp WHEN 'MMSCMV' THEN C.Precio2 ELSE O.Precio1 END Tasa, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMSCMV' THEN  C.Cantidad3 ELSE O.TotalIntereses END Interes, ")
