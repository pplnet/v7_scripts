*- Parametros de entrada:                                                          *
*                          zx1: Indica si tomo corto (0) o largo (1) plazo         *
*                          zx2: zx2=1 toma solo moneda Pesos                       *
*                               zx2=0 toma  moneda distinta de Pesos               *
*                               zx2=-1 toma cualquier moneda                                                   *
************************************************************************************

SQL.ADD(" Select O.Cliente1, O.Especie, O.FechaVto , O.TipoOp, O.NrOperacion, ")
SQL.ADD(" O.FechaOp, O.Plazo, C.Precio2 Tasa, C.Cantidad3 Interes, O.TipoTasa, C.Precio4 Spread, ")
SQL.ADD(" C.Cantidad2 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   <=  '"~IdxDate(Dialogo.Fecha1)~"' ")
if Val(zx1)=0
    SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
else
    SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
endif
if Val(zx2)=1
    SQL.ADD(" and  O.Especie = 'ARP' ")
else
    if Val(zx2)=0
       SQL.ADD(" and  O.Especie <> 'ARP' ")
    endif
endif
SQL.ADD(" and  O.TipoOp In ('MMPCLM') ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Cliente1, O.Especie, O.FechaVto ,  O.TipoOp, O.NrOperacion,")
SQL.ADD("O.FechaOp, O.Plazo,  O.Precio1 Tasa, O.TotalIntereses Interes, ")
SQL.ADD("CASE O.TipoOp WHEN 'MMPCL' THEN O.TipoTasa ELSE ' ' END TipoTasa,CASE O.TipoOp WHEN 'MMPCL' THEN O.Spread ELSE 0 END Spread, ")
SQL.ADD("Cantidad Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if Val(zx1)=0
    SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
else
    SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
endif
if Val(zx2)=1
    SQL.ADD(" and  O.Especie = 'ARP' ")
else
   if Val(zx2)=0    
      SQL.ADD(" and  O.Especie <> 'ARP' ")
   endif
endif
SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Cliente1, O.Especie, O.FechaVto , O.TipoOp, O.NrOperacion,")
SQL.ADD("O.FechaOp, O.Plazo, C.Precio2 Tasa, C.Cantidad3 Interes, O.TipoTasa, C.Precio4 Spread, ")
SQL.ADD("C.Cantidad2 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
