*- Los depositos a plazo son las operaciones MMCPM, MMCP
*- que se realizaron en pesos y dolares con una entidad local.

*- Filas para depositos a plazo
ACN(fa1, Val(fi2))
ACN(fa2, Val(fi4))

*- Inicializo 
ACT(es1, '')
ACN(fo1, 0)
ACN(fo2, 0)
ACN(fo3, 0)
ACN(fo4, 0)
ACN(fo5, 0)
ACN(fo6, 0)
ACN(fo7, 0)

SQL.ADD("SELECT O.Especie, SUM(C.Cantidad1) Cantidad ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES CL ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("        and  O.Cliente1 = CL.Codigo ")
SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMCPM') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
IF Dialogo.Radio2 = 0
   SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
   SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie")
SQL.ADD("UNION ALL")
SQL.ADD("SELECT O.Especie, SUM(O.Cantidad) Cantidad  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES CL ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        and  O.Cliente1 = CL.Codigo ")
SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
SQL.ADD("       and  O.TipoOp In ('MMCP') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
IF Dialogo.Radio2 = 0
   SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
   SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie")
*-- Para que me traiga todos intereses en el corto plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, 0 Cantidad ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES CL ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("        and  O.Cliente1 = CL.Codigo ")
   SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMCPM') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   SQL.ADD("GROUP BY O.Especie")
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, 0 Cantidad  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES CL ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("        and  O.Cliente1 = CL.Codigo ")
   SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
   SQL.ADD("       and  O.TipoOp In ('MMCP') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   SQL.ADD("GROUP BY O.Especie")
Endif
SQL.ADD("ORDER BY 1 ")

Recorrer SQL
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
      (.'TOTALRESUA'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      ACT(es1,FBN['Especie'])

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      *- Los intereses devengados los muestra solamente en el Corto
      If Dialogo.Radio2<>1      
         LinkearHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['Especie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=1, Lista2 = 'MMCPM|MMCP')
            
         *- fo2: Interes  fo3:Tasa Promedio fo4:Plazo Promedio          
         ACN(fo2,LinkH(1,fo2))
           
         ACN(fo3,0)
         ACN(fo4,0)

         *- Solo debe mostrar la tasa y el plazo promedio en el Corto+Largo
         If Dialogo.Radio2 = 2   
            ACN(fo3,LinkH(1,fo1)*LinkH(1,fo3))
            ACN(fo4,LinkH(1,fo1)*LinkH(1,fo4))
         Endif
        
         CerrarHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['Especie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=1, Lista2 = 'MMCPM|MMCP')
      Endif

   EndIf

   SCN(fo1,FBN['Cantidad']*Val(pr1))
Proximo

If NoVacio(val(es1))
   (.'TOTALRESUA'.)
   ACN(fo1,0)

   (.'TOTALRES2A'.)
EndIf


SetFont(b:Val(fa1)..q:Val(fa1), 1)
