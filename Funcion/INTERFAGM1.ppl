*---------------Llamada por informe GM0001. Genera INTERFACE-----------------------*
BorrarCeldas(yz:1..yz:1)
BorrarCeldas(yy:1..yy:44)


  *AbrirASCII(Val(aa3),0)
  if Val(zz1)=1  
    **----------------------Registro CABECERA       
    *Tipo Interface  (Mensual/Diaria)
    if Dialogo.Fecha2=FinDeMes(Dialogo.Fecha2,NO,'ARG'))
      act(yy1, 'M       ')  
    else
      act(yy1, 'D       ')
    endif
    *Fecha Proceso
    act(yy2, Fecha(Dialogo.Fecha5 ,'YYYYMMDD'))
    Recorrer&i 1, 2
      act(yz:1, Val(yz:1)~Val(yy:&i))
    Proximo
    EscribirCampo(val(yz:1),484,0)
    EscribirSR
    BorrarCeldas(yz:1..yz:1)
    BorrarCeldas(yy:1..yy:41)
  endif  
    **----------------------Registro de DATOS
    *Fecha Proceso
    act(yy1, Fecha(Dialogo.Fecha5 ,'YYYYMMDD'))
    *Fecha Concertaci#n
    act(yy2, Fecha( fbn['FECHAOP'] ,'YYYYMMDD'))
    *Fecha Vto
    act(yy3, Fecha(fbn['FechaVto']  ,'YYYYMMDD'))
    *Nro. Operaci#n char(8)
    act(yy4, Pad(fbn['NROPERACION'],8))
    *Tipo de Operaci#n  char(6)
    act(yy5, Pad(fbn['TipoOp'],6))
    *Producto			char(6)
    if Incluido(fbn['TipoOp'],'FXCTC|FXVTC')
      act(yy6, Pad('FWDROF',6))
    else 
      act(yy6, Pad(fbn['PRODUCTO'],6))
    endif
    *Cliente				char(10)
    act(yy7, Pad(Copy(fbn['CLIENTE'],1,10),10))
    *Moneda Base			char(6)
    if Incluido(fbn['TipoOp'],'FXCTC|FXVTC|FXROC|FXROV')
      act(yy8, Pad('USD',6))
    else
*      act(yy8, Pad(fbn['Especie'],6))
      act(yy8, Pad(IIf(Eqstr(fbn['Especie'], 'EUB'), 'EURO', fbn['Especie']),6))
    endif
    *Moneda Liq			char(6)
    act(yy9, Pad(fbn['ContraEspecie'],6))
    *Cantidad Operada M.Base	N(15,2)
    act(yy10, Pad0(FStr(fbn['CANTIDAD']*100,0,0),17))
    *Cantidad Operada USD		N(15,2)  f 'CantOpeUSD'
    act(yy11, Pad0(FStr(fbn['CantOpeUSD']*100,0,0),17))
    *Plazo		N(5)  g Fstr(fbn('PLAZO'),0,0)
    act(yy12, Pad0(Fstr(fbn('PLAZO'),0,0),5))
    *Valor				char(10)
    act(yy13, Pad(fbn['VALOR'],10))
    *Pr. Transferencia ME/USD	N(6,10)  i: 'TipoCambio2'
    act(yy14, Pad0(Fstr(fbn['TipoCambio2']*10000000000,0,0),16))
    *Cotizaci#n USD/$		N(6,10) j: 'COTUSD'
    if [EqStr(Val(yy8),'USD   ') o EqStr(Val(yy8),'USB   ')] y EqStr(Val(yy9),'ARP   ')
      act(yy15, Pad0(Fstr(fbn['Precio2']*10000000000,0,0),16))
    else 
      act(yy15, Pad0(Fstr(fbn['COTUSD']*10000000000,0,0),16))
    endif
    *Precio Cliente $		N(6,10)k: 'Precio2'
    act(yy16, Pad0(Fstr(fbn['Precio2']*10000000000,0,0),16))
    *Pr. Transferencia ME/$	N(6,10)l: 'TipoCambio3'
    act(yy17, Pad0(Fstr(fbn['TipoCambio3']*10000000000,0,0),16))
    *Monto ARP			N(15,2)m: 'MONTOARP'
    act(yy18, Pad0(Fstr(fbn['MONTOARP']*100,0,0),17))
    *Monto USD			N(15,2)n: 'MONTOUSD'
    act(yy19, Pad0(Fstr(fbn['MONTOUSD']*100,0,0),17))    
    *Spread				N(6,10)   Val(o:&K)
    if Val(o:fac)>=0
      act(yy20, Pad0(Fstr(Val(o:fac)*10000000000,0,0),16))
    else
      act(yy20, '-'~Pad0(Fstr(Abs(Val(o:fac)*10000000000),0,0),15))
    endif
    *Resultado en ARP		N(15,2) Val(p:&K)
    if Val(p:fac)>=0  
      act(yy21, Pad0(Fstr(Val(p:fac)*100,0,0),17))
    else
      act(yy21, '-'~Pad0(Fstr(Abs(Val(p:fac)*100),0,0),16))
    endif
    *Resultado en USD		N(15,2)   q:&K   'ResultadoUSD'
    if fbn['ResultadoUSD']>=0  
      act(yy22, Pad0(Fstr(fbn['ResultadoUSD']*100,0,0),17))
    else
      act(yy22, '-'~Pad0(Fstr(Abs(fbn['ResultadoUSD']*100),0,0),16))
    endif   
    *Operador			char(10)
    act(yy23, Pad(Copy(fbn['Operador'],1,10),10))
    *Equipo				char(6) 'EQUIPO'
    act(yy24, Pad(Copy(fbn['EQUIPO'],1,6),6))
    *Organizaci#n			char(3) 'ORGANIZACION'
    act(yy25, Pad(Copy(fbn['ORGANIZACION'],1,3),3))
    *Segmento			char(3) 'SEGMENTO'
    act(yy26, Pad(Copy(fbn['SEGMENTO'],1,3),3))
    *Oficial				char(3)  v:&K
    act(yy27, Pad(Copy(Val(v:fac),1,3),3))
    *Nombre Oficial			char(20)  w:&K
    act(yy28, Pad(Copy(Val(w:fac),1,20),20))
    *Origen Operaci#n		char(10) 'TIPO'
    act(yy29, Pad(Copy(fbn['TIPO'],1,10),10))
    *Broker				char(10) 'BROKER'
    act(yy30, Pad(Copy(fbn['BROKER'],1,10),10))
    *Cot. A3500 Concertaci#n	N(6,10) z:&K
    act(yy31, Pad0(Fstr(Val(z:FAC)*10000000000,0,0),16))
    *Cot. A3500 Fin de Mes		N(6,10)  aa:&K
    act(yy32, Pad0(Fstr(Val(aa:FAC)*10000000000,0,0),16))
    *Tipo Cliente			char(4) 'TIPOCLI'
    act(yy33, Pad(Copy(fbn['TIPOCLI'],1,4),4))
    *Nro. de Operaci#n OPEX	char(23) 'NrOPEX'
    act(yy34, Pad(Copy(fbn['NrOPEX'],1,23),23))
    
    *MTD USD			N(15,2) val(aj:&K)
    if Val(aj:fac)>=0
      act(yy35, Pad0(Fstr(Val(aj:FAC)*100,0,0),17))
    else
      act(yy35, '-'~Pad0(Fstr(Abs(Val(aj:FAC)*100),0,0),16))
    endif
    *Day USD			N(15,2)  val(ak:&K)
    if Val(ak:fac)>=0
      act(yy36, Pad0(Fstr(Val(ak:FAC)*100,0,0),17))
    else
      act(yy36, '-'~Pad0(Fstr(Abs(Val(ak:FAC)*100),0,0),16))
    endif
     
    *Estado				char(1)  'ESTADO'
    act(yy37, Pad(fbn['ESTADO'],1))
    
    **********
    *Fecha Liq. Mon. Pago
    act(yy38, Fecha(fbn['FechaPago']  ,'YYYYMMDD'))
    
    *--Nro.Altamira
    act(yy39,  Pad(Copy(fbn['NrAltamira'],1,8),8))
    act(c3, fbn['TipoDocum'])
    ACT(z1,'00')
    if EqStr(fbn['TIPO'],'Genuina') 
      (.'CONFPHOST'.)  
    else
      act(z1, Val(c3))
    endif
    act(yy40, Pad(Val(z1),2))
    act(yy41, Pad(Copy(fbn['NrDocum'],1,15),15))
    **Sept 2009    
    *Mto Broker (15,2) 
    act(yy42, Pad0(FStr(fbn['TotalGastos']*100,0,0),17))
    *Responsable Char(6) 
    act(yy43, Pad(fbn['Responsable1'],6))

    *Prod OPEX Char(6) 
    if EqStr(Copy(fbn['ProdOPEX'],1,1),' ')
      if EqStr(fbn['TIPO'],'Genuina') 
        act(yy44, Pad('PROPIA',6))
      else
        act(yy44, Pad('OTROS',6))
      endif
    else
      if EqStr(fbn['TIPO'],'Genuina') 
        If Eqstr(BuscarCampo('OPERACIONES','Custodia','NrOperacion',FBN['NROPERACION']),'1')
          **Busco el SubProductoTS para las operaciones de TS

          BorrarCeldas(xx44..xx44)
          SQL.ADD(" Select Distinct O.SubProductoTS from "~DBO~".OPEXPRODUCTOS O, "~DBO~".ESPECIES E, "~DBO~".ESPECIES EE, "~DBO~".OPERACIONES OP ")
          SQL.ADD(" where  O.TipoOp     = OP.TipoOp ")
          SQL.ADD(" and    O.CodigoOPEX = OP.Plaza1 ")
          SQL.ADD(" and  ((OP.CB10 = '1' and O.Reversa = 'S')  ")
          SQL.ADD("    or ((OP.CB10 = '0' or OP.CB10 = '' or OP.CB10=NULL ) and Reversa = 'N'))  ")
          SQL.ADD(" and E.Codigo = OP.Especie ")
          SQL.ADD(" and EE.Codigo = OP.ContraEspecie ")
          SQL.ADD(" and (patindex('%'+OP.Sector2+'%',O.Sectores)<> 0 or O.Sectores is Null or O.Sectores = ' ' )  ")
          SQL.ADD(" and (O.TipoMonBase = E.Alias3  or O.TipoMonBase is null or O.TipoMonBase = ' ' )     ")                   
          SQL.ADD(" and (O.TipoMonLiq  = EE.Alias3 or O.TipoMonLiq  is null or O.TipoMonLiq  = ' ' )     ")                                       
          SQL.ADD(" and (O.MonedaBase  =  OP.Especie or O.MonedaBase is null or O.MonedaBase = ' ' )     ")                             
          SQL.ADD(" and (O.MonedaLiq   =  OP.ContraEspecie or O.MonedaLiq is null or O.MonedaLiq = ' ' ) ")                         
          SQL.ADD(" and (patindex('%'+OP.Cliente1+'%',O.Clientes)<> 0 or O.Clientes is Null or O.Clientes = ' ' ) ")                     
          SQL.ADD(" and OP.Plazo3 between O.PlazoDesde and O.PlazoHasta  ")                      
          SQL.ADD(" and OP.NrOperacion = '"~FBN['NROPERACION']~"'        ")
          Recorrer SQL   
            DFA
            act(xx44, fbn['SubProductoTS'])
            Break
          Proximo

          If NoVacio(Val(xx44))
            ***SubProductoTS
            act(yy44, Pad(Val(xx44),6))
          Else
            act(yy44, Pad(fbn['ProdOPEX'],6))
          Endif
        Else
         act(yy44, Pad(fbn['ProdOPEX'],6))
        Endif
      else
        act(yy44, Pad(Copy(fbn['ProdOPEX'],1,4),6))
      endif
    endif    
    Recorrer&i 1, 44
      act(yz:1, Val(yz:1)~Val(yy:&i))
    Proximo
    EscribirCampo(val(yz:1),484,0)
    EscribirSR
  *CerrarASCII
