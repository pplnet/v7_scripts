      ACN(j:FAC, SUM(g:FAC..i:FAC))
      ACN(aj:FAC, SUM(ag:FAC..ai:FAC))

      if Val(q:FAC)>Val(aq:FAC)
        ACN(bb:FAC, Val(q:FAC))
      else
        ACN(bb:FAC, Val(aq:FAC))
      endif
      ACN(bj:FAC, Val(j:FAC)+Val(k:FAC)+Val(as:FAC))
      ACN(bi:FAC, Val(aj:FAC)+Val(ak:FAC)+Val(at:FAC))

      ACN(r:FAC, Val(q:FAC)-Val(bj:FAC))
      ACN(bc:FAC, Val(bb:FAC)-Val(bj:FAC)-Val(bi:FAC))
      if Val(bc:FAC)>=0
        if Val(r:FAC)>=0
          if Val(r:FAC)>Val(bc:FAC)
            ACN(r:FAC, Val(bc:FAC))
          endif
        endif
      else
        if Val(r:FAC)>=0
          ACN(r:FAC, 0)
        endif
      endif

**************************
IF NO
*      ACN(j:FAC, SUM(g:FAC..i:FAC))
*      ACN(aj:FAC, SUM(ag:FAC..ai:FAC))
      ACN(k:FAC, Val(b:FAC)-Val(j:FAC))
      if Val(b:FAC)>Val(ab:FAC)
        ACN(bb:FAC, Val(b:FAC))
      else
        ACN(bb:FAC, Val(ab:FAC))
      endif
      ACN(bc:FAC, Val(bb:FAC)-Val(j:FAC)-Val(aj:FAC))
      if Val(bc:FAC)>=0
        if Val(k:FAC)>=0
          if Val(k:FAC)>Val(bc:FAC)
            ACN(k:FAC, Val(bc:FAC))
          endif
        endif
      else
        if Val(k:FAC)>=0
          ACN(k:FAC, 0)
        endif
      endif
ENDIF
**************************

      ACN(l:FAC, Val(b:FAC)-Val(j:FAC))
      if Val(b:FAC)>Val(ab:FAC)
        ACN(be:FAC, Val(b:FAC))
      else
        ACN(be:FAC, Val(ab:FAC))
      endif
      ACN(bf:FAC, Val(be:FAC)-Val(j:FAC)-Val(aj:FAC))
      if Val(bf:FAC)>=0
        if Val(l:FAC)>=0
          if Val(l:FAC)>Val(bf:FAC)
            ACN(l:FAC, Val(bf:FAC))
          endif
        endif
      else
        if Val(l:FAC)>=0
          ACN(l:FAC, 0)
        endif
      endif
      if Val(l:FAC)>=0
        if Val(l:FAC)>Val(r:FAC)
          if Val(r:FAC)>=0
            ACN(l:FAC, Val(r:FAC))
          else
            ACN(l:FAC, 0)
          endif
        endif
      endif      

      ACN(m:FAC, Val(c:FAC))
      ACN(n:FAC, Val(d:FAC)-Val(g:FAC))
      ACN(o:FAC, Val(e:FAC)-Val(h:FAC))
      ACN(p:FAC, Val(f:FAC)-Val(i:FAC))
      if Val(n:FAC)<0 y Val(m:FAC)>0 y Vacio(Val(d:FAC))
        if -Val(n:FAC)<Val(m:FAC)
          SCN(m:FAC, Val(n:FAC))
          ACN(n:FAC, 0)
        else
          SCN(n:FAC, Val(m:FAC))
          ACN(m:FAC, 0)
        endif
      endif
      if Val(o:FAC)<0 y Val(m:FAC)>0 y Vacio(Val(e:FAC))
        if -Val(o:FAC)<Val(m:FAC)
          SCN(m:FAC, Val(o:FAC))
          ACN(o:FAC, 0)
        else
          SCN(o:FAC, Val(m:FAC))
          ACN(m:FAC, 0)
        endif
      endif
      if Val(p:FAC)<0 y Val(m:FAC)>0 y Vacio(Val(f:FAC))
        if -Val(p:FAC)<Val(m:FAC)
          SCN(m:FAC, Val(p:FAC))
          ACN(p:FAC, 0)
        else
          SCN(p:FAC, Val(m:FAC))
          ACN(m:FAC, 0)
        endif
      endif
      if Val(m:FAC)>0 y Val(m:FAC)>Val(l:FAC)
        if Val(l:FAC)>=0
          ACN(m:FAC, Val(l:FAC))
        else
          ACN(m:FAC, 0)
        endif
      endif
      if Val(n:FAC)>0 y Val(n:FAC)>Val(l:FAC)
        if Val(l:FAC)>=0
          ACN(n:FAC, Val(l:FAC))
        else
          ACN(n:FAC, 0)
        endif
      endif
      if Val(o:FAC)>0 y Val(o:FAC)>Val(l:FAC)
        if Val(l:FAC)>=0
          ACN(o:FAC, Val(l:FAC))
        else
          ACN(o:FAC, 0)
        endif
      endif
      if Val(p:FAC)>=0 y Val(p:FAC)>Val(l:FAC)
        if Val(l:FAC)>=0
          ACN(p:FAC, Val(l:FAC))
        else
          ACN(p:FAC, 0)
        endif
      endif
      FormatoCeldas(b:FAC..r:FAC,EXE('F0R'))
      FormatoCeldas(ab:FAC..at:FAC,EXE('F0R'))
      FormatoCeldas(bb:FAC..br:FAC,EXE('F0R'))
      SetFont(a:FAC..x:FAC,1)
      SetFont(ab:FAC..at:FAC,1)
      SetFont(bb:FAC..br:FAC,1)
