        acn(aa2,val(aa4))
     endif
  endif
  If val(aa5) > 0
     if val(aa5) < val(aa2)
        acn(aa2,val(aa5))
     endif
  endif

  if val(aa2) = 10000
     acn(aa2,val(aY3)+1)
  endif
* Hay una formula a partir de aY4
  if val(aY4)<>0
  ACT(ax7,'SI')

  Recorrer&k val(x6),val(x5)
        If EqStr(val(a:&k),copy(val(aY1),val(aY4)+1,val(aa2)-(val(aY4)+1)))
        ACT(ax7,'NO')
        endif
     Proximo

     if EqStr(val(ax7),'SI')

        act(a:val(x5),copy(val(aY1),val(aY4)+1,val(aa2)-(val(aY4)+1)))
        act(c:val(x5),SQL("Select Script From "~DBO~".FORMULAS Where Codigo = '"~Val(a:val(x5))~"' "))
        scn(x5,1)
     endif
     acn(aY2,val(aa2))
  endif
  if [val(aY2) >=  val(aY3)] o [val(aY4)=0]
     break
  endif

