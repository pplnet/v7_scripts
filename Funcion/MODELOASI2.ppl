  acn(aY2,1)
  acn(aY3,longitud(val(aY1))+1)

  recorrer&j 1,val(aY3)

  acn(aY4,Posicion('#',val(aY1),val(aY2),val(aY3)))
  acn(ay5,Posicion(' ',val(aY1),val(aY4)+1,val(aY3)))
  acn(z1,Posicion(')',val(aY1),val(aY4)+1,val(aY3)))
  acn(z2,Posicion('+',val(aY1),val(aY4)+1,val(aY3)))
  acn(z3,Posicion('-',val(aY1),val(aY4)+1,val(aY3)))
