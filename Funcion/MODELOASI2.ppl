  acn(z5,Posicion('/',val(aY1),val(aY4)+1,val(aY3)))
  acn(aa1,Posicion(',',val(aY1),val(aY4)+1,val(aY3)))
  acn(aa3,Posicion('<',val(aY1),val(aY4)+1,val(aY3)))
  acn(aa4,Posicion('>',val(aY1),val(aY4)+1,val(aY3)))
  acn(aa5,Posicion('~',val(aY1),val(aY4)+1,val(aY3)))

  acn(aa2,10000)

  If val(aY5) > 0
     if val(aY5) < val(aa2)
        acn(aa2,val(aY5))
     endif
  endif
  If val(z1) > 0
     if val(z1) < val(aa2)
      acn(aa2,val(z1))
     endif
  endif
  If val(z2) > 0
     if val(z2) < val(aa2)
        acn(aa2,val(z2))
     endif
  endif
  If val(z3) > 0
     if val(z3) < val(aa2)
        acn(aa2,val(z3))
     endif
  endif
  If val(z4) > 0
     if val(z4) < val(aa2)
        acn(aa2,val(z4))
     endif
  endif
  If val(z5) > 0
     if val(z5) < val(aa2)
        acn(aa2,val(z5))
     endif
  endif
  If val(aa1) > 0
     if val(aa1) < val(aa2)
        acn(aa2,val(aa1))
     endif
  endif
  If val(aa3) > 0
     if val(aa3) < val(aa2)
        acn(aa2,val(aa3))
     endif
  endif
  If val(aa4) > 0
