Indice         : 'Indice'                     ;8;2;2;NO;;Vacio(INDICE) o Incluido(ESPECIE,BuscarCampo('INDICES','Especie','Codigo',INDICE)) o Incluido(CONTRAESPECIE4,BuscarCampo('INDICES','Especie','Codigo',INDICE));'El Indice no esta Habilitado para la Especie '~ESPECIE;;;;;;;;;;;;;;
ContraEspecie4 : 'Esp_Ori'                    ;;2;2;NO;NoVacio(INDICE) y NoVacio(CONTRAESPECIE4) Y Not EqStr(ESPECIE,CONTRAESPECIE4);;;;ESPECIE;IF(VACIO(CONTRAESPECIE4),ESPECIE,CONTRAESPECIE4);;;;;;;;;;;
CantidadOri    : 'VN Original'                ;;2;2; ;NoVacio(INDICE) y CANTIDADORI<>0;;;;IF(COEFICIENTE=1,CANTIDAD,CANTIDADORI);IF(COEFICIENTE=1,CANTIDAD,CANTIDADORI);;;;;'###,###,###,###.##'
Coeficiente    : 'Coeficiente'                ;;2;2;NO;NoVacio(INDICE) y COEFICIENTE<>0;;;;IF(Vacio(INDICE),1,IF(FECHAVTO>Fsys,IF(FECHAOP=FSYS,1,COTIZACION(INDICE,,,,FSYS,1,SI)/COTIZACION(INDICE,,,,FECHAOP-1,1,SI)),COEFICIENTE));IF(Vacio(INDICE),1,IF(FECHAVTO>Fsys,IF(FECHAOP=FSYS,1,COTIZACION(INDICE,,,,FSYS,1,SI)/COTIZACION(INDICE,,,,FECHAOP-1,1,SI)),COEFICIENTE));;;;;'###.########'
ResultadoIndice: 'Resul Indice'               ;;2;2;NO;NoVacio(INDICE) y RESULTADOINDICE<>0;;;;PRECIOEJ-(CANTIDADORI*(1+VCAN10/100));PRECIOEJ-(CANTIDADORI*(1+VCAN10/100));;;;;'###,###,###,###.##'