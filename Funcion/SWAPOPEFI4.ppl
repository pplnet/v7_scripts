******************************************************************************************
***---Swaps Multiple Vtos.
***---Datos Vehiculo
SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha3 Fecha, O.OperacionRef NrOperacion, O.TipoOp, ")
SQL.ADD(" C.Cantidad6 Cant, C.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, '' ContraEspecie, ")
SQL.ADD(" C.Plazo1 Plazo, C.Precio1 Tasa, C.Total3 Spread ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Cantidad6 > 0 ")
SQL.ADD(" AND O.OperacionRef = '"~Val(ea2)~"' ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND C.Fecha3 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND C.Fecha3 > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" UNION ")

***---Datos Contraparte
SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha7 Fecha, O.OperacionRef NrOperacion, ")
SQL.ADD(" O.TipoOp, -C.Cantidad5 Cant, C.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, O.ContraEspecie, ")
SQL.ADD(" C.Plazo2 Plazo, C.Precio2 Tasa, C.Total4 Spread ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha7 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Cantidad5 > 0 ")
SQL.ADD(" AND O.OperacionRef = '"~Val(ea2)~"' ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND C.Fecha7 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND C.Fecha7 > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" UNION ")

******************************************************************************************
***---Swaps Unico Vtos
***---Datos Vehiculo
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaPago Fecha, O.OperacionRef NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cantidad Cant, O.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, '' ContraEspecie, ")
SQL.ADD(" O.Plazo, O.Precio3 Tasa, O.Spread ")
SQL.ADD(" From "~DBO~".OPERACIONES O")
SQL.ADD(" Where O.OperacionRef = '"~Val(ea2)~"' ")
SQL.ADD(" AND O.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Cantidad > 0 ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaPago <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" UNION ")
***---Datos Contraparte
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaPago Fecha, O.OperacionRef NrOperacion, ")
SQL.ADD(" O.TipoOp, -O.TotalBrutoCli1 Cant, O.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, O.ContraEspecie, ")
SQL.ADD(" O.Plazo, O.TotalGanancias Tasa, O.TotalNetoCli2 Spread ")
SQL.ADD(" From "~DBO~".OPERACIONES O  ")
SQL.ADD(" Where O.OperacionRef = '"~Val(ea2)~"' ")
SQL.ADD(" AND O.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TotalBrutoCli1 > 0 ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaPago <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
*- Para que traiga los intereses de los swaps de largo plazo en el corto
If NO Y Dialogo.Radio2=0
   SQL.ADD("UNION ")
   ***---Swaps Multiple Vtos.
   ***---Datos Vehiculo
   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha3 Fecha, O.OperacionRef NrOperacion, O.TipoOp, ")
   SQL.ADD(" 0 Cant, C.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, '' ContraEspecie, ")
   SQL.ADD(" 0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
   SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
   SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND C.Fecha3 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND C.Cantidad6 > 0 ")
   SQL.ADD(" AND O.OperacionRef = P.NrOperacion ")
   SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(TO:1))~") ")
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"' ")

   SQL.ADD(" UNION ")

   ***---Datos Contraparte
   SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Fecha7 Fecha, O.OperacionRef NrOperacion, ")
   SQL.ADD(" O.TipoOp, 0 Cant, C.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, O.ContraEspecie, ")
   SQL.ADD(" 0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
   SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
   SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND C.Fecha7 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND C.Cantidad5 > 0 ")
   SQL.ADD(" AND O.OperacionRef = P.NrOperacion ")
   SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(TO:1))~") ")
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"' ")

   SQL.ADD(" UNION ")

   ***---Swaps Unico Vtos
   ***---Datos Vehiculo
   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaPago Fecha, O.OperacionRef NrOperacion, O.TipoOp, ")
   SQL.ADD(" 0 Cant, O.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, '' ContraEspecie, ")
   SQL.ADD(" 0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
   SQL.ADD(" Where O.OperacionRef = P.NrOperacion ")
   SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
   SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND O.Cantidad > 0 ")
   SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(TO:1))~") ")
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"' ")

   SQL.ADD(" UNION ")

   ***---Datos Contraparte
   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaPago Fecha, O.OperacionRef NrOperacion, ")
   SQL.ADD(" O.TipoOp, 0 Cant, O.NrOperacion OperacionRef, 'SWAP' Tipo, '' MarcaSwap, O.ContraEspecie, ")
   SQL.ADD(" 0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
   SQL.ADD(" Where O.OperacionRef = P.NrOperacion ")
   SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
   SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND O.TotalBrutoCli1 > 0 ")
   SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(TO:1))~") ")
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"' ")
Endif
