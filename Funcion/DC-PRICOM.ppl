**// DC:3 = DC de Prima
**// DC:4 = DC de Comisiones
**// FC:1 = Fecha Fin de mes anterior O Inicio
**// FC:2 = Fecha Fin de mes
**// FC:9 = Inicio Cuota Vigente

*UPDATE 11/09/2023
*Se reemplazan celdas por variables para mayor claridad:
********************
***---MO:88 = &monedaOp
***---AL:88 = &monedaLocal
***---MO:55 = &capital
***---DK:55 = &dcCapitalMonFuerte
***---DK:66 = &dcCapitalMonLocal
***---DK:77 = &dcCapitalMonGrupo

***/// Inicializar
ACN(CP:2, 0)
ACN(DN:1, 0)
ACN(DN:2, 0)
ACN(DN:3, 0)
ACN(DI:1, 0)
ACN(DI:2, 0)
ACN(DI:3, 0)
ACN(DK:1, 0)
ACN(DK:2, 0)
ACN(DK:3, 0)
ACN(DP:1, 0)
ACN(DP:2, 0)
ACN(DP:3, 0)


**// Seteo en AP:1 si la Op. es Activa o Pasiva
If Incluido(FBN('TipoOp'),Var('OPEACT'))
   ACN(AP:1, 1)
Else
   ACN(AP:1, 2)
Endif


*************************************************
** --- Calculo DC y Prima   de forma DIARIA ---**
*************************************************

let &monedaOp fbn('Moneda')
let &monedaLocal fbn('MonLocalVeh')
ACT(TO:88, fbn('TipoOp'))
ACN(BD:55, 0)
ACN(MO:66, 0)
ACN(DP:1, 0)
ACN(DP:2, 0)
ACN(DP:3, 0)
ACN(IT:1, 0)
ACN(IT:2, 0)
ACN(IT:3, 0)
***/// Proceso dia a dia desde el inicio hasta la fecha actual
SQL.ADD(" Select NrOperacion, Fecha, Monto ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN('NrOperacion')~"' ")
SQL.ADD(" and TipoDevengado = '"~FBN('TipoDevengado')~"' ")
SQL.ADD(" and Fecha > '"~IdxDate(Val(FC:10))~"' ")
SQL.ADD(" and Fecha <= '"~IdxDate(Val(FH:1))~"' ")
SQL.ADD(" Order by Fecha ")
Recorrer SQL
    If FBN('Fecha') > Val(FD:1)
        ***// Para las operaciones Activas/Pasivas se toma TC Comprador/Vendedor
        If Not EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',Val(TO:88)),VAR('CLASEOPVIN'))
            ***/// Calculo de Interes con cotizacion diaria
            IF Eqstr(&monedaOp, Val(ME:1))
               ACN(IT:11, FBN('Monto') * CotizacionBNA(&monedaOp,FBN('Fecha'),Val(AP:1),NO,NO))
               IF Eqstr(&monedaLocal, Val(ML:1))
                  ACN(IT:22, Val(IT:11))
               ELSE
                  ACN(IT:22, FBN('Monto') * CotizacionBCU(&monedaOp,FBN('Fecha'),Val(AP:1),NO,NO))
               ENDIF
               ACN(IT:33, FBN('Monto'))
            ELSE
               IF Eqstr(&monedaOp, Val(ML:1))
                  ACN(IT:11, FBN('Monto'))
                  IF Eqstr(&monedaLocal, Val(ML:1))
                     ACN(IT:22, Val(IT:11))
                  ELSE
                     ACN(IT:22, FBN('Monto') * CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                  ENDIF
                  ACN(IT:33, FBN('Monto') / CotizacionBNA(&dolContableVh,FBN('Fecha'),Val(AP:1),NO,NO))
               ELSE
                  IF Eqstr(&monedaOp, Val(MU:1))    
                     ACN(IT:11, FBN('Monto') / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                     IF Eqstr(&monedaLocal, Val(ML:1))
                        ACN(IT:22, FBN('Monto') / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                     ELSE
                        ACN(IT:22, FBN('Monto'))
                     ENDIF
                     ACN(IT:33, FBN('Monto') / CotizacionBCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                  ENDIF
               ENDIF
            ENDIF
        ELSE
        ***/// Para las operaciones vinculadas toma TC promedio
            ***/// Calculo de Interes con cotizacion diaria
            IF Eqstr(&monedaOp, Val(ME:1))
               ACN(CT:1, (CotizacionBNA(&monedaOp,FBN('Fecha'),1,NO,NO) + CotizacionBNA(&monedaOp,FBN('Fecha'),2,NO,NO))/2)
               ACN(IT:11, FBN('Monto') * Val(CT:1))
               IF Eqstr(&monedaLocal, Val(ML:1))
                  ACN(IT:22, Val(IT:11))
               ELSE
                  ACN(CT:1, (CotizacionBCU(&monedaOp,FBN('Fecha'),1,NO,NO) + CotizacionBCU(&monedaOp,FBN('Fecha'),2,NO,NO))/2)
                  ACN(IT:22, FBN('Monto') * Val(CT:1))
               ENDIF
               ACN(IT:33, FBN('Monto'))
            ELSE
               IF Eqstr(&monedaOp, Val(ML:1))
                  ACN(IT:11, FBN('Monto'))
                  IF Eqstr(&monedaLocal, Val(ML:1))
                     ACN(IT:22, Val(IT:11))
                  ELSE
                     ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:22, FBN('Monto') * Val(CT:1))
                  ENDIF
                  ACN(CT:1, (CotizacionBNA(&dolContableVh,FBN('Fecha'),1,NO,NO) + CotizacionBNA(&dolContableVh,FBN('Fecha'),2,NO,NO))/2)
                  ACN(IT:33, FBN('Monto') / Val(CT:1))
               ELSE
                  IF Eqstr(&monedaOp, Val(MU:1))
                     ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:11, FBN('Monto') / Val(CT:1))
                     IF Eqstr(&monedaLocal, Val(ML:1))
                        ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                        ACN(IT:22, FBN('Monto') / Val(CT:1))
                     ELSE
                        ACN(IT:22, FBN('Monto'))
                     ENDIF
                     ACN(CT:1, (CotizacionBCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:33, FBN('Monto') / Val(CT:1)) 
                  ENDIF
               ENDIF
            ENDIF
        ENDIF
        SCN(IT:1, Val(IT:11))
        SCN(IT:2, Val(IT:22))
        SCN(IT:3, Val(IT:33))
    ENDIF
    ***/// Calculo DC Diario
    SCN(MO:66, Abs(fbn('Monto')))
    IF Val(BD:55) = 1
        ***---Hay DC desde el segundo dia que devenga, por el monto acumulado al dia anterior que se procesa
        ***---Tanto a fin de mes como al Vto. se calcula la DC dia a dia a partir del interes acumulado a principio de mes
        let &capital Val(MO:66) - Abs(fbn('Monto'))
        ACD(FD:55, FBN('Fecha')-1)
        ACD(FH:55, FBN('Fecha'))
        IF [Val(CK:99) = 0 Y fbn('Fecha') >= Val(V:4)] O [Val(CK:99) = 1 Y fbn('Fecha') >= Val(V:3)]
            ***/// El dia procesado correspone al mes actual, entonces calculo DC diario.
            (.'DCDIARIA'.)
            SCN(DP:1, &dcCapitalMonFuerte)
            SCN(DP:2, &dcCapitalMonLocal)
            SCN(DP:3, &dcCapitalMonGrupo)
        ENDIF
    ENDIF
    ACN(BD:55, 1)
Proximo

