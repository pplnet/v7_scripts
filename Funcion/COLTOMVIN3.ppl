BorrarCeldas(NX:1..NX:1)
Recorrer&k 91, 99
    ACN(ZV:&k, 0)
Proximo
***---ZV:91 = Plazo Promedio x Operacion
***---ZV:92 = Suma de Plazo x Cantidad Total
***---ZV:93 = Suma de Cantidad Total
***---ZV:94 = Plazo Promedio Grupo Vinculadas

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD(" WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  (O.TipoOp In ('TEMIND') and  O.MB3 = '1') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" UNION ALL ")

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD(" WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('VIMIND','VIMINM') ")
SQL.ADD("       and  O.MB3 = '1' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" UNION ALL ")

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD(" WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" UNION ALL ")

SQL.ADD(" SELECT O.NrOperacion, C.Cantidad1 CantCuota, C.Fecha2 FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCM')  ")
SQL.ADD("       and  O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" ORDER BY 1 ")

Recorrer SQL
    IF Eqstr(fbn('NrOperacion'), Val(NX:1))
        SCN(ZV:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ELSE
        IF Not CeldaVacia(NX:1)  
            ***---Cambio de Operacion
            ACN(ZV:91, Val(ZV:99) / Val(ZV:98))
            SCN(ZV:92, Val(ZV:99))
            SCN(ZV:93, Val(ZV:98))
            ACN(ZV:99, 0)
        ENDIF
        ACT(NX:1, fbn('NrOperacion'))
        SCN(ZV:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
        ACN(ZV:98, fbn('Cantidad'))
    ENDIF
Proximo

ACN(ZV:91, Val(ZV:99) / Val(ZV:98))
SCN(ZV:92, Val(ZV:99))
SCN(ZV:93, Val(ZV:98))
ACN(ZV:94, Val(ZV:92) / Val(ZV:93))

