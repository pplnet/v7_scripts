*******************************************************************************************************
Acn(FA:99,0)
acn(zz:99,0)

Recorrer SQL
  ACN(FA:99, val(FA:99)+1 )
  *- Por cada cambio de tipo de tasa Selecciono de la tabla de cotizaciones la cotizacion
  If Not EqStr(val(CT:1),FBN['TipoTasa']) 
     * Recupero la Tasa 
     SQL.ADD(" Select T.Valor1, Fecha From "~DBO~".TASASDIA T ")
     SQL.ADD(" Where TipoTasa = '"~fbn('TipoTasa')~"' ")
     SQL.ADD(" AND Fecha = (Select Max(Fecha) From "~DBO~".TASASDIA T1 ")
     SQL.ADD("              Where T.TipoTasa = T1.TipoTasa ")
     SQL.ADD("              AND T1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
     Recorrer SQL
         acn(zz:99,1)
         ACN(TS:1, fbn('Valor1'))
         ACD(FT:1, fbn('Fecha'))
     Proximo
     if val(zz:99) = 1
          acn(zz:99,0)
     else
        ACN(TS:1,0)
      endif
  EndIf
  ACT(a:val(FA:99), FBN['NrOperacion']) 
  ACN(b:val(FA:99), FBN['NrCuota']) 
  ACD(c:val(FA:99), Dialogo.Fecha1) 
  ACD(d:val(FA:99), FBN['Fecha2'])   
  ACD(e:val(FA:99), val(FT:1) ) 
  ACT(f:val(FA:99), FBN['TipoTasa'])
  ACN(g:val(FA:99), val(TS:1) ) 
  ACT(CT:1, fbn('TipoTasa'))
Proximo

********************************************************************************************

IF val(fa:99) <> 0

  CrearListBox; 'MS Sans Serif,10, ' ; 'Tasas a Aplicar'
    'NrOperacion'   ;A:1..A:val(FA:99);NO;SI;'Error'; 90; STRING;12
    'Nro Cuota'     ;B:1..B:val(FA:99);NO;SI;'Error'; 90; NUMERO;'##'      
    'Fecha Vig.'    ;C:1..C:val(FA:99);NO;SI;'Error'; 90; FECHA;
    'Fecha Settl.';D:1..D:val(FA:99);NO;SI;'Error'; 90; FECHA; 
    'Fecha Tasa'    ;E:1..E:val(FA:99);NO;SI;'Error'; 90; FECHA; 
    'Tipo Tasa'     ;F:1..F:val(FA:99);NO;SI;'Error'; 90; STRING;12
    'Tasa'          ;G:1..G:val(FA:99);NO;SI;'Error'; 90; NUMERO;'##.########'
  FinListBox

Else
    messagebox('Noxxx hay información que coincidan con los datos solicitados')
    cancelar

Endif

If Not Ok
   Cancelar
Endif

