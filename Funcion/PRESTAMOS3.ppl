BorrarCeldas(NX:1..NX:1)

*-- Prestamos Sindicados
SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD(" WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPSC') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD("UNION ALL")

SQL.ADD(" SELECT O.NrOperacion, C.Cantidad1 CantCuota, C.Fecha2 FechaFin, O.Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMSCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" ORDER BY 1 ")

ACN(BZ:1, 0)

Recorrer SQL
    IF Eqstr(fbn('NrOperacion'), Val(NX:1))
        SCN(ZS:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ELSE
        IF Not CeldaVacia(NX:1)  
            ***---Cambio de Operacion
            ACN(ZS:91, Val(ZS:99) / Val(ZS:98))
            SCN(ZS:92, Val(ZS:99))
            SCN(ZS:93, Val(ZS:98))
            ACN(ZS:99, 0)
        ENDIF
        ACT(NX:1, fbn('NrOperacion'))
        SCN(ZS:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
        ACN(ZS:98, fbn('Cantidad'))
    ENDIF
Proximo

ACN(ZS:91, Val(ZS:99) / Val(ZS:98))
SCN(ZS:92, Val(ZS:99))
SCN(ZS:93, Val(ZS:98))
ACN(ZS:94, Val(ZS:92) / Val(ZS:93))
