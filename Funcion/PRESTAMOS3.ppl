BorrarCeldas(NX:1..NX:1)
Recorrer&k 91, 99
    ACN(ZL:&k, 0)
    ACN(ZF:&k, 0)
    ACN(ZY:&k, 0)
    ACN(ZS:&k, 0)
Proximo
***---ZL: Locales
***---ZF: OffShore
***---ZY: Buyers
***---ZS: Sindicados
***---Fila 91: = Plazo Promedio x Operacion
***---Fila 92: = Suma de Plazo x Cantidad Total
***---Fila 93: = Suma de Cantidad Total
***---Fila 94: = Plazo Promedio Grupo

*-- Prestamos Terceros Locales
SQL.ADD(" SELECT O.NrOperacion, C.Cantidad1 CantCuota, C.Fecha2 FechaFin, O.PrecioEj Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCLM') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" UNION ALL")

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMPLME' THEN O.Cantidad ELSE O.PrecioEj END Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCL','MMPLME') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

Recorrer SQL
    IF Eqstr(fbn('NrOperacion'), Val(NX:1))
        SCN(ZL:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ELSE
        IF Not CeldaVacia(NX:1)  
            ***---Cambio de Operacion
            ACN(ZL:91, Val(ZL:99) / Val(ZL:98))
            SCN(ZL:92, Val(ZL:99))
            SCN(ZL:93, Val(ZL:98))
            ACN(ZL:99, 0)
        ENDIF
        ACT(NX:1, fbn('NrOperacion'))
        SCN(ZL:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
        ACN(ZL:98, fbn('Cantidad'))
    ENDIF
Proximo

ACN(ZL:91, Val(ZL:99) / Val(ZL:98))
SCN(ZL:92, Val(ZL:99))
SCN(ZL:93, Val(ZL:98))
ACN(ZL:94, Val(ZL:92) / Val(ZL:93))

BorrarCeldas(NX:1..NX:1)

*-- Prestamos Terceros OFF SHORE
