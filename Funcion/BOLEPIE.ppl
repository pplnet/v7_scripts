if Val(ba:1)=1
  *------Leyenda del Comienzo
  if Incluido(fbn['TipoOp'],'CTP|CTC')
    act(ax:1,'Comprado')
  else
    act(ax:1,'Vendido')
  endif
  
  act(b:fac, Pad('',6)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
  act(b:fac+1,Pad('',6)~Val(ax:1)~' en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a liquidar el importe')
  act(c:fac+2, 'correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
  SetFont(b:fac..e:fac+2,2)
  SetFilaActual(fac+2)
else
  *------Leyenda del Pie
*  ACT(g:FAC  , 'Promotor de Agentes y Sociedad de Bolsa . '~fbn['Direccion']~' .Age. de Mercado Abierto de Val.Mobil.N# '~Var('AGESIOP'))
  ACT(g:FAC  , 'Promotor de Agentes y Sociedad de Bolsa . '~fbn['Direccion'])
  ACT(g:FAC+1, 'CUIT '~Var('CUIT')~'. IVA Resp.Inscripto. Ingresos Brutos Nr. '~Var('INGBRUT')~'. RG(DGI). '~Var('RGDGI')~'.')
  SetFont(b:FAC..g:fac+1, 2)
  AlinearCeldas(g:fac..g:fac+1,'C')
  SetFilaActual(fac+3)
endif


