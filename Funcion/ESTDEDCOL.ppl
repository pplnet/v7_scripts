   ACT(a:fac, 'Operacion')
   ACT(b:fac, 'Vehiculo')
   ACT(c:fac, 'Contraparte')
   ACT(d:fac, 'Moneda')
   If Val(GR:1)=0
      If Incluido(fbn('TipoOp'),'MMCAUP|SERP|SERPV')
        ACT(d:fac, 'Moneda/')
      Endif
   ENDIF
   ACT(F:fac, 'Prestamo Original')
   ACT(I:fac, 'Capital')
   ACT(J:fac, 'Amort')
   ACT(K:fac, 'Interes a')
   ACT(L:fac, 'Comisiones')
   ACT(M:fac, 'IVA')
   ACT(N:fac, 'WHT')
   ACT(O:fac, 'Impuesto')
   ACT(P:fac, 'Total a')
   ACT(Q:fac, 'T.N.A.')
   ACT(R:fac, 'T.E.A.')
   ACT(S:fac, '                      Intereses')
   ACT(U:fac, '                     WHT/Sellos')
   ACT(W:fac,'Tipo Op')

   SetFilaActual(fac+1)
   If Val(GR:1)=0
      If Incluido(fbn('TipoOp'),'MMCAUP|SERP|SERPV')
        ACT(d:fac, 'Especie')
      Endif
   ENDIF
   ACT(E:fac, 'FechaOp')
   ACT(F:fac, 'Plazo')
   ACT(G:fac, 'FechaVto')
   ACT(H:fac-1, 'Plazo')
   ACT(H:fac, 'Remanente')
   ACT(I:fac, 'Original')
   ACT(J:fac, 'Capital')
   ACT(K:fac, 'Pagar')
   ACT(O:fac, 'Sellos')
   ACT(P:fac, 'Pagar')
   ACT(Q:fac, '%')
   ACT(R:fac, '%')
   ACT(S:fac, 'Dev.')
   ACT(T:fac, 'a Dev.')
   ACT(U:fac, 'Dev.')
   ACT(V:fac, 'a Dev.')

  
   SetFont(a:fac-1..w:fac, 2)
   ***contorno
   AgregarMarco(a:fac-1..w:fac,2,0,Exe('COLOR'))
   ***columnas a - d
   AgregarMarco(a:fac-1..d:fac,2,2,Exe('COLOR'))
   
   ***Prestamo Original
   AgregarMarco(E:fac-1..G:fac-1,2,0,Exe('COLOR'))
   AgregarMarco(E:fac..G:fac,2,2,Exe('COLOR'))
   
   ***columnas I - Q
   AgregarMarco(I:fac-1..Q:fac,2,2,Exe('COLOR'))
   
   ***columnas S - T
   AgregarMarco(S:fac-1..T:fac-1,2,0,Exe('COLOR'))
   AgregarMarco(S:fac..T:fac,2,2,Exe('COLOR'))
   
   ***columnas U - V
   AgregarMarco(U:fac-1..V:fac-1,2,0,Exe('COLOR'))
   AgregarMarco(U:fac..V:fac,2,2,Exe('COLOR'))
   
   AlinearCeldas(a:fac-1..w:fac, 'C')
