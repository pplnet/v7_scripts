SQL.ADD("  from "~DBO~".MOVEJECUTADOS M with (Index = INDME5), "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("  where M.NrTrans2 = T.NrTrans ")
SQL.ADD("  and   T.NrTrans = B.NrOperacion ")
SQL.ADD("  and   B.NrBit = 2 ")
SQL.ADD("  and   B.Valor = '1' ") 
SQL.ADD("  and   M.Cliente = T.Cliente1 ")
SQL.ADD("  and   T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")

if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and   T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif

if Dialogo.Radio6=2
   SQL.ADD("and M.NrMov in (8,18,28,38)  ")
endif

*if [Dialogo.Radio6=1]
*   SQL.ADD(" and M.Cliente = 'CV'  ")
*else
*   SQL.ADD(" and M.Cliente <> 'CV' ")
*endif
*SQL.ADD("and M.Concepto = 'BOLSA' ") 
*SQL.ADD("and M.NrMov =  7 ")
*SQL.ADD("and M.NrGrupo =  4 ")
*SQL.ADD("and T.TipoTr2 in ('AJCASH','AJCAPR')  ")








