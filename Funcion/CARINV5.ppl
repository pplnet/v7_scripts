SQL.ADD(" Select Cantidad, ContraEspecie, Precio1, FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O")
SQL.ADD(" Where O.Especie = '"~Val(ES:1)~"' ")
SQL.ADD(" AND O.Book1 = '"~Val(BK:1)~"' ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~")  ")
ENDIF
IF Val(TP:1) = 6
    SQL.ADD(" AND O.TipoOp = 'FCS' ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ('SECS','SECSV','SECT','SECTV') ")
ENDIF
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Eqstr(Val(ES:1), 'BOC15')
*SQL.ADD(" Order By 1, ")
ENDIF
ACN(CE:3, 0)
Recorrer SQL
    DFA
    ACN(fh:1, Dialogo.Fecha2 - FBN('FechaOp'))
    IF Eqstr(FBN('ContraEspecie'), Val(MI:1))
       SCN(CE:3, FBN('Cantidad')*FBN('Precio1')*Val(fh:1))
    Else
       SCN(CE:3, FBN('Cantidad')*FBN('Precio1')*Val(fh:1)*CotizacionC(FBN('ContraEspecie'),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
    Endif
Proximo
