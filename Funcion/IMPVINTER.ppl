**-- IMPVINTER: Impuestos Cta.Cte Terceros
**-- En Pares de Vehiculos se guardan los % de Impuestos
**-- Reforma Impositiva: En Ganancias2a1 y a 1a2 se guarda
* Segun el caso de la Minuta
* RB6=0 (Local) Iva
* RB6=2 y MB3=1 WH 
* RB6=3 o (RB6=4 y MB3=1) Impuesto Extranjero

*** Recupero los Impuestos de Directo el Inverso
** DIRECTO

**--- Calculo de la tasa total neta: ((T(1+(G+WHT)/100))/Divisor)*365
**- Recupero el Factor en forma directa
ACT(Y13," Ganancias1a2 G,WHT1a2 W ")

IF EqStr(Val(Z7),'1')
   *-- Coloca => Recupero el Factor en forma inversa
   ACT(Y13," Ganancias2a1 G,WHT2a1 W ")
ENDIF

* MessageBox('2')

* Y15 Factor a Multiplicar la Tasa 
SQL.ADD("SELECT "~VAL(Y13)~",Divisor FROM "~DBO~".IMPTERCEROS WHERE Vehiculo='"~VAL(AV1)~"' AND Cliente='"~VAL(AV2)~"' ")

Recorrer SQL
  dfa
  ACN(Y15,FBN['W']/100)
  ACN(Y17,FBN['W'])
  ACN(Y18,IIF(EqStr('360',FBN['Divisor']),360,365))

  ACN(Y30,FBN['G'])
Proximo

* MessageBox('3')

* Tasa Total Neta
ACN(Y19,IIF(Dialogo.Precio1=0,VAL(Z12),Dialogo.Precio1)/VAL(Y18)*365)


* Tasa Total Neta Incluyendo WH e Impuesto Extranjero
IF VAL(AB6)>=2
   ACN(Y19,IIF(Dialogo.Precio1=0,VAL(Z12),Dialogo.Precio1)*(1+VAL(Y15))/VAL(Y18)*365)
ENDIF

* Monto Capitalizable Siempre es el Monto menos para caso 1
ACN(Y20,VAL(Z11))

ACN(Y4,0)
ACN(Y5,0)
ACN(Y6,0)
ACN(Y12,0)
ACN(Y13,0)
ACN(Y16,0)

* MessageBox('4')

*------------ Calculo el Importe de Iva Si Ambas empresas son locales
IF VAL(AB6)=0

   * MessageBox('5')

   * MessageBox('Calculando el IVA')
   * Si ambos vehiculos tienen la misma categoria de Agente Retencion (Vehiculo.Alias5)=>
   *    IVA=IMPORTE INTERES* TASAIVA/100
   * 
   * Si Vehiculo1 es AR y Cliente1 es NAR => 
   *
   *    Si el Interes>=Minimo Interes para Vigencia Percepcion
   *       IVA=IMPORTE INTERES* TASAIVA+RG3337/100
   *    Sino
   *       IVA=IMPORTE INTERES* TASAIVA/100
   *  
   * Si Vehiculo1 es NAR y Cliente1 es AR => 
   *
   *    IVA=IMPORTE INTERES* TASAIVA/100
   *    Si el IVA>=Minimo IVA para retencion
   *       RETENCION IVA= IVA*IVARETEN/100
   *    Sino
   *       RETENCION IVA= 0
   * A1 : Categoria de Retencion Vehiculo1 
   * A2 : Categoria de Retencion Cliente1
   * Y5 : Importe de Retencion de IVA      
   * Y6 : Alicuota de IVA      
   * Y12: Alicuota de Percepcion
   * Y13: Importe  de Percepcion

   ACT(A1,BuscarCampo('CLIENTES','Res3337','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',VAL(AV1))))
   ACT(A2,BuscarCampo('CLIENTES','Res3337','Codigo',VAL(AV2)))


   * MessageBox('6')

   IF EqStr(Val(Z7),'1')
      * MessageBox('*-- El Colocador es el Cliente1')
      ACT(A3,VAL(A1))
      ACT(A1,VAL(A2))
      ACT(A2,VAL(A3))       
   ENDIF

   * MessageBox('7')

   ACN(Y4,VAL(Z11)*VAL(Y17)/100)
   ACN(Y5,0)   
         
   * MessageBox('8')

   ACN(Y6,VAL(Y17))
   ACN(Y12,0)
   ACN(Y13,0)

   IF EqSTr(VAL(A1),'SI') y EqSTr(VAL(A2),'NO') 
      IF VAL(Z11)>=VAR('RG3337MINI') 
         ACN(Y12,VAR('RG3337'))
         ACN(Y13,VAL(Z11)*VAR('RG3337')/100)   
      ENDIF
   ENDIF

   * MessageBox(' Percepcion '~Fstr(val(y12),0,2))
   * MessageBox(' Imp. Percepcion '~Fstr(val(y13),0,2))

   * MessageBox('9')

   * MessageBox(' a1 '~val(a1))
   * MessageBox(' a2 '~val(a2))
   * MessageBox(' Y4 '~Fstr(val(y4),0,2) )
   * MessageBox(' ivaminimo '~Fstr(var('IVAMINIMO'),0,2) )
   * MessageBox(' ivareten  '~Fstr(var('IVARETEN' ),0,2) )

   IF EqSTr(VAL(A1),'NO') y EqSTr(VAL(A2),'SI') 
      IF VAL(Y4)>=VAR('IVAMINIMO') 
         ACN(Y5,VAL(Y4)*VAR('IVARETEN')/100)
      ENDIF
   ENDIF

   * MessageBox(' Retencion '~Fstr(val(y5),0,2))

   * MessageBox('10')

   * Y16: IvaNeto= IVA-Retenciones+Percepcion
   * Y17: MontoCapitalizable = Interes + IvaNeto
   ACN(Y16,VAL(Y4)-VAL(Y5)+VAL(Y13))    
   ACN(Y20,VAL(Z11)+VAL(Y16))
EndIf

   * MessageBox('11')
ACN(W1,0)
ACN(W2,0)

*------------ Calculo el Importe de WH
IF VAL(AB6)=2
   * W1: Tasa WH  W2: Importe de WH Directa  W3:Importe de WH Invera
   ACN(W1,VAL(Y17))

   * MessageBox('Calculo de Wh')
   * MessageBox(' Z7 '~VAL(Z7))
   * MessageBox(' Z11 '~Fstr(VAL(Z11),0,2) )

   IF EqStr(Val(Z7),'1')
      * Para Tomas
      ACN(W2,VAL(Z11)*VAL(W1)/100)
      * MessageBox(' Importe wh '~Fstr(VAL(W2),0,2) )
   EndIf
EndIf

* MessageBox('13')

*------------ Calculo el Importe del Impuesto Extranjero
ACN(I1,0)
ACN(I2,0)

IF VAL(AB6)>=3
   * MessageBox('14')
   * MessageBox('Calculo de Imp.')
   * MessageBox(' Z7 '~VAL(Z7))
   * MessageBox(' Z11 '~Fstr(VAL(Z11),0,2) )

   * I1: Tasa Impuesto  I2: Importe de Impuesto
   ACN(I1,VAL(Y17))

   * MessageBox('Antes de Evaluar Z7 '~VAL(Z7))

   IF VAL(AB6)=3 o EqStr(Val(Z7),'1')

      * MessageBox('Entro a Liquidar Evaluar Z7 '~VAL(Z7))
      * Para Tomas

      ACN(I2,VAL(Z11)*VAL(I1)/100)

      * MessageBox(' Importe Impuesto '~Fstr(VAL(i2),0,2) )
   EndIf
EndIf

***------------ Calculo por Reforma Impositiva.
*-- Calculo de Iva para Caso 3 
IF VAL(AB6)=2 y EqStr(Val(Z7),'1')
   *-- Calculo de Iva por Reforma Impositiva
   * Y30: % Iva
   * Y31: Importe de Iva
   ACN(y31,0)

   IF EqStr(Val(Z7),'1')
      ACN(y31,VAL(Z11)*VAL(Y30)/100)
   EndIf
   ACN(Y6 ,VAL(Y30))    
   ACN(Y4 ,VAL(Y31))    
   ACN(Y16,VAL(Y31))    
EndIf

