***---Obtengo Asientos Devengados Fin De Mes de la cuota que vence
SQL.ADD(" Select Sum(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, Sum(A1.Cantidad3) Cantidad3, Sum(A1.Valor1) Cantidad4,")
SQL.ADD(" M.TipoOp, A.NrUnicoAsiento, A1.Especie1, A1.Especie2, A1.Especie3, A1.Alias6 Especie4, C.Alias TipoCta, A1.DebitoCredito, A.NrOperacion, A1.Alias6 Moneda, V.Alias4 ")
SQL.ADD(" From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1, "~DBO~".MODELOSASIENTO M, "~DBO~".CONTABILIDAD C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where A.NrOperacion = '"~Val(NR:1)~"' ")
SQL.ADD(" AND A.NrUnicoAsiento = A1.NrUnicoAsiento ")
SQL.ADD(" AND M.Codigo = A.Modelo ")
SQL.ADD(" AND C.Codigo = A1.Cuenta ")
SQL.ADD(" AND V.Codigo = A.Vehiculo ")
***---Cuenta de Interes O DC Interes
SQL.ADD(" AND (C.Alias = 'I' OR (C.Alias = 'DC' AND A1.Alias5 = 'DCI')) ")
*SQL.ADD(" AND A1.Cuenta = '"~fbn('Cuenta')~"' ")
SQL.ADD(" AND M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVF'))~") ")
***---Asientos del periodo que vence
SQL.ADD(" AND (A.FechaValor > (Select Max(C.Fecha1) From "~DBO~".CUOTAS C ")
SQL.ADD("                   Where A.NrOperacion = C.NrOperacion ")
SQL.ADD("                   AND C.Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD(" Group By M.TipoOp, A.NrUnicoAsiento, A1.Especie1, A1.Especie2, A1.Especie3, A1.Alias6, C.Alias, A1.DebitoCredito, A.NrOperacion, V.Alias4 ")
Recorrer SQL
    IF Not Eqstr(fbn('NrOperacion'), Val(NR:2)) Y Not CeldaVacia(NR:2)
        SCN(TI:1, Val(VI:1) + Val(FI:1))
        SCN(TI:2, Val(VI:2) + Val(FI:2))
        SCN(TI:3, Val(VI:3) + Val(FI:3))
        SCN(TI:4, Val(VI:4) + Val(FI:4))
        SCN(TD:1, Val(VD:1) + Val(FD:1))
        SCN(TD:2, Val(VD:2) + Val(FD:2))
        SCN(TD:3, Val(VD:3) + Val(FD:3))
        SCN(TD:4, Val(VD:4) + Val(FD:4))
        ACN(FI:1, 0)
        ACN(FI:2, 0)
        ACN(FI:3, 0)
        ACN(FI:4, 0)
        ACN(FD:1, 0)
        ACN(FD:2, 0)
        ACN(FD:3, 0)
        ACN(FD:4, 0)
        ACN(TI:1, 0)
        ACN(TI:2, 0)
        ACN(TI:3, 0)
        ACN(TI:4, 0)
        ACN(TD:1, 0)
        ACN(TD:2, 0)
        ACN(TD:3, 0)
        ACN(TD:4, 0)
    ENDIF
    IF Incluido(fbn('TipoOp'), Val(OA:1)) O [Eqstr(fbn('TipoOp'), 'MMPCCM') Y BuscarCampo('OPERACIONES','MB3','NrOperacion', fbn('NrOperacion')) = 1]
        ***---Signo
        IF Eqstr(fbn('DebitoCredito'), 'DEB')
            ACN(SG:1, -1)
        ELSE
            ACN(SG:1, 1)
        ENDIF
    ELSE
        ***---Signo
        IF Eqstr(fbn('DebitoCredito'), 'DEB')
            ACN(SG:1, 1)
        ELSE
            ACN(SG:1, -1)
        ENDIF
    ENDIF
    IF Eqstr(fbn('TipoCta'), 'I')
        ***---Interes Contabilizado a Fin de Mes
        SCN(FI:1, fbn('Cantidad1') * Val(SG:1))
        SCN(FI:2, fbn('Cantidad2') * Val(SG:1))
        SCN(FI:3, fbn('Cantidad3') * Val(SG:1))
        SCN(FI:4, fbn('Cantidad4') * Val(SG:1))
    ELSE
        ***---DC Contabilizada a Fin de Mes
        SCN(FD:1, fbn('Cantidad1') * Val(SG:1))
        SCN(FD:2, fbn('Cantidad2') * Val(SG:1))
        SCN(FD:3, fbn('Cantidad3') * Val(SG:1))
        SCN(FD:4, fbn('Cantidad4') * Val(SG:1))
    ENDIF
    ACT(NR:2, fbn('NrOperacion'))
    ACT(AS:2, fbn('NrUnicoAsiento'))
Proximo
***---Ultimo Registro
SCN(TI:1, Val(VI:1) + Val(FI:1))
SCN(TI:2, Val(VI:2) + Val(FI:2))
SCN(TI:3, Val(VI:3) + Val(FI:3))
SCN(TI:4, Val(VI:4) + Val(FI:4))
SCN(TD:1, Val(VD:1) + Val(FD:1))
SCN(TD:2, Val(VD:2) + Val(FD:2))
SCN(TD:3, Val(VD:3) + Val(FD:3))
SCN(TD:4, Val(VD:4) + Val(FD:4))
