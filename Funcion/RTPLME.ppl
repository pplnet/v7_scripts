acn(o:fac,val(j:fac)*(val(l:fac)/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1) )
acn(q:fac,(val(j:fac)*(val(av:fac)/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(FBN['ImpGastos2']/100) )

acn(v:fac,IIf(val(l:fac)>VAR('TASAIMPINT'),((((val(j:fac)*(VAR('TASAIMPINT')/100)*FBN['Plazo'])/36500))*FBN['TasaImp1']),val(o:fac)*(FBN['TasaImp1']/100)))

acn(z:fac,val(j:fac)+val(o:fac) )
acn(aa:fac,val(z:fac) + val(q:fac)+ val(v:fac) )

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')
