********************************* Si el mensaje fue un Boleto **********************************
* Mensaje que dio origen a la respuesta fue :                                                  *
*       0305 : Alta para la venta hoy            0405 : Alta para la compra hoy                *
*       0306 : Alta para la venta ayer           0406 : Alta para la compra ayer               *
* con el primer digito de la secuencia = 1 Operacion - 4 OpMinorista                           *
************************************************************************************************
if EqStr(Copy(Val(A:FAC),42,1),'1')
  Message('----- Codigo Mensaje Recibido : Boleto '~Copy(Val(A:FAC),32,4))

  ACN(v4, 0)
  SQL.ADD("Select O.NrOperacion, O.PaseCB, O.NrOperacion3, O.OperacionRef, O.TipoOp ")
  SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
  SQL.ADD(" Where O.NrOperacion Like '"~'T___'~Copy(Val(A:FAC),43,4)~"' ")
  SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
  SQL.ADD("   and OB.NrBit = 66 ")
  SQL.ADD("   and OB.Valor = '1' ")
  Recorrer SQL
    DFA
    SCN(v4, 1)
    if Val(v4)>1
      Message('Mas de una Operacion RECMAE03')
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Mas de una Operacion RECMAE03',30)~'-'~Val(A:FAC))
        CerrarASCII
      endif
      break
    endif
    if EqStr(Copy(Val(A:FAC),47,1),'S') o EqStr(Copy(Val(A:FAC),47,1),'2')
      * Acepta Informacion Boleto
      Message('---------- '~FBN['NrOperacion']~' Ok Boleto, Actualiza Ops y va a Emision de Boletos')
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=66, Entero2=67)
      if EqStr(FBN['PaseCB'],'1')
** FJL 17/03/20 - En STD el pase es OperacionRef
*        ACT(w1, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',FBN['NrOperacion3']))
        ACT(w1, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',FBN['OperacionRef']))
        if Incluido(FBN['TipoOp'],'TIC|TIV')
          ACT(w3, 'OK  '~Copy(Val(w1),5,4))
        else
          ACT(w3, Copy(Val(w1),1,4)~'OK  ')
        endif
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set NroAltaMAE = '"~Val(w3)~"' ")
** FJL 17/03/20 - En STD el pase es OperacionRef
*        SQL.ADD(" Where NrOperacion= '"~FBN['NrOperacion3']~"' ")
        SQL.ADD(" Where NrOperacion= '"~FBN['OperacionRef']~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    else
      if EqStr(Copy(Val(A:FAC),47,1),'N')
        * No Acepta Informacion Boleto
        Message('---------- '~FBN['NrOperacion']~' No acepta Boleto, va a Boletos Rechazados (75)')
        SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
        SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~FBN['NrOperacion']~"', ")
        SQL.ADD(" "~SQLAhora~", ")
        SQL.ADD(" 'ERRORBOL', ")
        SQL.ADD(" '"~Copy(Val(A:FAC),48,60)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=66, Entero2=75)
      else
        Message('Error Codigo Respuesta Boleto RECMAE03')
        if Eqstr(Var('LOGERRMAE'),'SI')
          AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
          EscribirASCII(Pad('Error Cod.Res.Boleto RECMAE03',30)~'-'~Val(A:FAC))
          CerrarASCII
        endif
      endif
    endif
  Proximo
  if Val(v4)=0
    Message('Operacion NO encontrada RECMAE03')
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Op. NO encontrada RECMAE03',30)~'-'~Val(A:FAC))
      CerrarASCII
    endif
  endif
else
  if EqStr(Copy(Val(A:FAC),42,1),'4') y NO
    Message('----- Codigo Mensaje Recibido : Boleto Minorista '~Copy(Val(A:FAC),32,4))
    ACN(v4, 0)
    SQL.ADD("Select O.NrOperacion, O.PaseCB, O.OperacionRef, O.TipoOp ")
    SQL.ADD("  from "~DBO~".OPMINORISTAS O, "~DBO~".OPERACIONESBITS OB ")
    SQL.ADD(" Where O.NrOperacion Like '"~'MT__'~Copy(Val(A:FAC),43,4)~"' ")
    SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
    SQL.ADD("   and OB.NrBit = 66 ")
    SQL.ADD("   and OB.Valor = '1' ")
    Recorrer SQL
      DFA
      SCN(v4, 1)
      if Val(v4)>1
        Message('Mas de una Operacion RECMAE03')
        if Eqstr(Var('LOGERRMAE'),'SI')
          AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
          EscribirASCII(Pad('Mas de 1 Op.Minorista RECMAE03',30)~'-'~Val(A:FAC))
          CerrarASCII
        endif
        break
      endif
      if EqStr(Copy(Val(A:FAC),47,1),'S') o EqStr(Copy(Val(A:FAC),47,1),'2')
        * Acepta Informacion Boleto
        Message('---------- '~FBN['NrOperacion']~' Ok Boleto, Actualiza Ops y va a Emision de Boletos')
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=66, Entero2=67)
      else
        if EqStr(Copy(Val(A:FAC),47,1),'N')
          * No Acepta Informacion Boleto
          Message('---------- '~FBN['NrOperacion']~' No acepta Boleto, va a Boletos Rechazados (75)')
          SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
          SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD(" '"~FBN['NrOperacion']~"', ")
          SQL.ADD(" "~SQLAhora~", ")
          SQL.ADD(" 'ERRORBOL', ")
          SQL.ADD(" '"~Copy(Val(A:FAC),48,60)~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=66, Entero2=75)
        else
          Message('Error Codigo Respuesta Boleto RECMAE03')
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Error Cod.Res.Boleto RECMAE03',30)~'-'~Val(A:FAC))
            CerrarASCII
          endif
        endif
      endif
    Proximo
    if Val(v4)=0
      Message('Operacion NO encontrada RECMAE03')
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Op.Min. NO encontrada RECMAE03',30)~'-'~Val(A:FAC))
        CerrarASCII
      endif
    endif
  else
    Message('Digito Secuencia incorrecto RECMAE03')
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Digito incorrecto RECMAE03',30)~'-'~Val(A:FAC))
      CerrarASCII
    endif
  endif
endif
