Message('----- Saldos por Cartera') 

* buscar carteras 1- Trading / 2- Investment / 3- Disponible
recorrer&i 1, 3
  BorrarCeldas(x1..x4)
  ACN(x2,&i)
  if Val(x2)=1
    ACT(x3,'0')
  else
    if Val(x2)=2
      ACT(x3,'1')
    else
      ACT(x3,'2')
    endif
  endif

  * Cantidad
  ACN(x1, Saldo(VAR('VEHICULODE'),Val(b2),,,,,,Val(x2),Val(g2),FStr(Val(c2),1,0)))

  if Val(x1)<>0
    * insertar una transaccion para actualizar el saldo
    SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")
    SQL.ADD(" Especie, Especie2, Cupon1 ,")
    SQL.ADD(" Fecha1, Fecha2, Cliente1, ")
    SQL.ADD(" Cantidad1, RB1, Precio1, ")
    SQL.ADD(" Precio2, Precio3, Cambio1, ")
    SQL.ADD(" Cambio2, Vehiculo1, ")
    SQL.ADD(" TipoTr2, NrTrans, ")
    SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput ")
    SQL.ADD(" ) Values ( ")
    SQL.ADD(" '"~Val(b2)~"', '"~Val(b4)~"', '"~FStr(Val(c2),1,0)~"',")
    SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~IdxDate(Val(h4))~"', '"~VAR('VEHICULODE')~"', ")
    SQL.ADD(" "~FStr(Val(x1),1,2)~", '"~Val(x3)~"', "~FStr(Val(k2),1,8)~", ")    
    SQL.ADD(" "~FStr(Val(l2),1,8)~", "~FStr(Val(m2),1,8)~", "~FStr(Val(e2),1,8)~", ")
    SQL.ADD(" "~FStr(Val(e3),1,8)~", '"~VAR('VEHICULODE')~"', ")
    ACT(Y1,GetNumerador(16))
    SQL.ADD(" 'CUPON', '"~Val(Y1)~"'," )
    SQL.ADD(" "~SQLAhora~", "~SQLAhora~", '"~UsuarioActivo~"' ")
    SQL.ADD(" ) ")
    SQL.NEW  

    * Generar Movimientos por la especie original
    ACT(x4,'Corte de Cupon '~FStr(Val(c2),1,0)~' de '~Val(b2))
    SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS (")
    SQL.ADD("NrOperacion, FechaMov, Cliente, ")
    SQL.ADD(" Especie, Cantidad, Leyenda,")
    SQL.ADD(" Bits, NrSaldo, NrGrupo, ")
    SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
    SQL.ADD(" NrInstan, Cupon ")
    SQL.ADD(" ) Values (")
    SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~VAR('VEHICULODE')~"', ")
    SQL.ADD(" '"~Val(b2)~"', "~FStr(Val(x1)*-1,1,2)~", '"~Val(x4)~"', ")
    SQL.ADD(" 'AV', "~FStr(Val(x2),1,0)~", 1,  ")
    SQL.ADD(" '"~IdxDate(FSys)~"', 0, 1, ")
    SQL.ADD(" 0, '"~FStr(Val(c2),1,0)~"') ")
    SQL.NEW

    ** Generar Movimientos por la especie nueva
    SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS (")
    SQL.ADD("NrOperacion, FechaMov, Cliente, ")
    SQL.ADD(" Especie, Cantidad, Leyenda,")
    SQL.ADD(" Bits, NrSaldo, NrGrupo, ")
    SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
    SQL.ADD(" NrInstan, Cupon ")
    SQL.ADD(" ) Values (")
    SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~VAR('VEHICULODE')~"', ")
    SQL.ADD(" '"~Val(b2)~"', "~FStr(Val(x1),1,2)~", '"~Val(x4)~"', ")
    SQL.ADD(" 'AV', "~FStr(Val(x2),1,0)~", 2,  ")
    SQL.ADD(" '"~IdxDate(FSys)~"', 0, 2, ")
    SQL.ADD(" 0, '"~FStr(Val(c3),1,0)~"') ")
    SQL.NEW

    ** Generar Movimientos por los cupones
    SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS (")
    SQL.ADD("NrOperacion, FechaMov, Cliente, ")
    SQL.ADD(" Especie, Cantidad, Leyenda,")
    SQL.ADD(" Bits, NrSaldo, NrGrupo, ")
    SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
    SQL.ADD(" NrInstan, Cupon ")
    SQL.ADD(" ) Values (")
    SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~VAR('VEHICULODE')~"', ")
    SQL.ADD(" '"~Val(b4)~"', "~FStr(Val(x1),1,2)~", '"~Val(x4)~"', ")
    SQL.ADD(" 'AV', "~FStr(Val(x2),1,0)~", 2,  ")
    SQL.ADD(" '"~IdxDate(FSys)~"', 0, 3, ")
    SQL.ADD(" 0, '"~FStr(Val(c2),1,0)~"') ")
    SQL.NEW

    SQL.EXEC

    * guardar nro. de transaccion por saldo de Trading
    if Val(x2)=1
      ACT(yy1,Val(Y1))
    endif
  endif
proximo
