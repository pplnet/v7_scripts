VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
Vacio(Vehiculo2) o EqStr(BuscarCampo('Clientes','Status','Codigo',Vehiculo2),'HAB');'La Contraparte No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,VEHICULO2);'La Contraparte y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(VEHICULO2,VEHICULO);'La Contraparte debe ser Terminal';NO
INSTANCIA=1 o INSTANCIA=2 o ESEVENTUAL;'Instancia de Carga Incorrecta !!!';SI
FECHAOP2<=Fsys;'La Fecha de Concertacion no puede ser futuro';NO
