Recorrer SQL

   If Incluido(fbn['MB3'],'0')
      *--> O.MB3 = '0'
      If Val(bb:2020) = 0
         ACT(c:fac, "Opciones")
         SetFont(c:fac, 2)
         ACN(bb:2020,1)
         SCN(c:2000,1)
           
         *--> Seteo en cero la fila
         RECORRER&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO
            
         SCN(fl:2,1)
      EndIf

      *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
      If Val(cz:2) = 0
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)))
      Else
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)))
      EndIf

      ACN(mt:1100, 0)
      SCN(mt:1100, FBN['Cant'] * Val(mt:1200))

      *--> Diario
      RECORRER&i Val(VT:1), val(lm:1) 
         If FBN['Fecha'] = val(&i:Val(xx:2000))
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf   
         EndIf
      Proximo

      RECORRER&i val(lm:1)+1, val(lm:2)-1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         endif
      Proximo

      *--> Para la ultima columna de meses
      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         If Val(mn:1000) = 0
            ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      EndIf
   Else
      *--> O.MB3 = '1'
      If Val(bb:2030) = 0
         ACT(C:fac, "Opciones")
         SetFont(C:fac, 2)
         ACN(bb:2030,1)
         SCN(f:2000,1)
           
         *--> Seteo en cero la fila
         RECORRER&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO
            
         SCN(fl:2,1)
      EndIf

      *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
      If Val(cz:2) = 0
         ACN(MT:1200, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(ML:1)))
      Else
         ACN(MT:1200, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(ME:1)))
      EndIf

      ACN(MT:1100, 0)
      SCN(MT:1100, FBN['Cant'] * Val(mt:1200))

      *--> Diario
      RECORRER&i Val(VT:1), val(lm:1)
         If FBN['Fecha'] = val(&i:Val(xx:2000))
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf   
         EndIf
      Proximo

      RECORRER&i val(lm:1)+1, val(lm:2)-1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         endif
      Proximo

      *--> Para la ultima columna de meses
      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         If Val(mn:1000) = 1
            ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      EndIf
   EndIf
Proximo

