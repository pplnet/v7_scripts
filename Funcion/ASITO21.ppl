    ACN(e:fac, SUM(e:Val(fi:1)..e:fac))
    ACN(f:fac, SUM(f:Val(fi:1)..f:fac))
    ACN(g:fac,-Val(e:fac)+Val(f:fac) )
*    ACN(l:fac, SUM(l:Val(fi:1)..l:fac))
*    ACN(m:fac, SUM(m:Val(fi:1)..m:fac))
*    ACN(n:fac,-Val(l:fac)+Val(m:fac) )

    If ROUND(Val(g:fac),2)=0
      ACT(h:fac, '<-OK')
      ColorCeldas(h:fac, clBLUE)
    Else
      ACT(h:fac, iif(Eqstr(Val(aa:3),'BI'),'<-Bimonetario','<-ERROR') )
      ColorCeldas(h:fac, clRED)
    Endif

*    If ROUND(Val(n:fac),2)=0
*      ACT(o:fac, '<-OK')
*      ColorCeldas(o:fac, clBLUE)
*    Else
*      ACT(aa:2, 'ERROR')     
*      ACT(o:fac, '<-ERROR')
*      ColorCeldas(o:fac, clRED)
*    Endif

*    IF Val(QQ:fac-1) = 1
*      ACT(aa:2, 'ERROR')     
*      ACT(A:fac, '<-ERROR Fecha Valor')
*      ColorCeldas(A:fac, clRED)
*    ENDIF

    If [Dialogo.Radio1=2] o [Dialogo.Radio1=0 y Eqstr(Val(aa:2),'OK')] o [Dialogo.Radio1=1 y Eqstr(Val(aa:2),'ERROR')]
       FormatoCeldas(e:fac..m:fac, EXE('F2'))
       AgregarMarco(a:fac..u:fac,1,0,0)
       SetFont(a:fac..z:fac, 4)
       ifa
       ifa
       ACN(fi:1, fac)
    Else
       BorrarCeldas(a:Val(fi:1)..u:fac)  
       SetFilaActual(Val(fi:1))  
    Endif
