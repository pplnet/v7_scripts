VTXT11  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT12  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)


Label1     : ''              ;17;1;2;NO;NoVacio(CONTRAESPECIE) Y CB9=0 ;;;;'Especie';'Especie';;;;;;
Label2     : ''              ;17;2;2;NO;NoVacio(CONTRAESPECIE)    ;;;;'ContraEspecie';'ContraEspecie';;;;;;      


Cuenta1 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a');18;1;2;Not EV;Not Incluido(TipoOp, 'DSEO') Y CB9=0 ; [[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')  ] y NOVACIO(CUENTA1)  ] O CB9 <> 0  ;"Error en Cuenta  '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')~"' "~ESPECIE;SI;IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1);IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA1);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')"
Cuenta2 : If(Incluido(TIPOOP,EXE('CARTA1V')) O [Eqstr(TipoOp, 'DSEO')],'Credito a','Debito en')       ;18;2;2;Not EV Y NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE);Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'HAB')]]];"Error en Cuenta  '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'HAB'), CUENTA2);;;;;;"( Cliente='"~VEHICULO1~"' and Estado='HAB'  and "~RB6~"=1 AND (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%'))  OR ("~RB6~"=0 AND Cliente='"~VEHICULO1~"' and Estado='HAB'  AND (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista (VTXT11,Elementos(VTXT11))~"%') )"
