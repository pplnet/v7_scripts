SQL.ADD("Select S.Cliente, S.EnteCustodia, S.NrSaldo, Sum(S.Saldo) as Saldo from "~DBO~".SALDOSDIA S")
SQL.ADD("where  S.Especie = '"~Dialogo.Especie1~"'  ")
SQL.ADD("  and  S.NrSaldo<>1 and S.Saldo<>0 ")
SQL.ADD("  and  S.Fecha=( ")
SQL.ADD("Select Max(Fecha) as Fe from "~DBO~".SALDOSDIA S1")
SQL.ADD("where  S1.Especie = S.Especie  and ")
SQL.ADD("       S1.Cliente = S.Cliente  and ")
SQL.ADD("       ((S1.EnteCustodia = S.EnteCustodia) OR (S1.EnteCustodia is Null AND S.EnteCustodia is Null))  and ")
SQL.ADD("       S1.NrSaldo = S.NrSaldo  and ")
SQL.ADD("       Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("group by Cliente, EnteCustodia, NrSaldo")
SQL.ADD("order by Cliente, EnteCustodia, NrSaldo")

Recorrer SQL

