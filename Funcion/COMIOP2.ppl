COMISIONES2:VACIO(OPERACIONREF) o Not Eqstr(ABM,'A');30;
  Tipo      : 'Tipo'         ;VACIO(OPERACIONREF);;;;;;90;NO;Combo;'FPD|FFC|CDO|CPI|CF|EF| '
  Tasa1     : 'Tasa'         ;VACIO(OPERACIONREF);;COM2L.TIPO[Fila]>5 O COM2L.TASA1[Fila]>0;'INDIQUE LA TASA DE LA COMISION ';;IF(COM2L.TIPO[Fila]<=5,IF(COM2L.TIPO[Fila]<=2 O COM2L.TIPO[Fila]=5,COM2L.IMPORTE1[Fila]*100/(CANTIDAD+IF(COM2L.TIPO[Fila]<=2,TOTALCOMISIONES,0)),IF(COM2L.TIPO[Fila]=3,(COM2L.IMPORTE1[Fila]*IF(COM2L.RB2[Fila]=0,36000,36500))/((CANTIDAD+TOTALCOMISIONES)*PLAZO)))),0);100;NO;Numero;'###.########';NO;NO;'4'
  NrCuota   : 'Cuota'        ;VACIO(OPERACIONREF);;COM2L.NRCUOTA[Fila]>=0 y COM2L.NRCUOTA[Fila]<=Cuotas1;'Nro. de Cuota INCORRECTA ';;IF(COM2L.TIPO[Fila]<>3,COM2L.NRCUOTA[Fila],IF(MODI,COM2L.NRCUOTA[Fila],Fila));50;;Numero;'###';;;
  Importe1  : 'Importe'      ;VACIO(OPERACIONREF);;;;;IF(COM2L.TIPO[Fila]<=5,IF(COM2L.TIPO[Fila]<=2 O COM2L.TIPO[Fila]=5,(CANTIDAD+IF(COM2L.TIPO[Fila]<=2,TOTALCOMISIONES,0))*COM2L.TASA1[Fila]/100,IF(COM2L.TIPO[Fila]=3,((CUOTASL.CANTIDAD2[COM2L.NRCUOTA[Fila]])*COM2L.TASA1[Fila]*CUOTASL.PLAZO1[COM2L.NRCUOTA[Fila]]/IF(COM2L.RB2[Fila]=0,36000,36500)),COM2L.IMPORTE1[Fila]))),0);200;;Numero;'###,###,###,###,###.##';NO;NO;'2'
  Especie1  : 'Especie'      ;VACIO(OPERACIONREF);;COM2L.TIPO[Fila]>5 O NOVACIO(COM2L.ESPECIE1[Fila]);'Indique la Especie de la Comision';;;90;NO;Tabla;'Especies';'Codigo';'Codigo;Nombre'
  Fecha1    : 'Fecha'        ;VACIO(OPERACIONREF);;COM2L.TIPO[Fila]>5 O COM2L.FECHA1[Fila]>=FECHAOP2 O [COM2L.TIPO[Fila]=0 Y [COM2L.FECHA1[Fila]=0 O COM2L.FECHA1[Fila]>=FECHAOP]] O  [COM2L.TIPO[Fila]=5 Y COM2L.FECHA1[Fila]=FECHAOP] O [COM2L.TIPO[Fila]=3 Y COM2L.FECHA1[Fila]=CUOTASL.FECHA2[COM2L.NRCUOTA[Fila]]] O [COM2L.TIPO[Fila]=2 Y [COM2L.FECHA1[Fila]=0 O COM2L.FECHA1[Fila]>=FECHAOP2]];'La Fecha de la Comision es Incorrecta !!';;IF(COM2L.TIPO[Fila]=3,CUOTASL.FECHA2[COM2L.NRCUOTA[Fila]],IF(COM2L.TIPO[Fila]=1 O COM2L.TIPO[Fila]=5,FECHAOP,COM2L.FECHA1[Fila]));90;;Fecha
  Cliente1  : 'Destinatario' ;VACIO(OPERACIONREF);;COM2L.TIPO[Fila]>5 O NOVACIO(COM2L.CLIENTE1[Fila]);'Indique el Destinatario de la Comision';;;90;;Tabla;'Clientes';'Codigo';'Codigo;RazonSocial'
  RB1       : 'Extranjero'   ;NO;NO;;;0;IF(VACIO(COM2L.CLIENTE1[Fila]) O EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',COM2L.CLIENTE1[Fila])),0,1);50;;Check
  Tasa2     : 'Tasa IVA'     ;VACIO(OPERACIONREF);;VACIO(COM2L.CLIENTE1[Fila]) O INCLUIDO(FSTR(COM2L.TASA2[Fila],2,2),VAR('IVA'));"El Valor de TASA IVA es Erroneo: "~VAR('IVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,if(VACIO(OPERACIONREF),IF(COM2L.RB1[Fila]<>1,if(EqStr('A',ABM),VAR('TASAIVA'),COM2L.TASA2[Fila]),0)));IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,if(VACIO(OPERACIONREF),IF(COM2L.RB1[Fila]<>1,if(EqStr('A',ABM),VAR('TASAIVA'),COM2L.TASA2[Fila]),0)));100;;Numero;'###.##';NO;NO
  Importe2  : 'Importe_IVA'  ;NO;;;;if(VACIO(OPERACIONREF),(COM2L.IMPORTE1[Fila]*COM2L.TASA2[Fila]/100));if(VACIO(OPERACIONREF),(COM2L.IMPORTE1[Fila]*COM2L.TASA2[Fila]/100));200;;Numero;'###,###,###,###,###.##'
  Tasa3     : 'Tasa WH '     ;VACIO(OPERACIONREF);;VACIO(COM2L.CLIENTE1[Fila]) O COM2L.RB1[Fila]=0 O Incluido(Fstr(COM2L.TASA3[Fila],2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';VAR('DEFWH1');IF(COM2L.RB1[Fila]=0,0,VAR('DEFWH1'));100;;Numero;'##.####';NO;NO
  Importe3  : 'Importe_WH'   ;NO;;;;;IF(COM2L.RB1[Fila]=1,COM2L.IMPORTE1[Fila]*COM2L.TASA3[Fila]/100,0);200;;Numero;'###,###,###,###,###.##'
  RB2       : 'U_Tiempo'     ;VACIO(OPERACIONREF);;;;0;;90;;Combo;'360|365'
  Precio1   : '% ImpInt'         ;VACIO(OPERACIONREF);;INCLUIDO(FSTR(COM2L.PRECIO1[Fila],2,4),VAR('TASAINT'));"El Valor de TASA INTERES es Erroneo: "~VAR('TASAINT');if(VACIO(OPERACIONREF),IF(COM2L.RB1[Fila]<>1,if(EqStr('A',ABM),VAR('DEFAINT'),COM2L.PRECIO1[Fila])));if(VACIO(OPERACIONREF),IF(COM2L.RB1[Fila]<>1,if(EqStr('A',ABM),VAR('DEFAINT'),COM2L.PRECIO1[Fila])));100;;Numero;'###.##';NO;NO
  Precio2   : 'Impto.Imp.Int'    ;NO;;;;if(VACIO(OPERACIONREF),(COM2L.IMPORTE1[Fila]*COM2L.PRECIO1[Fila]/100),0);if(VACIO(OPERACIONREF),(COM2L.IMPORTE1[Fila]*COM2L.PRECIO1[Fila]/100),0);200;;Numero;'###,###,###,###,###.##'
  Importe4  : 'Importe_Pagar'    ;NO;;;;;COM2L.IMPORTE1[Fila]+COM2L.IMPORTE3[Fila]+COM2L.PRECIO2[Fila];200;;Numero;'###,###,###,###,###.##'
  Cotizacion1: 'TC_IVA'          ;NO;NO;;;-1;;200;;Numero;'###.######'
  Cotizacion2: 'TC_WH'           ;NO;NO;;;-1;;200;;Numero;'###.######'
  Importe5  : 'Commitment Fee'   ;NO;NO;;;0;;200;;Numero;'###.######'


MOVCOMISIONES
Com2L.Fecha1[Fila];Com2L.Cliente1[Fila];If(Com2L.Cotizacion2[Fila]<=0,Com2L.Especie1[Fila],VAR('MONELOCA'));;Vehiculo1;1;Com2L.Importe1[Fila]                                                        ;'Monto Comision';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Com2L.Fecha1[Fila]<>0 y Com2L.Importe1[Fila]<>0;Fila;Cuenta3;        ;Fila+10000;'COMISIONES2'
Com2L.Fecha1[Fila];Com2L.Cliente1[Fila];If(Com2L.Cotizacion1[Fila]<=0,Especie,VAR('MONELOCA'))             ;;Vehiculo1;1;Com2L.Importe2[Fila]*If(Com2L.Cotizacion1[Fila]<0,1,Com2L.Cotizacion1[Fila]);'IVA Comision';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Com2L.Fecha1[Fila]<>0 y Com2L.Importe2[Fila]<>0;Fila;Cuenta3;         ;Fila+11000;'COMISIONES2'
Com2L.Fecha1[Fila];Com2L.Cliente1[Fila];If(Com2L.Cotizacion2[Fila]<=0,Com2L.Especie1[Fila],VAR('MONELOCA'));;Vehiculo1;1;Com2L.Importe3[Fila]*If(Com2L.Cotizacion2[Fila]<0,1,Com2L.Cotizacion2[Fila]);'WH Comision';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Com2L.Fecha1[Fila]<>0 y Com2L.Importe3[Fila]<>0;Fila;Cuenta3;          ;Fila+12000;'COMISIONES2'
Com2L.Fecha1[Fila];Com2L.Cliente1[Fila];If(Com2L.Cotizacion1[Fila]<=0,Especie,VAR('MONELOCA'))             ;;Vehiculo1;1;Com2L.Precio2[Fila]*If(Com2L.Cotizacion1[Fila]<0,1,Com2L.Cotizacion1[Fila]) ;'Impto.Int Comision';SI;Not Incluido(Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'));;Com2L.Fecha1[Fila]<>0 y Com2L.Precio2[Fila]<>0;Fila;Cuenta3;    ;Fila+13000;'COMISIONES2'

