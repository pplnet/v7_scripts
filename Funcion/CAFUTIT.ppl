VTXT5            : 'Cta $/U$S'      ;6;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),SQLSet("Select Codigo from "~DBO~".CUENTAS where Cliente='"~IF(EqStr(MERCADO2,VAR('MERCARGC')),VAR('CLIARGC'),CLIENTE1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and  "~IF(NOT INCLUIDO(MERCADO2,VAR('MERCARGC'))," Mercado='"~MERCADO2~"' "," Mercado IN ('BCRA','AC','SWIFT') ")~" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
VCAN2            : 'Cant.    '      ;7;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(NoVacio(VTXT5),Elementos(VTXT5),0));
VTxt6            : 'Ctas/Saldos'    ;4;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~IF(EqStr(MERCADO3,VAR('MERCARGC')),VEHICULO1,CLIENTE1)~"' AND (Especies='"~ESPECIE~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') AND Mercado='"~MERCADO3~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")) ;
