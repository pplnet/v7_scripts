MB3              : '|Sin Garantia|Con Garantia';9;2;3;;NO;;;;0


PorCaucion       : 'RiskWeighting'  ; 5;2;2;NO;NO  ;;;;;IF(NoVacio(BOOK1),Query("Select Factor from "~DBO~".RISKWEIGHT where Especie = 'USD' and TipoOp = '"~TIPOOP~"' and Fecha <= '"~IdxDate(FECHAOP)~"' order by Fecha desc"))
TotalAux5        : 'PreSettlement'  ;15;2;2;NO;SI  ;;;;;IF(NoVacio(BOOK1),CANTIDAD * if(PORCAUCION=0,1,PORCAUCION/100));;;;;'###,###,###,###.######'
VCAN7            : 'Asignado'       ;12;2;2;NO;SI  ;;;;;IF(NoVacio(BOOK1),LimAsignado(CLIENTE1,'PRESETTLEM',ESPECIE,VEHICULO1));;;;;'###,###,###,###.######'
VCAN8            : 'Consumido'      ;13;2;2;NO;SI  ;;;;;IF(NoVacio(BOOK1),LimConsumido(CLIENTE1,'PRESETTLEM',ESPECIE,0,VEHICULO1,,,NROPERACION));;;;;'###,###,###,###.######'
MinDerechoBolsa  : 'Ex.Pres.'       ;14;2;2;NO;SI  ;;;;;IF(NoVacio(BOOK1),IF(Not[(LimAsignado(CLIENTE1,'PRESETTLEM',ESPECIE,VEHICULO1)-(LimConsumido(CLIENTE1,'PRESETTLEM',ESPECIE,0,VEHICULO1,,,NROPERACION) +TOTALAUX5))<0],0,(LimAsignado(CLIENTE1,'PRESETTLEM',ESPECIE,VEHICULO1)-(LimConsumido(CLIENTE1,'PRESETTLEM',ESPECIE,0,VEHICULO1,,,NROPERACION)+TOTALAUX5))));;;;;'###,###,###,###.######'

