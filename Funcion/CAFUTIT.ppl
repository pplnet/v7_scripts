FechaOp          : 'Fecha Op.'       ;2;2; ;;  ;FechaOp <= FSys y [[FinDeMes(FECHAOP)<>FinDeMes(FSys) y FECHAOP>= Habiles(FSys,-Var('FTVALOR'),'ARG')] o [FinDeMes(FECHAOP)=FinDeMes(FSys)]] y EsHabil(FECHAOP,'ARG');'Fecha Op. Incorrecta';NO;FSYS;
Especie          : 'Especie'         ;1;1;1;     ;  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie Valida';NO;;;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' ";
Cliente1         : 'Cliente'         ;2;1; ;  ;  ;NoVacio(CLIENTE1) y EsTerminal(CLIENTE1,Cliente);'Debe ser un Cliente Valido';NO;;;;;;;;" Status = 'HAB' ";
TotalBrutoCli3   : 'Cant.Contratos'  ;3;1; ;  ;  ;TOTALBRUTOCLI3>0 ;'Cant.Contratos debe ser Positivo';NO; ;
Cantidad         : 'V.N.'            ;4;1; ;NO;  ;CANTIDAD>0;'El Importe debe ser Positivo';NO; ;TOTALBRUTOCLI3 * BuscarCampo('ESPECIES','TamanioLote','Codigo',ESPECIE)
Precio1          : 'Precio Futuro'   ;5;1; ;  ;  ;PRECIO1>0 ;'El Tipo de Cambio debe ser Positivo'    ;NO;0;IF(NoVacio(ESPECIE) Y TIPOCAMBIO3>0,1000/(TIPOCAMBIO3*BuscarCampo('ESPECIES','Valor2','Codigo',ESPECIE)/365+1),TOTALBRUTOCLI1/CANTIDAD)
TotalBrutoCli1   : 'Monto'           ;6;1; ;NO;  ;;;;;PRECIO1*CANTIDAD;
ContraEspecie    : 'Mon. Pago'       ;1;2; ;  ;  ;NoVacio(CONTRAESPECIE);'Debe ingresar la Moneda de Pago';NO;;CotizaEn(ESPECIE)
Plazo            : 'Plazo'           ;3;2; ;  ;  ;PLAZO>0;'Plazo invalido';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP
FechaVto         : 'Fecha Vto.'      ;4;2; ;  ;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1) y [IF(Eqstr(BuscarCampo('MERCADOS','Regulado','Codigo', MERCADO), 'SI'),Query("Select 1 From "~DBO~".PLAZOSMERCADO Where MercadoNegociacion = '"~MERCADO~"' and FechaVto = '"~IdxDate(FECHAVTO)~"' and Especie = '"~ESPECIE~"' ")=1,1=1)];'FechaVto No es un Dia Habil o no existe el plazo';NO;FECHAOP;FECHAOP+PLAZO;
FechaPago        : 'F.Liq.Mon.Pago'  ;5;2; ;NO;NO;EsHabil(FECHAPAGO,TABLAFERIADOS1);'FechaPago No es un Dia Habil';NO;Habiles(FECHAVTO,0,TABLAFERIADOS1);Habiles(FECHAVTO,0,TABLAFERIADOS1)
TipoCambio3      : 'Tasa Nom. Anual' ;7;1; ;  ;NO;TIPOCAMBIO3>0;'La Tasa Nominal Anual debe ser positiva';NO;;IF(Eqstr(Copy(ESPECIE,1,2),'LE'),IF(NoVacio(ESPECIE) Y PRECIO1>0,(1000/PRECIO1-1)*365/Num(BuscarCampo('ESPECIES','Valor2','Codigo',ESPECIE)),0),0)

RB10             : 'Tipo Fut|Delivery|Non-Delivery' ;6;2;;Not EV;;;;;1;
Especie1         : 'Subyacente'                   ;8;1;;Not EV Y RB10=0;RB10=0;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Subyacente Valida';NO;;;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' ";
FormaLiquidacion1: 'Liquidacion|FD&&P|DVP|RVP'    ;7;2;;Not EV y Eqstr(RB10,'0');Eqstr(RB10,'0') Y INCLUIDO(MERCADO3,VAR('MERCADOCV'));;;;0; IF(Incluido(MERCADO3,VAR('MERCAVARI')),IF(MODI O EV,FORMALIQUIDACION1,0),0);
FormaLiquidacion2: 'Liquidacion|STD|DVP|FOP'      ;7;2;;Not EV y NOT INCLUIDO(MERCADO3,VAR('MERCAACMC')) y Vacio(NRORDEN1);Incluido(MERCADO3,VAR('MERCAVARI'));EV o NOT Incluido(MERCADO3,VAR('MERCAVARI')) O FORMALIQUIDACION2>0;'Liquidacion no puede ser FD&&P';NO;IF(Incluido(MERCADO3,VAR('MERCAVARI')),1,0);IF(Incluido(MERCADO3,VAR('MERCAVARI')),IF(MODI O EV,FORMALIQUIDACION2,1),0);
Mercado3         : 'M. Liq. Esp.'                 ;8;2;;Not EV Y RB10=0;RB10=0;RB10<> 0 O [NOVACIO(MERCADO3) y Incluido('T',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO3))];'Debe ingresar Mercado de Titulos';NO;MercadoDef(ESPECIE);MercadoDef(ESPECIE);;;;;;" TipoNegocio Like '%T%' and TipoNegocio not Like '%F%' "

FechaVto2        : 'F.Valuacion'                  ;7;2;;Not EV Y RB10=1;RB10=1;RB10=0 o [RB10=1 y ESHABIL(FECHAVTO2,TABLAFERIADOS1) Y FECHAVTO2<=FECHAVTO];'Fecha de Valuacion Invalida';NO; HABILES(FECHAPAGO,-2, TABLAFERIADOS1,SI) ; HABILES(FECHAPAGO,-2, TABLAFERIADOS1,SI)

Plazo2           : 'PlazoLiq.'                    ;9;2;;NO;NO;;;;;IF(RB5=0,0,IF(RB5=1,1,2))
RB5              : 'PlazoLiq.|'~VAR('PLAZOLIQ')   ;9;2;;;RB10=0;;;;0;IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'0'),0,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'24'),1,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'48'),2)))
FechaPrecan      : 'FechaLiq.'                    ;10;2;;;RB10=0;RB10 > 0 o EsHabil(FECHAPRECAN,TABLAFERIADOS1) Y FECHAPRECAN>=FECHAVTO;'Fecha de Liquidacion Invalida';NO; HABILES(FECHAVTO,(PLAZO2 DIV 24),TABLAFERIADOS1,SI);HABILES(FECHAVTO,(PLAZO2 DIV 24),TABLAFERIADOS1,SI)

MB4              : 'Liquida MTM|No Aplica|Liquida|No Liquida' ;11;2;;Not EV Y Eqstr(BuscarCampo('MERCADOS','Regulado','Codigo', Mercado), 'NO');;;;;;BuscarCampo('MERCADOS','MTM','Codigo',MERCADO);
MB1              : 'Frec.Liq.|Diario|Mensual|Vto'             ;12;2;;Not EV Y Eqstr(BuscarCampo('MERCADOS','Regulado','Codigo', Mercado), 'NO');;;;;0;

MB2              : 'TipoNeg.|OCT|Otro'    ;6;2;;NO;NO;;;;0;

Mercado          : 'M. Negociac.'   ; 9;1; ;  ;;NOVACIO(MERCADO) y Incluido('FT',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO));'Debe ingresar Mercado de Futuro de Titulos';NO;VAR('MENEFTI');;;;;;;"TipoNegocio Like '%FT%' "
Mercado2         : 'M. Liq. Mon.'   ;10;1; ;  ;;Incluido('M',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO2));'Debe ingresar un Mercado de Moneda';NO;MercadoDef(CONTRAESPECIE);MercadoDef(CONTRAESPECIE);;;;;;"TipoNegocio Like '%M%' "
TablaFeriados1   : 'Feriados'       ;13;2; ;NO;;NoVacio(TABLAFERIADOS1);'No esta cargada la Tabla de feriados para ARG';NO;'ARG';

TipoCambio       : 'Precio Mayorista' ;13;1; ;NO;  ;;;;;Query(" Select TOP 1 Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~ESPECIE~"' and Moneda = '"~CONTRAESPECIE~"' and Mercado = '"~MERCADO~"' and Fecha <= '"~IdxDate(FECHAOP)~"' and FechaFut = '"~IdxDate(FECHAVTO)~"' and CallPut='FUT' Order by Fecha desc ")
TipoCambio2      : 'Precio Mercado'   ;14;1; ;  ;  ;TIPOCAMBIO2<=TIPOCAMBIO*(1+VAR('RENTABILID')/100) Y TIPOCAMBIO2>=TIPOCAMBIO*(1-VAR('RENTABILID')/100);'El Precio Mercado de estar dentro del Rango: '~FSTR((TIPOCAMBIO*(1-VAR('RENTABILID')/100)),1,7)~' y '~FSTR((TIPOCAMBIO*(1+VAR('RENTABILID')/100)),1,7);NO;;TIPOCAMBIO

Cuenta4          : 'Cta.Mon.CLI:'   ;15;1; ;Not EV;      ;;;;;IF(RB10=0,IF(NoVacio(BOOK1),IF(1<=VCAN2,ItemLista(VTXT5,1),VAR('CTAMOD23'))));;;;;;"Cliente = '"~IF(EqStr(MERCADO2,VAR('MERCARGC')),VAR('CLIARGC'),CLIENTE1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO2~"' ";;
Cuenta3          : 'Cta.Mon.VEH:'   ;15;2; ;Not EV;      ;;;;;IF(RB10=0,IF(NoVacio(BOOK1),IF(EQSTR(MERCADO2,VAR('MERCARGC')),CUENTA4,QUERY("Select Top(1) Codigo from "~DBO~".CUENTAS where Cliente='"~VEHICULO1~"' and (Especies Like '%"~CONTRAESPECIE~"|%' OR Especies LIKE '%MONEDA%') AND Estado='HAB' AND TipoCuenta In ('CC','CA','CUS') AND Mercado='"~MERCADO2~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))));;;;;;"Cliente='"~VEHICULO1~"' and (Especies Like '%"~CONTRAESPECIE~"|%' OR Especies LIKE '%MONEDA%') AND Estado='HAB' AND TipoCuenta In ('CC','CA','CUS') AND Mercado='"~MERCADO2~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%')"
Cuenta1          : 'Cta.Esp.CLI:'   ;16;1; ;      ;RB10=0;;;;;IF(RB10=0,IF(NoVacio(BOOK1),IF(1<=VCAN4,ItemLista(VTXT6,1),'')),'');;;;;;"Estado = 'HAB' and Mercado='"~MERCADO3~"' and TipoCuenta In ('CUS', 'CCO') and Cliente='"~IF(EqStr(MERCADO3,VAR('MERCARGC')),VEHICULO1,CLIENTE1)~"'  ";;
Cuenta2          : 'Cta.Esp.VEH:'   ;16;2; ;      ;RB10=0;;;;;IF(RB10=0,IF(NoVacio(BOOK1),if(EQSTR(MERCADO ,VAR('MERCARGC')),CUENTA1,QUERY("Select Top(1) Codigo from "~DBO~".CUENTAS where Cliente='"~VEHICULO1~"' and (Especies Like '%"~ESPECIE~"|%'       OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO')    AND Mercado='"~MERCADO3~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))));;;;;;"Cliente='"~VEHICULO1~"' and (Especies Like '%"~ESPECIE~"|%'       OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO')    AND Mercado='"~MERCADO3~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%')"

Operador         : 'Operador'       ; 1;1;2;NO   ;  ;;;;USUARIOACTIVO;
