PorDerechoBolsa  : 'C.CEsp CotizaEn';2;2;2;NO;SI;;;;;IF(Eqstr(ContraEspecie, BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE)), 1, CotizacionC(ContraEspecie,,,,FechaOp,1,SI,BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE)));;;;;'###,###.########'
