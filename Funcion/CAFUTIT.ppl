Cliente3  : 'Controlante'     ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' "))
VTXT15    : 'Ascendientes'    ;11;2;2;NO;NO;;;;"("~Pipe2Comillas(Ascendientes('ESPECIES',ESPECIE))~")";"("~Pipe2Comillas(Ascendientes('ESPECIES',ESPECIE))~")"
VCAN3     : '% PRESSET'       ;12;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1,0,QUERY("Select Factor from "~DBO~".RISKWEIGHT where Especie='"~ESPECIE~"' or Especie In  "~VTXT15~" Order By Fecha Desc") / 100));;;;;'###,###.######'
VCAN5     : '% PRESSET'       ;13;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1,0,IF(VCAN3=0,BuscarCampo('TiposNegocio','PorPreset','Codigo', BuscarCampo('TIPOSOPERACION','TipoNegocio','Codigo',TIPOOP))/100,VCAN3)) );;;;;'###,###.######'
VCAN9     : 'Monto PRESSET'   ;14;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),TOTALNETOCLI3*VCAN5);;;;;'###,###,###,###.######'


