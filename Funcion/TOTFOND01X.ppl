act(a:val(cd3)+val(cf1)+9,'Total Entidad '~VAR('MONEEXTR'))
act(a:val(cd3)+val(cf1)+10,'Lim. Asignado '~VAR('MONEEXTR'))
act(a:val(cd3)+val(cf1)+11,'Disponible '~VAR('MONEEXTR'))
SetFont(a:val(cd3)+val(cf1)+9..a:val(cd3)+val(cf1)+11,3)
AgregarMarco(a:val(cd3)+val(cf1)+9..a:val(cd3)+val(cf1)+11,2,0,Exe('COLOR6'))

acn(cj1,3)
Recorrer&j 1, val(ci1)
  acn(val(cj1):val(cd3)+val(cf1)+9, LimConsumido(val(val(cj1)-1:val(cd1)),'COTOR',VAR('MONEEXTR'),0,,,,,Dialogo.Fecha1) )
  acn(val(cj1):val(cd3)+val(cf1)+10,LimAsignado(val(val(cj1)-1:val(cd1)),'COTOR',VAR('MONEEXTR')))
  acn(val(cj1):val(cd3)+val(cf1)+11,val(val(cj1):val(cd3)+val(cf1)+10)-val(val(cj1):val(cd3)+val(cf1)+9))
  SetFont(val(cj1):val(cd3)+val(cf1)+9..val(cj1):val(cd3)+val(cf1)+11,3)
  FormatoCeldas(val(cj1):val(cd3)+val(cf1)+11..val(cj1):val(cd3)+val(cf1)+11,Exe('F2'))
  AgregarMarco(val(cj1)-1:val(cd3)+val(cf1)+9..val(cj1):val(cd3)+val(cf1)+11,2,0)
  scn(cj1,2)
Proximo
