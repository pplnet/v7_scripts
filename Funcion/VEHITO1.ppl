Vehiculo1     : 'Vehiculo'         ; 1;2; ;NOT EV y EqStr(ABM,'A') Y Not Incluido(TIPOOP, 'MMPRCO|MMPREC');;NOVACIO(VEHICULO1) Y  Incluido(VEHICULO1,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo1~"' and Status ='HAB' ")) y [Vacio(UsrVehiculos(UsuarioActivo)) o Incluido(VEHICULO1,SqlSet("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))];'El VEHICULO es INVALIDO';NO;;IF(Incluido(TIPOOP, 'MMPRCO|MMPREC'), BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion', NROPERACION5));;If(Vacio(UsrVehiculos(UsuarioActivo)),SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Status ='HAB' "),SqlSet("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"));NO
Book1         : 'Book'             ; 2;2; ;Not Incluido(TIPOOP, 'MMPRCO|MMPREC');;BookValido(BOOK1, TIPOOP, ESPECIE, VEHICULO1, OPERADOR,'') y NoVacio(BOOK1);'El Book seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo';NO;;IF(Incluido(TIPOOP, 'MMPRCO|MMPREC'), BuscarCampo('OPERACIONES','Book1','NrOperacion', NROPERACION5))    ;;;;;;" Vehiculo='"~VEHICULO1~"' AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
PrecioRef     : 'Ref_Val'          ;15;2;2;;;NOVACIO(PRECIOREF);'Indique Precio de Referencia';NO;VAR('TASADEFA');
PrecioRef4    : 'Ref_Val_Cont'     ;16;2;2;INCLUIDO(COPY(TIPOOP,1,2),'FX|DT');INCLUIDO(COPY(TIPOOP,1,2),'FX|DT');NOT INCLUIDO(COPY(TIPOOP,1,2),'FX|DT') O NOVACIO(PRECIOREF4);'Indique Precio de Referencia para la ContraEspecie';NO;
