SCN(fl:2, 3)
SetFilaActual(Val(fl:2))

If Val(cz:2) = 0
   ACT(b:fac, "Cuadro 1 - Resumen de Operaciones en $")
EndIf
If Val(cz:2) = 1
   ACT(b:fac, "Cuadro 2 - Resumen de Operaciones en u$s")
EndIf

If Val(cz:2) = 2
   ACT(b:fac, "Cuadro 3 - CONSOLIDADO expresado en "~IIF(Dialogo.Radio2=0, "Pesos", "Dolares") )
EndIf

If Val(cz:2) = 3
   ACT(b:fac, "          Cuadro 1a - Bancos en $" )
EndIf

If Val(cz:2) = 4
   ACT(A:fac, "          Cuadro 2a - Bancos moneda extranjera expresado en USD" )
EndIf

If Val(cz:2) = 5
   ACT(b:fac, "Cuadro 3a - Bancos consolidado expresado en "~IIF(Dialogo.Radio2=0, "Pesos", "Dolares") )
EndIf

SCN(fl:2,1)
SetFilaActual(Val(fl:2))
ACT(b:fac, "                           Conceptos")
AgregarMarco(a:fac-1..c:fac,2,0)
SetFont(a:fac-1..c:fac, 4)

*--> Fila en la que se setean las fechas
ACN(xx:2000, fac)

*--> Para acumular el total del cuadro
ACN(kk:2030, 1000)

*--> Cantidad de dias habiles a partir de la fecha dada
ACN(di:2000, 60)

*--> Calcula la fecha que cae al final de los dias seteados
ACD(aa:2000, Habiles(Dialogo.Fecha1, Val(di:2000), 'ARG', SI) ) 

*--> Busca el ultimo dia habil del mes del calculo anterior (aa:2000)
ACD(ab:2000, FinDeMes(Val(aa:2000), NO, 'ARG') )

*--> Cantidad de dias totales + vueltas extra para los meses
ACN(ac:2000, DifDias(Dialogo.Fecha1, Val(ab:2000)) +6)

*--> Bandera para la primera fecha posterior a la finalizacion del periodo de dias TOTALES. 
ACN(bb:2000, 0)

*--> Contador para los meses
ACN(cc:2000, 0)

ACN(tw:2000, 4)

RECORRER&i 3, Val(ac:2000)+2
   *--> Seteo de la cabecera con las fechas de los dias habiles
   (.'RCASHFFIL'.)
PROXIMO

ACN(cc:1990, Val(lm:2))
AgregarMarco(d:fac..Val(cc:1990):fac, 2, 2, Exe('COLOR'))
SetFont(d:fac..Val(cc:1990):fac, 2)
AlinearCeldas(Val(VT:1):Val(xx:2000)..Val(cc:1990):Val(xx:2000), 'C')

 