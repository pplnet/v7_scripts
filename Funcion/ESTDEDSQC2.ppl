***--->SECTOR COMISIONES FPD, FFC, CDO, CPI, CF, EF

SQL.Add(" Select CM.Tipo, CM.Cliente1 Banco, CM.Fecha1 FechaVto, CM.Importe1 Comision, CM.Importe2 IVA, CM.Importe3 WHT, (CM.Importe4 + CM.Importe2) TotPagar ")
SQL.Add(" From "~DBO~".COMISIONES2 CM ")
SQL.Add(" Where CM.NrOperacion = '"~Val(aa1)~"'" )
SQL.Add(" and Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' " )
SQL.Add(" Order By FechaVto " )

ACN(w1,0)
RECORRER SQL
   If Val(w1) = 0
      If NoVacio(Val(e:fac-1))
         ifa
      EndIf
      ACT(a:fac,'Comisiones')
      SetFont(a:fac, 2)
      ifa
      acn(w1,1)
   EndIf
   If NoVacio(FBN['Tipo'])
      ACT(b:fac, ItemLista(Var('TCOMISION'), fbn('Tipo')+1))
   Endif

   ACT(c:fac, FBN['Banco'])
   ACD(g:fac, FBN['FechaVto'])
   ACN(L:fac, FBN['Comision'])
   ACN(M:fac, FBN['IVA'])
   ACN(N:fac, FBN['WHT'])
   ACN(P:fac, FBN['TotPagar'])
   
   *--->Acumula los datos de la operacion
   ACN(bb3, Val(bb3) + FBN['Comision']) 
   ACN(bb4, Val(bb4) + FBN['IVA']) 
   ACN(bb5, Val(bb5) + FBN['WHT'])
   ACN(bb6, Val(bb6) + FBN['TotPagar'])
   SetFont(a:fac..Q:fac, 1)
PROXIMO

***--->SECTOR COMISIONES CEN Y CEC

SQL.Add(" Select O.Cliente1 Banco, O.FechaVto2 FechaCEC, NULL FechaCEN, O.ImpComCor1 ComisionCEC, NULL ComisionCEN, 0 IVACEN, O.ImpComCor1 TotalCEC, NULL TotalCEN ")
SQL.Add(" From "~DBO~".OPERACIONES O ")
SQL.Add(" Where O.NrOperacion = '"~Val(aa1)~"' ")
SQL.Add(" and O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.Add(" and O.TipoOp = 'MMPCL' ")

SQL.Add(" Union All ")

SQL.Add(" Select O.Cliente1 Banco, O.FechaVto2 FechaCEC, O.FechaPrecan FechaCEN, O.PorComMer1 ComisionCEC, O.ImpComCorEq2 ComisionCEN, O.TotalGastos IVACEN, O.PorComMer1 TotalCEC, (O.ImpComCorEq2 + O.TotalGastos) TotalCEN ")
SQL.Add(" From "~DBO~".OPERACIONES O ")
SQL.Add(" Where O.NrOperacion = '"~Val(aa1)~"' ")
SQL.Add(" and ((O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.Add("     or (O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.Add(" and O.TipoOp in ('MMPE','MMPI','MMPCOS') ")

SQL.Add(" Union All ")

SQL.Add(" Select O.Cliente1 Banco, NULL FechaCEC, C.Fecha2 FechaCEN, NULL ComisionCEC, C.Cantidad6 ComisionCEN,  C.Tasa3 IVACEN, NULL TotalCEC, (C.Cantidad6 + C.Tasa3) TotalCEN ")
SQL.Add(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C  ")
SQL.Add(" Where O.NrOperacion = '"~Val(aa1)~"' ")
SQL.Add(" and O.NrOperacion = C.NrOperacion ")
SQL.Add(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.Add(" and O.TipoOp = 'MMPOSM' ")

SQL.Add(" Union All ")

SQL.Add(" Select O.Cliente1 Banco, C.Fecha2 FechaCEC, C.Fecha2 FechaCEN, C.Cantidad6 ComisionCEC, C.Plazo4 ComisionCEN, C.Tasa3 IVACEN, C.Cantidad6 TotalCEC, (C.Plazo4 + C.Tasa3) TotalCEN ")
SQL.Add(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.Add(" Where O.NrOperacion = '"~Val(aa1)~"' ")
SQL.Add(" and O.NrOperacion = C.NrOperacion ")
SQL.Add(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.Add(" and O.TipoOp in ('MMPCLM','MMPEM','MMPIM') ")

SQL.Add(" Order By FechaCEN ")

RECORRER SQL
   If FBN['TotalCEN'] > 0 O FBN['TotalCEC'] > 0
      If Val(w1) = 0
         If NoVacio(Val(e:fac-1))
            ifa
         EndIf
         ACT(a:fac,'Comisiones')
         SetFont(a:fac, 2)
         ifa
         acn(w1,1)
      EndIf

      If FBN['TotalCEC'] <> 0 Y NoVacio(FBN['TotalCEC'])
         ACT(b:fac, 'CEC')
         ACT(c:fac, FBN['Banco'])
         ACD(g:fac, FBN['FechaCEC'])
         ACN(L:fac, FBN['ComisionCEC'])
         ACN(M:fac, 0)
         ACN(N:fac, 0)
         ACN(P:fac, FBN['TotalCEC'])

         *--->Acumula los datos de la operacion
         ACN(bb3, Val(bb3) + FBN['ComisionCEC']) 
         ACN(bb6, Val(bb6) + FBN['TotalCEC'])
      EndIf

      If FBN['TotalCEN'] <> 0 Y NoVacio(FBN['TotalCEN']) 
         ACT(b:fac, 'CEN')
         ACT(c:fac, FBN['Banco'])
         ACD(g:fac, FBN['FechaCEN'])
         ACN(L:fac, FBN['ComisionCEN'])
         If NoVacio(FBN['IVACEN'])
            ACN(M:fac, FBN['IVACEN'])
         Else
            ACN(M:fac, 0)
         EndIf
         ACN(N:fac, 0)
         ACN(P:fac, FBN['TotalCEN'])
      
         *--->Acumula los datos de la operacion
         ACN(bb3, Val(bb3) + FBN['ComisionCEN']) 
         ACN(bb4, Val(bb4) + FBN['IVACEN']) 
         ACN(bb6, Val(bb6) + FBN['TotalCEN'])
      EndIf
   Else
      SetFilaActual(fac-1)
   EndIf   
   SetFont(a:fac..Q:fac, 1)   
PROXIMO


if Val(w1) = 1
   ifa
EndIf