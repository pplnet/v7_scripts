ACN(BD:2, 0)
SQL.ADD(" Select Condicion, ICOrigen, ICInstante, ICSubInstante, ICConcepto ")
SQL.ADD(" From "~DBO~".ICRELACIONES Where ConceptoFPA Like '%"~Trim(Val(LY:1))~"%' ")
IF [Not Eqstr(Val(CQ:1), 'COMISI')] O [CeldaVacia(CQ:1)]
    SQL.ADD(" AND TipoOp = '"~Val(TO:1)~"' ")
    ACN(CM:2, 0)
ELSE
    SQL.ADD(" AND TipoOp Is Null ")
    ACN(CM:2, 1)
ENDIF
Recorrer SQL
    Message('***---Determino Origen, Instante, SubInstante y Concepto')
    ACT(CD:1, fbn('Condicion'))
    IF Val(CM:2) = 0
        Message('***---Operacion')
        IF Incluido(Val(TO:1), 'DTSFF|DTSFFM|DTSFV|DTSFVM|DTSVV|DTSVVM')
            ACT(FF:1, Var('FECHAMIGRA'))
            ACT(NR:1, SQL(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOperacion = '"~Val(NP:1)~"' "~Val(CD:1)~" '"~IdxDate(Fecha(Val(FF:1)))~"' "))
        ELSE
            IF Not Incluido(Val(TO:1), 'CUPON')
                ***---Para cupon conozco el origen, por lo que solo busco los otros datos
                ACT(FF:1, '')
                ACT(NR:1, SQL(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOperacion = '"~Val(NP:1)~"' "~Val(CD:1)~" "))
            ENDIF
        ENDIF
    ELSE
        Message('***---Comisiones')
        IF Val(BD:3) = 0
            Message('***---Monto Comision')
            ACT(FF:1, Dialogo.Fecha1)
            ACT(NR:1, SQL(" Select O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C Where O.NrOperacion = C.NrOperacion AND O.NrOperacion = '"~Val(NP:1)~"' "~Val(CD:1)~" '"~IdxDate(Fecha(Val(FF:1)))~"' "))
        ELSE
            ACT(FF:1, '')
            ACT(NR:1, SQL(" Select O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C Where O.NrOperacion = C.NrOperacion AND O.NrOperacion = '"~Val(NP:1)~"' "~Val(CD:1)~" "))
        ENDIF
    ENDIF
    IF [Incluido(Val(TO:1), 'CUPON') Y Eqstr(Val(TO:3), fbn('ICOrigen'))] O [Not Incluido(Val(TO:1), 'CUPON') Y Eqstr(Val(NP:1), Val(NR:1))]
        Message('***---Esta es la relacion buscada')
        ACT(OG:1, Lpad(fbn('ICOrigen'), 3))
        ACT(IT:1, Lpad(fbn('ICInstante'), 2))
        ACT(SS:1, Lpad(fbn('ICSubInstante'), 2))
        ACT(CP:1, Pad(Copy(BuscarCampo('ICCONCEPTOS','Descripcion','Codigo', fbn('ICConcepto')), 1, 25), 25))
        ACN(BD:2, 1)
        Break
    ELSE
        Message('***---No se encuentra relacion buscada')
        ACT(OG:1, '999')
        ACT(IT:1, '99')
        ACT(SS:1, '99')
        ACT(CP:1, Pad('', 25))
    ENDIF
    ACN(BD:2, 1)
Proximo
IF Val(BD:2) = 0
    Message('***---No encontro la relacion para el TipoOp')
    ACT(OG:1, '999')
    ACT(IT:1, '99')
    ACT(SS:1, '99')
    ACT(CP:1, Pad('', 25))
ENDIF
