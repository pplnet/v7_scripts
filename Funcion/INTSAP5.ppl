***Segmento (nombre externo)***
ACT(li:1,PAD('E2FINBU006',30))
***Mandante***
ACT(li:1,Val(li:1)~PAD('',3))
***Número del IDOC***
ACT(li:1,Val(li:1)~PAD('',16))
***Número de segmento***
ACT(li:1,Val(li:1)~PAD0(Fstr(Val(co:1),0,0),6))
***Número del segmento padre superior***
ACT(li:1,Val(li:1)~'000002')
***Nivel de jerarquía de segmento SAP***
ACT(li:1,Val(li:1)~'03')
***Indicador de operación en cuenta de mayor especial***
ACT(li:1,Val(li:1)~PAD('',1))
***Importe del impuesto en moneda local***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe del impuesto en moneda del documento***
ACT(li:1,Val(li:1)~PAD('',15))
***Nº de cliente 1***
If EqStr(fbn('Libro'),'AR')
  ***Si el número de cliente es numérico, informar con ceros a izquierda. Si es alfanumérico (por ejemplo "G105" o "CITI") alineado a izquierda sin blancos ni ceros.
  ACT(cl:1,Copy(BuscarCampo('CLIENTES','Alias1','Codigo',fbn('Alias2')),1,10))
  ACT(li:1,Val(li:1)~IIF(EsNumero(VAL(cl:1)),PAD0(Val(cl:1),10),Pad(Val(cl:1),10)))
Else
  ACT(li:1,Val(li:1)~PAD('',10))
Endif
***Número de cuenta de la subsidiaria***
ACT(li:1,Val(li:1)~PAD('',10))
***Fecha base para cálculo del vencimiento***
ACT(li:1,Val(li:1)~FStr(Anio(fbn('FechaValor')),0,0)~Pad0(FStr(Mes(fbn('FechaValor')),0,0),2)~Pad0(FStr(Dia(fbn('FechaValor')),0,0),2))
***---ZTERM - Clave de condiciones de pago***
ACT(li:1,Val(li:1)~PAD('Z000',4))
***Días del descuento por pronto pago 1***
ACT(li:1,Val(li:1)~PAD('',5))
***Días del descuento por pronto pago 2***
ACT(li:1,Val(li:1)~PAD('',5))
***Plazo para condición de pago neto***
ACT(li:1,Val(li:1)~PAD('',5))
***Porcentaje de descuento por pronto pago 1***
ACT(li:1,Val(li:1)~PAD('',7))
***Porcentaje de descuento por pronto pago 2***
ACT(li:1,Val(li:1)~PAD('',7))
***Importe con derecho a descuento en moneda del documento***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe del descuento en moneda local***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe del descuento en moneda del documento***
ACT(li:1,Val(li:1)~PAD('',15))
***Vía de pago***
ACT(li:1,Val(li:1)~PAD(fbn('Alias8'),1))
***Clave para bloqueo de pago***
ACT(li:1,Val(li:1)~PAD('',1))
***Suplemento para la vía de pago***
ACT(li:1,Val(li:1)~PAD('',2))
***---HBKID: Clave breve para banco propio***
ACT(li:1,Val(li:1)~PAD(fbn('Alias9'),5))
***Tipo de banco interlocutor***
ACT(li:1,Val(li:1)~PAD('',4))
***Número documento de factura a la que pertenece la operación***
ACT(li:1,Val(li:1)~PAD('',10))
***Ejercicio de la factura correspondiente (para abonos)***
ACT(li:1,Val(li:1)~PAD('',4))
***Posición en la factura correspondiente***
ACT(li:1,Val(li:1)~PAD('',3))
***Clase documento subsiguiente***
ACT(li:1,Val(li:1)~PAD('',1))
***Indicador del banco central regional***
ACT(li:1,Val(li:1)~PAD('',3))
***País proveedor***
ACT(li:1,Val(li:1)~PAD('',3))
***Indicador de prestación de servicios (pagos al extranjero)***
ACT(li:1,Val(li:1)~PAD('',1))
***Indicador de seguro***
ACT(li:1,Val(li:1)~PAD('',1))
***Fecha de seguro***
ACT(li:1,Val(li:1)~PAD('',8))
***Clave de reclamación***
ACT(li:1,Val(li:1)~PAD('',1))
***Bloqueo de reclamación***
ACT(li:1,Val(li:1)~PAD('',1))
***Área de reclamación***
ACT(li:1,Val(li:1)~PAD('',2))
***Fecha de la última reclamación***
ACT(li:1,Val(li:1)~PAD('',8))
***Nivel de reclamación***
ACT(li:1,Val(li:1)~PAD('',1))
***Indicador de retención***
ACT(li:1,Val(li:1)~PAD('',2))
***Importe base para retención***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe exento de retención (en moneda del documento)***
ACT(li:1,Val(li:1)~PAD('',15))
***---LIFNR: Número de cuenta del proveedor o acreedor***
If EqStr(fbn('Libro'),'AP')
  ***Si el número de cliente es numérico, informar con ceros a izquierda. Si es alfanumérico (por ejemplo "G105" o "CITI") alineado a izquierda sin blancos ni ceros.
  ACT(cl:2,Copy(BuscarCampo('CLIENTES','Alias2','Codigo',fbn('Alias2')),1,10))
  ACT(li:1,Val(li:1)~IIF(EsNumero(VAL(cl:2)),PAD0(Val(cl:2),10),Pad(Val(cl:2),10)))
Else
  ACT(li:1,Val(li:1)~PAD('',10))
Endif
***Nº de usuario ESR***
ACT(li:1,Val(li:1)~PAD('',11))
***Nº de referencia ESR***
ACT(li:1,Val(li:1)~PAD('',27))
***Dígito de control ESR***
ACT(li:1,Val(li:1)~PAD('',2))
***Condición de pago fija***
ACT(li:1,Val(li:1)~PAD('',1))
***Referencia de pago***
ACT(li:1,Val(li:1)~PAD('',30))
***Receptor del pago/Pagador***
ACT(li:1,Val(li:1)~PAD('',10))
***Importe de descuento en moneda local 2***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe de descuento en moneda local 3***
ACT(li:1,Val(li:1)~PAD('',15))
***Importe para el pago automático***
ACT(li:1,Val(li:1)~PAD('',5))
***Importe en moneda de pago***
ACT(li:1,Val(li:1)~PAD('',15))
***Área de control de créditos***
ACT(li:1,Val(li:1)~PAD('',4))
***Gestión de créditos: importe asegurado***
ACT(li:1,Val(li:1)~PAD('',15))
***Indicador CME de destino***
ACT(li:1,Val(li:1)~PAD('',1))
***Indicador cesión créditos***
ACT(li:1,Val(li:1)~PAD('',2))
***Instrucción 1***
ACT(li:1,Val(li:1)~PAD('',2))
***Instrucción 2***
ACT(li:1,Val(li:1)~PAD('',2))
***Instrucción 3***
ACT(li:1,Val(li:1)~PAD('',2))
***Instrucción 4***
ACT(li:1,Val(li:1)~PAD('',2))
***Operación de referencia***
ACT(li:1,Val(li:1)~PAD('',5))
***Ref.factura: número de documento de ref.para ref.factura***
ACT(li:1,Val(li:1)~PAD('',10))
***Referencia a factura: organizaciones de refer.para ref.fact.***
ACT(li:1,Val(li:1)~PAD('',10))
***Campo de texto long.50***
ACT(li:1,Val(li:1)~PAD('',50))