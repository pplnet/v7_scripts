* ESTA FUNCION NUEVA CONTROLA EL SALDO CUENTA POR CUENTA
* 20/12/04

*- Controla el saldo de cartera propia para Extrabursatil
*- y para Bursatil en caso de ser Cliente=SUDAMERIS y Cuenta=PROPIA 


If Dialogo.Radio2=0 o Dialogo.Radio2=3
   * --------------------- Arma Lista de Cuentas ----------------------- *
   Recorrer&i 4, Val(b1)  
      If Val(k:&i)=1 y DesciendeDeEspecie(Val(d:&i),'TITULO') 
         If Dialogo.Radio2=0
            * Extra
            If NOT Incluido(Val(j:&i),Val(lc:1))
               ACT(lc:1, Val(lc:1)~Val(j:&i)~'|')
            Endif
         Else
            If Dialogo.Radio2=3 y EqStr(Dialogo.Vehiculo1,val(b:&i)) y EqStr(VAR('CTAEXT'),val(v:&i))
               * Bolsa
               If BuscarLista(Val(v:&i),Val(lc:1))<>0
                  ACT(lc:1, Val(lc:1)~Val(v:&i)~'|')
               Endif
            Endif
         Endif
      Endif
   proximo
   * ------------------------------------------------------------------ *

   * ---------- Recorre la lista de cuentas y verifica los salos 20/12/04 ------ *
* 21/12/04 - El control lo dejo afuera del recorrer para que no lo resetee con las distinats cuentas que pudiera haber en la lista
   ACT(at1, 'SI')

   Recorrer&k 1, Elementos(Val(lc:1))

   ACT(SA:5, ItemLista(Val(lc:1),&k))

   if Val(hs1) > 0
      BorrarCeldas(sa0..sg:Val(hs1))
   endif

   ACT(sd0, '')
*   ACT(at1, 'SI')


   Recorrer&i 4, Val(b1)  
      *** toma solo lo marcado si es extrabursatil o bursatil para Sudameris/Cartera Propia
      *** SUMA MOV A LIQUIDAR
      If Val(k:&i)=1 y [[Dialogo.Radio2=0 y Eqstr(Val(j:&i),ItemLista(Val(lc:1),&k)) ] o [Dialogo.Radio2=3 y EqStr(Dialogo.Vehiculo1,val(b:&i)) y EqStr(ItemLista(Val(lc:1),&k),val(v:&i))]]
         if DesciendeDeEspecie(Val(d:&i),'TITULO') 
            ACN(se0, BuscarLista(Val(d:&i)~'/'~Val(al:&i),Val(sd0)))    
            if Val(se0) = 0
               * en la variable sd0 pongo todos los mercados y especies
               ACT(sd0, Val(sd0)~Val(d:&i)~'/'~Val(al:&i)~'|')
               ACN(se0, BuscarLista(Val(d:&i)~'/'~Val(al:&i),Val(sd0)))
            endif

            * Coloco el Mercado
            ACT(se:Val(se0), Val(d:&i)~'/'~Val(al:&i))

            If Dialogo.Radio2=0
               SCN(sd:Val(se0), -Val(f:&i))
            Else
               SCN(sd:Val(se0), Val(f:&i))
            EndIf
         Endif
      Endif
   Proximo
   
   ACN(hs1, Elementos(Val(sd0)))

   Recorrer&i 1, Val(hs1)
      ACN(sa0, Posicion('/',ItemLista(Val(sd0),&i)))

      * Longitud
      ACN(sa1, Longitud(ItemLista(Val(sd0),&i)))

      * Especie
      ACT(sa2, COPY(ItemLista(Val(sd0),&i),1,Val(sa0)-1))
 
      * Mercado
      ACT(sa3, COPY(ItemLista(Val(sd0),&i),Val(sa0)+1,Val(sa1)-Longitud(Val(sa2))+1))

      * Cupon
      ACN(sa4, NrCupon2(Val(sa2),Dialogo.Fecha1))

      * Dependiendo del mercado, selecciono la cuenta propia
      * Si el mercado es 'CV'

IF NO
      If EqStr(Val(sa3), VAR('CLHODEFA'))
         ACT(sa5, VAR('CTAEXT'))
      Else
         SQL.ADD("SELECT Codigo FROM "~DBO~".CUENTAS ")
         SQL.ADD("WHERE Cliente = '"~VAR('VEHICULODE')~"' AND ")
         SQL.ADD("  Estado = 'HAB' AND ")
         SQL.ADD("  TipoCuenta = 'CUS' AND ")
         SQL.ADD("  Mercado = '"~Val(sa3)~"' ")
         Recorrer SQL
           ACT(sa5, FBN['Codigo'])
           break
         Proximo
      endif
ENDIF
      * Recupero el Sldo para la cta propia de un determ. mercado de una determ especie

*      ACN(sf:&i, SaldoC(VAR('VEHICULODE'),Val(sa2),,,,Val(sa3),VAR('VEHICULODE'),Val(sa5),Val(sl0),Dialogo.Fecha1,IIf(val(sa4)<>0,FStr(Val(sa4),0,0)) ) )
      ACN(sf:&i, SaldoC(Dialogo.Vehiculo1,Val(sa2),,,,Val(sa3),Dialogo.Vehiculo1,Val(sa5),Val(sl0),Dialogo.Fecha1,IIf(val(sa4)<>0,FStr(Val(sa4),0,0)) ) )

      Message('SaldoC: '~Val(sf:&i))
 
      * Movimientos de las operaciones de Compra/Venta Extrabursatil pendientes de liquidar 
      SQL.ADD("SELECT -SUM(M.Cantidad) Cant ")
      SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M  WITH (NOLOCK INDEX = INDME1),  "~DBO~".OPERACIONES O ")
      SQL.ADD("WHERE O.TipoOp IN ('TIC','TIFC','TIV','TIFV','TICT','TICO','TIDE','TIPO','TCOPRI','TCPCEM') AND ")
      SQL.ADD("      O.NrOperacion = M.NrOperacion AND ")
      SQL.ADD("      M.Especie     = '"~Val(sa2)~"' AND ")
      * Si es de CV tambien tomo los pendientes de ArgenClear
      if EqStr(Val(sa3), VAR('CLHODEFA'))
         SQL.ADD("      (M.Mercado = '"~Val(sa3)~"' or M.Mercado = 'AC') AND ")
      Else
         SQL.ADD("      M.Mercado = '"~Val(sa3)~"'  AND ")
      EndIf
*      SQL.ADD("      M.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
      SQL.ADD("      M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
      SQL.ADD("      M.NrSaldo = 31 ")
      Recorrer SQL
         dfa
         SCN(sf:&i, FBN['Cant'])
      Proximo

      * Movimientos de las operaciones de Compra/Venta Bursatil pendientes de liquidar       
      SQL.ADD("SELECT SUM(M.Cantidad) Cant ")
      SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M WITH (INDEX = INDME1), "~DBO~".OPERACIONES O ")
      SQL.ADD("WHERE O.TipoOp IN ('CTP','CTC','VTC','VTP') AND ")
      SQL.ADD("      O.NrOperacion = M.NrOperacion AND ")
      SQL.ADD("      M.Especie = '"~Val(sa2)~"' AND ")
      SQL.ADD("      M.Mercado = '"~Val(sa3)~"' AND ")
      SQL.ADD("      M.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
      SQL.ADD("      M.Cuenta  = '"~Val(sa:5)~"' AND ")
*      SQL.ADD("      M.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
      SQL.ADD("      M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
      SQL.ADD("      M.NrSaldo = 31 ")
      Recorrer SQL
         dfa
         SCN(sf:&i, FBN['Cant'])
      Proximo

      Message('Saldo : '~Val(sf:&i))

      * Movimientos pendientes no Matcheadas       
      SQL.ADD("SELECT SUM(M.Cantidad) Cant ")
      SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T  ")
      SQL.ADD("WHERE T.TipoTr2 IN ('DTP','RTP') AND ")
      SQL.ADD("      T.NrTrans = M.NrOperacion AND ")
      SQL.ADD("      M.Especie = '"~Val(sa2)~"' AND ")
      SQL.ADD("      M.Mercado = '"~Val(sa3)~"' AND ")
      SQL.ADD("      M.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
      SQL.ADD("      M.Cuenta  = '"~Val(sa:5)~"' AND ")
*      SQL.ADD("      M.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
      SQL.ADD("      M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
      SQL.ADD("      M.NrSaldo = 101 ")
      Recorrer SQL
         dfa
         SCN(sf:&i, FBN['Cant'])
      Proximo

      Message('Saldo : '~Val(sf:&i))

      if (Val(sf:&i) + Val(sd:&i)) < 0
         MessageBox("Se excede el saldo de cartera propia - Cuenta "~Val(sa:5)~" : "~Val(sa2)~" / "~Val(sa3)~" Sldo: "~FStr(Val(sf:&i),0,0)~" a Liq.: "~FStr(Val(sd:&i),0,0))
         ACT(at1, 'NO')
      endif
   proximo

   Proximo
   * este proximo es de la lista de cuentas - 20/12/04
   * ------------------------------------------------------------------ *
   * FO 13/10/2005 NO SE CONTROLAN SALDOS PARA dbo
   ACT(at1, 'SI')
else
   ACT(at1, 'SI')
endif
