SQL.ADD("SELECT E.Codigo, P1.NrSaldo-107 Cartera, 'ASALDOPOSIC' TipoOp, SUM(P1.CantidadFin) Cantidad, ")
SQL.ADD("       '' FechaVto, '0' NrOperacion, 0 PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, 0 Precio1 ")
SQL.ADD("FROM "~DBO~".POSICIONES P1, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE P1.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      P1.Especie = E.Codigo AND ")
SQL.ADD("      P1.NrSaldo IN ("~Pipe2Comillas(Val(cr2))~") AND ")
SQL.ADD("      P1.Fecha = (SELECT MAX(P2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                  WHERE P2.Cliente = P1.Cliente AND ")
SQL.ADD("                        P2.Especie = P1.Especie AND ")
SQL.ADD("                        P2.NrSaldo = P1.NrSaldo AND ")
SQL.ADD("                        P2.TipoNegocio = P1.TipoNegocio AND ")
SQL.ADD("                        P2.Sector = P1.Sector AND ")
IF Dialogo.Fecha1 > FSys
   SQL.ADD("                        P2.Fecha <= '"~IdxDate(FSys-1)~"') ")
ELSE
   SQL.ADD("                        P2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"') ")
ENDIF
SQL.ADD("GROUP BY P1.NrSaldo, E.Codigo, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT E.Codigo, T.RB4 Cartera, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, ")
SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, T.NrTrans NrOperacion, 0 PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, T.Precio1 ")
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B  ")
SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      T.Especie = E.Codigo AND ")
SQL.ADD("      Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      T.RB4 IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
SQL.ADD("      T.CB6 <> 1 ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT E.Codigo, O.Cartera, O.TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      O.Especie = E.Codigo AND ")
SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT E.Codigo, O.Cartera, O.TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      O.Especie = E.Codigo AND ")
SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT E.Codigo, O.Cartera, O.TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      O.Especie = E.Codigo AND ")
SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
SQL.ADD("      O.PaseCB = '1' ")

IF Dialogo.Fecha1 > FSys
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT E.Codigo, T.RB4 Cartera, 'BSALDOPOSIC'+T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, T.NrTrans NrOperacion, 0 PaseCB, ")
   SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, T.Precio1 ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   IF NoVacio(Dialogo.Lista1)
      SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
   ELSE
      SQL.ADD("      E.Status='HAB' AND ")
      SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
   ENDIF
   SQL.ADD("      T.Especie = E.Codigo AND ")
   SQL.ADD("      Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.RB4 IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
   SQL.ADD("      T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT E.Codigo, O.Cartera, 'BSALDOPOSIC'+O.TipoOp TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
   SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   IF NoVacio(Dialogo.Lista1)
      SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
   ELSE
      SQL.ADD("      E.Status='HAB' AND ")
      SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
   ENDIF
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
   SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT E.Codigo, O.Cartera, 'BSALDOPOSIC'+O.TipoOp TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
   SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   IF NoVacio(Dialogo.Lista1)
      SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
   ELSE
      SQL.ADD("      E.Status='HAB' AND ")
      SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
   ENDIF
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT E.Codigo, O.Cartera, 'BSALDOPOSIC'+O.TipoOp TipoOp, O.Cantidad, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
   SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   IF NoVacio(Dialogo.Lista1)
      SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
   ELSE
      SQL.ADD("      E.Status='HAB' AND ")
      SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
   ENDIF
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Cartera IN ("~Pipe2Comillas(Val(cr1))~") AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("      O.PaseCB = '1' ")
   SQL.ADD("ORDER BY 1, 2, 3 ")
ELSE
   SQL.ADD("ORDER BY 1, 2, 3 ")
ENDIF
