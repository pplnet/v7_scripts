** ALTAINSTER
** Inserta las Instancias dejandolas en Terminal
** z3: Debe estar el Nro. de La Operacion a ingresar
Message('Ingresando Instancias Operacion '~VAL(Z3)~' ...')

ACN(i1,50)

SQL.ADD("SELECT * FROM "~DBO~".INSTANCIAS ")
SQL.ADD(" Where Tabla = 'OPERACIONES' ")
SQL.ADD(" ORDER BY NrInstancia ")
Recorrer SQL
  DFA
  SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ( ")
  SQL.ADD(" NrOperacion, NrBit, Valor ")
  SQL.ADD(" ) Values ( ")
  SQL.ADD(" '"~Val(z3)~"', ")
  SQL.ADD(" "~Fstr(FBN['NrInstancia'],2,0)~", ")
  SQL.ADD(" '"~IIF(VAL(i1)=FBN['NrInstancia'],'1','0')~"' ")
  SQL.ADD(" ) ")
  SQL.NEW
  SQL.EXEC
Proximo
