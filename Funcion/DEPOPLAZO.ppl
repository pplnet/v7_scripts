****** COREN A - Depositos a Plazo ******
*Buscar si hay algun ajuste
ACN(v1,0)
SQL.ADD("Select Cantidad, Precio1, Precio2 from "~DBO~".OPERACIONES where ")
SQL.ADD("TipoOp = 'AJUCOR' and Vehiculo1= '"~fbn('Codigo')~"' ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and Especie = '"~Dialogo.Especie1~"' and RB7= '0' and RB6='0' and RB8='0' ")

Recorrer SQL

  dfa
  ACN(v1,1)

  * acumular capital
  SCN(ww1, fbn('Cantidad'))

  * acumular capital por tasa
  SCN(ww2, fbn('Cantidad')*fbn('Precio1') )

  * acumular capital por plazo
  SCN(ww3, fbn('Cantidad')*fbn('Precio2') )

  * acumular capital por tasa por plazo 
  SCN(ww4, fbn('Cantidad')*fbn('Precio1')*fbn('Precio2') )
Proximo

if Val(v1)=1
  * hay ajuste
  * Capital
  ACN(w1, Val(ww1)) 

  * tasa
  If Dialogo.Radio8 = 0 
    ACN(w11, Val(ww2)/Val(ww1))
  else
    ACN(w11, Val(ww4)/Val(ww3))
  endif

  ACN(w12, Val(ww3)/Val(ww1))

  * poner el resto en cero
  ACN(w2, 0)
  ACN(w21,0)
  ACN(w22, 0)
  ACN(w3, 0)
  ACN(w31,0)
  ACN(w42, 0)
  ACN(w4, 0)
  ACN(w41,0)
  ACN(w42, 0)
else
  *-- Vto. Multiple ---
  If Dialogo.Radio14=0  o Dialogo.Radio14=2 
     * LinkearHoja('COREN6',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     LinkearHoja('COREN6',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio3=1,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Lista1='',Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Radio6=2,Lista3=Dialogo.Lista3)
     If Dialogo.Radio8 = 0 
        ACN(w1, LinkH(1, bv:1))
        ACN(w11, LinkH(1, bu:1))
        ACN(w12, LinkH(1, bw:1))
     Else
        ACN(w1, LinkH(1, by:1))
        ACN(w11, LinkH(1, bx:1))
        ACN(w12, LinkH(1, bz:1))
     Endif   
     *CerrarHoja('COREN6',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=Dialogo.Radio3,Radio6=2,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     *CerrarLink(1)
  Else 
     ACN(w1, 0)
     ACN(w11,0)
     ACN(w12, 0)
  Endif  

  *-- Vto. Simple --
  If Dialogo.Radio14=0  o Dialogo.Radio14=1 
     * LinkearHoja('COREN4',2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     LinkearHoja('COREN4',2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio3=1,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Lista1='',Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Radio6=2,Lista3=Dialogo.Lista3)
     If Dialogo.Radio8 = 0 
        ACN(w2, LinkH(2, bv:1))
        ACN(w21, LinkH(2, bu:1))
        ACN(w22, LinkH(2, bw:1))
     Else
        ACN(w2, LinkH(2, by:1))
        ACN(w21, LinkH(2, bx:1))
        ACN(w22, LinkH(2, bz:1))
     Endif   
     *CerrarHoja('COREN4',2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=1,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     *CerrarLink(2)
  Else 
     ACN(w2, 0)
     ACN(w21,0)
     ACN(w22, 0)
  Endif  

  *-- Ajuste a tasa Ops de Vto.Simple con FXVT en USD --
  * Todos los T.Op o Vto.simple
  If Dialogo.Radio14=0  o Dialogo.Radio14=1 
    * Por Periodo
    If Dialogo.Radio8 = 0 
      * Todas Ops. o a Tasa
      If Dialogo.Radio10=0  o Dialogo.Radio10=1 
        * Todas las especies o USD
        If Dialogo.Radio7=0  o EqStr(Pipe2Coma(Dialogo.Lista2),'USD,') 
          LinkearHoja('COREN9',10,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio1=1,Check4=Dialogo.Check4)
          ACN(xx98, LinkH(10, x:98))
          ACN(xx99, LinkH(10, x:99))
          ACN(xx97, (((Val(w2)-Val(xx98))*Val(w21))+(Val(xx98)*(Val(w21)+Val(xx99))))/Val(w2)   )
 
          ACN(w21, Val(xx97))
          *CerrarHoja('COREN9',10,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio1=1,Check4=Dialogo.Check4)
          *CerrarLink(10)
        Endif
      Endif
    Endif
  Endif  
  *-- Caja de Ahorro --
  If Dialogo.Radio14=0  o Dialogo.Radio14=3
    LinkearHoja('COREN8',3,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    If Dialogo.Radio8 = 0 
      ACN(w3, LinkH(3, bv:1))
      ACN(w31, LinkH(3, bu:1))
      ACN(w32, LinkH(3, bw:1))
    Else
      ACN(w3, LinkH(3, by:1))
      ACN(w31, LinkH(3, bx:1))
      ACN(w32, LinkH(3, bz:1))
    Endif   
    *CerrarHoja('COREN8',3,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(3)
  Else 
    ACN(w3, 0)
   ACN(w31,0)
   ACN(w32, 0)
  Endif  
  *-- Todas las operaciones o Securities --
  If Dialogo.Radio10=0  o Dialogo.Radio10=2 
    *-- Fondos de Securities
    LinkearHoja('SCORE3',48,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio2=1,Radio6=1,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2)
    ACN(w4, LinkH(48, bv:1))
    ACN(w41, LinkH(48, bu:1))
    ACN(w42, 1)
    *CerrarHoja('SCORE3',48,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio2=1,Radio6=1,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2)
    *CerrarLink(48)
  Else 
    ACN(w4, 0)
    ACN(w41,0)
    ACN(w42, 0)
  Endif  
Endif