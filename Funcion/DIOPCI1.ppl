*** DIOPCI
*** Toma las Opciones y modifica el Precio, el Notional y la Cantidad

Message('Procesando Opciones ...')

SQL.ADD("SELECT O.TipoOp, O.NrOperacion, O.Cliente1, O.Vehiculo1, ")
SQL.ADD("       O.Cantidad, O.Book1, O.TotalRetenciones, O.PrecioEj ")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and TipoOp In ('DSEO') ")
SQL.ADD("   and FechaEj >='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("   and (CB8 is Null or CB8 = '0' ) ")
SQL.ADD(" order by O.TipoOp, O.Especie")

Recorrer SQL
   Message('Opciones  :'~FBN['TipoOp']~' '~FBN['NrOperacion'])   

   act(a:fac,fbn['Cliente1'])
   act(b:fac,fbn['TipoOp'])
   act(c:fac,fbn['Vehiculo1'] )   
   act(k:fac,fbn['NrOperacion'])
   acn(d:fac,fbn['Cantidad'] )
   act(k:fac,fbn['NrOperacion'])   
   act(l:fac,fbn['Book1'])   

   * j:Cantidad Original
   acn(j:fac,fbn['TotalRetenciones'] )
  
   IF Val(j:fac)=0
      * Nunca Cambio
      acn(j:fac,fbn['Cantidad'] )
   EndIf

   * e: Monto en Efectivo 
   * f: Monto en Acciones 
   * g: Precio Nuevo 
   * g: Precio 
   * h:Notional

   acn(e:fac, 0)    
   acn(g:fac, FBN['PrecioEj'])    

   IF FBN['RB9']=1
      * Calculo el Precio del Dividendo en Efectivo si esta protegida la opcion 
      acn(e:fac, FBN['Cantidad']*(Dialogo.Precio1/100))    
      acn(g:fac, FBN['PrecioEj']-(Dialogo.Precio1/100))    
   ENDIF

   acn(h:fac, FBN['Cantidad']*VAL(g:fac))    

   * Calculo el Dividendo en Acciones.
   acn(f:fac, FBN['Cantidad']*(Dialogo.Precio2/100))

   * Calculo el Nuevo Precio
   acn(g:fac, VAL(h:fac)/(FBN['Cantidad']+VAL(f:fac)))       

Proximo
