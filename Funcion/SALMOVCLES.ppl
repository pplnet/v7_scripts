SQL.ADD("SELECT S1.Cliente, S1.Especie, S1.Mercado, S1.Cuenta, '"~IdxDate(Dialogo.Fecha1)~"' Fecha1, '0' NrTrans, Sum(S1.Saldo) as Cantidad1, ")
SQL.ADD("       C.RazonSocial, 'SALINI' TipoTr2, 'DIR' Tipo, '0' RB1, '0' CB1, '0' CB2, E.FechaCambioTasa, E.TasaIntAnterior, ")
SQL.ADD("       E.TasaIntVigente,'EJE' Ejecutado,' ' Leyenda, '"~IdxDate(Dialogo.Fecha1)~"' FechaEje, E.InteresesC,S1.Cupon, E.Nombre") 
SQL.ADD("FROM "~DBO~".SALDOSDIA S1,"~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE ")
SQL.ADD("      S1.Cliente=C.Codigo AND ")
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado='"~Dialogo.Mercado1~"' AND ")
ENDIF
SQL.ADD("      (S1.NrSaldo="~Fstr(val(aa1),0,0)~" or S1.NrSaldo>201) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Especie = E.Codigo AND ")
SQL.ADD("      S1.Fecha    = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE ")
SQL.ADD("                        S2.Cliente = S1.Cliente  AND ")
SQL.ADD("                        S2.Especie = S1.Especie  AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("                        S2.Cuenta  = S1.Cuenta   AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo) ")
SQL.ADD("GROUP BY S1.Cliente,S1.Especie,S1.Cupon,S1.Mercado,C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.InteresesC, S1.Cuenta, E.Nombre ")
SQL.ADD("UNION ALL ")
