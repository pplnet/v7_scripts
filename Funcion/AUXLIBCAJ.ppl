SQL.ADD(" and    m2.NrOperacion = o.NrOperacion ")
SQL.ADD(" and    O.tipoop = 'CAUC' ")
SQL.ADD(" AND    m1.Leyenda    Not like 'INVERTIR%'    ")
SQL.ADD(" and    O.Cliente1    = C.Codigo    ")  
SQL.ADD(" AND    O.TipoOp      = TP.Codigo ")    
