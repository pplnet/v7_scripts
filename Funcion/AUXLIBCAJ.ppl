SQL.ADD(" AND    T.Fecha1 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1 in ("~Pipe2Comillas(VAR('MERCAACMC'))~")")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND  O.NrOperacion NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF

