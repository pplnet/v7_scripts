SQL.ADD(" CU.Comitente, M1.Leyenda, TP.Nombre, M1.NrSaldo, M1.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, O.Mercado4  ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS m1, "~DBO~".MOVEJECUTADOS m2, "~DBO~".OPERACIONES O,  "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION TP, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo ")
SQL.ADD(" where  t.NrTrans      = m1.nroperacion ")
