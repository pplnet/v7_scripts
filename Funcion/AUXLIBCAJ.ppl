*- Vouchers Neteo de MTM
SQL.ADD(" SELECT T.Cantidad1 as VN, T.Fecha1 FechaMov, 'Neto' NrOperacion, '' NrBoleto, T.Cliente1, C.RazonSocial, 'Neto' TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, T.Especie ContraEspecie, -M.Cantidad Cantidad, 0 TotalCaucion, 0 PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, 'MTM' Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, T.Mercado1 Mercado4  ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo ")
SQL.ADD(" where  T.NrTrans       = M.NrOperacion ")
SQL.ADD(" AND    M.Leyenda       Not like 'INVERTIR%' ")
SQL.ADD(" and    T.Cliente1      = C.Codigo    ")  
SQL.ADD(" AND    T.Especie       = M.Especie ")
SQL.ADD(" AND    T.Fecha3        >= 0 ")
SQL.ADD(" AND    T.Fecha1        >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1        <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1      in ("~Pipe2Comillas(VAR('MERROFEX'))~") ")
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" UNION ")

SQL.ADD(" SELECT DISTINCT M.Cantidad as VN, M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, 'MAE' Mercado4  ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON M.Cuenta = CU.Codigo, ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TP ")
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")
SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    C.Alias3   = 'CP'          ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD(" AND  T.NrTrans NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT M.Cantidad as VN, M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, 'MAE' Mercado4  ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON M.Cuenta = CU.Codigo , ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TP ")
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")

SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    M.Cliente  <> T.Vehiculo1  ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD(" AND  T.NrTrans NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF

