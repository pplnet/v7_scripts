      ACN(n:fac, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaMov')-1,25,SI,val(es:1)) )
   Endif
   ACN(o:fac, Val(m:fac)*Val(n:fac))
** FJL 21/12/18 - Se saca de la operacion
*   ACT(p:fac,'MAE')
   ACT(p:fac, fbn('Mercado4'))
   ACT(q:fac, iif(vacio(BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Cliente1'))),'Propio','Contraparte'))

   If Eqstr(fbn('TipoOp'), 'LCUPON') y fbn('NrSaldo')=5
      SQL.ADD(" SELECT T.Precio1, T.Precio2, T.Precio3, M.NrGrupo2     ")
      SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
      SQL.ADD(" WHERE T.NrTrans = M.NrOperacion ")
      SQL.ADD(" AND   M.Cliente = '"~fbn('Cliente1')~"' ")
      SQL.ADD(" AND   T.NrTrans = '"~fbn('NrOperacion')~"' ")
      Recorrer SQL
         dfa
         * AMORT
         ACN(pr:1, fbn('Precio1'))
         * RENTA  
         ACN(pr:2, fbn('Precio2'))
         * INT CAPITALIZ.
         ACN(pr:3, fbn('Precio3'))
         ACN(ng:2, fbn('NrGrupo2'))
         Break
      Proximo
      If Val(pr:1)<>0
         ACT(e:fac, Val(e:fac)~' - Renta')
         ACN(m:fac,  Val(ng:2)*Val(pr:1)/100)
         ACN(o:fac, Val(m:fac)*Val(n:fac))
         SetFont(a:fac..z:fac,1)
         FormatoCeldas(m:fac, EXE('F2'))
         FormatoCeldas(n:fac, EXE('F9'))
         FormatoCeldas(o:fac, EXE('F2'))
         AlinearCeldas(l:fac..l:fac, 'C')
         AlinearCeldas(p:fac..p:fac, 'C')
      Endif
      If Val(pr:2)<>0 o Val(pr:3)<>0
         If Val(pr:1)<>0
            ifa
            ACN(zz:2, 1)
            ACT(a:fac, Val(a:fac-1))
            ACLT(a:fac, Val(a:fac-1))
            ACT(b:fac, Val(b:fac-1))
*            ACT(c:fac, Val(c:fac-1))
            ACT(d:fac, Val(d:fac-1))
            ACT(e:fac, fbn('TipoOp')~' - '~fbn('Nombre'))
            ACT(i:fac, Val(i:fac-1))
            ACT(j:fac, Val(j:fac-1))
            ACT(k:fac, Val(k:fac-1))
            ACT(l:fac, Val(l:fac-1))
            ACN(n:fac, Val(n:fac-1))
         Endif
         ACT(e:fac, Val(e:fac)~' - Amortizacion')
         ACN(m:fac,  Val(ng:2)*(Val(pr:2)+Val(pr:3))/100)
         ACN(o:fac, Val(m:fac)*Val(n:fac))
      Endif
   Endif

   SetFont(a:fac..z:fac,1)
   AlinearCeldas(l:fac..l:fac, 'C')
   FormatoCeldas(m:fac, EXE('F2'))
   FormatoCeldas(n:fac, EXE('F9'))
   FormatoCeldas(o:fac, EXE('F2'))
   AlinearCeldas(p:fac..p:fac, 'C')

   If Val(zz:2)=1
      SCN(fe:2, Val(o:fac-1))
      SCN(me:2, Val(o:fac-1))
      SCN(tg:1, Val(o:fac-1))
   Endif

   SCN(fe:2, Val(o:fac))
   SCN(me:2, Val(o:fac))
   SCN(tg:1, Val(o:fac))
   ACD(fe:1, fbn('FechaMov'))
   ACN(me:1, Mes(fbn('FechaMov')))
   ACN(zz:1, 1)
Proximo

If Val(zz:1)<>0
   ifa
   ifa
