*- vi1: Vigentes=1 , Todos los Settements=0
*- vf1: Los que no estan vigentes pero vencieron en ese mes

*- REPOS Y CAUCIONES - PASIVAS: SERP|SERPV|MMCAUP|

If Dialogo.Radio3 = 1 
   SQL.ADD("Select O.Vehiculo1, 'Repos y Cauciones' Grupo, O.NrOperacion, O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
Else
   SQL.ADD("Select 'Consolidado' Vehiculo1, 'Repos y Cauciones' Grupo, O.NrOperacion, O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.Cantidad VResidual,")
EndIf 
SQL.ADD("O.RB8, CASE WHEN O.TipoOp = 'MMCAUP' THEN O.FechaVto ELSE O.FechaVto2 END FechaVto, O.FechaEx1 FechaSett, O.TipoTasa, O.PrecioRef, 0 Spread, ")
SQL.ADD("CASE WHEN O.TipoOp = 'MMCAUP' THEN O.Precio1 ELSE O.Precio3 END Tasa, CASE WHEN O.TipoOp = 'MMCAUP' THEN O.Precio4 ELSE 0 END TTN, ")
SQL.ADD("CASE WHEN O.TipoOp = 'MMCAUP' THEN O.TotalIntereses ELSE -(O.TotalNetoCli2 - O.TotalNetoCli1) END TotalIntereses, O.TotalIntereses IntNeto, O.TotalBrutoCli1 Monto, 0 TasaIva, 0 ImpIva, 0 TasaWH,")
SQL.ADD("0 ImpWH, O.TotalBrutoCli1 MontoNeto, 0 TasaImpInt, 0 ImpInt, O.PrecioEj ImpAmort, O.Cotizacion1, O.Cantidad, 0 NrCuota, 0 RB6, ")
SQL.ADD("O.FechaOp FInicio, CASE WHEN O.TipoOp = 'MMCAUP' THEN O.FechaVto ELSE O.FechaVto2 END FFin, O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3, O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O Where ")
SQL.ADD(" O.TipoOp In ('SERP','SERPV','MMCAUP') ")
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vf1)=1     
   *- Que Vencen en ese mes aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
 
SQL.ADD(" ) ")

If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

If Dialogo.Radio1 = 1
  If NoVacio(Dialogo.Vehiculo1)   
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  Else
    IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
  EndIf
Else
  IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  ENDIF
EndIf

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
