*-- Parametros de la Funcion AV1: Vehiculo1 AV2: Vehiculo2 AF1: Fecha AE1: Especie
* VERIINSVIN Verifica Instancia de Vinculadas

SQL.ADD("SELECT O.* ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where ((TipoOp='VIMD' and FechaOp='"~IdxDate(VAL(AF1))~"') ")
SQL.ADD(" or (TipoOp='VIMIND' and FechaVto='"~IdxDate(VAL(AF1))~"') ")
SQL.ADD(" or (TipoOp='VIMINM' and FechaVto='"~IdxDate(VAL(AF1))~"')) ")
SQL.ADD(" and O.Especie='"~VAL(AE1)~"' ")
SQL.ADD(" and ((O.Vehiculo1='"~VAL(AV1)~"' and O.Vehiculo2='"~VAL(AV2)~"') or (O.Vehiculo1='"~VAL(AV2)~"' and O.Vehiculo2='"~VAL(AV1)~"')) ")
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT TipoOp ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where TipoOp='VIMIND' and FechaOp='"~IdxDate(VAL(AF1))~"' ")
SQL.ADD(" and O.Especie ='"~VAL(AE1)~"' ")
SQL.ADD(" and ((O.Vehiculo1='"~VAL(AV1)~"' and O.Vehiculo2='"~VAL(AV2)~"') or (O.Vehiculo1='"~VAL(AV2)~"' and O.Vehiculo2='"~VAL(AV1)~"'))) ")
SQL.ADD(" Order By O.FechaOp,O.NrOperacion ")

Recorrer SQL

   DFA
   *- Verifico que se encuentre en Back Office o Terminal
   ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~FBN['NrOperacion']~"' AND Valor='1'") )

   If VAL(X1)<>20 y VAL(X1)<>50
      *-- Busco la instancia actual
      Cancelar("La Operacion '"~FBN['NrOperacion']~"' Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
   EndIf
