CONDICIONES

EV o [EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB')];'La Especie No esta Habilitada';NO
EV o [EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB')];'El Cliente No esta Habilitado';NO
EV o [FECHAOP>= Habiles(FSys,-Var('FTVALOR'),'ARG')];'Es una Operacion FechaValor';NO;SI;FSYS;'FVALOR'
EV o [Incluido(Vehiculo1, UsrVehiculos(Operador)) o Vacio(UsrVehiculos(Operador))];'El Operador no esta habilitado para operar con el Vehiculo';NO
Precio1 > 0;'La cotizacion de la Especie debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO
EV o PRECIO1<=TIPOCAMBIO*(1+VAR('RPRECIO2')/100) Y PRECIO1>=TIPOCAMBIO*(1-VAR('RPRECIO2')/100);'Precio Fuera de Rango: '~FSTR((TIPOCAMBIO*(1-VAR('RPRECIO2')/100)),1,7)~' y '~FSTR((TIPOCAMBIO*(1+VAR('RPRECIO2')/100)),1,7);NO


EV o PRECIO1<=TIPOCAMBIO*(1+VAR('RPRECIO') /100) Y PRECIO1>=TIPOCAMBIO*(1-VAR('RPRECIO') /100);'PRECIO FUERA DE RANGO: '~FSTR((TIPOCAMBIO*(1-VAR('RPRECIO') /100)),1,7)~' y '~FSTR((TIPOCAMBIO*(1+VAR('RPRECIO') /100)),1,7);SI;SI;FSYS;'RANGOPRE1'
ExisteLimite('78',CLIENTE1,'USD') o TOTALAUX2 = 0         o FechaOp > Fsys; 'Limite FXL No Asignado ';SI;SI;FSYS;'LINOAS';;;2
VtoLimite('78',CLIENTE1,'USD') >= FECHAOP o TOTALAUX2 = 0 o FechaOp > Fsys; 'Limite FXL Vencido '    ;SI;SI;FSYS;'LIVENC';;;2  
[LimAsignado(CLIENTE1,'78','USD',,,,,,,,,,,PLAZO)>=(LimConsumido(CLIENTE1,'78','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + LimConsumido(CLIENTE1,'320','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TOTALAUX2)] o TOTALAUX2 = 0 o FechaOp > Fsys;'Limite FXL Excedido en U$D '~PYC(((LimConsumido(CLIENTE1,'78','USD',0,VEHICULO1,,,NROPERACION,,,,,,,,,PLAZO) + TOTALAUX2) - LimAsignado(Cliente1,'78','USD',,,,,,,,,,,PLAZO)),1,0)~'.-';SI;SI;FSYS;'LIEXCE';;;2

CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o ExisteLimite('DERIVADOS',CLIENTE1,'USD')                                                       ;'Derivado Cliente no asignado'                                                       ;SI;SI;FSYS   ;'DERIVANOAS'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not ExisteLimite('DERIVADOS',CLIENTE1,'USD') o VtoLimite('DERIVADOS',CLIENTE1,'USD') >= FechaOp;'Derivado Cliente vencido el '~FECHA(VtoLimite('DERIVADOS',CLIENTE1,'USD'))          ;SI;SI;FSYS   ;'DERIVVENC'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not LimCancelado('DERIVADOS',CLIENTE1,'USD')                                                   ;'Derivado Cliente cancelado'                                                         ;SI;SI;FSYS   ;'DERIVCANC'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o MinDerechoBolsa>=0                                                                             ;'Excede el limite de Derivado Cliente '~CLIENTE1~' en '~PYC(Abs(MinDerechoBolsa),0,2);SI;SI;FECHAOP;'DERIVEXC'

CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Vacio(CLIENTE3) o ExisteLimite('DERIVADOS',CLIENTE3,'USD')                                                                                                       ;'Derivado Controlante '~CLIENTE3~' no asignado'                                                                                                                                                                      ;SI;SI;FSYS   ;'DERIVNOAS'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Vacio(CLIENTE3) o Not ExisteLimite('DERIVADOS',CLIENTE3,'USD') o VtoLimite('DERIVADOS',CLIENTE3,'USD') >= FechaOp                                                ;'Derivado Controlante '~CLIENTE3~' vencido el '~FECHA(VtoLimite('DERIVADOS',CLIENTE3,'USD'))                                                                                                                         ;SI;SI;FSYS   ;'DERIVVENC'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Vacio(CLIENTE3) o Not LimCancelado('DERIVADOS',CLIENTE3,'USD')                                                                                                   ;'Derivado Controlante '~CLIENTE3~' cancelado'                                                                                                                                                                        ;SI;SI;FSYS   ;'DERIVCANC'
CB9 = 1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Vacio(CLIENTE3) o LimAsignado(CLIENTE3,'DERIVADOS',VAR('MONEEXTR'),VEHICULO1)>=LimConsumido(CLIENTE3,'DERIVADOS',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN9;'Excede el limite de Derivado a Controlante '~CLIENTE3~' en '~PYC(LimConsumido(CLIENTE3,'DERIVADOS',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7-LimAsignado(CLIENTE3,'DERIVADOS',VAR('MONEEXTR'),VEHICULO1),0,2);SI;SI;FECHAOP;'DERIVEXC'

SI O Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~VTXT8~"' ") <> 1;'Ya Ha Sido Liquidado el MTM del Dia';NO
SI O Vacio(VTXT8);'Recuerde Procesar el MTM del Dia';SI
SI O EV o Cantidad >= ValidacionMonto(OficialCuenta,Especie,TipoOp,0);'La Cantidad debe ser Mayor o Igual al Monto Minimo';SI;SI;FSYS;'OPEWAR';
SI O [Not EV] o Cantidad >= ValidacionMonto(OficialCuenta,Especie,TipoOp,0);'La Cantidad debe ser Mayor o Igual al Monto Minimo';SI;SI;FSYS;'OPEWAR';
SI O EV o Cantidad <= ValidacionMonto(OficialCuenta,Especie,TipoOp,1);'La Cantidad debe ser Menor o Igual al Monto Maximo';SI;SI;FSYS;'OPEWAR';
SI O [Not EV] o Cantidad <= ValidacionMonto(OficialCuenta,Especie,TipoOp,1);'La Cantidad debe ser Menor o Igual al Monto Maximo';SI;SI;FSYS;'OPEWAR';
SI O EV o [[Incluido(TipoOp,'FXIMPO|FXEXPO')] o [Incluido(TipoOp,'TICF|TIVF')] o VCAN5 <> 0 ];'Risk Management no ha ingresado valor PFE para este plazo. No puede ser cargada la operacion';NO;
SI O Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)>LimConsumido(CLIENTE1,'RPCCLI','USD',0,VEHICULO1,,,NROPERACION)];'Patrimonio del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI')] o [DesciendeDeCliente(Cliente1,'VINCULADOS') y EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PVINC')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BLOCAL')] o [DesciendeDeCliente(Cliente1,'BLOCAL') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINAN')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'BEXTER')] o [DesciendeDeCliente(Cliente1,'BEXTER') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PFINEXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [Not DesciendeDeCliente(Cliente1,'CORREXT')] o [DesciendeDeCliente(Cliente1,'CORREXT') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCORREXT')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [DesciendeDeCliente(Cliente1,'BANCOS')] o [DesciendeDeCliente(Cliente1,'VINCULADOS')] o [EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI')] o [DesciendeDeCliente(Cliente1,'CORRESP')] o [Not DesciendeDeCliente(Cliente1,'BANCOS') y Not DesciendeDeCliente(Cliente1,'VINCULADOS') y Not EqStr(BuscarCampo('Clientes','Vinculado','Codigo',Cliente1),'SI') y Not DesciendeDeCliente(Cliente1,'CORRESP') y BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('PCLIENTE')>LimConsumido(CLIENTE1,'RPCBCO','USD',0,VEHICULO1,,,NROPERACION)];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
SI O Vacio(Cliente1) o FechaOp > Fsys o [BuscarCampo('Clientes','Patrimonio','Codigo',Vehiculo1)*Var('P25')>BuscarCampo('Clientes','Patrimonio','Codigo',Cliente1)*3];'Deuda RPC del Cliente Excedido';SI;SI;FSYS;'RPC';;;1
