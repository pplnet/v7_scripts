If Val(zz1) <> 0
   (.'ESTDEDSQLC'.)
   if Vacio(Val(x1)) O Val(x1) = 0
      ifa
   EndIf

   *--->Acumula los totales por vehiculo y especie
   ACN(cc1, Val(cc1) + Val(bb1))
   ACN(cc2, Val(cc2) + Val(bb2))
   ACN(cc3, Val(cc3) + Val(bb3))
   ACN(cc4, Val(cc4) + Val(bb4))
   ACN(cc5, Val(cc5) + Val(bb5))
   ACN(cc6, Val(cc6) + Val(bb6))
   ACN(cc7, Val(cc7) + Val(bb7))
   ACN(cc8, Val(cc8) + Val(bb8))
   ACN(cc9, Val(cc9) + Val(bb9))
   ACN(cc10, Val(cc10) + Val(bb10))
   ACN(cc11, Val(cc11) + Val(bb11))

   FormatoCeldas(z:6..z:9, Exe('F2'))
   If Val(GR:1)=0
      ACT(a:fac, 'Total '~Val(aa2)~' en '~Val(aa3)~'')
   Else
      ACT(a:fac, 'Total '~Val(aa:10)~' en '~Val(aa3)~'')
   Endif

   *--->Muestra Total Amort. Capital
   ACN(J:fac, Val(cc1))
   *--->Muestra Intereses a Pagar
   ACN(K:fac, Val(cc2))
   *--->Muestra Total Comision
   ACN(L:fac, Val(cc3))
   *--->Muestra Total IVA
   ACN(M:fac, Val(cc4))
   *--->Muestra Total WHT
   ACN(N:fac, Val(cc5))
   *--->Muestra Impuesto a los Sellos
   ACN(O:fac, Val(cc11))
   *--->Muestra Total a Pagar
   ACN(P:fac, Val(cc6))

   *--->Muestra Total Devengados
   ACN(s:fac, Val(cc7))
   ACN(t:fac, Val(cc8))
   ACN(u:fac, Val(cc9))
   ACN(v:fac, Val(cc10))


   SetFont(a:fac..w:fac, 2)
   AgregarMarco(a:fac..w:fac,2,0,Exe('COLOR11'))


   ***+++>Acumula la suma de Amort Capital y Intereses Dev para el cuadro de totales por moneda del final del informe
   If Val(mo1) = 0
       ACT(mm1, Val(aa3))
       ACN(mp1,CotizacionC(Val(me1),,,,Dialogo.Fecha1-1,1,SI,Val(aa3)))
       If DesciendeDeEspecie(Val(es:1),'MONEDA')
         ACN(mn:1, Val(cc1)+ Val(cc7) + Val(cc9))
       Else
         If Incluido(Val(aa:5),'SERP|SERPV')
           ACN(mn:1, Val(cc:7))
         Endif
         If Incluido(Val(aa:5),'MMCAUP')
           ACN(mn:1, Val(cc:1)+Val(cc:7))
         Endif
       Endif
       ACN(mo1, 1)
   Else
       Recorrer&j 1, Val(mo1)
          If EqStr(Val(aa3), Val(mm:&j))
             If DesciendeDeEspecie(Val(es:1),'MONEDA')
               ACN(mn:&j, Val(mn:&j) + Val(cc1)+ Val(cc7) )
             Else
               If Incluido(Val(aa:5),'SERP|SERPV')
                 ACN(mn:&j, Val(mn:&j) + Val(cc:7))
               Endif
               If Incluido(Val(aa:5),'MMCAUP')
                 ACN(mn:&j,Val(mn:&j) + Val(cc:1) + Val(cc:7))
               Endif
             Endif
             Break
          Endif
          If Val(mo1) = &j
             ACT(mm:&j+1, Val(aa3))
             ACN(mp:&j+1,CotizacionC(Val(me1),,,,Dialogo.Fecha1-1,1,SI,Val(aa3)))
             If DesciendeDeEspecie(Val(es:1),'MONEDA')
               ACN(mn:&j+1, Val(cc1) + Val(cc7) )
             Else
               If Incluido(Val(aa:5),'SERP|SERPV')
                 ACN(mn:&j+1, Val(cc:7))
               Endif
               If Incluido(Val(aa:5),'MMCAUP')
                 ACN(mn:&j+1, Val(cc:1) + Val(cc:7))
               Endif
             Endif
             SCN(mo1, 1)
          Endif
       Proximo
   Endif
EndIf

