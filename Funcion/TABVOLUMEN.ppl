SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1,  ")
SQL.ADD(" O.Especie, O.Cantidad, O.Precio1, TotalBrutoCli1, O.Plazo, ")
SQL.ADD(" O.ContraEspecie, O.TotalNetoCli1, CB8 Custodia, ")
SQL.ADD(" TotalAux3 MontoComi, TotalIVA MontoIva, TotalAux1 MontoDBolsa, TotalAux2 MontoDMercado, TotalAux4 IvaDMercado, TotalComisiones ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE O.Cliente1='"~Dialogo.Cliente1~"'")
SQL.ADD("   AND O.TipoOp IN('TIC','TICCL','TIV','TIVCL','MMFCS','MMFCR','FXCF','FXVF') ")
SQL.ADD("   AND O.FechaOp>="~IdxDate2(val(fe:1))~" AND O.FechaOp<="~IdxDate2(val(fe:2)))
SQL.ADD(" ORDER BY TipoOp, Especie, FechaOp ")

Recorrer SQL
   dfa
   if EQSTR(fbn['Contraespecie'],val(az:1))
      acn(ax:1,fbn['TotalBrutoCli1'])
   else
      acn(ax:1,fbn['TotalBrutoCli1']*CotizacionC(fbn['ContraEspecie'],,,,fbn['FechaOp'],1,NO,val(az:1)))
   endif
   if Incluido(fbn['TipoOp'],'TIC|TICCL|TIV|TIVCL|')
      if DesciendeDeEspecie(FBN['Especie'],'DEUDA')
         scn(val(co:1):fac,val(ax:1))
         scn(val(co:1)+1:fac,1)
         FormatoCeldas(val(co:1)+1:fac,Exe('F0'))
         scn(val(co:1)+2:fac,fbn['MontoComi']+fbn['MontoIva']+fbn['MontoDBolsa']+fbn['MontoDMercado']+fbn['IvaDMercado'])
         if val(k:fac)<fbn['FechaOp']
            acd(k:fac,fbn['FechaOp'])
         endif
      else
         if DesciendeDeEspecie(FBN['Especie'],'PRIVA')
            scn(val(co:1):fac+1,val(ax:1))
            scn(val(co:1)+1:fac+1,1)
            FormatoCeldas(val(co:1)+1:fac+1,Exe('F0'))
            scn(val(co:1)+2:fac+1,fbn['MontoComi']+fbn['MontoIva']+fbn['MontoDBolsa']+fbn['MontoDMercado']+fbn['IvaDMercado'])
            if val(k:fac)+1<fbn['FechaOp']
               acd(k:fac+1,fbn['FechaOp'])
            endif
         endif
      endif
   else
      if Incluido(fbn['TipoOp'],'MMFCS|MMFCR|')
         scn(val(co:1):fac+2,val(ax:1))
         scn(val(co:1)+1:fac+2,1)
         FormatoCeldas(val(co:1)+1:fac+2,Exe('F0'))
         scn(val(co:1)+2:fac+2,fbn['TotalComisiones'])
         if val(k:fac)+2<fbn['FechaOp']
            acd(k:fac+2,fbn['FechaOp'])
         endif
      else
         if Incluido(fbn['TipoOp'],'FXCT|FXVT|')
            scn(val(co:1):fac+3,val(ax:1))
            scn(val(co:1)+1:fac+3,1)
            FormatoCeldas(val(co:1)+1:fac+3,Exe('F0'))
            scn(val(co:1)+2:fac+3,0)
            if val(k:fac)+3<fbn['FechaOp']
               acd(k:fac+3,fbn['FechaOp'])
            endif
         endif
      endif
   endif
