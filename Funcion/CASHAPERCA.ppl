*-- nc1: Guarda el Nro.de Saldo  110: HM 111: SA 112: AS 113: TR
*-- nc3: Especie  nc4: Vehiculo1 nc5: Cliente1


SQL.ADD("Select S.* ")
SQL.ADD("from "~DBO~".MOVPOSEJE S ")
SQL.ADD("where  S.Especie='"~VAL(nc3)~"' ")

If Dialogo.Radio3=0   
   SQL.ADD("and    S.Vehiculo='"~VAL(nc4)~"' ")
   SQL.ADD("and    S.Cliente='"~VAL(nc5)~"' ")
EndIf

SQL.ADD(" and (")
SQL.ADD(" S.NrSaldo="~Fstr(VAL(nc1),0,0)~" ")
If Dialogo.Radio2=1
   SQL.ADD(" or S.NrSaldo="~Fstr(100+VAL(nc1),0,0)~" ")  
EndIf
SQL.ADD(")")

SQL.ADD("and    S.Cantidad<>0 ")
SQL.ADD("and    (S.CallPut is Null or S.CallPut = ' ') ")
SQL.ADD("and    S.FechaMov <= '"~IdxDate(Dialogo.Fecha3)~"' ")
SQL.ADD("order by S.FechaMov ")


ACN(nc2,0)

Recorrer SQL
   dfa
   SCN(nc2,FBN['Cantidad'])
Proximo


