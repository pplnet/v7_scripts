*- Tabla de Feriados
ACT(zz3, VAR('FERIADODEF'))


scn(c:200,2)
scn(d:200,2)

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("Sum(C.Cantidad1)/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMCPM') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD(" group by O.NrOperacion, O.Vehiculo1, O.Especie, O.FechaVto, O.TipoOp ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("Cantidad/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMCP','MMDCA','MMO','MMD','MMCDIA') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("Cantidad/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ((O.FechaVto2 Is Not Null and O.FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"') or (O.FechaVto2 Is Null and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"') )")
SQL.ADD(" and  O.TipoOp In ('MMCDP') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("CASE TipoOp WHEN 'FCS' THEN O.Cantidad ELSE -O.Cantidad END/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('FCS','FCR') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')

Recorrer SQL

  Message(FBN['TipoOp']~' '~FBN['NrOperacion'])

  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,HABILES(Dialogo.Fecha1,1,Val(zz3),SI),1,SI,Val(me1)))
     ACN(zz4, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  if EqStr(fbn['Especie'],'ARP')
     scn(val(e:200):val(c:200),fbn['Cant'])
     scn(val(e:200):val(h:200),fbn['Cant'])
     SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
  else
     if Incluido(fbn['TipoOp'],'FCS|FCR') y EqStr(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn['Especie']),'ARP')
        scn(val(e:200):val(c:200),fbn['Cant']*Val(zz2))
        scn(val(e:200):val(h:200),fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        scn(val(e:200):val(d:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
        scn(val(e:200):val(k:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif
  endif
  if fbn['Fecha'] <= (Dialogo.Fecha1+365)
     scn(val(e:200):val(t:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
     SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     scn(b:val(t:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
  else
     if Not Incluido(fbn['TipoOp'],'MMCPM')
        scn(val(e:200):val(x:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
        scn(b:val(x:200),fbn['Cant']*IIf(Incluido(fbn['TipoOp'],'FCS|FCR'),Val(zz2),Val(zz4)))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     else
        SQL.ADD("Select Sum(Cantidad1)/1000 Parcial from "~DBO~".CUOTAS ")
        SQL.ADD("where  NrOperacion = '"~fbn['NrOperacion']~"' ")
        SQL.ADD("  and  Fecha2 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
        SQL.ADD("  and  Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")

        acn(y:200,0)
        Recorrer SQL

          acn(y:200,fbn['Parcial'])
        Proximo

        scn(val(e:200):val(t:200),val(y:200)*Val(zz4))
        scn(b:val(t:200),val(y:200)*Val(zz4))
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)

        scn(val(e:200):val(x:200),(fbn['Cant']-val(y:200))*Val(zz4))
        scn(b:val(x:200),(fbn['Cant']-val(y:200))*Val(zz4))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
proximo

*** depositos por compra/venta de moneda no puesto ****
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("O.Cantidad/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <> O.FechaPago ")
SQL.ADD(" and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("order by 1, 2 ")

acn(z:200,0)
act(u:200,' ')

Recorrer SQL  

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion 
     ACN(zz4, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  Message(FBN['Vehiculo1']~' '~fbn['NrOperacion']~' '~Fstr(fbn['Cant'],0,2)~' '~fbn['TipoOp'])

  if Not EqStr(val(u:200),fbn['Vehiculo1']) y Not EqStr(val(u:200),' ')
     Message('Cambia de Vehiculo=>Sumariza ')

     if (val(z:200)+val(val(e:200):val(d:200)))>= 0   
        scn(val(e:200):val(d:200),val(z:200))   

        Message(val(d:200))
        Message(Val(val(e:200):val(d:200)))

        scn(val(e:200):val(k:200),val(z:200))   

        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)

        scn(val(e:200):val(t:200),val(z:200))   
        scn(b:val(t:200),val(z:200))
   
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     else
        if (val(z:200)+val(val(e:200):val(d:200))) < 0      
           scn(val(e:200):val(y:200),Abs(val(z:200)))      
           scn(val(e:200):val(l:200),Abs(val(z:200)))      
           SetFont(val(e:200):val(y:200)..val(e:200):val(y:200),3)
 
           scn(val(e:200):val(v:200),Abs(val(z:200)))     
           scn(b:val(v:200),Abs(val(z:200)))
           SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
        endif
     endif
  EndIf

  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           acn(z:200,0)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  if Incluido(fbn['TipoOp'],'FXCS|FXCSV')
     scn(z:200,fbn['Cant']*Val(zz4))
  else
     scn(z:200,fbn['Cant']*(-1)*Val(zz4))
  endif


proximo

If val(z:200)<>0 
   If (val(z:200)+val(val(e:200):val(d:200)))>= 0   
      scn(val(e:200):val(d:200),val(z:200))   

      Message(val(d:200))
      Message(Val(val(e:200):val(d:200)))

      scn(val(e:200):val(k:200),val(z:200))   

      SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)

      scn(val(e:200):val(t:200),val(z:200))   
      scn(b:val(t:200),val(z:200))
   
      SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
   else
      if (val(z:200)+val(val(e:200):val(d:200))) < 0      
         scn(val(e:200):val(y:200),Abs(val(z:200)))      
         scn(val(e:200):val(l:200),Abs(val(z:200)))      
         SetFont(val(e:200):val(y:200)..val(e:200):val(y:200),3)
 
         scn(val(e:200):val(v:200),Abs(val(z:200)))     
         scn(b:val(v:200),Abs(val(z:200)))
         SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
      endif
   endif
EndIf
