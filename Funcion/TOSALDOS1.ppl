VTXT36     : 'Cupon'           ;1 ;2;2;NO;NO;NoVacio(VTXT36);'El Cupon es Nulo, Corrija la Especie o la Agenda Cupon';NO;NrCupon2(ESPECIE,FECHAVTO);NrCupon2(ESPECIE,FECHAVTO)
VTXT8     : 'Cupon Vig Saldo' ;2 ;2;2;NO;NO;[[NUM(VTXT8)>=NUM(VTXT36) Y FECHAORDEN<FSYS] O [NUM(VTXT8)<=NUM(VTXT36) Y FECHAORDEN>=FSYS]] O NoVacio(VTXT8)];'Cupon Vigente incorrecto.';NO;;IF(EQSTR(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'PRI'),VTXT36,FSTR(Min(NUM(VTXT37),NUM(IF(NOVACIO(VTXT9),VTXT9,VTXT37))),0,0) )
VTXT37     : 'Cupon Vig Saldo' ;3 ;2;2;NO;NO;;;;;QUERY("Select A.NrCupon from "~DBO~".AGENDACUPONES A where A.Especie='"~ESPECIE~"' and A.FechaCorte=(Select Min(FechaCorte) from "~DBO~".AGENDACUPONES C where C.Especie = A.Especie and C.Estado='PEN' ) ")
VTXT9     : 'Cupon Vig Saldo' ;4 ;2;2;NO;NO;;;;;QUERY("Select A.NrCupon from "~DBO~".AGENDACUPONES A where A.Especie='"~ESPECIE~"' and A.FechaCorte=(Select Min(FechaCorte) from "~DBO~".AGENDACUPONES C where C.Especie = A.Especie and C.FechaCorte>'"~IDXDATE(FSYS)~"' AND C.Estado<>'PEN') ")

*VTxt4     : 'Ctas/Saldos'           ;10;1;2;NO;NO; ; ; ;IIF(VCAN18<>0 y VCAN7<>0 THEN SQLSet("SELECT S.Cuenta FROM "~DBO~".SALDOS S, "~DBO~".CUENTAS C WHERE S.Cliente='"~CLIENTE~"' AND S.Mercado='"~MERCADO~"' AND S.NrSaldo="~FStr(VCAN9,0,0)~" AND S.Especie='"~ESPECIE~"' AND S.Cuenta=C.Codigo AND C.Estado='HAB' AND C.TipoCuenta In ('CUS', 'CCO') AND S.Saldo<>0 "~IF(NoVacio(VTXT8)," AND Cupon = '"~VTXT8~"' ","")~" ORDER BY S.Saldo DESC") ELSE '' ENDIF);IIF(VCAN18<>0 y VCAN7<>0 THEN SQLSet("SELECT S.Cuenta FROM "~DBO~".SALDOS S, "~DBO~".CUENTAS C WHERE S.Cliente='"~CLIENTE~"' AND C.Mercado='"~MERCADO~"' AND S.NrSaldo="~FStr(VCAN9,0,0)~" AND S.Especie='"~ESPECIE~"' AND S.Cuenta=C.Codigo AND C.Estado='HAB' AND C.TipoCuenta In ('CUS', 'CCO') AND S.Saldo<>0 "~IF(NoVacio(VTXT8)," AND Cupon = '"~VTXT8~"' ","")~" ORDER BY S.Saldo DESC") ELSE '' ENDIF);
*PZ 16/04/2020 Lo paso al cuerpo para igualar OTIC/OTIV
*VTxt4     : 'Ctas/Saldos'            ;10;2;2;NO;NO; ; ; ;SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~CLIENTE~"' AND (Especies='"~ESPECIE~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') AND Mercado='"~MERCADO~"' ORDER BY Codigo ASC");SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~CLIENTE~"' AND (Especies='"~ESPECIE~"' OR Especies LIKE '%TITULO%') AND Mercado='"~MERCADO~"' AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') ORDER BY Codigo ASC");
