def TasaUvaPeriodo(operacion,fechaFin)
    let &fechaInicio BuscarCampo('OPERACIONES','FechaOp','NrOperacion',operacion)
    let &cotizacionInicio Cotizacion('UVA','CON',,,&fechaInicio,1)
    let &cotizacionFin Cotizacion('UVA','CON',,,fechaFin,1)
    return ((&cotizacionFin/&cotizacionInicio)*100)-100
end

def TasaUvaAnualizada(operacion,FechaFin,tasaUvaPeriodo)
    let &fechaInicio BuscarCampo('OPERACIONES','FechaOp','NrOperacion',operacion)
    let &uTiempo IIF(Eqstr(BuscarCampo('OPERACIONES','RB8','NrOperacion',operacion),'1'),365,360)
    return tasaUvaPeriodo*&uTiempo/(FechaFin-&fechaInicio)
end