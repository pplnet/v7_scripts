*- Recibe el Monto sobre el cual aplicar la comision (En Moneda ) y Calcula atributos de 
*- Comisiones e Iva 

*- cl1: Cliente / 
*- ce1: Especie Original del Saldo
*- sa1: Monto en Efectivo base para calculo / 
*- ch1: Cuenta para Calculo de Comision
*- cz1: En que cotiza la especie del saldo / 
*- cz2: Moneda de la cuenta de comision
*- cv1: Vehiculo / 
*- cy1: Mercado / 
*- ct1: Tipo de Comision

*- Por cada saldo recuperado -> Calculo Recupero la cuenta default para el calculo de comisiones
*- cp1: Cuenta de Pesos 
act(cp:1,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~val(cl1)~"' and Especies Like '%"~Val(dz1)~"%' and Estado='HAB' and TipoCuenta In('CC','CA') "))

*- cd1: Cuenta de dolares 
act(cd:1,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~val(cl1)~"' and Especies Like '%"~Val(dz2)~"%' and Estado='HAB' and TipoCuenta In('CC','CA') "))

*- Especie en la que cotiza la especie original del saldo
act(cz:1,Val(bq:&i)) 

act(ch:1,IIF(NoVacio(val(cp:1)),val(cp:1),IIf(NoVacio(val(cd:1)),val(cd:1),Val(dz3))))

ACT(cz:2,Val(dz1))

*- Para cada porcion del saldo segun el estado, abro la comision
SCN(sa2,1)
  
*- Saldo Original   
  ACN(sa1, Val(hg:1))
  IF Val(hs:1) = Val(sl1)
     ACT(cz8, BuscarCampo('ESTADOSCUSTODIA', 'Codigo', 'NrSaldo', Val(hs:1)))  
  ELSE
     ACN(cz9, Val(hs:1)-100)
     ACT(cz8, BuscarCampo('ESTADOSCUSTODIA', 'Codigo', 'NrSaldo', Val(cz9)))  
  ENDIF

***  If EqStr(val(ct1),Val(dz4)) o EqStr(val(ct1),Val(dz5))
     ACN(sa1,val(cj1))
***  Else 
***     *- ci: Cotizacion
***     acn(ci:1,Cotizacion(val(ce1),,,,Dialogo.Fecha1,1))
***
***     *- Resolucion 1585
***     ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Val(ce1)))
***
***     If Not EqStr(Val(bp:&i),'DIR')
***        *** calcula precio sucio ***
***        act(ca:fac,val(ce1))
***        acd(ck:fac,Dialogo.Fecha1)
***
***        ACT(aa0, Val(bp:&i))
***        ACN(ab0, Val(br:&i))
***        ACD(ac0, Val(bs:&i))
***        ACT(ad0, Val(bt:&i))
***        ACN(ae0, Val(bu:&i))
***        ACT(af0, Val(bv:&i))
***        ACT(ag0, Val(bw:&i))
***        ACT(ah0, Val(bx:&i))
***
***        ***(."SUCIO".)
***        (."SUCIO2".)
***
***        IF Incluido(Val(al4), '1585')
***           acn(ci:1,(val(ci:1)+(val(cj:fac)*Val(ci:1)))*val(ci:fac) ) 
***        Else
***           acn(ci:1,(val(ci:1)+val(cj:fac))*val(ci:fac) ) 
***        Endif
***     EndIf
***
***     *- j: Valuacion
***     acn(sa:1,val(sa1)*val(ci:1)*CotizacionC(val(cz1),,,,Dialogo.Fecha1,1,SI,Val(dz1)))
***  EndIf


#ifdef PRUEBA
  MessageBox('Monto de '~val(ct1)~' '~Fstr(val(sa1),0,2) )
#else
  Message('Monto de '~val(ct1)~' '~Fstr(val(sa1),0,2) )
#endif 

  * Message(' CACOMISION => '~val(cl1)~val(cE1)~val(cv1)~val(ct1)~val(sa1)~val(bl:&i)~val(cy1)~val(cz8))
  *- ck: Monto de Arancel
  ACN(ck:1,Round2(MontoArancelC(,val(cl1),val(ce1),val(cv1),VAL(ct:1), VAL(sa:1) ,0,,Val(bl:&i),SI,'',VAL(cy:1),Val(cz8),'MAN',SI,SI,,SI),2))

  * MessageBOX(' CACOMISION = '~FStr(val(ck1),0,2))
  SCN(sa3,val(ck:1))


  If NO
     ACN(ck:1,val(ck:1)*CotizacionC(val(cz1),,,,Dialogo.Fecha1,1,SI,val(cz:2)) )
     ACN(cq:1,MontoArancelC(,val(cl1),val(ce1),val(cv1),VAL(ct:1), VAL(sa:1) ,4,,BuscarCampo('Clientes','TipoCliente','Codigo',VAL(cl:1)),SI,'',VAL(cy:1),Val(cz8),'MAN',SI))
     ACN(cm:1,MontoArancelC(,val(cl1),val(ce1),val(cv1),VAL(ct:1), VAL(sa:1) ,1,,BuscarCampo('Clientes','TipoCliente','Codigo',VAL(cl:1)),SI,'',VAL(cy:1),Val(cz8),'MAN',SI)*CotizacionC(val(cz1),,,,Dialogo.Fecha1,1,SI,val(cz:2)))
     ACN(cn:1,MontoArancelC(,val(cl1),val(ce1),val(cv1),VAL(ct:1), VAL(sa:1) ,2,,BuscarCampo('Clientes','TipoCliente','Codigo',VAL(cl:1)),SI,'',VAL(cy:1),Val(cz8),'MAN',SI)*CotizacionC(val(cz1),,,,Dialogo.Fecha1,1,SI,val(cz:2)))
     ACN(co:1,MontoArancelC(,val(cl1),val(ce1),val(cv1),VAL(ct:1), VAL(sa:1) ,5,,BuscarCampo('Clientes','TipoCliente','Codigo',VAL(cl:1)),SI,'',VAL(cy:1),Val(cz8),'MAN',SI)*CotizacionC(val(cz1),,,,Dialogo.Fecha1,1,SI,val(cz:2)))

     *- Guardo en Cuotas todas las ocurrencias que encuentre
     SQL.ADD("INSERT INTO "~DBO~".CUOTAS  ")  
     SQL.ADD("(NrOperacion,NrCuota,Cantidad1,Tasa1,Cantidad2,Cantidad3,Cantidad4,Precio1,Vehiculo1) ")  
     SQL.ADD("Values ")  
     SQL.ADD(" ('"~val(y1)~"',"~Fstr(val(sa2),0,0)~","~Fstr(val(ck:1),0,2)~","~Fstr(val(cq:1),0,2)~","~Fstr(val(cm:1),0,2)~","~Fstr(val(cn:1),0,2)~","~Fstr(val(co:1),0,2)~","~Fstr(FBN['NrSaldo'],0,0)~",'"~val(ct:1)~"') ")  
     SQL.NEW
     SQL.EXEC
  EndIf

