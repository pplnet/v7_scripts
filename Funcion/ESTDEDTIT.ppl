If FBN['Num'] = 1
   ACT(a:FAC, "PRESTAMOS FINANCIEROS")
   SetFont(a:fac..a:fac,3)
   Message('- Prestamos Financieros')
EndIf
If FBN['Num'] = 2
   ACT(a:FAC, "PRESTAMOS SINDICADOS")
   SetFont(a:fac..a:fac,3)
   Message('- Prestamos Sindicados')
EndIf
If FBN['Num'] = 3
   ACT(a:FAC, "FRN")
   SetFont(a:fac..a:fac,3)
   Message('- FRN')
EndIf
If FBN['Num'] = 4
   ACT(a:FAC, "PRESTAMOS VINCULADAS")
   SetFont(a:fac..a:fac,3)
   Message('- Prestamos Vinculadas')
EndIf
If FBN['Num'] = 5
   ACT(a:FAC, "DESCUBIERTOS")
   SetFont(a:fac..a:fac,3)
   Message('- Descubiertos')
EndIf
If FBN['Num'] = 6
   ACT(a:FAC, "OBLIGACIONES NEGOCIABLES")
   SetFont(a:fac..a:fac,3)
   Message('- Obligaciones Negociables')
EndIf
If FBN['Num'] = 7
   ACT(a:FAC, "SWAPS")
   SetFont(a:fac..a:fac,3)
   Message('- SWAPS')
EndIf
If FBN['Num'] = 8
   ACT(a:FAC, "REPOS")
   SetFont(a:fac..a:fac,3)
   Message('- REPOS')
EndIf
If FBN['Num'] = 9
   ACT(a:FAC, "REPOS VINCULADAS")
   SetFont(a:fac..a:fac,3)
   Message('- REPOS Vinculadas')
EndIf
If FBN['Num'] = 10
   ACT(a:FAC, "CAUCIONES")
   SetFont(a:fac..a:fac,3)
   Message('- Cauciones')
EndIf

ACT(aa:10, Val(a:fac))
IFA
