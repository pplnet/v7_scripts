*--------Todas las cuentas con saldo por mercado para la especie que corta-----------*
SQL.ADD(" SELECT S.Cliente,     S.Especie,      S.Cupon,       S.Mercado, ")
SQL.ADD("        S.Cuenta,      S.EnteCustodia, S.NrSaldo,     S.Saldo, ")
SQL.ADD("        C.RazonSocial, E.ISIN,         E.TamanioLote, S.NrSaldo, ")
SQL.ADD("        S.Book,        S.Fecha ")
SQL.ADD(" from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E")
SQL.ADD(" WHERE S.Cliente = C.Codigo  ")
SQL.ADD("   AND C.Status  = 'HAB' ")
SQL.ADD("   AND S.Especie = E.Codigo  ")
SQL.ADD("   AND S.Especie = '"~VAL(b2)~"' ")
SQL.ADD("   AND S.Cliente = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   AND S.Cupon   =  '"~FSTR(VAL(c2),1,0)~"' ")
SQL.ADD("   AND S.Fecha  <= "~IdxDate2(VAL(g2))~" ")
SQL.ADD("   AND S.Fecha  IN (Select MAX(Fecha) ")
SQL.ADD("                      from "~DBO~".SALDOSDIA ")
SQL.ADD("                     where Cliente  = S.Cliente ")
SQL.ADD("                       and Especie  = S.Especie ")
SQL.ADD("                       and NrSaldo  = S.NrSaldo ")
SQL.ADD("                       and (Mercado = S.Mercado or (Mercado IS NULL and S.Mercado IS NULL) or (Mercado = '' and S.Mercado = '') or (Mercado = ' ' and S.Mercado = ' ')) ")
SQL.ADD("                       and (Cuenta  = S.Cuenta  or (Cuenta  IS NULL and S.Cuenta IS NULL)) ")
SQL.ADD("                       and (Cupon   = S.Cupon   or (Cupon   IS NULL and S.Cupon IS NULL))  ")
SQL.ADD("                       and (Book = S.Book or (Book IS NULL and S.Book IS NULL) or (Book = '' and S.Book = '') or (Book = ' ' and S.Book = ' ')) ")
SQL.ADD("                       and (EnteCustodia = S.EnteCustodia OR ('"~Dialogo.Vehiculo1~"'=S.Cliente)) ")
SQL.ADD("                       and Fecha   <= "~IdxDate2(VAL(g2))~") ")
SQL.ADD(" ORDER BY S.Cliente, S.Mercado, S.Cuenta")

SetFilaActual(9)
ACN(z1,0)

Recorrer SQL
  ACN(x1, fbn('Saldo'))
  IF Val(x1)<>0
     ACT(a:fac, fbn('Cliente'))
     ACT(b:fac, Val(b2))
     ACT(c:fac, FStr(VAL(c2),1,0))
     ACT(d:fac, fbn('Mercado'))
     ACT(f:fac, fbn('Cuenta'))
     ACT(BK:fac, fbn('Book'))
     ACN(g:fac, Val(x:1))
     ACN(h:fac, FBN['NrSaldo'])
     ACD(FE:fac, fbn('Fecha'))
     ACN(k:fac, 1)
     ACT(l:fac, '')
     ACN(z:1, 1)
     ***---Chequeo si paga con Pik
     ACN(PW:fac, SQL(" Select PorPIK From "~DBO~".AGENDACUPONES Where Especie = '"~Val(B:2)~"' AND NrCupon = "~Fstr(Val(C:2), 0, 0)~" "))
     IF Val(PW:fac) > 0
        ACN(PK:fac, Val(X:1) * Val(PW:fac) / 100)
     ENDIF
  ELSE
     dfa
  ENDIF
Proximo

IF Val(z:1)<>0
  CrearListBox ; 'Arial,8,';'Corte de Saldos de Clientes.'
   'OK'          ;k:10..k:fac  ;SI;;; 40;CHECK ;RGB(255,255,193)
   'Cliente'     ;a:10..a:FAC  ;NO;;; 70;STRING;;RGB(220,220,193)
   'Especie'     ;b:10..b:FAC  ;NO;;; 60;STRING;;RGB(220,220,193)
   'Cupon'       ;c:10..c:FAC  ;NO;;; 40;STRING;;RGB(220,220,193)
   'Cuenta'      ;f:10..f:FAC  ;NO;;;100;STRING;;RGB(220,220,193)
   'Cantidad'    ;g:10..g:FAC  ;NO;;;120;NUMERO;'###,###,###,###.##';RGB(220,220,193)
   '% Pik'       ;PW:10..PW:FAC  ;NO;;;60;NUMERO;'###.########';RGB(220,220,193)
   'Cant.Pikeo'  ;PK:10..PK:FAC  ;NO;;;120;NUMERO;'###,###,###,###.##';RGB(220,220,193)
   'NrSaldo'     ;h:10..h:FAC  ;NO;;; 50;NUMERO;'###';RGB(220,220,193)
   'Fecha'       ;FE:10..FE:FAC;NO;;; 80;FECHA ;RGB(220,220,193)
   'Book'        ;BK:10..BK:FAC;NO;;; 60;STRING;;RGB(220,220,193)
  FinListBox
  *-   'Mercado'     ;d:100..d:FAC;NO;;; 60;STRING;;RGB(220,220,193)
  IF NOT OK 
    Cancelar
  ENDIF

  Recorrer&i 10,fac

    IF Val(k:&i)=1
***---    ACT(Y1,GetNumerador(20))
      ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', Val(J:2))))
                         
      *--------------- Insertar una transaccion para actualizar el saldo
      SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
      SQL.ADD(" Especie, Especie2, Cupon1 ,")
      SQL.ADD(" CB5, Fecha1, Fecha2, ")
      SQL.ADD(" Cliente1, Cantidad1, Precio1, ")
      SQL.ADD(" Precio2, Precio3, Cambio1, ")
      SQL.ADD(" Cambio2, Vehiculo1, TipoTr2, ")
      SQL.ADD(" NrTrans, Mercado1, Cuenta2, ")
      SQL.ADD(" Cuenta6, Cuenta1, FechaCarga, ")
      SQL.ADD(" FechaCargaSys, UsrInput, Cupon2, ")
      SQL.ADD(" Cantidad4, Cambio3, Ley1, Precio4, Cantidad5 ")
      SQL.ADD(" ) VALUES ( ")
      * Especie
      SQL.ADD(" '"~Val(b:2)~"', ")
      * Especie2
      SQL.ADD(" '"~Val(b:4)~"', ")
      * Cupon1
      SQL.ADD(" '"~FStr(Val(c:2),1,0)~"',")

      * CB5
      If Round2(Val(e:3),3)=0
        SQL.ADD(" '1', ")
      Else
        SQL.ADD(" '0', ")
      Endif
***---    SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~IdxDate(Val(h:4))~"', '"~Val(a:&i)~"', ")
      * Fecha1
      SQL.ADD(" '"~IdxDate(Val(g:2))~"', ")
      * Fecha2
      SQL.ADD(" '"~IdxDate(Val(h:2))~"', ")

      * Cliente1
      SQL.ADD(" '"~Val(a:&i)~"', ")
      * Cantidad1
      SQL.ADD(" "~FStr(Val(g:&i),1,2)~", ")
      * Precio1
      SQL.ADD(" "~FStr(Val(k:2),1,8)~", ")

      * Precio2
      SQL.ADD(" "~FStr(Val(l:2),1,8)~", ")
      * Precio3
      SQL.ADD(" "~FStr(Val(m:2),1,8)~", ")
      * Cambio1
      SQL.ADD(" "~FStr(Val(e:2),1,8)~", ")

      * Cambio2
      SQL.ADD(" "~FStr(Val(e:3),1,8)~", ")
      * Vehiculo1
      SQL.ADD(" '"~VAL(j:2)~"', ")
      * TipoTr2
      SQL.ADD(" 'CUPON', ")

      * NrTrans
      SQL.ADD(" '"~Val(Y1)~"', ")
      * Mercado1
      SQL.ADD(" '"~Val(d:&i)~"', " )
      * Cuenta2
      SQL.ADD(" '"~Val(f:&i)~"', ")

      * Cuenta6
      SQL.ADD(" '"~Val(f:&i)~"', ")
      * Cuenta1
      SQL.ADD(" '"~Val(m:&i)~"', ")
      * FechaCarga
      SQL.ADD(" "~SQLAhora~", ")

      * FechaCargaSys
      SQL.ADD(" '"~IdxDate(Fsys)~"', ")
      * UsrInput
      SQL.ADD(" '"~UsuarioActivo~"', ")
      * Cupon2
      SQL.ADD(" '"~FStr(Val(c:4),1,0)~"', ")

      * Cantidad4 (Saldo)
      SQL.ADD(" "~FStr(Val(h:&i),1,0)~", ")
      * Cambio3
      SQL.ADD(" "~FStr(Val(in:1),1,8)~", ")
      * Ley1 (Book)
      SQL.ADD(" '"~Val(BK:&i)~"', ")
      * Precio4 (%PIK)
      SQL.ADD(" '"~Val(PW:&i)~"', ")
      * Cantidad5 (Pikeo)
      SQL.ADD(" "~Fstr(Trunc(Val(PK:&i)), 0, 2)~" ")
      SQL.ADD(" ) ")
      SQL.NEW 

      SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
      SQL.ADD("(NrBit, NrOperacion, Valor) ")
      SQL.ADD(" VALUES ")
      SQL.ADD("(20, '"~Val(y1)~"', '1') ")
      SQL.NEW
      SQL.EXEC

      SQL.ActualizarMovimientosT4(Val(y:1),SI,NO,NO,SI,NO,SI,0)
      SQL.EXEC
* MessageBox('Llama CCUPONPOS - Esp.: '~Val(b:2)~' Veh.: '~Val(j:2)~' Book: '~Val(bk:&i)~' Sal: '~FStr(Val(h:&i),1,0))
      (.'CCUPONPOS'.)
    ENDIF
  Proximo
ELSE
   Message('Noy hay saldos para cortar.')
ENDIF
