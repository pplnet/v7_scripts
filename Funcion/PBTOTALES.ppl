      ACT(a:fac, 'Total '~Val(mo:1)~' ->')
      ACN(b:fac, SUM(b:Val(fm:1)..b:fac))
      ACN(c:fac, SUM(c:Val(fm:1)..c:fac))
      ACN(d:fac, SUM(d:Val(fm:1)..d:fac))
      ACN(e:fac, SUM(e:Val(fm:1)..e:fac))
      ACN(f:fac, SUM(f:Val(fm:1)..f:fac))
      ACN(g:fac, SUM(g:Val(fm:1)..g:fac))
      ACN(h:fac, SUM(h:Val(fm:1)..h:fac))
      ACN(i:fac, SUM(i:Val(fm:1)..i:fac))
      ACN(j:fac, SUM(j:Val(fm:1)..j:fac))
      ACN(k:fac, SUM(k:Val(fm:1)..k:fac))
      ACN(l:fac, SUM(l:Val(fm:1)..l:fac))
      ACN(m:fac, SUM(m:Val(fm:1)..m:fac))
      ACN(n:fac, SUM(n:Val(fm:1)..n:fac))

      ACT(aa:val(ac:1), val(mo:1))
      ACN(ab:val(ac:1), val(n:fac))
      SCN(ac:1,1)

      *- Saldo por Especie para el CARA
      SCN(ca1,val(n:fac))

      ACN(p:fac, SUM(p:Val(fm:1)..p:fac))
      SetFont(a:fac..z:fac,5)
      AgregarMarco(a:fac..n:fac,0,0,0)
      AgregarMarco(p:fac..p:fac,0,0,0)
      FormatoCeldas(b:fac..z:fac, EXE('F2'))
      ifa
