IF Dialogo.Radio8 = 0
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS (Hoja 1)') 
ELSE
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS AHEAD (Hoja 1)')   
ENDIF
SetFont(a3..a3, 3)


ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

If NoVacio(val(zz6))
   ACT(f5, 'Vehiculo : '~val(zz6))
Else
   ACT(f5, 'Vehiculo : Todos ')
EndIf

If NoVacio(Dialogo.Lista3)
  ACT(f6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
Else
  if Dialogo.Radio6=0
    ACT(f6,'Clientes: TODOS' )   
  else
    if Dialogo.Radio6=1
      ACT(f6,'Clientes: Vinculados' )   
    else
      ACT(f6,'Clientes: Terceros' )   
    endif
  endif
Endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(f7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(f7,'Especies: TODAS' )   
endif

ACT(d6,'Origen: TODOS ')


SetFont(a4..z7, 2)
	