SQl.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
SQL.ADD("Set PrecioEj = '"~Fstr(&TCContable,0,6)~"' ")
IF &totalCP > 0
    SQL.ADD(", Cantidad1 = '"~Fstr(&totalCP,0,2)~"'")
ENDIF
IF &total3ros > 0
    SQL.ADD(", Cantidad2 = '"~Fstr(&total3ros,0,2)~"' ")
ENDIF
SQL.ADD("WHERE NrTrans = '"~&nrTrans~"' ")
SQL.NEW
SQL.EXEC
