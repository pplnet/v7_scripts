***---Esta fc calcula DC entre dos fechas
***---MO:55 = Monto para calcular DC
***---FD:55 = Fecha Desde
***---FH:55 = Fecha Hasta
***---DK:55 = DC Diaria en Moneda Fuerte ARP
***---DK:66 = DC Diaria en Moneda Local
***---DK:77 = DC Diaria en Moneda Grupo USD
********************
*UPDATE 11/09/2023
*Se reemplazan celdas por variables para mayor claridad:
********************
***---MO:88 = &monedaOp
***---AL:88 = &monedaLocal
***---MO:55 = &capital
***---DK:55 = &dcCapitalMonFuerte
***---DK:66 = &dcCapitalMonLocal
***---DK:77 = &dcCapitalMonGrupo

IF Eqstr(&monedaOp, Val(ME:1))
    let &tcHoy CotizacionBNA(&monedaOp,Val(FH:55),Val(AP:1),NO,NO)  
    let &tcAyer CotizacionBNA(&monedaOp,Val(FD:55),Val(AP:1),NO,NO)
    *ACN(DK:55, (Val(MO:55) * &tcHoy) - (Val(MO:55) * &tcAyer))
    let &dcCapitalMonFuerte ( (&capital * &tcHoy) - (&capital * &tcAyer) )
   IF Eqstr(&monedaLocal, Val(ML:1))
       *ACN(DK:66, Val(DK:55))
       let &dcCapitalMonLocal &dcCapitalMonFuerte
   ELSE
     *ACN(DK:66, (Val(MO:55) * CotizacionBCU(Val(MO:88),Val(FH:55),Val(AP:1),NO,NO)) - (Val(MO:55) * CotizacionBCU(Val(MO:88),Val(FD:55),Val(AP:1),NO,NO)))
     let &dcCapitalMonLocal ((&capital * CotizacionBCU(&monedaOp,Val(FH:55),Val(AP:1),NO,NO)) - (&capital * CotizacionBCU(&monedaOp,Val(FD:55),Val(AP:1),NO,NO)))
   ENDIF
   *ACN(DK:77, 0)
   let &dcCapitalMonGrupo 0
ELSE
   IF Eqstr(&monedaOp, Val(ML:1))
       *ACN(DK:55, 0)
       let &dcCapitalMonFuerte 0
      IF Eqstr(&monedaLocal, Val(ML:1))
          *ACN(DK:66, &dcCapitalMonFuerte)
          let &dcCapitalMonLocal &dcCapitalMonFuerte
      ELSE
          *ACN(DK:66, (Val(MO:55) * CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (Val(MO:55) * CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
          let &dcCapitalMonLocal ((&capital * CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (&capital * CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
      ENDIF
      let &tcHoy CotizacionBNA(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)
      let &tcAyer CotizacionBNA(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)
      *ACN(DK:77, (Val(MO:55) / &tcHoy) - (Val(MO:55) / &tcAyer))
      let &dcCapitalMonGrupo ((&capital / &tcHoy) - (&capital / &tcAyer))
   ELSE
      IF Eqstr(&monedaOp, Val(MU:1))
        *ACN(DK:55, (&capital / CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (&capital / CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
         let &dcCapitalMonFuerte (&capital / CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (&capital / CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO))
        IF Eqstr(&monedaLocal, Val(ML:1))
            *ACN(DK:66, (Val(MO:55) / CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (Val(MO:55) / CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
            let &dcCapitalMonLocal ((&capital / CotizacionBNABCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (&capital / CotizacionBNABCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
         ELSE
            *ACN(DK:66, 0)
            let &dcCapitalMonLocal 0 
         ENDIF
         *ACN(DK:77, (Val(MO:55) / CotizacionBCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (Val(MO:55) / CotizacionBCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
         let &dcCapitalMonGrupo ((&capital / CotizacionBCU(Val(ME:1),Val(FH:55),Val(AP:1),NO,NO)) - (&capital / CotizacionBCU(Val(ME:1),Val(FD:55),Val(AP:1),NO,NO)))
      ENDIF
   ENDIF
ENDIF

**// Si es Op. Vinculada se saca el promedio de las Cotizacion de Compra y Venta
If EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',Val(TO:88)),VAR('CLASEOPVIN'))
   IF Eqstr(&monedaOp, Val(ME:1))
      let &tcHoy CotizacionBNA(&monedaOp,Val(FH:55),1,NO,NO) + CotizacionBNA(&monedaOp,Val(FH:55),2,NO,NO)/2
      let &tcAyer CotizacionBNA(&monedaOp,Val(FD:55),1,NO,NO) + CotizacionBNA(&monedaOp,Val(FD:55),2,NO,NO)/2
      *ACN(CT:1, (CotizacionBNA(Val(MO:88),Val(FH:55),1,NO,NO) + CotizacionBNA(Val(MO:88),Val(FH:55),2,NO,NO))/2)
      *ACN(CT:2, (CotizacionBNA(Val(MO:88),Val(FD:55),1,NO,NO) + CotizacionBNA(Val(MO:88),Val(FD:55),2,NO,NO))/2)
      *ACN(DK:55, (&capital * &tcHoy) - (&capital * &tcAyer))
      let &dcCapitalMonFuerte ((&capital * &tcHoy) - (&capital * &tcAyer))
      IF Eqstr(&monedaLocal, Val(ML:1))
          *ACN(DK:66, Val(DK:55))
          let &dcCapitalMonLocal &dcCapitalMonFuerte
      ELSE
         ACN(CT:1, (CotizacionBCU(&monedaOp,Val(FH:55),1,NO,NO) + CotizacionBCU(&monedaOp,Val(FH:55),2,NO,NO))/2)
         ACN(CT:2, (CotizacionBCU(&monedaOp,Val(FD:55),1,NO,NO) + CotizacionBCU(&monedaOp,Val(FD:55),2,NO,NO))/2)
         *ACN(DK:77, (Val(MO:55) / &tcHoy) - (Val(MO:55) / &tcAyer))
         let &dcCapitalMonLocal ((&capital * Val(CT:1)) - (&capital * Val(CT:2)))

      ENDIF
      *ACN(DK:77, 0)
      let &dcCapitalMonGrupo 0
   ELSE
      IF Eqstr(&monedaOp, Val(ML:1))
         *ACN(DK:55, 0)
         let &dcCapitalMonFuerte 0
         IF Eqstr(&monedaLocal, Val(ML:1))
            *ACN(DK:66, Val(DK:55))
            let &dcCapitalMonLocal &dcCapitalMonFuerte
         ELSE
            ACN(CT:1, (CotizacionBNABCU(Val(ME:1),Val(FH:55),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FH:55),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBNABCU(Val(ME:1),Val(FD:55),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FD:55),2,NO,NO))/2)
            *ACN(DK:66, (Val(MO:55) * Val(CT:1)) - (Val(MO:55) * Val(CT:2)))
            let &dcCapitalMonLocal ((&capital * Val(CT:1)) - (&capital * Val(CT:2)))
         ENDIF
         let &tcHoy (CotizacionBNA(Val(ME:1),Val(FH:55),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FH:55),2,NO,NO))/2
         let &tcAyer (CotizacionBNA(Val(ME:1),Val(FD:55),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FD:55),2,NO,NO))/2
         *ACN(CT:1, (CotizacionBNA(Val(ME:1),Val(FH:55),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FH:55),2,NO,NO))/2)
         *ACN(CT:2, (CotizacionBNA(Val(ME:1),Val(FD:55),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FD:55),2,NO,NO))/2)
         *ACN(DK:77, (Val(MO:55) / &tcHoy) - (Val(MO:55) / &tcAyer))
         let &dcCapitalMonGrupo ((&capital / &tcHoy) - (&capital / &tcAyer))
      ELSE
         IF Eqstr(&monedaOp, Val(MU:1))
            ACN(CT:1, (CotizacionBNABCU(Val(ME:1),Val(FH:55),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FH:55),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBNABCU(Val(ME:1),Val(FD:55),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FD:55),2,NO,NO))/2)
            *ACN(DK:55, (&capital / Val(CT:1)) - (&capital / Val(CT:2)))
            let &dcCapitalMonFuerte ((&capital / Val(CT:1)) - (&capital / Val(CT:2)) )
            IF Eqstr(&monedaLocal, Val(ML:1))
                *ACN(DK:66, Val(DK:55))
                let &dcCapitalMonLocal &dcCapitalMonFuerte
            ELSE
                *ACN(DK:66, 0)
                let &dcCapitalMonLocal 0
            ENDIF
            ACN(CT:1, (CotizacionBCU(Val(ME:1),Val(FH:55),1,NO,NO) + CotizacionBCU(Val(ME:1),Val(FH:55),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBCU(Val(ME:1),Val(FD:55),1,NO,NO) + CotizacionBCU(Val(ME:1),Val(FD:55),2,NO,NO))/2)
            *ACN(DK:77, (Val(MO:55) / Val(CT:1)) - (Val(MO:55) / Val(CT:2)))
            let &dcCapitalMonGrupo ((&capital / Val(CT:1)) - (&capital / Val(CT:2)))
         ENDIF
      ENDIF
   ENDIF
ENDIF