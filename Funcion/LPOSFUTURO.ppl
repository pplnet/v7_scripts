  SQL.ADD("Select TipoOp, Cantidad, Precio1, FechaVto, ContraEspecie, Especie, FechaEj, PrecioEj, MB3, MB1 from "~DBO~".OPERACIONES where ")
  SQL.ADD("((TipoOp in ('SECT','SEVT','SECTV','SEVTV') and PaseCB='0' and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') or ")
  SQL.ADD("(TipoOp in ('DSEO') and FechaEj > '"~IdxDate(Dialogo.Fecha1)~"'))")
  SQL.ADD("and FechaOp <= '"~Idxdate(Dialogo.Fecha1)~"' and Especie='"~fbn('Codigo')~"' ")
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and Vehiculo1 in ("~Val(z11)~")")
  endif
  recorrer SQL
    dfa
    if Incluido(fbn('TipoOp'), 'DSEO')
      ACN(z7, fbn('Cantidad')*Cotizacion(fbn('Especie'),IIF(EqStr(fbn('MB1'),'0'),'C','P'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1))
      if EqStr(fbn('MB3'), '1')
        ACN(z7, -Val(z7))
      endif
    else
      if Incluido(fbn('TipoOp'), 'SECT|SECTV')
        ACN(z7, fbn('Cantidad')*Cotizacion(fbn('Especie'),'F',fbn('FechaVto'),,Dialogo.Fecha1,1))
      else
        ACN(z7, -fbn('Cantidad')*Cotizacion(fbn('Especie'),'F',fbn('FechaVto'),,Dialogo.Fecha1,1))
      endif
      if EqStr(fbn('ContraEspecie'), 'ARP')
        ACN(z7, Val(z7)/Cotizacion('USD',,,,Dialogo.Fecha1,1))
      endif
    endif
    SCN(z8, Val(z7)/1000)
  proximo
