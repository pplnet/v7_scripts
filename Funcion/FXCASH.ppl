MostrarCuadroDeMensajes
Message('FX CashFlow ')

SCN(c:200,1)
SCN(f:200,1)

***---Esta linea comentada corresponde a impuestos, queda pte. definir cuando va en este query
***---y cuando en el query de monto
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad)/1000 Cant ")
SQL.ADD(" From "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  Else
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
Endif
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, O.ContraEspecie2 ")
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad)/1000 Cant ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
     Else
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
   Endif
   SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, O.ContraEspecie2 ")
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
   Message('Listando FX')
   *** Diario o Mensual ***
   ACN(MT:11, 0)
   ACN(MT:12, 0)
   ACN(MT:13, 0) 
    
*   ACN(MT:12, IIf(Eqstr(SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~FBN('Especie')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1)))
   ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   ***---Variable pte. hasta definicion de impuestos
*   ACN(MT:13, IIf(Eqstr(SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~FBN('MonImp')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('MonImp'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('MonImp'),,,,Dialogo.Fecha1,1)))
      
   ***---FX no tiene Intereses
   If Dialogo.Check1 = 1
      ***---Capital
      SCN(MT:11, FBN('Cant') * Val(MT:12))
   Endif
*   If Dialogo.Check3 = 1
*       ***---Impuestos
*       SCN(MT:11, FBN('Imp') * Val(MT:13))
*   Endif
    
   If Dialogo.Radio2 = 0
      *** Diario ***
      Recorrer&i 2, Val(d:200)-1
         If FBN['Fecha'] = Val(&i:10)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(c:200)+1, Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Else
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Endif
      Proximo
      Recorrer&i Val(d:200)+1, Val(g:200)-1
         If FBN['Fecha'] = Val(&i:10)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(c:200)+1, Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Else
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Endif
      Proximo
   Else
      *** Mensual ***
      Recorrer&i Val(m:200), Val(n:200)
         If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(c:200)+1, Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Else
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Endif
      Proximo
      Recorrer&i Val(o:200), Val(p:200)
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(c:200)+1, Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Else
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Endif
      Proximo
      If Val(o:200) > 0
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(Val(p:200)+1:Val(c:200)+1, Val(MT:11))
               SCN(Val(p:200)+1:Val(h:200), Val(MT:11))
            Else
               SCN(Val(p:200)+1:Val(f:200), Val(MT:11))
               SCN(Val(p:200)+1:Val(i:200), Val(MT:11))
            Endif
         Endif
      Endif
      Recorrer&i Val(d:200), Val(g:200)
         If Anio(FBN['Fecha']) = Val(&i:280)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(c:200)+1, Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Else
               SCN(&i:Val(f:200), Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Endif
         Endif
      Proximo
      If Anio(FBN['Fecha']) > Val(Val(g:200):280)
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            SCN(Val(g:200):Val(c:200)+1, Val(MT:11))
            SCN(Val(g:200):Val(h:200), Val(MT:11))
         Else
            SCN(Val(g:200):Val(f:200), Val(MT:11))
            SCN(Val(g:200):Val(i:200), Val(MT:11))
         Endif
      Endif
   Endif
Proximo

SQL.ADD("Select O.Vehiculo1, O.TipoOp, O.FechaPago Fecha, O.ContraEspecie, ")
SQL.ADD("Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
Endif
SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaPago ")
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.TipoOp, O.FechaPago Fecha, O.ContraEspecie, ")
   SQL.ADD("Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Else
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
   Endif
   SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaPago ")
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
   Message('Monto')
   *** Diario o Mensual ***
   ACN(MT:11, 0)
   If Dialogo.Check1 = 1
      ACN(MT:11, FBN('Monto') * CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   Endif
   If Dialogo.Radio2 = 0
      *** Diario ***
      Recorrer&i 2, Val(d:200)-1
         If FBN['Fecha'] = Val(&i:10)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(f:200)+1, Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Else
               SCN(&i:Val(c:200), Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Endif
         Endif
      Proximo
      Recorrer&i Val(d:200)+1, Val(g:200)-1
         If FBN['Fecha'] = Val(&i:10)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(f:200)+1, Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Else
               SCN(&i:Val(c:200), Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Endif
         Endif
      Proximo
   Else
      *** Mensual ***
      Recorrer&i Val(m:200), Val(n:200)
         If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(f:200)+1, Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Else
               SCN(&i:Val(c:200), Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Endif
         Endif
      Proximo
      Recorrer&i Val(o:200), Val(p:200)
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(f:200)+1, Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Else
               SCN(&i:Val(c:200), Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Endif
         Endif
      Proximo
      If Val(o:200) > 0
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(Val(p:200)+1:Val(f:200)+1, Val(MT:11))
               SCN(Val(p:200)+1:Val(i:200), Val(MT:11))
            Else
               SCN(Val(p:200)+1:Val(c:200), Val(MT:11))
               SCN(Val(p:200)+1:Val(h:200), Val(MT:11))
            Endif
         Endif
      Endif
      Recorrer&i Val(d:200), Val(g:200)
         If Anio(FBN['Fecha']) = Val(&i:280)
            If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
               SCN(&i:Val(f:200)+1, Val(MT:11))
               SCN(&i:Val(i:200), Val(MT:11))
            Else
               SCN(&i:Val(c:200), Val(MT:11))
               SCN(&i:Val(h:200), Val(MT:11))
            Endif
         Endif
      Proximo
      If Anio(FBN['Fecha']) > Val(Val(g:200):280)
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            SCN(Val(g:200):Val(f:200)+1, Val(MT:11))
            SCN(Val(g:200):Val(i:200), Val(MT:11))
         Else
            SCN(Val(g:200):Val(c:200), Val(MT:11))
            SCN(Val(g:200):Val(h:200), Val(MT:11))
         Endif
      Endif
   Endif
Proximo
