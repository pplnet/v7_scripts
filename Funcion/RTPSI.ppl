acn(m:fac,FBN['Spread'])
*- Interes
acn(o:fac,val(j:fac)*((val(l:fac)+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))

*- IVA
acn(q:fac,((val(j:fac)*(val(av:fac)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)) * (FBN['ImpGastos2']/100))

*- WH
acn(p:fac,((val(j:fac)*(val(aw:fac)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)) * (FBN['TotalAux1']/100))

*- Imp.Interes
acn(v:fac,val(o:fac)*(FBN['TasaImp1']/100))

*- Interes Total
acn(ab:fac,val(o:fac)+iif(FBN['CB10']=1,val(p:fac),0)+val(v:fac))

acn(z:fac, val(j:fac)+val(o:fac) )
acn(aa:fac,val(j:fac)+val(ab:fac))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')

