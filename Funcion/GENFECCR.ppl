ACN(FI:1, fac)
ACN(FI:3, fac)
ACN(FI:4, fac)
***---Armo Columna de Fechas
Recorrer&k Dialogo.Fecha1, Dialogo.Fecha2
    IF &k = Dialogo.Fecha1
        ***---Fila para poner la entidad
        ifa
    ENDIF
    ACD(A:&k-Dialogo.Fecha1+fac, Dialogo.Fecha2 - (Dialogo.Fecha2-&k))
    IF Val(A:&k-Dialogo.Fecha1+fac) = FinDeMes(Val(A:&k-Dialogo.Fecha1+fac), SI) Y Mes(Val(A:&k-Dialogo.Fecha1+fac-1)) <> Mes(Dialogo.Fecha2)
        ifa
        InsertarFila(&k-Dialogo.Fecha1+fac)
        ACT(A:&k-Dialogo.Fecha1+fac, 'Total '~Meses(Mes(Val(A:&k-Dialogo.Fecha1+fac-1)))~' '~Copy(Fstr(Anio(Val(A:&k-Dialogo.Fecha1+fac-1)), 0, 4), 3, 2))
        SetFont(A:&k-Dialogo.Fecha1+fac..J:&k-Dialogo.Fecha1+fac, 2)
        AlinearCeldas(A:&k-Dialogo.Fecha1+fac, 'D')
    ENDIF
    ACN(FI:2, &k-Dialogo.Fecha1+fac)
Proximo
SCN(FI:2, 1)
ACT(A:Val(FI:2), 'Total '~Meses(Mes(Val(A:Val(FI:2)-1)))~' '~Copy(Fstr(Anio(Val(A:Val(FI:2)-1)), 0, 4), 3, 2))
SetFont(A:Val(FI:1)..A:Val(FI:2), 2)
AlinearCeldas(A:Val(FI:2), 'D')