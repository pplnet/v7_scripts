
* -----> Edicion De La Condicion De I.V.A.

* ZB:07 ==> Valor A Editar
* ZB:08 ==> Valor Devuelto

ACT(ZB:08, " Cond. I.V.A.: ")

If [NoVacio(Val(ZB:07))]
   If [EqStr(Val(ZB:07), "INS")]
      ACT(ZB:08, Val(ZB:08) ~ "Inscripto")
   Else
      If [EqStr(Val(ZB:07), "NOI")]
         ACT(ZB:08, Val(ZB:08) ~ "No Inscripto")
      Else
         If [EqStr(Val(ZB:07), "EXE")]
            ACT(ZB:08, Val(ZB:08) ~ "Exento")
         Else
            If [EqStr(Val(ZB:07), "FIN")]
               ACT(ZB:08, Val(ZB:08) ~ "Consumidor Final")
            Else
               If [EqStr(Val(ZB:07), "MON")]
                  ACT(ZB:08, Val(ZB:08) ~ "Monotributista")
               EndIf    
            EndIf
         EndIf
      EndIf
   EndIf
EndIf
