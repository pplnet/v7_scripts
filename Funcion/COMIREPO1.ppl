Mercado           : 'Mercado_SP'                 ;1;1;2;;;NoVacio(MERCADO) O SI;'Debe indicar Mercado de Operacion Spot';NO;'CV';;
ContraEspecie3    : 'Mon_Comision'               ;1;2;2;Not Incluido(MERCADO,'OTC');NO Y Not Incluido(MERCADO,'OTC');SI O Incluido(MERCADO,'OTC') O NoVacio(CONTRAESPECIE3);'Moneda de Comision de Mercado INVALIDA';NO;'USD';
PorComMer1        : '%_Comision'                 ;2;1;2;Not Incluido(MERCADO,'OTC');Not Incluido(MERCADO,'OTC');Incluido(MERCADO,'OTC') O PORCOMMER1>0  O VACIO(MERCADO) O SI;'Debe INGRESAR  un % de COMISION DEL MERCADO Spot';NO;;
TCComMer1         : 'Tipo_Cambio'                ;2;2;2;Not Incluido(MERCADO,'OTC');NO Y Not Incluido(MERCADO,'OTC');SI O TCCOMMER1>=0;'Tipo de Cambio del Mercado INVALIDO';NO;;
ImpComMer1        : 'Imp_Comision'               ;3;1;2;NO;Not Incluido(MERCADO,'OTC');;;;;(TOTALBRUTOCLI1+TOTALINTERESES)*(PORCOMMER1/100)
ImpComMerEq1      : 'Importe_Eq.'                ;3;2;2;NO;NO Y Not Incluido(MERCADO,'OTC');SI;;;;(TOTALBRUTOCLI1+TOTALINTERESES)*(PORCOMMER1/100)*IF(EQSTR(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~CONTRAESPECIE3~"' "),'DIR'),TCCOMMER1,IF(TCCOMMER1<>0,1/TCCOMMER1,0))

Corredor          : 'Corredor_SP'                ;4;1;2;
ContraEspecie2    : 'Mon_Comision'               ;4;2;2;NoVacio(CORREDOR);NO;SI O Vacio(CORREDOR) O [NoVacio(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;'USD'
PorComCor1        : '%_Comision'                 ;5;1;2;NoVacio(CORREDOR);;;;;;IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR));
TCComCor1         : 'Tipo_Cambio'                ;5;2;2;NoVacio(CORREDOR);NO;SI O Vacio(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;
ImpComCor1        : 'Imp_Comision'               ;6;1;2;NO;;;;;;(TOTALBRUTOCLI1/PRECIO1)*(PORCOMCOR1/100)
ImpComCorEq1      : 'Importe_Eq.'                ;6;2;2;NO;NO;SI;;;;IMPCOMCOR1*IF(EQSTR(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~CONTRAESPECIE2~"' "),'DIR'),TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))
RB7               : 'Deducible|Si|No'            ;7;1;2;NoVacio(CORREDOR);NO;Vacio(CORREDOR) O RB7>=0;'Indique Deducible / No Deducible';NO;1;
TasaImp1          : '%IVA SP'                    ;5;2;2;;;Incluido(Fstr(TASAIMP1,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Corredor SP es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA') ;;;;;;'#####.#####'
TotalIVA          : 'IVA SP'                     ;6;2;2;NO;;[TOTALIVA<= ROUND((IMPCOMCOR1*TASAIMP1/100)*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND((IMPCOMCOR1*TASAIMP1/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Corredor SP Fuera de Rango: '~Fstr(ROUND((IMPCOMCOR1*TASAIMP1/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((IMPCOMCOR1*TASAIMP1/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(IMPCOMCOR1*TASAIMP1)/100;;;;;'###,###,###,###,###.##'


Mercado2          : 'Mercado_FU'                 ;8;1;2;;;NoVacio(MERCADO2) O SI;'Debe indicar Mercado de Operacion Futuro';NO;'CV';;
ContraEspecie4    : 'Mon_Comision'               ;8;2;2;Not Incluido(MERCADO2,'OTC');NO Y Not Incluido(MERCADO2,'OTC');SI O Incluido(MERCADO2,'OTC') O NoVacio(CONTRAESPECIE4);'Moneda de Comision de Mercado Op.Futuro INVALIDA';NO;'USD';
PorComMer2        : '%_Comision'                 ;9;1;2;Not Incluido(MERCADO2,'OTC');Not Incluido(MERCADO2,'OTC');Incluido(MERCADO2,'OTC') O PORCOMMER2>0  O VACIO(MERCADO2) O SI;'Debe INGRESAR  un % de COMISION DEL MERCADO Op.Futuro';NO;;
TCComMer2         : 'Tipo_Cambio'                ;9;2;2;Not Incluido(MERCADO2,'OTC');NO Y Not Incluido(MERCADO2,'OTC');SI O TCCOMMER2>=0;'Tipo de Cambio del Mercado de Operacion Futuro INVALIDO';NO;;
ImpComMer2        : 'Imp_Comision'               ;10;1;2;NO;Not Incluido(MERCADO2,'OTC');;;;;(TOTALBRUTOCLI2+TOTALDERECHOS)*(PORCOMMER2/100)
ImpComMerEq2      : 'Importe_Eq.'                ;10;2;2;NO;NO Y Not Incluido(MERCADO2,'OTC');SI;;;;(TOTALBRUTOCLI2+TOTALDERECHOS)*(PORCOMMER2/100)*IF(EQSTR(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~CONTRAESPECIE4~"' "),'DIR'),TCCOMMER2,IF(TCCOMMER2<>0,1/TCCOMMER2,0))

Corredor2         : 'Corredor_FU'                ;11;1;2;
ContraEspecie5    : 'Mon_Comision'               ;11;2;2;NoVacio(CORREDOR2);NO;SI O Vacio(CORREDOR2) O [NoVacio(CONTRAESPECIE5) y DESCIENDEDEESPECIE(CONTRAESPECIE5,'MONEDA') y ESTERMINAL(CONTRAESPECIE5,ESPECIE)];'Especie de Pago Comision CORREDOR OP. Futuro INVALIDA';NO;'USD'
PorComCor2        : '%_Comision'                 ;12;1;2;NoVacio(CORREDOR2);;;;;;IF(MODI,PORCOMCOR2,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR2));
TCComCor2         : 'Tipo_Cambio'                ;12;2;2;NoVacio(CORREDOR2);NO;SI O Vacio(CORREDOR2) O TCCOMCOR2>=0;'Tipo de Cambio del CORREDOR de Op.Futuro INVALIDO';NO;;
ImpComCor2        : 'Imp_Comision'               ;13;1;2;NO;;;;;;(TOTALBRUTOCLI2/PRECIO2)*(PORCOMCOR2/100)
ImpComCorEq2      : 'Importe_Eq.'                ;13;2;2;NO;NO;SI;;;;IMPCOMCOR2*IF(EQSTR(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~CONTRAESPECIE5~"' "),'DIR'),TCCOMCOR2,IF(TCCOMCOR2<>0,1/TCCOMCOR2,0))
MB1               : 'Deducible|Si|No'            ;14;1;2;NoVacio(CORREDOR2);NO;Vacio(CORREDOR2) O MB1>=0;'Indique Deducible / No Deducible';NO;1;
TasaPrecan        : '%IVA FU'                    ;12;2;2;;;Incluido(Fstr(TASAPRECAN,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Corredor FU es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA') ;;;;;;'#####.#####'
TotalGastos       : 'IVA FU'                     ;13;2;2;NO;;[TOTALGASTOS<= ROUND((IMPCOMCOR2*TASAPRECAN/100)*(1+Var('PORVAR')/100),2) y TOTALGASTOS >= ROUND((IMPCOMCOR2*TASAPRECAN/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Corredor FU Fuera de Rango: '~Fstr(ROUND((IMPCOMCOR2*TASAPRECAN/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((IMPCOMCOR2*TASAPRECAN/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(IMPCOMCOR2*TASAPRECAN)/100;;;;;'###,###,###,###,###.##'