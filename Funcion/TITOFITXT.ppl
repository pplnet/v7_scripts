Recorrer&j val(de:1),Val(ha:1)

    #ifdef BIND
           If Dialogo.Check1<>0
              ** AA 31-10-2025 generar actualizacion saldos por fecha de incorporacion IVSA - BIND
              (.'TITALLPROC'.)
           Else   
              *---- grabar linea TXT BIND STD y Consolidado ----
              ACT(re:1, '')
              ACT(re:2, '')
              Recorrer&i 1,21
                 ACT(re:1, Val(re:1)~Val(&i:&j))
                 #ifdef BIND
                     if &i=3
                        ACT(re:2, Val(re:2)~Val(cc:&j))
                     else
                        ACT(re:2, Val(re:2)~Val(&i:&j))
                     endif
                 #endif   
              Proximo
              If Not Eqstr(Val(tb:2),'NO')
                 EscribirASCII(Val(re:1))
                 #ifdef BIND
                 if EqStr(Val(aa:&j),'1')
                        EscribirASCII(Val(re:2))
                     endif
                 #endif
              Endif
           Endif
      #else
           *---- grabar linea TXT STD ---------------------
           ACT(re:1, '')
           ACT(re:2, '')
           If EqSTR(Var('FECMOVPOS'),'SI')
              if NoVacio(Val(z:&j))
                 ACN(fi:1,&j)
                 **Columna 8,9,10
              else   
                 Recorrer&i 1,21
                    if &i=8 o &i=9 o &i=10
                       ACT(re:1, Val(re:1)~Val(&i:&j))
                    else
                       ACT(re:1, Val(re:1)~Val(&i:Val(fi:1)))
                    endif   
                 Proximo
              endif 
           else   
              Recorrer&i 1,21
                ACT(re:1, Val(re:1)~Val(&i:&j))
              Proximo
           endif
           If Not Eqstr(Val(tb:2),'NO') y Vacio(val(z:&j))
              EscribirASCII(Val(re:1))
           Endif      
      #endif     
       
Proximo       