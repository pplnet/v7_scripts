IF Dialogo.Radio8 = 0
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS (hoja 3)') 
ELSE
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS AHEAD (Hoja 3)')   
ENDIF
SetFont(a3..a3, 3)


ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio6 = 1 y NoVacio(Dialogo.Lista3)
  ACT(h6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
Else
  ACT(h6,'Clientes: TODOS' )   
endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(h7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(h7,'Especies: TODAS' )   
endif

If Dialogo.Radio10 = 0
  ACT(d5,'Operaciones: A TASA y SECURITIES ')
Else
   If Dialogo.Radio10 = 1
       ACT(d5,'Operaciones: A TASA ')
   Else
       ACT(d5,'Operaciones: SECURITIES ')
   Endif 
Endif

If Dialogo.Radio3 = 0
   ACT(d6,'Origen: ACTIVAS y PASIVAS ')
Else
   If Dialogo.Radio3 = 1
      ACT(d6,'Origen: ACTIVAS ')
   Else
      ACT(d6,'Origen: PASIVAS ')
   Endif 
Endif

If Dialogo.Radio14 = 0
   ACT(d7,'Tipo Operacion: TODAS ')
Else
   ACT(d7,'Tipo Operacion: ')
   If Dialogo.Radio14 = 1
      ACT(d7, Val(d7)~'Vto.Simple  ' )
   Endif 
   If Dialogo.Radio14 = 2
      ACT(d7, Val(d7)~'Vto.Multiple  ' )
   Endif 
   If Dialogo.Radio14 = 3
      ACT(d7, Val(d7)~' Caja de Ahorro ' )
   Endif 
Endif

if Dialogo.Radio1=0
  ACT(k4, 'Terc y Act: Todos')
else
  if Dialogo.Radio1=1
    ACT(k4, 'Terc y Act: Dep.Plazo')
  else
    if Dialogo.Radio1=2
      ACT(k4, 'Terc y Act: Cta.CTe.Terceros')
    endif
  endif
endif

if Dialogo.Radio4=0
  ACT(k5, 'Terc y Pas: Todos')
else
  if Dialogo.Radio4=1
    ACT(k5, 'Terc y Pas: Obligaciones Negociables')
  else
    if Dialogo.Radio4=2
      ACT(k5, 'Terc y Pas: Comercio Exterior')
    else
      if Dialogo.Radio4=3
        ACT(k5, 'Terc y Pas: Financiamiento Loc.')
      else
        if Dialogo.Radio4=4
          ACT(k5, 'Terc y Pas: Financiamiento Ext.')
        else
          if Dialogo.Radio4=5
            ACT(k5, 'Terc y Pas: Cta.Cte.Terceros')
          endif
        endif
      endif
    endif
  endif
endif

if Dialogo.Radio2=0
  ACT(k6, 'Vinc y Act: Todos')
else
  if Dialogo.Radio2=1
    ACT(k6, 'Vinc y Act: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio2=2
      ACT(k6, 'Vinc y Act: Cta.Cte.Div.')
    else
      if Dialogo.Radio2=3
        ACT(k6, 'Vinc y Act: Colocaciones Vinc.')
      else
        if Dialogo.Radio2=4
          ACT(k6, 'Vinc y Act: Colocaciones Div.')
        endif
      endif
    endif
  endif
endif

if Dialogo.Radio5=0
  ACT(k7, 'Vinc y Pas: Todos')
else
  if Dialogo.Radio5=1
    ACT(k7, 'Vinc y Pas: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio5=2
      ACT(k7, 'Vinc y Pas: Cta.Cte.Div.')
    else
      if Dialogo.Radio5=3
        ACT(k7, 'Vinc y Pas: Prestamos Vinc.')
      else
        if Dialogo.Radio5=4
          ACT(k7, 'Vinc y Pas: Prestamos Div.')
        endif
      endif
    endif
  endif
endif

SetFont(a4..z7, 2)
