SCN(c:200,1)

*- Monto de MMCPM E Intereses de MMCDIA
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("(CASE TipoOp WHEN 'MMCDIA' THEN 0 ELSE C.Cantidad1 END )/1000 Cant,C.Cantidad3/1000 Int,CASE TipoOp WHEN 'MMCDIA' THEN 0 ELSE C.Total3-C.Cantidad3 END/1000 Imp,C.Precio2,C.NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMCPM','MMCDIA') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("CASE TipoOp WHEN 'MMDCA ' THEN O.TotalNetoCli1 WHEN 'MMD   ' THEN O.TotalBrutoCli1 ELSE O.Cantidad END/1000 Cant, ")
SQL.ADD("CASE TipoOp WHEN 'MMCP  ' THEN O.TotalIntereses ELSE 0 END/1000 Int, CASE TipoOp WHEN 'MMCP  ' THEN O.TotalNetoCli2 - O.TotalIntereses ELSE 0 END/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMCDIA','MMCP','MMDCA','MMD') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*----
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie,CASE Plazo2 WHEN  0 THEN  O.FechaVto ELSE  O.FechaVto2 END Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("O.Cantidad/1000 Cant, CASE Plazo2 WHEN 0 THEN  O.TotalIntereses ELSE O.TotalAux1 END/1000 Int,0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("       or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' )) ")
SQL.ADD(" and  O.TipoOp In ('MMCDP') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*----
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("CASE TipoOp WHEN 'FCS   ' THEN O.Cantidad ELSE  -O.Cantidad END/1000 Cant,0 Int, 0 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('FCS','FCR') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("CASE TipoOp WHEN 'MMCPM ' THEN C.Total2 ELSE 0 END/1000 Cant, CASE TipoOp WHEN 'MMCDIA' THEN C.Cantidad3 ELSE 0 END )/1000 Int,0 Imp,C.Precio2,C.NrCuota ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMCPM','MMCDIA') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
   SQL.ADD("CASE TipoOp WHEN 'MMDCA ' THEN O.TotalNetoCli1 WHEN 'MMD   ' THEN O.TotalBrutoCli1 ELSE O.Cantidad END/1000 Cant, ")
   SQL.ADD("CASE TipoOp WHEN 'MMCP  ' THEN O.TotalIntereses ELSE 0 END/1000 Int, CASE TipoOp WHEN 'MMCP  ' THEN O.TotalNetoCli2 - O.TotalIntereses ELSE 0 END/1000 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMCDIA','MMCP','MMDCA','MMD') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *----
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
   SQL.ADD("O.Cantidad/1000 Cant, CASE Plazo2 WHEN 0 THEN O.TotalIntereses ELSE O.TotalAux1 END/1000 Int,0 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("       or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD(" and  O.TipoOp In ('MMCDP') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("CASE TipoOp WHEN 'FCS   ' THEN O.Cantidad ELSE -O.Cantidad END/1000 Cant,0 Int, 0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('FCS','FCR') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
   Message(FBN['TipoOp']~' '~FBN['NrOperacion'])
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp'])
   
   If FBN['Precio2']=0 y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   EndIf
      
   ACN(mt11,0)
   
   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   EndIf
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   EndIf
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   EndIf


   ACN(mt12, IIf(Incluido(FBN['TipoOp'],'FCS|FCR'),CotizacionC(FBN['Especie'],,,,HABILES(Dialogo.Fecha1,1,VAR('FERIADODEF'),SI),1,SI,Val(mt50)),CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50))))
   
   *** Diario o Mensual ***
   If Dialogo.Radio2 = 0
      *** Diario ***
      Recorrer&i 2, Val(d:200)-1
         If FBN['Fecha'] = Val(&i:10) o [Incluido(FBN['TipoOp'],'FCS|FCR') y &i=Val(m:200)]
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      Recorrer&i Val(d:200)+1, Val(g:200)-1
         If FBN['Fecha'] = Val(&i:10)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
   Else
      *** Mensual ***
      *-- Los Fondos se ubican siempre en la 1er. columna porque son presentes, no futuros
      Recorrer&i Val(m:200),Val(n:200)       
         If [Anio(FBN['Fecha'])=Val(Val(m:200):280) y Mes(FBN['Fecha'])=Val(&i:281)] o [Incluido(FBN['TipoOp'],'FCS|FCR') y &i=Val(m:200)]
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))          
         Endif
      Proximo
      Recorrer&i Val(o:200), Val(p:200)
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      If Val(o:200) > 0
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
            SCN(Val(p:200)+1:Val(c:200),Val(mt11)*Val(mt12))
            SCN(Val(p:200)+1:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Endif
      Recorrer&i Val(d:200), Val(g:200)
         If Anio(FBN['Fecha']) = Val(&i:280)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      If Anio(FBN['Fecha']) > Val(Val(g:200):280)
         SCN(Val(g:200):Val(c:200),Val(mt11)*Val(mt12))
         SCN(Val(g:200):Val(h:200),Val(mt11)*Val(mt12))
      Endif
   Endif
Proximo

*** depositos por compra/venta de moneda no puesto ****
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
If Dialogo.Check1 = 1
   SQL.ADD("O.Cantidad/1000 Cant ")
Else
   SQL.ADD(" 0 Cant ")
Endif
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto   > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <> O.FechaPago ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD(" and  O.TipoOp In ('FXCS','FXVS') ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   ** Si eligio listar Capital listo Cantidad, sino 0
   If Dialogo.Check1 = 1
      SQL.ADD("O.Cantidad/1000 Cant ")
   Else
      SQL.ADD(" 0 Cant ")
   Endif
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD(" where O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto   > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto <> O.FechaPago ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Else
      SQL.ADD(" and  O.TipoOp In ('FXCS','FXVS') ")
   Endif
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
   ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   *** Diario o Mensual ***
   If Dialogo.Radio2 = 0
      *** Diario ***
      Recorrer&i 2, Val(d:200)-1
         If FBN['Fecha'] = Val(&i:10)
            If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
               SCN(&i:282,FBN['Cant']*Val(mt12))
            Else
               SCN(&i:282,-FBN['Cant']*Val(mt12))
            Endif
        Endif
     Proximo
     Recorrer&i Val(d:200)+1, Val(g:200)-1
        If FBN['Fecha'] = Val(&i:10)
           If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
              SCN(&i:282,FBN['Cant']*Val(mt12))
           Else
              SCN(&i:282,-FBN['Cant']*Val(mt12))
           Endif
        Endif
     Proximo
  Else
     *** Mensual ***
     Recorrer&i Val(m:200), Val(n:200)
        If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
           If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
              SCN(&i:282,FBN['Cant']*Val(mt12))
           Else
              SCN(&i:282,-FBN['Cant']*Val(mt12))
           Endif
        Endif
     Proximo
     Recorrer&i Val(o:200), Val(p:200)
        If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
           If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
              SCN(&i:282,FBN['Cant']*Val(mt12))
           Else
              SCN(&i:282,-FBN['Cant']*Val(mt12))
           Endif
        Endif
     Proximo
     If Val(o:200) > 0
        If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
           If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
              SCN(Val(p:200)+1:282,FBN['Cant']*Val(mt12))
           Else
              SCN(Val(p:200)+1:282,-FBN['Cant']*Val(mt12))
           Endif
        Endif
     Endif
     Recorrer&i Val(d:200), Val(g:200)
        If Anio(FBN['Fecha']) = Val(&i:280)
           If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
              SCN(&i:282,FBN['Cant']*Val(mt12))
           Else
              SCN(&i:282,-FBN['Cant']*Val(mt12))
           Endif
        Endif
     Proximo
     If Anio(FBN['Fecha']) > Val(Val(g:200):280)
        If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
           SCN(Val(g:200):282,FBN['Cant']*Val(mt12))
        Else
           SCN(Val(g:200):282,-FBN['Cant']*Val(mt12))
        Endif
     Endif
  Endif
Proximo

Recorrer&i 2, Val(b:200)-2
   If Val(&i:282) <> 0
      If (Val(&i:282) + Val(&i:Val(c:200))) >= 0
         SCN(&i:Val(c:200),Val(&i:282))
         SCN(&i:Val(h:200),Val(&i:282))
      Else
         SCN(&i:Val(y:200),Abs(Val(&i:282)))
         SCN(&i:Val(i:200),Abs(Val(&i:282)))
      Endif
   Endif
Proximo

SCN(c:200,1)

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 1 Precio2, ")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, 0 Imp from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMO','MMCCR') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 1 Precio2, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, 0 Imp from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMO','MMCCR') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
SQL.ADD("order by 1, 2 ")

Recorrer SQL
   Message(FBN['TipoOp']~' '~FBN['NrOperacion'])   
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp'])
    
   If FBN['Precio2']=0  y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   EndIf
   
   ACN(mt11,0)
    
   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   EndIf
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   EndIf
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   EndIf
   
   ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   *** Diario o Mensual ***
   If Dialogo.Radio2 = 0
      *** Diario ***
      Recorrer&i 2, Val(d:200)-1
         If FBN['Fecha'] = Val(&i:10)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      Recorrer&i Val(d:200)+1, Val(g:200)-1
         If FBN['Fecha'] = Val(&i:10)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
   Else
      *** Mensual ***
      Recorrer&i Val(m:200), Val(n:200)
         If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      Recorrer&i Val(o:200), Val(p:200)
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      If Val(o:200) > 0
         If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
            SCN(Val(p:200)+1:Val(c:200),Val(mt11)*Val(mt12))
            SCN(Val(p:200)+1:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Endif
      Recorrer&i Val(d:200), Val(g:200)
         If Anio(FBN['Fecha']) = Val(&i:280)
            SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
            SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Proximo
      If Anio(FBN['Fecha']) > Val(Val(g:200):280)
         SCN(Val(g:200):Val(c:200),Val(mt11)*Val(mt12))
         SCN(Val(g:200):Val(h:200),Val(mt11)*Val(mt12))
      Endif
   Endif
Proximo

