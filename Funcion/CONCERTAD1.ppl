     ACT(g:FAC, FBN['Cliente1'])
     ACT(h:FAC, FBN['Especie'])
     ACN(i:FAC, FBN['Plazo'])
     ACD(j:FAC, FBN['FechaEj'])
     ACN(k:FAC, FBN['TotalAux1'])
     ACN(l:FAC, FBN['PrecioEj'])
     ACT(m:FAC, FBN['ContraEspecie'])
     ACT(n:FAC, iif(fbn['MB3']=0,'Compra','Venta')~'  '~iif(fbn['MB1']=0,'Call','Put'))
     SetFont(a:FAC..n:FAC,1)
     FormatoCeldas(i:fac..i:fac,"0")
     FormatoCeldas(k:fac..k:fac,Exe('F2'))
