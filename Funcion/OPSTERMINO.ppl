*- Especies
ACT(ea2, '')
ACT(me1, '')
*- Totales
ACN(aa1, 0)
ACN(aa2, 0)
ACN(aa3, 0)
ACN(aa4, 0)
ACN(aa6, 0)
ACN(ea5, 0)


*- FX Terminos y Spot Normal Puesto
SQL.ADD("SELECT O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad) Cant, Sum(O.TotalBrutoCli1) Monto ")
SQL.ADD("       FROM "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  (O.TipoOp In ('FXCT','FXVT') or (O.TipoOp In ('FXCS','FXVS') and  O.FechaVto=O.FechaPago))")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD("   and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie, O.TipoOp, O.FechaVto ")
SQL.ADD("UNION ALL")
SQL.ADD("SELECT O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad) Cant, Sum(O.TotalBrutoCli1) Monto  ")
SQL.ADD("       FROM "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (O.TipoOp In ('FXCTV','FXVTV') or (O.TipoOp In ('FXCSV','FXVSV') and  O.FechaVto=O.FechaPago))")
SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("GROUP BY O.Especie, O.TipoOp, O.FechaVto ")
SQL.ADD("ORDER BY 1, 2 ")

Recorrer SQL
   If Not EqStr(Val(ea2),FBN['Especie'])
      *- Cotizacion 
      ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
      ACT(ea2, FBN['Especie']) 
   EndIf
    
   *- Capital
   ACN(aa1, FBN['Cant']*Val(ea5))
   ACN(aa4, FBN['Monto'])
   *- Total: Capital+Intereses Devengados
   ACN(aa3, FBN['Cant']*Val(ea5))
   ACN(aa6, FBN['Monto'])
   
   If Incluido(FBN['TipoOp'],'FXCT|FXCS|FXCTV|FXCSV')
      *- Inversiones en Moneda Extranjera: Operaciones de Cambio a Termino
      SCN(g:Val(fi2)+7, Val(aa1))
      SCN(i:Val(fi2)+7, Val(aa3))
      
      *-Total en Pesos
      SCN(l:Val(fi2)+7, Val(aa1)*Dialogo.Precio1)
      SCN(n:Val(fi2)+7, Val(aa3)*Dialogo.Precio1)

      *- Total en Dolares
      SCN(o:Val(fi2)+7, Val(aa1))
      SCN(q:Val(fi2)+7, Val(aa3))

      *- Total Activo
      SCN(g:Val(fi4), Val(aa1))
      SCN(i:Val(fi4), Val(aa3))
      SCN(l:Val(fi4), Val(aa1)*Dialogo.Precio1)
      SCN(n:Val(fi4), Val(aa3)*Dialogo.Precio1)
      SCN(o:Val(fi4), Val(aa1))
      SCN(q:Val(fi4), Val(aa3))
     
      *- Pasivo en Moneda Local: Ops de Cambio a Termino
      SCN(b:Val(fi6)+5, Val(aa4))
      SCN(d:Val(fi6)+5, Val(aa6))
      
      *-Total en Pesos
      SCN(l:Val(fi6)+5, Val(aa4))
      SCN(n:Val(fi6)+5, Val(aa6))

      *- Total en Dolares
      SCN(o:Val(fi6)+5, Val(aa4)/Dialogo.Precio1)
      SCN(q:Val(fi6)+5, Val(aa4)/Dialogo.Precio1)

      *- Total Pasivo
      SCN(b:Val(fi8), Val(aa4))
      SCN(d:Val(fi8), Val(aa6))
      SCN(l:Val(fi8), Val(aa4))
      SCN(n:Val(fi8), Val(aa6))
      SCN(o:Val(fi8), Val(aa4)/Dialogo.Precio1)
      SCN(q:Val(fi8), Val(aa4)/Dialogo.Precio1)
   Else
      *- Pasivo en Moneda Extranjera: Operaciones de Cambio a Termino   
      SCN(g:Val(fi6)+5, Val(aa1))
      SCN(i:Val(fi6)+5, Val(aa3))
      
      *-Total en Pesos
      SCN(l:Val(fi6)+5, Val(aa1)*Dialogo.Precio1)
      SCN(n:Val(fi6)+5, Val(aa3)*Dialogo.Precio1)

      *- Total en Dolares
      SCN(o:Val(fi6)+5, Val(aa1))
      SCN(q:Val(fi6)+5, Val(aa3))
       
      *- Total Pasivo
      SCN(g:Val(fi8), Val(aa1))
      SCN(i:Val(fi8), Val(aa3))
      SCN(l:Val(fi8), Val(aa1)*Dialogo.Precio1)
      SCN(n:Val(fi8), Val(aa3)*Dialogo.Precio1)
      SCN(o:Val(fi8), Val(aa1))
      SCN(q:Val(fi8), Val(aa3))

         
      *- Inversiones en Moneda Local: Ops de Cambio a Termino
      SCN(b:Val(fi2)+7, Val(aa4))
      SCN(d:Val(fi2)+7, Val(aa6))
            
      *-Total en Pesos
      SCN(l:Val(fi2)+7, Val(aa4))
      SCN(n:Val(fi2)+7, Val(aa6))

      *- Total en Dolares
      SCN(o:Val(fi2)+7, Val(aa4)/Dialogo.Precio1)
      SCN(q:Val(fi2)+7, Val(aa4)/Dialogo.Precio1)

      *- Total Activo
      SCN(b:Val(fi4), Val(aa4))
      SCN(d:Val(fi4), Val(aa6))
      SCN(l:Val(fi4), Val(aa4))
      SCN(n:Val(fi4), Val(aa6))
      SCN(o:Val(fi4), Val(aa4)/Dialogo.Precio1)
      SCN(q:Val(fi4), Val(aa4)/Dialogo.Precio1)
   Endif
Proximo


SetFont(b:Val(fi2)+7..q:Val(fi2)+7, 1)
SetFont(b:Val(fi4)..q:Val(fi4), 1)
SetFont(b:Val(fi6)+5..q:Val(fi6)+5, 1)
SetFont(b:Val(fi8)..q:Val(fi8), 1)

FormatoCeldas(b:Val(fi2)+7..d:Val(fi2)+7, Exe('F2'))
FormatoCeldas(g:Val(fi2)+7..i:Val(fi2)+7, Exe('F2'))
FormatoCeldas(l:Val(fi2)+7..q:Val(fi2)+7, Exe('F2'))
