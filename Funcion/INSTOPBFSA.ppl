INSTANCIA20
BITS
20;0;FW=1 o [FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1] y Not Incluido(Vehiculo1, Var('VLIQUIDAA'))
