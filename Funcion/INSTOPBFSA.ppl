BITS
1;1
3;0
5;0
10;0
13;0
19;0
20;0
50;0

INSTANCIA1
BITS
1;0;FW=1
3;1;FW=1 y [Not Incluido(Vehiculo1, Var('VLIQUIDAA'))] y [EqStr(RIESGO,'BA')]
5;1;FW=1 y [Not Incluido(Vehiculo1, Var('VLIQUIDAA'))] y [EqStr(RIESGO,'BA') o EqStr(RIESGO,'MB')] 
10;1;FW=1 y [Not Incluido(Vehiculo1, Var('VLIQUIDAA')) y Not EqStr(RIESGO,'AL')] o [Incluido(Vehiculo1,Var('WFVHSBFSA')) y EqStr(RIESGO,'AL')]
13;1;FW=1 y [Not Incluido(Vehiculo1, Var('VLIQUIDAA')) y Incluido(Vehiculo1,Var('WFVHSBFSA'))] y EqStr(RIESGO,'AL')
50;1;FW=1 y Incluido(Vehiculo1, Var('VLIQUIDAA'))

POSTEDICION
EqStr(ABM,'D') y NoVacio(OPERACIONREF);'UPOPRE';NrOperacion1=OPERACIONREF
EqStr(ABM,'D') Y Eqstr(TIPOOP, 'MMSIMV');'ACTDIS';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;Cantidad1=VCAN3;Radio1=1
EqStr(ABM,'D') Y EqStr(TIPOOP,'MMONRE');'ELIREE';NrOperacion1=OPERACIONREF;Fecha1=FECHAOP2;Cantidad1=TOTALBRUTOCLI1;
*Actualiza ejecuciones cuando se da de baja la operación. NOTA: El campo cantidad se invierte el signo en el evento
NoVacio(NRORDEN) Y EqStr(ABM,'D');'ACTEJE';NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=0;Radio1=1


