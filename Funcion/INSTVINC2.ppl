INSTANCIA1
BITS
1 ;0;FW=1
19;1;FW=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) 
50;1;FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))

POSTEDICION
EqStr(ABM,'D') y NoVacio(OPERACIONREF);'UPOPRE';NrOperacion1=OPERACIONREF
EqStr(ABM,'D') Y Eqstr(TIPOOP, 'MMSIMV');'ACTDIS';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;Cantidad1=VCAN3;Radio1=1
EqStr(ABM,'D');'ELIMVI';NrOperacion1=NROPERACION3
FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not Incluido(Vehiculo2, Var('VLIQUIDA')~Var('VLIQUIDA2'));'FWVIN9';NrOperacion1=NROPERACION3;Entero2=15;Entero3=50

INSTANCIA20
BITS
20;0;FW=1 y [CB1=0 o Vacio(CB1)] o [FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y [CB1=0 o Vacio(CB1)] ]
50;1;FW=1 y [CB1=0 o Vacio(CB1)] o [CB1=1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not Incluido(Vehiculo2, Var('VLIQUIDA')~Var('VLIQUIDA2'))]
19;1;FW=2 y [CB1=0 o Vacio(CB1)] y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))

