***--- Cuadro de Totales de Informe de Caida de Prestamos---***

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(B:fac, 'Pesos')
ACT(C:fac, 'Dolares')
ACT(D:fac, 'Otras')
ACT(E:fac, 'Totales')
ifa
ACN(xx:1, Val(z:9) * CotizacionC(Val(ML:1),,,,Fsys,1,SI,Val(im:1)) + Val(x:9) * CotizacionC(Val(ME:1),,,,Fsys,1,SI,Val(im:1))) 
ACN(B:fac, Val(z:9))
ACN(C:fac, Val(x:9))
ACN(D:fac, Val(w:9))
ACN(xx:2, Val(xx:1) + Val(w:9))
ACN(E:fac, Val(xx:2))
ACT(A:FAC,'Totales')

ACT(A:FAC+1,'Plazo Prom. Ponderado')
ACN(B:FAC+1, Val(pp:1)/Val(z:9))
ACN(C:FAC+1, Val(pp:2)/Val(x:9))
ACN(D:FAC+1, Val(pp:3)/Val(w:9))
ACN(E:FAC+1, Val(pp:4)/Val(xx:2))

ACT(A:FAC+2,'Tasa Promedio')
ACN(B:FAC+2, Val(tp:1)/Val(tp:5))
ACN(C:FAC+2, Val(tp:2)/Val(tp:6))
ACN(D:FAC+2, Val(tp:3)/Val(tp:7))
*ACN(E:FAC+2, Val(tp:4)/Val(tp:8))       Descontinuado a partir del 22-08-2008 
 
SetFont(a:fac..a:fac+2,2)
ACN(z:9,0)
ACN(x:9,0)
ACN(w:9,0)

ACN(tp:1,0)
ACN(tp:2,0)
ACN(tp:3,0)
ACN(tp:4,0)
ACN(tp:5,0)
ACN(tp:6,0)
ACN(tp:7,0)
ACN(tp:8,0)
ACN(pp:1,0)
ACN(pp:2,0)
ACN(pp:3,0)
ACN(pp:4,0)

ACN(xx:1,0)
ACN(xx:2,0)

SetFont(a:fac-1..e:fac-1,2)
AgregarMarco(a:fac-1..e:fac-1,2,0,Exe('COLOR'))
AgregarMarco(a:fac..e:fac+2,1)
SetFilaActual(fac+2)
