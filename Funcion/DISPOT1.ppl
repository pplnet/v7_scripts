** DISPOT 
** x3: Cartera
*** Toma los Spot no vencidos a la fecha de corte y calcula el monto
*** de dividendo

Message('Procesando Spot ...')
ACN(BD:2, 0)
SQL.ADD("SELECT SUM(Cantidad) as Cantidad, Vehiculo1, ")
SQL.ADD("       CASE TipoOp WHEN 'SECS' THEN 'C' WHEN 'SECSV' THEN 'C' ELSE 'V' END Tip, Book1 ")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and O.TipoOp In ('SECS','SECSV','SEVS','SEVSV') ")
SQL.ADD("   and O.FechaOp <='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("   and Cartera IN "~VAL(x3)~"  ")
SQL.ADD(" group by Vehiculo1,TipoOp, Book1")
SQL.ADD(" order by Vehiculo1,TipoOp, Book1")
Recorrer SQL

*  IF Incluido(FBN['Vehiculo1'],Var('VLIQUIDA') ~Var('VLIQUIDA2'))  
      Message('Spots :'~FBN['Vehiculo1']~' '~Fstr(fac,0,0))   

      IF EqStr(VAL(S1),FBN['Vehiculo1']~FBN['Vehiculo1']~FBN['Tip']~FBN['Book1'])
         DFA
         ACN(BD:1, 0)
      Else
         ACT(s1,FBN['Vehiculo1']~FBN['Vehiculo1']~FBN['Tip']~FBN['Book1'])
         ACN(BD:1, 1)
      EndIf

      act(a:fac,fbn['Vehiculo1'])
      act(b:fac,'SPOTS '~Fstr(VAL(x4),0,0))
      act(c:fac,fbn['Vehiculo1'] )
      scn(d:fac,iif( EqStr(FBN['Tip'],'C'), fbn['Cantidad'],- fbn['Cantidad']) )
      act(l:fac,fbn['Book1'])    
 
      * Tipo de Saldo PARA CARTERA
      acn(n:fac,VAL(X4))

      * e: Monto en Efectivo 
      * f: Monto en Acciones 
      * g: Precio Nuevo 
      * g: Precio 
      * h: TotalBrutoCli1

      * Calculo el Precio del Dividendo en Efectivo si esta protegida la opcion 
      acn(e:fac,FBN['Cantidad']*(Dialogo.Precio1/100))    
 
      * Calculo el Dividendo en Acciones.
      acn(f:fac,FBN['Cantidad']*(Dialogo.Precio2/100))

      *** Calcula importes de dividendos ***
      IF Val(BD:1) = 1 Y Val(BD:2) > 0
          DFA
          (.'CALCDIVI2'.)
          ifa
      ENDIF
*   Else 
*      DFA
*   EndIf
    SCN(BD:2, 1)
Proximo
(.'CALCDIVI2'.)
