ACT(FE:1,&fechaCotizacion)
ACT(A:fac,&especie)
ACT(B:fac,&especieNombre)
ACT(C:fac,&especieCotiza)
If Not ESHABIL(&fechaCotizacion)
    let &fechaCotizacion HABILES(&fechaCotizacion,-1)
EndIf
ACD(D:FAC,&fechaCotizacion)
ACT(H:FAC, &book)
*ACT(M:FAC, fbn('TipoAsi'))
    
If EqStr(&especie,'USD') AND EqStr(fbn('TipoAsi'),'VTO')
    ACD(E:FAC, &fechaCotizacion)
    ACT(I:FAC,'')
    If &PrecioNIIF = 0 O Vacio(&PrecioNIIF)
        ACN(F:FAC, 0)
    Else
        ACN(F:FAC,&PrecioNIIF)
    EndIf
Else
    If &cotizacion <> 0
    *If NoVacio(&valuacion)
        let &tipoVal &valuacion.get_TipoValuacionNIIF
        ACD(E:FAC, &valuacion.get_FechaCotizacion)
        if(not Eqstr(&tipoVal, 'PARTIDAS'))
            ACN(F:FAC, &valuacion.get_CotizacionUtilizadaNIIF)
        else
            ACN(F:FAC, 0)
        endif
        ACT(G:FAC, &tipoVal)
        *Mercado
        *ACT(I:FAC, &valuacion.get_Mercado)     
        *Plazo
        *ACT(J:FAC, &valuacion.get_PlazoLiquidacion)
        ACT(I:FAC,'')
    Else
        let &valuacion ValuacionNIIF(&especie, Dat(Habiles(&fechaCotizacion)), &book, 0)
        if(NoVacio(&valuacion))
            let &tipoVal &valuacion.get_TipoValuacionNIIF
        endif
        ACN(F:FAC, 0)
        ACT(G:FAC, &tipoVal)
        *Mercado
        *ACT(I:FAC, '')  
        *Plazo   
        *ACT(J:FAC, '') 
        ACT(I:FAC, 'No hay cotizacion para la fecha '~val(FE:1))
    EndIf
EndIf