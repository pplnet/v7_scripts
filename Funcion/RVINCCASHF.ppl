SetFilaActual(Val(fl:2))
ACN(bb:2010, 0)

*--> Calcula vinculadas si es por vehiculo
If Dialogo.Radio1 = 1
   *--> Activos Financieros - Colocaciones Vinculadas
   If Val(mn:1000) = 0
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int,(O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and (O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
      SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf

      SQL.ADD("Union All ")
      
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, -O.TotalAux3/1000 Imp,1 Precio2, 0 NrCuota  from "~DBO~".OPERACIONES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0') ")
      SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf
      
      SQL.ADD("Union All ")

      SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp, C.Precio2,C.NrCuota  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
      SQL.ADD("where O.NrOperacion = C.NrOperacion ")
      SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and O.TipoOp In ('MMPCCM') ")
      SQL.ADD("  and O.MB3 = '1' ")
      SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf

      If Dialogo.Radio3 = 1
         *--> Toma los eventuales
         SQL.ADD(" Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
         SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and (O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
         SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf
         
         SQL.ADD("Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
         SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0') ")
         SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf

         SQL.ADD("Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
         SQL.ADD("where O.NrOperacion = C.NrOperacion ")
         SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD("  and O.TipoOp In ('MMPCCM') ")
         SQL.ADD("  and O.MB3 = '1' ")
         SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf
      EndIf

      SQL.ADD("order by 1, 3 ")

      Recorrer SQL
         If Val(bb:2010) = 0
            ACT(c:fac, "Colocaciones Vinculadas")
*            AlinearCeldas(b:fac, 'D')
            SetFont(c:fac, 2)
            ACN(bb:2010, 1)
            ***---SCN(c:2000, 1)
            ACN(c:2000, fac)
            *--> Seteo en cero la fila
            RECORRER&i 4, Val(cc:1990)+2
               ACN(&i:fac, 0)
            PROXIMO
            
            SCN(fl:2,1)
         EndIf
 
         ACN(mt:1001, FBN['Cant'])
         ACN(mt:2002, FBN['Int'])
         ACN(mt:3003, FBN['Imp'])
      
         If FBN['Precio2']=0 y Dialogo.Radio10=0
            ACT(nt:1000, FBN['NrOperacion'])
            *--> Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
            (.'RMONTOTOMV'.)
         EndIf

         ACN(mt:1100, 0)
         SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

         If Val(cz:2) = 0
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ML:1)) )
         Else
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ME:1)) )
         EndIf

         *--> Todas las columnas de dias
         Recorrer&i 4, Val(lm:1)
            If FBN['Fecha'] = Val(&i:Val(xx:2000) )
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         Proximo

         *--> Todas las columnas de meses menos la ultima
         Recorrer&i Val(lm:1), Val(lm:2)-1
            If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         Proximo

         *--> Para la ultima columna de meses
         If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
            ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         EndIf
         
      Proximo
      *--> Fin de Activos Financieros
   Else
      *--> Pasivos Financieros - Prestamos Vinculados <--*
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('VIMIND','VIMINM') ")
      SQL.ADD(" and  O.MB3 = '1' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf

      SQL.ADD(" Union All ")

      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf

      SQL.ADD(" Union All ")

      SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
      SQL.ADD("where O.NrOperacion = C.NrOperacion ")
      SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMPCCM')  ")
      SQL.ADD(" and O.MB3 = '0' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

      If Val(cz:2) = 0
         SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
      Else
         SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
      EndIf

      If Dialogo.Radio3 = 1
         SQL.ADD(" Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
         SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.TipoOp In ('VIMIND','VIMINM') ")
         SQL.ADD(" and  O.MB3 = '1' ")
         SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf

         SQL.ADD(" Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
         SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
         SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf

         SQL.ADD(" Union All ")

         SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
         SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
         SQL.ADD("where O.NrOperacion = C.NrOperacion ")
         SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.TipoOp In ('MMPCCM')  ")
         SQL.ADD(" and  O.MB3 = '0' ")
         SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

         If Val(cz:2) = 0
            SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
         Else
            SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
         EndIf
      Endif

      SQL.ADD("order by 1, 2 ")
    
      Recorrer SQL
         If Val(bb:2010) = 0
            ACT(c:fac, "Prestamos Vinculados")
            SetFont(c:fac, 2)
            ACN(bb:2010, 1)
            SCN(f:2000, 1)
            *--> Seteo en cero la fila
            RECORRER&i 4, Val(cc:1990)
               ACN(&i:fac, 0)
            PROXIMO

            SCN(fl:2,1)
         EndIf
         
         ACN(mt:1001, FBN['Cant'])
         ACN(mt:2002, FBN['Int'])
         ACN(mt:3003, FBN['Imp'])
      
         If FBN['Precio2']=0 y Dialogo.Radio10=0
            ACT(nt:1000, fbn('NrOperacion'))
            *- Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
            (.'RMONTOTOMV'.)
         EndIf
            
         ACN(mt:1100, 0)
         SCN(mt:1000, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

         If Val(cz:2) = 0
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ML:1)) )
         Else
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ME:1)) )
         EndIf

         *--> Todas las columnas de dias
         Recorrer&i 4, Val(lm:1)
            If FBN['Fecha'] = Val(&i:Val(xx:2000) )
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif

         Proximo

         *--> Todas las columnas de meses menos la ultima
         Recorrer&i Val(lm:1)+1, Val(lm:2)-1
            If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         Proximo

         *--> Para la ultima columna de meses
         If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
            ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         EndIf
      Proximo
      *--> Fin Pasivos Financieros
   Endif
   *--> Fin Consolidado
EndIf

*--> Activos Financieros - Colocaciones Vinculadas
If Val(mn:1000) = 0
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2 from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and (O.TipoOp In ('TEMIND','TEMINM') and  O.MB3 = '0') ")

   If Dialogo.Radio1 = 1
       SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   EndIf

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   Recorrer SQL
      If DesciendeDeCliente(FBN['Cliente1'], 'EMPRESAS')     
         If Val(bb:2010) = 0
            ACT(c:fac, "Colocaciones Vinculadas")
            SetFont(c:fac, 2)
            ACN(bb:2010, 1)
            ***---SCN(c:2000, 1)
            ACN(c:2000, fac)
            *--> Seteo en cero la fila
            RECORRER&i 4, Val(cc:1990)
               ACN(&i:fac, 0)
            PROXIMO

            SCN(fl:2, 1)
         EndIf

         ACN(mt:1001, FBN['Cant'])
         ACN(mt:2002, FBN['Int'])
         ACN(mt:3003, FBN['Imp']) 
   
         If FBN['Precio2']=0  y Dialogo.Radio10=0
            ACT(NT:1000, fbn('NrOperacion'))
            *- Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
            (.'RMONTOTOMV'.)
         EndIf
    
         ACN(mt:1100, 0)
         SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

         If Val(cz:2) = 0
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ML:1)) )
         Else
            ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ME:1)) )
         EndIf      

         *--> Todas las columnas de dias
         Recorrer&i 4, Val(lm:1)
            If FBN['Fecha'] = Val(&i:Val(xx:2000) )
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         Proximo

         *--> Todas las columnas de meses menos la ultima
         Recorrer&i Val(lm:1)+1, Val(lm:2)-1
            If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            Endif
         Proximo

         *--> Para la ultima columna de meses
         If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
            ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         EndIf
      Endif
   Proximo
   *--> Fin Activos Financieros
Else
   *--> Pasivos Financieros
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2 from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and (O.TipoOp In ('TEMIND','TEMINM') and  O.MB3 = '1') ")

   If Dialogo.Radio1 = 1
       SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   EndIf

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   Recorrer SQL      
      If Val(bb:2010) = 0
         ACT(c:fac, "Prestamos Vinculadas")
         SetFont(c:fac, 2)
         ACN(bb:2010, 1)
         SCN(f:2000, 1)

         *--> Seteo en cero la fila
         RECORRER&i 4, Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO

         SCN(fl:2, 1)
      EndIf

      ACN(mt:1001, FBN['Cant'])
      ACN(mt:2002, FBN['Int'])
      ACN(mt:3003, FBN['Imp'])
   
      If FBN['Precio2']=0  y Dialogo.Radio10=0
         ACT(NT:1000, fbn('NrOperacion'))
         *- Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
         (.'RMONTOTOMV'.)
      EndIf
   
      ACN(mt:1100, 0)
      SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

      If Val(cz:2) = 0
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ML:1)) )
      Else
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(ME:1)) )
      EndIf
        
      *--> Todas las columnas de dias
      Recorrer&i 4, Val(lm:1)
         If FBN['Fecha'] = Val(&i:Val(xx:2000) )
            ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      Proximo

      *--> Todas las columnas de meses menos la ultima
      Recorrer&i Val(lm:1)+1, Val(lm:2)-1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      Proximo

      *--> Para la ultima columna de meses
      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      EndIf
      
   Proximo
   *--> Fin Pasivos Financieros
EndIf

SetFilaActual(Val(fl:2))

