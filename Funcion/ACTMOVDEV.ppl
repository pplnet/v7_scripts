***/// Pone la variable GENDEV en 0 para que actualice todos los MOVDEVENGADOS, luego vuelve a su valor original

Message('Actualizando Devengados '~FBN('NrOperacion'))

ACN(GD:1, VAR('GENDEV'))

ModificarGENDEV(0)

SQL.ActualizarMovimientos3(FBN['NrOperacion'],NO,NO,NO,NO,SI)
SQL.EXEC

ModificarGENDEV(Val(GD:1))
