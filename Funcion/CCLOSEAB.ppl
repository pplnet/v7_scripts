**-- Recupera las Operaciones de Alquileres de Bonos SEABD y SEABP
*-- Hace Vencer la Operacion Original Especie Cupon N
*-- Genera una Nueva Operacion con la Especie y Cupon N+1
*-- Genera una Nueva Operacion con la CuponEspecie y Cupon N
**-- (" O.Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("SELECT O.*  ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and  O.Cupon1  = '"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and  O.FechaVto > '"~IdxDate(Val(g2))~"' ")
SQL.ADD("and  O.TipoOp In ('SEABD','SEABP') ")
SQL.ADD("and  (RB9='1') ")
SQL.ADD("and  (RB4 is Null or RB4='0') ")
SQL.ADD("order by O.TipoOp, O.Especie ")

SetFilaActual(10)

ACN(x1,0)
ACN(x2,fac+2)

Recorrer SQL 
    ACN(x1,1)
    Message('*-- Recuperando Operacion '~FBN['NrOperacion'])
   
    ** Muestro los datos
    ACN(aa:FAC+1,FBN['RB10'])
    ACT(ab:FAC+1,FBN['NrOperacion'])
    ACD(ac:FAC+1,FBN['FechaOp'])
    ACD(ad:FAC+1,FBN['FechaVto'])
    ACN(ae:FAC+1,FBN['Cantidad'])
    ACN(af:FAC+1,FBN['Precio1'])
    ACN(ag:FAC+1,FBN['TotalIntereses'])
    ACT(ah:FAC+1,FBN['TipoOp'])
    ACT(ai:FAC+1,FBN['Cliente1'])
Proximo

IF VAL(x1)=1 
    *-- Hay datos para mostrar
   CrearDialogo
      Entero1        :'Nr.Cupon'    ;1;2;;NO;;;;;Val(m2)
      ContraEspecie2 :'Cupon'       ;;;;NO;;;;;Val(b4)
      Especie1       :'E. Origen'   ;1;1;;NO;;;;;Val(b2)
      Fecha2         :'Fecha Pago'  ;;;;NO;;;;;Val(h4)
     ListBox; 'Arial,8,N'; 450;280
        'Dev.Cupon?'    ;aa:val(x2)..aa:FAC+1;  ;;;;20;CHECK
        'Nro.Op.'       ;ab:val(x2)..ab:FAC+1;NO;;;;60;STRING
        'F.Operacion'   ;ac:val(x2)..ac:FAC+1;NO;;;;;FECHA
        'F.Vto'         ;ad:val(x2)..ad:FAC+1;NO;;;;;FECHA
        'Cantidad'      ;ae:val(x2)..ae:FAC+1;NO;;;;80;NUMERO;'##,###,###.##'
        'Tasa'          ;af:val(x2)..af:FAC+1;NO;;;;60;NUMERO;'###.#####'
        'Interes VN.'   ;ag:val(x2)..ag:FAC+1;NO;;;;80;NUMERO;'##,###,###.##'
        'Tipo Op.'      ;ah:val(x2)..ah:FAC+1;NO;;;;60;STRING
        'Entidad'       ;ai:val(x2)..ai:FAC+1;NO;;;;60;STRING
      FinListBox  
   FinDialogo

   If Not OK
      Cancelar('Corte de Cupon de Alquiler de Bonos Cancelado ...')
   Endif

   *-- El primer renglon es de Totales
   Recorrer&i val(x2),val(x2)+100

      Message('Validando Operacion: '~Val(ab:&i))

      If Not Vacio(Val(ab:&i)) 
         * Desdobla las Operaciones 
         (."CCSEAB".)         
      Else 
         Break
      Endif
   Proximo
ENDIF