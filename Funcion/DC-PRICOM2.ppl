**// DC:3 = DC de Prima
**// DC:4 = DC de Comisiones
**// FC:1 = Fecha Fin de mes anterior O Inicio
**// FC:2 = Fecha Fin de mes
**// FC:9 = Inicio Cuota Vigente

***/// Inicializar
ACN(CP:2, 0)
ACN(DN:1, 0)
ACN(DN:2, 0)
ACN(DN:3, 0)
ACN(DI:1, 0)
ACN(DI:2, 0)
ACN(DI:3, 0)
ACN(DK:1, 0)
ACN(DK:2, 0)
ACN(DK:3, 0)
ACN(DP:1, 0)
ACN(DP:2, 0)
ACN(DP:3, 0)

*If Val(FC:1) < Val(FC:9)
*   ACD(FC:1, Val(FC:9))
*Endif

*        Messagebox('Fecha Inicial: '~Fecha(Val(FC:9)))
*        Messagebox('Fecha 1: '~Fecha(Val(FC:1)))
*        Messagebox('Fecha 2: '~Fecha(Val(FC:2)))

SQL.ADD(" Select Sum(Monto) DEV ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN('NrOperacion')~"' ")
SQL.ADD(" and TipoDevengado = '"~FBN('TipoDevengado')~"' ")
**SQL.ADD(" and Fecha > "~IdxDate2(Val(FC:9))~" ")
**SQL.ADD(" and Fecha <= "~IdxDate2(Val(FC:1))~" ")
Recorrer SQL
   ACN(PC:1, ABS(FBN('DEV')))
Proximo

**// Seteo en AP:1 si la Op. es Activa o Pasiva
If Incluido(FBN('TipoOp'),Var('OPEACT'))
   ACN(AP:1, 1)
Else
   ACN(AP:1, 2)
Endif

*********************************
** ------ VERSION NUEVA -------**
*********************************

***---PC = DC Prima/Comision
***---DP:1 Moneda Fuerte = ARP
***---DP:2 Moneda Local
***---DP:3 Moneda Grupo = USD

*MessageBox(Val(FD:1))
*MessageBox(Val(FH:1))

IF Eqstr(fbn('Moneda'), Val(ME:1))
   ACN(DP:1, (Val(PC:1) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   IF Eqstr(fbn('Alias4'), Val(ML:1))
      ACN(DP:2, Val(DP:1))
   ELSE
      ACN(DP:2, (Val(PC:1) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   ENDIF
   ACN(DP:3, 0)
ELSE
   IF Eqstr(fbn('Moneda'), Val(ML:1))
      ACN(DP:1, 0)
      IF Eqstr(fbn('Alias4'), Val(ML:1))
         ACN(DP:2, Val(DP:1))
      ELSE
         ACN(DP:2, (Val(PC:1) * CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) * CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ENDIF
      ACN(DP:3, (Val(PC:1) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
   ELSE
      IF Eqstr(fbn('Moneda'), Val(MU:1))
         ACN(DP:1, (Val(PC:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         IF Eqstr(fbn('Alias4'), Val(ML:1))
            ACN(DP:2, (Val(PC:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ELSE
            ACN(DP:2, 0)
         ENDIF
         ACN(DP:3, (Val(PC:1) / CotizacionBCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(PC:1) / CotizacionBCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ENDIF
   ENDIF
ENDIF
