CONDICIONES
EV o [Incluido(TipoOp,'TCOPRI|TIFC|TIFV|')] o [EQSTR(TRIM(VAR('CONTINGEXT')),'SI') y INSTANCIA=11] o [INSTANCIA<>11 y [Not Incluido(VAR('INSTALACIO'),'MLASA')]] o EqStr(ABM,'E');'El alta en esta instancia no es válida. Verifique si está en contingencia';NO
[Incluido(TipoOp,'TCOPRI|TIFC|TIFV|')] o EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o Incluido(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO|NE|  |');VAR('MSGSISEXT');NO
[Incluido(TipoOp,'TCOPRI|TIFC|TIFV|')] o EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o Incluido(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO|SI');'Especie PME no informada';NO

EV o EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La especie No esta Habilitada';NO
EV o [FECHAMADURACION(ESPECIE) >= FECHAOP y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie esta vencida';SI;SI;FSys;'CUPONPAG'
EV o [EqStr(CUPON1,'0')] o [VACIO(CUPON1) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAOP];'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI;SI;FSys;'CUPONANT'
EV o Habiles(PROXCUPON(ESPECIE,FECHAOP),-3,'ARG') <> FECHAOP ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o ProxCupon(ESPECIE,FECHAOP) <> FSYS ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo';SI
EV o Not [DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') y CANTIDAD<BuscarCampo('ESPECIES','VolumenMinimo','Codigo',ESPECIE)];'La Cantidad no puede ser inferior al Volumen Minimo';NO 
EV o [BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)<>0 y [CANTIDAD  Mod2(BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0]] o BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)=0;'La Cantidad debe ser Multiplo de Lamina Minima';NO
CB5 = 0 o EqStr(BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE),ENTECUS1);'El Codigo MAE de la especie ('~BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE)~') no coincide con el recibido del MAE ('~ENTECUS1~')';NO

Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

EV o Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EV o Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

** FJL 10/11/21 - Nueva validacion por error en la liquidacion
* Si es CRYL / BCRA es no match pero se puede
*Not [EqStr(Mercado,'CRYL') y EqStr(Mercado2,'BCRA') y FormaLiquidacion2=1];'Si el mercado es CRYL-BCRA no puede liquidar DVP!!!';NO

*EV o VCAN1=0 o [Not Incluido(Mercado,VAR('MERCAACMC')) y VCAN1=1];'No Puede Liquidar por ArgenClear un Cliente !!!';NO
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Precio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;Fsys;'RANGOPRECIO';

EV o [VPRE20 >= 0 y [CARTERA=1 o CARTERA=2]] o [CARTERA<>1 y CARTERA<>2];'La posicion investment no puede quedar vendida';NO
FechaOp = FSYS y [[FinDeMes(FECHAOP)=FinDeMes(FSys)] o [FinDeMes(FECHAOP)<>FinDeMes(FSys) y FECHAOP>= Habiles(FSys,-Var('FVALORMAX'),'ARG')]];'Operacion Ingresada con Fecha Valor';SI;SI;FSYS;'FVALOR'

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO
BookValido(VAR('BOOKCONTRA'), TIPOOP, CONTRAESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de Contraespecie '~VAR('BOOKCONTRA')~' es Invalido.';NO

[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o ExisteLimite('SETTLEMENT',VTXT11,'USD')]]                                                      ; 'Settlement Cliente no asignado'                                                                                 ;SI;SI;FSYS;'SETTLENOAS'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o Not ExisteLimite('SETTLEMENT',VTXT11,'USD') o VtoLimite('SETTLEMENT',VTXT11,'USD') >= FechaOp]]; 'Settlement Cliente vencido el '~FECHA(VtoLimite('SETTLEMENT',VTXT11,'USD'))                                     ;SI;SI;FSYS;'SETTLEVENC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o Not LimCancelado('SETTLEMENT',VTXT11,'USD')]]                                                  ; 'Settlement Cliente cancelado'                                                                                   ;SI;SI;FSYS;'SETTLECANC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o LimAsignado(VTXT11,'SETTLEMENT','USD') >= (VCAN11+TOTALNETOCLI3)]]                             ; 'Settlement Cliente excedido en U$D '~PYC((VCAN11+TOTALNETOCLI3)-LimAsignado(VTXT11,'SETTLEMENT','USD'),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o ExisteLimite('SETTLEMENT',VTXT10,'USD')]]                                                      ; 'Settlement Grupo (Controlante '~VTXT10~') no asignado'                                                                                 ;SI;SI;FSYS;'SETTLENOAS'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o Not ExisteLimite('SETTLEMENT',VTXT10,'USD') o VtoLimite('SETTLEMENT',VTXT10,'USD') >= FechaOp]]; 'Settlement Grupo (Controlante '~VTXT10~') vencido el '~FECHA(VtoLimite('SETTLEMENT',VTXT10,'USD'))                                     ;SI;SI;FSYS;'SETTLEVENC'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o Not LimCancelado('SETTLEMENT',VTXT10,'USD')]]                                                  ; 'Settlement Grupo (Controlante '~VTXT10~') cancelado'                                                                                   ;SI;SI;FSYS;'SETTLECANC'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1<>1] Y [FORMALIQUIDACION2<>1]] o LimAsignado(VTXT10,'SETTLEMENT','USD') >= (VCAN24+TOTALNETOCLI3)]]                             ; 'Settlement Grupo (Controlante '~VTXT10~') excedido en U$D '~PYC((VCAN24+TOTALNETOCLI3)-LimAsignado(VTXT10,'SETTLEMENT','USD'),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

SI o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1=0] Y [FORMALIQUIDACION2<>1]] o INCLUIDO(VTXT11,Var('CLINOLIM')) o ExisteLimite('SETTCRE',Vehiculo1,'USD'); 'Settlement Global no asignado' ;SI;SI;FSYS;'SETCRENOAS'
SI o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1=0] Y [FORMALIQUIDACION2<>1]] o INCLUIDO(CLIENTE1,Var('CLINOLIM')) o Not ExisteLimite('SETTCRE',Vehiculo1,'USD') o VtoLimite('SETTCRE',Vehiculo1,'USD') >= FechaOp; 'Settlement Global vencido el '~FECHA(VtoLimite('SETTCRE',Vehiculo1,'USD'));SI;SI;FSYS;'SETCREVENC'
SI o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1=0] Y [FORMALIQUIDACION2<>1]] o INCLUIDO(CLIENTE1,Var('CLINOLIM')) o Not LimCancelado('SETTCRE',Vehiculo1,'USD')     ; 'Settlement Global cancelado' ;SI;SI;FSYS;'SETCRECANC'
SI o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o VCAN1=1 o PASECB=1 o Not [[FORMALIQUIDACION1=0] Y [FORMALIQUIDACION2<>1]] o INCLUIDO(CLIENTE1,Var('CLINOLIM')) o LimAsignado(Vehiculo1,'SETTCRE','USD') >= VCAN19; 'Settlement Global excedido en U$D '~PYC(VCAN19-LimAsignado(Vehiculo1,'SETTCRE','USD'),1,0)~'.-';SI;SI;FSYS;'SETCREEXCE'

[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o ExisteLimite('PRESETTLEM',VTXT11,'USD')]]                                                      ; 'PreSettlement Cliente '~VTXT11~' no asignado'                                            ;SI;SI;FSYS;'PRESETNOAS'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not ExisteLimite('PRESETTLEM',VTXT11,'USD') o VtoLimite('PRESETTLEM',VTXT11,'USD') >= FechaOp]]; 'PreSettlement Cliente '~VTXT11~' vencido el '~FECHA(VtoLimite('PRESETTLEM',VTXT11,'USD'));SI;SI;FSYS;'PRESETVENC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not LimCancelado('PRESETTLEM',VTXT11,'USD')]]                                                  ; 'PreSettlement Cliente '~VTXT11~' cancelado'                                              ;SI;SI;FSYS;'PRESETCANC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o MinDerechoBolsa>=0]]                                                                           ; 'PreSettlement Cliente '~VTXT11~' excedido en U$D '~PYC(Abs(MinDerechoBolsa),0,2)         ;SI;SI;FECHAOP ;'PRESETEXCE';

Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o ExisteLimite('PRESETTLEM',VTXT10,'USD')]]                                                                                                      ; 'PreSettlement Grupo (Controlante '~VTXT10~') no asignado'                                                                                                                                                                   ;SI;SI;FSYS;'PRESETNOAS'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not ExisteLimite('PRESETTLEM',VTXT10,'USD') o VtoLimite('PRESETTLEM',VTXT10,'USD') >= FechaOp]]                                                ; 'PreSettlement Grupo (Controlante '~VTXT10~') vencido el '~FECHA(VtoLimite('PRESETTLEM',VTXT10,'USD'))                                                                                                                       ;SI;SI;FSYS;'PRESETVENC'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not LimCancelado('PRESETTLEM',VTXT10,'USD')]]                                                                                                  ; 'PreSettlement Grupo (Controlante '~VTXT10~') cancelado'                                                                                                                                                                     ;SI;SI;FSYS;'PRESETCANC'
Vacio(VTXT10) o [Incluido(TipoOp,'TCOPRI') y Corporate=1] o EqStr(AfectaLS,'Saldos') o [EqStr(AfectaLS,'Limites') y [EqStr(VTXT17,'1') o Vacio(VTXT10) o PASECB=1 o VCAN1=1 o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o LimAsignado(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)>=LimConsumido(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7]]; 'Excede el limite de Presettl. Grupo (Controlante '~VTXT10~') en U$D '~PYC(LimConsumido(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7-LimAsignado(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1),0,2) ;SI;SI;FECHAOP ;'PRESETEXCE'

[Incluido(TipoOp,'TCOPRI') y Corporate=1] o Not EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1  o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o ExisteLimite('MAX'~MERCADO,VEHICULO1,'USD')   ; 'Maximo Monto '~MERCADO~' no Asignado' ;SI;SI;FSYS;'MAX'~MERCADO~'NOAS'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o Not EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1  o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not ExisteLimite('MAX'~MERCADO,VEHICULO1,'USD') o VtoLimite('MAX'~MERCADO,VEHICULO1,'USD') >= FechaOp; 'Maximo Monto '~MERCADO~' vencido el '~FECHA(VtoLimite('MAX'~MERCADO,VEHICULO1,'USD'));SI;SI;FSYS;'MAX'~MERCADO~'VENC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o Not EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1  o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o Not LimCancelado('MAX'~MERCADO,VEHICULO1,'USD') ; 'Maximo Monto '~MERCADO~' Cancelado' ;SI;SI;FSYS;'MAX'~MERCADO~'CANC'
[Incluido(TipoOp,'TCOPRI') y Corporate=1] o Not EqStr(VTXT17,'1') o VCAN1=1 o PASECB=1  o [FormaLiquidacion1<>1 y FormaLiquidacion2<>1] o MinArancel>=0;'Excede el limite de Monto '~MERCADO~' en '~PYC(Abs(MinArancel),0,2) ;SI;SI;FECHAOP ;'MAX'~MERCADO~'EXC';'Excede Monto '~MERCADO~' en U$D '~PYC(Abs(MinArancel),0,2)

Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT25) o PASECB=1 o CB4=1 o ExisteLimite('ISSUER',VTXT25,'USD')                        ; 'Limite Issuer '~VTXT25~' no asignado'                                              ;SI;SI;FSYS;'ISSUERNOAS'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT25) o PASECB=1 o CB4=1 o NOT ExisteLimite('ISSUER',VTXT25,'USD') o VFEC15 >= FechaOp; 'Limite Issuer '~VTXT25~' vencido el '~FECHA(VFEC15)                                ;SI;SI;FSYS;'ISSUERVENC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT25) o PASECB=1 o CB4=1 o NOT LimCancelado('ISSUER',VTXT25,'USD')                    ; 'Limite Issuer '~VTXT25~' Cancelado'                                                ;SI;SI;FSYS;'ISSUERCANC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT25) o PASECB=1 o CB4=1 o VCAN15 >= VCAN25 + TOTALNETOCLI3                           ; 'Limite Issuer '~VTXT25~' excedido en U$D '~PYC(VCAN25 + TOTALNETOCLI3 - VCAN15,0,2);SI;SI;FECHAOP ;'ISSUEREXCE'

Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT26) o PASECB=1 o CB4=1 o ExisteLimite('COUNTRY',VTXT26,'USD')                        ; 'Limite Country '~VTXT26~' no asignado'                                              ;SI;SI;FSYS;'COUNTRNOAS'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT26) o PASECB=1 o CB4=1 o NOT ExisteLimite('COUNTRY',VTXT26,'USD') o VFEC16 >= FechaOp; 'Limite Country '~VTXT26~' vencido el '~FECHA(VFEC16)                                ;SI;SI;FSYS;'COUNTRVENC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT26) o PASECB=1 o CB4=1 o NOT LimCancelado('COUNTRY',VTXT26,'USD')                    ; 'Limite Country '~VTXT26~' Cancelado'                                                ;SI;SI;FSYS;'COUNTRCANC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o Vacio(VTXT26) o PASECB=1 o CB4=1 o VCAN16 >= VCAN26 + TOTALNETOCLI3                            ; 'Limite Country '~VTXT26~' excedido en U$D '~PYC(VCAN26 + TOTALNETOCLI3 - VCAN16,0,2);SI;SI;FECHAOP ;'COUNTREXCE'

Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o PASECB=1 o CB4=1 o ExisteLimite('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1)                        ; 'Limite Book '~BOOK1~' no asignado'                                              ;SI;SI;FSYS;'LBOOKNOAS'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o PASECB=1 o CB4=1 o NOT ExisteLimite('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1) o VFEC17 >= FechaOp; 'Limite Book '~BOOK1~' vencido el '~FECHA(VFEC17)                                ;SI;SI;FSYS;'LBOOKVENC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o PASECB=1 o CB4=1 o NOT LimCancelado('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1)                    ; 'Limite Book '~BOOK1~' Cancelado'                                                ;SI;SI;FSYS;'LBOOKCANC'
Incluido(TipoOp,'TIV|TIFV') o [Incluido(TipoOp,'TCOPRI') y Corporate=0] o [Not EqStr(VTXT17,'1') y CB=1] o PASECB=1 o CB4=1 o VCAN17 >= VCAN27 + TOTALNETOCLI3                                             ; 'Limite Book '~BOOK1~' excedido en U$D '~PYC(VCAN27 + TOTALNETOCLI3 - VCAN17,0,2);SI;SI;FECHAOP ;'LBOOKEXCE'

[Not Incluido(TipoOp,'TCOPRI')] o [Incluido(TipoOp,'TCOPRI') y CANTIDAD <= BuscarCampo('Ordenes','CantidadTotalOrden','NrOrden',NRORDEN1)];'Excede el limite de Monto de la TMANIF' ;NO

