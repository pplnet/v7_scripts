**** ATENCION : SOLO ESTOY USANDO LOS SIG CAMPOS:
*CANTIDAD,CANTIDAD1,CANTIDAD2,TOTALBRUTOCLI1
****************************************************

******** SECCION VEHICULO DE MULTIPLE VENCIMIENTO *****************

**************************----------------------------------------------------
If Dialogo.Radio3 = 1 
  SQL.ADD(" Select O.Vehiculo1,'DERIVADOS' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,-C.Cantidad1 VResidual, ")
Else
  SQL.ADD(" Select 'Consolidado' Vehiculo1,'DERIVADOS' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,-C.Cantidad1 VResidual, ")
EndIf
**************************----------------------------------------------------

SQL.ADD(" O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,'' TipoTasa,O.PrecioRef,C.Total3 Spread,C.Precio1 Tasa,0 TTN, ")
SQL.ADD(" -C.Cantidad3 TotalIntereses,0 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH, ")
SQL.ADD(" 0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt,  ")
SQL.ADD(" 0 ImpAmort,0 Cotizacion1,0 Cantidad,0 NrCuota,'0' RB6,C.Fecha1 FInicio,C.Fecha2 FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" 'Vehiculo' Swap, O.Observac3 ,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD(" O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD(" From   "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(zz6))~") ")   
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
SQL.ADD("        AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("        AND C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        and (C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("            or (Year(C.Fecha2)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
SQL.ADD("            and Month(C.Fecha2)="~Fstr(Mes(Dialogo.Fecha1),0,0)~")) ")
SQL.ADD("        AND C.Cantidad3 > 0 ")

SQL.ADD(" UNION ")

