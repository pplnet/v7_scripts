*- FX y Titulos a Termino POR LA ESPECIE
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'FUTURO' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,0 VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaVto FechaSett,' ' TipoTasa,' ' PrecioRef,0 Spread ,O.Precio1 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0  IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("0 ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('FXCT','FXVT','FXAT','SECT','SEVT') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("Union All ")
*- FX y Titulos a Termino POR LA CONTRAESPECIE
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'FUTURO' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.ContraEspecie Especie,0 VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaPago FechaSett,' ' TipoTasa,' ' PrecioRef,0 Spread ,O.Precio1 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0  IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("0 ImpAmort,O.Cotizacion1,-O.TotalBrutoCli1 Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaPago FFin,O.Plazo2 Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaPago Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('FXCT','FXVT','FXAT','SECT','SEVT') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("Union All ")
*- TEMD
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'COLLATERAL' Grupo,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,0 VResidual,")
SQL.ADD("O.RB8,O.FechaOp FechaVto,O.FechaOp FechaSett,' ' TipoTasa,' ' PrecioRef,0 Spread ,0 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0  IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("0 ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaOp FFin,0 Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('TEMD') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
