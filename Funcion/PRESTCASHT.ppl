Message('Prestamos CashFlow D ')
scn(f:200,1)

SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo, ")
SQL.ADD("C.Total1/1000 Cant,C.Cantidad1/1000 ImpAm,C.Precio2,C.NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPIM') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp, 'Cap' as Tipo, ")
SQL.ADD("PrecioEj/1000 Cant,0 as ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPIM') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD("TotalNetoCli1/1000 Cant,PrecioEj/1000 ImpAm,1 Precio2,0 NrCuota  from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPI') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD("PrecioEj/1000 Cant,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  O.TipoOp In ('MMPI') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("C.Total1/1000 Cant,C.Cantidad1/1000 ImpAm,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPIM') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp  <> O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPIM') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("TotalNetoCli1/1000 Cant,PrecioEj/1000 ImpAm,1 Precio2,0 NrCuota  from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPI') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
   SQL.ADD(" and  O.TipoOp In ('MMPI') ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
Endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("C.Importe4/1000 Cant,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPI','MMPIM') ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp, 'Com' as Tipo,")
   SQL.ADD("C.Importe4/1000 Cant,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPI','MMPIM') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
EndIf
SQL.ADD("order by 1, 2,4,6 ")

Recorrer SQL
  *** Diario o Mensual ***

  ACN(mt1, fbn['Cant'])

  If FBN['Precio2']=0
      ACT(NT:1, fbn('NrOperacion'))
     *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
     (.'MONTOTOMV'.)
  EndIf

  if Dialogo.Radio2 = 0
     *** Diario ***
     *-- Ajuste por Capital si FInicio<>FConcertacion
     IF EqStr(FBN['Tipo'],'Cap')
        Recorrer&i 2, val(d:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(af:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(af:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
        Proximo       
        act(af:201,FBN['NrOperacion'])
     Else     
        Recorrer&i 2, val(d:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(&i:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
              *   scn(&i:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              *EndIf
           endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(&i:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
              *   scn(&i:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              *EndIf
           endif
        Proximo
      EndIf
   Else
     IF EqStr(FBN['Tipo'],'Cap')
        Recorrer&i 2, val(d:200)-1
          If Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
             scn(&i:val(af:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
          If Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
              scn(&i:val(af:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
        Proximo       
        *-- m201: Nro. de Operacion que Mostro Capital
        act(af:201,FBN['NrOperacion'])
     Else
        *** Mensual ***
        Recorrer&i val(m:200), val(n:200)
           if Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
              scn(&i:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(&i:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
              *   scn(&i:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              *EndIf
           endif
        Proximo
        Recorrer&i val(o:200), val(p:200)
          if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) = val(&i:281)
             scn(&i:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             scn(&i:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
             *If EqStr(Val(af:201),FBN['NrOperacion'])
             *   scn(&i:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
             *EndIf
          endif
        Proximo
        if val(o:200) > 0
           if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) > val(val(p:200):281)
              scn(val(p:200)+1:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(val(p:200)+1:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
              *   scn(val(p:200)+1:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              *EndIf
           endif
        endif
        Recorrer&i val(d:200), val(g:200)
           if Anio(fbn['Fecha']) = val(&i:280)
              scn(&i:val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(&i:val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
              *   scn(&i:val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
              *EndIf
           endif
        Proximo
        if Anio(fbn['Fecha']) > val(val(g:200):280)
           scn(val(g:200):val(f:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           scn(val(g:200):val(i:200),val(mt1)*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           *If EqStr(Val(af:201),FBN['NrOperacion'])
           *   scn(val(g:200):val(af:200),-fbn['ImpAm']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))             
           *EndIf
        endif
     endif
  endif
proximo

