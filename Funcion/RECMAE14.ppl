*/******************************************************************
*/Interpreto los Registros 4430 y Completo la tabla FLAGSOCT       *
*/******************************************************************

*AbrirASCII(Val(z2)~'\REC-4430.TXT',0)
*EscribirASCII(Val(A:2))
*CerrarASCII


**********************************************************
*/00560000000410151337541002144304416000004000
*/Bloque de Control
*/0056000000040820133754345044430
*/Codigo de Registro ==>  4416 (MTM) / 4426 (Detalle) / 4427 (Precios)
*/Cantidad de Registros ==> 
**********************************************************
acn(z1,0)
ACT(s:2, 'Reg.MAE')
ACT(s:3, 'Fecha MAE')
ACT(s:4, 'Fecha')
ACT(s:5, 'Hora MAE')
ACT(s:6, 'Hora')
ACT(s:7, 'Secuencia')
ACT(s:8, 'Cant.Reg.MAE')
ACT(s:9, 'Cant.Reg.')
ACT(s:10, 'Paso MAE')
ACT(s:11, 'Paso')
ACT(s:12, 'Tipo Reg.')

ACT(t:2, Copy(Val(a:2),32,4))
ACT(t:3, Copy(Val(a:2),11,6))
ACD(t:4, Fecha(Copy(Val(a:2),15,2)~'/'~Copy(Val(a:2),13,2)~'/'~Copy(Val(a:2),11,2)))
ACT(t:5, Copy(Val(a:2),17,6))
ACT(t:6, Copy(Val(a:2),17,2)~':'~Copy(Val(a:2),19,2)~':'~Copy(Val(a:2),21,2))
ACT(t:7, Copy(Val(a:2),23,5))
ACT(t:8, Copy(Val(a:2),38,10))
ACN(t:9, Num(Val(t:8)))
ACT(t:10, Copy(Val(a:2),36,2))
ACN(t:11, Num(Val(t:10)))
ACT(t:12, Copy(Val(a:2),32,4))

ACN(x1, 0)
ACN(x2, 0)
ACN(x3, 0)
ACN(x4, 0)
if Eqstr(Copy(Val(a:2),32,4),'4416')
  ACN(x2, 1)
  if EqStr(Copy(Val(t:8),1,3),'999')
    * Cierre del DIA
    ACN(t:9, 0)
    ACT(t:12, 'FIND')
    ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSOCT where Fecha='"~IdxDate(Val(t:4))~"' and Registro = '"~Val(t:12)~"' "))
  else
    ACN(x3, 1)
    ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSOCT where Fecha='"~IdxDate(Val(t:4))~"' and Registro = '"~Val(t:12)~"' and Paso = "~Val(t:11)~" "))
  endif
endif
if Incluido(Copy(Val(a:2),32,4),'4426|4427')
  ACN(x2, 1)
  ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSOCT where Fecha='"~IdxDate(Val(t:4))~"' and Registro = '"~Val(t:12)~"' "))
endif

if Val(x2)=1
  if Val(x1)=0
    Message('Insert Flag')
    SQL.ADD("Insert into "~DBO~".FLAGSOCT ( ")
    SQL.ADD(" Fecha, Registro, Cantidad, ")
    if Val(x3)=1
      SQL.ADD(" Paso, ")
    endif
    SQL.ADD(" FechaMAE, HoraMAE, Secuencia, ")
    SQL.ADD(" Estado ")
    SQL.ADD(" ) Values ( ")
    SQL.ADD(" '"~IdxDate(Val(t:4))~"', ")
    SQL.ADD(" '"~Val(t:12)~"', ")
    SQL.ADD(" "~Val(t:9)~", ")
    if Val(x3)=1
      SQL.ADD(" "~Val(t:11)~", ")
    endif
    SQL.ADD(" '"~Val(t:3)~"', ")
    SQL.ADD(" '"~Val(t:5)~"', ")
    SQL.ADD(" '"~Val(t:7)~"', ")
    SQL.ADD(" 'REC' ")
    SQL.ADD(" ) ")
    SQL.NEW
    SQL.EXEC
  else
    if Val(x1)=1
      Message('Update Flag')
      SQL.ADD("Update "~DBO~".FLAGSOCT ")
      SQL.ADD("Set Cantidad  = "~Val(t:9)~", ")
      SQL.ADD("    FechaMAE  = '"~Val(t:3)~"', ")
      SQL.ADD("    HoraMAE   = '"~Val(t:5)~"', ")
      SQL.ADD("    Secuencia = '"~Val(t:7)~"' ")
      SQL.ADD("Where Fecha    = '"~IdxDate(Val(t:4))~"' ")
      SQL.ADD("  and Registro = '"~Val(t:12)~"' ")
      if Val(x3)=1
        SQL.ADD("  and Paso   = "~Val(t:11)~" ")
      else
        SQL.ADD("  and Paso   is Null ")
      endif
      SQL.NEW
      SQL.EXEC
    else
      ACT(y5, 'Mas de un registro en FlagsOCT')
      Message(Val(y5))
      ACN(x4, 1)
    endif
  endif
else
  ACT(y5, 'Codigo Registro erroneo ('~Val(t:2)~')')
  Message(Val(y5))
  ACN(x4, 1)
endif
if Val(x4)=1
  Message('*/Grabo en el Log de Errores')
  */Fecha 
  ACN(y1, Ahora)
  ACT(y2, Hora(Val(y1)))
  ACT(y3, Fecha(FSYS, Exe('FORFECMAE')))
  ***** Fecha
  ACT(y4,Val(y3))
  ***** Hora
  ACT(y4, Val(y4)~Copy(Val(y2),1,2))
  ACT(y4, Val(y4)~Copy(Val(y2),4,2))
  ACT(y4, Val(y4)~Copy(Val(y2),7,2))
  */Codigo de Registro
  act(y4,val(y4)~Copy(Val(a:2),28,4))
  */Motivo
  act(y4,val(y4)~Pad(Val(y5),40))
  */Contenido
  act(y4,val(y4)~Val(a:2))
  AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
  EscribirASCII(Val(y4))
  CerrarASCII
endif
