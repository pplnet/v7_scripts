AbrirASCII(Dialogo.String1~Dialogo.String2, 0)
***---Tipo de Registro
ACT(RC:1, '0')
***---Depositante Emisor
ACT(RC:1, Val(RC:1)~Pad0(Copy(fbn('DepEmisor'), 1, 4), 4))
***---Identificacion Archivo
ACT(RC:1, Val(RC:1)~'TRFDIA')
***---Fecha de Grabacion
ACT(FE:1, Pad0(Fstr(Dia(Fsys), 0, 0), 2))
ACT(FE:2, Pad0(Fstr(Mes(Fsys), 0, 0), 2))
ACT(FE:3, Copy(Fstr(Anio(Fsys), 4, 0), 3, 2))
ACT(RC:1, Val(RC:1)~Val(FE:1)~Val(FE:2)~Val(FE:3))
***---Numero de Orden Interno
ACT(RC:1, Val(RC:1)~Pad0(Fstr(Dialogo.Entero1,0,0),4))
***---Filler
ACT(RC:1, Val(RC:1)~Pad('', 24))
EscribirASCII(Val(RC:1))
CerrarASCII