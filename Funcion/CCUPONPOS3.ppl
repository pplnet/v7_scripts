*- ch1: Acumulador HM *- ch2: Acumulador del resto
ACN(ch:1,0)
ACN(ch:2,0)

Message('----- Corte de Posicion Cliente: '~Val(a:&i))

SQL.ADD(" SELECT P.CantidadFin, P.PrecioFin,  P.Cliente,     P.NrSaldo, ")
SQL.ADD("        P.TipoNegocio, P.NrSaldo,    P.Vehiculo,    P.Trader, ")
SQL.ADD("        E.Cotiza,      E.InteresesC, E.TamanioLote, 'Ejecutado' Estado, ")
SQL.ADD("        P.Fecha FechaMov ")
SQL.ADD(" FROM  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE P.Cliente  = '"~Val(a:&i)~"' ")
SQL.ADD(" AND   P.Especie  = E.Codigo ")
SQL.ADD(" AND   P.Fecha    <= '"~IdxDate(Val(g:2))~"' ")
SQL.ADD(" AND   P.Vehiculo  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND   P.Especie   = '"~Val(b:2)~"' ")
SQL.ADD(" AND   P.Cupon     = '"~FStr(Val(c:2),1,0)~"' ")
SQL.ADD(" AND   P.NrSaldo   >= 100 and P.NrSaldo < 120 ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES X")
SQL.ADD("                 WHERE  X.Cliente = P.Cliente ")
SQL.ADD("                 AND    X.Especie = P.Especie ")
SQL.ADD("                 AND    (X.TipoNegocio=P.TipoNegocio OR (X.TipoNegocio IS NULL AND P.TipoNegocio IS NULL)) ")
SQL.ADD("                 AND    X.Vehiculo     = P.Vehiculo ") 
SQL.ADD("                 AND    X.NrSaldo      = P.NrSaldo  ") 
SQL.ADD("                 AND    (X.Trader=P.Trader OR (X.Trader IS NULL AND P.Trader IS NULL))  ") 
SQL.ADD("                 AND    X.Cupon        = P.Cupon    ") 
SQL.ADD("                 AND    X.Fecha <= '"~IdxDate(Val(g:2))~"') ")
SQL.ADD(" ORDER By E.Cotiza")

Recorrer SQL

 Message('Posiciones ')

 IF fbn('CantidadFin')<>0
    *- Distribuye distintas carteras
    If FBN['NrSaldo']=110
       *- HM
       SCN(ch:1,fbn('CantidadFin'))
    EndIf
    If FBN['NrSaldo']>110 y FBN['NrSaldo']<200
       SCN(ch:2,fbn('CantidadFin'))
    EndIf

   ACN(z:1, fbn('CantidadFin'))
   ACN(z:2, fbn('PrecioFin'))

   * Precio Final actualizado
   if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b2)),'CLE')
      ACN(z4, (Val(l2)+Val(k2)*Val(z2)+Val(m2))/100)
      ACN(z3,Val(z2))
   else
      ACN(z4, (Val(l2) + (Val(k2) * (Val(z2)-Val(l2)/100-Val(m2)/100)) + Val(m2))/100 )
      ACN(z3,  Val(z2) - Val(z4) )
   endif 

   * Actualizar movimientos de posicion para la especie vieja
   *------ Posicion del Cliente ----------------*
   SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
   SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
   SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
   SQL.ADD(" NrSaldo, Precio, ")
   SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader, Book ")
   SQL.ADD(" ) Values ( ")
   SQL.ADD(" '"~Val(b2)~"', "~Fstr(val(z1)*(-1),1,2)~", '"~Val(Y1)~"', ")
   SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
   SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr(Val(z2),1,8)~", ")
   SQL.ADD(" '"~FStr(Val(c2),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"', '' ) ")
   SQL.NEW

   If Round2(Val(e:3),3)<>0
     * Actualizar movimientos de posicion para la especie nueva
     SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
     SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
     SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
     SQL.ADD(" NrSaldo, Precio,  ")
     SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader, Book ")
     SQL.ADD(" ) Values ( ")
     SQL.ADD(" '"~Val(b2)~"', "~Fstr(val(z1),1,2)~", '"~Val(Y1)~"', ")
     SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
     SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr(Val(z3),1,8)~", ")
     SQL.ADD(" '"~FStr(Val(c3),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"', '' ) ")
     SQL.NEW
   Endif

   If val(l2)+val(k2)<>0
      * Actualizar movimientos de posicion para el cupon
      SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
      SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
      SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
      SQL.ADD(" NrSaldo, Precio,  ")
      SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader, Book ")
      SQL.ADD(" ) Values ( ")
      SQL.ADD(" '"~Val(b4)~"', "~Fstr(val(z1),1,2)~", '"~Val(Y1)~"', ")
      SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
      SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr(Val(z4),1,8)~",  ")
      SQL.ADD(" '"~FStr(Val(c2),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"', '' ) ")
      SQL.NEW
   ENDIF
   SQL.EXEC
 ENDIF
Proximo

*- Actualizo en la transaccion de saldo la division de HM u Otras
SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
SQL.ADD("   Set Cantidad2 = "~Fstr(val(ch:1),0,2)~", ")
SQL.ADD("       Cantidad3 = "~Fstr(val(ch:2),0,2)~" ")
SQL.ADD(" Where NrTrans='"~val(y1)~"' ")
SQL.NEW
SQL.EXEC

if Val(h:&i)=2
  Message('----- Corte de Posiciones Nuevas')

  SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONES P ")
  SQL.ADD("  WHERE P.Cliente         =  '"~Val(a:&i)~"' ")
  SQL.ADD("    AND P.Especie         =  '"~Val(b:2)~"' ")
  SQL.ADD("    AND P.Cupon           =  '"~FStr(Val(c:2),1,0)~"' ")
  SQL.ADD("    AND P.Vehiculo        =  '"~Dialogo.Vehiculo1~"' ")
*  SQL.ADD("    AND IsNull(P.Book,'') =  '"~Val(bk:&i)~"' ")
  SQL.ADD("    AND P.NrSaldo         >= 120 ")
  SQL.ADD("    and P.NrSaldo         <  140 ")
  SQL.ADD("    AND P.Fecha           <= '"~IdxDate(Val(g:2))~"' ")
  SQL.ADD("    AND P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
  SQL.ADD("                     WHERE P1.Especie                = P.Especie ")
  SQL.ADD("                       AND P1.Cupon                  = P.Cupon ") 
  SQL.ADD("                       AND P1.NrSaldo                = P.NrSaldo ") 
  SQL.ADD("                       AND P1.Cliente                = P.Cliente ")
  SQL.ADD("                       AND P1.Vehiculo               = P.Vehiculo ") 
  SQL.ADD("                       AND IsNull(P1.Book,'')        = IsNull(P.Book,'') ")
  SQL.ADD("                       AND IsNull(P1.TipoNegocio,'') = IsNull(P.TipoNegocio,'') ")
  SQL.ADD("                       AND IsNull(P1.Trader,'')      = IsNull(P.Trader,'') ") 
  SQL.ADD("                       AND P1.Fecha <= '"~IdxDate(Val(g:2))~"' ")
  SQL.ADD("                   ) ")
  SQL.ADD(" ORDER By Especie,Vehiculo,Book,NrSaldo")

  Recorrer SQL
    Message('Posiciones ')

    IF fbn('CantidadFin')<>0
      ACN(z1, fbn('CantidadFin'))
      ACN(z2, fbn('PrecioFin'))

*      MessageBox('Especie  = '~Val(b:2))
*      MessageBox('Vehiculo = '~fbn('Vehiculo'))
*      MessageBox('Book     = '~fbn('Book'))
*      MessageBox('NrSaldo  = '~fbn('NrSaldo'))
*      MessageBox('Fecha    = '~fbn('Fecha'))
*      MessageBox('Cantidad = '~PYC(Val(z1),0,2))

      * Precio Final actualizado
      if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b:2)),'CLE')
        ACN(z:4, (Val(l:2)+Val(k:2)*Val(z:2)+Val(m:2))/100)
        ACN(z:3, Val(z:2))
      else
        ACN(z:4, (Val(l:2) + (Val(k:2) * (Val(z:2)-Val(l:2)/100-Val(m:2)/100)) + Val(m:2))/100 )
        ACN(z:3, Val(z:2) * (1 - Val(k:2)/100) )
      endif 

      * Actualizar movimientos de posicion para la especie vieja
      *------ Posicion del Cliente ----------------*
      SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
      SQL.ADD("   Especie, Cantidad, NrOperacion, ")
      SQL.ADD("   FechaMov, Cliente, Vehiculo, ")
      SQL.ADD("   NrSaldo, Precio, Cupon, ")
      SQL.ADD("   Tipo, TipoNegocio, Trader, ")
      SQL.ADD("   Book, Unidad, Centro, ")
      SQL.ADD("   Sector, Sucursal, CallPut, ")
      SQL.ADD("   Estrategia, Cartera ")
      SQL.ADD(" ) Values ( ")
      * Especie
      SQL.ADD("   '"~Val(b:2)~"', ")
      * Cantidad
      SQL.ADD("   "~Fstr(val(z:1)*(-1),1,2)~", ")
      * NrOperacion
      SQL.ADD("   '"~Val(Y1)~"', ")

      * FechaMov
      SQL.ADD("   '"~IdxDate(Val(g:2))~"', ")
      SQL.ADD("   '"~FBN['Cliente']~"', ")
      SQL.ADD("   '"~FBN['Vehiculo']~"', ")

      SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
      * Precio
      SQL.ADD("   "~FStr(Val(z:2),1,8)~", ")
      * Cupon
      SQL.ADD("   '"~FStr(Val(c:2),1,0)~"', ")

      * Tipo
      SQL.ADD("   '1', ")
      SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
      SQL.ADD("   '"~FBN['Trader']~"', ")

      SQL.ADD("   '"~FBN['Book']~"', ")
      SQL.ADD("   '"~FBN['Unidad']~"', ")
      SQL.ADD("   '"~FBN['Centro']~"', ")

      SQL.ADD("   '"~FBN['Sector']~"', ")
      SQL.ADD("   '"~FBN['Sucursal']~"', ")
      SQL.ADD("   '"~FBN['CallPut']~"', ")

      SQL.ADD("   '"~FBN['Estrategia']~"', ")
      SQL.ADD("   '"~FBN['Cartera']~"' ")
      SQL.ADD(" ) ")
      SQL.NEW

      If Round2(Val(e:3),3)<>0
        * Actualizar movimientos de posicion para la especie nueva
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,  Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov, Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,  Precio,      Cupon, ")
        SQL.ADD("   Tipo,     TipoNegocio, Trader, ")
        SQL.ADD("   Book, Unidad, Centro, ")
        SQL.ADD("   Sector, Sucursal, CallPut, ")
        SQL.ADD("   Estrategia, Cartera ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b:2)~"', ")
        * Cantidad
        SQL.ADD("   "~Fstr(val(z:1),1,2)~", ")
        * NrOperacion
        SQL.ADD("   '"~Val(Y1)~"', ")

        * FechaMov
        SQL.ADD("   '"~IdxDate(Val(g:2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        * Precio
        SQL.ADD("   "~FStr(Val(z:3),1,8)~", ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c:3),1,0)~"', ")

        * Tipo
        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '"~FBN['Book']~"', ")
        SQL.ADD("   '"~FBN['Unidad']~"', ")
        SQL.ADD("   '"~FBN['Centro']~"', ")

        SQL.ADD("   '"~FBN['Sector']~"', ")
        SQL.ADD("   '"~FBN['Sucursal']~"', ")
        SQL.ADD("   '"~FBN['CallPut']~"', ")

        SQL.ADD("   '"~FBN['Estrategia']~"', ")
        SQL.ADD("   '"~FBN['Cartera']~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      Endif

      If val(l2)+val(k2)<>0
        * Actualizar movimientos de posicion para el cupon
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,  Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov, Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,  Precio,      Cupon, ")
        SQL.ADD("   Tipo,     TipoNegocio, Trader, ")
        SQL.ADD("   Book, Unidad, Centro, ")
        SQL.ADD("   Sector, Sucursal, CallPut, ")
        SQL.ADD("   Estrategia, Cartera ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b:4)~"', ")
        * Cantidad
        SQL.ADD("   "~Fstr(val(z:1),1,2)~", ")
        * NrOperacion
        SQL.ADD("   '"~Val(Y1)~"', ")

        * FechaMov
        SQL.ADD("   '"~IdxDate(Val(g:2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        * Precio
        SQL.ADD("   "~FStr(Val(z:4),1,8)~",  ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c:2),1,0)~"', ")

        * Tipo
        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '"~FBN['Book']~"', ")
        SQL.ADD("   '"~FBN['Unidad']~"', ")
        SQL.ADD("   '"~FBN['Centro']~"', ")

        SQL.ADD("   '"~FBN['Sector']~"', ")
        SQL.ADD("   '"~FBN['Sucursal']~"', ")
        SQL.ADD("   '"~FBN['CallPut']~"', ")

        SQL.ADD("   '"~FBN['Estrategia']~"', ")
        SQL.ADD("   '"~FBN['Cartera']~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      ENDIF
      SQL.EXEC
    ENDIF
  Proximo
else
  Message('NO corta Posiciones Nuevas')
endif
