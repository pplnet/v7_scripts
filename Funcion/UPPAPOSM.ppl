* UPPAPOSM: Update de Partidas - MMPOSM
         ACN(o1,FBN['ImpGastos2'])
         ACN(o2,FBN['TotalAux1'])
         ACN(o3,FBN['TasaImp1'])
         ACN(o4,FBN['RB6'])
         ACN(o5,FBN['MB1'])
         ACN(o7,FBN['RB7'])
         ACN(o8,FBN['RB8'])
         ACN(o9,FBN['RB9'])
         ACN(o10,FBN['IntDevengados1'])
         ACN(o11,FBN['Precio2'])
         ACN(o12,FBN['RB5'])

         SQL.ADD(" SELECT * FROM  "~DBO~".CUOTAS where NrOperacion='"~FBN['NrOperacion']~"' and Fecha2 > '"~IdxDate(Val(a2))~"' ")

         Recorrer SQL
            Message(' Recuperando Cuota Nro '~Fstr(FBN['NrCuota'],0,0)~' '~FBN['NrOperacion'])

            * e1=>Interes e2=> Impuesto Interes e3 => Interes Total  e4: Monto e5: MontoTotal
            * q21: Cen Variable q11: Cen Total q12:  Importe CEN en Equivalente
            * f1: Importe de Iva  f2: Importe WH f3: Importe IVA CEN
            ACN(Q21,IIF(VAL(o4)=0,((FBN['Cantidad2']*VAL(o11)*FBN['Plazo1'])/IIF(Val(o12)=0,36000,36500)),0))
            ACN(Q11,IIF(VAL(o4)=0, FBN['Cantidad5']+val(q21), 0))
            ACN(Q12,FBN['Cantidad7']^IiF(EqStr(FBN['Check1'],'1'),1,-1)*VAL(Q11))

            ACN(e1,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],Val(o8)+1))
            ACN(e2,VAL(e1)*VAL(o3)/100 )
            ACN(f1,VAL(e1)*(Val(o1)/100) )
            ACN(f2,((FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6'])/IIF(Val(o9)=1,36500,36000))*(VAL(o2)/100)) 

            ACN(e3,VAL(e1)+VAL(e2)+VAL(q11)+val(f2) )
            ACN(e4,FBN['Cantidad1']+VAL(e1))
            ACN(e5,FBN['Cantidad1']+VAL(e3))
            ACN(f3,VAL(q11)*(val(o10)/100))

            SQL.ADD(" UPDATE "~DBO~".CUOTAS Set ")
            SQL.ADD(" Cantidad3="~Fstr(val(e1),0,2)~", Precio5="~Fstr(val(e1),0,2)~", ")
            SQL.ADD(" Total9="~Fstr(val(e2),0,2)~",PrecioRef1='"~Fstr(val(e2),0,2)~"', ")
            SQL.ADD(" Total1="~Fstr(val(e5),0,2)~",Total4="~Fstr(val(f1),0,2)~",Precio6="~Fstr(val(f1),0,2)~", ")
            SQL.ADD(" Total2="~Fstr(val(e4),0,2)~",")
            SQL.ADD(" Total3 ="~Fstr(val(e3),0,2)~", ")
            SQL.ADD(" Tasa3="~Fstr(val(f3),0,2)~", ")
            SQL.ADD("Cantidad4 = "~Fstr(val(q21),0,7)~", ")
            SQL.ADD("Cantidad6 = "~Fstr(val(q11),0,7)~", ")
            SQL.ADD("Cantidad8 = "~Fstr(val(q12),0,2)~", ")
            SQL.ADD("Precio8 = "~Fstr(val(q21),0,7)~", ")
            SQL.ADD(" Total7="~Fstr(val(f2),0,2)~" ")
            SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")
            SQL.ADD(" and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
            SQL.NEW  
         Proximo 
