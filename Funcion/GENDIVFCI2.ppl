SetFilaActual(0)
SQL.ADD(" Select P.CantidadFin, Book From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND P.NrSaldo IN ('101') ")
SQL.ADD(" AND P.Cliente = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND P.Fecha = (Select Max(D.Fecha) From "~DBO~".POSICIONES D ")
SQL.ADD("                Where D.Cliente = P.Cliente ")
SQL.ADD("                AND D.Especie = P.Especie ")
SQL.ADD("                AND D.NrSaldo = P.NrSaldo ")
SQL.ADD("                AND D.Book = P.Book ")
SQL.ADD("                AND D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")

Recorrer SQL
  IF fbn('CantidadFin') <> 0
    ACT(A:fac, fbn('Book') )
    ACN(B:fac, fbn('CantidadFin') )
    If Dialogo.Radio1 = 1
       ACN(C:fac, Dialogo.Cantidad2 )
       ACN(D:fac, val(b:fac)*val(c:fac)/100 )
    Else
       ACN(D:fac, Dialogo.Cantidad1)
    EndIf
  ELSE
    DFA
  ENDIF
Proximo

ACN(FC:99,fac)
If Val(FC:99) =0
 Cancelar('No hay Posicion para el Fondo Solicitado')
EndIf

CrearListBox ; 'MS Sans Serif,8,'; 'Dividendos FCI'
  'Book     '         ;A:1..A:Fac;NO;SI;'Error'; 90; STRING;12
  'Posicion'          ;B:1..B:fac;NO;SI;'Error';120;NUMERO;'#,###,###,###.##'
  '%'                 ;C:1..C:Fac;NO;SI;'Error';120;NUMERO;'#####.########'
  'Monto a Cobrar '   ;D:1..D:fac;NO;SI;'Error';120;NUMERO;'#,###,###,###.##'
FinListBox

If Not Ok 
   Cancelar
Endif

Recorrer&j 1,Fac
  
   ****INSERTAR OPERACION

