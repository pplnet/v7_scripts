   ACT(Z3,GetNumerador(Val(ZC:66))) 
   ACT(ZC:77, BuscarCampo('ESPECIES','Issuer','Codigo', Dialogo.Especie1) )

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ( ")
   SQL.ADD(" TipoOp,         CB7,            NrOperacion,   Especie, Book1, ")
   SQL.ADD(" ContraEspecie,  Cliente1,       Cantidad,      ")
   SQL.ADD(" TotalNetoCli1, Cuenta2, ")
   SQL.ADD(" FechaOp,        FechaPago,  FechaCarga ,   FechaCargaSys, ")
   SQL.ADD(" TipoCambio3, ")
   SQL.ADD(" Numerador , ")
   SQL.ADD(" MB3 , MB4, MB2, UsrInput, ")
   SQL.ADD(" Vehiculo1 ")
   SQL.ADD(" ) Values ( ")
   SQL.ADD(" 'DIVIDE', '1', '"~Val(Z3)~"', '"~Dialogo.Especie1~"','"~ val(A:&j)~"' , ")
   SQL.ADD(" '"~Dialogo.Especie2~"', '"~Val(ZC:77)~"', "~FStr(val(B:&j),0,2)~" , ")
   SQL.ADD(" "~FStr(Val(D:&j),0,2)~", '"~Dialogo.Cuenta3~"', ")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', "~SQLAhora~" , '"~IdxDate(FSYS)~"', ")
   SQL.ADD(" 101, ")
   SQL.ADD(" "~FStr(Val(ZC:66),0,0)~", ")
   SQL.ADD(" 0,-1 ,-1 , '"~VAL(ZO:99)~"', ")
   SQL.ADD(" '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" ) ")
   SQL.NEW
   SQL.EXEC

   ***---INSERTAR INSTANCIA 

   SQL.ADD("SELECT * FROM "~DBO~".INSTANCIAS ")
   SQL.ADD(" Where Tabla = 'OPERACIONES' ")
   SQL.ADD(" ORDER BY NrInstancia ")

