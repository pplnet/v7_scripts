If Dialogo.Radio3=1
   *- Actualiza

   SQL.ADD("Update "~DBO~".CUOTAS ")
   SQL.ADD("Set")
   SQL.ADD("Precio2   = "~Fstr(val(l:fac),0,7)~", ")
   SQL.ADD("Cantidad3 = "~Fstr(val(o:fac),0,2)~", ")
   SQL.ADD("Total2    = "~Fstr(val(z:fac),0,2)~", ")
   SQL.ADD("Total1    = "~Fstr(val(aa:fac),0,2)~", ")
   SQL.ADD("Cantidad5 = "~Fstr(val(ca:55),0,2)~", ")
   SQL.ADD("Total5 = "~Fstr(val(to:50),0,2)~", ")
   SQL.ADD("Cantidad6 = "~Fstr(val(ca:56),0,2)~", ")
   SQL.ADD("Cantidad4 = "~Fstr(val(ca:54),0,2)~", ")
   SQL.ADD("Total3 = "~Fstr(val(ab:fac),0,2)~", ")
   SQL.ADD("Precio5 = "~Fstr(val(pr:90),0,2)~", ")
   SQL.ADD("Precio6 = "~Fstr(val(pr:91),0,2)~", ")
   SQL.ADD("Precio7 = "~Fstr(val(pr:92),0,2)~", ")
   SQL.ADD("Precio8 = "~Fstr(val(pr:93),0,2)~" ")
   SQL.ADD("where NrOperacion = '"~val(i:3)~"' ")
   SQL.ADD("and NrCuota = "~Fstr(val(af:fac),2,0)~" ")
   SQL.NEW
   SQL.EXEC
   
   If &manual=1
      (.'SETTASFUT'.)
   Endif   
EndIf

