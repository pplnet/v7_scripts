*-- Importar Tipos de Variables
LeerPMG('TIPOVAR', 'WKS')

If Vacio(val(ab1))
   Cancelar('No se ha podido recuperar el TIPOVAR.wks')
EndIf

acn(ab2,0)

*- Recupero el tipo de variable  ab2: Fila en la cual esta la variable
Recorrer&i 1,val(ab1)
   Message('Recupero el tipo de variable '~Fstr(&i,0,0))


   If EqStr(val(dv1),val(a:&i))
      acn(ab2,&i)
      Break      
   EndIf
Proximo

If val(ab2)=0   
   MessageBox('Variable no encontrada en el Planilla excel, se da por valida..')
   acn(aa3,0)
Else  
   If EqStr(val(b:val(ab2)),'LOG') y Incluido(val(ds1),'SI|NO')
      *- Tipo Logica SI/NO 
      acn(aa3,0)
   EndIf

   If EqStr(val(b:val(ab2)),'TEXT') o Vacio(val(b:val(ab2)))
      *- TEXTO: Puede ingresar lo que quiera
      acn(aa3,0)
   EndIf

   If EqStr(val(b:val(ab2)),'NUM') 
      *- Numeros: 
      If Vacio(val(c:val(ab2)) ) y EsNumero(val(ds1)) 
         acn(aa3,0)
      EndIf
 
      If EqStr("Pipe",val(c:val(ab2)))
         *- Lista de Numeros
         acn(aa6,Elementos(val(ds1)))      
         acn(aa3,0)         
  
         Recorrer&j 1,val(aa6)
            If Not EsNumero(ItemLista(val(ds1),&j))                   
               acn(aa3,-1)         
               Break
            EndIf
         Proximo
      EndIf
   EndIf

   If Incluido(val(b:val(ab2)),'TIPOOP|VEHI|ESPE|USUARIO|FER|PRECIOSREF')

      acn(aa6,Elementos(val(ds1)))
      If EqStr(val(b:val(ab2)),'TIPOOP')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".TIPOSOPERACION ")
         SQL.ADD("Where Codigo ")
      EndIf

      If EqStr(val(b:val(ab2)),'VEHI')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".VEHICULOS ")
         SQL.ADD("Where Codigo ")
      EndIf
 
      If EqStr(val(b:val(ab2)),'ESPE')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".ESPECIES ")
         SQL.ADD("Where Codigo ")
      EndIf
 
      If EqStr(val(b:val(ab2)),'USUARIO')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".USUARIOS ")
         SQL.ADD("Where Codigo ")
      EndIf

      If EqStr(val(b:val(ab2)),'FER')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".FERIADOS ")
         SQL.ADD("Where Codigo ")
      EndIf
 
      If EqStr(val(b:val(ab2)),'PRECIOSREF')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".PRECIOSREF ")
         SQL.ADD("Where Codigo ")
      EndIf

      If EqStr("Pipe",val(c:val(ab2)))
         act(aa5,Reemplazar(val(ds1),"'"," "))
         act(aa5,Mirt(Trim(val(aa5))) )
         If EqStr("EXE",val(d:val(ab2)))
            act(aa5,val(aa5)~'|' )
         EndIf

         If Vacio(Pipe2Comillas(val(aa5)) )
            SQL.ADD("In ('') ")
         Else
            SQL.ADD("In ("~Pipe2Comillas(val(aa5))~") ")
         EndIf
      EndIf

      If EqStr("In",val(c:val(ab2)))
         act(aa5,Reemplazar(val(ds1),",","|"))
         act(aa5,Reemplazar(val(aa5),"'"," "))
         act(aa5,Mirt(Trim(val(aa5))) )
         acn(aa6,Elementos(val(aa5)))
   
         SQL.ADD("In ("~val(ds1)~") ")  
      EndIf

      If Vacio(val(c:val(ab2)))
         act(aa5,Reemplazar(val(ds1),"'"," "))
         act(aa5,Mirt(Trim(val(aa5))) ) 
         SQL.ADD(" In ('"~val(aa5)~"') ")
      EndIf

      If EqStr(val(b:val(ab2)),'JER')
         SQL.ADD("Select COUNT(*) as Cont From "~DBO~".ESPECIES ")
         SQL.ADD("Where Jerarquia Like '"~Mirt(Trim(val(ds1)))~"%' ")
      EndIf
 

      Recorrer SQL

         acn(aa4,FBN['Cont'])
      Proximo


      If val(aa4)=val(aa6)
         acn(aa3,0)
      EndIf
   EndIf  

   If EqStr(val(b:val(ab2)),'JERESPE')
      SQL.ADD("Select COUNT(*) as Cont From "~DBO~".ESPECIES ")
      SQL.ADD("Where Jerarquia Like '"~Mirt(Trim(val(ds1)))~"%' ")
      Recorrer SQL
          acn(aa4,FBN['Cont'])
      Proximo

      If val(aa4)>0
         acn(aa3,0)
      EndIf  
   EndIf

   If EqStr(val(b:val(ab2)),'JERCLI')
      SQL.ADD("Select COUNT(*) as Cont From "~DBO~".CLIENTES ")
      SQL.ADD("Where Jerarquia Like '"~Mirt(Trim(val(ds1)))~"%' ")
      Recorrer SQL
         acn(aa4,FBN['Cont'])
      Proximo

      If val(aa4)>0
         acn(aa3,0)
      EndIf
   EndIf


   If EqStr(val(b:val(ab2)),'FECHA')
      act(aa3,val(ds1))
      CrearDialogo
         Variable1 : 'Variable'  ;;;;NO;;;;;Val(aa2)
         Fecha1    : 'Fecha'     ;;;;;;Dialogo.Fecha1>0;'La Fecha es Incorrecta';No;Fecha(val(aa3))
         String    : 'Valor'     ;;;;NO;NO;;;;;Dialogo.Fecha1
      FinDialogo
      If OK
         acn(aa3,0)
      Else
         acn(aa3,1)
      EndIf
   EndIf
EndIf




