*- Se debe ejecutar primero el evento de Devengamiento para 
*- Tener el ResultadoIndice en OPERACIONES
*- Despues se debe descontar el Resultado al fin de mes anterior ma1: FinMes anterior
*- op1:Nro. de Operacion

**************************************---------------------------------
IF Dialogo.Radio1 = 1
   SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.TipoOp,O.TipoTasa,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
Else
   SQL.ADD("SELECT 'Consolidado' Vehiculo1,O.FechaOp,O.TipoOp,O.TipoTasa,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
EndIf
**************************************---------------------------------

SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.CantidadOri,O.Precio1,O.OperacionRef,O.Precio4 as OPrecio4,O.TotalBrutoCli3,O.TotalBrutoCli2,O.TotalNetoCli3,O.Coeficiente,")
SQL.ADD("C.Cantidad1,C.Cantidad2,C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,' ' as Pata,C.Cantidad3,C.Cantidad4,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.Precio2,O.ResultadoIndice,O.Indice ")
SQL.ADD(" from  "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.NrOperacion = '"~val(op1)~"' and (O.Indice Is Not Null or O.Indice<>' ')")
SQL.ADD("       and O.TipoOp In ('MMFCMV','MMSCMV','MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMONM','MMPCCM') ")
SQL.ADD("       and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and C.Fecha2 >'"~IdxDate(val(ma1))~"'   ")
SQL.ADD(" Union ")
*- Operaciones Unico Vto
SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.TipoOp,O.TipoTasa,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia, ")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.CantidadOri,O.Precio1,O.OperacionRef,O.Precio4 as OPrecio4,O.TotalBrutoCli3,O.TotalBrutoCli2,O.TotalNetoCli3,O.Coeficiente,")
SQL.ADD("O.Cantidad Cantidad1,O.Cantidad Cantidad2,0 Total5,O.Plazo Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaOp Fecha1,O.FechaVto Fecha2,0 Total6,0 Precio3,0 Cantidad7, '0' Check1,0 Cantidad4,0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,' ' as Pata, 0 Cantidad3,0 Cantidad4,0 Cantidad1Ori,0 Cantidad2Ori,0 Cantidad3Ori,0 as Precio2,O.ResultadoIndice,O.Indice ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMFRN','MMFRNP','MMPSC','MMPSI','MMPCL','MMPE','MMPI','MMPLME','MMON','MMPCCV') ")
SQL.ADD("and O.NrOperacion = '"~val(op1)~"' and (O.Indice Is Not Null or O.Indice<>' ') ")
SQL.ADD("and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
*- Que Vencen en ese mes y anio aunque no esten vigentes
SQL.ADD(" and O.FechaVto > '"~IdxDate(val(ma1))~"'   ")
SQL.ADD(" Order By 1,2,3,4")

Recorrer SQL

  dfa
  Message(fbn('NrOperacion'))
  acn(CO:99,Cotizacion(FBN['Indice'],,,,val(ma1),1,SI)/Cotizacion(FBN['Indice'],,,,FBN['FechaOp']-1,1,SI))

  *- ba: Resultado Acumulado bb: Resultado del mes Anterior bc: Diferencia para contabilizar
  ACN(ba:fac,FBN['ResultadoIndice'])

  ACN(bb:fac,0)

  If FBN['FechaOp']<val(ma1)
     ACN(ef:1, FBN['CantidadOri'])

     *- EF
     If NoVacio(FBN['OperacionRef'])
        ACN(ef:2, SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~FBN['OperacionRef']~"' AND Tipo='5'"))
     Else
        ACN(ef:2, SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~FBN['NrOperacion']~"' AND Tipo='5'"))
     EndIf

     *- Cantidad + EF
     ACN(ef:3, val(ef:1)*val(ef:2)/100)  
     ACN(ef:4, val(ef:1)+val(ef:3))

     ACN(bb:fac,val(ef:4)*val(CO:99))
     ACN(bb:fac,val(bb:fac)-val(ef1))
  EndIf

  ACN(bc:fac,val(ba:fac)-val(bb:fac))  

Proximo
