***---Esta funcion escribe el texto ingresado en TX1 cortandolo en las lineas que sean 
***---necesarias. Escribe a razon de CR1 caracteres por linea hasta el blanco siguiente.
***---ACN(CR:1, 80)
***---ACT(TX:1, 'Los USD mencionados seran acreditados en '~Val(NM:1)~', para la cuenta Nro. '~Val(NM:2)~' de '~Val(CL:1)~' - Fecha Valor: '~Val(ZC:&i))
ACN(FI:2, 0)
ACN(LG:1, Longitud(Val(TX:1)))
***---FI:2 = Cantidad de Filas que necesito para el string.
***---Escribo un minimo de CR1 caracteres por linea hasta el siguiente blanco
Recorrer&k 1, 10
    IF Val(LG:1) > (Val(CR:1)*&k) 
        Recorrer&i 1, 50
            IF Eqstr(Copy(Val(TX:1), (Val(CR:1)*&k)+&i, 1), ' ')
                SCN(FI:2, 1)
                IF &k = 1
                    ACN(CA:Val(FI:2), 1)
                    ACN(CB:Val(FI:2), Val(CR:1)*&k+&i)
                ELSE
                    ACN(CA:Val(FI:2), Val(CA:Val(FI:2)-1)+Val(CB:Val(FI:2)-1))
                    ACN(CB:Val(FI:2), (Val(CR:1)*&k+&i)-Val(CA:Val(FI:2)))
                    IF Eqstr(Copy(Val(TX:1), Val(CA:Val(FI:2)), 1), ' ')
                        SCN(CA:Val(FI:2), 1)
                    ENDIF
                ENDIF
                Break
            ENDIF
        Proximo
    ELSE
        SCN(FI:2, 1)
        IF &k = 1 O Val(FI:2) = 1
            ACN(CA:Val(FI:2), 1)
        ELSE
            ACN(CA:Val(FI:2), Val(CA:Val(FI:2)-1)+Val(CB:Val(FI:2)-1))
        ENDIF
        ACN(CB:Val(FI:2), Val(LG:1)-Val(CA:Val(FI:2))+1)
        IF Eqstr(Copy(Val(TX:1), Val(CA:Val(FI:2)), 1), ' ')
            SCN(CA:Val(FI:2), 1)
        ENDIF
        Break
    ENDIF
Proximo
