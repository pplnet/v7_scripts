Message('Prestamos CashFlow C')
SCN(f:200,1)
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo,")
SQL.ADD(" C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp, ")
SQL.ADD(" C.Cantidad1/1000 ImpAm,C.Precio2,C.NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPEM') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
*-- Capital si FIncio<>FConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp, 'Cap' as Tipo,")
SQL.ADD("O.Cantidad/1000 Cant, 0 Int, O.TotalComisiones/1000 Imp,0 as ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPEM') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
*---
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,PrecioEj/1000 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPE') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
*---  Capital si FIncio<>FConcertacion
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD("O.Cantidad/1000 Cant, 0 Int, O.TotalComisiones/1000 Imp,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  O.TipoOp In ('MMPE') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*---
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Cantidad1/1000 ImpAm,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPEM') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *--- Capital Si FInicio<>FConc.
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("O.Cantidad/1000 Cant, 0 Int, O.TotalComisiones/1000 Imp,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp  <> O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPEM') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *---
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo,")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,PrecioEj/1000 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPE') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *--- Capital Si FInicio<>FConc.
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp, 'Cap' as Tipo,")
   SQL.ADD("O.Cantidad/1000 Cant, 0 Int, O.TotalComisiones/1000 Imp,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp  <> O.FechaOp2 ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPE') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *---
Endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("0 Cant, 0 Int, C.Importe4/1000 Imp,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPE','MMPEM') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD("0 Cant, 0 Int, C.Importe4/1000 Imp,0 ImpAm,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPE','MMPEM') ")   
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
*-----
SQL.ADD("order by 1, 2,4,6 ")

Recorrer SQL
   * MessageBox(FBN('NrOperacion')~' '~FBN('Tipo')~' '~Fstr(FBN['Cant'],0,2)~' '~FBN['Fecha'])
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp'])
   
   If FBN['Precio2']=0  y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   Endif
   
   ACN(mt11,0)
   
   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   Endif
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   Endif
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   Endif
   
   *ACN(mt12,IIf(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
   ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
    
   *** Diario o Mensual ***
   If Dialogo.Radio2 = 0
      *** Diario ***
      *-- Ajuste por Capital si FInicio<>FConcertacion
      If EqStr(FBN['Tipo'],'Cap') 
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         *-- af201: Nro. de Operacion que Mostro Capital
         ACT(af:201,FBN['NrOperacion'])
      Else     
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      Endif
   Else
      *** Mensual ***
      If EqStr(FBN['Tipo'],'Cap') 
         Recorrer&i 2, Val(d:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         *-- m201: Nro. de Operacion que Mostro Capital
         ACT(af:201,FBN['NrOperacion'])
      Else
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(f:200),Val(mt11)*Val(mt12))
               SCN(Val(p:200)+1:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(f:200),Val(mt11)*Val(mt12))
            SCN(Val(g:200):Val(i:200),Val(mt11)*Val(mt12))
         Endif
      Endif
   Endif
Proximo

