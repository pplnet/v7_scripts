   SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, ")
   SQL.ADD("(CASE WHEN TipoOp='MMPCL ' THEN (O.TotalNetoCli2-O.TotalIntereses) ELSE (O.TotalIVA+O.ImporteImp) END)/1000 Imp, ")
   SQL.ADD("1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ") 
*   SQL.ADD("DECODE( TipoOp ,'MMPCL ' , (O.TotalNetoCli2-O.TotalIntereses) , (O.TotalIVA+O.ImporteImp))/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ") 
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCL','MMPLME') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
