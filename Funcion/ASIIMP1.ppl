ACT(LW:1, Var('TIPOFACVAL'))
Recorrer&i 1, 10000000
    IF Val(BD:2) = 0
        CrearListBox;'Arial,8,B';'Ingreso de Datos de la Factura Legal - NO BANCOS'
           'Centro Emisor'    ;CE:1..CE:1;;Longitud(Val(CE:FLB)) = 4;'Centro Emisor Invalido -  Debe ser de 4 Caracteres';85;STRING;;RGB(2,255,255)
           'Tipo Factura'     ;TF:1..TF:1;;;;75;COMBO;Var('TIPOFACVAL')
           'Nro.Factura'      ;FA:1..FA:1;;Longitud(Val(FA:FLB)) = 8;'Nro. de Factura Invalido - Debe ser de 8 Caracteres';70;STRING
           'F.Factura'        ;FX:1..FX:1;;Val(FX:FLB) <= Fsys Y Anio(Val(FX:FLB)) > 2000;'Fecha de Factura Invalida';60;FECHA;RGB(2,255,255)
           'Monto Factura'    ;MN:1..MN:1;;Val(MN:FLB) > 0;'Monto Factura Invalido';85;NUMERO;'###,###,###,###.##';RGB(2,255,255);
           'Codigo Barra'     ;CB:1..CB:1;;Longitud(Val(CB:FLB)) = 40 O Eqstr(ItemLista(Val(LW:1), Num(Val(TF:1))+1), 'X');'Codigo de Barra Invalido';250;STRING;50;RGB(2,255,255)
           'C.A.I.'           ;CA:1..CA:1;NO;Longitud(Val(CA:FLB)) = 14 O Eqstr(ItemLista(Val(LW:1), Num(Val(TF:1))+1), 'X');'C.A.I. Invalido';100;STRING;;;Copy(Val(CB:FLB), 18, 14);
           'F.Vto.C.A.I.'     ;FC:1..FC:1;NO;Anio(Val(FC:FLB)) > 2000 O Eqstr(ItemLista(Val(LW:1), Num(Val(TF:1))+1), 'X');'Vto. del CAI Invalido';65;FECHA;;Fecha(Copy(Val(CB:FLB), 38, 2)~'/'~Copy(Val(CB:FLB), 36, 2)~'/'~Copy(Val(CB:FLB), 32, 4));
        FinListBox
    ELSE
        CrearListBox;'Arial,8,B';'Ingreso de Datos de la Factura Legal - BANCOS'
           'Nr.Correlativo'   ;CE:1..CE:1;;Longitud(Val(CE:FLB)) = 4;'Centro Emisor Invalido -  Debe ser de 4 Caracteres';85;STRING;;RGB(2,255,255)
           'Caracter Fijo'    ;TF:1..TF:1;NO;SI;;75;STRING
           'Operacion'        ;FA:1..FA:1;NO;SI;;65;STRING
           'F.Factura'        ;FX:1..FX:1;;Val(FX:FLB) <= Fsys Y Anio(Val(FX:FLB)) > 2000;'Fecha de Factura Invalida';60;FECHA;RGB(2,255,255)
           'Monto Factura'    ;MN:1..MN:1;;Val(MN:FLB) > 0;'Monto Factura Invalido';85;NUMERO;'###,###,###,###.##';RGB(2,255,255);
           'Codigo Barra'     ;CB:1..CB:1;;Vacio(Val(CB:FLB)) O Longitud(Val(CB:FLB)) = 40;'Codigo de Barra Invalido';250;STRING;50;RGB(2,255,255)
           'C.A.I.'           ;CA:1..CA:1;NO;;;100;STRING;150;;IIF(NoVacio(Val(CB:FLB)), Copy(Val(CB:FLB), 18, 14));
           'F.Vto.C.A.I.'     ;FC:1..FC:1;NO;Vacio(Val(CB:FLB)) O Anio(Val(FC:FLB)) > 2000;'Vto. del CAI Invalido';65;FECHA;;IIF(NoVacio(Val(CB:FLB)), Fecha(Copy(Val(CB:FLB), 38, 2)~'/'~Copy(Val(CB:FLB), 36, 2)~'/'~Copy(Val(CB:FLB), 32, 4)));
        FinListBox
    ENDIF
    IF Not OK
        Cancelar
    ENDIF
    ***---Nro. Factura Legal
    IF Val(BD:2) = 1
        ACT(FL:1, Val(CE:1)~Val(TF:1)~Val(FA:1))
    ELSE
        ACT(LW:1, Var('TIPOFACVAL'))
        ACT(TF:2, ItemLista(Val(LW:1), Num(Val(TF:1))+1))
        ACT(FL:1, Val(CE:1)~Val(TF:2)~Val(FA:1))
    ENDIF
    IF Dialogo.Radio1 = 0 O Not Eqstr(Val(CE:1), Copy(Val(NF:1), 1, 4)) O Not Eqstr(Val(TF:2), Copy(Val(NF:1), 5, 1)) O Not Eqstr(Val(FA:1), Copy(Val(NF:1), 6, 8))
        ***---Si es alta o cambie el Nro. de factura Legal
        IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where NrSisExterno = '"~Val(FL:1)~"' AND Cliente1 = '"~Val(E:&k)~"' ") = 1
            MessageBox(" Nro. Factura Legal "~Val(FL:1)~" Ya Existente para el Proveedor "~Val(E:&k))
        ELSE
            Break
        ENDIF
    ELSE
        ***---Modificacion y conserva el Nro de Factura Legal
        Break
    ENDIF
Proximo
