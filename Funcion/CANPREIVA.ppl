*pf1: Fecha Calculo
*pt1: Tipo INT o COM
*pm1: Monto
*pr1: IVA Nor
*pr2: IVA Adi
*pr3: IVA Per
      
*--- IVA ---
ACN(pr1,Round(val(pm1)*MontoImpuesto('IVANOR'~val(pt1),val(pf1),3,val(j1))/100,2))
ACN(pr2,Round(val(pm1)*MontoImpuesto('IVAADI'~val(pt1),val(pf1),3,val(j1))/100,2))

ACN(pr3,0)
if Eqstr(val(k1),'SI') 
  if Eqstr(val(l1),'SI') y val(pf1) >= val(n1) y val(pf1) <= val(o1)
    ACN(pr3,Round(val(pm1)*MontoImpuesto('IVAPER'~val(pt1),val(pf1),3,'')*(1-val(m1)/100),2)/100)
  else
    ACN(pr3,Round(val(pm1)*MontoImpuesto('IVAPER'~val(pt1),val(pf1),3,'')/100,2))
  endif   
endif
  if val(pr3) < Var('IVAPERMIN')
    ACN(pr3,0)
  endif


