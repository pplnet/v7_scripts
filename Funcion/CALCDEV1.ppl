***+++ Esta funcion recibe Val(XX:99)
***+++ 'INTLEN' para Devengados de intereses
***+++ 'INTWHT' para Devengados de WHT
***+++ Devuelve DV1, DV2, DV3

ACD(DS:1, 0)
ACD(DS:2, 0)
ACD(DS:3, 0)
ACD(HS:1, 0)
ACD(HS:2, 0)
ACD(HS:3, 0)

ACN(DV:1, 0)
ACN(DV:2, 0)
ACN(DV:3, 0)
ACN(DV:9, 0)


SQL.ADD(" Select Monto, Fecha ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~Val(a:fac)~"' ")
SQL.ADD(" And NrSaldo = 140 ")
SQL.ADD(" And TipoDevengado = '"~Val(XX:99)~"' ")
*SQL.ADD(" AND Fecha >= '"~Val(E:fac)~"' ")
*SQL.ADD(" AND Fecha < '"~Val(F:fac)~"' ")

Recorrer SQL
  dfa
  *-Calculo de Dev. Acumulados ---> DV1
  If FBN['Fecha'] <= Dialogo.Fecha1
    SCN(DV:1, ABS(FBN['Monto']))
  Endif

  *-Calculo de Dev. Mes ---> DV2
  If FBN['Fecha'] >= PriDeMes(Dialogo.Fecha1,SI) Y FBN['Fecha'] <= Dialogo.Fecha1
    SCN(DV:2, ABS(FBN['Monto']))
  Endif

  *-Calculo de A Dev. ---> DV3
  If FBN['Fecha'] > Dialogo.Fecha1
    SCN(DV:3, ABS(FBN['Monto']))
  Endif
Proximo

IF Eqstr(Val(XX:99), 'INTLEN')
    ACN(I:FAC, Val(DV:1))
    ACN(J:FAC, Val(DV:2))
    ACN(K:FAC, Val(DV:3))
ENDIF
IF Eqstr(Val(XX:99), 'INTWHT')
    ACN(S:FAC, Val(DV:1))
    ACN(T:FAC, Val(DV:2))
    ACN(U:FAC, Val(DV:3))
ENDIF
