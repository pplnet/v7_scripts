**-- Parametros 
* x1: Fecha 
* x3: Anio
* x5: Mes y Anio
* x6: Codigo 
* x7: Tipos de Resultados
* x8: Tipos de Saldos
**------------------------

SQL.ADD("SELECT SUM(CASE WHEN DATEDIFF(day,R.Fecha,'"~IdxDate(Dialogo.Fecha1)~"')=0 THEN Day ELSE 0 END) as Diario,")
SQL.ADD("       SUM(CASE WHEN CONVERT(numeric,STR(MONTH(CONVERT(smalldatetime, R.Fecha)))+STR(YEAR(CONVERT(smalldatetime, R.Fecha)),4))="~Val(x5)~" THEN R.Day ELSE 0 END) as Mes,                                     ")
SQL.ADD("       SUM(CASE WHEN CONVERT(numeric,YEAR(CONVERT(smalldatetime, R.Fecha)))="~Val(x3)~" THEN R.Day ELSE 0 END)  as Anio  ")
SQL.ADD("FROM   "~DBO~".RESULTADOS  R  ")
SQL.ADD("WHERE  R.Especie = '"~Val(x6)~"'  ")
SQL.ADD("       and R.TipoResultado in ("~Pipe2Comillas(Val(x7))~") ")
SQL.ADD("       and R.NrSaldo IN ("~Pipe2Comillas(Val(x8))~") ")
SQL.ADD("       and R.TipoNegocio = 'TIT' ")
SQL.ADD("       and R.Vehiculo = '"~FBN('Vehiculo')~"' ")
SQL.ADD("       and R.Fecha <= '"~IdxDate(Val(x1))~"'  ")