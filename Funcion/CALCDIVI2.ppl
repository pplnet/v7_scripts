** CALCDIVI2
** Calcula Montos de Acciones y Efectivo
** ACT(b:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',VAL(a:fac)),1,30))
** 1ero. calcula el monto del efectivo. Lo que hace es reducir el precio
** en precio1/100

** Calcula el monto total para efectivo********
if Dialogo.Check1 = 1
  acn(ae:fac, Val(d:fac)*Dialogo.Precio1/100)
  acn(ae:fac, Round(val(ae:fac),2))
endif

*** calcula las acciones *****
if Dialogo.Check2 = 1
  acn(p:fac, Val(d:fac)*(Dialogo.Precio2/100))
endif

*** calcula el porcentaje de revaluo
if Dialogo.Check3 = 1
  acn(q:fac, Val(d:fac)*(Dialogo.Precio9/100))
endif

** s: Cantidad + acciones + revaluo
acn(s:fac, Val(d:fac)+Val(p:fac)+Val(q:fac))

*** calcula el canje ****
if Dialogo.Check4 = 1
   acn(r:fac, val(s:fac)*(Dialogo.Precio10/100))
endif

*** Calcula la fraccion *******
acn(t:fac, val(s:fac)/Dialogo.Precio3)
acn(u:fac, Trunc(val(s:fac)/Dialogo.Precio3))
acn(v:fac, (Val(t:fac)-Val(u:fac))*Dialogo.Precio3)

* af: Monto  de Acciones Entero+ Monto de Revaluo - fraccion
* ah: Monto de Fraccion.
acn(af:fac, (val(p:fac)+val(q:fac))-val(v:fac))
acn(ag:fac, val(v:fac))
acn(ah:fac, Round(val(ag:fac)*Dialogo.Precio4/0.01)*0.01)
 
acn(aj:fac,0)
acn(ak:fac,0)

** al: monto en efectivo + monto fraccion.
acn(al:fac, val(ae:fac)+val(ah:fac)-val(ai:fac)-val(aj:fac)-val(ak:fac))
