****** COREN A - Acciones (titulos privados) ******
*Buscar si hay algun ajuste
ACN(v1,0)
BorrarCeldas(ww1..ww4)
SQL.ADD("Select Cantidad, Precio1, Precio2 from "~DBO~".OPERACIONES where ")
SQL.ADD("TipoOp = 'AJUCOR' and Vehiculo1= '"~fbn('Codigo')~"' ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and Especie = '"~Dialogo.Especie1~"' and RB7= '0' and RB6='0' and RB8='5' ")
Recorrer SQL
  dfa
  ACN(v1,1)
  * acumular capital
  SCN(ww1, fbn('Cantidad'))
  * acumular capital por tasa
  SCN(ww2, fbn('Cantidad')*fbn('Precio1') )
  * acumular capital por plazo=> Precio2
  SCN(ww3, fbn('Cantidad')*fbn('Precio2') )
  * acumular capital por tasa por plazo 
  SCN(ww4, fbn('Cantidad')*fbn('Precio1')*fbn('Precio2') )
Proximo
if Val(v1)=1
  * hay ajuste
  * Capital
  ACN(w1, Val(ww1)) 
  * tasa
  If Dialogo.Radio8 = 0 
    ACN(w11, Val(ww2)/Val(ww1))
  else
    ACN(w11, Val(ww4)/Val(ww3))
  endif
  * plazo
  ACN(w12, Val(ww3)/Val(ww1))
else
  *-- Todas las operaciones o Securities ---
  If Dialogo.Radio10=0  o Dialogo.Radio10=2 
    *-- Acciones
    LinkearHoja('SCORE2',47,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio2=1,Radio6=2,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2)
    ACN(w1, LinkH(47, bv:1))
    ACN(w11, LinkH(47, bu:1))
    ACN(w12, 0)
    *CerrarHoja('SCORE2',44,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio2=1,Radio6=2,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2)
    *CerrarLink(47)
  Else 
    ACN(w1, 0)
    ACN(w11,0)
    ACN(w12, 0)
  Endif  
Endif