SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

BITS
24;1
25;0
26;0
30;0
70;0

INSTANCIA24
CAMPOS:0;;1;1=2;
VPRE1: 'Exceso Monto';;;;NO;NO;;;;If(CANTIDAD<=VAR('EXCTACTE'),0,1);If(CANTIDAD<=VAR('EXCTACTE'),0,1)
VPRE2: 'Fecha Valor' ;;;;NO;NO;;;;If(DifDias(FECHAOP,FSYS,VAR('FERIDEF'),SI)<=VAR('DIASCTACTE'),0,1);If(DifDias(FECHAOP,FSYS,VAR('FERIDEF'),SI)<=VAR('DIASCTACTE'),0,1)

POSTEDICION
FW=1 o FW=2;'AUTCC';NrOperacion1=NrOperacion;Entero1=INSTANCIA;Entero2=FW
FW=2 ;'ANULO';NrOperacion1=NROPERACION

BITS
24;0;FW=1 o FW=2
25;1;FW=1 y VPRE1=1
26;1;FW=1 y VPRE2=1
70;1;FW=1 y VPRE1=0 y VPRE2=0
30;1;FW=2


INSTANCIA25
CAMPOS:0
FechaOp       : 'Fecha Op.'     ;1;1;;NO;
FechaPago     : 'F.Acreditacion';1;2;;NO;
Cliente1      : 'Cliente'       ;2;1;;NO;
Especie       : 'Especie'       ;3;1;;NO;
Cuenta1       : 'Cuenta '       ;4;1;;NO;
Cantidad      : 'Importe'       ;5;1;;NO;

FormaPago1    : 'Tipo Dep/Ret'  ;3;2;;NO;
ConceptosOper1: 'Concepto'      ;7;2;;NO;

Mercado2      : 'Mercado'       ;8;2;1;NO;
Cuenta2       : 'Cuenta Veh.'   ;9;2;1;NO;

TotalBrutoCli3: 'IVA'           ;7;1; ;NO;
TotalBrutoCli2: 'Impuesto CR'   ;8;1; ;NO;

Sucursal      : 'Sucursal'      ;11;1;1;NO;
Vehiculo1     : 'Vehiculo'      ;11;2;1;NO;

ObservacDoc   : 'Ref.Univoca'       ;13;1;1;NO;EQSTR(FORMAPAGO1,'TRA')                         ;;;;;;;;;;'!!!!!!!!!!!!!!!!!!!!!!!!!'
Observac3     : 'Nombre Originante' ;14;1;1;NO;EQSTR(TIPOOP, 'CCDEP') y EQSTR(FORMAPAGO1,'TRA');
MensajeChequeo: 'CUIT/CUIL/DNI'     ;15;1;1;NO;EQSTR(TIPOOP, 'CCDEP') y EQSTR(FORMAPAGO1,'TRA');;;;;;;;;;'!!!!!!!!!!!!!!!!!!!!!!!!!'

POSTEDICION
FW=1 o FW=2;'AUTCC';NrOperacion1=NrOperacion;Entero1=INSTANCIA;Entero2=FW
SQL
"Update "~DBO~".EXCEPCIONES Set Autorizado='"~USUARIOACTIVO~"'  Where NrOperacion = '"~NROPERACION~"' "; FW=1 
"Update "~DBO~".OPERACIONESBITS Set Valor='0' Where NrOperacion='"~NROPERACION~"' AND NrBit=26"; FW=2 y FechaVto2=FSYS

BITS
24;1;[FW=2 y FechaVto2=FSYS] 
25;0;[FW=2 y FechaVto2=FSYS] o FW=1
70;1;FW=1 y Query("SELECT 1 FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~NROPERACION~"' AND NrBit=26 AND Valor= '1' ")<>1 


INSTANCIA26
CAMPOS:0
FechaOp       : 'Fecha Op.'     ;1;1;;NO;
FechaPago     : 'F.Acreditacion';1;2;;NO;
Cliente1      : 'Cliente'       ;2;1;;NO;
Especie       : 'Especie'       ;3;1;;NO;
Cuenta1       : 'Cuenta '       ;4;1;;NO;
Cantidad      : 'Importe'       ;5;1;;NO;

FormaPago1    : 'Tipo Dep/Ret.' ;3;2;;NO;
ConceptosOper1: 'Concepto'      ;7;2;;NO;

Mercado2      : 'Mercado'       ;8;2;1;NO;
Cuenta2       : 'Cuenta Veh.'   ;9;2;1;NO;

TotalBrutoCli3: 'IVA'           ;7;1; ;NO;
TotalBrutoCli2: 'Impuesto CR'   ;8;1; ;NO;

Sucursal      : 'Sucursal'      ;11;1;1;NO;
Vehiculo1     : 'Vehiculo'      ;11;2;1;NO;

ObservacDoc   : 'Ref.Univoca'       ;13;1;1;NO;EQSTR(FORMAPAGO1,'TRA')                         ;;;;;;;;;;'!!!!!!!!!!!!!!!!!!!!!!!!!'
Observac3     : 'Nombre Originante' ;14;1;1;NO;EQSTR(TIPOOP, 'CCDEP') y EQSTR(FORMAPAGO1,'TRA');
MensajeChequeo: 'CUIT/CUIL/DNI'     ;15;1;1;NO;EQSTR(TIPOOP, 'CCDEP') y EQSTR(FORMAPAGO1,'TRA');;;;;;;;;;'!!!!!!!!!!!!!!!!!!!!!!!!!'


POSTEDICION
FW=1 o FW=2;'AUTCC';NrOperacion1=NrOperacion;Entero1=INSTANCIA;Entero2=FW
SQL
"Update "~DBO~".EXCEPCIONES Set Autorizado='"~USUARIOACTIVO~"'  Where NrOperacion = '"~NROPERACION~"' "; FW=1 
"Update "~DBO~".OPERACIONESBITS Set Valor='0' Where NrOperacion='"~NROPERACION~"' AND NrBit=25"; FW=2 y FechaVto2=FSYS


BITS
24;1;[FW=2 y FechaVto2=FSYS] 
26;0;[FW=2 y FechaVto2=FSYS] o FW=1
70;1;FW=1 y Query("SELECT 1 FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~NROPERACION~"' AND NrBit=25 AND Valor= '1' ")<>1 


