Message('Exportando excel con resultados...')

let &Directorio Dialogo.Directorio3
@VALIDARUTA


ACD(VR:2, Fsys)

**// FSYS Formato DDMMAA
ACT(VR:3, Copy(Val(VR:2),1,2)~Copy(Val(VR:2),4,2)~Copy(Val(VR:2),9,2))

**// Nombre Archivo - Mismo nombre que el archivo a importar pero le saco la extension.
ACT(VR:4, Copy(Dialogo.String1,1,Longitud(Dialogo.String1)-4))

**// Archivo a exportar
ACT(VR:5, Dialogo.Directorio3~Val(VR:4)~Val(VR:3)~'.xls')

**// Busco el nombre a usar para el archivo -- FORMATO: DDMMAA + (A-Z)
If ExisteArchivo(Val(VR:5))
   Recorrer&k 66, 90
      **// Archivo a exportar
      ACT(VR:5, Dialogo.Directorio3~Val(VR:4)~Val(VR:3)~Chr(&k)~'.xls')
      If Not ExisteArchivo(Val(VR:5))
         Break
      Endif
   Proximo
Endif


**// Si ya existen 25 archivos para ese dia, de la A - Z, (DDMMAAZ) Continuo con DDMMAAZ1 a DDNNAAZ100
If ExisteArchivo(Val(VR:5))
   Recorrer&k 1, 100
      **// Archivo a exportar
      ACT(VR:5, Dialogo.Directorio3~Val(VR:4)~Val(VR:3)~"Z"~Fstr(&k,0,0)~'.xls')
      If Not ExisteArchivo(Val(VR:5))
         Break
      Endif
   Proximo
Endif


ExportarXLS(AS:1..AT:10000,A:1..B:10000, Val(VR:5))

If Not Ok
   MessageBox('No se pudo guardar el archivo '~Val(VR:5)~'. ')
EndIf
