** funcion de informe "Detalle de Operaciones Financieras"

** PARAMETROS:
**             co1: es la columna inicial para comenzar a imprimir
**             co4: 900..Val(co4) es el rango de datos de vtos por fecha
**             co3 = 0 indica que ya imprimi los titulos, entonces
**                   formateo celdas y pongo marcos 
**             fi1: fila actual (fila en la que empiezo a imprimir)
**             fi3: indica si es TOMA DE FONDOS o INVERSION DE FONDOS
**********************************************************************

** Ordeno los datos guardados por entidad
If Val(co4)>900
   OrdenarFilas(900,Val(co4),53,'A')
endif

** fila inicial de datos a recuperar de las celdas guardadas
ACN(co5,899)
** cantidad de filas de datos
acn(co6,Val(co4)-Val(co5) )

ACN(co7,0)

ACT(Val(co1):Val(fi1), 'RESUMEN DE VENCIMIENTOS POR ENTIDAD')
ACT(Val(co1):Val(fi1)+1, 'ENTIDAD')
ACT(Val(co1)+1:Val(fi1)+1, 'CAPITAL')
ACT(Val(co1)+2:Val(fi1)+1, 'INTERES DEV.')
ACT(Val(co1)+3:Val(fi1)+1, IIF(EqStr(Val(fi3),'TOMA'),'IMP. END. DEV.','IMP. GCIAS S/INT') )
ACT(Val(co1)+4:Val(fi1)+1, 'TOTAL')
AlinearCeldas(Val(co1):Val(fi1)+1..Val(co1)+4:Val(fi1)+1,'C')
SetFont(Val(co1):Val(fi1)..Val(co1)+4:Val(fi1)+1,1)
SCN(fi1,1)

ACN(bt1,0)
ACN(bt2,1)
** Recorro el rango de datos
Recorrer&i 1,Val(co6)
   ** Corte de control por entidad
   if Not EqStr(Val(ba:Val(co5)+&i),Val(at1))
      SCN(fi1,1)
      SCN(co7,1)
      ACT(Val(co1):Val(fi1), Val(ba:Val(co5)+&i) )
      ACT(at1,Val(ba:Val(co5)+&i) )
   endif
   SCN(Val(co1)+1:Val(fi1), Val(bc:Val(co5)+&i) )
*   if EqStr(Val(fi3),'TOMA')
*      ACN(bt1, - Val(bf:Val(co5)+&i) )
*      ACN(bt2, - 1)
*   endif

   SCN(Val(co1)+2:Val(fi1), Val(bd:Val(co5)+&i) - Val(bf:Val(co5)+&i) )
   SCN(Val(co1)+3:Val(fi1), Val(bf:Val(co5)+&i) )
   SCN(bs1, Val(bc:Val(co5)+&i) )
   SCN(bs2, Val(bd:Val(co5)+&i) - Val(bf:Val(co5)+&i) )
   SCN(bs3, Val(bf:Val(co5)+&i) )
   SCN(Val(co1)+4:Val(fi1), Val(bc:Val(co5)+&i) + Val(bd:Val(co5)+&i) - Val(bf:Val(co5)+&i) )
   SCN(bs4, Val(bc:Val(co5)+&i) + Val(bd:Val(co5)+&i) - Val(bf:Val(co5)+&i) )
Proximo
ACT(Val(co1):Val(fi1)+1,'TOTAL '~Dialogo.Especie1 )
ACN(Val(co1)+1:Val(fi1)+1,Val(bs1) )
ACN(Val(co1)+2:Val(fi1)+1,Val(bs2) )
ACN(Val(co1)+3:Val(fi1)+1,Val(bs3) )
ACN(Val(co1)+4:Val(fi1)+1,Val(bs4) )
ACN(fi2,1)
if Not EqStr(Dialogo.Especie1,Dialogo.Especie2)
   ACT(Val(co1):Val(fi1)+2,'TOTAL '~Dialogo.Especie2 )
   if EqStr(Modo(Dialogo.Especie1,Dialogo.Especie2),'DIR')
      ACN(Val(co1)+1:Val(fi1)+2,Val(bs1)*Dialogo.Precio1 )
      ACN(Val(co1)+2:Val(fi1)+2,Val(bs2)*Dialogo.Precio1 )
      ACN(Val(co1)+3:Val(fi1)+2,Val(bs3)*Dialogo.Precio1 )
      ACN(Val(co1)+4:Val(fi1)+2,Val(bs4)*Dialogo.Precio1 )
   else
      ACN(Val(co1)+1:Val(fi1)+2,Val(bs1)/Dialogo.Precio1 )
      ACN(Val(co1)+2:Val(fi1)+2,Val(bs2)/Dialogo.Precio1 )
      ACN(Val(co1)+3:Val(fi1)+2,Val(bs3)/Dialogo.Precio1 )
      ACN(Val(co1)+4:Val(fi1)+2,Val(bs4)/Dialogo.Precio1 )
   endif
   SetFont(Val(co1):Val(fi1)+2..Val(co1)+4:Val(fi1)+2,1)
   ACN(fi2,2)
endif
SetFont(Val(co1):Val(fi1)+1..Val(co1)+4:Val(fi1)+1,1)

** Marco de fila de resumen
AgregarMarco(Val(co1):Val(fi1)-Val(co7)-1..Val(co1)+4:Val(fi1)-Val(co7),1,1)
** Marco de datos y columnas
AgregarMarco(Val(co1):Val(fi1)-Val(co7)..Val(co1)+4:Val(fi1),1,2)
** Marco de totales
AgregarMarco(Val(co1):Val(fi1)+1..Val(co1)+4:Val(fi1)+Val(fi2),1,3)

** Realizo el formato de todas las celdas
FormatoCeldas(Val(co1)+2:Val(fi1)-Val(co7)+1..Val(co1)+4:Val(fi1)+Val(fi2),Exe('F2'))
Setfont(Val(co1):Val(fi1)-Val(co7)+1..Val(co1)+4:Val(fi1),2)