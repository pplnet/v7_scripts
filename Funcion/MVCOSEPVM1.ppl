
**// Se actualiza los campos que pudieron haber sido modificados
SQL.ADD(" Select FechaOp2, Book1, Book2, FechaVto, Plazo, Cuotas1, ImpGastos2, TasaImp1, Plazo4, ")
SQL.ADD("        TipoTasa, RB8, Observac2, TablaFeriados1, Precio3, MB1, DeltaTasa, RB11, NrOperacion3 ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(OP:1, FBN('NrOperacion3'))
   SQL.ADD("  Update "~DBO~".OPERACIONES ")
   SQL.ADD("  Set")
   SQL.ADD("    FechaOp2 = '"~IdxDate(FBN('FechaOp2'))~"' , Book1 = '"~FBN('Book2')~"', Book2 = '"~FBN('Book1')~"', ")
   SQL.ADD("    FechaVto = '"~IdxDate(FBN('FechaVto'))~"' , Plazo = "~FBN('Plazo')~", ")
   SQL.ADD("    Cuotas1 = "~FBN('Cuotas1')~"            , ImpGastos2 = "~FBN('ImpGastos2')~", ")
   SQL.ADD("    TasaImp1 = "~FBN('TasaImp1')~"          , Plazo4 = "~FBN('Plazo4')~", ")
   SQL.ADD("    TipoTasa = '"~FBN('TipoTasa')~"'        , RB8 = "~FBN('RB8')~", ")
   SQL.ADD("    Observac2 = '"~FBN('Observac2')~"'      , TablaFeriados1 = '"~FBN('TablaFeriados1')~"', ")
   SQL.ADD("    Precio3 = "~FBN('Precio3')~"            , MB1 = "~FBN('MB1')~",  ")
   SQL.ADD("    DeltaTasa = "~FBN('DeltaTasa')~"        , RB11 = "~FBN('RB11')~",  ")
   **// Marco que la operacion fue modificada
   SQL.ADD("    Impresa = '1' ")
   SQL.ADD("  Where NrOperacion = '"~Val(OP:1)~"' ")
   SQL.NEW
Proximo


**// Se borran las cuotas
SQL.ADD(" Delete From "~DBO~".CUOTAS ")
SQL.ADD(" Where NrOperacion = '"~Val(OP:1)~"' ")
SQL.NEW
SQL.EXEC

**// Insert de cuotas replicando la op original
SQL.ADD(" Select * into #TEMPCUOTAS from "~DBO~".CUOTAS where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Update #TEMPCUOTAS ")
SQL.ADD(" Set NrOperacion = '"~Val(OP:1)~"' ")
SQL.ADD(" Insert into "~DBO~".CUOTAS ")
SQL.ADD(" Select * FROM #TEMPCUOTAS ")
SQL.ADD(" Where NrOperacion = '"~Val(OP:1)~"' ")
SQL.ADD(" DROP TABLE #TEMPCUOTAS ")
SQL.NEW
SQL.EXEC


**// Se borran las comisiones
SQL.ADD(" Delete From "~DBO~".COMISIONES2 ")
SQL.ADD(" Where NrOperacion = '"~Val(OP:1)~"' ")
SQL.NEW

**// Insert de Comisiones replicando la op original
SQL.ADD(" Select * into #TEMPCOM2 from "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Update #TEMPCOM2 ")
SQL.ADD(" Set NrOperacion = '"~Val(OP:1)~"' ")
SQL.ADD(" Insert into "~DBO~".COMISIONES2 ")
SQL.ADD(" Select * FROM #TEMPCOM2 ")
SQL.ADD(" Where NrOperacion = '"~Val(OP:1)~"' ")
SQL.ADD(" DROP TABLE #TEMPCOM2 ")
SQL.NEW
SQL.EXEC

**// Si la Op opera con Vehiculo extranjero (PISA) va a instancia de confirmacion, sino a vinculadas en espera
If Incluido(Val(VH:1), VAR('VEHIEXTRAN')) O Incluido(Val(VH:3), VAR('VEHIEXTRAN'))
   SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='0' where NrOperacion = '"~VAL(OP:1)~"' ")
   SQL.NEW
   SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion = '"~VAL(OP:1)~"' and NrBit=19 ")
   SQL.NEW
Else
   SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='0' where NrOperacion = '"~VAL(OP:1)~"' ")
   SQL.NEW
   SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion = '"~VAL(OP:1)~"' and NrBit=15 ")
   SQL.NEW
Endif

**// Se graba excepcion
SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
SQL.ADD(" (NrOperacion, Fecha, Tipo, Descripcion) Values ")
SQL.ADD(" ('"~Val(OP:1)~"', '"~IdxDate(FSYS)~"','MODEVENTO','"~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~" "~Hora(Ahora)~"') ")
SQL.NEW

SQL.EXEC

**// Actualiza movimientos y devengados
SQL.ActualizarMovimientos3(VAL(OP:1),SI,NO,NO,NO,SI)
SQL.EXEC

**// Calculo de TTN
EjecutarEvento('TTNOP',NrOperacion1=val(OP:1), Entero1 = 0,NrOperacion2='',Lista1='')
