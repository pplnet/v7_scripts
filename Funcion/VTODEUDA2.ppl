*- Capital del Vehiculo
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'SWAP' Grupo,O.NrOperacion,O.FechaOp2 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,O.TotalAux4 VResidual,")
SQL.ADD("O.RB8,O.FechaEx2 FechaVto,O.FechaEx2 FechaSett,O.TipoTasa,O.PrecioRef,0 Spread ,0 Tasa,0 TTN, ")
SQL.ADD("0 TotalIntereses,0 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("O.TotalAux4 ImpAmort,0 Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp2 FInicio,O.FechaEj FFin,O.Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaEx2 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('DTSFF','DTSFV','DTSVV') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("Union All ")
*- Capital de ContraParte
