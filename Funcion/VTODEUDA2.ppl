SQL.ADD("-O.TotalBrutoCli3 ImpAmort,0 Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp2 FInicio,O.FechaEj FFin,O.Plazo,O.CantidadOri")
