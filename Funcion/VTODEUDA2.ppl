SQL.ADD("O.RB8,O.FechaPago FechaVto,O.FechaPago FechaSett,O.TipoTasa2 TipoTasa,O.PrecioRef3 PrecioRef,O.TotalNetoCli2 Spread ,O.TotalGanancias Tasa,0 TTN, ")
SQL.ADD("-O.InteresesCorr TotalIntereses ,-O.InteresesCorr IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("0 ImpAmort,0 Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp2 FInicio,O.FechaEj FFin,O.Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaPago Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('DTSFF','DTSFV','DTSVV') ")
If NoVacio(Dialogo.Especie1)
