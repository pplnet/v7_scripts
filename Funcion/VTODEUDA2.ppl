*--  Multiples Vencimiento
*--- Capital e Interes del Vehiculo
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'SWAP' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad1 VResidual,")
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef2 PrecioRef,C.Total3 Spread ,C.Precio1 Tasa,0 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad3 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("C.Cantidad6 ImpAmort,0 Cotizacion1,O.TotalAux3 Cantidad,C.NrCuota,O.RB6,C.Fecha1 FInicio,C.Fecha2 FFin,C.Plazo1 Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion=C.NrOperacion and C.Fecha3 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("  and C.Plazo1 <> 0 ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD("Union All")
*--- Capital e Interes de la Contraparte
SQL.ADD("Select ")
SQL.ADD("O.Vehiculo1,'SWAP' Grupo,O.NrOperacion,C.Fecha5 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
SQL.ADD("O.RB8,C.Fecha6 FechaVto,C.Fecha7 FechaSett,O.TipoTasa,O.PrecioRef,C.Total4 Spread,C.Precio2 Tasa,0 TTN, ")
SQL.ADD("-C.Cantidad4 TotalIntereses,-C.Cantidad4 IntNeto,0 Monto,0 TasaIva,0 ImpIva,0 TasaWH,")
SQL.ADD("0 ImpWH,0 MontoNeto,0 TasaImpInt,0 ImpInt, ")
SQL.ADD("C.Cantidad5 ImpAmort,0 Cotizacion1,O.TotalBrutoCli2 Cantidad,C.NrCuota,O.RB6,C.Fecha5 FInicio,C.Fecha6 FFin,C.Plazo2 Plazo,O.CantidadOri")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion=C.NrOperacion and C.Fecha7 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("  and C.Plazo2 <> 0 ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
*If NoVacio(Dialogo.Lista1)
*   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*EndIf
SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
