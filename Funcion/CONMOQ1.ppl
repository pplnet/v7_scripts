***---Select

  SQL.ADD("SELECT M.NrOperacion, M.FechaMov, M.CLiente, M.Especie, M.Cantidad, ")

  SQL.ADD(" M.Leyenda, M.NrMov, TipoOp ")

  SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O ")
  SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
  SQL.ADD(" and   M.NrOperacion = O.NrOperacion ")

  SQL.ADD("and M.Especie<>'"~VAR('MONELOCA')~"' and ")
  SQL.ADD(" (M.Leyenda like '%IVA %' or M.Leyenda like '%WH %' or M.Leyenda like  '%Impto.Int %' or Leyenda like '%Imp_Cs_Fin%' or Leyenda like '%Imp.DB%') ")

  SQL.ADD(" AND M.NrSaldo = 1 ")
  SQL.ADD("       and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")

If Dialogo.Fecha2>0
   SQL.ADD("       and M.FechaMov >= '"~IdxDate(Dialogo.Fecha2)~"' ")
EndIf

  SQL.ADD("       and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("       and M.Bits = 'MV' ")

If Novacio(Dialogo.Especie1)
   SQL.ADD("       and M.Especie = '"~Dialogo.Especie1~"' ")
EndIf

If Novacio(Dialogo.Cliente1)
   SQL.ADD("       and M.Cliente = '"~Dialogo.Cliente1~"' ")
EndIf

If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("and M.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
EndIf

  SQL.ADD("       and ((B.NrBit = 20 and B.Valor = '1') or (B.NrBit = 50 and B.Valor = '1'))")

