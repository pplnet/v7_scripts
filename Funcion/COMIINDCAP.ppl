*--> (cp:3) = Capital ajustado (Cantidad) <--*
*--> (cp:5) = Capital amort. ajustado <--*

*--> (vv:3) = TotalComisiones-- <--*
*--> (vc:1) = Importe1--------- <--*
*--> (vc:2) = Cantidad1-------- <--*
*--> (vc:3) = Importe2--------- <--*
*--> (vc:4) = Importe3--------- <--*
*--> (vc:5) = Importe4--------- <--*
*--> (vc:6) = Precio2---------- <--*

If (Val(um:1) + 1) = 1
   *--> Operaciones U.V. <--*  
   Sql.Add("Select C.NrOperacion NrOp, ")
   Sql.Add("       C.NrComision NrComi, ")
   Sql.Add("       C.Tipo Tipo, ")
   Sql.Add("       C.Tasa1 Ta1, ")
   Sql.Add("       C.NrCuota Cuota, ")
   Sql.Add("       C.Importe1 Imp1, ")
   Sql.Add("       C.Especie1 Esp, ")
   Sql.Add("       C.Fecha1 Fe1, ")
   Sql.Add("       C.Cliente1 Cl1, ")
   Sql.Add("       C.RB1 RB1, ")
   Sql.Add("       C.Tasa2 Ta2, ")
   Sql.Add("       C.Importe2 Imp2, ")
   Sql.Add("       C.Tasa3 Ta3, ")
   Sql.Add("       C.Importe3 Imp3, ")
   Sql.Add("       C.RB2 RB2, ")
   Sql.Add("       C.Precio1 Pr1, ")
   Sql.Add("       C.Precio2 Pr2, ")
   Sql.Add("       C.Importe4 Imp4, ")
   Sql.Add("       C.Cantidad1 Ca1, ")
   Sql.Add("       C.Cotizacion1 Co1, ")
   Sql.Add("       C.Cotizacion2 Co2, ")
   Sql.Add("       C.Importe5 Imp5, ")
   Sql.Add("       O.Plazo Pl, ")
   Sql.Add("       O.OperacionRef OpRef, ")
   Sql.Add("       0 Cant, ")
   Sql.Add("       O.TipoOp TipoOp, ")
   Sql.Add("       0 CTCa2, ")
   Sql.Add("       1 Uni_Mul ")
   Sql.Add("  From "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES O ")
   Sql.Add(" Where C.NrOperacion =  '"~FBN['NrOp']~"' ")
   *--> Tratando de solucionar que la comision no este liquidada <--*
   Sql.Add("   and C.Fecha1      >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   Sql.Add("   and C.NrOperacion =  O.NrOperacion ")
Else
   *--> Operaciones M.V. <--*
   *--> Se definio que se ingresara el numero de cuota en las comisiones. (Mail de Leonardo 08/05)
   Sql.Add("Select C.NrOperacion NrOp, ")
   Sql.Add("       C.NrComision NrComi, ")
   Sql.Add("       C.Tipo Tipo, ")
   Sql.Add("       C.Tasa1 Ta1, ")
   Sql.Add("       C.NrCuota Cuota, ")
   Sql.Add("       C.Importe1 Imp1, ")
   Sql.Add("       C.Especie1 Esp, ")
   Sql.Add("       C.Fecha1 Fe1, ")
   Sql.Add("       C.Cliente1 Cl1, ")
   Sql.Add("       C.RB1 RB1, ")
   Sql.Add("       C.Tasa2 Ta2, ")
   Sql.Add("       C.Importe2 Imp2, ")
   Sql.Add("       C.Tasa3 Ta3, ")
   Sql.Add("       C.Importe3 Imp3, ")
   Sql.Add("       C.RB2 RB2, ")
   Sql.Add("       C.Precio1 Pr1, ")
   Sql.Add("       C.Precio2 Pr2, ")
   Sql.Add("       C.Importe4 Imp4, ")
   Sql.Add("       C.Cantidad1 Ca1, ")
   Sql.Add("       C.Cotizacion1 Co1, ")
   Sql.Add("       C.Cotizacion2 Co2, ")
   Sql.Add("       C.Importe5 Imp5, ")
   Sql.Add("       CT.Plazo1 Pl, ")
   Sql.Add("       O.OperacionRef OpRef, ")
   Sql.Add("       O.Cantidad Cant, ")
   Sql.Add("       O.TipoOp TipoOp, ")
   Sql.Add("       CT.Cantidad2 CTCa2, ")
   Sql.Add("       2 Uni_Mul ")
   Sql.Add("  From "~DBO~".COMISIONES2 C, "~DBO~".CUOTAS CT, "~DBO~".OPERACIONES O ")
   Sql.Add(" Where O.NrOperacion  =  '"~FBN['NrOp']~"' ")
   Sql.Add("   and O.NrOperacion  =  CT.NrOperacion ")
   Sql.Add("   and CT.NrOperacion =  C.NrOperacion ")
   Sql.Add("   and C.NrCuota      =  '"~FBN['Cuota']~"' ")
   Sql.Add("   and C.NrCuota      =  CT.NrCuota ")
   Sql.Add("   and C.Fecha1       >= '"~IdxDate(Dialogo.Fecha1)~"' ")
EndIf
Sql.Add(" Order by Fe1, Tipo, Cuota ")

RECORRER SQL
  * FJL 24/11/11 para que no avance en las lineas del listado de operaciones
  DFA

  If FBN['Uni_Mul'] = 1
    ACN(vv:3, Val(vu:3))
  Else
    ACN(vv:3, Val(vm:3))
  EndIf

  *  messageBox('Op. '~fbn('NrOp')~' Fn COMIIND x hacer UpDate')
  if Dialogo.Check1=1
  * messageBox('Op. '~fbn('NrOp')~' Fn COMIIND haciendo UpDate')
    Sql.Add(" Update "~DBO~".COMISIONES2 Set ")
    Sql.Add(" Importe1 = "~FStr(Val(vc:1),0,2)~" ,")
    Sql.Add(" Importe2 = "~FStr(Val(vc:3),0,2)~" ,")
    Sql.Add(" Importe3 = "~FStr(Val(vc:4),0,2)~" ,")
    Sql.Add(" Importe4 = "~FStr(Val(vc:5),0,2)~" ,")
    Sql.Add(" Precio2 = "~FStr(Val(vc:6),0,2)~" ")
    Sql.Add(" Where NrOperacion = '"~FBN['NrOp']~"' ")

    If FBN['Uni_Mul'] = 2
      Sql.Add("   and NrCuota = '"~FStr(FBN['Cuota'],0,0)~"' ")   
    EndIf

    Sql.Add("   and NrComision = '"~FStr(FBN['NrComi'],0,0)~"' ")
    Sql.Add("   and Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' ")

    Sql.New
    Sql.Exec
  endif

