         * e1=>Interes 
         ACN(e1,FBN['PrecioEj']*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))
   
         * d1=> Importe Variable CEN  d2: Importe Total CEN  
         ACN(d1,IIF(FBN['RB6']=1,(FBN['PrecioEj']*FBN['Precio2']*FBN['Plazo'])/IIF(FBN['MB3']=0,36000,36500),0)  )
         ACN(d2,IIF(FBN['RB6']=1,VAL(d1)+FBN['ImpComCor1'],0))

         * d3: Importe Variable CEC  d4: Importe Total CEC
         ACN(d3,IIF(FBN['RB6']=0,((FBN['PrecioEj']*FBN['ImpGastos1']*FBN['Plazo'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Precio3']/100),0) )
         ACN(d4,IIF(FBN['RB6']=0,FBN['ImpComCor2']+VAL(d3),0))

         * f1: Importe de Iva  f2: Importe WH f3: Importe IVA CEN   
         ACN(f1,(VAL(d4)+((FBN['PrecioEj']*FBN['Plazo']*FBN['TotalAux4'])/IIF(FBN['RB7']=0,36000,36500))*(FBN['ImpGastos2']/100)) ) 
         ACN(f2,IIF(FBN['RB6']=0,0,IIF(FBN['RB6']=2,FBN['PrecioEj']*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)*(FBN['TOTALAUX1']/100),FBN['PrecioEj']*FBN['Plazo']*FBN['TotalAux2']/IiF(FBN['RB9']=1,36500,36000)*(FBN['TotalAux1']/100))) )

         * e2=> Impuesto Interes e3 => Interes Total 
         ACN(e2,IIF(FBN['RB6']=0,VAL(e1),IIF(FBN['RB6']=1,VAL(d2),0))*(FBN['TasaImp1']/100)  )
         ACN(e3,FBN['PeriodoInts']+VAL(e1)+VAL(d4)+VAL(d2)+Val(f2)+VAL(e2))

         * e4: Monto e5: MontoTotal
         ACN(e4,FBN['PrecioEj']+VAL(e1))
         ACN(e5,FBN['PrecioEj']+VAL(e3))
         ACN(f3,VAL(d2)*(FBN['IntDevengados1']/100) )
       
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
         SQL.ADD(" TotalIntereses="~Fstr(val(e1),0,2)~", ")
         SQL.ADD(" TotalGanancias="~Fstr(val(d1),0,2)~", ")
         SQL.ADD(" PorComMer1="~Fstr(val(d2),0,2)~", ")
         SQL.ADD(" ImpComCorEq1="~Fstr(val(d3),0,2)~", ")
         SQL.ADD(" ImpComCorEq2="~Fstr(val(d4),0,2)~", ")
         SQL.ADD(" ImporteImp="~Fstr(val(e2),0,2)~", ")
         SQL.ADD(" TotalNetoCli2="~Fstr(val(e3),0,2)~", ")  
         SQL.ADD(" TotalBrutoCli1="~Fstr(val(e4),0,2)~",")
         SQL.ADD(" TotalGastos="~Fstr(val(f3),0,2)~", ")
         SQL.ADD(" TotalAux3="~Fstr(val(f2),0,2)~", ")
         SQL.ADD(" TotalNetoCli1="~Fstr(val(e5),0,2)~",TotalIVA="~Fstr(val(f1),0,2)~"  ")
         SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")
         SQL.NEW
