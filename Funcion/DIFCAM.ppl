
***/// tipoCotizacion: Tipo Cotizacion BNA|Mercado  0|1
***/// tipoCambio:   Tipo de Cambio Comprador|Vendedor 1|2 
***/// fechaDC:   Fecha (Habil)
***/// fechaDesde: FechaDC menos cantidad de días que se quiere calcular la diferencia de cambio
***/// monto:   Monto sobre el que se calcula DC
***/// monedaCot: Especie del evento
***/// DC: Diferencia de cambio
***************************************************************************************************

If &tipoCotizacion = 0
    **//TC BNA    
    let &DC ((&monto * CotizacionBNA(&monedaCot,&fechaDC,&tipoCambio,NO,NO))-(&monto * CotizacionBNA(&monedaCot,&fechaDesde,&tipoCambio,NO,NO)))
    let &hoy CotizacionBNA(&monedaCot,&fechaDC,&tipoCambio,NO,NO)
    let &ayer CotizacionBNA(&monedaCot,&fechaDesde,&tipoCambio,NO,NO)
    *MessageBox(Fstr(&monto, 0, 4))
    *MessageBox(Fstr(&hoy, 0, 4))
    *MessageBox(Fstr(&ayer, 0, 4))
*Message(&fechaDC)
*Message(&fechaDesde)
*Esperar(1)
Else
    **//TC Mercado            
    let &DC ((&monto * Cotizacion(&monedaCot,,,,&fechaDC,&tipoCambio))-(&monto * Cotizacion(&monedaCot,,,,&fechaDesde,&tipoCambio)))
Endif
*IF &DC <> 0
*MessageBox('1')
**ENDIF