* devuelve en at: estos FD
ACN(pl1,0)
ACN(fd1,0)
ACN(fd2,0)

* Veo cual es el precioref del tipo tasa
ACT(pr1,SQL("SELECT PrecioRef FROM "~DBO~".TIPOSTASA WHERE Codigo='"~FBN['TipoTasa']~"' "))

SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pr1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and TD.PlazoHasta=")
SQL.ADD("(Select Min(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pr1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~"<=PlazoHasta ) Union All")
SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo  and TT.PrecioRef='"~Trim(Mirt(val(pr1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"'  and TD.PlazoHasta=")
SQL.ADD("(Select Max(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pr1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~">PlazoHasta )")
SQL.ADD("ORDER BY TD.PlazoHasta  ")

Recorrer SQL
   dfa
   IF val(pl1)<=val(fe3) y val(fe3)<=FBN['PlazoHasta']
      * Este es el plazo a interpolar  
      ACN(fd3,val(fd1)/FBN['Valor4'] -1 )
      ACN(fd4,(val(fd3)/(FBN['Valor3']-val(fd2)))*100 )
      ACN(fd5,(FBN['Valor3']-(val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd2))*val(fd1)+((val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd2))/(FBN['Valor3']-val(fd2))*FBN['Valor4']) 
   EndIf
   ACN(pl1,FBN['PlazoHasta'])
   ACN(fd1,FBN['Valor4'])
   ACN(fd2,FBN['Valor3'])
Proximo
ACN(at:fac,val(fd5)) 
