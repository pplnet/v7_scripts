ACN(fo1, 0)
ACN(fo2, 0)
ACN(fo3, 0)
ACN(fo4, 0)
ACN(fo5, 0)

 
*- Ajuste de Cobertura
SQL.ADD("Select O.Especie,O.RB9,O.RB6,O.RB10,O.RB11,O.RB7,O.RB8,ValorRB1,O.FechaOp,O.FechaVto,Sum(O.Cantidad) as Cantidad from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('AJPOFI') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   *- Corto Plazo
   SQL.ADD("   and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   *- Largo Plazo
   SQL.ADD("   and O.FechaVto  > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD("group by O.Especie,RB9,RB6,RB10,RB7,RB8,O.RB11,ValorRB1,O.FechaOp,O.FechaVto")
SQL.ADD("order by O.RB9,O.RB6,O.RB10,O.RB7,O.RB8,O.RB11,ValorRB1,O.Especie")

act(es1,'')
act(ti1,'')

*- Fila previa
acn(fp1,0)

*- aj: Valores de filas a ubicar en los ajustes, inicializada en filasinf1

Recorrer SQL

  *- Cuando cambia la linea
  IF [Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))] o [Not EqStr(val(ti1),FBN['RB9']~FBN['RB6']~FBN['RB10']~FBN['RB11']~FBN['RB7']~FBN['RB8']~FBN['ValorRB1']) y NoVacio(val(ti1))]
     (.'TOTALRESU'.)

     *- Impresion de totales por Renglon
     *- Lectura previa de Renglon fa1: Renglon que acaba de imprimir  fp1: Renglon que va a imprimir

     IF EqStr(FBN['RB9'],'0') y [EqStr(FBN['RB6'],'0') o EqStr(FBN['RB6'],'1')]
        ACN(fp1,val(aj1))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'2')
        ACN(fp1,val(aj2))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'3')
        ACN(fp1,val(aj20))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'4')
        ACN(fp1,val(aj21))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'5')
        *- Otras Cuentas 
        IF EqStr(FBN['RB10'],'0')   
           *- Otras Op.Dinero en Transito Canc.Exterior
           ACN(fp1,val(aj30))
        EndIf
        IF EqStr(FBN['RB10'],'1')   
           *- Bonos en Transito por Canjes
           ACN(fp1,val(aj31))
        EndIf
        IF EqStr(FBN['RB10'],'2')   
           *- Certificados de Credito Fiscal
           ACN(fp1,val(aj32))
        EndIf
     EndIf

     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'0')
        ACN(fp1,val(aj3))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'1')
        ACN(fp1,val(aj4))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'2')
        ACN(fp1,val(aj22))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'3')
        ACN(fp1,val(aj40))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'4')
        ACN(fp1,val(aj41))
     EndIf

     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'0')
        ACN(fp1,val(aj6))
     EndIf
     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'1')
        ACN(fp1,val(aj7))
     EndIf
     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'2')
        ACN(fp1,val(aj8))
     EndIf
     IF Not val(fa1)=val(fp1)
        (.'TOTALRESU2'.)
     EndIf
  EndIf

  IF Not EqStr(val(es1),FBN['Especie'])
     ACT(es1,FBN['Especie'])
      
     ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
     ACN(pr1,1)
       
     If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
        ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
     EndIf
  EndIf

  If Not EqStr(val(ti1),FBN['RB9']~FBN['RB6']~FBN['RB10']~FBN['RB11']~FBN['RB7']~FBN['RB8']~FBN['ValorRB1'])
     ACT(ti1,FBN['RB9']~FBN['RB6']~FBN['RB10']~FBN['RB11']~FBN['RB7']~FBN['RB8']~FBN['ValorRB1'])
     *- Inicializo Filas
     IF EqStr(FBN['RB9'],'0') y [EqStr(FBN['RB6'],'0') o EqStr(FBN['RB6'],'1')]
        *- Saldo de Otras Cuentas en Dolares y Saldo de Otras Cuentas en Pesos
        ACN(fa1,val(aj1))
        ACN(fa2,val(fi4))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'2')
        *- Dinero en Transito
        ACN(fa1,val(aj2))
        ACN(fa2,val(fi4))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'3')
        *- Otros Conceptos
        ACN(fa1,val(aj20))
        ACN(fa2,val(fi4))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'4')
        *- USD atesoramiento
        ACN(fa1,val(aj21))
        ACN(fa2,val(fi4))
     EndIf
     IF EqStr(FBN['RB9'],'0') y EqStr(FBN['RB6'],'5')
        *- Otras Cuentas 
        IF EqStr(FBN['RB10'],'0')   
           *- Otras Op.Dinero en Transito Canc.Exterior
           ACN(fa1,val(aj30))
           ACN(fa2,val(fi4))
        EndIf
        IF EqStr(FBN['RB10'],'1')   
           *- Bonos en Transito por Canjes
           ACN(fa1,val(aj31))
           ACN(fa2,val(fi4))
        EndIf
        IF EqStr(FBN['RB10'],'2')   
           *- Certificados de Credito Fiscal
           ACN(fa1,val(aj32))
           ACN(fa2,val(fi4))
        EndIf
     EndIf

     *---
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'0')
        *- Imp_Endeudamiento => Va en Intereses
        ACN(fa1,val(aj3))
        ACN(fa2,val(fi8))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'1')
        *- WH => Va en Intereses
        ACN(fa1,val(aj4))
        ACN(fa2,val(fi8))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'2')
        *- Otros Conceptos
        ACN(fa1,val(aj22))
        ACN(fa2,val(fi8))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'3')
        *- Unwind Deriviados
        ACN(fa1,val(aj40))
        ACN(fa2,val(fi8))
     EndIf
     IF EqStr(FBN['RB9'],'1') y EqStr(FBN['RB7'],'4')
        *- CC
        ACN(fa1,val(aj41))
        ACN(fa2,val(fi8))
     EndIf
     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'0')
        *- Difer_TLock
        ACN(fa1,val(aj6))
        ACN(fa2,val(aj5))
     EndIf
     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'1')
        *- UnderWriting Fee 
        ACN(fa1,val(aj7))
        ACN(fa2,val(aj5))
     EndIf
     IF EqStr(FBN['RB9'],'2') y EqStr(FBN['RB8'],'2')
        *- Otros Fees a Pagar
        ACN(fa1,val(aj8))
        ACN(fa2,val(aj5))
     EndIf
     ACN(fo1,0)
     ACN(fo2,0)
  EndIf

  IF EqStr(FBN['RB9'],'2') o [EqStr(FBN['RB9'],'1') y [EqStr(FBN['RB7'],'0') o EqStr(FBN['RB7'],'1') o [EqStr(FBN['RB7'],'3') y EqStr(FBN['RB11'],'1')] ]] 
     *- Va en Intereses
     If EqStr(FBN['ValorRB1'],'0') o EqStr(FBN['ValorRB1'],'') o EqStr(FBN['ValorRB1'],' ') o EqStr(FBN['ValorRB1'],'-1')               
        SCN(fo2,FBN['Cantidad']*Val(pr1))
     Else          
        *- de1: Cantidad  de2: Cant Dias de3: Dias Devengados de4: Devengado
        *- de5: A Devengar
        ACN(de1,FBN['Cantidad']*Val(pr1)) 
        ACN(de2,FBN['FechaVto']-FBN['FechaOp']) 
        ACN(de3,Dialogo.Fecha1-FBN['FechaOp']+1) 
        ACN(de4,(val(de1)/val(de2))*val(de3)) 
        ACN(de5,val(de1)-val(de4))

        SCN(fo2,val(de5))     
     EndIf
  Else
     If EqStr(FBN['ValorRB1'],'0') o EqStr(FBN['ValorRB1'],'') o EqStr(FBN['ValorRB1'],' ') o EqStr(FBN['ValorRB1'],'-1')               
        *- No Devenga => Toma los montos como vienen
        SCN(fo1,FBN['Cantidad']*Val(pr1))
     Else  
        *- de1: Cantidad  de2: Cant Dias de3: Dias Devengados de4: Devengado
        *- de5: A Devengar
        ACN(de1,FBN['Cantidad']*Val(pr1)) 
        ACN(de2,FBN['FechaVto']-FBN['FechaOp']) 
        ACN(de3,Dialogo.Fecha1-FBN['FechaOp']+1) 
        ACN(de4,(val(de1)/val(de2))*val(de3)) 
        ACN(de5,val(de1)-val(de4))

        SCN(fo1,val(de5))     
     EndIf
  EndIf
Proximo
If NoVacio(val(es1))
   (.'TOTALRESU'.)

   (.'TOTALRESU2'.)
EndIf

