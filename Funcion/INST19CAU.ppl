INSTANCIA19
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1);FW=1
FechaOp2        : 'Fecha Conc.'                ;1;1;;NO
FechaOp         : 'Fecha_Origen'               ;2;1;;NO
Vehiculo1       : 'Vehiculo'                   ;1;2;;NO
Book1           : 'Book'                       ;2;2;;NO 
   
Cliente1        : 'Entidad'                    ;4;1;;NO
Especie         : 'Especie'                    ;5;1;;NO
Cantidad        : 'Cantidad'                   ;6;1;;NO;;;;;;;;;;;'###,###,###,###,###.##';
TipoTasa        : 'Tipo_Tasa'                  ; ; ;;NO
Plazo           : 'Plazo'                      ; ; ;;NO
RB10            : 'Interes|Consumido|Pactado'  ;10;;;NO;EqStr(TIPOOP,'MMDPAC');
TotalIntereses  : 'Interes Pact'               ;10;2;;NO;EqStr(TIPOOP,'MMDPAC');

TablaFeriados1  : 'Feriados'                   ;12;1;;NO 
Operador        :                              ;13; ;;NO

@COMICAU

VCAN7           : 'INTERES MOD'                ;3 ;1;2;NO;NO;;;;;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000))

VTXT11  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT12  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)
Label1     : ''              ;17;1;2;NO;NoVacio(CONTRAESPECIE) Y Not Incluido(TIPOOP, 'DSEO|MMONM');;;;'Especie                                                     ContraEspecie';'Especie                                                     ContraEspecie';;;;;;
Label2     : ''              ;17;1;2;NO;Vacio(CONTRAESPECIE) O Incluido(TIPOOP, 'DSEO|MMONM');;;;'Especie';'Especie';;;;;;
Cuenta1 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')       ;18;1;2;;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(IF(EQSTR(TIPOOP, 'MMONM') Y PRECIO5=1, CONTRAESPECIE5, ESPECIE),CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')] y NOVACIO(CUENTA1);"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')~"' "~IF(EQSTR(TIPOOP, 'MMONM') Y PRECIO5=1, CONTRAESPECIE5, ESPECIE);SI;IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,IF(EQSTR(TIPOOP, 'MMONM') Y PRECIO5=1, CONTRAESPECIE5, ESPECIE),CORREDOR,,TIPOOP,'HAB'), CUENTA1);IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,IF(EQSTR(TIPOOP, 'MMONM') Y PRECIO5=1, CONTRAESPECIE5, ESPECIE),CORREDOR,,TIPOOP,'HAB'), CUENTA1);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~IF(EQSTR(TIPOOP, 'MMONM') Y PRECIO5=1, CONTRAESPECIE5, ESPECIE)~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')"     
Cuenta2 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')       ;18;2;2;NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE) Y Not Incluido(TIPOOP, 'MMONM');Incluido(TIPOOP, 'MMONM') O Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'HAB')]]];"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CORREDOR,,TIPOOP,'HAB'), CUENTA2);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CORREDOR,,TIPOOP,'HAB'), CUENTA2);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')" 

Cuenta3 : 'Cta.M.Local:'  ;20;1;2;NoVacio(ESPECIE) y Not EqStr(ESPECIE,VAR('MONELOCA'));NO Y NoVacio(ESPECIE) y Not EqStr(ESPECIE,VAR('MONELOCA')) Y NOT EQSTR(TIPOOP,'MMDPAC') ;SI O [[[CLIENTECUENTA(VEHICULO1,CUENTA3) y ESPECIECUENTA(ESPECIE,CUENTA3) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA3),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA3),'SUS')] y NOVACIO(CUENTA3)] o EqStr(ESPECIE,VAR('MONELOCA'))] O Eqstr(TIPOOP, 'MMDPAC');'Error en Cuenta de Mon.Local '~VAR('MONELOCA');SI;;;;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null) and (Especies Like '%"~VAR('MONELOCA')~"%' )" 

