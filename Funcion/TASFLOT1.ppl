*-----------------------------------------------------------------------------
* Operaciones con FechaVto y TotalBrutoCli1
* 
***---MMPLME Se divide en dos querys (por especie) para poder agruparla
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.TotalIntereses Importe, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cliente1, O.FechaOp2 Inicio, O.FechaVto Fin, 0 NrCuota, O.FechaOp2 Reset, O.Plazo, ")
SQL.ADD(" O.TipoTasa, O.Precio1 Tasa, O.Spread ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMPLME') ")
SQL.ADD(" AND O.Especie = '"~Var('MONEEXTR')~"' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:2))~") ")
SQL.ADD(" AND O.FechaOp2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.TotalIntereses > 0 ")
SQL.ADD(" AND ((O.TipoTasa Is Not Null AND O.TipoTasa<>'FIJA') OR (O.TipoTasa2 Is Not Null AND O.TipoTasa<>'FIJA')) ")
IF Dialogo.Radio1 = 1
    SQL.ADD(" AND (O.Precio1 = 0 OR O.Precio1 Is Null) ")
ENDIF

SQL.ADD(" Union ")

