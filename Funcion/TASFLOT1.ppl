*- MMFIMV y MMSIMV Definitivos -> RB5=0
SQL.ADD(" Select O.Vehiculo1, O.Especie, C.Cantidad3 Importe, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cliente1, C.Fecha1 Inicio, C.Fecha2 Fin, C.NrCuota, C.Fecha1 Reset, C.Plazo1 Plazo, ")
SQL.ADD(" O.TipoTasa, C.Precio2 Tasa, C.Precio4 Spread ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:2))~") ")
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
SQL.ADD(" and O.RB5='0' ")
SQL.ADD(" AND C.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND C.Cantidad3 > 0 ")
SQL.ADD(" AND ((O.TipoTasa Is Not Null AND O.TipoTasa<>'FIJA') OR (O.TipoTasa2 Is Not Null AND O.TipoTasa<>'FIJA')) ")
IF Dialogo.Radio1 = 1
    SQL.ADD(" AND (C.Precio2 = 0 OR C.Precio2 Is Null) ")
ENDIF

SQL.ADD(" Union ")

