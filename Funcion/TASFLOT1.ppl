SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:2))~") ")
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
SQL.ADD(" and O.RB5='1' ")
