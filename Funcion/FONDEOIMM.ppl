
SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ( ")
SQL.ADD(" TipoOp, NrOperacion, Especie, Cantidad, ")
SQL.ADD(" TipoTasa, Precio1, ContraEspecie, ")
SQL.ADD(" FechaOp, Plazo, FechaVto, DiasAnio, ")
SQL.ADD(" TotalIntereses, TotalBrutoCli1, Vehiculo1, Vehiculo2, ")
SQL.ADD(" Book1, Book2, ")
SQL.ADD(" Cliente1, TablaFeriados1, CB10,   ")
SQL.ADD(" FechaCargaSys, FechaCarga, UsrInput, Operador, EnteCus1, ")
SQL.ADD("  RB10 ")
SQL.ADD(" ) VALUES ( ")
SQL.ADD(" 'IMM', '"~Val(y1)~"', '"~Val(e:fac-1)~"', "~fstr(abs(Val(i:fac-1)),0,2)~", ")
SQL.ADD(" '"~Val(f:fac-1)~"', "~fstr(Val(j:fac-1),0,8)~",'"~CotizaEn(Val(e:fac-1))~"', ")
* FO 09/01/2006 SQL.ADD(" "~idxdate2(Val(fc:1))~", "~fstr(Val(pl:1),0,0)~",  "~idxdate2(Val(fv:1))~", '"~Val(r:fac-1)~"', ")
SQL.ADD(" "~idxdate2(Val(fc:1))~", "~fstr(Val(pl:1),0,0)~",  "~idxdate2(Val(fv:1))~", '"~Val(ba:1)~"', ")
SQL.ADD(" "~fstr(abs(Val(m:fac-1)),0,2)~",  "~fstr(abs(Val(n:fac-1)),0,2)~", '"~Val(b:fac-1)~"',  '"~Val(b:fac-1)~"',  ")
If Val(tb:1)<0
   * --- Cuando es + el book de trading es el beneficiario
   SQL.ADD(" '"~Val(c:fac-1)~"', '"~Val(g:fac-1)~"',  ")
Else
   * --- Cuando es - el book de trading es el prestador
   SQL.ADD(" '"~Val(g:fac-1)~"', '"~Val(c:fac-1)~"',  ")
Endif
SQL.ADD(" '"~Val(b:fac-1)~"', 'ARG', '1', ")
SQL.ADD(" "~idxdate2(FSYS)~", "~SQLAHORA~", '"~USUARIOACTIVO~"', '"~USUARIOACTIVO~"', '"~Val(g:fac-1)~"', ")
If Dialogo.Radio1=0
   * Fondeo de Titulos
   SQL.ADD(" '0' ")
Else
   * Fondeo de Moneda
   SQL.ADD(" '1' ")
Endif
SQL.ADD(" ) ")
SQL.NEW
SQL.EXEC


