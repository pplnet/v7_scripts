* UPPAPCL - Update de Partidas - MMPCL
         * d1=> ImpComCorEq2: Importe Variable CEC d2: ImpComCor1=> Imp.Tot._CEC 
         ACN(d1,IIF(FBN['RB6']=1,((FBN['PrecioEj']*FBN['ImpGastos1']*FBN['Plazo'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Precio3']/100),0))
         ACN(d2,VAL(d1)+FBN['ImpComCor2'])

         * e1=>Interes e2=> Impuesto Interes e3 => Interes Total  e4: Monto e5: MontoTotal
         ACN(e1,FBN['PrecioEj']*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))
         ACN(e2,VAL(e1)*(FBN['TasaImp1']/100))
         ACN(e3,VAL(e1)+VAL(e2)+IIF(FBN['RB6']=1,FBN['ImpComCor1'],0))
         ACN(e4,FBN['PrecioEj']+VAL(e1))
         ACN(e5,FBN['PrecioEj']+VAL(e3))
     
         * f1: Importe de Iva
         ACN(f1,IIF(FBN['RB6']=1,(((FBN['PrecioEj']*FBN['Plazo']*FBN['TotalAux4'])/IIF(FBN['RB7']=0,36000,36500)+FBN['ImpComCor1'])*(FBN['ImpGastos2']/100)),((FBN['PrecioEj']*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))+FBN['ImpComCor1'])*(FBN['ImpGastos2']/100)) )
  
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
         SQL.ADD(" ImpComCorEq2="~Fstr(val(d1),0,2)~", ")
         SQL.ADD(" ImpComCor1="~Fstr(val(d2),0,2)~", ")
         SQL.ADD(" TotalIntereses="~Fstr(val(e1),0,2)~", ")
         SQL.ADD(" ImporteImp="~Fstr(val(e2),0,2)~", ")
         SQL.ADD(" TotalNetoCli2="~Fstr(val(e3),0,2)~", ")
         SQL.ADD(" TotalBrutoCli1="~Fstr(val(e4),0,2)~",")
         SQL.ADD(" TotalNetoCli1="~Fstr(val(e5),0,2)~",TotalIVA="~Fstr(val(f1),0,2)~"  ")
         SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")
         SQL.NEW
