VTXT11  : 'Ascend. Especie'  ;18;2;2;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
VTXT12  : 'Ascend. ContraE'  ;19;2;2;NO;NO;;;;Ascendientes('ESPECIES',CONTRAESPECIE);Ascendientes('ESPECIES',CONTRAESPECIE)

Label1     : ''              ;17;1;2;NO;NoVacio(CONTRAESPECIE) Y Not Incluido(TipoOp, 'DSEO|MMONM');;;;'Especie                                                     ContraEspecie';'Especie                                                     ContraEspecie';;;;;;
Label2     : ''              ;17;1;2;NO;Vacio(CONTRAESPECIE) O Incluido(TipoOp, 'DSEO|MMONM');;;;IF(Incluido(TipoOp, 'DSEO'), 'ContraEspecie', 'Especie');IF(Incluido(TipoOp, 'DSEO'), '                                                                    ContraEspecie', 'Especie');;;;;;

Cuenta1 : If(Incluido(TIPOOP,EXE('CARTA1V')) Y Not Incluido(TIPOOP,'FXAS|FXASV|FXAT|FXATV|'),'Debito en','Credito a');18;1;2;Not EV;Not Incluido(TipoOp, 'DSEO');[Incluido(TipoOp, 'DSEO')] O [[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')] y NOVACIO(CUENTA1)];"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')~"' "~ESPECIE;SI;IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,If(Eqstr(TIPOOP,'MMCAUA'),CORREDOR,CLIENTE1),,TIPOOP,'HAB'), CUENTA1);IF(Eqstr(ABM, 'A'), CUENTACLIENTE(VEHICULO1,ESPECIE,If(Eqstr(TIPOOP,'MMCAUA'),CORREDOR,CLIENTE1),,TIPOOP,'HAB'), CUENTA1);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')"     
Cuenta2 : If([Incluido(TIPOOP,EXE('CARTA1V')) Y Not Incluido(TIPOOP,'FXAS|FXASV|FXAT|FXATV|')] O [Eqstr(TipoOp, 'DSEO')],'Credito a','Debito en')       ;18;2;2;Not EV Y NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE) Y Not Incluido(TIPOOP, 'MMONM');Incluido(TIPOOP, 'MMONM') O Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'HAB')]]];"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')~"' "~CONTRAESPECIE;SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,If(Eqstr(TIPOOP,'MMCAUA'),CORREDOR,CLIENTE1),,TIPOOP,'HAB'), CUENTA2);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,If(Eqstr(TIPOOP,'MMCAUA'),CORREDOR,CLIENTE1),,TIPOOP,'HAB'), CUENTA2);;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'HAB' and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')" 
