SQL.ADD(" P.FechaOp2, O.FechaOp2 Inicio, O.FechaEj Fin, O.TipoTasa, O.TotalGanancias Tasa, 0 NrCuota,'CONT' Pata ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
