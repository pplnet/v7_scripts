   SQL.ADD(" and P.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPago >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    IF Val(MV:1) = 0
        SQL.ADD(" AND O.FechaPago <= '"~IdxDate(Dialogo.Fecha3)~"' ")
    ELSE
        SQL.ADD(" AND O.FechaEj = '"~IdxDate(Dialogo.Fecha3)~"' ")
    ENDIF
ENDIF
SQL.ADD(" AND O.TotalBrutoCli1 > 0 ")
SQL.ADD(" AND P.TipoOp = 'MMPLME' ")
SQL.ADD(" AND P.Especie = '"~Var('MONEEXTR')~"' ")
