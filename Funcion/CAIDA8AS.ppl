*****************************************************************************************
***---Swaps Multiple Vtos.
***---Datos Vehiculo
SQL.ADD(" Select O.Vehiculo1 As Clave, O.Especie, C.Fecha3 Vto, C.Cantidad6 Importe, ")
SQL.ADD(" O.OperacionRef NrOperacion, 'SWAP' as Tipo, O.TipoOp, ' ' as DescImp, 0 as BD1, ")
SQL.ADD(" CASE P.TipoOp WHEN 'MMPE  ' THEN 'BUYERS' WHEN ")
SQL.ADD("                   'MMPI  ' THEN 'BUYERS' WHEN ")
SQL.ADD("                   'MMPEM ' THEN 'BUYERS' WHEN ")
SQL.ADD("                   'MMPIM ' THEN 'BUYERS' WHEN ")
SQL.ADD("                   'MMON  ' THEN 'O.N. EN ' WHEN ")
SQL.ADD("                   'MMONM ' THEN 'O.N. EN ' WHEN ")
SQL.ADD("                   'MMFIMV' THEN 'F.R.N. / YANKEE' WHEN ")
SQL.ADD("                   'MMFRNP' THEN 'F.R.N. / YANKEE' WHEN ")
SQL.ADD("                   'MMSIMV' THEN 'PRESTAMOS SINDICADOS' WHEN ")
SQL.ADD("                   'MMPSI ' THEN 'PRESTAMOS SINDICADOS' WHEN ")
SQL.ADD("                   'MMPCL ' THEN 'PRESTAMOS FINANCIEROS' WHEN ")
SQL.ADD("                   'MMPCOS' THEN 'PRESTAMOS FINANCIEROS' WHEN ")
SQL.ADD("                   'MMPCLM' THEN 'PRESTAMOS FINANCIEROS' WHEN ")
SQL.ADD("                   'MMPOSM' THEN  'PRESTAMOS FINANCIEROS' WHEN ")
SQL.ADD("                   'MMPLME' THEN 'PRESTAMOS FINANCIEROS' END Grupo, ")
SQL.ADD(" O.Cliente1, O.FechaOp, C.Fecha2 FechaVto, ' ' as MarcaSwap, O.NrOperacion OperacionRef, ")
SQL.ADD(" P.FechaOp2, C.Fecha1 Inicio, C.Fecha2 Fin, O.TipoTasa, C.Precio1 Tasa, C.NrCuota,'VEHI' Pata ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and P.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and P.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" AND O.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    IF Val(MV:1) = 0
        SQL.ADD(" AND C.Fecha3 <= '"~IdxDate(Dialogo.Fecha3)~"' ")
    ELSE
        SQL.ADD(" AND C.Fecha2 = '"~IdxDate(Dialogo.Fecha3)~"' ")
    ENDIF
ENDIF
SQL.ADD(" AND C.Cantidad6 > 0 ")
SQL.ADD(" AND O.OperacionRef = P.NrOperacion ")
SQL.ADD(" AND (P.TipoOp IN ('MMPE','MMPI','MMPEM','MMPIM','MMON','MMONM','MMFIMV','MMFRNP','MMSIMV','MMPSI','MMPCL','MMPCOS','MMPCLM','MMPOSM') ")
SQL.ADD("      OR (P.TipoOp = 'MMPLME' AND P.Especie <> '"~Var('MONEEXTR')~"')) ")

SQL.ADD(" UNION ")

***---Datos Contraparte
SQL.ADD(" Select O.Vehiculo1 As Clave, O.ContraEspecie Especie, C.Fecha7 Vto, -C.Cantidad5 Importe, ")
SQL.ADD(" O.OperacionRef NrOperacion, 'SWAP' as Tipo, O.TipoOp, ' ' as DescImp, 0 as BD1, ")
