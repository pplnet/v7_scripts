** SELECCIONO OPERACIONES VINCULADAS
If Dialogo.Radio3<>0
   *- Todas las operaciones
   SQL.ADD(" Select  3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" O.Cantidad Importe,  ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMPCCV' THEN O.TotalNetoCli1 ELSE O.Cantidad+O.TotalIntereses END ImporteVto,  ")
   SQL.ADD(" 0 ImpInt, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'VIMINM' THEN  0 ELSE  O.Cantidad END Cantidad , ")
   SQL.ADD(" O.Spread , CASE O.TipoOp WHEN 'MMPCCV' THEN -O.TotalComisiones ELSE 0 END Comision,  O.Precio1 Tasa,  O.RB8, O.Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
   SQL.ADD(" where O.Cliente1 = CL.Codigo ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  ( (O.TipoOp In ('MMPCCV') and O.MB3=1) or (O.TipoOp In ('VIMIND','VIMINM') and O.MB3=0) )  ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   SQL.ADD(" Select 3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" C.Cantidad1 Importe, C.Cantidad1+C.Total3 ImporteVto, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMPCCM' THEN 0 ELSE C.Cantidad4 END ImpInt, ")
   SQL.ADD(" C.Cantidad2 Cantidad, CASE O.TipoOp WHEN 'MMPCCM' THEN C.Precio4 ELSE O.Spread END Spread, ")
   SQL.ADD(" 0 Comision, C.Precio2 Tasa, O.RB8, CASE O.TipoOp WHEN 'MMPCCM' THEN  0 ELSE C.Plazo1 END Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo ")
   SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  ( (O.TipoOp In ('MMCPM')) or (O.TipoOp In ('MMPCCM') and O.MB3=1) ) ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   SQL.ADD(" Select 3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" O.Cantidad Importe, O.TotalBrutoCli1 ImporteVto, ")
   SQL.ADD(" 0 ImpInt, O.Cantidad Cantidad, O.Spread, 0 Comision, O.Precio1 Tasa, O.RB8, C.Plazo1 Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo ")
   SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and   O.TipoOp In ('MMCDIA') ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   SQL.ADD("Select  3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" O.Cantidad Importe, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMCP  ' THEN O.TotalNetoCli1 WHEN 'MMD   ' THEN O.Cantidad WHEN 'MMDCA ' THEN O.Cantidad+O.TotalNetoCli2 ELSE O.TotalBrutoCli1 END ImporteVto,  ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMO   ' THEN 0 ELSE O.TotalRetenciones END ImpInt, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMD   ' THEN 0 ELSE O.Cantidad END Cantidad , O.Spread, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'MMCCR ' THEN O.PeriodoInts ELSE 0 END Comision, O.Precio1 Tasa, O.RB8, O.Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL  ")
   SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  O.TipoOp In ('MMCP','MMDCA','MMO','MMD','MMCCR') ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   SQL.ADD(" Select  3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp, O.Cantidad Importe, O.TotalBrutoCli1 ImporteVto, 0 ImpInt, ")
   SQL.ADD(" O.Cantidad, O.Spread, 0 Comision, O.Precio1 Tasa, O.RB8, O.Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL  ")
   SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.FechaVto2 Is Not Null and O.FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"') or (O.FechaVto2 Is Null and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"') )")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  O.TipoOp In ('MMCDP') ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   *** depositos por compra/venta de moneda no puesto ****
   SQL.ADD(" Select  3 Orden, 2 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" O.Cantidad Importe, CASE O.TipoOp WHEN 'FXCS  ' THEN O.Cantidad WHEN 'FXVS  ' THEN O.Cantidad ELSE O.Cantidad END ImporteVto, 0 ImpInt, ")
   SQL.ADD("  0 Cantidad, 0 Spread, 0 Comision, 0 Tasa, O.RB8, 0 Plazo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL  ")
   SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto <> O.FechaPago ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
   If Dialogo.Radio3=1
      SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=2
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
   Endif
   If Dialogo.Radio3=3
      SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
      SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
   Endif
   SQL.ADD(" UNION ALL ")
EndIf
If Dialogo.Radio3=0 o Dialogo.Radio3<>0
   ** SALDOS DE FONDOS
   SQL.ADD(" Select  1 Orden, 1 Grupo, P.Cliente Cliente1, P.Vehiculo as Vehiculo1, P.Especie, P.Fecha FechaVto, ")
   SQL.ADD(" P.Fecha FechaOp, ' ' NrOperacion, 'FONDO' TipoOp, 0 Importe, 0 ImporteVto, P.PrecioFin ImpInt, ")
   SQL.ADD(" P.CantidadFin Cantidad, 0 Spread, 0 Comision, 0 Tasa, '0' RB8, 0 Plazo ")
   SQL.ADD(" from "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
   SQL.ADD(" where  P.Especie = E.Codigo ")
   SQL.ADD(" and  P.NrSaldo = 101 ")
   SQL.ADD(" and  E.Tipo = 'FON' ")
   If NoVacio(Dialogo.Lista2)
*      SQL.ADD(" and E.Tipo = 'NO QUIERO QUE ENTRE' ")
       SQL.ADD(" and E.Tipo In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and  E.Cotiza = '"~val(en1)~"' ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  P.Vehiculo In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
   SQL.ADD(" and  P.Fecha = (Select Max(D.Fecha) from "~DBO~".POSICIONES D ")
   SQL.ADD("                   where  D.Vehiculo = P.Vehiculo ")
   SQL.ADD("                   and    D.Especie = P.Especie  ")
   SQL.ADD("                   and    D.Cliente = P.Cliente  ")
   SQL.ADD("                   and    D.NrSaldo = 101 ")
   SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Val(fe2))~"') ")
   SQL.ADD(" UNION ALL ")
   ** SELECCIONO LAS OPERACIONES DE FONDOS DE HOY
   ** ayuda: el campo ImporteVto lo uso para saber si la operacion fue en efectivo,cuotaspartes sin precio o cuotaspartes con precio
   SQL.ADD(" Select  2 Orden, 1 Grupo, O.Cliente1, O.Vehiculo1, O.Especie, O.FechaVto, ")
   SQL.ADD(" O.FechaOp, O.NrOperacion, O.TipoOp, ")
   SQL.ADD(" CASE O.TipoOp WHEN 'FCR   ' THEN -O.TotalNetoCli1 ELSE O.TotalNetoCli1 END Importe,")
   SQL.ADD(" CASE O.TipoOp WHEN 'FCR   ' THEN -Cantidad ELSE Cantidad END ImporteVto, O.Precio1 ImpInt, CASE O.TipoOp WHEN 'FCR   ' THEN -Cantidad ELSE Cantidad END, 0 Spread, 0 Comision, 0 Tasa, '0' RB8, 0 Plazo ")

   SQL.ADD(" FROM "~DBO~".OPERACIONES O  ")
   SQL.ADD(" WHERE TipoOp in ('FCS','FCR') ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   endif
   SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.ContraEspecie = '"~val(en1)~"' ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   endif
EndIf
SQL.ADD("order by 2,5,1,9,6")
