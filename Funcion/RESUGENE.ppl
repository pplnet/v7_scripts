SQL.ADD(" Select Sum(Day) Day ")
SQL.ADD(" From "~DBO~".RESULTADOS R ")
SQL.ADD(" Where R.Especie = '"~Val(ES:1)~"' ") 
SQL.ADD(" AND R.NrSaldo = "~Val(NR:1)~" ")
SQL.ADD(" AND R.TipoResultado = '"~Val(TR:1)~"' ")
SQL.ADD(" AND R.TipoNegocio = '"~Val(TN:1)~"' ")
SQL.ADD(" AND R.Book = '"~Val(BK:1)~"' ")
SQL.ADD(" AND R.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND R.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
*SQL.ADD(" AND R.Fecha = (Select Max(Fecha) From "~DBO~".RESULTADOS S ")
*SQL.ADD("                Where S.Especie = R.Especie ")
*SQL.ADD("                AND S.Vehiculo = R.Vehiculo ")
*SQL.ADD("                AND S.NrSaldo = R.NrSaldo ")
*SQL.ADD("                AND S.TipoNegocio = R.TipoNegocio ")
*SQL.ADD("                AND S.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")
IF EQstr(Val(ES:1), 'DBGLOB')
*SQL.ADD(" Order by 1, ")
ENDIF
Recorrer SQL
    DFA
    ACN(RS:1, fbn('Day'))
Proximo
