 ACT(f:Fac,GetNumerador(1))
 ACLT(f:fac,VAL(F:FAC))

 Message('*- Elimino la transacciones '~VAL(CA2)~' Anteriores para el mismo periodo actual ... ')
 SQL.ADD("DELETE "~DBO~".TRANSACCIONES2 Where TipoTr2='"~val(ca2)~"'    ")
 SQL.ADD("and Fecha2='"~IdxDate(Dialogo.Fecha2)~"' and Fecha3='"~IdxDate(Dialogo.Fecha3)~"'  ")
 SQL.ADD("and Cliente1='"~val(a:fac)~"'                                 ")
 SQL.NEW          

 *- Genero la Transaccion COMCTA por cobro de comision de Saldos
 *- Fecha1 Proceso, Fecha2: Desde Calculo Fecha3: Hasta Calculo
 SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2                                       ")
 SQL.ADD("(Vehiculo1, Fecha1, Cliente1,                                            ")
 SQL.ADD(" Cantidad6, Cuenta1, Especie,                                            ")
 SQL.ADD(" NrTrans, TipoTr2, Cantidad2,                                            ")
 SQL.ADD(" Cambio5,Cantidad3,Fecha2,Fecha3) Values                                              ")
 SQL.ADD("('"~Dialogo.Vehiculo1~"','"~IdxDate(Dialogo.Fecha1)~"','"~Val(a:fac)~"', ")
 SQL.ADD(" "~Fstr(Abs(val(c:fac)),0,2)~",'"~val(g:Fac)~"', 'ARP',                  ")
 SQL.ADD(" '"~val(f:Fac)~"','"~val(ca2)~"',"~Fstr(Abs(val(c:fac)),0,2)~",          ") 
 SQL.ADD("  "~Fstr(Abs(val(d:fac)),0,2)~","~Fstr(Abs(val(e:fac)),0,2)~",'"~IdxDate(Dialogo.Fecha2)~"','"~IdxDate(Dialogo.Fecha3)~"') ")
 SQL.NEW
 SQL.EXEC

 *- Actualizo el Movimiento de la transaccion
 *SQL.ActualizarMovimientosT2(val(f:Fac),SI,NO,NO,NO)
 *SQL.EXEC

 *------------------------------------------------------------------------------------------------
 *--- Movimiento de COMISION DE CUSTODIA NRO 5 E IVA NRO. 6
 ACT(mp1,val(f:Fac) )
 ACD(mp2,Dialogo.Fecha1)
 ACT(mp3,Val(a:fac) )
 ACT(mp4,'ARP')
 ACT(mp5,'')
 ACT(mp6,'')
 ACT(mp7,'')
 ACT(mp8,'')
 ACT(mp9, Dialogo.Vehiculo1)
 ACN(mp10,-Abs(val(c:fac)) )
 ACT(mp11,'')
 ACT(mp12,'Comision Cuenta '~val(ca2))
  
 *- Condicion de Automatico
 ACT(mp13,'AV')
 ACT(mp17,'')

 *- mp17: FechaEje
 ACD(mp17,Fsys)

 *- mp14: Nr.Saldo
 ACN(mp14,4)

 *- mp15: NrGrupo Nada, mp16: Concepto nada, mp20: NrGrupo2 nada
 *- mp19: Cuenta
 ACN(mp15,41)
 ACT(mp19,val(g:Fac))

 *- Nro.Mov.
 ACN(mp22,5)

 *- Cupon 
 ACT(mp27,'')

 *- mp25: NrLiq = ''
 ACT(mp25,'')

 *- Elimino el mov. previamente vc5: Tabla
 ACT(vc5,'MOVPENDIENTES' )
 IF EqStr(val(mp13),'AV')
    ACT(vc5,'MOVEJECUTADOS' )
 ENDIF     
 (.'DELMOVTR'.)

 (.'IMMOVPEND'.)      

 *--------------------------- IVA
 ACD(mp2,Dialogo.Fecha1)
 ACT(mp3,Val(a:fac) )
 ACT(mp4,'ARP')
 ACT(mp5,'')
 ACT(mp6,'')
 ACT(mp7,'')
 ACT(mp8,'')
 ACT(mp9,Dialogo.Vehiculo1)
 ACN(mp10,-Abs(val(e:fac)))
 ACT(mp11,'')
 ACT(mp12,'IVA Com. Cuenta '~val(ca2))
  
 *- Condicion de Automatico
 ACT(mp13,'AV')
 ACT(mp17,'')

 *- mp17: FechaEje
 ACD(mp17,Fsys)

 *- mp14: Nr.Saldo
 ACN(mp14,4)

 *- mp15: NrGrupo Nada, mp16: Concepto nada, mp20: NrGrupo2 nada
 *- mp19: Cuenta
 ACN(mp15,42)
 ACT(mp19,val(g:Fac))

 *- Nro.Mov.
 ACN(mp22,6)

 *- Cupon 
 ACT(mp27,'')

 *- mp25: NrLiq = ''
 ACT(mp25,'')

 *- Elimino el mov. previamente vc5: Tabla
 ACT(vc5,'MOVPENDIENTES' )
 IF EqStr(val(mp13),'AV')
    ACT(vc5,'MOVEJECUTADOS' )
 ENDIF     
 (.'DELMOVTR'.)

 (.'IMMOVPEND'.)      

 SQL.ADD("Insert Into "~DBO~".OPERACIONESBITS ")
 SQL.ADD("  (NrOperacion, NrBit, Valor ) ")
 SQL.ADD(" Values ")
 SQL.ADD("  ('"~val(f:Fac)~"', "~fstr(70,0,0)~", '1') ")
 SQL.NEW
 SQL.EXEC

