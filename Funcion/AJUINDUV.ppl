*--> (bc:2) = BuscarCampo ------- <--*

*--> (cp:3) = Capital ajustado--- <--*

*--> (vu:2) = VCAN10------------- <--*
*--> (vu:3) = TotalComisiones---- <--*
*--> (vu:4) = PrecioEj----------- <--*
*--> (vu:5) = TotalIntereses----- <--*
*--> (vu:6) = TotalBrutoCli1----- <--*
*--> (vu:7) = ImpComCorEq2------- <--*
*--> (vu:8) = ImpComCor1--------- <--*
*--> (vu:9) = ImporteImp--------- <--*
*--> (vu:10) = TotalNetoCli2----- <--*
*--> (vu:11) = TotalNetoCli1----- <--*
*--> (vu:12) = TotalIVA---------- <--*  MMCP
*--> (vu:13) = PrecioMer--------- <--*
*--> (vu:14) = ResultadoIndice--- <--*
*--> (vu:15) = TotalRetenciones-- <--*
*--> (vu:16) = PeriodoInts------- <--*
*--> (vu:17) = TotalAux3--------- <--*  MMCP
*--> (vu:18) = TotalGanancias---- <--*
*--> (vu:19) = ImpComCorEq1------ <--*
*--> (vu:20) = PorComMer1-------- <--*
*--> (vu:21) = Precio2----------- <--*
*--> (vu:22) = TotalGastos------- <--*
*--> (vu:23) = TotalBrutoCli3---- <--*
*--> (vu:24) = TotalNetoCli3----- <--*
*--> (vu:25) = TotalDerechos----- <--*
*--> (vu:26) = TotalImpuestos---- <--*
*--> (vu:27) = TotalImpuesto1---- <--*
*--> (vu:28) = Cantidad---------- <--*
*--> (vu:29) = IMP DB/CR--------- <--*
*--> (vu:30) = TotalAux1--------- <--*  MMCP
*--> (vu:31) = ImpGastos2-------- <--*  MMCP
*--> (vu:31) = TotalAux2--------- <--*  MMCP


If EqStr(FBN['Tipo'], 'MMCP')
  * INTERES (TotalIntereses)  
  ACN(vu:5, Val(cp:3) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) )
  * MONTO (TOTALBRUTOCLI1)
  ACN(vu:6, Val(cp:3) + Val(vu:5) )
  * RET GAN (TOTALRETENCIONES)
  If FBN['TRet'] = 0
     ACN(vu:15, 0 )  
  else
     ACN(vu:15, Val(vu:5) * FBN['ImpG1'] / 100 )
  endif
  * INT.NETO (TOTALNETOCLI2)
  ACN(vu:10, Val(vu:5) - Val(vu:15) )
  * MONTO NETO (TOTALNETOCLI1)
  ACN(vu:11, Val(vu:6) - Val(vu:15)  )
  * IVA DIRECTO (TotalAux1)
  If FBN['Alias2'] = 0
     ACN(vu:30, 0 )  
  else
     ACN(vu:30, Val(vu:5) * FBN['ImpG2'] / 100  )
  endif
  * PERCEPCION IVA (TotalAux3)
  If FBN['Alias4'] = 0
     ACN(vu:17, 0 )  
  else
     ACN(vu:17, Val(vu:5) * FBN['Alias3'] / 100  )
  endif
  * TOTAL IVA (Cantidad6)
  ACN(vu:12, Val(vu:30) + Val(vu:17)  )
  * pRECIOmER
  ACN(vu:13, Val(cp:3) * COTIZACIONC(FBN['Esp'],,,,FBN['FIni'], 1, SI, VAR('MONEEXTR')) )
  * RESULTADO iNDICE (pRECIOMER)
  ACN(vu:14, Val(cp:3) - FBN['COri']  )
  * IMP DB/CR                                        *++++ A confirmar aplicacion     
  ACN(vu:29, Val(cp:3) * FBN['DT'] / 100 )
EndIf



If EqStr(FBN['Tipo'], 'MMPCL')

   ACN(vu:2, IIF(NOVACIO(FBN['OpRef']), SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion = '"~FBN['OpRef']~"' AND Tipo='5'"), SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ")) )
   ACN(vu:3, (Val(cp:3) * Val(vu:2)) / 100 )
   ACN(vu:4, Val(cp:3) + Val(vu:3) )
   ACN(vu:5, Val(vu:4) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) )
   ACN(vu:6, Val(vu:4) + Val(vu:5) )
   ACN(vu:7, IIF(FBN['RB6'] = 1,((Val(vu:4) * FBN['ImpG1'] * FBN['Pl'] )/IIF(FBN['MB1'] = 0, 36000, 36500 )) * (FBN['Pr3']/100) ,0) )
   ACN(vu:8, FBN['ImpCC2'] + Val(vu:7) )
   ACN(vu:9, IIF(FBN['TImp1'] <> 0, IIF(FBN['Pr1'] > VAR('TASAIMPINT'), ((((Val(vu:4) * (VAR('TASAIMPINT') / 100) * FBN['Pl']) / 36500)) * FBN['TImp1']) ,Val(vu:5) * FBN['TImp1'] / 100) , 0) )
   ACN(vu:10, Val(vu:5) + Val(vu:9) + IIF (FBN['RB6'] = 1, Val(vu:8), 0) )
   ACN(vu:11, Val(vu:4) + Val(vu:10) )
   ACN(vu:12, IIF(FBN['RB6']=1, ((Val(vu:4) * FBN['Alias1'] / 100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8']+1)) + Val(vu:8)) * (FBN['ImpG2'] / 100), ((Val(vu:4) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8']+1)) + Val(vu:8)) * (FBN['ImpG2'] / 100)) )
   ACN(vu:13, Val(vu:4) * COTIZACIONC(FBN['Esp'],,,,FBN['FIni'], 1, SI, VAR('MONEEXTR')) )
   ACN(vu:14, Val(vu:4) - (FBN['COri'] * (1 + Val(vu:2) / 100)) )
   ACN(vu:15, Val(vu:5) * FBN['TBa'] / 100 )

EndIf

If EqStr(FBN['Tipo'], 'MMPI')

   ACN(vu:2, IIF(NOVACIO(FBN['OpRef']), SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion = '"~FBN['OpRef']~"' AND Tipo='5'"), SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ")) )
   ACN(vu:3, (Val(cp:3) * Val(vu:2)) / 100 )
   ACN(vu:4, Val(cp:3) + Val(vu:3) )
   ACN(vu:5, (Val(cp:3) + Val(vu:3)) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) )   
   ACN(vu:6, (Val(cp:3) + Val(vu:3)) + Val(vu:5) )
   ACN(vu:17, IIF(FBN['RB6']=0, 0, IIF(FBN['RB6']=2, Val(vu:4)*((FBN['Pr1']+FBN['Sp'])/100)*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)*(FBN['Alias2']/100), Val(vu:4)*FBN['Alias3']/100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)*(FBN['Alias2']/100))) )
   ACN(vu:18, IIF(FBN['RB6']=0,((Val(vu:4)*FBN['ImpG1']*FBN['Pl'])/IIF(FBN['MB1']=0, 36000, 36500))*(FBN['Pr3']/100) ,0) )
   ACN(vu:13, Val(vu:4) * COTIZACIONC(FBN['Esp'],,,,FBN['FOp'],1,SI,VAR('MONEEXTR')) )
   ACN(vu:19, IIF(FBN['RB6']=1,(Val(vu:4)*FBN['Pr2']*FBN['Pl'])/IIF(FBN['MB3']=0, 36000, 36500),0) )
   ACN(vu:20, IIF(FBN['RB6']=0,FBN['ImpCC2']+Val(vu:18),0) )
   ACN(vu:12, (Val(vu:20)+((Val(vu:4)*FBN['Alias1'])/100*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)))*(FBN['ImpG2']/100))
   ACN(vu:16, IIF(FBN['RB6']=0,Val(vu:20)*(FBN['DT']/100),0))
   ACN(vu:7, IIF(FBN['RB6']=1,FBN['ImpCC1'] + Val(vu:19),0) )
   ACN(vu:9, IIF(FBN['RB6']=0,Val(vu:5),IIF(FBN['RB6']=1,Val(vu:7),0))*(FBN['TImp1']/100) )
   ACN(vu:10, Val(vu:16)+Val(vu:5)+Val(vu:20)+Val(vu:7)+Val(vu:17)+Val(vu:9) )
   ACN(vu:11, (Val(cp:3)+Val(vu:3))+Val(vu:10) )    
   ACN(vu:14, Val(vu:4) - (FBN['COri'] * (1 + Val(vu:2) / 100)) )

EndIf

If EqStr(FBN['Tipo'], 'MMPE')

   ACN(vu:2, IIF(NOVACIO(FBN['OpRef']), SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion = '"~FBN['OpRef']~"' AND Tipo='5'"), SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ")) )   
