If EqStr(FBN['Tipo'], 'MMFRN')

   ACN(vu:4, Val(cp:3))
   ACN(vu:2, IIF(NOVACIO(FBN['OpRef']), SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion = '"~FBN['OpRef']~"' AND Tipo='5'"), SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ")) )
   ACN(vu:3, Val(vu:4) * Val(vu:2)/100 )
