   ACN(vu:14, IIF(INCLUIDO(FBN['Tipo'],'MMFRN|MMPSC|MMSCMV|MMFCMV|'), Val(cp:3)-(FBN['COri']*(1+Val(vu:2)/100)), FBN['TBC2']-FBN['COri']) )
   ACN(vu:28, Val(vu:4) + Val(vu:3) )

EndIf

If EqStr(FBN['Tipo'], 'MMON')

   ACN(vu:2, SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ") )   
   ACN(vu:3, (Val(cp:3) * Val(vu:2)) / 100 )
   ACN(vu:4, Val(cp:3) + Val(vu:3) )      
   ACN(vu:24, Val(cp:3) )
   ACN(vu:5, Val(vu:4) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) )  
   ACN(vu:6, Val(vu:4) + Val(vu:5) )   
   ACN(vu:12, IIF(FBN['RB6']=0, ((Val(vu:4) * (FBN['Alias1'] / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8']+1)) * FBN['ImpG2']) / 100, 0) )
   ACN(vu:17, ((Val(vu:4) * (FBN['Alias3']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8']+1)) * FBN['Alias2'])/100 )
   ACN(vu:25, Val(vu:4) * (1-FBN['TG']) )
   ACN(vu:13, Val(vu:4) * COTIZACIONC(FBN['Esp'],,,,FBN['FIni'], 1, SI, VAR('MONEEXTR')) )
   ACN(vu:9, Val(vu:5) * (FBN['TImp1']/100) )
   ACN(vu:10, Val(vu:5) + Val(vu:17) + Val(vu:9) )
   ACN(vu:26, Val(vu:5) * FBN['TBa'] /100 )
   ACN(vu:11, Val(vu:6) + Val(vu:17) )
   ACN(vu:14, Val(vu:4) - (FBN['COri'] * (1 + Val(vu:2) / 100)) )

EndIf

If EqStr(FBN['Tipo'], 'MMPCCV')

   ACN(vu:5, (Val(cp:3) + FBN['TComi']) * ((FBN['Pr1'] + FBN['Sp']) / 100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) )
   ACN(vu:6, (Val(cp:3) + FBN['TComi']) + Val(vu:5) )
   ACN(vu:12, IIF(FBN['RB6']=0 O [FBN['RB6']=2 y FBN['MB3']=0], (Val(cp:3)+FBN['TComi']) * (FBN['Alias1']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) * (FBN['ImpG2']/100) ,0) )
   ACN(vu:17, IIF(FBN['RB6']=2 y FBN['MB3']=0, (Val(cp:3) + FBN['TComi']) * (FBN['Alias3']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] + 1) * FBN['Alias2']/100, 0) )
   ACN(vu:13, Val(cp:3) * COTIZACIONC(FBN['Esp'],,,,FBN['FIni'], 1, SI, VAR('MONEEXTR')) )
   ACN(vu:15, IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=0], Val(vu:5) * FBN['TPC']/100, 0) )
   ACN(vu:10, Val(vu:5) + Val(vu:17) + IIF(FBN['RB6']=4 y FBN['MB3']=0, Val(vu:15), 0) )
   ACN(vu:11, Val(cp:3) + FBN['TComi'] + Val(vu:10) )
   ACN(vu:26, Val(vu:5) * FBN['TBa'] / 100 )
   ACN(vu:27, Val(vu:5) * FBN['ImpG1'] / 100 )
   
   ACN(vx:1, BuscarCampo('CLIENTES','NrDNRP','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',FBN['Vh1'])) )
   ACN(vx:2, BuscarCampo('CLIENTES','NrDNRP','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',FBN['Vh2'])) )
   ACN(vx:3, BuscarCampo('CLIENTES','ImpuestosInternos','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',FBN['Vh1'])) )
   ACN(vx:4, BuscarCampo('CLIENTES','ImpuestosInternos','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',FBN['Vh2'])) )
   ACT(vw:1, Ascendientes('VEHICULOS', FBN['Vh1']) )
   ACT(vw:2, Ascendientes('VEHICULOS', FBN['Vh2']) )
   ACT(bc:1, BuscarCampo('VEHICULOS', 'TipoVehiculo', 'Codigo', FBN['Vh1']) )
   ACT(bc:2, BuscarCampo('VEHICULOS', 'TipoVehiculo', 'Codigo', FBN['Vh2']) )
   ACT(vx:5, IIF(Incluido(Val(vw:1), Val(vw:2), 1) y EqStr(Val(bc:1), 'DIV') y EqStr(Val(bc:2), 'DIV'), 'SI', 'NO'))
   ACN(vu:9, IIF(INCLUIDO(Val(vx:5),'NO') y [FBN['MB3']=0 y [[EqStr(Val(vx:1), 'AUTORET') y Not EqStr(Val(vx:2), 'AUTORET') y Not EqStr(Val(vx:4), 'CERTIF')] o [Not EqStr(Val(vx:1), 'AUTORET') y Not EqStr(Val(vx:2), 'AUTORET') y Not EqStr(Val(vx:4), 'CERTIF')]]] o [FBN['MB3']=1 y [[Not EqStr(Val(vx:1), 'AUTORET') y EqStr(Val(vx:2), 'AUTORET') y Not EqStr(Val(vx:3), 'CERTIF')] o [Not EqStr(Val(vx:1), 'AUTORET') y Not EqStr(Val(vx:2), 'AUTORET') y Not EqStr(Val(vx:3), 'CERTIF')]]] y (Val(vu:5)-BuscarCampo('VARIABLES', 'Valor', 'Codigo', 'RETMINIMO')) > 0, (Val(vu:5)-BuscarCampo('VARIABLES', 'Valor', 'Codigo', 'RETMINIMO')) * (FBN['TImp1']/100), 0) )   
   
   ACN(vu:22, IIF(INCLUIDO(Val(vx:5),'NO') y FBN['MB3']=1 y EqStr(Val(vx:1),'AUTORET') y Not EqStr(Val(vx:3),'CERTIF') y (Val(vu:5)-BuscarCampo('VARIABLES', 'Valor', 'Codigo', 'RETMINIMO')) > 0, (Val(vu:5)-BuscarCampo('VARIABLES', 'Valor', 'Codigo', 'RETMINIMO')) * (FBN['TImp1']/100) ,0) )
   ACN(vu:14, Val(cp:3)-FBN['COri'] )

EndIf

