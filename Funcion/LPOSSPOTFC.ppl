  SQL.ADD("Select Sum(S.Saldo) as Cantidad from "~DBO~".SALDOSDIA S")
  SQL.ADD("where S.NrSaldo = 2")
  SQL.ADD("and S.Especie = '"~fbn('Codigo')~"' ")
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and S.Cliente in ("~Val(z11)~")")
  endif
  SQL.ADD("and S.Fecha = (Select Max(O.Fecha) from "~DBO~".SALDOSDIA O")
  SQL.ADD("    where O.Especie = '"~fbn('Codigo')~"'")
  SQL.ADD("    and O.NrSaldo = 2")
  SQL.ADD("    and O.Cliente = S.Cliente")
  SQL.ADD("    and O.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
  SQL.ADD("group by Cliente")
*  messagebox(fbn('Codigo'))
  recorrer SQL
    dfa
    SCN(z1, fbn('Cantidad'))
*    messagebox(FStr(fbn('Cantidad'),0,0))
*    messagebox(FStr(Val(z1),0,0))
  proximo
