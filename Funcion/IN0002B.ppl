***********************************************
* IN0002B - CANCELACION DE CHEQUE             *
*                                             *
* Invocada por el IN0002 - Interfase CAP-SIAF *
*                                             *
***********************************************

message( "CANCELACION")

** -- Busco el estado del cheque
ACT(xp:&i,SQL("SELECT /*+ RULE */ Estado FROM "~DBO~".CHEQUES WHERE Chequera='"~VAL(xo:&i)~"' AND NrCheque= "~Fstr(VAL(xd:&i),0,0) ) )

** -- Si no encontr¢ el cheque ... aviso de advertencia
If Vacio(VAL(xp:&i))
   ACT(p:val(zd:1), "AVISO: no hallo cheque para cancelar" )
   ACN(zj:1, 1)
Else        
   ** -- Lo encontr¢ y no est  pagado
   If NOT Eqstr(VAL(xp:&i), "PAG" ) Y NOT Eqstr(VAL(xp:&i), "ANU" )
      ** -- Busco y guardo el N§ de comprobante
      ACT(xq:&i,SQL("SELECT /*+ RULE */ NrComprobante FROM "~DBO~".CHEQUES WHERE Chequera='"~VAL(xo:&i)~"' AND NrCheque= "~Fstr(VAL(xd:&i),0,0) ) )
      ** -- Actualizando el estado del cheque      
      message( 'Actualizando CHEQUES ...' )
      SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES " )
      SQL.ADD(" SET Estado = 'ANU' "     )
      SQL.ADD(" WHERE Chequera='"~VAL(xo:&i)~"' AND NrCheque= "~Fstr(VAL(xd:&i),0,0) )  
      SQL.NEW
      SQL.EXEC
      ** -- Borro movimientos relacionados en MOVPENDIENTES
      message( 'Borrando MOVPENDIENTES ...' )
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".MOVPENDIENTES   WHERE NrOperacion='"~VAL(xq:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ** -- Borro movimientos relacionados en OPERACIONESBITS
      message( 'Borrando OPERACIONESBITS ...' )
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~VAL(xq:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      message( 'Borrando TRANSACCIONES2 ...' )
      ** -- Borro la transaccion en TRANSACCIONES2
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".TRANSACCIONES2  WHERE NrTrans='"~VAL(xq:&i)~"' ")           
      SQL.NEW
      SQL.EXEC
      ACT(p:val(zd:1), "Registro procesado con exito !!!"  )
      SetFont(p:val(zd:1)..p:val(zd:1), 3)
   Else
      ** -- Lo encontr¢ y est  pagado ... aviso de advertencia
      ACT(p:val(zd:1), "AVISO: el cheque ya esta pagado o anulado" )               
      ACN(zj:1, 1)
   EndIf
EndIf