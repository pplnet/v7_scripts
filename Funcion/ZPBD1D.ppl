IF Val(AN:fac)=1 
    ACT(c:3, "Vehiculo2")
    ACT(a:val(z:1),val(aw:fac))
    ACT(b:val(z:1),val(ah:fac))
    ACT(c:val(z:1),val(ai:fac))
    ACT(d:val(z:1),val(ak:fac))
    ACT(e:val(z:1),val(af:fac))
    ACT(f:val(z:1),val(au:fac))
    ACT(g:val(z:1),val(ag:fac))
    ACT(h:val(z:1),val(av:fac))
    SCN(z:1,1)
ELSE
    ACT(c:3, "Proveedor")
    ACT(a:val(z:1),val(aw:fac))
    ACT(b:val(z:1),val(ah:fac))
    ACT(c:val(z:1),val(aj:fac))
    ACT(d:val(z:1),val(ak:fac))
    ACT(e:val(z:1),val(af:fac))
    ACT(f:val(z:1),val(au:fac))
    ACT(g:val(z:1),val(ag:fac))
    ACT(h:val(z:1),val(av:fac))
    SCN(z:1,1)
ENDIF