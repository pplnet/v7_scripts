SQL.ADD(" Select A1.Cantidad1, A1.Cantidad2, A1.Cantidad3, A1.Valor1 Cantidad4, A1.DebitoCredito, A1.Alias3 NrItem, C.Alias TipoCta ")
SQL.ADD(" From "~DBO~".ASIENTOSCON1 A1, "~DBO~".CONTABILIDAD C ")
SQL.ADD(" Where C.Codigo = A1.Cuenta ")
SQL.ADD(" AND A1.NrUnicoAsiento = '"~Val(AS:1)~"' ")
SQL.ADD(" AND C.Alias IN ('I','P') ")
Recorrer SQL
    ***---Activa: Si Ajuste negativo => Suma interes en el DEBE y Resta en HABER de cuenta contraria
    ***---Pasiva: Si Ajuste negativo => Resta interes en el DEBE y Suma en HABER de cuenta contraria
    ***---AHORA
    ***---Activa: Si Ajuste negativo => Suma interes en el DEBE y Suma en HABER de cuenta contraria
    ***---Pasiva: Si Ajuste negativo => Resta interes en el DEBE y Resta en HABER de cuenta contraria
    IF Val(AT:1) = 1
        ***---Activa
        IF Eqstr(fbn('TipoCta'), 'I')
            ***---Cuenta de Interes => Una sola linea
            IF [Val(AJ:1) < 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')] O [Val(AJ:1) > 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')]
                SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                SQL.ADD(" Set Cantidad1 = Cantidad1 + "~Fstr(Abs(Val(AJ:1)), 0, 2)~", ")
                SQL.ADD(" Cantidad2 = Cantidad2 + "~Fstr(Abs(Val(AJ:2)), 0, 2)~", ")
                SQL.ADD(" Cantidad3 = Cantidad3 + "~Fstr(Abs(Val(AJ:3)), 0, 2)~", ")
                SQL.ADD(" Valor1 = Valor1 + "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                SQL.NEW
            ELSE
                SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                SQL.ADD(" Set Cantidad1 = Cantidad1 - "~Fstr(Abs(Val(AJ:1)), 0, 2)~", ")
                SQL.ADD(" Cantidad2 = Cantidad2 - "~Fstr(Abs(Val(AJ:2)), 0, 2)~", ")
                SQL.ADD(" Cantidad3 = Cantidad3 - "~Fstr(Abs(Val(AJ:3)), 0, 2)~", ")
                SQL.ADD(" Valor1 = Valor1 - "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                SQL.NEW
            ENDIF
        ELSE
            ***---Cuenta del Producto => 3 Lineas con algunas en cero. Se procesan las distintas a cero
            IF fbn('Cantidad1') > 0
                IF [Val(AJ:1) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:1) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad1 = Cantidad1 + "~Fstr(Abs(Val(AJ:1)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad1 = Cantidad1 - "~Fstr(Abs(Val(AJ:1)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad2') > 0
                IF [Val(AJ:2) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:2) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad2 = Cantidad2 + "~Fstr(Abs(Val(AJ:2)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad2 = Cantidad2 - "~Fstr(Abs(Val(AJ:2)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad3') > 0
                IF [Val(AJ:3) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:3) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad3 = Cantidad3 + "~Fstr(Abs(Val(AJ:3)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad3 = Cantidad3 - "~Fstr(Abs(Val(AJ:3)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad4') > 0
                IF [Val(AJ:4) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:4) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Valor1 = Valor1 + "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Valor1 = Valor1 - "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
        ENDIF
    ELSE
        ***---Pasiva
        IF Eqstr(fbn('TipoCta'), 'I')
            ***---Cuenta de Interes => Una sola linea
            IF [Val(AJ:1) < 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')] O [Val(AJ:1) > 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')]
                SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                SQL.ADD(" Set Cantidad1 = Cantidad1 - "~Fstr(Abs(Val(AJ:1)), 0, 2)~", ")
                SQL.ADD(" Cantidad2 = Cantidad2 - "~Fstr(Abs(Val(AJ:2)), 0, 2)~", ")
                SQL.ADD(" Cantidad3 = Cantidad3 - "~Fstr(Abs(Val(AJ:3)), 0, 2)~", ")
                SQL.ADD(" Valor1 = Valor1 - "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                SQL.NEW
            ELSE
                SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                SQL.ADD(" Set Cantidad1 = Cantidad1 + "~Fstr(Abs(Val(AJ:1)), 0, 2)~", ")
                SQL.ADD(" Cantidad2 = Cantidad2 + "~Fstr(Abs(Val(AJ:2)), 0, 2)~", ")
                SQL.ADD(" Cantidad3 = Cantidad3 + "~Fstr(Abs(Val(AJ:3)), 0, 2)~", ")
                SQL.ADD(" Valor1 = Valor1 + "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                SQL.NEW
            ENDIF
        ELSE
            ***---Cuenta del Producto => 3 Lineas con algunas en cero. Se procesan las distintas a cero
            IF fbn('Cantidad1') > 0
                IF [Val(AJ:1) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:1) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad1 = Cantidad1 - "~Fstr(Abs(Val(AJ:1)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad1 = Cantidad1 + "~Fstr(Abs(Val(AJ:1)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad2') > 0
                IF [Val(AJ:2) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:2) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad2 = Cantidad2 - "~Fstr(Abs(Val(AJ:2)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad2 = Cantidad2 + "~Fstr(Abs(Val(AJ:2)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad3') > 0
                IF [Val(AJ:3) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:3) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad3 = Cantidad3 - "~Fstr(Abs(Val(AJ:3)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ELSE
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Cantidad3 = Cantidad3 + "~Fstr(Abs(Val(AJ:3)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
            IF fbn('Cantidad4') > 0
                IF [Val(AJ:4) < 0 Y Eqstr(fbn('DebitoCredito'), 'CRE')] O [Val(AJ:4) > 0 Y Eqstr(fbn('DebitoCredito'), 'DEB')]
                    SQL.ADD(" Update "~DBO~".ASIENTOSCON1 ")
                    SQL.ADD(" Set Valor1 = Valor1 - "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
