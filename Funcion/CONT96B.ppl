                    SQL.ADD(" Set Valor1 = Valor1 + "~Fstr(Abs(Val(AJ:4)), 0, 2)~" ")
                    SQL.ADD(" Where NrUnicoAsiento = '"~Val(AS:1)~"' ")
                    SQL.ADD(" AND Alias3 = '"~fbn('NrItem')~"' ")
                    SQL.NEW
                ENDIF
            ENDIF
        ENDIF
    ENDIF
    SQL.EXEC
