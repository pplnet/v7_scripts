Message('Procesando Spot ...')

SQL.ADD("SELECT SUM(Cantidad) as Cantidad,Vehiculo1, ")
SQL.ADD("CASE TipoOp  WHEN 'SECS' THEN 'C' WHEN 'SECSV' THEN 'C' ELSE 'V' END Tip ")
SQL.ADD("from  "~DBO~".OPERACIONES O ")
SQL.ADD("Where O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and O.Cupon1  = '"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and O.TipoOp In ('SECS','SECSV','SEVS','SEVSV') ")
SQL.ADD("and O.FechaOp <='"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and O.FechaVto > '"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and Cartera IN "~VAL(x3)~"  ")
SQL.ADD("group by Vehiculo1,TipoOp")
SQL.ADD("order by Vehiculo1,TipoOp")

Recorrer SQL

      Message('Spots :'~FBN['Vehiculo1']~' '~Fstr(fac,0,0))   

      IF EqStr(VAL(S1),FBN['Vehiculo1']~FBN['Vehiculo1']~FBN['Tip'])
         DFA
      Else
         ACT(s1,FBN['Vehiculo1']~FBN['Vehiculo1']~FBN['Tip'])
      EndIf

      act(a:fac,fbn['Vehiculo1'])
      act(b:fac,'SPOTS '~Fstr(VAL(x4),0,0))
      act(c:fac,fbn['Vehiculo1'])
      scn(d:fac,iif( EqStr(FBN['Tip'],'C'), fbn['Cantidad'],- fbn['Cantidad']) )
      act(k:fac,fbn['Vehiculo1'] )

      * Tipo de Saldo PARA CARTERA
      acn(n:fac,VAL(X4))
Proximo