
***---Funcion solo para Saldo 101 de DTP y RTP que son los mov. liquidados pero no confirmados.
***---Los mov.ptes. de operaciones se toman en la funcion CUPONPASES
*** Agregado por Marcelo
***---SQL.ADD("       M.PrecioEj, M.Cliente, M.Cantidad, M.FechaMov,                           ")
SQL.ADD("SELECT Distinct M.NrSaldo, M.Cuenta, M.Mercado, M.EnteCustodia, M.CallPut, M.FechaEj, ")
SQL.ADD("       M.PrecioEj,                                                                    ")
*SQL.ADD("       Case T.Cliente2                                                                ")                                                          
*SQL.ADD("             When ''   then   (select TT.Cliente1 from "~DBO~".TRANSACCIONES2 TT      ")
*SQL.ADD("                                where TT.NrTrans = T.NrOperacionRef1)                 ") 
*SQL.ADD("             Else T.Cliente2                                                          ")  
*SQL.ADD("             End  as  Cliente,                                                        ")
SQL.ADD("       M.Cliente, M.Cantidad, M.FechaMov,                        ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes, M.NrOperacion ")
SQL.ADD("FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE  M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("       M.Especie      = '"~VAL(b2)~"'           AND ")
SQL.ADD("       M.Cupon        = '"~FSTR(VAL(c2),1,0)~"' AND ")
SQL.ADD("       M.NrOperacion  = T.NrTrans               AND ")
SQL.ADD("       T.TipoTr2 not in ("~Pipe2Comillas(VAR('CUPON'))~") AND (T.TipoTr2 = 'DTP' and T.CB6 <> 0)  AND ")
SQL.ADD("       M.Cliente = C.Codigo AND ")
SQL.ADD("       M.Especie = E.Codigo AND ")
SQL.ADD("       M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("and M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD("and M.Mercado='"~Dialogo.Mercado1~"' ")
Endif
SQL.ADD("UNION ALL")
*** Agregado por Marcelo
*SQL.ADD("       Case T.Cliente2                                                                ")                                                          
*SQL.ADD("             When ''   then   (select TT.Cliente1 from "~DBO~".TRANSACCIONES2 TT      ")
*SQL.ADD("                                where TT.NrTrans = T.NrOperacionRef1)                 ") 
*SQL.ADD("             Else T.Cliente2                                                          ")  
*SQL.ADD("             End  as  Cliente,                                                        ")    
*SQL.ADD("       M.PrecioEj,                                                                       ")
*SQL.ADD("       M.Cantidad, M.FechaMov,                                                           ")
SQL.ADD("SELECT Distinct M.NrSaldo, M.Cuenta, M.Mercado, M.EnteCustodia, M.CallPut, M.FechaEj,    ")
SQL.ADD("       M.PrecioEj, M.Cliente, M.Cantidad, M.FechaMov,                              ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes, M.NrOperacion ")
SQL.ADD("FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE  M.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("       M.Especie      = '"~VAL(b2)~"'           AND ")
SQL.ADD("       M.Cupon        = '"~FSTR(VAL(c2),1,0)~"' AND ")
SQL.ADD("       M.NrOperacion  = T.NrTrans               AND ")
SQL.ADD("       T.TipoTr2 not in ("~Pipe2Comillas(VAR('CUPON'))~") AND ")
SQL.ADD("       ( T.TipoTr2 = 'RTP' and T.CB6 <> 0 AND ")
SQL.ADD("         (C.CategDepositante NOT IN  ("~Pipe2Comillas(VAR('TIPOCLI'))~") OR ")
SQL.ADD("         (C.CategDepositante = 'OTR' and C.AFJP='NO'))             ) AND ")
SQL.ADD("       M.Cliente = C.Codigo AND ")
SQL.ADD("       M.Especie = E.Codigo AND ")
SQL.ADD("       M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("and M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD("and M.Mercado='"~Dialogo.Mercado1~"' ")
Endif
SQL.ADD("  ORDER BY M.NrSaldo, M.Cliente ")

SetFilaActual(fac+100)
ACN(z1,fac)

ACN(ha1, fac+1)
Recorrer SQL
  ACN(x1, fbn('Cantidad'))

  Message(fbn('Cliente')~' '~VAL(b2)~' '~FBN['Mercado']~' '~FBN['Cuenta']~' '~Fstr(val(x1),0,2)  )

  IF Round(Val(x1),2)<>0
     IF FBN['NrSaldo'] >= Val(sl1) y Val(ha1) = 0
        ACN(ha1, fac)
     ENDIF
     ACT(a:fac, fbn('Cliente'))
     ACT(b:fac, Val(b2))
     ACT(c:fac, FStr(VAL(c2),1,0))
     ACT(d:fac, fbn('Mercado'))
     ACT(f:fac, fbn('Cuenta'))
     ACN(g:fac, Val(x:1))
     ACN(k:fac, 1)
     ACT(l:fac, '')
     ACN(m:fac, FBN['NrSaldo'])
     ACD(n:fac, FBN['FechaMov'])

     ACT(o:fac, fbn('CallPut'))
     ACD(p:fac, fbn('FechaEj'))
     ACN(q:fac, fbn('PrecioEj'))

     ACT(bl:fac, FBN['TipoCliente'])
     ACT(bm:fac, FBN['CondicionGan'])
     ACT(bn:fac, FBN['CondicionIVA'])
     ACT(bo:fac, FBN['Res3125'])
     ACT(bp:fac, FBN['InteresesC'])
     ACT(bq:fac, FBN['Cotiza'])
     ACN(br:fac, FBN['TasaIntVigente'])
     ACD(bs:fac, FBN['FechaCambioTasa'])
     ACT(bt:fac, FBN['Valor10'])
     ACN(bu:fac, FBN['TasaIntAnterior'])
     ACT(bv:fac, FBN['Valor9'])
     ACT(bw:fac, FBN['DiasAnio'])
     ACT(bx:fac, FBN['DiasMes'])
     ACT(by:fac, FBN['NrOperacion'])

     IF Not Incluido(Val(o:fac), 'CAL|PUT')
        ACN(r:fac, 1)
     ENDIF

     ACT(lb:fac,'')
     ACN(lc:fac, 0)
     ACN(ld:fac, 0)
     ACT(le:fac, '')

     *- Si quiere cobrar el cupon y no es un saldo bloqueado por caja de valores 
     If val(jo1)=6 y Not Incluido(Fstr(val(m:fac),0,0),Val(dz6))
        *- Guardo los datos de la liquidacion 
        *- lb: Cuenta Efectivo lc:Precio ld: Monto en Efectivo

        *- Seleccion de la cuenta de efectivo
        ACT(lb:fac,'')
        SQL.ADD("SELECT Codigo,Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:fac)~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB'  AND (Mercado IS NULL OR Mercado='' OR Mercado='BCRA' OR Mercado='"~Val(d:fac)~"') ")
  
        Recorrer SQL
          dfa
          If Vacio(val(lb:fac)) y [Incluido(FBN['Especies'],Dialogo.Especie2) o Incluido(FBN['Especies'],'MONEDA') ] 
             ACT(lb:fac,FBN['Codigo'])
          EndIf
        Proximo
        If Vacio(val(lb:fac)) 
           ACT(lb:fac,Val(dz3))
        EndIf
        *-    
        ACN(lc:fac, val(aa5))
        ACN(ld:fac, Val(x:1)*Val(lc:fac))
        ACT(le:fac, Dialogo.Especie2)
     EndIf

  ELSE
     dfa
  ENDIF
Proximo

ACN(w1,fac)

IF Val(z:1)<>val(w1)
   ***** Val(ha1) indica desde donde estan los movimientos de custodia antes era Val(z1)+1 *****
 If Dialogo.Radio2=0
   CrearListBox ; 'Arial,8,';'Movimientos Fallados.'
       'OK'              ;k:Val(ha1)..k:val(w1);SI;;;40;CHECK
       'Cliente'         ;a:Val(ha1)..a:val(w1);NO;;;70;STRING
       'Especie'         ;b:Val(ha1)..b:val(w1);NO;;;60;STRING
       'Cupon'           ;c:Val(ha1)..c:val(w1);NO;;;40;STRING
       'Casa Cust.'      ;d:Val(ha1)..d:val(w1);NO;;;60;STRING
       'Cuenta'          ;f:Val(ha1)..f:val(w1);NO;;;100;STRING
       'Cantidad'        ;g:Val(ha1)..g:val(w1);NO;;;100;NUMERO;'##,###,###.##'
       'NrSaldo'         ;m:Val(ha1)..m:val(w1);NO;;;100;NUMERO;'###'
       'Precio del Cupon';lc:Val(ha1)..lc:val(w1);NO;;;90;NUMERO;'###.######'
       'Moneda'          ;le:Val(ha1)..le:val(w1);NO;;;50;STRING
       'Efectivo'        ;ld:Val(ha1)..ld:val(w1);NO;;;80;NUMERO;'###,###,###.##'
       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(l:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','CUS') AND (Especies LIKE '%"~val(m:fac)~"%' OR Especies LIKE '%"~IIf(EqStr(val(m:fac),Val(dz1)),Val(dz2),Val(dz1))~"%')  "
       'CallPut'         ;o:Val(ha1)..o:val(w1);NO;;;40;STRING
       'FechaEj'         ;p:Val(ha1)..p:val(w1);NO;;;50;FECHA
       'PrecioEj'        ;q:Val(ha1)..q:val(w1);NO;;;60;NUMERO;'###.########'
   FinListBox

   IF NOT OK 
      Cancelar
   ENDIF
 ENDIF


   ACT(k0, 'SI')
   Recorrer&i val(z1)+1,val(w1)
      IF Val(k:&i)=1
         IF EqStr(Val(k0),'SI')
            ACT(k0, 'NO')
            If Vacio(val(y1))
               *- Genera la Transaccion de Cupon 
               (."GENCUPON".)
            EndIf

            *- Genera la Transaccion de Liquidacion Cupon 
            If [Vacio(val(y2)) o val(y2)=0] y val(jo1)=6 
               *- Parametros para llamar a la funcion
               *- b4: Especie Cupon c2: Nro. Cupon h4: Fecha Proximo Corte 
               *- m1: Moneda k2: % Amortizacion l2: % Renta m2: Interes Capitalizados j2: Vehiculo  
               ACT(lb4,val(b4))
               ACN(lc2,val(c2))
               ACD(lh4,Dialogo.Fecha2)
               ACT(lm1,Dialogo.Especie2)
               ACN(lk2,val(k2))
** FJL 01/08/20 - Ingreso de TNA
               ACN(ls:2,val(s:2))
*****
               ACN(ll2,val(l2))
               ACN(lm2,val(m2))
               ACT(lj2,val(j2))

               (."GENLCUPON".)
               ACT(rx:1, Val(y2))
            EndIf
         ENDIF

         *  07/10/04 para grabar en callput y poder cortar los saldos y saber que mov eran falla
         *  07/10/04 cambiar esto para que grabe en vehiculo o campo nuevo y que vehiculo sea clave. ver con JUAN
         ACT(y:3,'Fal')

         ACN(fi1,&i)

         If val(jo1)=6 
            Message('*---Calculo de Comisiones por CORTE DE CUPON')
            *- cl1: Cliente ce1: Especie Original del Saldo *- cv1: Vehiculo cy1: Mercado ct1: Tipo de Comision
            *- da: CallPut db: FechaEj dc: PrecioEj de:Cuenta sa2: Ultimo nro. de Cuota para insertar comisiones
            *- sa:3 Acumulador de Comisiones 

            act(cl1, Val(a:&i))
            act(cv1, Dialogo.Vehiculo1)
            act(cy1, Val(d:&i))
            act(da1, '')
            act(db1, '')
            acn(dc1, 0)
            act(de1, Val(lb:&i))
            act(ce1, Val(b:&i))

            acn(ci:2,0)
            acn(ci:1,0)
            acn(sa2,0)
            acn(sa3,0)
            acn(re1,0)
            acn(re2,0)
            acn(re3,0)
            acn(ci:12,0)
            acn(ci:11,0)

            *- Calculo la comision de la Renta solamente para los Saldos <> 201
            If val(aa:9)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz4))
               acn(cj:1,Val(g:&i)*val(aa:9))

               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)

               acn(re1, val(sa:3))
            EndIf

            *- Calculo la comision de la Amortizacion solamente para los Saldos <> 201
            If val(aa:8)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz5))
               acn(cj:1,Val(g:&i)*val(aa:8))
               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)
               acn(re2, val(sa:3)-val(re1))
            EndIf

            *- ci2: Calculo del % del Iva sobre comisiones
            acn(ci:2, Num(Val(dz10))+IIF(EQSTR(Val(bn:&i),'NOI'),Num(Val(dz11)),IIF(EQSTR(Val(bo:&i),'SI'),Num(Val(dz12)),0)))

            *- ci:1 Monto de Iva
            acn(ci:1,ROUND(Abs(val(sa:3))*Val(ci:2)/100,2))


            *- COMISION CAJA DE VALORES DE RENTA
            *- re3: Monto de la comision
            If val(aa:9)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz41))
               acn(cj:1,Val(g:&i)*val(aa:9))
               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               *-'CACOMISION'.)
               acn(re3, val(sa:3)-val(re1)-val(re2))
               scn(sa3,-val(re3))
            EndIf

            *- ci12: Calculo del % del Iva sobre comisiones DE CAJA DE VALORES 
            acn(ci:12, Num(Val(dz20)) )

            *- ci:11 Monto de Iva
            acn(ci:11,ROUND(Abs(val(re:3))*Val(ci:12)/100,2))            

            * si la comision es mayor que lo que pago
            IF Val(sa3)+Val(ci1)>Val(ld:&i)
               ACN(sa3, ROUND(val(ld:&i)/(1+Val(ci2)/100),2))
               ACN(ci1, Val(ld:&i)-Val(sa3))
            ENDIF
            ***---BC1 = %Bonif.Comision
            ***---SA4 = Comision Bonificada
            ***---SA5 = IVA Comision Bonificada
            IF Val(SA:3) <> 0 
                ***---Hay Bonificacion sobre la comision
                ACN(SA:4, Val(SA:3) - (Val(SA:3) * Val(BC:1) / 100))
            ELSE
                ACN(SA:4, 0)
            ENDIF
            IF Val(CI:1) <> 0 
               ***---Hay Bonificacion sobre el IVA comision
               ACN(SA:5, Val(CI:1) - (Val(CI:1) * Val(BC:1) / 100))
            ELSE
                ACN(SA:5, 0)
            ENDIF
         EndIf

         Message('Generando Movimientos Nro. '~Val(a:&i)~' .... ')       

         *- fv1: Fecha Valida para Movimiento del Corte fv2: Fecha Valida para Movimiento del Pago 
*** 22/11/2004        ACD(fv1,val(n:&i))
         If Val(n:&i)<Dialogo.Fecha1
            ACD(fv1, Dialogo.Fecha1)
         Else
            ACD(fv1, Val(n:&i))
         Endif
         ACD(fv2,Dialogo.Fecha2)

         *- Si FechaMov<FechaPago -> El pago de cupones se hace a la fecha de Pago
         *- Sino                  -> El pago de cupones se hace a la fecha de Movimiento
         If val(n:&i)>Dialogo.Fecha2
             ACD(fv2,val(n:&i) )
         EndIf

         *- Leyenda que indica que eel corte viene de un mov. pendiente
         ACT(mp50, 'MovPend')

         ACT(mp28, Val(by:&i))
         * --- FO 15/03/2006 - Cambio para que no genere mov negativos y positivos de cupon
         * --- Solo debe actualizar el cupon del mov y generar mov por cupon y moneda si corresponde
         SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 SET Cupon2 = "~fstr(Val(c:3),0,0)~" WHERE NrTrans = '"~Val(by:&i)~"' ")
         SQL.NEW 
         * Esta es la marca para despues poder anular
         SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET Book = '"~Val(y:1)~"', Cupon = "~fstr(Val(c:3),0,0)~" WHERE NrOperacion = '"~Val(by:&i)~"' ")
         SQL.NEW 
         SQL.EXEC
         IF Val(C:3) = 0
             ***---No Hay cupones siguientes por lo que borro los mov.ptes ya que no queda nada
             ***---por liquidar a futuro y se cobran con el pago del cupon actual.
             SQL.ADD(" Delete "~DBO~".MOVPENDIENTES ")
             SQL.ADD(" Where NrOperacion = '"~Val(BY:&i)~"' ")
             SQL.ADD(" AND EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
             SQL.ADD(" AND Especie = '"~Val(B:&i)~"' ")
             SQL.ADD(" AND Cupon = "~Fstr(Val(C:3), 0, 0)~" ")
             SQL.ADD(" AND FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
             SQL.ADD(" AND Round(NrSaldo, 2) = "~Fstr(Val(M:&i), 0, 2)~" ")
             SQL.NEW
             SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
             SQL.ADD(" Set NrOperacionRef3 = '"~Val(Y:1)~"' ")
             SQL.ADD(" Where NrTrans = '"~Val(BY:&i)~"' ")
             SQL.NEW
             SQL.EXEC
         ENDIF
         (.'CUPINSMOVF'.)
      ENDIF
   Proximo
ELSE
   If Dialogo.Check8=0
      MessageBox('Noy hay MOVIMIENTOS FALLADOS para cortar.')
   Endif
ENDIF
ACT(mp50, ' ')