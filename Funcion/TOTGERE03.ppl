Message('*** posicion final ***')
ACT(c:fac,'Valor Mercado Posicion')
AgregarMarco(c:FAC..d:FAC,2,0)

acd(a:fac,Dialogo.Fecha2)
acd(b:fac,Dialogo.Fecha2)
acn(h:fac,val(h:fac-1))

if EqStr(val(v5),'DIR')
   acn(f:fac,Cotizacion(val(v4),,,,Dialogo.Fecha2,1))
else
   acn(e:fac,Cotizacion(val(v4),,,,Dialogo.Fecha2,1))

   *** calcula precio sucio ***
   act(ca:fac,val(v4))
   acd(ck:fac,Dialogo.Fecha2)
   (.'SUCIO'.)
   acn(f:fac,val(ci:fac)*(val(e:fac)+val(cj:fac))) 
endif

acn(i:fac,val(h:fac)*val(f:fac))
acn(m:fac,sum(m:val(bb3)..m:fac-1))
acn(n:fac,val(b:fac)-Dialogo.Fecha1)

If Val(x1)>1
   *- Recupero operaciones del periodo
   acn(w5,0)
   If val(h:fac)=0
      *- Descuento a los dias el periodo que no hubo capital
      *- Obtengo el menor de los valores de la columna l:
      acn(w5,val(l:val(bb3)))
      Recorrer&j val(bb3),fac-1
         If val(w5)>val(l:&j))
            acn(w5,val(l:&j))
         EndIf         
      Proximo
   EndIf
Else 
   If val(h:fac)<>0
      acn(w5,0)
   EndIf
EndIf

* MessageBox(val(w5))


* Valores para Parametro de TIR para Anual
ACN(val(bb4):val(bb3)  ,VAL(b:fac)-val(zz5))
ACN(val(bb4):val(bb3)+1,VAL(i:fac))

* 1er. Valor de Columna para Tir de Acumulado A#o
If val(val(bb4):val(bb3)+1)<>0 y val(w4)=0
   acn(w4,val(bb4))    
EndIf

* Max. de Dias para valuar la Tir del Acumulado
If val(w3)=0 
   acn(w3,val(l:fac))
EndIf

acn(z:fac,(Dialogo.Fecha2-val(zz5))/365)

SetFont(a:fac..m:FAC,1)
FormatoCeldas(g:fac..j:fac,Exe('F2'))
FormatoCeldas(e:fac..f:fac,Exe('F6'))
FormatoCeldas(m:fac..m:fac,Exe('F2'))

*** calcula el resultado ***
SetFilaActual(fac+2)

*-- Resultado= Sum(Flujo_Fondos) Sum(Acum.Año)
act(a:fac,'Resultado')
acn(i:fac,sum(i:val(bb3)..i:fac-1))
acn(j:fac,val(j:fac-3)+val(i:fac-2) )

FormatoCeldas(i:fac..j:fac,Exe('F2'))

* Llamado GERE03
ACN(o1,val(i:fac))
ACN(p1,val(j:fac))

act(a:fac+3,'TIR Diaria')
If val(w1)=0 o val(i:fac)=0
   acn(i:fac+3,0)
Else
   ACN(i:fac+3, ((1+TIR2(n:val(w1)..n:fac-2,i:val(w1)..i:fac-2))^(1/365)-1)*100  ) 
EndIf

If [val(bb3)=0 o val(j:fac)=0]
   acn(j:fac+3,0)
Else
   ACN(ck1, TIR2(val(w4):val(bb3)..val(bb4):val(bb3),val(w4):val(bb3)+1..val(bb4):val(bb3)+1) ) 
   ACN(j:fac+3, ((1+TIR2(val(w4):val(bb3)..val(bb4):val(bb3),val(w4):val(bb3)+1..val(bb4):val(bb3)+1))^(1/365)-1)*100  ) 
EndIf

FormatoCeldas(i:fac+3..j:fac+3,Exe('F7'))

act(a:fac+4,'Dias')
acn(i:fac+4,val(w2))

If val(i:fac+4)<>0
   scn(i:fac+4,-val(w5))
EndIf

acn(j:fac+4,val(w3))
* MessageBox('Dias Original  '~Fstr(val(w3),0,2))
If val(j:fac+4)<>0
   scn(j:fac+4,-val(w5))
EndIf

* MessageBox('Descuento Dias Original  '~Fstr(val(w5),0,2))
* acn(j:fac+4,Dialogo.Fecha2-VAL(ZZ5))

act(a:fac+5,'Rendimiento de la Tenencia')
If val(i:fac)<>0
   acn(i:fac+5,(((1+(Val(i:fac+3)/100))^val(i:fac+4))-1)/val(i:fac+4)*365*100)
Else
   acn(i:fac+5,0)
EndIf
If val(j:fac)<>0
   acn(j:fac+5,(((1+(Val(j:fac+3)/100))^val(j:fac+4))-1)/val(j:fac+4)*365*100)
Else
   acn(j:fac+5,0)
EndIf

*-- Llamado GERE03
acn(o2,val(i:fac+5))
acn(p2,val(j:fac+5))

act(a:fac+6,'Capital Promedio Tenecia')
If val(i:fac)<>0
   acn(i:fac+6,(val(i:fac)*365)/((val(i:fac+5)/100)*(Dialogo.Fecha2-Dialogo.Fecha1)))
Else
   acn(i:fac+6,-Val(m:fac-2)/(Dialogo.Fecha2-Dialogo.Fecha1))
EndIf
If val(j:fac)<>0
   acn(j:fac+6,(val(j:fac)*365)/((val(j:fac+5)/100)*(Dialogo.Fecha2-VAL(ZZ5))))
Else
   acn(j:fac+6,-Val(m:fac-2)/(Dialogo.Fecha2-VAL(ZZ5)))
EndIf
FormatoCeldas(i:fac+6..j:fac+6,Exe('F2'))

*-- Llamado GERE03
acn(o3,val(i:fac+6))
acn(p3,val(j:fac+6))

act(a:fac+8,'Analisis Resultado')
act(a:fac+9,'Trading')
act(a:fac+10,'Revaluo')
act(a:fac+11,'Rev.Div.Acciones')
act(a:fac+12,'Revaluo TOTAL')
act(a:fac+13,'Realizado')
SetFont(a:fac..a:FAC+13,2)

AgregarMarco(a:FAC..h:FAC+13,2,0)
AgregarMarco(i:FAC..i:FAC+13,2,0)
AgregarMarco(j:FAC..j:FAC+13,2,0)

* Resultado
acn(i:fac+8, val(i:fac))

*-- Trading Min(VolCompra..VolVenta)*(PPV-PPC)
acn(pp1,val(fa1)/val(va1))
acn(pp2,val(fa2)/val(va2))

* MessageBox(val(va1))
* MessageBox(val(va2))
* MessageBox(val(pp1))
* MessageBox(val(pp2))

acn(i:fac+9, Min(val(va1),val(va2))*(val(pp2)-val(pp1)) )

* Calculo de Costo Historico a Fin de Periodo para Realizado
If val(h:val(bb3))>0 y val(h:fac-2)>0 y val(h:val(bb3))<val(h:fac-2) 
   ACN(ch1,(  val(i:val(bb3))+(val(va1)-val(va2))*val(pp1) )/val(h:fac-2))
Else 
   If val(h:val(bb3))<0 y val(h:fac-2)<0 y val(h:val(bb3))>val(h:fac-2)
      ACN(ch1,( -val(i:val(bb3))+(val(va1)-val(va2))*val(pp2) ) /val(h:fac-2))
   Else 
      If val(h:val(bb3))<0 y val(h:fac-2)<0 y val(h:val(bb3))<val(h:fac-2)
         ACN(ch1,val(f:val(bb3)))
      Else 
         If val(h:val(bb3))>0 y val(h:fac-2)>0 y val(h:val(bb3))>val(h:fac-2)
            ACN(ch1,val(f:val(bb3)))
         Else
            If (val(va1)-val(va2))=0 
               ACN(ch1,val(f:val(bb3)))
            Else 
               If (val(va1)-val(va2))>0
                  ACN(ch1,val(pp1))
               Else 
                  ACN(ch1,val(pp2))
               EndIf
            EndIf
         EndIf
      EndIf
   EndIf
EndIf

*--Calculo del Revaluo Ojo: La Posicion final para Revaluo no cuenta el dividendo en acciones
*- Si Pos_Inicio+Mov.Neto+Vol.Dividendo en Acciones < Posicion_Inicial+Vol.Dividendo en Acciones (El Mov.Neto<0)
*-    Si DivAcciones=0   
*-       Revaluo= Pos_Final*(PREC_FIN-PREC_INIC)
*-    Sino
*-       (POS_FIN-MOV_NETO)*(PREC_FIN-PREC_INIC)
*-    Fsi
*- Sino  
*-    (POS_FIN-MOV_NETO)*(PREC_FIN-PREC_INIC)+MOV_NETO*(PREC_FIN-PPC)
*--Fsi
ACN(pf1, val(h:fac-2)-val(da1) )

IF val(va1)-val(va2)<0
   If VAL(da1)=0
      acn(i:fac+10,val(pf1)*(val(f:fac-2)-val(f:val(bb3))) )
   Else
      acn(i:fac+10, (val(pf1)-(val(va1)-val(va2)))*(val(f:fac-2)-val(f:val(bb3))) )
   EndIf
Else 
   acn(i:fac+10, (val(pf1)-(val(va1)-val(va2)))  *  (val(f:fac-2)-val(f:val(bb3))) )
   acn(i:fac+10, val(i:fac+10)+(  (val(va1)-val(va2))* (val(f:fac-2)-val(pp1))) )
EndIf

Message('*--Calculo del Revaluo por Dividendo en Acciones')
* =SI(MOV_NETO<0,(1-(-MOV_NETO/DivAcciones))*(DivAcciones*PREC_FIN),DivAcciones*PREC_FIN)
IF (val(va1)-val(va2))<0
   acn(i:fac+11,(1-(-(val(va1)-val(va2))/VAL(da1)))*(VAL(da1)*val(f:fac-2)))
Else
   acn(i:fac+11,VAL(da1)*val(f:fac-2) )
EndIf

Message('*-- Revaluo Total')
acn(i:fac+12,val(i:fac+10)+val(i:fac+11))

*-- Calculo del Realizado:  Sumatoria de Flujos - Trading - Revaluo
acn(i:fac+13,val(i:fac+8)-val(i:fac+12)- val(i:fac+9))

SetFont(i:fac..j:FAC+13,2)
FormatoCeldas(i:fac+8..j:fac+13,Exe('F2'))
SetFilaActual(fac+13)

