** MODIINSIX
** Modifica las Instancias para las Operaciones 
** i3= NrOperacion, Si Vacio utiliza Dialogo.NrOperacion1 
** Dialogo.NrOperacion1: Debe estar el Nro. de La Operacion 
If VACIO(VAL(i3))
   ACT(i3,Dialogo.NrOperacion1)
EndIf

ACN(i1,11)

If EqStr(BuscarCampo('Operaciones','RB3','NrOperacion',VAL(i3)),'0')             
   ACN(i1,13)
EndIf

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS Set Valor='0' Where NrOperacion='"~VAL(i3)~"' and Valor='1' ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS Set Valor='1' Where NrOperacion='"~VAL(i3)~"' and NrBit="~Fstr(Val(i1),2,0)~" ")
SQL.NEW        


BorrarCeldas(i3..i3)
