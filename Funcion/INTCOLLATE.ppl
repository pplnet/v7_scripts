*- Funcion que recupara los intereses acumulados para el collateral hasta Dialogo.Fecha1
*- Parametros  eb0: Fecha  eb1: Especie  eb2: Vehiculo  eb3: Cliente
*- Resultado   eb11: Intereses DE TEMINM
SQL.ADD("SELECT SUM(TotalIntereses) As Interes,MB3 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  (TipoOp='TEMIND' or TipoOp='TEMINM') and ")
SQL.ADD("       FechaOp<'"~IdxDate(Val(eb0))~"' and ")
SQL.ADD("       Especie ='"~Val(eb1)~"' and ")
SQL.ADD("       Vehiculo1 In ("~Pipe2Comillas(Val(eb2))~") and ")
SQL.ADD("       Cliente1 = '"~Val(eb3)~"' and ")
SQL.ADD("       (((NrOperacion2 IS NULL or NrOperacion2='') ")
SQL.ADD("       AND NOT EXISTS ")
SQL.ADD("                      (SELECT TipoOp ")
SQL.ADD("                       FROM   "~DBO~".OPERACIONES O")
SQL.ADD("                       WHERE  TipoOp='TEMINM' and FechaOp='"~IdxDate(Val(eb0))~"' and ")
SQL.ADD("                              Especie ='"~Val(eb1)~"' and ")
SQL.ADD("                              Vehiculo1 In ("~Pipe2Comillas(Val(eb2))~") and ")
SQL.ADD("                              Cliente1 ='"~Val(eb3)~"' )) ")
*- Se puede haber generado la minuta mensual y consultar fecha valor
SQL.ADD("       or ")
SQL.ADD("       (NrOperacion2 IS NOT NULL ")
SQL.ADD("       AND NrOperacion2 In ")
SQL.ADD("                      (SELECT O.NrOperacion ")
SQL.ADD("                       FROM   "~DBO~".OPERACIONES O")
SQL.ADD("                       WHERE  TipoOp='TEMINM' and FechaOp>='"~IdxDate(Val(eb0))~"' and ")
SQL.ADD("                              Especie ='"~Val(eb1)~"' and ")
SQL.ADD("                              Vehiculo1 In ("~Pipe2Comillas(Val(eb2))~") and ")
SQL.ADD("                              Cliente1 ='"~Val(eb3)~"' ))) ")
SQL.ADD("GROUP BY MB3")

ACN(eb11, 0)   

Recorrer SQL
   *-- Acumulo el Interes
   SCN(eb11, FBN['Interes']*IIF(FBN['MB3']=0,1,-1))   
Proximo 

message('Interes Devengado Anterior '~fstr(val(eb11),0,2))
ACN(eb10,val(eb10)+val(eb11))
