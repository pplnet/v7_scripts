***Consulta utilizada para recorrer operaciones
SQL.ADD("SELECT O.TipoOp,O.Precio1,O.Precio4,O.FechaVto,O.FechaOp,O.NrOperacion,O.Cantidad,O.Cliente1, O.Especie,")
SQL.ADD("O.Cuenta1,C.RazonSocial,C.TipoInscripcion,C.CUIT,C.Codigo,C.OficialCuenta,O.PorBonificacion,C.NrCuenta,O.Cuenta3,")
SQL.ADD("c.NrDocum,c.TipoDocum,c.CategDepositante FROM "~DBO~".OPERACIONES O ")
*SQL.ADD("Left outer join "~DBO~".SALDOSREM s on o.NrOperacion = s.NrOperacion")
SQL.ADD("JOIN "~DBO~".CLIENTES c on O.Cliente1 = C.Codigo")
*Borrar COMENTARIO PARA LAS INSTANCIAS TUCU
SQL.ADD("JOIN "~DBO~".OPERACIONESBITS AS OB ON OB.NrOperacion = O.NrOperacion")
*GruposEconomicos
SQL.ADD("LEFT JOIN "~DBO~".GRUPOSECONOMICOS G ON C.Codigo = G.Cliente")
SQL.ADD("WHERE OB.NrBit IN (10, 70, 93)AND OB.Valor = '1'")
*SQL.ADD("AND O.fechaOP BETWEEN '"~IDxDate(Dialogo.Fecha1) ~"' AND '"~IdXDate(Dialogo.Fecha2)~"' ")
*SQL.ADD("AND O.FechaOP <='"~IDxDate(Dialogo.Fecha2) ~"' AND (O.FechaVto >= '"~IdXDate(Dialogo.Fecha1)~"' OR FechaVto IS NULL)")
SQL.ADD("AND O.FechaOP <='"~IDxDate(Dialogo.Fecha2) ~"'")
SQL.ADD("AND O.FechaOP <> O.FechaVto AND O.FechaVto > '"~IdXDate(Dialogo.Fecha1)~"'")
IF Novacio Dialogo.Lista1 
    SQL.ADD(" and TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ")   
Else
    If Dialogo.Radio2 = 0
        SQL.ADD("and TipoOp In ("~Pipe2Comillas(Var('PYLOPPRECI'))~")")
    Else
        SQL.ADD("and TipoOp In ("~Pipe2Comillas(Var('PYLOPTASA'))~")")
    EndIf
EndIf
IF Novacio Dialogo.Cliente1
    SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
IF Novacio Dialogo.OficialCuenta
    SQL.ADD(" and C.OficialCuenta = '"~Dialogo.OficialCuenta~"' ")
EndIf
*Especie emision
IF Dialogo.Radio3 = 0
    SQL.ADD(" and O.Especie= 'ARP' ")
    Else If Dialogo.Radio3 = 1
        SQL.ADD(" and O.Especie= 'USD' ")
        Else
        SQL.ADD(" and O.Especie IN ('ARP','USD')")
    Endif
Endif
*Controlante
IF Novacio Dialogo.GrupoEconomico
    SQL.ADD(" and G.Controlante = '"~Dialogo.GrupoEconomico~"' ")
EndIf

*Cuenta
IF Novacio Dialogo.Cuenta1
    SQL.ADD(" and (O.Cuenta1= '"~Dialogo.Cuenta1~"' OR O.Cuenta3= '"~Dialogo.Cuenta1~"')")
    else
EndIf

*Cuenta 3
IF Novacio Dialogo.Cuenta3
    SQL.ADD(" and O.Cuenta3= '"~Dialogo.Cuenta3~"' ")
EndIf




