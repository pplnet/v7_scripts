acn(q:fac,IIF(FBN['RB6']=0,(((val(j:fac)+FBN['TotalComisiones'])*(VAL(AV:FAC)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(FBN['ImpGastos2']/100),0))
acn(p:fac,IIF(FBN['RB6']=2 y FBN['MB3']=0,((((val(j:fac)+FBN['TotalComisiones'])*(val(aw:fac)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(FBN['TotalAux1']/100)),0))
acn(o:fac,(val(j:fac)+FBN['TotalComisiones'])*((FBN['Spread']+val(l:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))
acn(ac:fac,IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=0],val(o:fac)*FBN['TasaPrecan']/100,0))
acn(ab:fac,val(o:fac)+IIF(FBN['RB6']=2 Y FBN['MB3']=0,val(p:fac),0)+IIF(FBN['RB6']=4 Y FBN['MB3']=0,val(ac:fac),0))
acn(z:fac,((val(j:fac)+FBN['TotalComisiones'])+val(o:fac)))
acn(aa:fac,((val(j:fac)+FBN['TotalComisiones'])+val(ab:fac)))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')

