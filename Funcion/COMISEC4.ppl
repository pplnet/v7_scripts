Mercado          : 'Mercado Liq.'            ;1;1;2; ; ;NoVacio(MERCADO) O SI;'Debe indicar mercado';NO;'CV';
ContraEspecie3   : 'Moneda Comision'         ;1;2;2;Not Incluido(MERCADO,'OTC');NO;Incluido(MERCADO,'OTC') O NoVacio(CONTRAESPECIE3);'Moneda de Comision de Mercado INVALIDA';NO;'USD';
PorComMer1       : '% Comision'              ;2;1;2;Not Incluido(MERCADO,'OTC') Y NoVacio(MERCADO);Not Incluido(MERCADO,'OTC') Y RB13=0;Incluido(MERCADO,'OTC') O PORCOMMER1>0 O RB13=1 O VACIO(MERCADO) O SI;'Debe INGRESAR  un % de COMISION DEL MERCADO';NO;;IF(RB13=1 O VACIO(MERCADO),0)
TCComMer1        : 'T.Cambio'                ;2;2;2;Not Incluido(MERCADO,'OTC');NO;TCCOMMER1>=0;'Tipo de Cambio del Mercado INVALIDO';NO;;
ImpComMer1       : 'Imp.Comision'            ;3;1;2;RB13=1 Y NoVacio(MERCADO);Not Incluido(MERCADO,'OTC');;;;;IF(VACIO(MERCADO),0,IF(RB13=0,IF(Eqstr(TIPOOP, 'DFXO'),TOTALAUX1,IF(Eqstr(TIPOOP, 'DSEO'),TOTALNETOCLI1,(TOTALNETOCLI1+TOTALINTERESES)))*(PORCOMMER1/100)));
ImpComMerEq1     : 'Importe Eq.'             ;3;2;2;NO;NO;;;;;IMPCOMMER1*IF(CB6=1,TCCOMMER1,IF(TCCOMMER1<>0,1/TCCOMMER1,0));

RB13             : ' Tipo|%|Fijo'            ;2;2;2;;;;;;;0; 

Corredor         : 'Corredor'                ;5;1;2;;;
ContraEspecie2   : 'Moneda Comision'         ;5;2;2;;NO;VACIO(CORREDOR) O [NoVacio(CONTRAESPECIE2) y DESCIENDEDEESPECIE(CONTRAESPECIE2,'MONEDA') y ESTERMINAL(CONTRAESPECIE2,ESPECIE)];'Especie de Pago Comision Corredor INVALIDA';NO;'USD'
PorComCor1:IF(RB12=1,'V x Unidad','% Comision');6;1;2;;RB12<>2;;;;;IF(RB12=2 O VACIO(CORREDOR),0,IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR)));
TCComCor1        : 'T.Cambio'                ;6;2;2;;NO;VACIO(CORREDOR) O TCCOMCOR1>=0;'Tipo de Cambio del Corredor INVALIDO';NO;;
ImpComCor1       : 'Imp.Comision'            ;7;1;2;RB12=2;;;;;;IF(RB12=0, IF(Eqstr(TIPOOP, 'DFXO'),TOTALAUX1,IF(Eqstr(TIPOOP, 'DSEO'),TOTALNETOCLI1,(TOTALNETOCLI1+TOTALINTERESES)))*(PORCOMCOR1/100),IF(RB12=1, CANTIDAD*PORCOMCOR1));
ImpComCorEq1     : 'Importe Eq.'             ;7;2;2;NO;NO;;;;;IMPCOMCOR1*IF(CB6=1,TCCOMCOR1,IF(TCCOMCOR1<>0,1/TCCOMCOR1,0))

RB12             : ' Tipo|%|Unidad|Fijo'     ;5;2;2;;;;;;;0
ImpGastos2       : '% Tasa IVA'              ;6;2;2;;;Incluido(Fstr(IMPGASTOS2,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Corredor es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');;;;;;'#####.#####'
TotalIVA         : 'Imp. IVA'                ;7;2;2;NO;;[TOTALIVA<= ROUND((IMPCOMCOR1*IMPGASTOS2/100)*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND((IMPCOMCOR1*IMPGASTOS2/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~Fstr(ROUND((IMPCOMCOR1*IMPGASTOS2/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((IMPCOMCOR1*IMPGASTOS2/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(IMPCOMCOR1*IMPGASTOS2)/100;;;;;'###,###,###,###,###.##'

