BITS
19;0;FW=1 o [FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))]
20;1;FW=1
1 ;1;FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"'") <> 1 
5 ;1;FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Not Incluido(Sector2,VAR('PERSUPFIN')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"'") <> 1 
10;1;FW=2 y Query("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~NrOperacion~"' and NrSaldo=1") <> 1 y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) y Query("Select 1 from "~DBO~".EXCEPCIONES where NrOperacion='"~NrOperacion~"'") = 1 