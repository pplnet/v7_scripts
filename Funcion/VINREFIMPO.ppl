*-- Calculo de Retencion Ganancias.
* Clientes.NrDRP            = AUTORET => Autoretencion
* Clientes.ImpuestosInternos= CERTIF  => Certificados de NoRetencion
* Si el Vehiculo que Coloca se Autorretiene 

* y40: Importe sobre el que se calcula la retencion

* y41: Importe de la Autoretencion
* y45: Importe de la Autoretencion

* y42: Importe de Retencion Directa
* y44: Importe de Retencion Inversa

* y43: Porcentaje de Retencion

* Calculo de Excedente Minimo para Retener
ACN(y40,0)
ACN(y41,0)
ACN(y42,0)
ACN(y43,0)
ACN(y44,0)
ACN(y45,0)

ACT(y50,' ')
ACT(y51,' ')
ACT(y52,' ')
ACT(y53,' ')
ACT(y54,' ')

If VAL(Z11)-VAR('RETMINIMO')>0
   ACN(y40,VAL(Z11)-VAR('RETMINIMO'))
EndIf

* No es Vehiculo, sino cliente
ACT(y60,' ')
ACT(y61,' ')

ACT(y60,BuscarCampo('VEHICULOS','Codigo','Codigo',VAL(av1)))
ACT(y61,BuscarCampo('VEHICULOS','Codigo','Codigo',VAL(av2)))


* Si son divisiones de los mismos Ascendentes no llevan retenciones
* MessageBox(val(y40))
* MessageBox(Ascendientes('VEHICULOS',VAL(av1)))
* MessageBox(Ascendientes('VEHICULOS',VAL(av2)))

If VAL(y40)>0  y Not [Incluido(Ascendientes('VEHICULOS',VAL(av1)),Ascendientes('VEHICULOS',VAL(av2)),1) y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VAL(av1)),'DIV') y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',VAL(av2)),'DIV')] o EqStr(VAL(y61),' ') o EqSTr(VAL(y2),' ')
   * MessageBox('entro a calcular ')
   * y50: Condicion Autoretencion V1
   * y51: Condicion Autoretencion V2

   ACT(y50,BuscarCampo('CLIENTES','NrDNRP','Codigo',VAL(av1) ))
   ACT(y51,BuscarCampo('CLIENTES','NrDNRP','Codigo',VAL(av2) ))

   * y52: Condicion Certificados de Retencion V1
   * y53: Condicion Certificados de Retencion V2

   ACT(y52,BuscarCampo('CLIENTES','ImpuestosInternos','Codigo',VAL(av1) ))
   ACT(y53,BuscarCampo('CLIENTES','ImpuestosInternos','Codigo',VAL(av2) ))

   * Colocacion
   If EqStr(VAL(Z7),'0')
      * Agente con Agente  o Agente con No Agente
      IF EqStr(VAL(y50),'AUTORET') y Not EqStr(VAL(y52),'CERTIF')
         ACN(y41,VAL(y40)*VAR('RETINSC')/100)
      EndIf

      * No Agente Coloca a Agente
      IF Not EqStr(VAL(y50),'AUTORET') y EqStr(VAL(y51),'AUTORET') y Not EqStr(VAL(y52),'CERTIF')
         If EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(AV2)) )
            ACN(y42,VAL(y40)*VAR('RETINSC')/100)             
         EndIf
      EndIf

      * No Agente Coloca a No Agente      
      IF Not EqStr(VAL(y50),'AUTORET') y Not EqStr(VAL(y51),'AUTORET') y Not EqStr(VAL(y52),'CERTIF')
         If EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(AV2)) )
            ACN(y42,VAL(y40)*VAR('RETINSC')/100)             
         EndIf
      EndIf
      * MessageBox(' Coloca '~val(y50)~' '~val(y51)~' '~val(y52) )
   Else 
      * MessageBox(' Toma '~val(y50)~' '~val(y51)~' '~val(y53) )

      * Agente Toma a No Agente=> Retencion
      IF EqStr(VAL(y50),'AUTORET') y Not EqStr(VAL(y51),'AUTORET') y Not EqStr(VAL(y53),'CERTIF')
         * Si un Agente le toma a un Beneficiario del Exterior => No Retiene
         If EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(AV2)) )
            ACN(y42,VAL(y40)*VAR('RETINSC')/100)             
         EndIf
      EndIF

      IF Not EqStr(VAL(y50),'AUTORET') y Not EqStr(VAL(y51),'AUTORET') y Not EqStr(VAL(y53),'CERTIF')
         If EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(AV2)) )
            ACN(y42,VAL(y40)*VAR('RETINSC')/100)             
         EndIf
      EndIf
   EndIf

   If VAL(y42)<>0  o VAL(y41)<>0  
      ACN(y43,VAR('RETINSC'))
   EndIf

   ACN(Y20,VAL(y20)-VAL(y42)) 
EndIf

 * MessageBox('Autoret '~Fstr(val(y41),0,2))
 * MessageBox('Retencion '~Fstr(val(y42),0,2))
 * MessageBox('Monto Total '~Fstr(val(y20),0,2))
     
   

