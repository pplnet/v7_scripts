AbrirASCII(Dialogo.String1~Dialogo.String2, 0)
***---Tipo de Registro
ACT(RG:1, '1')
***---Comitente Emisor
ACT(RG:1, Val(RG:1)~Val(CE:1))
***---Especie
***---La especie es de 4 pero viene con un 0 (cero) adelante que se le quita
ACT(RG:1, Val(RG:1)~Pad0(Copy(fbn('Especie'), 1, 5), 5))
***---Depositante Receptor
ACT(RG:1, Val(RG:1)~Pad0(Copy(fbn('DepReceptor'), 1, 4), 4))
***---Comitente Receptor
ACT(RG:1, Val(RG:1)~Val(CR:1))

If Incluido(VAR('CVENOMINAL'), Ascendientes('ESPECIES',FBN['Especie'])))
   ACT(RG:1, Val(rg:1)~Pad(Pad0(Fstr(FBN['Cantidad1'],0,0 ),11),18,'0'))
Else
   ***---Cantidad a Transferir - Entero
   ACT(CT:1, Fstr(fbn('Cantidad2'), 0, 7))
   BorrarCeldas(CT:2..CT:2)
   Recorrer&k 1, Longitud(Val(CT:1))
      IF Not Eqstr(Copy(Val(CT:1), &k, 1), '.')
         ACT(CT:2, Val(CT:2)~Copy(Val(CT:1), &k, 1))
      ELSE
         ***---Cantidad - Parte Entera
         ACT(RG:1, Val(RG:1)~Pad0(Val(CT:2), 11))
         BorrarCeldas(CT:2..CT:2)
      ENDIF
   Proximo
   ***---Cantidad - Parte Decimal
   ACT(RG:1, Val(RG:1)~Pad(Val(CT:2), 7, '0'))
Endif

EscribirASCII(Val(RG:1))
CerrarASCII

*- Informacion de Detalle
ACT(a:fac,Val(CE:1))
ACT(b:fac,fbn('Especie'))
ACT(c:fac,fbn('DepReceptor'))
ACT(d:fac,Val(CR:1))
If Incluido(VAR('CVENOMINAL'), Ascendientes('ESPECIES',FBN['Especie'])))
   ACN(e:fac, FBN['Cantidad1'])
Else
   ACN(e:fac,fbn('Cantidad2'))
Endif
SetFont(a:fac..e:fac,1)
