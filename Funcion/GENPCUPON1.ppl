*** Genera la transaccion pago de cupon *** 

acn(aa4,BuscarCampo('Especies','Cupon','Codigo',Dialogo.Especie1))

if Val(d:FilaCiclo) <> 0

   act(aa1,'PCUPON')

   IF Incluido(VAL(n:FilaCiclo),'SERA|SERAV|')
      act(aa1,'CCUPON')
   ENDIF

   ACT(aa2,GetNumerador(BuscarCampo('VEHICULOS','Alias2','Codigo',VAL(k:FilaCiclo)))) 

   If Vacio(VAL(AA2))
      Cancelar(' No se encontro numerador para Vehiculo '~VAL(k:FilaCiclo))
   EndIf

   ** Ingreso Transaccion2 **
   SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("(TipoTr2, NrTrans, Especie, Especie2, ")
   SQL.ADD(" Cambio1, Cliente1, ")
   SQL.ADD(" Cantidad1, Cantidad2, ")
   SQL.ADD(" Cantidad3, Cantidad4, ")
   SQL.ADD(" Cantidad5, Cantidad6, ")
   SQL.ADD(" Cantidad7, ")
   SQL.ADD(" Fecha1, Fecha2, FechaCargaSys, ")
   SQL.ADD(" Vehiculo1, Cuenta1, ")
   SQL.ADD(" CB1, CB8, Precio1, Precio2, Precio3, Precio4, Precio5, ")
   SQL.ADD(" Cambio2,Cambio5 ) ")
   SQL.ADD("Values")
   SQL.ADD("('"~Val(aa1)~"', '"~Val(aa2)~"', '"~Dialogo.Especie1~"', '"~Dialogo.Especie2~"', ")
   SQL.ADD(" "~FStr(Val(aa4),0,0)~", '"~val(a:FilaCiclo)~"', ")
   SQL.ADD(" "~FStr(Val(d:FilaCiclo),0,4)~", "~FStr(Val(ae:FilaCiclo),0,4)~", ")
   SQL.ADD(" "~FStr(Val(ag:FilaCiclo),0,4)~", "~FStr(Val(ah:FilaCiclo),0,4)~", ")
   SQL.ADD(" "~FStr(Val(ak:FilaCiclo),0,4)~", "~FStr(Val(aj:FilaCiclo),0,4)~", ")
   SQL.ADD(" "~FStr(Val(ai:FilaCiclo),0,4)~", ")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(FSYS)~"',  '"~IdxDate(FSYS)~"', ")
   SQL.ADD(" '"~VAL(k:FilaCiclo)~"', '"~Dialogo.Cuenta1~"', ")
   SQL.ADD(" '1', '1', ")
   SQL.ADD(" "~FStr(Dialogo.Precio1,0,7)~", "~FStr(Dialogo.Precio2,0,7)~", ")
   SQL.ADD(" "~FStr(Dialogo.Precio3,0,7)~", ")
   SQL.ADD(" "~FStr(Dialogo.Precio4,0,7)~", ")
   SQL.ADD(" "~FStr(Dialogo.Precio5,0,7)~", ")
   SQL.ADD(" "~FStr(Dialogo.Precio6,0,7)~","~FStr(Dialogo.Precio7,0,5)~") ")
   SQL.NEW


   * Actualizo la transaccion original de Pago
   SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
   SQL.ADD(" Set NrTransRef1='"~Val(aa2)~"' Where NrTrans='"~Val(m:FilaCiclo)~"' ")
   SQL.NEW
   SQL.EXEC
endif

