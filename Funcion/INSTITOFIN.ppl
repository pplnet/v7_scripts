Recorrer&i val(FV:1), Habiles(val(FV:1),1,'ARG',SI)-1
    **-inserto datos en DETITOFIN-**
    SQL.ADD("INSERT INTO "~DBO~".DETITOFIN ( ")
    SQL.ADD("Fecha, Especie, TipCupon, CuentaContable, ValorResidual, ")
    SQL.ADD("ValorContable, ValorContValuado, FecIncorporacion, ")
    SQL.ADD("TipoRegistro, NrOperacion ) ")
    SQL.ADD("VALUES ( ")
    SQL.ADD("'"~Idxdate(&i)~"','"~&especie~"', "~Fstr(&tipoCupon, 0, 0)~",'"~&cuentaContable~"',"~Fstr(&valorResidual, 0, 0)~", ")
    SQL.ADD(" "~Fstr(&valorContable, 0, 0)~", "~Fstr(&valorContableValuado, 0, 2)~", '"~Idxdate(&fechaProceso)~"', ")
    SQL.ADD("'"~&tipoRegistro~"', '"~&nrOperacion~"') ")
    SQL.NEW
    SQL.EXEC 
Proximo


