Message('Prestamos CashFlow E ')
scn(f:200,1)
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo, ")
*SQL.ADD("C.Total2/1000 Cant,C.Cantidad1/1000 ImpAm  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("C.Total1/1000 Cant,C.Cantidad1/1000 ImpAm  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion=C.NrOperacion and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD("PrecioEj/1000 Cant,0 as ImpAm  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
*SQL.ADD("TotalBrutoCli1/1000 Cant,PrecioEj/1000 ImpAm from "~DBO~".OPERACIONES  O ")
SQL.ADD("TotalNetoCli1/1000 Cant,PrecioEj/1000 ImpAm from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie,  O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD("PrecioEj/1000 Cant,0 ImpAm from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and  O.FechaOp<> O.FechaOp2 ")
SQL.ADD(" and  ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1,O.Especie,O.FechaVto Fecha,O.NrOperacion,O.TipoOp,'Vto' as Tipo, ")
SQL.ADD(" (O.Cantidad-SUM(C.Cantidad4))/1000 Cant,C.Cantidad1/1000 ImpAm ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' and  C.Fecha2>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMFIMV') and  O.RB5='1' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Group By O.Vehiculo1, O.Especie, O.FechaVto, O.NrOperacion, O.TipoOp,O.Cantidad,C.Cantidad1 ")
SQL.ADD(" Union All ")
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
SQL.ADD(" PrecioEj/1000 Cant,0 as ImpAm from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion=C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMFIMV') and  O.RB5='1' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1,O.Especie,C.Fecha2 Fecha,O.NrOperacion,O.TipoOp,'Vto' as Tipo, ")
   *SQL.ADD("C.Total2/1000 Cant,C.Cantidad1/1000 ImpAm  from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("C.Total1/1000 Cant,C.Cantidad1/1000 ImpAm  from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie,O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("PrecioEj/1000 Cant,0 ImpAm   from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo, ")
   *SQL.ADD("TotalBrutoCli1/1000 Cant,PrecioEj/1000 ImpAm  from "~DBO~".OPSEVENTUALES O ")
   SQL.ADD("TotalNetoCli1/1000 Cant,PrecioEj/1000 ImpAm  from "~DBO~".OPSEVENTUALES O ")
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, 'Cap' as Tipo,")
   SQL.ADD("PrecioEj/1000 Cant,0 ImpAm from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 and  O.FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo,  ")
SQL.ADD("C.Importe4/1000 Cant,0 ImpAm from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) or ")
SQL.ADD(" ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) or ")
SQL.ADD(" (O.TipoOp In ('MMFIMV') and  O.RB5='1') ")
SQL.ADD(" ) ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD("C.Importe4/1000 Cant,0 ImpAm from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and O.FechaOp2 <='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha1>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and ( ")
   SQL.ADD(" ((O.TipoOp In ('MMONM') and  O.MB2='0') or O.TipoOp In ('MMFIMV')) or ")
   SQL.ADD(" ((O.TipoOp In ('MMON') and  O.MB2='0') or O.TipoOp In ('MMFRNP')) or ")
   SQL.ADD(" (O.TipoOp In ('MMFIMV') and  O.RB5='1') ")
   SQL.ADD(" ) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
EndIf
SQL.ADD("order by 1, 2,4,6 ")
Recorrer SQL

  If Dialogo.Radio2 = 0
     IF EqStr(FBN['Tipo'],'Cap')
        Recorrer&i 2, val(d:200)-1
          if fbn['Fecha'] = val(&i:10)
             scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
        Recorrer&i val(d:200)+1, val(g:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(af:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
           endif
        Proximo       
        act(af:201,FBN['NrOperacion'])
     Else     
        Recorrer&i 2, val(d:200)-1
           if fbn['Fecha'] = val(&i:10)
              scn(&i:val(f:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              scn(&i:val(i:200),fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
              *If EqStr(Val(af:201),FBN['NrOperacion'])
