**-- CALCDIVI
**-- Calculo de Importes para Pago de Cupon

ACT(a:FAC, FBN['Cliente1'])
ACT(b:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
ACT(c:FAC, Dialogo.Cuenta1)

*** Calcula el monto total ********
acn(q:fac, val(d:fac)*(Dialogo.Precio1/100))
acn(r:fac, val(d:fac)*(Dialogo.Precio2/100))
acn(s:fac, val(d:fac)*VAL(z6))

*** Calcula la fraccion *******
acn(t:fac, val(s:fac)/Dialogo.Precio3)
acn(u:fac, Trunc(val(s:fac)/Dialogo.Precio3))
acn(v:fac, (Val(t:fac)-Val(u:fac))*Dialogo.Precio3)

acn(ae:fac, Round(val(s:fac),2)-Round(val(v:fac),2))
acn(af:fac, val(v:fac))
acn(ag:fac, Round(val(af:fac)*Dialogo.Precio4/0.01)*0.01)
 
*** calcula los gastos sobre el monto ***
acn(w:fac, val(ae:fac)*Dialogo.Precio5/100)
acn(ah:fac, iif(val(w:fac)<Dialogo.Precio6,Dialogo.Precio6,val(w:fac)))
acn(ah:fac, Round(val(ah:fac),2))

acn(ak:fac, val(ae:fac)+val(ag:fac)-val(ah:fac))
  
  