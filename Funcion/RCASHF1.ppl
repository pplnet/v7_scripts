ACN(BD:1, 0)
IF Val(CZ:2) > 0
    Recorrer&k 4, Val(LM:2)
        ACN(TS:&k, 0)
        ACN(TC:&k, 0)
        ACN(TX:&k, 0)
    Proximo
    ACN(FS:1, 0)
    ACN(FC:1, 0)
    ACT(CO:1, '')
    ACT(SB:1, '')
ENDIF
(.'RCABCUADRO'.)
***---Fila con Fechas del cuadro
ACN(FI:1, fac)
ifa
***---MessageBox(Val(FJ:1))
SQL.ADD(" Select CCGPK1 as Concepto, CCDL01 as DescCon, CCGPK2 as SubCon, CCDL02 as DescSubCon, CCGPK3 as Oper, CCDL03 as DescOper, ")
SQL.ADD("        RTrim(CCGPK6) as Cuadro, CCDL06 as DescCuadro, CCDIVJ as Fecha, (CCAAP/1000) as ImpTot, (CCFAP/1000) as ImpMonExt, CCCRCD as Moneda ")
SQL.ADD(" From "~DBO~".F5509997 ")
***---SQL.ADD(" From "~Var('OWDBL1')~".F5509997@"~Var('DBLINK1')~" ")
***---SQL.ADD(" Where CCUPMJ = '"~Val(FJ:1)~"' ")
SQL.ADD(" Where CCUPMJ = '"~IdxDate(Dialogo.Fecha1)~"' ")
If Val(cz:2) = 0
   SQL.ADD(" AND (CCGPK6 = 'LOC' or (CCGPK6 = 'MON' and CCCRCD = '"~Val(ML:2)~"' )) ")
Else
   SQL.ADD(" AND (CCGPK6 = 'EXT' or (CCGPK6 = 'MON' and CCCRCD <> '"~Val(ML:2)~"' )) ")
EndIf
IF Dialogo.Radio1 = 1
   SQL.ADD(" AND CCCO = '"~Val(VH:1)~"' ")
ENDIF
SQL.ADD(" Order By Concepto, SubCon, Oper ")
Recorrer SQL
    ACT(MF:1, BuscarCampo('ESPECIES','Codigo','Alias5', fbn('Moneda')))
    ACN(BD:2, 0)
    IF Val(BD:1) = 0
        ***---Primer Registro
        *(.'RCABCUADRO'.)
        ***---Fila con Fechas del cuadro
        *ACN(FI:1, fac)
        *ifa
    ENDIF
    IF Not Eqstr(fbn('Concepto'), Val(CO:1))
        IF Not CeldaVacia(CO:1)
            Recorrer&k 4, Val(LM:2)
                ***---Totales Concepto, SubConcepto Y Cuadro
                ACN(&k:Val(FC:1), Val(TC:&k))
                ACN(&k:Val(FS:1), Val(TS:&k))
                SCN(TX:&k, Val(TC:&k) * Val(SG:1))
                ACN(TC:&k, 0)
                ACN(TS:&k, 0)
            Proximo
        ENDIF
        ***---Cambio de Concepto
        ACT(A:fac, fbn('DescCon'))
        ACT(CX:fac, fbn('Concepto'))
        IF Eqstr(Copy(fbn('Concepto'), 3, 1), '+')
            ACN(SG:1, 1)
        ELSE
            ACN(SG:1, -1)
        ENDIF
        ***---Fila Concepto
        ACN(FC:1, fac)
        IF Val(BD:1) = 0
            IF Val(CZ:2) = 0
                ***---Fila Inicial Cuadro ARP
                ACN(PI:1, fac)
            ELSE
                ***---Fila Inicial Cuadro USD
                ACN(DI:1, fac)
            ENDIF
        ENDIF
        ifa
        ACT(B:fac, fbn('DescSubCon'))
        ***---Fila SubConcepto
        ACN(FS:1, fac)
        ifa
        ACT(C:fac, fbn('DescOper'))
        ACT(CO:1, fbn('Concepto'))
        ACT(SB:1, fbn('SubCon'))
        ACT(OP:1, fbn('Oper'))
        IF Val(BD:1) = 0
            IF Val(CZ:2) = 0
                ***---Fila Inicial Primer Operacion ARP
                ACN(OI:1, fac)
            ELSE
                ***---Fila Inicial Primer Operacion USD
                ACN(OI:2, fac)
            ENDIF
        ENDIF
    ELSE
        IF Not Eqstr(fbn('SubCon'), Val(SB:1))
            ***---Cambio de SubConcepto
            IF Not CeldaVacia(SB:1)
                Recorrer&k 4, Val(LM:2)
                    ACN(&k:Val(FS:1), Val(TS:&k))
                    ACN(TS:&k, 0)
                Proximo
            ENDIF
            ACT(B:fac, fbn('DescSubCon'))
            ACN(FS:1, fac)
            ifa
            ACT(C:fac, fbn('DescOper'))
            ACT(SB:1, fbn('SubCon'))
            ACT(OP:1, fbn('Oper'))
        ELSE
            ***---Cambio de Operacion
            IF Not Eqstr(fbn('Oper'), Val(OP:1))
                ACT(C:fac, fbn('DescOper'))
                ACT(OP:1, fbn('Oper'))
            ELSE
                ***---Suma en la misma fila
                DFA
            ENDIF
        ENDIF
    ENDIF
    ***---Determino Fecha
    ACD(FE:2, fbn('Fecha'))
    ***---lo comento hasta que se desarrolle en V6 ACD(FE:1, FechaJul(Val(FE:2)))
    IF EsHabil(Val(FE:2), 'ARG')
        ACD(FE:2, Val(FE:2))
    ELSE
        ACD(FE:2, Habiles(Val(FE:2), 1, 'ARG', SI))
    ENDIF
    ***---Determino monto a sumar
    IF Eqstr(fbn('Cuadro'), 'LOC')
        ACN(IM:1, fbn('ImpTot'))
*MessageBox(Val(IM:1))
    ELSE
        IF Eqstr(fbn('Cuadro'), 'EXT')
            IF Eqstr(Val(MF:1), Val(ME:1))
                ***---Moneda USD
                ACN(IM:1, fbn('ImpMonExt'))
            ELSE
                IF Eqstr(Val(MF:1), Val(ML:1))
                    ***---Moneda ARP
                    Recorrer&k 1, Val(RX:1)
                        ***---Busco Cotizacion del USD para cuadro USD
                        IF Eqstr(Val(YX:&k), 'DOL') Y Eqstr(Val(YY:&k), Val(ME:1))
                            ACN(TC:1, Val(YZ:&k))
                            Break
                        ELSE
                            ACN(TC:1, 1)
                        ENDIF
                    Proximo
                    ACN(IM:1, fbn('ImpTot')/Val(TC:1))
                ELSE
                    ***---Moneda NO USD ni ARP
                    Recorrer&k 1, Val(RX:1)
                        ***---Busco Cotizacion de la moneda para cuadro USD
                        IF Eqstr(Val(YX:&k), 'DOL') Y Eqstr(Val(YY:&k), Val(MF:1))
                            ACN(TC:1, Val(YZ:&k))
                            Break
                        ELSE
                            ACN(TC:1, 1)
                        ENDIF
                    Proximo
                    ACN(IM:1, fbn('ImpMonExt')*Val(TC:1))
                ENDIF
            ENDIF
        ELSE
            IF Eqstr(fbn('Cuadro'), 'MON')
                IF Eqstr(Val(MF:1), Val(ML:1))
                    ***---Moneda ARP
                    ACN(IM:1, fbn('ImpTot'))
                ELSE
                    IF Eqstr(Val(MF:1), Val(ME:1))
                        ***---Moneda USD
                        ACN(IM:1, fbn('ImpMonExt'))
                    ELSE
                        ***---Moneda NO USD ni ARP
                        Recorrer&k 1, Val(RX:1)
                            ***---Busco Cotizacion de la moneda para cuadro USD
                            IF Eqstr(Val(YX:&k), 'DOL') Y Eqstr(Val(YY:&k), Val(MF:1))
                                ACN(TC:1, Val(YZ:&k))
                                Break
                            ELSE
                                ACN(TC:1, 1)
                            ENDIF
                        Proximo
                        ACN(IM:1, fbn('ImpMonExt')*Val(TC:1))
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
    ***---Recorro Columnas Diarias
*MessageBox(Val(LM:1))
*MessageBox(Val(FE:2))
*MessageBox(Val(&k:Val(FI:1)))
    Recorrer&k 4, Val(LM:1)-1
        IF Val(FE:2) = Val(&k:Val(FI:1))
            SCN(&k:fac, Val(IM:1))
            SCN(TC:&k, Val(IM:1))
            SCN(TS:&k, Val(IM:1))
            ACN(BD:2, 1)
        ELSE
            SCN(&k:fac, 0)
        ENDIF
    Proximo
    IF Val(BD:2) = 0
        ***---Recorro Columnas Mensuales
        Recorrer&k Val(LM:1), Val(LM:2)-1
            ***---En GG tengo el ultimo dia habil de la columna
            IF Val(FE:2) >= PriDeMes(Val(GG:&k), SI) Y Val(FE:2) <= Val(GG:&k)
                SCN(&k:fac, Val(IM:1))
                SCN(TC:&k, Val(IM:1))
                SCN(TS:&k, Val(IM:1))
                ACN(BD:2, 1)
            ELSE
                SCN(&k:fac, 0)
            ENDIF
        Proximo
    ENDIF
    IF Val(BD:2) = 0
        ***---Ultima columna
        IF Val(FE:2) >= PriDeMes(Val(GG:Val(LM:2)), SI)
            SCN(Val(LM:2):fac, Val(IM:1))
            SCN(TC:Val(LM:2), Val(IM:1))
            SCN(TS:Val(LM:2), Val(IM:1))
            ACN(BD:2, 1)
        ELSE
            SCN(Val(LM:2):fac, 0)
        ENDIF
    ENDIF
    ACN(BD:1, 1)    
Proximo
IF Val(CZ:2) = 0
    ***---Fila Final Cuadro ARP
    ACN(PF:1, fac)
ELSE
    ***---Fila Final Cuadro USD
    ACN(DF:1, fac)
ENDIF
***---Totales Ultimo Concepto Y SubConcepto
IF Not CeldaVacia(SB:1)
    Recorrer&k 4, Val(LM:2)
        ACN(&k:Val(FS:1), Val(TS:&k))
        ACN(TS:&k, 0)
    Proximo
ENDIF
IF Not CeldaVacia(CO:1)
    Recorrer&k 4, Val(LM:2)
        ACN(&k:Val(FC:1), Val(TC:&k))
        SCN(TX:&k, Val(TC:&k) * Val(SG:1))
IF &k=4
*MessageBox(Val(TC:&k))
ENDIF
        ACN(TC:&k, 0)
    Proximo
ENDIF
