SQL.ADD("Select O.NrOperacion, MP.Cliente, MP.FechaMov, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.RazonSocial, E.Nombre,                                          ")
SQL.ADD("          CASE  WHEN O.TipoOp in('TIC', 'TIV', 'TIFC', 'TIFV')  THEN Cuenta3 Else (CASE  WHEN O.TipoOp in ('FXC','FXV','FXCT','FXVT','FXA','FXAT','MMCO', 'MMCT','MMPF','MMPFCE') and O.Especie=MP.Especie THEN Cuenta1 Else (CASE  WHEN O.TipoOp in ('FXC','FXV','FXCT','FXVT','FXA','FXAT') and O.ContraEspecie=MP.Especie THEN Cuenta2 Else Cuenta1 END ) END ) END AS Cuenta, ")
SQL.ADD("       MP.Mercado                                         ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                                                         ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'                                         ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'                                         ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'                                                ")
SQL.ADD(" and   MP.Cliente=C.Codigo                                                                    ")
SQL.ADD(" and   O.Especie=E.Codigo                                                                     ")
if val(AB1) = 1
   * Filas de EuroClear
   SQL.ADD(" and MP.Mercado = 'EU'                                                                     ")
EndIf
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                    ")
SQL.ADD(" and MP.NrSaldo in (1)                                                                        ")