*-DEVEBOA: Resultado de Barrier Option Asiatica 
* Verifico la condicion de ejercicio
IF [EqStr(FBN['MB1'],'0') y val(j:fac)>=val(g:fac)] o [EqStr(FBN['MB1'],'1') y val(j:fac)<=val(g:fac)]
   *-- Calculo el Resultado por Unidad    
   IF EqStr(FBN['MB1'],'0') 
      *---- CALL
      IF Num(FBN['MB4'])=3
         *-- Down&Out -> PrecioReal >=Knock
         IF val(j:fac)>=FBN['TipoCambio2']
            ACN(ab1,(val(j:fac)-val(g:fac)))
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=2
         *-- Down&In -> PrecioReal<=Knock
         IF val(j:fac)<=FBN['TipoCambio2']
            ACN(ab1,(val(j:fac)-val(g:fac)))
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=1
         *-- Up&Out -> PrecioReal <=Knock
         IF val(j:fac)<=FBN['TipoCambio2']
            ACN(ab1,(val(j:fac)-val(g:fac)))
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=0
         *-- Up&In -> PrecioReal >=Knock
         IF val(j:fac)>=FBN['TipoCambio2']
            ACN(ab1,(val(j:fac)-val(g:fac)))
         ENDIF
      ENDIF
   ELSE 
      *---- PUT
      IF Num(FBN['MB4'])=3
         *-- Down&Out -> PrecioReal >=Knock
         IF val(j:fac)>=FBN['TipoCambio2']
            ACN(ab1,(val(g:fac)-val(j:fac)))
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=2
         *-- Down&In -> PrecioReal<=Knock
         IF val(j:fac)<=FBN['TipoCambio2']
            ACN(ab1,(val(g:fac)-val(j:fac)))
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=1
         *-- Up&Out -> PrecioReal <=Knock
         IF val(j:fac)<=FBN['TipoCambio2']
            ACN(ab1,(val(g:fac)-val(j:fac)))  
         ENDIF
      ENDIF
      IF Num(FBN['MB4'])=0
         *-- Up&In -> PrecioReal >=Knock
         IF val(j:fac)>=FBN['TipoCambio2']
            ACN(ab1,(val(g:fac)-val(j:fac)))
         ENDIF
      ENDIF
   ENDIF   

   IF Num(FBN['MB3'])=1
      * Si es Venta Multiplico por -1
      ACN(ab1,-VAL(ab1))
   ENDIF

   Message('Resultado por Unidad '~Fstr(val(ab1),0,2))

EndIf      

