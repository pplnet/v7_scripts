   IF Dialogo.Radio1=2
      SQL.ADD("    (O.Cartera = 1 OR (Cartera = -1 and CanPosInv1 > 0)) AND ") 
   ENDIF
   IF Dialogo.Radio1=3
      SQL.ADD("    (O.Cartera = 2 OR (Cartera = -1 and CanPosInv2 > 0)) AND ") 
   ENDIF
   IF Dialogo.Radio1=4
      SQL.ADD("    (O.Cartera = 3 OR (Cartera = -1 and CanPosOSoc > 0)) AND ") 
   ENDIF
   SQL.ADD("       O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.TipoOp IN ('TIPP') ")
