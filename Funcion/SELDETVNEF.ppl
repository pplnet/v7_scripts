If EqStr(Dialogo.String1, 'Retiros')
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, 0 as CanPosTrad, 0 as CanPosInv1, 0 as CanPosInv2, 0 as CanPosOSoc, T.Cambio1 TotalNetoCli1, 0 TotalBrutoCli1, ")
   SQL.ADD("       0 TotalDerechos, T.Fecha1 FechaOp, '' FechaVto, '' Inv ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSPEN M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("       T.NrTrans=M.NrOperacion and ")
   SQL.ADD("       T.Cliente1=M.Cliente and ")
   SQL.ADD("       M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("       M.NrSaldo IN ("~Pipe2Comillas(Val(ns1))~") AND ")
   SQL.ADD("       B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("       T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   IF Dialogo.Radio1<>0
      SQL.ADD("    T.RB4 = '"~Fstr(Dialogo.Radio1-1,0,0)~"' AND ") 
   ELSE
      SQL.ADD("    T.RB4 >= 0 AND ") 
   ENDIF
   SQL.ADD("       T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       T.TipoTr2 IN ('RTP') ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, 0 as CanPosTrad, 0 as CanPosInv1, 0 as CanPosInv2, 0 as CanPosOSoc, T.Cambio1 TotalNetoCli1, 0 TotalBrutoCli1, ")
   SQL.ADD("       0 TotalDerechos, T.Fecha1 FechaOp, '' FechaVto, '' Inv ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("       T.NrTrans=M.NrOperacion and ")
   SQL.ADD("       T.Cliente1=M.Cliente and ")
   SQL.ADD("       M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("       M.NrSaldo IN ("~Pipe2Comillas(Val(ns1))~") AND ")
   SQL.ADD("       B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("       T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   IF Dialogo.Radio1<>0
      SQL.ADD("    T.RB4 = '"~Fstr(Dialogo.Radio1-1,0,0)~"' AND ") 
   ELSE
      SQL.ADD("    T.RB4 >= 0 AND ") 
   ENDIF
   SQL.ADD("       T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       T.TipoTr2 IN ('RTP') ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, 0 as CanPosTrad, 0 as CanPosInv1, 0 as CanPosInv2, 0 as CanPosOSoc, T.Cambio1 TotalNetoCli1, 0 TotalBrutoCli1, ")
   SQL.ADD("       0 TotalDerechos, T.Fecha1 FechaOp, '' FechaVto, 'INV' Inv ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSPEN M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("       T.NrTrans=M.NrOperacion and ")
   SQL.ADD("       T.Cliente2=M.Cliente and ")
   SQL.ADD("       M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("       M.NrSaldo IN ("~Pipe2Comillas(Val(ns1))~") AND ")
   SQL.ADD("       B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("       T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   IF Dialogo.Radio1<>0
      SQL.ADD("    T.RB4 = '"~Fstr(Dialogo.Radio1-1,0,0)~"' AND ") 
   ELSE
      SQL.ADD("    T.RB4 >= 0 AND ") 
   ENDIF
   SQL.ADD("       T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       T.TipoTr2 IN ('DTP') ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, 0 as CanPosTrad, 0 as CanPosInv1, 0 as CanPosInv2, 0 as CanPosOSoc, T.Cambio1 TotalNetoCli1, 0 TotalBrutoCli1, ")
   SQL.ADD("       0 TotalDerechos, T.Fecha1 FechaOp, '' FechaVto, '' Inv ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
