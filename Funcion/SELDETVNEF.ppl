If EqStr(Dialogo.String1, 'Pases Activos')
   SQL.ADD("SELECT O.NrOperacion, O.TipoOp,  ")
   IF Dialogo.Radio1=0
      SQL.ADD("    O.Cantidad, O.CanPosTrad, O.CanPosInv1, O.CanPosInv2, O.CanPosOSoc, ")
      SQL.ADD("    O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.FechaOp, O.FechaVto ")
   Endif
   IF Dialogo.Radio1=1
      SQL.ADD("    O.Cantidad, O.CanPosTrad, (O.TotalNetoCli1*O.CanPosTrad)/O.Cantidad as TotalNetoCli1, ")
      SQL.ADD("    (O.TotalBrutoCli1*O.CanPosTrad)/O.Cantidad as TotalBrutoCli1, ")
      SQL.ADD("    (O.TotalDerechos*O.CanPosTrad)/O.Cantidad as TotalDerechos, O.FechaOp, O.FechaVto ")
   Endif
   IF Dialogo.Radio1=2
      SQL.ADD("    O.Cantidad, O.CanPosInv1, (O.TotalNetoCli1*O.CanPosInv1)/O.Cantidad as TotalNetoCli1, ")
      SQL.ADD("    (O.TotalBrutoCli1*O.CanPosInv1)/O.Cantidad as TotalBrutoCli1, ")
      SQL.ADD("    (O.TotalDerechos*O.CanPosInv1)/O.Cantidad as TotalDerechos, O.FechaOp, O.FechaVto ")
   Endif
   IF Dialogo.Radio1=3
      SQL.ADD("    O.Cantidad, O.CanPosInv2, (O.TotalNetoCli1*O.CanPosInv2)/O.Cantidad as TotalNetoCli1, ")
      SQL.ADD("    (O.TotalBrutoCli1*O.CanPosInv2)/O.Cantidad as TotalBrutoCli1, ")
      SQL.ADD("    (O.TotalDerechos*O.CanPosInv2)/O.Cantidad as TotalDerechos, O.FechaOp, O.FechaVto ")
   Endif
   IF Dialogo.Radio1=4
      SQL.ADD("    O.Cantidad, O.CanPosOSoc, (O.TotalNetoCli1*O.CanPosOSoc)/O.Cantidad as TotalNetoCli1, ")
      SQL.ADD("    (O.TotalBrutoCli1*O.CanPosOSoc)/O.Cantidad as TotalBrutoCli1, ")
      SQL.ADD("    (O.TotalDerechos*O.CanPosOSoc)/O.Cantidad as TotalDerechos, O.FechaOp, O.FechaVto ")
   Endif
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion AND ")
   SQL.ADD("       B.Valor=0 and B.NrBit in ('30') AND ")
   SQL.ADD("       O.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("       O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   IF Dialogo.Radio1=1
      SQL.ADD("    (O.Cartera = 0 OR (Cartera = -1 and CanPosTrad > 0) AND ") 
   ENDIF
   IF Dialogo.Radio1=2
      SQL.ADD("    (O.Cartera = 1 OR (Cartera = -1 and CanPosInv1 > 0) AND ") 
   ENDIF
   IF Dialogo.Radio1=3
      SQL.ADD("    (O.Cartera = 2 OR (Cartera = -1 and CanPosInv2 > 0) AND ") 
   ENDIF
   IF Dialogo.Radio1=4
      SQL.ADD("    (O.Cartera = 3 OR (Cartera = -1 and CanPosOSoc > 0) AND ") 
   ENDIF
   SQL.ADD("       O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.TipoOp IN ('TIPA', 'TIBCRA')  ")
Endif

