*-- Importar Tipos de Variables
LeerPMG('TIPOVAR', 'WKS')

If Vacio(val(ab1))
   Cancelar('No se ha podido recuperar el TIPOVAR.wks')
EndIf

*- Incorporar nueva variable a la planilla
SCN(ab1,1)
ACT(a:val(ab1),Dialogo.String)
ACT(b:val(ab1),Mirt(Trim(Reemplazar(Dialogo.Lista1,"|"," "))) )

If Dialogo.Radio1=1
   ACT(c:val(ab1),'Pipe')
EndIf
If Dialogo.Radio1=2
   ACT(c:val(ab1),"In")
EndIf

If Dialogo.Radio2=1
   ACT(d:val(ab1),'EXE')
EndIf

Message('*-- Actualizando TIPOVAR.WKS ')

GrabarPMG('TIPOVAR','WKS')
