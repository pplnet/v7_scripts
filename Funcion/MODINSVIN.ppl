* Funcion Que modifica la Instancia para Operaciones Vinculadas
* Z:1 = Valor (0 o 1)
* Z:2 = NrOperacion (Pasiva o Activa)
* Z:3 = Nr Bit (Instancia Origen)
* Z:4 = Nr Bit (Instancia Destino)
*************** ORIGEN ************
ACN(z:1,0)
mESSAGEbOX ('pASO POR LA FUNCION1')
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = 'O' ")
    SQL.ADD(" Where NrOperacion = '"~Val(z:2)~"' ")
    SQL.ADD(" and NrBit         =  "~Fstr(Dialogo.Entero2,2,0)~"  ")

    SQL.NEW
    SQL.EXEC
*************** DESTINO ************
ACN(z:1,1)
mESSAGEbOX ('pASO POR LA FUNCION2')
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = '1' ")
    SQL.ADD(" Where NrOperacion = '"~Val(z:2)~"' ")
    SQL.ADD(" and NrBit         =  "~Fstr(Dialogo.Entero3,2,0)~"  ") 

    SQL.NEW
    SQL.EXEC
mESSAGEbOX ('pASO POR LA FUNCION3')