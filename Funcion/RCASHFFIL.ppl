If Val(cc:2000) <= 5
   ACD(ff:1000, Habiles(Dialogo.Fecha1-1, &i -2, 'ARG', SI))
   ACD(&i+1:fac, Val(ff:1000))
IF Val(CZ:2)=4
*MessageBox(Val(&i+1:fac))
ENDIF
   If Val(ff:1000) = Val(ab:2000)
      ACD(ab:2500, FinDeMes(Val(ab:2000)) )
      ACD(ff:2000, Val(ab:2500) )
   EndIf
   
   If Val(ff:1000) > Val(ab:2000) y Val(cc:2000) < 5
      ACT(ab:2510, Meses(Mes(Habiles(Val(ff:2000), 1))) )
      ACT(&i+1:fac, Val(ab:2510) )
      ACD(ff:2000, FinDeMes(Habiles(Val(ff:2000), 1)) )
      SCN(cc:2000, 1)
   
      If Val(bb:2000) = 0
         ACN(lm:1, &i+1)
         ACN(bb:2000, 1)
      EndIf
   
      ACD(gg:&i+1, Val(ff:2000))
   EndIf
    
   If Val(cc:2000) = 5
      ACT(ab:2510, Meses(Mes(Habiles(Val(ff:2000), 0))) )
      ACT(&i+1:fac, ">= "~Val(ab:2510) )
      ACN(lm:2, &i+1)
      ACD(gg:&i+1, Val(ff:2000))
      SCN(cc:2000,1)
   EndIf
EndIf
   
ACO(&i+1, 10)