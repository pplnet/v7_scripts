ACD(fe:1, Pridemes(dialogo.Fecha1) )

ACN(fi:1, fac)
ACT(a:fac, 'Resultados')
ACT(b:fac, 'REVAL')
ACT(c:fac, 'TRADE')
ACT(d:fac, 'REALIZ')
ACT(e:fac, 'RIEXP')
ACT(f:fac,   'Total')
ACT(f:fac+1, 'Trading')

ACN(co:1, 7)

SQL.ADD("SELECT Distinct TipoResultado FROM "~DBO~".RESULTADOS R WHERE Fecha<= "~idxdate2(Dialogo.Fecha1)~" AND TipoResultado NOT IN ('REVAL','TRADE','REALIZ','RIEXP') ")

Recorrer SQL
  dfa
  ACT(Val(co:1):fac, fbn('TipoResultado'))
  SCN(co:1, 1)
Proximo

ACT(Val(co:1):fac,   'Total')
ACT(Val(co:1):fac+1, 'Intereses')
SCN(co:1, 1)
ACT(Val(co:1):fac,   'TOTAL')

AgregarMarco(a:fac..Val(co:1):fac+1,1,0,EXE('COLOR6'))
SetFont(a:fac..Val(co:1):fac+1,2)
AlinearCeldas(a:fac..Val(co:1):fac+1,'C')
ifa

SQL.ADD(" SELECT R.TipoResultado, R.Especie,  R.FechaEj, R.Book, ") 
SQL.ADD(" SUM(R.Day) Resultado ")
SQL.ADD(" , CASE R.NrSaldo WHEN 42  THEN 'NDF' ")
SQL.ADD("                  WHEN 136 THEN 'NDF' ")
SQL.ADD("                  WHEN 137 THEN 'NDF' ")
SQL.ADD("                  WHEN 43  THEN 'OCT' ")
SQL.ADD("                  WHEN 44  THEN 'ROFEX' ")
SQL.ADD("                  ELSE E.Tipo END NrSaldo  ")
SQL.ADD(" , CASE E.Tipo    WHEN 'MON'  THEN 1 ")
SQL.ADD("                  ELSE 2 END Tipo  ")
SQL.ADD(" FROM "~DBO~".RESULTADOS R, "~DBO~".ESPECIES E, "~DBO~".BOOKS B ")
SQL.ADD(" WHERE R.Book    = B.Codigo ")
SQL.ADD(" AND R.Especie = E.Codigo ")
SQL.ADD(" AND R.TipoResultado NOT IN ('CONT','MTMOCT') ")
SQL.ADD(" AND R.NrSaldo NOT IN (51,172) ")
SQL.ADD(" AND R.Day<>0 ")
SQL.ADD(" AND R.Fecha  = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" and R.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and R.Especie <>'"~VAR('MONELOCA')~"' ")
SQL.ADD(" AND R.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS P1 ")
SQL.ADD("                   WHERE P1.Vehiculo      = R.Vehiculo      ")
SQL.ADD("                   AND   P1.Book          = R.Book          ")
SQL.ADD("                   AND   P1.TipoResultado = R.TipoResultado ")
SQL.ADD("                   AND   P1.Especie       = R.Especie       ")
SQL.ADD("                   AND   P1.NrSaldo       = R.NrSaldo       ")
SQL.ADD("                   AND   (P1.Cupon    = R.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (R.Cupon    IS NULL OR R.Cupon   ='' OR R.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = R.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (R.Sector   IS NULL OR R.Sector  ='' OR R.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = R.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (R.CallPut  IS NULL OR R.CallPut ='' OR R.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = R.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (R.FechaEj  IS NULL OR R.FechaEj ='' OR R.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = R.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (R.PrecioEj IS NULL OR R.PrecioEj='' OR R.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" GROUP BY R.TipoResultado, R.Especie, R.FechaEj, Tipo, R.NrSaldo, E.Tipo, R.Book ")
SQL.ADD(" ORDER BY E.Tipo, R.NrSaldo, R.Especie, R.FechaEj, R.TipoResultado ")
ACT(ea:1, '')
ACD(fj:1, 0)
ACT(ti:1, '')
ACN(fi:2, fac)

Recorrer SQL
  If Not Eqstr(fbn('NrSaldo'),Val(ti:1)) y Not Eqstr('',Val(ti:1))
     ACT(a:fac, Val(ti:1))
     Recorrer&i 2,Val(co:1)
       ACN(&i:fac, SUM(&i:Val(fi:2)..&i:fac))
     Proximo
     ACT(Val(co:1)+1:fac, 'x')
     AgregarMarco(a:fac..Val(co:1):fac,1,0,0)
     SetFont(a:fac..Val(co:1):fac,2)
     ifa
     ifa
     ACN(fi:2, fac)
  Endif
  If eqstr(fbn('Especie'), Val(ea:1)) y fbn('FechaEj')=Val(fj:1) 
     * y Not Eqstr(fbn('TipoResultado'),'FONDEO')
     dfa
  Endif
  ACT(a:fac, fbn('Especie'))
  If NoVacio(fbn('FechaEj'))
     ACT(a:fac, fbn('Especie')~' - '~fbn('FechaEj'))
  Endif

  Recorrer&i 2,Val(co:1)
    If Eqstr(fbn('TipoResultado'), Val(&i:Val(fi:1)) )
       SCN(&i:fac, fbn('Resultado'))
       Break
    Endif
  Proximo

  ACN(f:fac, SUM(b:fac..e:fac))

  ****  ACN(Val(co:1):fac, SUM(g:fac..Val(co:1)-1:fac))

  ACN(Val(co:1)-1:fac, SUM(g:fac..Val(co:1)-2:fac))
  ACN(Val(co:1):fac, Val(f:fac)+Val(Val(co:1)-1:fac))

  SetFont(a:fac..Val(co:1):fac, 1)
  SetFont(f:fac, 2)
  SetFont(Val(co:1):fac, 2)

  ACT(ea:1, fbn('Especie'))
  ACT(ti:1, fbn('NrSaldo'))
  If Novacio(fbn('FechaEj'))
     ACD(fj:1, fbn('FechaEj'))
  Else
     ACD(fj:1, 0)
  Endif
Proximo

ifa
ACT(a:fac, Val(ti:1))
Recorrer&i 2,Val(co:1)
  ACN(&i:fac, SUM(&i:Val(fi:2)..&i:fac))
Proximo
ACT(Val(co:1)+1:fac, 'x')
AgregarMarco(a:fac..Val(co:1):fac,1,0,0)
SetFont(a:fac..Val(co:1):fac,2)

ifa
ifa
ACT(a:fac, 'Total en '~val(ml1))
ACT(a:fac+1, 'Total en '~val(me1))

Recorrer&i 2,Val(co:1)
   * Recorro la columnas hasta el final.
   Recorrer&j 11,fac
      * Recorro todas las filas para sumar. Solo sumo las filas de totales.
      If Eqstr(Val(Val(co:1)+1:&j) ,'x')
         * En co:1, &j tengo una marca para saber si es una fila de totales. 
         SCN(&i:fac, Val(&i:&j) )

         *- En Dolares => Divido por val(g:val(fp1)+2)
         SCN(&i:fac+1, Val(&i:&j)/ val(g:val(fp1)+2))    
      Endif
   Proximo
Proximo

*- Utilidad para subir al informe
acn(g:val(fv1),val(f:fac)) 

AgregarMarco(a:fac..Val(co:1):fac+1,1,0,EXE('COLOR8'))
SetFont(a:fac..Val(co:1):fac+2,2)
