ACT(a:FAC  , 'SWAPS')
SetFont(a:fac,1)

SetFilaActual(fac+2)

ACT(a:fac,'Vehiculo')
ACT(b:fac,'Entidad')
ACT(c:fac,'Fecha')
ACT(c:fac+1,'Inicio')
ACT(d:fac,'Criterio')
ACT(d:fac+1,'Valuac')
ACT(e:fac,'NrOperacion')
ACT(f:fac,'TipoOp')
ACT(g:fac,'P&L')

ACT(h:fac  ,' F L U J O     DE    F O N D O S    A     P A G A R')
ACT(h:fac+1,'Moneda')
ACT(i:fac+1,'F.Inicial')
ACT(j:fac+1,'F.Final')
ACT(k:fac+1,'VResidual')
ACT(l:fac+1,'Amortiz ')
ACT(m:fac+1,'FD(t,Tj)')
ACT(n:fac+1,'Tasa c/Int')
ACT(o:fac+1,'Interes')
ACT(p:fac+1,'F Fondos')
ACT(q:fac+1,'FF*FD')
ACT(r:fac+1,'TipoTasa')
ACT(s:fac+1,'Tasa')
ACT(t:fac+1,'Spread')

ACT(u:fac  ,' F L U J O     DE    F O N D O S    A    C O B R A R ')
ACT(u:fac+1,'Moneda')
ACT(v:fac+1,'F.Inicial')
ACT(w:fac+1,'F.Final')
ACT(x:fac+1,'VResidual')
ACT(y:fac+1,'Amortiz ')
ACT(z:fac+1,'FD(t,Tj)')
ACT(aa:fac+1,'Tasa c/Int')
ACT(ab:fac+1,'Interes')
ACT(ac:fac+1,'F Fondos')
ACT(ad:fac+1,'FF*FD')
ACT(ae:fac+1,'TipoTasa')
ACT(af:fac+1,'Tasa')
ACT(ag:fac+1,'Spread')

SetFont(a:fac..ag:fac+1,1)

AgregarMarco(a:fac..g:fac+1,2,2,Exe('COLOR6'))
AgregarMarco(h:fac..u:fac,2,0,Exe('COLOR6'))
AgregarMarco(h:fac+1..ag:fac+1,2,2,Exe('COLOR6'))
AgregarMarco(v:fac..ag:fac,2,0,Exe('COLOR6'))
ifa

act(np1,'')
ACN(zt4,fac)

SQL.ADD("Select 1 Orden,               O.Vehiculo1,         O.FechaCargaSys,     O.Cliente1, ")
SQL.ADD("       O.NrOperacion,         O.Especie,           O.ContraEspecie,     O.FechaOp, ")
SQL.ADD("       C.Fecha2  FVto,        C.Fecha1 FInicio,    C.Fecha2 FFin,       C.Cantidad1 ResidualV, ")
SQL.ADD("       C.Cantidad2 ResidualC, C.Precio1 VTasa,     C.Precio2 CTasa,     C.Total3 VSpread, ")
SQL.ADD("       C.Total4 CSpread,      C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, ")
SQL.ADD("       O.RB9,                 O.RB8,               O.TotalAux3,         O.TotalBrutoCli2, ")
SQL.ADD("       C.Fecha3 FechaPago,    C.Cantidad5,         C.Cantidad6,         O.Cuotas1, ")
SQL.ADD("       O.RB5,                 C.Fecha5 FInicioC,   O.PrecioRef,         O.PrecioRef4, ")
SQL.ADD("       O.TipoTasa,            C.Fecha6 as FFinC,   O.TipoTasa2,         C.Plazo1, ")
SQL.ADD("       C.Plazo2,              O.Cotizacion1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  AND O.Especie=O.ContraEspecie ")
SQL.ADD("  and TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD("  and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF

SQL.ADD("  Union All ")

*** Selecciono operaciones con Vto Multiple
SQL.ADD("Select 2 Orden,               O.Vehiculo1,         O.FechaCargaSys,     O.Cliente1, ")
SQL.ADD("       O.NrOperacion,         O.Especie,           O.ContraEspecie,     O.FechaOp, ")
SQL.ADD("       C.Fecha2 FVto,         C.Fecha1 FInicio,    C.Fecha2 FFin,       C.Cantidad1 ResidualV, ")
SQL.ADD("       C.Cantidad2 ResidualC, C.Precio1 VTasa,     C.Precio2 CTasa,     C.Total3 VSpread, ")
SQL.ADD("       C.Total4 CSpread,      C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, ")
SQL.ADD("       O.RB9,                 O.RB8,               O.TotalAux3,         O.TotalBrutoCli2, ")
SQL.ADD("       C.Fecha3 FechaDePago,  C.Cantidad5,         C.Cantidad6,         O.Cuotas1, ")
SQL.ADD("       O.RB5,                 C.Fecha5 FInicioC,   O.PrecioRef,         O.PrecioRef4, ")
SQL.ADD("       O.TipoTasa,            C.Fecha6 as FFinC,   O.TipoTasa2,         C.Plazo1, ")
SQL.ADD("       C.Plazo2,              O.Cotizacion1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  AND O.Especie<>O.ContraEspecie ")
SQL.ADD("  and TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD("  and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(val(op1))
   SQL.ADD(" and  O.NrOperacion='"~VAL(op1)~"' ")
EndIf
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
If NoVacio(val(li4))
   SQL.ADD(" and  O.Cliente1 In ("~Pipe2Comillas(val(li4))~") ")
EndIF
SQL.ADD(" order by 1,2,3")
Recorrer SQL
   IF Not EqStr(FBN['NrOperacion'],val(np1)) y NoVacio(val(np1)) 
      ACT(a:fac,' TOTAL Flujo de Fondos en Moneda Flujo')
      ACN(p:fac,Sum(p:val(zt4)..p:fac-1))
      ACN(ac:fac,Sum(ac:val(zt4)..ac:fac-1))   
      SetFont(a:fac..aj:fac,2)
      SetFont(a:val(zt4)..aj:val(zt4),2)         
      IFA

      ACT(a:fac,' TOTAL Flujo de Fondos en Moneda de Cobro')
      ACN(p:fac,val(p:fac-1)*iif(eqstr(val(sw3),'INV'),1/val(sw2),val(sw2)))
      ACN(ac:fac,val(ac:fac-1))   
      SetFont(a:fac..aj:fac,2)     
      ACN(g:val(zt4),-val(p:fac)+val(ac:fac) )   
      SetFont(a:val(zt4)..aj:val(zt4),2)
      IFA
   ENDIF 

   IF Not EqStr(FBN['NrOperacion'],val(np1))
      ACN(zt1,FBN['Orden'])
      ACN(zt3,0)
      ACN(zt4,fac)

      ACT(np1,FBN['NrOperacion']) 
      ACT(to1,FBN['TipoOp']) 
 
      ACT(a:FAC  , FBN['Vehiculo1'])
      ACT(b:fac, FBN['Cliente1'] )
      ACD(c:fac, FBN['FechaOp'] )
      ACT(e:fac, FBN['NrOperacion'] )
      ACLO(e:fac, FBN['NrOperacion'] )
      ACT(f:fac, FBN['TipoOp'] )

      *- co1: Contador de Flujos
      ACN(co1,0)
      ACN(co2,fac)

      *- Criterio para Valuar => Devuelve en cr1 el criterio al cual valuar
      (.'CRITEVALU'.)
      ACT(d:FAC  , val(cr1))  

      if Not EqStr(FBN['Especie'],FBN['ContraEspecie'])
         * Currency Swap, recupero el tipo de cambio
         ACN(SW1,1)
         ACN(sw2,FBN['Cotizacion1'])
         ACT(sw3,SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~FBN['ContraEspecie']~"' "))
      else
         ACN(SW1,0)
         ACN(sw2,0)
      endif

   endif

   if Not EqStr(FBN['Especie'],Val(es1))
      * az1: Cotizacion 
       ACN(az1,CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
       ACT(es1, FBN['Especie'])
   endif

   if Not EqStr(FBN['ContraEspecie'],Val(es2))
      * az2: Cotizacion Contraparte
       ACN(az2,CotizacionC(fbn['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
       ACT(es2, FBN['ContraEspecie'])
   endif

   SCN(co1,1)

   ACT(gr1,FBN['PrecioRef']) 
   ACT(pe1,val(gr1))
   ACD(fe1,Dialogo.Fecha1)
   ACN(fi1,fac)  
   ACD(mx1,Dialogo.Fecha1)
   SQL.ADD(" Select Max(TD1.Fecha) AS Max from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 Where TD1.TipoTasa=TT1.Codigo and TT1.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD1.Fecha<='"~IdxDate(val(fe1))~"' ")
   Recorrer SQL
       dfa
       ACD(mx1,FBN['Max'])
   Proximo

   ACT(h:fac, FBN['Especie'] )
   ACD(i:fac, FBN['FInicio'] )
   ACD(j:fac, FBN['FFin'] )
   ACN(k:fac, FBN['ResidualV'] )
   ACN(l:fac, FBN['Cantidad6'] )
   ACT(r:fac, 'FIJA' ) 
   If NoVacio(FBN['TipoTasa'])
      ACT(r:fac, FBN['TipoTasa'] ) 
   EndIf

   ACN(s:fac, FBN['VTasa'] )
   ACN(t:fac, FBN['VSpread'] )

   If EqStr(val(d:val(co2)),'MToModel') 
      *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
      ACD(fe2,FBN['FFin'])

      *- fe3 es el plazo a interpolar 
      ACN(fe3,val(fe2)-val(fe1))
      ACN(pl1,0)
      ACN(fd1,0)
      ACN(fd2,0)

      SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and TD.PlazoHasta=")
      SQL.ADD("(Select Min(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~"<=PlazoHasta ) Union All")
      SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo  and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"'  and TD.PlazoHasta=")
      SQL.ADD("(Select Max(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~">PlazoHasta )")
      SQL.ADD("ORDER BY TD.PlazoHasta  ")

      Recorrer SQL
           dfa
           IF val(pl1)<=val(fe3) y val(fe3)<=FBN['PlazoHasta']
              * Este es el plazo a interpolar  
              ACN(fd3,val(fd1)/FBN['Valor4'] -1 )
              ACN(fd4,(val(fd3)/(FBN['Valor3']-val(fd2)))*100 )
              ACN(fd5,(FBN['Valor3']-(val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd2))*val(fd1)+((val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd2))/(FBN['Valor3']-val(fd2))*FBN['Valor4']) 
           EndIf
           ACN(pl1,FBN['PlazoHasta'])
           ACN(fd1,FBN['Valor4'])
           ACN(fd2,FBN['Valor3'])
      Proximo

      ACN(m:fac,val(fd5))
      * n:Tasa c/Int
      IF val(s:fac)>0 
         ACN(n:fac,val(s:fac)*(FBN['Plazo1']/IIf(FBN['RB8']=1,365,360)))
      Else
         ACN(n:fac,(FBN['VSpread']*(FBN['Plazo1']/IIf(FBN['RB8']=1,365,360))+((val(m:fac-1)/val(m:fac))-1))*100)
      EndIf
      *- o: Interes p: F Fondos q: FF*FD
      ACN(o:fac,val(n:fac)*val(k:fac)/100)
      ACN(p:fac,val(o:fac)+val(l:fac))
      ACN(q:fac,val(p:fac)*val(m:fac))
   EndIf

   ACT(u:fac, FBN['ContraEspecie'] )
   ACD(v:fac, FBN['FInicioC'] )
   ACD(w:fac, FBN['FFinC'] )
   ACN(x:fac, FBN['ResidualC'] )      
   ACN(y:fac, FBN['Cantidad5'] )

   ACT(ae:fac, 'FIJA' ) 
   IF NoVacio(FBN['TipoTasa2'])
      ACT(ae:fac, FBN['TipoTasa2'] )
   EndIf

   ACN(af:fac, FBN['CTasa'] )
   ACN(ag:fac, FBN['CSpread'] )

   If EqStr(val(d:val(co2)),'MToModel') 
      *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
      ACD(fe2,FBN['FFinC'])

     ACT(gr1,FBN['PrecioRef4']) 
     ACT(pe1,val(gr1))
     ACD(fe1,Dialogo.Fecha1)
     ACN(fi1,fac)  
     ACD(mx1,Dialogo.Fecha1)
     SQL.ADD(" Select Max(TD1.Fecha) AS Max from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 Where TD1.TipoTasa=TT1.Codigo and TT1.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD1.Fecha<='"~IdxDate(val(fe1))~"' ")
     Recorrer SQL
       dfa
       ACD(mx1,FBN['Max'])
     Proximo

      *- fe3 es el plazo a interpolar 
      ACN(fe3,val(fe2)-val(fe1))
      ACN(pl1,0)
      ACN(fd1,0)
      ACN(fd2,0)

      SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and TD.PlazoHasta=")
      SQL.ADD("(Select Min(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where  TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~"<=PlazoHasta ) Union All")
      SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where TD.TipoTasa=TT.Codigo  and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"'  and TD.PlazoHasta=")
      SQL.ADD("(Select Max(TD.PlazoHasta) from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where TD.TipoTasa=TT.Codigo and TT.PrecioRef='"~Trim(Mirt(val(pe1)))~"' AND TD.Fecha='"~IdxDate(val(mx1))~"' and "~Fstr(val(fe3),0,0)~">PlazoHasta )")
      SQL.ADD("ORDER BY TD.PlazoHasta  ")

      Recorrer SQL
           dfa
           IF val(pl1)<=val(fe3) y val(fe3)<=FBN['PlazoHasta']
              * Este es el plazo a interpolar  
              ACN(fd3,val(fd1)/FBN['Valor4'] -1 )
              ACN(fd4,(val(fd3)/(FBN['Valor3']-val(fd2)))*100 )
              ACN(fd5,(FBN['Valor3']-(val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd2))*val(fd1)+((val(fe2)-val(fe1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd2))/(FBN['Valor3']-val(fd2))*FBN['Valor4']) 
           EndIf
           ACN(pl1,FBN['PlazoHasta'])
           ACN(fd1,FBN['Valor4'])
           ACN(fd2,FBN['Valor3'])
      Proximo

      ACN(z:fac,val(fd5))

      IF val(af:fac)>0 
         ACN(aa:fac,val(af:fac)*(FBN['Plazo2']/IIf(FBN['RB5']=1,365,360)))
      Else
         ACN(aa:fac,(FBN['CSpread']*(FBN['Plazo2']/IIf(FBN['RB8']=1,365,360))+((val(z:fac-1)/val(z:fac))-1))*100)
      EndIf

      *- ab: Interes ac: F Fondos ad: FF*FD
      ACN(ab:fac,val(x:fac)*val(aa:fac)/100)
      ACN(ac:fac,val(ab:fac)+val(y:fac))
      ACN(ad:fac,val(ac:fac)*val(z:fac))
   EndIf

   SetFont(a:fac..aj:fac,2)
   FormatoCeldas(m:fac..n:fac, Exe('F8'))
   FormatoCeldas(aa:fac..aa:fac, Exe('F8'))
   FormatoCeldas(z:fac..z:fac, Exe('F8'))
   FormatoCeldas(ai:fac..ai:fac, Exe('F8'))

Proximo

ifa
* Obtengo Flujo de Fondos a Cobrar, a pagar y Pl.
ACT(a:fac,' TOTAL Flujo de Fondos en Moneda Flujo')
ACN(p:fac,Sum(p:val(zt4)..p:fac-1))
ACN(ac:fac,Sum(ac:val(zt4)..ac:fac-1))   
SetFont(a:fac..aj:fac,2)

ifa
ACT(a:fac,' TOTAL Flujo de Fondos en Moneda de Cobro')
ACN(p:fac,val(p:fac-1)*iif(eqstr(val(sw3),'INV'),1/val(sw2),val(sw2)))
ACN(ac:fac,val(ac:fac-1))   
SetFont(a:fac..aj:fac,2)     

ACN(g:val(zt4),-val(p:fac)+val(ac:fac) )   
SetFont(a:val(zt4)..aj:val(zt4),2)

IFA
