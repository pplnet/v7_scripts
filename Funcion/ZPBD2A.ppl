                                          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor=0 ")
                                          SQL.ADD(" WHERE NrBit=17 ")
                                          SQL.ADD(" AND NrOperacion='"~val(ad:&i)~"' ")
                                          SQL.NEW
                                          SQL.EXEC
                                          SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor=1 ")
                                          SQL.ADD(" WHERE NrBit=3 ")
                                          SQL.ADD(" AND NrOperacion='"~val(ad:&i)~"' ")
                                          SQL.NEW
                                          SQL.EXEC
                                        endif
                                      endif
                                      SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".INSTANCIASOP ")
                                      SQL.ADD(" WHERE NrOperacion='"~val(ad:&i)~"' ")
                                      SQL.ADD(" AND NrInstancia='17' ")
                                      SQL.ADD(" AND Usuario='"~USUARIOACTIVO~"' ")
                                      SQL.ADD(" AND Mensaje='ZPBD2' ")
                                      SQL.ADD(" AND Fecha="~idxdate2(Dialogo.Fecha1)~" ")
                                      SQL.NEW
                                      SQL.EXEC
                                      SQL.ADD(" INSERT INTO "~DBO~".INSTANCIASOP ")
                                      SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
                                      SQL.ADD(" VALUES ")
                                      SQL.ADD(" ('"~val(ad:&i)~"', '17', '"~USUARIOACTIVO~"', 'ZPBD2', "~idxdate2(Dialogo.Fecha1)~") ")
                                      SQL.NEW
                                      SQL.EXEC
                                      ACT(a:val(z:1), val(ac:&i))
                                      ACT(b:val(z:1), val(ad:&i))
                                      ACT(c:val(z:1), val(ae:&i))
                                      ACT(d:val(z:1), val(af:&i))
                                      ACT(e:val(z:1), val(ag:&i))
                                      ACT(f:val(z:1), val(ah:&i))
