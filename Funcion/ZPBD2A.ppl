                                      If Buscar(",", val(ai:&i)) o Buscar(".", val(ai:&i))
                                        If Buscar(",", val(ai:&i))
                                          ACT(ca:&i, Copy(val(ai:&i),Posicion(",",val(ai:&i)),3))
                                        Else
                                          ACT(ca:&i, Copy(val(ai:&i),Posicion(".",val(ai:&i)),3))
                                        EndIf
                                        if longitud(val(ca:&i)) = 2
                                          ACT(ca:&i, val(ca:&i)~'0')
                                          ACT(ca:&i, Copy(val(ca:&i), Longitud(val(ca:&i))-1,2))
                                          ACT(cb:&i, Copy(val(ai:&i),1,Longitud(val(ai:&i))-2))
                                        else
                                          ACT(ca:&i, Copy(val(ai:&i),Longitud(val(ai:&i))-1,2))
                                          ACT(cb:&i, Copy(val(ai:&i),1,Longitud(val(ai:&i))-3))
                                        endif
                                        ACT(x:1, '*M*'~Pad(val(am:&i),3)~Pad(val(ar:&i),2)~Pad(val(ao:&i),17)~Pad0(trim(mirt(val(cb:&i)~val(ca:&i))),17)~Pad('',60)~Pad('',2)~Pad('',12)~Pad('',2)~Pad('',12)~Pad(val(av:&i),12)~Pad('',2)~Pad0('',12)~Pad('',12)~Pad0('',10)~Pad(Val(CU:fac), 11)~Pad(Val(BU:fac), 22)~Pad('',29))
                                      Else
