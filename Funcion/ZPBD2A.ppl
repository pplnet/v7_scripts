                                      EndIf
                                      EscribirAscii(val(x:1))
                                      if val(ap:&i) = 1
                                        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor=0 ")
                                        SQL.ADD(" WHERE NrBit=17 ")
                                        SQL.ADD(" AND NrOperacion='"~val(ad:&i)~"' ")
                                        SQL.NEW
                                        SQL.EXEC
                                        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor=1 ")
                                        SQL.ADD(" WHERE NrBit=18 ")
                                        SQL.ADD(" AND NrOperacion='"~val(d:&i)~"' ")
                                        SQL.NEW
                                        SQL.EXEC
                                      else
