                      if novacio(val(aj:&i))
                        if not Eqstr(Trim(Mirt(val(aq:&i))),'Error')
                          if not Eqstr(Trim(Mirt(val(ar:&i))),'Error')
                            if novacio(val(al:&i))
                              if novacio(val(am:&i))
                                if novacio(val(ak:&i))
                                  IF Not Eqstr(Val(CU:&i), 'Error')
                                    IF Not Eqstr(Val(BU:&i), 'Error')
