* Operaciones con FechaVto y TotalNetoCli1
SQL.ADD(" Select O.Vehiculo1 As Clave, O.Especie, O.FechaVto Vto, O.TotalIntereses Importe, ")
SQL.ADD(" O.NrOperacion, 'OPE' as Tipo, O.TipoOp, ' ' as DescImp, 1 as BD1, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMPCL ' THEN 'PRESTAMOS FINANCIEROS' END ")
SQL.ADD("                   'MMPE  ', 'BUYERS', ")
SQL.ADD("                   'MMPI  ', 'BUYERS', ")
SQL.ADD("                   'MMPCOS', 'PRESTAMOS FINANCIEROS') Grupo, O.Cliente1, O.FechaOp, ")
SQL.ADD(" O.FechaVto, O.Contrato as MarcaSwap, O.OperacionRef, O.FechaOp2, '' Inicio, '' Fin, O.TipoTasa, O.Precio1 Tasa, 0 NrCuota,' ' Pata ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMPCL','MMPCOS','MMPE','MMPI') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
IF Dialogo.Radio5 = 0
    SQL.ADD(" AND O.TotalIntereses > 0 ")
ENDIF

SQL.ADD(" Union ")

*-----------------------------------------------------------------------------
* Operaciones con FechaVto y TotalBrutoCli1
* 
***---MMPLME Se divide en dos querys (por especie) para poder agruparla
SQL.ADD(" Select O.Vehiculo1 As Clave, O.Especie, O.FechaVto Vto, O.TotalIntereses Importe, ")
SQL.ADD(" O.NrOperacion, 'OPE' as Tipo, O.TipoOp, ' ' as DescImp, 1 as BD1, ")
SQL.ADD(" 'TOMAS ARGENDOLARES CP' Grupo, O.Cliente1, O.FechaOp, O.FechaVto, ")
SQL.ADD(" O.Contrato as MarcaSwap, O.OperacionRef, O.FechaOp2, '' Inicio, '' Fin, O.TipoTasa, O.Precio1 Tasa, 0 NrCuota,' ' Pata ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMPLME') ")
SQL.ADD(" AND O.Especie = '"~Var('MONEEXTR')~"' ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
IF Dialogo.Radio5 = 0
    SQL.ADD(" AND O.TotalIntereses > 0 ")
ENDIF

SQL.ADD(" Union ")

***---MMPLME Se divide en dos querys (por especie) para poder agruparla
SQL.ADD(" Select O.Vehiculo1 As Clave, O.Especie, O.FechaVto Vto, O.TotalIntereses Importe, ")
SQL.ADD(" O.NrOperacion, 'OPE' as Tipo, O.TipoOp, ' ' as DescImp, 1 as BD1, ")
SQL.ADD(" 'PRESTAMOS FINANCIEROS' Grupo, O.Cliente1, O.FechaOp, O.FechaVto, ")
