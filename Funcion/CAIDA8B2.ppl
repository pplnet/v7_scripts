*- MMFIMV y MMSIMV Definitivos -> RB5=0
SQL.ADD(" Select O.Vehiculo1 As Clave, O.Especie, C.Fecha3 Vto, C.Cantidad3 Importe, ")
SQL.ADD(" O.NrOperacion, 'CUO' as Tipo, O.TipoOp, ' ' as DescImp, 1 as BD1, ")
SQL.ADD(" CASE  O.TipoOp WHEN 'MMFIMV' THEN 'F.R.N. / YANKEE' ELSE 'PRESTAMOS SINDICADOS' END Grupo, ")
SQL.ADD(" O.Cliente1, O.FechaOp, O.FechaVto, O.Contrato as MarcaSwap, O.OperacionRef, O.FechaOp2, ")
SQL.ADD(" '' Inicio, '' Fin, O.TipoTasa, C.Precio2 Tasa, C.NrCuota,' ' Pata ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.RB5='0' and C.Fecha3 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND C.Fecha3 <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
IF Dialogo.Radio5 = 0
    SQL.ADD(" AND C.Cantidad3 > 0 ")
ENDIF

SQL.ADD(" Union ")

