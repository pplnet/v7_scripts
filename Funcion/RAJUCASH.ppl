SQL.ADD("SELECT O.Vehiculo1, O.Especie, O.TipoOp, O.FechaOp Fecha, ")
SQL.ADD("Sum(O.Cantidad)/1000 Cant FROM  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('AJUSCF') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:200) = 0
   SQL.ADD("  and O.Especie = '"~Val(mt:50)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(mt:50)~"' ")
EndIf

SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaOp ")

If Dialogo.Radio3 = 1
   SQL.ADD(" UNION ALL ")

   SQL.ADD("SELECT O.Vehiculo1, O.Especie, O.TipoOp, O.FechaOp Fecha, ")
   SQL.ADD("Sum(O.Cantidad)/1000 Cant FROM  "~DBO~".ESPECIES E, "~DBO~".OPSEVENTUALES O ")
   SQL.ADD("WHERE O.Especie = E.Codigo ")
   SQL.ADD(" and  O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('AJUSCF') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:200) = 0
      SQL.ADD("  and O.Especie = '"~Val(mt:50)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(mt:50)~"' ")
   EndIf

   SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaOp ")
Endif

SQL.ADD("order by 1, 2 ")

Recorrer SQL

  ACN(MT:11, 0)
  ACN(MT:12, 0)

  * ACN(MT:12, IIf(Eqstr(SQL(" SELECT Modo FROM "~DBO~".MODOESPECIES WHERE Especie1 = '"~FBN('Especie')~"' AND Especie2 = '"~Var('MONEEXTR')~"' "), 'INV'), 1/Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1), Cotizacion(FBN('Especie'),,,,Dialogo.Fecha1,1)))
  ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt:50)))

  If Dialogo.Check1 = 1
      SCN(MT:11, FBN('Cant') * Val(MT:12))
  Endif

  If Dialogo.Radio2 = 0
     *** Diario ***
     Recorrer&i 2, Val(d:200)-1
       If FBN['Fecha'] = Val(&i:10)
          SCN(&i:Val(j:200), Val(MT:11))
          SCN(&i:Val(kk:203), Val(mt:11))
       Endif
     Proximo

     Recorrer&i Val(d:200)+1, Val(g:200)-1
       If FBN['Fecha'] = Val(&i:10)
          SCN(&i:Val(j:200), Val(MT:11))
          SCN(&i:Val(kk:203), Val(mt:11))
       Endif
     Proximo

    Else

     *** Mensual ***
     Recorrer&i Val(m:200), Val(n:200)
       If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
          SCN(&i:Val(j:200), Val(MT:11))
          SCN(&i:Val(kk:203), Val(mt:11))
       Endif
     Proximo

     Recorrer&i Val(o:200), Val(p:200)
       If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
          SCN(&i:Val(j:200), Val(MT:11))
          SCN(&i:Val(kk:203), Val(mt:11))
       Endif
     Proximo

     If Val(o:200) > 0
        If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
           SCN(Val(p:200)+1:Val(j:200), Val(MT:11))
           SCN(&i:Val(kk:203), Val(mt:11))
        Endif
     Endif

     Recorrer&i Val(d:200), Val(g:200)
       If Anio(FBN['Fecha']) = Val(&i:280)
          SCN(&i:Val(j:200), Val(MT:11))
          SCN(&i:Val(kk:203), Val(mt:11))
       Endif
     Proximo

     If Anio(FBN['Fecha']) > Val(Val(g:200):280)
        SCN(Val(g:200):Val(j:200), Val(MT:11))
        SCN(&i:Val(kk:203), Val(mt:11))
     Endif
  Endif
proximo