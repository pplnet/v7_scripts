if Dialogo.Check1=1
SQL.ADD(" SELECT 1 Qry, 1 TpReg, 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, OP.Plazo, OP.FechaOp2, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, OP.FechaCarga, OP.FechaPago, ")
SQL.ADD(" OP.PaseCB, C.Codigo Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, OP.ObservacDoc, OP.NrOrden1, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB4, OP.CB8, OP.Mercado4, OP.TotalIVA IvaComision, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5, C.NrMAE, C.NrBYMA, OP.TotalGastos Derechos, OP.TotalIvaAdi IvaDerechos, ") 
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon, UDN2, NrOrdenAux, NumOpeSENEBI, ")
SQL.ADD(" (select Top(1) CT.NrDepositante from "~DBO~".CUENTAS CT Where CT.Cliente = C.Codigo and TipoCuenta = 'CUS' and NrDepositante is not Null) as ComitenteCTA, ")
SQL.ADD(" 'NO' BYMA ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
*SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      ((OP.Cliente1 = '"~VAR('VEHICULODE')~"' and OP.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('CLIENTEMAE')~"'=C.Codigo) or ((OP.Cliente1 <> '"~VAR('VEHICULODE')~"' or OP.Mercado4<>'"~VAR('AMBMAE')~"') and OP.Cliente1=C.Codigo)) AND ")
SQL.ADD("      OP.Especie   = E.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
IF EqStr(VAR('LICILIBROS'),'SI')
   SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF','TCOPRI') AND ")
ELSE
   SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
ENDIF   
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      (OP.Mercado4 not in ("~Pipe2Comillas(VAR('MENEFFX')~"|"~VAR('MENEFTI')~"|"~VAR('AMBBYMA'))~") OR (OP.Mercado4 in ("~Pipe2Comillas(VAR('AMBBYMA'))~") AND (OP.NrBoleto2 = '' or OP.NrBoleto2 = ' ' or OP.NrBoleto2 IS NULL) )) AND ")
SQL.ADD("      OPB.NrBit IN (30,31) AND ")
SQL.ADD("      OPB.Valor = 1  ")
*SQL.ADD("and  OP.fechaOP='20220914' ")
SQL.ADD(" UNION ALL ")
