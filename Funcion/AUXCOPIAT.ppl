**-----------------------------------------------------**
** AUXCOPIAT - Copiativo Boletos  Función Auxiliar     **
**-----------------------------------------------------**

CrearFont(1, 'Arial,7,')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,8,B')
CrearFont(4, 'Arial,7,B')   

SetFilaActual(1)
ACN(zz1,FAC)

ACT(xx1,BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Vehiculo1))
ACN(xx2,Cotizacion('USD',,,,Dialogo.fecha1-1,1,SI))
ACT(xx3,BuscarCampo('CLIENTES','CUIT','Codigo',Dialogo.Vehiculo1))
ACT(xx4,BuscarCampo('CLIENTES','CodComitente','Codigo',Dialogo.Vehiculo1))

If Dialogo.Check1=1
ACT(j:FAC+1, val(xx1))
if Dialogo.Fecha2>Dialogo.Fecha1
  ACT(j:FAC+2, 'Registro de Operaciones desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
else
  ACT(j:FAC+2, 'Registro de Operaciones del '~Dialogo.Fecha1)
endif
AlinearCeldas(j:FAC+1..j:FAC+2,'C')

ACT(q:fac+2, 'Cotizacion USD: '~fstr(Val(xx2),0,8))

SetFilaActual(fac+4)

ACT(a:FAC, 'Boleto')
ACT(a:FAC+1, 'Nro Orden')
ACT(b:FAC, 'Nro Minuta')
ACT(b:FAC+1, 'Fecha Orden')
ACT(b:FAC+2, 'Ejecucion')
ACT(c:FAC, 'Fecha Op.')
ACT(c:FAC+1, 'Hora Orden')
ACT(c:FAC+2, 'Secuencia')
ACT(d:FAC, 'Fecha Liq.')
ACT(e:FAC, 'Tipo Op')
ACT(f:FAC, 'Plazo')
ACT(g:FAC, 'Nro Mercado')
ACT(h:FAC, 'Cliente - Razon Social')
ACT(h:FAC+1, 'CUIT - Comitente')
ACT(i:fac, 'Especie')
ACT(j:fac, 'Cantidad VN')
ACT(j:fac+2, 'Cantidad VN')
#ifdef MLASA
  ACT(k:fac, 'Precio/Tasa')
  ACT(k:fac+2, 'Precio/Tasa')
#else
  ACT(k:fac, 'Precio')
  ACT(k:fac+2, 'Precio')
#endif
ACT(l:fac, 'Importe Bruto')
ACT(m:fac, 'Intereses')
ACT(n:fac, 'Importe Neto')
ACT(o:fac, 'Comision')
ACT(o:fac+1, 'IVA Comision')
ACT(p:fac, 'Derechos')
ACT(p:fac+1, 'IVA Derechos')
ACT(q:fac, 'Gastos+IVA')
ACT(r:fac, 'Monto Total')
ACT(r:fac+2, 'Monto Total')

ACT(s:fac, ' Cupon')
ACT(t:fac, 'Age.')
ACT(u:fac, 'Oper.')
ACT(v:fac, 'Contr.')
ACT(w:fac, 'Moneda')
ACT(x:fac, 'Baja')
ACT(y:fac, 'Mercado')

*CUIT
*Plazo en dias
*Derechos
*orden-secuencia idem Boleto ???

AlinearCeldas(a:FAC..y:fac+2,'C')
AgregarMarco(a:FAC..y:fac+2,2)
SetFont(a:FAC..y:fac+2,2)

IFA
IFA
Endif
ACN(aa:1,FAC)

