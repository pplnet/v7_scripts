*** uso rango wa..wz

*-VTXT3
ACT(wa1,BuscarCampo('ESPECIES','InteresesC','Codigo',Val(va1)))

*-VCAN19
ACN(wa2, EspecieDiasAnio(Val(va1)))

*-VCAN20
ACN(wa3, EspecieDiasMes(Val(va1)))

*-VPRE2
ACN(wa4, IIF(Val(wa2)=0 y Val(wa3)=0,1,0) )

*-VPRE3
acn(wa5, BuscarCampo('ESPECIES','TasaIntVigente','Codigo',Val(va1)) )

*-VFEC1
acn(wa6, BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',Val(va1)) )

*-VFEC2
ACN(wa7, UltCupon2(Val(va1),Val(wa14)))

*-VFEC3
ACN(wa8, IIF(Val(wa3)=0 o EsHabil(Val(wa7),'USA'),Val(wa7),Habiles(Val(wa7),BuscarCampo('ESPECIES','Valor10','Codigo',Val(va1)),'USA')))

*-VPRE4
ACN(wa9, ((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',Val(va1))*IIF(Val(wa4)=1,Dif360(Val(wa8),Val(wa6)-1,2),DifDias(Val(wa8),Val(wa6)-1,'USA',NO)))+(Val(wa5)*(IIF(Val(wa4)=1,Dif360(Val(wa6)-1,Val(wa14),2),DifDias(Val(wa6)-1,Val(wa14),'USA',NO)))))/(IIF(Val(wa4)=1,Dif360(Val(wa8),Val(wa14),2),DifDias(Val(wa8),Val(wa14),'USA',NO))*100))

*-VPRE5
ACN(wa10, Val(wa5)*100)

*-VPRE6
ACN(wa11, IIF(Val(wa6)>Val(wa8) y Val(wa6)<=Val(wa14),Val(wa9),Val(wa10)) )

*-VPRE7
ACN(wa12, Val(wa11)*IIF(Val(wa4)=1,Dif360(Val(wa8),Val(wa14),2),DifDias(Val(wa8),Val(wa14),'USA',NO))/(DiasAnio2(Val(va1),UltCupon2(val(va1),FSYS),ProxCupon2(val(va1),FSYS))*100 ))


