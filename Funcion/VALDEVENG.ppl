*-ACN(co1,CotizacionC(FBN('Especie'),,,,Dialogo.Fecha1,1,SI,Val(me1)) )
ACN(co1,1)

*- hd1: Hasta donde Devengar
ACD(hd1,Dialogo.Fecha1+1)

If FBN['FechaVto']<val(hd1)
   ACD(hd1,FBN['FechaVto'])
EndIf

*--- Valua a devengado las operaciones para el informe de valuacion
ACN(i:fac,FBN['Tasa']+FBN['Spread'])
ACN(n:fac,FBN['TotalIntereses']*val(co1) )

*- Intereses -> Dev.Acumulado, Dev.Mes, a Devengar
IF Incluido(fbn('TipoOp'), 'CC|CCMV|FXREPO|FXREPV|GA|GAMV|MMCCR|MMCDIA|MMCDP|MMCP|MMCPM|MMD|MMDC|MMDCA|MMO|SEABD|SEABP|SERA|SERAV|SERP|SERPV|TEMIND|TEMINM|VIMIND|VIMINM')
   ACN(pe1,0)
   IF Incluido(fbn('TipoOp'), 'MMCCR')
      ACN(pe1,BuscarCampo('OPERACIONES','PeriodoInts','NrOperacion',val(a:fac)) )
   EndIf
   ***---El Day Account de la operacion es 360 o 365 => se aplica calculo de la operacion
   ***---CANTIDAD*(SPREAD+PRECIO1)*PLAZO/IF(RB8=1,36500,36000)
   ACN(p:fac, (fbn('Cantidad') -val(pe1))* (fbn('Spread') + fbn('Tasa')) * (Val(HD:1)-FBN['FechaOp'])/IIF(fbn('RB8') = 1, 36500, 36000))
   *- ACN(J:fac, (fbn('Cantidad') -val(pe1))* (fbn('Spread') + fbn('Tasa')) * (Val(HD:1)-PriDeMes(Dialogo.Fecha1,SI)) /IIF(fbn('RB8') = 1, 36500, 36000))
ELSE
   ACN(p:fac,val(d:fac)*(val(i:fac)/100)*FACTORDIAS(FBN['FechaOp'],val(hd1),FBN['RB8']+1))
   *- ACN(j:fac,val(d:fac)*(val(i:fac)/100)*FACTORDIAS(PriDeMes(Dialogo.Fecha1,SI),val(hd1),FBN['RB8']+1))
ENDIF

