FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA CONCERTACION NO HABIL EN TABLA SELECCIONADA';RB11 = 0;FSYS;
@VEHITO
Operador       :                              ;2;1;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1       : 'ContraParte'                ;3;1;;NOT EV;;NOVACIO(CLIENTE1);'EL CLIENTE NO ES VALIDO';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2      : 'Op.Contraparte'             ;3;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR CONTRAPARTE NO ES VALIDO';NO;;;

MB3            : 'Tipo|COMPRA |VENTA'         ;5;1;;NOT EV;;;;;0;
PrecioEj       : IF(MB1=0,'Cap','Floor')      ;;;;NOT EV;;PRECIOEJ<>0 Y PRECIOEJ>=VAR('RTASA1') Y PRECIOEJ<=VAR('RTASA2');'El '~IF(MB1=0,'Cap','Floor')~' esta fuera de rango:'~VAR('RTASA1')~' '~VAR('RTASA2');NO;
TablaFeriados1 : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'SE DEBE INDICAR FERIADOS A UTILIZAR';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
CB9            : 'Mark_To_Mkt'                ;;;;NO;NO;;;;0;

Cuotas1        : 'Cant_Sett'                  ;5;2;;;;CUOTAS1>=1;'La Cantidad de Settlements debe ser superior a 0';NO;
TotalNetoCli1  : 'Monto_Prima'                ;;;;;;TOTALNETOCLI1>=0;'Monto de la Prima Incorrecto';NO;;;
ContraEspecie  : 'Especie_Liq'                ;;;;NOT EV Y TOTALNETOCLI1<>0;TOTALNETOCLI1<>0;TOTALNETOCLI1=0 O [NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE)];'Debe ingresar una ContraEspecie';NO;;;;LeerObjeto('Monedas')
FechaVto       : 'Fecha_Prima'                ;;;;TOTALNETOCLI1<>0;TOTALNETOCLI1<>0;TOTALNETOCLI1=0 O ESHABIL(FECHAVTO,TABLAFERIADOS1);'FECHA PRIMA NO HABIL EN TABLA SELECCIONADA';NO;Habiles(FECHAOP,2,'ARG',SI);Habiles(FECHAOP,2,'ARG',SI)

CB7            : 'Ejercicio Swaption'         ;9;1;;NO;NO;;;;0

NrOperacion2   : 'Swtion Rel.'                ;;;;NO;CB7=1;;;;;

Especie        : 'Moneda'                     ;1;1;2;NOT EV;;NOVACIO(ESPECIE) y [DESCIENDEDEESPECIE(ESPECIE,'MONEDA') o EqStr(Especie,'ORO')] y ESTERMINAL(ESPECIE, ESPECIE);'DEBE INGRESAR UNA MONEDA DE VEHICULO VALIDA';NO;'USD';;;
RB8            : 'Day Count|ActAct|Act365F|Act360|360360|30E360' ;3;;2;;;;;;0;
PrecioRef2     : 'Fte_Ref'                    ;6;1;2;;;;;;;;
TipoTasa       : 'Tipo_Tasa'                  ;;;2;;;NOT EQSTR(TIPOTASA,'FIJA');'El Tipo de Tasa debe ser Variable';NO;;;
TotalAux3      : 'Notional Amount'            ;;;2;;;TOTALAUX3>=0;'Debe Ingresar el Vehiculo Notional Amount';NO;0;

PlazoRenovPredeter : 'Cot.Contable'           ;7 ;2;2;NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE);NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE);EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0;'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), 1))
RB11           : 'Ajuste|NO|SI'               ;10;1;2;;;;;;1;
VCAN12         : 'Cotizacion de Mercado'      ;18;2;2;No;No;;;;;COTIZACIONC(COTIZAEN(ESPECIE),,,,FECHAOP,1,SI,CONTRAESPECIE))

Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
VPRE5          : 'Cot.ESP/USD'                ;10;3;;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))
VPRE6          : 'Cot.CONTESP/USD'            ;10;3;;NO;NO;;;;;COTIZACIONC(CONTRAESPECIE,,,,Fsys,1,SI,VAR('MONEEXTR'))

@CUENTAS
@CUENTAS2
@DTREFER

LISTA:SI;IF(ESINICIO,100,CUOTAS1);
 Fecha1    : 'CF_Ini'          ;NO;NO;;;;CUOTASL.FECHA5[Fila];90;;Fecha
 Plazo1    : 'CF_Plazo'        ;NO;NO;;;;CUOTASL.PLAZO2[Fila];60;;Numero;'####'
 Fecha2    : 'CF_Fin '         ;NO;NO;;;;CUOTASL.FECHA6[Fila];90;;Fecha

 Cantidad6 : 'CF_Imp_Amor'     ;NO;NO;;;;CUOTASL.CANTIDAD5[Fila];200;;Numero;'###,###,###,###.##';NO;NO;
 Cantidad1 : 'CF_Notional'     ;NO;NO;;;;CUOTASL.CANTIDAD2[Fila];200;;Numero;'###,###,###,###,###.##'
 Precio1   : 'CF_Tasa'         ;NO;NO;;;IF(CUOTASL.PRECIO2[Fila]<>0 y [[CUOTASL.PRECIO2[Fila]>PRECIOEJ y MB1=0] o [CUOTASL.PRECIO2[Fila]<PRECIOEJ y MB1=1]],PRECIOEJ,CUOTASL.PRECIO2[Fila]);IF(CUOTASL.PRECIO2[Fila]<>0 y [[CUOTASL.PRECIO2[Fila]>PRECIOEJ y MB1=0] o [CUOTASL.PRECIO2[Fila]<PRECIOEJ y MB1=1]],PRECIOEJ,CUOTASL.PRECIO2[Fila]);100;;Numero;'###,###.######';NO;NO;'8'

 Total3    : 'CF_Spread'       ;NO;NO;;;;CUOTASL.TOTAL4[Fila];100;;Numero;'###,###.######';NO;NO;'8'
 Cantidad3 : 'CF_Interes'      ;EV;NO;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2)<=ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Vehiculo Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'6;7'
 Fecha3    : 'CF_Settlement'   ;NO;NO;;;;CUOTASL.FECHA7[Fila];90;NO;Fecha;;NO

 Fecha5    : 'Ini'              ;;;ESHABIL(CUOTASL.FECHA5[Fila],TABLAFERIADOS1);'La Fecha de Inicio de la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA6[Fila-1]);IF(Fila=1,CUOTASL.FECHA5[Fila],CUOTASL.FECHA6[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo2    : 'Plazo'            ;;;CUOTASL.PLAZO2[Fila]>=0;'El PLAZO ContraParte DEBE SER POSITIVO ';IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.PLAZO2['~Fstr(Fila,1,0)~']'),CUOTASL.PLAZO2[Fila],CUOTASL.PLAZO1[Fila]);CUOTASL.FECHA6[Fila]-CUOTASL.FECHA5[Fila];60;;Numero;'####';;;'12'
 Fecha6    : 'Fin'              ;;;CUOTASL.FECHA6[Fila]>=CUOTASL.FECHA5[Fila] Y ESHABIL(CUOTASL.FECHA6[Fila],TABLAFERIADOS1);IF(CUOTASL.FECHA6[Fila] < CUOTASL.FECHA5[Fila], 'La Fecha de Vencimiento debe ser mayor a la Fecha de Inicion', 'La Fecha de Vencimiento de la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL');;CUOTASL.FECHA5[Fila]+CUOTASL.PLAZO2[Fila];90;;Fecha;;;;;;;;RB11 = 0

 Cantidad5 : 'Imp_Amor'         ;NOT EV;;CUOTASL.CANTIDAD5[Fila]>=0;'El Importe Amortizacion de la ContraParte debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALAUX3,0);IF(Fila=CUOTAS1,TOTALAUX3,0);200;;Numero;'###,###,###,###.##';NO;NO;'14'
 Cantidad2 : 'Notional'         ;NOT EV;;CUOTASL.CANTIDAD2[Fila]>=0;'EL NOTIONAL AMMOUNT DE LA CONTRAPARTE ES INCORRECTO';IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1]);IF(Fila=1,TOTALAUX3,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1]);200;;Numero;'###,###,###,###,###.##';NO;NO;'13'
 Precio2   : 'Tasa'             ;;;CUOTASL.PRECIO2[Fila]=0 O [CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2')];'La Tasa de la Contraparte ESTA FUERA DE RANGO:'~VAR('RTASA1')~' '~VAR('RTASA2');;;100;;Numero;'###,###.######';NO;NO;'17'

 Total4    : 'Spread'           ;;;CUOTASL.TOTAL4[Fila]=0 O [CUOTASL.TOTAL4[Fila]>=VAR('RSPREAD1') Y CUOTASL.TOTAL4[Fila]<=VAR('RSPREAD2')];'El Spread de la Contraparte esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;;100;;Numero;'###,###.######';NO;NO;'17'
 Cantidad4 : 'Interes'          ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Contraparte Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA5[Fila],CUOTASL.FECHA6[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'15;16'
 Fecha7    : 'Settlement'       ;;;ESHABIL(CUOTASL.FECHA7[Fila],TABLAFERIADOS1);'FECHA SETTLEMENT ContraParte NO HABIL EN TABLA SELECCIONADA';;IF(EQSTR(CAMPOMODIFICADO,'CUOTASL.FECHA7['~Fstr(Fila,1,0)~']'),CUOTASL.FECHA7[Fila],CUOTASL.FECHA6[Fila]);90;NO;Fecha;;NO

 Fecha4    : 'Reset'            ;;;ESHABIL(CUOTASL.FECHA4[Fila],BuscarCampo('FERIADOS','Codigo','Codigo',BuscarCampo('ESPECIES','PaisOrigen','Codigo',BuscarCampo('TIPOSTASA','EspecieValida','Codigo',TIPOTASA))));'FECHA RESET DEBE SER HABIL EN TABLA DE '~BuscarCampo('FERIADOS','Descripcion','Codigo',BuscarCampo('ESPECIES','PaisOrigen','Codigo',BuscarCampo('TIPOSTASA','EspecieValida','Codigo',TIPOTASA))));if(EV o Not EqStr('A',ABM),CUOTASL.FECHA4[Fila],HABILES(CUOTASL.FECHA1[Fila],-2,TABLAFERIADOS1,SI));if(EV o Not EqStr('A',ABM),CUOTASL.FECHA4[Fila],HABILES(CUOTASL.FECHA1[Fila],-2,TABLAFERIADOS1,SI));90;NO;Fecha;;NO;;;;;;RB11 = 0

 Total2    : 'Resultado'        ;NO;;;;;IF(CUOTASL.PRECIO1[Fila]=0 O CUOTASL.PRECIO2[Fila]=0,0,IF(MB1=0,-CUOTASL.CANTIDAD3[Fila]+CUOTASL.CANTIDAD4[Fila],CUOTASL.CANTIDAD3[Fila]-CUOTASL.CANTIDAD4[Fila]));200;;Numero;'###,###,###,###,###.##';SI;
 Check1    : 'Ejercio?'         ;NO;;;;;IF(CUOTASL.PRECIO1[Fila]=0 O CUOTASL.PRECIO2[Fila]=0,0,1);50;NO;Check

 Precio5   : 'V MOD INT'        ;NO;NO;;;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);;200;;Numero;'###.######'
 Precio6   : 'C MOD INT'        ;NO;NO;;;IF(CUOTASL.PRECIO2[Fila]>0,((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA5[Fila],CUOTASL.FECHA6[Fila],RB5+1),0);;200;;Numero;'###.######'
 Cantidad8 : 'Exposicion MM'    ;NO;NO;;;;;100;;Numero;'###,###,###,###.##'
 Check10   : 'Est.'             ;  ;  ;CUOTASL.CHECK10[Fila] = 0;'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' Es Simulada';0;;50;;Check;;;;;;;;SI
 Precio3   : 'CtaModiInteres'   ;NO;NO;;;;IF(Round(QUERY("SELECT Cantidad3 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~NROPERACION~"' and NrCuota="~Fstr(Fila,0,0)~" "),2)<>Round(CUOTASL.CANTIDAD3[Fila],2),Fila,0);100;;Numero;'###'

CONDICIONES
SUM(CUOTASL,13)=TOTALAUX3;'El Imp. de Amortizacion de la ContraParte debe ser igual que el Notional Amount Contraparte';NO
ESHABIL(FECHAOP,'ARG');'LA FECHA DE CONCERTACION NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'COINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta  Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
Vacio(CONTRAESPECIE) O EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
ESTERMINAL(VEHICULO2,VEHICULO);'El Vehiculo ContraParte debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO2')/100);'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);NO
Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VCAN12*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VCAN12*(1-VAR('RPRECIO') /100);'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'




EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

@POSTEDT

