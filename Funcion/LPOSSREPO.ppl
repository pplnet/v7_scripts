**-- Selecciono aquellos repos que alguna pata esta activa
SQL.ADD("Select O.*,E.VTeorico,E.InteresesC,E.Cotiza  ")  
SQL.ADD("from "~DBO~".OPERACIONES O,"~DBO~".ESPECIES E ")
SQL.ADD("where O.Especie=E.Codigo ")
SQL.ADD("and O.Especie = '"~fbn('Codigo')~"' ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 in ("~Val(z11)~")")
endif
SQL.ADD(" and  FechaOp2<= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  (FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' or FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" and  TipoOp In ('SERA','SERAV','SERP','SERPV') ") 
SQL.ADD(" Order By NrOperacion ")
 
ACN(y1,0)

Recorrer SQL
   dfa
   ACN(z3, FBN['Cantidad'])

   If Incluido(FBN['TipoOp'],'SERA|SERAV')
      ACN(z3,-val(z3))
   EndIf

   SCN(z8, Val(z3))
   Message(' Display de Repos Activos y Pasivos '~val(z8))
Proximo
