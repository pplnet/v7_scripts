ELSE
    SQL.ADD(" AND P.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND P.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and P.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and P.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" AND O.TipoOp IN ('DTCAP','DTFLO') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha3 >= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF Dialogo.Fecha3 <> 0
    SQL.ADD(" AND C.Fecha3 <= '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
*SQL.ADD(" AND C.Total2 > 0 ")
SQL.ADD(" AND O.OperacionRef = P.NrOperacion ")
SQL.ADD(" AND P.TipoOp = 'MMPLME' ")
SQL.ADD(" AND P.Especie = '"~Var('MONEEXTR')~"' ")
