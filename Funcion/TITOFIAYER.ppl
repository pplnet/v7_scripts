**-Busco casos informados ayer que hoy no se hayan informado para insertarlos en la tabla con fecha de hoy-**
let &seInformoHoy 0

SQl.ADD("SELECT TA.* FROM "~DBO~"."~&tablaInformada~" TA ")
SQL.ADD("JOIN "~DBO~".OPERACIONES O ON TA.NrOperacion = O.NrOperacion ")
SQL.ADD("where TA.FecIncorporacion = '"~Idxdate(Habiles(&fechaProceso,-1,'ARG',SI))~"' ")
SQL.ADD("AND TA.TipoRegistro='A' ")
SQL.ADD("AND O.FechaVto > '"~Idxdate(&fechaProceso)~"' ")

Recorrer SQL
    let &seInformoHoy Iif(Vacio(SQL("SELECT 1 FROM "~DBO~"."~&tablaInformada~" TH WHERE TH.FecIncorporacion = '"~Idxdate(&fechaProceso)~"' AND TH.CuentaContable = '"~fbn('CuentaContable')~"' AND TH.NrOperacion = '"~fbn('NrOperacion')~"' AND TH.TipoRegistro = 'A' ")),0,1)
    
    If &seInformoHoy = 0
        let &especieDeCorte         fbn('Especie')
        let &tipoCupon              fbn('TipCupon')
        let &CuentaContable         fbn('CuentaContable')
        let &valorResidual          fbn('ValorResidual')
        let &valorContable          fbn('ValorContable')
        let &valorContableValuado   fbn('ValorContValuado') 
        *let &fechaProceso           val(FV:1)
        let &tipoRegistro           fbn('TipoRegistro')
        let &nrOperacion            fbn('NrOperacion')
        let &precioNiif             fbn('Cotizacion')
        let &cuentaCustodia         fbn('CuentaCustodia')
        let &informaFecInc          fbn('InformaFecInc')
        
        **-inserto datos en DETITOFIN-**
        SQL.ADD("INSERT INTO "~DBO~"."~&tablaInformada~" ( ")
        SQL.ADD("Fecha, Especie, TipCupon, CuentaContable, ValorResidual, ")
        SQL.ADD("ValorContable, ValorContValuado, FecIncorporacion, ")
        SQL.ADD("TipoRegistro, NrOperacion, Cotizacion, CuentaCustodia, InformaFecInc ) ")
        SQL.ADD("VALUES ( ")
        SQL.ADD("'"~Idxdate(val(FV:1))~"','"~&especieDeCorte~"', "~Fstr(&tipoCupon, 0, 0)~",'"~&cuentaContable~"',"~Fstr(&valorResidual, 0, 0)~", ")
        SQL.ADD(" "~Fstr(&valorContable, 0, 0)~", "~Fstr(&valorContableValuado, 0, 2)~", '"~Idxdate(&fechaProceso)~"', ")
        SQL.ADD("'"~&tipoRegistro~"', '"~&nrOperacion~"', "~Fstr(&precioNiif, 0, 8)~", '"~&cuentaCustodia~"', '"~&informaFecInc~"') ")
        SQL.NEW
        SQL.EXEC 
    EndIf
