scn(c:200,1)
scn(d:200,1)
SQL.ADD("Select S.Cliente, S.EnteCustodia, S.Especie, S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo/1000 Saldo, ")
SQL.ADD("E.Tipo, E.Cotiza,E.InteresesC,E.VTeorico ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where   S.Especie = E.Codigo ")
SQL.ADD("and     S.NrSaldo = 2 ")
SQL.ADD("and    (S.CallPut is Null or S.CallPut = '') ")
SQL.ADD("and     S.Cliente = S.EnteCustodia ")
SQL.ADD("and     E.Tipo Not In ('FON') ")
SQL.ADD("and     S.EnteCustodia In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD("and     S.Especie Not In ("~val(en1)~") ")
SQL.ADD("and     S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    (D.CallPut is Null or D.CallPut = '') ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by S.Cliente, S.Especie ")

act(u:200,' ')

Recorrer SQL

  Message(fbn['Especie']~' '~fbn['Tipo'])

  if Not EqStr(val(u:200),fbn['EnteCustodia'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['EnteCustodia'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['EnteCustodia'])
  endif

  *- cs1: Obtengo el precio sucio 
  act(x96,FBN['Especie'])
  acd(x97,Dialogo.Fecha1)
  acn(x94,FBN['VTeorico'])
  acn(x93,FBN['Saldo'])

  act(x92,FBN['InteresesC'])

  (.'SUCIOPOSF2'.)

  if Incluido(fbn['Tipo'],'PUB')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200),fbn['Saldo']*val(cs1))
        scn(val(e:200):val(h:200),fbn['Saldo']*val(cs1))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        scn(val(e:200):val(d:200),fbn['Saldo']*val(cs1))
        scn(val(e:200):val(k:200),fbn['Saldo']*val(cs1))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif
  endif
  if Incluido(fbn['Tipo'],'PRI|ONE')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200)+1,fbn['Saldo']*val(cs1))
        scn(val(e:200):val(h:200),fbn['Saldo']*val(cs1))
        SetFont(val(e:200):val(c:200)+1..val(e:200):val(c:200)+1,3)
     else
        scn(val(e:200):val(d:200)+1,fbn['Saldo']*val(cs1))
        scn(val(e:200):val(k:200),fbn['Saldo']*val(cs1))
        SetFont(val(e:200):val(d:200)+1..val(e:200):val(d:200)+1,3)
     endif
  endif
  scn(val(e:200):val(t:200),fbn['Saldo']*val(cs1))
  scn(b:val(t:200),fbn['Saldo']*val(cs1))
  SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
proximo

scn(f:200,1)
scn(g:200,1)

*- Repos Activo y Pasivos 

SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, E.Cotiza, O.Vehiculo2,E.Tipo, O.ContraEspecie, E.VTeorico,E.InteresesC, ")
SQL.ADD("Sum(O.Cantidad)/1000 Cant,Sum(O.TotalBrutoCli2)/1000 Monto from "~DBO~".OPERACIONES  O, "~DBO~".ESPECIES E  ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('SERA','SERAV','SERP','SERPV') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, E.Cotiza, O.Vehiculo2,E.Tipo, O.ContraEspecie,E.VTeorico,E.InteresesC  ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL

  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  *- cs1: Obtengo el precio sucio 
  act(x96,FBN['Especie'])
  acd(x97,Dialogo.Fecha1)
  acn(x94,FBN['VTeorico'])
  acn(x93,FBN['Cant'])
  act(x92,FBN['InteresesC'])

  (.'SUCIOPOSF2'.)


  *-- Titulos Publicos y Privados
  ACN(bb1,fbn['Cant'])  
  If Incluido(Fbn['TipoOp'],'SERA|SERAV')
     ACN(bb1,-fbn['Cant'])  
  EndIf

  if Incluido(fbn['Tipo'],'PUB')     
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200),val(bb1)*val(cs1))
        scn(val(e:200):val(h:200),val(bb1)*val(cs1))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        scn(val(e:200):val(d:200),val(bb1)*val(cs1))
        scn(val(e:200):val(k:200),val(bb1)*val(cs1))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif
  endif
  if Incluido(fbn['Tipo'],'PRI|ONE')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200)+1,val(bb1)*val(cs1))
        scn(val(e:200):val(h:200)  ,val(bb1)*val(cs1))
        SetFont(val(e:200):val(c:200)+1..val(e:200):val(c:200)+1,3)
     else
        scn(val(e:200):val(d:200)+1,val(bb1)*val(cs1))
        scn(val(e:200):val(k:200)  ,val(bb1)*val(cs1))
        SetFont(val(e:200):val(d:200)+1..val(e:200):val(d:200)+1,3)
     endif
  endif
  scn(val(e:200):val(t:200),val(bb1)*val(cs1))
  scn(b:val(t:200)         ,val(bb1)*val(cs1))
  SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)

  *-- Titulos Vendidos y Comprados a Futuro (+) Titulos Comprados a Futuro => val(c:200)+2 y val(d:200)+2  (+) Titulos Vendidos a Futuro=> val(f:200) y val(g:200)
  ACN(bb1,fbn['Cant'])  

  if Incluido(fbn['TipoOp'],'SERA|SERAV')     
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200)+2,val(bb1)*val(cs1))
        scn(val(e:200):val(h:200)  ,val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(c:200)+2,val(bb1)*val(cs1))
              scn(b:val(h:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(c:200)+2..val(e:200):val(c:200)+2,3)
     else
        scn(val(e:200):val(d:200)+2,val(bb1)*val(cs1))
        scn(val(e:200):val(k:200)  ,val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(d:200)+2,val(bb1)*val(cs1))
              scn(b:val(k:200)  ,val(bb1)*val(cs1))
           endif
        endif        
        SetFont(val(e:200):val(d:200)+2..val(e:200):val(d:200)+2,3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(t:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     else
        scn(val(e:200):val(x:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(x:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
  if Incluido(fbn['TipoOp'],'SERP|SERPV')    
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(f:200),val(bb1)*val(cs1))
        scn(val(e:200):val(i:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(f:200),val(bb1)*val(cs1))
              scn(b:val(i:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
     else
        scn(val(e:200):val(g:200),val(bb1)*val(cs1))
        scn(val(e:200):val(l:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(g:200),val(bb1)*val(cs1))
              scn(b:val(l:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(v:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
     else
        scn(val(e:200):val(w:200),val(bb1)*val(cs1))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(w:200),val(bb1)*val(cs1))
           endif
        endif
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
  endif

  *- Cotizacion
  ACN(zz2, 1)

  If Not EqStr(fbn['ContraEspecie'],Val(me1))
     ACN(zz2, CotizacionC(fbn['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
  EndIf

  *-- (+) Creditos por Liquidacion Titulos Valores => val(c:200)+3 y val(d:200)+3 
  *-- (+)Deuda Por Liquidacion Titulos Valores    => val(f:200)+1 y val(g:200)+1 
  *-- Estos items tienen en cuenta el Monto Futuro y la ContraEspecie
  ACN(bb1,fbn['Monto'])  

  if Incluido(fbn['TipoOp'],'SERP|SERPV')     
     If Incluido(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn['ContraEspecie']),'ARP')
        scn(val(e:200):val(c:200)+3,val(bb1)*Val(zz2))
        scn(val(e:200):val(h:200)  ,val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(c:200)+3,val(bb1)*Val(zz2))
              scn(b:val(h:200)  ,val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(c:200)+3..val(e:200):val(c:200)+3,3)
     else
        scn(val(e:200):val(d:200)+3,val(bb1)*Val(zz2))
        scn(val(e:200):val(k:200)  ,val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(d:200)+3,val(bb1)*Val(zz2))
              scn(b:val(k:200)  ,val(bb1)*Val(zz2))
           endif
        endif        
        SetFont(val(e:200):val(d:200)+3..val(e:200):val(d:200)+3,3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(t:200),val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     else
        scn(val(e:200):val(x:200),val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(x:200),val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif

  if Incluido(fbn['TipoOp'],'SERA|SERAV')    
     If Incluido(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn['ContraEspecie']),'ARP')
        scn(val(e:200):val(f:200)+1,val(bb1)*Val(zz2))
        scn(val(e:200):val(i:200)  ,val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(f:200)+1,val(bb1)*Val(zz2))
              scn(b:val(i:200)  ,val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(f:200)+1..val(e:200):val(f:200)+1,3)
     else
        scn(val(e:200):val(g:200)+1,val(bb1)*Val(zz2))
        scn(val(e:200):val(l:200)  ,val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(g:200)+1,val(bb1)*Val(zz2))
              scn(b:val(l:200)  ,val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(g:200)+1..val(e:200):val(g:200)+1,3)
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(v:200),val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
     else
        scn(val(e:200):val(w:200),val(bb1)*Val(zz2))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(w:200),val(bb1)*Val(zz2))
           endif
        endif
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
  endif
proximo

