* -----> Edicion Del Numero De CUIT

* ZB:10 ==> Valor A Editar
* ZB:11 ==> Tipo
* ZB:12 ==> Valor Devuelto con Leyenda

* ZB:13 ==> Valor (sin leyenda)
* ZB:14 ==> Leyenda(Tipo)

If [NoVacio(Val(ZB:11))]
   If [EqStr(Val(ZB:11), "CIT")]
      ACT(ZB:12, " CUIT: ")
   Else
      If [EqStr(Val(ZB:11), "CIL")]
         ACT(ZB:12, " CUIL: ")
      Else
         If [EqStr(Val(ZB:11), "CDI")]
            ACT(ZB:12, " CDI: ")
         Else
            ACT(ZB:12, " Otros: ")
         EndIf
      EndIf
   EndIf
Else
   ACT(ZB:12, " CUIT/CUIL/CDI: ")
EndIf
ACT(ZB:14, Val(ZB:12))


If [NoVacio(Val(ZB:10))]
   If [[EqStr(Copy(Val(ZB:10), 03, 01), '-')] y [EqStr(Copy(Val(ZB:10), 12, 01), '-')]]
      ACT(ZB:12, Val(ZB:12) ~ Val(ZB:10))
      ACT(ZB:13, Val(ZB:10))
   Else        
      ACT(ZB:12, Val(ZB:12) ~ Copy(Val(ZB:10), 01, 02) ~ '-' ~ Copy(Val(ZB:10), 03, 08) ~ '-' ~ Copy(Val(ZB:10), 11, 01))
      ACT(ZB:13, Copy(Val(ZB:10), 01, 02) ~ '-' ~ Copy(Val(ZB:10), 03, 08) ~ '-' ~ Copy(Val(ZB:10), 11, 01))
   EndIf
EndIf

