*** Toma las transacciones con fecha mayor a la posicion y menor o igual a hoy           ***
*** y las fallas del dia de posicion o anteriores que tengan movimientos pendientes      ***
*** Las marca como con corte y modifica sus movimientos ejecutados o pendientes (fallas) ***
*** SQL.ADD("and T.Vehiculo1 = '"~Val(j2)~"' ")
*** SQL.ADD("and T.Vehiculo1 = '"~Val(j2)~"' ")

Message('Transacciones con fecha mayor a la posicion ...')

SQL.ADD("SELECT T.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T,"~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = T.NrTrans ")
SQL.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and (T.PrecioEj is Null or T.PrecioEj = 0) ") 
SQL.ADD("and T.TipoTr2 Not In ('CUPON') ")
SQL.ADD("and T.NrTrans   = B.NrOperacion ")
SQL.ADD("and B.NrBit=7 and B.Valor='1'  ") 
SQL.ADD("Union ")
SQL.ADD("SELECT T.* ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where T.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and T.TipoTr2 Not In ('CUPON') ")
SQL.ADD("and T.Fecha1>'"~IdxDate(Val(g2))~"' ")
SQL.ADD("and T.NrTrans= B.NrOperacion ")
SQL.ADD("and B.NrBit=7 and B.Valor='1'  ") 

SetFilaActual(10)
Recorrer SQL
   act(a:fac,fbn['NrTrans'])

   *** Las opciones no pasan los cupones y modifican su precio de ejercicio ***
   SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("Set Especie2 = '"~Dialogo.ContraEspecie2~"', ")
   SQL.ADD("    Fecha3 = '"~IdxDate(Val(g2))~"', CB10 = '1' ")
   SQL.ADD("where  NrTrans = '"~Val(a:fac)~"' ")
   SQL.NEW

   SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
   SQL.ADD("(Especie, Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia )")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia ")
   SQL.ADD(" from "~DBO~".MOVPENDIENTES where nrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW

   SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("(Especie, Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia )")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia ")
   SQL.ADD(" from "~DBO~".MOVEJECUTADOS where nrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW

   SQL.ADD("INSERT INTO "~DBO~".MOVLIMITES ")
   SQL.ADD("(Especie, Cliente, Limite, FechaLim, Monto, ")
   SQL.ADD(" FechaMov, NrOperacion, Bits) ")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Limite, FechaLim, Monto, ")
   SQL.ADD(" FechaMov, NrOperacion, Bits ")
   SQL.ADD(" from "~DBO~".MOVLIMITES where nrOperacion = '"~Val(a:fac)~"' and Especie = '"~Dialogo.Especie1~"' ")
   SQL.NEW
   SQL.EXEC
