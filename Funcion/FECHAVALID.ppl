*********************************************************************
* FECHAVALID
*
* Validacion de fecha 
*
* Argumentos
*
*   Entrada
*      FE:1      = Fecha formato dd/mm/yyyy
*      FE:2      = 0 -> No valida yyyy no menor a A¥O CORRIENTE
*                  1 -> Valida    yyyy no menor a A¥O CORRIENTE
*   Salida
*      YA:1      = DIA caracter
*      YA:2      = MES caracter
*      YA:3      = A¥O caracter
*      YA:4      = Mensaje de error
*
*      YB:1      = DIA numerico
*      YB:2      = MES numerico
*      YB:3      = A¥O numerico
*
*      FE:1      = Espacios  si la fecha es erronea
*      FE:1      = dd/mm/yyy si la fecha esta OK
*
*********************************************************************
ACT(ya:1, PAD0(Copy(VAL(fe:1),1,2),2) )
ACT(ya:2, PAD0(Copy(VAL(fe:1),4,2),2) )
ACT(ya:3, PAD0(Copy(VAL(fe:1),7,4),4) )
*
If EsNumero(VAL(ya:1)) y EsNumero(VAL(ya:2)) y EsNumero(VAL(ya:3))
   
   ** -- Transformo a numeros los datos
   ACN(yb:1, NUM(VAL(ya:1)) )
   ACN(yb:2, NUM(VAL(ya:2)) )
   ACN(yb:3, NUM(VAL(ya:3)) )

   ** -- Control del a¤o   
   IF VAL(fe:2) = 0 o [ VAL(fe:2) = 1 y VAL(yb:3) >= ANIO(FSYS) ]
      
      ** -- Control de Mes
      If VAL(yb:2) > 12 o VAL(yb:2) < 1
         ACT(ya:4, 'ERROR MES FUERA DE RANGO ' ) 
         ACT(fe:1, '          ' ) 
      Else
         ** -- Control de Dia
         If VAL(yb:2) = 2 
            If Bisiesto(VAL(yb:3)) = 1 
               If VAL(yb:1) > 29 o VAL(yb:1) < 1 
                  ACT(ya:4, 'ERROR DIA FEB/BISIESTO' )
                  ACT(fe:1, '          ' )
               EndIf
            Else
               If VAL(yb:1) > 28 o VAL(yb:1) < 1
                  ACT(ya:4, 'ERROR DIA FEB/NO BISIESTO' )
                  ACT(fe:1, '          ' )
               EndIf
            EndIf   
         Else
            ** -- Meses de 31 dias
            If VAL(yb:2) = 1 o VAL(yb:2) = 3 o VAL(yb:2) = 5 o VAL(yb:2) = 7 o VAL(yb:2) = 8 o VAL(yb:2) = 10 o VAL(yb:2) = 12
               If VAL(yb:1) > 31 o VAL(yb:1) < 1
                  ACT(ya:4, 'ERROR DIA MES/31' )
                  ACT(fe:1, '          ' )
               EndIf
            Else
               ** -- Meses de 30 dias
               If VAL(yb:1) > 30 o VAL(yb:1) < 1
                  ACT(ya:4, 'ERROR DIA MES/30' )
                  ACT(fe:1, '          ' )
               EndIf
            EndIf
         Endif   
      EndIf
   Else
      If VAL(fe:2) = 1 y VAL(yb:3) < ANIO(FSYS)
         ACT(ya:4, 'ERROR A¥O MENOR QUE A¥O CORRIENTE' )
         ACT(fe:1, '          ' )
      EndIf
   EndIf
Else
   ACT(ya:4, 'ERROR GENERAL DE FECHA' ) 
Endif 
