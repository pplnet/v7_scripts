SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".BOOKS BO, "~DBO~".VEHICULOS V  ")
SQL.ADD("where O.NrOperacion=B.NrOperacion ")
SQL.ADD("and   O.Book1=BO.Codigo ")
SQL.ADD("and   O.Vehiculo1=V.Codigo ")
SQL.ADD("and B.NrBit=30 and B.Valor=0  ")
SQL.ADD("and O.NrOperacion=M.NrOperacion ")
SQL.ADD("and C.Codigo = O.Cliente1  ")
SQL.ADD("and Not (O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"') and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and  M.NrTrans2 In ")
SQL.ADD(" ( ")
SQL.ADD(" Select NrTrans from "~DBO~".TRANSACCIONES2 T,"~DBO~".MOVPENDIENTES MP  where T.TipoTr2 in ('DEP','RET','COMP','MATCH','TRANSP')  and T.CB3 = '1'  and ")
SQL.ADD(" (T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and I.NrOperacion like 'V%' ) or (T.CB9 = '0' or T.CB9 is NUll) )  ")
SQL.ADD(" and ((T.NrTransRef1=MP.NrOperacion and T.Mercado1 Not In ('CV','AC','CRYL','EU')) or (T.NrTrans=MP.NrOperacion and T.Mercado1  In ('CV','AC','CRYL','EU')) ) ")
SQL.ADD(" ) ")
SQL.ADD(" and  M.NrOperacion <> M.NrTrans2 ")
