SQL.ADD(" Select Codigo from "~DBO~".CLIENTES ")
SQL.ADD(" Where Codigo not in ("~Pipe2Comillas(Descendientes('CLIENTES','SERVICIOS'))~") ")
SQL.ADD("   and Codigo not in ("~Pipe2Comillas(Descendientes('CLIENTES','EMPRESAS'))~") ")
SQL.ADD("   and Status = 'HAB' ")
