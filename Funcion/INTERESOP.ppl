TotalIntereses    : 'Interes'        ; 17;2; 2;NO;Eqstr(VTXT20,'CLE');;;;;IF(Eqstr(VTXT20,'CLE'),IF(VPRE11=0, VPRE10*CANTIDAD*TASAINTERESESCUPON/DIASA(VCAN19,FSYS)/100*IF(VCAN19=0 y VCAN10=0, Dif360(FECHAULTCUPON,FECHAVTO,2), DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO)),(TOTALAUX3+TOTALAUX4)),0)

