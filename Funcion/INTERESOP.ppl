TotalAux3         : 'Ints.Capitaliz.'; 7;1;2;NO;NO;;;;;IF(BuscarCampo('ESPECIES','Tasa1','Codigo',ESPECIE) > 0,CANTIDAD*(VPRE6+BuscarCampo('ESPECIES','IntsCapitalizados','Codigo', Especie))*VPRE10*PRECIO1*IF(VCAN19=0 y VCAN10=0, Dif360(FECHAULTCUPON,FECHAVTO,2),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO))*BuscarCampo('ESPECIES','Tasa1','Codigo',ESPECIE)/IF(VCAN19=0, 360, IF(VCAN19=1, 365,DIASA(2,FSYS))))
TotalAux4         : 'Ints.a Pagar'   ; 7;2;2;NO;NO;;;;;IF(BuscarCampo('ESPECIES','Tasa1','Codigo',ESPECIE) > 0, CANTIDAD*(VPRE6+BuscarCampo('ESPECIES','IntsCapitalizados','Codigo', Especie))*VPRE10*IF(VCAN19=0 y VCAN10=0, Dif360(FECHAULTCUPON,FECHAVTO,2), DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO))*(BuscarCampo('ESPECIES','TasaIntVigente','Codigo', Especie)-BuscarCampo('ESPECIES','Tasa1','Codigo', Especie))/IF(VCAN19=0, 360, IF(VCAN19=1, 365,DIASA(2,FSYS))))

