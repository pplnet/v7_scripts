TasaInteresesCupon: 'Tasa (%)'       ; 6;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(VFEC1>FECHAULTCUPON y VFEC1<=FECHAVTO,((VPRE7*IF(VCAN19=0 y VCAN10=0,Dif360(FECHAULTCUPON,VFEC1-1,2),DifDias(FECHAULTCUPON,VFEC1-1,'USA',NO)))+(VPRE8*(IF(VCAN19=0 y VCAN10=0,Dif360(VFEC1-1,FECHAVTO,2),DifDias(VFEC1-1,FECHAVTO,'USA',NO)))))/(IF(VCAN19=0 y VCAN10=0,Dif360(FECHAULTCUPON,FECHAVTO,2),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO))),TASABASE)*100;
