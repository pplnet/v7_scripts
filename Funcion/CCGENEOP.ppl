*****************************************************************************************
**- CCGENEOP
*****************************************************************************************
**- Actualizo las Operaciones segun el tipo de operacion
* MessageBox('En fc. ccgeneop ')

**- Genera la transaccion pago de cupon ***
*-- AA1=MB3=> 1:Pago 0: Cobro
act(aa1,'0')

IF Incluido(VAL(e:val(w1)),'SERP|SERPV') o VAL(d:val(w1))<0
   act(aa1,'1')
ENDIF

**-- Obtengo el numerador para la transaccion.
Message('Generando Operacion de Corte '~VAL(b:val(w1))~' '~FStr(VAL(n:val(w1)),0,0))

ACT(Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Val(c:val(w1))))) 

* Z4: MB4 0:Spot 1: Futuro 2: Repo 3: Saldo 4: Posicion
ACT(Z4,'0')

IF Incluido(Copy(VAL(b:val(w1)),1,3),'POS')
   ACT(Z4,'1')
EndIf

IF Incluido(VAL(b:val(w1)),'SERA|SERAV|SERP|SERPV')
   ACT(Z4,'2')
EndIf

IF Incluido(Copy(VAL(b:val(w1)),1,3),'SAL')
   ACT(Z4,'3')
EndIf

SQL.ADD(" INSERT INTO "~DBO~".OPERACIONES ")
SQL.ADD(" (TipoOp, MB3, NrOperacion, ContraEspecie2, Cliente1, ")
SQL.ADD(" Cantidad,FechaOp, FechaPago, FechaCargaSys, FechaCarga, ")
SQL.ADD(" Vehiculo1, Spread,Cupon1, ")
SQL.ADD(" Precio1, Precio2,Precio3,")
SQL.ADD(" OperacionRef,RB3,MB4,TipoCambio3,Especie ) ")
SQL.ADD(" Values")
SQL.ADD(" ('CUPON','"~Val(aa1)~"', '"~Val(Z3)~"', '"~Dialogo.Especie1~"', '"~Val(a:val(w1))~"', ")
SQL.ADD(" "~FStr(Abs(Val(d:val(w1))),0,4)~",'"~IdxDate(val(g2))~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~IdxDate(FSYS)~"', '"~IdxDate(Dialogo.Fecha1)~"',")
SQL.ADD(" '"~VAL(c:val(w1))~"',"~FStr(Val(h:val(w1)),0,7)~",'"~FStr(Dialogo.Entero1,0,0)~"', ")
SQL.ADD(" "~FStr(Val(k2),0,7)~","~FStr(Val(l2),0,7)~", "~FStr(Val(z:val(w1)),0,7)~", ")
SQL.ADD(" '"~VAL(f:val(w1))~"','1','"~Val(Z4)~"',"~FStr(VAL(n:val(w1)),0,0)~",'"~Dialogo.ContraEspecie2~"') ")
SQL.NEW
SQL.EXEC

* Insert de Instancias: Recibe z3: Nro.Op.
If [EqStr(Val(Z4),'3') y VAL(n:val(w1))=3] o EqStr(Val(Z4),'0') o [Incluido(VAL(b:val(w1)),'SERA|SERAV|SERP|SERPV')]
   * Si es Saldo 3 o Spot no Liquidados va a supervision especial
   * sino a terminal
   (."ALTAINSTAN".)
Else
   (."ALTAINSTER".)
EndIf


SQL.ActualizarMovimientos2(Val(Z3),SI,NO,NO,SI)
SQL.EXEC

