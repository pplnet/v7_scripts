* Los da: son para las cantidades del parcial (Cupon / Acciones / CAMEST)
* a los da: les saqué los abs y se ponen en los rr:
* Los db: son para el producto
           SQL.ADD("SELECT M.Especie, M.FechaEj, M.PrecioEj, M.CallPut, M.Cliente, M.Cantidad, ")
           SQL.ADD(" M.FechaMov, M.NrOperacion, Cuenta, M.Leyenda, M.NrSaldo-30 , M.EnteCustodia, ")
           SQL.ADD(" M.Bits, M.NrGrupo, FechaEje, M.Concepto, ")
           SQL.ADD(" M.NrMov, M.NrLiq, NrTrans2, M.Mercado, M.Book, M.Cupon, ")
           SQL.ADD(" O.TipoOp, O.Especie EspOpe ")
           SQL.ADD(" from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
           SQL.ADD(" Where M.NrTrans2='"~Val(aq:&i) ~"' ")
           SQL.ADD("   and M.NrOperacion=O.NrOperacion ")
           SQL.ADD(" UNION ")
           SQL.ADD("SELECT M.Especie, M.FechaEj, M.PrecioEj, M.CallPut, M.Cliente, M.Cantidad, ")
           SQL.ADD(" M.FechaMov, M.NrOperacion, Cuenta, M.Leyenda, M.NrSaldo-30 , M.EnteCustodia, ")
           SQL.ADD(" M.Bits, M.NrGrupo, FechaEje, M.Concepto, ")
           SQL.ADD(" M.NrMov, M.NrLiq, NrTrans2, M.Mercado, M.Book, M.Cupon, ")
           SQL.ADD(" O.TiPoTr2 TipoOp, O.Especie1 EspOpe ")
           SQL.ADD(" from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 O ")
           SQL.ADD(" Where M.NrOperacion='"~Val(aq:&i) ~"' ")
           SQL.ADD("   and M.NrOperacion=O.NrTrans ")
           SQL.ADD("   and TipoTr2 in('PDIVID','STOCK','CANJE','LCUPON') ") 
           SQL.ADD("   and "~DBO~".DesciendeDeEspecie(M.Especie,'MONEDA') = 1 ")
           watch(SQL.BATCH())
           Recorrer SQL
               * C/V Titulos privados
               If Eqstr(SQL("SELECT T.Clasificacion from "~DBO~".TIPOESPECIE T, "~DBO~".ESPECIES E WHERE T.Codigo=E.tipo and E.Codigo='"~fbn('EspOpe')~"'"),'PRI')               
                  If Incluido(FBN['TipoOp'],'TIC|TIV|')
                     * Comision TPR
                     If fbn('NrGrupo')=15
                        If fbn('NrMov')=11
                           SCN(da:2,fbn('Cantidad'))
                        else
                           * Iva
                           SCN(da:4,fbn('Cantidad'))
                        endif   
                        SCN(db:1,Abs(fbn('Cantidad')))
                        if val(db:1)>val(dz:1)
                           acn(dz:1,val(db:1))
                           act(dz:2,'1')
                        endif
                     else
                        * Derechos TPR
                        If fbn('NrGrupo')=16
                           If fbn('NrMov')=13
                              SCN(da:3,fbn('Cantidad'))
                           else
                              * Iva
                              SCN(da:4,fbn('Cantidad'))
                           endif   
                           SCN(db:1,Abs(fbn('Cantidad')))
                           if val(db:1)>val(dz:1)
                              acn(dz:1,val(db:1))
                              act(dz:2,'1')
                           endif
                        else
                           * Acciones
                           SCN(da:1,fbn('Cantidad'))
                           SCN(db:1,Abs(fbn('Cantidad')))
                           if val(db:1)>val(dz:1)
                              acn(dz:1,val(db:1))
                              act(dz:2,'1')
                           endif
                        endif   
                     endif   
                  else
                     If Incluido(FBN['TipoOp'],'PDIVID|STOCK|CANJE|LCUPON|')
                        If Incluido(FBN['TipoOp'],'LCUPON|') y Incluido(FBN['NrGrupo'],'1|3|')
                           SCN(da:1,fbn('Cantidad'))
                        else
                           If Incluido(FBN['TipoOp'],'LCUPON|') y Incluido(FBN['NrGrupo'],'2|')
                              SCN(da:5,fbn('Cantidad'))
                           else
                              If Incluido(FBN['TipoOp'],'PDIVID|') y Incluido(FBN['NrGrupo'],'1|2|')
                                 SCN(da:1,fbn('Cantidad'))
                              else
                                 If Incluido(FBN['TipoOp'],'PDIVID|STOCK|CANJE|LCUPON|') y Incluido(FBN['NrGrupo'],'41|51|')
                                    SCN(da:2,fbn('Cantidad'))
                                 else
                                    If Incluido(FBN['TipoOp'],'PDIVID|STOCK|CANJE|LCUPON|') y Incluido(FBN['NrGrupo'],'42|52|')
                                       SCN(da:4,fbn('Cantidad'))
                                    else
                                       * Lo mando a capital
                                       SCN(da:1,fbn('Cantidad'))
                                    endif    
                                 endif 
                              endif    
                           endif    
                        endif    
                        SCN(db:3,Abs(fbn('Cantidad')))
                        if val(db:3)>val(dz:1)
                           acn(dz:1,val(db:3))
                           act(dz:2,'3')
                        endif
                     else
                        If Incluido(FBN['TipoOp'],'TIPO|TICO|')
                           SCN(da:5,fbn('Cantidad'))
                           SCN(db:5,Abs(fbn('Cantidad')))
                           if val(db:5)>val(dz:1)
                              acn(dz:1,val(db:5))
                              act(dz:2,'5')
                           endif
                        else
                           If Incluido(FBN['TipoOp'],'TIDE|TICT|')
                              SCN(da:5,fbn('Cantidad'))
                              SCN(db:7,Abs(fbn('Cantidad')))
                              if val(db:7)>val(dz:1)
                                 acn(dz:1,val(db:7))
                                 act(dz:2,'7')
                              endif
                           else
                              If Incluido(FBN['TipoOp'],'TIPA|')
                                 SCN(da:5,fbn('Cantidad'))
                                 SCN(db:9,Abs(fbn('Cantidad')))
                                 if val(db:9)>val(dz:1)
                                    acn(dz:1,val(db:9))
                                    act(dz:2,'9')
                                 endif
                              else
********************* desde 1
                                 If Incluido(FBN['TipoOp'],'TCOPRI|')
                                     * Comision TPR
                                     If fbn('NrGrupo')=15
                                        If fbn('NrMov')=11
                                           SCN(da:2,fbn('Cantidad'))
                                        else
                                           * Iva
                                           SCN(da:4,fbn('Cantidad'))
                                        endif   
                                        SCN(db:999,Abs(fbn('Cantidad')))
                                        if val(db:999)>val(dz:1)
                                        acn(dz:1,val(db:999))
                                           act(dz:2,'1')
                                        endif
                                     else
                                        * Derechos TPR
                                        If fbn('NrGrupo')=16
                                           If fbn('NrMov')=13
                                              SCN(da:3,fbn('Cantidad'))
                                           else
                                              * Iva
                                              SCN(da:4,fbn('Cantidad'))
                                           endif   
                                           SCN(db:999,Abs(fbn('Cantidad')))
                                           if val(db:999)>val(dz:1)
                                           acn(dz:1,val(db:999))
                                              act(dz:2,'1')
                                           endif
                                        else
                                           * Acciones
                                           SCN(da:1,fbn('Cantidad'))
                                           SCN(db:999,Abs(fbn('Cantidad')))
                                           if val(db:999)>val(dz:1)
                                           acn(dz:1,val(db:999))
                                              act(dz:2,'1')
                                           endif
                                        endif   
                                     endif   
                                 else
                                 endif
********************* hasta 1                             
                              endif
                           endif
                        endif
                     endif
                  endif
               else
                  * C/V Titulos publicos
                  If Eqstr(SQL("SELECT T.Clasificacion from "~DBO~".TIPOESPECIE T, "~DBO~".ESPECIES E WHERE T.Codigo=E.tipo and E.Codigo='"~fbn('EspOpe')~"'"),'PUB')
                     If Incluido(FBN['TipoOp'],'TIC|TIV|')
                        * Comision TPU
                        If fbn('NrGrupo')=15
                           If fbn('NrMov')=11
                              SCN(da:2,fbn('Cantidad'))
                           else
                              * Iva
                              SCN(da:4,fbn('Cantidad'))
                           endif   
                           SCN(db:2,Abs(fbn('Cantidad')))
                           if val(db:2)>val(dz:1)
                              acn(dz:1,val(db:2))
                              act(dz:2,'2')
                           endif                       
                        else
                           * Derechos TPU
                           If fbn('NrGrupo')=16
                              If fbn('NrMov')=13
                                 SCN(da:3,fbn('Cantidad'))
                              else
                                 * Iva
                                 SCN(da:4,fbn('Cantidad'))
                              endif   
                              SCN(db:2,Abs(fbn('Cantidad')))
                              if val(db:2)>val(dz:1)
                                 acn(dz:1,val(db:2))
                                 act(dz:2,'2')
                              endif                       
                           else
                              * Titulos
                              SCN(da:1,fbn('Cantidad'))
                              SCN(db:2,Abs(fbn('Cantidad')))
                              if val(db:2)>val(dz:1)
                                 acn(dz:1,val(db:2))
                                 act(dz:2,'2')
                              endif                       
                           endif   
                        endif   
                     else
                        If Incluido(FBN['TipoOp'],'LCUPON|')
                           * falta amortizacion del capital
                           If Incluido(FBN['NrGrupo'],'1|3|')
                              SCN(da:1,fbn('Cantidad'))
                           else
                              If Incluido(FBN['NrGrupo'],'2|')
                                 SCN(da:5,fbn('Cantidad'))
                              else
                                 If Incluido(FBN['NrGrupo'],'41|51|')
                                    SCN(da:2,fbn('Cantidad'))
                                 else
                                    If Incluido(FBN['NrGrupo'],'42|52|')
                                       SCN(da:4,fbn('Cantidad'))
                                    else
                                       * Lo mando a capital
                                       SCN(da:1,fbn('Cantidad'))
                                    endif    
                                 endif 
                              endif    
                           endif    
                           SCN(db:4,Abs(fbn('Cantidad')))
                           if val(db:4)>val(dz:1)
                              acn(dz:1,val(db:4))
                              act(dz:2,'4')
                           endif                       
                        else
                           If Incluido(FBN['TipoOp'],'TIPO|TICO|')
                              SCN(da:5,fbn('Cantidad'))
                              SCN(db:6,Abs(fbn('Cantidad')))
                              if val(db:6)>val(dz:1)
                                 acn(dz:1,val(db:6))
                                 act(dz:2,'6')
                              endif                       
                           else
                              If Incluido(FBN['TipoOp'],'TIDE|TICT|')
                                 SCN(da:5,fbn('Cantidad'))
                                 SCN(db:8,Abs(fbn('Cantidad')))
                                 if val(db:8)>val(dz:1)
                                    acn(dz:1,val(db:8))
                                    act(dz:2,'8')
                                 endif                       
                              else
                                 If Incluido(FBN['TipoOp'],'TIPA|')
                                    SCN(da:5,fbn('Cantidad'))
                                    SCN(db:10,Abs(fbn('Cantidad')))
                                    if val(db:10)>val(dz:1)
                                       acn(dz:1,val(db:10))
                                       act(dz:2,'10')
                                    endif                       
                                 else
********************* desde 2
                                     If Incluido(FBN['TipoOp'],'TIC|TIV|')
                                        * Comision TPU
                                        If fbn('NrGrupo')=15
                                           If fbn('NrMov')=11
                                              SCN(da:2,fbn('Cantidad'))
                                           else
                                              * Iva
                                              SCN(da:4,fbn('Cantidad'))
                                           endif   
                                           SCN(db:999,Abs(fbn('Cantidad')))
                                           if val(db:999)>val(dz:1)
                                           acn(dz:1,val(db:999))
                                              act(dz:2,'2')
                                           endif                       
                                        else
                                           * Derechos TPU
                                           If fbn('NrGrupo')=16
                                              If fbn('NrMov')=13
                                                 SCN(da:3,fbn('Cantidad'))
                                              else
                                                 * Iva
                                                 SCN(da:4,fbn('Cantidad'))
                                              endif   
                                              SCN(db:999,Abs(fbn('Cantidad')))
                                              if val(db:999)>val(dz:1)
                                              acn(dz:1,val(db:999))
                                                 act(dz:2,'2')
                                              endif                       
                                           else
                                              * Titulos
                                              SCN(da:1,fbn('Cantidad'))
                                              SCN(db:999,Abs(fbn('Cantidad')))
                                              if val(db:999)>val(dz:1)
                                                 acn(dz:1,val(db:999))
                                                 act(dz:2,'2')
                                              endif                       
                                           endif   
                                        endif   
                                     else
                                     endif
********************* hasta 2
                                 endif
                              endif
                           endif
                        endif
                     endif   
                  else
                  endif
               endif
           Proximo