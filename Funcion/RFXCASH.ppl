MostrarCuadroDeMensajes
Message('FX CashFlow ')

If Val(mn:1000) = 0
   SetFilaActual(Val(fl:2))
Else
   SCN(fl:2,1)
   SetFilaActual(Val(fl:2))
EndIf

ACN(bb:2010, 0)

SQL.ADD("Select O.Vehiculo1, O.TipoOp, O.FechaPago Fecha, O.ContraEspecie, ")
SQL.ADD("Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaPago ")

If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.TipoOp, O.FechaPago Fecha, O.ContraEspecie, ")
   SQL.ADD("Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Else
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD("group by O.Vehiculo1, O.ContraEspecie, O.TipoOp, O.FechaPago ")
Endif

SQL.ADD("order by 1, 2 ")

RECORRER SQL
If FBN['Fecha'] >= Val(2:Val(xx:2000)) y FBN['Fecha'] <= Val(2:Val(gg:Val(lm:2)))
   If Val(bb:2010) = 0
      If Val(mn:1000) = 0
         ACT(c:fac, "Operaciones de cambio a termino venta")
         SetFont(c:fac, 2)
         ACN(bb:2010, 1)
         SCN(c:2000,1)

         *--> Seteo en cero la fila
         recorrer&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO

         SCN(fl:2,1)
      Else
         ACT(c:fac, "Operaciones de cambio a termino compra")
         SetFont(a:fac, 2)
         ACN(bb:2010, 1)
         SCN(f:2000,2)

         *--> Seteo en cero la fila
         recorrer&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO

         SCN(fl:2,1)
      EndIf

   EndIf

   *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
   If Val(cz:2) = 0
      ACN(mt:1200, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)) )
   Else
      ACN(mt:1200, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)) )
   EndIf

   ACN(mt:1100, 0)
   ACN(mt:1100, FBN['Monto'] * Val(mt:1200) )

   *--> Diario
   recorrer&i Val(VT:1), Val(lm:1)
      If FBN['Fecha'] = Val(&i:Val(xx:2000) )
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Else
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Endif
      Endif
   Proximo

   Recorrer&i Val(lm:1)+1, Val(lm:2)-1
      If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Else
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Endif
      Endif
   Proximo

   If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
      If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
         If Val(mn:1000) = 1
            ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      Else
         If Val(mn:1000) = 0
            ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      EndIf
   EndIf
EndIf 
PROXIMO

*--> Esta linea comentada corresponde a impuestos, queda pte. definir cuando va en este query
*--> y cuando en el query de monto

If Val(mn:1000) = 0
   SetFilaActual(Val(fl:2))
Else
   SetFilaActual(Val(fl:2)-2)
EndIf

SQL.ADD(" Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad)/1000 Cant ")
SQL.ADD(" From "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, O.ContraEspecie2 ")

If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, Sum(O.Cantidad)/1000 Cant ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXCTV','FXVT','FXVTV') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Else
      SQL.ADD(" and  O.TipoOp In ('FXCT','FXVT') ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, O.ContraEspecie2 ")
Endif

SQL.ADD("order by 1, 2 ")

RECORRER SQL
If FBN['Fecha'] >= Val(2:Val(xx:2000)) y FBN['Fecha'] <= Val(2:Val(gg:Val(lm:2)))
   If Val(bb:2010) = 0 o Val(bb:2010) = 1
      If Val(mn:1000) = 1
         ACT(a:fac, "                Operaciones de cambio a termino venta")
         SetFont(a:fac, 2)
         ACN(bb:2010, 2)
         SCN(f:2000, -1)

         *--> Seteo en cero la fila
         recorrer&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO
 
         SCN(fl:2, 1)
      Else
         ACT(a:fac, "                Operaciones de cambio a termino compra")
         SetFont(a:fac, 2)
         ACN(bb:2010, 2)
         SCN(c:2000, 1)

         *--> Seteo en cero la fila
         recorrer&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO

         SCN(fl:2, 1)
      EndIf
   EndIf

   ACN(mt:1100, 0)
   ACN(mt:1200, 0)
   ACN(mt:1300, 0) 
    
   *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
   If Val(cz:2) = 0
      ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)) )
   Else
      ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)) )
   EndIf
        
   *--> FX no tiene Intereses
   *--> Capital
   SCN(mt:1100, Round(FBN('Cant') * Val(mt:1200), 2))
    
   *--> Diario
   recorrer&i Val(VT:1), Val(lm:1)
      If FBN['Fecha'] = Val(&i:Val(xx:2000) )
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Else
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Endif
      Endif
   Proximo

   Recorrer&i Val(lm:1)+1, Val(lm:2)-1
      If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
         If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
            If Val(mn:1000) = 0
               ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Else
            If Val(mn:1000) = 1
               ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Val(mt:1100), 2))
               ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Val(mt:1100), 2))
            EndIf
         Endif
      Endif
   Proximo

   If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
      If Incluido(FBN['TipoOp'],'FXCT|FXCTV')
         If Val(mn:1000) = 0
            ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      Else
         If Val(mn:1000) = 1
            ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Val(mt:1100), 2))
            ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Val(mt:1100), 2))
         EndIf
      EndIf
   EndIf
EndIf
PROXIMO

If Val(mn:1000) = 1
   SCN(f:2000, 1)
   SetFilaActual(Val(fl:2)-1)
EndIf

