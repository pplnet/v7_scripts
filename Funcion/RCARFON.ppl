ACT(ba:0, 'BA')
ACT(bm:0, 'BM NMV')
ACT(bq:0, 'BQ R.TRADE')
ACT(bs:0, 'BS R.REALIZ')
ACT(bu:0, 'BU R.DIVFON')
************************************
* Posiciones de Fondos
************************************
SQL.ADD("Select P.Especie, P.Cupon, P.Vehiculo, P.Book, V.Descripcion, ")
SQL.ADD("       E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD("       E.Alias2, ")
SQL.ADD("       CASE E.Alias2 When '1' Then '1' Else '0' End Tipo1, ")
SQL.ADD("       E.PaisOrigen, ")
SQL.ADD("       CASE E.PaisOrigen When 'ARG' Then '0' Else '1' End Tipo2, ")
SQL.ADD("       '0' Tipo3, ")
SQL.ADD("       P.Fecha, P.NrSaldo, ")
SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
SQL.ADD("       P.Cantidad1, P.Precio1, ")
SQL.ADD("       P.Cantidad2, P.Precio2, ")
SQL.ADD("       P.CantidadFin, P.PrecioFin ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, "~DBO~".BOOKS B ")
SQL.ADD(" where P.Especie      =  E.Codigo ")
SQL.ADD("   and P.Vehiculo     =  V.Codigo ")
SQL.ADD("   and P.Book         =  B.Codigo ")
SQL.ADD("   and NrSaldo        =  "~Val(q:2)~" ")
SQL.ADD("   and P.TipoNegocio  =  'FC' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie    = '"~Dialogo.Especie1~"' ")
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and P.Book      in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
SQL.ADD("                        from "~DBO~".POSICIONES P1 ")
SQL.ADD("                       where P1.Especie             =  P.Especie ")
SQL.ADD("                         and IsNull(P1.Cupon,'') = IsNull(P.Cupon,'') ")
SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
SQL.ADD("                         and IsNull(P1.Book,'')  = IsNull(P.Book,'') ")
SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
SQL.ADD(" order by Tipo1,Tipo2,Tipo3,P.Especie, P.Cupon, P.Vehiculo, P.NrSaldo ")
Recorrer SQL
  if Val(z:2)=0
    ACT(a:FAC, 'FONDOS')
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 1)
    ACN(y:2, FAC)
    ACN(s:1, FAC)
    IFA
    if EqStr(fbn('Tipo1'),'0')
      ACT(a:FAC, Pad('',5)~'Money Market')
    else
      ACT(a:FAC, Pad('',5)~'Renta Fija')
    endif
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 2)
    ACN(l:FAC, Val(s:1))
    ACN(s:2, FAC)
    IFA
    if EqStr(fbn('Tipo2'),'0')
      ACT(a:FAC, Pad('',10)~'Locales')
    else
      ACT(a:FAC, Pad('',10)~'Extranjeros')
    endif
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 1)
    ACN(v:FAC, 3)
    ACN(l:FAC, Val(s:1))
    ACN(m:FAC, Val(s:2))
    ACN(s:3, FAC)
    IFA
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, fbn('Tipo2'))
  endif
  if Not EqStr(fbn('Tipo1'),Val(v:2))
    if EqStr(fbn('Tipo1'),'0')
      ACT(a:FAC, Pad('',5)~'Money Market')
    else
      ACT(a:FAC, Pad('',5)~'Renta Fija')
    endif
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 0)
    ACN(v:FAC, 2)
    ACN(l:FAC, Val(s:1))
    ACN(s:2, FAC)
    IFA
    ACT(v:2, fbn('Tipo1'))
    ACT(v:3, '')
  endif
  if Not EqStr(fbn('Tipo2'),Val(v:3))
    if EqStr(fbn('Tipo2'),'0')
      ACT(a:FAC, Pad('',10)~'Locales')
    else
      ACT(a:FAC, Pad('',10)~'Extranjeros')
    endif
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 1)
    ACN(v:FAC, 3)
    ACN(l:FAC, Val(s:1))
    ACN(m:FAC, Val(s:2))
    ACN(s:3, FAC)
    IFA
    ACT(v:3, fbn('Tipo2'))
  endif
  if EqStr(fbn('Especie'),Val(v:4))
    DFA
  else
    ACT(a:FAC, Pad('',15)~fbn('Especie'))
    ACT(i:FAC, 'FCS-FCR')
    ACN(r:FAC, 1)
    ACN(s:FAC, 1)
    ACN(t:FAC, 2)
    ACN(v:FAC, 4)
    ACN(z:FAC, 1)
    ACN(l:FAC, Val(s:1))
    ACN(m:FAC, Val(s:2))
    ACN(n:FAC, Val(s:3))
    ACT(v:4, fbn('Especie'))
  endif
  SCN(z:2, 1)

  ** Armado de lista de especies para TIR
  ACT(p:FAC, fbn('Especie'))
  if Vacio(Val(p:Val(l:FAC)))
    ACT(p:Val(l:FAC), fbn('Especie'))
  else
    if Not Incluido(fbn('Especie'),Val(p:Val(l:FAC)))
      ACT(p:Val(l:FAC), Val(p:Val(l:FAC))~'|'~fbn('Especie'))
    endif
  endif
  if Vacio(Val(p:Val(m:FAC)))
    ACT(p:Val(m:FAC), fbn('Especie'))
  else
    if Not Incluido(fbn('Especie'),Val(p:Val(m:FAC)))
      ACT(p:Val(m:FAC), Val(p:Val(m:FAC))~'|'~fbn('Especie'))
    endif
  endif
  if Vacio(Val(p:Val(n:FAC)))
    ACT(p:Val(n:FAC), fbn('Especie'))
  else
    if Not Incluido(fbn('Especie'),Val(p:Val(n:FAC)))
      ACT(p:Val(n:FAC), Val(p:Val(n:FAC))~'|'~fbn('Especie'))
    endif
  endif
  ** Armado de lista de saldos para TIR
  ACN(q:FAC, fbn('NrSaldo'))
  ACN(q:Val(l:FAC), fbn('NrSaldo'))
  ACN(q:Val(m:FAC), fbn('NrSaldo'))
  ACN(q:Val(n:FAC), fbn('NrSaldo'))

  ACT(ba:Val(z:2), fbn('Especie'))
  ACN(bb:Val(z:2), fbn('Cupon'))
  ACT(bc:Val(z:2), fbn('Cotiza'))

*  ACT(bt:Val(z:2), fbn('Alias2'))
*  ACT(bu:Val(z:2), fbn('Tipo1'))
  ACT(bv:Val(z:2), fbn('PaisOrigen'))
  ACT(bw:Val(z:2), fbn('Tipo2'))
  ACD(bx:Val(z:2), fbn('Fecha'))

  ACT(bd:Val(z:2), fbn('Vehiculo'))
  ACT(be:Val(z:2), fbn('Book'))
  ACN(bf:Val(z:2), fbn('NrSaldo'))
  ACN(bg:Val(z:2), fbn('CantidadIni'))
  ACN(bh:Val(z:2), fbn('PrecioIni'))
  ACN(bi:Val(z:2), fbn('CantidadFin'))
  ACN(bj:Val(z:2), fbn('PrecioFin'))
  ACN(bk:Val(z:2), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI))
  ACN(bl:Val(z:2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,Val(r:2)))
  * Net Market Value
  ACN(bm:Val(z:2), fbn('CantidadFin')*Val(bl:Val(z:2))*iif(Eqstr(fbn('InteresesC'),'CLE'),ValorTeorico(fbn('Especie')),1))
  ACN(bn:Val(z:2), fbn('CantidadFin')*Val(bj:Val(z:2))*iif(Eqstr(fbn('InteresesC'),'CLE'),ValorTeorico(fbn('Especie')),1))
  * P&L NO Realizado
  ACN(bo:Val(z:2), Val(bm:Val(z:2))-Val(bn:Val(z:2)))
  SQL.ADD("Select R1.TipoResultado,R1.YTD from "~DBO~".RESULTADOS R1 ")
  SQL.ADD(" where R1.TipoResultado   in ('TRADE','REALIZ','DIVFON') ")
  SQL.ADD("   and R1.Especie         =  '"~fbn('Especie')~"' ")
  SQL.ADD("   and R1.Vehiculo        =  '"~fbn('Vehiculo')~"' ")
  SQL.ADD("   and IsNull(R1.Book,'') =  '"~fbn('Book')~"' ")
  SQL.ADD("   and R1.NrSaldo         =  "~fbn('NrSaldo')~" ")
  SQL.ADD("   and R1.Fecha           >= "~IdxDate2(Val(r:7))~" ")
  SQL.ADD("   and R1.Fecha           = (select Max(Fecha) ")
  SQL.ADD("                               from "~DBO~".RESULTADOS R2 ")
  SQL.ADD("                              where R2.Especie         =  R1.Especie ")
  SQL.ADD("                                and R2.Vehiculo        =  R1.Vehiculo ")
  SQL.ADD("                                and IsNull(R2.Book,'') = IsNull(R1.Book,'') ")
  SQL.ADD("                                and R2.NrSaldo         =  R1.NrSaldo ")
  SQL.ADD("                                and R2.TipoResultado   =  R1.TipoResultado ")
  SQL.ADD("                                and R2.Fecha           <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
  recorrer SQL
    DFA
    if EqStr(fbn('TipoResultado'),'TRADE')
      SCN(bp:Val(z:2), 1)
      SCN(bq:Val(z:2), fbn('YTD'))
    else
      if EqStr(fbn('TipoResultado'),'REALIZ')
        SCN(br:Val(z:2), 1)
        SCN(bs:Val(z:2), fbn('YTD'))
      else
        SCN(bt:Val(z:2), 1)
        SCN(bu:Val(z:2), fbn('YTD'))
      endif
    endif
  proximo

  * Net Market Value
  SCN(b:FAC, Val(bm:Val(z:2)))
  * Res. Realizado
  SCN(d:FAC, Val(bq:Val(z:2))+Val(bs:Val(z:2))+Val(bu:Val(z:2)))
  * Res. NO Realizado
  SCN(e:FAC, Val(bo:Val(z:2)))
  * Totales
  SCN(t:1,   Val(bm:Val(z:2)))
  SCN(t:2,   Val(bq:Val(z:2))+Val(bs:Val(z:2))+Val(bu:Val(z:2)))
  SCN(t:3,   Val(bo:Val(z:2)))

  * Aculuma Nivel 1
  SCN(b:Val(l:FAC), Val(bm:Val(z:2)))
  SCN(d:Val(l:FAC), Val(bq:Val(z:2))+Val(bs:Val(z:2))+Val(bu:Val(z:2)))
  SCN(e:Val(l:FAC), Val(bo:Val(z:2)))
  * Aculuma Nivel 2
  SCN(b:Val(m:FAC), Val(bm:Val(z:2)))
  SCN(d:Val(m:FAC), Val(bq:Val(z:2))+Val(bs:Val(z:2))+Val(bu:Val(z:2)))
  SCN(e:Val(m:FAC), Val(bo:Val(z:2)))
  * Aculuma Nivel 3
  SCN(b:Val(n:FAC), Val(bm:Val(z:2)))
  SCN(d:Val(n:FAC), Val(bq:Val(z:2))+Val(bs:Val(z:2))+Val(bu:Val(z:2)))
  SCN(e:Val(n:FAC), Val(bo:Val(z:2)))

  SCN(j:FAC, 1)
  SCN(k:FAC, fbn('CantidadFin'))
proximo

if Val(z:2)>0
  SetFont(ba:1..by:Val(z:2),1)
  FormatoCeldas(bg:1..bs:Val(z:2),Exe('F2'))
  FormatoCeldas(bh:1..bh:Val(z:2),Exe('F8'))
  FormatoCeldas(bj:1..bl:Val(z:2),Exe('F8'))
endif

