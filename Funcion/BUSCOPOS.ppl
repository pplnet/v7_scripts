** Dejo en AZ10 la fecha de la posiciones, (si es a futuro), o blancos
** Dejo en AZ11 la posicion,(con signo)
** Dejo en AZ12 el valor nominal de la posicion


SQL.ADD("SELECT P1.Fecha, P1.CantidadFin ")
SQL.ADD("FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("WHERE P1.Cliente = '"~Val(az8)~"' AND ")
SQL.ADD("      P1.Vehiculo = '"~Val(az8)~"' AND ")
SQL.ADD("      P1.NrSaldo IN ("~Val(az6)~") AND ")
SQL.ADD("      P1.Especie = '"~Val(az7)~"' AND ")
SQL.ADD("      (P1.FechaEj Is Null or P1.FechaEj='' ) and (P1.PrecioEj Is Null or P1.PrecioEj=0) AND ")
SQL.ADD("      P1.Fecha = (SELECT MAX(P2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                  WHERE P2.Cliente = P1.Cliente AND ")
SQL.ADD("                        P2.Vehiculo = P1.Vehiculo AND ")
SQL.ADD("                        P2.NrSaldo = P1.NrSaldo AND ")
SQL.ADD("                        P2.Especie = P1.Especie AND ")
SQL.ADD("                        (P2.FechaEj Is Null or P2.FechaEj='' ) and (P2.PrecioEj Is Null or P2.PrecioEj=0) AND ") 
SQL.ADD("                        P2.Fecha <= '"~IdxDate(Val(az9))~"') ")
****SQL.ADD("ORDER BY P1.Cliente, P1.Especie, P1.NrSaldo, P1.Fecha ")

* Blanqueo valores a devolver
ACD(az10, 0)
ACT(az11, '')
ACN(az12, 0)

ACN(az20, 0)
Recorrer SQL
   SCN(az20, 1)
   * Devuelvo fecha (si es a futuro devuelvo una fecha, si es contado devuelvo blanco), por ahora 
   * devuelvo siempre blanco
   ACD(az10, 0)
   IF FBN['CantidadFin'] < 0
      * Posicion negativa
      ACT(az11, 'S')
   ELSE
      * Posicion positiva
      ACT(az11, 'L')
   ENDIF
   ACN(az12, ABS(FBN['CantidadFin']))
Proximo
SetFilaActual(fac-Val(az20))