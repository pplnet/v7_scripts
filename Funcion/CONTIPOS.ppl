***Tipo de documento
if Eqstr(val(c3),'01')
   ACT(z1,'CI' )
else
   if Eqstr(val(c3),'02')
      ACT(z1,'LC' )
   else
      if Eqstr(val(c3),'03')
         ACT(z1,'LE' )
      else
         if Eqstr(val(c3),'04')
            ACT(z1,'DNI' )
         else
            if Eqstr(val(c3),'05')
               ACT(z1,'CIP' )
            else
               if Eqstr(val(c3),'06')
                  ACT(z1,'CUI' )
               else
                  if Eqstr(val(c3),'07')
                     ACT(z1,'PAS' )
                  else
                     if Eqstr(val(c3),'08')
                        ACT(z1,'GCE' )
                     else
                       if Eqstr(val(c3),'09')
                          ACT(z1,'OTR' )
                       endif
                     endif
                  endif
               endif 
            endif 
         endif
      endif 
   endif
endif

***Condicion Ganancias
if val(c19)=0
 ACT(y1, 'NOR')
else
 if val(c19)=1
  ACT(y1, 'INS')
 else
  if val(c19)=2
   ACT(y1, 'NOI')
  else 
   if val(c19)=3
    ACT(y1, 'EXE')
   else
    if val(c19)=7
     ACT(y1, 'NOR')
    endif
   endif
  endif
 endif    
endif 

***Condicion IVA
if Eqstr(val(c20),'0')
 ACT(x1, 'OTR')
else
 if Eqstr(val(c20),'1')
  ACT(x1, 'INS')
 else 
  if Eqstr(val(c20),'2')
   ACT(x1, 'NOI')
