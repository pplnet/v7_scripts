***Clasificaci#n BCRA
if Eqstr(val(c15),'A')
 ACT(w1,'NOR')
else

 if Eqstr(val(c15),'B')
  ACT(w1,'RPO')
 else
  if Eqstr(val(c15),'C')
   ACT(w1,'CPR')
  else
   if Eqstr(val(c15),'E') o Eqstr(val(c15),'S') o Eqstr(val(c15),'X') 
    ACT(w1,'IRR')
   else
    if Eqstr(val(c15),'F') o Eqstr(val(c15),'Y') o Eqstr(val(c15),'Z') 
     ACT(w1,'IRA')
    else
     if Eqstr(val(c15),'O') o Eqstr(val(c15),'H') o Eqstr(val(c15),'K') o Eqstr(val(c15),'T') 
      ACT(w1,'CPN')
     else
      if Eqstr(val(c15),'P') o Eqstr(val(c15),'U') 
       ACT(w1,'CPI')
      else
       if Eqstr(val(c15),'Q') o Eqstr(val(c15),'V') 
        ACT(w1,'CPD')
       else
        if Eqstr(val(c15),'R') o Eqstr(val(c15),'W')  
         ACT(w1,'DFR')
        else
