         * e1=>Interes e2=> Impuesto Interes e3 => Interes Total  e4: Monto e5: MontoTotal
         * f1: Importe de Iva  f2: Importe WH f3: Importe IVA CEN
         ACN(e1,FBN['PrecioEj']*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))
         ACN(e2,IIF(FBN['RB6']=0,FBN['ImpComCorEq2']*(FBN['TasaImp1']/100),0) )
         ACN(f1,VAL(e1)*(FBN['ImpGastos2']/100) )
         ACN(f2,((FBN['PrecioEj']*FBN['Plazo']*FBN['TotalAux2'])/IIF(FBN['RB9']=1,36500,36000))*(FBN['TotalAux1']/100)) 
         ACN(e3,VAL(e1)+VAL(e2)+FBN['ImpComCorEq2']+val(f2) )
         ACN(e4,FBN['PrecioEj']+VAL(e1))
         ACN(e5,FBN['PrecioEj']+VAL(e3))
         ACN(f3,FBN['ImpComCorEq2']*(FBN['IntDevengados1']/100))
      
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
         SQL.ADD(" TotalIntereses="~Fstr(val(e1),0,2)~", ")
         SQL.ADD(" ImporteImp="~Fstr(val(e2),0,2)~", ")
         SQL.ADD(" TotalNetoCli2="~Fstr(val(e3),0,2)~", ")  
         SQL.ADD(" TotalBrutoCli1="~Fstr(val(e4),0,2)~",")
         SQL.ADD(" TotalGastos="~Fstr(val(f3),0,2)~", ")
         SQL.ADD(" TotalAux3="~Fstr(val(f2),0,2)~", ")
         SQL.ADD(" TotalNetoCli1="~Fstr(val(e5),0,2)~",TotalIVA="~Fstr(val(f1),0,2)~"  ")
         SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")
         SQL.NEW
