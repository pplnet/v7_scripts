SetFilaActual(2)

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
SQL.ADD("Cantidad/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and ((O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
SQL.ADD("  or  (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0')) ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
SQL.ADD("Sum(C.Cantidad1)/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCCM') ")
SQL.ADD(" and  O.MB3 = '1' ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD(" group by O.NrOperacion, O.Vehiculo1, O.Especie, O.FechaVto, O.TipoOp, O.Vehiculo2 ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  
  if EqStr(fbn['Especie'],'ARP')
     scn(val(e:200):val(c:200)+iif([Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')],0,1),fbn['Cant'])
     scn(val(e:200):val(h:200),fbn['Cant'])
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(c:200),fbn['Cant'])
           scn(b:val(h:200),fbn['Cant'])
        endif
     endif
     SetFont(val(e:200):val(c:200)..val(e:200):val(c:200)+1,3)
    else
     scn(val(e:200):val(d:200)+iif([Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')],0,1),fbn['Cant']*Val(zz2))
     scn(val(e:200):val(k:200),fbn['Cant']*Val(zz2))
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(d:200),fbn['Cant']*Val(zz2))
           scn(b:val(k:200),fbn['Cant']*Val(zz2))
        endif
     endif
     SetFont(val(e:200):val(d:200)..val(e:200):val(d:200)+1,3)
  endif
  if fbn['Fecha'] <= (Dialogo.Fecha1+365)
     scn(val(e:200):val(t:200),fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(t:200),fbn['Cant']*Val(zz2))
        endif
     endif
    else
     if Not Incluido(fbn['TipoOp'],'MMCPVM|MMPCVM|MMPCCM')
        scn(val(e:200):val(x:200),fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(x:200),fbn['Cant']*Val(zz2))
           endif
        endif
     else
        SQL.ADD("Select Sum(Cantidad1)/1000 Parcial from "~DBO~".CUOTAS ")
        SQL.ADD("where  NrOperacion = '"~fbn['NrOperacion']~"' ")
        SQL.ADD("  and  Fecha2 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
        SQL.ADD("  and  Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")

        acn(ba:200,0)
        Recorrer SQL
          acn(ba:200,fbn['Parcial'])
        Proximo

        scn(val(e:200):val(t:200),val(ba:200)*Val(zz2))
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
        scn(val(e:200):val(x:200),(fbn['Cant']-val(ba:200))*Val(zz2))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(t:200),val(ba:200)*Val(zz2))
              scn(b:val(x:200),(fbn['Cant']-val(ba:200))*Val(zz2))
           endif
        endif
     endif
  endif
proximo

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
SQL.ADD("Cantidad/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.TipoOp In ('TEMIND') and  O.MB3 = '1') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")

act(u:200,' ')
Recorrer SQL

  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif


  if EqStr(fbn['Especie'],'ARP')
     if DesciendeDeCliente(fbn['Cliente1'],'EMPRESAS')
        scn(val(e:200):val(f:200),fbn['Cant'])
        scn(val(e:200):val(i:200),fbn['Cant'])
        scn(b:val(f:200),fbn['Cant'])
        scn(b:val(i:200),fbn['Cant'])
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
       else
        scn(val(e:200):val(ax:200)+1,fbn['Cant'])
        SetFont(val(e:200):val(ax:200)+1..val(e:200):val(ax:200)+1,3)
     endif
    else
     if DesciendeDeCliente(fbn['Cliente1'],'EMPRESAS')
        scn(val(e:200):val(g:200),fbn['Cant']*Val(zz2))
        scn(val(e:200):val(l:200),fbn['Cant']*Val(zz2))
        scn(b:val(g:200),fbn['Cant']*Val(zz2))
        scn(b:val(l:200),fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
       else
        scn(val(e:200):val(ax:200)+1,fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(ax:200)+1..val(e:200):val(ax:200)+1,3)
     endif
  endif
  if DesciendeDeCliente(fbn['Cliente1'],'EMPRESAS')
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
        scn(b:val(v:200),fbn['Cant']*Val(zz2))
       else
        scn(val(e:200):val(w:200),fbn['Cant']*Val(zz2))
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
        scn(b:val(w:200),fbn['Cant']*Val(zz2))
     endif
  endif
proximo


