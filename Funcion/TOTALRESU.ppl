*- fo1: Capital fo2:Interes + Impuestos 
*- fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo
If val(ra2)=0
   *- Expresado en Pesos -> Ubico las celdas en los valores de pesos
   *- b: Capital c: Interes d: Total e: TPromedio f: Plazo Promedio 
   SCN(b:val(fa1),val(fo1))
   SCN(c:val(fa1),val(fo2))
    
   ACN(d:val(fa1),val(b:val(fa1))+val(c:val(fa1)))

   SCN(e:val(fa1),val(fo5))     
   SCN(f:val(fa1),val(fo5))
   SCN(t:val(fa1),val(fo6))

   SCN(u:val(fa1),val(fo7))

   *- Sumo Total de Activos
   SCN(b:val(fa2),val(fo1))
   SCN(c:val(fa2),val(fo2))
   ACN(d:val(fa2),val(b:val(fa2))+val(c:val(fa2)))

   *SCN(e:val(fa2),val(fo5))     
   *SCN(f:val(fa2),val(fo5))
   SCN(t:val(fa2),val(fo6))
   SCN(u:val(fa2),val(fo7))
Else
   *- Expresado en Dolares -> Ubico las celdas en los valores de Moneda Extranjera
   SCN(g:val(fa1),val(fo1))
   SCN(h:val(fa1),val(fo2))
   ACN(i:val(fa1),val(g:val(fa1))+val(h:val(fa1)))
   SCN(j:val(fa1),val(fo5))     
   SCN(k:val(fa1),val(fo5))
   SCN(v:val(fa1),val(fo6))



   SCN(w:val(fa1),val(fo7))

   *- Sumo Total de Activos
   SCN(g:val(fa2),val(fo1))
   SCN(h:val(fa2),val(fo2))
   ACN(i:val(fa2),val(g:val(fa2))+val(h:val(fa2)))
   *SCN(j:val(fa2),val(fo5))     
   *SCN(k:val(fa2),val(fo5))
   SCN(v:val(fa2),val(fo6))
   SCN(w:val(fa2),val(fo7))
EndIf
SetFont(b:Val(fa1)..q:Val(fa1), 1)
