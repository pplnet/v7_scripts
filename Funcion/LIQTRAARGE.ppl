*- Movimiento DTP - RTP por el Cliente Sudameris contra cliente ARGENCLEAR
*- TIC - > RET de EuroClear -> DTP Cliente1= Sudameris y Cliente3=ARGENCLEAR
*- TIV - > DEP de EuroClear -> RTP Cliente1= Sudameris y Cliente3=ARGENCLEAR


*- Parametros para Ingresar Movimientos de Custodias
*- ta1: Especie ta2: TipoTr2  ta81: Vehiculo1 ta39: Fecha1
*- ta50: CB1 ta103: Mercado1 ta4: Cliente1   ta9: Cuenta1
*- ta6: Cliente3 ta7: Cliente4 ta104: Mercado2 ta5: Cliente2 ta10: Cuenta2
*- ta115: ComitenteExt ta60: RB1 ta40: Fecha2 ta41: Fecha3  ta24: Cantidad1 ta25: Cantidad2 
*- ta17: Especie4 ta18: Especie5  ta52: CB3  ta42: Fecha4 ta29: Precio1 
*- ta107: Cupon1 ta51: CB2 ta61: RB2 ta62: RB3 ta55: CB6 (Marca de Automatico)
*- ta92: NrOperacionRef2 ta203: Book1
*- ta47 Rueda ta116 Cantidad11 (bloqueo ventas)
*- ta16 Especie3 (Contraespecie Voucher) Cantidad12 DiasParking Cantidad25 0 Ni S ni L /1 xSaldo / 2 xLimites 

* El Depositante de la Cuenta2 es SUDAMERIS 
If Eqstr(Val(at:&i),'LICI3RO')
   If Incluido(Val(ai:&i),'RET|')
      ACT(w:&i, 'RTP')
   Else
      ACT(w:&i, 'DTP')
   Endif
else
   If Incluido(Val(ai:&i),'RET|')
      ACT(w:&i, 'DTP')
   Else
      ACT(w:&i, 'RTP')
   Endif
endif   

act(ta92, Val(ai:&i) )
act(ta1  ,Val(ab:&i) )
act(ta2  ,Val(w:&i) )
act(ta81 ,Val(aj:&i) )
acd(ta39 ,Dialogo.Fecha1) 
act(ta50 ,'1')

If Eqstr(Val(at:&i),'LICI3RO')
   act(ta103,BuscarCampo('CUENTAS','Mercado','Codigo',val(al:&i)))
else
   if EQSTR(SQL("SELECT isNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'SI') y EQSTR(SQL("SELECT isNull(Afectacustodia,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'SI')
      act(ta103,Dialogo.Mercado1)
   else 
      act(ta103,VAR('CLHODEFA'))
   endif
endif   
act(ta4  ,val(ta81) )
act(ta9  ,val(al:&i))

act(ta6  ,SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' ") ) 
act(ta7  ,BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',val(ta6)) ) 

* Si el mercado netea y lleva custodia va ese. Si no CV
if EQSTR(SQL("SELECT isNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'SI') y EQSTR(SQL("SELECT isNull(Afectacustodia,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'SI')
   act(ta104,Dialogo.Mercado1)
else
   act(ta104,VAR('CLHODEFA') )
endif   
act(ta5  ,'' )
act(ta10 ,val(ah:&i)  )

act(ta115,BuscarCampo('CUENTAS','NrDepositante','Codigo',val(ta10))  )
act(ta60 ,'2' )

act(ta40, '' )
act(ta41, '' )

act(ta47, val(ax:&i) )

acn(ta24,Abs(val(af:&i)) )

*- Valor Teorico
acn(ta200, ValorTeorico2(val(ta1),val(ta39)) )
acn(ta25,val(ta24)*val(ta200) )
act(ta17,'CUS')
act(ta18,'CUS')
act(ta52,'0')
act(ta42,'')
acn(ta29,COTIZACION(val(ta1),,,,val(ta39),1) )
act(ta107,Fstr(NrCupon2(val(ta1),val(ta39)),0,0) )
*If EqStr(val(ta107),'0')
*   act(ta107,'')
*EndIf

act(ta51,'0') 
act(ta61,'0') 
act(ta62,'0') 
act(ta63,'0') 

if Incluido(val(ax:&i),VAR('RUECPC1'))
   act(ta5  ,val(ay:&i) )
   act(ta51,'1') 
else
   act(ta5  ,'' )
endif    

act(ta201,BuscarCampo('ESPECIES','InteresesC','Codigo',val(ta1)) ) 
acn(ta202,val(ta29)) 
act(ta203,val(bk:&i)) 

*- Resolucion 1585
ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Val(ta1)))

If Not EqStr(val(ta201),'DIR')
   *** calcula precio sucio ***
   act(ca:fac,val(ta1))
   acd(ck:fac,val(ta39))
 
   (.'SUCIO'.)

   IF Incluido(Val(al4), '1585')
      acn(ta202,(val(ta29)+(val(cj:fac)*Val(ta29)))*val(ci:fac) )
   Else
      acn(ta202,(val(ta29)+val(cj:fac))*val(ci:fac) ) 
   Endif 
EndIf

*- ta34: Cambio1 ta35: Cambio2 ta36: Cambio3 ta37: Cambio4
*- ta28: Cantidad5  ta30: Precio2 ta31: Precio3 ta32: Precio4 ta33: Precio5 ta11: Cuenta3
*- ta38: Cambio5 ta26: Cantidad3

acn(ta35, IIF(Incluido('LETES',Ascendientes('ESPECIES',val(ta1))),(1-val(ta29))*36000/(FechaMaduracion(val(ta1))-val(ta39)),0) )
acn(ta36, val(cj:fac) )

*- Monto de la Transferencia 
acn(ta37, IIF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',val(ta1)),'CLE'),IIF(BuscarCampo('ESPECIES','Tasa1','Codigo',val(ta1))=0,val(ta29)*val(ta24)*val(ta200),(val(ta29)*val(ta24)*(ValorNominal(val(ta1))+BuscarCampo('ESPECIES','IntsCapitalizados','Codigo', val(ta1))))),val(ta29)*val(ta24)) )

*- Total
acn(ta34, val(ta24)*val(ta202) )

act(ta55,'1') 

*- ta91: Operacion de Referencia1 ta92: Operacion de Referencia2
act(ta91,Val(aq:&i) ) 

* - Fechacargasys
acd(ta80,fsys) 

* - Cantidad11 Cantidad Bloqueada
acn(ta116,Abs(val(aw:&i)) )

* - Especie3 Contraespecie del Voucher
act(ta16,val(am:&i) )

* - Cantidad12 Cantidad Bloqueada
acn(ta117,Abs(val(an:&i)) )

* - Cantidad25 Tipo Control
acn(ta118,Abs(val(as:&i)) )

(.'GENTRANS2'.)

ACT(az:&i, val(ta3) )
