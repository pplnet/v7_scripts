ACT(aa:1, 'Codigo')
ACT(aa:2, 'FechaMAE')
ACT(aa:3, 'HoraMAE')
ACT(aa:4, 'Secuencia')
ACT(aa:5, 'CodigoMAE')
ACT(aa:6, 'Estado')

ACN(v4, 0)
SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
SQL.ADD(" where Codigo    in ('CONALT','CONBAJ') ")
SQL.ADD("   and Secuencia =  '"~Copy(Val(A:FAC),23,5)~"' ")
SQL.ADD("   and Estado    in  ('PEN','A76') ")
Recorrer SQL
  DFA
  ACT(ab:1, fbn('Codigo'))
  ACT(ab:2, fbn('FechaMAE'))
  ACT(ab:3, fbn('HoraMAE'))
  ACT(ab:4, fbn('Secuencia'))
  ACT(ab:5, fbn('CodigoMAE'))
  ACT(ab:6, fbn('Estado'))
  SCN(v4,1)
proximo
if Val(v4)=1
  SQL.ADD("Update "~DBO~".MENSAJESMAE ")
  SQL.ADD("   Set Estado    = 'VEN' ")
  SQL.ADD(" Where Codigo    = '"~Val(ab:1)~"' ")
  SQL.ADD("   and FechaMAE  = '"~Val(ab:2)~"' ")
  SQL.ADD("   and HoraMAE   = '"~Val(ab:3)~"' ")
  SQL.ADD("   and Secuencia = '"~Val(ab:4)~"' ")
  SQL.ADD("   and CodigoMAE = '"~Val(ab:5)~"' ")
  SQL.ADD("   and Estado    = '"~Val(ab:6)~"' ")
  SQL.NEW
  SQL.EXEC
else
  if Eqstr(Var('LOGERRMAE'),'SI')
    if Val(v4)=0
      *** Error 7020/0500
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('7020|0500 No Existe PEN|A76',30)~'-'~Val(A:FAC))
      CerrarASCII
    else
      *** Error 7020/0500
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('7020|0500 multipes registros',30)~'-'~Val(A:FAC))
      CerrarASCII
    endif
  endif
endif
