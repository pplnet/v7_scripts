CAMPOS:1;;8
Especie        : 'Fondo'          ; 1;1; ;;  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'FONDOS');'Debe Ingresar un Fondo Comun';NO;;IF(VACIO(OPERACIONREF) o MODI,ESPECIE,OPREF.ESPECIE);;;;;;"Status = 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','FONDOS')~"%' and  "~DBO~".EsTerminalEspecie(Codigo)=1";
ContraEspecie  : 'Moneda'         ; 1;2; ;NO;  ; ;;;;CotizaEn(ESPECIE)
Cliente1       : 'Cliente'        ; 2;1; ;;  ;Eqstr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1), 'HAB');'Cliente Invalido' ;NO;;;;;;;;"Status Like 'HAB' ";
ContraEspecie2 : 'Moneda Liq.'    ; 2;2; ;;  ; ;;;;IF(EqStr(CAMPOEDITADO,'Especie'),IF(EqStr(CAMPOEDITADO,'Especie'),CotizaEn(ESPECIE),CONTRAESPECIE2),OPREF.CONTRAESPECIE2);;;;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ";
OficialCuenta  : 'Of.Cuenta'      ;  ;1; ;NO;;;;;;BuscarCampo('CLIENTES','OficialCuenta','Codigo',CLIENTE1)

Cantidad       : 'CuotasPartes'   ; 5;1; ; ; ;Cantidad > 0;'El campo debe ser positivo';NO;;ROUND(TOTALBRUTOCLI1/PRECIO1,4);;;;;'####,###,###,###.####'
Precio1        : 'Valor Cuota.'   ;  ; ; ;NO;;;;;;CotizacionC(ESPECIE,,,,FSYS,1,SI,CONTRAESPECIE2)
TotalBrutoCli1 : 'Monto'          ;  ; ; ;NO;;;;;;ROUND(CANTIDAD*PRECIO1,2);;;;;'####,###,###,###.##'
TotalNetoCli1  : 'Neto'           ;  ; ; ;NO;NO;;;;;TOTALBRUTOCLI1;

FechaOp        : 'Fecha Conc.'    ; 4;2; ;VerificaAcceso('OPFVALOR');;EsHabil(FECHAOP,TABLAFERIADOS1) y [FECHAOP <= if(Gtstr(Copy(Hora(Ahora),1,5),VTXT1),Habiles(FSYS,1, TABLAFERIADOS1, SI),FSYS)];'Fecha de Concertacion Incorrecta';NO;FSYS;if(Gtstr(Copy(Hora(Ahora),1,5),VTXT1),Habiles(FSYS,1, TABLAFERIADOS1, SI),FSYS)
TablaFeriados1 : 'Feriados'       ;  ;2; ;;;;;;VAR('FERIDEF')
Plazo          : 'Plazo'          ;  ;2; ;BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE)=0;;PLAZO>0;'Plazo de Liquidacion 0';SI;;BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE)/24;
FechaVto       : 'Fecha Liq.'     ;  ;2; ;;;;;;HABILES(FECHAOP,PLAZO,TABLAFERIADOS1);HABILES(FECHAOP,PLAZO,TABLAFERIADOS1);
Mercado        : 'Mercado'        ;  ;2;;;;;'Mercado Invalido';NO;;MercadoDef(ESPECIE)

Cuenta1    : 'Cta.Fon.Cli.';9 ;1;;;;NOVACIO(CUENTA1) ;'Cuenta Inversor del Cliente invalida' ;NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~CLIENTE1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~ESPECIE~"%' OR Especies LIKE '%FONDO%') AND TipoCuenta='INV' ")        ;;;;;;"Cliente = '"~CLIENTE1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~ESPECIE~"%' OR Especies LIKE '%FONDO%')  "
Cuenta2    : 'Cta.Mon.Cli.';9 ;2;;;;NOVACIO(CUENTA2) ;'Cuenta Moneda del Cliente invalida'   ;NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~CLIENTE1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta='CA' ");;;;;;"Cliente = '"~CLIENTE1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta='CA' "
Cliente3   : 'Custodio'    ;10;1;;;NO;SI;'Custodio Invalido'                    ;NO;;VAR('CUSRESTO');;;;;;"Status = 'HAB' and EsDepositante='SI' AND Codigo <> 'CAJA' ";
Cuenta3    : 'Cta.Fondo'   ;11;1;;;NO;SI ;'Cuenta Inversor del Vehiculo invalida';NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~VEHICULO1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~ESPECIE~"%' OR Especies LIKE '%FONDO%') AND TipoCuenta='INV' AND Mercado= '"~MERCADO~"' ");;;;;;"Cliente = '"~VEHICULO1~"' AND Estado = 'HAB' AND Mercado = '"~MERCADO~"'    AND (Especies LIKE '%"~ESPECIE~"%' OR Especies LIKE '%FONDO%') AND TipoCuenta = 'INV'  "

*Se deja el original previo a sacar mercado vista a vehículos. CAL 16/11/2022
*Cuenta4    : 'Cta.Moneda'  ;11;2;;;NO;SI ;'Cuenta Moneda del Vehiculo invalida'  ;NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~VEHICULO1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE3~"' ")         ;;;;;;"Cliente = '"~VEHICULO1~"' AND Estado = 'HAB' AND Comitente = '"~CLIENTE3~"' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%')  "
Cuenta4    : 'Cta.Moneda'  ;11;2;;;NO;SI ;'Cuenta Moneda del Vehiculo invalida'  ;NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~VEHICULO1~"' AND Estado = 'HAB' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE3~"' AND Mercado= '"~ IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE2,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(CONTRAESPECIE2, VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO)),MERCADO) ~"'")         ;;;;;;"Cliente = '"~VEHICULO1~"' AND Estado = 'HAB' AND Mercado = '"~ IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE2,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(CONTRAESPECIE2, VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO)),MERCADO) ~"' AND Comitente = '"~CLIENTE3~"' AND (Especies LIKE '%"~CONTRAESPECIE2~"%' OR Especies LIKE '%MONEDA%')  "

Vehiculo1  : 'Vehiculo'    ;13;1;;;;;;;;VAR('VEHICULODE')
Operador   :               ;13;2;;;;;;;USUARIOACTIVO;

CB5            : 'Fail'           ;1;1;2;NO;
Observac2      : 'Obs.Anulacion'  ;2;1;2;NO;INSTANCIA=30;
Autocotizada   : 'Comp_Saldos'    ;3;1;2;NO
PorComision    : 'Por.Comision'   ;4;1;2;NO;
TotalComisiones: 'Comision'       ;5;1;2;NO;

EnteCus2       : 'Categ_Cli'     ; ; ; ;NO;NO;EqStr(ENTECUS2,'CLI');'La operacion es valida solo para Clientes';NO;;BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1)
Vtxt2          : 'TipoEspecie'   ;4;1;2;NO;NO;NoVacio(VTXT2);'La Especie no posee un Tipo definido';NO;;BUSCARCAMPO('ESPECIES','Tipo','Codigo',ESPECIE)
TipoPosicion   : 'TipoPosicion'  ; ; ; ;NO;NO;;;;;BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE)

TotalAux1      : 'Saldo Cuotas P.';3;;2;NO;NO;;;;;SaldoC(CLIENTE1,ESPECIE,,,,,,CUENTA1,1,FECHAOP)
                                                 
Operador1      : 'Responsable'    ; ;;2;NO;NO
NrOperacion2   : 'Op.Relacionada' ; ;;2;NO;NO

Vtxt1 : 'Cut-Off Time'   ; ; ;2;NO;NO;
VCan1 : 'TipoCarteraCli' ;7;1;2;NO;NO;
VCan2 : 'TipoCarteraEsp' ;8;1;2;NO;NO;
VCAN3 : 'Pos. Especie'   ; ; ;2;NO;NO; 

CONDICIONES
 
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'El Fondo No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie2),'HAB');'La Moneda No esta Habilitada';NO

TotalBrutoCli1 >= BuscarCampo('Especies','Valor1','Codigo',Especie);'El Monto debe ser Mayor o Igual al Minimo del Fondo';SI;SI;FSYS;'OPERAT'
Cantidad <= TOTALAUX1;'La Cantidad de CuotasPartes Supera el Saldo Actual';SI;SI;FSYS;'OPERAT'
 
Precio1 <> 0;'La cotizacion del Fondo no puede ser cero';NO
Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

COTIZACION(ContraEspecie,,,,FECHAOP,1) <> 0;'La cotizacion de la ContraEspecie no puede ser cero';NO

MOVIMIENTOS
FechaVto;Cliente1 ;Especie        ;;;;Mercado;Vehiculo1;1;       Cantidad;;'Rescate de Fondos';SI;SI;1;NOVACIO(CUENTA1);1;CUENTA1;;1;'MMFCI'
FechaVto;Cliente1 ;ContraEspecie2 ;;;;       ;Vehiculo1;1;-TotalBrutoCli1;;'Rescate de Fondos';SI;SI;2;NOVACIO(CUENTA2);1;CUENTA2;;2;'MMFCI'

FechaVto;Vehiculo1;Especie        ;;;;Mercado;        ;1;      -Cantidad;;'Rescate de Fondos';SI;SI;1;NOVACIO(CUENTA3);11;CUENTA3;;3;'MMFCI'
FechaVto;Vehiculo1;ContraEspecie2 ;;;;       ;Cliente3;1; TotalBrutoCli1;;'Rescate de Fondos';SI;SI;2;NOVACIO(CUENTA4);11;CUENTA4;;4;'MMFCI'

