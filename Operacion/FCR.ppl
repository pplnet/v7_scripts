FechaOp ;Cliente1 ;ContraEspecie;;;;Vehiculo1;;;;;1; TotalBrutoCli1;COTIZACION(ContraEspecie,,,,FECHAOP,1);;;;RESPONSABLE1;BuscarCampo('TIPOSOPERACION','TipoNegocio','Codigo','MMFCR');Eqstr(EnteCus2,'CLI');;;;BuscarCampo('ESPECIES','Tipo','Codigo',ContraEspecie)
