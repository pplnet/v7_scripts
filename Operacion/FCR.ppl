FechaVto;Cliente1 ;ContraEspecie;;;;Vehiculo1;;;;;2; TotalBrutoCli1;COTIZACION(ContraEspecie,,,,FECHAOP,1);;;;RESPONSABLE1;BuscarCampo('TIPOSOPERACION','TipoNegocio','Codigo','MMFCR');Eqstr(EnteCus2,'CLI');;;;BuscarCampo('ESPECIES','Tipo','Codigo',ContraEspecie)
FechaVto;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;2; TotalBrutoCli1;COTIZACION(ContraEspecie,,,,FECHAOP,1);;;;RESPONSABLE1;BuscarCampo('TIPOSOPERACION','TipoNegocio','Codigo','MMFCR');Eqstr(EnteCus2,'CLI');;;;BuscarCampo('ESPECIES','Tipo','Codigo',ContraEspecie)

BAJA
SI o Query(" Select Count(*) From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~NROPERACION~"' ")=1000;'La Operacion Tiene Movimientos Liquidados.Poner el control cuando se liquide';

