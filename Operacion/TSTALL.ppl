CAMPOS:1;;4

FechaOp: 'Fecha Operacion';;;;

Cliente1: 'Cliente';1;1;;;;NOVACIO(CLIENTE1);'Debe ingresar un Cliente';NO;;;

Especie: 'Especie';1;1;;;;NOVACIO(ESPECIE);'Debe ingresar una Especie';NO;;;

Cantidad: 'Cantidad';;;;;;CANTIDAD > 0;'La Cantidad debe ser mayor a cero';NO

Precio1: 'Precio Unitario';;;;;;PRECIO1 > 0;'El Precio debe ser mayor a cero';NO

Vehiculo1: 'Vehiculo';;;;

Book1: 'Book';;;;

Precio3: 'Precio Ej.';;;;

Precio2: 'Total';;;;;;;;;;CANTIDAD * PRECIO1

Check1: 'Urgente';;;;;;;;;NO

CONDICIONES
PRECIO1 <= 2000;'El precio1 supera $2000.';NO

BITS
1;1
2;0
3;0
80;0

INSTANCIA1
CAMPOS:1;;4

Cliente1: 'Cliente';1;2;;;;NOVACIO(CLIENTE1);'Cliente es requerido';NO;;;
Especie: 'Especie';1;2;;;;NOVACIO(ESPECIE);'Especie es requerida';NO;;;
Cantidad: 'Cantidad';1;2;;;;CANTIDAD > 0;'La Cantidad debe ser positiva';NO
Precio1: 'Precio';1;2;;;;PRECIO1 > 0;'El Precio debe ser positivo';NO
Precio2: 'Total';;;;;;;;;;CANTIDAD * PRECIO1

BAJA
Precio1 > 1;'No se puede eliminar: la operacion tiene un valor cargado'

CONDICIONES
NoVacio(Observac);'Debe ingresar una observacion para avanzar';NO
CANTIDAD <= 500;'La cantidad supera el limite recomendado (500). Desea continuar?';SI;SI;FSys();'EXCESO';'Supero el limite de 500';SI;''
PRECIO1 <= 1500;'El precio1 supera $1500.';NO;SI;FSys();'MONTO PRECIO 1';'Precio1 excede limite';NO;''

BITS
1;0;FW=1 O FW=2
2;1;FW=1 Y CANTIDAD <= 100
3;1;FW=1 Y CANTIDAD > 100
80;1;FW=2

INSTANCIA2
CAMPOS:1;;4

Cliente1: 'Cliente';1;2;;;;NOVACIO(CLIENTE1);'Cliente es requerido';NO;;;
Especie: 'Especie';1;2;;;;NOVACIO(ESPECIE);'Especie es requerida';NO;;;
Cantidad: 'Cantidad';1;2;;;;CANTIDAD > 0;'La Cantidad debe ser positiva';NO
Precio1: 'Precio';1;2;;;;PRECIO1 > 0;'El Precio debe ser positivo';NO
Precio2: 'Total';;;;;;;;;;CANTIDAD * PRECIO1

BAJA
Precio1 > 1000;'No se puede eliminar: el precio1 es mayor a 1000'

CONDICIONES
PRECIO2 <= 10000;'El total supera $10.000. Esta seguro?';SI;SI;FSys();'MONTO';'Total excede limite';NO;''
PRECIO1 <= 1000;'El precio1 supera $1000.';NO;SI;FSys();'MONTO PRECIO 1';'Precio1 excede limite';NO;''

BITS
2;0;FW=1 O FW=2
5;1;FW=1
80;1;FW=2

INSTANCIA3

BAJA
Precio1 < 1000;'No se puede eliminar: el precio1 es menor a 1000'

BITS
3;0;FW=1 O FW=2
80;1;FW=2
5;1;FW=1

INSTANCIA5
CAMPOS:0;;4

Cliente1: 'Cliente';1;2;;;;;;;;
Especie: 'Especie';1;2;;;;;;;;
Cantidad: 'Cantidad';1;2;;;;;;;;
Precio1: 'Precio';1;2;;;;;;;;
Precio2: 'Total';;;;;;;;;;CANTIDAD * PRECIO1
Label1: 'Estado';;;;;;;;;;'FINALIZADA'

BAJA:
1 = 0;'No se puede eliminar una operacion finalizada'

BITS:
5;0;FW=2
2;1;FW=2 Y CANTIDAD <= 100
3;1;FW=2 Y CANTIDAD > 100



