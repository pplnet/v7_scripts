CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;;;FECHAOP2<=FECHAOP;'FECHA DE CONCERTACION INCORRECTA';NO;"15/01/2024";
FechaOp         : 'Fecha_Origen'               ;2;1;;;;;'FECHA DE ORIGEN INCORRECTA';;"15/01/2024";
MB2             : 'Clase|ON|CP'                ;4;1;;;;'INDICAR OBLIGACION NEGOCIABLE O COMERCIAL PAPER';NO;"1";"1"
RB10            : 'Precancelable|Si|No'        ;4;2;;;NO;;'Precancelable Si/No';NO;1; 
Vehiculo1     : 'Vehiculo'                 ; 1;2; ;;;;'El VEHICULO es INVALIDO';NO;'00000';;;If(Vacio(UsrVehiculos(UsuarioActivo)),SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Status ='HAB' "),SqlSet("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"));NO
Book1         : 'Book'                     ; 2;2; ;;;;'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo';NO;'ALBANESI';;;;;;;" (Vehiculo='"~VEHICULO1~"' OR Vehiculo is null) AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
PrecioRef     : 'Ref_Val'                  ;15;2;2;;;;'Indique Precio de Referencia';NO;VAR('TASADEFA');
PrecioRef4    : 'Ref_Val_Cont'             ;16;2;2;;;;'Indique Precio de Referencia para la ContraEspecie';NO;VAR('TASADEFA');


Operador        :                              ;3;2;;;;;'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Ent_Arranger'               ;5;1;;;;;'ENTIDAD ARRANGER INVALIDA';NO;"00161";
Observac2       : 'Op.Arranger'                ;5;2;;;;;'EL OPERADOR ARRANGER NO ES VALIDO';NO;'Cris';
Cliente2        : 'Ent_Agente'                 ;6;1;;;;;'ENTIDAD AGENTE INVALIDA';NO;"111";
Especie         : 'Moneda'                     ;;;;;;;'DEBE INGRESAR UNA MONEDA VALIDA';NO;'ARP';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cantidad        : 'Capital'                    ;;;;;;CANTIDAD>0;'CAPITAL INVALIDO';NO;30000;IF(CANTIDADORI<>0,CANTIDADORI,CANTIDADORI);
TotalComisiones : 'Comision EF'                ;;;;;;;;;;CANTIDAD*1/100;;;;;'###,###,###,###,###.##'
PrecioEj        : 'V. Nominal'                 ;;;;;;;;;;CANTIDAD+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
RB8             : 'Devengado|0|1|2|3|4'        ;;;;;;;;;;4
Cuotas2         : 'Cuotas'                     ;;;;;;;;;;3

MOVIMIENTOS
FechaOp;Cliente1;Especie ;;;;;Vehiculo1;1;-Cantidad;;'Alta ON';SI;;;;;Book1;;1;
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1; TotalComisiones;;IF(RB8=1,'Prima','Descuento')~' ON';SI;;;;;;;6;
FechaOp;Cliente1;Especie;;;;;Vehiculo1;1;Cantidad;;'Emision de Titulo' ;SI;NO;;;;Book1;;8;


LISTA:si;1;;
    Fecha1:           'Fecha Precan'             ;SI;;;;FechaOp2;;90;SI;Fecha
    Fecha2:           'Fecha Precan2'             ;SI;;;;Fsys;;90;SI;Fecha
    Total1:           'Capital Precan'           ;SI;;;;200;;200;;Numero;'###,###,###,###,###.##'
    Precio1:          'Interes Precan'           ;SI;;;;15;;200;;Numero;'###,###,###,###,###.##'
    Precio2:          'Prima/Descuento'          ;SI;;;;5;;200;;Numero;'###,###,###,###,###.##'
    
    
PRECANCELACION:SI;3;;
NrOperacion1:     'Op Precan'                ;SI;;;;;;90;SI;STRING;   
Fecha1:           'Fecha Precan'             ;SI;;;;FechaOp2;;90;SI;Fecha
Fecha2:           'Fecha Precan2'            ;SI;;;;Fsys;;90;SI;Fecha
Total1:           'Capital Precan'           ;SI;;;;100;;200;;Numero;'###,###,###,###,###.##'
Precio1:          'Interes Precan'           ;SI;;;;10;;200;;Numero;'###,###,###,###,###.##'
Precio2:          'Prima/Descuento'          ;SI;;;;6;;200;;Numero;'###,###,###,###,###.##'
NrCuota1:         'Cuota ON'                 ;SI;;;;Fila+1;;90;;Numero;'###'

DEVENGADOS
FechaOp;FSYS + 1;SI;SI;SI;'ARG';SI;SI;'INTLEN';-TotalComisiones;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;;Especie;;;;;;;;


DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila];CUOTASL.FECHA2[Fila];SI;SI;SI;'ARG';SI;SI;'dcuota';-TotalComisiones/2;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;

DEVENGADOSPRECANCELACIONES
PRECANL.Fecha1[Fila];PRECANL.Fecha2[Fila];SI;SI;SI;'ARG2';SI;SI;'DPREC';-TotalComisiones/2;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM2';;Fstr(Fila,0,0);Especie;

MOVCUOTAS
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1; CuotasL.Total1[Fila];'Vto.Monto ON';SI;SI;;SI;(Fila+500);Book1;;(Fila+500) ;'CUOTAS'

MOVPRECANCELACIONES
PrecanL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1; PrecanL.Total1[Fila];'Vto.Monto OFF';SI;SI;;SI;(Fila+500);Book1;;(Fila+500) ;'PRECAN'


BITS
1;1
10;0
14;0
16;0
17;0
50;0


INSTANCIA1
BITS
50;1;FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))
1;0;FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))
CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1);FW=1
FechaOp         : 'Fecha Conc.'                ;1;1;;NO
FechaOp2        : 'Fecha_Origen'               ;2;1;;NO
Vehiculo1       : 'Vehiculo'                   ;1;2;;NO
Book1           : 'Book'                       ;2;2;;NO 
   
Cliente1        : 'Entidad'                    ;4;1;;NO
Especie         : 'Especie'                    ;5;1;;NO
Cantidad        : 'Cantidad'                   ;6;1;;NO;;;;;;;;;;;'###,###,###,###,###.##';
FechaVto        : 'FechaVto'                   ;7;1;;NO
Plazo           : 'Plazo'                      ; ; ;;NO

TablaFeriados1  : 'Feriados'                   ;12;1;;NO 
Operador        :                              ;13; ;;NO


SQL
"UPDATE "~DBO~".OPERACIONES Set Fecha1 = '"~IdxDate(FSys)~"' where NrOperacion= '"~NrOperacion~"'"; FW=1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))

POSTEDICION
FW = 1 Y Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'));'WORFOP'; NrOperacion1=NrOperacion; Lista1='10|'; Entero1=1; Vehiculo1=Vehiculo1; Check1=1; String1=UsuarioActivo; Entero2=FW
EqStr(ABM,'D') y NoVacio(OPERACIONREF);'UPOPRE';NrOperacion1=OPERACIONREF
EqStr(ABM,'D') Y Eqstr(TIPOOP, 'MMSIMV');'ACTDIS';NrOperacion1=OPERACIONREF;NrOperacion2=NROPERACION;Cantidad1=VCAN3;Radio1=1
FW = 1 y Not Incluido(Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2')) Y [Eqstr(TIPOOP, 'TRANMM') O Eqstr(TIPOOP, 'TRANTI') O Eqstr(TIPOOP, 'TRANME')];'GENMT'; NrOperacion1 = NROPERACION; Radio1 = 1;