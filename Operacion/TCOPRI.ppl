BAJA
Vacio(NrOrden1) y Vacio(QUERY("Select NrOperacion from "~DBO~".PARTIDAS where NrOperacion='"~NROPERACION~"' "));'No se puede dar de baja, tiene una orden o partida asignada';

SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

