  Total1   : 'Monto Neto'     ;NO    ;  ;;;;(CUOTASL.TOTAL2[Fila]-CUOTASL.CANTIDAD4[Fila])   ;200;  ;Numero;'###,###,###,###,###.##'
  Precio4  : 'Tasa T.Neta'    ;NO    ;  ;SI Y [CUOTASL.Precio4[Fila]<=VAR('RTTN2') Y CUOTASL.Precio4[Fila]>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######';NO;NO;
  Precio6  : 'MOD IVA'        ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS2/100,0);200;;Numero;'###.######'
  Precio5  : 'MOD INT'        ;NO    ;NO;;;;IF(Fila<PlazoGracia,0,(CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500));200;;Numero;'###.######'
  Precio7  : 'MOD I P IVA'    ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TOTALAUX2/100,0);200;;Numero;'###.######'
  Precio8  : 'MOD IMP'        ;NO    ;NO;;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100,0);200;;Numero;'###.######'
  Fecha4   : 'F.Reset'        ;NO    ;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Tasa7    : '% Amort Orig'   ;NO;SI;;;IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),(100/CUOTAS1),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));IF(SUM(CUOTASL, 24)=0, CUOTASL.TASA1[Fila], CUOTASL.TASA7[Fila]);100;;Numero;'###,###.######';NO;NO;
  
  Cantidad10 :'Interes Ori'   ;NO;NO;;;CUOTASL.CANTIDAD3[Fila];CUOTASL.CANTIDAD3[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad11 :'Retencion Ori' ;NO;NO;;;CUOTASL.CANTIDAD4[Fila];CUOTASL.CANTIDAD4[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad7  :'Imp. IVA'   ;NO;NO;;;CUOTASL.CANTIDAD5[Fila];CUOTASL.CANTIDAD5[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad8  :'Imp_Neto_IVA Ori' ;NO;NO;;;CUOTASL.CANTIDAD6[Fila];CUOTASL.CANTIDAD6[Fila];;;Numero;'###,###,###,###,###.##'
  Total6  :'Imp_Perc_IVA Ori' ;NO;NO;;;CUOTASL.TOTAL5[Fila];CUOTASL.TOTAL5[Fila];;;Numero;'###,###,###,###,###.##'
  Total4  :'Imp.Int.Neto Ori' ;NO;NO;;;CUOTASL.TOTAL3[Fila];CUOTASL.TOTAL3[Fila];;;Numero;'###,###,###,###,###.##'
  Total7  :'Monto Ori' ;NO;NO;;;CUOTASL.TOTAL2[Fila];CUOTASL.TOTAL2[Fila];;;Numero;'###,###,###,###,###.##'
  Total8  :'Monto Neto Ori' ;NO;NO;;;CUOTASL.TOTAL1[Fila];CUOTASL.TOTAL1[Fila];;;Numero;'###,###,###,###,###.##'
  Precio1    :  'Precio1'       ;;NO;;;;;200;;Numero;'###,###,###,###,###.##';NO;NO;
  Precio3    :  'Precio3'       ;;NO;;;;;200;;Numero;'###,###,###,###,###.##';NO;NO;
@INDICEMMCT
*@INDICECTAS

@COMIOPMM

CONDICIONESCUOTAS
SI O [CUOTASL.PRECIO2[Fila]>=VPRE11 Y CUOTASL.PRECIO2[Fila]<=VPRE12];'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA ';
***---CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' esta fuera de rango' ;SI;SI;FSYS;'RTASA ';
SI O CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2');'La Tasa esta fuera de rango' ;SI;SI;FSYS;'RTASA ';

CONDICIONES
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es Dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
ESHABIL(FECHAVTO,'ARG');'La Fecha de Vencimiento NO ES DIA HABIL en Argentina';SI;SI;FSYS;'VTOINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
[DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=VAR('PLAZOBLOCA')] O [NOT DESCIENDEDECLIENTE(CLIENTE1,'BLOCAL') Y PLAZO>=0];"El Plazo es Invalido Banco Local>="~VAR('PLAZOBLOCA');NO
VACIO(OPERACIONREF) O [EQSTR(TIPOOP,BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF)) y BuscarCampo('Operaciones','FechaVto','NrOperacion',OPERACIONREF)=Fsys y EQSTR(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',OPERACIONREF),VEHICULO1) y EQSTR(ESPECIE,BuscarCampo('Operaciones','Especie','NrOperacion',OPERACIONREF))];'La Operacion de Referencia es INVALIDA';NO
SUM(CUOTASL,3)=PLAZO;'La Sumatoria de los Plazos Individuales DEBE SER IGUAL a la del Plazo Total';NO
Not DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O  Incluido(Fstr(IMPGASTOS1,2,2),VAR('LISTIMPU'));'El Valor de la Alicuota Impuesto es Erroneo: '~VAR('LISTIMPU')~' ...';NO
EQSTR(TIPOTASA,'FIJA') O [SPREAD>=VAR('RSPREAD1') Y SPREAD<=VAR('RSPREAD2')];'El Spread esta Fuera de Rango '~VAR('RSPREAD1')~' '~VAR('RSPREAD2');SI;SI;FSYS;'RANGOSPREAD'
SUM(CUOTASL,1)=100;' La Sumatoria de La Tasa de Amortizacion debe ser el 100%';SI
SI O [[DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0] O NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y IMPGASTOS1>=0]];'La Alicuota Impuesto  DEBE SER POSITIVA';NO
[NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))] O NOT [NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) Y INCLUIDO(FSTR(IMPGASTOS2,2,2),VAR('IVA'))];"El Valor de TASA IVA es Erroneo: "~VAR('IVA');NO
FECHAOP2 = Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP  = Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
%%ifdef BFSA
    **LIMITES
    @CONLIMBFSA
    *Cantidad Completada Órdenes
    @ORCCCA
%%else
    [NOT NOVACIO(CLIENTE1)] o ExisteLimite('COTOR',Cliente1,VTXT6); 'Lim.Credito no asignado';SI;SI;FSYS;'COTORNOAS'
    [NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('COTOR',Cliente1,VTXT6) o VtoLimite('COTOR',Cliente1,VTXT6) >= FechaOp; 'Lim.Credito vencido el '~FECHA(VtoLimite('COTOR',Cliente1,VTXT6));SI;SI;FSYS;'COTORVENC'
    [NOT NOVACIO(CLIENTE1)] o LimAsignado(Cliente1,'COTOR',VTXT6) >= VCAN7; 'Lim.Credito excedido '~PYC(-(LimAsignado(Cliente1,'COTOR',VTXT6)-VCAN7),1,0)~'.-';SI;SI;FSYS;'COTOREXCE'
%%endif
@CONDIOP

SI O Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR')) o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR')) o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR')) o EqStr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO


MOVIMIENTOS
FechaOp ;Cliente1;Especie ;;;;;Vehiculo1;1;Cantidad   ;;'Alta Colocacion a Plazo MV '~ESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;1;
FechaOp ;Cliente1;Especie ;;;;;Vehiculo1;1;PeriodoInts;;'Imp.DB/CR';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PeriodoInts<>0 Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;6;
FechaVto ;Cliente1;Especie ;;;;;Vehiculo1;1;-ResultadoIndice;;'Resultado Indice '~INDICE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));; [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;8;
FechaVto ;Cliente1;Especie ;;;;;Vehiculo1;1;TotalAux1   ;;'Penalidad x Precancelacion PF';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;9;
FechaOp ;Vehiculo1;Especie;;;;;Vehiculo1;50;-Cantidad;;'Colocacion a Plazo '~ESPECIE ;SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV') Y FechaOp>=Fecha(Var('FECHAMIGRA')) Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;10;;;;;;;;;;;;;;

FechaOp ;Cliente1;ContraEspecie5 ;;;;;Vehiculo1;1;Cantidad * Precio6 ;;'Alta Colocacion a Plazo MV Link '~ESPECIE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;1;
FechaOp ;Cliente1;ContraEspecie5 ;;;;;Vehiculo1;1;PeriodoInts * Precio6;;'Imp.DB/CR Link';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;PeriodoInts<>0  Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;6;
FechaVto;Cliente1;ContraEspecie5 ;;;;;Vehiculo1;1;-ResultadoIndice * Precio6;;'Resultado Indice Link'~INDICE;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;8;
FechaVto;Cliente1;ContraEspecie5 ;;;;;Vehiculo1;1;TotalAux1 * Precio6  ;;'Penalidad x Precancelacion PF Link';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NO Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;9;
FechaOp;Vehiculo1;ContraEspecie5;;;;;Vehiculo1;50;-Cantidad * Precio6;;'Colocacion a Plazo Link'~ESPECIE ;SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV') Y FechaOp>=Fecha(Var('FECHAMIGRA')) Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;10;;;;;;;;;;;;;;


POSICION
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;122;-Cantidad;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,VTXT40)  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132;-Cantidad;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,VAR('MONEEXTR'))  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));

MOVCUOTAS
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;TotalAux1 -CuotasL.Cantidad3[Fila];'Vto.Interes Colocacion a Plazo MV';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;[Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;(Fila+5000); SI
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1; CuotasL.Cantidad4[Fila];'Vto.Ret.Gan Colocacion a Plazo MV';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad4[Fila]<>0 Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;(Fila+7000);
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Cantidad1[Fila];'Vto.Capital Colocacion a Plazo MV';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad1[Fila]<>0 Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;(Fila+500);;;;;;;;;;;;;;600
CuotasL.Fecha2[Fila];Cliente1 ;Especie;;Vehiculo1;1;-CuotasL.Cantidad5[Fila];'Vto. IVA Colocacion a Plazo MV'   ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad5[Fila]<>0 Y NO Y [Vacio(INDICE) O Not Eqstr(TIPOGRACIA,'ULK')];;Cuenta1;;(Fila+3*CUOTAS1)+2;

CuotasL.Fecha2[Fila];Vehiculo1;Especie;;Vehiculo1;50;CuotasL.Cantidad1[Fila];'Vto.Capital Colocacion a Plazo MV';SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV');;Cuenta1;;(Fila+10000);;;;;;;;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;Vehiculo1;50;CuotasL.Cantidad3[Fila];'Vto.Interes Colocacion a Plazo MV';SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV');;Cuenta1;;(Fila+11000);;;;;;;;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;Vehiculo1;50;-CuotasL.Cantidad4[Fila];'Vto.Ret.Gan Colocacion a Plazo MV';SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV');;Cuenta1;;(Fila+12000);;;;;;;;
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;Vehiculo1;50;CuotasL.Cantidad5[Fila];'Vto. IVA Colocacion a Plazo MV';SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta1), 'INV');;Cuenta1;;(Fila+13000);;;;;;;;


CuotasL.Fecha2[Fila];Cliente1 ;ContraEspecie5;;Vehiculo1;1;TotalAux1*CuotasL.Cantidad17[Fila] -CuotasL.Cantidad14[Fila];'Vto.Interes Colocacion a Plazo MV Link';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;(Fila+5000); SI
CuotasL.Fecha2[Fila];Cliente1 ;ContraEspecie5;;Vehiculo1;1; CuotasL.Cantidad4[Fila]*CuotasL.Cantidad17[Fila];'Vto.Ret.Gan Colocacion a Plazo MV Link';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad4[Fila]<>0 Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;(Fila+7000);
CuotasL.Fecha2[Fila];Cliente1 ;ContraEspecie5;;Vehiculo1;1;-CuotasL.Cantidad13[Fila];'Vto.Capital Colocacion a Plazo MV Link';SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad1[Fila]<>0 Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;(Fila+500);;;;;;;;;;;;;;600
CuotasL.Fecha2[Fila];Cliente1 ;ContraEspecie5;;Vehiculo1;1;-CuotasL.Cantidad16[Fila];'Vto. IVA Colocacion a Plazo MV Link'   ;SI;Incluido(Vehiculo1,Var('VLIQUIDAA'));;CuotasL.Cantidad5[Fila]<>0 Y NO Y NoVacio(INDICE) Y Eqstr(TIPOGRACIA,'ULK');;Cuenta1;;(Fila+3*CUOTAS1)+2;

POSCUOTAS
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122; CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VTXT40)  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132; CuotasL.Cantidad1[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VAR('MONEEXTR'))  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;122; CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VTXT40)  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));
CuotasL.Fecha2[Fila];Vehiculo1;Especie;;;;Vehiculo1;;;;;132; CuotasL.Cantidad3[Fila];COTIZACIONC(ESPECIE,,,,CuotasL.Fecha2[Fila]-1,1,SI,VAR('MONEEXTR'))  ;;;VTXT19;;'FXS';Not Incluido(Especie,VTXT40~"|"~VAR('MONEEXTR'));

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];SI;SI;NO;TablaFeriados1;SI;SI;'INTLEN';CUOTASL.CANTIDAD3[Fila];140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'MM';;Fstr(Fila,0,0);Especie;

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
Not EqStr(CB9,'1');'La operacion debe ser eliminada a través del proceso de anulacion de plazo fijo'

POSTEDICION
@POSTEMM
@POSTERENT
%%ifdef BFSA
    SI;'DETRIE';TipoOp = TIPOOP;Especie1=ESPECIE;Cantidad1=CANTIDAD;Book1=BOOK1;NrOperacion=NROPERACION;Fecha1=FechaOp
    *Actualiza Ejecuciones cuando se da de alta la operación
    NoVacio(NRORDEN) Y Not EqStr(ABM,'D');'ACTEJE';NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=CANTIDAD;Radio1=0
    *Actualiza ejecuciones cuando se da de baja la operación. NOTA: El campo cantidad se invierte el signo en el evento
    NoVacio(NRORDEN) Y EqStr(ABM,'D');'ACTEJE';NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=CANTIDAD;Radio1=1
%%endif
    
SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";EqStr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";EqStr(ABM,'E')

LIMITES
%%ifdef BFSA
    FechaVto;Cliente1;'PF';VTXT25;;Cantidad*CotiOpLim;TipoOp~' '~Especie;RB15=1;;;Book1;;;;;Especie;;;    
%%else
    FechaOp2;Cliente1;'COTOR';VTXT6;; VCAN8;TipoOp~' '~Especie;NoVacio(Cliente1);
    Habiles(FechaVto,1,TablaFeriados1);Cliente1;'COTOR';VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Incluido(Vehiculo1,Var('VLIQUIDAA'));
    FechaVto;Cliente1;'COTOR';VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y NoVacio(Cliente1) y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not EqStr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');
%%endif

@INSTOPE
@INST19MM
@INST19BITS