VTXT15      : 'Alias4'          ; 7;2;2;NO;NO;;;;;IIF(NOVACIO(ESPECIE) THEN QUERY("Select Alias4 from "~DBO~".ESPECIES where Codigo = '"~ESPECIE~"' ") ELSE " " ENDIF)
Cambio4     : 'Monto'           ;16;2;1;NO;;;;;;IF(Eqstr(VTXT12,'CLE'),CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1))*PRECIO1*VPRE10,PRECIO1*CANTIDAD1);;;;;'##,###,###,###.##';
Cambio1     : 'Total'           ;17;2;1;NO;Eqstr(VTXT12,'CLE');;;;;CAMBIO4+CAMBIO3;;;;;'##,###,###,###.##';

Cambio2     : 'Tasa'            ; 7;1;2;CB6=0;Incluido('LETES',VTXT18);;;;;IF(Incluido('LETES',VTXT18),(1-PRECIO1)*36000/(FechaMaduracion(ESPECIE)-FECHA1),0)
Cambio3     : 'Interes'         ;  ;1;2;NO;Eqstr(VTXT12,'CLE');;;;;IF(Eqstr(VTXT12,'CLE'),VCAN5+CANTIDAD5,0)
VCAN5       : 'Ints.Capitaliz.' ;  ;1;2;NO;  ;;;;;InteresEspecieCap(ESPECIE,FECHA1,CANTIDAD1,,VPRE1,(1+IntsCapitalizados2(ESPECIE,FECHA1)),PRECIO1)
Cantidad5   : 'Ints.a Pagar'    ;  ;1;2;NO;  ;;;;;IF(Eqstr(VTXT15,'1585'),InteresEspecie(ESPECIE,FECHA1,CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1)))*PRECIO1,InteresEspecie(ESPECIE,FECHA1,CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1))))
VPRE3       : 'Tasa (%)'        ;  ;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(VFEC1>VFEC2 y VFEC1<=FECHA1,((VPRE7*IF(VCAN9=0 y VCAN10=0,Dif360(VFEC2,VFEC1-1,2),DifDias(VFEC2,VFEC1-1,'USA',NO)))+(VPRE8*(IF(VCAN9=0 y VCAN10=0,Dif360(VFEC1-1,FECHA1,2),DifDias(VFEC1-1,FECHA1,'USA',NO)))))/(IF(VCAN9=0 y VCAN10=0,Dif360(VFEC2,FECHA1,2),DifDias(VFEC2,FECHA1,'USA',NO))),VPRE4)*100;
VFEC2       : 'Ult.Cupon'       ;  ;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(EsHabil(UltCupon2(ESPECIE,FECHA1),'USA'),UltCupon2(ESPECIE,FECHA1),Habiles(UltCupon2(ESPECIE,FECHA1),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Especie),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Especie),'ANT'),-1,0)),'USA'))

VPRE4       : 'Tasa Default'    ; 1;2;2;NO;NO;;;;;IF(VFEC1<=VFEC2,VPRE8,VPRE7);
VFEC1       : 'FechaCambioTasa' ;  ;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)
VTXT12      : 'Clean/Dirty'     ;  ;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE)
VPRE1       : 'Tasa1'           ;  ;2;2;NO;NO;;;;;CampoAgenda(ESPECIE,CUPON1,4)
VPRE6       : 'ValorNominal'    ;  ;2;2;NO;NO;;;;;ValorNominal(ESPECIE)
VPRE10      : 'ValorTeorico2'   ;  ;2;2;NO;NO;;;;;ValorTeorico2(ESPECIE,FECHA1)
VPRE2       : 'Ints Cap'        ; 1;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','IntsCapitalizados','Codigo', ESPECIE)
VTXT18      : 'Ascend_Especie'  ;  ;2;2;NO;NO;;;;;Ascendientes('ESPECIES',ESPECIE)
VCAN9       : 'EspecDiasAnio'   ;  ;2;2;NO;NO;;;;;EspecieDiasAnio(ESPECIE)
VCAN10      : 'EspecDiasMes'    ;  ;2;2;NO;NO;;;;;EspecieDiasMes(ESPECIE)
VPRE7       : 'TasaIntAnterior' ; 2;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)
VPRE8       : 'TasaIntVigente'  ; 2;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE)

@DTPRTPAUXI
@TOCONTROL2

CONDICIONES
[VPRE12=1 y VCAN18>=CANTIDAD1] o VPRE12=0;'Se Excede el Saldo';NO
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ESPECIE),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA1),'HAB');'La Cuenta de Deposito No esta Habilitada';NO
EqStr(BuscarCampo('Cuentas','Comitente','Codigo',CUENTA1),VEHICULO1) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA1),VEHICULO1);'La Cuenta de Deposito No Pertenece al Vehiculo';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA1),'CUS|CCO');'La Cuenta de Deposito Debe ser una Cuenta de Custodia';NO
VACIO(CUENTA2) o EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA2),'HAB');'La Cuenta Origen No esta Habilitada';NO
VACIO(CUENTA2) o Incluido(BuscarCampo('Cuentas','TipoCuenta','Codigo',Cuenta2),'CUS|CCO');'La Cuenta Origen Debe ser una Cuenta de Custodia';NO
Not Eqstr(CUENTA1,CUENTA2);'Las Cuentas Son Iguales';NO;
Fecha1 > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(Fecha1,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(Fecha1);SI;SI;FSYS;'FECHAVAL'
DifDias(Fecha1,Fsys,'ARG',SI)<=Var('FVALORMAX');'Fecha Valor No Puede Superar '~Var('FVALORMAX')~' Dias';NO;
[VCan4<>0 y [Cantidad1 Mod2(VCan4)=0]] o VCan4=0;'La cantidad V.N. no es multiplo de la cantidad de Lamina minima';NO
[CB2=1 y VCAN2>=CANTIDAD1] o CB2=0;'Cantidad de Titulos Supera el Saldo '~PYC(VCAN2,0,2);NO;
[CB2=1 y VCAN11>=CANTIDAD1] o CB2=0;'Cantidad de Titulos Supera el Saldo '~PYC(VCAN11,0,2)~' a la fecha de hoy';NO;
[FECHAMADURACION(ESPECIE) >= FECHA1 y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie ya maduro';NO
[VCAN12=1 y VPRE20 >= 0 y [RB4=1 o RB4=2]] o VCAN12=0 o [RB4<>1 o RB4<>2] ;'La posicion investment no puede quedar vendida';NO 
NOVACIO(CUPON1);'El cupon esta Nulo, Corrija la Especie o la Agenda Cupon.';NO 
EqStr(CUPON1,'0') o VACIO(CUPON1) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC3>FECHA1;'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC3~') '; 
ClienteCuenta(CLIENTE1,CUENTA1,ESPECIE)                 ;'La Cuenta '~CUENTA1~' no corresponde al Cliente '~CLIENTE1~' o la Especie '~ESPECIE~'.';NO
ClienteCuenta(CLIENTE2,CUENTA2,ESPECIE) o Vacio(CUENTA2);'La Cuenta '~CUENTA2~' no corresponde al Cliente '~CLIENTE2~' o la Especie '~ESPECIE~'.';NO


BAJA
CB6<>1;'La Transferencia esta asociada a una liquidacion, no se puede anular manualmente.'

MOVIMIENTOS
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente1;IF(NoVacio(VTXT9) y CB1=1,VTXT9,Especie);;;;Mercado1;Vehiculo1;VCAN1; Cantidad1 ;;'Deposito de '~IF(NoVacio(VTXT9) y CB1=1 ,VTXT9,Especie);SI;[Fecha1<Fsys] O RB2=1;  ;      ;;Cuenta1;;1;'TI';;If(NoVacio(Cupon2),Cupon2,Cupon1)
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente2;Especie                                 ;;;;Mercado2;Vehiculo1;VCAN1;-Cantidad1 ;;'Retiro de '~Especie                                    ;SI;[Fecha1<Fsys] O RB2=1;  ;CB2=1 ;;Cuenta2;;2;'TI';;If(NoVacio(Cupon2),Cupon2,Cupon1)

IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente1;IF(NoVacio(VTXT9) y CB1=1,VTXT9,Especie);;;;Mercado1;Vehiculo1;VCAN6; Cantidad1 ;;'Deposito de '~IF(NoVacio(VTXT9) y CB1=1 ,VTXT9,Especie);SI;[Fecha1<Fsys] O RB2=1;  ;      ;;Cuenta1;;1;'TI';;If(NoVacio(Cupon2),Cupon2,Cupon1)
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente2;Especie                                 ;;;;Mercado2;Vehiculo1;VCAN6;-Cantidad1 ;;'Retiro de '~Especie                                    ;SI;[Fecha1<Fsys] O RB2=1;  ;CB2=1 ;;Cuenta2;;2;'TI';;If(NoVacio(Cupon2),Cupon2,Cupon1)

POSICION
Fecha1                                                      ;Cliente1;IF(NoVacio(VTXT9) y CB1=1,VTXT9,Especie);;;;Vehiculo1;;;Mercado1;;101; Cantidad1;Precio1;;;Book1;;'T';VCAN12=1 y CB6<>1;Cupon1;
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente1;IF(NoVacio(VTXT9) y CB1=1,VTXT9,Especie);;;;Vehiculo1;;;Mercado1;;102; Cantidad1;Precio1;;;Book1;;'T';VCAN12=1 y CB6<>1;If(NoVacio(Cupon2),Cupon2,Cupon1);
