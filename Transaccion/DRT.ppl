IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente1;Especie;;;;Vehiculo1;;;;;172; Cantidad1;PRECIO1*CotizacionC(CotizaEn(ESPECIE),,,,FECHA1,25,SI,VAR('MONELOCA'));;;Book1;;'T';VCAN12=1 y CB6<>1;If(NoVacio(Cupon2),Cupon2,Cupon1);
