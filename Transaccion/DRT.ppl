VFEC3       : 'F.CorteCupon'    ; 1;1;2;NO;NO;;;;;IIF(NOVACIO(ESPECIE) THEN Query("SELECT FechaCorte FROM  "~DBO~".AGENDACUPONES WHERE Especie = '"~ESPECIE~"' and NrCupon = '"~CUPON1~"' ") ELSE FSYS ENDIF)
VCAN13      : 'CobroMovCustodia';  ; ; ;NO;NO;;;;IIF(NOVACIO(CLIENTE1) THEN QUERY("Select 1 from "~DBO~".CLIENTES where CobroMovCustodia='SI' and Codigo='"~CLIENTE1~"' ") ELSE 0 ENDIF );QUERY("Select 1 from "~DBO~".CLIENTES where CobroMovCustodia='SI' and Codigo='"~CLIENTE1~"' ")
