Fecha1                                                      ;Cliente1;Especie;;;;Vehiculo1;;;;;191; Cantidad1;PRECIO1*CotizacionC(CotizaEn(ESPECIE),,,,FECHA1,25,SI,VAR('MONELOCA'));;;Book1;;'T';VCAN12=1 y CB6<>1;Cupon1;
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente1;Especie;;;;Vehiculo1;;;;;192; Cantidad1;PRECIO1*CotizacionC(CotizaEn(ESPECIE),,,,FECHA1,25,SI,VAR('MONELOCA'));;;Book1;;'T';VCAN12=1 y CB6<>1;If(NoVacio(Cupon2),Cupon2,Cupon1);
Fecha1                                                      ;Cliente2;Especie;;;;Vehiculo1;;;;;191;-Cantidad1;PRECIO1*CotizacionC(CotizaEn(ESPECIE),,,,FECHA1,25,SI,VAR('MONELOCA'));;;Book1;;'T';VPRE12=1 y CB6<>1;Cupon1;
IF(NoVacio(Fecha5),Fecha5,IF(NoVacio(Fecha3),Fecha3,Fecha1));Cliente2;Especie;;;;Vehiculo1;;;;;192;-Cantidad1;PRECIO1*CotizacionC(CotizaEn(ESPECIE),,,,FECHA1,25,SI,VAR('MONELOCA'));;;Book1;;'T';VPRE12=1 y CB6<>1;If(NoVacio(Cupon2),Cupon2,Cupon1);

