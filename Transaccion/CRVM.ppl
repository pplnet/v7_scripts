CAMPOS:1; ;23
Especie        : 'Moneda'    ;2;1; ;;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA');'Debe Ingresar una Moneda Valida';NO;;;;;;;;"Status = 'HAB' AND Tipo='MON' "
Cliente1       : 'Cliente'   ;3; ; ;;;;;;;BuscarCampo('CUENTAS','Cliente','Codigo',CUENTA1)

Cliente2       : 'Banco'      ;4;1;;;;Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE2),'BAN');'Banco invalido';NO;;;;;;;;" Sector='BAN' "
Cuenta1        : 'Cuenta'     ;5;1;;;;NoVacio(CUENTA1);'Cuenta Invalida';NO;;QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~CLIENTE1~"' AND Estado='HAB' AND (Especies LIKE '%"~ESPECIE~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~CLIENTE2~"' AND TipoCuenta IN ('CC','CA') ");;;;;;"Cliente = '"~CLIENTE1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies LIKE '%MONEDA%') and Estado='HAB' AND Comitente = '"~CLIENTE2~"' AND TipoCuenta IN ('CC','CA')  ";
VTXT2          : '#'          ;5;2;;NO;;;;;;BuscarCampo('CUENTAS','Numero','Codigo',CUENTA1);;;;;'XXXXXXXXXXXXXXXXXXXXXX'

Cantidad1      : 'Cantidad'  ;7;1; ;;;CANTIDAD1>0;'Cantidad Invalida';NO;

Fecha1         : 'Fecha Op'  ;2;2;;VerificaAcceso('OPFVALOR');  ;FECHA1 <= FSYS y EsHabil(FECHA1,'ARG');'Fecha Incorrecta';NO;FSYS;
ConceptoPago   : 'Concepto'  ;3;2;;;;Eqstr(BuscarCampo('CNCONCEPTOSPAGOCOBRO','TipoConcepto','Codigo',CONCEPTOPAGO),'CRE');'Concepto invalido';NO;;;;;;;;" TipoConcepto='CRE' ";

Vehiculo1      : 'Vehiculo'; 9;1;1;  ;;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
NrOperacionRef1: 'RTP/DTP' ; 9;2;1;NO;NOVACIO(NROPERACIONREF1)
Especie2       : 'Mon.Original'   ;10;1;1;NO;NOVACIO(NROPERACIONREF1)
Precio1        :  'Cotizacion'     ;11;1;1;NO;NOVACIO(NROPERACIONREF1)
Ley1           :  'Custodio'       ; 1;1;1;NO;NO;;;;;CLIENTE2;

CONDICIONES
Incluido(VEHICULO1, UsrVehiculos(USUARIOACTIVO))  o VACIO(UsrVehiculos(USUARIOACTIVO)); 'El usuario activo no esta habilitado para operar con el vehiculo '~VEHICULO1;NO
EspecieCuenta(ESPECIE, CUENTA1)  ;'La Moneda No Corresponde a la Cuenta seleccionada.';NO
ClienteCuenta(CLIENTE1, CUENTA1) ;'La Cuenta no corresponde al Cliente seleccionado. ';NO

BAJA
VACIO(NrOperacionRef1);'El Mov. de Fondos esta asociado a un Pago de Cupon, no se puede anular manualmente.'


MOVIMIENTOS
Fecha1;Cliente1;Especie;;;;BuscarCampo('CUENTAS','Mercado','Codigo',Cuenta1);Vehiculo1;1; Cantidad1;;'Credito de '~Especie;SI;NO;1;;;Cuenta1

BITS
110;1
111;0
70 ;0
30 ;0

INSTANCIA110
