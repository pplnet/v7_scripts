CAMPOS:1;;333
   Cliente:
   CantidadTotalOrden:
   *** No es necesario definir el campo con mismo casing que en la db
   especie:
   *** Dependencia de TipoOrden
   Cantidad1 : 'Cantidad1' ;;;;;;;;;;TIPOORDEN

EJECUCIONES:SI;2;
  Cantidad:    'Cantidad'    ;;;;;100;100;200;;Numero;'#';;;
  NrSecuencia: 'NrSecuencia' ;;;;;100;100;200;;Numero;'#';;;

SQL
   "UPDATE "~DBO~".ORDENES Set Leyenda1='CITI' Where NrOrden='"~NrOrden~"' ";SI

BITS
   1;1
   2;0

MOVIMIENTOS
   *** MOVPENDIENTE (Automatico en 'NO')
   Fecha('01/01/2015');"RIO";'USD';'PUT';Fecha('02/01/2015');2;'MERCAD';'ENTECU';1;100;101;'Venta';SI;NO;9;SI;9;'Cuenta';'TRANS';1;
   *** MOVEJECUTADO o MOVPENDIENTE (Automatico en 'SI' y fechasys es <= a FechaMov para que sea ejecutado)
   Fecha('01/01/2015');"RIO";'USD';'PUT';Fecha('02/01/2015');2;'MERCAD';'ENTECU';1;100;101;'Venta';SI;SI;9;SI;9;'Cuenta';'TRANS';1;


