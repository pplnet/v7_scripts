EJECUCIONES:CUOTAS1>0;CUOTAS1
  Fecha      : 'Fecha'        ;NO;;;;FSys;;85;NO;FECHA;
  Cantidad   : 'Cantidad'     ;EQSTR(ABM,'A');;EJECOL.CANTIDAD[Fila]>0 o CUOTAS1=0;'La cantidad debe ser positiva';;;110;;NUMERO;'###,###,###,###.##'
  Precio     : 'Precio'       ;EQSTR(ABM,'A');;EJECOL.PRECIO[Fila]>0 o CUOTAS1=0;'El precio debe ser positivo';;;100;;NUMERO;'###,###.########'
  NrSecuencia: 'NrSecuencia'  ;EQSTR(ABM,'A');;CUOTAS1=0 o [NoVacio(EJECOL.NRSECUENCIA[Fila]) Y EsNumero(EJECOL.NRSECUENCIA[Fila]) Y EJECOL.NRSECUENCIA[Fila]>0 Y Longitud(EJECOL.NRSECUENCIA[Fila])<=20];'El Nro. de Secuencia debe ser numerico, positivo y no debe superar los 20 digitos';;;80;;NUMERO;'##########'
  NrOperacion: 'NrOperacion'  ;NO;NoVacio(EJECOL.NROPERACION[Fila]);;;;;80;;STRING;
  Cantidad2  : 'CantXPrec'    ;EQSTR(ABM,'A');NO;;;;EJECOL.CANTIDAD[Fila]*EJECOL.PRECIO[Fila];110;NO;NUMERO;'###,###,###,###.##'

@INSOTICV
