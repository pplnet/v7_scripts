VPRE13: 'Interes Cash'    ;7;2;2;NO;VPRE15<>0;;;;;(VPRE1*VPRE7)
VPRE14: 'Interes Cap.'    ;8;2;2;NO;VPRE15<>0;;;;;(VPRE1*VPRE15*VCAN2)


