CAMPOS:1; ;215
Especie             : 'Especie'                ;1; ;;;;NoVacio(ESPECIE) Y DesciendeDeEspecie(ESPECIE,'TITULO');'Debe Ingresar una Accion';NO;;;;;;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' ";
Cliente             : 'Cliente'                ;2; ;;;;NoVacio(CLIENTE) y NOT DESCIENDEDECLIENTE(CLIENTE,'OTROS') y EsTerminal(CLIENTE,Cliente) ;'Debe Ingresar un Cliente Valido';NO;
CantidadTotalOrden  : 'Cantidad VN'            ;3; ;;;;CANTIDADTOTALORDEN>0 Y CANTIDADTOTALORDEN>=BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE);'Debe Ingresar un VN positivo';NO;;;;;;;'###,###,###,###.##';
PrecioLimite        : 'Precio Limite'          ;5; ;;;;;;;;;;;;;'###,###,###.######';;
Plazo1              : 'Plazo'                  ;3;2;;NO;NO;;;;IF(RB5=0,0,IF(RB5=1,1,2));IF(RB5=0,0,IF(RB5=1,1,2))
RB5                 : 'Plazo|'~VAR('PLAZOLIQ') ;3; ; ;  ;  ;RB5>=0;'Plazo Incorrecto';NO;0;IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'0'),0,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'24'),1,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'48'),2)))
Cantidad2           : 'Cant VN Minima'         ;4;1;;NO;;CANTIDAD2>0 Y CANTIDAD2>=BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE);'La Especie no tiene lamina minima cargada';NO;1;IF(MODI,CANTIDAD2,BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE));;;;;'###,###,###,###.##';

Mercado3            : 'M. Negociac.'           ;6;;;;;IF(CB7=1,NoVacio(MERCADO3));'Debe ingresar Merc. Negociacion';NO;;;;;;;
Mercado             : 'M. Liq. Especie'        ; ;;;;;;;;;IF(NoVacio(MERCADO3),IF(EQSTR(MERCADO3,'BYMA'),'CV',IF(Caracteristica(CLIENTE,'CE'),'CE',IF(Caracteristica(CLIENTE,'CV'),'CV',MercadoDef(ESPECIE)))));;;;;
Mercado2            : 'M. Liq. Mon'            ; ;;;;;;;;;IF(NoVacio(MERCADO3),IF(EQSTR(MERCADO3,'BYMA'),'BCRA',MercadoDef(CONTRAESPECIE)));;;;;
Mercado4            : 'Ubicacion'              ; ;;;NO;NO;;;;'CV';;;;;;
RB10                : 'F. Liquidacion|FOP|DVP|RVP';10;;;;;RB10>=0;'Debe Indicar F. Liquidacion';NO;0;
PrecioReal          : 'P. Mayorista'           ; ;;;NO;;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAORDEN,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE,,,,FECHAORDEN,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE,,,,FECHAORDEN,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAORDEN,1,SI,'ARP'))
Vehiculo            : 'Vehiculo'               ;13;;;;;NoVacio(VEHICULO);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE');;

ContraEspecie       : 'Moneda'                 ;1;2;;;;NoVacio(CONTRAESPECIE);'Debe ingresar la Moneda';NO;;CotizaEn(ESPECIE);;;;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' "
FechaOrden          : 'Fecha Orden'            ; ; ;;;;EsHabil(FECHAORDEN,'ARG') Y FECHAORDEN<= FSYS y FECHAORDEN>= Habiles(FSYS,-Var('FVALORACC'),'ARG');'Maxima Fecha Valor Excedida';NO;FSYS;;;;;;
FechaVto            : 'Fecha Liq.'             ;4; ;;NO;;EsHabil(FECHAVTO,'ARG');'Fecha Vto. Incorrecta';NO;FSYS;Habiles(FECHAORDEN,PLAZO1,'ARG',SI);;;;;
TotalAux1           : 'T. Cbio. Pos.'          ; ; ;;;NO Y Not Eqstr(CONTRAESPECIE, BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE));IF(Not Eqstr(CONTRAESPECIE, BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE)),TOTALAUX1>0);'Debe ingresar Tipo de Cambio Posicion';NO;;COTIZACION(Var('MONEEXTR'),,,,FECHAORDEN-1,1,SI);;;;;'###,###,###.######';;
TotalAux2           : 'T. Cbio. Pos.'          ; ; ;;;NO;;;;;TOTALAUX1*100;;;;;'###,###,###.######';;
VCAN2               : 'T. Cbio. Pos.'          ; ;;;;NO;;;;TIPOCAMBIO2*100;TIPOCAMBIO2*100;;;;
TipoCambio2         : 'T. Cbio. Pos.'          ; ;;;;NO;;;;VCAN2/100;VCAN2/100;;;;


Book1               : 'Cartera'                ;6;;;;;IF(EQSTR(CLIENTE,VEHICULO),NoVacio(BOOK1));'Debe Ingresar la Cartera';NO;BookDefault2(VEHICULO,TIPOORDEN,'',ESPECIE,'','','','','HAB')
Operador            : 'Usuario'                ; ;;;NO;;;;;USUARIOACTIVO;
Operador1           : 'Operador'               ; ;;;;;;;;USUARIOACTIVO;
CB8                 : 'Anul Conting'           ; ;;;NO;NO;
CB10                : 'Bonificada'             ; ;;;;;
CB7                 : 'Contingencia'           ; ;;;;;
Cantidad3           : 'Cant. Ejec.'            ; ;;;CB7=1;CB7=1;CANTIDAD3>=0;'La Cant. de Ejecuciones no puede ser negativa';NO;;;;;;;'#####';;
NroAltaMAE          : 'Nro. Secuencia'         ; ;;;CANTIDAD3=0;CB7=1;Vacio(NROALTAMAE) O [NoVacio(NROALTAMAE) Y EsNumero(NROALTAMAE) Y NROALTAMAE>0 Y Longitud(NROALTAMAE)<=20];'El Nro. de Secuencia debe ser numerico, positivo y no debe superar los 20 digitos';NO;;;;;;;'##,###,###,###,###,###,###'
Cantidad1           : 'Tot. Cant. VN Ej.'      ; ;;;CANTIDAD3=0;CB7=1;CB7=0 O [CB7=1 Y CANTIDAD1>0 Y CANTIDAD1<=CANTIDADTOTALORDEN];'El Total ejecutado debe ser positivo y menor o igual al VN';NO;;SUM(EJECOL,2);
Cantidad4           : 'Precio Promedio'        ; ;;;CANTIDAD3=0;CB7=1;CB7=0 O [CB7=1 Y CANTIDAD4>0];'El Precio Promedio debe ser positivo';NO;;SUM(EJECOL,6)/SUM(EJECOL,2);;;;;'###,###,###.######';
UDN1                : 'Rueda'                  ; ;;;NO;NO;
NrOperacion2        : 'NrOperacion'            ; ;;;NO;NO;
CB6                 : 'Cot. Esp/ContDirecta'   ; ;;;NO;NO;;;;;IF(EqStr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)

Estado              : 'Estado'                 ; ;;;NO;NO;


@TODEVOLUC

@TOSALDOSEC

VTXT10              : 'Cupon'                  ;10;1;2;NO;NO;;;;;NrCupon2(ESPECIE,FECHAORDEN)
VFEC4               : 'F.CorteCupon'           ; 1;1;2;NO;NO;;;;;Query("SELECT FechaCorte FROM  "~DBO~".AGENDACUPONES WHERE Especie = '"~ESPECIE~"' and NrCupon = '"~VTXT10~"' ")

CONDICIONES
CANTIDAD2<=CANTIDADTOTALORDEN;'El VN Minimo debe ser menor o igual al VN';NO
[(CANTIDADTOTALORDEN MOD BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0];'El VN debe ser Multiplo de Lamina Minima';NO
EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA1),'HAB');'La Cuenta No esta Habilitada';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA1),'CUS|CCO');'La Cuenta debe ser una Cuenta de Custodia';NO
EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA4),'HAB');'La Cuenta No esta Habilitada';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA4),'CC|CA|');'La Cuenta debe ser una Cuenta de moneda';NO
PRECIOLIMITE<= PRECIOREAL*(1+VAR('RPRECIO2')/100) Y PRECIOLIMITE>=PRECIOREAL*(1-VAR('RPRECIO2')/100);'Precio Fuera de Rango: '~FSTR((PRECIOREAL*(1-VAR('RPRECIO2')/100)),1,7)~' y '~FSTR((PRECIOREAL*(1+VAR('RPRECIO2')/100)),1,7);NO

PRECIOLIMITE<= PRECIOREAL*(1+VAR('RPRECIO') /100) Y PRECIOLIMITE>=PRECIOREAL*(1-VAR('RPRECIO') /100);'PRECIO FUERA DE RANGO: '~FSTR((PRECIOREAL*(1-VAR('RPRECIO')/100)),1,7)~' y '~FSTR((PRECIOREAL*(1+VAR('RPRECIO')/100)),1,7);SI;SI;FSYS;'RANGOPRECI'
VACIO(VTXT10) o EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'PRI') o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAORDEN;'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI;SI;FSys;'CUPONANT'
[FECHAMADURACION(ESPECIE) >= FECHAORDEN y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie esta vencida';SI;SI;FSys;'CUPONPAG'

@TOMOVIMSEC

EJECUCIONES:CANTIDAD3>0 O [NOT EQSTR(ABM,'A') Y CANTIDAD3=0];CANTIDAD3;
  Fecha      : 'Fecha'        ;NO;;;;FSys;;85;NO;FECHA;
  Cantidad   : 'Cantidad'     ;  ;;EJECOL.CANTIDAD[Fila]>0;'La cantidad debe ser positiva';;;110;;NUMERO;'##,###,###.##'
  Precio     : 'Precio'       ;  ;;EJECOL.PRECIO[Fila]>0;'El precio debe ser positivo';;;100;;NUMERO;'###,###.########'
  NrSecuencia: 'NrSecuencia'  ;  ;;Vacio(EJECOL.NRSECUENCIA[Fila]) O [NoVacio(EJECOL.NRSECUENCIA[Fila]) Y EsNumero(EJECOL.NRSECUENCIA[Fila]) Y EJECOL.NRSECUENCIA[Fila]>0 Y Longitud(EJECOL.NRSECUENCIA[Fila])<=20];'El Nro. de Secuencia debe ser numerico, positivo y no debe superar los 20 digitos';;;80;;STRING;
  NrOperacion: 'NrOperacion'  ;NO;NoVacio(EJECOL.NROPERACION[Fila]);;;;;80;;STRING;
  Cantidad2  : 'CantXPrec'    ;  ;NO;;;;EJECOL.CANTIDAD[Fila]*EJECOL.PRECIO[Fila];110;NO;NUMERO;'##,###,###.##'


