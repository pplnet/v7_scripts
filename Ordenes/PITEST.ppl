CAMPOS:1;;BuscarCampo('VEHICULOS','Alias2','Codigo',Vehiculo)
FechaOrden            :'Fecha Propuesta'        ;2;1;1;NO;;;;;FSYS
FechaEjercicio        :'Fecha Disponibilidad'   ;;1;1;;;;;;FSYS
Vehiculo              :'Vehiculo'               ;2;2;1;EqStr(ABM,'A');;NoVacio(VEHICULO) Y  Incluido(VEHICULO,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo~"' and Status ='HAB' ")) y [Vacio(UsrVehiculos(UsuarioActivo)) o Incluido(VEHICULO,SqlSet("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))];'El VEHICULO es INVALIDO';NO;;;;;;;;IF(Vacio(UsrVehiculos(UsuarioActivo)),  " Status ='HAB' " ,  " Codigo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"')")
Book1                 :'Book'                   ;3;2;1;;;NoVacio(BOOK1);'Se debe completar el campo Book';NO;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO);BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO);;;;;;" Vehiculo='"~VEHICULO~"'";
Plazo1                :'Plazo Inversion'        ;;2;1;;;
Especie               :'Moneda'                 ;5;1;1;;;NoVacio(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA');'Debe ingresar una Especie';NO;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~")and Status = 'HAB' ";;;;;; 
CantidadTotalOrden    :'Cantidad'               ;;1;1;;;CANTIDADTOTALORDEN>0;'La cantidad debe ser mayor que 0';NO
Cliente               :'Banco'                  ;;1;1;;;NoVacio(CLIENTE);'Se debe completar el campo Banco';NO;;;;;;;;"Status = 'HAB'";;;;; 
Cuenta1               :'Cuenta'                 ;;2;1;NoVacio(ESPECIE);NoVacio(ESPECIE);Vacio(ESPECIE) o [NOVACIO(CUENTA1) y [[[CLIENTECUENTA(VEHICULO,CUENTA1)] y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'HAB')]]];"Se debe completar el campo con una Cuenta Valida";SI;IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,'','HAB'), CUENTA1);IF(Eqstr(ABM, 'A'),CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,'','HAB'), CUENTA1);;;;;;"Cliente='"~VEHICULO~"' and Estado = 'HAB' and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT1,Elementos(VTXT1))~"%')"  
CB1                   :'Requiere Instruccion'   ;;1;1;NO;;;;;;BuscarCampo('BOOKS','CB1','Codigo',BOOK1);;      
CB2                   :'Instruccion'            ;;1;1;CB1<>1;;;;;;IF(CB1=1,1,0);;;;;;
Operador              :                         ;;2;1;NO;;NoVacio(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
VTXT1                 : 'Ascend. ContraE'       ;;2;;NO;NO;;;;Ascendientes('ESPECIES',ESPECIE);Ascendientes('ESPECIES',ESPECIE)
CantidadCompletada    : 'Cantidad Completada'   ;6;2;;NO;SI;


CONDICIONES
CB1 = 0 O NoVacio(OBSERVACIONES);'Se debe especificar al menos una observacion';NO

EJECUCIONES:SI;LOTES
  NrEjecucion       : 'NrEjec'              ;NO;;;;;;45;;NUMERO;'###,###,###,###'
  NrOperacion       : 'NrOperacion'         ;NO;;;;;;80;;STRING;30
  NrOrden           : 'Orden'               ;NO;NO;;;;;80;;STRING;30
  TipoOp            : 'TipoOp'              ;NO;;;;;;80;;Tabla;'TIPOSOPERACION';'Codigo';'Codigo;Nombre' ;
  Fecha1            : 'FechaOp'             ;NO;;;;;;85;NO;FECHA;
  Fecha2            : 'FechaVto'            ;NO;;;;;;85;NO;FECHA;
  Cantidad          : 'Cantidad'            ;NO;;;;;;110;;NUMERO;'###,###,###,###.##'
  Cliente1          : 'ContraParte'         ;NO;;;;;;90;;STRING;30

BAJA
(BuscarCampo('ORDENES','Lotes','NrOrden',NRORDEN)= 0);'No se puede dar de baja una Orden con Operaciones Asignadas' 

