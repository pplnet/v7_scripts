CAMPOS:1; ;220;1

Especie                : 'Especie'        ;1;1;;;;NoVacio(ESPECIE) y [DesciendeDeEspecie(ESPECIE,'TITULO') o DesciendeDeEspecie(ESPECIE,'CUPON')] y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie';NO;;;;;;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' AND Jerarquia Not Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
ContraEspecie          : 'Contraespecie'  ;1;2;;;;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA');'Debe Ingresar una ContraEspecie';NO;;CotizaEn(ESPECIE);;;;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' "
Cliente                : 'Cliente'        ;2;1; ;;;NoVacio(CLIENTE) y Incluido(Ascendientes('CLIENTES', CLIENTE),VAR('CLIORDEN'),1) y EsTerminal(CLIENTE,Cliente) y EqStr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE),'HAB');'Debe Ingresar un Cliente Valido';NO;;
VTXT2             : 'TipoCliente'         ;3;1;1;NO;NO;;;;;BUSCARCAMPO('CLIENTES','TipoCliente','Codigo',CLIENTE)

CantidadTotalOrden     : 'Cantidad VN.'   ;4;1; ;RB2=0 y EqStr(ABM,'A');;CANTIDADTOTALORDEN>=0;'Debe Ingresar una Cantidad  En Valor NOMINAL';NO;

*MontoArancel      : 'Monto Comision'     ;10;1;1;SI;SI;;;;0;MontoArancelC(TIPOORDEN,CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADTOTALORDEN,0,,VTXT2,SI);;;;;'###,###,###,###.##';
Cantidad1              : 'Monto Comision'     ;5;1;1;SI;SI;;;;0;MontoArancelC('TIC',CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADTOTALORDEN,0,,VTXT2,SI,,,,,SI,SI)
Vehiculo               : 'Vehiculo '     ;7;1;;  ;;NoVacio(VEHICULO);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')

CONDICIONES
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE),'HAB');'El cliente No esta Habilitado';NO
