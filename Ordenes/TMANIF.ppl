Cotizacion1: 'Cot.USD/Emision' ;19;1;2;NO;SI;;;;;IF(Not EqStr(CONTRAESPECIE,VAR('MONELOCA')),COTIZACIONC(CONTRAESPECIE,,,,FECHAORDEN,25,SI,VAR('MONELOCA')),1);;;;;"####.##########"
VTXT16      : 'COND IVA'       ;22;1;1;NO;NO;;;;;BuscarCampo('CLIENTES','CondicionIVA','Codigo',VEHICULO)

Impuestos   : 'IVA Com/100'    ;23;2;2;NO;NO;;;;0;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,MontoImpuesto('IVARGCOM',FECHAORDEN,3,VTXT16)/100,0);;;;;'############.####';
Cantidad10  : '%Comision'      ; 4;2;2;NO;SI;;;;;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,MontoArancelC('TCOPRI',CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADENPROCESO*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1),4,,VTXT1,SI,,MERCADO4,,,SI,SI,,SI),0);;;;;'#,###.######';
MontoArancel: 'Monto Comision' ; 5;2;2;NO;  ;;;;0;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,MontoArancelC('TCOPRI',CLIENTE,ESPECIE,VEHICULO,'AOPER',CANTIDADENPROCESO*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1),0,,VTXT1,SI,,MERCADO4,,,SI,SI,,SI),0);;;;;'###,###,###,###.##';
IvaArancel  : 'IVA Comision'   ; 6;2;2;NO;  ;;;;0;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,MontoArancel*IMPUESTOS,0);;;;;'###,###,###,###.##';
vCan44      : 'Derecho Merc'   ; 6;2;2;NO;NO;;;;;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,IvaGastos('TCOPRI',ESPECIE,VEHICULO,'DMERC',0,,Mercado4));
MontoGastos : 'Derechos'       ; 7;2;2;NO;  ;;;;0;IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,CANTIDADENPROCESO*PRECIOLIMITE*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,COTIZACION1)*MontoGastos('TCOPRI',ESPECIE,VEHICULO,'DMERC',0,4,,Mercado4)/100,0);;;;;'###,###,###,###.##';
IvaGastos   : 'IVA Derechos'   ; 8;2;2;NO;  ;;;;0;if(vCan44=1,IF(CANTIDADENPROCESO<>0 y PRECIOLIMITE<>0,MontoGastos*IMPUESTOS,0),0);;;;;'###,###,###,###.##';
*-----------------------

CONDICIONES
[Vacio(HORALIMITE) o EqStr(HORALIMITE,'00:00:00')] o HORA24(HORALIMITE)>=HORA24(HORAORDEN); 'Hora Limite '~HORALIMITE~' Erronea debe ser >= '~HORA24(HORAORDEN);NO
[Vacio(VTXT12) o EqStr(VTXT12,'00:00:00')] o HORA24(HORALIMITE)>=HORA24(VTXT12); 'Hora Limite '~HORALIMITE~' Erronea debe ser >= '~HORA24(VTXT12);NO
[Vacio(VTXT12) o EqStr(VTXT12,'00:00:00')] o HORA24(HORAORDEN)>=HORA24(VTXT12); 'Hora Orden '~HORAORDEN~' Erronea debe ser >= '~HORA24(VTXT12);NO
[Vacio(VTXT13) o EqStr(VTXT13,'00:00:00')] o HORA24(HORALIMITE)<=HORA24(VTXT13);'Hora Limite '~HORALIMITE~' Erronea debe ser <= '~HORA24(VTXT13);NO
[Vacio(VTXT13) o EqStr(VTXT13,'00:00:00')] o HORA24(HORAORDEN)<=HORA24(VTXT13);'Hora Orden '~HORAORDEN~' Erronea debe ser <= '~HORA24(VTXT13);NO
EqStr(VTXT20,'0') o VACIO(VTXT20) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAORDEN;'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI;SI;FSys;'CUPONANT'
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE),'HAB');'El cliente no esta Habilitado';NO
EsTerminal(ContraEspecie,Especie);'La Contraespecie No puede ser una Jerarquia';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La Contraespecie No esta Habilitada';NO
FechaOrden > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(FechaOrden,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOrden);SI;SI;FSYS;'FECHAVAL'
DifDias(FechaOrden,Fsys,'ARG',SI)<=Var('FVALORMAX');'Fecha Valor No Puede Superar '~Var('FVALORMAX')~' Dias';NO;
[VCan8<>0 y (CantidadTotalOrden Mod2(VCan8))=0] o VCan8=0;'La Cantidad V.N. no es multiplo de la Lamina minima '~PYC(VCan8,0,2);NO
[FECHAMADURACION(ESPECIE) >= FECHAORDEN y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie esta vencida';SI;SI;FSys;'CUPONPAG'
CantidadTotalOrden>=VCan1 y CantidadTotalOrden<=VCan2;'Cantidad VN debe estar entre '~PYC(VCan1,1,2)~' y '~PYC(VCan2,1,2);NO

Vacio(VTXT11) o VCAN11 = 1 o CB9=0 o ExisteLimite('PRESETTLEM',VTXT11,'USD')                                                                                                    ; 'PreSettlement Cliente '~VTXT11~' no asignado'                                                                                                                                                                  ;SI;SI;FSYS;'PRESETNOAS'
Vacio(VTXT11) o VCAN11 = 1 o CB9=0 o Not ExisteLimite('PRESETTLEM',VTXT11,'USD') o VtoLimite('PRESETTLEM',VTXT11,'USD') >= FechaOp                                              ; 'PreSettlement Cliente '~VTXT11~' vencido el '~FECHA(VtoLimite('PRESETTLEM',VTXT11,'USD'))                                                                                                                      ;SI;SI;FSYS;'PRESETVENC'
Vacio(VTXT11) o VCAN11 = 1 o CB9=0 o Not LimCancelado('PRESETTLEM',VTXT11,'USD')                                                                                                ; 'PreSettlement Cliente '~VTXT11~' cancelado'                                                                                                                                                                    ;SI;SI;FSYS;'PRESETCANC'
Vacio(VTXT11) o VCAN11 = 1 o CB9=0 o LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO)>=LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO,,,NROPERACION)+VCAN7; 'PreSettlement Cliente '~VTXT11~' excedido en U$D '~PYC(LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO,,,NROPERACION)+VCAN7-LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO),0,2)         ;SI;SI;FECHAORDEN;'PRESETEXCE';

Vacio(VTXT10) o VCAN10=1 o CB9=0 o ExisteLimite('PRESETTLEM',VTXT10,'USD')                                                                                                    ; 'PreSettlement Grupo (Controlante '~VTXT10~') no asignado'                                                                                                                                                                   ;SI;SI;FSYS;'PRESETNOAS'
Vacio(VTXT10) o VCAN10=1 o CB9=0 o Not ExisteLimite('PRESETTLEM',VTXT10,'USD') o VtoLimite('PRESETTLEM',VTXT10,'USD') >= FechaOp                                              ; 'PreSettlement Grupo (Controlante '~VTXT10~') vencido el '~FECHA(VtoLimite('PRESETTLEM',VTXT10,'USD'))                                                                                                                       ;SI;SI;FSYS;'PRESETVENC'
Vacio(VTXT10) o VCAN10=1 o CB9=0 o Not LimCancelado('PRESETTLEM',VTXT10,'USD')                                                                                                ; 'PreSettlement Grupo (Controlante '~VTXT10~') cancelado'                                                                                                                                                                     ;SI;SI;FSYS;'PRESETCANC'
Vacio(VTXT10) o VCAN10=1 o CB9=0 o LimAsignado(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO)>=LimConsumido(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO,,,NROPERACION)+VCAN7; 'Excede el limite de Presettl. Grupo (Controlante '~VTXT10~') en U$D '~PYC(LimConsumido(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO,,,NROPERACION)+VCAN7-LimAsignado(VTXT10,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO),0,2) ;SI;SI;FECHAORDEN;'PRESETEXCE'

Vacio(VTXT25) o Not EqStr(VTXT7,'1') o ExisteLimite('ISSUER',VTXT25,'USD')                        ; 'Limite Issuer '~VTXT25~' no asignado'                                          ;SI;SI;FSYS;'ISSUERNOAS'
Vacio(VTXT25) o Not EqStr(VTXT7,'1') o NOT ExisteLimite('ISSUER',VTXT25,'USD') o VFEC15 >= FechaOp; 'Limite Issuer '~VTXT25~' vencido el '~FECHA(VFEC15)                            ;SI;SI;FSYS;'ISSUERVENC'
Vacio(VTXT25) o Not EqStr(VTXT7,'1') o NOT LimCancelado('ISSUER',VTXT25,'USD')                    ; 'Limite Issuer '~VTXT25~' Cacnelado'                                            ;SI;SI;FSYS;'ISSUERCANC'
Vacio(VTXT25) o Not EqStr(VTXT7,'1') o VCAN15 >= VCAN25 + TOTALAUX1                               ; 'Limite Issuer '~VTXT25~' excedido en U$D '~PYC(VCAN25 + TOTALAUX1 - VCAN15,0,2);SI;SI;FECHAORDEN;'ISSUEREXCE'

Vacio(VTXT26) o Not EqStr(VTXT7,'1') o ExisteLimite('COUNTRY',VTXT26,'USD')                        ; 'Limite Country '~VTXT26~' no asignado'                                          ;SI;SI;FSYS;'COUNTRNOAS'
Vacio(VTXT26) o Not EqStr(VTXT7,'1') o NOT ExisteLimite('COUNTRY',VTXT26,'USD') o VFEC16 >= FechaOp; 'Limite Country '~VTXT26~' vencido el '~FECHA(VFEC16)                            ;SI;SI;FSYS;'COUNTRVENC'
Vacio(VTXT26) o Not EqStr(VTXT7,'1') o NOT LimCancelado('COUNTRY',VTXT26,'USD')                    ; 'Limite Country '~VTXT26~' Cacnelado'                                            ;SI;SI;FSYS;'COUNTRCANC'
Vacio(VTXT26) o Not EqStr(VTXT7,'1') o VCAN16 >= VCAN26 + TOTALAUX1                                ; 'Limite Country '~VTXT26~' excedido en U$D '~PYC(VCAN26 + TOTALAUX1 - VCAN16,0,2);SI;SI;FECHAORDEN;'COUNTREXCE'

Not EqStr(VTXT7,'1') o ExisteLimite('BOOK',VEHICULO,'USD',VEHICULO,,BOOK1)                        ; 'Limite Book '~BOOK1~' no asignado'                                          ;SI;SI;FSYS;'LBOOKNOAS'
Not EqStr(VTXT7,'1') o NOT ExisteLimite('BOOK',VEHICULO,'USD',VEHICULO,,BOOK1) o VFEC17 >= FechaOp; 'Limite Book '~BOOK1~' vencido el '~FECHA(VFEC17)                            ;SI;SI;FSYS;'LBOOKVENC'
Not EqStr(VTXT7,'1') o NOT LimCancelado('BOOK',VEHICULO,'USD',VEHICULO,,BOOK1)                    ; 'Limite Book '~BOOK1~' Cacnelado'                                            ;SI;SI;FSYS;'LBOOKCANC'
Not EqStr(VTXT7,'1') o VCAN17 >= VCAN27 + TOTALAUX1                                               ; 'Limite Book '~BOOK1~' excedido en U$D '~PYC(VCAN27 + TOTALAUX1 - VCAN17,0,2);SI;SI;FECHAORDEN;'LBOOKEXCE'
@TSTINV

EDICION
CantidadCompletada=0;'No se puede Modificar, Ya se Asignaron Operaciones a esta Orden: '

BAJA
Completada = 0;'No se puede Eliminar, Ya se Asignaron Operaciones a esta Orden: '


POSTEDICION
 EqStr(ABM,'E') o EqStr(ABM,'A');"POSMAN";NrOrden=NROPERACION

MOVIMIENTOS


LIMITES
FechaOrden   ;VTXT11   ;'PRESETTLEM' ;VAR('MONEEXTR');           ; VCAN7        ;TipoOp~' '~Especie      ;Not EqStr(VTXT7,'1') y [NoVacio(VTXT11) y VCAN11=0 y CB9=1];Vehiculo

FechaOrden   ;VTXT10   ;'PRESETTLEM' ;VAR('MONEEXTR');           ; VCAN7        ;TipoOp~' '~Especie~' GE';Not EqStr(VTXT7,'1') y [NoVacio(VTXT10) y VCAN10=0 y CB9=1];Vehiculo

FechaOrden    ;VTXT25  ;'ISSUER' ;ESPECIE;;CANTIDADTOTALORDEN;TipoOp~' '~Especie;EqStr(VTXT7,'1') y NoVacio(VTXT25) ;Vehiculo
FechaOrden    ;VTXT26  ;'COUNTRY';ESPECIE;;CANTIDADTOTALORDEN;TipoOp~' '~Especie;EqStr(VTXT7,'1') y NoVacio(VTXT26) ;Vehiculo
FechaOrden    ;VEHICULO;'BOOK'   ;ESPECIE;;CANTIDADTOTALORDEN;TipoOp~' '~Especie;EqStr(VTXT7,'1') y NoVacio(BOOK1)  ;Vehiculo;;BOOK1

@TOTMANIF
