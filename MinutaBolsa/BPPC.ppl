CAMPOS:1; ;21
Especie        : 'Especie'        ;2;1; ;  ;  ;NoVacio(ESPECIE);'Debe Ingresar una Especie';NO;
Agente         : 'Agente'         ; ; ; ;  ;  ;NoVacio(AGENTE);'Debe Ingresar el Agente';NO;
Cantidad       : 'Cantidad'       ; ; ; ;  ;  ;CANTIDAD>0;'La Cantidad debe ser Positiva';NO;
Precio1        : 'Precio Spot'    ;6; ; ;  ;  ;PRECIO1>0; 'El Precio debe ser Positivo';NO;
Total1         : 'Monto Spot'     ; ; ; ;NO;  ;;;;;PRECIO1*CANTIDAD
Precio2        : 'Precio Futuro'  ; ; ; ;  ;  ;PRECIO2>=PRECIO1;'El Precio Futuro debe ser Mayor que el Precio Spot';NO;
Total2         : 'Monto Futuro'   ; ; ; ;NO;  ;;;;;CANTIDAD*PRECIO2;
Operador       :                  ;11; ; ;NO;  ;;;;USUARIOACTIVO;
Vehiculo       : 'Veh!culo '      ; ; ; ;  ;  ;NoVacio(VEHICULO);'Debe Ingresar el Veh!culo';NO;'BOLSA'
ContraEspecie  : 'Contraespecie'  ;2;2; ;  ;  ;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA');'Debe Ingresar una ContraEspecie';NO;;CotizaEn(ESPECIE)
FechaMinuta    : 'Fecha Spot'     ;6;2; ;NO;  ;;;;FSYS;
Plazo          : 'Plazo'          ; ;2; ;  ;  ;Plazo>0;'El Plazo debe ser Mayor que Cero';NO;FECHAVTO-FechaMinuta;FECHAVTO-FechaMinuta
FechaVto       : 'Fecha Futuro'   ; ;2; ;  ;  ;ESHABIL(FECHAVTO,'ARG');'No es un D!a H bil';NO;FINDEMES(FechaMinuta,NO,'ARG');FechaMinuta+PLAZO;
Precio3        : 'Tasa N.A.'      ; ; ; ;NO;  ;;;;;((PRECIO2-PRECIO1)*36500)/(PRECIO1*PLAZO);
RB1            : 'Plazo Spot|0 |24 |48 |72 ';11; ; ; ; ;;;;0;
Precio4        :                  ; ; ; ;NO;NO;;;;Cotizacion('USD',,,,FechaMinuta,1)

CONDICIONES
FechaMaduracion(Especie) >= FechaMinuta;'El Cup?n ya fue pagado';SI
Precio3<>0;'La Tasa de Inter?s es Cero';SI
Plazo <= Var('PAPLAZOMAX') ;'Supera el Plazo M ximo';NO
[IF(EQSTR(CONTRAESPECIE,'ARP'),TOTAL1/PRECIO4,TOTAL1)<=Var('PAMONTO') y Plazo>=Var('PAPLAZOMI2')] o [IF(EQSTR(CONTRAESPECIE,'ARP'),TOTAL1/PRECIO4,TOTAL1)>Var('PAMONTO') y Plazo>=Var('PAPLAZOMI1')];'El Plazo es Menor al M!nimo';NO
