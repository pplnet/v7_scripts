CAMPOS:1; ;20
Especie        : 'Especie'        ;2;1; ;  ;  ;NoVacio(ESPECIE);'Debe Ingresar una Especie';NO;
Agente         : 'Agente'         ; ; ; ;  ;  ;NoVacio(AGENTE);'Debe Ingresar el Agente';NO;
Cantidad       : 'Cantidad'       ; ; ; ;  ;  ;CANTIDAD>0;'La Cantidad debe ser Positiva';NO;
Precio1        : 'Precio'         ; ; ; ;  ;  ;PRECIO1>0; 'El Precio debe ser Positivo';NO;
Operador       :                  ;7; ; ;NO;  ;;;;USUARIOACTIVO;
Vehiculo       : 'Veh!culo '      ; ; ; ;  ;  ;NoVacio(Vehiculo);'Debe Ingresar el Veh!culo';NO;'BOLSA'
ContraEspecie  : 'Contraespecie'  ;2;2; ;  ;  ;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA');'Debe Ingresar una ContraEspecie';NO;;CotizaEn(ESPECIE)
FechaMinuta    : 'Fecha Op.'      ; ;2; ;NO;  ;;;;FSYS;
Plazo          : 'Plazo'          ; ;2; ;NO;  ;;;;72;
FechaVto       : 'Fecha Liq.'     ; ; ; ;NO;  ;;;;Habiles(FechaMinuta,(PLAZO DIV 24),'ARG');Habiles(FechaMinuta,(PLAZO DIV 24),'ARG')
