creardialogo
fecha1:'Fecha';;;;;;;;;;FSys()
termsheet: 'TermSheet';;;;;;;;;

findialogo

if (not ok)
Cancelar()
endif


Sqladd(" Select NrCuota,C.Nroperacion,Fecha1,C.Cliente1,C.Especie1,Cantidad1,Cantidad2,O.Termsheet from CUOTAS C, OPERACIONES O ")
Sqladd(" where  C.Nroperacion=O.NrOperacion ")
if (NoVacio(dialogo.termsheet))
Sqladd(" and Termsheet = '"~dialogo.termsheet~"' ")
else
Sqladd("  and Termsheet <> '' and FechaOp < '"~IdxDate(dialogo.fecha1)~"' ")
endif
Sqladd(" and Radio2=1 and Radio1=5")
Sqladd("Order by Termsheet, NrOperacion ")

recorrer sql

Acn(a:fac, 1)
Act(b:fac, Fbn()['TermSheet'])
Act(c:fac, Fbn()['NrOperacion'])
Act(d:fac, Fbn()['Cliente1'])
Act(e:fac, Fbn()['Especie1'])
Acn(f:fac, Fbn()['Cantidad2'])
Acn(g:fac, Fbn()['Cantidad1'])
Acn(h:fac, Fbn()['NrCuota'])

Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';'Supervision Montos en CONUs'
'Accion ?';a:1..a:fac;SI;;;60;combo;'Ok|Rechaza'
'TermSheet';b:1..b:fac;NO;;;70;string;;
'Operacion';c:1..c:fac;NO;;;70;string;;
'Cliente';d:1..d:fac;NO;;;70;string;;
'Especie';e:1..e:fac;NO;;;70;string;;
'Monto Original';f:1..f:fac;NO;;;100;numero;'##,###,###,###.##';
'Monto Actualizdo';g:1..g:fac;NO;;;100;numero;'##,###,###,###.##';
finlistbox

if (not ok)
Cancelar()
endif

if (ok)
Act(t0, 'TSXXXXX')
Acn(x1, 1)
recorrer&j 1, Val(ca:1)
if (Eqstr(Val(t0), 'TSXXXXX'))
Act(t0, Val(b:&j))
endif
if (Eqstr(Val(t0), Val(b:&j)))
Scn(t:Val(x1), Val(a:&j))
Scn(u:Val(x1), 1)
else
Act(t0, Val(b:&j))
Scn(x1, 1)
Acn(t:Val(x1), Val(a:&j))
Acn(u:Val(x1), 1)
endif
proximo
Act(u:0, 'XX')
recorrer&k 1, Val(x:1)
if (Val(t:&k) = 0 y not Eqstr(Val(u:0), 'NOK'))
Act(u:0, 'OK')
else
if (Val(t:&k) = Val(u:&k) y not Eqstr(Val(u:0), 'NOK'))
Act(u:0, 'OK')
else
Act(u:0, 'NOK')
endif
endif
proximo
if (Eqstr(Val(u:0), 'OK'))
recorrer&i 1, Val(ca:1)
if (Val(a:&i) = 1)
Sqladd(" Delete "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~Val(c:&i)~"' and NrCuota= '"~FStr(Val(h:&i), 1, 0)~"'")
Sqlnew()
Sqlexec()
else
Sqladd("UPDATE "~Dbo()~".OPERACIONES ")
Sqladd("SET Cantidad = "~FStr(Val(g:&i), 0, 2)~", Cuotas2=1 ")
Sqladd("Where NrOperacion = '"~Val(c:&i)~"' ")
Sqlnew()
Sqladd("UPDATE "~Dbo()~".CUOTAS ")
Sqladd("SET Cantidad1 = "~FStr(Val(g:&i), 0, 2)~" ")
Sqladd("Where NrOperacion = '"~Val(c:&i)~"' and Radio1=0 ")
Sqlnew()
Sqladd("UPDATE "~Dbo()~".CUOTAS ")
Sqladd("SET Radio2 = '0' ")
Sqladd("Where NrOperacion = '"~Val(c:&i)~"' and NrCuota='"~FStr(Val(h:&i), 1, 0)~"' ")
Sqlnew()

Sqlexec()
endif
proximo
Messagebox('Supervision terminada')
else
Messagebox('La supervision debe tener la misma opcion(Ok/Rechaza) para las CONUs de la TermSheet')
endif
endif
else
Messagebox('No se encontraron operaciones para Supervisar')
endif

