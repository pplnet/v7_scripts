nrorden1:'Orden';;;;;;NoVacio(dialogo.nrorden1);'Ingrese Orden';NO;
cantidad1:'Ejecuciones';;;;;;dialogo.cantidad1 > 0;'Ingrese Cantidad de Ejecuciones';NO;
cantidad2:'Nominales';;;;;;dialogo.cantidad2 > 0;'Ingrese Cantidad de Nominales';NO;
findialogo

if (not ok)
Cancelar()
endif

Sqladd("SELECT NrOrden, NrOperacion, Fecha, Cantidad, Precio, Cantidad2 ")
Sqladd("  FROM "~Dbo()~".EJECUCIONES ")
Sqladd("WHERE NrOrden='"~dialogo.nrorden1~"'")
Acn(aa:1, 0)
recorrer sql
Sqladd("DELETE "~Dbo()~".EJECUCIONES WHERE NrOrden='"~dialogo.nrorden1~"'")
Sqlnew()
Sqlexec()

recorrer&i 1, dialogo.cantidad1
Scn(aa:1, 1)
Message('Insertando ejecucion '~FStr(Val(aa:1), 1, 0))
Sqladd("INSERT INTO "~Dbo()~".EJECUCIONES ( ")
Sqladd("NrOrden, NrEjecucion, NrOperacion, Fecha, ")
Sqladd("Cantidad, Precio, Cantidad2 ")
Sqladd(") VALUES ( ")
Sqladd("'"~Fbn()['NrOrden']~"',"~FStr(Val(aa:1), 1, 0)~", '"~Fbn()['NrOperacion']~"', "~IdxDate2(Fbn()['Fecha'])~", ")
Sqladd(FStr(dialogo.cantidad2, 0, 2)~","~FStr(Fbn()['Precio'], 0, 2)~", "~FStr(dialogo.cantidad2 * Fbn()['Precio'], 0, 2)~")")
Sqlnew()
Sqlexec()
proximo
Sqladd("UPDATE "~Dbo()~".ORDENES SET Cuotas1="~FStr(dialogo.cantidad1, 1, 0)~" WHERE NrOrden='"~dialogo.nrorden1~"' ")
