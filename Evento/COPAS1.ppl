*- COPMOD: Copia Modelos Contables/Adiciona Lineas
CrearDialogo
   ModeloAsiento1: 'Modelo'
   String2      :'Modelo Nuevo'     ;;;;;;NoVacio(Dialogo.String2);;NO;;;
   String       :'Cond.Copia Items' ;;;;;;;;;'NrItem>0';
FinDialogo

If not Ok
 Cancelar
EndIf

ACT(MN:1, Mayusculas2(Dialogo.String2))

ACN(a1,SQL("SELECT Count(*) FROM "~DBO~".MODELOSASIENTO Where Codigo='"~Val(MN:1)~"' ") )

If Val(a1)=0
   Message('Generando Modelo '~Val(MN:1)~'   ...')

   SQL.ADD("INSERT INTO "~DBO~".MODELOSASIENTO ")
   SQL.ADD("(Codigo,Descripcion,Vehiculo,TipoOp,TipoAsiento, Libro, ClaseDocumento,Habilitado) ")
   SQL.ADD("Select '"~Val(MN:1)~"' as Codigo,Descripcion,Vehiculo,TipoOp,TipoAsiento, Libro, ClaseDocumento,Habilitado ")
   SQL.ADD("from "~DBO~".MODELOSASIENTO  Where Codigo='"~Dialogo.ModeloAsiento1~"' ")
   SQL.NEW
   SQL.EXEC
EndIf

Message('Generando Items '~Val(MN:1)~'  ...')
SQL.ADD("INSERT INTO "~DBO~".MODELOSASIENTO1 ")
SQL.ADD("(Modelo,NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,Alias3,Detalle, ")
SQL.ADD(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3, ")
SQL.ADD(" CC1, CentroCosto1, CT1 ) ")
SQL.ADD("Select '"~Val(MN:1)~"' Modelo,NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,Alias3,Detalle, ")
SQL.ADD(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3, ")
SQL.ADD(" CC1, CentroCosto1, CT1 ")
SQL.ADD("from "~DBO~".MODELOSASIENTO1 Where Modelo= '"~Dialogo.ModeloAsiento1~"' and NrItem Not In  ")
SQL.ADD("(Select NrItem from "~DBO~".MODELOSASIENTO1 Where Modelo= '"~Val(MN:1)~"' ")
If NoVacio(Dialogo.String)
   SQL.ADD(" and "~Dialogo.String~" ")
EndIf
SQL.ADD(")")
If NoVacio(Dialogo.String)
   SQL.ADD(" and "~Dialogo.String~" ")
EndIf
**SQL.ADD("and")
SQL.NEW
SQL.EXEC

MessageBox('Copia Finalizada ')