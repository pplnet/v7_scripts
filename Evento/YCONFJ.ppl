MostrarCuadroDeMensajes
ACT(es1,SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo "))
CrearDialogo
   Vehiculo1  : 'Vehiculo'          ;  ;;;;;;;;VAR('VEHICULODE')
   Fecha1     : 'FechaLiq'          ;  ;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha del Movimiento';NO;HABILES(FSys,0,'ARG')
