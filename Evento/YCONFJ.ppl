SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT Distinct T.NrTrans, T.TipoTr2, T.Fecha1, T.Cliente1, T.Cliente2, T.Fecha3,    ")
SQL.ADD("        T.Cuenta1, T.Cuenta2, T.Especie, T.Cantidad1, T.Precio1, T.Cambio1, T.Cupon1, ")
SQL.ADD("        T.Mercado1, T.CB6, T.NrOperacionRef1, T.CB1, T.CB2, M.NrOperacion,CT1.NrDepositante as NrDepositante1 ")
SQL.ADD(" FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, ")
SQL.ADD("        "~DBO~".CUENTAS CT1,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" WHERE  M.NrOperacion = T.NrTrans                      ")
SQL.ADD(" and    OB.NrOperacion=T.NrTrans                       ")
SQL.ADD(" and    T.Fecha1      = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and    T.Vehiculo1   = '"~Dialogo.Vehiculo1~"'        ")
SQL.ADD(" and    T.TipoTr2    IN ('DTP','RTP')                  ")
*SQL.ADD(" and    T.CB1         = '1'           ")
* cambio cb1 x cb6 porque deja afuera las que no son trf. cb6= automatica.
SQL.ADD(" and    T.CB6         = '1'           ")
SQL.ADD(" and    CT1.Codigo    = T.Cuenta1     ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       and T.Mercado1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("    AND T.Especie IN ("~Pipe2Comillas(Dialogo.Lista2)~")     ")
ENDIF
IF NoVacio(Dialogo.Lista3)
