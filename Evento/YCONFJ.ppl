*---------
SQL.ADD(" ORDER BY T.Fecha1, T.Especie, CT1.NrDepositante, T.Cuenta2 ")

watch(SQL.BATCH())

ACT(z1,'')
ACT(z2,'')

Message('Recuperando Informacion.')

Recorrer SQL
   If Not EqStr(FBN['Cuenta2'],val(z2))
      ACT(z2,FBN['Cuenta2'])
      ACT(aa2,'')
      If NoVacio(val(z2))
         ACT(aa2,BuscarCampo('CUENTAS','NrDepositante','Codigo',FBN['Cuenta2']))
      EndIf
   EndIf

   ACT(a:FAC, FBN['NrTrans'])
   ACT(b:FAC, FBN['TipoTr2'])
   ACD(c:FAC, FBN['Fecha1'])
   If Novacio(FBN['Fecha3'])
      ACD(cc:FAC, FBN['Fecha3'])
   Else
      ACD(cc:FAC, FBN['Fecha1'])
   Endif
   ACT(d:FAC, FBN['Cliente1'])
   ACT(e:FAC, FBN['Cliente2'])
   ACT(f:FAC, FBN['NrDepositante1'])
   ACT(g:FAC, val(aa2))
   ACT(h:FAC, FBN['Especie'])

   ACT(r:fac, fbn('Cupon1'))

   ACN(i:FAC, FBN['Cantidad1'])
   ACN(j:FAC, FBN['Precio1'])
   ACN(k:FAC, FBN['Cambio1'])
   ACT(l:FAC, FBN['Mercado1'])
   ACT(m:FAC,'')

   *- DEP/RET que dio origen al DTP/RTP Automatico 
   If EqStr(FBN['CB6'],'1')
      ACT(m:FAC,FBN['NrOperacionRef1'])

      SQL.ADD("Select RB6 from "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" where NrTrans = '"~val(m:fac)~"' ")

      Recorrer SQL
        dfa
        acn(s:fac, fbn('RB6'))
        If fbn('RB6')=1
           ACT(t:fac,'Confirmada')
        Else
           If fbn('RB6')=2
              ACT(t:fac,'Falla')
           Else
              ACT(t:fac,'Pendiente')
           Endif
        Endif
      Proximo
   EndIf

   ACN(n:FAC, NUM(FStr(FBN['CB1'],0,0)))
   ACN(o:FAC, NUM(FStr(FBN['CB2'],0,0)))
   ACT(p:FAC, FBN['NrOperacion'])
   ACT(u:FAC,FBN['NrOperacionRef1'])
   If Dialogo.Check1=1
      ACN(q:FAC, 1)
   else
      ACN(q:FAC, 0)
   Endif
   SCN(qf:1, 1)
Proximo

If Val(qf:1)>0 
   If Dialogo.Check1=0
       **- Armo la lista de las transacciones que puede seleccionar
      CrearListBox ; 'Arial,8,';'Seleccion de Transacciones para Anulacion '
          'Anula'        ;q:4..q:FAC;  ;;;18;CHECK ;RGB(220,220,193);;NO;NO;;NO;NO;NO;SI
          'Estado'       ;t:4..t:fac;NO;SI; ;65 ;STRING;;RGB(180,180,193)
          'Especie'      ;h:4..h:FAC;NO;;;50;TABLA;'Especies';'Codigo';'Codigo;Nombre';
          'CuponMatch'   ;r:4..r:FAC;NO;;;40;STRING;
          'Cuenta1'      ;f:4..f:FAC;NO;;;75;TABLA;'Cuentas';
          'Cliente1'     ;d:4..d:FAC;NO;;;80;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
          'Cantidad VN'  ;i:4..i:FAC;NO;;;90;NUMERO;'###,###,###';
          'Fecha'        ;c:4..c:FAC;NO;;;75;FECHA;
          'TipoTrans '   ;b:4..b:FAC;NO;;;55;STRING;
          'NrCustodia'   ;a:4..a:FAC;NO;;;65;STRING;
          'Transf'       ;n:4..n:FAC;NO;;;40;CHECK;
          'Interna'      ;o:4..o:FAC;NO;;;45;CHECK;
          'C.Cust'       ;l:4..l:FAC;NO;;;45;STRING;
          'Cliente2'     ;e:4..e:FAC;NO;;;80;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
          'Cuenta2'      ;g:4..g:FAC;NO;;;75;TABLA;'Cuentas';
          'Precio'       ;j:4..j:FAC;NO;;;65;NUMERO;'##,###,###.########';
          'Monto'        ;k:4..k:FAC;NO;;;90;NUMERO;'###,###,###.##';
          'Voucher'      ;u:4..u:FAC;NO;;;65;STRING;
      FinListBox

      If Not OK
         Cancelar('No se seleccionaron transaciones para matchear')
      Endif
   endif
   **- Recorro las filas para ver cual esta seleccionada
   Recorrer&i 4, FAC
     If Val(q:&i) = 1
        IF Eqstr(Val(t:&i),'Confirmada')
           Message('* ------- Dejo la DTP o RTP de nuevo como pendiente ------------ *')
           SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 SET ")
           SQL.ADD(" RB2    = '0', ")
           SQL.ADD(" Fecha5 = '"~IdxDate(Val(cc:&i))~"', ")
           SQL.ADD(" Cupon2 = '"~val(r:&i)~"' ")
           SQL.ADD(" WHERE  NrTrans = '"~Val(a:&i)~"' ")
           SQL.NEW
           SQL.EXEC

           SQL.ActualizarMovimientosT2(Val(a:&i),SI,NO,NO,SI,0,4)
           SQL.EXEC
           *- Pasa de Instancia
           ACT(az3,Val(a:&i))
           ACT(az4,'TRANSACCIONES2')
           ACN(az5, 1)
           ACN(az6,70)
           (.'MODIINSTAN'.)
           * -------------------------------------------------------------- *

           * -------- Dejo el DEP o RET pendiente y en su instancia -------- *
           SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 SET ")
           SQL.ADD(" Fecha5 = Null,  ")
           SQL.ADD(" FechaConfir = Null,  ")
           SQL.ADD(" RB6    = '0'    ")
           SQL.ADD(" WHERE NrTrans = '"~val(m:&i)~"' ")
           SQL.NEW
           SQL.EXEC
           If EqStr(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',val(m:&i)),'DEP')
              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit=3 ")
           Else
              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit=6 ")
           Endif
           SQL.NEW
           SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit IN (70) ")
           SQL.NEW
           SQL.EXEC
           * -------------------------------------------------------------- *

           * ------------------ Vuelvo a afectar limites ------------------ *
           IF NoVacio(val(m:&i))
              *** busco las operaciones y afecto los limites nuevamente, siempre tomo los pagos ***
              SQL.ADD("Select NrOperacion from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" where NrTrans2     = '"~val(m:&i)~"' ")
              SQL.ADD("   and NrOperacion <> '"~val(m:&i)~"'")
              SQL.ADD("   and Cantidad     < 0 ")
              SQL.ADD(" order by NrOperacion ")

              Recorrer SQL
                dfa
                SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
                SQL.ADD("  SET RB10        = '',    ")
                SQL.ADD("      FechaPrecan = Null   ")
                SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
                SQL.ADD("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
                SQL.NEW
                SQL.EXEC
                ModificarOperacion(fbn['NrOperacion'],0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,0)
              Proximo
           EndIf
           * -------------------------------------------------------------- *
       Else
           IF Eqstr(Val(t:&i),'Falla')
              If EqStr(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',val(m:&i)),'DEP')
                 SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit=3 ")
              Else
                 SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit=6 ")
              Endif
              SQL.NEW
              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~val(m:&i)~"' and NrBit IN (8) ")
              SQL.NEW
              SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 SET ")
              SQL.ADD(" RB6         = 0,    ")
              SQL.ADD(" FechaTransp = null, ")
              SQL.ADD(" FechaFalla  = null  ")
              SQL.ADD(" WHERE NrTrans = '"~val(m:&i)~"' ")
              SQL.NEW

              * --- FO 28/04/2006 ----------------------------------------------------- *
              * --- Borra los Movs generados por la falla para desafectar el saldo de liq
              SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(m:&i)~"' AND Transaccion = 'Falla' ")
              SQL.NEW
              * ----------------------------------------------------------------------- *

              SQL.EXEC
          Endif
       EndIf
     Endif
  Proximo
else
  IF Dialogo.Check1=0
     Cancelar('No se encontraron Movimientos para Anular')
  endif   
endif
IF Dialogo.Check1=1
   Message('Fin de la anulacion.')
else
   Messagebox('Fin de la anulacion.')
Endif
