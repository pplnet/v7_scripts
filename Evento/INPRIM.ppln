Sqladd("Select Distinct O.* ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
Sqladd("where O.NrOperacion = C.NrOperacion ")
Sqladd("and O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and C.Fecha2>'"~IdxDate(dialogo.fecha1)~"' ")
