endif
if (NoVacio(Val(zz6)))
Sqladd("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
Sqladd("order by O.Vehiculo1,")
if (dialogo.radio1 = 0)
Sqladd("TCComCor1, O.Cliente1")
else
Sqladd("TCComCor2, O.Cliente1")
endif


recorrer sql
