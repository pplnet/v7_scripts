Sqladd("and (O.TipoOp in ('DPDSO','DPDSS','DPBOD','DPOA','DPOD','DPRC','DPRRS','DPRS','DPBOA','DPC','DPF','DPFW','DPOGA','DPOGD') ")
Sqladd(" or (O.TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL)) )")
Sqladd("Union ")
Sqladd("Select Distinct O.* ")
Sqladd(" from "~Dbo()~".OPERACIONES O")
Sqladd("where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and O.CB9='1' ")
Sqladd("and TipoOp In ('DPOS','DPBOS','DPOGS') and O.FechaEj>'"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.cliente1))
