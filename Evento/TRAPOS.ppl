CrearDialogo
  Especie1: 'Especie'     ;1;1;1;  ;  ;Novacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe ingresar un titulo.';NO;;;;;;
  Book1:    'Book Origen' ;2;1;1;SI;SI;NoVacio(Dialogo.Book1);'Debe ingresar un book Origen';NO;;
  Book2:    'Book Destino';3;1;1;SI;SI;NoVacio(Dialogo.Book2) y Not EqStr(Dialogo.Book2,Dialogo.Book1);'Debe ingresar un book Destino distinto al Origen.';NO;;
  Fecha1:   'Fecha'       ;4;1;1;SI;SI;Dialogo.Fecha1<=FSys;'La fecha no puedse ser mayor que FechaSys';NO;FSys
  Check1:   'Procesa'     ;5;1;1;NO;NO;;;;1;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

**

ACT(h:1, 'Vehiculo')
ACT(h:2, 'Cupon Vig')
ACT(h:3, 'Nr Trans')

** FJL 5/8/22 - Se cambia para BIND
*ACT(k:1, 'Saldo 171')
*ACT(k:2, 'Precio 171')
*ACT(k:3, 'Saldo 172')
*ACT(k:4, 'Precio 172')
ACT(k:1, 'Saldo 121')
ACT(k:2, 'Precio 121')
ACT(k:3, 'Saldo 122')
ACT(k:4, 'Precio 122')

ACT(i:1, Var('VEHICULODE'))
ACN(i:2, BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))

SetFilaActual(1)
ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Book')
ACT(ac:FAC, 'NrSaldo')
ACT(ad:FAC, 'Cupon')
ACT(ae:FAC, 'Fecha')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Cliente')
ACT(ah:FAC, 'Sector')
ACT(ai:FAC, 'Estrategia')
ACT(aj:FAC, 'CantidadFin')
ACT(ak:FAC, 'PrecioFin')
ACT(ak:FAC, 'TipoPosicion')
ACT(al:FAC, 'A Pasar')
ACT(am:FAC, 'Confirmado')

SQL.ADD("Select * from "~DBO~".POSICIONES P ")
SQL.ADD(" where P.Fecha       <= "~IDXDATE2(Dialogo.Fecha1)~" ")
SQL.ADD("   and P.Especie     = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and P.Vehiculo    = '"~Val(i:1)~"' ")
SQL.ADD("   and P.Cupon       = "~FStr(Val(i:2),1,0)~" ")
SQL.ADD("   and P.Book        = '"~Dialogo.Book1~"' ")
SQL.ADD("   and P.NrSaldo in (122) ")
SQL.ADD("   and P.CantidadFin <> 0  ")
SQL.ADD("   AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie    = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo   = P.Vehiculo ")
SQL.ADD("                   AND   P1.NrSaldo    = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Cliente    = P.Cliente  ")
SQL.ADD("                   AND   P1.Book       = P.Book     ")
SQL.ADD("                   AND  (P1.Sector     = P.Sector     OR (P1.Sector     IS NULL AND P.Sector     IS NULL) ) ")
SQL.ADD("                   AND  (P1.CallPut    = P.CallPut    OR (P1.CallPut    IS NULL AND P.CallPut    IS NULL) ) ")
SQL.ADD("                   AND  (P1.Cupon      = P.Cupon      OR (P1.Cupon      IS NULL AND P.Cupon      IS NULL) ) ")
SQL.ADD("                   AND  (P1.Estrategia = P.Estrategia OR (P1.Estrategia IS NULL AND P.Estrategia IS NULL) ) ")
SQL.ADD("                   AND  (P1.TipoPosicion = P.TipoPosicion OR (P1.TipoPosicion IS NULL AND P.TipoPosicion IS NULL) ) ")
SQL.ADD("                   AND  (P1.FechaEj    = P.FechaEj    OR (P1.FechaEj    IS NULL AND P.FechaEj    IS NULL) ) ")
SQL.ADD("                   AND  (P1.PrecioEj   = P.PrecioEj   OR (P1.PrecioEj   IS NULL AND P.PrecioEj   IS NULL) ) ")
SQL.ADD("                   AND  P1.Fecha      <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                 ) ")
SQL.ADD("order by Especie,Book,NrSaldo,Cupon,Fecha                 ")

recorrer SQL
  SCN(y:1, 1)
  ACT(aa:FAC, fbn('Especie'))
  ACT(ab:FAC, fbn('Book'))
  ACN(ac:FAC, fbn('NrSaldo'))
  ACN(ad:FAC, fbn('Cupon'))
  ACD(ae:FAC, fbn('Fecha'))
  ACT(af:FAC, fbn('Vehiculo'))
  ACT(ag:FAC, fbn('Cliente'))
  ACT(ah:FAC, fbn('Sector'))
  * Cuenta
  ACT(ai:FAC, fbn('Estrategia'))
  * TipoGarantia
  ACT(aj:FAC, fbn('TipoPosicion'))
  ACN(ak:FAC, fbn('CantidadFin'))
*  ACN(al:FAC, fbn('PrecioFin'))
* FJL 23/08/24 - Se hablo con Andrea y este seria el criterio correcto para tomar el precio para la TRPOS
*  ACN(al:fac, fbn('PrecioHistCon'))
* FJL 23/09/24 - Se corrige porque si la posicion es de una fecha anterior el precio es el de cierre
  if fbn('Fecha')<Dialogo.Fecha1
    ACN(al:fac, fbn('PrecioFinCon'))
  else
    if fbn('PrecioIniCon')>0
      ACN(al:fac, fbn('PrecioIniCon'))
    else
      ACN(al:fac, fbn('PrecioFinCon'))
    endif
  endif
  * Book destino
  ACT(am:FAC, Dialogo.Book2)
  * VN a pasar
  ACN(an:FAC, 0)
  * Confirmado
  ACN(ao:FAC, 0)
proximo

if Val(y:1)=0
  MessageBox('No hay posiciones para transferir')
  if Dialogo.Check1=1
    Cancelar
  endif
endif

if Val(y:1)>0
  CrearListBox ; 'Arial,8,';Val(di:1)
    'Conf'              ;ao:2..ao:Fac ;;;;40;CHECK;RGB(160,160,193)
    'Vehiculo'          ;af:2..af:Fac ;NO;;;70 ;STRING;;
    'Cliente'           ;ag:2..ag:Fac ;NO;;;70 ;STRING;;
    'Especie '          ;aa:2..aa:Fac ;NO;;;70 ;STRING;;
    'Cupon'             ;ad:2..ad:Fac ;NO;;;70 ;STRING;;
    'Book Origen'       ;ab:2..ab:Fac ;NO;;;80 ;STRING;;
    'Cuenta'            ;ai:2..ai:Fac ;NO;;;70 ;STRING;;
    'Tipo'              ;aj:2..aj:Fac ;NO;;;50 ;STRING;;
    'Posicion'          ;ak:2..ak:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'
    'Precio'            ;al:2..al:Fac ;NO;;;100;NUMERO;'###.########'
    'Book Destino'      ;am:2..am:Fac ;NO;;;80 ;STRING;;
* FJL 24/06/24 - Issue 7315 - Validacion con Posicion negativa
*    'Cant.a Transferir' ;an:2..an:Fac ;SI;Val(an:FLB)<=Val(ak:FLB) y Val(an:FLB)>=0 y ( Val(an:FLB)>0 o Val(ao:FLB)=0);'Cantidad a transferir invalida. (Fila '~FStr(FLB-1,1,0)~')';100;NUMERO;'###,###,###,###.##';RGB(160,160,193)
    'Cant.a Transferir' ;an:2..an:Fac ;SI;((Val(ak:FLB)>0 y Val(an:FLB)<=Val(ak:FLB) y Val(an:FLB)>0) o (Val(ak:FLB)<0 y Val(an:FLB)>=Val(ak:FLB) y Val(an:FLB)<0)) o Val(ao:FLB)=0;'Cantidad a transferir invalida. (Fila '~FStr(FLB-1,1,0)~')';100;NUMERO;'###,###,###,###.##';RGB(160,160,193)
  FinListBox
  IF NOT OK 
    Cancelar('evento Cancelado')
  ENDIF
  
  ACN(y:2, Sum(ao:2..ao:fac))
  if Val(y:2)=0
    MessageBox('No se selecciono ninguna fila para realizar pasaje de posicion')
  else
    recorrer&i 2,Val(y:1)+1
      if Val(ao:&i)=1
        * Linea Confirmada
        SCN(y:3, 1)
        ***************************
        ** Insert Transaccion TRPOS
        ***************************
        if Dialogo.Check1=1
          ACT(ao:&i, GetNumerador(27))
          SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
          SQL.ADD("   TipoTr2, NrTrans,   Cliente1, Fecha1, Especie, ")
          SQL.ADD("   Cupon1,  Book1,     Book2,    Cantidad1, Cantidad2, ")
          SQL.ADD("   Precio2, Cantidad3, Precio3,  Vehiculo1, RB6, ")
          SQL.ADD("   Cuenta1, ConceptoPago, ")
          SQL.ADD("   FechaCarga, FechaCargaSys, UsrInput ")
          SQL.ADD(" ) VALUES( ")
          SQL.ADD("   'TRPOS', ")
          SQL.ADD("   '"~Val(ao:&i)~"', ")
          SQL.ADD("   '"~Val(ag:&i)~"', ")
          SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD("   '"~Dialogo.Especie1~"', ")
    
          SQL.ADD("   "~FSTR(Val(ad:&i),1,0)~", ")
          SQL.ADD("   '"~Dialogo.Book1~"', ")
          SQL.ADD("   '"~Dialogo.Book2~"', ")
          * Cantidad1 - A transferir
          SQL.ADD("   "~FStr(Val(an:&i),1,2)~",")
          * Cantidad2 - Fin 121
          SQL.ADD("   "~FStr(Val(ak:&i),1,2)~",")

          * Precio2 - Pr Pos Spot
          SQL.ADD("   "~FStr(Val(al:&i),1,8)~", ")
          * Cantidad3 - Fin 122
          SQL.ADD("   "~FStr(Val(ak:&i),1,2)~",")
          * Precio3 - Pr Pos Fut
          SQL.ADD("   "~FStr(Val(al:&i),1,8)~", ")
          * Vehiculo1
          SQL.ADD("   '"~Val(af:&i)~"', ")
          * RB6 - Sec
          SQL.ADD("   '0', ")

          * Cuenta1 (Estrategia)
          SQL.ADD("   '"~Val(ai:&i)~"', ")
          * ConceptoPago (TipoPosicion)
          SQL.ADD("   '"~Val(aj:&i)~"', ")

          SQL.ADD(" "~SQLAhora~","~idxdate2(fsys)~", '"~USUARIOACTIVO~"') ")
          SQL.NEW
          SQL.EXEC    

          SQL.ActualizarMovimientosT2(Val(ao:&i),NO,NO,NO,SI)
          SQL.EXEC 

          *- Alta de Instancias
          EjecutarEvento('INBIT2',String1='TRANSACCIONES2', Entero1=70, NrOperacion1=Val(ao:&i))
        endif
      endif
    proximo
    if Val(y:3)=1
      MessageBox('Se realizo '~FStr(Val(y:3),1,0)~' passaje de posicion')
    else
      MessageBox('Se realizaron '~FStr(Val(y:3),1,0)~' pasajes de posicion')
    endif
  endif
endif

