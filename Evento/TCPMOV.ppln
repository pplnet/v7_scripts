creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'TCPCEM';;;;;;;;;;;;;;"TipoOp in ('TCPCEM')"
lista1: 'Mercados';;;;NO;;;;;;Var('CIELICDEF');SQLSet("SELECT Codigo FROM "~Dbo()~".MERCADOS  ORDER BY Codigo ");SI
findialogo
if (not ok)
Cancelar()
endif

Acn(y:1, 1)
if (Val(y:1) = 0)
HojaVisible(SI)
endif

Acd(fe:1, dialogo.fecha1)

sql.add("Select OD.NrOperacion1 NrTCPCEM, M.Especie, OPTCP.Cuenta1, OPTCP.Cuenta2, OPTCP.Cuenta3, OPTCP.Cuenta4, ")
sql.add(" OPTCP.Mercado, OPTCP.Mercado2, M.Entecustodia, M.NrSaldo,  ")
sql.add(" CASE WHEN  OP.Cliente1 = OP.Vehiculo1 THEN 'CP' ELSE 'Tercero' END TipoCliente, OP.Especie EspO, OPTCP.Cliente1 CliTCP,   ")
sql.add(" M.Book,  M.FechaMov, SUM(M.Cantidad) Cantidad, M.Concepto, M.Cupon,  M.Nrinstan, M.NrGrupo2, M.NrGrupo,      ")
sql.add(" IsNull(OPTCP.FormaLiquidacion1,'') FormaLiquidacion1, IsNull(OPTCP.FormaLiquidacion2,'') FormaLiquidacion2   ")
sql.add("From "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONES OP, "~Dbo()~".ORDENES OD, "~Dbo()~".OPERACIONES OPTCP           ")
sql.add("Where M.NrOperacion = OP.NrOperacion                                                                          ")
sql.add(" And  (M.NrGrupo <> 15 And  M.NrGrupo <> 16) ")
sql.add(" And  OP.NrOperacion = OD.NrOperacion2                                                                        ")
sql.add(" And  OPTCP.NrOperacion = OD.NrOperacion1                                                                     ")
sql.add(" And OP.TipoOp = 'TCOPRI' ")
if (NoVacio(dialogo.nroperacion1))
sql.add("AND  OPTCP.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.lista1))
sql.add("AND  OP.Mercado4 In ("~pipe2comillas(dialogo.lista1)~") ")
endif
sql.add(" And OP.FechaOp <= "~IdxDate2(Val(fe:1))~"                                                                    ")
sql.add(" And OP.FechaCargaSys = "~IdxDate2(Val(fe:1))~"                                                               ")
sql.add(" And not exists(SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS ME WHERE ME.NrOperacion=OD.NrOperacion1 )                 ")
sql.add(" And OP.Cliente1<>OP.Vehiculo1 and OP.Cliente1<>'"~Var('CLIBCRA')~"'                                          ")
sql.add("Group by OPTCP.Cuenta1, OPTCP.Cuenta2, OPTCP.Cuenta3, OPTCP.Cuenta4, M.Especie, OPTCP.Mercado, OPTCP.Mercado2, M.EnteCustodia, OD.NrOperacion1,               ")
sql.add(" CASE WHEN  OP.Cliente1 = OP.Vehiculo1 THEN 'CP' ELSE 'Tercero' END , OP.Especie , OPTCP.Cliente1,            ")
sql.add("         M.Concepto, M.Cupon,  M.Nrinstan,  M.NrSaldo, M.Book, M.FechaMov, M.NrGrupo2, M.NrGrupo,             ")
sql.add(" IsNull(OPTCP.FormaLiquidacion1,''), IsNull(OPTCP.FormaLiquidacion2,'') ")
sql.add("ORDER BY 1, 2 ")
Watch(sql.batch())

Acn(co:1, 0)
Act(co:2, '')

recorrer sql
if (Val(y:1) = 1)
Message('Generando movimientos '~Fbn('NrTCPCEM')~' '~Fbn('TipoCliente')~' '~Fbn('Especie'))

if (not Eqstr(Val(co:2), Fbn()['NrTCPCEM']))
sql.add("DELETE "~Dbo()~".MOVPENDIENTES WHERE NrOperacion='"~Fbn()['NrTCPCEM']~"' ")
sql.new

if (NO)
endif

sql.add("UPDATE "~Dbo()~".OPERACIONES                                      ")
sql.add("   SET Cuenta2='"~Fbn()['Cuenta2']~"', Cuenta3='"~Fbn()['Cuenta3']~"' ")
sql.add(" WHERE NrOperacion in (SELECT Op.NrOperacion                      ")
sql.add("                         From "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONES OP, "~Dbo()~".ORDENES OD, "~Dbo()~".OPERACIONES OPTCP           ")
sql.add("                        WHERE OP.TipoOp = 'TCOPRI'                                                    ")
sql.add("                          and M.NrOperacion = OP.NrOperacion                                          ")
sql.add("                          and OP.NrOperacion = OD.NrOperacion2                                        ")
sql.add("                          and  OPTCP.NrOperacion = '"~Fbn()['NrTCPCEM']~"'                              ")
sql.add("                          and OP.FechaVto = "~IdxDate2(Val(fe:1))~"                                                                    ")
sql.add("                          and not exists(SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS ME WHERE ME.NrOperacion=OD.NrOperacion1 )                 ")
sql.add("                          and OP.Cliente1<>OP.Vehiculo1 and OP.Cliente1<>'"~Fbn()['CliTCP']~"'                                          ")
sql.add("                        ) ")
sql.new

sql.add("UPDATE "~Dbo()~".OPERACIONES ")
sql.add("   SET FechaVto="~IdxDate2(Val(fe:1))~" ")
sql.add(" WHERE NrOperacion='"~Fbn()['NrTCPCEM']~"' ")
sql.new

Acn( in :1, sql("select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~Fbn()['NrTCPCEM']~"' and Valor = '1' "))
ejecutarevento('CBOINS', string1 = Fbn()['NrTCPCEM'], radio1 = 0, radio2 = 2, entero1 = Val( in :1), entero2 = 10)

if (NO)
sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '0' ")
sql.add(" Where (NrOperacion = '"~Fbn()['NrTCPCEM']~"') ")
sql.new

sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '1' ")
sql.add(" Where NrOperacion = '"~Fbn()['NrTCPCEM']~"' and NrBit = 10 ")
sql.new
endif

Act(co:2, Fbn()['NrTCPCEM'])
endif
Scn(co:1, 1)
Acn(q:fac, Fbn('Cantidad'))
Act(a:fac, Fbn('Especie'))
Act(b:fac, Fbn('NrTCPCEM'))
Act(c:fac, Fbn('Especie'))
Act(d:fac, sql("SELECT Cliente1 FROM "~Dbo()~".OPERACIONES WHERE NrOperacion='"~Fbn('NrTCPCEM')~"'"))
if (Eqstr(Fbn('EspO'), Fbn('Especie')))
Act(e:fac, Fbn('Mercado'))
else
Act(e:fac, Fbn('Mercado2'))
endif
Act(f:fac, Fbn('EnteCustodia'))
Acn(h:fac, Fbn('NrSaldo'))
if (DesciendeDeEspecie(Fbn('Especie'), 'TITULO'))
Act(i:fac, Fbn('Cuenta1'))
else
Act(i:fac, Fbn('Cuenta4'))
endif
Act(l:fac, Fbn('Book'))
Acd(n:fac, Fbn('FechaMov'))
Act(k:fac, Fbn('Concepto'))
Act(p:fac, Fbn('Cupon'))
Acn(r:fac, Fbn('Nrinstan'))
Acn(s:fac, Fbn('NrGrupo2'))
Acn(t:fac, Fbn('NrGrupo'))
Act(u:fac, Fbn('TipoCliente'))

sql.add(" Insert into "~Dbo()~".MOVPENDIENTES           ")
sql.add(" (NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
sql.add("  Bits, NrSaldo, Cuenta, NrMov, Status, ")
sql.add(" Book,  FechaMov, Cantidad, Leyenda,         ")
sql.add(" NrGrupo, Concepto, Cupon, NrComprob,        ")
sql.add(" NrGrupo2, Nrinstan)                         ")
sql.add(" values  (                                   ")
sql.add(" '"~Val(b:fac)~"'  , '"~Val(a:fac)~"', '"~Val(d:fac)~"', '"~Val(e:fac)~"', '"~Val(f:fac)~"',                  ")
sql.add(" 'MV'  , "~FStr(Val(h:fac), 0, 0)~",  '"~Val(i:fac)~"', "~FStr(Val(co:1), 0, 0)~", '"~Val(v:fac)~"' ,             ")
sql.add(" '"~Val(l:fac)~"'  ,  "~IdxDate2(Val(n:fac))~", "~FStr(Val(q:fac), 0, 2)~", '"~Val(u:fac)~" - "~Val(a:fac)~"', ")
sql.add(" '"~Val(t:fac)~"'  , '"~Val(k:fac)~"', '"~Val(p:fac)~"', '"~FStr(1000 + Val(co:1), 1, 0)~"',                      ")
sql.add(" '"~Val(s:fac)~"' , '"~Val(r:fac)~"'         ")
sql.add("         )                                   ")
sql.new
else
Messagebox('No Procesa - Generando movimientos '~Fbn('NrTCPCEM')~' '~Fbn('TipoCliente')~' '~Fbn('Especie'))
endif
proximo
if (Val(y:1) = 1)
sql.exec
else
Messagebox('No Procesa - Fin')
endif

if (NO)
if (Val(co:1) = 0)
Cancelar()('No hay emisiones pendientes de liquidacion')
else
Messagebox('Movimientos de emisiones generados')
endif
endif

