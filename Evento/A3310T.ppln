Act(aa:&j, Val(aa:&j)~','~Val(j:&j))

if (LTStr(Val(k:&j), '0'))
Act(aa:&j, Val(aa:&j)~',-'~Pad0(Copy(Val(k:&j), 2, Longitud(Val(k:&j))), 6))
else
Act(aa:&j, Val(aa:&j)~','~Pad0(Val(k:&j), 7))
endif

Act(aa:&j, Val(aa:&j)~','~Pad0(FStr(Val(l:&j), 0, 8), 12))

if (LTStr(Val(m:&j), '0'))
Act(aa:&j, Val(aa:&j)~',-'~Pad0(Copy(Val(m:&j), 2, Longitud(Val(m:&j))), 9))
else
Act(aa:&j, Val(aa:&j)~','~Pad0(Val(m:&j), 10))
endif

EscribirAscii(Val(aa:&j))
endif
proximo
