CrearFont(2, "Arial,8,")
CrearFont(1, "Arial,8,I")
CrearFont(3, "Arial,10,B")

Sqladd("SELECT E.Codigo as Especie, E.Extendido, E.ISIN as CodigoISIN, E.Tipo, ")
Sqladd("       E.CodMAEContado as CodigoMAE, E.CodNumCajaValores as CodigoCValores, ")
Sqladd("       E.LocalRating1 as TipoValor, E.PaisOrigen, SUM(S1.Saldo) Cantidad, ")
Sqladd("       E.MonedaEmision as Cotiza, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd("       E.InteresesC, C.PaisDir, C.CategDepositante as CatDep, CASE C.AFJP WHEN 'NO' THEN 'NO' WHEN 'SI' THEN 'SI' ELSE 'NO' END AS AFJP ")
Sqladd("FROM "~Dbo()~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON S1.Cliente = C.Codigo ")
Sqladd("     INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = S1.Especie ")
Sqladd("     INNER JOIN "~Dbo()~".ESTADOSCUSTODIA EC WITH (NOLOCK) ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
Sqladd("        ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
Sqladd("WHERE S1.Cliente <> '"~dialogo.vehiculo1~"' AND  S1.Saldo <> 0 AND ")
Sqladd("      S1.Fecha = (SELECT MAX(S2.Fecha)                        ")
Sqladd("                  FROM "~Dbo()~".SALDOSDIA S2 WITH (NOLOCK)     ")
Sqladd("                  WHERE S2.Cliente      = S1.Cliente      AND ")
Sqladd("                        S2.Especie      = S1.Especie      AND ")
Sqladd("                        S2.EnteCustodia = S1.EnteCustodia AND ")
Sqladd("                        S2.Mercado      = S1.Mercado      AND ")
Sqladd("                        S2.NrSaldo      = S1.NrSaldo      AND ")
Sqladd("                        S2.Cuenta       = S1.Cuenta       AND ")
Sqladd("                        S2.Fecha       <= '"~IdxDate(dialogo.fecha1)~"' ) ")
Sqladd("GROUP BY E.Codigo, E.Extendido, E.ISIN, E.CodMAEContado, E.CodNumCajaValores, ")
Sqladd("         E.LocalRating1, E.Tipo, E.PaisOrigen, E.MonedaEmision, E.FechaCambioTasa, ")
Sqladd("         E.TasaIntAnterior, E.TasaIntVigente, E.InteresesC, C.PaisDir, ")
Sqladd("         C.CategDepositante, CASE AFJP WHEN 'NO' THEN 'NO' WHEN 'SI' THEN 'SI' ELSE 'NO' END ")
Sqladd("ORDER BY 3,1,10")

Acn(az22, BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', dialogo.vehiculo1))

Act(a1, 'Circular "A" 3310 a la fecha '~dialogo.fecha1~' Entidad Informante : '~FStr(Val(az22), 0, 0))
