Act(ax1, '5')
else
Act(ax1, '6')
endif
endif
endif
endif
endif
Act(j:fac, Val(ax1))

Acn(k:fac, Fbn()['Cantidad'])


Acn(yt1, Fac())
Acd(yu:fac, dialogo.fecha1)
Act(yv:fac, Fbn()['Especie'])
Acn(yw:fac, Fbn()['Cantidad'])
Acd(yx:fac, Fbn()['FechaCambioTasa'])
Acn(yy:fac, Fbn()['TasaIntAnterior'])
Acn(yz:fac, Fbn()['TasaIntVigente'])
Acn(ti:1, 0)
if (Eqstr(BuscarCampo('ESPECIES', 'InteresesC', 'Codigo', Val(yv:Val(yt1))), 'CLE'))
Acn(ti:1, InteresEspecie(Val(yv:1), Val(yu:1), Val(yw:1) * (1 + IntsCapitalizados2(Val(yv:1), Val(yu:1)))))
endif


Acn(ca:fac, Val(zz:fac))
Acn(cc:fac, ValorTeorico2(Fbn()['Especie'], dialogo.fecha1))

Act(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Fbn()['Especie']))

if (Eqstr(Fbn()['InteresesC'], 'CLE'))
if (Incluido(Val(al4), '1585'))
Acn(m:fac, Val(k:fac) * Val(cc:fac) * Val(l:fac) + (Val(ca:fac) * Val(cc:fac)))
else
Acn(m:fac, Val(k:fac) * Val(cc:fac) * Val(l:fac) + Val(ca:fac))
endif
else
Acn(m:fac, Val(k:fac) * Val(l:fac) + Val(ca:fac))
endif


Act(k:fac, FStr(Round2(Val(k:fac) / 1000, 2), 0, 0))
Act(m:fac, FStr(Round2(Val(m:fac) / 1000, 2), 0, 0))

SetFont(a:fac..m:fac, 1)
