HojaVisible(SI)
MostrarCuadroDeMensajes()

creardialogo
fecha1: 'Fecha Saldos';1;1;1;SI;SI;EsHabil(dialogo.fecha1, 'ARG');'Dia no habil';SI;Habiles(FSys(), -1, 'ARG')
directorio1: 'Path ';2;1;1;SI;SI;;;;Var('PATHDN')
string1: 'Archivo ';3;1;1;SI;SI;;;;Var('FILEDN')
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar('El directorio '~dialogo.directorio1~' no existe')
endif


let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

Act(c:1, 'Informe de errores de Importacion de Saldos Bancarios')
SetFont(c:1, 1)
Act(a:3, 'Fecha: '~dialogo.fecha1)
SetFont(a:3, 2)

importarxls(g:4..i:10000, zx:4..zz:100000, &pf)
if (not ok)
Cancelar('Error al cargar el archivo'~&pf)
endif

let(&fecsaldos, Fecha(Val(zz:4)))

if (&fecsaldos <> dialogo.fecha1)
Cancelar('Fecha Saldos('~dialogo.fecha1~') y fecha del XLS('~&fecsaldos~') son distintas')
endif

SetFilaActual(4)
Acn(fa:1, Fac())

Message('Procesando datos')
recorrer&i 5, 100000

if (NoVacio(Val(zx:&i)))
Act(a:Val(fa:1), 'Mensaje de Error')
Ifa()
SetFont(a:Val(fa:1), 2)
AgregarMarco(a:Val(fa:1)..f:Val(fa:1), 1, 1, Exe('COLOR'))

let(&ultfila, Fac())
endif
proximo

Act(a:&ultfila + 2, 'FIN DEL INFORME')
SetFont(a:&ultfila + 2, 2)


LimitesVision(i:&ultfila + 2)
Message('Insertando registros en la Base de Datos')


SetFilaActual(5)

recorrer&j 5, 100000

if (NoVacio(Val(zx:&j)))

let(&nombrecta, BuscarCampo('CUENTAS', 'Nombre', 'Numero', Val(zx:&j)))
let(&bancocta, BuscarCampo('Clientes', 'Alias3', 'Codigo', BuscarCampo('Cuentas', 'Comitente', 'Numero', Val(zx:&j))))

let(&inssaldo, 0)
if (Query(" Select 1 from "~Dbo()~".CUENTAS Where Numero ='"~Val(zx:&j)~"' ") <> 1)
Act(a:fac, 'No existe la cuenta Nr: '~Val(zx:&j)~'  ')
ColorCeldas(a:fac, clred)
Ifa()
else
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Habiles(dialogo.fecha1, -1, 'ARG'))~"' and NrCuenta = '"~Val(zx:&j)~"' and Estado <> 'ANU'  ") = 1)
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~Val(zx:&j)~"' and Estado <> 'ANU'  ") = 1)
Act(a:fac, 'Ya existe saldo para la cuenta Nr: '~Val(zx:&j)~' al '~dialogo.fecha1~' ')
ColorCeldas(a:fac, clred)
Ifa()
else
let(&inssaldo, 1)
endif
else
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo < '"~IdxDate(Habiles(dialogo.fecha1, -1, 'ARG'))~"' and NrCuenta = '"~Val(zx:&j)~"' and Estado <> 'ANU'  ") = 1)
Act(a:fac, 'Faltan cargar saldos para días anteriores para la cuenta Nr: '~Val(zx:&j)~' al '~dialogo.fecha1~' ')
ColorCeldas(a:fac, clred)
Ifa()
else
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~Val(zx:&j)~"' and Estado <> 'ANU'  ") = 1)
Act(a:fac, 'Ya existe saldo para la cuenta Nr: '~Val(zx:&j)~' al '~dialogo.fecha1~' ')
ColorCeldas(a:fac, clred)
Ifa()
else
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~Val(zx:&j)~"' and Estado <> 'ANU'  ") = 1)
Act(a:fac, 'Existen saldos posteriores para la cuenta Nr: '~Val(zx:&j)~' al '~dialogo.fecha1~' ')
ColorCeldas(a:fac, clred)
Ifa()
else
let(&inssaldo, 1)
endif
endif
endif
endif
endif
if (&inssaldo = 1)
Acd(dd:1, Fecha(PriDeMes(&fecsaldos, SI)))
let(&contable, 0)
let(&operativo, 0)
let(&inicial, 0)
let(&dias, 0)
if (Val(dd:1) < &fecsaldos)
Sqladd(" Select TOP 1 SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu from "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" where NrCuenta = '"~Val(zx:&j)~"' and FechaSaldo < '"~IdxDate(&fecsaldos)~"' and  FechaSaldo >= '"~IdxDate(Val(dd:1))~"' and Estado <> 'ANU' ")
Sqladd(" Order by FechaSaldo DESC ")
recorrer sql
Dfa()
let(&contable, Fbn()['SaldoAcuCon'])
let(&operativo, Fbn()['SaldoAcuOpe'])
let(&inicial, Fbn()['SaldoAcuIni'])
let(&dias, Fbn()['DiasAcu'])
break
proximo
endif

let(&contable, &contable + Val(zy:&j))

let(&inicial, &inicial + Val(zy:&j))

let(&operativo, &operativo + Val(zy:&j))

let(&flag2, 0)

recorrer&k &fecsaldos, Habiles(&fecsaldos, +1, 'ARG') - 1
let(&dias, &dias + 1)
if (&flag2 = 0 y Fecha(&k) > FinDeMes(&fecsaldos, SI))
let(&dias, 1)
let(&flag2, 1)
let(&operativo, Val(zy:&j))
let(&contable, Val(zy:&j))
let(&inicial, Val(zy:&j))
else
if (&k > &fecsaldos)
let(&operativo, &operativo + Val(zy:&j))
let(&contable, &contable + Val(zy:&j))
let(&inicial, &inicial + Val(zy:&j))
endif
endif
let(&signoinicial, iif (Val(zy:&j) > 0, 'C', 'D'))
Sqladd(" INSERT INTO "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" (FechaSaldo, FechaBajada, FechaCarga, NrCuenta, Nombre, SaldoContable, ")
Sqladd(" SaldoInicio, SaldoOperativo, Proyectado24h, Proyectado48h, ")
Sqladd(" Estado, Banco, ")
Sqladd(" SaldoOpePromedio, SaldoConPromedio, Usuario, SaldoIniPromedio, ")
Sqladd(" SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, Ajuste, ")
Sqladd(" SignoInicial) ")
Sqladd(" Values('"~IdxDate(Fecha(&k))~"' , '"~IdxDate(FSys())~"' , "~SQLAhora()~" , '"~Val(zx:&j)~"' , '"~Copy(&nombrecta, 1, 40)~"' , "~FStr(Val(zy:&j), 1, 2)~" , ")
Sqladd(" "~FStr(Val(zy:&j), 1, 2)~" , "~FStr(Val(zy:&j), 1, 2)~" , "~FStr(Val(zy:&j), 1, 2)~" , "~FStr(Val(zy:&j), 1, 2)~" , ")
Sqladd(" 'REC' , '"~&bancocta~"' , ")
Sqladd(" "~FStr(&operativo / &dias, 1, 2)~" , "~FStr(&contable / &dias, 1, 2)~" , '"~UsuarioActivo()~"' , "~FStr(&inicial / &dias, 1, 2)~" , ")
Sqladd(" "~FStr(&contable, 1, 2)~", "~FStr(&operativo, 1, 2)~", "~FStr(&inicial, 1, 2)~", "~FStr(&dias, 1, 0)~", 0,  ")
Sqladd(" '"~&signoinicial~"') ")
Sqlnew()
Sqlexec()
proximo
endif
else
break
endif
proximo

