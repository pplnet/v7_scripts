CrearDialogo
  Fecha1: 'Fecha'                ;;;;;;;;;fsys
  Check1: 'Saldos y Movimientos' ;;;;;;;;;1
  Check2: 'Cobranzas'            ;;;;;;;;;1
  Check3: 'Disponibilidades'     ;;;;;;;;;1
  Check4: 'Movs del Dia'         ;;;;;;;;;1
FinDialogo

If Not OK 
  Cancelar
Endif

ACN(xx:1,0)

If Dialogo.Check1=1
  SQL.ADD(" SELECT Codigo, Extension FROM "~DBO~".OBJETOS WHERE Codigo = '"~Fecha(Dialogo.Fecha1)~"' AND Extension LIKE 'APBD3%' ")
  ACN(xx:1,1)
Endif

If Dialogo.Check2=1
  If Val(xx:1)=1
    SQL.ADD(" UNION ")
  Endif
  SQL.ADD(" SELECT Codigo, Extension FROM "~DBO~".OBJETOS WHERE Codigo = '"~Fecha(Dialogo.Fecha1)~"' AND Extension LIKE 'APBD2%' ")
  ACN(xx:1,1)
Endif

If Dialogo.Check3=1
  If Val(xx:1)=1
    SQL.ADD(" UNION ")
  Endif
  SQL.ADD(" SELECT Codigo, Extension FROM "~DBO~".OBJETOS WHERE Codigo = '"~Fecha(Dialogo.Fecha1)~"' AND Extension LIKE 'APBD5%' ")
  ACN(xx:1,1)
Endif

If Dialogo.Check4=1
  If Val(xx:1)=1
    SQL.ADD(" UNION ")
  Endif
  SQL.ADD(" SELECT Codigo, Extension FROM "~DBO~".OBJETOS WHERE Codigo = '"~Fecha(Dialogo.Fecha1)~"' AND Extension LIKE 'APBD4%' ")
Endif
SQL.ADD(" ORDER BY 2 ")

ACN(z:1, 0)
Recorrer SQL
   ACN(z:1, 1)
   ACT(Aa:fac, fbn('Codigo'))
   ACT(Ab:fac, fbn('Extension'))
   ACN(Ac:fac, 1)
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron registros.')
Endif

CrearListBox; 'Arial,8,'
 'OK '  ;Ac:1..Ac:fac;SI;;; 50;CHECK ;RGB(232,255,215);
 ' '    ;Ab:1..Ab:fac;NO;;;500;STRING;;RGB(232,255,215);
FinListBox

If Not Ok
  Cancelar
Endif

Recorrer&i 1,fac
  If Val(Ac:&i)=1
    EjecutarEvento('APBD61',Fecha1=Dialogo.Fecha1,String=Val(Ab:&i))
  Endif
Proximo


