sql.add("  and Cliente     = '"~Val(b:7)~"' ")
sql.add("  and NrSaldo     = "~FStr(Val(b:9), 1, 0)~" ")
sql.add("  and Mercado     = '"~Val(b:11)~"' ")
sql.add("  and FechaMov    = '"~IdxDate(Val(b:2))~"' ")
