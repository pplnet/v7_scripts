creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 > 0 y dialogo.fecha1 <= FSys();'La Fecha es Invalida';NO;FSys()
check1:'Procesa';;;;NO;;;;;1
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Sqladd("Select NrOperacion,TipoOp,FechaOp,FechaVto,Especie,ContraEspecie,Cantidad,Precio1 ")
Sqladd("  from "~Dbo()~".OPERACIONES ")
Sqladd(" where TipoOp           In ('FXCT','FXVT') ")
Sqladd("   and IsNull(CB9,'0')  =  '0' ")
Sqladd("   and IsNull(CB10,'0') =  '0' ")
Sqladd("   and FechaVto         <= '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Acn(x1, 1)

Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acd(d:fac, Fbn('FechaVto'))
Act(e:fac, Fbn('Especie'))
Act(f:fac, Fbn('ContraEspecie'))
Acn(g:fac, Fbn('Cantidad'))
Acn(h:fac, Fbn('Precio1'))
Acn(i:fac, CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaVto') - 1, 1, SI, Fbn('ContraEspecie')))
Acn(j:fac, Val(i:fac) * CotizacionC(Fbn('ContraEspecie'), null, null, null, Fbn('FechaVto') - 1, 1, SI, 'USD'))
Acn(k:fac, Val(h:fac) * CotizacionC(Fbn('ContraEspecie'), null, null, null, Fbn('FechaVto') - 1, 1, SI, 'USD'))

if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set CB10     = '1', ")
Sqladd("       PrecioEj = "~FStr(Val(i:fac), 0, 7)~"  ")
Sqladd("where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqlexec()

if (Fbn('FechaVto') <= FSys())
Sqladd("INSERT INTO "~Dbo()~".MOVPOSEJE ")
else
Sqladd("INSERT INTO "~Dbo()~".MOVPOSPEN ")
endif
Sqladd("(FechaMov,    Cliente,    Vehiculo, ")
Sqladd(" Unidad,      Centro,     Sector, ")
Sqladd(" Sucursal,    NrSaldo,    Especie, ")
Sqladd(" FechaEj,     CallPut,    Cantidad, ")
Sqladd(" Precio,      Estrategia, Cartera, ")
Sqladd(" Book,        Trader,     TipoNegocio, ")
Sqladd(" NrOperacion, Tipo ")
Sqladd(") ")
Sqladd("SELECT '"~IdxDate(Fbn('FechaVto'))~"', Cliente,    Vehiculo, ")
Sqladd("       Unidad,                         Centro,     Sector, ")
Sqladd("       Sucursal,                       NrSaldo,    Especie, ")
Sqladd("       FechaEj,                        CallPut,    -Cantidad, ")
Sqladd("       "~FStr(Val(i:fac), 0, 7)~",       Estrategia, Cartera, ")
Sqladd("       Book,                           Trader,     TipoNegocio, ")
Sqladd("       NrOperacion,                    Tipo ")
Sqladd(" FROM "~Dbo()~".MOVPOSEJE ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd("   And NrSaldo     = 123 ")
Sqlnew()

