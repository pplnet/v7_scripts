HojaVisible(SI)
creardialogo
fecha1:'Fecha';;;;NO;;;;;FSys();;;;;;
especie1:'Especie';;;;;;;;;'WTI';;;;;;
findialogo

if (not ok)
Cancelar()
endif
Act(a1, 'Curva de Futuros de Commodities al '~dialogo.fecha1)

Act(a3, 'Contrato')
Act(b3, 'Precio')
Act(c3, 'LastTrade')

AlinearCeldas(a3..c3, 'D')

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
AgregarMarco(a3..c3, 2, 0, Exe('COLOR'))

linkearddeserver('Excel', '(ContFut.xls)Hoja1')

Sqladd("Select * from "~Dbo()~".CONTRATOS Where Especies Like '%"~dialogo.especie1~"%' and ")
Sqladd(" LastTradingDate>='"~IdxDate(dialogo.fecha1)~"' Order By LastTradingDate ")


Acn(x1, 0)

SetFilaActual(4)

Acn(z3, 3)

Acd(c:fac, Habiles(dialogo.fecha1, -1, 'ARG', SI))
Acd(z4, dialogo.fecha1)
SetFont(a:fac..c:fac, 1)

recorrer sql

if (Val(x1) = 0)
recorrer&j 1, 100
Act(z6, 'f'~FStr(&j, 0, 0)~'c1')
Acf(a:fac, linkdde(Val(z6)))

if (Eqstr(Val(a:fac), Fbn()['Codigo']))
Acn(z2, &j)
break
endif
proximo
Acn(x1, 1)
endif

if (Val(z2) > 0)
Message('Contrato Futuro '~Fbn()['Codigo'])

Act(z6, 'f'~FStr(Val(z2), 0, 0)~'c'~FStr(Val(z3), 0, 0))

Act(a:fac, Fbn()['Codigo'])
Acf(b:fac, linkdde(Val(z6)))
Acd(c:fac, Fbn()['LastTradingDate'])

SetFont(a:fac..c:fac, 1)
FormatoCeldas(b:fac..b:fac, Exe('F7'))


Acn(z1, DifDias(Habiles(Val(c:fac - 1), 1, 'ARG', SI), Val(c:fac), 'ARG', SI) + 1)

recorrer&i 1, Val(z1)
Message("  Actualizando Precios al "~Val(z4)~" ...")

if (Query("SELECT Count(*) FROM "~Dbo()~".CURVAFUTUROSCOMM Where Especie='"~dialogo.especie1~"' and Fecha='"~IdxDate(Val(z4))~"' ") = 1)
Sqladd("UPDATE "~Dbo()~".CURVAFUTUROSCOMM Set PrecioFut="~FStr(Val(b:fac), 0, 7)~" Where ")
Sqladd("Especie='"~dialogo.especie1~"' and ")
Sqladd("Fecha='"~IdxDate(Val(z4))~"' ")
else
Sqladd(" INSERT "~Dbo()~".CURVAFUTUROSCOMM ")
Sqladd(" (Especie,Fecha,PrecioFut,PrecioCon) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.especie1~"','"~IdxDate(Val(z4))~"',"~FStr(Val(b:fac), 0, 7)~",0) ")
endif

Sqlnew()
Sqlexec()

Acd(z4, Habiles(Val(z4), 1, 'ARG', SI))
proximo

Scn(z2, 1)
else
Cancelar('No se encontro el Primer contrato en la planilla excel !!!')
endif

proximo

ACO(1, 10)
ACO(2, 10)
ACO(3, 10)
LimitesVision(f:fac)



