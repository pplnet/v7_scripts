        SQL.ADD(" '1', ")
               
        * NroAltaMAE
        SQL.ADD(" '"~Val(t:39)~"', ")
        * NroBajaMAE
        SQL.ADD(" '"~Val(t:40)~"', ")
        * UDN2 (Rueda)
        SQL.ADD(" '"~Val(t:32)~"', ")
        * NrSisExterno
        SQL.ADD(" '"~Val(t:36)~"', ")
               
        * MB6
        SQL.ADD(" '2', ")
        * RB1
        SQL.ADD(" '0', ")
        * RB5 - Fuente Alta
        SQL.ADD(" '0', ")
        * EsCaucionado
        SQL.ADD(" '"~FStr(Val(t:44),1,0)~"', ")
        * AceptaMAE
        SQL.ADD(" 'SI', ")
               
        * FechaAltaMAE
        SQL.ADD(" "~Val(t:59)~", ")
        * FechaBajaMAE
        SQL.ADD(" "~Val(t:59)~", ")
        * FechaEnvioMAE
        SQL.ADD(" "~Val(t:59)~", ")

        * RuedaMAE
        SQL.ADD(" '"~Val(t:32)~"', ")
        * EspecieMAE
        SQL.ADD(" '"~Val(t:27)~"', ")
        * AgenteMAE
        SQL.ADD(" '"~Val(t:6)~"', ")
