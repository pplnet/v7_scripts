    ACT(t:58, Val(ae:Val(v:&i))~'/'~Val(ad:Val(v:&i))~'/'~Val(ac:Val(v:&i))~' '~Val(au:Val(v:&i))~':'~Val(av:Val(v:&i))~':'~Val(aw:Val(v:&i)))
    ACT(t:59, SQLFechaStr(Val(t:58),Exe('FORFECHOR')))

    ACT(t:60, Val(az:Val(v:&i)))

    if Vacio(Val(t:8))
      ACN(t:41, SQL("Select Count(*) from "~DBO~".OPERACIONES where (NroAltaMAE='"~Val(t:39)~"' or NroBajaMAE='"~Val(t:40)~"') and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
    else
      ACN(t:41, SQL("Select Count(*) from "~DBO~".OPERACIONES where (NroAltaMAE='"~Val(t:39)~"' or NroBajaMAE='"~Val(t:40)~"') and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:8)~"' and CB5='1' "))
    endif
    if Val(t:41)>0
      ACN(t:42, 1)
      if Vacio(Val(t:8))
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where (NroAltaMAE='"~Val(t:39)~"' or NroBajaMAE='"~Val(t:40)~"') and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
      else
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where (NroAltaMAE='"~Val(t:39)~"' or NroBajaMAE='"~Val(t:40)~"') and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:8)~"' and CB5='1' "))
      endif

