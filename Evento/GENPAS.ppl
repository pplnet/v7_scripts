** FJL 21/11/19 - Se saca la busqueda
*    ACT(t:55, SQL("Select Min(Codigo) from "~DBO~".CUENTAS where Cliente='"~Val(t:8)~"' and (Comitente='"~Val(t:29)~"' or Comitente is Null) and (ClHouse='"~Val(t:22)~"' or ClHouse is Null) and TipoCuenta='CUS' and (Especies Like '%TITULO%' or Especies is Null) and Estado = 'HAB' and TipoMAE = '"~Val(t:52)~"' ") )
    ACT(t:55, '' )

    *** ContraEspecie2 Moneda de Liquidacion ****
    ACT(t:54, BuscarCampo('ESPECIES','Alias10','Codigo',Val(t:12)))
    if EqStr(Val(t:12),'USD')
      if Incluido(Val(t:22),VAR('MERCAACMC'))      
        ACT(t:54, 'USD')
        if EqStr(Val(t:49),'B')
          ACT(t:54, 'USB')
        endif
      endif
      if EqStr(Val(t:22),'CRYL')
        ACT(t:54, 'USB')
      endif
      if EqStr(Val(t:22),'CV')
        ACT(t:54, 'USB')
      endif
      if EqStr(Val(t:22),'EU')
        if EqStr(Val(t:52),'5') o EqStr(BuscarCampo('CUENTAS','Global','Codigo',Val(t:55)),'S')
          ACT(t:54, 'USD')
        else
          ACT(t:54, 'USB')
        endif
      endif
    endif

    ***** Tabla Feriados (*)
    if Incluido(Val(t:49),'D|3|4|6|9')
      ACT(t:24, 'USA')
    endif
    if Incluido(Val(t:49),'1|2|5|8|B')
      ACT(t:24, 'ARG')
    endif
    if Incluido(Val(t:22),VAR('MERCAACMC'))    
      if Incluido(Val(t:54),'ARP|USB')
        ACT(t:24, 'ARG')
      endif
      if EqStr(Val(t:54),'USD')
        ACT(t:24, 'USA')
      endif
    endif
    if Vacio(Val(t:24))
      ACN(t:44, 1)
*      ACT(52+FAC:24, 'Inc')
    endif

