*** Lee de la tabla OPSIOPEL lo que esta sin procesar de Tipo de Negociacion 
*** de Pases Var('TIPONEGPAS')
*** % de Aforo en Var('PAFOREPO')
CrearDialogo
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(z:5, VAR('AGESIOP'))
* w:2 ==> z:6
ACT(z:6, VAR('CONTROLAPM'))
* w:4 ==> z:7
ACT(z:7, VAR('MSGSISEXT'))

SetFilaActual(1)
ACT(a:FAC, 'Secuencia2')
ACT(b:FAC, 'Cpra/Vta(*)')
ACT(c:FAC, 'Spot/Fut(*)')
ACT(d:FAC, 'E.Liquid.(*)')
ACT(e:FAC, 'Cod Cli(*)')
ACT(f:FAC, 'CodNego(*)')
ACT(g:FAC, 'Plazo')
ACT(h:FAC, 'Cantidad(*)')
ACT(i:FAC, 'Error?')
ACT(j:FAC, 'Listo?')
ACT(k:FAC, 'Rueda(*)')
ACT(l:FAC, 'NrMAE Cli')
ACT(m:FAC, 'Nr.Rel(*)')
ACT(n:FAC, 'Genera')
ACT(o:FAC, '# Oper.')
ACT(p:FAC, 'Nr.Pase')
ACT(q:FAC, 'Cont.Clie')
ACT(r:FAC, 'Oberv.')

ACT(v:FAC, 'Lin.Spot')
ACT(w:FAC, 'Lin.Fut')
ACT(x:FAC, '# Oper.')
ACT(y:FAC, 'Oberv.')

ACT(aa:FAC, 'Agente')
ACT(ab:FAC, 'Operador')
ACT(ac:FAC, 'Fecha_aa')
ACT(ad:FAC, 'Fecha_mm')
ACT(ae:FAC, 'Fecha_dd')
ACT(af:FAC, 'Secuencia')
ACT(ag:FAC, 'CodReg.')
ACT(ah:FAC, 'CodTitulo(*)')
ACT(ai:FAC, 'NroCupon(*)')
ACT(aj:FAC, 'Plazo')
ACT(ak:FAC, 'Moneda(*)')
ACT(al:FAC, 'AgContra')
ACT(am:FAC, 'OpContra')
ACT(an:FAC, 'Precio')
ACT(ao:FAC, 'EnteLiq.(*)')
ACT(ap:FAC, 'TipoLiq.(*)')
ACT(aq:FAC, 'Cliente')
ACT(ar:FAC, 'Pata')
ACT(as:FAC, 'Tasa(*)')
ACT(at:FAC, 'Intereses')
ACT(au:FAC, 'Hora_hh')
ACT(av:FAC, 'Hora_mm')
ACT(aw:FAC, 'Hora_ss')
ACT(ax:FAC, 'TipoOpDestino')
ACT(ay:FAC, 'TipoOpOrigen')
ACT(az:FAC, 'NrOrden')
ACT(ba:FAC, 'Mnemotecnico')

ACT(bd:FAC, '# Oper.')
ACT(be:FAC, 'es:1')
ACT(bf:FAC, 'es:2')
ACT(bg:FAC, 'cl:1')

SetFont(a:FAC..r:FAC,2)
SetFont(v:FAC..y:FAC,2)
SetFont(aa:FAC..ba:FAC,2)
SetFont(bd:FAC..bg:FAC,2)

* Para empezar las operaciones a generar en la linea 2
ACN(z:3, 1)

SQL.ADD(" Select * from "~DBO~".OPSIOPEL ")
** FJL 20/11/19 - Se agrega lacondicion de CodigoRegistro por pases 0301-0401 rueda TRD
SQL.ADD("  where CodigoRegistro in ('0105','0205')  ")
SQL.ADD("    and CodigoNego in ("~Pipe2Comillas(Var('TIPONEGPAS'))~") ")
SQL.ADD("    and Fecha      = '"~IdxDate(Fsys)~"'                     ")
** FJL 13/04/20 - No tomaba registros con Carga en Null
*SQL.ADD("    and Carga      = NULL                                    ")
SQL.ADD("    and IsNull(Carga,'')      = ''                           ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                          ")
*SQL.ADD("    and Referencia in ('71314')  ")
Recorrer SQL
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
  if SI
    ***** Tipo Oper. (1=Cpra, 2=Vta)
    ***** Agente MAE
    if EqStr(fbn('AgenteContra'),Val(z:5))
      * Cpra mia
      ACN(b:FAC,1)
      ACT(l:FAC, fbn('Agente'))
    else
      if EqStr(fbn('Agente'),Val(z:5))
        * Vta Mia
        ACN(b:FAC,2)
        ACT(l:FAC, fbn('AgenteContra'))
      else
        ACN(z:1,1)
      endif
    endif
    ***** Tipo Oper. (1=Spot, 2=Futuro)
    ACN(c:FAC, Num(fbn('Pata')))
    ***** Ente Liquidador
** FJL 21/11/19 - Se agregan los codigos de Maeclear
    if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9') o Incluido(fbn('EnteLiquidador'),'1|2|5|8|B') o Incluido(fbn('EnteLiquidador'),'G|F|W|U')
      ACT(d:FAC, fbn('EnteLiquidador'))
    else
      SCN(z:1,1)
    endif
    ***** Cliente
    ACT(e:FAC, SQL("Select Codigo from "~DBO~".CLIENTES where NrMAE = '"~Val(l:FAC)~"' "))
    if Vacio(Val(e:FAC))
** FJL 09/03/21 - Para que genere igual y mande a Incompleto con Cliente1='SIOPEL'
*      ACN(z:1,1)
    endif
    ***** TipoNegociacion
    ACT(f:FAC, fbn('CodigoNego'))
    ***** Plazo Spot
    if Val(c:FAC)=1 o SI
      ACN(g:FAC, Num(fbn('Plazo')))
    endif
    ***** Cantidad
    ACN(h:FAC, fbn('Cantidad'))
    ***** Rueda
    ACT(k:FAC, fbn('CodigoRueda'))
    ***** Referencia
    ACT(m:FAC, fbn('Referencia'))
    ***** Codigo Cliente
    if EqStr(Val(e:FAC),fbn('Cliente'))
      ACT(q:FAC, 'OK')
    else
      ACT(q:FAC, 'Error')
    endif
    if Val(z:1)=0
      ACT(aa:FAC, fbn('Agente'))
      ACT(ab:FAC, fbn('Operador'))
      ACT(ac:FAC, fbn('Fecha_aa'))
      ACT(ad:FAC, fbn('Fecha_mm'))
      ACT(ae:FAC, fbn('Fecha_dd'))
      ACT(af:FAC, fbn('Secuencia'))
      ACT(ag:FAC, fbn('CodigoRegistro'))
      ACT(ah:FAC, fbn('CodigoTitulo'))
      ACT(ai:FAC, fbn('Nrocupon'))
      ACT(aj:FAC, fbn('Plazo'))
      ACT(ak:FAC, fbn('Moneda'))
      ACT(al:FAC, fbn('AgenteContra'))
      ACT(am:FAC, fbn('OperadorContra'))
      ACN(an:FAC, fbn('Precio'))
      ACT(ao:FAC, fbn('EnteLiquidador'))
      ACT(ap:FAC, fbn('TipoLiquidacion'))
      ACT(aq:FAC, fbn('Cliente'))
      ACT(ar:FAC, fbn('Pata'))
      ACN(as:FAC, fbn('Tasa'))
      ACN(at:FAC, fbn('Interes'))
      ACT(au:FAC, fbn('Hora_hh'))
      ACT(av:FAC, fbn('Hora_mm'))
      ACT(aw:FAC, fbn('Hora_ss'))
      ACT(ax:FAC, fbn('TipoOpDestino'))
      ACT(ay:FAC, fbn('TipoOpOrigen'))
      if Vacio(fbn('NroOrdenComprador'))
         ACT(az:FAC, Copy(fbn('NroOrdenVendedor'),7,5))
      else
         ACT(az:FAC, Copy(fbn('NroOrdenComprador'),7,5))
      Endif 
      ACT(ba:FAC, fbn('Mnemotecnico'))
    else
       ACT(i:FAC, 'ERROR')
    endif
  else
    if Dialogo.Check1=1
      SQL.ADD("Update "~DBO~".OPSIOPEL ")
      SQL.ADD("   Set Procesado  = '1',")
      SQL.ADD("       Carga      = '2' ")
      SQL.ADD(" where Secuencia2 = '"~Val(a:FAC)~"' ")
      SQL.NEW
      SQL.EXEC
    endif
  endif
proximo


if FAC>1
  recorrer&i 2,FAC
    if Vacio(Val(i:&i)) y Vacio(Val(j:&i))
      * Sin error       y No usado
      recorrer&j &i+1,FAC
        if Vacio(Val(i:&j)) y Vacio(Val(j:&j))
          * Sin error       y No usado
          if Val(b:&i)<>Val(b:&j)
            * Distinto Cpra/Vta
            if Val(c:&i)<>Val(c:&j)
              * Distinto Spot/Fut
              if EqStr(Val(d:&i),Val(d:&j))
                * Igual EnteLiquidador
                if EqStr(Val(e:&i),Val(e:&j))
                  * Igual Cliente
                  if EqStr(Val(f:&i),Val(f:&j))
                    * Igual CodigoNego
                    if Val(h:&i)=Val(h:&j)
                      * Igual Cantidad
                      if EqStr(Val(k:&i),Val(k:&j))
                        * Igual Rueda
                        if EqStr(Val(m:&i),Val(m:&j))
                          * Igual NrRelacion
                          if EqStr(Val(ah:&i),Val(ah:&j))
                            * Igual EspecieMAE
                            if EqStr(Val(ai:&i),Val(ai:&j))
                              * Igual NrCuponMAE
                              if EqStr(Val(ak:&i),Val(ak:&j))
                                * Igual Moneda
                                if EqStr(Val(ao:&i),Val(ao:&j))
                                  * Igual EnteLiq
                                  if EqStr(Val(ap:&i),Val(ap:&j))
                                    * Igual FormaLiq
                                    if Val(as:&i)=Val(as:&j)
                                      * Igual Tasa
                                      SCN(z:3,1)
                                      if Val(c:&i)=1
                                        ACN(v:Val(z:3), &i)
                                        ACN(w:Val(z:3), &j)
                                      else
                                        ACN(v:Val(z:3), &j)
                                        ACN(w:Val(z:3), &i)
                                      endif
                                      ACT(j:&i, 'LISTO')
                                      ACT(j:&j, 'LISTO')
                                      ACN(p:&i, Val(z:3))
                                      ACN(p:&j, Val(z:3))
                                    endif
                                  endif
                                endif
                              endif
                            endif
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      proximo
    endif
  proximo
  FormatoCeldas(h:1..h:FAC,Exe('F2'))
  FormatoCeldas(an:1..an:FAC,Exe('F8'))
  FormatoCeldas(as:1..as:FAC,Exe('F8'))
  FormatoCeldas(at:1..at:FAC,Exe('F2'))
else
  if Dialogo.Check1=0
    MessageBox('No hay registros en OPSIOPEL para analizar.')
  endif
endif


if Val(z:3)>1 
  SetFilaActual(0)
  ACT(s:1, 'NrOperacion')
  ACT(s:2, 'TipoOp')
  ACT(s:3, 'Especie')
  ACT(s:4, 'Cupon MAE')
  ACT(s:5, 'Nro.Cupon')
  ACT(s:6, 'Ag.Contra')
  ACT(s:7, 'Clie.Tabla (A)')
  ACT(s:8, 'Cliente')
  ACT(s:9, 'Op.Contra (A)')
  ACT(s:10, 'VTXT3 (A)')
  ACT(s:11, '11-Cantidad')
  ACT(s:12, 'C.Especie')
  ACT(s:13, 'Pre.Spot MAE')
  ACT(s:14, 'Precio3')
  ACT(s:15, 'Precio4')
  ACT(s:16, 'Ints.Spot MAE')
  ACT(s:17, 'Tasa')
  ACT(s:18, 'FechaOp txt (A)')
  ACT(s:19, 'FechaOp')
  ACT(s:20, 'MB1 (ex-ValorRB1)')
  ACT(s:21, '21-PlazoGracia')
  ACT(s:22, 'Mercado')
  ACT(s:23, 'F.Liq.1 y 2')
  ACT(s:24, 'Feriados')
  ACT(s:25, 'Operador')
  ACT(s:26, 'Op.SIOPEL')
  ACT(s:27, 'Cod.MAE Esp.')
  ACT(s:28, 'DiasAnio')
  ACT(s:29, 'Vechiculo1')
  ACT(s:30, 'UND1')
  ACT(s:31, '31-Mercado4')
  ACT(s:32, '# Rueda')
  ACT(s:33, 'EsAforado')
  ACT(s:34, 'MB4')
  ACT(s:35, 'PorAforo')
  ACT(s:36, 'Referencia')
  ACT(s:37, 'Pre.Fut. MAE')
  ACT(s:38, 'Ints.Fut. MAE')
  ACT(s:39, 'SecMAE Spot')
  ACT(s:40, 'SecMAE Fut.')
  ACT(s:41, '41-Cant.Ops.')
  ACT(s:42, 'Duplicada')
  ACT(s:43, 'Op.Anterior')
  ACT(s:44, 'Incompleto')

  ACT(s:45, 'Observ')
  ACT(s:46, 'Moneda')
  ACT(s:47, 'Cod.Reg.Spot')
  ACT(s:48, 'Cod.Reg.Fut.')
  ACT(s:49, 'EnteLiquidador')
  ACT(s:50, 'FormaLiquidacion')
  ACT(s:51, '51-z:1')
  ACT(s:52, 'TipoOpDestino')
  ACT(s:53, 'TipoOpOrigen')
  ACT(s:54, 'ContraEspecie2')
  ACT(s:55, 'Cuenta1')
  ACT(s:56, 'OficialCuenta --')
  ACT(s:57, 'Book1 --')
  ACT(s:58, 'FechaAltaMAE (txt)')
  ACT(s:59, 'FechaAltaMAE')
  ACT(s:60, '60-NrOrden')

  ACT(s:62, '62-Mercado2')
  ACT(s:63, 'EstadoOperativo')
  ACT(s:64, 'A Compliance SE')
  SetFont(s:1..s:64,2)

  recorrer&i 1,64
    ACT(bz:&i, Val(s:&i))
  proximo
  SetFont(bz:1..bz:64,2)

  recorrer&i 2,Val(z:3)
    IFA
    if &i>20
      Break
    endif
    BorrarCeldas(t:1..t:62)
    BorrarCeldas(es:1..es:2)
    BorrarCeldas(cl:1)
    ACN(z:1, 0)
    ***** Tipo Op
    if Val(b:Val(v:&i))=2
      ACT(t:2,'TIPP')
    else
      if val(b:val(v:&i))=1
        ACT(t:2,'TIPA')
      else
        SCN(z:1,1)
*        ACN(52+FAC:2, 1)
      endif
    endif
    ***** Especie
    ACT(t:27, Val(ah:Val(v:&i)))
    ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado = '"~Val(t:27)~"' "))

    if Vacio(Val(t:3))
      ACN(t:44, 1)
*      ACN(52+FAC:3, 1)
** FJL 17/12/20 - Para que funcione como TIC-TIV cuando no existe la especie. La crea y va a Incompleto.
      ACN(es:1, 1)
      ACN((26+FAC):3, 1)
      ACN(u:3, SQL("Select 1 From "~DBO~".ESPECIES Where Codigo='"~Val(t:27)~"' "))
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
*      EjecutarEvento('ALTESP', String1=Val(t:27),String2=Val(ba:Val(v:&i)),Check1=Dialogo.Check1)
      EjecutarEvento('ALTESP', String1=Val(t:27),String2=Val(ba:Val(v:&i)),Entero1=Num(Val(ai:Val(v:&i))),Check1=Dialogo.Check1)
      ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    else
      ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
      if Eqstr(Val(es:2),'DES')
        ACN(es:1,1)
      Endif
    endif
    ***** Cupon MAE
*    ACT(t:4, Val(ai:Val(v:&i)))
    ACT(t:4, Fstr(Num(Val(ai:Val(v:&i))),1,0))
    ***** Nro Cupon
    ACT(t:5, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))

* FJL 15/07/19 - Por Issue 3799 - Especies Sancionadas
    ***** EstadoOperativo
    ACT(t:63, BuscarCampo('ESPECIES','EstadoOperativo','Codigo',Val(t:3)))
    if Vacio(Val(t:63))
      ACT(t:63, 'NE')
    endif
    ***** A Compliance SE
    ACT(t:64, 'NO')
    if EqStr(Val(z:6),'SI') 
      if Incluido(Val(t:64),'SI|NE')
        ACT(t:64, 'SI')
      endif
    endif

    
    ***** Agente Contra
    ACT(t:6, Val(l:Val(v:&i)))
    ***** Cliente Tabla
    ACT(t:7, Val(aq:Val(v:&i)))
    ***** Codigo Cliente
    if EqStr(Val(t:6),'000') o EqStr(Val(t:6),Val(v5))
      ACT(t:45, 'Cliente erroneo. Nr MAE : '~Val(t:6))
    else
      ACT(t:8, Val(e:Val(v:&i)))
      ***** Operador Contra
      ACT(t:9, Val(am:Val(v:&i)))
      if Vacio(Val(t:8))
        ACT(t:45, 'Cliente no existente en FPA. Nr MAE : '~Val(t:6))
      endif
    endif
    ***** Mercado4
    ACT(t:31, Var('AMBMAE'))
    ***** VTXT3
***///***    
    *    ACT(t:10, CampoMercado(Val(t:31),Val(t:3),Val(t:8),2))
    ***** Cantidad
    ACN(t:11, Val(h:Val(v:&i)))
    if Val(t:11)=0
      SCN(z:1,1)
*      ACT(52+FAC:11, 'Err')
    endif
    ***** MonedaMAE
    ACT(t:46, Val(ak:Val(v:&i)))
    ***** ContraEspecie
    if EqStr(Val(t:46),'D')
      ACT(t:12, 'USD')
      ACT(t:62, 'SWIFT')
    else
      if EqStr(Val(t:46),'$')
        ACT(t:12, 'ARP')
        ACT(t:62, 'BCRA')
      else
        ACN(t:44, 1)
*        ACN(52+FAC:12, 1)
      endif
    endif
    ***** PrecioMAE Spot (*)
    ACN(t:13, Val(an:Val(v:&i)))
    ***** Precio3 / Precio4 (*)
    if Eqstr(Val(t:10),'CLE')
      ACN(t:14, Val(t:13))
    else
      ACN(t:15, Val(t:13))
    endif
    ***** InteresesMAE Spot (*)
    ACN(t:16, Val(at:Val(v:&i)))
    ***** Tasa
    ACN(t:17, Val(as:Val(v:&i)))
    ***** Codigo Registro
    ACT(t:47, Val(ag:Val(v:&i)))
    ACT(t:48, Val(ag:Val(w:&i)))
    ***** Fecha Op
    if EqStr(Copy(Val(ag:Val(v:&i)),3,2),'05')
      ACT(t:18, Val(ae:Val(v:&i))~'/'~Val(ad:Val(v:&i))~'/'~Val(ac:Val(v:&i)))
      ACD(t:19, Fecha(Val(t:18)))
    else
      SCN(z:1,1)
*      ACT(52+FAC:19, 'Err')
    endif
    ***** ValorRB1
    if Val(c:Val(v:&i))=1
      * Pata Spot
      if Val(g:Val(v:&i))<=3
        ACT(t:20, FStr(Val(g:Val(v:&i)),1,0))
      else
        SCN(z:1,1)
*        ACT(52+FAC:20, 'Err')
      endif
    endif
    if Val(c:Val(w:&i))=2
      * Pata Futuro
      * Plazo pata futura - Plazo del pase 
      ACN(t:21, Val(g:Val(w:&i)))
    endif

    ***** Mercado - Mercado2 (*)
    ACT(t:49, Val(ao:Val(v:&i)))
    if Incluido(Val(t:49),'1|D|T|B')
      ACT(t:22, 'AC')
      ACT(t:62, 'AC')
    else
      if EqStr(Val(t:49),'2')
        ACT(t:22, 'CRYL')
** FJL 08/11/21 - Se cambia a CRYL cuando llega del MAE
*        ACT(t:62, 'BCRA')
** FJL 29/06/22 - Se vuelve a BCRA
*        ACT(t:62, 'CRYL')
        ACT(t:62, 'BCRA')
      else
        if EqStr(Val(t:49),'3')
          ACT(t:22, 'CE')
          ACT(t:62, 'CE')
        else
          if EqStr(Val(t:49),'4')
            ACT(t:22, 'EU')
            ACT(t:62, 'EU')
          else
            if Incluido(Val(t:49),'5|6|8|9')
              ACT(t:22, 'CV')
            else
              if Incluido(Val(t:49),'G|F|U|C')
                ACT(t:22, VAR('ENTELIQA3'))
                *Para garantizado en dolares el mercado puede ser variable.
                if  EqStri(Val(t:49),'G') y EqStri(Val(t:12),'D')
                  ACT(t:62, VAR('ENTELIQGD'))
                else 
                  ACT(t:62, VAR('ENTELIQA3'))
                endif
              else
                if Incluido(Val(t:49),'W')
                  ACT(t:22, VAR('ENTELIQA3'))
                  ACT(t:62, VAR('MERMCMEP'))
                else
                  ACN(t:44, 1)
*                  ACT(52+FAC:22, 'Inc')
                endif
              endif
            endif
          endif
        endif
      endif
    endif
    
    ***** Rueda
    ACT(t:32, Val(k:Val(v:&i)))
    ** FJL 22/08/25 - Por Issue 8447 BACS (Se replica modificacion del GENTIT del 17/08/23 por Issue 6614)
    if EqStr(VAR('MERESBCRA'),'SI')
      * SI la variable esta en SI usa el criterio definido por BACS
      if EqStr(Val(t:8),VAR('CLIBCRA'))
**        if Incluido(fbn('CodigoRueda'),VAR('MERESBCRAR')) o Vacio(VAR('MERESBCRAR'))
        if Incluido(Val(t:32),VAR('MERESBCRAR')) o Vacio(VAR('MERESBCRAR'))
          ACT(t:22, VAR('MERESBCRAM'))
          if Vacio(Val(t:22))
            ACT(t:22, 'CRYL')
          endif
          ACT(t:62, 'BCRA')
          ACT(t:24, 'ARG')
        endif
      endif
    endif

    ***** FormaLiquidacion (*)
    ACT(t:50, Val(ap:Val(v:&i)))
** FJL 02/07/22 - Contemplar distintos tipos de acuerdo al mercado
*    if EqStr(Val(t:50),'2')
*      ACN(t:23, 0)
*    else
*      if EqStr(Val(t:50),'1')
*        ACN(t:23, 1)
*      else
*        if EqStr(Val(t:50),'6')
*          ACN(t:23, 2)
*        else
*          ACN(t:44, 1)
**          ACT(52+FAC:23, 'Inc')
*        endif
*      endif
*    endif
    if Incluido(Val(t:22),VAR('MERCADOCV'))
      if Incluido(Val(t:50),'2|4')
        ACN(t:23, 0)
      else
        if EqStr(Val(t:50),'1')
          ACN(t:23, 1)
        else
          if EqStr(Val(t:50),'6')
            ACN(t:23, 2)
          else
            ACN(t:44, 1)
            ACN((26+FAC):23, 1)
          endif
        endif
      endif
    else
      if Incluido(Val(t:22),VAR('MERCAVARI'))
        if EqStr(Val(t:50),'5')
          ACN(t:23, 0)
        else
          if EqStr(Val(t:50),'1')
            ACN(t:23, 1)
          else
            if EqStr(Val(t:50),'2')
              ACN(t:23, 2)
            else
              ACN(t:44, 1)
              ACN((26+FAC):23, 1)
            endif
          endif
        endif
      else
*        SCN(z:1,1)
        ACN(t:44, 1)
        ACN((26+FAC):23, 1)
      endif
    endif
    if Incluido(Val(t:22),VAR('MERCAACMC'))    
        ACN(T:23, 1)
    ENDIF
    ***** TipoOpDestino
    ACT(t:52, Val(ax:Val(v:&i)))

    ***** TipoOpOrigen
    ACT(t:53, Val(ay:Val(v:&i)))

    ***** Operador / OperadorContra
    if Incluido(Val(t:2),'TIPP')
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',Val(ab:Val(v:&i))))
      ACT(t:26, Val(am:Val(v:&i)))
    else
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',Val(am:Val(v:&i))))
      ACT(t:26, Val(ab:Val(v:&i)))
    endif
    if Vacio(Val(t:25))
      ACT(t:25, UsuarioActivo)
    endif
    ***** DiasAnio
    ACN(t:28, 1)
    ***** Vehiculo1
    ACT(t:29, Var('VEHICULODE'))
    ***** UDN1
    ACT(t:30, 'MD')
    ***** EsAforado
*    if EqStr(Val(f:Val(v:&i)),'5')
    if Incluido(Val(f:Val(v:&i)),Var('TNEGPASNAF'))
      ACN(t:33, 0)
      ACN(t:34, 2)
      ACN(t:35, 0)
    else
*      if EqStr(Val(f:Val(v:&i)),'7')
      if Incluido(Val(f:Val(v:&i)),Var('TNEGPASAF'))
        ACN(t:33, 1)
        ACN(t:34, 0)
** FJL 21/11/19 - Se cambia la variable. PAFORO es la que se usa en TIPA-TIPP
*        ACN(t:35, Var('PAFOREPO'))
        ACN(t:35, Var('PAFORO'))
      else
        SCN(z:1,1)
*        ACT(52+FAC:33, 'Err')
      endif
    endif
    ***** Referencia
    ACT(t:36, Val(m:Val(v:&i)))
    ***** PrecioMAE Fut (*)
    ACN(t:37, Val(an:Val(w:&i)))
    ***** InteresesMAE Fut (*)
    ACN(t:38, Val(at:Val(w:&i)))
    ***** NrAltaMAE (*)
    ACT(t:39, Val(af:Val(v:&i)))
    ***** NrBajaMAE (*)
