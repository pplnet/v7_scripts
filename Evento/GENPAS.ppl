        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = 'DUPLIC' ")
        SQL.ADD(" where Secuencia2  = '"~Val(a:Val(v:&i))~"' ")
        SQL.NEW
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = 'DUPLIC' ")
        SQL.ADD(" where Secuencia2  = '"~Val(a:Val(w:&i))~"' ")
