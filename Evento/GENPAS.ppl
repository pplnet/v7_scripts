      ACT(n:Val(w:&i), 'OK')
      if Dialogo.Check1=1
        ACT(t:1, GetNumerador(1))
        ACT(o:Val(v:&i), Val(t:1))
        ACT(o:Val(w:&i), Val(t:1))
        ACT(x:&i, Val(t:1))
        ACT(bd:&i, Val(t:1))
        Message('--- #Op : '~Val(t:1)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:8))
        SQL.ADD("Insert into "~DBO~".OPERACIONES ( ")

