*          SQL.ADD(" '"~FStr(1,1,0)~"', ")
*        endif
        if Incluido(Val(t:22),VAR('MERCADOCV'))
          * FormaLiquidacion1
          SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
          * FormaLiquidacion2
          SQL.ADD(" '"~FStr(1,1,0)~"', ")
        else
          if Incluido(Val(t:22),VAR('MERCAVARI'))
            * FormaLiquidacion1
            SQL.ADD(" '"~FStr(0,1,0)~"', ")
            * FormaLiquidacion2
            SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
          else
            * FormaLiquidacion1
            SQL.ADD(" '"~FStr(0,1,0)~"', ")
            * FormaLiquidacion2
            SQL.ADD(" '"~FStr(1,1,0)~"', ")
          endif
        endif

        * DiasAnio
        SQL.ADD(" '"~FStr(Val(t:28),1,0)~"', ")
