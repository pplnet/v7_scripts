        SQL.ADD(" '"~IIF(EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~val(t:22)~"' "),'SI'),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~val(t:22)~"' "),Val(t:8))~"', ")
        * NrOrden
        SQL.ADD(" '"~Val(t:60)~"' ")

