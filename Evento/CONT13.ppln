MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
vehiculo1: 'Vehiculos';3;;;;;;;;;Var('VEHICULODE')
radio1: 'Func.|Autom|Manual';4;;;;NO;;;;1;
findialogo

if (not ok)
Cancelar()
endif
Message('--- Asientos de Capitalizacion de Interes ICL ---')
Act(ta:1, Var('TIPASICLCP'))
Act(ml:1, Var('MONELOCA'))
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))

Sqladd("SELECT C.NrOperacion, C.Fecha1, O.Vehiculo1, C.Cantidad3 IVA, C.Cantidad4 WTH, C.Cantidad5 IntTot, ")
Sqladd("C.Cantidad5-C.Cantidad4 Interes, MA.Codigo CodAsi, O.TipoOp, O.Especie, O.Especie ContraEspecie,C.Precio1,")
Sqladd("       '#Op:' + C.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.TipoCONU) + ',' + rtrim(O.Especie) Leyenda, O.Book1, O.TipoCONU ")
Sqladd("FROM "~Dbo()~".CUOTAS C, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".OPERACIONES O ")
Sqladd("WHERE C.Radio1 = 3 ")
Sqladd("AND O.NrOperacion = C.NrOperacion ")
Sqladd("AND C.Fecha1 = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("AND o.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("AND MA.TipoAsiento in("~Pipe2Comillas(Val(ta:1))~") ")
Sqladd("AND MA.Vehiculo = '"~dialogo.vehiculo1~"' ")
Watch(Sqlbatch())
Acn(xx:2, 0)
Acn(xx:1, 0)
recorrer sql
Acd(fv:1, Fbn('Fecha1'))
Acd(fd:1, dialogo.fecha1)
Acn(co:1, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 25, SI, Var('MONELOCA')))
Acn(it:1, Round(Fbn('IntTot') * Val(co:1), 2))
Acn(ip:1, Round(Fbn('Interes') * Val(co:1), 2))
Acn(iv:1, Round(Fbn('IVA') * Fbn('Precio1'), 2))
Acn(wt:1, Round(Fbn('WTH') * Fbn('Precio1'), 2))
Act(vh:1, Fbn('Vehiculo1'))
Act(vk:1, Fbn('Book1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, Fbn('TipoOp'))
Act(nr:1, Fbn('NrOperacion'))
Acn(re:1, (Val(ip:1) + Val(wt:1)) - Val(it:1))
Act(nr:2, '')
if (Val(xx:2) = 0)
if (Val(xx:1) = 0)
if (NoVacio(Query("Select NrUnicoAsiento from "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where M.Codigo = A.Modelo AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") AND A.Fecha1="~IdxDate2(Val(fd:1))~" and A.NrLote<>0")))
if (dialogo.radio1 = 1)
Messagebox('Tiene asientos enviados.')
else
Message('Tiene asientos enviados.')
endif
Acn(xx:2, 1)
else
if (NoVacio(Query("Select NrUnicoAsiento from "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where M.Codigo = A.Modelo AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") AND A.Fecha1="~IdxDate2(Val(fd:1))~" /*AND A.Book = '"~Val(vk:1)~"'*/ and (A.NrLote=0 OR A.NrLote = NULL)")))
if (dialogo.radio1 = 1)
if (Messagebox('Ya existen asientos de '~BuscarCampo('TIPOSASIENTO', 'Descripcion', 'Codigo', Val(ta:1))~' para esa fecha, desea eliminarlos?', 1, 2) = 6)
Message('Borrando Asientos Previos')
Sqladd("Delete "~Dbo()~".ASIENTOSCON1 Where NrUnicoAsiento IN ")
Sqladd("(Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~IdxDate2(Val(fd:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") /*AND A.Book = '"~Val(vk:1)~"'*/)")
Sqlnew()
Sqlexec()
Sqladd("Delete "~Dbo()~".ASIENTOSCON Where NrUnicoAsiento IN ")
Sqladd("(Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~IdxDate2(Val(fd:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") /*AND A.Book = '"~Val(vk:1)~"'*/)")
Sqlnew()
Sqlexec()
Message(Val(nr:1)~' - Modelo: '~Val(to:1))
Sqlgenerarasientoop(Val(to:1), Val(nr:1), '', '', Var('ASINUM'), Val(fv:1), Val(vh:1), null, Val(vk:1), null, null, null, Val(ti:1), null, Val(nr:2), null, null, null, null, FSys(), Val(fd:1))
Sqlexec()
else
Acn(xx:2, 1)
endif
else
Message('Borrando Asientos Previos')
Sqladd("Delete "~Dbo()~".ASIENTOSCON1 Where NrUnicoAsiento IN ")
Sqladd("(Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~IdxDate2(Val(fd:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") /*AND A.Book = '"~Val(vk:1)~"'*/)")
Sqlnew()
Sqlexec()
Sqladd("Delete "~Dbo()~".ASIENTOSCON Where NrUnicoAsiento IN ")
Sqladd("(Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~IdxDate2(Val(fd:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(ta:1))~") /*AND A.Book = '"~Val(vk:1)~"*/)")
Sqlnew()
Sqlexec()
Message(Val(nr:1)~' - Modelo: '~Val(to:1))
Sqlgenerarasientoop(Val(to:1), Val(nr:1), '', '', Var('ASINUM'), Val(fv:1), Val(vh:1), null, Val(vk:1), null, null, null, Val(ti:1), null, Val(nr:2), null, null, null, null, FSys(), Val(fd:1))
Sqlexec()
endif
else
Message(Val(nr:1)~' - Modelo: '~Val(to:1))
Sqlgenerarasientoop(Val(to:1), Val(nr:1), '', '', Var('ASINUM'), Val(fv:1), Val(vh:1), null, Val(vk:1), null, null, null, Val(ti:1), null, Val(nr:2), null, null, null, null, FSys(), Val(fd:1))
Sqlexec()
endif
Acn(xx:1, 1)
endif
else
Message(Val(nr:1)~' - Modelo: '~Val(to:1))
Sqlgenerarasientoop(Val(to:1), Val(nr:1), '', '', Var('ASINUM'), Val(fv:1), Val(vh:1), null, Val(vk:1), null, null, null, Val(ti:1), null, Val(nr:2), null, null, null, null, FSys(), Val(fd:1))
Sqlexec()
endif
endif


proximo
