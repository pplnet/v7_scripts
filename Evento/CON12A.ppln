Acd(fe:9, Query(" Select Max(Fecha2) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha2 < '"~IdxDate(dialogo.fecha1)~"' "))
Acn(id:1, Query(" Select Sum(Abs(Monto)) From "~Dbo()~".MOVDEVENGADOS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND TipoDevengado = 'INTLEN' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' AND Fecha > '"~IdxDate(Val(fe:9))~"' "))
Acn(rs:1, 0)
Acn(rs:3, 0)
Acn(rs:2, Val(id:1) * (Val(ct:1) - Val(ct:2)))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, dialogo.fecha1, Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
