If(Dialogo.Radio1 == 0)
    IF(Dialogo.Check1 == 1)
        EnviarMensaje("Este es un mensaje sin operación o transaccion con adjunto",0,Dialogo.String1)
    ELSE
        EnviarMensaje("Este es un mensaje sin operación o transaccion sin adjunto",0)
    ENDIF
ENDIF

If(Dialogo.Radio1 == 1)
    IF(Dialogo.Check1 == 1)
        EnviarMensajeOp("Este es un mensaje a operación con adjunto",Dialogo.String4,Dialogo.String2)
    ELSE
        EnviarMensajeOp("Este es un mensaje a operación sin adjunto",Dialogo.String4)
    ENDIF
ENDIF

If(Dialogo.Radio1 == 2)
    IF(Dialogo.Check1 == 1)
        EnviarMensajeTr("Este es un mensaje a transacción con adjunto",Dialogo.String5,Dialogo.String3)
    ELSE
        EnviarMensajeTr("Este es un mensaje a transacción sin adjunto",Dialogo.String5)
    ENDIF
