creardialogo
fecha1: 'D.Fecha';1;;;;;;;;FSys()
fecha2: 'H.Fecha';;;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
lista2: 'Tipos de Asientos';-3;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".TIPOSASIENTO ");
listatabla1: 'Operaciones';-2;1;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';5;1;;NO;NO;;;;4;
findialogo

if (not ok)
raise('Evento Cancelado')
endif

Act(vc:1, dialogo.vehiculo1)
Message('Anulacion de Asientos por Fecha')

Sqladd(" Select A.NrUnicoAsiento, MA.Codigo CodAsi, A.NrAsiento, A.Estado ")
Sqladd(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" Where MA.Codigo = A.Modelo ")
Sqladd(" AND A.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND A.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'REV' ) ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
if (NoVacio(dialogo.lista2))
Sqladd(" AND  MA.TipoAsiento IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND  A.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" Order By 2 ")

Watch(Sqlbatch())
recorrer sql
Message('Borrando Asientos Previos - Modelo '~Fbn('CodAsi'))
Sqladd(" Delete "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqladd(" Delete "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
if (Incluido(Fbn('Estado'), 'COT|NC|REV|'))
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = Null ")
Sqladd(" Where NrAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
endif
Sqlexec()
proximo
