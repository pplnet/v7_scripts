creardialogo
fecha1: 'D.Fecha';1;;;;;;;;FSys()
fecha2: 'H.Fecha';;;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
lista2: 'Tipos de Asientos';-3;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".TIPOSASIENTO ");
listatabla1: 'Operaciones';-2;1;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';5;1;;NO;NO;;;;4;
findialogo

if (not ok)
raise('Evento Cancelado')
endif

Act(vc:1, dialogo.vehiculo1)
Message('Anulacion de Asientos por Fecha')

sql.add(" Select A.NrUnicoAsiento, MA.Codigo CodAsi, A.NrAsiento, A.Estado ")
sql.add(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO MA ")
sql.add(" Where MA.Codigo = A.Modelo ")
sql.add(" AND A.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND A.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' ")
sql.add(" AND (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'REV' ) ")
sql.add(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
if (NoVacio(dialogo.lista2))
sql.add(" AND  MA.TipoAsiento IN ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.listatabla1))
sql.add(" AND  A.NrOperacion IN ("~pipe2comillas(dialogo.listatabla1)~") ")
endif
sql.add(" Order By 2 ")

Watch(sql.batch)
recorrer sql
Message('Borrando Asientos Previos - Modelo '~Fbn('CodAsi'))
sql.add(" Delete "~Dbo()~".ASIENTOSCON1 ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.add(" Delete "~Dbo()~".ASIENTOSCON ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
if (Incluido(Fbn('Estado'), 'COT|NC|REV|'))
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
sql.add(" Set NrAsiento = Null ")
sql.add(" Where NrAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
endif
sql.exec
proximo
