mostrarcuadrodemensajes
creardialogo
fecha1:'FechaValor';;;;;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;Habiles(FSys(), -0, 'ARG', SI)
fecha2:'FechaConf';;;;;;dialogo.fecha2 <> 0;'Debe Ingresar la Fecha de Confirmacion';NO;FSys()
cliente1:'Contraparte';;;;;;
cuenta1:'Cuenta';;;;;;(NoVacio(dialogo.cliente1) y NoVacio(dialogo.cuenta1) y Eqstr(BuscarCampo('CUENTAS', 'Cliente', 'Codigo', dialogo.cuenta1), dialogo.cliente1)) o (Vacio(dialogo.cliente1)) o (Vacio(dialogo.cuenta1));'La cuenta no pertenece al cliente';NO;
especie1:'Moneda';;;;;;;;;;
vehiculo1: 'Vehiculo';;;;;;NoVacio(dialogo.vehiculo1);'Ingrese un vehiculo';NO;Var('VEHICULODE');
mercado1:'Mercado';;;;;;NoVacio(dialogo.mercado1);'Debe ingresar un Mercado';NO;Var('MERNETEODE');;;;;" NETEA='SI' "
nrtrans1:'Voucher';;;;;;;;;;;
check1:'Batch';1;;;NO;NO;;;;0;
findialogo

if (not ok)
Cancelar()
endif

Acn(z1, 0)

Message('Generando datos de confirmacion')
sql.add(" SELECT DISTINCT T.Cuenta2, T.Cuenta1, T.NrTrans, T.Fecha1, T.Fecha2, T.Cliente1, T.Especie,           ")
sql.add(" T.Cantidad1, T.RB6, T.TipoTr2, T.Ley4 Rueda                                                           ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T INNER JOIN "~Dbo()~".OPERACIONESBITS B ON T.NrTrans = B.NrOperacion       ")
sql.add(" INNER JOIN "~Dbo()~".ESPECIES E ON T.Especie = E.Codigo     ")
sql.add(" INNER JOIN "~Dbo()~".MERCADOS M2 ON T.Mercado1 = M2.Codigo  ")
sql.add(" WHERE  E.Tipo    = 'MON'                           ")
sql.add(" AND    B.Valor   = '1'                             ")
sql.add(" AND    B.NrBit in (3,6,8)                          ")
sql.add(" AND    T.TipoTr2 in ('DEP','RET')                  ")
sql.add(" AND    T.Mercado1 = '"~dialogo.mercado1~"'         ")
sql.add(" AND   (T.RB6 IN (0, -1, 2) OR T.RB6 IS NULL) ")
sql.add(" AND   T.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"'    ")
sql.add(" AND ((M2.Netea='SI') OR (M2.Netea='NO' AND T.Ley4 IN ("~pipe2comillas(Var('RUECPC1'))~"))) ")
if (NoVacio(dialogo.cliente1))
sql.add("AND T.Cliente1 = '"~dialogo.cliente1~"'          ")
endif
if (NoVacio(dialogo.cuenta1))
sql.add("AND (T.Cuenta1 = '"~dialogo.cuenta1~"' or T.Cuenta2 = '"~dialogo.cuenta1~"')")
endif
if (NoVacio(dialogo.especie1))
sql.add("AND T.Especie = '"~dialogo.especie1~"'           ")
endif
if (NoVacio(dialogo.vehiculo1))
sql.add("AND T.Vehiculo1 = '"~dialogo.vehiculo1~"'        ")
endif
if (NoVacio(dialogo.nrtrans1))
sql.add("AND T.NrTrans = '"~dialogo.nrtrans1~"'          ")
endif

sql.add(" ORDER BY T.Cuenta2, T.Cuenta1                      ")
Watch(sql.batch())
recorrer sql
if (NoVacio(Fbn('Cuenta2')))
Act(a:fac, Fbn('Cuenta2'))
else
Act(a:fac, Fbn('Cuenta1'))
endif
Act(b:fac, Fbn('NrTrans'))
Acd(c:fac, Fbn('Fecha1'))
Acd(d:fac, Fbn('Fecha2'))
Act(e:fac, Fbn('Cliente1'))
Act(f:fac, Fbn('Especie'))
Acn(g:fac, Fbn('Cantidad1'))
Acn(u:fac, Fbn('RB6'))
Act(v:fac, Fbn('TipoTr2'))
Act(y:fac, Fbn()['Rueda'])
if (Fbn('RB6') = 1)
Act(t:fac, 'Confirmada')
else
if (Fbn('RB6') = 2)
Act(t:fac, 'Falla')
else
Act(t:fac, 'Pendiente')
endif
endif
Acn(w:fac, 0)
if (Eqstr(Fbn('TipoTr2'), 'RET'))
if (Incluido(Val(y:fac), Var('RUECPC1')))
Act(sg:fac, 'Pago')
else
Act(sg:fac, 'Cobro')
endif
else
if (Incluido(Val(y:fac), Var('RUECPC1')))
Act(sg:fac, 'Cobro')
else
Act(sg:fac, 'Pago')
endif
endif
if (dialogo.check1 = 1)
Acn(w:fac, 1)
endif
Scn(z1, 1)
proximo

if (dialogo.check1 = 0)
if (Val(z1) = 0)
Cancelar()('No se encontraron Movimientos para Confirmar')
endif

crearlistbox;'Arial,8,';'Movimientos a Confirmar'
'Procesa';w1..w:fac;SI;SI;;80;check;RGB(220, 220, 193)
'Accion';x1..x:fac;SI;(Val(w:flb) = 0 o Val(x:flb) = 0 o Val(x:flb) = 2) o (Val(x:flb) = 1 y Val(c:flb) < dialogo.fecha2);'No se pueden Fallar Vouchers del Dia';80;combo;'Confirma|Falla|Pendiente';RGB(220, 220, 193)
'Estado';t1..t:fac;NO;SI;;80;string;;RGB(180, 180, 193)
'';sg:1..sg:fac;NO;;;50;string;;RGB(180, 180, 193)
'Cuenta';a1..a:fac;NO;SI;;100;string;;RGB(180, 180, 193)
'Nr. Trans';b1..b:fac;NO;SI;;100;string;;RGB(180, 180, 193)
'F.Ingreso';c1..c:fac;NO;SI;;80;fecha;RGB(180, 180, 193)
'F.Cobro';d1..d:fac;NO;SI;;80;fecha;RGB(180, 180, 193)
'Cliente';e1..e:fac;NO;SI;;100;string;;RGB(180, 180, 193)
'Especie';f1..f:fac;NO;SI;;100;string;;RGB(180, 180, 193)
'Cantidad';g1..g:fac;NO;SI;;80;numero;'##,###,###.####';RGB(180, 180, 193)
finlistbox

if (not ok)
Cancelar()
endif
else
if (Val(z1) = 0)
Cancelar()
endif
endif

Message('Procesando datos')
recorrer&j 1, Fac()
if (Val(w:&j) = 1)
Message(Val(b:&j))
if (Val(x:&j) = 0)
sql.add("Select NrOperacion from "~Dbo()~".MOVEJECUTADOS ")
sql.add(" where NrTrans2     = '"~Val(b:&j)~"' ")
sql.add("   and NrOperacion <> '"~Val(b:&j)~"'")
sql.add("   and Cantidad     < 0 ")
sql.add(" order by NrOperacion ")

recorrer sql
Message('1-Actualiza '~Fbn()['NrOperacion'])
Dfa()
sql.add("UPDATE "~Dbo()~".OPERACIONES ")
sql.add("  SET RB10        = '1',  ")
sql.add("      FechaPrecan = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("Where NrOperacion = '"~Fbn()['NrOperacion']~"' ")
sql.add("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
sql.new
sql.exec

Message('2-Recalcula datos '~Fbn()['NrOperacion'])
modificaroperacion(Fbn()['NrOperacion'], 0, NO, NO, SI, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, 0)
Message('3-fin recalculo '~Fbn()['NrOperacion'])
proximo
Message('Actualizacion limites')
sql.add("Insert Into "~Dbo()~".MOVLIMITES ")
sql.add(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
sql.add("  Descripcion, Bits, Vehiculo ) ")
sql.add(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
sql.add("        M.FechaLim, (M.Monto*(-1)), M.NrOperacion,  ")
sql.add("        'Desafectacion Falla', M.Bits, M.Vehiculo ")
sql.add("   from "~Dbo()~".MOVLIMITES M ")
sql.add("Where NrOperacion = '"~Val(b:&j)~"' ")
sql.new

Message('Actualizacion falla')
sql.add(" DELETE FROM "~Dbo()~".MOVEJECUTADOS ")
sql.add(" WHERE NrOperacion = '"~Val(b:&j)~"' AND Transaccion = 'Falla' ")
sql.new

Message('Actualizacion instancias '~Val(b:&j))
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit=70 ")
sql.new
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit in (3,6,8) ")
sql.new
sql.add("UPDATE "~Dbo()~".TRANSACCIONES2 SET RB6 = 1, ")
sql.add("                               Fecha5 = '"~IdxDate(dialogo.fecha2)~"', ")
sql.add("                               FechaConfir = '"~IdxDate(FSys())~"' ")
sql.add(" WHERE NrTrans = '"~Val(b:&j)~"' ")
sql.new
sql.exec
else
if (Val(x:&j) = 1)
Message('Afectacion limites')
sql.add("Select NrOperacion from "~Dbo()~".MOVEJECUTADOS ")
sql.add(" where NrTrans2     = '"~Val(b:&j)~"' ")
sql.add("   and NrOperacion <> '"~Val(b:&j)~"'")
sql.add("   and Cantidad     < 0 ")
sql.add(" order by NrOperacion ")

recorrer sql
Dfa()
Message('Afectando limites '~Val(b:&j))
sql.add("Insert Into "~Dbo()~".MOVLIMITES ")
sql.add(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
sql.add("  Descripcion, Bits, Vehiculo ) ")
sql.add(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
sql.add("        '"~IdxDate(dialogo.fecha2)~"', M.Monto, '"~Val(b:&j)~"',  ")
sql.add("        'Afectacion Falla', M.Bits, M.Vehiculo ")
sql.add("   from "~Dbo()~".MOVLIMITES M ")
sql.add("Where NrOperacion = '"~Fbn()['NrOperacion']~"' ")
sql.add("  and FechaLim is not Null ")
sql.new
sql.exec
proximo

Message('Afectando movimientos de fallas '~Val(b:&j))
sql.add("INSERT INTO "~Dbo()~".MOVEJECUTADOS ")
sql.add("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
sql.add("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
sql.add("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
sql.add("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
sql.add("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
sql.add(") ")
sql.add("select ")
sql.add("NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
sql.add("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
sql.add("'"~'Falla AC'~Val(b:&j)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
sql.add("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys())~"', ")
sql.add("'"~UsuarioActivo()~"', Cuenta, 'Falla', -Cantidad, Cupon")
sql.add("from "~Dbo()~".MOVEJECUTADOS ")
sql.add("where NrOperacion = '"~Val(b:&j)~"' ")
sql.new

Message('Actualizacion instancias de fallas '~Val(b:&j))
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit=8 ")
sql.new
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit in (3,6) ")
sql.new
sql.add("UPDATE "~Dbo()~".TRANSACCIONES2 SET RB6      = 2, ")
sql.add("                               FechaTransp = '"~IdxDate(dialogo.fecha2)~"', ")
sql.add("                               FechaFalla  = '"~IdxDate(FSys())~"' ")
sql.add(" WHERE NrTrans = '"~Val(b:&j)~"' ")
sql.new
sql.exec
else
if (Val(u:&j) = 2)
Message('Re afectando limites '~Val(b:&j))
sql.add("Insert Into "~Dbo()~".MOVLIMITES ")
sql.add(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
sql.add("  Descripcion, Bits, Vehiculo ) ")
sql.add(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
sql.add("        M.FechaLim, (M.Monto*(-1)), M.NrOperacion,  ")
sql.add("        'Desafectacion Falla', M.Bits, M.Vehiculo ")
sql.add("   from "~Dbo()~".MOVLIMITES M ")
sql.add("Where NrOperacion = '"~Val(b:&j)~"' ")
sql.new

Message('Actualizando movimientos por fallas '~Val(b:&j))
sql.add(" DELETE FROM "~Dbo()~".MOVEJECUTADOS ")
sql.add(" WHERE NrOperacion = '"~Val(b:&j)~"' AND Transaccion = 'Falla' ")
sql.new

Message('Actualizando movimientos por fallas '~Val(b:&j))
if (Eqstr(Val(v:&j), 'DEP'))
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit=3 ")
else
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Val(b:&j)~"' and NrBit=6 ")
endif
sql.new
