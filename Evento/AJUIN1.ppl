*ModoReproceso(ConDialogo)
*--> AJUSTE POR INDICE EN OPERACIONES MM PASIVAS <--*

*--> LOS PRESTAMOS SINDICADOS Y FRN SERAN REESTRUCTURADOS
*--> QUEDARON: PRESTAMOS SINDICADOS = SOLO ITEMS
*-->           FRN = SOLO CABECERAS

CrearDialogo
   Fecha1 :'Fecha'   ;1;1; ;  ;  ;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys;'Fecha incorrecta';NO;FSys;
   Check1 :'Procesa' ;1;2; ;SI;SI;;;;1;
FinDialogo
If Not Ok
   Cancelar
EndIf

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

If Dialogo.Check1=0
  HojaVisible(SI)
endif

** Ya no se usa mas esta variable. El evento es para todos los incides
*ACT(ic:1, Var('INDICEDEFA'))

*--> Ultimo dia habil del mes anterior al ingresado en el dialogo
ACD(fm:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'), -1, 'ARG', SI))

ACT(vc:0, 'VC')
ACT(vm:0, 'VM')
ACT(vu:0, 'VU')
ACT(vv:0, 'VV')


SetFilaActual(1)
ACT(a:FAC, 'NrOp')
ACT(b:FAC, 'Tipo')
ACT(c:FAC, 'Esp')
ACT(d:FAC, 'Indice')
ACT(e:FAC, 'FOp')
ACT(f:FAC, 'FIni')
ACT(g:FAC, 'FFin')
ACT(h:FAC, 'Uni_Mul')
ACT(i:FAC, 'Cuota')

ACT(j:FAC, 'Caso 1')
ACT(k:FAC, 'Caso 2')

ACT(m:FAC, 'fc:1')
ACT(n:FAC, 'cp:1')
ACT(o:FAC, 'cp:10')
ACT(p:FAC, 'cp:3')

ACT(q:FAC, 'cx:1')
ACT(r:FAC, 'Cuota')

ACT(s:FAC, 'cp:1')
ACT(t:FAC, 'fc:1')
ACT(u:FAC, 'cp:1')
ACT(v:FAC, 'cp:10')
