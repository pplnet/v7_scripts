SQL.ADD(" Order by FFin, Tipo, NrOp ")

*--> (ic:1) = Variable INDICEDEFA
*--> (fm:1) = Primer día Hábil del mes
*--> (fc:1) = Fecha Vto de la cuota anterior
*--> (fa:1) = Dia habil anterior a la fecha vto. de la cuota
*--> (cx:1) = CER (anterior a la fecha vto. de la primera cuota)
*--> (cp:1) = CER (actual)
*--> (cp:2) = COEF
*--> (cp:3) = Cap. Ajust.
*--> (cp:4) = Ajust. Amort.
*--> (cp:5) = Amort. Ajust.
*--> (cp:6) = Cap. Luego Amort. (Proxima cuota)
*--> (pc:1) = Cuota anterior
watch(sql.batch)
Recorrer SQL
*MessageBox(FBN['NrOp'])
  ACT(a:FAC, fbn('NrOp'))
  ACT(b:FAC, fbn('Tipo'))
  ACT(c:FAC, fbn('Esp'))
  ACT(d:FAC, fbn('Indice'))
  ACD(e:FAC, fbn('FOp'))
  ACD(f:FAC, fbn('FIni'))
  ACD(g:FAC, fbn('FFin'))
  ACN(h:FAC, fbn('Uni_Mul'))
  ACN(i:FAC, fbn('Cuota'))

  ** Para que las formulas sigan usando la misma celda
  ACT(ic:1, fbn('Indice'))

  IF FBN['Uni_Mul'] = 1
     * --> Si la operación es U.V. <--*
     * --> Cálculo del coeficiente CER (En CP:1 guardo el coeficiente de calculo real, en CP:10 el Coefic de arrastre para mostrar en la operacion)    
     * SI ES PROCESO DEVENGADO TOMO INDICE PRIMERO DE MES Y ACTUALIZO LA OPERACION
* solo dejo las preguntas para poner en las columnas J,K,L el caso del viejo evento
     IF Dialogo.Fecha1 <> FBN['FFin'] Y Mes(FBN['FFin']) > Mes(FBN['FIni'])
       * La operacion No vence hoy    y tuvo cambio de mes
*/MessageBox(FBN['NrOp']~' 1')
ACT(aj:FAC, 'Caso 1')
*       ACD(FC:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'),-1  , 'ARG', SI))        
*       ACN(cp:1 , COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))
*       ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))         
     EndIF
     * SI el Vto de la cuota es PRIMERO DE MES Y la ultima cuota cayo en el mes anterior tomo indice de la ultima cuota 
     IF Dialogo.Fecha1 = FBN['FFin'] Y Dialogo.Fecha1 = PriDeMes(Dialogo.Fecha1, NO, 'ARG')    
       * La operacion vence hoy      y es primer dia de mes
*/MessageBox(FBN['NrOp']~' 2')
ACT(ak:FAC, 'Caso 2')
*       ACD(FC:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'),-1  , 'ARG', SI))          
*       ACN(cp:1 , COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))
*       ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))   
    * SI ES PROCESO DIARIO EL INDICE LO CALCULO DESDE FECHA VTO HASTA FECHA PRIMERO DE MES (ACTUALIZADO POR EL DEVENGADO)
     Else
       If Dialogo.Fecha1 = FBN['FFin']
       * La operacion vence hoy
*/MessageBox(FBN['NrOp']~' 3')
ACT(al:FAC, 'Caso 3')
*         ACD(FC:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'),-1  , 'ARG', SI)) 
*         ACN(cp:1 , COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,Val(FC:1),1))
*         ACN(cp:10, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1)) 
       EndIF 
     EndIf

************************************************
*** Este es el nuevo criterio para ajuste diario
************************************************
     ACD(FC:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))        
     IF Dialogo.Fecha1 <> FBN['FFin']
       * La operacion No vence hoy
ACT(j:FAC, 'Caso 1')
       ACN(cp:1 , COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))
       ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))         
     EndIF
     If Dialogo.Fecha1 = FBN['FFin']
       * La operacion vence hoy
ACT(k:FAC, 'Caso 2')
       ACN(cp:1 , COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,Val(FC:1),1))
       ACN(cp:10, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1)) 
     EndIf

     *--> Calcula Cap. Orig. y Cap. Amort.  
     ACN(cp:3, FBN['CapOr'] * Val(cp:1) )
  
     ACD(m:FAC, Val(fc:1))
     ACN(n:FAC, Val(cp:1))
     ACN(o:FAC, Val(cp:10))
     ACN(p:FAC, Val(cp:3))

     *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig y Cap.Amort <--*
     (.'AJUINDUV'.)


****++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++*****
  Else
     *--> Si la operación es M.V. <--*
     ACN(cx:1, COTIZACION(Val(ic:1),,,,FBN['FOp']-1,1) )
     ACN(q:FAC, Val(cx:1))
     IF FBN['Cuota'] > 1
       ACT(r:FAC, 'Otra')
       *--> Si la Cuota no es la primera <--*      
       ACN(ct:1, FBN['Cuota'] - 1 ) 
       ACN(pc:1, FBN['Cuota'] - 1 )
       *--> Busca la FechaVto de la Cuota anterior <--* CALCULO COEFICIENTES PARA SER UTILIZADOS EN EL PROCESO
       ACD(fc:1, SQL(" Select Fecha2 From "~DBO~".CUOTAS where NrOperacion = '"~FBN['NrOp']~"' and NrCuota = "~Val(ct:1)~" ") )
       ACD(zz:1, Habiles(Dialogo.Fecha1, -1 , 'ARG', SI) )
       ACN(XX:1, COTIZACION(Val(ic:1),,,,Val(zz:1),1) )
       ACN(cp:1, Val(XX:1) )  
       ACN(yy:1, COTIZACION(Val(ic:1),,,,Val(fc:1)-1,1) )
       ACN(FO:1, COTIZACION(Val(ic:1),,,,FBN['FOp']-1,1))   
       * WW:1 = Fecha Devengado anterior
*       ACD(WW:1, Habiles(PriDeMes(Dialogo.Fecha1-1, SI, 'ARG'),-1  , 'ARG', SI))
       ACD(WW:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))
       ACN(yy:2, COTIZACION(Val(ic:1),,,,Val(WW:1),1) ) 

       *-->  Calculo de Indices segun posicion de la ultima cuota.
       *     Si el mes del la ultima cuota es igual al mes de devengamiento ==> Denominador = Indice Ult Cta (YY1)  
       *     Si son distintos ==> el denominador el indice del devengamiento anterior (YY2)            
       IF Mes(Val(fc:1)) = Mes(Val(zz:1))
         ACN(cp:2,  Val(xx:1) / Val(yy:1)  )            
       Else
         ACN(cp:2,  Val(xx:1) / Val(yy:2)  )          
       EndIf    
*MessageBox(Val(xx:1))
*MessageBox(Val(yy:1))
       ACN(cp:3, FBN['CapOr'] *  Val(cp:2)   )
       ACN(cp:4, FBN['CAmort'] * ((Val(cp:1) / Val(cx:1)) -1) )    
       ACN(cp:5, FBN['CAmort'] + Val(cp:4) )       
       ACN(cp:6, Val(cp:3) - Val(cp:5) ) 
    
       *--> Indice CER para grabar en la operacion
       ACN(cp:10, Val(xx:1) / Val(FO:1) )         

       ACD(t:FAC, Val(fc:1))
       ACN(u:FAC, Val(cp:1))
       ACN(w:FAC, Val(cp:2))
       ACN(x:FAC, Val(cp:3))
       ACN(y:FAC, Val(cp:4))
       ACN(z:FAC, Val(cp:5))
       ACN(aa:FAC, Val(cp:6))
       ACN(v:FAC, Val(cp:10))

       *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig, Cap.Amort y prox. cuota <--*
       (.'AJUINDMV'.)

     ELSE
       ACT(r:FAC, 'Primera')
       *--> Si es la primera cuota <--*
       ACN(cp:1, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / Val(cx:1) )
       ACN(s:FAC, Val(cp:1))
IF NO
       *--> Calculo de Coeficiente para el proceso de Ajuste Devengado (fin de mes)
       IF Dialogo.Fecha1 <> FBN['FFin']
         * La cuota no vence hoy
         ACD(FC:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'),-1  , 'ARG', SI))        
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / Val(cx:1) ) 
         *--> Indice CER para grabar en la operacion   
         ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))             
       EndIf
       *--> Calculo de Coeficiente para el proceso Diario
       IF Dialogo.Fecha1 = FBN['FFin'] Y Mes(FBN['FFin']) > Mes(FBN['FIni'])       
         * La cuota vence hoy          y tuvo cambio de mes
         ACD(FC:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'),-1  , 'ARG', SI))             
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,Val(FC:1),1))
         *--> Indice CER para grabar en la operacion  
         ACN(cp:10, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))   
       EndIF 
ELSE
       *--> Calculo de Coeficiente para el proceso de Ajuste Devengado (fin de mes)
       IF Dialogo.Fecha1 <> FBN['FFin']
         * La cuota no vence hoy
         ACD(FC:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))   
*MessageBox(Fstr(COTIZACION(Val(ic:1),,,,Val(FC:1),1),0,6))
*MessageBox(Val(cx:1))     
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / Val(cx:1) ) 
         *--> Indice CER para grabar en la operacion   
         ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))             
       EndIf
       *--> Calculo de Coeficiente para el proceso Diario
       IF Dialogo.Fecha1 = FBN['FFin']
         * La cuota vence hoy
         ACD(FC:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))        
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,Val(FC:1),1))
         *--> Indice CER para grabar en la operacion  
         ACN(cp:10, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))   
       EndIF 
ENDIF
*MessageBox(Val(CP:1))
       ACN(cp:2, Val(cp:1) - 1 )
       ACN(cp:3, FBN['CapOr'] * (Val(cp:2) + 1) )

       ACN(cp:4, FBN['CAmort'] * Val(cp:2) )
       ACN(cp:5, FBN['CAmort'] + Val(cp:4) )
       ACN(cp:6, Val(cp:3) - Val(cp:5) )

       ACD(t:FAC, Val(fc:1))
       ACN(u:FAC, Val(cp:1))
       ACN(v:FAC, Val(cp:10))
       ACN(w:FAC, Val(cp:2))
       ACN(x:FAC, Val(cp:3))
       ACN(y:FAC, Val(cp:4))
       ACN(z:FAC, Val(cp:5))
       ACN(aa:FAC, Val(cp:6))

       *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig, Cap.Amort y prox. cuota <--*
       (.'AJUINDMV'.)

     ENDIF
  ENDIF
********+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++   

  ACN(um:1, FBN['Uni_Mul'] -1)
  ACN(az:FAC, Val(um:1))
  
  *--> Busca las comisiones vigentes para la cuota que esta siendo ajustada
*  (*.*'COMICER'.)
  (.'COMIIND'.)

*messageBox('Op. '~fbn('NrOp')~' chequeando Procesa')
  if Dialogo.Check1=1
     *--> Actualizo la operacion con los Campos (y a los q influyen estos) q sean alterados x el Cap.Orig y Cap.Amort  
*messageBox('Op. '~fbn('NrOp')~' x llamar Fn AJUINDUPD')
*     (*.*'AJUCERUPD'.)
     (.'AJUINDUPD'.)

*messageBox('Op. '~fbn('NrOp')~' x llamar Ev TTNOP')
     EjecutarEvento('TTNOP', NrOperacion1 = FBN['NrOp'], Entero1 = Val(um:1), NrOperacion2 = '', Lista1 = '')

     *messageBox('Op. '~fbn('NrOp')~' x hacer update')
     SQL.ActualizarMovimientos3(FBN['NrOp'], SI, NO, NO, NO, SI, 0)
     Sql.Exec
  else
*messageBox('Op. '~fbn('NrOp')~' NO Procesa')
  endif
Proximo

if FAC>1
  SetFont(a:2..az:FAC,1)
  FormatoCeldas(n:2..o:FAC, Exe('F8'))
  FormatoCeldas(p:2..p:FAC, Exe('F2'))
  FormatoCeldas(q:2..q:FAC, Exe('F8'))
  FormatoCeldas(u:2..w:FAC, Exe('F8'))
  FormatoCeldas(x:2..aa:FAC, Exe('F2'))
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del recorrer')
SetFont(a:FAC,2)
