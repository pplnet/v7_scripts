Act(s:32, 'FechaVto')

Act(s:38, 'Estado')
Act(s:39, 'Op Generada')
Act(s:40, 'A Compliance')

sql.add("Select * from "~Dbo()~".OPERACIONES ")
sql.add(" where NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Act(b:1, Fbn()['NrOperacion'])
Act(b:2, Fbn()['CodSisExterno'])
Acn(b:3, Fbn()['IDSisExterno'])
Act(b:4, Fbn()['NrExterno'])
Act(b:5, Fbn()['TipoOp'])
Act(b:6, Fbn()['Especie'])
Act(b:7, Fbn()['Cliente1'])
Act(b:8, Fbn()['ContraEspecie'])
Acn(b:9, 0)
Acn(b:10, 0)

sql.add("Select * from "~Dbo()~".OPEXTERNAS ")
sql.add("  where CodSisExterno = Upper('"~Val(b:2)~"')  ")
sql.add("    and IDSisExterno = "~FStr(Val(b:3), 1, 0)~"  ")
recorrer sql
Scn(b:9, 1)
borrarceldas(t:1..t:53)
Act(t:38, Fbn('Estado'))
Act(t:39, Fbn('NrOperacion'))
Act(t:40, 'NO')
Acn(t:1, Fbn('IDSisExterno'))
Act(t:2, Fbn('CodSisExterno'))
Act(t:3, Fbn('NrExterno'))
Act(t:4, Fbn('TipoOp'))
if (Eqstr(Fbn('TipoOp'), 'TC'))
Act(t:5, 'TIC')
endif
if (Eqstr(Fbn('TipoOp'), 'TV'))
Act(t:5, 'TIV')
endif

Act(t:6, Fbn('TipoEspecie'))
Act(t:7, Fbn('Especie'))
if (Eqstr(Val(t:6), 'ISIN'))
Act(t:8, BuscarCampo('ESPECIES', 'Codigo', 'ISIN', Val(t:7)))
endif
if (Eqstr(Val(t:6), 'BBG'))
Act(t:8, BuscarCampo('ESPECIES', 'Codigo', 'Codigo2', Val(t:7)))
endif
if (Vacio(Val(t:8)))
Act(t:9, 'Error')
Act(t:40, 'SI')
else
Act(t:9, 'OK')
Act(t:10, BuscarCampo('ESPECIES', 'EstadoOperativo', 'Codigo', Val(t:8)))
if (Vacio(Val(t:10)))
Act(t:10, 'NE')
endif
endif

Act(t:11, Fbn('TipoCliente'))
Act(t:12, Fbn('Cliente'))
if (Eqstr(Val(t:11), 'COPER'))
Act(t:13, BuscarCampo('CLIENTESDOCUMENTACION', 'Codigo', 'NrCOPERS', Val(t:12)))
endif
if (Vacio(Val(t:13)))
Act(t:14, 'Error')
Act(t:40, 'SI')
else
Act(t:14, 'OK')
endif

Acn(t:15, Fbn('Cantidad'))
Acn(t:16, Fbn('Precio'))

Act(t:17, Fbn('TipoContraEspecie'))
Act(t:18, Fbn('ContraEspecie'))
if (Eqstr(Val(t:17), 'ISO'))
Act(t:19, BuscarCampo('ESPECIES', 'Codigo', 'ISO', Val(t:18)))
endif
if (Vacio(Val(t:19)))
Act(t:20, 'Error')
Act(t:40, 'SI')
else
Act(t:20, 'OK')
endif

Acd(t:21, Fbn('FechaOp'))
Acd(t:22, Fbn('FechaOp'))

Acn(t:23, Fbn('Plazo'))
Acn(t:24, Num(Fbn('Plazo')) * 24)
Act(t:25, FStr(Fbn('Plazo'), 1, 0))

Act(t:26, Fbn('Operador'))
Act(t:27, BuscarCampo('USUARIOS', 'Codigo', 'Codigo', Fbn('Operador')))

Act(t:28, Fbn('Book'))
Act(t:29, BuscarCampo('BOOKS', 'Codigo', 'Codigo', Fbn('Book')))

Act(t:30, Var('VEHICULODE'))
proximo
if (Val(b:9) <> 1)
Acn(b:10, 1)
Act(b:11, 'Error ID - Sin Accion')
endif
if (Val(b:10) = 0)
Acn(b:12, sql("Select Count(*) from "~Dbo()~".EXCEPCIONES where NrOperacion = '"~Val(b:1)~"' and Tipo in ('ERRORSISEX') "))
if (Val(b:12) > 0)
Act(t:40, 'SI')
endif
if (dialogo.check1 = 1)
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set Especie       = '"~Val(t:8)~"',")
sql.add("       Cliente1      = '"~Val(t:13)~"', ")
sql.add("       ContraEspecie = '"~Val(t:19)~"' ")
sql.add(" where NrOperacion   = '"~Val(b:1)~"' ")
sql.new
sql.add("Delete "~Dbo()~".EXCEPCIONES ")
sql.add(" where NrOperacion = '"~Val(b:1)~"' ")
sql.add("   and Tipo        Not in ('ERRORSISEX') ")
sql.new
sql.exec
endif

if (Eqstr(Val(t:40), 'SI'))
Act(b:11, 'Update y Queda')
Message('Modificar Operacion '~Val(b:1)~' - Sin Movimientos')
if (dialogo.check1 = 1)
modificaroperacion(Val(b:1), 0, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, SI, NO, NO, NO, SI, NO, SI, NO, 0, NO, NO)
endif
Message('Operacion '~Val(b:1)~' Ok. Queda a Instancia 9')
if (dialogo.check1 = 1)
ejecutarevento('CBOINS', string1 = Val(b:1), radio1 = 0, radio2 = 0, entero1 = 1, entero2 = 9)
endif
if (Eqstr(Val(t:9), 'Error'))
Act(e:1, 'Error Especie. El codigo '~Val(t:6)~' '~Val(t:7)~' no existe en FPA.')
Scn(t:48, 1)
Act(f:Val(t:48), Val(e:1))
if (dialogo.check1 = 1)
sql.add(" Insert into "~Dbo()~".EXCEPCIONES ")
sql.add(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
sql.add(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSys())~"' , '"~Val(e:1)~"' ) ")
sql.new
endif
endif
if (Eqstr(Val(t:14), 'Error'))
Act(e:1, 'Error Cliente. El codigo '~Val(t:11)~' '~Val(t:12)~' no existe en FPA.')
Scn(t:48, 1)
Act(f:Val(t:48), Val(e:1))
if (dialogo.check1 = 1)
sql.add(" Insert into "~Dbo()~".EXCEPCIONES ")
sql.add(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
sql.add(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSys())~"' , '"~Val(e:1)~"' ) ")
sql.new
endif
endif
if (Eqstr(Val(t:20), 'Error'))
Act(e:1, 'Error Contraespecie. El codigo '~Val(t:17)~' '~Val(t:18)~' no existe en FPA.')
Scn(t:48, 1)
Act(f:Val(t:48), Val(e:1))
if (dialogo.check1 = 1)
sql.add(" Insert into "~Dbo()~".EXCEPCIONES ")
sql.add(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
sql.add(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSys())~"' , '"~Val(e:1)~"' ) ")
sql.new
endif
endif
if (dialogo.check1 = 1)
sql.exec
endif
Messagebox('Operacion '~Val(b:1)~' No cumple alguna condicion y queda en Compliance.  Verifique Excepciones')
else
Act(b:11, 'Update y pasa')
Message('Modificar Operacion '~Val(b:1))
if (dialogo.check1 = 1)
modificaroperacion(Val(b:1), 0, SI, SI, SI, NO, SI, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, SI, NO, NO, NO, SI, NO, SI, NO, 0, NO, NO)
if (ok)
sql.add("Update "~Dbo()~".OPERACIONES Set Direccion = 0 where NrOperacion = '"~Val(b:1)~"' ")
sql.new
sql.exec
endif
endif
endif
endif
proximo


if (dialogo.check1 = 0 y Fac() > 0)
FormatoCeldas(b:3..b:3, exe('F0'))
