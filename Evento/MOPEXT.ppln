check1: 'Procesa';;;1;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif


Act(w:2, Var('CONTROLAPM'))
Acn(w:3, Var('PLAMAXSESS'))

Act(a:1, 'Nr Operacion')
