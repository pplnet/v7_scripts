Sqladd(" Select Max(S.Fecha) as Fecha,Max(S.Cupon) as Cupon,S.EnteCustodia,S.Cliente, ES.Cotiza,S.Especie,S.Mercado,S.Cuenta, ")
Sqladd("        S.NrSaldo,ES.InteresesC,E.Codigo as Estado,C.Estado as CtaEstado  ")
Sqladd(" From "~Dbo()~".SALDOSDIA S (NOLOCK) INNER JOIN  "~Dbo()~".CLIENTES AS CL (NOLOCK) ")
Sqladd("           ON S.Cliente = CL.Codigo ")
Sqladd("       INNER JOIN  "~Dbo()~".ESPECIES ES (NOLOCK) ")
Sqladd("           ON S.Especie=ES.Codigo ")
Sqladd("       INNER JOIN  "~Dbo()~".CUENTAS C (NOLOCK) ")
Sqladd("             ON C.Codigo=S.Cuenta ")
Sqladd("       INNER JOIN "~Dbo()~".ESTADOSCUSTODIA E (NOLOCK) ")
Sqladd("             ON ( (S.NrSaldo=E.NrSaldo and S.NrSaldo=101) or (S.NrSaldo=E.NrSaldo+100 and S.NrSaldo>201)) ")
Sqladd("Where (S.NrSaldo>201 or S.NrSaldo=101) and                                    ")
Sqladd("      S.NrSaldo not in ("~Pipe2Comillas(Val(x:1))~") AND                   ")
Sqladd("      S.EnteCustodia='"~dialogo.vehiculo1~"' and                              ")
Sqladd("     (C.Estado = 'HAB' or                                                       ")
Sqladd("     (C.Estado = 'CER' and C.Alias1 = '"~IdxDate(dialogo.fecha2)~"')) and         ")
Sqladd("     C.Comitente = '"~dialogo.vehiculo1~"' and ")
Sqladd("     C.Cliente <> '"~dialogo.vehiculo1~"' and ")

Sqladd("  (ES.Valor8 =0 or ES.Valor8 is null)   and                                   ")
Sqladd("     S.Fecha <= '"~IdxDate(dialogo.fecha2)~"' and                             ")
if (NoVacio(dialogo.cliente1))
Sqladd(" S.Cliente='"~dialogo.cliente1~"' and                                      ")
endif
if (dialogo.radio3 = 0)
Sqladd("      (CL.Valor10<>1 OR CL.Valor10 Is Null) And ")
endif
if (dialogo.radio3 = 1)
Sqladd("      CL.Valor10=1 and ")
endif
if (NoVacio(dialogo.cliente2) y NoVacio(dialogo.cliente3))
Sqladd(" S.Cliente Between '"~dialogo.cliente2~"' and '"~dialogo.cliente3~"' ")
endif
Sqladd(" GROUP BY S.EnteCustodia, S.Cliente, ES.Cotiza,     S.Especie, S.Mercado, S.Cuenta,     S.NrSaldo, ES.InteresesC, E.Codigo, C.Estado ")
Sqladd(" ORDER BY S.EnteCustodia, S.Cliente, C.Estado DESC, S.Especie, S.Mercado, E.Codigo DESC ")

