sql.add(" Select Max(S.Fecha) as Fecha,Max(S.Cupon) as Cupon,S.EnteCustodia,S.Cliente, ES.Cotiza,S.Especie,S.Mercado,S.Cuenta, ")
sql.add("        S.NrSaldo,ES.InteresesC,E.Codigo as Estado,C.Estado as CtaEstado  ")
sql.add(" From "~Dbo()~".SALDOSDIA S (NOLOCK) INNER JOIN  "~Dbo()~".CLIENTES AS CL (NOLOCK) ")
sql.add("           ON S.Cliente = CL.Codigo ")
sql.add("       INNER JOIN  "~Dbo()~".ESPECIES ES (NOLOCK) ")
sql.add("           ON S.Especie=ES.Codigo ")
sql.add("       INNER JOIN  "~Dbo()~".CUENTAS C (NOLOCK) ")
sql.add("             ON C.Codigo=S.Cuenta ")
sql.add("       INNER JOIN "~Dbo()~".ESTADOSCUSTODIA E (NOLOCK) ")
sql.add("             ON ( (S.NrSaldo=E.NrSaldo and S.NrSaldo=101) or (S.NrSaldo=E.NrSaldo+100 and S.NrSaldo>201)) ")
sql.add("Where (S.NrSaldo>201 or S.NrSaldo=101) and                                    ")
sql.add("      S.NrSaldo not in ("~pipe2comillas(Val(x:1))~") AND                   ")
sql.add("      S.EnteCustodia='"~dialogo.vehiculo1~"' and                              ")
sql.add("     (C.Estado = 'HAB' or                                                       ")
sql.add("     (C.Estado = 'CER' and C.Alias1 = '"~IdxDate(dialogo.fecha2)~"')) and         ")
sql.add("     C.Comitente = '"~dialogo.vehiculo1~"' and ")
sql.add("     C.Cliente <> '"~dialogo.vehiculo1~"' and ")

sql.add("  (ES.Valor8 =0 or ES.Valor8 is null)   and                                   ")
sql.add("     S.Fecha <= '"~IdxDate(dialogo.fecha2)~"' and                             ")
if (NoVacio(dialogo.cliente1))
sql.add(" S.Cliente='"~dialogo.cliente1~"' and                                      ")
endif
if (dialogo.radio3 = 0)
sql.add("      (CL.Valor10<>1 OR CL.Valor10 Is Null) And ")
endif
if (dialogo.radio3 = 1)
sql.add("      CL.Valor10=1 and ")
endif
if (NoVacio(dialogo.cliente2) y NoVacio(dialogo.cliente3))
sql.add(" S.Cliente Between '"~dialogo.cliente2~"' and '"~dialogo.cliente3~"' ")
endif
sql.add(" GROUP BY S.EnteCustodia, S.Cliente, ES.Cotiza,     S.Especie, S.Mercado, S.Cuenta,     S.NrSaldo, ES.InteresesC, E.Codigo, C.Estado ")
sql.add(" ORDER BY S.EnteCustodia, S.Cliente, C.Estado DESC, S.Especie, S.Mercado, E.Codigo DESC ")

