*hojavisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "Fecha"    ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo
if Not Ok
  Cancelar
endif

Message('Calcula el Precio Sucio')
SQL.ADD("Select * from "~DBO~".COTIZACIONES             ")
SQL.ADD("where  Fecha = '"~IdxDate(Dialogo.Fecha1)~"'   ")
SQL.ADD("or     PrecioCartera is NULL                   ")
SQL.ADD("or     PrecioCartera = 0                       ")

SQL.ADD("order by Codigo")

Recorrer SQL
   Message(fbn['Codigo']~'  '~FBN['CallPut'])

   *** calcula precio sucio ***
   act(ca:fac,fbn['Codigo'])
   acd(ck:fac,fbn['Fecha'])

   (."SUCIO".)

   acn(b:fac,fbn['Precio1'])
   acn(c:fac,val(ci:fac)*(val(b:fac)+val(cj:fac))) 


   ACN(aa1,FBN['PrecioEj'])
   ACT(aa2,FBN['CallPut'])
   ACD(aa3,FBN['FechaEj'])

   if Incluido(FBN['CallPut'],'CAL|PUT' )
      SQL.ADD("Update "~DBO~".COTIZACIONES ")
      SQL.ADD("Set  PrecioCartera = "~Fstr(val(c:fac),1,10)~" ")
      SQL.ADD("where Fecha = '"~IdxDate(Val(ck:fac))~"' and Codigo = '"~fbn['Codigo']~"' ")
      SQL.ADD("and   CallPut = '"~Val(aa2)~"'  and PrecioEj = "~Val(aa1)~" ")
      SQL.ADD("and   FechaEj = '"~IdxDate(Val(aa3))~"' ")
      SQL.NEW
      SQL.EXEC
   else
      SQL.ADD("Update "~DBO~".COTIZACIONES ")
      SQL.ADD("Set  PrecioCartera = "~Fstr(val(c:fac),1,10)~" ")
      SQL.ADD("where Fecha = '"~IdxDate(Val(ck:fac))~"' and Codigo = '"~fbn['Codigo']~"' ")
      SQL.ADD("and    (CallPut is NULL or CallPut = 'CON' ) and PrecioEj is NULL  ")
      SQL.ADD("and   FechaEj is NULL  ")
      SQL.NEW
      SQL.EXEC
   endif
Proximo