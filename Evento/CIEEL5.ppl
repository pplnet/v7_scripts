HojaVisible(SI)
MostrarcuadrodeMensajes
CrearDialogo
  Fecha1: 'Fecha'        ;;;;SI;;Dialogo.Fecha1<=FSYS;'Fecha Inválida';;Fsys;
  Check1: 'Controles'    ;;;;SI;SI;;;;1;
  Check2: 'Reporte'      ;;;;NO;NO;;;;0;
  Check3: 'Regenera Pos' ;;;;NO;NO;;;;1
FinDialogo

if Not Ok
   Cancelar
endif

Message('Calculo diario Interes ICL 1')
EjecutarEvento('ICLDEV', Fecha1=Dialogo.Fecha1,Fecha2=Habiles(Dialogo.Fecha1,1,'ARG',SI)-1,Fecha3=Habiles(Dialogo.Fecha1,1,'USA',SI)-1,Vehiculo1=Var('VEHICULODE') )
Message('Termino ICL1')

Message('CONT0')
EjecutarEvento('CONT0A',Fecha1=Dialogo.Fecha1,Vehiculo1=Var('VEHICON'),Radio1=4,Radio2=Var('RETIDIARIO'),Check1=1)
Message('Termino CONT0')

Message('Calculo diario Interes ICL 2')
EjecutarEvento('ICLDEV', Fecha1=Dialogo.Fecha1,Fecha2=Habiles(Dialogo.Fecha1,1,'ARG',SI)-1,Fecha3=Habiles(Dialogo.Fecha1,1,'USA',SI)-1,Vehiculo1=Var('VEHICULODE') )
Message('Termino ICL2')