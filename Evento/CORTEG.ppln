'Total';h1..h:fac;NO;;;80;numero;'###,###,###.##';RGB(220, 220, 193)
'De Cuenta';i1..i:fac;NO;;;100;string;;RGB(220, 220, 193)
'A Cuenta';j1..j:fac;NO;;;100;string;;RGB(220, 220, 193)
finlistbox

