creardialogo
especie3:'Especie';1;1;;;;NoVacio(dialogo.especie3) y DesciendeDeEspecie(dialogo.especie3, 'TITULO');'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
especie1:'Cupon';;;;;;;;;;BuscarCampo('ESPECIES', 'Alias3', 'Codigo', dialogo.especie3);;;;"Status = 'HAB' "
entero1:'Nr.Cupon';;;;;;dialogo.entero1 > 0 o dialogo.check1 = 1;'Debe Ingresar el Numero de Cupon';NO;0;Num(BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1))
fecha1:'F.Pago/Cobro';;;;;;;;;;iif (dialogo.check1 = 0, sql(" SELECT FechaPago FROM "~Dbo()~".AGENDACUPONES WHERE Especie = '"~dialogo.especie3~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' "), FechaMaduracion(dialogo.especie3))
vehiculo1: 'Vehiculo';1;2;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"), SQLSet("Select U.Vehiculo from "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V where U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
check1:'ZeroCoupon';1;1;;NO;NO;;;;;iif (Eqstr('SI', BuscarCampo('ESPECIES', 'ZeroCoupon', 'Codigo', dialogo.especie3)), 1, 0)
findialogo


mostrarcuadrodemensajes

if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.vehiculo1))
let(&vehiculos, dialogo.vehiculo1~'|')
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
let(&vehiculos, SQLSet("Select Vehiculo From"~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))
else
let(&vehiculos, SQLSet("Select Codigo From "~Dbo()~".VEHICULOS "))
endif
endif

Acn(x:1, 0)

sql.add(" SELECT Fecha1, Cliente1, Especie, Cupon1, Cantidad1, Especie1, Cantidad2, ")
sql.add(" Cuenta6, Cuenta2, NrTrans, TipoTr2 ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 ")
sql.add(" WHERE  TipoTr2 IN ('PCUPON', 'CCUPON') ")
sql.add(" AND    Especie   = '"~dialogo.especie1~"'")
sql.add(" AND    Cupon1    = '"~FStr(dialogo.entero1, 1, 0)~"'")
sql.add(" AND    Vehiculo1 IN ("~pipe2comillas(&vehiculos)~") ")
sql.add(" ORDER BY Cliente1, TipoTr2 ")

recorrer sql
if (Eqstr(Fbn('TipoTr2'), 'PCUPON'))
Act(a:fac, 'Pago de Cupon')
else
Act(a:fac, 'Cobro de Cupon')
endif
Acd(b:fac, Fbn('Fecha1'))
Act(c:fac, Fbn('Cliente1'))
Act(d:fac, Fbn('Especie'))
Act(e:fac, Fbn('Cupon1'))
Acn(f:fac, Fbn('Cantidad1'))
Act(g:fac, Fbn('Especie1'))
Acn(h:fac, Fbn('Cantidad2'))
Act(i:fac, Fbn('Cuenta6'))
Act(j:fac, Fbn('Cuenta2'))
Act(l:fac, Fbn('NrTrans'))
Acn(x:1, 1)
proximo

if (Val(x:1) <> 1)
Cancelar()('No hay transacciones de Pago o Cobro para la Especie y Cupon solicitados')
endif

