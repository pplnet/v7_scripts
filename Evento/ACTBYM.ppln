Sqladd("Select O.NrOperacion,NrBit from "~Dbo()~".OPERACIONES  O, "~Dbo()~".OPERACIONESBITS  OB ")
Sqladd(" WHERE O.NrOperacion=OB.NrOperacion and Valor=1 ")
Sqladd("  and FechaOp = '"~IdxDate(dialogo.fecha1)~"' and Mercado4 ='BYMA' ")
Sqladd("  and O.Nroperacion not in ('T0023842','T0023857') ")
Sqladd(" and ((Book1 = '' or Book1 is Null) or (Cuenta1 = '' or Cuenta1 is Null) or (Cuenta4 = '' or Cuenta4 is Null))")
recorrer sql
