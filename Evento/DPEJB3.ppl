* DPEJBS: Ejercicio de Barrier Option Simple
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Fecha1       : "F Real Ej."               ;;;;NO;;;;;Fsys
  Precio2      : "Precio_Ref"               ;;;;;;Dialogo.Precio2<>0;'Precio de Referencia Incorrecto';NO;
  Fecha2       : "Liquidacion Final"        ;;;;;;ESHABIL(Dialogo.Fecha2,'ARG');'La Fecha de Liquidacion Final NO ES HABIL en Argentina';;;HABILES(Dialogo.Fecha1,5,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1),SI)
  Radio1       : "Opcion|Europea|Americana" ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Precio4      : 'Knock'                    ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoCambio2','NrOperacion',Dialogo.NrOperacion1) 
  Especie1     : "Commodity"                ;1;2;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Ej"                 ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Ej"                ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Call|Put"            ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : "    |Compra|Venta"        ;;;;NO;;;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
  Radio4       : 'Barrera|Up&&In|Up&&Out|Down&&In|Down&&Out'         ;;;;NO;;;;;0;BuscarCampo('Operaciones','MB4','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DPBOS|')
   Cancelar('La operacion No '~Dialogo.NrOperacion1~' No es un Barrier Option Simple')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

* Verifico que no se haya pasado la fecha de liquidacion
(."DCFMODI".)

If NoVacio(IdxDate(val(d1))) y Dialogo.Fecha1>VAL(D1)
   Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and ((TipoOpcion='0' and FechaEj = '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"')) ")

*  SQL.ADD("and (CB8 is Null or CB8='0') ")

   Recorrer SQL
     acn(x1,1)

     * Verifico la Condicion de Ejercicio
     IF [Dialogo.Radio2=0 y Dialogo.Precio2>=Dialogo.Precio3] o [Dialogo.Radio2=1 y Dialogo.Precio2<=Dialogo.Precio3]

        *-- Verifico que la Fecha de Liquidacion Final
        *-- sea habil en la tabla de Feriados de la operacion
        IF [NOT ESHABIL(Dialogo.Fecha2,FBN['TablaFeriados1'])]
           MESSAGEBOX('La Fecha de Liquidacion Final NO ES Doa Habil en la Tabla de Feriados '~FBN['TablaFeriados1'] )        
           Break     
        ENDIF

        *-- Calculo el Resultado por Unidad    
        IF Dialogo.Radio2=0 
           *---- CALL
           IF Eqstr(FBN['MB4'],'3')
              *-- Down&Out -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-FBN['PrecioEj']))
              ENDIF
           ENDIF
 
           IF Eqstr(FBN['MB4'],'2')
              *-- Down&In -> PrecioReal<=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-FBN['PrecioEj']))
              ENDIF
           ENDIF

           IF Eqstr(FBN['MB4'],'1')
              *-- Up&Out -> PrecioReal <=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-FBN['PrecioEj']))
              ENDIF
           ENDIF

           IF Eqstr(FBN['MB4'],'0')
              *-- Up&In -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-FBN['PrecioEj']))
              ENDIF
           ENDIF
        ELSE 
           *---- PUT
           IF Eqstr(FBN['MB4'],'3')
              *-- Down&Out -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(FBN['PrecioEj']-Dialogo.Precio2))
              ENDIF
           ENDIF
  
           IF Eqstr(FBN['MB4'],'2')
              *-- Down&In -> PrecioReal<=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(FBN['PrecioEj']-Dialogo.Precio2))
               ENDIF
           ENDIF

           IF Eqstr(FBN['MB4'],'1')
              *-- Up&Out -> PrecioReal <=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(FBN['PrecioEj']-Dialogo.Precio2))  
              ENDIF
           ENDIF
  
           IF Eqstr(FBN['MB4'],'0')
              *-- Up&In -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(FBN['PrecioEj']-Dialogo.Precio2))
              ENDIF
           ENDIF
        ENDIF
     
        IF Dialogo.Radio3=1
           * Si es Venta Multiplico por -1
           ACN(Z3,-VAL(Z3))
        ENDIF
  
        *** Calculo el Resultado TOTAL
        ACN(Z2,VAL(Z3)*FBN['Cantidad'])
   
        Message('Actualizando la Opcion  .... ')                  

        *** Marca la operacion como ejercida ***
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set CB8 = '1', ")
        SQL.ADD("FechaPago = '"~IdxDate(Dialogo.Fecha2)~"', ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~", ")
        SQL.ADD("Precio3   = "~Fstr(VAL(Z3),0,2)~", ")
        SQL.ADD("Precio4   = "~Fstr(VAL(Z2),0,2)~"  ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        *-- Insert de Mov.Pendientes. El Resultado invierte el signo porque se ve desde el cliente
        * EjecutarEvento('IMOVPE',NrOperacion1=Dialogo.NrOperacion1,Fecha1=Dialogo.Fecha2,Cliente1=BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),Especie1=BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1),Vehiculo1=BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),Entero1=1,Precio1=-VAL(Z2),String='Resultado Settlement',Entero2=9,Entero3=0,String1='')

        *** Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
        SQL.EXEC

     ELSE
        *** Marca la operacion como NO ejercida ***
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set CB8 = '-1', ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~" ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC
     ENDIF

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)
   proximo

   If Val(x1)=0
      Cancelar('La operacion Nro. '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif

