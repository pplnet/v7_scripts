Sqladd("SELECT * from "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" where TipoTr2 in ('DRT') ")
Sqladd("   and Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
Sqladd("   and IsNull(ParkAfecta,'NO') = 'SI' ")
Sqladd("order by Especie,NrTrans ")
recorrer sql
Scn(x:1, 1)
if (not Eqstr(Fbn('Especie'), Val(v:1)))
if (Val(v:2) > 1)
Acn(ad:Val(v:2), Fac())
