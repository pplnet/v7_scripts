Sqladd("   and FechaOp = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Especie = '"~Val(aa:Val(v:2))~"' ")
Sqladd("   and O.NrOperacion = OB.NrOperacion ")
Sqladd("   and (OB.NrBit Not in (30,31) and OB.Valor=1)")
Sqladd("order by O.NrOperacion ")
recorrer sql
Dfa()
