creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 > 0;'Fecha Invalida';NO;FSys()
vehiculo1: 'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
entero1:'Pag.Desde';;;;;;dialogo.entero1 > 0;'Pagina Desde invalida';NO;
entero2:'Pag.Hasta';;;;;;dialogo.entero2 >= dialogo.entero1;'Pagina Hasta invalida';NO;
string1:'Numerador';;;;;;NoVacio(dialogo.string1);'Codigo Numerador Requerido';NO;
findialogo
if (not ok)
Cancelar()
endif

Acn(b:1, Query("Select Count(*) From "~Dbo()~".FLAGSMERCADO Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = '"~dialogo.string1~"' "))
if (Val(b:1) > 1)
Cancelar('Existe mas de un registro de Numero de Copiativo '~dialogo.string1~' para el '~dialogo.fecha1)
endif

Act(c:1, Fecha(Hoy()))
Act(c:2, Copy(Val(c:1), 9, 2)~Copy(Val(c:1), 4, 2)~Copy(Val(c:1), 1, 2))
Act(d:1, Hora(Ahora()))
Act(d:2, Copy(Val(d:1), 1, 2)~Copy(Val(d:1), 4, 2)~Copy(Val(d:1), 7, 2))

if (Val(b:1) = 0)
Act(e:1, 'Insert')
Message('Insert Flag Copiativo')
Sqladd("Insert Into "~Dbo()~".FLAGSMERCADO ( ")
Sqladd(" Fecha,    Registro, Paso,  Cantidad, ")
Sqladd(" FechaMercado, HoraMercado,  Estado ")
Sqladd(" ) Values ( ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd(" '"~dialogo.string1~"', ")
Sqladd(" "~FStr(dialogo.entero1, 1, 0)~", ")
Sqladd(" "~FStr(dialogo.entero2, 1, 0)~", ")
Sqladd(" '"~Val(c:2)~"', ")
Sqladd(" '"~Val(d:2)~"', ")
Sqladd(" 'IMP' ")
Sqladd(" ) ")
Sqlnew()
else
Act(e:1, 'Update')
Message('Update Flag Copiativo')
Sqladd("Update "~Dbo()~".FLAGSMERCADO ")
Sqladd("   Set Estado     = 'REI' ")
Sqladd(" where Fecha      = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Registro   = '"~dialogo.string1~"' ")
Sqlnew()
endif
Sqlexec()

