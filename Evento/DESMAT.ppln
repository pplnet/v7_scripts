Sqladd(" UPDATE "~Dbo()~".TRANSACCIONES2 SET ")
Sqladd(" RB2    ='0',   ")
Sqladd(" Fecha5 = Null, ")
Sqladd(" Cupon2 = Null  ")
Sqladd(" WHERE  NrTrans = '"~dialogo.nrtrans1~"' ")
