Sqladd(" SELECT T.*, C.RazonSocial")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C")
Sqladd(" WHERE T.Cliente1 = C.Codigo ")
Sqladd(" AND   T.Especie  = '"~dialogo.especie1~"'")
Sqladd(" AND   T.TipoTr2  = 'SPINOF' ")
Sqladd(" AND   T.Fecha1   = '"~IdxDate(dialogo.fecha2)~"'")
Sqladd(" AND   T.Fecha2   = '"~IdxDate(dialogo.fecha1)~"'")
if (NoVacio(dialogo.mercado1))
Sqladd(" AND   T.Mercado1 = '"~dialogo.mercado1~"'")
endif
Sqladd(" AND  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" ORDER BY T.Cliente1, T.NrTrans")

Acn(z:1, 0)
recorrer sql
