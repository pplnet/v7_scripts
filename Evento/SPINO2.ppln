Sqladd(" SELECT O.*, C.RazonSocial FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C ")
Sqladd(" WHERE  O.Cliente1 = C.Codigo ")
Sqladd(" AND    O.TipoOp IN ('CCE','CPE','VCE','VPE','CCP','CPP','VPP','VCP') ")
Sqladd(" AND    O.Especie  = '"~dialogo.especie1~"' ")
Sqladd(" AND    O.FechaEj >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND    (O.CB9 = '0' OR O.CB9 IS NULL) ")
Sqladd(" AND    O.CB7 = '1' ")
Sqladd(" ORDER BY O.TipoOp, O.Cliente1 ")
recorrer sql
Sqladd(" UPDATE "~Dbo()~".OPERACIONES SET CB7 = '0' WHERE NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Message('Operacion '~Fbn('NrOperacion')~' actualizada.')
proximo
Sqlexec()


Sqladd(" SELECT Codigo, Precio1, Fecha, CallPut, CodigoSpin FROM "~Dbo()~".OPCIONES WHERE Codigo = '"~dialogo.especie1~"' ")
recorrer sql
Sqladd(" UPDATE "~Dbo()~".OPCIONES ")
Sqladd(" SET CodNumCajaValores = '"~Fbn('CodigoSpin')~"',  ")
Sqladd("     CodigoSpin        = ''  ")
Sqladd(" WHERE Codigo     = '"~dialogo.especie1~"' ")
Sqladd(" AND   CodigoSpin = '"~Fbn('CodigoSpin')~"' ")
Sqladd(" AND   Fecha      = '"~IdxDate(Fbn('Fecha'))~"' ")
Sqladd(" AND   CallPut    = '"~Fbn('CallPut')~"' ")
Sqladd(" AND   Precio1    = "~FStr(Fbn('Precio1'), 1, 8)~" ")
Sqlnew()
Message('Codigo de Opcion actualizada.')
proximo
Sqlexec()
