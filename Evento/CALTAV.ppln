creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO') y not DesciendeDeEspecie(dialogo.especie1, 'CUPON');'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' "
fecha4:'F.Actualiz';1;2;;;;dialogo.fecha4 > 0;'La fecha de actualizacion ingresada no es valida';NO;FSys();
fecha1:'F.Corte';2;1;;;;dialogo.fecha1 > 0;'La fecha ingresada no es valida';NO;FSys();Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' ");
fecha6:'F.Pago';2;2;;NO;SI;dialogo.fecha6 > 0;'La fecha ingresada no es valida';NO;FSys();Query(" Select FechaPago From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' ");
entero1:'Nr.Cupon';3;1;;;;dialogo.entero1 >= 0;'Debe Ingresar el Numero de Cupon';NO;BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1);BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1)
check1:'Procesa';5;1;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Message('Calculo TNA '~dialogo.especie1)

Act(a:1, 'Especie')
Act(a:2, 'Cupon')
Act(a:3, 'TipoTasa')
Act(a:4, 'Tasa')
Act(a:5, 'Spread')
Act(a:6, 'Dias Prom')
Act(a:7, 'Dias atras')
Act(a:8, 'Tasa al Vto')
Act(a:9, 'Mon.Emision')
Act(a:10, 'DevengaTasa')
Act(a:11, 'Tasa Maxima')
Act(a:12, 'Tasa Minima')
Act(a:13, 'Fecha Base')
Act(a:14, 'Corte a Corte')
Act(a:15, 'Fecha Desde')
Act(a:16, 'Fecha Hasta')
Act(a:17, 'Dias')

Act(d:1, 'Error')
Act(f:1, 'Fecha')
Act(g:1, 'Tasa')

Act(h:1, 'Fecha Inicial')
Act(h:2, 'Suma tasas')
Act(h:3, 'Tasa Promedio')
Act(h:4, 'Tasa Ajustada')
Act(h:5, 'Tasa final')

Act(j:1, 'FPago Orig')
Act(j:2, 'FPago Orig Ant')
Act(j:3, 'Plazo')
Act(j:4, 'Base')
Act(j:5, 'Indice')
Act(j:6, '% Renta')

Act(l:1, 'Espcie')
Act(l:2, 'F4 - Actua.')
Act(l:3, 'F1 - Corte')
Act(l:4, 'F6 - Pago')
Act(l:5, 'Cupon')
Act(l:6, 'Procesa')
SetFont(a:1..l:17, 2)

Act(m:1, dialogo.especie1)
Acd(m:2, dialogo.fecha4)
Acd(m:3, dialogo.fecha1)
Acd(m:4, dialogo.fecha6)
Acn(m:5, dialogo.entero1)
Acn(m:6, dialogo.check1)

Sqladd("SELECT * FROM "~Dbo()~".ESPECIES WHERE Codigo = '"~dialogo.especie1~"'")
recorrer sql
Act(b:1, Fbn('Codigo'))
Acn(b:2, Fbn('Cupon'))
Act(b:3, Fbn('TasaCER'))
Act(b:4, Fbn('TiposTasas'))
Acn(b:5, Fbn('Spread'))
Acn(b:6, Fbn('DiasProm'))
Acn(b:7, Fbn('Diasatras'))
Act(b:8, Fbn('TasaAlVto'))
Act(b:9, Fbn('MonedaEmision'))
Act(b:10, Fbn('DevengaTasa'))
Acn(b:11, Fbn('TasaMax'))
Acn(b:12, Fbn('TasaMin'))
Act(b:14, Fbn('Alias7'))
proximo
if (Eqstr(Val(b:10), 'COR'))
Act(b:13, 'F.Corte')
else
if (Eqstr(Val(b:10), 'PAG'))
Act(b:13, 'F.Pago')
else
Act(b:13, 'F.Pago Orig')
endif
endif

Acn(e:1, 0)
if (not Eqstr(Val(b:3), 'FLO'))
Acn(e:1, 1)
if (dialogo.check1 = 1)
Cancelar('la especie '~Val(b:1)~' no es de tasa variable')
else
Messagebox('la especie '~Val(b:1)~' no es de tasa variable')
endif
endif
if (Vacio(Val(b:4)))
Acn(e:1, 1)
if (dialogo.check1 = 1)
Cancelar('La especie '~Val(b:1)~' no tiene cargado el tipo tasa.')
else
Messagebox('La especie '~Val(b:1)~' no tiene cargado el tipo tasa.')
endif
endif
if (Val(b:6) < 1)
Acn(b:6, 1)
Act(c:6, 'Forzado')
endif
if (Val(b:7) < 1)
Acn(b:7, 0)
Act(c:7, 'Forzado')
endif

if (Val(e:1) = 0)
if (Eqstr(Val(b:10), 'COR'))
Acd(k:1, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "))
else
if (Eqstr(Val(b:10), 'PAG'))
Acd(k:1, Query(" Select FechaPago From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "))
else
Acd(k:1, Query(" Select FechaPagoOriginal From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "))
endif
endif
if (dialogo.entero1 = 1)
Acd(k:2, BuscarCampo('ESPECIES', 'FEmision', 'Codigo', dialogo.especie1))
else
if (Eqstr(Val(b:10), 'COR'))
Acd(k:2, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1 - 1, 0, 0)~"' "))
else
if (Eqstr(Val(b:10), 'PAG'))
Acd(k:2, Query(" Select FechaPago From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1 - 1, 0, 0)~"' "))
else
Acd(k:2, Query(" Select FechaPagoOriginal From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1 - 1, 0, 0)~"' "))
endif
endif
endif
Acn(k:3, Val(k:1) - Val(k:2))
if (Eqstr(BuscarCampo('ESPECIES', 'DiasAnio', 'Codigo', dialogo.especie1), 'REA'))
Acn(k:4, DiasA(2, dialogo.fecha1))
else
if (Eqstr(BuscarCampo('ESPECIES', 'DiasAnio', 'Codigo', dialogo.especie1), '360'))
Acn(k:4, 360)
else
Acn(k:4, 365)
endif
endif
Acn(k:5, Val(k:3) / (Val(k:4)))

if (Eqstr(Val(b:14), 'SI'))
if (dialogo.entero1 = 1)
Acd(b:15, BuscarCampo('ESPECIES', 'FEmision', 'Codigo', dialogo.especie1))
else
Acd(b:15, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1 - 1, 0, 0)~"' "))
endif
Acd(b:16, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "))
if (Val(b:7) > 0)
Acd(c:15, Val(b:15))
Acd(b:15, Habiles(Val(c:15), -Val(b:7), 'ARG', SI))
Acd(c:16, Val(b:16))
Acd(b:16, Habiles(Val(c:16), -Val(b:7), 'ARG', SI))
endif
Acn(b:17, DifDias(Val(b:15), Val(b:16), 'ARG', SI))
Acd(i:1, Val(b:15))
Acn(b:6, Val(b:17))
else
if (Eqstr(Val(b:8), 'SI'))
Acd(i:1, Habiles(Val(k:1), -(Val(b:7) + Val(b:6) - 1), 'ARG', SI))
else
Acd(i:1, Habiles(Val(k:2), -(Val(b:7) + Val(b:6) - 1), 'ARG', SI))
endif
endif

recorrer&i 0, Val(b:6) - 1
Acd(f:&i + 2, Habiles(Val(i:1), &i, 'ARG', SI))
Acn(g:&i + 2, TasaDia(Val(b:4), Val(b:9), Val(f:&i + 2), 1, 1))
Scn(i:2, Val(g:&i + 2))
proximo
Acn(i:3, Val(i:2) / Val(b:6))
Acn(i:4, Val(i:3) + Val(b:5))
Acn(i:5, Val(i:4))
if (Val(b:11) > 0)
if (Val(i:5) > Val(b:11))
Acn(i:5, Val(b:11))
Act(i:6, 'Forzada x Maxima')
endif
endif
if (Val(i:5) < Val(b:12))
Acn(i:5, Val(b:12))
Act(i:6, 'Forzada x Minima')
endif

Acn(k:6, Val(i:4) * Val(k:5))
endif

if (dialogo.check1 = 1)
Message('Actualizando TNA en Agenda de Cupones ')
Sqladd("UPDATE "~Dbo()~".AGENDACUPONES ")
Sqladd("   Set TNA = "~FStr(Val(i:5), 1, 9)~", ")
Sqladd("       PorRenta = "~FStr(Val(k:6), 1, 9)~" ")
Sqladd(" WHERE Especie = '"~dialogo.especie1~"' ")
Sqladd("  AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' ")
Sqlnew()
Sqlexec()
else
Messagebox('Actualizando TNA en Agenda de Cupones')
endif

FormatoCeldas(k:3..k:4, Exe('F0'))
FormatoCeldas(k:5..k:6, Exe('F8'))
ACO(1, 10)
ACO(8, 10)
ACO(10, 10)
ACO(12, 10)


