modoreproceso(condialogo)
creardialogo
fecha1:'Fecha';;;;;;NoVacio(dialogo.fecha1);'Debe Ingresar una Fecha';NO;FSys()
especie1:'Especie';;;;;;;;;
check1:'Procesa';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)
Act(a:fac, 'Fecha:')
Act(b:fac, dialogo.fecha1)
SetFont(a:fac..b:fac, 3)

SetFilaActual(Fac() + 2)
Act(a:fac, 'Especie')
Act(b:fac, 'PrecioEj')
Act(c:fac, 'FechaEj')
Act(d:fac, 'Cupon')
Act(e:fac, 'Cliente')
Act(f:fac, 'Vehiculo')
Act(g:fac, 'Book')
Act(h:fac, 'Trader')
Act(i:fac, 'TipoNego')
Act(j:fac, 'NrSaldo')
Act(k:fac, 'Fecha')
Act(l:fac, 'Cant.Ini.')
Act(m:fac, 'Cant.Fin.')
Act(n:fac, 'Cotiza')
Act(o:fac, 'IntCorr')

Act(aa:fac, 'Especie')
Act(ab:fac, 'Intereses')
Act(ac:fac, 'Cant.Reg.')
Act(ad:fac, 'Resultado')

Act(ai:fac, 'VTeorico2()')
Act(aj:fac, 'Esp.DiasAnio')
Act(ak:fac, 'Esp.DiasMes')
Act(al:fac, 'CuponFer')
Act(am:fac, 'UltCupon2()')
Act(an:fac, 'F.Ult.Cupon')
Act(ao:fac, 'F.Cbio.Tasa')
Act(ap:fac, 'Tipo FUC')
Act(aq:fac, 'T.Int.Cupon')
Act(ar:fac, 'Divisor')

SetFont(a:fac..az:fac, 2)
Acn(w:1, Fac())

Sqladd(" Select P.Especie,     P.PrecioEj,    P.FechaEj, P.Cupon,  ")
Sqladd("        P.Cliente,     P.Vehiculo,    P.Book,    P.Trader, ")
Sqladd("        P.TipoNegocio, P.NrSaldo,     P.Fecha, ")
Sqladd("        P.CantidadIni, P.CantidadFin, ")
Sqladd("        E.Cotiza,      E.InteresesC   ")

Sqladd("   from "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E")
Sqladd("  where P.Especie = E.Codigo ")
Sqladd("    and E.Codigo in ("~Pipe2Comillas(Descendientes('ESPECIES', 'TITULO'))~") ")
if (NoVacio(dialogo.especie1))
Sqladd("and P.Especie = '"~dialogo.especie1~"' ")
endif
Sqladd("and P.Fecha = (Select Max(P1.Fecha) from "~Dbo()~".POSICIONES P1 ")
Sqladd("                where P1.Especie                 = P.Especie  ")
Sqladd("                  and IsNull(P1.FechaEj,'')      = IsNull(P.FechaEj,'')  ")
Sqladd("                  and IsNull(P1.PrecioEj,'')        = IsNull(P.PrecioEj,'')  ")
Sqladd("                  and IsNull(P1.Cupon,'')        = IsNull(P.Cupon,'')  ")
Sqladd("                  and P1.Cliente                 = P.Cliente ")
Sqladd("                  and P1.Vehiculo                = P.Vehiculo ")
Sqladd("                  and IsNull(P1.Book,'')         = IsNull(P.Book,'')  ")
Sqladd("                  and IsNull(P1.Trader,'')       = IsNull(P.Trader,'')  ")
Sqladd("                  and IsNull(P1.TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
Sqladd("                  and P1.NrSaldo                 = P.NrSaldo ")
Sqladd("                  and P1.Fecha                  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("              ) ")
Sqladd("Order by P.Especie, P.PrecioEj, P.FechaEj, P.Cupon, P.Cliente, P.Vehiculo, P.Book, P.Trader, P.TipoNegocio, P.NrSaldo ")

recorrer sql
Scn(x:1, 1)
Act(a:fac, Fbn('Especie'))
Acn(b:fac, Fbn('PrecioEj'))
Acd(c:fac, Fbn('FechaEj'))
Act(d:fac, Fbn('Cupon'))
Act(e:fac, Fbn('Cliente'))
Act(f:fac, Fbn('Vehiculo'))
Act(g:fac, Fbn('Book'))
Act(h:fac, Fbn('Trader'))
Act(i:fac, Fbn('TipoNegocio'))
Acn(j:fac, Fbn('NrSaldo'))
Acd(k:fac, Fbn('Fecha'))
Acn(l:fac, Fbn('CantidadIni'))
Acn(m:fac, Fbn('CantidadFin'))
Act(n:fac, Fbn('Cotiza'))
Act(o:fac, Fbn('InteresesC'))
if (not Eqstr(Fbn('Especie'), Val(v:1)))
Scn(x:2, 1)
Act(aa:Val(x:2) + 3, Fbn('Especie'))
Act(v:1, Fbn('Especie'))
endif

proximo

if (Val(x:1) > 0)
FormatoCeldas(b:Val(w:1) + 1..b:fac, Exe('F6'))
FormatoCeldas(j:Val(w:1) + 1..j:fac, Exe('F0'))
FormatoCeldas(l:Val(w:1) + 1..m:fac, Exe('F2'))
SetFont(a:Val(w:1) + 1..o:fac, 1)
endif
if (Val(x:2) > 0)
recorrer&i 4, Val(x:2) + 3






Acn(ai:&i, ValorTeorico2(Val(aa:&i), dialogo.fecha1))
Acn(aj:&i, EspecieDiasAnio(Val(aa:&i)))
Acn(ak:&i, EspecieDiasMes(Val(aa:&i)))
Act(al:&i, BuscarCampo('ESPECIES', 'CuponFeriado', 'Codigo', Val(aa:&i)))
Acd(am:&i, UltCupon2(Val(aa:&i), dialogo.fecha1))
if (EsHabil(Val(am:&i), 'USA'))
Acd(an:&i, Val(am:&i))
else
Acd(an:&i, Habiles(Val(am:&i), iif (Eqstr(Val(al:&i), 'SIG'), 1, iif (Eqstr(Val(al:&i), 'ANT'), -1, 0)), 'USA'))
endif
Acd(ao:&i, BuscarCampo('ESPECIES', 'FechaCambioTasa', 'Codigo', Val(aa:&i)))
if (Val(ao:&i) > Val(an:&i) y Val(ao:&i) < dialogo.fecha1)
Act(ap:&i, 'Mix')
Acn(aq:&i, BuscarCampo('ESPECIES', 'TasaIntVigente', 'Codigo', Val(aa:&i)))
else
Act(ap:&i, 'Vigente')
Acn(aq:&i, BuscarCampo('ESPECIES', 'TasaIntVigente', 'Codigo', Val(aa:&i)))
endif
Acn(aq:&i, Val(aq:&i) * 100)
Acn(ar:&i, DiasA(Val(aj:&i), dialogo.fecha1))

Acn(ab:&i, Val(aq:&i) / Val(ar:&i) / 100)

if (Val(ab:&i) > 0)
Acn(ac:&i, Query("Select Count(*) from "~Dbo()~".INTERESESCORRIDOS where Especie = '"~Val(aa:&i)~"' and Fecha = '"~IdxDate(dialogo.fecha1)~"' "))
if (Val(ac:&i) = 0)
Act(ad:&i, 'Insert')
if (dialogo.check1 = 1)
Sqladd("Insert into "~Dbo()~".INTERESESCORRIDOS ( ")
Sqladd("   Fecha, Especie, Intereses ")
Sqladd("   ) values ( ")
Sqladd("   '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("   '"~Val(aa:&i)~"', ")
Sqladd("   "~FStr(Val(ab:&i), 1, 8)~" ")
Sqladd("   ) ")
Sqlnew()
Sqlexec()
endif
else
if (Val(ac:&i) = 1)
Act(ad:&i, 'Update')
if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".INTERESESCORRIDOS ")
Sqladd("   Set Intereses = "~FStr(Val(ab:&i), 1, 8)~" ")
Sqladd(" where Especie = '"~Val(aa:&i)~"' ")
Sqladd("   and Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()
endif
else
Act(ad:&i, 'Error - Mas de un registro')
endif
endif
else
Act(ad:&i, 'Error - Intereses cero')
endif

proximo
FormatoCeldas(ab:Val(w:1) + 1..ab:fac, Exe('F8'))
FormatoCeldas(ac:Val(w:1) + 1..ac:fac, Exe('F0'))
FormatoCeldas(ai:Val(w:1) + 1..ai:fac, Exe('F8'))
FormatoCeldas(aj:Val(w:1) + 1..ak:fac, Exe('F0'))
FormatoCeldas(aq:Val(w:1) + 1..aq:fac, Exe('F8'))
FormatoCeldas(ar:Val(w:1) + 1..ar:fac, Exe('F0'))
SetFont(aa:4..az:Val(x:2) + 3, 1)
endif

SetFont(v:1..z:3, 1)


