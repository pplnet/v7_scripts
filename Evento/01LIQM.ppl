CrearDialogo
  Vehiculo1: 'Vehiculo'      ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   : 'Fecha Liq.'    ; 2;1;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
  Check11  : 'Incluye Pend'  ; 2;2;;;;;;;0;
  Mercado1 : 'Mercado'       ; 3;1;;;;[NoVacio(Dialogo.Mercado1) y Not Incluido(Dialogo.Mercado1, VAR('MERCTITULO'))] o Dialogo.Check6=0;'Debe ingresar un Mercado';NO;;;;;;" (Netea='NO' or Netea is Null) and Observaciones like ('T|') "
  Cliente1 : 'Cliente'       ; 4;1;;;;NoVacio(Dialogo.Cliente1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar un Cliente';NO;
  Especie1 : 'Especie'       ; 5;1;;;;NoVacio(Dialogo.Especie1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar una Especie';NO;
  Mercado2 : 'Merc. Neg.'    ; 6;1;;;;[NoVacio(Dialogo.Mercado2) y Not Incluido(Dialogo.Mercado2, VAR('MERCTITULO'))] o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar Mercado Negociacion';NO;VAR('MERCANEG');;;;;" Codigo not in ('AC') "
  Check14  : 'SENEBI'        ; 6;2;;                ;EQSTR(Dialogo.Mercado2,VAR('MERSENEBI'));;;;IIF(EQSTR(Dialogo.Mercado2,VAR('MERSENEBI')),1,0);IIF(EQSTR(Dialogo.Mercado2,VAR('MERSENEBI')),1,0);
  Check1   : 'Titulos'       ; 7;1;;                ;Dialogo.Check12=0  ;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check10+Dialogo.Check12>0;'Debe seleccionar un grupo de operaciones';NO;1;IIF(Dialogo.Check12=1,0,Dialogo.Check1)
  Check13  : 'COM. MAE1'     ; 8;1;;Dialogo.Check1=1;Dialogo.Check1=1;Dialogo.Check5+Dialogo.Check13=2 o Dialogo.Check13=0;'Liquidando Comision MAE1 se debera COMPENSAR';NO;IIF(Dialogo.Check12=1,0,Dialogo.Check13);IIF(Dialogo.Check12=1,0,Dialogo.Check13)
  Check2   : 'F.Exchange'    ; 9;1;;;Dialogo.Check12=0 y Dialogo.Check13=0;;;;1;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,0,Dialogo.Check2)
  Check3   : 'M.Market'      ;10;1;;;Dialogo.Check12=0 y Dialogo.Check13=0;;;;1;IIF(Dialogo.Check12=1 o Dialogo.Check13=1 ,0,Dialogo.Check3)
  Check12  : 'Rofex'         ; 7;2;;                ;Dialogo.Check13=0;Dialogo.Check5+Dialogo.Check12=2 o Dialogo.Check12=0;'Liquidando ROFEX se debera COMPENSAR';NO;IIF(Dialogo.Check13=1,0,Dialogo.Check12);IIF(Dialogo.Check13=1,0,Dialogo.Check12)
  Check4   : 'Prestamos'     ; 8;2;;;Dialogo.Check12=0 y Dialogo.Check13=0;;;;0;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,0,Dialogo.Check4)
  Check10  : 'Falla OCT'     ; 9;2;;;Dialogo.Check12=0 y Dialogo.Check13=0;;;;0;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,0,Dialogo.Check10)
  Check9   : 'Netea Mon.'    ; 3;2;;Dialogo.Check6=1;Dialogo.Check6=1;;;;0;
  Check5   : 'Compensar Op.' ; 4;2;;;;Dialogo.Check5+Dialogo.Check6<2;'No se puede Compensar y Seleccionar al mismo tiempo';NO;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,1,0);IIF(Dialogo.Check12=1 o Dialogo.Check13=1,1,0)
  Check6   : 'Seleccionar'   ; 5;2;;  ;  ;;;;0;
  Check8   : 'Procesa'       ;11;1;;NO;NO;;;;1;
  Check7   : 'Liq.Automatica';11;2;;NO;NO;;;;0;
FinDialogo

if Not Ok
   Cancelar
