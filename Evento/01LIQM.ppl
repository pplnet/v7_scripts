CrearListBox ; 'Arial,8,';Val(di:1)
   'OK'                ;q:1..q:Fac   ;Val(bm:1)=1;;;40;CHECK
   'Cliente'           ;a:1..a:Fac   ;NO;;;70 ;STRING;;
   'Mercado'           ;b:1..b:Fac   ;NO;;;70 ;STRING;;
   'Tipo   '           ;TR:1..TR:Fac   ;NO;;;30 ;STRING;;
   'Concepto'          ;c:1..c:Fac   ;NO;;;30 ;STRING;;
   '        '          ;d:1..d:Fac   ;NO;;;60 ;STRING;;
   'Especie '          ;e:1..e:Fac   ;NO;;;60 ;STRING;;
   'Titulos'           ;f:1..f:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Moneda '           ;g:1..g:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
**//Arreglo separadores en condicion de validez para que funcione bien en V6
**// SI o SI y NO = NO (En V3)
**// En V6 = SI, por lo que agrego: (SI O SI) Y NO
**//   'Cta.Cliente'       ;r:1..r:Fac   ;SI;[[val(cn:flb)=0 y [ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb)) o ClienteCuenta(Val(a:flb),Val(r:flb),Val(eb:flb))] o Eqstr(Val(r:FLB),VAR('CTAMOD23'))] o [val(cn:flb)=1 y [ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb)) o ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb))] o Eqstr(Val(r:FLB),VAR('CTAMOD23')) o Vacio(BuscarCampo('CUENTAS','Cliente','Codigo',Val(a:flb)))]  y Eqstr(BuscarCampo('CUENTAS','Mercado','Codigo',val(r:flb)),Val(b:FLB)) y NoVacio(Val(r:FLB))]  o Val(q:FLB)=0;'La Cta '~Val(r:FLB)~' del Cliente '~Val(a:FLB)~' es incorrecta.';70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';" (Cliente='"~Val(a:FLB)~"' and  (Especies like '%"~Val(me:flb)~"%'  OR Especies LIKE '%"~Val(e:flb)~"%') and Estado='HAB' and "~IIF(NoVacio(Val(b:FLB)),"Mercado = '"~Val(b:FLB)~"' and ","")~" TipoCuenta In ('CUS','CCO','CA','CC')) or Codigo='"~VAR('CTAMOD23')~"'";RGB(180,180,193);;NO;NO;;NO;NO;NO;SI
   'Cta.Cliente'       ;r:1..r:Fac   ;SI;[[[val(cn:flb)=0 y [ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb)) o ClienteCuenta(Val(a:flb),Val(r:flb),Val(eb:flb))] o Eqstr(Val(r:FLB),VAR('CTAMOD23'))] o [val(cn:flb)=1 y [ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb)) o ClienteCuenta(Val(a:flb),Val(r:flb),Val(ea:flb))] o Eqstr(Val(r:FLB),VAR('CTAMOD23')) o Vacio(BuscarCampo('CUENTAS','Cliente','Codigo',Val(a:flb)))]]  y Eqstr(BuscarCampo('CUENTAS','Mercado','Codigo',val(r:flb)),Val(b:FLB)) y NoVacio(Val(r:FLB))]  o Val(q:FLB)=0;'La Cta '~Val(r:FLB)~' del Cliente '~Val(a:FLB)~' es incorrecta.';70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';" (Cliente='"~Val(a:FLB)~"' and  (Especies like '%"~Val(me:flb)~"%'  OR Especies LIKE '%"~Val(e:flb)~"%') and Estado='HAB' and "~IIF(NoVacio(Val(b:FLB)),"Mercado = '"~Val(b:FLB)~"' and ","")~" TipoCuenta In ('CUS','CCO','CA','CC')) or Codigo='"~VAR('CTAMOD23')~"'";RGB(180,180,193);;NO;NO;;NO;NO;NO;SI
   'Nro.Op.'           ;i:1..i:Fac   ;NO;;;60 ;STRING;;
   'Cta.Propia'        ;s:1..s:Fac   ;SI;[[ClienteCuenta(Dialogo.Vehiculo1,Val(s:flb),Val(ea:flb)) o ClienteCuenta(Dialogo.Vehiculo1,Val(s:flb),Val(ea:flb))] y NoVacio(Val(s:FLB)) y Eqstr(BuscarCampo('CUENTAS','Mercado','Codigo',val(s:flb)),Val(b:FLB)) ] o Val(q:FLB)=0;'La Cta '~Val(s:FLB)~' de Liquidacion para el vehiculo es incorrecta.'; 60;TABLA  ; 'Cuentas';'Codigo';'Codigo;Nombre';"Cliente='"~Dialogo.Vehiculo1~"' and Estado='HAB'  and  "~IIF(NoVacio(Val(b:FLB)),"Mercado = '"~Val(b:FLB)~"' and ","")~"   (Especies like '%"~Val(me:flb)~"%'  OR Especies LIKE '%"~Val(e:flb)~"%')    "                      ;RGB(180,180,193);;NO;NO;;NO;NO;NO;SI
   'Transferencia'     ;bt:1..bt:Fac ;DesciendeDeEspecie(Val(e:FLB),'TITULO') y Not EqStr(BuscarCampo('CUENTAS','Comitente','Codigo',Val(r:Fac)),VAR('VEHICULODE')) y Eqstr(val(b:fac),VAR('CLHODEFA')) ;[DesciendeDeEspecie(Val(e:FLB),'TITULO') y Not EqStr(BuscarCampo('CUENTAS','Comitente','Codigo',Val(r:Fac)),VAR('VEHICULODE'))  y Val(bt:FLB)<>0 ] o [[ Not DesciendeDeEspecie(Val(e:FLB),'TITULO') y Not EqStr(BuscarCampo('CUENTAS','Comitente','Codigo',Val(r:Fac)),VAR('VEHICULODE'))] y Val(bt:FLB)=0]; 'Tipo Transferencia Incorrecta '~val(a:FLB)~' '~val(e:FLB);90 ;COMBO;'|Inmediata|Diferida|Conformada|';RGB(180,180,193)
   'Matching'          ;bu:1..bu:Fac ;val(bt:flb)=1  o val(bt:flb)=2;[[val(bt:flb)=1 o val(bt:flb)=2] y val(bu:flb)>0 y val(bu:flb)>=val(ak:flb) y val(bu:flb)<=Dialogo.Fecha1+Var('MAXFECMATC') y EsHabil(val(bu:flb),'ARG')] o val(bu:flb)=0;'Fecha Matching Erronea '; 70; FECHA;RGB(180,180,193);
   'Ejecucion'         ;bv:1..bv:Fac ;val(bt:flb)=2 ;[val(bt:flb)=2 y NoVacio(val(bv:flb)) y val(bv:flb)>=val(bu:flb) y val(bv:flb)<=val(bu:flb)+Var('MAXFECEJEC') y EsHabil(val(bv:flb),'ARG')] o val(bv:flb)=0  ;'Fecha Ejecucion Erronea '; 70; FECHA;RGB(180,180,193);
FinListBox

**** 
IF NOT OK 
   Cancelar
ENDIF

ACT(nu1,GetNumerador(8000))

if OK o Dialogo.Check7=1
   if Dialogo.Check6=1
      * Selecciona
      (.'GENNETDBO'.)
   else
      recorrer&i 1,Fac
        if Val(q:&i) = 1
           if Val(bo:&i)=1
              * Voucher MATCH
              (.'GENMATDBO'.)
           else
              * Vouchers DEP,RET,COMP
              (.'GENVOUDBO'.)
           endif
           SQL.EXEC

           if Val(k:&i)=0 
               EjecutarEvento('DESPRF',NrTrans1=Val(n:&i),Fecha1=Habiles(Dialogo.Fecha1,1,'ARG'),Fecha2=Dialogo.Fecha1)
           endif
        endif
        Message('Pasando Operaciones a Terminal ...')
        EjecutarEvento('PPASE',NrOperacion=val(i:&i), Mercado1='')
      proximo
   endif
   
   message('Generando Transaccion de Custodia ...')
   EjecutarEvento('CONCUS',Vehiculo1=Dialogo.Vehiculo1, String1=Val(nu1)) 
  
endif