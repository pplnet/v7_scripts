Sqladd("Select O.NrOrden, O.TipoOrden, O.Cliente, OB.NrBit ")
Sqladd("  from "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" Where (O.NrOrden   Like '"~'____'~Copy(Val(c:54), 2, 4)~"' and O.TipoOrden in ('TMANIF') and OB.NrBit in (104) ) ")
Sqladd("   and O.NroAltaMAE = '"~Val(c:60)~"' ")
Sqladd("   and O.FechaAltaMAE = "~Val(c:62)~" ")
Sqladd("   and O.NrOrden   = OB.NrOperacion ")
Sqladd("   and OB.Valor    = '1' ")
Sqladd(" UNION ")
Sqladd("Select O.NrOrden, O.TipoOrden, O.Cliente, OB.NrBit ")
Sqladd("  from "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" Where  O.NrOrden   Like '"~'____'~Copy(Val(c:54), 2, 4)~"' and O.TipoOrden in ('OTIC','OTIV')  ")
Sqladd("   and O.NroAltaMAE = '"~Val(c:60)~"' ")
Sqladd("   and O.NrOrden   = OB.NrOperacion ")
Sqladd("   and OB.Valor    = '1' ")
Watch(Sqlbatch())
