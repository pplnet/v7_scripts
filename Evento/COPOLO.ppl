MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Desde'       ;;;;;;Dialogo.Fecha1 < Dialogo.Fecha2;'La Fecha Desde debe ser menor a la Fecha Hasta';NO;Fsys
  Fecha2:       'Hasta'       ;;;;;;SI O Dialogo.Fecha2 <= FSys;'La Fecha Hasta debe ser menor a la Fecha del Sistema';NO;Fsys
  Especie1:     'Especie'     ;;;;;;;;;
FinDialogo

If Not Ok
  Cancelar
Endif

Recorrer&k Dialogo.Fecha1, Dialogo.Fecha2
    ACN(DS:1, DiaSem(&k))
    IF Val(DS:1) > 1 Y Val(DS:1) < 7
        Message('Copiando El '~Fecha(&k))
        IF Val(DS:1) = 6
        EjecutarEvento('COPPOS', Fecha1=Fecha(&k)+3, Especie1=Dialogo.Especie1)
        ELSE
        EjecutarEvento('COPPOS', Fecha1=Fecha(&k)+1, Especie1=Dialogo.Especie1)
        ENDIF
    ENDIF
Proximo