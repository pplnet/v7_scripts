Sqladd("Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, TotalIntereses from "~Dbo()~".OPERACIONES where FechaVto = '"~IdxDate(FSys())~"' ")
Sqladd("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE') ")
Sqladd("and RB6 = '1' ")
Sqladd("order by Cliente1, Especie, TipoOp ")


Acn(z1, 0)
recorrer sql
Act(a:fac, Fbn('Cliente1'))
Act(b:fac, Fbn('Especie'))
Act(c:fac, Fbn('TipoOp'))
Acn(d:fac, Fbn('Cantidad'))
Acn(e:fac, Fbn('Precio1'))
Acn(f:fac, Fbn('TotalIntereses'))
Acn(g:fac, Fbn('Plazo'))
Act(h:fac, Fbn('NrOperacion'))
Scn(z1, 1)
proximo

ACO(1, 10)
ACO(2, 6)
ACO(3, 6)
ACO(4, 12)
ACO(5, 10)
ACO(6, 10)
ACO(7, 5)
ACO(8, 8)

FormatoCeldas(d1..d:fac, Exe('F2'))
FormatoCeldas(e1..e:fac, Exe('F7'))
FormatoCeldas(f1..f:fac, Exe('F2'))
FormatoCeldas(g1..g:fac, Exe('F0'))

if (Val(z1) > 0)
listbox(a1..h:fac, 'Cliente      Especie TipoOp         Cantidad       Precio    Intereses  Plazo   #Oper.')
if (ok)
recorrersel
Sqladd("Delete "~Dbo()~".OPERACIONES where OperacionRef = '"~Val(h:filaciclo)~"'")
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONES set RB6 = '0' where NrOperacion = '"~Val(h:filaciclo)~"'")
Sqlnew()
proximo
Sqlexec()
endif
else
Cancelar('No existen operaciones')
endif

