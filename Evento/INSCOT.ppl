MostrarCuadroDeMensajes

ACD(z1, Fecha('01/10/2010'))
ACD(z2, Fecha('10/09/2011'))
ACN(a1, 2.45)
   Recorrer&i Val(z1), Val(z2)
     SCN(a1, 0.0011)
     If EsHabil(&i)
       SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
       SQL.ADD("(Fecha, Codigo, CallPut, Precio1 )")
       SQL.ADD("Values")
       SQL.ADD("( '"~IdxDate(&i)~"','CER', 'CON', "~Val(a1)~" ) ")
       SQL.NEW
       SQL.EXEC
       ACT(Z:9, 'Fecha: '~Fecha(&i)~' = CER: '~Fstr(Val(a1),0,3))
       Message(Val(z9))
       Esperar(0.15)
     Endif
   Proximo