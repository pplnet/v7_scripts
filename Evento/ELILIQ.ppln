creardialogo
nroperacion1:'Nr.Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Debe indicar un Nro. de Operacion';NO;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), Var('TIPOOPNC')))
if (Messagebox('Si intenta ingresar una Nota de Credito, debe anular los vouchers a traves del evento Anulacion de Factura y Vouchers, ¿Desea Continuar?', 1, 2) = 7)
Cancelar()
endif
endif

Act(ls:2, 'MMPCCM|MMPCCV|MMPCL|MMPCLM|MMPCOS|MMPE|MMPEM|MMPI|MMPIM|MMPIMO|MMPOSM')
Sqladd(" Select TipoOp, OperacionRef, Vehiculo1 ")
Sqladd(" From "~Dbo()~".OPERACIONES ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Act(tp:1, Fbn('TipoOp'))
Act(rf:1, Fbn('OperacionRef'))
Act(vh:1, Fbn('Vehiculo1'))
proximo

if (Incluido(Val(tp:1), Val(ls:2)) y not celdavacia(rf:1))
Cancelar('La Operacion No Puede Anularse por tener Asociada la Partida '~Val(rf:1)~' - DEBE ANULAR LA PARTIDA')
endif

MostrarCuadroDeMensajes()


Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif





Sqladd("Select NrTrans from "~Dbo()~".TRANSACCIONES2 where NrOperacionRef1='"~dialogo.nroperacion1~"' ")

Acn(a1, 0)

recorrer sql

Message(' Anulando Voucher Nro. '~Fbn('NrTrans')~' ....')

Acn(a1, 1)
Ejecutarevento('ANUVOU', 'nrtrans1', Fbn('NrTrans'), 'check1', 1)

proximo

if (Val(a1) = 0)
Message('La operacion no tiene vouchers asociados')
else
if (Eqstr(Val(tp:1), 'MMP'))
Act(ls:3, SQLSet(" Select NrOperacion From "~Dbo()~".OPERACIONES Where OperacionRef = '"~dialogo.nroperacion1~"' "))
Sqladd("DELETE "~Dbo()~".MOVAJUSTE Where NrOperacion IN ("~Pipe2Comillas(Val(ls:3))~")")
else
Sqladd("DELETE "~Dbo()~".MOVAJUSTE Where NrOperacion='"~dialogo.nroperacion1~"'  ")
endif
Sqlnew()
Sqlexec()
endif

