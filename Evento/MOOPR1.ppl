CrearDialogo
  NrOperacion1 : 'Nro. Operacion';;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar un numero de Op.';NO
FinDialogo

if not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario
  
ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

if Incluido(BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),Var('VLIQUIDA')~Var('VLIQUIDA2'))
  Cancelar('Las operaciones del Vehiculo '~BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)~' no se modifican con este evento')
endif

ACT(z7, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))

if Incluido(Copy(Val(z7),1,2),'SE|FX')
  Cancelar("Las operaciones del Tipo "~Val(z7)~" no se modifican por evento")
endif

if Incluido(Val(z7),'DTSFV|DTSFF|DTSVV')
  Cancelar("Las operaciones del Tipo "~Val(z7)~" no se modifican por evento")
endif

ACN(z9, SQL("Select count(*) from "~DBO~".MOVPENDIENTES where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrSaldo = 1"))

*if Val(z9)=0 y BuscarCampo('OPERACIONES','Cuotas1','NrOperacion',Dialogo.NrOperacion1)<1 y Incluido(Copy(Val(z7),1,2),'MM')
*  Cancelar("Las operaciones liquidadas del Tipo "~Val(z7)~" no se modifican")
*endif

*if Val(z9)=0 y BuscarCampo('OPERACIONES','FechaEj','NrOperacion',Dialogo.NrOperacion1) < FSys y BuscarCampo('OPERACIONES','Cuotas1','NrOperacion',Dialogo.NrOperacion1)<1 y Incluido(Copy(Val(z7),1,2),'DP|DT')
*  Cancelar("Las operaciones liquidadas del Tipo "~Val(z7)~" no se modifican")
*endif

ACN(z1, SQL("Select count(*) from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"'"))
if Val(z1) = 0
  Cancelar('La Operacion no existe')
else
  if Not EqStr(BuscarCampo('OPERACIONES','Operador','NrOperacion',Dialogo.NrOperacion1), UsuarioActivo) y Not Incluido(UsuarioActivo, Var('ULMODI'))
    Cancelar('El usuario no esta autorizado a modificar la operacion')
  endif
  ACN(z2, SQL("Select count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrSaldo = 1"))
  if Val(z2)=0
    Cancelar('La operacion no tiene liquidaciones')
  else
    ACN(z3, SQL("Select count(*) from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrBit in (8,9,20,50) and Valor = '1'"))
    if Val(z3)=0
      Cancelar('La operacion no esta en BackOffice ni en Terminal')
    else
      ModificarOperacion(Dialogo.NrOperacion1,1,NO)

      if Ok
        ACN(z4, SQL("Select RB3 from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"'"))
        SQL.ADD("Update "~DBO~".OPERACIONES set Impresa='1' where NrOperacion='"~Dialogo.NrOperacion1~"'")
        SQL.NEW
        SQL.EXEC
        SQL.ADD(" Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrOperacion1~"' and Valor = '1' ")
        Recorrer SQL
            DFA
            IF fbn('NrBit') = 50
                ***---Si esta en terminal verifico si estan las instancias
                IF SQL(" Select Count(*) From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' ") = 1
                    ***---No estan las otras instancias => las inserto
                    EjecutarEvento('INSBIT', String1 = 'OPERACIONES', Entero1 = 50, NrOperacion1=Dialogo.NrOperacion1)
                ENDIF
            ENDIF
        Proximo
        SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='0' where NrOperacion='"~Dialogo.NrOperacion1~"' and NrBit in (8,9,20,50)")
        SQL.NEW
        if Val(z4) > 0
           SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Dialogo.NrOperacion1~"' and NrBit=11")
        else
           SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Dialogo.NrOperacion1~"' and NrBit=13")
        endif
        SQL.NEW

        SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
        SQL.ADD(" (NrOperacion, Fecha, Tipo, Descripcion) Values ")
        SQL.ADD(" ('"~Dialogo.NrOperacion1~"', '"~IdxDate(FSYS)~"','MODEVENTO','"~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~" "~Hora(Ahora)~"') ")
        SQL.NEW
        SQL.EXEC
      endif
    endif     
  endif
endif
