* BAJNUM Baja de Numeradores
CrearDialogo
  Entero1 : 'Codigo'   ;;;;;;SQL("Select count(*) from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ")>0;'El Numerador es INEXISTENTE !!!';NO;
  String1 : 'Tipo'     ;;;;NO;;;;;;SQL("Select Tipo from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ");;;  
  Entero2 : 'Numero'   ;;;;NO;;;;;;SQL("Select Numero from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ");;;  
FinDialogo

if not Ok  
  Cancelar
endif

*- Verifico que en el Alias1 de Vehiculos No exista el Codigo
ACT(a1,SQL("Select Codigo from "~DBO~".VEHICULOS where Alias1 Like '"~Fstr(Dialogo.Entero1,0,0)~"%' "))

If Vacio(val(a1))
   SQL.ADD("DELETE "~DBO~".NUMERADORES Where  Codigo="~Fstr(Dialogo.Entero1,0,0)~" ")
   SQL.NEW
   SQL.EXEC
Else
   MessageBox('El Tipo de Numerador esta asignado al Vehiculo '~val(a1) )
EndIf


