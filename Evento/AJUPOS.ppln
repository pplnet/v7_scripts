Sqladd(" SELECT DISTINCT P.Especie, P.Cupon, P.Cliente, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
Sqladd(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin, P.Fecha, P.PrecioFinCon, P.PrecioHistCon, ")
Sqladd(" P.PrecioReset, P.PrecioResetCon, P.Estrategia, P.TipoPosicion ")
Sqladd(" FROM "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" WHERE P.Especie = E.Codigo ")
Sqladd(" AND   P.Cliente = V.Codigo ")
Sqladd(" AND   P.Vehiculo= V.Codigo ")
Sqladd(" AND   P.Fecha  <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   P.CantidadFin <> 0 ")
if (NoVacio(dialogo.especie1))
Sqladd(" AND   P.Especie = '"~dialogo.especie1~"'  ")
endif
Sqladd(" AND P.Book Not IN ("~Pipe2Comillas(&bvaluapartida)~") ")
if (dialogo.radio1 <> 1)
Sqladd(" AND   P.NrSaldo IN (122) ")
else
Sqladd(" AND   P.NrSaldo IN (121) ")
endif
Sqladd(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES P1 ")
Sqladd("                   WHERE P1.Especie   = P.Especie  ")
Sqladd("                   AND   P1.Vehiculo  = P.Vehiculo ")
Sqladd("                   AND   P1.Cliente   = P.Cliente  ")
Sqladd("                   AND   P1.NrSaldo   = P.NrSaldo  ")
Sqladd("                   AND   P1.Book      = P.Book     ")
Sqladd("                   and   IsNull(P.Unidad,'')       = IsNull(P1.Unidad,'') ")
Sqladd("                   and   IsNull(P.Centro,'')       = IsNull(P1.Centro,'') ")
Sqladd("                   and   IsNull(P.Sector,'')       = IsNull(P1.Sector,'') ")
Sqladd("                   and   IsNull(P.Sucursal,'')     = IsNull(P1.Sucursal,'') ")
Sqladd("                   and   IsNull(P.PrecioEj,0)      = IsNull(P1.PrecioEj,0) ")
Sqladd("                   and   IsNull(P.FechaEj,0)       = IsNull(P1.FechaEj,0) ")
Sqladd("                   and   IsNull(P.CallPut,'')      = IsNull(P1.CallPut,'') ")
Sqladd("                   and   IsNull(P.Estrategia,'')   = IsNull(P1.Estrategia,'') ")
Sqladd("                   and   IsNull(P.Cartera,'')      = IsNull(P1.Cartera,'') ")
Sqladd("                   and   IsNull(P.Trader,'')       = IsNull(P1.Trader,'') ")
Sqladd("                   and   IsNull(P.TipoNegocio,'')  = IsNull(P1.TipoNegocio,'') ")
Sqladd("                   and   IsNull(P.Cupon,'')        = IsNull(P1.Cupon,'') ")
Sqladd("                   and   IsNull(P.Responsable,'')  = IsNull(P1.Responsable,'') ")
Sqladd("                   and   IsNull(P.TipoPosicion,'') = IsNull(P1.TipoPosicion,'') ")
Sqladd("                   and   IsNull(P.Producto,'')     = IsNull(P1.Producto,'') ")
Sqladd("                   and   IsNull(P.GrupoEspecie,'') = IsNull(P1.GrupoEspecie,'') ")
Sqladd("                   AND   P1.Fecha     <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("                  ) ")
Sqladd(" ORDER BY P.Vehiculo, P.Book, P.NrSaldo, E.Tipo, P.Especie, P.Cupon, P.Estrategia, P.TipoPosicion ")

recorrer sql
Scn(y:1, 1)
Act(aa:fac, Fbn('Especie'))
Act(ab:fac, Fbn('Book'))
Acn(ac:fac, Fbn('NrSaldo'))
Acn(ad:fac, Fbn('Cupon'))
Acd(ae:fac, Fbn('Fecha'))
Act(af:fac, Fbn('Vehiculo'))
Act(ag:fac, Fbn('Cliente'))
Act(ai:fac, Fbn('Estrategia'))
Act(aj:fac, Fbn('TipoPosicion'))
Acn(ak:fac, Fbn('CantidadFin'))
Acn(al:fac, Fbn('PrecioHistCon'))
Acn(am:fac, 0)
Acn(an:fac, 0)
Acn(ao:fac, 0)
if (dialogo.radio1 = 2)
Acn(at:fac, 0)
else
Acn(at:fac, 1)
endif
if (dialogo.radio1 = 1)
Acn(au:fac, 0)
else
Acn(au:fac, 1)
endif
proximo

if (Val(y:1) = 0)
Messagebox('No hay posiciones para transferir')
if (dialogo.check1 = 1)
Cancelar()
endif
endif

if (Val(y:1) > 0)
crearlistbox;'Arial,8,';Val(di:1)
'Conf';ao:2..ao:fac;;;;40;check;RGB(160, 160, 193)
'Vehiculo';af:2..af:fac;NO;;;70;string;;
'Cliente';ag:2..ag:fac;NO;;;70;string;;
'Especie ';aa:2..aa:fac;NO;;;70;string;;
'Cupon';ad:2..ad:fac;NO;;;70;string;;
'Book';ab:2..ab:fac;NO;;;80;string;;
'Cuenta';ai:2..ai:fac;NO;;;100;string;;
'Tipo Gar';aj:2..aj:fac;NO;;;70;string;;
'Posicion';ak:2..ak:fac;NO;;;100;numero;'###,###,###,###.##'
'Precio';al:2..al:fac;NO;;;100;numero;'###.########'
'Posicion real';am:2..am:fac;SI;;;100;numero;'###,###,###,###.##';RGB(160, 160, 193)
'Ajuste a Realizar';an:2..an:fac;NO;Val(ao:flb) = 0 o Val(an:flb) <> 0;'Cantidad a ajustar invalida. (Fila '~FStr(flb - 1, 1, 0)~')';100;numero;'###,###,###,###.##';;iif (Val(ao:flb) = 1, Val(am:flb) - Val(ak:flb), 0)
finlistbox
if (not ok)
Cancelar('Evento Cancelado')
endif

Acn(y:2, Sum(ao:2..ao:fac))
if (Val(y:2) = 0)
Messagebox('No se selecciono ninguna fila para realizar pasaje de posicion')
else
recorrer&i 2, Val(y:1) + 1
if (Val(ao:&i) = 1)
Scn(y:3, 1)
Act(ar:&i, BuscarCampo('CUENTAS', 'Mercado', 'Codigo', Val(ai:&i)))
if (dialogo.check1 = 1)
Act(ap:&i, getnumerador(27))
Sqladd("INSERT INTO "~Dbo()~".TRANSACCIONES2 ( ")
Sqladd("   TipoTr2, NrTrans, Cliente1,  Fecha1, Especie, ")
Sqladd("   Cupon1,  Book1,   Cantidad1, Precio1, ")
Sqladd("   Cantidad2, Cantidad3, Vehiculo1, ")
Sqladd("   Cuenta1, ConceptoPago, Mercado1, ")
Sqladd("   CB1, CB2, ")
Sqladd("   FechaCarga, FechaCargaSys, UsrInput ")
Sqladd(" ) VALUES( ")
Sqladd("   'TRAJUP', ")
Sqladd("   '"~Val(ap:&i)~"', ")
Sqladd("   '"~Val(ag:&i)~"', ")
Sqladd("   '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("   '"~Val(aa:&i)~"', ")

Sqladd("   "~FStr(Val(ad:&i), 1, 0)~", ")
Sqladd("   '"~Val(ab:&i)~"', ")
Sqladd("   "~FStr(Val(ak:&i), 1, 2)~",")
Sqladd("   "~FStr(Val(al:&i), 1, 8)~", ")

Sqladd("   "~FStr(Val(am:&i), 1, 2)~",")
Sqladd("   "~FStr(Val(an:&i), 1, 2)~",")
Sqladd("   '"~Val(af:&i)~"', ")

Sqladd("   '"~Val(ai:&i)~"', ")
Sqladd("   '"~Val(aj:&i)~"', ")
Sqladd("   '"~Val(ar:&i)~"', ")

Sqladd("   "~FStr(Val(at:&i), 1, 0)~",")
Sqladd("   "~FStr(Val(au:&i), 1, 0)~",")

Sqladd(" "~SQLAhora()~","~IdxDate2(FSys())~", '"~UsuarioActivo()~"') ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientost2(Val(ap:&i), NO, NO, NO, SI)
Sqlexec()

Ejecutarevento('INBIT2', 'string1', 'TRANSACCIONES2', 'entero1', 70, 'nroperacion1', Val(ap:&i))
endif
endif
proximo
if (Val(y:3) = 1)
Messagebox('Se realizo '~FStr(Val(y:3), 1, 0)~' passaje de posicion')
else
Messagebox('Se realizaron '~FStr(Val(y:3), 1, 0)~' pasajes de posicion')
endif
endif
