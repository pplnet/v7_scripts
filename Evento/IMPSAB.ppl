HojaVisible(SI)
MostrarCuadroDeMensajes

CrearDialogo
    Fecha1:  'Fecha Saldos'        ;1;1;1;SI;SI;EsHabil(Dialogo.Fecha1,'ARG');'Dia no habil';SI;Habiles(FSYS,-1,'ARG')
    Directorio1:    'Path '        ;2;1;1;SI;SI;;;;Var('PATHDN')
    String1:    'Archivo '         ;3;1;1;SI;SI;;;;Var('FILEDN')
FinDialogo

If not ok
    Cancelar
Endif

(.'VALIDPATH'.)

*** Corregir path
let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

ACT(C:1,'Informe de errores de Importacion de Saldos Bancarios')
SetFont(C:1,1)
ACT(A:3, 'Fecha: '~Dialogo.Fecha1)
SetFont(A:3,2)

ImportarXLS(G:4..I:10000,ZX:4..ZZ:100000, &pf)
If Not Ok
    Cancelar('Error al cargar el archivo'~&pf)
Endif

let &fecSaldos Fecha(Val(ZZ:4))

**-Validación de la fecha--**
If &fecSaldos <> Dialogo.Fecha1
    Cancelar('Fecha Saldos('~Dialogo.Fecha1~') y fecha del XLS('~&fecSaldos~') son distintas')
Endif

SetFilaActual(4)
ACN(FA:1,fac)

Message('Procesando datos')
**------------------- BAJADA DE DATOS DE ARCHIVO A HOJA ---------------------------*
Recorrer&i 5,100000
            
If NoVacio(Val(ZX:&i))
    ACT(A:Val(FA:1),'Mensaje de Error')
    ifa
    SetFont(A:Val(FA:1),2)
    AgregarMarco(A:Val(FA:1)..F:Val(FA:1),1,1,Exe('COLOR'))
    
    let &ultFila fac
Endif
Proximo

ACT(A:&ultfila+2,'FIN DEL INFORME' )
SetFont(A:&ultfila+2,2)


LimitesVision(I:&ultfila+2)
Message('Insertando registros en la Base de Datos')


***------------------- PROCESAMIENTO DE DATOS A LA BASE ---------------------------*
SetFilaActual(5)

Recorrer&j 5, 100000
   
    If NoVacio(Val(ZX:&j))
    
        let &nombreCta BuscarCampo('CUENTAS','Nombre','Numero',Val(ZX:&j))
        let &bancoCta BuscarCampo('Clientes','Alias3','Codigo',BuscarCampo('Cuentas','Comitente','Numero',Val(ZX:&j)))

        let &insSaldo 0
        If SQL(" Select 1 from "~dbo~".CUENTAS Where Numero ='"~Val(ZX:&j)~"' ")<>1
            ACT(A:fac, 'No existe la cuenta Nr: '~Val(ZX:&j)~'  ')
            ColorCeldas(A:fac, clRED)
            ifa
        Else
            If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Habiles(Dialogo.Fecha1,-1,'ARG'))~"' and NrCuenta = '"~Val(ZX:&j)~"' and Estado <> 'ANU'  ")=1
                If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(ZX:&j)~"' and Estado <> 'ANU'  ")=1
                    ACT(A:fac, 'Ya existe saldo para la cuenta Nr: '~Val(ZX:&j)~' al '~Dialogo.Fecha1~' ')
                        ColorCeldas(A:fac, clRED)
                        ifa
                      Else
                         let &insSaldo 1
                      Endif
            Else
                IF SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo < '"~IdxDate(Habiles(Dialogo.Fecha1,-1,'ARG'))~"' and NrCuenta = '"~Val(ZX:&j)~"' and Estado <> 'ANU'  ")=1
                    ACT(A:fac, 'Faltan cargar saldos para días anteriores para la cuenta Nr: '~Val(ZX:&j)~' al '~Dialogo.Fecha1~' ')
                        ColorCeldas(A:fac, clRED)
                        ifa
                     Else
                        IF SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(ZX:&j)~"' and Estado <> 'ANU'  ")=1
                            ACT(A:fac, 'Ya existe saldo para la cuenta Nr: '~Val(ZX:&j)~' al '~Dialogo.Fecha1~' ')
                            ColorCeldas(A:fac, clRED)
                            ifa 
                        ELSE
                            IF  SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(ZX:&j)~"' and Estado <> 'ANU'  ")=1
                                ACT(A:fac, 'Existen saldos posteriores para la cuenta Nr: '~Val(ZX:&j)~' al '~Dialogo.Fecha1~' ')
                                ColorCeldas(A:fac, clRED)
                                ifa 
                            ELSE
                                let &insSaldo 1
                            ENDIF
                        ENDIF
                     Endif
            Endif
        Endif         
                 If &insSaldo = 1
                        ACD(DD:1,Fecha(PriDeMes(&fecSaldos,SI)))
                        let &contable 0
                        let &operativo 0
                        let &inicial 0
                        let &dias 0
                        ****-------------- Buscar saldos anteriores (del mismo mes) para calcular promedios --------******
                        If Val(DD:1) < &fecSaldos
                            SQL.ADD(" Select TOP 1 SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu from "~dbo~".SALDOSBANCARIOS ")
                            SQL.ADD(" where NrCuenta = '"~Val(ZX:&j)~"' and FechaSaldo < '"~IdxDate(&fecSaldos)~"' and  FechaSaldo >= '"~IdxDate(Val(DD:1))~"' and Estado <> 'ANU' ")
                            SQL.ADD(" Order by FechaSaldo DESC ")
                            Recorrer SQL
                                dfa
                                let &contable FBN['SaldoAcuCon']
                                let &operativo FBN['SaldoAcuOpe']
                                let &inicial FBN['SaldoAcuIni']
                                let &dias FBN['DiasAcu']
                                break
                            Proximo
                        Endif
                        
                        let &contable &contable+Val(ZY:&j)

                        let &inicial &inicial+Val(ZY:&j)

                        let &operativo &operativo+Val(ZY:&j)
                        
                        let &flag2 0

                        ***--------------- Insertar saldo de siguiente/s fecha/s no habil/es  --------***
                        Recorrer&k &fecSaldos, Habiles(&fecSaldos,+1,'ARG')-1
                            let &dias &dias+1
                            If &flag2=0 y Fecha(&k) > FinDeMes(&fecSaldos,SI)
                                ***---Cambio de Mes
                                let &dias 1
                                let &flag2 1 
                                let &operativo Val(ZY:&j)
                                let &contable Val(ZY:&j)
                                let &inicial Val(ZY:&j)
                            ELSE
                                IF &k > &fecSaldos
                                    ***---Los dias no hábiles sumo al acumulado el saldo del dia hábil anterior
                                    let &operativo &operativo + Val(ZY:&j)
                                    let &contable &contable + Val(ZY:&j)
                                    let &inicial &inicial + Val(ZY:&j)
                                ENDIF
                            Endif
                            let &SignoInicial IIF(Val(ZY:&j)>0,'C','D')
                            SQL.ADD(" INSERT INTO "~dbo~".SALDOSBANCARIOS ")
                            SQL.ADD(" (FechaSaldo, FechaBajada, FechaCarga, NrCuenta, Nombre, SaldoContable, ")
                            SQL.ADD(" SaldoInicio, SaldoOperativo, Proyectado24h, Proyectado48h, ")
                            SQL.ADD(" Estado, Banco, ")
                            SQL.ADD(" SaldoOpePromedio, SaldoConPromedio, Usuario, SaldoIniPromedio, ")
                            SQL.ADD(" SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, Ajuste, ")
                            SQL.ADD(" SignoInicial) ")
                            SQL.ADD(" Values('"~IdxDate(Fecha(&k))~"' , '"~IdxDate(FSYS)~"' , "~SQLAhora~" , '"~Val(ZX:&j)~"' , '"~Copy(&nombreCta,1,40)~"' , "~Fstr(Val(ZY:&j),1,2)~" , ")
                            SQL.ADD(" "~Fstr(Val(ZY:&j),1,2)~" , "~Fstr(Val(ZY:&j),1,2)~" , "~Fstr(Val(ZY:&j),1,2)~" , "~Fstr(Val(ZY:&j),1,2)~" , ")
                            SQL.ADD(" 'REC' , '"~&bancoCta~"' , ")
                            SQL.ADD(" "~Fstr(&operativo/&dias,1,2)~" , "~Fstr(&contable/&dias,1,2)~" , '"~UsuarioActivo~"' , "~Fstr(&inicial/&dias,1,2)~" , ")
                            SQL.ADD(" "~Fstr(&contable,1,2)~", "~Fstr(&operativo,1,2)~", "~Fstr(&inicial,1,2)~", "~Fstr(&dias,1,0)~", 0,  ")
                            SQL.ADD(" '"~&SignoInicial~"') ")
                            SQL.NEW
                            SQL.EXEC
                        Proximo  
                 Endif    
    Else
        break
    Endif  
Proximo
