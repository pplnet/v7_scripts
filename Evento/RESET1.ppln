creardialogo
fecha1: 'Fecha';;;;;;dialogo.fecha1 <= FSys();'Fecha No debe ser superior a la Fecha del Sistema';NO;FSys()
especie1: 'Especie';;;;;;;;;
check1: 'Procesa';;;;SI;;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Act(y1, 'Fin de Mes')
Act(y2, 'OK')
Act(y4, 'Mes Inicio')
Act(y5, 'Mes Cierre')

Acd(z:1, FinDeMes(dialogo.fecha1, NO, 'ARG'))

Act(z:2, 'SI')
if (Val(z:1) <> dialogo.fecha1)
Messagebox('La fecha indicada no es fin de mes')
Act(z:2, 'NO')
endif

if (Eqstr(Val(z:2), 'SI'))
Acn(z:4, 0)
Acn(z:4, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo='MESINIEJE' "))
if (Val(z:4) = 0)
Acn(z:5, 12)
else
Acn(z:5, Var('MESINIEJE') - 1)
endif
if (Val(z:5) < 1 o Val(z:5) > 12)
Acn(z:5, 12)
endif
if (Mes(dialogo.fecha1) <> Val(z:5))
Messagebox('La fecha indicada no es fin de Ejercicio')
Act(z:2, 'NO')
endif
endif

if (Eqstr(Val(z:2), 'NO'))
Cancelar('No es posible Resetear Posicion en esta Fecha: '~dialogo.fecha1)
endif

if (dialogo.check1 = 1)
Sqladd("Delete "~Dbo()~".POSICIONES ")
Sqladd(" where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and PrecioEj = 0 ")
Sqladd("   and Cantidad1 = 0 ")
Sqladd("   and Cantidad2 = 0 ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
Sqlnew()
Sqlexec()
endif

SetFilaActual(1)
Act(a:fac, 'Orden')
Act(b:fac, 'Fecha')
Act(c:fac, 'Cliente')
Act(d:fac, 'Vehiculo')
Act(e:fac, 'NrSaldo')
Act(f:fac, 'Especie')
Act(g:fac, 'Cupon')
Act(h:fac, 'Book')
Act(i:fac, 'TipoNegocio')
Act(j:fac, 'CantidadIni')
Act(k:fac, 'PrecioIni')
Act(l:fac, 'CantidadFin')
Act(m:fac, 'PrecioFin')
Act(n:fac, 'PrecioHist')
Act(o:fac, 'PrecioReset')
Act(p:fac, 'Accion')
Act(q:fac, 'CantReg')
Act(r:fac, 'PrecioMer')
SetFont(a:fac..x:fac, 2)

Sqladd("Select '1' Orden, P.* ")
Sqladd("  From "~Dbo()~".POSICIONES P ")
Sqladd(" Where P.TipoNegocio  = 'SEC' ")
Sqladd("   and P.CantidadFin  <> 0 ")
Sqladd("   and P.NrSaldo in (120,130) ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
Sqladd("   and P.Fecha = (Select MAX(P1.Fecha) ")
Sqladd("                    From "~Dbo()~".POSICIONES P1 ")
Sqladd("                   Where P1.Vehiculo    = P.Vehiculo ")
Sqladd("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
Sqladd("                     and P1.TipoNegocio = P.TipoNegocio ")
Sqladd("                     and P1.Cliente     = P.Cliente ")
Sqladd("                     and P1.Especie     = P.Especie ")
Sqladd("                     and IsNull(P1.Cupon,'') = IsNull(P.Cupon,'') ")
Sqladd("                     and P1.NrSaldo     = P.NrSaldo ")
Sqladd("                     and P1.Fecha       <= '"~IdxDate(dialogo.fecha1)~"') ")

Sqladd("Union all ")

Sqladd("Select '2' Orden, P.* ")
Sqladd("  From "~Dbo()~".POSICIONES P ")
Sqladd(" Where P.TipoNegocio  = 'FC' ")
Sqladd("   and P.CantidadFin  <> 0 ")
Sqladd("   and P.NrSaldo in (121,131) ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
Sqladd("   and P.Fecha = (Select MAX(P1.Fecha) ")
Sqladd("                    From "~Dbo()~".POSICIONES P1 ")
Sqladd("                   Where P1.Vehiculo    = P.Vehiculo ")
Sqladd("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
Sqladd("                     and P1.TipoNegocio = P.TipoNegocio ")
Sqladd("                     and P1.Cliente     = P.Cliente ")
Sqladd("                     and P1.Especie     = P.Especie ")
Sqladd("                     and IsNull(P1.Cupon,'') = IsNull(P.Cupon,'') ")
Sqladd("                     and P1.NrSaldo     = P.NrSaldo ")
Sqladd("                     and P1.Fecha       <= '"~IdxDate(dialogo.fecha1)~"') ")

Sqladd("Union all ")

Sqladd("Select '3' Orden, P.* ")
Sqladd("  From "~Dbo()~".POSICIONES P ")
Sqladd(" Where P.TipoNegocio  = 'FXS' ")
Sqladd("   and P.CantidadFin  <> 0 ")
Sqladd("   and P.NrSaldo in (122,132) ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
Sqladd("   and P.Fecha = (Select MAX(P1.Fecha) ")
Sqladd("                    From "~Dbo()~".POSICIONES P1 ")
Sqladd("                   Where P1.Vehiculo    = P.Vehiculo ")
Sqladd("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
Sqladd("                     and P1.TipoNegocio = P.TipoNegocio ")
Sqladd("                     and P1.Cliente     = P.Cliente ")
Sqladd("                     and P1.Especie     = P.Especie ")
Sqladd("                     and IsNull(P1.Cupon,'') = IsNull(P.Cupon,'') ")
Sqladd("                     and P1.NrSaldo     = P.NrSaldo ")
Sqladd("                     and P1.Fecha       <= '"~IdxDate(dialogo.fecha1)~"') ")

Sqladd("ORDER BY Orden, P.Especie, P.Cupon, P.Vehiculo, P.NrSaldo, P.Book ")

recorrer sql
Act(a:fac, Fbn('Orden'))
Acd(b:fac, Fbn('Fecha'))
Act(c:fac, Fbn('Cliente'))
Act(d:fac, Fbn('Vehiculo'))
Acn(e:fac, Fbn('NrSaldo'))
Act(f:fac, Fbn('Especie'))
Act(g:fac, Fbn('Cupon'))
Act(h:fac, Fbn('Book'))
Act(i:fac, Fbn('TipoNegocio'))
Acn(j:fac, Fbn('CantidadIni'))
Acn(k:fac, Fbn('PrecioIni'))
Acn(l:fac, Fbn('CantidadFin'))
Acn(m:fac, Fbn('PrecioFin'))
Acn(n:fac, Fbn('PrecioHist'))
Acn(o:fac, Fbn('PrecioReset'))

if (Fbn()['Fecha'] = dialogo.fecha1)
Act(p:fac, 'Update')
Sqladd("Select Count(*) as CantReg from "~Dbo()~".POSICIONES ")
Sqladd(" where Fecha                 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Cliente               = '"~Fbn()['Cliente']~"' ")
Sqladd("   and Vehiculo              = '"~Fbn()['Vehiculo']~"' ")
Sqladd("   and IsNull(Unidad,'')     = '"~Fbn()['Unidad']~"' ")
Sqladd("   and IsNull(Centro,'')     = '"~Fbn()['Centro']~"' ")
Sqladd("   and IsNull(Sector,'')     = '"~Fbn()['Sector']~"' ")
Sqladd("   and IsNull(Sucursal,'')   = '"~Fbn()['Sucursal']~"' ")
Sqladd("   and NrSaldo               = "~FStr(Fbn()['NrSaldo'], 0, 0)~" ")
Sqladd("   and Especie               = '"~Fbn()['Especie']~"' ")
if (NoVacio(Fbn()['PrecioEj']))
Sqladd("and PrecioEj              = "~Fbn()['PrecioEj']~" ")
endif
if (NoVacio(Fbn()['FechaEj']))
Sqladd("and FechaEj               = '"~IdxDate(Fbn()['FechaEj'])~"' ")
endif
Sqladd("   and IsNull(CallPut,'')    = '"~Fbn()['CallPut']~"' ")
Sqladd("   and IsNull(Estrategia,'') = '"~Fbn()['Estrategia']~"' ")
Sqladd("   and IsNull(Cartera,'')    = '"~Fbn()['Cartera']~"' ")
Sqladd("   and IsNull(Book,'')       = '"~Fbn()['Book']~"' ")
Sqladd("   and IsNull(Trader,'')     = '"~Fbn()['Trader']~"' ")
Sqladd("   and TipoNegocio           = '"~Fbn()['TipoNegocio']~"' ")
Sqladd("   and IsNull(Cupon,'')      = '"~Fbn()['Cupon']~"' ")
recorrer sql
Dfa()
Acn(q:fac, Fbn()['CantReg'])
proximo
else
Act(p:fac, 'Insert')
endif

if (Eqstr(Fbn('Orden'), '1'))
if (Fbn('Nrsaldo') = 120)
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'ARP'))
else
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'USD'))
endif
endif
if (Eqstr(Fbn('Orden'), '2'))
if (Fbn('Nrsaldo') = 121)
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'ARP'))
else
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'USD'))
endif
endif
if (Eqstr(Fbn('Orden'), '3'))
if (Fbn('Nrsaldo') = 122)
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'ARP'))
else
Acn(r:fac, CotizacionC(Fbn('Especie'), null, null, null, dialogo.fecha1, 1, SI, 'USD'))
endif
endif

if (dialogo.check1 = 1)
if (Fbn()['Fecha'] = dialogo.fecha1)
Sqladd("UPDATE "~Dbo()~".POSICIONES ")
Sqladd("   Set PrecioReset = "~FStr(Val(r:fac), 0, 10)~" ")
Sqladd(" where Fecha                 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Cliente               = '"~Fbn()['Cliente']~"' ")
Sqladd("   and Vehiculo              = '"~Fbn()['Vehiculo']~"' ")
Sqladd("   and IsNull(Unidad,'')     = '"~Fbn()['Unidad']~"' ")
Sqladd("   and IsNull(Centro,'')     = '"~Fbn()['Centro']~"' ")
Sqladd("   and IsNull(Sector,'')     = '"~Fbn()['Sector']~"' ")
Sqladd("   and IsNull(Sucursal,'')   = '"~Fbn()['Sucursal']~"' ")
Sqladd("   and NrSaldo               = "~FStr(Fbn()['NrSaldo'], 0, 0)~" ")
Sqladd("   and Especie               = '"~Fbn()['Especie']~"' ")
if (NoVacio(Fbn()['PrecioEj']))
Sqladd("and PrecioEj              = "~Fbn()['PrecioEj']~" ")
endif
if (NoVacio(Fbn()['FechaEj']))
Sqladd("and FechaEj               = '"~IdxDate(Fbn()['FechaEj'])~"' ")
endif
Sqladd("   and IsNull(CallPut,'')    = '"~Fbn()['CallPut']~"' ")
Sqladd("   and IsNull(Estrategia,'') = '"~Fbn()['Estrategia']~"' ")
Sqladd("   and IsNull(Cartera,'')    = '"~Fbn()['Cartera']~"' ")
Sqladd("   and IsNull(Book,'')       = '"~Fbn()['Book']~"' ")
Sqladd("   and IsNull(Trader,'')     = '"~Fbn()['Trader']~"' ")
Sqladd("   and TipoNegocio           = '"~Fbn()['TipoNegocio']~"' ")
Sqladd("   and IsNull(Cupon,'')      = '"~Fbn()['Cupon']~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT "~Dbo()~".POSICIONES ( ")
Sqladd("Fecha,        Cliente,     Vehiculo,  Unidad,    Centro, ")
Sqladd("Sector,       Sucursal,    NrSaldo,   Especie,   PrecioEj, ")
Sqladd("FechaEj,      CallPut,     Precio1,   Precio2,   ValorUSD, ")
Sqladd("ValorARP,     Estrategia,  Cartera,   Book,      Trader, ")
Sqladd("TipoNegocio,  Cantidad1,   Cantidad2, Cantidad3, Cantidad4, ")
Sqladd("Cantidad5,    Precio3,     Precio4,   Precio5,   CantidadIni, ")
Sqladd("PrecioIni,    CantidadFin, PrecioFin, Cupon,     PrecioReset, ")
Sqladd("PrecioHist   ")
Sqladd(") Values ( ")
Sqladd("  '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("  '"~Fbn()['Cliente']~"', ")
Sqladd("  '"~Fbn()['Vehiculo']~"', ")
Sqladd("  '"~Fbn()['Unidad']~"', ")
Sqladd("  '"~Fbn()['Centro']~"', ")

Sqladd("  '"~Fbn()['Sector']~"', ")
Sqladd("  '"~Fbn()['Sucursal']~"', ")
Sqladd("  "~FStr(Fbn()['NrSaldo'], 0, 0)~", ")
Sqladd("  '"~Fbn()['Especie']~"', ")
if (Fbn()['PrecioEj'] = 0)
Sqladd(" NULL, ")
else
Sqladd(" "~FStr(Fbn()['PrecioEj'], 15, 8)~", ")
endif

if (Vacio(Fbn()['FechaEj']))
Sqladd(" NULL, ")
else
Sqladd(" '"~IdxDate(Fbn('FechaEj'))~"', ")
endif
Sqladd("  '"~Fbn()['CallPut']~"', ")
Sqladd("  "~FStr(0, 0, 10)~", ")
Sqladd("  "~FStr(0, 0, 10)~", ")
if (Fbn()['ValorUSD'] = 0)
Sqladd(" NULL, ")
else
Sqladd(" "~FStr(Fbn()['ValorUSD'], 0, 10)~", ")
endif

if (Fbn()['ValorARP'] = 0)
Sqladd(" NULL, ")
else
Sqladd(" "~FStr(Fbn()['ValorARP'], 0, 10)~", ")
endif
Sqladd("  '"~Fbn()['Estrategia']~"', ")
Sqladd("  '"~Fbn()['Cartera']~"', ")
Sqladd("  '"~Fbn()['Book']~"', ")
Sqladd("  '"~Fbn()['Trader']~"', ")

Sqladd("  '"~Fbn()['TipoNegocio']~"', ")
Sqladd("  "~FStr(0, 0, 2)~", ")
Sqladd("  "~FStr(0, 0, 2)~", ")
Sqladd("  "~FStr(0, 0, 2)~", ")
Sqladd("  "~FStr(0, 0, 2)~", ")

Sqladd("  "~FStr(0, 0, 2)~", ")
Sqladd("  "~FStr(0, 0, 10)~", ")
Sqladd("  "~FStr(0, 0, 10)~", ")
Sqladd("  "~FStr(0, 0, 10)~", ")
Sqladd("  "~FStr(Fbn()['CantidadFin'], 0, 10)~", ")

Sqladd("  "~FStr(Fbn()['PrecioFin'], 0, 10)~", ")
Sqladd("  "~FStr(Fbn()['CantidadFin'], 0, 10)~", ")
Sqladd("  "~FStr(Val(r:fac), 0, 10)~", ")
if (Vacio(Fbn()['Cupon']))
Sqladd("  Null, ")
else
Sqladd("  '"~Fbn()['Cupon']~"', ")
endif
Sqladd("  "~FStr(Val(r:fac), 0, 10)~", ")

Sqladd("  "~FStr(Fbn()['PrecioHist'], 0, 10)~" ")

Sqladd(" ) ")
Sqlnew()
Sqlexec()
endif

Sqladd("EXEC "~Dbo()~".RecalculaPosiciones ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd(" '"~Fbn()['Cliente']~"', ")
Sqladd(" '"~Fbn()['Vehiculo']~"', ")
Sqladd(" '"~Fbn()['Unidad']~"', ")

Sqladd(" '"~Fbn()['Centro']~"', ")
Sqladd(" '"~Fbn()['Sector']~"', ")
Sqladd(" '"~Fbn()['Sucursal']~"', ")
Sqladd(" "~FStr(Fbn()['NrSaldo'], 3, 0)~", ")

Sqladd(" '"~Fbn()['Especie']~"', ")
if (Fbn()['PrecioEj'] = 0)
Sqladd(" NULL,")
else
Sqladd(" "~FStr(Fbn()['PrecioEj'], 15, 8)~", ")
endif
if (Vacio(Fbn()['FechaEj']))
Sqladd(" NULL,")
else
Sqladd(" "~IdxDate2(Fbn()['FechaEj'])~", ")
endif
Sqladd(" '"~Fbn()['CallPut']~"', ")

Sqladd(" '"~Fbn()['Cupon']~"', ")
Sqladd(" '"~Fbn()['Estrategia']~"', ")
Sqladd(" '"~Fbn()['Cartera']~"', ")
Sqladd(" '"~Fbn()['Book']~"', ")

Sqladd(" '"~Fbn()['Trader']~"', ")
Sqladd(" '"~Fbn()['TipoNegocio']~"' ")
Sqlnew()
Sqlexec()
endif

proximo

if (Fac() > 1)
SetFont(y:1..z:6, 1)
SetFont(a:2..x:fac, 1)
FormatoCeldas(e:2..e:fac, Exe('F0'))
FormatoCeldas(j:2..j:fac, Exe('F2'))
FormatoCeldas(k:2..k:fac, Exe('F8'))
FormatoCeldas(l:2..l:fac, Exe('F2'))
FormatoCeldas(m:2..r:fac, Exe('F8'))
endif

if (Vacio(dialogo.especie1))
Ejecutarevento('RESET2', 'fecha1', dialogo.fecha1, 'check1', dialogo.check1)
