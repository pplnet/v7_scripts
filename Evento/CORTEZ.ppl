MostrarCuadroDeMEnsajes
CrearDialogo
   Especie1: 'Especie';1;1;1;;;NOVACIO(Dialogo.Especie1);'Especie Invalida';NO;
   Entero1 : 'Cupon'  ;2;1;1;;;;;;;iif(novacio(Dialogo.Especie1),bUSCARcampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)-1)
   Fecha1  : 'Fecha'  ;;;;;;
FinDialogo

If not OK
   Cancelar
Endif

SQL.ADD(" SELECT NrTrans, Cambio2, Fecha1, Fecha3, Especie2 FROM "~DBO~".TRANSACCIONES2    ")
SQL.ADD(" WHERE Especie = '"~Dialogo.Especie1~"'        ")
SQL.ADD(" AND   Cupon1  = "~fstr(Dialogo.Entero1,0,0)~" ")
SQL.ADD(" AND   TipoTr2 = 'ACUPON' ")
If Dialogo.Fecha1<>0
   SQL.ADD(" AND Fecha3 = "~idxdate2(Dialogo.Fecha1)~" ")
Endif

Recorrer SQL
   message('Cancelando ACUPON -> '~fbn('NrTrans'))

   * Cupon cortado
   ACN(c:2, Dialogo.Entero1)
   * Fecha de corte -1
   ACD(fr:1, Habiles(fbn('Fecha1'),-1,'ARG') )
   * VT Actual
   ACN(c:3, fbn('Cambio2'))

   SQL.ADD("DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~fbn('NrTrans')~"' ")
   SQL.NEW
   SQL.ADD("DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~fbn('NrTrans')~"' ")
   SQL.NEW
   SQL.ADD("DELETE FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion = '"~fbn('NrTrans')~"' ")
   SQL.NEW
   SQL.ADD("DELETE FROM "~DBO~".TRANSACCIONES2  WHERE NrTrans     = '"~fbn('NrTrans')~"' ")
   SQL.NEW
   ** Borra Cotizacion Cupon
   SQL.ADD(" Delete "~DBO~".COTIZACIONES ")
   SQL.ADD(" Where Fecha = '"~IdxDate(fbn('Fecha3'))~"' ")
   SQL.ADD(" AND Codigo = '"~fbn('Especie2')~"' ")
   SQL.ADD(" AND CallPut = 'CON' ")
   SQL.NEW
   SQL.EXEC   
Proximo


If Val(c:3)<=0 
   * Cuando amortiza 100% restea precio de posicion
   ACT(er:1, Dialogo.Especie1)
   ACN(cr:2, 0)
   ACN(cr:1, 0)
   (.'CUPONRESET'.)
Endif

