Act(x:3, Hora(Ahora()))
Act(x:2, Var('PATHAS400')~'CA'~Fecha(dialogo.fecha1, 'DDMMYY')~'.txt')
cerrarascii
borrararchivo(Val(x:2))

sql.add("Select 'A' as TipoMov, O.NrOperacion, O.TipoOp, O.ContraEspecie, O.Especie, O.ValorRB1, O.Cantidad, O.Precio4, O.Precio3, O.Precio1, O.NroAltaMAE, O.FechaCarga,  ")
sql.add(" C.Alias3, O.FechaOp, O.FechaPrecan, O.FechaPago, O.FechaVto, O.Cliente3, C.Codigo, C.CodigoBCRA, O.TotalBrutoCli1, O.TipoCambio, IsNull(O.Puesto,'0') Puesto, U.Alias2, O.Cartera  ")
sql.add("from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".USUARIOS U   ")
sql.add("Where FechaCargaSys= "~IdxDate2(dialogo.fecha1)~"   and              ")
sql.add(" O.TipoOp in ('FXC','FXV','FXVF','FXCF','FXA','FXAT') and            ")
sql.add(" O.Cliente1 = C.Codigo                              and              ")
sql.add(" O.Operador = U.Codigo                                               ")
sql.add("union                                                                ")
sql.add("Select 'B' as TipoMov, BO.NrOperacion, BO.TipoOp, BO.ContraEspecie, BO.Especie, BO.ValorRB1, BO.Cantidad, BO.Precio4, BO.Precio3, BO.Precio1, BO.NroAltaMAE, BO.FechaCarga, ")
sql.add("C.Alias3, BO.FechaOp, BO.FechaPrecan, BO.FechaPago, BO.FechaVto, BO.Cliente3, C.Codigo, C.CodigoBCRA, BO.TotalBrutoCli1, BO.TipoCambio, IsNull(BO.Puesto,'0') Puesto, U.Alias2, BO.Cartera ")
sql.add("from "~Dbo()~".BOPERACIONES BO, "~Dbo()~".CLIENTES C, "~Dbo()~".USUARIOS U ")
sql.add("Where BO.FechaCargaSys < "~IdxDate2(dialogo.fecha1)~"  and           ")
sql.add(" BO.FechaDel = "~IdxDate2(dialogo.fecha1)~"            and           ")
sql.add(" BO.TipoOp in ('FXC','FXV','FXVF','FXCF','FXA','FXAT') and           ")
sql.add(" BO.Cliente1 = C.Codigo                                and           ")
sql.add(" BO.Operador = U.Codigo                                              ")

recorrer sql
Message(Fbn('NrOperacion'))
Scn(x:1, 1)
if (Incluido(Fbn('TipoMov'), 'A'))
Act(a1, 'A')
else
Act(a1, 'B')
endif
Act(a1, Val(a1)~Pad(Fbn('NrOperacion'), 10))
if (Incluido(Fbn('TipoOp'), 'FXV'))
Act(a1, Val(a1)~'FXV ')
endif
if (Incluido(Fbn('TipoOp'), 'FXC'))
Act(a1, Val(a1)~'FXC ')
endif
if (Incluido(Fbn('TipoOp'), 'FXCF'))
Act(a1, Val(a1)~'FXCF')
endif
if (Incluido(Fbn('TipoOp'), 'FXVF'))
Act(a1, Val(a1)~'FXVF')
endif
if (Incluido(Fbn('TipoOp'), 'FXA'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
Act(a1, Val(a1)~'FXC ')
else
Act(a1, Val(a1)~'FXV ')
endif
endif
if (Incluido(Fbn('TipoOp'), 'FXAT'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
Act(a1, Val(a1)~'FXCF')
else
Act(a1, Val(a1)~'FXVF')
endif
endif
if (Incluido(Fbn('TipoOp'), 'FXA|FXAT'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
Act(a1, Val(a1)~Pad(Copy(Fbn('Especie'), 1, 3), 3))
else
Act(a1, Val(a1)~Pad(Copy(Fbn('ContraEspecie'), 1, 3), 3))
endif
else
Act(a1, Val(a1)~Pad(Copy(Fbn('Especie'), 1, 3), 3))
endif

if (NoVacio(Fbn('Alias3')))
Act(a1, Val(a1)~Copy(Pad0(Fbn('Alias3'), 9), 1, 9))
else
Act(a1, Val(a1)~Copy(Pad0('0', 9), 1, 9))
endif

Act(a1, Val(a1)~Fecha(Fbn('FechaOp'), 'yyyymmdd'))
if (Incluido(Fbn('TipoOp'), 'FXA|FXFA'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
if (NoVacio(Fbn('FechaPrecan')))
Act(a1, Val(a1)~Fecha(Fbn('FechaPrecan'), 'yyyymmdd'))
else
Act(a1, Val(a1)~'00000000')
endif
Act(a1, Val(a1)~Fecha(Fbn('FechaPago'), 'yyyymmdd'))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Cantidad') * 100, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Precio1') * 1000000000, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('TotalBrutoCli1') * 100, 1, 0), 15), 1, 15))
else
Act(a1, Val(a1)~Fecha(Fbn('FechaPago'), 'yyyymmdd'))
if (NoVacio(Fbn('FechaPrecan')))
Act(a1, Val(a1)~Fecha(Fbn('FechaPrecan'), 'yyyymmdd'))
else
Act(a1, Val(a1)~'00000000')
endif
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('TotalBrutoCli1') * 100, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Precio1') * 1000000000, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Cantidad') * 100, 1, 0), 15), 1, 15))
endif
else
if (NoVacio(Fbn('FechaPrecan')))
Act(a1, Val(a1)~Fecha(Fbn('FechaPrecan'), 'yyyymmdd'))
else
Act(a1, Val(a1)~'00000000')
endif
Act(a1, Val(a1)~Fecha(Fbn('FechaPago'), 'yyyymmdd'))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Cantidad') * 100, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Precio1') * 1000000000, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('TotalBrutoCli1') * 100, 1, 0), 15), 1, 15))
endif
Act(a1, Val(a1)~'080')
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('TipoCambio') * 1000000000, 1, 0), 15), 1, 15))
Act(a1, Val(a1)~'0')
if (NoVacio(Fbn('Cliente3')) y NoVacio(Fbn('Alias3')))
Act(a1, Val(a1)~Pad(Copy(Fbn('Alias3'), 1, 5), 5))
else
Act(a1, Val(a1)~Copy(Pad0('0', 5), 1, 5))
endif

Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('Precio3') * 100000, 1, 0), 9), 1, 9))
Act(a1, Val(a1)~Copy(Pad0('0', 5), 1, 5))
Act(a1, Val(a1)~'1')
if (NoVacio(Fbn('Codigo')))
if (DesciendeDeCliente(Fbn('Codigo'), 'BANCOS'))
Act(a1, Val(a1)~'1')
else
Act(a1, Val(a1)~'2')
endif
else
Act(a1, Val(a1)~'0')
endif
if (Incluido(Fbn('TipoOp'), 'FXC|FXCF'))
Act(a1, Val(a1)~'1')
endif
if (Incluido(Fbn('TipoOp'), 'FXV|FXVF'))
Act(a1, Val(a1)~'2')
endif
if (Incluido(Fbn('TipoOp'), 'FXA|FXAT'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
Act(a1, Val(a1)~'1')
else
Act(a1, Val(a1)~'2')
endif
endif
if (Incluido(Fbn('TipoOp'), 'FXC|FXV|FXA'))
Act(a1, Val(a1)~'1')
endif
if (Incluido(Fbn('TipoOp'), 'FXCF|FXVF|FXAT'))
Act(a1, Val(a1)~'2')
endif
if (Incluido(Fbn('ValorRB1'), '0'))
Act(a1, Val(a1)~'2')
else
if (Incluido(Fbn('ValorRB1'), '1'))
Act(a1, Val(a1)~'1')
else
if (Incluido(Fbn('ValorRB1'), '2'))
Act(a1, Val(a1)~'3')
else
Act(a1, Val(a1)~'4')
endif
endif
endif
if (Incluido(Fbn('Especie'), Var('ESPBILLETE')))
Act(a1, Val(a1)~'2')
else
Act(a1, Val(a1)~'2')
endif
if (Incluido(Fbn('Puesto'), '0'))
Act(a1, Val(a1)~'0')
endif
if (Incluido(Fbn('Puesto'), '1'))
Act(a1, Val(a1)~'1')
endif
if (Incluido(Fbn('TipoOp'), 'FXA|FXAT'))
Act(a1, Val(a1)~'3')
else
Act(a1, Val(a1)~'2')
endif
Act(a1, Val(a1)~Pad('', 10))
Act(a1, Val(a1)~Pad('', 10))
Act(a1, Val(a1)~Copy(Pad0('0', 3), 1, 3))
Act(a1, Val(a1)~'0')
if (NoVacio(Fbn('Alias2')))
Act(a1, Val(a1)~Pad(Copy(Fbn('Alias2'), 1, 8), 8))
else
Act(a1, Val(a1)~Pad('', 8))
endif
if (not Incluido(Fbn('NroAltaMAE'), '0'))
Act(a1, Val(a1)~Pad0(Fbn('NroAltaMAE'), 10))
else
Act(a1, Val(a1)~Pad0('0', 10))
endif
if (Incluido(Fbn('TipoOp'), 'FXA|FXAT'))
if (Eqstr(Fbn('ContraEspecie'), 'USD'))
Act(a1, Val(a1)~Pad(Copy(Fbn('ContraEspecie'), 1, 3), 3))
else
Act(a1, Val(a1)~Pad(Copy(Fbn('Especie'), 1, 3), 3))
endif
else
Act(a1, Val(a1)~Pad(Copy(Fbn('ContraEspecie'), 1, 3), 3))
endif
if (Incluido(Fbn('TipoOp'), 'FXCF|FXVF|FXAT'))
Act(a1, Val(a1)~Fecha(Fbn('FechaVto'), 'yyyymmdd'))
else
Act(a1, Val(a1)~Fecha(Fbn('FechaOp'), 'yyyymmdd'))
endif
Act(a1, Val(a1)~' ')
if (NoVacio(Fbn('CodigoBCRA')))
Act(a1, Val(a1)~Copy(Pad0(FStr(Fbn('CodigoBCRA'), 1, 0), 5), 1, 5))
else
Act(a1, Val(a1)~'00000')
endif
if (Eqstr(Fbn('Codigo'), Var('VEHICULODE')))
Act(a1, Val(a1)~'S')
else
Act(a1, Val(a1)~' ')
endif
Act(a1, Val(a1)~Hora(Fbn('FechaCarga')))

abrirascii(Val(x:2), 0)
escribirascii(Val(a:1))
cerrarascii
proximo
