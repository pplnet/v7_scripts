**---MMCEMV: Cesion de Capital Multiple Vencimiento
* HOJAVISIBLE(SI)
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;;;;" TipoOp IN ('MMFIMV', 'MMSIMV') ";
  Cliente4     : "Coloca"                   ;;;;NO;;NOT EQSTR(Dialogo.Cliente1, Dialogo.Cliente4);'LOS PARTICIPANTES NO PUEDEN SER IGUALES';NO;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Cliente3     : 'Arranger'                 ;;;;NO;;;;;;BuscarCampo('Operaciones','Cliente3','NrOperacion',Dialogo.NrOperacion1)
  Cliente2     : 'Agente'                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Cliente2','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Moneda"                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha1       : "Vto V_Nominal"            ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1)
  Cantidad1    : "VNA"                      ;;;;NO;;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion1);;;"###,###,###,###.##"
  TipoOp1      : 'TipoOp'                   ;;;;NO;NO;;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cliente1     : "Toma"                     ;2;2;;;;DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS') Y Not EqStr(Dialogo.Cliente1,Dialogo.Cliente4);'El Cliente Debe Ser una Entidad Bancaria ';NO;;
  Cantidad2    : "Valor Nominal"            ;;;;;;Dialogo.Cantidad2 >0 y Dialogo.Cantidad2<=Dialogo.Cantidad1;'El Valor Nominal de la Nueva Operacion debe ser Inferior al Valor Nominal del Original';NO; ; ;;;"###,###,###,###.##"
  Radio1       : "Ya Participa?|No|Si"      ;;;;NO;;;;;;IIF(NOVACIO(Dialogo.NrOperacion3),1,0)
  Fecha3       : "Concertacion"             ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o Dialogo.Fecha3<=Dialogo.Fecha4;'Fecha de Concertacion Incorrecta';NO;Fsys
  Fecha4       : "F.Cesion"                 ;;;;;;ESHABIL(Dialogo.Fecha4,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1));'Fecha de Origen Incorrecta';NO;FSYS;IIF(Dialogo.Radio1=1, SQL("Select FechaVto2 from "~DBO~".OPERACIONES where NrOperacion='"~Dialogo.NrOperacion3~"' "),FSYS)
  Precio4      : 'Tasa WH'                  ;8;;;Dialogo.Radio1=0 y Dialogo.Radio4=1;Dialogo.Radio1=0 y Dialogo.Radio4=1;[Not [Dialogo.Radio1=0 y Dialogo.Radio4=1]] o Incluido(Fstr(Dialogo.Precio4,2,4),VAR('TASAWH'));'El Valor de Tasa WH es Invalido: '~Fstr(Dialogo.Precio4,2,4)~' '~VAR('TASAWH')~' ...';NO;;;;;"###.####"
  Precio5      : 'Tasa IVA'                 ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;[Not Dialogo.Radio1=0] o Incluido(Fstr(Dialogo.Precio5,2,2),VAR('IVA'));'El Valor de Tasa IVA es Invalido: '~Fstr(Dialogo.Precio5,2,2)~' '~VAR('IVA')~' ...';NO;;;;;"###.####"
  Precio6      : 'Tasa ImpInt'              ;;;;Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMSIMV')] o [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFIMV')]];Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMSIMV')] O [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFIMV')]];Not [Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMSIMV')] o [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFIMV')]] ] o Incluido(Fstr(Dialogo.Precio6,2,4),VAR('TASAINT'));'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;;;;;"###.####"
  NrOperacion3 : "Op.Participa"             ;;;;NO;;;;;;SQL("Select NrOperacion from "~DBO~".OPERACIONES where (OperacionRef='"~Dialogo.NrOperacion1~"' or OperacionRef='"~Dialogo.NrOperacion2~"') and Cliente1='"~Dialogo.Cliente1~"' and TipoOp='"~Dialogo.TipoOp1~"' ")
  Radio4       : 'Pmo.|Local|Extranjero'    ;2;2;;NO;NO;;;;;IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
  NrOperacion2 : 'Referencia'               ;2;2;;NO;NO;;;;;BuscarCampo('Operaciones','OperacionRef','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

If Not Ok
   Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
(.'CONTROLVH'.)

If Not Incluido(Dialogo.TipoOp1,'MMFIMV|MMSIMV')
   Cancelar('La operacion Nro. '~Dialogo.NrOperacion1~' No es Participante de FRN o Sidicado')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   * Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
Else
   If Dialogo.Radio1=1 
      * Verifico que se encuentre en Back Office o Terminal
      ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion3~"' AND Valor='1'") )

      If VAL(X1)<>20 y VAL(X1)<>50
         *-- Busco la instancia actual
         * Cancelar('La Operacion Participante '~Dialogo.NrOperacion3~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
      EndIf
   EndIf
EndIf

***---El valor Nominal a ceder no puede exceder el Valor Nominal pte de amortizar.
SQL.ADD(" Select Sum(C.Cantidad4) Cantidad4 From "~DBO~".CUOTAS C ")
SQL.ADD(" Where C.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND C.Fecha1 >= (Select Max(C1.Fecha1) ")
SQL.ADD("                 From "~DBO~".CUOTAS C1 ")
SQL.ADD("                 Where C1.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("                 AND C1.Fecha1 <= '"~IdxDate(Dialogo.Fecha4)~"') ")
SQL.ADD("  ")
Recorrer SQL
    ACN(VN:1, fbn('Cantidad4'))
Proximo

IF Dialogo.Cantidad2 > Val(VN:1)
    Cancelar('No se puede ceder mas de lo que resta por amortizar '~Fstr(Val(VN:1), 0, 2))
ENDIF

* Si el Cliente ya participa Verifico las instancias de la Operacion  Participante
If Ok
   acn (j1,0)
   If NoVacio(Dialogo.NrOperacion3)
      *-- SI NO EXISTE LA TOMADORA GENERA NUEVA OPERACION
      SQL.ADD("Select * from "~DBO~".OPERACIONES ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
      Recorrer SQL
         acn (j1,1)
      Proximo  
   EndIf
   
   If val(j1)=0
      SetFilaActual(0)
      *- Pido el ingreso de las tasas de interes para calculo de iva y wh de la nueva operacion
      SQL.ADD(" SELECT NrCuota,Tasa1 PorAmor,Cantidad4 Amort,Precio2 as Tasa,Precio4 as Spread, ")
      SQL.ADD(" Tasa2 as TasaIntIva, Total6 as TasaIntWH ")
      SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")

      Recorrer SQL
           acn(aa:fac,FBN['NrCuota'] )
           acn(ab:fac,FBN['PorAmor'] )
           acn(ac:fac,FBN['Amort']   )
           acn(ad:fac,FBN['Tasa']    )
           acn(ae:fac,FBN['Spread']  )
           acn(af:fac,FBN['TasaIntIva']  )
           acn(ag:fac,FBN['TasaIntWH']  )
      Proximo

      ACT(ba1,Dialogo.NrOperacion1)
      ACT(ba2,Dialogo.Cliente4)
      ACT(ba3,Dialogo.Cliente3)
      ACT(ba4,Dialogo.Cliente2)
      ACT(ba5,Dialogo.Especie1)
      ACD(ba6,Dialogo.Fecha1)
      ACN(ba7,Dialogo.Cantidad1)
      ACT(ba8,Dialogo.TipoOp1)
      ACT(ba9,Dialogo.Cliente1)
      ACN(ba10,Dialogo.Cantidad2)
      ACN(ba11,Dialogo.Radio1)
      ACD(ba12,Dialogo.Fecha3)
      ACD(ba13,Dialogo.Fecha4)
      ACN(ba14,Dialogo.Precio4)
      ACN(ba15,Dialogo.Precio5)
      ACN(ba16,Dialogo.Precio6)
      ACT(ba17,Dialogo.NrOperacion3)
      ACN(ba18,Dialogo.Radio4)
      ACT(ba19,Dialogo.NrOperacion2)

      CrearDialogo
         NrOperacion1 : "Operacion"                ;1;1;;NO;;;;;val(ba1) ;
         Cliente4     : "Coloca"                   ; ; ;;NO;;;;;val(ba2) ;
         Cliente3     : 'Arranger'                 ; ; ;;NO;;;;;val(ba3) ;
         Cliente2     : 'Agente'                   ; ; ;;NO;;;;;val(ba4) ;
         Especie1     : "Moneda"                   ; ; ;;NO;;;;;val(ba5) ;
         Fecha1       : "Vto V_Nominal"            ; ; ;;NO;;;;;val(ba6) ;
         Cantidad1    : "VNA"                      ; ; ;;NO;;;;;val(ba7) ;;;;;"###,###,###,###.##"

         Cliente1     : "Toma"                     ; ; ;;NO;;;;;val(ba9) ;
         Cantidad2    : "Valor Nominal"            ; ; ;;NO;;;;;val(ba10); ;;;"###,###,###,###.##"
         Radio1       : "Ya Participa?|No|Si"      ;1;2;;NO;;;;;val(ba11);
         Fecha3       : "Concertacion"             ; ; ;;NO;;;;;val(ba12);
         Fecha4       : "F.Cesion"                 ; ; ;;NO;;;;;val(ba13);
         TipoOp1      : 'TipoOp'                   ; ; ;;NO;;;;;val(ba8) ;
         Precio4      : 'Tasa WH'                  ; ; ;;NO;;;;;val(ba14);
         Precio5      : 'Tasa IVA'                 ; ; ;;NO;;;;;val(ba15);
         Precio6      : 'Tasa ImpInt'              ; ; ;;NO;;;;;val(ba16);
         NrOperacion3 : "Op.Participa"             ; ; ;;NO;;;;;val(ba17);
         Radio4       : 'Pmo.|Local|Extranjero'    ; ; ;;NO;;;;;val(ba18);
         NrOperacion2 : 'Referencia'               ;10;1;;NO;;;;;val(ba19);
         ListBox; 'Arial,8,N'; 480; 300
            'NrCuota'       ;aa:1..aa:FAC;NO;;;;60;NUMERO ;'###'
            'PorAmor'       ;ab:1..ab:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'Amor'          ;ac:1..ac:FAC;NO;;;;100;NUMERO;'###,###,###.##'
            'Tasa'          ;ad:1..ad:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'Spread'        ;ae:1..ae:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'TasaIntIva'    ;af:1..af:FAC; ;VAL(af:FLB)>=0;'Tasa Int. Calculo IVA Cuota '~Fstr(val(aa:flb),0,0)~' Incorrecta';;80;NUMERO;'##,###.#####'
            'TasaIntWH'     ;ag:1..ag:FAC;val(ba18)=1;VAL(ag:FLB)>=0 o val(ba18)=0;'Tasa Int. Calculo WH Cuota '~Fstr(val(aa:flb),0,0)~' Incorrecta';;80;NUMERO;'##,###.#####'
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      *- ah1: Cantidad de filas de cuotas 
      ACN(ah1,fac)
   EndIf

   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
        acn(x1,1)

        *-- A5: TotalComisiones   A6: ValorNominal Total  
        ACN(A6,Dialogo.Cantidad2)

        *-- A2: Entidad Local o Extranera -> CB10
        ACN(A2,IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1))

        Message('Actualizando la Operacion Original .... ')                  

        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set Cantidad=Cantidad-"~FStr(Dialogo.Cantidad2,0,2)~" ")
        SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and ")
        SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
        SQL.NEW
        SQL.EXEC

        *-- Disminuye el Capital => - Precio1=Dialogo.Cantidad2
        EjecutarEvento('PROCUO',NrOperacion1=FBN['OperacionRef'],NrOperacion2=Dialogo.NrOperacion1,String1=" Fecha2>='"~IdxDate(Dialogo.Fecha4)~"' ",Precio1=-Dialogo.Cantidad2)

        EjecutarEvento('INCOMV',NrOperacion1=FBN['OperacionRef'],NrOperacion2=Dialogo.NrOperacion1,String=" Tipo  IN ('5','3')",String1=" Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' " )

        * Actualizo la Instancia de la Operacion a Supervision
        (.'MODIINSTAN'.)      

        * Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
        SQL.EXEC

        IF val(j1)=0
           Message('Generando la Nueva Operacion   .... ')          

           *** Z3 Nro. Operacion Contado
           ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

           * Genero el Nuevo FRN 
           SQL.ADD("Insert INTO "~DBO~".OPERACIONES ")
           SQL.ADD("(TipoOp,NrOperacion,")
           SQL.ADD("FechaOp2,FechaOp, ")
           SQL.ADD("RB10,OperacionRef,")
           SQL.ADD("Vehiculo1, ")
           SQL.ADD("Cliente1,Cliente2,Cliente3,")
           SQL.ADD("Especie,Plazo,")
           SQL.ADD("FechaVto2,TipoTasa,Precio1,")
           SQL.ADD("RB8,Spread,TotalBrutoCli2, ")
           SQL.ADD("FechaPago,Cantidad,FechaVto,")
           SQL.ADD("TotalIntereses,Precio4,")
           SQL.ADD("TotalNetoCli2,TablaFeriados1,TotalBrutoCli1,")
           SQL.ADD("TotalNetoCli1,Observac2,Operador,")
           SQL.ADD("CB10,TotalAux1,TotalAux2,TotalAux3,")
           SQL.ADD("ImpGastos2,TotalAux4,TotalIVA,RB3,")
           SQL.ADD("PrecioEj,Impresa,FechaEx1,")
           SQL.ADD("Cotizacion1,NrOperacion3,Cuotas1,RB5,TasaImp1,")
           SQL.ADD("Indice,Coeficiente,ResultadoIndice,CantidadOri,Book1) ")
           SQL.ADD(" Values ")
           SQL.ADD(" ('"~Dialogo.TipoOp1~"','"~VAL(Z3)~"',")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha3)~"','"~IdxDate(Dialogo.Fecha4)~"', ") 
           SQL.ADD(" '"~FBN['RB10']~"','"~FBN['OperacionRef']~"', ")
           SQL.ADD(" '"~FBN['Vehiculo1']~"', ")
           SQL.ADD(" '"~Dialogo.Cliente1~"','"~Dialogo.Cliente2~"','"~Dialogo.Cliente3~"',")
           SQL.ADD(" '"~FBN['Especie']~"',"~FStr(FBN['FechaVto']-Dialogo.Fecha4,0,0)~", ")
           SQL.ADD(" '"~IdxDate(FBN['FechaVto2'])~"','"~FBN['TipoTasa']~"',"~FStr(FBN['Precio1'],0,7)~", ")
           SQL.ADD(" '"~FStr(FBN['RB8'],0,0)~"', "~FStr(FBN['Spread'],0,7)~","~FStr(Dialogo.Cantidad2,0,2)~", ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha4)~"',"~FStr(Dialogo.Cantidad2,0,2)~", '"~IdxDate(FBN['FechaVto'])~"',")
           SQL.ADD(" "~Fstr(VAL(A1),0,7)~", "~Fstr(FBN['Precio4'],0,7)~",")
           SQL.ADD(" "~Fstr(VAL(A1)+VAL(A3),0,7)~",'"~FBN['TablaFeriados1']~"',"~Fstr(VAL(A6)+VAL(A1),0,2)~",")
           SQL.ADD(" "~Fstr(VAL(A6)+VAL(A1)+VAL(A3),0,2)~",'"~FBN['Observac2']~"','"~USUARIOACTIVO~"', ")
           SQL.ADD(" '"~Fstr(VAL(A2),1,0)~"',"~Fstr(Dialogo.Precio4,0,7)~","~Fstr(FBN['TotalAux2'],0,7)~","~Fstr(VAL(A3),0,2)~",  ")
           SQL.ADD(" "~Fstr(Dialogo.Precio5,0,7)~","~Fstr(FBN['TotalAux4'],0,7)~","~Fstr(VAL(A4),0,2)~", '"~FBN['RB3']~"',")
           SQL.ADD(" "~Fstr(VAL(A6),0,2)~",'"~FBN['Impresa']~"','"~IdxDate(FBN['FechaEx1'])~"',")
           SQL.ADD(" "~Fstr(FBN['Cotizacion1'],0,5)~",'"~Dialogo.NrOperacion1~"',"~Fstr(FBN['Cuotas1'],0,0)~",'"~FBN['RB5']~"',"~Fstr(Dialogo.Precio6,0,7)~",")
           SQL.ADD(" '"~FBN['Indice']~"',1,0,"~FStr(Dialogo.Cantidad2,0,2)~",'"~FBN['Book1']~"') ")
           SQL.NEW

           **-- Traslado los calls y puts no posteriores a la Fecha de Creacion
           SQL.ADD("INSERT INTO "~DBO~".OPSCALLSPUTS (NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida) ")
           SQL.ADD("SELECT '"~VAL(Z3)~"' As NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida ")
           SQL.ADD("FROM "~DBO~".OPSCALLSPUTS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
           SQL.ADD("and FechaEj>='"~IdxDate(Dialogo.Fecha4)~"' ")
           SQL.NEW
           SQL.EXEC  

           Message('Insertando Settlements')

           SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
           SQL.ADD(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
           SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
           SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
           SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
           SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
           SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
           SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
           SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
           SQL.ADD(" Cantidad7,Cantidad8, ")
           SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice)  ")

           SQL.ADD(" SELECT '"~VAL(z3)~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
           SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
           SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
           SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
           SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
           SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
           SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
           SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
           SQL.ADD(" Cantidad7,Cantidad8, ")
           SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice  ")
           SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
           SQL.ADD(" and  Fecha2>='"~IdxDate(Dialogo.Fecha4)~"'  ")
           SQL.NEW
           SQL.EXEC

           Recorrer&i 1,VAL(ah1)
              SQL.ADD("Update  "~DBO~".CUOTAS SET ")
              SQL.ADD("Tasa2="~Fstr(val(af:&i),0,8)~",")
              SQL.ADD("Total6="~Fstr(val(ag:&i),0,8)~" ")
              SQL.ADD("WHERE NrOperacion='"~VAL(z3)~"' and NrCuota="~val(aa:&i)~" ")
              SQL.NEW
              SQL.EXEC
           Proximo

           Message('Antes de CuoPro')
           EjecutarEvento('CUOPRO',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=VAL(Z3),String1=" Fecha2>='"~IdxDate(Dialogo.Fecha4)~"' ",Precio1=Dialogo.Cantidad2)

           * Alta de Instancias Z3: Nro.Operacion
           (.'ALTAINSTAN'.)

           *- Recalculo ttn de operacion item y Cabecera
           EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion1,Entero1=0,NrOperacion2='',Lista1='')

           EjecutarEvento('TTNOP',NrOperacion1=VAL(z3),Entero1=0,NrOperacion2='',Lista1='')

           EjecutarEvento('TTNOP',NrOperacion1=FBN['OperacionRef'],Entero1=0,NrOperacion2='',Lista1='')
        Else 
          Message('Existe la Entidad en otra Operacion ')

          SQL.ADD("Update "~DBO~".OPERACIONES ")
          SQL.ADD("Set Cantidad=Cantidad+"~FStr(Dialogo.Cantidad2,0,2)~",")
          SQL.ADD("CantidadOri=CantidadOri+"~FStr(Dialogo.Cantidad2,0,2)~" ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
          SQL.NEW

          SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' and ")
          SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
          SQL.NEW
          SQL.EXEC

          ACT(i3,Dialogo.NrOperacion3)
          ACT(Z3,VAL(I3))

          (.'MODIINSTAN'.)      

           *-- Aumenta el Capital => + Precio1=Dialogo.Cantidad2
           EjecutarEvento('PROCUO',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=VAL(Z3),String1=" Fecha2>='"~IdxDate(Dialogo.Fecha4)~"' ",Precio1=Dialogo.Cantidad2)
        Endif

        EjecutarEvento('INCOMV',NrOperacion1=FBN['OperacionRef'],NrOperacion2=VAL(Z3),String=" Tipo  IN ('5','3')",String1=" Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")

        * Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(VAL(Z3),SI)
        SQL.EXEC

        *- Recalculo ttn de operacion item y Cabecera
        EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion3,Entero1=0,NrOperacion2='',Lista1='')

        EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion1,Entero1=0,NrOperacion2='',Lista1='')

        EjecutarEvento('TTNOP',NrOperacion1=FBN['OperacionRef'],Entero1=0,NrOperacion2='',Lista1='')
   Proximo

   If Val(x1)=0
      Cancelar('La Operacion No '~Dialogo.NrOperacion1~' No pudo Desdoblarse')
   endif
endif
