MostrarCuadroDeMensajes

CrearDialogo
  Fecha1:   'FechaBajada'    ;1;1;;;;;;;;FSYS
  String:   'Archivo'        ;2;1;;;;;;;'DNCTAS';BuscarCampo('DATANET','Archivo','NrDatanet',Dialogo.String2)
  String2:  'NrDatanet'      ;3;1;;;;Eqstr(BuscarCampo('DATANET','EstadoAprobacion','NrDatanet',Trim(Dialogo.String2)),'P');'El extracto ya esta aprobado, no se puede modificar';NO;SQL("SELECT NrDatanet FROM "~DBO~".DATANET WHERE FechaBajada="~IdxDate2(Dialogo.Fecha1)~" AND TRIM(Archivo)='"~TRIM(MIRT(MAYUSCULAS2(Dialogo.String)))~"' ORDER BY NrDatanet DESC ")
  Fecha2:   'F.Desde'        ;4;1;;NO;;;;;;BuscarCampo('DATANET','FechaDesde','NrDatanet',Trim(Dialogo.String2))
  Fecha3:   'F.Hasta'        ;5;1;;NO;;;;;;BuscarCampo('DATANET','FechaHasta','NrDatanet',Trim(Dialogo.String2))
  Radio1:   'Estado|A|C|NC'  ;6;1;;NO;;;;;;BuscarCampo('DATANET','Estado','NrDatanet',Trim(Dialogo.String2))
  Vehiculo1: 'Vehiculo'      ;7;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Label1:   ''               ; 8;1;;;;;;;'Modifica por ________________________________________________________________'
  Fecha2:   'FechaBajada'    ; 9;;;;;Dialogo.Fecha2<>0       ;'Fecha de Bajada Invalida';NO;;Dialogo.Fecha1;
  String3:  'Archivo'        ;10;;;;;NoVacio(Dialogo.String3);'Archivo Invalido'        ;NO;;Dialogo.String;
  Fecha4:   'F.Desde'        ;11;;;;;Dialogo.Fecha4<>0       ;'Fecha Desde Invalida'    ;NO;;Dialogo.Fecha2;
  Fecha5:   'F.Hasta'        ;12;;;;;Dialogo.Fecha5<>0       ;'Fecha Hasta Invalida'    ;NO;;Dialogo.Fecha3;
  Radio2:   'Estado|A|C|NC'  ;13;;;NO;NO;;;;Dialogo.Radio1;
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" UPDATE "~DBO~".DATANET SET ")
SQL.ADD(" FechaBajada = "~IdxDate2(Dialogo.Fecha2)~", ")
SQL.ADD(" FechaDesde  = "~IdxDate2(Dialogo.Fecha4)~", ")
SQL.ADD(" FechaHasta  = "~IdxDate2(Dialogo.Fecha5)~", ")
SQL.ADD(" Archivo     = '"~MIRT(TRIM(Dialogo.String3))~"', ")
If Dialogo.Radio2 = 0
  SQL.ADD(" Estado = 'A' ")
Endif
If Dialogo.Radio2 = 1
  SQL.ADD(" Estado = 'C' ")
Endif
If Dialogo.Radio2 = 2
  SQL.ADD(" Estado = 'NC' ")
Endif
SQL.ADD(" WHERE NrDatanet = '"~MIRT(TRIM(Dialogo.String2))~"' ")
SQL.NEW
SQL.EXEC

Cancelar('Extracto '~Dialogo.String2~' actualizado.')
