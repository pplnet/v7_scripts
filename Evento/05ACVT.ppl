SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 Set CB10='0',CB9='0',Fecha3=Null where NrTrans='"~Dialogo.NrTrans1~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD(" UPDATE "~DBO~".INSTANCIASOP Set Usuario=' ',Fecha=Null where NrOperacion='"~Dialogo.NrTrans1~"' and (NrInstancia=8 or NrInstancia=3) ")
SQL.NEW
SQL.EXEC

if Incluido(Val(TR1),'|RET|')
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS Set Valor='1' where NrOperacion='"~Dialogo.NrTrans1~"' and NrBit = 6 ")
ELSE
   if Incluido(Val(TR1),'|DEP|')
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS Set Valor='1' where NrOperacion='"~Dialogo.NrTrans1~"' and NrBit = 3 ")
   else
   if Incluido(Val(TR1),'|MATCH|') y Val(TR3) >= 0
         SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS Set Valor='1' where NrOperacion='"~Dialogo.NrTrans1~"' and NrBit = 6 ")
      else
         SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS Set Valor='1' where NrOperacion='"~Dialogo.NrTrans1~"' and NrBit = 3 ")
      endif
   endif
   
ENDIF

SQL.NEW
SQL.EXEC

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS Set Valor = '0' where NrOperacion='"~Dialogo.NrTrans1~"' and NrBit = 70 ")
SQL.NEW
SQL.EXEC
*********************************************************************************************************
 
if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(TR2)),'DTP|RTP')
   Message('Modifica DTP/RTP  Y Paso a Pendientes - '~VAL(TR2) )

   **- DESMarco la Transaccion dtp / rtp -**
   ** MB Restauro el importe de la DTP/RTP por si la confirmacion fue parcial

   SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2                             ")
   SQL.ADD("SET    RB2='0',Fecha5=null, CB9 = '0'                    ")

   * Cambia el estado de los movimientos a manual (solo en los MATCH por ahora)
   acn(am:1,0)
   if Not Eqstr(VAL(TR1),'MATCH')
      SQL.ADD("       ,Cantidad1 = '"~FSTR(Val(TR3),1,2)~"'          ")
   else   
      acn(am:1,1)
   Endif 

   SQL.ADD("WHERE  NrTrans= '"~Val(TR2)~"'                            ")
   SQL.NEW
   SQL.EXEC
   Message('Actualizando movimientos')
   SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
   SQL.ADD("(NrOperacion , FechaMov, Cliente, Especie, CallPut, ")
   SQL.ADD("FechaEj , PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
   SQL.ADD("Leyenda , Bits, NrGrupo, Concepto, NrGrupo2,        ")
   SQL.ADD("NrMov , NrLiq, Status, NrInstan, Cupon,             ")
   SQL.ADD("Cuenta, Transaccion, Cantidad)                      ")

   SQL.ADD("Select ")
   SQL.ADD("NrOperacion, FechaMov, Cliente, Especie, CallPut,   ")
   SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado,  ")
   SQL.ADD("Leyenda, ")
   * Solo se pone manual a propósito en los match
   if Val(am:1)=0
      SQL.ADD("Bits,  ")
   else
      SQL.ADD("'MV',  ")
   endif
   SQL.ADD(" NrGrupo, Concepto, NrGrupo2,         ")
   SQL.ADD("NrMov, NrLiq, Status, NrInstan, Cupon,              ")
   SQL.ADD("Cuenta, Transaccion, Cantidad                       ")
   SQL.ADD("from "~DBO~".MOVEJECUTADOS                          ")
   SQL.ADD("where NrOperacion = '"~Val(TR2)~"'                     ")
   SQL.NEW

   SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("where NrOperacion = '"~Val(TR2)~"'   ")
   SQL.NEW

   SQL.EXEC


   *- Pasa de Instancia
   Message('Actualizando instancias')
   ACT(az3,Val(TR2))
   ACT(az4,'TRANSACCIONES2')
   ACN(az5,1)
   ACN(az6,0 )
  (.'MODIINSTAN'.)            

ENDIF

