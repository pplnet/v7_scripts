MostrarcuadrodeMensajes
CrearDialogo
  NrTrans1: 'Nro.Comprobante';;;;;;Incluido(Copy(Dialogo.NrTrans1,1,1),'V');'Numero de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('DEP','RET','MATCH','COMP') ";
FinDialogo
if Not OK
  Cancelar
endif

Message('Generando datos de confirmacion')
SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 where NrTrans='"~Dialogo.NrTrans1~"' order by NrTrans")
recorrer SQL
 act(TR1,FBN['TipoTr2'] )
 act(TR2,FBN['NrOperacionRef2'] )
 acn(TR3,FBN['Cantidad1'] )

 if Not Incluido(FBN['TipoTr2'],'DEP|RET|COMP|MATCH|TRACTA')
    Cancelar('Tipo de Transaccion incorrecto.')
 endif

 ACT(x1,SQL("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrTrans1~"' and NrBit = 70 "))
 * FBN['Bits'] <> -536870912
 if CeldaVacia(x1) o not EqStr(val(x1),'1')
   if Incluido(FBN['TipoTr2'],'TRACTA')
      Cancelar('La Transferencia Nro '~FBN['NrTrans']~' no esta confirmada.')
   else
      Cancelar('El Voucher Nro '~FBN['NrTrans']~' no esta confirmado.')
   endif
 endif
 if FBN['CB9']=0
    Cancelar('El Voucher Nro '~FBN['NrTrans']~' esta Transportado.')
 endif
 
proximo

