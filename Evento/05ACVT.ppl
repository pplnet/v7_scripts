*FO26/10/2005 Agrego esto para restablecer los limites cuando se anula una confirmacion de voucher
SQL.ADD(" SELECT M.NrOperacion, M.Concepto FROM "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE M.NrTrans2 = '"~Dialogo.NrTrans1~"' ")
SQL.ADD(" AND   M.Concepto IN ('TI','FX')  ")
Recorrer sql
  If Incluido(fbn('Concepto'),'TI|FX') y Incluido(Val(tr:1),'DEP|MATCH')
      Message('Restableciendo limites')
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD("  SET RB10        = '0',   ")
      SQL.ADD("      FechaPrecan = null   ")  
      SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
      SQL.ADD("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
      SQL.NEW
      SQL.EXEC
      *** Actualiza movimientos y limites ****
      Message('Actualizando movimientos y limites')
      SQL.ActualizarMovimientos2(fbn['NrOperacion'],NO,SI,NO,NO)
      SQL.EXEC
  Endif  
Proximo
