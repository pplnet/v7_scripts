Act(md:1, Fbn('Codigo'))
sql.add(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
sql.add(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, V.Codigo Vehiculo1, '"~&book~"' Book, ")
sql.add(" "~FStr(Abs(Val(ct:1)), 0, 0)~" Cantidad, E.Alias8, V.Alias4, '"~Val(md:1)~"' CodAsi, '' NrOperacion, ")
if (DesciendeDeEspecie(Val(es:1), 'FONDOS'))
