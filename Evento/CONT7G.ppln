sql.add(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
sql.add(" Where E.Codigo = '"~Val(es:1)~"' ")
sql.add(" AND V.Codigo = '"~Val(vh:1)~"' ")
recorrer sql
Dfa()
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~Fbn('Especie')~"' AND A.Modelo = '"~Val(md:1)~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(dialogo.fecha1)~"' AND A.Vehiculo = '"~Fbn('Vehiculo')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
sql.generarasientoop(Fbn('CodAsi'), '', '', '', 810, Val(fv:1), Fbn('Vehiculo'), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
sql.exec
endif
proximo
