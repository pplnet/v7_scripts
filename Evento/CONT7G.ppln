sql.add(" Select CRMEDAY, IRMEDAY, CRMLDAY, CIMLDAY, KRMLDAY, IRMLDAY, CRMCDAY, CIMCDAY, RTMCDAY, IRMCDAY, CRMFDAY, CIMFDAY, RTMFDAY, IRMFDAY, ")
sql.add(" KRMFDAY, KRMCDAY, RTMFDAY, RTMCDAY, RTMLDAY, XRMFDAY, XRMCDAY, XRMLDAY, Especie, Vehiculo, Book, FTMCDAY, FTMFDAY, FTMLDAY, Especie, ")
sql.add(" Vehiculo, NrSaldo, INMEDAY, INMLDAY, INMCDAY, INMFDAY, YRMFDAY, YRMEDAY, YRMLDAY, YRMCDAY ")
sql.add(" From "~Dbo()~".RESULTADOS2 ")
sql.add(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND NrSaldo IN ("~Val(y:2)~") ")
if (NoVacio(dialogo.lista1))
sql.add(" AND (Vehiculo IN ("~pipe2comillas(dialogo.lista1)~") OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add(" AND Vehiculo Not IN ("~pipe2comillas(Var('VLIQUIDAA'))~") ")
recorrer sql
Acn(rz:1, Fbn('CRMFDAY') + Fbn('FTMFDAY') + Fbn('RTMFDAY'))
Acn(iz:1, Fbn('YRMFDAY'))
Acn(dz:1, Fbn('XRMFDAY') - Fbn('RTMFDAY'))
Acn(rz:2, Fbn('CRMLDAY') + Fbn('FTMLDAY') + Fbn('RTMLDAY'))
Acn(iz:2, Fbn('YRMLDAY'))
Acn(dz:2, Fbn('XRMLDAY') - Fbn('RTMLDAY'))
Acn(rz:3, Fbn('CRMCDAY') + Fbn('FTMCDAY') + Fbn('RTMCDAY'))
Acn(iz:3, Fbn('YRMCDAY'))
Acn(dz:3, Fbn('XRMCDAY') - Fbn('RTMCDAY'))
Acn(rz:4, Fbn('CRMEDAY'))
Acn(iz:4, Fbn('YRMEDAY'))
Act(es:1, Fbn('Especie'))
Act(vh:1, Fbn('Vehiculo'))
let(&book, Fbn('Book'))
if (sql(" Select 1 From "~Dbo()~".TRANSACCIONES2 Where Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND TipoTr2 = 'CUPON' AND Especie = '"~Fbn('Especie')~"' ") = 1)
Acn(iz:1, 0)
Acn(iz:2, 0)
Acn(iz:3, 0)
Acn(iz:4, 0)
endif
sql.add(" Select MA.Codigo From "~Dbo()~".MODELOSASIENTO MA ")
sql.add(" Where MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASIRZ'))~") ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND MA.Entorno = '"~sigla~"' ")
if (NoVacio(dialogo.lista1))
sql.add(" AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
sql.add(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
sql.add(" OR ")
endif
proximo
sql.add(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")
endif

recorrer sql
Dfa()
Acd(fv:1, dialogo.fecha1)
