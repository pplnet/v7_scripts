creardialogo
vehiculo1: 'Vehiculo';1;1;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO', 'Vehiculo', 'Codigo', UsuarioActivo());;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
cuenta1:'Cuenta';;;;;;(NoVacio(dialogo.cuenta1) y Incluido(dialogo.cuenta1, SQLSet(" Select Cuenta From "~Dbo()~".CNCHEQUERASBANCO "))) o (dialogo.radio1 <> 0);'Cuenta Invalida';NO;;;;;;" Codigo IN (Select Distinct Cuenta From "~Dbo()~".CNCHEQUERASBANCO WHERE Vehiculo= '"~dialogo.vehiculo1~"' ) "
chequera1: 'Nr.Chequera';;;;;;(NoVacio(dialogo.chequera1)) o (dialogo.radio1 <> 0);'Numero de Chequera Invalida';NO;Query(" Select Chequera From "~Dbo()~".CNCHEQUERASBANCO Where Cuenta='"~dialogo.cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~dialogo.vehiculo1~"' ");Query(" Select Chequera From "~Dbo()~".CNCHEQUERASBANCO Where Cuenta='"~dialogo.cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~dialogo.vehiculo1~"' ");;;;" Cuenta = '"~dialogo.cuenta1~"' AND Vehiculo = '"~dialogo.vehiculo1~"' ";
entero1:'Nr.Cheque';;;;;;(dialogo.entero1 > 0 y dialogo.entero1 >= Query(" Select Min(NrChequeDesde) From "~Dbo()~".CNCHEQUERASBANCO Where Cuenta='"~dialogo.cuenta1~"' AND Vehiculo = '"~dialogo.vehiculo1~"' ") y dialogo.entero1 <= Query(" Select Max(NrChequeHasta) From "~Dbo()~".CNCHEQUERASBANCO Where Cuenta='"~dialogo.cuenta1~"' AND Vehiculo = '"~dialogo.vehiculo1~"' ")) o dialogo.radio1 <> 0;'Numero de Cheque Invalido';NO;Query(" Select Min(NrCheque) From "~Dbo()~".CHEQUES Where Chequera='"~dialogo.chequera1~"' AND Estado Not IN('ANU','PAG','ENT') ");Query(" Select Min(NrCheque) From "~Dbo()~".CHEQUES Where Chequera='"~dialogo.chequera1~"' AND Estado Not IN('ANU','PAG','ENT') ");;;'###############';;
radio1:'Llamada|Menu|InstFacChe|Terminal|InstFacNche|Inf.Datanet|Conciliacion';;;;NO;NO;NoVacio(dialogo.radio1);;NO;0;
nrtrans1:'Transaccion DEVM';;;;dialogo.radio1 = 4;dialogo.radio1 = 4;NoVacio(dialogo.nrtrans1) o dialogo.radio1 <> 4;'Numero de Transaccion Invalida';NO;
findialogo

if (not ok)
Cancelar()
endif

Acn(bd:1, 0)

if (dialogo.radio1 = 2)
Act(es:2, Query("Select Estado From "~Dbo()~".CHEQUES Where Chequera='"~dialogo.chequera1~"' AND NrCheque="~FStr(dialogo.entero1, 0, 0)~" "))

if (not Eqstr(Trim(Val(es:2)), 'PAG'))
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".CHEQUES SET Estado = 'ANU' ")
Sqladd(" Where  NrComprobante = '"~dialogo.nrtrans1~"' ")
Sqlnew()
Sqlexec()
else
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where  NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND NrBit= 11 ")
Sqlnew()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND NrBit= 20 ")
Sqlnew()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".TRANSACCIONES2 SET Direccion = 2 ")
Sqladd(" Where  NrTrans = '"~dialogo.nrtrans1~"' ")
Sqlnew()
Sqlexec()
Cancelar('La Transaccion no puede retroceder el Cheque esta Pagado.')
endif
endif

if (dialogo.radio1 = 4 o dialogo.radio1 = 5)
SetFilaActual(1)
Sqladd(" Select /*+ RULE */ C.Chequera, C.FechaEmision, C.NrCheque, C.NrComprobante, C.Monto, C.Estado, ")
Sqladd(" T.Cliente1, C.Observaciones, C.FechaPago, T.Proveedor ")
Sqladd(" From "~Dbo()~".CHEQUES C, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" Where NrComprobante = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND Estado <> 'ANU' ")
Sqladd(" AND C.NrComprobante = T.NrTrans ")
recorrer sql
if (Eqstr(Fbn('Estado'), 'ASI'))
Act(es:1, 'Asignado')
endif
if (Eqstr(Fbn('Estado'), 'ENT'))
Act(es:1, 'Entregado')
endif
if (Eqstr(Fbn('Estado'), 'PEN'))
Act(es:1, 'Pendiente')
endif
Act(a:fac, Fbn('Chequera'))
Act(b:fac, Fbn('Proveedor'))
Acd(c:fac, Fbn('FechaEmision'))
Acn(d:fac, Fbn('NrCheque'))
Act(e:fac, Fbn('NrComprobante'))
Acn(f:fac, Fbn('Monto'))
Act(g:fac, Fbn('Observaciones'))
Act(h:fac, Val(es:1))
Acd(i:fac, Fbn('FechaPago'))
Act(j:fac, dialogo.vehiculo1)
ACO(7, 50)
proximo

crearlistbox;'Arial,8,'
'Proveedor';j:fac..j:fac;NO;;;70;string;;RGB(220, 220, 193);
'NrChequera';a:fac..a:fac;NO;;;70;string;;RGB(220, 220, 193);
'Proveedor';b:fac..b:fac;NO;;;70;string;;RGB(220, 220, 193);
'Fecha Emision';c:fac..c:fac;NO;;;100;fecha;RGB(220, 220, 193);
'Fecha Pago';i:fac..i:fac;NO;;;100;fecha;RGB(220, 220, 193);
'NrCheque';d:fac..d:fac;NO;;;80;numero;'###,###,###,###,###';RGB(220, 220, 193);
'Transaccion';e:fac..e:fac;NO;;;80;string;;RGB(220, 220, 193);
'Monto';f:fac..f:fac;NO;;;85;numero;'###,###,###,###,###.##';RGB(220, 220, 193);
'Observaciones';g:fac..g:fac;NO;;;220;string;40;RGB(220, 220, 193);
'Estado';h:fac..h:fac;NO;;;70;string;;RGB(220, 220, 193);
finlistbox

if (not ok)
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where  NrOperacion = '"~Val(e:fac)~"' ")
Sqladd(" AND NrBit= 11 ")
Sqlnew()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrOperacion = '"~Val(e:fac)~"' ")
if (dialogo.radio1 = 4)
Sqladd(" AND NrBit= 17 ")
else
Sqladd(" AND NrBit= 18 ")
endif
Sqlnew()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".TRANSACCIONES2 SET Direccion = 2 ")
Sqladd(" Where  NrTrans = '"~Val(e:fac)~"' ")
Sqlnew()
Sqlexec()
else
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".CHEQUES SET Estado = 'ANU' ")
Sqladd(" Where  NrComprobante = '"~Val(e:fac)~"' ")
Sqlnew()
Sqlexec()
endif
endif

if (dialogo.radio1 = 0)
Sqladd(" SELECT Max(NrCheque) NrCheque ")
Sqladd(" From "~Dbo()~".CHEQUES ")
Sqladd(" Where Chequera = '"~dialogo.chequera1~"' ")

recorrer sql
if (Fbn('NrCheque') + 1 = dialogo.entero1)
Acn(vi:1, 0)
if (Val(vi:1) = 1)
Act(a:fac, Fbn('Chequera'))
if (Eqstr(BuscarCampo('CNFORMASPAGOCOBRO', 'Tipo', 'Codigo', Fbn('CNFormaPago')), 'CAN') o Eqstr(Fbn('Usado'), 'Tran'))
Act(b:fac, Fbn('Cliente2'))
Act(c:fac, Fbn('Cuenta2'))
else
Act(b:fac, Fbn('Cliente1'))
Act(c:fac, Fbn('Cuenta1'))
endif
Act(d:fac, Fbn('Proveedor'))
Acd(e:fac, Fbn('FechaEmision'))
Acn(f:fac, Fbn('NrCheque'))
Act(g:fac, Fbn('NrComprobante'))
Acn(h:fac, Fbn('Monto'))
Act(i:fac, Fbn('Observaciones'))
if (Eqstr(Fbn('Estado'), 'ASI'))
Act(j:fac, 'Asignado')
endif
if (Eqstr(Fbn('Estado'), 'PEN'))
Act(j:fac, 'Pendiente')
endif
if (Eqstr(Fbn('Estado'), 'ANU'))
Act(j:fac, 'Anulado')
endif
if (Eqstr(Fbn('Estado'), 'ENT'))
Act(j:fac, 'Entregado')
endif
else
Act(a:fac, dialogo.chequera1)
Act(c:fac, dialogo.cuenta1)
Act(b:fac, BuscarCampo('CUENTAS', 'Comitente', 'Codigo', Val(c:fac)))
Act(d:fac, '')
Acd(e:fac, Hoy())
Acn(f:fac, dialogo.entero1)
Act(g:fac, '')
Acn(h:fac, 0)
Act(i:fac, 'Cheque en Blanco')
Act(j:fac, '')
endif


crearlistbox;'Arial,8,'
'NrChequera';a:fac..a:fac;NO;;;70;string;;RGB(220, 220, 193);
'Banco';b:fac..b:fac;NO;;;70;string;;RGB(220, 220, 193);
'Cuenta';c:fac..c:fac;NO;;;70;string;;RGB(220, 220, 193);
'Proveedor';d:fac..d:fac;NO;;;70;string;;RGB(220, 220, 193);
'Fecha Emision';e:fac..e:fac;NO;;;100;fecha;RGB(220, 220, 193);
'NrCheque';f:fac..f:fac;NO;;;80;numero;'###,###,###,###,###';RGB(220, 220, 193);
'Transaccion';g:fac..g:fac;NO;;;60;string;;RGB(220, 220, 193);
'Monto';h:fac..h:fac;NO;;;80;numero;'###,###,###,###,###.##';RGB(220, 220, 193);
'Observaciones';i:fac..i:fac;NO;;;100;string;;RGB(220, 220, 193);
'Estado';j:fac..j:fac;NO;;;70;string;;RGB(220, 220, 193);
finlistbox

if (not ok)
Acn(vi:1, 1)
else
Acn(vi:1, 0)
endif


if (Val(vi:1) = 0)
Sqladd(" INSERT INTO "~Dbo()~".CHEQUES ")
Sqladd(" (Chequera, FechaEmision, NrCheque, Observaciones ,Estado) ")
Sqladd(" VALUES ")
Sqladd(" ('"~dialogo.chequera1~"', '"~IdxDate(FSys())~"', "~dialogo.entero1~", 'Cheque Anulado en Blanco por Evento', 'ANU') ")
Sqlnew()
Sqlexec()
else
Cancelar()
endif
else
Messagebox('El Numero de Cheque Ingresado no es el Siguiente en la Chequera.')
endif
proximo
endif
