CrearDialogo
  NrOperacion1: 'Nr.Ope.'     ;1;1;1;  ;  ;Novacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIC|TIV');'Debe ingresar una operacion.';NO;;;;;;"TipoOp in ('TIC','TIV')"
  Fecha1:       'Fecha'       ;2;1;1;  ;  ;;;;FSys
  Check1:       'Procesa'     ;4;1;1;NO;NO;;;;1;
  Check2:       'Automatico'  ;5;1;1;NO;NO;;;;0;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

ACT(a:1, 'Operacion')
ACT(a:2, 'Fecha')
ACT(a:3, 'Cliente')
ACT(a:4, 'Vehiculo')
ACT(a:5, 'Cant.ML')
ACT(a:6, 'A Ajsutar')
ACT(a:7, 'Transaccion')
ACT(a:8, 'Especie')
ACT(a:9, 'Descripcion')

SetFont(a:1..a:10, 2)

ACT(b:1, Dialogo.NrOperacion1)
ACD(b:2, Dialogo.Fecha1)
ACT(b:3, BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1))
ACT(b:4, BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1))

SetFilaActual(1)
ACT(aa:FAC, 'Cliente')
ACT(ab:FAC, 'Limite')
ACT(ac:FAC, 'Especie')
ACT(ad:FAC, 'Monto')
ACT(ae:FAC, 'Vehiculo')
ACT(af:FAC, 'Operador')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'Responsable')
ACT(ai:FAC, 'TipoPosicion')
ACT(aj:FAC, 'Producto')
ACT(ak:FAC, 'GrupoEspecie')
ACT(al:FAC, 'CarteraBCRA')
ACT(am:FAC, 'Ajusta')
ACT(an:FAC, 'Ajustado')
ACT(ao:FAC, 'Operacion')
SetFont(aa:fac..an:fac, 2)

SQL.ADD("SELECT * ")
SQL.ADD(" FROM "~DBO~".MOVLIMITES ")
SQL.ADD(" WHERE NrOperacion  = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND   Limite   in ('PRESETTLEM') ")
recorrer SQL

  ACT(aa:FAC, fbn('Cliente'))
  ACT(ab:FAC, fbn('Limite'))
  ACT(ac:FAC, fbn('Especie'))
  ACN(ad:FAC, fbn('Monto'))
  ACT(ae:FAC, fbn('Vehiculo'))
  ACT(af:FAC, fbn('Operador'))
  ACT(ag:FAC, fbn('Book'))
  ACT(ah:FAC, fbn('Responsable'))
  ACT(ai:FAC, fbn('TipoPosicion'))
  ACT(aj:FAC, fbn('Producto'))
  ACT(ak:FAC, fbn('GrupoEspecie'))
  ACT(al:FAC, fbn('CarteraBCRA'))
  ACT(ao:FAC, fbn('NrOperacion'))
  ACT(ap:FAC, fbn('Descripcion'))
  
  SCN(b:5, 1)
  SCN(b:6, fbn('Monto'))
  ACT(b:8, fbn('Especie'))

proximo

if Val(b:6)<=0.0
  * No hay Limites
  if Dialogo.Check2=0 y Dialogo.Check1=1
    * Manual y Procesa
    Cancelar('La operacion '~Dialogo.NrOperacion1~' no tienen limite para ajustar')
  else
    if Dialogo.Check1=0
      MessageBox('La operacion '~Dialogo.NrOperacion1~' no tienen limite para ajustar')
    endif
    if Dialogo.Check2=1
      ** Automatico
      Message('La operacion '~Dialogo.NrOperacion1~' no tienen limite para ajustar')
      Cancelar
    endif
  endif
endif

if Val(b:6)>0.01
  ACT(b:10, 'Genera Tr')
  if Dialogo.Check1=1
    ACT(b:7, GetNumerador(27))
    SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
    SQL.ADD("   TipoTr2, NrTrans, Cliente1,  Fecha1, Especie, Vehiculo1, ")
    SQL.ADD("   RB1, NrOperacionRef1, ")
    SQL.ADD("   FechaCarga, FechaCargaSys, UsrInput ")
    SQL.ADD(" ) VALUES ( ")
    * TipoTr2
    SQL.ADD("   'AJULIM', ")
    * Nr Trans
    SQL.ADD("   '"~Val(b:7)~"', ")
    * Cliente
    SQL.ADD("   '"~Val(b:3)~"', ")
    * Fecha
    SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
    * Especie
    SQL.ADD("   '"~Val(b:8)~"', ")
    * Vehiculo1
    SQL.ADD("   '"~Val(b:4)~"', ")
    * RB1 (TipoLim 0=Posicion)
    SQL.ADD("   1, ")
    * NrOperacionRef
    SQL.ADD("   '"~Dialogo.NrOperacion1~"', ")

    SQL.ADD(" "~SQLAhora~","~idxdate2(fsys)~", '"~USUARIOACTIVO~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
    SQL.EXEC    

    ** Alta en Instancia 70 - Terminal **
    SQL.ADD("SELECT NrInstancia FROM "~DBO~".INSTANCIAS Where Tabla='TRANSACCIONES2' ")
    SQL.ADD("ORDER BY NrInstancia ")
    Recorrer SQL
      dfa
      SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
      SQL.ADD("(NrOperacion,NrBit,Valor) ")
      SQL.ADD(" Values ")
      SQL.ADD("('"~Val(b:7)~"',"~Fstr(FBN['NrInstancia'],3,0)~",")
      IF Incluido(FBN['NrInstancia'], '70')
        SQL.ADD("'1')")
      ELSE
        SQL.ADD("'0')")
      ENDIF
      SQL.NEW
      SQL.EXEC
    Proximo
    ACT(b:9, Copy('AJULIM '~Val(b:7)~' '~Val(ap:2),1,50))

    recorrer&i 2,2
        ACT(an:&i, 'OK')

        SQL.ADD("INSERT INTO "~DBO~".MOVLIMITES ( ")
        SQL.ADD("   FechaMov,    Cliente,    Limite,       Especie,  Monto, ")
        SQL.ADD("   NrOperacion, Descripcion, Bits,         Vehiculo, Operador, ")
        SQL.ADD("   Book,        Responsable, TipoPOsicion, Producto, GrupoEspecie, ")
        SQL.ADD("   CarteraBCRA ")

        SQL.ADD(" ) VALUES ( ")

        * FechaMov
        SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
        * Cliente
        SQL.ADD("   '"~Val(aa:&i)~"', ")
        * Limite
        SQL.ADD("   '"~Val(ab:&i)~"', ")
        * Especie
        SQL.ADD("   '"~Val(ac:&i)~"', ")
        * Monto
        SQL.ADD("   "~FStr(-Val(b:6),1,2)~", ")

        * Nr Operacion
        SQL.ADD("   '"~Val(b:1)~"', ")
        * Descripcion
        SQL.ADD("   '"~Val(b:9)~"', ")
        * Bits
        SQL.ADD("   'P', ")
        * Vehiculo1
        SQL.ADD("   '"~Val(b:4)~"' ,")
        * Operador
        SQL.ADD("   '"~Val(af:&i)~"', ")

        * Book
        SQL.ADD("   '"~Val(ag:&i)~"', ")
        * Responsable
        SQL.ADD("   '"~Val(ah:&i)~"', ")
        * TipoPosicion
        SQL.ADD("   '"~Val(ai:&i)~"', ")
        * Producto
        SQL.ADD("   '"~Val(aj:&i)~"', ")
        * GrupoEspecie
        SQL.ADD("   '"~Val(ak:&i)~"', ")
        
        * CarteraBCRA
        SQL.ADD("   '"~Val(al:&i)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC    
    proximo
  endif
endif

ACO(1,15)
