MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';1;1;;;;EsHabil(dialogo.fecha1) y dialogo.fecha1 <= FSys();'Fecha Invalida';NO;FSys();
vehiculo1: 'Vehiculo:';2;1;;NO;SI;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
cliente1:'Cliente';3;1;;NO;NO;
check1:'Procesa';1;2;;SI;NO;;;;1;
check2:'Ejec.Liq.';2;2;;NO;NO;;;;1;
check3:'Contingencia';3;2;;NO;NO;;;;0;
lista1:'Mercado';;1;;SI;;;;;;;SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where (TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%') and MTM=2")
lista2:'Producto';;1;;NO;NO;;;;'Moneda';;'Titulo|Moneda'

findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

if (NoVacio(dialogo.lista1))
Act(ls:1, dialogo.lista1)
else
Act(ls:1, SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where (TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%') and MTM=2  "))
endif
if (NoVacio(dialogo.lista2))
Act(ls:2, dialogo.lista2)
else
Act(ls:2, 'Moneda')
endif

Acn(co1, Query("SELECT PrecioContable FROM "~Dbo()~".COTIZACIONES WHERE Codigo='USD' and Fecha="~IdxDate2(dialogo.fecha1)~" and CallPut='CON' And Moneda='"~Var('MONELOCA')~"' "))
if (Val(co1) = 0)
Cancelar('No hay cotizacion USD Contable para la fecha')
endif


SetFilaActual(1)
Act(a:fac, 'Mercado')
Act(b:fac, 'Producto')
Act(c:fac, 'Cant Ops')
Act(d:fac, 'Cont.Precio')
Act(e:fac, 'Ult fecha')
Act(f:fac, 'Cont.Fecha')
Act(g:fac, 'Tipo Error')
Act(l:fac, 'Liquidaciones')
SetFont(a:fac..l:fac, 2)

Act(aa:fac, 'Mercado')
Act(ab:fac, 'Producto')
Act(ac:fac, 'Nr Op')
Act(ad:fac, 'Tipo Op')
Act(ae:fac, 'Cot Hoy')
Act(af:fac, 'Cot Ayer')
Act(ag:fac, 'Cot Ant')
Act(ah:fac, 'Difer.')
Act(ai:fac, 'MTM')
Act(aj:fac, '')

SetFont(aa:fac..al:fac, 2)

Acn(x:1, Fac())
recorrer&k 1, Elementos(Val(ls:1))
recorrer&j 1, Elementos(Val(ls:2))
Ifa()
Act(a:fac, ItemLista(Val(ls:1), &k))
Act(c:fac, BuscarCampo('MERCADOS', 'TablaFeriados', 'Codigo', Val(a:fac)))
Act(b:fac, ItemLista(Val(ls:2), &j))
proximo
proximo
Acn(y:1, Fac())

if (Val(y:1) = Val(x:1))
if (dialogo.check1 = 1)
Cancelar('No existe Mercado+Producto para analizar')
else
Messagebox('No existe Mercado+Producto para analizar')
endif
endif


if (Val(y:1) > Val(x:1))
recorrer&k 2, Val(y:1)
Acd(e:&k, Query(" Select Max(Fecha) From "~Dbo()~".MTM Where Fecha <= '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND Estado = 'PRO' AND TipoMTM = 'MTM' "))
Act(f:&k, 'OK')
if (Val(e:&k) = dialogo.fecha1)
if (Query(" Select 1 From "~Dbo()~".MTM Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND Estado = 'PRO' AND TipoMTM = 'MTM' ") = 1)
Act(f:&k, 'OKK')
Act(g:&k, 'MTM ya procesado')
Messagebox('MTM ya Existe para Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~' - Fecha '~dialogo.fecha1~' - VA A REPROCESARLO')
endif
else
if (Val(e:&k) > 0)
if (Val(e:&k) < Habiles(dialogo.fecha1, -1, Val(c:&k)))
endif
endif
endif

if (Query(" Select 1 From "~Dbo()~".OPERACIONES Where  Mercado = '"~Val(a:&k)~"' AND TipoOp IN ('FXCF','FXVF') AND FechaVto >= '"~IdxDate(dialogo.fecha1)~"' and MercadoRB='1' ") = 1)
Act(f:&k, 'Error')
Act(n:&k, 'Operaciones sin Autorizar')
Messagebox('Existen Operaciones pendientes de autorizacion para el Mercado '~Val(a:&k)~' - PRIMERO DEBE AUTORIZAR PARA PODER INGRESAR EL MTM')
endif

Act(m:&k, 'OK')
Acn(l:&k, Query(" Select 1 From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M Where O.NrOperacion = M.NrOperacion  AND O.Mercado = '"~Val(a:&k)~"' AND O.TipoOp IN ('FXCF','FXVF') AND M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' AND M.NrMov >= 1000 "))
if (Val(l:&k) = 1)
Act(m:&k, 'Error')
Messagebox('Existen liquidaciones Relizadas para la fecha. Mercado: '~Val(a:&k)~' , Producto: '~Val(b:&k))
endif
proximo
endif

if (Val(y:1) > Val(x:1))
SetFilaActual(1)
Acn(xy10, 0)
recorrer&k 2, Val(y:1)
if (Incluido(Val(f:&k), 'OK|OKK') y Incluido(Val(m:&k), 'OK'))

Sqladd("Select O.NrOperacion,   O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
Sqladd("       O.Precio1,       O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        O.Cuenta4,     ")
Sqladd("       O.FechaOp,       O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    O.Mercado2,    ")
Sqladd("       O.FechaUltCupon, O.PrecioEj,      O.FechaEj,        O.MB1,         O.ObsErrorMAE,  O.TasaEspecie, ")
Sqladd("       O.TotalAux1,     O.TotalAux3,     O.ContraEspecie2, O.EnteCus1,    O.Mercado,      O.MB4          ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" Where C.Codigo    = O.Cliente1 ")
Sqladd(" AND O.Mercado = '"~Val(a:&k)~"' ")
Sqladd(" AND O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.NrOperacion = B.NrOperacion ")
Sqladd("   and B.NrBit   in (10) ")
Sqladd("   and B.Valor   = '1' ")
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
if (NoVacio(dialogo.cliente1))
Sqladd("   and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
Sqladd(" Order By O.FechaVto, O.NrOperacion ")
recorrer sql
Message(Fbn('NrOperacion'))
Scn(xy10, 1)
Act(ba:fac, Val(a:&k))
Act(bb:fac, Val(b:&k))
Act(bc:fac, Fbn('NrOperacion'))
Act(bd:fac, Fbn('TipoOp'))
Acd(be:fac, Fbn('FechaOp'))
Acd(bf:fac, Fbn('FechaVto'))
Act(bg:fac, Fbn('Especie'))
Act(bh:fac, Fbn('ContraEspecie'))
Act(bm:fac, Fbn('Cliente1'))
Act(bn:fac, Fbn('Mercado2'))
Act(bo:fac, Fbn('Vehiculo1'))
Act(bp:fac, Fbn('Cuenta4'))
Act(bq:fac, Fbn('Book1'))
Act(br:fac, Fbn()['TasaEspecie'])
Acn(ae:fac, 0)
Acn(ag:fac, 0)
Acn(bi:fac, Fbn('Cantidad'))
Act(bl:fac, 'MTM')
if (Eqstr(Val(f:&k), 'OKK'))
Acn(bj:fac, Query("Select MTMEspecie from "~Dbo()~".MTMDIARIO Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha = '"~IdxDate(dialogo.fecha1)~"' "))
Acn(cj:fac, Val(bj:fac))
Acn(bk:fac, Query("Select MTM from "~Dbo()~".MTMDIARIO Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha = '"~IdxDate(dialogo.fecha1)~"' "))
Acn(ck:fac, Val(bk:fac))
if (Val(bk:fac) = 0)
Act(bz:fac, 'OK')
else
Act(bz:fac, Val(f:&k))
endif
else
Acn(bj:fac, 0)
Acn(bk:fac, 0)
Act(bz:fac, 'OK')
endif
Acn(bx:fac, 1)
proximo
endif
proximo
if (Val(xy10) > 0)
crearlistbox;'Arial,8,';'MTM Manual de operaciones NDF  al '~dialogo.fecha1
'Act.';bx2..bx:fac;SI;;;50;check;RGB(160, 160, 193)
'Mercado';ba2..ba:fac;NO;;;60;string;;RGB(232, 232, 255);
'Producto';bb2..bb:fac;NO;;;60;string;;RGB(232, 232, 255);
'Operacion';bc2..bc:fac;NO;;;70;string;;RGB(232, 232, 255);
'TipoOp';bd2..bd:fac;NO;;;50;string;;RGB(232, 232, 255);
'FechaOp';be2..be:fac;NO;;;70;fecha;RGB(232, 232, 255);
'FechaVto';bf2..bf:fac;NO;;;70;fecha;RGB(232, 232, 255);
'Especie';bg2..bg:fac;NO;;;50;string;;RGB(232, 232, 255);
'ContraEsp';bh2..bh:fac;NO;;;70;string;;RGB(232, 232, 255);
'Esp.Liquid.';br2..br:fac;NO;;;70;string;;RGB(232, 232, 255);
'Cantidad';bi2..bi:fac;NO;;;100;numero;'###,###,###.##';RGB(232, 232, 255);
'MTM Especie';bj2..bj:fac;;;;100;numero;'###,###,###.##';RGB(255, 255, 213);
'MTM ContraEsp';bk2..bk:fac;NO;;;100;numero;'###,###,###.##';RGB(255, 255, 213);Val(bj:fac) * Val(co1);

finlistbox

if (not ok)
Cancelar('Evento Cancelado.')
endif

recorrer&i 2, Fac()
if (Val(bx:&i) = 1)
if (dialogo.check1 = 1)
if (Eqstr(Val(bz:&i), 'OK') y not Eqstr(Val(f:&i), 'OKK'))
Message('Agregando MTM '~Val(bc:&i))
Sqladd(" Insert Into "~Dbo()~".MTMDIARIO ")
Sqladd(" (NrOperacion, Fecha, PrecioHoy, PrecioAyer, ")
Sqladd(" MTMEspecie, MTM, TipoMTM,  ")
Sqladd(" Especie1, Especie2, FechaCargaSys) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(bc:&i)~"', '"~IdxDate(dialogo.fecha1)~"', 0, 0, ")
Sqladd(" "~FStr(Val(bj:&i), 0, 2)~","~FStr(Val(bk:&i), 0, 2)~", '"~Val(bl:&i)~"', ")
Sqladd(" '"~Val(bh:&i)~"','"~Val(bg:&i)~"', "~IdxDate2(FSys())~" ) ")
Sqlnew()
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set TotalAux3 = TotalAux3 + "~FStr(Val(bk:&i), 0, 2)~" ")
Sqladd(" Where NrOperacion = '"~Val(bc:&i)~"' ")
Sqlnew()
Sqlexec()
else
Message('Actualizando MTM '~Val(bc:&i))
Sqladd(" Update "~Dbo()~".MTMDIARIO ")
Sqladd(" Set MTMEspecie = "~FStr(Val(bj:&i), 0, 2)~", MTM = "~FStr(Val(bk:&i), 0, 2)~", ")
Sqladd(" Especie1 = '"~Val(bh:&i)~"', Especie2= '"~Val(bg:&i)~"', FechacargaSys= "~IdxDate2(FSys())~" ")
Sqladd(" Where NrOperacion = '"~Val(bc:&i)~"' and Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and TipoMTM = '"~Val(bl:&i)~"' ")
Sqlnew()
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set TotalAux3 = TotalAux3 - "~FStr(Val(ck:&i), 0, 2)~" + "~FStr(Val(bk:&i), 0, 2)~" ")
Sqladd(" Where NrOperacion = '"~Val(bc:&i)~"' ")
Sqlnew()
Sqlexec()
endif

Acn(cu:1, 1 + Query(" Select count(*) From "~Dbo()~".MTMDIARIO Where NrOperacion = '"~Val(bc:&i)~"' "))
Act(le:1, 'Liquidacion MTM '~Val(bg:&i))

if (NoVacio(Val(br:&k)) y not Eqstr(Val(bh:&i), Val(br:&k)))
Act(es:1, Val(br:&k))
Acn(ca:1, Val(aj:fac) * -1)
Acn(nr:1, 2000)
else
Act(es:1, Val(bg:&i))
Acn(ca:1, Val(ai:fac) * -1)
Acn(nr:1, 1000)
endif
if (NO)
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES  Where FechaMov = '"~IdxDate(dialogo.fecha1)~"' AND NrOperacion = '"~Val(bc:&i)~"'  AND NrGrupo > 1000 ") = 1)
Sqladd(" Update "~Dbo()~".MOVPENDIENTES            ")
Sqladd(" Set Cantidad = "~FStr(Val(bk:&i), 0, 2)~", Leyenda = '"~Val(le:1)~"' ")
Sqladd(" Where  NrOperacion = '"~Val(bc:&i)~"' ")
Sqladd("   And  FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()
else
Sqladd(" Insert into "~Dbo()~".MOVPENDIENTES           ")
Sqladd(" (NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
Sqladd("  Bits, NrSaldo, Cuenta, NrMov,  ")
Sqladd(" Book,  FechaMov, Cantidad, Leyenda,         ")
Sqladd(" NrGrupo, Concepto,         ")
Sqladd(" NrGrupo2, Nrinstan)                         ")
Sqladd(" values  (                                   ")
Sqladd(" '"~Val(bc:&i)~"'  , '"~Val(es:1)~"', '"~Val(bm:&i)~"', '"~Val(bn:&i)~"', '"~Val(bo:&i)~"',                  ")
Sqladd(" 'MV'  , 1,  '"~Val(bp:&i)~"', "~FStr(Val(nr:1) + Val(cu:1), 1, 0)~",              ")
Sqladd(" '"~Val(bq:&i)~"'  ,  "~IdxDate2(dialogo.fecha1)~", "~FStr(Val(bk:&i), 0, 2)~", '"~Val(le:1)~"', ")
Sqladd(" 0  , 'FM',                       ")
Sqladd(" "~FStr(Val(nr:1) + Val(cu:1), 1, 0)~" , "~FStr(0, 0, 0)~"         ")
Sqladd("         )                                   ")
Sqlnew()
Sqlexec()
endif
endif
if (Query(" Select 1 From "~Dbo()~".MTM Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(ba:&i)~"' AND Producto = '"~Val(bb:&i)~"' AND TipoMTM = '"~Val(bl:&i)~"' ") = 1)
Sqladd(" Update "~Dbo()~".MTM ")
Sqladd(" Set Estado = 'PRO', ")
Sqladd(" FechaEstado = "~IdxDate2(FSys())~" ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Mercado = '"~Val(ba:&i)~"' ")
Sqladd(" AND Producto = '"~Val(bb:&i)~"' ")
Sqladd(" AND TipoMTM = '"~Val(bl:&i)~"' ")
else
Sqladd(" Insert Into "~Dbo()~".MTM ")
Sqladd(" (Fecha, Mercado, Producto, Estado, TipoMTM, FechaEstado) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Val(ba:&i)~"', '"~Val(bb:&i)~"', 'PRO', '"~Val(bl:&i)~"', "~IdxDate2(FSys())~") ")
endif
Sqlnew()
Sqlexec()
endif
endif
proximo
endif
endif
