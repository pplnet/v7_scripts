MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

(.'DNLISTA'.)

CrearDialogo
 Fecha1   : 'F.Bajada'  ;1; ;;;;Dialogo.Fecha1<=FSYS ;'Fecha Incorrecta';NO;FSys
 Label1   : ''          ;2; ;;NO;;;;;'Concilia por ______________________________________________________________________'
 Check1   : 'Fecha'     ;3; ;;;;;;;0
 Check2   : 'NrComprob' ;4; ;;;;;;;1
 Check3   : 'Importe'   ;5; ;;;;;;;1
 Cantidad1: 'Tolerancia';5;2;;;Dialogo.Check3=0;;;;1 
 Label1   : ''          ;6;1;;NO;;;;;'_______________________________________________________________________________________'
 Radio2:  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;7;1;;;;;;;4
 Check5:  'Incluye Pagadoras';8;1;;;;;;;1
* Lista1   : 'Archivo'   ; 9;1;;;;;;;;;'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNOTRO'
 Lista1   : 'Archivo'   ; 9;1;;;;;;;;;Val(l:1)
 Lista2   : 'Vehiculos' ; 3;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista3   : 'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
 Check4   : 'Confirma'  ;1;1;1;NO;NO;;;;1
FinDialogo

If Not Ok
   Cancelar
Endif  

*If Vacio(Dialogo.Lista1)
*  ACT(l:1, 'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNOTRO')
*Else
*  ACT(l:1, Dialogo.Lista1)
*Endif

If NoVACIO(Dialogo.Lista1)
   ACT(l:1, Dialogo.Lista1)
Endif

If Vacio(Dialogo.Lista2)
  ACT(l:2, iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1)))
Else
  ACT(l:2, Dialogo.Lista2)
Endif

If Vacio(Dialogo.Lista3)
  ACT(L:3, SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' "))
else
  ACT(l:3, Dialogo.Lista3)
endif

Recorrer&i 1,Elementos(Val(l:2))
  message('Vehiculo: '~ItemLista(Val(l:2),&i))
  Recorrer&j 1,Elementos(Val(l:1))
    message('Archivo: '~ItemLista(Val(l:1),&j))
    EjecutarEvento('CONCM',Vehiculo1=ItemLista(Val(l:2),&i),String=ItemLista(Val(l:1),&j),Fecha1=Dialogo.Fecha1,Check1=Dialogo.check1,Check2=Dialogo.check2,Check3=Dialogo.check3,Cantidad1=Dialogo.Cantidad1, Check4=1,Radio2=Dialogo.Radio2,Check5=Dialogo.Check5, Lista3 = Val(L:3), Lista4='')
  Proximo
Proximo
