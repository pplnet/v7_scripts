Message('Recuperando Movimientos...')
Sqladd(" Select  T.Especie,         T.Cliente1 ClienteTr, T.Fecha1 FechaLiq, T.NrTrans, ")
Sqladd("         T.Fecha2,          T.Fecha4,             T.NrOperacionRef1, ")
Sqladd("         T.TipoTr2,         T.Cliente1,           T.Cantidad1 Cantidad, ")
Sqladd("         T.Cuenta1,         T.Mercado1,           T.Cuenta2,         T.Mercado2, ")
Sqladd("         C.NrAgenteBolsa,   T.RB1,                T.Cliente3,  CU.Numero, ")
Sqladd("         E.ISIN, CU.NrDepositante, C.DeposDelComitente Depositante, CU.Alias2 ")
Sqladd("   From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E, "~Dbo()~".CUENTAS CU   ")
Sqladd("  Where T.Cliente1 = C.Codigo ")
Sqladd("    and T.Cuenta1  = CU.Codigo ")
Sqladd("    and T.Especie  = E.Codigo ")
Sqladd("    and E.Jerarquia like '002%' ")
Sqladd("    and T.Mercado1 In ('CV','A3' )")
Sqladd("    and T.Mercado2 In ('CV','A3') ")
Sqladd("    and ((T.TipoTr2  in ('DTP','RTP') and T.CB6=1) ")
Sqladd("      or (T.TipoTr2  = 'DRT' ) ) ")
Sqladd("    and T.Vehiculo1 = '"~Var('VEHICULODE')~"' ")
Sqladd("    and T.Fecha1    = "~IdxDate2(dialogo.fecha1)~" ")
if (NoVacio(dialogo.mercado1))
Sqladd("    and T.Mercado1 In ('CV','A3')")
Sqladd("    and T.Mercado2 In ('CV','A3') ")
endif
if (NoVacio(dialogo.nrtrans1))
Sqladd(" and T.NrTrans = '"~dialogo.nrtrans1~"' ")
endif
if (NoVacio(dialogo.especie1))
Sqladd(" and (T.Especie = '"~dialogo.especie1~"' or "~Dbo()~".DesciendeDeEspecie(T.Especie,'"~dialogo.especie1~"') = 1) ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" and T.Cliente3 = '"~dialogo.cliente1~"' ")
endif
if (dialogo.check1 = 0)
Sqladd(" and Not Exists(SELECT 1 FROM "~Dbo()~".TRANSFCVA3 CT  ")
Sqladd("                 WHERE CT.NrTrans = T.NrTrans ")
Sqladd("                   AND CT.Especie = T.Especie ")
Sqladd("                   AND CT.Status  = '1' ")
Sqladd("                   AND ABS(IsNull(CT.Monto,0)) >= T.Cantidad1 ) ")
else
Sqladd(" and Exists(SELECT 1 FROM "~Dbo()~".TRANSFCVA3 CT  ")
Sqladd("                 WHERE CT.NrTrans = T.NrTrans ")
Sqladd("                   AND CT.Especie = T.Especie ")
Sqladd("                   AND CT.Status  = '1' ")
Sqladd("                   AND ABS(IsNull(CT.Monto,0)) >= T.Cantidad1 ) ")
endif
Sqladd("Order By 1, 2, 3, 4 ")

Watch(Sqlbatch())
