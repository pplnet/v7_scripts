Sqladd(" M.FechaAcreditacion, M.TipoMov, M.Comprobante, M.Observaciones, M.NrDatanet, ")
Sqladd(" M.Vehiculo, M.NrMovDatanet, ")
Sqladd(" C.Codigo CuentaFPA, CL.Codigo BancoFPA, E.Codigo MonedaFPA, V.Codigo VehiculoFPA ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".DATANET D, "~Dbo()~".CUENTAS C, "~Dbo()~".CLIENTES CL, ")
Sqladd(" "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" WHERE  D.NrDatanet   = M.NrDatanet ")
Sqladd(" AND    M.Cuenta      = C.Numero  (+) ")
Sqladd(" AND    M.Banco       = CL.Alias2 (+) ")
Sqladd(" AND    M.Moneda      = E.Alias3  (+) ")
Sqladd(" AND    M.Vehiculo    = V.Codigo  (+) ")
Sqladd(" AND    D.FechaBajada = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND    D.Archivo     = 'DNCOBR' ")
Sqladd(" AND    D.Estado      = 'A' ")
