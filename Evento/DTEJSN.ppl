* DTEJSN: Ejercico de Opciones de Swaption
CrearDialogo
  Fecha1       : "F Real Ej."               ;1;1;;;;Dialogo.Fecha1>=BuscarCampo('Operaciones','FechaOp2','NrOperacion',Dialogo.NrOperacion1) y Dialogo.Fecha1<=BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1);'FECHA EJERCICIO REAL TIENE QUE ESTAR EN EL PERIODO DEL SWAPTION';NO;Fsys;
  NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTSNFV');'DEBE INGRESAR UNA OPERACION DE TIPO DTSNFV';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'DTSNFV' ")
  Radio3       : "Operacion de|Compra|Venta";;;;NO;;;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
  Radio1       : "Opcion|Europea|Americana|Asiatica" ;;;;NO;;Dialogo.Radio1=1 O [Dialogo.Radio1<>1 Y Dialogo.Fecha1=BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)];'NO SE PUEDE EJERCER EN ESTA FECHA PARA UNA OPCION EUROPEA O ASIATICA';NO;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Fecha2       : "F Reset"                  ;;;;;;ESHABIL(Dialogo.Fecha2,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1)) y ESHABIL(Dialogo.Fecha2,'ARG');'FECHA RESET NO HABIL EN TABLA SELECCIONADA O EN ARGENTINA';SI;;Dialogo.Fecha4
  TipoOp1      : "TipoOp"                   ;;;;NO;NO;;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Fecha3       : "Fecha Inicio Swaption"    ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaOp2','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Fin Swaption"       ;3;2;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and (CB8 is Null or CB8='0') ")  

   Recorrer SQL

     acn(x1,1)

    * asigno algunos valores de la parte fija del swaption para usar luego en el insert
     acn (R1, FBN['Cuotas1'])
     act (R3, FBN['Vehiculo1'])
     ACN (G12, FBN['TotalAux3'])
     ACN (G13, FBN['TotalAux4'])
     ACN (G14, FBN['TotalBrutoCli2'])
     ACN (G15, FBN['TotalBrutoCli3'])


     Message('Actualizando swaption .... ')                  
     *** Marca la operacion como ejercida ***
     SQL.ADD("Update "~DBO~".OPERACIONES ")
     SQL.ADD("Set CB8 = '1', ")
     SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     SQL.EXEC

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)      
   proximo

   If Val(x1)=0
      Cancelar('LA OPERACION N# '~Dialogo.NrOperacion1~' YA FUE EJERCIDA')
   else
       if val(R1)=1
          * caso en el que el swaption tiene 1 vencimiento
            Message(' ---- Generando swap ...')
            SQL.ADD("Select * from "~DBO~".CUOTAS ")
            SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
            SQL.ADD("and NrCuota = 1 ")  
         
            Recorrer SQL
              ACD (G1, FBN['Fecha1'])
              ACN (G2, FBN['Plazo1'])
              ACD (G3, FBN['Fecha2'])
              ACN (G4, FBN['Cantidad1'])
              ACN (G5, FBN['Precio1'])
              ACN (G6, FBN['Cantidad3'])
              ACN (G7, FBN['Cantidad2'])
              ACN (G8, FBN['Precio2'])
              ACN (G9, FBN['Cantidad4'])
              ACD (G11, FBN['Fecha3'])
              ACD (G16, FBN['Fecha4'])
              ACD (G17, FBN['Total3'])
              ACD (G18, FBN['Total4'])

            Proximo

            ACT (Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',val(R3))))
 
            SQL.ADD("Select * from "~DBO~".OPERACIONES ")
            SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

            Recorrer SQL         
               *** Graba la opcion ****
               SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
               SQL.ADD("(TipoOp, NrOperacion, ")
               SQL.ADD(" FechaOp, Vehiculo1, Operador, ")
               SQL.ADD(" Cliente1, Observac2, FechaOp2, ")
               SQL.ADD(" Plazo, RB7, FechaEj, ")
               SQL.ADD(" FechaPago, TablaFeriados1, ")
               SQL.ADD(" RB9, CB9, CB8, ")
               SQL.ADD(" Especie, ContraEspecie, Cantidad, ")
               SQL.ADD(" TotalBrutoCli1, RB8, RB5, ")
               SQL.ADD(" PrecioRef2, PrecioRef3, TipoTasa, ")
               SQL.ADD(" TipoTasa2, Precio3, TotalGanancias, ")
               SQL.ADD(" Spread, TotalNetoCli2, TotalIntereses, ")
               SQL.ADD(" InteresesCorr, TotalAux3, TotalBrutoCli2, ")
               SQL.ADD(" TotalAux4, TotalBrutoCli3, FechaPrecan, ")
               if NoVacio(FBN['FechaEx1'])
                 SQL.ADD(" FechaEx1, FechaEx2, ")
               endif
               SQL.ADD(" Impresa, RB3, ")
               SQL.ADD(" CB7, NrOperacion2) ")
               SQL.ADD("Values")
               SQL.ADD("('DTSFV', '"~VAL(Z3)~"', ")
               SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN['Vehiculo1']~"', '"~FBN['Operador']~"', ")
               SQL.ADD(" '"~FBN['Cliente1']~"', '"~FBN['Observac2']~"', '"~IdxDate(VAL(G1))~"', ")
               SQL.ADD(" "~Fstr(VAL(G2),2,0)~", '1', '"~IdxDate(VAL(G3))~"', ")
               SQL.ADD(" '"~IdxDate(VAL(G11))~"', '"~FBN['TablaFeriados1']~"', ")
               SQL.ADD(" '"~FBN['RB9']~"', '"~FBN['CB9']~"', '0', ")
               SQL.ADD(" '"~FBN['Especie']~"','"~FBN['ContraEspecie']~"',"~Fstr(VAL(G4),0,4)~", ")
               SQL.ADD(" "~Fstr(VAL(G7),0,4)~",'"~FBN['RB8']~"','"~FBN['RB5']~"', ")
               SQL.ADD(" '"~FBN['PrecioRef2']~"','"~FBN['PrecioRef3']~"','"~FBN['TipoTasa']~"', ")
               SQL.ADD(" '"~FBN['TipoTasa2']~"',"~Fstr(VAL(G5), 2, 2)~","~Fstr(VAL(G8), 2, 2)~", ")
               SQL.ADD(" "~Fstr(VAL(G17), 2, 2)~","~Fstr(VAL(G18), 2, 2)~","~Fstr(VAL(G6),0,4)~", ")
               SQL.ADD(" "~Fstr(VAL(G9),0,4)~","~Fstr(fbn['TotalAux3'],0,4)~","~Fstr(fbn['TotalBrutoCli2'],0,4)~", ")
               SQL.ADD(" "~Fstr(fbn['TotalAux4'],0,4)~","~Fstr(fbn['TotalBrutoCli3'],0,4)~", '"~IdxDate(val(g16))~"', ")
                 if NoVacio(FBN['FechaEx1'])
                  SQL.ADD(" '"~IdxDate(FBN['FechaEx1'])~"', '"~IdxDate(FBN['FechaEx2'])~"', ")
                 endif
               SQL.ADD(" '0','1', ")
               SQL.ADD(" '1', '"~fbn['NrOperacion']~"') ")
               SQL.NEW
               SQL.EXEC

               * Alta de Instancias Z3: Nro.Operacion
               (.'ALTAINSTAN'.)
            PROXIMO

       else
          * caso en el que el swaption tiene multiple vencimiento
            Message(' ---- Generando swap ...')

            ACT (Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',val(R3))))
 
            SQL.ADD("Select * from "~DBO~".OPERACIONES ")
            SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

            Recorrer SQL         
               *** Graba la opcion ****
               SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
               SQL.ADD("(TipoOp, NrOperacion, ")
               SQL.ADD(" FechaOp, Vehiculo1, Operador, ")
               SQL.ADD(" Cliente1, Observac2, TablaFeriados1, ")
               SQL.ADD(" RB9, CB9, Cuotas1, ")
               SQL.ADD(" Especie, ContraEspecie, ")
               SQL.ADD(" RB8, RB5, RB7, ")
               SQL.ADD(" PrecioRef2, PrecioRef3, TipoTasa, ")
               SQL.ADD(" TipoTasa2, ")
               SQL.ADD(" TotalAux3, TotalBrutoCli2, ")
               SQL.ADD(" TotalAux4, TotalBrutoCli3, ")
               if NoVacio(FBN['FechaEx1'])
                 SQL.ADD(" FechaEx1, FechaEx2, ")
               endif
               SQL.ADD(" Impresa, RB3, ")
               SQL.ADD(" CB7, NrOperacion2) ")
               SQL.ADD("Values")
               SQL.ADD("('DTSFVM', '"~VAL(Z3)~"', ")
               SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN['Vehiculo1']~"', '"~FBN['Operador']~"', ")
               SQL.ADD(" '"~FBN['Cliente1']~"', '"~FBN['Observac2']~"', '"~FBN['TablaFeriados1']~"', ")
               SQL.ADD(" '"~FBN['RB9']~"', '"~FBN['CB9']~"', "~Fstr(FBN['Cuotas1'],2,0)~", ")
               SQL.ADD(" '"~FBN['Especie']~"','"~FBN['ContraEspecie']~"', ")
               SQL.ADD(" '"~FBN['RB8']~"','"~FBN['RB5']~"', '1', ")
               SQL.ADD(" '"~FBN['PrecioRef2']~"','"~FBN['PrecioRef3']~"','"~FBN['TipoTasa']~"', ")
               SQL.ADD(" '"~FBN['TipoTasa2']~"', ")
               SQL.ADD(" "~Fstr(fbn['TotalAux3'],0,4)~","~Fstr(fbn['TotalBrutoCli2'],0,4)~", ")
               SQL.ADD(" "~Fstr(fbn['TotalAux4'],0,4)~","~Fstr(fbn['TotalBrutoCli3'],0,4)~", ")
                 if NoVacio(FBN['FechaEx1'])
                  SQL.ADD(" '"~IdxDate(FBN['FechaEx1'])~"', '"~IdxDate(FBN['FechaEx2'])~"', ")
                 endif
               SQL.ADD(" '0','1', ")
               SQL.ADD(" '1', '"~fbn['NrOperacion']~"') ")
               SQL.NEW
               SQL.EXEC

              * Alta de Instancias Z3: Nro.Operacion
              (.'ALTAINSTAN'.)
            PROXIMO

            acn(l1, 0)

            SQL.ADD(" INTO "~DBO~".CUOTAS ")
            SQL.ADD(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
            SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
            SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
            SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
            SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
            SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
            SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
            SQL.ADD(" Cantidad5,")
            SQL.ADD(" Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,Cantidad7,Cantidad8, ")
            SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice)  ")

            SQL.ADD(" SELECT '"~VAL(Z3)~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
            SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
            SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
            SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
            SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
            SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,"~Fstr(VAL(l1),0,4)~" As Total2,")
            SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
            SQL.ADD(" Cantidad5,")
            SQL.ADD(" Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,Cantidad7,Cantidad8, ")
            SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice  ")
            SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
            SQL.NEW
            SQL.EXEC
       endif

         *** Actualiza al Swaption respecto a la opcion relacionada ***
         SQL.ADD("Update "~DBO~".OPERACIONES ")
         SQL.ADD("Set NrOperacion2 = '"~val(Z3)~"' ")
         SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
         SQL.NEW
         SQL.EXEC

   endif
endif

