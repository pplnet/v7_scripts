sql.add(" Select O.NrOperacion, O.Precio1, O.Cantidad, O.Vehiculo1, O.FechaOp ")
sql.add("  ")
sql.add(" From "~Dbo()~".OPERACIONES O ")
sql.add(" Where Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND NrSaldo IN ("~Val(y:2)~") ")
if (NoVacio(dialogo.lista1))
sql.add(" AND Vehiculo IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add(" AND Vehiculo Not IN ("~pipe2comillas(Var('VLIQUIDAA'))~") ")
recorrer sql
