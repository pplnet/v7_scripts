Act(av2, Fbn()['Cliente'])

Sqladd("SELECT Codigo FROM  "~Dbo()~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Fbn()['ListaEspecies'])~") ")

recorrer sql

Acn(f:fac, Query("SELECT Tasa from "~Dbo()~".TASASTERCEROS where Vehiculo='"~Val(av1)~"' and Cliente='"~Val(av2)~"' and Especie ='"~Fbn()['Codigo']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

