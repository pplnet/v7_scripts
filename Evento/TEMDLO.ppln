Sqladd("SELECT DISTINCT O.Vehiculo1,O.Cliente1,O.Especie  ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((O.TipoOp='TEMD' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("    or (O.TipoOp='TEMINM' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("    or (O.TipoOp='TEMIND' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"')) ")
if (NoVacio(dialogo.vehiculo1))
Sqladd(" and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and O.Vehiculo1 IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
Sqladd(" and NOT EXISTS ")
Sqladd(" (SELECT * ")
Sqladd("from "~Dbo()~".OPERACIONES Op")
Sqladd("where Op.TipoOp='TEMIND' and Op.FechaOp='"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd("      and Op.Vehiculo1=O.Vehiculo1 and Op.Cliente1=O.Cliente1  and Op.Especie=O.Especie) ")
Sqladd("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

Acn(ab1, 0)

recorrer sql
Message('Procesando Vehiculo: '~Fbn()['Vehiculo1']~' Veh. ContraParte '~Fbn()['Cliente1']~' Especie:'~Fbn()['Especie']~' ...')

Act(av1, Fbn()['Vehiculo1'])
Act(av2, Fbn()['Cliente1'])
Act(ae1, Fbn()['Especie'])
Acd(af1, dialogo.fecha1)

Sqladd("SELECT O.* ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((TipoOp='TEMD' and FechaOp='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='TEMIND' and FechaVto='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='TEMINM' and FechaVto='"~IdxDate(Val(af1))~"')) ")
Sqladd(" and O.Especie='"~Val(ae1)~"' ")
Sqladd(" and ((O.Vehiculo1='"~Val(av1)~"' and O.Cliente1='"~Val(av2)~"') or (O.Vehiculo1='"~Val(av2)~"' and O.Cliente1='"~Val(av1)~"')) ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT TipoOp ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where TipoOp='TEMIND' and FechaOp='"~IdxDate(Val(af1))~"' ")
Sqladd(" and O.Especie ='"~Val(ae1)~"' ")
Sqladd(" and ((O.Vehiculo1='"~Val(av1)~"' and O.Cliente1='"~Val(av2)~"') or (O.Vehiculo1='"~Val(av2)~"' and O.Cliente1='"~Val(av1)~"'))) ")
Sqladd(" Order By O.FechaOp,O.NrOperacion ")

recorrer sql

Dfa()
Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~Fbn()['NrOperacion']~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar("La Operacion '"~Fbn()['NrOperacion']~"' Debe estar en BackOffice o Terminal. Instancia Actual="~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif
proximo




Acn(a1, Query("SELECT Tasa from "~Dbo()~".TASASTERCEROS where Vehiculo='"~Fbn()['Vehiculo1']~"' and Cliente='"~Fbn()['Cliente1']~"' and Especie ='"~Fbn()['Especie']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

