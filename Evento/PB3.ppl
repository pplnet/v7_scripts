CrearDialogo
  Vehiculo1: 'Vehiculo'          ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Cuenta1    :'Cuenta'           ;;;;;;[NoVacio(Dialogo.Cuenta1) y Incluido(Dialogo.Cuenta1, SQLSet(" Select Cuenta From "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo = '"~Dialogo.vehiculo1~"' "))] ;'Cuenta Invalida';NO;;;;;;" Codigo IN (Select Distinct Cuenta From "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo= '"~Dialogo.Vehiculo1~"') ";
  Chequera1  :'Nr.Chequera'      ;;;;;;NoVacio(Dialogo.Chequera1); 'Numero de Chequera Invalida';NO;SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ");SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ");;;;" Cuenta = '"~Dialogo.Cuenta1~"' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ";
  Entero1    :'Nr.Cheque'        ;;;;;;Dialogo.Entero1<>0;'Numero de Cheque Invalido';NO;;;;;'###############';
  String     : 'ESTADO' ;;;;NO;NO;;;;;SQL(" SELECT Estado FROM "~DBO~".CHEQUES WHERE Chequera= '"~Dialogo.Chequera1~"' AND NrCheque = "~fstr(Dialogo.Entero1,0,0)~" ")
  Radio1     : 'Est.Actual|Asignado|Entregado|Pagado|Anulado';;;;NO;;;;;;IIF(Eqstr(Dialogo.String, 'ASI'),0,IIF(Eqstr(Dialogo.String, 'ENT'),1,IIF(Eqstr(Dialogo.String,'PAG'),2,3)))
  Radio2     : 'Est.Nuevo|Asignado|Entregado' ;;;;;;;;;1;
FinDialogo


If Not OK
  Cancelar
Endif

If Dialogo.Radio1=2
  Cancelar('No se puede cambiar el estado de cheques pagados con este evento.')
Endif
If Dialogo.Radio1=3
  Cancelar('No se puede cambiar el estado de cheques anulados con este evento.')
Endif

SQL.ADD(" UPDATE "~DBO~".CHEQUES ")
If Dialogo.Radio2=0
  SQL.ADD(" SET Estado = 'ASI' ")
Else
  SQL.ADD(" SET Estado = 'ENT' ")
Endif
SQL.ADD(" WHERE  Chequera = '"~Dialogo.Chequera1~"' AND NrCheque = "~fstr(Dialogo.Entero1,0,0)~" ")
SQL.NEW
SQL.EXEC

Messagebox('Estado del Cheque actualizado.')