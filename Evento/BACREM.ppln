Acn(ab:1, Query("SELECT CASE WHEN EXISTS (SELECT 1 FROM "~Dbo()~".GRUPOSECONOMICOS WHERE Cliente = '"~dialogo.cliente1~"') THEN 1  ELSE 0 END "))

Sqladd("SELECT O.Cliente1, O.Especie, O.Cuenta1, O.Cliente1, O.Precio1, O.Precio4, O.Cantidad, O.NrOperacion, C.CodigoTasa, C.Codigo, C.TipoCuenta, C.Comitente,  O.FechaOp, O.FechaVto, O.Plazo")
Sqladd("  FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CUENTAS C, "~Dbo()~".OPERACIONESBITS B")
Sqladd(" WHERE O.Cuenta1 = C.Codigo ")
Sqladd("  AND O.TipoOp = 'MMCREM' ")
Sqladd("  AND O.Cliente1 = '"~dialogo.cliente1~"'")
Sqladd("  AND O.Cuenta1 = '"~dialogo.cuenta1~"'")
Sqladd("  AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("  AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("  AND C.TipoCuenta IN ('CA', 'CC') ")
Sqladd("  AND C.Comitente = '"~Var('VEHICULODE')~"'")
Sqladd("  AND O.Especie = '"~dialogo.especie1~"'")
Sqladd("  AND B.NrOperacion = O.NrOperacion")
Sqladd("  AND B.NrBit in(93,70) AND B.Valor = 1")
if (Eqstr(dialogo.string3, 'TEM'))
Sqladd("AND TEM = 'SI'")
else
Sqladd("AND ISNULL(TEM, 'NO') = 'NO'")
endif


recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Query("SELECT Controlante FROM "~Dbo()~".GRUPOSECONOMICOS WHERE Cliente = '"~dialogo.cliente1~"'"))
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Cuenta1'])
Act(e:fac, Fbn()['Especie'])
Act(f:fac, Fbn()['CodigoTasa'])
Acd(g:fac, Fbn()['FechaOp'])
Acd(h:fac, Fbn()['FechaVto'])
Act(i:fac, Fbn()['Plazo'])
Act(j:fac, Fbn()['Cantidad'])
Act(k:fac, Fbn()['Precio1'])
Act(l:fac, Fbn()['Precio4'] - Fbn()['Precio1'])
Acd(m:fac, dialogo.fecha1)
Acn(n:fac, dialogo.fecha1 - Fbn()['FechaOp'])
Acn(o:fac, 1)
Scn(p:1, 1)
proximo


