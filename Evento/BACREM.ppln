Sqladd("SELECT O.NrOperacion, O.Cuenta1, O.Cliente1, O.Precio1, O.Precio4, C.Cliente, C.CodigoTasa, C.Comitente, O.FechaVto, O.Cantidad, O.Especie, O.TipoOp, O.FechaOp, O.Plazo")
Sqladd("  FROM "~Dbo()~".CUENTAS C, "~Dbo()~".GRUPOSECONOMICOS G, "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B")
Sqladd(" WHERE C.Cliente= G.Cliente and C.Codigo = O.Cuenta1")
Sqladd("  AND O.Cliente1 <> '"~dialogo.cliente1~"'")
Sqladd("  AND C.Codigo<>'"~dialogo.cuenta1~"'")
Sqladd("  AND O.TipoOp = 'MMCREM'")
Sqladd("  AND C.TipoCuenta IN ('CA', 'CC')")
Sqladd("  AND C.Comitente = '"~Var('VEHICULODE')~"'")
Sqladd("  AND ISNULL(C.NoRemunerable, 'NO') = 'NO'")
Sqladd("  AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("  AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("  AND O.Especie = '"~dialogo.especie1~"'")
Sqladd("  AND G.Controlante=(SELECT Controlante FROM "~Dbo()~".GRUPOSECONOMICOS WHERE Cliente=(SELECT Cliente from "~Dbo()~".CUENTAS where Codigo='"~dialogo.cuenta1~"'))")
Sqladd("  AND B.NrOperacion = O.NrOperacion")
