creardialogo
fecha1: 'Fecha';;;;;;dialogo.fecha1 <= FSys();'Fecha No debe ser superior a la Fecha del Sistema';SI;FSys()
check1: 'Procesa';;;;SI;;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Acd(x:1, Habiles(dialogo.fecha1, 4, 'ARG'))

SetFilaActual(1)
Act(a:fac, 'TipoOp')
Act(b:fac, 'NrOperacion')
Act(c:fac, 'FechaMov')
Act(d:fac, 'Vehiculo')
Act(e:fac, 'Book')
Act(f:fac, 'Especie')
Act(g:fac, 'Cantidad')
Act(h:fac, 'Precio')
Act(i:fac, 'NrSaldo')
Act(j:fac, 'Exp. en')
Act(k:fac, 'Cotizacion')
Act(l:fac, 'Count(*)')
Act(m:fac, 'Accion')

SetFont(a:fac..m:fac, 2)

sql.add("Select M.*, O.TipoOp ")
sql.add("  From "~Dbo()~".MOVPOSPEN M, "~Dbo()~".OPERACIONES O ")
sql.add(" Where M.NrOperacion=O.NrOperacion ")
sql.add("   and O.TipoOp like 'MM%' ")
sql.add("   and M.Especie Not in ('ARP','USD') ")
sql.add("   and M.NrSaldo in (122,132) ")
sql.add("   and M.FechaMov < '"~IdxDate(Val(x:1))~"' ")
sql.add("   Order by M.FechaMov,M.NrSaldo ")
recorrer sql
Act(a:fac, Fbn('TipoOp'))
Act(b:fac, Fbn('NrOperacion'))
Acd(c:fac, Fbn('FechaMov'))
Act(d:fac, Fbn('Vehiculo'))
Act(e:fac, Fbn('Book'))
Act(f:fac, Fbn('Especie'))
Acn(g:fac, Fbn('Cantidad'))
Acn(h:fac, Fbn('Precio'))
Acn(i:fac, Fbn('NrSaldo'))
if (Fbn('NrSaldo') = 122)
Act(j:fac, 'ARP')
else
Act(j:fac, 'USD')
endif
Acn(k:fac, CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaMov') - 1, 1, SI, Val(j:fac)))
Acn(l:fac, sql("Select Count(*) from "~Dbo()~".MOVPOSPEN where NrOperacion='"~Val(b:fac)~"' and FechaMov='"~IdxDate(Fbn('FechaMov'))~"' and Especie='"~Fbn('Especie')~"' and NrSaldo = "~Fbn('NrSaldo')~" and Cantidad="~Fbn('Cantidad')~" "))
if (Val(l:fac) = 1)
if (dialogo.check1 = 1)
Act(m:fac, 'Actulizado')
sql.add("Update "~Dbo()~".MOVPOSPEN ")
sql.add("   Set Precio      = "~Val(k:fac)~" ")
sql.add(" where NrOperacion = '"~Val(b:fac)~"' ")
sql.add("   and FechaMov    = '"~IdxDate(Fbn('FechaMov'))~"' ")
sql.add("   and Especie     = '"~Fbn('Especie')~"' ")
sql.add("   and NrSaldo     = "~Fbn('NrSaldo')~" ")
sql.add("   and Cantidad    = "~Fbn('Cantidad')~" ")
sql.new
sql.exec
endif
else
Act(m:fac, 'Error en Count')
endif
proximo

SetFont(x:1, 1)
if (Fac() > 1)
SetFont(a:2..m:fac, 1)
FormatoCeldas(g:2..g:fac, exe('F2'))
FormatoCeldas(h:2..h:fac, exe('F8'))
FormatoCeldas(i:2..i:fac, exe('F0'))
FormatoCeldas(k:2..k:fac, exe('F8'))
endif

