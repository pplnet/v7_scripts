fecha1:'Fecha';1;;;;;EsHabil(dialogo.fecha1, 'ARG') y NoVacio(dialogo.fecha1);'La fecha debe ser un dia habil';NO;FSys();
lista1:'Vehiculos';3;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
check1:'Contab.Procesada';;;;NO;NO;
findialogo

if (not ok)
Cancelar()
endif

let(&monedalocal, Var('MONELOCA'))

Sqladd("Select S.Fecha,S.Saldo,S.EnteCustodia as 'Vehiculo', S.Especie as 'Moneda' ")
Sqladd("FROM "~Dbo()~".SALDOSDIA S ")
Sqladd(" WHERE   S.Fecha IN (SELECT MAX(SD.Fecha) FROM "~Dbo()~".SALDOSDIA SD")
Sqladd("                   WHERE SD.NrSaldo = S.NrSaldo  ")
Sqladd("                   AND SD.EnteCustodia = S.EnteCustodia ")
Sqladd("                   AND SD.Especie = S.Especie ")
Sqladd("                   AND SD.Fecha  <= '"~IdxDate(dialogo.fecha1)~"') ")
if (NoVacio(dialogo.lista1))
Sqladd(" and S.EnteCustodia IN ("~Pipe2Comillas(dialogo.lista1)~")")
endif
Sqladd("and NrSaldo = '50'")
Sqladd("and S.Especie <> '"~&monedalocal~"'")
Sqladd("Order By Vehiculo,Fecha")

recorrer sql
let(&monto, Fbn('Saldo'))
let(&fechadc, Fbn('Fecha'))
let(&fechadesde, &fechadc - 1)
let(&moneda, Fbn('Moneda'))
let(&tipocotizacion, 0)
let(&tipocambio, 2)
if (&tipocotizacion = 0)
let(&dc, ((&monto * CotizacionBNA(&monedacot, &fechadc, &tipocambio, NO, NO)) - (&monto * CotizacionBNA(&monedacot, &fechadesde, &tipocambio, NO, NO))))
let(&hoy, CotizacionBNA(&monedacot, &fechadc, &tipocambio, NO, NO))
let(&ayer, CotizacionBNA(&monedacot, &fechadesde, &tipocambio, NO, NO))
else
let(&dc, ((&monto * Cotizacion(&monedacot, null, null, null, &fechadc, &tipocambio)) - (&monto * Cotizacion(&monedacot, null, null, null, &fechadesde, &tipocambio))))
endif

proximo
