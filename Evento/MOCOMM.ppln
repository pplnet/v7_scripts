Sqladd("Select O.NrOperacion, O.TipoOp, O.PrecioEj, O.FechaOp, O.FechaOp2, ")
Sqladd("C.* ")
Sqladd("from "~Dbo()~".OPERACIONES O, "~Dbo()~".COMISIONES2 C")
Sqladd("where O.NrOperacion=C.NrOperacion  and C.Importe1<>0 and")
Sqladd("C.Tipo='4' and O.NrOperacion='"~dialogo.nroperacion1~"' ")
Sqladd(" order by O.NrOperacion,C.Fecha1")

recorrer sql

