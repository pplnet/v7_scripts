creardialogo
nroperacion1: '# Pase :';;;;;;Vacio(dialogo.nroperacion1) o Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'TIPA|TIPP');'Debe ingresar un pase.';NO;;;;;;"TipoOp in ('TIPA','TIPP') "
fecha1:'Fecha';;;;;;dialogo.fecha1 <= FSys();'La Fecha NO DEBE ser superior a la fecha del sistema';NO;FSys()
check1:'Procesa';1;2;;NO;SI;;;;1;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)
Act(a:fac, 'NrOperacion')
Act(b:fac, 'TipoOp')
Act(c:fac, 'Fecha')
Act(d:fac, 'Plazo')
Act(e:fac, 'Cliente')
Act(f:fac, 'Especie')
Act(g:fac, 'Cantidad')
Act(h:fac, 'Instancias')
Act(i:fac, 'Anula')
Act(j:fac, 'Cant patas')
Act(k:fac, 'No Mercado')
Act(l:fac, 'Oferta')
Act(m:fac, 'Nro Alta')
Act(n:fac, 'Nro Baja')
Act(o:fac, 'Elem Inst')
Act(p:fac, 'Nom Inst')
Act(q:fac, 'Control')
Act(r:fac, 'Mensaje error')

SetFont(a:fac..u:fac, 2)

Act(aa:fac, 'Op Spot')
Act(ab:fac, 'NrOperacion')
Act(ac:fac, 'TipoOp')
Act(ad:fac, 'Instancias')
Act(ae:fac, 'Movs ejec.')
Act(af:fac, 'Liquidada')
Act(ag:fac, 'Elem Inst')
Act(ah:fac, 'Nom Inst')

Act(aj:fac, 'Op Futu')
Act(ak:fac, 'NrOperacion')
Act(al:fac, 'TipoOp')
Act(am:fac, 'Instancias')
Act(an:fac, 'Movs ejec.')
Act(ao:fac, 'Liquidada')
Act(ap:fac, 'Elem Inst')
Act(aq:fac, 'Nom Inst')

SetFont(aa:fac..az:fac, 2)

Message('----- Enviando Baja Op '~dialogo.nroperacion1)
sql.add("Select * from "~Dbo()~".OPERACIONES ")
sql.add(" Where TipoOp in ('TIPA','TIPP') ")
if (NoVacio(dialogo.nroperacion1))
sql.add(" and NrOperacion = '"~dialogo.nroperacion1~"' ")
else
sql.add(" and FechaOp = "~IdxDate2(dialogo.fecha1)~" ")
endif
sql.add(" order by NrOperacion ")
recorrer sql
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acn(d:fac, Fbn('Plazo'))
Act(e:fac, Fbn('Cliente1'))
Act(f:fac, Fbn('Especie'))
Acn(g:fac, Fbn('Cantidad'))
Act(h:fac, SQLSet("SELECT NrBit FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion = '"~Fbn('NrOperacion')~"' AND Valor = '1'"))
Acn(i:fac, 0)
Acn(q:fac, 0)
Acn(k:fac, Fbn('CB7'))
Acn(l:fac, Fbn('CB5'))
Act(m:fac, Fbn('NroAltaMAE'))
Act(n:fac, Fbn('NroBajaMAE'))

Act(aa:fac, Fbn('NrOperacion3'))
Act(aj:fac, Fbn('NrOperacion4'))
sql.add("Select * from "~Dbo()~".OPERACIONES ")
sql.add(" Where TipoOp in ('TIC','TIV','TIFC','TIFV') ")
sql.add("   and OperacionRef = '"~Val(a:fac)~"' ")
sql.add("   and PaseCB       = '1' ")
recorrer sql
Dfa()
Scn(j:fac, 1)
if (Incluido(Fbn('TipoOp'), 'TIC|TIV'))
Acn(x:1, 1)
else
Acn(x:1, 10)
endif
Act(27 + Val(x:1):fac, Fbn('NrOperacion'))
Act(28 + Val(x:1):fac, Fbn('TipoOp'))
Act(29 + Val(x:1):fac, SQLSet("SELECT NrBit FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion = '"~Fbn('NrOperacion')~"' AND Valor = '1'"))
Acn(30 + Val(x:1):fac, sql("SELECT COUNT(*) FROM "~Dbo()~".MOVEJECUTADOS WHERE NrOperacion = '"~Fbn()['NrOperacion']~"' AND NrSaldo <> 9 "))
if (Val(30 + Val(x:1):fac) > 0)
Act(31 + Val(x:1):fac, 'SI')
else
Act(31 + Val(x:1):fac, 'NO')
endif
proximo

Acn(o:fac, Elementos(Val(h:fac)))
if (Val(o:fac) = 1)
Act(p:fac, sql("SELECT Nombre FROM "~Dbo()~".INSTANCIAS WHERE TABlA = 'OPERACIONES' AND NrInstancia = "~FStr(ItemLista(Val(h:fac), 1), 1, 0)~" "))
else
if (Val(o:fac) = 0)
Act(p:fac, 'Sin Instancia')
else
Act(p:fac, Val(h:fac))
endif
endif

if (NoVacio(Val(ab:fac)))
Acn(ag:fac, Elementos(Val(ad:fac)))
if (Val(ag:fac) = 1)
Act(ah:fac, sql("SELECT Nombre FROM "~Dbo()~".INSTANCIAS WHERE TABlA = 'OPERACIONES' AND NrInstancia = "~FStr(ItemLista(Val(ad:fac), 1), 1, 0)~" "))
else
if (Val(ag:fac) = 0)
Act(ah:fac, 'Sin Instancia')
else
Act(ah:fac, Val(ad:fac))
endif
endif
endif

if (NoVacio(Val(ak:fac)))
Acn(ap:fac, Elementos(Val(am:fac)))
if (Val(ap:fac) = 1)
Act(aq:fac, sql("SELECT Nombre FROM "~Dbo()~".INSTANCIAS WHERE TABlA = 'OPERACIONES' AND NrInstancia = "~FStr(ItemLista(Val(am:fac), 1), 1, 0)~" "))
else
if (Val(ap:fac) = 0)
Act(aq:fac, 'Sin Instancia')
else
Act(aq:fac, Val(am:fac))
endif
endif
endif

proximo

if (Fac() = 1)
Acn(z:1, 1)
Messagebox('No exisen pases para anular')
if (dialogo.check1 = 1)
Cancelar()('')
endif
else
crearlistbox;'MS Sans SerIf,8,'
'Confirma';i:2..i:fac;SI;SI;;60;check;RGB(255, 255, 213);;
'Operacion';a:2..a:fac;NO;SI;;60;string;;RGB(232, 232, 255);
'TipoOp';b:2..b:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'FechaOp';c:2..c:fac;NO;SI;;70;fecha;RGB(232, 232, 255);
'Plazo';d:2..d:fac;NO;SI;;40;string;;RGB(232, 232, 255);
'Cliente';e:2..e:fac;NO;SI;;100;string;;RGB(232, 232, 255)
'Especie';f:2..f:fac;NO;SI;;100;string;;RGB(232, 232, 255);
'Cantidad';g:2..g:fac;NO;SI;;80;numero;'##,###,###.##';RGB(232, 232, 255);
'No Mercado';k:2..k:fac;NO;SI;;80;check;RGB(232, 232, 255);;
'Oferta';l:2..l:fac;NO;SI;;60;check;RGB(232, 232, 255);;
'Inst.Pase';p:2..p:fac;NO;SI;;120;string;;RGB(232, 232, 255);
'Op.Spot';aa:2..aa:fac;NO;SI;;60;string;;RGB(232, 232, 255);
'Tipo Op Spot';ac:2..ac:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'Liquid';af:2..af:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'Inst.Op Spot';ah:2..ah:fac;NO;SI;;120;string;;RGB(232, 232, 255);
'Op.Futuro';aj:2..aj:fac;NO;SI;;60;string;;RGB(232, 232, 255);
'Tipo Op Fut';al:2..al:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'Liquid.';ao:2..ao:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'Inst.Op Futuro';aq:2..aq:fac;NO;SI;;120;string;;RGB(232, 232, 255);
finlistbox

if (not ok)
if (dialogo.check1 = 1)
Cancelar()('Evento Cancelado.')
else
Messagebox('Evento Cancelado. No Procesa')
endif
Acn(z:1, 1)
endif

if (Val(z:1) = 0)
recorrer&i 2, Fac()
if (Val(i:&i) = 1)
if (Val(q:&i) = 0)
if (Incluido('30', Val(h:&i)))
Acn(q:&i, 1)
Act(r:&i, 'Pase ya se encuentra en la instancia Anualcion Manual (30).')
endif
endif
if (Val(q:&i) = 0)
if (Eqstr(Val(af:&i), 'SI'))
Acn(q:&i, 1)
Act(r:&i, 'Operacion Spot '~Val(ab:&i)~' esta liquidada.')
endif
endif
if (Val(q:&i) = 0)
if (Eqstr(Val(ao:&i), 'SI'))
Acn(q:&i, 1)
Act(r:&i, 'Operacion Futuro '~Val(ak:&i)~' esta liquidada.')
endif
endif
if (Val(q:&i) = 0)
if (Val(j:&i) = 1)
Acn(q:&i, 1)
Act(r:&i, 'Pase con una sola operacion relacionada')
endif
endif
if (Val(q:&i) = 0)
if (Val(j:&i) > 2)
Acn(q:&i, 1)
Act(r:&i, 'Pase con mas de 2 operaciones relacionadas')
endif
endif
if (Val(q:&i) = 0)
if (Val(k:&i) = 0 y NO)
Acn(q:&i, 1)
Act(r:&i, 'Operacion de MAE')
endif
endif
if (Val(q:&i) = 0)
if (Val(l:&i) = 1)
Acn(q:&i, 1)
Act(r:&i, 'Pase por oferta de MAE')
endif
endif

if (Val(q:&i) = 0)
if (dialogo.check1 = 1)
sql.add(" UPDATE "~Dbo()~".OPERACIONES ")
sql.add(" SET Direccion = 1, ")
sql.add("     Rojo = 1, ")
sql.add("     RB7  = 1 ")
sql.add(" Where NrOperacion= '"~Val(a:&i)~"' ")
sql.new
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("   SET Valor = '0' ")
sql.add(" Where NrOperacion = '"~Val(a:&i)~"' ")
sql.new
sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("   SET Valor = '1' ")
sql.add(" where NrOperacion= '"~Val(a:&i)~"' ")
if (Val(k:&i) = 1)
sql.add("   and NrBit = 30 ")
else
sql.add("   and NrBit = 74 ")
endif
sql.new
sql.exec
else
if (Val(k:&i) = 1)
Messagebox('Pone operacion '~Val(a:&i)~' en Anlulacion (30)')
else
Messagebox('Pone operacion '~Val(a:&i)~' en Auxiliar Baja Paeses (74)')
endif
endif
if (Val(j:&i) = 2)
if (dialogo.check1 = 1)
ejecutarevento('BAJPAT', nroperacion1 = Val(a:&i), string1 = Val(h:&i), check1 = dialogo.check1)
else
Messagebox('Ejecuta BAJPAT para operacion '~Val(a:&i))
endif
endif
else
Messagebox('La operacion '~Val(a:&i)~' no puede anularse. '~Val(r:&i))
endif
endif
proximo
endif
endif

