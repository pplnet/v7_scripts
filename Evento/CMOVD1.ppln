Sqladd(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
Sqladd(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'DIR' Tipo, T.NrTrans, ")
Sqladd(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
Sqladd(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
Sqladd(" T.Mercado4, T.Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4 ")
Sqladd(" from  "~Dbo()~".TRANSACCIONES2 T WITH (NOLOCK),"~Dbo()~".ESPECIES E WITH (NOLOCK), "~Dbo()~".CUENTAS CT WITH (NOLOCK), "~Dbo()~".MOVPENDIENTES M  WITH (NOLOCK INDEX = INDMP1) ")
Sqladd(" where T.NrTrans=M.NrOperacion AND T.Fecha1<="~IdxDate2(dialogo.fecha1))
Sqladd("  and  T.TipoTr2  In ('DTP','RTP') ")
Sqladd("  and  T.RB2=0 ")
Sqladd("  and  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("  and  T.Cuenta1   = M.Cuenta ")
Sqladd("  and  M.NrSaldo   = 101 ")
Sqladd("  and ((T.TipoTr2  In ('DTP') and M.Cantidad > 0) ")
Sqladd("    or (T.TipoTr2  In ('RTP') and M.Cantidad <= 0)) ")
Sqladd("  and  Abs(M.Cantidad) = T.Cantidad1 ")
Sqladd("  and  M.Especie   = E.Codigo ")
if (NoVacio(dialogo.lista2))
Sqladd("and E.Codigo    Not  IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.mercado1))
Sqladd(" and  M.Mercado   = '"~dialogo.mercado1~"' ")
endif
Sqladd("  and  M.Cuenta    = CT.Codigo ")
if (NoVacio(dialogo.nrtrans1))
Sqladd("  and  T.NrTrans = '"~dialogo.nrtrans1~"'  ")
endif
Sqladd("UNION ALL ")
Sqladd(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
Sqladd(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'INV' Tipo, T.NrTrans, ")
Sqladd(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
Sqladd(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
Sqladd(" T.Mercado4, T.Cuenta1 as Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4")
Sqladd(" from  "~Dbo()~".TRANSACCIONES2 T WITH (NOLOCK),"~Dbo()~".ESPECIES E WITH (NOLOCK), "~Dbo()~".CUENTAS CT WITH (NOLOCK), "~Dbo()~".MOVPENDIENTES M WITH (NOLOCK INDEX = INDMP1) ")
Sqladd(" where T.NrTrans   = M.NrOperacion AND T.Fecha1    <= "~IdxDate2(dialogo.fecha1))
Sqladd("  and  T.TipoTr2  In ('DTP','RTP') ")
Sqladd("  and  T.RB2=0 ")
Sqladd("  and  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("  and  T.CB1       ='1' ")
Sqladd("  and ((T.CB2 = 1)  ")
Sqladd("   or  (T.Mercado4 = CT.Alias1))  ")
Sqladd("  and  T.Cuenta2   = M.Cuenta ")
Sqladd("  and  M.NrSaldo   = 101 ")
Sqladd("  and ((T.TipoTr2  In ('DTP') and M.Cantidad < 0) ")
Sqladd("    or (T.TipoTr2  In ('RTP') and M.Cantidad >= 0)) ")
Sqladd("  and  Abs(M.Cantidad) = T.Cantidad1 ")
Sqladd("  and  M.Especie   = E.Codigo ")
if (NoVacio(dialogo.lista2))
Sqladd("and E.Codigo    Not IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.mercado1))
