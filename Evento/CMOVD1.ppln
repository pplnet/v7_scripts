sql.add("  and  M.Cuenta    = CT.Codigo ")
if (NoVacio(dialogo.nrtrans1))
sql.add("  and  T.NrTrans = '"~dialogo.nrtrans1~"'  ")
endif
sql.add("Order by 1,5,M.Cuenta, T.Cantidad1 ")
