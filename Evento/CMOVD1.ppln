sql.add(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
sql.add(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'DIR' Tipo, T.NrTrans, ")
sql.add(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
sql.add(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
sql.add(" T.Mercado4, T.Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4 ")
sql.add(" from  "~Dbo()~".TRANSACCIONES2 T WITH (NOLOCK),"~Dbo()~".ESPECIES E WITH (NOLOCK), "~Dbo()~".CUENTAS CT WITH (NOLOCK), "~Dbo()~".MOVPENDIENTES M  WITH (NOLOCK INDEX = INDMP1) ")
sql.add(" where T.NrTrans=M.NrOperacion AND T.Fecha1<="~IdxDate2(dialogo.fecha1))
sql.add("  and  T.TipoTr2  In ('DTP','RTP') ")
sql.add("  and  T.RB2=0 ")
sql.add("  and  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
sql.add("  and  T.Cuenta1   = M.Cuenta ")
sql.add("  and  M.NrSaldo   = 101 ")
sql.add("  and ((T.TipoTr2  In ('DTP') and M.Cantidad > 0) ")
sql.add("    or (T.TipoTr2  In ('RTP') and M.Cantidad <= 0)) ")
sql.add("  and  Abs(M.Cantidad) = T.Cantidad1 ")
sql.add("  and  M.Especie   = E.Codigo ")
if (NoVacio(dialogo.lista2))
sql.add("and E.Codigo    Not  IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.mercado1))
sql.add(" and  M.Mercado   = '"~dialogo.mercado1~"' ")
endif
sql.add("  and  M.Cuenta    = CT.Codigo ")
if (NoVacio(dialogo.nrtrans1))
sql.add("  and  T.NrTrans = '"~dialogo.nrtrans1~"'  ")
endif
sql.add("UNION ALL ")
sql.add(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
sql.add(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'INV' Tipo, T.NrTrans, ")
sql.add(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
sql.add(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
sql.add(" T.Mercado4, T.Cuenta1 as Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4")
sql.add(" from  "~Dbo()~".TRANSACCIONES2 T WITH (NOLOCK),"~Dbo()~".ESPECIES E WITH (NOLOCK), "~Dbo()~".CUENTAS CT WITH (NOLOCK), "~Dbo()~".MOVPENDIENTES M WITH (NOLOCK INDEX = INDMP1) ")
sql.add(" where T.NrTrans   = M.NrOperacion AND T.Fecha1    <= "~IdxDate2(dialogo.fecha1))
sql.add("  and  T.TipoTr2  In ('DTP','RTP') ")
sql.add("  and  T.RB2=0 ")
sql.add("  and  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
sql.add("  and  T.CB1       ='1' ")
sql.add("  and ((T.CB2 = 1)  ")
sql.add("   or  (T.Mercado4 = CT.Alias1))  ")
sql.add("  and  T.Cuenta2   = M.Cuenta ")
sql.add("  and  M.NrSaldo   = 101 ")
sql.add("  and ((T.TipoTr2  In ('DTP') and M.Cantidad < 0) ")
sql.add("    or (T.TipoTr2  In ('RTP') and M.Cantidad >= 0)) ")
sql.add("  and  Abs(M.Cantidad) = T.Cantidad1 ")
sql.add("  and  M.Especie   = E.Codigo ")
if (NoVacio(dialogo.lista2))
sql.add("and E.Codigo    Not IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.mercado1))
