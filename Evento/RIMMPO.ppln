creardialogo
nroperacion1: 'IMM';1;1;;;;NoVacio(dialogo.nroperacion1);'';NO;;;;;;" TipoOp = 'IMM' "
nroperacion2: 'Prestamo';2;1;;;;NoVacio(dialogo.nroperacion2) o dialogo.radio1 = 2;'';NO;;;;;;" TipoOp in ('PMU','PME') "
book1:'Book';3;1;;;;NoVacio(dialogo.book1) o dialogo.radio1 = 2;'';NO;;;;;;
radio1: 'Tipo|Nada|Pone|Quita';4;1;;;;;;;1
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 1)
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set NrOperacion2 = '"~dialogo.nroperacion2~"', ")
Sqladd("       ObsErrorMAE  = '"~dialogo.book1~"' ")
Sqladd(" Where NrOperacion  = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos3(dialogo.nroperacion1, NO, NO, NO, NO, SI, 0)
Sqlexec()
endif

if (dialogo.radio1 = 2)
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set NrOperacion2 = NULL, ")
Sqladd("       ObsErrorMAE  = NULL ")
Sqladd(" Where NrOperacion  = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos3(dialogo.nroperacion1, NO, NO, NO, NO, SI, 0)
Sqlexec()
endif

