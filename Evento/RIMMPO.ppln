creardialogo
nroperacion1: 'IMM';1;1;;;;NoVacio(dialogo.nroperacion1);'';NO;;;;;;" TipoOp = 'IMM' "
nroperacion2: 'Prestamo';2;1;;;;NoVacio(dialogo.nroperacion2) o dialogo.radio1 = 2;'';NO;;;;;;" TipoOp in ('PMU','PME') "
book1:'Book';3;1;;;;NoVacio(dialogo.book1) o dialogo.radio1 = 2;'';NO;;;;;;
radio1: 'Tipo|Nada|Pone|Quita';4;1;;;;;;;1
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 1)
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set NrOperacion2 = '"~dialogo.nroperacion2~"', ")
sql.add("       ObsErrorMAE  = '"~dialogo.book1~"' ")
sql.add(" Where NrOperacion  = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec
sql.actualizarmovimientos3(dialogo.nroperacion1, NO, NO, NO, NO, SI, 0)
sql.exec
endif

if (dialogo.radio1 = 2)
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set NrOperacion2 = NULL, ")
sql.add("       ObsErrorMAE  = NULL ")
sql.add(" Where NrOperacion  = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec
sql.actualizarmovimientos3(dialogo.nroperacion1, NO, NO, NO, NO, SI, 0)
sql.exec
endif

