creardialogo

fecha1:'Fecha';;;;;;;;SI;FSys()

findialogo

let(&especie, null)
let(&fecha, null)
let(&fecha, null)
sql.add("SELECT SUBSTRING(COdigo , 1, 6) AS TipoTasa, SUBSTRING(COdigo , 7, 6) AS Especie, SUBSTRING(COdigo , 12, 11) AS Fecha")
sql.add("FROM "~Dbo()~".PMAUDIT WHERE Fecha >= '"~IdxDate(dialogo.fecha1)~"' AND Tabla = 'TASASDIA' AND Campo = 'Valor1' AND SUBSTRING(COdigo , 1, 6)IN ('TNA','TEM','TRANSF')")
sql.add("GROUP BY SUBSTRING(COdigo , 1, 6)  , SUBSTRING(COdigo , 7, 6) ,SUBSTRING(COdigo , 12, 11) ")

recorrer sql

&especie := Fbn()['Especie']
&fecha := Fbn()['Fecha']

sql.add("SELECT NrOperacion,TipoOp,'TNA' TipoTasa,Plazo FROM "~Dbo()~".OPERACIONES WHERE")
sql.add("FechaOp >= '"~&fecha~"' AND Especie = '"~&especie~"' AND FechaVto > "~IdxDate2(dialogo.fecha1)~"")
sql.add("AND TipoOp IN ('MMCO', 'MMCT')")
sql.add("UNION ALL")
sql.add(" SELECT NrOperacion,TipoOp, TipoTasa,1 Plazo FROM "~Dbo()~".OPERACIONES WHERE")
sql.add("FechaOp >= '"~&fecha~"' AND Especie = '"~&especie~"' AND")
sql.add("TipoOp = 'MMCREM' AND (FechaVto <= "~IdxDate2(dialogo.fecha1)~" OR FechaVto IS NULL)")

recorrer sql

Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Fbn()['TipoOp'])
Act(c:fac, Fbn()['TipoTasa'])
Act(d:fac, Fbn()['NrOperacion'])

sql.add(" UPDATE "~Dbo()~".OPERACIONES ")
if (Eqstr(Var('BASEXPILAR'), 'SI'))

sql.add("SET PRECIO4 = "~Dbo()~".ObtenerTasaTransferencia("~IdxDate2(&fecha)~",'"~Fbn()['TipoTasa']~"','"~&especie~"',"~Fbn()['Plazo']~")")
else
Acn(i:fac, TasaDia(Var('TASATRANSF'), &especie, &fecha, Fbn()['Plazo'], 1))
sql.add("SET PRECIO4 = '"~Val(i:fac)~"'")


endif

sql.add("Where NrOperacion ='"~Val(a:fac)~"'")
sql.new

