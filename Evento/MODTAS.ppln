fecha1:'Fecha';;;;;;;;SI;FSys()

findialogo

let(&especie, null)
let(&fecha, null)
let(&fecha, null)
Sqladd("SELECT SUBSTRING(COdigo , 1, 6) AS TipoTasa, SUBSTRING(COdigo , 7, 6) AS Especie, SUBSTRING(COdigo , 12, 11) AS Fecha")
Sqladd("FROM "~Dbo()~".PMAUDIT WHERE Fecha >= '"~IdxDate(dialogo.fecha1)~"' AND Tabla = 'TASASDIA' AND Campo = 'Valor1' AND SUBSTRING(COdigo , 1, 6)IN ('TNA','TEM','TRANSF')")
Sqladd("GROUP BY SUBSTRING(COdigo , 1, 6)  , SUBSTRING(COdigo , 7, 6) ,SUBSTRING(COdigo , 12, 11) ")

recorrer sql

&especie := Fbn()['Especie']
&fecha := Fbn()['Fecha']

Sqladd("SELECT NrOperacion,TipoOp,'TNA' TipoTasa,Plazo FROM "~Dbo()~".OPERACIONES WHERE")
Sqladd("FechaOp >= '"~&fecha~"' AND Especie = '"~&especie~"' AND FechaVto > "~IdxDate2(dialogo.fecha1)~"")
Sqladd("AND TipoOp IN ('MMCO', 'MMCT')")
Sqladd("UNION ALL")
Sqladd(" SELECT NrOperacion,TipoOp, TipoTasa,1 Plazo FROM "~Dbo()~".OPERACIONES WHERE")
Sqladd("FechaOp >= '"~&fecha~"' AND Especie = '"~&especie~"' AND")
Sqladd("TipoOp = 'MMCREM' AND (FechaVto <= "~IdxDate2(dialogo.fecha1)~" OR FechaVto IS NULL)")

recorrer sql

Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Fbn()['TipoOp'])
Act(c:fac, Fbn()['TipoTasa'])
Act(d:fac, Fbn()['NrOperacion'])

Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
if (Eqstr(Var('BASEXPILAR'), 'SI'))

Sqladd("SET PRECIO4 = "~Dbo()~".ObtenerTasaTransferencia("~IdxDate2(&fecha)~",'"~Fbn()['TipoTasa']~"','"~&especie~"',"~Fbn()['Plazo']~")")
else
Acn(i:fac, TasaDia(Var('TASATRANSF'), &especie, &fecha, Fbn()['Plazo'], 1))
Sqladd("SET PRECIO4 = '"~Val(i:fac)~"'")


endif

Sqladd("Where NrOperacion ='"~Val(a:fac)~"'")
