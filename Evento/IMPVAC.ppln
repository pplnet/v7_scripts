creardialogo
fecha1: 'F.Trans';;;;;;;;;FSys()
check3: 'Impresora';
findialogo

if (not ok)
Cancelar()
endif
Sqladd(" Select T.NrTrans,T.Fecha2,T.Cliente1,T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, ")
Sqladd("        T.Mercado1 ,T.CB1, T.CB5                                              ")
Sqladd("   from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O ")
Sqladd(" where  T.NrTrans = O.NrOperacion ")
Sqladd(" and    O.NrBit In (3,6,51,70) and O.Valor ='1'      ")
Sqladd(" and    T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and    T.TipoTr2 In ('PDIVID','CANJE','STOCK') ")
Sqladd(" and    T.Cambio5 = 101 ")
Sqladd(" order by T.NrTrans ")

Watch(Sqlbatch())
Acn(z1, 0)
recorrer sql
Scn(z1, 1)
Act(a:Val(z1), Fbn()['NrTrans'])
Act(b:Val(z1), Fbn()['Fecha2'])
Act(c:Val(z1), Fbn()['Cliente1'])
Act(d:Val(z1), Fbn()['TipoTr2'])
Act(e:Val(z1), Fbn()['Especie'])
Acn(f:Val(z1), Abs(Fbn()['Cantidad1']))

Act(ab:Val(z1), Fbn()['CB5'])

proximo

if (Val(z1) = 0)
Cancelar('No existen Vouchers para imprimir')
else
ACO(1, 9)
ACO(2, 11)
ACO(3, 11)
ACO(4, 7)
ACO(5, 11)
ACO(6, 15)
FormatoCeldas(f1..f:Val(z1), Exe('F2'))

* listbox stripped

if (ok)
* recorrersel stripped

































endif
endif

