Acn(vm:17, Val(vm:21) + Val(vm:22))
Acn(vm:9, Val(vm:3) - Val(vm:12))
Acn(vm:6, Val(cp:5) + Val(vm:3))
Acn(vm:13, Val(vm:6) - Val(vm:12))
Acn(vu:13, Val(cp:3) * CotizacionC(Fbn()['Esp'], null, null, null, Fbn()['FIni'], 1, SI, Var('MONEEXTR')))
Acn(vu:29, Val(cp:3) * Fbn()['DT'] / 100)
Acn(vm:23, Val(cp:3) - Fbn()['COri'])
endif


if (Eqstr(Fbn()['Tipo'], 'MMPCLM'))

Acn(vm:2, iif (Fbn()['RB6'] = 1, ((Val(cp:3) * Fbn()['To5'] * Fbn()['Pl']) / iif (Fbn()['MB1'] = 0, 36000, 36500)) * (Fbn()['Pr3'] / 100), 0))
Acn(vm:3, iif (Fbn()['Cuota'] < Fbn()['PG'], 0, Val(cp:3) * ((Fbn()['Sp'] + Fbn()['Pr2']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)))
Acn(vm:4, iif (Fbn()['Cuota'] < Fbn()['PG'], 0, Val(cp:3) * ((Fbn()['Sp'] + Fbn()['Pr2']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)))
Acn(vm:5, iif (Fbn()['RB6'] = 1, ((Val(cp:3) * Fbn()['To5'] * Fbn()['Pl']) / iif (Fbn()['MB1'] = 0, 36000, 36500)) * (Fbn()['Pr3'] / 100), 0))
Acn(vm:6, Val(cp:5) + Val(vm:3))
Acn(vm:7, iif (Fbn()['RB6'] = 1, Fbn()['C5'] + Val(vm:2), 0))
Acn(vm:8, iif (Fbn()['RB6'] = 1, Val(vm:7) * (Fbn()['DT'] / 100), 0))
