if (Eqstr(Fbn()['Tipo'], 'MMCPM'))
Acn(vm:3, Val(cp:3) * Fbn()['Pr2'] * Fbn()['Pl'] / iif (Fbn()['RB8'] = 0, 36000, 36500))
Acn(vm:12, Val(vm:3) * Fbn()['ImpG1'] / 100)
if (Fbn()['C5'] = 0)
Acn(vm:21, 0)
else
