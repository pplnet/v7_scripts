Acn(cp:3, Fbn()['CapOr'] * Val(cp:2))
Acn(cp:4, Fbn()['CAmort'] * ((Val(cp:1) / Val(cx:1)) - 1))
Acn(cp:5, Fbn()['CAmort'] + Val(cp:4))
Acn(cp:6, Val(cp:3) - Val(cp:5))
Acn(cp:10, Val(xx:1) / Val(fo:1))
