if (Eqstr(Fbn()['Tipo'], 'MMSIMV'))

Acn(vm:2, Val(cp:5))
Acn(vm:3, iif (Fbn()['Cuota'] < Fbn()['PG'], 0, Val(cp:3) * ((Fbn()['Sp'] + Fbn()['Pr2']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)))
Acn(vm:18, ((Val(cp:3) * Fbn()['Alias1'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) * (Fbn()['ImpG2'] / 100))
Acn(vm:19, ((Val(cp:3) * Fbn()['To6'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) * (Fbn()['Alias2'] / 100))
Acn(vm:20, iif (Fbn()['TC2'] > 0, iif (Fbn()['Pr8'] < Fbn()['Pr3'], Round(((Val(cp:3) * Fbn()['To6'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) * ((Fbn()['Alias2'] - Fbn()['TC2']) / 100), 2), 0), 0))
Acn(vm:6, Val(cp:5) + Val(vm:3))
Acn(vm:21, Fbn()['To9'] + Val(vm:3) + iif (not Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn()['Cl1'])), Val(vm:19), 0))
Acn(vm:13, Val(cp:5) + Val(vm:21))
