Acd(ww:1, Habiles(dialogo.fecha1, -1, 'ARG', SI))
Acn(yy:2, Cotizacion(Val(ic:1), null, null, null, Val(ww:1), 1))
if (Mes(Val(fc:1)) = Mes(Val(zz:1)))
Acn(cp:2, Val(xx:1) / Val(yy:1))
