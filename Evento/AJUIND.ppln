if (Eqstr(Fbn()['Tipo'], 'MMPEM'))

Acn(vm:17, iif (Fbn()['RB6'] = 0, ((Val(cp:3) * Fbn()['To5'] * Fbn()['Pl'] / iif (Fbn()['MB1'] = 0, 36000, 36500)) * (Fbn()['Pr3'] / 100)), 0))
Acn(vm:2, iif (Fbn()['RB6'] = 1, Val(cp:3) * Fbn()['Pr2'] * Fbn()['Pl'] / iif (Fbn()['MB3'] = 0, 36000, 36500), 0))
Acn(vm:10, (Fbn()['ImpG2'] / 100) * (Fbn()['C6'] + (Val(cp:3) * Fbn()['Alias1'] / 100 * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1))))
Acn(vm:14, iif (Fbn()['RB6'] = 0, 0, iif (Fbn()['RB6'] = 2, Val(cp:3) * ((Fbn()['Pr2'] + Fbn()['Sp']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1) * (Fbn()['Alias2'] / 100), Val(cp:3) * Fbn()['To6'] / 100 * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1) * (Fbn()['Alias2'] / 100))))
Acn(vm:3, iif (Fbn()['Cuota'] < Fbn()['PG'], 0, Val(cp:3) * ((Fbn()['Sp'] + Fbn()['Pr2']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)))
Acn(vm:6, Val(cp:5) + Val(vm:3))
