if (Eqstr(Fbn()['Tipo'], 'MMPCCM'))

Acn(vm:10, iif (Fbn()['RB6'] = 0 o (Fbn()['RB6'] = 2 y Fbn()['MB3'] = 0), ((Val(cp:5) * Fbn()['Alias1'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) * (Fbn()['ImpG2'] / 100), 0))
Acn(vm:14, iif (Fbn()['RB6'] = 2 y Fbn()['MB3'] = 0, (((Val(cp:3) * Fbn()['To6'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) * (Fbn()['Alias2'] / 100)), 0))
Acn(vm:3, Val(cp:3) * ((Fbn()['Sp'] + Fbn()['Pr2']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1))
Acn(vm:22, iif (Fbn()['RB6'] = 2 y Fbn()['MB3'] = 1, (((Val(cp:3) * Fbn()['Pl'] * Fbn()['To6']) / iif (Fbn()['RB9'] = 1, 36500, 36000)) * (Fbn()['Alias2'] / 100)), 0))
