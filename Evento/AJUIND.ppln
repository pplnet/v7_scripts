Acn(vm:10, iif (Fbn()['RB6'] = 1, ((((Val(cp:3) * Fbn()['Alias1'] / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) + Val(vm:7)) * (Fbn()['ImpG2'] / 100)), ((Val(cp:3) * ((Fbn()['Pr2'] + Fbn()['Sp']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1))) * (Fbn()['ImpG2'] / 100)))
Acn(vm:11, iif (Fbn()['RB6'] = 1, ((((Val(cp:3) * Fbn()['Alias1']) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1)) + Val(vm:7)) * (Fbn()['ImpG2'] / 100)), ((Val(cp:3) * ((Fbn()['Pr2'] + Fbn()['Sp']) / 100) * FactorDias(Fbn()['FIni'], Fbn()['FFin'], Fbn()['RB8'] + 1))) * (Fbn()['ImpG2'] / 100)))
Acn(vm:12, iif (Fbn()['RB6'] = 1, Val(vm:7) * (Fbn()['DT'] / 100), 0))
