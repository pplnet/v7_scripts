Sqladd(" SELECT NrOperacion, OperacionRef ,PaseCB ")
Sqladd(" FROM "~Dbo()~".OPERACIONES OP Where  NroAltaMAE = '"~Copy(Val(a:2), 38, 5)~"' ")
Sqladd(" and TipoOp in ('TIC','TIV','TIFC','TIFV') and FechaOp = '"~IdxDate(Val(c6))~"' and CB5='1' ")
Sqladd(" AND   Cliente1 IS NOT NULL and Cliente1 <> '' and Cliente1 <> ' ' ")
Sqladd(" AND   NrOperacion NOT IN (SELECT M.NrOperacion FROM "~Dbo()~".MOVEJECUTADOS M WHERE M.NrOperacion = OP.NrOperacion AND M.NrSaldo<>9 ) ")

recorrer sql
Message('Operacion de Oferta '~Fbn('NrOperacion')~' Encontrada - Baja Aprobada')

Message('---------- '~Fbn()['NrOperacion']~' Ok Baja, va a Eliminacion Automatica')

borrarceldas(k9..k12)
Act(k11, Copy(Val(a:2), 15, 2)~'/'~Copy(Val(a:2), 13, 2)~'/'~Copy(Val(a:2), 11, 2)~' '~Copy(Val(a:2), 17, 2)~':'~Copy(Val(a:2), 19, 2)~':'~Copy(Val(a:2), 21, 2))
Act(k12, SQLFechaStr(Val(k11), Exe('FORFECHOR')))

Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
Sqladd(" SET AceptaMAE = 'SI', FechaBajaMAE = "~Val(k12)~", ")
Sqladd(" NroBajaMAE = '"~Copy(Val(a:2), 23, 5)~"' ")
Sqladd(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" Where  NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" Where  NrBit=31 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

if (Eqstr(Fbn('PaseCB'), '1'))
Sqladd(" SELECT NrOperacion ")
Sqladd(" FROM "~Dbo()~".OPERACIONES OP Where PaseCB = '1' and FechaOp = '"~IdxDate(Val(c6))~"'")
Sqladd(" and (OperacionRef = '"~Fbn('OperacionRef')~"' or NrOperacion = '"~Fbn('OperacionRef')~"') ")
recorrer sql
Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
Sqladd(" SET AceptaMAE = 'SI', FechaBajaMAE = "~Val(k12)~", ")
Sqladd(" NroBajaMAE = '"~Copy(Val(a:2), 23, 5)~"' ")
Sqladd(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" Where  NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" Where  NrBit=31 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
