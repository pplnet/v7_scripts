Act(v1, Var('CONBAOF'))
Act(v2, Val(v1)~'*.TXT')
Act(v3, primerarchivo(Val(v2)))

if (not ok)
Cancelar()
endif

Acn(z2, 100)

recorrer&i 1, Val(z2)

borrarceldas(a1..t8)
Message('----- Preparando Informacion de Busqueda de Ops.Oferta BAJA')
abrirascii(Copy(Val(v1), 1, Longitud(Val(v1)) - 3)~Copy(Val(v3), 1, 12), 0)

Act(a:2, leerascii)
cerrarascii


Acn(k1, Fecha(Copy(Val(a2), 15, 2)~'/'~Copy(Val(a2), 13, 2)~'/'~Copy(Val(a2), 11, 2)))
if (Incluido(Copy(Val(a:2), 99, 2), '02'))
Acn(c6, Hoy())
else
Acn(c6, Fecha(Copy(Val(a:2), 36, 2)~'/'~Copy(Val(a:2), 34, 2)~'/20'~Copy(Val(a:2), 32, 2)))
endif



sql.add(" SELECT NrOperacion, OperacionRef ,PaseCB ")
sql.add(" FROM "~Dbo()~".OPERACIONES OP Where  NroAltaMAE = '"~Copy(Val(a:2), 38, 5)~"' ")
sql.add(" and TipoOp in ('TIC','TIV','TIFC','TIFV') and FechaOp = '"~IdxDate(Val(c6))~"' and CB5='1' ")
sql.add(" AND   Cliente1 IS NOT NULL and Cliente1 <> '' and Cliente1 <> ' ' ")
sql.add(" AND   NrOperacion NOT IN (SELECT M.NrOperacion FROM "~Dbo()~".MOVEJECUTADOS M WHERE M.NrOperacion = OP.NrOperacion AND M.NrSaldo<>9 ) ")

recorrer sql
Message('Operacion de Oferta '~Fbn('NrOperacion')~' Encontrada - Baja Aprobada')

Message('---------- '~Fbn()['NrOperacion']~' Ok Baja, va a Eliminacion Automatica')

borrarceldas(k9..k12)
Act(k11, Copy(Val(a:2), 15, 2)~'/'~Copy(Val(a:2), 13, 2)~'/'~Copy(Val(a:2), 11, 2)~' '~Copy(Val(a:2), 17, 2)~':'~Copy(Val(a:2), 19, 2)~':'~Copy(Val(a:2), 21, 2))
Act(k12, SQLFechaStr(Val(k11), exe('FORFECHOR')))

sql.add(" UPDATE "~Dbo()~".OPERACIONES ")
sql.add(" SET AceptaMAE = 'SI', FechaBajaMAE = "~Val(k12)~", ")
sql.add(" NroBajaMAE = '"~Copy(Val(a:2), 23, 5)~"' ")
sql.add(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new

sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '0' ")
sql.add(" Where  NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new

sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '1' ")
sql.add(" Where  NrBit=31 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new

if (Eqstr(Fbn('PaseCB'), '1'))
sql.add(" SELECT NrOperacion ")
sql.add(" FROM "~Dbo()~".OPERACIONES OP Where PaseCB = '1' and FechaOp = '"~IdxDate(Val(c6))~"'")
sql.add(" and (OperacionRef = '"~Fbn('OperacionRef')~"' or NrOperacion = '"~Fbn('OperacionRef')~"') ")
recorrer sql
sql.add(" UPDATE "~Dbo()~".OPERACIONES ")
sql.add(" SET AceptaMAE = 'SI', FechaBajaMAE = "~Val(k12)~", ")
sql.add(" NroBajaMAE = '"~Copy(Val(a:2), 23, 5)~"' ")
sql.add(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new

sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '0' ")
sql.add(" Where  NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new

sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add(" SET Valor = '1' ")
sql.add(" Where  NrBit=31 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new
proximo
endif

sql.exec
borrararchivo(Copy(Val(v1), 1, Longitud(Val(v1)) - 3)~Copy(Val(v3), 1, 12))
proximo

Act(v3, proximoarchivo)
if (not ok)
break
endif
proximo

