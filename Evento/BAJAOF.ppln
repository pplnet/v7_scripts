recorrer&i 1, Val(z2)

borrarceldas(a1..t8)
Message('----- Preparando Informacion de Busqueda de Ops.Oferta BAJA')
AbrirAscii(Copy(Val(v1), 1, Longitud(Val(v1)) - 3)~Copy(Val(v3), 1, 12), 0)

