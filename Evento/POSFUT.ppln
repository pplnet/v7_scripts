Message('*-- Inserto las Posciones Contado ')

Sqladd("INSERT INTO "~Dbo()~".MOVPOSEJE ")
Sqladd("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
Sqladd("Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
Sqladd(" SELECT FechaEj As FechaMov,Cliente,Vehiculo,")
Sqladd(" NrSaldo=(NrSaldo-100) ,Especie,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
Sqladd(" FROM "~Dbo()~".MOVPOSEJE Where NrSaldo>=200 and NrSaldo<=300 and ")
Sqladd(" FechaEj<='"~IdxDate(FSys())~"' ")
Sqlnew()
Sqlexec()

Message('*-- Reverso Posciones Futuraso ')
Sqladd("INSERT INTO "~Dbo()~".MOVPOSEJE ")
Sqladd("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
Sqladd("FechaEj,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
Sqladd(" SELECT FechaMov,Cliente,Vehiculo,")
Sqladd(" NrSaldo,Especie,FechaEj,-Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
Sqladd(" FROM "~Dbo()~".MOVPOSEJE Where NrSaldo>=200 and NrSaldo<=300 and ")
Sqladd(" FechaEj<='"~IdxDate(FSys())~"' ")
Sqlnew()
Sqlexec()


