Sqladd(" SELECT T.Especie, T.Especie Moneda, T.Fecha1, T.Vehiculo1,  T.NrTrans, T.Cantidad1 Cantidad, V.Valor1, V.Valor2, ")
Sqladd(" E.Codigo, E.Cotiza, T.TipoTr2, T.Cuenta1, T.Cliente1, V.Alias4 MonLocalVeh, T.Cantidad2 TotalIVA, T.NrTrans NrOperacion, T.Book1 Book ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".VEHICULOS V, "~Dbo()~".ESPECIES E ")
Sqladd(" WHERE T.Vehiculo1 = V.Codigo ")
Sqladd(" AND E.Codigo = T.Especie ")
Sqladd(" AND T.TipoTr2   IN ('INGGAS') ")
Sqladd(" AND T.FechaCargaSys = "~IdxDate2(dialogo.fecha1)~"   ")
Sqladd(" AND   T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (T.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") OR T.Vehiculo1 is null OR T.Vehiculo1 = '' OR T.Vehiculo1 = ' ' )")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd("  ORDER BY T.NrTrans ")
