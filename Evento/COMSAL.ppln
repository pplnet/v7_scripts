Sqladd("UPDATE "~Dbo()~".VARIABLES SET Valor=0 WHERE Codigo='CONTWKSCOM' ")
Sqlnew()
Sqlexec()


Act(v9, Var('MONELOCA'))
Act(v10, Var('MONEEXTR'))

