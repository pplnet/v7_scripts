Act(x:1, Var('SALNOCOM'))

Sqladd("SELECT Distinct S.Cliente FROM "~Dbo()~".SALDOSDIA S WITH (NOLOCK),")
Sqladd("                 "~Dbo()~".CLIENTES CL WITH (NOLOCK), "~Dbo()~".ESPECIES E  WITH (NOLOCK)       ")
Sqladd("WHERE S.Cliente = CL.Codigo AND                                  ")
Sqladd("      (S.NrSaldo > 201 OR S.NrSaldo = 101) AND                   ")
Sqladd("      S.NrSaldo not in ("~Pipe2Comillas(Val(x:1))~") AND                   ")
Sqladd("      S.EnteCustodia = '"~dialogo.vehiculo1~"' AND               ")
if (NoVacio(dialogo.cliente1))
Sqladd("      S.Cliente = '"~dialogo.cliente1~"' AND                  ")
endif
if (dialogo.radio3 = 0)
Sqladd("      (CL.Valor10<>1 OR CL.Valor10 Is Null)  AND ")
endif
if (dialogo.radio3 = 1)
Sqladd("      CL.Valor10=1 AND ")
endif
Sqladd("      S.Especie =  E.Codigo  AND                                 ")
Sqladd("      (E.Valor8 =0 or E.Valor8 is null)   AND                    ")
Sqladd("      S.Fecha <= '"~IdxDate(dialogo.fecha2)~"' AND               ")
Sqladd("      S.Fecha=(SELECT MAX(Fecha)                                 ")
Sqladd("               FROM "~Dbo()~".SALDOSDIA S1    WITH (NOLOCK) ")
Sqladd("               WHERE S1.Cliente = S.Cliente AND                  ")
Sqladd("                     S1.Especie = S.Especie AND                  ")
Sqladd("                     S1.EnteCustodia = S.EnteCustodia AND        ")
Sqladd("                     S1.Mercado = S.Mercado AND                  ")
Sqladd("                     S1.NrSaldo = S.NrSaldo AND                  ")
Sqladd("                     S1.Cuenta = S.Cuenta AND                    ")
Sqladd("                     S1.Fecha <= '"~IdxDate(dialogo.fecha2)~"')  ")
Sqladd("ORDER BY S.Cliente                                               ")

Acn(w1, Fac())
