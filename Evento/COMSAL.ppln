sql.add("UPDATE "~Dbo()~".VARIABLES SET Valor=0 WHERE Codigo='CONTWKSCOM' ")
sql.new
sql.exec


Act(v9, Var('MONELOCA'))
Act(v10, Var('MONEEXTR'))

Act(v11, Hora(Ahora()))


Act(x:1, Var('SALNOCOM'))

sql.add("SELECT Distinct S.Cliente FROM "~Dbo()~".SALDOSDIA S WITH (NOLOCK),")
sql.add("                 "~Dbo()~".CLIENTES CL WITH (NOLOCK), "~Dbo()~".ESPECIES E  WITH (NOLOCK)       ")
sql.add("WHERE S.Cliente = CL.Codigo AND                                  ")
sql.add("      (S.NrSaldo > 201 OR S.NrSaldo = 101) AND                   ")
sql.add("      S.NrSaldo not in ("~pipe2comillas(Val(x:1))~") AND                   ")
sql.add("      S.EnteCustodia = '"~dialogo.vehiculo1~"' AND               ")
if (NoVacio(dialogo.cliente1))
sql.add("      S.Cliente = '"~dialogo.cliente1~"' AND                  ")
endif
if (dialogo.radio3 = 0)
sql.add("      (CL.Valor10<>1 OR CL.Valor10 Is Null)  AND ")
endif
if (dialogo.radio3 = 1)
sql.add("      CL.Valor10=1 AND ")
endif
sql.add("      S.Especie =  E.Codigo  AND                                 ")
sql.add("      (E.Valor8 =0 or E.Valor8 is null)   AND                    ")
sql.add("      S.Fecha <= '"~IdxDate(dialogo.fecha2)~"' AND               ")
sql.add("      S.Fecha=(SELECT MAX(Fecha)                                 ")
sql.add("               FROM "~Dbo()~".SALDOSDIA S1    WITH (NOLOCK) ")
sql.add("               WHERE S1.Cliente = S.Cliente AND                  ")
sql.add("                     S1.Especie = S.Especie AND                  ")
sql.add("                     S1.EnteCustodia = S.EnteCustodia AND        ")
sql.add("                     S1.Mercado = S.Mercado AND                  ")
sql.add("                     S1.NrSaldo = S.NrSaldo AND                  ")
sql.add("                     S1.Cuenta = S.Cuenta AND                    ")
sql.add("                     S1.Fecha <= '"~IdxDate(dialogo.fecha2)~"')  ")
sql.add("ORDER BY S.Cliente                                               ")

