*-- Para C/V de Titulos-----
SQL.ADD(" Select * from "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Where ( NrBit = 50 ) and ( Valor = '1' ) ")
SQL.ADD(" Order by NrOperacion ")
Recorrer SQL
  EscribirAscII(FBN['NrOperacion'])
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
  SQL.ADD(" Where NrBit=80 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
  SQL.ADD(" Where NrBit=50 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC
Proximo


*-- Para C/V de Titulos----- Esto es para las ofertas
SQL.ADD(" Select B.NrOperacion, O.PaseCB from "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where B.NrOperacion = O.NrOperacion     ")
SQL.ADD(" and   B.NrBit = 65  and  B.Valor = '1'  ")
SQL.ADD(" Order by B.NrOperacion ")
Recorrer SQL
  EscribirAscII(FBN['NrOperacion'])
  If Eqstr(fbn('PaseCB'),'1')
     SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
     SQL.ADD(" Where NrBit=73 and NrOperacion='"~FBN['NrOperacion']~"' ")
     SQL.NEW
  Else
     SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
     SQL.ADD(" Where NrBit=80 and NrOperacion='"~FBN['NrOperacion']~"' ")
     SQL.NEW
  Endif

  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
  SQL.ADD(" Where NrBit=65 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC

  If Eqstr(fbn('PaseCB'),'1')
     message('- Iniciando Generacion de Pase x Oferta')
     EjecutarEvento('PASESG')
     Esperar2(500)
  Endif
Proximo


*-- Para Baja C/V de Titulos-----
SQL.ADD(" Select * from "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Where ( NrBit = 60 ) and ( Valor = '1' ) ")
SQL.ADD(" Order by NrOperacion ")
Recorrer SQL
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
  SQL.ADD(" Where NrBit=30 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
  SQL.ADD(" Where NrBit=60 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC
Proximo

CerrarAscII	