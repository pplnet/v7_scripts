MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 <= FSys();'Fecha inválida';NO;FSys()
vehiculo1: 'Vehiculo';3;;;;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE')
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select 'Vehiculo' as Tipo, O.NrOperacion, O.TipoTasa, C.NrCuota, C.Total3 Spread, C.Cantidad1 Cantidad, C.Precio1 Tasa,")
Sqladd(" C.Fecha1 FechaIni, C.Fecha2 FechaFin, O.RB8 DayCount, O.Especie Moneda ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
Sqladd(" Where O.NrOperacion = C.NrOperacion ")
Sqladd(" AND O.TipoOp = 'MMST' ")
Sqladd(" AND O.TipoTasa <> 'FIJA' ")
Sqladd(" AND C.Fecha5 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" UNION ")
Sqladd(" Select 'Contraparte' as Tipo, O.NrOperacion, O.TipoTasa2 TipoTasa, C.NrCuota, C.Total4 Spread, C.Cantidad2 Cantidadd, ")
Sqladd(" C.Precio2 Tasa, C.Fecha1 FechaIni, C.Fecha2 FechaFin, O.RB5 DayCount, O.ContraEspecie Moneda ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
Sqladd(" Where O.NrOperacion = C.NrOperacion ")
Sqladd(" AND O.TipoOp = 'MMST' ")
Sqladd(" AND O.TipoTasa2 <> 'FIJA' ")
Sqladd(" AND C.Fecha6 = '"~IdxDate(dialogo.fecha1)~"' ")
Watch(Sqlbatch())
recorrer sql
Sqladd(" Select T.Valor1 From "~Dbo()~".TASASDIA T ")
Sqladd(" Where T.TipoTasa = '"~Fbn('TipoTasa')~"' ")
Sqladd(" AND T.Especie = '"~Fbn('Moneda')~"' ")
Sqladd(" AND T.Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T2 ")
Sqladd("               Where T.TipoTasa = T2.TipoTasa ")
Sqladd("               AND T2.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Acn(ts:1, Fbn('Valor1'))
proximo
Acn(it:1, ((Fbn('Cantidad') * (Val(ts:1) + Fbn('Spread'))) / 100) * FactorDias(Fbn('FechaIni'), Fbn('FechaFin'), Fbn('DayCount') + 1))
Sqladd(" Update "~Dbo()~".CUOTAS ")
if (Eqstr(Fbn('Tipo'), 'Vehiculo'))
Sqladd(" Set Cantidad3 = "~FStr(Val(it:1), 0, 2)~", ")
Sqladd(" Precio1 = "~FStr(Val(ts:1), 0, 8)~" ")
else
Sqladd(" Set Cantidad4 = "~FStr(Val(it:1), 0, 2)~", ")
Sqladd(" Precio2 = "~FStr(Val(ts:1), 0, 8)~" ")
endif
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND NrCuota = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos3(Fbn('NrOperacion'), SI, NO, NO, NO, SI)
Sqlexec()
proximo

