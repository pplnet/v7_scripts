MostrarCuadroDeMensajes()
creardialogo
fecha1:"F.Op.Desde";;;;;;dialogo.fecha1 <> 0;'Debe Ingresar una FechaOp Desde';NO;FSys();
fecha2:"F.Op.Hasta";;;;;;dialogo.fecha2 <> 0;'Debe Ingresar una Fecha';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

Acn(w:1, 0)
Acn(w:2, 0)

Sqladd(" Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, O.Especie ")
Sqladd(" From    "~Dbo()~".OPERACIONES O   ")
Sqladd(" where  O.TipoOp IN ('FCS','FCR')  ")
Sqladd(" AND O.FechaOp between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" order by O.FechaOp, O.NrOperacion ")
recorrer sql
Message('Procesando Operaciones')
Scn(w:1, 1)
Act(b:1, Fbn('Especie'))
Act(b:2, Fbn('NrOperacion'))
Acd(b:3, Fbn('FechaOp'))
SqlActualizarmovimientos3(Val(b:2), NO, SI, NO, NO, NO, 0)
Sqlnew()
Sqlexec()
proximo

recorrer&i dialogo.fecha1, dialogo.fecha2
if (EsHabil(&i, 'ARG') o EsHabil(&i, 'URU'))
Acd(b:4, &i)
Message('Ajustando Dia '~Fecha(&i))
Ejecutarevento('AJULIM', 'fecha1', Val(b:4))
endif
proximo


