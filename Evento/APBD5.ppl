MostrarCuadroDeMensajes
*DialogoVisible(SI)
CrearDialogo
  Fecha1    :"Fecha"            ;1;1;;NO;;;;;;FSYS
  String    :"Archivo"          ;2;1;;  ;;NOVACIO(Dialogo.String) ;'Archivo Invalido'   ;NO;VAR('DNCCDI');;;;;;;;;SI
  String2   :"Nuevo Directorio" ;3;1;;  ;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;0
  Check10: 'HojaVisible' ;;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

If Dialogo.Check10=1
   HojaVisible(SI)
EndIf

ACN(x:3,0)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(a:1, 'Cuentas no existentes en la Captura de Disponibilidades. Archivo: '~Dialogo.String)
ACT(a:3, 'Banco')
ACT(b:3, 'Cuenta')
SetFont(a:1, 2)
ACN(x:4, 4)
ACN(x:6,0)

message(Dialogo.String)

AbrirAscii(MAYUSCULAS2(Dialogo.String),0)

Recorrer&i 1,10000000
 ACT(ta:1,LEERASCII)
 If &i>=2
    *Saco la cuenta corta para identificar la moneda y tipo de cuenta.
    ACT(ta:2, Copy(Val(ta:1),2,5) )
    ACT(ta:3, SQL(" SELECT /*+ RULE */ Codigo FROM "~DBO~".CUENTAS WHERE Alias3 = '"~Val(ta:2)~"' ") )
    If NoVacio(Val(ta:3)) o Vacio(Val(ta:1))
      *Cuando encuentro una cuenta valida para determinar la moneda o terminal el archivo, salgo.
      Break
    Endif
 Endif
Proximo
CerrarAscii

SQL.ADD(" SELECT /*+ RULE */ Codigo, Especies, Alias3, TipoCuenta FROM "~DBO~".CUENTAS WHERE Codigo = '"~Val(ta:3)~"' ")
Recorrer SQL
  dfa
  ACT(tc:1, fbn('TipoCuenta'))
  If Incluido('ARP',fbn('Especies'))
    ACT(es:1, 'ARP')
    Break
  Endif
  If Incluido('USD',fbn('Especies'))
    ACT(es:1, 'USD')
    Break
  Endif
  If Incluido('USB',fbn('Especies'))
    ACT(es:1, 'USD')
    Break
  Endif
Proximo

If Eqstr(Val(es:1),'ARP')
   If Incluido(Val(tc:1),'CA')
     * CAJA DE AHORRO EN PESOS - DNAHDI
     ACN(ta:1, 1)
   Else
     * CC EN PESOS - DNCCDI
     ACN(ta:1, 2)
   Endif
Else
   If Incluido(Val(tc:1),'CA')
     * CAJA DE AHORRO EN DOLARES - DNADDI
     ACN(ta:1, 3)
   Else
     * CC EN DOLARES - DNCDDI
     ACN(ta:1, 4)
   Endif
Endif


If ExisteArchivo(MAYUSCULAS2(Dialogo.String))
  ACT(PT:1, Var('DNERROR'))
  SQL.ADD(" SELECT /*+ RULE */ ")
  SQL.ADD(" Distinct M.NrDatanet, M.NrMovdatanet ")
  SQL.ADD(" FROM " ~DBO~ ".MOVDATANET M, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE M.NrDatanet = D.NrDatanet ")
  SQL.ADD(" AND   D.FechaBajada = '" ~Dialogo.Fecha1~ "' ")
  If Val(ta:1)=2
    SQL.ADD(" AND   D.Archivo     = 'DNCCDI' ")
    ACT(ba:1, Val(PT:1)~'DNCCDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(ba:2, Dialogo.String2~"DNCCDI-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(ba:3, Val(PT:1)~'DNCCDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=1
    SQL.ADD(" AND   D.Archivo     = 'DNAHDI' ")
    ACT(ba:1, Val(PT:1)~'DNAHDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(ba:2, Dialogo.String2~"DNAHDI-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(ba:3, Val(PT:1)~'DNAHDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=4
    SQL.ADD(" AND   D.Archivo     = 'DNCDDI' ")
    ACT(ba:1, Val(PT:1)~'DNCDDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(ba:2, Dialogo.String2~"DNCDDI-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(ba:3, Val(PT:1)~'DNCDDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=3
    SQL.ADD(" AND   D.Archivo     = 'DNADDI' ")
    ACT(ba:1, Val(PT:1)~'DNADDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(ba:2, Dialogo.String2~"DNADDI-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(ba:3, Val(PT:1)~'DNADDI-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet ")
  Recorrer SQL
    message('Recuperando MovDatanet del dia.')
    ACN(x:3,1)
    ACT(x:2,fbn('NrDatanet'))
    ACN(nm:1, fbn('NrMovDatanet'))
  Proximo
  ACN(fi:1, fac)

  AbrirAscii(MAYUSCULAS2(Dialogo.String),0)

  Recorrer&i 1,1000000
    ACT(x:1,LEERASCII)
    ACN(nm:2, &i)
    message(' Registrando movimientos del archivo. '~fstr(Val(nm:2),0,0))

    If Vacio(val(x:1))
      * Termino el archivo
      ACT(aq:&i, Val(x:1))
      ACN(x:5, &i)
      Break  
    Endif

    If Eqstrl(Val(x:1),"S",1)
      *Tipo de Registro
      ACT(aa:&i,Copy(Val(x:1),1,1))

      *Banco
      ACT(ab:&i,Copy(Val(x:1),2,3))

      *Cuenta Corta
      ACT(ac:&i,Copy(Val(x:1),5,2))

      *Csdigo de Moneda
      ACT(ad:&i,Copy(Val(x:1),7,3))

      *D/C Saldo Contable
      ACT(ae:&i,Copy(Val(x:1),10,1))

      *Saldo Contable
      ACN(af:&i, NUM(COPY(Val(x:1),11,13)~'.'~COPY(Val(x:1),24,2)))

      *D/C Saldo Ini
      ACT(ag:&i,Copy(Val(x:1),26,1))

      *Saldo Inicio Dia
      ACN(ah:&i, NUM(COPY(Val(x:1),27,13)~'.'~COPY(Val(x:1),40,2)))

      *D/C Saldo Ope
      ACT(ai:&i,Copy(Val(x:1),42,1))

      *Saldo Operativo
      ACN(aj:&i, NUM(COPY(Val(x:1),43,13)~'.'~COPY(Val(x:1),56,2)))

      *Total Debitos 24 hs.
      ACN(ak:&i, NUM(COPY(Val(x:1),58,13)~'.'~COPY(Val(x:1),71,2)))

      *Total Debitos 48 hs.
      ACN(al:&i, NUM(COPY(Val(x:1),73,13)~'.'~COPY(Val(x:1),86,2)))

      *Total Debitos 72 hs.
      ACN(am:&i, NUM(COPY(Val(x:1),88,13)~'.'~COPY(Val(x:1),101,2)))

      *Total Debitos 96 hs.
      ACN(an:&i, NUM(COPY(Val(x:1),103,13)~'.'~COPY(Val(x:1),116,2)))

      *Total Creditos 24 hs.
      ACN(ao:&i, NUM(COPY(Val(x:1),118,13)~'.'~COPY(Val(x:1),131,2)))

      *Total Creditos 48 hs.
      ACN(ap:&i, NUM(COPY(Val(x:1),133,13)~'.'~COPY(Val(x:1),146,2)))

      *Total Creditos 72 hs.
      ACN(aq:&i, NUM(COPY(Val(x:1),148,13)~'.'~COPY(Val(x:1),161,2)))

      *Total Creditos 96 hs.
      ACN(ar:&i, NUM(COPY(Val(x:1),163,13)~'.'~COPY(Val(x:1),176,2)))

      *Total Acuerdos
      ACN(as:&i, NUM(COPY(Val(x:1),178,13)~'.'~COPY(Val(x:1),191,2)))

      *Filler
      ACT(at:&i,Copy(Val(x:1),193,48))

      *Cuenta Larga
      ACT(au:&i, SQL(" SELECT /*+ RULE */ Numero FROM "~DBO~".CUENTAS WHERE Alias3 = '"~TRIM(MIRT(Val(ab:&i)))~TRIM(MIRT(Val(ac:&i)))~"' ") )

      *Vehiculo
      ACT(av:&i, SQL(" SELECT /*+ RULE */ Cliente FROM "~DBO~".CUENTAS WHERE Numero = '"~TRIM(MIRT(Val(au:&i)))~"' ") )
    EndIf

    ACT(aq:&i, Val(x:1))
    ACN(x:5, &i)
  Proximo

  * --- Cierra el archivo Procesado.
  CerrarAscii

  * --- Abre archivo para Grabar errores para las lineas sin cuentas.
  AbrirAscii(val(ba:1),0)
  
  If val(x:3) = 1
    * --- Hay movimientos Datanet del Dia 
    Recorrer&i 1,val(x:5)
      SQL.ADD(" DELETE /*+ RULE */ FROM " ~DBO~ ".MovDatanet WHERE NrDatanet='" ~val(x:2)~ "' ") 
      SQL.ADD(" AND Banco        = '"~val(ab:&i)~"' ")
      SQL.ADD(" AND Cuenta       = '"~val(au:&i)~"' ")
      SQL.ADD(" AND Vehiculo     = '"~val(av:&i)~"' ")
      SQL.ADD(" AND FechaIngreso = '"~idxdate(Dialogo.Fecha1)~"' ")
      SQL.NEW
      SQL.EXEC

      * Recorre los movimientos del Ascii 

      If NoVacio(val(av:&i))
        * --- Si hay vehiculo
        SCN(nm:1,1)
        SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
        SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
        SQL.ADD(" Banco, Sucursal, Cuenta, ")
        SQL.ADD(" Moneda, Importe, DC, ")
        SQL.ADD(" Importe2, DC2, Importe3, ")
        SQL.ADD(" DC3, Importe4, Importe5, ")
        SQL.ADD(" Importe6, Importe7, Importe8, ")
        SQL.ADD(" Importe9, Importe10, Importe11, ")
        SQL.ADD(" Importe12, FechaIngreso, FechaAcreditacion, ")
        SQL.ADD(" TipoMov, EstadoConciliacion ")
        SQL.ADD(" ) VALUES ( ")
        SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(av:&i)~"', ")
        SQL.ADD(" '"~val(ab:&i)~"', '', '"~val(au:&i)~"', ")
        If Val(ta:1)=2 o  Val(ta:1)=1
          SQL.ADD(" '$', "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
        EndIf
        If Val(ta:1)=4 o Val(ta:1)=3
          SQL.ADD(" 'U$S', "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
        EndIf
        SQL.ADD(" "~fstr(val(ah:&i),1,2)~", '"~val(ag:&i)~"', "~fstr(val(aj:&i),1,2)~", ")
        SQL.ADD(" '"~val(ai:&i)~"', "~fstr(val(ak:&i),1,2)~", "~fstr(val(al:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(am:&i),1,2)~", "~fstr(val(an:&i),1,2)~", "~fstr(val(ao:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(ap:&i),1,2)~", "~fstr(val(aq:&i),1,2)~", "~fstr(val(ar:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(as:&i),1,2)~", '"~idxdate(Dialogo.Fecha1)~"', '"~idxdate(Dialogo.Fecha1)~"', ")
        SQL.ADD(" 'DIS', 'OK' )  ")
        SQL.NEW
        SQL.EXEC
        message(' Movimiento nuevo OK.')
      Else
        * No hay vehiculo
        If novacio(val(ab:&i))
          message(' El codigo de Banco o Cuenta Corta no existe.')
          ACT(a:Val(x:4), Val(ab:&i))
          ACT(b:Val(x:4), Val(ac:&i))
          ACT(c:Val(x:4), ' El codigo de Banco o Cuenta Corta no existe.')
          SCN(x:4,1)
          * --- Si no tiene vehiculo graba el error.
          EscribirAscii(Val(aq:&i))
          SCN(x:6,0)
        EndIf
      EndIf
    Proximo
  Else
    * --- No hay MovDatanet del Dia
    ACN(nm:1,0)
    ACT(x:2,getnumerador(7))

    Recorrer&i 1,val(x:5)
      * Recorre los movimientos del Ascii 
      If NoVacio(val(av:&i))
        * --- Hay vehiculo
        SCN(nm:1,1)
        SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
        SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
        SQL.ADD(" Banco, Sucursal, Cuenta, ")
        SQL.ADD(" Moneda, Importe, DC, ")
        SQL.ADD(" Importe2, DC2, Importe3, ")
        SQL.ADD(" DC3, Importe4, Importe5, ")
        SQL.ADD(" Importe6, Importe7, Importe8, ")
        SQL.ADD(" Importe9, Importe10, Importe11, ")
        SQL.ADD(" Importe12, FechaIngreso, FechaAcreditacion, ")
        SQL.ADD(" TipoMov, EstadoConciliacion ")
        SQL.ADD(" ) VALUES ( ")
        SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(av:&i)~"', ")
        SQL.ADD(" '"~val(ab:&i)~"', '', '"~val(au:&i)~"', ")
        If Val(ta:1)=2 o Val(ta:1)=1
          SQL.ADD(" '$', "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
        EndIf
        If Val(ta:1)=4 o Val(ta:1)=3
          SQL.ADD(" 'U$S', "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
        EndIf
        SQL.ADD(" "~fstr(val(ah:&i),1,2)~", '"~val(ag:&i)~"', "~fstr(val(aj:&i),1,2)~", ")
        SQL.ADD(" '"~val(ai:&i)~"', "~fstr(val(ak:&i),1,2)~", "~fstr(val(al:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(am:&i),1,2)~", "~fstr(val(an:&i),1,2)~", "~fstr(val(ao:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(ap:&i),1,2)~", "~fstr(val(aq:&i),1,2)~", "~fstr(val(ar:&i),1,2)~", ")
        SQL.ADD(" "~fstr(val(as:&i),1,2)~", '"~idxdate(Dialogo.Fecha1)~"', '"~idxdate(Dialogo.Fecha1)~"', ")
        SQL.ADD(" 'DIS', 'OK' )  ")
        SQL.NEW
        SQL.EXEC
        message(' Movimiento nuevo OK.')
        ACN(zz:1,1)
      Else
        * No hay vehiculo 
        If novacio(val(ab:&i))
          message(' El codigo de Banco o Cuenta Corta no existe.')
          ACT(a:Val(x:4), Val(ab:&i))
          ACT(b:Val(x:4), Val(ac:&i))
          ACT(c:Val(x:4), ' El codigo de Banco o Cuenta Corta no existe.')
          SCN(x:4,1)
          * Si no tiene vehiculo graba el error.
          EscribirAscii(Val(aq:&i))
          SCN(x:6,1)
        EndIf
      EndIf
    Proximo

    If val(zz:1) = 1
      SQL.ADD(" INSERT INTO "~DBO~".DATANET ( ")
      SQL.ADD(" NrDatanet, FechaBajada, Archivo, ")
      SQL.ADD(" FechaDesde, FechaHasta, Usuario, Estado, ")
      SQL.ADD(" EstadoAprobacion, FechaAprobacion, Supervisor ")
      SQL.ADD(" ) VALUES ( ")
      SQL.ADD(" '"~val(x:2)~"', '"~idxdate(Dialogo.Fecha1)~"',  ")
      If Val(ta:1)=2
        SQL.ADD(" 'DNCCDI',  ")
      EndIf
      If Val(ta:1)=1
        SQL.ADD(" 'DNAHDI',  ")
      EndIf
      If Val(ta:1)=4
        SQL.ADD(" 'DNCDDI',  ")
      EndIf
      If Val(ta:1)=3
        SQL.ADD(" 'DNADDI',  ")
      EndIf
      SQL.ADD(" '"~idxdate(Dialogo.Fecha1)~"', '"~idxdate(Dialogo.Fecha1)~"', ")
      SQL.ADD(" '"~UsuarioActivo~"', 'NC', 'OK', "~IdxDate2(fsys)~", 'Captura' ) ")
      SQL.NEW
      SQL.EXEC
    EndIf
  EndIf

  * --- Cierro Archivo de Errores
  CerrarAscii

  If val(x:6) > 0
    ExportarXLS(a:1..e:val(x:4), a1..e:val(x:4), val(ba:3))
  Else
    BorrarArchivo(val(ba:1))  
  EndIf


  AbrirAscii(val(ba:2),0)
  Recorrer&i 1,val(x:5)
     EscribirAscii(val(aq:&i))
  Proximo
  CerrarAscii

  If Dialogo.Radio1=0
    *W98
*    message('Pasando archivo '~Dialogo.String~' a Procesados.')
*    WinExec("COMMAND.COM /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(ba:2),0)
*    Esperar(5)

    message('Borrando archivo '~Dialogo.String)
    WinExec("COMMAND.COM /C del "~Dialogo.String,0)
    Esperar(5)
  Else
    *NT
*    message('Pasando archivo '~Dialogo.String~' a Procesados.')
*    WinExec("CMD.EXE /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(ba:2),0)
*    Esperar(5)

    message('Borrando archivo '~Dialogo.String)
    WinExec("CMD.EXE /C del "~Dialogo.String,0)
    Esperar(5)
  EndIf
Else
  Message('El archivo '~Dialogo.String~' aun no se ha generado.')
  Cancelar
EndIf


ACT(a:Val(x:4)+1, 'Fin')
SetFont(a:Val(x:4)+1, 1)

ACO(1,20)
ACO(2,20)
ACO(3,30)
LimitesVision(c:Val(x:4)+2)

ACT(fe:1,Fecha(Dialogo.Fecha1))
GrabarPMG(Val(fe:1), 'APBD5|Disponibil|'~Hora(AHORA) )
