sql.add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
sql.add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*,")
sql.add("       C.RazonSocial, ")
sql.add("       C.Direccion, ")
sql.add("       C.Localidad, ")
sql.add("       C.CodigoPostal, ")
sql.add("       C.CUIT, ")
sql.add("       C.CondicionIVA, ")
sql.add("       C.TipoInscripcion, ")
sql.add("       C.Sucursal ")
sql.add("FROM "~Dbo()~".TRANSACCIONES2 T2, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVEJECUTADOS M ")
sql.add("WHERE T2.Especie  =  '"~dialogo.especie1~"' ")
sql.add("  AND T2.Cupon1   =  '"~FStr(dialogo.entero1, 1, 0)~"' ")
sql.add("  AND T2.TipoTr2  = 'LCUPON' ")
sql.add("  AND M.NrOperacion = T2.NrTrans ")
sql.add("  AND M.Cliente     = C.Codigo ")
sql.add("  AND M.NrSaldo IN (5,1)  ")
if (NoVacio(dialogo.listatabla1))
sql.add("  AND M.Cliente in ("~pipe2comillas(dialogo.listatabla1)~") ")
endif
if (NoVacio(dialogo.mercado1))
sql.add("  AND M.Mercado='"~dialogo.mercado1~"' ")
endif
sql.add(" UNION ALL ")
sql.add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
sql.add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*,")
sql.add("       C.RazonSocial, ")
sql.add("       C.Direccion, ")
sql.add("       C.Localidad, ")
sql.add("       C.CodigoPostal, ")
sql.add("       C.CUIT, ")
sql.add("       C.CondicionIVA, ")
sql.add("       C.TipoInscripcion, ")
sql.add("       C.Sucursal ")
sql.add("FROM "~Dbo()~".TRANSACCIONES2 T2, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVPENDIENTES M ")
sql.add("WHERE T2.Especie  =  '"~dialogo.especie1~"' ")
sql.add("  AND T2.Cupon1   =  '"~FStr(dialogo.entero1, 1, 0)~"' ")
sql.add("  AND T2.TipoTr2  = 'LCUPON' ")
sql.add("  AND M.NrOperacion = T2.NrTrans ")
sql.add("  AND M.Cliente     = C.Codigo ")
sql.add("  AND M.NrSaldo IN (5,1)  ")
if (NoVacio(dialogo.listatabla1))
sql.add("  AND M.Cliente in ("~pipe2comillas(dialogo.listatabla1)~") ")
endif
if (NoVacio(dialogo.mercado1))
sql.add("  AND M.Mercado='"~dialogo.mercado1~"' ")
endif
sql.add("ORDER BY T2.NrTrans,M.Cliente, M.Concepto, M.NrSaldo ")

recorrer sql
