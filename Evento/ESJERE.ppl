
MostrarCuadroDeMensajes
CrearFont(1, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')


SQL.ADD("Select Codigo From "~DBO~".ESPECIES")

Message ('Procesando...')
Recorrer SQL    
    If Not EsTerminal(FBN['Codigo'],'ESPECIES')
        Message('Actualizando Especie '~ FBN['Codigo'])
        SQL.ADD("UPDATE "~DBO~".ESPECIES Set EsJerarquia='SI' Where Codigo ='"~FBN['Codigo']~"' ")
        SQL.NEW
        SQL.EXEC
    Endif
Proximo

