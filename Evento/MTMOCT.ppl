ACT(ax:FAC, 'NO 70')
ACT(ay:FAC, 'Error')
ACT(ca:FAC, 'Cartera')
ACT(cb:FAC, 'Book Spot')
ACT(cc:FAC, 'Cot Esp/USD')
ACT(cd:FAC, 'Cant en USD')
ACT(ce:FAC, 'Cant Reval')
ACT(cf:FAC, 'Modo CEsp/USD')
