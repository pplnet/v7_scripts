SetFilaActual(1)
SQL.ADD("Select NrTrans,Cantidad1,Cliente1 from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" Where Fecha1    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and TipoTr2   = 'LIQOCT' ")
SQL.ADD("   and Cambio1   = 0 ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("   and Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
recorrer SQL
  SCN(bk:2, 1)
  ACT(bl:FAC, fbn('NrTrans'))
  ACT(bm:FAC, fbn('Cliente1'))
  ACN(bn:FAC, fbn('Cantidad1'))
proximo
SetFilaActual(0)
if Val(bk:2)>0
  recorrer&i 2,Val(bk:2)+1
    SQL.ADD("Select Cantidad from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion    = '"~Val(bl:&i)~"' ")
    SQL.ADD("   and NrSaldo        = 1 ")
    recorrer SQL
      SCN(bo:&i, 1)
      SCN(bp:&i, fbn('Cantidad'))
    proximo
    if Val(bo:&i)>0
      MessageBox('La transacccion '~Val(bl:&i)~' esta liquidada.')
      ACN(bk:3,1)
    endif
  proximo
  if Val(bk:3)>0
    Cancelar('Evento Cancelado')
  endif
endif

SQL.ADD("Select NrOperacion,Cantidad from "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" Where FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and NrOperacion Like 'OC%' ")
SQL.ADD("   and NrSaldo     = 100 ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD(" order by NrOperacion ")
recorrer SQL
  SCN(cy:1, 1)  
  SCN(cz:1, 1)  
  SCN(cz:2, fbn('Cantidad'))
  ACT(da:Val(cz:1), fbn('NrOperacion'))
  ACN(db:Val(cz:1), fbn('Cantidad'))
proximo
SQL.ADD("Select NrOperacion,Cantidad from "~DBO~".MOVPENDIENTES ")
SQL.ADD(" Where FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and NrOperacion Like 'OC%' ")
SQL.ADD("   and NrSaldo     = 100 ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD(" order by NrOperacion ")
recorrer SQL
  SCN(cy:2, 1)  
  SCN(cz:1, 1)  
  SCN(cz:2, fbn('Cantidad'))  
  ACT(da:Val(cz:1), fbn('NrOperacion'))
  ACN(db:Val(cz:1), fbn('Cantidad'))
proximo
if Val(cy:1)>0 y Val(cy:2)>0
  Cancelar('Hay Movimientos saldo 100 Ejecutados y Pendientes')
endif

SetFilaActual(1)
