ACD(bz:1, SQL("Select Max(Fecha) From "~DBO~".FLAGSOCT Where Registro = 'MTMD' "))
if Val(bz:1)>Dialogo.Fecha1
  MessageBox('Existe Flag MTM posterior al '~Dialogo.Fecha1)
  if Dialogo.Check1=1
    Cancelar('Evento cancelado')
  endif
endif
if SQL(" Select 1 From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = '4427' ") <> 1
  if Dialogo.Check3=0
    MessageBox('No Se Han Recibido Las COTIZACIONES desde el MAE')
    if Dialogo.Check1=1
      Cancelar('Evento cancelado')
    endif
  else
    if MessageBox('No Se Han Recibido Las COTIZACIONES desde el MAE, Desea Continuar?', 3, 2) = 7
      Cancelar('MTM Cancelado')
    endif
  endif
endif
***Obtengo Especies validas de OCT
SetFilaActual(0)
acn(ed:1, 0)
acn(ee:1, 0)
SQL.ADD("Select EspecieDestino2,EspecieOrigen,EspecieDestino1,TipoNegociacion From "~DBO~".EQUIVALENCIA_ESPECIES ")
Recorrer SQL
  act(ea:fac, fbn('EspecieDestino2'))
  acn(ec:fac, 0)
  act(eg:fac, fbn('EspecieDestino1'))
  if NoVacio(fbn('EspecieOrigen'))
    dfa
    SQL.ADD("Select * From "~DBO~".PLAZOSOCT P ")
    SQL.ADD(" Where P.Habilitado = 'SI' ")
    SQL.ADD("   and P.TipoNegociacion = '"~fbn('TipoNegociacion')~"' ")
    SQL.ADD("   and P.Especie = '"~fbn('EspecieDestino1')~"' ")
    SQL.ADD(" order by Fecha ")
    Recorrer SQL
      act(ea:fac, fbn('EspecieDestino2',0))
      acd(ef:fac, fbn('Fecha'))
      act(eg:fac, fbn('EspecieDestino1',0))
      SQL.ADD("Select C.* From "~DBO~".COTIZACIONES C ")
      SQL.ADD(" Where C.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" AND C.Codigo  = '"~Val(ea:fac)~"' ")
      SQL.ADD(" AND C.CallPut = 'FUT' ")
      SQL.ADD(" AND C.FechaEj = '"~IdxDate(fbn('Fecha'))~"' ")
      Recorrer SQL
        dfa
        acn(eb:fac, fbn('Precio1'))
        acn(ec:fac, 1)
        Break
      Proximo
      scn(ed:1, 1)
    Proximo
  else
    SQL.ADD("Select * From "~DBO~".COTIZACIONES ")
    SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND Codigo  = '"~val(ea:fac)~"' ")
    Recorrer SQL
      dfa
      acn(eb:fac, fbn('Precio1'))
      acn(ec:fac, 1)
    Proximo
    scn(ed:1,1)
  endif
Proximo
Recorrer&i 1, val(ed:1)
  if val(ec:&i) = 0
     acn(ee:1,1)
  endif
Proximo
if val(ee:1) = 1
   **** muestra las cotizaciones y valida si sigue ****
   MessageBox('No Se Han Actualizado todas las COTIZACIONES en FPA')
   CrearListBox ; 'Arial,8,';'Cotizaciones del Dia '~Dialogo.Fecha1
     'Especie'    ;ea:1..ea:val(ed:1);NO;;;90 ;STRING;;RGB(450,200,250);
     'Cotizacion' ;eb:1..eb:val(ed:1);NO;;;120;NUMERO;'####.######';RGB(450,200,250);
     'Plazo'      ;ef:1..ef:val(ed:1);NO;;;120;FECHA;RGB(450,200,250);
   FinListBox
   if Not OK
     Cancelar('MTM Cancelado')
   endif
endif

ACN(bx:1, SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 Where TipoTr2 in ('OCTDEP','OCTRET') and Fecha1='"~IdxDate(Dialogo.Fecha1)~"' and Precio5=0 "))
if Val(bx:1)>1
  MessageBox('Existe mas de una trasaccion de Cobro/Pago')
