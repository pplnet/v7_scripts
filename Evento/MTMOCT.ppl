SetFont(ed:1..ee:1,1)
if Val(ed:1)>0
  SetFont(ea:1..eg:Val(ed:1),1)
endif
if Val(fa:1)>0
  SetFont(fa:1..fe:Val(fa:1),1)
  FormatoCeldas(fd:1..fe:Val(fa:1),Exe('F0'))
endif
