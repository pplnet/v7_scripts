CrearDialogo
  Fecha1   : 'Fecha'       ;1;1; ;  ;  ;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1<=FSys;'Fecha incorrecta (> FSys) o no habil';NO;FSys;
  Vehiculo1: 'Vehiculo:'   ;2;1; ;NO;SI;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Cliente1 : 'Cliente'     ;3;1; ;NO;NO;
  Check1   : 'Procesa'     ;1;2; ;NO;NO;;;;1;
  Check2   : 'Ejec.Liq.'   ;2;2; ;NO;NO;;;;1;
  Check3   : 'Contingencia';3;2; ;NO;NO;;;;0;
FinDialogo
if not ok
  Cancelar
endif
if Dialogo.Check1=0
  Message('**** NO PROCESA ****')
  HojaVisible(SI)
endif

