modoreproceso(condialogo)
creardialogo
nroperacion1: 'Nr. Operacion';1;1;1;;;NoVacio(dialogo.nroperacion1);'Operacion Invalida.';NO;
check1: 'Procesa';;;1;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif


Act(w:2, Var('CONTROLAPM'))
Act(w:4, Var('MSGSISEXT'))

Act(a:1, 'Nr Operacion')
Act(a:2, 'CB5')
Act(a:3, 'CB2')
Act(a:4, 'Nr Alta')
Act(a:5, 'TipoOp')
Act(a:6, 'Especie')
Act(a:7, 'Cliente1')
Act(a:8, 'ContraEspecie')
Act(a:9, 'PME Especie')
Act(a:10, 'A Compliance')
Act(a:11, 'Accion')
Act(a:12, 'Tipo Excep')
Act(a:13, 'Desc Excep')

Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd(" where NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Act(b:1, Fbn()['NrOperacion'])
Act(b:2, Fbn()['CB5'])
Act(b:3, Fbn()['CB2'])
Act(b:4, Fbn()['NroAltaMAE'])
Act(b:5, Fbn()['TipoOp'])
Act(b:6, Fbn()['Especie'])
Act(b:7, Fbn()['Cliente1'])
Act(b:8, Fbn()['ContraEspecie'])
Act(b:9, BuscarCampo('ESPECIES', 'EstadoOperativo', 'Codigo', Val(b:6)))
if (Vacio(Val(b:9)))
Act(b:9, 'NE')
endif
Act(b:10, 'NO')
if (Eqstr(Val(w:2), 'SI'))
if (Incluido(Val(b:9), 'SI|NE'))
Act(b:10, 'SI')
endif
endif
if (dialogo.check1 = 1)
Sqladd("Delete "~Dbo()~".EXCEPCIONES ")
Sqladd(" where NrOperacion = '"~Val(b:1)~"' ")
Sqladd("   and Tipo        in ('PMENOINF','PMESANCION') ")
Sqlnew()
Sqlexec()
endif
if (Eqstr(Val(b:10), 'SI'))
Act(b:11, 'Queda en inst 9')
if (Eqstr(Val(b:9), 'NE'))
Act(b:12, 'PMENOINF')
Act(b:13, 'La Especie '~Val(b:6)~' no esta informada.')
endif
if (Eqstr(Val(b:9), 'SI'))
Act(b:12, 'PMESANCION')
if (Vacio(Val(w:4)))
Act(b:13, 'La Especie '~Val(b:6)~' esta sancionada.')
else
Act(b:13, Val(w:4))
endif
endif
if (dialogo.check1 = 1)
Sqladd(" Insert into "~Dbo()~".EXCEPCIONES ( ")
Sqladd(" NrOperacion, Tipo, Fecha, Descripcion ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(b:1)~"', '"~Val(b:12)~"', '"~IdxDate(FSys())~"' , '"~Val(b:13)~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
endif
if (dialogo.check1 = 1)
Ejecutarevento('CBOINS', 'string1', Val(b:1), 'radio1', 0, 'radio2', 0, 'entero1', 1, 'entero2', 9)
endif
Messagebox('Operacion '~Val(b:1)~' No cumple alguna condicion y queda en Compliance.  Verifique Excepciones')
else
Act(b:11, 'Pasa a inst 1')
endif
proximo

if (dialogo.check1 = 0 y Fac() > 0)
FormatoCeldas(b:3..b:3, Exe('F0'))
FormatoCeldas(t:15..t:15, Exe('F2'))
FormatoCeldas(t:16..t:16, Exe('F8'))
FormatoCeldas(t:23..t:25, Exe('F0'))
FormatoCeldas(t:41..t:42, Exe('F0'))
FormatoCeldas(t:44..t:44, Exe('F0'))

ACO(1, 10)
ACO(2, 12)
ACO(19, 15)
ACO(20, 12)
endif

