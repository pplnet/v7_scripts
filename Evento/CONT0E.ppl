***---EjecutarEvento('CONT9', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Resultados por Tenencia Forward y NDF de FXs
EjecutarEvento('CONT10', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Resultados por Tenencia Futuros Mercado Regulado - Mensual o al vto.
EjecutarEvento('CONT11', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Resultados por Diferencia de Cambio Prestamos - Mensual o al vto.
***---EjecutarEvento('CONT12', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))


ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
   ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
   ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
ACD(x3, PriDeMes(Dialogo.Fecha1,SI)-1)
ACD(x4, PriDeMes(Val(x3),SI))

if Dialogo.Fecha1=Val(x2)
    ***---Asientos Mensuales
    ***---Asientos de Resultados por Tenencia - Titulos       
    EjecutarEvento('CONT4', Fecha1=Dialogo.Fecha1, Especie1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

    ***---Asientos de Resultados por Tenencia - Fondos
    EjecutarEvento('CONT5', Fecha1=Dialogo.Fecha1, Especie1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

    ***---Asientos Diferencia de Cambio Titulos y Acciones
    ***---EjecutarEvento('CONT20', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', TipoOp1='', Check1=Val(CK:1))

    ***---Asientos Diferencia de Cambio FCI
    ***---EjecutarEvento('CONT21', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', TipoOp1='', Check1=Val(CK:1))
    
    ***---Asientos Diferencia de Cambio de Saldos en Cuentas Comitentes
    EjecutarEvento('CONT25', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Check1=Val(CK:1))
    
    ***---Asientos de Reclasificacion de Deuda - Prestamos
    EjecutarEvento('CONT30', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

    ***---Asientos de Reclasificacion de Deuda - Descubiertos
    EjecutarEvento('CONT31', Fecha1=Dialogo.Fecha1, ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))
       
    Recorrer&i Val(x4), Val(x3)
      ACD(FE:1,&I)
      If DiaSem(Val(FE:1))>1 Y DiaSem(Val(FE:1))<7
         ***---Asientos de Resultados Realizados~
         Message('-----Resultados Realizados por Venta '~Val(FE:1)~'-----')
         EjecutarEvento('ANUASI', Fecha1=Val(FE:1), Fecha2=Val(FE:1), Lista2=Dialogo.Lista1, Lista1=Var('TIPASIRZ'), ListaTabla1='')
         EjecutarEvento('CONT47', Fecha1=Val(FE:1), Lista1=Dialogo.Lista1, TipoOp1='', Check1=Val(CK:1), Fecha2=Dialogo.Fecha1)
      EndIf
    Proximo
endif
IF Dialogo.Fecha1 = Habiles(Val(X:2), 1, 'ARG')
    ***---Reversa asiento devengados a fin de mes, al dia siguiente
    EjecutarEvento('CONT48', Fecha1=Habiles(Dialogo.Fecha1, -Val(X:1)), ListaTabla1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1), Fecha2=Dialogo.Fecha1)
ENDIF

