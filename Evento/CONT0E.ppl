MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1:       'TEST DE PROCESO' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif
***---Se chequea siempre si existe asiento anterior enviado
***---IF Eqstr(Var('CONTAPROCE'), 'SI')
    ACN(CK:1, 1)
***---ELSE
***---    ACN(CK:1, 0)
***---ENDIF

****              Barrera de habilitacion de proceso Contable Vrs Proceso SAP
IF Eqstr(Var('INTASIENTO'), 'SI')
      MESSAGEbOX ('Se esta ejecutando el proceso contable con SAP...Por favor intente en unos minutos',2,0)   
      Cancelar
ELSE
     ** Se coloca la variable GENASIENTO en SI para avisar/bloquear el proceso SAP  
     SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='SI' Where Codigo='GENASIENTO' ")
     SQL.NEW
     SQL.EXEC
ENDIF

***--- Borra movimientos puntuales en la tabla de MovPendientes (27-05-09) 
     SQL.ADD("DELETE "~DBO~".MOVPENDIENTES Where NrOperacion= '50001871' and NrMov ='8004' and NrGrupo2 ='5004'  ")             
     SQL.NEW
     SQL.EXEC
        
     SQL.ADD("DELETE "~DBO~".MOVPENDIENTES Where (NrOperacion= '50001651' and NrMov ='8002') or  ") 
     SQL.ADD("                                   (NrOperacion= '50001651' and NrMov ='8003') or  ") 
     SQL.ADD("                                   (NrOperacion= '50001651' and NrMov ='8102')     ")              
     SQL.NEW
     SQL.EXEC        

('FECHACIERR')

***---Anulacion de Asientos
EjecutarEvento('ANUASI', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha1, Lista2=Dialogo.Lista1, Lista1='', ListaTabla1='')

***---Asientos de Concertacion
EjecutarEvento('CONT1', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', Check1=Val(CK:1))

***---Asientos por Ingreso de Gastos
EjecutarEvento('CONT16', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Liquidacion
EjecutarEvento('CONT2', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', Check1=Val(CK:1))

***---Asientos de Devengados
EjecutarEvento('CONT3', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', TipoOp1='', Check1=Val(CK:1))

***---Asientos de Devengados de Descubiertos 
EjecutarEvento('CONT32', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', TipoOp1='', Check1=Val(CK:1))

***---Asientos de Resultados por Tenencia - Fondos
***---EjecutarEvento('CONT5', Fecha1=Dialogo.Fecha1, Especie1='', Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Corte de Cupon
EjecutarEvento('CONT6', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Pago de Dividendos
EjecutarEvento('CONT7', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Check1=Val(CK:1))

***---Asientos de Transferencias entre cuentas
***---Se comenta porque vamos a contabilizar las liquidaciones de las TRANSF
***---EjecutarEvento('CONT8', Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, ListaTabla1='', Check1=Val(CK:1))

