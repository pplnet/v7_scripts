HojaVisible(NO)
creardialogo
fecha1:'Fecha';;;;NO;;;;;Habiles(FSys(), -1, Var('FERWTIUSA'), SI);;;;;;
especie1:'Especie';;;;;;;;;'WTI';;;;;;
radio1:'Platts|No|Si';;;;;;;;;0
findialogo

if (not ok)
Cancelar()
endif

Linkearhoja('CURFUT', 1, 'fecha1', dialogo.fecha1, 'especie1', dialogo.especie1)

Sqladd("Select * from "~Dbo()~".CONTRATOS Where Especies Like '%"~dialogo.especie1~"%' and ")
Sqladd(" LastTradingDate>='"~IdxDate(dialogo.fecha1)~"' Order By LastTradingDate ")


Acn(z2, 4)
Acn(z3, 3)
Act(z6, BuscarCampo('Feriados', 'Codigo', 'Codigo', BuscarCampo('Especies', 'PaisOrigen', 'Codigo', dialogo.especie1)))

SetFilaActual(4)
Acd(c:fac, Habiles(dialogo.fecha1, -1, Val(z6), SI))
Acd(z4, dialogo.fecha1)
SetFont(a:fac..c:fac, 1)

recorrer sql
Acn(z5, Fac())

Acd(c:fac, Linkh(1, c:Val(z5)))
Acn(b:fac, Linkh(1, b:Val(z5)))


Acn(z1, DifDias(Habiles(Val(c:fac - 1), 1, Val(z6), SI), Val(c:fac), Val(z6), SI) + 1)

recorrer&i 1, Val(z1)
Message("  Actualizando Precio Futuro "~FStr(Val(b:fac), 0, 2)~" al "~Val(z4)~" ...")

if (Query("SELECT Count(*) FROM "~Dbo()~".CURVAFUTUROSCOMM Where Especie='"~dialogo.especie1~"' and Fecha='"~IdxDate(Val(z4))~"' ") = 1)
Sqladd("UPDATE "~Dbo()~".CURVAFUTUROSCOMM Set PrecioFut="~FStr(Val(b:fac), 0, 7)~" Where ")
Sqladd("Especie='"~dialogo.especie1~"' and ")
Sqladd("Fecha='"~IdxDate(Val(z4))~"' ")
else
Sqladd(" INSERT "~Dbo()~".CURVAFUTUROSCOMM ")
Sqladd(" (Especie,Fecha,PrecioFut,PrecioCon) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.especie1~"','"~IdxDate(Val(z4))~"',"~FStr(Val(b:fac), 0, 7)~",0) ")
endif

Sqlnew()
Sqlexec()

Acd(z4, Habiles(Val(z4), 1, Val(z6), SI))
proximo

Scn(z2, 1)
proximo

if (dialogo.radio1 = 1)

Acd(z8, PriDeMes(dialogo.fecha1 - 30, SI))

Sqladd("Select * from "~Dbo()~".COTIZACIONES Where Codigo='"~dialogo.especie1~"' and ")
Sqladd(" Fecha>='"~IdxDate(Val(z8))~"' Order By Fecha ")

Acn(x1, 0)
recorrer sql
Acn(x1, 1)

Message("Actualizando Precio Contado "~FStr(Fbn()['Precio1'], 0, 2)~" al "~Fbn()['Fecha']~" ...")

Sqladd("UPDATE "~Dbo()~".CURVAFUTUROSCOMM Set PrecioCon="~FStr(Fbn()['Precio1'], 0, 7)~" Where ")
Sqladd("Especie='"~dialogo.especie1~"' and ")
Sqladd("Fecha='"~IdxDate(Fbn()['Fecha'])~"' ")
Sqlnew()
Sqlexec()
proximo
endif



