*HOJAVISIBLE(SI)
* Selecciono del Archivo de Comisiones Las Comisiones 4
* Cuya Fecha de Liquidaci¦n Coincida con la Fecha del Sistema y aun no se 
* encuentren liquidadas
CrearDialogo
  Fecha1       : "Fecha"                    ;;;;;;;;;Fsys
  Lista1       : 'Vehiculos'                ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

FinDialogo

if Not Ok
  Cancelar
endif

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

SQL.ADD(" Select O.FechaOp, O.Cantidad, O.TotalComisiones, O.TotalAux3, O.TotalNetoCli3,O.TipoOp, ")
SQL.ADD(" C.* from "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" WHERE O.NrOperacion=C.NrOperacion AND C.Fecha1='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Importe1=0 AND O.TipoOp IN ('MMP','MMPV','MMFRN','MMFCMV','MMPSC','MMSCMV') AND Tipo IN ('4') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf

SQL.ADD(" ORDER BY C.NrOperacion,C.Tipo ")

Recorrer SQL   
   *-- X2: Disponible => Verifico que no se haya consumido el Total de la Operacion
   ACN(X2,FBN['TotalNetoCli3'])

   IF Incluido(FBN['TipoOp'],'MMP')
      ACN(X2,FBN['Cantidad']+FBN['TotalComisiones']-FBN['TotalAux3'])
   EndIf
   IF Incluido(FBN['TipoOp'],'MMPV')
      ACN(X2,FBN['Cantidad']-FBN['TotalAux3'])
   EndIf
*   IF VAL(X2)=0
*      MessageBox('Imposible Calcular Commitment Fee. La Operaci¦n '~FBN['NrOperacion']~' Fue Totalmente Utilizada !!!')
*   ELSE
      * Verifico que la Op. Partida se encuentre en Back Office o Terminal
      ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~FBN['NrOperacion']~"' AND Valor='1'") )

      If VAL(X1)<>20 y VAL(X1)<>50
         *-- Busco la instancia actual
         MessageBox('La Operaci¦n '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal !!!. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
      Else 
         Message("*-- Recuperando Fecha de Pago Anterior Operaci¦n: "~FBN['NrOperacion']~" Nro: "~FBN['NrComision']~"...")    
         *-- A: Desembolso a la Fecha (c) B: Valor de la Partida No Utilizado
         *-- C: Fecha Origen o Pago anterior comision
         *-- D: Tasa Comision E: UT.
         ACN(z1,fac)
         ACN(D:fac,FBN['Tasa1'])
         ACN(E:fac,IIF(FBN['RB2']=0,36000,36500))

         *-- Obtengo la Fecha de Pago Anterior para este tipo de comision
         SQL.ADD(" Select * FROM "~DBO~".COMISIONES2  ")
         SQL.ADD(" WHERE NrOperacion='"~FBN['NrOperacion']~"' AND Tipo='"~FBN['Tipo']~"' ")
         SQL.ADD(" AND Importe1<>0 AND Fecha1<'"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" ORDER BY Fecha1 DESC")
   
         * X1=1 -> Se pago con anterioridad la comision tipo 6 
         ACN(x1,0)        
         Recorrer SQL   
            DFA
            ACN(x1,1)    
            ACN(B:fac,FBN['Importe5'])
            ACD(C:fac,FBN['Fecha1'])
            Break
         Proximo

         IF VAL(X1)=0 
            * No Existe Pago Anterior 
  
            ACN(B:fac,FBN['Cantidad'])
            ACD(C:fac,FBN['FechaOp'])
  
            *-- Obtengo el Importe de la comision tipo 6 de esta operacion
            SQL.ADD(" Select * FROM "~DBO~".COMISIONES2 ")
            SQL.ADD(" WHERE NrOperacion='"~FBN['NrOperacion']~"' ")
            SQL.ADD(" AND Tipo='5' ")
   
            Recorrer SQL
               DFA
               ACN(B:fac,VAL(B:fac)+FBN['Importe1']) 
               Break                             
            Proximo
         ENDIF         

         * z1: Ubicaci¦n de la 1er. Fila por Nro. de Operacion
         * a: VN Partida b: FechaOrigen Partida c: Valor del Desembolso Anterior
         * d: Tasa Comision e: UT. 
         * h: Ultimo Tramo de la comision i: Total de comision
         * j: Valor de Comision tipo 6 de la operacion 
         *-- Recupero Los Desembolsos Asociadas a la Partida que aun no fueron tenidos en cuenta
         SQL.ADD(" Select * FROM "~DBO~".OPERACIONES ")
         SQL.ADD(" WHERE OperacionRef='"~FBN['NrOperacion']~"' ")
         SQL.ADD(" AND  FechaOp <='"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" AND  FechaOp >='"~IdxDate(VAL(C:fac))~"' ")
         SQL.ADD(" ORDER BY FechaOp ")
   
         ACN(y1,0)

         Recorrer SQL   
            * Verifico que la Op. Partida se encuentre en Back Office o Terminal
            ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~FBN['NrOperacion']~"' AND Valor='1'") )

            If VAL(X1)<>20 y VAL(X1)<>50
               *-- Busco la instancia actual
               MessageBox('La Operaci¦n '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal !!!. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
               ACN(y1,1)
               Break
            EndIf
        
            ACN(A:fac,FBN['Cantidad'])       
            ACD(C:fac,FBN['FechaOp'])       
 
            *-- Obtengo el Importe de la comision tipo 6 de esta operacion
            SQL.ADD(" Select * FROM "~DBO~".COMISIONES2 ")
            SQL.ADD(" WHERE NrOperacion='"~FBN['NrOperacion']~"' ")
            SQL.ADD(" AND Tipo='5' ")
     
            Recorrer SQL
               DFA
               ACN(A:fac,VAL(A:fac)+FBN['Importe1']) 
               Break                             
            Proximo
 
            * Actualizo el monto no utilizado a fecha c
            ACN(B:fac,VAL(B:fac-1)-VAL(A:fac)) 
  
            *-- F: Subtotales de comision G: Acumulados Desembolsos Anteriores al Evaluado
            * Paso1: Solamente se aplica para la Evaluacion del Primer Pago de Comision
            ACN(F:fac, (VAL(B:fac-1)*VAL(D:VAL(z1))*(VAL(c:fac)-VAL(c:fac-1)))/VAL(e:val(z1)))
  
            ACN(G:fac,VAL(g:fac-1)+VAL(f:fac))
         Proximo

         If VAL(y1)=0
            * Todas las Op. estan en la instancia correcta
            IFA

            * Calculo el Ultimo Tramo de la Comision
            ACN(f:fac,(VAL(B:fac-1)*VAL(D:VAL(z1))*(Dialogo.Fecha1-VAL(c:fac-1)))/VAL(e:val(z1)))  
            ACN(G:fac,VAL(g:fac-1)+VAL(f:fac) )
    
            * J: Importe de Iva  K: Importe de WH L: Impuesto Interes
            ACN(J:fac,VAL(G:fac)*FBN['Tasa2']/100)
            ACN(K:fac,VAL(G:fac)*FBN['Tasa3']/100) 
            ACN(L:fac,VAL(G:fac)*FBN['Precio1']/100) 

            Message('Actualizar Comisiones ...')

            *-- Actualizo la Comision
            SQL.ADD(" UPDATE "~DBO~".COMISIONES2 ")
            SQL.ADD(" SET Importe1="~Fstr(VAL(G:fac),0,2)~", ")
            SQL.ADD("     Importe2="~Fstr(VAL(J:fac),0,2)~", ")
            SQL.ADD("     Importe3="~Fstr(VAL(K:fac),0,2)~", ")
            SQL.ADD("     Precio2 ="~Fstr(VAL(L:fac),0,2)~", ")
            SQL.ADD("     Importe4="~Fstr(VAL(K:fac)+VAL(G:fac)+VAL(l:fac),0,2)~", ")
            SQL.ADD("     Importe5="~Fstr(VAL(B:fac-1),0,2)~" ")
            SQL.ADD(" WHERE NrOperacion='"~FBN['NrOperacion']~"' and ")
            SQL.ADD(" NrComision="~Fstr(FBN['NrComision'],0,0)~" ")
            SQL.NEW
            SQL.EXEC

            * Actualizo la Instancia de la Operacion a Supervision
            ACT(i3,fbn['NrOperacion'])
            (.'MODIINSTAN'.)      

            *** Actualiza movimientos y limites ****
            SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
            SQL.EXEC
         EndIf
      EndIf
*   ENDIF
Proximo

