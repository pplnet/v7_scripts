if (dialogo.check1 = 0)
sql.add("Select O.* From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
else
sql.add("Select O.NrOperacion  From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
endif
sql.add(" Where FechaOp = "~IdxDate2(dialogo.fecha1)~" ")
sql.add("   and TipoOp in ('TIC','TIV','TCOPRI') ")
sql.add("   and ContraEspecie <> '"~Var('MONELOCA')~"' ")
sql.add("   AND O.NrOperacion = OB.NrOperacion ")
sql.add("   AND OB.NrBit Not in (30,31) ")
sql.add("   AND OB.Valor = 1 ")
recorrer sql
Message(Fbn('NrOperacion'))
Act(a:fac, Fbn('NrOperacion'))
if (dialogo.check1 = 0)
Act(b:fac, Fbn('TipoOp'))
Act(c:fac, Fbn('Especie'))
Act(d:fac, Fbn('ContraEspecie'))
Acn(e:fac, Fbn('Cantidad'))
Acn(f:fac, Fbn('Precio1'))
Acn(g:fac, Fbn('TotalNetoCli1'))
Acn(h:fac, Fbn('PorDerechoMercado'))
Acn(i:fac, CotizacionC(Fbn('ContraEspecie'), null, null, null, Fbn('FechaOp'), 25, SI, Var('MONELOCA')))
else
sql.actualizarmovimientos3(Val(a:fac), NO, NO, NO, SI, NO)
sql.exec
endif
