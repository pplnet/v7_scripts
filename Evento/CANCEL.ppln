endif
if (NoVacio(dialogo.cliente1))
sql.add("and Cliente1 = '"~dialogo.cliente1~"'")
endif
if (NoVacio(dialogo.tipoop1))
sql.add("and TipoOp = '"~dialogo.tipoop1~"'")
else
sql.add("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPFP','MMPO','MMAD','MMDES','MMCA')")
endif
if (NoVacio(dialogo.operador))
sql.add("and Operador = '"~dialogo.operador~"'")
endif
sql.add("and (RB6 = '0' or RB6 is NULL)")
sql.add("order by Cliente1, Especie, TipoOp")

