creardialogo
cliente1:'Cliente'
especie1:'Especie'
tipoop1:'Tipo Op.'
operador:'Operador';;;;;;;;;UsuarioActivo()
findialogo


Sqladd("Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, TotalIntereses from "~Dbo()~".OPERACIONES where FechaVto = '"~IdxDate(FSys())~"'")
if (NoVacio(dialogo.especie1))
Sqladd("and Especie = '"~dialogo.especie1~"'")
endif
if (NoVacio(dialogo.cliente1))
Sqladd("and Cliente1 = '"~dialogo.cliente1~"'")
endif
if (NoVacio(dialogo.tipoop1))
Sqladd("and TipoOp = '"~dialogo.tipoop1~"'")
else
Sqladd("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPFP','MMPO','MMAD','MMDES','MMCA')")
endif
if (NoVacio(dialogo.operador))
Sqladd("and Operador = '"~dialogo.operador~"'")
endif
Sqladd("and (RB6 = '0' or RB6 is NULL)")
Sqladd("order by Cliente1, Especie, TipoOp")

Acn(z1, 0)
recorrer sql
Act(a:fac, Fbn('Cliente1'))
Act(b:fac, Fbn('Especie'))
Act(c:fac, Fbn('TipoOp'))
Acn(d:fac, Fbn('Cantidad'))
Acn(e:fac, Fbn('Precio1'))
Acn(f:fac, Fbn('TotalIntereses'))
Acn(g:fac, Fbn('Plazo'))
Act(h:fac, Fbn('NrOperacion'))
Scn(z1, 1)
proximo

ACO(1, 10)
