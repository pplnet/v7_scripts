MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';;;;;;;;;FSys()
lista1: 'Vehiculos';;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
listatabla1: 'Operaciones';-4;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';;;;NO;NO;

findialogo

if (not ok)
Cancelar()
endif

Message('--- Asientos de Transferencias FCI ---')

Sqladd(" SELECT O.NrOperacion, O.Cantidad, O.ContraEspecie Moneda, MA.Codigo CodAsi, ")
Sqladd(" O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.Cuenta4 Cuenta2, O.TipoOp, ")
Sqladd(" O.Cuenta1, V.Valor1, V.Valor2, O.Cliente1, O.Precio1, O.Plazo, O.Observaciones, M.Cuenta, ")
Sqladd(" '' Alias8, M.NrTrans2, O.ContraEspecie Cotiza, O.MB3, V.Alias4, O.FechaPago FechaCobro, O.CB7 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".VEHICULOS V, ")
Sqladd(" "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" WHERE O.NrOperacion = M.NrOperacion ")
Sqladd(" AND T.NrOperacionRef1 = O.NrOperacion ")
Sqladd(" AND T.NrTrans     =  M.NrTrans2 ")
Sqladd(" AND T.TipoTr2 in ('DEP','RET') ")
Sqladd(" AND O.Vehiculo1 =  V.Codigo  ")
Sqladd(" AND O.TipoOp in ('TRANFC') ")
Sqladd(" AND O.TipoOp = MA.TipoOp ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITRAN'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
else 
Sqladd(" AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
endif
Sqladd(" ORDER By MA.Codigo, O.NrOperacion ")

recorrer sql
Acd(fv:1, Fbn('FechaVto'))
Act(vh:1, Fbn('Vehiculo1'))
Act(ct:9, CotizaEn(Fbn('Especie')))

Acn(cn:1, Fbn('Cantidad'))
Acn(ct:1, CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaVto'), 1, SI, Val(ct:9)))
Acn(ct:2, CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaCobro'), 1, SI, Val(ct:9)))
Acn(ct:3, CotizacionC(Fbn('Especie'), null, null, null, FinDeMes(PriDeMes(dialogo.fecha1, SI) - 1, NO), 1, SI, Val(ct:9)))
Acn(rv:1, Val(cn:1) * (Val(ct:1) - Val(ct:2)))
Acn(ma:1, Val(cn:1) * Val(ct:3))

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND NrTrans2 = '"~Fbn('NrTrans2')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)

Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, Fbn('NrTrans2'), null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
