sql.add(" SELECT O.NrOperacion, O.Cantidad, O.ContraEspecie Moneda, MA.Codigo CodAsi, ")
sql.add(" O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.Cuenta4 Cuenta2, O.TipoOp, ")
sql.add(" O.Cuenta1, V.Valor1, V.Valor2, O.Cliente1, O.Precio1, O.Plazo, O.Observaciones, M.Cuenta, ")
sql.add(" '' Alias8, M.NrTrans2, O.ContraEspecie Cotiza, O.MB3, V.Alias4, O.FechaPago FechaCobro, O.CB7 ")
sql.add(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".VEHICULOS V, ")
sql.add(" "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T ")
sql.add(" WHERE O.NrOperacion = M.NrOperacion ")
sql.add(" AND T.NrOperacionRef1 = O.NrOperacion ")
sql.add(" AND T.NrTrans     =  M.NrTrans2 ")
sql.add(" AND T.TipoTr2 in ('DEP','RET') ")
sql.add(" AND O.Vehiculo1 =  V.Codigo  ")
sql.add(" AND O.TipoOp in ('TRANFC') ")
sql.add(" AND O.TipoOp = MA.TipoOp ")
sql.add(" AND M.NrSaldo = 1 ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASITRAN'))~") ")
sql.add(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.listatabla1))
sql.add(" AND O.NrOperacion IN ("~pipe2comillas(dialogo.listatabla1)~") ")
else
sql.add(" AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.lista1))
sql.add(" AND O.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
sql.add(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
sql.add(" OR ")
endif
proximo
sql.add(") ")
