MostrarCuadroDeMensajes()
creardialogo
nrtrans1: 'Nro.Comprobante';;;;;;Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'DEP|RET|MATCH');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('DEP','RET','MATCH') and (CB3 = '1') ";
radio1:'Cierre OCT';;;;NO;NO;;;;0;
findialogo

if (not ok)
Cancelar()
endif

if (Eqstr(BuscarCampo('TRANSACCIONES2', 'Mercado1', 'NrTrans', dialogo.nrtrans1), Var('MERCOCT')))
Cancelar('Las Fallas OCT no Pueden Anularse con este Proceso')
endif
if (BuscarCampo('TRANSACCIONES2', 'CB9', 'NrTrans', dialogo.nrtrans1) = 1)
Cancelar('El Voucher '~dialogo.nrtrans1~' esta confirmado')
endif

Act(mo:1, Var('MERCOCT'))

Sqladd("Select T.NrTrans, T.NrTransRef1, T.Mercado1, T.CB9, T.TipoTr2, T.NrOperacionRef2 , T.Cantidad1 ")
Sqladd("from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
Sqladd("where T.NrTrans = B.NrOperacion ")
Sqladd("and T.NrTrans = '"~dialogo.nrtrans1~"' ")
Sqladd("and (")
Sqladd("(B.NrBit = 8 and B.Valor = '1' and (T.CB9 = '0' or T.CB9 is NULL) and T.Mercado1 not in  ('CE','EU','CRYL','ARGEN') )")
Sqladd("or ( (B.NrBit = 3 or B.NrBit = 6) and B.Valor = '1' and T.CB3 = '1' and T.Mercado1 in ('CE','EU','CRYL','ARGEN'))")
Sqladd(")")

recorrer sql
if (not Incluido(Fbn()['Mercado1'], Var('MERCTITULO')))
Message('Anulacion TRANSP Nr. '~Fbn()['NrTransRef1'])

Act(a:fac, Fbn()['NrTrans'])
Act(b:fac, Fbn()['NrTransRef1'])
Act(c:fac, Fbn()['Mercado1'])
Act(d:fac, Fbn()['TipoTr2'])

if (Query("Select Count(*) from "~Dbo()~".MOVPENDIENTES where NrOperacion = '"~Val(b:fac)~"' and NrSaldo = 1 ") = 0)
Cancelar('El Voucher de Transporte '~Val(b:fac)~' ya esta liquidado')
endif

Sqladd("DELETE from "~Dbo()~".INSTANCIASOP where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVPENDIENTES where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".TRANSACCIONES2 where NrTrans = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVLIMITES where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("Delete from "~Dbo()~".INSTANCIASOP ")
Sqladd("Where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and (NrInstancia = 3 or NrInstancia = 6 )")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2 ")
Sqladd("SET Fecha3 = NULL, ")
Sqladd("NrTransRef1 = NUll, ")
Sqladd("Cantidad3 = NUll, ")
Sqladd("Cantidad4 = NUll, ")
Sqladd("CB3 = NULL ")
Sqladd("Where NrTrans = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '0' ")
Sqladd("where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and NrBit = 8")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '1' ")
Sqladd("where NrOperacion = '"~dialogo.nrtrans1~"' ")
if (Eqstr(Val(d:fac), 'DEP'))
Sqladd("and NrBit = 3 ")
else
Sqladd("and NrBit = 6 ")
endif
Sqlnew()
Sqlexec()

if (Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', Fbn()['NrOperacionRef2']), 'DTP|RTP'))
Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2                     ")
Sqladd("SET    CB10='0' ")
if (not Eqstr(Val(d:fac), 'MATCH'))
Sqladd(" , Cantidad1 = '"~FStr(Fbn()['Cantidad1'], 1, 2)~"'  ")
endif
Sqladd("WHERE  NrTrans= '"~Fbn()['NrOperacionRef2']~"'      ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientost2(Fbn()['NrOperacionRef2'], SI, NO, NO, SI, 0, 4)
Sqlexec()
endif
else
Message('Anulacion falla Cedel/CRYL/EU')
Acn(x1, Query("Select Count(*) from "~Dbo()~".INSTANCIASOP where NrOperacion = '"~dialogo.nrtrans1~"' and NrInstancia = 30 "))
Act(x2, Fecha(FSys(), 'YYYY.MM.DD'))

Sqladd("Delete from "~Dbo()~".INSTANCIASOP ")
Sqladd("Where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and NrInstancia = 30 ")
Sqladd("and Convert(Char,Fecha,102) = '"~Val(x2)~"' ")
Sqlnew()
Sqladd("Delete from "~Dbo()~".MOVEJECUTADOS  ")
Sqladd("Where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and Transaccion = 'Falla' ")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVLIMITES where NrOperacion = '"~dialogo.nrtrans1~"'")
Sqlnew()

if (Val(x1) = 1)
Sqladd("Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd("Set CB3 = '0'")
Sqladd("Where NrTrans = '"~dialogo.nrtrans1~"' ")
Sqlnew()
endif

if (Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', Fbn()['NrOperacionRef2']), 'DTP|RTP'))
Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2                               ")
Sqladd("SET    CB10='0'                                             ")
if (not Eqstr(Fbn()['TipoTr2'], 'MATCH'))
Sqladd(" , Cantidad1 = '"~FStr(Fbn()['Cantidad1'], 1, 2)~"'          ")
endif
Sqladd("WHERE  NrTrans= '"~Fbn()['NrOperacionRef2']~"'                ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientost2(Fbn()['NrOperacionRef2'], SI, NO, NO, SI, 0, 4)
Sqlexec()
endif
Sqlexec()
endif
proximo
if (Fac() = 0)
Cancelar('El Voucher '~dialogo.nrtrans1~' no se puede desfallar.')
endif

