Sqladd("SELECT DISTINCT MP.NrOperacion ")
Sqladd("FROM "~Dbo()~".OPERACIONESBITS OB, "~Dbo()~".MOVPENDIENTES MP ")
Sqladd("WHERE OB.NrBit = 30 AND ")
Sqladd("      OB.Valor = 1 AND ")
Sqladd("      OB.NrOperacion = MP.NrOperacion ")
Sqladd("ORDER BY MP.NrOperacion ")

