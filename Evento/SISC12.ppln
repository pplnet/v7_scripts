sql.add("       CONVERT(INTEGER, E3.Alias7) CodSISCEN, CONVERT(INTEGER, E1.Alias7) Moneda, O.Especie, C.SectorBCRA, C.Persona, O.FechaOp, O.FechaVto, C.RazonSocial, ")
sql.add("       CASE WHEN C.Jerarquia like '"~Val(je1)~"%' THEN '0003' ELSE CASE WHEN C.Jerarquia like '"~Val(je2)~"%' THEN '0039' ELSE CASE WHEN C.Jerarquia like '"~Val(je3)~"%' THEN '0001' ELSE CASE C.Persona WHEN 'SI' THEN '0027' ELSE '0031' END END END END  TipoTit ")
sql.add("From "~Dbo()~".OPERACIONES O JOIN "~Dbo()~".OPERACIONESBITS OP ON O.NrOperacion=OP.NrOperacion ")
sql.add("       JOIN "~Dbo()~".CLIENTES C ON O.Cliente1 = C.Codigo ")
sql.add("       JOIN "~Dbo()~".ESPECIES E3 ON E3.Codigo = O.Especie ")
sql.add("       JOIN "~Dbo()~".ESPECIES E1 ON E1.Codigo = E3.MonedaEmision ")
sql.add("Where  O.TipoOp IN ('TIC','TIV','TIFC','TIFV') AND OP.Valor=1 ")
sql.add("       and OP.NrBit<>30 and OP.NrBit<>31 ")
sql.add("   and O.FechaOp >= "~IdxDate2(dialogo.fecha1))
sql.add("   and O.FechaOp <= "~IdxDate2(dialogo.fecha2))
sql.add("Order By TipoTit, Moneda,CodSISCEN,TipoTran ")

