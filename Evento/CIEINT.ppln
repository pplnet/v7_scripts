SetFilaActual(2)
Message('Buscando Operaciones...')
Sqladd("Select 'Orig' Tipo,Especie,NrOperacion from "~Dbo()~".OPERACIONES ")
Sqladd("Where Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd("  and FechaVto  = '"~IdxDate(Habiles(dialogo.fecha1, 1, 'ARG'))~"'  and FechaVto2 is null ")
Sqladd("  and TipoOp In ('TICO','TICT','TIDE','TIPO') AND (CB8 Is Null or CB8='' or CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("Union All")
Sqladd("Select 'Prec' Tipo,Especie,NrOperacion from "~Dbo()~".OPERACIONES ")
Sqladd("Where Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd(" and FechaVto  = '"~IdxDate(dialogo.fecha1)~"' and FechaVto2 > FechaVto and  CB2=1 ")
Sqladd(" and TipoOp In ('TICO','TICT','TIDE','TIPO') AND (CB8 Is Null or CB8='' or CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("Union All")
Sqladd("Select 'Cuot' Tipo,O.Especie,O.NrOperacion from "~Dbo()~".OPERACIONES O,"~Dbo()~".CUOTAS CU ")
Sqladd("Where O.NrOperacion=CU.NrOperacion and O.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd("and CU.Fecha1 = '"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd("and TipoOp In ('TICO','TIPO') and (CU.Precio1=0 or CU.Precio1 Is Null) AND (O.CB8 Is Null or O.CB8='' or O.CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("Order by Especie,NrOperacion ")
Watch(Sqlbatch())
recorrer sql
recorrer&i 3, Val(zz3) + 2
if (Eqstr(Val(x:&i)~Val(u:&i), Fbn()['Tipo']~Fbn()['Especie']))
Acn(b:fac, Val(v:&i))
break
endif
proximo
