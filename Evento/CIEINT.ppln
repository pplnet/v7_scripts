if (Val(v:fac) = 0)
Acn(v:fac, cotizaciondirecta(Fbn()['Especie'], null, dialogo.fecha1, 1, Fbn('ContraEspecie'), Var('AMBMAE'), 48))
endif
endif
endif
endif
endif
endif
Acn(w:fac, Fbn()['Fecha'])
Act(x:fac, Fbn()['Tipo'])
Scn(zz3, 1)
Act(es1, Fbn()['Tipo']~Fbn()['Especie'])
else
Dfa()
endif
proximo

