SetFilaActual(2)
Acn(zz3, 0)
Message('Buscando Cotizaciones...')
Sqladd(" Select 'Orig' Tipo, O.Especie, C1.Precio1 PrecioCartera, C1.Fecha, O.ContraEspecie ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".COTIZACIONES C1 ")
Sqladd(" Where C1.Codigo = O.Especie ")
Sqladd(" and O.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd(" and O.FechaVto  = '"~IdxDate(Habiles(dialogo.fecha1, 1, 'ARG'))~"'  and O.FechaVto2 is null ")
Sqladd(" and O.TipoOp In ('TICO','TICT','TIDE','TIPO') AND (O.CB8 Is Null or O.CB8='' or O.CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd(" and C1.Fecha = (SELECT MAX(Fecha)  FROM "~Dbo()~".COTIZACIONES C2  ")
Sqladd("                 WHERE C2.Codigo = C1.Codigo                      ")
Sqladd("                 AND   (C2.Precio1 is not null AND C2.Precio1<>0)  ")
Sqladd("                 AND   C2.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd(" Union ")
Sqladd(" Select 'Prec' Tipo, O.Especie, C1.Precio1 PrecioCartera, C1.Fecha, O.ContraEspecie ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".COTIZACIONES C1 ")
Sqladd(" Where C1.Codigo = O.Especie ")
Sqladd(" and O.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd(" and O.FechaVto  = '"~IdxDate(dialogo.fecha1)~"' and O.FechaVto2 > O.FechaVto and  CB2=1 ")
Sqladd(" and O.TipoOp In ('TICO','TICT','TIDE','TIPO') AND (O.CB8 Is Null or O.CB8='' or O.CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd(" and C1.Fecha = (SELECT MAX(Fecha)  FROM "~Dbo()~".COTIZACIONES C2  ")
Sqladd("                 WHERE C2.Codigo = C1.Codigo                      ")
Sqladd("                 AND   (C2.Precio1 is not null AND C2.Precio1<>0)  ")
Sqladd("                 AND   C2.Fecha <= '"~IdxDate(dialogo.fecha1 - 1)~"') ")
Sqladd(" Union ")
Sqladd(" Select 'Cuot' Tipo, O.Especie, C1.Precio1 PrecioCartera, C1.Fecha, O.ContraEspecie ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".COTIZACIONES C1, "~Dbo()~".CUOTAS CU ")
Sqladd(" Where CU.NrOperacion = O.NrOperacion ")
Sqladd(" and C1.Codigo        = O.Especie ")
Sqladd(" and O.Vehiculo1      = '"~dialogo.vehiculo1~"'       ")
Sqladd(" and CU.Fecha1        = '"~IdxDate(Habiles(dialogo.fecha1, 1, 'ARG'))~"' ")
Sqladd(" and O.TipoOp In ('TICO','TIPO')  and (CU.Precio1=0 or CU.Precio1 Is Null) AND (O.CB8 Is Null or O.CB8='' or O.CB8='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd(" and C1.Fecha         = (SELECT MAX(Fecha) FROM "~Dbo()~".COTIZACIONES C2     ")
Sqladd("                          WHERE C2.Codigo  = C1.Codigo                      ")
Sqladd("                          AND   (C2.Precio1 is not null AND C2.Precio1<>0) ")
Sqladd("                          AND    C2.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("  Order by Tipo,O.Especie ")
Watch(Sqlbatch())
recorrer sql
if (not Eqstr(Fbn()['Tipo']~Fbn()['Especie'], Val(es1)))
