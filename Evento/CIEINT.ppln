if (Val(v:fac) = 0)
Acn(v:fac, cotizaciondirecta(Fbn()['Especie'], null, dialogo.fecha1, 1, Fbn('ContraEspecie'), 'BYMA', 24))
if (Val(v:fac) = 0)
