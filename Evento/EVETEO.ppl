** FJL 07/04/2025 - Ajuste Posicion GD38
CrearDialogo
  Check1 : 'Procesa'                ;;;;;;;;;0
FinDialogo
if not OK
  Cancelar
endif   

IF Dialogo.Check1=0
  HOJAVISIBLE(SI) 
Endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:1, 'Especie')  
ACT(a:2, 'Trans')  
ACT(a:3, 'MovsPosPen')  
ACT(a:4, 'MovsPosEje')  

ACT(b:1, 'GD38')
ACT(b:2, 'TE034661')
ACN(b:3, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))
ACN(b:4, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))

ACT(d:2, 'TE034662')
ACN(d:3, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(d:2)~"' "))
ACN(d:4, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(d:2)~"' "))

if Val(b:4)=0
  MessageBox('Error en movimientos transaccion '~Val(b:2)~'. Puede ser que el ajuste ya se haya ejecutado.')
  ACN(x:2, 1)
endif

SetFilaActual(5)
SQL.ADD("Select * from "~DBO~".MOVPOSEJE ")
SQL.ADD(" WHERE Especie       = '"~Val(b:1)~"' ")
SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACD(c:fac, fbn('FechaMov'))
  ACT(d:fac, fbn('Estrategia'))
  ACN(f:fac, fbn('NrSaldo'))
  ACN(g:fac, fbn('Cantidad'))
proximo
SQL.ADD("Select * from "~DBO~".MOVPOSEJE ")
SQL.ADD(" WHERE Especie       = '"~Val(b:1)~"' ")
SQL.ADD("   AND NrOperacion = '"~Val(d:2)~"' ")
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACD(c:fac, fbn('FechaMov'))
  ACT(d:fac, fbn('Estrategia'))
  ACN(f:fac, fbn('NrSaldo'))
  ACN(g:fac, fbn('Cantidad'))
proximo

if Dialogo.Check1=1 y Val(x:2)=0
  SQL.ADD("Delete "~DBO~".MOVPOSPEN ")
  SQL.ADD(" WHERE Especie     = '"~Val(b:1)~"' ")
  SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
  SQL.NEW

  SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
  SQL.ADD(" WHERE Especie     = '"~Val(b:1)~"' ")
  SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
  SQL.NEW

  MessageBox('Se ajusto la transacccion '~Val(b:2)~' - Especie '~Val(b:1))
  ACT(c:2, 'Ajustada')

  SQL.ADD("Delete "~DBO~".MOVPOSPEN ")
  SQL.ADD(" WHERE Especie     = '"~Val(b:1)~"' ")
  SQL.ADD("   AND NrOperacion = '"~Val(d:2)~"' ")
  SQL.NEW

  SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
  SQL.ADD(" WHERE Especie     = '"~Val(b:1)~"' ")
  SQL.ADD("   AND NrOperacion = '"~Val(d:2)~"' ")
  SQL.NEW

  SQL.EXEC
  MessageBox('Se ajusto la transacccion '~Val(d:2)~' - Especie '~Val(b:1))
  ACT(e:2, 'Ajustada')
endif

ACN(c:3, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))
ACN(c:4, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))
ACN(e:3, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(d:2)~"' "))
ACN(e:4, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(d:2)~"' "))

if Dialogo.Check1=0
  MessageBox('Evento finalizo Sin Procesar')
else
  MessageBox('Evento finalizo correctamente')
endif
