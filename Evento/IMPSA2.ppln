HojaVisible(SI)
mostrarcuadrodemensajes

creardialogo
fecha1: 'Fecha Saldos';1;1;1;SI;SI;EsHabil(dialogo.fecha1, 'ARG');'Dia no habil';SI;Habiles(FSys(), -1, 'ARG')
directorio1: 'Path ';2;1;1;SI;SI;;;;Var('PATHDN')
string1: 'Archivo ';3;1;1;SI;SI;;;;Var('FILEDN')
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar()('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar()('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar()('El directorio '~dialogo.directorio1~' no existe')
endif


let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

Act(c:1, 'Informe de errores de Importacion de Saldos Bancarios')
SetFont(c:1, 1)
Act(a:3, 'Fecha: '~dialogo.fecha1)
SetFont(a:3, 2)

importarxls(g:4..h:10000, zy:4..zz:100000, &pf)
if (not ok)
Cancelar()('Error al cargar el archivo'~&pf)
endif

let(&fecsaldos, Fecha(Val(zz:4)))

if (&fecsaldos <> dialogo.fecha1)
Cancelar()('Fecha Saldos('~dialogo.fecha1~') y fecha del XLS('~&fecsaldos~') son distintas')
endif

SetFilaActual(4)
Acn(fa:1, Fac())

Message('Procesando datos')
recorrer&i 5, 100000

if (NoVacio(Val(zy:&i)))
Act(a:Val(fa:1), 'Mensaje de Error')
Ifa()
SetFont(a:Val(fa:1), 2)
AgregarMarco(a:Val(fa:1)..f:Val(fa:1), 1, 1, exe('COLOR'))

let(&ultfila, Fac())
endif
proximo

Act(a:&ultfila + 2, 'FIN DEL INFORME')
SetFont(a:&ultfila + 2, 2)


LimitesVision(i:&ultfila + 2)
Message('Insertando registros en la Base de Datos')


recorrer&j 5, 100000

if (NoVacio(Val(zy:&j)))

let(&nombrecta, BuscarCampo('CUENTAS', 'Nombre', 'Numero', Val(zy:&j)))
let(&bancocta, BuscarCampo('Clientes', 'Alias3', 'Codigo', BuscarCampo('Cuentas', 'Comitente', 'Numero', Val(zy:&j))))


if (sql(" Select 1 from "~Dbo()~".CUENTAS Where Numero ='"~Val(zy:&j)~"' ") <> 1)
Act(a:&j, 'No existe la cuenta Nr: '~Val(zy:&j)~'  ')
ColorCeldas(a:&j, clred)
else
if (sql(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo >= '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~Val(zy:&j)~"' and Estado <> 'ANU'  ") = 1)
if (sql(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~Val(zy:&j)~"' and Estado <> 'ANU'  ") = 1)
Act(a:&j, 'Ya existe saldo para la cuenta Nr: '~Val(zy:&j)~' al '~dialogo.fecha1~' ')
else
Act(a:&j, 'Existen saldos posteriores para la cuenta Nr: '~Val(zy:&j)~' al '~dialogo.fecha1~' ')
endif
ColorCeldas(a:&j, clred)
else

Acd(dd:1, Fecha(PriDeMes(&fecsaldos, SI)))
let(&contable, 0)
let(&operativo, 0)
let(&inicial, 0)
let(&dias, 0)
if (Val(dd:1) < &fecsaldos)
sql.add(" Select TOP 1 SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu from "~Dbo()~".SALDOSBANCARIOS ")
sql.add(" where NrCuenta = '"~Val(zy:&j)~"' and FechaSaldo < '"~IdxDate(&fecsaldos)~"' and  FechaSaldo >= '"~IdxDate(Val(dd:1))~"' and Estado <> 'ANU' ")
sql.add(" Order by FechaSaldo DESC ")
recorrer sql
let(&contable, Fbn()['SaldoAcuCon'])
let(&operativo, Fbn()['SaldoAcuOpe'])
let(&inicial, Fbn()['SaldoAcuIni'])
let(&dias, Fbn()['DiasAcu'])
break
proximo
endif

let(&contable, &contable + Val(zz:&j))

let(&inicial, &inicial + Val(zz:&j))

let(&operativo, &operativo + Val(zz:&j))

let(&flag2, 0)

recorrer&k &fecsaldos, Habiles(&fecsaldos, +1, 'ARG') - 1
let(&dias, &dias + 1)
if (&flag2 = 0 y Fecha(&k) > FinDeMes(&fecsaldos, SI))
let(&dias, 1)
let(&flag2, 1)
let(&operativo, Val(zz:&j))
let(&contable, Val(zz:&j))
let(&inicial, Val(zz:&j))
else
if (&k > &fecsaldos)
let(&operativo, &operativo + Val(zz:&j))
let(&contable, &contable + Val(zz:&j))
let(&inicial, &inicial + Val(zz:&j))
endif
endif
let(&signoinicial, iif (Val(zz:&j) > 0, 'C', 'D'))
sql.add(" INSERT INTO "~Dbo()~".SALDOSBANCARIOS ")
sql.add(" (FechaSaldo, FechaBajada, FechaCarga, NrCuenta, Nombre, SaldoContable, ")
sql.add(" SaldoInicio, SaldoOperativo, Proyectado24h, Proyectado48h, ")
sql.add(" Estado, Banco, ")
sql.add(" SaldoOpePromedio, SaldoConPromedio, Usuario, SaldoIniPromedio, ")
sql.add(" SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, Ajuste, ")
sql.add(" SignoInicial) ")
sql.add(" Values('"~IdxDate(Fecha(&k))~"' , '"~IdxDate(FSys())~"' , "~SQLAhora()~" , '"~Val(zy:&j)~"' , '"~Copy(&nombrecta, 1, 40)~"' , "~FStr(Val(zz:&j), 1, 2)~" , ")
sql.add(" "~FStr(Val(zz:&j), 1, 2)~" , "~FStr(Val(zz:&j), 1, 2)~" , "~FStr(Val(zz:&j), 1, 2)~" , "~FStr(Val(zz:&j), 1, 2)~" , ")
sql.add(" 'REC' , '"~&bancocta~"' , ")
sql.add(" "~FStr(&operativo / &dias, 1, 2)~" , "~FStr(&contable / &dias, 1, 2)~" , '"~UsuarioActivo()~"' , "~FStr(&inicial / &dias, 1, 2)~" , ")
sql.add(" "~FStr(&contable, 1, 2)~", "~FStr(&operativo, 1, 2)~", "~FStr(&inicial, 1, 2)~", "~FStr(&dias, 1, 0)~", 0,  ")
sql.add(" '"~&signoinicial~"') ")
sql.new
sql.exec
proximo

endif
endif
else
break
endif

proximo

