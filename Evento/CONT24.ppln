Sqladd(" Values ")
Sqladd(" ( '"~UsuarioActivo()~"', '"~IdxDate(Trunc(Ahora()))~' '~Hora(Ahora())~"', 'EVE', 'CONT24','Inicio') ")
Sqlnew()
Sqlexec()
