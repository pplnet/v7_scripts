creardialogo
nroperacion1: 'NrOperacion';1;1;1;;;NoVacio(dialogo.nroperacion1);'Debe ingresar una operacion';NO;
radio1: "Accion|Aprueba|Desaprueba|";1;2;1;;;dialogo.radio1 >= 0;'Debe elegir una opcion';NO;0;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
sql.add("Update "~Dbo()~".OPERACIONES set Fecha1 = '"~IdxDate(FSys())~"' where NrOperacion = '"~dialogo.nroperacion1~"' and (Fecha1='' or Fecha1 is NULL) ")
sql.new
sql.exec
else
sql.add("Update "~Dbo()~".OPERACIONES set Fecha1 = NULL where NrOperacion = '"~dialogo.nroperacion1~"'")
sql.new
sql.exec
endif
