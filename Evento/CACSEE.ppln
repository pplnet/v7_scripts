ModoReproceso(SinDialogo())
creardialogo
nroperacion1: 'Operacion';;;;;;Incluido(Query("Select TipoOp From "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"' "), 'SEVS|SECS');'El TipoOp debe ser SECS o SEVS';NO;;;;;;"TipoOp in ('SECS','SEVS')";
directorio1: 'Path carta';;;;;;NoVacio(dialogo.directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
string1: 'File carta';;;;;;NoVacio(dialogo.string1);'Debe ingresar un documento';NO;Var('FILECACSEE')
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar('El directorio '~dialogo.directorio1~' no existe')
endif


let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif


SetFilaActual(1)
Sqladd(" Select C.Localidad, C.Fax, C.Telefono, C.Direccion, C.PaisDir, C.CodigoPostal, C.CUIT, O.Vehiculo1 ")
Sqladd(" From "~Dbo()~".CLIENTES C ")
Sqladd(" JOIN "~Dbo()~".OPERACIONES O ")
Sqladd(" on C.Codigo = O.Vehiculo1 ")
Sqladd(" where O.NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
let(&direccion, Fbn('Direccion'))
let(&codigo_postal, Fbn('CodigoPostal'))
let(&localidad, Fbn('Localidad'))
let(&pais, BuscarCampo('PAISES', 'Nombre', 'Codigo', Fbn('PaisDir')))
let(&cuit, Fbn('CUIT'))
let(&personas, Var('CONURUSE'))
let(&fax, Fbn('Fax'))
proximo


Sqladd(" Select O.TipoOp,O.FormaLiquidacion1,O.ContraEspecie,O.Cantidad,O.Precio1,O.TotalBrutoCli1,O.TotalIntereses,O.FechaOp,O.FechaVto,O.Cliente1,E.Nombre,E.ISIN ")
Sqladd(" From "~Dbo()~".OPERACIONES O ")
Sqladd(" LEFT JOIN "~Dbo()~".ESPECIES E ")
Sqladd(" on O.Especie=E.Codigo ")
Sqladd(" where O.NrOperacion='"~dialogo.nroperacion1~"' ")
recorrer sql

let(&marca1, ' ')
let(&marca2, ' ')
if (Eqstr(Fbn('TipoOp'), 'SEVS'))
let(&marca1, 'X')
else
let(&marca2, 'X')
endif

emitircartavisible(&pf, Copy(dialogo.string1, 1, Longitud(dialogo.string1) - 5)~'_'~dialogo.nroperacion1, direccion = &direccion, codigo_postal = &codigo_postal, localidad = &localidad, pais = &pais, CUIT() = &cuit, personas = &personas, fax = &fax, marca1 = &marca1, marca2 = &marca2, nombre = Fbn('Nombre'), isin = Fbn('ISIN'), contra_especie = Fbn('ContraEspecie'), monto = PYC(Fbn('Cantidad'), 0, 2), precio = PYC(Fbn('Precio1'), 0, 3), total_bruto_cli = PYC(Fbn('TotalBrutoCli1'), 0, 2), total_intereses = PYC(Fbn('TotalIntereses'), 0, 2), bruto_mas_intereses = PYC(Fbn('TotalBrutoCli1') + Fbn('TotalIntereses'), 0, 2), fecha_op = Fbn('FechaOp'), fecha_vto = Fbn('FechaVto'), razon_social = BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn('Cliente1')))

proximo





