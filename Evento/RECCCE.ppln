creardialogo
fecha1: 'Fec.Desde';1;1;;;;;;;FSys()
fecha2: 'Fec.Hasta';;;;;;;;;FSys()
especie1: 'Especie';;;;;;;;;
check2: 'Ej.RECPCU';;;;SI;;;;;1
check1: 'Procesa';;;;SI;;;;;1
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0 o dialogo.check2 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(1)

Act(a:fac, 'NrTrans')
Act(b:fac, 'TipoTr2')
Act(c:fac, 'Especie')
Act(d:fac, 'Especie1')
Act(e:fac, 'Especie2')
Act(f:fac, 'Fecha1')
Act(g:fac, 'Saldo 2')
Act(h:fac, 'Vehiculo')
Act(i:fac, 'Book')
Act(j:fac, 'Cant4 (Saldo)')
Act(k:fac, 'Cliente1')
Act(l:fac, 'Accion')

SetFont(a:fac..l:fac, 2)

Sqladd(" Select * from "~Dbo()~".TRANSACCIONES2 ")
Sqladd("  where Fecha1 >= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("    and Fecha1 < "~IdxDate2(dialogo.fecha2 + 1)~" ")
Sqladd("    and TipoTr2  in ('CUPON') ")
if (NoVacio(dialogo.especie1))
Sqladd("    and Especie = '"~dialogo.especie1~"' ")
endif
Sqladd(" Order By Fecha1,Especie,NrTrans")
recorrer sql
Act(a:fac, Fbn('NrTrans'))
Act(b:fac, Fbn('TipoTr2'))
Act(c:fac, Fbn('Especie'))
Act(d:fac, Fbn('Especie1'))
Act(e:fac, Fbn('Especie2'))
Acd(f:fac, Fbn('Fecha1'))

if (Fbn('Cantidad4') = 2)
Act(g:fac, 'Saldo = 2')
Act(h:fac, Fbn('Vehiculo1'))
Act(i:fac, Fbn('Ley1'))
Acn(j:fac, Fbn('Cantidad4'))
Act(k:fac, Fbn('Cliente1'))

if (dialogo.check2 = 1)
if (dialogo.check1 = 1)
Act(l:fac, 'Ejecuta RECPCU y procesa')
else
Act(l:fac, 'Ejecuta RECPCU sin procesar')
endif
Ejecutarevento('RECPCU', 'nrtrans1', Fbn('NrTrans'), 'check1', dialogo.check1)
else
Act(l:fac, 'No Ejecuta')
endif
else
Message('NO corta Posiciones Nuevas')
endif
proximo

if (Fac() > 1)
SetFont(a:2..l:fac, 1)
endif

