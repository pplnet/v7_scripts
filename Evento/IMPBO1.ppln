creardialogo
fecha1:'D.Fecha';;;;;;;;;FSys() - 7;;;;;
fecha2:'H.Fecha';;;;;;;;;FSys();;;;;
radio2: "|Impresora|Pantalla|PDF|Mail";;;;;;;;;1;;;;;
string1:'Path';;;;NO;dialogo.radio2 = 2;;;;Var('PATHPDFBOL');;;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
findialogo

if (not ok)
Cancelar()
endif


sql.add("Select O.* from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B")
sql.add("where FechaOp>='"~IdxDate(dialogo.fecha1)~"' and FechaOp<='"~IdxDate(dialogo.fecha2)~"'")
sql.add(" and O.NrOperacion=B.NrOperacion and B.NrBit in (10,70) and B.Valor = '1' ")
sql.add("and O.TipoOp in ('DDC','DDV') and (O.NrBoleto is not NULL)")
Watch(sql.batch())
Act(a0, 'Marca')
Act(c0, 'Cliente')
Act(d0, 'Operacion')
Act(e0, 'TipoOp')
Act(f0, 'FechaOp')
Act(g0, 'FechaVto')
Act(h0, 'FechaLiq')
Act(i0, 'FechaAcred')
Act(j0, 'Moneda')
Act(k0, 'Cantidad')
Act(l0, 'Tasa')
Act(m0, 'Monto')
Act(n0, 'Arancel')

Acn(b1, 3)
SetFilaActual(3)
mostrarcuadrodemensajes
recorrer sql
Message('Operacion '~Fbn('NrOperacion'))
Scn(b1, 1)
Acn(a:Val(b1), 1)
Act(c:Val(b1), Fbn('Cliente1'))
Act(d:Val(b1), Fbn('NrOperacion'))
Act(e:Val(b1), Fbn('TipoOp'))
Acd(f:Val(b1), Fbn('FechaOp'))
Acd(g:Val(b1), Fbn('FechaVto'))

Acd(h:Val(b1), Fbn('FechaOp2'))
Acd(i:Val(b1), Fbn('FechaVto2'))

Act(j:Val(b1), Fbn('Especie'))
Act(k:Val(b1), Fbn('Cantidad'))
Act(l:Val(b1), Fbn('Precio1'))
Act(m:Val(b1), Fbn('TotalBrutoCli1'))
Act(n:Val(b1), Fbn('ImpGastos1'))
proximo
ocultarcuadrodemensajes

if (Val(b1) = 3)
Messagebox('No existen operaciones para Imprimir Boleto')
else
crearlistbox;'Arial,8,';'Boletos a imprimir'
'Marca';a4..a:Val(b1);SI;;;30;check;RGB(160, 160, 193)
'Cliente';c4..c:Val(b1);NO;;;80;string;;RGB(250, 250, 193)
'Operacion';d4..d:Val(b1);NO;;;60;string;;RGB(250, 250, 193)
'TipoOp';e4..e:Val(b1);NO;;;50;string;;RGB(250, 250, 193)
'Especie';j4..j:Val(b1);NO;;;50;string;;RGB(250, 250, 193)
'Fecha Op';f4..f:Val(b1);NO;;;70;fecha;RGB(250, 250, 193)
'Fecha Vto';g4..g:Val(b1);NO;;;70;fecha;RGB(250, 250, 193)
'Fecha Liq';h4..h:Val(b1);NO;;;70;fecha;RGB(250, 250, 193)
'Fecha Acred';i4..i:Val(b1);NO;;;70;fecha;RGB(250, 250, 193)
'Cantidad';k4..k:Val(b1);NO;;;120;numero;'##,###,###.##';RGB(250, 250, 193)
'Tasa';l4..l:Val(b1);NO;;;120;numero;'#####.#####';RGB(250, 250, 193)
'Total';m4..m:Val(b1);NO;;;120;numero;'##,###,###.##';RGB(250, 250, 193)
'Arancel';n4..n:Val(b1);NO;;;120;numero;'##,###,###.##';RGB(250, 250, 193)
finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 4, Val(b1)
if (Val(a:&i) = 1)

ejecutarevento('IMPBO2', nroperacion1 = Val(d:&i), radio2 = dialogo.radio2, string1 = dialogo.string1)

endif
proximo
sql.exec
endif

