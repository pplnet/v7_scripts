creardialogo
fecha1:'Fecha';;;;;;NoVacio(dialogo.fecha1);'Debe Ingresar una Fecha';NO;Fecha('23/05/2008')
check1:'Procesa';;;;SI;SI;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)
Act(a:fac, 'Fecha:')
Act(b:fac, dialogo.fecha1)
SetFont(a:fac..b:fac, 3)

SetFilaActual(Fac() + 2)
Act(a:fac, 'Fecha')
Act(b:fac, 'Especie')
Act(c:fac, 'CallPut')
Act(d:fac, 'FechaEj')
Act(e:fac, 'PrecioEj')
Act(f:fac, 'Precio1')
Act(g:fac, 'Precio2')
Act(h:fac, 'Precio3')
Act(i:fac, 'Precio4')
Act(j:fac, 'Precio5')
Act(k:fac, 'Precio6')
Act(l:fac, 'Precio7')
Act(m:fac, 'Cotiza en')
Act(n:fac, 'Estado')
Act(o:fac, 'CotBNABCU')
Act(p:fac, 'CotBCU')

Act(r:fac, 'PreFue '~Var('MONEFUERTE'))
Act(s:fac, 'PreGru '~Var('MONEGRUPO'))
Act(t:fac, 'PreUru '~Var('MONEURU'))
Act(u:fac, 'Cant.')

Act(mu:1, Var('MONEURU'))

SetFont(a:fac..az:fac, 2)
Acn(w:1, Fac())

Sqladd(" Select C.*, E.Cotiza ")
Sqladd("   from "~Dbo()~".COTIZACIONES C, "~Dbo()~".ESPECIES E ")
Sqladd("  where C.Codigo = E.Codigo ")
Sqladd("    and C.Fecha  = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("Order by C.CallPut, C.FechaEj, C.Codigo ")
recorrer sql
Scn(x:1, 1)
Acd(a:fac, Fbn('Fecha'))
Act(b:fac, Fbn('Codigo'))
Act(c:fac, Fbn('CallPut'))
Acd(d:fac, Fbn('FechaEj'))
Acn(e:fac, Fbn('PrecioEj'))
Acn(f:fac, Fbn('Precio1'))
Acn(g:fac, Fbn('Precio2'))
Acn(h:fac, Fbn('Precio3'))
Acn(i:fac, Fbn('Precio4'))
Acn(j:fac, Fbn('Precio5'))
Acn(k:fac, Fbn('Precio6'))
Acn(l:fac, Fbn('Precio7'))
Act(m:fac, Fbn('Cotiza'))
proximo

if (Val(x:1) > 0)
recorrer&i Val(w:1) + 1, Val(x:1) + 3

Act(n:&i, 'OK')
if (DesciendeDeEspecie(Val(b:&i), 'INDICE'))
Act(n:&i, 'ERROR')
endif

if (Eqstr(Val(n:&i), 'OK'))
Acn(r:&i, CotizacionC(Val(b:&i), null, null, null, dialogo.fecha1, 1, SI, Var('MONEFUERTE')))
Acn(s:&i, CotizacionC(Val(b:&i), null, null, null, dialogo.fecha1, 1, SI, Var('MONEGRUPO')))
if (Eqstr(Val(m:&i), 'ARP'))
Acn(o:&i, cotizacionbnabcu('USD', dialogo.fecha1, 1, SI, NO))
Acn(t:&i, Val(f:&i) * cotizacionbnabcu('USD', dialogo.fecha1, 1, SI, NO))
else
Acn(p:&i, cotizacionbcu(Val(m:&i), dialogo.fecha1, 1, SI, NO))
Acn(t:&i, Val(f:&i) * cotizacionbcu(Val(m:&i), dialogo.fecha1, 1, SI, NO))
endif
endif

if (Eqstr(Val(n:&i), 'OK'))
Sqladd("Select Count(*) as Cant ")
Sqladd("  from "~Dbo()~".COTIZACIONES ")
Sqladd(" where Fecha  = '"~IdxDate(Val(a:&i))~"' ")
Sqladd("   and Codigo = '"~Val(b:&i)~"'  ")
Sqladd("   and IsNull(CallPut,'') = '"~Val(c:&i)~"' ")
Sqladd("   and IsNull(FechaEj,0)  = '"~IdxDate(Val(d:&i))~"' ")
Sqladd("   and IsNull(PrecioEj,0) = "~FStr(Val(e:&i), 1, 8)~" ")
recorrer sql
Dfa()
Acn(u:&i, Fbn('Cant'))
proximo
if (Val(u:&i) <> 1)
Act(v:&i, 'Error buscando update')
else
Act(v:&i, 'Update')
if (dialogo.check1 = 1)
if (Eqstr(Val(b:&i), Val(mu:1)))
Acn(t:&i, 1)
Acn(r:&i, Cotizacion(Val(b:&i), null, null, null, dialogo.fecha1, 1, SI))
endif
Sqladd("Update "~Dbo()~".COTIZACIONES ")
Sqladd("   Set Precio5  = "~FStr(Val(r:&i), 1, 8)~", ")
Sqladd("       Precio6  = "~FStr(Val(s:&i), 1, 8)~", ")
Sqladd("       Precio7  = "~FStr(Val(t:&i), 1, 8)~" ")
Sqladd(" where Fecha    = '"~IdxDate(Val(a:&i))~"' ")
Sqladd("   and Codigo   = '"~Val(b:&i)~"'  ")
Sqladd("   and IsNull(CallPut,'') = '"~Val(c:&i)~"' ")
Sqladd("   and IsNull(FechaEj,0)  = '"~IdxDate(Val(d:&i))~"' ")
Sqladd("   and IsNull(PrecioEj,0) = "~FStr(Val(e:&i), 1, 8)~" ")
Sqlnew()
Sqlexec()
endif
endif
endif

proximo
FormatoCeldas(e:Val(w:1) + 1..l:fac, Exe('F6'))
FormatoCeldas(o:Val(w:1) + 1..p:fac, Exe('F6'))
FormatoCeldas(r:Val(w:1) + 1..t:fac, Exe('F6'))
FormatoCeldas(u:Val(w:1) + 1..u:fac, Exe('F0'))
SetFont(a:Val(w:1) + 1..z:fac, 1)
endif

SetFont(v:1..x:1, 1)

