Sqladd("                where  S1.Especie = S.Especie  and ")
Sqladd("                S1.Cliente = S.Cliente  and ")
Sqladd("                ((S1.EnteCustodia = S.EnteCustodia) OR (S1.EnteCustodia is null AND S.EnteCustodia is null) OR(S1.EnteCustodia = '' AND S.EnteCustodia = '')) AND ")
Sqladd("                ((S1.Book = S.Book) OR (S1.Book is null AND S.Book is null) OR(S1.Book = '' AND S.Book = '')) AND ")
Sqladd("                S1.NrSaldo = S.NrSaldo  and ")
Sqladd("                Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("group by Cliente, EnteCustodia, NrSaldo, Book, Cuenta")
Sqladd("order by Cliente, EnteCustodia, NrSaldo, Book")
