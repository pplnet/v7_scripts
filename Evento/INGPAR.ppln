if (dialogo.check1 = 1)
Message('Generacion de Transporte Voucher '~Val(b:1)~'.')
Sqladd("Delete from "~Dbo()~".INSTANCIASOP ")
Sqladd("Where NrOperacion = '"~Val(b:1)~"' ")
