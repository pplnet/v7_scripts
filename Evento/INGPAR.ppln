Act(a:21, 'Mercado Falla')

Sqladd("Select * from "~Dbo()~".TRANSACCIONES2 where NrTrans = '"~dialogo.nrtrans1~"' ")
recorrer sql
Act(b:1, Fbn()['NrTrans'])
Act(b:2, Fbn()['Cliente1'])
Act(b:3, Fbn()['Especie'])
Act(b:4, Fbn()['TipoTr2'])
Acn(b:5, Fbn()['Cantidad1'])
Acn(b:9, Fbn()['CB6'])
Acn(b:10, Fbn()['CB7'])
Acn(b:11, Fbn()['CB8'])
Act(b:13, Fbn()['Mercado1'])
Sqladd("Select Concepto from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~dialogo.nrtrans1~"'")
recorrer sql
Dfa()
Act(b:14, Fbn()['Concepto'])
proximo
Act(b:15, Fbn()['Vehiculo1'])
Act(b:16, Fbn()['Cupon1'])
Act(b:17, Fbn()['Cuenta1'])
Act(b:18, Fbn()['Cuenta2'])
Acd(b:19, Fbn()['Fecha2'])
if (dialogo.radio1 = 0)
Acd(b:20, Habiles(Val(b:19), 1, 'ARG', SI))
else
Acd(b:20, Habiles(Val(b:19), 1, 'ARG', SI))
endif
if (Eqstr(Fbn('TipoTr2'), 'FXDEP'))
Acn(x1, 1)
else
Acn(x1, -1)
endif

if (dialogo.radio1 = 1)
if (Eqstr(Fbn()['TipoTr2'], 'FXDEP'))
creardialogo
cantidad2: 'Cant.Cobrada';8;1;;;;dialogo.cantidad2 > 0 y dialogo.cantidad2 < Val(b: 5);'La cantidad esta fuera del rango.';NO;
nrtrans1:'# Vocher';1;1;;NO;;;;;Fbn()['NrTrans'];
cliente1:'Cliente';;;;NO;;;;;Fbn()['Cliente1'];
especie1:'Especie';;;;NO;;;;;Fbn()['Especie'];
fecha1:'Fecha Liq';;;;NO;;;;;Fbn()['Fecha2'];
cuenta1:'Cta. Cliente';;;;NO;;;;;Fbn()['Cuenta1'];
cuenta2:'Cta. Propia';;;;NO;;;;;Fbn()['Cuenta2'];
cantidad1: 'Cant.a Cobrar';;;;NO;;;;;Fbn()['Cantidad1'];
radio1:'Cierre OCT|SI|NO';9;1;;NO;Val(y1) = 0;;;;1;
check1:'Procesa';9;2;;NO;Val(y1) = 0;;;;Val(y1);
findialogo
else
creardialogo
cantidad2: 'Cant.Pagada';8;1;;;;dialogo.cantidad2 > 0 y dialogo.cantidad2 < Val(b: 5);'La cantidad esta fuera del rango.';NO;
nrtrans1:'# Vocher';1;1;;NO;;;;;Fbn()['NrTrans'];
cliente1:'Cliente';;;;NO;;;;;Fbn()['Cliente1'];
especie1:'Especie';;;;NO;;;;;Fbn()['Especie'];
fecha1:'Fecha Liq';;;;NO;;;;;Fbn()['Fecha2'];
cuenta1:'Cta. Cliente';;;;NO;;;;;Fbn()['Cuenta1'];
cuenta2:'Cta. Propia';;;;NO;;;;;Fbn()['Cuenta2'];
cantidad1: 'Cant.a Pagar';;;;NO;;;;;Fbn()['Cantidad1'];
radio1:'Cierre OCT|SI|NO';9;1;;NO;Val(y1) = 0;;;;1;
check1:'Procesa';9;2;;NO;Val(y1) = 0;;;;Val(y1);
findialogo
endif
if (not ok)
Cancelar('Evento cancelado')
endif
Act(b:21, Fbn()['Mercado1'])
else
Act(b:21, 'BCRA')
