MostrarCuadroDeMensajes()
creardialogo
nrtrans1:'Nro.Voucher';;;;;;NoVacio(dialogo.nrtrans1) y Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'FXDEP|FXRET') y BuscarCampo('TRANSACCIONES2', 'CB10', 'NrTrans', dialogo.nrtrans1) = 1;'Tipo de Comprobante incorrecto';NO;;;;;;"TipoTr2 In ('FXDEP','FXRET') and CB10='1' and IsNull(CB3,'0')='0' and IsNull(CB9,'0')='0' and Mercado1='BCRA' and NrTrans in (Select NrOperacion from "~Dbo()~".OPERACIONESBITS where (NrBit=6 or NrBit=7) and Valor='1')"
radio1:'Cierre OCT|SI|NO';;;;NO;NO;;;;1;
cantidad2:'Cantidad Confirma OCT';;;;NO;NO;;;;0;
check1:'Procesa';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
Acn(y1, dialogo.check1)
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (dialogo.radio1 = 1 y Eqstr(BuscarCampo('TRANSACCIONES2', 'Mercado1', 'NrTrans', dialogo.nrtrans1), Var('MERCOCT')))
Cancelar('Los Vouchers OCT no Pueden Confirmarse con este Proceso')
endif
if (BuscarCampo('TRANSACCIONES2', 'CB9', 'NrTrans', dialogo.nrtrans1) = 1)
Cancelar('El Voucher '~dialogo.nrtrans1~' esta confirmado')
endif

Act(x1, Query("Select Valor from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nrtrans1~"' and NrBit = 2 "))
if (Eqstr(Val(x1), '1'))
Cancelar('El Voucher '~dialogo.nrtrans1~' esta fallado')
endif

Act(a:1, 'Nr.Voucher:')
Act(a:2, 'Cliente:')
Act(a:3, 'Especie:')
Act(a:4, 'Tipo:')
