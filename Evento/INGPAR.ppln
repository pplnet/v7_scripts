Sqladd(" NrMov, NrLiq, Status, -1, '"~IdxDate(FSys())~"', ")
Sqladd(" '"~UsuarioActivo()~"', Cuenta, Transaccion, "~FStr(-Val(b:8), 1, 2)~", Cupon")
Sqladd("  from "~Dbo()~".MOVEJECUTADOS ")
