Sqladd("'"~UsuarioActivo()~"', ")
Sqladd("'Generacion de Falla Parcial', ")
Sqladd(""~SQLFechaStr(Fecha(FSys())~' '~Hora(Ahora()))~"")
Sqladd(")")
Sqlnew()

Act(b:12, getnumerador(13))
Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2 ")
Sqladd("   SET Fecha3      = '"~IdxDate(FSys())~"', ")
Sqladd("       NrTransRef1 = '"~Val(b:12)~"', ")
Sqladd("       Cantidad3   = "~FStr(Val(b:8), 1, 2)~", ")
Sqladd("       Cantidad4   = "~FStr(Val(b:6), 1, 2)~", ")
Sqladd("       CB3         = '1'")
Sqladd(" Where NrTrans = '"~Val(b:1)~"' ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
