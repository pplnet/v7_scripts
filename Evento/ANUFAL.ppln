creardialogo
nrtrans1: 'Nro.Voucher';;;;;;Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'FXDEP|FXRET|FXCOMP');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('FXDEP','FXRET','FXCOMP') AND Fecha1 = '"~IdxDate(FSys())~"' and CB3 = '1' ";
radio1:'Cierre OCT';;;;NO;NO;;;;1;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 1 y Eqstr(BuscarCampo('TRANSACCIONES2', 'Mercado1', 'NrTrans', dialogo.nrtrans1), Var('MERCOCT')))
Cancelar('Las Fallas OCT no Pueden Anularse con este Proceso')
endif
if (BuscarCampo('TRANSACCIONES2', 'CB9', 'NrTrans', dialogo.nrtrans1) = 1)
Cancelar('El Voucher '~dialogo.nrtrans1~' esta confirmado')
endif

Act(mo:1, Var('MERCOCT'))

Sqladd("Select T.NrTrans, T.NrTransRef1, T.Mercado1, T.CB9, T.TipoTr2 ")
Sqladd("from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
Sqladd("where T.NrTrans = B.NrOperacion ")
Sqladd("and T.NrTrans = '"~dialogo.nrtrans1~"' ")
Sqladd("and (")
Sqladd("(B.NrBit = 2 and B.Valor = '1' and (T.CB9 = '0' or T.CB9 is NULL) and T.Mercado1!='CE' and T.Mercado1!='EU' and T.Mercado1!='CRYL' and T.Mercado1!='ARGEN' )")
Sqladd("or ( (B.NrBit = 7 or B.NrBit = 6) and B.Valor = '1' and T.CB3 = '1' and T.Mercado1 in ('CE','EU','CRYL','ARGEN','"~Val(mo:1)~"'))")
Sqladd(")")

recorrer sql
Act(a:fac, Fbn()['NrTrans'])
Act(b:fac, Fbn()['NrTransRef1'])
Act(c:fac, Fbn()['Mercado1'])
Act(d:fac, Fbn()['TipoTr2'])

if (Query("Select Count(*) from "~Dbo()~".MOVPENDIENTES where NrOperacion = '"~Val(b:fac)~"' and NrSaldo = 1 ") = 0)
Cancelar('El Voucher de Transporte '~Val(b:fac)~' ya esta liquidado')
endif

Sqladd("DELETE from "~Dbo()~".INSTANCIASOP where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVPENDIENTES where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVLIMITES where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".MOVCASHFLOW where NrOperacion = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("DELETE from "~Dbo()~".TRANSACCIONES2 where NrTrans = '"~Val(b:fac)~"'")
Sqlnew()

Sqladd("Delete from "~Dbo()~".INSTANCIASOP ")
Sqladd("Where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and (NrInstancia = 7 or NrInstancia = 6 )")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2 ")
Sqladd("SET Fecha3 = NULL, ")
Sqladd("NrTransRef1 = NUll, ")
Sqladd("Cantidad3 = NUll, ")
Sqladd("Cantidad4 = NUll, ")
Sqladd("CB3 = NULL ")
Sqladd("Where NrTrans = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '0' ")
Sqladd("where NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd("and NrBit = 2 ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '1' ")
Sqladd("where NrOperacion = '"~dialogo.nrtrans1~"' ")
if (Eqstr(Val(d:fac), 'FXDEP'))
Sqladd("and NrBit = 7 ")
else
Sqladd("and NrBit = 6 ")
endif
Sqlnew()
Sqlexec()
proximo
if (Fac() = 0)
Cancelar('El Voucher '~dialogo.nrtrans1~' no se puede desfallar.')
endif

