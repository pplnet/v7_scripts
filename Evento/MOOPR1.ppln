creardialogo
nroperacion1:'Nro. Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Debe ingresar un numero de Op.';NO

findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (Incluido(BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1), Var('VLIQUIDA')~Var('VLIQUIDA2')))
Cancelar('Las operaciones del Vehiculo '~BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1)~' no se modifican con este evento')
endif

Act(z7, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1))

if (Incluido(Copy(Val(z7), 1, 2), 'SE|FX'))
Cancelar("Las operaciones del Tipo "~Val(z7)~" no se modifican por evento")
endif

if (Incluido(Val(z7), 'DTSFV|DTSFF|DTSVV'))
Cancelar("Las operaciones del Tipo "~Val(z7)~" no se modifican por evento")
endif

Acn(z9, Query("Select count(*) from "~Dbo()~".MOVPENDIENTES where NrOperacion = '"~dialogo.nroperacion1~"' and NrSaldo = 1"))



Acn(z1, Query("Select count(*) from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
if (Val(z1) = 0)
Cancelar('La Operacion no existe')
else
if (not Eqstr(BuscarCampo('OPERACIONES', 'Operador', 'NrOperacion', dialogo.nroperacion1), UsuarioActivo()) y not Incluido(UsuarioActivo(), Var('ULMODI')))
Cancelar('El usuario no esta autorizado a modificar la operacion')
endif
Acn(z2, Query("Select count(*) from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~dialogo.nroperacion1~"' and NrSaldo = 1"))
if (Val(z2) = 0)
Cancelar('La operacion no tiene liquidaciones')
else
Acn(z3, Query("Select count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and NrBit in (8,9,20,50) and Valor = '1'"))
if (Val(z3) = 0)
Cancelar('La operacion no esta en BackOffice ni en Terminal')
else
modificaroperacion(dialogo.nroperacion1, 1, NO)

if (ok)
Acn(z4, Query("Select RB3 from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
Sqladd("Update "~Dbo()~".OPERACIONES set Impresa='1' where NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()
Sqladd(" Select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and Valor = '1' ")
recorrer sql
Dfa()
if (Fbn('NrBit') = 50)
if (Query(" Select Count(*) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~dialogo.nroperacion1~"' ") = 1)
Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 50, 'nroperacion1', dialogo.nroperacion1)
endif
endif
proximo
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit in (8,9,20,50)")
Sqlnew()
if (Val(z4) > 0)
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=11")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=13")
endif
Sqlnew()

Sqladd(" Insert into "~Dbo()~".EXCEPCIONES ")
Sqladd(" (NrOperacion, Fecha, Tipo, Descripcion) Values ")
Sqladd(" ('"~dialogo.nroperacion1~"', '"~IdxDate(FSys())~"','MODEVENTO','"~BuscarCampo('EVENTOS', 'Nombre', 'Codigo', codigoinforme)~" "~Hora(Ahora())~"') ")
Sqlnew()
Sqlexec()
endif
endif
endif
endif

