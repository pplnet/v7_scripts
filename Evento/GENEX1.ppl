  endif      
proximo

if Dialogo.Check1=0 y FAC>0
  FormatoCeldas(t:15..t:15,Exe('F2'))
  FormatoCeldas(t:16..t:16,Exe('F8'))
  FormatoCeldas(t:23..t:25,Exe('F0'))
  FormatoCeldas(t:41..t:42,Exe('F0'))
  FormatoCeldas(t:44..t:44,Exe('F0'))

  FormatoCeldas(ca:15..(78+FAC):15,Exe('F2'))
  FormatoCeldas(ca:16..(78+FAC):16,Exe('F8'))
  FormatoCeldas(ca:23..(78+FAC):25,Exe('F0'))
  FormatoCeldas(ca:41..(78+FAC):42,Exe('F0'))
  FormatoCeldas(ca:44..(78+FAC):44,Exe('F0'))
  ACO(1, 10)
  ACO(5, 20)
  ACO(19,15)
  ACO(20,12)
  ACO(78,15)
