****** verificar mercados liquidacion EU EU idem TCI/TIV

** Especie BBG Codigo2 Char(10)
** Especie ISO ISO Char(5)
** Cliente Coper busco en CLIENTESDOCUMENTACION

(.'CONECTASIS'.)

*** Lee de la tabla OPEXTERNAS correspondiete al sistema indicado en la variable SISEXT1
CrearDialogo
  Fecha1: 'Fecha'  ;1;1; ;  ;  ;;;;Fecha(Ahora)
* FJL 10/07/19 - Para hacer pruebas usar la segunda linea
*  Check1: 'Procesa';1;2; ;NO;NO;;;;1;
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(w:1, VAR('SISEXT1'))
ACT(w:2, VAR('CONTROLAPM'))
* FJL 17/07/19 - El plazo maximo se lee de la variable
ACN(w:3, VAR('PLAMAXSESS'))

ACT(s:1, 'ID SE')
ACT(s:2, 'Cod SE')
ACT(s:3, 'Nr SE')
ACT(s:4, 'TipoOp SE')
ACT(s:5, 'TipoOp')
ACT(s:6, 'T.Esp. SE')
ACT(s:7, 'Especie SE')
ACT(s:8, 'Especie FPA')
ACT(s:9, 'Especie OK')
ACT(s:10, '10-Esp Valida')
ACT(s:11, 'T.Cli. SE')
ACT(s:12, 'Cli. SE')
ACT(s:13, 'Cliente')
ACT(s:14, 'Cliente OK')
ACT(s:15, 'Cantidad')
ACT(s:16, 'Precio SE')
ACT(s:17, 'T.CEsp. SE')
ACT(s:18, 'CEsp. SE')
ACT(s:19, 'CEsp. FPA')
ACT(s:20, '20-ContraEspecie OK')
ACT(s:21, 'FechaOp SE')
ACT(s:22, 'FechaOp')
ACT(s:23, 'Plazo SE')
ACT(s:24, 'Plazo')
ACT(s:25, 'RB5')
ACT(s:26, 'Operador SE')
ACT(s:27, 'Operador')
ACT(s:28, 'Book SE')
ACT(s:29, 'Book')
ACT(s:30, '30-Vehiculo')
ACT(s:31, 'Feriados')
ACT(s:32, 'FechaVto')
ACT(s:35, 'TipoABM')

ACT(s:40, '40-A Compliance')
ACT(s:41, 'Ops.= NrSE')
ACT(s:42, 'Ops.= IDSE')
ACT(s:43, 'Op.Anterior')
ACT(s:44, 'Mensaje Error')
ACT(s:45, 'Op Generada')
ACT(s:46, 'Con Error')
ACT(s:47, 'Nuevo Estado')
ACT(s:48, 'Excepciones')
ACT(s:49, 'Cant.Ops')
ACT(s:50, '50-Instacia')
ACT(s:51, 'En 68 ?')

** FJL 17/01/25 - Issue 7845 - Como no ponia AfectaLS fallaba el control de limites por Controlante
ACT(s:60, 'AfectaLS')

ACT(s:70, 'T-Bills')
ACT(s:71, 'No MAE')
ACT(s:72, 'Mer.Liq')
ACT(s:73, 'Mer.LIq.Cli')

if Dialogo.Check1=0
  recorrer&i 1,73
    ACT(bz:&i, Val(s:&i))
  proximo
endif

SQL.ADD("Select * from "~DBO~".OPEXTERNAS ")
SQL.ADD("  where CodSisExterno = Upper('"~Val(w:1)~"')  ")
SQL.ADD("    and FechaCarga    >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("    and FechaCarga    < '"~IdxDate(Dialogo.Fecha1+1)~"'  ")
SQL.ADD("    and IsNull(Estado,'ING') in ('ING','PEN')        ")
*SQL.ADD("    and IDSisExterno = 26 ")
SQL.ADD("order by IDSisExterno ")
*watch(SQL.BATCH())
Recorrer SQL
  ACN(a:FAC, fbn('IDSisExterno'))
  BorrarCeldas(t:1..u:75)
  BorrarCeldas(v:1..v:5)
  BorrarCeldas(e:1..f:20)
  * Errores
  ACN(z:1,0)
  ACT(t:35, fbn('TipoABM'))
  * A Compliance
  ACT(t:40, 'NO')
  ***** IDSisExterno
  ACN(t:1, fbn('IDSisExterno'))
  ***** SisExterno
  ACT(t:2, fbn('CodSisExterno'))
  ***** NrExterno
  ACT(t:3, fbn('NrExterno'))
  if Incluido(FBN['TipoAbm'],'A|')
      ***** TipoOp
      ACT(t:4, fbn('TipoOp'))
      if EqStr(fbn('TipoOp'),'TC')
        ACT(t:5,'TIC')
      endif
      if EqStr(fbn('TipoOp'),'TV')
        ACT(t:5,'TIV')
      endif
      if Vacio(Val(t:5))
        SCN(z:1,1)
        ACN((26+FAC):5, 1)
      endif

      ***** TipoEspecie
      ACT(t:6, fbn('TipoEspecie'))
      ***** Especie
      ACT(t:7, fbn('Especie'))
      if EqStr(Val(t:6),'ISIN')
        ACT(t:8, BuscarCampo('ESPECIES','Codigo','ISIN',Val(t:7)))
      endif
      if EqStr(Val(t:6),'BBG')
        ACT(t:8, BuscarCampo('ESPECIES','Codigo','Codigo2',Val(t:7)))
      endif
      if Vacio(Val(t:8))
        ACT(t:9, 'Error')
        * A compliance
        ACT(t:40, 'SI')
      else
        ACT(t:9, 'OK')
        ACT(t:10, BuscarCampo('ESPECIES','EstadoOperativo','Codigo',Val(t:8)))
        if Vacio(Val(t:10))
          ACT(t:10, 'NE')
        endif
      endif
      
      ***** TipoCliente
      ACT(t:11, fbn('TipoCliente'))
      ***** Especie
      ACT(t:12, fbn('Cliente'))
      if EqStr(Val(t:11),'COPER')
    ******************************
    * Fata definir TipoCliente - Por Ahora busca por codigo
    ******************************* 
    *    ACT(t:13, BuscarCampo('CLIENTES','Codigo','Codigo',Val(t:12)))
        ACT(t:13, BuscarCampo('CLIENTESDOCUMENTACION','Codigo','NrCOPERS',Val(t:12)))
      endif
      if Vacio(Val(t:13))
        ACT(t:14, 'Error')
        * A compliance
        ACT(t:40, 'SI')
      else
        ACT(t:14, 'OK')
      endif

      ***** Cantidad SE
      ACN(t:15, fbn('Cantidad'))
      if Val(t:15)<=0
        SCN(z:1,1)
        ACN((26+FAC):15, 1)
      endif
      ***** Precio SE
      ACN(t:16, fbn('Precio'))
      if Val(t:16)<=0
        SCN(z:1,1)
        ACN((26+FAC):16, 1)
      endif
      
      ***** TipoContraEspecie
      ACT(t:17, fbn('TipoContraEspecie'))
      ***** ContraEspecie
      ACT(t:18, fbn('ContraEspecie'))
      if EqStr(Val(t:17),'ISO')
        ACT(t:19, BuscarCampo('ESPECIES','Codigo','ISO',Val(t:18)))
      endif
      if Vacio(Val(t:19))
        ACT(t:20, 'Error')
        * A compliance
        ACT(t:40, 'SI')
      else
        ACT(t:20, 'OK')
      endif

      ***** FechaOp SE
      ACD(t:21, fbn('FechaOp'))
      ***** Fecha Op
      ACD(t:22, fbn('FechaOp'))

      ** FJL 12/07/19 - Cambio criterio para no rechazar operaciones
    *FechaOp <= FSys
    * y 
    *[[FinDeMes(FECHAOP)<>FinDeMes(FSys) y FECHAOP>= Habiles(FSys,-Var('FVALORMAX'),'ARG')] o [FinDeMes(FECHAOP)=FinDeMes(FSys)]]
    * y 
    * EsHabil(FECHAOP,'ARG')  
      if Val(t:22)>FSys
        * A compliance
        ACT(t:40, 'SI')
        ACN(u:22, 1)
        ACN(v:1, 1)
      endif  
      if FinDeMes(Val(t:22))<>FinDeMes(FSys)
        if Val(t:22)< Habiles(FSys,-Var('FVALORMAX'),'ARG')
          * A compliance
          ACT(t:40, 'SI')
          ACN(u:22, 1)
          ACN(v:2, 1)
        endif  
      endif  
      if Not EsHabil(Val(t:22),'ARG')
        * A compliance
        ACT(t:40, 'SI')
        ACN(u:22, 1)
        ACN(v:3, 1)
      endif  

      ***** Plazo SE
      ACN(t:23, fbn('Plazo'))
      ***** Plazo
      ACN(t:24, Num(fbn('Plazo'))*24)
      ***** RB5
      ACT(t:25, FStr(fbn('Plazo'),1,0))
    * FJL 17/07/19 - El plazo maximo se lee de la variable
    *  if fbn('Plazo')<0 o fbn('Plazo')>3
      if fbn('Plazo')<0 o fbn('Plazo')>Val(w:3)
    ** FJL 12/07/19 - Cambio criterio para no rechazar operaciones
    *    SCN(z:1,1)
        ACN((26+FAC):25, 1)
        * A compliance
        ACT(t:40, 'SI')
        ACN(u:25, 1)
      endif
      ***** Feriados
      ACT(t:31, 'ARG')
      ***** FechaVto
      ACD(t:32, Habiles(Val(t:22),fbn('Plazo'),Val(t:31)))
      **** Mercado
      ** verificar si especie T-Bill Tipo='TBL' incorporar mercado EXT
      ACT(t:70,BuscarCampo('ESPECIES','Tipo','Codigo',Val(t:8)))
      if EqStr(val(t:70),'TBL')
         ACN(t:71,1)
      endif
      if EqStr(val(t:70),'TBL')
         *Negociacion Mercado4
         ACT(t:72, Var('MERCADOTBL'))
         *Liquidacion Mercado
         **ACT(t:33, BuscarCampo('ESPECIES','MercadoDef','Codigo',Val(t:8)))
         ACT(t:33, BuscarCampo('MERCADOS','Codigo','CodigoExterno1',fbn['Mercado']))
         *Liquidacion Cli Mercado2
         **ACT(t:73, BuscarCampo('ESPECIES','MercadoCli','Codigo',Val(t:8)))
         ACT(t:73, BuscarCampo('MERCADOS','Codigo','CodigoExterno1',fbn['Mercado']))
      else
         ACT(t:33, BuscarCampo('MERCADOS','Codigo','CodigoExterno1',fbn['Mercado']))
      endif

      ***** Operador SE
      ACT(t:26, fbn('Operador'))
      ***** Operador FPA (Usuario)
    ** FJL 12/07/19 - Cambio criterio para no rechazar operaciones
      if Vacio(Val(t:26))
        * A compliance
        ACT(t:40, 'SI')
        ACN(u:26, 1)
      else
        ACT(t:27, BuscarCampo('USUARIOS','Codigo','Codigo',fbn('Operador')))
        if Vacio(Val(t:27))
          * A compliance
          ACT(t:40, 'SI')
          ACN(u:27, 1)
        endif
      endif

      ***** Book SE
      ** verificar si especie T-Bill Tipo='TBL' --> Variable BOOKTBILLS
      if EqStr(val(t:70),'TBL')
         ACT(t:28, Var('BOOKTBILLS'))
      else      
         ACT(t:28, fbn('Book'))
      endif   
      ***** Book FPA
    ** FJL 12/07/19 - Cambio criterio para no rechazar operaciones
      if Vacio(Val(t:28))
        * A compliance
        ACT(t:40, 'SI')
        ACN(u:28, 1)
      else
        ACT(t:29, BuscarCampo('BOOKS','Codigo','Codigo',fbn('Book')))
        if Vacio(Val(t:29))
          * A compliance
          ACT(t:40, 'SI')
          ACN(u:29, 1)
        endif
      endif

      ***** Vehiculo1
      ACT(t:30, Var('VEHICULODE'))

** FJL 17/01/25 - Issue 7845 - Como no ponia AfectaLS fallaba el control de limites por Controlante
      ***** AfectaLS
      ACT(t:60, 'Limites')
     **********************
    * Control duplicadas
    **********************
    *    if Vacio(Val(t:8))
    *      ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where IDSisExterno = "~FStr(fbn('IDSisExterno'),1,0)~" and NrExterno = '"~fbn('NrExterno')~"' and TipoOp='"~Val(t:5)~"' and FechaOp='"~IdxDate(Val(t:22))~"' and CB2='1' and Especie='"~Val(t:8)~"' and Cliente1='"~Val(t:13)~"' "))
    *    endif
    * Controla por Sistema, ID y NrExterno
        ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where CodSisExterno = '"~fbn('CodSisExterno')~"' and NrExterno = '"~fbn('NrExterno')~"' "))
    *    ACN(t:42, SQL("Select 1 from "~DBO~".OPERACIONES where CodSisExterno = '"~fbn('CodSisExterno')~"' and IDSisExterno = "~FStr(fbn('IDSisExterno'),1,0)~" "))
    ** FJL 12/07/19 - Se saco control en BOPERACIONES - PZ
        * En BOControla solo por Sistema, ID y NrExterno
    *    ACN(t:42, SQL("Select 1 from "~DBO~".BOPERACIONES where CodSisExterno = '"~fbn('CodSisExterno')~"' and IDSisExterno = "~FStr(fbn('IDSisExterno'),1,0)~" and NrExterno = '"~fbn('NrExterno')~"' "))
        if Val(t:41)+Val(t:42) > 0
          SCN(z:1,1)
        endif

    ******************************************************
        
        ACN(t:46, Val(z:1))
        if Val(z:1)=0
          * No se detecto ningun error
          ACT(b:FAC, 'OK')
          ACT(t:47, 'GEN')
          if Dialogo.Check1=1
            ACT(t:45, GetNumerador(1))
            * NrOperacion
            ACT(d:FAC, Val(t:45))
            * A Compliance
            ACT(d:FAC, Val(t:40))
            Message('--- #Op : '~Val(t:45)~' Tipo : '~Val(t:5)~' Especie : '~Val(t:8)~' Cliente : '~Val(t:13))

            SQL.ADD("Insert into "~DBO~".OPERACIONES (")
              
            SQL.ADD("NrOperacion, ")
            SQL.ADD("TipoOp, ")
            SQL.ADD("Especie, ")
            SQL.ADD("Cliente1, ")
            SQL.ADD("Cantidad, ")

            SQL.ADD("ContraEspecie, ")
            SQL.ADD("Precio1, ")
            SQL.ADD("FechaOp, ")
            SQL.ADD("Plazo, ")
            SQL.ADD("RB5, ")
            SQL.ADD("RB6, ")

            SQL.ADD("TablaFeriados1, ")
            SQL.ADD("FechaVto, ")
            SQL.ADD("Operador, ")
            SQL.ADD("Vehiculo1, ")
            SQL.ADD("Book1, ")
            SQL.ADD("Mercado, ")

            SQL.ADD("PaseCB, ")
            SQL.ADD("CB2, ")
            if EqStr(val(t:70),'TBL')
               SQL.ADD("CB7, ")
               SQL.ADD("Mercado4, ")
               SQL.ADD("Mercado2, ")
               SQL.ADD("EsTBills, ")
            endif
            SQL.ADD("IDSisExterno, ")
            SQL.ADD("CodSisExterno, ")
            SQL.ADD("NrExterno, ")
** FJL 17/01/25 - Issue 7845 - Como no ponia AfectaLS fallaba el control de limites por Controlante
            SQL.ADD("AfectaLS, ")

            SQL.ADD("FechaCarga, ")
            SQL.ADD("FechaCargaSys, ")
            SQL.ADD("UsrInput, ")
            SQL.ADD("Direccion, ")
            SQL.ADD("Numerador ")

            SQL.ADD(") values ( ")
              
            * NrOperacion
            SQL.ADD(" '"~Val(t:45)~"', ")
            * TipoOp
            SQL.ADD(" '"~Val(t:5)~"', ")
            * Especie
            SQL.ADD(" '"~Val(t:8)~"', ")
            * Cliente1
            SQL.ADD(" '"~Val(t:13)~"', ")
            * Cantidad
            SQL.ADD(" "~FStr(Val(t:15),0,2)~", ")

            * ContraEspecie
            SQL.ADD(" '"~Val(t:19)~"', ")
            * Precio1
            SQL.ADD(" "~FStr(Val(t:16),0,8)~", ")
            * FechaOp
            SQL.ADD(" '"~IdxDate(Val(t:22))~"', ")
            * Plazo (N)
            SQL.ADD(" "~FStr(Val(t:24),1,0)~", ")
            * RB5 (N)
            SQL.ADD(" '"~Val(t:25)~"', ")
            * RB6 Fuente=2=Raiden
            SQL.ADD(" '2', ")

            * TablaFeriados1
            SQL.ADD(" '"~Val(t:31)~"', ")
            * FechaVto
            SQL.ADD(" '"~IdxDate(Val(t:32))~"', ")
            * Operador
            SQL.ADD(" '"~Val(t:27)~"', ")
            * Vehiculo1
            SQL.ADD(" '"~Val(t:30)~"', ")
            * Book1
            SQL.ADD(" '"~Val(t:29)~"', ")
            * Mercado
            SQL.ADD(" '"~Val(t:33)~"', ")

            * PaseCB
            SQL.ADD(" '0', ")
            * CB2 (Externa)
            SQL.ADD(" '1', ")
            * CB7 No MAE
            if EqStr(val(t:70),'TBL')
               SQL.ADD(" 1, ")
               SQL.ADD(" '"~Val(t:72)~"', ")
               SQL.ADD(" '"~Val(t:73)~"', ")
               SQL.ADD(" 'SI', ")
            endif
            * IDSisExterno
            SQL.ADD(" "~FStr(Val(t:1),1,0)~", ")
            * CodSisExterno
            SQL.ADD(" '"~Val(t:2)~"', ")
            * NrSisExterno
            SQL.ADD(" '"~Val(t:3)~"', ")
** FJL 17/01/25 - Issue 7845 - Como no ponia AfectaLS fallaba el control de limites por Controlante
            * AfectaLS
            SQL.ADD(" '"~Val(t:60)~"', ")

            * FechaCarga
            SQL.ADD(" "~SQLAhora~", ")
            * FechaCargaSys
            SQL.ADD(" "~IdxDate2(FSys)~", ")
            * UsrInput
            SQL.ADD(" '"~Val(t:27)~"', ")
            * Direccion
            SQL.ADD(" 2,")
            * Numerador
            SQL.ADD(" 1 ")

            SQL.ADD(" ) ")
            SQL.NEW

            SQL.ADD("Update "~DBO~".OPEXTERNAS ")
            SQL.ADD("   Set Estado       = 'GEN',")
            SQL.ADD("       NrOperacion  = '"~Val(t:45)~"' ")
            SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
            SQL.NEW
            SQL.EXEC
          endif

          If EqStr(Val(t:40),'SI')
            * Va a Compliance
            Message('Modificar Operacion '~Val(t:45)~' - Sin Movimientos')
            if Dialogo.Check1=1
               ModificarOperacion(Val(t:45),0,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
            endif
            Message('Operacion '~Val(t:45)~' Ok. Pasa a Instancia 9')
            if Dialogo.Check1=1
              EjecutarEvento('CBOINS', String1=Val(t:45), Radio1=0, Radio2=0, Entero1=1, Entero2=9)
            endif

    * FJL 12/07/19 - Generacion de Excepciones
            if EqStr(Val(t:9),'Error')
              ACT(e:1, 'Error Especie. El codigo '~Val(t:6)~' '~Val(t:7)~' no existe en FPA.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if EqStr(Val(t:14),'Error')
              ACT(e:1, 'Error Cliente. El codigo '~Val(t:11)~' '~Val(t:12)~' no existe en FPA.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if EqStr(Val(t:20),'Error')
              ACT(e:1, 'Error Contraespecie. El codigo '~Val(t:17)~' '~Val(t:18)~' no existe en FPA.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif

            if Val(u:22)=1
              * error en Fecha
              if Val(v:1)=1
                ACT(e:1, 'FechaOp ('~Fecha(Val(t:22))~') mayor que FSys.')
                SCN(t:48, 1)
                ACT(f:Val(t:48), Val(e:1))
                if Dialogo.Check1=1
                  SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                  SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                  SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                  SQL.NEW
                endif
              endif
              if Val(v:2)=1
                ACT(e:1, 'FechaOp ('~Fecha(Val(t:22))~') supera maximo de Fecha Valor.')
                SCN(t:48, 1)
                ACT(f:Val(t:48), Val(e:1))
                if Dialogo.Check1=1
                  SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                  SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                  SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                  SQL.NEW
                endif
              endif
              if Val(v:3)=1
                ACT(e:1, 'FechaOp ('~Fecha(Val(t:22))~') no es habil en la tabla feriados '~Val(t:31)~'.')
                SCN(t:48, 1)
                ACT(f:Val(t:48), Val(e:1))
                if Dialogo.Check1=1
                  SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                  SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                  SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                  SQL.NEW
                endif
              endif
            endif
            if Val(u:25)=1
    * FJL 17/07/19 - El plazo maximo se lee de la variable
    *          ACT(e:1, 'Plazo invalido.')
              ACT(e:1, 'Plazo '~Val(t:25)~' invalido. Rango de 0 a '~FStr(Val(w:3),1,0))
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if Val(u:26)=1
              ACT(e:1, 'Operador no informado.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if Val(u:27)=1
              ACT(e:1, 'Operador '~Val(t:26)~' no existe en FPA.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if Val(u:28)=1
              ACT(e:1, 'Book no informado.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif
            if Val(u:29)=1
              ACT(e:1, 'Book '~Val(t:28)~' no existe en FPA.')
              SCN(t:48, 1)
              ACT(f:Val(t:48), Val(e:1))
              if Dialogo.Check1=1
                SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
                SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
                SQL.ADD(" ('"~Val(t:45)~"', 'ERRORSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
                SQL.NEW
              endif
            endif

            if Dialogo.Check1=1
              SQL.EXEC                   
            endif
          else
            * Va a Carga Trader
            Message('Modificar Operacion '~Val(t:45))
            if Dialogo.Check1=1
               ModificarOperacion(Val(t:45),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
               IF Ok
                  ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
                  SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 0 where NrOperacion = '"~Val(t:45)~"' ")
                  SQL.NEW
                  SQL.EXEC                   
               Endif
            Endif

            Message('Fin Modificar Operacion')
          endif
        else
          * Tuve error que no genera operacion
          if Val(t:41)+Val(t:42) > 0
            * Duplicada
            if Val(t:41)=1
              ACN((26+FAC):41, 1)
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where CodSisExterno = '"~fbn('CodSisExterno')~"' and NrExterno = '"~fbn('NrExterno')~"' "))
              ACT(t:44, 'NrExterno '~Val(t:3)~' duplicado para el sistema '~Val(t:2)~' - OP.'~Val(t:43))
            else
              ACN((26+FAC):42, 1)
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where CodSisExterno = '"~fbn('CodSisExterno')~"' and IDSisExterno = "~FStr(fbn('IDSisExterno'),1,0)~" "))
              ACT(t:44, 'IDSisExterno '~FStr(Val(t:1),1,0)~' duplicado para el sistema '~Val(t:2)~' - OP.'~Val(t:43))
            endif
            ACT(t:47, 'DUP')
          else
            * Otro tipo error
            if Val((26+FAC):5)=1
              ACT(t:44, 'Tipo operacion '~Val(t:4)~' invalido.')
            else
              if Val((26+FAC):15)=1
                ACT(t:44, 'Cantidad cero o negativa.')
              else
                if Val((26+FAC):16)=1
                  ACT(t:44, 'Precio cero o negativo.')
                else
                  ACT(t:44, 'Error no contemplado')
                endif
              endif
            endif
            ACT(t:47, 'ERR')
          endif
          if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".OPEXTERNAS ")
            SQL.ADD("   Set Estado       = '"~Val(t:47)~"', ")
            SQL.ADD("       Warning      = '"~Val(t:44)~"' ")
            SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
            SQL.NEW
            SQL.EXEC
          endif
        endif
        ACT(c:FAC, Val(t:47))
        ACT(d:FAC, Val(t:40))
        if Dialogo.Check1=0
          ACN((78+FAC):1,  Val(t:1))
          ACT((78+FAC):2,  Val(t:2))
          ACT((78+FAC):3,  Val(t:3))
          ACT((78+FAC):4,  Val(t:4))
          ACT((78+FAC):5,  Val(t:5))
          ACT((78+FAC):6,  Val(t:6))
          ACT((78+FAC):7,  Val(t:7))
          ACT((78+FAC):8,  Val(t:8))
          ACT((78+FAC):9,  Val(t:9))
          ACT((78+FAC):10, Val(t:10))
          ACT((78+FAC):11, Val(t:11))
          ACT((78+FAC):12, Val(t:12))
          ACT((78+FAC):13, Val(t:13))
          ACT((78+FAC):14, Val(t:14))
          ACN((78+FAC):15, Val(t:15))
          ACN((78+FAC):16, Val(t:16))
          ACT((78+FAC):17, Val(t:17))
          ACT((78+FAC):18, Val(t:18))
          ACT((78+FAC):19, Val(t:19))
          ACT((78+FAC):20, Val(t:20))
          ACD((78+FAC):21, Val(t:21))
          ACD((78+FAC):22, Val(t:22))
          ACN((78+FAC):23, Val(t:23))
          ACN((78+FAC):24, Val(t:24))
          ACT((78+FAC):25, Val(t:25))
          ACT((78+FAC):26, Val(t:26))
          ACT((78+FAC):27, Val(t:27))
          ACT((78+FAC):28, Val(t:28))
          ACT((78+FAC):29, Val(t:29))
          ACT((78+FAC):30, Val(t:30))
          ACT((78+FAC):31, Val(t:31))
          ACD((78+FAC):32, Val(t:32))

          ACT((78+FAC):40, Val(t:40))
          ACN((78+FAC):41, Val(t:41))
          ACN((78+FAC):42, Val(t:42))
          ACT((78+FAC):43, Val(t:43))
          ACT((78+FAC):44, Val(t:44))
          ACT((78+FAC):45, Val(t:45))
          ACN((78+FAC):46, Val(t:46))
          ACT((78+FAC):47, Val(t:47))
          ACN((78+FAC):48, Val(t:48))

          ACT((78+FAC):60, Val(t:60))
          ACT((78+FAC):70, Val(t:70))
          ACN((78+FAC):71, Val(t:71))
          ACT((78+FAC):72, Val(t:72))
          ACT((78+FAC):73, Val(t:73))
          ACO((78+FAC),12)

        endif
  endif
  if Incluido(FBN['TipoAbm'],'B|')
         * Baja
         ***** NrExterno
         ACT(t:3, fbn('NrExterno'))
         * Validaciones
         ACT(t:45, SQL("SELECT NrOperacion FROM "~DBO~".OPERACIONES WHERE NrExterno='"~fbn('NrExterno')~"' "))
         if Vacio(val(t:45))
            SCN(z:1,1)
            ACN((26+FAC):45, 1)
            ACT((27+FAC):45, DealCancelResp(NO, fbn('NrExterno'), 'NA', 'ERRORSISEX: Operacion no encontrada|'))
* FJL 19/12/19 - Se cambia por modificacion respuesta NOK
*            if Eqstr(Val((27+FAC):45),'OK')
            if EqStr(Copy(Val((27+FAC):45),1,2),'OK')
               * 'Operacion no encontrada'
               SQL.ADD("Update "~DBO~".OPEXTERNAS ")
               SQL.ADD("   Set Estado       = 'REC', ")
               SQL.ADD("       Warning      = 'Operacion no encontrada' ")
               SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
               SQL.NEW
               SQL.EXEC
            endif
         else   
* FJL 27/11/19 - Se agrega numero de saldo por operaciones con corredores
*            ACN(t:49, SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~val(t:45)~"' "))
           ACN(t:49, SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~val(t:45)~"' and NrSaldo=1 "))
           if val(t:49)=1
             SCN(z:1,1)
             ACN((26+FAC):49, 1)
             ACT((27+FAC):49, DealCancelResp(NO, fbn('NrExterno'), val(t:45), 'ERRORSISEX: Operacion liquidada|'))
* FJL 19/12/19 - Se cambia por modificacion respuesta NOK
*             if Eqstr(Val((27+FAC):49),'OK')
             if EqStr(Copy(Val((27+FAC):49),1,2),'OK')
               *'Operacion liquidada'
               SQL.ADD("Update "~DBO~".OPEXTERNAS ")
               SQL.ADD("   Set Estado       = 'REC', ")
               SQL.ADD("       Warning      = 'Operacion liquidada' ")
               SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
               SQL.NEW
               SQL.EXEC
             endif    
           else
             acn(t:50, SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~val(t:45)~"' and Valor=1 ") )
             if Not Incluido(VAR('INSTBAJARA'),VAL(t:50))
                ACT((27+FAC):49, DealCancelResp(NO, fbn('NrExterno'), val(t:45), 'ERRORSISEX: Operacion en instancias intermedias|'))
* FJL 19/12/19 - Se cambia por modificacion respuesta NOK
*               if Eqstr(Val((27+FAC):49),'OK')
               if EqStr(Copy(Val((27+FAC):49),1,2),'OK')
                 *'Operacion liquidada'
                 SQL.ADD("Update "~DBO~".OPEXTERNAS ")
                 SQL.ADD("   Set Estado       = 'REC', ")
                 SQL.ADD("       Warning      = 'Operacion en instancias intermedias' ")
                 SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
                 SQL.NEW
                 SQL.EXEC
               endif     
             else
               if NoVacio(SQL("SELECT NroAltaMae FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~val(t:45)~"' ")) y Vacio(SQL("SELECT NroBajaMae FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~val(t:45)~"' "))
* FJL 29/10/19 - Le agrego fuente baja (RB7)
*                 SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Rojo=1 WHERE NrOperacion='"~val(t:45)~"' ")
                 SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Rojo=1, RB7=2 WHERE NrOperacion='"~val(t:45)~"' ")
                 SQL.NEW
                 SQL.EXEC
                 * Dar de baja mandando a Siopel
                 EjecutarEvento('CBOINS', String1=val(t:45), Radio1=0, Radio2=1, Entero1=val(t:50), Entero2=50)
                 SQL.ADD("Update "~DBO~".OPEXTERNAS ")
                 SQL.ADD("   Set Estado       = 'PRO' ")
                 SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
                 SQL.NEW
                 SQL.EXEC
               else
                 * Ahora los nomae se responden en ANUOPE
*                 ACT((27+FAC):49, DealCancelResp(SI, fbn('NrExterno'), val(t:45), '|'))
* FJL 19/12/19 - Se cambia por modificacion respuesta NOK
*                 if Eqstr(Val((27+FAC):49),'OK')
*                 if EqStr(Copy(Val((27+FAC):49),1,2),'OK')
                   * 'Operacion liquidada'
                   SQL.ADD("Update "~DBO~".OPEXTERNAS ")
                   SQL.ADD("   Set Estado       = 'PRO' ")
                   SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
                   SQL.NEW
                   SQL.EXEC
*                 endif     
                 * Dar de baja sin mandar a Siopel
                 EjecutarEvento('CBOINS', String1=val(t:45), Radio1=0, Radio2=1, Entero1=val(t:50), Entero2=30)
                 EjecutarEvento('ANUOPE')
               endif
             endif    
           endif
         endif   
  endif      
  ** FJL 29-10-19-Nuevas opciones de respuesta por Raiden III
  if Incluido(FBN['TipoAbm'],'RAO|')
    * Respuesta a Alta
    ***** IDSisExterno
    ACN(t:1, fbn('IDSisExterno'))
    ***** SisExterno
    ACT(t:2, fbn('CodSisExterno')) 
    ***** NrExterno
    ACT(t:3, fbn('NrExterno'))
    ***** NrOperacion a modificar
    ACT(t:45, fbn('NrOperacion'))
    ACN(t:49, SQL("Select Count(*) FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~val(t:45)~"' "))
    if Val(t:49)=1
* FJL 19/12/19 - Las operaciones informadas a Raiden ahora quedan en 68 hasta recibir la respuesta
      ACN(t:51, SQL("SELECT Valor FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~val(t:45)~"' and NrBit=68 ") )
      ACT(t:47, 'PRO')
      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set IDSisExterno  = "~FStr(Val(t:1),1,0)~", ")
        SQL.ADD("       CodSisExterno = '"~Val(t:2)~"', ")
        SQL.ADD("       NrExterno     = '"~Val(t:3)~"' ")
        SQL.ADD(" where NrOperacion   = '"~Val(t:45)~"' ")
        SQL.NEW
        SQL.ADD("Update "~DBO~".OPEXTERNAS ")
        SQL.ADD("   Set Estado       = '"~Val(t:47)~"', ")
        SQL.ADD("       Warning      = Null ")
        SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
        SQL.NEW
        SQL.EXEC
        if Val(t:51)=1
          * La operacion esta en 68 la paso a la 10
          EjecutarEvento('CBOINS', String1=val(t:45), Radio1=0, Radio2=1, Entero1=68, Entero2=10)
        endif
      endif
    endif
    if Val(t:49)=0
      ACT(t:44, 'Operacion '~Val(t:45)~' no encontrada.')
      ACT(t:47, 'ERR')
      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPEXTERNAS ")
        SQL.ADD("   Set Estado       = '"~Val(t:47)~"', ")
        SQL.ADD("       Warning      = '"~Val(t:44)~"' ")
        SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
  endif      
  if Incluido(FBN['TipoAbm'],'RAN|')
    ** FJL 01/11/19 - No esta definido que hacer con la respuestra negativa
    ** Solo le cambio el estado para no leerla mas
    ACT(t:3, fbn('NrExterno'))
    ACT(t:45, fbn('NrOperacion'))
    ACN(t:49, SQL("Select Count(*) FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~val(t:45)~"' "))
    if Val(t:49)=1
      ACT(t:47, 'PRO')
    else
      ACT(t:47, 'ERR')
    endif
    if Vacio(fbn('Warning'))
      ACT(t:44, 'Alta rechazada por Raiden motivo desconocido')
    else
      ACT(t:44, fbn('Warning'))
    endif
    if Dialogo.Check1=1
      if Val(t:49)=1
        * Existe la Operacion - Genero Excepcion
        SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
        SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~Val(t:45)~"', ")
        SQL.ADD(" "~SQLAhora~", ")
        SQL.ADD(" 'RESPSERAN', ")
        SQL.ADD(" '"~Copy(Val(t:44),1,100)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      endif

      SQL.ADD("Update "~DBO~".OPEXTERNAS ")
      SQL.ADD("   Set Estado       = '"~Val(t:47)~"' ")
      if Vacio(fbn('Warning'))
        SQL.ADD("   , Warning      = '"~Val(t:44)~"' ")
      endif
      SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
      SQL.NEW
      SQL.EXEC
    endif
  endif      
  if Incluido(FBN['TipoAbm'],'RBO|RBN|')
    * Respuesta a Baja
    ***** NrExterno
    ACT(t:3, fbn('NrExterno'))
    ACT(t:45, fbn('NrOperacion'))
    ACN(t:49, SQL("Select Count(*) FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~val(t:45)~"' "))
    if Val(t:49)=1
      ACT(t:47, 'PRO')
      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPEXTERNAS ")
        SQL.ADD("   Set Estado       = '"~Val(t:47)~"' ")
        SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
    if Val(t:49)=0
      ACT(t:44, 'Operacion '~Val(t:45)~' no encontrada.')
      if Incluido(FBN['TipoAbm'],'RBO|')
        if Dialogo.Check1=1
          SQL.ADD("Update "~DBO~".OPEXTERNAS ")
          SQL.ADD("   Set Warning      = '"~Val(t:44)~"' ")
          SQL.ADD(" where IDSisExterno = "~FStr(Val(a:FAC),1,0)~" ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    endif
