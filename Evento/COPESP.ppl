     SQL.ADD("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ")    
     SQL.ADD(") values (                                                                           ")

     SQL.ADD("  '"~val(pp:4)~"', '"~Dialogo.String1~"', '"~fbn['Cupon']~"', '"~fbn['Nombre']~"', '"~fbn['Extendido']~"', '"~fbn['Cotiza']~"', '"~fbn['InteresesC']~"',                                     ")
     SQL.ADD("  '"~IdxDate(fbn['FEmision'])~"', '"~IdxDate(fbn['Fecha'])~"', '"~fbn['Cupones']~"', '"~fbn['TamanioLote']~"', '"~fbn['VTeorico']~"', '"~fbn['VNominal']~"',  '"~fbn['Factor']~"',           ")
     SQL.ADD("  '"~fbn['DiasMes']~"', '"~fbn['DiasAnio']~"', '"~fbn['MercadoDef']~"', '"~fbn['Tasa1']~"', '"~fbn['Tasa2']~"', '"~fbn['Tasa3']~"', '"~fbn['Observaciones']~"',                          ")
     SQL.ADD("  '"~fbn['Valor1']~"', '"~fbn['Valor2']~"', '"~fbn['Valor3']~"', '"~fbn['Valor4']~"', '"~fbn['Valor5']~"', '"~fbn['Valor6']~"', '"~fbn['Valor7']~"', '"~fbn['Valor8']~"',                    ")
     SQL.ADD("  '"~fbn['Valor10']~"', '"~fbn['Alias1']~"', '"~fbn['Alias2']~"', '"~fbn['Alias3']~"', '"~fbn['Alias4']~"', '"~fbn['Alias5']~"', '"~fbn['Alias6']~"', '"~fbn['Alias7']~"',                   ")
     SQL.ADD("  '"~fbn['Alias8']~"', '"~fbn['Alias9']~"', '"~fbn['Alias10']~"', '"~fbn['Caracter']~"', '"~fbn['MaxGraficar']~"', '"~fbn['MinGraficar']~"',                                                 ")
     SQL.ADD("  '"~fbn['MaxSupuesto']~"', '"~fbn['MinSupuesto']~"', '"~fbn['Intervalos']~"', '"~fbn['TipoOpcionDef']~"', '"~fbn['PlazoLiq']~"',                                                            ")
     SQL.ADD("  '"~fbn['Security']~"', '"~fbn['ExNumber']~"', '"~fbn['ExNumbers']~"', '"~fbn['Issue']~"', '"~fbn['SType']~"', '"~fbn['Issuer']~"', '"~fbn['Guarantor']~"', '"~IdxDate(fbn['CalDate'])~"',  ")
     SQL.ADD("  '"~IdxDate(fbn['PutDate'])~"', '"~IdxDate(fbn['ConDate'])~"', '"~fbn['CodAlfCajaValores']~"', '"~fbn['CodNumCajaValores']~"', '"~fbn['Tipo']~"', '"~fbn['TipoEC']~"', '"~fbn['LaminaMinima']~"',                           ")
     SQL.ADD("  '"~fbn['TipoAccion']~"', '"~fbn['CantidadVotos']~"', '"~fbn['SyPRating']~"', '"~fbn['MoodysRating']~"', '"~fbn['Status']~"', '"~fbn['Sector']~"',                                          ")
     SQL.ADD("  '"~fbn['IndustryGroup']~"', '"~fbn['CallPrice']~"', '"~fbn['PutPrice']~"', '"~fbn['DenominCajaValores']~"', '"~fbn['Habilitada']~"',                                                       ")
