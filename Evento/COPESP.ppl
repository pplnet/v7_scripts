     SQL.ADD("  '"~fbn['FechaAsigHoldingP']~"', '"~fbn['FechaVtoHoldingP']~"', '"~IdxDate(fbn['FechaRevHoldingP'])~"', '"~fbn['FuenteCotizacion']~"',                                                      ")
     SQL.ADD("  '"~fbn['CodigoCotizacion']~"', '"~fbn['CotizaMAE']~"',  '"~fbn['VolumenMinimo']~"', '"~fbn['GrupoEspecie']~"', '"~fbn['CantEmitida']~"', '"~fbn['CutOffTime']~"',                          ")
     SQL.ADD("  '"~fbn['EntidadEmisora']~"', '"~fbn['Tipocartera']~"', '"~fbn['Aforo']~"', '"~fbn['Comprobante']~"', '"~fbn['OrdenFirmada']~"', '"~fbn['CodMAEContado']~"',                                ")
     SQL.ADD("  '"~fbn['AforoPesos']~"', '"~fbn['AforoDolares']~"', '"~fbn['MonedaEmision']~"', '"~fbn['TasaCER']~"', '"~fbn['SWIFT']~"'                                                                   ")
     SQL.ADD("     )                                                                                                                                                                                       ")
     
     SQL.NEW

