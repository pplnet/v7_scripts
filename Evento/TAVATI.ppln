MostrarCuadroDeMensajes()
creardialogo
fecha1:"Fecha";;;;;;dialogo.fecha1 <= FSys();'Fecha  Invalida';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select A.FechaCorte, A.NrCupon, A.Especie, E.DiasTasa Dias, E.TipoTasa, E.Spread ")
Sqladd(" From "~Dbo()~".AGENDACUPONES A, "~Dbo()~".ESPECIES E ")
Sqladd(" Where E.Codigo = A.Especie ")
Sqladd(" AND A.Estado = 'PEN' ")
Sqladd(" AND A.NrCupon = E.Cupon ")
Sqladd(" AND (E.TipoTasa Is Not Null OR E.TipoTasa <> '') ")
Sqladd(" AND E.TipoTasa <> 'FIJA' ")
Sqladd(" AND A.Esquema = '0' ")
Sqladd(" Order by A.Especie, A.NrCupon ")
recorrer sql
let(&tasaencontrada, 0)
if (Habiles(Fbn('FechaCorte'), -Fbn('Dias'), 'ARG', SI) >= dialogo.fecha1)
Acn(b:1, 0)
Act(b:2, Fbn('Especie'))
Act(b:3, Fbn('NrCupon'))
Sqladd(" Select T.Valor1 From "~Dbo()~".TASASDIA T ")
Sqladd(" Where TipoTasa = '"~Fbn('TipoTasa')~"'  ")
Sqladd(" AND Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T1 ")
Sqladd("              Where T.TipoTasa = T1.TipoTasa ")
Sqladd("              AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Acn(b:1, Fbn('Valor1'))
let(&tasaencontrada, 1)
proximo
if (&tasaencontrada = 1)
Acd(fa:1, UltCupon2(Fbn('Especie'), Fbn('FechaCorte') - 1))
Acd(fp:1, ProxCupon2(Fbn('Especie'), Fbn('FechaCorte')))
Acn(da:1, DiasA(EspecieDiasAnio(Fbn('Especie')), Fbn('FechaCorte')))
Acn(dm:1, Abs(iif (EspecieDiasAnio(Fbn('Especie')) = 0 y EspecieDiasMes(Fbn('Especie')) = 0, 30 * DifMes(Val(fp:1), Val(fa:1)), DifDias(Val(fp:1), Val(fa:1), 'USA', NO))))
Acn(ta:1, ((Val(b:1) + (Fbn('Spread') * 100)) / Val(da:1)) * Val(dm:1))
Sqladd(" Update "~Dbo()~".ESPECIES Set ")
Sqladd(" TasaIntAnterior = TasaIntVigente, ")
Sqladd(" TasaIntVigente = "~FStr(Val(b:1) / 100, 0, 8)~", ")
Sqladd(" FechaCambioTasa = '"~IdxDate(FSys())~"' ")
Sqladd(" Where TipoTasa = '"~Fbn('TipoTasa')~"' ")
Sqlnew()
Sqladd(" Update "~Dbo()~".AGENDACUPONES SET ")
Sqladd(" PorRentaAnterior  = PorRenta, ")
Sqladd(" PorRenta = "~FStr(Val(b:1), 0, 8)~", ")
Sqladd(" FechaCambioTasa = '"~IdxDate(FSys())~"' ")
Sqladd(" Where Especie = '"~Val(b:2)~"' ")
Sqladd(" AND NrCupon = '"~Val(b:3)~"' ")
Sqladd(" AND NrCupon > 0 ")
Sqladd(" AND Esquema = '0' ")
Sqlnew()
Sqlexec()
if (Fbn('NrCupon') > 1)
Acd(ss:1, Query("Select FechaCorte from "~Dbo()~".AGENDACUPONES where NrCupon='"~Val(b:3)~"'-1  and Especie='"~Val(b:2)~"' "))
else
Acd(ss:1, Query("Select FEmision from "~Dbo()~".ESPECIES where Codigo='"~Val(b:2)~"' "))
endif
Ejecutarevento('INT002', 'fecha1', Val(ss:1), 'fecha2', dialogo.fecha1, 'especie1', Val(b:2))
else
Message('No se encontró la tasa')
endif
endif
proximo



