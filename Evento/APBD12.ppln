'Cantidad';ac:1..ac:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Deb/Cre';ad:1..ad:fac;not Eqstr(Val(r:flb), 'Captura');;;40;combo;'D|C';RGB(232, 232, 232)
'Cantidad';ae:1..ae:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Cantidad';af:1..af:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Cantidad';ag:1..ag:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Cantidad';ah:1..ah:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Cantidad';ai:1..ai:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Cantidad';aj:1..aj:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
