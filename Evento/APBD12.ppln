finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 1, Fac()
if (Val(m:&i) = 1)
Sqladd(" DELETE /*+ RULE */ FROM "~Dbo()~".MOVDATANET WHERE NrDatanet = '"~Val(o:&i)~"' AND NrMovDatanet= "~FStr(Val(p:&i), 0, 0)~" ")
Sqlnew()
Message('Movimiento '~Val(o:&i)~' - '~FStr(Val(p:&i), 0, 0)~' eliminado.')
endif
if (Val(n:&i) = 1)
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".MOVDATANET SET ")
if (not Eqstr(Val(r:&i), 'Captura'))
Sqladd(" Vehiculo = '"~Val(a:&i)~"', ")
Sqladd(" Banco    = '"~Val(b:&i)~"', ")
Sqladd(" Sucursal = '"~Val(c:&i)~"', ")
Sqladd(" Cuenta   = '"~Val(d:&i)~"', ")
Sqladd(" Moneda   = '"~Val(e:&i)~"', ")
Sqladd(" Importe  = "~FStr(Val(f:&i), 1, 2)~", ")
if (Val(g:&i) = 0)
Sqladd(" DC = 'D', ")
else
Sqladd(" DC = 'C', ")
endif
Sqladd(" FechaIngreso      = "~IdxDate2(Val(h:&i))~", ")
Sqladd(" FechaAcreditacion = "~IdxDate2(Val(i:&i))~", ")
Sqladd(" Comprobante       = '"~Val(k:&i)~"', ")
if (Val(l:&i) = 0)
Sqladd(" EstadoConciliacion = 'P', ")
endif
if (Val(l:&i) = 1)
Sqladd(" EstadoConciliacion = 'OK', ")
endif
if (Val(l:&i) = 2)
Sqladd(" EstadoConciliacion = 'FC', ")
endif
Sqladd(" Importe2  = "~FStr(Val(aa:&i), 1, 2)~", ")
if (Val(ab:&i) = 0)
Sqladd(" DC2 = 'D', ")
else
Sqladd(" DC2 = 'C', ")
endif
Sqladd(" Importe3  = "~FStr(Val(ac:&i), 1, 2)~", ")
if (Val(ad:&i) = 0)
Sqladd(" DC3 = 'D', ")
else
Sqladd(" DC3 = 'C', ")
endif
Sqladd(" Importe4  = "~FStr(Val(ae:&i), 1, 2)~", ")
Sqladd(" Importe5  = "~FStr(Val(af:&i), 1, 2)~", ")
Sqladd(" Importe6  = "~FStr(Val(ag:&i), 1, 2)~", ")
Sqladd(" Importe7  = "~FStr(Val(ah:&i), 1, 2)~", ")
Sqladd(" Importe8  = "~FStr(Val(ai:&i), 1, 2)~", ")
Sqladd(" Importe9  = "~FStr(Val(aj:&i), 1, 2)~", ")
Sqladd(" Importe10 = "~FStr(Val(ak:&i), 1, 2)~", ")
Sqladd(" Importe11 = "~FStr(Val(al:&i), 1, 2)~", ")
Sqladd(" Importe12 = "~FStr(Val(am:&i), 1, 2)~", ")
endif
Sqladd(" TipoMov           = '"~Val(j:&i)~"' ")
Sqladd(" WHERE NrDatanet = '"~Val(o:&i)~"' AND NrMovDatanet= "~FStr(Val(p:&i), 0, 0)~" ")
Sqlnew()
Message('Movimiento '~Val(o:&i)~' - '~FStr(Val(p:&i), 0, 0)~' actualizado.')
endif
Sqlexec()
proximo


