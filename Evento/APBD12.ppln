'Cuenta';d:1..d:fac;NO;;;70;tabla;'Cuentas';'Numero';'Numero;Codigo;Nombre';" Comitente='"~Val(q:flb)~"' AND Cliente='"~Val(a:flb)~"' ";RGB(232, 232, 232);
'Moneda';e:1..e:fac;NO;;;70;tabla;'Especies';'Alias3';'Alias3;Codigo;Nombre';" Tipo = 'MON'  AND Alias3 IS NOT NULL";RGB(232, 232, 232)
'Cantidad';f:1..f:fac;not Eqstr(Val(r:flb), 'Captura');;;80;numero;'###,###,###,###.##';RGB(232, 232, 232);
'Deb/Cre';g:1..g:fac;not Eqstr(Val(r:flb), 'Captura');;;40;combo;'D|C';RGB(232, 232, 232)
