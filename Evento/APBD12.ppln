MostrarCuadroDeMensajes()

creardialogo
fecha1: 'FechaBajada';1;;;;;;;;;FSys()
string: 'Archivo';2;;;;;;;;'DNCTAS';BuscarCampo('DATANET', 'Archivo', 'NrDatanet', dialogo.string2)
string2: 'NrDatanet';3;;;;;;;;Query("SELECT NrDatanet FROM "~Dbo()~".DATANET WHERE FechaBajada="~IdxDate2(dialogo.fecha1)~" AND TRIM(Archivo)='"~Trim(Mirt(Mayusculas2(dialogo.string)))~"' ORDER BY NrDatanet DESC ")
fecha2: 'F.Desde';4;;;NO;;;;;;BuscarCampo('DATANET', 'FechaDesde', 'NrDatanet', Trim(dialogo.string2))
fecha3: 'F.Hasta';5;;;NO;;;;;;BuscarCampo('DATANET', 'FechaHasta', 'NrDatanet', Trim(dialogo.string2))
radio1: 'Estado|A|C|NC';6;;;NO;;;;;;BuscarCampo('DATANET', 'Estado', 'NrDatanet', Trim(dialogo.string2))
radio2: 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos';7;1;;;;;;;4
check1: 'Incluye Pagadoras';8;1;;;;;;;1
vehiculo1: 'Vehiculo';9;;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO', 'Vehiculo', 'Codigo', UsuarioActivo());;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
lista1: 'Bancos';10;1;1;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista2: 'Cuentas';4;2;1;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Cliente = '"~dialogo.vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(dialogo.lista1)~")"~iif (dialogo.check1 = 0, " AND (Pagadora <>'SI' OR Pagadora IS NULL)"));
findialogo

if (not ok)
Cancelar()
endif

Message('Recuperando datos del Extracto ... ')
Sqladd(" SELECT /*+ RULE */ ")
Sqladd(" M.*, E.Codigo MonedaFPA, C.Codigo CuentaFPA, B.Codigo BancoFPA, D.Supervisor ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".CLIENTES B, "~Dbo()~".CUENTAS C, "~Dbo()~".ESPECIES E, ")
Sqladd(" "~Dbo()~".DATANET D ")
Sqladd(" WHERE  M.Moneda   = E.Alias3 ")
Sqladd(" AND    M.Cuenta   = C.Numero ")
Sqladd(" AND    M.Banco    = B.Alias2 ")
Sqladd(" AND    M.NrDatanet = D.NrDatanet ")
Sqladd(" AND    (D.EstadoAprobacion = 'P' OR D.Supervisor = 'Captura') ")
Sqladd(" AND    M.TipoMov <> 'SAL' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND   C.Comitente IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND   C.Codigo IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (dialogo.radio2 = 0)
Sqladd(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
endif
if (dialogo.radio2 = 1)
Sqladd(" AND C.TipoCuenta IN ('INT')")
endif
if (dialogo.radio2 = 2)
Sqladd(" AND C.TipoCuenta IN ('REC')")
endif
if (dialogo.radio2 = 3)
Sqladd(" AND C.TipoCuenta IN ('CA')")
endif
if (dialogo.check1 = 0)
Sqladd(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
endif
Sqladd(" ORDER BY M.NrDatanet, M.NrMovDatanet ")
Acn(z:1, 0)
recorrer sql
Acn(z:1, 1)
Act(a:fac, Fbn('Vehiculo'))
Act(b:fac, Fbn('Banco'))
Act(c:fac, Fbn('Sucursal'))
Act(d:fac, Fbn('Cuenta'))
Act(e:fac, Fbn('Moneda'))
Acn(f:fac, Fbn('Importe'))
if (Eqstr(Fbn('DC'), 'D'))
Acn(g:fac, 0)
else
Acn(g:fac, 1)
endif
Acd(h:fac, Fbn('FechaIngreso'))
Acd(i:fac, Fbn('FechaAcreditacion'))
Act(j:fac, Fbn('TipoMov'))
Act(k:fac, Fbn('Comprobante'))
if (Eqstr(Fbn('EstadoConciliacion'), 'P'))
Acn(l:fac, 0)
endif
if (Eqstr(Fbn('EstadoConciliacion'), 'OK'))
Acn(l:fac, 1)
endif
if (Eqstr(Fbn('EstadoConciliacion'), 'FC'))
Acn(l:fac, 2)
endif

Acn(aa:fac, Fbn('Importe2'))
if (Eqstr(Fbn('DC2'), 'D'))
Acn(ab:fac, 0)
else
Acn(ab:fac, 1)
endif
Acn(ac:fac, Fbn('Importe3'))
if (Eqstr(Fbn('DC3'), 'D'))
Acn(ad:fac, 0)
else
Acn(ad:fac, 1)
endif
Acn(ae:fac, Fbn('Importe4'))
Acn(af:fac, Fbn('Importe5'))
Acn(ag:fac, Fbn('Importe6'))
Acn(ah:fac, Fbn('Importe7'))
Acn(ai:fac, Fbn('Importe8'))
Acn(aj:fac, Fbn('Importe9'))
Acn(ak:fac, Fbn('Importe10'))
Acn(al:fac, Fbn('Importe11'))
Acn(am:fac, Fbn('Importe12'))
Acn(m:fac, 0)
Acn(n:fac, 0)
Act(o:fac, Fbn('NrDatanet'))
Acn(p:fac, Fbn('NrMovDatanet'))
Act(q:fac, Fbn('BancoFPA'))
Act(r:fac, Fbn('Supervisor'))
proximo

if (Val(z:1) = 0)
Cancelar('No se encontraron movimientos.')
endif

