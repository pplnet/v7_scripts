sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("Set CB8 = '1', ")
sql.add("OperacionRef = '"~Val(z3)~"', ")
sql.add("FechaEx2  = '"~IdxDate(dialogo.fecha2)~"', ")
sql.add("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
sql.add("Precio2   = "~FStr(dialogo.precio2, 0, 7)~", ")
sql.add("TotalNetoCli2 = "~FStr(Val(z4), 0, 2)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new

