message('--- Asientos de Interes Devengado diario ICL ---')
ACT(TA:1, Var('TIPASDEV'))
ACT(ML:1, Var('MONELOCA'))


SQL.ADD("SELECT *,Especie ContraEspecie, '#Op:' + NrOperacion + ',' + rtrim(TipoOp) + ',' + rtrim(Especie) Leyenda ")
SQL.ADD(" From (select M.NrOperacion,  M.Vehiculo, Sum(M.Monto) TotalNetoCli1, ")
** FJL 17/11/20 - Se agrega TipoConu
SQL.ADD(" MA.Codigo CodAsi, O.TipoOp, M.Especie, M.Book, O.TipoCONU  ")
SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M, "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE M.TipoDevengado in ('INTICL') ")
SQL.ADD("AND O.NrOperacion = M.NrOperacion ")
SQL.ADD("AND M.FechaEj = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("AND M.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("AND MA.TipoAsiento in("~Pipe2Comillas(Val(TA:1))~") ")
SQL.ADD("AND MA.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" Group by M.NrOperacion,M.Vehiculo,Codigo,O.TipoOp,M.Especie, M.Book, O.TipoCONU ")
SQL.ADD(" ) Aux ")

watch(SQL.Batch)
ACN(XX:2,0)
ACN(XX:1,0)
Recorrer SQL
    ACD(FV:1, Dialogo.Fecha1)
    ACD(FD:1, Dialogo.Fecha1)
    ACT(VH:1, fbn('Vehiculo'))
    ACT(VK:1, fbn('Book'))    
