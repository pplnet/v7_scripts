creardialogo
lista1:'Especies';;;;;;;;;;;SQLSet("Select Codigo from "~Dbo()~".ESPECIES Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")
findialogo
if (not ok)
Cancelar()
endif

if (Eqstr(Query("SELECT Valor FROM "~Dbo()~".VARIABLES WHERE Codigo='CONTROLAPM' "), 'NO'))
Cancelar('Control de PME inhabilitado')
endif

Sqladd("SELECT Codigo, ISIN, Codigo2, EstadoOperativo FROM "~Dbo()~".ESPECIES")
Sqladd("  Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")
if (NoVacio(dialogo.lista1))
Sqladd(" and  Codigo in ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Watch(Sqlbatch())
recorrer sql
Act(xy1, '')
if (NoVacio(Fbn()['ISIN']))
Act(xy1, Query("Select Case When SANCTION_STATUS = 'Sanctioned' then 'SI' When SANCTION_STATUS = 'Not Sanctioned' then 'NO' Else 'NE' End from "~Var("PMEPATH")~" where ISIN = '"~Fbn()['ISIN']~"'  "))
else
Act(xy1, Query("Select Case When SANCTION_STATUS = 'Sanctioned' then 'SI' When SANCTION_STATUS = 'Not Sanctioned' then 'NO' Else 'NE' End from "~Var("PMEPATH")~" where BBTICKER = '"~Fbn()['Codigo2']~"'  "))
endif


if (NoVacio(Val(xy1)))
if (not Eqstr(Fbn()['EstadoOperativo'], Val(xy1)))
Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET EstadoOperativo    = '"~Val(xy1)~"' ")
Sqladd("WHERE Codigo          = '"~Fbn()['Codigo']~"' ")
Sqlnew()
Sqlexec()
endif
else
if (not Eqstr(Fbn()['EstadoOperativo'], 'NE'))
Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET EstadoOperativo    = 'NE' ")
Sqladd("WHERE Codigo          = '"~Fbn()['Codigo']~"' ")
Sqlnew()
Sqlexec()
endif
endif

proximo


