MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';;;;NO;;;;;;FSys()
string1:'Path';;;;;;;;;Var('PATHIMPO')
string2:'Archivo';;;;;;;;;'INDICES.XLS'
check1:'Procesa';1;2;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
HojaVisible(SI)

if (not existedirectorio(Var('PATHIMPO')))
Cancelar('Debe Crear el Directorio '~Var('PATHIMPO'))
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

Acn(x:1, 1000)
importarxls(a:1..c:Val(x:1), aa:1..ac:Val(x:1), dialogo.string1~dialogo.string2)

if (Vacio(Val(aa:1)))
Cancelar('No se ha podido recuperar el archivo de indices:'~dialogo.string1~dialogo.string2)
endif

SetFilaActual(1)
recorrer&i 2, Val(x:1)
if (Vacio(Val(aa:&i)))
Acn(x:2, &i - 1)
break
endif

Act(af:&i, Query(" Select Codigo From "~Dbo()~".ESPECIES Where Codigo = '"~Val(aa:&i)~"' "))
if (Vacio(af:&i))
Scn(ae:&i, 1)
Act(al:&i, 'No existe en Especies')
endif

if (Val(ae:&i) = 0)
if (DesciendeDeEspecie(Val(aa:&i), 'INDICE'))
Act(ag:&i, 'OK')
else
Scn(ae:&i, 1)
Act(al:&i, 'No desciende de INDICE')
endif
endif

if (Val(ae:&i) = 0)
if (EsTerminal(Val(aa:&i)))
Act(ah:&i, 'OK')
else
Scn(ae:&i, 1)
Act(al:&i, 'No es Terminal')
endif
endif

if (Val(ae:&i) = 0)
Act(ai:&i, BuscarCampo('ESPECIES', 'CodigoExterno', 'Codigo', Val(aa:&i)))
Act(aj:&i, BuscarCampo('ESPECIES', 'Tenor', 'Codigo', Val(aa:&i)))
if (NoVacio(Val(ai:&i)) o NoVacio(Val(aj:&i)))
Scn(ae:&i, 1)
Act(al:&i, 'Es indice para spread ICL')
endif
endif
proximo

SetFilaActual(3)
Act(a:fac, 'Importacion de Indices')
SetFont(a:fac, 3)

SetFilaActual(Fac() + 2)
Act(a:fac, 'Fecha: '~dialogo.fecha1)
Act(a:fac + 1, 'Archivo importado: '~dialogo.string1~dialogo.string2)
SetFont(a:fac..a:fac + 1, 2)

SetFilaActual(Fac() + 3)
Act(a:fac, 'Indice')
Act(b:fac, 'Fecha')
Act(c:fac, 'Valor')
Act(d:fac, 'Accion')
Act(e:fac, 'Observacion')
SetFont(a:fac..e:fac, 2)
AgregarMarco(a:fac..e:fac, 1, 0, Exe('COLOR6'))

if (Val(x:2) > 1)
recorrer&i 2, Val(x:2)
Ifa()

Act(a:fac, Val(aa:&i))
Acd(b:fac, Val(ab:&i))
Acn(c:fac, Val(ac:&i))
if (Val(ae:&i) = 0)
if (Query("SELECT 1 FROM "~Dbo()~".COTIZACIONES WHERE Codigo='"~Val(aa:&i)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(ab:&i))~"' and Moneda='ARP' ") = 1)
Act(d:fac, 'Update')
if (dialogo.check1 = 1)
Sqladd("UPDATE "~Dbo()~".COTIZACIONES SET ")
Sqladd("Precio1            = "~FStr(Val(ac:&i), 1, 8)~", ")
Sqladd("FechaActualizacion = "~SQLAhora()~" ")
Sqladd("WHERE  Codigo='"~Val(aa:&i)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(ab:&i))~"' and Moneda='ARP' ")
Sqlnew()
Sqlexec()
endif
else
Act(d:fac, 'Insert')
if (dialogo.check1 = 1)
Sqladd("INSERT INTO "~Dbo()~".COTIZACIONES ")
Sqladd("(Fecha, Codigo, CallPut, Precio1, Moneda, FechaActualizacion) ")
Sqladd(" VALUES ('"~IdxDate(Val(ab:&i))~"', '"~Val(aa:&i)~"', 'CON', ")
Sqladd(" "~FStr(Val(ac:&i), 0, 8)~", 'ARP',"~SQLAhora()~" )")
Sqlnew()
Sqlexec()
endif
endif
else
Act(d:fac, 'ERROR')
Act(e:fac, Val(al:&i))
endif
proximo
SetFont(a:fac - Val(x:2) + 2..e:fac, 1)
FormatoCeldas(c:fac - Val(x:2) + 2..c:fac, Exe('F8'))

else
SetFilaActual(Fac() + 2)
Act(a:fac, 'No registros para importar')
SetFont(a:fac, 2)
endif

SetFilaActual(Fac() + 2)
Act(a:fac, 'Fin Listado')
SetFont(a:fac, 2)

ACO(1, 10)
ACO(2, 10)
ACO(3, 10)
ACO(4, 10)
ACO(5, 20)

LimitesVision(e:fac)

