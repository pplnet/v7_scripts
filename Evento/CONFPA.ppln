sql.add(" SELECT OperacionRef FROM "~Dbo()~".OPERACIONES   ")
sql.add(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
sql.add(" SELECT NrOperacion, TipoOp FROM "~Dbo()~".OPERACIONES      ")
sql.add(" WHERE ( OperacionRef = '"~Fbn('OperacionRef')~"' ")
sql.add("         OR ")
sql.add("        (NrOperacion = '"~Fbn('OperacionRef')~"' AND TipoOp IN ('TIPA','TIPP'))  ) ")
recorrer sql
if (not Incluido(Fbn('TipoOp'), 'TIPA|TIPP'))
sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '1' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit=50 ")
sql.new
sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '0' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit<>50 ")
sql.new
sql.exec
else
sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '1' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit=70 ")
sql.new
sql.add(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '0' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit<>70 ")
sql.new
sql.exec
endif
