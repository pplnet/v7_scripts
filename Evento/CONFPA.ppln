Sqladd(" SELECT OperacionRef FROM "~Dbo()~".OPERACIONES   ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Sqladd(" SELECT NrOperacion, TipoOp FROM "~Dbo()~".OPERACIONES      ")
Sqladd(" WHERE ( OperacionRef = '"~Fbn('OperacionRef')~"' ")
Sqladd("         OR ")
Sqladd("        (NrOperacion = '"~Fbn('OperacionRef')~"' AND TipoOp IN ('TIPA','TIPP'))  ) ")
recorrer sql
if (not Incluido(Fbn('TipoOp'), 'TIPA|TIPP'))
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
Sqladd(" Valor = '1' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit=50 ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
Sqladd(" Valor = '0' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit<>50 ")
Sqlnew()
Sqlexec()
else
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
Sqladd(" Valor = '1' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit=70 ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET ")
Sqladd(" Valor = '0' WHERE  NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit<>70 ")
Sqlnew()
Sqlexec()
endif
