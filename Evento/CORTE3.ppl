         'Saldo'           ;g:Val(ha1)..g:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
         'Precio del Cupon';j:Val(ha1)..j:val(z:1)  ;NO;;;90;NUMERO;'###.########';
         'Moneda'          ;m:Val(ha1)..m:val(z:1)  ;NO;;;50;STRING;
         'Total'           ;k:Val(ha1)..k:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
