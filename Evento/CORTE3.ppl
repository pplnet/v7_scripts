         'A Cuenta'        ;h:Val(ha1)..h:val(z:1)  ;SI;Val(a:FLB)=0 o [NoVacio(Val(h:FLB)) y Incluido(Val(h:FLB),Val(q:FLB))];'Debe ingresar una cuenta valida. (Linea '~FStr(Val(i:FLB),0,0)~')';90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"(Cliente = '"~Val(l:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','CUS','VIS') AND (Mercado = '"~Val(c:FLB)~"' OR Mercado in ("~Pipe2Comillas(Val(f:fac))~")) AND (Especies LIKE '%"~val(m:fac)~"%' OR Especies LIKE '%MONEDA%') ) or Codigo='"~val(dz3)~"'  ";RGB(160,160,193);
         'Linea'           ;i:Val(ha1)..i:val(z:1)  ;NO;;;60;NUMERO;'###';
         'NrSaldo'         ;s:Val(ha1)..s:val(z:1)  ;NO;;;80;NUMERO;'###';
         'Tipo'            ;by:Val(ha1)..by:val(z:1);NO;;;60;STRING;
** FJL 13/12/2021 - Se agregan campos de Comisiones
         'Comision'        ;ja:Val(ha1)..ja:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
         'IVA Com'         ;jb:Val(ha1)..jb:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
** FJL 27/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
** FJL 18/03/24 - Se vuelve atras la modificacion
*         'Mon.Com.CV'      ;dm:Val(ha1)..dm:val(z:1)  ;NO;;;80;STRING;
*         'Cta.Com.CV'      ;dh:Val(ha1)..dh:val(z:1)  ;SI;Val(a:FLB)=0 o [NoVacio(Val(dh:FLB)) y Incluido(Val(dh:FLB),Val(dq:FLB))];'Debe ingresar una cuenta valida. (Linea '~FStr(Val(i:FLB),0,0)~')';90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"(Cliente = '"~Val(l:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','CUS','VIS') AND (Mercado = '"~Val(c:FLB)~"' OR Mercado in ("~Pipe2Comillas(Val(f:fac))~")) AND (Especies LIKE '%"~val(dm:fac)~"%' OR Especies LIKE '%MONEDA%') ) or Codigo='"~val(dz3)~"'  ";RGB(160,160,193);
         'Com.CV'          ;jc:Val(ha1)..jc:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
         'Iva Com. CV'     ;jd:Val(ha1)..jd:val(z:1)  ;NO;;;80;NUMERO;'###,###,###.##';
      FinListBox

      IF NOT OK
         Cancelar
      ENDIF

      Message('---------- Generando Transacciones de Cobro/Pago -------------')
      
      *- Genera la Transaccion de Liquidacion Cupon
      *- b4: Especie Cupon 
      *- c2: Nro. Cupon 
      *- h4: Fecha Proximo Corte
      *- m1: Moneda 
      *- k2: % Amortizacion 
      *- l2: % Renta 
      *- m2: Interes Capitalizados 
      *- j2: Vehiculo
      ACT(lb4, val(ec1))
      ACN(lc2, Num(val(x3)))
      ACD(lh4, VAL(aa3))
      ACT(lm1, val(aa7))
      ** Actualiza  Con  aa8: Amortizacion   aa9: Renta   aa10: Ints. Cap
 **AA 21-03-18      ** Actualiza  pr:8 Amortizacion   pr:9 Renta   y pr:10 Ints. Cap con valores del Dialogo 
 **      ACN(lk2,val(aa8)*100)
 **     ACN(ll2,val(aa9)*100)
 **    ACN(lm2,val(aa10)*100) 
      ACN(lk:2, val(pr:8))
** FJL 27/06/18 - Ingreso de TNA
      ACN(ls:2, val(pr:11))
*****
      ACN(ll:2, val(pr:9))
      ACN(lm:2, val(pr:10))
      ACT(lj:2, val(aa:4))

** FJL 13/07/22 - Se agrega marca de Tipo de saldos que se Pagan
      ACN(ts:1, val(aa:11))

** FJL 10/10/23 - Se agrega marca de Dollar Linked y su precio
      ACN(ld:1, val(aa:28))
      ACN(ld:2, val(pr:12))
** FJL 26/02/24 - TC x Comisiones CV
      ACN(ld:3, val(pr:13))

#ifdef PRUEBA
  MessageBox('No Procesa')
#else
      (.'GENLCUPON'.)
**  Actualizacion Cotizaciones  y Agenda --> Precio cupon a fecha de pago cupon, si hubo cambio con el CORTE
      IF Val(aa:5)<>Val(pr:1)
      *-----------    Actualizacion LCUPON con Valores  del Corte Original--------*   
         SQL.ADD(" Update "~DBO~".TRANSACCIONES2  ")
         SQL.ADD(" Set Cambio1="~FStr(val(aa8)*100,1,8)~", ")
         SQL.ADD("     Cambio2="~FStr(val(aa9)*100,1,8)~", ")
         SQL.ADD("     Cambio3="~FStr(val(aa10)*100,1,8)~", ")
** FJL 27/06/18 - Ingreso de TNA
         SQL.ADD(" Cambio5="~FStr(val(ab:9),1,8)~" ")
*****
         SQL.ADD(" WHERE NrTrans = '"~Val(y2)~"' ")
         SQL.ADD(" AND   TipoTr2 = 'LCUPON'      ")
         SQL.ADD(" AND   Especie = '"~Val(lb4)~"' ")
         SQL.ADD(" AND   Cupon1  = "~fstr(Val(lc2),0,0)~" ")
         SQL.ADD(" AND   Fecha1  = '"~IdxDate(Val(lh4))~"' ")
         SQL.ADD(" AND   Vehiculo1 = '"~VAL(lj2)~"' ")
         SQL.NEW
         SQL.EXEC
         *----------- Inserto Cotizacion ESPECIE CUPON -------------*
         IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Fecha = '"~IdxDate(val(aa3))~"' AND Codigo = '"~Val(aa1)~"' AND CallPut = 'CON' AND Moneda = '"~Val(ec:2)~"'  ") <> 1
            Message('Alta Cotizacion  '~Val(aa1))
            SQL.ADD(" Insert Into "~DBO~".COTIZACIONES ")
            SQL.ADD(" (Fecha, Codigo, CallPut, ")
            SQL.ADD(" Precio1, Precio2, Precio3,Moneda) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~IdxDate(val(aa3))~"', '"~Val(aa1)~"', 'CON', ")
            SQL.ADD(" "~Fstr(Val(pr:1), 0, 8)~",  "~Fstr(Val(pr:1), 0, 8)~", ")
            SQL.ADD(" "~Fstr(Val(pr:1), 0, 8)~",'"~Val(ec:2)~"' ) ")
            SQL.NEW
            SQL.EXEC
         ELSE
            Message('Modificacion Cotizacion '~Val(aa1))
            SQL.ADD(" Update "~DBO~".COTIZACIONES ")
            SQL.ADD(" Set Precio1 = "~Fstr(Val(pr:1), 0, 8)~", ")
            SQL.ADD(" Precio2 = "~Fstr(Val(pr:1), 0, 8)~", ")
            SQL.ADD(" Precio3 = "~Fstr(Val(pr:1), 0, 8)~" ")
            SQL.ADD(" Where Fecha = '"~IdxDate(Val(aa3))~"' ")
            SQL.ADD(" AND Codigo = '"~Val(aa1)~"' ")
            SQL.ADD(" AND CallPut = 'CON' ")
            SQL.ADD(" AND Moneda = '"~Val(ec:2)~"' ")
            SQL.NEW
            SQL.EXEC
         ENDIF
 
         *---------- Actualiza Tabla AgendaCupon ------------*
         SQL.ADD("UPDATE "~DBO~".AGENDACUPONES SET ")
         SQL.ADD(" PrecioCupon  = "~FSTR(Val(pr:1),1,9)~", ")
         SQL.ADD(" FechaProceso = '"~IdxDate(Val(aa3))~"', ")
         SQL.ADD(" PorAmCapital = "~FSTR(Val(pr:8),1,9)~", ")
         SQL.ADD(" PorRenta     = "~FSTR(Val(pr:9),1,9)~", ")
** FJL 27/06/18 - Ingreso de TNA
         SQL.ADD(" TNA          = "~FSTR(Val(pr:11),1,9)~", ")
*****
         SQL.ADD(" PorAmIntCap  = "~FSTR(Val(pr:10),1,9)~" ")
         SQL.ADD("WHERE Especie = '"~Val(aa14)~"' ")
         SQL.ADD("  AND NrCupon = '"~FSTR(Val(aa2),1,0)~"' ")
         SQL.NEW
         SQL.EXEC
      Endif 
 
 
      Recorrer&i 1,val(z:1)
        IF Val(a:&i)=1 y CLIENTECUENTA(Val(l:&i),Val(h:&i),Val(m:&i))
           Message('*---Calculo de Comisiones por CORTE DE CUPON')
           *- cl1: Cliente  
           *- ce1: Especie Original del Saldo 
           *- cv1: Vehiculo  
           *- cy1: Mercado  
           *- ct1: Tipo de Comision
           *- da: CallPut  
           *- db: FechaEj  
           *- dc: PrecioEj  
           *- de:Cuenta  
           *- sa2: Ultimo nro. de Cuota para insertar comisiones
           *- sa:3 Acumulador de Comisiones

            act(cl1, Val(l:&i))
            act(cv1, Val(aa4))
            act(cy1, Val(c:&i))
            act(da1, '')
            act(db1, '')
            acn(dc1, 0)
            act(de1, Val(h:&i))
            act(ce1, Val(aa14))

            acn(ci:2,0)
            acn(ci:1,0)
            acn(sa2,0)
            acn(sa3,0)
            acn(re1,0)
            acn(re2,0)
            acn(re3,0)
            acn(ci:12,0)
            acn(ci:11,0)

* FJL 20/12/21 - Saldos no pagan comision
*            If Not EqStr(val(bz:&i),'PAS') y Not EqStr(val(bz:&i),'PRE')
            If Vacio(Val(jp:&i)) y Not EqStr(val(bz:&i),'PAS') y Not EqStr(val(bz:&i),'PRE')
               If val(pr:9)<>0 
                  Message('*- Calculo la comision de la Renta solamente para los Saldos <> 201 '~val(l:&i))
                  act(ct:1, Val(dz4))
                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9))
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))

                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)

                  acn(re1, val(sa:3))
               EndIf

               If val(pr:8)<>0 y Val(m:&i)<>Val(sl1)+100 
                  Message('*- Calculo la comision de la Amortizacion solamente para los Saldos <> 201 '~val(l:&i))
                  act(ct:1, Val(dz5))
                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:8))
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))
 
                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)
                  acn(re2, val(sa:3)-val(re1))
               EndIf


               *- ci2: Calculo del % del Iva sobre comisiones
               acn(ci:2, Num(Val(dz10))+IIF(EQSTR(Val(bn:&i),'NOI'),Num(Val(dz11)),IIF(EQSTR(Val(bo:&i),'SI'),Num(Val(dz12)),0)))

               *- ci:1 Monto de Iva
               acn(ci:1,ROUND(Abs(val(sa:3))*Val(ci:2)/100,2))

               *-------------------------
               *- COMISION CAJA DE VALORES DE RENTA
               *- re3: Monto de la comision
* FJL 12/01/22 - La base para la comision de CV es ahora Renta+Amortizacion (Lautaro)
*               If val(pr:9)<>0  y Not EqStr(val(bz:&i),'PAS')
* FJL 22/12/23 - La base para la comision de CV cuelve a ser solo Renta (Lautaro)
*               If (val(pr:9)<>0 o val(pr:8)<>0) y Not EqStr(val(bz:&i),'PAS')
               If val(pr:9)<>0  y Not EqStr(val(bz:&i),'PAS')
                 act(ct:1, Val(dz41))
* FJL 12/01/22 - La base para la comision de CV es ahora Renta+Amortizacion (Lautaro)
*                  acn(cj:1,Val(g:&i)*val(pr:9))
* FJL 22/12/23 - La base para la comision de CV cuelve a ser solo Renta (Lautaro)
*                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9)+Val(g:&i)*Val(pr:12)*val(pr:8))
                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9)/100)
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))
  
                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)
  
                  acn(re3, val(sa:3)-val(re1)-val(re2))
                  scn(sa3,-val(re3))
               EndIf
 
               *- ci12: Calculo del % del Iva sobre comisiones DE CAJA DE VALORES 
               acn(ci:12, Num(Val(dz20)) )

               *- ci:11 Monto de Iva
               acn(ci:11,ROUND(Abs(val(re:3))*Val(ci:12)/100,2))            
               *-------------------------
 
               * si la comision es mayor que lo que pago
               * messagebox(Val(sa3)~'+'~Val(ci1))
               IF Val(sa3)+Val(ci1)>Val(k:&i)
                  ACN(sa3, ROUND(val(k:&i)/(1+Val(ci2)/100),2))
                  ACN(ci1, Val(k:&i)-Val(sa3))
               ENDIF

               ***---BC1 = %Bonif.Comision
               ***---SA4 = Comision Bonificada
               ***---SA5 = IVA Comision Bonificada
               IF Val(SA:3) <> 0 
                  ***---Hay Bonificacion sobre la comision
                  ACN(SA:4, Val(SA:3) - (Val(SA:3) * Val(BC:1) / 100))
               ELSE
                  ACN(SA:4, 0)
               ENDIF
               IF Val(CI:1) <> 0 
                  ***---Hay Bonificacion sobre el IVA comision
                  ACN(SA:5, Val(CI:1) - (Val(CI:1) * Val(BC:1) / 100))
               ELSE
                  ACN(SA:5, 0)
               ENDIF
            EndIf


            *- Linea a Insertar
            ACN(fi1,&i)
            
            Message('Generando Movimientos Nro. '~Val(y:2)~' .... ')
            (.'LCUPINSMOV'.)

            If EqStr(val(bz:&i),'PAS')
               *- Actualizo las operaciones futuras
               SQL.ADD(" Update "~DBO~".OPERACIONES ")
               SQL.ADD(" Set ")
               SQL.ADD(" NrOperacion2 = '"~Val(Y:2)~"' ")
               SQL.ADD(" Where NrOperacion2='"~Val(aa20)~"' ")
               SQL.NEW

               SQL.ADD(" Update "~DBO~".CUOTAS ")
               SQL.ADD(" Set ")
               SQL.ADD(" Vehiculo2 = '"~Val(Y:2)~"' ")
               SQL.ADD(" Where Vehiculo2='"~Val(aa20)~"' ")
               SQL.NEW
               SQL.EXEC
            EndIf
        Else
            If Val(a:&i)=1
               messagebox('La cuenta '~Val(h:&i)~' es incorrecta para el cliente '~Val(l:&i)~' y especie '~Val(m:&i))
            Endif
        ENDIF
      Proximo

      *- Libero la posicion de los cupones
      (.'LCUPPOSI'.)
      (.'CUSMONEDA'.)
#endif
   ELSE
     Cancelar('No existen saldos para el cupon solicitado.')
   ENDIF
ENDIF
