           ACT(d:fac, Val(ec:1))

           ACT(e:fac, Val(x:3))
           ACN(g:fac, Val(x:1))
           ACN(j:fac, Val(pr:1))
*           ACN(k:fac, Val(x:1)*Val(pr:1))
           ACN(k:fac, Val(x:1)*Val(pr:1)*Val(pr:12))
           ACT(l:fac, fbn('Cliente'))
           ACT(m:fac, Val(ec:2))
           * MOneda Comision CV
           ACT(dm:fac, Var('MONELOCA'))
           ACN(s:fac, FBN['NrSaldo'])
           ACN(fa:1, fac)
           ACT(r:fac, '')
           ACN(a:fac, 1)
           
** FJL 11/07/22 - Cuanta Vista para saldos bloquedas
           ACN(t:fac, 0)
           if Incluido(Val(s:fac),Val(dz:16))
             ACN(t:fac, 1)
           endif

           ACT(bl:fac, FBN['TipoCliente'])
           ACT(bm:fac, FBN['CondicionGan'])
           ACT(bn:fac, FBN['CondicionIVA'])
           ACT(bo:fac, FBN['Res3125'])
           ACT(bp:fac, FBN['InteresesC'])
           ACT(bq:fac, FBN['Cotiza'])
           ACN(br:fac, FBN['TasaIntVigente'])
           ACD(bs:fac, FBN['FechaCambioTasa'])
           ACT(bt:fac, FBN['Valor10'])
           ACN(bu:fac, FBN['TasaIntAnterior'])
           ACT(bv:fac, FBN['Valor9'])
           ACT(bw:fac, FBN['DiasAnio'])
           ACT(bx:fac, FBN['DiasMes'])
           ACT(bz:fac, FBN['CallPut'])

           ACT(by:fac, 'Saldo')
           If EQSTR(fbn('CallPut'),'Fal')
              ACT(by:fac, 'Falla')
           Endif
           If EQSTR(fbn('CallPut'),'PRE')
              ACT(by:fac, 'Prestamo')
           Endif
           If EQSTR(fbn('CallPut'),'PAS')
              ACT(by:fac, 'Pase')
           Endif
           If EQSTR(fbn('CallPut'),'PEN')
              ACT(by:fac, 'Pend/Difer')
           Endif

           ACT(h:fac,'')
** FJL 01/08/2020 - Linea para referencia
           ACN(i:fac, fac)
    
** FJL 11/07/22 - Cuanta Vista para saldos bloquedas
           If Val(t:fac)=1
             * Es Saldo Bloqueado
             ACT(f:fac, Val(ml:1))
             ACT(h:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(m:fac)~"%') and Estado='HAB' and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
             ACT(q:fac, Val(h:fac))
             ACT(dh:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(dm:fac)~"%') and Estado='HAB' and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
             ACT(dq:fac, Val(dh:fac))
           else

** FJL 31/07/2020 - Se agrega 2do Mercado y Order By
*             SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~fbn('Cliente')~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB' AND (Mercado IS NULL OR Mercado='' OR Mercado='BCRA' OR Mercado='"~FBN('Mercado')~"') ") 
** FJL 26/10/2021 - Se agrega Mercado MERINT
*             SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~fbn('Cliente')~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB' AND (Mercado='"~Val(c:fac)~"' OR Mercado='"~Val(f:fac)~"') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ") 
** FJL 01/06/2023 - Se agrega TipoCuenta VIS
*             SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~fbn('Cliente')~"' AND TipoCuenta IN ('CC','CA') AND Estado='HAB' AND (Mercado='"~Val(c:fac)~"' OR Mercado in ("~Pipe2Comillas(Val(f:fac))~")) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ") 
             SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~fbn('Cliente')~"' AND TipoCuenta IN ('CC','CA','VIS') AND Estado='HAB' AND (Mercado='"~Val(c:fac)~"' OR Mercado in ("~Pipe2Comillas(Val(f:fac))~")) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ") 
             Recorrer SQL
              dfa
              **// If Vacio(val(h:fac)) y EspecieCuenta(Dialogo.Especie2,FBN['Codigo']) o Incluido(FBN['Especies'],'MONEDA') ] 
              **// Hay un corchete de mas, lo saco... (si agrego el corchete que falta cambia la ejecucion)
              If Vacio(val(h:fac)) y EspecieCuenta(Dialogo.Especie2,FBN['Codigo']) o Incluido(FBN['Especies'],'MONEDA')
                ACT(h:fac,FBN['Codigo'])
              EndIf
** FJL 01/08/2020 - Armo lista de cuentas validas
              If Incluido(Dialogo.Especie2,FBN['Especies']) o Incluido('MONEDA',FBN['Especies'])
                if NoVacio(Val(q:fac))
                  ACT(q:fac, Val(q:fac)~'|')
                endif
                ACT(q:fac, Val(q:fac)~FBN['Codigo'])
              endif
             Proximo
             if NoVacio(Val(dz3))
               if NoVacio(Val(q:fac))
                 ACT(q:fac, Val(q:fac)~'|')
               endif
               ACT(q:fac, Val(q:fac)~Val(dz3))
             endif

** FJL 27/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
             SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~fbn('Cliente')~"' AND TipoCuenta IN ('CC','CA','VIS') AND Estado='HAB' AND (Mercado='"~Val(c:fac)~"' OR Mercado in ("~Pipe2Comillas(Val(f:fac))~")) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ") 
             Recorrer SQL
              dfa
              If Vacio(val(dh:fac)) y EspecieCuenta(Val(dm:fac),FBN['Codigo']) o Incluido(FBN['Especies'],'MONEDA')
                ACT(dh:fac,FBN['Codigo'])
              EndIf
              If Incluido(Val(dm:fac),FBN['Especies']) o Incluido('MONEDA',FBN['Especies'])
                if NoVacio(Val(dq:fac))
                  ACT(dq:fac, Val(dq:fac)~'|')
                endif
                ACT(dq:fac, Val(dq:fac)~FBN['Codigo'])
              endif
