** FJL 10/12/21 - Se calculan las comisiones antes para mostrar en la ListBox
** uso el recorrer&i porque la funcion CACOMISION lo usa
*           MessageBox('FAC antes recorrer &i: '~FStr(fac,1,0))
           recorrer&i Val(fa:1),Val(fa:1)
             *- cl1: Cliente  
             *- ce1: Especie Original del Saldo 
             *- cv1: Vehiculo  
             *- cy1: Mercado  
             *- ct1: Tipo de Comision
             *- da: CallPut  
             *- db: FechaEj  
             *- dc: PrecioEj  
             *- de:Cuenta  
             *- sa2: Ultimo nro. de Cuota para insertar comisiones
             *- sa:3 Acumulador de Comisiones

             act(cl:1, Val(l:&i))
             act(cv:1, Val(aa:4))
             act(cy:1, Val(c:&i))
             act(da:1, '')
             act(db:1, '')
             acn(dc:1, 0)
             act(de:1, Val(h:&i))
             act(ce:1, Val(aa:14))

             acn(ci:1,0)
             acn(ci:2,0)
             acn(sa:2,0)
             acn(sa:3,0)
             acn(re:1,0)
             acn(re:2,0)
             acn(re:3,0)
             acn(ci:11,0)
             acn(ci:12,0)
*             MessageBox('FAC '~FStr(fac,1,0))
*             MessageBox('&i '~FStr(&i,1,0))
* FJL 20/12/21 - Saldos no pagan comision
*             If Not EqStr(val(bz:fac),'PAS') y Not EqStr(val(bz:fac),'PRE')
             if incluido(Val(s:fac),Val(dz:25))
               ACT(jp:FAC, 'NO COMI')
             endif
             If Vacio(Val(jp:fac)) y Not EqStr(val(bz:fac),'PAS') y Not EqStr(val(bz:fac),'PRE')
*               MessageBox('Calcula')
               * Comision 
               ACT(jq:fac, 'Calcula')
               ACN(jr:fac, Val(g:&i))
               ACN(js:fac, Val(s:&i))
               If val(pr:9)<>0 
                  Message('*- Calculo la comision de la Renta solamente para los Saldos <> 201 '~val(l:&i))
                  act(ct:1, Val(dz:4))
                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9)/100)
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))

                  ACT(jt:fac, Val(ct:1))
                  ACN(ju:fac, Val(cj:1))

                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)

                  acn(jg:fac, val(ck:1))
                  acn(jm:fac, val(sa:3))
               EndIf

               If val(pr:8)<>0 y Val(m:&i)<>Val(sl:1)+100 
                  Message('*- Calculo la comision de la Amortizacion solamente para los Saldos <> 201 '~val(l:&i))
                  act(ct:1, Val(dz:5))
                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:8)/100)
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))
 
                  ACT(jv:fac, Val(ct:1))
                  ACN(jw:fac, Val(cj:1))

                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)

                  acn(jh:fac, val(ck:1))
                  acn(jn:fac, val(sa:3)-val(jm:fac))
               EndIf
               
               *- ci2: Calculo del % del Iva sobre comisiones
               acn(ci:2, Num(Val(dz:10))+IIF(EQSTR(Val(bn:&i),'NOI'),Num(Val(dz:11)),IIF(EQSTR(Val(bo:&i),'SI'),Num(Val(dz:12)),0)))
               ACN(ji:fac, Val(ci:2))

               *- ci:1 Monto de Iva
               acn(ci:1, ROUND(Abs(val(sa:3))*Val(ci:2)/100,2))
               ACN(jj:fac, Val(ci:1))

               *-------------------------
               *- COMISION CAJA DE VALORES DE RENTA
               *- jo:fac Monto de la comision
* FJL 12/01/22 - La base para la comision de CV es ahora Renta+Amortizacion (Lautaro)
*               If val(pr:9)<>0 y Not EqStr(val(bz:&i),'PAS')
* FJL 22/12/23 - La base para la comision de CV cuelve a ser solo Renta (Lautaro)
*               If (val(pr:9)<>0 o val(pr:8)<>0) y Not EqStr(val(bz:&i),'PAS')
               If val(pr:9)<>0 y Not EqStr(val(bz:&i),'PAS')
                  act(ct:1, Val(dz:41))
* FJL 12/01/22 - La base para la comision de CV es ahora Renta+Amortizacion (Lautaro)
*                  acn(cj:1, Val(g:&i)*val(pr:9))
* FJL 22/12/23 - La base para la comision de CV cuelve a ser solo Renta (Lautaro)
*                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9)/100+Val(g:&i)*Val(pr:12)*val(pr:8)/100)
* FJL 26/02/24 - Comision CV cvuando se cobra en USD hay que convertirla a ARP
*                  acn(cj:1, Val(g:&i)*Val(pr:12)*val(pr:9)/100)
                  acn(cj:1, Val(g:&i)*Val(pr:12)*Val(pr:13)*val(pr:9)/100)
                  acn(hg:1, Val(g:&i))
                  acn(hs:1, Val(s:&i))

                  ACT(jx:fac, Val(ct:1))
                  ACN(jy:fac, Val(cj:1))
  
                  *- Funcion que recupera los montos de comisiones
                  (.'CACOMISION'.)
  
                  acn(jk:fac, val(ck:1))
                  acn(jo:fac, val(sa:3)-val(jm:fac)-val(jn:fac))
                  scn(sa:3, -val(jo:fac))
               EndIf
               
               *- ci12: Calculo del % del Iva sobre comisiones DE CAJA DE VALORES 
               acn(ci:12, Num(Val(dz:20)) )
               ACN(jl:fac, Val(ci:12))
               
               *- ci:11 Monto de Iva
               acn(ci:11,ROUND(Abs(val(jo:fac))*Val(ci:12)/100,2))            
               *-------------------------
 
               * si la comision es mayor que lo que pago
               * messagebox(Val(sa3)~'+'~Val(ci1))
               IF Val(sa:3)+Val(ci1)>Val(k:&i)
                  ACN(sa:3, ROUND(val(k:&i)/(1+Val(ci:2)/100),2))
                  ACN(ci:1, Val(k:&i)-Val(sa:3))
               ENDIF
               
               ACN(ja:fac, Val(sa:3))
               ACN(jb:fac, Val(ci:1))
** FJL 14/12/21 - Cambio campo comision
*               ACN(jc:fac, Val(sa:3))
               ACN(jc:fac, Val(jo:fac))
               ACN(jd:fac, Val(ci:11))

               ***---BC1 = %Bonif.Comision
               ***---SA4 = Comision Bonificada
               ***---SA5 = IVA Comision Bonificada
               IF Val(SA:3) <> 0 
                  ***---Hay Bonificacion sobre la comision
                  ACN(SA:4, Val(SA:3) - (Val(SA:3) * Val(BC:1) / 100))
               ELSE
                  ACN(SA:4, 0)
               ENDIF
               IF Val(CI:1) <> 0 
                  ***---Hay Bonificacion sobre el IVA comision
                  ACN(SA:5, Val(CI:1) - (Val(CI:1) * Val(BC:1) / 100))
               ELSE
                  ACN(SA:5, 0)
               ENDIF
             endif
           proximo
           
           SCN(ka:1, Val(ja:fac))
           SCN(ka:2, Val(jb:fac))
           if EqStr(Val(l:fac),VAR('VEHICULODE'))           
             SCN(ka:3, Val(jc:fac))
             SCN(ka:4, Val(jd:fac))
           else
             SCN(ka:5, Val(jc:fac))
             SCN(ka:6, Val(jd:fac))
           endif
        ELSE
           dfa
        ENDIF
   Proximo

   IF Val(z:1)<>0
      CrearListBox ; 'Arial,8,';'Saldos OK.'
         'OK'              ;a:Val(ha1)..a:val(z:1)  ;SI;;;30;CHECK;RGB(160,160,193);
         'Cliente'         ;l:Val(ha1)..l:val(z:1)  ;NO;;;90;STRING;
