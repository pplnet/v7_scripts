creardialogo
string1:'Path';;;;;;;;;'C:\'
string2:'Arch. Texto';;;;;;;;;'BONOS.WKS';
especie1:'Jerarquia';;;;;;NoVacio(dialogo.especie1);'indicar jerarquia';NO
radio1:'Tipo|Titulos|ONs|FCI|Acciones';;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

importarwks(a1..z:1000, a1..z:1000, dialogo.string1~dialogo.string2)

if (Vacio(Val(b1)))
Cancelar('No se ha podido recuperar el archivo wks')
endif

Act(z1, Query("select "~Dbo()~".SACAJERARQUIAESPECIE('"~dialogo.especie1~"') from dbo.ESPECIES"))



recorrer&i 2, 100
if (Vacio(Val(a:&i)))
break
endif

if (dialogo.radio1 = 0)
if (Val(h:&i) = 1)
Act(h:&i, 'CLE')
else
Act(h:&i, 'DIR')
endif
if (Val(o:&i) = 1)
Act(o:&i, '30')
else
if (Val(o:&i) = 2)
Act(o:&i, 'REA')
else
Act(o:&i, '30E')
endif
endif
if (Val(p:&i) = 1)
Act(p:&i, '360')
else
if (Val(p:&i) = 2)
Act(p:&i, '365')
else
Act(p:&i, 'REA')
endif
endif
if (Eqstr(Val(j:&i), 'MULTIPLES'))
Act(j:&i, 'CV')
endif
if (Query("select count(*) from "~Dbo()~".ESPECIES where Codigo='"~Val(a:&i)~"'") = 0 y Query("select count(*) from "~Dbo()~".ESPECIES where Nombre='"~Val(b:&i)~"'") = 0)
Act(z2, Pad(Val(z1)~Pad0(FStr(&i, 0, 0), 3), 15, '0'))
Sqladd(" INSERT "~Dbo()~".ESPECIES")
Sqladd(" (Codigo, Nombre, Cupon, Extendido, Cotiza")
Sqladd(",FEmision, Fecha, InteresesC, VTeorico, MercadoDef")
Sqladd(", ISIN, CUSIP, Cedel, EuroClear, DiasMes")
Sqladd(", DiasAnio, LaminaMinima, PaisOrigen, PlazoLiq, Indexado")
Sqladd(", Indice, ZeroCoupon, TasaIntVigente, Jerarquia, Tipo, Status) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(a:&i)~"','"~Val(b:&i)~"',"~FStr(Val(c:&i), 1, 0)~",'"~Val(d:&i)~"', '"~Val(e:&i)~"', ")
Sqladd(" '"~IdxDate(Val(f:&i))~"', '"~IdxDate(Val(g:&i))~"','"~Val(h:&i)~"',"~Val(i:&i)~", '"~Copy(Val(j:&i), 1, 6)~"', ")
Sqladd(" '"~Copy(Val(k:&i), 1, 12)~"', '"~Val(l:&i)~"','"~Val(m:&i)~"','"~Val(n:&i)~"', '"~Val(o:&i)~"', ")
Sqladd(" '"~Val(p:&i)~"', "~Val(q:&i)~",'"~Val(r:&i)~"',"~Val(t:&i)~", '"~Val(u:&i)~"', ")
Sqladd(" '"~Val(v:&i)~"', '"~Val(w:&i)~"',"~FStr(Val(x:&i), 1, 0)~",'"~Val(z2)~"', 'PUB', 'HAB') ")
Sqlnew()
Sqlexec()
else
Message(Val(a:&i)~' Ya existe ')
endif
endif

