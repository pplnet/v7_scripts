      Message(' Eliminando Limites Consumidos  ...')
      SQL.ADD("DELETE "~DBO~".LIMCONSUMIDOS Where")
      SQL.ADD(" Vehiculo  like 'SADE%' ")
      SQL.NEW

      Message(' Eliminando Posiciones  ...')
      SQL.ADD("DELETE "~DBO~".POSICIONES Where")
      SQL.ADD(" Vehiculo  like 'SADE%' ")
      SQL.NEW
      SQL.EXEC    

