Sqladd("update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   set Valor       = 0 ")
Sqladd(" where nrbit       = 12 ")
Sqladd("   and NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd("update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   set Valor       = 1 ")
Sqladd(" where nrbit       = 11 ")
Sqladd("   and NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd("update "~Dbo()~".TRANSACCIONES2 ")
Sqladd("   set Observaciones = null ")
Sqladd(" where NrTrans       = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqlexec()

