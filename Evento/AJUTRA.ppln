sql.add("update "~Dbo()~".OPERACIONESBITS ")
sql.add("   set Valor       = 0 ")
sql.add(" where nrbit       = 12 ")
sql.add("   and NrOperacion = '"~dialogo.nrtrans1~"' ")
sql.new

sql.add("update "~Dbo()~".OPERACIONESBITS ")
sql.add("   set Valor       = 1 ")
sql.add(" where nrbit       = 11 ")
sql.add("   and NrOperacion = '"~dialogo.nrtrans1~"' ")
sql.new

sql.add("update "~Dbo()~".TRANSACCIONES2 ")
sql.add("   set Observaciones = null ")
sql.add(" where NrTrans       = '"~dialogo.nrtrans1~"' ")
sql.new

sql.exec

