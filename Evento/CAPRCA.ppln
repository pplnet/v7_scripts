sql.add(" SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS ")
sql.add(" WHERE FechaMov = '"~IdxDate(BuscarCampo('OPERACIONES', 'FechaVto', 'NrOperacion', dialogo.nroperacion1))~"' AND NrSaldo = 1 ")
recorrer sql
Cancelar()('La operacion que seleccionó tiene una liquidación ya hecha. Anule la liquidación e intente de nuevo')
proximo


sql.add(" SELECT O.FechaOp, O.Plazo, O.FechaVto, O.Cantidad, O.Precio1 'Tasa', O.Precio3 'Tasa Penalidad', ")
sql.add(" O.TotalAux1 'Penalidad', O.Plazo3 'Plazo Ori', O.FechaVto2 'Vto Ori', O.Precio4 'Penalidad Ori',C.Cantidad3 'Interes', C.Cantidad10 'Interes Ori'")
sql.add(" FROM "~Dbo()~".OPERACIONES O JOIN "~Dbo()~".CUOTAS C ")
sql.add(" ON O.NrOperacion = C.NrOperacion ")
sql.add(" WHERE O.NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Acd(a:1, Fbn('FechaOp'))
Acn(b:1, Fbn('Plazo'))
Acd(c:1, Fbn('FechaVto'))
Acn(d:1, Fbn('Cantidad'))
Acn(e:1, Fbn('Tasa'))
Acn(f:1, Fbn('Interes'))
Acn(g:1, Fbn('Tasa Penalidad'))
Acn(h:1, Fbn('Penalidad'))
Acn(i:1, Fbn('Plazo Ori'))
Acd(j:1, Fbn('Vto Ori'))
Acn(k:1, Fbn('Interes Ori'))
Acn(l:1, Fbn('Penalidad Ori'))
proximo

crearlistbox;'Arial,8,';'Anulacion de Precancelacion '~dialogo.nroperacion1
'Fecha Op';a1;NO;SI;;80;fecha
'Plazo';b1;NO;SI;;60;numero;'##'
'Fecha Vto';c1;NO;SI;;80;fecha
