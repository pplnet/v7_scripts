creardialogo
nroperacion1: 'NrOperacion';;;;;;Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', nroperacion1), 'MMCPM') y Eqstr(BuscarCampo('OPERACIONES', 'CB7', 'NrOperacion', nroperacion1), '1') y Eqstr(BuscarCampo('OPERACIONES', 'RB10', 'NrOperacion', nroperacion1), '0');'Debe ingresar una operacion MMCPM precancelable que haya sido precancelada';NO;;;;;;"TipoOp = 'MMCPM' AND CB7 = 1"
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" WHERE FechaMov = '"~IdxDate(BuscarCampo('OPERACIONES', 'FechaVto', 'NrOperacion', dialogo.nroperacion1))~"' AND NrSaldo = 1 ")
recorrer sql
Cancelar('La operacion que seleccionó tiene una liquidación ya hecha. Anule la liquidación e intente de nuevo')
proximo


Sqladd(" SELECT O.FechaOp, O.Plazo, O.FechaVto, O.Cantidad, O.Precio1 'Tasa', O.Precio3 'Tasa Penalidad', ")
Sqladd(" O.TotalAux1 'Penalidad', O.Plazo3 'Plazo Ori', O.FechaVto2 'Vto Ori', O.Precio4 'Penalidad Ori',C.Cantidad3 'Interes', C.Cantidad10 'Interes Ori'")
Sqladd(" FROM "~Dbo()~".OPERACIONES O JOIN "~Dbo()~".CUOTAS C ")
Sqladd(" ON O.NrOperacion = C.NrOperacion ")
Sqladd(" WHERE O.NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Acd(a:1, Fbn('FechaOp'))
Acn(b:1, Fbn('Plazo'))
Acd(c:1, Fbn('FechaVto'))
Acn(d:1, Fbn('Cantidad'))
Acn(e:1, Fbn('Tasa'))
Acn(f:1, Fbn('Interes'))
Acn(g:1, Fbn('Tasa Penalidad'))
Acn(h:1, Fbn('Penalidad'))
Acn(i:1, Fbn('Plazo Ori'))
Acd(j:1, Fbn('Vto Ori'))
Acn(k:1, Fbn('Interes Ori'))
Acn(l:1, Fbn('Penalidad Ori'))
proximo

crearlistbox;'Arial,8,';'Anulacion de Precancelacion '~dialogo.nroperacion1
'Fecha Op';a1;NO;SI;;80;fecha
'Plazo';b1;NO;SI;;60;numero;'##'
'Fecha Vto';c1;NO;SI;;80;fecha
'Cantidad';d1;NO;SI;;100;numero;'###,###,###.##'
'Tasa ';e1;NO;SI;;100;numero;'##.########'
'Interes ';f1;NO;SI;;100;numero;'##,###,###.##'
'Tasa Penalidad';g1;NO;SI;;100;numero;'##.########'
'Penalidad';h1;NO;SI;;100;numero;'##,###,###.##'
'Plazo Ori';i1;NO;SI;;60;numero;'##';Exe('COLOR6')
'Vto Ori';j1;NO;SI;;80;fecha;Exe('COLOR6')
'Interes Ori';k1;NO;SI;;100;numero;'##,###,###.##';Exe('COLOR6')
'Penalidad Ori';l1;NO;SI;;100;numero;'##,###,###.##';Exe('COLOR6')
finlistbox

if (not ok)
Cancelar()
endif

Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
Sqladd(" Set FechaVto = FechaVto2, ")
Sqladd(" Plazo = Plazo3, ")
Sqladd(" CB7 = '0', ")
Sqladd(" TotalAux1 = 0, ")
Sqladd(" Precio3 = Precio4, ")
Sqladd(" FechaPrecan = null ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

Sqladd(" UPDATE "~Dbo()~".CUOTAS ")
Sqladd(" Set Cantidad3 = Cantidad10, ")
Sqladd(" Cantidad4 = Cantidad11, ")
Sqladd(" Cantidad5 = Cantidad7, ")
Sqladd(" Total5 = Total6, ")
Sqladd(" Cantidad6 = Cantidad8, ")
Sqladd(" Total3 = Total4, ")
Sqladd(" Total2 = Total7, ")
Sqladd(" Total1 = Total8, ")
Sqladd(" Fecha2 = '"~IdxDate(BuscarCampo('OPERACIONES', 'FechaVto2', 'NrOperacion', dialogo.nroperacion1))~"' ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' AND NrCuota = 1 ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientos3(dialogo.nroperacion1, SI, NO, NO, NO, SI)
Sqlnew()
Sqlexec()

Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 11, 'nroperacion1', dialogo.nroperacion1)

