Sqladd("select ")
Sqladd("M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.CallPut, ")
Sqladd("M.FechaEj, M.PrecioEj, M.EnteCustodia, M.NrSaldo, M.Mercado, ")
Sqladd("M.Leyenda, M.Bits, M.NrGrupo, M.Concepto, M.NrGrupo2, ")
