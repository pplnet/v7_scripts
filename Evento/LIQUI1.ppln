Sqladd("INSERT INTO "~Dbo()~".MOVEJECUTADOS ")
Sqladd("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
Sqladd("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
Sqladd("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
Sqladd("NrMov, NrLiq, Status, NrInstan, Cupon, ")
Sqladd("FechaEje, UsuarioEje, Cuenta, Transaccion, Cantidad, ")
Sqladd("NrTrans2 ")
Sqladd(") ")
Sqladd("select ")
Sqladd("M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.CallPut, ")
Sqladd("M.FechaEj, M.PrecioEj, M.EnteCustodia, M.NrSaldo, M.Mercado, ")
Sqladd("M.Leyenda, M.Bits, M.NrGrupo, M.Concepto, M.NrGrupo2, ")
Sqladd("M.NrMov, M.NrLiq, M.Status, M.NrInstan, M.Cupon, ")
Sqladd("'"~IdxDate(Hoy())~"', '"~UsuarioActivo()~"', M.Cuenta, M.Transaccion, M.Cantidad, ")
Sqladd("'"~Val(n:&i)~"' ")
Sqladd("from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
Sqladd("where M.NrOperacion = T.NrTrans")
Sqladd("and M.NrOperacion = B.NrOperacion")
if (dialogo.check5 = 0)
Sqladd("and M.NrOperacion = '"~Val(ca:&i)~"' ")
Sqladd("and M.NrMov = "~Val(y:&i))
endif
