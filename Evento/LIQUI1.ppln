Sqladd("Select M.FechaMov,      M.Cliente,       M.Especie,  M.Cupon,    ")
Sqladd("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
Sqladd("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
Sqladd("       T.TipoTr2 Tipo,  T.Mercado1 MercO ")
Sqladd("from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
Sqladd("where M.NrOperacion = T.NrTrans")
Sqladd("and M.NrOperacion = B.NrOperacion")
Sqladd("and M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("and M.Cliente = T.Cliente1 ")
Sqladd("and M.NrSaldo = 1 ")
if (dialogo.check10 = 0)
Sqladd("and M.Concepto <> 'OCT' ")
endif
Sqladd("and M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and M.Bits = 'MV' ")
if (NoVacio(dialogo.cliente1))
Sqladd("and M.Cliente = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.especie1))
Sqladd("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.mercado1))
Sqladd("and M.Mercado = '"~dialogo.mercado1~"' ")
endif
Sqladd("and T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND ((B.NrBit = 5 AND T.TipoTr2 <> 'LIQOCT') OR (B.NrBit = 2 AND T.TipoTr2 = 'LIQOCT')) ")
Sqladd("and B.Valor = '1' ")
Sqladd("Order By 2, 9, 10, 3, 4, 11, 1, 6")

