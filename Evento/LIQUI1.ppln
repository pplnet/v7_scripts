Sqladd("and M.Especie = '"~Val(j:&i)~"' ")
Sqladd("and M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("and M.Mercado = '"~Val(b:&i)~"'")
Sqladd("and M.NrSaldo = 1 ")
Sqladd("and M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and M.Bits = 'MV' ")
Sqladd("and (")
Sqladd("'"~FStr(Val(bk:&i), 1, 0)~"' = '0' ")
Sqladd("or ('"~FStr(Val(bk:&i), 1, 0)~"' = '1' and (M.Status = '' or Status is Null or M.Status = 'RVP'))")
Sqladd(")")
Sqladd("and T.Cliente1 = '"~Val(a:&i)~"' ")
Sqladd("and T.Mercado1 = '"~Val(b:&i)~"' ")
Sqladd("and T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("and ((B.NrBit = 5 AND '"~Val(tr:&i)~"' <> 'LIQOCT' ) OR (B.NrBit = 2 AND '"~Val(tr:&i)~"' = 'LIQOCT' )) ")
Sqladd("and B.Valor = '1' ")
Sqlnew()

