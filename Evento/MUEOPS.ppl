CrearDialogo
   Check1    :'Procesa'      ;;;;;;;;;1
FinDialogo

If Not Ok
   Cancelar
Endif
   
*   Updatea OPERACIONESBITS  Valor = 0 donde NrBit en (10) y OPERACIONESBITS  Valor = 1 donde NrBit en (70)
*   Si Operaciones no tiene movpendientes

SQL.ADD("Select B.NrOperacion from "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O ")
SQL.ADD("Where B.Valor = 1 ")
SQL.ADD("  and B.NrBit IN (10) ")
SQL.ADD("  and B.NrOperacion = O.NrOperacion ")
SQL.ADD("  and Not Exists (Select 1 FROM MOVPENDIENTES MP WHERE MP.NrOperacion = B.NrOperacion) ")

Recorrer
    Message('Moviendo operacion '~FBN(NrOperacion))
    SQL.ADD("Update "~DBO~".OPERACIONESBITS")
    SQL.ADD("Set Valor =  0 ")
    SQL.ADD("Where NrOperacion = "~FBN('NrOperacion')~" ")
    SQL.ADD("  and NrBit IN (10) ")
    SQL.NEW

    SQL.ADD("Update "~DBO~".OPERACIONESBITS")
    SQL.ADD("Set Valor =  1 ")
    SQL.ADD("Where NrOperacion = "~FBN('NrOperacion')~" ")
    SQL.ADD("  and NrBit IN (70) ")
    SQL.NEW

    SQL.EXEC    
Proximo

