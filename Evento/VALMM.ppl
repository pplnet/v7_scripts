CrearDialogo
  Fecha1        : "Fecha"    ;;;;;;
  NrOperacion1  : "NrOp"     ;;;;;;
FinDialogo

if not Ok
  Cancelar
endif

ACT(LI:5, SQLSet("Select NrOperacion+' '+TipoOp as Codigo From "~DBO~".OPERACIONES WHERE Convert(Char,FechaOp,20) <='"~Fecha(Dialogo.Fecha1,'YYYY-MM-DD')~"' and  Convert(Char,FechaVto,20) >'"~Fecha(Dialogo.Fecha1,'YYYY-MM-DD')~"' ORDER BY 1"))
ACT(LI:5, val(LI:5)~SQLSet("Select Distinct TipoOp as Codigo From "~DBO~".OPERACIONES WHERE Convert(Char,FechaOp,20) <='"~Fecha(Dialogo.Fecha1,'YYYY-MM-DD')~"' and  Convert(Char,FechaVto,20) >'"~Fecha(Dialogo.Fecha1,'YYYY-MM-DD')~"' ORDER BY 1 "))


LinkearHoja('000006',1,NrOperacion1=Dialogo.NrOperacion1,Fecha1=Dialogo.Fecha1,Lista1='',Lista3='',Label1='',Radio1=0,Radio2=0,Radio3=0,Radio4=0,Radio5=2,Label2='',Radio6=2,Radio7=2,Radio8=2,Radio9=2,Radio10=0,Label3='',Radio11=0,Radio12=0,Radio13=0,Radio14=0,Radio15=0,Label4='',Radio16=0,Radio17=0,Radio18=0,Radio19=0,Radio20=0,Lista4=Val(li:5),Lista5=Val(li:5),Lista6=Val(li:5),Lista7=Val(li:5),Lista8=Val(li:5))
