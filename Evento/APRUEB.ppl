CrearDialogo
    String1      : 'Riesgo'               ;;;;;;;;
    NrOperacion1 : 'Nr.Operacion'         ;;;;;;;;
    String2      : 'Aprobador'            ;;;;;;;;
    Entero1      : 'Aprobaciones'         ;;;;;;;;
    Entero2      : "Avanza/Retrocede"     ;;;;;;;;
FinDialogo

**Cant de aprobaciones que requiere el riesgo
ACN(A:1,QUERY("Select Aprobaciones From "~DBO~".RIESGOOPERACIONES Where Codigo = '"~Dialogo.String1~"'"))
**Cant de aprobaciones que posee la operacion
ACN(A:2,Dialogo.Entero1)

**AVANZAR OP
IF Dialogo.Entero2 = 1   
    IF Val(A:2)<Val(A:1)
        SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Aprobaciones='"~Fstr(Val(A:2)+1,1,0)~"' WHERE NrOperacion = '"~Dialogo.NrOperacion1~"'")
        ACN(A:2,Val(A:2)+1)
        IF Val(A:2)=1
            SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Aprobador1='"~Dialogo.String2~"' Where NrOperacion = '"~Dialogo.NrOperacion1~"'")
        ENDIF
        IF Val(A:2)=2
            SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Aprobador2='"~Dialogo.String2~"' Where NrOperacion = '"~Dialogo.NrOperacion1~"'")
        ENDIF
    ENDIF
    IF Val(A:2)=Val(A:1)
        SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor=1 Where NrBit = 19 and NrOperacion='"~Dialogo.NrOperacion1~"'")
        SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor=0 Where NrBit <> 19 and NrOperacion='"~Dialogo.NrOperacion1~"'")
    ENDIF
    SQL.NEW
    SQL.EXEC
ELSE
**RETROCEDER OP
    IF Dialogo.Entero2 = 2
        SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Aprobador1= Null, Aprobador2=Null,Aprobaciones = Null Where NrOperacion='"~Dialogo.NrOperacion1~"'")
        SQL.NEW
        SQL.EXEC
    ENDIF
ENDIF