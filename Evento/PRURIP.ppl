MostrarCuadroDeMensajes
*HOJAVISIBLE(SI)
CrearDialogo
  Fecha1 :"Fecha: " ;1;1;;NO;;;;;;FSYS
  String :'Path:  ' ;2;1;;;;NOVACIO(Dialogo.String);'Path Invalido';NO;VAR('DIRRIO');
  String3: 'Archivo';
  String2   :"Nuevo Directorio" ;;;;;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('RIOPROCES')
  Radio1:  '|W98|NT'   ;;;;;;;;;0
  Entero1: 'Registros' ;;;;;;;;;VAR('RIOREGISTR')
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(fi:1,0)
ACN(AA:1,0)

AbrirAscii(Dialogo.String~Dialogo.String3,0)
message(' Abriendo Archivo '~MIRT(TRIM(Dialogo.String))~Dialogo.String3)

* --- Recorre el archivo recibido como parametro para guardar en la hoja de FPA  --- *

Recorrer&i 1,1000000
    * Lee el registro
    ACT(x:1, LEERASCII)
    ACT(x:1, mirt(trim(Val(x:1))))
    * Guardo la fila por donde voy
    ACN(fi:1, &i)
    ACN(fi:2, &i)

    * Si esta vacio se va
    If Vacio(val(x:1))
       Break  
    Endif

    ACN(fi:3, 1)

    * Si es un registro de inicio

    If Val(e:1)=Dialogo.Entero1
       ACN(d:&i, 1)
       ACN(e:1, 1)
    Else
       ACN(d:&i, 0)
       SCN(e:1, 1)
    Endif

    If Incluido(Copy(Val(x:1),45,8),'Extracto') o Val(d:&i)=1
       * ----- Crea un nombre de archivo nuevo

       If Val(d:&i)=0
          ACT(c:1,Val(x:1))
       Endif

       ACT(nu:1, GetNumerador(10106))

       * --- Pregunta por el tipo de Archivo y crea el nombre correspondiente --- *

       * --- Nombre del archivo a generar
       ACT(a:&i, 'ExtractoRIO'~fstr(NUM(Val(nu:1)),0,0)~'.CSV')

       * --- Registro de Datos
       ACT(b:&i,  Val(x:1))
       ACT(f:1,  'Extracto')
       ACT(g:&i,Val(c:1)) 
       ACN(aa:1,1)

       message('Registro '~fstr(Val(aa:1),0,0))
    Else

      * --- Registro de Datos
      ACT(b:&i, Val(x:1))

      SCN(aa:1,1)
      message('Registro '~fstr(Val(aa:1),0,0))
    Endif
Proximo

CerrarAscii


* --- Guarda los registros de la Hoja de FPA en Archivos --- *

Recorrer&i 1, Val(fi:2)

 If NoVacio(Val(a:&i)) 
    If &i<>1
       EscribirAscii('F')
       * --- Como no es el primero lo cierro
       CerrarAscii
    Endif

******-------------25/08/2004    AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(a:&i),0)
    AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(a:&i),0)
    message('Nuevo archivo: '~MIRT(TRIM(Dialogo.String))~Val(a:&i))
    If Val(d:&i)=1
       * --- Graba el encabezado
       EscribirAscii(Val(g:&i))
    Endif
    EscribirAscii(Val(b:&i))
 Else
    If NoVacio(Val(b:&i))
       If Val(d:&i)=1
          * --- Graba el encabezado
         EscribirAscii(Val(g:&i))
       Endif
       EscribirAscii(Val(b:&i))
    Endif
 Endif
Proximo
CerrarAscii

* ------------------------------------------------------------------------ *
* Largo del nombre del archivo recibido como parametro (el que se guardo en la hoja FPA)
ACN(ar:2, Longitud(Dialogo.String3))

* Le resto el .dat 
ACN(ar:3, Val(ar:2)-4)

* Guardo el nombre sin extension
ACT(ar:4, COPY(Dialogo.String3,1,Val(ar:3)))

* Guardo el nombre con fecha hora y extension
ACT(ar:1, Val(ar:4)~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".CSV")
* ------------------------------------------------------------------------ *

If Dialogo.Radio1=0
  *W98
  * --- Copia el archivo en Procesados
  * Copia el archivo en Procesados
  WinExec("COMMAND.COM /C COPY  "~MIRT(TRIM(Dialogo.String))~Dialogo.String3~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
  Esperar(5)

  * --- Borra el archivo Procesado
  WinExec("COMMAND.COM /C del   "~MIRT(TRIM(Dialogo.String))~Dialogo.String3,0)
  Esperar(5)
Else
  * NT
  * --- Copia el archivo en Procesados
  WinExec("CMD.EXE /C COPY  "~MIRT(TRIM(Dialogo.String))~Dialogo.String3~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
  Esperar(5)

  * --- Borra el archivo Procesado
  WinExec("CMD.EXE /C del   "~MIRT(TRIM(Dialogo.String))~Dialogo.String3,0)
  Esperar(5)
Endif
