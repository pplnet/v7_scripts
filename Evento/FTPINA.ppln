creardialogo
radio1:'Sist.Oper.|W98|NT';1;1;;;;;;;1;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(so1, "COMMAND.COM /C ")
else
Act(so1, "CMD.EXE /C ")
endif

Message('Eliminando archivos Texto')

Message('Eliminando archivos Texto '~Var('CAPTRF')~'\SIAGCAP.TXT')
winexec(Val(so1)~" del "~Var('CAPTRF')~'\SIAGCAP.TXT', 0)
esperar(5)

winexec(Val(so1)~" del "~Var('CAPTRF')~'\MVINCAP.bat', 0)
esperar(5)

Message('Construyendo linea FTP '~Var('CAPTRF')~'\SIAGCAP.TXT')
abrirascii(Var('CAPTRF')~'\SIAGCAP.TXT', 0)

Act(t1, " "~Var('TECOUSR')~" ")
escribirascii(Val(t1))

Act(t1, " "~Var('TECOPASW')~" ")
escribirascii(Val(t1))

Act(t1, "lcd "~Var('CAPTRF')~" ")
escribirascii(Val(t1))

Act(t1, "cd "~Var('CAPDESTI')~" ")
escribirascii(Val(t1))

Acd(fe:1, FSys())
Act(fe:2, Copy(FStr(Trunc((Anio(Val(fe:1)) / 100) + 1), 0, 0), 2, 1))
Act(fe:2, Val(fe:2)~Copy(FStr(Anio(Val(fe:1)), 4, 0), 3, 2))
Act(fe:2, Val(fe:2)~Pad0(FStr(DifDias(Val(fe:1), Fecha('01/01/'~FStr(Anio(Val(fe:1)), 4, 0)), 'ARG', NO) + 1, 0, 0), 3))




sql.add("Select Codigo from "~Dbo()~".VEHICULOS Where ")
sql.add("Codigo Not In ('"~Var('VEHIADISC')~"')")
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add("and Codigo IN (SELECT Vehiculo from "~Dbo()~".USRVEHICULO WHERE Codigo='"~UsuarioActivo()~"') ")
endif


Acn(ct1, 0)

recorrer sql
Dfa()
Act(vh:2, Pad(Copy(Fbn('Codigo'), 1, 1), 1))

Act(v2, Var('CAPTRF')~"\S"~Val(vh:2)~Copy(Val(fe:2), 2, 5)~'*.txt')
Act(v3, primerarchivo(Val(v2)))

if (not ok)
break
else
abrirascii(Var('CAPTRF')~'\MVINCAP.bat', 0)
escribirascii('Move '~Val(v2)~' '~Var('CAPTRFPRO'))
cerrarascii

abrirascii(Var('CAPTRF')~'\SIAGCAP.TXT', 0)

Act(t1, "put "~Val(v3)~" ")
escribirascii(Val(t1))

Acn(ct1, 1)

recorrer&j 1, 100
Act(v3, proximoarchivo)
if (not ok)
break
else
Act(t1, "put "~Val(v3)~" ")
escribirascii(Val(t1))
endif
proximo
endif
proximo

Act(t1, "close ")
escribirascii(Val(t1))

Act(t1, "quit ")
escribirascii(Val(t1))
cerrarascii

if (Val(ct1) = 1)
winexec("ftp -v -i -s:"~Var('CAPTRF')~"\SIAGCAP.TXT "~Var('TECOAS400'))
endif


Message('Eliminando Archivos Texto ')
winexec(Val(so1)~" del  "~Var('CAPTRF')~'\HGIACAP.TXT', 0)
esperar(5)

abrirascii(Var('CAPTRF')~'\HGIACAP.TXT', 0)

Act(t1, " "~Var('PERSUSR')~" ")
escribirascii(Val(t1))

Act(t1, " "~Var('PERSPASW')~" ")
escribirascii(Val(t1))

Act(t1, "lcd "~Var('CAPTRF')~" ")
escribirascii(Val(t1))

Act(t1, "cd "~Var('CAPDESTI')~" ")
escribirascii(Val(t1))

Acd(fe:1, FSys())
Act(fe:2, Copy(FStr(Trunc((Anio(Val(fe:1)) / 100) + 1), 0, 0), 2, 1))
Act(fe:2, Val(fe:2)~Copy(FStr(Anio(Val(fe:1)), 4, 0), 3, 2))
Act(fe:2, Val(fe:2)~Pad0(FStr(DifDias(Val(fe:1), Fecha('01/01/'~FStr(Anio(Val(fe:1)), 4, 0)), 'ARG', NO) + 1, 0, 0), 3))




Acn(ct2, 0)

sql.add("Select Codigo,Valor3 from "~Dbo()~".VEHICULOS Where ")
sql.add("Codigo In ('"~Var('VEHIADISC')~"')")
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" and Codigo IN (SELECT Vehiculo from "~Dbo()~".USRVEHICULO WHERE Codigo='"~UsuarioActivo()~"') ")
endif

recorrer sql
Dfa()

Act(vh:2, Pad(Copy(Fbn('Codigo'), 1, 1), 1))

Act(v2, Var('CAPTRF')~"\S"~Val(vh:2)~Copy(Val(fe:2), 2, 5)~'*.txt')
Act(v3, primerarchivo(Val(v2)))

if (not ok)
break
else
abrirascii(Var('CAPTRF')~'\MVINCAP.bat', 0)
escribirascii('Move '~Val(v2)~' '~Var('CAPTRFPRO'))
cerrarascii

abrirascii(Var('CAPTRF')~'\HGIACAP.TXT', 0)

if (not ok)
Acn(ct1, 1)
else
Acn(ct2, 1)

Act(t1, "put  "~Val(v3)~" ")
escribirascii(Val(t1))

recorrer&j 1, 100
Act(v3, proximoarchivo)

if (not ok)
break
else
Act(t1, "put  "~Val(v3)~" ")
escribirascii(Val(t1))
endif
proximo
endif
endif
proximo

Act(t1, "close ")
escribirascii(Val(t1))

Act(t1, "quit ")
escribirascii(Val(t1))

cerrarascii

if (Val(ct2) = 1)
winexec("ftp -v -i -s:"~Var('CAPTRF')~"\HGIACAP.TXT "~Var('PERSAS400'))
endif

esperar(5)

if (Val(ct2) = 1 o Val(ct1) = 1)
winexec(Var('CAPTRF')~'\MVINCAP.bat')
endif

