MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
lista1: 'Vehiculos';3;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
listatabla1: 'Operaciones';-3;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';;;;NO;NO;
findialogo

if (not ok)
Cancelar()
endif

Message('--- Asientos de Vencimiento ---')

Sqladd(" SELECT O.NrOperacion, O.Especie, O.FechaOp, O.Cliente1, O.ContraEspecie, C.Fecha2, C.Cantidad3, C.Cantidad12, ")
Sqladd(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, V.Valor1, V.Valor2, ")
Sqladd(" MA.Codigo CodAsi, O.CB9, O.CB10, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, ")
Sqladd(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, V.Alias4, ")
Sqladd(" O.Especie Moneda, O.Cuenta2, O.ViaPago1, O.Indice, O.Precio5, O.Precio6  ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C, "~Dbo()~".VEHICULOS V, ")
Sqladd(" "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MODELOSASIENTO MA")
Sqladd(" WHERE O.NrOperacion    =  C.NrOperacion ")
Sqladd(" AND   O.Vehiculo1   =  V.Codigo ")
Sqladd(" AND   O.TipoOp IN ('MMONM') ")
Sqladd(" AND   O.RB7 = 1 ")
Sqladd(" AND   O.NrOperacion =  B.NrOperacion  ")
Sqladd(" AND   B.Valor       =  '1'      ")
Sqladd(" AND   O.TipoOp      = MA.TipoOp ")
Sqladd(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIVTO'))~") ")
Sqladd(" AND   C.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" ORDER BY O.NrOperacion ")

recorrer sql
Acd(fv:1, Fbn('Fecha2'))
Act(vh:1, Fbn('Vehiculo1'))
Acn(im:1, Query(" Select Sum(Cantidad4) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(fv:1) + Var('PLCAPCORR'))~"' AND Fecha2 > '"~IdxDate(Val(fv:1))~"' "))
Acn(im:2, Query(" Select Sum(Cantidad4) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(fv:1) + Var('PLCAPCORR'))~"'  "))
Acn(im:3, Val(im:1) + Val(im:2))
Acn(pr:1, Val(im:1) / Val(im:3))
Acn(pr:2, Val(im:2) / Val(im:3))
Acn(pk:1, Fbn('Cantidad12') * Val(pr:1))
Acn(pk:2, Fbn('Cantidad12') * Val(pr:2))



Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Fbn('FechaOp'))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo

