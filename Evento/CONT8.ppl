MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;3;1;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif

ACT(VC:1, Dialogo.Vehiculo1)
ACN(NA:1, Var('ASINUM'))

ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))
IF Dialogo.Radio1 = 2 O Dialogo.Radio1 = 4
    #ifdef MLASA
        message('--- Asientos MTM Diario No ROFEX ---')
        ACT(TA:1, Var('TIPASIMTM'))
        ACN(XX:1,0)
        ACN(XX:2,0)
        SQL.ADD(" SELECT MO.MTM as Cantidad, O.NrOperacion, O.TipoOp, MO.Fecha Fecha, O.Vehiculo1, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
        SQL.ADD( "C.PaisDir, O.Cuenta4 as Cuenta1, 0 as Monto, O.ContraEspecie as ContraEspecie, O.Especie, O.FechaOp, ")
        SQL.ADD(" '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, O.Cliente1 Cliente, O.Book1   ")
        SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".CLIENTES C, "~DBO~".MTMDIARIO MO ")
        SQL.ADD(" WHERE  C.Codigo  = O.Cliente1 and MO.NrOperacion=O.NrOperacion and MO.TipoMTM = 'MTM' ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp AND MA.TipoAsiento = '"~Val(TA:1)~"' ") 
        SQl.ADD(" AND O.TipoOp in ('FXCF','FXVF') ")
        SQL.ADD(" AND MO.Fecha = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND O.FechaVto <> '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND MO.Fecha >= '"~IdxDate(val(FE:1))~"' ")
        SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        SQL.ADD(" AND O.Mercado4 <> '"~Var('MERROFEX')~"' ")
        SQL.ADD(" AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
        watch (SQL.batch)
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACN(RE:1, fbn('Cantidad'))
          ACT(NR:1, fbn('NrOperacion'))
          ACT(NR:2, '')  
          ACT(CT:1,SQL("Select Cuenta from "~DBO~".RELACIONCUENTA   where Book = '"~fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~fbn('TipoOp')~"%' "))
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo

        message('--- Asientos MTM Diario Consolidado ROFEX ---')
        ACT(TA:1, Var('TIPASIMTM'))
        SQL.ADD(" Select Sum(MO.MTM) as Cantidad,Fecha,O.TipoOp, '"~Var('MERROFEX')~"' as Mercado4,MA.Codigo as CodAsi, O.Vehiculo1 , ")
        SQL.ADD(" '' as NrOperacion,O.Especie, 'MTM de ROFEX' as Leyenda ")
        SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".CLIENTES C, "~DBO~".MTMDIARIO MO ")
        SQL.ADD(" Where C.Codigo  = O.Cliente1 and MO.NrOperacion=O.NrOperacion and MO.TipoMTM = 'MTM' ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp AND MA.TipoAsiento = '"~Val(TA:1)~"' AND O.TipoOp in ('FXCF','FXVF') ")
        SQL.ADD(" AND MO.Fecha = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND O.FechaVto <> '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND MO.Fecha >= '"~IdxDate(val(FE:1))~"' ")
        SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        SQL.ADD(" AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
        SQL.ADD(" AND O.Mercado4 = '"~Var('MERROFEX')~"' ") 
        SQL.ADD("Group by MO.Fecha, O.TipoOp, MA.Codigo, O.Vehiculo1, O.Especie ")
        watch(sql.batch())
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACN(RE:1, fbn('Cantidad'))
          ACT(NR:1, fbn('NrOperacion'))
          ACT(NR:2, '')  
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo
        message('--- Asientos Fixing NO ROFEX---')
        ACT(TA:1, Var('TIPASIFIX'))
        SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, MO.Fecha Fecha, O.Vehiculo1, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
        SQL.ADD(" C.PaisDir, O.Cuenta4 as Cuenta1, O.Cliente1 Cliente, ")
        SQL.ADD(" Case When O.Mercado4 = '"~Var('MERROFEX')~"' Then MO.MTM Else MO.MTMEspecie End Cantidad,  ")
        SQL.ADD(" O.ContraEspecie, O.Especie, O.FechaOp, ")
        SQL.ADD(" '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, O.Book1,")
        SQL.ADD("  (Select sum(MTM) from "~DBO~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' ) as AcumMTM, ")
        SQL.ADD(" Case When O.Mercado4 = '"~Var('MERROFEX')~"' Then 0 Else (Select sum(MTMEspecie) from "~DBO~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'MTM') End AcumEspMTM ")
        SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".CLIENTES C, "~DBO~".MTMDIARIO MO ")
        SQL.ADD(" Where C.Codigo = O.Cliente1 and MO.NrOperacion=O.NrOperacion and MO.TipoMTM = 'FIX' ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp AND MA.TipoAsiento = '"~Var('TIPASIFIX')~"' AND O.TipoOp in ('FXCF','FXVF') ")
        SQL.ADD(" AND MO.Fecha = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND MO.Fecha >= '"~IdxDate(val(FE:1))~"' ")
        SQL.ADD(" AND O.FechaVto = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
        SQL.ADD(" AND O.Mercado4 <> '"~Var('MERROFEX')~"' ") 
        SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        watch(sql.batch())
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACN(CO:1, IIF(EqStr(fbn('Mercado4'),Var('MERROFEX')),1,SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo='"~fbn('Especie')~"' and Fecha="~IdxDate2(fbn('Fecha'))~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' ")))
          ACN(RE:1, (fbn('Cantidad')-fbn('AcumEspMTM'))*Val(CO:1))
          ACN(CK:1, 0)
          ACT(CT:1,SQL("Select Cuenta from "~DBO~".RELACIONCUENTA   where Book = '"~fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~fbn('TipoOp')~"%' "))  
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo

        message('--- Asientos Fixing Consolidado ROFEX ---')
        ACT(TA:1, Var('TIPASIFIX'))
        SQL.ADD(" Select Sum(Cantidad) as Cantidad, TipoOp, Fecha, Vehiculo1, ")
        SQL.ADD(" CodAsi, Mercado4, Especie, '' as NrOperacion, 'FIX de ROFEX' as Leyenda from ( ")
        SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, MO.Fecha Fecha, O.Vehiculo1, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
        SQL.ADD(" C.PaisDir, O.Cuenta4 as Cuenta1, Case When O.Mercado4 = '"~Var('MERROFEX')~"' Then MO.MTM Else MO.MTMEspecie End Cantidad,  O.ContraEspecie as ContraEspecie, O.Especie, O.FechaOp ")
        SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".CLIENTES C, "~DBO~".MTMDIARIO MO ")
        SQL.ADD(" WHERE  C.Codigo  = O.Cliente1 and MO.NrOperacion=O.NrOperacion and MO.TipoMTM = 'FIX' ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp AND MA.TipoAsiento = '"~Val(TA:1)~"' AND O.TipoOp in ('FXCF','FXVF') ")
        SQL.ADD(" AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
        SQL.ADD(" AND MO.Fecha = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND O.FechaVto = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND MO.Fecha >= '"~IdxDate(val(FE:1))~"' ")
        SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        SQL.ADD(" AND O.Mercado4 = '"~Var('MERROFEX')~"') as Aux ") 
        SQL.ADD("Group by TipoOp,Fecha,Vehiculo1,CodAsi, Mercado4, Especie ")
        watch(sql.batch())
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACN(RE:1, fbn('Cantidad'))
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo
    #else
        message('--- Asientos MTM ---')
        **Cintia Ene-2025 se agrega variable por asiento de Reval. FM Diario
        ACT(TA:1, Var('TIPASMTMDI')~'|'~ Var('TIPASRFMD'))
        **
        SQL.ADD(" Select Sum(MTM) as MTM, TipoOp, Fecha, Vehiculo1,TotalBrutoCli1, ")
        SQL.ADD(" CodAsi, Mercado4, Especie, NrOperacion as NrOperacion, 'FIX de ROFEX' as Leyenda, MonedaLiq, Cliente1, Cliente1 Cliente, RB10,MonLiqFut from ( ")
        SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, MO.Fecha Fecha, O.Vehiculo1, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4,TotalBrutoCli1, ")
        *SQL.ADD(" C.PaisDir, O.Cuenta4 as Cuenta1, Case When O.Mercado4 = '"~Var('MERROFEX')~"' Then MO.MTM Else MO.MTMEspecie End Cantidad,  O.ContraEspecie as ContraEspecie, O.Especie, O.FechaOp ")
        SQL.ADD(" C.PaisDir, O.Cuenta4 as Cuenta1, CASE WHEN O.TasaEspecie='' OR O.ContraEspecie=O.TasaEspecie THEN MO.MTM ELSE MO.MTMEspecie END MTM,  O.ContraEspecie as ContraEspecie, O.Especie, O.FechaOp ")
        SQL.ADD(" ,CASE O.TasaEspecie WHEN '' THEN O.ContraEspecie ELSE O.TasaEspecie END MonedaLiq, O.Cliente1, O.RB10,CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut ")
        SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
        SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
        SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON C.Codigo  = O.Cliente1 ") 
        SQL.ADD("       INNER JOIN "~DBO~".MTMDIARIO MO ON MO.NrOperacion=O.NrOperacion ") 
        SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
        SQL.ADD(" WHERE MA.TipoAsiento IN ("~Pipe2Comillas(Val(TA:1))~") AND O.TipoOp in ('FXCF','FXVF') ")
        SQL.ADD(" AND B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
        SQL.ADD(" AND MO.Fecha = '"~IdxDate(Dialogo.fecha1)~"' ")
        SQL.ADD(" AND MO.Fecha >= '"~IdxDate(val(FE:1))~"' ")
        SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI') a ")
        SQL.ADD("Group by TipoOp,Fecha,Vehiculo1,CodAsi, Mercado4, Especie, NrOperacion, MonedaLiq,Cliente1, RB10,MonLiqFut,TotalBrutoCli1 ")
        watch(sql.batch())
        Recorrer SQL
          **Cintia 180924 - Issue 7512
          If #ESBACS
            let &mercNeg ''
          Else
            let &mercNeg #MERCNEGO
          Endif
          **
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACN(RE:1, fbn('MTM'))
          ACN(CK:1, 0)
          let &esNDF Iif(fbn('RB10')=1, SI, NO) 
          **Cintia Feb2025 - se setea el total MTM de la Op para sumar al asiento de VTO
          let &signoMTM 1
          IF NOT #ESCP y #ESNDFMER
              let &signoMTM (-1)
          Endif
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          let &codAsi fbn('CodAsi')
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(&codAsi, fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo         
    #endif
ENDIF
