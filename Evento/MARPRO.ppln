creardialogo
nroperacion1:'Operacion'
nroperacion2:'Operacion Prorrogada'
findialogo
if (not ok)
Cancelar()
endif


Sqladd("Select NrCuota, Radio1, Cantidad9 ")
Sqladd("  From "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Sqladd("Update "~Dbo()~".CUOTAS ")
Sqladd("   Set Radio1      = '"~Fbn('Radio1')~"', ")
Sqladd("       Cantidad9   = "~FStr(Fbn('Cantidad9'), 0, 0)~" ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion2~"' ")
Sqladd("   AND NrCuota     = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
Sqlnew()
Sqlexec()

Sqladd(" Select NrOperacion3, TipoOp ")
Sqladd("   From "~Dbo()~".OPERACIONES ")
Sqladd("  Where NrOperacion = '"~dialogo.nroperacion2~"' ")
recorrer sql
if (Eqstr(Fbn('TipoOp'), 'MMPCCM'))
Act(nr:3, Fbn('NrOperacion3'))
Sqladd("Select NrCuota, Radio1, Cantidad9 ")
Sqladd("  From "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Sqladd("Update "~Dbo()~".CUOTAS ")
Sqladd("   Set Radio1    = '"~Fbn('Radio1')~"', ")
Sqladd("       Cantidad9 = "~FStr(Fbn('Cantidad9'), 0, 0)~" ")
Sqladd(" Where NrOperacion = '"~Val(nr:3)~"' ")
Sqladd("   AND NrCuota     = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
Sqlnew()
proximo
endif
