creardialogo
cliente1: 'Ciente'
findialogo


if (not ok)
Cancelar()
endif




Sqladd(" SELECT NrMAE, NrBYMA, NrRofex, TipoCliente, CodigoCNV, ")
Sqladd(" Case CatPrestamosBCRA when 'NOR' then 0 when 'RPO' then 1 when 'CPR' then 2 when 'IRR' then 3 when 'IRA' then 4 end CatPrestamosBCRA FROM dbo.CLIENTES ")
Sqladd("Where codigo='"~dialogo.cliente1~"'")

recorrer sql
Act(a:fac, Fbn('NrMAE'))
Act(b:fac, Fbn('NrBYMA'))
Act(c:fac, Fbn('NrRofex'))
Act(d:fac, Fbn('TipoCliente'))
Act(e:fac, Fbn('CodigoCNV'))
Acn(f:fac, Fbn('CatPrestamosBCRA'))

proximo

crearlistbox;'Arial,8,'
'Nro. Mae';a1..a:fac;SI;;;60;string;3
'Nro. BYMA';b1..b:fac;SI;;;70;string;3
'Nro. Rofex';c1..c:fac;SI;;;80;string;5
'Tipo Cliente';d1..d:fac;SI;;;100;tabla;'TIPOSCLIENTE';'Codigo';'Codigo;Descripcion';
'CodigoCNV';e1..e:fac;SI;;;150;string;20
'Cat.Prest BCRA';f1..f:fac;SI;;;100;combo;'Normal|Riesgo Bajo|Riesgo Medio|Riesgo Alto|Irrecuperable|';

finlistbox

if (ok)
recorrer&i 1, Fac()
Sqladd("Update dbo.CLIENTES set ")
Sqladd("NrMAE='"~Val(a:&i)~"', ")
Sqladd("NrBYMA='"~Val(b:&i)~"', ")
Sqladd("NrRofex='"~Val(c:&i)~"', ")
Sqladd("TipoCliente='"~Val(d:&i)~"', ")
Sqladd("CodigoCNV='"~Val(e:&i)~"', ")
Sqladd("CatPrestamosBCRA='"~iif (Val(f:&i) = 0, 'NOR', iif (Val(f:&i) = 1, 'RPO', iif (Val(f:&i) = 2, 'CPR', iif (Val(f:&i) = 3, 'IRR', 'IRA'))))~"' ")
Sqladd("Where codigo='"~dialogo.cliente1~"'")
Sqlnew()
Sqlexec()

proximo
endif
Messagebox('El evento ha finalizado')

