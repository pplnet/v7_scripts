* DPEJBD: Ejercicio de Barrier Option Diaria
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Entero1      : "Nro.Settlement"           ;;;;;;Dialogo.Entero1>0;'El Nro. de Settlement es Incorrecto';NO
  Fecha1       : "F Real Ej."               ;;;;NO;;Dialogo.Fecha1>=Dialogo.Fecha4;'La Fecha de Ejercicio Real para esta Operacion es Invalida';NO;Fsys
  Precio2      : "Precio_Prom"              ;;;;;;Dialogo.Precio2<>0;'Indique el Precio Promedio';NO; ; ;;;"###,###,###.########"
  Precio4      : 'Knock'                    ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoCambio2','NrOperacion',Dialogo.NrOperacion1) 
  Entero2      : "Doas_Ejercio"             ;;;;;;Dialogo.Entero2<=Dialogo.Entero3;'La Cant. de Doas en que se Ejercio no debe superar los Doas Habiles del Settlement';NO;
  Especie1     : "Commodity"                ;1;2;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Ej"                 ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Ej"                ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Call|Put"            ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : "    |Compra|Venta"        ;;;;NO;;;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
  Radio4       : 'Barrera|UpIn|UpOut|DownIn|DownOut'         ;;;;NO;;;;;0;BuscarCampo('Operaciones','MB4','NrOperacion',Dialogo.NrOperacion1)
  Entero3      : "Dias_Habiles"             ;;;;NO;;;;;;SQL("Select Plazo2 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DPBOD|')
   Cancelar('La operacion No '~Dialogo.NrOperacion1~' No es un Barrier Option Simple')
endif


* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

* Verifico que no se haya pasado la fecha de liquidacion
(.'DCFMODI'.)

If Dialogo.Fecha1>VAL(D1)
   Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
EndIf

If OK
   * La Ejerce y Genera Resultado
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".CUOTAS ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")

*    SQL.ADD("and (Precio1 is Null or Precio1=0) ")

   Recorrer SQL
     acn(x1,1)

     IF [Dialogo.Radio2=0 y Dialogo.Precio2>=Dialogo.Precio3] o [Dialogo.Radio2=1 y Dialogo.Precio2<=Dialogo.Precio3]
       * Verifico la condicion de ejercicio

        *-- Calculo el Resultado por Unidad    
        IF Dialogo.Radio2=0 
           *---- CALL
           IF Dialogo.Radio4=3
              *-- Down&Out -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-Dialogo.Precio3))
              ENDIF
           ENDIF

           IF Dialogo.Radio4=2
              *-- Down&In -> PrecioReal<=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-Dialogo.Precio3))
              ENDIF
           ENDIF

           IF Dialogo.Radio4=1
              *-- Up&Out -> PrecioReal <=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-Dialogo.Precio3))
              ENDIF
           ENDIF

           IF Dialogo.Radio4=0
              *-- Up&In -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio2-Dialogo.Precio3))
              ENDIF
           ENDIF
        ELSE 
           *---- PUT
           IF Dialogo.Radio4=3
              *-- Down&Out -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio3-Dialogo.Precio2))
              ENDIF
           ENDIF
 
           IF Dialogo.Radio4=2
              *-- Down&In -> PrecioReal<=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio3-Dialogo.Precio2))
              ENDIF
           ENDIF
 
           IF Dialogo.Radio4=1
              *-- Up&Out -> PrecioReal <=Knock
              IF Dialogo.Precio2<=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio3-Dialogo.Precio2))  
              ENDIF
           ENDIF

           IF Dialogo.Radio4=0
              *-- Up&In -> PrecioReal >=Knock
              IF Dialogo.Precio2>=Dialogo.Precio4
                 ACN(Z3,(Dialogo.Precio3-Dialogo.Precio2))
              ENDIF
           ENDIF
        ENDIF
     
        IF Dialogo.Radio3=1
           * Si es Venta Multiplico por -1
           ACN(Z3,-VAL(Z3))
        ENDIF

        IF VAL(Z3)<>0 y  Dialogo.Entero2=0 
            Cancelar('Si desea Ejercer La operacion debe indicar la Cantidad de Dias en que se Ejercio  ....')  
        ENDIF

        IF VAL(Z3)=0 
           Acn(a1,MessageBox('Con Este Floating Price la Operacion No ser# Ejercida !!',2,1))
        ENDIF

        If val(a1)<>2
           *** Calculo el Resultado TOTAL
           ACN(Z2,VAL(Z3)*FBN['Cantidad1']*Dialogo.Entero2)
  
           Message('Actualizando la Opcion  .... ')
   
           *** Marca la operacion como ejercida ***
           SQL.ADD("Update "~DBO~".CUOTAS ")
           SQL.ADD("Set ")
           SQL.ADD("Precio1   = "~Fstr(Dialogo.Precio2,0,8)~", ")
           SQL.ADD("Precio2   = "~Fstr(VAL(Z3),0,8)~", ")
           SQL.ADD("Total1    = "~Fstr(VAL(Z2),0,8)~", ")
           SQL.ADD("Cantidad2 = "~Fstr(Dialogo.Entero2,0,0)~" ")
           SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
           SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
           SQL.NEW
           SQL.EXEC

           *-- Insert de Mov.Pendientes. El Resultado invierte el signo porque se ve desde el cliente
           * EjecutarEvento('IMOVPE',NrOperacion1=Dialogo.NrOperacion1,Fecha1=FBN['Fecha2'],Cliente1=BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),Especie1=BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1),Vehiculo1=BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),Entero1=1,Precio1=-VAL(Z2),String='Resultado Settlement',Entero2=9,Entero2=9,Entero3=Dialogo.Entero1,String1='CUOTAS')

           *** Actualiza movimientos y limites ****
           SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
           SQL.EXEC

        EndIf

     else
        Acn(a1,MessageBox('Con Este Floating Price la Operacion No ser# Ejercida !!',2,1))

        If val(a1)<>2
           *** Marca la operacion como No ejercida ***
           SQL.ADD("Update "~DBO~".CUOTAS ")
           SQL.ADD("Set ")
           SQL.ADD("Precio1   = "~Fstr(Dialogo.Precio2,0,8)~" ")
           SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
           SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
           SQL.NEW
           SQL.EXEC
        EndIf
     endif

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)
  proximo

  If Val(x1)=0
     Cancelar('La operacion No '~Dialogo.NrOperacion1~' No puede ser Ejercida')
  endif
endif


