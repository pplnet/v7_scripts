CrearDialogo
  Fecha1:       'Fecha'     ;1;;;  ;  ;Dialogo.Fecha1>=Habiles(FSys,-Var('FVALORMAX'),'ARG') y Dialogo.Fecha1 <= Fsys;'Fecha fuera de rango permitido';NO;Fsys
  NrOperacion1:  'TCPCEM'   ; ;;;  ;  ;;;;;;;;;"TipoOp in ('TCPCEM')"
  Lista1:        'Mercados' ; ;;;NO;  ;;;;;'MAE|BYMA';SQLSet("SELECT Codigo FROM "~DBO~".MERCADOS  ORDER BY Codigo ");SI
FinDialogo

If Not Ok
  Cancelar
Endif

** Para Procesar poner y:1 en 1
ACN(y:1, 1)
if Val(y:1)=0
  HojaVisible(SI)
endif

SQL.ADD(" Select O.NrOperacion, ")
SQL.ADD("  ISNULL((Select top(1) 'SI' from dbo.ORDENES  where NrOperacion1=O.NrOperacion and NrOperacion2 <> ''),'NO') NrTCOPRI, ")
SQL.ADD("  (Select Count(*)  from "~DBO~".ORDENES  where NrOperacion1=O.NrOperacion ) Ordenes, ")
SQL.ADD("  ISNULL((Select Top (1) 'SI'  from "~DBO~".ORDENES  where NrOperacion1=O.NrOperacion and  Cliente <> '"~VAR('VEHICULODE')~"'),'NO') Terceros ")
SQL.ADD("   From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  O.TipoOp        = 'TCPCEM'                          ")
* No se hizo el cierre
SQL.ADD("   and  O.RB8 = '0' " )
SQL.ADD("    and    O.FechaPago  = "~IdxDate2(Dialogo.Fecha1)~"      ")
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("AND  O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD("AND  O.Mercado4 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif

watch(sql.batch())
*Bandera  (1, desierta, 2 cerrada)
ACN(co:1,0)
*Instancia (1 Liquidacion, 2 Terminal)
ACN(co:2,0)

** AA 4-01-2024 
** Si no hay ordenes es desierta y va a terminal.
** No hay tcopri, terminal y cerrada.
** Si hay tcopri, pero si hay de terceros a liduidacion, cerrada.
** Si hay tcopri y son del vehiculo va a terminal, cerrada.

Recorrer SQL

    If fbn('Ordenes')=0
        ACN(co:1,1)     
        ACN(co:2,2)     
     Else   
        if EqStr(fbn('NrTcopri'),'SI')
           ACN(co:1,2)
           if EqStr(fbn('Terceros'),'SI')
              ACN(co:2,1) 
           else
              ACN(co:2,2) 
           endif
        Else
           ACN(co:1,2)
           ACN(co:2,2)
        Endif   
     Endif

    IF Val(y:1)=1
       * Procesa
       SQL.ADD(" Update "~DBO~".OPERACIONES   ") 
       If Val(co:1)=2
          SQL.ADD(" Set RB8 = '1'            ") 
       Else
          SQL.ADD(" Set RB8 = '2'            ") 
       Endif

       SQL.ADD(" Where NrOperacion = '"~fbn['NrOperacion']~"' ")
       SQL.NEW
       SQL.EXEC
       
       ACN(in:1,SQL("select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~fbn['NrOperacion']~"' and Valor = '1' "))
       
       If Val(co:2)=1
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=Val(in:1), Entero2=10)
       Else
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=Val(in:1), Entero2=70)
       Endif

    Endif
        
Proximo








