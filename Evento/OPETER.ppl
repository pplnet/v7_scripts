MostrarCuadroDeMensajes
CrearDialogo
   Fecha1: 'Desde' ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;Fsys;
   Fecha2: 'Hasta' ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
   Vehiculo1: 'Vehiculo' ;
FinDialogo

IF Not OK
   Cancelar
ENDIF

SQL.ADD(" Select O.NrOperacion ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND B.NrBit = 20 ")
SQL.ADD(" AND B.Valor = '1' ")
IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
ENDIF
Recorrer SQL
    IF SQL(" Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1
        ***---No le quedan ptes. => la paso a Terminal
        Message(fbn('NrOperacion'))
        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '0' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" AND NrBit = 20 ")
        SQL.NEW
        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '1' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" AND NrBit = 50 ")
        SQL.NEW
        SQL.EXEC
    ENDIF
