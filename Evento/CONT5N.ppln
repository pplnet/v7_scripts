Act(md:1, Fbn('Codigo'))
Sqladd(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
Sqladd(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, E.Issuer Cliente1, V.Codigo Vehiculo1, ")
Sqladd(" "~FStr(Abs(Val(ct:1)), 0, 0)~" Cantidad, E.Alias8, V.Alias4 MonLocalVeh, '"~Val(md:1)~"' CodAsi, 'RXTFCI' NrOperacion, '"~&book~"' Book ")
Sqladd(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" Where E.Codigo = '"~Val(a:fac)~"' ")
Sqladd(" AND V.Codigo = '"~Val(f:fac)~"' ")
recorrer sql
Dfa()
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~Fbn('Especie')~"' AND A.Modelo = '"~Val(md:1)~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND (A.FechaValor > '"~IdxDate(Val(fo:2))~"' OR A.FechaValor =  '"~IdxDate(Val(fo:1))~"') AND A.Vehiculo = '"~Val(f:fac)~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
let(&modelocontable, Val(md:1))
Sqlgenerarasientoop(Val(md:1), '', '', '', 810, Val(fv:1), Val(f:fac), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
proximo
Acn(rs:1, 0)
