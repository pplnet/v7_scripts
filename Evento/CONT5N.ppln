Sqladd("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
Sqladd("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
Sqladd("       P.CantidadFin as Cantidad, P.Book, ")
Sqladd("       P.CantidadFin*P.PFRME as Monto, '' Observaciones, '' Cliente1, P.Vehiculo Vehiculo, E.Alias8 ")
Sqladd(" from  "~Dbo()~".POSICIONES2 P, "~Dbo()~".ESPECIES E ")
Sqladd(" where P.Especie     = E.Codigo ")
Sqladd("   and P.NrSaldo     in ("~Val(y:2)~") ")
Sqladd("   and P.TipoNegocio = 'FC' ")
if (NoVacio(dialogo.especie1))
Sqladd("  and P.Especie     = '"~dialogo.especie1~"' ")
endif
Sqladd("   and P.Fecha = '"~IdxDate(Val(v:2))~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (P.Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~")  OR P.Vehiculo is null OR P.Vehiculo = '' OR P.Vehiculo = ' ' )")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND P.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" AND   P.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" order by P.Especie, P.Cupon ")
Watch(Sqlbatch())
recorrer sql
Act(a:fac, Fbn('Especie'))
Act(b:fac, Fbn('Nombre'))
Acn(d:fac, Fbn('NrSaldo'))
Act(e:fac, Fbn('TipoNegocio'))
Act(f:fac, Fbn('Vehiculo'))
Acn(i:fac, Fbn('Cantidad'))
Acn(j:fac, Fbn('Monto') / Fbn('Cantidad'))
Act(k:fac, Fbn('Cotiza'))
Acn(l:fac, CotizacionC(Fbn('Especie'), null, null, null, Val(v:3), 1, SI, Fbn('Cotiza')))
Acn(m:fac, CotizacionC(Fbn('Especie'), null, null, null, Val(v:2), 1, SI, Fbn('Cotiza')))
Acn(n:fac, Val(m:fac) - Val(l:fac))
Acn(o:fac, Val(i:fac) * Val(n:fac))
let(&book, Fbn('Book'))
Sqladd(" Select VRMFMTD, VRMLMTD, VRMCMTD, VRMEMTD, DIMFMTD, DIMLMTD, DIMCMTD, DSMFMTD, DSMLMTD, DSMCMTD, INMFMTD, INMLMTD, INMCMTD, INMEMTD, ")
Sqladd("        RRMFMTD, RRMCMTD, RRMLMTD, RRMEMTD, DKMFMTD, DKMLMTD, DKMCMTD, RTMFMTD, RTMLMTD, RTMCMTD, FTMFMTD, FTMLMTD, FTMCMTD, ")
Sqladd("        XFMFMTD, XFMLMTD, XFMCMTD,          DXMFMTD, DXMLMTD, DXMCMTD ")
Sqladd(" From "~Dbo()~".RESULTADOS2 ")
Sqladd(" Where Fecha = '"~IdxDate(Val(v:2))~"' ")
Sqladd(" AND Especie = '"~Fbn('Especie')~"' ")
Sqladd(" AND NrSaldo IN ("~Val(y:2)~") ")
Sqladd(" AND Book = '"~Fbn('Book')~"' ")
Sqladd(" AND (Vehiculo = '"~Fbn('Vehiculo')~"' OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' '  )")
Sqladd("  ")
Sqladd("  ")
Watch(Sqlbatch())
recorrer sql
Dfa()
Acn(rs:1, Fbn('VRMFMTD') + Fbn('RRMFMTD'))
Acn(rs:2, Fbn('VRMLMTD') + Fbn('RRMLMTD'))
Acn(rs:3, Fbn('VRMCMTD') + Fbn('RRMCMTD'))
Acn(rs:4, Fbn('VRMEMTD') + Fbn('RRMEMTD'))
Acn(di:1, 0)
Acn(di:2, 0)
Acn(di:3, 0)
Acn(dk:1, Fbn('XFMFMTD') + Fbn('DXMFMTD') - Fbn('FTMFMTD'))
Acn(dk:2, Fbn('XFMLMTD') + Fbn('DXMLMTD') - Fbn('FTMLMTD'))
Acn(dk:3, Fbn('XFMCMTD') + Fbn('DXMCMTD') - Fbn('FTMCMTD'))
Acn(id:1, Fbn('INMFMTD'))
Acn(id:2, Fbn('INMLMTD'))
Acn(id:3, Fbn('INMCMTD'))
Acn(id:4, Fbn('INMEMTD'))
proximo
Sqladd(" Select MA.Codigo ")
Sqladd(" From "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" Where MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFC'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")
endif
recorrer sql
Dfa()
