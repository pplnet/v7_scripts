Acd(fo:1, Val(fv:1))
Acd(fo:2, Habiles(FinDeMes(Val(fo:1), NO, 'ARG')))
Act(vh:1, Val(f:&i))
Acn(v1, 0)
Sqladd("Select FechaInicio, FechaFin    from "~Dbo()~".PERIODOSCONTABLES where ")
Sqladd("    Vehiculo = '"~Val(vh:1)~"' ")
recorrer sql
if (Fbn()['FechaInicio'] <= Val(fv:1))
