if (NO)
Sqladd(" Select M.*,T.NrTrans,T.Fecha2,T.Cliente1,T.TipoTr2,T.Especie,T.Especie1,T.Cantidad1,T.Cantidad2, T.Cuenta5, ")
Sqladd("        T.CB8, T.CB7 ,T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5                                              ")
Sqladd("   from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O, "~Dbo()~".ESPECIES E,"~Dbo()~".MOVEJECUTADOS M    ")
Sqladd("                                                                                    ")
Sqladd(" where  T.NrTrans = O.NrOperacion                                                                          ")
Sqladd(" and    M.NrOperacion = T.NrTrans                                                                          ")
Sqladd(" and    M.Especie = E.Codigo                                                                               ")
Sqladd(" and    E.Tipo = 'MON'                                                                                     ")
Sqladd(" and    O.NrBit In (3,4,6,70) and O.Valor ='1'                                                               ")
Sqladd(" and    T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"'                                                           ")
Sqladd(" and    T.TipoTr2 In ('LCUPON')                                                                            ")
Sqladd(" and    M.NrSaldo = 1                                                                                      ")
endif
Sqladd(" Select T.NrTrans,T.Fecha1,M.Cliente,T.TipoTr2,T.Especie,T.Especie1,M.Cantidad,T.Cantidad2, T.Cuenta5,     ")
Sqladd("        T.CB8, T.CB7 ,T.CB6 ,T.Mercado1 ,T.CB1, T.CB5, M.Book                                              ")
Sqladd("   from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O,"~Dbo()~".MOVEJECUTADOS M                        ")
Sqladd(" where  T.NrTrans = O.NrOperacion                                                                          ")
Sqladd(" and    M.NrOperacion = T.NrTrans                                                                          ")
Sqladd(" and    M.Especie = T.Especie                                                                              ")
Sqladd(" and    O.NrBit In (3,4,6,70) and O.Valor ='1'                                                             ")
Sqladd(" and    T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"'                                                           ")
Sqladd(" and    T.TipoTr2 In ('LCUPON')                                                                            ")

Sqladd(" order by T.NrTrans ")

Watch(Sqlbatch())
