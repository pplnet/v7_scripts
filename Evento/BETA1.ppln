operador1:"Origen";;;;;;dialogo.radio4 = 1 o NoVacio(dialogo.operador1);'ALGUN OPERADOR VACIO U OPERADORES IGUALES';NO;;;SQLSet("Select Codigo from "~Dbo()~".USUARIOS ")
operador2:"Destinatario";;;;;;dialogo.radio4 = 1 o (NoVacio(dialogo.operador2) y not Eqstr(dialogo.operador1, dialogo.operador2));'ALGUN OPERADOR VACIO U OPERADORES IGUALES';NO;;;SQLSet("Select Codigo from "~Dbo()~".USUARIOS ")
