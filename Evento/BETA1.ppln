endif


sql.add("Select O.NrOperacion ")
sql.add(" from "~Dbo()~".OPERACIONES O ")
sql.add("  where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("  and (O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' or O.FechaVto is Null) ")
sql.add("  and O.TipoOp In ('MMDC','MMDCA','MMCP','MMCPR','MMCPRV','MMCPV') ")
sql.add("  and O.Operador = '"~dialogo.operador1~"' ")


sql.add("order by O.NrOperacion ")
recorrer sql

sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("Set ")
sql.add(" Operador ='"~dialogo.operador2~"' ")
sql.add("where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
sql.new
sql.exec

