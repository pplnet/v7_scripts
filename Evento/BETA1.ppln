Sqladd("Select O.NrOperacion ")
Sqladd(" from "~Dbo()~".OPERACIONES O ")
Sqladd("  where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("  and (O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' or O.FechaVto is Null) ")
Sqladd("  and O.TipoOp In ('MMDC','MMDCA','MMCP','MMCPR','MMCPRV','MMCPV') ")
Sqladd("  and O.Operador = '"~dialogo.operador1~"' ")


Sqladd("order by O.NrOperacion ")
recorrer sql

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set ")
Sqladd(" Operador ='"~dialogo.operador2~"' ")
Sqladd("where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()

