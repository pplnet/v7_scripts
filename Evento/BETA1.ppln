findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio4 = 1)
Cancelar()('NO SE REALIZARON CAMBIOS')
endif

Acn(x10, sql('Select count(*) from '~Dbo()~'.OPERACIONES where Operador = "'~dialogo.operador1~'" '))
if (Val(x10) = 0)
Cancelar()('EL OPERADOR QUE SALE NO TIENE MINUTAS ASIGNADAS: La Operacion queda abortada')
endif

if (dialogo.radio2 = 0)
linkearhoja('BETA1', 1, operador = dialogo.operador1, string = 'Operaciones Vigentes Anteriores al Cambio de: ', fecha1 = dialogo.fecha1)
