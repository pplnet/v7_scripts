Sqladd(" DELETE "~Dbo()~".CONFIRMACIONESOP  ")
Sqladd(" Where NrOperacion = '"~Val(b:&i)~"'                 ")
Sqladd("  and  NrConfirmacion = "~FStr(Val(cf:1), 0, 0)~"      ")
Sqlnew()
Sqlexec()



