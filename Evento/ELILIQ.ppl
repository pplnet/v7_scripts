* Recupero los Nros. de Vouchers de Transacciones2
SQL.ADD("Select NrTrans from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~Dialogo.NrOperacion1~"' ")

ACN(a1,0)

Recorrer SQL

  Message(' Anulando Voucher Nro. '~fbn('NrTrans')~' ....' )

  ACN(a1,1)
  EjecutarEvento('ANUVOU',NrTrans1=fbn('NrTrans'), Check1 = 1)

  * MessageBox('VerIfique si debe anular el comprobante en JDE. Nr.Operacion: '~Dialogo.NrOperacion1~'. Voucher: '~fbn('NrTrans'))
Proximo

If Val(a1)=0
   Message('La operacion no tiene vouchers asociados')
Else
   IF Eqstr(Val(TP:1), 'MMP')
       ***---Borro los MOVAJUSTE de las operaciones asociadas a la partida
       ACT(LS:3, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where OperacionRef = '"~Dialogo.NrOperacion1~"' "))
       SQL.ADD("DELETE "~DBO~".MOVAJUSTE Where NrOperacion IN ("~Pipe2Comillas(Val(LS:3))~")")
   ELSE
       SQL.ADD("DELETE "~DBO~".MOVAJUSTE Where NrOperacion='"~Dialogo.NrOperacion1~"'  ")
   ENDIF
   SQL.NEW
   SQL.EXEC        
Endif
