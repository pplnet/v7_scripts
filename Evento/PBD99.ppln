creardialogo
fecha1: 'D.Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;1;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO', 'Vehiculo', 'Codigo', UsuarioActivo());;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
especie1: 'Moneda';3;;;;;Eqstr(BuscarCampo('ESPECIES', 'Tipo', 'Codigo', dialogo.especie1), 'MON');'Moneda Invalida';NO;'ARP';;;;;" Tipo = 'MON' "
radio2: 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos';4;1;;;;;;;4
check1: 'Incluye Pagadoras';5;1;;;;;;;1
lista1: 'Bancos';6;1;1;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista2: 'Cuentas';-0;2;1;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Cliente = '"~dialogo.vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(dialogo.lista1)~") ");
findialogo

if (not ok)
Cancelar()
