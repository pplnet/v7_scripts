Sqladd(" SELECT /*+ RULE */ O.NrOperacion, M.*, 'T' Tipo, M.NrTrans2 ")
Sqladd(" FROM "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVPENDIENTES M, ")
Sqladd(" "~Dbo()~".CUENTAS C ")
Sqladd(" WHERE O.NrOperacion = M.NrOperacion ")
Sqladd(" AND   O.NrOperacion = B.NrOperacion ")
Sqladd(" AND   M.Cuenta      = C.Codigo ")
Sqladd(" AND   M.FechaMov <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND   M.Especie      = '"~dialogo.especie1~"' ")
Sqladd(" AND   B.NrBit = 17  ")
Sqladd(" AND   B.Valor = '1' ")
Sqladd(" UNION ")
Sqladd(" SELECT /*+ RULE */ O.NrOperacion, M.*, 'O' Tipo, O.NrOperacion NrTrans2 ")
Sqladd(" FROM "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".TRANSACCIONES2 O, "~Dbo()~".MOVPENDIENTES M, ")
Sqladd(" "~Dbo()~".CUENTAS C ")
Sqladd(" WHERE O.NrOperacion = M.NrOperacion ")
Sqladd(" AND   O.NrOperacion = B.NrOperacion ")
Sqladd(" AND   M.Cuenta      = C.Codigo ")
Sqladd(" AND   M.FechaMov <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND   M.Especie      = '"~dialogo.especie1~"' ")
Sqladd(" AND   B.NrBit = 17  ")
Sqladd(" AND   B.Valor = '1' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND C.Comitente IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND C.Codigo IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (dialogo.radio2 = 0)
Sqladd(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
endif
if (dialogo.radio2 = 1)
Sqladd(" AND C.TipoCuenta IN ('INT')")
endif
if (dialogo.radio2 = 2)
Sqladd(" AND C.TipoCuenta IN ('REC')")
endif
if (dialogo.radio2 = 3)
Sqladd(" AND C.TipoCuenta IN ('CA')")
endif
if (dialogo.check1 = 0)
Sqladd(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
endif
recorrer sql
