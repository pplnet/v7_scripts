DialogoVisible(SI)

creardialogo
especie1:'Especie a copiar';;;;SI;;;;;
string1:'Nombre nuevo de la Especie';;;;;;;;;;;;;'XXXXXX'
findialogo

if (not ok)
Cancelar()
endif

if (dobleconf('ESPECI'))
ejecutarevento('COPEST', especie1 = dialogo.especie1, string1 = dialogo.string1)
Cancelar()
endif


Act(xx:3, SQLSet("Select 1 from "~Dbo()~".Especies where Codigo = '"~dialogo.string1~"'"))

if (Incluido(Val(xx:3), '1'))
Cancelar()('El codigo de especie ya existe, utilice otro.')
endif


Act(jj:1, Ascendientes('ESPECIES', dialogo.especie1))

Act(jj:2, sql("Select MAX(Jerarquia) from "~Dbo()~".Especies where Codigo In ("~pipe2comillas(Val(jj:1))~") "))

Act(pp:4, generarjerarquiaporreferencia('ESPECIES', Val(jj:2)))


