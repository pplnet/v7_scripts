creardialogo
nroperacion1: 'Op  Cabecera'
nroperacion2: 'Op. Participante'
string1:'Condicion de Select Cuotas'
findialogo

if (not ok)
Cancelar()
endif


Message('Insertando Settlements')

Sqladd("INSERT INTO "~Dbo()~".CUOTAS ")
Sqladd(" (NrOperacion,C.NrCuota,C.Cliente1,C.Cliente2,")
Sqladd(" C.Vehiculo1,C.Vehiculo2,C.Especie1,C.Especie2,C.Especie3,C.Especie4,C.Check1,C.Check2,C.Check3,")
Sqladd(" C.Check4,C.Check5,C.Check6,C.Check7,C.Check8,C.Check9,C.Check10,C.Radio1,C.Radio2,C.Radio3,C.Radio4,")
Sqladd(" C.Radio5,C.Radio6,C.Radio7,C.Radio8,C.Radio9,C.Radio10,C.Fecha1,C.Fecha2,C.Fecha3,C.Fecha4,C.Fecha5,")
Sqladd(" C.Fecha6,C.Fecha7,C.Fecha8,C.Fecha9,C.Fecha10,C.Mercado1,C.Mercado2,C.Plazo1,C.Plazo2,C.Plazo3,C.Plazo4,")
Sqladd(" C.Cantidad1,C.Cantidad2,C.Cantidad3,C.Cantidad4,C.Precio1,C.Precio2,C.Precio3,C.Precio4,C.Total1,C.Total2,")
Sqladd(" C.Total3,C.Total4,C.Total5,C1.Total6,C.Total7,C.Total8,C.Tasa1,C1.Tasa2,C.PrecioRef1,C.PrecioRef2,")
Sqladd(" C.Cantidad5,C. Cantidad6,C.Precio5,C.Precio6,C.Precio7,C.Precio8,C.Tasa3,C.Total9,C.Cotizacion1,C.Cotizacion2,")
Sqladd(" C.Tasa4,C.Tasa5,")
Sqladd(" C.Cantidad7,C.Cantidad8,C.Coeficiente,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.ResultadoIndice) ")

Sqladd(" SELECT '"~dialogo.nroperacion2~"' As NrOperacion,C.NrCuota,C.Cliente1,C.Cliente2,")
Sqladd(" C.Vehiculo1,C.Vehiculo2,C.Especie1,C.Especie2,C.Especie3,C.Especie4,C.Check1,C.Check2,C.Check3,")
Sqladd(" C.Check4,C.Check5,C.Check6,C.Check7,C.Check8,C.Check9,C.Check10,C.Radio1,C.Radio2,C.Radio3,C.Radio4,")
Sqladd(" C.Radio5,C.Radio6,C.Radio7,C.Radio8,C.Radio9,C.Radio10,C.Fecha1,C.Fecha2,C.Fecha3,C.Fecha4,C.Fecha5,")
Sqladd(" C.Fecha6,C.Fecha7,C.Fecha8,C.Fecha9,C.Fecha10,C.Mercado1,C.Mercado2,C.Plazo1,C.Plazo2,C.Plazo3,C.Plazo4,")
Sqladd(" C.Cantidad1,C.Cantidad2,C.Cantidad3,C.Cantidad4,C.Precio1,C.Precio2,C.Precio3,C.Precio4,C.Total1,C.Total2,")
Sqladd(" C.Total3,C.Total4,C.Total5,C1.Total6,C.Total7,C.Total8,C.Tasa1,C1.Tasa2,C.PrecioRef1,C.PrecioRef2,")
Sqladd(" C.Cantidad5,C. Cantidad6,C.Precio5,C.Precio6,C.Precio7,C.Precio8,C.Tasa3,C.Total9,C.Cotizacion1,C.Cotizacion2,")
Sqladd(" C.Tasa4,C.Tasa5,")
Sqladd(" C.Cantidad7,C.Cantidad8,C.Coeficiente,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.ResultadoIndice ")
Sqladd(" FROM "~Dbo()~".CUOTAS C,  "~Dbo()~".CUOTAS C1 WHERE C.NrOperacion='"~dialogo.nroperacion1~"' AND C1.NrOperacion='"~dialogo.nroperacion2~"' AND C1.NrCuota=C.NrCuota ")
if (NoVacio(dialogo.string1))
Sqladd(" and "~dialogo.string1~" ")
endif
Sqlnew()

Sqladd("DELETE "~Dbo()~".CUOTAS WHERE NrOperacion= '"~dialogo.nroperacion2~"' and Cantidad3=0 ")
Sqlnew()
Sqlexec()


Sqladd("SELECT TotalAux4,TotalAux2,CB10,TipoOp,RB8,Cantidad,")
Sqladd("ImpGastos2,TotalAux1,TasaImp1,RB7,RB9,CB10 FROM "~Dbo()~".OPERACIONES WHERE ")
Sqladd("NrOperacion='"~dialogo.nroperacion2~"' ")

recorrer sql
Dfa()
Acn(a50, Fbn()['CB10'])

Act(a60, Fbn()['TipoOp'])

Acn(a10, iif (Eqstr(Fbn()['RB8'], '0'), 36000, 36500))

Acn(a3, Fbn()['Cantidad'])

Acn(a20, Fbn()['ImpGastos2'])
Acn(a21, Fbn()['TotalAux1'])
Acn(a40, Fbn()['TasaImp1'])

Act(a24, Fbn()['RB7'])
Act(a25, Fbn()['RB9'])

Act(a26, Fbn()['CB10'])
proximo

Sqladd("SELECT * FROM "~Dbo()~".CUOTAS WHERE ")
Sqladd("NrOperacion='"~dialogo.nroperacion2~"' ORDER BY NrCuota ")

recorrer sql
Message('Insertando Settlements '~dialogo.nroperacion2~' '~FStr(Fbn()['NrCuota'], 2, 0))


Acn(a7, 0)
Acn(a8, 0)

Acn(a30, FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], BuscarCampo('Operaciones', 'RB8', 'NrOperacion', dialogo.nroperacion1) + 1))

if (Val(a20) <> 0)
Acn(a7, (Val(a3) * Fbn()['Tasa2'] / 100 * Val(a30) * Val(a20)) / 100)
endif
if (Eqstr(Val(a26), '1'))
Acn(a8, (Val(a3) * Fbn()['Total6'] / 100 * Val(a30) * Val(a21)) / 100)
endif

Acn(a9, BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion2) * Fbn()['Tasa1'] / 100)

Acn(a4, Val(a3) * ((Fbn()['Precio2'] + Fbn()['Precio4']) / 100) * Val(a30))

Acn(a41, 0)

if (Val(a40) <> 0 y ((Val(a50) = 0 y Eqstr(Val(a60), 'MMSIMV')) o (Val(a50) = 1 y Eqstr(Val(a60), 'MMFIMV'))))
Acn(a41, Val(a4) * (Val(a40) / 100))
endif

Acn(a11, Val(a4) + Val(a8) + Val(a41))

Acn(a5, Val(a9) + Val(a4))

Acn(a6, Val(a9) + Val(a11))

Sqladd("Update "~Dbo()~".CUOTAS SET ")
Sqladd(" Cantidad2= "~FStr(Val(a3), 0, 2)~", ")
Sqladd(" Cantidad4= "~FStr(Val(a9), 0, 2)~", ")
Sqladd(" Cantidad5= "~FStr(Val(a11), 0, 2)~", ")
Sqladd(" Cantidad3= "~FStr(Val(a4), 0, 2)~", ")
Sqladd(" Precio1= "~FStr(Val(a7), 0, 2)~", ")
Sqladd(" Precio6= "~FStr(Val(a7), 0, 2)~", ")
Sqladd(" Precio3= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Precio7= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Total2= "~FStr(Val(a5), 0, 2)~", ")
Sqladd(" Total9= "~FStr(Val(a41), 0, 2)~", ")
Sqladd(" Total1= "~FStr(Val(a6), 0, 2)~", ")
Sqladd(" PrecioRef1= '"~FStr(Val(a41), 0, 2)~"', ")
Sqladd(" Cantidad1Ori= "~FStr(Val(a9), 0, 2)~", ")
Sqladd(" Cantidad2Ori= "~FStr(Val(a3), 0, 2)~" ")
Sqladd(" WHERE NrOperacion='"~dialogo.nroperacion2~"' ")
Sqladd(" AND NrCuota="~FStr(Fbn()['NrCuota'], 2, 0)~" ")
Sqlnew()
Sqlexec()

Acn(a3, Val(a3) - Val(a9))

Sqlactualizarmovimientos(dialogo.nroperacion2, SI)
Sqlexec()
proximo

Sqladd(" SELECT C.NrCuota,Sum(C.Precio1) as Precio1,Sum(C.Precio3) as Precio3 ")
Sqladd(" FROM "~Dbo()~".CUOTAS C, "~Dbo()~".OPERACIONES O WHERE ")
Sqladd(" C.NrOperacion=O.NrOperacion and O.OperacionRef='"~dialogo.nroperacion1~"' ")
Sqladd(" Group By C.NrCuota")

recorrer sql
Dfa()
Sqladd("UPDATE "~Dbo()~".CUOTAS SET ")
Sqladd("Precio1="~FStr(Fbn()['Precio1'], 0, 2)~", ")
Sqladd("Precio3="~FStr(Fbn()['Precio3'], 0, 2)~"  ")
Sqladd("WHERE NrOperacion='"~dialogo.nroperacion1~"' ")
Sqladd("and NrCuota="~FStr(Fbn()['NrCuota'], 0, 0)~" ")
Sqlnew()
Sqlexec()
proximo

SqlActualizarmovimientos3(dialogo.nroperacion2, NO, NO, NO, NO, SI)
Sqlexec()












