sql.add("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia, ")
sql.add("O.RB6,O.CB10,O.MB1,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
sql.add("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaVto,O.Plazo,O.Cantidad,")
sql.add("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
