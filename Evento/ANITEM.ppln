nroperacion1: 'Nr.Operacion:';;;;NO
findialogo

if (not ok)
Cancelar()
endif



sql.add(" Select * from "~Dbo()~".OPERACIONES Where ")
sql.add(" NrOperacion IN ")
sql.add(" (Select OperacionRef  from "~Dbo()~".OPERACIONES Where NrOperacion='"~dialogo.nroperacion1~"') ")
sql.add(" Order By NrOperacion ")

recorrer sql

Message('Procesando Operacion '~Fbn()['NrOperacion']~' ...')

Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Act(c:fac, Fbn('Cliente1'))
Acd(d:fac, Fbn('FechaOp'))
proximo

ACO(3, 15)
ACO(4, 8)

listbox(a1..d:fac, '# Op     Tipo     Entidad      Fecha      ')

if (ok)
recorrer&j 1, Fac()

Message('Modificando la Operacion Relacionada '~Val(a:&j)~' ...')

sql.add(" UPDATE "~Dbo()~".OPERACIONES SET ")

if (Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMFRNP|MMFIMV|MMPSI|MMSIMV'))
sql.add(" TotalBrutoCli2 = TotalBrutoCli2-"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~", ")
sql.add(" TotalNetoCli3 = TotalNetoCli3+"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
else
sql.add(" TotalAux3 = TotalAux3-"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
endif

if (Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMPSI|MMSIMV'))
sql.add(" ,TotalIVA  = TotalIVA-"~FStr(BuscarCampo('Operaciones', 'TotalIVA', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
sql.add(" ,TotalAux3 = TotalAux3-"~FStr(BuscarCampo('Operaciones', 'TotalAux3', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
endif

sql.add(" Where NrOperacion= '"~Val(a:&j)~"' ")
sql.new

if (Incluido(Val(b:&j), 'MMP|MMPV'))
Message('Elimando relacionante en Partida '~Val(a:&j)~' ...')
sql.add("DELETE "~Dbo()~".CUOTAS Where NrOperacion='"~Val(a:&j)~"' and Mercado1='"~dialogo.nroperacion1~"' ")
sql.new
endif

Message('Anulando los Datos Relacionados con la Operacion '~dialogo.nroperacion1)
sql.add("DELETE "~Dbo()~".CUOTAS Where")
sql.add(" NrOperacion='"~dialogo.nroperacion1~"' ")
sql.new

sql.add("DELETE "~Dbo()~".COMISIONES2 Where")
sql.add(" NrOperacion='"~dialogo.nroperacion1~"' ")
sql.new

sql.add("DELETE "~Dbo()~".OPSCALLSPUTS Where")
sql.add(" NrOperacion='"~dialogo.nroperacion1~"' ")
sql.new

Message('Anulando la Operacion '~dialogo.nroperacion1)
sql.add("DELETE "~Dbo()~".OPERACIONES Where")
sql.add(" NrOperacion='"~dialogo.nroperacion1~"' ")
sql.new
sql.exec

ejecutarevento('UIVAWH', nroperacion1 = Val(a:&j))

