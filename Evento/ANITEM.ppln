creardialogo
nroperacion1: 'Nr.Operacion:';;;;NO
findialogo

if (not ok)
Cancelar()
endif



Sqladd(" Select * from "~Dbo()~".OPERACIONES Where ")
Sqladd(" NrOperacion IN ")
Sqladd(" (Select OperacionRef  from "~Dbo()~".OPERACIONES Where NrOperacion='"~dialogo.nroperacion1~"') ")
Sqladd(" Order By NrOperacion ")

recorrer sql

Message('Procesando Operacion '~Fbn()['NrOperacion']~' ...')

Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Act(c:fac, Fbn('Cliente1'))
Acd(d:fac, Fbn('FechaOp'))
proximo

ACO(3, 15)
ACO(4, 8)

* listbox stripped

if (ok)
recorrer&j 1, Fac()

Message('Modificando la Operacion Relacionada '~Val(a:&j)~' ...')

Sqladd(" UPDATE "~Dbo()~".OPERACIONES SET ")

if (Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMFRNP|MMFIMV|MMPSI|MMSIMV'))
Sqladd(" TotalBrutoCli2 = TotalBrutoCli2-"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~", ")
Sqladd(" TotalNetoCli3 = TotalNetoCli3+"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
else
Sqladd(" TotalAux3 = TotalAux3-"~FStr(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
endif

if (Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMPSI|MMSIMV'))
Sqladd(" ,TotalIVA  = TotalIVA-"~FStr(BuscarCampo('Operaciones', 'TotalIVA', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
Sqladd(" ,TotalAux3 = TotalAux3-"~FStr(BuscarCampo('Operaciones', 'TotalAux3', 'NrOperacion', dialogo.nroperacion1), 0, 2)~" ")
endif

Sqladd(" Where NrOperacion= '"~Val(a:&j)~"' ")
Sqlnew()

if (Incluido(Val(b:&j), 'MMP|MMPV'))
Message('Elimando relacionante en Partida '~Val(a:&j)~' ...')
Sqladd("DELETE "~Dbo()~".CUOTAS Where NrOperacion='"~Val(a:&j)~"' and Mercado1='"~dialogo.nroperacion1~"' ")
Sqlnew()
endif

Message('Anulando los Datos Relacionados con la Operacion '~dialogo.nroperacion1)
Sqladd("DELETE "~Dbo()~".CUOTAS Where")
Sqladd(" NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()

Sqladd("DELETE "~Dbo()~".COMISIONES2 Where")
Sqladd(" NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()

Sqladd("DELETE "~Dbo()~".OPSCALLSPUTS Where")
Sqladd(" NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()

Message('Anulando la Operacion '~dialogo.nroperacion1)
Sqladd("DELETE "~Dbo()~".OPERACIONES Where")
Sqladd(" NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

