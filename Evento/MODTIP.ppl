* MODTIP Modificar El Tipo Variables 
CrearDialogo
  Variable1 : 'Variable'                       ;;;;;;;;;;;;;;;;
  Radio1    : 'Tipo|Param|Segur|Usuario|Vacio'       ;;;;;;;;;;IIF(EqStr(BuscarCampo('VARIABLES','Cotiza','Codigo',Dialogo.Variable1),'P'),0,IIF(EqStr(BuscarCampo('VARIABLES','Cotiza','Codigo',Dialogo.Variable1),'S'),1,IIF(EqStr(BuscarCampo('VARIABLES','Cotiza','Codigo',Dialogo.Variable1),'U'),2,3)) );
  Radio2    : 'Cambio|Param|Segur|Usuario|Vacio'     ;;;;;;Dialogo.Radio1<>Dialogo.Radio2;'Debe cambiar el tipo de la variable';NO;0;;
FinDialogo

If Not Ok  
  Cancelar
Else

  Message('Actualizando el Tipo de Variable ...')
  ACT(aa1,IIF(Dialogo.Radio2=0,'P',IIF(Dialogo.Radio2=1,'S',IIF(Dialogo.Radio2=2,'U',''))))

  SQL.ADD('Update '~DBO~'.VARIABLES set Cotiza = "'~val(aa1)~'" where Codigo="'~Dialogo.Variable1~'" ')
  SQL.NEW
  SQL.EXEC
Endif
