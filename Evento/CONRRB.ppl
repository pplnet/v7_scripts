CrearDialogo
  NrOperacion1: '# Operacion' ;;;;;;Novacio(Dialogo.NrOperacion1);;;
  Check1      : 'Procesa'     ;;;;NO;NO;;;;1
FinDialogo
If Not OK
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

SQL.ADD("Select NrOperacion, RB6 ")
SQL.ADD("  from "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion= '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACT(a:1, fbn('NrOperacion'))
  ACN(a:2, fbn('RB6'))
  SQL.ADD("Select NrOperacion, Valor  ")
  SQL.ADD("  from "~DBO~".OPERACIONESBITS ")
  SQL.ADD(" Where NrOperacion= '"~Dialogo.NrOperacion1~"' ")
  SQL.ADD("   and NrBit = 30 ")
  Recorrer SQL
    dfa
    ACN(a:3, fbn('Valor'))
  Proximo
  if Val(a:2)=0 o Val(a:2)=1
    if Val(a:3)=1
      if Dialogo.Check1=1 
        SQL.ADD("DELETE "~DBO~".OPERACIONES ")
        SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
        SQL.New
        SQL.Exec
      endif
    endif
  endif
Proximo
