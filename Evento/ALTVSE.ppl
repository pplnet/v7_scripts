* Alta Variables de Seguridad

CrearDialogo
  String : 'Variable' ;;;;;;SQL("Select count(*) from "~DBO~".VARIABLES where Codigo = '"~Dialogo.String~"'")=0;'Ya Existe esa Variable';NO;
  String1 : 'Nombre'   ;;;;;;Not Vacio(Dialogo.String1);'Ingrese un Nombre';NO
  String2 : 'Valor'    ;;;;;;Not Vacio(Dialogo.String2)  ;'Ingrese un Valor' ;NO;
FinDialogo
if not Ok  
  Cancelar
endif
if Longitud(Dialogo.String)>10
   Messagebox('El Codigo de Variable excede la longitud permitida')
   Cancelar
endif
if Longitud(Dialogo.String1)>25
   Messagebox('El Nombre excede la longitud permitida')
   Cancelar
endif
if Longitud(Dialogo.String2)>200
   Messagebox('El Valor excede la longitud permitida')
   Cancelar
endif

SQL.ADD('Insert into '~DBO~'.VARIABLES (Codigo, Nombre, Valor, Cotiza) ') 
SQL.ADD('Values (  "' ~Dialogo.String~'",  "'~Dialogo.String1~'", "'~Dialogo.String2~'", "S" ) ')
SQL.NEW
SQL.EXEC


