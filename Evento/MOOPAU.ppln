creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 <= FSys();'Fecha inválida';NO;FSys()
check1: 'Procesa';;;;SI;SI;;;;0
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(m:1, Var('LINSPAUCIE'))

Sqladd("SELECT DISTINCT O.NrOperacion, O.TipoOp, O.FechaOp, O.FechaVto, O.Cliente1, O.Especie, B.NrBit ")
Sqladd("  FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" WHERE O.NrOperacion = B.NrOperacion ")
Sqladd("   AND B.Valor = '1' ")
Sqladd("   AND B.NrBit in ("~Var('LINSPAUCIE')~") ")
Sqladd("   AND O.TipoOp Not in('MMCO', 'MMCT', 'MMCREM', 'MMPF') ")

Sqladd(" ORDER BY O.NrOperacion, B.NrBit ")
recorrer sql
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acd(d:fac, Fbn('FechaVto'))
Act(e:fac, Fbn('Cliente1'))
Act(f:fac, Fbn('Especie'))
Acn(g:fac, Fbn('NrBit'))

if (Val(g:fac) <> 69)
if (dialogo.check1 = 1)
Sqladd("UPDATE "~Dbo()~".OPERACIONES ")
Sqladd("   SET InstAnterior  = "~FStr(Val(g:fac), 1, 0)~" ")
Sqladd(" Where NrOperacion = '"~Val(a:fac)~"' ")
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(a:fac)~"' AND NrBit=69 ") = 0)
Ejecutarevento('INSBIT', 'entero1', 69, 'nroperacion1', Val(a:fac))
endif
Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   SET Valor       = '0' ")
Sqladd(" Where NrOperacion = '"~Val(a:fac)~"' ")
Sqladd("   and NrBit       = "~FStr(Val(g:fac), 1, 0)~" ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   SET Valor       = '1' ")
Sqladd(" Where NrOperacion = '"~Val(a:fac)~"' ")
Sqladd("   and NrBit       = "~FStr(69, 1, 0)~" ")
Sqlnew()

Act(h:fac, 'Evento MOOPAU mueve a 69')
Sqladd("Insert Into "~Dbo()~".INSTANCIASOP ")
Sqladd(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(a:fac)~"', "~FStr(Val(g:fac), 1, 0)~", '"~UsuarioActivo()~"', '"~Val(h:fac)~"', "~SQLAhora()~" )")
Sqlnew()

Act(i:fac, 'Pasaje automatico a Inst 69 desde '~FStr(Val(g:fac), 1, 0))
Sqladd("Insert into "~Dbo()~".EXCEPCIONES ( ")
Sqladd(" NrOperacion, Fecha, Tipo, Descripcion ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(a:fac)~"', ")
Sqladd(" "~SQLAhora()~", ")
Sqladd(" 'A69AUTOM', ")
Sqladd(" '"~Val(i:fac)~"' ")
Sqladd(" ) ")
Sqlnew()

Sqlexec()
endif
endif
proximo
if (Fac() = 0)
if (dialogo.check1 = 0)
Messagebox('No hay operaciones para pasar a Compliance (69)')
endif
