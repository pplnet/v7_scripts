*** Actualiza movimientos, limites, posiciones y Devengados
SQL.ActualizarMovimientos3(VAL(A1),SI,NO,NO,SI,SI)
SQL.EXEC

*- Calculo de TTN Op.Vinculada
EjecutarEvento('TTNOP',NrOperacion1=val(a1), Entero1 = 0,NrOperacion2='',Lista1='')

if Incluido(Val(w:1),'SECS|SECSV|SEVS|SEVSV|FXCS|FXCSV|FXVS|FXVSV|FCCPV|FCVPV')
  if Val(e:2)=1
    if Val(e:11)=1
      EjecutarEvento('ACTSPE',NrOperacion1=Val(e:3), Entero1=Val(e:4),Cantidad1=Val(e:12),Radio1=0,Check1=1)
    endif
  endif
endif

ACO(3,15)
ACO(4,12)
ACO(5,12)
