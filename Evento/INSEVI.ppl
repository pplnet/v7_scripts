SQL.ADD("         Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
SQL.ADD("         Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
SQL.ADD("         Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2,Cantidad5,")
SQL.ADD("         Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
SQL.ADD("         Cantidad7,Cantidad8,Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice, Cantidad12")
SQL.ADD("    FROM "~DBO~".CUOTAS ")
SQL.ADD("   WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW


Message('Generando Calls y Puts Operacion '~VAL(A1)~' Vinculada ...')
SQL.ADD("INSERT INTO "~DBO~".OPSCALLSPUTS ")
SQL.ADD(" (NrOperacion,TipoOpcion,FechaEj,PrecioEj,")
