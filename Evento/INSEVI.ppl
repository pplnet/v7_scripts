**-- INSEVI - Insert de Operacion Vinculadas
*hojavisible(si)
CrearDialogo
   NrOperacion1:'Op  Vehiculo'        
   TipoOp1     :'Tipo Vinculada' 
   String      :'Condicion de Update'
   Vehiculo1   :'Veh. Nueva'
   Vehiculo2   :'Veh Origen'
   String1     :'Cond.Update2'
FinDialogo

If not Ok
 Cancelar
EndIf

* A2: Numerador
ACN(A2,BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1) )

***---Uso siempre el numerador del vehiculo - Ver si es necesario usar otro numerador cuando se origina por vinculada.
***---* Obtengo el Nro. de la Operacion Vinculada Cambia el Numerador
***---IF Incluido(Dialogo.TipoOp1,'VIMD')
***---   ACN(A2,BuscarCampo('VEHICULOS','Valor5','Codigo',Dialogo.Vehiculo1) )    
***---EndIf

***---IF Incluido(Dialogo.TipoOp1,'MMCPRV')
***---   * Obtengo el Numerador de Vinculadas
***---   ACN(A2,3)
***---EndIf

ACT (W:1, BuscarCampo('OPERACIONES','TipoOp', 'NrOperacion', Dialogo.NrOperacion1 ))
ACT (CB:3, BuscarCampo('OPERACIONES','CB3', 'NrOperacion', Dialogo.NrOperacion1 ))

** FJL 20/01/2012
** Bloque para operaciones sinteticas. Relacionadas con Prestamos en especies.

if Incluido(Val(w:1),'SECS|SECSV|SEVS|SEVSV|FXCS|FXCSV|FXVS|FXVSV|FCCPV|FCVPV')
  ACT(c:1, 'TipoOp')
  ACT(c:2, 'CB13')
  ACT(c:3, 'Prestamo')
  ACT(c:4, 'Cuota')
  ACT(c:5, 'Pmo rel')
  ACT(c:6, 'Vto Cta')
  ACT(c:7, 'TOp Hab Pmo ')
  ACT(c:8, 'RB14 (TPmo)')
  ACT(c:9, 'Especie Pmo')
  ACT(c:10, 'Saldo VN')
  ACT(c:11, 'Afecta')
  ACT(c:12, 'Cantidad')

  SQL.ADD("SELECT * ")
  SQL.ADD("  FROM "~DBO~".OPERACIONES ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
  recorrer SQL
    ACT(d:1, fbn('TipoOp'))
    ACT(e:1, Dialogo.TipoOp1)
    ACN(d:2, fbn('CB13'))
    ACN(e:2, fbn('CB13'))
    if Val(d:2)=1
      ACT(d:3, fbn('NrOperacion5'))
      ACT(e:3, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',fbn('NrOperacion5')))
      ACN(d:4, fbn('Cuotas1'))
      ACN(e:4, fbn('Cuotas1'))
      * VTXT7 Pmo Asociado
      ACT(d:5, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',fbn('NrOperacion5')))
      * VFEC7 - Fecha Vto Cuota
      ACD(d:6, SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion5')~"' and NrCuota="~FStr(fbn('Cuotas1'),1,0)~" "))
      ACD(e:6, SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion='"~Val(d:5)~"' and NrCuota="~FStr(fbn('Cuotas1'),1,0)~" "))
      * VTXT9 - TipoOp Pmo
      if Incluido(Val(w:1),'SECS|SEVS|FXCS|FXVS')
        ACT(d:7, 'SEPTMV')
      else
        ACT(d:7, 'SEPVMV')
      endif
      if Incluido(Val(w:1),'SECS|SEVS|FXCS|FXVS')
        ACT(e:7, 'SEPTMV')
      else
        ACT(e:7, 'SEPVMV')
      endif
      ACN(d:8, fbn('RB14'))
      ACN(e:8, BuscarCampo('OPERACIONES','MB3','NrOperacion',Val(d:5)))
      * VTXT10 - Especie Pmo
      ACT(d:9, BuscarCampo('OPERACIONES','Especie','NrOperacion',fbn('NrOperacion5')))
      ACT(e:9, BuscarCampo('OPERACIONES','Especie','NrOperacion',Val(d:5)))
      * VCAN10
      ACN(d:10, SQL("Select Cantidad12 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion5')~"' and NrCuota="~FStr(fbn('Cuotas1'),1,0)~" "))
      ACN(e:10, SQL("Select Cantidad12 from "~DBO~".CUOTAS where NrOperacion='"~Val(d:5)~"' and NrCuota="~FStr(fbn('Cuotas1'),1,0)~" "))
      ACN(d:11, fbn('CB14'))
      ACN(e:11, IIF([Incluido(Dialogo.TipoOp1,'SECS|SECSV|FXCS|FXCSV|FCCPV') y Val(e:8)=0] o [Incluido(Dialogo.TipoOp1,'SEVS|SEVSV|FXVS|FXVSV|FCVPV') y Val(e:8)=1],1,0))
      ACN(d:12, fbn('Cantidad'))
      ACN(e:12, fbn('Cantidad'))
    endif
  proximo
endif

ACT(A1,GetNumerador(VAL(A2)) )

Message('Generando Operacion '~VAL(A1)~' Vinculada ...')

