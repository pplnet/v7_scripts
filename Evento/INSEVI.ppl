Message('Actualizando la Operacion ')

IF NOVACIO(Dialogo.String)
   SQL.ADD("Update "~DBO~".OPERACIONES SET ")
   SQL.ADD(" "~Dialogo.String~Dialogo.String1~" WHERE  NrOperacion='"~VAL(A1)~"' ")
   SQL.NEW
ENDIF

**-- Actualiza la Operacion Nueva (Vinculada) Con cambio de Books y Tratamiento de Operaciones Renovadas
**-- Algunos Tipos De Operacion no estan alcanzados por el cambio de Books.
**-- El NrOperacion renovable (Nroperacion4 en la operacion nueva) de las operaciones indicadas como Renovadas (son las que traen CB3=1 en la Operacion vieja)
**--    son generadas con el NrOperacion de la Vinculada (NrOperacion3 en la Operacion vieja) y con CB3 activado (en 1) 
 

* MessageBox ('Cambio de Cuentas, de '~Dialogo.NrOperacion1~' a '~VAL(A1)~' ----')
SQL.ADD("Update "~DBO~".OPERACIONES ")
***Si la operación tiene 2 especies se actualizan 4 cuentas, las de la especie y la contraespecie***
If Not Incluido(Val(w:1),'MMPCCV|MMCPRV|VIMD') 
  SQL.ADD("SET Cuenta1 = Cuenta4 , Cuenta4 = Cuenta1 , ")
  SQL.ADD("    Cuenta2 = Cuenta5 , Cuenta5 = Cuenta2  ")
***Si la operación tiene una sola especie, se actualizan las 2 cuentas de la especie***
Else
  SQL.ADD("SET Cuenta1 = Cuenta2 , Cuenta2 = Cuenta1 ")
Endif 
SQL.ADD("WHERE  NrOperacion='"~VAL(A1)~"' ")
SQL.NEW
SQL.EXEC

iF Incluido(Val(w:1),'MMPCCV|MMPCCM|SEPVMV') Y  EqStr(Val(CB:3), '1') 
  ACT (W:2, BuscarCampo('OPERACIONES','NrOperacion3', 'NrOperacion',BuscarCampo('OPERACIONES','NrOperacion4', 'NrOperacion', Dialogo.NrOperacion1  ) )  )
  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   SET NrOperacion4 = '"~VAL(W:2)~"', ")
  SQL.ADD("       CB3          = '1' ")
  SQL.ADD(" WHERE NrOperacion  = '"~VAL(A1)~"'  ")                                     
  SQL.NEW
EndIf

if Not Incluido(Val(w:1),'MMPCL|MMPCOS|VIMD|VIMIND|VIMINM')
  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   SET Book1       = Book2, ")
  SQL.ADD("       Book2       = Book1 ")
  SQL.ADD(" WHERE NrOperacion = '"~VAL(A1)~"'  ")                                     
  SQL.NEW
EndIf

** FJL 20/01/2012
** Update Campos operaciones sinteticas. Relacionadas con Prestamos en especies.
if Incluido(Val(w:1),'SECS|SECSV|SEVS|SEVSV|FXCS|FXCSV|FXVS|FXVSV|FCCPV|FCVPV')
  if Val(e:2)=1
    SQL.ADD("Update "~DBO~".OPERACIONES ")
    SQL.ADD("   SET NrOperacion5 = '"~Val(e:3)~"', ")
    SQL.ADD("       RB14         = "~FStr(Val(e:8),1,0)~", ")
    SQL.ADD("       CB14         = "~FStr(Val(e:11),1,0)~" ")
    SQL.ADD(" WHERE NrOperacion  = '"~VAL(A1)~"' ")
    SQL.NEW
  endif
endif

Message('Generando Instancias Operacion '~VAL(A1)~' Vinculada ...')
SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD(" (NrOperacion,NrBit,Valor) ")
SQL.ADD("  SELECT '"~VAL(A1)~"' As NrOperacion,NrBit,Valor ")
SQL.ADD("    FROM "~DBO~".OPERACIONESBITS ")
SQL.ADD("   WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW

*************** Las Operaciones Nuevas se generan en la Instancia 15 ************
if Not Incluido(Val(w:1),'MMPCL|MMPCOS|VIMD|VIMIND|VIMINM')
   SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD("   Set Valor       = '0' ")
   SQL.ADD(" Where NrOperacion = '"~Val(A1)~"' ")
   SQL.ADD("   and NrBit         =  '1'  ")
   SQL.NEW

   SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD("   Set Valor       = '1' ")
   SQL.ADD(" Where NrOperacion = '"~Val(A1)~"' ")
   SQL.ADD(" and NrBit         =  '15'  ") 
   SQL.NEW
EndIf
SQL.EXEC

Message('Generando Settlements Operacion '~VAL(A1)~' Vinculada ...')
SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
