**-- Actualiza la Operacion Original con el nro. de la vinculada
SQL.ADD("Update "~DBO~".OPERACIONES SET ")
SQL.ADD(" NrOperacion3='"~VAL(A1)~"' WHERE  NrOperacion='"~Dialogo.NrOperacion1~"' ")
