HojaVisible(NO)

ModoReproceso(SinDialogo)
CrearDialogo
  Especie1   : ''                ;;;;;;;;;
FinDialogo
IF Not Ok
  Cancelar
Endif

SQL.ADD(" Select Fecha, Cupon from "~DBO~".ESPECIES where  Codigo = '"~Dialogo.Especie1~"' ")
Recorrer SQL
    SQL.ADD("Insert into "~DBO~".AGENDACUPONES ( ")
    SQL.ADD("           especie,    tipocupon,    FechaCorte, FechaPago, ")
    SQL.ADD("           PorRenta,   PorAmCapital, NrCupon,    Estado, ")
    SQL.ADD("           PorAmIntCap ")
    
    SQL.ADD("           ) values ( ")
    
    SQL.ADD("           '"~Dialogo.Especie1~"', ")
    SQL.ADD("           'AMO', ")
    SQL.ADD("           '"~IdxDate(fbn['Fecha'])~"', ")
    SQL.ADD("           '"~IdxDate(fbn['Fecha'])~"',         ") 

    SQL.ADD("           0, ")
    SQL.ADD("           100, ")

** FJL 17/01/19 - Las especies ZeroCoupon puden ser cupon 0 o 1
*    SQL.ADD("           0, ")
    SQL.ADD("           "~Fstr(fbn('Cupon'),0,0)~", ")
    SQL.ADD("           'PEN', ")

    SQL.ADD("           0 ")
    SQL.ADD("           ) ")
    SQL.NEW
    SQL.EXEC
Proximo

MessageBox('Zero-cupon creado con exito!')
