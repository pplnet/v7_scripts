if (Incluido(Fbn()['TipoOp'], 'DTC|DTF|DTK|DTKVI|DTSFFM|DTSFVM|DTSFVX|DTSVVM|DTSNFV'))
Acn(i:fac, Fbn()['Fecha1'])
Acn(j:fac, Fbn()['Fecha2'])
