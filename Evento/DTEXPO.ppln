Acn(f:fac, Fbn('PrecioEj'))
Acn(g:fac, Fbn()['Cantidad'])
Acn(h:fac, Fbn()['NrCuota'])

if (Incluido(Fbn()['TipoOp'], 'DTSFV|DTSFF|DTSVV|DTSFVV'))
