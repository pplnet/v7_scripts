Sqladd("Select O.*,0 NrCuota,0 Cant1,0 Cant2,'' Fecha1,'' Fecha2,'' Fecha5,'' Fecha6,0 Cant8 ")
Sqladd("from "~Dbo()~".OPERACIONES O ")
Sqladd("where ")
Sqladd(" ((TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(dialogo.fecha1)~"' and O.FechaEj>='"~IdxDate(dialogo.fecha1)~"')   ")
Sqladd(" or (TipoOp IN ('DTO','DTOV') and O.FechaOp2<='"~IdxDate(dialogo.fecha1)~"' and O.FechaEj>'"~IdxDate(dialogo.fecha1)~"')) ")
if (NoVacio(Val(zz6)))
Sqladd(" and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
if (NoVacio(dialogo.especie1))
Sqladd(" and O.Especie='"~dialogo.especie1~"' ")
endif
Sqladd("  Union All ")
Sqladd("Select O.*,C.NrCuota, C.Cantidad1 Cant1,C.Cantidad2 Cant2,C.Fecha1,C.Fecha2,C.Fecha5,C.Fecha6,C.Cantidad8 Cant8 ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
Sqladd(" where O.NrOperacion = C.NrOperacion ")
Sqladd("  and ((TipoOp IN ('DTC','DTF','DTK','DTKVI','DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(dialogo.fecha1)~"' and C.Fecha2>'"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("  or (TipoOp IN ('DTOM','DTOMV') and  C.Fecha2>'"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(dialogo.fecha1)~"')) ")
if (NoVacio(Val(zz6)))
Sqladd(" and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
if (NoVacio(dialogo.especie1))
Sqladd(" and O.Especie='"~dialogo.especie1~"' ")
endif
Sqladd(" order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")

SetFilaActual(1)

recorrer sql

if (Incluido(Fbn()['TipoOp'], 'DTO|DTOV|DTSFV|DTSFF|DTSVV|DTSFVV'))
Acn(a:fac, Fbn('TCComCor2'))
else
Acn(a:fac, Fbn('Cant8'))
endif

Act(b:fac, Fbn()['NrOperacion'])
