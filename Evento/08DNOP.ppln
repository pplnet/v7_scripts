'Especie';f1..f:fac;NO;SI;;100;string;;RGB(232, 232, 255);
'Cantidad';g1..g:fac;NO;;;80;numero;'##,###,###.##';RGB(232, 232, 255);

'Confirma';x1..x:fac;SI;SI;;30;check;RGB(255, 255, 213);

'Cliente Dep.';a1..a:fac;NO;SI;;100;string;;RGB(232, 232, 255);
'Mercado Dep.';r1..r:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Cta. Dep ';m1..m:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Cta.Contable Dep.';u1..u:fac;NO;SI;;100;string;;RGB(232, 232, 255);


'Cliente Ret.';h1..h:fac;NO;SI;;100;string;;RGB(232, 232, 255);
'Mercado Ret.';s1..s:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Cta. Ret.';n1..n:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Cta.Contable Ret.';v1..v:fac;NO;SI;;100;string;;RGB(232, 232, 255);

'Vehiculo';q1..q:fac;NO;SI;;70;string;;RGB(232, 232, 255);

'Observaciones';o1..o:fac;SI;;;150;string;200;RGB(255, 255, 213);

finlistbox

if (not ok)
Cancelar('Evento Cancelado.')
endif

recorrer&i 1, Fac()


if (Val(x:&i) = 1)
Sqladd(" UPDATE "~Dbo()~".TRANSACCIONES2  SET ")
Sqladd(" CB5 = 0,                           ")
Sqladd(" Observaciones = '"~Val(o:&i)~"'    ")
Sqladd(" WHERE NrTrans  = '"~Val(b:&i)~"'   ")
