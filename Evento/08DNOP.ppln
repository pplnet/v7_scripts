creardialogo
nrtrans1:'NrTrans';;;;;;;;;;;;;;"NrTrans IN (SELECT B.NrOperacion FROM "~Dbo()~".OPERACIONESBITS B WHERE B.NrOperacion = NrTrans AND B.NrBit = 70 AND B.Valor = '1') "
vehiculo1: 'Vehiculo';;;;;;;;;Var('VEHICULODE')
check1: 'Lo llamo desde la Operacion';;;;NO;NO;;;;0
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" SELECT DISTINCT T.Cliente1,T.Cliente2, T.Especie, T.Cantidad1 , T.Vehiculo1,          ")
Sqladd(" T.NrTrans, T.Fecha1 , T.Fecha2 , T.TipoTr2, E.Nombre, T.Cuenta1, T.Cuenta2,           ")
Sqladd(" T.Mercado1, T.Mercado2, T.CuentaContable1, T.CuentaContable2,                         ")
Sqladd(" T.ConceptoPago, T.Book1, T.Observaciones                                              ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".ESPECIES E, "~Dbo()~".OPERACIONESBITS B          ")
Sqladd(" WHERE  T.Especie  = E.Codigo                                                          ")
Sqladd(" AND    T.NrTrans  = B.NrOperacion                                                     ")
Sqladd(" AND    T.TipoTr2 IN  ('TRNOP','DENOP','RENOP')                                        ")
Sqladd(" AND    B.Valor = '1'                                                                  ")
Sqladd(" AND    B.NrBit = 111                                                                  ")
Sqladd(" AND    IsNull(T.CB6,0)='0'                                                            ")
Sqladd(" AND    IsNull(T.CB5,0)='1'                                                            ")

if (NoVacio(dialogo.nrtrans1))
Sqladd(" AND  T.NrTrans = '"~dialogo.nrtrans1~"'                                            ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd(" AND  T.Vehiculo1 = '"~dialogo.vehiculo1~"'                                         ")
endif

Sqladd(" ORDER BY T.Cliente1, T.TipoTr2                                                        ")

Acn(z:1, 0)
recorrer sql

Acn(z:1, 1)

Act(a:fac, Fbn('Cliente1')~' - '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn('Cliente1')))
Act(b:fac, Fbn('NrTrans'))
Act(c:fac, Fbn('TipoTr2'))
Acd(d:fac, Fbn('Fecha2'))
Acd(e:fac, Fbn('Fecha1'))
Act(f:fac, Fbn('Especie')~' - '~Fbn('Nombre'))
Acn(g:fac, Fbn('Cantidad1'))

Act(m:fac, Fbn('Cuenta1'))
Act(r:fac, Fbn('Mercado1'))
Act(u:fac, Fbn('CuentaContable1'))

if (Incluido(Fbn('TipoTr2'), 'TRNOP'))

Act(m:fac, Fbn('Cuenta1'))
Act(n:fac, Fbn('Cuenta2'))
Act(r:fac, Fbn('Mercado1'))
Act(s:fac, Fbn('Mercado2'))
Act(u:fac, Fbn('CuentaContable1'))
Act(v:fac, Fbn('CuentaContable2'))
Act(h:fac, Fbn('Cliente2')~' - '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn('Cliente2')))
else

Act(n:fac, '')
Act(s:fac, '')
Act(v:fac, '')
Act(h:fac, '')

endif

Act(q:fac, Fbn('Vehiculo1'))
Act(o:fac, Fbn('Observaciones'))

Acn(x:fac, 0)

proximo

if (Val(z:1) = 0)
Cancelar('No se encontraron Movimientos no Operativos para Confirmar.')
endif

crearlistbox;'MS Sans SerIf,8,'
'Transaccion';b1..b:fac;NO;SI;;70;string;;RGB(232, 232, 255);
