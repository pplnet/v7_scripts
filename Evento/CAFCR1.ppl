ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'FCR|');'El TipoOp debe ser FCR';NO;;;;;;" TipoOp in ('FCR') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACFCR')
FinDialogo

If Not OK
  Cancelar
Endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

SQL.ADD("Select O.TipoOp, O.Cliente1,O.Especie,O.Vehiculo1,O.NrOperacion,O.Cuenta1,O.Cuenta2,O.TotalNetoCli1,O.ContraEspecie, ")
SQL.ADD("C.Localidad, C.Telefono, C.Fax,C.CUIT, C.RazonSocial, C.Direccion,C.CodigoPostal,C.PaisDir,C.Provincia, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O ,"~DBO~".CLIENTES C   ")
SQL.ADD(" Where NrOperacion ='"~Dialogo.NrOperacion1~"' and O.Vehiculo1=C.Codigo  ")
Recorrer SQL
  ACT(zd:99, fbn['TipoOp'])
  ACT(zz:98, fbn['ContraEspecie'])  
  ACT(za:99, fbn['Cuenta2']) 
  ACN(zb:99, fbn['TotalNetoCli1'])
  let &localidad fbn['Localidad']
  ACT(zz:99, fbn['Vehiculo1'])
  let &nrOperacion fbn['NrOperacion']
  ACT(ab:99, fbn['Cuenta1'])    
  ACT(ab:1,fbn['RazonSocial'])
  let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ])
  ACT(aa:1, BuscarCampo('ESPECIES','Nombre'     ,'Codigo',Fbn['Especie']))
  ACT(or:1, BuscarCampo('ESPECIES','Extendido'  ,'Codigo',Fbn['Especie']))
  ACT(ad:1,fbn['CUIT'])
  ACT(af:1, BuscarCampo('CUENTAS','CBU'         ,'Codigo',Fbn['Cuenta1']))
  ACT(af:2, BuscarCampo('CUENTAS','CBU'         ,'Codigo',Fbn['Cuenta2']))
  ACT(cc:1, BuscarCampo('ESPECIES','Codigo'     ,'Codigo',Fbn['Especie']))
  ACT(mm:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Cliente','Codigo',Fbn['Cuenta1'])))
  ACT(mm:2, BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Cliente','Codigo',Fbn['Cuenta2'])))
  ACT(af:99,BuscarCampo('CUENTAS','Alias9'       ,'Codigo',Fbn['Cuenta1']))
  ACT(ta:1,fbn['Telefono'])
  ACT(tb:1,fbn['Fax'])
  ACT(tc:1,fbn['Direccion'])
  ACT(td:1,fbn['CodigoPostal'])
  ACT(te:1,BuscarCampo('PAISES','Nombre','Codigo',fbn['PaisDir']))
  ACT(tf:1,BuscarCampo('PROVINCIAS','Nombre','Codigo',fbn['Provincia']))
  ACD(FE:1, fbn('FechaOp'))
if EqStr(val(zz:98),var('MONEEXTR')) 
   ACT(cc:88,'u$s' )
   ACT(cc:66,'dolares') 
   else
   if EqStr(val(zz:98),var('MONELOCA'))    
      ACT(cc:88,'$' )
      ACT(cc:66,'pesos')
      else     
      ACT(cc:88,val(zz:98) )
   endif  
endif
Proximo

let &fecha_larga FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)
let &usuario_activo UsuarioActivo

let &referencia ''

let &pieahorro1 ''
let &pieahorro2 ''
let &pieahorro3 ''
let &pieahorro4 ''
let &pieahorro5 ''
let &pieahorro6 ''

If EqStr(val(cc:1),var('AHORROPL'))

   let &oracion1 'De nuestra consideracion:' 
   
   let &oracion2 '       Por intermedio de la presente les solicitamos a ustedes RESCATE de la totalidad de cuotapartes del fondo '~val(aa:1)~' a nombre de '~val(ab:1)
   
   let &oracion31 '       Asimismo solicitamos que el producido de este rescate sea transferidos a nuestra cuenta '~val(za:99)~' CBU: '~val(af:2)~'  en '~val(mm:2)
   let &oracion32 ' y nos comprometemos a enviar el original de la presente nota a vuestras oficinas y a retirar los formularios de liquidacion correspondientes dentro de las 24 horas habiles.'

   let &oracion4 'Dejamos constancia que hemos recibido, conocemos y adherimos al Reglamento de Gestion del Fondo Comun de Inversion respectivo.'~Chr(13)~'Asimismo declaramos que:'~Chr(13)~'             ·'

   let &pieahorro1 var('PIEAHORRO1')
   let &pieahorro2 var('PIEAHORRO2')
   let &pieahorro3 var('PIEAHORRO3')
   let &pieahorro4 var('PIEAHORRO4')

   let &oracion5 Chr(13)~'             ·'

   let &pieahorro5 var('PIEAHORRO5')
   let &pieahorro6 var('PIEAHORRO6')

Else

   let &referencia 'Ref.: Rescate Fondos Comun de Inversion'

   let &oracion1 val(ab:1)~Chr(13)~'Cuenta cuotapartista nº '~val(af:99)~Chr(13)~'De nuestra consideracion:'

   let &oracion2 '       Por medio de la presente les solicitamos tengan a bien de rescatar pesos del Fondo Comun de Inversion que detallamos a continuacion:'
   
   let &oracion31 val(or:1)~' FCI por un total de ' ~val(cc:66)~' '~val(cc:88)~PYC(val(zb:99),0,0) ~'.-'
   let &oracion32 Chr(13)~'       Asimismo, les solicitamos y autorizamos a acreditar el total a nuestra Cuenta Corriente en pesos numero ' ~val(ab:99) ~' del '~val(mm:1)

   let &oracion4 Chr(13)~' C.B.U. '~val(af:1)
   let &oracion5 ''
      
  
Endif

let &razon_social2 val(ab:1)

let &cuit 'CUIT:'~val(ad:1)

let &telefono 'Tel: '~val(ta:1)
let &fax 'Fax: '~val(tb:1)
let &direccion val(tc:1)
let &datos_geograficos val(td:1)~'-'~val(tf:1)~'-'~val(te:1)

EmitirCartaVisible(&pf, Copy(Dialogo.String1,1,Longitud(Dialogo.String1)-5)~'_'~Dialogo.NrOperacion1, razon_social = &razon_social, localidad = &localidad, fecha_larga = &fecha_larga, usuario_activo = &usuario_activo, nr_operacion = &nrOperacion, referencia = &referencia, oracion1 = &oracion1, oracion2 = &oracion2, oracion31 = &oracion31, oracion32 = &oracion32, oracion4 = &oracion4, oracion5 = &oracion5, pieahorro1 = &pieahorro1, pieahorro2 = &pieahorro2, pieahorro3 = &pieahorro3, pieahorro4 = &pieahorro4, pieahorro5 = &pieahorro5, pieahorro6 = &pieahorro6, razon_social2 = &razon_social2, cuit = &cuit, telefono = &telefono, fax = &fax, direccion = &direccion, datos_geograficos = &datos_geograficos)
