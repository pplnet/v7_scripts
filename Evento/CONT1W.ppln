Acn(x1, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo = 'DIASCONT' "))
if (Val(x1) = 1)
Acn(x1, Trunc(Var('DIASCONT'), 0))
endif
if (Val(x1) < 1)
Acn(x1, 1)
endif
Acd(x2, Habiles(PriDeMes(dialogo.fecha1, SI) - 1, Val(x1), 'ARG'))
Acd(x3, Habiles(Val(x2), 1, 'ARG'))

Acd(v:1, dialogo.fecha1)
Acd(v:2, Habiles(PriDeMes(dialogo.fecha1), -1, 'ARG'))
Acd(v:3, Habiles(Val(v:2), 1, 'ARG'))

Message('--- Asientos de tenencia Futuros ---')


Sqladd(" SELECT O.NrOperacion, O.Contrato Especie, O.Especie ContraEspecie, ")
Sqladd("        O.FechaOp, O.FechaEx4 FechaVto, O.Cliente1, ")
Sqladd("        O.Vehiculo1, O.Especie Moneda, ")
Sqladd("        O.TipoOp, O.Cantidad, O.Precio1, ")
Sqladd("        C.CUIT, V.Valor1, V.Valor2, ")
Sqladd("        M.Codigo CodAsi, E.Tipo, E.Cotiza, 'Vto' TipoRes, O.Plazo, ")
Sqladd("        Case O.MB2 When 1 Then 'NONDF' Else 'NDF' END TipoFut, O.Observaciones, O.MB4, E.Alias8 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, ")
Sqladd("      "~Dbo()~".MODELOSASIENTO M, "~Dbo()~".ESPECIES E ")
Sqladd(" WHERE O.Cliente1    = C.Codigo ")
Sqladd(" AND   O.Vehiculo1   = V.Codigo ")
Sqladd(" AND   O.Especie     = E.Codigo ")
Sqladd(" AND   O.FechaEx4    = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND   O.TipoOp      IN ('MRF') ")
Sqladd(" AND   O.Vehiculo1 Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" and   M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFW'))~") ")
Sqladd(" AND M.Habilitado = 'SI' ")
Sqladd(" AND M.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif

if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") OR M.Vehiculo is null OR M.Vehiculo = '' OR M.Vehiculo = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" ORDER BY O.NrOperacion ")
recorrer sql
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(dialogo.fecha1)~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acd(d:fac, Fbn('FechaVto'))
Act(e:fac, Fbn('Especie'))
Act(f:fac, Fbn('ContraEspecie'))
Acn(g:fac, Fbn('Cantidad'))
Acn(h:fac, Fbn('Precio1'))
Acn(i:fac, CotizacionC(Fbn('Especie'), 'CON', null, null, dialogo.fecha1, 1, SI, Fbn('ContraEspecie')))
Acn(j:fac, Val(g:fac) * (Val(i:fac) - Val(h:fac)))
Acn(z1, Val(j:fac))
Acd(fv:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Acn(v1, 0)
Sqladd("Select FechaInicio, FechaFin    from "~Dbo()~".PERIODOSCONTABLES where ")
Sqladd("    Vehiculo = '"~Val(vh:1)~"' ")
recorrer sql
if (Fbn()['FechaInicio'] <= Val(fv:1))
else
Acd(fv:1, Fbn()['FechaInicio'])
endif
proximo


Acn(rs:1, Val(j:fac))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo

