creardialogo
nrorden:'Nr Orden';;;
nroperacion1:'Nr Operacion';;;
tipoop1:'Tipo Op';;;
cliente1:'ContraParte ';;;
fecha1:'FechaOp';;;
fecha2:'FechaVto';;;
cantidad1:'Cantidad';;;
radio1:'DELETE|NO|SI';;;;;NO;;;;0
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
if (Query("SELECT 1 FROM "~Dbo()~".EJECUCIONES WHERE NrOperacion='"~dialogo.nroperacion1~"' AND NrOrden='"~dialogo.nrorden~"'") = 1)
Acn(ca:1, BuscarCampo('EJECUCIONES', 'Cantidad', 'NrOperacion', dialogo.nroperacion1))
Acn(ca:2, dialogo.cantidad1 - Val(ca:1))
Sqladd(" UPDATE "~Dbo()~".ORDENES ")
Sqladd(" SET")
Sqladd(" CantidadCompletada= CantidadCompletada + ("~FStr(Val(ca:2), 0, 2)~") ")
Sqladd(" WHERE ")
Sqladd(" NrOrden='"~dialogo.nrorden~"'  ")
Sqlnew()
Sqlexec()
Sqladd(" UPDATE "~Dbo()~".EJECUCIONES ")
Sqladd(" SET")
Sqladd(" Cliente1='"~dialogo.cliente1~"',Cantidad="~FStr(dialogo.cantidad1, 0, 2)~",")
Sqladd(" Fecha1='"~IdxDate(dialogo.fecha1)~"',Fecha2='"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" WHERE ")
Sqladd(" NrOrden='"~dialogo.nrorden~"'  ")
Sqladd(" AND NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
else
Acn(ej:1, BuscarCampo('ORDENES', 'Lotes', 'NrOrden', dialogo.nrorden) + 1)

Sqladd(" INSERT INTO "~Dbo()~".EJECUCIONES ")
Sqladd(" (NrOrden, NrOperacion, NrEjecucion,")
Sqladd(" TipoOp, Cliente1, Fecha1, Fecha2, Cantidad) ")
Sqladd(" VALUES ( ")
Sqladd(" '"~dialogo.nrorden~"', '"~dialogo.nroperacion1~"', "~FStr(Val(ej:1), 0, 0)~", ")
Sqladd(" '"~dialogo.tipoop1~"', '"~dialogo.cliente1~"', ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~IdxDate(dialogo.fecha2)~"', "~FStr(dialogo.cantidad1, 0, 2)~" ) ")
Sqlnew()
Sqlexec()
Sqladd(" UPDATE "~Dbo()~".ORDENES ")
Sqladd(" SET")
Sqladd(" Lotes="~FStr(Val(ej:1), 0, 0)~", ")
Sqladd(" CantidadCompletada=CantidadCompletada + "~FStr(dialogo.cantidad1, 0, 2)~" ")
Sqladd(" WHERE ")
Sqladd(" NrOrden='"~dialogo.nrorden~"'  ")
Sqlnew()
Sqlexec()
endif
else
Acn(ne:1, BuscarCampo('EJECUCIONES', 'NrEjecucion', 'NrOperacion', dialogo.nroperacion1))
Acn(ca:1, BuscarCampo('EJECUCIONES', 'Cantidad', 'NrOperacion', dialogo.nroperacion1))
Sqladd("DELETE FROM "~Dbo()~".EJECUCIONES")
Sqladd("WHERE NrOperacion = '"~dialogo.nroperacion1~"'")
Sqladd("AND NrOrden = '"~dialogo.nrorden~"'")
Sqlnew()
Sqlexec()
Sqladd("UPDATE "~Dbo()~".EJECUCIONES")
Sqladd("SET NrEjecucion = NrEjecucion-1")
Sqladd("WHERE NrOrden = '"~dialogo.nrorden~"'")
Sqladd("AND NrEjecucion >= "~FStr(Val(ne:1), 0, 0)~"")
Sqlnew()
Sqlexec()
Sqladd("UPDATE "~Dbo()~".ORDENES")
Sqladd("SET Lotes = Lotes -1,")
Sqladd("CantidadCompletada=CantidadCompletada + ("~FStr(Val(ca:1) * (-1), 0, 2)~") ")
Sqladd("WHERE NrOrden = '"~dialogo.nrorden~"'")
Sqlnew()
Sqlexec()
endif
