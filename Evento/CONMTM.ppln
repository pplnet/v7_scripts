creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 > 0;'Fecha Invalida';NO;FSys()
vehiculo1: 'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
radio1:'Estado|OK|Dif|Manual';;;;NO;NO;;;;2;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(a1, 'OK')
else
if (dialogo.radio1 = 1)
Act(a1, 'DIF')
else
if (dialogo.radio1 = 2)
Act(a1, 'MAN')
else
Act(a1, 'ERR')
endif
endif
endif
Acn(b:1, Query("Select Count(*) From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' "))
if (Val(b:1) > 1)
Cancelar('Existe mas de un registro de conciliacio para el '~dialogo.fecha1)
endif
if (Val(b:1) = 1)
Act(a:2, Query("Select Estado From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' "))
if (dialogo.radio1 = 2)
Cancelar('Ya existe flag de Conciliacion para el '~dialogo.fecha1~' Estado: '~Val(a:2))
endif
endif
Acn(b:2, Query("Select Cantidad From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' "))
Acn(b:3, Val(b:2) + 1)

Act(c:1, Fecha(Hoy()))
Act(c:2, Copy(Val(c:1), 9, 2)~Copy(Val(c:1), 4, 2)~Copy(Val(c:1), 1, 2))
Act(d:1, Hora(Ahora()))
Act(d:2, Copy(Val(d:1), 1, 2)~Copy(Val(d:1), 4, 2)~Copy(Val(d:1), 7, 2))

if (Val(b:1) = 0)
Act(e:1, 'Insert')
Message('Insert Flag CONC')
Sqladd("Insert Into "~Dbo()~".FLAGSOCT ( ")
Sqladd("Fecha,    Registro, Paso,      Cantidad, ")
Sqladd("FechaMAE, HoraMAE,  Secuencia, Estado    ")
Sqladd(" ) Values ( ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd(" 'CONC', ")
Sqladd(" 0, ")
Sqladd(" "~FStr(Val(b:3), 1, 0)~", ")
Sqladd(" '"~Val(c:2)~"', ")
Sqladd(" '"~Val(d:2)~"', ")
Sqladd(" Null, ")
Sqladd(" '"~Val(a:1)~"' ")
Sqladd(" ) ")
Sqlnew()
else
Act(e:1, 'Update')
Message('Update Flag CONC')
Sqladd("Update "~Dbo()~".FLAGSOCT ")
Sqladd("   Set Cantidad   = "~FStr(Val(b:3), 1, 0)~", ")
Sqladd("       FechaMAE   = '"~Val(c:2)~"', ")
Sqladd("       HoraMAE    = '"~Val(d:2)~"', ")
Sqladd("       Estado     = '"~Val(a:1)~"' ")
Sqladd(" where Fecha      = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Registro   = 'CONC' ")
Sqlnew()
endif
Sqlexec()

