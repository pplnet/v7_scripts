creardialogo
radio1:'Tipo|Activa|Borrada';;;;NO;NO;;;;0;
nrorden1:'# Orden:';;;;dialogo.radio1 = 0;dialogo.radio1 = 0;NoVacio(dialogo.nrorden1) y Eqstr(BuscarCampo('ORDENES', 'TipoOrden', 'NrOrden', dialogo.nrorden1), 'TMANIF');;;;;;;;" TipoOrden in ('TMANIF')";;;;;
string1:'# Alta Mae :';;;;;;;;;;iif (dialogo.radio1 = 0, BuscarCampo('ORDENES', 'NroAltaMAE', 'NrOrden', dialogo.nrorden1), BuscarCampo('ORDENES', 'NroAltaMAE', 'NrOrden', dialogo.nrorden1));;;'99999';
fecha1:'Fecha Alta Mae:';;;;;;;;;;iif ((dialogo.radio1 = 0 y Vacio(dialogo.nrorden1)) o (dialogo.radio1 = 1 y Vacio(dialogo.nrorden1)), FSys(), iif (dialogo.radio1 = 0, BuscarCampo('ORDENES', 'FechaAltaMAE', 'NrOrden', dialogo.nrorden1), BuscarCampo('BORDENES', 'FechaAltaMAE', 'NrOrden', dialogo.nrorden)));
entero1:'Hora:';;;;;;dialogo.entero1 < 24;'La hora no puede ser superior a 24';NO;;Num(Copy(dialogo.string5, 1, 2))
entero2:'Minutos:';;;;;;dialogo.entero2 < 60;'Los minutos no pueden ser superiores a 60';NO;;Num(Copy(dialogo.string5, 4, 2))
entero3:'Segundos:';;;;;;dialogo.entero3 < 60;'Los segundos no pueden ser superiores a 60';NO;;Num(Copy(dialogo.string5, 7, 2))
string5:'Hora';;;;NO;NO;;;;;iif (dialogo.radio1 = 0, Hora(BuscarCampo('ORDENES', 'FechaAltaMAE', 'NrOrden', dialogo.nrorden1)), Hora(BuscarCampo('BORDENES', 'FechaAltaMAE', 'NrOrden', dialogo.nrorden1)));
findialogo

if (not ok)
Cancelar()
endif

Act(a2, Copy(dialogo.fecha1, 7, 4)~'-'~Copy(dialogo.fecha1, 4, 2)~'-'~Copy(dialogo.fecha1, 1, 2)~' '~FStr(dialogo.entero1, 2, 0)~':'~FStr(dialogo.entero2, 2, 0)~':'~FStr(dialogo.entero3, 2, 0))

Sqladd("Update ")
if (dialogo.radio1 = 0)
Sqladd(" "~Dbo()~".ORDENES SET         ")
else
Sqladd(" "~Dbo()~".BORDENES SET         ")
endif
Sqladd("NroAltaMAE    = '"~dialogo.string1~"', ")
Sqladd("FechaAltaMAE  = Convert(datetime,'"~Val(a2)~"',120), ")
Sqladd("FechaEnvioMAE = Convert(datetime,'"~Val(a2)~"',120), ")

Sqladd("AceptaMAE = 'SI' ")

if (dialogo.radio1 = 0)
Sqladd("where NrOrden = '"~dialogo.nrorden1~"'")
else
Sqladd("where NrOrden = '"~dialogo.nrorden1~"'")
endif
Sqlnew()
Sqlexec()

Messagebox('Orden modificada con exito')

