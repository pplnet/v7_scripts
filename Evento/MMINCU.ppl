**- MMINCU: Ingreso de Settlement FRN y Sindicado
**- Permite modificar aquellas operaciones que no son definitivas
CrearDialogo
   NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1) Y Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMFCMV|MMSCMV');'Debe Ingresar un MMFCMV o MMSCMV';NO;
   Entero1      : "Nro. Settlement"          ;1;2;;NO;Novacio(Dialogo.NrOperacion1);;;;BuscarCampo('Operaciones','Cuotas1','NrOperacion',Dialogo.NrOperacion1)+1;BuscarCampo('Operaciones','Cuotas1','NrOperacion',Dialogo.NrOperacion1)+1
   Cliente1     : "Ent. Arranger"            ;3;1;;NO;;;;;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
   Cliente2     : "Ent. Agente"              ;3;2;;NO;;;;;;BuscarCampo('Operaciones','Cliente2','NrOperacion',Dialogo.NrOperacion1)
   Fecha2       : "F.Inicio"                 ;5;1;;NO;;;;;;SQL("SELECT Fecha2 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1-1,2,0)~" ")
   Entero2      : "Plazo"                    ;;;;;;Dialogo.Entero2>=0;'EL PLAZO DEBE SER POSITIVO';NO;Dialogo.Fecha3-Dialogo.Fecha2;Dialogo.Fecha3-Dialogo.Fecha2
   Fecha3       : "F.Fin"                    ;;;;;;[NOVACIO(Dialogo.Fecha3) Y ESHABIL(Dialogo.Fecha3,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1)) Y ESHABIL(Dialogo.Fecha3,'ARG')];'La Fecha de Fin de Periodo debe ser dia habil';NO;Dialogo.Fecha2 + Dialogo.Entero2;Dialogo.Fecha2 + Dialogo.Entero2
   Fecha4       : "F. Settl."                ;;;;;;[NOVACIO(Dialogo.Fecha4) Y ESHABIL(Dialogo.Fecha4,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1)) Y ESHABIL(Dialogo.Fecha4,'ARG')];'Fecha de SETTLEMENT del Periodo Incorrecta';NO;Dialogo.Fecha2 + Dialogo.Entero2;Dialogo.Fecha2 + Dialogo.Entero2
   Precio1      : "Tasa Amort."              ;5;2;;;;(Dialogo.Precio1 + BuscarCampo('Operaciones','TotalBrutoCli1','NrOperacion',Dialogo.NrOperacion1))<=100;'La Sumatoria de Tasa de Amortizacion excede el 100 %';NO;0;
   Precio2      : "Tasa Int."                ;7;2;;;;Dialogo.Precio2<=VAR('RTASA2') Y Dialogo.Precio2>=VAR('RTASA1');'TASA DE INTERES FUERA DE RANGO:'~VAR('RTASA1')~" Y "~VAR('RTASA2');NO;IIF(EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA'), SQL("SELECT Precio2 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1-1,2,0)~" "),0);IIF(EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA'), SQL("SELECT Precio2 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1-1,2,0)~" "), 0)
   Precio3      : "Spread"                   ;;;;;NOT EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA');EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA') O [NOT EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA') y Dialogo.Precio3>=VAR('RSPREAD1') Y Dialogo.Precio3<=VAR('RSPREAD2')];'Spread Fuera de Rango '~VAR('RSPREAD1')~' Y '~VAR('RSPREAD2');NO;;
   Precio4      : 'Tasa Int WH'              ;;;;;;Dialogo.Precio4>0;'El Valor de Tasa Interes WH es Invalido ';NO;;Dialogo.Precio2+Dialogo.Precio3;;;
   Precio5      : 'Tasa Int IVA'             ;;;;;;Dialogo.Precio5>0;'El Valor de Tasa Interes IVA es Invalido ';NO;Dialogo.Precio2+Dialogo.Precio3;;;
   Precio6      : "TTN"                      ;;;;;;Dialogo.Precio6>=VAR('RTTN1') Y Dialogo.Precio6<=VAR('RTTN2');'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');SI;;
FinDialogo

If Not Ok
  Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
(.'CONTROLVH'.)

* Verifico que se encuentre en Back Office o Terminal
ACN(x1,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS  WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
*   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("SELECT Nombre FROM "~DBO~".INSTANCIAS  WHERE NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf


* Verifico que todos los participantes esten tambien en estas instancias
SQL.ADD("SELECT O.NrOperacion,NrBit,Valor ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE  O.OperacionRef = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("       and O.NrOperacion = B.NrOperacion ")
SQL.ADD("       and Valor='1' ")

ACN(X1,0)

Recorrer SQL
   ACN(X1,FBN['NrBit'])

   If FBN['NrBit']<>20 y FBN['NrBit']<>50
      *-- Busco la instancia actual
      *Cancelar("La OperaciOn Participante "~FBN['NrOperacion']~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("SELECT Nombre FROM "~DBO~".INSTANCIAS  WHERE NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
   EndIf
Proximo

*-- VERIFICA QUE LA OPERACION SEA SIN PERIODOS COMPLETOS EN LA CONCERTACION
If BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1) = 0
   Cancelar ('Esta Operacion tiene todos sus Periodos Ingresados !!')
Else
   *-- Verifico si debo solicitar los datos de CPI
   *-- y1: NrOperacion y2: Nro. Settlement y3: Tasa Amort y4: Fecha Inicio
   *-- y5: Plazo  y6: FechaFin y7: Fecha Settlement y8: TasaInt y9: Spread  y14: TTN
   *-- y17: Tasa Int IVA y18: Tasa Int WH
   ACT(y1,Dialogo.NrOperacion1)
   ACN(y2,Dialogo.Entero1)
   ACN(y32,Dialogo.Entero1-1)
   ACN(y3,Dialogo.Precio1)
   ACD(y4,Dialogo.Fecha2)
   ACN(y5,Dialogo.Entero2)
   ACD(y6,Dialogo.Fecha3)
   ACD(y7,Dialogo.Fecha4)
   ACN(y8,Dialogo.Precio2)
   ACN(y9,Dialogo.Precio3)
   ACN(y14,Dialogo.Precio6)
   ACN(y17,Dialogo.Precio4)
   ACN(y18,Dialogo.Precio5)

   *-- Pido los datos para los Calls o Puts
   ACN(y19,0)
   If Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMFCMV')
      CrearDialogo
         Radio1       : "Calls/Puts|No|Si"         ;;;;;;;;;0;
         NrOperacion1 : "Operacion"                ;1;2;;NO;Dialogo.Radio1=1;NoVacio(Dialogo.NrOperacion1);'DEBE INGRESAR UNA OPERACION';NO;VAL(Y1)
         Fecha2       : "Fecha Ej."                ;3;1;;;Dialogo.Radio1=1;Dialogo.Fecha2>BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1);'La Fecha de Ejercicio Debe Ser Mayor al Origen';NO;VAL(y7)
         Radio2       : "Tipo|Call|Put"            ;;;;;Dialogo.Radio1=1;;;;0;
         Precio10     : "Precio Ej"                ;;;;;Dialogo.Radio1=1;Dialogo.Precio10>0;'No se Ha Encontrado una Opcion de Precancelacion para Esta Fecha';NO;100;
      FinDialogo

      If Not Ok
         Cancelar
      Endif

      * y19: Ingresa Calls o Puts  y20: Fecha Ejercicio
      ACN(y19,Dialogo.Radio1)
      ACD(y20,Dialogo.Fecha2)
      ACT(y21,IIF(Dialogo.Radio2=0,'CAL','PUT'))
      ACN(y22,Dialogo.Precio10)
   EndIf

   SQL.ADD("SELECT * FROM "~DBO~".COMISIONES2 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion1~"' and Tipo='3' ")

   ACN(Z1,0)
   Recorrer SQL
      If FBN['NrCuota']<>0
         * La CPI no es General 
         ACN(Z1,1)                
      EndIf
   Proximo

   *-- y10 Calculo del Imp. de Amortizacion por Cuota  y11: Valor Nominal de la Cuota
   *-- y12: Imp.Amor Orig
   SQL.ADD("SELECT RB8,Cuotas1,Cantidad,CantidadOri,TotalBrutoCli1 FROM "~DBO~".OPERACIONES ")
   SQL.ADD("WHERE  NrOperacion='"~val(y1)~"'  ")
   Recorrer SQL
      dfa
      ACN(y10, FBN['Cantidad']*VAL(y3)/100 )
      ACN(y12, FBN['CantidadOri']*VAL(y3)/100 )
      ACN(u5,  FBN['TotalBrutoCli1'])
      ACN(d1,  FBN['Cuotas1']+1)
      ACN(y25, FBN['RB8'])
   Proximo

   SQL.ADD("SELECT (Cantidad2-Cantidad1) VResidual,(Cantidad2Ori-Cantidad1Ori) VResidualOri,Coeficiente FROM "~DBO~".CUOTAS WHERE NrOperacion='"~VAL(y1)~"' and NrCuota="~Fstr(VAL(y2)-1,0,0)~" ")

   Recorrer SQL
      dfa
      ACN(y11,FBN['VResidual'])
      ACN(y13,FBN['VResidualOri'])
      ACN(ce2,FBN['Coeficiente'])
   Proximo

   *- y14: Resultado Indice
   ACN(y14,VAL(y10)-val(y12))
   
   If Val(z1)=1
      CrearDialogo
         NrOperacion1 : "Operacion"                ;1;1;;NO;  ;NoVacio(Dialogo.NrOperacion1);'DEBE INGRESAR UNA OPERACION';NO;VAL(Y1)
         Especie1     : "Especie"                  ;;;;;;NOVACIO(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie';NO;
         Cliente1     : "Destinatario"             ;;;;;;NOVACIO(Dialogo.Cliente1);'DEBE INGRESAR EL DESTINATARIO';NO
         Radio1       : "Estranjero?|Loc|Ext"      ;;;;NO;NO;;;;;IIF(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
         Entero1      : "Nro. Settlement"          ;1;2;;NO;Novacio(Dialogo.NrOperacion1);;;;VAL(y2)
         Precio2      : "Tasa IVA"                 ;2;2;;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o INCLUIDO(FSTR(Dialogo.Precio2,2,2),VAR('IVA'));"EL VALOR DE LA TASA IVA ES ERRONEO: "~VAR('IVA');NO;VAR('TASAIVA');IIF(Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio2)
         Precio3      : "Tasa WH"                  ;3;2;;Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o Incluido(Fstr(Dialogo.Precio3,2,4),VAR('TASAWH'));'EL VALOR DE LA TASA WH ES ERRONEO: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');IIF(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio3)
         Precio4      : "% Imp.Int"                ;;;;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o INCLUIDO(FSTR(Dialogo.Precio4,2,4),VAR('TASAINT'));"El Valor de TASA INTERES es Erroneo: "~VAR('TASAINT');NO;VAR('DEFAINT');IIF(Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio4)
         Precio1      : "Tasa Comision"            ;;;;;;Dialogo.Precio1>0;'Debe Ingresar una Tasa Comision';NO;;(Dialogo.Cantidad1*IIF(Dialogo.Radio2=0,36000,36500)) /(VAL(y11)*VAL(y5))
         Cantidad1    : "Importe"                  ;;;;;;;;;;(VAL(y11)*Dialogo.Precio1*val(y5))/IIF(Dialogo.Radio2=0,36000,36500);;;"###,###,###,###.##"
         Radio2       : "UT|360|365"               ;;;;;;;;;1;     
     FinDialogo

     If Not Ok
        Cancelar
     EndIf
   EndIf

   *-- y23: Interes Cabecera y24: Monto Cabecera
   ACN(y23,Val(y11)*((Val(y9)+Val(y8))/100)*FACTORDIAS(Val(y4),Val(y6),Val(y25)+1))

   ACN(y24,VAL(y10)+VAL(y23))

   SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
   SQL.ADD("(NrOperacion, NrCuota, ")
   SQL.ADD(" Tasa1, Fecha1, Plazo1, Fecha3, ")
   SQL.ADD(" Fecha2, Precio2, Precio4, ")
   SQL.ADD(" Total3,Cantidad1,Cantidad2,")
   SQL.ADD(" Tasa2,Total6, Precio5,")
   SQL.ADD(" Cantidad3,Total2,Cotizacion1,")
   SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,ResultadoIndice")
   SQL.ADD(" ) ")
   SQL.ADD("Values")
   SQL.ADD("('"~VAL(Y1)~"', "~Fstr(val(d1),2,0)~", ")
   SQL.ADD(" "~Fstr(VAL(y3),0,6)~", '"~IdxDate(VAL(y4))~"', "~Fstr(VAL(y5),2,0)~", '"~IdxDate(VAL(y7))~"', ")
   SQL.ADD(" '"~IdxDate(VAL(y6))~"', "~Fstr(VAL(y8),0,6)~", "~Fstr(VAL(y9),0,6)~", ")
   SQL.ADD(" "~Fstr(VAL(y14),0,6)~","~Fstr(VAL(y10),0,2)~","~Fstr(VAL(y11),0,2)~",")
   SQL.ADD(" "~Fstr(VAL(y17),0,6)~","~Fstr(VAL(y18),0,6)~", "~Fstr(VAL(y23),0,2)~",")
   SQL.ADD(" "~Fstr(VAL(y23),0,2)~","~Fstr(VAL(y24),0,6)~",-1,")
   SQL.ADD(" "~Fstr(val(ce2),0,8)~","~Fstr(val(y12),0,2)~","~Fstr(val(y13),0,2)~","~Fstr(val(y14),0,2)~" ")
   SQL.ADD("  ) ")
   SQL.NEW

   *** actualiza la cantidad de periodos de la parte fija mas la tasa de amortizacion total
   acn(u5, val(u5)+VAL(y3))

   SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
   SQL.ADD("Set")
   SQL.ADD("Cuotas1 = "~Fstr(VAL(y2),2,0)~", ")

   * Actualiza el Definitivo
   IF val(u5)=100
      SQL.ADD("RB9= '0', ")
   EndIf

   SQL.ADD("TotalBrutoCli1 = "~Fstr(val(u5),2,0)~" ")
   SQL.ADD("WHERE NrOperacion = '"~VAL(y1)~"' ")
   SQL.NEW

   *-- Inserto la Nueva Comision CPI si corresponde
   If VAL(z1)=1

      *-- Obtengo el ultimo nro de Comision
      ACN(y13,SQL("SELECT MAX(NrComision) FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~VAL(y1)~"' ")+1)

      * y15: TasaIVA  y16:TasaWH  y26: Tasa Imp.Interes

      ACN(y15,IIF(Dialogo.Radio1=0,Dialogo.Precio2,0))
      ACN(y16,IIF(Dialogo.Radio1=1,Dialogo.Precio3,0))
      ACN(y26,IIF(Dialogo.Radio1=1,Dialogo.Precio4,0))

      SQL.ADD(" Insert Into "~DBO~".COMISIONES2 ")
      SQL.ADD(" (NrOperacion,Tipo,Tasa1,Importe1,")
      SQL.ADD(" Especie1,Fecha1,Cliente1,")
      SQL.ADD(" Tasa2,Importe2,")
      SQL.ADD(" Tasa3,Importe3,")
      SQL.ADD(" RB2, Importe4, NrComision,NrCuota,Precio1,Precio2,Cotizacion1,Cotizacion2) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~VAL(y1)~"','3',"~Fstr(Dialogo.Precio1,0,5)~","~Fstr(Dialogo.Cantidad1,0,2)~",")
      SQL.ADD(" '"~Dialogo.Especie1~"','"~IdxDate(VAL(y6))~"','"~Dialogo.Cliente1~"',")
      SQL.ADD(" "~Fstr(VAL(y15),0,5)~","~Fstr(VAL(y15)*Dialogo.Cantidad1/100,0,2)~",")
      SQL.ADD(" "~Fstr(VAL(y16),0,5)~","~Fstr(VAL(y16)*Dialogo.Cantidad1/100,0,2)~",")
      SQL.ADD(" '"~FStr(Dialogo.Radio2,0,0)~"', ")
      SQL.ADD(" "~Fstr(Dialogo.Cantidad1+( VAL(y16)*Dialogo.Cantidad1 /100 ),0,2)~", ")
      SQL.ADD(" "~Fstr(VAL(y13),0,0)~","~Fstr(Dialogo.Entero1,0,0)~","~Fstr(VAL(y26),0,5)~","~Fstr(VAL(y26)*Dialogo.Cantidad1/100,0,2)~",-1,-1 ) ")
      SQL.NEW
   EndIf 

   If VAL(y19)=1
      * Inserto Calls o Puts en Cabecera
      SQL.ADD(" INSERT INTO "~DBO~".OPSCALLSPUTS ")
      SQL.ADD(" (NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida) VALUES ")
      SQL.ADD(" ('"~VAL(y1)~"','"~VAL(y21)~"','"~IdxDate(VAL(y20))~"',"~Fstr(VAL(y22),0,0)~",'0') ")
      SQL.NEW
   EndIf
   SQL.EXEC         

   * Actualizo la Instancia de la Operacion a Supervision
   (.'MODIINSTAN'.)      

   *** Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(VAL(y1),SI)
   SQL.EXEC

   *** ingresa el periodo en las participantes
   SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES ")
   SQL.ADD("WHERE OperacionRef = '"~VAL(y1)~"' ")

   Recorrer SQL
     *** asigno el vn actual para un calculo posterior
     acn (m1, fbn['Cantidad'])

     *** actualiza cantidad de periodos parte fija participante
     SQL.ADD("UPDATE "~DBO~".OPERACIONES SET ")
     SQL.ADD(" Cuotas1 = "~Fstr(VAL(y2),2,0)~" ")
     SQL.ADD(" WHERE NrOperacion='"~fbn['NrOperacion']~"' ")
     SQL.NEW
     SQL.EXEC

     * insert inicial con datos sin calculos
     SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
     SQL.ADD(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
     SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
     SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
     SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
     SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
     SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
     SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
     SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
     SQL.ADD(" Cantidad7,Cantidad8, ")
     SQL.ADD(" Coeficiente, Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice) ")

     SQL.ADD(" SELECT '"~fbn['NrOperacion']~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
     SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
     SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
     SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
     SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
     SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
     SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
     SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
     SQL.ADD(" Cantidad7,Cantidad8, ")
     SQL.ADD(" Coeficiente, Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice ")
     SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~VAL(y1)~"' ")
     SQL.ADD(" and NrCuota= "~Fstr(VAL(y2),2,0)~" ")
     SQL.NEW
     SQL.EXEC

     * u1: tasa am. periodo anterior u2: imp am. periodo anterior u3: vn periodo anterior u4: Coeficiente
     SQL.ADD("Select Tasa1,Cantidad4,Cantidad2,Coeficiente,(Cantidad2Ori-Cantidad1Ori) as VROrig from "~DBO~".CUOTAS WHERE ")
     SQL.ADD("NrOperacion='"~fbn['NrOperacion']~"' and NrCuota="~Fstr(val(y32),2,0)~" ")

     Recorrer SQL
        ACN(u1,FBN['Tasa1'])
        ACN(u2,FBN['Cantidad4'])
        ACN(u3,FBN['Cantidad2'])
        ACN(u4,FBN['Coeficiente'])
        ACN(cs2,FBN['VROrig'])
     Proximo

     * A3 vn del periodo
     * M3 ES EL IMPORTE DE AMORTIZACION

     acn(a3, val(u3) - val(u2))
     acn(m3, VAL(y3) * val(m1) / 100)

     * TASA IVA A20 WH A21 a40: Tasa Imp.Intereses
     ACN (A20, fbn['ImpGastos2'])
     ACN (A21, fbn['TotalAux1'])
     ACN (A40, fbn['TasaImp1'])

     ACN (A23, fbn['TotalAux2'])

     * UT IVA A24 WH A25
     ACT (A24, fbn['RB7'])
     ACT (A25, fbn['RB9'])

     * LOCAL O EXTRANJERO
     ACT (A26, fbn['CB10'])


     ******************** 
     * A4 es el interes
     * A5 es el monto
     * A6 es el monto total
     * A7 es el importe iva
     * A8 es el importe wh
     * A41 es el importe Impuesto Intereses
     * A9 es el interes total
     * A30 Y 31 360 O 365 PARA IVA Y WH
     * PARA LOCAL O EXTRANJERO

     ACN(A7,0)
     ACN(A8,0)
     ACN(A41,0)

     If VAL(A20)<>0
        * Si la Tasa de IVA es Positiva
        * PARA UT
        IF EQSTR(VAL(A24),'0')
           ACN(A30,360)
        ELSE
           ACN(A30,365)
        ENDIF
        ACN (A7, ((val(a3)*VAL(Y17)/100)* FACTORDIAS(VAL(y4),VAL(y6),fbn['RB8']+1))*(VAL(A20)/100))
     EndIf

     * INTERES
     acn (a4, val(a3) * ((VAL(y8)+VAL(y9))/100) * FACTORDIAS(VAL(y4),VAL(y6),fbn['RB8']+1))

     IF EQSTR (val(A26), '0')
        If EqStr(FBN['TipoOp'],'MMSIMV')
           * Calculo del Impuesto a los Intereses
           ACN(a41, VAL(A4)*VAL(A40)/100)
        EndIf
     ELSE
        If EqStr(FBN['TipoOp'],'MMFIMV')
           * Calculo del Impuesto a los Intereses
           ACN(a41, VAL(A4)*VAL(A40)/100)
        EndIf
        IF EQSTR(VAL(A25),'0')
           ACN(A31,360)
        ELSE
           ACN(A31,365)
        ENDIF
        ACN (A8, ((val(a3)*VAL(Y18)/100)*FACTORDIAS(VAL(y4),VAL(y6),fbn['RB8']+1))*(VAL(A21)/100))
     ENDIF

     * INTERES TOTAL
     acn (a9, val(a4) + val(a8)+val(a41))

     * MONTO
     ACN (A5, VAL(m3)+VAL(A4))

     * MONTO TOTAL
     ACN (A6, VAL(m3)+VAL(A9))

     *- Cantidad1Ori, Cantidad2Ori, ResultadoIndice
     ACN(cs1,FBN['CantidadOri']*val(y3)/100)
     ACN(cs4,val(a3)-val(cs1))
     

     SQL.ADD("UPDATE "~DBO~".CUOTAS SET ")
     SQL.ADD(" Cantidad2= "~Fstr(VAL(A3),0,2)~", ")
     SQL.ADD(" Cantidad3= "~Fstr(VAL(A4),0,2)~", ")
     SQL.ADD(" Precio1= "~Fstr(VAL(A7),0,6)~", ")
     SQL.ADD(" Precio6= "~Fstr(VAL(A7),0,6)~", ")
     SQL.ADD(" Precio3= "~Fstr(VAL(A8),0,6)~", ")
     SQL.ADD(" Precio7= "~Fstr(VAL(A8),0,6)~", ")
     SQL.ADD(" Total2= "~Fstr(VAL(A5),0,6)~", ")
     SQL.ADD(" Total1= "~Fstr(VAL(A6),0,6)~", ")
     SQL.ADD(" Cantidad4= "~Fstr(val(m3),0,2)~", ")
     SQL.ADD(" Total9   = "~Fstr(val(a41),0,2)~", ")
     SQL.ADD(" Cotizacion1 = -1, ")
     SQL.ADD(" Cantidad5= "~Fstr(val(a9),0,2)~", ")
     SQL.ADD(" Cantidad1Ori= "~Fstr(val(cs1),0,2)~", ")      
     SQL.ADD(" Cantidad2Ori= "~Fstr(val(cs2),0,2)~", ")
     SQL.ADD(" Coeficiente= "~Fstr(val(u4),0,8)~",")
     SQL.ADD(" ResultadoIndice= "~Fstr(val(cs4),0,2)~" ")
     SQL.ADD(" WHERE NrOperacion='"~fbn['NrOperacion']~"' ")
     SQL.ADD(" AND NrCuota="~FStr(VAL(y2),2,0)~" ")
     SQL.NEW

     If VAL(y19)=1
        * Inserto Calls o Puts en Cabecera
        SQL.ADD(" INSERT INTO "~DBO~".OPSCALLSPUTS ")
        SQL.ADD(" (NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida) VALUES ")
        SQL.ADD(" ('"~FBN['NrOperacion']~"','"~VAL(y21)~"','"~IdxDate(VAL(y20))~"',"~Fstr(VAL(y22),0,0)~",'0') ")
        SQL.NEW
     EndIf

     SQL.EXEC

     * Inserto al Nueva Comision en la Participante
     EjecutarEvento('INCOMV',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=fbn['NrOperacion'],String=" Tipo  IN ('3') and NrCuota="~FStr(VAL(y2),0,0)~" ",String1=" NrCuota="~FStr(VAL(y2),0,0)~" " )

     * Actualizo la Instancia de la Operacion a Supervision
     ACT(i3,fbn['NrOperacion'])

     (.'MODIINSTAN'.)      

     *** Actualiza movimientos y limites ****
     SQL.ActualizarMovimientos(fbn['NrOperacion'],SI)
     SQL.EXEC
   Proximo
ENDIF