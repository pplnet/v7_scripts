MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;
findialogo

if (not ok)
raise('Evento Cancelado')
endif

if (dialogo.radio1 = 0 o dialogo.radio1 = 4)
Message('--- Asientos de Custodia ---')
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))
Act(ta:1, Var('TIPASICUST'))
Act(vc:1, dialogo.vehiculo1)
Acn(na:1, Var('ASINUM'))
Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha1 Fecha, T.Vehiculo1, T.Cantidad1 as Cantidad, MA.Codigo CodAsi, T.Cuenta1, T.Cuenta2, ")
Sqladd("       CU1.CuentaContable1 CuentaOrigen, CU2.CuentaContable1 CuentaDestino, ")
Sqladd("CASE T.TipoTr2 when 'RTP' then 'Retiro de ' when 'DTP' then 'Deposito de ' else rtrim(T.TipoTr2) + ', ' end ")
Sqladd("+ rtrim(T.Especie) + ' (' + rtrim(T.NrTrans) + ')' Leyenda, T.Especie, T.Cantidad4 Cantidad1, T.Cantidad4 Cantidad2, T.RB3 Bloqueado, T.TipoTr2 as TipoOp, T.Cliente1 Cliente, T.Vehiculo1, E.MonedaEmision, E.Cotiza,  ")
Sqladd(" T.Cuenta1 CtaDestino, T.Cuenta2 CtaOrigen, T.ConceptoPago Concepto, T.Book1, E.Tipo TipoEspecie, ")
Sqladd(" 'TIC' TipoOpC, 'TIV' TipoOpV, E.Issuer,T.Cliente1, '' ConceptoDest, '' ConceptoOri, T.NrOperacionRef2 NrOperacion ")
Sqladd("FROM "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".MERCADOS M, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" LEFT JOIN CUENTAS CU1 ON (T.Cuenta1 = CU1.Codigo) ")
Sqladd(" LEFT JOIN CUENTAS CU2 ON (T.Cuenta2 = CU2.Codigo) ")
Sqladd(" ,"~Dbo()~".ESPECIES E ")
Sqladd("WHERE T.NrTrans = B.NrOperacion ")
Sqladd(" AND T.Especie = E.Codigo ")
Sqladd("AND T.TipoTr2 = MA.TipoTr2 AND MA.TipoAsiento = '"~Var('TIPASICUST')~"' ")
Sqladd("AND (T.TipoTr2 = 'DTP' OR T.TipoTr2 = 'RTP') ")
        *solo se contabilizaran las dtp y rtp de terceros y manuales,
Sqladd("AND ((T.CB6 =0 AND T.Cliente1 <> T.Vehiculo1)) ")
    **
Sqladd("AND B.Valor = 1 AND B.NrBit = 70 ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd("AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd("AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("AND T.Mercado1 = M.Codigo ")

Sqladd("UNION ALL ")
Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha1 Fecha, T.Vehiculo1, T.Cantidad1 as Cantidad, MA.Codigo CodAsi, T.Cuenta1, T.Cuenta2, ")
Sqladd("       CU1.CuentaContable1 CuentaOrigen, CU2.CuentaContable1 CuentaDestino, ")
Sqladd("CASE T.TipoTr2 when 'RTP' then 'Retiro de ' when 'DTP' then 'Deposito de ' else rtrim(T.TipoTr2) + ', ' end ")
Sqladd("+ rtrim(T.Especie) + ' (' + rtrim(T.NrTrans) + ')' Leyenda, T.Especie, T.Cantidad4 Cantidad1, T.Cantidad4 Cantidad2, T.RB3 Bloqueado, T.TipoTr2 as TipoOp, T.Cliente1 Cliente, T.Vehiculo1, E.MonedaEmision, E.Cotiza,  ")
Sqladd(" T.Cuenta1 CtaDestino, T.Cuenta2 CtaOrigen, T.ConceptoPago Concepto, T.Book1, E.Tipo TipoEspecie, ")
Sqladd(" 'TIC' TipoOpC, 'TIV' TipoOpV, E.Issuer,T.Cliente1, ")
Sqladd(" CASE WHEN CU1.CB2='SI' THEN T.ConceptoPago ELSE '' END ConceptoDest, ")
Sqladd(" CASE WHEN CU2.CB2='SI' THEN T.ConceptoPago ELSE '' END ConceptoOri, '' NrOperacion ")
Sqladd("FROM "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".MERCADOS M, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" LEFT JOIN CUENTAS CU1 ON (T.Cuenta1 = CU1.Codigo) ")
Sqladd(" LEFT JOIN CUENTAS CU2 ON (T.Cuenta2 = CU2.Codigo) ")
Sqladd(" ,"~Dbo()~".ESPECIES E ")
Sqladd("WHERE T.NrTrans = B.NrOperacion ")
Sqladd(" AND T.Especie = E.Codigo ")
Sqladd("AND T.TipoTr2 = MA.TipoTr2 AND MA.TipoAsiento = '"~Var('TIPASICUST')~"' ")
Sqladd("AND T.TipoTr2 in ('DRT') ")
Sqladd("AND B.Valor = 1 AND B.NrBit = 70 ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd("AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd("AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("AND T.Mercado1 = M.Codigo ")
Sqladd(" AND T.CB6 =0  AND (T.Cliente1=T.Vehiculo1 OR T.Cliente2=T.Vehiculo1)")
    **
Sqladd("UNION ALL ")

Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha1 Fecha, T.Vehiculo1, T.Precio2 as Cantidad, MA.Codigo CodAsi, T.Cuenta1, T.Cuenta2, ")
Sqladd("       CU1.CuentaContable1 CuentaOrigen, CU2.CuentaContable1 CuentaDestino, ")
Sqladd("rtrim(T.TipoTr2) + ', ' + rtrim(T.Especie) + ' (' + rtrim(T.NrTrans) + ')' Leyenda, T.Especie, ")
Sqladd("T.Cantidad1 Cantidad1, T.Cantidad2 Cantidad2, T.RB3 Bloqueado, T.TipoTr2 as TipoOp, T.Cliente1 Cliente, T.Vehiculo1, E.MonedaEmision, E.Cotiza, ")
Sqladd(" T.Cuenta1 CtaDestino, T.Cuenta2 CtaOrigen, T.ConceptoPago Concepto, T.Book1, E.Tipo TipoEspecie, ")
Sqladd(" '' TipoOpC, '' TipoOpV, E.Issuer,T.Cliente1, '' ConceptoDest, '' ConceptoOri, '' NrOperacion ")
Sqladd("FROM "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" LEFT JOIN CUENTAS CU1 ON (T.Cuenta1 = CU1.Codigo) ")
Sqladd(" LEFT JOIN CUENTAS CU2 ON (T.Cuenta2 = CU2.Codigo) ")
Sqladd(" ,"~Dbo()~".ESPECIES E ")
Sqladd("WHERE T.TipoTr2 = MA.TipoTr2 AND MA.TipoAsiento = '"~Var('TIPASICUST')~"' AND T.TipoTr2 = '"~Var('CAMEST')~"' ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND T.Especie = E.Codigo ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd("AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd("AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("AND "~Dbo()~".DesciendedeEspecie(T.Especie,'TITULO')=1  ")
Acn(xx:1, 0)
Watch(Sqlbatch())

recorrer sql
if (Fbn('Bloqueado') = 0)
if (Fbn('Cantidad2') = Var('BLOQGROFEX'))
Act(sl:1, 'GTIAROFEX')
else
