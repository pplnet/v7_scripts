Act(nr:1, '')
Act(nr:2, Fbn('NrTrans'))
Act(mn:99, Fbn('Cotiza'))
if (NoVacio(BuscarCampo('OPERACIONES', 'NrOperacion', 'NrOperacion', Fbn('NrOperacion'))))
Act(no:1, Fbn('NrOperacion'))
else
Act(no:1, '')
endif

if (not (Eqstr(Val(ti:1), Var('CAMEST'))))
if (Eqstr(Val(sl:1), 'CARTERA') y Eqstr(Val(sl:2), 'CARTERA'))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrTrans2 = '"~Fbn('NrTrans')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrTrans')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Val(no:1), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoTr2'), null, Fbn('NrTrans'), null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
endif
endif
proximo
