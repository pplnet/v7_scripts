   Fecha1     : 'Fecha_Saldos'    ;;;;;; ; ; ;FSys-1 
   String1    : 'Nombre_Arch.'    ;;;;;;;;;;VAR('PATHMOVIM')
   NrTrans1   : 'NrTrans'         ;3;1;;;;;;;;;;;
   Radio1     : 'Ejecuta|Si|No|'  ;;;;  ;  ;;;;1
