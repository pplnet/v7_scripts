** Contador manual **
ACN(tt:0,FAC)
ACN(ti:0,FAC)


*- Cargo el archivo en las celdas
AbrirASCII(Val(x1),0)
Repetir
*  BorrarCeldas(aa:Val(tt:0)..ag:Val(tt:0))
  ACT(aa:Val(tt:0), LeerAscii)

  If Not Ok
     Break
  Endif
  
  *-Tipo Registro
  ACT(ab:Val(tt:0), Copy(Val(aa:Val(tt:0)),1,1) )
  ACN(z1,3)                
  scn(z4,1)  
  
  *--Si es Registro de Movim 
  If Eqstr(Val(ab:Val(tt:0)),'2')
    *scn(z4,1)  
       
    acn(al:Val(tt:0),Val(tt:0))      
    *---Especie
    ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
    ACT(ac:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
    ACT(j:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
    ACN(z1,Val(z2)+1)
                
    *---Tipo_Cuenta
    ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
    ACT(ad:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
    ACN(z1,Val(z2)+1)
    If Eqstr(Val(ad:Val(tt:0)),'0')
      
      *---Comitente ae
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACT(ae:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
      ACT(ae:Val(tt:0), Fstr(  Num(Val(ae:Val(tt:0))) ,1,0)  )  
      ACT(i:Val(tt:0), Pad0(Fstr(Num(Val(ae:Val(tt:0))),1,0),9))  
      ACN(z1,Val(z2)+1)
       
      ACT(gg:Val(tt:0),BuscarCampo('CUENTAS','Codigo','NrDepositante',Val(i:Val(tt:0))))
      if Vacio(Val(gg:Val(tt:0)))
         ACT(i:Val(tt:0), Fstr(Num(Val(ae:Val(tt:0))),1,0))  
         ACT(gg:Val(tt:0),BuscarCampo('CUENTAS','Codigo','NrDepositante',Val(i:Val(tt:0))))
         if Vacio(Val(gg:Val(tt:0)))
            ACT(a:Val(tt:0),'Cuenta inexistente')
         endif
      endif
      
      *---Tipo_Movimiento af
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACT(af:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)
      
      *---Cantidad VN ag
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACN(ag:Val(tt:0),Abs( Num(COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ) ) ) )
      ACN(z1,Val(z2)+1)
      
      *---Codigo Numerico de Movimiento  ah
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACT(ah:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)
     
      ACT(m:Val(tt:0),Val(ah:Val(tt:0)))

      *---Referencia ai
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACT(ai:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)
                 
      *---Codigo Comitente Contraparte aj
      ACN(z2, Posicion('"',VAL(aa:Val(tt:0)),Val(z1) )  )
      ACT(aj:Val(tt:0),COPY(VAL(aa:Val(tt:0)),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *mac concilia
      *ACT(l:Val(tt:0),Val(ai:Val(tt:0))~' '~Val(aj:Val(tt:0)))
      ACT(l:Val(tt:0),Val(ai:Val(tt:0)))
       
*       * 10 - Transferencia receptora
*       * 11 - ajuste + (credito)
*       * 12 - ajuste - (debito)
*       * 13 - deposito 
*       * 14 - extraccion
*       * 15 - transf. emisora
*       * 16 - compra
*       * 17 - venta
        If Incluido(Val(ah:Val(tt:0)),'10|11|13')
          ACN(ag:Val(tt:0), Val(ag:Val(tt:0)))
        Endif
        
        If Incluido(Val(ah:Val(tt:0)),'12|14|15')
          ACN(ag:Val(tt:0), -Val(ag:Val(tt:0)))
        Endif  
        ACN(k:Val(tt:0), Val(ag:Val(tt:0)))
      if Vacio(Val(a:Val(tt:0)))
         ACT(a:Val(tt:0),'Movimiento sin Matchear en FPA')
         acn(h:Val(tt:0),0)
         ColorCeldas(a:Val(tt:0)..m:Val(tt:0),clRED)
      endif
      Message(Fstr((Val(tt:0)-Val(ti:0)),1,0)~'- Cuenta '~Val(i:Val(tt:0))~' Especie '~Val(j:Val(tt:0)))
      scn(tt:0,1)

    Endif
  Endif
Proximo
CerrarASCII

*- Fin carga de archivo
Message(Fstr((Val(tt:0)-Val(ti:0)),1,0)~'- Registros leidos de CV')

ACN(tf:0,Val(tt:0))
acn(ck3,0)

SQL.ADD(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
SQL.ADD(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'DIR' Tipo, T.NrTrans, ")
SQL.ADD(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
SQL.ADD(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
SQL.ADD(" T.Mercado4, T.Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4 ") 
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T WITH (NOLOCK),"~DBO~".ESPECIES E WITH (NOLOCK), "~DBO~".CUENTAS CT WITH (NOLOCK), "~DBO~".MOVPENDIENTES M  WITH (NOLOCK INDEX = INDMP1) ")
SQL.ADD(" where T.NrTrans=M.NrOperacion AND T.Fecha1<="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2  In ('DTP','RTP') ")
SQL.ADD("  and  T.RB2=0 ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  T.Cuenta1   = M.Cuenta ")
SQL.ADD("  and  M.NrSaldo   = 101 ")
SQL.ADD("  and ((T.TipoTr2  In ('DTP') and M.Cantidad > 0) ")
SQL.ADD("    or (T.TipoTr2  In ('RTP') and M.Cantidad <= 0)) ")
SQL.ADD("  and  Abs(M.Cantidad) = T.Cantidad1 ")
SQL.ADD("  and  M.Especie   = E.Codigo ")
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("and E.Codigo    Not  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
 SQL.ADD(" and  M.Mercado   = '"~Dialogo.Mercado1~"' ")
ENDIF
SQL.ADD("  and  M.Cuenta    = CT.Codigo ")
IF NoVacio(Dialogo.NrTrans1)
   SQL.ADD("  and  T.NrTrans = '"~Dialogo.NrTrans1~"'  ")
EndIf
SQL.ADD("UNION ALL ")
SQL.ADD(" Select Distinct E.CodNumCajaValores, E.CodAlfCajaValores, M.Especie Especie, M.Cupon Cupon,CONVERT(Float,CT.NrDepositante) as DepNumero, M.Cliente as Cliente,")
SQL.ADD(" T.Fecha1, T.TipoTr2, M.Cuenta as Cuenta, M.Cantidad, 'INV' Tipo, T.NrTrans, ")
SQL.ADD(" T.Fecha2,T.Fecha3, T.CB2, T.RB1, isnull(CT.NrDepositante,'-') Comitente, E.Alias5, ")
SQL.ADD(" E.Nombre, T.Mercado2 Mercado , convert(float,E.CodNumCajaValores) orden, CT.Alias1, ")
SQL.ADD(" T.Mercado4, T.Cuenta1 as Cuenta2, T.ComitenteExt ComRec, E.Alias3, T.Cantidad1, T.CB6, T.NrOperacionRef1,CT.NrDepositante,T.Cliente3 as DepOrig,T.Cliente4") 
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T WITH (NOLOCK),"~DBO~".ESPECIES E WITH (NOLOCK), "~DBO~".CUENTAS CT WITH (NOLOCK), "~DBO~".MOVPENDIENTES M WITH (NOLOCK INDEX = INDMP1) ")
SQL.ADD(" where T.NrTrans   = M.NrOperacion AND T.Fecha1    <= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and  T.TipoTr2  In ('DTP','RTP') ")
SQL.ADD("  and  T.RB2=0 ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  T.CB1       ='1' ")
SQL.ADD("  and ((T.CB2 = 1)  ")
SQL.ADD("   or  (T.Mercado4 = CT.Alias1))  ")
SQL.ADD("  and  T.Cuenta2   = M.Cuenta ")
*SQL.ADD("  and  T.Cuenta2   <> '"~VAR('CTALIQEXT')~"' ")
SQL.ADD("  and  M.NrSaldo   = 101 ")
SQL.ADD("  and ((T.TipoTr2  In ('DTP') and M.Cantidad < 0) ")
SQL.ADD("    or (T.TipoTr2  In ('RTP') and M.Cantidad >= 0)) ")
SQL.ADD("  and  Abs(M.Cantidad) = T.Cantidad1 ")
SQL.ADD("  and  M.Especie   = E.Codigo ")
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("and E.Codigo    Not IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
 SQL.ADD(" and  M.Mercado   = '"~Dialogo.Mercado1~"' ")
ENDIF
SQL.ADD("  and  M.Cuenta    = CT.Codigo ")
IF NoVacio(Dialogo.NrTrans1)
   SQL.ADD("  and  T.NrTrans = '"~Dialogo.NrTrans1~"'  ")
EndIf
SQL.ADD("Order by 1,5,M.Cuenta, T.Cantidad1 ")
watch(sql.batch())

ACN(rr:0,Val(tf:0))
act(ss:1,'')
act(ss:2,'')
acn(ti:1,val(ti:0))
acn(ti:2,val(ti:0))

*MAC se fija sino es macheado
act(yt:1,'NO')
acn(nw:1,0)


Recorrer SQL
   scn(ck3,1)
   acn(ss:0,0)
   *MAC se fija sino es macheado
   act(yt:1,'NO')
   
   if eqstr(fbn('nrtrans'),'R0001234')
      acn(z95,0)
   endif 
   
   If Not EqStr(fbn['CodNumCajaValores'],val(ss2))
      act(ss:2,fbn['CodNumCajaValores'])

      *- Tomo el valor teorico a la fecha de dialogo, por si es una
      *- transaccion vieja, y CV la matchea a hoy, al valor teorico de hoy
      acn(vt2,ValorTeorico2(fbn['Especie'],Dialogo.Fecha1))

      *- Cupon a la fecha del matcheo
      ACT(cu1,Fstr(NrCupon2(fbn['Especie'],Dialogo.Fecha1),0,0))
   EndIf

   If Not EqStr(fbn['CodNumCajaValores']~fbn['NrDepositante'],val(ss1))
      act(ss:1,fbn['CodNumCajaValores']~fbn['NrDepositante'])
      *-ti1: Puntero para cambiar 
      acn(ti:1,val(ti:2))
   EndIf

   Recorrer&i Val(ti:1),Val(tf:0)
      if EqStr(Val(a:&i),'Movimiento sin Matchear en FPA')
         BorrarCeldas(y:0..y:0)
         acn(vt:1,1)
         Recorrer&j 1,Val(x:0)
            if EqStr(fbn['Especie'],Val(cc:&j))
               ACT(y:0,Val(ce:&j))
               break
            endif
         Proximo

         act(ck1,Val(j:&i)~Pad0(Val(i:&i),9))
         act(ck2,Pad0(fbn['CodNumCajaValores'],5)~Pad0(fbn['NrDepositante'],9))

         * MESSAGEBOX('cv '~VAL(CK1))
         * MESSAGEBOX('fpa '~VAL(CK2))
         *1.4.3.6.2.2.12 Gtstr(string1, string2)
         *Compara que el primer String sea mayor que el otro y devuelve True o False.
         *mac concilia
         *if GtStr(Val(ck1),Val(ck2))
         
         if not Eqstr(Val(ck1),Val(ck2))
            *- Si la especie y el nrodepositante Paso 
            *- Cambio el puntero para empezar el txt desde mas abajo
            ACN(ti:2,&i)
            * MessageBOX('CAMBIO EL PUNTERO '~val(ti2)~' '~val(ck1)~' fpa '~val(ck2))    
            *LogWrite("Difer Movimientos CMOVD1 : NO Concilia Especie-Depositante Transaccion: "~fbn('nrtrans')~' cv: '~VAL(CK1)~' fpa: '~VAL(CK2))
            break
         endif

         *- la1 ContraParte para Matchear con l:
         If NoVacio(FBN('ComRec'))
            *act(la1,Pad0(fbn['Cliente4'],4)~' '~fbn['ComRec'])
              act(la1,Fbn['ComRec'])
         Else
            *mac concilia
            *act(la1,Pad0(fbn['Cliente4'],4)~' '~BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta2']))
            act(la1,BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta2']))
         EndIf

         if [Num(fbn['CodNumCajaValores'])=Num(Val(j:&i)) o Num(Val(j:&i))=Num(Val(y:0))] 
            if EqStr(fbn['Cuenta'],Val(gg:&i)) 

               IF NOT [DesciendeDeEspecie(fbn['Especie'],'CEDRO') o [DesciendeDeEspecie(fbn['Especie'],'ON') y EqStr(fbn['Alias3'],'CED')]]
                  acn(vt:1,val(vt2))
               ENDIF

               if Vacio(Val(vt:1)) or Val(vt:1)=0
                  acn(vt:1,1)
               endif
*MESSAGE(' fpa '~VAL(LA1))
*MESSAGE(' CV '~VAL(L:&I))
*message(fbn['Tipo'])
               
               if EqStr(fbn['TipoTr2'],'DTP') y Incluido(Val(m:&i),'10|11|13') y EqStr(Fstr(fbn['Cantidad']*Val(vt:1),1,6),Fstr(Val(k:&i),1,6)) y EqStr(fbn['Tipo'],'DIR') y EqStr(val(la1),Val(l:&i))
                  acn(ss:0,1)
                  acn(st:0,&i)
                  break
               endif  
               if EqStr(fbn['TipoTr2'],'RTP') y Incluido(Val(m:&i),'12|14|15') y EqStr(Fstr(fbn['Cantidad']*Val(vt:1),1,6),Fstr(Val(k:&i),1,6)) y EqStr(fbn['Tipo'],'DIR') y EqStr(val(la1),Val(l:&i))
                  acn(ss:0,1)
                  acn(st:0,&i)
                  break
               endif  
               if EqStr(fbn['TipoTr2'],'DTP') y Incluido(Val(m:&i),'12|14|15') y EqStr(Fstr(fbn['Cantidad']*Val(vt:1),1,6),Fstr(Val(k:&i),1,6)) y EqStr(fbn['Tipo'],'INV') y EqStr(val(la1),Val(l:&i))
                  acn(ss:0,1)
                  acn(st:0,&i)
                  break
               endif  
               if EqStr(fbn['TipoTr2'],'RTP') y Incluido(Val(m:&i),'10|11|13') y EqStr(Fstr(fbn['Cantidad']*Val(vt:1),1,6),Fstr(Val(k:&i),1,6)) y EqStr(fbn['Tipo'],'INV') y EqStr(val(la1),Val(l:&i))
                  acn(ss:0,1)
                  acn(st:0,&i)
                  break
               endif  
               
            endif
         endif
      endif
   proximo

   if Vacio(Val(vt:1)) or Val(vt:1)=0
      acn(vt:1,1)
   endif
   if Val(ss:0)=0
      *MAC se fija sino es macheado
      Recorrer&h 0,Val(nw:1)
      if eqstr(fbn['NrTrans'],val(mt:&h))
               act(yt:1,'SI')
               break
           endif
      proximo
      if eqstr(val(yt:1),'NO')
         ColorCeldas(a:Val(rr:0)..m:Val(rr:0),clBLUE)
         act(a:Val(rr:0),'Movimiento sin Matchear en CV')
         act(b:Val(rr:0),fbn['Cuenta'])
         act(c:Val(rr:0),fbn['CodNumCajaValores'])
         acn(d:Val(rr:0),fbn['Cantidad']*Val(vt:1))
         act(e:Val(rr:0),fbn['ComRec']~'-'~fbn['Cuenta2'])
         act(f:Val(rr:0),fbn['TipoTr2'])
         act(g:Val(rr:0),fbn['NrTrans'])
         aclt(g:Val(rr:0),fbn['NrTrans'])
         *- h: ContraParte para Matchear con l:
         If NoVacio(FBN('ComRec'))
           act(h:Val(rr:0),Pad0(fbn['Cliente4'],4)~' '~fbn['ComRec'])
         Else
           act(h:Val(rr:0),Pad0(fbn['Cliente4'],4)~' '~BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta2']))
         EndIf
         Message(Val(a:Val(rr:0))~' Cuenta '~fbn['Cuenta']~' Especie '~fbn['CodNumCajaValores'])
         
         scn(rr:0,1)
      endif
   
   else
      ColorCeldas(a:Val(st:0)..m:Val(st:0),clGREEN)
      act(a:Val(st:0),'Movimiento Matcheado')
      act(b:Val(st:0),fbn['Cuenta'])
      act(c:Val(st:0),fbn['CodNumCajaValores'])
      acn(d:Val(st:0),fbn['Cantidad']*Val(vt:1))
      act(e:Val(st:0),fbn['Mercado4']~'-'~fbn['Cuenta2'])
      act(f:Val(st:0),fbn['TipoTr2'])
      act(g:Val(st:0),fbn['NrTrans'])
      aclt(g:Val(st:0),fbn['NrTrans'])

      *- h: ContraParte para Matchear con l:
      If NoVacio(FBN('ComRec'))
         act(h:Val(rr:0),Pad0(fbn['Cliente4'],4)~' '~fbn['ComRec'])
      Else
         act(h:Val(rr:0),Pad0(fbn['Cliente4'],4)~' '~BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta2']))
      EndIf
      
      Message(Val(a:Val(st:0))~' Cuenta '~fbn['Cuenta']~' Especie '~fbn['CodNumCajaValores'])
      
      if Val(st:0)=(Val(ti:0))
         acn(ti:0,Val(st:0)+1) 
      endif
      *MAC se fija sino es macheado
      act(mt:val(nw:1),fbn['NrTrans'])
      scn(nw:1,1)
      *- Si ejecuta la Confirmacion
      if Dialogo.Radio1=0 
         **- Marco la Transaccion que se esta matcheando          
         IF NO
            SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Dialogo.Fecha1)~"',Cupon2='"~val(cu1)~"' ")
            SQL.ADD("WHERE  NrTrans= '"~Val(g:Val(st:0))~"' ")
            SQL.NEW
            SQL.EXEC

            *SQL.ActualizarMovimientosT4(Val(g:Val(st:0)),SI,NO,NO,SI,NO,NO,4)
            *SQL.EXEC

             *- dt1: Nro.Transaccion ft1: Fecha de Matcheo
             ACT(dt1,Val(g:Val(st:0)))
             ACD(ft1,Dialogo.Fecha1)

             (.'ACTMOVTRMA'.)

             *- Pasa de Instancia
             ACT(az3,Val(g:Val(st:0)))
             ACT(az4,'TRANSACCIONES2')
             ACN(az5,70)
             ACN(az6,1 )
             (.'MODIINSTAN'.)
         endif
         acn(er1,0)
         *MESSAGEBOX("Se va confirmar las transaccion  "~Val(g:Val(st:0))~" ")
         act(z95,SQL("select Nrtrans from "~DBO~".TRANSACCIONES2 WHERE NrOperacionRef2 ='"~Val(g:Val(st:0))~"'"))
         *MESSAGEBOX("Se va confirmar el voucher  "~Val(z95)~" ")
         ACT(y1, Fecha(FSys, 'YYYY.MM.DD'))
         if novacio(val(z95))
            SQL.ADD("Select 1 hay ")
            SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where T.NrTrans = B.NrOperacion")
            SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and (T.CB9 = '0' or T.CB9 is NULL) ")
            SQL.ADD("AND T.Mercado1 <> '"~Var('MERCOCT')~"' ")
            SQL.ADD("AND T.Mercado1 not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
            SQL.ADD("AND IsNull(T.Ley4,'') Not In ("~Pipe2Comillas(VAR('RUECPC1'))~")  ")
            SQL.ADD("and ")
            SQL.ADD("( ")
            SQL.ADD("  ( ")
            SQL.ADD("    T.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD("    and (T.CB3 = '0' or T.CB3 is NULL) ")
            SQL.ADD("  )  ")
            SQL.ADD("  or ")
            SQL.ADD("  (  ")
            SQL.ADD("    T.Fecha2 < '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD("    and T.CB3 = '1' ")
            SQL.ADD("    and Not T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and Convert(Char,I.Fecha,102) = '"~Val(y1)~"') ")
            SQL.ADD("  )  ")
            SQL.ADD(")    ")
            SQL.ADD("and (B.NrBit = 6 or B.NrBit = 3)")
            SQL.ADD("AND T.NrTrans = '"~Val(z95)~"'          ")
            SQL.ADD("and B.Valor = '1' ")
            *SQL.ADD("Order By 1, 7, 3   ")
            recorrer sql
                acn(er1,1)
                if fbn('hay') = 1
                EjecutarEvento('03CONF', Radio1=2, Mercado1='', Especie1='', Vehiculo1=Dialogo.Vehiculo1, Radio2=1, Fecha1=Dialogo.Fecha1, Cliente1='', NrTrans1=Val(z95), Check1=1, Check2=0) 
                else
                   EjecutarEvento('YCONFI', Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Fecha2=fsys,Lista1='',Lista2='' ,Lista3='', NrTrans1=Val(z95), Check1=1) 
                endif
            Proximo
            if val(er1)=0
                EjecutarEvento('YCONFI', Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Fecha2=fsys,Lista1='',Lista2='' ,Lista3='', NrTrans1=Val(g:Val(st:0)), Check1=1) 
            endif
            acn(er1,0)
         else
            SQL.ADD("Select 1 hay ")
            SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where T.NrTrans = B.NrOperacion")
            SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
