SQL.ADD("select E1.Codigo,E1.Alias8,E2.Valor5 ")
SQL.ADD("  from "~DBO~".ESPECIES E1,"~DBO~".ESPECIES E2 ")
SQL.ADD("where E1.Alias8 is not null and E1.Alias3='CED'  ")
SQL.ADD("  and E2.Codigo=E1.Alias8 ")
