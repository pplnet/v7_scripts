                   EjecutarEvento('YCONFI', Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Fecha2=fsys,Lista1='',Lista2='' ,Lista3='', NrTrans1=Val(g:Val(st:0)), Check1=1) 
