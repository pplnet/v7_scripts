if (Val(z1) = 0)
Acn(cu1, 0)
sql.add("Select Count('*') Cuantos from "~Dbo()~".GARANTIASOCT ")
sql.add(" Where Fecha           = '"~IdxDate(Val(t:5))~"' ")
