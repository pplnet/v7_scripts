sql.add("   and Especie         = '"~Val(t:2)~"' ")
sql.add("   and NroPlazo        = "~FStr(Val(t:4), 0, 0)~" ")
sql.add("   and Cliente         = '"~Val(t:1)~"' ")
sql.add("   and TipoGar         = '"~Val(t:15)~"' ")
recorrer sql
Acn(cu1, Fbn('Cuantos'))
proximo
