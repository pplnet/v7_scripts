sql.add(" CVPostCierre, CCPostCierre,    TotalNeto    ")
sql.add(" ) Values ( ")
sql.add(" '"~IdxDate(Val(t:5))~"', ")
sql.add(" '"~Val(t:3)~"', ")
sql.add(" '"~Val(t:2)~"', ")

sql.add(" "~FStr(Val(t:4), 0, 0)~", ")
