MostrarCuadroDeMensajes()

creardialogo
fecha1: 'Fecha Saldos';1;1;1;SI;SI;EsHabil(dialogo.fecha1, 'ARG');'Dia no habil';SI;FSys()
cuenta1: 'Cuenta';2;1;;;;NoVacio(dialogo.cuenta1);'Debe ingresar una cuenta';NO;;;;;;"Select Codigo, Numero , Nombre from "~Dbo()~".CUENTAS Where Numero IN (Select Distinct Numero From "~Dbo()~".SALDOSBANCARIOS) "
findialogo

if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.cuenta1))
let(&nrcuenta, BuscarCampo('Cuentas', 'Numero', 'Codigo', dialogo.cuenta1))
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(dialogo.fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(dialogo.fecha1, SI))~"' and NrCuenta = '"~&nrcuenta~"' and Estado in ('REC','PRO') ") = 1)
Cancelar('Existen saldos posteriores a la fecha. Cancela Evento.')
endif
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~&nrcuenta~"' and Estado in ('PRO') ") = 1)
Cancelar('El saldo para la fecha ya está procesado. Cancela Evento.')
endif
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~&nrcuenta~"' and Estado in ('REC','PRO')  ") <> 1)
Cancelar('No existen saldos para la cuenta '~dialogo.cuenta1~' a la fecha '~dialogo.fecha1~' ')
endif
else
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(dialogo.fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(dialogo.fecha1, SI))~"' and Estado in ('REC','PRO')  ") = 1)
Cancelar('Existen saldos posteriores a la fecha. Cancela Evento.')
endif
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and Estado in ('PRO')  ") = 1)
Cancelar('Existen saldos procesados para la fecha. Cancela Evento.')
endif
if (Query(" Select 1 from "~Dbo()~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and Estado in ('REC','PRO')  ") <> 1)
Cancelar('No existen saldos a la fecha '~dialogo.fecha1~' ')
endif
endif


if (Messagebox('Anular saldos de '~dialogo.cuenta1~' al '~dialogo.fecha1~' ', 1, 2) = 7)
Cancelar('Evento cancelado')
endif

Sqladd(" UPDATE "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" SET Estado = 'ANU' , FechaAnu="~SQLAhora()~", UsuarioAnu='"~UsuarioActivo()~"' ")
Sqladd(" WHERE FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and NrCuenta = '"~&nrcuenta~"' ")
Sqlnew()
Sqlexec()


