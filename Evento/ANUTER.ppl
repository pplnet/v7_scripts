CrearDialogo
   NrOperacion1 
FinDialogo

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

IF OK
   SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES Where TipoOp='TEMINM' and ")
   SQL.ADD("NrOperacion='"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
      IF FBN['FechaOp']=Fsys
         Message("Operacion '"~FBN['NrOperacion']~"' ")

         SQL.ADD("Delete "~DBO~".OPERACIONES Where NrOperacion='"~FBN['NrOperacion']~"' ")
         SQL.NEW

         SQL.ADD("UPDATE "~DBO~".OPERACIONES Set NrOperacion2='' Where NrOperacion2='"~FBN['NrOperacion']~"' ")
         SQL.NEW
         SQL.EXEC
      Else
         MessageBox('La Minuta Mensual es de Fecha '~FBN['FechaOp']~' y no puede ser Eliminada ..')
      EndIf

   Proximo 
ENDIF
