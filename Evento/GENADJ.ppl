SQL.ADD(" Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGLIC'))~") ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUELICI'))~")    ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                     ")
SQL.ADD("    and Carga       is null                                   ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                           ")
*SQL.ADD("    and Secuencia2='26022318002210310' ")
SQL.ADD("  order by Secuencia2 ")
Recorrer SQL
  ** FJL 22/01/26 - Se amplia la cantidad de registros a 50. 
  ** Se almacenanan los errores desde la columna AA a BX
  ** Se almacenana desde la columna CA a CX
  if FAC>50
    break
  endif
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
*  MessageBox('GENADJ OPSIOPEL '~FStr(FAC,1,0)~' - '~fbn('Secuencia2'))
if Eqstr(Var('LOGEAMAE'),'SI')
  AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
  EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - GENADJ OPSIOPEL '~FStr(FAC,1,0)~' - '~fbn('Secuencia2'))
  CerrarASCII
endif

  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..u:90)
  BorrarCeldas(k:1..l:2)
  if SI
    ***** Secuencia2
    ACT(t:1, fbn('Secuencia2'))
    ***** TipoOp
    if EqStr(fbn('CodigoRegistro'),'7020')
      if Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
        ACT(x:1, 'S')
        ACT(t:2,'TCOPRI')
        ACT(t:5, fbn('AgenteContra'))
        ACT(t:53, fbn('NrOrden'))
        ACT(t:54, BuscarCampo('ORDENES','Cliente','NrOrden',fbn('NrOrden')))
        if NoVacio(Val(t:54))
          ACT(u:54, BuscarCampo('CLIENTES','Alias1','Codigo',Val(t:54)))
          ACT(v:54, BuscarCampo('VEHICULOS','Cliente','Codigo',BuscarCampo('ORDENES','Vehiculo','NrOrden',fbn('NrOrden'))))
          if EqStr(Val(u:54),'CP') o EqStr(Val(v:54),Val(t:54))
            * Es Cartera Propia  
            ACN(t:55, 1)
          endif
        endif
* FJL 12/09/22 - Se graba el book de la TMANIF
        ACT(t:59, BuscarCampo('ORDENES','Book1','NrOrden',fbn('NrOrden')))
* MAC 17/07/2023 - Se graba la cuenta de comisiones de la TMANIF
        ACT(t:74, BuscarCampo('ORDENES','Cuenta5','NrOrden',fbn('NrOrden')))
      else
        SCN(z:1,1)
        ACN((26+FAC):2, 1)
      endif
    else
      * No es 7020
*      if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
*        ACT(x:1, 'S')
*      else
*        ACT(x:1, 'F')
*      endif
*      if EqStr(fbn('Agente'),Val(v:5))
*        ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
*        if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
*          ACT(t:2,'TIV')
*        else
*          ACT(t:2,'TIFV')
*        endif
*        ACT(t:5, fbn('AgenteContra'))
*      else
*        if EqStr(fbn('AgenteContra'),Val(v:5))
*          if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
*            ACT(t:50,Copy(fbn('NroOrdenComprador'),7,5))
*            if Incluido(fbn('CodigoRueda'),Var('RUELICI'))
*              ACT(t:2,'TCOPRI')
*            else
*              ACT(t:2,'TIC')
*            endif
*          else
*            ACT(t:2,'TIFC')
*          endif
*          ACT(t:5, fbn('Agente'))
*        else
*          SCN(z:1,1)
*          ACN((26+FAC):2, 1)
*        endif
*      endif
*      if Incluido(fbn('CodigoNego'),Var('TIPONEGLIC')) y EqStr(fbn('Agente'),Val(v:5)) y EqStr(fbn('AgenteContra'),Val(v:5)) y EqStr(fbn('CodigoRegistro'),'0205')
      if Incluido(fbn('CodigoNego'),Var('TIPONEGLIC')) y Not EqStr(fbn('Agente'),'000') y EqStr(fbn('AgenteContra'),Val(v:5)) y EqStr(fbn('CodigoRegistro'),'0205')
        ACT(x:1, 'S')
        ACT(t:2,'TCOPRI')
        ACT(t:71,'S')
        ACT(t:5, fbn('AgenteContra'))
        if EqStr(fbn('TipoOpDestino'),'5')
          * Es Cartera Propia  
          ACT(t:8, Var('VEHICULODE'))
          ACN(t:55, 1)
        else
          if NoVacio(fbn('ComitenteComprador'))
            ACT(t:61, fbn('ComitenteComprador'))
          else
            ACT(t:61, fbn('ComitenteVendedor'))
          endif
          ACN(t:62, Longitud(Val(t:61)))
          if Val(t:62)>1
            ACT(t:63, Copy(Val(t:61),1,2))
              if EqStr(Val(t:63),'*C')
              * es CUIT
              if Val(t:62)>2
                if Val(t:62)>13
                  ACT(t:64, Copy(Val(t:61),3,11))
                else
                  ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                endif
                ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CUIT = '"~Val(t:64)~"' "))
              endif
            endif
            if Incluido(Val(t:63),'*F|*S')
              * es Fondo o Seguros
              ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
              if EqStr(Val(t:63),'*F')
                ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='FON' "))
              endif
              if EqStr(Val(t:63),'*S')
                ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='CSE' "))
              endif
            endif
            if NoVacio(Val(t:65))
              ACT(t:8, Val(t:65))
            endif
          endif  
        endif
      else
        SCN(z:1,1)
        ACN((26+FAC):2, 1)
      endif
      
    endif
    ***** Especie
    ACT(t:27, fbn('CodigoTitulo'))
    ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    if Vacio(Val(t:3))
*      SCN(z:1,1)
** AA Verificar t:44 se utiliza en otros lugares del evento
      * Marca Incompleto
      ACN(t:44, 1)
      ACN(k:1, 1)
      ACN((26+FAC):3, 1)
** FJL 18/11/20 - Se pasa a un evento para poder ponerle logica y que lo usen el resto de GENxxx
** AA - 09/02/18  
** Insertando Nuevo codigo en Especies - Deshabilitada
*        ACT(pp:4, GenerarJerarquiaPorReferencia('ESPECIES',Var('JERAUTOMA'),si))
*        SQL.ADD("Insert into "~DBO~".ESPECIES (")
*        SQL.ADD("Jerarquia, ")
*        SQL.ADD("Codigo, ")
*        SQL.ADD("CodMAEContado, ")
*        SQL.ADD("Nombre, ")
*        SQL.ADD("Extendido, ")        
*        SQL.ADD("Status ")
*        
*        SQL.ADD(") values (")
*
*        SQL.ADD(" '"~Val(pp:4) ~"', ")           
*        SQL.ADD(" '"~fbn('CodigoTitulo')~"', ")
*        SQL.ADD(" '"~fbn('CodigoTitulo')~"', ")
*        SQL.ADD(" '"~Copy(fbn('Mnemotecnico'),1,15)~"', ")
*        SQL.ADD(" '"~fbn('Mnemotecnico')~"', ")
*        SQL.ADD(" 'DES' ")        
*        SQL.ADD(")")
*        SQL.NEW
**       AA - La especie se graba en Operaciones        
*        ACT(t:3, fbn('CodigoTitulo'))
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
*      EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
      EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Entero1=Num(fbn('Nrocupon')),Check1=Dialogo.Check1)
      ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    else
      ACT(k:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
      if Eqstr(Val(k:2),'DES')
        ACN(k:1,1)
      Endif
    endif
    ***** Cupon MAE
    ACT(t:4, fbn('NroCupon'))
    if EqStr(fbn('CodigoRueda'),'MAE1')
      ACN(t:34, 1)
    endif
    ***** Cliente
    ACN(t:6, Num(Val(t:5)))
    ***** Cliente Tabla
    ACT(t:7, fbn('Cliente'))
    if EqStr(Val(t:5),'000') o EqStr(Val(t:5),Val(v:5))
    * Agente=0  o Agente=Vehiculo
      if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
        * Agente=0  y FCI/AFJP
        ACN((26+FAC):8, 2)
      else
        if Val(t:34)=1
          * MAE1
          ACN((26+FAC):8, 3)
        else
*          SCN(z:1,1)
          ACN((26+FAC):8, 4)
        endif
      endif
    else
      ***** Codigo MAE Cliente
      ACT(t:57, Val(t:5))
      ***** Codigo Cliente
      ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
      ***** Operador Contra
      ACT(t:9, fbn('OperadorContra'))
      if Vacio(Val(t:8)) y Not EqStr(Val(t:2),'TCOPRI')
        ACN(l:1,1)
        ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
      endif
    endif

    ***** Mercado4
    ACT(t:31, Var('AMBMAE'))
    ***** VTXT3
***///***
*    ACT(t:10, CampoMercado(Val(t:31),Val(t:3),Val(t:8),2))
    ***** Cantidad
    ACN(t:11, fbn('Cantidad'))
    if Val(t:11)=0
      SCN(z:1,1)
      ACN((26+FAC):11, 1)
    endif
    ***** ContraEspecie / Mercado2
    if EqStr(fbn('Moneda'),'D')
      ACT(t:12, 'USD')
    else
      if EqStr(fbn('Moneda'),'$')
        ACT(t:12, 'ARP')
      else
*        SCN(z:1,1)
        * Marca Incompleto
        ACN(t:44, 1)
        ACN((26+FAC):12, 1)
      endif
    endif
    ***** PrecioMAE
    ACN(t:13, fbn('Precio'))
    
** FJL 22-12-23 - Por Licitaciones por tasa
    if EqStr(fbn('CodigoNego'),'@')
      ACN(t:13, fbn('Valorizacion')/fbn('Cantidad'))
    endif
    ***** Precio3 / Precio4 / Precio1
    if Eqstr(Val(t:10),'CLE')
      ACN(t:14, Val(t:13))
    else
      ACN(t:15, Val(t:13))
    endif
** FJL 25/03/2024 Por Divisor del precio de la TCPCEM
    ***** Precio para TCOPRI
    ACN(t:76, Val(t:13))

    ***** InteresesMAE
    ACN(t:16, fbn('Interes'))
** FJL 29-03-19 - Por cupon 0/1 para especies ZeroCoupon
*    ***** Nro Cupon
*    ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    ***** Es ZeroCupon
    ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
    ***** Nro Cupon
    if EqStr(Val(t:58),'SI')    
      ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    else
      ACT(t:17, Val(t:4))
    endif
    if Vacio(Val(t:17))
      ACT(t:17, '0')
    endif
    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05') o (EqStr(fbn('CodigoRegistro'),'7020') y EqStr(Copy(fbn('CodRegContestado'),3,2),'05'))
      ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACD(t:19, Fecha(Val(t:18)))
    else
      SCN(z:1,1)
      ACN((26+FAC):19, 1)
    endif
    
    ***** Mercado2 default por contraespecie
    if EqStr(fbn('Moneda'),'D')
      ACT(t:52, 'SWIFT')
    else
      if EqStr(fbn('Moneda'),'$')
        ACT(t:52, 'BCRA')
      else
        * Marca Incompleto
        ACN(t:44, 1)
        ACN((26+FAC):52, 1)
      endif
    endif
    ***** Mercado
    if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
      ACT(t:22, 'AC')
      ACT(t:52, 'AC')
    else
      if EqStr(fbn('EnteLiquidador'),'2')
        ACT(t:22, 'CRYL')
        ACT(t:52, 'BCRA')
      else
        if EqStr(fbn('EnteLiquidador'),'3')
          ACT(t:22, 'CE')
          ACT(t:52, 'CE')
        else
          if EqStr(fbn('EnteLiquidador'),'4')
            ACT(t:22, 'EU')
            ACT(t:52, 'EU')
          else
            if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
              ACT(t:22, 'CV')
            else
*              if Incluido(fbn('EnteLiquidador'),'G|F|W|U')
*                ACT(t:22, 'MC')
*                ACT(t:52, 'MC')
*              else
** FJL 23/07/25 - Para Equiparar con GENTIT
              if Incluido(fbn('EnteLiquidador'),'G|F|U|C')
                ACT(t:22, VAR('ENTELIQA3')) 
                *Para garantizado en dolares el mercado puede ser variable.
                if  EqStri(fbn('EnteLiquidador'),'G') y EqStri(fbn('Moneda'),'D')
                  ACT(t:52, VAR('ENTELIQGD'))
                else 
                  ACT(t:52, VAR('ENTELIQA3'))
                endif
              else
                if Incluido(fbn('EnteLiquidador'),'W')
                  ACT(t:22, VAR('ENTELIQA3'))
                  ACT(t:52, VAR('MERMCMEP'))
                else
*                  SCN(z:1,1)
                  * Marca Incompleto
                  ACN(t:44, 1)
                  ACN((26+FAC):22, 1)
                endif
              endif
            endif
          endif
        endif
      endif
    endif

    if Val(t:55)=0
      * La TCOPRI no es Cartera Propia
      ACT(t:22, 'CV')
      ACT(t:52, 'BCRA')
      ACT(t:24, 'ARG')
    endif

    ***** FormaLiquidacion
    if EqStr(fbn('TipoLiquidacion'),'2')
      ACN(t:23, 0)
    else
      if EqStr(fbn('TipoLiquidacion'),'1')
        ACN(t:23, 1)
      else
        if EqStr(fbn('TipoLiquidacion'),'6')
          ACN(t:23, 2)
        else
*          SCN(z:1,1)
          * Marca Incompleto
          ACN(t:44, 1)
          ACN((26+FAC):23, 1)
        endif
      endif
    endif
    IF Incluido(Val(T:22), VAR('MERCAACMC'))
      ***** FormaLiquidacion1 = DVP
      ACN(T:23, 1)
    Else
       if EqStr(Val(t:2),'TCOPRI')
          ACN(T:23, BuscarCampo('ORDENES','RB9','NrOrden',fbn('NrOrden')))
       endif
    Endif
    ***** Operador / OperadorContra
    if Incluido(Val(t:2),'TIV')
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
      ACT(t:26, fbn('OperadorContra'))
    else
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
      ACT(t:26, fbn('Operador'))
    endif
    if Vacio(Val(t:25))
      ACT(t:25, UsuarioActivo)
    endif
    ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

    ***** Vehiculo1
    ACT(t:29, Var('VEHICULODE'))

    ***** Cuenta1
*    ACT(t:28, SQL("Select Min(Codigo) from "~DBO~".CUENTAS where Cliente='"~Val(t:8)~"' and (Comitente='"~Val(t:29)~"' or Comitente is Null) and (ClHouse='"~Val(t:22)~"' or ClHouse is Null) and TipoCuenta='CUS' and (Especies Like '%TITULO%' or Especies is Null) and Estado = 'HAB' "~iif(EqStr(BuscarCampo('USUARIOS','Alias3','Codigo',Val(t:25)),Var('SECRTRAD')),"and TipoMAE = '"~Var('TIPOMAETR')~"' "," "))) )
*    ACT(t:28, SQL("Select Min(Codigo) from "~DBO~".CUENTAS where Cliente='"~Val(t:8)~"' and (Comitente='"~Val(t:29)~"' or Comitente is Null) and (ClHouse='"~Val(t:22)~"' or ClHouse is Null) and TipoCuenta='CUS' and (Especies Like '%TITULO%' or Especies is Null) and Estado = 'HAB' and TipoMAE = '"~fbn('TipoOpDestino')~"' ") )
* Revisar por MC
***/// FJL 23/01/18 Ver porque la tabla CUENTAS no tiene Global ni ClHouse
*    ACT(t:28, SQL("Select Min(Codigo) from "~DBO~".CUENTAS where Cliente='"~Val(t:8)~"' and (('"~fbn('EnteLiquidador')~"'='AC' and (Comitente<>'"~Val(t:29)~"' or Comitente is Null or Global='S')) or ('"~fbn('EnteLiquidador')~"'<>'AC' and (Comitente='"~Val(t:29)~"' or Comitente is Null))) and (ClHouse='"~Val(t:22)~"' or ClHouse is Null) and TipoCuenta='CUS' and (Especies Like '%TITULO%' or Especies is Null) and Estado = 'HAB' "))

    *** ContraEspecie2 Moneda de Liquidacion ****
    ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
    if EqStr(Val(t:12),'USD')
      if Incluido(Val(t:22),VAR('MERCAACMC'))
        ACT(t:46, 'USD')
        if EqStr(fbn('EnteLiquidador'),'B')
          ACT(t:46, 'USB')
        endif
      endif
      if EqStr(Val(t:22),'CRYL')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'CV')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'EU')
        if EqStr(fbn('TipoOpDestino'),'5') o EqStr(BuscarCampo('CUENTAS','Global','Codigo',Val(t:28)),'S')
          ACT(t:46, 'USD')
        else
          ACT(t:46, 'USB')
        endif
      endif
    endif

    ***** Tabla Feriados
    if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9')
      ACT(t:24, 'USA')
    endif
    if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
      ACT(t:24, 'ARG')
    endif
    if Incluido(Val(t:22),VAR('MERCAACMC'))
      ACT(t:24, 'ARG')
      if Incluido(Val(t:46),'ARP|USB')
        ACT(t:24, 'ARG')
      endif
      if EqStr(Val(t:46),'USD')
        ACT(t:24, 'USA')
      endif
    endif
    if Vacio(Val(t:24))
*      SCN(z:1,1)
      * Marca Incompleto
      ACN(t:44, 1)
      ACN((26+FAC):24, 1)
    endif

    if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
      * Es Spot
***/// FJL 24-01-18     
      ***** Plazo
      ACN(t:21, Num(fbn('Plazo'))*24)
      ***** RB5
*** FJL 04/07/25 - Issue EXTBACS-8374 por licitaciones con plazo > 4      
*      if Num(fbn('Plazo'))<=4
      ACN(t:66, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='PLAMAXLADJ' "))
      if Val(t:66)=1
        ACN(t:67, Var('PLAMAXLADJ'))
      else
        ACN(t:67, 4)
      endif
      if Num(fbn('Plazo'))<=Val(t:67)
        ACT(t:20, FStr(fbn('Plazo'),1,0))
      else
        SCN(z:1,1)
        ACN((26+FAC):20, 1)
      endif
      ***** FechaVto
      ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))
    else
      * Es Futuro
      ***** PlazoGracia
      ACN(t:21, Num(fbn('Plazo')))
      ***** FechaVto
      ACD(t:45, Val(t:19)+Val(t:21))
    endif

    ***** UDN1
    ACT(t:30, 'MD')
    ***** Rueda (UDN2)
    ACT(t:32, fbn('CodigoRueda'))
    ***** PaseCB
    ACT(t:33, '0')
    ***** MAE1
    if Val(t:34)=1
      ***** Datos MAE1
      ACT(t:36, fbn('Referencia'))
      ACN(t:37, Num(Val(t:36)))
      if Val(t:37)=0
        ACN(t:35, 0)
        ACN(t:38, 1)
      else
        if EqStr(fbn('TipoOpOrigen'),'1')
          ** Terceros
          ACN(t:35, 0)
        else
          ACN(t:35, 1)
        endif
      endif

      if EqStr(fbn('TipoOpDestino'),'5')
        * Agente
        ACN(t:39, 0)
      else
        if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
          if EqStr(fbn('TipoOpDestino'),'2')
            * FCI
            ACN(t:39, 1)
          endif
          if EqStr(fbn('TipoOpDestino'),'4')
            * AFJP Fondo
            ACN(t:39, 2)
          endif
          if EqStr(fbn('TipoOpDestino'),'6')
            * AFJP Encaje
            ACN(t:39, 3)
          endif
          if EqStr(fbn('TipoOpDestino'),'7')
            * AFJP Adminis (Cartera Propia)
            ACN(t:39, 4)
          endif
        endif
      endif
    endif

    if DesciendeDeEspecie(Val(t:3),'LETES')
      *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
      ACN(x:2, 1)
    else
      ACN(x:2, 0)
    endif 

    * FJL 10/04/18 - Las TCOPRI llevan el cliente de las TMANIF
    * Cliente definitivo a la Operacion
    ACT(t:56, Val(t:8))
    *ACT(t:56, Val(t:54))
    *if NoVacio(Val(t:53)) 
    *  * FJL 12/04/18 - Solo para las que no son de Cartera Propia
    *  if Val(t:55)=0
    *    ACT(t:56, SQL("Select Cliente From "~DBO~".ORDENES Where NrOrden = '"~Val(t:53)~"' "))
    *  endif
    *endif
    if Vacio(Val(t:56)) y Val(t:34)=1
      * Vacio Cliente y MAE1
      ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
    else
      ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
    endif
    if Val(t:41) = 1
      ACN(t:42, 1)
      if Vacio(Val(t:56)) y Val(t:34)=1
        * Vacio Cliente y MAE1
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
      else
      ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
      endif
      SCN(z:1,1)
      ACN((26+FAC):41, 1)

      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = 'DUPLIC' ")
        SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
    if Vacio(Val(t:56))
      * Vacio Cliente
      if Val(t:34)=0
        * NO MAE1
        * Marca Incompleto
        ACN(t:44, 1)
      endif
      ACT(t:56, 'SIOPEL')
      ACN((26+FAC):8, 1)
    endif
* FJL 12/09/22 - Se graba el book de la TMANIF
    ACT(t:60, Val(t:59))
    if Vacio(Val(t:60))
      ACT(t:60, BookDefault2(Val(t:29),Val(t:2),'',Val(t:3),'','','','','HAB')) 
    endif
    ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
    ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))

** FJL 21/07/22 - Se descartan los registros 0105-0205
**                Solo se toman los 7020 que llegan cuando se inicio con una TMANIF en FPA
*    if Incluido(fbn('CodigoRegistro'),'0105|0205')
    if Incluido(fbn('CodigoRegistro'),'0105') o (Incluido(fbn('CodigoRegistro'),'0205') y Val((26+FAC):2)=1)
      SCN(z:1,1)
      ACT(b:FAC, 'No Genera')
      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = 'NOGENERA' ")
        SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
** FJL 25/03/24 - Se busca siempre la TCPCEM para traer el divisor del Precio
*    if EqStr(Val(t:71),'S')
    if EqStr(Val(t:71),'S') o SI
      * Genera TMANIF
      *      ACT(t:72, QUERY("SELECT O.NrOperacion FROM "~DBO~".OPERACIONES  O, "~DBO~".OPERACIONESBITS OB WHERE O.NrOperacion = OB.NrOperacion and OB.Valor = '1' and OB.NrBit = 16 and TipoOp='TCPCEM' and Especie='"~ESPECIE~"' and Contraespecie='"~CONTRAESPECIE~"' and "~IdxDate2(FECHAORDEN)~">=FechaOp2 and "~IdxDate2(FECHAORDEN)~"<=FechaPago and RB8='0' "))
      ACT(t:72, SQL("SELECT O.NrOperacion FROM "~DBO~".OPERACIONES  O, "~DBO~".OPERACIONESBITS OB WHERE O.NrOperacion = OB.NrOperacion and OB.Valor = '1' and OB.NrBit = 16 and TipoOp='TCPCEM' and Especie='"~Val(t:3)~"' and Contraespecie='"~Val(t:12)~"' and FechaOp2<="~IdxDate2(Val(t:19))~" and FechaPago>="~IdxDate2(Val(t:19))~" and RB8='0' "))
      if NoVacio(Val(t:72))
        ACN(t:75, BuscarCampo('OPERACIONES','TipoCambio2','NrOperacion',Val(t:72)))
        if Val(t:75)<=0
          ACT(u:75, 'Forzado')
          ACN(t:75, 1)
        endif
        ACN(t:76, Val(t:76)/Val(t:75))
** FJL 22/07/25 - Issue 8385 - Debe respetar la tabla feriados de la TCPECEM
#ifdef BACS
        ACT(t:77, BuscarCampo('OPERACIONES','TablaFeriados1','NrOperacion',Val(t:72)))
        if NoVacio(Val(t:77))
          ACT(t:24, Val(t:77))
          * Solo si es Spot recalculo fecha Vto con la nueva tabla
          if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
            * Es Spot
            ***** FechaVto
            ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))
          endif
        endif
#endif
      else
        SCN(z:1,1)
        ACN((26+FAC):72, 1)
      endif
    endif

    ACN(t:51, Val(z:1))
    if Val(z:1)=0
      ACT(b:FAC, 'OK')

      if EqStr(Val(t:71),'S')
        * Genera TMANIF
        if Dialogo.Check1=1
          ACT(t:73, GetNumerador(215))
          ACT(d:FAC, Val(t:73))
          Message('--- #Tran : '~Val(t:73)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:56))
          *  messagebox('Grabo TMANIF')
          (.'GENTMANIF'.)
          ACT(t:53, Val(t:73))
        endif
      endif
      if Dialogo.Check1=1
        ACT(w6, GetNumerador(1))
        ACT(c:FAC, Val(w6))
        ACT(t:70,BuscarCampo('CANALES','AfectaPorDefecto','Codigo','MERCADO'))
        Message('--- #Op : '~Val(w6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:56))
        SQL.ADD("Insert into "~DBO~".OPERACIONES (")
          
        SQL.ADD("NrOperacion, ")
        SQL.ADD("TipoOp, ")
        SQL.ADD("TipoTicket, ")
        SQL.ADD("Especie, ")
        SQL.ADD("Cliente1, ")
          
        SQL.ADD("Cantidad, ")
        SQL.ADD("ContraEspecie, ")
        SQL.ADD("Precio1, ")
          
** FJL 29-03-19 - Se saca por cupon 0/1, ahora simpre ponemos cupon
*        if Val(x:2) <> 1
*          * No es LETES
*          SQL.ADD("Cupon1,")
*        endif
        SQL.ADD("Cupon1,")
        SQL.ADD("FechaOp, ")
          
        if EqStr(Val(x:1),'S')
          * Spot        
          SQL.ADD("Plazo, ")
          SQL.ADD("RB5, ")
        else
          * Futuro
          SQL.ADD("PlazoGracia, ")
        endif
        SQL.ADD("RB6, ")
        SQL.ADD("FechaVto, ")
        SQL.ADD("Mercado, ")
        SQL.ADD("Mercado2, ")
        SQL.ADD("FormaLiquidacion1, ")
          
        SQL.ADD("TablaFeriados1, ")
        SQL.ADD("Operador, ")
        SQL.ADD("OpSIOPEL, ")
          
        SQL.ADD("EnteCus1, ")
        SQL.ADD("EnteCus2, ")
        SQL.ADD("Vehiculo1, ")
        SQL.ADD("Mercado4, ")
          
        SQL.ADD("CB5, ")
        SQL.ADD("NroAltaMAE, ")
        SQL.ADD("UDN2, ")
        SQL.ADD("PaseCB, ")
          
        SQL.ADD("AceptaMAE, ")
        SQL.ADD("FechaAltaMAE, ")
        SQL.ADD("FechaEnvioMAE, ")
        
        SQL.ADD("RuedaMAE, ")
        SQL.ADD("EspecieMAE, ")
        SQL.ADD("AgenteMAE, ")
        SQL.ADD("ComitenteMAE, ")

        SQL.ADD("Cuenta1, ")
        SQL.ADD("Observaciones, ")
        SQL.ADD("Numerador, ")
          
        SQL.ADD("FechaCarga, ")
        SQL.ADD("FechaCargaSys, ")
        SQL.ADD("UsrInput, ")

        SQL.ADD("Direccion, ")
        SQL.ADD("NrOrden, ")
        SQL.ADD("Corporate, ")
        SQL.ADD("NrOrden1, ")
* FJL 12/09/22 - Se graba el book de la TMANIF
        SQL.ADD("Book1, ")
* MAC 17/07/23 - Se graba la cuenta de comsiones de la TMANIF
        SQL.ADD("Cuenta5, ")
        SQL.ADD("AfectaLS ")        

        SQL.ADD(") values (")
          
        * NrOperacion
        SQL.ADD(" '"~Val(w6)~"', ")
        * TipoOp
        SQL.ADD(" '"~Val(t:2)~"', ")
        * TipoTicket (Boden 2008)
        SQL.ADD(" '0', ")
        * Especie
        SQL.ADD(" '"~Val(t:3)~"', ")
        * Cliente1
        SQL.ADD(" '"~Val(t:56)~"', ")
          
        * Cantidad
        SQL.ADD(" "~FStr(Val(t:11),0,2)~", ")
        * ContraEspecie
        SQL.ADD(" '"~Val(t:12)~"', ")
        * Precio1
** FJL 25/03/2024 Por Divisor del precio de la TCPCEM
*        SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
        SQL.ADD(" "~FStr(Val(t:76),0,8)~", ")
        * Cupon1
** FJL 29-03-19 - Se saca por cupon 0/1, ahora simpre ponemos cupon
*        if Val(x:2) <> 1
*          * No es LETES
*          SQL.ADD(" '"~Val(t:17)~"', ")
*        endif
        SQL.ADD(" '"~Val(t:17)~"', ")
        * FechaOp
        SQL.ADD(" '"~IdxDate(Val(t:19))~"', ")
          
        if EqStr(Val(x:1),'S')
          * Spot        
          * Plazo (N)
          SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
          * RB5 (N)
          SQL.ADD(" '"~Val(t:20)~"', ")
        else
          * Futuro        
          * PlazoGracia (N)
           SQL.ADD(" "~FStr(Val(t:21),1,0)~" , ")
        endif
        * RB6 (N) Fuente=0=Siopel
        SQL.ADD(" '0', ")
        * FechaVto
        SQL.ADD(" '"~IdxDate(Val(t:45))~"', ")
        * Mercado
        SQL.ADD(" '"~Val(t:22)~"', ")
        * Mercado2
        SQL.ADD(" '"~Val(t:52)~"', ")
        * FormaLiquidacion1
        SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
          
        * TablaFeriados1
        SQL.ADD(" '"~Val(t:24)~"', ")
        * Operador
        SQL.ADD(" '"~Val(t:25)~"', ")
        * OpSIOPEL
        SQL.ADD(" '"~Val(t:26)~"', ")
          
        * EnteCus1 - CodMaeEsp (N)
        SQL.ADD(" '"~Val(t:27)~"', ")
        * EnteCus2 - NrMAE Agente (N)
        SQL.ADD(" '"~Val(t:57)~"', ")
        * Vehiculo1
        SQL.ADD(" '"~Val(t:29)~"', ")
        * Mercado4
        SQL.ADD(" '"~Val(t:31)~"', ")
          
        * CB5 (Oferta)
        SQL.ADD(" '1', ")
        * NroAltaMAE
        SQL.ADD(" '"~fbn('Secuencia')~"', ")
        * UDN2 (Rueda)
        SQL.ADD(" '"~Val(t:32)~"', ")
        * PaseCB
        SQL.ADD(" '"~Val(t:33)~"', ")
          
          
        * AceptaMAE
        SQL.ADD(" 'SI', ")
        * FechaAltaMAE
        SQL.ADD("Convert(datetime,'"~Val(t:84)~"',120), ")
        * FechaEnvioMAE
        SQL.ADD(" "~Val(t:49)~", ")

        * RuedaMAE
        SQL.ADD(" '"~Val(t:32)~"', ")
        * EspecieMAE
        SQL.ADD(" '"~Val(t:27)~"', ")
        * AgenteMAE
        SQL.ADD(" '"~Val(t:57)~"', ")
        * ComitenteMAE
        SQL.ADD(" '"~Val(t:61)~"', ")

        * Cuenta1
        SQL.ADD(" '"~Val(t:28)~"', ")
        * Observaciones
        SQL.ADD(" '"~Val(t:40)~"', ")
        * Numerador
        SQL.ADD(" 1, ")
          
        * FechaCarga
        SQL.ADD(" "~SQLAhora~", ")
        * FechaCargaSys
        SQL.ADD(" "~IdxDate2(FSys)~", ")
        * UsrInput
        SQL.ADD(" '"~UsuarioActivo~"', ")

        * Direccion
        SQL.ADD(" 2, ")

        * NrOrden
        SQL.ADD(" '"~Val(t:50)~"', ")
        * Corporate (Cartera Propia)
        SQL.ADD(" '"~FStr(Val(t:55),1,0)~"', ")
        * NrOrden1 (TMANIF)
        SQL.ADD(" '"~Val(t:53)~"', ")
* FJL 12/09/22 - Se graba el book de la TMANIF
        * Book1
        SQL.ADD(" '"~Val(t:60)~"', ")
* MAC 17/07/23 - Se graba la cuenta de comsiones de la TMANIF
        SQL.ADD("'"~val(t:74)~"', ")
        * AfectaLS
        SQL.ADD(" '"~Val(t:70)~"' ")        

        SQL.ADD(")")
        SQL.NEW
          
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = '"~Val(w6)~"' ")
        SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
        SQL.NEW
        SQL.EXEC

        Message('Modificar Operacion '~Val(w6))
* FJL 05/04/18 - No procesaba movimientos
*        ModificarOperacion(Val(w6),0,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
         ModificarOperacion(Val(w6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)

        
** AA 12/02/2018 Se genera instancia con variables por error Especie/Cliente
IF NO
        IF Not Ok
** MessageBox('Error en operacion '~Val(w6)~' Pasa a Carga Trader')
           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Values ('"~Val(w6)~"',4,'1')  ")
           SQL.NEW
           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Values ('"~Val(w6)~"',1,'0')  ")
           SQL.NEW
           SQL.ADD("Update "~DBO~".OPERACIONES  ")
           SQL.ADD("   Set Direccion = 2,  ")
           SQL.ADD("       EsCaucionado='1'  ")
           SQL.ADD(" where NrOperacion = '"~Val(w6)~"' ")
           SQL.NEW
        Else
** MessageBox('Operacion '~Val(w6)~' Ok. Pasa a Instancia 5')
           ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
           SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w6)~"' ")
           SQL.NEW
        Endif
        SQL.EXEC
Endif

        IF Ok
           ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
           SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w6)~"' ")
           SQL.NEW
           SQL.EXEC                   
        Endif
        
        If Val(k:1) = 1 o Val(l:1) = 1
        ** MessageBox('Operacion '~Val(w6)~' Ok. Pasa a Instancia 4')        
        ** AA Actualizo. se ejecuta siempre modificaroperacion y las instancias estan creadas
*           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
*           SQL.ADD("Values ('"~Val(w6)~"',4,'1')  ")
*           SQL.NEW
*           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
*           SQL.ADD("Values ('"~Val(w6)~"',1,'0')  ")
*           SQL.NEW
           SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Set Valor='0'  ")
           SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Valor = '1' ")
           SQL.NEW
           SQL.EXEC           
           SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Set Valor='1'  ")
           SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Nrbit = 4 ")
           SQL.NEW
           SQL.ADD("Update "~DBO~".OPERACIONES  ")
           SQL.ADD("   Set Direccion = 2,  ")
           SQL.ADD("       EsCaucionado='1'  ")
           SQL.ADD(" where NrOperacion = '"~Val(w6)~"' ")
           SQL.NEW      
           SQL.EXEC
           **Else
           **EjecutarEvento('ASIBOL',NrOperacion1=Val(w:6))  
        Endif
        
        Message('Fin Modificar Operacion')
        
        if NoVacio(Val(t:53))
          * Tengo numero de TMANIF
*** FJL 04/04/2018 - Se saco porque esta en la PostEdicion de la TCOPRI y se ejecuta con el ModificaOperacion()
*          Message('Actualiza TMANIF '~Val(t:53))
*          EjecutarEvento('ACTTMA', NrOrden1=Val(t:53), NrOperacion1=Val(w:6), Check1=Dialogo.Check1)
        endif
        
      endif
      * Fin Check1=1
    endif
    * Fin z:1=0
    if Dialogo.Check1=0
      ACT((78+FAC):1,  Val(t:1))
      ACT((78+FAC):2,  Val(t:2))
      ACT((78+FAC):3,  Val(t:3))
      ACT((78+FAC):4,  Val(t:4))
      ACT((78+FAC):5,  Val(t:5))
      ACN((78+FAC):6,  Val(t:6))
      ACT((78+FAC):7,  Val(t:7))
      ACT((78+FAC):8,  Val(t:8))
      ACT((78+FAC):9,  Val(t:9))
