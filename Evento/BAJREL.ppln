sql.add("Select * from "~Dbo()~".MENSAJESMAE ")
sql.add(" where Codigo  = 'BAJREL' ")
sql.add("   and Estado = 'ING' ")
recorrer sql
Acn(a:1, 0)
Act(3 + fac:1, Fbn('Codigo'))
Act(3 + fac:2, Fbn('FechaMAE'))
Act(3 + fac:3, Fbn('HoraMAE'))
Act(3 + fac:4, Fbn('Secuencia'))
Act(3 + fac:5, Fbn('CodigoMAE'))
Act(3 + fac:6, Fbn('Estado'))

Message('Preparando Informacion de Busqueda de Ops. (Sec. '~Fbn('Secuencia')~')')

Act(a:2, Fbn('Mensaje1'))
if (NoVacio(Fbn('Mensaje2')))
Act(a:2, Val(a:2)~Fbn('Mensaje2'))
endif
if (NoVacio(Fbn('Mensaje3')))
Act(a:2, Val(a:2)~Fbn('Mensaje3'))
endif

Act(3 + fac:11, Copy(Val(a:2), 5, 1))
Act(3 + fac:12, Copy(Val(a:2), 6, 3))
Act(3 + fac:13, Copy(Val(a:2), 9, 2))
Act(3 + fac:14, Copy(Val(a:2), 11, 6))
Act(3 + fac:15, Copy(Val(a:2), 17, 6))
Act(3 + fac:16, Copy(Val(a:2), 23, 5))
Act(3 + fac:17, Copy(Val(a:2), 28, 4))
Act(3 + fac:18, Copy(Val(a:2), 32, 4))
Act(3 + fac:19, Copy(Val(a:2), 36, 6))
Act(3 + fac:20, Copy(Val(a:2), 42, 5))
Act(3 + fac:21, Copy(Val(a:2), 47, 1))
Act(3 + fac:22, Copy(Val(a:2), 48, 6))
Act(3 + fac:23, Copy(Val(a:2), 54, 5))

sql.add("Select NrOperacion, NroAltaMAE, NroBajaMAE, NrSisExterno, ")
sql.add("       CB5,         UDN2,       PaseCB,     NrOperacion3 ")
sql.add("  from "~Dbo()~".OPERACIONES ")
sql.add(" where NroAltaMAE = '"~Val(3 + fac:23)~"' ")
recorrer sql
Dfa()
Scn(3 + fac:31, 1)
Act(3 + fac:32, Fbn('NrOperacion'))
Act(3 + fac:33, Fbn('NroAltaMAE'))
Act(3 + fac:34, Fbn('NroBajaMAE'))
Act(3 + fac:35, Fbn('NrSisExterno'))
Act(3 + fac:36, Fbn('CB5'))
Act(3 + fac:37, Fbn('UDN2'))
Act(3 + fac:38, Fbn('PaseCB'))
Act(3 + fac:39, Fbn('NrOperacion3'))
proximo
Acn(a:3, Val(3 + fac:31))
if (Val(a:3) <> 1)
Acn(a:1, 1)
if (Val(a:3) = 0)
Act(3 + fac:7, 'No Existe Op')
else
Act(3 + fac:7, 'Multip.Operac.')
endif
endif
if (Val(a:1) = 0)
if (NoVacio(Val(3 + fac:34)))
Acn(a:1, 1)
Act(3 + fac:7, 'Op con NroBaja')
endif
endif
if (Val(a:1) = 0)
sql.add("Select NrOperacion, NroAltaMAE, NroBajaMAE, NrSisExterno, ")
sql.add("       CB5,         UDN2,       PaseCB,     NrOperacion3 ")
sql.add("  from "~Dbo()~".OPERACIONES ")
sql.add(" where NrSisExterno = '"~Val(3 + fac:35)~"' ")
sql.add("   and NrOperacion  <> '"~Val(3 + fac:32)~"' ")
if (Eqstr(Val(3 + fac:38), '1'))
sql.add("   and NrOperacion  <> '"~Val(3 + fac:39)~"' ")
endif
recorrer sql
Dfa()
Scn(3 + fac:51, 1)
Act(3 + fac:52, Fbn('NrOperacion'))
Act(3 + fac:53, Fbn('NroAltaMAE'))
Act(3 + fac:54, Fbn('NroBajaMAE'))
Act(3 + fac:55, Fbn('NrSisExterno'))
Act(3 + fac:56, Fbn('CB5'))
Act(3 + fac:57, Fbn('UDN2'))
Act(3 + fac:58, Fbn('PaseCB'))
Act(3 + fac:59, Fbn('NrOperacion3'))
proximo
Acn(a:4, Val(3 + fac:51))
if (Val(a:4) <> 1)
Acn(a:1, 1)
if (Val(a:4) = 0)
Act(3 + fac:7, 'No Existe Op Rel')
else
Act(3 + fac:7, 'Multip.Operac. Rel')
endif
endif
endif
if (Val(a:1) = 0)
if (Vacio(Val(3 + fac:54)))
Acn(a:1, 1)
Act(3 + fac:7, 'OpRel sin NroBaja')
endif
endif
if (Val(a:1) = 0)
sql.add("Select NrBit ")
sql.add("  from "~Dbo()~".OPERACIONESBITS ")
sql.add(" where NrOperacion = '"~Val(3 + fac:32)~"' ")
sql.add("   and Valor       = '1' ")
recorrer sql
Dfa()
Act(3 + fac:40, Val(3 + fac:40)~FStr(Fbn('NrBit'), 1, 0)~'|')
proximo
if (Vacio(Val(3 + fac:40)))
Acn(a:1, 1)
Act(3 + fac:7, 'Oper sin Instan.')
endif
endif
if (Val(a:1) = 0)
sql.add("Select NrBit ")
sql.add("  from "~Dbo()~".OPERACIONESBITS ")
sql.add(" where NrOperacion = '"~Val(3 + fac:52)~"' ")
sql.add("   and Valor       = '1' ")
recorrer sql
Dfa()
Act(3 + fac:60, Val(3 + fac:60)~FStr(Fbn('NrBit'), 1, 0)~'|')
proximo
if (Vacio(Val(3 + fac:60)))
Acn(a:1, 1)
Act(3 + fac:7, 'OpRel sin Instan.')
endif
endif
if (Val(a:1) = 0)
if (not Eqstr(Val(3 + fac:35), Val(3 + fac:55)))
Acn(a:1, 1)
endif
if (not Eqstr(Val(3 + fac:36), Val(3 + fac:56)))
Acn(a:1, 1)
endif
if (not Eqstr(Val(3 + fac:37), Val(3 + fac:57)))
Acn(a:1, 1)
endif
if (not Eqstr(Val(3 + fac:38), Val(3 + fac:58)))
Acn(a:1, 1)
endif
if (not Eqstr(Val(3 + fac:39), Val(3 + fac:59)))
Acn(a:1, 1)
endif
if (Val(a:1) = 1)
Act(3 + fac:7, 'Diferencias')
endif
endif
if (Val(a:1) = 0)
Act(3 + fac:8, 'OK')

if (dialogo.check1 = 1)
Message('Actualiza datos BajaMAE operacion '~Val(3 + fac:32))
Act(a:11, Copy(Val(3 + fac:14), 5, 2)~'/'~Copy(Val(3 + fac:14), 3, 2)~'/'~Copy(Val(3 + fac:14), 1, 2)~' '~Copy(Val(3 + fac:15), 1, 2)~':'~Copy(Val(3 + fac:15), 3, 2)~':'~Copy(Val(3 + fac:15), 5, 2))
Act(a:12, SQLFechaStr(Val(a:11), exe('FORFECHOR')))
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set FechaBajaMAE = "~Val(a:12)~", ")
sql.add("       NroBajaMAE   = '"~Val(3 + fac:16)~"' ")
sql.add(" Where NrOperacion  = '"~Val(3 + fac:32)~"' ")
sql.new
sql.exec
else
Messagebox('Actualiza datos BajaMAE operacion '~Val(3 + fac:32))
endif
if (dialogo.check1 = 1)
Message('BAJREL llama DESAFE operacion '~Val(3 + fac:32))
ejecutarevento('DESAFE', nroperacion1 = Val(3 + fac:32))
else
Messagebox('BAJREL llama DESAFE operacion '~Val(3 + fac:32))
endif

sql.add("Select NrBit from "~Dbo()~".OPERACIONESBITS ")
sql.add(" where NrOperacion = '"~Val(3 + fac:32)~"' ")
sql.add("   and Valor       = '1' ")
recorrer sql
Dfa()
if (dialogo.check1 = 1)
Message('BAJREL pasa operacion '~Val(3 + fac:32)~' de '~FStr(Fbn('NrBit'), 1, 0)~' a 12')
ejecutarevento('CBOINS', string1 = Val(3 + fac:32), radio1 = 1, radio2 = 1, entero1 = Fbn('NrBit'), entero2 = 30)
else
Messagebox('BAJREL pasa operacion '~Val(3 + fac:32)~' de '~FStr(Fbn('NrBit'), 1, 0)~' a 30')
endif
proximo
if (dialogo.check1 = 1)
Message('Pone PRO en MENSAJESMAE')
sql.add("Update "~Dbo()~".MENSAJESMAE ")
sql.add("   Set Estado    = 'PRO' ")
sql.add(" Where Codigo    = '"~Val(3 + fac:1)~"' ")
sql.add("   and FechaMAE  = '"~Val(3 + fac:2)~"' ")
sql.add("   and HoraMAE   = '"~Val(3 + fac:3)~"' ")
sql.add("   and Secuencia = '"~Val(3 + fac:4)~"' ")
sql.add("   and CodigoMAE = '"~Val(3 + fac:5)~"' ")
sql.add("   and Estado    = '"~Val(3 + fac:6)~"' ")
sql.new
sql.exec
else
Messagebox('Pone PRO en MENSAJESMAE')
endif
endif
proximo

SetFont(c:1..c:70, 2)
ACO(1, 40)
ACO(3, 10)
if (Fac() > 0)
SetFont(d:1..3 + fac:70, 1)
