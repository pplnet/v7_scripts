HojaVisible(NO)



ACD(A:1,PriDeMes(FSYS,NO,'ARG'))
IF FSYS= Val(A:1) O SI
   ACD(A:2,Habiles(Val(A:1),-1,'ARG'))
   ACD(A:3,PriDeMes(Val(A:2),NO,'ARG'))
   IF Vacio(UsrVehiculos(UsuarioActivo))
      ACT(LI:1,SQLSET(" Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "))
   Else
       ACT(LI:1,SQLSET(" Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' "))
   EndIF
   SQL.ADD(" Insert into "~DBO~".LOGINFORMES ")
   SQL.ADD(" (Usuario, Fecha, Tipo, Codigo, Datos) ")
   SQL.ADD(" Values ")
   SQL.ADD(" ( '"~UsuarioActivo~"', '"~IdxDate(TRUNC(AHORA))~' '~Hora(AHORA)~"', 'EVE', 'CONT24','Inicio') ")
   SQL.NEW
   SQL.EXEC
   EjecutarEvento('CONT00', Fecha1=Val(A:3), Fecha2=Val(A:1), Lista1=Val(LI:1))   
   SQL.ADD(" Insert into "~DBO~".LOGINFORMES ")
   SQL.ADD(" (Usuario, Fecha, Tipo, Codigo, Datos) ")
   SQL.ADD(" Values ")
   SQL.ADD(" ( '"~UsuarioActivo~"', '"~IdxDate(TRUNC(AHORA))~' '~Hora(AHORA)~"', 'EVE', 'CONT24','Finalizo') ")
   SQL.NEW
   SQL.EXEC
EndIf 



