creardialogo
fecha1:'Fecha';;;;;;;;;Fecha(Var('CIEPAR'))
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.fecha1 <> Fecha(Var('CIEPAR')))
Cancelar('el ultimo Cierre Realizado es del '~Var('CIEPAR'))
endif

Acn(bd:1, 0)
Sqladd(" Select O.NrOperacion, C.NrCuota ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
Sqladd(" Where O.NrOperacion = C.NrOperacion ")
Sqladd(" AND O.TipoOp = 'PARTID' ")
Sqladd(" AND ((C.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND O.FechaCargaSys < '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("       OR (C.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' AND O.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"')) ")

Sqladd("  ")
Sqladd("  ")
recorrer sql
Sqladd(" Delete "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND NrCuota = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
Sqlnew()
Sqlexec()
Acn(bd:1, 1)
Sqladd("select P.ValorAnterior from "~Dbo()~".PMAUDIT P where ")
Sqladd("P.Tabla = 'VARIABLES' ")
Sqladd("AND P.Codigo = 'CIEPAR' ")
Sqladd("AND P.ValorActual = '"~dialogo.fecha1~"' ")
Sqladd("AND P.Fecha = (Select Max(P2.Fecha) From "~Dbo()~".PMAUDIT P2 ")
Sqladd("   Where P.Tabla = P2.Tabla ")
Sqladd("   AND P.Codigo = P2.Codigo ")
Sqladd("   AND P2.ValorAnterior= P.ValorAnterior ")
Sqladd(" AND P2.Fecha <= "~SQLAhora()~" ) ")
Watch(Sqlbatch())
recorrer sql
let(&valoranterior, Fecha(Habiles(dialogo.fecha1, -1, 'ARG')))
Sqladd(" Update "~Dbo()~".VARIABLES ")
Sqladd(" Set Valor = '"~&valoranterior~"' ")
Sqladd(" Where Codigo = 'CIEPAR' ")
Sqlnew()
Sqlexec()
proximo
proximo

if (Val(bd:1) = 0)
Messagebox('No fue realizado el cierre del día para la fecha '~dialogo.fecha1)
else
Messagebox('Anulacion del Cierre de Partidas Realizado con Exito para la fecha '~dialogo.fecha1)
endif


