creardialogo
fecha1:'Fecha';;;;;;;;;Fecha(Var('CIEPAR'))
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.fecha1 <> Fecha(Var('CIEPAR')))
Cancelar()('el ultimo Cierre Realizado es del '~Var('CIEPAR'))
endif

Acn(bd:1, 0)
sql.add(" Select O.NrOperacion, C.NrCuota ")
sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C ")
sql.add(" Where O.NrOperacion = C.NrOperacion ")
sql.add(" AND O.TipoOp = 'PARTID' ")
sql.add(" AND ((C.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND O.FechaCargaSys < '"~IdxDate(dialogo.fecha1)~"') ")
sql.add("       OR (C.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' AND O.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"')) ")

sql.add("  ")
sql.add("  ")
recorrer sql
sql.add(" Delete "~Dbo()~".CUOTAS ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.add(" AND NrCuota = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
sql.new
sql.exec
Acn(bd:1, 1)
sql.add("select P.ValorAnterior from "~Dbo()~".PMAUDIT P where ")
sql.add("P.Tabla = 'VARIABLES' ")
sql.add("AND P.Codigo = 'CIEPAR' ")
sql.add("AND P.ValorActual = '"~dialogo.fecha1~"' ")
sql.add("AND P.Fecha = (Select Max(P2.Fecha) From "~Dbo()~".PMAUDIT P2 ")
sql.add("   Where P.Tabla = P2.Tabla ")
sql.add("   AND P.Codigo = P2.Codigo ")
sql.add("   AND P2.ValorAnterior= P.ValorAnterior ")
sql.add(" AND P2.Fecha <= "~SQLAhora()~" ) ")
Watch(sql.batch)
recorrer sql
let(&valoranterior, Fecha(Habiles(dialogo.fecha1, -1, 'ARG')))
sql.add(" Update "~Dbo()~".VARIABLES ")
sql.add(" Set Valor = '"~&valoranterior~"' ")
sql.add(" Where Codigo = 'CIEPAR' ")
sql.new
sql.exec
proximo
proximo

if (Val(bd:1) = 0)
Messagebox('No fue realizado el cierre del día para la fecha '~dialogo.fecha1)
else
Messagebox('Anulacion del Cierre de Partidas Realizado con Exito para la fecha '~dialogo.fecha1)
endif


