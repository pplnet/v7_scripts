*-- PREON: Precancelacion de FRN Utilizando Calls y Puts
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Fecha2       : "Fecha Ej."                ;;;;;;Dialogo.Fecha2>BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1) y Dialogo.Fecha2>=Fsys;'LA FECHA DE EJERCICIO DEBE SER MAYOR QUE LA FECHA DE ORIGEN DE LA OPERACION';NO
  Fecha3       : "Ult.PagoInt"              ;;;;NO;;;;;;IIF(Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMFRN'),BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1),SQL("SELECT Fecha1 FROM  "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and Fecha2>='"~IdxDate(Dialogo.Fecha2)~"' ")) 
  Radio2       : "Tipo|Call|Put"            ;;;;;;;;;0;
  Precio10     : "Precio Ej"                ;;;;NO;;Dialogo.Precio10>0;'No se Ha Encontrado una Opcion de Precancelacion para Esta Fecha';NO;;SQL(" Select PrecioEj from "~DBO~".OPSCALLSPUTS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaEj='"~IdxDate(Dialogo.Fecha2)~"' and TipoOpcion='"~IIF(Dialogo.Radio2=0,'CAL','PUT')~"' ")
  Entero1      : "Plazo"                    ;;;;NO;;;;;0;Dialogo.Fecha2-Dialogo.Fecha3
  Precio7      : 'Tasa %'                   ;;;;NO;;;;;;Dialogo.Precio5+Dialogo.Precio6
  Precio1      : '%_Canc'                   ;;;;;;Dialogo.Precio1>0 y Dialogo.Precio1<=100;'El Porcentaje Cancelable es Incorrecto';NO;;
  Cantidad2    : 'Valor Nominal'            ;;;;NO;;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion1);;;"###,###,###,###.##"
  Radio3       : "Precancelable|Si|No"      ;2;2;;NO;;Dialogo.Radio3=0;'La Operacion DEBE SER PRECANCELABLE !!!';NO;;BuscarCampo('Operaciones','RB10','NrOperacion',Dialogo.NrOperacion1)
  Fecha1       : 'Fecha_Pago'               ;3;2;;;;Dialogo.Fecha1>=Dialogo.Fecha2 Y ESHABIL(Dialogo.Fecha1,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1)) Y ESHABIL(Dialogo.Fecha1,'ARG')];'La Fecha de Pago no es Dia Habil';NO;
  Cantidad3    : 'Int_Corridos'             ;;;;;;;;;;Dialogo.Cantidad4*(Dialogo.Precio7/100)*FACTORDIAS(Dialogo.Fecha3,Dialogo.Fecha2,BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1);;;"###,###,###,###.##"
  Cantidad4    : 'VN_Cancelado'             ;;;;NO;;;;;;Dialogo.Cantidad2*Dialogo.Precio1/100;;;"###,###,###,###.##"
  Cantidad5    : 'Imp_Pagar'                ;;;;NO;;;;;;(Dialogo.Cantidad4*Dialogo.Precio10/100)+(Dialogo.Precio1-Dialogo.Precio1);;;"###,###,###,###.##"
  Cantidad1    : 'Total_Pagar'              ;;;;NO;;;;;;Dialogo.Cantidad5+Dialogo.Cantidad3+(Dialogo.Precio1-Dialogo.Precio1);;;"###,###,###,###.##"
  Precio5      : 'Tasa MMFRN'               ;;;;NO;NO;;;;;BuscarCampo('Operaciones','Precio1+Spread','NrOperacion',Dialogo.NrOperacion1)
  Precio6      : 'Tasa MMFCMV'              ;;;;NO;NO;;;;;SQL("SELECT Precio2+Precio4 FROM  "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and Fecha2>='"~IdxDate(Dialogo.Fecha2)~"' ")
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMFRN|MMFCMV')
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es una FRN')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf


If Ok
   * X1: Recupero la Operacion

   acn(x1,0)
   act(a1,IIF(Dialogo.Radio2=0,'CAL','PUT'))
   act(a2,BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1))
   act(a3,BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1))
   act(a4,BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1))

   SQL.ADD("Select PrecioEj from "~DBO~".OPSCALLSPUTS ")
   SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and FechaEj='"~IdxDate(Dialogo.Fecha2)~"' ")
   SQL.ADD("and TipoOpcion='"~VAL(a1)~"' ")
   SQL.ADD("and Ejercida='0' ")

   Recorrer SQL

     acn(x1,1)

     Message('Actualizando Calls y  Puts  .... ')
           
     *** Marca la operacion como ejercida ***
     SQL.ADD("Update "~DBO~".OPSCALLSPUTS ")
     SQL.ADD("Set ")
     SQL.ADD("Ejercida    ='1', ")
     SQL.ADD("FechaPago   ='"~IdxDate(Dialogo.Fecha1)~"', ")
     SQL.ADD("PorCancelar ="~Fstr(Dialogo.Precio1,0,2)~", ")
     SQL.ADD("VNCancelado ="~Fstr(Dialogo.Cantidad4,0,2)~", ")
     SQL.ADD("ImpVNCancela="~Fstr(Dialogo.Cantidad5,0,2)~", ")
     SQL.ADD("IntCorridosEj="~Fstr(Dialogo.Cantidad3,0,2)~", ")
     SQL.ADD("ImporteTotEj="~Fstr(Dialogo.Cantidad1,0,2)~" ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.ADD("and FechaEj='"~IdxDate(Dialogo.Fecha2)~"' ")
     SQL.ADD("and TipoOpcion='"~VAL(a1)~"' ")
     SQL.ADD("and Ejercida='0' ")
     SQL.NEW

     Message('Actualizando la Operacion Principal  .... ')                  
     SQL.ADD("Update "~DBO~".OPERACIONES ")
     SQL.ADD("Set ")
     SQL.ADD("TotalBrutoCli3 = TotalBrutoCli3 - "~Fstr(Dialogo.Cantidad4,0,2)~" ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW

     EjecutarEvento('PROCUO',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=Dialogo.NrOperacion1,String1=" Fecha2>='"~IdxDate(Dialogo.Fecha2)~"' ",Precio1=-Dialogo.Cantidad4)

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)      

     *** Actualiza movimientos y limites ****
     SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
     SQL.EXEC

     ** Recorro los Items Precancelandolos
     * A6: Sumatoria del Capital de todos los items de ese participante

     ACN(A6,SQL("Select SUM(Cantidad) from "~DBO~".OPERACIONES where OperacionRef='"~Dialogo.NrOperacion1~"' ") )

     SQL.ADD("Select * from "~DBO~".OPERACIONES ")
     SQL.ADD("where OperacionRef='"~Dialogo.NrOperacion1~"' ")

     Recorrer SQL

        Message('Operacion Nro: '~FBN['NrOperacion'])

        ** Para Cada Item determino cual es el % a Cancelar 
        **-- a5: VN Cancelado  A2: Importe a Pagar  A3: Total a Pagar  A4: Intereses Corridos
        ACN(a5,FBN['Cantidad']*Dialogo.Cantidad4/VAL(a6) )

        ACN(A2,VAL(a5)*Dialogo.Precio10/100)
        ACN(A4,VAL(a5)*(Dialogo.Precio7/100)*FACTORDIAS(Dialogo.Fecha3,Dialogo.Fecha2,BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))
        ACN(A3,VAL(A2)+VAL(A4))

        SQL.ADD("Update "~DBO~".OPSCALLSPUTS ")
        SQL.ADD("Set ")
        SQL.ADD("Ejercida    ='1', ")
        SQL.ADD("FechaPago   ='"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("PorCancelar ="~Fstr(Dialogo.Precio1,0,2)~", ")
        SQL.ADD("VNCancelado ="~Fstr(VAL(a5),0,2)~", ")
        SQL.ADD("ImpVNCancela="~Fstr(VAL(a2),0,2)~", ")
        SQL.ADD("IntCorridosEj="~Fstr(VAL(a4),0,2)~", ")
        SQL.ADD("ImporteTotEj="~Fstr(VAL(a3),0,2)~" ")
        SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
        SQL.ADD("and FechaEj='"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD("and TipoOpcion='"~VAL(a1)~"' ")
        SQL.ADD("and Ejercida='0' ")
        SQL.NEW
        SQL.EXEC

        Message('Actualizando la Items  .... ')                  
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set ")
        SQL.ADD("Cantidad = Cantidad - "~Fstr(VAL(a5),0,2)~" ")
        SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
        SQL.NEW
        SQL.EXEC

        
        EjecutarEvento('PROCUO',NrOperacion1=FBN['OperacionRef'],NrOperacion2=FBN['NrOperacion'],String1=" Fecha2>='"~IdxDate(Dialogo.Fecha2)~"' ",Precio1=-VAL(a5))

        * Actualizo la Instancia de la Operacion a Supervision
        ACT(i3,FBN['NrOperacion'])

        (.'MODIINSTAN'.)      

        *** Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
        SQL.EXEC
      Proximo
   Proximo
   If Val(x1)=0
      Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No Puede Precancelarse ')
   endif
endif