MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
lista1: 'Vehiculos';3;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
listatabla1: 'Operaciones';-3;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';;;;NO;NO;

findialogo

if (not ok)
Cancelar()
endif

Message('--- Asientos de Reclasificacion Deuda Prestamos ---')

Acn(di:1, Query(" Select 1 from "~Dbo()~".VARIABLES where Codigo = 'DIASCONT' "))
Acn(x3, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo = 'DIASCONT' "))
if (Val(di:1) = 1)
Acn(di:1, Trunc(Var('DIASCONT'), 0))
endif
if (Val(di:1) < 1)
Acn(di:1, 1)
endif
Acd(di:2, Habiles(PriDeMes(dialogo.fecha1, SI) - 1, Val(di:1), 'ARG'))
if (dialogo.fecha1 <> Val(di:2))
Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
endif



Acd(fe:1, dialogo.fecha1)
Acd(fe:2, FinDeMes(PriDeMes(dialogo.fecha1, SI) - 1, NO))
Acd(fe:3, FinDeMes(PriDeMes(Val(fe:2), SI) - 1, NO))
Acd(fe:4, Val(fe:2) + Var('PLCAPCORR'))
Acd(fe:5, Val(fe:3) + Var('PLCAPCORR'))

Acn(gs:1, 0)



Sqladd(" SELECT Case When O.TipoOp in ('SEPVMV','SEPTMV') Then O.ContraEspecie Else O.Especie END Moneda, O.NrOperacion, O.Especie, ")
Sqladd("        O.ContraEspecie, O.TipoOp, MA.Codigo CodAsi, V.Valor1, V.Valor2, CU.Fecha2 FechaVto, O.Vehiculo1, E.Tipo, O.FechaOp, ")
Sqladd("        O.Cliente1, Case O.TipoOp When 'MMONM ' Then CU.Cantidad4 Else CU.Cantidad1 END Cantidad, O.Observaciones, O.MB3, ")
Sqladd("        E.Alias8, V.Alias4, O.Precio1, CU.Cantidad3Ori, CU.Cantidad9 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, ")
Sqladd("      "~Dbo()~".CUOTAS CU, "~Dbo()~".ESPECIES E ")
Sqladd(" Where O.Cliente1 = C.Codigo ")
Sqladd("   AND O.Vehiculo1 = V.Codigo ")
Sqladd("   AND O.Especie = E.Codigo ")
Sqladd("   AND O.NrOperacion = CU.NrOperacion ")
Sqladd("   AND O.TipoOp IN ('MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMFCMV','MMPCCM','MMONM','SEPVMV','SEPTMV') ")
Sqladd("   AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIREDE'))~") ")
Sqladd("   AND O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd("   AND CU.Fecha2 > O.FechaOp +"~Var('PLCAPCORR'))
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
else 
Sqladd(" AND CU.Fecha2 <= '"~IdxDate(Val(fe:4))~"' ")
Sqladd(" AND CU.Fecha2 > '"~IdxDate(Val(fe:5))~"' ")
Sqladd(" AND O.FechaOp <= '"~IdxDate(Val(fe:2))~"' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
endif
Sqladd(" ORDER By O.NrOperacion, MA.Codigo ")

recorrer sql
Acd(fv:1, Val(fe:2))
Act(vh:1, Fbn('Vehiculo1'))
Acn(ck:1, 0)
if (Incluido(Fbn('TipoOp'), 'SEPVMV|SEPTMV|'))
Acn(rc:1, Fbn('Cantidad') * Fbn('Precio1'))
else 
if (Incluido(Fbn('TipoOp'), 'MMPCLM|MMPOSM|'))
Acn(rc:1, Fbn('Cantidad3Ori'))
else 
Acn(rc:1, Fbn('Cantidad'))
endif
endif
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo





Sqladd(" SELECT CO.Especie1 as Moneda, O.NrOperacion, CO.Especie1 as Especie, O.ContraEspecie, O.TipoOp, MA.Codigo CodAsi, V.Valor1,")
Sqladd("        V.Valor2, O.FechaVto, O.Vehiculo1, E.Tipo, O.FechaOp, O.Cliente1, O.Observaciones, O.MB3, ")
Sqladd("        E.Alias8, V.Alias4, O.Precio1, CO.Fecha1, CO.NrComision, 0 as Cantidad, 0 as Cantidad9 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, ")
Sqladd("      "~Dbo()~".COMISIONES2 CO, "~Dbo()~".ESPECIES E ")
Sqladd(" Where O.Cliente1 = C.Codigo ")
Sqladd("   AND O.Vehiculo1 = V.Codigo ")
Sqladd("   AND O.Especie = E.Codigo ")
Sqladd("   AND O.NrOperacion = CO.NrOperacion ")
Sqladd("   AND O.TipoOp = 'MMONM' ")
Sqladd("   AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIREDE'))~") ")
Sqladd("   AND O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd("   AND O.FechaVto > CO.Fecha1 +"~Var('PLCAPCORR'))
Sqladd("   AND CO.Fecha1 <= '"~IdxDate(Val(fe:2))~"' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
else 
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
endif
Sqladd(" ORDER By O.NrOperacion, MA.Codigo ")

recorrer sql
Acd(fv:1, Val(fe:2))
Act(vh:1, Fbn('Vehiculo1'))
Acn(ck:1, 0)

if (Fbn('Fecha1') > Val(fe:3))
Acd(fd:1, Fbn('Fecha1') + Var('PLCAPCORR'))
else 
Acd(fd:1, Val(fe:3) + Var('PLCAPCORR'))
endif

Acn(gs:1, 0)
Sqladd(" Select SUM(Monto) Monto ")
Sqladd(" FROM "~Dbo()~".MOVDEVENGADOS ")
Sqladd(" WHERE NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND TipoDevengado = 'COMION' ")
Sqladd(" AND Cupon = "~Fbn('NrComision')~" ")
Sqladd(" AND Fecha > '"~IdxDate(Val(fd:1))~"' ")
Sqladd(" AND Fecha <= '"~IdxDate(Val(fe:4))~"'  ")
recorrer sql
Acn(gs:1, Round(Abs(Fbn('Monto')), 2))
proximo

if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo

