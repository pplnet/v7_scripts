**//HojaVisible(SI)

* TOMA UNA OPERACION DE LA INSTANCIA ACONTROLAR Y LUEGO
* DE CONTROLARLA LA DEJA EN LA INSTANCIA CORRESPONDIENTE
CrearDialogo
   Fecha1      : 'Fecha'      ; 1;1;;  ;  ;;;;FSys
   NrOperacion1: 'NrOperacion'; 1;2;;  ;  ;NoVacio(Dialogo.NrOperacion1);'Debe ingresar una Operacion';NO;
   Check1      : 'Procesa'    ; 2;1;;SI;SI;;;;0
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, 'NrOperacion')
ACT(a:2, 'TipoOp')
ACT(a:3, 'Especie')
ACT(a:4, 'Cliente')
ACT(a:5, 'FechaOp')
ACT(a:6, 'FechaVto')
ACT(a:7, 'Limite')
ACT(a:8, 'Commited')
ACT(a:9, 'Sublimite')
ACT(a:10, 'Vehiculo')
ACT(a:11, 'Cantidad')
ACT(a:12, 'Intereses')
ACT(a:13, 'Total')
ACT(a:14, 'ContractST')

SQL.ADD("Select * from "~DBO~".OPERACIONES where NrOperacion='"~Dialogo.NrOperacion1~"' ")
recorrer SQL
  DFA
  ACT(b:1, fbn('NrOperacion'))
  ACT(b:2, fbn('TipoOp'))
  ACT(b:3, fbn('Especie'))
  ACT(b:4, fbn('Cliente1'))
  ACD(b:5, fbn('FechaOp'))
  ACD(b:6, fbn('FechaVto'))
  ACT(b:7, fbn('TipoLimite'))
  ACT(b:8, iif(fbn('RB5')=0,'SI','NO'))
  ACT(b:9, fbn('Sublimite'))
  ACT(b:10, fbn('Vehiculo1'))
  ACN(b:11, fbn('Cantidad'))
  ACN(b:12, fbn('TotalIntereses'))
  ACN(b:13, fbn('TotalBrutoCli1'))
  ACT(b:14, fbn('Centro2'))
proximo


if EqStr(Val(b:10),VAR('VEHICULODE'))
  * CONTROL LIMITES DE CREDITO BCRA
  ACT(c:1, 'RPC')
  ACN(d:1, BuscarCampo('CLIENTES','RPC','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',VAR('VEHICULODE'))))
  ACT(c:2, 'RPC Ant')
  ACN(d:2, BuscarCampo('CLIENTES','Valor3','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',VAR('VEHICULODE'))))
  SetFilaActual(1)
  ACT(j:FAC, 'Cliente')
  ACT(k:FAC, 'Patrim')
  ACT(l:FAC, 'BCRAN')
  ACT(m:FAC, 'ACIDN')
  ACT(n:FAC, 'ACCON')
  ACT(o:FAC, 'ACMAN')
  ACT(p:FAC, 'BCRAG')
  ACT(q:FAC, 'ACIDG')
  ACT(r:FAC, 'ACCOG')
  ACT(s:FAC, 'Total NGar')
  ACT(t:FAC, 'Total Gar')
  ACT(u:FAC, 'Total Asit.')
  ACT(aa:FAC, 'G.T.Max.')
  ACT(ab:FAC, 'G.Lim.Max.')
  ACT(ac:FAC, 'G.Max.Exe.')
  ACT(ad:FAC, 'G.T.Min.')
  ACT(ae:FAC, 'G.Lim.Min.')
  ACT(af:FAC, 'G.Min.Exe.')
  ACT(ag:FAC, 'G.RPC')
  ACT(ah:FAC, 'G.Lim.RPC')
  ACT(ai:FAC, 'G.RPC.Exe')
  ACT(ak:FAC, 'Act.Comp.')
  ACT(al:FAC, 'Alias7')
  ACT(am:FAC, 'Sector')
  ACT(bm:FAC, 'Persona')
  ACT(an:FAC, '% RPC NGar')
  ACT(ao:FAC, 'Lim.NGar')
  ACT(ap:FAC, 'Exe.NGar')
  ACT(aq:FAC, '% RPC Gar')
  ACT(ar:FAC, 'Lim.Gar')
  ACT(as:FAC, 'Exe.Gar')
  ACT(au:FAC, 'Exe.Con.NF')
  ACT(av:FAC, 'Exe.Con.F')

  IFA
  ACT(j:FAC, Val(b:4))
  ACN(k:FAC, BuscarCampo('CLIENTES','PatrimonioPesos','Codigo',Val(j:FAC)))
  ACN(l:FAC, LimConsumido(Val(b:4),'BCRAN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(m:FAC, LimConsumido(Val(b:4),'ACIDN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(n:FAC, LimConsumido(Val(b:4),'ACCON','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(o:FAC, LimConsumido(Val(b:4),'ACMAN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(p:FAC, LimConsumido(Val(b:4),'BCRAG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(q:FAC, LimConsumido(Val(b:4),'ACIDG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
  ACN(r:FAC, LimConsumido(Val(b:4),'ACCOG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))

  ACN(s:FAC, Val(l:FAC)+Val(m:FAC)+Val(n:FAC)+Val(o:FAC))
  ACN(t:FAC, Val(p:FAC)+Val(q:FAC)+Val(r:FAC))
  ACN(u:FAC, Val(s:FAC)+Val(t:FAC))
 
  **************************************************************** 
  */ Graduacion
  **************************************************************** 
  */Veo si el cliente es bco
  ACT(aaa:FAC, BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(j:FAC)))
  ACT(am:FAC, BuscarCampo('CATEGORIACLIENTES','Sector','Codigo',Val(AAA:FAC)))
  ACT(bm:FAC, BuscarCampo('CLIENTES','Persona','Codigo',Val(j:FAC)))

  if NOT EqStr(Val(am:FAC),'FIN') Y NOT EqStr(Val(bm:FAC),'SI')
     ACN(aa:FAC, Var('BCGRATMAX'))
     ACN(ab:FAC, Val(k:FAC)*Val(aa:FAC)/100)
     if Val(u:FAC)>Val(ab:FAC)
        ACN(ac:FAC, Val(u:FAC)-Val(ab:FAC))
     endif
     ACN(ad:FAC, Var('BCGRATMIN'))
     ACN(ae:FAC, Val(k:FAC)*Val(ad:FAC)/100)
     if Val(u:FAC)>Val(ae:FAC)
        ACN(af:FAC, Val(u:FAC)-Val(ae:FAC))
     endif
     ACN(ag:FAC, Var('BCGRARPC'))
     ACN(ah:FAC, Val(d:2)*Val(ag:FAC)/100)
     if Val(af:FAC)>0
        if Val(af:FAC)>Val(ah:FAC)
           ACN(ai:FAC, Val(af:FAC)-Val(ah:FAC))
        endif
     endif
   endif

  **************************************************************** 
  */ Fraccionamiento
  ****************************************************************
  ACT(ak:FAC, BuscarCampo('CLIENTES','ActComplementarias','Codigo',Val(j:FAC)))
  ACT(al:FAC, BuscarCampo('CLIENTES','Alias7','Codigo',Val(j:FAC)))
  ACT(aab:FAC, BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(j:FAC)))
  ACT(am:FAC, BuscarCampo('CATEGORIACLIENTES','Sector','Codigo',Val(aab:FAC)))
  ACT(bm:FAC, BuscarCampo('CLIENTES','Persona','Codigo',Val(j:FAC)))
  ACT(aak:FAC, BuscarCampo('CLIENTES','Vinculado','Codigo',Val(j:FAC)))

  ACN(an:FAC, iif(EqStr(Val(ak:FAC),'SI'),Var('BCFRANGVAC'),iif(EqStr(Val(aak:FAC),'SI'),Var('BCFRANGVIN'),iif(EqStr(Val(al:FAC),'CIG'),Var('BCFRANGCIG'),iif(EqStr(Val(al:FAC),'CNIG'),Var('BCFRANGNIG'),iif(EqStr(Val(am:FAC),'FIN'),Var('BCFRANGF'),Var('BCFRANGNF')))))))
  ACN(ao:FAC, Val(d:1)*Val(an:FAC)/100)
  if Val(s:FAC)>Val(ao:FAC)
    ACN(ap:FAC, Val(s:FAC)-Val(ao:FAC))
  endif
  ACN(aq:FAC, iif(EqStr(Val(aak:FAC) ,'SI') y EqStr(Val(ak:FAC) ,'SI'),Var('BCFRAGVAC'),iif(EqStr(Val(aak:FAC),'SI'),Var('BCFRAGVIN'),iif(EqStr(Val(al:FAC),'CIG'),Var('BCFRAGCIG'),iif(EqStr(Val(al:FAC),'CNIG'),Var('BCFRAGNIG'),iif(EqStr(Val(am:FAC),'FIN'),Var('BCFRAGF'),Var('BCFRAGNF')))))))
  ACN(ar:FAC, Val(d:1)*Val(aq:FAC)/100)
  if Val(u:FAC)>Val(ar:FAC)
    ACN(as:FAC, Val(u:FAC)-Val(ar:FAC))
  endif


  **************************************************************** 
  */ Concentracion
  **************************************************************** 
  **//LinkearHoja('PMCLCD',1,Fecha1=Dialogo.Fecha1,Cliente1='')
  **//ACN(au:FAC, LinkH(1,ba:1))
  **//ACN(av:FAC, LinkH(1,ba:2))
  **//CerrarHoja('PMCLCD',1,Fecha1=Dialogo.Fecha1,Cliente1='')
  
  **//Para evitar utilizar LinkearHoja, obtenemos los valores con la funcion PMCLCD
  ACD(ar:99, Dialogo.Fecha1)
  ACT(ar:98, '')
  (.'PMCLCD'.)
  ACN(au:FAC, Val(rs:98))
  ACN(av:FAC, Val(rs:99))

  **//MessageBox("Fin funcion PMCLCD")
  **//MessageBox(Fstr(Val(au:FAC),0,9))
  **//MessageBox(Fstr(Val(av:FAC),0,9))

  **************************************************************** 
  */ Grupos Econimicos
  **************************************************************** 
  SQL.ADD("Select GE.Controlante, C.Codigo, GE.TipoGrupo ")
  *-I
  *SQL.ADD("  from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS GE ")
   SQL.ADD("  from "~DBO~".CLIENTES C RIGHT OUTER JOIN  "~DBO~".GRUPOSECONOMICOS GE ON GE.Cliente = C.Codigo ")
  *-F
  SQL.ADD(" where GE.TipoGrupo in ('BCRA','BCHO') ")
  *-I
  *SQL.ADD("   and GE.Cliente =* C.Codigo ")
  *-F
  SQL.ADD("   and C.Codigo = '"~Val(b:4)~"' ")
  SQL.ADD("   and exists(select 1 from "~DBO~".LIMCONSUMIDOS where Limite in ('BCRAN','ACIDN','ACCON','BCRAG','ACIDG','ACCOG','ACMAN') and Cliente=C.Codigo) ")
  SQL.ADD(" order by 1,2 ")
  Recorrer SQL
    DFA
    SCN(az:1,1)
    ACT(ba:Val(az:1), fbn('Controlante'))
    ACT(bb:Val(az:1), fbn('Codigo'))
    ACT(bc:Val(az:1), fbn('TipoGrupo'))
  proximo    
  if Val(az:1)>0
    Recorrer&i 1,Val(az:1)
      if NoVacio(Val(ba:&i))
        SQL.ADD("Select GE.* from "~DBO~".GRUPOSECONOMICOS GE")
        SQL.ADD(" where GE.TipoGrupo in ('BCRA','BCHO') ")
        SQL.ADD("   and GE.Controlante = '"~Val(ba:&i)~"' ")
        SQL.ADD("   and GE.Cliente <> '"~Val(b:4)~"' ")
        SQL.ADD("   and exists(select 1 from "~DBO~".LIMCONSUMIDOS where Limite in ('BCRAN','ACIDN','ACCON','BCRAG','ACIDG','ACCOG','ACMAN') and Cliente=GE.Cliente) ")
        SQL.ADD(" order by GE.Controlante,GE.Cliente ")
        Recorrer SQL
          DFA
          SCN(bz:1,1)
          ACT(ca:Val(bz:1), fbn('Controlante'))
          ACT(cb:Val(bz:1), fbn('Cliente'))
          ACT(cc:Val(bz:1), fbn('TipoGrupo'))
          if Val(az:3)>0
            ACN(az:4,0)
            recorrer&j FAC+1,FAC+Val(az:3)
              if EqStr(Val(j:&j),fbn('Cliente'))
                ACN(az:4,&j-FAC)
                Break
              endif
            proximo
            if Val(az:4)=0
              SCN(az:3,1)
              ACT(j:FAC+Val(az:3), fbn('Cliente'))
              ACN(cd:Val(bz:1), Val(az:3))
            else
              ACN(cd:Val(bz:1), Val(az:4))
            endif
          else
            SCN(az:3,1)
            ACT(j:FAC+Val(az:3), fbn('Cliente'))
            ACN(cd:Val(bz:1), Val(az:3))
          endif
        proximo    
      endif
    proximo
  endif

  if Val(az:3)>0
    recorrer&i FAC+1,FAC+Val(az:3)
      ACN(k:&i, BuscarCampo('CLIENTES','PatrimonioPesos','Codigo',Val(j:&i)))
      ACN(l:&i, LimConsumido(Val(j:&i),'BCRAN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(m:&i, LimConsumido(Val(j:&i),'ACIDN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(n:&i, LimConsumido(Val(j:&i),'ACCON','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(o:&i, LimConsumido(Val(j:&i),'ACMAN','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(p:&i, LimConsumido(Val(j:&i),'BCRAG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(q:&i, LimConsumido(Val(j:&i),'ACIDG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(r:&i, LimConsumido(Val(j:&i),'ACCOG','ARP',0,Val(b:10),,,,Dialogo.Fecha1))
      ACN(s:&i, Val(l:&i)+Val(m:&i)+Val(n:&i)+Val(o:&i))
      ACN(t:&i, Val(p:&i)+Val(q:&i)+Val(r:&i))
      ACN(u:&i, Val(s:&i)+Val(t:&i))
    proximo
    recorrer&i 1,Val(az:1)
      ACN(bd:&i, Val(s:FAC))
      ACN(be:&i, Val(t:FAC))
      recorrer&j 1,Val(bz:1)
        if EqStr(Val(ba:&i),Val(ca:&j))
          SCN(bd:&i, Val(s:FAC+Val(cd:&j)))
          SCN(be:&i, Val(t:FAC+Val(cd:&j)))
        endif
      proximo
      ACN(bf:&i, Val(bd:&i)+Val(be:&i))

      ACN(bg:&i, Val(an:FAC))
      ACN(bh:&i, Val(ao:FAC))
      if Val(bd:&i)>Val(bh:&i)
        ACN(bi:&i, Val(bd:&i)-Val(bh:&i))
      endif
      ACN(bj:&i, Val(aq:FAC))
      ACN(bk:&i, Val(ar:FAC))
      if Val(bf:&i)>Val(bk:&i)
        ACN(bl:&i, Val(bf:&i)-Val(bk:&i))
      endif
    proximo
  endif


  *******************************
 */ REGISTRAR EXCEPCIONES BCRA
  *******************************


  * Tope Maximo Graduacion
  ACT(z1, Dialogo.NrOperacion1)
  ACT(z2, 'GRAMAXEXCE')
  ACT(z3, 'Tope Maximo Graduacion excedido en ARP '~PYC(Val(ac:FAC),1,0)~'.-')
  ACN(z4, Val(ac:FAC))
  (.'AUXCLIMBC'.)

  * Tope Minimo Graduacion
  ACT(z2, 'GRAMINEXCE')
  ACT(z3, 'Tope Minimo Graduacion excedido en ARP '~PYC(Val(af:FAC),1,0)~'.-')
  ACN(z4, Val(af:FAC))
  (.'AUXCLIMBC'.)

  * % RPC Graduacion
  ACT(z2, 'GRARPCEXCE')
  ACT(z3, 'Exceso Tope Minimo Graduacion excede % RPC en ARP '~PYC(Val(ai:FAC),1,0)~'.-')
  ACN(z4, Val(ai:FAC))
  (.'AUXCLIMBC'.)

  * Fraccionamiento NoGar 
  ACT(z2, 'BCRANEXCE')
  ACT(z3, 'Asistencia Crediticia No Garantizada excedida en ARP '~PYC(Val(ap:FAC),1,0)~'.-')
  ACN(z4, Val(ap:FAC))
  (.'AUXCLIMBC'.)

  * Fraccionamiento Gar
  ACT(z2, 'BCRAGEXCE')
  ACT(z3, 'Asistencia Crediticia Garantizada excedida en ARP '~PYC(Val(as:FAC),1,0)~'.-')
  ACN(z4, Val(as:FAC))
  (.'AUXCLIMBC'.)

  * Concentracion No Financiero
  ACT(z2, 'CONNFEXCE')
  ACT(z3, 'Concentracion Clientes No Financieros excedida en ARP '~PYC(Val(au:FAC),1,0)~'.-')
  ACN(z4, Val(au:FAC))
  (.'AUXCLIMBC'.)


  * Concentracion Financiero
  ACT(z2, 'CONFEXCE')
  ACT(z3, 'Concentracion Clientes Financieros excedida en ARP '~PYC(Val(av:FAC),1,0)~'.-')
  ACN(z4, Val(av:FAC))
  (.'AUXCLIMBC'.)

  if Val(az:1)>0
    recorrer&i 1,Val(az:1)
      if NoVacio(Val(ba:&i))
        * Fraccionamiento NoGar Grupo
        ACT(z2, 'BCRANGREX')
        ACT(z3, Val(ba:&i)~' - Asistencia Crediticia No Garantizada Grupo excedida en ARP '~PYC(Val(bi:&i),1,0)~'.-')
        ACN(z4, Val(bi:&i))
        ACT(z7, Val(ba:&i))
        (.'AUXCLIMBC'.)
        * Fraccionamiento Gar Grupo
        ACT(z2, 'BCRAGGREX')
        ACT(z3, Val(ba:&i)~' - Asistencia Crediticia Garantizada Grupo excedida en ARP '~PYC(Val(bl:&i),1,0)~'.-')
        ACN(z4, Val(bl:&i))
        ACT(z7, Val(ba:&i))
        (.'AUXCLIMBC'.)
      endif
    proximo
    BorrarCeldas(z7..z7)
  endif
  if Dialogo.Check1=1
    SQL.EXEC
  endif
endif



if Dialogo.Check1=1
  SQL.EXEC
endif
