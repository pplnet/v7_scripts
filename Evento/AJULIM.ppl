CrearDialogo
  Especie1: 'Especie'     ;1;1;1;  ;  ;Novacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe ingresar un titulo.';NO;;;;;;
  Fecha1:   'Fecha'       ;2;1;1;  ;  ;;;;FSys
  Check1:   'Procesa'     ;4;1;1;NO;NO;;;;1;
  Check2:   'Automatico'  ;5;1;1;NO;NO;;;;0;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

ACT(a:1, 'Especie')
ACT(a:2, 'Fecha')
ACT(a:3, 'Fecha Maduracion')
ACT(a:4, 'Vehiculo')
ACT(a:5, 'Cant.reg')
ACT(a:6, 'A Ajsutar')
ACT(a:7, 'Transaccion')
SetFont(a:1..a:10, 2)

ACT(b:1, Dialogo.Especie1)
ACD(b:2, Dialogo.Fecha1)
ACD(b:3, BuscarCampo('ESPECIES','Fecha','Codigo',Dialogo.Especie1))
ACT(b:4, Var('VEHICULODE'))

if Val(b:3)>Val(b:2)
  if Dialogo.Check2=0 y Dialogo.Check1=1
    * Manual y Procesa
    Cancelar('La fecha de maduracion  de la espeice '~Dialogo.Especie1~' es pasoterior a la fecha ingresada.')
  else
    ** Automatico
    Message('La fecha de maduracion  de la espeice '~Dialogo.Especie1~' es pasoterior a la fecha ingresada.')
    if Dialogo.Check2=1
      Cancelar
    endif
  endif
endif


SetFilaActual(1)
ACT(aa:FAC, 'Cliente')
ACT(ab:FAC, 'Limite')
ACT(ac:FAC, 'Especie')
ACT(ad:FAC, 'Monto')
ACT(ae:FAC, 'Vehiculo')
ACT(af:FAC, 'Operador')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'Responsable')
ACT(ai:FAC, 'TipoPosicion')
ACT(aj:FAC, 'Producto')
ACT(ak:FAC, 'GrupoEspecie')
ACT(al:FAC, 'CarteraBCRA')
ACT(am:FAC, 'Ajusta')
ACT(an:FAC, 'Ajustado')
SetFont(aa:fac..an:fac, 2)

SQL.ADD("SELECT * ")
SQL.ADD(" FROM "~DBO~".LIMCONSUMIDOS ")
SQL.ADD(" WHERE Especie  = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND   Limite   in ('BOOK','COUNTRY','ISSUER') ")
SQL.ADD(" AND   Vehiculo = '"~Val(b:4)~"' ")
recorrer SQL
  SCN(b:5, 1)

  ACT(aa:FAC, fbn('Cliente'))
  ACT(ab:FAC, fbn('Limite'))
  ACT(ac:FAC, fbn('Especie'))
  ACN(ad:FAC, fbn('Monto'))
  ACT(ae:FAC, fbn('Vehiculo'))
  ACT(af:FAC, fbn('Operador'))
  ACT(ag:FAC, fbn('Book'))
  ACT(ah:FAC, fbn('Responsable'))
  ACT(ai:FAC, fbn('TipoPosicion'))
  ACT(aj:FAC, fbn('Producto'))
  ACT(ak:FAC, fbn('GrupoEspecie'))
  ACT(al:FAC, fbn('CarteraBCRA'))
  
  if fbn('Monto')>0
    ACT(am:FAC, 'SI')
    SCN(b:6, 1)
  endif
proximo

if Val(b:6)=0
  * No hay Limites
  if Dialogo.Check2=0 y Dialogo.Check1=1
    * Manual y Procesa
    Cancelar('No existen limites consumidos para la espeice '~Dialogo.Especie1~'.')
  else
    ** Automatico
    Message('No existen limites consumidos para la espeice '~Dialogo.Especie1~'.')
    if Dialogo.Check2=1
      Cancelar
    endif
  endif
endif

if Val(b:6)>0
  if Dialogo.Check1=1
    ACT(b:7, GetNumerador(27))
    SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
    SQL.ADD("   TipoTr2, NrTrans, Cliente1,  Fecha1, Especie, RB1, Vehiculo1, ")
    SQL.ADD("   FechaCarga, FechaCargaSys, UsrInput ")
    SQL.ADD(" ) VALUES ( ")
    * TipoTr2
    SQL.ADD("   'AJULIM', ")
    * Nr Trans
    SQL.ADD("   '"~Val(b:7)~"', ")
    * Cliente
    SQL.ADD("   '"~Val(b:4)~"', ")
    * Fecha
    SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
    * Especie
    SQL.ADD("   '"~Dialogo.Especie1~"', ")
    * RB1 (TipoLim 0=Posicion)
    SQL.ADD("   0, ")
    * Vehiculo1
    SQL.ADD("   '"~Val(b:4)~"' ,")

    SQL.ADD(" "~SQLAhora~","~idxdate2(fsys)~", '"~USUARIOACTIVO~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
    SQL.EXEC    
    
    recorrer&i 2,Val(b:5)+1
      if EqStr(Val(am:&i),'SI')
        ACT(an:&i, 'OK')

        SQL.ADD("INSERT INTO "~DBO~".MOVLIMITES ( ")
        SQL.ADD("   FechaMov,    Cliente,    Limite,       Especie,  Monto, ")
        SQL.ADD("   NrOperacion, Descripcion, Bits,         Vehiculo, Operador, ")
        SQL.ADD("   Book,        Responsable, TipoPOsicion, Producto, GrupoEspecie, ")
        SQL.ADD("   CarteraBCRA ")

        SQL.ADD(" ) VALUES ( ")

        * FechaMov
        SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
        * Cliente
        SQL.ADD("   '"~Val(aa:&i)~"', ")
        * Limite
        SQL.ADD("   '"~Val(ab:&i)~"', ")
        * Especie
        SQL.ADD("   '"~Val(ac:&i)~"', ")
        * Monto
        SQL.ADD("   "~FStr(-Val(ad:&i),1,2)~", ")

        * Nr Operacion
        SQL.ADD("   '"~Val(b:7)~"', ")
        * Descripcion
        SQL.ADD("   'AJULIM "~Val(ac:&i)~"', ")
        * Bits
        SQL.ADD("   'P', ")
        * Vehiculo1
        SQL.ADD("   '"~Val(b:4)~"' ,")
        * Operador
        SQL.ADD("   '"~Val(af:&i)~"', ")

        * Book
        SQL.ADD("   '"~Val(ag:&i)~"', ")
        * Responsable
        SQL.ADD("   '"~Val(ah:&i)~"', ")
        * TipoPosicion
        SQL.ADD("   '"~Val(ai:&i)~"', ")
        * Producto
        SQL.ADD("   '"~Val(aj:&i)~"', ")
        * GrupoEspecie
        SQL.ADD("   '"~Val(ak:&i)~"', ")
        
        * CarteraBCRA
        SQL.ADD("   '"~Val(al:&i)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC    
      endif
    proximo
  endif
endif

ACO(1,15)
