* Este evento es invocado desde el Cierre y genera el cashflow segun LIQOCT y FALLAS ****
*HojaVisible(SI)
CrearDialogo
  Vehiculo1: 'Vehiculo'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   : 'Fecha Cierre';;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
FinDialogo
if Not Ok
  Cancelar
endif


************************************************
* Selecciona Fallas y Liqoct del dia ****
************************************************
SetFilaActual(0)
SQL.ADD("Select T.NrTrans ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and T.TipoTr2  In ('LIQOCT','TRANSP') ")
SQL.ADD("   and T.Fecha1    = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("Order By NrTrans")

Recorrer SQL
  *** genera el cashflow ****
  ModificarOperacion(fbn('NrTrans'),0,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,NO,NO,1)
proximo

