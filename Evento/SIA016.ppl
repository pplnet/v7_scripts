     'Codigo'              ; a1..a:fac; NO; SI;;70; STRING
     'Cliente'               ; b1..b:fac; NO; SI;;70; STRING
     'Comitente'              ; c1..c:fac; NO; SI;;70; STRING
     'Alias7'             ; d1..d:fac; NO; SI;;80; STRING
     'Nombre'              ; e1..e:fac; NO; SI;;90; STRING
   FinListBox

   If Ok 
