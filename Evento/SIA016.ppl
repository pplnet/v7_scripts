ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

********************************************************************
* Cambio de ID Cuentas (Alias5 y Alias7) - Conversion PDC
* Fecha..............: 21/Jun/2005
* Ultima modificacisn: 
* Autor..............: Silvia
********************************************************************

HojaVisible(NO)

CrearDialogo
   String1     : 'ID Actual'         ;;;;;;;;;;;;;;;;
   String2     : 'ID Nuevo'         ;;;;;;;;;;;;;;;;
FinDialogo


If Not OK
   Cancelar
endif

*-- Select ALIAS5
  SQL.ADD(" Select /*+ RULE */ a.*    " )
  SQL.ADD("   from   "~DBO~".cuentas a  " )
  SQL.ADD("   where a.alias5 ='"~Dialogo.String1~"'  ")

*-- Busco Transaccion
  If NoVacio(UsrVehiculos(UsuarioActivo))
     SQL.ADD("  AND A.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  endif

*  SQL.ADD("      order by a.CODIGO ")
*-- 

Recorrer SQL
   Message(' CUenta '~FBN['Alias5']~'  ...')

       ACT(a:fac,FBN['Codigo'])
       ACT(b:fac,FBN['Cliente'])
       ACT(c:fac,FBN['Comitente'])
       ACT(d:fac,FBN['Alias5'])
       ACT(e:fac,FBN['Nombre'])
       ACN(z:fac, 0 )

Proximo

If fac>0

   CrearListBox;'Arial,10,B'
     'Cambia'              ; z1..k:fac; SI; SI;;70; COMBO; 'Si|No|'
     'Codigo'              ; a1..a:fac; NO; SI;;70; STRING
     'Cliente'               ; b1..b:fac; NO; SI;;70; STRING
     'Comitente'              ; c1..c:fac; NO; SI;;70; STRING
     'Alias5'             ; d1..d:fac; NO; SI;;80; STRING
     'Nombre'              ; e1..e:fac; NO; SI;;90; STRING
   FinListBox

   If Ok 
      Recorrer&i 1,fac
       If Val(z:&i)=0
        SQL.ADD(" Update /*+ RULE */ "~DBO~".cuentas ")
        SQL.ADD(" Set Alias5 = '"~Dialogo.String2~"' ")
        SQL.ADD("   where alias5 ='"~Dialogo.String1~"'  ")
        SQL.NEW
        SQL.EXEC
         Message('Actualizado Alias5: '~val(a:&i))
      endif
      Proximo
   else
      Cancelar
   Endif
Else
   MessageBox('No existen transacciones para la seleccion')

EndIf

