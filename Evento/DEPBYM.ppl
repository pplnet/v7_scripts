*************************************************************
* Elimina los registros de las tablas con una fecha anterior
* segun la cantidad de dias ingresados 
*************************************************************

CrearDialogo
    Plazo1:    "Cantidad de Dias"       ;1;1;;;;Dialogo.Plazo1 > 9;'Cantidad de dias debe ser mayor a 9';NO;;30;;
    Fecha1:    "Fecha a Eliminar"       ;1;2;;NO;;;;;;FECHA(SQL("SELECT CAST(GETDATE() AS DATE)"))-Plazo1;;
    Plazo2:    "Cant. Dias MarketData"  ;2;1;;;;Dialogo.Plazo2 > 9;'Cantidad de dias debe ser mayor a 9';NO;;10;;
    Fecha2:    "Fecha MarketData"       ;2;2;;NO;;;;;;FECHA(SQL("SELECT CAST(GETDATE() AS DATE)"))-Plazo2;;
FinDialogo

If not Ok
  Cancelar
Endif

If(MessageBox("Si continua, se eliminaran registros con fecha anterior a "~Dialogo.Fecha1~" y registros de la tabla IMEMARKETDATA con fecha anterior a "~Dialogo.Fecha2,2,1) = 1)
    SQL.ADD("EXEC "~DBO~".DepurarTablasFPA_BYMA "~Dialogo.Plazo1~","~Dialogo.Plazo2)
    SQL.NEW
    SQL.EXEC
    MessageBoX("-- Depuracion de Tablas Completada --")
Else
    MessageBox("-- Depuracion de Tablas Cancelada --")
EndIf