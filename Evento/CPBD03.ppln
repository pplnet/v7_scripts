Sqladd(" C.Comitente, C.Codigo CuentaFPA, E.Codigo MonedaFPA, C.Comitente BancoFPA, ")
Sqladd(" V.Codigo VehiculoFPA, M.Banco, M.Moneda, M.Comprobante, M.Cuenta, ")
