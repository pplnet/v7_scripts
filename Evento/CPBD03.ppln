Sqladd(" SELECT /*+ RULE */ M.*, C.Comitente, C.Codigo CuentaFPA, E.Codigo MonedaFPA, C.Comitente BancoFPA, V.Codigo VehiculoFPA ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".CUENTAS C, "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V, ")
Sqladd(" "~Dbo()~".DATANET D, "~Dbo()~".CLIENTES B, "~Dbo()~".CODIGOSDATANET CD ")
Sqladd(" WHERE M.Cuenta      = C.Numero  ")
Sqladd(" AND   M.NrDatanet   = D.NrDatanet ")
Sqladd(" AND   M.Moneda      = E.Alias3  ")
Sqladd(" AND   C.Comitente   = B.Codigo  ")
Sqladd(" AND   (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
Sqladd(" AND   M.Vehiculo    = V.Codigo  ")
Sqladd(" AND   M.TipoMov     = CD.Codigo (+) ")
Sqladd(" AND   V.Codigo      = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND   E.Codigo      = '"~dialogo.especie1~"'  ")
Sqladd(" AND    D.Archivo      IN ("~Pipe2Comillas(Val(ll:1))~")  ")
Sqladd(" AND   CD.Tipo       IN ("~Pipe2Comillas(Var('CPBD020'))~")  ")
Sqladd(" AND   M.NrMovDatanet NOT IN (SELECT MNrMovDatanet FROM "~Dbo()~".EXTRACTOS WHERE MNrDatanet=M.NrDatanet ) ")
if (NoVacio(dialogo.cuenta1))
Sqladd(" AND C.Codigo  = '"~dialogo.cuenta1~"' ")
endif
Sqladd(" AND M.FechaAcreditacion = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" ORDER BY M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion, M.Cuenta ")

