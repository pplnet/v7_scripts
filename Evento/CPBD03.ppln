Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".CUENTAS C, "~Dbo()~".ESPECIES E, ")
Sqladd(" "~Dbo()~".VEHICULOS V, "~Dbo()~".DATANET D, "~Dbo()~".CLIENTES B, "~Dbo()~".CODIGOSDATANET CD ")
