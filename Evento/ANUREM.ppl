CrearDialogo
    NrOperacion1: '# Operacion' ;;;;;;NoVacio(Dialogo.NrOperacion1) Y SQL("SELECT 1 FROM "~DBO~".OPERACIONES O INNER JOIN "~dbo~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion and OB.Valor = 1 WHERE TipoOp = 'MMCREM' and O.NrOperacion = '"~Dialogo.NrOperacion1~"' and OB.NrBit IN ("~VAR('INSTCREM')~") and O.Sector1 = '"~Dialogo.String1~"'") = 1;'Operación Inválida!';NO;;;;;;"SELECT O.NrOperacion, O.Especie, O.TipoOp, O.Cliente1, O.FechaOp FROM "~DBO~".OPERACIONES O INNER JOIN "~dbo~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion and OB.Valor = 1 WHERE TipoOp = 'MMCREM' and OB.NrBit IN ("~VAR('INSTCREM')~") and O.Sector1 = '"~Dialogo.String1~"'"
    String1: 'Sector';;;;NO;;NoVacio(Dialogo.String1);"El usuario debe tener un sector";NO;SQL("select sector from USRVEHICULO where Codigo = '"~USUARIOACTIVO~"'");;;;;
FinDialogo

if not ok
    Cancelar("Evento Cancelado.")
Endif

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '0' ")
SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') and (NrBit <> '30' ) ")
SQL.NEW

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '1' ")
SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') and (NrBit = '30' ) ")
SQL.NEW
SQL.EXEC

if MessageBox("Operación eliminada con éxito. Desea actualizar otra Operación?", 3, 1) = 2
    Cancelar
endif

