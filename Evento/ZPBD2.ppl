ACN(z:1, 0)
Recorrer SQL
  SCN(z:1, 1)
  ACN(aa:fac, 0)
  ACN(ab:fac, 0)
  ACT(ac:fac, fbn('Vehiculo1') )
  ACT(ad:fac, fbn('NrTrans') )
  ACD(ae:fac, fbn('Fecha1') )
  ACD(af:fac, fbn('Fecha1') )
  ACT(ag:fac, fbn('Cliente1') )
  ACT(ah:fac, fbn('Especie') )
  ACT(ai:fac, fbn('Cantidad1') )
  ACT(aj:fac, fbn('Cuenta1') )
  ACT(ak:fac, fbn('Cuenta2') )
  ACT(al:fac, fbn('Banco1') )
  ACT(am:fac, fbn('Banco2') )
  ACT(an:fac, fbn('Numero1') )
  ACT(ao:fac, fbn('Numero2') )
  ACT(ap:fac, fbn('CB3') )
  ACT(aq:fac, fbn('Tipo1') )
  ACT(ar:fac, fbn('Tipo2') )
  ACT(as:fac, fbn('FechaMov') )
  ACT(at:fac, fbn('Tipo') )
  ACT(au:fac, fbn('DC') )
  ACT(av:fac, fbn('CliDatanet') )
  IF Longitud(fbn('CtaDat')) = 5
      ACT(FC:fac, Copy(fbn('CtaDat'), 4, 2))
  ELSE
      ACT(FC:fac, 'Error')
  ENDIF
  ACT(BU:fac, fbn('CBU'))
  IF Longitud(Val(BU:fac)) <> 22
      ACT(BU:fac, 'Error')
  ENDIF
  ***---Obtengo CUIT de la Contraparte
  ACT(CU:fac, ReemplazarSTR(BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Cliente1')), '-', '',SI))
  IF Longitud(Val(CU:fac)) <> 11
      ACT(CU:fac, 'Error')
  ENDIF
Proximo

If Val(z:1)=0
  Message('No se encontraron Movimientos de FPA para conciliar.')
  Cancelar
Endif

CrearListBox; 'Arial,8,'
  'Informa'            ;aa:1..aa:fac;SI;;;50;CHECK;RGB(232,255,215); 
  'Avanza'             ;ab:1..ab:fac;SI;;;50;CHECK;RGB(232,255,215); 
  'Vehiculo'           ;ac:1..ac:fac;NO;;;80;STRING;;RGB(232,232,232);
  'Nro. Trans.'        ;ad:1..ad:fac;NO;;;70;STRING;;RGB(232,232,232);
  'Fecha Liquidacion'  ;ae:1..ae:fac;NO;;;80;FECHA;RGB(232,232,232);
  'Fecha de Carga'     ;af:1..af:fac;NO;;;95;FECHA;RGB(232,232,232);
  'Contraparte'        ;ag:1..ag:fac;NO;;;70;STRING;;RGB(232,232,232);
  'Moneda'             ;ah:1..ah:fac;NO;;;80;STRING;;RGB(232,232,232);
  'Cantidad'           ;ai:1..ai:fac;NO;;;70;STRING;;RGB(232,232,232);
  'De Cuenta'          ;aj:1..aj:fac;NO;;;70;STRING;;RGB(232,232,232);
  'A Cuenta'           ;ak:1..ak:fac;NO;;;70;STRING;;RGB(232,232,232);
FinListBox

ACN(z:1,4)
ACT(a:1, "Errores Encontrados y Liquidaciones Procesadas")
ACT(a:3, "Vehiculo")
ACT(b:3, "Nro. Trans.")
ACT(c:3, "Fecha Liquidacion")
ACT(d:3, "Fecha de Carga")
ACT(e:3, "Contraparte")
ACT(f:3, "Moneda")
ACT(g:3, "Cantidad")
ACT(h:3, "De Cuenta")
ACT(i:3, "A Cuenta")
ACT(j:3, "Error")
ACT(ba:4, GetNumerador(8))
ACN(x:2,0)
ACT(ax:1, Dialogo.String~val(ba:4)~'-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
ACT(ay:1, "")
If Ok
  Recorrer&i 1,fac
  if Eqstr(val(ay:1), val(al:&i))
    *Es el mismo banco
    AbrirAscii(val(ax:1),0)
    if val(aa:&i) = 1 y val(ab:&i) = 0
      * El primer check esta tildado
      If val(x:2) = 0
        (.'ZPBD2B'.)
      EndIf
      ACN(x:2,1)
      (.'ZPBD2A'.)
    Else
      if val(ab:&i) = 1 y val(aa:&i) = 0
        (.'ZPBD2C'.)
        ACN(x:2,0)
      EndIf
    EndIF
    CerrarAscii
    ACT(ay:1, val(al:&i))
  else
    *Es un banco distinto
    ACT(ax:1, Dialogo.String~val(ba:4)~'-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACN(x:2,0)
    AbrirAscii(val(ax:1),0)
    if val(aa:&i) = 1 y val(ab:&i) = 0
      * El primer check esta tildado
      (.'ZPBD2B'.)
      (.'ZPBD2A'.)
      ACN(x:2,1)
    Else
      if val(ab:&i) = 1 y val(aa:&i) = 0
        (.'ZPBD2C'.)
        ACN(x:2,0)
      EndIf
    EndIF
    ACT(ay:1, val(al:&i))
  endif


  Proximo
  CerrarAscii
  ACT(z:3, Dialogo.String~val(ba:4)~'-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  ExportarXLS(a:1..j:val(z:1), a:1..j:val(z:1), val(z:3))
Else
  Cancelar('Evento Cancelado.')
Endif