MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha Desde';1;1;;;;;;;FSys()
cuenta1: 'Cuenta';;;;;;NoVacio(dialogo.cuenta1);'Debe ingresar una cuenta';NO;
findialogo

if (not ok)
Cancelar()
endif

let(&fechalimite, FinDeMes(dialogo.fecha1, NO))

recorrer&i dialogo.fecha1, &fechalimite
Message('Anulando Calculo Remuneradas '~Fecha(&i)~' - Cuenta '~dialogo.cuenta1)
Act(op:1, '')
let(&nroperacionmmrpac, '')
let(&fechacuotas, '')
Sqladd("SELECT NrOperacion, TotalIntereses, OperacionRef, FechaOp FROM "~Dbo()~".OPERACIONES")
Sqladd("WHERE TipoOp = 'MMCCR' ")
Sqladd("AND CB1 = '1' ")
Sqladd("AND FechaOp = '"~IdxDate(&i)~"' ")
Sqladd("AND Cuenta1 = '"~dialogo.cuenta1~"' ")
recorrer sql
Act(op:1, Val(op:1)~Fbn()['NrOperacion']~'|')
let(&totalinteresesanulados, Fbn()['TotalIntereses'])
let(&nroperacionmmrpac, Fbn()['OperacionRef'])
let(&fechacuotas, Fbn()['FechaOp'])

if (Query("SELECT COUNT(*) FROM MOVEJECUTADOS WHERE NrOperacion = '"~&nroperacionmmrpac~"' AND NrSaldo = 1") > 0)
Cancelar('No se puede ejecutar la Anulacion porque la Operacion: '~&nroperacionmmrpac~' ya fue liquidada. Anule la liquidacion antes de seguir')
endif
Sqladd(" UPDATE "~Dbo()~".OPERACIONES")
Sqladd(" SET TotalIntereses = TotalIntereses-"~FStr(&totalinteresesanulados, 0, 2)~", ")
Sqladd("       TotalNetoCli1 = 0 ")
Sqladd("WHERE NrOperacion = '"~&nroperacionmmrpac~"'")
Sqlnew()
Sqlexec()

Sqladd("DELETE FROM "~Dbo()~".CUOTAS")
Sqladd("WHERE NrOperacion = '"~&nroperacionmmrpac~"' AND Fecha1 = '"~IdxDate(&fechacuotas)~"'")
Sqlnew()
Sqlexec()

proximo

Sqladd(" UPDATE "~Dbo()~".SALDOSBANCARIOS")
Sqladd(" SET Estado = 'REC'")
Sqladd(" Where FechaSaldo = '"~IdxDate(Fecha(&i))~"' ")
Sqladd(" AND NrCuenta = '"~BuscarCampo('CUENTAS', 'Numero', 'Codigo', dialogo.cuenta1)~"' ")
Sqladd(" AND Estado = 'PRO'     ")
Sqlnew()
Sqlexec()

Sqladd("DELETE FROM "~Dbo()~".OPERACIONES")
Sqladd("WHERE NrOperacion in ("~Pipe2Comillas(Val(op:1))~")")
Sqlnew()
Sqlexec()
proximo

