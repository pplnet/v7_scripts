MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 <= FSys();'Fecha inválida';NO;FSys()
vehiculo1: 'Vehiculo';3;;;;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE')
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select O.NrOperacion, M.Monto, O.Vehiculo1, O.Cliente1 ClienteOp, M.Cliente ClienteDev, M.Especie Moneda ")
Sqladd("  ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C, "~Dbo()~".MOVDEVENGADOS M ")
Sqladd(" Where O.NrOperacion = C.NrOperacion ")
Sqladd(" AND O.NrOperacion = M.NrOperacion ")
Sqladd(" AND TipoOp = 'MMST' ")
Sqladd(" AND C.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND C.Fecha2 >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND M.Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.MB1 > 0 ")
Sqladd(" Order By O.NrOperacion ")
Watch(Sqlbatch())
recorrer sql
if (not Eqstr(Fbn('NrOperacion'), Val(nr:1)))
if (not celdavacia(nr:1))
Sqladd(" Delete "~Dbo()~".MTMDIARIO ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()
Acn(ac:1, 0)
Sqladd(" Select MTMAcuMensual From "~Dbo()~".MTMDIARIO ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Month(Fecha) = "~FStr(Mes(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Year(Fecha) = "~FStr(Anio(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Fecha = (Select Max(Fecha) ")
Sqladd("               From "~Dbo()~".MTMDIARIO ")
Sqladd("               Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd("               AND Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Acn(ac:1, Fbn('MTMAcuMensual'))
proximo
if (Val(ac:1) <> 0)
Sqladd(" Update "~Dbo()~".MTMDIARIO ")
Sqladd(" Set Ultimo = 'NO' ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Month(Fecha) = "~FStr(Mes(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Year(Fecha) = "~FStr(Anio(dialogo.fecha1), 0, 0)~" ")
Sqlnew()
Sqlexec()
endif
Sqladd(" Insert Into "~Dbo()~".MTMDIARIO ")
Sqladd(" (NrOperacion, Fecha, PrecioHoy, PrecioAyer, ")
Sqladd(" MTM, TipoMTM, Especie1, FechaCargaSys, ")
Sqladd(" MTMAcuMensual, Ultimo) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nr:1)~"', '"~IdxDate(dialogo.fecha1)~"', "~FStr(Val(it:1), 0, 2)~", "~FStr(Val(it:2), 0, 2)~", ")
Sqladd(" "~FStr(Val(mt:1), 0, 2)~", 'MTM', '"~Val(mn:1)~"', '"~IdxDate(FSys())~"',")
Sqladd(" "~FStr(Val(ac:1) + Val(mt:1), 0, 2)~", 'SI') ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientos3(Val(nr:1), SI, NO, NO, NO, NO)
Sqlexec()
endif
Acn(mt:1, 0)
Acn(it:1, 0)
Acn(it:2, 0)
endif
if (Eqstr(Fbn('ClienteOp'), Fbn('ClienteDev')))
Acn(it:1, Fbn('Monto'))
else
Acn(it:2, Fbn('Monto'))
endif
Scn(mt:1, Fbn('Monto'))
Act(nr:1, Fbn('NrOperacion'))
Act(mn:1, Fbn('Moneda'))
proximo
if (not celdavacia(nr:1))
Sqladd(" Delete "~Dbo()~".MTMDIARIO ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()
Acn(ac:1, 0)
Sqladd(" Select MTMAcuMensual From "~Dbo()~".MTMDIARIO ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Month(Fecha) = "~FStr(Mes(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Year(Fecha) = "~FStr(Anio(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Fecha = (Select Max(Fecha) ")
Sqladd("               From "~Dbo()~".MTMDIARIO ")
Sqladd("               Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd("               AND Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Acn(ac:1, Fbn('MTMAcuMensual'))
proximo
if (Val(ac:1) <> 0)
Sqladd(" Update "~Dbo()~".MTMDIARIO ")
Sqladd(" Set Ultimo = 'NO' ")
Sqladd(" Where NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND Month(Fecha) = "~FStr(Mes(dialogo.fecha1), 0, 0)~" ")
Sqladd(" AND Year(Fecha) = "~FStr(Anio(dialogo.fecha1), 0, 0)~" ")
Sqlnew()
Sqlexec()
endif
Sqladd(" Insert Into "~Dbo()~".MTMDIARIO ")
Sqladd(" (NrOperacion, Fecha, PrecioHoy, PrecioAyer, ")
Sqladd(" MTM, TipoMTM, Especie1, FechaCargaSys, ")
Sqladd(" MTMAcuMensual, Ultimo) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nr:1)~"', '"~IdxDate(dialogo.fecha1)~"', "~FStr(Val(it:1), 0, 2)~", "~FStr(Val(it:2), 0, 2)~", ")
Sqladd(" "~FStr(Val(mt:1), 0, 2)~", 'MTM', '"~Val(mn:1)~"', '"~IdxDate(FSys())~"', ")
Sqladd(" "~FStr(Val(ac:1) + Val(mt:1), 0, 2)~", 'SI') ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientos3(Val(nr:1), SI, NO, NO, NO, NO)
Sqlexec()
endif
