creardialogo
fecha1:'F. Desde';;;;;;;;;FSys() - 4
fecha2:'F. Hasta';;;;;;;;;FSys()
cliente1:'Cliente';;;;;;;;;Var('VEHICULODE')
vehiculo1:'Vehiculo';;;;;;;;;Var('VEHICULODE')
especie1:'Especie';;;;;;NoVacio(dialogo.especie1);'Especie Vacia';NO;
findialogo

if (not ok)
Cancelar()
endif



Message('----- Recalculando Posiciones para '~dialogo.especie1)

sql.add("EXEC "~Dbo()~".RegeneraPosiciones '"~IdxDate(dialogo.fecha1)~"','"~IdxDate(dialogo.fecha2)~"','"~dialogo.cliente1~"','"~dialogo.vehiculo1~"','"~dialogo.especie1~"' ")
sql.new
sql.exec

Messagebox('-- Recalculo de Posiciones Terminado --')

