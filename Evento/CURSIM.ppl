* CURSIM - Creacion de CURVASIM.WKS
HojaVisible(No)
CrearDialogo
   Especie1 : 'Especie'       ;;;;;;;;;'WTI';;;;;; 
   String1  : 'Path'          ;;;;;;;;;VAR('DIRDEFAULT')
   String2  : 'Arch. Texto'   ;;;;NO;;;;;;'CURVASIM.WKS';
FinDialogo

If Not Ok
   Cancelar
EndIf

SetFilaActual(0)

SQL.ADD("SELECT Fecha,PrecioFut,PrecioCon FROM "~DBO~".CURVAFUTUROSCOMM ")
SQL.ADD("Where Especie='"~Dialogo.Especie1~"' Order By 1 ")

Recorrer SQL
   acd(a:fac,FBN['Fecha'])
   acn(b:fac,FBN['PrecioFut'])
   acn(c:fac,FBN['PrecioCon'])
Proximo

Message('*-- Creacion Inicial de la Curva de Futuros')
ExportarWKS(a1..c:fac,a1..c:fac,Dialogo.String1~Dialogo.String2)

MessageBox('Exportacion Finalizada !!!')
