sql.add(" SELECT /*+ RULE */ C.NrOperacion, T.TipoTr2, T.CNFormaPago, FP.Tipo, M.Cuenta, T.Cliente2,   ")
sql.add(" M.Cantidad, C.Fecha, T.NrTrans, T.Fecha1, M.FechaMov, M.Especie, T.Cantidad2,    ")
sql.add(" T.Vehiculo1, T2.NrTrans NrTransV, T2.TipoTr2 TipoTr2V, T2.Cliente1 ClienteV,     ")
sql.add(" T2.Fecha2 Fecha2V, T2.Especie EspecieV, T2.Cantidad1 Cantidad1V, M2.NrMov NrMov2 ")
sql.add(" FROM "~Dbo()~".CONCILIACIONES C, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CNFORMASPAGOCOBRO FP, ")
sql.add(" "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T2, "~Dbo()~".MOVEJECUTADOS M2  ")
sql.add(" WHERE C.NrOperacion = T.NrTrans      ")
sql.add(" AND   T.NrTrans     = M.NrOperacion  ")
sql.add(" AND   T.NrTrans     = T2.NrTransRef1 ")
sql.add(" AND   T2.NrTrans    = M2.NrOperacion  ")
sql.add(" AND   C.Fecha       >= "~IdxDate2(dialogo.fecha1)~" ")
sql.add(" AND   C.Fecha       <= "~IdxDate2(dialogo.fecha2)~" ")
sql.add(" AND   M2.NrSaldo    = 99 ")
sql.add(" AND   T.CNFormaPago = FP.Codigo ")
sql.add(" AND   T.TipoTr2     = 'DEVM' ")
sql.add(" AND   FP.Tipo       = 'CHE' ")
if (NoVacio(dialogo.lista2))
sql.add(" AND T.Cliente2 IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND M.Cuenta IN ("~pipe2comillas(dialogo.lista3)~")  ")
endif
if (NoVacio(dialogo.lista1))
sql.add(" AND T.Vehiculo1  IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND T.Vehiculo1 IN ("~pipe2comillas(Val(vh:1))~") ")
endif
endif
sql.add(" ORDER BY T.Vehiculo1, T.Cliente2, M.Cuenta, M.FechaMov, T.Cantidad2 ")

Acn(z:1, 0)
Acn(tc:1, 0)

recorrer sql
Acn(z:1, 1)
