*Simulador de cierre de cuentas remuneradas
HojaVisible(Si)
CrearDialogo
    Fecha1      : 'Fecha'               ;;;;NO;;Dialogo.Fecha1>0 Y Dialogo.Fecha1<=fsys;'Fecha Inválida';NO;Fsys;    
    Check1      :  'Reporte'            ;;;;NO;NO;;;;1;
FinDialogo

If Not OK
  Cancelar
Endif


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AgregarBMP(a1,Exe('LOGO'))
SetFilaActual(FAC+5)
ACN(w1,FAC)

if Dialogo.check1 = 1
   ACT(a:fac,'Operaciones en instancias intermedias')
else
   ACT(a:fac,'Simulacion de cierre de las operaciones en instancias intermedias')
endif
SetFont(a:FAC..a:FAC,3)
ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
SetFont(a:FAC..a:FAC,2)
SetFilaActual(FAC+3)
(.'CIERREM'.)

ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC..a:FAC,2)
LimitesVision(g:fac)

ACO(1,10)
ACO(2,10)
ACO(3,12)
ACO(4,6)
ACO(5,9)
ACO(6,13)
ACO(7,20)
