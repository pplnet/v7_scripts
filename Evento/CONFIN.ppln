Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha1, T.Fecha2, T.Especie, T.Cliente1, T.Cliente3, ")
Sqladd("       T.Cliente4, T.ComitenteExt, T.Cantidad1, T.Cantidad2, T.Cambio1,T.CB6,T.NrOperacionRef1 ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T ")
Sqladd("WHERE T.RB1 = 2 AND ")
Sqladd("      T.CB1 = 1 AND ")
Sqladd("      T.TipoTr2 IN ('DTP','RTP') AND ")
Sqladd("      T.NrTrans IN (SELECT DISTINCT M.NrOperacion ")
Sqladd("                    FROM "~Dbo()~".MOVPENDIENTES M ")
Sqladd("                    WHERE M.NrSaldo = "~FStr(Val(a1), 0, 0)~" AND ")
Sqladd("                          M.NrOperacion = T.NrTrans) ")
Sqladd("ORDER BY T.NrTrans ")

Acn(de1, 1)
Acn(ha1, 0)
SetFilaActual(Val(de1) - 1)

recorrer sql

Scn(ha1, 1)
