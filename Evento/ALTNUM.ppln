creardialogo
entero1:'Codigo';;;;;;sql("Select count(*) from "~Dbo()~".NUMERADORES where Codigo="~FStr(dialogo.entero1, 0, 0)~" ") = 0 y dialogo.entero1 > 0;'Numerador Repetido o Codigo Invalido';NO;
string1:'Tipo';;;;;;not Vacio(dialogo.string1);'Ingrese un Tipo de Numerador de dos caracteres en Mayusculas';NO;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (not Eqstr(Pad(Copy(dialogo.string1, 1, 2), 2), dialogo.string1))
Cancelar()('El tipo de Numerador debe contener dos caracteres!!!')
endif

if (not Eqstr(Mayusculas2(dialogo.string1), dialogo.string1))
Cancelar()('Ingrese el Tipo de Numerador en Mayusculas !!!')
endif

Acn(a1, 0)
Acn(a1, sql("Select Codigo from "~Dbo()~".NUMERADORES where Tipo='"~Copy(dialogo.string1, 1, 2)~"' "))

if (Val(a1) = 0)
Act(a2, Copy(dialogo.string1, 1, 2))

sql.add("Insert Into "~Dbo()~".NUMERADORES (Codigo, Tipo, Numero) Values ")
sql.add(" ("~FStr(dialogo.entero1, 0, 0)~", '"~Val(a2)~"',0) ")
sql.new
sql.exec
else
Messagebox('El tipo de Numerador ya fue asignado al Numerador '~FStr(Val(a1), 0, 0))
endif


