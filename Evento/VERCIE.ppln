HojaVisible(SI)
sql.add("Select * from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B where")
sql.add("NrSaldo = 1 ")
sql.add("and M.FechaMov = '"~IdxDate(FSys())~"' ")
sql.add("and M.NrOperacion = B.NrOperacion ")
sql.add("and M.Bits = 'MV'")
sql.add("and B.Valor = '1' ")
sql.add("order by M.NrOperacion")

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

Acn(x1, 0)

Act(a1, ' Operaciones Pendientes de Liquidacion al '~IdxDate(FSys()))

Act(a4, 'NrOperacion')
Act(b4, 'FechaMov')
Act(c4, 'Cliente')
Act(d4, 'Especie')
Act(e4, 'Monto ')
Act(f4, 'Vehiculo')
Act(g4, 'Leyenda')
Act(h4, 'Instancia')
Act(i4, 'TipoOp')
Act(j4, 'Cupon')

AgregarMarco(a4..j4, 1, 0, exe('COLOR'))
SetFont(a1..s4, 1)
SetFilaActual(4)

recorrer sql

Message(' Operacion Nro. '~Fbn()['NrOperacion'])

Act(a:fac, Fbn()['NrOperacion'])
Acd(b:fac, Fbn()['FechaMov'])
Act(c:fac, Fbn()['Cliente'])
Act(d:fac, Fbn()['Especie'])
Acn(e:fac, -Fbn()['Cantidad'])
Act(f:fac, Fbn()['EnteCustodia'])
Act(g:fac, Fbn()['Leyenda'])
Act(h:fac, sql("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Fbn()['NrBit'], 0, 0)~" AND Tabla='OPERACIONES'"))
Act(i:fac, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Fbn('NrOperacion')))
Act(j:fac, Fbn()['Cupon'])

Scn(x1, 1)
SetFont(a:fac..j:fac, 2)
proximo

ACO(7, 12)
ACO(8, 25)

if (Val(x1) > 0)
Acn(x2, Messagebox('Existen Operaciones Pendientes de Liquidacion ..., El Cierre Sera Cancelado', 1, 1))
if (Val(x2) = 1)
cancelarcierredia('Cierre Cancelado !!!')
endif
endif


