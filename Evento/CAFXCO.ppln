creardialogo
nroperacion1: 'Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Operacion Invalida';NO;;;;;;" TipoOp = 'FXCS' "
string1:'Path';;;;;;;;;Var('PATHCARTA');;;;;;;;;;;;;;;;;
string2:'File';;;;;;;;;Var('FILECARTA');;;;;;;;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" SELECT Cliente1, Cliente2, Precio1, ConceptoBCRA, TotalBrutoCli1, FechaOp, Plazo, Cantidad ")
Sqladd(" FROM "~Dbo()~".OPERACIONES WHERE NrOperacion='"~dialogo.nroperacion1~"'")
recorrer sql
Acd(z1, Fbn()['FechaOp'])

Act(a1, FStr(Dia(Val(z1)), 0, 0)~' de '~Meses(Mes(Val(z1)))~' de '~FStr(Anio(Val(z1)), 0, 0))

Act(b1, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1']))

Acd(c1, Fecha(Fbn()['FechaOp']))

Act(d1, PYC(Fbn()['Cantidad'], 1, 2))

Act(e1, Letras(Fbn()['Cantidad']))

Act(f1, FStr(Fbn()['Precio1'], 0, 9))

Act(g1, Fbn('ConceptoBCRA'))

Act(h1, BuscarCampo('CONCEPTOSBCRA', 'Descripcion', 'Codigo', Fbn('ConceptoBCRA')))

Act(i1, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente2']))

Act(j1, FStr(Fbn()['Plazo']))

Act(k1, Mayusculas(BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1'])))

Act(l1, PYC(Fbn()['TotalBrutoCli1'], 1, 2))
break
proximo

emitircarta(dialogo.string1~dialogo.string2, dialogo.string1~'carta.docx', fecha_larga = Val(a1), razon_social = Val(b1), nroperacion = dialogo.nroperacion1, fecha_corta = Val(c1), cantidad = Val(d1), cantidad_textual = Val(e1), tipo_de_cambio = Val(f1), codigo = Val(g1), concepto = Val(h1), razon_social_tomado = Val(i1), plazo = Val(j1), razon_social_up = Val(k1), importe = Val(l1))

Messagebox('La carta fue generada correctamente.')




