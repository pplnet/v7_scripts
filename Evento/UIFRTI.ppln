creardialogo
label1:'';1;1;;;;;;;;'Ingrese Periodo a Generar';;;
entero1:'Año';;1;;;;dialogo.entero1 >= 2004 y dialogo.entero1 <= 2050;'Debe Ingresar un anio valido';NO;Anio(FSys());;;;'####'
entero2:'Mes';;1;;;;dialogo.entero2 >= 1 y dialogo.entero2 <= 12;'Debe Ingresar un mes valido';NO;Mes(FSys());;;;'##'
string1:'Periodo';;1;;NO;NO;;;;'01/'~Pad0(dialogo.entero2, 2)~'/'~Pad0(dialogo.entero1, 4);'01/'~Pad0(dialogo.entero2, 2)~'/'~Pad0(dialogo.entero1, 4)
fecha1:'Fecha desde';;1;;NO;;;;;Fecha(dialogo.string1);Fecha(dialogo.string1)
fecha2:'Fecha hasta';;1;;NO;;;;;FinDeMes(dialogo.fecha1, SI);FinDeMes(dialogo.fecha1, SI)
string2:'Path';;1;;NO;;;;;Var('PATHRTI');;;;'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
string3:'Archivo RTI';;1;;NO;;;;;Var('RTINOMB');
string4:'Encodig';;1;;NO;;;;;Var('RTIENCO');
check1:'Mensajes';;;;NO;NO;;;;0;
findialogo


if (not ok)
Cancelar()
endif


if (not existedirectorio(dialogo.string2))
Messagebox('No existe el path '~dialogo.string2~'. Debera crearlo.')
Cancelar()
endif

Message(' - Borrando Archivos RSM - ')

winexec('CMD.EXE /C DEL '~dialogo.string2~dialogo.string3~'*.*', 0)
esperar(5)

ejecutarevento('RTIGEN', entero1 = dialogo.entero1, entero2 = dialogo.entero2, string1 = dialogo.string1, fecha1 = dialogo.fecha1, fecha2 = dialogo.fecha2)

sql.add("Select * From "~Dbo()~".UIFRTI  ")
sql.add("Where Periodo= '"~Pad0(dialogo.entero1, 4)~Pad0(dialogo.entero2, 2)~"' ")
Watch(sql.batch)
recorrer sql

Scn(co1, 1)
Act(aa1, dialogo.string2~dialogo.string3~FStr(Val(co1), 1, 0)~'.XML')
Message('Creando Archivo '~dialogo.string3)
abrirascii(Val(aa1), 0)

escribirascii('<?xml version="1.0" encoding="'~dialogo.string4~'"?>')
escribirascii('<Operacion>')
escribirascii('  <RTI_de_valores_negociables Version="1.0">')

Act(x1, Trim(Fbn()['Transferencia']))
escribirascii('    '~xmlelemento('Transferencia_internacional_de_Valores_Negociables', Val(x1), 'SI'))
Act(fe1, Fecha(Fbn()['FechaLiq'], 'YYYY-MM-DD')~'T00:00:00-03:00')
escribirascii('    '~xmlelemento('Fecha_de_liquidaci93n', Val(fe1), 'SI'))
Act(x1, Trim(Fbn()['EntidadDep']))
escribirascii('      '~xmlelemento('Entidad_depositaria_del_exterior', Val(x1), 'SI'))
if (Eqstr(Fbn()['EntidadDep'], 'OTRA'))
Act(x1, Trim(Fbn()['DenomEntidadOtra']))
escribirascii('      '~xmlelemento('Denominaci93n', Val(x1), 'SI'))
endif
Act(x1, Trim(Fbn()['NroCtaTransferencia']))
escribirascii('      '~xmlelemento('Nro_de_la_cuenta_receptoraX85Xemisora_del_exterior', Val(x1), 'SI'))
Act(x1, Trim(BuscarCampo('PAISES', 'NomExterno', 'Codigo', Fbn()['PaisCtaTransferencia'])))
escribirascii('      '~xmlelemento('Pa92s_de_la_cuenta_receptoraX85Xemisora_del_exterior', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['NroCuentaDepos']))
escribirascii('      '~xmlelemento('Cuenta_depositante_Nro', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['NroCuentaComit']))
escribirascii('      '~xmlelemento('Nro_de_la_cuenta_comitente_de_Argentina', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['EspecieTransf']))
escribirascii('      '~xmlelemento('Especie_transferida', Val(x1), 'SI'))
if (Eqstr(Fbn()['EspecieTransf'], 'OTRA'))
Act(x1, Trim(Fbn()['DenomEspecieOtra']))
escribirascii('      '~xmlelemento('Denominaci93n_de_la_especie', Val(x1), 'SI'))
endif
Act(x1, Trim(Fbn()['TickerVN']))
escribirascii('      '~xmlelemento('TICKER_del_VN', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['TipoEspecieVN']))
escribirascii('      '~xmlelemento('Tipo_de_c93digo_identificatorio_del_VN', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['CodEspecieVN']))
escribirascii('      '~xmlelemento('C93digo_identificatorio_del_VN', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['CotizMonedaVN']))
escribirascii('      '~xmlelemento('Cotizaci93n_al_cierre_del_d92a_anterior_a_la_fecha_de_liquidaci93n', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['MonedaVN']))
escribirascii('      '~xmlelemento('Moneda_de_cotizaci93n_del_VN', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['CantidadVN']))
escribirascii('      '~xmlelemento('Cantidad_nominal_de_VN_transferida', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['ComparteComit']))
escribirascii('      '~xmlelemento('Las_cuentas_comitentes_comparten_alg94n_cond93mino', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['DenNoComparteComit']))
escribirascii('      '~xmlelemento('Denominaci93n_contraparte_del_exterior', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['CantidadCli']))
escribirascii('      '~xmlelemento('Cantidad_de_clientes_y_otros_sujetos_vinculados_a_la_cuenta_comitente_de_Argentina_a_la_fecha_de_la_transferencia', Val(x1), 'SI'))

escribirascii('      <IDENTIFICACI98N_DE_CLIENTES>')
Act(x1, Trim(Fbn()['TipoCliente']))
escribirascii('        '~xmlelemento('Tipo_Cliente88Cliente', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['NroCUIT']))
escribirascii('        '~xmlelemento('CUIT_CUIL_CDI_CIE88Cliente', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['TipoPersona']))
escribirascii('        '~xmlelemento('Tipo_de_Persona88Cliente', Val(x1), 'SI'))
if (Eqstr(Copy(Fbn()['TipoPersona'], 1, 14), 'Persona humana'))
Act(x1, Trim(Fbn()['Apellido']))
escribirascii('        '~xmlelemento('Apellidos88Cliente', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['Nombre']))
escribirascii('        '~xmlelemento('Nombres88Cliente', Val(x1), 'SI'))
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CUI'))
Act(x1, 'CUIT')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CIL'))
Act(x1, 'CUIL')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CED'))
Act(x1, 'Cédula Mercosur')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CI'))
Act(x1, 'CDI')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'DNI'))
Act(x1, 'Documento Nacional de Identidad')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'LE'))
Act(x1, 'Libreta de Enrolamiento')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'LC'))
Act(x1, 'Libreta Cívica')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'PAS'))
Act(x1, 'Pasaporte')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'DEX'))
Act(x1, 'Documento EXT')
else
Act(x1, 'Tipo Doc. No esperado')
endif
endif
endif
endif
endif
endif
endif
endif
endif
escribirascii('        '~xmlelemento('Tipo_Documento88Cliente', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['NroDoc']))
escribirascii('        '~xmlelemento('N94mero_Documento88Cliente', Val(x1), 'SI'))
else
Act(x1, Trim(Fbn()['DenomPersona']))
escribirascii('        '~xmlelemento('Denominaci93n88Cliente', Val(x1), 'SI'))
endif
escribirascii('      </IDENTIFICACI98N_DE_CLIENTES>')


sql.add("Select * From "~Dbo()~".UIFRTIOTR  ")
sql.add("Where Periodo= '"~Pad0(dialogo.entero1, 4)~Pad0(dialogo.entero2, 2)~"' ")
sql.add("  and NrOperacion = '"~Fbn()['NrOperacion']~"' ")
Watch(sql.batch)

recorrer sql
escribirascii('      <IDENTIFICACI98N_DE_OTROS_SUJETOS_VINCULADOS_A_LA_CUENTA_COMITENTE>')
Act(x1, Trim(Fbn()['NroCUIT']))
escribirascii('        '~xmlelemento('CUIT_CUIL_CDI_CIE88SujetosVinculados', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['Vinculo']))
escribirascii('        '~xmlelemento('Naturaleza_del_v92nculo_con_elX85Xlos_clientes88SujetosVinculados', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['TipoPersona']))
escribirascii('        '~xmlelemento('Tipo_de_Persona88SujetosVinculados', Val(x1), 'SI'))

Act(x1, Trim(Fbn()['Apellido']))
escribirascii('        '~xmlelemento('Apellidos88SujetosVinculadosPF', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['Nombre']))
escribirascii('        '~xmlelemento('Nombres88SujetosVinculadosPF', Val(x1), 'SI'))
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CUI'))
Act(x1, 'CUIT')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CIL'))
Act(x1, 'CUIL')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CED'))
Act(x1, 'Cédula Mercosur')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'CI'))
Act(x1, 'CDI')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'DNI'))
Act(x1, 'Documento Nacional de Identidad')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'LE'))
Act(x1, 'Libreta de Enrolamiento')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'LC'))
Act(x1, 'Libreta Cívica')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'PAS'))
Act(x1, 'Pasaporte')
else
if (Eqstr(Trim(Fbn()['TipoDoc']), 'DEX'))
Act(x1, 'Documento EXT')
else
Act(x1, 'Tipo Doc. No esperado')
endif
endif
endif
endif
endif
endif
endif
endif
endif
escribirascii('        '~xmlelemento('Tipo_Documento88SujetosVinculadosPF', Val(x1), 'SI'))
Act(x1, Trim(Fbn()['NroDoc']))
escribirascii('        '~xmlelemento('N94mero_Documento88SujetosVinculadosPF', Val(x1), 'SI'))
escribirascii('      </IDENTIFICACI98N_DE_OTROS_SUJETOS_VINCULADOS_A_LA_CUENTA_COMITENTE>')

proximo

escribirascii('  </RTI_de_valores_negociables>')
escribirascii('</Operacion>')

cerrarascii

proximo

if (dialogo.check1 = 0)
Messagebox('Generados '~FStr(Val(co1), 0, 0)~' Archivos '~dialogo.string3~' XML en '~dialogo.string2)
endif
