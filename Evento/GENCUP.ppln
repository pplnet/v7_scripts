HojaVisible(NO)

ModoReproceso(SinDialogo())
creardialogo
especie1:'Especie para generar especie-cupon ';;;;;;;;;

findialogo

if (not ok)
Cancelar()
endif


Act(pp:4, generarjerarquiaporreferencia('ESPECIES', '004000000000000', SI))


Sqladd("  SELECT                                                                             ")
