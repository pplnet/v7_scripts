modoreproceso(sindialogo)
creardialogo
nroperacion1: 'Operacion';;;;;;Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'TRANMM');'El TipoOp debe ser TRANMM';NO;;;;;;" TipoOp in ('TRANMM') "
directorio1: 'Path carta';;;;;;NoVacio(dialogo.directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
string1: 'File carta';;;;;;NoVacio(dialogo.string1);'Debe ingresar un documento';NO;Var('FILECACTRN')
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar('El directorio '~dialogo.directorio1~' no existe')
endif


let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

Act(ml:99, Var('MONELOCA'))
Act(me:99, Var('MONEEXTR'))

Sqladd(" Select O.TipoOp, O.FechaOp, O.Especie, O.Cliente1, O.Cuenta4, O.Cantidad, O.Vehiculo1, O.Cliente2, O.Cuenta1, ")
Sqladd(" C1.Cliente ClienteCta1, C4.Cliente ClienteCta4, C1.CBU CBUCta1, C4.CBU CBUCta4, C1.Numero NumeroCta1, C4.Numero NumeroCta4 ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".CUENTAS C1, "~Dbo()~".CUENTAS C4 ")
Sqladd(" where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" AND C1.Codigo = O.Cuenta1 ")
Sqladd(" AND C4.Codigo = O.Cuenta4 ")
recorrer sql

if (Eqstr(Fbn()['Especie'], Val(ml:99)))
Act(mo:99, 'Pesos')
else
Act(mo:99, 'Dolares')
endif

if (Eqstr(Fbn()['Especie'], Val(ml:99)))
Act(ms:99, '$')
else
Act(ms:99, 'u$s')
endif


let(&localidad, BuscarCampo('CLIENTES', 'Localidad', 'Codigo', Fbn()['Cliente1']))
let(&fecha_larga, FStr(Dia(Fbn()['FechaOp']), 1, 0)~' de '~Meses(Mes(Fbn()['FechaOp']))~' de '~FStr(Anio(Fbn()['FechaOp']), 4, 0))
let(&razon_social, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1']))

let(&oracion1, 'Declaro bajo juramento que la emision de la transferencia via MEP por '~iif (Eqstr(Fbn()['Especie'], Val(ml:99)), Val(ms:99), iif (Eqstr(Fbn()['Especie'], Val(me:99)), Val(ms:99), Fbn()['Especie']))~' '~PYC(Fbn()['Cantidad'], 1, 2))
let(&oracion2, ' que por medio de la presente solicitamos que sea realizada en el dia de la fecha, desde la cuenta corriente nro. '~Fbn()['NumeroCta4'])
let(&oracion3, ', CBU: '~Fbn()['CBUCta4']~', abierta en esta entidad, perteneciente a '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Vehiculo1'])~', C.U.I.T. '~BuscarCampo('CLIENTES', 'CUIT', 'Codigo', Fbn()['Vehiculo1'])~', tiene como destino la cuenta corriente Nº '~Fbn()['NumeroCta1'])
let(&oracion4, ', CBU '~Fbn()['CBUCta1']~', de '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente2'])~', a nombre de '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Vehiculo1'])~', C.U.I.T. '~BuscarCampo('CLIENTES', 'CUIT', 'Codigo', Fbn()['Vehiculo1']))
let(&oracion5, ', previo credito en la cuenta en el B.C.R.A Nº '~BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', Fbn()['Cliente2'])~' de dicho Banco, bajo el concepto transferencia entre cuentas del mismo titular.')

let(&oracion6, 'Con el mismo caracter declaramos que las cuentas intervinientes en esta transferencia no se hallan abiertas a la orden de mas de una persona juridica.')

let(&oracion7, 'Me doy por notificado que esta declaracion jurada queda en poder de la entidad financiera para ser puesta a disposicion de la Administracion Federal de Ingresos Publicos en caso de requerirla dicho organismo.')

emitircartavisible(&pf, Copy(directorio.string1, 1, Longitud(directorio.string1) - 5)~'_'~dialogo.nroperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion1 = &oracion1, oracion2 = &oracion2, oracion3 = &oracion3, oracion4 = &oracion4, oracion5 = &oracion5, oracion6 = &oracion6, oracion7 = &oracion7)



let(&razon_social, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente2']))

let(&oracion1, 'Por medio de la presente informamos a Uds. que hemos solicitado al '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1'])~' la emision de una transferencia via MEP por ')
let(&oracion2, iif (Eqstr(Fbn()['Especie'], Val(ml:99)), Val(ms:99), iif (Eqstr(Fbn()['Especie'], Val(me:99)), Val(ms:99), Fbn()['Especie']))~' '~PYC(Fbn()['Cantidad'], 1, 2)~' con credito a Vuestra cuenta en el B.C.R.A Nº '~BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', Fbn()['Cliente2'])~' los fondos anteriormente informados seran debitados de la cuenta corriente en ')
let(&oracion3, Val(mo:99)~' nro. '~Fbn()['NumeroCta4']~', CBU: '~Fbn()['CBUCta4']~', Titular: '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Vehiculo1'])~', C.U.I.T. nro. '~BuscarCampo('CLIENTES', 'CUIT', 'Codigo', Fbn()['Vehiculo1'])~', del mencionado Banco.')
let(&oracion4, ' ')
let(&oracion5, ' ')

let(&oracion6, 'En tal sentido, les solicitamos sirvanse acreditar dichos fondos en nuestra Cuenta Corriente Nº '~Fbn()['NumeroCta1']~', CBU: '~Fbn()['CBUCta1']~', la suma de '~iif (Eqstr(Fbn()['Especie'], Val(ml:99)), Val(ms:99), iif (Eqstr(Fbn()['Especie'], Val(me:99)), Val(ms:99), Fbn()['Especie']))~' '~PYC(Fbn()['Cantidad'], 1, 2)~'.')

let(&oracion7, ' ')

emitircartavisible(&pf, Copy(directorio.string1, 1, Longitud(directorio.string1) - 5)~'_'~dialogo.nroperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion1 = &oracion1, oracion2 = &oracion2, oracion3 = &oracion3, oracion4 = &oracion4, oracion5 = &oracion5, oracion6 = &oracion6, oracion7 = &oracion7)
proximo

