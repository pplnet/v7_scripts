creardialogo
check1:'Procesa';;;;SI;SI;;;;0
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(l:1, 'T2X4|X20F4')

Act(a:1, 'MovPend')
Act(a:2, 'MovEjec')
Act(a:3, 'Saldos')
Act(a:4, 'SaldosDia')

Acn(b:1, Query("Select Count(*) from "~Dbo()~".MOVPENDIENTES WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(b:2, Query("Select Count(*) from "~Dbo()~".MOVEJECUTADOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(b:3, Query("Select Count(*) from "~Dbo()~".SALDOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(b:4, Query("Select Count(*) from "~Dbo()~".SALDOSDIA WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))

if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".MOVPENDIENTES  ")
Sqladd("   Set NrSaldo    = 321 ")
Sqladd("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
Sqladd("  and NrSaldo     = 121 ")
Sqlnew()

Sqladd("Update "~Dbo()~".MOVEJECUTADOS  ")
Sqladd("   Set NrSaldo    = 321 ")
Sqladd("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
Sqladd("  and NrSaldo     = 121 ")
Sqlnew()

Sqladd("Update "~Dbo()~".SALDOS  ")
Sqladd("   Set NrSaldo    = 321 ")
Sqladd("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
Sqladd("  and NrSaldo     = 121 ")
Sqlnew()

Sqladd("Update "~Dbo()~".SALDOSDIA  ")
Sqladd("   Set NrSaldo    = 321 ")
Sqladd("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
Sqladd("  and NrSaldo     = 121 ")
Sqlnew()

Sqlexec()
Messagebox('Ajuste Finalizado')
else
Messagebox('Finalizado sin Procesar')
endif

Acn(c:1, Query("Select Count(*) from "~Dbo()~".MOVPENDIENTES WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(c:2, Query("Select Count(*) from "~Dbo()~".MOVEJECUTADOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(c:3, Query("Select Count(*) from "~Dbo()~".SALDOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
Acn(c:4, Query("Select Count(*) from "~Dbo()~".SALDOSDIA WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))

