creardialogo
fecha1:'Fecha';;;;;;;;;;FSys()
vehiculo1: 'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
fecha2:'Fecha Hasta';;;;NO;;;;;;Habiles(dialogo.fecha1, 1, 'ARG', SI) - 1
fecha3:'Fecha Prox';;;;NO;;;;;;Habiles(dialogo.fecha1, 1, 'ARG', SI)
findialogo


if (not ok)
Cancelar()
endif

Acd(fe:1, dialogo.fecha2)


recorrer&k dialogo.fecha1, Val(fe:1)


sql.add("DELETE FROM "~Dbo()~".MOVDEVENGADOS  ")
sql.add(" WHERE Fecha     = '"~IdxDate(&k)~"' ")
sql.add(" AND   NrSaldo   = 110 ")
sql.add(" AND   TipoDevengado = 'INTICL'    ")
sql.add(" AND   Vehiculo      = '"~dialogo.vehiculo1~"'  ")
sql.new
sql.exec

sql.add(" Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, ")
sql.add("  Case When DiasAnio = '0' Then 36000 Else 36500 End Divisor,")
sql.add("  Precio1 as Tasa, TipoTasa as CodTasa, Spread, Especie1 as CodSpread, ")
sql.add("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(&k)~"',2)) as Saldo ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" where (FechaVto >= '"~IdxDate(&k)~"'  or CB1=1) ")
sql.add("   and O.NrOperacion = OB.NrOperacion ")
sql.add("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")
sql.add("   and TipoOp in ('CONU')")
sql.add("   and (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(&k)~"',2))>0")
Watch(sql.batch)
recorrer sql

Acn(sa:1, Fbn('Saldo'))
Acn(di:1, Fbn('Divisor'))
Act(ta:1, Fbn('CodTasa'))
Acn(ta:2, Fbn('Tasa'))
Act(sp:1, Fbn('CodSpread'))
Acn(sp:2, Fbn('Spread'))
Act(es:1, Fbn('Especie'))
Acd(fp:1, &k)
Acn(pz:1, 1)

if (Vacio(Val(ta:1)))
Acn(ta:10, Val(ta:2))
else
Acn(ta:10, sql("select Valor1 from "~Dbo()~".TASASDIA where TipoTasa = '"~Val(ta:1)~"' and Especie ='"~Val(es:1)~"' and Fecha=  (select Max(Fecha) from "~Dbo()~".TASASDIA where Fecha<= '"~IdxDate(Val(fp:1))~"' and TipoTasa = '"~Val(ta:1)~"' and Especie ='"~Val(es:1)~"') "))
endif

if (Vacio(Val(sp:1)))
Acn(ta:11, Val(sp:2))
else
Acn(ta:11, sql("Select Precio1 from "~Dbo()~".COTIZACIONES where Codigo = '"~Val(sp:1)~"' and Fecha=  (select Max(Fecha) from "~Dbo()~".COTIZACIONES where Fecha<= '"~IdxDate(Val(fp:1))~"' and Codigo = '"~Val(sp:1)~"') "))
endif

Acn(ta:3, Val(ta:10) + Val(ta:11))

Acn( in :1, Val(sa:1) * Val(ta:3) / Val(di:1) * Val(pz:1))


Acd(fe:2, sql(" Select max(Fecha) from "~Dbo()~".MOVDEVENGADOS where NrOperacion='"~Fbn('NrOperacion')~"' and TipoDevengado='INTICL' and Especie='"~Fbn('Especie')~"' and NrSaldo= 110 "))
if (Val(fe:2) < Fecha('01/01/2000'))
Acd(fe:2, Fbn('FechaOp'))
else
Acd(fe:2, Val(fe:2) + 1)
endif

if (Val(fe:2) < dialogo.fecha1)
recorrer&j Val(fe:2), dialogo.fecha1 - 1
Acd(fe:3, &j)
if (sql(" Select 1 from "~Dbo()~".MOVDEVENGADOS where NrOperacion='"~Fbn('NrOperacion')~"' and  Fecha= '"~IdxDate(&k)~"' and TipoDevengado='INTICL' and Especie='"~Fbn('Especie')~"' and NrSaldo= 110 ") > 0)
Message('Borrando devengados del dia ... ')
sql.add("DELETE FROM "~Dbo()~".MOVDEVENGADOS  ")
sql.add(" WHERE Fecha     = '"~IdxDate(Val(fe:3))~"' ")
sql.add(" AND   NrSaldo   = 110 ")
sql.add(" AND   TipoDevengado = 'INTICL'    ")
sql.add(" AND   Cliente       = '"~Fbn('Cliente1')~"'  ")
sql.add(" AND   Vehiculo      = '"~dialogo.vehiculo1~"'  ")
sql.add(" AND   NrOperacion   = '"~Fbn('NrOperacion')~"' ")
sql.new
endif

Message('Generando movimiento devengado ... ')
sql.add(" INSERT INTO "~Dbo()~".MOVDEVENGADOS ( ")
sql.add(" NrOperacion, Fecha, FechaEj, Monto, TipoDevengado, ")
sql.add(" Cliente, Vehiculo, NrSaldo, Especie, ")
sql.add(" Book, EspecieRef, Producto, Tasa1, Tasa2 ")
sql.add(" ) VALUES ( ")
sql.add(" '"~Fbn('NrOperacion')~"', '"~IdxDate(Val(fe:3))~"','"~iif (Mes(Val(fe:3)) = Mes(dialogo.fecha1), IdxDate(dialogo.fecha1), IdxDate(dialogo.fecha3))~"',  "~FStr(Val( in :1), 0, 2)~", 'INTICL', ")
sql.add(" '"~Fbn('Cliente1')~"', '"~dialogo.vehiculo1~"', 110, '"~Fbn()['Especie']~"', ")
sql.add(" '"~Fbn()['Book1']~"', '"~Fbn()['Especie']~"', 'ICL', "~FStr(Val(ta:10), 0, 8)~", "~FStr(Val(ta:11), 0, 8)~"")
sql.add(" ) ")
sql.new
sql.exec


proximo
endif

Acd(fe:3, &k)
if (sql(" Select 1 from "~Dbo()~".MOVDEVENGADOS where NrOperacion='"~Fbn('NrOperacion')~"' and  Fecha= '"~IdxDate(&k)~"' and TipoDevengado='INTICL' and Especie='"~Fbn('Especie')~"' and NrSaldo= 110 ") > 0)
Message('Borrando devengados del dia ... ')
sql.add("DELETE FROM "~Dbo()~".MOVDEVENGADOS  ")
sql.add(" WHERE Fecha     = '"~IdxDate(Val(fe:3))~"' ")
sql.add(" AND   NrSaldo   = 110 ")
sql.add(" AND   TipoDevengado = 'INTICL'    ")
sql.add(" AND   Cliente       = '"~Fbn('Cliente1')~"'  ")
sql.add(" AND   Vehiculo      = '"~dialogo.vehiculo1~"'  ")
sql.add(" AND   NrOperacion   = '"~Fbn('NrOperacion')~"' ")
sql.new
endif

Message('Generando movimiento devengado ... ')
sql.add(" INSERT INTO "~Dbo()~".MOVDEVENGADOS ( ")
sql.add(" NrOperacion, Fecha, FechaEj, Monto, TipoDevengado, ")
sql.add(" Cliente, Vehiculo, NrSaldo, Especie, ")
sql.add(" Book, EspecieRef, Producto, Tasa1, Tasa2 ")
sql.add(" ) VALUES ( ")
sql.add(" '"~Fbn('NrOperacion')~"', '"~IdxDate(Val(fe:3))~"','"~iif (Mes(Val(fe:3)) = Mes(dialogo.fecha1), IdxDate(dialogo.fecha1), IdxDate(dialogo.fecha3))~"',  "~FStr(Val( in :1), 0, 2)~", 'INTICL', ")
sql.add(" '"~Fbn('Cliente1')~"', '"~dialogo.vehiculo1~"', 110, '"~Fbn()['Especie']~"', ")
sql.add(" '"~Fbn()['Book1']~"', '"~Fbn()['Especie']~"', 'ICL', "~FStr(Val(ta:10), 0, 8)~", "~FStr(Val(ta:11), 0, 8)~"")
sql.add(" ) ")
sql.new
sql.exec



proximo

proximo


