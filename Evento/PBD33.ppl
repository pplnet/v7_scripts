MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
(.'DNLISTA'.)

CrearDialogo
  Fecha1: 'F.Bajada'  ; ;;;;;;;;fsys
  Radio2: 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;2;1;;;;;;;4
  Check2:  'Incluye Pagadoras';3;1;;;;;;;1
*  Lista1: 'Archivo'   ; 4;1;;;;;;;;;'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNCOBR|DNOTRO'
*  Lista1   : 'Archivo' ;4;1;;;;;;;;;VAR('DNARCHIVOS')
  Lista1   : 'Archivo' ;4;1;;;;;;;;;Val(l:1)
  Lista2: 'Vehiculos' ;-2;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista3:  'Bancos'   ;  ;1;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista4:  'Cuentas'  ;-7;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista3)~") "~IIF(NOVACIO(Dialogo.Lista2)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar 
Endif

EjecutarEvento('PBD31',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Lista4=Dialogo.Lista4,Check1=0,Check2=Dialogo.Check2)