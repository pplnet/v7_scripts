MostrarCuadroDeMensajes
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'Fecha'       ;;;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;fsys
  ListaTabla1: 'Operaciones' ;;;;NO;NO;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES'
  TipoOp1    : 'TipoOp'      ;;;;NO;NO;;
  Lista1     : 'Vehiculos'   ;;;;NO;NO;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1     : 'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

Message('--- Asientos NDF Fin de Mes ---')

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
    ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
    ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))

**// Fecha Proceso
ACD(v:1, Dialogo.Fecha1)
**// Ultimo Dia Habil mes anterior
***---ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:2, FinDeMes(PriDeMes(Dialogo.Fecha1, SI)-1, NO))
**// Primer Dia Mes Anterior
ACD(v:3, PriDeMes(Val(v:2),SI))
**// Primer Dia del Mes
ACD(v:4, PriDeMes(Val(v:1),SI))
**// Ultimo Dia del Mes anterior
ACD(v:5, Val(v:4)-1)

***---Dialogo.Fecha1 = 07/08 => V2=31/07 => V3=01/07 => V4=01/08 => V5=31/07 => FE1=01/07

***// Si en la fecha no corresponde contabilizar asientos de fin de mes, cancelo.
If Val(v:1)<>Val(x2)
   Cancelar
Endif

SQL.ADD(" Select O.TipoOp, O.Vehiculo1, M.Codigo CodAsi, O.Cliente1, O.NrOperacion, O.Precio1, O.Plazo, ")
SQL.ADD(" O.Cantidad, O.MB3, O.Cantidad, O.Especie, O.ContraEspecie, O.FechaOp, O.ContraEspecie Moneda, O.FechaPago, V.Alias4 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".MODELOSASIENTO M ")
SQL.ADD("   Where O.FechaOp  <= "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and O.FechaVto   >  "~IdxDate2(Val(v:5))~" ")
SQL.ADD("   and O.TipoOp in ('FXCT','FXVT','FXCTV','FXVTV','FXAT','FXATV') ")
SQL.ADD("   and O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
SQL.ADD(" AND M.Habilitado = 'SI' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
   Recorrer&i 1,Elementos(Dialogo.Lista1)
        SQL.ADD(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
   proximo
   SQL.ADD(") ")    
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD("   and O.Vehiculo1   =  V.Codigo ")
SQL.ADD("   and M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASINDFM'))~") ")
SQL.ADD("   and M.TipoOp      = O.TipoOp ")
**// Es NDF y no fue ejercida
SQL.ADD("   and O.CB9 = 1 and O.CB8=1 ")
SQL.ADD(" Order by O.NrOperacion ")

Recorrer SQL
   ACN(CK:1, 0)
   ACD(FV:1, Val(V:5))
   ACT(VH:1, fbn('Vehiculo1'))
   **//(.'FECHAVALOR'.)
   IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         ACN(CK:1, 0)
      ENDIF
   ENDIF
   ACN(CT:1, CotizacionC(fbn('Especie'),,FBN('FechaPago'),,Val(v:5),1,SI,FBN('ContraEspecie')))

   If Eqstr(FBN('TipoOp'),'FXCT')
      ACN(ND:1, FBN('Cantidad') * (Val(CT:1) - FBN('Precio1')) )
   Else
      ACN(ND:1, FBN('Cantidad') * (FBN('Precio1') - Val(CT:1)) )
   Endif
*/MessagebOx(Val(ND:1))
   IF Val(CK:1) = 0
     message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
     SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
     SQL.EXEC
   ENDIF
Proximo