ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

********************************************************************
*
* Interfase - SIAF-CAP (CRVM y DEVM)
* Fecha..............: 03/FEB/2003 
* Ultima modificacisn: 
* Autor..............: Silvia
*
********************************************************************
*
* Blanqueo de Password de Usuarios
*
*********************************************************************

HojaVisible(NO)

CrearDialogo
   Fecha1   : 'Fecha'               ;1;1;;;;;;;;FSYS
   NrTrans1 : "Nro. Transaccion"    ;;;;;;;;;;;
   Lista1:    'Vehiculos'           ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select /*+ RULE */ Codigo from "~DBO~".VEHICULOS"),Val(VH:1))
   Lista2:    'Bancos'              ;  ;1;;;;;;;;;SQLSet(" Select /*+ RULE */ Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
   Lista3:    'Cuentas'             ;-6;2;;;;;;;;;SQLSet(" Select /*+ RULE */ Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not OK
   Cancelar
endif


*-- Busco Transaccion
   ACT(tr1, TRIM(MIRT(Dialogo.NrTrans1)))

     SQL.ADD(" Select /*+ RULE */ A.*  from "~DBO~".Transacciones2 A ")
     SQL.ADD("   where (A.CB4 IS NULL OR A.CB4 = '0') ")
     SQL.ADD("     and (A.CB10 IS NULL OR A.CB10 = '0') ")
     SQL.ADD("     and A.TipoTr2 in ('CRVM', 'DEVM') ")
     if NoVacio(Dialogo.NrTrans1)
        SQL.ADD("     and A.NrTrans = '"~Dialogo.NrTrans1~"'  ")
     endif

     SQL.ADD("     AND A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1)~" ")

     If NoVAcio(Dialogo.Lista1)
        SQL.ADD(" AND A.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
     Else
        If NoVacio(UsrVehiculos(UsuarioActivo))
           SQL.ADD("  AND A.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
        endif
     Endif

     If NoVAcio(Dialogo.Lista2)
        SQL.ADD(" AND A.Cliente2  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
     endif

     If NoVAcio(Dialogo.Lista3)
        SQL.ADD(" AND A.Cuenta2  IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
     endif

*-- 

Recorrer SQL
   Message(' Usuario '~FBN['Nrtrans']~' '~FBN['Tipotr2']~' ...')

       ACT(a:fac,FBN['Nrtrans'])
       ACT(b:fac,FBN['Tipotr2'])
       ACT(c:fac,FBN['Especie'])
       ACT(d:fac,FBN['Cliente1'])
       ACT(e:fac,FBN['Cuenta1'])
       ACT(f:fac,FBN['Cliente2'])
       ACT(g:fac,FBN['Cuenta2'])
       ACN(h:fac,FBN['Cantidad1'])
       ACD(i:fac,FBN['Fecha1'])
       ACD(j:fac,FBN['Fecha2'])
       ACT(k:fac,FBN['CB2'])
       ACT(l:fac,FBN['CB4'])
       ACT(n:fac,FBN['Vehiculo1'])
       ACT(o:fac,FBN['CB6'])
       ACT(p:fac,FBN['CB8'])
       ACD(q:fac,FBN['Fecha5'])
       ACT(r:fac,FBN['CB10'])

       ACN(z:fac, 1 )

Proximo

If fac>0

   CrearListBox;'Arial,10,B'
     'Transm.'              ; z1..k:fac; SI; SI;;70; COMBO; 'Si|No|'
     'Nrtrans'              ; a1..a:fac; NO; SI;;70; STRING
     'Tipo T'               ; b1..b:fac; NO; SI;;70; STRING
     'Especie'              ; c1..c:fac; NO; SI;;70; STRING
     'Cliente1'             ; d1..d:fac; NO; SI;;80; STRING
     'Cuenta1'              ; e1..e:fac; NO; SI;;90; STRING
     'Cliente2'             ; f1..f:fac; NO; SI;;80; STRING
     'Cuenta2'              ; g1..g:fac; NO; SI;;90; STRING
     'Cantidad1'            ; h1..h:fac; NO; SI;;100; STRING
     'Fecha1'               ; i1..i:fac; NO; SI;;70; STRING
     'Fecha2'               ; j1..j:fac; NO; SI;;70; STRING
     'CB2'                  ; k1..k:fac; NO; SI;;50; STRING
     'CB4'                  ; l1..l:fac; NO; SI;;50; STRING
     'Vehiculo'             ; n1..n:fac; NO; SI;;80; STRING
     'CB6'                  ; o1..o:fac; NO; SI;;50; STRING
     'CB8'                  ; p1..p:fac; NO; SI;;50; STRING
     'Fecha5'               ; q1..q:fac; NO; SI;;230; STRING
     'CB10'                 ; r1..r:fac; NO; SI;;50; STRING

   FinListBox

   If Ok 
      Recorrer&i 1,fac
       If Val(z:&i)=0
         SQL.ADD("Update /*+ RULE */ "~DBO~".transacciones2 Set ")
         SQL.ADD("CB10 = '1' ")
         SQL.ADD("where NrTrans ='"~val(a:&i)~"'  ")
         SQL.NEW
         SQL.EXEC
         MessageBox('Marcado Exitoso para: '~val(a:&i))
      endif
      Proximo
   else
      Cancelar
   Endif
Else
   MessageBox('No existen transacciones para la seleccion')

EndIf

