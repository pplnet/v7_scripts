Sqladd(" INSERT INTO "~Dbo()~".RELACIONCUENTA ")
Sqladd(" (Codigo, TiposOperacion, Cuenta, Tabla, ")
Sqladd(" TiposGrupoEsp, Moneda, Vehiculos) ")
