Sqladd(" Select /*+ RULE */ M.FechaAcreditacion, M.Vehiculo, M.NrDatanet, M.Moneda, M.Importe, M.Cuenta, ")
Sqladd(" M.Banco, M.NrMovDatanet, M.TipoMov, D.Archivo ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".DATANET D, "~Dbo()~".VEHICULOS V, "~Dbo()~".CUENTAS C, ")
Sqladd(" "~Dbo()~".CODIGOSDATANET CD ")
Sqladd(" WHERE  M.NrDatanet   = D.NrDatanet ")
Sqladd(" AND    M.Cuenta      = C.Numero ")
Sqladd(" AND    M.TipoMov     = CD.Codigo (+) ")
Sqladd(" AND    D.FechaBajada = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND    M.DC          = 'C' ")
Sqladd(" AND    M.Vehiculo    = V.Codigo ")
Sqladd(" AND    M.EstadoConciliacion = 'P' ")
if (not celdavacia(dn:1))
Sqladd(" AND    CD.Tipo NOT IN ("~Pipe2Comillas(Val(dn:1))~") ")
endif
if (dialogo.radio2 = 0)
Sqladd(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
endif
if (dialogo.radio2 = 1)
Sqladd(" AND C.TipoCuenta IN ('INT')")
endif
if (dialogo.radio2 = 2)
Sqladd(" AND C.TipoCuenta IN ('REC')")
endif
if (dialogo.radio2 = 3)
Sqladd(" AND C.TipoCuenta IN ('CA')")
endif
if (dialogo.check2 = 0)
Sqladd(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND   D.Archivo IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND   M.Vehiculo IN ("~Pipe2Comillas(dialogo.lista2)~") ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND   C.Comitente IN ("~Pipe2Comillas(dialogo.lista3)~") ")
endif
if (NoVacio(dialogo.lista4))
Sqladd(" AND   C.Codigo IN ("~Pipe2Comillas(dialogo.lista4)~") ")
endif

if (dialogo.check1 = 1)
Sqladd(" ORDER BY M.NrDataNet, M.Vehiculo, M.Banco, M.Cuenta ")
