ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(SQL("Select TipoOp From "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' "),'SEVS|SECS');'El TipoOp debe ser SECS o SEVS';NO;;;;;;"TipoOp in ('SECS','SEVS')";
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACSEE')
FinDialogo

If Not OK
  Cancelar
Endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif


SetFilaActual(1)
SQL.ADD(" Select C.Localidad, C.Fax, C.Telefono, C.Direccion, C.PaisDir, C.CodigoPostal, C.CUIT, O.Vehiculo1 ")
SQL.ADD(" From "~DBO~".CLIENTES C ")
SQL.ADD(" JOIN "~DBO~".OPERACIONES O ")
SQL.ADD(" on C.Codigo = O.Vehiculo1 ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  let &direccion fbn('Direccion')
  let &codigo_postal fbn('CodigoPostal')
  let &localidad fbn('Localidad')
  let &pais BuscarCampo('PAISES','Nombre','Codigo',fbn('PaisDir'))
  let &cuit fbn('CUIT')
  let &personas VAR('CONURUSE')
  let &fax fbn('Fax')
Proximo


SQL.ADD(" Select O.TipoOp,O.FormaLiquidacion1,O.ContraEspecie,O.Cantidad,O.Precio1,O.TotalBrutoCli1,O.TotalIntereses,O.FechaOp,O.FechaVto,O.Cliente1,E.Nombre,E.ISIN ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" LEFT JOIN "~DBO~".ESPECIES E ")
SQL.ADD(" on O.Especie=E.Codigo ")
SQL.ADD(" where O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
Recorrer SQL

  let &marca1 ' '
  let &marca2 ' '
  ***DVP***
  If EqStr(fbn('TipoOp'),'SEVS')
    let &marca1 'X'
  ***RVP***
  Else
    let &marca2 'X'
  Endif
  
  EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, direccion = &direccion, codigo_postal = &codigo_postal, localidad = &localidad, pais = &pais, cuit = &cuit, personas = &personas, fax = &fax, marca1 = &marca1, marca2 = &marca2, nombre = fbn('Nombre'), isin = fbn('ISIN'), contra_especie = fbn('ContraEspecie'), monto = PYC(fbn('Cantidad'),0,2), precio = PYC(fbn('Precio1'),0,3), total_bruto_cli = PYC(fbn('TotalBrutoCli1'),0,2), total_intereses = PYC(fbn('TotalIntereses'),0,2), bruto_mas_intereses = PYC(fbn('TotalBrutoCli1')+fbn('TotalIntereses'),0,2), fecha_op = fbn('FechaOp'), fecha_vto = fbn('FechaVto'), razon_social = BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente1')))
  
Proximo




