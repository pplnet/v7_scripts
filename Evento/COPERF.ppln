creardialogo
perfil1: 'Perfil';;;;;;NoVacio(dialogo.perfil1);"Tiene que ingresar un Perfil";NO;;
string1: 'Cod. Nuevo Perfil';;;;;;NoVacio(dialogo.string1) y Longitud(dialogo.string1) <= 10;"Debe ingresar el codigo del nuevo Perfil con un maximo de 10 caracteres";NO;;
string2: 'Nom. Nuev. Perfil';;;;;;NoVacio(dialogo.string2) y Longitud(dialogo.string2) <= 30;"Debe ingresar el nombre del nuevo Perfil con un maximo de 30 caracteres";NO;;BuscarCampo('PERFILES2', 'Nombre', 'Codigo', dialogo.perfil1);;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX';
findialogo

if (not ok)
Cancelar()
endif

if (Query("SELECT 1 FROM "~Dbo()~".PERFILES2 WHERE Codigo = '"~Mayusculas2(dialogo.string1)~"'") = 1)
Cancelar()("Ya existe un perfil con el codigo "~Mayusculas2(dialogo.string1))
endif

sql.add(" SELECT Script ")
sql.add(" FROM "~Dbo()~".PERFILES2 ")
sql.add(" WHERE Codigo = '"~dialogo.perfil1~"' ")
recorrer sql
Act(sc:1, Fbn('Script'))
proximo

sql.add(" INSERT INTO "~Dbo()~".PERFILES2 ")
sql.add(" (Codigo,Nombre,Script) ")
sql.add(" VALUES ")
sql.add(" ('"~Mayusculas2(dialogo.string1)~"','"~dialogo.string2~"','"~Val(sc:1)~"') ")
sql.new
sql.exec

