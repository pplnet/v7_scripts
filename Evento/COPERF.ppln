Sqladd(" SELECT Script ")
Sqladd(" FROM "~Dbo()~".PERFILES2 ")
Sqladd(" WHERE Codigo = '"~dialogo.perfil1~"' ")
recorrer sql
Act(sc:1, Fbn('Script'))
proximo

Sqladd(" INSERT INTO "~Dbo()~".PERFILES2 ")
Sqladd(" (Codigo,Nombre,Script) ")
Sqladd(" VALUES ")
Sqladd(" ('"~Mayusculas2(dialogo.string1)~"','"~dialogo.string2~"','"~Val(sc:1)~"') ")
