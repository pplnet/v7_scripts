Acn(vc4, Query("SELECT Cantidad2 FROM "~Dbo()~".CUOTAS Where NrOperacion='"~Val(a:fac)~"' and NrCuota="~FStr(Val(vc2), 0, 0)~" "))
Acn(vc5, Query("SELECT Cantidad3 FROM "~Dbo()~".CUOTAS Where NrOperacion='"~Val(a:fac)~"' and NrCuota="~FStr(Val(vc2), 0, 0)~" "))

