Sqladd(" Select O.NrOperacion, E.TiposTasas, O.Especie, O.TipoCambio, O.FechaVto, E.DiasAnio, O.Cantidad, O.Precio1, O.TotalNetoCli1, ")
Sqladd(" E.TasaCER, O.FechaOp, O.FechaCargaSys ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".ESPECIES E ")
Sqladd(" Where E.Codigo = O.Especie ")
Sqladd(" AND O.TipoOp IN ('PARTID') ")
Sqladd(" AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.FechaCargaSys <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.TotalNetoCli1 > 0 ")
Sqladd(" AND O.FechaVto >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
Sqladd(" AND E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" Order By O.Especie, O.NrOperacion ")
recorrer sql
if (not Eqstr(Fbn('Especie'), Val(es:1)))
Act(aa:1, Fbn('Especie'))
Acn(ts:1, 0)
Sqladd(" Select TiposTasas, DiasMes, DiasAnio, Fecha, TasaCER, MonedaEmision, TasaIntVigente, TasaMin, TasaMax, Spread ")
Sqladd(" From "~Dbo()~".ESPECIES ")
Sqladd(" Where Codigo = '"~Val(aa:1)~"' ")
recorrer sql
Dfa()
Act(em:1, Fbn('MonedaEmision'))
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
Acn(ts:1, Fbn('TasaIntVigente'))
else
Acn(mi:1, Fbn('TasaMin'))
Acn(mx:1, Fbn('TasaMax'))
Acn(sp:1, Fbn('Spread'))
Sqladd(" Select T.Valor1 From "~Dbo()~".TASASDIA T ")
Sqladd(" Where TipoTasa = '"~Fbn('TiposTasas')~"' ")
Sqladd(" AND Especie = '"~Fbn('MonedaEmision')~"' ")
Sqladd(" AND Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T1 ")
Sqladd("              Where T.TipoTasa = T1.TipoTasa ")
Sqladd("              AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Dfa()
if (Val(mi:1) > Fbn('Valor1'))
Acn(ts:1, Val(mi:1))
else
if (Val(mx:1) < Fbn('Valor1'))
Acn(ts:1, Val(mx:1))
else
Acn(ts:1, Fbn('Valor1'))
endif
endif
Scn(ts:1, Val(sp:1))
proximo
endif
proximo

endif
Act(es:1, Fbn('Especie'))
Act(tt:1, Fbn('TiposTasas'))
Act(ce:1, Fbn('TasaCER'))
Acn(tr:1, Fbn('TipoCambio'))
if (dialogo.fecha1 = Fbn('FechaCargaSys'))
Acn(pr:1, Fbn('Precio1'))
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
Acn(pr:2, Fbn('TipoCambio'))
else
Act(aa:1, Fbn('Especie'))
Acn(pr:2, tirespecie(Fbn('Especie'), dialogo.fecha1, Val(ts:1), Fbn('Precio1')))
endif
Acn(pr:2, Fbn('TipoCambio'))
Acn(nc:1, 0)
Acd(fe:2, Fbn('FechaOp'))
else
Sqladd(" Select C.Precio4, C.NrCuota, C.Precio4 TIRDA, C.Precio2, C.Cantidad3 From "~Dbo()~".CUOTAS C ")
Sqladd(" Where C.NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND C.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Acn(pr:1, Fbn('Precio2'))
if (Eqstr(Val(tt:1), 'FIJA') o Eqstr(Val(ce:1), 'FIJ'))
Acn(pr:2, Val(tr:1))
else
Acn(pr:2, tirespecie(Val(es:1), dialogo.fecha1, Val(ts:1), Fbn('Precio2')))
endif
Acn(ca:3, Fbn('Cantidad3'))
Acn(nc:1, Fbn('NrCuota'))
proximo
Acn(pr:2, Val(tr:1))
Acd(fe:2, dialogo.fecha1)
endif
Acd(fe:3, dialogo.fecha1)
if (Eqstr(Fbn('DiasAnio'), 'REA'))
Acn(da:1, DiasAnio2(Fbn('Especie'), Fecha('01/01/'~FStr(Anio(Fbn('FechaOp')), 0, 0)), Fecha('31/12/'~FStr(Anio(Fbn('FechaOp')), 0, 0))))
else
Acn(da:1, Fbn('DiasAnio'))
endif
Acn(ca:1, Fbn('TotalNetoCli1'))
Act(nu:1, Fbn('NrOperacion'))
Acn(ca:3, 0)
Acn(ed:1, (1 + Val(pr:2) / 100) ** (1 / Val(da:1)) - 1)
recorrer&k Val(fe:2), Val(fe:3)
if (EsHabil(&k, 'ARG') o &k = Val(fe:2))
Acd(fi:1, &k)
Acd(ff:1, Habiles(&k, 1, 'ARG', SI))
Acn(pl:1, Val(ff:1) - Val(fi:1))
if (&k = Val(fe:2))
Acn(pi:1, Val(pr:1))
else
Acn(pi:1, Val(pf:1))
endif
Acn(pf:1, (Val(pi:1)) * (1 + Val(ed:1)) ** Val(pl:1))
Acn(pd:1, Val(pf:1) - Val(pi:1))
Acn(dv:1, Val(ca:1) * Val(pd:1))
Sqladd(" Select Max(NrCuota) NrCuota From "~Dbo()~".CUOTAS Where NrOperacion = '"~Val(nu:1)~"' ")
recorrer sql
Dfa()
Acn(nc:1, Fbn('NrCuota') + 1)
Sqladd(" Select Cantidad3 From "~Dbo()~".CUOTAS Where NrOperacion = '"~Val(nu:1)~"' AND NrCuota = "~FStr(Fbn('NrCuota'), 0, 0)~" ")
recorrer sql
Dfa()
Acn(ca:3, Fbn('Cantidad3'))
proximo
proximo
Scn(nc:1, 1)
Scn(ca:3, Val(dv:1))
Sqladd(" Insert Into "~Dbo()~".CUOTAS ")
Sqladd(" (NrOperacion, NrCuota, Fecha1, ")
Sqladd(" Fecha2, Cantidad2, Precio1, ")
Sqladd(" Precio2, Precio3, Cantidad1, ")
Sqladd(" Precio4, Cantidad3, Cantidad4) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nu:1)~"', "~FStr(Val(nc:1), 0, 0)~", '"~IdxDate(Val(fi:1))~"', ")
Sqladd(" '"~IdxDate(Val(ff:1))~"', "~FStr(Val(pl:1), 0, 0)~", "~FStr(Val(pi:1), 0, 15)~", ")
Sqladd(" "~FStr(Val(pf:1), 0, 15)~", "~FStr(Val(pd:1), 0, 15)~", "~FStr(Val(dv:1), 0, 2)~", ")
Sqladd(" "~FStr(Val(pr:2), 0, 8)~", "~FStr(Val(ca:3), 0, 2)~", "~FStr(Val(ca:1), 0, 2)~") ")
Sqlnew()
Sqlexec()
