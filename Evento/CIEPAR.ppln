let(&opsnoasignadaspartidas, 0)
Sqladd(" SELECT O.Cartera,O.FechaOp,O.Vehiculo1,O.Especie,M.Cantidad, ")
Sqladd("        O.Precio1,O.FechaVto,O.TipoOp,O.NrOperacion, M.NrSaldo, M.Book, O.Cliente1 ")
Sqladd(" FROM   "~Dbo()~".OPERACIONES O,"~Dbo()~".MOVPOSEJE M  ")
Sqladd(" WHERE  O.NrOperacion = M.NrOperacion ")
Sqladd("   and  M.FechaMov  >='"~IdxDate(dialogo.fecha1 - Var('DIASPAR'))~"' and M.FechaMov  <='"~IdxDate(dialogo.fecha1)~"' and M.FechaMov  >='"~IdxDate(Fecha(Var('FEINIPART')))~"'  ")
Sqladd("   and  M.NrSaldo    = '101' ")
Sqladd("   and  O.TipoOp    = 'TIC' ")
if (NoVacio(&book))
Sqladd("   and  M.Book    = '"~&book~"' ")
else
Sqladd("   and M.Book IN ("~Pipe2Comillas(Val(bk:1))~") ")
endif
Sqladd("   and  (O.NrPartida Is Null OR O.NrPartida = '' OR O.NrPartida = ' ' ) ")
Sqladd(" UNION ALL ")
Sqladd(" SELECT T.RB4 Cartera,T.Fecha1 FechaOp,T.Vehiculo1,T.Especie, ")
Sqladd(" M.Cantidad,T.Precio1, T.Fecha1 FechaVto,T.TipoTr2 TipoOp, ")
Sqladd(" T.NrTrans NrOperacion, M.NrSaldo, M.Book, T.Cliente1 ")
Sqladd(" FROM   "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M ")
Sqladd(" WHERE  T.NrTrans = M.NrOperacion ")
Sqladd("   and  M.FechaMov  >='"~IdxDate(dialogo.fecha1 - Var('DIASPAR'))~"' and M.FechaMov  <='"~IdxDate(dialogo.fecha1)~"' and M.FechaMov  >='"~IdxDate(Fecha(Var('FEINIPART')))~"'  ")
Sqladd("   and  M.NrSaldo     = '101' ")
Sqladd("   and  T.TipoTr2  IN ('DTP','TRPOS') ")
if (NoVacio(&book))
Sqladd("   and  M.Book    = '"~&book~"' ")
else
Sqladd("   and M.Book IN ("~Pipe2Comillas(Val(bk:1))~") ")
endif
Sqladd("   and  (T.NrPartida Is Null OR T.NrPartida = '' OR T.NrPartida = ' ' ) ")
Sqladd(" ORDER BY 9,1,2,4 ")

recorrer sql
let(&opsnoasignadaspartidas, &opsnoasignadaspartidas + 1)
proximo
if (&opsnoasignadaspartidas > 0)
