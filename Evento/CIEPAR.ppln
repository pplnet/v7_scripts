sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".ESPECIES E ")
sql.add(" Where E.Codigo = O.Especie ")
sql.add(" AND O.TipoOp IN ('PARTID') ")
sql.add(" AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.FechaCargaSys <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.TotalNetoCli1 > 0 ")
sql.add(" AND O.FechaVto >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
sql.add(" AND E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" Order By O.Especie, O.NrOperacion ")
recorrer sql
