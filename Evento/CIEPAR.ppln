sql.add("              Where T.TipoTasa = T1.TipoTasa ")
sql.add("              AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Dfa()
if (Val(mi:1) > Fbn('Valor1'))
Acn(ts:1, Val(mi:1))
else
if (Val(mx:1) < Fbn('Valor1'))
Acn(ts:1, Val(mx:1))
else
Acn(ts:1, Fbn('Valor1'))
endif
endif
Scn(ts:1, Val(sp:1))
proximo
endif
proximo

endif
Act(es:1, Fbn('Especie'))
Act(tt:1, Fbn('TiposTasas'))
Act(ce:1, Fbn('TasaCER'))
Acn(tr:1, Fbn('TipoCambio'))
if (dialogo.fecha1 = Fbn('FechaCargaSys'))
Acn(pr:1, Fbn('Precio1'))
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
