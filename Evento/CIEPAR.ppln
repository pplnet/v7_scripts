Sqladd(" "~FStr(Val(e:fac), 0, 8)~","~FStr(Val(f:fac), 0, 8)~","~FStr(Val(g:fac), 0, 2)~",")
Sqladd(" "~FStr(Val(k:fac), 0, 8)~","~FStr(Val(l:fac), 0, 8)~","~FStr(Val(m:fac), 0, 2)~",'1') ")
Sqlnew()
