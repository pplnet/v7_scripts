Sqladd(" C.Codigo Cliente1, '' Observaciones, V.Codigo Vehiculo1, "~FStr(Val(ct:1), 0, 0)~" Cantidad, E.Alias8 ")
Sqladd(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V, "~Dbo()~".CLIENTES C ")
