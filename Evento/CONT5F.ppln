Sqladd("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
Sqladd("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
Sqladd("       Sum(P.CantidadFin) as Cantidad, P.Vehiculo Vehiculo1, ")
Sqladd("       Sum(P.CantidadFin*P.PrecioFin) as Monto, V.Valor1, V.Valor2, E.Cotiza Moneda, P.Cliente, '' Observaciones, E.Alias8 ")
Sqladd(" from  "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" where P.Especie     = E.Codigo ")
Sqladd(" AND P.Vehiculo = V.Codigo ")
Sqladd("   and P.NrSaldo     in ("~Val(y:2)~") ")
Sqladd("   and P.TipoNegocio = 'FC' ")
if (NoVacio(dialogo.especie1))
Sqladd(" and P.Especie     = '"~dialogo.especie1~"' ")
endif
Sqladd("   and P.CantidadFin <> 0 ")
Sqladd("   and P.Fecha       = (select Max(Fecha) ")
Sqladd("                       from  "~Dbo()~".POSICIONES P2 ")
Sqladd("                       where P2.Especie     = P.Especie ")
Sqladd("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
Sqladd("                         and P2.Cliente     = P.Cliente ")
Sqladd("                         and P2.Vehiculo    = P.Vehiculo ")
Sqladd("                         and P2.NrSaldo     = P.NrSaldo ")
Sqladd("                         and P2.TipoNegocio = P.TipoNegocio ")
Sqladd("                         and P2.Fecha      <= "~IdxDate2(Val(v:2))~" ) ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND P.Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND P.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, V.Valor1, V.Valor2, P.Cliente, E.Alias8 ")
recorrer sql
Act(a:fac, Fbn('Especie'))
Act(b:fac, Fbn('Nombre'))
