MostrarCuadroDeMensajes()
creardialogo
especie1: 'Especie';1;1;1;;;NoVacio(dialogo.especie1);'Especie Invalida';NO;
entero1:'Cupon';2;1;1;;;;;;;iif (NoVacio(dialogo.especie1), BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1) - 1)
fecha1:'Fecha';;;;;;
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" SELECT NrTrans, Cambio2, Fecha1, Fecha3, Especie2 FROM "~Dbo()~".TRANSACCIONES2    ")
Sqladd(" WHERE Especie = '"~dialogo.especie1~"'        ")
Sqladd(" AND   Cupon1  = "~FStr(dialogo.entero1, 0, 0)~" ")
Sqladd(" AND   TipoTr2 = 'ACUPON' ")
if (dialogo.fecha1 <> 0)
Sqladd(" AND Fecha3 = "~IdxDate2(dialogo.fecha1)~" ")
endif

recorrer sql
Message('Cancelando ACUPON -> '~Fbn('NrTrans'))

Acn(c:2, dialogo.entero1)
Acd(fr:1, Habiles(Fbn('Fecha1'), -1, 'ARG'))
Acn(c:3, Fbn('Cambio2'))

Sqladd("DELETE FROM "~Dbo()~".MOVPOSEJE WHERE NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqladd("DELETE FROM "~Dbo()~".MOVPOSPEN WHERE NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqladd("DELETE FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqladd("DELETE FROM "~Dbo()~".TRANSACCIONES2  WHERE NrTrans     = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqladd(" Delete "~Dbo()~".COTIZACIONES ")
Sqladd(" Where Fecha = '"~IdxDate(Fbn('Fecha3'))~"' ")
Sqladd(" AND Codigo = '"~Fbn('Especie2')~"' ")
Sqladd(" AND CallPut = 'CON' ")
Sqlnew()
Sqlexec()
proximo


if (Val(c:3) <= 0)
Act(er:1, dialogo.especie1)
Acn(cr:2, 0)
Acn(cr:1, 0)
Message('Reseteando Precio Fin de Posicion por Rescate ... ')
Sqladd("SELECT R.* FROM "~Dbo()~".POSICIONES R      ")
Sqladd("WHERE R.CantidadFin<> 0                    ")
Sqladd("AND   R.Especie  = '"~Val(er:1)~"'  ")
Sqladd("AND   R.Cupon    = '"~FStr(Val(c2), 1, 0)~"' ")
Sqladd("AND   R.NrSaldo  IN (172,171)              ")
if (Val(cr:2) = 1)
Sqladd("AND ( (R.PrecioReset  IS NULL) OR ")
Sqladd("      (R.PrecioReset  IS NOT NULL AND R.PrecioReset <> "~FStr(Val(cr:1), 0, 8)~")) ")
else
Sqladd("AND R.PrecioReset IS NOT NULL AND R.PrecioReset <> 0  ")
endif
Sqladd("AND   R.Fecha  <= '"~IdxDate(Val(fr:1))~"' ")
Sqladd(" AND R.Fecha IN (SELECT MAX(Fecha) from "~Dbo()~".POSICIONES ")
Sqladd("                   WHERE  Especie  = R.Especie  ")
Sqladd("                   AND    Vehiculo = R.Vehiculo ")
Sqladd("                   AND    NrSaldo  = R.NrSaldo  ")
Sqladd("                   AND    Cliente  = R.Cliente  ")
Sqladd("                   AND    Book     = R.Book     ")
Sqladd("                   AND   (R.Cupon    = Cupon    OR ((R.Cupon    IS NULL OR R.Cupon   ='' OR R.Cupon   =' ') AND (Cupon    IS NULL OR Cupon   ='' OR Cupon   =' ' )) )  ")
Sqladd("                   AND   (R.Sector   = Sector   OR ((R.Sector   IS NULL OR R.Sector  ='' OR R.Sector  =' ') AND (Sector   IS NULL OR Sector  ='' OR Sector  =' ' )) )  ")
Sqladd("                   AND   (R.CallPut  = CallPut  OR ((R.CallPut  IS NULL OR R.CallPut ='' OR R.CallPut =' ') AND (CallPut  IS NULL OR CallPut ='' OR CallPut =' ' )) )  ")
Sqladd("                   AND   (R.FechaEj  = FechaEj  OR ((R.FechaEj  IS NULL OR R.FechaEj ='' OR R.FechaEj =' ') AND (FechaEj  IS NULL OR FechaEj ='' OR FechaEj =' ' )) )  ")
Sqladd("                   AND   (R.PrecioEj = PrecioEj OR ((R.PrecioEj IS NULL OR R.PrecioEj='' OR R.PrecioEj=' ') AND (PrecioEj IS NULL OR PrecioEj='' OR PrecioEj=' ' )) )  ")
Sqladd("                   AND   Fecha       <= "~IdxDate2(Val(fr:1))~" ) ")
recorrer sql
if (Fbn()['Fecha'] = Val(fr:1))
Sqladd("UPDATE "~Dbo()~".POSICIONES ")
Sqladd("SET   PrecioReset = "~FStr(Val(cr:1), 0, 8)~" ")
Sqladd("WHERE Vehiculo    = '"~Fbn()['Vehiculo']~"' AND ")
Sqladd("      TipoNegocio = '"~Fbn()['TipoNegocio']~"' AND ")
Sqladd("      Cliente     = '"~Fbn()['Cliente']~"' AND ")
Sqladd("      Especie     = '"~Fbn()['Especie']~"' AND ")
Sqladd("      Cupon       = '"~Fbn()['Cupon']~"' AND ")
Sqladd("      NrSaldo     = "~FStr(Fbn()['NrSaldo'], 0, 0)~"  AND ")
Sqladd("      Book        = '"~Fbn()['Book']~"'             AND ")
Sqladd("      Fecha       = '"~IdxDate(Val(fr:1))~"' AND ")
Sqladd("      IsNull(Unidad,'') = '"~Fbn()['Unidad']~"'     AND ")
Sqladd("      IsNull(Centro,'') = '"~Fbn()['Centro']~"'     AND ")
Sqladd("      IsNull(Sector,'') = '"~Fbn()['Sector']~"'     AND ")
Sqladd("      IsNull(Sucursal,'') = '"~Fbn()['Sucursal']~"' AND ")
Sqladd("      IsNull(CallPut,'') = '"~Fbn()['CallPut']~"'   AND ")
Sqladd("      IsNull(Estrategia,'') = '"~Fbn()['Estrategia']~"' AND ")
Sqladd("      IsNull(Cartera,'') = '"~Fbn()['Cartera']~"'       AND ")
Sqladd("      IsNull(Trader,'') = '"~Fbn()['Trader']~"'         AND ")
Sqladd("      IsNull(Responsable,'') = '"~Fbn()['Responsable']~"'   AND ")
Sqladd("      IsNull(TipoPosicion,'') = '"~Fbn()['TipoPosicion']~"' AND ")
Sqladd("      IsNull(Producto,'') = '"~Fbn()['Producto']~"'         AND ")
Sqladd("      IsNull(GrupoEspecie,'') = '"~Fbn()['GrupoEspecie']~"' AND ")
Sqladd("      IsNull(CarteraBCRA,'') = '"~Fbn()['CarteraBCRA']~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT "~Dbo()~".POSICIONES ( ")
Sqladd("Fecha, Cliente, Vehiculo, Unidad, Centro, ")
Sqladd("Sector, Sucursal, NrSaldo, Especie, PrecioEj, ")
Sqladd("FechaEj, CallPut, Precio1, Precio2, ValorUSD, ")
Sqladd("ValorARP, Estrategia, Cartera, Book, Trader, ")
Sqladd("TipoNegocio, Cantidad1, Cantidad2, Cantidad3, Cantidad4, ")
Sqladd("Cantidad5, Precio3, Precio4, Precio5, CantidadIni, ")
Sqladd("PrecioIni, CantidadFin, PrecioFin, Cupon, Responsable, ")
Sqladd("TipoPosicion, Producto, GrupoEspecie, CarteraBCRA, ")
Sqladd("PrecioHist, PrecioReset) ")
Sqladd("Values ( ")
Sqladd("'"~IdxDate(Val(fr:1))~"', '"~Fbn()['Cliente']~"', '"~Fbn()['Vehiculo']~"', '"~Fbn()['Unidad']~"', '"~Fbn()['Centro']~"', ")
Sqladd("   '"~Fbn()['Sector']~"', '"~Fbn()['Sucursal']~"', "~FStr(Fbn()['NrSaldo'], 0, 0)~", '"~Fbn()['Especie']~"', ")
Sqladd("NULL, ")
Sqladd("NULL, ")
Sqladd("   '"~Fbn()['CallPut']~"', 0, 0, 0, ")
Sqladd("   0, '"~Fbn()['Estrategia']~"', '"~Fbn()['Cartera']~"', '"~Fbn()['Book']~"', '"~Fbn()['Trader']~"', ")
Sqladd("   '"~Fbn()['TipoNegocio']~"', 0, 0, 0, 0, ")
Sqladd("   0, 0, 0, 0, "~FStr(Fbn()['CantidadFin'], 0, 10)~", ")
Sqladd("   "~FStr(Fbn()['PrecioFin'], 0, 10)~", "~FStr(Fbn()['CantidadFin'], 0, 10)~", "~FStr(Fbn()['PrecioFin'], 0, 10)~", '"~Fbn()['Cupon']~"', '"~Fbn()['Responsable']~"', ")
Sqladd("   '"~Fbn()['TipoPosicion']~"', '"~Fbn()['Producto']~"', '"~Fbn()['GrupoEspecie']~"', '"~Fbn()['CarteraBCRA']~"', ")
Sqladd("   "~FStr(Fbn()['PrecioHist'], 0, 10)~", "~FStr(Val(cr:1), 0, 10)~") ")
Sqlnew()
Sqlexec()
endif

Sqladd("EXEC "~Dbo()~".RecalculaPosiciones ")
Sqladd(IdxDate2(Val(fr:1))~", ")
Sqladd(" '"~Fbn()['Cliente']~"', ")
Sqladd(" '"~Fbn()['Vehiculo']~"', ")
Sqladd(" '"~Fbn()['Unidad']~"', ")
Sqladd(" '"~Fbn()['Centro']~"', ")
Sqladd(" '"~Fbn()['Sector']~"', ")
Sqladd(" '"~Fbn()['Sucursal']~"', ")
Sqladd(" "~FStr(Fbn()['NrSaldo'], 3, 0)~", ")
Sqladd(" '"~Fbn()['Especie']~"', ")
Sqladd(" NULL,")
Sqladd(" NULL,")
Sqladd(" '"~Fbn()['CallPut']~"', ")
Sqladd(" '"~Fbn()['Cupon']~"', ")
Sqladd(" '"~Fbn()['Estrategia']~"', ")
Sqladd(" '"~Fbn()['Cartera']~"', ")
Sqladd(" '"~Fbn()['Book']~"', ")
Sqladd(" '"~Fbn()['Trader']~"', ")
Sqladd(" '"~Fbn()['TipoNegocio']~"', ")
Sqladd(" '"~Fbn()['Responsable']~"', ")
Sqladd(" '"~Fbn()['TipoPosicion']~"', ")
Sqladd(" '"~Fbn()['Producto']~"', ")
Sqladd(" '"~Fbn()['GrupoEspecie']~"', ")
Sqladd(" '"~Fbn()['CarteraBCRA']~"' ")
Sqlnew()
Sqlexec()
proximo


endif


