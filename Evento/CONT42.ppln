sql.add("select DISTINCT O.FechaOp, O.NrOperacion, O.Cantidad, O.Especie, O.Vehiculo1, O.Cliente1, O.TipoOp ")
sql.add("  from "~Dbo()~".BOPERACIONES O ")
sql.add("where CONVERT (Char(10), O.FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' and TipoOp in ('FCS','FCR')")
sql.add("  order by O.NrOperacion ")
Acd(f:2, dialogo.fecha1)
Watch(sql.batch)
recorrer sql
Acn(ca:99, Fbn('Cantidad'))
Act(es:99, Fbn('Especie'))
Act(ve:99, Fbn('Vehiculo1'))
Act(cl:99, Fbn('Cliente1'))
Acd(fo:99, Fbn('FechaOp'))
Acd(fe:99, Habiles(Fbn('FechaOp'), -2, 'ARG'))
Acd(fa:99, Habiles(dialogo.fecha1, -1, 'ARG'))
if (Eqstr(Fbn('TipoOp'), 'FCS') o Eqstr(Fbn('TipoOp'), 'FCR'))
Acd(f:1, Habiles(Fbn('FechaOp'), 2, 'ARG'))
if (DifDias(Val(f:1), Val(f:2)) <= 0)
recorrer&j Val(f:1), dialogo.fecha1
if (EsHabil(&j, 'ARG'))
Acn(rs:1, 0)
Acn(ll:1, CotizacionC(Fbn('Especie'), null, null, null, Habiles(&j, -2, 'ARG'), 1, SI, BuscarCampo('Especies', 'Cotiza', 'Codigo', Fbn('Especie'))))
Acn(mm:1, CotizacionC(Fbn('Especie'), null, null, null, Habiles(&j, -1, 'ARG'), 1, SI, BuscarCampo('Especies', 'Cotiza', 'Codigo', Fbn('Especie'))))
Acn(nn:1, Val(mm1) - Val(ll1))
Act(r:1, Var('TIASDICAFO'))
Acd(fv:1, &j)
if (Val(fv:1) >= Fecha(Var('FECHAMIGRA')))
sql.add(" Select MA.Codigo ")
sql.add(" From "~Dbo()~".MODELOSASIENTO MA ")
sql.add(" Where MA.TipoAsiento IN ("~pipe2comillas(Val(r:1))~") ")
recorrer sql
Dfa()
Act(md:1, Fbn('Codigo'))
Acn(rs:1, Val(ca:99) * Val(nn:1))
sql.add(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, V.Valor1, V.Valor2, E.Cotiza Moneda, ")
sql.add(" C.Codigo Cliente1, '' Observaciones, V.Codigo Vehiculo1, '"~Val(md:1)~"' CodAsi, 'RXTFCI' NrOperacion ")
sql.add(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V, "~Dbo()~".CLIENTES C ")
sql.add(" Where E.Codigo = '"~Val(es:99)~"' ")
sql.add(" AND V.Codigo = '"~Val(ve:99)~"' ")
sql.add(" AND C.Codigo = '"~Val(cl:99)~"' ")
recorrer sql
Dfa()
let(&modelocontable, Val(md:1))
sql.generarasientoop(Val(md:1), '', '', '', 810, Val(fv:1), Val(ve:99), null, null, null, null, null, null, null, null, null, null, null, SI, FSys(), Val(fo:99))
sql.exec
