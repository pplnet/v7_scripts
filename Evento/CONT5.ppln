if (not ok)
Raise('Evento Cancelado')
endif

Message('--- Asientos de Revaluo Pendientes de liquidacion Moneda Extranjera ---')
Act(ta:1, Var('TIPASIREVM'))
Act(ml:1, Var('MONELOCA'))
Acn(na:1, Var('ASINUM'))
