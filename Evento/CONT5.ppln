Watch(Sqlbatch())
Acn(xx:2, 0)
Acn(xx:1, 0)
recorrer sql
if (Fbn('Tipo') = 1)
Acd(fe:2, Habiles(Fbn('FechaOp'), 1, 'ARG'))
if (Fbn('FechaMov') > dialogo.fecha1)
Acd(fe:3, dialogo.fecha1)
else 
Acd(fe:3, Fbn('FechaMov'))
endif
recorrer&i Val(fe:2), Val(fe:3)
if (&i > Val(fe:1))
if (EsHabil(&i, Var('FERIDEF')))
Acd(xy:1, &i)
Acd(xy:2, Habiles(&i, -1, 'ARG'))
Acn(xz:1, CotizacionC(Fbn('ContraEspecie'), 'CON', null, null, Val(xy:1), 25, null, Val(ml:1)))
Acn(xz:2, CotizacionC(Fbn('ContraEspecie'), 'CON', null, null, Val(xy:2), 25, null, Val(ml:1)))
Acn(re:1, Fbn('Cantidad') * (Val(xz:1) - Val(xz:2)))
Acd(fv:1, &i)
Acd(fd:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, Fbn('TipoOp'))
Act(nr:1, Fbn('NrOperacion'))
Act(nr:2, '')
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
endif
endif
proximo
else 
Acd(xy:1, dialogo.fecha1)
