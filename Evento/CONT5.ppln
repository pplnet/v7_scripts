if (dialogo.radio1 = 0 o dialogo.radio1 = 4)
Sqladd("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
Sqladd(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
Sqladd("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante ")
Sqladd("FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CLIENTES C ")
Sqladd("WHERE MA.TipoAsiento = '"~Val(ta:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
Sqladd("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
Sqladd("AND FechaCargaSys = "~IdxDate2(dialogo.fecha1)~" AND FechaOp < "~IdxDate2(dialogo.fecha1)~" AND ContraEspecie <> '"~Val(ml:1)~"' ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
Sqladd(" AND O.FechaVto > O.FechaOp ")
Sqladd("UNION ")
Sqladd("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
