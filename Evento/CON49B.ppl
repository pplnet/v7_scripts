***---Este evento toma las posiciones de especies que no son de irsa. Para bonos propios se va a crear un nuevo NrSaldo de posicion, y se contabiliza en otro evento, para que se haga por book. Ver Pago de dividendos de esos bonos.

MostrarCuadroDeMensajes
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:   'Fecha'    ; 1; ;;;;;;;fsys
  Especie1: 'Especie'  ; 1;2;;;;;;;'LLL15'
  Lista1:   'Vehiculos'; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Resultados por Tenencia ---')

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
ACN(x3, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))

if Val(x1)=1
  ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
  ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
if Dialogo.Fecha1<>Val(x2)
  Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
endif

ACD(v:1, Dialogo.Fecha1)
***---ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:2, FinDeMes(PriDeMes(Dialogo.Fecha1,SI)-1, NO))
***---ACD(v:3, Habiles(PriDeMes(Val(v:2)),-1,'ARG'))
ACD(v:3, FinDeMes(PriDeMes(Val(V:2),SI)-1, NO))
ACT(y:1, Dialogo.Lista1)
ACT(y:2, '101,102')

***---V2 = 31/12
***---V3 = 30/11

***---Moneda Grupo
ACT(ME:1, Var('MONEEXTR'))
***---Moneda Fuerte
ACT(ML:1, Var('MONELOCA'))
***---Moneda Uruguay
ACT(MU:1, Var('MONEURU'))

SetFilaActual(1)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Cupon')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'TipoNegocio')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'CantidadFin')
ACT(j:FAC, 'PrecioFin')
ACT(k:FAC, 'Cotiza')
ACT(l:FAC, 'Cot.Mes Ant')
ACT(m:FAC, 'Cot.Actual')
ACT(n:FAC, 'Dif.Cotiz.')
ACT(o:FAC, 'Res.Saldo Ant.')
ACT(p:FAC, 'Res.Operac.')
ACT(q:FAC, 'Res.TOTAL')
ACT(r:FAC, 'Tipos Asi')
ACT(S:fac, 'ContraEsp')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Nombre')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'NrSaldo')
ACT(ae:FAC, 'TipoNegocio')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'FechaMov')
ACT(ai:FAC, 'Cantidad')
ACT(aj:FAC, 'Precio')
ACT(ak:FAC, 'Cotiza')
ACT(al:FAC, 'Cotizacion')
ACT(am:FAC, 'Dif.Cotiz.')
ACT(an:FAC, 'Resultado')
ACT(ao:FAC, 'Linea')
ACT(ap:FAC, 'NrOperacion')
ACT(aq:FAC, 'TipoOp')
ACT(ar:FAC, 'FechaOp')
ACT(AS:fac, 'ContraEsp')


********************************
*** Posiciones al inicio del Mes
********************************

SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       P.CantidadFin as Cantidad, P.Book, ")
SQL.ADD("       P.CantidadFin*P.PFRME as Monto, '' Observaciones, '' Cliente1, P.Vehiculo Vehiculo, E.Alias8 ")
SQL.ADD(" from  "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD("   and P.NrSaldo     = 3 ")
SQL.ADD("   and P.TipoNegocio = 'SEC' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and P.Especie     = '"~Dialogo.Especie1~"' ")
endif
***---SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha = '"~IdxDate(Val(V:3))~"' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND P.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" AND  P.Vehiculo IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
SQL.ADD(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
SQL.ADD(" order by P.Especie, P.Cupon ")

Recorrer SQL
   ACT(a:FAC, FBN('Especie'))
   ACT(b:FAC, FBN('Nombre'))
*  ACT(c:FAC, FBN('Cupon'))
   ACN(d:FAC, FBN('NrSaldo'))
   ACT(e:FAC, FBN('TipoNegocio'))
   ACT(f:FAC, FBN('Vehiculo'))
*  ACT(g:FAC, FBN('Book'))
*  ACD(h:FAC, FBN('Fecha'))
   ACN(i:FAC, FBN('Cantidad'))
*  ACN(j:FAC, FBN('PrecioFin'))
   ***---ACN(i:FAC, FBN('Cantidad'))
   ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
   ACT(k:FAC, FBN('Cotiza'))
   ACN(l:FAC, CotizacionC(FBN('Especie'),,,,Val(v:3),1,SI,FBN('Cotiza')))
   ACN(m:FAC, CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
   ACN(n:FAC, Val(m:FAC)-Val(l:FAC))
   ACN(o:FAC, Val(i:FAC)*Val(n:FAC))
*  ACN(PS:fac, fbn('CantidadFin'))
   ***---Busco Cupon anterior al vigente a fin de mes
   ACN(CP:fac, SQL(" Select Min(CAST(NrCupon as INT)) From "~DBO~".AGENDACUPONES Where Especie = '"~fbn('Especie')~"' AND FechaCorte >= '"~IdxDate(Val(V:2))~"' ") - 1)
   ***---Fecha Corte cupon anterior
   ACD(FE:fac, SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~fbn('Especie')~"' AND NrCupon = '"~Fstr(Val(CP:fac), 0, 0)~"' "))
   ***---Fecha Desde para intereses
   IF Val(FE:fac) > Val(V:3)
      ACD(FD:fac, Val(FE:fac))
   ELSE
      ACD(FD:fac, Val(V:3))
   ENDIF
   ***---Intereses a Fin de Mes
   ACN(IP:fac, SQL(" Select Intereses From "~DBO~".INTERESESCORRIDOS Where Especie = '"~fbn('Especie')~"' AND Fecha = '"~IdxDate(Val(V:2))~"' "))
   ***---Intereses a Fecha anterior
   ACN(IQ:fac, SQL(" Select Intereses From "~DBO~".INTERESESCORRIDOS Where Especie = '"~fbn('Especie')~"' AND Fecha = '"~IdxDate(Val(FD:fac))~"' "))
   ***---Intereses del periodo
   ACN(IR:fac, Val(IP:fac) - Val(IQ:fac))
   ***---Intereses de la Posicion
   ACN(DB:fac, Val(I:fac) * Val(IR:fac))
   ***---Operacion Activa 1=SI
   ACN(AP:1, 1)
   ***---Moneda Local De vehiculo
   ACT(AL:88, BuscarCampo('VEHICULOS','Alias4','Codigo', Val(F:fac)))

   ***/// DC Capital de la Posicion
   ***---Monto = Posicion (Se valoriza a 1)
   ACN(MO:55, Val(I:fac))
   ***---Fecha Desde
   ACD(FD:55, Val(V:3))
   ***---Fecha Hasta
   ACD(FH:55, Val(V:2))
   ***---Moneda Monto
   ACT(MO:88, Val(K:fac))
   (.'DCDIARIA'.)
   SCN(DM:fac, Val(DK:55))
   SCN(DO:fac, Val(DK:66))
   SCN(DQ:fac, Val(DK:77))

   ***/// Interes al inicio
   ACN(JJ:1, Val(IQ:fac))

   ***---DC Intereses de la Posicion
   ACN(BD:55, 0)
   SQL.ADD(" Select Fecha, Intereses ")
   SQL.ADD(" From "~DBO~".INTERESESCORRIDOS ")
   SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND Fecha > '"~IdxDate(Val(FD:fac))~"' ")
   SQL.ADD(" AND Fecha <= '"~IdxDate(Val(V:2))~"' ")
   SQL.ADD(" Order By Fecha ")
   Recorrer SQL
      DFA
      ***// Interes de ese dia
      ACN(JJ:2, Val(I:fac)*(FBN('Intereses')-Val(JJ:1)))
      ***/// Calculo de Interes con cotizacion diaria
      IF Eqstr(Val(MO:88), Val(ME:1))
          SCN(IX:fac, Val(JJ:2) * CotizacionBNA(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          IF Eqstr(Val(AL:88), Val(ML:1))
             SCN(IY:fac, Val(JJ:2) * CotizacionBNA(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          ELSE
             SCN(IY:fac, Val(JJ:2) * CotizacionBCU(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          ENDIF
          SCN(IZ:fac, Val(JJ:2))
       ELSE
          IF Eqstr(Val(MO:88), Val(ML:1))
             SCN(IX:fac, Val(JJ:2))
             IF Eqstr(Val(AL:88), Val(ML:1))
                SCN(IY:fac, Val(JJ:2))
             ELSE
                SCN(IY:fac, Val(JJ:2) * CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
             ENDIF
             SCN(iZ:fac, Val(JJ:2) / CotizacionBNA(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
          ELSE
             IF Eqstr(Val(MO:88), Val(MU:1))    
                SCN(IX:fac, Val(JJ:2) / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                IF Eqstr(Val(AL:88), Val(ML:1))
                   SCN(IY:fac, Val(JJ:2) / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                ELSE
                   SCN(IY:fac, Val(JJ:2))
                ENDIF
                SCN(IZ:fac, Val(JJ:2) / CotizacionBCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
             ENDIF
          ENDIF
       ENDIF

       IF Val(BD:55) = 1
          ***---Hay DC desde el segundo dia que devenga, por el monto acumulado al dia anterior que se procesa
          ***---Parametros Funcion
          ***---Monto
          ACN(MO:55, Val(IA:fac))
          ***---Fecha Desde
          ACD(FD:55, Val(FA:fac))
          ***---Fecha Hasta
          ACD(FH:55, fbn('Fecha'))
          ***---Moneda Monto
          ACT(MO:88, Val(K:fac))
          (.'DCDIARIA'.)
          SCN(DH:fac, Val(DK:55))
          SCN(DJ:fac, Val(DK:66))
          SCN(DL:fac, Val(DK:77))
       ENDIF
       ACN(JJ:1, FBN('Intereses'))
       ***---Interes dia anterior = Posicion * (int acumulado ayer - int acumulado al inicio)
       ACN(IA:fac, Val(I:fac) * (fbn('Intereses') - Val(IQ:fac)))
       ***---Fecha dia anterior
       ACN(FA:fac, fbn('Fecha'))
       ACN(BD:55, 1)
   Proximo
Proximo

**MessageBox('DC ARP')
**MessageBox(Val(DH:fac))
**MessageBox('Interes')
**MessageBox(Val(IZ:fac))



********************************
*** Posiciones del Mes
********************************

ACN(w:1, 1)
SQL.ADD("select M.FechaMov,    M.Vehiculo Cliente, M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.PrecioClean Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
SQL.ADD("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8, O.FechaVto ")
SQL.ADD("  from "~DBO~".MOVPOSEJE2 M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
SQL.ADD(" where M.NrSaldo  = 3 ")
SQL.ADD(" AND V.Codigo = M.Vehiculo ")
SQL.ADD("   and M.TipoNegocio = 'SEC' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and M.Especie    = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
***---Bonos Propios
SQL.ADD(" AND E.Issuer = M.Vehiculo ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
SQL.ADD(" AND  O.Vehiculo1    IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
SQL.ADD(" order by M.Especie, M.Cupon ")

Recorrer SQL
   DFA
   SCN(w:1,1)
   ACN(w:2,0)
   ***/// Busca si esa especie ya tenia posiciones
   if FAC>1
     recorrer&i 2,FAC
       if EqStr(FBN('Especie'),Val(a:&i))
         ACN(w:2, &i)
         Break
       endif
     proximo
   endif
   if Val(w:2)=0
     IFA
     ACT(a:FAC, FBN('Especie'))
     ACT(b:FAC, FBN('Nombre'))
 *    ACT(c:FAC, FBN('Cupon'))
     ACN(d:FAC, FBN('NrSaldo'))
     ACT(e:FAC, FBN('TipoNegocio'))
     ACT(f:FAC, FBN('Vehiculo'))
     ACT(g:FAC, FBN('Book'))
     ACN(w:2, FAC)
   endif 

   ACT(aa:Val(w:1), FBN('Especie'))
   ACT(ab:Val(w:1), FBN('Nombre'))
   ACT(ac:Val(w:1), FBN('Cupon'))
   ACN(ad:Val(w:1), FBN('NrSaldo'))
   ACT(ae:Val(w:1), FBN('TipoNegocio'))
   ACT(af:Val(w:1), FBN('Vehiculo'))
   ACT(ag:Val(w:1), FBN('Book'))
   ACD(ah:Val(w:1), FBN('FechaMov'))
   ACN(ai:Val(w:1), FBN('Cantidad'))
   IF Eqstr(fbn('Cotiza'), fbn('ContraEspecie'))
       ACN(aj:Val(w:1), FBN('Precio'))
   ELSE
       ACT(MD:2, SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie1 = '"~fbn('Cotiza')~"' AND Especie2 = '"~fbn('ContraEspecie')~"' "))
       ***---ACN(AJ:Val(W:1), IIF(Eqstr(Val(MD:2), 'INV'), fbn('Precio') / fbn('CotOp'), fbn('Precio') * fbn('CotOp')))
       ***---ACN(AJ:Val(W:1), IIF(Eqstr(Val(MD:2), 'INV'), fbn('Precio') * fbn('CotOp'), fbn('Precio') / fbn('CotOp')))
       ***---En la carga de operaciones se ingresa la cotizacion de cotiza en contraespecie.
       IF Eqstr(fbn('ContraEspecie'), Var('MONELOCA')) O Eqstr(fbn('Cotiza'), Var('MONELOCA'))
           ACN(AJ:Val(W:1), fbn('Precio') / fbn('CotOp'))
       ELSE
           ACN(AJ:Val(W:1), fbn('Precio') * fbn('CotOp'))
       ENDIF
   ENDIF
   ACT(ak:Val(w:1), FBN('Cotiza'))
   ACN(al:Val(w:1), CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
   ACN(am:Val(w:1), Val(al:Val(w:1))-Val(aj:Val(w:1)))
   ACN(an:Val(w:1), Val(ai:Val(w:1))*Val(am:Val(w:1)))
   ACN(ao:Val(w:1), Val(w:2))
   ACT(ap:Val(w:1), FBN('NrOperacion'))
   ACT(aq:Val(w:1), FBN('TipoOp'))
   ACD(ar:Val(w:1), FBN('FechaOp'))
   ACT(AS:Val(w:1), fbn('ContraEspecie'))
   ACN(AT:Val(w:1), fbn('CotOp'))
   SCN(p:Val(w:2), Val(an:Val(w:1)))
   ***---Fecha Corte cupon siguiente
   ACD(FE:Val(W:2), SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~fbn('Especie')~"' AND NrCupon = '"~Fstr(fbn('Cupon')+1, 0, 0)~"' "))
   ***---Fecha Desde para intereses
   IF Val(FE:Val(W:2)) < Val(V:2)
      ACD(FD:Val(W:2), Val(FE:Val(W:2)))
   ELSE
      ACD(FD:Val(W:2), fbn('FechaVto'))
   ENDIF
   ***---Intereses a Fin de Mes
   ACN(IP:Val(W:2), SQL(" Select Intereses From "~DBO~".INTERESESCORRIDOS Where Especie = '"~fbn('Especie')~"' AND Fecha = '"~IdxDate(Val(V:2))~"' "))
   ***---Intereses a Fecha Desde
   ACN(IQ:Val(W:2), SQL(" Select Intereses From "~DBO~".INTERESESCORRIDOS Where Especie = '"~fbn('Especie')~"' AND Fecha = '"~IdxDate(Val(FD:Val(W:2)))~"' "))
   ***---Intereses del periodo
   ACN(IR:Val(W:2), Val(IP:Val(W:2)) - Val(IQ:Val(W:2)))
   ***---Intereses de la posicion
   SCN(DB:Val(W:2), Val(AI:Val(W:1)) * Val(IR:Val(W:2)))
   ***---Operacion Activa 1=SI
   ACN(AP:1, 1)
   ***---Moneda Local De vehiculo
   ACT(AL:88, BuscarCampo('VEHICULOS','Alias4','Codigo', Val(F:fac)))

   ***/// DC Capital de la Posicion
   ***---Monto = Posicion (Se valoriza a 1)
   ACN(MO:55, Val(AI:Val(W:1)))
   ***---Fecha Desde
   ACD(FD:55, Val(V:3))
   ***---Fecha Hasta
   ACD(FH:55, Val(V:2))
   ***---Moneda Monto
   ACT(MO:88, Val(AK:Val(W:1)))
   (.'DCDIARIA'.)
   SCN(DM:Val(W:2), Val(DK:55))
   SCN(DO:Val(W:2), Val(DK:66))
   SCN(DQ:Val(W:2), Val(DK:77))

   ***/// Interes al inicio
   ACN(JJ:1, Val(IQ:Val(W:2)))
   ***---DC Intereses de la Posicion
   ACN(BD:55, 0)
   SQL.ADD(" Select Fecha, Intereses ")
   SQL.ADD(" From "~DBO~".INTERESESCORRIDOS ")
   SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND Fecha > '"~IdxDate(Val(FD:Val(W:2)))~"' ")
   SQL.ADD(" AND Fecha <= '"~IdxDate(Val(V:2))~"' ")
   SQL.ADD(" Order By Fecha ")
   Recorrer SQL
      DFA
      ***// Interes de ese dia
      ACN(JJ:2, Val(AI:Val(W:1))*(FBN('Intereses')-Val(JJ:1)))
      ***/// Calculo de Interes con cotizacion diaria
      IF Eqstr(Val(MO:88), Val(ME:1))
          SCN(IX:fac, Val(JJ:2) * CotizacionBNA(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          IF Eqstr(Val(AL:88), Val(ML:1))
             SCN(IY:fac, Val(JJ:2) * CotizacionBNA(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          ELSE
             SCN(IY:fac, Val(JJ:2) * CotizacionBCU(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
          ENDIF
          SCN(IZ:fac, Val(JJ:2))
       ELSE
          IF Eqstr(Val(MO:88), Val(ML:1))
             SCN(IX:fac, Val(JJ:2))
             IF Eqstr(Val(AL:88), Val(ML:1))
                SCN(IY:fac, Val(JJ:2))
             ELSE
                SCN(IY:fac, Val(JJ:2) * CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
             ENDIF
             SCN(iZ:fac, Val(JJ:2) / CotizacionBNA(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
          ELSE
             IF Eqstr(Val(MO:88), Val(MU:1))    
                SCN(IX:fac, Val(JJ:2) / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                IF Eqstr(Val(AL:88), Val(ML:1))
                   SCN(IY:fac, Val(JJ:2) / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                ELSE
                   SCN(IY:fac, Val(JJ:2))
                ENDIF
                SCN(IZ:fac, Val(JJ:2) / CotizacionBCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
             ENDIF
          ENDIF
       ENDIF

       IF Val(BD:55) = 1
          ***---Hay DC desde el segundo dia que devenga, por el monto acumulado al dia anterior que se procesa
          ***---Parametros Funcion
          ***---Monto
          ACN(MO:55, Val(IA:Val(W:2)))
          ***---Fecha Desde
          ACD(FD:55, Val(FA:Val(W:2)))
          ***---Fecha Hasta
          ACD(FH:55, fbn('Fecha'))
          ***---Moneda Monto
          ACT(MO:88, Val(AK:Val(W:1)))
          (.'DCDIARIA'.)
          SCN(DH:Val(W:2), Val(DK:55))
          SCN(DJ:Val(W:2), Val(DK:66))
          SCN(DL:Val(W:2), Val(DK:77))
       ENDIF
       ACN(JJ:1, FBN('Intereses'))
       ***---Interes dia anterior = Posicion * (int acumulado ayer - int acumulado al inicio)
       ACN(IA:Val(W:2), Val(AI:Val(W:1)) * (fbn('Intereses') - Val(IQ:Val(W:2))))
       ***---Fecha dia anterior
       ACN(FA:Val(W:2), fbn('Fecha'))
       ACN(BD:55, 1)
   Proximo
Proximo

**MessageBox('DC CAP ARP')
**MessageBox(Val(DM:fac))
**MessageBox('DC INT ARP')
**MessageBox(Val(DH:fac))
**MessageBox('Interes')
**MessageBox(Val(Iz:fac))


********************************
*** Generacion de Asientos
********************************

if FAC>1
   recorrer&i 2,FAC
      ACN(q:&i, Val(o:&i)+Val(p:&i))
      ACN(RS:1, Val(Q:&i))
      ***---Aca sumo DC e Intereses para la especie    
      ***---Busco si hubieron pagos de cupones durante el mes
      ***---SQL.ADD(" Select Sum(T.Cantidad2) Monto, T.TipoTr2 From "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
      ***---SQL.ADD(" Where E.Alias3 = T.Especie ")
      ***---SQL.ADD(" AND TipoTr2 IN ('CCUPON','PCUPON') ")
      ***---SQL.ADD(" AND E.Codigo = '"~Val(A:&i)~"' ")
      ***---SQL.ADD(" AND T.Vehiculo1 = '"~Val(F:&i)~"' ")
      ***---SQL.ADD(" AND T.Fecha1 >  '"~IdxDate(Val(V:3))~"' ")
      ***---SQL.ADD(" AND T.Fecha1 <=  '"~IdxDate(Val(V:2))~"' ")
      ***---No se toman los cobros de zero cupon ya que el resultado es la diferencia de precios.
      ***---SQL.ADD(" AND (ZeroCoupon <> 'SI' OR ZeroCoupon = '' OR ZeroCoupon = null) ")
      ***---SQL.ADD(" Group By T.TipoTr2 ")
      ***---Recorrer SQL
        ***---IF Eqstr(fbn('TipoTr2'), 'CCUPON')
            ***---SCN(RS:1, fbn('Monto'))
        ***---ELSE
            ***---SCN(RS:1, -fbn('Monto'))
        ***---ENDIF
      ***---Proximo
      ACN(CT:1, Val(AI:&i))
      ACT(r:&i, Var('TIPASITEBP'))
      SQL.ADD("select MA.Codigo ")
      SQL.ADD("  from "~DBO~".MODELOSASIENTO MA ")
      SQL.ADD(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
      Recorrer SQL    
         DFA
         Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
         ACD(FV:1, Val(V:2))
         ACT(VH:1, Val(F:&i))
         (.'FECHAVALOR'.)
         ACT(MD:1, fbn('Codigo'))

         ***/// Datos del modelo
         ACN(CR:1, 0)
         ACN(DN:1, 0)      
         ACN(DN:2, 0)
         ACN(DN:3, 0)
         ACN(DK:1, VAL(DM:&i))      
         ACN(DK:2, VAL(DO:&i))
         ACN(DK:3, VAL(DQ:&i))
         ACN(IT:1, VAL(IX:&i))      
         ACN(IT:2, VAL(IY:&i))
         ACN(IT:3, VAL(IZ:&i))
         ACN(DI:1, VAL(DH:&i))      
         ACN(DI:2, VAL(DJ:&i))
         ACN(DI:3, VAL(DL:&i))
         ACN(DV:1, VAL(DB:&i))
         SQL.ADD(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
         SQL.ADD(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, '' Cliente1, V.Codigo Vehiculo1, ")
         SQL.ADD(" "~Fstr(Abs(Val(CT:1)), 0, 0)~" Cantidad, E.Alias8, V.Alias4, 'MMONM' TipoOp, E.Issuer, ")
         SQL.ADD("'"~Val(MD:1)~"' CodAsi, '' NrOperacion, E.Issuer Cliente1")
         SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
         SQL.ADD(" Where E.Codigo = '"~Val(A:&i)~"' ")
         SQL.ADD(" AND V.Codigo = '"~Val(F:&i)~"' ")
         Recorrer SQL
            DFA
            ACN(CK:1, 0)
            IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
               ACN(CK:1, 1)
               IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~fbn('Especie')~"' AND A.Modelo = '"~Val(MD:1)~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(V:2))~"' AND A.Vehiculo = '"~Val(F:&i)~"' "))
                  ACN(CK:1, 0)
               ENDIF
            ENDIF
            ACT(EM:1, fbn('Issuer'))
            ACT(VH:11, fbn('Vehiculo'))
            IF Val(CK:1) = 0
                SQL.GenerarAsientoOp(Val(MD:1), '','','',810,Val(FV:1),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
                SQL.EXEC
            ENDIF
         Proximo
      Proximo
   Proximo
Endif

