sql.add(" AND   O.Especie  <> '"~Val(ml:1)~"' ")
sql.add(" and   M.TipoAsiento IN ("~pipe2comillas(Var('TIASDICAPF'))~") ")
if (NoVacio(dialogo.listatabla1))
