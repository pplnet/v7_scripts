Acn(id:1, sql(" Select Sum(Monto) From "~Dbo()~".MOVDEVENGADOS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND TipoDevengado = 'INTLEN' AND Fecha >= '"~IdxDate(Val(fe:1))~"' "))
Acn(rs:1, 0)
