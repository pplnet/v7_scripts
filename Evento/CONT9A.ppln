Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Acn(rs:1, 0)
Acn(rs:2, 0)
Acn(ct:1, CotizacionBNA(Fbn('Especie'), Val(v:2), 1, NO, NO))
if (Val(v:3) > Fbn('FechaOp'))
Acn(ct:2, CotizacionBNA(Fbn('Especie'), Val(v:3), 1, NO, NO))
else
Acn(ct:2, CotizacionBNA(Fbn('Especie'), Fbn('FechaOp'), 1, NO, NO))
endif
sql.add(" Select Sum(Cantidad1) Capital, Sum(Cantidad3) Interes ")
sql.add(" From "~Dbo()~".CUOTAS ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.add(" AND Fecha2 >= '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Dfa()
Acn(cp:1, Fbn('Capital'))
Acn(it:1, Fbn('Interes'))
proximo
Acn(rs:1, Val(cp:1) * (Val(ct:1) - Val(ct:2)))
Acn(rs:2, Val(it:1) * (Val(ct:1) - Val(ct:2)))
Acn(ct:3, Val(ct:1))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
sql.generarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
