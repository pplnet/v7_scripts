creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO');'Debe Ingresar una Especie Valida';NO;
fecha1:'Record_Date';1;2;;;;dialogo.fecha1 <> 0;'Debe Ingresar una Fecha valida ';NO;FSys()
fecha2:'Fecha_Pago';3;2;;;;dialogo.fecha2 <> 0 y dialogo.fecha2 >= dialogo.fecha1;'Debe Ingresar una Fecha valida ';NO;FSys()
cliente1:'Cliente';3;1;;;;(Vacio(dialogo.cliente1)) o (Eqstr(BuscarCampo('CLIENTES', 'CategDepositante', 'Codigo', dialogo.cliente1), 'CLI') y Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente1), 'HAB') y not Eqstr(BuscarCampo('CLIENTES', 'BloqueoFondos', 'Codigo', dialogo.cliente1), 'SI'));'Cliente Invalido';NO;;;;;;" CategDepositante='CLI' AND Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) ";
mercado1:'Mercado';5;2;;;;
operador1:'Operador';5;1;;NO;;NoVacio(dialogo.operador1);'Debe Ingresar el Operador';NO;UsuarioActivo()
vehiculo1:'Vehiculo';7;1;;;;NoVacio(dialogo.vehiculo1);'Debe Ingresar el vehiculo';NO;Var('VEHICULODE');
radio1:'Anular|Novedad|Confirmacion|Todos|';7;2;;;;;;;;2
findialogo

if (not ok)
Cancelar()
endif

Ejecutarevento('RESGLA', 'especie1', dialogo.especie1, 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha2, 'cliente1', dialogo.cliente1, 'mercado1', dialogo.mercado1, 'operador1', dialogo.operador1, 'vehiculo1', dialogo.vehiculo1, 'radio1', dialogo.radio1)
