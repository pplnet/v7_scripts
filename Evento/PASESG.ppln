Sqladd(" Select O.NrOperacion3, Sum(1) cuantas, min(TipoOp) Tipo, O.Vehiculo1, O.FechaOp, O.Especie ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B  ")
Sqladd(" where O.NrOperacion=B.NrOperacion and NrBit IN (10,70,80)  and Valor = '1' ")
Sqladd(" and   O.TipoOp in ('TIC','TIV','TIFC','TIFV')  ")
Sqladd(" and   O.NrOperacion3 is NOT NUll               ")
Sqladd(" and   O.PaseCB ='1' and O.CB5 ='1'             ")
Sqladd(" and (O.OperacionRef is  NUll OR O.OperacionRef = '' ) ")
Sqladd(" Group by O.NrOperacion3, O.Vehiculo1, O.FechaOp, O.Especie ")
recorrer sql
Message('Operaciones encontradas ... ')
if (Fbn('cuantas') = 2)
if (Eqstr(Fbn('Tipo'), 'TIC') o Eqstr(Fbn('Tipo'), 'TIFV'))
Act(tp1, 'TIPA')
else
Act(tp1, 'TIPP')
endif

Sqladd(" Select * From "~Dbo()~".OPERACIONES   ")
Sqladd(" WHERE TipoOp in ('TIC','TIV')       ")
Sqladd(" AND Vehiculo1 = '"~Fbn('Vehiculo1')~" '         ")
Sqladd(" AND NrOperacion3 = '"~Fbn('NrOperacion3')~"'    ")
Sqladd(" AND (OperacionRef is NUll OR OperacionRef = '') ")
Sqladd(" AND PaseCB ='1' and CB5 ='1'                    ")
Sqladd(" AND FechaOp  = "~IdxDate2(Fbn('FechaOp'))~"     ")
Sqladd(" AND Especie  = '"~Fbn('Especie')~"'             ")
recorrer sql
Act(nu1, getnumerador(1))
Message('Generando Pase '~Val(nu1)~' ... ')
Sqladd(" Insert Into "~Dbo()~".OPERACIONES ")
Sqladd(" ( FechaOp, Especie, Cliente1,DiasAnio, ")
Sqladd(" Cantidad, Precio1, Corredor, EnteCus1, ")
Sqladd(" Plazo, FechaVto, PorComision, ")
Sqladd(" ContraEspecie, FormaLiquidacion1, TotalIntereses, TotalDerechos, ")
Sqladd(" TotalNetoCli1, TotalBrutoCli1, Mercado, ")
Sqladd(" Operador, TablaFeriados1, Observaciones,Book1, ")
Sqladd(" TotalComisiones, PaseCB, OperacionRef, ")
Sqladd(" FechaPago, FormaLiquidacion2, FechaUltCupon, ")
Sqladd(" TasaInteresesCupon, PorImpuesto, TotalGanancias, ")
Sqladd(" PorArancel, TotalRetenciones, Cartera,Corporate,TasaBase, ")
Sqladd(" Vehiculo1, OpSIOPEL, CB5, CB6, CB7,Cupon1, RB10, ")
Sqladd(" NrOperacion, TipoCambio2, EsAforado, PorAforo, TotalCaucion, RB9, ")
Sqladd(" TipoOp, FechaCarga, FechaCargaSys")
Sqladd(", FechaAltaMAE, NroAltaMAE, AceptaMAE, FechaEnvioMAE,MB1, ")
Sqladd(" CanPosInv1, CanPosInv2, CanPosTrad, CanPosOSoc, Precio3, RB5 ")
Sqladd(" ) Values ( ")
Sqladd(" '"~IdxDate(Fbn()['FechaOp'])~"', '"~Fbn()['Especie']~"', '"~Fbn()['Cliente1']~"','1', ")
Sqladd(" "~FStr(Fbn('Cantidad'), 1, 2)~", "~FStr(Fbn('Precio1'), 1, 8)~", '0000', '"~Fbn()['EnteCus1']~"', ")
Sqladd(" "~FStr(DifDias(Fbn()['FechaOp'], Fbn()['FechaVto'], 'ARG', NO), 1, 0)~", '"~IdxDate(Fbn()['FechaVto'])~"', "~FStr(0, 1, 7)~", ")
Sqladd(" '"~Fbn()['ContraEspecie']~"',")
if (Eqstr(Fbn('Mercado'), 'CV'))
Sqladd(" '"~Fbn()['FormaLiquidacion1']~"',")
else
Sqladd(" '"~Fbn()['FormaLiquidacion2']~"',")
endif
Sqladd(" "~FStr(Fbn('TotalIntereses'), 1, 2)~", "~FStr(Fbn('TotalIntereses'), 1, 2)~", ")
Sqladd(" "~FStr(Fbn('TotalNetoCli1'), 1, 2)~", "~FStr(Fbn('TotalBrutoCli1'), 1, 2)~", '"~Fbn()['Mercado']~"', ")
Sqladd(" '"~Fbn()['Operador']~"', '"~Fbn()['TablaFeriados1']~"', '"~Fbn()['Observaciones']~"', '"~Fbn('Book1')~"',")
Sqladd(" "~FStr(0, 1, 2)~", '1', '"~Fbn()['NrOperacion']~"', ")
Sqladd(" '"~IdxDate(Fbn()['FechaVto'])~"', '"~Fbn()['FormaLiquidacion2']~"', '"~IdxDate(Fbn()['FechaUltCupon'])~"', ")
Sqladd(" "~FStr(Fbn()['Precio4'], 1, 6)~", "~FStr(Fbn()['PorImpuesto'], 1, 2)~", "~FStr(Fbn()['TotalGanancias'], 1, 2)~", ")
Sqladd(" "~FStr(Fbn()['PorArancel'], 1, 2)~", "~FStr(Fbn()['TotalRetenciones'], 1, 2)~", '0','"~Fbn('Corporate')~"','"~Fbn('TipoCambio3')~"', ")
Sqladd(" '"~Fbn()['Vehiculo1']~"', '"~Fbn()['OpSIOPEL']~"', '"~Fbn('CB5')~"', '0', '"~Fbn('CB7')~"','"~Fbn('Cupon1')~"', '"~Fbn('RB10')~"',")
Sqladd(" '"~Val(nu1)~"', "~FStr(Fbn('TipoCambio2'), 1, 8)~", '"~Fbn()['EsAforado']~"', "~FStr(Fbn()['PorAforo'], 1, 2)~", "~FStr(Fbn('TotalCaucion'), 1, 2)~", '"~Fbn('RB9')~"',")
Sqladd(" '"~Val(tp1)~"'  ")
Sqladd(", "~SQLFecha(Fbn('FechaCarga'))~", '"~IdxDate(Fbn('FechaCargaSys'))~"' ")
Sqladd(", '"~IdxDate(Fbn('FechaAltaMAE'))~"', '"~Fbn('NroBajaMAE')~"', 'SI', '"~IdxDate(Fbn('FechaAltaMAE'))~"' ,'0', ")
Sqladd(" 0, 0, "~FStr(Fbn('Cantidad'), 1, 2)~", 0, "~FStr(Fbn('Precio2'), 1, 8)~", '"~Fbn('RB5')~"' ")
Sqladd(" ) ")
Sqlnew()

proximo

Sqladd(" Select Precio1, Plazo, FormaLiquidacion1, TotalIntereses, TotalBrutoCli1, FechaVto, TipoCambio2, TotalCaucion ")
Sqladd(" From "~Dbo()~".OPERACIONES    ")
Sqladd(" WHERE TipoOp in ('TIFC','TIFV')      ")
Sqladd(" AND   Vehiculo1    = '"~Fbn('Vehiculo1')~"'      ")
Sqladd(" AND   NrOperacion3 = '"~Fbn('NrOperacion3')~"'   ")
Sqladd(" AND PaseCB   = '1' and CB5 ='1'            ")
Sqladd(" AND FechaOp  = "~IdxDate2(Fbn('FechaOp'))~" ")
Sqladd(" AND Especie  = '"~Fbn('Especie')~"'        ")
recorrer sql
Message('Actualizando Pase '~Val(nu1)~'... ')
Sqladd(" Update "~Dbo()~".OPERACIONES                    ")
Sqladd(" set Precio2 = "~FStr(Fbn('Precio1'), 1, 8)~",   ")
Sqladd("     Plazo   = "~FStr(Fbn('Plazo'), 1, 0)~",     ")
Sqladd("     FormaLiquidacion2   = "~FStr(Fbn('FormaLiquidacion1'), 1, 0)~",  ")
Sqladd("     TotalAux1  ="~FStr(Fbn('TotalIntereses'), 1, 2)~",")
Sqladd("     TotalBrutoCli2  ="~FStr(Fbn('TotalBrutoCli1'), 1, 2)~",")
Sqladd("     FechaVto   ='"~IdxDate(Fbn()['FechaVto'])~"', ")
Sqladd("     FechaVto2  ='"~IdxDate(Fbn()['FechaVto'])~"' ")
if (Var('AFOROMAE') > 0)
Sqladd(", EsAforado = '1', ")
Sqladd("  PorAforo  = "~FStr(Var('AFOROMAE'), 0, 2)~", ")
Sqladd("  TipoCambio2 = "~FStr(Fbn('TipoCambio2'), 0, 8)~", ")
Sqladd("  TotalGastos = "~FStr(Fbn('TotalCaucion'), 0, 2)~" ")
endif
Sqladd(" where  NrOperacion =  '"~Val(nu1)~"'   ")
Sqlnew()
proximo

if (Var('AFOROMAE') > 0)
Message('Actualizando Aforo de Operacion Contado ... ')
Sqladd(" Select TipoCambio2, TotalCaucion ")
Sqladd(" From "~Dbo()~".OPERACIONES         ")
Sqladd(" WHERE TipoOp in ('TIC','TIV')    ")
Sqladd(" AND   Vehiculo1    = '"~Fbn('Vehiculo1')~"'    ")
Sqladd(" AND   NrOperacion3 = '"~Fbn('NrOperacion3')~"' ")
Sqladd(" AND PaseCB   = '1' and CB5 ='1'            ")
Sqladd(" AND FechaOp  = "~IdxDate2(Fbn('FechaOp'))~" ")
Sqladd(" AND Especie  = '"~Fbn('Especie')~"' ")
recorrer sql
Sqladd(" Update "~Dbo()~".OPERACIONES SET ")
Sqladd(" TipoCambio   = "~FStr(Fbn('TipoCambio2'), 0, 8)~", ")
Sqladd(" TotalCaucion = "~FStr(Fbn('TotalCaucion'), 0, 2)~" ")
Sqladd(" where  NrOperacion =  '"~Val(nu1)~"' ")
Sqlnew()
proximo
endif

Sqladd("SELECT NrInstancia FROM "~Dbo()~".INSTANCIAS Where Tabla='OPERACIONES' ")
Sqladd("ORDER BY NrInstancia ")
recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd("(NrOperacion,NrBit,Valor) ")
Sqladd(" Values ")
Sqladd("('"~Val(nu1)~"',"~FStr(Fbn()['NrInstancia'], 3, 0)~",")
if (Incluido(Fbn()['NrInstancia'], '70'))
Sqladd("'1')")
else
Sqladd("'0')")
endif
Sqlnew()
Sqlexec()
proximo

