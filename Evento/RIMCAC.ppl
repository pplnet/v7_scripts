CrearDialogo
  NrOperacion1: 'Nr.Operacion';;;;;;;;;
  Fecha1      : 'Fecha Op' ;;;;;;;;;
  Fecha2      : 'Fecha Conc ' ;;;;;;;;;
  Vehiculo1   : 'Vehiculo'    ;;;;;;;;;
  Cliente1    : 'Cliente'     ;;;;;;;;;
  Entero1     : 'Copias'      ;;;;;;;;;1
  Radio1      : 'Tipo|Clasico|Intermed.' ;;;;;NO;;;;0;;;
FinDialogo

If Not Ok
   Cancelar
Endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz:6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))

If NoVacio(Dialogo.NrOperacion1)
   *- Control de vehiculo habilitado para el usuario
   *- vh1: vehiculo de la operacion 
   *- Cancela si el vehiculo no esta habilitado para el usuario activo
   
   ACT(vh:1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
    
   (.'CONTROLVH'.)
Endif

CrearFont(1,"Arial,8,B")

ACT(VE:1, Var('VEHIEXTRAN'))

SQL.ADD(" Select Distinct O.NrOperacion, O.Vehiculo1, O.FechaOp, O.Cliente1, O.TipoOp, O.Especie, O.Cantidad, O.NrOrden,O.CB3 ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where  O.NrOrden is Not NULL ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion ='"~Dialogo.NrOperacion1~"' ")
Else
   If NoVacio(IdxDate(Dialogo.Fecha1))
      SQL.ADD(" and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'  ")
   EndIf
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz:6))~") ")
      EndIf 
   EndIf
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1='"~Dialogo.Cliente1~"' ")
   EndIf
EndIf
SetFilaActual(0)
Recorrer SQL

  ACT(a:FAC, fbn['NrOperacion'])
  ACD(b:FAC, fbn['FechaOp'])
  ACT(c:FAC, fbn['Cliente1'])
  ACT(d:fac, FBN['TipoOp'])
  ACT(e:fac, FBN['Especie'])
  ACN(f:fac, FBN['Cantidad'])
  ACT(g:fac, fbn['NrOrden'])
  ACT(ah:fac, fbn['Vehiculo1'])
  ACN(h:1, fbn['CB3'])
  ACN(z1,fac)

Proximo

if Val(z1)=0
  MessageBox('No existen cartas para la operacion')
Else 
  ACO(1,7)
  ACO(2,8)
  ACO(3,8)
  ACO(4,5)
  ACO(5,5)
  ACO(6,13)
  ACO(7,5)
  FormatoCeldas(f:1..f:fac,Exe('F2'))

  CrearListBox;'Arial,8,B'
      'Imprime'                  ; k1..k:val(z1); SI; SI;;60; COMBO; 'Si|No|'
      'Operacion'                ; a1..a:val(z1); NO; SI;;80; STRING
      'FechaLiq'                 ; b1..b:val(z1); NO; SI;;70; FECHA
      'Cliente'                  ; c1..c:val(z1); NO; SI;;70; STRING
      'Tipo'                     ; d1..d:val(z1); NO; SI;;70; STRING
      'Especie'                  ; e1..e:val(z1); NO; SI;;70; STRING
      'Cantidad'                 ; f1..f:val(z1); NO; SI;;100; NUMERO;'###,###,###.##p'
      'Moneda'                   ; g1..g:val(z1); NO; SI;;70; STRING
   FinListBox

   If Not Ok 
      Cancelar
   EndIf

   Recorrer&j 1,val(z1)
  
      If val(k:&j)=0
      *- Imprime 
        Recorrer&k 1, Dialogo.Entero1
           If Incluido(val(d:&j), 'FCS')
               EjecutarEvento('CACFCS',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACFCS'))
           Else
               If Incluido(val(d:&j), 'TRANTI|')
                  LinkearHoja('CACTRA',1,NrOperacion1=Val(a:&j),Fecha1=FSys)
               Else
                  If Incluido(val(d:&j), 'MMCP|MMCPM|')
                      LinkearHoja('CACPLF',1,NrOperacion1=Val(a:&j))
                  Else
                      If Incluido(val(d:&j), 'MMO|')
                          LinkearHoja('CACMMO',1,NrOperacion1=Val(a:&j))
                      Else
                          If Incluido(val(d:&j), 'MMCCR|')
                              LinkearHoja('CACREM',1,NrOperacion1=Val(a:&j))
                          Else
                              If Incluido(val(d:&j), 'MMDC|')
                                  LinkearHoja('CACDES',1,NrOperacion1=Val(a:&j))
                              Else
                                  If Incluido(val(d:&j), 'MMCAUA|')
                                      LinkearHoja('CACCAU',1,NrOperacion1=Val(a:&j))
                                  Else
                                      If Incluido(val(d:&j), 'SECSV|SEVSV|SECT|SEVT|SECTV|SEVTV|')
                                          LinkearHoja('CACSEC',1,NrOperacion1=Val(a:&j))
                                      Else
                                          If Incluido(VAL(D:&J),'SECS|SEVS')
                                              IF Incluido(Val(AH:&j), Val(VE:1))
                                                  ***---Extranjero
                                                  LinkearHoja('CACSEE',1,NrOperacion1=Val(A:&j))
                                              ELSE
                                                  ***---Local
                                                  LinkearHoja('CACSEL',1,NrOperacion1=Val(A:&j))
                                              ENDIF
                                          Else
                                              If Incluido(val(d:&j), 'MMPCL|MMPCLM|MMPCOS|MMPOSM|MMFCMV|MMFRN|MMPE|MMPEM|MMPI|MMPIM|MMPSC|MMPSCMV|MMON|MMONM|')
                                                  LinkearHoja('CACPRE',1,NrOperacion1=Val(a:&j))
                                              Else
                                                  If Incluido(val(d:&j), 'TRANMM|')
                                                      LinkearHoja('CACTRN',1,NrOperacion1=Val(a:&j))                                            
                                                  Else                                                                                       
                                                      If Incluido(val(d:&j), 'MMPCCM|SEPVMV|MMPCCV')
                                                         If Val(h:1)=1
                                                            LinkearHoja('CACPRV',1,NrOperacion1=Val(a:&j),Radio1=1)
                                                         else
                                                            LinkearHoja('CACPRV',1,NrOperacion1=Val(a:&j),Radio1=0)
                                                         Endif
                                                      Else
                                                          If Incluido(val(d:&j), 'FCR')
                                                              EjecutarEvento('CACFCR',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACFCR'))
                                                          Else
                                                             MessageBox('Carta no definida para Operacion '~val(d:&j))
                                                             *----      If Incluido(val(d:&j),Exe('CARTA1C')) o Incluido(val(d:&j),Exe('CARTA1V'))
                                                             *----          LinkearHoja('CARTA1',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(g:&j),Fecha1=Dialogo.Fecha1,Check1=0, Radio1=Dialogo.Radio1)
                                                             *----      Else
                                                             *----          If Incluido(val(d:&j),Exe('CARTA2')) o EqStr(val(d:&j),'MMP')
                                                             *----              LinkearHoja('CARTA2',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(g:&j),Fecha1=Dialogo.Fecha1,Check1=0, Radio1=Dialogo.Radio1)        
                                                             *----          ENDIF
                                                          ENDIF
                                                      ENDIF
                                                  ENDIF
                                              ENDIF
                                          ENDIF
                                      ENDIF
                                  ENDIF
                              ENDIF
                          ENDIF
                      ENDIF
                  ENDIF    
              ENDIF
          ENDIF
        Proximo  
      Endif
   Proximo
ENDIF
