creardialogo
fecha1: 'FechaMov';2;1;;;;dialogo.fecha1 <> 0;'Fecha invalida';NO;FSys()
especie1: 'Especie';3;1;;;;NoVacio(dialogo.especie1);'Debe seleccionar una especie';NO;
findialogo

if (not ok)
Cancelar()
endif

MostrarCuadroDeMensajes()
Message('----- Recalculando Saldos para '~dialogo.especie1)

Sqladd("EXEC "~Dbo()~".Regenera_SaldosDiaEspecie '"~dialogo.especie1~"','"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()

Sqladd("EXEC "~Dbo()~".Regenera_SaldosEspecie '"~dialogo.especie1~"' ")
Sqlnew()
Sqlexec()

Message('-- Recalculo de Saldos Terminado --')
ocultarcuadrodemensajes

Messagebox('-- Recalculo de Saldos Terminado --')


