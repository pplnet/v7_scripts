Act(z1, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))
if (NoVacio(Val(z1)))
Act(z1, Pipe2Comillas(Val(z1)))
creardialogo
nroperacion1:'Nr.Operacion';;;;;;;;;;;;;;"Vehiculo1 in ("~Val(z1)~")"

findialogo
else
creardialogo
nroperacion1:'Nr.Operacion';;;;;;;;;

findialogo
endif

if (not ok)
Cancelar()
endif

Act(z2, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

Sqladd("Select Vehiculo1, RB3 from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'")
recorrer sql
if (Incluido(Fbn('Vehiculo1'), Var('VLIQUIDA')~Var('VLIQUIDA2')))
Cancelar('La operacion pertenece a un Vehiculo que liquida')
endif
if ((not Incluido(Fbn('Vehiculo1'), Val(z2))) y NoVacio(Val(z2)))
Cancelar('La operacion pertebnece a un Vehiculo no autorizado para el Usuario')
endif


Act(f1, SQLSet("Select TipoOp from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
if (Buscar('AJUCOB', Val(f1)) o Buscar('AJUCON', Val(f1)) o Buscar('AJUCOR', Val(f1)) o Buscar('AJUDEV', Val(f1)) o Buscar('AJULIM', Val(f1)) o Buscar('AJUSCF', Val(f1)) o Buscar('AJUSMV', Val(f1)) o Buscar('AJUSTE', Val(f1)))
Cancelar('No se puede utilizar para Operaciones de Ajuste, Utilizar la Flecha de Retroceso')
endif


Acn(z1, Query("Select count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and (NrBit=20 or NrBit=50) and Valor='1'"))
if (Val(z1) = 0)
Cancelar('La Operacion no esta en BackOffice ni Terminal')
endif
Acn(z4, Fbn('RB3'))
proximo

Sqladd("Update "~Dbo()~".OPERACIONES")
Sqladd("Set Direccion=1 where NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()
Sqladd(" Select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and Valor = '1' ")
recorrer sql
Dfa()
if (Fbn('NrBit') = 50)
if (Query(" Select Count(*) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~dialogo.nroperacion1~"' ") = 1)
Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 50, 'nroperacion1', dialogo.nroperacion1)
endif
endif
proximo
Sqladd("Update "~Dbo()~".OPERACIONESBITS")
Sqladd("Set Valor='0' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit in (20, 50)")
Sqlnew()
if (Val(z4) > 0)
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=10")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=12")
endif
Sqlnew()
Sqlexec()

