endif
if (NoVacio(dialogo.especie1))
Sqladd("       and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd("       and M.Cliente = '"~dialogo.cliente1~"' ")
endif
Sqladd("       and ((B.NrBit = 20 and B.Valor = '1') or (B.NrBit = 50 and B.Valor = '1')) ")
Sqladd(" UNION ")
Sqladd("SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, ")
Sqladd(" M.Transaccion, M.Cuenta, M.Leyenda, M.NrMov, O.TipoTr2 TipoOp, M.EnteCustodia Vehiculo, M.NrLiq,O.Book1 ")
Sqladd(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 O ")
