Sqladd("SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, ")
Sqladd(" M.Transaccion, M.Cuenta, M.Leyenda, M.NrMov, O.TipoOp, M.EnteCustodia Vehiculo, M.NrLiq, O.Book1 ")
Sqladd(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
Sqladd(" Where O.NrOperacion = B.NrOperacion ")
Sqladd("       and M.NrOperacion = B.NrOperacion ")
Sqladd("       and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("       and M.EnteCustodia in ("~Pipe2Comillas(Val(vh:1))~") ")
Sqladd("       and M.Bits = 'MV' ")
if (dialogo.fecha2 > 0)
Sqladd("       and M.FechaMov >= '"~IdxDate(dialogo.fecha2)~"' ")
endif
Sqladd(" AND M.NrSaldo = 1 ")
if (dialogo.check1 = 1)
Sqladd(" AND (((O.OperacionRef Is Null OR O.OperacionRef = '') ")
Sqladd("        AND O.TipoOp IN ("~Pipe2Comillas(Val(ls:2))~")) ")
