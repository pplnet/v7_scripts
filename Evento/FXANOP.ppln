creardialogo
nroperacion1: 'Nro. Operacion';;;;
findialogo

if (not ok o not Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'FXAS|FXAT|FXASV|FXATV|FXREPO|FXREPV'))
Cancelar()('La operacion Nro. '~dialogo.nroperacion1~' No es un Arbitraje ni un Repo')
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

sql.add("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
sql.add("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
sql.add("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar()('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


sql.add(" Select * from "~Dbo()~".OPERACIONES ")
sql.add(" Where OperacionRef = '"~dialogo.nroperacion1~"' ")
sql.add(" Order by NrOperacion")

recorrer sql

if (Incluido(Fbn()['TipoOp'], 'FXA|FXAT|FXASV|FXATV'))
sql.add(" Select * from "~Dbo()~".OPERACIONES ")
sql.add(" Where OperacionRef = '"~Fbn()['NrOperacion']~"' ")
sql.add(" Order by NrOperacion")

recorrer sql
Message('----- Eliminado Operacion Nr: '~Fbn()['NrOperacion']~' Asociada al Aritraje ...')
sql.add(" Delete "~Dbo()~".OPERACIONES ")
sql.add(" Where  NrOperacion = '"~Fbn()['NrOperacion']~"' ")
sql.new
sql.exec
proximo
endif

Message('----- Eliminado Operacion Nro.: '~Fbn()['NrOperacion']~' ...')
sql.add(" Delete "~Dbo()~".OPERACIONES ")
sql.add(" Where  NrOperacion = '"~Fbn()['NrOperacion']~"' ")
sql.new
sql.exec
proximo

Message('----- Eliminado Operacion Nro.: '~dialogo.nroperacion1~' ...')
sql.add(" Delete "~Dbo()~".OPERACIONES ")
sql.add(" Where  NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
