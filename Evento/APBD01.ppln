creardialogo
fecha1:"Fecha: ";1;1;;NO;;;;;;FSys()
string:'Path:  ';2;1;;;;NoVacio(dialogo.string);'Path Invalido';NO;Var('DIRDATANET');
string2:"Nuevo Directorio";;;;;;NoVacio(dialogo.string2);'Directorio Invalido';NO;Var('DNPROCES')
radio1: '|W98|NT';;;;;;;;;0
entero1: 'Registros';;;;;;;;;Var('DNREGISTRO')
findialogo

if (not ok)
Cancelar()
endif

sql.add(" UPDATE "~Dbo()~".NUMERADORES SET Numero=0 WHERE Codigo='10105' ")
sql.new
sql.exec

Act(ww:1, primerarchivo(Mirt(Trim(dialogo.string))~'\*.dat'))
if (not Vacio(Val(ww:1)))
abrirascii(Trim(Mirt(dialogo.string))~Val(ww:1), 0)
Act(x:1, leerascii)

if (Incluido(Copy(Val(x:1), 17, 6), 'DNCTAS|DNAHMS|DNCCDO|DNCADO'))
cerrarascii
Message('Es un archivo de saldos y movimientos.'~Copy(Val(x:1), 17, 6))
ejecutarevento('APBD02', fecha1 = dialogo.fecha1, string = dialogo.string, string3 = Val(ww:1), string2 = dialogo.string2, radio1 = dialogo.radio1, entero1 = dialogo.entero1)
else
Message('No es un archivo de saldos y movimientos.')
cerrarascii
endif
endif


recorrer&j 2, 1000000
Act(ww:&j, proximoarchivo)
if (not ok)
break
endif

abrirascii(Trim(Mirt(dialogo.string))~Val(ww:&j), 0)
Act(x:1, leerascii)

if (Incluido(Copy(Val(x:1), 17, 6), 'DNCTAS|DNAHMS|DNCCDO|DNCADO'))
cerrarascii
Message('Es un archivo de saldos y movimientos.'~Copy(Val(x:1), 17, 6))
ejecutarevento('APBD02', fecha1 = dialogo.fecha1, string = dialogo.string, string3 = Val(ww:&j), string2 = dialogo.string2, radio1 = dialogo.radio1, entero1 = dialogo.entero1)
else
cerrarascii
endif
proximo


