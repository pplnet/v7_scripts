Sqladd("SELECT O.NrORDEN, O.Mercado4 ")
Sqladd("  FROM "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" WHERE O.NrORDEN = OB.NrOperacion ")
Sqladd("   AND OB.NrBit in (54,104) ")
Sqladd("   AND OB.Valor = '1' ")
Sqladd("   AND O.FechaVto <="~IdxDate2(dialogo.fecha1))
Sqladd("   AND  O.TipoOrden = 'TMANIF' ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("AND  O.NrOperacion1 = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.lista1))
Sqladd("AND  O.Mercado4 In ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Sqladd("ORDER BY O.NrOrden ")
Watch(Sqlbatch())
recorrer sql
Message('Cerrando manifestacion '~Fbn('NrOrden'))
Act( o :1, Fbn()['NrOrden'])
if (Val(y:1) = 1)
Sqladd("SELECT *  FROM "~Dbo()~".MOVLIMITES  WHERE NrOperacion = '"~Fbn()['NrOrden']~"' ")
recorrer sql
Sqladd("INSERT INTO "~Dbo()~".MOVLIMITES ")
Sqladd("(FechaMov, Cliente, Limite, Especie, Monto, NrOperacion, Descripcion,  ")
Sqladd("Bits, Vehiculo, Operador, Book, Responsable, TipoPosicion, Producto,  ")
Sqladd("GrupoEspecie, CarteraBCRA) ")
Sqladd(" values (  ")
Sqladd(" "~IdxDate2(Fbn()['FechaMov'])~", '"~Fbn()['Cliente']~"', '"~Fbn()['Limite']~"', '"~Fbn()['Especie']~"', "~FStr(Fbn()['Monto'] * -1, 0, 2)~", '"~Fbn()['NrOperacion']~"', '"~Fbn()['Descripcion']~"',  ")
Sqladd(" '"~Fbn()['Bits']~"', '"~Fbn()['Vehiculo']~"', '"~Fbn()['Operador']~"', '"~Fbn()['Book']~"', '"~Fbn()['Responsable']~"', '"~Fbn()['TipoPosicion']~"', '"~Fbn()['Producto']~"',   ")
Sqladd(" '"~Fbn()['GrupoEspecie']~"', '"~Fbn()['CarteraBCRA']~"') ")
Sqlnew()
proximo
