creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'TCPCEM';;;;;;;;;;;;;;"TipoOp in ('TCPCEM')"
lista1: 'Mercados';;;;NO;;;;;;'MAE|BYMA';SQLSet("SELECT Codigo FROM "~Dbo()~".MERCADOS  ORDER BY Codigo ");SI
findialogo
if (not ok)
Cancelar()
endif

Acn(y:1, 1)
if (Val(y:1) = 0)
HojaVisible(SI)
endif

sql.add("SELECT O.NrORDEN, O.Mercado4 ")
sql.add("  FROM "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" WHERE O.NrORDEN = OB.NrOperacion ")
sql.add("   AND OB.NrBit in (54,104) ")
sql.add("   AND OB.Valor = '1' ")
sql.add("   AND O.FechaVto <="~IdxDate2(dialogo.fecha1))
sql.add("   AND  O.TipoOrden = 'TMANIF' ")
if (NoVacio(dialogo.nroperacion1))
sql.add("AND  O.NrOperacion1 = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.lista1))
sql.add("AND  O.Mercado4 In ("~pipe2comillas(dialogo.lista1)~") ")
endif
sql.add("ORDER BY O.NrOrden ")
Watch(sql.batch())
recorrer sql
Message('Cerrando manifestacion '~Fbn('NrOrden'))
Act( o :1, Fbn()['NrOrden'])
if (Val(y:1) = 1)
sql.add("SELECT *  FROM "~Dbo()~".MOVLIMITES  WHERE NrOperacion = '"~Fbn()['NrOrden']~"' ")
recorrer sql
sql.add("INSERT INTO "~Dbo()~".MOVLIMITES ")
sql.add("(FechaMov, Cliente, Limite, Especie, Monto, NrOperacion, Descripcion,  ")
sql.add("Bits, Vehiculo, Operador, Book, Responsable, TipoPosicion, Producto,  ")
sql.add("GrupoEspecie, CarteraBCRA) ")
sql.add(" values (  ")
sql.add(" "~IdxDate2(Fbn()['FechaMov'])~", '"~Fbn()['Cliente']~"', '"~Fbn()['Limite']~"', '"~Fbn()['Especie']~"', "~FStr(Fbn()['Monto'] * -1, 0, 2)~", '"~Fbn()['NrOperacion']~"', '"~Fbn()['Descripcion']~"',  ")
sql.add(" '"~Fbn()['Bits']~"', '"~Fbn()['Vehiculo']~"', '"~Fbn()['Operador']~"', '"~Fbn()['Book']~"', '"~Fbn()['Responsable']~"', '"~Fbn()['TipoPosicion']~"', '"~Fbn()['Producto']~"',   ")
sql.add(" '"~Fbn()['GrupoEspecie']~"', '"~Fbn()['CarteraBCRA']~"') ")
sql.new
proximo
sql.exec

if (Eqstr(Fbn('Mercado4'), Var('AMBBYMA')))
ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 1, entero1 = 54, entero2 = 170)
else
