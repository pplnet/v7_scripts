creardialogo
nropminorista1: 'Operacion';
check1:'Procesa';;;;;;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(a:1, 'NrOpMin')
Act(a:2, 'NrOrden')
Act(a:3, 'TipoOp')
Act(a:4, 'FechaOp')
Act(a:5, 'FechaVto')
Act(a:6, 'Cliente')
Act(a:7, 'Cuenta')
Act(a:8, 'SectorRB')
Act(a:9, 'RB1')
Act(a:10, 'Control')

sql.add("Select * from "~Dbo()~".OPMINORISTAS")
sql.add(" where NrOperacion = '"~dialogo.nropminorista1~"' ")
recorrer sql
Act(b:1, Fbn('NrOperacion'))
Act(b:2, Fbn('NrOrden1'))
Act(b:3, Fbn('TipoOp'))
Acd(b:4, Fbn('FechaOp'))
Acd(b:5, Fbn('FechaVto'))
Act(b:6, Fbn('Cliente1'))
Act(b:7, Fbn('Cuenta5'))
Acn(b:8, Fbn('SectorRB'))
Acn(b:9, Fbn('RB1'))
proximo

if (NoVacio(Val(b:2)))
sql.add("Select * from "~Dbo()~".ORDENES")
sql.add(" where NrOrden = '"~Val(b:2)~"' ")
recorrer sql
Act(c:1, Fbn('NrOperacion2'))
Act(c:2, Fbn('NrOrden'))
Act(c:3, Fbn('TipoOrden'))
Acd(c:4, Fbn('FechaOrden'))
Acd(c:5, Fbn('FechaVto'))
Act(c:6, Fbn('TipoDocum')~' '~Fbn('NrDocum'))
Act(c:7, Fbn('Cuenta5'))
Acn(c:8, Fbn('RB1'))
Act(c:10, 'OK')
proximo
if (not Eqstr(Val(b:1), Val(c:1)))
message2('No coincide el numero de OpMinorista')
Act(c:10, 'Error')
endif
if (not Eqstr(Val(b:2), Val(c:2)))
message2('No coincide el numero de Orden')
Act(c:10, 'Error')
endif
else
message2('La OpMinorista no tiene Orden relacionada')
Act(c:10, 'Error')
endif

if (Eqstr(Val(c:10), 'OK'))
Message('Anulacion de Orden / OpMinorista')
if (dialogo.check1 = 1)
ejecutarevento('ANUMOV', nroperacion1 = Val(b:1))

sql.add("Update "~Dbo()~".OPERACIONESBITS ")
sql.add("   set Valor = '0' ")
sql.add(" where NrBit <> 30 ")
sql.add("   and NrOperacion = '"~Val(c:2)~"' ")
sql.new
sql.exec
ejecutarevento('CBOINS', string1 = Val(c:2), radio1 = 2, radio2 = 1, entero1 = 10, entero2 = 30)
endif
endif

