MostrarCuadroDeMensajes()
creardialogo
nrunicoasiento1: 'Nr Asiento';1;;;radio1 = 0;;NoVacio(dialogo.nrunicoasiento1);'Asiento Invalido';;
fecha1:'F.Valor';2;;;radio1 = 1;;;;NO;;iif (Vacio(dialogo.nrunicoasiento1), FSys(), BuscarCampo('ASIENTOSCON', 'FechaValor', 'NrUnicoAsiento', dialogo.nrunicoasiento1))
radio1:'Envia Asientos|Nr Asiento|Fecha Valor';3;;;;;;;;;0

findialogo

if (not ok)
Cancelar()
endif

Acn(bd:1, 0)

Sqladd(" Select  FechaGeneracion, FechaValor,NrUnicoAsiento,NrOperacion, Fecha2, Estado  ")
Sqladd(" From  "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where ")
if (dialogo.radio1 = 0)
Sqladd(" NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' ")
else 
Sqladd(" FechaValor = '"~IdxDate(dialogo.fecha1)~"' ")
endif
Sqladd(" AND (Estado = NULL OR Estado = '' OR Estado = ' ' OR Estado = 'COT' OR Estado = 'NC' OR Estado = 'REV') ")
Sqladd(" order by NrUnicoAsiento ")
recorrer sql
Acn(bd:1, 1)
if (Eqstr(Fbn('Estado'), 'COT'))
Act(a:fac, 'COE')
else 
if (Eqstr(Fbn('Estado'), 'NC'))
Act(a:fac, 'NCE')
else 
if (Eqstr(Fbn('Estado'), 'REV'))
Act(a:fac, 'REE')
else 
Act(a:fac, 'E')
endif
endif
endif
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set Estado = '"~Val(a:fac)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()

Messagebox('Se envió el asiento '~dialogo.nrunicoasiento1~'')

proximo


