creardialogo
nroperacion1: 'Op       ';;;;;;;;;;
nroperacion2: 'Op Divide';;;;;;;;;;
fecha1:'FechaOp';;;;;;;;;;
entero1:'Plazo';;;;;;;
cantidad1:'Cantidad';;;;;;;;;

findialogo

if (not ok)
Cancelar()
endif

Acd(fe:1, Habiles(dialogo.fecha1, dialogo.entero1, 'ARG', SI))

Sqladd(" Select Especie, ContraEspecie,Vehiculo1,Vehiculo2 FROM "~Dbo()~".OPERACIONES WHERE NrOperacion='"~dialogo.nroperacion1~"'  ")
recorrer sql
Act(es:1, Fbn('Especie'))
Act(cs:1, Fbn('ContraEspecie'))
Act(ve:1, Fbn('Vehiculo1'))
Act(ve:2, Fbn('Vehiculo2'))
proximo

Acn(pe:1, CotizacionC(Val(es:1), 'CON', null, null, dialogo.fecha1, 1, SI, Val(cs:1)))
Acn(tb:1, Val(pe:1) * dialogo.cantidad1)
Acd(di:1, FSys())

Acn(a2, BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Val(ve:1)))
Act(a1, getnumerador(Val(a2)))


