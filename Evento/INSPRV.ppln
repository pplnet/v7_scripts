Sqladd("  Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
Sqladd("  Cantidad7,Cantidad8,Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice, Cantidad12")
Sqladd(" ) ")

Sqladd("SELECT '"~Val(a:1)~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
Sqladd("  Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
Sqladd("  Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
Sqladd("  Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,'"~IdxDate(dialogo.fecha1)~"'as  Fecha1,'"~IdxDate(Val(fe:1))~"' as Fecha2,'"~IdxDate(Val(fe:1))~"' ")
Sqladd("  as Fecha3,'"~IdxDate(Val(fe:1))~"' as Fecha4,Fecha5, Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,'"~dialogo.entero1~"' as Plazo1,Plazo2,Plazo3,Plazo4,")
Sqladd("  "~dialogo.cantidad1~" as Cantidad1,"~dialogo.cantidad1~" as Cantidad2,0 as Cantidad3,Cantidad4,Precio1,0 as Precio2,Precio3,Precio4,"~Val(tb:1)~" as Total1,"~Val(tb:1)~" as Total2,")
Sqladd("  0 as Total3,0 as Total4,Total5,Total6,"~Val(tb:1)~" as Total7,"~Val(tb:1)~" as Total8,Tasa1,Tasa2,0 as PrecioRef1,PrecioRef2,Cantidad5,")
Sqladd("  Cantidad6,0 as Precio5,0 as Precio6,0 as Precio7,"~Val(pe:1)~" as Precio8,Tasa3,0 as Total9,Cotizacion1,0 as Cotizacion2,Tasa4,Tasa5,")
Sqladd("  Cantidad7,Cantidad8,Coeficiente,"~dialogo.cantidad1~" as Cantidad1Ori,"~dialogo.cantidad1~" as Cantidad2Ori,Cantidad3Ori,ResultadoIndice,"~dialogo.cantidad1~" as Cantidad12")
Sqladd("FROM "~Dbo()~".CUOTAS ")
Sqladd("WHERE NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
Ejecutarevento('INSEVI', 'nroperacion1', Val(a:1), 'tipoop1', 'SEPVMV', 'vehiculo2', Val(ve:1), 'vehiculo1', Val(ve:2), 'string1', '', 'string', '')


Act(j:1, Val(a:1))
Act(j:2, BuscarCampo('OPERACIONES', 'NrOperacion3', 'NrOperacion', Val(j:1)))
recorrer&i 1, 2
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion,NrBit,Valor) ")
Sqladd("  SELECT '"~Val(j:&i)~"' As NrOperacion,NrBit,Valor ")
Sqladd("    FROM "~Dbo()~".OPERACIONESBITS ")
Sqladd("   WHERE NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '0' ")
Sqladd(" Where NrOperacion = '"~Val(j:&i)~"' ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '1' ")
Sqladd(" Where NrOperacion = '"~Val(j:&i)~"' ")
Sqladd(" and NrBit         =  '50'  ")
Sqlnew()
Sqlexec()
