Sqladd("INSERT INTO "~Dbo()~".CUOTAS ")
Sqladd(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
Sqladd("  Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
Sqladd("  Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
