MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';1;1;;;;;;;FSys()
lista1: 'Vehiculos';3;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
findialogo

if (not ok)
Cancelar()
endif

Acd(fe:1, dialogo.fecha1)

Message('--- ContraAsientos de Vouchers ---')
Sqladd(" select distinct T.Fecha1, T.TipoTr2, T.NrTrans, AC.Modelo as CodAsi, AC.* ")
Sqladd(" from "~Dbo()~".BTRANSACCIONES2 T, "~Dbo()~".ASIENTOSCON AC ")
Sqladd(" where CONVERT (Char(10), T.FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ")
Sqladd(" and T.NrTrans = AC.NrTrans2 ")
Sqladd(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (T.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") OR T.Vehiculo1 is null OR T.Vehiculo1 = '' OR T.Vehiculo1 = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif

recorrer sql
Message('Voucher '~Fbn('NrTrans'))
if (Query(" Select 1 From "~Dbo()~".IMPUESTOS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrTrans1 = '"~Fbn('NrTrans')~"' AND Check2 = 1 ") = 1)
Act(tp:1, 'NC')
else
Act(tp:1, 'COT')
endif
Act(nn:1, getnumerador(810))
Acd(fv:1, Fbn('FechaValor'))
Act(vh:1, Fbn('Vehiculo'))
Acn(v1, 0)
Sqladd("Select FechaInicio, FechaFin    from "~Dbo()~".PERIODOSCONTABLES where ")
Sqladd("    Vehiculo = '"~Val(vh:1)~"' ")
recorrer sql
if (Fbn()['FechaInicio'] <= Val(fv:1))
else
Acd(fv:1, Fbn()['FechaInicio'])
endif
proximo


Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON ")
Sqladd(" ( FechaGeneracion, ")
Sqladd("   FechaValor, ")
Sqladd("   Vehiculo, Libro, ")
Sqladd("   Modelo, Book, UDN, Centro, ")
Sqladd("   Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
Sqladd("   NrOperacion, NrTrans2, Fecha1, Estado ")
Sqladd("    ) VALUES ( ")
Sqladd("   "~IdxDate2(FSys())~", ")
Sqladd("   "~IdxDate2(Val(fv:1))~", ")
Sqladd("   '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
Sqladd("   '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
Sqladd("   '"~Fbn('Sector')~"', '"~Fbn('NrLote')~"', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
Sqladd("   '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', "~IdxDate2(dialogo.fecha1)~", '"~Val(tp:1)~"') ")
Sqlnew()
Sqladd(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
recorrer sql
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
Sqladd(" Especie2, Especie3, Cantidad1, Cantidad2, ")
Sqladd(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
Sqladd(" Alias2, Alias3, Alias4, Alias5, ")
Sqladd(" Detalle, CentroCosto, Book, ")
Sqladd(" Alias6, Alias7, Alias8, ")
Sqladd(" Alias9, Alias10, Valor1, ")
Sqladd(" Valor2, Valor3 ")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
Sqladd(" 'CRE', ")
else
Sqladd(" 'DEB', ")
endif
Sqladd(" '"~Fbn('Especie1')~"', ")
Sqladd(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 2)~", "~FStr(Fbn('Cantidad2'), 0, 2)~", ")
Sqladd(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
Sqladd(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', '"~Fbn('Alias4')~"', '"~Fbn('Alias5')~"', ")
Sqladd(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', ")
Sqladd(" '"~Fbn('Alias6')~"', '"~Fbn('Alias7')~"', '"~Fbn('Alias8')~"', ")
Sqladd(" '"~Fbn('Alias9')~"', '"~Fbn('Alias10')~"', "~FStr(Fbn('Valor1'), 0, 2)~", ")
Sqladd(" "~FStr(Fbn('Valor2'), 0, 8)~", "~FStr(Fbn('Valor3'), 0, 2)~") ")
Sqlnew()
proximo
Sqlexec()
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = '"~Val(nn:1)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
proximo

