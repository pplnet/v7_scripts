Sqladd("and S.NrSaldo = 50 ")
Sqladd("and S.Especie <> '"~&monedalocal~"'")
Sqladd(" and S.Fecha IN (SELECT MAX(SD.Fecha) FROM "~Dbo()~".SALDOSDIA SD")
Sqladd("                   WHERE SD.NrSaldo = S.NrSaldo  ")
Sqladd("                   AND SD.EnteCustodia = S.EnteCustodia ")
Sqladd("                   AND SD.Especie = S.Especie ")
Sqladd("                   AND SD.Cuenta = S.Cuenta ")
Sqladd("                   AND SD.Fecha  <= '"~IdxDate(&fhasta)~"') ")
Sqladd("Order By 1")
