Sqladd("Select Distinct S.EnteCustodia as 'Vehiculo', S.Cuenta, S.Especie as 'Moneda', V.Alias4 MonLocalVeh,S.Book ")
Sqladd("from "~Dbo()~".SALDOSDIA S, "~Dbo()~".VEHICULOS V ")
Sqladd(" Where V.Codigo = S.EnteCustodia ")
Sqladd(" AND Round(S.Saldo, 2) <> 0")
