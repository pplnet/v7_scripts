MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'Fecha'                            ;1;;;;;Dialogo.Fecha1<=FSys;'Fecha inválida';SI;Fsys
  *Lista1:    'Vehiculos'   ; 3;;;;;;;;;;SQLSET("Select Codigo from "~DBO~".VEHICULOS")
  Vehiculo1:   'Vehiculo'                       ;2;;;NO;;;;;Var('VEHICON')
  Radio1:    'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos' ; 4;1;;NO;NO;;;;4;
  Radio2:   'Reval TIT|Mensual|Diario'          ;;;;NO;;;;;Var('RETIDIARIO');;;;;;;;;;;;
  Check1:   'Regenera Pos'                      ;;;;NO;NO;;;;1
FinDialogo

If Not Ok
   Cancelar('Evento Cancelado')
Endif

***Si llamamos desde CONT00 no regeneramos posiciones por default, agregamos check1 para manejarlo
If EqStr(Var('ACTPOS'),'SI') Y Dialogo.Check1 = 1
    * Revaluar operaciones y transacciones en dolares
    Message('Regenera posiciones de Ops/Tr en dolares')
    EjecutarEvento('REGPOS', Fecha1=Dialogo.Fecha1,Check1=1)

    * Reset Precio
    Message('Resetea precio posicion')
    EjecutarEvento('RESPCO', Fecha1=Dialogo.Fecha1,Especie1='',Check3=1,Check4=1,Check1=1,Check2=1 )
EndIf

IF Eqstr(Var('CONTAPROCE'), 'SI')
    ACN(CK:1, 1)
ELSE
    ACN(CK:1, 0)
ENDIF

SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='SI' Where Codigo='GENASIENTO' ")
SQL.NEW
SQL.EXEC

ACD(FE:1, Habiles(Fsys,-Var('FVALORCONT'),'ARG'))
ACN(X:1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
IF Val(X:1) = 1
   ACN(X:1, Trunc(Var('DIASCONT'),0))
ENDIF
IF Val(X:1) < 1
   ACN(X:1, 1)
ENDIF
ACD(X:2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(X:1),'ARG'))

***---Anulacion de Asientos
EjecutarEvento('ANUASI', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha1, Lista2='', ListaTabla1='', Radio1=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
***---Concertacion
EjecutarEvento('CONT1', Fecha1=Dialogo.Fecha1, ListaTabla1='', Check1=Val(CK:1), Radio1=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
***---Liquidacion
EjecutarEvento2('CONT2', Fecha1=Dialogo.Fecha1, ListaTabla1='', Check1=Val(CK:1), Radio1=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
***---Liquidacion Gastos
