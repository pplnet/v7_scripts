MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;;;NO;;;;;Fsys
Findialogo

if Not Ok
   Cancelar
endif

* Reset Precio
Message('Resetea precio posicion')
EjecutarEvento('RESPCO', Fecha1=Dialogo.Fecha1,Especie1='',Check1=1,Check2=1 )

* Corte
Message('Genera corte automatico')
EjecutarEvento('CORTE7', Fecha1=Dialogo.Fecha1 )

** Cierra licitaciones
*EjecutarEvento('CIELIC', Fecha1=Fsys )

* Contabilidad   
Message('Genera contabilidad')
EjecutarEvento('CONT0',Fecha1=Dialogo.Fecha1,Vehiculo1=Var('VEHICULODE'))

Message('Generando auditoria de cierre')
LinkearHoja('LOGCIE',1,Fecha1=Dialogo.Fecha1)
