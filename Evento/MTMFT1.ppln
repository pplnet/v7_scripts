sql.add(" Select TOP 1 O.NrOperacion ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where O.NrOperacion = B.NrOperacion ")
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
endif
if (NoVacio(dialogo.fecha2))
sql.add(" AND O.FechaVto = '"~IdxDate(dialogo.fecha2)~"' ")
endif
sql.add(" AND B.NrBit   < 19 ")
sql.add(" AND B.Valor   = '1' ")
sql.add(" AND O.TipoOp IN ('FXCF','FXVF') ")

recorrer sql
Cancelar()('Existen operaciones sin confirmar para el vehiculo '~dialogo.vehiculo1~', el dia '~dialogo.fecha1~' y el futuro '~dialogo.fecha2)
proximo

if (dialogo.fecha1 = dialogo.fecha2)
if (sql("Select 1 FROM "~Dbo()~".COTIZACIONES where Codigo = '"~Var('USDFUT')~"' AND CallPut = 'CON' AND Fecha = '"~IdxDate(dialogo.fecha1)~"' ") <> 1)
Cancelar()('No hay cotizaciones cargadas para la especie '~Var('USDFUT')~' del dia '~dialogo.fecha1)
endif
else
if (sql("Select 1 FROM "~Dbo()~".COTIZACIONES where Codigo = '"~Val(ml:2)~"' AND CallPut = 'FUT' AND Fecha = '"~IdxDate(dialogo.fecha1)~"' AND FechaEj = '"~IdxDate(dialogo.fecha2)~"' ") <> 1)
Cancelar()('No hay cotizaciones cargadas para la especie '~Val(ml:2)~' el dia '~dialogo.fecha1~' y el futuro '~dialogo.fecha2)
endif
endif

sql.add(" Select O.NrOperacion,   O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
sql.add("       O.Precio1,       O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        ")
sql.add("       O.FechaOp,       O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    ")
sql.add("       O.FechaUltCupon, O.PrecioEj,      O.FechaEj,        O.MB1,         ")
sql.add("       O.TotalAux1,     O.TotalAux3,     O.ContraEspecie2, O.Mercado, 1 as Tipo ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where C.Codigo    = O.Cliente1 ")
sql.add(" AND O.NrOperacion = B.NrOperacion ")
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
endif
sql.add(" AND O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.fecha2))
sql.add(" AND O.FechaVto = '"~IdxDate(dialogo.fecha2)~"' ")
endif
sql.add("   and B.NrBit   >= 19 ")
sql.add("   and B.Valor   = '1' ")
sql.add(" AND O.TipoOp IN ('FXCF','FXVF','SECF','SEVF') ")

sql.add(" UNION ALL")

sql.add(" Select O.NrOperacion,   O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
sql.add("       O.Precio1,       O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        ")
sql.add("       O.FechaOp,       O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    ")
sql.add("       O.FechaUltCupon, O.PrecioEj,      O.FechaEj,        O.MB1,          ")
sql.add("       O.TotalAux1,     O.TotalAux3,     O.ContraEspecie2, O.Mercado, 2 as Tipo ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where C.Codigo    = O.Cliente1 ")
sql.add(" AND O.NrOperacion = B.NrOperacion ")
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
endif
sql.add(" AND O.FechaOp  < '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.FechaCargaSys  = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.fecha2))
sql.add(" AND O.FechaVto = '"~IdxDate(dialogo.fecha2)~"' ")
endif
sql.add(" AND B.NrBit   >= 19 ")
sql.add(" AND B.Valor   = '1' ")
sql.add(" AND O.TipoOp IN ('FXCF','FXVF','SECF','SEVF') ")
sql.add(" Order By O.FechaVto, O.NrOperacion ")

Acn(op:1, 0)
recorrer sql
if (Fbn('Tipo') = 1)
Acd(fe:2, dialogo.fecha1)
Acd(fe:3, dialogo.fecha1)
else
Acd(fe:2, Fbn('FechaOp'))
Acd(fe:3, Habiles(dialogo.fecha1, -1, 'ARG'))
endif
recorrer&i Val(fe:2), Val(fe:3)
Acn(fe:1, &i)
if (sql(" Select 1 From "~Dbo()~".CUOTAS Where Fecha1 = '"~IdxDate(Val(fe:1))~"' AND NrOperacion = '"~Fbn('NrOperacion')~"'") <> 1)
Message('Operacion: '~Fbn('NrOperacion'))
Acn(ct:1, CotizacionC(Val(ml:2), 'FUT', dialogo.fecha2, null, Val(fe:1), 1, null, Val(ml:1)))
Acn(ct:2, CotizacionC(Val(ml:2), 'FUT', dialogo.fecha2, null, Val(fe:1) - 1, 1, null, Val(ml:1)))


if (Fbn('FechaOp') = Val(fe:1))
Acn(ct:2, Fbn('Precio1'))
else
if (dialogo.fecha2 = Val(fe:1))
Acn(ct:1, CotizacionC(Var('USDFUT'), 'CON', null, null, Val(fe:1), 1, null, Val(ml:1)))
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set FechaEj = '"~IdxDate(FSys())~"', Precio2 = "~FStr(Val(ct:1), 0, 2)~" ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec
else
endif
endif

Acn(df:1, Val(ct:1) - Val(ct:2))

if (Val(ct:1) <> 0 y Val(ct:2) <> 0)
if (Incluido(Fbn('TipoOp'), 'FXCF|SECF'))
Acn(mm:1, Fbn('Cantidad') * Val(df:1))
else
Acn(mm:1, -Fbn('Cantidad') * Val(df:1))
endif

if (Incluido(Fbn('TipoOp'), 'FXCF|FXVF'))
Acn(cu:1, sql("Select Max(NrCuota)+1 From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"'"))
if (Vacio(Val(cu:1)) o Eqstr(Val(cu:1), '') o Val(cu:1) = 0)
Acn(cu:1, 1)
endif

if (Incluido(Fbn('Cliente1'), Var('BRLIQMTM')))
Acd(fe:3, Habiles(Val(fe:1), 1, 'ARG'))
else
Acd(fe:3, Val(fe:1))
endif
if (Val(fe:1) = Fbn('FechaOp'))
Acd(fe:9, Fbn('FechaOp'))
else
Acd(fe:9, Habiles(Val(fe:1), -1, 'ARG'))
endif
if (sql(" Select 1 From "~Dbo()~".CUOTAS Where Fecha1 = '"~IdxDate(Val(fe:1))~"' AND NrOperacion = '"~Fbn('NrOperacion')~"'") = 1)
sql.add(" Update "~Dbo()~".CUOTAS ")
sql.add(" Set Precio1 = "~FStr(Val(mm:1), 0, 2)~", ")
sql.add(" Cotizacion1 = "~FStr(Val(ct:1), 0, 8)~", Cotizacion2 = "~FStr(Val(ct:2), 0, 8)~" ")
sql.add(" Where Fecha1 = '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec
else
sql.add(" Insert Into "~Dbo()~".CUOTAS ")
sql.add(" (NrCuota, NrOperacion, Fecha1, Fecha2, Fecha3, ")
sql.add(" Precio1, Cotizacion1, Cotizacion2) ")
sql.add(" Values ")
sql.add(" ("~FStr(Val(cu:1), 0, 0)~", '"~Fbn('NrOperacion')~"', '"~IdxDate(Val(fe:1))~"', '"~IdxDate(Val(fe:9))~"', '"~IdxDate(Val(fe:3))~"', ")
sql.add(" "~FStr(Val(mm:1), 0, 2)~", "~FStr(Val(ct:1), 0, 8)~", "~FStr(Val(ct:2), 0, 8)~") ")
sql.add("  ")
sql.new
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set Cuotas1 = "~FStr(Val(cu:1), 0, 0)~", CB5 = 1 ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec
endif
else
if (sql(" Select 1 From "~Dbo()~".MTMDIARIO Where Fecha = '"~IdxDate(Val(fe:1))~"' AND NrOperacion = '"~Fbn('NrOperacion')~"'") = 1)
sql.add(" Update "~Dbo()~".MTMDIARIO ")
sql.add(" Set MTM = "~FStr(Val(mm:1), 0, 2)~", ")
sql.add(" PrecioHoy = "~FStr(Val(ct:1), 0, 8)~", PrecioAyer = "~FStr(Val(ct:2), 0, 8)~" ")
sql.add(" Where Fecha = '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec
else
sql.add(" Insert Into "~Dbo()~".MTMDIARIO ")
sql.add(" (NrOperacion, Fecha, PrecioHoy, ")
sql.add(" PrecioAyer, MTM) ")
sql.add(" Values ")
sql.add(" ('"~Fbn('NrOperacion')~"', '"~IdxDate(Val(fe:1))~"', "~FStr(Val(ct:1), 0, 8)~", ")
sql.add(" "~FStr(Val(ct:2), 0, 8)~", "~FStr(Val(mm:1), 0, 2)~") ")
sql.new
sql.exec
endif
endif
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set TotalAux3 = TotalAux3 + "~FStr(Val(mm:1), 0, 2)~" ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec

sql.actualizarmovimientos3(Fbn('NrOperacion'), SI, SI, NO, SI, SI)
