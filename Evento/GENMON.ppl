SQL.ADD("Delete from "~DBO~".OBJETOS where Codigo ='Monedas'")
SQL.NEW
SQL.EXEC
SQL.ADD("Select Codigo from "~DBO~".ESPECIES order by Codigo")
recorrer SQL
  if DesciendeDeEspecie(fbn('Codigo'),'MONEDA') y EsTerminal(fbn('Codigo'), Especie)
    ACT(a4, val(a4)~fbn('Codigo')~'|')
  endif
proximo

EscribirObjeto('Monedas',Val(a4))
