MostrarCuadroDeMensajes()
Sqladd(" Select /*+ RULE */ O.NrOperacion ")
Sqladd(" From "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND O.NrOperacion = B.NrOperacion ")
Sqladd(" AND (O.Observac4 <> 'SI' OR O.Observac4 Is Null) ")
Sqladd(" AND B.NrBit = 50 ")
Sqladd(" AND B.Valor = '1' ")
Sqladd(" AND M.NrSaldo = 1 ")
recorrer sql
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1)
Message('Borrando Bits Operacion '~Fbn('NrOperacion'))
Sqladd(" Delete "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND NrBit <> 50 ")
Sqlnew()
Sqlexec()
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set Observac4 = 'SI' ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqlexec()
endif
proximo
Sqladd(" Select /*+ RULE */ T.NrTrans NrOperacion ")
Sqladd(" From "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" Where T.NrTrans = M.NrOperacion ")
Sqladd(" AND T.NrTrans = B.NrOperacion ")
Sqladd(" AND (T.Ley5 <> 'SI' OR T.Ley5 Is Null) ")
Sqladd(" AND B.NrBit = 20 ")
Sqladd(" AND B.Valor = '1' ")
Sqladd(" AND M.NrSaldo = 1 ")
recorrer sql
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1)
Message('Borrando Bits Transaccion '~Fbn('NrOperacion'))
Sqladd(" Delete "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND NrBit <> 20 ")
Sqlnew()
Sqlexec()
Sqladd(" Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Set Ley5 = 'SI' ")
Sqladd(" Where NrTrans = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqlexec()
endif
proximo

