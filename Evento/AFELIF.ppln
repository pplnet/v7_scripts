Acd(f5, Habiles(FSys(), -1, Var('FERIADODEF')))


Act(f1, Query("Select Min(FechaVto) from "~Dbo()~".PMAUDIT, "~Dbo()~".OPERACIONES Where Tabla='OPERACIONES' and ValorAnterior<>ValorActual and Fecha Between '"~IdxDate(FSys())~"' and  '"~IdxDate(FSys() + 1)~"' and Codigo=NrOperacion and TipoOp like 'FC%' Having Min(FechaVto) is not null"))

Message(' Verificando dia de Proceso por Modificaciones .... '~Val(f5)~' '~Val(f1))
if (NoVacio(Val(f1)) y Fecha(Val(f1)) < Val(f5))
Acd(f5, Fecha(Val(f1)))
endif


Act(f2, Query("Select Min(FechaVto) from "~Dbo()~".OPERACIONES Where TipoOp like 'FC%' and FechaCargaSys='"~IdxDate(FSys())~"' and FechaOp<>FechaCargaSys "))
Message(' Verificando dia de Proceso por Operaciones Fecha Valor .... '~Val(f2))
if (NoVacio(Val(f2)) y Fecha(Val(f2)) < Val(f5))
Acd(f5, Fecha(Val(f2)))
endif



Act(f3, Query("Select Min(FechaVto) from "~Dbo()~".BOPERACIONES Where TipoOp like 'FC%' and FechaDel = '"~IdxDate(FSys())~"' "))
Message(' Verificando Bajas de Operaciones  .... '~Val(f3))

if (NoVacio(Val(f3)) y Fecha(Val(f3)) < Val(f5))
Acd(f5, Fecha(Val(f3)))
endif

creardialogo
fecha1:'Fecha';;;;;;EsHabil(dialogo.fecha1, 'ARG');'Debe Ingresar un D¡a H bil en Argentina';NO;Val(f5)

findialogo

if (not ok)
Cancelar()
endif

Acd(f6, dialogo.fecha1)
Acd(f7, FSys() - 1)

recorrer&j Val(f6), Val(f7)
Acd(f6, &j)
if (EsHabil(Val(f6)))
Message('Procesando fecha '~Val(f6))
Ejecutarevento('AFELI1', 'fecha1', Val(f6))
else
Message('NO es habil, no la procesa '~Val(f6))
endif
proximo


