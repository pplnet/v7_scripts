require'FPA.BOFA.COMMON.dll'
importservicefpa, 'FPA.BOFA.COMMON.Services.Default.ServiceFPA'
let(&serv, newservicefpa())
let(&resp, &serv.sisext_dealcancelresponse())
Watch(&resp)
if (Eqstr(&resp, 'OK'))
Messagebox('Respuesta OK')
endif
importparamscreate, 'FPA.BOFA.COMMON.Services.Default.ParamsCreate'
let(&params, newparamscreate())
&params.nroperacion = 'ASDASDASD'
&params.nrraiden = 'ADSDSAD'
&params.cantidad = 1000
let(&resp, &serv.sisext_dealcreateresponse(&params))
Watch(&resp)





