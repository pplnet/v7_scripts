* EJENDF: NDF - Resultado en Lotes
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;;;;;;SQLSET("Select NrOperacion FROM "~DBO~".OPERACIONES WHERE TipoOp In ('FXCT','FXVT','FXAT','FXCTV','FXVTV','FXATV') and CB9='1' and CB8='0' and (CB1=0 or CB1 is null or CB1='') ");NO
  Fecha1       : "F Real Ej."               ;;;;;;Dialogo.Fecha1>0;'La Fecha de Ejercicio Real Es incorrecta ';NO;Fsys
  Cliente1     : "Cliente"                  ;;;;;;
  Lista1       : "Vehiculo"                 ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where Status='HAB' or Status Is Null or Status='' "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

IF Not OK
   Cancelar
EndIf

SetFilaActual(1)

ACT(z1,Dialogo.NrOperacion1)
ACN(z2,Dialogo.Fecha1)
ACT(z3,Dialogo.Cliente1)

If NoVacio(Dialogo.NrOperacion1)
   *- Control de vehiculo habilitado para el usuario
   *- vh1: vehiculo de la operacion o transaccion
   *- Cancela si el vehiculo no esta habilitado para el usuario activo
    
   ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
   
   (.'CONTROLVH'.)
Endif

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

SQL.ADD("Select NrOperacion, FechaOp, FechaPago, FechaVto2, TipoOp, Cliente1, Vehiculo1, Especie, ContraEspecie, Cantidad, Precio1 ")
SQL.ADD("From "~DBO~".OPERACIONES ")
SQL.ADD("Where TipoOp In ('FXCT','FXVT','FXAT','FXCTV','FXVTV','FXATV') ")
SQL.ADD("  and CB9='1' ")
SQL.ADD("  and FechaVto2<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and CB8='0' ")
SQL.ADD("  and (CB1=0 or CB1 is null or CB1='') ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and NrOperacion = '"~Dialogo.NrOperacion1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Val(zz6))
  SQL.ADD(" and Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
SQL.ADD(" order by FechaVto2,NrOperacion ")
ACN(x1,0)

Recorrer SQL 
 
    ACN(x1,1)
    Message('*-- Recuperando Operacion '~FBN['NrOperacion'])
   
    ** Muestro los datos
    ACT(b:FAC,FBN['NrOperacion'])
    ACD(c:FAC,FBN['FechaOp'])
    ACD(d:FAC,FBN['FechaPago'])
    ACD(e:FAC,FBN['FechaVto2'])
    ACT(f:FAC,FBN['TipoOp'])
    ACT(g:FAC,FBN['Cliente1'])
    ACT(h:FAC,FBN['Vehiculo1'])
    ACT(i:FAC,FBN['Especie'])
    ACT(j:FAC,FBN['ContraEspecie'])
    ACN(k:FAC,FBN['Cantidad'])
    ACN(l:FAC,FBN['Precio1'])
Proximo


IF VAL(x1)=1 
    *-- Hay datos para mostrar
   CrearDialogo
     NrOperacion1 : "Operacion"                ;1;1;;NO;;;;;val(z1);;
     Fecha1       : "F Real Ej."               ; ; ;;NO;;;;;val(z2);;
     Cliente1     : "Cliente"                  ; ; ;;NO;;;;;val(z3);;
     ListBox; 'Arial,8,N'; 460; 180
        'Resultado?'    ;a2..a:FAC;  ;;;;20;CHECK
        'Nro.Op.'       ;b2..b:FAC;NO;;;;60;STRING
        'F.Operacion'   ;c2..c:FAC;NO;;;;;FECHA
        'F.Vto'         ;d2..d:FAC;NO;;;;;FECHA
        'F.Reset'       ;e2..e:FAC;NO;;;;;FECHA
        'TipoOp'        ;f2..f:FAC;NO;;;;50;STRING
        'Entidad'       ;g2..g:FAC;NO;;;;50;STRING
        'Vehiculo'      ;h2..h:FAC;NO;;;;50;STRING
        'Especie'       ;i2..i:FAC;NO;;;;35;TABLA;'Especies';'Codigo';'Codigo;Nombre';
        'CEsp'          ;j2..j:FAC;NO;;;;35;TABLA;'Especies';'Codigo';'Codigo;Nombre';
        'Cantidad'      ;k2..k:FAC;NO;;;;80;NUMERO;'##,###,###.##'
        'Precio'        ;l2..l:FAC;NO;;;;60;NUMERO;'#,###.#####'
        'P.Refer'       ;m2..m:FAC;  ;VAL(a:FLB)=0 O val(m:FLB)>0;'Ingrese precio de Refernecia';;60;NUMERO;'#,###.#####'
      FinListBox  
   FinDialogo

   IF Not OK
      Cancelar
   EndIf

   *-- El primer renglon es de totales
   Recorrer&i 2,fac

      Message('Validando Renglon '~Fstr(&i-1,2,0)~' Operacion: '~Val(b:&i))

      If NoVacio(Val(a:&i)) y Val(a:&i)<>0
         * Verifico que se encuentre en Liquidacion o Terminal
         ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~VAL(b:&i)~"' AND Valor='1'") )

         If VAL(X1)<>20 y VAL(X1)<>50
            *-- Busco la instancia actual
            MessageBox("La Operacion "~VAL(b:&i)~" Debe estar en Liquidacion o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
         Else

            ACN(mo1,0)
            IF Incluido(val(f:&i),'FXAT|FXATV|')
               ACN(mo1,IIf(EqStr(BuscarCampo('Operaciones','CB6','NrOperacion',val(b:&i)),'0'),-1,1))
            Else 
               ACN(mo1,IIf(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~val(i:&i)~"' and Especie2='"~val(j:&i)~"' "),'INV'),-1,1))
            EndIf

            ACN(re1,((val(m:&i)^val(mo1))-(val(l:&i)^val(mo1)))*val(k:&i)*IIF(Incluido(val(f:&i),'FXVT|FXAT|FXVTV|FXATV|'),-1,1) )
 
            EjecutarEvento('NDFEJE',NrOperacion1=VAL(b:&i),Fecha1=Dialogo.Fecha1,Precio2=VAL(m:&i),Cantidad1=VAL(k:&i),Especie1=VAL(i:&i),Especie2=VAL(j:&i),Precio4=val(re1),Fecha2=VAL(e:&i),Precio3=VAL(l:&i),Fecha4=VAL(d:&i),TipoOp1=VAL(f:&i),Cantidad2=val(mo1))
         EndIf
      Endif
   Proximo
ELSE
   MessageBox('No existe ninguna Opcion para Ejercer a la Fecha  ...')
ENDIF
