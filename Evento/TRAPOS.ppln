Sqladd("Select * from "~Dbo()~".POSICIONES P ")
Sqladd(" where P.Fecha       <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("   and P.Especie     = '"~dialogo.especie1~"' ")
Sqladd("   and P.Vehiculo    = '"~Val(i:1)~"' ")
Sqladd("   and P.Cupon       = "~FStr(Val(i:2), 1, 0)~" ")
Sqladd("   and P.Book        = '"~dialogo.book1~"' ")
Sqladd("   and P.NrSaldo in (122) ")
Sqladd("   and P.CantidadFin <> 0  ")
Sqladd("   AND P.Fecha IN (SELECT MAX(Fecha) from "~Dbo()~".POSICIONES P1 ")
Sqladd("                   WHERE P1.Especie    = P.Especie  ")
Sqladd("                   AND   P1.Vehiculo   = P.Vehiculo ")
Sqladd("                   AND   P1.NrSaldo    = P.NrSaldo  ")
Sqladd("                   AND   P1.Cliente    = P.Cliente  ")
Sqladd("                   AND   P1.Book       = P.Book     ")
Sqladd("                   AND  (P1.Sector     = P.Sector     OR (P1.Sector     IS NULL AND P.Sector     IS NULL) ) ")
Sqladd("                   AND  (P1.CallPut    = P.CallPut    OR (P1.CallPut    IS NULL AND P.CallPut    IS NULL) ) ")
Sqladd("                   AND  (P1.Cupon      = P.Cupon      OR (P1.Cupon      IS NULL AND P.Cupon      IS NULL) ) ")
Sqladd("                   AND  (P1.Estrategia = P.Estrategia OR (P1.Estrategia IS NULL AND P.Estrategia IS NULL) ) ")
Sqladd("                   AND  (P1.TipoPosicion = P.TipoPosicion OR (P1.TipoPosicion IS NULL AND P.TipoPosicion IS NULL) ) ")
Sqladd("                   AND  (P1.FechaEj    = P.FechaEj    OR (P1.FechaEj    IS NULL AND P.FechaEj    IS NULL) ) ")
Sqladd("                   AND  (P1.PrecioEj   = P.PrecioEj   OR (P1.PrecioEj   IS NULL AND P.PrecioEj   IS NULL) ) ")
Sqladd("                   AND  P1.Fecha      <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("                 ) ")
Sqladd("order by Especie,Book,NrSaldo,Cupon,Fecha                 ")

recorrer sql
Scn(y:1, 1)
Act(aa:fac, Fbn('Especie'))
Act(ab:fac, Fbn('Book'))
