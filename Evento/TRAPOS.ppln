book1: 'Book Origen';2;1;1;SI;SI;NoVacio(dialogo.book1);'Debe ingresar un book Origen';NO;;
book2: 'Book Destino';3;1;1;SI;SI;NoVacio(dialogo.book2) y not Eqstr(dialogo.book2, dialogo.book1);'Debe ingresar un book Destino distinto al Origen.';NO;;
fecha1: 'Fecha';4;1;1;SI;SI;dialogo.fecha1 <= FSys();'La fecha no puedse ser mayor que FechaSys';NO;FSys()
