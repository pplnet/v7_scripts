creardialogo
nroperacion1:"Operacion";1;1;;;;NoVacio(dialogo.nroperacion1);'Debe Ingresar una Operacion';NO;
especie1:"Commodity";1;2;;NO;;;;;;BuscarCampo('Operaciones', 'Especie', 'NrOperacion', dialogo.nroperacion1)
precio2:"Precio_Real";2;1;;;;dialogo.precio2 > 0;'El Precio Real es Incorrecto';NO;
fecha4:"Fecha Vto";;;;NO;;;;;;BuscarCampo('Operaciones', 'FechaEj', 'NrOperacion', dialogo.nroperacion1)
precio3:"Precio Pactado";;;;NO;;;;;;BuscarCampo('Operaciones', 'PrecioEj', 'NrOperacion', dialogo.nroperacion1)
radio3:"    |Compra|Venta";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB3', 'NrOperacion', dialogo.nroperacion1)
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DPFW|'))
Cancelar('La operacion No '~dialogo.nroperacion1~' No es un Forward de Commodities')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (ok)
Acn(x1, 0)

Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and FechaEj <='"~IdxDate(FSys())~"' ")

recorrer sql

Acn(x1, 1)

if (dialogo.radio3 = 0)
Acn(z3, (dialogo.precio2 - Fbn()['PrecioEj']))
else
Acn(z3, (Fbn()['PrecioEj'] - dialogo.precio2))
endif

Acn(z2, Val(z3) * Fbn()['Cantidad'])

Message('Actualizando la Opcion  .... ')

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set CB8 = '1', ")
Sqladd("Precio2   = "~FStr(dialogo.precio2, 0, 7)~", ")
Sqladd("Precio3   = "~FStr(Val(z3), 0, 2)~", ")
Sqladd("Precio4   = "~FStr(Val(z2), 0, 2)~"  ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()


Sqlactualizarmovimientos(dialogo.nroperacion1, SI)
Sqlexec()

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
Sqladd("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', Val(az5), 'nroperacion1', Val(az3))
endif

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
Sqlnew()
Sqlexec()



proximo

if (Val(x1) = 0)
Cancelar('La operacion No '~dialogo.nroperacion1~' No puede ser Actualizada')
endif
endif
