           IF Eqstr(Val(o:&i), 'CAL')
           ACT(aa:3,'0')
           ELSE
              IF Eqstr(Val(o:&i), 'PUT')
                 ACT(aa:3,'1')
              ELSE
                 ACT(aa:3,'-1')
              ENDIF
           ENDIF
           ACT(aa:1, GetNumerador(20))
           
           message('Transaccion Nro. '~Val(aa:1)~'...')
           
           SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 (")
           SQL.ADD(" Especie, Cliente1, Fecha2, FechaCarga, FechaCargaSys, ")
           SQL.ADD(" Fecha1, Cantidad1, Cuenta1, Mercado1, Precio1, ")
           SQL.ADD(" Cantidad2, Cantidad3, Vehiculo1, Cupon1, ")
           SQL.ADD(" TipoTr2, NrTrans, CallPut, Cliente3, Cuenta4, ")
* FJL 26/09/21 - Comisiones Eventos Corporativos
           SQL.ADD(" Cantidad10, Cantidad11, ")
* FJL 18/12/21 - Se guarda Monto Moneda (Base Comisiones)
           SQL.ADD(" Cantidad9, ")
* FJL 07/09/22 - se agregan Comisiones e IVA CV
           if Val(ei:&i)=1
             * Cartera Propia
             SQL.ADD(" Cantidad12, Cantidad13, ")
           else
             * Terceros
             SQL.ADD(" Cantidad14, Cantidad15, ")
           endif
* FJL 11/04/22 - Se guarda Moneda Comisiones
           SQL.ADD(" Especie2, ")
* FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*                En CB3 se guarda si es bloqueado
           SQL.ADD(" CB3, ")
* FJL 26/04/22 - Se guarda NrSaldo para usar en los movimientos
           SQL.ADD(" Cambio5, ")
           SQL.ADD(" RB1, RB2, CB1 ")
           SQL.ADD(" ) VALUES (")
           SQL.ADD(" '"~Val(a:&i)~"', '"~Val(g:&i)~"', "~IdxDate2(Val(fe:1))~", "~IdxDate2(FSys)~", "~IdxDate2(FSys)~", ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', "~FStr(Val(i:&i),1,2)~", '"~Val(h:&i)~"', '"~Val(e:&i)~"',  "~FStr(Val(k:&i),1,8)~", ")
           SQL.ADD(" "~FStr(Val(l:&i),1,2)~", "~FStr(Val(m:&i),1,2)~", '"~Val(vh:1)~"', '"~Val(b:&i)~"', ")
           SQL.ADD(" 'STOCK', '"~Val(aa:1)~"', '"~Val(aa:3)~"', '"~Val(CP:&i)~"', '"~Val(NN:&i)~"', ")
* FJL 26/09/21 - Comisiones Eventos Corporativos
           SQL.ADD(" "~FStr(Val(da:&i),0,2)~", "~FStr(Val(db:&i),0,2)~", ")
* FJL 18/12/21 - Se guarda Monto Moneda (Base Comisiones)
           SQL.ADD(" "~FStr(Val(t:&i),0,2)~", ")
* FJL 07/09/22 - se agregan Comisiones e IVA CV
           SQL.ADD(" "~FStr(Val(ea:&i),0,2)~", "~FStr(Val(eb:&i),0,2)~", ")
* FJL 11/04/22 - Se guarda Moneda Comisiones
           SQL.ADD(" '"~Val(s:&i)~"', ")
* FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*                En CB3 se guarda si es bloqueado
           SQL.ADD(" "~FStr(Val(y:&i),0,0)~", ")
* FJL 26/04/22 - Se guarda NrSaldo para usar en los movimientos
           SQL.ADD(" "~FStr(Val(u:&i),0,0)~", ")
