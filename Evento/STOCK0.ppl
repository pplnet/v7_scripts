watch(SQL.batch())

   Recorrer SQL
     IF fbn('Saldo')>0
        IF fbn('Tipo')=0
          SCN(fi:2, 1)
        else
          #ifdef PRUEBA
            * Tambien muestra saldos parking
            SCN(fi:2, 1)
          #endif 
        endif
        SCN(z:1,1)
        
        ACT(a:fac, fbn('Especie'))
        ACT(b:fac, fbn('Cupon'))
        ACN(c:fac, fbn('NrSaldo'))
        ACT(e:fac, fbn('Mercado'))
        ACT(f:fac, fbn('RazonSocial'))
        ACT(g:fac, fbn('Cliente'))
        ACT(h:fac, fbn('Cuenta'))
        ACN(i:fac, fbn('Saldo'))
        ACN(k:fac, Dialogo.Entero1)
        ACN(l:fac, fbn('Saldo')*Dialogo.Entero1/100)
        If Dialogo.Check1=0
           ACN(m:fac, Val(l:fac)+Val(i:fac))
        Else
           ACN(m:fac, Val(i:fac)-Val(l:fac))
        EndIf
        ACT(o:fac, fbn('CallPut'))
        ACD(p:fac, fbn('FechaEj'))
        ACN(q:fac, fbn('PrecioEj'))
        ACT(TC:fac, fbn('TipoCliente'))
        
        ** FJL 11/04/22 - Moneda Comision
        ACT(s:fac, Val(es:2))

        ACN(u:fac, fbn('NrSaldo'))
        ACN(v:fac, fbn('Tipo'))
        ACN(w:fac, Val(u:fac))
        if Val(u:fac)>201
          ACN(w:fac, Val(u:fac)-100)
        endif
        ACT(x:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(w:fac)))
        
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
        ACN(y:fac, 0)
        if Incluido(Val(u:fac),Val(sl:3))
          ACN(y:fac, 1)
        endif

     ** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar la cuenta. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
        IF Not Eqstr(Val(G:fac), Val(VH:1))
           ***---'CLI'
           ACT(CP:fac, '')
*           ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')"))
** FJL 11/04/22 - Se cambia por la momneda ingresada en el dialogo
*           ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')  ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*           ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Val(s:fac)~"%' OR Especies LIKE '%MONEDA%')  ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
           if Val(y:fac)=1
             * Saldo bloqueado
             ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Val(s:fac)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
           else
             ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Val(s:fac)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
           endif
           ACN(BD:fac, 1)
           ACN(BB:fac, 0)
        ELSE
           ***---Vehiculo
           ACT(CP:fac, Val(VH:1))
*           ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')"))
** FJL 11/04/22 - Se cambia por la momneda ingresada en el dialogo
*           ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')  ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
           ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Val(s:fac)~"%' OR Especies LIKE '%MONEDA%')  ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
           ACN(BD:fac, 0)
        ENDIF
        ACN(r:fac, 1)
        ** FJL 18/11/21 - Valuacion de la accion origen para calcular comisiones
        ACN(t:fac, Val(i:fac)*Val(co:1))
** FJL 26/04/22 - Si es saldo de parking no tiene monto moneda
        if Val(v:fac)=1
          ACN(t:fac, 0)
        endif

        if Not EqStr(Val(g:fac),Val(vh:1)) y Val(t:fac)>0
          ACT(de:fac, 'SPLIT')
          ACN(dg:fac, COTIZACIONC(val(es:2),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
          ACN(dh:fac, iif(EqStr(Modo(val(es:2),VAR('MONELOCA')),'INV'),1/val(dg:fac),val(dg:fac)))
       
          ACN(df:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),4,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))
          ACN(da:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),0,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))

          * Cond IVA
          ACT(dc:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
          * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*          ACN(dd:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(dc:fac))/100)
          ACN(dd:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(dc:fac))/100)
          
          * IVA
          ACN(db:fac, Val(da:fac)*Val(dd:fac))
        else
          ACN(da:fac, 0)
          ACN(db:fac, 0)
        endif  

** FJL 25/8/22 - Se agrgan Comisiones CV
        if Val(t:fac)>0
          if EqStr(Val(g:fac),Dialogo.Vehiculo1)
            * Cartera Propia
            ACN(ei:fac, 1)
          else
            * Terceros
            ACN(ei:fac, 0)
          endif
          ACT(ee:fac, 'CVSTOC')
          ACN(eg:fac, COTIZACIONC(val(es:2),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
          ACN(eh:fac, iif(EqStr(Modo(val(es:2),VAR('MONELOCA')),'INV'),1/val(eg:fac),val(eg:fac)))
       
          ACN(ef:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(ee:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(eh:fac)),4,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))
          ACN(ea:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(ee:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(eh:fac)),0,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))

          * Cond IVA
          ACT(ec:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
          * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*          ACN(ed:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(ec:fac))/100)
          ACN(ed:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(ec:fac))/100)
          
          * IVA
          ACN(eb:fac, Val(ea:fac)*Val(ed:fac))
        else
          ACN(ea:fac, 0)
          ACN(eb:fac, 0)
        endif  
  
     ELSE
        DFA
     ENDIF
   Proximo
   
   IF Val(z:1)=0
      MessageBox('No se encontraron Saldos de la Especie solicitada.')
   ELSE
      CrearListBox ; 'Arial,8,';'Split'~IIF(Dialogo.Check1=1,' Inverso')~': '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') - SALDOS'
