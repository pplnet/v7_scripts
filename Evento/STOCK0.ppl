   SQL.ADD(" WHERE S.Cliente      = C.Codigo  ")
   SQL.ADD("   AND C.Status       = 'HAB' ")
   SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:4))~") ")
   SQL.ADD("   AND S.Especie      = '"~Val(ES:1)~"' ")
   SQL.ADD("   and S.EnteCustodia = '"~Val(VH:1)~"' ")
   SQL.ADD("   and S.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(VH:1)~"' ")
   If Not CeldaVacia(MR:1)
     SQL.ADD(" AND S.Mercado = '"~Val(MR:1)~"' ")
   Endif
   SQL.ADD("   AND S.Fecha       <= "~IdxDate2(Dialogo.Fecha1)~" ")
