           SQL.ADD(" Cantidad9, ")
* FJL 11/04/22 - Se guarda Moneda Comisiones
           SQL.ADD(" Especie2, ")
           SQL.ADD(" RB1, RB2, CB1 ")
           SQL.ADD(" ) VALUES (")
           SQL.ADD(" '"~Val(a:&i)~"', '"~Val(g:&i)~"', "~IdxDate2(Val(fe:1))~", "~IdxDate2(FSys)~", "~IdxDate2(FSys)~", ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', "~FStr(Val(i:&i),1,2)~", '"~Val(h:&i)~"', '"~Val(e:&i)~"',  "~FStr(Val(k:&i),1,8)~", ")
           SQL.ADD(" "~FStr(Val(l:&i),1,2)~", "~FStr(Val(m:&i),1,2)~", '"~Val(vh:1)~"', '"~Val(b:&i)~"', ")
           SQL.ADD(" 'STOCK', '"~Val(aa:1)~"', '"~Val(aa:3)~"', '"~Val(CP:&i)~"', '"~Val(NN:&i)~"', ")
* FJL 26/09/21 - Comisiones Eventos Corporativos
           SQL.ADD(" "~FStr(Val(da:&i),0,0)~", "~FStr(Val(db:&i),0,0)~", ")
* FJL 18/12/21 - Se guarda Monto Moneda (Base Comisiones)
           SQL.ADD(" "~FStr(Val(t:&i),0,2)~", ")
* FJL 11/04/22 - Se guarda Moneda Comisiones
           SQL.ADD(" '"~Val(s:&i)~"', ")
           SQL.ADD(" '2', '0', '"~FStr(Dialogo.Check1,0,0)~"' ")
           SQL.ADD(" ) ")
           SQL.NEW
           SQL.EXEC
           
           SQL.ActualizarMovimientosT2(Val(aa:1),SI,NO,NO,NO)
           SQL.EXEC
           
           SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS (") 
           SQL.ADD(" NrOperacion, NrBit, Valor ")
           SQL.ADD(" ) VALUES ( ")
           SQL.ADD(" '"~Val(aa:1)~"',51, '1')")
           SQL.NEW
           SQL.EXEC
        ENDIF
      Proximo
#endif 
   ENDIF
EndIf

* ----------------------------------------------------------------------------------------- *

ACN(ZZ:1,0)

If Not CeldaVacia(MR:1)
   If SQL(" Select 1 From "~DBO~".TRANSACCIONES2 Where TipoTr2='STOCK' and Especie='"~Val(ES:1)~"' and Fecha2='"~IdxDate(Val(z:6))~"' and Vehiculo1='"~Val(VH:1)~"' and Mercado1='"~Val(MR:1)~"' and RB1=0 ") = 1
      MessageBox('Split ya Ejectutado para Especie '~Val(ES:1)~', Fecha '~Fecha(Val(z:6))~', Vehiculo '~Val(VH:1)~' y Mercado '~Val(MR:1))
      ACN(ZZ:1,1)
   EndIf
Else
   If SQL(" Select 1 From "~DBO~".TRANSACCIONES2 Where TipoTr2='STOCK' and Especie='"~Val(ES:1)~"' and Fecha2='"~IdxDate(Val(FE:1))~"' and Vehiculo1='"~Val(VH:1)~"' and RB1=0 ") = 1
      MessageBox('Split ya Ejectutado para Especie '~Val(ES:1)~', Fecha '~Fecha(Val(FE:1))~' y Vehiculo '~Val(VH:1))
      ACN(ZZ:1,1)
   EndIf
EndIf

*********************************************************************
*********************************************************************
** FJL - Se saca la parte de Posiciones para STD
If Val(ZZ:1)=0 Y NO
   ACN(FI:1, fac+1)
   ***---POSICIONES
   SQL.ADD(" Select P.Cliente, P.Especie, P.Cupon, P.Sector as Mercado, P.Book, P.FechaEj, ")
   SQL.ADD(" P.NrSaldo, P.CantidadFin as Cantidad, C.RazonSocial, P.CallPut, P.PrecioEj, ")
   SQL.ADD(" C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
   SQL.ADD(" From "~DBO~".POSICIONESACCION P, "~DBO~".CLIENTES C ")
   SQL.ADD(" Where P.Cliente = C.Codigo ")
   SQL.ADD(" AND P.Especie = '"~Val(ES:1)~"' ")
   SQL.ADD(" AND P.Cliente = '"~Val(VH:1)~"' ")
   SQL.ADD(" AND P.Vehiculo = '"~Val(VH:1)~"' ")
   SQL.ADD(" and P.NrSaldo = 101 ")
   If Not CeldaVacia(MR:1)
      SQL.ADD(" AND P.Sector = '"~Val(MR:1)~"' ")
   EndIf
   SQL.ADD(" AND P.Fecha = (Select Max(P2.Fecha) From "~DBO~".POSICIONESACCION P2 ")
   SQL.ADD("               Where P.Especie = P2.Especie ")
   SQL.ADD("               AND P.Cliente = P2.Cliente ")
   SQL.ADD("               AND P.Vehiculo = P2.Vehiculo ")
   SQL.ADD("               AND P.NrSaldo = P2.NrSaldo ")
   SQL.ADD("               AND P.Book    = P2.Book ")
   SQL.ADD("               AND P.Sector = P2.Sector ")
   SQL.ADD("               AND P2.Fecha <= '"~IdxDate(Val(FE:1))~"') ")
   
   SQL.ADD(" ORDER BY P.Cliente, Mercado, P.Book ")
   
   ACN(z:1,fac)
   ACN(ZZ:2,fac)
   
   Recorrer SQL
     IF fbn('Cantidad')>0
        SCN(z:1,1)
        
        ACT(a:fac, fbn('Especie'))
        ACT(b:fac, fbn('Cupon'))
        ACN(c:fac, fbn('NrSaldo'))
        ACT(e:fac, fbn('Mercado'))
        ACT(f:fac, fbn('RazonSocial'))
        ACT(g:fac, fbn('Cliente'))
        ACT(h:fac, fbn('Book'))
        ACN(i:fac, fbn('Cantidad'))
        ACN(k:fac, Dialogo.Entero1)
        ACN(l:fac, fbn('Cantidad')*Dialogo.Entero1/100)
        If Dialogo.Check1=0
           ACN(m:fac, Val(l:fac)+Val(i:fac))
        Else
           ACN(m:fac, Val(i:fac)-Val(l:fac))
        EndIf
        ACT(o:fac, fbn('CallPut'))
        ACD(p:fac, fbn('FechaEj'))
        ACN(q:fac, fbn('PrecioEj'))
        ACT(TC:fac, fbn('TipoCliente'))
        
        IF Not Eqstr(Val(G:fac), Val(VH:1))
           ***---'CLI'
           ACT(CP:fac, '')
           ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')"))
           ACN(BD:fac, 1)
           ACN(BB:fac, 0)
        ELSE
           ***---Vehiculo
           ACT(CP:fac, Val(VH:1))
           ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') "))
           ACN(BD:fac, 0)
        ENDIF
        ACN(r:fac, 1)
     ELSE
        DFA
     ENDIF
   Proximo
   
   IF Val(z:1)=Val(ZZ:2)
      MessageBox('No se encontraron Posiciones de la Especie solicitada')
   ELSE
      CrearListBox ; 'Arial,8,';'Split'~IIF(Dialogo.Check1=1,' Inverso')~': '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') - POSICIONES'
        'Ok?'                 ;x:Val(FI:1)..x:Val(z:1);SI;;;30;CHECK ;RGB(255,255,193);;;;;;;;SI
        'Especie'             ;a:Val(FI:1)..a:Val(z:1);NO;;;60;STRING;;RGB(220,220,193)
        'Mercado'             ;e:Val(FI:1)..e:Val(z:1);NO;;;60;STRING;;RGB(220,220,193)
        'Cliente'             ;G:Val(FI:1)..G:Val(z:1);NO;;;60;STRING;;RGB(220,220,193)
        'Nombre'              ;f:Val(FI:1)..f:Val(z:1);NO;;;100;STRING;;RGB(220,220,193)
        'Book'                ;h:Val(FI:1)..h:Val(z:1);NO;;;100;STRING;;RGB(220,220,193)
        'Saldo'               ;i:Val(FI:1)..i:Val(z:1);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
        '%'                   ;k:Val(FI:1)..k:Val(z:1);NO;;;40;NUMERO;'###.##';RGB(220,220,193)
        'Total'               ;l:Val(FI:1)..l:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
        'Nuevo Saldo'         ;m:Val(FI:1)..m:Val(z:1);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
        'Cta.Pesos'           ;nn:Val(FI:1)..nn:Val(z:1);SI;Val(r:FLB)=0 o ClienteCuenta(Val(g:FLB),Val(nn:FLB),VAR('MONELOCA'));'Cuenta Pesos Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Eqstr(Val(G:FLB),Val(VH:1))," Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')", " Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')");RGB(255,255,193);IIF(Eqstr(Val(G:FLB), Val(VH:1)), SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') ") , SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') "));NO;NO;'18';;;;SI     
      FinListBox
      
      IF NOT OK
         Cancelar
      ENDIF
      
      Recorrer&j Val(FI:1), fac
        ***---Sumo los Saldos Seleccionados
        IF Val(r:&j) = 1 Y Val(BD:&j) = 1
           ***---'CLI'
           SCN(SA:1, Val(I:&J))
        ENDIF
        IF Val(r:&j) = 1 Y Val(BD:&j) = 0
           ***---Vehiculo
           SCN(SA:2, Val(I:&J))
        ENDIF
      Proximo
      
      Recorrer&i Val(FI:1),Val(z:1)
        IF Val(r:&i)=1
           *------------------Generar Transaccion--------------------*
           IF Eqstr(Val(o:&i), 'CAL')
              ACT(aa:3,'0')
           ELSE
              IF Eqstr(Val(o:&i), 'PUT')
                 ACT(aa:3,'1')
              ELSE
                 ACT(aa:3,'-1')
              ENDIF
           ENDIF
           ACT(aa:1, GetNumerador(20))
           
           message('Transaccion Nro. '~Val(aa:1)~'...')
           
           SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 (")
           SQL.ADD(" Especie, Cliente1, Fecha2, FechaCarga, FechaCargaSys, ")
           SQL.ADD(" Fecha1, Cantidad1, Book1, Mercado1, Precio1, ")
           SQL.ADD(" Cantidad2, Cantidad3, Vehiculo1, Cupon1, ")
           SQL.ADD(" TipoTr2, NrTrans, CallPut, Cliente3, Cuenta4, ")
           SQL.ADD(" RB1, RB2, CB1 ")
           SQL.ADD(" ) VALUES (")
           SQL.ADD(" '"~Val(a:&i)~"', '"~Val(g:&i)~"', "~IdxDate2(Val(fe:1))~", "~IdxDate2(FSys)~", "~IdxDate2(FSys)~", ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', "~FStr(Val(i:&i),1,2)~", '"~Val(h:&i)~"', '"~Val(e:&i)~"',  "~FStr(Val(k:&i),1,8)~", ")
           SQL.ADD(" "~FStr(Val(l:&i),1,2)~", "~FStr(Val(m:&i),1,2)~", '"~Val(vh:1)~"', '"~Val(b:&i)~"', ")
           SQL.ADD(" 'STOCK', '"~Val(aa:1)~"', '"~Val(aa:3)~"', '"~Val(CP:&i)~"', '"~Val(NN:&i)~"', ")
           SQL.ADD(" '0', '0', '"~FStr(Dialogo.Check1,0,0)~"' ")
           SQL.ADD(" ) ")
           SQL.NEW
           SQL.EXEC
           
           SQL.ActualizarMovimientosT2(Val(aa:1),NO,NO,NO,SI)
           SQL.EXEC
           
           SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS (") 
           SQL.ADD(" NrOperacion, NrBit, Valor ")
           SQL.ADD(" ) VALUES ( ")
           SQL.ADD(" '"~Val(aa:1)~"',51, '1')")
           SQL.NEW
           SQL.EXEC
        ENDIF
      Proximo
   ENDIF
EndIf
