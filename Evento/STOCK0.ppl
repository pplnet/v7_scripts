        'Cta.Comision'        ;nn:1..nn:Val(fi:2);SI;Val(r:FLB)=0 o ClienteCuenta(Val(g:FLB),Val(nn:FLB),Val(s:FLB));'Cuenta Pesos Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Eqstr(Val(G:FLB),Val(VH:1))," Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')", " Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')");RGB(255,255,193);IIF(Eqstr(Val(G:FLB), Val(VH:1)), SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') ") , SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') "));NO;NO;'18';;;;SI     
