        'Mercado'             ;e:1..e:Val(fi:2);NO;;;60;STRING;;RGB(220,220,193)
        'Cliente'             ;g:1..g:Val(fi:2);NO;;;60;STRING;;RGB(220,220,193)
        'Nombre'              ;f:1..f:Val(fi:2);NO;;;100;STRING;;RGB(220,220,193)
        'Cuenta Especie'      ;h:1..h:Val(fi:2);NO;;;100;STRING;;RGB(220,220,193)
        'Saldo'               ;i:1..i:Val(fi:2);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
        '%'                   ;k:1..k:Val(fi:2);NO;;;40;NUMERO;'###.##';RGB(220,220,193)
        'Total'               ;l:1..l:Val(fi:2);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
        'Nuevo Saldo'         ;m:1..m:Val(fi:2);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
        'Valuacion'           ;t:1..t:Val(fi:2);NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
