   ACN(FI:1, fac+1)
   ***---MOVPENDIENTES
   SQL.ADD("SELECT M.Cliente, M.Especie, M.Cupon, M.Mercado, M.Cuenta, M.FechaEj, ")
   SQL.ADD("       M.NrSaldo, SUM(M.Cantidad) Cantidad, C.RazonSocial, M.CallPut, M.PrecioEj, ")
   SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*   SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O ")
   SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS CU ")
   SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
   SQL.ADD("   and C.Status       = 'HAB' ")   
   SQL.ADD("   AND M.NrSaldo      = 1 ")
   SQL.ADD("   AND M.Especie      = '"~Val(ES:1)~"' ")
   SQL.ADD("   AND M.NrOperacion  = O.NrOperacion ")
** FJL 24/05/21 - Cambio de criterio
*   SQL.ADD(" AND M.Cliente = '"~Val(VH:1)~"'")
*   SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Val(VH:1)~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*   SQL.ADD("       OR ('"~Val(VH:1)~"' = C.Codigo AND 'HAB' = C.Status )) ")
   SQL.ADD("   AND M.EnteCustodia = '"~Val(VH:1)~"' ")
   SQL.ADD("   and M.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(VH:1)~"' ")
   If Not CeldaVacia(MR:1)
     SQL.ADD(" AND M.Mercado      = '"~Val(MR:1)~"'")
   EndIf
   SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Val(FE:1))~"' ")
   SQL.ADD(" GROUP BY M.Cliente, M.Especie, M.Cupon, M.Mercado, M.Cuenta, M.FechaEj, ")
   SQL.ADD("          M.NrSaldo, C.RazonSocial, M.CallPut, M.PrecioEj, ")
   SQL.ADD("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
   
   SQL.ADD(" Union ")
   
   SQL.ADD("SELECT M.Cliente, M.Especie, M.Cupon, M.Mercado, M.Cuenta, M.FechaEj, ")
   SQL.ADD("       M.NrSaldo, SUM(M.Cantidad) Cantidad, C.RazonSocial, M.CallPut, M.PrecioEj, ")
   SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*   SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS CU ")
   SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
   SQL.ADD("   and C.Status       = 'HAB' ")   
   SQL.ADD("   AND M.NrSaldo      = "~Fstr(Val(SL:1), 0, 0)~" ")
   SQL.ADD("   AND M.Especie      = '"~Val(ES:1)~"' ")
   SQL.ADD("   AND M.NrOperacion  = T.NrTrans ")
   SQL.ADD("   AND (T.TipoTr2 not in ('STOCK','DTP','RTP') or (CB6 = '0' and  T.TipoTr2 in ('DTP','RTP'))) ")
** FJL 24/05/21 - Cambio de criterio
*   SQL.ADD(" AND M.Cliente = '"~Val(VH:1)~"'")
*   SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Val(VH:1)~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*   SQL.ADD("       OR ('"~Val(VH:1)~"' = C.Codigo AND 'HAB' = C.Status )) ")
   SQL.ADD("   AND M.EnteCustodia = '"~Val(VH:1)~"' ")
   SQL.ADD("   and M.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(VH:1)~"' ")
   If Not CeldaVacia(MR:1)
     SQL.ADD(" AND M.Mercado      = '"~Val(MR:1)~"'")
   EndIf
   SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Val(FE:1))~"'  ")
   SQL.ADD(" GROUP BY M.Cliente, M.Especie, M.Cupon, M.Mercado, M.Cuenta, M.FechaEj, ")
   SQL.ADD("          M.NrSaldo, C.RazonSocial, M.CallPut, M.PrecioEj, ")
   SQL.ADD("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
   
   SQL.ADD(" ORDER BY M.Cliente, M.Mercado, M.Cuenta ")
   
   ACN(z:1,fac)
   ACN(ZZ:2,fac)
   
   Recorrer SQL
     SCN(z:1,1)
     
     ACT(a:fac, fbn('Especie'))
     ACT(b:fac, fbn('Cupon'))
     ACN(c:fac, fbn('NrSaldo'))
     ACT(e:fac, fbn('Mercado'))
     ACT(f:fac, fbn('RazonSocial'))
     ACT(g:fac, fbn('Cliente'))
     ACT(h:fac, fbn('Cuenta'))
     ACN(i:fac, -fbn('Cantidad'))
     ACN(k:fac, Dialogo.Entero1)
     ACN(l:fac, -fbn('Cantidad')*Dialogo.Entero1/100)
     If Dialogo.Check1=0
        ACN(m:fac, Val(l:fac)+Val(i:fac))
        ACN(mm:fac, -(Val(l:fac)+Val(i:fac)))
     Else
        ACN(m:fac, Val(i:fac)-Val(l:fac))
        ACN(mm:fac, -(Val(i:fac)-Val(l:fac)))
     EndIf
     ACT(o:fac, fbn('CallPut'))
     ACD(p:fac, fbn('FechaEj'))
     ACN(q:fac, fbn('PrecioEj'))
     ACT(TC:fac, fbn('TipoCliente'))
     
     ** FJL 11/04/22 - Moneda Comision
     ACT(s:fac, Val(es:2))
** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar la cuenta. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
     IF Not Eqstr(Val(G:fac), Val(VH:1))
        ***---'CLI'
        ACT(CP:fac, '')
*        ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%')"))
        ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
        ACN(BD:fac, 1)
        ACN(BB:fac, 0)
     ELSE
        ***---Vehiculo
        ACT(CP:fac, Val(VH:1))
*        ACT(NN:fac, SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') "))
        ACT(NN:fac, SQL(" Select TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:fac)~"' AND Estado = 'HAB' AND (Especies LIKE  '%"~Var('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
        ACN(BD:fac, 0)
     ENDIF
     ACN(r:fac, 1)
     ** FJL 18/11/21 - Valuacion de la accion origen para calcular comisiones
     ACN(t:fac, Val(i:fac)*Val(co:1))

     if Not EqStr(Val(g:fac),Val(vh:1)) y Val(t:fac)>0
       ACT(de:fac, 'SPLIT')
       ACN(dg:fac, COTIZACIONC(val(es:2),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
       ACN(dh:fac, iif(EqStr(Modo(val(es:2),VAR('MONELOCA')),'INV'),1/val(dg:fac),val(dg:fac)))
       
       ACN(df:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),4,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))
       ACN(da:fac, MontoArancelC(,Val(g:fac),Val(es:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),0,,,,'STOCK',Val(e:fac),,,SI,SI,,SI))

       * Cond IVA
       ACT(dc:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
       * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*       ACN(dd:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(dc:fac))/100)
       ACN(dd:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(dc:fac))/100)
          
       * IVA
       ACN(db:fac, Val(da:fac)*Val(dd:fac))
     else
       ACN(da:fac, 0)
       ACN(db:fac, 0)
     endif  
   Proximo
   
   IF Val(z:1)=Val(ZZ:2)
      MessageBox('No se encontraron Movimientos de la Especie solicitada')
   ELSE
