MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1  : 'D.FechaConc' ;1;1;;;;;;;FSYS
  Fecha2  : 'H.FechaConc' ;2;1;;;;;;;FSYS
  Label1   : ''           ;3; ;;NO;;;;;'Concilia por ______________________________________________________________________'
  Check1   : 'Fecha'      ;4; ;;;;;;;1
  Check3   : 'Importe'    ;5; ;;;;;;;1
  Cantidad1: 'Tolerancia' ;5;2;;;Dialogo.Check3=0;;;;1 
  Label2   : ''           ;6;1;;NO;;;;;'_______________________________________________________________________________________'
  Lista1:   'Vehiculos'   ; 7;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista2:   'Bancos'      ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'     ;-5;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
  Check4:   'Confirma'    ;1;2;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ C.NrOperacion, T.TipoTr2, T.CNFormaPago, FP.Tipo, M.Cuenta, T.Cliente2, ")
SQL.ADD(" M.Cantidad, C.Fecha, T.NrTrans, T.Fecha1, M.FechaMov, M.Especie, T.Cantidad2, T.Vehiculo1  ")
SQL.ADD(" FROM "~DBO~".CONCILIACIONES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".CNFORMASPAGOCOBRO FP, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE C.NrOperacion = T.NrTrans     ")
SQL.ADD(" AND   T.NrTrans     = M.NrOperacion ")
SQL.ADD(" AND   T.CNFormaPago = FP.Codigo ")
SQL.ADD(" AND   C.Fecha       >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   C.Fecha       <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   T.TipoTr2     = 'DEVM' ")
SQL.ADD(" AND   FP.Tipo       = 'CHE' ")
SQL.ADD(" AND   (T.CB5 = '0' OR T.CB5 IS NULL OR T.CB5='') ")
If NoVAcio(Dialogo.Lista2)
  SQL.ADD(" AND T.Cliente2 IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVAcio(Dialogo.Lista3)
  SQL.ADD(" AND M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND T.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY T.Vehiculo1, T.Cliente2, M.Cuenta, M.FechaMov, T.Cantidad2 ")

ACN(z:1,  0)
ACN(tc:1, 0)

Recorrer SQL
  ACN(z:1, 1)
  ACN(a:fac, 1)
  ACD(b:fac, fbn('Fecha'))
  ACT(c:fac, fbn('NrTrans'))
  ACD(d:fac, fbn('Fecha1'))
  ACD(e:fac, fbn('FechaMov'))
  ACT(f:fac, fbn('Especie'))
  ACN(g:fac, fbn('Cantidad'))
  ACT(h:fac, fbn('Cliente2'))
  ACT(i:fac, fbn('Cuenta'))
  ACN(j:fac, fbn('Cantidad2'))
  ACT(k:fac, fbn('Vehiculo1'))
  SCN(tc:1,1)
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron cheques conciliados para los parametros solicitados.')
Endif

SQL.ADD(" SELECT /*+ RULE */ M.*, C.Comitente ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C ")
SQL.ADD(" WHERE M.Cuenta  = C.Codigo ")
SQL.ADD(" AND   M.NrSaldo = 99 ")
If NoVAcio(Dialogo.Lista2)
  SQL.ADD(" AND C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVAcio(Dialogo.Lista3)
  SQL.ADD(" AND M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.EnteCustodia  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY M.EnteCustodia, C.Comitente, M.Cuenta, M.FechaMov ")
Recorrer SQL
  Recorrer&i 1, Val(tc:1)

    ACN(kk:1, 1)
    ACN(mt:1, 0)

    If Eqstr(fbn('EnteCustodia'),Val(k:&i)) y Eqstr(fbn('Cuenta'),Val(i:&i)) y Val(aa:&i)<>1
      If Dialogo.Check1=1 y fbn('FechaMov')<>Val(e:&i)
         message('No es la misma fecha.')
         ACN(kk:1, 0)
      Endif
      If Dialogo.Check3=1 
        If abs(fbn('Cantidad'))<>Abs(Val(g:&i))
          message('No es la misma cantidad.')
          ACN(kk:1, 0)
        Endif
      Else
        If ABS(abs(fbn('Cantidad'))-abs(Val(g:&i))) >Dialogo.Cantidad1
          message('Supera el rango de tolerancia.')
          ACN(kk:1, 0)
        Else
          ACN(mt:1, ( abs(fbn('Cantidad'))-abs(Val(g:&i)) ) )
        Endif
      Endif 
    Else
      message('No es la misma Cuenta ni Vehiculo.')
      If Val(aa:&i)=1
        message('Matcheo con la operacion '~Val(ab:&i))
      Endif
      ACN(kk:1, 0)
    Endif

    If Val(kk:1)=1
      ACN(aa:&i, 1 ) 
      ACT(ab:&i, fbn('NrOperacion') ) 
      ACN(ac:&i, fbn('NrMov') ) 
      ACT(ad:&i, fbn('Comitente') ) 
      ACT(ae:&i, fbn('Cuenta') ) 
      ACT(af:&i, fbn('Especie') ) 
      ACN(ah:&i, fbn('Cantidad')) 
      ACD(am:&i, fbn('FechaMov')) 
      ACT(an:&i, fbn('EnteCustodia')) 
      message('Movimiento encontrado.')
      Break
    Endif

    If Val(kk:1)=0
      message('El Cheque de la transaccion '~fbn('NrOperacion')~' no conciliado.')
    Endif
  Proximo
Proximo

If Val(tc:1)=0
  Cancelar
Endif


If Dialogo.Check4=1
  CrearListBox; 'Arial,8,'
   'Vehiculo'      ;k:1..k:Val(tc:1);NO;;;80;STRING;;RGB(232,232,232);
   'Banco'         ;h:1..h:Val(tc:1);NO;;;80;STRING;;RGB(232,232,232);
   'Cuenta'        ;i:1..i:Val(tc:1);NO;;;80;STRING;;RGB(232,232,232);
   'FechaMov'      ;e:1..e:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'FechaOp'       ;d:1..d:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'F.Conciliacion';b:1..b:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'NrTrans'       ;c:1..c:Val(tc:1);NO;;;70;STRING;;RGB(232,232,232);
   'Moneda'        ;f:1..f:Val(tc:1);NO;;;60;STRING;;RGB(232,232,232);
   'Importe'       ;g:1..g:Val(tc:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Cheque'        ;j:1..j:Val(tc:1);NO;;;70;NUMERO;'###,###,###,###';RGB(232,232,232);
   'OK'          ;aa:1..aa:Val(tc:1);SI;Val(aa:flb)=0 o NoVacio(Val(ab:flb));'Voucher Invalido';30;CHECK; RGB(232,255,215);
   'Vehiculo'    ;an:1..an:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Banco'       ;ad:1..ad:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Cuenta'      ;ae:1..ae:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'FechaMov'    ;am:1..am:Val(tc:1);NO;;;70;FECHA ; RGB(221,242,255);
   'Moneda'      ;af:1..af:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Cantidad'    ;ah:1..ah:Val(tc:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(221,242,255);
   'Voucher'     ;ab:1..ab:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
  FinListBox

  If Not Ok
    Cancelar
  Endif
Endif

Recorrer&i 1,fac
  If Val(aa:&i)=1
    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET NrTransRef1 = '"~Val(c:&i)~"' WHERE NrTrans = '"~Val(ab:&i)~"' ")
    SQL.NEW

    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET CB5 = '1' WHERE NrTrans = '"~Val(c:&i)~"' ")
    SQL.NEW

    SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
    SQL.ADD(" FechaEje, UsuarioEje, NrTrans2, NrOperacion, ")
    SQL.ADD(" Leyenda, Cantidad, Cliente, Especie, ")
    SQL.ADD(" CallPut, NrSaldo, NrGrupo, NrGrupo2, ")
    SQL.ADD(" Bits, Cupon, NrMov, NrInstan, ")
    SQL.ADD(" FechaMov, EnteCustodia, Cuenta, Transaccion ) ")
    SQL.ADD(" SELECT "~Idxdate2(Val(b:&i))~", '"~USUARIOACTIVO~"', NrTrans2, NrOperacion, ")
    SQL.ADD(" Leyenda, Cantidad, Cliente, Especie, ")
    SQL.ADD(" CallPut, NrSaldo, NrGrupo, NrGrupo2, ")
    SQL.ADD(" Bits, Cupon, NrMov, NrInstan, ")
    SQL.ADD(" FechaMov, EnteCustodia, Cuenta, Transaccion  ")
    SQL.ADD(" FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(ab:&i)~"' AND NrMov = "~Fstr(Val(ac:&i),0,0)~" AND NrSaldo=99 ")
    SQL.NEW
   
    SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(ab:&i)~"' AND NrMov = "~Fstr(Val(ac:&i),0,0)~" AND NrSaldo=99 ")
    SQL.NEW
    SQL.EXEC
    message(' Voucher '~Val(ab:&i)~' conciliado.')
  Endif
Proximo
