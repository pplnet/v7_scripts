Message('Evento Reversa INTSEC e INTSECBP')
Message('Reversa de Devengados de Fin de Mes')
Sqladd(" Select A.NrUnicoAsiento, A.FechaValor ")
Sqladd(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ASIENTOSCON1 A1 ")
Sqladd(" Where MA.Codigo = A.Modelo ")
Sqladd(" AND A.Vehiculo in (SELECT Codigo FROM "~Dbo()~".VEHICULOS WHERE Status = 'HAB') ")
Sqladd(" AND A.NrUnicoAsiento = A1.NrUnicoAsiento ")
Sqladd(" AND A1.NrItem = (SELECT MIN(NrItem) FROM "~Dbo()~".ASIENTOSCON1 B1 WHERE B1.NrUnicoAsiento = A1.NrUnicoAsiento ) ")
Sqladd(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASINTSE'))~") ")
Sqladd(" AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') ")
Sqladd(" AND A.FechaValor = (Select Max(B.FechaValor) From "~Dbo()~".ASIENTOSCON B, "~Dbo()~".ASIENTOSCON1 B1 ")
Sqladd("         Where A.NrUnicoAsiento = B.NrUnicoAsiento ")
Sqladd("         AND A1.NrItem = B1.NrItem ")
Sqladd("         AND A.Modelo = B.Modelo ")
Sqladd("         AND A.Vehiculo = B.Vehiculo ")
Sqladd("         AND B.FechaValor <= '"~IdxDate(dialogo.fecha1)~"') ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND A.Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND A.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" AND A.Vehiculo Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND A.FechaValor >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
recorrer sql
