#ifdef CMF
    CrearDialogo    
    Fecha1:"Fecha"     ;;;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha ';NO;FSys
        Label1:'Actualizar'
        Check1:'Clientes'
        Check2:'Cuentas'
        Check3:'Integrantes'
        Check4:'Saldos'      ;;;;;;;;;1;
        Fecha2:"Habil anterior"  ;;;;NO;NO;;'Debe Ingresar una Fecha ';NO;;Habiles(Dialogo.Fecha1, -1,VAR('FERIDEF'), SI)
    FinDialogo

    If Not OK
      Cancelar
    Endif
    *1-Ejecucion de Novedades
    Message("Ejecutando evento de Novedades")
    If Dialogo.Check1 = 1 o Dialogo.Check2 = 1 o Dialogo.Check3 = 1
        EjecutarEvento('ACTUAL', Label1 = Dialogo.Label1, Check1 = Dialogo.Check1, Check2 = Dialogo.Check2, Check3 = Dialogo.Check3)
    Endif

    if Dialogo.Check4 = 1
    *2-Ejecucion de Alta de saldos
        Message("Ejecutando evento de Alta de saldos")
        EjecutarEvento('INTALS', Directorio1 = Var('PATHINTALS'), String1 = Var('NOMALS')~Copy(Dialogo.Fecha2,7,8)~Copy(Dialogo.Fecha2,4,2)~Copy(Dialogo.Fecha2,1,2), Fecha1 = Dialogo.Fecha2)

    Endif

    MessageBox("Apertura finalizada")
#endif