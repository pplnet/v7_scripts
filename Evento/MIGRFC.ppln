MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';2;1;;SI;SI;dialogo.fecha1 <> 0 y EsHabil(dialogo.fecha1, Var('FERIDEF'));'En fecha a tomar como base, debe Ingresar un dia habil';NO;FSys();
label1:'';1;1;;NO;;;;;;'Cotizaciones a procesar';;;
check1: 'Procesa';1;2;;NO;NO;;;;1;

findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0 o SI)
HojaVisible(SI)
endif

if (Query("Select 1 From "~Dbo()~".FLAGSMERCADO Where Fecha="~IdxDate2(dialogo.fecha1)~" and Registro='MCR' and Estado='PRO' ") = 1)
if (Messagebox('Ya se habia migrado las cotizaciones. Continua????', 3, 2) <> 6)
Cancelar('La migracion de las cotizaciones ha sido cancelado!!!')
endif
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

agregarbmp(a1, Exe('LOGO'), Exe('ESCALOGO'))

Act(a3, 'Migracion Cotizaciones ROFEX del '~Fecha(dialogo.fecha1))
SetFont(a3, 3)

Act(a:5, 'Fecha')
Act(b:5, 'Posicion')
Act(c:5, 'Precio')
Act(d:5, 'Fecha Vto.')
Act(e:5, 'Esp.FPA')
Act(f:5, 'Fecha Vto.')
Act(g:5, 'Accion Plazo')
Act(h:5, 'Accion Cotiz')
Act(i:5, 'Accion Flag')

Act(k:5, 'E:')
Act(l:5, 'Cont. Vto')
Act(m:5, 'Esp Alias 10')
Act(n:5, 'TB:')
Act(o:5, 'TB = 1')

SetFont(a:5..p:5, 1)
AgregarMarco(a:5..i:5, 2, 0, Exe('COLOR6'))
AlinearCeldas(a:5..i:5, 'C')

SetFilaActual(6)
Acn(z:1, 0)

Message('Recuperando Cotiz. Rofex...')
Sqladd("Select * From "~Dbo()~".COTIZACIONESROFEX ")
Sqladd(" where isnull(Procesado,'0')='0' ")
Sqladd("   and SUBSTRING(Posicion,1,3) = 'DLR' ")
Sqladd("   and Convert(Date,FechaReal)   <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("Order by SUBSTRING(Posicion,1,3),FechaVto ")
Watch(Sqlbatch())
recorrer sql
Message('...'~Fbn()['Posicion'])
Act(a:fac, Fbn()['Fecha'])
Act(b:fac, Fbn()['Posicion'])
Acn(c:fac, Fbn()['Ajuste'])
Act(d:fac, Fbn()['FechaVto'])
Act(e:fac, BuscarCampo('PLAZOSMERCADO', 'Especie', 'NombreExtendido', Fbn()['Posicion']))
Act(fp:fac, BuscarCampo('PLAZOSMERCADO', 'FechaVto', 'NombreExtendido', Fbn()['Posicion']))
Acn(fs:fac, Query("Select 1 From "~Dbo()~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))

if (Val(fs:fac) = 1)
Acd(fv:fac, Query("Select MaturityDate From "~Dbo()~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))
else
Act(ft:fac, Copy(Val(b:fac), Longitud(Val(b:fac)) - 3, 4)~'-'~Copy(Val(b:fac), Longitud(Val(b:fac)) - 5, 2)~'-01')
Acd(fv:fac, FinDeMes(Fecha(Val(ft:fac)), NO, 'ARG'))
endif

Acd(f:fac, Val(fv:fac))

Acn(tb:fac, 0)
if (NoVacio(Val(e:fac)))
Act(k:fac, 'Existe Especie Plazo')
if (Val(fp:fac) <> Val(fv:fac))
Sqladd("Update "~Dbo()~".PLAZOSMERCADO ")
Sqladd(" Set FechaVto =  "~IdxDate2(Val(fv:fac))~" ")
Sqladd(" Where MercadoNegociacion = '"~Var('MERROFEX')~"' ")
Sqladd("   And NombreExtendido    = '"~Val(b:fac)~"' ")
Sqladd("   And Especie            = '"~Val(e:fac)~"' ")
Sqlnew()
Sqlexec()
endif

Acn(tb:fac, 1)
else
Act(k:fac, 'NO Existe Especie Plazo')
if (Val(fv:fac) >= dialogo.fecha1)
Act(l:fac, 'Vto mayor hoy')
Act(e:fac, Query("Select Codigo From "~Dbo()~".ESPECIES Where Alias10 = '"~Copy(Val(b:fac), 1, Longitud(Val(b:fac)) - 6)~"' "))
if (NoVacio(Val(e:fac)))
Act(m:fac, 'Esta Esp.c/Alias10')
Act(g:fac, 'Insert Plazo')
if (dialogo.check1 = 1)
Sqladd("Insert INTO "~Dbo()~".PLAZOSMERCADO ( ")
Sqladd("       NombreExtendido, Especie, FechaVto, MercadoNegociacion ")
Sqladd("     ) VALUES ( ")
Sqladd("       '"~Val(b:fac)~"',")
Sqladd("       '"~Val(e:fac)~"', ")
Sqladd("       "~IdxDate2(Val(fv:fac))~", ")
Sqladd("       '"~Var('MERROFEX')~"' ")
Sqladd("     ) ")
Sqlnew()
Sqlexec()
Acn(tb:fac, 1)
endif
else
Act(m:fac, 'No esta Alias10')
endif
else
Act(l:fac, 'Fecha Vto. Menor')
endif
endif

Acn(n:fac, Val(tb:fac))
if (Val(tb:fac) = 1)
Act(o:fac, 'TB = 1')
if (Query("select 1 from "~Dbo()~".COTIZACIONESFUT where Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(dialogo.fecha1)~" and FechaFut="~IdxDate2(Val(fv:fac))~" and CallPut='FUT' ") = 0)
Message('Generando cotizaciones...')
Act(h:fac, 'Insert Cotizacion')
if (dialogo.check1 = 1)
Sqladd("Insert into "~Dbo()~".COTIZACIONESFUT ( ")
Sqladd("       Fecha,       CallPut,      Codigo,  Precio1,  ")
Sqladd("       FechaFut,    Moneda,       Mercado, PrecioEj, ")
Sqladd("       FechaUltAct, UsuarioUltAct ")
Sqladd("     ) Values ( ")
Sqladd("       "~IdxDate2(dialogo.fecha1)~",")
Sqladd("       'FUT', ")
Sqladd("       '"~Val(e:fac)~"', ")
Sqladd("       "~FStr(Fbn()['Ajuste'], 0, 9)~", ")

Sqladd("       "~IdxDate2(Val(fv:fac))~", ")
Sqladd("       '"~Var('MONELOCA')~"', ")
Sqladd("       '"~Var('MERROFEX')~"', ")
Sqladd("       "~FStr(0, 0, 0)~", ")

Sqladd("       "~SQLAhora()~", ")
Sqladd("       '"~UsuarioActivo()~"' ")
Sqladd("     ) ")
Sqlnew()
endif
else
Message('Actualizando cotizaciones...')
Act(h:fac, 'update Cotizacion')
if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".COTIZACIONESFUT ")
Sqladd("   Set Precio1       = "~FStr(Fbn()['Ajuste'], 0, 9)~", ")
Sqladd("       FechaUltAct   = "~SQLAhora()~", ")
Sqladd("       UsuarioUltAct = '"~UsuarioActivo()~"' ")
Sqladd(" where Codigo   = '"~Val(e:fac)~"'  ")
Sqladd("   and Fecha    = "~IdxDate2(dialogo.fecha1)~"  ")
Sqladd("   and FechaFut = "~IdxDate2(Val(fv:fac))~"  ")
Sqladd("   and CallPut  = 'FUT' ")
Sqlnew()
endif
endif

Scn(z:1, 1)
if (dialogo.check1 = 1)
Message('Procesado COTIZACIONESROFEX...')
Sqladd("Update "~Dbo()~".COTIZACIONESROFEX ")
Sqladd("   Set Procesado = '1' ")
Sqladd(" where Fecha     = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("   and Posicion  = '"~Val(b:fac)~"' ")
Sqlnew()
Sqlexec()
endif
endif
FormatoCeldas(c:fac, Exe('F8'))
AlinearCeldas(a:fac..b:fac, 'C')
AlinearCeldas(d:fac..e:fac, 'C')
SetFont(a:fac..e:fac, 2)

proximo

if (Val(z:1) > 0)
if (Query("Select 1 From "~Dbo()~".FLAGSMERCADO  Where Fecha="~IdxDate2(dialogo.fecha1)~" and Registro='MCR' ") = 0)
Act(i:fac, 'Insert Flag')
if (dialogo.check1 = 1)
Sqladd(" Insert into "~Dbo()~".FLAGSMERCADO ( ")
Sqladd(" Fecha,  Registro,     Cantidad, HoraMercado, ")
Sqladd(" Estado, FechaMercado, Mercado,  Descripcion ")
Sqladd(" ) Values (")
Sqladd(" "~IdxDate2(dialogo.fecha1)~",")
Sqladd(" 'MCR', ")
Sqladd(" "~FStr(Val(z:1), 0, 0)~", ")
Sqladd(" '"~Copy(Hora(Ahora()), 1, 2)~Copy(Hora(Ahora()), 4, 2)~Copy(Hora(Ahora()), 7, 2)~"', ")

Sqladd("  'PRO', ")
Sqladd(" "~Copy(IdxDate2(FSys()), 3, 2)~Copy(IdxDate2(FSys()), 6, 2)~Copy(IdxDate2(FSys()), 9, 2)~", ")
Sqladd(" '"~Var('MERROFEX')~"', ")
Sqladd(" 'Migracion Cot ROFEX' ")
Sqladd(" ) ")
endif
else
Act(i:fac, 'Update Flag')
if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".FLAGSMERCADO ")
Sqladd(" Set HoraMercado = '"~Copy(Hora(Ahora()), 1, 2)~Copy(Hora(Ahora()), 4, 2)~Copy(Hora(Ahora()), 7, 2)~"', ")
Sqladd("     Estado      = 'PRO', ")
Sqladd("     Cantidad    = "~FStr(Val(z:1), 0, 0)~" ")
Sqladd(" Where Fecha     = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" and Registro    = 'MCR' ")
endif
endif
if (dialogo.check1 = 1)
Sqlnew()
Sqlexec()
endif
Messagebox('El proceso de migracion cotizaciones finalizo correctamente!!!')
else
Messagebox('No existen cotizaciones para procesar!!!')
endif

SetFilaActual(Fac() + 2)
Act(a:fac, 'Fin listado')
SetFont(a:fac, 1)

ACO(1, 8)
ACO(2, 8)
ACO(3, 8)
ACO(4, 8)
ACO(5, 6)
ACO(6, 8)
ACO(7, 10)
ACO(8, 10)
ACO(9, 10)

ACO(11, 15)
ACO(12, 15)
ACO(13, 15)
ACO(14, 8)
ACO(15, 8)

LimitesVision(j:fac + 2)

