MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1  : 'D.FechaConc' ; 1;1;;;;;;;FSYS
  Fecha2  : 'H.FechaConc' ; 2;1;;;;;;;FSYS
  Lista1:   'Vehiculos'   ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista2:   'Bancos'      ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'     ;-9;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ C.NrOperacion, T.TipoTr2, T.CNFormaPago, FP.Tipo, M.Cuenta, T.Cliente2,   ")
SQL.ADD(" M.Cantidad, C.Fecha, T.NrTrans, T.Fecha1, M.FechaMov, M.Especie, T.Cantidad2,    ")
SQL.ADD(" T.Vehiculo1, T2.NrTrans NrTransV, T2.TipoTr2 TipoTr2V, T2.Cliente1 ClienteV,     ")
SQL.ADD(" T2.Fecha2 Fecha2V, T2.Especie EspecieV, T2.Cantidad1 Cantidad1V, M2.NrMov NrMov2 ")
SQL.ADD(" FROM "~DBO~".CONCILIACIONES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".CNFORMASPAGOCOBRO FP, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M2  ")
SQL.ADD(" WHERE C.NrOperacion = T.NrTrans      ")
SQL.ADD(" AND   T.NrTrans     = M.NrOperacion  ")
SQL.ADD(" AND   T.NrTrans     = T2.NrTransRef1 ")
SQL.ADD(" AND   T2.NrTrans    = M2.NrOperacion  ")
SQL.ADD(" AND   C.Fecha       >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   C.Fecha       <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   M2.NrSaldo    = 99 ")
SQL.ADD(" AND   T.CNFormaPago = FP.Codigo ")
SQL.ADD(" AND   T.TipoTr2     = 'DEVM' ")
SQL.ADD(" AND   FP.Tipo       = 'CHE' ")
If NoVAcio(Dialogo.Lista2)
  SQL.ADD(" AND T.Cliente2 IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVAcio(Dialogo.Lista3)
  SQL.ADD(" AND M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND T.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY T.Vehiculo1, T.Cliente2, M.Cuenta, M.FechaMov, T.Cantidad2 ")

ACN(z:1,  0)
ACN(tc:1, 0)

Recorrer SQL
  ACN(z:1, 1)
  ACN(a:fac, 0)
  ACD(b:fac, fbn('Fecha'))
  ACT(c:fac, fbn('NrTrans'))
  ACD(d:fac, fbn('Fecha1'))
  ACD(e:fac, fbn('FechaMov'))
  ACT(f:fac, fbn('Especie'))
  ACN(g:fac, fbn('Cantidad'))
  ACT(h:fac, fbn('Cliente2'))
  ACT(i:fac, fbn('Cuenta'))
  ACN(j:fac, fbn('Cantidad2'))
  ACT(k:fac, fbn('Vehiculo1'))

  ACT(l:fac, fbn('NrTransV'))
  ACT(m:fac, fbn('TipoTr2V'))
  ACD(n:fac, fbn('Fecha2V'))
  ACT(o:fac, fbn('ClienteV'))
  ACT(p:fac, fbn('EspecieV'))
  ACN(q:fac, fbn('Cantidad1V'))
  ACN(r:fac, fbn('NrMov2'))
  SCN(tc:1,1)
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron cheques conciliados para los parametros solicitados.')
Endif

CrearListBox; 'Arial,8,'
   'F.Conciliacion';b:1..b:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'NrTrans'       ;c:1..c:Val(tc:1);NO;;;70;STRING;;RGB(232,232,232);
   'FechaOp'       ;d:1..d:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'FechaMov'      ;e:1..e:Val(tc:1);NO;;;70;FECHA ; RGB(232,232,232);
   'Vehiculo'      ;k:1..k:Val(tc:1);NO;;;70;STRING;;RGB(232,232,232);
   'Banco'         ;h:1..h:Val(tc:1);NO;;;70;STRING;;RGB(232,232,232);
   'Cuenta'        ;i:1..i:Val(tc:1);NO;;;70;STRING;;RGB(232,232,232);
   'Moneda'        ;f:1..f:Val(tc:1);NO;;;60;STRING;;RGB(232,232,232);
   'Importe'       ;g:1..g:Val(tc:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Cheque'        ;j:1..j:Val(tc:1);NO;;;70;NUMERO;'###,###,###,###';RGB(232,232,232);
   'OK'            ;a:1..a:Val(tc:1);SI;;;30;CHECK; RGB(232,255,215);
   'Voucher'       ;l:1..l:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Tipo'          ;m:1..m:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'FechaLiq'      ;n:1..n:Val(tc:1);NO;;;70;FECHA ; RGB(221,242,255);
   'Cliente'       ;o:1..o:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Moneda'        ;p:1..p:Val(tc:1);NO;;;70;STRING;;RGB(221,242,255);
   'Importe'       ;q:1..q:Val(tc:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(221,242,255);
FinListBox

If Not Ok
  Cancelar
Endif


Recorrer&i 1,Val(tc:1)
  If Val(a:&i)=1
    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET NrTransRef1 = '' WHERE NrTrans = '"~Val(l:&i)~"' ")
    SQL.NEW

    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET CB5 = '0' WHERE NrTrans = '"~Val(c:&i)~"' ")
    SQL.NEW

    SQL.ADD(" INSERT INTO "~DBO~".MOVPENDIENTES ( ")
    SQL.ADD(" FechaEje, UsuarioEje, NrTrans2, NrOperacion, ")
    SQL.ADD(" Leyenda, Cantidad, Cliente, Especie, ")
    SQL.ADD(" CallPut, NrSaldo, NrGrupo, NrGrupo2, ")
    SQL.ADD(" Bits, Cupon, NrMov, NrInstan, ")
    SQL.ADD(" FechaMov, EnteCustodia, Cuenta, Transaccion ) ")
    SQL.ADD(" SELECT "~Idxdate2(FSYS)~", '"~USUARIOACTIVO~"', NrTrans2, NrOperacion, ")
    SQL.ADD(" Leyenda, Cantidad, Cliente, Especie, ")
    SQL.ADD(" CallPut, NrSaldo, NrGrupo, NrGrupo2, ")
    SQL.ADD(" Bits, Cupon, NrMov, NrInstan, ")
    SQL.ADD(" FechaMov, EnteCustodia, Cuenta, Transaccion  ")
    SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(l:&i)~"' AND NrMov = "~Fstr(Val(r:&i),0,0)~" AND NrSaldo=99 ")
    SQL.NEW
   
    SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(l:&i)~"' AND NrMov = "~Fstr(Val(r:&i),0,0)~" AND NrSaldo=99 ")
    SQL.NEW
    SQL.EXEC
    message(' Voucher '~Val(l:&i)~' desconciliado.')
  Endif
Proximo
