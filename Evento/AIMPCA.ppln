creardialogo
fecha1:'R.Date Desde';1;1;;;;;;;FSys()
fecha2:'R.Date Hasta';2;1;;;;dialogo.fecha2 >= dialogo.fecha1;'El R.Date Hasta debe ser posterior al R.Date Desde';NO;FSys()
fecha3:'F.Pago Desde';1;2;;;;;;;FSys()
fecha4:'F.Pago Hasta';2;2;;;;dialogo.fecha4 >= dialogo.fecha3;'La F.Pago Hasta debe ser posterior a la F.Pago Desde';NO;FSys()
especie1:'Especie';4;1;;;;;;;
cliente1:'Cliente';5;1;;;;(Vacio(dialogo.cliente1)) o (Eqstr(BuscarCampo('CLIENTES', 'CategDepositante', 'Codigo', dialogo.cliente1), 'CLI') y Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente1), 'HAB'));'Cliente Invalido';NO;
mercado1:'Mercado';4;2;;;;;;;
vehiculo1: 'Vehiculo';5;2;;;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE')
radio1:'Tipo|Obligatorias|Optativas';7;1;;;;;;;0
radio2:'C.Action|P.Divid.|Spin Off|Stk Split|C.de Cupon';8;1;;;dialogo.radio1 = 0;;;;0
radio3:'C.Action|Canje|Rescate|Tender Offer';8;1;;;dialogo.radio1 = 1;;;;0
findialogo

if (not ok)
Cancelar()
endif

if ((dialogo.radio1 = 0) y (dialogo.radio2 = 0))
Linkearhoja('IMTPDI', 1, 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha2, 'fecha3', dialogo.fecha3, 'fecha4', dialogo.fecha4, 'especie1', dialogo.especie1, 'cliente1', dialogo.cliente1, 'mercado1', dialogo.mercado1, 'vehiculo1', dialogo.vehiculo1)
endif

