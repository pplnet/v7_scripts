creardialogo
fecha1: 'F.Bajada';;;;;;;;;FSys()
especie1: 'Moneda';;;;;;Eqstr(BuscarCampo('ESPECIES', 'Tipo', 'Codigo', dialogo.especie1), 'MON');'Moneda Invalida.';NO;'ARP';;;;;" Tipo = 'MON' "
