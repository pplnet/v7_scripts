Sqladd("FROM "~Dbo()~".MOVPENDIENTES M INNER JOIN "~Dbo()~".OPERACIONES O ON M.NrOperacion = O.NrOperacion")
Sqladd("INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion")
Sqladd("INNER JOIN "~Dbo()~".CLIENTES C ON M.Cliente = C.Codigo")

Sqladd("WHERE (B.NrBit = 10  or B.NrBit = 70)              ")
Sqladd("  and B.Valor = '1'                                ")
Sqladd("  and M.Mercado = '"~dialogo.mercado1~"'           ")
Sqladd("  and O.Mercado4 = '"~dialogo.mercado2~"'          ")
Sqladd("  and M.EnteCustodia = '"~dialogo.vehiculo1~"'     ")
