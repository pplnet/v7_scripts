sql.add("FROM "~Dbo()~".MOVPENDIENTES M INNER JOIN "~Dbo()~".OPERACIONES O ON M.NrOperacion = O.NrOperacion")
sql.add("INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion")
sql.add("INNER JOIN "~Dbo()~".CLIENTES C ON M.Cliente = C.Codigo")

sql.add("WHERE (B.NrBit = 10  or B.NrBit = 70)              ")
sql.add("  and B.Valor = '1'                                ")
sql.add("  and M.Mercado = '"~dialogo.mercado1~"'           ")
sql.add("  and O.Mercado4 = '"~dialogo.mercado2~"'          ")
