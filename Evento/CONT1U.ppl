MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Concertacion ---')

ACT(US:1, Descendientes('ESPECIES', 'U$S'))
***---Moneda Fuerte
ACT(MF:1, Var('MONEEXTR'))

SQL.ADD(" SELECT O.NrOperacion, Case O.TipoOp When 'MRF   ' Then O.ContraEspecie When 'MRO   ' Then O.ContraEspecie ELSE O.Especie END Especie, ")
SQL.ADD(" O.FechaOp, O.Cliente1, Case O.TipoOp When 'MRF   ' Then O.Especie When 'MRO   ' Then O.Especie ELSE O.ContraEspecie END ContraEspecie, ")
SQL.ADD(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD(" MA.Codigo CodAsi, O.CB9, O.CB10, E.Tipo, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, E.Cotiza, ")
SQL.ADD(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, E.Alias8, V.Alias4, O.ContraEspecie Moneda, ")
SQL.ADD(" O.Cuenta2, O.ViaPago1, O.CantidadOri, O.CB13, 0 NrMov,O.Book1 AS Book,C.CategDepositante,O.ContraEspecie ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO MA, "~DBO~".ESPECIES E")
SQL.ADD(" WHERE O.Cliente1    =  C.Codigo ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo ")
SQL.ADD(" AND   ((O.Especie =  E.Codigo AND O.TipoOp Not IN ('MRF','MRO')) OR (O.ContraEspecie = E.Codigo AND O.TipoOp IN ('MRF','MRO'))) ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
SQL.ADD(" AND   O.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
***---Las vinculadas solo se toman las que fueron cargadas, no la que se genera por la carga
***---SQL.ADD(" AND   (O.TipoOp Not IN ('FXCSV','FXCTV','FXVSV','FXVTV') OR (O.TipoOp IN ('FXCSV','FXCTV','FXVSV','FXVTV') AND O.MB4 IN ('0','1'))) ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
* -- Solo los vehiculos que liquidan contabilizan.
SQL.ADD(" AND O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  AND ((")
   Recorrer&i 1,Elementos(Dialogo.Lista1)
        SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
   proximo
   SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
***---SQL.ADD("AND (C.CategDepositante <> 'ALY' OR C.CategDepositante Is Null OR C.CategDepositante = '' OR C.CategDepositante = ' ') ")
SQL.ADD(" ORDER BY O.NrOperacion ")
watch(sql.batch)
Recorrer SQL
    ACD(FV:1, fbn('FechaOp'))
    ACT(VH:1, fbn('Vehiculo1'))
    (.'FECHAVALOR'.)
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
       **MessageBox(Fstr(#MONTONETO, 0, 8))
       **MessageBox(Fstr(#COTMONFUEC, 0, 8))
       Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
       SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
       SQL.EXEC
    ENDIF
Proximo