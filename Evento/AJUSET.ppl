HojaVisible(SI)

SQL.ADD("Select * from  "~DBO~".OPERACIONES  ")
SQL.ADD("where TipoOp in ('FXCS','FXCT','FXVS','FXVT','FXAS','FXAT','SECS','SECT','SEVS','SEVT')")
Recorrer SQL
  ACN(w1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp'])
  ACT(h:FAC, FBN['Vehiculo1'])
  ACT(i:FAC, FBN['TipoOp']~' '~FBN['Especie'])
  if Incluido(FBN['TipoOp'],'FXCS|FXCT|FXAS|FXAT|FXVS|FXVT')
    if Incluido(FBN['TipoOp'],'FXCS|FXCT|FXAS|FXAT')
      ACD(c:FAC, FBN['FechaPago'])
      if FBN['FechaPago']<=FBN['FechaVto']
        ACD(d:FAC, Habiles(FBN['FechaVto'],1,FBN['TablaFeriados1']))
      else
        ACD(d:FAC, Habiles(FBN['FechaPago'],1,FBN['TablaFeriados1']))
      endif
    else
      ACD(c:FAC, FBN['FechaVto'])
      if FBN['FechaVto']<=FBN['FechaPago']
        ACD(d:FAC, Habiles(FBN['FechaPago'],1,FBN['TablaFeriados1']))
      else
        ACD(d:FAC, Habiles(FBN['FechaVto'],1,FBN['TablaFeriados1']))
      endif
    endif
    ACN(e:FAC, iif(EqStr(FBN['Especie'],'USD'),FBN['Cantidad'],FBN['TotalBrutoCli1']*iif(EqStr(Modo(FBN['ContraEspecie'],'USD'),'DIR'),FBN['Cotizacion1'],1/iif(FBN['Cotizacion1']<=0,1,FBN['Cotizacion1']))))
    if Incluido(FBN['TipoOp'],'FXCS|FXCT|FXVS|FXVT') y FBN['Arbitraje']=1
      ACN(f:FAC, 1)
    endif
  else
    if Incluido(FBN['TipoOp'],'SECS|SECT')
      ACD(c:FAC, FBN['FechaPago'])
      if FBN['FechaPago']<=FBN['FechaVto']
        ACD(d:FAC, Habiles(FBN['FechaVto'],1,FBN['TablaFeriados1']))
      else
        ACD(d:FAC, Habiles(FBN['FechaPago'],1,FBN['TablaFeriados1']))
      endif
    else
      ACD(c:FAC, FBN['FechaVto'])
      if FBN['FechaVto']<=FBN['FechaPago']
        ACD(d:FAC, Habiles(FBN['FechaPago'],1,FBN['TablaFeriados1']))
      else
        ACD(d:FAC, Habiles(FBN['FechaVto'],1,FBN['TablaFeriados1']))
      endif
    endif
    ACN(e:FAC, iif(EqStr(FBN['ContraEspecie'],'USD'),FBN['TotalNetoCli1'],FBN['TotalNetoCli1']*CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,'USD')))
    if FBN['FormaLiquidacion1']=1
      ACN(f:FAC, 1)
    endif
  endif
  if FBN['PaseCB']=1
    ACN(f:FAC, 1)
  endif
  if Not Incluido(FBN['Vehiculo1'],Var('VLIQUIDAA'))
    ACN(g:FAC, 1)
  endif
  if Val(c:FAC)<=FSys
    ACT(j:FAC, 'P')
  else
    ACT(j:FAC, 'N')
  endif
  if Val(d:FAC)<=FSys
    ACT(k:FAC, 'P')
  else
    ACT(k:FAC, 'N')
  endif
  Message(' Operacion '~FBN['NrOperacion'])

  SQL.ADD("Delete from "~DBO~".MOVLIMITES where NrOperacion = '"~FBN('NrOperacion')~"' and Limite in ('SETTLEMENT','SETCRE') ")
  SQL.NEW

  if Val(f:FAC)=0
    SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
    SQL.ADD("FechaMov, Cliente, Limite, ")
    SQL.ADD("Especie, Monto, NrOperacion, ")
    SQL.ADD("Descripcion, Bits ")
    SQL.ADD(") Values (")
    SQL.ADD("'"~IdxDate(Val(c:FAC))~"', '"~FBN('Cliente1')~"', 'SETCRE', ")
    SQL.ADD("'USD', "~FStr(Val(e:FAC),0,2)~", '"~Val(a:FAC)~"', ")
    SQL.ADD("'"~Val(i:FAC)~"', '"~Val(j:FAC)~"' ")
    SQL.ADD(")")
    SQL.NEW
  endif
  if Val(g:FAC)=0
    SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
    SQL.ADD("FechaMov, Cliente, Limite, ")
    SQL.ADD("Especie, Monto, NrOperacion, ")
    SQL.ADD("Descripcion, Bits ")
    SQL.ADD(") Values (")
    SQL.ADD("'"~IdxDate(Val(d:FAC))~"', '"~FBN('Cliente1')~"', 'SETCRE', ")
    SQL.ADD("'USD', "~FStr(-Val(e:FAC),0,2)~", '"~Val(a:FAC)~"', ")
    SQL.ADD("'"~Val(i:FAC)~"', '"~Val(k:FAC)~"' ")
    SQL.ADD(")")
    SQL.NEW
  endif
  SQL.EXEC

Proximo

