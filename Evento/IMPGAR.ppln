Sqladd("Select ORD.NrOrden, OP.NrOperacion ")
Sqladd("  From "~Dbo()~".ORDENES ORD ")
Sqladd("    LEFT JOIN "~Dbo()~".OPERACIONES OP")
Sqladd("       on ORD.NrOperacion2 = OP.NrOperacion ")
Sqladd("Where ORD.NrOrden = '"~dialogo.nrorden1~"' ")
Sqladd("  and  ORD.CB7 = 1 ")
Sqladd("  and  (   ((OP.NrOperacion is null or OP.NrOperacion = '') ")
Sqladd("             and ORD.Cantidad1 ="~FStr(Val(t:1), 0, 2)~" )")
Sqladd("        Or  (Not(OP.NrOperacion is null or OP.NrOperacion = '')")
Sqladd("             and not Exists(SELECT 1 FROM "~Dbo()~".MovEjecutados ME ")
Sqladd("                            WHERE ME.NrOperacion = ORD.NrOperacion2  )")
Sqladd("             and OP.Cantidad="~FStr(Val(t:1), 0, 2)~")        )")

