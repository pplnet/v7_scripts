*-- DPEDSS: Ejercicio de Double Up Swap con Swaption-PC-
CrearDialogo
  NrOperacion1 : "Operacion"                   ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Fecha1       : "F Real "                     ;;;;NO;;Dialogo.Fecha1>=Dialogo.Fecha4;'La Fecha de Ejercicio Real para esta Operacion es Invalida';NO;Fsys
  Especie1     : "Commodity"                   ;1;2;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Ejercicio"             ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaPrecan','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Fixed Price"                 ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Swap|Consumer|Producer"      ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : "Ejerce|No|Si"                ;;;;;;;;;1;
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DPDSS|')
   Cancelar('La operacion No '~Dialogo.NrOperacion1~' No es Double Up Swap con Swaption')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

* Verifico que no se haya pasado la fecha de liquidacion
(.'DCFMODI'.)

If Dialogo.Fecha1>VAL(D1)
   Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and ((TipoOpcion='0' and FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" or (TipoOpcion='1' and FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"')) ")

*   SQL.ADD("and (CB8 IS NULL OR CB8='0' )")

   Recorrer SQL

     acn(x1,1)     
 
     IF Dialogo.Radio3=1 
        * Se Ejerce
        Message('Actualizando la Operacion  .... ')  
                
        *** Marca la operacion como ejercida ***
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set ")
        SQL.ADD("Cantidad  = Cantidad*2 , ")
        SQL.ADD("TotalAux2 = TotalAux2*2, ")
        SQL.ADD("TotalAux1 = TotalAux1*2, ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("CB8 = '1'  ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW

        Message('Actualizando Los Settlements  .... ')  
                  
        *** Marca la operacion como ejercida ***
        SQL.ADD("Update "~DBO~".CUOTAS ")
        SQL.ADD("Set ")
        SQL.ADD("Cantidad1  = Cantidad1*2 ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
     ELSE 
        * Elije no Ejercerla
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("CB8 = '-1'  ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
     ENDIF
     SQL.EXEC

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)    
   proximo

   If Val(x1)=0
      Cancelar('La operacion No '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif

