CrearDialogo
  NrOperacion1: 'Nr.Operacion'             ;1;1;;;;;;;;;;;;" TipoOp in ('PME','PMU') AND NrOperacion Not in (Select ME.NrOperacion From "~DBO~".MOVEJECUTADOS ME Where ME.NrOperacion=NrOperacion  and ME.NrSaldo=1 and ME.NrGrupo=1 ) and NrOperacion in (Select MP.NrOperacion  From "~DBO~".MOVPENDIENTES MP Where MP.NrOperacion= NrOperacion and MP.NrSaldo=1 and MP.NrGrupo=1) AND NrOperacion in (Select OB.NrOperacion  from "~DBO~".OPERACIONESBITS OB where OB.NrOperacion = NrOperacion  and OB.NrBit in ('10','70') and OB.Valor='1' ) "
FinDialogo

if not OK
  Cancelar
endif

ACT(z1,Dialogo.NrOperacion1)

ACN(x1,SQL("Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion='"~val(z1)~"' and NrSaldo=1 and NrGrupo=1 "))
if val(x1)=1
  Cancelar('El Desembolso fue liquidado. No puede anular.')
endif

ACN(x1,SQL("Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion='"~val(z1)~"' and NrSaldo=1 and NrGrupo=1 "))
if val(x1)<>1
  Cancelar('No se encuentra el MOVPENDIENTE. No puede anular.')
endif

ACN(x1, SQL("Select 1 from "~DBO~".OPERACIONESBITS where NrOperacion='"~val(z1)~"' and NrBit in ('10','70') and Valor='1'"))
if val(x1)<>1
  Cancelar('La Operacion '~val(z1)~' debe estar en instancia Liquidacion ')
endif

SQL.ADD("Select Especie, Cliente1, Cantidad, FechaOp, Plazo, FechaVto, Vehiculo1 ")
SQL.ADD("From "~DBO~".OPERACIONES Where NrOperacion='"~val(z1)~"' ")
Recorrer SQL
  ACT(a1, fbn['Especie']) 
  ACT(b1, fbn['Cliente1'])
  ACN(c1, fbn['Cantidad'])
  ACD(d1, fbn['FechaOp'])
  ACN(e1, fbn['Plazo'])
  ACD(f1, fbn['FechaVto'])
  ACT(p1, fbn['Vehiculo1'])
Proximo

CrearDialogo
  NrOperacion1 : "Operacion"           ; 1;1;;NO;;;;;val(z1)
  Cliente1     : "Cliente"             ; 2;1;;NO;;;;;val(b1)
  Especie1     : "Moneda"              ; 3;1;;NO;;;;;val(a1)
  Cantidad1    : "Cantidad"            ; 4;1;;NO;;;;;val(c1)
  Fecha1       : "F.Concer."           ; 1;2;;NO;;;;;val(d1)
  Entero3      : "Pl.Original"         ; 2;2;;NO;;;;;val(e1)
  Fecha2       : "F.Vto.Original"      ; 3;2;;NO;;;;;val(f1)
FinDialogo

if not OK
  Cancelar
endif

if Messagebox('Confirma la Anulacion del Desembolso del Prestamo '~val(z1)~' ?',3,1) = 1
  ACN(pc1,0)
  ACD(z2,FSYS)
  (.'CANPRE20'.)

  LinkearHoja('PMOADE',5,NrTrans1=val(nm1), Check1=0)
endif
