creardialogo
string1:'Ruta';1;1;;;;;;;Var('PATHACREM')
string2:'Archivo';2;1;;;;;;;Var('ACREM')
findialogo

if (not ok)
Cancelar()
endif

if (Eqstr(Copy(dialogo.string1, Longitud(dialogo.string1), 1), '\'))
Act(x:1, dialogo.string1~dialogo.string2)
else
Act(x:1, dialogo.string1~'\'~dialogo.string2)
endif

importarxls(a:2..g:1000, aa:2..gg:1000, Val(x:1))

if (not ok)
Cancelar()('Error al cargar el archivo '~Val(x:1))
endif

recorrer&i 2, 1000
if (Vacio(Val(aa:&i)))
break
endif

Act(co:1, Val(aa:&i))

Act(vh:1, BuscarCampo('CUENTAS', 'Cliente', 'Numero', Val(co:1)))

Act(es:1, BuscarCampo('CUENTAS', 'Especies', 'Numero', Val(co:1)))
Act(es:2, Copy(Val(vh:2), 1, Longitud(Val(es:2)) - 1))

Act(cl:1, BuscarCampo('CUENTAS', 'Comitente', 'Numero', Val(co:1)))

Act(cu:1, BuscarCampo('CUENTAS', 'Codigo', 'Numero', Val(co:1)))

Acn(nu:1, BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Val(vh:1)))

Act(nr:1, getnumerador(Val(nu:1)))

Acn(rb:8, Val(af:&i))

Acn(pr:1, Val(ae:&i))

Acn(pl:1, Fecha(Val(ac:&i)) - Fecha(Val(ab:&i)))

Act(pe:1, BuscarCampo('USUARIOS', 'Perfiles', 'Codigo', UsuarioActivo()))


sql.add("INSERT INTO "~Dbo()~".OPERACIONES ( ")
sql.add("   TipoOp,          NrOperacion,    FechaOp,         FechaOp2,      FechaVto, ")
sql.add("   Plazo,           Vehiculo1,      Especie,         Cliente1,      Operador, ")
sql.add("   TipoTasa,        FechaPago,      Precio1,         RB8,           TablaFeriados1, ")
sql.add("   Cuenta1,         Book1,          Sector2,         MB3,           UsrInput, ")
sql.add("   FechaCarga,      FechaCargaSys ")
sql.add("   ) VALUES (")
sql.add("   'MMRPAC'                 , '"~Val(nr:1)~"'           , '"~IdxDate(Val(ab:&i))~"' , '"~IdxDate(Val(ab:&i))~"' , '"~IdxDate(Val(ac:&i))~"', ")
sql.add("   "~FStr(Val(pl:1), 0, 0)~"  , '"~Val(vh:1)~"'           , '"~Val(es:2)~"'           , '"~Val(cl:1)~"'         , '"~UsuarioActivo()~"', ")
sql.add("   'FIJA'                   , '"~IdxDate(Val(ad:&i))~"' , "~FStr(Val(pr:1), 0, 2)~"   , "~FStr(Val(rb:8), 0, 0)~" , 'ARG', ")
sql.add("   '"~Val(cu:1)~"'          , '"~Val(ag:&i)~"'          , '"~Val(pe:1)~"'           , '1'                     , '"~UsuarioActivo()~"', ")
sql.add("   "~SQLAhora()~"             , '"~IdxDate(FSys())~"' ")
sql.add("   )")
Watch(sql.batch)
sql.new
sql.exec

ejecutarevento('INSBIT', string1 = 'OPERACIONES', entero1 = 1, nroperacion1 = Val(nr:1))
proximo

Messagebox('Evento Finalizado Correctamente.')



