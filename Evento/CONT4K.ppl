ACD(fe:1, Dialogo.Fecha1)

*SE HACEN CONTRASIENTOS DE TODOS LOS ASIENTOS RELACIONADOS CON UNA OPERACION.
Message('--- Contrasientos contables ---')
*SQL.ADD("select DISTINCT O.FechaOp, O.NrOperacion, MA.Codigo as CodAsi, AC.FechaGeneracion,  ")
SQL.ADD("select DISTINCT O.FechaOp, O.NrOperacion, A.Modelo as CodAsi, AC.FechaGeneracion,  ")
SQL.ADD(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
SQL.ADD(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
*SQL.ADD("  from "~DBO~".BOPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".ASIENTOSCON AC ")
SQL.ADD("  from "~DBO~".BOPERACIONES O, "~DBO~".ASIENTOSCON AC ")
SQL.ADD("where CONVERT (Char(10), O.FechaDel, 103) = '"~Fecha(Dialogo.Fecha1,'DD/MM/YYYY')~"' ")
***---SQL.ADD(" AND O.FechaOp >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" and O.NrOperacion = AC.NrOperacion ")
*SQL.ADD(" and MA.Codigo = AC.Modelo      ")
***---SQL.ADD(" and O.TipoOp  = MA.TipoOp      ")
***---SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
* NO TRAIGO LOS QUE ESTAN RELACIONADOS CON TRANSACCIONES
***---SQL.ADD(" AND (AC.NrTrans2 IS NULL OR AC.NrTrans2='' OR AC.NrTrans2 = ' ') ")
***---SQL.ADD(" AND AC.Estado = 'OK' ")
SQL.ADD(" AND (AC.Estado IS NULL OR AC.Estado='' OR AC.Estado = ' ' OR AC.Estado = 'E') ")
SQL.ADD(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
*SQL.ADD(" AND MA.Habilitado = 'SI' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*   Recorrer&i 1,Elementos(Dialogo.Lista1)
*        SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
*        If NOT Elementos(Dialogo.Lista1)=&i
*            SQL.ADD(" OR ")
*        EndIf
*   proximo
*   SQL.ADD(") ")   
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif

*SQL.ADD(" UNION ")

*SQL.ADD(" select DISTINCT O.FechaOp, O.NrOperacion, MA.Codigo as CodAsi, AC.FechaGeneracion,  ")
*SQL.ADD(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
*SQL.ADD(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
*SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".ASIENTOSCON AC ")
