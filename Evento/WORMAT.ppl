CrearDialogo
   NrOperacion1: 'NrOper'        ;;;;;;;;;;;;;;;;;;;;;;;
   Entero1     : 'Instancia'     ;;;;;;;;;;;;;;;;;;;;;;;
   Radio1      : 'Avanza|SI|NO'  ;;;;;;;;;;;;;;;;;;;;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

***---Estos son los 4 recorridos posibles
***---1) Operador -> 2 Gerentes
***---2) Operador -> 1 Gerente -> CFO
***---3) Operador -> 1 Gerente -> CFO -> Gerente General
***---4) Operador -> 1 Gerente -> CFO -> Gerente General -> Presidencia o Vicepresidencia

***---Instancia Gerente Administracion
ACN(GA:1, 10)
***---Instancia Gerente Riesgo Financiero
ACN(GF:1, 12)
***---Instancia Gerente Mercado Capitales
ACN(GM:1, 13)
***---Instancia CFO
ACN(FO:1, 14)
***---Instancia Gerente General
ACN(GG:1, 15)
***---Instancia Vicepresidencia
ACN(IV:1, 16)
***---Instancia Presidencia
ACN(IP:1, 17)
***---Instancia Confirmacion
ACN(IC:1, 19)

IF Dialogo.Radio1 = 0
    ACN(IN:1, 0)
    ACN(IN:2, 0)
    SQL.ADD(" Select O.TipoOp, O.TotalAux3, O.PrecioMer, O.CantImpresiones3, O.Plazo, C.MontoR1, ")
    SQL.ADD(" C.MontoR2, C.MontoR3, C.PlazoR1, C.PlazoR2, C.PlazoR3 ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".TIPOSOPERACION T, "~DBO~".CLASESOPERACION C ")
    SQL.ADD(" Where T.Codigo = O.TipoOp ")
    SQL.ADD(" AND T.ClaseOperacion = C.Codigo ")
    SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    Recorrer SQL
        ACN(MN:1, fbn('MontoR1'))
        ACN(MN:2, fbn('MontoR2'))
        ACN(MN:3, fbn('MontoR3'))
        ACN(PL:1, fbn('PlazoR1'))
        ACN(PL:2, fbn('PlazoR2'))
        ACN(PL:3, fbn('PlazoR3'))
        IF Incluido(fbn('TipoOp'), 'DFXO|DSEO')
            ACN(MD:1, fbn('TotalAux3'))
        ELSE
            ACN(MD:1, fbn('PrecioMer'))
        ENDIF
        ***---Obtengo Montos y Plazos para el TipoOp
        IF Dialogo.Entero1 = Val(GA:1) O Dialogo.Entero1 = Val(GF:1) O Dialogo.Entero1 = Val(GM:1)
            IF Val(MN:1) > 0
                ***---El Recorrido 1 esta Habilitado
                IF fbn('CantImpresiones3') = 1
                    ***---Ya tuvo una aprobacion del primer grupo de Gerencias, => avanza
                    IF Val(MD:1) <= Val(MN:1) Y fbn('Plazo') <= Val(PL:1)
                        ***---Esta dentro del limite del grupo => se aprueba
                        ACN(IN:1, Val(IC:1))
                    ELSE
                        ***---Necesita Aprobacion CFO
                        ACN(IN:1, Val(FO:1))
                    ENDIF
                ENDIF
                ACN(CM:3, fbn('CantImpresiones3') + 1)
                ***---Actualizo marca de aprobacion del primer recorrido
                SQL.ADD(" Update "~DBO~".OPERACIONES ")
                SQL.ADD(" Set CantImpresiones3 = "~Fstr(Val(CM:3), 0, 0)~" ")
                SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
                SQL.NEW
            ELSE
                ***---El Recorrido 1 No esta Habilitado => Avanza a CFO
                ACN(IN:1, Val(FO:1))
            ENDIF
        ELSE
            IF Dialogo.Entero1 = Val(FO:1)
                ***---CFO
                IF Val(MD:1) <= Val(MN:2) Y fbn('Plazo') <= Val(PL:2)
                    ***---Esta dentro del limite del grupo => se aprueba
                    ACN(IN:1, Val(IC:1))
                ELSE
                    ***---Necesita Aprobacion Gerente General
                    ACN(IN:1, Val(GG:1))
                ENDIF
            ELSE
                IF Dialogo.Entero1 = Val(GG:1)
                    ***---Gerente General
                    IF Val(MD:1) <= Val(MN:3) Y fbn('Plazo') <= Val(PL:3)
                        ***---Esta dentro del limite del grupo => se aprueba
                        ACN(IN:1, Val(IC:1))
                    ELSE
                        ***---Necesita Aprobacion Vicepresidencia O Presidencia
                        ACN(IN:1, Val(IV:1))
                        ACN(IN:2, Val(IP:1))
                    ENDIF
                ELSE
                    IF Dialogo.Entero1 = Val(IV:1)
                        ***---Vicepresidencia => se aprueba
                        ACN(IN:1, Val(IC:1))
                    ELSE
                        IF Dialogo.Entero1 = Val(IP:1)
                            ***---Presidencia => se aprueba
                            ACN(IN:1, Val(IC:1))
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '0' ")
        SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        IF Val(IN:1) = 0
            ***---Si la operacion no avanza => la saco solo de la instancia desde donde se la avanzo
            SQL.ADD(" AND NrBit = "~Dialogo.Entero1~" ")
        ENDIF
        SQL.NEW
        IF Val(IN:1) > 0
            ***---La operacion avanza
            SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
            SQL.ADD(" Set Valor = '1' ")
            SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
            SQL.ADD(" AND (NrBit = "~Val(IN:1)~" ")
            IF Val(IN:2) > 0
                SQL.ADD(" OR NrBit = "~Val(IN:2)~" ")
            ENDIF
            SQL.ADD(" ) ")
            SQL.NEW
        ENDIF
        SQL.EXEC
    Proximo
ELSE
    ***---Dejo en cero posibles autorizaciones anteriores del recorrido 1
    SQL.ADD(" Update "~DBO~".OPERACIONES ")
    SQL.ADD(" Set CantImpresiones3 = 0 ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
ENDIF