Sqladd(" Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, O.Especie ")
Sqladd(" From    "~Dbo()~".OPERACIONES O   ")
Sqladd(" where  O.TipoOp IN ('FCS','FCR')  ")
Sqladd(" AND O.FechaOp between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" order by O.NrOperacion ")

recorrer sql
