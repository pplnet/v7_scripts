Act(nm1, getnumerador(iif (Eqstr(Val(p1), 'INGCURA'), 304, 204)))

sql.add("INSERT INTO "~Dbo()~".TRANSACCIONES2 ")
sql.add("(TipoTr2,NrTrans, NrOperacionRef1, Cupon1, ")
sql.add("Fecha1, Fecha2, Cantidad1, Especie, Vehiculo1) ")
