creardialogo
fecha1:'Fecha';1;1;;;;;;;FSys()
nrboperacion: 'Operacion';;;;;;;;;;;;;;" CONVERT (Char(10), FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ";;;;;
vehiculo1: 'Vehiculo';;;;NO;NO;
findialogo

mostrarcuadrodemensajes

if (not ok)
Cancelar()
endif

Acd(fe:1, dialogo.fecha1)

Message('--- Contrasientos contables ---')

sql.add("select DISTINCT O.FechaOp, O.NrOperacion, AC.Modelo as CodAsi, AC.FechaGeneracion,  ")
sql.add(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
sql.add(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
sql.add("  from "~Dbo()~".BOPERACIONES O, "~Dbo()~".ASIENTOSCON AC ")
sql.add("where CONVERT (Char(10), O.FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ")
sql.add(" and O.NrOperacion = AC.NrOperacion ")
sql.add(" AND (AC.Estado IS NULL OR AC.Estado='' OR AC.Estado = ' ' OR AC.Estado IN ('E','A')) ")
sql.add(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
if (NoVacio(dialogo.nrboperacion))
sql.add(" AND O.NrOperacion = '"~dialogo.nrboperacion~"' ")
endif
sql.add(" order by O.NrOperacion ")
Watch(sql.batch)
recorrer sql
Acd(fv:1, Fbn('FechaValor'))
Act(vh:1, Fbn('Vehiculo'))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi')~' - NrAsiento: '~Fbn('NrUnicoAsiento'))
Act(nn:1, getnumerador(Var('ASINUM')))
sql.add(" INSERT INTO "~Dbo()~".ASIENTOSCON                ")
sql.add(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
sql.add(" Modelo, Book, UDN, Centro, ")
sql.add(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
sql.add(" NrOperacion, NrTrans2, Estado, Fecha1) ")
sql.add(" VALUES ")
sql.add(" ("~IdxDate2(FSys())~", "~IdxDate2(Val(fv:1))~", '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
sql.add(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
sql.add(" '"~Fbn('Sector')~"', '', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
sql.add(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', 'COT', "~IdxDate2(dialogo.fecha1)~")  ")
sql.new
sql.add(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
sql.add(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
sql.add(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
sql.add(" Especie2, Especie3, Cantidad1, Cantidad2, ")
sql.add(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
sql.add(" Alias2, Alias3, Alias4, Alias5, ")
sql.add(" Detalle, CentroCosto, Book, NrItem ")
sql.add(" ) VALUES ( ")
sql.add(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
sql.add(" 'CRE', ")
else
sql.add(" 'DEB', ")
endif
sql.add(" '"~Fbn('Especie1')~"', ")
sql.add(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
sql.add(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
sql.add(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', 'ContraAsiento "~Copy(Fbn('Alias4'), 1, 26)~"', '"~Fbn('Alias5')~"', ")
sql.add(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', '"~Fbn('NrItem')~"' ) ")
sql.new
proximo
sql.exec
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
sql.add(" Set NrAsiento = '"~Val(nn:1)~"' ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.exec
proximo


