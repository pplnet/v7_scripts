creardialogo
fecha1:'Fecha';1;1;;;;;;;FSys()
nrboperacion: 'Operacion';;;;;;;;;;;;;;" CONVERT (Char(10), FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ";;;;;
vehiculo1: 'Vehiculo';;;;NO;NO;
findialogo

MostrarCuadroDeMensajes()

if (not ok)
Cancelar()
endif

Acd(fe:1, dialogo.fecha1)

Message('--- Contrasientos contables ---')

Sqladd("select DISTINCT O.FechaOp, O.NrOperacion, AC.Modelo as CodAsi, AC.FechaGeneracion,  ")
Sqladd(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
Sqladd(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
Sqladd("  from "~Dbo()~".BOPERACIONES O, "~Dbo()~".ASIENTOSCON AC ")
Sqladd("where CONVERT (Char(10), O.FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ")
Sqladd(" and O.NrOperacion = AC.NrOperacion ")
Sqladd(" AND (AC.Estado IS NULL OR AC.Estado='' OR AC.Estado = ' ' OR AC.Estado IN ('E','A')) ")
Sqladd(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
if (NoVacio(dialogo.nrboperacion))
Sqladd(" AND O.NrOperacion = '"~dialogo.nrboperacion~"' ")
endif
Sqladd(" order by O.NrOperacion ")
Watch(Sqlbatch())
recorrer sql
Acd(fv:1, Fbn('FechaValor'))
Act(vh:1, Fbn('Vehiculo'))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi')~' - NrAsiento: '~Fbn('NrUnicoAsiento'))
Act(nn:1, getnumerador(Var('ASINUM')))
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON                ")
Sqladd(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
Sqladd(" Modelo, Book, UDN, Centro, ")
Sqladd(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
Sqladd(" NrOperacion, NrTrans2, Estado, Fecha1) ")
Sqladd(" VALUES ")
Sqladd(" ("~IdxDate2(FSys())~", "~IdxDate2(Val(fv:1))~", '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
Sqladd(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
Sqladd(" '"~Fbn('Sector')~"', '', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', 'COT', "~IdxDate2(dialogo.fecha1)~")  ")
Sqlnew()
Sqladd(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
Sqladd(" Especie2, Especie3, Cantidad1, Cantidad2, ")
Sqladd(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
Sqladd(" Alias2, Alias3, Alias4, Alias5, ")
Sqladd(" Detalle, CentroCosto, Book, NrItem ")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
Sqladd(" 'CRE', ")
else
Sqladd(" 'DEB', ")
endif
Sqladd(" '"~Fbn('Especie1')~"', ")
Sqladd(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
Sqladd(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
Sqladd(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', 'ContraAsiento "~Copy(Fbn('Alias4'), 1, 26)~"', '"~Fbn('Alias5')~"', ")
Sqladd(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', '"~Fbn('NrItem')~"' ) ")
Sqlnew()
proximo
Sqlexec()
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = '"~Val(nn:1)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
proximo


