CrearDialogo
  Especie3   : 'Especie'      ;;;;  ;;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3,'TITULO') y EsTerminal(Dialogo.Especie3,Especie);'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
  Especie1   : 'Cupon'        ;;;;NO;;;;;BuscarCampo('ESPECIES','Alias9', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES','Alias9', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB'  "
  Entero1    : 'Nr.Cupon'     ;;;;NO;;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;0;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
  Fecha1     : 'F.Pago/Cobro' ;;;;NO;;SQL("SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"'")=Dialogo.Fecha1;'La Fecha de Pago no es Correcta';;SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ");SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
** FJL 01/03/23 - Por Issue EXTBACS 8129 - No se permite cancelacion parcial
*  Mercado1   : 'Casa_Custodia';;;;;; 
  Mercado1   : 'Casa_Custodia';;;;NO;NO; 
  Radio1     : "Tipo Cliente|"~Var('LABEL')~"|Caja|Todos" ;1;2;;NO;NO;;;;2;
  ListaTabla1: 'Clientes'    ;2;2;;;;;;;;;;;;IIF(Dialogo.Radio1<>2," "~IIF(Dialogo.Radio1=0," TipoCliente='"~VAR('CLISUD')~"' or TipoCliente Is Null"," TipoCliente='"~VAR('CLICAJA')~"' "),"1=1" );'Codigo' ; 'Codigo;RazonSocial' ; 'VCLIENTES01'
FinDialogo

If Not OK 
   Cancelar
EndIf

ACN(x:1, 0)
ACN(x:2, BuscarCampo('ESPECIES', 'Cupon', 'Codigo', Dialogo.Especie3))

*- Controlo si se hizo la actualizacion de especies del nuevo cupon.
If VAL(X2)>Dialogo.Entero1+1
   ACN(x3,MessageBox('Esta Anulando el Cupon Nro. '~Fstr(Dialogo.Entero1,0,0)~' y la especie esta en Cupon '~Fstr(val(x2),0,0)~', Continua?',1,2))
   If val(x3)=7
      *-NO
      Cancelar 
   EndIf
Endif

*- No recupero los Movimientos de Comisiones
SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*,")
SQL.Add("       C.RazonSocial, ")
SQL.Add("       C.Direccion, ")
SQL.Add("       C.Localidad, ")
SQL.Add("       C.CodigoPostal, ")
SQL.Add("       C.CUIT, ")
SQL.Add("       C.CondicionIVA, ")
SQL.Add("       C.TipoInscripcion, ")
SQL.Add("       C.Sucursal ")
SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS M ")
SQL.Add("WHERE T2.Especie  =  '"~Dialogo.Especie1~"' ")
SQL.Add("  AND T2.Cupon1   =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
SQL.Add("  AND T2.TipoTr2  = 'LCUPON' ")
SQL.Add("  AND M.NrOperacion = T2.NrTrans ")
SQL.Add("  AND M.Cliente     = C.Codigo ")
SQL.Add("  AND M.NrSaldo IN (5,1)  ")
if NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("  AND M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD("  AND M.Mercado='"~Dialogo.Mercado1~"' ")
Endif
SQL.Add(" UNION ALL ")
SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*,")
SQL.Add("       C.RazonSocial, ")
SQL.Add("       C.Direccion, ")
SQL.Add("       C.Localidad, ")
SQL.Add("       C.CodigoPostal, ")
SQL.Add("       C.CUIT, ")
SQL.Add("       C.CondicionIVA, ")
SQL.Add("       C.TipoInscripcion, ")
SQL.Add("       C.Sucursal ")
SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M ")
SQL.Add("WHERE T2.Especie  =  '"~Dialogo.Especie1~"' ")
SQL.Add("  AND T2.Cupon1   =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
SQL.Add("  AND T2.TipoTr2  = 'LCUPON' ")
SQL.Add("  AND M.NrOperacion = T2.NrTrans ")
SQL.Add("  AND M.Cliente     = C.Codigo ")
SQL.Add("  AND M.NrSaldo IN (5,1)  ")
if NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("  AND M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD("  AND M.Mercado='"~Dialogo.Mercado1~"' ")
Endif
SQL.Add("ORDER BY T2.NrTrans,M.Cliente, M.Concepto, M.NrSaldo ")

Recorrer SQL
  If Not EqStr(fbn('NrTrans'),val(z1))
     ACT(z1,fbn('NrTrans'))
     ACT(z2,fbn('NrTrans')~'|'~val(z2))
  EndIf

  ACD(b:fac, fbn('Fecha1'))
  ACT(c:fac, fbn('Cliente'))
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('Cupon1'))
  ACT(g:fac, fbn('Especie1'))

  *- Display del Saldo 
  ACN(f:fac,FBN('NrGrupo2'))

  *- Display del Monto
  ACN(h:fac, fbn('Cantidad'))

  *- Cuenta del Saldo 
  ACT(i:fac, FBN('Book'))  

  *- Cuenta del Efectivo 
  ACT(j:fac, fbn('Cuenta'))

  ACT(l:fac, fbn('NrTrans'))
  ACN(x:1, 1)
  ACN(k:fac, 1)
  ACT(m:fac, fbn('NrTrans'))
Proximo

IF Val(x:1)<>1
   Cancelar('No hay transacciones de Pago o Cobro para la Especie y Cupon solicitados')
ENDIF

CrearListBox ; 'Arial,8,'
** FJL 01/03/23 - Por Issue EXTBACS 8129 - No se permite cancelacion parcial
*   'Cancela'          ;k1..k:fac;SI;;;40;CHECK
   'Cancela'          ;k1..k:fac;NO;;;40;CHECK
   'Fecha'            ;b1..b:FAC;NO;;;70;STRING
   'Cliente'          ;c1..c:FAC;NO;;;70;STRING
   'Especie'          ;d1..d:FAC;NO;;;60;STRING
   'Cupon'            ;e1..e:FAC;NO;;;50;STRING
   'Cantidad'         ;f1..f:FAC;NO;;;80;NUMERO;'##,###,###.##'
   'Moneda'           ;g1..g:FAC;NO;;;60;STRING
   'Total'            ;h1..h:FAC;NO;;;80;NUMERO;'###,###,###.##'
   'De Cuenta'        ;i1..i:FAC;NO;;;100;STRING
   'A Cuenta'         ;j1..j:FAC;NO;;;100;STRING
   'NrTrans'          ;l1..l:FAC;NO;;;70;STRING
FinListBox

IF NOT OK 
   Cancelar
ENDIF

Recorrer&i 1,fac
   IF Val(k:&i)=1
      ACN(ck1,&i)
      * If val(ck1)=1
         **--- Verifico que no se hayan liquidado los movimientos generados por pases y futuros
         *- solamente en la primera pasada
         SQL.ADD(" SELECT Distinct NrOperacion From "~DBO~".CUOTAS ")
         SQL.ADD(" Where Vehiculo2 = '"~Val(l:&i)~"' ")
         Recorrer SQL
            *- Verifico que no haya liquidado el movimiento de la moneda del corte de cupon
            ACN(me1,0)
            ACN(me1,SQL(" SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~fbn('NrOperacion')~"' AND Especie='"~val(g:&i)~"' AND FechaMov='"~IdxDate(Dialogo.Fecha1)~"' "))
            IF val(me1)=1
               Cancelar('Anule Previamente la Liquidacion del Movimiento de Pago de Cupones de la Operacion '~fbn('NrOperacion'))
            EndIf
         Proximo

         ***---Obtengo NrOperacion de operaciones futuras para volver para atras el cupon y la Tr CUPON
         SQL.ADD(" SELECT Distinct NrOperacion From "~DBO~".CUOTAS ")
         SQL.ADD(" Where Vehiculo2 = '"~Val(l:&i)~"' ")
         Recorrer SQL
            SQL.ADD(" Update "~DBO~".OPERACIONES ")
            SQL.ADD(" Set Cupon1 = '"~Fstr(Dialogo.Entero1,1,0)~"', ")
            SQL.ADD(" NrOperacion2 = Null ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.NEW

            SQL.ADD(" Update "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" Set Cupon = '"~Fstr(Dialogo.Entero1,1,0)~"' ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.NEW

            SQL.ADD(" DELETE "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" Where NrOperacion='"~fbn('NrOperacion')~"' and Especie='"~val(g:&i)~"' and Leyenda Like '%Corte%' and FechaMov='"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.NEW
  
            SQL.ADD(" DELETE "~DBO~".CUOTAS ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"'  ")
            SQL.NEW
         Proximo 
         SQL.EXEC
      * EndIf

      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~Val(L:&i)~"' AND Cliente='"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~Val(L:&i)~"' AND Cliente='"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS  WHERE NrOperacion = '"~Val(l:&i)~"' AND Cliente='"~Val(c:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE NrOperacion = '"~Val(l:&i)~"'  AND Cliente='"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.EXEC
 

      * Elimina DTP de custodia de moneda
      SQL.ADD(" SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" WHERE  NrOperacionRef2 = '"~Val(m:&i)~"'   ")
      SQL.ADD(" AND    TipoTr2  = 'DTP'  ")
      SQL.ADD(" AND    Cliente1 = '"~Val(c:&i)~"'  ")
      Recorrer SQL
        SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~FBN('NrTrans')~"'  ")
        SQL.NEW
        SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~FBN('NrTrans')~"'  ")
        SQL.NEW
        SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~FBN('NrTrans')~"'  ")
        SQL.NEW
        SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~FBN('NrTrans')~"'  ")
        SQL.NEW
        SQL.ADD(" DELETE FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion = '"~FBN('NrTrans')~"'  ")
        SQL.NEW
        SQL.ADD(" DELETE FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~FBN('NrTrans')~"'  ")
        SQL.NEW 
        SQL.EXEC
      Proximo     

      Message('Eliminando Cliente '~Val(c:&i))
      SQL.ADD(" DELETE FROM "~DBO~".SALDOSDIA WHERE Especie='"~Dialogo.Especie1~"'  and Cupon='"~FSTR(Dialogo.Entero1,1,0)~"' and Saldo=0  AND Cliente='"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".SALDOS WHERE Especie='"~Dialogo.Especie1~"'  and Cupon='"~FSTR(Dialogo.Entero1,1,0)~"' and Saldo=0  AND Cliente='"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.EXEC
   ENDIF
Proximo

*- 
ACN(z3,Elementos(val(z2)) )

Recorrer&j 1,val(z3)
   ACT(z4,ItemLista(val(z2),&j))

   ACN(cu1,0)

   *- Verifico si la transaccion se quedo con movimientos antes de borrar
   SQL.ADD(" Select Count(*) as Cuantos FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(z4)~"'")
   Recorrer SQL
     dfa
     ACN(cu1,FBN('Cuantos'))
   Proximo

   If val(cu1)=0
      SQL.ADD(" DELETE FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~Val(z4)~"'")
      SQL.NEW
   EndIf
   SQL.EXEC
Proximo

