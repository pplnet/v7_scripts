*** Genera la nueva operacion
SQL.ADD("Select * from "~DBO~".OPERACIONES ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL         

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, NrOperacion, Operador, ")
   SQL.ADD(" FechaOp, Vehiculo1, Vehiculo2,MB4, OperacionRef, ")
   SQL.ADD(" RB7, TablaFeriados1, RB9, CB9, Cuotas1, ")
   SQL.ADD(" Especie, RB8, PrecioRef3, TipoTasa, TotalAux3, ")
   SQL.ADD(" FechaEx1, TotalAux4, FechaEx2, ContraEspecie, RB5, ")
   SQL.ADD(" PrecioRef4, TipoTasa2, TotalBrutoCli2, TotalBrutoCli3, ImpGastos2,RB3,Cliente1, ")
   SQL.ADD(" Cuenta1, Cuenta2, CuentaContable1 ,Book1,Book2,CB1 ) ")        
   SQL.ADD("Values")
   SQL.ADD("('DTKVI', '"~VAL(Z3)~"', '"~FBN['Operador']~"', ")
   SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"','"~FBN['Vehiculo2']~"','"~FBN['Vehiculo1']~"','"~FBN['MB4']~"', '"~Dialogo.NrOperacion1~"', ")
   SQL.ADD(" '"~FBN['RB7']~"','"~FBN['TablaFeriados1']~"','"~val(z1)~"','"~FBN['CB9']~"',"~Fstr(FBN['Cuotas1'],2,0)~", ")
   SQL.ADD(" '"~FBN['ContraEspecie']~"','"~FBN['RB5']~"','"~FBN['PrecioRef4']~"','"~FBN['TipoTasa2']~"',"~Fstr(FBN['TotalBrutoCli2'],0,4)~", ")
   SQL.ADD(" '"~IdxDate(FBN['FechaEx1'])~"',"~Fstr(FBN['TotalBrutoCli3'],0,4)~",'"~IdxDate(FBN['FechaEx2'])~"','"~FBN['Especie']~"','"~FBN['RB8']~"', ")
   SQL.ADD(" '"~FBN['PrecioRef3']~"','"~FBN['TipoTasa']~"',"~Fstr(FBN['TotalAux3'],0,4)~","~Fstr(FBN['TotalAux4'],0,4)~", "~Fstr(FBN['ImpGastos2'],0,7)~",")
   SQL.ADD(" '"~FBN['RB3']~"','"~FBN['Vehiculo1']~"', ")
   SQL.ADD(" '"~FBN['Cuenta1']~"','"~FBN['Cuenta2']~"','"~FBN['CuentaContable1']~"', '"~FBN['Book2']~"', '"~FBN['Book1']~"', '1' )")
   SQL.NEW
   SQL.EXEC

Proximo

*** Genera los periodos
SQL.ADD("Select * from "~DBO~".CUOTAS ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")


*** Vehiculo fijo
IF eqstr(val(a2), '0')

   Recorrer SQL         
      SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
      SQL.ADD("(NrOperacion, NrCuota, ")
      SQL.ADD(" Fecha1, Plazo1, Fecha2, Cantidad1, Precio1, ")
      SQL.ADD(" Total3, Cantidad3, Cantidad2, Precio2, Total4, ")
      SQL.ADD(" Cantidad4, Tasa1, Check1, Fecha3, Fecha4, ")
      SQL.ADD(" Cotizacion1, ")
      SQL.ADD(" Total2, Precio3, Precio5, Precio6) ")
      SQL.ADD("Values")
      SQL.ADD("('"~VAL(Z3)~"', "~Fstr(FBN['NrCuota'],2,0)~",")
      SQL.ADD(" '"~IdxDate(FBN['Fecha1'])~"', "~Fstr(FBN['Plazo1'],2,0)~",'"~IdxDate(FBN['Fecha2'])~"', "~Fstr(FBN['Cantidad2'],0,4)~","~Fstr(val(z2), 2, 7)~", ")
      SQL.ADD(" "~Fstr(FBN['Total4'],0,7)~", "~Fstr(FBN['Cantidad4'],0,4)~", "~Fstr(FBN['Cantidad1'],0,4)~", "~Fstr(FBN['Precio1'], 2, 7)~", "~Fstr(val(z2),0,7)~", ")
      SQL.ADD(" "~Fstr(FBN['Cantidad3'],0,4)~", "~Fstr(FBN['Tasa1'],0,7)~", '"~FBN['Check1']~"', '"~IdxDate(FBN['Fecha3'])~"','"~IdxDate(FBN['Fecha4'])~"', ")
      SQL.ADD(" "~Fstr(FBN['Cotizacion1'],0,7)~", ")
      SQL.ADD(" "~Fstr(FBN['Total2'],0,7)~", "~Fstr(FBN['Precio3'],0,7)~", "~Fstr(FBN['Precio6'],0,4)~", "~Fstr(FBN['Precio5'],0,4)~") ")
      SQL.NEW
      SQL.EXEC
   PROXIMO
*** Vehiculo variable
ELSE
   Recorrer SQL

acn (u1, fbn['Cantidad1'])
acn (u2, fbn['Precio1'])
acn (u3, fbn['Total3'])
acn (u4, fbn['Cantidad3'])

      SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
      SQL.ADD("(NrOperacion, NrCuota, ")
      SQL.ADD(" Fecha1, Plazo1, Fecha2, Cantidad1, Precio1, ")
      SQL.ADD(" Total3, Cantidad3, Cantidad2, Precio2, Total4, ")
      SQL.ADD(" Cantidad4, Tasa1, Check1, Fecha3, Fecha4, ")
      SQL.ADD(" Cotizacion1, ")
      SQL.ADD(" Total2, Precio3, Precio5, Precio6) ")
      SQL.ADD("Values")
      SQL.ADD("('"~VAL(Z3)~"', "~Fstr(FBN['NrCuota'],2,0)~", ")
      SQL.ADD(" '"~IdxDate(FBN['Fecha1'])~"', "~Fstr(FBN['Plazo1'],2,0)~",'"~IdxDate(FBN['Fecha2'])~"', "~Fstr(FBN['Cantidad2'],0,4)~","~Fstr(FBN['Precio2'], 2, 2)~", ")
      SQL.ADD(" "~Fstr(val(z2),0,7)~", "~Fstr(FBN['Cantidad4'],0,4)~", "~Fstr(val(u1),0,4)~", "~Fstr(val(z2), 2, 2)~", "~Fstr(val(u3),0,7)~", ")
      SQL.ADD(" "~Fstr(val(u4),0,4)~", "~Fstr(FBN['Tasa1'],0,7)~", '"~FBN['Check1']~"', '"~IdxDate(FBN['Fecha3'])~"','"~IdxDate(FBN['Fecha4'])~"', ")
      SQL.ADD(" "~Fstr(FBN['Cotizacion1'],0,7)~", ")
      SQL.ADD(" "~Fstr(FBN['Total2'],0,7)~", "~Fstr(FBN['Precio3'],0,7)~", "~Fstr(FBN['Precio6'],0,7)~", "~Fstr(FBN['Precio5'],0,7)~") ")
      SQL.NEW
      SQL.EXEC
   PROXIMO
ENDIF

*** Pone el número de operacion de la vinculada
*** en la original ya que lo necesita para el posterior ejercicio
SQL.ADD("Update "~DBO~".OPERACIONES ")
SQL.ADD("Set ")
SQL.ADD("OperacionRef = '"~VAL(Z3)~"' ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SELECT '"~VAL(Z3)~"' As NrOperacion,NrBit,Valor ")
SQL.ADD(" FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC
*************** Las Operaciones Nuevas se generan en la Instancia 15 ************
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '0' ")
SQL.ADD("  WHERE NrOperacion='"~VAL(Z3)~"' ")
SQL.ADD(" and NrBit         =  '1'  ")
SQL.NEW
SQL.EXEC

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '1' ")
SQL.ADD("  WHERE NrOperacion='"~VAL(Z3)~"' ")
SQL.ADD(" and NrBit         =  '15'  ") 
SQL.NEW
SQL.EXEC