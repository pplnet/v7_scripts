CrearDialogo
  Check1      : 'Procesa';
FinDialogo
If Not OK
  Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

******************************************************************
* Evento que envia Alta, Baja y Modificaciones de TMANIF a Siopel *
******************************************************************

*- Seleccion de las ordenes que se encuentran en la instancia Informar al MAE (160)
** 23-10-2020 AA ORD.Mercado y ORD.RB9 y RB10 se cambia por los datos de la TCPCEM
SQL.ADD("SELECT OB.*, OB.NrBit Inst, ")
SQL.ADD("       ORD.Cliente,   ORD.TipoOrden,    ORD.NrOrden,      O.Mercado,         ORD.CantidadTotalOrden,  ")
SQL.ADD("       ORD.Cantidad1, ORD.PrecioLimite, ORD.Especie,      ORD.ContraEspecie, ORD.FechaOrden,          ")
SQL.ADD("       ORD.FechaVto,  ORD.NroAltaMAE,   ORD.FechaAltaMAE, ORD.Lotes PlazoOr, ORD.FechaLimite,         ")
SQL.ADD("       ORD.Direccion, ORD.Cuenta1,      ORD.Vehiculo,     ORD.Cupon1,        ORD.NrOperacion1 TCPCEM, ")
SQL.ADD("       ORD.RuedaMAE,  ORD.RB7,          ORD.RB5,          ORD.PrecioLimite,  O.FormaLiquidacion1 RB9,                 ")
SQL.ADD("       O.FormaLiquidacion2 RB10,        ORD.RB6,          ORD.Leyenda5,      ORD.Leyenda6,      ORD.Cantidad2            ")
SQL.ADD("  FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".ORDENES ORD, "~DBO~".OPERACIONES O  ")
SQL.ADD(" Where ORD.NrOrden = OB.NrOperacion ")
SQL.ADD("   and O.NrOperacion = ORD.NrOperacion1 ")
SQL.ADD("   and ( OB.NrBit in (160) ) ")
SQL.ADD("   AND ( OB.Valor = '1' )  ")
SQL.ADD("   AND ORD.TipoOrden in ('TMANIF') ")
SQL.ADD("ORDER BY OB.NrOperacion ")

Recorrer SQL
  if Incluido(FBN['TipoOrden'], 'TMANIF')
    ACN(z1,0)
    BorrarCeldas(a:1..t:15)

    ACT(aa:FAC, fbn('NrOrden'))
    ACT(ab:FAC, fbn('TipoOrden'))
    ACN(ac:FAC, fbn('Inst'))
    ACT(ad:FAC, fbn('Cliente'))

    ACT(l:1, 'Cod MAE Especie')
    ACT(l:2, 'EsCupon de Especie')
    ACT(l:3, 'Zero Cupon Especie')
    ACT(l:4, 'NrMAE de Cliente')
    ACT(l:5, 'NrAgenteBolsa de Cliente')
    ACT(l:6, 'Num(NrAgenteBolsa)')
    ACT(l:7, 'CampoMercado')
    ACT(l:8, 'Cuenta1')
    ACT(l:9, 'Tipo Op Origen')
    ACT(l:10, 'Vehiculo')
    ACT(l:11, 'Cliente Vehiculo')
    ACT(l:12, 'Alias1')
    ACT(l:13, 'CUIT')
    ACT(l:15, 'Tipo Op Destino')
    ACT(l:16, 'Tipo Esp.')

    ACT(m:1, BuscarCampo('ESPECIES','CodMAEContado','Codigo',FBN['Especie']))
    ACT(m:2, BuscarCampo('ESPECIES','EsCupon','Codigo',FBN['Especie']))
    ACT(m:3, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',FBN['Especie']))
    ACT(m:4, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente']),3))
    ACT(m:5, Pad0(BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',FBN['Cliente']),3))
    ACN(m:6, Num(Val(m:5)))
    ACT(m:8, fbn('Cuenta1'))
    ACT(m:10, FBN['Vehiculo'])
    ACT(m:11, BuscarCampo('VEHICULOS','Cliente','Codigo',FBN['Vehiculo']))
    ACT(m:12, BuscarCampo('CLIENTES','Alias1','Codigo',FBN['Cliente']))
    ACT(m:13, BuscarCampo('CLIENTES','CUIT','Codigo',FBN['Cliente']))
    ACT(vi:1,BuscarCampo('CLIENTES','Vinculado','Codigo',FBN['Cliente']))
    if EqStr(fbn['Cliente'],Val(m:11)) o EqStr(Val(m:12),'CP')
      ACT(m:9, '5')
      ACT(m:15, '5')
    else
      if DesciendeDeCliente(FBN['Cliente'], 'VINCULADOS') o EqStr(Val(vi:1),'SI')
        ACT(m:9, '7')
        ACT(m:15, '4')
      else
        if Vacio(Val(m:4)) o EqStr(val(m:4),'000')
          if NoVacio(Val(m:13))
            ACT(m:9, '8')
            ACT(m:15, '6')
          else
            ACT(m:9, '1')
            ACT(m:15, '0')
          endif
        else
          ACT(m:9, '9')
          ACT(m:15, '5')
        endif
      endif
    endif
    ACT(m:16, BuscarCampo('ESPECIES','Tipo','Codigo',FBN['Especie']))

    ACT(ae:FAC, Val(m:9))
    ACT(af:FAC, Val(m:15))

    ACT(r:1, BuscarCampo('OPERACIONES','UDN1','NrOperacion',FBN['TCPCEM']))
    if Vacio(Val(r:1))
      ACT(r:1, 'LICI')
    else
      ACT(r:1, Pad(Copy(Val(r:1),1,4),4))
    endif
    ACT(r:2, BuscarCampo('OPERACIONES','SistAmortizacion','NrOperacion',FBN['TCPCEM']))
    if Vacio(Val(r:2))
      ACT(r:2, 'F')
    else
      ACT(r:2, Pad(Copy(Val(r:2),1,1),1))
    endif
    ** FJL 26/03/24 - Por Divisor/multiplicador en TCPCEM
    ACN(r:3, BuscarCampo('OPERACIONES','TipoCambio2','NrOperacion',FBN['TCPCEM']))
    if Val(r:3)<=0
      ACN(r:3, 1)
    endif
   
    ************ Prepara info para Bloque de Control ******************************************
    * Longitud             PIC(4)                                                             *
    * Mercado              PIC(1)                                                             *
    * Agente               PIC(3)                                                             *
    * Operador             PIC(2)                                                             *
    * Fecha                PIC(6)                                                             *
    * Hora                 PIC(6)                                                             *
    * Secuencia            PIC(5)                                                             *
    * Cod. de Registro     PIC(4)                                                             *
    *******************************************************************************************

    ** AA 06-11-2020 Fecha y Hora se actualiza con datos originales para Bajas
    ACN(Y:1, Ahora)
    ACT(Y:2, Hora(Val(Y:1)))
    if FBN['Direccion'] = 1
      * Baja
      ACT(Y:3, Fecha(FSYS, Exe('FORFECMAE')))
      ACT(Y:2, Hora(fbn('FechaAltaMAE')))
    else
      * Alta / Modif
*      ACT(Y:3, Fecha(fbn('FechaOrden'), Exe('FORFECMAE')))
      ACT(Y:3, Fecha(FSYS, Exe('FORFECMAE')))
    endif
    ACT(Y:4, Fecha(FSYS, Exe('FORFECMAE')))
    
    *** Mercado
    ACT(A2, Var('MERSIOP'))
    *** Agente                                        
    ACT(A2, Val(A2)~Var('AGESIOP'))
    ************************************************
    *** Operador (Por ahora informar siempre 99) ***
    ************************************************
* FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
*    ACT(A2, Val(A2)~'99')
    ACT(A2, Val(A2)~Var('OPESIOPEL'))
    *** Fecha
    ACT(A2, Val(A2)~Val(Y:3))
    *** Hora
    ACT(A2, Val(A2)~Copy(Val(Y:2),1,2))
    ACT(A2, Val(A2)~Copy(Val(Y:2),4,2))
    ACT(A2, Val(A2)~Copy(Val(Y:2),7,2))

    *** Secuencia (Comienza con 0 (alta), 1 (Modificacion) o 9 (baja) )
    
    if FBN['Direccion'] = 1
      * Baja
      ACT(A2, Val(A2)~'9')
      ACT(s:1, 'BA')
    else
      if Vacio(fbn('NroAltaMAE'))
        * Alta
        ACT(A2, Val(A2)~'0')
        ACT(s:1, 'AL')
      else
        * Modif
        ACT(A2, Val(A2)~'1')
        ACT(s:1, 'MO')
      endif
    endif
    ACT(A2, Val(A2)~Copy(FBN['NrOrden'],5,4))
    **ACT(A2, Val(A2)~Copy(FBN['NrOrden'],4,5))

    *** Cod. de Registro
    ACT(s:2, 'TM')
    ACT(A2, Val(A2)~'025')
    if FBN['Direccion'] = 1
    * Baja Ofertan (Forma parte del Cod. de Reg.)
      ACT(A2, Val(A2)~'2')
    else
      if Vacio(fbn('NroAltaMAE'))
        * Alta
        ACT(A2, Val(A2)~'1')
      else
        * Modif
        ACT(A2, Val(A2)~'3')
      endif
    endif

    if EqStr(Val(m:9),'5')
      ACT(s:3, 'CP')
    else
      if Vacio(Val(m:4)) o EqStr(val(m:4),'000')
        ACT(s:3, 'TR')
      else
        ACT(s:3, 'AG')
      endif
    endif
    
    ****************************************
    *** Aca termina el Bloque de Control ***
    ****************************************
    
    if EqStr(Val(s:1),'AL')
      ** Es Alta
      ************************ Informar Alta Oferta al MAE (0251) ************************************

      *** Rueda
      ACT(A2, Val(A2)~Val(r:1))

      ************************ Prepara info para Codigo de Titulo ***********************************
      * Negociacion PIC(1) reservado                                                                *
      * Cod especie PIC(5)                                                                          *
      * Cupon       PIC(1) " " (negocia lamina) o "C" (negocia cupon)                               * 
      * Nro Cupon   PIC(3) nro. cupon adherido                                                      *
      * Plazo dias  PIC(3) habiles para CV o corridos para pases                                    *
      * Moneda      PIC(1) "A" (pesos) o "D" (dolares)                                              *
      * Indica tipo PIC(1) 1(Tit.Pub.) 2(ON) 3(Acc.Ord.) 4(Acc.Pref.) 5(Pases) 6(Caucion) 7(Pase Af)*
      ***********************************************************************************************
      *** Negociacion
*** FJL Lo teme del ejemplo de Galciia
*      ACT(A3,'F')
* FJL 04/05/18 - Se pone la logica
      ACT(A3, Val(r:2))
      
      *** Especie
      ACT(A3, Val(A3)~Pad(Val(m:1),5))
      *** Cupon     
      if EqStr(Val(m:2),'SI')
        ACT(A3, Val(A3)~'C')
      else
        ACT(A3, Val(A3)~' ')
      endif
      *** Nro Cupon 
      if EqStr(Val(m:3),'SI')
        ACT(A3, Val(A3)~'   ')
      else
        ACT(A3, Val(A3)~PAD0(FStr(Num(FBN['Cupon1']),1,0),3))
      endif
      *** Plazo
      ACT(A3, Val(A3)~Pad0(FStr(fbn['PlazoOr']/24,1,0),3))
      *** Moneda 
      if Incluido(FBN['ContraEspecie'], 'USD')
        ACT(A3, Val(A3)~'D')
      else
        if Incluido(FBN['ContraEspecie'], 'ARP')
          ACT(A3, Val(A3)~'$')
        else
          ACT(A3, Val(A3)~'E')
        endif
      endif
      *** Indicador de Tipo
      if DesciendeDeEspecie(FBN['Especie'], 'TITULO') 
* FJL 28/06/22 - Para independizarse de la jerarquia (BOFA)
*        if DesciendeDeEspecie(FBN['Especie'], 'ON')
*          ACT(A3, Val(A3)~'2')
*        else
*          ACT(A3, Val(A3)~'1')
*        endif
        ACT(n:16, '1')
        if Incluido(Val(m:16),'ONE|ON')
          ACT(n:16, '2')
        endif
        ACT(A3, Val(A3)~Val(n:16))
      else
        ACT(A3, Val(A3)~'0')
      endif
      * Agrego a Mensaje
      ACT(A2, Val(A2)~Val(A3))

      *************************** Codigo de Agente Contraparte ********************************
      * Tipo   PIC X                                                               *
      * Divulgacion    PIC 9(02)                                                               *
      * Vigencia  PIC 9(03)                                                               *
      * Ente Liquidador   PIC(1) (Op.Compra) 1/D (ARGENCLEAR) 3/6 (CEDEL)  2 (CRYL)           *
      *                                      4/6 (EUROCLEAR)  5/6 (MERVAL) 6 (E/PARTES USA)   *
      * Tipo Liquidacion  PIC(1) (Op.Compra) 1 (DVP)          2 (FP)       3 (DVP&F)          *
      *                                      4 (FT)                                           *
      *****************************************************************************************
      if FBN('RB7')=0
        ACT(A4, 'P') 
      else
        ACT(A4, 'T') 
      endif
      *** Divulgacion  // FJL Lo teme del ejemplo de Galciia
      ACT(A4, Val(A4)~'01')
      *** Vigencia  // FJL Lo teme del ejemplo de Galciia
      ACT(A4, Val(A4)~'999')
      *** Ente Liquidador
      ** 23-10-2020 AA va el mercado de la TCPCEM - se incluye en el Select
      if EqStr(FBN['Mercado'],'AC')
        ACT(A4,Val(A4)~'1')
      else
        if EqStr(FBN['Mercado'],'CRYL')
          ACT(A4,Val(A4)~'2')
        else
          if EqStr(FBN['Mercado'],'CE')
            ACT(A4,Val(A4)~'3')
          else
            if EqStr(FBN['Mercado'],'EU')
              ACT(A4,Val(A4)~'4')
            else
              if EqStr(FBN['Mercado'],'CV')
                ACT(A4,Val(A4)~'5')
              else
              ** 19-11-2020 AA  Mercado de la TCPCEM = MC --> F
                if EqStr(FBN['Mercado'],'MC')
                  **ACT(A4,Val(A4)~'G')
                  ACT(A4,Val(A4)~'F')
                else
                  ACT(A4,Val(A4)~'5')
                endif
              endif
            endif
          endif
        endif
      endif
      *** Tipo de Liquidacion / Revisar las opciones de acuerdo al mercado
      ** 27-10-2020 AA va el tipo de liquidacion de la TCPCEM - se incluye en el Select
      if EqStr(FBN['Mercado'],'CV')
        if FBN['RB9'] = 0
          ACT(A4,Val(A4)~'2')
        endif
        if FBN['RB9'] = 1
          ACT(A4,Val(A4)~'1')
        endif
        if FBN['RB9'] = 2
          ACT(A4,Val(A4)~'4')
        endif
      else
        if FBN['RB10'] = 0
          ACT(A4,Val(A4)~'2')
        endif
        if FBN['RB10'] = 1
          ACT(A4,Val(A4)~'1')
        endif
        if FBN['RB10'] = 2
          ACT(A4,Val(A4)~'4')
        endif
      endif
      * Agrego a Mensaje
      ACT(A2, Val(A2)~Val(A4))
      
      ************************************ Otros datos ****************************************
      * Cantidad            PIC(14)V(4)                                                         *
      * CantidadMinima      PIC(14)V(4)                                                         *
      * Precio              PIC(10)V(8)                                                         *
      * Tipo Op.Origen      PIC X       1 (AMA)          2 (BCRA)           5 (Cartera Propia)  *
      * Clase de Oferta     PIC X                                                               *
      * Fecha  Vencimiento  PIC 9(06) AAMMDD                                                       * 
      * Cliente             PIC X(18)                                                       * 
      * Tipo Op.Destino     PIC X     0 (No Agente)    1 (AMA)            2 (BCRA)            *
      *                               3 (Ag.Bolsa)     4 (AFJP Fondo)     5 (Cartera Propia)  *
      *                               6 (AFJP Encaje)                                         *
      * Cliente Destino      PIC X(18)                                                       * 
      * Plazo vuelta         PIC 9(03)                                                       * 
      *****************************************************************************************
      *- Cantidad
      ACT(A5, Pad0(FStr(FBN['CantidadTotalOrden']*10000,1,0),18))
      *- CantidadMinima
      if FBN('RB7')=0
        ACT(A5, Val(A5)~Pad0(FStr(FBN['Cantidad1']*10000,1,0),18))
      else
        ACT(A5, Val(A5)~Pad0(FStr(FBN['CantidadTotalOrden']*10000,1,0),18))
      endif
      *- Precio/tasa
      ** FJL 26/03/24 - Por Divisor/multiplicador en TCPCEM
*      ACT(A5, Val(A5)~Pad0(FStr(FBN['PrecioLimite']*100000000,1,0),18))
      ACT(A5, Val(A5)~Pad0(FStr(FBN['PrecioLimite']*Val(r:3)*100000000,1,0),18))
      ***** Tipo Op.Origen
      * FJL 12/04/18 - Se pone la logica
*      ACT(A5, Val(A5)~'5')
      ACT(A5, Val(A5)~Val(m:9))
      *** Clase de Oferta // FJL Lo teme del ejemplo de Galciia
      ACT(A5, Val(A5)~'3')
      ***** Fecha Vencimiento
      ACT(A5, Val(A5)~Fecha(fbn('FechaLimite'), Exe('FORFECMAE')))
      ***** Cliente
      * FJL 13/04/18 - Se pone la logica
**      If NO y [Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))] y Not Incluido(val(TD1),'3')
      if Incluido(Val(m:9),'9')
        * Agente
        ACT(A5, Val(A5)~Pad('*A'~Var('MERSIOP')~Val(m:4)~'01',18))
      else
        if Incluido(Val(m:9),'7|8')
          * Tercero o Vinculado
          Borrarceldas(yy:1..yy:1)
          ACT(yy:2, FBN['Cliente'])
          (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*          ACT(A5, Val(A5)~Pad(Val(yy:10),18))
          ACT(A5, Val(A5)~Copy(Pad(Val(yy:10),18),1,18))
        Else
          ACT(A5, Val(A5)~Pad(' ',18))
        Endif 
      Endif 
      ***** Tipo Op.Destino - FJL Ver logica
* FJL 12/04/18 - Se pone la logica
*      ACT(A5, Val(A5)~'5')
      ACT(A5, Val(A5)~Val(m:15))
      ***** Cliente Destino 
      ACT(A5, Val(A5)~Pad(' ',18))
      ***** Plazo Vuelta 
      ACT(A5, Val(A5)~Pad0(0,3))
      * Agrego a Mensaje
      ACT(A2, Val(A2)~Val(A5))

      **************** Otros datos ****************
      * Especie Garantia     PIC X(15)            *
      * Cantidad Garantia    PIC 9(14)V9(04)      *
      * Precio/Tasa Grantia  PIC S9(10)V9(08)     *
      * Texto                PIC X(100)           *
      * Precio/Tasa x cuenta PIC S9(10)V9(08)     *
      * Nr Orden             PIC S9(13)           * 
      * Grupo Economico      PIC X(18)            * 
      * Valor CAP            PIC 9(3)V9(2)        *
      * Dueño CAP            PIC X                * 
      *********************************************
      * Especie Garantia
      ACT(A6, Pad('',15))
      * Cantidad Garantia
      ACT(A6, Val(A6)~Pad0(0,18))
      * Precio/Tasa Garantia
      ACT(A6, Val(A6)~Pad0(0,18))
      * Texto
      ACT(A6, Val(A6)~Pad(' ',100))
      * Precio/Tasa x cuenta
      ACT(A6, Val(A6)~Pad0(0,18))
      * Nr orden
      ACT(A6, Val(A6)~Pad0(0,13))
      * Grupo Economico
      ACT(A6, Val(A6)~Pad(' ',18))
      * Valor CAP
      ACT(A6, Val(A6)~Pad0(fbn('Cantidad2')*100,5))
      * Dueño CAP
      ACT(A6, Val(A6)~' ')
      * Agrego a Mensaje
      ACT(A2, Val(A2)~Val(A6))
      
    else
      if EqStr(Val(s:1),'BA')
        *********** Informar Baja Oferta al MAE (0252) ************************************
        *********** Campos Bloque de Datos **************
        * Rueda                PIC X(4)                 *
        * Secuencia Oferta                              *
        * Fecha                PIC X(6)                 *
        * Hora                 PIC X(6)                 *
        * Secuencia            PIC X(5)                 *
        *************************************************
        *** Rueda
        ACT(A3, Val(r:1))
        *** Fecha
        ACT(A3, Val(A3)~Val(Y:3))
        *** Hora
        ACT(A3, Val(A3)~Copy(Val(Y:2),1,2))
        ACT(A3, Val(A3)~Copy(Val(Y:2),4,2))
        ACT(A3, Val(A3)~Copy(Val(Y:2),7,2))
        *** Secuencia (Comienza con 0 (alta), 1 (Modificacion) o 9 (baja) )
        ACT(A3, Val(A3)~Copy(FBN['NroAltaMAE'],1,5))

        * Agrego a Mensaje
        ACT(A2, Val(A2)~Val(A3))
      else
        if EqStr(Val(s:1),'MO')
          *********** Informar Modificaciona Oferta al MAE (0253) ************************************
          *********** Campos Bloque de Datos **************
          * Rueda                PIC X(4)                 *
          * Secuencia Oferta                              *
          * Fecha                PIC X(6)                 *
          * Hora                 PIC X(6)                 *
          * Secuencia            PIC X(5)                 *
          *************************************************
          *** Rueda
          ACT(A3, Val(r:1))
          *** Fecha
          ACT(A3, Val(A3)~Val(Y:3))
          *** Hora
          ACT(A3, Val(A3)~Copy(Val(Y:2),1,2))
          ACT(A3, Val(A3)~Copy(Val(Y:2),4,2))
          ACT(A3, Val(A3)~Copy(Val(Y:2),7,2))

          ACT(A2, Val(A2)~Val(A3))

          ********** Otros datos **********************
          * Cantidad             PIC 9(14)V9(04)      *
          * CantidadMinima       PIC 9(14)V9(04)      *
          * Precio               PIC S9(10)V9(08)     *
          * Cantidad Garantia    PIC 9(14)V9(04)      *
          * Precio/Tasa Grantia  PIC S9(10)V9(08)     *
          * Texto                PIC X(100)           *
          * Precio x cuenta      PIC 9(10)V9(08)      *
          * Grupo Economico      PIC X(18)            * 
          * Valor CAP            PIC 9(3)V9(2)        *
          * Dueño CAP            PIC X                * 
          *********************************************
        
        else
          ** Error en Valor s:1
          ACN(z1,1)
        endif
      endif
      
    endif
    
    *************************************** Envio de Datos ************************************
    * Envia los Datos a la Estacion Monitora, pasa la orden a la Instancia Siguiente y    *
    * actualiza la orden con los datos de envio                                           *
    *******************************************************************************************
    *- Longitud Total del Paquete en Caracteres
    ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4) )
    ACT(A2, Val(P1)~Val(A2))
    if Val(z1)=0
      if Dialogo.Check1=1
        Socket.Enviar(Val(A2))
        if Not OK
          Message('Error Enviando Orden Nro : '~FBN['NrOrden'])
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Error Enviando Orden.'~FBN['NrOrden'],30))
            CerrarASCII
          endif
        else
          if Eqstr(Var('LOGEAMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.TXT',0)
            EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
            CerrarASCII
          endif
          ACT(t:1, Val(s:1)~Val(s:2)~Val(s:3))
          * FJL 07/03/18 - Lo cambio porque EL MAE responde con la fecha real
*          ACT(t:2, Copy(Val(A2),11,6))
          ACT(t:2, Val(Y:4))
          ACT(t:3, Copy(Val(A2),17,6))
          ACT(t:4, Copy(Val(A2),23,5))
          ACT(t:5, Copy(Val(A2),28,4))
          ACT(t:6, 'INF')
          ACT(t:7, Copy(Val(A2),1,250))
          if Longitud(Val(A2))>250
            ACT(t:8, Copy(Val(A2),251,250))
          endif
          if Longitud(Val(A2))>500
            ACT(t:9, Copy(Val(A2),501,250))
          endif
          (.'GRAMENMAE'.)
          
          ACT(a:1, SQLAhora)
          SQL.ADD("Update "~DBO~".ORDENES ")
          SQL.ADD("   Set FechaEnvioMAE = "~Val(a:1)~", ")
          SQL.ADD("       SecEnvioMAE = "~Val(t:4)~" ")
          SQL.ADD(" Where NrOrden   = '"~FBN['NrOrden']~"' ")
          SQL.NEW
          if FBN['FechaOrden'] < FSYS
            SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
            SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
            SQL.ADD(" ) Values ( ")
            SQL.ADD(" '"~FBN['NrOrden']~"', ")
            SQL.ADD(" "~SQLAhora~", ")
            SQL.ADD(" 'MAEFVALOR', ")
            SQL.ADD(" '"~Copy(Val(A6),1,2)~'-'~Copy(Val(A6),3,55)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
          endif
          SQL.EXEC
          * Avanza la Orden a Espera Respuesta de MAE
          EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=0, Entero1=160, Entero2=162)
        endif
      * Fin Check1 = 1 (Procesa)
      endif
    * Fin z:1 = 0
    else
      * Error z:1 <> 0
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Error z1<>0 INFMAE ('~FBN['NrOrden']~')',30))
        CerrarASCII
      endif
    endif
  * Fin Orden = TMANIF
  else
    * Error en Tipo de Orden
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Error TipoOrden INFMAG ('~FBN['NrOrden']~')',30))
      CerrarASCII
    endif
  endif
Proximo
ACO(12,15)

