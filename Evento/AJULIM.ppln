creardialogo
especie1: 'Especie';1;1;1;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO');'Debe ingresar un titulo.';NO;;;;;;
fecha1: 'Fecha';2;1;1;;;;;;FSys()
check1: 'Procesa';4;1;1;NO;NO;;;;1;
check2: 'Automatico';5;1;1;NO;NO;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

Act(a:1, 'Especie')
Act(a:2, 'Fecha')
Act(a:3, 'Fecha Maduracion')
Act(a:4, 'Vehiculo')
Act(a:5, 'Cant.reg')
Act(a:6, 'A Ajsutar')
Act(a:7, 'Transaccion')
SetFont(a:1..a:10, 2)

Act(b:1, dialogo.especie1)
Acd(b:2, dialogo.fecha1)
Acd(b:3, BuscarCampo('ESPECIES', 'Fecha', 'Codigo', dialogo.especie1))
Act(b:4, Var('VEHICULODE'))

if (Val(b:3) > Val(b:2))
if (dialogo.check2 = 0 y dialogo.check1 = 1)
Cancelar('La fecha de maduracion  de la espeice '~dialogo.especie1~' es pasoterior a la fecha ingresada.')
else
Message('La fecha de maduracion  de la espeice '~dialogo.especie1~' es pasoterior a la fecha ingresada.')
if (dialogo.check2 = 1)
Cancelar()
endif
endif
endif


SetFilaActual(1)
Act(aa:fac, 'Cliente')
Act(ab:fac, 'Limite')
Act(ac:fac, 'Especie')
Act(ad:fac, 'Monto')
Act(ae:fac, 'Vehiculo')
Act(af:fac, 'Operador')
Act(ag:fac, 'Book')
Act(ah:fac, 'Responsable')
Act(ai:fac, 'TipoPosicion')
Act(aj:fac, 'Producto')
Act(ak:fac, 'GrupoEspecie')
Act(al:fac, 'CarteraBCRA')
Act(am:fac, 'Ajusta')
Act(an:fac, 'Ajustado')
SetFont(aa:fac..an:fac, 2)

Sqladd("SELECT * ")
Sqladd(" FROM "~Dbo()~".LIMCONSUMIDOS ")
Sqladd(" WHERE Especie  = '"~dialogo.especie1~"' ")
Sqladd(" AND   Limite   in ('BOOK','COUNTRY','ISSUER') ")
Sqladd(" AND   Vehiculo = '"~Val(b:4)~"' ")
recorrer sql
Scn(b:5, 1)

Act(aa:fac, Fbn('Cliente'))
Act(ab:fac, Fbn('Limite'))
Act(ac:fac, Fbn('Especie'))
Acn(ad:fac, Fbn('Monto'))
Act(ae:fac, Fbn('Vehiculo'))
Act(af:fac, Fbn('Operador'))
Act(ag:fac, Fbn('Book'))
Act(ah:fac, Fbn('Responsable'))
Act(ai:fac, Fbn('TipoPosicion'))
Act(aj:fac, Fbn('Producto'))
Act(ak:fac, Fbn('GrupoEspecie'))
Act(al:fac, Fbn('CarteraBCRA'))

if (Fbn('Monto') > 0)
Act(am:fac, 'SI')
Scn(b:6, 1)
endif
proximo

if (Val(b:6) = 0)
if (dialogo.check2 = 0 y dialogo.check1 = 1)
Cancelar('No existen limites consumidos para la espeice '~dialogo.especie1~'.')
else
Message('No existen limites consumidos para la espeice '~dialogo.especie1~'.')
if (dialogo.check2 = 1)
Cancelar()
endif
endif
endif

if (Val(b:6) > 0)
if (dialogo.check1 = 1)
Act(b:7, getnumerador(27))
Sqladd("INSERT INTO "~Dbo()~".TRANSACCIONES2 ( ")
Sqladd("   TipoTr2, NrTrans, Cliente1,  Fecha1, Especie, RB1, Vehiculo1, ")
Sqladd("   FechaCarga, FechaCargaSys, UsrInput ")
Sqladd(" ) VALUES ( ")
Sqladd("   'AJULIM', ")
Sqladd("   '"~Val(b:7)~"', ")
Sqladd("   '"~Val(b:4)~"', ")
Sqladd("   '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("   '"~dialogo.especie1~"', ")
Sqladd("   0, ")
Sqladd("   '"~Val(b:4)~"' ,")

Sqladd(" "~SQLAhora()~","~IdxDate2(FSys())~", '"~UsuarioActivo()~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()

recorrer&i 2, Val(b:5) + 1
if (Eqstr(Val(am:&i), 'SI'))
Act(an:&i, 'OK')

Sqladd("INSERT INTO "~Dbo()~".MOVLIMITES ( ")
Sqladd("   FechaMov,    Cliente,    Limite,       Especie,  Monto, ")
Sqladd("   NrOperacion, Descripcion, Bits,         Vehiculo, Operador, ")
Sqladd("   Book,        Responsable, TipoPOsicion, Producto, GrupoEspecie, ")
Sqladd("   CarteraBCRA ")

Sqladd(" ) VALUES ( ")

Sqladd("   '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("   '"~Val(aa:&i)~"', ")
Sqladd("   '"~Val(ab:&i)~"', ")
Sqladd("   '"~Val(ac:&i)~"', ")
Sqladd("   "~FStr(-Val(ad:&i), 1, 2)~", ")

Sqladd("   '"~Val(b:7)~"', ")
Sqladd("   'AJULIM "~Val(ac:&i)~"', ")
Sqladd("   'P', ")
Sqladd("   '"~Val(b:4)~"' ,")
Sqladd("   '"~Val(af:&i)~"', ")

Sqladd("   '"~Val(ag:&i)~"', ")
Sqladd("   '"~Val(ah:&i)~"', ")
Sqladd("   '"~Val(ai:&i)~"', ")
Sqladd("   '"~Val(aj:&i)~"', ")
Sqladd("   '"~Val(ak:&i)~"', ")

Sqladd("   '"~Val(al:&i)~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
endif
proximo
endif
endif

ACO(1, 15)

