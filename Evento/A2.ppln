sql.add(" VALUES ('"~IdxDate(FSys())~"', '"~Copy(Val(ww:1), 1, 6)~"', '"~IdxDate(Val(y:3))~"', 'FUT', ")
sql.add(" "~FStr(Val(e:Val(z5)), 0, 8)~","~FStr(Val(c:Val(z5)), 0, 8)~","~FStr(Val(d:Val(z5)), 0, 8)~","~FStr(Val(b:Val(z5)), 0, 8)~" )")
