Acn(bd:1, 1)
Acn(x:9, 0)
Acn(x:9, Query("SELECT 1 FROM "~Dbo()~".COTIZACIONES WHERE Codigo='"~Val(ww:1)~"' and CallPut='FUT'  and Fecha='"~IdxDate(FSys())~"'  AND FechaEj = '"~IdxDate(Val(y:3))~"' "))
proximo

if (Val(bd:1) = 1)
if (NoVacio(Val(a:Val(z5))))
