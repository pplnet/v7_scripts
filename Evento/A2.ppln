if ((Val(b:Val(z5)) + Val(c:Val(z5)) + Val(d:Val(z5)) + Val(e:Val(z5))) <> 0 y Query("SELECT Count(*) FROM "~Dbo()~".ESPECIES WHERE Codigo='"~Val(a:Val(z5))~"' ") = 1)
