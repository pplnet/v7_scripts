Sqladd("Precio3="~FStr(Val(d:Val(z5)), 1, 8)~", ")
Sqladd("Precio4="~FStr(Val(e:Val(z5)), 1, 8)~"  ")
Sqladd("WHERE  Codigo='"~Val(ww:1)~"' and CallPut='FUT' and Fecha='"~IdxDate(FSys())~"' AND FechaEj = '"~IdxDate(Val(y:3))~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT INTO "~Dbo()~".COTIZACIONES ")
Sqladd("(Fecha, Codigo, FechaEj ,CallPut, Precio1,Precio2,Precio3,Precio4) ")
Sqladd(" VALUES ('"~IdxDate(FSys())~"', '"~Copy(Val(ww:1), 1, 6)~"', '"~IdxDate(Val(y:3))~"', 'FUT', ")
Sqladd(" "~FStr(Val(e:Val(z5)), 0, 8)~","~FStr(Val(c:Val(z5)), 0, 8)~","~FStr(Val(d:Val(z5)), 0, 8)~","~FStr(Val(b:Val(z5)), 0, 8)~" )")
Sqlnew()
Sqlexec()
endif
else
if (NoVacio(Val(a:Val(z5))))
Scn(w:9, 1)
endif
endif

else
