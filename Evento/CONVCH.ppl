*    ACN(bc:&i, SQL("SELECT COUNT(*) FROM "~DBO~".CUENTAS WHERE NUMERO = '"~TRIM(MIRT(Val(ac:&i)))~"' "))
    ACN(bc:&i, SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE NUMERO = '"~TRIM(MIRT(Val(ac:&i)))~"' "))

    *Busco el Proveedor
    ACT(ae:&i,mirt(trim(fstr(val(ae:&i),15,0))))
*    ACN(bd:&i, SQL("SELECT COUNT(*) FROM "~DBO~".CNPROVEEDORES WHERE CODIGO = '"~TRIM(MIRT(Val(ae:&i)))~"' "))
    ACN(bd:&i, SQL("SELECT 1 FROM "~DBO~".CNPROVEEDORES WHERE CODIGO = '"~TRIM(MIRT(Val(ae:&i)))~"' "))
    If val(bd:&i) <> 1
      SQL.ADD(" INSERT INTO "~DBO~".CNPROVEEDORES ")
      SQL.ADD(" (Codigo, Nombre) ")
      SQL.ADD(" Values ('"~val(ae:&i)~"','"~val(af:&i)~"') ")
      SQL.NEW
      SQL.EXEC
    EndIf

