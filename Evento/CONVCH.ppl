*    ACN(be:&i, SQL("SELECT COUNT(*) FROM "~DBO~".ESPECIES WHERE CODIGO = '"~TRIM(MIRT(Val(aj:&i)))~"' "))
    ACN(be:&i, SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE CODIGO = '"~TRIM(MIRT(Val(aj:&i)))~"' "))

