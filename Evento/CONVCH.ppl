      ACN(bf:&i, val(bf:&i)-1)
    Else
      ACN(bf:&i, 1)
    EndIf
    *Calculo la diferencia de dias
    ACT(ag:&i,fecha(val(ag:&i)))    
    ACD(ag:&i, fecha(val(ag:&i)))
    ACT(ah:&i,fecha(val(ah:&i)))
    ACD(ah:&i, fecha(val(ah:&i)))
    ACN(bg:&i, DifDias(val(ah:&i),val(ag:&i)))

    *Verifico que la cuenta pertenezca al banco
*    ACN(bh:&i, SQL("SELECT COUNT(*) FROM "~DBO~".CUENTAS WHERE CLIENTE='"~val(aa:&i)~"' AND COMITENTE='"~val(ab:&i)~"' AND NUMERO='"~val(ac:&i)~"' "))
    ACN(bh:&i, SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE CLIENTE='"~val(aa:&i)~"' AND COMITENTE='"~val(ab:&i)~"' AND NUMERO='"~val(ac:&i)~"' "))

    *Busco el Numero de Chequera seg#n el numero de cheque
    ACN(bi:&i, SQL("SELECT CHEQUERA FROM "~DBO~".CNCHEQUERASBANCO WHERE VEHICULO='"~val(aa:&i)~"' AND BANCO='"~val(ab:&i)~"' AND CUENTA=(SELECT CODIGO FROM "~DBO~".CUENTAS WHERE NUMERO='"~val(ac:&i)~"') AND "~val(ad:&i)~" BETWEEN NRCHEQUEDESDE AND NRCHEQUEHASTA "))

