    ACT(bj:1, GetNumerador(10101))

    ACT(bk:&i, SQL("SELECT CODIGO FROM CUENTAS WHERE NUMERO='"~TRIM(MIRT(Val(ac:&i)))~"' "))

    If val(ba:&i)=1
