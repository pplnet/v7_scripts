creardialogo
fecha1: 'F.Liquid';;;;;;dialogo.fecha1 <> 0;'Debe ingresar una fecha';NO;FSys()
nrtrans1: 'Voucher';;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif


Act(xx:1, Var('PATHCARTA1'))
Act(xx:3, Var('PATHCARTA2'))
Act(xx:4, Var('PATHCARTA4'))
Act(xx:5, Var('PATHCARTA5'))

Sqladd(" Select T.NrTrans,T.Fecha1, T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, T.CB8, T.CB7, CO.Nombre RazonSocialCorresp, E.Nombre NomEsp, ")
Sqladd("        T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5, T.Precio1, T.Cliente2, T.Cuenta2, T.Vehiculo1, CO.Contacto ContactoCorresp, CU.Numero, CU.NrDepositante Comitente,   ")
Sqladd("        C.RazonSocial RSocialVeh, C.Cuit CuitVeh, CO.Codigo CodCorresp, T.Cuenta1 ")
Sqladd("   FROM  "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E, "~Dbo()~".TRANSACCIONES2 T LEFT OUTER JOIN "~Dbo()~".CUENTAS CU ON T.Cuenta2 = CU.Codigo  ")
Sqladd("         LEFT JOIN "~Dbo()~".CORRESPONSALES CO ON CU.Corresponsal = CO.Codigo  ")
Sqladd("  WHERE  T.Especie = E.Codigo   ")
Sqladd(" AND    T.Especie = '"~Var('MONELOCA')~"'   ")
Sqladd(" AND    T.Fecha1 = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND    T.Mercado1 in("~Pipe2Comillas(Var('MERCAACMC'))~")   ")
Sqladd(" AND    T.Vehiculo1 = C.Codigo  ")

if (NoVacio(dialogo.nrtrans1))
Sqladd(" and    T.NrTrans= '"~dialogo.nrtrans1~"'                                   ")
endif
Sqladd(" UNION ")
Sqladd(" Select T.NrTrans,T.Fecha1, T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, T.CB8, T.CB7, CO.Nombre RazonSocialCorresp, E.Nombre NomEsp, ")
Sqladd("        T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5, T.Precio1, T.Cliente2, T.Cuenta2, T.Vehiculo1, CO.Contacto ContactoCorresp, CU.Numero, CU.Comitente,   ")
Sqladd("        C.RazonSocial RSocialVeh, C.Cuit CuitVeh, CO.Codigo CodCorresp, T.Cuenta1 ")
Sqladd("   FROM  "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E, "~Dbo()~".TRANSACCIONES2 T LEFT OUTER JOIN "~Dbo()~".CUENTAS CU ON T.Cuenta2 = CU.Codigo  ")
Sqladd("         LEFT JOIN "~Dbo()~".CORRESPONSALES CO ON CU.Corresponsal = CO.Codigo  ")
Sqladd("  WHERE  T.Especie    = E.Codigo   ")
Sqladd("  AND    T.TipoTr2    = 'TRNOP'                             ")
Sqladd("  AND    T.CB5        = '1'                                 ")
Sqladd("  AND    T.CB6        = '1'                                 ")
Sqladd("  AND    T.Cliente1   = '"~Var('VEHICULODE')~"'             ")
Sqladd("  AND    T.Mercado1   in ("~Pipe2Comillas(Var('MERROFEX'))~") ")
Sqladd("  AND    T.Cliente2   = '"~Var('VEHICULODE')~"'             ")
Sqladd("  AND    T.Mercado2   in ("~Pipe2Comillas(Var('MERCBCRA'))~") ")
Sqladd("  AND    T.Especie    = '"~Var('MONELOCA')~"'               ")
Sqladd("  AND    T.Fecha1     = "~IdxDate2(dialogo.fecha1)~"        ")
Sqladd("  AND    T.Vehiculo1  = C.Codigo                            ")
if (NoVacio(dialogo.nrtrans1))
Sqladd(" and    T.NrTrans = '"~dialogo.nrtrans1~"'              ")
endif
Sqladd(" order by T.NrTrans                ")
Watch(Sqlbatch())
Acn(z:1, 0)

recorrer sql
Scn(z:1, 1)

Act(a:Val(z1), Fbn()['NrTrans'])

Act(b:Val(z1), Fbn()['TipoTr2'])


Acd(c:Val(z1), Fbn()['Fecha1'])

Act(o:Val(z1), FStr(Dia(Val(c:Val(z1))), 0, 0)~' de '~Meses(Mes(Val(c:Val(z1))))~' de '~FStr(Anio(Val(c:Val(z1))), 0, 0))

Act(d:Val(z1), Fbn()['RazonSocialCorresp'])
if (Vacio(Val(d:Val(z1))))
Messagebox('Falta definir corresponsal cuenta '~Fbn()['Cuenta2'])
endif

Act(e:Val(z1), Fbn()['NUMERO'])

Act(f:Val(z1), Fbn()['Especie'])

if (Fbn()['Cantidad1'] >= 0)
Act(g:Val(z1), PYC(Fbn()['Cantidad1'], 1, 2))
Act(h:Val(z1), Letras(Fbn()['Cantidad1'], 0, 150))
else
Act(g:Val(z1), PYC(-Fbn()['Cantidad1'], 1, 2))
Act(h:Val(z1), Letras(-Fbn()['Cantidad1'], 0, 150))
endif

if (Eqstr(Fbn()['TipoTr2'], 'DEP'))
Act(i:Val(z1), Fbn()['RSocialVeh'])
Act(j:Val(z1), Fbn()['CuitVeh'])
Act(k:Val(z1), Fbn()['Comitente'])
Act(m:Val(z1), 'Operaciones con el MAE')
else
if (Eqstr(Fbn()['TipoTr2'], 'TRNOP'))
Act(i:Val(z1), Fbn()['RSocialVeh'])
Act(j:Val(z1), Fbn()['CuitVeh'])
Act(k:Val(z1), Fbn()['Comitente'])
Act(m:Val(z1), 'Operaciones con ROFEX')
endif
endif

Act(n:Val(z1), Fbn()['CodCorresp'])

Act(p:Val(z1), Fbn()['NomEsp'])


Act(s:Val(z1), Fbn()['ContactoCorresp'])

Act(ct:Val(z1), Fbn()['Cuenta1'])

Act(me:Val(z1), Fbn()['Mercado1'])

proximo

if (Val(z:1) = 0)
Cancelar('No existen cartas para imprimir')
else
ACO(1, 10)
ACO(2, 5)
ACO(3, 10)
ACO(4, 18)
ACO(5, 10)
ACO(6, 10)
endif

* listbox stripped

if (ok)
* recorrersel stripped







































endif

