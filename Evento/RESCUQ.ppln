sql.add("Select * from "~Dbo()~".RESULTADOS R1 ")
sql.add(" where R1.TipoResultado in ('CUPAMO','CUPREN') ")
sql.add("   and R1.Especie  =  '"~Val(j:2)~"' ")
sql.add("   and R1.Vehiculo =  '"~Val(e:2)~"' ")
if (NoVacio(Val(f:2)))
sql.add("   and IsNull(R1.Book,'')     =  '"~Val(f:2)~"' ")
endif
sql.add("   and R1.NrSaldo  in (120,130) ")
sql.add("   and R1.Fecha    >= "~IdxDate2(Val(az:7))~" ")
sql.add("   and R1.Fecha    = (select Max(Fecha) ")
sql.add("                       from  "~Dbo()~".RESULTADOS R2 ")
sql.add("                       where R2.Especie         =  R1.Especie ")
sql.add("                        and  R2.Vehiculo        =  R1.Vehiculo ")
sql.add("                        and  IsNull(R2.Book,'') =  IsNull(R1.Book,'') ")
sql.add("                        and  R2.NrSaldo         =  R1.NrSaldo ")
sql.add("                        and  R2.TipoResultado   =  R1.TipoResultado ")
sql.add("                        and  R2.TipoNegocio     =  R1.TipoNegocio ")
sql.add("                        and  R2.Fecha          <= "~IdxDate2(Val(c:2))~" ")
sql.add("                     ) ")
sql.add(" Order By Fecha ")
recorrer sql
