sql.add("Select P.* From "~Dbo()~".POSICIONES P ")
sql.add(" Where P.TipoNegocio  = 'SEC' ")
sql.add("   and P.CantidadFin  <> 0 ")
sql.add("   and P.NrSaldo      in (120,130) ")
sql.add("   and P.Especie      = '"~Fbn('Especie2')~"' ")
sql.add("   and P.Vehiculo     = '"~Fbn('Vehiculo1')~"' ")
sql.add("   and P.Fecha       <= '"~IdxDate(Val(c:fac))~"' ")
sql.add("   and P.Fecha = (Select MAX(P1.Fecha) ")
sql.add("                    From "~Dbo()~".POSICIONES P1 ")
sql.add("                   Where P1.Vehiculo        = P.Vehiculo ")
sql.add("                     and P1.TipoNegocio     = P.TipoNegocio ")
sql.add("                     and P1.Cliente         = P.Cliente ")
sql.add("                     and P1.Especie         = P.Especie ")
sql.add("                     and P1.Cupon           = P.Cupon ")
sql.add("                     and P1.NrSaldo         = P.NrSaldo ")
sql.add("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
sql.add("                     and P1.Fecha           < '"~IdxDate(Val(c:fac))~"' ")
sql.add("                 ) ")
sql.add(" order by NrSaldo,Especie,Cupon,Vehiculo,Fecha ")
recorrer sql
