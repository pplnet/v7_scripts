ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'FCS|');'El TipoOp debe ser FCS';NO;;;;;;" TipoOp in ('FCS') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACFCS')
FinDialogo

If Not OK
  Cancelar
Endif

let &banco BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1)
#ifdef bfsa
    let &archivo 'SUSCRIPCION_'~&banco~'_FCI.dotx'
#else
    let &archivo Dialogo.String1
#endif

********************************************************VALIDACION DIRECTORIO Y ARCHIVO*******************************************
If ExisteDirectorio(Dialogo.Directorio1)
    If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
        let &pathCompleto Dialogo.Directorio1~&archivo
    Else
        let &pathCompleto Dialogo.Directorio1~'\'~&archivo
    Endif
    #ifdef bfsa
    If Not ExisteArchivo(&pathCompleto)
        let &archivo Dialogo.String1
        let &pathCompleto Dialogo.Directorio1~'\'~&archivo
    Endif
    #endif
    If Not ExisteArchivo(&pathCompleto)
       Cancelar('1.El Archivo '~&archivo~' no existe en el directorio: '~Dialogo.Directorio1)
    Endif
    
Else
    Cancelar('El directorio '~Dialogo.Directorio1~' no existe')
Endif
**********************************************************SQL*************************************************************

SQL.ADD("Select O.TipoOp, O.Cliente1,O.Especie,O.Vehiculo1,O.NrOperacion,O.Cuenta1,O.Cuenta2,O.TotalNetoCli1,O.ContraEspecie, ")
SQL.ADD("C.Localidad, C.CUIT, C.RazonSocial, O.FechaOp,O.Cantidad ")
SQL.ADD(" From "~DBO~".OPERACIONES O ,"~DBO~".CLIENTES C   ")
SQL.ADD(" Where NrOperacion ='"~Dialogo.NrOperacion1~"' and O.Vehiculo1=C.Codigo  ")
Recorrer SQL
  let &fecha_op fbn['FechaOp']
  let &localidad fbn['Localidad'] 
  let &razon_social_contraparte BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1'])
  let &especie BuscarCampo('ESPECIES','Extendido','Codigo',Fbn['Especie'])
  let &nr_cuotapartista BuscarCampo('CUENTAS','Alias9','Codigo',Fbn['Cuenta1'])
  let &cuit_vehiculo Fbn['CUIT']
  let &nr_cuenta_contraparte BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])
  let &nr_cuenta_debito BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta2'])
  let &cbu_cuenta_debito BuscarCampo('CUENTAS','CBU','Codigo',fbn['Cuenta2'])
  let &total_neto FBN('TotalNetoCli1')
  let &total_string Letras(FBN('TotalNetoCli1'),0,100)
  let &contraespecie FBN('ContraEspecie')
  let &razon_social_bancodebito BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Comitente','Codigo',FBN['Cuenta2']))
  let &razon_social_vehiculo FBN('RazonSocial')
  if EqStr(FBN('ContraEspecie'),var('MONEEXTR')) 
      let &contraespecie 'u$s'
      let &contraespecie_string 'dolares' 
  else
      if EqStr(FBN('ContraEspecie'),var('MONELOCA'))    
          let &contraespecie '$' 
          let &contraespecie_string 'pesos'
      else     
          let &contraespecie FBN('ContraEspecie')
      endif  
  endif 
Proximo
****************************************************************************************************************************************************

let &fecha_larga FStr(Dia(&fecha_op),2,0)~' de '~Meses(Mes(&fecha_op))~' de '~FStr(Anio(&fecha_op),4,0)

  


let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~&archivo
Else
    let &pf Dialogo.Directorio1~'\'~&archivo
Endif

EmitirCartaVisible(&pf, Copy(&archivo,1,Longitud(&archivo)-5)~'_'~Dialogo.NrOperacion1,razon_social_vehiculo=&razon_social_vehiculo,nr_cuenta_contraparte=&nr_cuenta_contraparte,razon_social_contraparte=&razon_social_contraparte, localidad = &localidad, fecha_larga = &fecha_larga, especie=&especie,nr_cuotapartista=&nr_cuotapartista,cuit_vehiculo=&cuit_vehiculo,contraespecie=&contraespecie,total_neto=&total_neto,contraespecie_string=&contraespecie_string,total_string=&total_string,nr_cuenta_debito=&nr_cuenta_debito,razon_social_bancodebito=&razon_social_bancodebito,cbu_cuenta_debito = &cbu_cuenta_debito)

