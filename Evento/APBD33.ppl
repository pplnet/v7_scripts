MostrarCuadroDeMensajes
CrearDialogo
  Fecha1    :"Fecha"            ;1;1;;NO;;;;;;FSYS
  Fecha2    :"D.FechaProceso"   ;2;1;;  ;;;;;HABILES(FSYS,-1,'ARG')
  Fecha3    :"H.FechaProceso"   ;3;1;;  ;;;;;HABILES(FSYS,-1,'ARG')
  String    :"Archivo"          ;4;1;;  ;;NOVACIO(Dialogo.String) ;'Archivo Invalido'   ;NO;VAR('DNCTAS');;;;;;;;;SI
  String2   :"Nuevo Directorio" ;5;1;;  ;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;0
  Check10: 'HojaVisible' ;;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

If Dialogo.Check10=1
   HojaVisible(SI)
EndIf

ACN(x:3,0)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(a:1, 'Errores en la interfaz de Captura de Saldos y Movimientos. Archivo: '~Dialogo.String)
SetFont(a:1, 2)
ACT(a:3, 'Cuenta')
ACT(b:3, 'Banco')
ACT(C:3, 'Vehiculo')
ACT(D:3, 'Sucursal')
ACT(E:3, 'Importe/Saldo')
ACT(F:3, 'DC')
ACT(G:3, 'F.Valor')
ACT(H:3, 'F.Acred.')
ACT(I:3, 'Comprob.')
ACT(J:3, 'Tipo Mov.')
ACT(K:3, 'Observ.')
SetFont(A:3..K:3, 2)
AgregarMarco(A:3..K:3, 0, 0, Exe('COLOR6'))
ACN(x:4, 4)
ACN(x:6,0)
ACT(ta:3,'')
ACT(DT:1, Var('DTTIPNN'))
ACT(DD:1, Var('DTDESNN'))

* ------------------  DEFINE EL TIPO DE ARCHIVO ------------------------------------ *
AbrirAscii(MAYUSCULAS2(Dialogo.String),0)
Recorrer&i 1,1
 ACT(ta:1,LEERASCII)
 ACT(tc:1, Copy(Val(ta:1),17,6))

 If Incluido(Val(tc:1),'DNAHMS')
   * CAJA DE AHORRO EN PESOS - DNAHMS
   ACN(ta:1, 1)
 Endif
 If Incluido(Val(tc:1),'DNCTAS')
   * CC EN PESOS - DNCTAS
   ACN(ta:1, 2)
 Endif
 If Incluido(Val(tc:1),'DNCADO')
   * CAJA DE AHORRO EN DOLARES - DNCADO
   ACN(ta:1, 3)
 Endif
 If Incluido(Val(tc:1),'DNCCDO')
   * CC EN DOLARES - DNCCDO
   ACN(ta:1, 4)
 Endif
Proximo
CerrarAscii
* ---------------------------------------------------------------------------------- *

IF NO
* -------------------  BUSCA UNA CUENTA CORTA VALIDA -------------------------------- *
AbrirAscii(MAYUSCULAS2(Dialogo.String),0)

Recorrer&i 1,10000000
 ACT(ta:1,LEERASCII)
 If &i>=2
    * --- Saco la cuenta corta para identificar la moneda y tipo de cuenta.
    ACT(ta:2, Copy(Val(ta:1),2,5) )
    ACT(ta:3, SQL(" SELECT /*+ RULE */ Codigo FROM "~DBO~".CUENTAS WHERE Alias3 = '"~Val(ta:2)~"' ") )

    If NoVacio(Val(ta:3)) o Vacio(Val(ta:1))
      * --- Cuando encuentro una cuenta valida para determinar la moneda o terminal el archivo, salgo.
      Break
    Endif
 Endif
Proximo
CerrarAscii
* ---------------------------------------------------------------------------------- *

If Vacio(Val(ta:3)) 
  message('No se encontraron cuentas validas en el archivo.')
  ACN(ta:4,1)
Endif


* ------------------  DEFINE EL TIPO DE ARCHIVO ------------------------------------ *
SQL.ADD(" SELECT /*+ RULE */ Codigo, Especies, Alias3, TipoCuenta FROM "~DBO~".CUENTAS WHERE Codigo = '"~MIRT(TRIM(Val(ta:3)))~"' ")
Recorrer SQL
  dfa
  ACT(tc:1, fbn('TipoCuenta'))
  If Incluido('ARP',fbn('Especies'))
    ACT(es:1, 'ARP')
  Endif
  If Incluido('USD',fbn('Especies'))
    ACT(es:1, 'USD')
  Endif
  If Incluido('USB',fbn('Especies'))
    ACT(es:1, 'USD')
  Endif
Proximo

If Eqstr(Val(es:1),'ARP')
   If Incluido(Val(tc:1),'CA')
     * CAJA DE AHORRO EN PESOS - DNAHMS
     ACN(ta:1, 1)
   Else
     * CC EN PESOS - DNCTAS
     ACN(ta:1, 2)
   Endif
Else
   If Incluido(Val(tc:1),'CA')
     * CAJA DE AHORRO EN DOLARES - DNCADO
     ACN(ta:1, 3)
   Else
     * CC EN DOLARES - DNCCDO
     ACN(ta:1, 4)
   Endif
Endif
* ---------------------------------------------------------------------------------- *
ENDIF

* --------------------------- PROCESA EL ARCHIVO ----------------------------------- *
ACT(PT:1, Var('DNERROR'))

If Val(ta:1)=2
  ACT(bl:1, Val(PT:1)~'DNCTAS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
  ACT(bl:2, Dialogo.String2~"DNCTAS-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
  ACT(bl:3, Val(PT:1)~'DNCTAS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
EndIf
If Val(ta:1)=1
  ACT(bl:1, Val(PT:1)~'DNAHMS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
  ACT(bl:2, Dialogo.String2~"DNAHMS-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
  ACT(bl:3, Val(PT:1)~'DNAHMS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
EndIf
If Val(ta:1)=4
  ACT(bl:1, Val(PT:1)~'DNCCDO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
  ACT(bl:2, Dialogo.String2~"DNCCDO-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
  ACT(bl:3, Val(PT:1)~'DNCCDO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
EndIf
If Val(ta:1)=3
  ACT(bl:1, Val(PT:1)~'DNCADO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
  ACT(bl:2, Dialogo.String2~"DNCADO-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
  ACT(bl:3, Val(PT:1)~'DNCADO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
EndIf

If ExisteArchivo(MAYUSCULAS2(Dialogo.String))
  * --- Si existe el archivo paso como parametro, busca los mov del dia y crea los archivos de errores
IF NO
  ***---Se quita verificacion
  SQL.ADD(" SELECT M.Vehiculo, M.Banco, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, M.DC, ")
  SQL.ADD(" M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, M.EstadoConciliacion, M.NrDatanet ")
  SQL.ADD(" FROM " ~DBO~ ".MOVDATANET M, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE M.NrDatanet   = D.NrDatanet ")
  SQL.ADD(" AND   D.FechaBajada = '" ~idxdate(Dialogo.Fecha1)~ "' ")
  If Val(ta:1)=2
    SQL.ADD(" AND   D.Archivo     = 'DNCTAS' ")
    ACT(bl:1, Val(PT:1)~'DNCTAS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(bl:2, Dialogo.String2~"DNCTAS-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(bl:3, Val(PT:1)~'DNCTAS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=1
    SQL.ADD(" AND   D.Archivo     = 'DNAHMS' ")
    ACT(bl:1, Val(PT:1)~'DNAHMS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(bl:2, Dialogo.String2~"DNAHMS-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(bl:3, Val(PT:1)~'DNAHMS-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=4
    SQL.ADD(" AND   D.Archivo     = 'DNCCDO' ")
    ACT(bl:1, Val(PT:1)~'DNCCDO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(bl:2, Dialogo.String2~"DNCCDO-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(bl:3, Val(PT:1)~'DNCCDO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  If Val(ta:1)=3
    SQL.ADD(" AND   D.Archivo     = 'DNCADO' ")
    ACT(bl:1, Val(PT:1)~'DNCADO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
    ACT(bl:2, Dialogo.String2~"DNCADO-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
    ACT(bl:3, Val(PT:1)~'DNCADO-'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")
  EndIf
  SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet ")

  Recorrer SQL
    message('Recuperando MovDatanet del dia.')
    ACN(x:3,1)
    ACT(x:2,fbn('NrDatanet'))
    ACT(ba:fac,fbn("vehiculo"))
    ACT(bb:fac,fbn("banco"))
    ACT(bc:fac,fbn("sucursal"))
    ACT(bd:fac,fbn("cuenta"))
    ACT(be:fac,fbn("moneda"))
    ACN(bf:fac,fbn("importe"))
    ACT(bg:fac,fbn("dc"))
    ACD(bh:fac,fbn("fechaingreso"))
    ACD(bi:fac,fbn("fechaacreditacion"))
    ACT(bj:fac,fbn("tipomov"))
    ACN(bk:fac,NUM(fbn("comprobante")))
  Proximo
ENDIF
  ACN(fi:1, fac)
  If val(x:3) = 1
    * --- Encontro MovDatanet del Dia, guarda el ultimo nro de mov de la tabla.
    ACN(nm:1, SQL("SELECT /*+ RULE */ MAX(NrMovDatanet) FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(x:2)~"' "))
  Endif
  * --- Abre el archivo pasado como parametro
  AbrirAscii(MAYUSCULAS2(Dialogo.String),0)

  Recorrer&i 1,1000000
    ACT(x:1,LEERASCII)
    ACN(nm:2, &i)
    message(' Registrando movimientos del archivo '~Dialogo.String~' - '~fstr(Val(nm:2),0,0))

    If Vacio(val(x:1))
      * --- Termino el archivo
      ACT(aq:&i, Val(x:1))
      ACN(x:5, &i)
      Break  
    Endif

    If Eqstrl(Val(x:1),"H",1)
      * --- Tipo de Registro : SALDO
      message(' Tipo de registro: Saldo')

      ACT(aa:&i,Copy(Val(x:1),1,1))

      *Banco
      ACT(ab:&i,Copy(Val(x:1),2,3))

      *Cuenta Corta
      ACT(ac:&i,Copy(Val(x:1),5,2))

      *Fecha
      ACT(ad:&i,Copy(Val(x:1),13,2)~'/'~Copy(Val(x:1),11,2)~'/'~Copy(Val(x:1),7,4))
      ACD(ad:&i,Fecha(Val(ad:&i)))

      *D/C
      ACT(ae:&i,Copy(Val(x:1),15,1))

      *Saldo
      ACN(af:&i, NUM(COPY(Val(x:1),16,15)~'.'~COPY(Val(x:1),31,2)))

      *Importe Total de Debitos
      ACN(ag:&i, NUM(COPY(Val(x:1),33,15)~'.'~COPY(Val(x:1),48,2)))

      *Importe Total de Creditos
      ACN(ah:&i, NUM(COPY(Val(x:1),50,15)~'.'~COPY(Val(x:1),65,2)))

      *Cuenta Larga
*      ACT(z:&i,Copy(Val(x:1),67,17))
      *Cuenta Corta + Banco
      ACT(cc:&i,Copy(Val(x:1),2,5))
      ACT(z:&i, SQL(" SELECT /*+ RULE */ Numero FROM "~DBO~".CUENTAS WHERE Alias3 = '"~TRIM(MIRT(Val(cc:&i)))~"' ") )

      *Vehiculo
      ACT(ai:&i, SQL(" SELECT /*+ RULE */ Cliente FROM "~DBO~".CUENTAS WHERE Numero = '"~TRIM(MIRT(Val(z:&i)))~"' ") )

      *Sin Contenido
      ACT(aj:&i,Copy(Val(x:1),84,47))

    Else
      * (Else del tipo de regisro)

      If Eqstrl(Val(x:1),"M",1)
        message(' Tipo de registro: Movimiento')
        *Tipo de Registro : MOVIMIENTO
        ACT(aa:&i,Copy(Val(x:1),1,1))

        *Banco
        ACT(ab:&i,Copy(Val(x:1),2,3))

        *Cuenta Corta
        ACT(ac:&i,Copy(Val(x:1),5,2))

        *Fecha del Movimiento
        ACT(ad:&i,Copy(Val(x:1),13,2)~'/'~Copy(Val(x:1),11,2)~'/'~Copy(Val(x:1),7,4))
        ACD(ad:&i,Fecha(Val(ad:&i)))

        *Fecha Valor
        ACT(ae:&i,Copy(Val(x:1),21,2)~'/'~Copy(Val(x:1),19,2)~'/'~Copy(Val(x:1),15,4))
        ACD(ae:&i,Fecha(Val(ae:&i)))

        *D/C
        ACT(af:&i,Copy(Val(x:1),23,1))

        *Importe
        ACN(ag:&i, NUM(COPY(Val(x:1),24,15)~'.'~COPY(Val(x:1),39,2)))

        *Numero Comprobante
        ACT(ah:&i,Copy(Val(x:1),41,12))

        *Codigo Operacion
        ACT(ai:&i,Copy(Val(x:1),53,3))
*        ACN(ar:&i, SQL("SELECT COUNT(*) FROM "~DBO~".CODIGOSDATANET WHERE Codigo='"~val(ai:&i)~"' AND Tipo is not NULL"))
        ACN(ar:&i, SQL("SELECT /*+ RULE */ 1 FROM "~DBO~".CODIGOSDATANET WHERE Codigo='"~val(ai:&i)~"' "))
        IF Val(AR:&i) <> 1 Y Not Eqstr(Val(AI:&i), '   ') Y Not CeldaVacia(AI:&i)
            ***---No Existe el Codigo de Operacion => lo inserto como generico
            SQL.ADD(" Insert Into "~DBO~".CODIGOSDATANET ")
            SQL.ADD(" (Codigo, Descripcion, Tipo) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~Mayusculas2(Val(AI:&i))~"', '"~Val(DD:1)~"', '"~Val(DT:1)~"') ")
            SQL.NEW
            SQL.EXEC
        ENDIF

        *Fecha de Proceso
        ACT(aj:&i,Copy(Val(x:1),62,2)~'/'~Copy(Val(x:1),60,2)~'/'~Copy(Val(x:1),56,4))
        ACD(aj:&i,Fecha(Val(aj:&i)))

        *Sin Contenido
        ACT(ak:&i,Copy(Val(x:1),64,3))

        *Informacion Libre
        ACT(al:&i,Copy(Val(x:1),67,25))

        *Suc Origen
        ACT(am:&i,Copy(Val(x:1),92,5))

        *Codigo De Depositante
        ACT(an:&i,Copy(Val(x:1),97,8))

        *Cuenta Larga
*        ACT(z:&i,Copy(Val(x:1),105,17))
        ACT(cc:&i,Copy(Val(x:1),2,5))
        ACT(z:&i, SQL(" SELECT /*+ RULE */ Numero FROM "~DBO~".CUENTAS WHERE Alias3 = '"~TRIM(MIRT(Val(cc:&i)))~"' ") )

        *Vehiculo
        ACT(ao:&i, SQL(" SELECT /*+ RULE */ Cliente FROM "~DBO~".CUENTAS WHERE Numero = '"~TRIM(MIRT(Val(z:&i)))~"' ") )

        *Sin Contenido
        ACT(ap:&i,Copy(Val(x:1),122,9))
        * Tipo M
      EndIf
      * Tipo H
    EndIf

    ACT(aq:&i, Val(x:1))
    ACN(x:5, &i)
  Proximo

  * --- Cierra el archivo pasado como parametro.
  CerrarAscii
  * ------------------------------------------------------------------------------- *


  * -------- Abre archivo para Grabar errores para las lineas sin cuentas. -------- *
  AbrirAscii(val(bl:1),0)

  Message('Abriendo archivo de errores '~val(bl:1))
  If val(x:3) = 1
    * Hay movimientos Datanet del Dia
    Recorrer&i 1,val(x:5)
      * --- Recorre los mov del ASCII
      If Eqstrl(Val(aa:&i),"H",1)
        If val(ad:&i) >= Dialogo.Fecha2 y val(ad:&i)<= Dialogo.Fecha3
          * --- Si la fecha de Proceso es correcta

          If NoVacio(val(ai:&i))
            * --- Si tiene vehiculo 
    
            Recorrer&j 1,Val(fi:1)
            * --- Recorre los movimientos de la tabla para cada linea del ascii para ver si ya existe.
              If Eqstr(val(ai:&i),val(ba:&j)) y Eqstr(val(ab:&i),val(bb:&j)) y ROUND(val(af:&i),2)=ROUND(val(bf:&j),2) 
                message('El movimiento ya existe.')
                ACT(nn:1,'0')
                Break
              Else
                ACT(nn:1,'1')
              EndIf
            Proximo

            If Eqstrl(Val(nn:1),'1',1)
              SCN(nm:1,1)
              SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
              SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
              SQL.ADD(" Banco, Cuenta, ")
              SQL.ADD(" Moneda, ")
              SQL.ADD(" Importe, DC, ")
              SQL.ADD(" FechaAcreditacion, TipoMov, ")
              SQL.ADD(" EstadoConciliacion ")
              SQL.ADD(" ) VALUES ( ")
              SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ai:&i)~"', ")
              SQL.ADD(" '"~val(ab:&i)~"', '"~val(z:&i)~"', ")
              If Val(ta:1)=2 o Val(ta:1)=1
                SQL.ADD(" '$', ") 
              EndIf
              If Val(ta:1)=4 o Val(ta:1)=3
                SQL.ADD(" 'U$S', ")
              EndIf
              SQL.ADD(" "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
              SQL.ADD(" "~Idxdate2(val(ad:&i))~", 'SAL', 'OK' )  ")
              SQL.NEW
              SQL.EXEC
              message(' Movimiento nuevo OK.')
            ELSE
              ***---Movimiento Duplicado
              * --- Cuenta Corta
              ACT(a:Val(x:4), Val(cc:&i))
              * --- Banco
              ACT(b:Val(x:4), Val(ab:&i))
              ACT(C:Val(X:4), Val(AI:&I))
              ACN(E:Val(X:4), Val(AF:&I))
              ACT(F:Val(X:4), Val(AE:&I))
              ACD(H:Val(X:4), Val(AD:&I))
              ACT(J:Val(X:4), 'H')
              ACT(K:Val(X:4), 'Registro Duplicado')
              SCN(x:4,1)
              EscribirAscii(Val(aq:&i))
              SCN(x:6,1)
            EndIf          
          Else
            * --- Si no tiene vehiculo 
            message(' La cuenta corta '~Val(cc:&i)~' no existe.')
            ACT(a:Val(x:4), Val(cc:&i))
            ACT(b:Val(x:4), Val(ab:&i))
            ACT(c:Val(x:4), 'La cuenta corta '~Val(cc:&i)~' no existe.')
            ACT(L:Val(X:4), 'H')
            SCN(x:6,1)
            * --- Si no tiene vehiculo graba el error (archivo: bl:1).
            EscribirAscii(Val(aq:&i))
            * --- Endif de Tiene Vehiculo
          EndIf
          * --- Endif de Fecha Correcta
        EndIf
      Else
        * --- (Else de Tipo de Movimiento)
        If val(aj:&i) >= Dialogo.Fecha2 y val(aj:&i) <= Dialogo.Fecha3
          * --- Fecha de Acreditacion correcta
          If Eqstrl(Val(aa:&i),"M",1)
            If NoVacio(val(ao:&i))
              * --- Si tiene vehiculo      

              Recorrer&j 1,Val(fi:1)
              * --- Recorre los movimientos de la tabla para cada linea del ascii para ver si ya existe.
                If Eqstr(val(ao:&i),val(ba:&j)) y Eqstr(val(ab:&i),val(bb:&j)) y NoVacio(val(bc:&j)) y Eqstr(fstr(val(am:&i),0,0),fstr(val(bc:&j),0,0)) y Eqstr(fstr(val(z:&i),0,0),fstr(val(bd:&j),0,0)) y ROUND(val(ag:&i),2)=ROUND(val(bf:&j),2) y Eqstr(val(af:&i),val(bg:&j))y val(aj:&i)=val(bh:&j) y Val(ae:&i) = val(bi:&j) y Eqstr(val(ai:&i),val(bj:&j)) y Eqstr(Pad0(val(ah:&i),17),Pad0(fstr(val(bk:&j),0,0),17))
                  ACT(nn:1,'0')
                  Break
                Else
                  ACT(nn:1,'1')
                EndIf
              Proximo

              If Eqstrl(Val(nn:1),'1',1)
                IF Val(AJ:&i) = Dialogo.Fecha3
                    ACT(TM:1, Val(AI:&i))
                    ACT(EC:1, 'P')
                ELSE
                    ACT(TM:1, 'INI')
                    ACT(EC:1, 'FC')
                ENDIF
                SCN(nm:1,1)
                SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
                SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
                SQL.ADD(" Banco, Sucursal, Cuenta, ")
                SQL.ADD(" Moneda, ")
                SQL.ADD(" Importe, DC, ")
                SQL.ADD(" FechaIngreso, FechaAcreditacion, TipoMov, ")
                SQL.ADD(" Comprobante, EstadoConciliacion ")
                SQL.ADD(" ) VALUES ( ")
                SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ao:&i)~"', ")
                SQL.ADD(" '"~val(ab:&i)~"', '"~val(am:&i)~"', '"~val(z:&i)~"', ")
                If Val(ta:1)=2 o Val(ta:1)=1
                  SQL.ADD(" '$', ")
                EndIf
                If Val(ta:1)=4  o Val(ta:1)=3
                  SQL.ADD(" 'U$S', ")
                EndIf
                SQL.ADD(" "~fstr(val(ag:&i),1,2)~", '"~val(af:&i)~"', ")
                SQL.ADD(" "~Idxdate2(val(aj:&i))~", "~IdxDate2(val(ae:&i))~", '"~Val(TM:1)~"', ")
                SQL.ADD(" '"~val(ah:&i)~"', '"~Val(EC:1)~"' )  ")
                SQL.NEW
                SQL.EXEC
                If val(ar:&i) <> 1
                  message(' El codigo de operacion no existe/no esta tipificado.')
                  ACT(a:Val(x:4), Val(ai:&i))
                  ACT(c:Val(x:4), 'El codigo de operacion no existe/no esta tipificado.')
                  SCN(x:4,1)
                EndIf
                message(' Movimiento nuevo OK.')
              ELSE
                ***---Movimiento Duplicado
                * --- Cuenta Corta
                ACT(a:Val(x:4), Val(cc:&i))
                * --- Banco
                ACT(b:Val(x:4), Val(ab:&i))
                ACT(C:Val(X:4), Val(AO:&I))
                ACT(D:Val(X:4), Val(AM:&I))
                ACN(E:Val(X:4), Val(AG:&I))
                ACT(F:Val(X:4), Val(AF:&I))
                ACD(G:Val(X:4), Val(AE:&I))
                ACD(H:Val(X:4), Val(AD:&I))
                ACT(I:Val(X:4), Val(AH:&I))
                ACT(J:Val(X:4), 'M')
                ACT(K:Val(X:4), 'Registro Duplicado')
                SCN(x:4,1)
                EscribirAscii(Val(aq:&i))
                SCN(x:6,1)
              EndIf
            Else
              * Si no tiene Vehiculo
              If val(ar:&i) <> 1
                message(' El codigo de operacion no existe/no esta tipificado.')
                ACT(a:Val(x:4), Val(ai:&i))
                ACT(c:Val(x:4), 'El codigo de operacion no existe/no esta tipificado.')
                ACT(L:Val(X:4), 'M')
                SCN(x:4,1)
              Endif
              message(' La cuenta corta '~Val(cc:&i)~' no existe.')
              ACT(a:Val(x:4), Val(cc:&i))
              ACT(b:Val(x:4), Val(ab:&i))
              ACT(c:Val(x:4), 'La cuenta '~Val(cc:&i)~' no existe.')
              ACT(L:Val(X:4), 'M')
              SCN(x:6,1)

              * --- Si no tiene vehiculo graba el error en el txt abierto.
              EscribirAscii(Val(aq:&i))
              * --- Endif de tiene vehiculo
            EndIf
            * --- Endif de Tipo de Movimiento M
          EndIf
          * --- Endif de Fecha Correcta
        EndIf
        * --- Endif de Tipo de Movimiento H
      EndIf
      * --- Termino de recorrer los mov del dia
    Proximo

  Else
    * --- No hay MovDatanet del Dia
    ACT(x:2,getnumerador(7))
    ACN(nm:1,0)

    Recorrer&i 1,val(x:5)
      * --- Recorre los movimientos del Ascii 
*Message('AD: '~Val(AD:&i))
*Message('AJ: '~Val(AJ:&i))
*Message('VH: '~Val(AO:&i))
      If Eqstr(Val(aa:&i),"H")
        If val(ad:&i) >= Dialogo.Fecha2 y val(ad:&i) <= Dialogo.Fecha3
           * --- Fecha de Acreditacion correcta
          If NoVacio(val(ai:&i))
            * --- Si tiene vehiculo
            SCN(nm:1,1)
            SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
            SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
            SQL.ADD(" Banco, Cuenta, ")
            SQL.ADD(" Moneda, ")
            SQL.ADD(" Importe, DC, ")
            SQL.ADD(" FechaAcreditacion, TipoMov, ")
            SQL.ADD(" EstadoConciliacion ")
            SQL.ADD(" ) VALUES ( ")
            SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ai:&i)~"', ")
            SQL.ADD(" '"~val(ab:&i)~"', '"~val(z:&i)~"', ")
            If Val(ta:1)=2 o Val(ta:1)=1
              SQL.ADD(" '$', ")
            EndIf
            If Val(ta:1)=4 o Val(ta:1)=3
              SQL.ADD(" 'U$S', ")
            EndIf
            SQL.ADD(" "~fstr(val(af:&i),1,2)~", '"~val(ae:&i)~"', ")
            SQL.ADD(" "~Idxdate2(val(ad:&i))~", 'SAL', 'OK' )  ")
            SQL.NEW
            SQL.EXEC
            message(' Movimiento nuevo OK.')            
          Else
            * --- No tiene vehiculo
            message(' La cuenta corta '~Val(cc:&i)~' no existe.')
            ACT(a:Val(x:4), Val(cc:&i))
            ACT(b:Val(x:4), Val(ab:&i))
            ACT(c:Val(x:4), 'La cuenta corta '~Val(cc:&i)~' no existe.')
            SCN(x:4,1)
            SCN(x:6,1)
           * --- Endif de Tiene vehiculo
          Endif
          * --- Endif de Fecha Correcta
        EndIf
      Else
        * -- Else de tipo de movimiento H
        If val(aj:&i) >= Dialogo.Fecha2 y val(aj:&i) <= Dialogo.Fecha3
          * --- Fecha de Acreditacion correcta
          If NoVacio(val(ao:&i))
            * --- Tiene Vehiculo
            IF Val(AJ:&i) = Dialogo.Fecha3
                ACT(TM:1, Val(AI:&i))
                ACT(EC:1, 'P')
            ELSE
                ACT(TM:1, 'INI')
                ACT(EC:1, 'FC')
            ENDIF
            SCN(nm:1,1)
            SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
            SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
            SQL.ADD(" Banco, Sucursal, Cuenta, ")
            SQL.ADD(" Moneda, ")
            SQL.ADD(" Importe, DC, ")
            SQL.ADD(" FechaIngreso, FechaAcreditacion, TipoMov, ")
            SQL.ADD(" Comprobante, EstadoConciliacion ")
            SQL.ADD(" ) VALUES ( ")
            SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ao:&i)~"', ")
            SQL.ADD(" '"~val(ab:&i)~"', '"~val(am:&i)~"', '"~val(z:&i)~"', ")
            If Val(ta:1)=2 o Val(ta:1)=1
              SQL.ADD(" '$', ")
            EndIf
            If Val(ta:1)=4 o Val(ta:1)=3
              SQL.ADD(" 'U$S', ")
            EndIf
            SQL.ADD(" "~fstr(val(ag:&i),1,2)~", '"~val(af:&i)~"', ")
            SQL.ADD(" "~Idxdate2(val(aj:&i))~", "~IdxDate2(val(ae:&i))~", '"~Val(TM:1)~"', ")
            SQL.ADD(" '"~val(ah:&i)~"', '"~Val(EC:1)~"' )  ")
            SQL.NEW
            SQL.EXEC
            If val(ar:&i) <> 1
              message(' El codigo de operacion no existe/no esta tipificado.')
              ACT(a:Val(x:4), Val(ai:&i))
              ACT(c:Val(x:4), 'El codigo de operacion no existe/no esta tipificado.')
              SCN(x:4,1)
            EndIf
            message(' Movimiento nuevo OK.')
          Else
            * --- No tiene vehiculo
            If val(ar:&i) <> 1
              message(' El codigo de operacion no existe/no esta tipificado.')
              ACT(a:Val(x:4), Val(ai:&i))
              ACT(c:Val(x:4), 'El codigo de operacion no existe/no esta tipificado.')
              SCN(x:4,1)
            EndIf
            message(' La cuenta corta '~Val(cc:&i)~' no existe.')
            ACT(a:Val(x:4), Val(cc:&i))
            ACT(b:Val(x:4), Val(ab:&i))
            ACT(c:Val(x:4), 'La cuenta corta '~Val(cc:&i)~' no existe.')
            SCN(x:4,1)
            SCN(x:6,1)

            * --- Si no tiene vehiculo graba el error.
            EscribirAscii(Val(aq:&i))
          EndIf
        EndIf
      EndIf 
    Proximo

    SQL.ADD(" INSERT INTO "~DBO~".DATANET ( ")
    SQL.ADD(" NrDatanet, FechaBajada, ")
    SQL.ADD(" Archivo, ")
    SQL.ADD(" FechaDesde, FechaHasta, Usuario, Estado, ")
    SQL.ADD(" EstadoAprobacion, FechaAprobacion, Supervisor ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~val(x:2)~"', '"~idxdate(Dialogo.Fecha1)~"', ")
    If Val(ta:1)=2
      SQL.ADD(" 'DNCTAS', ")
    EndIf
    If Val(ta:1)=1
      SQL.ADD(" 'DNAHMS', ")
    EndIf
    If Val(ta:1)=4
      SQL.ADD(" 'DNCCDO', ")
    EndIf
    If Val(ta:1)=3
      SQL.ADD(" 'DNCADO', ")
    EndIf
*    SQL.ADD(" '"~idxdate(Dialogo.Fecha2-VAR('DNTIEMPO'))~"', '"~idxdate(Dialogo.Fecha2)~"', ")
    SQL.ADD(" '"~idxdate(Dialogo.Fecha3)~"', '"~idxdate(Dialogo.Fecha2)~"', ")
    SQL.ADD(" '"~UsuarioActivo~"', 'A', 'OK', "~IdxDate2(fsys)~", 'Captura' ) ")
    SQL.NEW
    SQL.EXEC
  EndIf

  *Cierro Archivo de Errores
  CerrarAscii
  message('Cerrando archivo de errrores '~val(bl:1))
  * ----------------------------------------------------------------------------------- *


  If val(x:4) > 4
    * X4 es la marca de errores (Cuenta o Codigos de Operacion). Si hubo errores graba XLS
    * X4 esta inicializada en 4 que es donde estan los titulos.
    message('Generando planilla de errrores '~val(bl:3))
    ExportarXls(a:1..c:val(x:4), a:1..c:val(x:4), val(bl:3))
  Endif

  If val(x:6) = 0
    * X6 es la marca de que no hay cuenta
    BorrarArchivo(val(bl:1))
    message('No hubo errores. Borrando archivo '~val(bl:1))
  EndIf

  * --- Graba el archivo en Procesados
  message('Pasando archivo: '~Dialogo.String~'a la carpeta de Procesados.')  
  AbrirAscii(val(bl:2),0)
  Recorrer&i 1,val(x:5)
     EscribirAscii(val(aq:&i))
  Proximo
  CerrarAscii
  * ---------------------------------- *

  * --- Borra el archivo procesado
  If Dialogo.Radio1=0
*     message('Pasando archivo: '~Dialogo.String~'a la carpeta de Procesados.')  
*     WinExec("COMMAND.COM /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(bl:2),0)
*     Esperar(5)

     message('Borrando archivo procesado : '~Dialogo.String)    
     WinExec("COMMAND.COM /C del "~Dialogo.String,0)
     Esperar(5)
  Else
*     message('Pasando archivo: '~Dialogo.String~'a la carpeta de Procesados.')  
*     WinExec("CMD.EXE /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(bl:2),0)
*     Esperar(5)

     message('Borrando archivo procesado : '~Dialogo.String)
     WinExec("CMD.EXE /C del "~Dialogo.String,0)
     Esperar(5)
  EndIf
  * ------------------------------------ *
Else
  Message('El archivo '~Dialogo.String~' aun no se ha generado.') 
  Cancelar
EndIf


ACT(a:Val(x:4)+1, 'Fin')
SetFont(a:Val(x:4)+1, 1)

ACO(1, 7)
ACO(2, 7)
ACO(3, 17)
ACO(5, 10)
ACO(6, 5)
ACO(7, 7)
ACO(9, 10)
ACO(11, 10)

ACT(fe:1,Fecha(Dialogo.Fecha1))
*GrabarPMG(Val(fe:1), 'APBD3|Saldos/Mov|'~Hora(AHORA) )
LimitesVision(K:Val(x:4)+2)