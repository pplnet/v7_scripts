Sqladd("Select OB.Nrbit, O.* from "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" where NrOrden     = '"~dialogo.nrorden1~"' ")
Sqladd("   and NrOrden     = OB.NrOperacion ")
Sqladd("   and Valor       = '1' ")
Sqladd("   and FechaOrden >= "~IdxDate2(Habiles(FSys(), -Var('FVALORORD')))~" ")
Sqladd("   and TipoOrden Like 'OTI%' ")
Sqladd("   and NrOrden in (Select NrOperacion from OPERACIONESBITS where NrOperacion = NrOrden and Valor = '1'  and NrBit in (9,11)) ")
Watch(Sqlbatch())
Acn(xy1, 0)
recorrer sql

Act(t:1, Fbn('NrOperacion2'))
