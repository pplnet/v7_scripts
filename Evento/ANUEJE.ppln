if (Val(xy2) = 1)
Cancelar('La orden no puede anularse porque la operación '~Val(c:1)~' asociada a la orden seleccionada se encuentra liquidada')
endif
Dfa()
Sqladd("Select * from "~Dbo()~".EJECUCIONES E")
Sqladd(" where NrOrden     = '"~Fbn('NrOrden')~"' ")
Sqladd("   and fecha2 is null")
if (dialogo.entero3 <> 0)
Sqladd("   and NrSecuencia = "~dialogo.entero3~" ")
else
if (dialogo.entero2 > 0)
Sqladd("   and Cantidad Between "~dialogo.entero1~" and "~dialogo.entero2~" ")
endif
endif
Sqladd(" Order By NrEjecucion ")
Watch(Sqlbatch())
recorrer sql
Acn(x:fac, 0)
Act(a:fac, Fbn('NrOrden'))
Act(b:fac, Fbn('NrEjecucion'))
Act(c:fac, Fecha(Fbn('Fecha')))
Act(d:fac, Hora(Fbn('Fecha')))
Act(e:fac, Fbn('NrSecuencia'))
Acn(f:fac, Fbn('Cantidad'))
Acn(g:fac, Fbn('Precio'))
Acn(h:fac, Fbn('Cantidad2'))
Acn(a:0, Fac())
proximo
Act(t:2, Fbn('NrOrden'))
