endif

if (ok)
Acn(x1, 0)

sql.add("Select * from "~Dbo()~".CUOTAS ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")


recorrer sql
Acn(x1, 1)

Acn(z3, 0)
Acn(z4, 0)

if (dialogo.precio2 - dialogo.precio3) >= 0 y (dialogo.radio2 = 1 o dialogo.precio2 <= dialogo.precio4)
Acn(z4, (dialogo.precio2 - dialogo.precio3))
endif

if (dialogo.precio6 - dialogo.precio5) >= 0 y (dialogo.radio2 = 0 o dialogo.precio5 >= dialogo.precio4)
Acn(z3, (dialogo.precio6 - dialogo.precio5))
endif

if (dialogo.radio2 = 0)
Acn(z3, -Val(z3))
else
Acn(z4, -Val(z4))
endif

Acn(z2, ((Val(z3) * dialogo.entero4) + (Val(z4) * dialogo.entero2)) * Fbn()['Cantidad1'])

if (Val(z3) = 0)
Acn(a1, Messagebox('Con estos Valores el Resultado del Put ser# 0 ...', 2, 1))
endif

if (Val(z4) = 0)
Acn(a2, Messagebox('Con estos Valores el Resultado del Call ser# 0 ...', 2, 1))
endif

if (Val(a1) <> 2 y Val(a2) <> 2)
Message('Actualizando la Opcion  .... ')

sql.add("Update "~Dbo()~".CUOTAS ")
sql.add("Set ")
sql.add("Precio1   = "~FStr(dialogo.precio5, 0, 8)~", ")
sql.add("Precio2   = "~FStr(Val(z3), 0, 8)~", ")
sql.add("Cantidad2 = "~FStr(dialogo.entero4, 3, 0)~", ")
sql.add("Precio3   = "~FStr(dialogo.precio2, 0, 8)~", ")
sql.add("Precio4   = "~FStr(Val(z4), 0, 8)~", ")
sql.add("Cantidad3 = "~FStr(dialogo.entero2, 3, 0)~", ")
sql.add("Total1    = "~FStr(Val(z2), 0, 8)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
sql.new
sql.exec


sql.actualizarmovimientos(dialogo.nroperacion1, SI)
sql.exec


Message('Modificando Instancias Operacion '~Val(az3)~' ...')


