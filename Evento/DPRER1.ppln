precio2:"Fl_Pr_Call";;;;;;;;;;;;;"###,###,###.########"
entero2:"Doas_Call";;;;;;dialogo.entero2 + dialogo.entero4 <= dialogo.entero3;'La Cant. de Doas de Resultado Incorrecto';NO;
