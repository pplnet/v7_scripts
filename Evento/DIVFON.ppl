*-- Calcula Resultados por pago de Dividendos de Fondos en CuotasPartes
CrearDialogo
  Radio2:       'Por|Oper.|Fecha';1;1;;  ;  ;;;;0
  NrOperacion1: 'Nr.Operacion:'  ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 o [NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'FCS|DIVIDE') y BuscarCampo('OPERACIONES','CB7','NrOperacion',Dialogo.NrOperacion1)=1];'Debe ingresar una Operacion Tipo FCS por pago de Dividendos o DIVIDE por FCI';NO;
  Radio1:       'Por|Alta|Baja'  ;2;2;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0
  Fecha1:       'Fecha'          ;2;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Radio2=0 o [Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys];'Debe ingresar una Fecha Valida';NO;FSys;
  Check1:       'Procesa'        ;3;1;;SI;SI;;;;1
FinDialogo
If Not OK
  Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)
ACT(a:FAC, 'NrOperacion')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'FechaVto')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Especie')
ACT(i:FAC, 'Cupon')
ACT(j:FAC, 'ContraEspecie')
ACT(k:FAC, 'Cant.CPartes')
ACT(l:FAC, 'Precio')
ACT(m:FAC, 'Efectivo')
ACT(n:FAC, 'CB7')
ACT(p:FAC, 'Monto ARP')
ACT(q:FAC, 'Monto USD')

SetFont(a:FAC..z:FAC,2)

if Dialogo.Radio2=0
  * Por Operacion
  if Dialogo.Radio1=0
    SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
  else
    SQL.ADD(" Select * from "~DBO~".BOPERACIONES ")
  endif
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.ADD(" Order By NrOperacion")
  Recorrer SQL
    if Not Incluido(fbn('TipoOp'),'FCS|DIVIDE')
      Cancelar('Error Evento DIVFON. TipoOp incorrecto')
    endif
    if fbn('CB7')=0
      if EqStr(fbn('TipoOp'),'FCS')
        Cancelar('Error Evento DIVFON. Op FCS incorrecta')
      else
        Cancelar('Error Evento DIVFON. Op DIVIDE incorrecta')
      endif
    endif
    ACT(a:FAC, fbn('NrOperacion'))
    ACT(b:FAC, fbn('TipoOp'))
    ACD(c:FAC, fbn('FechaOp'))
    ACD(d:FAC, fbn('FechaVto'))
    ACT(e:FAC, fbn('Cliente1'))
    ACT(f:FAC, fbn('Vehiculo1'))
    ACT(g:FAC, fbn('Book1'))
    ACT(h:FAC, fbn('Especie'))
    ACT(i:FAC, fbn('Cupon1'))
    ACT(j:FAC, fbn('ContraEspecie'))
    ACN(k:FAC, fbn('Cantidad'))
    ACN(l:FAC, fbn('Precio1'))
    ACN(m:FAC, fbn('TotalNetoCli1'))
    ACN(n:FAC, fbn('CB7'))
    ACT(o:FAC, 'Orignal')
    if EqStr(fbn('TipoOp'),'FCS')
      ACT(r:FAC, 'DIVFON')
    else
      ACT(r:FAC, 'DIVFON')
    endif

    * Por Operacion busco otras operaciones de la misma fecha
    SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
    SQL.ADD(" Where NrOperacion <> '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and TipoOp    = '"~fbn('TipoOp')~"' ")
    SQL.ADD("   and FechaOp   = "~IdxDate2(fbn('FechaOp'))~" ")
    SQL.ADD("   and Vehiculo1 = '"~fbn('Vehiculo1')~"' ")
    SQL.ADD("   and Book1     = '"~fbn('Book1')~"' ")
    SQL.ADD("   and Especie   = '"~fbn('Especie')~"' ")
    SQL.ADD("   and CB7       = '"~fbn('CB7')~"' ")
    SQL.ADD(" Order By NrOperacion")
    Recorrer SQL
      ACT(a:FAC, fbn('NrOperacion'))
      ACT(b:FAC, fbn('TipoOp'))
      ACD(c:FAC, fbn('FechaOp'))
      ACD(d:FAC, fbn('FechaVto'))
      ACT(e:FAC, fbn('Cliente1'))
      ACT(f:FAC, fbn('Vehiculo1'))
      ACT(g:FAC, fbn('Book1'))
      ACT(h:FAC, fbn('Especie'))
      ACT(i:FAC, fbn('Cupon1'))
      ACT(j:FAC, fbn('ContraEspecie'))
      ACN(k:FAC, fbn('Cantidad'))
      ACN(l:FAC, fbn('Precio1'))
      ACN(m:FAC, fbn('TotalNetoCli1'))
      ACN(n:FAC, fbn('CB7'))
      ACT(o:FAC, 'Hermana')
    proximo
  proximo

  if FAC>1
    ACN(az:4, 0)
    ACN(az:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
    if Val(az:4)=0
      ACN(az:5, 1)
    else
      ACN(az:5, VAR('MESINIEJE'))
    endif
    if Val(az:5)<1 or Val(az:5)>12
      ACN(az:5, 1)
    endif
    if Mes(Val(c:2))>=Val(az:5)
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2)),4,0))
    else
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2))-1,4,0))
    endif
    ACD(az:7, Fecha(Val(az:6)))

    recorrer&i 2,FAC
      if Dialogo.Radio1=1 y &i=2
        ACN(p:&i, 0)
        ACN(q:&i, 0)
      else
        ACN(p:&i, Val(m:&i)*CotizacionC(Val(j:&i),,,,Val(c:&i),1,SI,'ARP'))
        ACN(q:&i, Val(m:&i)*CotizacionC(Val(j:&i),,,,Val(c:&i),1,SI,'USD'))
      endif
    proximo

    SetFont(a:2..z:FAC,1)
    FormatoCeldas(k:2..q:FAC, Exe('F2'))
    FormatoCeldas(l:2..l:FAC, Exe('F8'))
    FormatoCeldas(n:2..n:FAC, Exe('F0'))

    ACT(o:FAC+2, 'Day')
    ACN(p:FAC+2, Sum(p:2..p:FAC))
    ACN(q:FAC+2, Sum(q:2..q:FAC))

    ACT(aa:1, 'Exp. En')
    ACT(aa:2, 'ARP')
    ACT(aa:3, 'USD')
    ACT(ab:1, 'Day')
    ACT(ac:1, 'NrSaldo')
    ACT(ad:1, 'Cant.Reg')
    ACT(ae:1, 'Fecha Res')
    ACT(af:1, 'LastDay')
    ACT(ag:1, 'MTD')
    ACT(ah:1, 'YTD')

    ACN(ab:2, Val(p:FAC+2))
    ACN(ac:2, 121)
    ACN(ab:3, Val(q:FAC+2))
    ACN(ac:3, 131)
  
    SQL.ADD("Select * from "~DBO~".RESULTADOS R1 ")
    SQL.ADD(" where R1.TipoResultado = '"~Val(r:2)~"' ")
    SQL.ADD("   and R1.Especie  =  '"~Val(h:2)~"' ")
    SQL.ADD("   and R1.Vehiculo =  '"~Val(f:2)~"' ")
    SQL.ADD("   and R1.Book     =  '"~Val(g:2)~"' ")
    SQL.ADD("   and R1.NrSaldo  in (121,131) ")
    SQL.ADD("   and R1.Fecha    >= "~IdxDate2(Val(az:7))~" ")
    SQL.ADD("   and R1.Fecha    = (select Max(Fecha) ")
    SQL.ADD("                       from  "~DBO~".RESULTADOS R2 ")
    SQL.ADD("                       where R2.Especie       =  R1.Especie ")
    SQL.ADD("                        and  R2.Vehiculo      =  R1.Vehiculo ")
    SQL.ADD("                        and  R2.Book          =  R1.Book ")
    SQL.ADD("                        and  R2.NrSaldo       =  R1.NrSaldo ")
    SQL.ADD("                        and  R2.TipoResultado =  R1.TipoResultado ")
    SQL.ADD("                        and  R2.TipoNegocio   =  R1.TipoNegocio ")
    SQL.ADD("                        and  R2.Fecha       <= "~IdxDate2(Val(c:2))~" ) ")
    SQL.ADD(" Order By Fecha ")
    recorrer SQL
      DFA
      if fbn('NrSaldo')=121
        ACN(x1,2)
      else
        ACN(x1,3)
      endif
      SCN(ad:Val(x1), 1)
      ACD(ae:Val(x1), fbn('Fecha'))
      ACN(af:Val(x1), fbn('Day'))
      ACN(ag:Val(x1), fbn('MTD'))
      ACN(ah:Val(x1), fbn('YTD'))
    proximo

    recorrer&i 2,3

      if Val(ad:&i)=0
        * No existe registro para el ejercicio
        ACT(ai:&i, 'Nuevo')
      else
        if Mes(Val(c:2))=Mes(Val(ae:&i))
          * Mismo Mes
          if Dia(Val(c:2))=Dia(Val(ae:&i))
            * Mismo Dia
            ACT(ai:&i, 'Mismo Dia/Mes')
          else
            * Distinto Dia
            ACT(ai:&i, 'Mismo Mes/Distinto Dia')
          endif
        else
          * Distinto Mes
          ACT(ai:&i, 'Distinto Mes')
        endif
      endif

      if Dialogo.Check1=1
        ACT(aj:&i, 'Procesa')
        SQL.ADD("EXEC "~DBO~".ActualizaResultados ")
        * Maxfecha
        SQL.ADD(" '"~IdxDate(Val(ae:&i))~"',")
        * Fecha
        SQL.ADD(" '"~IdxDate(Val(c:2))~"',")
        * Cliente
        SQL.ADD(" '"~Val(f:2)~"', ")
        * Vehiculo
        SQL.ADD(" '"~Val(f:2)~"', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * NrSaldo
        SQL.ADD(" "~FStr(Val(ac:&i),0,0)~", ")
        * Especie
        SQL.ADD(" '"~Val(h:2)~"', ")
        SQL.ADD(" Null, ")
        SQL.ADD(" Null, ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * Book
        SQL.ADD(" '"~Val(g:2)~"', ")
        SQL.ADD(" '', ")
        SQL.ADD(" 'FC', ")
        SQL.ADD(" '"~Val(r:2)~"', ")
        SQL.ADD(" "~FStr(Val(ab:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(ag:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(ah:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(af:&i),0,2)~" ")
        SQL.NEW
        SQL.EXEC
      endif

    proximo

    SetFont(o:FAC+2..q:FAC+6,2)
    FormatoCeldas(p:FAC+2..q:FAC+6, Exe('F2'))

  endif
endif

if Dialogo.Radio2=1
  * Por Fecha
  SQL.ADD(" Select NrOperacion from "~DBO~".OPERACIONES ")
  SQL.ADD("  where FechaOp = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("    and TipoOp  = 'FCS' ")
  SQL.ADD("    and CB7     = '1' ")
  SQL.ADD(" Order By NrOperacion")
  Recorrer SQL
    ACT(a:FAC, fbn('NrOperacion'))
    EjecutarEvento('DIVFON',Radio2=0,NrOperacion1=fbn('NrOperacion'),Radio1=0,Fecha1=Dialogo.Fecha1,Check1=Dialogo.Check1)
  proximo
endif
