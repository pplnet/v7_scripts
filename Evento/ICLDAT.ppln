HojaVisible(NO)
modoreproceso(sindialogo)
MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';;;;NO;;;;;;FSys()
string1:'Path';;;;;;;;;Var('PATHICL')
string3:'Spread';;;;;;;;;'SPREAD.XLS'
string2:'Tasas';;;;;;;;;'TASAS.XLS'
findialogo

if (not ok)
Cancelar()
endif


if (not existedirectorio(Var('PATHICL')))
Cancelar('Debe Crear el Directorio '~Var('PATHICL'))
endif

CrearFont(1, "Arial,10,B")
CrearFont(2, "Arial,8,")
CrearFont(3, "Arial,8,B")

importarxls(a:2..b:200, a:1..b:200, dialogo.string1~dialogo.string2)

if (Vacio(Val(a2)))
Cancelar('No se ha podido recuperar el archivo Tasas')
endif

SetFilaActual(1)

Acn(zx1, 0)
recorrer&i 2, 200


Act(c:&i, Query(" Select Codigo From "~Dbo()~".TIPOSTASA Where CodigoExterno = '"~Val(a:&i)~"' AND EspecieValida = '"~Val(b:1)~"'  "))

if (Vacio(Val(a:&i)))
break
endif
Scn(zx3, 1)
Acn(d:&i, Num(Val(b:&i)))
if (NOVacio(Val(c:&i)) y Val(d:&i) <> 0)
Scn(zx1, 1)
if (Query("SELECT 1 FROM "~Dbo()~".TASASDIA WHERE TipoTasa='"~Val(c:&i)~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' and Especie= '"~Val(b:1)~"' and PlazoDesde=1 and PlazoHasta=999999") = 0)
Message('Insertando Tasa ICL'~Val(c:&i))
Sqladd(" Insert "~Dbo()~".TASASDIA ")
Sqladd(" (Fecha, Especie, TipoTasa, ")
Sqladd(" PlazoDesde, PlazoHasta, Valor1, ")
Sqladd(" Valor2, Valor3, Valor4, ")
Sqladd(" Valor5) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Val(b:1)~"', '"~Val(c:&i)~"', ")
Sqladd(" 1, 999999, "~FStr(Val(d:&i), 0, 8)~", ")
Sqladd(" "~FStr(0, 0, 8)~", "~FStr(0, 0, 8)~", "~FStr(0, 0, 8)~", ")
Sqladd(" "~FStr(0, 0, 8)~" ) ")
Sqlnew()
else
Message('Actualizando Tasa ICL'~Val(c:&i))
Sqladd(" Update "~Dbo()~".TASASDIA ")
Sqladd(" Set Valor1 = "~FStr(Val(d:&i), 0, 8)~", ")
Sqladd(" Valor2 = "~FStr(0, 0, 8)~", ")
Sqladd(" Valor3 = "~FStr(0, 0, 8)~", ")
Sqladd(" Valor4 = "~FStr(0, 0, 8)~", ")
Sqladd(" Valor5 = "~FStr(0, 0, 8)~" ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Especie = '"~Val(b:1)~"' ")
Sqladd(" AND TipoTasa = '"~Val(c:&i)~"' ")
Sqladd(" AND PlazoDesde = 1 ")
Sqladd(" AND PlazoHasta = 999999 ")
Sqlnew()
endif
Sqlexec()
else
if (Val(d:&i) = 0)
Message('Sin valor de Tasa para '~Val(a:&i)~' '~Val(b:1)~' '~Val(b:&i))
else
Message('No Existe '~Val(a:&i)~' '~Val(b:1)~' '~Val(b:&i))
endif
endif
proximo


Acn(zx3, 0)

importarxls(a:2..h:501, k:1..r:500, dialogo.string1~dialogo.string3)

if (Vacio(Val(k1)))
Cancelar('No se ha podido recuperar el archivo Spread')
endif

SetFilaActual(1)

Acn(zx2, 0)

recorrer&i 1, 500

Act(j:&i, Query(" Select Codigo From "~Dbo()~".ESPECIES Where CodigoExterno = '"~Val(m:&i)~"' AND MonedaEmision = '"~Val(k:&i)~"'  and Tenor = '"~Val(l:&i)~"' "))
if (Vacio(Val(k:&i)))
break
endif
Scn(zx3, 1)

Acn(s:&i, Num(Val(p:&i)))
if (NOVacio(Val(j:&i)) y Val(s:&i) <> 0)

Message('Actualizando Spread: '~Val(j:&i))

if (Query("SELECT 1 FROM "~Dbo()~".COTIZACIONES WHERE Codigo='"~Val(j:&i)~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(dialogo.fecha1)~"' and Moneda = '"~Val(k:&i)~"' ") = 1)
Sqladd("UPDATE "~Dbo()~".COTIZACIONES SET ")
Sqladd("Precio1="~FStr(Val(s:&i) / 100, 1, 8)~" ")
Sqladd("WHERE  Codigo='"~Val(j:&i)~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT INTO "~Dbo()~".COTIZACIONES ")
Sqladd("(Fecha, Codigo, CallPut, Precio1, Moneda) ")
Sqladd(" VALUES ('"~IdxDate(dialogo.fecha1)~"', '"~Val(j:&i)~"', 'CON', ")
Sqladd(" "~FStr(Val(s:&i) / 100, 0, 8)~", '"~Val(k:&i)~"' )")
Sqlnew()
Sqlexec()
endif
Scn(zx2, 1)
else
if (Val(s:&i) = 0)
Message('Sin valor de Spread para '~Val(k:&i)~' '~Val(l:&i)~' '~Val(m:&i))
else
Message('No Existe '~Val(k:&i)~' '~Val(l:&i)~' '~Val(m:&i))
endif
endif


proximo
