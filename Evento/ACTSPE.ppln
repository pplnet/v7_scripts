creardialogo
nroperacion1: 'Nr.Operacion';
entero1:'Cuota';
cantidad1:'Especie';
radio1:'|Alta|Baja';
check1:'Procesa';
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(a:1, 'Nr Operacion')
Act(a:2, 'Nr Cuota')
Act(a:3, 'Tipo')
Act(a:4, 'Saldo Actual')
Act(a:5, 'Saldo Orig.')
Act(a:6, 'Imp. Afectado')
Act(a:7, 'Saldo Nuevo')
Act(a:8, 'Vuelve Total')
Act(a:9, 'Resultado')
Act(a:10, 'Accion')

Act(b:1, dialogo.nroperacion1)
Acn(b:2, dialogo.entero1)
Act(b:3, iif (dialogo.radio1 = 0, 'Alta', 'Baja'))
Acn(b:4, sql("Select Cantidad12 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 1, 0)~" "))
Acn(b:5, sql("Select Cantidad1 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 1, 0)~" "))
Acn(b:6, dialogo.cantidad1)
if (Val(b:5) <= 0)
Acn(x:1, 1)
endif
if (Val(b:6) <= 0)
Acn(x:1, 1)
endif
if (dialogo.radio1 = 0)
if (Val(b:4) <= 0)
Acn(x:1, 1)
endif
Acn(b:7, Val(b:4) - Val(b:6))
if (Val(b:7) < 0)
Acn(x:1, 1)
endif
else
Acn(b:7, Val(b:4) + Val(b:6))
if (Val(b:7) > Val(b:5))
Acn(x:1, 1)
endif
if (Val(b:7) = Val(b:5))
Act(b:8, 'SI')
endif
endif

if (Val(x:1) = 0)
Act(b:9, 'Actualiza')
if (dialogo.check1 = 1)
sql.add("Update "~Dbo()~".CUOTAS ")
sql.add("   Set Cantidad12 = "~FStr(Val(b:7), 1, 2)~", ")
if (Eqstr(Val(b:8), 'SI'))
sql.add("       Check9 = 0 ")
else
sql.add("       Check9 = 1 ")
endif
sql.add(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("   and NrCuota     = "~FStr(dialogo.entero1, 1, 0)~" ")
sql.new
sql.exec
Act(b:10, 'Exec')
endif
else
Act(b:9, 'Error')
endif

