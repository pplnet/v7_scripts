Acn(az:4, sql("Select 1 from "~Dbo()~".VARIABLES where Codigo='MESINIEJE' "))
if (Val(az:4) = 0)
Acn(az:5, 1)
else
Acn(az:5, Var('MESINIEJE'))
endif
if (Val(az:5) < 1 o Val(az:5) > 12)
Acn(az:5, 1)
endif
if (Mes(Val(c:2)) >= Val(az:5))
Act(az:6, '01/'~Pad0(FStr(Val(az:5), 1, 0), 2)~'/'~FStr(Anio(Val(c:2)), 4, 0))
else
Act(az:6, '01/'~Pad0(FStr(Val(az:5), 1, 0), 2)~'/'~FStr(Anio(Val(c:2)) - 1, 4, 0))
endif
Acd(az:7, Fecha(Val(az:6)))

recorrer&i 2, Fac()
if (dialogo.radio1 = 1 y &i = 2)
Acn(aa:&i, 0)
Acn(ab:&i, 0)
else
if (Val(l:&i) = 0)
Acn(aa:&i, 0)
else
if (Eqstr(Val(m:&i), Val(r:&i)))
Acn(aa:&i, Val(n:&i))
else
Acn(aa:&i, Val(n:&i) * CotizacionC(Val(m:&i), null, null, null, Val(c:&i) - 1, 1, SI, Val(r:&i)))
Acn(ac:&i, Val(n:&i))
Acn(ad:&i, CotizacionC(Val(m:&i), null, null, null, Val(c:&i) - 1, 1, SI, Val(r:&i)))
endif
endif
if (Val(o:&i) = 0)
Acn(ab:&i, 0)
else
Acn(ab:&i, Val(p:&i) * Val(q:&i))
endif
endif
proximo

