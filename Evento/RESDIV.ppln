sql.add(" Select * from "~Dbo()~".OPERACIONES ")
sql.add(" Where NrOperacion <> '"~dialogo.nroperacion1~"' ")
sql.add("   and TipoOp      in ('DIVIDE') ")
sql.add("   and FechaOp      = "~IdxDate2(Fbn('FechaOp'))~" ")
sql.add("   and Vehiculo1    = '"~Fbn('Vehiculo1')~"' ")
sql.add("   and Book1        = '"~Fbn('Book1')~"' ")
sql.add("   and Especie      = '"~Fbn('Especie')~"' ")
sql.add("   and TipoCambio3  = "~Fbn('TipoCambio3')~" ")
