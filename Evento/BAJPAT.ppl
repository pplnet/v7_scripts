* Enviar a Baja las patas de un pase que esten en Instancia 70 (terminal)
* Lo Ejecutan los Scripts de Operaciones de Pase TIPA/TIPP desde la
* instancia 70 y como evento cuando alguna de las operaciones esta en 70 y
* la otra no y esta no se puede llevar a 70 tambien (en esos casos la operacion madre
* esta en 73 o 74)

CrearDialogo
  NrOperacion1: '# Pase :'   ;;;;;;NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIPA|TIPP');'Debe ingresar un pase.';NO;;;;;;"TipoOp in ('TIPA','TIPP') "
  String1     : 'Instancias' ;;;;;;;;;;;;
  Check1      : 'Procesa'    ;;;;SI;SI;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACN(w1,0)
ACN(w2,0)

ACT(a:1, Dialogo.NrOperacion1)
ACT(a:2, Dialogo.String1)

SetFilaActual(1)
ACT(c:FAC, 'NrOperacion')
ACT(d:FAC, 'TipoOp')
ACT(e:FAC, 'v:1')
ACT(f:FAC, 'w:1')
ACT(g:FAC, 'w:2')
ACT(h:FAC, 'NrOperacion')
ACT(i:FAC, 'TipoOp')
ACT(j:FAC, 'CB5')
ACT(k:FAC, 'CB7')
ACT(l:FAC, 'Inst valida')
SetFont(c:FAC..o:FAC, 2)

Message('----- Enviando Baja Op '~Dialogo.NrOperacion1)
SQL.ADD("Select NrOperacion,TipoOp from "~DBO~".OPERACIONES ")
SQL.ADD(" Where OperacionRef = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("   and PaseCB = '1' ")
SQL.ADD(" order by NrOperacion ")
Recorrer SQL
  ACT(c:FAC, fbn('NrOperacion'))
  ACT(d:FAC, fbn('TipoOp'))
** FJL 31/03/20 - Por ahora solo permito anular pases si sus patas estan en Compliance (69) / Liqudiacion (10) / Terminal (70)
  *  ACT(v1, SQL("Select DISTINCT Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~FBN['NrOperacion']~"' and NrBit IN (70,80,10,7) AND Valor = '1' "))
  ACT(v:1, SQL("Select DISTINCT Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~FBN['NrOperacion']~"' and NrBit IN (69,70,10) AND Valor = '1' "))
  ACT(e:FAC, Val(v:1))
  If EqStr(Val(v:1),'1')
    ACN(v:2, SQL("SELECT COUNT(1) FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~FBN['NrOperacion']~"' AND NrSaldo <> 9 "))
    IF Val(v:2) = 0
      ** No tiene movs ejecutados
      IF Val(w:1) = 0
        ACN(w:1, 1)
      ELSE
        IF Val(w1) = 1 y Val(w2) = 0
          ACN(w:2, 1)
        ENDIF
      ENDIF
    ENDIF
    ACT(l:FAC, 'SI')
  else
    * La pata no esta en alguna de las Instancias validas
    ACT(a:3 ,'NO')
    ACT(l:FAC, 'NO')
  ENDIF
  ACN(f:FAC, Val(w:1))
  ACN(g:FAC, Val(w:2))
Proximo

IF Val(w1) = 1 y Val(w2) = 1
  ** Ninguma pata tiene movimientos ejecutados
  SetFilaActual(1)
  SQL.ADD("Select * from "~DBO~".OPERACIONES ")
  SQL.ADD(" Where OperacionRef = '"~Dialogo.NrOperacion1~"' ")
  SQL.ADD("   and PaseCB = '1' ")
  SQL.ADD(" order by NrOperacion ")
  Recorrer SQL
    ACT(h:FAC, fbn('NrOperacion'))
    ACT(i:FAC, fbn('TipoOp'))
    ACN(j:FAC, fbn('CB5'))
    ACN(k:FAC, fbn('CB7'))
      if Dialogo.Check1=1
        Message('----- Enviando Baja Op '~FBN['TipoOp']~' '~FBN['NrOperacion'])
        SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
        SQL.ADD(" SET Direccion = 1, ")
        SQL.ADD("     Rojo = 1, ")
        SQL.ADD("     RB7  = 1 ")
        SQL.ADD(" Where NrOperacion= '"~FBN['NrOperacion']~"' ")
        SQL.NEW
      else
        MessageBox('----- Enviando Baja Op '~FBN['TipoOp']~' '~FBN['NrOperacion'])
      endif
      if Eqstr(fbn('CB7'),'1') 
        * Es NO MAE
        * Va a anulacion Manual
        if Dialogo.Check1=1
          SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD("   SET Valor = '1' ")
          SQL.ADD(" Where NrBit = 30 ")
          SQL.ADD("   and NrOperacion= '"~FBN['NrOperacion']~"' ")
          SQL.NEW

          SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD("   SET Valor = '0' ")
          SQL.ADD(" Where NrBit IN (70,69,10) ")
          SQL.ADD(" and NrOperacion= '"~FBN['NrOperacion']~"' ")
          SQL.NEW

          SQL.EXEC
** FJL 12/03/20 - Saco esta llamada porque es de SBK
*          EjecutarEvento('ANULO',NrOperacion1=FBN['NrOperacion'])
        else
          MessageBox('----- Operacion No Mercado. Activo Inst 30')
        endif
      else
        * Es MAE
        if Dialogo.Check1=1
          * INST. INFORMAR AL MAE
          SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD("   SET Valor = '1' ")
          SQL.ADD(" Where NrBit = 60 ")
          SQL.ADD("   and NrOperacion= '"~FBN['NrOperacion']~"' ")
          SQL.NEW
          SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD("   SET Valor = '0' ")
          SQL.ADD(" Where NrBit IN (70,69,10) ")
          SQL.ADD(" and NrOperacion= '"~FBN['NrOperacion']~"' ")
          SQL.NEW

          * Actualizo NroBajaMAE de la cabecera
          ACT(x1, Pad(BuscarCampo('OPERACIONES','NroBajaMAE','NrOperacion',FBN['OperacionRef']),8))
          if Incluido(FBN['TipoOp'],'TIC|TIV')
            ACT(x2, 'AEN '~Copy(Val(x1),5,4))
            SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
            SQL.ADD("   SET NroBajaMAE = '"~Val(x2)~"' ")
            SQL.ADD(" Where NrOperacion= '"~FBN['OperacionRef']~"' ")
            SQL.NEW
          else
            ACT(x2, Copy(Val(x1),1,4)~'AEN ')
            SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
            SQL.ADD("   SET NroBajaMAE = '"~Val(x2)~"' ")
            SQL.ADD(" Where NrOperacion= '"~FBN['OperacionRef']~"' ")
            SQL.NEW
          endif
          SQL.EXEC
        else
          MessageBox('----- Operacion Mercado. Activo Inst 60 y actualizo NroBajaMAE en cabecera')
        endif
      endif
  proximo
ELSE
  ** Alguna pata tiene movs ejecutados o no esta en una instancia valida
  if EqStr(Val(a:3),'NO')
    MessageBox("No se pudo anular el Pase "~Dialogo.NrOperacion1~'. Alguna de sus patas no esta en las Instacias validas.')
  else
    MessageBox("No se pudo anular el Pase "~Dialogo.NrOperacion1~'. Alguna de sus patas esta liquidada.')
  endif
  if Dialogo.Check1=1
    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   SET Valor = '0' ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   SET Valor = '1' ")
    SQL.ADD(" Where NrBit IN ("~Pipe2Comillas(Dialogo.String1)~") ")
    SQL.ADD("   and NrOperacion= '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
  else
    MessageBox('----- Apago todas y prendo la que recibi en el dialogo. ('~Dialogo.String1~')')
  endif
endif
