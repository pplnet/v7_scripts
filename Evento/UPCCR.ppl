CrearDialogo
   NrOperacion1:'Op  Renovada'
   NrOperacion2:'Op. Nueva'
   Precio1     :'Variacion de Capital'
FinDialogo

If not Ok
 Cancelar
EndIf

*- Recupero el % Impuesto de la operacion anterior
ACN(a1,SQL("Select DeltaTasa FROM "~DBO~".OPERACIONES Where NrOperacion='"~Dialogo.NrOperacion1~"' "))

Message('Modificando Operacion '~Dialogo.NrOperacion1~'  ...')

SQL.ADD("Update "~DBO~".OPERACIONES Set NrOperacion3='"~Dialogo.NrOperacion2~"', ")
SQL.ADD("IntDevengados1="~Fstr(Dialogo.Precio1*VAL(a1)/100,0,2)~" Where NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

* Actualizo la Instancia de la Operacion a Supervision
ACT(i3,Dialogo.NrOperacion1)

(.'MODIINSTAN'.)      

*** Actualiza movimientos y limites ****
SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
SQL.EXEC

