Acn(h2, 0)


Sqladd("SELECT  P.Vehiculo1,P.Vehiculo2,P.ListaEspecies FROM  "~Dbo()~".PARESVEHICULO P ")
Sqladd("Where Estado='HAB' ")
Sqladd("Order By P.Vehiculo1,P.Vehiculo2")

recorrer sql

Dfa()
Message('Pares de Vehiculos: '~Fbn()['Vehiculo1']~'/'~Fbn()['Vehiculo2']~'  ...')

Act(av1, Fbn()['Vehiculo1'])
Act(av2, Fbn()['Vehiculo2'])

Sqladd("SELECT Codigo FROM  "~Dbo()~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Fbn()['ListaEspecies'])~") ")

recorrer sql

Acn(f:fac, Query("SELECT Tasa    from "~Dbo()~".TASASVEHICULO where ((Vehiculo1='"~Val(av1)~"' and Vehiculo2='"~Val(av2)~"') or (Vehiculo1='"~Val(av2)~"' and Vehiculo2='"~Val(av1)~"')) and Especie ='"~Fbn()['Codigo']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

if (Val(f:fac) = 0)
Cancelar("La Tasa '"~Val(av1)~"'/'"~Val(av2)~"'-'"~Fbn()['Codigo']~"' Es Incorrecta")
Scn(h2, 1)
endif
proximo
proximo



Acd(z10, Habiles(dialogo.fecha1, -1, 'ARG', SI))

Sqladd("SELECT DISTINCT O.Vehiculo1,O.Vehiculo2,O.Especie  ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((O.TipoOp='VIMD' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("       or (O.TipoOp='VIMIND' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("       or (O.TipoOp='VIMINM' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"')) ")
Sqladd(" and CB6='1' ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT * ")
Sqladd("from "~Dbo()~".OPERACIONES Op")
Sqladd("where Op.TipoOp='VIMIND' and Op.FechaOp='"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd("      and Op.Vehiculo1=O.Vehiculo1 and Op.Vehiculo2=O.Vehiculo2  and Op.Especie=O.Especie) ")
Sqladd("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

Acn(ab1, 0)

recorrer sql
Message('Procesando Vehiculo: '~Fbn()['Vehiculo1']~' Veh. ContraParte '~Fbn()['Vehiculo2']~' Especie:'~Fbn()['Especie']~' ...')

Act(av1, Fbn()['Vehiculo1'])
Act(av2, Fbn()['Vehiculo2'])
Act(ae1, Fbn()['Especie'])
Acd(af1, dialogo.fecha1)

Sqladd("SELECT O.* ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((TipoOp='VIMD' and FechaOp='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='VIMIND' and FechaVto='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='VIMINM' and FechaVto='"~IdxDate(Val(af1))~"')) ")
Sqladd(" and O.Especie='"~Val(ae1)~"' ")
Sqladd(" and ((O.Vehiculo1='"~Val(av1)~"' and O.Vehiculo2='"~Val(av2)~"') or (O.Vehiculo1='"~Val(av2)~"' and O.Vehiculo2='"~Val(av1)~"')) ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT TipoOp ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where TipoOp='VIMIND' and FechaOp='"~IdxDate(Val(af1))~"' ")
Sqladd(" and O.Especie ='"~Val(ae1)~"' ")
Sqladd(" and ((O.Vehiculo1='"~Val(av1)~"' and O.Vehiculo2='"~Val(av2)~"') or (O.Vehiculo1='"~Val(av2)~"' and O.Vehiculo2='"~Val(av1)~"'))) ")
Sqladd(" Order By O.FechaOp,O.NrOperacion ")

recorrer sql

Dfa()
Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~Fbn()['NrOperacion']~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar("La Operacion '"~Fbn()['NrOperacion']~"' Debe estar en BackOffice o Terminal. Instancia Actual="~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif
proximo




Acn(a1, Query("SELECT Tasa from "~Dbo()~".TASASVEHICULO where ((Vehiculo1='"~Fbn()['Vehiculo1']~"' and Vehiculo2='"~Fbn()['Vehiculo2']~"') or (Vehiculo1='"~Fbn()['Vehiculo2']~"' and Vehiculo2='"~Fbn()['Vehiculo1']~"')) and Especie ='"~Fbn()['Especie']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

if (Val(a1) <> 0)
Ejecutarevento('VIMIND', 'fecha1', dialogo.fecha1, 'vehiculo1', Fbn()['Vehiculo1'], 'vehiculo2', Fbn()['Vehiculo2'], 'especie1', Fbn()['Especie'], 'precio1', Val(a1))
else
Cancelar(' Falta cargar la Tasa Diaria para '~Fbn()['Vehiculo1']~'/'~Fbn()['Vehiculo2']~' '~Fbn()['Especie']~' ....')
endif

