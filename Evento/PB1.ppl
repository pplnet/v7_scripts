MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'H.FechaPago'  ;1;1;;;;Dialogo.Fecha1<>0;'Fecha de Pago Invalida';NO;Fsys;
  Vehiculo1: 'Vehiculo'     ;1;2;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Cuenta1  : 'Cuenta'       ;2;1;;;;Vacio(Dialogo.Cuenta1) o Incluido(Dialogo.Cuenta1, SQLSet(" Select Cuenta From "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo = '"~Dialogo.Vehiculo1~"' "));'Cuenta Invalida';NO;;;;;;" Codigo IN (Select DISTINCT Cuenta From "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo = '"~Dialogo.Vehiculo1~"' ) "
  Chequera1: 'Nr.Chequera'  ;3;1;;;;Vacio(Dialogo.Cuenta1) o Incluido(Dialogo.Chequera1, SQLSet(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta = '"~Dialogo.Cuenta1~"' AND Estado = 'HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ")) ;'Numero de Chequera Invalida';NO;SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ");SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo='"~Dialogo.Vehiculo1~"' ");;;;" Cuenta = '"~Dialogo.Cuenta1~"' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ";
  Entero1  : 'Nr.Cheque'    ;4;1;;;;;;;;;;;'###############';
FinDialogo

IF Not Ok
  Cancelar
ENDIF

ACN(X:1, 0)
ACN(BD:3, 0)
ACN(BD:5, 5)
ACN(FI:1, fac+1)

SQL.ADD(" Select /*+ RULE */ C.Chequera, F.Cliente1, F.Cuenta2 Cuenta1, '' as Proveedor, C.FechaEmision, ")
SQL.ADD(" C.NrCheque, C.NrComprobante, C.Monto, C.Observaciones, C.Estado, F.CNFormaPago, ")
SQL.ADD(" F.Cliente2, '', 1 as BD1, M.FechaMov, C.FechaPago ")
SQL.ADD(" From "~DBO~".CHEQUES C, "~DBO~".TRANSACCIONES2 F,  "~DBO~".MOVPENDIENTES M ")
*, "~DBO~".OPERACIONESBITS B, ")
SQL.ADD(" Where C.NrComprobante = F.NrTrans ")
SQL.ADD(" AND   M.NrOperacion = C.NrComprobante ")
*SQL.ADD(" AND   B.NrOperacion = F.NrTrans ")
SQL.ADD(" AND   M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   M.NrGrupo     = TO_NUMBER(C.Chequera) ")
SQL.ADD(" AND   M.NrComprob   = C.NrCheque ")
*SQL.ADD(" AND   B.NrBit       = 18 ")
*SQL.ADD(" AND   B.Valor       = '1' ")
SQL.ADD(" AND   F.TipoTr2 IN ('DEVM') ")
SQL.ADD(" AND   C.Estado  IN ('ENT','ASI') ")
SQL.ADD(" AND   F.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF NoVacio(Dialogo.Cuenta1)
  SQL.ADD(" AND F.Cuenta2  = '"~Dialogo.Cuenta1~"' ")
  SQL.ADD(" AND C.Chequera = '"~Dialogo.Chequera1~"' ")
ENDIF
IF Dialogo.Entero1 > 0
  SQL.ADD(" AND C.NrCheque = "~Dialogo.Entero1~" ")
ENDIF
SQL.ADD(" Order By C.NrComprobante ")

Recorrer SQL
    ACN(BD:99, 1)
    ACN(A:fac, 0)
    ACT(B:fac, fbn('Cliente2'))
    ACT(C:fac, fbn('Cuenta1'))
    ACT(D:fac, fbn('Cliente1'))
    ACD(E:fac, fbn('FechaEmision'))
    ACN(F:fac, fbn('NrCheque'))
    ACT(G:fac, fbn('NrComprobante'))
    ACN(H:fac, fbn('Monto'))
    ACT(I:fac, fbn('Observaciones'))
    ACT(J:fac, fbn('Chequera'))
    ACD(K:fac, fbn('FechaPago'))

    ACD(Y:fac, fbn('FechaMov'))
    ACN(X:fac, fbn('BD1'))
Proximo

IF Val(BD:99) = 0
  Cancelar('No hay cheques pendientes para los parametros solicitados.')
ENDIF

CrearListBox           ; 'Arial,8,'
  'OK'                 ;A:Val(FI:1)..A:FAC;SI;;;30;CHECK;RGB(232,255,215);
  'Proveedor'          ;D:Val(FI:1)..D:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'Banco'              ;B:Val(FI:1)..B:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'Cuenta'             ;C:Val(FI:1)..C:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'Chequera'           ;J:Val(FI:1)..J:FAC;NO;;;60;STRING;;RGB(232,232,232);
  'NrCheque'           ;F:Val(FI:1)..F:FAC;NO;;;70;NUMERO;'###,###,###,###,###';RGB(232,232,232);
  'Fecha Emision'      ;E:Val(FI:1)..E:FAC;NO;;;80;FECHA;RGB(232,232,232);
  'Fecha Pago'         ;K:Val(FI:1)..K:FAC;SI;[Val(A:FLB)=0] O [Val(K:FLB)>=Val(E:FLB) y EsHabil(Val(K:FLB),'ARG')];'Fecha de pago Invalida';75;FECHA;RGB(232,255,215);
  'Transaccion'        ;G:Val(FI:1)..G:FAC;NO;;;60;STRING;;RGB(232,232,232);
  'Monto'              ;H:Val(FI:1)..H:FAC;NO;;;80;NUMERO;'###,###,###,###,###.##';RGB(232,232,232);
  'Observaciones'      ;I:Val(FI:1)..I:FAC;NO;;;140;STRING;;RGB(232,232,232);
FinListBox

IF Not Ok
  Cancelar
ENDIF

Recorrer&J VAL(FI:1), Fac

    IF Val(A:&J)=1
        IF Val(K:&j) <> Val(Y:&j)
            ***---Se modifico la fecha de pago
            ***---Guardo en Fecha2 Fecha de Pago por si se modifico
            ***---Guardo en Fecha3 Fecha de Pago original por si se anula la confirmacion

            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET Fecha3 = '"~IdxDate(Val(Y:&J))~"', ")
            SQL.ADD(" Fecha2 = '"~IdxDate(Val(K:&J))~"' ")
            SQL.ADD(" WHERE NrTrans = '"~Val(G:&J)~"' ")
            SQL.NEW
            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES ")
            SQL.ADD(" Set FechaPago = '"~IdxDate(Val(K:&J))~"' ")
            SQL.ADD(" WHERE NrComprobante = '"~Val(G:&J)~"' ")
            SQL.NEW

            ***---Actualizo Fecha de Movimientos
            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" Set FechaMov = '"~IdxDate(Val(K:&j))~"' ")
            SQL.ADD(" Where NrOperacion = '"~Val(G:&J)~"' ")
            SQL.NEW
            SQL.EXEC
        ENDIF
        IF Val(K:&J) <= Fsys
            ***---Cheque Confirmado
            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES ")
            SQL.ADD(" Set Estado = 'PAG' ")
            SQL.ADD(" Where Chequera='"~Val(J:&J)~"' ")
            SQL.ADD(" AND NrCheque="~Val(F:&J)~" ")
            SQL.NEW
            SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
            SQL.ADD(" SELECT * FROM "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(G:&J)~"' ")
            SQL.NEW
            SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(G:&J)~"' ")
            SQL.NEW

            ***---Avanzo la Transaccion a Terminal
            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS ")
            SQL.ADD(" Set Valor = '1' ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(G:&J)~"' ")
            SQL.ADD(" AND NrBit = 20 ")
            SQL.NEW
            SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS ")
            SQL.ADD(" Set Valor = '0' ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(G:&J)~"' ")
            SQL.ADD(" AND NrBit = 18 ")
            SQL.NEW
            SQL.EXEC
        ENDIF
    ENDIF
Proximo
