Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,'1' as Tipo,CASE S1.Cliente WHEN '"~dialogo.vehiculo1~"' THEN 'CPROPIA' ELSE 'TERCER' END as Propia,' ' as TipoOp,CASE C.PaisDir WHEN 80 THEN 'SI' ELSE 'NO' END as Reside,S1.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,S1.Cliente,SUM(S1.CantidadFin) Saldo,0 AS VR,' ' as Cuenta, CASE WHEN S1.NrSaldo=107 THEN 0 WHEN S1.NrSaldo=110 THEN 0 ELSE 1 END as Cartera, 0 as Interes, 0 as CtaRegul, 0 as AjusteCER ")
Sqladd("FROM (("~Dbo()~".POSICIONES S1 WITH (NOLOCK) INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = S1.Especie) ")
Sqladd("      INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  S1.Cliente=C.Codigo)  ")
Sqladd("WHERE E.Tipo='PUB' AND ")
Sqladd("      S1.Vehiculo = '"~dialogo.vehiculo1~"' AND ")
Sqladd("      (S1.NrSaldo> 106 and S1.NrSaldo<111) AND ")
Sqladd("      S1.CantidadFin <> 0 AND ")
if (NoVacio(dialogo.especie1))
Sqladd("      S1.Especie='"~dialogo.especie1~"' AND ")
endif
Sqladd("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
Sqladd("                  FROM "~Dbo()~".POSICIONES S2 WITH (NOLOCK) ")
Sqladd("                  WHERE ")
Sqladd("                        S2.Cliente = S1.Cliente                   AND ")
Sqladd("                        S2.Especie = S1.Especie                   AND ")
Sqladd("                        S2.Vehiculo = S1.Vehiculo         AND ")
Sqladd("                        S2.Sector = S1.Sector                   AND ")
Sqladd("                        S2.Fecha <= '"~IdxDate(dialogo.fecha1)~"' AND ")
Sqladd("                        S2.Cupon  = S1.Cupon                      AND ")
Sqladd("                        S2.NrSaldo = S1.NrSaldo)                      ")
Sqladd("GROUP BY ")
Sqladd(" E.Alias7,E.Codigo,S1.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,S1.Cliente,C.PaisDir,S1.NrSaldo")
Sqladd("Union ALL")
Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,'2' as Tipo,'CPROPIA' as Propia,'' as TipoOp,CASE C.PaisDir WHEN 80 THEN 'SI' ELSE 'NO' END as Reside,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,'"~dialogo.vehiculo1~"' as Cliente,SUM(O.Cantidad) Saldo,0 AS VR,' ' as Cuenta, Cartera, 0 as Interes, 0 as CtaRegul, 0 as AjusteCER ")
Sqladd("FROM (("~Dbo()~".OPERACIONES O WITH (NOLOCK)  INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON  E.Codigo = O.Especie )")
Sqladd("      INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON O.Cliente1=C.Codigo) ")
Sqladd("WHERE E.Tipo='PUB' AND ")
if (NoVacio(dialogo.especie1))
Sqladd("      O.Especie='"~dialogo.especie1~"' AND ")
endif
Sqladd("      O.Vehiculo1 = '"~dialogo.vehiculo1~"' AND O.FechaOp<='"~IdxDate(dialogo.fecha1)~"' AND O.FechaVto>'"~IdxDate(dialogo.fecha1)~"' and O.TipoOp='TIBCRA' ")
Sqladd("GROUP BY ")
Sqladd(" E.Alias7,E.Codigo,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,C.PaisDir,Cartera ")
Sqladd("Union ALL")
Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,CASE O.PaseCB WHEN '1' THEN '3' ELSE '5' END as Tipo,'CPROPIA' as Propia,O.TipoOp,CASE C.PaisDir WHEN 80 THEN 'SI' ELSE 'NO' END as Reside,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,'"~dialogo.vehiculo1~"' as Cliente,SUM(CASE O.TipoOp WHEN 'TIFC  ' THEN O.Cantidad ELSE -O.Cantidad END) Saldo,0 AS VR,' ' as Cuenta, Cartera, 0 as Interes, 0 as CtaRegul, 0 as AjusteCER ")
Sqladd("FROM (("~Dbo()~".OPERACIONES O WITH (NOLOCK) INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = O.Especie ) ")
Sqladd("      INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON O.Cliente1=C.Codigo ) ")
Sqladd("WHERE E.Tipo='PUB' AND ")
if (NoVacio(dialogo.especie1))
Sqladd("      O.Especie='"~dialogo.especie1~"' AND ")
endif
Sqladd("      O.Vehiculo1='"~dialogo.vehiculo1~"' AND O.FechaOp<='"~IdxDate(dialogo.fecha1)~"' AND O.FechaVto>'"~IdxDate(dialogo.fecha1)~"' and ")
Sqladd(" O.TipoOp IN ('TIFC','TIFV') ")
Sqladd("GROUP BY ")
Sqladd(" E.Alias7,E.Codigo,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,O.PaseCB,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,O.Cliente1,O.TipoOp,C.PaisDir,Cartera ")
Sqladd("Union ALL")
Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,'4' as Tipo,'CPROPIA' as Propia,O.TipoOp,CASE C.PaisDir WHEN 80 THEN 'SI' ELSE 'NO' END as Reside,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,'"~dialogo.vehiculo1~"' as Cliente,SUM(CASE O.TipoOp WHEN 'TIC   ' THEN O.Cantidad ELSE -O.Cantidad END) Saldo,0 AS VR,' ' as Cuenta, Cartera, 0 as Interes, 0 as CtaRegul, 0 as AjusteCER ")
Sqladd("FROM (("~Dbo()~".OPERACIONES O WITH (NOLOCK) INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = O.Especie)")
Sqladd("      INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON O.Cliente1=C.Codigo)")
Sqladd("WHERE E.Tipo='PUB' AND ")
if (NoVacio(dialogo.especie1))
Sqladd("      O.Especie='"~dialogo.especie1~"' AND ")
endif
Sqladd("      O.Vehiculo1='"~dialogo.vehiculo1~"' AND O.FechaOp<='"~IdxDate(dialogo.fecha1)~"' AND O.FechaVto>'"~IdxDate(dialogo.fecha1)~"' and ")
Sqladd(" O.TipoOp IN ('TIC','TIV') and O.FechaVto>O.FechaOp ")
Sqladd("GROUP BY ")
Sqladd(" E.Alias7,E.Codigo,E.Cupon,E.Alias1,C.SectorBCRA,C.Provincia,C.BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,O.Cliente1,O.TipoOp,C.PaisDir,Cartera")
Sqladd("Union ALL")
Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,'7' as Tipo,'CPROPIA' as Propia,O.TipoOp,'SI' as Reside,E.Cupon,E.Alias1, '' SectorBCRA, '' Provincia,'' BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,'"~dialogo.vehiculo1~"' as Cliente, O.Cantidad Saldo, 0 AS VR,' ' as Cuenta, Cartera, C.Cantidad4 Interes, C.Total2 as CtaRegul, C.Cantidad2 AjusteCER  ")
Sqladd("FROM (("~Dbo()~".OPERACIONES O WITH (NOLOCK) INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = O.Especie)")
Sqladd("       INNER JOIN "~Dbo()~".CUOTAS C WITH (NOLOCK) ON O.NrOperacion = C.NrOperacion) ")
Sqladd("WHERE ")
Sqladd(" Month(C.Fecha1)=Month(O.FechaOp) AND YEAR(C.Fecha1)=YEAR(O.FechaOp) AND ")
if (NoVacio(dialogo.especie1))
Sqladd("      O.Especie='"~dialogo.especie1~"' AND ")
endif
Sqladd(" O.Vehiculo1='"~dialogo.vehiculo1~"' AND O.FechaOp='"~IdxDate(dialogo.fecha1)~"' AND ")
Sqladd(" O.TipoOp='PGARAN' ")
Sqladd("Union ALL")
Sqladd("SELECT E.Alias7 as CodigoSiscen,E.Codigo as Especie,'6' as Tipo,'CPROPIA' as Propia,'' as TipoOp,'SI' as Reside,E.Cupon,E.Alias1, '0' as SectorBCRA,' ' as Provincia, ' ' as BancoOpera,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen as Nacionalidad, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon, '"~dialogo.vehiculo1~"'  as Cliente, SUM(T2.Cantidad1) as Saldo,SUM(T2.Cantidad2) as VR,RC.Cuenta, 0 as Cartera, 0 as Interes, 0 as CtaRegul, 0 as AjusteCER ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T2 WITH (NOLOCK) INNER JOIN "~Dbo()~".RELACIONCUENTA RC WITH (NOLOCK) ON RC.Cuenta = T2.Ley1 ")
Sqladd("      INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON E.Codigo = T2.Especie ")
Sqladd("WHERE T2.TipoTr2='AJ3920' AND ")
Sqladd("      E.Tipo='PUB' AND T2.Fecha1='"~IdxDate(dialogo.fecha1)~"'")
if (NoVacio(dialogo.especie1))
Sqladd(" AND  T2.Especie='"~dialogo.especie1~"'")
endif
Sqladd("GROUP BY ")
Sqladd(" E.Alias7,E.Codigo,E.Cupon,E.Alias1,E.Nombre, ")
Sqladd(" E.CodNumCajaValores, E.PaisOrigen, E.Issuer, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
Sqladd(" E.InteresesC,E.Cotiza,E.EsCupon,RC.Cuenta ")
Sqladd("ORDER BY 1,2,3,4,5,6,7,8,9  ")

