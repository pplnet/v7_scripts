CrearDialogo
  Fecha1:       'F.Liquid'    ;;;;;;Dialogo.Fecha1<>0;'Debe ingresar una fecha';NO;Fsys
  *  Cliente1:     'Cliente'     ;;;;;;;;;
  NrTrans1:     'Voucher'     ;;;;;;;;;
FinDialogo

If not Ok
  Cancelar
Endif

*------------------------------------------------------------------------------------*
* Impresión de cartas - Transferencias pago MAECLEAR y Credito transferencia MAE     *
*------------------------------------------------------------------------------------*

* Dirección de origen del template "Transferencia pago maeclear"
ACT(xx:1, VAR('PATHCARTA1'))
* Dirección de origen del template "Crédito transferencia MAE"
ACT(xx:3, VAR('PATHCARTA2'))
* Dirección de origen del template "Transferencia Pago ROFEX"
ACT(xx:4, VAR('PATHCARTA4'))
* Dirección de origen del template "Transferencia Cta Gtia ROFEX"
ACT(xx:5, VAR('PATHCARTA5'))

SQL.ADD(" Select T.NrTrans,T.Fecha1, T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, T.CB8, T.CB7, CO.Nombre RazonSocialCorresp, E.Nombre NomEsp, ")
SQL.ADD("        T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5, T.Precio1, T.Cliente2, T.Cuenta2, T.Vehiculo1, CO.Contacto ContactoCorresp, CU.Numero, CU.NrDepositante Comitente,   ")
SQL.ADD("        C.RazonSocial RSocialVeh, C.Cuit CuitVeh, CO.Codigo CodCorresp, T.Cuenta1 ")
SQL.ADD("   FROM  "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo  ")
SQL.ADD("         LEFT JOIN "~DBO~".CORRESPONSALES CO ON CU.Corresponsal = CO.Codigo  ")
SQL.ADD("  WHERE  T.Especie = E.Codigo   ")
** AA 02/03/2018 No en todos los Vouchers se actualiza RB6 = 1 ...... Liquicacion????
** SQL.ADD(" AND    T.RB6         = '1'           ")
** AA 01/03/18 para emitir solo ARS
SQL.ADD(" AND    T.Especie = '"~VAR('MONELOCA')~"'   ")
SQL.ADD(" AND    T.Fecha1 = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Mercado1 in("~Pipe2Comillas(VAR('MERCAACMC'))~")   ")
SQL.ADD(" AND    T.Vehiculo1 = C.Codigo  ")

** AA 05/03/2018 NO se valida Reimpresion
*If Dialogo.Check1 = 0
*    SQL.ADD(" and    T.CB1 Is Null or T.CB1 =''  ")
*    else
*    SQL.ADD(" and    T.CB1 = 1                                                           ")
*Endif
*If NoVacio(Dialogo.Cliente1)
*    SQL.ADD(" and    T.Cliente1= '"~Dialogo.Cliente1~"'                                  ")
*Endif
If NoVacio(Dialogo.NrTrans1)
    SQL.ADD(" and    T.NrTrans= '"~Dialogo.NrTrans1~"'                                   ")
Endif
SQL.ADD(" UNION ")
SQL.ADD(" Select T.NrTrans,T.Fecha1, T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, T.CB8, T.CB7, CO.Nombre RazonSocialCorresp, E.Nombre NomEsp, ")
SQL.ADD("        T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5, T.Precio1, T.Cliente2, T.Cuenta2, T.Vehiculo1, CO.Contacto ContactoCorresp, CU.Numero, CU.Comitente,   ")
SQL.ADD("        C.RazonSocial RSocialVeh, C.Cuit CuitVeh, CO.Codigo CodCorresp, T.Cuenta1 ")
SQL.ADD("   FROM  "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo  ")
SQL.ADD("         LEFT JOIN "~DBO~".CORRESPONSALES CO ON CU.Corresponsal = CO.Codigo  ")
*SQL.ADD("         LEFT JOIN "~DBO~".CORRESPONSALES CO ON CU.Comitente = CO.Codigo  ")
SQL.ADD("  WHERE  T.Especie    = E.Codigo   ")
SQL.ADD("  AND    T.TipoTr2    = 'TRNOP'                             ")
SQL.ADD("  AND    T.CB5        = '1'                                 ")
SQL.ADD("  AND    T.CB6        = '1'                                 ")
SQL.ADD("  AND    T.Cliente1   = '"~VAR('VEHICULODE')~"'             ")
SQL.ADD("  AND    T.Mercado1   in ("~Pipe2Comillas(VAR('MERROFEX'))~") ")
SQL.ADD("  AND    T.Cliente2   = '"~VAR('VEHICULODE')~"'             ")
SQL.ADD("  AND    T.Mercado2   in ("~Pipe2Comillas(VAR('MERCBCRA'))~") ")
SQL.ADD("  AND    T.Especie    = '"~VAR('MONELOCA')~"'               ")
SQL.ADD("  AND    T.Fecha1     = "~idxdate2(Dialogo.Fecha1)~"        ")
SQL.ADD("  AND    T.Vehiculo1  = C.Codigo                            ")
If NoVacio(Dialogo.NrTrans1)
    SQL.ADD(" and    T.NrTrans = '"~Dialogo.NrTrans1~"'              ")
Endif
SQL.ADD(" order by T.NrTrans                ")
watch(SQL.BATCH())
ACN(z:1,0)

Recorrer SQL
    SCN(z:1,1)
    
    * Voucher
    ACT(a:Val(z1),FBN['NrTrans'])
    
    * Tipo de Voucher
    ACT(b:Val(z1),FBN['TipoTr2'])
    
    * Fecha_larga (ej. Buenos Aires, 10 de septiembre de 2017)

    *    ACT(c:Val(z1), FBN['Fecha5'])
    ACD(c:Val(z1), FBN['Fecha1'])
    
    ACT(o:Val(z1), FStr(Dia(val(c:Val(z1))),0,0)~' de '~Meses(Mes(val(c:Val(z1))))~' de '~FStr(Anio(val(c:Val(z1))),0,0))
   
    * Razon_social del cliente (cabecera - Sres...")
    ACT(d:Val(z1), FBN['RazonSocialCorresp'])
    if Vacio(Val(d:Val(z1)))
       Messagebox('Falta definir corresponsal cuenta '~fbn['Cuenta2'])
    endif

    * Cuenta a debitar
    ACT(e:Val(z1), FBN['NUMERO']) 
    
    * Especie         
    ACT(f:Val(z1), FBN['Especie'])
    
    * Cantidad/Importe - Cantidad_textual
    If FBN['Cantidad1']>=0
        ACT(g:Val(z1),    pyc(FBN['Cantidad1'],1,2))
        ACT(h:Val(z1), Letras(FBN['Cantidad1'],0,150))
    else
        ACT(g:Val(z1),    pyc(-FBN['Cantidad1'],1,2))
        ACT(h:Val(z1), Letras(-FBN['Cantidad1'],0,150))
    Endif 
    
    * Razon_social del vehículo1 (nombre de la empresa) - Cuit del vehículo1 - Comitente - Nombre de la cuenta (?)                   
    If EqStr(fbn['TipoTr2'],'DEP')
       ACT(i:Val(z1), FBN['RSocialVeh'])  
       ACT(j:Val(z1), FBN['CuitVeh']) 
       ACT(k:Val(z1), FBN['Comitente'])
       ACT(m:Val(z1), 'Operaciones con el MAE')
    Else
        If EqStr(fbn['TipoTr2'],'TRNOP')
           ACT(i:Val(z1), FBN['RSocialVeh'])  
           ACT(j:Val(z1), FBN['CuitVeh']) 
           ACT(k:Val(z1), FBN['Comitente'])
           ACT(m:Val(z1), 'Operaciones con ROFEX')
        Endif
    Endif
    
    * Destinatario
    ACT(n:Val(z1), FBN['CodCorresp'])   
    
    * Leyenda de Especie
    ACT(p:Val(z1), FBN['NomEsp'])
      
      * Leyenda de Reimpresión  AA Se elimina 03-2018
      *      If Dialogo.Check1 = 0
      *  ACT(t:Val(z1), '')
      *else
      *  ACT(t:Val(z1), 'Reimpresion')
      *Endif
    
    * Contacto Empresa
    ACT(s:Val(z1), FBN['ContactoCorresp'])
    
    * Cuenta Depositar TRNOP
    ACT(ct:Val(z1), FBN['Cuenta1'])
    
    * Mercado TRNOP ROFEX
    ACT(me:Val(z1), FBN['Mercado1'])
    
Proximo

If Val(z:1)=0
  Cancelar('No existen cartas para imprimir')
Else
  ACO(1, 10)
  ACO(2, 5)
  ACO(3, 10)
  ACO(4, 18)
  ACO(5, 10)
  ACO(6, 10)
Endif  
   
ListBox(a:1..g:Val(z:1),'Voucher      Tipo Trans.  Fecha   Cliente/Corresponsal   Cuenta       Especie      Importe   ')

If Ok
 Recorrersel

 ACT(fe:1, Fecha(val(C:FilaCiclo),'DD-MM-YYYY'))
 ACT(xx:2, VAR('PATHCARTA3')~val(A:FilaCiclo)~" - "~val(N:FilaCiclo)~" - "~val(fe:1)~".docx")
 
 ACN(kk:1,0)

 If EqStr(val(b:FilaCiclo),'DEP')
    Emitircarta(val(xx:1),val(xx:2), fecha_larga=Val(o:FilaCiclo), razon_social=Val(d:FilaCiclo), empresa=val(i:FilaCiclo), cuit=val(j:FilaCiclo), cuenta=val(e:FilaCiclo), cantidad=Val(g:FilaCiclo), leyenda=val(h:FilaCiclo), nombre_cuenta=val(m:FilaCiclo), comitente=val(k:FilaCiclo), especie_leyenda=val(p:FilaCiclo), leyenda_re=val(t:FilaCiclo))
    ACN(kk:1,1)
 EndIf

 If EqStr(val(b:FilaCiclo),'RET')
    Emitircarta(val(xx:3),val(xx:2), fecha_larga=Val(o:FilaCiclo), razon_social=Val(d:FilaCiclo), cuenta=val(e:FilaCiclo), cantidad=Val(g:FilaCiclo), leyenda=val(h:FilaCiclo), especie_leyenda=val(p:FilaCiclo), contacto_emp=val(s:FilaCiclo),leyenda_re=val(t:FilaCiclo))
    ACN(kk:1,1)
 EndIf
    
 If EqStr(val(b:FilaCiclo),'TRNOP') y EqStr(val(me:FilaCiclo),VAR('MERROFEX'))
    If EqStr(val(ct:FilaCiclo),VAR('CTAROFEXMT'))
       Emitircarta(val(xx:4),val(xx:2), fecha_larga=Val(o:FilaCiclo), razon_social=Val(d:FilaCiclo), contacto_emp=val(s:FilaCiclo), cuenta=val(e:FilaCiclo), cantidad=Val(g:FilaCiclo), leyenda=val(h:FilaCiclo))
       ACN(kk:1,1)
    Else
       Emitircarta(val(xx:5),val(xx:2), fecha_larga=Val(o:FilaCiclo), razon_social=Val(d:FilaCiclo), cuenta=val(e:FilaCiclo), cantidad=Val(g:FilaCiclo), leyenda=val(h:FilaCiclo), especie_leyenda=val(p:FilaCiclo), contacto_emp=val(s:FilaCiclo),leyenda_re=val(t:FilaCiclo))
       ACN(kk:1,1)
    Endif   
 EndIf

 
