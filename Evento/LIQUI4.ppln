sql.add("SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, ")
sql.add(" M.Transaccion, M.Cuenta, M.Leyenda, M.NrMov, O.TipoOp, M.EnteCustodia Vehiculo, M.NrLiq, O.Book1 ")
sql.add(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
sql.add(" Where O.NrOperacion = B.NrOperacion ")
sql.add("       and M.NrOperacion = B.NrOperacion ")
sql.add("       and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("       and M.EnteCustodia in ("~pipe2comillas(Val(vh:1))~") ")
sql.add("       and M.Bits = 'MV' ")
if (dialogo.fecha2 > 0)
sql.add("       and M.FechaMov >= '"~IdxDate(dialogo.fecha2)~"' ")
endif
sql.add(" AND M.NrSaldo = 1 ")
if (dialogo.check1 = 1)
sql.add(" AND (((O.OperacionRef Is Null OR O.OperacionRef = '') ")
sql.add("        AND O.TipoOp IN ("~pipe2comillas(Val(ls:2))~")) ")
sql.add("        OR O.TipoOp Not IN ("~pipe2comillas(Val(ls:2))~")) ")
else
endif
if (NoVacio(dialogo.lista2))
sql.add("       and O.TipoOp IN ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.especie1))
sql.add("       and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
sql.add("       and M.Cliente = '"~dialogo.cliente1~"' ")
endif
sql.add("       and ((B.NrBit = 20 and B.Valor = '1') or (B.NrBit = 50 and B.Valor = '1')) ")
sql.add(" UNION ")
sql.add("SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, ")
sql.add(" M.Transaccion, M.Cuenta, M.Leyenda, M.NrMov, O.TipoTr2 TipoOp, M.EnteCustodia Vehiculo, M.NrLiq,O.Book1 ")
sql.add(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 O ")
sql.add(" Where O.NrTrans = M.NrOperacion ")
sql.add("       and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("       and M.EnteCustodia in ("~pipe2comillas(Val(vh:1))~") ")
sql.add("       and M.Bits = 'MV' ")
if (dialogo.fecha2 > 0)
sql.add("       and M.FechaMov >= '"~IdxDate(dialogo.fecha2)~"' ")
endif
sql.add(" AND M.NrSaldo = 1 ")
if (NoVacio(dialogo.lista2))
if (Incluido('SECAT', dialogo.lista2))
sql.add(" and O.TipoTr2 IN ('INTGAR') ")
endif
endif
if (NoVacio(dialogo.especie1))
sql.add("       and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
sql.add("       and M.Cliente = '"~dialogo.cliente1~"' ")
endif



sql.add(" ORDER BY 1, 2, 3, 4 ")

recorrer sql

