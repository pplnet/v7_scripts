HojaVisible(NO)

creardialogo
nroperacion1: 'Operacion';;;;;;;;;;
mercado1:'Mercado';;;;;;;;;;

findialogo

Sqladd("SELECT O.NrOperacion FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd("WHERE  O.NrOperacion = OB.NrOperacion ")
Sqladd("       AND OB.NrBit = 10 AND OB.Valor='1'   ")
if (NoVacio(dialogo.mercado1))
Sqladd("       AND O.Mercado = '"~dialogo.mercado1~"'         ")
endif
if (NoVacio(dialogo.nroperacion1))
Sqladd("       AND O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("       AND NOT EXISTS (SELECT M.NrOperacion FROM "~Dbo()~".MOVPENDIENTES M ")
Sqladd("                       WHERE  M.NrOperacion = O.NrOperacion ) ")
Sqladd("       AND  (O.TipoOp NOT IN ('FXCF','FXVF','FXAT') OR O.RB10<>'1' OR O.TotalNetoCli1<>0 ) ")
Sqladd("ORDER BY O.NrOperacion ")

recorrer sql
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" Where  NrBit=70 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" Where  NrBit=10 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()

Sqlexec()
