creardialogo
nroperacion1: 'NrOperacion';;;;;;Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', nroperacion1), 'MMCPM') y Eqstr(BuscarCampo('OPERACIONES', 'CB7', 'NrOperacion', nroperacion1), '0') y Eqstr(BuscarCampo('OPERACIONES', 'RB10', 'NrOperacion', nroperacion1), '0');'Debe ingresar una operacion MMCPM precancelable que no haya sido precancelada';NO;;;;;;"TipoOp = 'MMCPM' AND CB7 = 0 AND RB10 = 0"
findialogo

