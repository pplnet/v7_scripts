MostrarCuadroDeMensajes()
creardialogo
nroperacion1:'Operacion';;;;;;;;;'FM000026';
fecha1:'Fecha';;;;;;;;;FSys();
cantidad:'TotalResultado';;;;;;;;;0;
findialogo

if (not ok)
Cancelar()
endif

Message('Borrando MTM')
Sqladd("DELETE "~Dbo()~".MTMDIARIO  ")
Sqladd("WHERE NrOperacion='"~dialogo.nroperacion1~"'  ")
Sqladd("  AND Fecha="~IdxDate2(dialogo.fecha1))
Sqladd("  AND TipoMTM='MTM' ")
Sqlnew()

Message('Borrando Liquidacion')
Sqladd("DELETE "~Dbo()~".MOVPENDIENTES  ")
Sqladd("WHERE NrOperacion='"~dialogo.nroperacion1~"'  ")
Sqladd("  AND Fechamov="~IdxDate2(dialogo.fecha1))
Sqlnew()


Message('Actualizando Resultado')
Sqladd("UPDATE "~Dbo()~".OPERACIONES  ")
Sqladd("   SET TotalAux3="~FStr(dialogo.cantidad, 0, 2))
Sqladd("WHERE NrOperacion='"~dialogo.nroperacion1~"'  ")
Sqlnew()
Sqlexec()

