creardialogo
nroperacion1: 'Operacion';1;1;;;;Vacio(dialogo.nroperacion1) o (Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMONM') y BuscarCampo('OPERACIONES', 'RB7', 'NrOperacion', dialogo.nroperacion1) = 1);'Operacion invalida';NO;;;;;;"TipoOp='MMONM' and RB7=1"
fecha1: 'FechaVto';2;1;;;;dialogo.fecha1 <> 0;'Ingrese la fecha de vencimiento';NO;FSys();
radio1: 'Automat|SI|NO';3;1;;NO;NO;
findialogo

if (not ok)
Cancelar()
endif


Sqladd("Select O.NrOperacion, O.PlazoGracia, O.RB8, C.NrCuota, C.Fecha1, C.Fecha2, C.Cantidad2, C.Precio4, C.Precio9, C.Precio10, C.Tasa3, C.Tasa5, C.Tasa7, ")
Sqladd("C.Check5, C.Total9, C.Cantidad4, O.Cliente1, O.ImpGastos2, O.TotalAux1, C.Precio11, O.Cuotas1 ")
Sqladd("From "~Dbo()~".CUOTAS C")
Sqladd("Join "~Dbo()~".OPERACIONES O ")
Sqladd("on C.NrOperacion=O.NrOperacion")
Sqladd("where O.RB7=1 and C.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
recorrer sql
if (dialogo.radio1 = 1 o (dialogo.radio1 = 0 y Fbn('Check5') = 1))
Acn(b:1, Fbn('Precio9') + Fbn('Precio4'))
Acn(a:1, iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Val(b:1) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1)))
Acn(a:2, iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Fbn('Precio10') / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1)))
Acn(b:2, iif (not Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn('Cliente1'))), 0, ((iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Val(b:1) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1))) * Fbn('ImpGastos2') / 100)))
Acn(b:3, iif (Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn('Cliente1'))), 0, ((iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Val(b:1) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1))) * Fbn('TotalAux1') / 100)))
Acn(b:5, Val(a:1) * (Fbn('Tasa3') / 100))
Acn(b:6, Val(a:1) + Val(b:3) + Val(b:5))

Sqladd("Update "~Dbo()~".CUOTAS ")
Sqladd("set Cantidad3 = "~FStr(Val(a:1), 0, 2)~", Cantidad12 = "~FStr(Val(a:2), 0, 2)~", Precio2 = "~FStr(Fbn('Precio9'), 0, 8)~", Check7 = 1, ")
Sqladd("Tasa2 = "~FStr(Val(b:1), 0, 8)~", Precio1 = "~FStr(Val(b:2), 0, 8)~", Total6 = "~FStr(Val(b:1), 0, 8)~",  Precio3 = "~FStr(Val(b:3), 0, 8)~", ")
Sqladd("Cantidad5 = "~Val(b:6)~",Total2 = "~FStr(Fbn('Cantidad4') + Val(a:1), 0, 2)~", Total1 = "~FStr(Fbn('Cantidad4') + Val(b:6), 0, 2)~", ")
Sqladd("PrecioRef1 = "~FStr(Val(b:5), 0, 2)~", Total9 = "~FStr(Val(b:5), 0, 2)~", ")
Sqladd("Precio5 = "~FStr(Val(a:1), 0, 8)~", Precio6 = "~FStr(Val(b:2), 0, 8)~", Precio7 = "~FStr(Val(b:3), 0, 8)~" ")
Sqladd("where NrOperacion = '"~Fbn('NrOperacion')~"' and NrCuota = "~Fbn('NrCuota')~" ")
Sqlnew()
Sqlexec()
Acn(cu:1, Fbn('NrCuota'))
Sqladd("Select O.RB8, O.PlazoGracia, O.ImpGastos2, O.TotalAux1, O.Cliente1, C.NrCuota, C.Fecha1, C.Fecha2, C.Cantidad2, C.Cantidad4, C.Precio4, C.Precio2,  ")
Sqladd("C.Tasa2, C.Tasa3, C.Tasa5, C.Tasa7, C.NrCuota Cuota, C.Precio3, C.Total6, C.Total9, C.Precio8, C.Precio9, C.Check6 ")
Sqladd("From "~Dbo()~".CUOTAS C")
Sqladd("Left Join "~Dbo()~".OPERACIONES O ")
Sqladd("on C.NrOperacion = O.NrOperacion ")
Sqladd("where C.NrOperacion = '"~Fbn('NrOperacion')~"' and C.NrCuota > "~Fbn('NrCuota')~" ")
recorrer sql
if (Fbn('Cuota') = Val(cu:1) + 1)
Acn(a:3, Fbn('Cantidad2') + Val(a:2))
else
Acn(a:3, Val(a:7))
endif
Acn(t:1, Fbn('Precio8') + Fbn('Precio11', 0))
Acn(t:3, Fbn('Precio9') + Fbn('Precio11', 0))
if (Fbn('Check6') = 1 o Fbn('Cuota') = Fbn('Cuotas1', 0))
Acn(t:10, Val(t:1))
else
Acn(t:10, Val(t:3))
endif
Acn(a:4, iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Val(a:3) * ((Fbn('Precio4') + Val(t:10)) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1)))
Acn(a:5, Fbn('Tasa7') / Fbn('Tasa5') * 100)
Acn(a:6, Val(a:3) * (Val(a:5) / 100))
Acn(a:7, Val(a:3) - Val(a:6))
Acn(t:2, Fbn('Precio4') + Val(t:10))
Acn(a:9, iif (not Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn('Cliente1'))), 0, ((iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Val(t:2) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1))) * Fbn('ImpGastos2') / 100)))
Acn(a:10, iif (Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn('Cliente1'))), 0, ((iif (Fbn('NrCuota') < Fbn('PlazoGracia'), 0, Fbn('Cantidad2') * (Val(t:2) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1))) * Fbn('TotalAux1') / 100)))
Acn(a:13, Val(a:4) * (Fbn('Tasa3') / 100))
Acn(a:11, Val(a:4) + Val(a:10) + Val(a:13))
Sqladd("Update "~Dbo()~".CUOTAS ")
Sqladd("set Cantidad2 = "~FStr(Val(a:3), 0, 2)~", Cantidad4 = "~FStr(Val(a:6), 0, 2)~", Tasa1 = "~FStr(Val(a:5), 0, 8)~",  ")
Sqladd("Cantidad3 = "~FStr(Val(a:4), 0, 2)~", Cantidad5 = "~FStr(Val(a:11), 0, 2)~", Total2 = "~FStr(Val(a:4) + Val(a:6), 0, 2)~", Total1 = "~FStr(Val(a:6) + Val(a:11), 0, 2)~", ")
Sqladd("Precio1 = "~FStr(Val(a:9), 0, 8)~", Precio3 = "~FStr(Val(a:10), 0, 8)~", Total9 = "~FStr(Val(a:13), 0, 2)~", ")
Sqladd("Precio5 = "~FStr(Val(a:4), 0, 8)~", Precio6 = "~FStr(Val(a:9), 0, 8)~", Precio7 = "~FStr(Val(a:10), 0, 8)~", PrecioRef1 = "~FStr(Val(a:13), 0, 2)~" ")
Sqladd(", Precio8 = "~FStr(Val(t:1), 0, 8)~", Precio9 = "~FStr(Val(t:3), 0, 8)~", ")
Sqladd("Precio2 = "~FStr(Val(t:10), 0, 8)~", Total6 = "~FStr(Val(t:2), 0, 8)~", Tasa2 = "~FStr(Val(t:2), 0, 8)~" ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota = "~Fbn('NrCuota')~" ")
Sqlnew()
Sqlexec()
proximo
endif
proximo


