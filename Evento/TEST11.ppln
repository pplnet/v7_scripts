Sqladd(" Select O.NrOperacion, O.TipoOp, O.Precio5, O.Indice as Indice, C.NrOperacion, C.NrCuota, C.Cantidad13, C.Cantidad14, C.Cantidad15,")
Sqladd(" C.Cantidad16, C.Precio3, C.Precio1, C.Cantidad17, C.Fecha5, O.Especie, C.Cantidad4, C.Cantidad3 ")
Sqladd(" From   "~Dbo()~".CUOTAS C, "~Dbo()~".OPERACIONES O   ")
Sqladd(" where C.NrOperacion=O.NrOperacion   AND O.TipoOp IN ('MMONM')     ")
Sqladd(" and O.Precio5 = '1'    AND C.Fecha5  = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and O.Indice Is Not null AND O.Indice <> ''  ")

Sqladd(" order by O.NrOperacion ")

recorrer sql
