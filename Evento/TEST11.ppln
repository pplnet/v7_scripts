Sqladd(" Cantidad17 = "~FStr(Val(w:9), 0, 8)~" ")
Sqladd(" where NrOperacion = '"~Val(b:2)~"' AND  NrCuota = "~FStr(Val(b:3), 2, 0)~" ")
