MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha Desde';;;;;;dialogo.fecha1 <> 0;'Fecha Desde Invalida';NO;FSys();
fecha2:'Fecha Hasta';;;;;;dialogo.fecha2 >= dialogo.fecha1;'Fecha Hasta Invalida';NO;FSys();
radio1:'Depura|Oper|Tran';;;;;;dialogo.radio1 >= 0;'¿Depura OPERACIONES o TRANSACCIONES?';NO;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0 o dialogo.radio1 = 2)
Sqladd(" Select Distinct O.NrOperacion ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND O.FechaCargaSys >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.FechaCargaSys <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND M.NrSaldo = 1 ")
recorrer sql
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1)
if (Query(" Select 1 From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrBit = 50 AND Valor = '1' ") = 1)
Message('Borrando Bits Operacion '~Fbn('NrOperacion'))
Sqladd(" Delete "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND NrBit <> 50 ")
Sqlnew()
Sqlexec()
endif
endif
proximo
endif
if (dialogo.radio1 = 1 o dialogo.radio1 = 2)
Sqladd(" Select Distinct T.NrTrans ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" Where T.NrTrans = M.NrOperacion ")
Sqladd(" AND T.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND M.NrSaldo = 1 ")
recorrer sql
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Fbn('NrTrans')~"' AND NrSaldo = 1 ") <> 1)
if (Query(" Select 1 From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Fbn('NrTrans')~"' AND NrBit = 20 AND Valor = '1' ") = 1)
Message('Borrando Bits Transaccion '~Fbn('NrTrans'))
Sqladd(" Delete "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqladd(" AND NrBit <> 20 ")
Sqlnew()
Sqlexec()
endif
endif
proximo
endif
