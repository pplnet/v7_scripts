*HojaVisible(SI)
MostrarCuadroDeMensajes

CrearDialogo
    Fecha1:  'Fecha Saldos'               ;1;1;1;SI;SI;EsHabil(Dialogo.Fecha1,'ARG');'Dia no habil';SI;FSYS
    Cuenta1:  'Cuenta'                    ;2;1;;;;;;;;;;;;"Select Codigo, Numero , Nombre from "~DBO~".CUENTAS Where Numero IN (Select Distinct Numero From "~DBO~".SALDOSBANCARIOS) "
FinDialogo

If not ok
    Cancelar
Endif

If NoVacio(Dialogo.Cuenta1)
    let &NrCuenta BuscarCampo('Cuentas','Numero','Codigo',Dialogo.Cuenta1) 
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(Dialogo.Fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(Dialogo.Fecha1,SI))~"' and NrCuenta = '"~&NrCuenta~"' and Estado in ('REC','PRO') ")=1
        Cancelar('Existen saldos posteriores a la fecha. Cancela Evento.')
    Endif
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~&NrCuenta~"' and Estado in ('PRO') ") = 1
        Cancelar('El saldo para la fecha ya está procesado. Cancela Evento.')
    Endif
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~&NrCuenta~"' and Estado in ('REC','PRO')  ")<>1
    Cancelar('No existen saldos para la cuenta '~Dialogo.Cuenta1~' a la fecha '~Dialogo.Fecha1~' ')
    Endif
Else
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo > '"~IdxDate(Dialogo.Fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(Dialogo.Fecha1,SI))~"' and Estado in ('REC','PRO')  ")=1
        Cancelar('Existen saldos posteriores a la fecha. Cancela Evento.')
    Endif
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and Estado in ('PRO')  ")=1
        Cancelar('Existen saldos procesados para la fecha. Cancela Evento.')
    Endif
    If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and Estado in ('REC','PRO')  ")<>1
        Cancelar('No existen saldos a la fecha '~Dialogo.Fecha1~' ')
    Endif
Endif

If NoVacio(Dialogo.Cuenta1)
    If MessageBox('Anular saldos de '~Dialogo.Cuenta1~' al '~Dialogo.Fecha1~' ',1,2) = 7
        Cancelar('Evento cancelado')
    Endif
Else
    If MessageBox('Anular saldos de todas las cuentas al '~Dialogo.Fecha1~' ',1,2) = 7
        Cancelar('Evento cancelado')
    Endif
Endif
    

If NoVacio(Dialogo.Cuenta1)
    SQL.ADD(" UPDATE "~dbo~".SALDOSBANCARIOS ")
    SQL.ADD(" SET Estado = 'ANU' , FechaAnu="~SQLAhora~", UsuarioAnu='"~UsuarioActivo~"' ")
    SQL.ADD(" WHERE FechaSaldo = '"~Idxdate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" and NrCuenta = '"~&NrCuenta~"' ")
    SQL.NEW
    SQL.EXEC
Else
    SQL.ADD(" UPDATE "~dbo~".SALDOSBANCARIOS ")
    SQL.ADD(" SET Estado = 'ANU' , FechaAnu="~SQLAhora~", UsuarioAnu='"~UsuarioActivo~"' ")
    SQL.ADD(" WHERE FechaSaldo = '"~Idxdate(Dialogo.Fecha1)~"' ")
    SQL.NEW
    SQL.EXEC
Endif
    

