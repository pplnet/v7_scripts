HojaVisible(NO)

ModoReproceso(SinDialogo)
CrearDialogo
  Especie1   : 'Especie para generar especie-cupon '                ;;;;;;;;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

**** Calculo la jerarquia cupones
                                                                           
ACT(pp:4, GenerarJerarquiaPorReferencia('ESPECIES','004000000000000',si))

****Genero la query

SQL.ADD("  SELECT                                                                             ")
SQL.ADD("  Jerarquia, Codigo,   Cupon, Nombre, Extendido, Cotiza, InteresesC,                 ")
SQL.ADD("  FEmision, Fecha, cupones, TamanioLote, VTeorico, VNominal,  Factor,                ")
SQL.ADD("  DiasMes, DiasAnio, MercadoDef, Tasa1, Tasa2, Tasa3, Observaciones,                 ")
SQL.ADD("  Valor1, Valor2, Valor3, Valor4, Valor5, Valor6, Valor7, Valor8,                    ")
SQL.ADD("  Valor10, Alias1, Alias2, Alias3, Alias4, Alias5, Alias6, Alias7,                   ")
SQL.ADD("  Alias8, Alias9, Alias10, Caracter, MaxGraficar, MinGraficar,                       ")
SQL.ADD("  MaxSupuesto, MinSupuesto, Intervalos, TipoOpcionDef, PlazoLiq,                     ")
SQL.ADD("  Security, ExNumber, ExNumbers, Issue, SType, Issuer, Guarantor, CalDate,           ")
SQL.ADD("  PutDate, ConDate, CodAlfCajaValores, Tipo, TipoEC, LaminaMinima,                   ")
SQL.ADD("  TipoAccion, CantidadVotos, SyPRating, MoodysRating, Status, Sector,                ")
SQL.ADD("  IndustryGroup, CallPrice, PutPrice, DenominCajaValores, Habilitada,                ")
SQL.ADD("  FecDeshabilitacion, CodEsCuponAnterior, CodEsProximoCupon,                         ")
SQL.ADD("  CodEsCuponAdherido, Codigo1, Codigo3, Codigo4, FechaCorteCupon,           ")
SQL.ADD("  FechaPresentaCupon, FechaProximoCorte, FechaPagoCupon, FechaCambioTasa,            ")
SQL.ADD("  TasaIntVigente, TasaIntAnterior, IntsCapitalizados, CUSIP, Cedel,            ")
SQL.ADD("  EuroClear, PeriodoIntereses, FormaCalculoInts, TasaAmortProxCupon, EsCupon,        ")
SQL.ADD("  CuponFeriado, PaisOrigen, Tranche, ISO, ContraespecieCupon, Indexado,              ")
SQL.ADD("  Indice, Reestructurado, ZeroCoupon, Fecha1, Fecha2, Fecha3, Fecha4,                ") 
SQL.ADD("  Fecha5, Fecha6, Fecha7, Fecha8, Fecha9, Fecha10, LocalRating1, LocalRatingSource1, ")
SQL.ADD("  LocalRating2, LocalRatingSource2, Marketability, CommonCode, MaxHoldingPeriod,     ")
SQL.ADD("  FechaAsigHoldingP, FechaVtoHoldingP, FechaRevHoldingP, FuenteCotizacion,           ")
SQL.ADD("  CodigoCotizacion, CotizaMAE, VolumenMinimo, GrupoEspecie, CantEmitida, CutOffTime, ")
SQL.ADD("  EntidadEmisora, Tipocartera, Aforo, Comprobante, OrdenFirmada, CodMAEContado,      ")
SQL.ADD("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ") 
SQL.ADD("  FROM  "~DBO~".Especies                                                             ")
SQL.ADD("  WHERE Codigo = '"~Dialogo.Especie1~"'                                              ")

**** Recorro y Cargo a la vez

Recorrer SQL

    ACT(pp:1, SQL("Select 1 from "~DBO~".Especies where codigo = '"~fbn['Alias9']~"' "))
    IF Incluido('1',val(pp:1))
        Cancelar('Ya existe la especie-cupón!')
    Endif

    ACT(pp:5, fbn['Alias9'])
    ACT(pp:8,'CUPON '~fbn['Nombre'])
    ACT(pp:9, Copy(val(pp:8),1,15))

    SQL.ADD("Insert into "~DBO~".Especies  (                                                      ")
    SQL.ADD("  Jerarquia, Codigo,   Cupon, Nombre, Extendido, Cotiza, InteresesC,                 ")
    SQL.ADD("  FEmision, Fecha, cupones, TamanioLote, VTeorico, VNominal,  Factor,                ")
    SQL.ADD("  DiasMes, DiasAnio, MercadoDef, Tasa1, Tasa2, Tasa3, Observaciones,                 ")
    SQL.ADD("  Valor1, Valor2, Valor3, Valor4, Valor5, Valor6, Valor7, Valor8,                    ")
    SQL.ADD("  Valor10, Alias1, Alias2, Alias3, Alias4, Alias5, Alias6, Alias7,                   ")
    SQL.ADD("  Alias8, Alias9, Alias10, Caracter, MaxGraficar, MinGraficar,                       ")
    SQL.ADD("  MaxSupuesto, MinSupuesto, Intervalos, TipoOpcionDef, PlazoLiq,                     ")
    SQL.ADD("  Security, ExNumber, ExNumbers, Issue, SType, Issuer, Guarantor, CalDate,           ")
    SQL.ADD("  PutDate, ConDate, CodAlfCajaValores, Tipo, TipoEC, LaminaMinima,                   ")
    SQL.ADD("  TipoAccion, CantidadVotos, SyPRating, MoodysRating, Status, Sector,                ")
    SQL.ADD("  IndustryGroup, CallPrice, PutPrice, DenominCajaValores, Habilitada,                ")
    SQL.ADD("  FecDeshabilitacion, CodEsCuponAnterior, CodEsProximoCupon,                         ")
    SQL.ADD("  CodEsCuponAdherido, Codigo1, Codigo3, Codigo4, FechaCorteCupon,           ")
    SQL.ADD("  FechaPresentaCupon, FechaProximoCorte, FechaPagoCupon, FechaCambioTasa,            ")
    SQL.ADD("  TasaIntVigente, TasaIntAnterior, IntsCapitalizados, CUSIP, Cedel,            ")
    SQL.ADD("  EuroClear, PeriodoIntereses, FormaCalculoInts, TasaAmortProxCupon, EsCupon,        ")
    SQL.ADD("  CuponFeriado, PaisOrigen, Tranche, ISO, ContraespecieCupon, Indexado,              ")
    SQL.ADD("  Indice, Reestructurado, ZeroCoupon, Fecha1, Fecha2, Fecha3, Fecha4,                ") 
    SQL.ADD("  Fecha5, Fecha6, Fecha7, Fecha8, Fecha9, Fecha10, LocalRating1, LocalRatingSource1, ")
    SQL.ADD("  LocalRating2, LocalRatingSource2, Marketability, CommonCode, MaxHoldingPeriod,     ")
    SQL.ADD("  FechaAsigHoldingP, FechaVtoHoldingP, FechaRevHoldingP, FuenteCotizacion,           ")
    SQL.ADD("  CodigoCotizacion, CotizaMAE, VolumenMinimo, GrupoEspecie, CantEmitida, CutOffTime, ")
    SQL.ADD("  EntidadEmisora, Tipocartera, Aforo, Comprobante, OrdenFirmada, CodMAEContado,      ")
    SQL.ADD("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ")
    
    SQL.ADD(") values (                                                                           ")

    SQL.ADD("  '"~val(pp:4)~"', '"~fbn['Alias9']~"', '"~fbn['Cupon']~"',  '"~val(pp:9)~"', 'Cupon de "~fbn['Extendido']~"', '"~fbn['Cotiza']~"', '"~fbn['InteresesC']~"',                                 ")
    SQL.ADD("  '"~IdxDate(fbn['FEmision'])~"', '"~IdxDate(fbn['Fecha'])~"', '"~fbn['Cupones']~"', '"~fbn['TamanioLote']~"', '"~fbn['VTeorico']~"', '"~fbn['VNominal']~"',  '"~fbn['Factor']~"',           ")
    SQL.ADD("  '"~fbn['DiasMes']~"', '"~fbn['DiasAnio']~"', '"~fbn['MercadoDef']~"', '"~fbn['Tasa1']~"', '"~fbn['Tasa2']~"', '"~fbn['Tasa3']~"', '"~fbn['Observaciones']~"',                              ")
    SQL.ADD("  '"~fbn['Valor1']~"', '"~fbn['Valor2']~"', '"~fbn['Valor3']~"', '"~fbn['Valor4']~"', '"~fbn['Valor5']~"', '"~fbn['Valor6']~"', '"~fbn['Valor7']~"', '"~fbn['Valor8']~"',                    ")
    SQL.ADD("  '"~fbn['Valor10']~"', '"~fbn['Alias1']~"', '"~fbn['Alias2']~"', '"~fbn['Alias3']~"', '"~fbn['Alias4']~"', '"~fbn['Alias5']~"', '"~fbn['Alias6']~"', '"~fbn['Alias7']~"',                   ")
    SQL.ADD("  '"~fbn['Alias8']~"', '"~fbn['Codigo']~"', '"~fbn['Alias10']~"', '"~fbn['Caracter']~"', '"~fbn['MaxGraficar']~"', '"~fbn['MinGraficar']~"',                                                 ")
    SQL.ADD("  '"~fbn['MaxSupuesto']~"', '"~fbn['MinSupuesto']~"', '"~fbn['Intervalos']~"', '"~fbn['TipoOpcionDef']~"', '"~fbn['PlazoLiq']~"',                                                            ")
    SQL.ADD("  '"~fbn['Security']~"', '"~fbn['ExNumber']~"', '"~fbn['ExNumbers']~"', '"~fbn['Issue']~"', '"~fbn['SType']~"', '"~fbn['Issuer']~"', '"~fbn['Guarantor']~"', '"~IdxDate(fbn['CalDate'])~"',  ")
    SQL.ADD("  '"~IdxDate(fbn['PutDate'])~"', '"~IdxDate(fbn['ConDate'])~"', '"~fbn['CodAlfCajaValores']~"', '"~fbn['Tipo']~"', '"~fbn['TipoEC']~"', '"~fbn['LaminaMinima']~"',                           ")
    SQL.ADD("  '"~fbn['TipoAccion']~"', '"~fbn['CantidadVotos']~"', '"~fbn['SyPRating']~"', '"~fbn['MoodysRating']~"', '"~fbn['Status']~"', '"~fbn['Sector']~"',                                          ")
    SQL.ADD("  '"~fbn['IndustryGroup']~"', '"~fbn['CallPrice']~"', '"~fbn['PutPrice']~"', '"~fbn['DenominCajaValores']~"', '"~fbn['Habilitada']~"',                                                       ")
    SQL.ADD("  '"~fbn['FecDeshabilitacion']~"', '"~fbn['CodEsCuponAnterior']~"', '"~fbn['CodEsProximoCupon']~"',                                                                                          ")
    SQL.ADD("  '"~fbn['CodEsCuponAdherido']~"', '"~fbn['Codigo1']~"', '"~fbn['Codigo3']~"', '"~fbn['Codigo4']~"', '"~IdxDate(fbn['FechaCorteCupon'])~"',                            ")
    SQL.ADD("  '"~IdxDate(fbn['FechaPresentaCupon'])~"', '"~IdxDate(fbn['FechaProximoCorte'])~"', '"~IdxDate(fbn['FechaPagoCupon'])~"', '"~IdxDate(fbn['FechaCambioTasa'])~"',                            ")
    SQL.ADD("  '"~fbn['TasaIntVigente']~"', '"~fbn['TasaIntAnterior']~"', '"~fbn['IntsCapitalizados']~"', '"~fbn['CUSIP']~"', '"~fbn['Cedel']~"',                                      ")
    SQL.ADD("  '"~fbn['EuroClear']~"', '"~fbn['PeriodoIntereses']~"', '"~fbn['FormaCalculoInts']~"', '"~fbn['TasaAmortProxCupon']~"', 'SI',                                                               ")
    SQL.ADD("  '"~fbn['CuponFeriado']~"', '"~fbn['PaisOrigen']~"', '"~fbn['Tranche']~"', '"~fbn['ISO']~"', '"~fbn['ContraespecieCupon']~"', '"~fbn['Indexado']~"',                                        ")
    SQL.ADD("  '"~fbn['Indice']~"', '"~fbn['Reestructurado']~"', '"~fbn['ZeroCoupon']~"', '"~IdxDate(fbn['Fecha1'])~"', '"~IdxDate(fbn['Fecha2'])~"', '"~IdxDate(fbn['Fecha3'])~"', '"~IdxDate(fbn['Fecha4'])~"', ") 
    SQL.ADD("  '"~IdxDate(fbn['Fecha5'])~"', '"~IdxDate(fbn['Fecha6'])~"', '"~IdxDate(fbn['Fecha7'])~"', '"~IdxDate(fbn['Fecha8'])~"', '"~IdxDate(fbn['Fecha9'])~"', '"~IdxDate(fbn['Fecha10'])~"', '"~fbn['LocalRating1']~"', '"~fbn['LocalRatingSource1']~"', ")
    SQL.ADD("  '"~fbn['LocalRating2']~"', '"~fbn['LocalRatingSource2']~"', '"~fbn['Marketability']~"', '"~fbn['CommonCode']~"', '"~fbn['MaxHoldingPeriod']~"',                                            ")
    SQL.ADD("  '"~IdxDate(fbn['FechaAsigHoldingP'])~"', '"~IdxDate(fbn['FechaVtoHoldingP'])~"', '"~IdxDate(fbn['FechaRevHoldingP'])~"', '"~fbn['FuenteCotizacion']~"',                                    ")
    SQL.ADD("  '"~fbn['CodigoCotizacion']~"', '"~fbn['CotizaMAE']~"', '"~fbn['VolumenMinimo']~"', '"~fbn['GrupoEspecie']~"', '"~fbn['CantEmitida']~"', '"~fbn['CutOffTime']~"',                           ")
    SQL.ADD("  '"~fbn['EntidadEmisora']~"', '"~fbn['Tipocartera']~"', '"~fbn['Aforo']~"', '"~fbn['Comprobante']~"', '"~fbn['OrdenFirmada']~"', '',                                                        ")
    SQL.ADD("  '"~fbn['AforoPesos']~"', '"~fbn['AforoDolares']~"', '"~fbn['MonedaEmision']~"', '"~fbn['TasaCER']~"', '"~fbn['SWIFT']~"'                                                                   ")
    SQL.ADD("     )                                                                                                                                                                                       ")

    SQL.NEW  

