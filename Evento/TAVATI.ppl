MostrarCuadroDeMensajes
CrearDialogo
  Fecha1       : "Fecha"        ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha  Invalida';NO;Fsys;
FinDialogo

if Not Ok
  Cancelar
endif

***---Obtengo cupones a Setear la tasa
SQL.ADD(" Select A.FechaCorte, A.NrCupon, A.Especie, E.DiasTasa Dias, E.TipoTasa, E.Spread ")
SQL.ADD(" From "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = A.Especie ")
SQL.ADD(" AND A.Estado = 'PEN' ")
SQL.ADD(" AND A.NrCupon = E.Cupon ")
SQL.ADD(" AND (E.TipoTasa Is Not Null OR E.TipoTasa <> '') ")
SQL.ADD(" AND E.TipoTasa <> 'FIJA' ")
SQL.ADD(" AND A.Esquema = '0' ")
SQL.ADD(" Order by A.Especie, A.NrCupon ")
Recorrer SQL
    let &tasaEncontrada 0
    IF Habiles(fbn('FechaCorte'), -fbn('Dias'), 'ARG', SI) >= Dialogo.Fecha1
        ***---Se setea la tasa hasta la fecha definitiva de seteo para el cupon
        ACN(b:1,0)
        ACT(b:2, fbn('Especie'))
        ACT(b:3, fbn('NrCupon'))
        SQL.ADD(" Select T.Valor1 From "~DBO~".TASASDIA T ")
        SQL.ADD(" Where TipoTasa = '"~fbn('TipoTasa')~"'  ")
        SQL.ADD(" AND Fecha = (Select Max(Fecha) From "~DBO~".TASASDIA T1 ")
        SQL.ADD("              Where T.TipoTasa = T1.TipoTasa ")
        SQL.ADD("              AND T1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")    
        Recorrer SQL
            ACN(b:1, fbn('Valor1'))    
            let &tasaEncontrada 1
        Proximo
        IF &tasaEncontrada = 1 
            ***---Fecha de Corte Anterior
            ACD(FA:1, UltCupon2(fbn('Especie'), fbn('FechaCorte')-1))
            ***---Fecha Prox Cupon
            ACD(FP:1, ProxCupon2(fbn('Especie'), fbn('FechaCorte')))
            ***---Dias Anio
            ACN(DA:1, DiasA(EspecieDiasAnio(fbn('Especie')),fbn('FechaCorte')))
            ***---Dias Mes
            ACN(DM:1, Abs(IIF(EspecieDiasAnio(fbn('Especie'))=0 y EspecieDiasMes(fbn('Especie'))=0,30*DifMes(Val(FP:1),Val(FA:1)),DifDias(Val(FP:1),Val(FA:1),'USA',NO))))
            ***---Tasa del Periodo
            ***---DM:1 = Tasa efectiva del periodo
            ***---B:1 = Tasa Anual
            ***---Debemos guardar la tasa anual. En la especie dividida 100
            ACN(TA:1, ((Val(B:1)+(fbn('Spread')*100))/Val(DA:1))*Val(DM:1))
            SQL.ADD(" Update "~DBO~".ESPECIES Set ")
            SQL.ADD(" TasaIntAnterior = TasaIntVigente, ")
            SQL.ADD(" TasaIntVigente = "~Fstr(Val(B:1)/100, 0, 8)~", ")
            ***---NO cambio la fecha de seteo porque sino luego InteresEspecie toma la tasa anterior
            SQL.ADD(" FechaCambioTasa = '"~IdxDate(Fsys)~"' ")
            SQL.ADD(" Where TipoTasa = '"~fbn('TipoTasa')~"' ")  
            SQL.NEW
            SQL.ADD(" Update "~DBO~".AGENDACUPONES SET ")
            SQL.ADD(" PorRentaAnterior  = PorRenta, ")
            SQL.ADD(" PorRenta = "~Fstr(Val(B:1), 0, 8)~", ")
            SQL.ADD(" FechaCambioTasa = '"~IdxDate(Fsys)~"' ")
            SQL.ADD(" Where Especie = '"~val(b:2)~"' ")
            SQL.ADD(" AND NrCupon = '"~val(b:3)~"' ")
            SQL.ADD(" AND NrCupon > 0 ")
            SQL.ADD(" AND Esquema = '0' ")
            SQL.NEW
            SQL.EXEC
            If fbn('NrCupon') > 1
               ACD(SS:1,SQL("Select FechaCorte from "~DBO~".AGENDACUPONES where NrCupon='"~Val(B:3)~"'-1  and Especie='"~Val(B:2)~"' "))
            Else
               ACD(SS:1,SQL("Select FEmision from "~DBO~".ESPECIES where Codigo='"~Val(B:2)~"' "))
            EndIF     
            EjecutarEvento('INT002',Fecha1=Val(SS:1),Fecha2=Dialogo.Fecha1,Especie1=Val(B:2))
        ELSE
            Message('No se encontró la tasa')
        ENDIF
    ENDIF
Proximo


