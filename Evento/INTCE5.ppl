SQL.ADD("Select T.NrTrans FROM TRANSACCIONES2 T, OPERACIONES O where O.NrOperacion = T.NrOperacionRef1 and T.TipoTr2 = 'DEP' and O.TipoOp IN ("~Pipe2Comillas(Var('TIPOOPCOMP'))~") ")
ACT(TR:1,'')
Recorrer SQL
    if Vacio(val(TR:1))
        ACT(TR:1, "'"~fbn('NrTrans')~"'")
    Else
        ACT(TR:1, val(TR:1)~",'"~fbn('NrTrans')~"'")
    EndIf
Proximo 

CrearDialogo
    NrTrans1 : 'Transaccion'   ;;;;;;NoVacio(Dialogo.NrTrans1);'Debe ingresar una transaccion';NO;;;;;;"NrTrans in ("~val(TR:1)~ ")";
    Book1:    'Book'             ;;;;;;NoVacio(Dialogo.Book1);;;;;;;;
FinDialogo

IF Not OK
    Cancelar
ENDIF


**Valida si existe el directorio para crear el csv
If ExisteDirectorio(VAR('PATHCOMPEG'))
**Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATHCOMPEG'),Longitud(VAR('PATHCOMPEG')),1),'\')
   ACT(pl:1, VAR('PATHCOMPEG')~VAR('FILECOMEG')~Pad0(FStr(Dia(FSYS),0,0),2)~Pad0(FStr(Mes(FSYS),0,0),2)~FStr(Anio(FSYS),0,0))
   Else
   ACT(pl:1, VAR('PATHCOMPEG')~'\'~VAR('FILECOMEG')~Pad0(FStr(Dia(FSYS),0,0),2)~Pad0(FStr(Mes(FSYS),0,0),2)~FStr(Anio(FSYS),0,0))
   EndIf
Else
    Cancelar('El directorio '~VAR('PATHCOMPEG')~' no existe')
EndIf

**Si el nombre del archivo del comprobante es el mismo, le agrega una enumeración al final del nombre del archivo.
ACT(eg:1,Val(pl:1)~'.csv')
IF ExisteArchivo(Val(eg:1))
    Recorrer&I 1,9000
    ACT(eg:1,Val(pl:1)~'_'~Fstr(&I,10,0)~'.csv')
    IF Not ExisteArchivo(Val(eg:1))
            Break
        ENDIF
    Proximo 
ENDIF

********BUSQUEDA DE CAMPOS***********
SQL.ADD(" SELECT Vehiculo1,NrOperacionRef1,Fecha2,Especie,Cantidad1,Cuenta2, NrTrans, Book1, Cliente1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" WHERE NrTrans = '"~Dialogo.NrTrans1~"' ")

acn(zz:1,0)

Recorrer SQL
    If val(zz:1)=0
        AbrirAscii(Val(eg:1),0)
    EndIf        
    *Business unit
    ACT(A:1,fbn('Vehiculo1'))
    *VOUCHER_STYLE
    ACT(A:2,'CI')
    *ORIGIN 
    ACT(A:3,'FPA')
    *DST_CNTRL_ID 
    IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'TRANSF')
        ACT(A:4,'TRANSFER')
    ELSE
        IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'FCS')
            ACT(A:4,'INVERSIONES')
        ELSE
            ACT(A:4,'NoDefinido')
        ENDIF
    ENDIF
    *AP_VCHR_CAT
    ACT(A:5,'REG')
    *INVOICE_ID
    ACT(A:6,fbn('NrOperacionRef1')~'_'~fbn('NrTrans'))
    *DATE
    ACT(A:7,Fecha(FBN['Fecha2'],'dd-mm-yyyy'))
    *VENDOR_ID A CONFIRMAR
    ACT(A:8,'')
    *VAT_RGSTRN_ID  
    ACT(A:9,BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Cliente1')))
    *NFI_CAE_AP
    ACT(A:10,'')
    *VOUCHER_CAI_NUM
    ACT(A:11,'')
    *EFFDT_BD
    ACT(A:12,'')
    *NFI_CAEA
    ACT(A:13,'N')
    *Voucher_line_num
    ACN(A:14,1)
    *INV_ITEM_ID
    IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'TRANSF')
        ACT(A:15,BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie'))~'_'~BuscarCampo('CUENTAS','Alias6','Codigo',fbn('Cuenta2'))~'_'~BuscarCampo('CUENTAS','Alias1','Codigo',fbn('Cuenta2')))
    ELSE
        IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'FCS')
            ACT(A:15,ACT(A:15,'FCI_'~BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie'))~'_'~Copy(BuscarCampo('BOOKS','Alias1','Codigo',Dialogo.Book1),1,8)))
        ELSE
            ACT(A:15,'NoDefinido')
        ENDIF
    ENDIF    
    *DESCR A CONFIRMAR
    IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'TRANSF')
        ACT(A:16,'Cta. Com._'~BuscarCampo('CUENTAS','Alias6','Codigo',fbn('Cuenta2'))~'_'~BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie')))
    ELSE
        IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'FCS')
            ACT(A:16,'Fondos Comunes de Inversion')
        ELSE
            ACT(A:16,'NoDefinido')
        ENDIF
    ENDIF  
    *OPERATING_UNIT
    IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'TRANSF')
        ACT(A:17,BuscarCampo('CUENTAS','Alias1','Codigo',fbn('Cuenta2')))
    ELSE
        ACT(A:17,Copy(BuscarCampo('BOOKS','Alias1','Codigo',Dialogo.Book1),1,8))
    ENDIF

    *DEPTID
    IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'TRANSF')
        ACT(A:18,'')
    ELSE
        IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')),'FCS')
            ACT(A:18,BuscarCampo('OPERACIONES','Especie','NrOperacion',fbn('NrOperacionRef1')))
        ELSE
            ACT(A:18,'NoDefinido')
        ENDIF
    ENDIF      
    *CURRENCY_CD
    ACT(A:19,BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie')))
    *MERCHANDISE_AMT
    ACN(A:20,fbn('Cantidad1'))
    *RATE_MULT ANALIZAR
    ACN(A:21,IIF(Eqstr(fbn('Especie'),Var('MONELOCA')),1,IIF(Incluido(fbn('Vehiculo1'),Var('VEHDOLBI')),COTIZACIONBNA(fbn('Especie'),1,NO,NO))))
    *RT_TYPE
    ACT(A:22,'CRRNT')
    *TAX_CD_VAT
    ACT(A:23,'')
    *VAT_AMT
    ACN(A:24,0)
    *CTAX_REG
    ACT(A:25,'')
    *CTAX_ENTRD_AMT
    ACN(A:26,0)
    *PYMNT_TERMS_CD
    ACT(A:27,'CTO')
    *SCHEDULED_PAY_DT
    ACT(A:28,Fecha(FBN['Fecha2'],'dd-mm-yyyy'))
    *BANK_CD
    ACT(A:29,BuscarCampo('CLIENTES','Alias3','Codigo',BuscarCampo('CUENTAS','Comitente','Codigo',fbn('Cuenta2'))))
    *BANK_ACCT_KEY
    ACT(A:30,BuscarCampo('CUENTAS','Alias6','Codigo',fbn('Cuenta2')))
    *PYMNT_METHOD
    ACT(A:31,'WIR')
    *Descripción del banco Proveedor A CONFIRMAR
    ACT(A:32,'')
    
    *Escribo la linea a insertar en el archivo
    ACT(LN:1,Val(A:1)~';'~Val(A:2)~';'~Val(A:3)~';'~Val(A:4)~';'~Val(A:5)~';'~Val(A:6)~';'~Val(A:7)~';'~Val(A:8)~';'~Val(A:9)~';'~Val(A:10)~';'~Val(A:11)~';'~Val(A:12)~';'~Val(A:13)~';'~Val(A:14)~';'~Val(A:15)~';'~Val(A:16)~';'~Val(A:17)~';'~Val(A:18)~';'~Val(A:19)~';'~Val(A:20)~';'~Val(A:21)~';'~Val(A:22)~';'~Val(A:23)~';'~Val(A:24)~';'~Val(A:25)~';'~Val(A:26)~';'~Val(A:27)~';'~Val(A:28)~';'~Val(A:29)~';'~Val(A:30)~';'~Val(A:31)~';'~Val(A:32))
    EscribirAscii(Val(LN:1))
    Proximo
    
if val(zz:1) <> 0
    CerrarASCII
endif

Message('Evento Interfaz Comprobante Egresos finalizó correctamente.')