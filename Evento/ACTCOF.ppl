CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;NO;;;;;Fecha('11/10/2013')
FinDialogo

If Not Ok
   Cancelar
Endif

*BID Compra, ASK venta. ASK > BID
* Actualizar Cotizaciones a partir del informe
* que toma los precios de Bloombergs (Spot y Futuros)

ACT(yy:2, HORA(AHORA))
ACT(zz:2, Copy(Val(yy:2),1,2)~Copy(Val(yy:2),4,2)~Copy(Val(yy:2),7,2))
ACD(yy:3, Dialogo.Fecha1)
ACT(zz:3, Copy(Val(yy:3),1,2)~Copy(Val(yy:3),4,2)~Copy(Val(yy:3),9,2))
ACT(pl:1, VAR('PATHLOG')~'PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
ACN(tx:2, 0)
ACT(fh:1, FECHA(HOY)~' '~HORA(AHORA)~' ACTCOT')

HojaVisible(NO)

***---A: 'Especie
***---B: 'Px Last
***---C: 'Px Ask
***---D: 'Px Bid
***---E: 'Px Close

LinkearHoja('BLOOM1',1)

*- Bid es compra => Precio3 , Ask es venta = Precio2 , Last el de ayer => Precio4 y close => Precio1 es el ultimo
*- Variables
* z2 : Primera fila con contenido
* z3 : Ultima fila con contenido
* z4 : Primera Celda asignada
* z5 : Ultima Celda asignada
* z6 : Celda corriente

ACN(z2,2)
ACN(z3,1000)
ACN(bd:7, 0)

SetFilaActual(2)
ACN(z4,fac)
ACN(z5,fac)

*- Recorrer valores
Recorrer&i Val(z2),Val(z3)

   ACT(a:Val(z5), LinkH(1,a:Val(z5)))
   ACN(b:Val(z5), LinkH(1,b:Val(z5)))
   ACN(c:Val(z5), LinkH(1,c:Val(z5)))
   ACN(d:Val(z5), LinkH(1,d:Val(z5)))
   ACN(e:Val(z5), LinkH(1,e:Val(z5)))
  
   ACT(es:1, Val(a:Val(z5))) 

   If Novacio(Val(a:Val(z5))) 
       *** Contador de Leidos
       SCN(W:3,1)
   endif

   ***---Relevo si el Codigo informado (A:Val(Z:5)) existe como contrato de Futuros

   ***Bandera de Contratos 0=No hay contratos  1=Existe el Dato en Contratos
   ACN(BD:1, 0)
   * Codigo de Contrato/Especie
   ACT(Y:1, Val(A:Val(Z:5)))
   SQL.ADD("Select * from "~DBO~".CONTRATOS WHERE Codigo = '"~Val(Y:1)~"' ")
   Recorrer SQL
     ACD (Y:3, FBN['LastTradingDate']) 
     ACT(ww:1, ItemLista(FBN['Especies'],1) )
     * Bandera de Seleccion (Contrato/Futuros)
     ACN(BD:1, 1)
     * Bandera de Seleccion Update o Insert para Futuros
     acn(x:9, 0)
     ACN(x:9, SQL("SELECT 1 FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(ww:1)~"' and CallPut='FUT'  and Fecha='"~IdxDate(Dialogo.Fecha1)~"'  AND FechaEj = '"~IdxDate(Val(Y:3))~"' "))
   Proximo

   ***-- Existe el dato en Contratos (Bandera 1) - Se toma informacion leida para Cotizacion Futuros
   ***-----------------------------------------------------------------------------------------------
   IF Val(BD:1) = 1       
     If Novacio(Val(a:Val(z5))) 
        * W:4 = Contador de Contratos Futuros
        SCN(W:4,1)
     EndIf
     
****      If (Val(b:Val(z5))+Val(c:Val(z5))+Val(d:Val(z5))+Val(e:Val(z5)))<>0    Descontinuado desde 29-08-2012 
     If Val(e:Val(z5)) <> 0 
       If Val(x:9)=1          
         *- **--- Ya habia una cotizacion futura previa entonces UPDATE (X:9=1) 
         SQL.ADD("UPDATE "~DBO~".COTIZACIONES SET ")
         SQL.ADD("FechaEj='"~IdxDate(Val(Y:3))~"', ")
         SQL.ADD("Precio1="~FStr(Val(e:Val(z5)),1,8)~", ")
         SQL.ADD("Precio2="~FStr(Val(c:Val(z5)),1,8)~", ")
         SQL.ADD("Precio3="~FStr(Val(d:Val(z5)),1,8)~", ")
         SQL.ADD("Precio4="~FStr(Val(b:Val(z5)),1,8)~"  ")
         SQL.ADD("WHERE  Codigo='"~Val(ww:1)~"' and CallPut='FUT' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' AND FechaEj = '"~IdxDate(Val(Y:3))~"' ")
         SQL.NEW
         SQL.EXEC

         ***---Aca. Claves = Fecha, Codigo, FechaEj, CallPut = FUT
        
         SQL.ADD("SELECT Max(Fecha) Fecha FROM "~DBO~".COTIZACIONES ")
         SQL.ADD("WHERE Codigo = '"~Copy(Val(ww:1),1,6)~"' ")
         SQL.ADD("AND FechaEj = '"~IdxDate(Val(Y:3))~"'") 
         SQL.ADD(" AND CallPut='FUT' and Fecha < '"~idxdate(Dialogo.Fecha1)~"' ")
         recorrer SQL
           SQL.ADD(" UPDATE "~DBO~".COTIZACIONES SET ")
           SQL.ADD(" Precio1="~Fstr(Val(e:Val(z5)),0,8)~" " )
           SQL.ADD(" WHERE  Codigo='"~Copy(Val(ww:1),1,6)~"' and CallPut='FUT' ")
           SQL.ADD(" AND Fecha = '"~IdxDate(FBN('Fecha'))~"' ")
           SQL.ADD("  AND FechaEj = '"~IdxDate(Val(Y:3))~"' ")
           SQL.NEW
           SQL.EXEC
         proximo
       Else   
         *- **--- No habia una cotizacion futura previa entonces INSERT (X:9<>=1)      
         SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
         SQL.ADD("(Fecha, Codigo, FechaEj ,CallPut, Precio1,Precio2,Precio3,Precio4) ")
         SQL.ADD(" VALUES ('"~IdxDate(Dialogo.Fecha1)~"', '"~Copy(Val(ww:1),1,6)~"', '"~IdxDate(Val(Y:3))~"', 'FUT', ")
         SQL.ADD(" "~Fstr(Val(e:Val(z5)),0,8)~","~Fstr(Val(c:Val(z5)),0,8)~","~Fstr(Val(d:Val(z5)),0,8)~","~Fstr(Val(b:Val(z5)),0,8)~" )")
         SQL.NEW
         SQL.EXEC
            
         ***---Aca. Claves = Fecha, Codigo, FechaEj, CallPut = FUT
        
         SQL.ADD("SELECT Max(Fecha) Fecha FROM "~DBO~".COTIZACIONES ")
         SQL.ADD("WHERE Codigo = '"~Copy(Val(ww:1),1,6)~"' ")
         SQL.ADD("AND FechaEj = '"~IdxDate(Val(Y:3))~"'") 
         SQL.ADD(" AND CallPut='FUT' and Fecha < '"~idxdate(Dialogo.Fecha1)~"' ")
         recorrer SQL
           SQL.ADD(" UPDATE "~DBO~".COTIZACIONES SET ")
           SQL.ADD(" Precio1="~Fstr(Val(e:Val(z5)),0,8)~" " )
           SQL.ADD(" WHERE  Codigo='"~Copy(Val(ww:1),1,6)~"' and CallPut='FUT' ")
           SQL.ADD(" AND Fecha = '"~IdxDate(FBN('Fecha'))~"' ")
           SQL.ADD("  AND FechaEj = '"~IdxDate(Val(Y:3))~"' ")
           SQL.NEW
           SQL.EXEC
         proximo

       Endif    
       * --- No se considera el dato si llega cotizacion de Bloomberg en 0 (para los 4 campos)  
       Else
         If Novacio(Val(a:Val(z5))) O Not EqStr(Val(a:Val(z5)), 'Especie') O Not EqStr(Val(a:Val(z5)), ' ') 
            * W:9 = Contador de Ignorados
            SCN(W:9,1)  
            
            If Val(bd:7)=0
              AbrirAscii(Val(pl:1),0)    
              EscribirAscii(Val(fh:1))
              ACN(tx:2,9)
              (.'MENSAJETXT'.)
              ACN(bd:7, 1)
            Else 
              ACN(tx:2,9)
             (.'MENSAJETXT'.)
           EndIf
         EndIf     
       Endif

   ELSE
   ***-- No Existe el dato en Contratos (Bandera 0) - Se toma informacion leida para Cotizacion SPOT ***************************************************
   ***-------------------------------------------------------------------------------------------------------------------------------------------------- 
     If Novacio(Val(a:Val(z5))) 
        * W:5 = Contador de Cotizaciones Spot
        SCN(W:5,1)
        ACN(x:4,0)  
     EndIf          
      
     If SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(a:Val(z5))~"' ")=1 Y Novacio(Val(a:Val(z5)))
****   If (Val(b:Val(z5))+Val(c:Val(z5))+Val(d:Val(z5))+Val(e:Val(z5)))<>0                          Descontinuado desde 29-08-2012 
       If Val(e:Val(z5)) <> 0 
         Message('Actualizando Cotizacion: '~Val(E:Val(z5)))
         * Calcula el Promedio de Monedas                                                 *** Rutina Descontinuada                                     
         *if DesciendeDeEspecie(Val(a:Val(Z:5)),'MONEDA') y EsTerminal(Val(a:Val(Z:5)), Especie)
         *   ACN(x:4,1)
         *    ACN ( e:Val(Z:5),(Val(c:Val(Z:5)) + Val(d:Val(Z:5))) / 2  )             
         *endif 
         *- Buscar Cotizacion Contado de hoy para ver si UPDATE o INSERT
         ACN(x:3,SQL("SELECT Count(*) FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(a:Val(z5))~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))

         *- Actualizar Precio  *- Precio1: Close Precio2: Ask Precio3: Bid Precio4: Last
         If Val(x:3)=1 
           SQL.ADD("UPDATE "~DBO~".COTIZACIONES SET ")           
           If Val(x:4)=0
                SQL.ADD("Precio1="~FStr(Val(E:Val(z5)),1,8)~", ")
                SQL.ADD("Precio2="~FStr(Val(C:Val(z5)),1,8)~", ") 
                SQL.ADD("Precio3="~FStr(Val(D:Val(Z:5)),1,8)~", ")                
                SQL.ADD("Precio4="~FStr(Val(b:Val(Z:5)),1,8)~"  ")
           Else
                SQL.ADD("Precio2="~FStr(Val(C:Val(z5)),1,8)~", ")
                SQL.ADD("Precio3="~FStr(Val(D:Val(Z:5)),1,8)~" ") 
           EndIf        
           ACN(x:4,0)        
           SQL.ADD("WHERE  Codigo='"~Copy(Val(a:Val(z5)),1,6)~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")
           SQL.NEW
           SQL.EXEC
                  
         Else
         *- Insertar registro : PAPELES Y MONEDAS (MAYO 2012) 
           If Val(x:4)=0
               SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
               SQL.ADD("(Fecha, Codigo, CallPut, Precio1,Precio2,Precio3,Precio4) ")
               SQL.ADD(" VALUES ('"~IdxDate(Dialogo.Fecha1)~"', '"~Copy(Val(a:Val(Z:5)),1,6)~"', 'CON', ")
               SQL.ADD(" "~Fstr(Val(E:Val(Z:5)),0,8)~","~Fstr(Val(C:Val(Z:5)),0,8)~","~Fstr(Val(D:Val(Z:5)),0,8)~","~Fstr(Val(B:Val(Z:5)),0,8)~" )")
               SQL.NEW
               SQL.EXEC
           *- Insertar registro : MONEDAS (Descontinuado)
           Else
               SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
               SQL.ADD("(Fecha, Codigo, CallPut, Precio2,Precio3) ")
               SQL.ADD(" VALUES ('"~IdxDate(Dialogo.Fecha1)~"', '"~Copy(Val(a:Val(Z:5)),1,6)~"', 'CON', ")
               SQL.ADD("  "~Fstr(Val(C:Val(Z:5)),0,8)~","~Fstr(Val(D:Val(Z:5)),0,8)~" )")
               SQL.NEW
               SQL.EXEC
               ACN(x:4,0) 
           EndIf             
         ***---NO OPERATIVO ACTUALIZAR DIA ANTERIOR       
         Endif
 
  
       Else
        * --- No se considera el spot si llega cotizacion de Bloomberg en 0 (para los 4 campos) 
          If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie') O Not EqStr(Val(a:Val(z5)), '')
             * W:9 = Contador de Ignorados
             SCN(W:9,1) 
             If Val(bd:7)=0
                AbrirAscii(Val(pl:1),0)    
                EscribirAscii(Val(fh:1))
                ACN(tx:2,9)
                (.'MENSAJETXT'.)
                ACN(bd:7, 1)
             Else 
                ACN(tx:2,9)
                (.'MENSAJETXT'.)
             EndIf
          Endif
       EndIf
 
    Else
      If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie')
        If Val(bd:7)=0
          AbrirAscii(Val(pl:1),0)    
          EscribirAscii(Val(fh:1))
          ACN(tx:2,1)
          (.'MENSAJETXT'.)
          ACN(bd:7, 1)
        Else
          ACN(tx:2,1)
          (.'MENSAJETXT'.)
        EndIf
      EndIf     
    EndIf
   
   ENDIF 

   SCN(z5,1)
Proximo

CerrarASCII
CerrarHoja('BLOOM1',1)

ACT(ME:1, Var('MONEEXTR'))
ACT(MU:1, Var('MONEURU'))

***---MIRAR CONCOT para el UYU y si tenemos que invertir o no Precio2 con Precio3
IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~Val(ME:1)~"' AND (CallPut='CON' or CallPut is Null) and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ") = 1
    IF SQL(" Select 1 From "~DBO~".CIERREBCU Where Especie = '"~Val(ME:1)~"' AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ") = 1
        ***---Genero Cotizacion del UYU en ARP
        ACN(CT:1, CotizacionBNABCU(Var('MONEEXTR'),Dialogo.Fecha1,1,NO,NO))
        IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~Val(MU:1)~"' AND (CallPut='CON' or CallPut is Null) and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ") = 1            
            SQL.ADD(" UPDATE "~DBO~".COTIZACIONES SET ")
            SQL.ADD(" Precio1 = "~Fstr(Val(CT:1),1,8)~", ")
            SQL.ADD(" Precio2 = "~Fstr(0,1,8)~", ")          
            SQL.ADD(" Precio3 = "~Fstr(0,1,8)~", ")
            SQL.ADD(" Precio4 = "~Fstr(0,1,8)~"  ")
            SQL.ADD(" Where Codigo = '"~Val(MU:1)~"' ")
            SQL.ADD(" AND (CallPut='CON' or CallPut is Null) ")
            SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.NEW
        ELSE
            SQL.ADD(" INSERT INTO "~DBO~".COTIZACIONES ")
            SQL.ADD(" (Fecha, Codigo, CallPut, Precio1,Precio2,Precio3,Precio4) ")
            SQL.ADD(" VALUES ('"~IdxDate(Dialogo.Fecha1)~"', '"~Val(MU:1)~"', 'CON', ")
            SQL.ADD(" "~Fstr(Val(CT:1),0,8)~","~Fstr(0,0,8)~","~Fstr(0,0,8)~","~Fstr(0,0,8)~" )")
            SQL.NEW
        ENDIF
        SQL.EXEC
    ENDIF
ENDIF

***---Conversion de Cotizaciones. Calculo de Precios en USD, ARP y UYU
EjecutarEvento('CONCOT', Fecha1=Dialogo.Fecha1, Check1=1)


MessageBox('Cotizaciones actualizadas')