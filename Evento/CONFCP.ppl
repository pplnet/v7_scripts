* Este evento es invocado desde CONFCO y CONFPA
* Si Radio1=0, instancia 7 (conf. de Cobros)
* Si Radio1=1, instancia 6 (conf. de Pagos) 
*HojaVisible(SI)
CrearDialogo
  Radio1   : 'Tipo de Accion|Cobros|Pagos';;;;;;;;;0
  Radio2   : 'Confirmar:|Solo Fecha Liq.|Hasta Fecha Liq.';;;;;;;;;1
  Fecha1   : 'Fecha Liq.';;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
  Fecha2   : 'Fecha Conf.';;;;;;Dialogo.Fecha2>0;'Fecha incorrecta';NO;FSys;
  Mercado1 : 'Mercado'   ;
  Especie1 : 'Especie'   ;
  Cliente1 : 'Cliente'   ;
  Vehiculo1: 'Vehiculo'  ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
FinDialogo
if Not Ok
  Cancelar
endif

ACT(y1, Fecha(FSys, 'YYYY.MM.DD'))

if NoVacio(Dialogo.Especie1)
  ACT(zz1," '")
  SQL.ADD("Select * from "~DBO~".ESPECIES" )
  recorrer SQL
    if DesciendeDeEspecie(FBN['Codigo'],Dialogo.Especie1)
      ACT(zz1,val(zz1)~FBN['Codigo']~"','" )
    endif
  proximo
  ACT(zz1,val(zz1)~"' ")
  SetFilaActual(0)
endif

*********************
* Confirmacion de C/P
*********************
SQL.ADD("Select T.Mercado1, T.TipoTr2, T.Cliente1, T.CB5, T.NrOperacionRef1, ")
SQL.ADD("T.NrTrans, T.Especie, T.Cantidad1, T.Fecha2, T.Cuenta1, ")
SQL.ADD("T.Cuenta2, T.Especie1, T.Cantidad2, T.Cupon1, T.CB6, ")
SQL.ADD("T.CB7, T.CB8 ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where T.NrTrans = B.NrOperacion")
SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and (T.CB9 = '0' or T.CB9 is NULL) ")
SQL.ADD("and  T.CB10 = '1' ")
SQL.ADD("AND T.Mercado1 <> '"~Var('MERCOCT')~"' ")
SQL.ADD("and ")
SQL.ADD("( ")
SQL.ADD("  ( ")
if Dialogo.Radio2=0
  SQL.ADD("    T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
else
  SQL.ADD("    T.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
endif
SQL.ADD("    and IsNull(T.CB3,'0') = '0' ")
SQL.ADD("  ) ")
SQL.ADD("  or ")
SQL.ADD("  ( ")
SQL.ADD("    T.Fecha2 < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and T.CB3 = '1' ")
SQL.ADD("    and Not T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and Convert(Char,I.Fecha,102) = '"~Val(y1)~"') ")
SQL.ADD("  ) ")
SQL.ADD(") ")
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and T.Mercado1 = '"~Dialogo.Mercado1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and (T.Especie = '"~Dialogo.Especie1~"' or T.Especie In ("~val(zz1)~") )")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if Dialogo.Radio1=0
  SQL.ADD("and B.NrBit = 7 ")
else
  SQL.ADD("and B.NrBit = 6 ")
endif
SQL.ADD("and B.Valor = '1'")
SQL.ADD("Order By 1, 7, 3")


recorrer SQL;;SI
  ACT(aa:FAC, FBN['NrTrans'])
  ACT(ab:FAC, FBN['TipoTr2'])
  ACT(ac:FAC, FBN['Mercado1'])
  ACT(ad:FAC, FBN['Cliente1'])
  ACT(ae:FAC, FBN['Especie'])
  ACN(af:FAC, FBN['Cantidad1'])
  ACT(ag:FAC, FBN['Cuenta1'])
  ACT(ah:FAC, FBN['Cuenta2'])
  ACT(ai:FAC, FBN['Especie1'])
  ACN(aj:FAC, FBN['Cantidad2'])
  ACT(ak:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(aa:FAC)~"'      and Especie = '"~Val(ae:FAC)~"'"))
  ACT(al:FAC, FBN['Cupon1'])

  ACT(a:FAC, FBN['Cliente1'])
  ACT(b:FAC, FBN['Mercado1'])
  ACT(c:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(aa:FAC)~"'      and Especie = '"~Val(ae:FAC)~"'"))
  ACT(h:FAC, ' ')
  if EqStr(FBN['TipoTr2'],'MATCH')
    ACT(d:FAC, 'Matcheo')
    ACT(e:FAC, FBN['Especie']~'/'~FBN['Especie1'])
    ACN(f:FAC, -FBN['Cantidad1'])
    ACN(g:FAC, -FBN['Cantidad2'])
    ACT(h:FAC, ' ')
  else
    if Incluido(FBN['TipoTr2'],'FXDEP|FXRET')
      ACT(e:FAC, FBN['Especie'])
      if EqStr(FBN['TipoTr2'],'FXDEP')
        ACT(d:FAC, 'Cobro')
        if DesciendeDeEspecie(FBN['Especie'],'TITULO')
          ACN(f:FAC, FBN['Cantidad1'])
          ACN(g:FAC, 0)
        else
          ACN(f:FAC, 0)
          ACN(g:FAC, FBN['Cantidad1'])
        endif
      else
        ACT(d:FAC, 'Pago')
        if DesciendeDeEspecie(FBN['Especie'],'TITULO')
          ACN(f:FAC, -FBN['Cantidad1'])
          ACN(g:FAC, 0)
        else
          ACN(f:FAC, 0)
          ACN(g:FAC, -FBN['Cantidad1'])
        endif
      endif
      if FBN['CB6']+FBN['CB7']+FBN['CB8']>1
        ACT(h:FAC, 'Error')
      else
        if FBN['CB6']=1
          ACT(h:FAC, 'DVP')
        endif
        if FBN['CB6']=1
          ACT(h:FAC, 'RVP')
        endif
        if FBN['CB6']=1
          ACT(h:FAC, 'Conf')
        endif
      endif
    else
      ACT(d:FAC, 'Error')
    endif
  endif
  ACT(i:FAC, FBN['NrTrans'])
  ACD(j:FAC, FBN['Fecha2'])
  ACD(db:FAC, Dialogo.Fecha2)
  ACN(dc:FAC, val(g:fac))
  ACN(p:FAC, 0)

  SQL.ADD("Select NrOperacion from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD(" where NrTrans2     = '"~Val(i:fac)~"' ")
  SQL.ADD("   and NrOperacion <> '"~Val(i:fac)~"' ")
  recorrer SQL
    dfa
    ACT(da:fac, fbn('NrOperacion'))
  proximo
proximo

ACO(1,9)
ACO(2,4)
ACO(3,3)
ACO(4,7)
ACO(5,9)
ACO(6,12)
ACO(7,12)
ACO(8,4)
ACO(9,7)
ACO(10,9)
FormatoCeldas(f:1..g:FAC,Exe('F2'))

if FAC>0
  CrearListBox ; 'Arial,8,';'CONFIRMACION de Cobros/Pagos OCT'
    'Cliente'         ; a1..a:fac ;NO;;;70;STRING;;Exe('COLOR6');
    'Leyenda'         ; d1..d:fac ;NO;;;70;STRING;;Exe('COLOR6');
    'Especie'         ; e1..e:fac ;NO;;;70;STRING;;Exe('COLOR6');
    'Cantidad'        ; g1..g:fac ;NO;;;90;NUMERO;'###,###,###,###.##';Exe('COLOR6');
    'Cant.a Confirmar';dc1..dc:fac;SI;[Val(g:FLB)<0 y Val(g:FLB)<=Val(dc:FLB) y Val(dc:FLB)<0] o [Val(g:FLB)>0 y Val(g:FLB)>=Val(dc:FLB) y Val(dc:FLB)>0] o Val(p:FLB)=0;'Cantidad a Confirmar Erronea';90;NUMERO;'###,###,###,###.##';;
    'Voucher'         ; i1..i:fac ;NO;;;70;STRING;;Exe('COLOR6');
    'Instruccion'     ;ag1..ag:fac;  ;SI;'Error'; 80;TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';" Cliente = '"~val(a:flb)~"' and Estado = 'HAB' ";
    'Cta.Propia'      ;ah1..ah:fac;  ;NoVacio(val(ah:FLB));'Debe Ingresar una Cuenta Propia'; 80;TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';" Cliente = '"~Var('VEHICULODE')~"' and Estado = 'HAB' and TipoCuenta = 'CCO' ";
    'Ok'              ; p1..p:fac ;  ;;;30;CHECK;Exe('COLOR3');;;;;;NO;;
    'Falla'           ;da1..da:fac;NO;;;70;STRING;;Exe('COLOR6');
    'Fecha'           ; j1..j:fac ;NO;;;60;FECHA;Exe('COLOR6');
    'F.Confir'        ;db1..db:fac;NO;;;60;FECHA;Exe('COLOR6');
    'Mercado'         ; b1..b:fac ;NO;;;50;STRING;;Exe('COLOR6');
  FinListBox

  if Ok
    recorrer&i 1,fac
*      MessageBox(Val(i:&i)~' '~FStr(Val(p:&i),1,0))
      if Val(p:&i) = 1
         *** veo si se confirma parcial o totalmente ****
         SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
         SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
         if Dialogo.Radio1 = 0
            SQL.ADD(" and NrInstancia = 7 ")
           else
            SQL.ADD(" and NrInstancia = 6 ")
         endif
         SQL.NEW
                  
         SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
         SQL.ADD("NrOperacion, NrInstancia, Usuario, Mensaje, Fecha ")
         SQL.ADD(") Values (")
         SQL.ADD("'"~Val(i:&i)~"', ")
         if Dialogo.Radio1 = 0
            SQL.ADD("7, ")
           else
            SQL.ADD("6, ")
         endif
         SQL.ADD("'"~UsuarioActivo~"', ")
         if Round(val(g:&i),2) = Round(val(dc:&i),2)
            SQL.ADD("'Confirmacion de Voucher', ")
           else
            SQL.ADD("'Generacion de Falla Parcial', ")
         endif
         SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
         SQL.ADD(")")
         SQL.NEW

         SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
         SQL.ADD("   Set CB9     = '1', ")
         SQL.ADD("       Fecha3  = '"~IdxDate(val(db:&i))~"', ")
         SQL.ADD("       Cantidad3   = "~FStr((Val(g:&i)-Val(dc:&i)),1,2)~", ")
         SQL.ADD("       Cantidad4   = "~FStr(Val(dc:&i),1,2)~", ")
         SQL.ADD("       Cuenta1 = '"~val(ag:&i)~"', ")
         SQL.ADD("       Cuenta2 = '"~val(ah:&i)~"' ")
         SQL.ADD(" Where NrTrans = '"~Val(i:&i)~"' ")
         SQL.NEW

         SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD("   Set Valor       = '0' ")
         SQL.ADD(" where NrOperacion = '"~Val(i:&i)~"' ")
         if Dialogo.Radio1 = 0
            SQL.ADD(" and NrBit       = 7 ")
           else
            SQL.ADD(" and NrBit       = 6 ")
         endif
         SQL.NEW
                  
         SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD("   Set Valor       = '1' ")
         SQL.ADD(" where NrOperacion = '"~Val(i:&i)~"' ")
         SQL.ADD("   and NrBit       = 2 ")
         SQL.NEW

         *** marca la falla como confirmada ****
         SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
         SQL.ADD("   Set CB2     = '1', ")
         SQL.ADD("       Fecha3  = '"~IdxDate(val(db:&i))~"' ")
         SQL.ADD(" Where NrTrans = '"~Val(da:&i)~"' ")
         SQL.NEW
                  
         *** pasa la falla a envio ED ***
         SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD("   SET Valor       = '0' ")
         SQL.ADD(" where NrOperacion = '"~Val(da:&i)~"' ")
         SQL.ADD("   and NrBit       = 5 ")
         SQL.NEW

         SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD("   Set Valor       = '1' ")
         SQL.ADD(" where NrOperacion = '"~Val(da:&i)~"' ")
         SQL.ADD("   and NrBit       = 33 ")
         SQL.NEW
         SQL.EXEC

         *** genera los mov de cashflow y limites que desafectan la falla ****
         ModificarOperacion(Val(da:&i),0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,SI,NO,NO,NO,1)

         if Round(val(g:&i),2) <> Round(val(dc:&i),2)
            ACT(dd:&i, GetNumerador(13))
            SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD("   SET NrTransRef1 = '"~Val(dd:&i)~"' ")
            SQL.ADD(" Where NrTrans = '"~Val(i:&i)~"' ")
            SQL.NEW
 
            Message('Genera Transporte '~Val(b:12))
            SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")

            SQL.ADD("TipoTr2, Especie, Fecha1, Fecha2, Fecha4, Cliente1, ")
            SQL.ADD("Cantidad1, Vehiculo1, Mercado1, Observaciones, NrTransRef1, ")
            SQL.ADD("Cuenta1, Cuenta2, NrTrans, ")
            SQL.ADD("FechaCarga, FechaCargaSys, UsrInput ")
            SQL.ADD(") Values (")

            SQL.ADD("'TRANSP', '"~Val(e:&i)~"', '"~IdxDate(FSys)~"', '"~IdxDate(Val(db:&i))~"', ")
            SQL.ADD("'"~IdxDate(Val(db:&i))~"', '"~Val(a:&i)~"', ")

            SQL.ADD(""~FStr((Val(g:&i)-Val(dc:&i)),1,2)~", '"~Var('VEHICULODE')~"', '"~Val(b:&i)~"', ")
            SQL.ADD("'"~'Transporte Parcial '~Val(i:&i)~"', '"~Val(i:&i)~"', ")

            SQL.ADD("'"~Val(ag:&i)~"', '"~Val(ah:&i)~"', '"~Val(dd:&i)~"' ")
            SQL.ADD(" ,"~SQLAhora~", "~IdxDate2(FSys)~", '"~UsuarioActivo~"' ")
            SQL.ADD(")")
            SQL.NEW

            **** Message('Genera Instancias Transporte '~Val(b:12))
            SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
            SQL.ADD("(NrBit, NrOperacion, Valor) ")
            SQL.ADD(" Select NrInstancia, '"~Val(dd:&i)~"', '0'")
            SQL.ADD("   from "~DBO~".INSTANCIAS ")
            SQL.ADD("  where Tabla = 'TRANSACCIONES2'")
            SQL.NEW

            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
            SQL.ADD("   Set Valor       = '1' ")
            SQL.ADD(" Where NrBit       = 5 ")
            SQL.ADD("   and NrOperacion = '"~Val(dd:&i)~"' ")
            SQL.NEW

            ***** Message('Genera MovPendiente Transporte '~Val(b:12))
            SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")

            SQL.ADD("FechaMov, Cliente, Especie, EnteCustodia, Cantidad, ")
            SQL.ADD("Leyenda, NrSaldo, NrMov, NrGrupo, Bits, ")
            SQL.ADD("Status, Mercado, Concepto, Cuenta, ")
            SQL.ADD("NrOperacion ")

            SQL.ADD(") Values (")
            SQL.ADD("'"~IdxDate(Val(db:&i))~"', '"~Val(a:&i)~"', '"~Val(e:&i)~"', ")
            SQL.ADD("'"~Var('VEHICULODE')~"', "~FStr(-(Val(g:&i)-Val(dc:&i)),1,2)~", ")
            SQL.ADD("'"~'Transporte Parcial '~Val(i:&i)~"', "~FStr(1,1,0)~", ")
            SQL.ADD(""~FStr(1,1,0)~", "~FStr(1,1,0)~", 'MV', ")

            SQL.ADD("'', '"~Val(b:&i)~"', 'OCT', '"~Val(ag:&i)~"', ")
            SQL.ADD("'"~Val(dd:&i)~"' ")
            SQL.ADD(")")
            SQL.NEW
            SQL.EXEC

            Message('Modificar Operacion Transporte '~Val(dd:&i))
            ModificarOperacion(Val(dd:&i),0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,SI,NO,NO,NO,1)
         endif
      endif
    proximo
  endif
else
  if Dialogo.Radio1 = 0
    MessageBox('No hay Cobros para Confirmar.')
  else
    MessageBox('No hay Pagos para Confirmar.')
  endIf
  Cancelar
endif

