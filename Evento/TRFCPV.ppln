fecha1:'F.Transf';1;1;;;;dialogo.fecha1 <= FSys();'Debe Ingresar una Fecha';NO;FSys()
fecha2:'F.Dividendo';1;2;;;;dialogo.fecha1 <= FSys();'Debe Ingresar una Fecha';NO;FSys()
especie1:'Especie';3;1;;;;DesciendeDeEspecie(dialogo.especie1, 'FONDOS');'Debe Ingresar una Especie de Fondos';NO;;;;;;" Codigo IN("~Pipe2Comillas(Descendientes('ESPECIES', 'FONDOS'))~") "
vehiculo1:'De Vehiculo';5;1;;;;NoVacio(dialogo.vehiculo1) y Eqstr(BuscarCampo('Vehiculos', 'TipoVehiculo', 'Codigo', dialogo.vehiculo1), 'DIV') y not Eqstr(dialogo.vehiculo1, dialogo.vehiculo2);'Vehiculo Origen Invalido';NO;;;;;;" TipoVehiculo = 'DIV' "
vehiculo2:'A Vehiculo';5;2;;;;NoVacio(dialogo.vehiculo2) y Eqstr(BuscarCampo('Vehiculos', 'TipoVehiculo', 'Codigo', dialogo.vehiculo2), 'DIV');'Vehiculo Destino Invalido';NO;;;;;;" TipoVehiculo = 'DIV' "
cliente1:'De Banco';7;1;;;;Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente1), 'HAB');'Banco Origen Invalido';NO;;BuscarCampo('ESPECIES', 'Issuer', 'Codigo', dialogo.especie1);;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES', 'BANCOS'))~") and Status = 'HAB' ";
cliente2:'A Banco';7;2;;;;Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente2), 'HAB');'Banco Destino Invalido';NO;;BuscarCampo('ESPECIES', 'Issuer', 'Codigo', dialogo.especie1);;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES', 'BANCOS'))~") and Status = 'HAB' ";
cuenta1:'De Cuenta';9;1;;;;Eqstr(BuscarCampo('CUENTAS', 'Comitente', 'Codigo', dialogo.cuenta1), dialogo.cliente1) y Eqstr(BuscarCampo('CUENTAS', 'Cliente', 'Codigo', dialogo.cuenta1), dialogo.vehiculo1);'Cuenta Origen Invalida';NO;;;;;;" Cliente = '"~dialogo.vehiculo1~"' and Estado='HAB' and (Especies LIKE '%"~dialogo.especie1~"%' or Especies LIKE '%FONDOS%') AND Comitente = '"~dialogo.cliente1~"' ")
cuenta2:'A Cuenta';9;2;;;;Eqstr(BuscarCampo('CUENTAS', 'Comitente', 'Codigo', dialogo.cuenta2), dialogo.cliente2) y Eqstr(BuscarCampo('CUENTAS', 'Cliente', 'Codigo', dialogo.cuenta2), dialogo.vehiculo2);'Cuenta Origen Invalida';NO;;;;;;" Cliente = '"~dialogo.vehiculo2~"' and Estado='HAB' and (Especies LIKE '%"~dialogo.especie1~"%' or Especies LIKE '%FONDOS%') AND Comitente = '"~dialogo.cliente2~"' ")
