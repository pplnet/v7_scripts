Sqladd(" Select NrOperacion ")
Sqladd(" From "~Dbo()~".OPERACIONES ")
Sqladd(" Where TipoOp = 'TRANFC' ")
Sqladd(" AND Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND FechaOp = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND Vehiculo2 = '"~dialogo.vehiculo2~"' ")
Sqladd(" AND CB7 = '1' ")
recorrer sql
Cancelar('Ya se realizo en la fecha una transferencia de '~dialogo.especie1~' de '~dialogo.vehiculo1~' a '~dialogo.vehiculo2)
proximo

Acn(bd:1, 0)
Sqladd(" Select O.NrOperacion, O.OperacionRef, TotalBrutoCli1 ")
Sqladd(" From "~Dbo()~".OPERACIONES O ")
Sqladd(" Where O.TipoOp = 'DIVIDE' ")
Sqladd(" AND O.FechaOp = '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND O.TipoOp In ('DIVIDE') ")
Sqladd(" AND O.MB3 = 1 ")
Sqladd(" AND O.MB4 = 4 ")
Sqladd(" AND O.TipoCambio3 = 101 ")
Sqladd(" AND O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND O.Vehiculo2 = '"~dialogo.vehiculo2~"' ")
Sqladd(" AND O.Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND O.Book1 = '"~dialogo.book1~"' ")
Sqladd(" Order By O.NrOperacion ")
recorrer sql
