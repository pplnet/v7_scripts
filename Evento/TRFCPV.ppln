Sqladd(" INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd(" (TipoOp, NrOperacion, Especie, ")
Sqladd(" Vehiculo1, Vehiculo2, Cantidad, Numerador, ")
Sqladd(" FechaOp, FechaCarga, FechaCargaSys, ")
Sqladd(" UsrInput, Operador, FechaVto, Cliente1, ")
Sqladd(" Cliente2, Cuenta4, Cuenta1, Book1, ")
Sqladd(" Book2, MB3, ContraEspecie, FechaPago, ")
