Sqladd(" '"~dialogo.vehiculo1~"', '"~dialogo.vehiculo2~"', "~FStr(Val(c:&k), 0, 2)~", "~FStr(Val(nm:1), 0, 0)~", ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', "~SQLAhora()~", '"~IdxDate(FSys())~"', ")
Sqladd(" '"~UsuarioActivo()~"', '"~UsuarioActivo()~"', '"~IdxDate(dialogo.fecha1)~"', '"~dialogo.cliente1~"', ")
