Message('--- Asientos por Cambio de Book ---')

Sqladd(" SELECT O.NrOperacion, O.BookAnterior, O.Book1, O.FechaCambioBook, O.FechaCarga , O.FechaOp,O.TotalBrutoCli1, O.ContraEspecie, ")
Sqladd(" O.Vehiculo1,O.Especie,O.Cuenta2 as CuentaCustodia,O.TipoOp, O.FechaVto, O.Precio1 PrecioOp,E.MonedaEmision, ")
Sqladd(" O.Cantidad,O.Plazo,M.Codigo CodAsi,O.Cliente1,O.Cliente1 Cliente,E.Tipo TipoEspecie,O.Cupon1,E.Cotiza,E.Issuer ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O,MODELOSASIENTO M,ESPECIES E ")
Sqladd(" Where O.Especie=E.Codigo and O.FechaCambioBook= '"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd(" AND ((O.FechaCambioBook>O.FechaOp and O.FechaOp>=O.FechaCargaSys) or(O.FechaOp<O.FechaCargaSys and O.FechaCambioBook>O.FechaCargaSys)) ")
Sqladd(" and ( O.FechaAnulacionCambioBook is null OR O.FechaCambioBook<>O.FechaAnulacionCambioBook OR ( ")
Sqladd("  O.FechaCambioBook=O.FechaAnulacionCambioBook AND BookAnterior is not null))AND O.TipoOp = M.TipoOp AND ")
Sqladd(" TipoAsiento = '"~Var('TIPASCAMBK')~"' AND '|'+rtrim(Vehiculo)+'|' like '%|"~dialogo.vehiculo1~"|%' AND Habilitado = 'SI' ")

recorrer sql
Acd(fv:1, dialogo.fecha1)
Act(bk:1, Fbn('BookAnterior'))
Act(bk:2, Fbn('Book1'))
Act(mn:99, Fbn('ContraEspecie'))

if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select A.NrUnicoAsiento from "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND  A.Modelo = '"~Fbn('CodAsi')~"' AND A.Estado IN ('E','A') AND A1.Alias1 = '"~Fbn('Especie')~"' AND A.Vehiculo = '"~Fbn('Vehiculo1')~"' AND A.Fecha1 = '"~IdxDate(Val(fv:1))~"' AND A1.Alias2 = '"~Val(bk:1)~"' AND (A.NrOperacion = '' OR A.NrOperacion = ' ' OR A.NrOperacion Is Null) ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Val(op:1)~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), null, null, Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
Acd(fv:3, Val(fv:1))
Act(ta:1, Var('TIPASIRETO'))
Sqladd(" Select FechaValor,NrUnicoAsiento ")
Sqladd(" From "~Dbo()~".ASIENTOSCON A, MODELOSASIENTO M ")
Sqladd(" Where A.Modelo = M.Codigo ")
Sqladd(" AND A.NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" And M.TipoAsiento = '"~Val(ta:1)~"'")
Sqladd(" AND '"~Fbn('Book1')~"' IN ("~Pipe2Comillas(&bvaluapartida)~")")
Sqladd(" AND (A.Estado is NULL OR A.Estado = '' OR A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
Sqladd(" Group By FechaValor,NrUnicoAsiento ")
recorrer sql
Act(as:1, Fbn('NrUnicoAsiento'))
Ejecutarevento('CONT46', 'fecha1', dialogo.fecha1, 'nrunicoasiento1', Val(as:1), 'fecha2', Val(fv:3), 'radio1', 0)
proximo

proximo


if (NO)
Message('--- Asientos por Reclasificación de Revalúo ---')

Sqladd(" SELECT O.NrOperacion, O.BookAnterior, O.Book1, O.FechaCambioBook, O.FechaCarga , O.FechaOp,O.TotalBrutoCli1, O.ContraEspecie, ")
Sqladd(" O.Vehiculo1,O.Especie,O.Cuenta2 as CuentaCustodia,O.TipoOp, O.FechaVto, O.Precio1 PrecioOp,E.MonedaEmision, ")
Sqladd(" O.Cantidad,O.Plazo,M.Codigo CodAsi,O.Cliente1,O.Cliente1 Cliente,E.Tipo TipoEspecie,O.Cupon1,E.Cotiza,E.Issuer ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O,MODELOSASIENTO M,ESPECIES E ")
Sqladd(" Where O.Especie=E.Codigo and O.FechaCambioBook= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND ((O.FechaCambioBook>O.FechaOp and O.FechaOp>=O.FechaCargaSys) or(O.FechaOp<O.FechaCargaSys and O.FechaCambioBook>O.FechaCargaSys)) ")
Sqladd(" and (O.FechaAnulacionCambioBook is null OR O.FechaCambioBook<>O.FechaAnulacionCambioBook OR ( ")
Sqladd(" O.FechaCambioBook=O.FechaAnulacionCambioBook AND BookAnterior is not null)) AND O.TipoOp = M.TipoOp AND")
Sqladd(" TipoAsiento = '"~Var('TIPASRECLA')~"' AND '|'+rtrim(Vehiculo)+'|' like '%|"~dialogo.vehiculo1~"|%' AND Habilitado = 'SI' AND")
Sqladd(" (O.BookAnterior Not IN ("~Pipe2Comillas(&bvaluapartida)~") AND O.Book1 IN ("~Pipe2Comillas(&bvaluapartida)~"))")

recorrer sql
Acn(nf:1, 0)
Acn(df:1, 0)
Acn(nf:2, 0)
Acn(rv:1, 0)
Acn(rv:2, 0)
Acn(dp:1, 0)
Acn(da:1, 0)
Act(fv:2, Fbn('FechaVto'))
Act(vh:1, Fbn('Vehiculo1'))
Acd(fo:1, Fbn('FechaOp'))
Act(bk:1, Fbn('BookAnterior'))
Act(bk:2, Fbn('Book1'))
Acd(fv:1, dialogo.fecha1)
Act(cp:99, Fbn('Cupon1'))
Act(me:1, Fbn('MonedaEmision'))
Act(mn:99, Fbn('ContraEspecie'))

let(&fechaop, Fbn('FechaOp'))
let(&fechavto, Fbn('FechaVto'))
let(&precioop, Fbn('PrecioOp'))
let(&especie, Fbn('Especie'))
let(&book, Fbn('Book1'))
let(&cantidad, Fbn('Cantidad'))
let(&monedadelcotizador, Fbn('Cotiza'))
let(&monedaprecioop, Fbn('ContraEspecie'))
let(&monedadelrevaluo, Val(ml:1))
let(&plazo, Fbn('Plazo'))
recorrer&i Fbn('FechaOp'), Fbn('FechaCambioBook') - 1
if (EsHabil(Fecha(&i)))
let(&fecharevaluo, Fecha(&i))
Acd(fv:1, &fecharevaluo)
let(&precioayer, 0)
let(&preciohoy, 0)
let(&difprecioenmoncotizador, 0)
let(&revaluoenmoneda, 0)
let(&revaluoenmoncotizador, 0)
let(&monedalocal, Var('MONELOCA'))
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))

if (Vacio(&revalopvig))
let(&revalopvig, 'NO')
endif

if (&plazo > 0)
if ((&fecharevaluo = &fechaop y not Incluido(Fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|')) o &fecharevaluo = &fechavto)
if (&fechaop = &fecharevaluo y ((not Eqstr(&monedaprecioop, &monedalocal) y Eqstr(&monedadelcotizador, &monedalocal)) o (not Eqstr(&monedaprecioop, &monedalocal) y not Eqstr(&monedadelcotizador, &monedalocal))))
if (not Eqstr(&monedaprecioop, &monedalocal) y Eqstr(&monedadelcotizador, &monedalocal))
let(&monedaaconvertir, &monedaprecioop)
let(&monedaexpresion, &monedalocal)
let(&precioayer, &precioop)
if (Vacio(&precioniif))
let(&preciohoy, 0)
else 
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
else 
if (not Eqstr(&monedaprecioop, &monedalocal) y not Eqstr(&monedadelcotizador, &monedalocal))
let(&monedaaconvertir, &monedaprecioop)
let(&monedaexpresion, &monedalocal)
let(&precioayer, &precioop)
if (Vacio(&precioniif))
let(&preciohoy, 0)
else 
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
endif
endif
else 
let(&precioayer, &precioop)
if (not Eqstr(&monedaprecioop, &monedadelcotizador))
let(&monedaaconvertir, &monedadelcotizador)
let(&monedaexpresion, &monedaprecioop)
let(&antrevalopvig, &revalopvig)
if (Eqstr(&revalopvig, 'SI'))
let(&revalopvig, 'NO')
endif
if (Eqstr(&monedalocal, &monedadelcotizador))
let(&precioayer, &precioayer)
else 
let(&precioayer, &precioayer / (iif (Eqstr(&revalopvig, 'SI'), (&precioopenarp), CotizacionC(&monedaaconvertir, null, null, null, &fecharevaluo, 25, SI, &monedaexpresion))))
endif
let(&revalopvig, &antrevalopvig)
endif
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else 
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
endif
else 
let(&precioniif, CotizacionNIIF(&especie, Habiles(Fecha(&fecharevaluo), -1, 'ARG'), &book))
if (Vacio(&precioniif))
let(&precioayer, 0)
else 
let(&precioayer, &precioniif.preciocotizaciondeterminada)
endif
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else 
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
endif


let(&difprecioenmoncotizador, &preciohoy - &precioayer)

let(&revaluoenmoncotizador, &cantidad * &difprecioenmoncotizador)

if (not Eqstr(&monedadelcotizador, &monedadelrevaluo))
let(&monedaaconvertir, &monedadelcotizador)
let(&monedaexpresion, &monedadelrevaluo)
let(&antrevalopvig, &revalopvig)
if (Eqstr(&revalopvig, 'SI'))
let(&revalopvig, 'NO')
endif
let(&revaluoenmonreval, &revaluoenmoncotizador)
let(&revalopvig, &antrevalopvig)
else 
let(&revaluoenmonreval, &revaluoenmoncotizador)
endif
else 
let(&revaluoenmonreval, 0)
let(&revaluoenmoncotizador, 0)
endif

Acn(rv:1, &revaluoenmonreval)

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
endif
proximo
proximo

endif

Message('--- Asientos por Anulación de cambio de Book ---')

Sqladd("select DISTINCT O.FechaOp, O.NrOperacion, AC.Modelo as CodAsi, AC.FechaGeneracion,  ")
Sqladd(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
Sqladd(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".ASIENTOSCON AC ")
Sqladd("where ")
Sqladd("  O.NrOperacion = AC.NrOperacion ")
Sqladd(" AND O.FechaAnulacionCambioBook= '"~IdxDate(dialogo.fecha1)~"' and ")
Sqladd("  (O.FechaCambioBook<>O.FechaAnulacionCambioBook) and  ")
Sqladd("  O.Book1 NOT IN ("~Pipe2Comillas(&bvaluapartida)~")")
if (Isdefined("MLASA"))
else 
Sqladd(" AND (AC.Estado IS NULL OR AC.Estado='' OR AC.Estado = ' ' OR AC.Estado IN ('E','A')) ")
endif
Sqladd(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
Sqladd(" order by O.NrOperacion ")
recorrer sql
Acd(fv:1, Fbn('FechaValor'))
Act(vh:1, Fbn('Vehiculo'))
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi')~' - NrAsiento: '~Fbn('NrUnicoAsiento'))
Act(nn:1, getnumerador(Var('ASINUM')))
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON                ")
Sqladd(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
Sqladd(" Modelo, Book, UDN, Centro, ")
Sqladd(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
Sqladd(" NrOperacion, NrTrans2, Estado, Fecha1) ")
Sqladd(" VALUES ")
Sqladd(" ("~IdxDate2(FSys())~", "~IdxDate2(Val(fv:1))~", '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
Sqladd(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
Sqladd(" '"~Fbn('Sector')~"', '', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', 'COT', "~IdxDate2(dialogo.fecha1)~")  ")
Sqlnew()
Sqladd(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
Sqladd(" Especie2, Especie3, Cantidad1, Cantidad2, ")
Sqladd(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
Sqladd(" Alias2, Alias3, Alias4, Alias5, ")
Sqladd(" Detalle, CentroCosto, Book, NrItem ")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
Sqladd(" 'CRE', ")
else 
Sqladd(" 'DEB', ")
endif
Sqladd(" '"~Fbn('Especie1')~"', ")
Sqladd(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
Sqladd(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
Sqladd(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', 'ContraAsiento "~Copy(Fbn('Alias4'), 1, 26)~"', '"~Fbn('Alias5')~"', ")
Sqladd(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', '"~Fbn('NrItem')~"' ) ")
Sqlnew()

Sqlexec()
proximo

proximo
