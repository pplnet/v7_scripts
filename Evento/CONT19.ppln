sql.add(" AND A.NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.add(" And M.TipoAsiento = '"~Val(ta:1)~"'")
sql.add(" AND '"~Fbn('Book1')~"' IN ("~pipe2comillas(&bvaluapartida)~")")
sql.add(" AND (A.Estado is NULL OR A.Estado = '' OR A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
sql.add(" Group By FechaValor,NrUnicoAsiento ")
recorrer sql
Act(as:1, Fbn('NrUnicoAsiento'))
