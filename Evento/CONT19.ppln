Message('--- Asientos por Reclasificación de Revalúo ---')

sql.add(" SELECT O.NrOperacion, O.BookAnterior, O.Book1, O.FechaCambioBook, O.FechaCarga , O.FechaOp,O.TotalBrutoCli1, O.ContraEspecie, ")
sql.add(" O.Vehiculo1,O.Especie,O.Cuenta2 as CuentaCustodia,O.TipoOp, O.FechaVto, O.Precio1 PrecioOp,E.MonedaEmision, ")
sql.add(" O.Cantidad,O.Plazo,M.Codigo CodAsi,O.Cliente1,O.Cliente1 Cliente,E.Tipo TipoEspecie,O.Cupon1,E.Cotiza,E.Issuer ")
sql.add(" FROM "~Dbo()~".OPERACIONES O,MODELOSASIENTO M,ESPECIES E ")
sql.add(" Where O.Especie=E.Codigo and O.FechaCambioBook= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND ((O.FechaCambioBook>O.FechaOp and O.FechaOp>=O.FechaCargaSys) or(O.FechaOp<O.FechaCargaSys and O.FechaCambioBook>O.FechaCargaSys)) ")
sql.add(" and (O.FechaAnulacionCambioBook is null OR O.FechaCambioBook<>O.FechaAnulacionCambioBook OR ( ")
sql.add(" O.FechaCambioBook=O.FechaAnulacionCambioBook AND BookAnterior is not null)) AND O.TipoOp = M.TipoOp AND")
sql.add(" TipoAsiento = '"~Var('TIPASRECLA')~"' AND '|'+rtrim(Vehiculo)+'|' like '%|"~dialogo.vehiculo1~"|%' AND Habilitado = 'SI' AND")
sql.add(" (O.BookAnterior Not IN ("~pipe2comillas(&bvaluapartida)~") AND O.Book1 IN ("~pipe2comillas(&bvaluapartida)~"))")

recorrer sql
Acn(nf:1, 0)
Acn(df:1, 0)
Acn(nf:2, 0)
Acn(rv:1, 0)
Acn(rv:2, 0)
Acn(dp:1, 0)
Acn(da:1, 0)
Act(fv:2, Fbn('FechaVto'))
Act(vh:1, Fbn('Vehiculo1'))
Acd(fo:1, Fbn('FechaOp'))
Act(bk:1, Fbn('BookAnterior'))
Act(bk:2, Fbn('Book1'))
Acd(fv:1, dialogo.fecha1)
Act(cp:99, Fbn('Cupon1'))
Act(me:1, Fbn('MonedaEmision'))
Act(mn:99, Fbn('ContraEspecie'))

let(&fechaop, Fbn('FechaOp'))
let(&fechavto, Fbn('FechaVto'))
let(&precioop, Fbn('PrecioOp'))
let(&especie, Fbn('Especie'))
let(&book, Fbn('Book1'))
let(&cantidad, Fbn('Cantidad'))
let(&monedadelcotizador, Fbn('Cotiza'))
let(&monedaprecioop, Fbn('ContraEspecie'))
let(&monedadelrevaluo, Val(ml:1))
let(&plazo, Fbn('Plazo'))
recorrer&i Fbn('FechaOp'), Fbn('FechaCambioBook') - 1
if (EsHabil(Fecha(&i)))
let(&fecharevaluo, Fecha(&i))
Acd(fv:1, &fecharevaluo)
let(&precioayer, 0)
let(&preciohoy, 0)
let(&difprecioenmoncotizador, 0)
let(&revaluoenmoneda, 0)
let(&revaluoenmoncotizador, 0)
let(&monedalocal, Var('MONELOCA'))
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))

if (Vacio(&revalopvig))
let(&revalopvig, 'NO')
endif

if (&plazo > 0)
if (&fecharevaluo = &fechaop y not Incluido(Fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|')) o &fecharevaluo = &fechavto
if (&fechaop = &fecharevaluo y ((not Eqstr(&monedaprecioop, &monedalocal) y Eqstr(&monedadelcotizador, &monedalocal)) o (not Eqstr(&monedaprecioop, &monedalocal) y not Eqstr(&monedadelcotizador, &monedalocal))))
if (not Eqstr(&monedaprecioop, &monedalocal) y Eqstr(&monedadelcotizador, &monedalocal))
let(&monedaaconvertir, &monedaprecioop)
let(&monedaexpresion, &monedalocal)
let(&precioayer, &precioop * EvalFormula('TCCONTABFOP'))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
else
if (not Eqstr(&monedaprecioop, &monedalocal) y not Eqstr(&monedadelcotizador, &monedalocal))
let(&monedaaconvertir, &monedaprecioop)
let(&monedaexpresion, &monedalocal)
let(&precioayer, &precioop * EvalFormula('TCCONTABFOP'))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else
let(&preciohoy, &precioniif.preciocotizaciondeterminada * EvalFormula('TCCONTABREVAL'))
endif
endif
endif
else
let(&precioayer, &precioop)
if (not Eqstr(&monedaprecioop, &monedadelcotizador))
let(&monedaaconvertir, &monedadelcotizador)
let(&monedaexpresion, &monedaprecioop)
let(&antrevalopvig, &revalopvig)
if (Eqstr(&revalopvig, 'SI'))
let(&revalopvig, 'NO')
endif
if (Eqstr(&monedalocal, &monedadelcotizador))
let(&precioayer, &precioayer * EvalFormula('TCCONTABREVAL'))
else
let(&precioayer, &precioayer / EvalFormula('TCCONTABREVAL'))
endif
let(&revalopvig, &antrevalopvig)
endif
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
endif
else
let(&precioniif, CotizacionNIIF(&especie, Habiles(Fecha(&fecharevaluo), -1, 'ARG'), &book))
if (Vacio(&precioniif))
let(&precioayer, 0)
else
let(&precioayer, &precioniif.preciocotizaciondeterminada)
endif
let(&precioniif, CotizacionNIIF(&especie, &fecharevaluo, &book))
if (Vacio(&precioniif))
let(&preciohoy, 0)
else
let(&preciohoy, &precioniif.preciocotizaciondeterminada)
endif
endif


let(&difprecioenmoncotizador, &preciohoy - &precioayer)

let(&revaluoenmoncotizador, &cantidad * &difprecioenmoncotizador)

if (not Eqstr(&monedadelcotizador, &monedadelrevaluo))
let(&monedaaconvertir, &monedadelcotizador)
let(&monedaexpresion, &monedadelrevaluo)
let(&antrevalopvig, &revalopvig)
if (Eqstr(&revalopvig, 'SI'))
let(&revalopvig, 'NO')
endif
let(&revaluoenmonreval, &revaluoenmoncotizador * EvalFormula('TCCONTABREVAL'))
let(&revalopvig, &antrevalopvig)
else
let(&revaluoenmonreval, &revaluoenmoncotizador)
endif
else
let(&revaluoenmonreval, 0)
let(&revaluoenmoncotizador, 0)
endif

Acn(rv:1, &revaluoenmonreval)

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
sql.generarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
sql.exec
endif
endif
