HojaVisible(NO)
creardialogo
fecha1:'Fecha Desde';2;1;;;;dialogo.fecha1 <> 0 y dialogo.fecha1 <= FSys();'Debe Ingresar una Fecha Desde';NO;PriDeMes(FSys() - 30, SI)
fecha2:'Fecha Hasta';;;;;;dialogo.fecha2 <> 0 y dialogo.fecha2 >= dialogo.fecha1 y dialogo.fecha2 <= FSys();'Debe Ingresar una Fecha Hasta valida';NO;FinDeMes(dialogo.fecha1, SI);FinDeMes(dialogo.fecha1, SI)
radio1:"|Pantalla|PDF|Mail";;;;;;;;;1;;;;;
radio2:"|Cliente|Lista";;;;;;;;;0;;;;;
cliente1:"Cliente";;;;;dialogo.radio2 = 0;(dialogo.radio2 = 0 y NoVacio(dialogo.cliente1)) o dialogo.radio2 = 1;'Ingresar Cliente';NO;
string1:'Path Destino';;;;NO;;;;;Var('PATHRESCT2')
lista1:'Clientes';1;2;;;dialogo.radio2 = 1;;;;;;SQLSet("select Codigo from "~Dbo()~".CLientes  where Status='HAB'  order by Jerarquia")
findialogo

if (not ok)
Cancelar()
endif


sql.add("Select Codigo ")
sql.add("FROM "~Dbo()~".CLIENTES C ")
if (dialogo.radio2 = 0)
sql.add("   Where Codigo = '"~(dialogo.cliente1)~"' ")
else
if (NoVacio(dialogo.lista1))
sql.add("   Where Codigo In ("~pipe2comillas(dialogo.lista1)~")")
else
sql.add("Where Status='HAB' ")
sql.add("and (select Top(1) 1  from "~Dbo()~".CUENTAS CT Where CT.Cliente = C.Codigo and CT.Comitente = '"~Var('VEHICULODE')~"' and CT.TipoCuenta = 'CUS' and CT.Mercado in ('"~Var('RESCTACUS')~"') and CT.NrDepositante is not Null)=1 ")
sql.add("and Jerarquia not like '011%' and  Jerarquia not like '007%' and  Jerarquia not like '008001%' order by Jerarquia   ")
endif
endif
Watch(sql.batch)
recorrer sql

linkearhoja('RESCTA', 1, cliente1 = Fbn()['Codigo'], fecha1 = dialogo.fecha1, fecha2 = dialogo.fecha2, radio1 = dialogo.radio1, string1 = dialogo.string1)

proximo

