creardialogo
fecha1: 'Fecha Desde';1;;;;;;;;;FSys()
fecha2: 'Fecha Hasta';2;;;;;;;;;FSys()
findialogo

Sqladd(" Select NrOperacion From "~Dbo()~".OPERACIONES Where FechaOp > '"~dialogo.fecha1~"' And FechaOp < '"~dialogo.fecha2~"' ")
recorrer sql
Message(Fbn('NrOperacion'))
Ejecutarevento('ELILIQ', 'nroperacion1', Fbn('NrOperacion'))
proximo
