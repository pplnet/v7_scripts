CrearDialogo
   NrOperacion1 : '# Operacion:'         ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar una operacion';NO;;;;;;"TipoOp in('FXCF','FXVF')"~iif(Dialogo.Check1=1,"and IsNull(NrBoleto,'')=''","")
   String1      : 'Boleto'
   Check1       : 'Sin boleto asignado'
FinDialogo

If Not ok
   Cancelar
endif

SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
SQL.ADD("   SET NrBoleto='"~Dialogo.String1~"' ")
SQL.ADD(" WHERE NrOperacion='"~Dialogo.Nroperacion1~"' ")
SQL.ADD("   AND TipoOp in('FXCF','FXVF')")
SQL.New
SQL.Exec

Messagebox('Operacion actualizada')

   
