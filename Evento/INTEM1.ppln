creardialogo
fecha1:"Fecha";;;;;;NoVacio(dialogo.fecha1);'Debe Ingresar la Fecha';NO;FSys()
precio1:"Tasa";;;;NO;NO;;;;0;;
lista1:'Vehiculos';;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

findialogo

if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.lista1))
Act(zz6, dialogo.lista1)
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Act(zz6, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))
endif
endif

Sqladd("SELECT * from "~Dbo()~".OPERACIONES O")
Sqladd("where O.TipoOp='VIMINM' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("      and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
Sqladd("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")


recorrer sql

Message('Procesando Vehiculo: '~Fbn()['Vehiculo1']~' Veh. ContraParte '~Fbn()['Vehiculo2']~' Especie:'~Fbn()['Especie']~' ...')

Acn(z11, iif (Eqstr('360', Query("SELECT Divisor from "~Dbo()~".PARESVEHICULO where Vehiculo1='"~Fbn()['Vehiculo1']~"' and Vehiculo2='"~Fbn()['Vehiculo2']~"' ")), 360, 365))
Acn(z12, Query("SELECT Tasa from "~Dbo()~".TASASVEHICULO where ((Vehiculo1='"~Fbn()['Vehiculo1']~"' and Vehiculo2='"~Fbn()['Vehiculo2']~"') or (Vehiculo1='"~Fbn()['Vehiculo2']~"' and Vehiculo2='"~Fbn()['Vehiculo1']~"')) and Especie ='"~Fbn()['Especie']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

if (Val(z12) = 0)
Messagebox("Debe Ingresar la Tasa para "~Fbn()['Vehiculo1']~"/"~Fbn()['Vehiculo2']~"-"~Fbn()['Especie']~" "~dialogo.fecha1~" ...")
else
Act(z7, Fbn()['MB3'])

Acn(ab6, Fbn()['RB6'])

Acn(z6, Val(z12) * Fbn()['TotalBrutoCli1'] * Fbn()['Plazo'] / (100 * Val(z11)))

Message('Calculando los Impuestos para Operacion Directa ')

Act(av1, Fbn()['Vehiculo1'])
Act(av2, Fbn()['Vehiculo2'])


Act(y13, " Ganancias1a2 G,WHT1a2 W ")

if (Eqstr(Val(z7), '1'))
Act(y13, " Ganancias2a1 G,WHT2a1 W ")
endif


Sqladd("SELECT "~Val(y13)~",Divisor FROM "~Dbo()~".PARESVEHICULO WHERE Vehiculo1='"~Val(av1)~"' AND Vehiculo2='"~Val(av2)~"' ")

recorrer sql
Dfa()
Acn(y15, Fbn()['W'] / 100)
Acn(y17, Fbn()['W'])
Acn(y18, iif (Eqstr('360', Fbn()['Divisor']), 360, 365))

Acn(y30, Fbn()['G'])
proximo


Acn(y19, iif (dialogo.precio1 = 0, Val(z12), dialogo.precio1) / Val(y18) * 365)

if (Val(ab6) >= 2)
Acn(y19, iif (dialogo.precio1 = 0, Val(z12), dialogo.precio1) * (1 + Val(y15)) / Val(y18) * 365)
endif

Acn(y20, Val(z11))

Acn(y4, 0)
Acn(y5, 0)
Acn(y6, 0)
Acn(y12, 0)
Acn(y13, 0)
Acn(y16, 0)


if (Val(ab6) = 0)



Act(a1, BuscarCampo('CLIENTES', 'Res3337', 'Codigo', BuscarCampo('VEHICULOS', 'Cliente', 'Codigo', Val(av1))))
Act(a2, BuscarCampo('CLIENTES', 'Res3337', 'Codigo', BuscarCampo('VEHICULOS', 'Cliente', 'Codigo', Val(av2))))


if (Eqstr(Val(z7), '1'))
Act(a3, Val(a1))
Act(a1, Val(a2))
Act(a2, Val(a3))
endif


Acn(y4, Val(z11) * Val(y17) / 100)
Acn(y5, 0)


Acn(y6, Val(y17))
Acn(y12, 0)
Acn(y13, 0)

if (Eqstr(Val(a1), 'SI') y Eqstr(Val(a2), 'NO'))
if (Val(z11) >= Var('RG3337MINI'))
Acn(y12, Var('RG3337'))
Acn(y13, Val(z11) * Var('RG3337') / 100)
endif
endif


if (Eqstr(Val(a1), 'NO') y Eqstr(Val(a2), 'SI'))
if (Val(y4) >= Var('IVAMINIMO'))
Acn(y5, Val(y4) * Var('IVARETEN') / 100)
endif
endif


Acn(y16, Val(y4) - Val(y5) + Val(y13))
Acn(y20, Val(z11) + Val(y16))
endif

Acn(w1, 0)
Acn(w2, 0)

if (Val(ab6) = 2)
Acn(w1, Val(y17))


if (Eqstr(Val(z7), '1'))
Acn(w2, Val(z11) * Val(w1) / 100)
endif
endif


Acn(i1, 0)
Acn(i2, 0)

if (Val(ab6) >= 3)

Acn(i1, Val(y17))


if (Val(ab6) = 3 o Eqstr(Val(z7), '1'))


Acn(i2, Val(z11) * Val(i1) / 100)

endif
endif

if (Val(ab6) = 2 y Eqstr(Val(z7), '1'))
Acn(y31, 0)

if (Eqstr(Val(z7), '1'))
Acn(y31, Val(z11) * Val(y30) / 100)
endif
Acn(y6, Val(y30))
Acn(y4, Val(y31))
Acn(y16, Val(y31))
endif





