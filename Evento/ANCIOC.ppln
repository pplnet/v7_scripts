MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha:';;;;;;dialogo.fecha1 <= FSys() y EsHabil(dialogo.fecha1, 'ARG');'Fecha Invalida';NO;FSys()
vehiculo1:'Vehiculo:';;;;NO;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
findialogo
if (not ok)
Cancelar()
endif
Acn(bd:1, 0)

SetFilaActual(0)
if (Query(" Select 1 From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Registro = 'CIED' ") <> 1)
Cancelar('El Cierre del Dia No Ha Sido Procesado')
endif

Act(me:1, Var('MERCOCT'))
Act(ct:2, CuentaCliente(dialogo.vehiculo1, 'ARP', '', Val(me:1)))
Acn(ps:1, 0)
Acn(ml:1, 0)
Acn(ml:2, 0)

Sqladd(" Select NrTrans, Cantidad1, Cliente1, NrTransRef1, Cantidad2 ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T1 ")
Sqladd(" Where T1.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T1.TipoTr2 = 'LIQOCT' ")
Sqladd(" AND T1.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND T1.Cambio1 = 0 ")
Sqladd(" Order By NrTrans ")
recorrer sql
Acn(bd:1, 1)
Act(a:fac, Fbn('NrTrans'))
Act(b:fac, Fbn('Cliente1'))
Acn(c:fac, Fbn('Cantidad1'))
Acn(d:fac, Fbn('Cantidad2'))
Scn(ml:1, Fbn('Cantidad1'))
Scn(ml:2, Fbn('Cantidad2'))
Act(ls:1, Val(ls:1)~'|'~Fbn('NrTrans'))
Act(nv:fac, Fbn('NrTransRef1'))
if (Fbn('Cantidad1') <> Fbn('Cantidad2'))
Act(tr:fac, Query(" Select NrTrans From "~Dbo()~".TRANSACCIONES2 Where TipoTr2 = 'TRANSP' AND NrTransRef1 = '"~Val(nv:fac)~"' "))
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Val(tr:fac)~"' AND NrSaldo = 1 ") <> 1)
Cancelar('El Voucher de Transporte '~Val(tr:fac)~' ya esta liquidado')
endif
endif
proximo

Acn(fi:1, Fac())
Ifa()
Act(a:fac, 'MULTILATERAL')
Acn(c:fac, Val(ml:1))
Acn(d:fac, Val(ml:2))

if (Val(bd:1) = 1)
crearlistbox;'Arial,8,';'Anulacion de Cierre Diario OCT del dia '~dialogo.fecha1
'Transaccion';a:1..a:fac;NO;;;90;string;;RGB(450, 200, 250);
'Agente';b:1..b:fac;NO;;;70;string;;RGB(450, 200, 250);
'Cantidad Liquidada';c:1..c:fac;NO;;;120;numero;'###,###,###,###.##';RGB(450, 200, 250);
'Cantidad Confirmada';d:1..d:fac;NO;;;120;numero;'###,###,###,###.##';RGB(450, 200, 250);
finlistbox
if (not ok)
Cancelar()
endif
else
Sqladd(" Delete "~Dbo()~".FLAGSOCT ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Registro = 'CIED' ")
Sqlnew()
Sqlexec()
Cancelar('El Cierre Diario OCT No Tuvo Liquidaciones')
endif

recorrer&k 1, Val(fi:1)
Sqladd(" Select CB3, CB9 From "~Dbo()~".TRANSACCIONES2 Where NrTrans = '"~Val(nv:&k)~"' ")
recorrer sql
Dfa()
Acn(cb:3, Fbn('CB3'))
Acn(cb:9, Fbn('CB9'))
proximo
if (Val(cb:3) = 1)
Message('Anulando Falla del Voucher '~Val(nv:&k))
Ejecutarevento('ANUFAL', 'nrtrans1', Val(nv:&k), 'radio1', 0)
endif
if (Val(cb:9) = 1)
Message('Anulando Confirmacion del Voucher '~Val(nv:&k))
Ejecutarevento('XNOCON', 'nrtrans1', Val(nv:&k))
Sqladd(" Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Set Cantidad4 = 0 ")
Sqladd(" Where NrTrans = '"~Val(nv:&k)~"' ")
Sqlnew()
endif
Sqladd(" Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Set Cantidad2 = 0, ")
Sqladd(" NrTransRef1 = Null ")
Sqladd(" Where NrTrans = '"~Val(a:&k)~"' ")
Sqlnew()
Sqlexec()
proximo

Ejecutarevento('ALIQAU', 'fecha1', dialogo.fecha1)

Sqladd(" Delete "~Dbo()~".FLAGSOCT ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Registro = 'CIED' ")
Sqlnew()
Sqlexec()

