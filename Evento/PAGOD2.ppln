Sqladd(" Select DISTINCT  T.Mercado1, T.Cliente1, T.NrTrans, T.RB10, T.Especie, T.Especie2, ")
Sqladd(" T.Cantidad1, T.Precio1, T.Cantidad2, T.Precio2, T.Cantidad3, T.Cantidad4, T.Cantidad5, ")
Sqladd(" T.Cantidad6, T.Cantidad7, T.Cantidad8, T.Cuenta1, T.Cuenta2, T.Cliente2, T.Cuenta3, ")
