Sqladd("from  "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" where T.TipoTr2   = 'PDIVID' ")
Sqladd("  and T.RB1 > 0 ")
Sqladd("  and  T.Especie   = '"~dialogo.especie1~"' ")
Sqladd("  and  T.Fecha2    = '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd("  and  T.Fecha1    = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("  and  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.cliente1))
Sqladd("  and  T.Cliente1  = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.mercado1))
Sqladd("  and  T.Mercado1  = '"~dialogo.mercado1~"' ")
endif
if (dialogo.radio1 = 0)
Sqladd(" AND T.RB2 = 0 ")
endif
if (dialogo.radio1 = 1)
Sqladd(" AND T.RB2 = 1 ")
endif
Sqladd(" order by Mercado1, Cliente1, NrTrans ")

