creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO') y not DesciendeDeEspecie(dialogo.especie1, 'ON');'Debe Ingresar una Especie Valida';NO;;;;;;
fecha1:'Record_Date';1;2;;;;dialogo.fecha1 <> 0;'Debe Ingresar una Fecha válida ';NO;FSys()
cliente1:'Cliente';3;1;;;;Vacio(dialogo.cliente1) o (Eqstr(BuscarCampo('CLIENTES', 'CategDepositante', 'Codigo', dialogo.cliente1), 'CLI') y Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente1), 'HAB'));'Debe Ingresar un Cliente';NO;;;;;;" CategDepositante='CLI' AND Status = 'HAB' ";
fecha2:'Fecha_Limite';3;2;;;;dialogo.fecha2 <> 0 y dialogo.fecha2 >= dialogo.fecha1;'Debe Ingresar una Fecha Limite ';NO;FSys()
especie2:'Moneda';5;1;;;;NoVacio(dialogo.especie2) y DesciendeDeEspecie(dialogo.especie2, 'MONEDA');'Debe Ingresar una Moneda Válida';NO;'ARP';;'ARP|USD|';;;" Codigo IN ( "~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
string1:'Hora_Limite';5;2;;;;NoVacio(dialogo.string1) y HoraValida(dialogo.string1);'Debe Ingresar una Hora Limite ';NO;'18:00:00'
precio1:'Porcentaje';7;1;;;;dialogo.precio1 > 0;'Porcentaje Invalido';NO
mercado1:'Mercado';7;2;;;;
operador1:'Operador';9;1;;NO;;NoVacio(dialogo.operador1);'Debe Ingresar el Operador';NO;UsuarioActivo()
vehiculo1:'Vehiculo';9;2;;;;NoVacio(dialogo.vehiculo1);'Debe Ingresar el vehículo';NO;Var('VEHICULODE');
radio1:'Tipo|Rescate|Tender';1;1;2;NO;NO;;;;;1
findialogo

if (not ok)
Cancelar()
endif

Linkearhoja('CARGLB', 1, 'especie1', dialogo.especie1, 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha2, 'cliente1', dialogo.cliente1, 'mercado1', dialogo.mercado1, 'operador1', dialogo.operador1, 'vehiculo1', dialogo.vehiculo1, 'radio1', dialogo.radio1, 'precio1', dialogo.precio1, 'especie2', dialogo.especie2, 'string1', dialogo.string1)
