**-- COTATE: Copia de Tasas Diarias para Terceros
CrearDialogo
  Fecha1     : "F.Desde"           ;;;;;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;FSYS
  Fecha2     : "F.Hasta"           ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta';NO;FSYS
  Vehiculo1  : 'Desde Vehi.'       ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo es Invalido';NO;
  Cliente1   : 'Desde Clie.'       ;;;;;;NOVACIO(Dialogo.Cliente1);'El Cliente es Invalido';NO;;;;
  Especie1   : 'Moneda'            ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;
  Entero1    : 'Existe?'           ;;;;NO;NO;Dialogo.Entero1>0;'No Existe el Rango de Tasas Indicado !!';NO;;SQL("Select COUNT(*) FROM "~DBO~".TASASTERCEROS Where Vehiculo='"~Dialogo.Vehiculo1~"' AND Cliente='"~Dialogo.Cliente1~"' AND Especie='"~Dialogo.Especie1~"' and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and Fecha<='"~IdxDate(Dialogo.Fecha2)~"' ")
FinDialogo

if not Ok
  Cancelar
endif

* x1: Vehiculo1 x2: Cliente1
act(x1,Dialogo.Vehiculo1)
act(x2,Dialogo.Cliente1)
acd(x3,Dialogo.Fecha1)
acd(x4,Dialogo.Fecha2)
act(x5,Dialogo.Especie1)

CrearDialogo
  Fecha1     : "F.Desde"       ;;;;NO;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;VAL(X3)
  Fecha2     : "F.Hasta"       ;;;;NO;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta';NO;VAL(X4)
  Especie1   : 'Moneda'        ;;;;NO;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;VAL(X5)
  Vehiculo1  : 'Hasta Vehi'    ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo 1 es Invalido';NO;
  Cliente1   : 'Hasta Clie'    ;;;;;;NOVACIO(Dialogo.Cliente1);'El Vehiculo 2 es Invalido';NO;;;;
FinDialogo

if not Ok
  Cancelar
endif

SQL.ADD("Select * FROM "~DBO~".TASASTERCEROS ")
SQL.ADD("Where Vehiculo='"~Val(x1)~"' AND Cliente='"~Val(x2)~"' ")
SQL.ADD("      and Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("      and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("      and Fecha<='"~IdxDate(Dialogo.Fecha2)~"' Order By Fecha")
  
Recorrer SQL

   Message('Copiando Fecha '~FBN['Fecha']~' ...')

   * Verifico que no existan las tasas para esa fecha y vehiculo
   SQL.ADD("Select * FROM "~DBO~".TASASTERCEROS ")
   SQL.ADD("Where Vehiculo='"~Dialogo.Vehiculo1~"' AND Cliente='"~Dialogo.Cliente1~"' ")
   SQL.ADD("      and Especie='"~Dialogo.Especie1~"' ")
   SQL.ADD("      and Fecha='"~IdxDate(FBN['Fecha'])~"' ")

   acn(y1,0)
   Recorrer SQL 
      acn(y1,FBN['Tasa'])
   Proximo

   IF VAL(y1)<>0
      Cancelar('Existe una Tasa de '~Fstr(VAL(y1),0,5)~' Para el Dia '~FBN['Fecha']~' ... ')
*      acn(t:fac,MessageBox('Existe una Tasa de '~Fstr(VAL(y1),0,5)~' Para el Dia '~FBN['Fecha']~' ... Desea Eliminarla?',2,2))

*      IF Val(t:fac)=1
*         * Si existe una anterior la borro
*         SQL.ADD("DELETE "~DBO~".TASASTERCEROS ")
*         SQL.ADD("Where Vehiculo='"~Dialogo.Vehiculo1~"' AND Cliente='"~Dialogo.Cliente1~"' ")
*         SQL.ADD("      and Especie='"~Dialogo.Especie1~"' ")
*         SQL.ADD("      and Fecha='"~IdxDate(FBN['Fecha'])~"' ")
*         SQL.NEW
*         SQL.EXEC      
*      ENDIF
   ELSE
      * Inserto el nuevo valor
      SQL.ADD("INSERT INTO "~DBO~".TASASTERCEROS ")
      SQL.ADD(" (Fecha,Vehiculo,Cliente,Especie,Tasa) Values ")
      SQL.ADD(" ('"~IdxDate(FBN['Fecha'])~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Cliente1~"','"~Dialogo.Especie1~"',"~Fstr(FBN['Tasa'],0,5)~") ")
      SQL.NEW
      SQL.EXEC      
   EndIf

Proximo

