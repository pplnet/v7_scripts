HojaVisible(NO)

creardialogo
nrtrans1:"Nro. Transaccion";;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (Vacio(dialogo.nrtrans1))
Cancelar()('No Ingreso Transaccion')
endif

Act(tr1, Trim(Mirt(dialogo.nrtrans1)))

sql.add(" Select /*+ RULE */ A.*  from "~Dbo()~".Transacciones2 A ")
sql.add("   where A.CB4 = '1' ")
sql.add("     and A.NrTrans = '"~dialogo.nrtrans1~"'  ")

if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND A.Vehiculo1 IN (Select /*+ RULE */ Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
endif

recorrer sql
Message(' Usuario '~Fbn()['Nrtrans']~' '~Fbn()['Tipotr2']~' ...')


Act(a:fac, Fbn()['Nrtrans'])
Act(b:fac, Fbn()['Tipotr2'])
Act(c:fac, Fbn()['Especie'])
Act(d:fac, Fbn()['Cliente1'])
Act(e:fac, Fbn()['Cuenta1'])
Act(f:fac, Fbn()['Cliente2'])
Act(g:fac, Fbn()['Cuenta2'])
Acn(h:fac, Fbn()['Cantidad1'])
Acd(i:fac, Fbn()['Fecha1'])
Acd(j:fac, Fbn()['Fecha2'])
Act(k:fac, Fbn()['CB2'])
Act(l:fac, Fbn()['CB4'])
Act(n:fac, Fbn()['Vehiculo1'])
Act(o:fac, Fbn()['CB6'])
Act(p:fac, Fbn()['CB8'])
Acd(q:fac, Fbn()['Fecha5'])
Act(r:fac, Fbn()['CB10'])

Acn(z:fac, 1)

proximo

if (Fac() > 0)

crearlistbox;'Arial,10,B'
'Retransm.';z1..k:fac;SI;SI;;70;combo;'Si|No|'
'Nrtrans';a1..a:fac;NO;SI;;70;string
'Tipo T';b1..b:fac;NO;SI;;70;string
'Especie';c1..c:fac;NO;SI;;70;string
'Cliente1';d1..d:fac;NO;SI;;80;string
'Cuenta1';e1..e:fac;NO;SI;;90;string
'Cliente2';f1..f:fac;NO;SI;;80;string
'Cuenta2';g1..g:fac;NO;SI;;90;string
'Cantidad1';h1..h:fac;NO;SI;;100;string
'Fecha1';i1..i:fac;NO;SI;;70;string
'Fecha2';j1..j:fac;NO;SI;;70;string
'CB2';k1..k:fac;NO;SI;;50;string
'CB4';l1..l:fac;NO;SI;;50;string
'Vehiculo';n1..n:fac;NO;SI;;80;string
'CB6';o1..o:fac;NO;SI;;50;string
'CB8';p1..p:fac;NO;SI;;50;string
'Fecha5';q1..q:fac;NO;SI;;230;string
'CB10';r1..r:fac;NO;SI;;50;string

finlistbox

if (ok)
recorrer&i 1, Fac()
if (Val(z:&i) = 0)
sql.add("Update /*+ RULE */ "~Dbo()~".transacciones2 Set ")
sql.add("CB4 = NULL ")
sql.add("where NrTrans ='"~Val(tr1)~"'  ")
sql.new
sql.exec
Messagebox('Blanqueo Exitoso para: '~Val(tr1))
endif
proximo
else
Cancelar()
endif
else
Messagebox('Transaccion Invalida: '~Val(tr1))

endif


