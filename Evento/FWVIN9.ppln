creardialogo
nroperacion1:'Nr.Operacion';
entero2: 'Origen'
entero3: 'Destino'
findialogo

if (not ok)
Cancelar()
endif

Act(z:2, dialogo.nroperacion1)

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '0' ")
Sqladd(" Where NrOperacion = '"~Val(z:2)~"' ")
Sqladd(" and NrBit         =  "~FStr(dialogo.entero2, 2, 0)~"  ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '1' ")
Sqladd(" Where NrOperacion = '"~Val(z:2)~"' ")
Sqladd(" and NrBit         =  "~FStr(dialogo.entero3, 2, 0)~"  ")
Sqlnew()
Sqlexec()




