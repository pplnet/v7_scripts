creardialogo
nroperacion1:'Nr.Operacion';
entero2: 'Origen'
entero3: 'Destino'
findialogo

if (not ok)
Cancelar()
endif

Act(z:2, dialogo.nroperacion1)

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("   Set Valor       = '0' ")
sql.add(" Where NrOperacion = '"~Val(z:2)~"' ")
sql.add(" and NrBit         =  "~FStr(dialogo.entero2, 2, 0)~"  ")
sql.new
sql.exec

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("   Set Valor       = '1' ")
sql.add(" Where NrOperacion = '"~Val(z:2)~"' ")
sql.add(" and NrBit         =  "~FStr(dialogo.entero3, 2, 0)~"  ")
sql.new
sql.exec




