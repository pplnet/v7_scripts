* HOJAVISIBLE(SI)

CrearDialogo
  String1  : 'Path'        ;;;;;;;;;'C:\'
  String2  : 'Arch. Texto' ;;;;;;;;;'BONOS.WKS';
  Especie1 : 'Jerarquia';;;;;;NoVacio(Dialogo.Especie1);'indicar jerarquia';NO
  Radio1   : 'Tipo|Titulos|ONs|FCI|Acciones';;;;;;;;;
FinDialogo

if not OK
  Cancelar
endif

ImportarWKS(a1..z:1000,a1..z:1000,Dialogo.String1~Dialogo.String2)

if Vacio(val(b1))
   Cancelar('No se ha podido recuperar el archivo wks')
endif

ACT(z1, SQL("select "~DBO~".SACAJERARQUIAESPECIE('"~Dialogo.Especie1~"') from dbo.ESPECIES"))



*-- Recorrer valores
recorrer&i 2,100
  if Vacio(Val(a:&i))
    Break
  endif

if Dialogo.Radio1=0
  if Val(h:&i)=1
    ACT(h:&i, 'CLE')
  else
    ACT(h:&i, 'DIR')
  endif
  if Val(o:&i)=1
    ACT(o:&i, '30')
  else
    if Val(o:&i)=2
      ACT(o:&i, 'REA')
    else
      ACT(o:&i, '30E')
    endif
  endif
  if Val(p:&i)=1
    ACT(p:&i, '360')
  else
    if Val(p:&i)=2
      ACT(p:&i, '365')
    else
      ACT(p:&i, 'REA')
    endif
  endif
  if EqStr(val(j:&i),'MULTIPLES')
    ACT(j:&i, 'CV')
  endif
  if SQL("select count(*) from "~DBO~".ESPECIES where Codigo='"~Val(a:&i)~"'") = 0 y SQL("select count(*) from "~DBO~".ESPECIES where Nombre='"~Val(b:&i)~"'") = 0
    ACT(z2, Pad(Val(z1)~Pad0(FStr(&i,0,0),3),15,'0'))
    SQL.ADD(" INSERT "~DBO~".ESPECIES")
    SQL.ADD(" (Codigo, Nombre, Cupon, Extendido, Cotiza")
    SQL.ADD(",FEmision, Fecha, InteresesC, VTeorico, MercadoDef")
    SQL.ADD(", ISIN, CUSIP, Cedel, EuroClear, DiasMes")
    SQL.ADD(", DiasAnio, LaminaMinima, PaisOrigen, PlazoLiq, Indexado")
    SQL.ADD(", Indice, ZeroCoupon, TasaIntVigente, Jerarquia, Tipo, Status) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(a:&i)~"','"~Val(b:&i)~"',"~FStr(Val(c:&i),1,0)~",'"~Val(d:&i)~"', '"~Val(e:&i)~"', ")
    SQL.ADD(" '"~Idxdate(Val(f:&i))~"', '"~Idxdate(Val(g:&i))~"','"~Val(h:&i)~"',"~Val(i:&i)~", '"~Copy(Val(j:&i),1,6)~"', ")
    SQL.ADD(" '"~Copy(Val(k:&i),1,12)~"', '"~Val(l:&i)~"','"~Val(m:&i)~"','"~Val(n:&i)~"', '"~Val(o:&i)~"', ")
    SQL.ADD(" '"~Val(p:&i)~"', "~Val(q:&i)~",'"~Val(r:&i)~"',"~Val(t:&i)~", '"~Val(u:&i)~"', ")
    SQL.ADD(" '"~Val(v:&i)~"', '"~Val(w:&i)~"',"~FStr(Val(x:&i),1,0)~",'"~Val(z2)~"', 'PUB', 'HAB') ")
    SQL.NEW
    SQL.EXEC 
  else 
    Message(Val(a:&i)~' Ya existe ')
  endif
endif

if Dialogo.Radio1=1
  if Val(h:&i)=1
    ACT(h:&i, 'CLE')
  else
    ACT(h:&i, 'DIR')
  endif
  if Val(o:&i)=1
    ACT(o:&i, '30')
  else
    if Val(o:&i)=2
      ACT(o:&i, 'REA')
    else
      ACT(o:&i, '30E')
    endif
  endif
  if Val(p:&i)=1
    ACT(p:&i, '360')
  else
    if Val(p:&i)=2
      ACT(p:&i, '365')
    else
      ACT(p:&i, 'REA')
    endif
  endif
  if EqStr(val(j:&i),'MULTIPLES')
    ACT(j:&i, 'CV')
  endif
  if SQL("select count(*) from "~DBO~".ESPECIES where Codigo='"~Val(a:&i)~"'") = 0 y SQL("select count(*) from "~DBO~".ESPECIES where Nombre='"~Val(b:&i)~"'") = 0
    ACT(z2, Pad(Val(z1)~Pad0(FStr(&i,0,0),3),15,'0'))
    SQL.ADD(" INSERT "~DBO~".ESPECIES")
    SQL.ADD(" (Codigo, Nombre, Cupon, Extendido, Cotiza")
    SQL.ADD(",FEmision, Fecha, InteresesC, VTeorico, MercadoDef")
    SQL.ADD(", ISIN, CUSIP, Cedel, EuroClear, DiasMes")
    SQL.ADD(", DiasAnio, LaminaMinima, PaisOrigen, PlazoLiq, Indexado")
    SQL.ADD(", Indice, ZeroCoupon, TasaIntVigente, Jerarquia, Issuer, Tipo, Status) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(a:&i)~"','"~Val(b:&i)~"',"~FStr(Val(c:&i),1,0)~",'"~Val(d:&i)~"', '"~Val(e:&i)~"', ")
    SQL.ADD(" '"~Idxdate(Val(f:&i))~"', '"~Idxdate(Val(g:&i))~"','"~Val(h:&i)~"',"~Val(i:&i)~", '"~Copy(Val(j:&i),1,6)~"', ")
    SQL.ADD(" '"~Copy(Val(k:&i),1,12)~"', '"~Val(l:&i)~"','"~Val(m:&i)~"','"~Val(n:&i)~"', '"~Val(o:&i)~"', ")
    SQL.ADD(" '"~Val(p:&i)~"', "~Val(q:&i)~",'"~Val(r:&i)~"',"~Val(t:&i)~", '"~Val(u:&i)~"', ")
    SQL.ADD(" '"~Val(v:&i)~"', '"~Val(w:&i)~"',"~FStr(Val(x:&i),1,0)~",'"~Val(z2)~"', '"~Copy(Val(y:&i),1,10)~"', 'PRI', 'HAB') ")
    SQL.NEW
    SQL.EXEC 
  else 
    Message(Val(a:&i)~' Ya existe ')
  endif
endif

if Dialogo.Radio1=2
  if EqStr(val(j:&i),'MULTIPLES')
    ACT(j:&i, 'CV')
  endif
  if SQL("select count(*) from "~DBO~".ESPECIES where Codigo='"~Val(a:&i)~"'") = 0 y SQL("select count(*) from "~DBO~".ESPECIES where Nombre='"~Val(b:&i)~"'") = 0
    ACT(z2, Pad(Val(z1)~Pad0(FStr(&i,0,0),3),15,'0'))
    SQL.ADD(" INSERT "~DBO~".ESPECIES")
    SQL.ADD(" (Codigo, Nombre, Extendido, Cotiza")
    SQL.ADD(" , PaisOrigen, Jerarquia, Issuer, Alias2, Tipo, Status) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(a:&i)~"','"~Val(b:&i)~"','"~Val(c:&i)~"', '"~Val(d:&i)~"', ")
    SQL.ADD(" '"~Val(e:&i)~"','"~Val(z2)~"', '"~Copy(Val(g:&i),1,10)~"', "~FStr(Val(f:&i),1,0)~", 'FON', 'HAB') ")
    SQL.NEW
    SQL.EXEC 
  else 
    Message(Val(a:&i)~' Ya existe ')
  endif
endif

if Dialogo.Radio1=3
  if EqStr(val(j:&i),'MULTIPLES')
    ACT(j:&i, 'CV')
  endif
  if SQL("select count(*) from "~DBO~".ESPECIES where Codigo='"~Val(a:&i)~"'") = 0 y SQL("select count(*) from "~DBO~".ESPECIES where Nombre='"~Val(b:&i)~"'") = 0
    ACT(z2, Pad(Val(z1)~Pad0(FStr(&i,0,0),3),15,'0'))
    SQL.ADD(" INSERT "~DBO~".ESPECIES")
    SQL.ADD(" (Codigo, Nombre, Extendido, Cotiza")
    SQL.ADD(" , PaisOrigen, MercadoDef, Jerarquia, Issuer, PlazoLiq, Tipo, Status) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(a:&i)~"','"~Val(b:&i)~"','"~Val(c:&i)~"', '"~Val(d:&i)~"', ")
    SQL.ADD(" '"~Val(k:&i)~"','"~Val(e:&i)~"','"~Val(z2)~"', '"~Copy(Val(m:&i),1,10)~"', "~FStr(Val(l:&i),1,0)~", 'PRI', 'HAB') ")
    SQL.NEW
    SQL.EXEC 
  else 
    Message(Val(a:&i)~' Ya existe ')
  endif
endif


proximo

hojavisible(SI)
