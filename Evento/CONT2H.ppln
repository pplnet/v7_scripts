Sqladd(" SELECT T.NrTrans, T.Cantidad1, T.Especie Moneda, O.NrOperacion, O.Especie, O.ContraEspecie, ")
Sqladd(" O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, C.CUIT, V.Valor1, V.Valor2, ")
Sqladd(" O.FechaVto, O.Vehiculo1, O.Cantidad, CU.Comitente, O.CB9, O.CB10, O.Precio3, E.Tipo, ")
Sqladd(" O.TotalNetoCli2, T.Fecha2, T.Fecha1, O.FechaVto2, O.PrecioMer, O.FechaPago, O.TotalIVA, ")
Sqladd(" O.TotalIntereses, O.FechaOp, O.TotalBrutoCli2, O.TotalDerechos, O.Cliente1, T.Cuenta2, ")
Sqladd(" CU.CuentaContable1, C.Valor1 CtaRem, E.Issuer Cliente, T.TipoTr2, O.CB7, O.TipoTasa, O.MB2, O.FechaEx4, ")
Sqladd(" O.MB3, O.Observaciones, O.Precio1, O.Plazo, M.NrMov, M.NrGrupo2 MovConcepto, M.Status TipoImpuesto, E.Alias8, E.Alias5, ")
Sqladd(" E.Cotiza, O.PlazoRenovPredeter, O.ImpComCor1, O.ImpComMer1, V.Alias4, O.MB4, O.CB13, O.CB14, MA.Libro, ")
Sqladd(" O.NrOperacion5, '' TipoDevengado, O.ImpGastos2, T.CNFormaPago, O.CantidadOri,C.CategDepositante, O.Book1 Book ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONES O, "~Dbo()~".MODELOSASIENTO MA, ")
Sqladd(" "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, "~Dbo()~".CUENTAS CU, "~Dbo()~".ESPECIES E,  ")
Sqladd(" "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
Sqladd(" AND ((O.Cliente1    =  C.Codigo AND O.TipoOp <> 'TRANSF') OR (T.Cliente1 = C.Codigo AND O.TipoOp = 'TRANSF')) ")
Sqladd(" AND O.Vehiculo1   =  V.Codigo  ")
Sqladd(" AND  O.Especie     =  E.Codigo ")
Sqladd(" AND   T.Especie  IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
Sqladd(" AND   T.NrTrans     =  M.NrTrans2 ")
Sqladd(" AND O.TipoOp Not IN ('MMCP', 'MMCPM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMPCCM','GARANT','MMDPAC','MMONM') ")
Sqladd(" and T.TipoTr2 in ('DEP','RET') ")
Sqladd(" AND M.NrOperacion = O.NrOperacion ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND T.Cantidad1 > 0 ")
Sqladd(" AND T.Cuenta2 = CU.Codigo ")
Sqladd(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") ")
Sqladd(" AND MA.TipoOp = O.TipoOp ")
Sqladd(" AND T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
Sqladd(" AND ((O.TipoOp = 'TRANSF' AND C.CategDepositante = 'ALY') OR (O.TipoOp <> 'TRANSF')) ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND T.NrTrans IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
else 
Sqladd(" AND T.Fecha1 = "~IdxDate2(dialogo.fecha1)~" ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
