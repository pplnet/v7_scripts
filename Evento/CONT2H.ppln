if (not (Fbn('NrMov') > 10000 y Fbn('NrMov') < 11000))
Sqladd(" Select Max(Fecha2) Fecha2 ")
Sqladd(" From "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" and Fecha2 <= '"~IdxDate(Val(fv:1))~"' ")
recorrer sql
if (not Vacio(Fbn('Fecha2')))
Acd(fv:1, Fbn('Fecha2'))
endif
proximo
endif
endif

