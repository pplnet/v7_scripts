creardialogo
nroperacion1: 'Nro.Op'
operador:'Autoriz.por:'
string:'Excepcion'
findialogo
if (not ok)
Cancelar()
endif

sql.add("Update "~Dbo()~".EXCEPCIONES set Autorizado='"~dialogo.operador~"' where ")
if (Eqstr(dialogo.string, 'Credito'))
sql.add("Tipo in (Select Codigo from "~Dbo()~".TIPOSEXCEPCION where Tipo='C')")
endif
if (Eqstr(dialogo.string, 'Posicion'))
sql.add("Tipo in (Select Codigo from "~Dbo()~".TIPOSEXCEPCION where Tipo='P')")
endif
sql.add("and NrOperacion='"~dialogo.nroperacion1~"'")
sql.new
if (Eqstr(dialogo.string, 'Credito'))
Acn(z1, sql("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1' and NrBit=3"))
endif
if (Eqstr(dialogo.string, 'Posicion'))
Acn(z1, sql("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1' and NrBit=3"))
endif
if (Val(z1) = 0)
sql.add("Update "~Dbo()~".OPERACIONES set ObservacDoc='Aprob# Riesgo', Direccion=0 where NrOperacion='"~dialogo.nroperacion1~"'")
sql.new
if (0 = sql("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1'"))
sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=7")
sql.new
endif
sql.exec
else
sql.add("Update "~Dbo()~".OPERACIONES set Direccion=1 where NrOperacion='"~dialogo.nroperacion1~"'")
sql.new
sql.exec
endif
if (Eqstr(dialogo.string, 'Credito'))
endif

