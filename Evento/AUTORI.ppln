creardialogo
nroperacion1: 'Nro.Op'
operador:'Autoriz.por:'
string:'Excepcion'
findialogo
if (not ok)
Cancelar()
endif

Sqladd("Update "~Dbo()~".EXCEPCIONES set Autorizado='"~dialogo.operador~"' where ")
if (Eqstr(dialogo.string, 'Credito'))
Sqladd("Tipo in (Select Codigo from "~Dbo()~".TIPOSEXCEPCION where Tipo='C')")
endif
if (Eqstr(dialogo.string, 'Posicion'))
Sqladd("Tipo in (Select Codigo from "~Dbo()~".TIPOSEXCEPCION where Tipo='P')")
endif
Sqladd("and NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
if (Eqstr(dialogo.string, 'Credito'))
Acn(z1, Query("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1' and NrBit=3"))
endif
if (Eqstr(dialogo.string, 'Posicion'))
Acn(z1, Query("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1' and NrBit=3"))
endif
if (Val(z1) = 0)
Sqladd("Update "~Dbo()~".OPERACIONES set ObservacDoc='Aprob# Riesgo', Direccion=0 where NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
if (0 = Query("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~dialogo.nroperacion1~"' and Valor='1'"))
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=7")
Sqlnew()
endif
Sqlexec()
else
Sqladd("Update "~Dbo()~".OPERACIONES set Direccion=1 where NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()
endif
if (Eqstr(dialogo.string, 'Credito'))
endif

