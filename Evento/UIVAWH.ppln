Sqladd(" SELECT O.TipoOp,C.NrCuota,Sum(C.Precio1) as Precio1,Sum(C.Precio2) as Precio2,Sum(C.Precio3) as Precio3 ")
Sqladd(" FROM "~Dbo()~".CUOTAS C, "~Dbo()~".OPERACIONES O WHERE ")
Sqladd(" C.NrOperacion=O.NrOperacion and O.OperacionRef='"~dialogo.nroperacion1~"' ")
Sqladd(" Group By O.TipoOp,C.NrCuota")

