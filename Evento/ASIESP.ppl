CrearDialogo
  Fecha1        : 'F.Op Desde'       ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys-30
  Fecha2        : 'F.Op Hasta'       ; ; ;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  NrOperacion1  : 'Nr.Emision'       ; ; ;;;;NoVacio(Dialogo.NrOperacion1) y SQL("Select 1 FROM "~DBO~".Operaciones WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and TipoOp='TCPCEM' ")=1;'Operacion incorrecta';NO;;;;;;" TipoOp in ('TCPCEM') and FechaOp>="~IdxDate2(Dialogo.Fecha1)~" and FechaOp<="~IdxDate2(Dialogo.Fecha2);
  Especie2      : 'Especie Anterior' ; ; ;;NO;;;;;;SQL("SELECT Especie FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ");
  Especie1      : 'Nueva Especie'    ; ; ;;;;NoVacio(Dialogo.Especie1) y Not EQSTR(Dialogo.Especie1,Dialogo.Especie2);'Especie Inválida';NO;;;;;;" Jerarquia LIKE '"~Var('JERTITULOS')~"%'";
FinDialogo

if not OK
  Cancelar
endif

**Buscar las TMANIF que tiene asociada la TCPCEM
SQL.ADD("SELECT  NrOrden NrTManif, NrOperacion1 NrTcpcem,NrOperacion2 NrTcopri FROM  "~DBO~".ORDENES  ")
SQL.ADD("WHERE NrOperacion1   = '"~Dialogo.NrOperacion1~"' ")

Recorrer sql

  * Actalizando TMANIF
  Message('Actual1zando Manifestacion')
  SQL.ADD(" UPDATE "~DBO~".ORDENES SET                  ")
  SQL.ADD(" Especie         = '"~Dialogo.Especie1~"' ")
  SQL.ADD(" WHERE NrOrden  = '"~fbn['NrTmanif']~"' ")
  SQL.NEW
   
  if NoVacio(FBN['NrTcopri'])
      * Actualizo TCOPRI
      Message('Actualizando Colocaciones '~FBN['NrTcopri'])
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET                  ")
      SQL.ADD(" Especie            = '"~Dialogo.Especie1~"' ")
      SQL.ADD(" WHERE NrOperacion   =  '"~fbn['NrTcopri']~"' ")
      SQL.NEW

      * Actualizo Movimientos Pendientes TCOPRI
      SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET            ")
      SQL.ADD(" Especie            = '"~Dialogo.Especie1~"' ")
      SQL.ADD(" WHERE NrOperacion   =  '"~fbn['NrTcopri']~"' ")
      SQL.ADD("   and Especie='"~Dialogo.Especie2~"' ")
      SQL.NEW
      SQL.EXEC 
      
      SQL.ActualizarMovimientos2(fbn['NrTcopri'],NO,NO,NO,SI)
      SQL.EXEC 
      
      * Actualizo Movimientos Ejecutados TCOPRI
        SQL.ADD("SELECT        ")
        SQL.ADD("  NrOperacion, FechaMov  , Cliente , Especie , CallPut  ,")
        SQL.ADD(" FechaEj , PrecioEj  , Mercado  , EnteCustodia , Cantidad   ")
        SQL.ADD(",Formula  , Leyenda  , Bits  , NrSaldo , NrGrupo  , ")
        SQL.ADD("Concepto , FechaEje  , UsuarioEje  , Cuenta  , NrGrupo2 , Transaccion  ")
        SQL.ADD(",NrMov  , NrLiq  , Status  , NrComprob , NrInstan  , Cupon ,")
        SQL.ADD("NrTrans2  , Book  , Vehiculo  ")
        SQL.ADD("FROM "~DBO~".MOVEJECUTADOS " )
        SQL.ADD(" WHERE NrOperacion   =  '"~fbn['NrTcopri']~"' ")
        SQL.ADD("   and Especie='"~Dialogo.Especie2~"' ")
       
        Recorrer SQL
     
            SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS  (        ")
            SQL.ADD(" NrOperacion  , FechaMov  , Cliente , Especie , CallPut, ")
            SQL.ADD(" FechaEj , PrecioEj  , Mercado  , EnteCustodia , Cantidad, ")
            SQL.ADD(" Formula  , Leyenda  , Bits  , NrSaldo , NrGrupo  , ")
            SQL.ADD(" Concepto , FechaEje  , UsuarioEje  , Cuenta  , NrGrupo2 , Transaccion,  ")
            SQL.ADD(" NrMov, NrLiq  , Status  , NrComprob , NrInstan  , Cupon , ")
            SQL.ADD(" NrTrans2  , Book  , Vehiculo  ")
           
            SQL.ADD(") values (                                                                           ")
            SQL.ADD(" '"~fbn['NrOperacion']~"', "~IdxDate2(fbn['FechaMov'])~",  '"~fbn['Cliente']~"',  '"~Dialogo.Especie1~"' ,  '"~fbn['CallPut']~"',")
            SQL.ADD(" "~IdxDate2(fbn['FechaEj'])~", "~FSTR(fbn['PrecioEj'],0,8)~",  '"~fbn['Mercado']~"', '"~fbn['EnteCustodia']~"',  "~FSTR(fbn['Cantidad'],0,2)~",")
            SQL.ADD(" '"~fbn['Formula']~"', '"~fbn['Leyenda']~"',  '"~fbn['Bits']~"', "~FSTR(fbn['NrSaldo'],1,0)~",  "~FSTR(fbn['NrGrupo'],1,0)~",")
            SQL.ADD(" '"~fbn['Concepto']~"', "~IdxDate2(fbn['FechaEje'])~",  '"~fbn['UsuarioEje']~"', '"~fbn['Cuenta']~"',  "~FSTR(fbn['NrGrupo2'],1,0)~",'"~fbn['Transaccion']~"',")
            SQL.ADD(" '"~fbn['NrMov']~"', '"~fbn['NrLiq']~"',  '"~fbn['Status']~"', '"~fbn['NrComprob']~"',  '"~fbn['NrInstan']~"','"~fbn['Cupon']~"', ")
            SQL.ADD(" '"~fbn['NrTrans2']~"','"~fbn['Book']~"','"~fbn['Vehiculo']~"') ")
            SQL.NEW
            
            * Revisar si hay que buscar el voucher que está en NrTrans2        
            
            
            SQL.ADD("DELETE  "~DBO~".MOVEJECUTADOS ")
            SQL.ADD(" WHERE NrOperacion   =  '"~fbn['NrOperacion']~"' ")
            SQL.ADD("   AND ESPECIE ='"~fbn['Especie']~"' ")
            SQL.ADD("   AND Especie='"~Dialogo.Especie2~"' ")
            SQL.NEW
     
        Proximo
    else
       Message('No hay Colocaciones asociadas')
    endif    

    * Actualizo TCPCEM
    Message('Actualizando Emisiones')
    SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET                  ")
    SQL.ADD(" Especie            = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" WHERE NrOperacion   =  '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW

    * Actualizo Movimientos Pendientes TCPCEM
    SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET                  ")
    SQL.ADD(" Especie            = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" WHERE NrOperacion   = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and Especie='"~Dialogo.Especie2~"' ")
    SQL.NEW

    * Actualizo Movimientos Ejecutados TCPCEM
    SQL.ADD("SELECT        ")
    SQL.ADD("  NrOperacion  , FechaMov  , Cliente , Especie , CallPut  ,")
    SQL.ADD(" FechaEj , PrecioEj  , Mercado  , EnteCustodia , Cantidad,   ")
    SQL.ADD(" Formula  , Leyenda  , Bits  , NrSaldo , NrGrupo, ")
    SQL.ADD(" Concepto , FechaEje  , UsuarioEje  , Cuenta  , NrGrupo2 , Transaccion,  ")
    SQL.ADD(" NrMov  , NrLiq  , Status  , NrComprob , NrInstan  , Cupon ,")
    SQL.ADD(" NrTrans2  , Book  , Vehiculo  ")
    SQL.ADD("FROM "~DBO~".MOVEJECUTADOS " )
    SQL.ADD(" WHERE NrOperacion   = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and Especie='"~Dialogo.Especie2~"' ")

    Recorrer sql
        SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS  (        ")
        SQL.ADD(" NrOperacion  , FechaMov  , Cliente , Especie , CallPut,")
        SQL.ADD(" FechaEj , PrecioEj  , Mercado  , EnteCustodia , Cantidad,   ")
        SQL.ADD(" Formula  , Leyenda  , Bits  , NrSaldo , NrGrupo, ")
        SQL.ADD(" Concepto , FechaEje  , UsuarioEje  , Cuenta  , NrGrupo2 , Transaccion,  ")
        SQL.ADD(" NrMov  , NrLiq  , Status  , NrComprob , NrInstan  , Cupon ,  ")
        SQL.ADD(" NrTrans2  , Book  , Vehiculo  ")

        SQL.ADD(") values (                                                                           ")
        SQL.ADD(" '"~fbn['NrOperacion']~"', "~IdxDate2(fbn['FechaMov'])~",  '"~fbn['Cliente']~"',  '"~Dialogo.Especie1~"' ,  '"~fbn['CallPut']~"',")
        SQL.ADD(" "~IdxDate2(fbn['FechaEj'])~", "~FSTR(fbn['PrecioEj'],0,8)~",  '"~fbn['Mercado']~"', '"~fbn['EnteCustodia']~"',  "~FSTR(fbn['Cantidad'],0,2)~",")
        SQL.ADD(" '"~fbn['Formula']~"', '"~fbn['Leyenda']~"',  '"~fbn['Bits']~"', "~FSTR(fbn['NrSaldo'],1,0)~",  "~FSTR(fbn['NrGrupo'],1,0)~",")
        SQL.ADD(" '"~fbn['Concepto']~"', "~IdxDate2(fbn['FechaEje'])~",  '"~fbn['UsuarioEje']~"', '"~fbn['Cuenta']~"',  "~FSTR(fbn['NrGrupo2'],1,0)~",'"~fbn['Transaccion']~"',")
        SQL.ADD(" '"~fbn['NrMov']~"', '"~fbn['NrLiq']~"',  '"~fbn['Status']~"', '"~fbn['NrComprob']~"',  '"~fbn['NrInstan']~"','"~fbn['Cupon']~"', ")
        SQL.ADD(" '"~fbn['NrTrans2']~"','"~fbn['Book']~"','"~fbn['Vehiculo']~"') ")
        SQL.NEW
        
        * Revisar si hay que buscar el voucher que está en NrTrans2               
        
        SQL.ADD("DELETE  "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE NrOperacion   = '"~Dialogo.NrOperacion1~"' ")
        SQL.ADD("   AND ESPECIE ='"~fbn['ESPECIE']~"' ")
        SQL.ADD("   AND Especie='"~Dialogo.Especie2~"' ")
        SQL.NEW
       
     Proximo

