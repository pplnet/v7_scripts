sql.add("Update "~Dbo()~".MOVEJECUTADOS ")
sql.add("   Set Transaccion = '"~Val(a1)~"' ")
sql.add("  from "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
sql.add("  where M.NrTrans2 = T.NrTrans ")
sql.add("  and   T.NrTrans = B.NrOperacion ")
sql.add("  and   M.NrOperacion = O.NrOperacion ")
sql.add("  and   B.NrBit = 12 ")
sql.add("  and   B.Valor = '1' ")
sql.add("  and   T.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' ")

if (NoVacio(dialogo.cliente1))
sql.add(" and   T.Cliente1 = '"~dialogo.cliente1~"' ")
endif

if (NoVacio(dialogo.especie1))
sql.add("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (dialogo.radio6 = 0)
sql.add("  and M.Cliente = O.Cliente1 ")
sql.add("  and M.Cliente = T.Cliente1 ")
else
if (dialogo.radio6 = 1)
sql.add(" and M.Cliente = O.Cliente2 ")
sql.add("  and   M.Cliente = T.Cliente1 ")
else
sql.add("  and M.Cliente = O.Cliente1 ")
sql.add("  and T.Cliente1='"~dialogo.cliente1~"' ")
endif
endif









sql.add("  and (M.Transaccion is Null or M.Transaccion = ' ') ")
sql.new

sql.add("Update "~Dbo()~".MOVEJECUTADOS ")
sql.add("   Set Transaccion = '"~Val(a1)~"' ")
sql.add("  from "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
sql.add("  where M.NrTrans2 = T.NrTrans ")
sql.add("  and   T.NrTrans = B.NrOperacion ")
sql.add("  and   M.NrOperacion = O.NrOperacion ")
sql.add("  and   B.NrBit = 12 ")
sql.add("  and   B.Valor = '1' ")
sql.add("  and   T.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' ")

if (NoVacio(dialogo.cliente1))
sql.add(" and   T.Cliente1 = '"~dialogo.cliente1~"' ")
endif

if (NoVacio(dialogo.especie1))
sql.add("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (dialogo.radio6 = 0)
sql.add("  and M.Cliente = O.Cliente1 ")
sql.add("  and M.Cliente = T.Cliente1 ")
else
if (dialogo.radio6 = 1)
sql.add(" and M.Cliente = O.Cliente2 ")
sql.add("  and   M.Cliente = T.Cliente1 ")
else
sql.add("  and M.Cliente = O.Cliente1 ")
sql.add("  and T.Ley4 In ("~pipe2comillas(Var('RUECPC1'))~")  ")
endif
endif



sql.add("  and (M.Transaccion is Null or M.Transaccion = ' ') ")
sql.new


sql.exec

