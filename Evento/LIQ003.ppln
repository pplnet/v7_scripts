Sqladd("Update "~Dbo()~".MOVEJECUTADOS ")
Sqladd("   Set Transaccion = '"~Val(a1)~"' ")
Sqladd("  from "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
Sqladd("  where M.NrTrans2 = T.NrTrans ")
Sqladd("  and   T.NrTrans = B.NrOperacion ")
Sqladd("  and   M.NrOperacion = O.NrOperacion ")
Sqladd("  and   B.NrBit = 12 ")
Sqladd("  and   B.Valor = '1' ")
Sqladd("  and   T.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' ")

if (NoVacio(dialogo.cliente1))
Sqladd(" and   T.Cliente1 = '"~dialogo.cliente1~"' ")
endif

if (NoVacio(dialogo.especie1))
Sqladd("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (dialogo.radio6 = 0)
Sqladd("  and M.Cliente = O.Cliente1 ")
Sqladd("  and M.Cliente = T.Cliente1 ")
else
if (dialogo.radio6 = 1)
Sqladd(" and M.Cliente = O.Cliente2 ")
Sqladd("  and   M.Cliente = T.Cliente1 ")
else
Sqladd("  and M.Cliente = O.Cliente1 ")
Sqladd("  and T.Cliente1='"~dialogo.cliente1~"' ")
endif
endif









Sqladd("  and (M.Transaccion is Null or M.Transaccion = ' ') ")
Sqlnew()

Sqladd("Update "~Dbo()~".MOVEJECUTADOS ")
Sqladd("   Set Transaccion = '"~Val(a1)~"' ")
Sqladd("  from "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
Sqladd("  where M.NrTrans2 = T.NrTrans ")
Sqladd("  and   T.NrTrans = B.NrOperacion ")
Sqladd("  and   M.NrOperacion = O.NrOperacion ")
Sqladd("  and   B.NrBit = 12 ")
Sqladd("  and   B.Valor = '1' ")
Sqladd("  and   T.Fecha1 <= '"~IdxDate(dialogo.fecha1)~"' ")

if (NoVacio(dialogo.cliente1))
Sqladd(" and   T.Cliente1 = '"~dialogo.cliente1~"' ")
endif

if (NoVacio(dialogo.especie1))
Sqladd("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (dialogo.radio6 = 0)
Sqladd("  and M.Cliente = O.Cliente1 ")
Sqladd("  and M.Cliente = T.Cliente1 ")
else
if (dialogo.radio6 = 1)
Sqladd(" and M.Cliente = O.Cliente2 ")
Sqladd("  and   M.Cliente = T.Cliente1 ")
else
Sqladd("  and M.Cliente = O.Cliente1 ")
Sqladd("  and T.Ley4 In ("~Pipe2Comillas(Var('RUECPC1'))~")  ")
endif
endif



Sqladd("  and (M.Transaccion is Null or M.Transaccion = ' ') ")
Sqlnew()


Sqlexec()

