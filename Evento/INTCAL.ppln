creardialogo
directorio1:"Ruta";;;;;;;;;;Var('PATHINTCAL')
fecha1:"Fecha";;;;;;;;;;FSys()


findialogo


if (not ok)
Cancelar()
endif

let(&fecha, Copy(dialogo.fecha1, 1, 2)~Copy(dialogo.fecha1, 4, 2))

Act(az1, 'CallOperAct|CallOperPas|CallCuoAct|CallCuoPas|')
Acn(az3, 1)
recorrer&k 1, Elementos(Val(az1))
Act(az2, ItemLista(Val(az1), &k))
if (Val(az4) = 0)
if (existearchivo(dialogo.directorio1~Val(az2)~&fecha~".txt"))
if (Messagebox('Ya existen archivos generados para este dia ¿Desea reprocesar?', 1, 2) = 6)
Acn(az4, 1)
else
Acn(az3, 0)
break
endif
endif
else
break
endif

proximo
if (Val(az3) = 1)
recorrer&l 1, Elementos(Val(az1))
Act(az2, ItemLista(Val(az1), &l))
if (existearchivo(dialogo.directorio1~Val(az2)~&fecha~".txt"))
borrararchivo(dialogo.directorio1~Val(az2)~&fecha~".txt")
endif
proximo
Dfa()
AbrirAscii(dialogo.directorio1~"CallOperAct"~&fecha~".txt")

Sqladd("SELECT * FROM "~Dbo()~".OPERACIONES Where TipoOp = 'MMCO' AND FechaOp <= '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha1)~"' <= FechaVto ")
recorrer sql
Act(a:fac, '54')
Act(b:fac, '319')
Act(c:fac, '1')
Act(d:fac, '60')
if (Eqstr(Fbn()['Especie'], 'USD'))
Act(e:fac, '2')
else
Act(e:fac, '0')
endif
Act(f:fac, Pad0(Query("SELECT ValorSistemaExterno FROM "~Dbo()~".CONFIGVALEXTERNOS WHERE Valor = (SELECT TipoDocum FROM "~Dbo()~".CLIENTES WHERE Codigo = '"~Fbn()['Cliente1']~"') AND CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO'"), 5))
Act(g:fac, Pad0(Query("SELECT CUIT FROM "~Dbo()~".Clientes Where Codigo = '"~Fbn()['Cliente1']~"'"), 17))
Act(h:fac, Pad0(Fbn()['NrOperacion'], 10))
Act(i:fac, '1')
Act(j:fac, '1')
Act(k:fac, '1')
Act(l:fac, Fecha(Fbn()['FechaOp']))
Act(m:fac, FStr(Fbn()['Precio4'], null, 4))
Act(n:fac, '0')
Act(o:fac, '1')
Act(p:fac, '1')
Act(q:fac, '1')
Act(r:fac, '1')
Act(s:fac, '1')
Act(t:fac, '1')

EscribirAscii(Val(a:fac)~'*~*'~Val(b:fac)~'*~*'~Val(c:fac)~'*~*'~Val(d:fac)~'*~*'~Val(e:fac)~'*~*'~Val(f:fac)~'*~*'~Val(g:fac)~'*~*'~Val(h:fac)~'*~*'~Val(i:fac)~'*~*'~Val(j:fac)~'*~*'~Val(k:fac)~'*~*'~Val(l:fac)~'*~*'~Val(m:fac)~'*~*'~Val(n:fac)~'*~*'~Val(o:fac)~'*~*'~Val(p:fac)~'*~*'~Val(q:fac)~'*~*'~Val(r:fac)~'*~*'~Val(s:fac)~'*~*'~Val(t:fac))
Ifa()
proximo
CerrarAscii()

