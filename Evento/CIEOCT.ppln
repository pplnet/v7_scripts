MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';;;;;;EsHabil(dialogo.fecha1, 'ARG') y dialogo.fecha1 <= FSys() y EsHabil(dialogo.fecha1, 'ARG');'Fecha Invalida';NO;FSys()
vehiculo1:'Vehiculo';2;1;;NO;SI;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
check1:'Porcesa';;;;NO;NO;;;;1
check2:'Automatico';;;;NO;NO;;;;0
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

Act(y1, Fecha(Hoy()))
Act(y2, Copy(Val(y1), 9, 2)~Copy(Val(y1), 4, 2)~Copy(Val(y1), 1, 2))
Act(z1, Hora(Ahora()))
Act(z2, Copy(Val(z1), 1, 2)~Copy(Val(z1), 4, 2)~Copy(Val(z1), 7, 2))

if (Query(" Select 1 From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CIED' ") = 1)
if (dialogo.check2 = 0)
Cancelar('El Cierre Del Dia ya ha sido procesado')
else
Message('El Cierre Del Dia ya ha sido procesado')
Cancelar()
endif
endif
if (Query(" Select 1 From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'FIND' ") <> 1)
if (dialogo.check2 = 0)
if (Messagebox('No se ha recibido el Fin Del Dia desde el MAE, Desea continuar?', 3, 2) = 7)
Cancelar('Evento Cierre OCT Cancelado')
endif
else
Message('No Se Ha Recibido El Fin Del Dia Desde el MAE.')
Message('Evento Cierre OCT Cancelado')
Cancelar()
endif
endif
if (Query(" Select 1 From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' ") = 0)
if (dialogo.check2 = 0)
Messagebox('No se ha realizado la Conciliacion con MAE')
if (dialogo.check1 = 1)
Cancelar()
endif
else
Message('No se ha realizado la Conciliacion con MAE')
if (dialogo.check1 = 1)
Cancelar()
endif
endif
else
if (not Eqstr(Query(" Select Estado From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' "), 'OK'))
if (Eqstr(Query(" Select Estado From "~Dbo()~".FLAGSOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' and Registro = 'CONC' "), 'MAN'))
if (dialogo.check2 = 0)
Messagebox('La Conciliacion con MAE fue realizada Manualmente')
else
Message('La Conciliacion con MAE fue realizada Manualmente')
endif
else
if (dialogo.check2 = 0)
Messagebox('La Conciliacion con MAE no esta OK')
if (dialogo.check1 = 1)
Cancelar()
endif
else
Message('La Conciliacion con MAE no esta OK')
if (dialogo.check1 = 1)
Cancelar()
endif
endif
endif
endif
endif

Act(v:1, 'Max.Paso')
Act(v:2, 'Merc.OCT')
Act(v:3, 'Cuenta')
Act(v:4, 'MTM 1')
Act(v:5, 'MTM 2')
Act(v:6, 'Cant.LIQOCT')
Act(v:7, 'Lista LIQOCT')
Act(v:8, 'Veh.Exluido')
Act(v:9, 'Ult.Fila')
Act(v:10, 'Multil.MAE')
Act(v:11, 'Ut.MTM.MAE')
Act(v:12, 'Ut.GAR.MAE')
Act(v:13, 'Cobrado')
Act(v:14, 'Pagado')

Act(s:1, 'Nr.Trans.')
Act(s:2, 'Tipo Trans')
if (dialogo.check1 = 1)
Ejecutarevento('LIQUI1', 'vehiculo1', dialogo.vehiculo1, 'fecha1', dialogo.fecha1, 'cliente1', '', 'especie1', '', 'mercado1', Var('MERCOCT'), 'check10', 1, 'check9', 0, 'check5', 0, 'check6', 0, 'check8', 1, 'check7', 1)
endif

Acn(w:1, Query(" Select Max(Paso) From "~Dbo()~".MTMOCT Where Fecha = '"~IdxDate(dialogo.fecha1)~"' "))

SetFilaActual(0)
Act(w:2, Var('MERCOCT'))
Act(w:3, CuentaCliente(dialogo.vehiculo1, 'ARP', '', Val(w:2)))

Acn(w:4, 0)
Acn(w:5, 0)
Acn(w:6, 0)

Sqladd(" Select NrTrans, Cambio1 Paso, Cantidad1, Cliente1 ")
Sqladd("   From "~Dbo()~".TRANSACCIONES2 T1 ")
Sqladd("  Where T1.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("    and T1.TipoTr2 = 'LIQOCT' ")
Sqladd("    and T1.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("    and T1.Cambio1 = 0 ")
Sqladd("    and T1.Cantidad1 <> 0 ")
Sqladd(" Order By NrTrans ")
recorrer sql
Scn(w:6, 1)
Act(a:fac, Fbn('NrTrans'))
Act(b:fac, Fbn('Cliente1'))
Acn(c:fac, Fbn('Paso'))
Acn(d:fac, Fbn('Cantidad1'))
Scn(w:4, Val(d:fac))
Sqladd(" Select Monto,UtilizadoMTM,UtilizadoGAR,Excluido From "~Dbo()~".MTMOCT ")
Sqladd("  Where Fecha   = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("    and Cliente = '"~Fbn('Cliente1')~"' ")
Sqladd("    and Paso    = "~FStr(Val(w:1), 0, 0)~" ")
Sqladd("    and (Especie Is Null OR Especie = '' OR Especie = ' ') ")
Sqladd("    and (TipoNegociacion Is Null OR TipoNegociacion = '' OR TipoNegociacion = ' ') ")
Sqladd("    and (Variable Is Null OR Variable = '' OR Variable = ' ') ")
Sqladd("  ")
recorrer sql
Dfa()
Acn(g:fac, Fbn('Monto'))
Acn(h:fac, Fbn('UtilizadoMTM'))
Acn(i:fac, Fbn('UtilizadoGAR'))
if (Fbn('Monto') >= 0)
Scn(w:13, Fbn('Monto'))
else
Scn(w:14, Fbn('UtilizadoMTM'))
endif
if (Eqstr(Copy(Fbn('Excluido'), 2, 1), 'S'))
Act(w:8, 'S')
endif
proximo
Act(w:7, Val(w:7)~'|'~Fbn('NrTrans'))
proximo
if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES Where NrOperacion IN ("~Pipe2Comillas(Val(w:7))~") and NrSaldo = 1 ") = 1)
if (dialogo.check2 = 0)
Messagebox('Hay Liquidaciones OCT Pendientes de Liquidar')
Cancelar('Evento Cierre OCT Cancelado')
else
Message('Hay Liquidaciones OCT Pendientes de Liquidar')
Message('Evento Cierre OCT Cancelado')
Cancelar()
endif
endif

if (Val(w:6) > 0)
recorrer&i 1, Val(w:6)
if (Val(d:&i) >= 0)
Acn(f:&i, Val(g:&i))
else
if (Val(w:1) = 0)
Acn(f:&i, Val(g:&i))
else
Acn(j:&i, Val(h:&i) / Val(w:14))
Acn(k:&i, -Val(w:13) * Val(j:&i))
Acn(f:&i, Val(g:&i))
endif
endif
Scn(w:5, Val(f:&i))
proximo
Sqladd("Select Monto,UtilizadoMTM,UtilizadoGAR From "~Dbo()~".MTMOCT ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and Paso = "~FStr(Val(w:1), 0, 0)~" ")
Sqladd("   and (Cliente Is Null OR Cliente = '' OR Cliente = ' ') ")
Sqladd("   and (Especie Is Null OR Especie = '' OR Especie = ' ') ")
Sqladd("   and (TipoNegociacion Is Null OR TipoNegociacion = '' OR TipoNegociacion = ' ') ")
Sqladd("   and (Variable Is Null OR Variable = '' OR Variable = ' ') ")
recorrer sql
Dfa()
Acn(w:10, Fbn('Monto'))
Acn(w:11, Fbn('UtilizadoMTM'))
Acn(w:12, Fbn('UtilizadoGAR'))
proximo
if (Val(w:11) - Val(w:14) > 0.01 o Val(w:11) - Val(w:14) < -0.01)
if (dialogo.check2 = 0)
Messagebox('Diferencia ente Monto Pagado ('~PYC(Val(w:14), 1, 2)~') y UtilizadoMTM ('~PYC(Val(w:11), 1, 2)~')')
else
Message('Diferencia ente Monto Pagado ('~PYC(Val(w:14), 1, 2)~') y UtilizadoMTM ('~PYC(Val(w:11), 1, 2)~')')
endif
endif
endif

Acn(w:9, Fac())
Ifa()
Act(a:fac, 'MULTILATERAL')
Act(c:fac, '')
Acn(d:fac, Val(w:4))
Acn(f:fac, Val(w:5))
SetFont(a:1..k:fac, 1)
SetFont(a:fac, 3)
FormatoCeldas(d:1..k:fac, Exe('F2'))
FormatoCeldas(j:1..j:fac, Exe('F6'))

repetir
if (Val(w:6) > 0)
if (dialogo.check2 = 0)
crearlistbox;'Arial,8,';'Cierre OCT del Dia '~dialogo.fecha1
'Transaccion';a:1..a:fac;NO;;;90;string;;RGB(450, 200, 250);
'Agente';b:1..b:fac;NO;;;70;string;;RGB(450, 200, 250);
'Paso';c:1..c:fac;NO;;;40;numero;'##';RGB(450, 200, 250);
'Cantidad Liquidada';d:1..d:fac;NO;;;120;numero;'###,###,###,###.##';RGB(450, 200, 250);
'Cantidad Confirmada';f:1..f:fac;;((Val(d:flb) > 0 y Val(f:flb) >= 0 y Val(f:flb) <= Val(d:flb)) o (Val(d:flb) < 0 y Val(f:flb) <= 0 y Val(f:flb) >= Val(d:flb))) o (flb = Fac());'Cantidad Confirmada Invalida';120;numero;'###,###,###,###.##';RGB(600, 200, 250);iif (flb = Fac(), Sum(f:1..f:Val(w:9)), Val(f:flb));
finlistbox
if (not ok)
if (dialogo.check1 = 1)
Ejecutarevento('ALIQAU', 'fecha1', dialogo.fecha1)
Cancelar('Evento Cierre OCT Cancelado')
endif
endif
endif
else
if (dialogo.check1 = 1)
Sqladd(" Insert Into "~Dbo()~".FLAGSOCT ( ")
Sqladd(" Fecha,    Registro, Paso,      Cantidad, ")
Sqladd(" FechaMAE, HoraMAE,  Secuencia, Estado    ")
Sqladd(" ) Values ( ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd(" 'CIED', ")
Sqladd(" 0, ")
Sqladd(" 0, ")
Sqladd(" '"~Val(y2)~"', ")
Sqladd(" '"~Val(z2)~"', ")
Sqladd(" Null, ")
Sqladd(" Null ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
endif
if (dialogo.check2 = 0)
Messagebox('No Hay Liquidaciones OCT para el dia solicitado')
else
Message('No Hay Liquidaciones OCT para el dia solicitado')
endif
Cancelar()
endif

Acn(x1, 0)
if (not Eqstr(Val(w:8), 'S'))
if (Round(Val(f:Val(w:9) + 1), 2) <> Round(Val(w:10), 2))
if (dialogo.check2 = 0)
if (Messagebox('El ultimo multilateral recibido desde el MAE (Paso '~FStr(Val(w:1), 0, 0)~') es de '~PYC(Val(w:10), 0, 2)~' y el calculado por el Cierre es de '~PYC(Val(f:Val(w:9) + 1), 0, 2)~', Desea Continuar?', 3, 2) = 7)
Acn(x1, 1)
endif
else
Message('El ultimo multilateral recibido desde el MAE (Paso '~FStr(Val(w:1), 0, 0)~') es de '~PYC(Val(w:10), 0, 2)~' y el calculado por el Cierre es de '~PYC(Val(f:Val(w:9) + 1), 0, 2))
endif
endif
endif

recorrer&k 1, Val(w:9)
if (Val(x1) = 0)
if (Round(Val(g:&k), 2) <> Round(Val(f:&k), 2))
if (not Eqstr(Val(w:8), 'S') o Val(d:&k) > 0)
if (dialogo.check2 = 0)
if (Messagebox('El bilateral del MAE con el agente '~Val(b:&k)~' es de '~PYC(Val(g:&k), 0, 2)~' Y el Ingresado en el Cierre es de '~PYC(Val(f:&k), 0, 2)~', Desea Continuar?', 3, 2) = 7)
Acn(x1, 1)
endif
else
Message('El bilateral del MAE con el agente '~Val(b:&k)~' es de '~PYC(Val(g:&k), 0, 2)~' Y el Ingresado en el Cierre es de '~PYC(Val(f:&k), 0, 2))
endif
endif
endif
endif
proximo
if (Val(x1) = 0 o dialogo.check2 = 1)
break
endif
proximo

SetFont(a:1..k:fac, 1)
SetFont(a:fac, 3)
FormatoCeldas(d:1..k:fac, Exe('F2'))
FormatoCeldas(j:1..j:fac, Exe('F6'))

recorrer&k 1, Val(w:9)
Sqladd("Select NrTrans,TipoTr2 ")
Sqladd("  From "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Where TipoTr2         IN ('FXDEP','FXRET') ")
Sqladd("   and NrOperacionRef1 =  '"~Val(a:&k)~"' ")
recorrer sql
Dfa()
Act(t:1, Fbn('NrTrans'))
Act(t:2, Fbn('TipoTr2'))
proximo
if (dialogo.check1 = 1)
if (Val(d:&k) = Val(f:&k))
Message('Confirmando Voucher '~Val(t:1))
Sqladd("Delete from "~Dbo()~".INSTANCIASOP ")
Sqladd("Where NrOperacion = '"~Val(nv:1)~"' ")
if (Eqstr(Val(tv:1), 'DEP'))
Sqladd("and NrInstancia = 3 ")
else
Sqladd("and NrInstancia = 6 ")
endif
Sqlnew()
Sqladd("Insert into "~Dbo()~".INSTANCIASOP (")
Sqladd("NrOperacion, ")
Sqladd("NrInstancia, ")
Sqladd("Usuario, ")
Sqladd("Mensaje, ")
Sqladd("Fecha ")
Sqladd(") Values (")
Sqladd("'"~Val(nv:1)~"', ")
if (Eqstr(Val(tv:1), 'DEP'))
Sqladd("3, ")
else
Sqladd("6, ")
endif
Sqladd("'"~UsuarioActivo()~"', ")
Sqladd("'Confirmacion de Voucher', ")
Sqladd(""~SQLFechaStr(Fecha(FSys())~' '~Hora(Ahora()))~"")
Sqladd(")")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".TRANSACCIONES2 ")
Sqladd("SET CB9 = '1', Fecha3 = '"~IdxDate(FSys())~"', Cantidad4 = "~FStr(Abs(Val(f:&k)), 0, 0)~" ")
Sqladd("Where NrTrans = '"~Val(nv:1)~"' ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '0' ")
Sqladd("where NrOperacion = '"~Val(nv:1)~"' ")
if (Eqstr(Val(tv:1), 'DEP'))
Sqladd("and NrBit = 3 ")
else
Sqladd("and NrBit = 6 ")
endif
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("SET Valor = '1' ")
Sqladd("where NrOperacion = '"~Val(nv:1)~"' ")
Sqladd("and NrBit = 4 ")
Sqlnew()
Sqlexec()

else
Message('Fallando Voucher '~Val(t:1))
if (Val(d:&k) > 0)
Ejecutarevento('INGPAR', 'nrtrans1', Val(t:1), 'radio1', 0, 'cantidad2', Abs(Val(f:&k)), 'check1', 1)
endif
if (Val(d:&k) < 0)
Ejecutarevento('INGPAR', 'nrtrans1', Val(t:1), 'radio1', 0, 'cantidad2', Abs(Val(f:&k)), 'check1', 1)
endif
endif
Sqladd("Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd("   Set NrTransRef1 = '"~Val(t:1)~"', ")
Sqladd("       Cantidad2   = "~FStr(Val(f:&k), 0, 2)~" ")
Sqladd(" Where NrTrans     = '"~Val(a:&k)~"' ")
Sqlnew()
Sqlexec()
endif
proximo

if (dialogo.check1 = 1)
Ejecutarevento('FALLAC', 'vehiculo1', dialogo.vehiculo1, 'fecha1', dialogo.fecha1)
endif

if (dialogo.check1 = 1)
Sqladd(" Insert Into "~Dbo()~".FLAGSOCT ( ")
Sqladd(" Fecha,    Registro, Paso,      Cantidad, ")
Sqladd(" FechaMAE, HoraMAE,  Secuencia, Estado    ")
Sqladd(" ) Values ( ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd(" 'CIED', ")
Sqladd(" 0, ")
Sqladd(" 0, ")
Sqladd(" '"~Val(y2)~"', ")
Sqladd(" '"~Val(z2)~"', ")
Sqladd(" Null, ")
Sqladd(" Null ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
endif

SetFont(s:1..z:15, 1)
FormatoCeldas(w:4..w:5, Exe('F2'))
FormatoCeldas(w:10..w:14, Exe('F2'))

ACO(4, 10)
ACO(6, 10)
ACO(7, 10)
ACO(8, 10)
