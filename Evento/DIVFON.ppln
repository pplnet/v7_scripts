Sqladd("Select * from "~Dbo()~".RESULTADOS R1 ")
Sqladd(" where R1.TipoResultado = '"~Val(r:2)~"' ")
Sqladd("   and R1.Especie  =  '"~Val(h:2)~"' ")
Sqladd("   and R1.Vehiculo =  '"~Val(f:2)~"' ")
Sqladd("   and R1.Book     =  '"~Val(g:2)~"' ")
Sqladd("   and R1.NrSaldo  in (121,131) ")
Sqladd("   and R1.Fecha    >= "~IdxDate2(Val(az:7))~" ")
Sqladd("   and R1.Fecha    = (select Max(Fecha) ")
Sqladd("                       from  "~Dbo()~".RESULTADOS R2 ")
Sqladd("                       where R2.Especie       =  R1.Especie ")
Sqladd("                        and  R2.Vehiculo      =  R1.Vehiculo ")
Sqladd("                        and  R2.Book          =  R1.Book ")
Sqladd("                        and  R2.NrSaldo       =  R1.NrSaldo ")
Sqladd("                        and  R2.TipoResultado =  R1.TipoResultado ")
Sqladd("                        and  R2.TipoNegocio   =  R1.TipoNegocio ")
Sqladd("                        and  R2.Fecha       <= "~IdxDate2(Val(c:2))~" ) ")
Sqladd(" Order By Fecha ")
recorrer sql
Dfa()
if (Fbn('NrSaldo') = 121)
Acn(x1, 2)
else
Acn(x1, 3)
endif
Scn(ad:Val(x1), 1)
Acd(ae:Val(x1), Fbn('Fecha'))
Acn(af:Val(x1), Fbn('Day'))
Acn(ag:Val(x1), Fbn('MTD'))
Acn(ah:Val(x1), Fbn('YTD'))
proximo

recorrer&i 2, 3

