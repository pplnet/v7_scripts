Sqladd(" Select * from "~Dbo()~".OPERACIONES ")
Sqladd(" Where NrOperacion <> '"~dialogo.nroperacion1~"' ")
Sqladd("   and TipoOp    = '"~Fbn('TipoOp')~"' ")
Sqladd("   and FechaOp   = "~IdxDate2(Fbn('FechaOp'))~" ")
Sqladd("   and Vehiculo1 = '"~Fbn('Vehiculo1')~"' ")
Sqladd("   and Book1     = '"~Fbn('Book1')~"' ")
Sqladd("   and Especie   = '"~Fbn('Especie')~"' ")
Sqladd("   and CB7       = '"~Fbn('CB7')~"' ")
