if (Fac() > 1)
Acn(az:4, 0)
Acn(az:4, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo='MESINIEJE' "))
if (Val(az:4) = 0)
Acn(az:5, 1)
else
Acn(az:5, Var('MESINIEJE'))
endif
if (Val(az:5) < 1 o Val(az:5) > 12)
Acn(az:5, 1)
endif
if (Mes(Val(c:2)) >= Val(az:5))
Act(az:6, '01/'~Pad0(FStr(Val(az:5), 1, 0), 2)~'/'~FStr(Anio(Val(c:2)), 4, 0))
else
Act(az:6, '01/'~Pad0(FStr(Val(az:5), 1, 0), 2)~'/'~FStr(Anio(Val(c:2)) - 1, 4, 0))
endif
Acd(az:7, Fecha(Val(az:6)))

recorrer&i 2, Fac()
if (dialogo.radio1 = 1 y &i = 2)
Acn(p:&i, 0)
Acn(q:&i, 0)
else
Acn(p:&i, Val(m:&i) * CotizacionC(Val(j:&i), null, null, null, Val(c:&i), 1, SI, 'ARP'))
Acn(q:&i, Val(m:&i) * CotizacionC(Val(j:&i), null, null, null, Val(c:&i), 1, SI, 'USD'))
endif
