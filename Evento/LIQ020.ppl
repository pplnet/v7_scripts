            SQL.ADD(" ) ")
            SQL.ADD("SELECT FechaMov, Cliente,                              Vehiculo,    Sector, ")
            SQL.ADD("       NrSaldo,  Especie,                              FechaEj,     PrecioEj, ")
            SQL.ADD("       CallPut,  "~Fstr(Val(pr:12)*-val(ab:&i),0,2)~", Precio,      Estrategia, ")
            SQL.ADD("       Book,     TipoNegocio,                          NrOperacion, Cupon ")
            SQL.ADD("  from "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion  =  '"~Val(b:&i)~"' ")
            SQL.ADD("   and NrSaldo      in (51) ")
            SQL.ADD("   and FechaMov     =  "~idxdate2(Val(i:&i))~" ")
*            SQL.ADD("   and Responsable  =  'AUX' ")
            SQL.ADD("   and Cantidad     <> "~Fstr(Val(pr:12)*-val(ab:&i),0,2)~" ")
            SQL.NEW

            if Val(j:&i)<=FSYS
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE  ")
            else
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN  ")
            endif
            SQL.ADD(" ( ")
            SQL.ADD(" FechaMov, Cliente,     Vehiculo,    Sector, ")
            SQL.ADD(" NrSaldo,  Especie,     FechaEj,     PrecioEj, ")
            SQL.ADD(" CallPut,  Cantidad,    Precio,      Estrategia, ")
            SQL.ADD(" Book,     TipoNegocio, NrOperacion, Cupon ")
            SQL.ADD(" ) ")
            SQL.ADD("SELECT "~idxdate2(Val(j:&i))~", Cliente,                             Vehiculo,    Sector, ")
            SQL.ADD("       NrSaldo,                 Especie,                             FechaEj,     PrecioEj, ")
            SQL.ADD("       CallPut,                 "~Fstr(Val(y:&i)*-val(ab:&i),0,2)~", Precio,      Estrategia, ")
            SQL.ADD("       Book,                    TipoNegocio,                         NrOperacion, Cupon ")
            SQL.ADD("  from "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion  =  '"~Val(b:&i)~"' ")
            SQL.ADD("   and NrSaldo      in (51) ")
            SQL.ADD("   and FechaMov     =  "~idxdate2(Val(i:&i))~" ")
*            SQL.ADD("   and Responsable  =  'AUX' ")
            SQL.ADD("   and Cantidad     <> "~Fstr(Val(pr:12)*-val(ab:&i),0,2)~" ")
            SQL.NEW

            SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion =  '"~Val(b:&i)~"' ")
            SQL.ADD("   and NrSaldo     in (51) ")
            SQL.ADD("   and FechaMov    =  "~idxdate2(Val(i:&i))~" ")
*            SQL.ADD("   and Responsable =  'AUX' ")
            SQL.ADD("   and Cantidad     <> "~Fstr(Val(pr:12)*-val(ab:&i),0,2)~" ")
            SQL.NEW
            SQL.EXEC
          Endif
            
          *Marca de operacion diferida
          SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
          SQL.ADD("   Set FechaAltaSisExterno = "~idxdate2(Val(i:&i))~", ")
          SQL.ADD("       Convenio            = '1', ")
          SQL.ADD("       FechaVto            = "~idxdate2(Val(j:&i))~", ")
** FJL 06/06/19 - Para Informe Fails
          SQL.ADD("       ConceptoFail        = '"~Val(af:&i)~"' ")
          SQL.ADD(" WHERE NrOperacion         = '"~Val(b:&i)~"' ")
          SQL.NEW
          SQL.EXEC

          ***---CUOTAS: F1=Vto.Ori, F2=Fsys, F3=F.Valor Contable
          ACN(NC:1, SQL(" Select Max(NrCuota) From "~DBO~".CUOTAS Where NrOperacion = '"~Val(b:&i)~"' ") + 1)
          ***---Guardo el diferimento
          SQL.ADD("Insert Into "~DBO~".CUOTAS ( ")
          SQL.ADD("  NrOperacion, NrCuota, Check1, Fecha1, ")
          SQL.ADD("  Fecha2, Cliente1, Fecha3 ")
          SQL.ADD("  ) Values (")
          SQL.ADD("  '"~Val(b:&i)~"', ")
          SQL.ADD("  "~Fstr(Val(NC:1), 0, 0)~", ")
          SQL.ADD("  '1', ")
          SQL.ADD("  '"~IdxDate(Val(i:&i))~"', ")

          SQL.ADD("  '"~IdxDate(Fsys)~"', ")
          SQL.ADD("  'DAC', ")
          SQL.ADD("  '"~IdxDate(Val(j:&i))~"' ")
          SQL.ADD("  ) ")

          SQL.NEW
          SQL.EXEC
        else
          MessageBox('No procesa linea '~FStr(&i,1,0)~' - Dif. Proporcional')
        Endif
      Endif
    Endif
Proximo

if Dialogo.Check2=1
  Messagebox('Los datos se actualizaron con éxito')
else
