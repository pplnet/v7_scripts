MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:       'FechaVto'          ;;;;  ;  ;SI o Dialogo.Fecha1 >= Fsys;'FechaVto Invalida';NO;fsys
   Cliente1:     'Cliente'           ;;;;  ;  ;;;;
   Vehiculo1:    'Vehiculo'          ;;;;  ;  ;;;;
   Mercado1 :    'Mercado'           ;;;;  ;  ;NoVacio(Dialogo.Mercado1) y EqStr(BuscarCampo('MERCADOS','NETEA','Codigo',Dialogo.Mercado1),'SI');'Si desea Seleccionar debe ingresar Mercado que Netea';NO;VAR('MERNETEODE');;;;;" NETEA='SI' "
   NrOperacion1: 'Operacion'         ;;;;  ;  ;;;;;;;;;" NrOperacion in (SELECT NrOperacion from "~DBO~".MOVPENDIENTES where OPERACIONES.NrOperacion=MOVPENDIENTES.NrOperacion) and TipoOP in ('TIC','TIV','TIFC','TIFV','TCOPRI')"
   Check1:       'Dif. Proporcional' ;;;;  ;  ;;;;0 
   Check2:       'Procesa'           ;;;;NO;NO;;;;1
FinDialogo
If not OK
   Cancelar
Endif
if Dialogo.Check2=0
  HojaVisible(SI)
endif

If Dialogo.Check1 = 0
    * Diferimiento Individual (No Proporcional)
    ***** Armo Query *****
    SQL.ADD("Select MP.NrOperacion,  MP.FechaMov, MP.Cliente,     MP.Especie, MP.Mercado, ")
    SQL.ADD("       MP.EnteCustodia, MP.Cantidad, MP.Leyenda,     MP.Bits,    MP.NrSaldo, ")
    SQL.ADD("       MP.Cuenta,       MP.NrMov,    MP.Transaccion, MP.Book,    MP.Vehiculo, ")
    SQL.ADD("       MP.NrGrupo,      MP.Concepto, MP.Status,      MP.Cupon,   MP.Formula, ")
    SQL.ADD("       MP.NrGrupo2,     MP.NrInstan, ")
** FJL 04/06/19 - Para Informe Fails
    SQL.ADD("       O.ConceptoFail ")
    SQL.ADD("  from "~DBO~".MOVPENDIENTES MP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B ,"~DBO~".OPERACIONES O      ")
    SQL.ADD(" where MP.Cliente    = C.Codigo                                                                           ")
    If Novacio(Dialogo.NrOperacion1)
      SQL.ADD("     AND MP.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    Endif
    SQL.ADD("       AND MP.NrOperacion = B.NrOperacion                 ")
    SQL.ADD("       AND MP.NrOperacion = O.NrOperacion                 ")
    SQL.ADD("       AND B.NrBit       = 10                             ")
    SQL.ADD("       AND B.Valor       = '1'                            ")
    SQL.ADD("       AND MP.FechaMov   = "~idxdate2(Dialogo.Fecha1)~"   ")
    SQL.ADD("       AND O.TipoOp In ('TIC','TIV','TIFV','TIFC','TCOPRI')  ")
    If NoVacio(Dialogo.Vehiculo1)
       SQL.ADD("    AND MP.EnteCustodia = '"~Dialogo.Vehiculo1~"'   ")
    Endif
    If Novacio(Dialogo.Cliente1)
      SQL.ADD("     AND MP.Cliente = '"~Dialogo.Cliente1~"'         ")
    Endif
    SQL.ADD("       AND O.Mercado = '"~Dialogo.Mercado1~"'             ")
    * Podria estar parcialmente liquidado
    *SQL.ADD(" and    O.NrOperacion not in (select NrOperacion from  "~DBO~".MOVEJECUTADOS M             ")
    *SQL.ADD("                              where  M.NrOperacion = O.NrOperacion AND NrSaldo IN (1,31) ) ")
    * solo puedo tener un movimiento a liquidar
    SQL.ADD("       AND Exists (SELECT 1 FROM "~DBO~".MOVPENDIENTES MP2   ")
    SQL.ADD("                    WHERE MP2.NrOperacion=MP.NrOperacion     ")
    SQL.ADD("                      AND MP2.Especie=MP.Especie             ")
    SQL.ADD("                    GROUP BY MP2.NrOperacion, MP2.Especie    ")
    SQL.ADD("                   HAVING COUNT(1)=1 )                       ")
    SQL.ADD(" ORDER BY MP.NrOperacion                              ")
else
    * Diferimiento Proporcional
    SQL.ADD("Select distinct O.TipoOp, O.NrOperacion, O.Mercado,             O.FechaOp,       O.FechaVto, ")
    SQL.ADD("       O.Cliente1,        O.Precio1,     O.Especie,             O.ContraEspecie, O.Cantidad, ")
    SQL.ADD("       O.TotalNetoCli1,   C.RazonSocial, O.FechaAltaSisExterno, O.Book1,         ")
** FJL 04/06/19 - Para Informe Fails
    SQL.ADD("       O.ConceptoFail ")
    SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B, "~DBO~".MERCADOS M2 ")
    SQL.ADD(" where O.Cliente1    = C.Codigo ")
    SQL.ADD("   AND O.NrOperacion = B.NrOperacion ")
    SQL.ADD("   AND B.NrBit       = 10 ")
    SQL.ADD("   AND B.Valor       = '1' ")
    *--- Toma la fecha de vto original o la de diferimiento --- 
    SQL.ADD("   AND ((O.FechaVto  = "~idxdate2(Dialogo.Fecha1)~" ) OR (O.FechaAltaSisExterno="~idxdate2(Dialogo.Fecha1)~" AND O.FechaAltaSisExterno IS NOT NULL)) ")
    If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1   = '"~Dialogo.Vehiculo1~"'")
    Endif
    If novacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1    = '"~Dialogo.Cliente1~"' ")
    Endif
    SQL.ADD("   and O.TipoOp      In ('TIC','TIV','TIFV','TIFC','TCOPRI') ")
    SQL.ADD("   and O.Mercado     = '"~Dialogo.Mercado1~"' ")
    SQL.ADD("   and O.NrOperacion not in (select NrOperacion from "~DBO~".MOVEJECUTADOS M ")
    SQL.ADD("                              where M.NrOperacion = O.NrOperacion ")
    SQL.ADD("                                AND NrSaldo       IN (1,31) ) ")
    SQL.ADD(" order by O.NrOperacion ")
Endif
ACN(z:1, 0)

If Dialogo.Check1 = 0
    * Diferimiento Individual (No Proporcional)
    Recorrer SQL
       message(fbn('NrOperacion'))
       
       ACN(a:fac, 0)
       ACT(b:fac, fbn('NrOperacion') )
       ACT(c:fac, fbn('Especie')     )
       ACT(d:fac, fbn('Cliente')     )
       ACT(e:fac, fbn('Mercado')     )
       ACT(f:fac, fbn('EnteCustodia'))
       ACT(g:fac, fbn('Bits')        )
       ACN(h:fac, fbn('NrSaldo')     )
       ACT(i:fac, fbn('Cuenta')      )
       ACN(j:fac, fbn('NrMov')       )
       ACT(k:fac, fbn('Transaccion') )
       ACT(l:fac, fbn('Book')        )
       ACT(m:fac, fbn('Vehiculo')    )
       ACD(n:fac, fbn('FechaMov')    )
       ACD(o:fac, habiles(fbn('FechaMov'),1,'ARG',SI))
       ACN(p:fac, ABS(fbn('Cantidad'))  )
       ACN(q:fac, ABS(fbn('Cantidad'))  )
       If FBN('Cantidad')>0
          ACN(aa:fac,1)
       else
          ACN(aa:fac,-1)
       Endif   
       **campo para calculo de cantidad  
       ACT(r:fac, fbn('Leyenda')     )
       ACN(s:fac, fbn('NrGrupo')     )
       ACT(t:fac, fbn('Concepto')    )
       ACT(u:fac, fbn('Status')      )
       ACT(v:fac, fbn('Cupon')       )
       ACT(w:fac, fbn('Formula')     )
** FJL 04/06/19 - Para Informe Fails
       ACT(af:fac, fbn('ConceptoFail'))
       ACN(xx:fac, fbn('NrGrupo2')    )
       ACN(yy:fac, fbn('Nrinstan')    )
       ACN(z:1, 1)
    Proximo
else
    * Diferimiento Proporcional
    Recorrer SQL
       message(fbn('NrOperacion')     )
       
       ACN(a:fac, 0)
       ACT(b:fac, fbn('NrOperacion')  )
       ACT(c:fac, fbn('Cliente1')     )
       ACT(d:fac,  fbn('Mercado')     )
       ***Para la Especie
       ACT(e:fac, fbn('Especie')      )
       SQL.ADD("Select   MP.NrMov,   MP.Cantidad, MP.Mercado, MP.EnteCustodia, MP.Bits, ")
       SQL.ADD("         MP.NrSaldo, MP.Cuenta,   MP.Leyenda, MP.NrGrupo,      MP.Concepto, ")
       SQL.ADD("         MP.Cupon,   MP.NrGrupo2, MP.Status,  MP.Nrinstan ")
       SQL.ADD("  from  "~DBO~".MOVPENDIENTES MP ")
       SQL.ADD(" where MP.NrOperacion         = '"~ fbn('NrOperacion')~"' ")
       SQL.ADD("   AND MP.Especie             = '"~ fbn('Especie')~"' ")
       SQL.ADD("   AND Isnull(MP.NrComprob,0) < 1000 ")
       Recorrer SQL
         DFA
         ACT(ec:fac, fbn('Status')       )
         ACN(ee:fac, fbn('NrMov')       )
         ACN(ek:fac, fbn('Cantidad')    )
         ACN(en:fac,  ABS(val(ek:fac))    )
         ACT(ef:fac, fbn('EnteCustodia'))
         ACT(eg:fac, fbn('Bits')        )
         ACN(eh:fac, fbn('NrSaldo')     )
         ACT(ei:fac, fbn('Cuenta')      )
         ACT(ev:fac, fbn('Cupon')       )
         ACT(er:fac, fbn('Leyenda')     )
         ACN(es:fac, fbn('NrGrupo')     )
         ACT(et:fac, fbn('Concepto')    )
         ACN(ex:fac, fbn('NrGrupo2')    )
         ACN(ey:fac, fbn('Nrinstan')    )
         ACT(ez:fac, fbn('Mercado')    )
         If val(ek:fac)>0
            ACN(aa:fac,1)
         else
            ACN(aa:fac,-1)
         Endif
       Proximo 
       ACT(f:fac, fbn('ContraEspecie'))
       ***Para la contra Especie
       SQL.ADD("Select MP.NrMov,   MP.Cantidad, MP.Mercado, MP.EnteCustodia, MP.Bits, ")
       SQL.ADD("       MP.NrSaldo, MP.Cuenta,   MP.Leyenda, MP.NrGrupo,      MP.Concepto, ")
       SQL.ADD("       MP.Cupon,   MP.NrGrupo2, MP.Status,  MP.Nrinstan ")
       SQL.ADD("  from "~DBO~".MOVPENDIENTES MP ")
       SQL.ADD(" where MP.NrOperacion         = '"~ fbn('NrOperacion')~"' ")
       SQL.ADD("   AND MP.Especie             = '"~ fbn('ContraEspecie')~"' ")
       SQL.ADD("   AND Isnull(MP.NrComprob,0) < 1000 ")
       Recorrer SQL
         DFA
         ACT(cc:fac, fbn('Status')       )
         ACN(ce:fac, fbn('NrMov')       )
         ACN(cp:fac, fbn('Cantidad')    )
         ACN(cl:fac, ABS(val(cp:fac))     )
         ACT(cf:fac, fbn('EnteCustodia'))
         ACT(cg:fac, fbn('Bits')        )
         ACN(ch:fac, fbn('NrSaldo')     )
         ACT(ci:fac, fbn('Cuenta')      )
         ACT(cv:fac, fbn('Cupon')       )
         ACT(cr:fac, fbn('Leyenda')     )
         ACN(cs:fac, fbn('NrGrupo')     )
         ACT(ct:fac, fbn('Concepto')    )
         ACN(cx:fac,fbn('NrGrupo2')     )
         ACN(cy:fac,fbn('Nrinstan')     )
         ACT(cz:fac, fbn('Mercado')    )
         If val(cp:fac)>0
            ACN(ab:fac,1)
         else
            ACN(ab:fac,-1)
         Endif
       Proximo 
       ACN(g:fac, 0)
       ACT(h:fac, fbn('Book1')        )
       ACD(i:fac, fbn('FechaVto')     )
       ACD(j:fac, habiles(fbn('FechaVto'),1,'ARG',SI))
       ACN(m:fac, fbn('Precio1'))
       ACT(af:fac, fbn('ConceptoFail'))
       ACN(z:1, 1)
    Proximo
Endif


If Val(z:1)=0
   Cancelar('No se encontraron operaciones con vencimiento el '~Dialogo.Fecha1)
Endif


If Dialogo.Check1 = 0
    * Diferimiento Individual (No Proporcional)
    CrearListBox;'Arial,8,';'Diferimiento de Operaciones con fecha de movimiento al '~Dialogo.Fecha1
      'Mod.'            ; a:1..a:fac ;SI;;; 50;CHECK ;RGB(160,160,193)
      'NrOperacion'     ; b:1..b:fac ;NO;;; 70;STRING;;RGB(250,250,193)
      'Especie'         ; c:1..c:fac ;NO;;; 50;STRING;;RGB(250,250,193)
      'Cliente'         ; d:1..d:fac ;NO;;; 50;STRING;;RGB(250,250,193)
      'Mercado'         ; e:1..e:fac ;NO;;; 50;STRING;;RGB(250,250,193)
      'EnteCustodia'    ; f:1..f:fac ;NO;;; 60;STRING;;RGB(250,250,193)
      'Cuenta'          ; i:1..i:fac ;NO;;; 60;STRING;;RGB(250,250,193)
      'Leyenda'         ; r:1..r:fac ;NO;;;120;STRING;;RGB(250,250,193)
      'Book'            ; l:1..l:fac ;NO;;; 60;STRING;;RGB(250,250,193)
      'Fecha Mov'       ; n:1..n:fac ;NO;;; 90;FECHA;RGB(250,250,193)
      'F.Dif.Nueva'     ; o:1..o:fac ;SI;Val(o:flb) >= Val(n:flb);'Fecha nueva invalida'; 90;FECHA;RGB(160,160,193)
      'Cant.Pendiente'  ; p:1..p:fac ;NO;;;120;NUMERO;'##,###,###,###.##';RGB(250,250,193)
      'Cant. a diferir' ; q:1..q:fac ;SI;(Val(q:flb) > 0 y Val(q:flb) <= Val(p:flb) y Val(a:flb)=1 ) o Val(a:flb)=0;'Cantidad a diferir invalida';120;NUMERO;'##,###,###,###.##';RGB(160,160,193)
** FJL 04/06/19 - Para Informe Fails
      'Concepto Fail  ' ;af:1..af:fac;SI;NoVacio(Val(af:flb)) o Val(a:flb)=0;'Debe ingresar un concepto de Fail';60 ;TABLA;'CONCEPTOSFAILS';'Codigo';'Codigo;Descripcion';;RGB(160,160,193);;;
    FinListBox
else
    * Diferimiento Proporcional
    CrearListBox;'Arial,8,';'Diferimiento proporcional de Operaciones con fecha de movimiento al '~Dialogo.Fecha1
      'Mod.'            ;a:1..a:fac  ;SI;;; 50;CHECK ;RGB(160,160,193)
      'NrOperacion'     ;b:1..b:fac  ;NO;;; 70;STRING;;RGB(250,250,193)
      'Cliente'         ;c:1..c:fac  ;NO;;; 50;STRING;;RGB(250,250,193)
      'Mercado'         ;d:1..d:fac  ;NO;;; 50;STRING;;RGB(250,250,193)
      'Especie'         ;e:1..e:fac  ;NO;;; 50;STRING;;RGB(250,250,193)
      'C.Especie'       ;f:1..f:fac  ;NO;;; 65;STRING;;RGB(250,250,193)
      'Cantidad'        ;en:1..en:fac;NO;;;120;NUMERO;'##,###,###,###.##';RGB(250,250,193)
      'Cantidad C.E.'   ;cl:1..cl:fac;NO;;;120;NUMERO;'##,###,###,###.##';RGB(250,250,193)
      'Book'            ;h:1..h:fac  ;NO;;; 60;STRING;;RGB(250,250,193)
      'Fecha Vto'       ;i:1..i:fac  ;NO;;; 90;FECHA;RGB(250,250,193)
      'F.Dif.Nueva'     ;j:1..j:fac  ;SI;Val(j:flb) >= Val(i:flb);'Fecha nueva invalida'; 90;FECHA;RGB(160,160,193)
      'Cant. a diferir' ;g:1..g:fac  ;SI;(Val(g:flb) > 0 y Val(g:flb) <= Val(en:flb) y Val(a:flb)=1 ) o Val(a:flb)=0;'Cantidad a diferir invalida';120;NUMERO;'##,###,###,###.##';RGB(160,160,193);;;;'13,12';
      'Cant.dif.Moneda' ;y:1..y:fac  ;NO;;;120;NUMERO;'##,###,###,###.##';RGB(250,250,193);(val(cl:flb)/val(en:flb))*val(g:flb);NO;NO;
** FJL 04/06/19 - Para Informe Fails
      'Concepto Fail  ' ;af:1..af:fac;SI;NoVacio(Val(af:flb)) o Val(a:flb)=0;'Debe ingresar un concepto de Fail';60 ;TABLA;'CONCEPTOSFAILS';'Codigo';'Codigo;Descripcion';;RGB(160,160,193);;;
    FinListBox
Endif
If Not OK
   Cancelar
Endif
If Sum(a:1..a:fac)=0 
   Cancelar('No se difirieron operaciones')
Endif

Recorrer&i 1, fac
    If Val(a:&i)=1
      message('Actualizando Operacion '~Val(b:&i))
      If Dialogo.Check1 = 0
        ACT(x:&i, '')
        ********************
        * Diferimiento Individual (NO Proporcional)
        ********************
        ACN(pr:11, Val(p:&i) - Val(q:&i))
        If Dialogo.Check2 = 1
          If Val(p:&i) = Val(q:&i)
            ********************
            * Diferimiento Individual - Total
            ********************
            SQL.ADD("Update "~DBO~".MOVPENDIENTES                      ")
            SQL.ADD("   Set FechaMov    = "~idxdate2(Val(o:&i))~",     ")
            SQL.ADD("       NrComprob   = "~Fstr(1000+Val(j:&i),1,0)~" ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"'              ")
            SQL.ADD("   AND Especie     = '"~Val(c:&i)~"'              ")
            SQL.NEW

*** FJL 06/07/18 - Por Nuevas Posiciones para POSPOR
            *  Esto es por si estuvieran Pendientes. Si ya estamos en la fecha de vto de la operacion deberiane estar todos ejecutados
            SQL.ADD("UPDATE "~DBO~".MOVPOSPEN ")
            SQL.ADD("   Set FechaMov    = "~idxdate2(Val(o:&i))~"  ")
            SQL.ADD(" WHERE NrOperacion =  '"~Val(b:&i)~"' ")
*** FJL 17/01/19 - Depende si estoy difiriendo titulos o moneda
            if DesciendeDeEspecie(Val(c:&i),'TITULO')
              SQL.ADD("   and NrSaldo     in (102,172,192,122) ")
            else
              SQL.ADD("   and NrSaldo     in (51) ")
            endif
            SQL.ADD("   and FechaMov    =  "~idxdate2(Val(n:&i))~" ")
            SQL.NEW

            if Val(o:&i)<=FSYS
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE  ")
            else
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN  ")
            endif
            SQL.ADD("(FechaMov, Cliente, Vehiculo, Sector, ")
            SQL.ADD(" NrSaldo, Especie, FechaEj, PrecioEj, ")
            SQL.ADD(" CallPut, Cantidad, Precio, Estrategia, ")
            SQL.ADD(" Book, TipoNegocio, NrOperacion, Cupon) ")
            SQL.ADD("SELECT "~idxdate2(Val(o:&i))~", Cliente, Vehiculo, Sector, ")
            SQL.ADD("       NrSaldo, Especie, FechaEj, PrecioEj, ")
            SQL.ADD("       CallPut, Cantidad, Precio, Estrategia, ")
            SQL.ADD("       Book, TipoNegocio, NrOperacion, Cupon ")
            SQL.ADD("  from "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion  = '"~Val(b:&i)~"'        ")
*** FJL 17/01/19 - Depende si estoy difiriendo titulos o moneda
            if DesciendeDeEspecie(Val(c:&i),'TITULO')
              SQL.ADD("   and NrSaldo     in (102,172,192,122) ")
            else
              SQL.ADD("   and NrSaldo     in (51) ")
            endif
            SQL.ADD("   and FechaMov    = "~idxdate2(Val(n:&i))~" ")
            SQL.NEW

            SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"'         ")
*** FJL 17/01/19 - Depende si estoy difiriendo titulos o moneda
            if DesciendeDeEspecie(Val(c:&i),'TITULO')
              SQL.ADD("   and NrSaldo     in (102,172,192,122) ")
            else
              SQL.ADD("   and NrSaldo     in (51) ")
            endif
            SQL.ADD("   and FechaMov    = "~idxdate2(Val(n:&i))~" ")
            SQL.NEW
          Else
            ********************
            * Diferimiento Individual - Parcial
            ********************
            SQL.ADD("UPDATE "~DBO~".MOVPENDIENTES                                ")
            SQL.ADD("   Set Cantidad      = "~Fstr(Val(pr:11)*val(aa:&i),0,2)~", ")
            SQL.ADD("       NrComprob     = "~Fstr(Val(j:&i),1,0)~"              ")
            SQL.ADD(" WHERE NrOperacion   = '"~Val(b:&i)~"'                      ")
            SQL.ADD("   AND Especie       = '"~Val(c:&i)~"'                      ")
            SQL.NEW
              
            SQL.ADD(" Insert into "~DBO~".MOVPENDIENTES                 ")
            SQL.ADD(" ( ")
            SQL.ADD(" NrOperacion, Especie, Cliente, Mercado, EnteCustodia,  ")
            SQL.ADD(" Bits, NrSaldo, Cuenta, NrMov,                     ")
            SQL.ADD(" Book,  FechaMov, Cantidad, Leyenda,               ")
            SQL.ADD(" NrGrupo, Concepto, Cupon, NrComprob,              ")     
            SQL.ADD(" NrGrupo2,nrinstan ")
            SQL.ADD(" ) values ( ")
            * NrOperacion
            SQL.ADD(" '"~Val(b:&i)~"', ")
            SQL.ADD(" '"~Val(c:&i)~"', ")
            SQL.ADD(" '"~Val(d:&i)~"', ")
            SQL.ADD(" '"~Val(e:&i)~"', ")
            * Bits
            SQL.ADD(" '"~Val(f:&i)~"', ")
            SQL.ADD(" '"~Val(g:&i)~"', ")
            SQL.ADD(" "~fstr(Val(h:&i),0,0)~", ")
            SQL.ADD(" '"~Val(i:&i)~"', ")
            * Book
            SQL.ADD(" "~Fstr(Val(j:&i),0,0)~", ")
            SQL.ADD(" '"~Val(l:&i)~"', ")
            SQL.ADD(" "~idxdate2(Val(o:&i))~", ")
            SQL.ADD(" "~Fstr(Val(q:&i)*val(aa:&i),0,2)~", ")
            * NrGrupo
            SQL.ADD(" '"~Val(r:&i)~"', ")
            SQL.ADD(" "~FSTR(Val(s:&i),1,0)~", ")
            SQL.ADD(" '"~Val(t:&i)~"', ")
            SQL.ADD(" '"~Val(v:&i)~"', ")
            * NrGrupo2
            SQL.ADD(" "~Fstr(1000+Val(j:&i),1,0)~", ")
            SQL.ADD(" "~FSTR(Val(xx:&i),1,0)~" , ")
            SQL.ADD(" '"~Val(yy:&i)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
            SQL.EXEC
              
*** FJL 06/07/18 - Por Nuevas Posiciones para POSPOR
            *  Esto es por si estuvieran Pendientes. Sy ya estamos en la fecha de vto de la operacion deberiane estar todos ejecutados
            SQL.ADD("UPDATE "~DBO~".MOVPOSPEN ")
            SQL.ADD("   Set Cantidad    = "~Fstr(Val(pr:11)*-val(aa:&i),0,2)~" ")
            SQL.ADD(" WHERE NrOperacion =  '"~Val(b:&i)~"' ")
*** FJL 17/01/19 - Depende si estoy difiriendo titulos o moneda
            if DesciendeDeEspecie(Val(c:&i),'TITULO')
              SQL.ADD("   and NrSaldo     in (102,172,192,122) ")
            else
              SQL.ADD("   and NrSaldo     in (51) ")
            endif
            SQL.ADD("   and FechaMov    =  "~idxdate2(Val(n:&i))~" ")
            SQL.NEW

            if Val(o:&i)<=FSYS
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE  ")
            else
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN  ")
            endif
            SQL.ADD(" ( ")
            SQL.ADD(" FechaMov, Cliente,     Vehiculo,    Sector, ")
            SQL.ADD(" NrSaldo,  Especie,     FechaEj,     PrecioEj, ")
            SQL.ADD(" CallPut,  Cantidad,    Precio,      Estrategia, ")
            SQL.ADD(" Book,     TipoNegocio, NrOperacion, Cupon ")
            SQL.ADD(" ) ")
            SQL.ADD("SELECT "~idxdate2(Val(o:&i))~", Cliente, Vehiculo, Sector, ")
            SQL.ADD("       NrSaldo, Especie, FechaEj, PrecioEj, ")
            SQL.ADD("       CallPut, "~Fstr(Val(q:&i)*-val(aa:&i),0,2)~", Precio, Estrategia, ")
            SQL.ADD("       Book, TipoNegocio, NrOperacion, Cupon ")
