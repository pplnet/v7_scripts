Act(xz1, Query("SELECT CodigoBCRA FROM "~Dbo()~".CLIENTES WHERE Codigo='"~Var('VEHICULODE')~"' "))

Sqladd("SELECT '4601' as Campo1, CL.CodigoBCRA as Campo2,  CASE WHEN O.TipoOp = 'FXCF' THEN '1' ELSE '1' END as Campo4,  ")
if (Eqstr(Var('OPTERMA3'), 'SI'))
Sqladd(" CASE WHEN O.Mercado = 'ROFEX' THEN '11' WHEN O.Mercado = 'MAE' THEN '11' WHEN O.Mercado = 'A3' THEN '11' WHEN O.Mercado = 'BYMA' THEN '10' ELSE '00' END as Campo5,")
else
Sqladd(" CASE WHEN O.Mercado = 'ROFEX' THEN '02' WHEN O.Mercado = 'MAE' THEN '03' ELSE '00' END as Campo5,")
endif
Sqladd(" O.Especie as Campo7, O.ContraEspecie as Campo8, O.FechaVto as Campo9, ")
if (Eqstr(Var('OPTERMA3'), 'SI'))
Sqladd(" CASE WHEN O.Mercado = 'ROFEX' THEN '1' WHEN O.Mercado = 'MAE' THEN '1' WHEN O.Mercado = 'A3' THEN '1'ELSE '2' END as Campo10,")
else
Sqladd(" CASE WHEN O.Mercado = 'ROFEX' THEN '1' WHEN O.Mercado = 'MAE' THEN '1' ELSE '2' END as Campo10,")
endif
Sqladd(" CASE WHEN O.TipoOp = 'FXCF' THEN '1' WHEN O.TipoOp = 'FXVF' THEN '3' ELSE '0' END as Campo11,")
Sqladd(" O.Cantidad as Campo12, O.TotalBrutoCli1 as Campo13, ")
Sqladd(" O.NrOperacion3, O.Cliente1, O.CB10, O.TipoOp, O.NrOperacion, ")
Sqladd(" CL.Nacionalidad, CL.Sector, E1.ISO as ISO1, E2.ISO as ISO2, ")
Sqladd(" O.FechaOp as Campo14, CASE when O.Cliente1 = '"~Var('VEHICULODE')~"' then '00000000000' else CL.CUIT end as Campo15,")
Sqladd(" CASE when O.Cliente1 = '"~Var('VEHICULODE')~"' then '' else CL.RazonSocial end as Campo16, CL.Pais ")
Sqladd("FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES CL,"~Dbo()~".ESPECIES E1,"~Dbo()~".ESPECIES E2 ")
Sqladd("WHERE O.TipoOp IN ('FXCF','FXVF') ")
Sqladd("AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
Sqladd("AND O.FechaCargaSys >= "~IdxDate2(dialogo.fecha2)~" AND O.FechaCargaSys <= "~IdxDate2(dialogo.fecha1))
Sqladd("AND CL.Codigo = O.Cliente1 AND  E1.Codigo = O.Especie AND  E2.Codigo = O.ContraEspecie ")
Sqladd("order by Campo5,Cliente1,Campo9,Campo14 ")
Watch(Sqlbatch())

recorrer sql
