sql.add(" Select Distinct TipoTasa ")
sql.add(" from "~Dbo()~".ESPECIES ")
sql.add(" where TipoTasa is not null OR TipoTasa <> ''  ")
sql.add(" order by TipoTasa ")
recorrer sql

Act(b:1, Fbn('TipoTasa'))

Act(b:2, BuscarCampo('ESPECIES', 'Codigo', 'TipoTasa', Val(b:1)))
Act(b:3, BuscarCampo('ESPECIES', 'Cupon', 'TipoTasa', Val(b:1)))
Messagebox(Val(b:2))
Messagebox(Val(b:3))
Cancelar()(Val(b:1))

recorrer sql
Act(b:2, Fbn('Codigo'))
Act(b:3, Fbn('Cupon'))

Messagebox(Val(b:2))
Messagebox(Val(b:3))
