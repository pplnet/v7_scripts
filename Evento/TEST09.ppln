Sqladd(" Select Distinct TipoTasa ")
Sqladd(" from "~Dbo()~".ESPECIES ")
Sqladd(" where TipoTasa is not null OR TipoTasa <> ''  ")
Sqladd(" order by TipoTasa ")
recorrer sql

Act(b:1, Fbn('TipoTasa'))

