sql.add("Select Codigo, Cotiza  ")
sql.add("  From "~Dbo()~".ESPECIES E1 ")
sql.add(" where Codigo in(")
sql.add("                 Select distinct Codigo ")
sql.add("                   from "~Dbo()~".COTIZACIONES c2 ")
sql.add("                ) ")
sql.add("  and Cotiza is not  null ")
sql.add("  and Cotiza <>'      '")

