HojaVisible(NO)

creardialogo
string1:"Usuario";;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (Vacio(dialogo.string1))
Cancelar()('No Ingreso Usuario')
endif


Act(us1, Trim(Mirt(dialogo.string1)))


sql.add("Select M.*, B.Codigo, B.Nombre as PNombre from  "~Dbo()~".USUARIOS M, "~Dbo()~".PERFILES2 B ")
sql.add("where M.Codigo ='"~Val(us1)~"'  ")
sql.add("  and B.Codigo = M.Perfil ")

recorrer sql
Message(' Usuario '~Fbn()['Codigo']~' '~Fbn()['Nombre']~' ...')

Act(a:fac, Fbn()['Codigo'])
Act(b:fac, Fbn()['Nombre'])
Act(c:fac, Fbn()['Perfil'])
Act(d:fac, Fbn()['PNombre'])
Acn(k:fac, 1)

proximo

if (Fac() > 0)

crearlistbox;'Arial,10,B'
'Blanquea Passw';k1..k:fac;SI;SI;;120;combo;'Si|No|'
'Usuario';a1..a:fac;NO;SI;;110;string
'Nombre';b1..b:fac;NO;SI;;230;string
'Perfil';c1..c:fac;NO;SI;;100;string
'Rol';d1..d:fac;NO;SI;;230;string
finlistbox

if (ok)
recorrer&i 1, Fac()
if (Val(k:&i) = 0)
sql.add("Update "~Dbo()~".USUARIOS Set ")
sql.add("FPassword = NULL ")
sql.add("where Codigo ='"~Val(us1)~"'  ")
sql.new
sql.exec
Messagebox('Blanqueo Passw Exitoso para: '~Val(us1))
endif
proximo
else
Cancelar()
endif
else
Messagebox('Usuario Inexistente: '~Val(us1))

endif


