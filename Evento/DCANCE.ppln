sql.add("Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, TotalIntereses from "~Dbo()~".OPERACIONES where FechaVto = '"~IdxDate(FSys())~"'")
sql.add("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPFP','MMPO','MMAD','MMDES','MMCA')")
sql.add("and RB6 = '2'")
sql.add("order by Cliente1, Especie, TipoOp")

Acn(z1, 0)
recorrer sql
Act(a:fac, Fbn('Cliente1'))
Act(b:fac, Fbn('Especie'))
Act(c:fac, Fbn('TipoOp'))
Acn(d:fac, Fbn('Cantidad'))
Acn(e:fac, Fbn('Precio1'))
Acn(f:fac, Fbn('TotalIntereses'))
Acn(g:fac, Fbn('Plazo'))
Act(h:fac, Fbn('NrOperacion'))
Scn(z1, 1)
proximo


ACO(1, 10)
ACO(2, 6)
ACO(3, 6)
ACO(4, 12)
ACO(5, 10)
ACO(6, 10)
ACO(7, 5)
ACO(8, 8)

FormatoCeldas(d1..d:fac, exe('F2'))
FormatoCeldas(e1..e:fac, exe('F7'))
FormatoCeldas(f1..f:fac, exe('F2'))
FormatoCeldas(g1..g:fac, exe('F0'))

if (Val(z1) > 0)
listbox(a1..h:fac, 'Cliente      Especie TipoOp         Cantidad       Precio    Intereses  Plazo   #Oper.')
if (ok)
recorrersel
sql.add("Update "~Dbo()~".OPERACIONES set RB6 = '0' where NrOperacion = '"~Val(h:filaciclo)~"'")
sql.new
proximo
sql.exec
endif
else
Cancelar()('No existen operaciones')
endif

