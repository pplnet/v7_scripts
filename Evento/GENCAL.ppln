Act(t:26, FormaPago(Val(t:3), Val(t:6), 'PAG', Val(t:2)))
if (Vacio(Val(t:3)))
Act(t:45, 'Cliente no existente en FPA. Nr MAE : '~Val(w2))
endif
if (Eqstr(Val(t:2), 'MMCO'))
Acn(t:27, Val(t:22))
endif
Act(t:50, Fbn('CodigoRueda'))

Acn(z2, Query("Select Count(*) from "~Dbo()~".OPERACIONES where NroAltaMAE='"~Fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:8))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:4)~"' and CB5='1' "))
if (Val(z2) > 0)
Scn(z1, 1)
Acn(26 + fac:15, 1)
