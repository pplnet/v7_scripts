if (Vacio(Val(t:21)))
Act(t:21, UsuarioActivo())
Acn(26 + fac:21, 1)
endif
if (Eqstr(Val(t:3), 'USD'))
Acn(t:22, Val(t:12))
else
Acn(t:22, Val(t:12) * CotizacionC(Val(t:3), null, null, null, Val(t:8), 1, SI, 'USD'))
endif
Act(t:23, CuentaCliente(Val(t:18), Val(t:3), null, Val(t:6), Val(t:2)))
Act(t:24, CuentaCliente(Val(t:4), Val(t:3), null, Val(t:6), Val(t:2)))
