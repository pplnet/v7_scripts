Act(t:6, Query("Select MercadoDef from "~Dbo()~".ESPECIES where Codigo='"~Val(t:3)~"'"))
else
Scn(z1, 1)
Acn(26 + fac:6, 1)
endif
if (Incluido(Fbn('Moneda'), 'D'))
Act(t:7, 'USA')
else
if (Incluido(Fbn('Moneda'), '$'))
Act(t:7, 'ARG')
else
Scn(z1, 1)
Acn(26 + fac:7, 1)
endif
endif
if (Eqstr(Copy(Fbn('CodigoRegistro'), 3, 2), '05'))
Acd(t:8, Fecha(Fbn('Fecha_dd')~'/'~Fbn('Fecha_mm')~'/'~Fbn('Fecha_aa')))
else
Scn(z1, 1)
Acn(26 + fac:8, 1)
