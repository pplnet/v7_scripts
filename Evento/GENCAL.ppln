Acn(26 + fac:2, 1)
endif
endif
if (Eqstr(Fbn('Moneda'), 'D'))
Act(t:3, 'USD')
else
if (Eqstr(Fbn('Moneda'), '$'))
Act(t:3, 'ARP')
else
Scn(z1, 1)
Acn(26 + fac:3, 1)
endif
endif
