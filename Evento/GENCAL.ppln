if (dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".OPSIOPEL ")
Sqladd("   Set Procesado   = '1',")
Sqladd("       Carga       = '1', ")
Sqladd("       NrOperacion = 'DUPLIC' ")
Sqladd(" where Secuencia2  = '"~Val(a:fac)~"' ")
Sqlnew()
Sqlexec()
endif
endif

