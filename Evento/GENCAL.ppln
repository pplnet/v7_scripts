Sqladd("  where CodigoNego in ("~Pipe2Comillas(Var('TIPONEGCAL'))~") ")
Sqladd("    and Fecha      = '"~IdxDate(FSys())~"'                     ")
Sqladd("    and Carga       is null                                    ")
Sqladd("    and IsNull(Procesado,'0') = '0'                          ")
recorrer sql
Acn(z1, 0)
Act(a:fac, Fbn('Secuencia2'))
