endif
Acn(t:13, Fbn('Tasa'))
if (Val(t:13) = 0)
Scn(z1, 1)
Acn(26 + fac:13, 1)
endif
Acn(t:14, Val(t:12) * Val(t:13) * Val(t:9) / iif (Val(t:11) = 0, 36000, 36500))
Acn(t:15, Val(t:12) + Val(t:14))
Acn(t:17, Fbn('Valorizacion'))
Acn(t:16, Val(t:17) - Val(t:12))
if (Val(t:14) - Val(t:16) > 0.01 o Val(t:14) - Val(t:16) < -0.01)
endif
Act(t:18, Var('VEHICULODE'))
Act(t:19, iif (Eqstr(Val(t:18), 'INGBA'), 'BA', iif (Eqstr(Val(t:18), 'INGCURA'), 'CU', 'SB'))~'FD')
