Message('----- Corte de Posiciones Nuevas')

Sqladd(" SELECT P.* FROM "~Dbo()~".POSICIONES P ")
Sqladd("  WHERE P.Cliente         =  '"~Val(ak:fac)~"' ")
Sqladd("    AND P.Especie         =  '"~Val(bb:2)~"' ")
Sqladd("    AND P.Cupon           =  '"~FStr(Val(bc:2), 1, 0)~"' ")
Sqladd("    AND P.Vehiculo        =  '"~Val(ah:fac)~"' ")
Sqladd("    AND P.NrSaldo         >= 120 ")
Sqladd("    and P.NrSaldo         <  140 ")
Sqladd("    AND P.Fecha = (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES P1 ")
Sqladd("                    WHERE P1.Especie                = P.Especie ")
Sqladd("                      AND P1.Cupon                  = P.Cupon ")
Sqladd("                      AND P1.NrSaldo                = P.NrSaldo ")
Sqladd("                      AND P1.Cliente                = P.Cliente ")
Sqladd("                      AND P1.Vehiculo               = P.Vehiculo ")
Sqladd("                      AND IsNull(P1.Book,'')        = IsNull(P.Book,'') ")
Sqladd("                      AND IsNull(P1.TipoNegocio,'') = IsNull(P.TipoNegocio,'') ")
Sqladd("                      AND IsNull(P1.Trader,'')      = IsNull(P.Trader,'') ")
Sqladd("                      AND P1.Fecha <= '"~IdxDate(Val(bg:2))~"' ")
Sqladd("                  ) ")
Sqladd(" ORDER By Especie,Vehiculo,Book,NrSaldo")
recorrer sql
