* Solo si se corre solo y no es llamado por otro
If Dialogo.Check3=0
   If DesciendeDeEspecie(Val(bb:1),'MONEDA') y Eqstr(Val(ba:1),VAR('MERCADOBT'))
     * Fila consolidacion trnsferencia
     acn(bz:2,1)
     #ifdef BIND
        * Parámetros Salida
        * RR:1  'OK/NOK  
        * RR:2  'Mensaje'  

        * Parámetros entrada
        * RR:10  'Referencia'  
        * RR:11  'Sucursal'  
        * RR:12  'Cuenta(1a7)'    
        * RR:13  'SubOperacion-Cuenta (9a10)'
        * RR:14  'Moneda'
        * RR:15  'Importe'
        * RR:16  'Observaciones'
        * RR:17  'Importe a Bloquear'
        * RR:18  'Importe a Debitar / Acreditar'
        * RR:19  'Cliente'
        * RR:20  'Cuenta'
        * RR:21  'Especie'
        * RR:22  'Importe Bloqueado'
        * RR:23  'Importe Debitado / Acreditado'
        * RR:24  'Tipo operacion'
        * RR:25  'Mercado'
        * RR:26  'Tipo Transferencia'
        * RR:27  'Capital'
        * RR:28  'Comisiones'
        * RR:29  'Derechos'
        * RR:30  'Iva'
        * RR:31  'Intereses'
        * RR:32  'Cod Evento (producto)'
        * RR:33  'Fecha Valor'
      
        * Cliente / Especie / Cuenta / 
           *  Interfase Bantotal
           BorrarCeldas(rr:1..rr:50)
           ACT(rr:10, Val(bq:val(bz:2)))
           ACT(rr:12, Copy(Val(bh:val(bz:2)),1,7))
           ACT(rr:13, Copy(Val(bh:val(bz:2)),9,2))
           ACN(rr:17, Val(bw:val(bz:2)))
           ACN(rr:18, Val(bf:val(bz:2)))
           ACT(rr:19, Val(by:val(bz:2)))
           ACT(rr:20, Val(bh:val(bz:2)))
           ACT(rr:21, Val(bb:val(bz:2)))
           ACT(rr:25, Val(ba:1))
           ACT(rr:26, 'ANUEP2')
           ACT(rr:27, '0')
           ACT(rr:28, '0')
           ACT(rr:29, '0')
           ACT(rr:30, '0')
           ACT(rr:31, '0')
           ACT(rr:32, '0')
           ACT(rr:32, '2')
           ACT(rr:33, Dialogo.Fecha1)
           * Faltaria obtener el Id del vouconsolidados
           SQL.ADD("SELECT * FROM "~DBO~".VOUCONSOLIDADOS WHERE Id="~FSTR(val(bs:val(bz:2))))
           Recorrer SQL
              dfa
              act(rr:36, FBN['Transaccion'])
              act(rr:37, FBN['FechaCont'])
              act(rr:38, FBN['Modulo'])
              act(rr:39, FBN['Relacion'])
              act(rr:9, FBN['Id'])
           Proximo
           
           if Val(bw:val(bz:2))<>0
              * Desbloqueo de Saldo
              ACN(rr:15, ABS(Val(bw:val(bz:2))))
              ACT(rr:27, val(rr:15))
              if Dialogo.Check2=1
                 (.'BLOQSALCTA'.)
                 if Eqstr(Val(rr:1),'OK')
                    acn(rr:22, val(rr:17))
                 endif
              else
                 act(rr:1,'OK')
                 acn(rr:22, val(rr:17))
                 Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
              endif   
           else
              act(rr:1,'OK')
           endif   
           (.'ANULMOVCON'.)    
           SCN(bz:2,1)   
           ACN(bz:3,1)   
     #endif
   Endif          
Endif