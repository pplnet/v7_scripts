CrearDialogo
  NrTrans1 : 'Nro.Voucher' ;;;;;;Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'DEP|RET|COMP|MATCH');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('DEP','RET','COMP','MATCH') ";
  Check3   : 'Llamado'     ;;;;NO;NO;;;;0;
  Check2   : 'Interfase'   ;;;;NO;NO;;;;1;
  Fecha1   : 'Fecha'       ;;;;NO;NO;;;;FSys;
FinDialogo

if Dialogo.Check3=0
   #ifdef BIND
      Cancelar('Debe correr el evento de anulacion por Fecha')
   #endif
endif

if Not OK
  Cancelar
endif

if BuscarCampo('TRANSACCIONES2','CB9','NrTrans',Dialogo.NrTrans1)=1
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta confirmado')
endif

if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'DEP|RET|MATCH')
  ACT(x1, SQL("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrTrans1~"' and NrBit = 4 "))
  if EqStr(Val(x1),'1')
    Cancelar('El Voucher '~Dialogo.NrTrans1~' esta fallado')
  endif
endif

if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrOperacionRef1',Dialogo.NrTrans1),'DTP|RTP')
   ACT(x5,BuscarCampo('TRANSACCIONES2','NrTrans','NrOperacionRef1',Dialogo.NrTrans1) )

   SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("where NrOperacion = '"~Val(x5)~"'")
   SQL.NEW

   SQL.ADD("DELETE from "~DBO~".MOVPENDIENTES ")
   SQL.ADD("where NrOperacion =  '"~Val(x5)~"' ")
   SQL.NEW

   SQL.ADD("DELETE from "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("where NrTrans =  '"~Val(x5)~"'   ")
   SQL.NEW

   SQL.EXEC
Endif

*FO27/10/2005 - Restablece los limites de las operaciones

if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'COMP')
   SQL.ADD(" select NrOperacion from "~DBO~".MOVEJECUTADOS ")
   SQL.ADD(" where NrTrans2   = '"~Dialogo.NrTrans1~"'     ")
   SQL.ADD(" and NrOperacion <> '"~Dialogo.NrTrans1~"'     ")
   Recorrer SQL
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD("  SET RB10        = '0',  ")
      SQL.ADD("      FechaPrecan = Null ")  
      SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
      SQL.ADD("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
      SQL.NEW
      SQL.EXEC
      *** Actualiza movimientos y limites ****
      SQL.ActualizarMovimientos2(fbn['NrOperacion'],NO,SI,NO,NO)
      SQL.EXEC
   Proximo
Endif


*VP generacion 2016 - Restablece los  bits de las operaciones


   SQL.ADD(" select NrOperacion from "~DBO~".MOVEJECUTADOS ")
   SQL.ADD(" where NrTrans2   = '"~Dialogo.NrTrans1~"'     ")
   SQL.ADD(" and NrOperacion <> '"~Dialogo.NrTrans1~"'     ")
   Recorrer SQL
   
     SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("  SET valor        = 0 ")
      SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
      SQL.NEW

      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("  SET valor        = 1  ")
      SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' and NrBit = '10' ")
      SQL.NEW
 
 
     SQL.EXEC
   Proximo
   
   
