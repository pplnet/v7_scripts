Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTSFVV|'))
Cancelar('La operacion N# '~dialogo.nroperacion1~' No es un Swap Fijo Variable')
endif

if (BuscarCampo('Operaciones', 'CB6', 'NrOperacion', dialogo.nroperacion1) = 0)
Cancelar('La operacion N# '~dialogo.nroperacion1~' No es la operacion Original')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))
Acn(x2, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion2~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar('La Operacion Original Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (BuscarCampo('Operaciones', 'MB4', 'NrOperacion', dialogo.nroperacion1) = 0)
if (Val(x2) <> 20 y Val(x2) <> 50)
Cancelar('La Operacion Vinculada Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x2), 0, 0)~" AND Tabla='OPERACIONES'"))
endif
endif

if (ok)
Acn(x1, 0)


Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")

recorrer sql

if (not EsHabil(dialogo.fecha3, Fbn()['TablaFeriados1']))
Messagebox('FECHA SETTLEMENT NO HABIL EN TABLA DE FERIADOS '~Fbn()['TablaFeriados1'])
break
endif


Acn(x1, 1)

Acn(z24, 0)
Acn(z20, 0)

Message('Calculando interes .... ')

if (Fbn()['RB9'] = 1)
Acn(z11, (Fbn()['RB8'] + 1))
Acn(z24, ((Fbn()['Cantidad'] * (dialogo.precio2 + Fbn()['Spread'])) / 100) * FactorDias(Fbn()['FechaOp2'], Fbn()['FechaEj'], Val(z11)))
Act(z26, Fbn()['Especie'])
Acn(z27, Val(z24))
else
Acn(z11, (Fbn()['RB5'] + 1))
Acn(z24, ((Fbn()['TotalBrutoCli1'] * (dialogo.precio2 + Fbn()['TotalNetoCli2'])) / 100) * FactorDias(Fbn()['FechaOp2'], Fbn()['FechaEj'], Val(z11)))
Act(z26, Fbn()['ContraEspecie'])
Acn(z27, -Val(z24))
endif

Message('Calculando resultado .... ')
if (Eqstr(Fbn()['Especie'], Fbn()['ContraEspecie']))
if (Fbn()['RB9'] = 1)
Acn(z20, Fbn()['InteresesCorr'] - Val(z24))
else
Acn(z20, Val(z24) - Fbn()['TotalIntereses'])
endif
endif

Message('Actualizando la Opcion .... ')

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set CB8 = '1', ")
Sqladd("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("FechaPrecan = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("Precio4   = "~FStr(Val(z20), 0, 2)~", ")

if (Fbn()['RB9'] = 1)
Sqladd("Precio3   = "~FStr(dialogo.precio2, 0, 7)~",  ")
Sqladd("TotalIntereses   = "~FStr(Val(z24), 0, 7)~"  ")
else
Sqladd("TotalGanancias   = "~FStr(dialogo.precio2, 0, 7)~",  ")
Sqladd("InteresesCorr   = "~FStr(Val(z24), 0, 7)~"  ")
endif

Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
Sqladd("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', Val(az5), 'nroperacion1', Val(az3))
endif

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
