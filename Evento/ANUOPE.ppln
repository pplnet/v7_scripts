Sqladd(" Select OB.* From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd("  Where O.NrOperacion = OB.NrOperacion  ")
Sqladd("    and OB.NrBit=30  ")
Sqladd("    and OB.Valor = 1  ")
recorrer sql
try
Sqladd("DELETE "~Dbo()~".OPERACIONES WHERE Exists ")
Sqladd("           (SELECT 1 FROM "~Dbo()~".OPERACIONESBITS OB ")
Sqladd("             WHERE OPERACIONES.NrOperacion=OB.NrOperacion   ")
Sqladd("               and OPERACIONES.NrOperacion='"~Fbn()['NrOperacion']~"'")
Sqladd("               and OB.NrBit = 30 ")
Sqladd("               and OB.Valor = 1 )")
Sqlnew()
Sqlexec()
catch 
Message('Se está intentando eliminar una operacion liquidada '~Fbn()['NrOperacion'])
end
