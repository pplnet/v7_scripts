sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   AND O.Mercado  = '"~Val(a:&k)~"' ")
if (Eqstr(Val(b:&k), 'Moneda'))
sql.add(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(b:&k), 'Titulo'))
sql.add(" AND O.TipoOp IN ('TICF','TIVF') ")
