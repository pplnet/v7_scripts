MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';1;1;;;;EsHabil(dialogo.fecha1, 'ARG') y dialogo.fecha1 <= FSys();'Fecha Invalida';NO;FSys();
vehiculo1: 'Vehiculo:';2;1;;NO;SI;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
cliente1:'Cliente';3;1;;NO;NO;
check1:'Procesa';1;2;;NO;NO;;;;1;
check2:'Ejec.Liq.';2;2;;NO;NO;;;;1;
check3:'Contingencia';3;2;;NO;NO;;;;0;
lista1:'Mercado';;1;;SI;;;;;;;SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%'  and MTM in(1)  ")
lista2:'Producto';;1;;SI;;;;;;;'Titulo|Moneda'

findialogo

if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (Eqstr(Var('MTMRFXSIG'), 'SI'))
Acd(fe:3, Habiles(dialogo.fecha1, +1, 'ARG'))
else 
Acd(fe:3, dialogo.fecha1)
endif

if (Eqstr(Var('MTMMAESIG'), 'SI'))
Acd(fe:2, Habiles(dialogo.fecha1, +1, 'ARG'))
else 
Acd(fe:2, dialogo.fecha1)
endif


Act(aa1, Var('PATHLOGAUD')~'LOGMTM.TXT')
AbrirAscii(Val(aa1), 0)

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Comienzo Corrida MTMFUT ')

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")


Ejecutarevento('CALFUT', 'fecha1', dialogo.fecha1, 'vehiculo1', dialogo.vehiculo1, 'cliente1', '', 'check1', dialogo.check1, 'check2', dialogo.check2, 'check3', dialogo.check3, 'lista1', '', 'lista2', dialogo.lista2)


if (NoVacio(dialogo.lista1))
Act(ls:1, dialogo.lista1)
else 
Act(ls:1, SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%' and MTM in(1) "))
endif
if (NoVacio(dialogo.lista2))
Act(ls:2, dialogo.lista2)
else 
Act(ls:2, 'Titulo|Moneda')
endif

SetFilaActual(1)
Act(a:fac, 'Mercado')
Act(b:fac, 'Producto')
Act(c:fac, 'Cant Ops')
Act(d:fac, 'Cont.Precio')
Act(e:fac, 'Ult fecha')
Act(f:fac, 'Cont.Fecha')
Act(g:fac, 'Tipo Error')
Act(h:fac, 'Hay Operaciones')
SetFont(a:fac..l:fac, 2)

Act(aa:fac, 'Mercado')
Act(ab:fac, 'Producto')
Act(ac:fac, 'Nr Op')
Act(ad:fac, 'Tipo Op')
Act(ae:fac, 'Cot Hoy')
Act(af:fac, 'Cot Ayer')
Act(ag:fac, 'Cot Ant')
Act(ah:fac, 'Difer.')
Act(ai:fac, 'MTM')
Act(aj:fac, '')

SetFont(aa:fac..al:fac, 2)

Acn(x:1, Fac())
recorrer&k 1, Elementos(Val(ls:1))
recorrer&j 1, Elementos(Val(ls:2))
Ifa()
Act(a:fac, ItemLista(Val(ls:1), &k))
Act(b:fac, ItemLista(Val(ls:2), &j))
proximo
proximo
Acn(y:1, Fac())

if (Val(y:1) = Val(x:1))
if (dialogo.check1 = 1)
Cancelar('No existe Mercado+Producto para analizar')
else 
Messagebox('No existe Mercado+Producto para analizar')
endif
endif

if (Val(y:1) > Val(x:1))
recorrer&k 2, Val(y:1)
Act(d:&k, 'OK')
Sqladd("Select O.Especie, O.ContraEspecie, O.FechaVto ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" Where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND O.Mercado  = '"~Val(a:&k)~"' ")
if (Eqstr(Val(b:&k), 'Moneda'))
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(b:&k), 'Titulo'))
Sqladd(" AND O.TipoOp IN ('TICF','TIVF') ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" and O.Cliente1    = '"~dialogo.cliente1~"' ")
endif
Sqladd("   and O.NrOperacion = B.NrOperacion ")
Sqladd("   and B.NrBit       in (10,70) ")
Sqladd("   and B.Valor       = '1' ")
Sqladd(" Order By O.FechaVto, O.NrOperacion ")
recorrer sql
Dfa()
Scn(c:&k, 1)
if (Eqstr(Val(d:&k), 'OK'))
if (Query("Select 1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Fbn('FechaVto'))~"' AND Mercado = '"~Val(a:&k)~"' AND CallPut = 'FUT' AND Fecha = '"~IdxDate(dialogo.fecha1)~"' ") <> 1)
Messagebox('Faltan Cotizaciones Futuro para el Vencimiento '~Fbn('FechaVto')~' Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~'. MTM Cancelado para este Mercado+Producto')
Act(d:&k, 'Error')
endif
endif
proximo
proximo
endif

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - Control Precios')

if (Val(y:1) > Val(x:1))
recorrer&k 2, Val(y:1)
if (Eqstr(Val(d:&k), 'OK'))
Acd(e:&k, Query(" Select Max(Fecha) From "~Dbo()~".MTM Where Fecha <= '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'MTM' AND Estado = 'PRO' "))
Act(f:&k, 'OK')
if (Val(e:&k) = dialogo.fecha1)
if (Query(" Select 1 From "~Dbo()~".MTM Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'MTM' AND Estado = 'PRO' ") = 1)
Act(f:&k, 'Error')
Act(g:&k, 'MTM ya procesado')
Messagebox('MTM ya procesado para Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~' - Fecha '~dialogo.fecha1)
endif
else 
if (Val(e:&k) > 0)
endif
endif
endif
proximo
endif

if (Val(y:1) > Val(x:1))
SetFilaActual(1)
recorrer&k 2, Val(y:1)
Acn(h:&k, 0)
if (Eqstr(Val(d:&k), 'OK') y Eqstr(Val(f:&k), 'OK'))
Sqladd("Select O.NrOperacion,   O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
Sqladd("       O.Precio1,       O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        O.Cuenta4,     ")
Sqladd("       O.FechaOp,       O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    O.Mercado2,    ")
Sqladd("       O.FechaUltCupon, O.PrecioEj,      O.FechaEj,        O.MB1,         O.ObsErrorMAE,  O.TasaEspecie, ")
Sqladd("       O.TotalAux1,     O.TotalAux3,     O.ContraEspecie2, O.EnteCus1,    O.Mercado,      O.MB4,          ")
Sqladd("       O.Mercado4, M.LiquidaMTM          ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MERCADOS M ")
Sqladd(" Where C.Codigo    = O.Cliente1 ")
Sqladd(" AND O.Mercado = '"~Val(a:&k)~"' ")
Sqladd(" AND M.Codigo= O.Mercado ")
Sqladd(" AND O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND O.NrOperacion = B.NrOperacion ")
Sqladd("   and B.NrBit   in (10,70) ")
Sqladd("   and B.Valor   = '1' ")
if (Eqstr(Val(b:&k), 'Moneda'))
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(b:&k), 'Titulo'))
Sqladd(" AND O.TipoOp IN ('TICF','TIVF') ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd("   and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
Sqladd(" Order By O.FechaVto, O.NrOperacion ")
Watch(Sqlbatch())

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - Lectura x Mercado '~Val(a:&k)~' Producto '~Val(b:&k))

recorrer sql
Message(Fbn('NrOperacion'))
Act(aa:fac, Val(a:&k))
Act(ab:fac, Val(b:&k))
Act(ac:fac, Fbn('NrOperacion'))
Act(ad:fac, Fbn('TipoOp'))
Act(me:1, Fbn('Mercado4'))

if (Eqstr(Val(ab:fac), 'Moneda'))
Acn(ct:1, Query("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Fbn('FechaVto'))~"' AND Mercado = '"~Fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
Acn(ct:2, Query("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Fbn('FechaVto'))~"' AND Mercado = '"~Fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha < '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
endif
if (Eqstr(Val(ab:fac), 'Titulos'))
Acn(ct:1, Query("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Fbn('FechaVto'))~"' AND Mercado = '"~Fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
Acn(ct:2, Query("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Fbn('FechaVto'))~"' AND Mercado = '"~Fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha < '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
endif
Acn(ae:fac, Val(ct:1))
Acn(af:fac, Val(ct:2))
if (dialogo.fecha1 = Fbn('FechaOp'))
Acn(ct:2, Fbn('Precio1'))
endif
Acn(ag:fac, Val(ct:2))
Acn(ah:fac, Val(ae:fac) - Val(ag:fac))
if (Incluido(Fbn('TipoOp'), 'TICF|FXCF'))
Acn(ai:fac, Fbn('Cantidad') * Val(ah:fac))
else 
Acn(ai:fac, -Fbn('Cantidad') * Val(ah:fac))
endif
if (dialogo.check1 = 1)
Sqladd(" Insert Into "~Dbo()~".MTMDIARIO ")
Sqladd(" (NrOperacion, Fecha, PrecioHoy, ")
Sqladd(" PrecioAyer, MTM, TipoMTM, Especie1, MTMEspecie, FechaCargaSys) ")
Sqladd(" Values ")
Sqladd(" ('"~Fbn('NrOperacion')~"', '"~IdxDate(dialogo.fecha1)~"', "~FStr(Val(ae:fac), 0, 8)~", ")
Sqladd(" "~FStr(Val(ag:fac), 0, 8)~", "~FStr(Val(ai:fac), 0, 2)~", 'MTM', '"~Fbn()['ContraEspecie']~"', 0, "~IdxDate2(FSys())~") ")
Sqladd("  ")
Sqlnew()
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set TotalAux3 = TotalAux3 + "~FStr(Val(ai:fac), 0, 2)~" ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - Insert MTMDIARIO '~Fbn('NrOperacion'))

Acn(cu:1, Query(" Select count(*) From "~Dbo()~".MTMDIARIO Where NrOperacion = '"~Fbn('NrOperacion')~"' "))
Act(le:1, 'Liquidacion MTM '~Fbn()['Especie'])

if (Fbn('LiquidaMTM') = 0)

if (Query(" Select 1 From "~Dbo()~".MOVPENDIENTES  Where "~iif (Eqstr(Val(me:1), Var('AMBROFEX')), " FechaMov = "~IdxDate2(Val(fe:3)), iif (Eqstr(Val(me:1), Var('AMBMAE')), " FechaMov = "~IdxDate2(Val(fe:2)), "FechaMov = "~IdxDate2(dialogo.fecha1)))~" AND NrOperacion = '"~Fbn('NrOperacion')~"'  AND NrGrupo > 1000 ") = 1)
Sqladd(" Update "~Dbo()~".MOVPENDIENTES            ")
if (Eqstr(Fbn('Cliente1'), Fbn('Vehiculo1')))
Sqladd(" Set Cantidad = "~FStr(-Val(ai:1), 0, 2)~", ")
else 
Sqladd(" Set Cantidad = "~FStr(Val(ai:1), 0, 2)~", ")
endif
Sqladd("     Leyenda = '"~Val(le:1)~"' ")
Sqladd(" Where  NrOperacion = '"~Fbn('NrOperacion')~"' ")

if (Eqstr(Val(me:1), Var('AMBROFEX')))
Sqladd("   And  FechaMov = "~IdxDate2(Val(fe:3))~" ")
else 
if (Eqstr(Val(me:1), Var('AMBMAE')))
Sqladd("   And  FechaMov = "~IdxDate2(Val(fe:2))~" ")
else 
Sqladd("   And  FechaMov = "~IdxDate2(dialogo.fecha1)~" ")
endif
endif


Sqlnew()
else 
Sqladd(" Insert into "~Dbo()~".MOVPENDIENTES ( ")
Sqladd(" NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
Sqladd(" Bits, NrSaldo, Cuenta, NrMov,  ")
Sqladd(" Book,  FechaMov, Cantidad, Leyenda,         ")
Sqladd(" NrGrupo, Concepto,         ")
Sqladd(" NrGrupo2, Nrinstan                        ")
Sqladd(" ) values  ( ")
Sqladd(" '"~Fbn('NrOperacion')~"', ")
Sqladd(" '"~Fbn()['ContraEspecie']~"', ")
Sqladd(" '"~Fbn('Cliente1')~"', ")
Sqladd(" '"~Fbn('Mercado2')~"', ")
Sqladd(" '"~Fbn('Vehiculo1')~"', ")
Sqladd(" 'MV', ")
Sqladd(" 1, ")
Sqladd(" '"~Fbn('Cuenta4')~"', ")
Sqladd(" "~FStr(1000 + Val(cu:1), 1, 0)~", ")
Sqladd(" '"~Fbn('Book1')~"', ")
if (Eqstr(Val(me:1), Var('AMBROFEX')))
Sqladd("  "~IdxDate2(Val(fe:3))~", ")
else 
if (Eqstr(Val(me:1), Var('AMBMAE')))
Sqladd("  "~IdxDate2(Val(fe:2))~", ")
else 
Sqladd("  "~IdxDate2(dialogo.fecha1)~", ")
endif
endif


if (Eqstr(Fbn('Cliente1'), Fbn('Vehiculo1')))
Sqladd(" "~FStr(-Val(ai:fac), 0, 2)~", ")
else 
Sqladd(" "~FStr(Val(ai:fac), 0, 2)~", ")
endif
Sqladd(" '"~Val(le:1)~"', ")
Sqladd(" 0, ")
Sqladd(" 'FM', ")
if (Eqstr(Fbn('Cliente1'), Fbn('Vehiculo1')))
Sqladd(" "~FStr(1000 + Val(cu:1), 1, 0)~" , ")
else 
Sqladd(" "~FStr(3000 + Val(cu:1), 1, 0)~" , ")
endif
Sqladd(" "~FStr(0, 0, 0)~" ")
Sqladd("         ) ")
Sqlnew()
endif

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - ActualizarMovimientos3 '~Fbn('NrOperacion'))
endif
Acn(h:&k, 1)
endif

proximo
if (dialogo.check1 = 1 y Val(h:&k) = 1)
if (Query(" Select 1 From "~Dbo()~".MTM Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'MTM' AND Estado = 'ANU' ") = 1)
Sqladd(" Update "~Dbo()~".MTM ")
Sqladd(" Set Estado = 'PRO', ")
Sqladd(" FechaEstado = "~IdxDate2(FSys())~" ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Mercado = '"~Val(a:&k)~"' ")
Sqladd(" AND Producto = '"~Val(b:&k)~"' ")
Sqladd(" AND TipoMTM = 'MTM' ")
Sqladd(" AND Estado = 'ANU' ")
else 
Sqladd(" Insert Into "~Dbo()~".MTM ")
Sqladd(" (Fecha, Mercado, Producto, Estado, TipoMTM, FechaEstado) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Val(a:&k)~"', '"~Val(b:&k)~"', 'PRO', 'MTM', "~IdxDate2(FSys())~") ")
endif
Sqlnew()
Sqlexec()

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - Actualiza MTM ')

endif
endif
proximo
endif

EscribirAscii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida MTMFUT - Comienzo FIX ')
CerrarAscii()

Message('Generando Fixing del Dia ...')
Ejecutarevento('FIXFUT', 'fecha1', dialogo.fecha1, 'vehiculo1', dialogo.vehiculo1, 'cliente1', '', 'check1', dialogo.check1, 'lista1', dialogo.lista1, 'lista2', dialogo.lista2)

