HojaVisible(SI)
creardialogo
directorio1:"Ruta";;;;;;;;;;Var('PATHINFUT')
string1:"Archivo";;;;;;;;;;"NDF-MigracionContratos.xls"

findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar()('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar()('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar()('El directorio '~dialogo.directorio1~' no existe')
endif


Act(z1, iif (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), "\"), dialogo.directorio1, dialogo.directorio1~'\'))

importarxls(a1..q:10000, a1..q:10000, Val(z1)~dialogo.string1)

SetFilaActual(2)

&opcargadas := 0
&opnocargadas := 0
&opduplicadas := 0

recorrer&i 2, 10000

if (Vacio(Val(a:fac)))
break
endif

&boleta := Query("SELECT 1 FROM "~Dbo()~".OPNDF WHERE Boleta = '"~FStr(Val(c:fac), 1, 0)~"' ")

if (&boleta = 1)
&opduplicadas := &opduplicadas + 1

else
&idcomitente := Query("SELECT Top(1) Codigo FROM "~Dbo()~".Clientes WHERE AliasBt = '"~Val(d:fac)~"'")


if (Vacio(&idcomitente))
AgregarMarco(a:fac..p:fac, 1, 0, exe('COLOR5'))
&opnocargadas := &opnocargadas + 1
else

if (Eqstr(Mayusculas2(Copy(Val(f:fac), 1, 1)), "C"))
Acn(f:fac, 3)
&idcpravta := 3
else
Acn(f:fac, 1)
&idcpravta := 1
endif

sql.add("INSERT INTO "~Dbo()~".OPNDF ")
sql.add("(  Boleta,     IdContrato,     Origen,         TipoEjecucion,      ")
sql.add("   TipoContrato,   Ejercicio,      IdCpraVta,                      ")
sql.add("   Precio,     Cantidad,       IdComitente,    Fecha,              ")
sql.add("   Hora,       Vto,            Procesado,      NrOperacion,        ")
sql.add("   FechaReal,  Warning,        Anulada,        Currency,           ")
sql.add("   MarketId,   TrdRptStatus,   RootPartyId,    RootPartyIdSource   ")

sql.add(" ) Values ( ")

sql.add("   '"~FStr(Val(c:fac), 1, 0)~"',                     '0',                            '0',                    '0',                                             ")
sql.add("   '1',                             0,                     "~FStr(&idcpravta, 1, 0)~",                                                                        ")
sql.add("   "~Val(l:fac)~",                                 "~FStr(Val(h:fac), 1, 0)~",       '"~&idcomitente~"',    '"~(IdxDate(Val(a:fac))~" "~Val(b:fac))~"',       ")
sql.add("   '"~ReemplazarSTR(Val(b:fac), ":", "", SI)~"',      '"~IdxDate(Val(n:fac))~"',      '0',                    '',                         ")
sql.add("    '"~IdxDate(FSys())~"',     '',                             'NO',                   'ARS',                      ")
sql.add("   '"~Val(m:fac)~"',                                        0,                              "~FStr(Val(q:fac), 1, 0)~",                     ''                                     )")
sql.new
sql.exec

&opcargadas := &opcargadas + 1
endif
endif
Acd(a:fac, Val(a:fac))
Acd(n:fac, Val(n:fac))
Act(c:fac, FStr(Val(c:fac), 1, 0))

Ifa()
proximo

AlinearCeldas(a:1..p:fac, 'I')

ACO(1, 10)
ACO(2, 8)
ACO(3, 10)
ACO(4, 10)
ACO(5, 25)
ACO(6, 7)
ACO(7, 10)
ACO(8, 10)
ACO(9, 7)
ACO(10, 7)
ACO(11, 10)
ACO(12, 8)
ACO(13, 6)
ACO(14, 8)
ACO(15, 12)
ACO(16, 8)

Messagebox("Total de Operaciones: "~FStr(&opcargadas + &opnocargadas + &opduplicadas, 1, 0)~"."~Chr(13)~Chr(10)~"Operaciones Cargadas: "~FStr(&opcargadas, 1, 0)~"."~Chr(13)~Chr(10)~"Operaciones Duplicadas - No Cargadas: "~FStr(&opduplicadas, 1, 0)~"."~Chr(13)~Chr(10)~"Operaciones no Cargadas: "~FStr(&opnocargadas, 1, 0)~".")

