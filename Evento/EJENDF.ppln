Sqladd("From "~Dbo()~".OPERACIONES ")
Sqladd("Where TipoOp In ('FXCT','FXVT','FXAT','FXCTV','FXVTV','FXATV') ")
Sqladd("  and CB9='1' ")
Sqladd("  and FechaVto2<='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("  and CB8='0' ")
Sqladd("  and (CB1=0 or CB1 is null or CB1='') ")
