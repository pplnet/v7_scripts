endif
else
Sqladd(" and ((O.TipoOp = '"~Val(b7)~"' and O.Plazo = "~FStr(Val(e7), 1, 0)~") ")
Sqladd("      or ")
Sqladd("      (O.TipoOp = '"~Val(b8)~"' and O.Plazo = "~FStr(Val(e8), 1, 0)~") ")
Sqladd("     ) ")
endif
Sqladd("   and O.NroAltaMAE            = '"~Copy(Val(a:2), 113, 5)~"' ")
Sqladd("   and IsNull(O.NroBajaMAE,'') = '' ")
Sqladd("   and IsNull(O.Plataforma,'SIOPEL') = 'SIOPEL' ")
Sqladd("   and O.NrOperacion           = OB.NrOperacion ")
Sqladd("   and OB.Valor                = '1' ")
if (Val(x1) = 1)
Sqladd(" and OB.NrBit                in (1,2,3,8,10,69) ")
else
Sqladd(" and OB.NrBit                in (61,69) ")
endif
Watch(Sqlbatch())
