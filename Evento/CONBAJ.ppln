Message('cantidad : '~PYC(Val(i6), 0, 2)~' - Precio : '~FStr(Val(j6), 0, 8))

Sqladd("Select O.Especie,        O.ContraEspecie,     O.FechaOp,           O.TotalIntereses , ")
Sqladd("       O.Precio1,        O.FechaVto,          O.Cantidad,          O.TipoOp,         ")
Sqladd("       O.Mercado,        O.FormaLiquidacion1, O.FormaLiquidacion2, O.TablaFeriados1, ")
Sqladd("       O.TotalBrutoCli1, O.NrOperacion,       O.NroBajaMAE,        O.OperacionRef,   ")
Sqladd("       O.Precio3,        O.Precio4            ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB  ")
Sqladd(" where O.FechaOp           = '"~IdxDate(Val(c6))~"' ")
Sqladd("   and O.Especie           = '"~Val(f6)~"' ")
Sqladd("   and Round(O.Cantidad,4) = "~FStr(Val(i6), 1, 4)~" ")
if (Eqstr(BuscarCampo('ESPECIES', 'CotizaMAE', 'Codigo', Val(f6)), 'CLE'))
Sqladd("   and Round(O.Precio1,8)     = ROUND(convert(float,"~FStr(Val(j6), 1, 8)~"),8) ")
else
Sqladd("   and Round(O.Precio1,8)     = ROUND(convert(float,"~FStr(Val(j6), 1, 8)~"),8) ")
endif
if (Eqstr(Val(l6), '1'))
Sqladd("   and O.PaseCB = '"~Val(l6)~"' ")
endif
if (Val(x1) = 1)
Sqladd("   and O.Cliente1 = '"~Val(a6)~"' ")
endif
if (Eqstr(Val(l6), '0'))
Sqladd("   and O.TipoOp   = '"~Val(b6)~"' ")
