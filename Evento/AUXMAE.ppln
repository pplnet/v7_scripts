Sqladd(" Select * from "~Dbo()~".OPERACIONESBITS Where ( NrBit = 50 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")

recorrer sql

borrarceldas(a1..b2)
borrarceldas(a3..a3)
borrarceldas(a4..a4)
Act(a:1, BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', Fbn()['NrOperacion']))
Act(a:3, BuscarCampo('Operaciones', 'CB7', 'NrOperacion', Fbn()['NrOperacion']))
Act(a:4, BuscarCampo('Operaciones', 'CB5', 'NrOperacion', Fbn()['NrOperacion']))
if (Incluido(Val(a:1), 'TIC|TIV|TIFC|TIFV|TIPP|TIPA|TCOPRI'))
if ((Incluido(Val(a:1), 'TIC|TIV|TIFC|TIFV') y Eqstr(Val(a:4), '1')) o Incluido(Val(a:1), 'TCOPRI'))
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOperacion'], 'radio1', 0, 'radio2', 2, 'entero1', 50, 'entero2', 71)
Ejecutarevento('ASIBOL', 'radio1', 1, 'nroperacion1', Fbn()['NrOperacion'])
else 
borrarceldas(y1..y2)
Act(y1, Query("Select CodMAEContado From "~Dbo()~".ESPECIES Where Codigo='"~BuscarCampo('Operaciones', 'Especie', 'NrOperacion', Fbn()['NrOperacion'])~"' "))
if (celdavacia(y1) o Incluido(Val(a3), '1'))
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOperacion'], 'radio1', 0, 'radio2', 2, 'entero1', 50, 'entero2', 71)
Ejecutarevento('ASIBOL', 'radio1', 1, 'nroperacion1', Fbn()['NrOperacion'])
else 
if (Incluido(Val(a1), 'TIPP|TIPA'))
Acn(y2, Query("Select Count(*) From "~Dbo()~".OPERACIONES Where OperacionRef = '"~Fbn()['NrOperacion']~"' "))
if (Val(y2) = 2)
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrBit=73 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where (NrBit = 50 ) and (NrOperacion = '"~Fbn()['NrOperacion']~"') ")
Sqlnew()
Sqlexec()
endif
else 
Act(b1, BuscarCampo('Operaciones', 'Cliente1', 'NrOperacion', Fbn()['NrOperacion']))
Act(a2, BuscarCampo('Clientes', 'NrMAE', 'Codigo', Val(b1)))
Act(p1, SQLAhora())
if ((Incluido(Val(a1), 'TIC|TIFC|TCOPRI') y Vacio(Val(a2))) o (Incluido(Val(a1), 'TIV|TIFV')))
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrBit=60 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
else 
Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
Sqladd(" SET FechaEnvioMAE = "~Val(p1)~" ")
Sqladd(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrBit=61 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
endif
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where NrBit = 50 and NrOperacion = '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
endif
endif
endif
endif
proximo

Sqladd(" Select NrOperacion from "~Dbo()~".OPERACIONESBITS Where ( NrBit = 61 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
Sqladd(" Select NrOperacion,TipoOp,FechaEnvioMAE,Cliente1  from "~Dbo()~".OPERACIONES Where NrOperacion = '"~Fbn()['NrOperacion']~"' ")
recorrer sql
if (Incluido(Fbn()['TipoOp'], 'TIC|TIFC|TCOPRI') y NoVacio(BuscarCampo('CLIENTES', 'NrMAE', 'Codigo', Fbn()['Cliente1'])))
Act(b1, Hora(Fbn()['FechaEnvioMAE']))
if (Num(Copy(Hora(SQLAhora()), 1, 2)) * 3600 + Num(Copy(Hora(SQLAhora()), 4, 2)) * 60 + Num(Copy(Hora(SQLAhora()), 7, 2)) > Num(Copy(Val(b1), 1, 2)) * 3600 + Num(Copy(Val(b1), 4, 2)) * 60 + Num(Copy(Val(b1), 7, 2)) + (Var('ESPERA') * 60))
Sqladd(" Insert into "~Dbo()~".EXCEPCIONES ")
Sqladd(" (NrOperacion, Fecha, Tipo, Descripcion ) Values ")
Sqladd(" ('"~Fbn()['NrOperacion']~"', '"~IdxDate(FSys())~"' , 'ERRORALTA','MAE no solicito confirmacion ALTA' ) ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where  NrBit=61 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrBit=69 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
endif
endif
proximo
proximo


Sqladd(" Select NrOperacion from "~Dbo()~".OPERACIONESBITS Where ( NrBit = 73 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
Message(Fbn()['NrOperacion']~'   9')
Sqladd(" Select NrOperacion,TipoOp  from "~Dbo()~".OPERACIONES Where NrOperacion = '"~Fbn()['NrOperacion']~"' ")
recorrer sql
borrarceldas(v1..w2)
if (Incluido(Fbn()['TipoOp'], 'TIPP|TIPA'))
Message('----- Buscando Patas de Op '~Fbn()['NrOperacion'])
Sqladd(" Select * from "~Dbo()~".OPERACIONES ")
Sqladd(" Where OperacionRef = '"~Fbn()['NrOperacion']~"' ")
Sqladd(" and PaseCB = '1' ")
recorrer sql
Act(v1, Query("Select 1 from "~Dbo()~".OPERACIONESBITS O where O.NrOperacion = '"~Fbn()['NrOperacion']~"' and O.Valor='1' and  (O.NrBit=70 or O.NrBit =10 or O.NrBit=7) "))
if (Eqstr(Val(v1), '1'))
if (Incluido(Fbn()['TipoOp'], 'TIC|TIV|TCOPRI'))
Acn(w1, 1)
else 
Acn(w2, 1)
endif
endif
proximo
if (Val(w1) = 1 y Val(w2) = 1)
Message('Pasando Pases a Terminal')
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrBit=70 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONES ")
Sqladd(" SET NroBajaMAE = '0   0   ' ")
Sqladd(" Where NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where  NrBit=73 and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
else 
Message("Las patas del pase no estan aun en Terminal(i70)")
endif
endif
proximo
