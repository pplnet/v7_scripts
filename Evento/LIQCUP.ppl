*- Procesando Saldos 10 para Costos y Rendimientos
SQL.ADD("Select * FROM "~DBO~".OPERACIONES ")
SQL.ADD("where Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("and Cupon1 ='"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and FechaOp='"~IdxDate(val(m1))~"' ")
SQL.ADD("and TipoOp='CUPON' ")
SQL.ADD("and (MB4='3' and TipoCambio3=10) ")
SQL.ADD("and NrOperacion2 IS NULL ")

act(z2,'PCUPON')

SetFilaActual(9)

Recorrer SQL

  Message('Procesando Saldos 10 Operacion '~FBN['NrOperacion']~' ...')

  if FBN['Cantidad'] <> 0
     act(a:fac, FBN['Cliente1'])
     act(b:fac, IIF(EqStr(FBN['MB4'],'0'),'SPOT',IIF(EqStr(FBN['MB2'],'0'),'REPO SPOT',IIF(EqStr(FBN['MB2'],'1'),'REPO','SALDO'))))
     act(c:fac, FBN['Vehiculo1'])
     acn(d:fac, FBN['Cantidad']*val(z13))
     act(e:fac, FBN['NrOperacion'])
     acn(f:fac, ((val(d:fac)*val(e1))/100)-val(i1))
     acn(h:fac, FBN['TipoCambio3'])
  else
     dfa
  endif

Proximo

* n2: Cantidad de Filas Generadas
ACN(x2,fac)

IF VAL(x2)>=10
   *-- El primer renglon es de totales
   Recorrer&i 10,FAC
     (."CCLIQCUP".)
   Proximo
EndIf

Message(' Deshabilitando la Especie Cupon ...')
SQL.ADD("Update "~DBO~".ESPECIES ")
SQL.ADD("Set ")
SQL.ADD("  Status ='DES' ")
SQL.ADD("where  Codigo = '"~Dialogo.Especie1~"' ")
SQL.NEW      
SQL.EXEC

