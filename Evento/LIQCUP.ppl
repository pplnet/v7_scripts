*HojaVisible(SI)
CrearDialogo
  Especie1   :'Cupon'      ;;;;;;NoVacio(Dialogo.Especie1) y EsTerminal(Dialogo.Especie1,Especie) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe Ingresar un Cupon';NO;
  Entero1    :'NrCupon'    ;;;;NO;;;;;;BuscarCampo('Especies','Cupon','Codigo',Dialogo.Especie1)
  Fecha2     :'F.Posicion' ;;;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 <= Fsys;'Debe Ingresar la Fecha de Posicion del Corte';NO;;BuscarCampo('Especies','FechaProximoCorte','Codigo',Dialogo.Especie1)
  Fecha1     :'F.Pago'     ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 <= Fsys;'Debe Ingresar una Fecha';NO;;BuscarCampo('Especies','FechaPagoCupon','Codigo',Dialogo.Especie1)
  Especie2   :'Moneda'     ;;;;;;NoVacio(Dialogo.Especie2) y DesciendeDeEspecie(Dialogo.Especie2,'MONEDA');'Debe Ingresar una Moneda';NO;
  Precio1    :'Precio'     ;;;;;;Dialogo.Precio1>=0;'El Precio del Cupon debe ser Positivo';NO;
  Precio5    :'Arancel CV' ;8;1;;;;Dialogo.Precio5>=0;'El Arancel de CV debe ser Positivo';NO;
  Precio2    :'Imp. Gan.'  ; ; ;;;;Dialogo.Precio2>=0;'El Impuesto a las Ganancias debe ser Positivo';NO;
  Precio7    :'Tipo Cambio';;;;;Not Eqstr(Dialogo.Especie2,VAR('MONEEXTR'));Eqstr(Dialogo.Especie2,VAR('MONEEXTR')) o [Dialogo.Precio7<=Dialogo.Precio8*(1+VAR('RPRECIO2')/100) Y Dialogo.Precio7>=Dialogo.Precio8*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Fuera de Rango: '~FSTR(Dialogo.Precio8*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(Dialogo.Precio8*(1+VAR('RPRECIO2')/100),1,7);NO;Iif(Eqstr(Dialogo.Especie2,VAR('MONEEXTR')),1,Dialogo.Precio7);Iif(Eqstr(Dialogo.Especie2,VAR('MONEEXTR')),1,Dialogo.Precio7)
  Precio8    :'Cotizacion' ;;;;NO;NO;;;;;IIF(eqstr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Dialogo.Especie2~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP')/COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP')),COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP')/COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP'))
  Vehiculo1  :'Vehiculo'   ;;;;NO;NO;;;;
  Cuenta1    :'C.Efectivo' ;9;1;;NO;NO;[Vacio(Dialogo.Cuenta1) O Incluido(Dialogo.Especie2,BuscarCampo('CUENTAS','Especies','Codigo',Dialogo.Cuenta1))];'Debe Existir una Cuenta de Efectivo';NO;
FinDialogo

if Not Ok
  Cancelar
endif

If Not Eqstr(BuscarCampo('Especies','EsCupon','Codigo',Dialogo.Especie1),'SI')
   Cancelar('La Especie '~Dialogo.Especie1~' No es un Cupon')
endif


acn(q10,Dialogo.Precio2)


**** Valida que no haya transacciones por confirmar ***
SQL.ADD("Select * FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where T.Especie= '"~Dialogo.Especie1~"' ")
SQL.ADD("and T.NrTrans  = B.NrOperacion ")
SQL.ADD("and B.NrBit=7 and B.Valor='0'  ") 

acn(z1,0)


Recorrer SQL
   acn(z1,1)
   dfa
Proximo

if Val(z1)>0
  Cancelar('La Especie '~Dialogo.Especie1~' tiene Vouchers Pendientes de Confirmacion o Transacciones en No Operativos')
endif


**-- Ojo.Defecto 905 que dice que el valor residual no debe ser tenido en cuenta
*--acn(z13,BuscarCampo('Especies','VTeorico','Codigo',Dialogo.Especie1))
acn(z13,1)

*-- Selecciono las Transacciones de Pago de Cupon que no generaron transacciones de pago
*-- Las Operaciones que se liquidan son SPOT no Liquidados, Repos y Saldos3 
SQL.ADD("Select * FROM "~DBO~".OPERACIONES ")
SQL.ADD("where Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("and Cupon1 ='"~FStr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and FechaOp='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and TipoOp='CUPON' ")
SQL.ADD("and (MB4='0' or MB4='2' or (MB4='3' and TipoCambio3=3)) ")
SQL.ADD("and (NrOperacion2 IS NULL or NrOperacion2='') ")

act(z2,'PCUPON')

SetFilaActual(9)

Recorrer SQL

  Message('Procesando Operacion '~FBN['NrOperacion']~' ...')

  if FBN['Cantidad'] <> 0
     act(a:fac, FBN['Cliente1'])
     act(b:fac, IIF(EqStr(FBN['MB4'],'0'),'SPOT',IIF(EqStr(FBN['MB2'],'0'),'REPO SPOT',IIF(EqStr(FBN['MB2'],'1'),'REPO','SALDO'))))
     act(c:fac, FBN['Vehiculo1'])
     acn(d:fac, FBN['Cantidad']*val(z13))
     act(e:fac, FBN['NrOperacion'])
     acn(f:fac, ((val(d:fac)*Dialogo.Precio1)/100)-Dialogo.Precio5)
     acn(g:fac, FBN['MB3'])
     acn(h:fac, FBN['TipoCambio3'])
  else
     dfa
  endif
Proximo


* n2: Cantidad de Filas Generadas
ACN(x2,fac)

ACT(a1,Dialogo.Especie1)
ACN(b1,Dialogo.Entero1)
ACD(c1,Dialogo.Fecha1)
ACT(d1,Dialogo.Especie2)
ACN(e1,Dialogo.Precio1)
ACN(i1,Dialogo.Precio5)
ACT(k1,Dialogo.Cuenta1)
ACN(l1,Dialogo.Precio7)
ACN(ii1,Dialogo.Precio5)
ACD(m1,Dialogo.Fecha2)

*-- Hay datos para mostrar
CrearDialogo
  Especie1   :'Cupon'      ;;;;NO;;;;;val(a1);
  Entero1    :'NrCupon'    ;;;;NO;;;;;val(b1);
  Fecha1     :'F.Pago'     ;;;;NO;;;;;val(c1);
  Especie2   :'Moneda'     ;;;;NO;;;;;val(d1);
  Precio1    :'% Amort.'   ;;;;NO;;;;;val(e1);
  Precio2    :'Imp. Gast'  ;;;;NO;NO;;;;val(q10);
  ListBox; 'Arial,8,N'; 460; 300
     'Cliente'       ;a10..a:FAC;NO;;;;60;STRING
     'Concepto'      ;b10..b:FAC;NO;;;;60;STRING
     'Vehiculo'      ;c10..c:FAC;NO;;;;60;STRING
     'Cantidad'      ;d10..d:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Nro.Op.'       ;e10..e:FAC;NO;;;;60;STRING
     'Importe'       ;f10..f:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Tipo'          ;g10..g:FAC;NO;;;;35;COMBO;'Cobro|Pago'
  FinListBox  

FinDialogo

IF Not OK
   Cancelar
EndIf


IF VAL(x2)>=10
   *-- El primer renglon es de totales
   Recorrer&i 10,FAC
     (."CCLIQCUP".)
   Proximo
EndIf

ACN(i1,VAL(ii1))

Message('*-- Reverso Posiciones Futuras ')
SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
SQL.ADD("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
SQL.ADD("FechaEj,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
SQL.ADD(" SELECT '"~IdxDate(val(c1))~"' FechaMov,Cliente,Vehiculo,")
SQL.ADD(" NrSaldo,Especie,FechaEj,-Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
SQL.ADD(" FROM "~DBO~".MOVPOSEJE Where ")
SQL.ADD(" Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" and FechaMov='"~IdxDate(val(m1))~"' ")
SQL.NEW



Message('*-- Reverso Movimientos Pendientes ')
SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
SQL.ADD(" (NrOperacion,FechaMov,Cliente,Especie,")
SQL.ADD(" Cantidad,Leyenda,Bits,NrSaldo,")
SQL.ADD(" NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan) ")
SQL.ADD(" SELECT NrOperacion,'"~IdxDate(val(c1))~"' FechaMov,Cliente,Especie, ")
SQL.ADD(" -Cantidad,'Liq. Cupon',Bits,NrSaldo, ")
SQL.ADD(" NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan FROM "~DBO~".MOVPENDIENTES ")
SQL.ADD(" Where ")
SQL.ADD(" Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" and FechaMov='"~IdxDate(val(m1))~"' and NrSaldo>3 ")
SQL.NEW

*Message('*-- Reverso Movimientos Ejecutados ')
*SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
*SQL.ADD(" (NrOperacion,FechaMov,Cliente,Especie,")
*SQL.ADD(" Cantidad,Leyenda,Bits,NrSaldo,")
*SQL.ADD(" NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan) ")
*SQL.ADD(" SELECT NrOperacion,'"~IdxDate(val(c1))~"' FechaMov,Cliente,Especie, ")
*SQL.ADD(" -Cantidad,'Liq. Cupon',Bits,NrSaldo, ")
*SQL.ADD(" NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan FROM "~DBO~".MOVEJECUTADOS ")
*SQL.ADD(" Where ")
*SQL.ADD(" Especie = '"~Dialogo.Especie1~"' ")
*SQL.ADD(" and FechaMov='"~IdxDate(val(m1))~"' and NrSaldo>3")
