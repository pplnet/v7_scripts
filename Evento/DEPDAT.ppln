fecha1:'Fecha Desde';;;;;;dialogo.fecha1 <= Fecha(Var('FEDEPDAT'));'Fecha Desde Invalida';NO;Fecha(Var('FEDEPDAT'));
fecha2:'Fecha Hasta';;;;;;dialogo.fecha2 >= dialogo.fecha1 y dialogo.fecha2 <= Fecha(Var('FEDEPDAT'));'Fecha Hasta Invalida';NO;Fecha(Var('FEDEPDAT'));
findialogo

if (not ok)
Cancelar()
