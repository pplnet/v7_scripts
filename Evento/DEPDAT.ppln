Sqladd(" Select /*+ RULE */ D.NrDatanet ")
Sqladd(" From "~Dbo()~".DATANET D, "~Dbo()~".MOVDATANET M ")
Sqladd(" Where D.NrDatanet = M.NrDatanet ")
Sqladd(" AND D.FechaBajada >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND D.FechaBajada <= '"~IdxDate(dialogo.fecha2)~"' ")
recorrer sql
Message('Eliminando NrDatanet '~Fbn('NrDatanet'))
Sqladd(" Delete /*+ RULE */ "~Dbo()~".MOVDATANET ")
Sqladd(" Where NrDatanet = '"~Fbn('NrDatanet')~"' ")
Sqlnew()
Sqladd(" Delete /*+ RULE */ "~Dbo()~".DATANET ")
Sqladd(" Where NrDatanet = '"~Fbn('NrDatanet')~"' ")
Sqlnew()
Sqlexec()
proximo
Sqladd(" Select /*+ RULE */ T.NrTrans, B.NrBit ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" Where T.NrTrans = B.NrOperacion ")
Sqladd(" AND T.Fecha2 >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha2 <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND T.TipoTr2 IN ('CRVM','DEVM','TRANSF','DEP','RET') ")
Sqladd(" AND (T.CB2 = '1' OR T.CB3 = '1') ")
Sqladd(" AND B.Valor = '1' ")
recorrer sql
Message('Procesando Transaccion '~Fbn('NrTrans'))
Sqladd(" Update /*+ RULE */ "~Dbo()~".MOVPENDIENTES ")
Sqladd(" Set Status = 'OK' ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqlexec()
Sqladd(" Insert Into "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" (Select * From "~Dbo()~".MOVPENDIENTES ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"') ")
Sqlnew()
Sqlexec()
Sqladd(" Delete /*+ RULE */ "~Dbo()~".MOVPENDIENTES ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqlnew()
Sqlexec()
if (Fbn('NrBit') <> 20)
Message('Pasando Transaccion '~Fbn('NrTrans')~' a Terminal')
Sqladd(" Update /*+ RULE */ "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '0' ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqladd(" AND NrBit = "~FStr(Fbn('NrBit'), 0, 0)~" ")
Sqlnew()
Sqlexec()
Sqladd(" Update /*+ RULE */ "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '1' ")
Sqladd(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
Sqladd(" AND NrBit = 20 ")
Sqlnew()
Sqlexec()
endif
