sql.add(" Select /*+ RULE */ D.NrDatanet ")
sql.add(" From "~Dbo()~".DATANET D, "~Dbo()~".MOVDATANET M ")
sql.add(" Where D.NrDatanet = M.NrDatanet ")
sql.add(" AND D.FechaBajada >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND D.FechaBajada <= '"~IdxDate(dialogo.fecha2)~"' ")
recorrer sql
Message('Eliminando NrDatanet '~Fbn('NrDatanet'))
sql.add(" Delete /*+ RULE */ "~Dbo()~".MOVDATANET ")
sql.add(" Where NrDatanet = '"~Fbn('NrDatanet')~"' ")
sql.new
sql.add(" Delete /*+ RULE */ "~Dbo()~".DATANET ")
sql.add(" Where NrDatanet = '"~Fbn('NrDatanet')~"' ")
sql.new
sql.exec
proximo
sql.add(" Select /*+ RULE */ T.NrTrans, B.NrBit ")
sql.add(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where T.NrTrans = B.NrOperacion ")
sql.add(" AND T.Fecha2 >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND T.Fecha2 <= '"~IdxDate(dialogo.fecha2)~"' ")
sql.add(" AND T.TipoTr2 IN ('CRVM','DEVM','TRANSF','DEP','RET') ")
sql.add(" AND (T.CB2 = '1' OR T.CB3 = '1') ")
sql.add(" AND B.Valor = '1' ")
recorrer sql
Message('Procesando Transaccion '~Fbn('NrTrans'))
sql.add(" Update /*+ RULE */ "~Dbo()~".MOVPENDIENTES ")
sql.add(" Set Status = 'OK' ")
sql.add(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
sql.new
sql.exec
sql.add(" Insert Into "~Dbo()~".MOVEJECUTADOS ")
sql.add(" (Select * From "~Dbo()~".MOVPENDIENTES ")
sql.add(" Where NrOperacion = '"~Fbn('NrTrans')~"') ")
sql.new
sql.exec
sql.add(" Delete /*+ RULE */ "~Dbo()~".MOVPENDIENTES ")
sql.add(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
sql.new
sql.exec
if (Fbn('NrBit') <> 20)
Message('Pasando Transaccion '~Fbn('NrTrans')~' a Terminal')
sql.add(" Update /*+ RULE */ "~Dbo()~".OPERACIONESBITS ")
sql.add(" Set Valor = '0' ")
sql.add(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
sql.add(" AND NrBit = "~FStr(Fbn('NrBit'), 0, 0)~" ")
sql.new
sql.exec
sql.add(" Update /*+ RULE */ "~Dbo()~".OPERACIONESBITS ")
sql.add(" Set Valor = '1' ")
sql.add(" Where NrOperacion = '"~Fbn('NrTrans')~"' ")
sql.add(" AND NrBit = 20 ")
sql.new
sql.exec
endif
proximo
Message('Eliminando Conciliaciones')
sql.add(" Delete /*+ RULE */ "~Dbo()~".CONCILIACIONES ")
sql.add(" Where Fecha >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND Fecha <= '"~IdxDate(dialogo.fecha2)~"' ")
sql.new
sql.exec
