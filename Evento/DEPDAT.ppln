Message('Eliminando Conciliaciones')
Sqladd(" Delete /*+ RULE */ "~Dbo()~".CONCILIACIONES ")
Sqladd(" Where Fecha >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Fecha <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqlnew()
Sqlexec()
