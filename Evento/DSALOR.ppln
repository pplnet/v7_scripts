creardialogo
nrorden1: 'Nro.Orden';1;1;;;;;;;;
entero1:'Desde ints';;;;;;;;;1
check1:'Procesa';;1;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(a:1, 'NrOrden')
Act(a:2, 'TipoOrden')
Act(a:3, 'Cliente')
Act(a:4, 'Cuenta1')
Act(a:5, 'Cuenta4')
Act(a:6, 'Cuenta5')
Act(a:7, 'Especie')
Act(a:8, 'CantidadTotalOrden')
Act(a:9, 'ContraEspecie')
Act(a:10, 'CantidadEnProceso')
Act(a:11, 'TotalAux1')
Act(a:13, 'Mercado')
Act(a:14, 'AfectaLS')
Act(a:15, 'MB2')
Act(a:16, 'Leyenda3')
Act(a:17, '# Excep.')
Act(a:20, 'Bloquea')
Act(a:21, 'Desbloquea')
Act(a:22, 'Respuesta')
SetFont(a:1..a:25, 2)

sql.add("Select * From "~Dbo()~".ORDENES Where NrOrden='"~dialogo.nrorden1~"' ")
recorrer sql
Scn(x:1, 1)
Act(b:1, Fbn('NrOrden'))
Act(b:2, Fbn('TipoOrden'))
Act(b:3, Fbn('Cliente'))
Act(b:4, Fbn('Cuenta1'))
Act(b:5, Fbn('Cuenta4'))
Act(b:6, Fbn('Cuenta5'))
Act(b:7, Fbn('Especie'))
Acn(b:8, Fbn('CantidadTotalOrden'))
Act(b:9, Fbn('ContraEspecie'))
Acn(b:10, Fbn('CantidadEnProceso'))
Acn(b:11, Fbn('TotalAux1'))
Act(b:13, Fbn('Mercado2'))
Act(b:14, Fbn('AfectaLS'))
Acn(b:15, Fbn('MB2'))
Act(b:16, Fbn('Leyenda3'))
proximo

if (Val(x:1) = 0)
if (dialogo.check1 = 0)
Messagebox('DSALOR '~dialogo.nrorden1~' no encontrada.')
else
Cancelar()
endif
else
if (Eqstr(Val(b:2), 'OTIC') y Eqstr(Val(b:13), Var('MERCADOBT')) y Eqstr(Val(b:14), 'Saldos') y Val(b:15) = 1)
Act(b:20, 'SI')
else
Act(b:20, 'NO')
endif
if (Eqstr(Val(b:20), 'SI') y NoVacio(Val(b:16)))
Act(b:21, 'SI')
else
Act(b:21, 'NO')
endif
if (Eqstr(Val(b:21), 'SI'))
Act(b:22, 'OK')

if (Eqstr(Val(b:22), 'OK'))
if (dialogo.check1 = 1)
sql.add("Delete "~Dbo()~".EXCEPCIONES  ")
sql.add("Where NrOperacion = '"~Val(b:1)~"' ")
sql.add("  and Tipo        = 'ERRDESBLOQ' ")
sql.new
sql.add("UPDATE "~Dbo()~".ORDENES ")
sql.add("  SET Rojo    = '1'  ")
sql.add("Where NrOrden = '"~Val(b:1)~"' ")
sql.new
sql.exec

ejecutarevento('CBOINS', string1 = Val(b:1), radio1 = 1, radio2 = 1, entero1 = dialogo.entero1, entero2 = 30)
ejecutarevento('ANUMOV', nroperacion1 = Val(b:1))
else
Messagebox('Mueve orden '~Val(b:1)~' de '~FStr(dialogo.entero1, 1, 0)~' a 30')
endif
else
Acn(b:17, Query(" Select 1 From "~Dbo()~".EXCEPCIONES Where NrOperacion = '"~Val(b:1)~"' And Tipo = 'ERRDESBLOQ' "))
if (dialogo.check1 = 1)
if (Val(b:17) = 0)
sql.add("Insert into "~Dbo()~".EXCEPCIONES ( ")
sql.add(" NrOperacion, Fecha, Tipo, Descripcion ")
sql.add(" ) Values ( ")
sql.add(" '"~Val(b:1)~"', ")
sql.add(" "~SQLAhora()~", ")
sql.add(" 'ERRDESBLOQ', ")
sql.add(" '"~'Error al desbloquear cuenta '~Val(b:5)~"' ")
sql.add(" ) ")
sql.new
sql.exec
endif
else
if (Val(b:17) = 0)
Messagebox('Genera excepcion a la orden '~Val(b:1)~'.')
endif
Messagebox('Deja orden '~Val(b:1)~' en instancia '~FStr(dialogo.entero1, 1, 0)~'.')
endif
endif
endif

SetFont(b:1..b:25, 1)
FormatoCeldas(b:8..b:11, exe('F2'))
FormatoCeldas(b:15..b:15, exe('F0'))
endif

ACO(1, 15)
ACO(2, 15)


