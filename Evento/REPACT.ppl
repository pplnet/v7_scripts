CrearDialogo
  Fecha1       : 'Fecha'     ;;;;;;Dialogo.Fecha1 >= Fsys;'Fecha incorrecta';NO;Fsys
  NrOperacion1 : "Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;;;;"TipoOp = 'PME' and MB2 = '1' and RB2 ='0' "
FinDialogo

if Not Ok
  Cancelar
endif

if Eqstr(BuscarCampo('Operaciones','RB2','NrOperacion',Dialogo.NrOperacion1),'1') y Eqstr(BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),VAR('VEHICULODE'))
   Cancelar('Comision 2412 de:  '~BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',Dialogo.NrOperacion1)~'. No se modifica la tasa.')
endif

If BuscarCampo('Operaciones','MB2','NrOperacion',Dialogo.NrOperacion1)<>1
   Cancelar('El Prestamo debe ser a Tasa Repactable ')
endif

If BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1) < Fsys
   Cancelar('El Prestamo esta Vencido ')
endif

if Ok
   ACT(x1,Dialogo.NrOperacion1)
   ACD(x2,Dialogo.Fecha1)
   ACN(z1,0)
   SQL.ADD("Select O.DiasAnio,O.FechaVto,O.Book1,O.FechaVto2,O.Vehiculo1,O.Cliente1,O.Especie,O.Precio2, ")
   SQL.ADD("O.TablaFeriados1,O.TotalRetenciones, ")
   SQL.ADD("CC.CondicionIVA,CC.AgPercepcionIVA,CC.ExIVA,CC.PorcExIVA,CC.FDesdeExIVA,CC.FHastaExIVA, ")
   SQL.ADD("C.* from "~DBO~".CUOTAS C,"~DBO~".OPERACIONES O,"~DBO~".CLIENTES CC ")
   SQL.ADD("where O.NrOperacion =  '"~val(x1)~"' ")  
   SQL.ADD("and   C.NrOperacion =  '"~val(x1)~"' ")  
   SQL.ADD("and   C.Fecha1     <=  '"~IdxDate(val(x2))~"' ")
   SQL.ADD("and   C.Fecha2     >  '"~IdxDate(val(x2))~"' ")
   SQL.ADD("and   CC.Codigo     = O.Cliente1 ")
   SQL.ADD("order by C.NrCuota ")

   Recorrer SQL
    SCN(z1,1)
    ACD(a:fac,FBN['Fecha1'])
    ACN(b:fac,FBN['Plazo1'])
    ACD(c:fac,FBN['Fecha2'])
    ACN(d:fac,FBN['Precio2'])
    ACN(e:fac,FBN['Tasa1'])

    ACN(aa:fac,FBN['Cantidad3'])
    ACN(az:fac,FBN['Cantidad1'])
    ACN(cc:fac,FBN['Cantidad12'])
    ACN(cd:fac,FBN['Cantidad13'])
    ACN(ce:fac,FBN['Cantidad14'])
    ACN(cf:fac,FBN['Cantidad15'])

    ACT(ay:fac,FBN['CondicionIVA'])
    ACT(ax:fac,FBN['ExIVA'])
    ACN(aw:fac,FBN['PorcExIVA'])
    ACD(av:fac,FBN['FDesdeExIVA'])
    ACD(au:fac,FBN['FHastaExIVA'])

    ACD(ae:fac,FBN['FechaVto2'])

    ACN(l:fac,FBN['NrCuota'])

    ACN(da1,FBN['DiasAnio'])
    ACT(da2,FBN['Book1']) 
    ACT(da3,FBN['Vehiculo1'])
    ACT(da4,FBN['Especie'])
    ACT(da5,FBN['Cliente1'])
    ACT(da6,FBN['TablaFeriados1'])
    ACN(da7,FBN['TotalRetenciones'])
    ACN(da8,val(aa1)-val(da7))
    ACT(da9,FBN['Check1'])
    ACN(IN:1, fbn('Cantidad2'))
   Proximo

   if val(z1) > 0
     CrearDialogo
       Cliente1     : "Cliente"       ;1; 1;;NO;;;;;;val(da5)
       Especie1     : "Especie"       ;2; 1;;NO;;;;;;val(da4)
       Entero1      : "NrCuota"       ;3; 1;;NO;;;;;;val(l1)
       Fecha1       : "FechaDesde"    ;1; 2;;NO;;;;;;val(a1)
       Entero2      : "Plazo"         ;2; 2;;NO;;;;;;val(b1)
       Fecha2       : "FechaHasta"    ;3; 2;;NO;;;;;;val(c1)
       Fecha3       : "Vto.Ult.Fondeo";4; 2;;NO;val(ae1)>0;;;;;val(ae1)
       Cantidad1    : "Saldo Capital" ;4; 1;;NO;;;;;;val(aa1)
       Precio1      : "Tasa Spread"   ;5; 1;;NO;;;;;;val(d1)
       Cantidad2    : "Prevision"     ;6; 1;;NO;;;;;;val(da7)
       NrOperacion1 : "Op.Fondeo"     ;7; 1;;Not[Eqstr(val(da9),'1')] y val(ae1)<val(c1);;[Vacio(Dialogo.NrOperacion1) y val(da7)>=val(aa1)] o [Eqstr(val(da9),'1') o [Not Eqstr(val(da9),'1') y SQL("Select count(*) from "~DBO~".OPERACIONES where TipoOp= 'IMM' and NrOperacion='"~Dialogo.NrOperacion1~"' and Vehiculo1='"~val(da3)~"' and Especie = '"~val(da4)~"' and Cliente1='"~val(da5)~"' and (NrOperacion2 is Null or NrOperacion2=' ') and FechaOp = '"~IdxDate(val(ae1))~"' and FechaVto<= '"~IdxDate(val(c1))~"' and Cantidad >= "~val(da8)~" ")=1]];'La IMM no es correcta';NO;SQL("Select NrOperacion2 from "~DBO~".OPERACIONES where NrOperacion='"~val(x1)~"' and FechaVto2 > '"~IdxDate(val(a1))~"' ");;;;;"TipoOp = 'IMM' and Vehiculo1='"~val(da3)~"' and Especie = '"~val(da4)~"' and Cliente1='"~val(da5)~"' and (NrOperacion2 is Null or NrOperacion2=' ') and FechaOp = '"~IdxDate(val(ae1))~"' and FechaVto<= '"~IdxDate(val(c1))~"' and Cantidad >= "~val(da8)~"  "
       Cantidad3    : "Cantidad"      ;8; 2;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1)
***---       Fecha4       : "Vto.Fondeo"    ;7; 2;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','FechaVto2','NrOperacion',Dialogo.NrOperacion1)
       Fecha4       : "Vto.Fondeo"    ;7; 2;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)
***---       Precio2      : "Tasa Sales"    ;9; 2;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Precio2','NrOperacion',Dialogo.NrOperacion1)
       Precio2      : "Tasa Sales"    ;9; 2;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Precio1','NrOperacion',Dialogo.NrOperacion1)
       Precio3      : "Tasa Repac."   ;10;2;;  ;;;;;;Dialogo.Precio1+Dialogo.Precio2
     FinDialogo

     if ok
        *** Interes ***
        ACN(za1,Round(Dialogo.Cantidad1*Dialogo.Entero2*Dialogo.Precio3/iif(val(da1)=0,36000,36500),2))
        if Not[Eqstr(val(da3),'INGCURA')]
          *** IVANOR ***
          ACN(zb1,Round(val(za1)*MontoImpuesto('IVANORINT',Dialogo.Fecha2,3,val(ay1))/100,2))

          *** IVAADI ***
          ACN(zc1,Round(val(za1)*MontoImpuesto('IVAADIINT',Dialogo.Fecha2,3,val(ay1))/100,2))

          *** IVAPER ***
          if Eqstr(val(ay1),'SI') y Eqstr(val(ax1),'SI')
            if Dialogo.Fecha2 >= val(av1) y Dialogo.Fecha2 <= val(au1)
             **ACN(zd1,Round(val(za1)*MontoImpuesto('IVAPERINT',Dialogo.Fecha2,3,'')*1-val(m1)/100),2))
             ** La linea anterior no cerraba bien parentesis y utiliza la celda m1 que no se setea en ningun lado.
             ** Se ajusta para que al menos se logre parsear el evento.
             ACN(zd1,Round(val(za1)*MontoImpuesto('IVAPERINT',Dialogo.Fecha2,3,'')/100,2))
            else
             ACN(zd1,Round(val(za1)*MontoImpuesto('IVAPERINT',Dialogo.Fecha2,3,'')/100,2))
            endif

            if val(zd1) < Var('IVAPERMIN')
             ACN(zd1,0)
            endif
          else
           ACN(zd1,0)
          endif
        else
          ACN(zb1,0)
          ACN(zc1,0)
          ACN(zd1,0)
        endif

        *** Monto ***
           ACN(ze1,val(az1)+val(za1)+val(zb1)+val(zc1)+val(zd1)+val(cc1)+val(cd1)+val(ce1)+val(cf1))
        *** Spread ***
           ACN(zf1,Dialogo.Precio3-Dialogo.Precio2)

        *** Actualizacion de Tasa,Interes,IVA,IVAADIC,IVAPERC,Saldos,Monto y marca de Repacto ***
        *** en las Cuotas ***
        SQL.ADD("Update "~DBO~".CUOTAS  ")  
        SQL.ADD("   Set Tasa1      = "~Fstr(Dialogo.Precio3,0,7)~", ")
        SQL.ADD("       Cantidad2  = "~val(za1)~", ")
        SQL.ADD("       Cantidad6  = "~val(za1)~",  ")
        SQL.ADD("       Cantidad9  = "~val(zb1)~",  ")
        SQL.ADD("       Cantidad10 = "~val(zc1)~",  ")
        SQL.ADD("       Cantidad11 = "~val(zd1)~",  ")
        SQL.ADD("       Cantidad4  = "~val(ze1)~",  ")
        SQL.ADD("       Check1     = '1'  ")
        SQL.ADD(" where NrOperacion = '"~val(x1)~"' ")
        SQL.ADD(" and   NrCuota     = "~Dialogo.Entero1~" ")
        SQL.NEW

        *** Actualizacion de la IMM y Spread en PME ***
        SQL.ADD("Update "~DBO~".OPERACIONES set ")
        if NoVacio(Dialogo.NrOperacion1)
         SQL.ADD(" NrOperacion2='"~Dialogo.NrOperacion1~"',FechaVto2='"~IdxDate(Dialogo.Fecha4)~"', ")
        endif
        SQL.ADD("Precio2 = "~Fstr(val(zf1),0,7)~", Precio1 = "~Fstr(Dialogo.Precio3,0,7)~" ")
        SQL.ADD("where NrOperacion='"~val(x1)~"' ")
        SQL.NEW
        SQL.EXEC
        
        ***---Actualizo el interes total en la operacion
        ACN(TI:1, SQL(" Select Sum(Cantidad2) From "~DBO~".CUOTAS Where NrOperacion = '"~Val(X:1)~"' "))
        SQL.ADD(" Update "~DBO~".OPERACIONES Set TotalIntereses = "~Fstr(Val(TI:1), 0, 2)~" ")
        SQL.ADD(" Where NrOperacion = '"~Val(X:1)~"' ")
        SQL.NEW
        SQL.EXEC
        if NoVacio(Dialogo.NrOperacion1)
          *** Actualizacion del PME y el Book del Prestamo en la IMM ***
          SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion2='"~val(x1)~"', ")
          SQL.ADD("ObsErrorMAE='"~val(da2)~"' ")
          SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"'")
          SQL.NEW
          SQL.EXEC

          *** Actualizacion de Devengados de la IMM ***
          SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,NO,NO,NO,NO,SI,0)
          SQL.EXEC
        endif
      
        *** Generacion del GENDEVENGADO para los Devengados de Intereses del Prestamo y del MOVDEVENGADO del dia ***
        ACT(zz1,val(x1))
        ACD(zz2,val(a1))
        ACD(zz3,val(c1)-1)
        ACT(zz4,'INTLEN')
        ACN(zz5,val(za1))
        ACT(zz6,val(da3))
        ACT(zz7,val(da3))
        ACN(zz8,140)
        ACT(zz9,val(da4))
        ACT(zz10,val(da2))
        ACN(zz11,Dialogo.Entero1)
        ACT(zz12,val(da4))
        ACT(zz13,val(da6))
        ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
        ACN(zz15,Dialogo.Cantidad1)
        ACN(zz16,Dialogo.Precio3)
        ACN(zz17,IIF(val(da1)=0,360,365))
        ACN(zz18,1)
        ACD(zz19,val(zz2))

        if SQL("Select count(*) from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(zz1)~"' and FechaDes='"~IdxDate(val(zz2))~"' and FechaHas='"~IdxDate(val(zz3))~"' and TipoDevengado = '"~val(zz4)~"' and NrSaldo = "~val(zz8)~" ")>0
           SQL.ADD("Delete from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(zz1)~"' and FechaDes='"~IdxDate(val(zz2))~"' and FechaHas='"~IdxDate(val(zz3))~"' and TipoDevengado = '"~val(zz4)~"' and NrSaldo = "~val(zz8)~" ")
           SQL.NEW
        endif
        if SQL("Select count(*) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(zz1)~"' and Fecha>='"~IdxDate(val(zz2))~"' and Fecha<='"~IdxDate(val(zz3))~"' and TipoDevengado='"~val(zz4)~"' and NrSaldo= "~val(zz8)~"  ")>0
           SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(zz1)~"' and Fecha>='"~IdxDate(val(zz2))~"' and Fecha<='"~IdxDate(val(zz3))~"' and TipoDevengado='"~val(zz4)~"' and NrSaldo= "~val(zz8)~"  ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~val(zz1)~"' and Fecha='"~IdxDate(val(x2))~"'  ")
           SQL.NEW
        endif
        (.'CANPRE12'.)
        SQL.EXEC

        *** Generacion del MOVDEVENGADO correspondiente al dia ***
        ACT(z1,val(x1))
        ACD(z2,val(a1)+1)
        if Eqstr(val(da3),VAR('VEHICULODE'))
           ACN(zz7,((1+(Dialogo.Precio3/100)/iif(val(da1)=0,360,365)*Dialogo.Entero2)^(1/Dialogo.Entero2)-1)*val(aa1))
        else
           ACN(zz7,(Dialogo.Precio3/100)/iif(val(da1)=0,360,365)*val(aa1))
        endif
        ACT(p1,val(da3))
        ACN(zz3,140)
        ACT(a1,val(da4))
        ACT(bo1,val(da2))
        ACN(ss4,Dialogo.Entero1)
        (.'CANPRE11'.)
        SQL.EXEC
     endif
   else
     MESSAGEBOX('La operacion '~Dialogo.NrOperacion1~' no tiene cuotas vigentes a repactar a fecha '~Dialogo.Fecha1)
   endif
endif

