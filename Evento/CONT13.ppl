message('--- Asientos de Capitalizacion de Interes ICL ---')
ACT(TA:1, Var('TIPASICLCP'))
ACT(ML:1, Var('MONELOCA'))
ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))

** FJL 16/11/20 - Lo vimos con Ale y cambiamos Cantidad1 por Cantidad2
** Generaba la contabilidad con valores negativos.
*SQL.ADD("SELECT C.NrOperacion, C.Fecha1, O.Vehiculo1, C.Cantidad3 IVA, C.Cantidad4 WTH, C.Cantidad1 IntTot, ")
*SQL.ADD("C.Cantidad1-C.Cantidad4 Interes, MA.Codigo CodAsi, O.TipoOp, O.Especie, O.Especie ContraEspecie,")
SQL.ADD("SELECT C.NrOperacion, C.Fecha1, O.Vehiculo1, C.Cantidad3 IVA, C.Cantidad4 WTH, C.Cantidad5 IntTot, ")
SQL.ADD("C.Cantidad5-C.Cantidad4 Interes, MA.Codigo CodAsi, O.TipoOp, O.Especie, O.Especie ContraEspecie,C.Precio1,")
** FJL 17/11/20 - Se agrega TipoConu
**SQL.ADD("       '#Op:' + C.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, O.Book1, O.TipoCONU ")
** AA Jun-2021 se incorpora tipo conu en leyenda, liberar cuando aprueben presupuesto
SQL.ADD("       '#Op:' + C.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.TipoCONU) + ',' + rtrim(O.Especie) Leyenda, O.Book1, O.TipoCONU ")
SQL.ADD("FROM "~DBO~".CUOTAS C, "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE C.Radio1 = 3 ")
SQL.ADD("AND O.NrOperacion = C.NrOperacion ")
SQL.ADD("AND C.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("AND o.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("AND MA.TipoAsiento in("~Pipe2Comillas(Val(TA:1))~") ")
SQL.ADD("AND MA.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
watch(SQL.Batch)
ACN(XX:2,0)
ACN(XX:1,0)
Recorrer SQL
    ACD(FV:1, fbn('Fecha1'))
    ACD(FD:1, Dialogo.Fecha1)
    ** AA Jun-2021 la cotizacion debe ser la del cierre de mes anterior Precio1 en Radio1 = 3 Para IVA y WTH las demas la del dia
    ACN(CO:1, COTIZACIONC(fbn('Especie'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))
    **ACN(IT:1, fbn('IntTot')*Val(CO:1))    
    **ACN(IP:1, fbn('Interes')*Val(CO:1))    
    **ACN(IV:1, fbn('IVA')*Val(CO:1))      
    **ACN(WT:1, fbn('WTH')*Val(CO:1))          
    ACN(IT:1, Round(fbn('IntTot')*Val(CO:1),2))
    ACN(IP:1, Round(fbn('Interes')*Val(CO:1),2))    
    ACN(IV:1, Round(fbn('IVA')*fbn('Precio1'),2))      
    ACN(WT:1, Round(fbn('WTH')*fbn('Precio1'),2))          
    ACT(VH:1, fbn('Vehiculo1'))
    ACT(VK:1, fbn('Book1'))    
    ACT(TO:1, fbn('CodAsi'))
    ACT(TI:1, fbn('TipoOp'))
    ACT(NR:1, fbn('NrOperacion'))
    ** AA Jun-2021 se incorpora diferencia de cambio por cotizacion fin mes vs 1er dia habil
    ACN(RE:1, (Val(IP:1)+Val(WT:1))-Val(IT:1))
    ACT(NR:2, '')
    (.'GENASIENTO'.)         
