creardialogo
nroperacion1:'Nr.Operacion'
findialogo

if (not ok)
Cancelar()
endif

let(&nroperacion, dialogo.nroperacion1)

if (Eqstr(BuscarCampo('OPERACIONES', 'Cliente1', 'NrOperacion', &nroperacion), 'BIND'))

creardialogo
nroperacion2:'Nr.Operacion';;;;NO;SI;;;;;&nroperacion
fecha1: 'F.Liquidacion';;;;NO;SI;;;;;BuscarCampo('OPERACIONES', 'FechaOp2', 'NrOperacion', &nroperacion)
fecha2: 'F.Acreditacion';;;;NO;SI;;;;;BuscarCampo('OPERACIONES', 'FechaVto2', 'NrOperacion', &nroperacion)
fecha3: 'F.Liq.Diferida';;;;dialogo.fecha1 >= FSys();SI;;;;;BuscarCampo('OPERACIONES', 'FechaOp2', 'NrOperacion', &nroperacion)
fecha4: 'F.Acr.Diferida';;;;dialogo.fecha2 >= FSys();SI;;;;;BuscarCampo('OPERACIONES', 'FechaVto2', 'NrOperacion', &nroperacion)
findialogo

else

creardialogo
nroperacion2:'Nr.Operacion';;;;NO;SI;;;;;&nroperacion
fecha1: 'F.Liquidacion';;;;NO;SI;;;;;BuscarCampo('OPERACIONES', 'FechaOp2', 'NrOperacion', &nroperacion)
fecha3: 'F.Liq.Diferida';;;;dialogo.fecha1 >= FSys();SI;;;;;BuscarCampo('OPERACIONES', 'FechaOp2', 'NrOperacion', &nroperacion)
fecha2: 'N/A';;;;NO;NO
fecha4: 'N/A';;;;NO;NO
findialogo

endif

if (not ok)
Cancelar()
endif


if (dialogo.fecha1 <> dialogo.fecha3)
Sqladd("update "~Dbo()~".OPERACIONES set")
Sqladd("FechaOp2 = '"~IdxDate(dialogo.fecha3)~"', CB6=1")
Sqladd("where NrOperacion = '"~&nroperacion~"'")
Sqlnew()
enviarmensajeop('Se difiere F.Liquidacion: '~dialogo.fecha3, &nroperacion)
endif
if (dialogo.fecha2 <> dialogo.fecha4)
Sqladd("update "~Dbo()~".OPERACIONES set")
Sqladd("FechaVto2 = '"~IdxDate(dialogo.fecha4)~"', CB7=1")
Sqladd("where NrOperacion = '"~&nroperacion~"'")
Sqlnew()
enviarmensajeop('Se difiere F.Acreditacion: '~dialogo.fecha4, &nroperacion)
endif
Sqlexec()

