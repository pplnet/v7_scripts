*-- FXEJEO: Ejercico de Opciones de Cambios
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DFXO');'El TipoOp ingresado debe ser  DFXO ';NO;;;;;;" TipoOp IN ('DFXO') and (CB8 is Null or CB8='0') ";
  Fecha1       : "F Real Ej."               ;;;;NO;;Dialogo.Fecha1<=Dialogo.Fecha4;'La Fecha de Ejercicio Real para esta Operacion es Invalida';NO;Fsys
  Precio2      : "Precio_Ref"               ;;;;;;Dialogo.Precio2>0;'El precio ref debe ser mayor a cero';NO
  Fecha3       : "F Settlement"             ;;;;Dialogo.Radio1=1;;ESHABIL(Dialogo.Fecha3,'ARG') y Dialogo.Fecha3>=Fsys;'La Fecha de Settlement es Incorrecta';NO;;Fsys
  Especie1     : "Especie"                  ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Especie2     : "ContraEspecie"            ;;;;NO;;;;;;BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Fin Opcion"         ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Ej"                ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio1       : "Opcion|Europea|Americana" ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Call|Put"            ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DFXO|')
   Cancelar('La Operacion '~Dialogo.NrOperacion1~' No es un Call o Put de Moneda')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and (CB8 is Null or CB8='0') ")  
   SQL.ADD("and ((TipoOpcion='0' and FechaEj = '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("and FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"')) ")

   Recorrer SQL    
     *-- Verifico que la Fecha de Reset y la Fecha de Settlement 
     *-- sea habil en la tabla de feriados de la operacion
     IF [NOT ESHABIL(Dialogo.Fecha3,FBN['TablaFeriados1'])]          
        MessageBOX('La Fecha de Settlement NO ES D¦a Habil en la Tabla de Feriados '~FBN['TablaFeriados1'] )        
        Break
     ENDIF

     acn(x1,1)

     **-- Z16: Especie Z17: ContraEspecie 
     *** Determina los tipos de Operacion a utilizar ***
     *-- Compra de Call y Venta de Put -> Compra
     ACT(Z16,FBN['Especie'])
     ACT(Z17,FBN['ContraEspecie'])

     *-- Si genera Compra o Venta  o Arbitrajes y no invierte la moneda =>
     *-- Cantidad=Cantidad TotalBrutoCli1=TotalAux1 TotalNetoCli1=TotalAux1
     ACT(Z11," "~Fstr(FBN['Cantidad'],0,7)~","~Fstr(FBN['TotalAux1'],0,4)~","~Fstr(FBN['TotalAux1'],0,4)~" ")
 
     IF EqStr(FBN['ContraEspecie'],'ARP') o EqStr(FBN['Especie'],'ARP')
        If [EqStr(FBN['MB3'],'0') Y EqStr(FBN['MB1'],'0')] O [EqStr(FBN['MB3'],'1') Y EqStr(FBN['MB1'],'1')]
           ACT(z1,'FXCS')        
        else
           ACT(z1,'FXVS')                   
        endif
        * Si la ContraEspecie es ARP, Invierto las Monedas  y el Signo de la Operacion
        IF EqStr(FBN['Especie'],'ARP') 
           ACT(Z16,FBN['ContraEspecie'])
           ACT(Z17,FBN['Especie'])
           IF EqStr(VAL(Z1),'FXCS')
              ACT(z1,'FXVS')        
           else
              ACT(z1,'FXCS')        
           endif
        ENDIF       
     ELSE 
        * Genera un Arbitraje
        ACT(z1,'FXAS')        
        * Calculo VALORRB2 para la Moneda de Pago 
        ACN(Z6,0) 
        * Tabla de Feriados de la ContraEspecie
        ACT(Z7,BuscarCampo('Especies','PaisOrigen','Codigo',VAL(Z17)))
        * Partida Operada: Por Default toma valor VN-Entr 
        ACT(Z8,'1')
 
        * Si es Ventas de Call o Compra de Put es NEGATIVO EL RESULTADO
        If Not [[EqStr(FBN['MB3'],'0') Y EqStr(FBN['MB1'],'0')] O [EqStr(FBN['MB3'],'1') Y EqStr(FBN['MB1'],'1')]]
           ACT(Z16,FBN['ContraEspecie'])
           ACT(Z17,FBN['Especie'])
        
           *-- Si invierte la moneda =>
           *-- Cantidad=Notional TotalBrutoCli1=Cantidad TotalNetoCli1=Cantidad
           ACT(Z11," "~Fstr(FBN['TotalAux1'],0,4)~","~Fstr(FBN['Cantidad'],0,4)~","~Fstr(FBN['Cantidad'],0,4)~" ")
        EndIf
     ENDIF

     * Recupero el Modo Especie 
     ACN(Z10,IIF(eqstr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~FBN['ContraEspecie']~"' "),'INV'),0,1))

     *** Calculo el Resultado                
     IF FBN['MB1']=0
        IF VAL(Z10)=0
           * Call de Compra Inversa 
           ACN(Z2,(FBN['PrecioEj']/Dialogo.Precio2) -1)
           IF 0>VAL(Z2)
              ACN(Z2,0)
           ENDIF
        ELSE 
           * Call de Compra Directa
           ACN(Z2,(Dialogo.Precio2/FBN['PrecioEj']) -1)
           IF 0>VAL(Z2)
              ACN(Z2,0)
           ENDIF
        ENDIF
     ELSE 
        * Put de Compra Inversa 
        IF VAL(Z10)=0
           ACN(Z2,1- (FBN['PrecioEj']/Dialogo.Precio2))
           IF 0>VAL(Z2)
              ACN(Z2,0)
           ENDIF
        ELSE 
           * Put de Compra Directa
           ACN(Z2,1- (Dialogo.Precio2/FBN['PrecioEj']))
           IF 0>VAL(Z2)
              ACN(Z2,0)
           ENDIF
        ENDIF
     ENDIF

     ACN(Z2,VAL(Z2)*FBN['TotalAux1'])
     
     IF VAL(Z10) =0
        ACN(Z2,VAL(Z2)/Dialogo.Precio3)
     ELSE
        ACN(Z2,VAL(Z2)*Dialogo.Precio3)
     ENDIF

     * Si es Ventas de Call o Put 
     If EqStr(FBN['MB3'],'1') 
        ACN(Z2,-VAL(Z2))
     ENDIF

     * Recupero el Modo Especie 
     ACN(Z10,IIF(eqstr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Val(z16)~"' and Especie2='"~VAL(Z17)~"' "),'INV'),0,1))

     * Si la Condicion de Settlement es Transf se genera la Operacion Asociada y genero resultado
     IF FBN['RB10']=1 Y VAL(Z2)<>0
        Message('Obteniendo los Nros. de Operaciones a Generar .... ')          
   
        *** Z3 Nro. Operacion Contado
        ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

        Message('Calculando los Plazos .... ')  
       
        *** Z4: Calcula el Plazo de la Especie
        *** Z5: Calcula el Plazo2 de la ContraEspecie     
        ACN(Z4,Dialogo.Fecha3-Fsys)
        ACN(Z5,Dialogo.Fecha3-Fsys)

        *** Z14: Calcula la Fecha de Vencimiento de Moneda
        *** Z15: Calcula la Fecha de Vencimiento de Moneda de Cobro
        ACD(Z14,Dialogo.Fecha3)
        ACD(Z15,Dialogo.Fecha3)

        *** A1: Hoy o Normal
        *** A2: Puesto o No Puesto
        ACN(A1,VAL(Z4))
        ACN(A2,1)

        * Cotizacion de la Especie/ContraEspecie
        IF VAL(Z10)=0
           * Es Inversa
           ACN(Z9,COTIZACIONC(VAL(Z17),,,,FSYS,1,SI,'ARP')/COTIZACIONC(VAL(Z16),,,,FSYS,1,SI,'ARP'))
        ELSE 
           ACN(Z9,COTIZACIONC(VAL(Z16),,,,FSYS,1,SI,'ARP')/COTIZACIONC(VAL(Z17),,,,FSYS,1,SI,'ARP'))
        ENDIF

        Message('Generando Operacion de Ejercicio .... ')     
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
        SQL.ADD("(TipoOp, Book1,NrOperacion, Especie, ")
        SQL.ADD(" Cliente1, Precio1, ")
        SQL.ADD(" ContraEspecie, ")
        SQL.ADD(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
        SQL.ADD(" Operador, Vehiculo1, ")
        SQL.ADD(" ValorRB1, Puesto, Observac2, OperacionRef, TablaFeriados1, ")
        SQL.ADD(" Precio4, RB7, CB6, ")
        SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,ValorRB2,RB6,TablaFeriados2, ")
        SQL.ADD(" Cantidad, TotalBrutoCli1, TotalNetoCli1,RB3,PaseCB,Arbitraje,Cuenta1,Cuenta2) ") 
        SQL.ADD(" Values ")
        SQL.ADD("('"~Val(z1)~"','"~FBN['Book1']~"', '"~Val(z3)~"', '"~VAL(Z16)~"', ")
        SQL.ADD(" '"~FBN['Cliente1']~"', "~Fstr(FBN['PrecioEj'],0,7)~", ")
        SQL.ADD(" '"~VAL(Z17)~"', ")
        SQL.ADD(" '"~IdxDate(Fsys)~"', '"~IdxDate(VAL(Z14))~"', ")
        SQL.ADD(" '"~IdxDate(VAL(Z15))~"', "~Fstr(VAL(Z4),2,0)~", "~Fstr(VAL(Z5),2,0)~", ")
        SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
        SQL.ADD(" '"~Fstr(VAL(A1),1,0)~"', '"~Fstr(VAL(A2),1,0)~"', ")
        SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', '"~FBN['TablaFeriados1']~"', ")
        SQL.ADD(" "~Fstr(VAL(Z9),0,7)~", '"~FBN['RB7']~"', '"~Fstr(FBN['CB6'],1,0)~"', ")     
        SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', '"~FBN['MB4']~"', '"~FBN['RB10']~"', ")
        SQL.ADD(" '"~Fstr(VAL(Z6),1,0)~"','"~VAL(Z8)~"' ,'"~VAL(Z7)~"', ")
        SQL.ADD(" "~VAL(Z11)~",'"~FBN['RB3']~"','0','0','"~FBN['Cuenta1']~"','"~FBN['Cuenta2']~"') ")
        SQL.NEW
        SQL.EXEC

        *** Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Val(z3),SI)
        SQL.EXEC

        * Alta de Instancias Z3: Nro.Operacion
        (.'ALTAINSTAN'.)
     ENDIF

     Message('Actualizando la Opcion .... ')                  

     *--- Obtengo la cotizacion al Vto.
     ACN(c1,COTIZACIONC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR'))^IIf(EqStr(Modo(FBN['ContraEspecie'],'USD'),'DIR'),1,-1) )

     *** Marca la operacion como ejercida ***
     SQL.ADD("Update "~DBO~".OPERACIONES ")
     SQL.ADD("Set CB8 = '1', OperacionRef = '"~Val(z3)~"', ")
     SQL.ADD("FechaPago = '"~IdxDate(Dialogo.Fecha3)~"', ")
     SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
     SQL.ADD("Precio4   = "~Fstr(VAL(Z2),0,2)~", ")     
     SQL.ADD("Cotizacion2 = "~Fstr(VAL(c1),0,7)~",  ")
     SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~"  ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     SQL.EXEC

     IF Not [FBN['RB10']=1 Y VAL(Z2)<>0]
        SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,SI,SI,SI)
        SQL.EXEC
     ENDIF

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)      
   Proximo

   If Val(x1)=0
      Cancelar('La Operacion Nro '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif