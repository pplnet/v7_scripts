Sqladd(" Select T.NrTrans, Abs(M.Cantidad) as ImporteVoucher, M.Especie, O.NrOperacion, O.ContraEspecie, O.TotalGastos, ")
Sqladd(" O.Mercado, O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, O.FechaVto, O.Vehiculo1, O.Cantidad, ")
Sqladd(" M.Cuenta, T.Fecha2, T.Fecha1, O.FechaPago, O.FechaOp, O.Cliente1, T.TipoTr2, O.Cupon1, O.TotalCaucion, ")
Sqladd(" O.Precio1, O.Plazo, O.Book1, C.CuentaContable2, C.CuentaContable1, CL.CategDepositante, O.PorAforo, ")
Sqladd(" T.Cliente1 ClienteVoucher, O.TotalComisiones Comision, T.TipoTr2, ")
Sqladd(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, T.Fecha1, T.Fecha2, ME.Netea, E.Tipo TipoEspecie,O.ContraEspecie Moneda, ")
Sqladd(" O.CB4, C.Comitente, O.Cliente1 Cliente,O.TotalGastos DerechoMercado,O.TotalIva IvaComision,O.TotalIvaAdi IvaDerechos, O.Precio4, ")
Sqladd(" T.Cuenta2, O.TotalBrutoCli3, CASE WHEN O.TipoOp IN ('TICT','TIDE','TICO','TIPO') THEN O.Precio4 ELSE O.Precio1 END PrecioOp, ")
Sqladd(" CASE WHEN O.TipoOp = 'TCOPRI' THEN O.Cuenta1 ELSE O.Cuenta2 END CuentaCustodia, '' as Concepto, E.Issuer, E.Alias1 as EspBanTotal,O.Mercado4, O.PorDerechoMercado as PrecioOpEnARP ")
Sqladd(" ,T.Cuenta1 as CtaTitCli, O.CB5 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("    INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion ")
Sqladd("    INNER JOIN "~Dbo()~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
Sqladd("    INNER JOIN "~Dbo()~".CUENTAS C ON M.Cuenta = C.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")
Sqladd("    INNER JOIN dbo.MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
Sqladd("    INNER JOIN dbo.MERCADOS ME ON O.Mercado = ME.Codigo ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
Sqladd(" AND T.NrTrans = M.NrTrans2 ")
Sqladd(" AND M.Especie = O.Especie ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND C.Codigo  = M.Cuenta ")
Sqladd(" AND O.TipoOp = MA.TipoOp ")
Sqladd(" AND MA.TipoAsiento = '"~Var('TIPASILT')~"' ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
Sqladd("   AND ((T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
Sqladd("   AND ((T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
if (dialogo.radio1 = 4)
Sqladd(" AND ((O.TipoOp IN ('FXCF','FXVF','FXK')) ")
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO')  ")
else 
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO','TCOPRI')  ")
endif
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ')) ")
Sqladd("   OR (O.TipoOp IN ('FXOCTC','FXOCTV') AND O.Cliente1 Not IN ("~Pipe2Comillas(Val(cm:1))~") AND O.UDN2 IN ("~Pipe2Comillas(Val(rg:1))~"))) ")
else 
if (dialogo.radio1 = 0)
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd(" AND O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO') ")
else 
Sqladd(" AND O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO','TCOPRI') ")
endif
Sqladd(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
else 
if (dialogo.radio1 = 1)
Sqladd(" AND O.TipoOp IN ('FXK')")
else 
if (dialogo.radio1 = 2)
Sqladd(" AND O.TipoOp IN ('FXOCTC','FXOCTV','FXCF','FXVF') ")
Sqladd(" AND O.Cliente1 Not IN ("~Pipe2Comillas(Val(cm:1))~") ")
Sqladd(" AND O.UDN2 IN ("~Pipe2Comillas(Val(rg:1))~") ")
else 
if (dialogo.radio1 = 3)
endif
endif
endif
