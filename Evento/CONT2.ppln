Sqladd(" Select P.PrecioFin, P.Especie, P.Cupon, P.CantidadFin, P.CantidadIni, P.PrecioIni, P.Cantidad1, P.Precio1, P.PrecioHistCon ")
Sqladd(" From "~Dbo()~".POSICIONES P ")
Sqladd(" Where P.Especie = '"~Val(es:1)~"' ")
Sqladd(" AND P.Cliente = '"~Val(vh:1)~"' ")
Sqladd(" AND P.Vehiculo = '"~Val(vh:1)~"' ")
Sqladd(" AND P.Fecha <= '"~IdxDate(Val(fe:88))~"' ")
Sqladd(" AND P.CantidadFin >= 0 ")
Sqladd(" AND P.Book = '"~Val(bk:1)~"' ")
Sqladd(" AND P.Cupon = '"~Val(cu:1)~"' ")
Sqladd(" AND P.NrSaldo = "~FStr(Val(sl:1), 0, 0)~" ")
Sqladd(" AND P.Fecha IN (Select Max(Fecha) From "~Dbo()~".POSICIONES P1 ")
Sqladd("      Where P1.Especie = P.Especie ")
Sqladd("      AND P1.Vehiculo = P.Vehiculo ")
Sqladd("      AND P1.Cliente = P.Cliente ")
Sqladd("      AND P1.NrSaldo = P.NrSaldo ")
Sqladd("      AND P1.Book = P.Book ")
Sqladd("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
Sqladd("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
Sqladd("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
Sqladd("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
Sqladd("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
Sqladd("      AND P1.Fecha <= '"~IdxDate(Val(fe:88))~"') ")
Watch(Sqlbatch())
recorrer sql
