Sqladd(" Select T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, Abs(M.Cantidad) as Cantidad, MA.Codigo CodAsi, ")
Sqladd(" CL.Jerarquia, CL.PaisDir, Case when T.Tipotr2 = 'MATCH' Then T.Cuenta3 else T.Cuenta1 end Cuenta1, ")
Sqladd(" O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Mercado4, ")
Sqladd(" Case when T.Tipotr2 = 'MATCH' Then T.Cuenta4 else T.Cuenta2 end Cuenta2, ")
Sqladd(" O.Cuenta3, Case when T.TipoTr2 = 'MATCH' then T.Especie1 else T.Especie end Especie, ")
Sqladd(" O.TipoOp, O.NrOperacion, ")
Sqladd(" '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, ")
Sqladd(" O.Cliente1 Cliente, Abs(M.Cantidad) ImporteVoucher, M.Especie MonedaLiq, C.Mercado, O.TotalBrutoCli1, O.FechaVto, ")
Sqladd(" M.Cuenta, T.Fecha2, T.Fecha1, O.FechaPago, O.FechaOp, O.Cliente1, O.Precio1, O.Plazo, O.Book1, C.CuentaContable2, ")
Sqladd(" C.CuentaContable1, CL.CategDepositante, T.Cliente1 ClienteVoucher, O.TotalComisiones Comision, T.TipoTr2, ")
Sqladd(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, O.ContraEspecie Moneda, O.Cupon1, T.Fecha1, T.Fecha2, ME.Netea, ")
Sqladd(" O.CB4, T.Cantidad26 ConceptoLiq, M.Cantidad ImporteMtm, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos1 WHEN O.TipoOp ='FXCF' OR O.TipoOp='FXVF' THEN O.TotalAux1 ELSE O.TotalAux2 END as ComisionOp, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos2 ELSE O.TotalIva END as IvaComision, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalDerechos ELSE O.TotalGastos END DerechoMercado, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalIva ELSE O.TotalIvaAdi END IvaDerechos, ")
Sqladd(" E.Tipo TipoEspecie,TotalBrutoCli3, E.Issuer, E.Alias1 as EspBanTotal, O.Mercado2 MerLiqMon,O.Especie EspecieOp, T.Especie MonedaVou, O.TotalIntereses Interes, ")
Sqladd(" MA.TipoAsiento, O.Mercado4 MerNegociacion, M.Cliente CliMov, O.Cliente4 CliCentral, CASE WHEN O.TipoOp in ('DDC','DDV') AND (M.Leyenda like '%IVA Derecho%' OR M.Leyenda like '%Bolsa%' ) THEN 0 ELSE 1 END AS GeneraDerecho, O.FechaVto2, ")
Sqladd(" O.Mercado, O.Mercado2, O.Cantidad CantidadOp, M.NrMov, O.CB5,O.RB10")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("    INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
Sqladd("    INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV','FXJ'))) ")
Sqladd("    INNER JOIN "~Dbo()~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
Sqladd("    INNER JOIN "~Dbo()~".CUENTAS C ON M.Cuenta = C.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")
Sqladd("    INNER JOIN dbo.MERCADOS ME ON O.Mercado2 = ME.Codigo ")
Sqladd("  Where O.NrOperacion = M.NrOperacion ")
Sqladd("   AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
Sqladd("   AND T.NrTrans = M.NrTrans2 ")
Sqladd("   AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV','FXJ')))")
Sqladd("   AND M.NrSaldo = 1 ")
Sqladd("   AND M.NrMov not in (12,14) ")
Sqladd("   AND C.Codigo  = M.Cuenta ")
Sqladd("   AND O.TipoOp = MA.TipoOp ")
Sqladd("   AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") ")
Sqladd("   AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd("   AND MA.Habilitado = 'SI' ")
Sqladd("   AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
Sqladd("   AND ((T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
Sqladd("   AND ((T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
if (dialogo.radio1 = 4)
Sqladd(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO','TICF','TIVF','FXCF','FXVF','FXK','FXC','FXV','FXJ')) ")
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
else 
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
endif
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ')) ")
Sqladd(" OR O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
Sqladd(") ")
else 
if (dialogo.radio1 = 0)
Sqladd(" AND ((O.TipoOp IN ('TICF','TIVF')) ")
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
else 
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
endif
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
else 
if (dialogo.radio1 = 1)
Sqladd(" AND O.TipoOp IN ('FXK','FXC','FXV','FXJ')")
else 
if (dialogo.radio1 = 2)
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
else 
if (dialogo.radio1 = 3)
Sqladd(" AND O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
endif
endif
endif
endif
endif
