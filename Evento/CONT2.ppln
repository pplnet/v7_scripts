Sqladd("SELECT *, CASE WHEN LeyendaMov like  'IVA%' THEN Cantidad ELSE 0 END as  IVA, ")
Sqladd("          CASE WHEN LeyendaMov like  'WTH%' THEN cantidad ELSE 0 END as  WTH ")
Sqladd("    from ( ")
Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, ")
Sqladd("       Case when T.TipoTr2= 'MATCH' then T.Cantidad2 else T.Cantidad1 end as Cantidad, ")
Sqladd("       MA.Codigo as CodAsi, ")
Sqladd("       C.Jerarquia, C.PaisDir, ")
Sqladd("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado as Precio1, O.ContraEspecie, ")
Sqladd("       T.Cuenta2, T.Especie, ")
Sqladd("       O.TipoOp as TipoOp, C.CategDepositante, ")
Sqladd("       O.NrOperacion, O.FechaOp, O.Corporate as Cartera,")
Sqladd("       '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, ")
Sqladd("       O.Cliente2 as  Cliente, MO.Leyenda LeyendaMov ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVEJECUTADOS MO ")
Sqladd("WHERE O.TipoOp IN ('CONU') ")
Sqladd(" AND O.NrOperacion = MO.NrOperacion ")
Sqladd(" AND T.NrTrans = MO.NrTrans2 ")
Sqladd(" AND MO.Especie = '"~Var('MONELOCA')~"' ")
Sqladd(" AND MO.NrSaldo = 1 ")
Sqladd(" AND C.Codigo  = O.Cliente2 ")
Sqladd(" AND O.TipoOp = MA.TipoOp ")
Sqladd(" AND MA.TipoAsiento = '"~Var('TIPASICLLI')~"' ")
Sqladd(" AND T.TipoTr2 in ('RET','DEP','MATCH') ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd("  ) as Aux ")
Watch(Sqlbatch())
recorrer sql
Acd(fv:1, Fbn('Fecha'))
Acd(fd:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, Fbn('TipoOp'))
Act(nr:1, Fbn('NrOperacion'))
Act(nr:2, Fbn('NrTrans'))
Acn(iv:1, Fbn('IVA'))
Acn(wt:1, Fbn('WTH'))
Acn(nt:1, Val(iv:1) + Val(wt:1))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrTrans2 = '"~Fbn('NrTrans')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, Fbn('NrTrans'), null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
endif

