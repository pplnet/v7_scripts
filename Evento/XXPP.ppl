MostrarCuadroDeMensajes
HOJAVISIBLE(SI)
CrearDialogo
  Fecha1 :"Fecha: " ;1;1;;NO;;;;;;FSYS
  String :'Path:  ' ;2;1;;;;NOVACIO(Dialogo.String);'Path Invalido';NO;VAR('DIRDATANET');
  String2   :"Nuevo Directorio" ;;;;;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;0
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(fi:1,0)

ACT(ww:1, PrimerArchivo(MIRT(TRIM(Dialogo.String))~'\*.dat') )

If NOT Vacio(VAL(ww:1))

  * --- Abre el archivo
  AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(ww:1),0)
  ACN(ww:2,0)
  message(' Abriendo Archivo '~MIRT(TRIM(Dialogo.String))~Val(ww:1))

  Recorrer&i 1,10000000
    * Lee el registro
    ACT(x:1,LEERASCII)

    * Guardo la fila por donde voy
    ACN(fi:1, &i)
    ACN(fi:2, &i)
    * Si esta vacio se va
    If Vacio(val(x:1))
      Break  
    Endif

    ACT(c:1,VAL(ww:1))
    ACN(fi:3, 1)

    * Si es un registro de inicio
    If Incluido(Copy(Val(x:1),1,1),'I')
      If Not Incluido(Copy(Val(x:1),17,6),'DNCTAS|DNAHMS|DNCCDO|DNCADO')
        * --- Si no es un arechivo de mov, sale y lee el proximo
        message('No es un archivo de Saldos y Movimientos')
        Break
      Endif

      ACT(nu:1, GetNumerador(10105))

      * --- Pregunta por el tipo de cuenta y crea el nombre correspondiente --- *

      If Incluido(Copy(Val(x:1),17,6),'DNCTAS')
        message('Tipo de Archivo encontrado: DNCTAS')
        ACT(a:&i, 'DNCTAS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNAHMS')
        message('Tipo de Archivo encontrado: DNAHMS')
        ACT(a:&i, 'DNAHMS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNCCDO')
        message('Tipo de Archivo encontrado: DNAHMS')
        ACT(a:&i, 'DNCCDO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif
 
      If Incluido(Copy(Val(x:1),17,6),'DNCADO')
        message('Tipo de Archivo encontrado: DNCADO')
        ACT(a:&i, 'DNCADO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif
    Else
      ACT(b:&i,  Val(x:1))
    Endif
  Proximo
  CerrarAscii
  ACN(ww:2,1)
EndIf

If Val(ww:2)=0
  CerrarAscii
  ACN(ww:2,1)
Endif


Recorrer&j 2,1000000
  ACT(ww:&j, ProximoArchivo)

  If Not OK
     Break
  EndIf

  ACT(c:&j,VAL(ww:&j))
  ACN(fi:3, &j)

  * --- Abre proximo archivo
  AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(ww:&j),0)
  ACN(ww:2,0)
  message(' Abriendo Archivo '~MIRT(TRIM(Dialogo.String))~Val(ww:&j))

  Recorrer&i Val(fi:1),10000000
    * Lee el registro
    ACT(x:1,LEERASCII)

    *???
    ACN(fi:1, &i)

    ACN(fi:2, &i)

    * Si esta vacio se va
    If Vacio(val(x:1))
      Break  
    Endif

    * --- Si es un registro de inicio
    If Incluido(Copy(Val(x:1),1,1),'I')
      If Not Incluido(Copy(Val(x:1),17,6),'DNCTAS|DNAHMS|DNCCDO|DNCADO|')
        * --- Si no es un arechivo de mov, sale y lee el proximo
        message('No es un archivo de Saldos y Movimientos')
        Break
      Endif
      ACT(nu:1, GetNumerador(10105))

      *Pregunta por el tipo de cuenta
      If Incluido(Copy(Val(x:1),17,6),'DNCTAS')
        message('Tipo de Archivo encontrado: DNCTAS')
        ACT(a:&i, 'DNCTAS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNAHMS')
        message('Tipo de Archivo encontrado: DNAHMS')
        ACT(a:&i, 'DNAHMS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNCCDO')
        message('Tipo de Archivo encontrado: DNCCDO')
        ACT(a:&i, 'DNCCDO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif
  
      If Incluido(Copy(Val(x:1),17,6),'DNCADO')
        message('Tipo de Archivo encontrado: DNCADO')
        ACT(a:&i, 'DNCADO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        ACT(b:&i,  Val(x:1))
      Endif
    Else
      ACT(b:&i,  Val(x:1))
    Endif
  Proximo

  messagebox('cierra el archivo porque va a leer el proximo')
  CerrarAscii
  ACN(ww:2,1)

Proximo

*If Val(ww:2)=0
  CerrarAscii
*  ACN(ww:2,1)
*Endif

* -------------------------------------------------------------------------- *

* leer desde 1 hasta fi:2 y generar los archivos.

message(' Generando division de archivos ...')

Recorrer&i 1, Val(fi:2)
 If NoVacio(Val(a:&i)) 
messagebox('A')
    * --- es un nuevo archivo --- *
    If &i<>1
      CerrarAscii
      ACN(ww:2,1)
    Endif
    AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(a:&i),0)
    ACN(ww:2,0)
    message('Nuevo archivo: '~MIRT(TRIM(Dialogo.String))~Val(a:&i))
    EscribirAscii(Val(b:&i))
    Esperar(5)
    messagebox('B')
 Else
   If NoVacio(Val(b:&i))
     EscribirAscii(Val(b:&i))
   Else
     Break
   Endif
 Endif
Proximo

If Val(ww:2)=0
  CerrarAscii
  ACN(ww:2,1)
Endif


Recorrer&i 1,10000000
   If Vacio(Val(c:&i))
     Break
   Endif

   * Largo del nombre
   ACN(ar:2, Longitud(Val(c:&i)))
   * Le resto el .dat 
   ACN(ar:3, Val(ar:2)-4)
   * Guardo el nombre sin extension
   ACT(ar:4, COPY(Val(c:&i),1,Val(ar:3)))

   ACT(ar:1, Val(ar:4)~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")

   If Dialogo.Radio1=0
     WinExec("COMMAND.COM /C COPY  "~MIRT(TRIM(Dialogo.String))~Val(c:&i)~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
     Esperar(5)
     WinExec("COMMAND.COM /C del   "~MIRT(TRIM(Dialogo.String))~Val(c:&i),0)
     Esperar(5)
   Else
     WinExec("CMD.EXE /C COPY  "~MIRT(TRIM(Dialogo.String))~Val(c:&i)~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
     Esperar(5)
     WinExec("CMD.EXE /C del   "~MIRT(TRIM(Dialogo.String))~Val(c:&i),0)
     Esperar(5)
   Endif
Proximo

*IF NO
