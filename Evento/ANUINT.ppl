CrearDialogo
  Vehiculo1    : "Vehiculo"  ;1;1;1;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Fecha1       : "Fecha"     ;2;1;1;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  NrOperacion1 : "Operacion" ;;;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

Message('Buscando Operaciones...') 

SQL.ADD(" Select MP.FechaMov, O.TipoOp, MP.Cliente, MP.NrOperacion, O.Especie,")
SQL.ADD("        O.Cantidad CantidadO,  MP.Cantidad CantidadMP,     O.ContraEspecie")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES MP")
SQL.ADD(" Where     O.NrOperacion = MP.NrOperacion")
SQL.ADD("       and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("       and O.ContraEspecie = MP.Especie  ")
SQL.ADD("       and O.TipoOp In ('TICO','TICT','TIDE','TIPO') ")
SQL.ADD("       and O.CB8='1' ")
If NoVacio(Dialogo.NrOperacion1)
    SQL.ADD("   and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Else
    SQL.ADD("   and O.FechaVto  = '"~IdxDate(Dialogo.Fecha1)~"'")
EndIf

watch(sql.batch())

Recorrer SQL
   ACN(a:fac, FBN['FechaMov'] )
   ACT(b:fac, FBN['TipoOp'] )
   ACT(c:fac, FBN['Cliente'] )
   ACT(d:fac, FBN['NrOperacion'] )
   ACN(e:fac, FBN['CantidadO'] )
   ACN(f:fac, FBN['CantidadMP'] )   
   ACT(g:fac, FBN['Especie'] )
   ACT(h:fac, FBN['ContraEspecie'] )
   ACN(i:fac, 1)
Proximo

If fac > 0
   CrearListBox;'Arial,8,';'Cotizaciones'
    'OK'           ;i:1..i:Fac;SI;;; 40; CHECK ;    RGB(160,160,193)
    'Fecha'        ;a:1..a:fac;NO;;; 70; FECHA ;    RGB(250,250,193)
    'TipoOp'       ;b:1..b:fac;NO;;; 90; STRING;    ;RGB(250,250,193)
    'Ciente'       ;c:1..c:fac;NO;;;110; STRING;    ;RGB(250,250,193)
    'NrOperacion'  ;d:1..d:fac;NO;;; 70; STRING;    ;RGB(250,250,193)
    'CantidadO'    ;e:1..e:fac;NO;;; 70; NUMERO;    ;RGB(250,250,193)
    'CantidadMP'   ;f:1..f:fac;NO;;; 70; NUMERO;    ;RGB(250,250,193)
    'Especie'      ;g:1..g:fac;NO;;; 70; STRING;    ;RGB(250,250,193)
    'Moneda'       ;h:1..h:fac;NO;;; 70; STRING;    ;RGB(250,250,193)
   FinListBox
   If Not Ok
      Cancelar
   Endif   
else
  MessageBox('No se encontraron Prestamos para anular intereses.')
endif



Recorrer &I 1, fac
    If val(i:&I) = 1
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set Precio2    = 0,  ")
        SQL.ADD("TotalBrutoCli3 = 0,  ")
        SQL.ADD("PorCaucion     = 0,  ")
        SQL.ADD("TotalGanancias = 0,  ")
        SQL.ADD("TotalNetoCli3  = 0,  ")
        SQL.ADD("CB8            = 0   ")
        SQL.ADD("where NrOperacion = '"~val(d:&i)~"' ")
        SQL.NEW
        
        SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
        SQL.ADD("Where NrOperacion = '"~val(d:&i)~"'")
        SQL.ADD("and   Especie = '"~val(h:&i)~"'")
        SQL.NEW
        
        SQL.EXEC
    EndIf
Proximo

