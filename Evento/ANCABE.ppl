* Anula la  Operaciones cabecera y sus operaciones Relacionadas 
CrearDialogo
  NrOperacion1: 'Nr.Operacion:' ;;;;NO;
FinDialogo

If Not OK
  Cancelar
EndIf



SQL.ADD(" Select * from "~DBO~".OPERACIONES Where ")
SQL.ADD(" OperacionRef = '"~Dialogo.NrOperacion1~"'")
SQL.ADD(" Order By NrOperacion")

Recorrer SQL

  Message('Procesando Operacion '~FBN['NrOperacion']~' ...')

  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1'))
  ACD(d:fac, fbn('FechaOp'))
proximo

ACO(3,15)
ACO(4,8)

ListBox(a1..d:fac, '# Op     Tipo     Entidad            Fecha')

if Ok
   ACN(A2,MessageBox('Todas las Operaciones Relacionadas con '~Dialogo.NrOperacion1~' Seran Eliminadas',2,1))

   IF VAL(A2)=1
      Message(' Anulando Operaciones Relacionadas ...')
      SQL.ADD("DELETE "~DBO~".OPERACIONES Where")
      SQL.ADD(" OperacionRef = '"~Dialogo.NrOperacion1~"'")
      SQL.NEW

      Message(' Anulando los Datos Relacionados con la Operacion '~Dialogo.NrOperacion1)
      SQL.ADD("DELETE "~DBO~".CUOTAS Where")
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"' ")
      SQL.NEW

      SQL.ADD("DELETE "~DBO~".COMISIONES2 Where")
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"' ")
      SQL.NEW

      SQL.ADD("DELETE "~DBO~".OPSCALLSPUTS Where")
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"' ")
      SQL.NEW

      Message(' Anulando la Operacion '~Dialogo.NrOperacion1)
      SQL.ADD("DELETE "~DBO~".OPERACIONES Where")
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"' ")
      SQL.NEW
      SQL.EXEC    
   ENDIF
EndIf

