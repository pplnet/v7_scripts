creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
findialogo

if (not ok)
Cancelar()

endif

Act(aa:5, Query("select convert(varchar(8),Getdate(),112)"))

if (not existedirectorio(Var("PATHBASCON")))
Messagebox("No existe el directorio "~Var("PATHBASCON"))
Cancelar()
endif

Sqladd("SELECT A.NrUnicoAsiento,convert(varchar(8),A.FechaValor,112) as FechaValor,convert(varchar(8),A.FechaValor,112) as FechaLiquidacion,substring(A1.Cuenta,1,9) as Cuenta,")
Sqladd("case when A1.DebitoCredito='DEB' then 'D' else 'C' end as DC,str(A1.Cantidad1,14,2) as Cantidad1,isnull(RTRIM(A.NrOperacion),'') as NrOperacion,")
Sqladd("isnull(RTRIM(A.Modelo),'') + ' ' + isnull(RTRIM(A.NrOperacion),'') + ' ' + isnull(RTRIM(A.NrTrans2),'') as Descripcion")
Sqladd("FROM dbo.ASIENTOSCON A INNER JOIN dbo.ASIENTOSCON1 A1 on (A.NrUnicoAsiento=A1.NrUnicoAsiento)")
Sqladd("where A.FechaGeneracion = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and isnull(a.Estado,'') <> 'E'")

Act(bb:1, "N")
Acn(aa:4, 0)
Acn(aa:6, 0)
Acn(aa:7, 0)

recorrer sql

if (Eqstr(Val(bb:1), "N"))
AbrirAscii(Var("PATHBASCON")~"\"~Var("ARCHBASCON")~"("~Copy(Val(aa:5), 1, 4)~Copy(Val(aa:5), 5, 2)~Copy(Val(aa:5), 7, 2)~"-"~Copy(Hora(SQLAhora()), 1, 2)~Copy(Hora(SQLAhora()), 4, 2)~Copy(Hora(SQLAhora()), 7, 2)~")", 0)
Acn(aa:2, Fbn()['NrUnicoAsiento'])
endif

Act(bb:1, "S")

if (not Val(aa:2) = Fbn()['NrUnicoAsiento'])
Acn(aa:2, Fbn()['NrUnicoAsiento'])
Acn(aa:1, 1)
else
Acn(aa:1, Val(aa:1) + 1)
endif

EscribirAscii("001"~Pad0(Fbn('NrUnicoAsiento'), 9)~Pad0(Val(aa:1), 4)~Copy(IdxDate(dialogo.fecha1), 1, 4)~Copy(IdxDate(dialogo.fecha1), 6, 2)~Copy(IdxDate(dialogo.fecha1), 9, 2)~Fbn()['FechaValor']~Fbn()['FechaLiquidacion']~Pad0(Fbn()['Cuenta'], 9)~"        000000      000"~Fbn()['DC']~Pad0(Copy(Fbn()['Cantidad1'], 1, Posicion('.', Fbn()['Cantidad1'], 1) - 1)~Copy(Fbn()['Cantidad1'], Posicion('.', Fbn()['Cantidad1'], 1) + 1, 2), 14)~Pad0('0', 14)~Pad(Fbn()['Descripcion'], 40)~Pad0('0', 6)~Pad0('0', 98)~Pad('', 35)~Pad(Fbn('NrOperacion'), 8)~Pad0('0', 3))

Acn(aa:4, Val(aa:4) + 1)
Acn(aa:6, Val(aa:6) + Fbn('NrUnicoAsiento'))
Acn(aa:7, Val(aa:7) + Fbn('cantidad1'))

Query("Update dbo.ASIENTOSCON set Estado='E' Where NrUnicoAsiento='"~Fbn()['NrUnicoAsiento']~"'")
proximo


if (Eqstr(Val(bb:1), "S"))
Act(aa:7, FStr(Val(aa:7), 18, 2))
EscribirAscii(Pad0(Val(aa:4), 18)~Pad0(Val(aa:6), 18)~Pad0(Copy(Val(aa:7), 1, Posicion('.', Val(aa:7), 1) - 1)~Copy(Val(aa:7), Posicion('.', Val(aa:7), 1) + 1, 2), 18)~Pad('', 218))
CerrarAscii()
endif

