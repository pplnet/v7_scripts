ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPCCM|MMPCCV|SEPVMV|');'El TipoOp debe ser MMPCCM|MMPCCV|SEPVMV|';NO;;;;;;" TipoOp in ('MMPCCM','MMPCCV','SEPVMV') "
  Radio1      : "|Alta|Renovacion" ;;;;;;Dialogo.Radio1=0 o Dialogo.Radio1=1;'Debe seleccionar una opcion';NO
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACPRV')
FinDialogo

If Not OK
  Cancelar
Endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

SQL.ADD("Select O.TipoOp, O.Cliente1,O.MB3, O.Especie, O.Cuenta1,O.RB3, O.Vehiculo1,O.Cuenta5,O.TotalBrutoCli1,O.Cuenta2,O.Cuenta4, O.Plazo, O.FechaVto, O.Precio1,O.TotalIntereses,")
SQL.ADD(" O.Cantidad, O.FechaOp,O.TotalIntereses, O.TotalRetenciones, ")
SQL.ADD("C.Precio2")
SQL.ADD(" From "~DBO~".OPERACIONES O  ")
SQL.ADD(" LEFT JOIN "~DBO~".CUOTAS C")
SQL.ADD("  ON C.NrOperacion = O.NrOperacion ")
SQL.ADD(" Where O.NrOperacion ='"~Dialogo.NrOperacion1~"'")

Recorrer SQL
  ACT(zd:99, PYC(fbn['Cantidad'],1,2))
  ACN(zd:88, fbn['Cantidad'])
  ACD(zi:99, fbn['FechaVto'])
  ACT(zj:99, PYC(fbn['Precio1'],1,2))
  ACD(zm:99, fbn['FechaOp'])
  ACN(xa:99,fbn['MB3'])
  ACN(ca:99,fbn['Plazo'])
  ACN(da:99,fbn['TotalBrutoCli1'])
  ACT(ee:99,fbn['Especie'])
  ACN(ee:98,Cotizacion(val(ee:99),,,,val(zm:99),1))
  ACT(ii:99,BuscarCampo('ESPECIES','Extendido','Codigo',Fbn['Especie']))
  ACT(zz:99,fbn['Vehiculo1'])
  IF Val(xa:99)=0
    ***---Colocacion
    ACT(ab:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
    ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
    ACT(ba:1,fbn['Cuenta5'])  
    ACT(gg:1,fbn['Cuenta2'])    
    ACT(da:1,fbn['Cuenta4'])      
    ACT(ea:1,fbn['Cuenta1']) 
  else
    ***---Toma
    ACT(ab:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
    ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
    ACT(ba:1,fbn['Cuenta2'])
    ACT(gg:1,fbn['Cuenta5']) 
    ACT(da:1,fbn['Cuenta1'])  
    ACT(ea:1,fbn['Cuenta4'])   
  endIf  
   IF EqStr(fbn['TipoOp'],'SEPVMV')
    ACT(aa:1,' DE TITULOS')
    ACT(bb:1,'de Titulos') 
  else
    ACT(aa:1,' EN EFECTIVO')
    ACT(bb:1,'en Efectivo') 
  endif
   **NO MULTIPLE VENCIMIENTO
   IF EqStr(fbn['TipoOp'],'MMPCCV')
    ACN(jj:1,fbn['TotalIntereses'])
    ACN(kk:1,fbn['TotalIntereses']  * VAR('TASACOMPEN')/100 )

    else
   
   ACN(jj:1,fbn['Precio2'])
   ACN(kk:1,fbn['Precio2']  * VAR('TASACOMPEN')/100)

   endif
Proximo
ACD(zn:99,Fsys)    

let &razon_social1 Val(ab:1)
let &razon_social2 Val(ac:1)


IF EqStr(Val(aa:1),' EN EFECTIVO')  
      
  let &uno '      1. Prestataria: ' ~Val(ab:1)
  let &dos '      2. Prestamista: ' ~Val(ac:1)
  let &tres '      3. Capital de Pr'~Chr(233)~'stamo: '~Val(zd:99)
  let &cuatro '      4. Plazo:'~FStr(Val(ca:99),4,0)~' d'~Chr(237)~'as'
  let &cinco '      5. Fecha de Devoluci'~Chr(243)~'n: '~Val(zi:99)
  let &seis '      6. Tasa de Inter'~Chr(233)~'s Compensatorio: '~Val(jj:1)~' %'
  let &siete '      7. Tasa de Inter'~Chr(233)~'s Punitorio: '~Val(kk:1)~' %'
  let &ocho '      8. Cuenta Para Pagos de '~Val(ab:1)~': '~Val(ba:1)
  let &nueve '      9. Cuenta Para Pagos de '~Val(ac:1)~' : '~Val(gg:1)
  let &diez ''
  let &once ''
  let &doce ''
  let &trece ''
      
else
      
  let &uno '      1. Prestataria: ' ~Val(ab:1)
  let &dos '      2. Prestamista: ' ~Val(ac:1)
  let &tres '      3. Denominaci'~Chr(243)~'n y Serie de T'~Chr(237)~'tulos Valores: '~val(ii:99)
  let &cuatro '      4. Monto del Pr'~Chr(233)~'stamo: ' ~Val(zd:99)
  let &cinco '      5.Valor de los T'~Chr(237)~'tulos: '~Val(ee:98)
  let &seis '      6. Plazo:'~FStr(Val(ca:99),4,0)~' d'~Chr(237)~'as'
  let &siete '      7. Fecha de Devoluci'~Chr(243)~'n: '~Val(zi:99)
  let &ocho '      8. Tasa de Inter'~Chr(233)~'s Compensatorio: '~Val(jj:1)~' %'
  let &nueve '      9. Tasa de Inter'~Chr(233)~'s Punitorio: '~Val(kk:1)~' %'
  let &diez '      10. Cuenta Para Pagos de '~Val(ab:1)~':'~Val(ba:1)
  let &once '      11. Cuenta Para Pagos de '~Val(ac:1)~':'~Val(gg:1)
  let &doce '      12. Cuenta de T'~Chr(237)~'tulos de  '~Val(ab:1)~':'~Val(da:1)
  let &trece '      13. Cuenta de T'~Chr(237)~'tulos de   '~Val(ac:1)~':'~Val(ea:1)
  
endIf


 If Dialogo.Radio1=0

   
   let &titulo 'MODELO DE SOLICITUD PARA'~Chr(13)~'OPERACIONES DE PRESTAMO'~Val(aa:1)
   
   let &fecha Val(zn:99)
   
   let &re 'Acuerdo Marco para la Realizaci'~Chr(243)~'n de Operaciones Financieras entre ' ~Val(ab:1)~' y ' ~Val(ac:1)~' de fecha '~FStr(Dia(Val(zn:99)),2,0)~' de ' ~ Meses(Mes(Val(zn:99)))~' de ' ~ FStr(Anio(Val(zn:99)),4,0)~' (el "Acuerdo Marco")'
   
   let &oracion11 'La presente constituye una Solicitud en los t'~Chr(233)~'rminos del art'~Chr(237)~'culo 1 b) del Acuerdo Marco (la "Solicitud")'
   let &oracion12 ''
   
   let &oracion21 'Todos los t'~Chr(233)~'rminos en may'~Chr(250)~'scula no definidos, excepto cuando inicien una oraci'~Chr(243)~'n o constituyan un '
   let &oracion22 'nombre propio, tendr'~Chr(225)~'n el significado establecido en el Acuerdo Marco.'
   
   let &oracion31 'Se deja expresa constancia que, en el evento de cualquier tipo de inconsistencia entre las definiciones y/o los t'~Chr(233)~'rminos '
   let &oracion32 'y condiciones de la presente con aquellas y/o aquellos contenidos en el Acuerdo Marco, lo que ha sido previsto en la presente Solicitud prevalecer'~Chr(225)~'.'
   
   let &oracion4 'La presente Solicitud se considerar'~Chr(225)~' afectada por la Prestamista en caso que '~Chr(233)~'sta, dentro de los 2 D'~Chr(237)~'as '
   let &oracion5 'H'~Chr(225)~'biles de recibida la presente, transfiera el Capital del Pr'~Chr(233)~'stamo (o su equivalente en otras monedas) '
   let &oracion6 'a nuestra Cuenta para Pagos, o entregue a un representante de la Prestataria un cheque por el Capital del Pr'~Chr(233)~'stamo (o si equivalente en otras monedas).'
   let &oracion7 ''

  Else
   
   let &titulo 'OPERACIONES DE PR'~Chr(201)~'STAMO'~Val(aa:1)
   let &fecha Val(zn:99)
   
   let &re 'Acuerdo Marco para la Realizaci'~Chr(243)~'n de Operaciones Financieras entre ' ~Val(ab:1)~' y ' ~Val(ac:1)~' de fecha '~FStr(Dia(Val(zn:99)),2,0)~' de ' ~ Meses(Mes(Val(zn:99)))~' de ' ~ FStr(Anio(Val(zn:99)),4,0)~' (el "Acuerdo Marco") y Solicitud de fecha '~FStr(Dia(Val(zm:99)),2,0)~' de ' ~ Meses(Mes(Val(zm:99)))~' de ' ~ FStr(Anio(Val(zm:99)),4,0)~' enviada ' ~Val(ab:1)~' a ' ~Val(ac:1)~' (la "Solicitud").   '
   
   let &oracion11 'Todos los t'~Chr(233)~'rminos en may'~Chr(250)~'scula no definidos, excepto cuando inicien una oraci'~Chr(243)~'n o constituyan un nombre '
   let &oracion12 'propio, tendr'~Chr(225)~'n el significado establecido en el Acuerdo Marco o en la Solicitud, seg'~Chr(250)~'n corresponda. '
   
   let &oracion21 'La presente suplementa la Solicitud y deber'~Chr(225)~' considerarse junto con la Solicitud como un '~Chr(250)~'nico documento. Todos aquellos t'~Chr(233)~'rminos y '
   let &oracion22 'condiciones no modificados expresamente en la presente continuar'~Chr(225)~'n tal como fueran acordados por las partes al momento de aceptar la Solicitud.'
   
   let &oracion31 'Conforme las conversaciones que mantuvi'~Chr(233)~'ramos recientemente, entendemos que resulta conveniente modificar la Fecha de Devoluci'~Chr(243)~'n '
   let &oracion32 'de modo que la Operaci'~Chr(243)~'n de Pr'~Chr(233)~'stamo '~Val(bb:1)~' se sujetar'~Chr(225)~' a los siguientes t'~Chr(233)~'rminos y condiciones:'
   
   IF EqStr(Val(bb:1),'en Efectivo')
      let &cinco '      5. Nueva Fecha de Devoluci'~Chr(243)~'n: '~Val(zi:99)
   else
      let &siete '      7. Nueva Fecha de Devoluci'~Chr(243)~'n: '~Val(zi:99)    
   endIf
   
   let &oracion4 'La presente oferta se considerar'~Chr(225)~' aceptada en caso que Uds. dentro de los 30 dias corridos de la presente (el "Plazo de Aceptaci'~Chr(243)~'n")'
   let &oracion5 'procedan a acreditar los Intereses Compensatorios devengados desde la fecha de la Solicitud hasta la Fecha de Devoluci'~Chr(243)~'n. A los efectos del Plazo de '
   let &oracion6 'Aceptaci'~Chr(243)~'n antes referido se entender'~Chr(225)~' que, mientras el mismo no haya vencido, no se devengar'~Chr(225)~'n Intereses Punitorios '
   let &oracion7 'por la Operaci'~Chr(243)~'n, aunque si se devengaran los Intereses Compensatorios acordados por las Partes en la Solicitud.'
   
 EndIf

 EmitirCartaVisible(&pf, Copy(Dialogo.String1,1,Longitud(Dialogo.String1)-5)~'_'~Dialogo.NrOperacion1, titulo = &titulo, fecha = &fecha, re = &re, razon_social1 = &razon_social1, razon_social2 = &razon_social2, oracion11 = &oracion11, oracion12 = &oracion12, oracion21 = &oracion21, oracion22 = &oracion22, oracion31 = &oracion31, oracion32 = &oracion32, oracion4 = &oracion4, oracion5 = &oracion5, oracion6 = &oracion6, oracion7 = &oracion7, uno = &uno, dos = &dos, tres = &tres, cuatro = &cuatro, cinco = &cinco, seis = &seis, siete = &siete, ocho = &ocho, nueve = &nueve, diez = &diez, once = &once, doce = &doce, trece = &trece)


