MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
lista1: 'Vehiculos';3;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
listatabla1: 'Operaciones';-3;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';;;;NO;NO;
findialogo

if (not ok)
Cancelar()
endif

Message('--- Asientos de Concertacion ---')

Act(us:1, Descendientes('ESPECIES', 'U$S'))
Act(mf:1, Var('MONEEXTR'))

Sqladd(" SELECT O.NrOperacion, Case O.TipoOp When 'MRF   ' Then O.ContraEspecie When 'MRO   ' Then O.ContraEspecie ELSE O.Especie END Especie, ")
Sqladd(" O.FechaOp, O.Cliente1, Case O.TipoOp When 'MRF   ' Then O.Especie When 'MRO   ' Then O.Especie ELSE O.ContraEspecie END ContraEspecie, ")
Sqladd(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, C.CUIT, V.Valor1, V.Valor2, ")
Sqladd(" MA.Codigo CodAsi, O.CB9, O.CB10, E.Tipo, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, E.Cotiza, ")
Sqladd(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, E.Alias8, V.Alias4, O.ContraEspecie Moneda, ")
Sqladd(" O.Cuenta2, O.ViaPago1, O.CantidadOri, O.CB13, 0 NrMov ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, ")
Sqladd(" "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ESPECIES E ")
Sqladd(" WHERE O.Cliente1    =  C.Codigo ")
Sqladd(" AND   O.Vehiculo1   =  V.Codigo ")
Sqladd(" AND   ((O.Especie =  E.Codigo AND O.TipoOp Not IN ('MRF','MRO')) OR (O.ContraEspecie = E.Codigo AND O.TipoOp IN ('MRF','MRO'))) ")
Sqladd(" AND   O.NrOperacion =  B.NrOperacion  ")
Sqladd(" AND   B.Valor       =  '1'      ")
Sqladd(" AND   O.TipoOp      = MA.TipoOp ")
Sqladd(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
Sqladd(" AND   O.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~")  AND (")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" ORDER BY O.NrOperacion ")
Watch(Sqlbatch())
recorrer sql
Acd(fv:1, Fbn('FechaOp'))
Act(vh:1, Fbn('Vehiculo1'))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Fbn('FechaOp'))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
