Linkearhoja('LPOSPA', 4, 'fecha1', FSys())
Acn(a1, Linkh(4, 22:1))
recorrer&i 1, 5
if (Eqstr(Linkh(4, 1 + (2 * &i):Val(a1)), 'Excedido'))
Sendmail(Exe('USRLIMPOS'), 'Exceso de Limites de Posicion', 'Hay Exceso del limite de Pasivos por Vehiculo : '~Mirt(Linkh(4, 2 * &i:8)))
endif
proximo
if (Eqstr(Linkh(4, p:Val(a1)), 'Excedido'))
Sendmail(Exe('USRLIMPOS'), 'Exceso de Limites de Posicion', 'Hay Exceso del limite de Porcentaje de Pasivos en Pesos')
endif
if (Eqstr(Linkh(4, q:Val(a1)), 'Excedido'))
Sendmail(Exe('USRLIMPOS'), 'Exceso de Limites de Posicion', 'Hay Exceso del limite de Porcentaje de Pasivos en M. Extranjera')
endif
Cerrarlink(4)

Linkearhoja('LPOSPI', 5, 'fecha1', FSys(), 'vehiculo1', '')
