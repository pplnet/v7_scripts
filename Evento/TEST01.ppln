sql.add(" Select C.*, E.Cotiza ")
sql.add("   from "~Dbo()~".COTIZACIONES C, "~Dbo()~".ESPECIES E ")
sql.add("  where C.Codigo = E.Codigo ")
sql.add("    and C.Fecha  = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("Order by C.CallPut, C.FechaEj, C.Codigo ")
