mostrarcuadrodemensajes
HojaVisible(SI)
creardialogo
fecha1:"Fecha: ";1;1;;NO;;;;;;FSys()
string:'Path:  ';2;1;;;;NoVacio(dialogo.string);'Path Invalido';NO;Var('DIRDATANET');
string3: 'Archivo';
string2:"Nuevo Directorio";;;;;;NoVacio(dialogo.string2);'Directorio Invalido';NO;Var('DNPROCES')
radio1: '|W98|NT';;;;;;;;;0
entero1: 'Registros';;;;;;;;;Var('DNREGISTRO')
findialogo

if (not ok)
Cancelar()
endif

Acn(fi:1, 0)
Acn(aa:1, 0)

abrirascii(dialogo.string~dialogo.string3, 0)
Message(' Abriendo Archivo '~Mirt(Trim(dialogo.string))~dialogo.string3)


recorrer&i 1, 1000000
Act(x:1, leerascii)

Acn(fi:1, &i)
Acn(fi:2, &i)

if (Vacio(Val(x:1)))
break
endif

Acn(fi:3, 1)


if (Val(e:1) = dialogo.entero1)
Acn(d:&i, 1)
Acn(e:1, 1)
else
Acn(d:&i, 0)
Scn(e:1, 1)
endif

if (Incluido(Copy(Val(x:1), 1, 1), 'I') o Val(d:&i) = 1)

if (Val(d:&i) = 0)
Act(c:1, Val(x:1))
endif

Act(nu:1, getnumerador(10105))


if (Incluido(Copy(Val(x:1), 17, 6), 'DNCTAS') o (Val(d:&i) = 1 y Eqstr(Val(f:1), 'DNCTAS')))
Message('Tipo de Archivo encontrado: DNCTAS')
Act(a:&i, 'DNCTAS'~FStr(Num(Val(nu:1)), 0, 0)~'.DAT')

if (Eqstr(sql(" SELECT /*+ RULE */ Interfase FROM "~Dbo()~".CUENTAS WHERE Alias3 = '"~Trim(Mirt(Copy(Val(x:1), 2, 5)))~"' "), 'DAT') o Incluido(Copy(Val(x:1), 1, 1), 'I|F'))
Act(b:&i, Val(x:1))
else
Act(b:&i, 'NODATANET')
Scn(e:1, -1)
endif


Act(f:1, 'DNCTAS')
Act(g:&i, Val(c:1))
Acn(aa:1, 1)
endif

if (Incluido(Copy(Val(x:1), 17, 6), 'DNAHMS') o (Val(d:&i) = 1 y Eqstr(Val(f:1), 'DNAHMS')))
Message('Tipo de Archivo encontrado: DNAHMS')
Act(a:&i, 'DNAHMS'~FStr(Num(Val(nu:1)), 0, 0)~'.DAT')

if (Eqstr(sql(" SELECT /*+ RULE */ Interfase FROM "~Dbo()~".CUENTAS WHERE Alias3 = '"~Trim(Mirt(Copy(Val(x:1), 2, 5)))~"' "), 'DAT') o Incluido(Copy(Val(x:1), 1, 1), 'I|F'))
Act(b:&i, Val(x:1))
else
Act(b:&i, 'NODATANET')
Scn(e:1, -1)
endif


Act(f:1, 'DNAHMS')
Act(g:&i, Val(c:1))
Acn(aa:1, 1)
endif

if (Incluido(Copy(Val(x:1), 17, 6), 'DNCCDO') o (Val(d:&i) = 1 y Eqstr(Val(f:1), 'DNCCDO')))
Message('Tipo de Archivo encontrado: DNCCDO')
Act(a:&i, 'DNCCDO'~FStr(Num(Val(nu:1)), 0, 0)~'.DAT')

if (Eqstr(sql(" SELECT /*+ RULE */ Interfase FROM "~Dbo()~".CUENTAS WHERE Alias3 = '"~Trim(Mirt(Copy(Val(x:1), 2, 5)))~"' "), 'DAT') o Incluido(Copy(Val(x:1), 1, 1), 'I|F'))
Act(b:&i, Val(x:1))
else
Act(b:&i, 'NODATANET')
Scn(e:1, -1)
endif


Act(f:1, 'DNCCDO')
Act(g:&i, Val(c:1))
Acn(aa:1, 1)
endif

if (Incluido(Copy(Val(x:1), 17, 6), 'DNCADO') o (Val(d:&i) = 1 y Eqstr(Val(f:1), 'DNCADO')))
Message('Tipo de Archivo encontrado: DNCADO')
Act(a:&i, 'DNCADO'~FStr(Num(Val(nu:1)), 0, 0)~'.DAT')

if (Eqstr(sql(" SELECT /*+ RULE */ Interfase FROM "~Dbo()~".CUENTAS WHERE Alias3 = '"~Trim(Mirt(Copy(Val(x:1), 2, 5)))~"' "), 'DAT') o Incluido(Copy(Val(x:1), 1, 1), 'I|F'))
Act(b:&i, Val(x:1))
else
Act(b:&i, 'NODATANET')
Scn(e:1, -1)
endif


Act(f:1, 'DNCADO')
Act(g:&i, Val(c:1))
Acn(aa:1, 1)
endif
Message('Registro '~FStr(Val(aa:1), 0, 0))
else

if (Eqstr(sql(" SELECT /*+ RULE */ Interfase FROM "~Dbo()~".CUENTAS WHERE Alias3 = '"~Trim(Mirt(Copy(Val(x:1), 2, 5)))~"' "), 'DAT') o Incluido(Copy(Val(x:1), 1, 1), 'I|F'))
Act(b:&i, Val(x:1))
else
Act(b:&i, 'NODATANET')
Scn(e:1, -1)
endif


Scn(aa:1, 1)
Message('Registro '~FStr(Val(aa:1), 0, 0))
endif
proximo

cerrarascii



recorrer&i 1, Val(fi:2)

if (NoVacio(Val(a:&i)))
if (&i <> 1)
escribirascii('F')
cerrarascii
endif

abrirascii(Mirt(Trim(dialogo.string))~Val(a:&i), 0)
Message('Nuevo archivo: '~Mirt(Trim(dialogo.string))~Val(a:&i))
if (Val(d:&i) = 1)
escribirascii(Val(g:&i))
endif
if (not Eqstr(Val(b:&i), 'NODATANET'))
escribirascii(Val(b:&i))
endif
else
if (NoVacio(Val(b:&i)))
if (Val(d:&i) = 1)
escribirascii(Val(g:&i))
endif
if (not Eqstr(Val(b:&i), 'NODATANET'))
escribirascii(Val(b:&i))
endif
endif
endif
proximo
cerrarascii

Acn(ar:2, Longitud(dialogo.string3))

Acn(ar:3, Val(ar:2) - 4)

Act(ar:4, Copy(dialogo.string3, 1, Val(ar:3)))

Act(ar:1, Val(ar:4)~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".dat")

if (dialogo.radio1 = 0)
winexec("COMMAND.COM /C COPY  "~Mirt(Trim(dialogo.string))~dialogo.string3~" "~Mirt(Trim(dialogo.string2))~Val(ar:1), 0)
esperar(5)

winexec("COMMAND.COM /C del   "~Mirt(Trim(dialogo.string))~dialogo.string3, 0)
esperar(5)
else
winexec("CMD.EXE /C COPY  "~Mirt(Trim(dialogo.string))~dialogo.string3~" "~Mirt(Trim(dialogo.string2))~Val(ar:1), 0)
esperar(5)

winexec("CMD.EXE /C del   "~Mirt(Trim(dialogo.string))~dialogo.string3, 0)
esperar(5)
endif

