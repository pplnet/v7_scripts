
CrearDialogo
  Fecha1   : 'Fecha'        ;;;;;;;;;Fsys
  Vehiculo1: 'Vehiculo'     ;;;;;;
  Especie1 : 'Especie'      ;;;;
  String1  : 'Tipo Negocio' ;;;;
FinDialogo

if not OK
  Cancelar
endif

SQL.ADD("Exec "~DBO~".RegenerarPosiciones2 '"~IdxDate(Dialogo.Fecha1)~"', '"~Dialogo.Vehiculo1~"', 'CARTERA1' , '"~Dialogo.Especie1~"', '', 0, '"~Dialogo.String1~"' ")
SQL.NEW
SQL.EXEC

EjecutarEvento('REGPOS',Fecha1=Dialogo.Fecha1, Fecha2=FSys, Vehiculo1=Dialogo.Vehiculo1, Especie1=Dialogo.Especie1)