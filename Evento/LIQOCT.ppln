MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha:';;;;;;;;;FSys()
vehiculo1: 'Vehiculo:';;;;;;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
cliente1:'Agente';;;;;;Vacio(dialogo.cliente1) o (dialogo.entero1 <> 0);'Agente Invalido';NO;;;;;;" NrMAE Is Not Null AND NrMAE <> 0 ";
entero1:'NrMAE';;;;NO;NO;;;;;BuscarCampo('CLIENTES', 'NrMAE', 'Codigo', dialogo.cliente1);
findialogo
if (not ok)
Cancelar()
endif

Acn(bd:1, 0)
SetFilaActual(0)
Sqladd(" Select NrTrans From "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Where TipoTr2 = 'LIQOCT' ")
Sqladd(" AND Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Vehiculo1 = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.cliente1))
Sqladd(" AND Cliente1 = '"~dialogo.cliente1~"' ")
endif
recorrer sql
if (Query(" Select 1 From "~Dbo()~".MOVEJECUTADOS Where NrOperacion = '"~Fbn('NrTrans')~"' ") = 1)
Cancelar('El Mark To Mark del dia ya fue liquidado')
else
Acn(bd:1, 1)
Act(ta:fac, Fbn('NrTrans'))
endif
proximo

Acn(fi:1, Fac())
Act(me:1, Var('MERCOCT'))
Act(ct:2, Query("select Codigo from "~Dbo()~".CUENTAS WHERE Cliente = '"~dialogo.vehiculo1~"' AND Estado = 'HAB' and Especies Like '%ARP%' and Permanente = 'SI' "))

Sqladd(" Select Sum(Cantidad) Cantidad, EnteCustodia, Cliente ")
Sqladd(" From "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" Where FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND NrSaldo = 100 ")
Sqladd(" AND EnteCustodia = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.cliente1))
Sqladd(" AND Cliente = '"~dialogo.cliente1~"' ")
endif
Sqladd(" Group By EnteCustodia, Cliente ")

recorrer sql
Act(nt:1, getnumerador(88))
Message('Generando LIQOCT '~Val(nt:1))
Sqladd(" Insert Into "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" (NrTrans, TipoTr2, Cliente1, Especie, ")
Sqladd(" Vehiculo1, Cantidad1, Fecha1, Cuenta1, ")
Sqladd(" FechaCarga, FechaCargaSys, Numerador, UsrInput, ")
Sqladd(" Cambio1, Mercado1, Cuenta2) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nt:1)~"', 'LIQOCT', '"~Fbn('Cliente')~"', 'ARP', ")
Sqladd(" '"~dialogo.vehiculo1~"', "~FStr(Fbn('Cantidad'), 0, 2)~", '"~IdxDate(dialogo.fecha1)~"', '"~Val(ct:1)~"', ")
Sqladd(" "~SQLFecha(Ahora())~", '"~IdxDate(FSys())~"', 88, '"~UsuarioActivo()~"', ")
Sqladd(" 0, '"~Val(me:1)~"', '"~Val(ct:2)~"') ")
Sqlnew()

Sqladd(" Insert Into "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion, NrBit, Valor) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nt:1)~"', 2, '1') ")
Sqlnew()

if (Fbn('Cantidad') <> 0)
Sqladd(" Insert Into "~Dbo()~".MOVPENDIENTES ( ")
Sqladd(" NrOperacion, FechaMov, Cliente, Especie, ")
Sqladd(" Mercado, EnteCustodia, NrSaldo, Cantidad, ")
Sqladd(" Leyenda, Bits, Cuenta, NrMov, ")
Sqladd(" Concepto, NrGrupo, NrGrupo2, NrInstan) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(nt:1)~"', '"~IdxDate(dialogo.fecha1)~"', '"~Fbn('Cliente')~"', 'ARP', ")
Sqladd(" '"~Val(me:1)~"', '"~dialogo.vehiculo1~"', 1, "~FStr(-Fbn('Cantidad'), 0, 2)~", ")
Sqladd(" 'Liquidacion OCT', 'MV', '"~Val(ct:1)~"', 1, ")
Sqladd(" 'OCT', 0, 0, 0) ")
Sqlnew()
endif
Sqladd(" Update "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" Set NrTrans2 = '"~Val(nt:1)~"' ")
Sqladd(" Where FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND NrSaldo = 100 ")
Sqladd(" AND EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND Cliente = '"~Fbn('Cliente')~"' ")
Sqlnew()
Sqlexec()


proximo
if (Val(bd:1) = 1)
Message('***---Anulando Transacciones anteriores')
recorrer&k 1, Val(fi:1)
if (NoVacio(Val(ta:&k)))
Ejecutarevento('ANLOCT', 'nrtrans1', Val(ta:&k))
endif
proximo
endif

