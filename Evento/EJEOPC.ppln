Sqladd("SELECT OP.NrOperacion, '' AS Liquid, OP.Cliente1, OP.Especie, OP.ContraEspecie, OP.TipoOp, ")
Sqladd(" OP.Cantidad, OP.PrecioEj, OP.Plazo, OP.FechaOp, OP.FechaVto, OP.FechaEj, OP.FechaPago, OP.Precio1, OP.Vehiculo1, OP.Mercado ")
Sqladd(" FROM "~Dbo()~".OPERACIONES OP LEFT OUTER JOIN  "~Dbo()~".MOVEJECUTADOS ME ON OP.NrOperacion = ME.NrOperacion WHERE ")
Sqladd(" ME.Leyenda like '%Prima%' AND ME.NrSaldo=1 AND ")
Sqladd(" OP.TipoOp in ('OCC','OVC','OCP','OVP')")
if (NoVacio(dialogo.especie1))
Sqladd(" AND OP.Especie = '"~dialogo.especie1~"'")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" AND OP.Cliente1 = '"~dialogo.cliente1~"'")
endif
Sqladd(" AND (OP.CB5 = '0' or OP.CB5 is NULL)")
Sqladd(" AND ((OP.FechaEj >= '"~IdxDate(dialogo.fecha1)~"' AND OP.TipoOpcion='0') or (OP.FechaEj='"~IdxDate(dialogo.fecha1)~"'))")
Sqladd(" ORDER BY OP.Cliente1, OP.Especie, OP.TipoOp")
