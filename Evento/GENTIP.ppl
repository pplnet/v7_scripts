** FJL 26/11/19 - Nueva version para adaptar a STD (BBYMA)
ACT(h:1, 'Ejecuta GENPAT')
ACN(i:1, 1)
ACT(h:2, 'Procesa GENPAT')
ACN(i:2, 1)
if Val(i:1)=0
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'NrOper')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'CB5')
ACT(d:FAC, 'FechaOp')
ACT(e:FAC, 'NrOper3')
ACT(f:FAC, 'NrOper4')

SQL.ADD("Select O.NrOperacion, TipoOp, CB5, FechaOp, NrOperacion3, NrOperacion4 ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where O.NrOperacion=B.NrOperacion ")
SQL.ADD("   and B.NrBit = 72  ")
SQL.ADD("   and  Valor = '1' ")
SQL.ADD("   and O.TipoOp in ('TIPA','TIPP') ")
SQL.ADD("order by O.NrOperacion ")
Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACN(c:FAC, fbn('CB5'))
  ACD(d:FAC, fbn('FechaOp'))
  ACT(e:FAC, fbn('NrOperacion3'))
  ACT(f:FAC, fbn('NrOperacion4'))
  if val(i:1)=1
    EjecutarEvento('GENPAT',NrOperacion1=fbn('NrOperacion'),Check1=Val(i:2))
  endif
Proximo


** FJL 26/11/19 - version anterior
IF NO
SQL.ADD("Select NrOperacion,FechaCargaSys,MB1,Especie,Precio1,Especie,FechaVto,TotalBrutoCli1,TotalDerechos,Precio1,CB5,FechaOp,Cliente1,Cantidad,Corredor,FechaPago,")
SQL.ADD("PorComision,ContraEspecie,Cartera,Mercado,FormaLiquidacion1,TotalBrutoCli1,Mercado,Operador,TablaFeriados1,Observaciones,TasaInteresesCupon,FechaUltCupon,")
SQL.ADD("Vehiculo1,OpSIOPEL,CB5,CB7,Cupon1,TipoCambio,EsAforado,PorAforo,TotalCaucion,TipoOp,Cuenta1,Cuenta4,ContraEspecie,FechaAltaMAE,NroAltaMAE,CanPosTrad,CanPosInv1,CanPosInv2,CanPosOSoc,")
SQL.ADD("TotalBrutoCli2,TotalAux1,Precio2,FechaVto,FormaLiquidacion2,Mercado,FechaVto2,MB2,FechaUltCupon,Precio4,PorImpuesto,TotalGanancias,PorArancel,TotalRetenciones,Cartera,TipoCambio2,")
SQL.ADD("EsAforado,PorAforo,TotalGastos,Sucursal,PorArancel2, Cuenta2, Cuenta3, Mercado2, Mercado4, Book1, TotalAux9, TotalAux10 ")
SQL.ADD("from "~DBO~".OPERACIONES O where TipoOp in ('TIPA','TIPP') ")
SQL.ADD("and Exists (Select * from "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where O.NrOperacion=B.NrOperacion and NrBit = 72  and  Valor = '1' ) ")
SQL.ADD("and Vehiculo1 = '"~VAR('VEHICULODE')~"' and (CB5 <>1 or CB5 is NULL)")
SQL.ADD("order by NrOperacion ")
Recorrer SQL
  ACT(z1, FECHA(FBN['FechaCargaSys']) )
  ACT(z2, HORA(SQLAHORA))
  * plazo
  If fbn('MB1')=0
     ACN(p1,0)
  Else
    If fbn('MB1')=1
       ACN(p1,72)
    Else 
      If fbn('MB1')=2
         ACN(p1,24)
      Else
         ACN(p1,48)
      Endif
    Endif
  Endif

  if DesciendeDeEspecie(fbn('Especie'), VAR('IEP'))
     ACN(x1, 1-fbn('Precio1')*36000/(FechaMaduracion(fbn('Especie'))-fbn('FechaVto')))
  else
     ACN(x1, 0)
  endif

  *- Codigo de Especie en Mae
  act(cm1,BuscarCampo('ESPECIES','CodMAEContado','Codigo',fbn('Especie')) )
  act(vt1,BuscarCampo('ESPECIES','InteresesC','Codigo',fbn('Especie')) )

  *- Total Neto Cliente
  ACN(mn1, FBN['TotalBrutoCli1']+IIF(EqStr(val(vt1),'CLE'),FBN['TotalDerechos']))

  If Incluido(BuscarCampo('ESPECIES','Alias4','Codigo',fbn('Especie')),'1585')
     ACN(mn1, FBN['TotalBrutoCli1']+IIF(EqStr(val(vt1),'CLE'),(FBN['TotalDerechos']*fbn('Precio1'))) ) 
  EndIf

  *- Busco la cotizacion de la operacion respecto del COTIZAEN
  ACN(z11,IIF(Eqstr(CotizaEn(FBN['Especie']),FBN['ContraEspecie']),1,CotizacionC(FBN['ContraEspecie'],,,,fbn('FechaOp'),1,SI,CotizaEn(FBN['Especie']))))

  * --- Busco el controlante si es que lo tiene. 30/05/2005
  ACT(cl:1, SQL("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~fbn('Cliente1')~"' "))
  ACT(cl:2, IIF(VACIO(Val(cl:1)),fbn('Cliente1'),Val(cl:1)) )

  * --- equiv usd futuro
  ACN(tn:33, IIF(Incluido(fbn('ContraEspecie'),'USD|USB'), fbn('TotalBrutoCli2')+IIF(Eqstr(Val(vt:1),'CLE'),fbn('TotalAux1'),0),(fbn('TotalBrutoCli2')+IIF(Eqstr(Val(vt:1),'CLE'),fbn('TotalAux1'),0))*COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,'USD')) )

  * --- equiv usd spot
  ACN(tn:3, IIF(Incluido(fbn('ContraEspecie'),'USD|USB'),fbn('TotalBrutoCli1')+IIF(Eqstr(Val(vt:1),'CLE'),fbn('TotalDerechos'),0),(fbn('TotalBrutoCli1')+IIF(Eqstr(Val(vt:1),'CLE'),fbn('TotalDerechos'),0))*COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,'USD')))

  * generar operacion Spot (TIC/TIV)
  SQL.ADD("Insert Into "~DBO~".OPERACIONES ")
  SQL.ADD("(FechaOp, Especie, Cliente1,    ")
  SQL.ADD("Cantidad, Precio1, Corredor,    ")
  SQL.ADD("Plazo, FechaVto, PorComision,   ")
  SQL.ADD("ContraEspecie, Cartera,         ")
  SQL.ADD("FormaLiquidacion1, FormaLiquidacion2,     ")
  SQL.ADD("TipoCambio, TotalIntereses, TotalNetoCli1,")
  SQL.ADD("TotalBrutoCli1, Mercado, Operador,        ")
  SQL.ADD("TablaFeriados1, Observaciones, TotalComisiones,")
  SQL.ADD("PaseCB, OperacionRef, TasaInteresesCupon,")
  SQL.ADD("FechaUltCupon, Vehiculo1, OpSIOPEL, CB5, CB6, CB7,Cupon1,   ")
  SQL.ADD("NrOperacion, TipoCambio2, EsAforado, PorAforo, TotalCaucion,")
  SQL.ADD("TipoOp,EnteCus1, Cuenta1, Cuenta4, ")
  SQL.ADD("TotalNetoCli3, TotalAux3, Plazo2,   ")
  If EqStr(fbn('CB5'),'1')
     SQL.ADD(", FechaAltaMAE, NroAltaMAE, AceptaMAE, FechaEnvioMAE, ")
  Endif
  SQL.ADD("FechaCarga, FechaCargaSys,CanPosTrad,CanPosInv1,CanPosInv2,CanPosOSoc,Sucursal,TotalAux1,PorArancel2, Cuenta2, Cuenta3, Mercado2, Mercado4, Book1 ")
  SQL.ADD(" ) VALUES ( ")
  * FechaOp
  SQL.ADD(" '"~IdxDate(fbn('FechaOp'))~"', '"~fbn('Especie')~"', '"~fbn('Cliente1')~"', ")
  * Cantidad
  SQL.ADD(" "~FStr(fbn('Cantidad'),1,2)~","~FStr(fbn('Precio1'),1,8)~", '"~fbn('Corredor')~"', ")
  * Plazo
  SQL.ADD(" "~Val(p1)~", '"~IdxDate(fbn('FechaPago'))~"', "~FStr(fbn('PorComision')/2,1,2)~", ")
  * ContraEspecie
  SQL.ADD(" '"~fbn('ContraEspecie')~"', '"~fbn('Cartera')~"',")
  * FormaLiquidacion1
  If Incluido(fbn('Mercado'), 'CRYL|CE|EU|AC')
     SQL.ADD(" '0', '"~fbn('FormaLiquidacion1')~"', ")
  Else
     SQL.ADD(" '"~fbn('FormaLiquidacion1')~"', '0', ")
  Endif
  * TipoCambio
*FO 03/02/2006  SQL.ADD(" "~val(x1)~", "~FStr(fbn('TotalDerechos'),1,2)~", "~FStr(val(mn1),1,2)~", ")
  SQL.ADD(" "~val(x1)~", "~FStr(fbn('TotalDerechos'),1,2)~", "~FStr(fbn('TotalAux9'),1,2)~", ")
  * TotalBrutoCli1
  SQL.ADD(" "~FStr(fbn('TotalBrutoCli1'),1,2)~", '"~fbn('Mercado')~"', '"~fbn('Operador')~"', ")
  * TablaFeriados1
  SQL.ADD(" '"~fbn('TablaFeriados1')~"', '"~fbn('Observaciones')~"', "~FStr(fbn('TotalBrutoCli1')*fbn('PorComision')/2000,1,2)~", ")  
  * PaseCB
  SQL.ADD(" '1', '"~fbn('NrOperacion')~"', "~FStr(fbn('TasaInteresesCupon'),1,8)~", ")
  * FechaUltCupon
  SQL.ADD(" '"~IdxDate(fbn('FechaUltCupon'))~"', '"~fbn('Vehiculo1')~"', '"~fbn('OpSIOPEL')~"', '"~fbn('CB5')~"', '0', '"~fbn('CB7')~"','"~fbn('Cupon1')~"', ")
  * NrOperacion
  ACT(y1, GetNumerador(1))
  SQL.ADD(" '"~Val(y1)~"',  "~FStr(fbn('TipoCambio'),1,8)~", '"~fbn['EsAforado']~"', "~FStr(FBN['PorAforo'],1,2)~", "~FStr(fbn('TotalCaucion'),1,2)~",")
  If EqStr(fbn('TipoOp'), 'TIPA')
    SQL.ADD(" 'TIC',  ")
  Else
    SQL.ADD(" 'TIV',  ")
  Endif
  * EnteCus1
  SQL.ADD(" '"~val(cm1)~"', '"~fbn('Cuenta1')~"', '"~fbn('Cuenta4')~"',")
  * TotalNetoCli3
*fo29/09  ACN(mn:3, Val(mn1)*CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,VAR('MONEEXTR')) )
*fo29/09  SQL.ADD(" "~Fstr(Val(mn1)*CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,VAR('MONEEXTR')),0,2))
  SQL.ADD(" "~Fstr(Val(tn:3),0,2))
  * TotalAux3
  ACN(tx:3, IIF(Not[(LimAsignado(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('Vehiculo1'))-(LimConsumido(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('FechaOp'),fbn('Vehiculo1'))+Val(mn:3)))<0],0,(LimAsignado(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('Vehiculo1'))-(LimConsumido(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('FechaOp'),fbn('Vehiculo1'))+Val(mn:3)))))
  SQL.ADD(", "~FSTR(Val(tx:3),0,2)~", ")
  * PLAZO2
  SQL.ADD(" "~FStr((Val(p1) DIV 24),0,0)~", ")
  If EqStr(fbn('CB5'),'1')
     SQL.ADD(", '"~IdxDate(fbn('FechaAltaMAE'))~"', '"~fbn('NroAltaMAE')~"', 'SI', '"~IdxDate(fbn('FechaAltaMAE'))~"', ")
  Endif
  SQL.ADD("'"~IdxDate(Fsys)~" "~COPY(Val(z2),1,2)~":"~COPY(Val(z2),4,2)~":"~COPY(Val(z2),7,2)~"', ")
  SQL.ADD("'"~IdxDate(Fsys)~"', ")
  SQL.ADD(" "~Fstr(FBN['CanPosTrad'],1,2)~", "~Fstr(FBN['CanPosInv1'],1,2)~", "~Fstr(FBN['CanPosInv2'],1,2)~","~Fstr(FBN['CanPosOSoc'],1,2)~", '"~fbn('Sucursal')~"',"~Fstr(val(z11),0,7)~","~FStr(FBN['PorArancel2'],1,7)~", '"~fbn('Cuenta2')~"', '"~fbn('Cuenta3')~"', '"~fbn('Mercado2')~"', '"~fbn('Mercado4')~"', '"~fbn('Book1')~"' ) ")
  SQL.NEW
  SQL.EXEC

  *** Graba los movimientos de la operacion contado ***
  SQL.ActualizarMovimientos4(Val(y1),SI,SI,SI,SI,SI,SI)
  SQL.EXEC

*FO 26/09/2005 - Le paso las excepciones del pase
     SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
     SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ) ")
     SQL.ADD(" SELECT '"~Val(y1)~"', Tipo, Fecha, Descripcion ")
     SQL.ADD(" FROM "~DBO~".EXCEPCIONES ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND (Descripcion LIKE '%Spot%' OR Descripcion Not Like '%Futuro%') ")
     SQL.ADD(" AND Descripcion not LIKE '%Presettlement%' ")
     SQL.NEW


*FO 26/09/2005 - Le cambio el nro de op a los mov limites para poder liberarlos en la confirmacion
     SQL.ADD(" UPDATE "~DBO~".MOVLIMITES SET NrOperacion =  '"~Val(y1)~"' ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND   FechaLim = "~Idxdate2(fbn('FechaOp'))~" ")
     SQL.ADD(" AND   Limite   = 'SETTLEMENT' ")
     SQL.NEW

     * FO 29/09 los borro porque se generan en las patas
     ACT(mc:1, 'MAX'~fbn('Mercado'))
     SQL.ADD(" DELETE "~DBO~".MOVLIMITES  ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND   FechaLim = "~Idxdate2(fbn('FechaPago'))~" ")
     SQL.ADD(" AND   Limite   = '"~Val(mc:1)~"' ")
     SQL.NEW

     SQL.EXEC

  ACT(z2, HORA(SQLAHORA))
  *- Generar operacion Futura (TIFC/TIFV)
  *- Total Neto Cliente
  ACN(mn1, fbn('TotalBrutoCli2')+IIF(EqStr(val(vt1),'CLE'),fbn('TotalAux1')))

  If Incluido(BuscarCampo('ESPECIES','Alias4','Codigo',fbn('Especie')),'1585')
     ACN(mn1, fbn('TotalBrutoCli2')+IIF(EqStr(val(vt1),'CLE'),(fbn('TotalAux1')*fbn('Precio2'))) ) 
  EndIf

  SQL.ADD(" Insert Into "~DBO~".OPERACIONES ")
  SQL.ADD(" ( FechaOp, Especie, Cliente1, ")
  SQL.ADD(" Cantidad, Precio1, Corredor, ")
  SQL.ADD(" Plazo, FechaVto, PorComision, ")
  SQL.ADD(" ContraEspecie, FormaLiquidacion1,FormaLiquidacion2,TotalIntereses, ")
  SQL.ADD(" TotalNetoCli1, TotalBrutoCli1, Mercado, ")
  SQL.ADD(" Operador, TablaFeriados1, Observaciones, ")
  SQL.ADD(" TotalComisiones, PaseCB, OperacionRef, ")
  SQL.ADD(" FechaPago, FechaUltCupon, ")
  SQL.ADD(" TasaInteresesCupon, PorImpuesto, TotalGanancias, ")
  SQL.ADD(" PorArancel, TotalRetenciones, Cartera,")
  SQL.ADD(" Vehiculo1, OpSIOPEL, CB5, CB6, CB7,Cupon1, ")
  SQL.ADD(" NrOperacion, TipoCambio2, EsAforado, PorAforo, TotalCaucion, ")
  SQL.ADD(" TipoOp, EnteCus1, Cuenta1, Cuenta4, ")
  SQL.ADD(" TotalNetoCli3, TotalAux3, Plazo2, ")
  if EqStr(fbn('CB5'),'1')
    SQL.ADD(", FechaAltaMAE, NroAltaMAE, AceptaMAE, FechaEnvioMAE, ")
  endif
  SQL.ADD("FechaCarga, FechaCargaSys,CanPosTrad,CanPosInv1,CanPosInv2,CanPosOSoc,Sucursal,TotalAux1,PorArancel2, Cuenta2, Cuenta3, Mercado2, Mercado4, Book1 ")
  SQL.ADD(") VALUES ( ")
  * FechaOp
  SQL.ADD(" '"~IdxDate(fbn('FechaOp'))~"', '"~fbn('Especie')~"', '"~fbn('Cliente1')~"', ")
  * Cantidad
  SQL.ADD(" "~FStr(fbn('Cantidad'),1,2)~", "~FStr(fbn('Precio2'),1,8)~", '"~fbn('Corredor')~"', ")
  * Plazo
  SQL.ADD(" "~FStr(Difdias(fbn('FechaOp'),fbn('FechaVto'),'ARG',NO),1,0)~", '"~IdxDate(fbn('FechaVto'))~"', "~FStr(fbn('PorComision')/2,1,7)~", ")
  * ContraEspecie
  SQL.ADD(" '"~fbn('ContraEspecie')~"', ")
  * FormaLiquidacion
  if Incluido(fbn('Mercado'), 'CRYL|CE|EU|AC')
     SQL.ADD(" '0' , '"~fbn('FormaLiquidacion2')~"', ")
  else
     SQL.ADD(" '"~fbn('FormaLiquidacion2')~"', '0', ")
  endif
  * TotalIntereses
  SQL.ADD(" "~FStr(fbn('TotalAux1'),1,2)~", ")
  * TotalNetoCli1
*FO 03/02/2006  SQL.ADD(" "~FStr(val(mn1),1,2)~", "~FStr(fbn('TotalBrutoCli2'),1,2)~", '"~fbn('Mercado')~"', ")
  SQL.ADD(" "~FStr(fbn('TotalAux10'),1,2)~", "~FStr(fbn('TotalBrutoCli2'),1,2)~", '"~fbn('Mercado')~"', ")
  * Operador
  SQL.ADD(" '"~fbn('Operador')~"', '"~fbn('TablaFeriados1')~"', '"~fbn('Observaciones')~"', ")
  * TotalComisiones
  SQL.ADD(" "~FStr(fbn('TotalBrutoCli2')*fbn('PorComision')/2000,1,2)~", '1', '"~fbn('NrOperacion')~"', ")
  * FechaPago
  SQL.ADD(" '"~IdxDate(fbn('FechaVto2'))~"', '"~IdxDate(fbn('FechaUltCupon'))~"', ")
  * TasaInteresCupon
  SQL.ADD(" "~Fstr(fbn('Precio4'),1,6)~", "~FStr(fbn('PorImpuesto'),1,2)~", "~FStr(fbn('TotalGanancias'),1,2)~", ")
  * Por Arancel
  SQL.ADD(" "~FStr(fbn('PorArancel'),1,2)~", "~FStr(fbn('TotalRetenciones'),1,2)~", '"~fbn('Cartera')~"',")
  * Vehiculo1
  SQL.ADD(" '"~fbn('Vehiculo1')~"', '"~fbn('OpSIOPEL')~"', '"~fbn('CB5')~"', '0', '"~fbn('CB7')~"','"~fbn('Cupon1')~"', ")
  * NrOperacion
  ACT(y2,GetNumerador(1))
  SQL.ADD(" '"~Val(y2)~"', "~FStr(fbn('TipoCambio2'),1,8)~", '"~fbn('EsAforado')~"', "~FStr(fbn('PorAforo'),1,2)~", "~FStr(fbn('TotalGastos'),1,2)~",")
  If EqStr(fbn('TipoOp'), 'TIPA')
    SQL.ADD(" 'TIFV',  ")
   Else
    SQL.ADD(" 'TIFC',  ")
  EndIf
  *- EnteCus1
  SQL.ADD(" '"~val(cm1)~"', '"~fbn('Cuenta1')~"', '"~fbn('Cuenta4')~"', ")
  * TotalNetoCli3
*fo09/05  ACN(mn:3, Val(mn1)*CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,VAR('MONEEXTR')) )
*fo29/05  SQL.ADD(" "~Fstr(Val(mn1)*CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,VAR('MONEEXTR')),0,2))
  SQL.ADD(" "~Fstr(Val(tn:33),0,2))
  * TotalAux3
  ACN(tx:5, IIF(Not[(LimAsignado(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('Vehiculo1'))-(LimConsumido(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('FechaOp'),fbn('Vehiculo1'))+Val(mn:3)))<0],0,(LimAsignado(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('Vehiculo1'))-(LimConsumido(Val(cl:2),'VOLUMENCON',VAR('MONEEXTR'),fbn('FechaOp'),fbn('Vehiculo1'))+Val(mn:3)))))
  SQL.ADD(", "~FSTR(Val(tx:5),0,2)~", ")
  * Plazo2 
  SQL.ADD(" "~FStr(Difdias(fbn('FechaOp'),fbn('FechaVto'),'ARG',NO)*24,0,0)~", ")
  If EqStr(fbn('CB5'),'1')
     SQL.ADD(", '"~IdxDate(fbn('FechaAltaMAE'))~"', '"~fbn('NroBajaMAE')~"', 'SI', '"~IdxDate(fbn('FechaAltaMAE'))~"', ")
  Endif
  SQL.ADD("'"~IdxDate(Fsys)~" "~COPY(Val(z2),1,2)~":"~COPY(Val(z2),4,2)~":"~COPY(Val(z2),7,2)~"', ")
  SQL.ADD("'"~IdxDate(Fsys)~"', ")
  SQL.ADD(" "~Fstr(FBN['CanPosTrad'],1,2)~", "~Fstr(FBN['CanPosInv1'],1,2)~", "~Fstr(FBN['CanPosInv2'],1,2)~","~Fstr(FBN['CanPosOSoc'],1,2)~", '"~fbn('Sucursal')~"',"~Fstr(val(z11),0,7)~","~FStr(FBN['PorArancel2'],1,7)~", '"~fbn('Cuenta2')~"', '"~fbn('Cuenta3')~"', '"~fbn('Mercado2')~"', '"~fbn('Mercado4')~"', '"~fbn('Book1')~"') ")
  SQL.NEW
  
  If EqStr(fbn('CB5'),'1')
     SQL.ADD("update "~DBO~".OPERACIONES set NroAltaMAE = 'OK  OK  ', NroBajaMAE = '' ")
     SQL.ADD("where NrOperacion='"~fbn('NrOperacion')~"'")
     SQL.NEW
  Else
     SQL.ADD("update "~DBO~".OPERACIONES set NroAltaMAE = 'INI INI ' ")
     SQL.ADD("where NrOperacion='"~fbn('NrOperacion')~"' ")
     SQL.NEW
  Endif
  SQL.EXEC

  * Graba los movimientos de la operacion futuro vilma
  SQL.ActualizarMovimientos4(val(y2),SI,SI,SI,SI,SI,SI)
  SQL.EXEC

*FO 26/09/2005 - Le paso las excepciones del pase
     SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
     SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ) ")
     SQL.ADD(" SELECT '"~Val(y2)~"', Tipo, Fecha, Descripcion ")
     SQL.ADD(" FROM "~DBO~".EXCEPCIONES ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND (Descripcion LIKE '%Futuro%' OR Descripcion Not Like '%Spot%' OR Descripcion like '%Presettlement%' ) ")
     SQL.NEW

*FO 26/09/2005 - Le cambio el nro de op a los mov limites para poder liberarlos en la confirmacion
     SQL.ADD(" UPDATE "~DBO~".MOVLIMITES SET NrOperacion =  '"~Val(y2)~"' ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND   FechaLim > "~Idxdate2(fbn('FechaOp'))~" ")
     SQL.ADD(" AND   Limite   = 'SETTLEMENT' ")
     SQL.NEW
     * FO 29/09 los borro porque se generan en las patas
     ACT(mc:1, 'MAX'~fbn('Mercado'))
     SQL.ADD(" DELETE "~DBO~".MOVLIMITES  ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND   FechaLim = "~Idxdate2(fbn('FechaVto2'))~" ")
     SQL.ADD(" AND   Limite   = '"~Val(mc:1)~"' ")
     SQL.NEW

     SQL.ADD(" UPDATE "~DBO~".MOVLIMITES SET NrOperacion =  '"~Val(y2)~"' ")
     SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD(" AND   Limite   = 'PRESETTLEM' ")
     SQL.NEW
     SQL.EXEC

  *- Pasa de Instancia az5: Instancia Nueva az6: Instancia Vieja
  ACT(az3,fbn('NrOperacion')  )
  ACT(az4,'OPERACIONES')
  ACN(az5,73)
  ACN(az6,72 )
  (.'MODIINSTAN'.)

  * Generacion de Instancias en OperacionesBits para operacion CONTADO
  act(az3,Val(y1) )
  act(az4,'OPERACIONES')
  if EqStr(fbn('CB5'),'1')
     act(az5,'71')
     * asignar nro. de boleto automaticamente
     EjecutarEvento('ASIBOL',NrOperacion1=Val(Y1))
  else
     act(az5,'50')
  endif
  (.'ALTAINSTAN'.)

  * Generacion de Instancias en OperacionesBits para operacion FUTURO
  act(az3,Val(y2) )
  act(az4,'OPERACIONES')
  If EqStr(fbn('CB5'),'1')
     act(az5,'71')
     EjecutarEvento('ASIBOL',NrOperacion1=Val(y2))
  Else
     act(az5,'50')
  Endif
  (.'ALTAINSTAN'.)
Proximo
ENDIF
