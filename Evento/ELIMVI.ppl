CrearDialogo
  NrOperacion1 : 'Nr.Operacion' ;
FinDialogo

If Not Ok
  Cancelar
Endif

*** Verifico que la operacion sea pasiva, de lo contrario no la elimina.

IF Not EqStr(BuscarCampo('OPERACIONES','CB1','NrOperacion', Dialogo.NrOperacion1), '1')
   **Cancelar('La Operacion no es Pasiva !!! Cancela') 
ENDIF

* Borro las operaciones en OPERACIONESBITS    
  SQL.ADD("DELETE "~DBO~".OPERACIONESBITS ")
  SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC

*** Actualizo Saldo de Prestamo por baja de operacion Sintetica.
*EqStr(ABM,'D') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=1;Check1=1
IF EqStr(BuscarCampo('OPERACIONES','CB13','NrOperacion', Dialogo.NrOperacion1), '1')
  IF EqStr(BuscarCampo('OPERACIONES','CB14','NrOperacion', Dialogo.NrOperacion1), '1')
    EjecutarEvento('ACTSPE',NrOperacion1=BuscarCampo('OPERACIONES','NrOperacion5','NrOperacion', Dialogo.NrOperacion1),Entero1=BuscarCampo('OPERACIONES','Cuotas1','NrOperacion', Dialogo.NrOperacion1),Cantidad1=BuscarCampo('OPERACIONES','Cantidad','NrOperacion', Dialogo.NrOperacion1),Radio1=1,Check1=1)
  endif
endif

* Borro las operaciones en el Maestro de OPERACIONES
  SQL.ADD("DELETE "~DBO~".OPERACIONES ")
  SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC

