**-- TEMIML: Minuta Mesual de Capitalizacion de Intereses en LOTES
* HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;NOVACIO(Dialogo.Fecha1);'Debe Ingresar la Fecha';NO;Fsys
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")  
FinDialogo

if Not Ok
   Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))


* Obtengo el Ultimo Dia Habil Del Mes Anterior 
ACD(Z10,FinDeMes(Fsys-35,NO,'ARG'))

* Obtengo Todos los Pares de Vehiculos
SQL.ADD("SELECT O.Vehiculo1,O.Cliente1,O.Especie,SUM(O.TotalIntereses) As Interes ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where O.TipoOp='TEMIND' and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"'and ")
SQL.ADD(" (NrOperacion2 IS NULL Or NrOperacion2='') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT * ")
SQL.ADD("from "~DBO~".OPERACIONES B")
SQL.ADD("where B.TipoOp='TEMINM' and B.FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("B.Vehiculo1=O.Vehiculo1 and B.Cliente1=O.Cliente1 and B.Especie=O.Especie) ")
SQL.ADD("Group By O.Vehiculo1,O.Cliente1,O.Especie ")
SQL.ADD("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

ACN(AB1,0)

Recorrer SQL
   Message('Procesando Vehiculo: '~FBN['Vehiculo1']~' ContraParte '~FBN['Cliente1']~' Especie:'~FBN['Especie']~' ...')

   * Envia Precio1=Tasa que es 0 
   EjecutarEvento('TEMINM',Fecha1=Dialogo.Fecha1,Vehiculo1=FBN['Vehiculo1'],Cliente1=FBN['Cliente1'],Especie1=FBN['Especie'],Precio1=VAL(A1))

   SCN(AB1,1)
Proximo  
  
IF VAL(AB1)=0
   * No se generaron intereses
   MessageBox('No Existen Operaciones Vinculadas para la fecha ...')
ENDIF
