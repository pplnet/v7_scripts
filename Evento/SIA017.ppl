ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

*- Recupero las Variables de Equipo, Usuario,  Pasword y Directorio de TELECOM y PERSONAL
*- Telecom, Paginas, Internet, Soluciones y Microsistemas => Van al equipo de TELECOM
*- Personal => va al Equipo de Personal
CrearDialogo
  Radio1       : 'Sist.Oper.|W98|NT'     ;1;1;;;;;;;1;
FinDialogo

If Not Ok
   Cancelar
EndIf

If Dialogo.Radio1=0
   ACT(so1,"COMMAND.COM /C ")
Else
   ACT(so1,"CMD.EXE /C ")
EndIf

Message('Eliminando archivos Texto')

*------ TELECOM
WinExec(val(so1)~" del "~VAR('DIRICOTIZ')~'\SIAGGL.TXT',0)
Esperar(5)

Message('Borro siaggl.txt')
WinExec(val(so1)~" del "~VAR('DIRICOTIZ')~'\MVINCONT.bat',0)
Esperar(5)

Message('Borro mvincont.txt')
Message('Construyendo linea FTP ')
AbrirASCII(VAR('DIRICOTIZ')~'\SIAGGL.TXT',0)

ACT(t1,VAR('TECOUSR'))
EscribirASCII(VAL(t1))

ACT(t1,VAR('TECOPASW'))
EscribirASCII(VAL(t1))

ACT(t1,"lcd "~Var('SIAFCOTIZ1')~" ")
EscribirASCII(VAL(t1))

ACT(t1,"cd "~VAR('SIAFCOTIZ2')~" ")
EscribirASCII(VAL(t1))

*- Recupero la fecha juliana para sacar el nombre del archivo
ACD(fe:1, FSYS )
(.'FECHAJULIA'.)


ACN(ct1,0)

   ACT(V2, VAR('DIRICOTIZ')~"\SIA"~Copy(VAL(fe:2),2, 5)~'*')
*   ACT(V3, PrimerArchivo(Val(V2)))
   ACT(V3, Val(V2))

   *- Texto para mover los archivos
   AbrirASCII(VAR('DIRICOTIZ')~'\MVINCONT.bat',0)
   EscribirASCII('Move '~VAL(v2)~' '~VAR('SIAFCOTIZ3'))
   CerrarASCII

   If Ok
      If Novacio(val(v2))
        ACT(t1,"put "~val(v2)~" ")
        AbrirASCII(VAR('DIRICOTIZ')~'\SIAGGL.TXT',0)
        EscribirASCII(VAL(t1))
        CerrarASCII
      EndIf
      ACN(ct1,1)
   EndIf


   AbrirASCII(VAR('DIRICOTIZ')~'\SIAGGL.TXT',0)

ACT(t1,"close ")
EscribirASCII(VAL(t1))

ACT(t1,"quit ")
EscribirASCII(VAL(t1))
CerrarASCII

If val(ct1)=1
   messagebox("Envio Cotizaciones")
*   WinExec("ftp -v -i -s:"~VAR('DIRICOTIZ')~"\SIAGGL.TXT "~VAR('TECOAS400'))

EndIf

Esperar(5)

   If Ok
      WinExec('c:\as400\CAP\COTIZ\HSIAGgl1.bat')
      WinExec(VAR('DIRICOTIZ')~'\HSIAGgl2.bat')
   EndIf


