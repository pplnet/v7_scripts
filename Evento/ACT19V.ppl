DialogoVisible(NO)
CrearDialogo
  NrOperacion1 : 'Nr.Operacion' ;
  TipoOp1      : 'Tipo Op'      ;;;
  Check1       : 'CB1'          ;;;;;;;;;;;
  Vehiculo1    : 'Vehiculo1'    ;;;;;;;;;;;
  Vehiculo2    : 'Vehiculo2'    ;;;;;;;;;;;
  Cuenta1      :  'Cuenta1'     ;;;;;
  Cuenta2      :  'Cuenta2'     ;;;;;
  Cuenta3      :  'Cuenta4'     ;;;;;
  Cuenta4      :  'Cuenta5'     ;;;;;
FinDialogo
If Not Ok
  Cancelar
Endif
* [CB1=0 o Vacio(CB1)] y Not Incluido(Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Vehiculo2,VAR('VEHIEXTRAN')) y Incluido(TIPOOP,'SEPVMV|SECTV|SEVTV')
* [CB1=0 o Vacio(CB1)] y Not Incluido(Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Vehiculo2,VAR('VEHIEXTRAN')) y Incluido(TIPOOP,'MMPCCM|FXCSV|FXVSV|FXCTV|FXVTV')

If NoVacio(Dialogo.NrOperacion1) 
   if Dialogo.Check1=0 o Vacio(Dialogo.Check1)
      * MESSAGEBOX (' ***** cHEK1 Ok  ***'~Dialogo.Check1 )   
      IF Not Incluido(Dialogo.Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Dialogo.Vehiculo2,VAR('VEHIEXTRAN')) y Incluido(Dialogo.TipoOp1,'SEPVMV|SECTV|SEVTV|FXCSV|FXVSV|FXCTV|FXVTV|FCCPV|FCVPV')
      */Actualizo OPERACIONES ** 
          SQL.ADD(" UPDATE "~DBO~".OPERACIONES")  
          SQL.ADD("Set  Cuenta1='"~Dialogo.Cuenta3~"', Cuenta4='"~Dialogo.Cuenta1~"',    ") 
          SQL.ADD("     Cuenta2='"~Dialogo.Cuenta4~"', Cuenta5='"~Dialogo.Cuenta2~"'     ")                           
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
          SQL.NEW
          SQL.EXEC
          * Actualizo movimientos para la vinculada          
          SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,NO)    
          SQL.EXEC                     
      Endif

      IF Not Incluido(Dialogo.Vehiculo1,VAR('VEHIEXTRAN')) y Not Incluido(Dialogo.Vehiculo2,VAR('VEHIEXTRAN')) y Incluido(Dialogo.TipoOp1,'MMPCCM')
      */Actualizo OPERACIONES ** 
          SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
          SQL.ADD(" Cuenta1='"~Dialogo.Cuenta2~"' , Cuenta2='"~Dialogo.Cuenta1~"'    ")                         
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
          SQL.NEW  
          SQL.EXEC                  
          * Actualizo movimientos para la vinculada         
          SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,NO)    
          SQL.EXEC
          */MESSAGEbOX (' ***** ActualizarMovimientos x Vinculada de MM ***' ~Dialogo.NrOperacion1 )                 
      Endif
     
   ELSE
   *    MESSAGEbOX ('***** NO ES OPERACION INVERSA !!! '~Dialogo.Check1 )   
   ENDIF
Else
 * MESSAGEbOX('Nro de Operacion Vacio NO SE PROCESA   !!!') 
ENDIF






    