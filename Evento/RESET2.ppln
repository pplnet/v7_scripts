creardialogo
fecha1: 'Fecha';;;;;;dialogo.fecha1 <= FSys();'Fecha No debe ser superior a la Fecha del Sistema';NO;FSys()
check1: 'Procesa';;;;NO;;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Act(y1, 'Fin de Mes')
Act(y2, 'OK')
Act(y4, 'Mes Inicio')
Act(y5, 'Mes Cierre')

Acd(z:1, FinDeMes(dialogo.fecha1, NO, 'ARG'))

Act(z:2, 'SI')
if (Val(z:1) <> dialogo.fecha1)
Messagebox('La fecha indicada no es fin de mes')
Act(z:2, 'NO')
endif

if (Eqstr(Val(z:2), 'SI'))
Acn(z:4, 0)
Acn(z:4, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo='MESINIEJE' "))
if (Val(z:4) = 0)
Acn(z:5, 12)
else
Acn(z:5, Var('MESINIEJE') - 1)
endif
if (Val(z:5) < 1 o Val(z:5) > 12)
Acn(z:5, 12)
endif
if (Mes(dialogo.fecha1) <> Val(z:5))
Messagebox('La fecha indicada no es fin de Ejercicio')
Act(z:2, 'NO')
endif
endif

if (Eqstr(Val(z:2), 'NO'))
Cancelar('No es posible Resetear Posicion en esta Fecha: '~dialogo.fecha1)
endif

SetFilaActual(1)
Act(a:fac, 'TipoOp')
Act(b:fac, 'NrOperacion')
Act(c:fac, 'Vehiculo')
Act(d:fac, 'Book1')
Act(e:fac, 'Cliente1')
Act(f:fac, 'FechaOp')
Act(g:fac, 'Plazo')
Act(h:fac, 'FechaVto')
Act(i:fac, 'Especie')
Act(j:fac, 'Cantidad')
Act(k:fac, 'ContraEspecie')
Act(l:fac, 'TotalBrutoCli1')
Act(m:fac, 'Precio1')
Act(n:fac, 'PrecioRef')
Act(o:fac, 'PrecioRef4')
Act(p:fac, 'Cot.Spot')
Act(q:fac, 'FD PrRef')
Act(r:fac, 'FD PrRef4')
Act(s:fac, 'Pre.Hoy')
Act(t:fac, 'Max F.PrRef')
Act(u:fac, 'Max F.PrRef4')
SetFont(a:fac..x:fac, 2)

Sqladd("Select O.FechaVto, O.TipoOp,         O.NrOperacion, O.Vehiculo1,  ")
Sqladd("       O.Cliente1, O.Cantidad,       O.Plazo,       O.Especie,    ")
Sqladd("       O.FechaOp,  O.ContraEspecie,  O.PrecioRef,   O.PrecioRef4, ")
Sqladd("       O.Precio1,  O.TotalBrutoCli1, O.Book1 ")
Sqladd("  from "~Dbo()~".OPERACIONES O ")
Sqladd("where O.TipoOp In ('FXCT','FXVT') ")
Sqladd("   and O.FechaVto >  '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" order by FechaVto,Cliente1,Precio1 ")
recorrer sql
Act(a:fac, Fbn('TipoOp'))
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('Vehiculo1'))
Act(d:fac, Fbn('Book1'))
Act(e:fac, Fbn('Cliente1'))
Acd(f:fac, Fbn('FechaOp'))
Acn(g:fac, Fbn('Plazo'))
Acd(h:fac, Fbn('FechaVto'))
Act(i:fac, Fbn('Especie'))
Acn(j:fac, Fbn('Cantidad'))
Act(k:fac, Fbn('ContraEspecie'))
Acn(l:fac, Fbn('TotalBrutoCli1'))
Acn(m:fac, Fbn('Precio1'))
Act(n:fac, Fbn('PrecioRef'))
Act(o:fac, Fbn('PrecioRef4'))
Acn(p:fac, CotizacionC(Fbn()['Especie'], null, null, null, dialogo.fecha1, 1, SI, Fbn()['ContraEspecie']))


Acd(t:fac, dialogo.fecha1)
Sqladd("Select Max(TD1.Fecha) AS Max ")
Sqladd("  from "~Dbo()~".TASASDIA TD1, "~Dbo()~".TIPOSTASA TT1 ")
Sqladd(" Where TD1.TipoTasa  =  TT1.Codigo ")
Sqladd("   and TT1.PrecioRef =  '"~Trim(Mirt(Fbn()['PrecioRef']))~"' ")
Sqladd("   AND TD1.Fecha     <= '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Dfa()
Acd(t:fac, Fbn()['Max'])
proximo

Acd(u:fac, dialogo.fecha1)
Sqladd("Select Max(TD1.Fecha) AS Max ")
Sqladd("  from "~Dbo()~".TASASDIA TD1, "~Dbo()~".TIPOSTASA TT1 ")
Sqladd(" Where TD1.TipoTasa  =  TT1.Codigo ")
Sqladd("   and TT1.PrecioRef =  '"~Trim(Mirt(Fbn()['PrecioRef4']))~"' ")
Sqladd("   AND TD1.Fecha     <= '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Dfa()
Acd(u:fac, Fbn()['Max'])
proximo

Acd(fe:1, dialogo.fecha1)
Acd(fe:2, Fbn()['FechaVto'])
Acn(fe:3, (Val(fe:2) - Val(fe:1)) / 365 * 360)

Acn(ff:1, 0)
Acn(fd:1, 0)
Acn(fd:2, 0)
Acn(fd:3, 0)
Acn(fd:4, 0)
Acn(fd:5, 0)

Sqladd("Select TD.*,TT.DayCount ")
Sqladd("  from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd(" Where TD.Especie  = '"~Fbn()['Especie']~"' ")
Sqladd("   and TD.TipoTasa   = TT.Codigo ")
Sqladd("   and TT.PrecioRef  = '"~Trim(Mirt(Fbn()['PrecioRef']))~"' ")
Sqladd("   AND TD.Fecha      = '"~IdxDate(Val(t:fac))~"' ")
Sqladd("   and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
Sqladd("                          from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd("                         Where TD.Especie             = '"~Fbn()['Especie']~"' ")
Sqladd("                           and TD.TipoTasa            = TT.Codigo ")
Sqladd("                           and TT.PrecioRef           = '"~Trim(Mirt(Fbn()['PrecioRef']))~"' ")
Sqladd("                           AND TD.Fecha               = '"~IdxDate(Val(t:fac))~"' ")
Sqladd("                           and "~FStr(Val(fe:3), 0, 0)~" <= PlazoHasta ")
Sqladd("                       ) ")
Sqladd(" Union All ")
Sqladd("Select TD.*,TT.DayCount ")
Sqladd("  from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd(" Where TD.Especie    = '"~Fbn()['Especie']~"' ")
Sqladd("   and TD.TipoTasa   = TT.Codigo ")
Sqladd("   and TT.PrecioRef  = '"~Trim(Mirt(Fbn()['PrecioRef']))~"' ")
Sqladd("   AND TD.Fecha      = '"~IdxDate(Val(t:fac))~"' ")
Sqladd("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
Sqladd("                          from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd("                         Where TD.Especie             = '"~Fbn()['Especie']~"' ")
Sqladd("                           and TD.TipoTasa            = TT.Codigo ")
Sqladd("                           and TT.PrecioRef           = '"~Trim(Mirt(Fbn()['PrecioRef']))~"' ")
Sqladd("                           AND TD.Fecha               = '"~IdxDate(Val(t:fac))~"' ")
Sqladd("                           and "~FStr(Val(fe:3), 0, 0)~" > PlazoHasta ")
Sqladd("                       ) ")
Sqladd("ORDER BY TD.PlazoHasta  ")
recorrer sql
Dfa()
if (Val(ff:1) <= Val(fe:3) y Val(fe:3) <= Fbn()['PlazoHasta'])
Acn(fd:3, Val(fd:1) / Fbn()['Valor4'] - 1)
Acn(fd:4, (Val(fd:3) / (Fbn()['Valor3'] - Val(fd:2))) * 100)
Acn(fd:5, (Fbn()['Valor3'] - (Val(fe:2) - Val(fe:1)) / iif (not Incluido(Fbn()['DayCount'], 'ACT|365|'), 360, 365)) / (Fbn()['Valor3'] - Val(fd:2)) * Val(fd:1) + ((Val(fe:2) - Val(fe:1)) / iif (not Incluido(Fbn()['DayCount'], 'ACT|365|'), 360, 365) - Val(fd:2)) / (Fbn()['Valor3'] - Val(fd:2)) * Fbn()['Valor4'])
endif
Acn(ff:1, Fbn()['PlazoHasta'])
Acn(fd:1, Fbn()['Valor4'])
Acn(fd:2, Fbn()['Valor3'])
proximo
Acn(q:fac, Val(fd:5))

Acn(ff:1, 0)
Acn(fd:1, 0)
Acn(fd:2, 0)
Acn(fd:3, 0)
Acn(fd:4, 0)
Acn(fd:5, 0)

Sqladd("Select TD.*,TT.DayCount ")
Sqladd("from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd("Where TD.Especie  = '"~Fbn()['ContraEspecie']~"' ")
Sqladd("and TD.TipoTasa   = TT.Codigo ")
Sqladd("and TT.PrecioRef  = '"~Trim(Mirt(Fbn()['PrecioRef4']))~"' ")
Sqladd("AND TD.Fecha      = '"~IdxDate(Val(u:fac))~"' ")
Sqladd("and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
Sqladd("                       from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd("                      Where TD.Especie             = '"~Fbn()['ContraEspecie']~"' ")
Sqladd("                        and TD.TipoTasa            = TT.Codigo ")
Sqladd("                        and TT.PrecioRef           = '"~Trim(Mirt(Fbn()['PrecioRef4']))~"' ")
Sqladd("                        AND TD.Fecha               = '"~IdxDate(Val(u:fac))~"' ")
Sqladd("                        and "~FStr(Val(fe:3), 0, 0)~" <= PlazoHasta ")
Sqladd("                    ) ")
Sqladd(" Union All")
Sqladd("Select TD.*,TT.DayCount ")
Sqladd("  from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd(" Where TD.Especie    = '"~Fbn()['ContraEspecie']~"' ")
Sqladd("   and TD.TipoTasa   = TT.Codigo ")
Sqladd("   and TT.PrecioRef  = '"~Trim(Mirt(Fbn()['PrecioRef4']))~"' ")
Sqladd("   AND TD.Fecha      = '"~IdxDate(Val(u:fac))~"' ")
Sqladd("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
Sqladd("                          from "~Dbo()~".TASASDIA TD, "~Dbo()~".TIPOSTASA TT ")
Sqladd("                         Where TD.Especie             = '"~Fbn()['ContraEspecie']~"' ")
Sqladd("                           and TD.TipoTasa            = TT.Codigo ")
Sqladd("                           and TT.PrecioRef           = '"~Trim(Mirt(Fbn()['PrecioRef4']))~"' ")
Sqladd("                           AND TD.Fecha               = '"~IdxDate(Val(u:fac))~"' ")
Sqladd("                           and "~FStr(Val(fe:3), 0, 0)~" > PlazoHasta ")
Sqladd("                       ) ")
Sqladd("ORDER BY TD.PlazoHasta  ")
recorrer sql
Dfa()
if (Val(ff:1) <= Val(fe:3) y Val(fe:3) <= Fbn()['PlazoHasta'])
Acn(fd:3, Val(fd:1) / Fbn()['Valor4'] - 1)
Acn(fd:4, (Val(fd:3) / (Fbn()['Valor3'] - Val(fd:2))) * 100)
Acn(fd:5, (Fbn()['Valor3'] - (Val(fe:2) - Val(fe:1)) / iif (not Incluido(Fbn()['DayCount'], 'ACT|365|'), 360, 365)) / (Fbn()['Valor3'] - Val(fd:2)) * Val(fd:1) + ((Val(fe:2) - Val(fe:1)) / iif (not Incluido(Fbn()['DayCount'], 'ACT|365|'), 360, 365) - Val(fd:2)) / (Fbn()['Valor3'] - Val(fd:2)) * Fbn()['Valor4'])
endif
Acn(ff:1, Fbn()['PlazoHasta'])
Acn(fd:1, Fbn()['Valor4'])
Acn(fd:2, Fbn()['Valor3'])
proximo
Acn(r:fac, Val(fd:5))

Acn(s:fac, Val(p:fac) * Val(q:fac) / Val(r:fac))

Act(v:fac, 'OK')
if (dialogo.check1 = 1)
Act(w:fac, 'Update')
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set TipoCambio3 = "~FStr(Val(s:fac), 1, 8)~", FechaUltCupon = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" where NrOperacion = '"~Val(b:fac)~"' ")
Sqlnew()
Sqlexec()
endif
proximo

if (Fac() > 1)
SetFont(a:2..x:fac, 1)
FormatoCeldas(j:2..l:fac, Exe('F2'))
FormatoCeldas(m:2..m:fac, Exe('F8'))
FormatoCeldas(p:2..s:fac, Exe('F8'))
endif
SetFont(y:1..z:5, 1)

ACO(10, 12)
ACO(12, 12)

