Sqladd("select TipoReg, Fecha, Especie, TipCupon, Sum(Valorresidual) Residual, Sum(ValorContable) Contable, Sum(ValorContValuado) ContValuado, FecIncorporacion, RubroContable, ")
Sqladd("CodAlfCajaValores, FTenencia, Codmaecontado, CodNumCajaValores, Fvto, Denomincajavalores, clasecajavalores, nombre, cotiza, CodSISCEN , Tipo, Accion, ISIN, InformaFecInc, Campo24 from ")

Sqladd("(select '1' TipoReg, DT.Fecha, DT.Especie, DT.TipCupon TipCupon, DT.Valorresidual Valorresidual, DT.CuentaContable CuentaContable, DT.ValorContable ValorContable, ")
Sqladd("DT.ValorContValuado ValorContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, isnull(FechaInicioTenencia,DT.FecIncorporacion) FTenencia, ")
Sqladd("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo, ")
Sqladd("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%' Then 'SI' else 'NO' end Accion, ISIN, DT.InformaFecInc, '' Campo24 ")
Sqladd(" From "~Dbo()~".DETITOFIN DT  ")
Sqladd("      inner join dbo.CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
Sqladd("      inner join "~Dbo()~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
Sqladd("  and CO.Titofin='SI' ")
Sqladd("  and (ValorContable <> 0 or ValorContValuado <> 0) ")
Sqladd("  and DT.Fecha = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("  ) as Aux ")
Sqladd("Group By TipoReg, fecha, especie, tipcupon, fecincorporacion, rubrocontable, CodAlfCajaValores, FTenencia, CodMAEContado, ")
Sqladd("         CodNumCajaValores, FVto, DenominCajaValores, ClaseCajaValores, Nombre, Cotiza,CodSISCEN, Tipo, Accion, ISIN, InformaFecInc, Campo24 ")
Sqladd("HAVING Sum(ValorContValuado)<>0 ")
Sqladd(" order by especie,Rubrocontable,TipoReg ")
