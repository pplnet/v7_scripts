Sqladd("SELECT * from ")
Sqladd("(SELECT Aux.*, RC.Cuenta AS CuentaCont, (Select RubroContable from CONTABILIDAD CO   where CO.Codigo  = RC.Cuenta) Rubro ")
Sqladd("   FROM ( ")
Sqladd("   SELECT fechamov, especie, SUM(cantidad) Cantidad, E.MonedaEmision MonedaEmision, E.Tipo TipoEspecie,Tipoposicion Concepto, vehiculo Vehiculo1, Estrategia CuentaCustodia, Book ")
Sqladd("   FROM MOVPOSEJE M INNER JOIN ESPECIES E ON E.Codigo=M.Especie ")
Sqladd("WHERE Nrsaldo = 121 and Cantidad > 0 and especie='"~Val(es:1)~"' and M.FechaMov  <= "~IdxDate2(Val(fe:2))~" ")
Sqladd("GROUP BY FechaMov,especie,MonedaEmision,E.Tipo,TipoPosicion,Vehiculo,Estrategia,BOOK ")
Sqladd(" ) AS Aux ")
Sqladd("CROSS APPLY dbo.fnRelacionCuenta('TIC', 'TITULO', Aux.MonedaEmision, Aux.TipoEspecie, Aux.Book, Aux.Vehiculo1, Aux.CuentaCustodia ) RC ")
Sqladd(" ) AS Aux1 ")
Sqladd(" Where Rubro ='"~Val(co:1)~"' ")
Sqladd("ORDER BY fechamov DESC ")

