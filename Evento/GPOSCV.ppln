modoreproceso(condialogo)
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(1)
Act(a:fac, 'D.String')
Act(b:fac, 'Cant.Reg.')
Act(c:fac, 'CodigoSAP')
Act(d:fac, 'Vehiculo')
Act(e:fac, 'Moneda')
Act(f:fac, 'Importe')
Act(g:fac, 'FechaDoc')
Act(h:fac, 'FechaValor')
Act(i:fac, 'Sist.Origen')
Act(j:fac, 'Alias1')
Act(k:fac, 'Vehiculo')
Act(l:fac, 'Book')
Act(m:fac, 'Book')
Act(n:fac, 'Vehi/Book')
Act(o:fac, 'Especie')
Act(p:fac, 'CotizaEn')
Act(r:fac, 'Error')
Act(aa:fac, 'Documento')
Act(ab:fac, 'DetalleDoc')
Act(ac:fac, 'FechaCarga')
Act(ad:fac, 'Cta.Contable')
Act(ae:fac, 'Imp.Mon.Local')
Act(af:fac, 'Sociedad GL')
Act(ag:fac, 'Fecha1')
Act(ah:fac, 'Fecha2')
Act(ai:fac, 'Alias2')
Act(aj:fac, 'Valor1')
Act(ak:fac, 'Valor2')

SetFont(a:fac..ak:fac, 2)
repetir
creardialogo
string: 'Codigo SAP';1;1;;;;NoVacio(dialogo.string);'Debe ingresar un Codigo SAP';NO;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXX'
check1: 'Procesa';;;;NO;NO;;;;1
findialogo
if (not ok)
break
endif

Ifa()
Act(a:fac, dialogo.string)
sql.add("Select * from "~Dbo()~".MOVCTAVISTA where CodigoSAP = '"~Val(a:fac)~"' ")
recorrer sql
Dfa()
Scn(b:fac, 1)
Act(c:fac, Fbn('CodigoSAP'))
Act(d:fac, Fbn('Vehiculo'))
Act(e:fac, Fbn('Moneda'))
Acn(f:fac, Fbn('ImporteMonedaDoc'))
Acd(g:fac, Fbn('FechaDoc'))
Acd(h:fac, Fbn('FechaValor'))
Act(i:fac, Fbn('SistemaOrigen'))
Act(j:fac, Fbn('Alias1'))

Act(aa:fac, Fbn('Documento'))
Act(ab:fac, Fbn('DetalleDoc'))
if (NoVacio(Fbn('FechaCarga')))
Acd(ac:fac, Fbn('FechaCarga'))
endif
Act(ad:fac, Fbn('CuentaContable'))
if (NoVacio(Fbn('ImporteMonedaLocal')))
Acn(ae:fac, Fbn('ImporteMonedaLocal'))
endif
Act(af:fac, Fbn('SociedadGLAsociada'))
if (NoVacio(Fbn('Fecha1')))
Acd(ag:fac, Fbn('Fecha1'))
endif
if (NoVacio(Fbn('Fecha2')))
Acd(ah:fac, Fbn('Fecha2'))
endif
Act(ai:fac, Fbn('Alias2'))
if (NoVacio(Fbn('Valor1')))
Acn(aj:fac, Fbn('Valor1'))
endif
if (NoVacio(Fbn('Valor2')))
Acn(ak:fac, Fbn('Valor2'))
endif

proximo
if (Val(b:fac) = 1)
if (NoVacio(Val(j:fac)))
Messagebox('El registro Codigo SAP '~dialogo.string~' ya genero Posicion. Ref.: '~Val(j:fac))
Acn(r:fac, 1)
endif
if (Val(r:fac) = 0)
if (Eqstr(Val(i:fac), 'FPA'))
if (not Incluido(Val(e:fac), 'ARP|USD'))
Messagebox('El registro Codigo SAP '~dialogo.string~' de '~Val(e:fac)~' proviene del sistema FPA.')
Acn(r:fac, 1)
endif
endif
endif
if (Val(r:fac) = 0)
Act(k:fac, BuscarCampo('VEHICULOS', 'Codigo', 'Codigo', Val(d:fac)))
if (Vacio(Val(k:fac)))
Messagebox('El Vehiculo '~Val(d:fac)~' no existe.')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
Act(l:fac, BuscarCampo('VEHICULOS', 'Alias5', 'Codigo', Val(d:fac)))
if (Vacio(Val(l:fac)))
Messagebox('El Vehiculo '~Val(d:fac)~' no tiene Book asociado.')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
Act(m:fac, BuscarCampo('BOOKS', 'Codigo', 'Codigo', Val(l:fac)))
if (Vacio(Val(m:fac)))
Messagebox('El Book '~Val(l:fac)~' asociado el Vehiculo '~Val(d:fac)~' no existe.')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
Act(n:fac, BuscarCampo('BOOKS', 'Vehiculo', 'Codigo', Val(l:fac)))
if (not Eqstr(Val(n:fac), Val(d:fac)))
Messagebox('El Vehiculo '~Val(n:fac)~' del Book '~Val(l:fac)~' no coincide con el Vehiculo '~Val(d:fac)~' del Registro .')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
Act(o:fac, BuscarCampo('ESPECIES', 'Codigo', 'Codigo', Val(e:fac)))
if (Vacio(Val(o:fac)))
Messagebox('La Moneda '~Val(e:fac)~' no existe.')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
Act(p:fac, BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', Val(e:fac)))
if (not Incluido(Val(p:fac), 'ARP|USD'))
Messagebox('La Moneda '~Val(e:fac)~' no Cotiza en ARP ni USD.')
Acn(r:fac, 1)
endif
endif
if (Val(r:fac) = 0)
if (dialogo.check1 = 1)
Message('Procesa')
sql.add("Delete "~Dbo()~".MOVCTAVISTA where CodigoSAP = '"~Val(a:fac)~"' ")
sql.new
sql.exec

sql.add("Insert into "~Dbo()~".MOVCTAVISTA ( ")
sql.add(" CodigoSAP,          Vehiculo,           Documento,        DetalleDoc, ")
sql.add(" FechaCarga,         FechaDoc,           FechaValor,       CuentaContable, ")
sql.add(" Moneda,             ImporteMonedaLocal, ImporteMonedaDoc, SistemaOrigen, ")
sql.add(" SociedadGLAsociada, Fecha1,             Fecha2,           Alias1, ")
sql.add(" Alias2,             Valor1,             Valor2 ")
sql.add(" ) Values ( ")
sql.add("  '"~Val(c:fac)~"', ")
sql.add("  '"~Val(d:fac)~"', ")
if (Vacio(Val(aa:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(aa:fac)~"', ")
endif
if (Vacio(Val(ab:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(ab:fac)~"', ")
endif

if (Vacio(Val(ac:fac)))
sql.add(" NULL, ")
else
sql.add("  "~IdxDate2(Val(ac:fac))~", ")
endif
sql.add("  "~IdxDate2(Val(g:fac))~", ")
sql.add("  "~IdxDate2(Val(h:fac))~", ")
if (Vacio(Val(ad:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(ad:fac)~"', ")
endif

sql.add("  '"~Val(e:fac)~"', ")
if (Vacio(Val(ae:fac)))
sql.add(" NULL, ")
else
sql.add("  "~FStr(Val(ae:fac), 1, 2)~", ")
endif
sql.add("  "~FStr(Val(f:fac), 1, 2)~", ")
sql.add("  '"~Val(i:fac)~"', ")

if (Vacio(Val(af:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(af:fac)~"', ")
endif
if (Vacio(Val(ag:fac)))
sql.add(" NULL, ")
else
sql.add("  "~IdxDate2(Val(ag:fac))~", ")
endif
if (Vacio(Val(ah:fac)))
sql.add(" NULL, ")
else
sql.add("  "~IdxDate2(Val(ah:fac))~", ")
endif
if (Vacio(Val(j:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(j:fac)~"', ")
endif

if (Vacio(Val(ai:fac)))
sql.add(" NULL, ")
else
sql.add("  '"~Val(ai:fac)~"', ")
endif
if (Vacio(Val(aj:fac)))
sql.add(" NULL, ")
else
sql.add("  "~FStr(Val(aj:fac), 1, 8)~", ")
endif
if (Vacio(Val(ak:fac)))
sql.add(" NULL ")
else
sql.add("  "~FStr(Val(ak:fac), 1, 2)~" ")
endif
sql.add(" ) ")
sql.new
sql.exec
endif
endif
endif
if (Val(b:fac) = 0)
Messagebox('Codigo SAP '~dialogo.string~' no encontrado')
endif
if (Val(b:fac) > 1)
Messagebox('Existe mas de un registro con Codigo SAP '~dialogo.string)
endif
SetFont(a:fac..z:fac, 1)
proximo

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

ACO(1, 15)
ACO(3, 15)
ACO(5, 10)
ACO(9, 8)

