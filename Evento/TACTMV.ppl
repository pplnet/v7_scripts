CrearDialogo
   NrOperacion1 : "Nr.Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar Nr.Operacion';NO;
   Radio1       : 'Todo|Movimientos|Posicion|Limites|Devengados';;;;;;;;0;
FinDialogo

If Not Ok
   Cancelar
Endif

&nrOp := Dialogo.NrOperacion1

** Todo: comunes + posicion + limites + devengados + cashflow
If Dialogo.Radio1=0
   SQL.ActualizarMovimientos4(&nrOp, SI, SI, NO, SI, SI, SI)
EndIf

** Solo movimientos (comunes)
If Dialogo.Radio1=1
   SQL.ActualizarMovimientos2(&nrOp, SI, NO, NO, NO)
EndIf

** Solo posicion
If Dialogo.Radio1=2
   SQL.ActualizarMovimientos2(&nrOp, NO, NO, NO, SI)
EndIf

** Solo limites
If Dialogo.Radio1=3
   SQL.ActualizarMovimientos2(&nrOp, NO, SI, NO, NO)
EndIf

** Solo devengados
If Dialogo.Radio1=4
   SQL.ActualizarMovimientos3(&nrOp, NO, NO, NO, NO, SI)
EndIf

SQL.EXEC
Message('Movimientos actualizados para '~&nrOp)
