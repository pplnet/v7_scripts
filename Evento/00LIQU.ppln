creardialogo
nroperacion1: 'Operacion';;;;;;;;;;;;;;"NrOperacion IN (SELECT B.NrOperacion FROM "~Dbo()~".OPERACIONESBITS B WHERE B.NrOperacion = NrOperacion AND B.NrBit = 7 AND B.Valor = '1') "
vehiculo1: 'Vehiculo';;;;;;;;;Var('VEHICULODE')
check1: 'Lo llamo desde la Operacion';;;;NO;NO;;;;0
findialogo
if (not ok)
Cancelar()
endif
Acn(z:2, 1)
if (Val(z:2) = 0)
HojaVisible(SI)
endif

Sqladd(" SELECT DISTINCT O.Cliente1, O.Especie, O.ContraEspecie, O.Cantidad, O.Vehiculo1, ")
Sqladd(" O.Precio1, O.Precio4, O.NrOperacion, O.TotalNetoCli1, O.TotalIntereses, O.TotalBrutoCli1, O.UDN2, ")
Sqladd(" O.FechaOp, O.FechaVto, O.TipoOp, C.RazonSocial, E.Nombre, O.Cuenta1, O.Cuenta2, O.Cuenta5, O.Cuenta6,")
Sqladd(" O.Cuenta3, O.Cuenta4, O.Mercado, O.Mercado2, O.Especie1, O.RB10, O.RB6,C.CategDepositante, O.FechaPago, ")
Sqladd(" O.Mercado4, O.TasaEspecie, O.NrBoleto, ")
Sqladd(" O.MB1, O.TipoTasa, O.MB2, O.Spread ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" WHERE  O.Cliente1    = C.Codigo ")
Sqladd(" AND    O.Especie     = E.Codigo ")
Sqladd(" AND    O.NrOperacion = B.NrOperacion ")
Sqladd(" AND    O.TipoOp NOT IN ('FXOCTC','FXOCTV')  ")
Sqladd(" AND    B.Valor = '1'   ")
if (dialogo.check1 = 0)
Sqladd(" AND    B.NrBit =  7 ")
endif
if (NoVacio(dialogo.nroperacion1))
Sqladd(" AND  O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd(" AND  O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
endif
Sqladd(" ORDER BY O.Cliente1, O.TipoOp   ")
Watch(Sqlbatch())
Acn(z:1, 0)
recorrer sql
Acn(z:1, 1)
Act(a:fac, Fbn('Cliente1')~' - '~Fbn('RazonSocial'))
Act(aa:fac, Fbn('Cliente1'))
Acn(ab:fac, iif (Eqstr(Fbn('CategDepositante'), 'CLI'), 1, 0))
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('TipoOp'))
Acd(d:fac, Fbn('FechaOp'))
if (not Incluido(Fbn('TipoOp'), 'PICO|PICD|'))
Acd(e:fac, Fbn('FechaVto'))
endif
Act(f:fac, Fbn('Especie')~' - '~Fbn('Nombre'))
Act(ff:fac, Fbn('Especie'))
Acn(g:fac, Fbn('Cantidad'))
if (Incluido(Fbn('TipoOp'), 'PICO|PICD|'))
Acn(ar:fac, Fbn('MB1'))
Act(as:fac, Fbn('TipoTasa'))
Acn(at:fac, Fbn('Precio1'))
Acn(au:fac, Fbn('MB2'))
Act(av:fac, Fbn('Especie1'))
Acn(aw:fac, Fbn('Spread'))
if (Fbn('MB1') = 0)
Act(h:fac, FStr(Fbn('Precio1'), 3, 8))
else
Act(h:fac, Fbn('TipoTasa'))
endif
if (Fbn('MB2') = 0)
Act(ay:fac, FStr(Fbn('Spread'), 3, 8))
else
Act(ay:fac, Fbn('Especie1'))
endif
else
if (Incluido(Fbn('TipoOp'), 'MMCREM|MMCT|'))
Acn(ay:fac, Fbn('Precio4') - Fbn('Precio1'))
else
if (Incluido(Fbn('TipoOp'), 'MMCO|'))
Acn(ay:fac, Fbn('Precio1') - Fbn('Precio4'))
endif
endif
Act(h:fac, FStr(Fbn('Precio1'), 3, 8))
endif
Acn(i:fac, Fbn('TotalBrutoCli1'))
Acn(j:fac, Fbn('TotalIntereses'))
Acn(k:fac, Fbn('TotalNetoCli1'))
Acn(rb:fac, Fbn('RB10'))
if (not Incluido(Fbn('TipoOp'), 'TIC|TIV|TIFC|TIFV|TIDE|TIPO|TICO|TICT|TCOPRI|TCPCEM|TICF|TIVF|EQC|EQV'))
Act(tt:fac, 'MONEDA')
Act(mm:fac, 'MONEDA')
if (Incluido(Fbn('TipoOp'), 'FXCF|FXVF|PICO|PICD|'))
Act(l:fac, Fbn('Cuenta1'))
Act(o:fac, Fbn('Cuenta4'))
Act(m:fac, Fbn('Cuenta2'))
Act(n:fac, Fbn('Cuenta3'))
else
if (Incluido(Fbn('TipoOp'), 'MMCREM|'))
Act(l:fac, Fbn('Cuenta1'))
Act(m:fac, Fbn('Cuenta2'))
else
Act(l:fac, Fbn('Cuenta3'))
Act(o:fac, Fbn('Cuenta4'))
Act(m:fac, Fbn('Cuenta1'))
Act(n:fac, Fbn('Cuenta2'))
endif
endif
else
Act(tt:fac, 'TITULO')
Act(mm:fac, 'MONEDA')
Act(l:fac, Fbn('Cuenta1'))
Act(o:fac, Fbn('Cuenta4'))
Act(m:fac, Fbn('Cuenta2'))
Act(n:fac, Fbn('Cuenta3'))
Act(y:fac, Fbn('UDN2'))
if (Eqstr(Var('LIQCOMMO'), 'NO'))
Act(v:fac, Fbn('Cuenta5'))
Act(w:fac, Fbn('Cuenta6'))
endif
endif
Act(p:fac, '')
Act(u:fac, '')
Act(q:fac, Fbn('Vehiculo1'))
Act(r:fac, Fbn('Mercado'))
Act(s:fac, Fbn('Mercado2'))
if (Incluido(Fbn('TipoOp'), 'FXCT|FXVT') y Fbn('RB10') = 1 y Fbn('RB6') = 1)
Act(t:fac, Fbn('Especie1'))
else
Act(t:fac, Fbn('ContraEspecie'))
endif

Act(an:fac, Fbn('Mercado4'))
Act(nr:fac, Fbn('NrBoleto'))
Act(ao:fac, BuscarCampo('MERCADOS', 'Regulado', 'Codigo', Fbn('Mercado4')))
if (Incluido(Fbn('TipoOp'), 'FXCF|FXVF'))
if (Eqstr(Val(ao:fac), 'NO'))
Act(ap:fac, Fbn('TasaEspecie'))
else
Act(ap:fac, Val(t:fac))
endif
Act(aq:fac, Val(ap:fac))
else
Act(ap:fac, Val(t:fac))
endif

Acn(x:fac, 0)

if (Incluido(Fbn('TipoOp'), 'FXC|FXV|FXA|FXCT|FXVT|FXAT|PICO|PICD|'))
Acd(al:fac, Fbn()['FechaPago'])
else
Acd(al:fac, Fbn()['FechaVto'])
endif

Sqladd(" SELECT Comitente, NrDepositante, Numero, Corresponsal, Alias3, Alias1, Alias2 ")
Sqladd(" FROM "~Dbo()~".CUENTAS WHERE Codigo = '"~Val(l:fac)~"' ")
recorrer sql
Dfa()
Act(ae:fac, Fbn('Comitente'))
Act(af:fac, Fbn('NrDepositante'))
Act(ag:fac, Fbn('Numero'))
Act(ah:fac, Fbn('Corresponsal'))
Act(ai:fac, Fbn('Alias3'))
Act(aj:fac, Fbn('Alias1'))
Act(ak:fac, Fbn('Alias2'))
break
proximo

if (not Eqstr(Val(ff:fac), Val(t:fac)))
Sqladd(" SELECT Comitente, NrDepositante, Numero, Corresponsal, Alias3, Alias1, Alias2 ")
Sqladd(" FROM "~Dbo()~".CUENTAS WHERE Codigo = '"~Val(o:fac)~"' ")
recorrer sql
Dfa()
Act(be:fac, Fbn('Comitente'))
Act(bf:fac, Fbn('NrDepositante'))
Act(bg:fac, Fbn('Numero'))
Act(bh:fac, Fbn('Corresponsal'))
Act(bi:fac, Fbn('Alias3'))
Act(bj:fac, Fbn('Alias1'))
Act(bk:fac, Fbn('Alias2'))
break
proximo
endif
Act(cu:0, SQLSet("SELECT Codigo FROM "~Dbo()~".CUENTAS WHERE Cliente='"~iif (Eqstr(BuscarCampo('MERCADOS', 'Netea', 'Codigo', Fbn('Mercado')), 'SI'), Fbn('Vehiculo1'), Fbn('Cliente1'))~"' AND (Especies Like '%"~Fbn('Especie')~"%' OR Especies LIKE '%TITULO%') AND Estado='HAB' AND TipoCuenta In ('CUS','CCO') AND Mercado='"~Fbn('Mercado')~"' and (TiposOperacion is NULL or TiposOperacion like '%"~Fbn('TipoOp')~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
Act(cu:fac, iif (NoVacio(Val(cu:0)), ItemLista(Val(cu:0), 1), Fbn('Cuenta1')))

proximo

if (Val(z:1) = 0)
Cancelar('No se encontraron Operaciones para Confirmar.')
endif

