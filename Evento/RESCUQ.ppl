*-- Calcula Resultados por pago de Cupones de Titulos
CrearDialogo
  Radio2:   'Por|Trans.|Fecha';1;1;;  ;  ;;;;0
  NrTrans1: 'Nr.Trans.:'      ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 o [NoVacio(Dialogo.NrTrans1) y Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'CCUPON|PCUPON')];'Debe ingresar una Transaccion Tipo CCUPON o PCUPON';NO;
  Radio1:   'Por|Alta|Baja'   ;2;2;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0
  Fecha1:   'Fecha'           ;2;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Radio2=0 o [Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys];'Debe ingresar una Fecha Valida';NO;FSys;
  Check1:   'Procesa'         ;3;1;;SI;SI;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)
ACT(a:FAC, 'NrTrans.')
ACT(b:FAC, 'TipoTr')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'Cliente')
ACT(e:FAC, 'Vehiculo')
ACT(f:FAC, 'Book')

ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cupon')
ACT(i:FAC, 'Especie1')
ACT(j:FAC, 'Especie2')
ACT(k:FAC, 'Especie4')

ACT(l:FAC, 'Cantidad1')
ACT(m:FAC, 'Cantidad2')
ACT(n:FAC, 'Cantidad3')
ACT(o:FAC, 'Cantidad4')
ACT(p:FAC, 'Cantidad5')
ACT(q:FAC, 'Cantidad6')
ACT(r:FAC, 'Cantidad7')
ACT(s:FAC, 'Cantidad8')

ACT(t:FAC, 'Precio1')
ACT(u:FAC, 'Precio2')
ACT(v:FAC, 'Precio3')
ACT(w:FAC, 'Precio4')
ACT(x:FAC, 'Precio5')
ACT(y:FAC, 'PrecioEj')

ACT(an:FAC, 'Amort ARP')
ACT(ao:FAC, 'Amort USD')
ACT(ap:FAC, 'Renta ARP')
ACT(aq:FAC, 'Renta USD')

ACT(ba:FAC, '% AmorCap')
ACT(bb:FAC, 'Ints.Cap.')
ACT(bc:FAC, 'Indice')
ACT(be:FAC, 'PPP ARP')
ACT(bg:FAC, 'PPP USD')
ACT(bh:FAC, 'ZeroCupon')

SetFont(a:FAC..bz:FAC,2)

if Dialogo.Radio2=0
  ACN(bz:1, 1)
  * Por Operacion
  if Dialogo.Radio1=0
    * Por Alta
    SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 ")
  else
    * Por Baja
    SQL.ADD(" Select * from "~DBO~".BTRANSACCIONES2 ")
  endif
  SQL.ADD(" Where NrTrans = '"~Dialogo.NrTrans1~"' ")
  SQL.ADD(" Order By NrTrans")
  Recorrer SQL
    if Not Incluido(fbn('TipoTr2'),'CCUPON|PCUPON')
      Cancelar('Error Evento RESCUP. TipoOp incorrecto')
    endif

    ACT(a:FAC, fbn('NrTrans'))
    ACT(b:FAC, fbn('TipoTr2'))
    ACD(c:FAC, fbn('Fecha1'))
    ACT(d:FAC, fbn('Cliente1'))
    ACT(e:FAC, fbn('Vehiculo1'))
*    ACT(f:FAC, fbn('Book1'))
    ACT(g:FAC, fbn('Especie'))
    ACT(h:FAC, fbn('Cupon1'))
    ACT(i:FAC, fbn('Especie1'))
    ACT(j:FAC, fbn('Especie2'))
    ACT(k:FAC, fbn('Especie4'))

    ACN(l:FAC, fbn('Cantidad1'))
    ACN(m:FAC, fbn('Cantidad2'))
    ACN(n:FAC, fbn('Cantidad3'))
    ACN(o:FAC, fbn('Cantidad4'))
    ACN(p:FAC, fbn('Cantidad5'))
    ACN(q:FAC, fbn('Cantidad6'))
    ACN(r:FAC, fbn('Cantidad7'))
    ACN(s:FAC, fbn('Cantidad8'))

    ACN(t:FAC, fbn('Precio1'))
    ACN(u:FAC, fbn('Precio2'))
    ACN(v:FAC, fbn('Precio3'))
    ACN(w:FAC, fbn('Precio4'))
    ACN(x:FAC, fbn('Precio5'))
    ACN(y:FAC, fbn('PrecioEj'))

    ACT(z:FAC, 'Orignal')

    ACT(bh:FAC , BuscarCampo('ESPECIES','ZeroCoupon','Codigo',fbn('Especie2')))
    if EqStr(Val(bh:FAC),'SI')
      ACN(ba:FAC, 1)
    else
      ACN(ba:FAC , SQL("SELECT (PorAmCapital/100) FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Val(j:FAC)~"' AND NrCupon = '"~Val(h:FAC)~"' "))
    endif
    ACN(bb:FAC , fbn('Cantidad6')/fbn('Cantidad1')/fbn('Precio3'))
    ACN(bc:FAC , fbn('Precio3')/Val(ba:FAC))

    SQL.ADD("Select P.* From "~DBO~".POSICIONES P ")
    SQL.ADD(" Where P.TipoNegocio  = 'SEC' ")
    SQL.ADD("   and P.CantidadFin  <> 0 ")
    SQL.ADD("   and P.NrSaldo      in (120,130) ")
    SQL.ADD("   and P.Especie      = '"~fbn('Especie2')~"' ")
    SQL.ADD("   and P.Vehiculo     = '"~fbn('Vehiculo1')~"' ")
    SQL.ADD("   and P.Fecha       <= '"~IdxDate(Val(c:FAC))~"' ")
    SQL.ADD("   and P.Fecha = (Select MAX(P1.Fecha) ")
    SQL.ADD("                    From "~DBO~".POSICIONES P1 ")
    SQL.ADD("                   Where P1.Vehiculo        = P.Vehiculo ")
    SQL.ADD("                     and P1.TipoNegocio     = P.TipoNegocio ")
    SQL.ADD("                     and P1.Cliente         = P.Cliente ")
    SQL.ADD("                     and P1.Especie         = P.Especie ")
    SQL.ADD("                     and P1.Cupon           = P.Cupon ")
    SQL.ADD("                     and P1.NrSaldo         = P.NrSaldo ")
    SQL.ADD("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
    SQL.ADD("                     and P1.Fecha           < '"~IdxDate(Val(c:FAC))~"' ")
    SQL.ADD("                 ) ")
    SQL.ADD(" order by NrSaldo,Especie,Cupon,Vehiculo,Fecha ")
    recorrer SQL
      DFA
      if fbn('NrSaldo')=120
        SCN(bd:FAC, 1)
        ACN(be:FAC, fbn('PrecioFin'))
      else
        SCN(bf:FAC, 1)
        ACN(bg:FAC, fbn('PrecioFin'))
      endif
      SCN(bz:1, 1)
      ACD(ca:Val(bz:1), fbn('Fecha'))
      ACT(cb:Val(bz:1), fbn('Especie'))
      ACN(cc:Val(bz:1), fbn('Cupon'))
      ACT(cd:Val(bz:1), fbn('Vehiculo'))
      ACT(ce:Val(bz:1), fbn('Cliente'))
      ACT(cf:Val(bz:1), fbn('Book'))
      ACN(cg:Val(bz:1), fbn('NrSaldo'))
      ACN(ch:Val(bz:1), fbn('CantidadIni'))
      ACN(ci:Val(bz:1), fbn('PrecioIni'))
      ACN(cj:Val(bz:1), fbn('CantidadFin'))
      ACN(ck:Val(bz:1), fbn('PrecioFin'))
    proximo
     

    * Por Transaccion busco otras transacciones de la misma fecha
    SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 ")
    SQL.ADD(" Where NrTrans   <> '"~Dialogo.NrTrans1~"' ")
    SQL.ADD("   and TipoTr2   in ('CCUPON','PCUPON') ")
    SQL.ADD("   and Fecha1    = "~IdxDate2(fbn('Fecha1'))~" ")
    SQL.ADD("   and Vehiculo1 = '"~fbn('Vehiculo1')~"' ")
*    SQL.ADD("   and Book1     = '"~fbn('Book1')~"' ")
    SQL.ADD("   and Especie   = '"~fbn('Especie')~"' ")
    SQL.ADD("   and Especie2   = '"~fbn('Especie2')~"' ")
    SQL.ADD(" Order By NrTrans ")
    Recorrer SQL
      ACT(a:FAC, fbn('NrTrans'))
      ACT(b:FAC, fbn('TipoTr2'))
      ACD(c:FAC, fbn('Fecha1'))
      ACT(d:FAC, fbn('Cliente1'))
      ACT(e:FAC, fbn('Vehiculo1'))
*      ACT(f:FAC, fbn('Book1'))
      ACT(g:FAC, fbn('Especie'))
      ACT(h:FAC, fbn('Cupon1'))
      ACT(i:FAC, fbn('Especie1'))
      ACT(j:FAC, fbn('Especie2'))
      ACT(k:FAC, fbn('Especie4'))

      ACN(l:FAC, fbn('Cantidad1'))
      ACN(m:FAC, fbn('Cantidad2'))
      ACN(n:FAC, fbn('Cantidad3'))
      ACN(o:FAC, fbn('Cantidad4'))
      ACN(p:FAC, fbn('Cantidad5'))
      ACN(q:FAC, fbn('Cantidad6'))
      ACN(r:FAC, fbn('Cantidad7'))
      ACN(s:FAC, fbn('Cantidad8'))

      ACN(t:FAC, fbn('Precio1'))
      ACN(u:FAC, fbn('Precio2'))
      ACN(v:FAC, fbn('Precio3'))
      ACN(w:FAC, fbn('Precio4'))
      ACN(x:FAC, fbn('Precio5'))
      ACN(y:FAC, fbn('PrecioEj'))

      ACT(z:FAC, 'Hermana')

      ACT(bh:FAC , BuscarCampo('ESPECIES','ZeroCoupon','Codigo',fbn('Especie2')))
      if EqStr(Val(bh:FAC),'SI')
        ACN(ba:FAC, 1)
      else
        ACN(ba:FAC , SQL("SELECT (PorAmCapital/100) FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Val(j:FAC)~"' AND NrCupon = '"~Val(h:FAC)~"' "))
      endif
      ACN(bb:FAC , fbn('Cantidad6')/fbn('Cantidad1')/fbn('Precio3'))
      ACN(bc:FAC , fbn('Precio3')/Val(ba:FAC))

      SQL.ADD("Select P.* From "~DBO~".POSICIONES P ")
      SQL.ADD(" Where P.TipoNegocio  = 'SEC' ")
      SQL.ADD("   and P.CantidadFin  <> 0 ")
      SQL.ADD("   and P.NrSaldo      in (120,130) ")
      SQL.ADD("   and P.Especie      = '"~fbn('Especie2')~"' ")
      SQL.ADD("   and P.Vehiculo     = '"~fbn('Vehiculo1')~"' ")
      SQL.ADD("   and P.Fecha       <= '"~IdxDate(Val(c:FAC))~"' ")
      SQL.ADD("   and P.Fecha = (Select MAX(P1.Fecha) ")
      SQL.ADD("                    From "~DBO~".POSICIONES P1 ")
      SQL.ADD("                   Where P1.Vehiculo        = P.Vehiculo ")
      SQL.ADD("                     and P1.TipoNegocio     = P.TipoNegocio ")
      SQL.ADD("                     and P1.Cliente         = P.Cliente ")
      SQL.ADD("                     and P1.Especie         = P.Especie ")
      SQL.ADD("                     and P1.Cupon           = P.Cupon ")
      SQL.ADD("                     and P1.NrSaldo         = P.NrSaldo ")
      SQL.ADD("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
      SQL.ADD("                     and P1.Fecha           < '"~IdxDate(Val(c:FAC))~"' ")
      SQL.ADD("                 ) ")
      SQL.ADD(" order by NrSaldo,Especie,Cupon,Vehiculo,Fecha ")
      recorrer SQL
        DFA
        if fbn('NrSaldo')=120
          SCN(bd:FAC, 1)
          ACN(be:FAC, fbn('PrecioFin'))
        else
          SCN(bf:FAC, 1)
          ACN(bg:FAC, fbn('PrecioFin'))
        endif
        SCN(bz:1, 1)
        ACD(ca:Val(bz:1), fbn('Fecha'))
        ACT(cb:Val(bz:1), fbn('Especie'))
        ACN(cc:Val(bz:1), fbn('Cupon'))
        ACT(cd:Val(bz:1), fbn('Vehiculo'))
        ACT(ce:Val(bz:1), fbn('Cliente'))
        ACT(cf:Val(bz:1), fbn('Book'))
        ACN(cg:Val(bz:1), fbn('NrSaldo'))
        ACN(ch:Val(bz:1), fbn('CantidadIni'))
        ACN(ci:Val(bz:1), fbn('PrecioIni'))
        ACN(cj:Val(bz:1), fbn('CantidadFin'))
        ACN(ck:Val(bz:1), fbn('PrecioFin'))
      proximo
     
    proximo
  proximo

  if FAC>1
    ACN(az:4, 0)
    ACN(az:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
    if Val(az:4)=0
      ACN(az:5, 1)
    else
      ACN(az:5, VAR('MESINIEJE'))
    endif
    if Val(az:5)<1 or Val(az:5)>12
      ACN(az:5, 1)
    endif
    if Mes(Val(c:2))>=Val(az:5)
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2)),4,0))
    else
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2))-1,4,0))
    endif
    ACD(az:7, Fecha(Val(az:6)))

    recorrer&i 2,FAC
      if EqStr(Val(b:&i),'CCUPON')
        ACN(ay:1, 1)
      else
        ACN(ay:1, -1)
      endif
      if Dialogo.Radio1=1 y &i=2
        ACN(an:&i, 0)
        ACN(ao:&i, 0)
        ACN(ap:&i, 0)
        ACN(aq:&i, 0)
      else
        if EqStr(Val(i:&i),'ARP')
*          ACN(an:&i, Val(q:&i)*Val(ay:1))
*          ACN(ao:&i, Val(q:&i)*Val(ay:1)/Cotizacion('USD',,,,Val(c:&i),1,SI))
          ACN(an:&i, Val(ba:&i)*Val(l:&i)*Val(ay:1)*(Val(bb:&i)*Val(bc:&i)-Val(be:&i)))
          ACN(ao:&i, Val(ba:&i)*Val(l:&i)*Val(ay:1)*(Val(bb:&i)*Val(bc:&i)/Cotizacion('USD',,,,Val(c:&i),1,SI)-Val(bg:&i)))
          ACN(ap:&i, Val(p:&i)*Val(ay:1))
          ACN(aq:&i, Val(p:&i)*Val(ay:1)/Cotizacion('USD',,,,Val(c:&i),1,SI))
        else
*          ACN(an:&i, Val(q:&i)*Val(ay:1)*Cotizacion('USD',,,,Val(c:&i),1,SI))
*          ACN(ao:&i, Val(q:&i)*Val(ay:1))
          ACN(an:&i, Val(ba:&i)*Val(l:&i)*Val(ay:1)*(Val(bb:&i)*Val(bc:&i)*Cotizacion('USD',,,,Val(c:&i),1,SI)-Val(be:&i)))
          ACN(ao:&i, Val(ba:&i)*Val(l:&i)*Val(ay:1)*(Val(bb:&i)*Val(bc:&i)-Val(bg:&i)))
          ACN(ap:&i, Val(p:&i)*Val(ay:1)*Cotizacion('USD',,,,Val(c:&i),1,SI))
          ACN(aq:&i, Val(p:&i)*Val(ay:1))
        endif
      endif
      SetFont(an:&i..aq:&i,1)
    proximo

    SetFont(a:2..z:FAC,1)
    SetFont(ba:2..bh:FAC,1)
    FormatoCeldas(l:2..s:FAC, Exe('F2'))
    FormatoCeldas(t:2..y:FAC, Exe('F8'))
    FormatoCeldas(ba:2..bc:FAC, Exe('F8'))
    FormatoCeldas(be:2..be:FAC, Exe('F8'))
    FormatoCeldas(bg:2..bg:FAC, Exe('F8'))

    ACT(am:FAC+2, 'Day')
    ACN(an:FAC+2, Sum(an:2..an:FAC))
    ACN(ao:FAC+2, Sum(ao:2..ao:FAC))
    ACN(ap:FAC+2, Sum(ap:2..ap:FAC))
    ACN(aq:FAC+2, Sum(aq:2..aq:FAC))

    ACT(aa:1, 'Exp. En')
    ACT(aa:2, 'Amo.ARP')
    ACT(aa:3, 'Amo.USD')
    ACT(aa:4, 'Ren.ARP')
    ACT(aa:5, 'Ren.USD')
    ACT(ab:1, 'Day')
    ACT(ac:1, 'NrSaldo')
    ACT(ad:1, 'Cant.Reg')
    ACT(ae:1, 'Fecha Res')
    ACT(af:1, 'LastDay')
    ACT(ag:1, 'MTD')
    ACT(ah:1, 'YTD')
    ACT(ak:1, 'Resultado')
    SetFont(aa:1..al:1,2)

    ACN(ab:2, Val(an:FAC+2))
    ACN(ac:2, 120)
    ACT(al:2, 'CUPAMO')
    ACN(ab:3, Val(ao:FAC+2))
    ACN(ac:3, 130)
    ACT(al:3, 'CUPAMO')
    ACN(ab:4, Val(ap:FAC+2))
    ACN(ac:4, 120)
    ACT(al:4, 'CUPREN')
    ACN(ab:5, Val(aq:FAC+2))
    ACN(ac:5, 130)
    ACT(al:5, 'CUPREN')
  
    SQL.ADD("Select * from "~DBO~".RESULTADOS R1 ")
    SQL.ADD(" where R1.TipoResultado in ('CUPAMO','CUPREN') ")
    SQL.ADD("   and R1.Especie  =  '"~Val(j:2)~"' ")
    SQL.ADD("   and R1.Vehiculo =  '"~Val(e:2)~"' ")
    if NoVacio(Val(f:2))
      SQL.ADD("   and IsNull(R1.Book,'')     =  '"~Val(f:2)~"' ")
    endif
    SQL.ADD("   and R1.NrSaldo  in (120,130) ")
    SQL.ADD("   and R1.Fecha    >= "~IdxDate2(Val(az:7))~" ")
    SQL.ADD("   and R1.Fecha    = (select Max(Fecha) ")
    SQL.ADD("                       from  "~DBO~".RESULTADOS R2 ")
    SQL.ADD("                       where R2.Especie         =  R1.Especie ")
    SQL.ADD("                        and  R2.Vehiculo        =  R1.Vehiculo ")
    SQL.ADD("                        and  IsNull(R2.Book,'') =  IsNull(R1.Book,'') ")
    SQL.ADD("                        and  R2.NrSaldo         =  R1.NrSaldo ")
    SQL.ADD("                        and  R2.TipoResultado   =  R1.TipoResultado ")
    SQL.ADD("                        and  R2.TipoNegocio     =  R1.TipoNegocio ")
    SQL.ADD("                        and  R2.Fecha          <= "~IdxDate2(Val(c:2))~" ")
    SQL.ADD("                     ) ")
    SQL.ADD(" Order By Fecha ")
    recorrer SQL
      DFA
      if EqStr(fbn('TipoResultado'),'CUPAMO')
        if fbn('NrSaldo')=120
          ACN(x1,2)
        else
          ACN(x1,3)
        endif
      else
        if fbn('NrSaldo')=120
          ACN(x1,4)
        else
          ACN(x1,5)
        endif
      endif
      SCN(ad:Val(x1), 1)
      ACD(ae:Val(x1), fbn('Fecha'))
      ACN(af:Val(x1), fbn('Day'))
      ACN(ag:Val(x1), fbn('MTD'))
      ACN(ah:Val(x1), fbn('YTD'))
      ACT(ak:Val(x1), fbn('TipoResultado'))
    proximo

    recorrer&i 2,5

      if Val(ad:&i)=0
        * No existe registro para el ejercicio
        ACT(ai:&i, 'Nuevo')
      else
        if Mes(Val(c:2))=Mes(Val(ae:&i))
          * Mismo Mes
          if Dia(Val(c:2))=Dia(Val(ae:&i))
            * Mismo Dia
            ACT(ai:&i, 'Mismo Dia/Mes')
          else
            * Distinto Dia
            ACT(ai:&i, 'Mismo Mes/Distinto Dia')
          endif
        else
          * Distinto Mes
          ACT(ai:&i, 'Distinto Mes')
        endif
      endif

      if Dialogo.Check1=1
        ACT(aj:&i, 'Procesa')
        SQL.ADD("EXEC "~DBO~".ActualizaResultados ")
        * Maxfecha
        SQL.ADD(" '"~IdxDate(Val(ae:&i))~"',")
        * Fecha
        SQL.ADD(" '"~IdxDate(Val(c:2))~"',")
        * Cliente
        SQL.ADD(" '"~Val(e:2)~"', ")
        * Vehiculo
        SQL.ADD(" '"~Val(e:2)~"', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * NrSaldo
        SQL.ADD(" "~FStr(Val(ac:&i),0,0)~", ")
        * Especie
        SQL.ADD(" '"~Val(j:2)~"', ")
        SQL.ADD(" Null, ")
        SQL.ADD(" Null, ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * Book
        if NoVacio(Val(f:2))
          SQL.ADD(" '"~Val(f:2)~"', ")
        else
          SQL.ADD(" Null, ")
        endif
        SQL.ADD(" '', ")
        SQL.ADD(" 'SEC', ")
        SQL.ADD(" '"~Val(al:&i)~"', ")
        SQL.ADD(" "~FStr(Val(ab:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(ag:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(ah:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(af:&i),0,2)~" ")
        SQL.NEW
        SQL.EXEC
      endif

    proximo

    SetFont(am:FAC+2..aq:FAC+6,2)
    FormatoCeldas(an:FAC+2..aq:FAC+6, Exe('F2'))

  endif
endif

if Dialogo.Radio2=1
  * Por Fecha
  SQL.ADD(" Select NrOperacion from "~DBO~".TRANSACCIONES ")
  SQL.ADD("  where Fecha1   = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("    and TipoTr2  in ('CCUPON','PCUPON') ")
  SQL.ADD(" Order By NrTrans")
  Recorrer SQL
    ACT(a:FAC, fbn('NrOperacion'))
    EjecutarEvento('RESCUP',Radio2=0,NrTrans1=fbn('NrTrans'),Radio1=0,Fecha1=Dialogo.Fecha1,Check1=Dialogo.Check1)
  proximo
endif
