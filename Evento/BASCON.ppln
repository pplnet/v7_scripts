creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
findialogo

if (not ok)
Cancelar()

endif

Act(aa:5, sql("select convert(varchar(8),Getdate(),112)"))

if (not existedirectorio(Var("PATHBASCON")))
Messagebox("No existe el directorio "~Var("PATHBASCON"))
Cancelar()
endif

sql.add("SELECT A.NrUnicoAsiento,A.FechaValor,substring(A1.Cuenta,1,9) as Cuenta,")
sql.add("case when A1.DebitoCredito='DEB' then 'D' else 'C' end as DC,str(A1.Cantidad1,15,2) as Cantidad1,isnull(RTRIM(A.NrOperacion),'') as NrOperacion,")
sql.add("SUBSTRING('FPA-' + RTRIM(A.NrUnicoAsiento) +'-'+ isnull(RTRIM(A.Modelo),'') + ' ' + isnull(RTRIM(A.NrOperacion),''),1,40)      as Descripcion,")
sql.add("A1.Alias4 as FechaVto, A1.alias5,A1.valor3,A1.valor2,A1.alias5,A1.NrTrans2,")
sql.add("isnull(RTRIM(Case WHEN A.NrOperacion = '' THEN A1.NrTrans2 else A.NrOperacion END),'')      as Descripcion1, A.Estado, A1.Especie1 Moneda")
sql.add("FROM dbo.ASIENTOSCON A INNER JOIN dbo.ASIENTOSCON1 A1 on (A.NrUnicoAsiento=A1.NrUnicoAsiento)")
sql.add("where (A.Estado IS Null OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'REV') ")
sql.add("AND A.FechaValor <= '"~IdxDate(FSys())~"' ")

Act(bb:1, "N")
Acn(aa:4, 0)
Acn(aa:6, 0)
Acn(aa:7, 0)

Watch(sql.batch)
recorrer sql

if (Eqstr(Val(bb:1), "N"))
abrirascii(Var("PATHBASCON")~"\CBSIS005"~Copy(Val(aa:5), 1, 4)~Copy(Val(aa:5), 5, 2)~Copy(Val(aa:5), 7, 2)~Copy(Hora(SQLAhora()), 1, 2)~Copy(Hora(SQLAhora()), 4, 2)~Copy(Hora(SQLAhora()), 7, 2)~".TXT", 0)
Acn(aa:2, Fbn()['NrUnicoAsiento'])
endif

Act(bb:1, "S")

if (not Val(aa:2) = Fbn()['NrUnicoAsiento'])
Acn(aa:2, Fbn()['NrUnicoAsiento'])
Acn(aa:1, 1)
else
Acn(aa:1, Val(aa:1) + 1)
endif


Acn(aa:10, Posicion(',', Fbn()['valor3'], 0))
if (Val(aa:10) = 0)
Acn(aa:10, 5)
endif

Acn(aa:11, Posicion('-', Fbn()['valor2'], 0))
if (Val(aa:11) <> 0)
Act(aa:11, '-'~Pad0(Copy(Fbn()['valor2'], 2, 200), 11))
else
Act(aa:11, Pad0(Fbn()['valor2'], 12))
endif

Acn(po:1, Posicion('-', Fbn('Alias5'), 1))
Act(es:1, Copy(Fbn('Alias5'), Val(po:1) + 1, Longitud(Fbn('Alias5'))))
if (Longitud(Val(es:1)) > 6)
Act(es:1, Copy(Val(es:1), Longitud(Val(es:1)) - 6 + 1, Longitud(Val(es:1))))
endif

if (Val(po:1) > 10)
Acn(de:1, Val(po:1) - 9)
Act(cc:1, Copy(Fbn('Alias5'), Val(de:1), 9))
else
Acn(de:1, 1)
Act(cc:1, Copy(Fbn('Alias5'), Val(de:1), Val(po:1) - 1))
endif

Act(fv:1, Copy(Fbn('FechaVto'), 1, 2)~Copy(Fbn('FechaVto'), 4, 2)~Copy(Fbn('FechaVto'), 7, 4))

Act(fv:2, Copy(Fbn('FechaValor'), 1, 2)~Copy(Fbn('FechaValor'), 4, 2)~Copy(Fbn('FechaValor'), 7, 4))

Act(fl:1, Copy(Fbn('FechaValor'), 1, 2)~Copy(Fbn('FechaValor'), 4, 2)~Copy(Fbn('FechaValor'), 7, 4))

Act(fp:1, Copy(dialogo.fecha1, 1, 2)~Copy(dialogo.fecha1, 4, 2)~Copy(dialogo.fecha1, 7, 4))

if (not EsNumero(Copy(Fbn('Descripcion1'), 1, 1)))
Act(NO:1, '0'~Copy(Fbn('Descripcion1'), 2, 7))
if (not EsNumero(Copy(Fbn('Descripcion1'), 2, 1)))
Act(NO:1, '00'~Copy(Fbn('Descripcion1'), 3, 6))
endif
else
if (not EsNumero(Copy(Fbn('Descripcion1'), 2, 1)))
Act(NO:1, Copy(Fbn('Descripcion1'), 1, 1)~'0'~Copy(Fbn('Descripcion1'), 3, 6))
else
Act(NO:1, Fbn('Descripcion1'))
endif
endif
Act(mo:1, sql("Select ValorSistemaExterno from "~Dbo()~".CONFIGVALEXTERNOS where CodigoProceso = 'CBSIS' and Atributo = 'MONEDA' and Valor = '"~Fbn('Moneda')~"' "))

Acn(aa:9, Posicion('-', Fbn()['alias5'], 1))
escribirascii("001"~Pad0(Fbn('NrUnicoAsiento'), 9)~Pad0(Val(aa:1), 4)~Pad0(Val(fp:1), 8)~Pad0(Val(fv:2), 8)~Pad0(Val(fl:1), 8)~Pad0(Fbn()['Cuenta'], 9)~"        "~Val(mo:1)~"      000"~Fbn()['DC']~Pad0(Copy(Fbn()['Cantidad1'], 1, Posicion('.', Fbn()['Cantidad1'], 1) - 1)~Copy(Fbn()['Cantidad1'], Posicion('.', Fbn()['Cantidad1'], 1) + 1, 2), 14)~Pad0('0', 14)~Pad(Fbn()['Descripcion'], 40)~Pad0(Val(es:1), 6)~Pad0(Val(fv:1), 8)~Pad0(Val(cc:1), 9)~Pad0(Copy(Fbn()['valor3'], 1, Val(aa:10) - 1), 4)~Pad(Copy(Fbn()['valor3'], Val(aa:10) + 1, 6), 6, '0')~Pad0('0', 3)~Val(aa:11)~Pad0('0', 56)~Pad('', 35)~Pad0(Val(NO:1), 8)~Pad0('0', 3))


Acn(aa:4, Val(aa:4) + 1)
Acn(aa:6, Val(aa:6) + Fbn('NrUnicoAsiento'))
Acn(aa:7, Val(aa:7) + Fbn('cantidad1'))

if (Eqstr(Fbn('Estado'), 'COT'))
sql("Update "~Dbo()~".ASIENTOSCON set Estado='COE' Where NrUnicoAsiento='"~Fbn()['NrUnicoAsiento']~"'")
else
if (Eqstr(Fbn('Estado'), 'REV'))
sql("Update "~Dbo()~".ASIENTOSCON set Estado='REE' Where NrUnicoAsiento='"~Fbn()['NrUnicoAsiento']~"'")
else
sql("Update "~Dbo()~".ASIENTOSCON set Estado='E' Where NrUnicoAsiento='"~Fbn()['NrUnicoAsiento']~"'")
endif
endif
proximo


if (Eqstr(Val(bb:1), "S"))
Act(aa:7, FStr(Val(aa:7), 18, 2))
escribirascii(Pad0(Val(aa:4), 18)~Pad0(Val(aa:6), 18)~Pad0(Copy(Val(aa:7), 1, Posicion('.', Val(aa:7), 1) - 1)~Copy(Val(aa:7), Posicion('.', Val(aa:7), 1) + 1, 2), 18)~Pad('', 218))
cerrarascii
endif

