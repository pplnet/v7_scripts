sql.add("select M.FechaMov,    M.Vehiculo Cliente, M.Especie,     M.Cupon,  ")
sql.add("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.PrecioClean Precio, ")
sql.add("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
sql.add("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
sql.add("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
sql.add("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8, O.FechaVto ")
sql.add("  from "~Dbo()~".MOVPOSEJE2 M, "~Dbo()~".ESPECIES E, "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V ")
sql.add(" where M.NrSaldo  = 3 ")
sql.add(" AND V.Codigo = M.Vehiculo ")
sql.add("   and M.TipoNegocio = 'SEC' ")
if (NoVacio(dialogo.especie1))
sql.add("  and M.Especie    = '"~dialogo.especie1~"' ")
endif
sql.add("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
sql.add("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
sql.add("   and M.Especie     = E.Codigo ")
sql.add("   and M.NrOperacion = O.NrOperacion ")
sql.add(" AND E.Issuer = M.Vehiculo ")
if (NoVacio(dialogo.lista1))
sql.add(" AND O.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
sql.add(" AND  O.Vehiculo1    IN ("~pipe2comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
sql.add(" order by M.Especie, M.Cupon ")

recorrer sql
