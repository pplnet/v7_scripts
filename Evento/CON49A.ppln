sql.add("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
sql.add("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
sql.add("       P.CantidadFin as Cantidad, P.Book, ")
sql.add("       P.CantidadFin*P.PFRME as Monto, '' Observaciones, '' Cliente1, P.Vehiculo Vehiculo, E.Alias8 ")
sql.add(" from  "~Dbo()~".POSICIONES2 P, "~Dbo()~".ESPECIES E ")
sql.add(" where P.Especie     = E.Codigo ")
sql.add("   and P.NrSaldo     = 3 ")
sql.add("   and P.TipoNegocio = 'SEC' ")
if (NoVacio(dialogo.especie1))
sql.add("  and P.Especie     = '"~dialogo.especie1~"' ")
endif
sql.add("   and P.Fecha = '"~IdxDate(Val(v:3))~"' ")
if (NoVacio(dialogo.lista1))
sql.add(" AND P.Vehiculo IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND P.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add(" AND  P.Vehiculo IN ("~pipe2comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
sql.add(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
sql.add(" order by P.Especie, P.Cupon ")

recorrer sql
