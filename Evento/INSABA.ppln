creardialogo
vehiculo1:'Vehiculo';;;;;;NoVacio(vehiculo1);'Vehiculo invalido';NO;
cliente1:'Entidad';;;;;;;;;
cuenta1:'Cuenta';;;;;;;;;
fecha1:'FechaSaldo';;;;;;;;;
especie1:'Moneda';;;;;;;;;
cantidad1:'Saldo';;;;;;;;;
nrtrans1:'Número de Transacción';;;;;;;;;

findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select Numero, Nombre, TipoCuenta, CBU ")
Sqladd(" From "~Dbo()~".CUENTAS ")
Sqladd(" Where Codigo = '"~dialogo.cuenta1~"'")
recorrer sql
let(&nrcuenta, Fbn('Numero'))
let(&nombrecuenta, Fbn('Nombre'))
let(&tipocuenta, Fbn('TipoCuenta'))
let(&cbu, Fbn('CBU'))
proximo
let(&banco, BuscarCampo('CLIENTES', 'Alias3', 'Codigo', cliente1))
let(&cuit, BuscarCampo('CLIENTES', 'CUIT', 'Codigo', cliente1))

if (cantidad1 >= 0)
let(&signocontable, 'C')
let(&signoinicial, 'C')
let(&signooperativo, 'C')
else
let(&signocontable, 'D')
let(&signoinicial, 'D')
let(&signooperativo, 'D')
endif


Sqladd(" INSERT INTO "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" (FechaSaldo, FechaBajada, FechaCarga, ")
Sqladd(" NrCuenta, Nombre, TipoCuenta, ")
Sqladd(" SaldoContable, SaldoInicio, SaldoOperativo, ")
Sqladd(" Estado, Banco, CBU, CUIT, ")
Sqladd(" SignoContable, SignoInicial, SignoOperativo, ")
Sqladd(" Usuario, NrTransAjuste ) ")
Sqladd(" VALUES('"~IdxDate(dialogo.fecha1)~"' , '"~IdxDate(FSys())~"' , "~SQLAhora()~" , ")
Sqladd(" '"~&nrcuenta~"','"~&nombrecuenta~"','"~&tipocuenta~"',")
Sqladd(" "~FStr(dialogo.cantidad1, 0, 2)~", "~FStr(dialogo.cantidad1, 0, 2)~", "~FStr(dialogo.cantidad1, 0, 2)~", ")
Sqladd(" 'REC','"~&banco~"', '"~&cbu~"', '"~&cuit~"', ")
Sqladd(" '"~&signocontable~"','"~&signoinicial~"','"~&signooperativo~"', ")
Sqladd(" '"~UsuarioActivo()~"', '"~dialogo.nrtrans1~"') ")
Sqlnew()
Sqlexec()

