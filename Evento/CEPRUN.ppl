*-- CEPRUN : Cesion de Prestamos Local/Off Unico Vto
*-- HOJAVISIBLE(SI)
*-- NrOperacion2 de la Operacion guarda el nro. de operacion originalmente cedida, o sea su padre
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;;;;" TipoOp In ('MMPCL','MMPCOS') ";;
  Vehiculo1    : "Vehiculo"                 ;;;;NO;;;;;;BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1);;;;
  Radio3       : 'Fondeo|Local|Extranjero'  ;;;;NO;EqStr(Dialogo.TipoOp1,'MMPCL');;;;;BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1);;;;
  Radio5       : 'Fondeo|BLocalFExt|BcoExt' ;;;;NO;EqStr(Dialogo.TipoOp1,'MMPCOS');;;;;BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1);;;;
  Cliente4     : "Colocador"                ;;;;NO;;NOT EQSTR(Dialogo.Cliente1, Dialogo.Cliente4);'Los Participantes no pueden ser iguales';NO;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Moneda"                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha1       : "Vto V_Nominal"            ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1)
  Cantidad1    : "VNA"                      ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1);;;"###,###,###,###.##"
  TipoOp1      : 'TipoOp'                   ;;;;NO;NO;Incluido(Dialogo.TipoOp1,'MMPCOS|MMPCL');'Ingrese Una Operacion del Tipo MMPCOS o MMPCL';NO;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cliente1     : "Tomador"                  ;2;2;;;;[[EqStr(Dialogo.TipoOp1,'MMPCL') y [Dialogo.Radio4=0 y Dialogo.Radio3<=1 y DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS')] o [DESCIENDEDECLIENTE(Dialogo.Cliente1,'EMPRESAS') y Dialogo.Radio3=0 Y Dialogo.Radio4=0]] o [EqStr(Dialogo.TipoOp1,'MMPCOS') y Dialogo.Radio4=1]] y DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS');'Entidad Invalida => FONDEO LOCAL: Entidad o Banco Local, FONDEO EXTR: Banco Local Op.Off Shore: Banco Extranjero';NO;;
  Cantidad2    : "Valor Nominal"              ;;;;;;Dialogo.Cantidad2 >0 y Dialogo.Cantidad2<=Dialogo.Cantidad1;'El Valor Nominal de la Nueva Operacion debe ser Inferior al Valor Nominal del Original';NO; ; ;;;"###,###,###,###.##"
  Radio1       : "Ya Participa?|No|Si"        ;;;;NO;;;;;;IIF(NOVACIO(Dialogo.NrOperacion3),1,0)
  Radio2       : "Acumula a Existente?|No|Si" ;;;;;Dialogo.Radio1=1;;;;IIF(Dialogo.Radio1=1,1,0);IIF(Dialogo.Radio1=1,1,0)
  Fecha3       : "Concertacion"             ;;;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio1<>0 o Dialogo.Fecha3<=Dialogo.Fecha4;'Fecha de Concertacion Incorrecta';NO;Fsys
  Fecha4       : "F.Cesion"                 ;;;;Dialogo.Radio2=0;Dialogo.Radio2=0;ESHABIL(Dialogo.Fecha4,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1));'Fecha de Origen Incorrecta';NO;FSYS;
  Precio4      : 'Tasa WH'                  ;8;;;Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS');Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS');Not EqStr(Dialogo.TipoOp1,'MMPCOS') o [EqStr(Dialogo.TipoOp1,'MMPCOS') y Incluido(Fstr(Dialogo.Precio4,2,4),VAR('TASAWH'))];'El Valor de Tasa WH es Invalido: '~Fstr(Dialogo.Precio4,2,4)~' '~VAR('TASAWH')~' ...';NO;;;;;"###.####"
  Precio5      : 'Tasa IVA'                 ;;;;Dialogo.Radio2=0 ;Dialogo.Radio2=0 ;[Not Dialogo.Radio2=0] o Incluido(Fstr(Dialogo.Precio5,2,2),VAR('IVA'));'El Valor de Tasa IVA es Invalido: '~Fstr(Dialogo.Precio5,2,2)~' '~VAR('IVA')~' ...';NO;;;;;"###.####"
  Precio6      : 'Tasa ImpInt'              ;;;;Dialogo.Radio2=0 y Not [EqStr(Dialogo.TipoOp1,'MMPCOS') Y Dialogo.Radio5=1];Dialogo.Radio2=0 y Not [EqStr(Dialogo.TipoOp1,'MMPCOS') Y Dialogo.Radio5=1];[Not [EqStr(Dialogo.TipoOp1,'MMPCOS') Y Dialogo.Radio5=1] y Incluido(Fstr(Dialogo.Precio6,2,4),VAR('TASAINT'))] o [EqStr(Dialogo.TipoOp1,'MMPCOS') Y Dialogo.Radio5=1];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;;;;;"###.####"
  Precio7      : 'Tasa Int WH'              ;;;;Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS');Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS');Dialogo.Precio7>0;'El Valor de Tasa Int WH es Invalido';NO;;BuscarCampo('Operaciones','Precio1+Spread','NrOperacion',Dialogo.NrOperacion1);;
  Precio8      : 'Tasa Int IVA'             ;;;;[Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS')] o [Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCL') y Dialogo.Radio3=1];[Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCOS')] o [Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPCL') y Dialogo.Radio3=1];Dialogo.Precio8>0;'El Valor de Tasa IVA es Invalido';NO;;BuscarCampo('Operaciones','Precio1+Spread','NrOperacion',Dialogo.NrOperacion1);;
  NrOperacion3 : "Op.Participa"             ;;;;;;;;;;SQL("Select NrOperacion from "~DBO~".OPERACIONES where NrOperacion2='"~Dialogo.NrOperacion1~"' and Cliente1='"~Dialogo.Cliente1~"' and TipoOp='"~Dialogo.TipoOp1~"' and RB6="~FStr(IIF(EqStr(Dialogo.TipoOp1,'MMPCL'),Dialogo.Radio3,Dialogo.Radio5),0,0)~" ORDER BY NrOperacion DESC ");;;;"NrOperacion2='"~Dialogo.NrOperacion1~"' and Cliente1='"~Dialogo.Cliente1~"' and TipoOp='"~Dialogo.TipoOp1~"' and RB6="~FStr(IIF(EqStr(Dialogo.TipoOp1,'MMPCL'),Dialogo.Radio3,Dialogo.Radio5),0,0)~" ";
  Radio4       : 'Pmo.|Local|Extranjero'    ;2;2;;NO;NO;;;;;IIF(EQSTR(BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Vehiculo1),BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
  Fecha2       : "FechaOp"                  ;1;1;;NO;NO;;;;;BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

If Not Ok
   Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo
ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
Else
   If Dialogo.Radio2=1 
      * Verifico que se encuentre en Back Office o Terminal
      ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion3~"' AND Valor='1'") )

      If VAL(X1)<>20 y VAL(X1)<>50
         *-- Busco la instancia actual
         Cancelar('La Operacion Participante '~Dialogo.NrOperacion3~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
      EndIf
   EndIf
EndIf

* Si el Cliente ya participa Verifico las instancias de la Operacion  Participante
If Ok
   acn (j1,0)
   If NoVacio(Dialogo.NrOperacion3) y Dialogo.Radio2=1
      *-- SI NO EXISTE LA TOMADORA GENERA NUEVA OPERACION
      SQL.ADD("Select 1 from "~DBO~".OPERACIONES ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
      Recorrer SQL
         acn (j1,1)
      Proximo  
   EndIf
  
   *- Modificando operacion original
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set PrecioEj=PrecioEj-"~FStr(Dialogo.Cantidad2,0,2)~", ")
   SQL.ADD("    Cantidad=Cantidad-"~FStr(Dialogo.Cantidad2*Dialogo.Cantidad1/Dialogo.Cantidad1,0,2)~", ")
   SQL.ADD("    TotalComisiones=TotalComisiones-"~FStr(Dialogo.Cantidad2*BuscarCampo('OPERACIONES','TotalComisiones','NrOperacion',Dialogo.NrOperacion1)/Dialogo.Cantidad1,0,2)~" ")
   SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.EXEC

   SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and ")
   SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
   SQL.NEW
   SQL.EXEC

   EjecutarEvento('PRPRUN',NrOperacion1=Dialogo.NrOperacion1,Cantidad2=0)

   EjecutarEvento('INCOMV',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=Dialogo.NrOperacion1,String=" 1=1 ",String1=" Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' " )

   * Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
   SQL.EXEC

   *- Recalculo ttn de operacion item y Cabecera
   EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion1,Entero1=0,NrOperacion2='',Lista1='')

   IF val(j1)=0

      Message('Generando la Nueva Operacion   .... ')          

      EjecutarEvento('INSEVI',NrOperacion1=Dialogo.NrOperacion1,TipoOp1=Dialogo.TipoOp1,String="FechaOp='"~IdxDate(Dialogo.Fecha4)~"',Cliente1='"~Dialogo.Cliente1~"',PrecioEj="~FStr(Dialogo.Cantidad2,0,2)~",Cantidad="~FStr(Dialogo.Cantidad2,0,2)~",ImpGastos2="~FStr(Dialogo.Precio5,0,8)~",TotalAux1="~FStr(Dialogo.Precio4,0,8)~",TasaImp1="~FStr(Dialogo.Precio6,0,8)~",",Vehiculo1=Dialogo.Vehiculo1,Vehiculo2=Dialogo.Vehiculo1,String1="Plazo="~Fstr(Dialogo.Fecha1-Dialogo.Fecha2,0,0)~",FechaOp2='"~IdxDate(Dialogo.Fecha3)~"',TotalAux4="~Fstr(Dialogo.Precio7,0,8)~",TotalAux2="~Fstr(Dialogo.Precio8,0,8)~",TotalComisiones=TotalComisiones-"~FStr(Dialogo.Cantidad2*BuscarCampo('OPERACIONES','TotalComisiones','NrOperacion',Dialogo.NrOperacion1)/Dialogo.Cantidad1,0,2)~",NrOperacion2='"~Dialogo.NrOperacion1~"' ")

      ACT(z3,BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',Dialogo.NrOperacion1) )

      *- Deja el nro. de operacion nueva en NrOperacion3
      EjecutarEvento('PRPRUN',NrOperacion1=val(z3),Cantidad2=0)

  Else 
      Message('Existe la Entidad en otra Operacion ')

      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set Cantidad=Cantidad+"~FStr(Dialogo.Cantidad2,0,2)~",")
      SQL.ADD("    PrecioEj=PrecioEj+"~FStr(Dialogo.Cantidad2,0,2)~", ")
      SQL.ADD("CantidadOri=CantidadOri+"~FStr(Dialogo.Cantidad2,0,2)~" ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
      SQL.NEW

      SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' and ")
      SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
      SQL.NEW
      SQL.EXEC

      ACT(i3,Dialogo.NrOperacion3)
      ACT(Z3,VAL(I3))
      (.'MODIINSTAN'.)      

      *- Deja el nro. de operacion nueva en NrOperacion3
      EjecutarEvento('PRPRUN',NrOperacion1=val(z3),Cantidad2=0)
   Endif

   EjecutarEvento('TTNOP',NrOperacion1=VAL(z3),Entero1=0,NrOperacion2='',Lista1='')

   If Val(x1)=0
      Cancelar('La Operacion No '~Dialogo.NrOperacion1~' No pudo Desdoblarse')
   endif

EndIf
