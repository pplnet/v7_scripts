creardialogo
fecha1:'Fecha';;;;NO;;;;;;FSys()
nroperacion1: 'CONU';;;;;;;;;;;;;;"TipoOp In ('CONU') and   FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' and (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1)  and CB2=1"
vehiculo1:'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
fecha4:'Pri mes';;;;NO;NO;;;;;PriDeMes(dialogo.fecha1, NO, 'ARG')
fecha2:'Fecha 1Mes';;;;NO;NO;;;;;PriDeMes(Habiles(dialogo.fecha1, -1, 'ARG', SI), SI)
fecha3:'Fecha FMes';;;;NO;NO;;;;;FinDeMes(Habiles(dialogo.fecha1, -1, 'ARG', SI), SI)

findialogo

if (not ok)
Cancelar()
endif

sql.add(" Select * From ")
sql.add(" (Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, CB1, FechaVto, ")
sql.add("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',1)) as Saldo, ")
sql.add("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',2)) as Utilizado ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" where (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1) and CB2=1 ")
sql.add("   and O.NrOperacion = OB.NrOperacion ")
sql.add("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")
if (NoVacio(dialogo.nroperacion1))
sql.add("  and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif

sql.add("and TipoOp in ('CONU') ) as Aux")
sql.add(" Where Saldo > 0  ")
Watch(sql.batch)

recorrer sql

Acn(a:fac, 1)
Act(b:fac, Fbn()['NrOperacion'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Especie'])
Acn(e:fac, Fbn()['Cantidad'])
Act(f:fac, Fbn()['FechaOp'])
if (Fbn()['CB1'] = 1)
Act(g:fac, '')
else
Act(g:fac, Fbn()['FechaVto'])
endif
Act(h:fac, Fbn()['Book1'])
Acn(i:fac, Fbn()['Saldo'])
Acn(j:fac, Fbn()['Utilizado'])
Acn(k:fac, Fbn()['Saldo'])
Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';'Cancelacion Total/Parcial ICL - CONU'
'Accion ?';a:1..a:fac;SI;;;60;combo;'Ok|Rechaza'
'Operacion';b:1..b:fac;NO;;;70;string;;
'Cliente';c:1..c:fac;NO;;;70;string;;
'Especie';d:1..d:fac;NO;;;70;string;;
'Monto Original';e:1..e:fac;NO;;;100;numero;'##,###,###,###.##';
'Fecha Op';f:1..f:fac;NO;;;80;string;;
'Fecha Vto';g:1..g:fac;NO;;;80;string;
'Book';h:1..h:fac;NO;;;60;string;
'Imp. utilizado';j:1..j:fac;NO;;;100;numero;'##,###,###,###.##';
'Saldo Capital';i:1..i:fac;NO;;;100;numero;'##,###,###,###.##';
'Imp. a Cancelar';k:1..k:fac;Val(a:flb) = 0;Val(k:flb) <= Val(i:flb);'El importe a Cancelar es Mayor al Dispionible';100;numero;'##,###,###,###.##';RGB(175, 200, 228)
finlistbox

if (not ok)
Cancelar()
endif

if (ok)
recorrer&i 1, Fac()
if (Val(a:&i) = 0)
Acn(ct:1, sql("Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion='"~Val(b:&i)~"' ") + 1)

Message('Generando CUOTA Precancelacion ... ')
sql.add(" INSERT INTO "~Dbo()~".CUOTAS ( ")
sql.add(" NrOperacion, NrCuota, Radio1, Fecha1, Cantidad1, Cantidad2, NrOperacion1 ")
sql.add(" ) VALUES ( ")
sql.add(" '"~Val(b:&i)~"', "~Val(ct:1)~",  '4', '"~IdxDate(dialogo.fecha1)~"', "~FStr((-1 * Val(k:&i)), 0, 2)~", "~FStr(0, 0, 2)~",'"~Val(b:&i)~"'")
sql.add(" ) ")
sql.new
sql.exec
endif
proximo
endif
