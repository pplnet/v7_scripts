*** Lee de la tabla OPSIOPEL lo que esta procesado de Tipo de Negociacion 
*** de Garantizadas Var('TIPONEGCPC') y Ruedas de Garantizadas Var('RUECPC1')
*** donde la operacion no fue encontrada 'NOTFOUND'

CrearDialogo
  Check1: 'Procesa';1;1; ;SI;SI;;;;0;
FinDialogo

if Not OK
  Cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

SQL.ADD(" Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoNego          in ("~Pipe2Comillas(Var('TIPONEGCPC'))~") ")
SQL.ADD("    and CodigoRueda         in ("~Pipe2Comillas(Var('RUECPC1'))~")    ")
SQL.ADD("    and CodigoRegistro      in ('0105','0205','7020')                 ")
SQL.ADD("    and NrOperacion         = 'NOTFOUND'                              ")
SQL.ADD("    and Fecha               = '"~IdxDate(Fsys)~"'                     ")
SQL.ADD("    and Carga       = '1'                                             ")
SQL.ADD("    and Procesado   = '1'                                             ")
watch(SQL.Batch)
Recorrer SQL
      
   ACT(a:1,'')
   If EqStr(fbn('CodigoRegistro'),'0205')
      ACT(a:1, SQL("Select NrOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaCpra')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
   Else
      If EqStr(fbn('CodigoRegistro'),'0105')
         ACT(a:1,  SQL("Select NrOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaVta')~"'   and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
      else
         ACT(a:1,  SQL("Select NrOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('NroAltaMAE')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"' "))
      endif
      
   Endif
   
   If Novacio(Val(a:1)) y Dialogo.Check1=1
      ** actualizar Carga y Procesado para volver a tomarlo
      SQL.ADD("Update "~DBO~".OPSIOPEL ")
      SQL.ADD("   Set Procesado   = '0',")
      SQL.ADD("       Carga       = Null, ")
      SQL.ADD("       NrOperacion = '' ")
      SQL.ADD(" where NroAltaMAE  ='"~fbn('NroAltaMAE')~"'  and Fecha = '"~IdxDate(fbn('Fecha'))~"' ")
      SQL.NEW
      SQL.EXEC
      
   Endif

   
Proximo