* - Actualiza Saldo Disponible en Operacion Cabecera de un Sindicado
* - cuando se elimina operacion item
* - Parametros que llegan al Evento (que es llamado por la funcion INSTOPE)
* - NrOperacion1 = OperacionRef (Proviene del Proceso sobre el ITEM o Fondista )
* - CANTIDAD1 = MONTO A PROCESAR EN EL CABECERA (VARIABLE VCAN3 DE MMSIMV = TotalBrutoCliente2 del Item)

CrearDialogo
NrOperacion1: "NrOper.Cab."      ;;;;SI;;;;;;;;;;" TipoOp Like 'MM%' "
Cantidad1   : "Monto Afect"      ;;;;SI;;;;;
Radio1      : "Show Actividad|SHOW|No";;;;Si;;;;;;0
FinDialogo

IF Not OK
   Cancelar
EndIf
*  Nr Oper.Cabecera (OperacionRef del Item)
act(a:fac, Dialogo.NrOperacion1)
*  Cantidad de Afectacion (Llega desde Variable Vcan3 x la Funcion INSTOPE de MMSCMV)  
acn(z:fac, Dialogo.Cantidad1)
** Cabecera Utilizado ANTES del Update    
ACN(b:Fac,BuscarCampo('Operaciones','TotalBrutoCli2','NrOperacion',val(a:FAC)) )
** Cabecera Disponible ANTES del Update     
ACN(c:Fac,BuscarCampo('Operaciones','TotalNetoCli3','NrOperacion',val(a:FAC)) )  
*   
*  Mensajes de Testeo
*  MessageBox('NrOPERACIONES Cabecera = '~val(a:fac))          
*  MessageBox('CANTIDAD X VARIABLE = '~val(z:fac))  
*         
  
SQL.ADD(" Update  "~DBO~".OPERACIONES  set  ")
SQL.ADD(" TotalBrutoCli2 = TotalBrutoCli2 - '"~val(z:fac)~"', ")
SQL.ADD(" TotalNetoCli3  = TotalNetoCli3  + '"~val(z:fac)~"' ")
SQL.ADD("Where NrOperacion = '"~val(a:FAC)~"' ")
SQL.NEW
SQL.EXEC
** Cabecera Utilizado luego del Update
ACN(d:Fac,BuscarCampo('Operaciones','TotalBrutoCli2','NrOperacion',val(a:FAC)) ) 
** Cabecera Disponible luego del Update 
ACN(e:Fac,BuscarCampo('Operaciones','TotalNetoCli3','NrOperacion',val(a:FAC)) )     
       
  
IF Dialogo.Radio1=0
   MessageBox('*-- Actualizando Disponibles en Prestamos Sindicados')
   MessageBox('Cabecera: Utilizado = ' ~val(b:fac)~'...Disponible = '~val(c:fac))
   MessageBox('Monto Neto a Bajar VCAN de Funcion = ' ~val(z:fac))
   MessageBox('Cabecera Update: Utilizado = ' ~val(d:fac) ~'Disponible = '~val(e:fac))
   MessageBox('Neto = Monto Test a Procesar (Manual) = ' ~Dialogo.Cantidad1)
EndIf
   
  