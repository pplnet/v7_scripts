MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif

let &usaPartidas 'NO'
(.'BOOKPARTID'.)
Recorrer SQL
    let &usaPartidas 'SI'
    let &bookPartidas &bookPartidas~fbn('Books')    
Proximo

let &bookTRD Var('BOOKTRD')

ACT(TA:1, Var('TIPASICORT'))
ACN(BD:1,0)
SQL.ADD(" Select T.NrTrans, T.Especie4 Moneda, T.Vehiculo1, T.Cupon1, T.Fecha1, T.Precio2 PorRenta, T.Precio1+T.Precio3 PorAmort, ")
SQL.ADD(" MA.Codigo CodAsi, T.Cambio2 VT, T.Especie Especie, 'TIC' TipoOp, '' Concepto, ")
SQL.ADD(" T.Especie4 ContraEspecie, T.Especie2 EspecieCupon, E.MonedaEmision, E.Tipo TipoEspecie, ")
SQL.ADD(" E.Issuer, E.Fecha FMaduracion, T.Fecha1 FCorte, '' Concepto, E.VTeorico, T.Cupon1 CuponAnt, T.Cupon2 CuponActual, Cliente1 Cliente ")
** C.CategDepositante
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON T.TipoTr2 = MA.TipoTr2  ") 
SQL.ADD("       INNER JOIN dbo.ESPECIES E ON E.Codigo  = T.Especie ")
SQL.ADD(" Where T.TipoTr2 = 'CUPON' ")
SQl.ADD(" AND MA.Codigo = 'CUPONCORT' ")
SQL.ADD(" AND T.FechaCargaSys = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND T.NrTrans IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" ORDER BY T.NrTrans ")
watch(SQL.batch)
ACT(NT:1,'')
ACT(CU:1,'')

Recorrer SQL
    let &nrCupon fbn('NrTrans')
    let &porRenta fbn('PorRenta')
    let &porAmort fbn('PorAmort')
    let &especie fbn('Especie')
    let &especieCupon fbn('EspecieCupon')
    let &fechaMaduracion fbn('FMaduracion')
    let &fechaCorte fbn('FCorte')
    let &VTeorico fbn('VTeorico')
    let &codAsi fbn('CodAsi')  
    let &cuponActual fbn('CuponActual')
    let &cliente fbn('Cliente')
    
    ACT(NR:1, '')
    ACT(NR:2, fbn('NrTrans'))
    ACT(TO:1, fbn('CodAsi'))
    ACT(TI:1, '')      
    ACT(NT:1,fbn('NrTrans')) 
    ACD(FV:1, fbn('Fecha1'))
    ACT(VH:1, fbn('Vehiculo1'))    
    ACT(CE:1, fbn('ContraEspecie'))
    ACT(ME:1,fbn('MonedaEmision'))
    ACT(TE:1,fbn('TipoEspecie'))  
    ACT(EP:1,fbn('Especie'))          
    ACT(IS:1,fbn('Issuer'))
    ACT(MN:99, fbn('Moneda'))
    ACT(CO:1,fbn('Concepto'))      
    
    **TERCEROS
    **Tomamos los VN de los MOVEJECUTADOS (cupon nuevo) de terceros de la CUPON
    **NO HACER CORTE DE CONTROL
    SQL.ADD("Select Sum(Cantidad) Saldo, Cuenta CuentaCustodia from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("Where NrOperacion = '"~&nrCupon~"' ")
    SQL.ADD("AND Cliente <> Vehiculo ")
    SQL.ADD("Group By Cuenta ")
    *SQL.ADD("AND Cupon = ? ")
    Recorrer SQL
        ACT(BK:1,'')
        ACT(CU:1,fbn('CuentaCustodia'))   
        let &saldo fbn('Saldo')
        (.'CALCRENAMO'.)   
    Proximo
    
    **Renta para 3er
    ACN(RT:2:2, &renta)
    **Amortizacion para 3er
    ACN(AT:2, &amort)     

    **Genero asiento para 3er
    (.'GENASCORTE'.) 
        
    
    **CARTERA PROPIA
    **Debemos tomar los VN de los MOVPOSEJE (cupon nuevo) de la ACUPON separados por book. NrSaldo 122 y books cuyo modelo de negocio no sea partidas.
    **Mas los VN de los MOVPOSEJE (cupon viejo) de la CUPON. Esto para los casos de contado inmediato.    
    **HACER CORTE DE CONTROL POR CUENTACUSTODIA y BOOK, EXCLUIR BOOKS de partidas
    
    **MOVPOSEJE de ACUPON
    SQL.ADD("Select Sum(MP.Cantidad) Saldo, MP.Book, MP.Estrategia CuentaCustodia from ( ")
    SQL.ADD("Select M.Cantidad, M.Book, M.Estrategia CuentaCustodia from ")
    SQL.ADD("   "~DBO~".MOVPOSEJE M JOIN "~DBO~".TRANSACCIONES2 T ON  M.NrOperacion = T.NrTrans ")
    SQL.ADD(" where ")
    SQL.ADD(" T.TipoTr ='ACUPON' ")
    SQL.ADD(" AND T.Cupon1 = "~&cuponActual~" ")
    SQL.ADD(" AND T.Cupon2 = "~&cuponAnt~" ")
    SQL.ADD(" AND T.Especie1 = '"~&especie~"' ")
    SQL.ADD(" AND T.Especie2 = '"~&especieCupon~"' ")
    SQL.ADD(" AND M.NrSaldo = "~Fstr(Var('SALDOPOCON'), 0, 0)~" ")
    SQL.ADD(" AND M.Book NOT IN ("~Pipe2Comillas(&bookPartidas)~")")
    *SQL.ADD("AND Cupon = ? ")
    **MOVPOSEJE de CUPON
    SQL.ADD("Select sum(M.Cantidad) Saldo, M.Book, M.Estrategia CuentaCustodia from ")
    SQL.ADD("   "~DBO~".MOVPOSEJE M ")
    SQL.ADD(" where ")
    SQL.ADD(" AND M.NrOperacion = '"~&nrCupon~"'") 
    SQL.ADD(" AND M.Book NOT IN ("~Pipe2Comillas(&bookPartidas)~")")   
    *SQL.ADD("AND Cupon = ? ")
    SQl.ADD(" )MP ")
    SQL.ADD("GROUP BY MP.Book, MP.Estrategia")
    Recorrer SQL
        ACT(BK:1,fbn('Book'))
        ACT(CU:1,fbn('CuentaCustodia'))     
        let &saldo fbn('Saldo')
        (.'CALCRENAMO'.) 
        
        **Renta para CP
        ACN(RC:2, &renta)
        **Amortizacion para CP
        ACN(AC:2, &amort)   
        
        **Genero asiento para CP
        (.'GENASCORTE'.)       
    Proximo
    

Proximo
