modoreproceso(condialogo)
creardialogo
operador1: 'Usuario';;;;;;;;;;;;;;
check1: 'Procesa';;;;NO;NO;;;;1
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

Sqladd(" SELECT DISTINCT A.*, U.Nombre, U.FAcceso, U.Perfil ")
Sqladd(" FROM "~Dbo()~".USUARIOS U, "~Dbo()~".USUARIOSACTIVOS A ")
Sqladd(" WHERE  A.Codigo  = U.Codigo ")
if (NoVacio(dialogo.operador1))
Sqladd("   AND  A.Codigo  = '"~dialogo.operador1~"' ")
endif
Sqladd(" ORDER BY A.Codigo  ")

SetFilaActual(1)
Act(a:fac, 'Codigo')
Act(b:fac, 'Nombre')
Act(c:fac, 'Perfil')
Act(d:fac, 'F.Acceso')
Act(e:fac, 'IP')
Act(f:fac, 'Desblouea')
SetFont(a:fac..f:fac, 2)

Acn(z:1, 0)
recorrer sql
Scn(z:1, 1)
Act(a:fac, Fbn('Codigo'))
Act(b:fac, Fbn('Nombre'))
Act(c:fac, Fbn('Perfil'))
Acd(d:fac, Fbn('FAcceso'))
Act(e:fac, Fbn('IP'))
Acn(f:fac, 0)
proximo
if (Val(z:1) = 0)
if (NoVacio(dialogo.operador1))
Messagebox('El Usuario '~dialogo.operador1~' no esta activo')
else
Messagebox('No existen Usuarios Activos')
endif
if (dialogo.check1 = 1)
Cancelar()
else
Acn(z:2, 1)
endif
endif

if (Val(z:2) = 0)
crearlistbox;'MS Sans SerIf,8,'
'Desbloquea';f:2..f:fac;SI;SI;;70;check
'Codigo';a:2..a:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Nombre';b:2..b:fac;NO;SI;;150;string;;RGB(232, 232, 255);
'Perfil';c:2..c:fac;NO;SI;;70;string;;RGB(232, 232, 255);
'F.Acceso';d:2..d:fac;NO;SI;;70;fecha;RGB(232, 232, 255);
'IP';e:2..e:fac;NO;SI;;100;string;;RGB(232, 232, 255);
finlistbox

if (not ok)
if (dialogo.check1 = 1)
Cancelar('Evento Cancelado.')
else
Messagebox('Evento Cancelado. No Procesa')
Acn(z:2, 1)
endif
endif
endif

if (Val(z:2) = 0)
recorrer&i 2, Fac()
if (Val(f:&i) = 1)
Message('Desbloqueando Usuario...')
if (dialogo.check1 = 1)
Sqladd(" Delete "~Dbo()~".USUARIOSACTIVOS ")
Sqladd("  where Codigo = '"~Val(a:&i)~"' ")
Sqlnew()
Sqlexec()
endif
endif
proximo
Messagebox('Evento finalizo correctamente')
endif

ACO(2, 15)
ACO(5, 10)

