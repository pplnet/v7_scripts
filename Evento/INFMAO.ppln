Sqladd("SELECT OB.*, OB.NrBit Inst, ")
Sqladd("       ORD.Cliente,   ORD.TipoOrden,    ORD.NrOrden,      ORD.Mercado,       ORD.CantidadTotalOrden,  ")
Sqladd("       ORD.Cantidad1, ORD.PrecioLimite, ORD.Especie,      ORD.ContraEspecie, ORD.FechaOrden,          ")
Sqladd("       ORD.FechaVto,  ORD.NroAltaMAE,   ORD.FechaAltaMAE, ORD.Lotes PlazoOr, ORD.FechaLimite,         ")
Sqladd("       ORD.Direccion, ORD.Cuenta1,      ORD.Vehiculo,     ORD.Cupon1,        ORD.NrOperacion1 , ")
Sqladd("       ORD.RuedaMAE,  ORD.RB7,          ORD.RB5,          ORD.PrecioLimite,  ORD.RB9,                 ")
Sqladd("       ORD.RB10,      ORD.RB6,          ORD.Leyenda5,      ORD.Leyenda6,     ORD.Cantidad2            ")
Sqladd("  FROM "~Dbo()~".OPERACIONESBITS OB, "~Dbo()~".ORDENES ORD  ")
Sqladd(" Where ORD.NrOrden = OB.NrOperacion ")
Sqladd("   and ( OB.NrBit in (160) ) ")
Sqladd("   AND ( OB.Valor = '1' )  ")
Sqladd("   AND ORD.TipoOrden in ('OTIC','OTIV') ")
Sqladd("ORDER BY OB.NrOperacion ")
