Sqladd("  or (O.TipoOp In ('CTE','VTE') and CB6 = '1') ")
Sqladd("  or (O.TipoOp In ('CTP','VTP') and CB10 = '1')) ")
Sqladd(" and  RB4 = '1'  ")
Sqladd(" order by O.TipoOp ")

