Sqladd("SELECT Distinct T.NrTrans, T.TipoTr2, T.Fecha1, T.Cliente1, T.Cliente2, ")
Sqladd("       T.Cuenta1, T.Cuenta2, T.Especie, T.Cantidad1, T.Precio1, T.Cambio1, ")
Sqladd("       T.Mercado1, T.CB6, T.NrOperacionRef1, T.CB1, T.CB2, M.NrOperacion,CT1.NrDepositante as NrDepositante1 ")
Sqladd("FROM   "~Dbo()~".MOVPENDIENTES M WITH (NOLOCK index = INDMP1), "~Dbo()~".TRANSACCIONES2 T, ")
Sqladd("       "~Dbo()~".CUENTAS CT1,"~Dbo()~".OPERACIONESBITS OB  ")
Sqladd("WHERE  M.NrOperacion = T.NrTrans ")
Sqladd("       and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("       and OB.NrOperacion=T.NrTrans ")
Sqladd("       and T.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd("       and T.TipoTr2  IN ('DTP','RTP','DRT') ")
Sqladd("       and CT1.Codigo  = T.Cuenta1 ")
Sqladd("       and (T.CB6 <> '1' or T.CB6 is null) ")
if (NoVacio(dialogo.lista1))
Sqladd("       and T.Mercado1 In ("~Pipe2Comillas(dialogo.lista1)~")  ")
endif
if (NoVacio(dialogo.lista2))
Sqladd("    AND T.Especie IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista3))
Sqladd("    AND T.Especie Not IN ("~Pipe2Comillas(dialogo.lista3)~") ")
endif
Sqladd("       and OB.NrBit=1 and OB.Valor='1' ")
Sqladd("       and M.NrSaldo = "~FStr(Val(a1), 0, 0)~" ")
Sqladd("ORDER BY T.Fecha1,T.Especie,CT1.NrDepositante,T.Cuenta2  ")

