creardialogo
nroperacion1:'NrOperacion Nueva'
nroperacion2:'NrOperacion Vieja'
findialogo

if (Vacio(dialogo.nroperacion1))
Messagebox(" ­Atenci¢n!. La minuta no puede renovar. ")
else
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" set RB6 = '1' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

if (not Eqstr(dialogo.nroperacion1, dialogo.nroperacion2))
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" set RB6 = '0' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion2~"' ")
Sqlnew()
Sqlexec()
endif
endif


