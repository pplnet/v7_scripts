HojaVisible(NO)

creardialogo
fecha1: "F.Acred.Desde";;;;;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;FSys()
fecha2: "F.Acred.Hasta";;;;;;dialogo.fecha2 <> 0;'Debe Ingresar la Fecha';NO;FSys()
lista1: "Nro. Datanet";;;;;;;;;;;SQLSet(" Select NrDatanet From "~Dbo()~".DATANET ");
lista2: 'Bancos';-3;2;;;;;;;;;SQLSet(" Select Distinct Banco   From "~Dbo()~".MOVDATANET ");
lista3: 'Cuentas';;1;;;;;;;;;SQLSet(" Select Distinct Cuenta  From "~Dbo()~".MOVDATANET  ");
lista4: 'Conceptos';-8;2;;;;;;;;;SQLSet(" Select Distinct TipoMov From "~Dbo()~".MOVDATANET ");
findialogo

if (not ok)
Cancelar()
endif




sql.add(" Select * from "~Dbo()~".DATANET ")
sql.add(" where  NrDatanet  IN ("~pipe2comillas(dialogo.lista1)~")  ")

sql.add("order by FechaBajada, Archivo")

recorrer sql

Act(a:fac, Fbn()['NrDatanet'])
Act(b:fac, Fbn('FechaBajada'))
Act(c:fac, Fbn()['Archivo'])
Act(d:fac, Fbn()['FechaDesde'])
Act(e:fac, Fbn()['FechaHasta'])
Act(f:fac, Fbn()['Usuario'])
Act(g:fac, Fbn('Estado'))
Act(h:fac, Fbn('EstadoAprobacion'))
Act(i:fac, Fbn('FechaAprobacion'))
Act(j:fac, Fbn()['Supervisor'])

Acn(z:fac, 1)

proximo

if (Fac() > 0)
crearlistbox;'Arial,10,B'
'Elimino';z1..k:fac;SI;SI;;70;combo;'Si|No|'
'Nr.Datanet';a1..a:fac;NO;SI;;70;string
'Fec.Bajada';b1..b:fac;NO;SI;;70;string
'Archivo';c1..c:fac;NO;SI;;70;string
'Fec.Desde';d1..d:fac;NO;SI;;70;string
'Fec.Hasta';e1..e:fac;NO;SI;;80;string
'Usuario';f1..f:fac;NO;SI;;90;string
'Estado';g1..g:fac;NO;SI;;80;string
'Est.Apr.';h1..h:fac;NO;SI;;90;string
'Fec.Apr.';i1..i:fac;NO;SI;;100;string
'Supervisor';j1..j:fac;NO;SI;;70;string

finlistbox

if (ok)
recorrer&i 1, Fac()
if (Val(z:&i) = 0)
sql.add("Delete from "~Dbo()~".MOVDATANET  ")
sql.add("where NrDatanet  = '"~Val(a:&i)~"'  ")
sql.add("   and FechaAcreditacion >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   and FechaAcreditacion <= '"~IdxDate(dialogo.fecha2)~"' ")
if (NoVacio(dialogo.lista2))
sql.add(" AND Banco  IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND Cuenta  IN ("~pipe2comillas(dialogo.lista3)~")  ")
endif
if (NoVacio(dialogo.lista4))
sql.add(" AND Tipomov  IN ("~pipe2comillas(dialogo.lista4)~")  ")
endif
sql.new
sql.exec
Message('Eliminación Exitosa ')
Message('                    para: '~Val(a:&i)~Val(c:&i))
endif
proximo
else
Cancelar()
endif
else
Messagebox('No existen transacciones para la seleccion')

endif


