CrearDialogo
    NrTrans1  :'Transaccion'   ;
    String1   :'Forma de Pago' ;
FinDialogo

IF Not OK
   Cancelar
ENDIF

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('TRANSACCIONES2', 'Vehiculo1', 'NrTrans', Dialogo.NrTrans1))

(.'CONTROLVH'.)

SQL.ActualizarMovimientosT3(Dialogo.NrTrans1, SI, NO, NO, NO, NO)

IF Eqstr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Dialogo.String1), 'CHE')
    SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
    SQL.ADD(" Set Chequera1 = Null, ")
    SQL.ADD(" Cantidad2 = Null ")
    SQL.ADD(" Where NrTrans = '"~Dialogo.NrTrans1~"' ")
    SQL.NEW
    SQL.EXEC
ENDIF
