**HojaVisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif

ACT(ML:1, Var('MONELOCA'))
ACD(FV:1, Dialogo.Fecha1)
let &fechaProceso Fecha(Dialogo.Fecha1)
let &tablaInformada 'EFECTIVOMINIMOCRYL'

****ELIMINO CORRIDAS ANTERIORES****
(.'ELREGINFOR'.)

let &nrOperacion ''

SQL.ADD("Select EnteCustodia Vehiculo1, Especie, S.Book, Cuenta CuentaCustodia,'' Concepto, Saldo ")
SQL.ADD("from "~DBO~".SALDOSDIA S ")
SQL.ADD("JOIN "~DBO~".CUENTAS C ON S.Cuenta = C.Codigo")
SQL.ADD("Where C.Cliente = '"~Dialogo.Vehiculo1~"' ")
**Cuentas que tengan nueva marca "Efectivo Minimo Cryl"
SQL.ADD("AND C.EsEfMiCr = 'SI' ")
SQL.ADD("AND S.NrSaldo = 101 ")
SQL.ADD("AND S.Mercado = '"~VAR('MERCACRYL')~"'")
SQL.ADD("AND S.Cliente ='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("AND "~DBO~".DesciendedeEspecie(S.Especie,'TITULO')=1  ")
SQL.ADD("AND S.Fecha = (SELECT Max(S1.Fecha) FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("              WHERE S1.Cliente = S.Cliente ")
SQL.ADD("              AND   S1.Especie = S.Especie ")
SQL.ADD("              AND   S1.Mercado = S.Mercado ")
*SQL.ADD("              AND   S1.Cupon   = S.Cupon   ")
SQL.ADD("              AND   S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("              AND   S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("              AND   S1.Cuenta  = S.Cuenta   ")
*SQL.ADD("              AND (S1.Book = S.Book or (S1.Book Is Null and S.Book Is Null) or (S1.Book='' and S.Book='')) ")
*SQL.ADD("              AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null) or (S1.CallPut='' and S.CallPut='')) ")
*SQL.ADD("              AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null) or (S1.FechaEj='' and S.FechaEj='')) ")
*SQL.ADD("              AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null) or (S1.PrecioEj='' and S.PrecioEj='')) ")
SQL.ADD("              and   IsNull(S.PrecioEj,0)      = IsNull(S1.PrecioEj,0) ")
SQL.ADD("              and   IsNull(S.FechaEj,0)       = IsNull(S1.FechaEj,0) ")
SQL.ADD("              and   IsNull(S.CallPut,'')      = IsNull(S1.CallPut,'') ")
*SQL.ADD("              and   IsNull(S.Cupon,'')        = IsNull(S1.Cupon,'') ")
SQL.ADD("              AND   S1.Fecha <= '"~IdxDate(Val(FV:1))~"' ) ")
SQL.ADD(" and Saldo <> 0 ")
SQL.ADD(" Group by EnteCustodia,Especie,S.Book,Cuenta, Saldo")
watch(sql.batch)

Recorrer SQL

     ACT(CC:1, fbn('CuentaCustodia'))
     ACT(BK:1, fbn('Book'))
     ACT(VH:1, fbn('Vehiculo1'))
     ACT(CO:1, fbn('Concepto'))
     ACN(CA:1, fbn('Saldo'))
     let &cuentaCustodia fbn('CuentaCustodia')
     
     ****Datos de especie para EFECTIVOMINIMOCRYL
     (.'TITGENESP'.)
        
     ****Campos para insertar en EFECTIVOMINIMOCRYL
     (.'TITGENCAMP'.)
     
     let &cuentaContable RelacionCuenta('','','','','TIC','','','','TITULO','',val(MS:1),'','','',val(TS:1),'',val(BK:1),#VEHICULO,,,,,,#CTACUSTODIA,#CONCEPTO)           

     let &tipoRegistro 'S'
     
     **-inserto datos en EFECTIVOMINIMOCRYL-**
     (.'INSREGINFO'.)
     
