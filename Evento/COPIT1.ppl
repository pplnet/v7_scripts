*- COPMODITE: Copia de Itma de Modelos Contables
CrearDialogo
   ModeloAsiento1: 'Modelo Origen' ;;;;;;NoVacio(Dialogo.ModeloAsiento1);'Elegir un Modelo Origen';NO;;
   String       :  'Item Origen'          ;;;;;;NoVacio(Dialogo.String) y Num(Dialogo.String)>0;'Nro de Item debe ser mayor a cero';NO;;
   ModeloAsiento2: 'Modelo Destino';;;;;;NoVacio(Dialogo.ModeloAsiento2);'Elegir un Modelo Destino';NO;;
   String2      :  'Item Destino'         ;;;;;;NoVacio(Dialogo.String2) y Num(Dialogo.String2)>0 y Not Incluido(Dialogo.String2,SQLSET("Select NrItem FROM "~DBO~".MODELOSASIENTO1 Where Modelo  = '"~Dialogo.ModeloAsiento2~"' "));IIF(Num(Dialogo.String2)>0,'El Item '~Dialogo.String2~' ya existe en el Modelo '~Dialogo.ModeloAsiento2,'Nro de Item debe ser mayor a cero');NO;;SQL("SELECT Max(NrItem) + 1 FROM "~DBO~".MODELOSASIENTO1 Where Modelo  = '"~Dialogo.ModeloAsiento2~"'  ");
FinDialogo

If not Ok
  Cancelar
EndIf

If SQL("Select count(1) from "~DBO~".MODELOSASIENTO1 where Modelo  = '"~Dialogo.ModeloAsiento1~"' and NrItem = '"~Dialogo.String~"' ") = 0
   Cancelar('El Item '~Dialogo.String~' no pertenece al modelo '~Dialogo.ModeloAsiento1) 
EndIf

Message('Copiando Item en el Modelo '~Dialogo.ModeloAsiento2~'   ...')
                                     

SQL.ADD("INSERT INTO "~DBO~".MODELOSASIENTO1 ")
SQL.ADD("(Modelo,NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,Alias3,Detalle, ")
SQL.ADD(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3,  ")
SQL.ADD(" CC1,MN1,MN2,MN3,AL1,AL2,AL3,CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Book, Book1, Bk1)  ")
SQL.ADD("Select '"~Dialogo.ModeloAsiento2~"' Modelo, "~Dialogo.String2~" NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,'''"~Dialogo.String2~"''' Alias3,Detalle, ")
SQL.ADD(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3, ")
SQL.ADD(" CC1,MN1,MN2,MN3,AL1,AL2,AL3,CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Book, Book1, Bk1  ")
SQL.ADD("from "~DBO~".MODELOSASIENTO1 Where Modelo= '"~Dialogo.ModeloAsiento1~"' and NrItem = "~Fstr(num(Dialogo.String),0,0)~"  ")

SQL.NEW
SQL.EXEC

MessageBox('Copia Finalizada ')