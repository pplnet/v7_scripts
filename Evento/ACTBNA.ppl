MostrarCuadroDeMensajes
*                            Actualiza Cotiz. de Monedas desde Excel enviado por BNA
*                            Modifica Tablas CIERREBNA Y CIERREBCU
  
*Paso1 --PREPARA ARCHIVO DE SALIDA: TITULOS Y APERTURA DEL TXT
*  --    Fto File TXT = variable PATHLOG + Fecha + Hora + .TXT sobre NO1

ACT(OU:1, 'OK')
ACT(FG:1, 'Si')
act(ZZ:1, HORA(AHORA))
ACT(nr:2, copy(val(zz:1),1,2)~copy(val(zz:1),4,2)~copy(val(zz:1),7,2) )
acn(ze:1, Num(Copy(Fstr(Anio(Fsys), 4, 0), 3, 2)) ) 
acn(ze:2, Num(PAD0 (Copy(Fstr(MES(Fsys), 2, 0), 1, 2) ,2) ))
acn(ze:3, Num(PAD0 (Copy(Fstr(DIA(Fsys), 2, 0), 1, 2) ,2) )) 
ACT(nr:1, 'BNABLOO'~Pad0(Fstr(val(ze:3),0,0),2)~PAD0(Fstr(val(ze:2),0,0),2)~PAD0(Fstr(val(ze:1),0,0),2))
ACT(nr:3, '.TXT')
ACN(bd:7, 0)
ACN(tx:2, 0 )
ACT(fh:1, FECHA(HOY)~' '~HORA(AHORA)~' ACTBNA')
ACT(pn:2, VAR('PATHBNA')~VAR('BLOOMBNA'))

ACT(aa:1, VAR('PATHLOG')~val(nr:1)~val(nr:2)~val(nr:3))

IF Not ExisteDirectorio(Var('PATHBNA'))
   AbrirASCII(val(aa:1),0)
   If Val(bd:7)=0
      AbrirASCII(val(aa:1),0)  
      EscribirAscii(Val(fh:1))
      ACN(tx:2,6)
      (.'MENSAJETXT'.)
      ACN(bd:7, 1)
      CerrarAscii
      LinkearHoja('ERRCOT',1,String1=Val(aa:1),Radio1=1)
      Cancelar 
   Else 
      ACN(tx:2,6)
      (.'MENSAJETXT'.)
      CerrarAscii
      LinkearHoja('ERRCOT',1,String1=Val(aa:1),Radio1=1)
      Cancelar
   EndIf
ENDIF

*2 TRATAMIENTO ARCHIVO DE ENTRADA (EXCEL CON Datos BNA )
*--
ImportarXLS(a:2..g:1000, a:2..g:1000, Val(pn:2))


IF Not OK
   If Val(bd:7)=0
      AbrirASCII(val(aa:1),0)  
      EscribirAscii(Val(fh:1))
      ACN(tx:2,6)
      (.'MENSAJETXT'.)
      ACN(bd:7, 1)
      CerrarAscii
      LinkearHoja('ERRCOT',1,String1=Val(aa:1),Radio1=1)
      Cancelar 
   Else 
      ACN(tx:2,6)
      (.'MENSAJETXT'.)
      CerrarAscii
      LinkearHoja('ERRCOT',1,String1=Val(aa:1),Radio1=1)
      Cancelar
   EndIf
ENDIF

ACN(z2, 2)
ACN(z3, 1000)
SetFilaActual(2)
ACN(z5, fac) 


Recorrer&i Val(z2), Val(z3)
 IF Not CeldaVacia(A:&i) Y Not CeldaVacia(C:&i)
    *** Codigo Especie FPA
    ACT(a:fac, val(a:&i))
    *** Precio de Compra
    ACN(b:fac, val(b:&i))
    *** Precio de Venta       
    ACN(c:fac, val(c:&i))
    *** Unidad de Medida 
    ACN(d:fac, val(D:&i))
     *** Columna F
    ACT(f:fac, val(f:&i))
    ACT(es:1, Val(a:&i))
    *** Fecha 
    ACD(fe:1, IIF(NoVacio(val(g:&i)),val(g:&i),FSYS))


  
*3  Filtro de errores en el archivo de entrada (Base del TXT) 
*--
    If (Val(b:fac)+Val(c:fac)) <>0         
        * El Precio de Compra y el Precio de Venta estan en cero: No se procesa el dato 
    Else   
      ACT(FG:1, 'No')                  
      If Val(bd:7)=0
         AbrirASCII(val(aa:1),0)
         EscribirAscii(Val(fh:1))
         ACN(tx:2, 3)
         (.'MENSAJETXT'.)
         ACN(bd:7, 1)  
      Else
        ACN(tx:2,3)
        (.'MENSAJETXT'.)
      EndIf
    Endif
                                 *** Especie erronea
    ACN(x:9,SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(a:fac)~"'   "))
    If Val(x:9)<>1     
      ACT(FG:1, 'No') 
      If Val(bd:7)=0
         AbrirASCII(val(aa:1),0)
         EscribirAscii(Val(fh:1))
         ACN(tx:2, 1)
         (.'MENSAJETXT'.)
         ACN(bd:7, 1)
      Else
        ACN(tx:2,1)
        (.'MENSAJETXT'.)
      EndIf
    Endif

***   IF DesciendeDeEspecie(Val(a:fac),'MONEDA') y EsTerminal(Val(a:fac), Especie)
***   * No se controla que llegue Especie Moneda Exclusiva.
***   ACT(FG:1, 'No') 
***   ACN(tx:2, 1) 
***   Endif

*4  Actulizacion de TABLAS DE MONEDAS (CIERREBNA Y CIERREBCU):  Si coresponde Actualizar LLEGA FLAG EN "Si"
*--
    IF Eqstr(Val(F:fac), 'BCU')  y  EQSTR (Val(FG:1),'Si')       
        acn(x:5, SQL("SELECT 1 FROM "~DBO~".CIERREBCU WHERE Especie = '"~Val(a:fac)~"' AND Fecha = '"~IdxDate(Val(fe:1))~"'  "))
        if Val(x:5)=1
          SQL.ADD(" UPDATE "~DBO~".CIERREBCU SET ")
          SQL.ADD(" PrecioCompra  ="~FStr(Val(d:fac),1,8)~", ")               
          SQL.ADD(" PrecioVenta   ="~FStr(Val(c:fac),1,8)~"  ")               
          SQL.ADD(" WHERE Especie = '"~Copy(Val(a:fac),1,6)~"' AND Fecha = '"~IdxDate(Val(fe:1))~"' ") 
          SQL.NEW
          SQL.EXEC 
        Else    
       */Inserto  **  MESSAGEBOX('CIERREBCU Insert Registro en Tabla= '~Val(a:fac))
          SQL.ADD(" INSERT INTO "~DBO~".CIERREBCU ")
          SQL.ADD(" ( Especie, Fecha, PorCada, ")
          SQL.ADD("  PrecioCompra, PrecioVenta) ")
          SQL.ADD(" VALUES ")
          SQL.ADD(" ('"~Copy(Val(a:fac),1,6)~"','"~IdxDate(Val(fe:1))~"', 1, ")
          SQL.ADD("  "~FStr(Val(d:fac),1,8)~", "~FStr(Val(c:fac),1,8)~" )  ")
          SQL.NEW
          SQL.EXEC
        endIf        
    ELSE
        If EQSTR (Val(FG:1),'Si') 
           acn(x3, 0)
           acn(x3, SQL("SELECT 1 FROM "~DBO~".CIERREBNA WHERE Especie = '"~Val(a:fac)~"' AND Fecha = '"~IdxDate(Val(fe:1))~"'  "))           
           if Val(x3)=1
               */Actualizo **  MESSAGEBOX('ACTBNA: Registro Update en Tabla= '~Val(a:fac))
               SQL.ADD(" UPDATE "~DBO~".CIERREBNA SET ")
               SQL.ADD(" PrecioCompra  ="~FStr(Val(d:fac),1,8)~", ")               
               SQL.ADD(" PrecioVenta   ="~FStr(Val(c:fac),1,8)~", ") 
               SQL.ADD(" PorCada   = 1 ")               
               SQL.ADD(" WHERE Especie = '"~Copy(Val(a:fac),1,6)~"' AND Fecha = '"~IdxDate(Val(fe:1))~"' ")
               
           else    
               */Inserto  **  MESSAGEBOX('ACTBNA: Insert Registro en Tabla= '~Val(a:fac))            
               SQL.ADD(" INSERT INTO "~DBO~".CIERREBNA ")
               SQL.ADD(" ( Especie, Fecha, PorCada, Precio1, Precio2, ")
               SQL.ADD(" Precio3, Precio4, Precio5, PrecioCompra, PrecioVenta) ")
               SQL.ADD(" VALUES ")
               SQL.ADD(" ('"~Copy(Val(a:fac),1,6)~"', ")
               SQL.ADD(" '"~IdxDate(Val(fe:1))~"'  ")
               SQL.ADD(" , 1, 0,0,0,0, 0, "~FStr(Val(d:fac),1,8)~", "~FStr(Val(c:fac),1,8)~") ")
                
           ENDIF
           SQL.NEW
           SQL.EXEC
           ifa
        Else
        ACT(FG:1, 'Si')  
        ENDIF
    EndIf   

 ENDIF
Proximo
CerrarAscii


LinkearHoja('ERRCOT',1,String1=Val(aa:1),Radio1=1)

ACT(ME:1, Var('MONEEXTR'))
ACT(MU:1, Var('MONEURU'))
***---Genero cotizacion UYU en ARP
IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~Val(ME:1)~"' AND (CallPut='CON' or CallPut is Null) and Fecha = '"~IdxDate(Fsys)~"' ") = 1
    IF SQL(" Select 1 From "~DBO~".CIERREBCU Where Especie = '"~Val(ME:1)~"' AND Fecha = '"~IdxDate(Fsys)~"' ") = 1
        ***---Genero Cotizacion del UYU en ARP
        ACN(CT:1, CotizacionBNABCU(Var('MONEEXTR'),Fsys,1,NO,NO))
        IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~Val(MU:1)~"' AND (CallPut='CON' or CallPut is Null) and Fecha = '"~IdxDate(Fsys)~"' ") = 1
            SQL.ADD(" UPDATE "~DBO~".COTIZACIONES SET ")
            SQL.ADD(" Precio1 = "~Fstr(Val(CT:1),1,8)~", ")
            SQL.ADD(" Precio2 = "~Fstr(0,1,8)~", ")          
            SQL.ADD(" Precio3 = "~Fstr(0,1,8)~", ")
            SQL.ADD(" Precio4 = "~Fstr(0,1,8)~"  ")
            SQL.ADD(" Where Codigo = '"~Val(MU:1)~"' ")
            SQL.ADD(" AND (CallPut='CON' or CallPut is Null) ")
            SQL.ADD(" AND Fecha = '"~IdxDate(Fsys)~"' ")
            SQL.NEW
        ELSE
            SQL.ADD(" INSERT INTO "~DBO~".COTIZACIONES ")
            SQL.ADD(" (Fecha, Codigo, CallPut, Precio1,Precio2,Precio3,Precio4) ")
            SQL.ADD(" VALUES ('"~IdxDate(Fsys)~"', '"~Val(MU:1)~"', 'CON', ")
            SQL.ADD(" "~Fstr(Val(CT:1),0,8)~","~Fstr(0,0,8)~","~Fstr(0,0,8)~","~Fstr(0,0,8)~" )")
            SQL.NEW
        ENDIF
        SQL.EXEC
    ENDIF
ENDIF

***---Conversion de Cotizaciones. Calculo de Precios en USD, ARP y UYU
EjecutarEvento('CONCOT', Fecha1=Fsys, Check1=1)