creardialogo
nroperacion1: 'Nro. Oper. :'
check1: 'Procesa';;;;NO;NO;;;;1;
check2: 'Manual';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(a:1, '# Op')
Act(a:2, 'Check1')
Act(a:3, 'TipoOp')
Act(a:4, '# Boleto')
Act(a:5, 'Nuevo')


Act(b:1, dialogo.nroperacion1)
Acn(b:2, dialogo.check1)
Act(b:3, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1))
Act(b:4, BuscarCampo('OPERACIONES', 'NrBoleto', 'NrOperacion', dialogo.nroperacion1))

if (not Incluido(Val(b:3), 'FXC|FXV|FXJ|FXA|FXAT'))
if (dialogo.check2 = 1)
Messagebox('TipoOp '~Val(b:3)~' invalido.')
endif
if (dialogo.check1 = 1)
Cancelar()
endif
endif

if (NoVacio(Val(b:4)))
if (dialogo.check2 = 1)
Messagebox('La operacion '~Val(b:1)~' ya tiene NrBoleto ('~Val(b:4)~').')
endif
if (dialogo.check1 = 1)
Cancelar()
endif
else
if (dialogo.check1 = 1)
Act(b:5, getnumerador(800))
sql.add(" Update "~Dbo()~".OPERACIONES Set NrBoleto = '"~Val(b:5)~"' ")
sql.add(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec
if (dialogo.check2 = 1)
Messagebox('Boleto asignado a la operacion'~Val(b:1)~' ('~Val(b:5)~').')
endif
endif
endif


if (NO)


sql.add(" Select NrOperacion,NrBoleto,Vehiculo1 from "~Dbo()~".OPERACIONES ")
sql.add(" Where NrOperacion = '"~dialogo.nroperacion1~"'  ")
sql.add(" and (NrBoleto='' or NrBoleto = Null) ")
sql.add(" and (TipoOp like '%FX%' or TipoOp like '%MM%' )")

