proximo
endif
endif

if (dialogo.radio1 = 1)
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set NrOperacion3 = NULL, ")
sql.add("       RB1  = NULL, ")
sql.add("       RB2  = NULL ")
sql.add(" Where NrOperacion  in ('"~dialogo.nroperacion1~"','"~dialogo.nroperacion2~"') ")
sql.new
sql.exec
endif

