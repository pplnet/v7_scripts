creardialogo
nroperacion1: 'PM/BA';1;1;;;;NoVacio(dialogo.nroperacion1);'';NO;;;;;;" TipoOp in ('PMU','PME') and Vehiculo1='INGBA'  "
nroperacion2: 'PM/CURA';2;1;;;;NoVacio(dialogo.nroperacion2);'';NO;;BuscarCampo('OPERACIONES', 'NrOperacion3', 'NrOperacion', dialogo.nroperacion1);;;;" TipoOp in ('PMU','PME') and Vehiculo1 = 'INGCURA' "
radio1:'Tipo|Pone|Quita';3;1;;;;;;;;
cantidad1: '%Comision';4;1;;dialogo.radio1 = 0;dialogo.radio1 = 0;;;;;0
entero1: 'DiasAnio';5;1;;dialogo.radio1 = 0;dialogo.radio1 = 0;;;;;0
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("   Set NrOperacion3 = '"~dialogo.nroperacion1~"', ")
sql.add("       RB1  = '1' ")
sql.add(" Where NrOperacion  = '"~dialogo.nroperacion2~"' ")
sql.new
sql.exec

if (Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion2), 'PMU'))
Act(to1, 'PMU')
else
Act(to1, 'PME')
if (sql("Select count(*) from "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' ") = 0)
Acn(to2, 0)
else
Acn(to2, 1)
endif
endif

sql.add("Select O.FechaOp,O.TotalAux1,O.Plazo, O.TablaFeriados1, ")
sql.add("C.CondicionIVA, C.AgPercepcionIVA, C.ExIVA, C.PorcExIVA, C.FDesdeExIVA, C.FHastaExIVA ")
sql.add("from "~Dbo()~".OPERACIONES O,"~Dbo()~".CLIENTES C ")
sql.add("where NrOperacion = '"~dialogo.nroperacion2~"' ")
sql.add("and   C.Codigo    = O.Cliente1 ")

recorrer sql
Acd(ff1, Fbn()['FechaOp'])
Act(cc1, Fbn()['CondicionIVA'])
Act(cc2, Fbn()['AgPercepcionIVA'])
Act(cc3, Fbn()['ExIVA'])
Acn(cc4, Fbn()['PorcExIVA'])

Acd(cc5, Fbn()['FDesdeExIVA'])
Acd(cc6, Fbn()['FHastaExIVA'])

Acn(aa1, Fbn()['TotalAux1'])
Acn(aa2, Fbn()['Plazo'])

Act(zz13, Fbn()['TablaFeriados1'])
proximo

if (Eqstr(Val(to1), 'PMU'))
if (Val(aa1) = 0)
Acn(aa3, BuscarCampo('OPERACIONES', 'TotalAux8', 'NrOperacion', dialogo.nroperacion1))
else
Acn(aa3, Round(Val(aa1) * Val(aa2) * dialogo.cantidad1 / iif (dialogo.entero1 = 0, 36000, 36500), 2))
endif

Acn(aa4, Round(Val(aa3) * MontoImpuesto('IVANORCOM', Val(ff1), 3, Val(cc1)) / 100, 2))
Acn(aa5, Round(Val(aa3) * MontoImpuesto('IVAADICOM', Val(ff1), 3, Val(cc1)) / 100, 2))
Acn(aa6, 0)

if (Eqstr(Val(cc2), 'SI') y Eqstr(Val(cc3), 'SI'))
if (Val(ff1) >= Val(cc5) y Val(ff1) <= Val(cc6))
Acn(aa6, Round(Val(aa3) * (MontoImpuesto('IVAPERCOM', Val(ff1), 3, '') * (1 - Val(cc4) / 100)) / 100, 2))
else
Acn(aa6, Round(Val(aa3) * (MontoImpuesto('IVAPERCOM', Val(ff1), 3, '') / 100), 2))
endif
if (Val(aa6) < Var('IVAPERMIN'))
Acn(aa6, 0)
endif
else
Acn(aa6, 0)
endif

sql.add("Update "~Dbo()~".OPERACIONES set  ")
sql.add("TotalAux1 = "~Val(aa1)~", TotalAux8 = "~Val(aa3)~", TotalIVA = "~Val(aa4)~", ")
sql.add("TotalIVAADI = "~Val(aa5)~", TotalIVAPER = "~Val(aa6)~" ")
if (Val(aa1) = 0 y Val(aa3) = 0)
sql.add(", CB6= '1' ")
endif
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec
else
sql.add("Select NrCuota,Fecha1,Fecha2,Fecha3,Fecha4,Plazo1,Plazo2,Total7,Cantidad1,Cantidad5, ")
sql.add("Cantidad3,Cantidad12,Cantidad13,Cantidad14,Cantidad15 ")
sql.add("from "~Dbo()~".CUOTAS ")
sql.add("where NrOperacion = '"~dialogo.nroperacion2~"' ")
sql.add("order by NrCuota ")
recorrer sql
if (Val(to2) > 0)
if (NoVacio(Fbn()['Fecha4']))
Acd(ff1, Fbn()['Fecha4'])
endif
endif

if (Val(to2) = 0)
Acn(aa:fac, Round(Fbn()['Cantidad3'] * Fbn()['Plazo1'] * dialogo.cantidad1 / iif (dialogo.entero1 = 0, 36000, 36500), 2))
endif

if (Val(to2) = 1)
if (not (Eqstr(sql("Select Radio6 from "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota ="~Fbn()['NrCuota']~" "), '1')))
if (NoVacio(Fbn()['Fecha4']) y (Fbn()['Fecha1'] >= Fbn()['Fecha4'] y Fbn()['Fecha2'] >= Fbn()['Fecha4']))
Acn(aa:fac, 0)
else
if (NoVacio(Fbn()['Fecha4']) y Fbn()['Fecha4'] > 0)
if (Fbn()['Fecha4'] < Fbn()['Fecha2'])
Acn(pp2, Fbn()['Fecha4'] - Fbn()['Fecha1'])
Acn(pp3, sql("Select Cantidad3 from "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota ="~Fbn()['NrCuota']~" "))
Acn(aa:fac, Round(Val(pp3) * Val(pp2) * dialogo.cantidad1 / iif (dialogo.entero1 = 0, 36000, 36500), 2))
else
Acn(aa:fac, Round(Fbn()['Cantidad3'] * Fbn()['Plazo1'] * dialogo.cantidad1 / iif (dialogo.entero1 = 0, 36000, 36500), 2))
endif
else
Acn(aa:fac, Round(Fbn()['Cantidad3'] * Fbn()['Plazo1'] * dialogo.cantidad1 / iif (dialogo.entero1 = 0, 36000, 36500), 2))
endif
endif
endif
endif

Acn(ba:fac, MontoImpuesto('IVANORCOM', Val(ff1), 3, Val(cc1)))
Acn(bb:fac, MontoImpuesto('IVAADICOM', Val(ff1), 3, Val(cc1)))
Acn(bc:fac, MontoImpuesto('IVAPERCOM', Val(ff1), 3, ''))

Acn(ab:fac, Round(Val(aa:fac) * Val(ba:fac) / 100, 2))
Acn(ac:fac, Round(Val(aa:fac) * Val(bb:fac) / 100, 2))

if (Eqstr(Val(cc2), 'SI') y Eqstr(Val(cc3), 'SI'))
if (Val(ff1) >= Val(cc5) y Val(ff1) <= Val(cc6))
Acn(ad:fac, Round(Val(aa:fac) * Val(bc:fac) * (1 - Val(cc4) / 100) / 100, 2))
else
Acn(ad:fac, Round(Val(aa:fac) * Val(bc:fac) / 100, 2))
endif
if (Val(ad:fac) < Var('IVAPERMIN'))
Acn(ad:fac, 0)
Acn(bc:fac, 0)
endif
else
Acn(ad:fac, 0)
Acn(bc:fac, 0)
endif

Acn(ae:fac, Val(aa:fac) + Val(ab:fac) + Val(ac:fac) + Val(ad:fac))

if (Val(to2) = 0)
sql.add("Insert "~Dbo()~".CUOTAS  ")
sql.add("(NrOperacion,NrCuota,Fecha1,Fecha2, ")
sql.add(" Fecha3,Plazo1,Plazo2,Cantidad1,Cantidad5, ")
sql.add(" Total7,Cantidad3,Cantidad4, ")
sql.add(" Cantidad12,Cantidad13,Cantidad14,Cantidad15, ")
sql.add(" Precio8,Precio9,Precio10) ")
sql.add("values ")
sql.add("('"~dialogo.nroperacion1~"',"~Fbn()['NrCuota']~",'"~IdxDate(Fbn()['Fecha1'])~"','"~IdxDate(Fbn()['Fecha2'])~"',")
sql.add(" '"~IdxDate(Fbn()['Fecha3'])~"',"~Fbn()['Plazo1']~","~Fbn()['Plazo2']~","~Fbn()['Cantidad1']~","~Fbn()['Cantidad5']~",")
sql.add(" "~Val(aa:fac)~","~Fbn()['Cantidad3']~","~Val(ae:fac)~", ")
sql.add(" "~Val(aa:fac)~","~Val(ab:fac)~","~Val(ac:fac)~","~Val(ad:fac)~",")
sql.add(" "~Val(ba:fac)~","~Val(bb:fac)~", "~Val(bc:fac)~" )")
sql.new
sql.exec

else
if (not (Eqstr(sql("Select Radio6 from "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota ="~Fbn()['NrCuota']~" "), '1')))
sql.add("Update "~Dbo()~".CUOTAS set ")
sql.add("Cantidad3 = "~Fbn()['Cantidad3']~", Cantidad5 = "~Fbn()['Cantidad5']~", ")
sql.add("Total7="~Val(aa:fac)~",Cantidad12="~Val(aa:fac)~", ")
sql.add("Cantidad13="~Val(ab:fac)~",Cantidad14="~Val(ac:fac)~",Cantidad15="~Val(ad:fac)~", ")
sql.add("Precio8 = "~Val(ba:fac)~", Precio9 = "~Val(bb:fac)~", Precio10= "~Val(bc:fac)~", ")
sql.add("Cantidad4="~Val(ae:fac)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~Fbn()['NrCuota']~" ")
sql.new
sql.exec
endif
endif
