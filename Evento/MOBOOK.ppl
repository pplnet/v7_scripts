CrearDialogo
    Lista1    : 'Carteras'              ;1;1;;;;;;;;;SQLSet("Select Codigo  from "~DBO~".BOOKS")
    String1   : 'Codigo'                ;2;1;
FinDialogo

IF NOT OK
   Cancelar
Endif
ACT(A:1,SqlSet("select Books from ModelosNegocio WHERE Codigo <> '"~Dialogo.String1~"'" ))
ACT(A:2,'')
ACT(A:3,'')
Recorrer&i 1, Elementos(Dialogo.Lista1)
    If Incluido(ItemLista(Dialogo.Lista1,&i),val(a:1))
        If Eqstr(val(A:2), '')
            ACT(A:2,ItemLista(Dialogo.Lista1,&i))
        Else
            ACT(A:2,val(A:2)~'|'~ItemLista(Dialogo.Lista1,&i))
        EndIf
    Else
        If Eqstr(val(A:3), '')
            ACT(A:3,ItemLista(Dialogo.Lista1,&i)~'|')
        Else
            ACT(A:3,val(A:3)~''~ItemLista(Dialogo.Lista1,&i)~'|')
        EndIf
    EndIf
Proximo
SQL.ADD("UPDATE ModelosNegocio SET Books = '"~val(A:3)~"' WHERE Codigo = '"~Dialogo.String1~"'")
SQL.NEW
SQL.EXEC
If Not Eqstr(Val(A:2),'')
    MessageBox('Las siguientes carteras ya estan asignadas a otros Modelos de Negocios:'~val(A:2))
EndIf