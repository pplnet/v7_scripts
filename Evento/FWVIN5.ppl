CrearDialogo
  NrOperacion1 : 'Nr.Operacion' ;
FinDialogo

If Not Ok
  Cancelar
Endif
******************************************** Verifico que la operacion sea pasiva, de lo contrario no sigue.
IF EqStr(BuscarCampo('OPERACIONES','MB3','NrOperacion', Dialogo.NrOperacion1), '0')
*    MessageBox('FWVIN5: Verifico si es Pasiva la operacion Nro '~Dialogo.NrOperacion1 )
ELSE
  *  Cancelar('La Operacion no es Pasiva !!! Cancela') 
ENDIF

* Borro las operaciones en OPERACIONESBITS    
  SQL.ADD("DELETE "~DBO~".OPERACIONESBITS ")
  SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC

* MessageBox('FWVIN5: Borro Pasiva en el Maestro de OPERACIONES y en OperacionesBit Nro '~Dialogo.NrOperacion1 )

* Borro las operaciones en el Maestro de OPERACIONES
  SQL.ADD("DELETE "~DBO~".OPERACIONES ")
  SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC