    if Eqstr(FBN['TipoOp'],'FXCF')
      ACT(i:fac, 'BOLETO DE COMPRA FUTURO')
    Else 
        if Eqstr(FBN['TipoOp'],'FXVF')
            ACT(i:fac, 'BOLETO DE VENTA FUTURO')
        Else
            if Eqstr(FBN['TipoOp'],'FXJ')
                ACT(i:fac, 'BOLETO DE CANJE')
            Else
                ACT(i:fac, 'BOLETO DE CAMBIOS')
            Endif  
        Endif  
    Endif
   
    if Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACO(11,18)
    Else
        ACO(11,10)
    Endif
    
    ACT(i:fac+1, 'Boleto Nro.: '~FBN['NrBoleto'])
    ACT(i:fac+2, 'Fecha Operacion: '~FBN['FechaOp'])
    
    If Incluido(FBN['TipoOp'],'FXCF|FXVF')
       ACT(i:fac+3, 'Fecha Vto.' ~FBN['FechaVto'] )
    Else
       ACT(i:fac+3, 'Fecha Liq. '~FBN['Especie']~': '~FBN['FechaVto'])
    Endif
    
    If Incluido(FBN['TipoOp'],'FXCF|FXVF')
       ACT(i:fac+4, 'F.Fixing: ' ~FBN['FechaVto2'] )
    Else
       ACT(i:fac+4, 'Fecha Liq. '~FBN['ContraEspecie']~': '~FBN['FechaPago'])
    Endif
    
    *ACT(i:fac+5, 'Hora Confirm. '~Hora(SQL("Select Fecha from "~DBO~".INSTANCIASOP Where NrOperacion = '"~fbn['NrOperacion']~"' and NrInstancia = 80 ")))
    #ifdef BOFA
        ACT(i:fac+5, 'Hora Confirm. '~(SQL("Select CONVERT(VARCHAR, Fecha, 108) from "~DBO~".INSTANCIASOP Where NrOperacion = '"~fbn['NrOperacion']~"'  and NrInstancia = 80 ")))
    #else
        ACT(i:fac+5, 'Hora Confirm. '~(SQL("Select CONVERT(VARCHAR, FechaAltaMae, 108) from "~DBO~".OPERACIONES Where NrOperacion = '"~fbn['NrOperacion']~"' ")))  
    #endif
*  #endif
    
  SetFilaActual(6+&DesplBacs)
        
    #ifdef BACS
    #else
        
        ACT(a:fac,   'Sr./es:  ')
        ACT(a:fac+1, '              '~BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']))
        ACT(a:fac+2, '              '~BuscarCampo('CLIENTES','Direccion','Codigo',FBN['Cliente1']))
        ACT(a:fac+3, '              '~BuscarCampo('CLIENTES','Localidad','Codigo',FBN['Cliente1']))
    #endif
    * Datos de las cuentas
    
    #ifdef BACS
    if Incluido(FBN['TipoOp'],'FXC|FXCT|FXA|FXAT')
        ACT(h:FAC-3, 'Cuenta Cliente: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta4'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta4']))    
        **Modificacion 23/05/23
        if not Incluido(FBN['TipoOp'],'FXC')
            ACT(h:FAC-4, 'Cuenta Vehiculo: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta1'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta1']))
        endif
    else
    **Modificacion 13/07/23
        *If no Incluido(FBN['TipoOp'],'FXCF|FXVF')
        If no Incluido(FBN['TipoOp'],'FXCF|FXVF|FXV|FXJ' )
            ACT(h:FAC-4, 'Cuenta Vehiculo: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta2'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta2']))
        Endif
        ACT(h:FAC-3, 'Cuenta Cliente: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta4'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta4']))    
    endif

    **Modificacion 23/05/23
    if Incluido(FBN['TipoOp'],'FXC|FXV|FXCF|FXVF|FXJ')
        ACT(h:FAC-2, 'Razon Social: '    ~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn['Cliente1']))    
        ACT(h:FAC-1, 'Direccion: '~BuscarCampo('CLIENTES', 'Calle', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Altura', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Piso', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Depto', 'Codigo', fbn['Cliente1']))    
        ACT(h:FAC+0, 'Cuit: '     ~BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn['Cliente1']))    
        if Incluido(FBN['TipoOp'],'FXC|FXV')
            if EqStri('FIN', (BuscarCampo('CATEGORIACLIENTES', 'Sector', 'Codigo', BuscarCampo('CLIENTES', 'CategDepositante', 'Codigo', fbn['Cliente1']))))
                ACT(h:FAC+1, 'Codigo BCRA.: '   ~BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', fbn['Cliente1']))   
            endif 
        else 
            ACT(h:FAC+1, 'Nr. Rofex: '   ~BuscarCampo('CLIENTES', 'NrRofex', 'Codigo', fbn['Cliente1']))   
        endif 
    endif

     if Incluido(FBN['TipoOp'],'FXJ')
        ACT(h:FAC+1, 'Codigo BCRA.: '   ~BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', fbn['Cliente1']))   
     endif
    
    setFont(h:FAC-4..h:FAC+1, 5)

    #else
    
    if Incluido(FBN['TipoOp'],'FXC|FXCT|FXA|FXAT')
      ACT(f:FAC+2, 'Cuenta Vehiculo: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta1'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta1']))
      ACT(f:FAC+3, 'Cuenta Cliente: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta4'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta4']))    
    else
        If no Incluido(FBN['TipoOp'],'FXCF|FXVF|FXJ')
            ACT(f:FAC+2, 'Cuenta Vehiculo: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta2'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta2']))
        Endif
        ACT(f:FAC+3, 'Cuenta Cliente: '~BuscarCampo('CUENTAS', 'Numero', 'Codigo', fbn['Cuenta4'])~' - '~BuscarCampo('CUENTAS', 'Nombre', 'Codigo', fbn['Cuenta4']))    
    endif
    
    if Incluido(FBN['TipoOp'],'FXJ')
        ACT(f:FAC-1, val(f:fac+3))
        ACT(f:FAC, 'Razon Social: '    ~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn['Cliente1']))    
        ACT(f:FAC+1, 'Direccion: '~BuscarCampo('CLIENTES', 'Calle', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Altura', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Piso', 'Codigo', fbn['Cliente1']) ~ '-'~ BuscarCampo('CLIENTES', 'Depto', 'Codigo', fbn['Cliente1']))    
        ACT(f:FAC+2, 'Cuit: '     ~BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn['Cliente1']))    
        ACT(f:FAC+3, 'Codigo BCRA.: '   ~BuscarCampo('CLIENTES', 'CodigoBCRA', 'Codigo', fbn['Cliente1']))   
    endif
    
    #endif

     If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        *La función ITEMLISTA comienza a contar desde el índice 1
        ACT(f:fac+10, 'MTM: '~ITEMLISTA('No Aplica|Liquida|No Liquida', FBN['MB4'] + 1))
     Endif
     
     If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(f:fac+11, 'Frec.Liq.MTM: '~ITEMLISTA('Diario|Mensual|Vto|No Aplica',FBN['MB1'] + 1))
     Endif
     
     If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(f:fac+12, 'Merc. Negociacion: '~FBN['Mercado4'] )
     Endif
     
     If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(f:fac+13, 'Especie Fixing: '~FBN['ContraEspecie2'] )
     Endif

     If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(f:fac+14, 'M.Liq.Mon: '~FBN['Mercado2'] )
     Endif
    
     setFont(f:fac+10..f:fac+14,5)
     
     SetFilaActual(11 +&DesplBacs)

    if Eqstr(FBN['TipoOp'],'FXC')
       ACT(a:fac,'Nuestra Compra Contado de Moneda Extranjera') 
    Endif

    if Eqstr(FBN['TipoOp'],'FXV')
       ACT(a:fac,'Nuestra Venta Contado de Moneda Extranjera') 
    Endif
    
  
    if Incluido(FBN['TipoOp'],'FXA')
       ACT(a:fac,'Nuestra Compra Arbitraje Contado de Moneda Extranjera')
    endif 
    if Incluido(FBN['TipoOp'],'FXAT')
       ACT(a:fac,'Nuestra Compra Arbitraje a Termino de Moneda Extranjera')
    endif 
    if Incluido(FBN['TipoOp'],'FXP')
       ACT(a:fac,BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
    endif 
    If FBN['Plazo'] > 0
      ACT(a:fac+1, 'Plazo a la fecha de liquidacion: ' ~Fbn['Plazo']~' dias.')
    Endif 
    
     SetFilaActual(13+ &DesplBacs)

    ACT(a:fac, 'Especie')
    
    If Incluido(FBN['TipoOp'], 'FXCF|FXVF')
        ACT(d:fac, 'Cant. Contratos')
        ACT(e:fac, 'Cantidad')
    Else
        ACT(d:fac, 'Cantidad')
    Endif
    
    If Incluido(FBN['TipoOp'], 'FXCF|FXVF')
        ACO(5,10)
    Else
    *Modificacion 1/6/23 ACO(5,4)
        ACO(5,10)
    Endif
    
    If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(h:fac, 'Precio Futuro '~FBN['ContraEspecie'])
    Else
        ACT(h:fac, 'Precio '~FBN['ContraEspecie'])
    Endif
    
    If Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(k:fac, 'Monto '~FBN['ContraEspecie'])
    Else
        ACT(k:fac, 'Importe '~FBN['ContraEspecie'])
    Endif
    
    
    If Eqstr(FBN['TipoOp'],'FXP')
         ACT(b:fac, 'Tasa')
         ACT(f:fac, 'P.Futuro '~FBN['ContraEspecie'])
    Endif
    

    SetFilaActual(14 + &DesplBacs)
    *Modificacion 1/6/23
    #ifdef BACS
    
        if Incluido(fbn('TipoOp'),'FXCF|FXVF')
            ACT(a:fac, FBN['ObservacDoc'])
        else
            ACT(a:fac,FBN['Especie']~'-'~BuscarCampo('ESPECIES','Nombre','Codigo',FBN['Especie']))
            if Incluido(fbn('TipoOp'),'FXA|FXAT')
              ACT(a:fac+1, fbn('ContraEspecie')~'-'~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
            else
              ACT(a:fac+1, BuscarCampo('ESPECIES','Extendido','Codigo',FBN['Especie']))
            endif
        endif
            
    #else
    
        ACT(a:fac,FBN['Especie']~'-'~BuscarCampo('ESPECIES','Nombre','Codigo',FBN['Especie']))
        if Incluido(fbn('TipoOp'),'FXA|FXAT')
          ACT(a:fac+1, fbn('ContraEspecie')~'-'~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
        else
          ACT(a:fac+1, BuscarCampo('ESPECIES','Extendido','Codigo',FBN['Especie']))
        endif
        
    #endif
    
    
    
     If Incluido(FBN['TipoOp'], 'FXCF|FXVF')
        ACN(d:fac, FBN['TotalBrutoCli3'])
        ACN(e:fac, FBN['Cantidad'])
     Else
        ACN(d:fac, FBN['Cantidad'])
     Endif
    
    ACN(h:fac, FBN['Precio1'])
    ACN(k:fac, FBN['TotalBrutoCli1'])
    **** ARANCELES ******
***---    ACT(h:fac+2, BuscarCampo('ARANCELES', 'Descripcion', 'Codigo', FBN['Arancel1']))    
***---    ACT(h:fac+3, BuscarCampo('ARANCELES', 'Descripcion', 'Codigo', FBN['Arancel2']))    
***---    ACT(h:fac+4, BuscarCampo('ARANCELES', 'Descripcion', 'Codigo', FBN['Arancel3']))    
***---    ACT(h:fac+5, BuscarCampo('ARANCELES', 'Descripcion', 'Codigo', FBN['Arancel4']))    
    If FBN['PorArancel'] > 0
***---      ACN(k:fac+2, FBN['PorArancel']) 
    Endif
    If FBN['PorArancel2'] > 0
***---      ACN(k:fac+3, FBN['PorArancel2']) 
    Endif
    If FBN['PorArancel3'] > 0
***---      ACN(k:fac+4, FBN['PorArancel3']) 
    Endif
    If FBN['PorArancel4'] > 0
***---      ACN(k:fac+5, FBN['PorArancel4']) 
    Endif
    
    
    
    
    ACT(H:fac+6, 'TOTAL')
    if Incluido(FBN['TipoOp'], 'FXC|FXCF')
           ACN(k:fac+6, Val(k:fac) - (val(k:fac+2) + val(k:fac+3) + val(k:fac + 4) + val(k:fac + 5)))
    else
           ACN(k:fac+6, Val(k:fac) + (val(k:fac+2) + val(k:fac+3) + val(k:fac + 4) + val(k:fac + 5)))
    endif
    
    **Modificacion 6/23
    if  Incluido(FBN['TipoOp'], 'FXCF|FXVF')
        if EqStr(Var('COMTERBOLR'),'SI')

            ACT(H:fac+2, 'Comision')
            ACN(K:fac+2, BuscarCampo('Operaciones', 'TotalAux1','NrOperacion', fbn['NrOperacion']))
            ACT(H:fac+3, 'IVA Comision')
            ACN(K:fac+3, BuscarCampo('Operaciones', 'TotalIva','NrOperacion', fbn['NrOperacion']))
            ACT(H:fac+4, 'Derechos')
            ACN(K:fac+4, BuscarCampo('Operaciones', 'TotalGastos','NrOperacion', fbn['NrOperacion']))
            ACT(H:fac+5, 'IVA Derechos')
            ACN(K:fac+5, BuscarCampo('Operaciones', 'TotalIvaAdi','NrOperacion', fbn['NrOperacion']))
            ACT(H:fac+6, 'TOTAL GASTOS')
            ACN(K:fac+6,val(K:fac+2)+val(K:fac+3)+val(K:fac+4)+val(K:fac+5))
        endif
    endif
    
    If Eqstr(FBN['TipoOp'],'FXP')
         ACN(b:fac, FBN['TasaBase'])
         ACN(f:fac, FBN['Precio2'])
    Endif
    

    SetFilaActual(16 + &DesplBacs)

    ACT(a:fac  , 'Corredor: ' )
    ACT(a:fac+1, 'Comisión: ' )
    ACT(a:fac+2, 'Importe : ')
    
    ACT(b:fac  , Fbn['Corredor'] ~ '-' ~ BuscarCampo('Corredores','Nombre','Codigo',Fbn['Corredor']))
    ACT(b:fac+1, Fbn['Comision'] ~ '%')
    ACT(b:fac+2, Fbn['TotalComisiones'])
    
    if  Incluido(FBN['TipoOp'], 'FXCF|FXVF')
        if EqStr(Var('COMTERBOLR'),'SI')
            ACT(a:fac+1,'')
            ACT(a:fac+2,'')
            ACT(b:fac+1,'')
            ACT(b:fac+2,'')
        endif
    endif
    
    If  Incluido(FBN['TipoOp'], 'FXV')
        ACT(a:fac+3, "Cod.Instrumento Vendido")
        ACT(c:fac+3, "02")
        ACT(a:fac+4, "Cod.Instrumento Comprado")
        ACT(c:fac+4, "02")
    EndIf
    If  Incluido(FBN['TipoOp'], 'FXC')
        ACT(a:fac+3, "Cod.Instrumento Comprado")
        ACT(c:fac+3, "02")
        ACT(a:fac+4, "Cod.Instrumento Vendido")
        ACT(c:fac+4, "02")
    EndIf
    If  Incluido(FBN['TipoOp'], 'FXJ')
        ACT(a:fac+3, "Cod.Instrumento Comprado")
        ACT(c:fac+3, "02")
        ACT(a:fac+4,"Cod.Instrumento Vendido")
        ACT(c:fac+4, "02")
    EndIf


    ** AA 30-01-2023 inclusion Instrumentos Cpa y VTa
    *Plaza1 Comprado
    *Plaza2 Vendido
    *Modificacion 13/7/23
*    If Incluido(fbn('TipoOp'),'FXC')
*       ACT(a:fac+3,'Cod.Instrumento.Comprado:   '~Fbn['Plaza1'])
*    Else
*       If Incluido(fbn('TipoOp'),'FXV')
*          ACT(a:fac+3,'Cod.Instrumento.Vendido: ')
