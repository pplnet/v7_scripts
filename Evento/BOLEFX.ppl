*          ACT(a:fac+4,'Cod.Instrumento.Recibido: ')
*          ACT(c:fac+4,Fbn['Plaza1'])
*       endif
*     Endif
    
    
    *--- Formas de Liquidacion------   
    ACT(ab:fac, iif(Eqstr(Fbn['FormaLiquidacion1'],'0'),'STD',iif( Eqstr(Fbn['FormaLiquidacion1'],'1'),'DVP','RVP')))
    ACT(ac:fac, iif(Fbn['ValorRB1']=0,'Hoy',iif( Fbn['ValorRB1']=1,'Normal',iif( FBN['ValorRB1']=2,'48Hs','72Hs'))))
    ACT(ad:fac, iif(Eqstr(Fbn['FormaLiquidacion3'],'0'),'STD',iif(Eqstr(Fbn['FormaLiquidacion3'],'1'),'DVP','RVP')))
    ACT(ae:fac, iif(Eqstr(Fbn['FormaLiquidacion2'],'0'),'Tomorrow','Spot'))
    ACT(af:fac, iif(Eqstr(FBN['MercadoRB'],'0') ,'Local','Internacional') )
    If Incluido(FBN['TipoOp'],'FXCF|FXVF|')
       ACT(d:fac  , 'Forma de Liq.: ' ~ val(ab:fac))
    Endif
    If Incluido(FBN['TipoOp'],'FXC|FXV|FXJ')
       ACT(d:fac, 'Valor: '~ val(ac:fac))
       ACT(g:fac, 'Cod. Moneda: '~BuscarCampo('ESPECIES','CodBCRA','Codigo',FBN['Especie']))
       *Modificacion 23/05/23
       #ifdef BACS
       ACT(g:fac+1, 'USD "A" 3500: '~Str(Cotizacion('COMA35',,,,fbn('FechaOp')-1, 1, NO)))
       #else
       #endif
    Endif
    If Eqstr(FBN['TipoOp'],'FXJ')
    
         ACT(g:fac+1, 'USD "A" 3500: '~Str(Cotizacion('COMA35',,,,fbn('FechaOp')-1, 1, NO)))
    EndIf
    If Eqstr(FBN['TipoOp'],'FXAT')
       ACT(d:fac  , 'Forma de Liq.: ' ~ val(ab:fac))
       ACT(d:fac+1, 'Mercado: ' ~ val(af:fac) )
    Endif
    If Eqstr( FBN['TipoOp'] ,'FXA' )
       ACT(d:fac  , 'Forma de Liquidaci¢n: ' ~ val(ab:fac))
       If Eqstr(FBN['MercadoRB'],'0')
          ACT(d:fac+1, 'Valor: ' ~ val(ac:fac) )
       else
          ACT(d:fac+1, 'Valor: ' ~ val(ae:fac) )
       endif
    Endif
    If Eqstr(FBN['TipoOp'],'FXP')
       ACT(d:fac  , 'Liq.Spot: ' ~ val(ab:fac) ~'   Liq.Futuro: '~val(ad:fac))
       If Eqstr(FBN['MercadoRB'],'0')
          ACT(d:fac+1, 'Valor: ' ~ val(ac:fac) )
       else
          ACT(d:fac+1, 'Valor: ' ~ val(ae:fac) )
       endif
    Endif
    
     If No Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(d:fac+2,'Puesto     : ' ~ iif(Fbn['Puesto']=1,'SI','NO'))
     Endif

     If No Incluido(FBN['TipoOp'],'FXCF|FXVF')
        ACT(d:fac+3, 'Cto.BCRA: '~FBN['ConceptoBCRA']~'-'~BuscarCampo('ConceptosBCRA','Descripcion','Codigo',FBN['ConceptoBCRA']))
     Endif
    
    ACT(d:fac+4, 'Operador     : ' ~ BuscarCampo('USUARIOS','Nombre','Codigo',FBN['Operador']))
    
    SetFilaActual(19 + &DesplBacs)

    if NoVacio(BuscarCampo('Clientes','Responsable','Codigo',fbn['Cliente1']))
       ACT(a:fac+3, 'Ref: Banca Privada')
    endif
    ACT(a:fac+2, 'Minuta: '~FBN['NrOperacion'])
    
    SetFilaActual(23 + &DesplBacs)

    ACT(a:fac+2,'Original para el Cliente')
    ACT(h:fac, '____________________________________')
