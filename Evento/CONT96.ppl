MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Ajuste Dif. por Redondeo Dev al Vto ---')

ACT(US:1, Descendientes('ESPECIES', 'U$S'))
***---Moneda Fuerte
ACT(MF:1, Var('MONEEXTR'))
ACT(OA:1, Var('OPEACT'))
ACT(OV:1, Var('CLASEOPVIN'))
ACN(BD:1, 0)

***---Levanto asiento Devengados al Vto y obtengo Interes y DC del asiento
SQL.ADD(" Select A.NrOperacion, A.FechaValor, Sum(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, Sum(A1.Cantidad3) Cantidad3, ")
SQL.ADD(" Sum(A1.Valor1) Cantidad4, A1.Alias6 Moneda, V.Alias4, M.TipoOp, A1.Cuenta, C.Alias TipoCta, A1.DebitoCredito, A.NrUnicoAsiento ")
SQL.ADD(" From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M, "~DBO~".ASIENTOSCON1 A1, "~DBO~".VEHICULOS V, "~DBO~".CONTABILIDAD C ")
SQL.ADD(" Where A.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.Codigo = A.Modelo ")
SQL.ADD(" AND V.Codigo = A.Vehiculo ")
SQL.ADD(" AND A.NrUnicoAsiento = A1.NrUnicoAsiento ")
SQL.ADD(" AND C.Codigo = A1.Cuenta ")
***---Cuenta de Interes O DC Interes
SQL.ADD(" AND (C.Alias = 'I' OR (C.Alias = 'DC' AND A1.Alias5 = 'DCI')) ")
SQL.ADD(" AND M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVT'))~") ")
*SQL.ADD(" AND M.Habilitado = 'SI' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" A.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVAcio(Dialogo.Lista1)
   *SQL.ADD(" AND A.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
   SQL.ADD(" AND A.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*   Recorrer&i 1,Elementos(Dialogo.Lista1)
*        SQL.ADD(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
*        If NOT Elementos(Dialogo.Lista1)=&i
*            SQL.ADD(" OR ")
*        EndIf
*   proximo
*   SQL.ADD(") ")     
ELSE
   IF NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND A.Vehiculo IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
   ENDIF
ENDIF
***---SQL.ADD(" AND A.NrOperacion = 'G2000001' ")
SQL.ADD(" Group By A.NrOperacion, A.FechaValor, A1.Alias6, V.Alias4, M.TipoOp, A1.Cuenta, C.Alias, A1.DebitoCredito, A.NrUnicoAsiento ")
Recorrer SQL
*MessageBox('1')
    ACD(FV:1, fbn('FechaValor'))
    IF Not Eqstr(fbn('NrOperacion'), Val(NR:1)) Y Not CeldaVacia(NR:1)
        ACN(VI:1, 0)
        ACN(VI:2, 0)
        ACN(VI:3, 0)
        ACN(VI:4, 0)
        ACN(VD:1, 0)
        ACN(VD:2, 0)
        ACN(VD:3, 0)
        ACN(VD:4, 0)
        IF Val(BD:1) = 1
            ***---Busco Devengados Fin de Mes
            (.'CONT96A'.)
        ENDIF
        IF Val(FI:1) + Val(VI:1) + Val(FD:1) + Val(VD:1)  <> Val(IT:1)
            ACN(AJ:1, Round(Val(IT:1) - Val(FI:1) - Val(VI:1) - Val(FD:1) - Val(VD:1), 2))
        ENDIF
        IF Val(FI:2) + Val(VI:2) + Val(FD:2) + Val(VD:2)  <> Val(IT:2)
            ACN(AJ:2, Round(Val(IT:2) - Val(FI:2) - Val(VI:2) - Val(FD:2) - Val(VD:2), 2))
        ENDIF
        IF Val(FI:3) + Val(VI:3) + Val(FD:3) + Val(VD:3)  <> Val(IT:3)
            ACN(AJ:3, Round(Val(IT:3) - Val(FI:3) - Val(VI:3) - Val(FD:3) - Val(VD:3), 2))
        ENDIF
        IF Val(FI:4) + Val(VI:4) + Val(FD:4) + Val(VD:4)  <> Val(IT:4)
            ACN(AJ:4, Round(Val(IT:4) - Val(FI:4) - Val(VI:4) - Val(FD:4) - Val(VD:4), 2))
        ENDIF
        IF Val(AJ:1) <> 0 O Val(AJ:2) <> 0 O Val(AJ:3) <> 0 O Val(AJ:4) <> 0
*MessageBox('z')
            ***---Hay Ajuste
            (.'CONT96B'.)
        ENDIF
        ACN(BD:1, 0)
    ENDIF
    IF Incluido(fbn('TipoOp'), Val(OA:1)) O [Eqstr(fbn('TipoOp'), 'MMPCCM') Y BuscarCampo('OPERACIONES','MB3','NrOperacion', fbn('NrOperacion')) = 1]
        ***---Signo
        IF Eqstr(fbn('DebitoCredito'), 'DEB')
            ACN(SG:1, -1)
        ELSE
            ACN(SG:1, 1)
        ENDIF
        ACN(AT:1, 1)
    ELSE
        ***---Signo
        IF Eqstr(fbn('DebitoCredito'), 'DEB')
            ACN(SG:1, 1)
        ELSE
            ACN(SG:1, -1)
        ENDIF
        ACN(AT:1, 0)
    ENDIF
    IF Eqstr(fbn('TipoCta'), 'I')
        ***---Interes Contabilizado al Vto
        SCN(VI:1, fbn('Cantidad1') * Val(SG:1))
        SCN(VI:2, fbn('Cantidad2') * Val(SG:1))
        SCN(VI:3, fbn('Cantidad3') * Val(SG:1))
        SCN(VI:4, fbn('Cantidad4') * Val(SG:1))
    ELSE
        ***---DC Contabilizada al Vto
        SCN(VD:1, fbn('Cantidad1') * Val(SG:1))
        SCN(VD:2, fbn('Cantidad2') * Val(SG:1))
        SCN(VD:3, fbn('Cantidad3') * Val(SG:1))
        SCN(VD:4, fbn('Cantidad4') * Val(SG:1))
    ENDIF
    ***---Obtengo Interes de la operacion
    IF Incluido(fbn('TipoOp'), 'MMO|MMCCR|MMCAUA|MMCAUP|MMDPAC|SEABD|SEABP')
        ACN(IT:4, Round(SQL(" Select TotalIntereses From OPERACIONES Where NrOperacion = '"~fbn('NrOperacion')~"' AND FechaVto = '"~IdxDate(Val(FV:1))~"' "), 2))
    ELSE
        IF Incluido(fbn('TipoOp'), 'SERA|SERP|SERAV|SERPV')
            ACN(IT:4, Round(SQL(" Select TotalNetoCli2-TotalNetoCli1 From OPERACIONES Where NrOperacion = '"~fbn('NrOperacion')~"' AND FechaVto2 = '"~IdxDate(Val(FV:1))~"' "), 2))
        ELSE
            IF Incluido(fbn('TipoOp'), 'MMCPM|MMPOSM|MMPCLM|MMPEM|MMPIM|MMFCMV|MMFIMV|MMONM|MMPCCM|MMSIMV|SEPTMV|SEPVMV')
                ACN(IT:4, Round(SQL(" Select Cantidad3 From CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 = '"~IdxDate(Val(FV:1))~"' "), 2))
            ELSE
                ***---Operacion no prevista. Faltan los Swaps, ver como identificar el asiento porque devengan en dos monedas
                Break
            ENDIF
        ENDIF
    ENDIF
    ***---Calculo Interes en cada moneda
    IF Eqstr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo', fbn('TipoOp')), Val(OV:1))
        ACN(IT:1, Round(Val(IT:4)*#COTMONFUEP, 2))
        ACN(IT:2, Round(Val(IT:4)*#COTMONLOCP, 2))
        ACN(IT:3, Round(Val(IT:4)*#COTMONGRUP, 2))
    ELSE
        IF Incluido(fbn('TipoOp'), Val(OA:1))
            ACN(IT:1, Round(Val(IT:4)*#COTMONFUEC, 2))
            ACN(IT:2, Round(Val(IT:4)*#COTMONLOCC, 2))
            ACN(IT:3, Round(Val(IT:4)*#COTMONGRUC, 2))
        ELSE
            ACN(IT:1, Round(Val(IT:4)*#COTMONFUEV, 2))
            ACN(IT:2, Round(Val(IT:4)*#COTMONLOCV, 2))
            ACN(IT:3, Round(Val(IT:4)*#COTMONGRUV, 2))
        ENDIF
    ENDIF
    ACT(NR:1, fbn('NrOperacion'))
    ACT(AS:1, fbn('NrUnicoAsiento'))
    ACN(BD:1, 1)
Proximo
***---Busco Devengados Fin de Mes Ultima Operacion
(.'CONT96A'.)
SCN(TI:1, Val(VI:1) + Val(FI:1))
SCN(TI:2, Val(VI:2) + Val(FI:2))
SCN(TI:3, Val(VI:3) + Val(FI:3))
SCN(TI:4, Val(VI:4) + Val(FI:4))
SCN(TD:1, Val(VD:1) + Val(FD:1))
SCN(TD:2, Val(VD:2) + Val(FD:2))
SCN(TD:3, Val(VD:3) + Val(FD:3))
SCN(TD:4, Val(VD:4) + Val(FD:4))
IF Val(FI:1) + Val(VI:1) + Val(FD:1) + Val(VD:1)  <> Val(IT:1)
    ACN(AJ:1, Round(Val(IT:1) - Val(FI:1) - Val(VI:1) - Val(FD:1) - Val(VD:1), 2))
ELSE
    ACN(AJ:1, 0)
ENDIF
IF Val(FI:2) + Val(VI:2) + Val(FD:2) + Val(VD:2)  <> Val(IT:2)
    ACN(AJ:2, Round(Val(IT:2) - Val(FI:2) - Val(VI:2) - Val(FD:2) - Val(VD:2), 2))
ELSE
    ACN(AJ:2, 0)
ENDIF
IF Val(FI:3) + Val(VI:3) + Val(FD:3) + Val(VD:3)  <> Val(IT:3)
    ACN(AJ:3, Round(Val(IT:3) - Val(FI:3) - Val(VI:3) - Val(FD:3) - Val(VD:3), 2))
ELSE
    ACN(AJ:3, 0)
ENDIF
IF Val(FI:4) + Val(VI:4) + Val(FD:4) + Val(VD:4)  <> Val(IT:4)
    ACN(AJ:4, Round(Val(IT:4) - Val(FI:4) - Val(VI:4) - Val(FD:4) - Val(VD:4), 2))
ELSE
    ACN(AJ:4, 0)
ENDIF
IF Val(AJ:1) <> 0 O Val(AJ:2) <> 0 O Val(AJ:3) <> 0 O Val(AJ:4) <> 0
    ***---Hay Ajuste
    (.'CONT96B'.)
ENDIF

*MessageBox(Val(IT:1))
*MessageBox(Val(FI:1))
*MessageBox(Val(VI:1))
*MessageBox(Val(FD:1))
*MessageBox(Val(VD:1))

*MessageBox(Val(AJ:1))
*MessageBox(Val(AJ:2))
*MessageBox(Val(AJ:3))
*MessageBox(Val(AJ:4))

