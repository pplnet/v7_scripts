sql.add(" Select A.FechaValor,A.NrUnicoAsiento from "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1, "~Dbo()~".MODELOSASIENTO MA where ")
sql.add(" A.NrUnicoAsiento = A1.NrUnicoAsiento AND A.Modelo = MA.Codigo ")
sql.add(" AND A.FechaValor >= '"~IdxDate(Fbn('MinFechaOp'))~"' ")
sql.add(" AND A.Vehiculo = '"~Fbn('Vehiculo1')~"' AND A.Estado='E' ")
sql.add(" AND A1.Alias7 = '"~Fbn('Especie')~"' AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASIRZ'))~") ")
sql.add(" AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR  A.NrAsiento = ' ') ")
sql.add(" Group By A.FechaValor,A.NrUnicoAsiento ")
recorrer sql
