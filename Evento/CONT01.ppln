sql.add(" SELECT Min(FechaOp) MinFechaOp,Especie,Vehiculo1 FROM ( ")
sql.add(" SELECT O.FechaOp , O.Especie Especie, O.Vehiculo1 Vehiculo1")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M ")
sql.add(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
sql.add(" AND   T.Especie NOT IN ("~pipe2comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
sql.add(" AND   T.NrTrans     =  M.NrTrans2 ")
sql.add(" AND O.TipoOp in ('FCR','FCS','SECS','SEVS') ")
sql.add(" and T.TipoTr2 in ('DEP','RET') ")
sql.add(" AND M.NrOperacion = O.NrOperacion ")
sql.add(" AND M.NrSaldo = 1 ")
sql.add(" AND T.Cantidad1 > 0 ")
sql.add(" AND T.Vehiculo1 IN ("~pipe2comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
sql.add(" AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND T.Fecha2 < '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" ) query Group By Vehiculo1, Especie ")
recorrer sql
