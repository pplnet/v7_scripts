Sqladd(" SELECT Min(FechaOp) MinFechaOp,Especie,Vehiculo1 FROM ( ")
Sqladd(" SELECT O.FechaOp , O.Especie Especie, O.Vehiculo1 Vehiculo1")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
Sqladd(" AND   T.Especie NOT IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~")  ")
Sqladd(" AND   T.NrTrans     =  M.NrTrans2 ")
Sqladd(" AND O.TipoOp in ('FCR','FCS','SECS','SEVS') ")
Sqladd(" and T.TipoTr2 in ('DEP','RET') ")
Sqladd(" AND M.NrOperacion = O.NrOperacion ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND T.Cantidad1 > 0 ")
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
Sqladd(" AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND T.Fecha2 < '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" ) query Group By Vehiculo1, Especie ")
recorrer sql
recorrer&i Fbn('MinFechaOp'), Habiles(dialogo.fecha1, -1)
if (EsHabil(&i))
Ejecutarevento('ANUASI', 'fecha1', &i, 'fecha2', &i, 'lista2', Fbn('Vehiculo1'), 'lista3', Fbn('Especie'), 'listatabla1', '', 'lista1', Var('TIPASIRZ'))
Ejecutarevento('CONT47', 'fecha1', (&i), 'lista1', Fbn('Vehiculo1'), 'lista2', Fbn('Especie'))
endif
