sql.add(" Select NrOperacion, 0 BD1 from "~Dbo()~".OPERACIONES where ")
sql.add(" FechaCargaSys =  '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND FechaOp < FechaCargaSys ")
sql.add(" AND TipoOp in ('FCR','FCS','SECS','SEVS') ")
sql.add(" AND (CantImpresiones3 Is Null OR CantImpresiones3 = '' OR CantImpresiones3 = ' ') ")
sql.add(" AND Vehiculo1 = '"~Val(vh:1)~"' ")
sql.add(" AND Especie = '"~Val(es:1)~"' ")
sql.add(" UNION ")
sql.add(" Select NrOperacion, 1 BD1 from "~Dbo()~".BOPERACIONES ")
sql.add(" where CONVERT (Char(10), FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' ")
sql.add(" AND FechaOp < '"~IdxDate(dialogo.fecha1)~"'")
sql.add(" AND TipoOp in ('FCR','FCS','SECS','SEVS') ")
sql.add(" AND (CantImpresiones3 Is Null OR CantImpresiones3 = '' OR CantImpresiones3 = ' ') ")
sql.add(" AND Vehiculo1 = '"~Val(vh:1)~"' ")
sql.add(" AND Especie = '"~Val(es:1)~"' ")
recorrer sql
if (Fbn('BD1') = 0)
sql.add(" Update "~Dbo()~".OPERACIONES ")
else
sql.add(" Update "~Dbo()~".BOPERACIONES ")
endif
sql.add(" Set CantImpresiones3 = 1 ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
sql.new
sql.exec
