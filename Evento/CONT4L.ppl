MostrarCuadroDeMensajes
CrearDialogo
   Fecha1   : 'Fecha'      ;1;1;;;;;;;FSYS
   Lista1:    'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
   ***---   Vehiculo1: 'Vehiculo'   ;3;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
   ***---   ListaTabla1: 'Operaciones'     ;6;1;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
FinDialogo

If Not Ok
   Cancelar
Endif

ACD(fe:1, Dialogo.Fecha1)

Message('--- ContraAsientos de Vouchers ---')
SQL.ADD(" select distinct T.Fecha1, T.TipoTr2, T.NrTrans, AC.Modelo as CodAsi, AC.* ")
SQL.ADD(" from "~DBO~".BTRANSACCIONES2 T, "~DBO~".ASIENTOSCON AC ")
SQL.ADD(" where CONVERT (Char(10), T.FechaDel, 103) = '"~Fecha(Dialogo.Fecha1,'DD/MM/YYYY')~"' ")
SQL.ADD(" and T.NrTrans = AC.NrTrans2 ")
***---SQL.ADD(" and AC.Vehiculo = '"~Dialogo.Vehiculo1~"'  ")
***---SQL.ADD(" AND T.Fecha1 >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
***---SQL.ADD(" AND AC.Estado = 'OK' ")
SQL.ADD(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif

Recorrer SQL
    MESSAGE('Voucher '~fbn('NrTrans'))
    ***---Determino si es ContraAsiento o Nota de Credito
    IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrTrans1 = '"~fbn('NrTrans')~"' AND Check2 = 1 ") = 1
        ACT(TP:1, 'NC')
    ELSE
        ACT(TP:1, 'COT')
    ENDIF
    ACT(nn:1, GetNumerador(810))
    ACD(FV:1, fbn('FechaValor'))
    ACT(VH:1, fbn('Vehiculo'))
    (.'FECHAVALOR'.)
    SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
    SQL.ADD(" ( FechaGeneracion, ")
    SQL.ADD("   FechaValor, ")
    SQL.ADD("   Vehiculo, Libro, ")
    SQL.ADD("   Modelo, Book, UDN, Centro, ")
    SQL.ADD("   Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
    SQL.ADD("   NrOperacion, NrTrans2, Fecha1, Estado ")
    SQL.ADD("    ) VALUES ( ")
    SQL.ADD("   "~Idxdate2(fsys)~", ")
    SQL.ADD("   "~Idxdate2(Val(FV:1))~", ")
    SQL.ADD("   '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
    SQL.ADD("   '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
    SQL.ADD("   '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
    SQL.ADD("   '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', "~Idxdate2(Dialogo.Fecha1)~", '"~Val(TP:1)~"') ")
    SQL.NEW
    SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
       SQL.ADD(" Detalle, CentroCosto, Book, ")
       SQL.ADD(" Alias6, Alias7, Alias8, ")
       SQL.ADD(" Alias9, Alias10, Valor1, ")
       SQL.ADD(" Valor2, Valor3 ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(nn:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
         SQL.ADD(" 'CRE', ")
       Else
         SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,2)~", "~fstr(fbn('Cantidad2'),0,2)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', ")
       SQL.ADD(" '"~fbn('Detalle')~"', '"~fbn('CentroCosto')~"', '"~fbn('Book')~"', ")
       SQL.ADD(" '"~fbn('Alias6')~"', '"~fbn('Alias7')~"', '"~fbn('Alias8')~"', ")
       SQL.ADD(" '"~fbn('Alias9')~"', '"~fbn('Alias10')~"', "~Fstr(fbn('Valor1'), 0, 2)~", ")
       SQL.ADD(" "~Fstr(fbn('Valor2'), 0, 8)~", "~Fstr(fbn('Valor3'), 0, 2)~") ")
       SQL.NEW
    Proximo
    SQL.EXEC
    ***---Marco el asiento
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
    SQL.ADD(" Set NrAsiento = '"~Val(NN:1)~"' ")
    SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    SQL.NEW
    SQL.EXEC
Proximo
