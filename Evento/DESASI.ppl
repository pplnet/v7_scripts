CrearDialogo
  Radio1         : 'Filtro: |NrAsiento|FechaGen|FechaValor';1;1;1;;;;;;0;
  Radio2         : 'Tipo: |Asiento|ContraAsiento|Ambos'   ;2;1;1;;Radio1=0;;;NO;0
  NrUnicoAsiento : 'Nr Asiento: '                                    ;3;1;1;;Radio1=0;IIF(Radio1=0, NoVacio(NrUnicoAsiento), SI);'Debe Ingresar un Nro de Asiento';NO;;;;;;IIF(Radio2=0, "Estado ='E'", IIF(Radio2=1, "Estado='COE'", "Estado IN ('E','COE')"))
  Fecha1         : 'Fecha: '                                         ;2;1;1;;Radio1=1 O Radio1=2;IIF(Radio1=1 O Radio1=2,Dialogo.Fecha1<>0,SI);'Debe Ingresar una Fecha';NO;0;
FinDialogo

If Not OK
    Cancelar
EndIf

*---------Actualizo Asientos Con NrUnicoAsiento-----------*
IF Dialogo.Radio1=0
    SQL.ADD("UPDATE "~DBO~".ASIENTOSCON ")
    IF BuscarCampo('ASIENTOSCON','Estado','NrUnicoAsiento',Dialogo.NrUnicoAsiento)  = 'E'
       SQL.ADD("SET Estado = NULL")
    ELSE
       IF BuscarCampo('ASIENTOSCON','Estado','NrUnicoAsiento',Dialogo.NrUnicoAsiento)  = 'COE'
          SQL.ADD("SET Estado = 'COT'")
       EndIF
    ENDIF
    SQL.ADD("WHERE NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento~"'")
    SQL.NEW
    SQL.EXEC
*--------------Busco Asientos por FechaGen o FechaValor-----------------------*
ELSE
    If Dialogo.Radio1=1
        SQL.ADD("SELECT NrUnicoAsiento, Estado FROM "~DBO~".ASIENTOSCON")
        SQL.ADD("WHERE FechaGeneracion='"~IdxDate(Dialogo.Fecha1)~"'")
    ELSE
        SQL.ADD("SELECT NrUnicoAsiento, Estado FROM "~DBO~".ASIENTOSCON")
        SQL.ADD("WHERE FechaValor='"~IdxDate(Dialogo.Fecha1)~"'")
    EndIf
    SQL.ADD("AND Estado IN ('E','COE')")
*---------Actualizo Asientos Utilizando Fecha-----------*
    Recorrer SQL
       SQL.ADD("UPDATE "~DBO~".ASIENTOSCON ")
       IF FBN('Estado') = 'E'
           SQL.ADD("SET Estado = NULL")
       ELSE
           IF FBN('Estado') ='COE'
               SQL.ADD("SET Estado = 'COT'")
           EndIF
       ENDIF
       IF Dialogo.Radio1=1
           SQL.ADD("WHERE FechaGeneracion='"~IdxDate(Dialogo.Fecha1)~"'")
       ELSE
           If Dialogo.Radio1=2
               SQL.ADD("WHERE FechaValor='"~IdxDate(Dialogo.Fecha1)~"'")
           EndIf
       ENDIF
       SQL.NEW
       SQL.EXEC
    Proximo
EndIf


