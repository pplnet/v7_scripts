MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 <= FSys();'Fecha inválida';SI;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;
radio2: 'Reval TIT|Mensual|Diario';;;;NO;;;;;Var('RETIDIARIO');;;;;;;;;;;;
check1: 'Regenera Pos';;;;NO;NO;;;;1

findialogo

if (not ok)
Cancelar('Evento Cancelado')
endif

if (Eqstr(Var('ACTPOS'), 'SI') y dialogo.check1 = 1)
Message('Regenera posiciones de Ops/Tr en dolares')
Ejecutarevento('REGPOS', 'fecha1', dialogo.fecha1, 'check1', 1)

Message('Resetea precio posicion')
Ejecutarevento('RESPCO', 'fecha1', dialogo.fecha1, 'especie1', '', 'check3', 1, 'check4', 1, 'check1', 1, 'check2', 1)
endif

if (Eqstr(Var('CONTAPROCE'), 'SI'))
Acn(ck:1, 1)
else 
Acn(ck:1, 0)
endif

Sqladd(" Update "~Dbo()~".VARIABLES Set Valor='SI' Where Codigo='GENASIENTO' ")
Sqlnew()
Sqlexec()

Acd(fe:1, Habiles(FSys(), -Var('FVALORCONT'), 'ARG'))
Acn(x:1, Query("Select 1 from "~Dbo()~".VARIABLES where Codigo = 'DIASCONT' "))
if (Val(x:1) = 1)
Acn(x:1, Trunc(Var('DIASCONT'), 0))
endif
if (Val(x:1) < 1)
Acn(x:1, 1)
endif
Acd(x:2, Habiles(PriDeMes(dialogo.fecha1, SI) - 1, Val(x:1), 'ARG'))

Ejecutarevento('ANUASI', 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha1, 'lista2', '', 'listatabla1', '', 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT1', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento2('CONT2', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT3', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)

Ejecutarevento('CONT19', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio2', dialogo.radio2, 'vehiculo1', dialogo.vehiculo1)


Ejecutarevento('CONT4', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'radio2', dialogo.radio2, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('TITGEN', 'fecha1', dialogo.fecha1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT18', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'radio2', dialogo.radio2, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT15', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT16', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT5', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT6', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT7', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)

Ejecutarevento('CONT8', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT9', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT11', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT10', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1, 'fecha2', FinDeMes(PriDeMes(dialogo.fecha1) - 1))

Ejecutarevento('CONT17', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1, 'fecha2', FinDeMes(PriDeMes(dialogo.fecha1) - 1))
Ejecutarevento('CONT14', 'fecha1', dialogo.fecha1, 'listatabla1', '', 'check1', Val(ck:1), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1, 'fecha2', FinDeMes(PriDeMes(dialogo.fecha1) - 1))
Ejecutarevento('CONT40', 'fecha1', dialogo.fecha1, 'nrboperacion', '', 'vehiculo1', dialogo.vehiculo1)
Ejecutarevento('CONT41', 'fecha1', dialogo.fecha1, 'nrbtrans1', '', 'vehiculo1', dialogo.vehiculo1)

if (Isdefined("MLASA"))
Ejecutarevento('CONT12', 'fecha1', dialogo.fecha1, 'vehiculo1', dialogo.vehiculo1, 'radio1', dialogo.radio1)
Ejecutarevento('CONT13', 'fecha1', dialogo.fecha1, 'vehiculo1', dialogo.vehiculo1, 'radio1', dialogo.radio1)
else 
Ejecutarevento('CONT99', 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha1, 'radio1', 0, 'nrunicoasiento1', '', 'listatabla1', '', 'listatabla2', '')
Ejecutarevento('BALASI', 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha1, 'radio1', 0)
endif

Sqladd(" Update "~Dbo()~".VARIABLES Set Valor='NO' Where Codigo='GENASIENTO' ")
Sqlnew()
Sqlexec()
Sqladd(" Update "~Dbo()~".VARIABLES Set Valor='SI' Where Codigo='CONTAPROCE' ")
Sqlnew()
Sqlexec()


