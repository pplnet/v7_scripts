*** Este evento copia una especie en base a otra.
*** Pero en lugar de insertarlo directamente en la base,
*** lo envia a la instancia de supervision (temporales)
CrearDialogo
    Especie1   : 'Especie a copiar';;;;;;;;;
    String1    : 'Nuevo codigo'    ;;;;;;;;;;Upcase(Dialogo.String1);;;'XXXXXX'
FinDialogo

IF Not Ok
  Cancelar
ENDIF

let &tabla "ESPECIES"
let &cod_abm "ESPECI"
let &claves array("Jerarquia", "Codigo")

*** Si el abm de Especies requiere doble confirmacion...
*** (Devuelve false si la supervision de abms esta desactivada)
if not DobleConf(&cod_abm)
    Cancelar('El abm de Especies no requiere doble confirmacion. No se puede generar el registro en temporales.')
Endif

let &cod_src Dialogo.Especie1
let &cod_new Upcase(Dialogo.String1)

let &existe SQL("Select 1 from "~DBO~".ESPECIES where Codigo = '"~&cod_new~"'")

If &existe = 1
    Cancelar('El codigo de especie "'~&cod_new~'" ya existe, utilice otro.')
Endif

*** Busco Jerarquia de la especie de origen
let &jer_src SQL("Select Jerarquia from "~DBO~".ESPECIES where Codigo = '"~&cod_src~"'")
*** Creo una jerarquia nueva del mismo nivel
*** (Esta funcion contempla los registros de alta temporales tambien)
let &jer_new GenerarJerarquiaByRef(&tabla, &jer_src, NO)

SQL.ADD(" SELECT                                                                              ")
SQL.ADD("  Jerarquia, Codigo,   Cupon, Nombre, Extendido, Cotiza, InteresesC,                 ")
SQL.ADD("  FEmision, Fecha, cupones, TamanioLote, VTeorico, VNominal,  Factor,                ")
SQL.ADD("  DiasMes, DiasAnio, MercadoDef, Tasa1, Tasa2, Tasa3, Observaciones,                 ")
SQL.ADD("  Valor1, Valor2, Valor3, Valor4, Valor5, Valor6, Valor7, Valor8,                    ")
SQL.ADD("  Valor10, Alias1, Alias2, Alias3, Alias4, Alias5, Alias6, Alias7,                   ")
SQL.ADD("  Alias8, Alias9, Alias10, Caracter, MaxGraficar, MinGraficar,                       ")
SQL.ADD("  MaxSupuesto, MinSupuesto, Intervalos, TipoOpcionDef, PlazoLiq,                     ")
SQL.ADD("  Security, ExNumber, ExNumbers, Issue, SType, Issuer, Guarantor, CalDate,           ")
SQL.ADD("  PutDate, ConDate, CodAlfCajaValores, CodNumCajaValores, Tipo, TipoEC, LaminaMinima,")
SQL.ADD("  TipoAccion, CantidadVotos, SyPRating, MoodysRating, Status, Sector,                ")
SQL.ADD("  IndustryGroup, CallPrice, PutPrice, DenominCajaValores, Habilitada,                ")
SQL.ADD("  FecDeshabilitacion, CodEsCuponAnterior, CodEsProximoCupon,                         ")
SQL.ADD("  CodEsCuponAdherido, Codigo1, Codigo2, Codigo3, Codigo4, FechaCorteCupon,           ")
SQL.ADD("  FechaPresentaCupon, FechaProximoCorte, FechaPagoCupon, FechaCambioTasa,            ")
SQL.ADD("  TasaIntVigente, TasaIntAnterior, IntsCapitalizados, ISIN, CUSIP, Cedel,            ")
SQL.ADD("  EuroClear, PeriodoIntereses, FormaCalculoInts, TasaAmortProxCupon, EsCupon,        ")
SQL.ADD("  CuponFeriado, PaisOrigen, Tranche, ISO, ContraespecieCupon, Indexado,              ")
SQL.ADD("  Indice, Reestructurado, ZeroCoupon, Fecha1, Fecha2, Fecha3, Fecha4,                ") 
SQL.ADD("  Fecha5, Fecha6, Fecha7, Fecha8, Fecha9, Fecha10, LocalRating1, LocalRatingSource1, ")
SQL.ADD("  LocalRating2, LocalRatingSource2, Marketability, CommonCode, MaxHoldingPeriod,     ")
SQL.ADD("  FechaAsigHoldingP, FechaVtoHoldingP, FechaRevHoldingP, FuenteCotizacion,           ")
SQL.ADD("  CodigoCotizacion, CotizaMAE, VolumenMinimo, GrupoEspecie, CantEmitida, CutOffTime, ")
SQL.ADD("  EntidadEmisora, Tipocartera, Aforo, Comprobante, OrdenFirmada, CodMAEContado,      ")
SQL.ADD("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ") 
SQL.ADD(" FROM  "~DBO~".ESPECIES                                                              ")
SQL.ADD(" WHERE Codigo = '"~&cod_src~"'                                                       ")

Recorrer SQL
