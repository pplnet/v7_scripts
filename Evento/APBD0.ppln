MostrarCuadroDeMensajes()
creardialogo
fecha1:"Fecha: ";1;1;;NO;;;;;;FSys()
string:'Path:  ';2;1;;;;NoVacio(dialogo.string);'Path Invalido';NO;Var('DIRDATANET');
radio1: '|W98|NT';;;;;;;;;0
entero1: 'Registros';;;;;;;;;Var('DNREGISTRO')
findialogo

if (not ok)
Cancelar()
endif



Message(' Ejecutando divisor de archivos de saldos y movimientos ...')
Ejecutarevento('APBD01', 'fecha1', dialogo.fecha1, 'string', dialogo.string, 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'entero1', dialogo.entero1)


Act(ww:1, primerarchivo(Mirt(Trim(dialogo.string))~'\*.dat'))

if (not Vacio(Val(ww:1)))
AbrirAscii(Mirt(Trim(dialogo.string))~Val(ww:1), 0)
Acn(nn:2, 0)
recorrer&i 1, 2

Act(x:1, LeerAscii())
if (&i = 2)
if (Incluido(Copy(Val(x:1), 1, 1), 'H|M'))
Message('Saldos y Movimientos '~Val(ww:1))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD3B', 'fecha1', dialogo.fecha1, 'fecha2', Habiles(dialogo.fecha1, -16, 'ARG'), 'string', Mirt(Trim(dialogo.string))~Val(ww:1), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'S'))
Message('Disponibilidades '~Val(ww:1))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD5', 'fecha1', dialogo.fecha1, 'string', Mirt(Trim(dialogo.string))~Val(ww:1), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'Y'))
Message('Movimientos del Dia '~Val(ww:1))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD4', 'fecha1', dialogo.fecha1, 'string', Mirt(Trim(dialogo.string))~Val(ww:1), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'C'))
Message('Cobranzas '~Val(ww:1))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD2', 'fecha1', dialogo.fecha1, 'fecha2', Habiles(dialogo.fecha1, -1, 'ARG'), 'string', Mirt(Trim(dialogo.string))~Val(ww:1), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
endif
proximo
endif

if (Val(nn:2) = 0)
CerrarAscii()
Acn(nn:2, 1)
endif

recorrer&j 2, 1000000
Act(ww:&j, proximoarchivo)

if (not ok)
break
endif

AbrirAscii(Mirt(Trim(dialogo.string))~Val(ww:&j), 0)
Acn(nn:2, 0)

recorrer&i 1, 2
Act(x:1, LeerAscii())
if (&i = 2)
if (Incluido(Copy(Val(x:1), 1, 1), 'H|M'))
CerrarAscii()
Acn(nn:2, 1)
Message('Saldos y Movimientos '~Val(ww:&j))
Ejecutarevento('APBD3B', 'fecha1', dialogo.fecha1, 'fecha2', Habiles(dialogo.fecha1, -16, 'ARG'), 'string', Mirt(Trim(dialogo.string))~Val(ww:&j), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'S'))
Message('Disponibilidades '~Val(ww:&j))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD5', 'fecha1', dialogo.fecha1, 'string', Mirt(Trim(dialogo.string))~Val(ww:&j), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'Y'))
Message('Movimientos del Dia '~Val(ww:&j))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD4', 'fecha1', dialogo.fecha1, 'string', Mirt(Trim(dialogo.string))~Val(ww:&j), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
if (Incluido(Copy(Val(x:1), 1, 1), 'C'))
Message('Cobranzas '~Val(ww:&j))
CerrarAscii()
Acn(nn:2, 1)
Ejecutarevento('APBD2', 'fecha1', dialogo.fecha1, 'fecha2', Habiles(dialogo.fecha1, -1, 'ARG'), 'string', Mirt(Trim(dialogo.string))~Val(ww:&j), 'string2', Var('DNPROCES'), 'radio1', dialogo.radio1, 'check10', 0)
endif
endif
proximo
if (Val(nn:2) = 0)
CerrarAscii()
Acn(nn:2, 1)
endif
proximo

if (Val(nn:2) = 0)
CerrarAscii()
Acn(nn:2, 1)
endif

