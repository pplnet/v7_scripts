creardialogo
nroperacion1: 'NrOperacion';;;;;;;;
entero1: 'NrInstNueva';;;;;;
entero2: 'NrInstVieja';;;;;
radio1: 'Accion|Avanza|Retrocede';;;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

Act(ni:1, Query(" Select Nombre From "~Dbo()~".INSTANCIAS Where Tabla = 'OPERACIONES' AND NrInstancia = "~FStr(dialogo.entero1, 0, 0)~" "))
Act(nj:1, Query(" Select Nombre From "~Dbo()~".INSTANCIAS Where Tabla = 'OPERACIONES' AND NrInstancia = "~FStr(dialogo.entero2, 0, 0)~" "))


if (dialogo.radio1 = 0)
Messagebox('La Operacion '~dialogo.nroperacion1~' avanzo a la instancia '~Val(ni:1))
else
Messagebox('La Operacion '~dialogo.nroperacion1~' retrocedio a la instancia '~Val(ni:1))
endif





if (Messagebox('¿Esta de acuerdo con este cambio?', 1, 2) = 7)
Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '0' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" And NrBit = "~FStr(dialogo.entero1, 0, 0)~" ")
Sqlnew()

Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor = '1' ")
Sqladd("Where NrOperacion = '"~dialogo.nroperacion1~"'")
Sqladd(" And NrBit = "~FStr(dialogo.entero2, 0, 0)~" ")
Sqlnew()

Sqlexec()
Messagebox('La Operacion: '~dialogo.nroperacion1~' permanece en la Instancia '~Val(nj:1))
endif
