HojaVisible(SI)
creardialogo
nroperacion1:'Nro.Operacion';;;;;;;;;;;;;;"TipoOp In ('MMPF','MMPFCE','TIDE') ";
radio4:'|Impresion|Reimpresion';;;;NO;NO;;;;;0

findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,7,")
CrearFont(4, "Arial,8,")
CrearFont(2, "Arial,6,B")
CrearFont(3, "Arial,12,B")
CrearFont(6, "Arial,3,")

sql.add(" Select O.FechaOp, O.Plazo, O.Vehiculo1, O.CantImpresiones1, O.FechaVto, C.RazonSocial, ")
sql.add(" C.Direccion, C.TipoInscripcion, C.CUIT, C.CodigoPostal, C.Localidad, C.PaisDir, ")
sql.add(" O.Cantidad, O.TotalIntereses, O.TotalBrutoCli1, O.TotalGanancias, O.Precio2, O.Especie, ")
sql.add(" O.NrOperacion, O.CB5, O.TipoOp, O.Cotizacion1 ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".CLIENTES C ")
sql.add("  where O.NrOperacion = B.NrOperacion            ")
sql.add("  AND C.Codigo = O.Cliente1 ")
sql.add("  and   O.NrOperacion='"~dialogo.nroperacion1~"' ")
sql.add("  and   O.FechaOp <= '"~IdxDate(FSys())~"'         ")
sql.add("  and  (O.FechaVto >= '"~IdxDate(FSys())~"'        ")
sql.add("   or  (O.FechaVto < '"~IdxDate(FSys())~"'         ")
sql.add("  and  O.NrOperacion Not In (Select M.NrOperacion from "~Dbo()~".MOVEJECUTADOS M where M.NrOperacion = '"~dialogo.nroperacion1~"' AND M.NrSaldo = 1 and M.FechaMov = O.FechaVto))) ")

if (dialogo.radio4 = 0)
sql.add("  and (O.CantImpresiones1 is null or O.CantImpresiones1 = 0)  ")
endif

Acn(t1, 0)
Act(t3, dialogo.nroperacion1)
recorrer sql
Acn(t1, 2)
if (Vacio(Fbn()['CantImpresiones1']) o Fbn()['CantImpresiones1'] = 0)
Acn(t2, 1)
else
Acn(t2, Fbn()['CantImpresiones1'] + 1)
endif
SetFilaActual(12)
recorrer&k 1, 3
Ifa()
if (&k = 1)
AFI(Fac(), 6)
else
AFI(Fac(), 8)
endif
Ifa()
Act(j:fac, '          '~Fbn('FechaOp'))
Acn(l:fac, Fbn('Plazo'))
Act(m:fac, '              '~Fbn('FechaVto'))
FormatoCeldas(l:fac, exe('F0'))
AlinearCeldas(l:fac, 'C')
sql.add(" Select RazonSocial, Direccion, Localidad, CodigoPostal, PaisDir ")
sql.add(" From "~Dbo()~".CLIENTES ")
sql.add(" Where Codigo = '"~Fbn('Vehiculo1')~"' ")
recorrer sql
Dfa()
Act(f:fac, Copy(Fbn('Direccion')~' '~Fbn('Localidad'), 1, 40))
AFI(Fac(), 5)
proximo
Ifa()
AFI(Fac(), 5)
if (Eqstr(Fbn('TipoOp'), 'MMPF'))
Act(ms:1, 'Plazo Fijo a tasa Fija')
else
Act(ms:1, 'Plazo Fijo ajustado por CER')
Act(j:fac + 1, '          '~FStr(Fbn('Cotizacion1'), 0, 8))
endif
if (Fbn('CB5') = 1)
Act(e:fac, 'Transferible '~Val(ms:1)~' '~Fbn('NrOperacion'))
else
Act(e:fac, 'Intransferible '~Val(ms:1)~' '~Fbn('NrOperacion'))
endif
Ifa()
Act(d:fac, '            '~Copy(Fbn('RazonSocial'), 1, 40))
Acn(l:fac, Fbn('Precio2'))
AFI(Fac(), 3)
Act(m:fac, '             '~FStr(((((Fbn('Cantidad') + Fbn('TotalIntereses')) / Fbn('Cantidad')) ^ (30 / Fbn('Plazo'))) - 1) * 100, 0, 8))
FormatoCeldas(h:fac..m:fac, exe('F8'))
AFI(Fac(), 7)
Ifa()
Ifa()

Act(e:fac, '     '~Fbn('CUIT'))
if (Fbn('Precio2') = 0)
Act(g:fac, 'Depósito especial por ingreso de fondos del exterior - Decreto 616/05')
endif
Ifa()
AFI(Fac(), 5)
Act(d:fac, '            '~Fbn('Direccion')~' '~Fbn('Localidad'))
Ifa()
AFI(Fac(), 10)
Ifa()
Acn(e:fac, Fbn('Cantidad'))
Act(g:fac, '     '~FStr(Fbn('TotalIntereses'), 0, 2))
Acn(j:fac, Fbn('TotalGanancias'))
Acn(m:fac, Fbn('TotalBrutoCli1'))
Ifa()
AFI(Fac(), 8)
Ifa()
Act(e:fac, BuscarCampo('ESPECIES', 'Nombre', 'Codigo', Fbn('Especie')))
Act(e:fac, Val(e:fac)~' '~Letras(Fbn('TotalBrutoCli1'), 0, 150))
SetFilaActual(Fac() + 2)
if (Val(t:2) > 1)
Act(e:fac, 'REIMPRESION')
endif
if (&k < 3)
SetFilaActual(Fac() + 4)
AFI(Fac(), 10)
Ifa()
endif
proximo
proximo

if (Val(t1) = 0)
Cancelar()('No se imprime el comprobante '~Val(t3)~', debe ser un Plazo Fijo, estar Confirmado, Vigente o ya se imprimio ')
else
sql.add(" Update "~Dbo()~".OPERACIONES                     ")
sql.add(" Set CantImpresiones1 = "~FStr(Val(t2), 0, 0)~"   ")
sql.add(" where NrOperacion  = '"~Val(t3)~"'             ")
endif

sql.new
sql.exec

ACO(1, 0)
ACO(2, 0)
ACO(3, 5)
ACO(4, 5)
ACO(5, 5)
ACO(6, 5)
ACO(7, 5)
ACO(8, 5)
ACO(9, 5)
ACO(10, 5)
ACO(11, 5)
SetFont(a:1..o:fac, 1)
setmargins(0, 2, 2, 0)
LimitesVision(n:fac)
Impresion(2, 0)
Impresion(3, 0)
