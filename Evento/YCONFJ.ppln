Sqladd(" SELECT Distinct T.NrTrans, T.TipoTr2, T.Fecha1, T.Cliente1, T.Cliente2, T.Fecha3,    ")
Sqladd("        T.Cuenta1, T.Cuenta2, T.Especie, T.Cantidad1, T.Precio1, T.Cambio1, T.Cupon1, ")
Sqladd("        T.Mercado1, T.CB6, T.NrOperacionRef1, T.CB1, T.CB2, M.NrOperacion,CT1.NrDepositante as NrDepositante1 ")
Sqladd(" FROM   "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 T, ")
Sqladd("        "~Dbo()~".CUENTAS CT1,"~Dbo()~".OPERACIONESBITS OB, "~Dbo()~".MERCADOS MER   ")
Sqladd(" WHERE  M.NrOperacion = T.NrTrans ")
