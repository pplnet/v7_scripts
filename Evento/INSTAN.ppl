* Este evento pasa una operación de Instancia
* A la Inst. Anterior (Precio1) le pone un 0 en la tabla Operaciones Bits
* Si Precio1=0 entonces pone 0 a todas las instancias anteriores de la operación
* A la Inst. Nueva (Precio2) le pone un 1 


* HojaVisible(SI)
CrearDialogo
    NrOperacion1: '# Operación :'
    Precio1 :'Inst. Anterior';;;;;;;;;0
    Precio2 :'Inst. Nueva'
FinDialogo

If Not OK
    Cancelar
EndIf

***---Si no esta la instnacia, la crea
IF SQL(" Select Count(1) From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit="~Fstr(Dialogo.Precio2,0,0)~" ") = 0
   ***---No estan las otras instancias => las inserto
   EjecutarEvento('INSBIT', Entero1 = Dialogo.Precio2, NrOperacion1=Dialogo.NrOperacion1)
ENDIF


***** Pone la/las instancia/s anterior/res en 'CERO'
SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '0' ")
*SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') and (NrBit = "~FStr(Num(Dialogo.String1),1,0)~" ) ")
If Dialogo.Precio1<>0
    * solo a la instancia anterior ingresada
    SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') and (NrBit = "~FStr(Dialogo.Precio1,1,0)~" ) ")
  Else
    * a todas las instancias 
    SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') ")
EndIf
SQL.NEW
SQL.EXEC

***** Pone la instancia siguiente en 'UNO'
SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '1' ")
SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrOperacion1~"') and (NrBit = "~FStr(Dialogo.Precio2,1,0)~" ) ")
SQL.NEW
SQL.EXEC