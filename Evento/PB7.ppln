Sqladd(" SELECT /*+ RULE */ C.NrOperacion, T.TipoTr2, T.CNFormaPago, FP.Tipo, M.Cuenta, T.Cliente2, ")
Sqladd(" M.Cantidad, C.Fecha, T.NrTrans, T.Fecha1, M.FechaMov, M.Especie, T.Cantidad2, T.Vehiculo1  ")
Sqladd(" FROM "~Dbo()~".CONCILIACIONES C, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CNFORMASPAGOCOBRO FP, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" WHERE C.NrOperacion = T.NrTrans     ")
Sqladd(" AND   T.NrTrans     = M.NrOperacion ")
Sqladd(" AND   T.CNFormaPago = FP.Codigo ")
Sqladd(" AND   C.Fecha       >= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   C.Fecha       <= "~IdxDate2(dialogo.fecha2)~" ")
Sqladd(" AND   T.TipoTr2     = 'DEVM' ")
Sqladd(" AND   FP.Tipo       = 'CHE' ")
Sqladd(" AND   (T.CB5 = '0' OR T.CB5 IS NULL OR T.CB5='') ")
if (NoVacio(dialogo.lista2))
Sqladd(" AND T.Cliente2 IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND M.Cuenta IN ("~Pipe2Comillas(dialogo.lista3)~")  ")
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND T.Vehiculo1  IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
Sqladd(" ORDER BY T.Vehiculo1, T.Cliente2, M.Cuenta, M.FechaMov, T.Cantidad2 ")

Acn(z:1, 0)
Acn(tc:1, 0)

recorrer sql
Acn(z:1, 1)
Acn(a:fac, 1)
Acd(b:fac, Fbn('Fecha'))
Act(c:fac, Fbn('NrTrans'))
Acd(d:fac, Fbn('Fecha1'))
Acd(e:fac, Fbn('FechaMov'))
Act(f:fac, Fbn('Especie'))
Acn(g:fac, Fbn('Cantidad'))
Act(h:fac, Fbn('Cliente2'))
Act(i:fac, Fbn('Cuenta'))
Acn(j:fac, Fbn('Cantidad2'))
Act(k:fac, Fbn('Vehiculo1'))
Scn(tc:1, 1)
proximo

if (Val(z:1) = 0)
Cancelar('No se encontraron cheques conciliados para los parametros solicitados.')
endif

Sqladd(" SELECT /*+ RULE */ M.*, C.Comitente ")
Sqladd(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CUENTAS C ")
Sqladd(" WHERE M.Cuenta  = C.Codigo ")
Sqladd(" AND   M.NrSaldo = 99 ")
if (NoVacio(dialogo.lista2))
Sqladd(" AND C.Comitente IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND M.Cuenta IN ("~Pipe2Comillas(dialogo.lista3)~")  ")
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND M.EnteCustodia  IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
Sqladd(" ORDER BY M.EnteCustodia, C.Comitente, M.Cuenta, M.FechaMov ")
recorrer sql
recorrer&i 1, Val(tc:1)

Acn(kk:1, 1)
Acn(mt:1, 0)

if (Eqstr(Fbn('EnteCustodia'), Val(k:&i)) y Eqstr(Fbn('Cuenta'), Val(i:&i)) y Val(aa:&i) <> 1)
if (dialogo.check1 = 1 y Fbn('FechaMov') <> Val(e:&i))
Message('No es la misma fecha.')
Acn(kk:1, 0)
endif
if (dialogo.check3 = 1)
if (Abs(Fbn('Cantidad')) <> Abs(Val(g:&i)))
Message('No es la misma cantidad.')
Acn(kk:1, 0)
endif
else
if (Abs(Abs(Fbn('Cantidad')) - Abs(Val(g:&i))) > dialogo.cantidad1)
Message('Supera el rango de tolerancia.')
Acn(kk:1, 0)
else
Acn(mt:1, (Abs(Fbn('Cantidad')) - Abs(Val(g:&i))))
endif
endif
else
Message('No es la misma Cuenta ni Vehiculo.')
if (Val(aa:&i) = 1)
Message('Matcheo con la operacion '~Val(ab:&i))
endif
Acn(kk:1, 0)
endif

if (Val(kk:1) = 1)
Acn(aa:&i, 1)
Act(ab:&i, Fbn('NrOperacion'))
Acn(ac:&i, Fbn('NrMov'))
Act(ad:&i, Fbn('Comitente'))
Act(ae:&i, Fbn('Cuenta'))
Act(af:&i, Fbn('Especie'))
Acn(ah:&i, Fbn('Cantidad'))
Acd(am:&i, Fbn('FechaMov'))
Act(an:&i, Fbn('EnteCustodia'))
Message('Movimiento encontrado.')
break
endif

if (Val(kk:1) = 0)
Message('El Cheque de la transaccion '~Fbn('NrOperacion')~' no conciliado.')
endif
proximo
