Sqladd(" SELECT /*+ RULE */ T.Fecha1, T.Cliente1, T.Cliente2, T.Especie, T.Cantidad1, T.Cuenta1, ")
Sqladd(" T.Cuenta2, T.Vehiculo1, T.Vehiculo2, T.Proveedor, T.Cantidad1, T.Cliente1, T.Cliente2, ")
Sqladd(" T.RB1, B1.Alias2 Banco1, B2.Alias2 Banco2, C1.Numero Numero1, C2.Numero Numero2, ")
Sqladd(" T.CB3, T.Observaciones, DECODE(C1.TipoCuenta,'CC ','01','CA ','02','CCE','02','CCD','02','Error') Tipo1, ")
Sqladd(" DECODE(C2.TipoCuenta,'CC ','01','CA ','02','CCE','02','CCD','02','Error') Tipo2, T.NrTrans, ")
Sqladd(" C1.Alias3 ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O, "~Dbo()~".CLIENTES B1, ")
Sqladd(" "~Dbo()~".CLIENTES B2, "~Dbo()~".CUENTAS C1, "~Dbo()~".CUENTAS C2 ")
Sqladd(" Where T.Cliente1 = B1.Codigo ")
Sqladd(" AND T.Cliente2 = B2.Codigo ")
Sqladd(" AND T.Cuenta1 = C1.Codigo ")
Sqladd(" AND T.Cuenta2 = C2.Codigo ")
Sqladd(" AND T.NrTrans = O.NrOperacion ")
Sqladd(" AND T.Fecha1 = '"~dialogo.fecha1~"' ")
Sqladd(" AND T.TipoTr2 = 'TRANSF' ")
Sqladd(" AND T.Especie = 'ARP' ")
Sqladd(" AND T.RB1 <> '1' ")
Sqladd(" AND O.NrBit = 17 ")
Sqladd(" AND O.Valor = '1' ")
Sqladd(" AND   T.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")

Sqladd(" UNION ALL ")

Sqladd(" SELECT /*+ RULE */ T.Fecha1, T.Cliente1, T.Cliente2, T.Especie, T.Cantidad1, T.Cuenta1, ")
