creardialogo
fecha1:'Fecha';;;;;;;;;;FSys()
nroperacion1: 'CONU';;;;;;;;;;;;;;"TipoOp In ('CONU') and   FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' and (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1)  and CB2=1"
radio1:'Opcion|Bloqc.|DesBl.';;;;;;NoVacio(dialogo.radio1);'Debe Ingresar una Opcion';NO;;
vehiculo1:'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select * From ")
Sqladd(" (Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, CB1, FechaVto, ")
Sqladd("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',1)) as Saldo, ")
Sqladd("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',2)) as Utilizado, ")
Sqladd("  CB8,CB9,CB10 ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" where O.NrOperacion = OB.NrOperacion ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("  and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
else
Sqladd("   and (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1) and CB2=1 ")
endif
Sqladd("   and ISNULL(O.CB10,'0') = '0' ")
if (dialogo.radio1 = 0)
Sqladd("   and ISNULL(O.CB9,'0') = '0' ")
else
Sqladd("   and ISNULL(O.CB9,'0') = '1' ")
endif
Sqladd("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")

Sqladd("and TipoOp in ('CONU') ) as Aux")
Sqladd(" Where Saldo > 0  ")
Watch(Sqlbatch())

recorrer sql

Acn(a:fac, 1)
Act(b:fac, Fbn()['NrOperacion'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Especie'])
Acn(e:fac, Fbn()['Cantidad'])
Act(f:fac, Fbn()['FechaOp'])
if (Fbn()['CB1'] = 1)
Act(g:fac, '')
else
Act(g:fac, Fbn()['FechaVto'])
endif
Act(h:fac, Fbn()['Book1'])
Acn(i:fac, Fbn()['Saldo'])
Acn(j:fac, Fbn()['Utilizado'])
Acn(k:fac, Fbn()['Saldo'])
Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';iif (dialogo.radio1 = 0, 'Bloqueo ICL - CONU', 'DesBloqueo ICL - CONU')
'Accion ?';a:1..a:fac;SI;;;70;combo;iif (dialogo.radio1 = 0, 'Bloquea|Rechaza', 'DesBloquea|Rechaza')
'Operacion';b:1..b:fac;NO;;;70;string;;
'Cliente';c:1..c:fac;NO;;;70;string;;
'Especie';d:1..d:fac;NO;;;70;string;;
'Monto Original';e:1..e:fac;NO;;;100;numero;'##,###,###,###.##';
'Fecha Op';f:1..f:fac;NO;;;80;string;;
'Fecha Vto';g:1..g:fac;NO;;;80;string;
'Book';h:1..h:fac;NO;;;60;string;
'Imp. utilizado';j:1..j:fac;NO;;;100;numero;'##,###,###,###.##';
'Saldo Capital';i:1..i:fac;NO;;;100;numero;'##,###,###,###.##';
'Imp. a Cancelar';k:1..k:fac;NO;;;100;numero;'##,###,###,###.##';
finlistbox

if (not ok)
Cancelar()
endif

if (ok)
recorrer&i 1, Fac()
if (Val(a:&i) = 0)
Message('Bloqueo/Desbloqueo CONU ... ')
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set CB8 = CB9, ")
if (dialogo.radio1 = 0)
Sqladd(" CB9 = '1', ")
else
Sqladd(" CB9 = '0', ")
endif
Sqladd(" CB10 = '1' ")
Sqladd(" Where NrOperacion = '"~Val(b:&i)~"' ")
Sqlnew()
Sqlexec()
endif
proximo
endif
else
Messagebox('No se encontraron operaciones para '~iif (dialogo.radio1 = 0, 'Bloqueo ICL - CONU', 'DesBloqueo ICL - CONU'))
endif

