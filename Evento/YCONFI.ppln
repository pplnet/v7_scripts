else
Act(sg:fac, 'Pago')
endif
else
if ((Eqstr(Fbn('TipoTr2'), 'DTP') y Eqstr(Fbn('Cliente1'), dialogo.vehiculo1)) o (Eqstr(Fbn('TipoTr2'), 'RTP') y Eqstr(Fbn('Cliente2'), dialogo.vehiculo1)))
Act(sg:fac, 'Cobro')
else
Act(sg:fac, 'Pago')
endif
endif

if (dialogo.check1 = 1)
Acn(q:fac, 1)
else
