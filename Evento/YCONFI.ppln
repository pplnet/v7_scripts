endif
proximo

if (Val(qf:1) > 0)
if (dialogo.check1 = 0)
crearlistbox;'Arial,8,';'Seleccion de Transacciones para Matcheo '
'Matcheo';q:4..q:fac;;;;18;check;RGB(220, 220, 193);;NO;NO;;NO;NO;NO;SI
'Accion';x:4..x:fac;SI;(Val(q:flb) = 0 o Val(x:flb) = 0 o Val(x:flb) = 2) o (Val(x:flb) = 1 y Val(c:flb) < dialogo.fecha2);'No se pueden Fallar Vouchers del Dia';80;combo;'Confirma|Falla|Pendiente';RGB(220, 220, 193)
'Estado';t:4..t:fac;NO;SI;;80;string;;RGB(180, 180, 193)
'';sg:4..sg:fac;NO;;;50;string;
