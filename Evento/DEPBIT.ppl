MostrarCuadroDeMensajes
CrearDialogo
  Fecha1 : 'Fecha Desde'   ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;Fsys;
  Fecha2 : 'Fecha Hasta'   ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Radio1 : 'Depura|Oper|Tran' ;;;;;;Dialogo.Radio1>=0;'¿Depura OPERACIONES o TRANSACCIONES?';NO;
FinDialogo

If Not OK
  Cancelar
EndIf

IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 2
    ***---Operaciones
    SQL.ADD(" Select Distinct O.NrOperacion ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
    SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD(" AND M.NrSaldo = 1 ")
    Recorrer SQL
        IF SQL(" Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1
            ***---No le quedan ptes.
            IF SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrBit = 50 AND Valor = '1' ") = 1
                ***---Esta en Terminal
                Message('Borrando Bits Operacion '~fbn('NrOperacion'))
                SQL.ADD(" Delete "~DBO~".OPERACIONESBITS ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND NrBit <> 50 ")
                SQL.NEW
                SQL.EXEC
            ENDIF
        ENDIF
    Proximo
ENDIF
IF Dialogo.Radio1 = 1 O Dialogo.Radio1 = 2
    ***---Transacciones
    SQL.ADD(" Select Distinct T.NrTrans ")
    SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
    SQL.ADD(" Where T.NrTrans = M.NrOperacion ")
    SQL.ADD(" AND T.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD(" AND M.NrSaldo = 1 ")
    Recorrer SQL
        IF SQL(" Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion = '"~fbn('NrTrans')~"' AND NrSaldo = 1 ") <> 1
            ***---No le quedan ptes.
            IF SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~fbn('NrTrans')~"' AND NrBit = 20 AND Valor = '1' ") = 1
                ***---Esta en Terminal
                Message('Borrando Bits Transaccion '~fbn('NrTrans'))
                SQL.ADD(" Delete "~DBO~".OPERACIONESBITS ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
                SQL.ADD(" AND NrBit <> 20 ")
                SQL.NEW
                SQL.EXEC
            ENDIF
        ENDIF
    Proximo
ENDIF