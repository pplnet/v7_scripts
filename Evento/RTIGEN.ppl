   ACT(ap:1,'')
   ACT(ap:2,'')
   ACT(ap:3,'')
   ACT(ap:4,'')

   If EqStr(FBN['Persona'],'SI')
       SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento, Apellido, Nombre, Sexo, Nacionalidad,Pais, CodigoPEP, FechaNacimiento,  ")
       SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, ")
       SQL.ADD("P.EmpleadoGobierno,P.Telefono")
       #ifdef MLASA
           SQL.ADD("from INTEGRANTESUIF ICL ")
           SQL.ADD("left join PERSONASUIF P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #else
           SQL.ADD("from INTEGRANTESCLI ICL ")
           SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #endif
       SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento= (select Isnull(substring(CUIT,3,8),'00000000') from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       
       watch(sql.batch)
       Recorrer SQL
         ACT(ap:1,Trim(FBN['Apellido']))
         ACT(ap:2,Trim(FBN['Nombre']))
         ACT(ap:3,Trim(FBN['TipoDocumento']))
         #ifdef BIND
           IF Incluido(FBN['TipoDocumento'],'CUI|CIL')
              ACT(x1,Trim(Mirt(iif(EqStr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))))
           ELSE
              ACT(x1,Trim(FBN['NrDocumento']))
           ENDIF   
         #else
            #ifdef BACS
              IF Incluido(FBN['TipoDocumento'],'CUI|CIL')
                 ACT(x1,Trim(Mirt(iif(EqStr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))))
              ELSE
                 ACT(x1,Trim(FBN['NrDocumento']))
              ENDIF   
            #else 
              ACT(x1,Trim(FBN['NrDocumento']))
            #endif
         #endif          
         ACT(ap:4,Val(X1))
       Proximo

   endif
 
   
   ACT(no:1,FBN['NrOperacion'])
   Message('--- #Op : '~Val(no:1)~' Tipo : '~FBN['TipoOp']~' Especie : '~FBN['TickerVN']~' Cliente : '~FBN['Cliente'])
   SQL.ADD("Insert into "~DBO~".UIFRTI (")
               
   SQL.ADD("Periodo, ")
   SQL.ADD("NrOperacion, ")
   SQL.ADD("Cliente, ")
   SQL.ADD("Transferencia, ")
   SQL.ADD("FechaLiq, ")
   SQL.ADD("EntidadDep, ")
   SQL.ADD("DenomEntidadOtra, ")
   SQL.ADD("NroCtaTransferencia, ")
   SQL.ADD("PaisCtaTransferencia, ")
   SQL.ADD("NroCuentaDepos, ")
   SQL.ADD("NroCuentaComit, ")
   SQL.ADD("EspecieTransf, ")
   SQL.ADD("DenomEspecieOtra, ")
   SQL.ADD("TickerVN, ")
   SQL.ADD("TipoEspecieVN, ")
   SQL.ADD("CodEspecieVN, ")
   SQL.ADD("CotizMonedaVN, ")
   SQL.ADD("MonedaVN, ")
   SQL.ADD("CantidadVN, ")
   SQL.ADD("ComparteComit, ")
   SQL.ADD("DenNoComparteComit, ")
   SQL.ADD("CantidadCli, ")
   SQL.ADD("TipoCliente, ")
   SQL.ADD("NroCUIT, ")
   SQL.ADD("TipoPersona, ")
   SQL.ADD("DenomPersona, ")
   SQL.ADD("Apellido, ")
   SQL.ADD("Nombre, ")
   SQL.ADD("TipoDoc, ")
   SQL.ADD("NroDoc ")
                 
   SQL.ADD(") values (")
   
   *Periodo
   SQL.ADD(" '"~Val(pe:1)~"', ")                 
   *NrOperacion
   SQL.ADD(" '"~Val(no:1)~"', ")
   *Cliente
   SQL.ADD(" '"~FBN['Cliente']~"', ")   
   *Transferencia
   SQL.ADD(" '"~FBN['Transferencia']~"', ")
   *FechaLiq
   SQL.ADD(" '"~IdxDate(FBN['FechaLiq'])~"', ")
   *EntidadDep
   *SQL.ADD(" '"~FBN['EntidadDep']~"', ")
   SQL.ADD(" '"~FBN['EntExterior']~"', ")
   *DenomEntidadOtra
   SQL.ADD(" '"~FBN['DenomExterior']~"', ")
   *NroCtaTransferencia
   SQL.ADD(" '"~FBN['NroCtaTransferencia']~"', ")
   *PaisCtaTransferencia
   SQL.ADD(" '"~FBN['PaisCtaTransferencia']~"', ")
   *NroCuentaDepos
   SQL.ADD(" "~FStr(FBN['NroCuentaDepos'],0,0)~", ")
   *NroCuentaComit
   SQL.ADD(" "~FStr(FBN['ComitArgentina'],0,0)~", ")
   *EspecieTransf
   SQL.ADD(" '"~FBN['EspecieTransf']~"', ")
   *DenomEspecieOtra
   SQL.ADD(" '"~FBN['DenomEspecieOtra']~"', ")
   *TickerVN
   SQL.ADD(" '"~FBN['TickerVN']~"', ")
   *TipoEspecieVN
   SQL.ADD(" '"~FBN['TipoEspecieVN']~"', ")
   *CodEspecieVN
   SQL.ADD(" '"~FBN['CodEspecieVN']~"', ")
   *CotizMonedaVN
   ** AA 25-10-2025 - se incorpora MONPAIS en CONFIGVALEXTERNOS para determinar la monedaFPA (PaisEspecie)
   ACT(x3,Trim(SQL(" Select Valor from CONFIGVALEXTERNOS where CodigoProceso='UIF' and Atributo='MONPAIS' AND ValorSistemaExterno ='"~FBN['PaisEspecie']~"'")))
   ** AA 25-10-2025 BOFA Debe ser el valor de la cotización del día anterior al día de la liquidación a reportar, pero como máximo 30 días para atrás, de lo contrario va en ceros
   ACN(zx1,100*SQL("Select Top(1) Precio1 From COTIZACIONES CO Where Codigo = '"~FBN['TickerVN']~"' AND Moneda = '"~Val(x3)~"' AND Fecha between "~IdxDate2(FBN['FechaLiq']-31)~" and "~IdxDate2(FBN['FechaLiq']-1)~" Order By Fecha Desc"))
   **ACN(zx1,FBN['CotizMonedaVN']*100)
   ACN(zx2,TRUNC(Val(zx1),0))
   SQL.ADD(" "~FStr(Val(zx2)/100,0,2)~", ")
   *MonedaVN
   ** AA 25-10-2025 se toma la especie de la relacion Pais en CONFIGVALEXTERNOS
   ACT(x2,Trim(SQL(" Select Valor from CONFIGVALEXTERNOS where CodigoProceso='UIF' and Atributo='MONEDA' AND ValorSistemaExterno ='"~Val(x3)~"'")))
   SQL.ADD(" '"~Val(x2)~"', ")
   *CantidadVN
   SQL.ADD(" "~FStr(FBN['CantidadVN'],0,2)~", ")
   *ComparteComit
   SQL.ADD(" '"~FBN['ComparteComit']~"', ")
   *DenNoComparteComit
   SQL.ADD(" '"~FBN['DenNoComparteComit']~"', ")
   *CantidadCli
   SQL.ADD(" "~FStr(FBN['CantidadCli'],0,0)~", ")
   *TipoCliente
   SQL.ADD(" '"~FBN['TipoCliente']~"', ")
   *NroCUIT
   SQL.ADD(" "~FStr(FBN['NroCUIT'],0,0)~", ")
   *TipoPersona
   SQL.ADD(" '"~iif(EqStr(FBN['Pais'],VAR('PAISARG')),FBN['TipoPersona'],FBN['TipoPersona']~' extranjera')~"', ")
   *DenomPersona
   SQL.ADD(" '"~FBN['DenomPersona']~"', ")
   *Apellido
   SQL.ADD(" '"~Val(ap:1)~"', ")
   *Nombre
   SQL.ADD(" '"~Val(ap:2)~"', ")
   *TipoDoc 
   SQL.ADD(" '"~Val(ap:3)~"', ")              
   *NroDoc 
   SQL.ADD(" '"~Val(ap:4)~"' ")
                 
   SQL.ADD(")")
   SQL.NEW
   SQL.EXEC
                 

** Generar 1 registro por cada integrante del cliente de cada operacion en UIFRTIOTR
  * If EqStr(FBN['Persona'],'SI')
       ACN(NI:1,0)
       *SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento OtroDoc, Case When isnumeric("~(PAD0(ICL.NrDocumento,0)~")=1 then ICL.NrDocumento else 0 end NrDocumento, ")
       SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento,  ")       
       SQL.ADD("'Persona humana' TipoPersona, Apellido,Nombre, Sexo, Nacionalidad,P.Pais, CodigoPEP, FechaNacimiento,  ")
       SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, NrIntegrante, ICL.Codigo Cliente, ")
       SQL.ADD("P.EmpleadoGobierno,P.Telefono, Isnull(P.Cuit,'') CUIT ")
       #ifdef MLASA
           SQL.ADD("from INTEGRANTESUIF ICL ")
           SQL.ADD("left join PERSONASUIF P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #else
           SQL.ADD("from INTEGRANTESCLI ICL ")
           SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #endif
       SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento <> (select Isnull(substring(CUIT,3,8),'00000000') from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       
       watch(sql.batch)
       Recorrer SQL

       Message('--- #Op : '~Val(no:1)~' Cliente : '~FBN['Cliente']~' Integrante : '~FBN['TipoPoder'])
         
       
         ACT(po:1,Trim(SQL(" Select Valor from CONFIGVALEXTERNOS where CodigoProceso='UIF' and Atributo='TIPOINTEGRANTE' AND ValorSistemaExterno ='"~FBN['TipoPoder']~"'")))
         SCN(NI:1,1)

         SQL.ADD("Insert into "~DBO~".UIFRTIOTR (")         
         SQL.ADD("Periodo, ")
         SQL.ADD("NrOperacion, ")
         SQL.ADD("NroIntegrante, ")
         SQL.ADD("Vinculo, ")
         SQL.ADD("NroCUIT, ")
         SQL.ADD("TipoPersona, ")
         SQL.ADD("Apellido, ")
         SQL.ADD("Nombre, ")
         SQL.ADD("TipoDoc, ")
         SQL.ADD("NroDoc ")
                 
         SQL.ADD(") values (")
            
         *Periodo
         SQL.ADD(" '"~Val(pe:1)~"', ")
         *NrOperacion
         SQL.ADD(" '"~Val(no:1)~"', ")
         *NroIntegrante
         SQL.ADD(" '"~FStr(Val(NI:1),0,0)~"', ")
         *Vinculo
         SQL.ADD(" '"~Val(po:1)~"', ")
         *NroCUIT
         #ifdef BIND
           IF NoVacio(FBN['CUIT'])
              ACT(x1,Trim(FBN['CUIT']))
           ELSE
              ACT(x1,Trim(FBN['NrDocumento']))
           ENDIF   
         #else
            #ifdef BACS
              IF NoVacio(FBN['CUIT'])
                 ACT(x1,Trim(FBN['CUIT']))
              ELSE
                 ACT(x1,Trim(FBN['NrDocumento']))
              ENDIF   
            #else 
              ACT(x1,FStr(FBN['CUIT'],0,0))
            #endif
         #endif                            
         SQL.ADD(" "~Val(X1)~", ")
         *TipoPersona
         SQL.ADD(" '"~iif(EqStr(FBN['Pais'],VAR('PAISARG')),FBN['TipoPersona'],FBN['TipoPersona']~' extranjera')~"', ")
         *Apellido
         SQL.ADD(" '"~FBN['Apellido']~"', ")
         *Nombre
         SQL.ADD(" '"~FBN['Nombre']~"', ")
         *TipoDoc 
         SQL.ADD(" '"~FBN['TipoDocumento']~"', ")              
         *NroDoc 
         #ifdef BIND
           IF Incluido(FBN['TipoDocumento'],'CUI|CIL')
              ACT(x1,Trim(Mirt(iif(EqStr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))))
           ELSE
              ACT(x1,Trim(FBN['NrDocumento']))
           ENDIF   
         #else
            #ifdef BACS
              IF Incluido(FBN['TipoDocumento'],'CUI|CIL')
                 ACT(x1,Trim(Mirt(iif(EqStr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))))
              ELSE
                 ACT(x1,Trim(FBN['NrDocumento']))
              ENDIF   
            #else 
              ACT(x1,Trim(FBN['NrDocumento']))
            #endif
         #endif                   
         SQL.ADD(" '"~Val(X1)~"' ")        
         
         SQL.ADD(")")
         SQL.NEW
         SQL.EXEC
         
       Proximo

  * endif

Proximo
