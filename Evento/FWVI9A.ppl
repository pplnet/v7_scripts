CrearDialogo
  NrOperacion1 : 'Nr.Operacion' ;
  Entero2: 'Origen'
  Entero3: 'Destino'
FinDialogo

If Not Ok
  Cancelar
Endif
* Tratamiento para las operaciones que liquidan en IRSA (Contenidas en las variables VLIQUIDA y VLIQUIDA2)
      ACT(z:2,Dialogo.NrOperacion1)   
*************** ORIGEN ************

* MessageBox('Test') 
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = '0' ")
    SQL.ADD(" Where NrOperacion = '"~Val(z:2)~"' ")
    SQL.ADD(" and NrBit         =  "~Fstr(Dialogo.Entero2,2,0)~"  ")
    SQL.NEW
    SQL.EXEC

*************** DESTINO ************
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = '1' ")
    SQL.ADD(" Where NrOperacion = '"~Val(z:2)~"' ")
    SQL.ADD(" and NrBit         =  "~Fstr(Dialogo.Entero3,2,0)~"  ") 
    SQL.NEW
    SQL.EXEC



