**-- VIMINL: Minuta Diaria de Cuenta Corriente Vinculadas POR LOTES
* HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(FSYS-1,1,'ARG',SI)
FinDialogo

if not Ok
  Cancelar
endif

* Verifica Tasas para Todos los pares de Vehiculos
(."VIVERITASA".)

* Obtengo el Anterior Dia Habil para controlar que no se haya generado 
* la operacion de intereses
ACD(Z10,HABILES(Dialogo.Fecha1,-1,'ARG',SI))

* Obtengo Todos los Pares de Vehiculos CB6=1 => Todos los Originales
SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.Vehiculo2,O.Especie  ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where ((O.TipoOp='VIMD' and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("       or (O.TipoOp='VIMIND' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("       or (O.TipoOp='VIMINM' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD(" and CB6='1' ")
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT * ")
SQL.ADD("from "~DBO~".OPERACIONES Op")
SQL.ADD("where Op.TipoOp='VIMIND' and Op.FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("      and Op.Vehiculo1=O.Vehiculo1 and Op.Vehiculo2=O.Vehiculo2  and Op.Especie=O.Especie) ")
SQL.ADD("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

ACN(AB1,0)

Recorrer SQL
   Message('Procesando Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Vehiculo2']~' Especie:'~FBN['Especie']~' ...')

   ACT(AV1,FBN['Vehiculo1'])
   ACT(AV2,FBN['Vehiculo2'])
   ACT(AE1,FBN['Especie'])
   ACD(AF1,Dialogo.Fecha1)

   * Verifico que todas las operaciones esten en BackOffice O Terminal
   (."VERIINSVIN".)

   * Recupero la tasa para los pares de vehiculos
   * Si no lo encuentro cancelo
   ACN(a1,SQL("SELECT Tasa from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~FBN['Vehiculo1']~"' and Vehiculo2='"~FBN['Vehiculo2']~"') or (Vehiculo1='"~FBN['Vehiculo2']~"' and Vehiculo2='"~FBN['Vehiculo1']~"')) and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))

   IF Val(a1)<>0
      EjecutarEvento('VIMIND',Fecha1=Dialogo.Fecha1,Vehiculo1=FBN['Vehiculo1'],Vehiculo2=FBN['Vehiculo2'],Especie1=FBN['Especie'],Precio1=VAL(a1))
   Else
      Cancelar(' Falta cargar la Tasa Diaria para '~FBN['Vehiculo1']~'/'~FBN['Vehiculo2']~' '~FBN['Especie']~' ....')
   Endif

   SCN(AB1,1)
Proximo  
  
IF VAL(AB1)=0
   * No se generaron intereses
   MessageBox('No Existen Operaciones Vinculadas para la fecha ...')
ENDIF
