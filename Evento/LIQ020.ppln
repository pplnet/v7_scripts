Sqladd("Select MP.NrOperacion,  MP.FechaMov, MP.Cliente,     MP.Especie, MP.Mercado, ")
Sqladd("       MP.EnteCustodia, MP.Cantidad, MP.Leyenda,     MP.Bits,    MP.NrSaldo, ")
Sqladd("       MP.Cuenta,       MP.NrMov,    MP.Transaccion, MP.Book,    MP.Vehiculo, ")
Sqladd("       MP.NrGrupo,      MP.Concepto, MP.Status,      MP.Cupon,   MP.Formula, ")
Sqladd("       MP.NrGrupo2,     MP.NrInstan, ")
Sqladd("       O.ConceptoFail ")
Sqladd("  from "~Dbo()~".MOVPENDIENTES MP, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS B ,"~Dbo()~".OPERACIONES O      ")
Sqladd(" where MP.Cliente    = C.Codigo                                                                           ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("     AND MP.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("       AND MP.NrOperacion = B.NrOperacion                 ")
Sqladd("       AND MP.NrOperacion = O.NrOperacion                 ")
Sqladd("       AND B.NrBit       = 10                             ")
Sqladd("       AND B.Valor       = '1'                            ")
Sqladd("       AND MP.FechaMov   = "~IdxDate2(dialogo.fecha1)~"   ")
Sqladd("       AND O.TipoOp In ('TIC','TIV','TIFV','TIFC','TCOPRI')  ")
if (NoVacio(dialogo.vehiculo1))
Sqladd("    AND MP.EnteCustodia = '"~dialogo.vehiculo1~"'   ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd("     AND MP.Cliente = '"~dialogo.cliente1~"'         ")
endif
Sqladd("       AND O.Mercado = '"~dialogo.mercado1~"'             ")
Sqladd("       AND Exists (SELECT 1 FROM "~Dbo()~".MOVPENDIENTES MP2   ")
Sqladd("                    WHERE MP2.NrOperacion=MP.NrOperacion     ")
Sqladd("                      AND MP2.Especie=MP.Especie             ")
Sqladd("                    GROUP BY MP2.NrOperacion, MP2.Especie    ")
Sqladd("                   HAVING COUNT(1)=1 )                       ")
Sqladd(" ORDER BY MP.NrOperacion                              ")
else
Sqladd("Select distinct O.TipoOp, O.NrOperacion, O.Mercado,             O.FechaOp,       O.FechaVto, ")
Sqladd("       O.Cliente1,        O.Precio1,     O.Especie,             O.ContraEspecie, O.Cantidad, ")
Sqladd("       O.TotalNetoCli1,   C.RazonSocial, O.FechaAltaSisExterno, O.Book1,         ")
Sqladd("       O.ConceptoFail ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".MERCADOS M2 ")
Sqladd(" where O.Cliente1    = C.Codigo ")
Sqladd("   AND O.NrOperacion = B.NrOperacion ")
Sqladd("   AND B.NrBit       = 10 ")
Sqladd("   AND B.Valor       = '1' ")
Sqladd("   AND ((O.FechaVto  = "~IdxDate2(dialogo.fecha1)~" ) OR (O.FechaAltaSisExterno="~IdxDate2(dialogo.fecha1)~" AND O.FechaAltaSisExterno IS NOT NULL)) ")
if (NoVacio(dialogo.vehiculo1))
Sqladd(" and O.Vehiculo1   = '"~dialogo.vehiculo1~"'")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" and O.Cliente1    = '"~dialogo.cliente1~"' ")
endif
Sqladd("   and O.TipoOp      In ('TIC','TIV','TIFV','TIFC','TCOPRI') ")
Sqladd("   and O.Mercado     = '"~dialogo.mercado1~"' ")
Sqladd("   and O.NrOperacion not in (select NrOperacion from "~Dbo()~".MOVEJECUTADOS M ")
Sqladd("                              where M.NrOperacion = O.NrOperacion ")
Sqladd("                                AND NrSaldo       IN (1,31) ) ")
Sqladd(" order by O.NrOperacion ")
endif
