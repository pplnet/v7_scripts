Mostrarcuadrodemensajes

if NOt ExisteDirectorio(VAR("PATHBRCTAE"))
     MessageBox("No existe el directorio "~VAR("PATHBRCTAE"))
     Cancelar
endif


if NOt ExisteArchivo(VAR("PATHBRCTAE")~'\'~VAR("ARCHBRCTAE"))
     MessageBox("No existe el Archivo "~VAR("PATHBRCTAE")~'\'~VAR("ARCHBRCTAE"))
     Cancelar
endif

if NOt ExisteDirectorio(VAR("PATHBRCTAE")~'\PROCESADOS')
    WinExec("CMD.EXE /C CD "~VAR("PATHBRCTAE"), 0)
    WinExec("CMD.EXE /C MKDIR "~VAR("PATHBRCTAE")~'\PROCESADOS', 0)
endif   

ACT(aa:2,SQL("select convert(varchar(8),Getdate(),112)"))

AbrirASCII(VAR("PATHBRCTAE")~'\'~VAR("ARCHBRCTAE"),0)

Recorrer&ai 1,2000

    ACT(aa:1, LeerAscii)
    
    if Not Ok
        break
    endif

    if Eqstr(COPY(VAL(aa:1),36,1),'2')
    
        if Eqstr(COPY(VAL(aa:1),248,2),'PR')
        
            if SQL("Select Count(*) from dbo.MOVCTASEXT where IdReferencia ='" ~COPY(VAL(aa:1),77,9)~ "' and TipoReferencia='V' and Accion='PR'") = 0
                
                SQL.ADD("select Cuenta1,Especie1,Vehiculo1,Mercado1,Cliente1 from dbo.TRANSACCIONES2 TR")
                SQL.ADD("where TR.NrTrans = '"~COPY(VAL(aa:1),77,9)~"' ")
                
                Recorrer SQL
                    
                    SQL("update dbo.MOVCTASEXT set accion='PR', Fechavalor='"~COPY(VAL(aa:1),100,8)~ "' where IdReferencia ='" ~COPY(VAL(aa:1),77,9)~ "' and TipoReferencia='V'" )
                    
                    ACT(aa:3,COPY(VAL(aa:1),107,2)~"\"~COPY(VAL(aa:1),104,2)~"\"~COPY(VAL(aa:1),100,4))
                    
                    EjecutarEvento('ZCONFI','','','','','','','',COPY(VAL(aa:1),77,9),0)
                    
                proximo 
                

                endif
        endif
        
    endif
    
Proximo

CerrarASCII
WinExec("CMD.EXE /C copy "~VAR("PATHBRCTAE")~'\'~VAR("ARCHBRCTAE")~" "~VAR("PATHBRCTAE")~"\PROCESADOS\"~VAR("ARCHBRCTAE")~"["~copy(Val(aa:2),1,4)~copy(Val(aa:2),5,2)~copy(Val(aa:2),7,2)~"-"~copy(Hora(SQLAhora),1,2)~copy(Hora(SQLAhora),4,2)~copy(Hora(SQLAhora),7,2)~"]",0 ) 
WinExec("CMD.EXE /C del "~VAR("PATHBRCTAE")~'\'~VAR("ARCHBRCTAE"),0 ) 


MessageBox('El evento ha finalizado')    
HojaVisible(NO)
GrillaVisible(NO)
