Sqladd(" CT.Plazo1 Pl, O.OperacionRef OpRef, O.Cantidad Cant, O.TipoOp TipoOp,")
Sqladd(" CT.Cantidad2 CTCa2, 2 Uni_Mul ")
Sqladd(" From "~Dbo()~".COMISIONES2 C, "~Dbo()~".CUOTAS CT, "~Dbo()~".OPERACIONES O ")
Sqladd(" Where O.NrOperacion = '"~Fbn()['NrOp']~"' ")
Sqladd("   and O.NrOperacion = CT.NrOperacion ")
Sqladd("   and CT.NrOperacion = C.NrOperacion ")
Sqladd("   and C.NrCuota = '"~Fbn()['Cuota']~"' ")
Sqladd("   and C.NrCuota = CT.NrCuota ")
Sqladd("   and C.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
endif

Sqladd(" Order by Fe1, Tipo, Cuota ")

