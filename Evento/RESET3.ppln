creardialogo
fecha1: 'Fecha';;;;;;;;;FSys()
vehiculo1: 'Vehiculo'
book1: 'Book'
especie1: 'Especie'
findialogo

if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.especie1))
Act(a1, ", '"~dialogo.especie1~"'")
else
Act(a1, ", ' '")
endif
if (NoVacio(dialogo.vehiculo1))
Act(a1, Val(a1)~" , '"~dialogo.vehiculo1~"'")
else
Act(a1, Val(a1)~" , ' '")
endif
if (NoVacio(dialogo.book1))
Act(a1, Val(a1)~" , '"~dialogo.book1~"'")
else
Act(a1, Val(a1)~" , ' '")
endif

Sqladd("exec CalcularPrecioReset '"~IdxDate(dialogo.fecha1)~"' "~Val(a1))
Sqlnew()
Sqlexec()


