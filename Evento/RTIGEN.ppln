Message(' - Borrando Archivos RTI - UIFRTI - UIFRTIOTR')
Sqlnew()
Sqladd("Delete from "~Dbo()~".UIFRTI Where Periodo='"~Pad0(dialogo.entero1, 4)~Pad0(dialogo.entero2, 2)~"' ")
Sqlnew()
Sqladd("Delete from "~Dbo()~".UIFRTIOTR Where Periodo='"~Pad0(dialogo.entero1, 4)~Pad0(dialogo.entero2, 2)~"' ")
Sqlnew()
Sqlexec()

Act(pe:1, Pad0(dialogo.entero1, 4)~Pad0(dialogo.entero2, 2))

Sqladd("Select O.NrOperacion, TipoOp,")
Sqladd("Case O.TipoOp when 'TIC' Then 'Recibida' Else 'Emitida' End Transferencia, C.Persona, ")
Sqladd(" O.FechaVto FechaLiq, Case when O.Mercado in ("~Pipe2Comillas(Var('UIFRTIMER'))~") then M.DescUIF else 'Otra' end EntExterior,  ")
Sqladd(" Case when O.Mercado not in ("~Pipe2Comillas(Var('UIFRTIMER'))~") then M.Descripcion else '' end DenomExterior, ")
Sqladd("  TE.DescUIF EspecieTransf , ")
Sqladd(" C.CodComitente , (select Top(1) NrDepositante from "~Dbo()~".CUENTAS Where Cliente = O.Cliente1 and Comitente = '"~Var('VEHICULODE')~"' and TipoCuenta = 'CUS' and NrDepositante is not Null) as ComitArgentina, ")
Sqladd(" O.Cliente1 Cliente, (select ISO from "~Dbo()~".ESPECIES Where Codigo=O.ContraEspecie)  MonedaVN,")
Sqladd(" E.Nombre DenomEspecieOtra, O.Especie TickerVN,  O.Cantidad CantidadVN, ")
Sqladd(" C.CUIT NroCUIT, Case when E.ISIN <> '' Then 'ISIN' when E.CUSIP <> '' Then 'CUSIP' else 'Otro' End TipoEspecieVN, ")
Sqladd(" Case when E.ISIN <> '' Then E.ISIN when E.CUSIP <> '' Then E.CUSIP else 'SinCodigo' End CodEspecieVN, ")
Sqladd(" Case When C.Jerarquia like '"~Var('JERFONDOS')~"%' Then 'FCI' When C.Sector = 'PUB' Then 'Organismo Publico' When C.TipoInscripcion = 'FDI' Then 'Fideicomiso' Else 'Otro' End TipoCliente, ")
Sqladd(" Case When C.Persona = 'NO' Then 'Persona jurídica' When C.Persona = 'SI' Then 'Persona humana' Else 'SinTipoPersona' End TipoPersona, ")
Sqladd(" Deposdelcomitente NroCuentaDepos, C.Pais, E.PaisOrigen PaisEspecie, ")
Sqladd(" (select count(*) from "~Dbo()~".INTEGRANTESCLI IT where IT.Codigo = C.Codigo) as CantidadCli, C.RazonSocial DenomPersona, ")
Sqladd(" CU.Numero NroCtaTransferencia, CO.Pais PaisCtaTransferencia, 'NO' ComparteComit , '"~Var('RTICONTEXT')~"' DenNoComparteComit ")
Sqladd("  From "~Dbo()~".OPERACIONES O  ")
Sqladd("  LEFT OUTER JOIN "~Dbo()~".CLIENTES C on O.Cliente1=C.Codigo ")
Sqladd("  LEFT JOIN "~Dbo()~".CUENTAS CU on O.Cuenta2=CU.Codigo ")
Sqladd("       Left JOIN "~Dbo()~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
Sqladd("       Left JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
Sqladd("       Left JOIN "~Dbo()~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ")
Sqladd("       Left JOIN "~Dbo()~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
Sqladd("       Left JOIN "~Dbo()~".TIPOESPECIE TE WITH (NOLOCK) ON  E.Tipo=TE.Codigo ")
Sqladd("Where  B.Valor='1' and B.Nrbit not in (30)")
Sqladd("  and O.FechaOp between "~IdxDate2(dialogo.fecha1)~" and "~IdxDate2(dialogo.fecha2))
Sqladd("  and O.Mercado in  ("~Pipe2Comillas(Var('UIFRTIMERC'))~") ")
Sqladd(" and O.TipoOp In  ('TIC','TIV') ")
Watch(Sqlbatch())
Acn(xy1, 0)
recorrer sql

