Sqladd("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, ")
Sqladd("P.EmpleadoGobierno,P.Telefono")
Sqladd("from INTEGRANTESCLI ICL ")
Sqladd("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
Sqladd(" Where ICL.Codigo='"~Fbn()['Cliente']~"' and ICL.NrDocumento= (select Isnull(substring(CUIT,3,8),'00000000') from CLIENTES where Codigo='"~Fbn()['Cliente']~"') ")

Watch(Sqlbatch())
recorrer sql
