* INS - Insert de Sindicadas
* HOJAVISIBLE(SI)
*- NrOperacion1 es la operacion que cedio 
*- NrOperacion2 es la operacion nuevo que genero
CrearDialogo
   NrOperacion1:'Op  Cabecera'
   NrOperacion2:'Op. Participante'
   String1     :'Condicion de Select Cuotas'
FinDialogo

If not Ok
 Cancelar
EndIf

ACN(B1,SQL(" SELECT Sum(Tasa1) as SumTasa FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' "))

SQL.ADD(" SELECT * FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' Order By NrCuota ")

* B2 Contador de Cuotas
ACN(B3,0)

Recorrer SQL

  ACN(B2,100*FBN['Tasa1']/VAL(B1))

  SQL.ADD(" Update "~DBO~".CUOTAS SET ")
  SQL.ADD(" Tasa1= "~Fstr(VAL(B2),0,2)~" ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
  SQL.ADD(" and NrCuota="~FStr(FBN['NrCuota'],2,0)~" ")
  SQL.NEW
  SQL.EXEC

  SCN(B3,1)
Proximo

*- A50: Tipo de Operacion 
ACT(a50,BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion2))

* A10: Unidad de Tiempo Calculo de Intereses
ACN(A10,IIF(EqStr(BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion2),'0'),36000,36500))

* vn del periodo
ACN (A3,BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion2))

* TASA IVA A20 WH A21 Imp.Interes A40
ACN (A20,BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion2))
ACN (A21,BuscarCampo('Operaciones','TotalAux1' ,'NrOperacion',Dialogo.NrOperacion2))
ACN (A40,BuscarCampo('Operaciones','TasaImp1'  ,'NrOperacion',Dialogo.NrOperacion2))

* UT IVA A24 WH A25
ACT (A24,BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion2))
ACT (A25,BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion2))

* LOCAL O EXTRANJERO
ACT (A26,BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion2))

*-- Calculo CUOTAS
SQL.ADD(" SELECT * FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
If NOVACIO(Dialogo.String1)   
   SQL.ADD(" and "~Dialogo.String1~" ")
EndIf
SQL.ADD("Order By NrCuota ")

Recorrer SQL
  Message('Recorriendo las Cuotas ')
  * A4 es el interes
  * A11 es el interes total
  * A5 es el monto
  * A6 es el monto total
  * A7 es el importe iva
  * A8 es el importe wh
  * A41 es el importe wh
  * A9 es el importe de amortizaci¦n del per¦odo
  * A30 Y 31 360 O 365 PARA IVA Y WH

  ACN(A7,0)
  ACN(A8,0)
  ACN(A41,0)

  If Val(a20)<>0
     * Calculo del Iva si la tasa es distinta de 0
     * PARA UT
     IF EQSTR(VAL(A24),'0')
        ACN(A30,360)
     ELSE
        ACN(A30,365)
     ENDIF
     ACN (A7, val(a3)*(FBN['Tasa2']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)) 
     ACN (A7, val(a7)*val(a20)/100)
  EndIf

  * INTERES
  acn (a4, val(a3) * ((FBN['Precio2']+FBN['Precio4'])/100) * FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))

  * PARA LOCAL O EXTRANJERO
  IF EQSTR(val(A26), '0')
     * Para Sindicado el impuesto extranjero es para entidad local 
     * Para FRN  el impuesto extranjero es para entidad Extranjera
     IF Not EqStr(VAL(a50),'MMFIMV')
        acn(a41,VAL(a4)*VAL(a40)/100)
     EndIf
  ELSE
     IF EqStr(VAL(a50),'MMFIMV')
        acn(a41,VAL(a4)*VAL(a40)/100)
     EndIf

     IF EQSTR(VAL(A25),'0')
        ACN(A31,360)
     ELSE
        ACN(A31,365)
     ENDIF
     ACN (A8, val(a3)*(FBN['Total6']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1) )
     acn (a8,val(a8)*(VAL(A21)/100) )
  ENDIF

  Message('Calcula el importe de amortizaci¦n del per¦odo')
  acn(A9, BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion2) * FBN['Tasa1'] / 100)

  * INTERES TOTAL
  acn (a11, val(a4) + val(a8) + val(a41))

  * MONTO
  ACN (A5, val(a9) +VAL(A4))

  * MONTO TOTAL
  ACN (A6, val(a9) +VAL(A11))

  SQL.ADD("Update "~DBO~".CUOTAS SET ")
  SQL.ADD(" Cantidad2= "~Fstr(VAL(A3),0,2)~" , ")
  SQL.ADD(" Cantidad4= "~Fstr(VAL(A9),0,2)~" , ")
  SQL.ADD(" Cantidad5= "~Fstr(VAL(A11),0,2)~", ")
  SQL.ADD(" Cantidad3= "~Fstr(VAL(A4),0,2)~" , ")
  SQL.ADD(" Precio5= "~Fstr(VAL(A4),0,2)~", ")
  SQL.ADD(" Precio1= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Precio6= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Precio3= "~Fstr(VAL(A8),0,2)~", ")
  SQL.ADD(" Precio7= "~Fstr(VAL(A8),0,2)~", ")
  SQL.ADD(" Total2= "~Fstr(VAL(A5),0,2)~" , ")
  SQL.ADD(" Total9= "~Fstr(VAL(A41),0,2)~", ")
  SQL.ADD(" Total1= "~Fstr(VAL(A6),0,2)~" , ")
  SQL.ADD(" Cantidad2Ori= "~Fstr(VAL(A3),0,2)~", ")
  SQL.ADD(" Cantidad1Ori= "~Fstr(VAL(A9),0,2)~", ")
  SQL.ADD(" ResultadoIndice= 0 ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
  SQL.ADD(" AND NrCuota="~FStr(FBN['NrCuota'],2,0)~" ")
  SQL.NEW
  SQL.EXEC
  
  *-- amortiza
  ACN (A3, val(A3)-VAL(A9))
Proximo

* Actualizo la Cantidad de Cuotas
SQL.ADD("Update "~DBO~".OPERACIONES SET ")
SQL.ADD(" Cuotas1= "~Fstr(VAL(B3),0,0)~" ")
SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
SQL.NEW
SQL.EXEC











