SetFilaActual(FAC+2)
ACT(a:FAC, 'Transacciones ACUPON')
IFA
ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'TipoTr')
ACT(c:FAC, 'Fecha Act')
ACT(d:FAC, 'Fecha Corte')
ACT(e:FAC, 'Fecha Pago')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Esp.Cupon')
ACT(h:FAC, 'Mon Pago')
ACT(i:FAC, 'Cup')
ACT(j:FAC, 'Cup Ant')
ACT(k:FAC, 'Pre.Cup')
ACT(l:FAC, 'Pre.Cup $')
ACT(m:FAC, 'Pre.Cup $ Ant')
ACT(n:FAC, 'Cot.USD')
ACT(o:FAC, 'Pre.Cup $ Nue')

ACT(p:FAC, 'Est.Mov')
ACT(q:FAC, 'Fecha.Mov')
ACT(r:FAC, 'Especie')
ACT(s:FAC, 'Cupon')
ACT(t:FAC, 'NrSaldo')
ACT(u:FAC, 'Cantidad')
ACT(v:FAC, 'Precio Mov')
ACT(w:FAC, 'Precio Nue')
ACN(w:3, FAC)

SQL.ADD("Select * From "~DBO~".TRANSACCIONES2 ")
SQL.ADD("Where Fecha3 = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("  and TipoTr2 in ('ACUPON') ")
SQL.ADD("  and Especie4 <> '"~VAR('MONELOCA')~"' ")
Recorrer SQL
  Message(fbn('TipoTr2')~' '~fbn('NrTrans'))
  ACT(a:FAC, fbn('NrTrans'))
  ACT(b:FAC, fbn('TipoTr2'))
  ACD(c:FAC, fbn('Fecha3'))
  ACD(d:FAC, fbn('Fecha1'))
  ACD(e:FAC, fbn('Fecha2'))
  ACT(f:FAC, fbn('Especie'))
  ACT(g:FAC, fbn('Especie2'))
  ACT(h:FAC, fbn('Especie4'))
  ACN(i:FAC, fbn('Cupon1'))
  ACN(j:FAC, fbn('Cupon2'))
  ACN(k:FAC, fbn('Cambio3'))
  ACN(l:FAC, fbn('Cambio4'))
  ACN(m:FAC, fbn('Cambio5'))
  ACN(n:FAC, COTIZACIONC(fbn('Especie4'),,,,fbn('Fecha3'),25,SI,VAR('MONELOCA')))
  ACN(o:FAC, Val(k:FAC)*Val(n:FAC))

  ACN(y:1, 0)
  ACT(y:2, fbn('NrTrans'))
  ACN(y:3, FAC)
  SQL.ADD("Select * From "~DBO~".MOVPOSPEN ")
  SQL.ADD("Where NrOperacion = '"~Val(y:2)~"' ")
  SQL.ADD("  and (NrSaldo IN (171,172) or (NrSaldo >= 190 and NrSaldo < 200)) ")
  SQL.ADD("order by Especie,Cupon,NrSaldo,FechaMov ")
  Recorrer SQL
    SCN(y:1, 1)
    if Val(y:1)=1
      DFA
    endif
    ACT(p:FAC, 'Pend')
    ACD(q:FAC, fbn('FechaMov'))
    ACT(r:FAC, fbn('Especie'))
    ACN(s:FAC, fbn('Cupon'))
    ACN(t:FAC, fbn('NrSaldo'))
    ACN(u:FAC, fbn('Cantidad'))
    ACN(v:FAC, fbn('Precio'))
    * Es de la espcie
    if EqStr(fbn('Especie'),Val(f:Val(y:3)))
      * Es del cupon Nuevo
      if fbn('Cupon') = Val(j:Val(y:3))
        ACN(w:FAC, Val(v:FAC)+Val(l:Val(y:3))-Val(o:Val(y:3)))
        ACT(x:FAC, 'OK')
      endif
    endif
    * Es de la espcie Cupon
    if EqStr(fbn('Especie'),Val(g:Val(y:3)))
      ACN(w:FAC, Val(o:Val(y:3)))
      ACT(x:FAC, 'OK')
    endif
    if EqStr(Val(x:FAC),'OK')
      if Val(w:FAC)<>Val(v:FAC)
        ACT(y:FAC, 'OK')
      endif
    endif
    if EqStr(Val(x:FAC),'OK') y EqStr(Val(y:FAC),'OK')
      SQL.ADD("Select 1 from "~DBO~".MOVPOSPEN ")
      SQL.ADD(" WHERE NrOperacion    = '"~Val(y:2)~"' ")
      SQL.ADD("   and Especie        = '"~Val(r:FAC)~"' ")
      SQL.ADD("   and Cupon          = "~FSTR(Val(s:FAC),1,0)~" ")
      SQL.ADD("   and NrSaldo        = "~FSTR(Val(t:FAC),1,0)~" ")
      SQL.ADD("   and Cantidad       = "~FSTR(Val(u:FAC),1,2)~" ")
      SQL.ADD("   and Precio         = "~FSTR(Val(v:FAC),1,9)~" ")
      Recorrer SQL
        DFA
        SCN(z:FAC, 1)
      proximo
      if Dialogo.Check1=1
        SQL.ADD("UPDATE "~DBO~".MOVPOSPEN ")
        SQL.ADD("   SET Precio         = "~FSTR(Val(w:FAC),1,9)~" ")
        SQL.ADD(" WHERE NrOperacion    = '"~Val(y:2)~"' ")
        SQL.ADD("   and Especie        = '"~Val(r:FAC)~"' ")
        SQL.ADD("   and Cupon          = "~FSTR(Val(s:FAC),1,0)~" ")
        SQL.ADD("   and NrSaldo        = "~FSTR(Val(t:FAC),1,0)~" ")
        SQL.ADD("   and Cantidad       = "~FSTR(Val(u:FAC),1,2)~" ")
        SQL.ADD("   and Precio         = "~FSTR(Val(v:FAC),1,9)~" ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
  proximo

  SQL.ADD("Select * From "~DBO~".MOVPOSEJE ")
  SQL.ADD("Where NrOperacion = '"~Val(y:2)~"' ")
  SQL.ADD("  and (NrSaldo IN (171,172) or (NrSaldo >= 190 and NrSaldo < 200)) ")
  SQL.ADD("order by Especie,Cupon,NrSaldo,FechaMov ")
  Recorrer SQL
    SCN(y:1, 1)
    if Val(y:1)=1
      DFA
    endif
    ACT(p:FAC, 'Eje')
    ACD(q:FAC, fbn('FechaMov'))
    ACT(r:FAC, fbn('Especie'))
    ACN(s:FAC, fbn('Cupon'))
    ACN(t:FAC, fbn('NrSaldo'))
    ACN(u:FAC, fbn('Cantidad'))
    ACN(v:FAC, fbn('Precio'))
    * Es de la espcie
    if EqStr(fbn('Especie'),Val(f:Val(y:3)))
      * Es del cupon Nuevo
      if fbn('Cupon') = Val(j:Val(y:3))
        ACN(w:FAC, Val(v:FAC)+Val(l:Val(y:3))-Val(o:Val(y:3)))
        ACT(x:FAC, 'OK')
      endif
    endif
    * Es de la espcie Cupon
    if EqStr(fbn('Especie'),Val(g:Val(y:3)))
      ACN(w:FAC, Val(o:Val(y:3)))
      ACT(x:FAC, 'OK')
    endif
    if EqStr(Val(x:FAC),'OK')
      if Val(w:FAC)<>Val(v:FAC)
        ACT(y:FAC, 'OK')
      endif
    endif
    if EqStr(Val(x:FAC),'OK') y EqStr(Val(y:FAC),'OK')
      SQL.ADD("Select 1 from "~DBO~".MOVPOSEJE ")
      SQL.ADD(" WHERE NrOperacion    = '"~Val(y:2)~"' ")
      SQL.ADD("   and Especie        = '"~Val(r:FAC)~"' ")
      SQL.ADD("   and Cupon          = "~FSTR(Val(s:FAC),1,0)~" ")
      SQL.ADD("   and NrSaldo        = "~FSTR(Val(t:FAC),1,0)~" ")
      SQL.ADD("   and Cantidad       = "~FSTR(Val(u:FAC),1,2)~" ")
      SQL.ADD("   and Precio         = "~FSTR(Val(v:FAC),1,9)~" ")
      Recorrer SQL
        DFA
        SCN(z:FAC, 1)
      proximo
      if Dialogo.Check1=1
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE  ")
        SQL.ADD("(FechaMov, Cliente, Vehiculo, ")
        SQL.ADD(" NrSaldo, Especie, FechaEj, PrecioEj, ")
        SQL.ADD(" CallPut, Cantidad, Precio, Estrategia, ")
        SQL.ADD(" Book, TipoNegocio, NrOperacion, Cupon, Tipo ) ")

        SQL.ADD("SELECT FechaMov, Cliente, Vehiculo, ")
        SQL.ADD("       NrSaldo, Especie, FechaEj, PrecioEj, ")
        SQL.ADD("       CallPut, Cantidad, "~FSTR(Val(w:FAC),1,9)~", Estrategia, ")
        SQL.ADD("       Book, TipoNegocio, NrOperacion, Cupon, Tipo ")
        SQL.ADD("  from "~DBO~".MOVPOSEJE ")
        SQL.ADD(" WHERE NrOperacion    = '"~Val(y:2)~"' ")
        SQL.ADD("   and Especie        = '"~Val(r:FAC)~"' ")
        SQL.ADD("   and Cupon          = "~FSTR(Val(s:FAC),1,0)~" ")
        SQL.ADD("   and NrSaldo        = "~FSTR(Val(t:FAC),1,0)~" ")
        SQL.ADD("   and Cantidad       = "~FSTR(Val(u:FAC),1,2)~" ")
        SQL.ADD("   and Precio         = "~FSTR(Val(v:FAC),1,9)~" ")
        SQL.NEW

        SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
        SQL.ADD(" WHERE NrOperacion    = '"~Val(y:2)~"' ")
        SQL.ADD("   and Especie        = '"~Val(r:FAC)~"' ")
        SQL.ADD("   and Cupon          = "~FSTR(Val(s:FAC),1,0)~" ")
        SQL.ADD("   and NrSaldo        = "~FSTR(Val(t:FAC),1,0)~" ")
        SQL.ADD("   and Cantidad       = "~FSTR(Val(u:FAC),1,2)~" ")
        SQL.ADD("   and Precio         = "~FSTR(Val(v:FAC),1,9)~" ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
  proximo
  if Dialogo.Check1=1
    SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
    SQL.ADD("   SET Cambio4   = "~FSTR(Val(o:Val(y:3)),1,9)~" ")
    if Val(m:Val(y:3))=0
      SQL.ADD("   , Cambio5   = "~FSTR(Val(l:Val(y:3)),1,9)~" ")
    endif
    SQL.ADD(" WHERE NrTrans   = '"~Val(y:2)~"' ")
    SQL.NEW
    SQL.EXEC
  endif
proximo
if FAC>Val(w:3)
  FormatoCeldas(i:Val(w:3)+1..j:fac,Exe('F0'))
  FormatoCeldas(k:Val(w:3)+1..o:fac,Exe('F9'))
  FormatoCeldas(s:Val(w:3)+1..t:fac,Exe('F0'))
  FormatoCeldas(u:Val(w:3)+1..u:fac,Exe('F2'))
  FormatoCeldas(v:Val(w:3)+1..w:fac,Exe('F9'))
endif

