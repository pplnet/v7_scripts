MostrarcuadrodeMensajes
CrearDialogo
  Fecha1     :'Fecha'     ;;;;;;Dialogo.Fecha1<>0;'Fecha No Valida';NO;Fsys
  Check1     :'Procesa'   ;;;;;;;;;0
FinDialogo
if Not Ok
   Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'Operaciones')
IFA
ACT(a:FAC, 'NrOperacion')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'ContraEspecie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Precio1')
ACT(g:FAC, 'TotalNetoCli1')
ACT(h:FAC, 'PorDerechoMercado')
ACT(i:FAC, 'Nue Coti')
ACN(w:1, FAC)

if Dialogo.Check1=0
  SQL.ADD("Select O.* From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
else
  SQL.ADD("Select O.NrOperacion  From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
endif
SQL.ADD(" Where FechaOp = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and TipoOp in ('TIC','TIV','TCOPRI') ")
SQL.ADD("   and ContraEspecie <> '"~VAR('MONELOCA')~"' ")
SQL.ADD("   AND O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   AND OB.NrBit Not in (30,31) ")
SQL.ADD("   AND OB.Valor = 1 ")
Recorrer SQL
  Message(fbn('NrOperacion'))
  ACT(a:FAC, fbn('NrOperacion'))
  if Dialogo.Check1=0
    ACT(b:FAC, fbn('TipoOp'))
    ACT(c:FAC, fbn('Especie'))
    ACT(d:FAC, fbn('ContraEspecie'))
    ACN(e:FAC, fbn('Cantidad'))
    ACN(f:FAC, fbn('Precio1'))
    ACN(g:FAC, fbn('TotalNetoCli1'))
    ACN(h:FAC, fbn('PorDerechoMercado'))
    ACN(i:FAC, COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,VAR('MONELOCA')))
  else
    SQL.ActualizarMovimientos3(Val(a:FAC),NO,NO,NO,SI,NO)
    SQL.EXEC
  endif
proximo

****************************************************
SetFilaActual(FAC+2)
ACT(a:FAC, 'Transacciones')
IFA
ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'TipoTr2')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'CotizaEn')
ACT(e:FAC, 'Cantidad1')
ACT(f:FAC, 'Precio1')
ACT(g:FAC, 'Cambio1')
ACT(h:FAC, 'Cantidad10')
ACT(i:FAC, 'Cotizacion')
ACT(j:FAC, 'Nuevo Precio')
ACN(w:2, FAC)

if Dialogo.Check1=0
  SQL.ADD("Select * From "~DBO~".TRANSACCIONES2 ")
else
  SQL.ADD("Select NrTrans From "~DBO~".TRANSACCIONES2 ")
endif
SQL.ADD("Where Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("  and TipoTr2 in ('DTP','RTP','DRT','CAMEST') ")
Recorrer SQL
  Message(fbn('NrTrans'))
  ACT(a:FAC, fbn('NrTrans'))
  if Dialogo.Check1=0
    ACT(b:FAC, fbn('TipoTr2'))
    ACT(c:FAC, fbn('Especie'))
    ACT(d:FAC, CotizaEn(fbn('Especie')))
    if Incluido(FBN['TipoTr2'],'CAMEST|')
      ACN(e:FAC, fbn('Precio1'))
      ACN(f:FAC, COTIZACIONC(Val(c:FAC),,,,fbn('Fecha1'),1,SI,val(d:fac)))
      ACN(g:FAC, val(e:fac)*val(f:fac))
      ACN(h:FAC, COTIZACIONC(Val(c:FAC),,,,fbn('Fecha1'),1,SI,VAR('MONELOCA')))
    else
      ACN(e:FAC, fbn('Cantidad1'))
      ACN(f:FAC, fbn('Precio1'))
      ACN(g:FAC, fbn('Cambio1'))
      ACN(h:FAC, fbn('Cantidad10'))
    endif  
*  if Not EqStr(Val(d:FAC),VAR('MONELOCA'))
    ACN(i:FAC, COTIZACIONC(Val(d:FAC),,,,fbn('Fecha1'),25,SI,VAR('MONELOCA')))
    ACN(j:FAC, Val(f:FAC)*Val(i:FAC))
  else
    SQL.ActualizarMovimientosT3(Val(a:FAC),NO,NO,NO,SI,NO)
    SQL.EXEC
  endif
*  endif
proximo

