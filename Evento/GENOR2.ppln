creardialogo
check1: 'Procesa';1;1;;SI;SI;;;;0;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Sqladd(" Select * from "~Dbo()~".OPSIOPEL ")
Sqladd("  where CodigoNego          in ("~Pipe2Comillas(Var('TIPONEGCPC'))~") ")
Sqladd("    and CodigoRueda         in ("~Pipe2Comillas(Var('RUECPC1'))~")    ")
Sqladd("    and CodigoRegistro      in ('0105','0205','7020')                 ")
Sqladd("    and NrOperacion         = 'NOTFOUND'                              ")
Sqladd("    and Fecha               = '"~IdxDate(FSys())~"'                     ")
Sqladd("    and Carga       = '1'                                             ")
Sqladd("    and Procesado   = '1'                                             ")
Watch(Sqlbatch())
recorrer sql

Act(a:1, '')
if (Eqstr(Fbn('CodigoRegistro'), '0205'))
Act(a:1, Query("Select NrOrden From "~Dbo()~".ORDENES Where NroAltaMAE='"~Fbn('SecOfertaCpra')~"'  and FechaOrden = '"~IdxDate(Fbn('Fecha'))~"'"))
else
if (Eqstr(Fbn('CodigoRegistro'), '0105'))
Act(a:1, Query("Select NrOrden From "~Dbo()~".ORDENES Where NroAltaMAE='"~Fbn('SecOfertaVta')~"'   and FechaOrden = '"~IdxDate(Fbn('Fecha'))~"'"))
else
Act(a:1, Query("Select NrOrden From "~Dbo()~".ORDENES Where NroAltaMAE='"~Fbn('NroAltaMAE')~"'  and FechaOrden = '"~IdxDate(Fbn('Fecha'))~"' "))
endif

endif

if (NoVacio(Val(a:1)) y dialogo.check1 = 1)
Sqladd("Update "~Dbo()~".OPSIOPEL ")
Sqladd("   Set Procesado   = '0',")
Sqladd("       Carga       = Null, ")
Sqladd("       NrOperacion = '' ")
Sqladd(" where NroAltaMAE  ='"~Fbn('NroAltaMAE')~"'  and Fecha = '"~IdxDate(Fbn('Fecha'))~"' ")
Sqlnew()
Sqlexec()

endif


proximo
