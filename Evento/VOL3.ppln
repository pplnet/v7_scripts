creardialogo
especie1:'Especie';;;;;;NoVacio(dialogo.especie);;;
entero1:'Ruedas Min';;;;;;
entero2:'Ruedas Max';;;;;;;;;
fecha1:'Fecha';;;;;;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
check1:'Visible';;;;;;;;;
findialogos

if (not ok)
Cancelar()
endif

if (dialogo.check1 = 1)
HojaVisible(SI)
endif

Act(ru: 1, FStr(dialogo.entero2, 0, 0))

Act(co: 1, BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', dialogo.especie1))

sql.add("  Select Count(*) as Total  From                                                          ")
sql.add("  (Select  Top  "~Val(ru: 1)~" * from "~Dbo()~".COTIZACIONES where CallPut='CON' And Moneda='"~Val(co: 1)~"'   and  Codigo='"~dialogo.especie1~"' and Fecha<='"~IdxDate(dialogo.fecha1)~"' order by Fecha desc) ")
sql.add("  as ORDENADA                                                             ")
sql.add("                                                            ")
sql.add("                                                            ")
recorrer sql
Acn(b: 2, Fbn()['Total'] - 1)
proximo

if (Val(b: 2) < dialogo.entero1)
Cancelar()('No se encontraron la cantidad minima de ruedas para el Calculo para la Especie '~dialogo.especie1)
endif

SetFilaActual(6)
Act(a: Fac(), 'Fecha')
Act(b: Fac(), 'Precio')
Act(c: Fac(), 'Diferencial')
Act(d: Fac(), 'Ruedas')
Act(e: Fac(), 'Probabilidad (1/Ruedas)')
Act(f: Fac(), 'Valor Esperado (Diferencial*Probalidad)')
Act(g: Fac(), 'Desvio (Diferencial-SUM(ValorEsperado))')
Act(h: Fac(), 'Desvio Cuadrado (Desvio al Cuadrado)')
Act(i: Fac(), 'Varianza (Probabilidad*Desvio Cuadrado)')
sql.add("  Select * From                                                          ")
sql.add("  (Select  Top  "~Val(ru: 1)~" C.*,T2.TipoTr2 from "~Dbo()~".COTIZACIONES C LEFT JOIN "~Dbo()~".TRANSACCIONES2 T2 ON T2.Especie = C.Codigo and  C.Fecha=T2.Fecha3 and T2.TipoTr2='ACUPON' where C.CallPut='CON'  and  C.Codigo='"~dialogo.especie1~"' and C.Fecha<='"~IdxDate(dialogo.fecha1)~"' and C.Moneda='"~Val(co: 1)~"'  order by Fecha desc) ")
sql.add("  as ORDENADA order by Fecha                                                            ")
sql.add("                                                            ")
sql.add("                                                            ")
recorrer sql
Acd(a: Fac(), Fbn()['Fecha'])
Acn(b: Fac(), Fbn()['Precio1'])
if (Val(vr: 1) = 1)
if (Fbn()['Precio1'] = 0)
Acn(c: Fac(), 0)
else
if (Val(b: Fac() - 1) = 0)
Acn(c: Fac(), 0)
else
Acn(c: Fac(), LogN(Val(b: Fac()) / Val(b: Fac() - 1)))
endif
endif
if (Eqstr(Fbn()['TipoTr2'], 'ACUPON'))
Acn(c: Fac(), 0)
endif
Scn(dd: 1, 1)
Acn(d: Fac(), Val(dd: 1))
Acn(e: Fac(), 1 / Val(b: 2))
Acn(f: Fac(), Val(c: Fac()) * Val(e: Fac()))
Scn(ff: 1, Val(f: Fac()))
endif
Acn(vr: 1, 1)
proximo
recorrer&i 1, Val(dd: 1) + 1
if (Val(vr: 2) = 1)
Acn(g: &i + 6, Val(c: &i + 6) - Val(ff: 1))
Acn(h: &i + 6, Val(g: &i + 6) ^ 2)
Acn(i: &i + 6, Val(h: &i + 6) * Val(e: &i + 6))
Scn(ii: 1, Val(i: &i + 6))

endif
Acn(vr: 2, 1)
proximo
FormatoCeldas(ii: 1, exe('F10'))
Acn(aa: 1, Val(ii: 1) ^ 0.5)
FormatoCeldas(aa: 1, exe('F10'))

Act(a: 1, 'Volatilidad:')
Act(b: 1, 'Ruedas:')
Acn(a: 2, Val(aa: 1) * 100)

sql.add(" DELETE  "~Dbo()~".VOLATILIDADESPECIE ")
sql.add(" Where Especie='"~dialogo.especie1~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' and Metodo='AUT' ")
sql.new
sql.exec

sql.add(" Insert  "~Dbo()~".VOLATILIDADESPECIE ")
sql.add(" (Fecha,Especie,Tipo,Metodo,Modo,FechaActualizacion,Volatilidad,VolatilidadOriginal,RuedasMax,RuedasMin,EspecieRef,Zona,RuedasUtil) ")
sql.add("  Values  ")
sql.add("  ('"~IdxDate(dialogo.fecha1)~"','"~dialogo.especie1~"','STD','AUT','','"~IdxDate(SQLAhora())~' '~Hora(Ahora())~"',"~Val(a: 2)~",0,"~FStr(dialogo.entero2, 0, 0)~","~FStr(dialogo.entero1, 0, 0)~",'',0,"~FStr(Val(b: 2), 0, 0)~" ) ")
sql.new
sql.exec

FormatoCeldas(a: 2, exe('F10'))
FormatoCeldas(b: 4..i: Fac(), exe('F10'))
LimitesVision(i: Fac() + 2)


ACO(1, 8)
ACO(2, 8)
ACO(3, 8)
ACO(4, 8)
ACO(5, 25)
ACO(6, 25)
ACO(7, 25)
ACO(8, 25)
ACO(9, 25)
