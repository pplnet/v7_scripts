   ACN(b2,SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~Dialogo.NrOperacion1~"' AND Tipo='5' "))
   ACN(b3,Dialogo.Cantidad1*Val(b2)/100)
   ACT(x1,"Cantidad="~Fstr(Dialogo.Cantidad1,0,2)~",PrecioEj="~Fstr(Val(b3)+Dialogo.Cantidad1,0,2)~",TotalComisiones="~Fstr(Val(b3),0,2)~",CantidadOri="~Fstr(Dialogo.Cantidad1,0,2)~" ")     
EndIf
If val(a4)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACN(b1,Dialogo.Fecha1-Dialogo.Fecha3)
   
   ACT(x1,val(x1)~"FechaVto='"~IdxDate(Dialogo.Fecha1)~"',Plazo="~FStr(val(b1),0,0)~" ")   
EndIf
If val(a5)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
