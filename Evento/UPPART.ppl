If NoVacio(VAL(x1))
   Message('Modificando los datos de la Partida .... ')
   SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
   SQL.ADD(" "~val(x1)~" ")
   SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
Else 
   Cancelar('La Seleccion Fue Nula, El Proceso se cancelara !!!')
EndIf

If VAL(b3)<>0
   * b4: Iva b5: wh b6: Imp.Interes b7:Total
   BorrarCeldas(b4..b7)

   SQL.ADD("Select * from "~DBO~".COMISIONES2 where NrOperacion='"~Dialogo.NrOperacion1~"' AND Tipo='5' ")
   Recorrer SQL
      acn(b4,Val(b3)*FBN['Tasa2']/100)
      acn(b5,Val(b3)*FBN['Tasa3']/100)
      acn(b6,Val(b3)*FBN['Precio1']/100)
   Proximo

   ACN(b7,Val(b3)+val(b5)+val(b6))
    
   SQL.ADD("Update "~DBO~".COMISIONES2 Set ")
   SQL.ADD("Importe1="~Fstr(Val(b3),0,2)~",Importe2="~Fstr(Val(b4),0,2)~",Importe3="~Fstr(Val(b5),0,2)~",Precio2="~Fstr(Val(b6),0,2)~",Importe4="~Fstr(Val(b7),0,2)~" ")
   SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' AND Tipo='5' ")
   SQL.NEW
EndIf
SQL.EXEC

* Actualizo la Instancia de la Operacion a Supervision
(.'MODIINSTAN'.)      

*** Actualiza movimientos y limites ****
SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
SQL.EXEC

If val(a5)+val(a6)+val(a7)+val(a8)+val(a9)+val(a10)+val(a11)+val(a12)+val(a13)+val(a14)+val(a15)+val(a16)<>0 
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
      act(x1,'')
      Message('Modificando las Operaciones Relacionadas '~FBN['NrOperacion']~' .... ')  

      * Operaciones No Liquidadas 
      If FBN['FechaVto']>VAL(a2)
         If val(a6)=1
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TipoTasa='"~Dialogo.TipoTasa1~"' ")   
         EndIf
         If val(a7)=1 y Not Incluido(FBN['TipoOp'],'MMPCLM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Spread="~Fstr(Dialogo.Precio1,0,7)~",PrecioRef='"~Dialogo.PrecioRef1~"' ")   
            If Incluido(FBN['TipoOp'],'MMPCOS|MMPE|MMPI')
               ACT(x1,val(x1)~", TotalAux2="~Fstr(FBN['Precio1']+Dialogo.Precio1,0,7)~" ")
            EndIf
            If Incluido(FBN['TipoOp'],'MMPCL')
               ACT(x1,val(x1)~", TotalAux4="~Fstr(IIF(FBN['RB6']=1,FBN['Precio1']+Dialogo.Precio1,0),0,7)~" ")
            EndIf
         EndIf
         If val(a8)=1 y Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPCOS|MMPOSM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" ImpGastos2="~Fstr(Dialogo.Precio3,0,7)~" ")   
         EndIf
         If val(a9)=1 y Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" RB7='"~Fstr(Dialogo.Radio7,0,0)~"' ")   
         EndIf
         If val(a10)=1 y Incluido(FBN['TipoOp'],'MMPCOS|MMPOSM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TotalAux1="~Fstr(Dialogo.Precio5,0,7)~" ")   
         EndIf
         If val(a11)=1 y Incluido(FBN['TipoOp'],'MMPCOS|MMPOSM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" RB9='"~Fstr(Dialogo.Radio9,0,0)~"' ")   
         EndIf
         If val(a12)=1
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TasaImp1="~Fstr(Dialogo.Precio7,0,7)~" ")   
         EndIf
         If val(a13)=1 y Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Precio3="~Fstr(Dialogo.Precio9,0,7)~" ")   
         EndIf
         If val(a14)=1 y Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPE|MMPI')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" ImpGastos1="~Fstr(Dialogo.Cantidad4,0,7)~" ")   
         EndIf
         If val(a15)=1 y Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" MB1='"~Fstr(Dialogo.Radio4,0,0)~"' ")   
         EndIf
         If Val(a16)=1 y Not Incluido('MMPCL|MMPCOS|MMPCLM|MMPOSM',FBN['TipoOp'])
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Precio2="~Fstr(Dialogo.Cantidad6,0,7)~" ")   
         EndIf
         If val(a17)=1 y Incluido(FBN['TipoOp'],'MMPCOS|MMPOSM|MMPE|MMPI|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" IntDevengados1="~Fstr(Dialogo.Cantidad8,0,7)~" ")   
         EndIf
      EndIf
      If val(a5)=1
         If NoVacio(val(x1))
            ACT(x1,val(x1)~',')       
         EndIf
         ACT(x1,val(x1)~"RB8='"~Fstr(Dialogo.Radio1,0,0)~"' ")   
      EndIf

      If NoVacio(VAL(x1))
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
         SQL.ADD(" "~val(x1)~" ")
         SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")      
         SQL.NEW
      EndIf

      If Incluido(FBN['TipoOp'],'MMPCLM|MMPOSM|MMPEM|MMPIM')
         ACT(x1,'')
         Message('*- Modificacion de Atributos de Cuotas ')
         If val(a7)=1 y Incluido(FBN['TipoOp'],'MMPCLM|MMPCOS|MMPEM|MMPIM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Precio4="~Fstr(Dialogo.Precio1,0,7)~" ")   
            If Incluido(FBN['TipoOp'],'MMPCLM')
               ACT(x1,val(x1)~", Cotizacion2=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")
               If FBN['RB6']=1
                  ACT(x1,val(x1)~" ,Tasa2=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")   
               EndIf
            EndIf
            If Incluido(FBN['TipoOp'],'MMPCOS')
               ACT(x1,val(x1)~", Cotizacion2=Precio2+"~Fstr(Dialogo.Precio1,0,7)~",Total6=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")   
            EndIf
            If Incluido(FBN['TipoOp'],'MMPEM|MMPIM')
               ACT(x1,val(x1)~" ,Tasa2=Precio2+"~Fstr(Dialogo.Precio1,0,7)~",Total6=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")   
            EndIf
         EndIf
         If NoVacio(VAL(x1))
            SQL.ADD(" UPDATE "~DBO~".CUOTAS Set ")
            SQL.ADD(" "~val(x1)~" ")
            SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' and Fecha2>'"~IdxDate(Val(a2))~"' ")
            SQL.NEW  
         EndIf
      EndIf
      SQL.EXEC      
   Proximo 

   SQL.ADD("Select * from "~DBO~".OPERACIONES where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
      Message('Calculando Datos Operaciones  Relacionadas '~FBN['NrOperacion']~' .... ')  
      If Incluido(FBN['TipoOp'],'MMPCL')
         (.'UPPAPCL'.)
      EndIf

      If Incluido(FBN['TipoOp'],'MMPCLM')
         (.'UPPAPCLM'.)
      EndIf

      If Incluido(FBN['TipoOp'],'MMPCOS')
        (.'UPPAPCOS'.)
      EndIf

      If Incluido(FBN['TipoOp'],'MMPOSM')     
         (.'UPPAPOSM'.)
      EndIf

      If Incluido(FBN['TipoOp'],'MMPE|MMPI')
         (.'UPPAPE'.)
      EndIf

      If Incluido(FBN['TipoOp'],'MMPEM|MMPIM')         
         (.'UPPAPEM'.)
      EndIf
      SQL.EXEC      

      ACT(i3,fbn['NrOperacion'])
      (.'MODIINSTAN'.)      
      SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
      SQL.EXEC
   Proximo
EndIf

