(.'CONTROLVH'.)

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar("La Operacion "~Dialogo.NrOperacion1~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

SQL.ADD("Select * from "~DBO~".OPERACIONES where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL

   * Verifico que se encuentre en Back Office o Terminal
   ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~FBN['NrOperacion']~"' AND Valor='1'") )

   If VAL(X1)<>20 y VAL(X1)<>50 y VAL(X1)<>9
      *-- Busco la instancia actual
      Cancelar("La Operacion "~FBN['NrOperacion']~" Debe estar en BackOffice, Terminal o Rech. Sup. FC. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
   EndIf
Proximo

