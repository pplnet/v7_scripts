creardialogo
string1:'Ruta';1;1;;;;;;;'G:\Corporate\BICE Fideicomisos\Demos'
string2:'Archivo';2;1;;;;;;;'Fondep FINAL CPD_FPA.xlsx'
findialogo

if (not ok)
Cancelar()
endif

if (Eqstr(Copy(dialogo.string1, Longitud(dialogo.string1), 1), '\'))
Act(x:1, dialogo.string1~dialogo.string2)
else
Act(x:1, dialogo.string1~'\'~dialogo.string2)
endif

importarxls(a:6..au:1000, ba:1..cu:1000, Val(x:1))

if (not ok)
Cancelar('Error al cargar el archivo '~Val(x:1))
endif

if (Query("Select 1 From "~Dbo()~".OPERACIONES where TipoOp='DTODOC' ") > 0)
Sqladd("Delete From "~Dbo()~".OPERACIONES ")
Sqladd(" Where TipoOp='DTODOC' ")
Sqlnew()
Sqlexec()
endif

recorrer&i 1, 1000
if (Vacio(Val(ba:&i)))
break
endif

Acn(nu:1, BuscarCampo('VEHICULOS', 'Alias1', 'Alias5', Val(bt:&i)))

Act(nr:1, getnumerador(Val(nu:1)))

if (Eqstr(Trim(Val(bc:&i)), '$'))
Act(es:1, Var('MONELOCA'))
else
Act(es:1, Var('MONEEXTR'))
endif

if (Eqstr(Trim(Val(bd:&i)), 'C'))
Acn(rb:1, 0)
else
Acn(rb:1, 1)
endif

Act(cl:1, BuscarCampo('CLIENTES', 'Codigo', 'Valor10', Val(bf:&i)))

Act(cl:2, BuscarCampo('CLIENTES', 'Codigo', 'Valor10', Val(bl:&i)))

Acn(pl:2, Fecha(Val(bi:&i)) - Fecha(Val(bh:&i)))

Act(vh:1, BuscarCampo('VEHICULOS', 'Codigo', 'Alias5', Val(bt:&i)))

if (Eqstr(Trim(Val(cc:&i)), 'No') o Eqstr(Trim(Val(cc:&i)), 'NO'))
Acn(rb:2, 0)
else
Acn(rb:2, 1)
endif

Acn(pl:1, Fecha(Val(cd:&i)) - Fecha(Val(bh:&i)))

if (Eqstr(Trim(Val(cf:&i)), 'No') o Eqstr(Trim(Val(cf:&i)), 'NO'))
Acn(rb:3, 0)
else
Acn(rb:3, 1)
endif

if (Eqstr(Trim(Val(cg:&i)), 'No') o Eqstr(Trim(Val(cg:&i)), 'NO'))
Acn(rb:4, 0)
else
Acn(rb:4, 1)
endif

if (Eqstr(Trim(Val(cu:&i)), 'ECHEQ'))
Acn(rb:5, 0)
else
if (Eqstr(Trim(Val(cu:&i)), 'CPD'))
Acn(rb:5, 1)
else
Acn(rb:5, 2)
endif
endif

Acn(ca:1, Val(bp:&i) - Val(bq:&i))

Sqladd("INSERT INTO "~Dbo()~".OPERACIONES ( ")
Sqladd("   TipoOp,          NrOperacion,    TotalAux1,       ObservacDoc,   Especie, ")
Sqladd("   RB1,             Precio1,        Cliente1,        FechaOp,       FechaVto, ")
Sqladd("   Plazo2,          TotalAux2,      TotalAux3,       Cliente2,      TotalAux4,")
Sqladd("   FechaPago,       TotalNetoCli1,  TotalIntereses,  TotalDerechos, Vehiculo1, ")
Sqladd("   MensajeChequeo,  ContraEspecie,  TipoCambio,      RB2,           FechaVto2, ")
Sqladd("   Plazo,           NrSucursal,     RB3,             RB4,           UsrInput, ")
Sqladd("   FechaCarga,      FechaCargaSys,  Numerador,       Cantidad,      Operador, ")
Sqladd("   RB5,             TotalIVA,       TotalNetoCli2 ")
Sqladd("   ) VALUES (")
Sqladd("   'DTODOC',                  '"~Val(nr:1)~"',          "~FStr(Val(ba:&i), 0, 0)~", '"~Val(bb:&i)~"',          '"~Val(es:1)~"', ")
Sqladd("   "~FStr(Val(rb:1), 0, 0)~",   "~FStr(Val(be:&i), 1, 8)~", '"~Val(cl:1)~"',          '"~IdxDate(Val(bh:&i))~"', '"~IdxDate(Val(bi:&i))~"', ")
Sqladd("   "~FStr(Val(pl:2), 0, 0)~",   "~FStr(Val(bj:&i), 0, 0)~", "~FStr(Val(bk:&i), 0, 0)~", '"~Val(cl:2)~"',           "~FStr(Val(bn:&i), 0, 0)~", ")
Sqladd("   '"~IdxDate(Val(bo:&i))~"', "~FStr(Val(bp:&i), 0, 2)~", "~FStr(Val(bq:&i), 0, 2)~", "~FStr(Val(br:&i), 0, 2)~",  '"~Val(vh:1)~"', ")
Sqladd("   '"~Val(by:&i)~"',          '"~Var('MONELOCA')~"',    "~FStr(Val(ca:&i), 0, 2)~", "~FStr(Val(rb:2), 0, 0)~",   '"~IdxDate(Val(cd:&i))~"', ")
Sqladd("   "~FStr(Val(pl:1), 0, 0)~",   "~FStr(Val(ce:&i), 0, 0)~", "~FStr(Val(rb:3), 0, 0)~",  "~FStr(Val(rb:4), 0, 0)~",   '"~UsuarioActivo()~"', ")
Sqladd("   "~SQLAhora()~",              "~IdxDate2(FSys())~",       "~FStr(Val(nu:1), 0, 0)~",  "~FStr(Val(ca:1), 0, 2)~",   '"~UsuarioActivo()~"', ")
Sqladd("   "~FStr(Val(rb:5), 0, 0)~",   "~FStr(Val(co:&i), 0, 2)~", "~FStr(Val(ct:&i), 0, 2)~" ")
Sqladd("   )")
Sqlnew()
Sqlexec()

Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 1, 'nroperacion1', Val(nr:1))
proximo

Messagebox('Evento Finalizado Correctamente.')



