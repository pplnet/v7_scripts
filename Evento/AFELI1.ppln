Sqladd("Select E.Codigo, Sum(S.Saldo) as Sald  ")
Sqladd("from "~Dbo()~".SALDOSDIA S, "~Dbo()~".ESPECIES E ")
Sqladd("where  S.Especie = E.Codigo  ")
Sqladd("  and  S.NrSaldo = 2 ")
Sqladd("  and  S.Saldo <> 0 ")
Sqladd("  and  E.Tipo = 'FON' ")
Sqladd("  and  S.Fecha = (Select Max(D.Fecha) from "~Dbo()~".SALDOSDIA D ")
Sqladd("                   where  D.EnteCustodia = S.EnteCustodia ")
Sqladd("                   and    D.Especie = S.Especie  ")
Sqladd("                   and    D.Cliente = S.Cliente  ")
Sqladd("                   and    D.NrSaldo = 2 ")
