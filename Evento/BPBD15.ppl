MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1: 'D.Fecha'   ;1;1;;;;;;;HABILES(FSYS,-1,'ARG')  
  Fecha2: 'H.Fecha'   ;1;2;;;;;;;HABILES(FSYS,-1,'ARG')
  Radio1: 'TipoCta|Intermedia|Pagadora|Ambas';;;;NO;NO;;;;1
  Lista1: 'Vehiculos' ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),Val(VH:1))
  Lista2: 'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3: 'Cuentas'   ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~ ") "~IIF(Dialogo.Radio1=0, " AND TipoCuenta='INT' ", IIF(Dialogo.Radio1=1, " AND Pagadora='SI' ", " AND (Pagadora='SI' OR TipoCuenta='INT') " ))~"  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
  Check1: 'Confirma'  ;;;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ T.NrTrans, T.Vehiculo1, T.Vehiculo2, T.Cuenta1, T.Cuenta2, T.Cliente1, T.Cliente2, ")
SQL.ADD(" T.Cantidad1, T.Fecha1, T.Fecha2, T.Especie, T.CB3, T.CB5, C2.Numero Numero2, C1.Numero Numero1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C2, "~DBO~".CUENTAS C1 ")
SQL.ADD(" Where T.Cuenta2 = C2.Codigo ")
SQL.ADD(" AND   T.Cuenta1 = C1.Codigo ")
SQL.ADD(" AND   T.Fecha1  >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   T.Fecha1  <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   T.CB6     = '1' ")
SQL.ADD(" AND   T.TipoTr2 = 'TRANSF' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Vehiculo2 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo2 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  T.Cliente2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  T.Cuenta2 IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif 
If Dialogo.Radio1=0
  SQL.ADD(" AND  C1.TipoCuenta = 'INT' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND  C2.Pagadora = 'SI' ")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND  (C1.TipoCuenta = 'INT' OR C2.Pagadora = 'SI' )")
Endif
SQL.ADD(" ORDER BY T.NrTrans ")

ACN(z:1,0)
Recorrer SQL
  ACN(a:fac,0)
  ACN(z:1,1)
  ACT(b:fac, fbn('NrTrans'))
  ACD(c:fac, fbn('Fecha1'))
  ACD(d:fac, fbn('Fecha2'))
  ACT(e:fac, fbn('Vehiculo1'))
  ACT(f:fac, fbn('Cuenta1'))
  ACT(k:fac, fbn('Numero1'))
  ACN(l:fac, fbn('CB3'))

  ACT(g:fac, fbn('Especie'))
  ACN(h:fac, fbn('Cantidad1'))
  ACT(i:fac, fbn('Vehiculo2'))
  ACT(j:fac, fbn('Cuenta2'))
  ACT(m:fac, fbn('Numero2'))
  ACN(n:fac, fbn('CB5'))
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron registros.')
Endif

CrearListBox; 'Arial,8,'
  'OK '           ;a:1..a:fac;SI;;;50;CHECK ;RGB(232,255,215);
  'NrTrans'       ;b:1..b:fac;NO;;;70;STRING;;RGB(232,232,232);
  'F.Ingreso '    ;c:1..c:fac;NO;;;70;FECHA ; RGB(232,232,232);
  'F.Acredit.'    ;d:1..d:fac;NO;;;70;FECHA ; RGB(232,232,232);
  'Vh.Origen'     ;e:1..e:fac;NO;;;70;STRING;;RGB(232,232,232);
  'Cta Origen'    ;f:1..f:fac;NO;;;90;STRING;;RGB(232,232,232);
  'Nro'           ;k:1..k:fac;NO;;;90;STRING;;RGB(232,232,232);
  'Conc'          ;l:1..l:fac;SI;;;50;CHECK  ;RGB(232,255,215);
  'Importe'       ;h:1..h:fac;SI;;;90;NUMERO;'###,###,###,###.##';RGB(232,255,215);
  'Moneda'        ;g:1..g:fac;NO;;;50;STRING;;RGB(232,232,232);
  'Vh.Destino'    ;i:1..i:fac;NO;;;70;STRING;;RGB(232,232,232);
  'Cta Destino'   ;j:1..j:fac;NO;;;90;STRING;;RGB(232,232,232);
  'Nro'           ;m:1..m:fac;NO;;;90;STRING;;RGB(232,232,232);
  'Conc'          ;n:1..n:fac;SI;;;50;CHECK  ;RGB(232,255,215);
FinListBox

If Not OK
  Cancelar
Endif

Recorrer&i 1,fac
  ACN(xx:1, 0 )
  ACN(xx:1, SQL("SELECT /*+ RULE */ 1 Ejecutado FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(b:&i)~"' ") )

  If Val(xx:1)=0
    If Val(a:&i)=1
      SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET ")
      SQL.ADD(" Cantidad1 = "~fstr(Val(h:&i),0,2)~", ")
      SQL.ADD(" CB3 = '"~fstr(Val(l:&i),0,0)~"', ")
      SQL.ADD(" CB5 = '"~fstr(Val(n:&i),0,0)~"',  ")
      SQL.ADD(" CB8 = '1',  ")
      SQL.ADD(" Fecha5= "~IdxDate2(fsys)~"  ")
      SQL.ADD(" WHERE NrTrans = '"~Val(b:&i)~"' ")
      SQL.NEW
      SQL.EXEC

      message('Transferencia '~Val(b:&i)~' actualizada.')
      SQL.EXEC

      SQL.ActualizarMovimientosT4(Val(b:&i),SI,NO,NO,NO,NO,NO,0)
      SQL.EXEC
    Endif
  Else
    messagebox('La transferencia '~Val(b:&i)~' esta conciliada. No se puede modificar.')
  Endif
Proximo