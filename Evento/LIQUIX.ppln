Sqladd("       and M.FechaMov >= '"~IdxDate(dialogo.fecha2)~"' ")
endif
Sqladd(" AND M.NrSaldo = 1 ")
if (dialogo.check1 = 1)
Sqladd(" AND (((O.OperacionRef Is Null OR O.OperacionRef = '') ")
Sqladd("        AND O.TipoOp IN ("~Pipe2Comillas(Val(ls:2))~")) ")
Sqladd("        OR O.TipoOp Not IN ("~Pipe2Comillas(Val(ls:2))~")) ")
