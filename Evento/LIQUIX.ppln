if (NoVacio(dialogo.lista2))
sql.add("       and O.TipoOp IN ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.especie1))
sql.add("       and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
sql.add("       and M.Cliente = '"~dialogo.cliente1~"' ")
endif
sql.add("       and ((B.NrBit = 20 and B.Valor = '1') or (B.NrBit = 50 and B.Valor = '1')) ")
sql.add(" UNION ")
sql.add("SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, ")
sql.add(" M.Transaccion, M.Cuenta, M.Leyenda, M.NrMov, O.TipoTr2 TipoOp, M.EnteCustodia Vehiculo, M.NrLiq,O.Book1 ")
sql.add(" FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 O ")
sql.add(" Where O.NrTrans = M.NrOperacion ")
sql.add("       and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("       and M.EnteCustodia in ("~pipe2comillas(Val(vh:1))~") ")
sql.add("       and M.Bits = 'MV' ")
