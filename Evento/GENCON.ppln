Sqladd(" Select O.NrOperacion, O.Cliente1 ")
Sqladd("  From "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS OB  ")
Sqladd("Where O.FechaOp ="~IdxDate2(dialogo.fecha1))
Sqladd("  and O.Cliente1=C.Codigo ")
Sqladd("  and O.TipoOp in ('TIC','TIV') ")
Sqladd("  and (C.Jerarquia like ('"~Var('JERVINCULA')~"%') or C.Jerarquia like ('"~Var('JERCLIENTE')~"%') or Vinculado='SI')")
Sqladd("  and OB.NrOperacion=o.NrOperacion and OB.Valor=1 ")
Sqladd("  and OB.NrBit in(10,70) ")
if (NoVacio(dialogo.cliente1))
