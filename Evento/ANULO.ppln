Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" Where NrBit <> 30 and NrBit <> 60 and (NrOperacion = '"~dialogo.nroperacion1~"') ")
Sqlnew()
