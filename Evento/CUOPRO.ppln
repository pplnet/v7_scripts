creardialogo
nroperacion1: 'Op  Cabecera'
nroperacion2: 'Op. Participante'
string1:'Condicion de Select Cuotas'
findialogo

if (not ok)
Cancelar()
endif

Acn(b1, Query(" SELECT Sum(Tasa1) as SumTasa FROM "~Dbo()~".CUOTAS WHERE NrOperacion='"~dialogo.nroperacion2~"' "))

Sqladd(" SELECT * FROM "~Dbo()~".CUOTAS WHERE NrOperacion='"~dialogo.nroperacion2~"' Order By NrCuota ")

Acn(b3, 0)

recorrer sql

Acn(b2, 100 * Fbn()['Tasa1'] / Val(b1))

Sqladd(" Update "~Dbo()~".CUOTAS SET ")
Sqladd(" Tasa1= "~FStr(Val(b2), 0, 2)~" ")
Sqladd(" WHERE NrOperacion='"~dialogo.nroperacion2~"' ")
Sqladd(" and NrCuota="~FStr(Fbn()['NrCuota'], 2, 0)~" ")
Sqlnew()
Sqlexec()

Scn(b3, 1)
proximo

Act(a50, BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion2))

Acn(a10, iif (Eqstr(BuscarCampo('Operaciones', 'RB8', 'NrOperacion', dialogo.nroperacion2), '0'), 36000, 36500))

Acn(a3, BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion2))

Acn(a20, BuscarCampo('Operaciones', 'ImpGastos2', 'NrOperacion', dialogo.nroperacion2))
Acn(a21, BuscarCampo('Operaciones', 'TotalAux1', 'NrOperacion', dialogo.nroperacion2))
Acn(a40, BuscarCampo('Operaciones', 'TasaImp1', 'NrOperacion', dialogo.nroperacion2))

Act(a24, BuscarCampo('Operaciones', 'RB7', 'NrOperacion', dialogo.nroperacion2))
Act(a25, BuscarCampo('Operaciones', 'RB9', 'NrOperacion', dialogo.nroperacion2))

Act(a26, BuscarCampo('Operaciones', 'CB10', 'NrOperacion', dialogo.nroperacion2))

Sqladd(" SELECT * FROM "~Dbo()~".CUOTAS WHERE NrOperacion='"~dialogo.nroperacion2~"' ")
if (NoVacio(dialogo.string1))
Sqladd(" and "~dialogo.string1~" ")
endif
Sqladd("Order By NrCuota ")

recorrer sql
Message('Recorriendo las Cuotas ')

Acn(a7, 0)
Acn(a8, 0)
Acn(a41, 0)

if (Val(a20) <> 0)
if (Eqstr(Val(a24), '0'))
Acn(a30, 360)
else
Acn(a30, 365)
endif
Acn(a7, Val(a3) * (Fbn()['Tasa2'] / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], BuscarCampo('Operaciones', 'RB8', 'NrOperacion', dialogo.nroperacion1) + 1))
Acn(a7, Val(a7) * Val(a20) / 100)
endif

Acn(a4, Val(a3) * ((Fbn()['Precio2'] + Fbn()['Precio4']) / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], BuscarCampo('Operaciones', 'RB8', 'NrOperacion', dialogo.nroperacion1) + 1))

if (Eqstr(Val(a26), '0'))
if (not Eqstr(Val(a50), 'MMFIMV'))
Acn(a41, Val(a4) * Val(a40) / 100)
endif
else
if (Eqstr(Val(a50), 'MMFIMV'))
Acn(a41, Val(a4) * Val(a40) / 100)
endif

if (Eqstr(Val(a25), '0'))
Acn(a31, 360)
else
Acn(a31, 365)
endif
Acn(a8, Val(a3) * (Fbn()['Total6'] / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], BuscarCampo('Operaciones', 'RB8', 'NrOperacion', dialogo.nroperacion1) + 1))
Acn(a8, Val(a8) * (Val(a21) / 100))
endif

Message('Calcula el importe de amortizaci¦n del per¦odo')
Acn(a9, BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion2) * Fbn()['Tasa1'] / 100)

Acn(a11, Val(a4) + Val(a8) + Val(a41))

Acn(a5, Val(a9) + Val(a4))

Acn(a6, Val(a9) + Val(a11))

Sqladd("Update "~Dbo()~".CUOTAS SET ")
Sqladd(" Cantidad2= "~FStr(Val(a3), 0, 2)~" , ")
Sqladd(" Cantidad4= "~FStr(Val(a9), 0, 2)~" , ")
Sqladd(" Cantidad5= "~FStr(Val(a11), 0, 2)~", ")
Sqladd(" Cantidad3= "~FStr(Val(a4), 0, 2)~" , ")
Sqladd(" Precio5= "~FStr(Val(a4), 0, 2)~", ")
Sqladd(" Precio1= "~FStr(Val(a7), 0, 2)~", ")
Sqladd(" Precio6= "~FStr(Val(a7), 0, 2)~", ")
Sqladd(" Precio3= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Precio7= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Total2= "~FStr(Val(a5), 0, 2)~" , ")
Sqladd(" Total9= "~FStr(Val(a41), 0, 2)~", ")
Sqladd(" Total1= "~FStr(Val(a6), 0, 2)~" , ")
Sqladd(" Cantidad2Ori= "~FStr(Val(a3), 0, 2)~", ")
Sqladd(" Cantidad1Ori= "~FStr(Val(a9), 0, 2)~", ")
Sqladd(" ResultadoIndice= 0 ")
Sqladd(" WHERE NrOperacion='"~dialogo.nroperacion2~"' ")
Sqladd(" AND NrCuota="~FStr(Fbn()['NrCuota'], 2, 0)~" ")
