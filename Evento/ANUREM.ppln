Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" Where (NrOperacion = '"~dialogo.nroperacion1~"') and (NrBit <> '30' ) ")
