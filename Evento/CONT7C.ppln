MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';;;;;;;;;FSys()
lista1: 'Vehiculos';3;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet(" Select Codigo From "~Dbo()~".VEHICULOS"), SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"'"))
check1: 'Contab.Procesada';;;;NO;NO;

findialogo

if (not ok)
Cancelar()
endif

Message('--- Asientos de Pago de Dividendos ---')

Act(us:1, Descendientes('ESPECIES', 'U$S'))


Sqladd(" SELECT O.Vehiculo1, M.Especie EspecieM, O.Especie, O.FechaPago, V.Valor1, V.Valor2, E.Cotiza, ")
Sqladd(" SUM(M.Cantidad)*(-1) Total, MA.Codigo CodAsi, O.ContraEspecie, E.Tipo, E.Cotiza, M.Cuenta Cuenta2, ")
Sqladd(" O.Observaciones, O.Cliente1, O.Cantidad, E.Alias8, O.NrOperacion, O.CB7, V.Alias4, O.RB1, O.RB2, M.NrMov, ")
Sqladd(" Case When M.NrMov = 1 OR M.NrMov = 10 Then O.ContraEspecie Else E.Cotiza END Moneda, E.Alias5 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V, "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".ESPECIES E, "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" WHERE  O.Vehiculo1   = V.Codigo ")
Sqladd(" AND    O.MB4         <> 4  ")
Sqladd(" AND    O.NrOperacion = M.NrOperacion ")
Sqladd(" AND    O.Especie     = E.Codigo      ")
Sqladd(" AND    O.TipoOp      = 'DIVIDE' ")
Sqladd(" AND    M.NrSaldo     = 1 ")
Sqladd(" AND    O.TipoOp      = MA.TipoOp ")
Sqladd(" AND    MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDIVI'))~") ")
Sqladd(" AND    M.FechaEje   = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND    O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND    MA.Habilitado = 'SI' ")
Sqladd(" AND    MA.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" GROUP BY O.Vehiculo1, O.Especie, O.FechaPago, V.Valor1, V.Valor2, E.Cotiza, MA.Codigo, M.Especie, O.ContraEspecie, ")
Sqladd(" E.Tipo, E.Cotiza, M.Cuenta, O.Observaciones, O.Cliente1, O.Cantidad, E.Alias8, O.NrOperacion, O.CB7, V.Alias4, O.RB1, O.RB2, M.NrMov, E.Alias5 ")
Sqladd(" ORDER BY 1, 2 ")
recorrer sql
Acn(ma:1, 0)
Acn(me:1, 0)
if (Eqstr(BuscarCampo('ESPECIES', 'Tipo', 'Codigo', Fbn('EspecieM')), 'MON'))
Acn(me:1, Fbn('Total'))
else 
Acn(ma:1, Fbn('Total') * CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaPago'), 1, SI, Fbn('Cotiza')))
endif
Message('Modelo: '~Fbn('CodAsi'))
Acd(fv:1, Fbn('FechaPago'))
Act(vh:1, Fbn('Vehiculo1'))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~Fbn('Especie')~"' AND A.Modelo = '"~Fbn('CodAsi')~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Fbn('FechaPago'))~"' AND A.Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo




Message('--- Asientos de Dividendos por Pmos.FCI ---')

Sqladd(" SELECT O.Vehiculo1, O.Especie, O.FechaPago, V.Valor1, V.Valor2, E.Cotiza, ")
Sqladd(" O.TotalBrutoCli1 Monto, MA.Codigo CodAsi, E.Tipo, O.Observaciones, O.Cliente1, O.Cantidad, ")
Sqladd(" E.Alias8, O.NrOperacion, O.CB7, V.Alias4, O.RB1, O.RB2, E.Cotiza Moneda, O.MB3, E.Alias5, ")
Sqladd(" 0 NrMov")
Sqladd(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V, "~Dbo()~".ESPECIES E, "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" WHERE  O.Vehiculo1   = V.Codigo ")
Sqladd(" AND    O.MB4         = 4  ")
Sqladd(" AND    O.Especie     = E.Codigo  ")
Sqladd(" AND    O.TipoCambio3     = 101 ")
Sqladd(" AND    O.TipoOp      = 'DIVIDE' ")
Sqladd(" AND    O.TipoOp      = MA.TipoOp ")
Sqladd(" AND    MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDIVI'))~") ")
Sqladd(" AND    O.FechaCargaSys   = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND    O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" ORDER BY 1, 2 ")
recorrer sql
Acd(fv:1, Fbn('FechaPago'))
Act(vh:1, Fbn('Vehiculo1'))
Acn(mt:1, Fbn('Monto'))
Acn(ct:1, CotizacionC(Fbn('Especie'), null, null, null, Fbn('FechaPago'), 1, SI, Fbn('Cotiza')))

Acn(ma:1, Val(mt:1) * Val(ct:1))
Acn(mb:3, Fbn('MB3'))

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select A.NrUnicoAsiento From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~Fbn('Especie')~"' AND A.Modelo = '"~Fbn('CodAsi')~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Fbn('FechaPago'))~"' AND A.Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(Fbn('CodAsi'), Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
