CrearDialogo
   NrOperacion1  :  'NrOp'        ;1;1;;;;Vacio(Dialogo.NrOperacion1) O Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'FXCSPJ');'Debe ingresar una Op FXCSPJ';NO;;;;;;" TipoOp = 'FXCSPJ' ";
   Vehiculo1     :  'Vehiculo'    ;1;2;;;;NoVacio(Dialogo.Vehiculo1);'El vehiculo no es valido';NO;;
   Fecha1        :  'Fecha Desde' ;2;2;;;;;;;FSYS;;
   Fecha2        :  'Fecha Hasta' ;3;2;;;;;;;FSYS;;;
   Especie1      :  'Especie'     ;4;2;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingrear una especie';;;;;;;"Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~")";;
   Cliente1      :  'Cliente'     ;5;2;;;;;
FinDialogo

If Not Ok
  Cancelar
EndIf

If ExisteArchivo('C:\FPA\PRUEBAPJ.TXT')
    WinExec('CMD.EXE /C DEL C:\FPA\PRUEBAPJ.TXT', 0)
    Esperar(3)
EndIf

AbrirASCII('C:\FPA\PRUEBAPJ.TXT',0)

SQL.ADD("Select O.Vehiculo1,O.ContraEspecie,O.Especie,O.FechaOp,O.TipoOp,O.NrOperacion,")
SQL.ADD("O.Cliente1,O.Cantidad,O.Precio1")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD(" where FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Especie1)
    SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
    SQL.ADD(" and Cliente = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" and NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Else
    SQL.ADD(" and TipoOp = 'FXCSPJ' ")
EndIf

ACN(BD:1, 0)

  ACT(A:1,Pad('Vehiculo',9))
  ACT(B:1,Pad('ContraEsp.',7))
  ACT(C:1,Pad('Especie',8))
  ACT(D:1,Pad('FechaOp',11))
  ACT(E:1,Pad('TipoOp',10))
  ACT(F:1,Pad('NrOp.',7))
  ACT(G:1,Pad('Cliente',10))
  ACT(H:1,LPad('Cantidad',7))
  ACT(I:1,LPad('Precio',10))    

ACT(XZ:1, Val(A:1)~Val(B:1)~Val(C:1)~Val(D:1)~Val(E:1)~Val(F:1)~Val(G:1)~Val(H:1)~Val(I:1))
EscribirASCII (Val(XZ:1))

Recorrer SQL
  ACN(Z:FAC,1)
  ACT(A:FAC,fbn('Vehiculo1'))
  ACT(B:FAC,fbn('ContraEspecie'))
  ACT(C:FAC,fbn('Especie'))
  ACD(D:FAC,fbn('FechaOp'))
  ACT(E:FAC,fbn('TipoOp'))
  ACT(F:FAC,fbn('NrOperacion'))
  ACT(G:FAC,fbn('Cliente1'))
  ACN(H:FAC,fbn('Cantidad'))
  ACN(I:FAC,fbn('Precio1'))
  ACN(BD:1, 1)

  ACT(AZ:FAC,Pad(fbn('Vehiculo1'),10))
  ACT(BZ:FAC,Pad(fbn('ContraEspecie'),11))
  ACT(CZ:FAC,Pad(fbn('Especie'),8))
  ACT(DZ:FAC,Pad0(Fstr(Dia(fbn('FechaOp')),0,0),2)~Pad0(Fstr(Mes(fbn('FechaOp')),0,0),2)~Fstr(Anio(fbn('FechaOp')),0,0))
  ACT(EZ:FAC,Pad(fbn('TipoOp'),6))
  ACT(FZ:FAC,Pad(fbn('NrOperacion'),6))
  ACT(GZ:FAC,Pad(fbn('Cliente1'),10))
  ACT(HZ:FAC,LPad(Fstr(Trunc(fbn('Cantidad'),0),0,0),7))
  ACT(IZ:FAC,LPad(Fstr(Trunc(fbn('Precio1'),0),0,0),7))
  
  ACT(ZZ:FAC,Val(AZ:FAC)~Val(BZ:FAC)~Val(CZ:FAC)~Val(DZ:FAC)~' '~Val(EZ:FAC)~' '~Val(FZ:FAC)~' '~Val(GZ:FAC)~' '~Val(HZ:FAC)~Val(IZ:FAC))
EscribirASCII (Val(ZZ:FAC))
Proximo
CerrarASCII

If Val(BD:1) = 1
    CrearListBox;'Arial,8,B'; 'Operaciones'
      'Procesa?'             ;z:1..z:fac;SI;SI;;60;COMBO;'Si|No|'
      'Vehiculo'             ;a:1..a:fac;SI;SI;'Error';90;STRING;20
      'ContraEspecie'        ;b:1..b:fac;SI;SI;'Error';90;STRING;20
      'Especie'              ;c:1..c:fac;SI;SI;'Error';90;STRING;20
      'FechaOp'              ;d:1..d:fac;SI;SI;'Error';90;FECHA;
      'TipoOp'               ;e:1..e:fac;SI;SI;'Error';90;STRING;20
      'NrOp'                 ;f:1..f:fac;SI;SI;'Error';90;STRING;12
      'Cliente'              ;g:1..g:fac;SI;SI;'Error';90;TABLA;'CLIENTES';'Codigo';'Codigo;RazonSocial'
      'Cantidad'             ;h:1..h:fac;SI;Val(z:flb)=1 O Val(h:flb)>0;'Error';90;NUMERO;'###,####.##'
      'Precio'               ;i:1..i:fac;SI;SI;'Error';90;NUMERO;'###,####.########'
    FinListBox
Else
   Cancelar ('No hay operaciones para mostrar')
EndIf

If Not Ok
  Cancelar
EndIf


Recorrer&i 1,fac
  If Val(A:&i) = 0
    SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
    SQL.ADD(" SET Cliente1 = '"~Val(G:&i)~"' ,Cantidad = '"~Val(H:&i)~"' ")
    SQL.ADD(" WHERE NrOperacion ='"~Val(F:&i)~"' ")
    SQL.NEW
    SQL.EXEC
  EndIf
Proximo
