Sqladd("     LEFT JOIN "~Dbo()~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ")
