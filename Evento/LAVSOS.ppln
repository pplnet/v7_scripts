HojaVisible(SI)
creardialogo
fecha1:'Fecha';;;;;;;;;FSys()
fecha2:'FechaHta';;;;;;;;;dialogo.fecha1;dialogo.fecha1
cliente1:'Cliente';3;1;;SI;SI
cantidad1: 'Monto Minimo';;;;;NO;;;;
radio2:"Salida|Informe|Inf+TXT";4;;;;;;;;1
string1:'Path';;;;NO;dialogo.radio2 = 1;;;;Var('PATHBCRA');
string2:'Operaciones SOS';;;;NO;dialogo.radio2 = 1;;;;'LAVOPER_'~Fecha(dialogo.fecha1, 'YYYYMMDD')~'.TXT';'LAVOPER_'~Fecha(dialogo.fecha1, 'YYYYMMDD')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!'
string3:'Clientes SOS';;;;NO;dialogo.radio2 = 1;;;;'LAVCTAS_'~Fecha(dialogo.fecha1, 'YYYYMMDD')~'.TXT';'LAVCTAS_'~Fecha(dialogo.fecha1, 'YYYYMMDD')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!'
check1:'Saldo 81|SI|NO';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")


if (dialogo.radio2 = 1 y not existedirectorio(dialogo.string1))
Messagebox('No existe el path '~dialogo.string1~'. Debera crearlo.')
Cancelar()
endif

Message(' - Borrando Archivos SOS')

if (dialogo.radio2 = 1 y existearchivo(dialogo.string1~dialogo.string2))
winexec('CMD.EXE /C DEL '~dialogo.string1~dialogo.string2, 0)
esperar(5)
endif

if (dialogo.radio2 = 1 y existearchivo(dialogo.string1~dialogo.string3))
winexec('CMD.EXE /C DEL '~dialogo.string1~dialogo.string3, 0)
esperar(5)
endif

if (dialogo.radio2 = 1)
Act(aa1, dialogo.string1~dialogo.string2)
Message('Creando Archivo '~dialogo.string2)
AbrirAscii(Val(aa1), 0)
endif

Act(yy:4, 'Interfase Lavado de Dinero SOS')
Act(yy:5, 'LAVDIN')
Sqladd("SELECT 1 as TP, '"~Var('OPDEPTIT')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT,  ")
Sqladd(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.Cantidad*Precio3 Monto, C.Sucursal, O.FechaOP FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
Sqladd(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
Sqladd("     LEFT JOIN dbo.CUENTAS CU on O.Cuenta1=CU.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
Sqladd("WHERE  O.TipoOp in ('TIDE') ")
Sqladd("       and B.Valor='1' and B.NrBit not in (30) ")
Sqladd("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ')   ")
Sqladd("       and (O.FechaOP >= "~IdxDate2(dialogo.fecha1)~" and O.FechaOP<="~IdxDate2(dialogo.fecha2)~" )")
Sqladd("UNION")
Sqladd("SELECT 1 as TP, '"~Var('OPPPASTI')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT,  ")
Sqladd(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.TotalNetoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
Sqladd(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA  ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
Sqladd("     LEFT JOIN dbo.CUENTAS CU on O.Cuenta1=CU.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion ")
Sqladd("     LEFT JOIN "~Dbo()~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ")
Sqladd("     LEFT JOIN "~Dbo()~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
Sqladd("WHERE  O.TipoOp in ('TIC','TIFV')  and PaseCB=1 ")
Sqladd("       and B.Valor='1' and B.NrBit not in (30) ")
Sqladd("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ')   ")
Sqladd("       and  (MO.FechaEje >= "~IdxDate2(dialogo.fecha1)~" and MO.FechaEje<="~IdxDate2(dialogo.fecha2)~" )")
Sqladd("       and O.ContraEspecie  =MO.Especie ")
Sqladd("UNION")
Sqladd("SELECT 1 as TP, '"~Var('OPPACTTI')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT, ")
Sqladd(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.TotalNetoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
Sqladd(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA  ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
