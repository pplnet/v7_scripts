Sqladd("SELECT 1 as TP, ")
Sqladd(" CASE WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then '"~Var('OPVTAPRI')~"'  else '"~Var('OPCPRAPRI')~"' end ")
Sqladd("      WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then '"~Var('OPCPRAPRI')~"'  else '"~Var('OPVTAPRI')~"' end  ELSE ")
Sqladd(" Case when O.Cliente1 = '"~Var('VEHICULODE')~"' then (case when TipoOp in ('TIC','TCOPRI','TIFC') Then '"~Var('OPCPRAPRI')~"' else '"~Var('OPVTAPRI')~"' end) else (case when TipoOp in ('TIC','TCOPRI','TIFC') then '"~Var('OPVTAPRI')~"' else '"~Var('OPCPRAPRI')~"' end) end  END Operacion, ")
Sqladd(" O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT, ")
Sqladd(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.TotalBrutoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal,  ")
Sqladd(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA  ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
Sqladd("     LEFT JOIN dbo.CUENTAS CU on Cuenta1=CU.Codigo ")
if (dialogo.check1 = 1)
Sqladd("     LEFT JOIN "~Dbo()~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion and Nrsaldo=81 ")
else
Sqladd("     LEFT JOIN "~Dbo()~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion ")
endif
Sqladd("     LEFT JOIN "~Dbo()~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
