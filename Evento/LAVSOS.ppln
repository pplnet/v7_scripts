Sqladd("SELECT 2 as TP, '"~Var('OPTRSEEXT')~"' as Operacion, TipoTr2 TipoOP, NrTrans Nroperacion, T.Fecha1 FechaOp, T.Cantidad1 Monto, T.Cuenta1, T.Cliente1,  C.AliasBT, ")
Sqladd(" '"~Var('MONELOCA')~"' ContraEsp, T.Especie, E.Cotiza, T.Cantidad1 Monto, C.Sucursal, T.Fecha1 FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
