Sqladd("WHERE  O.TipoOp in ('TIC','TIFC','TIV','TCOPRI','TIFV') and PaseCB<>1 ")
Sqladd("       and B.Valor='1' and B.NrBit not in (30) ")
Sqladd("       and E.Tipo in (select Codigo from "~Dbo()~".TIPOESPECIE where Clasificacion ='PRI')  ")
Sqladd("       and O.Mercado not in  ("~Pipe2Comillas(Var('UIFRTIMERC'))~") ")
