Sqladd(" Select NrInstancia From "~Dbo()~".INSTANCIAS ")
Sqladd(" Where Tabla = '"~dialogo.string1~"' ")
recorrer sql
if (Query(" Select 1 From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~dialogo.nroperacion1~"' AND NrBit = "~FStr(Fbn('NrInstancia'), 0, 0)~" ") <> 1)
Sqladd(" Insert Into "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion, NrBit, Valor) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.nroperacion1~"', "~FStr(Fbn('NrInstancia'), 0, 0)~", '0') ")
Sqlnew()
endif
proximo
Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '1' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" AND NrBit = "~FStr(dialogo.entero1, 0, 0)~" ")
Sqlnew()
Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '0' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" AND NrBit <> "~FStr(dialogo.entero1, 0, 0)~" ")
Sqlnew()
