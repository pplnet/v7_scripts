**--TEMINM: Minuta Mensual de Capitalizacion de Interes para Cuenta Corriente Vinculadas
** HojaVisible(SI)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;NOVACIO(Dialogo.Fecha1);'Debe Ingresar la Fecha';NO;Fsys
  Vehiculo1  : 'Vehiculo1'    ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo es Invalido';NO;
  Cliente1   : 'Cliente1'     ;;;;;;NOVACIO(Dialogo.Cliente1);'El Cliente es Invalido';NO;;;;
  Especie1   : 'Moneda'       ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;
  Precio1    : 'Tasa'         ;;;;NO;NO;;;;0;
FinDialogo

if not Ok
  Cancelar
endif

ACT(AV1,Dialogo.Vehiculo1)
ACT(AV2,Dialogo.Cliente1)

* Obtengo el Ultimo Dia Habil Del Mes Anterior 
ACD(Z10,FinDeMes(Dialogo.Fecha1-35,NO,'ARG'))

ACD(Z10,FinDeMes(Dialogo.Fecha1-35,NO,'ARG'))

SQL.ADD("SELECT SUM(TotalIntereses) As Interes,MB3 ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where (TipoOp='TEMIND' or TipoOp='TEMINM') and ")
SQL.ADD("FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("Especie ='"~Dialogo.Especie1~"' and ")
SQL.ADD("Vehiculo1 ='"~Dialogo.Vehiculo1~"' and ")
SQL.ADD("Cliente1 ='"~Dialogo.Cliente1~"' and (NrOperacion2 IS NULL or NrOperacion2='') ")
SQL.ADD("       AND NOT EXISTS ")
SQL.ADD(" (SELECT TipoOp ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where TipoOp='TEMINM' and FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("       Especie ='"~Dialogo.Especie1~"' and ")
SQL.ADD("Vehiculo1 ='"~Dialogo.Vehiculo1~"' and ")
SQL.ADD("Cliente1 ='"~Dialogo.Cliente1~"' ) ")
SQL.ADD("Group By MB3 ")

Recorrer SQL
   * Acumulo el Interes
   ACN(Z11,VAL(Z11)+FBN['Interes']*IIF(FBN['MB3']=0,-1,1))   
Proximo 

IF Round(VAL(Z11),2)<>0
    
   Message('Obteniendo los Nros. de Operaciones a Generar .... ')          

   *-- Z3 Nro. Minuta Diaria Y4: Importe de IVA
   ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1)))

   *-- Z7: MB3
   ACT(Z7,IIF(VAL(Z11)>0,'1','0') )

   IF VAL(Z11)<0
      ACN(Z11,-VAL(Z11))
   Else
      ACT(AV1,Dialogo.Cliente1)
      ACT(AV2,Dialogo.Vehiculo1)   
   ENDIF

   * Obtengo el Nro de Caso para la Minuta Vinculada AB6: Caso
   (."CASOVINCU".)    

   Message('Calculando los Impuestos para Operacion Directa ')

   ACT(AV1,Dialogo.Vehiculo1)
   ACT(AV2,Dialogo.Cliente1)

   * Determina los Impuestos de Vinculadas
   * Y5 : Imp.Ret.IVA  Y6 : Alicuota de IVA  Y12: Alicuota Percepcion  Y13: Importe  de Percepcion
   * Y16: IvaNeto  Y20: MontoCapitalizable Y19:TTN
   * I1: Tasa Impuesto Extr I2: Importe de Impuesto Ext
   * W1: Tasa WH  W2: Importe de WH Directa  

   (."IMPVINTER".)


   * Retencion Reforma Impositiva
   (."VINREFIMPO".)

   ACD(Z14,HABILES(Dialogo.Fecha1,1,'ARG',SI))
   ACN(Z15,VAL(Z14)-Dialogo.Fecha1)

   Message('Generando Minuta de Mensual de Capitalizacion de Interes .... ')          

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, NrOperacion,FechaOp,Vehiculo1,Cliente1,Especie, ")
   SQL.ADD(" MB3,Cantidad,ImpGastos1,TotalIVA,TotalRetenciones,")
   SQL.ADD(" ImpGastos2,")
   SQL.ADD(" TotalImpuestos,Plazo,FechaVto,UsrInput,Operador,")
   SQL.ADD(" TotalComisiones,TotalBrutoCli1,")
   SQL.ADD(" RB6,TotalAux1,TotalAux3,")
   SQL.ADD(" TasaPrecan,Comision,RB3,FechaCarga,") 
   SQL.ADD(" TasaImp1,ImporteImp,TotalGastos  ) ") 
   SQL.ADD("Values")
   SQL.ADD("('TEMINM','"~Val(z3)~"','"~IdxDate(Dialogo.Fecha1)~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Cliente1~"','"~Dialogo.Especie1~"',")
   SQL.ADD(" '"~Val(z7)~"', "~Fstr(VAL(Z11),0,2)~","~Fstr(VAL(Y6),0,2)~","~Fstr(VAL(Y4),0,2)~","~Fstr(VAL(y5),0,2)~", ")
   SQL.ADD(" "~Fstr(VAL(Y12),0,2)~",")
   SQL.ADD(" "~Fstr(VAL(Y13),0,2)~","~Fstr(VAL(Z15),0,0)~",")
   SQL.ADD(" '"~IdxDate(VAL(Z14))~"','"~USUARIOACTIVO~"','"~USUARIOACTIVO~"',")
   SQL.ADD(" "~Fstr(VAL(Y16),0,2)~","~Fstr(VAL(Y20),0,2)~",")
   SQL.ADD(" '"~Fstr(Val(AB6),0,0)~"',"~Fstr(Val(W1),0,2)~","~Fstr(Val(W2),0,2)~",")
   SQL.ADD(" "~Fstr(Val(I1),0,2)~","~Fstr(Val(I2),0,2)~",'1','"~IdxDate(Fsys)~"', ")
   SQL.ADD(" "~Fstr(val(y43),0,2)~","~Fstr(Val(y42),0,2)~","~Fstr(Val(y41),0,2)~" ) ")
   SQL.NEW
   SQL.EXEC

   *** Actualiza Movimientos y limites ****
   SQL.ActualizarMovimientos(Val(z3),SI)
   SQL.EXEC

   * Insert de Instancias: Recibe z3: Nro.Op.
   (."ALTAINSSU".)

   * Retencion Reforma Impositiva
   (."VINREFIMPO".)

   SQL.ADD("UPDATE "~DBO~".OPERACIONES")
   SQL.ADD(" Set NrOperacion2='"~VAL(Z3)~"' ")
   SQL.ADD("where (TipoOp='TEMIND' or TipoOp='TEMINM') and FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' and ")
   SQL.ADD("Especie ='"~Dialogo.Especie1~"' and ")
   SQL.ADD("Vehiculo1 ='"~Dialogo.Vehiculo1~"' and ")
   SQL.ADD("Cliente1 ='"~Dialogo.Cliente1~"' and (NrOperacion2 IS NULL or NrOperacion2='')")
   SQL.NEW
   SQL.EXEC    
EndIf