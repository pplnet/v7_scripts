Act(al:fac, 'Cotizacion BNA Mes actual')
Act(am:fac, 'Dif.Cotiz.')
Act(an:fac, 'Resultado')
Act(ao:fac, 'Linea')
Act(ap:fac, 'NrOperacion')
Act(aq:fac, 'TipoOp')
Act(ar:fac, 'FechaOp')
Act(as:fac, 'ContraEsp')


Sqladd("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
Sqladd("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
Sqladd("       Sum(P.CantidadFin) as Cantidad, ")
Sqladd("       Sum(P.CantidadFin*P.PrecioFin) as Monto, '' Observaciones, E.Alias8, '' Cliente1, P.Vehiculo Vehiculo1 ")
Sqladd(" from  "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E ")
Sqladd(" where P.Especie     = E.Codigo ")
Sqladd(" AND P.NrSaldo IN ("~Val(sl:1)~") ")
Sqladd(" and P.TipoNegocio = 'SEC' ")
Sqladd(" AND E.Cotiza <> '"~Val(ml:1)~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND P.Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Sqladd("   and P.CantidadFin <> 0 ")
Sqladd("   and P.Fecha       = (select Max(Fecha) ")
Sqladd("                       from  "~Dbo()~".POSICIONES P2 ")
Sqladd("                       where P2.Especie     = P.Especie ")
Sqladd("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
Sqladd("                         and P2.Cliente     = P.Cliente ")
Sqladd("                         and P2.Vehiculo    = P.Vehiculo ")
Sqladd("                         and P2.NrSaldo     = P.NrSaldo ")
Sqladd("                         and P2.TipoNegocio = P.TipoNegocio ")
Sqladd("                         and P2.Fecha      <= "~IdxDate2(Val(v:3))~" ) ")
Sqladd(" AND   P.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, E.Alias8 ")
recorrer sql
Act(a:fac, Fbn('Especie'))
Act(b:fac, Fbn('Nombre'))
Acn(d:fac, Fbn('NrSaldo'))
Act(e:fac, Fbn('TipoNegocio'))
Act(f:fac, Fbn('Vehiculo'))
Acn(i:fac, Fbn('Cantidad'))
Acn(j:fac, Fbn('Monto') / Fbn('Cantidad'))
Act(k:fac, Fbn('Cotiza'))
Acn(ct:fac, Cotizacion(Fbn('Especie'), null, null, null, Val(v:3), 1, SI))
Acn(l:fac, CotizacionBNA(Fbn('Cotiza'), Val(v:3), 1, NO, NO))
Acn(m:fac, CotizacionBNA(Fbn('Cotiza'), Val(v:2), 1, NO, NO))
Acn(o:fac, Fbn('Cantidad') * Val(ct:fac) * (Val(m:fac) - Val(l:fac)))
proximo

Acn(w:1, 1)
Sqladd("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
Sqladd("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
Sqladd("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
Sqladd("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
Sqladd("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
Sqladd("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8, O.Cliente1, M.Vehiculo Vehiculo1 ")
Sqladd("  from "~Dbo()~".MOVPOSEJE M, "~Dbo()~".ESPECIES E, "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V ")
Sqladd(" where M.NrSaldo IN ("~Val(sl:1)~") ")
Sqladd(" AND V.Codigo = M.Vehiculo ")
Sqladd("   and M.TipoNegocio = 'SEC' ")
Sqladd(" AND E.Cotiza <> '"~Val(ml:1)~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND M.Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Sqladd("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
Sqladd("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
Sqladd("   and M.Especie     = E.Codigo ")
Sqladd("   and M.NrOperacion = O.NrOperacion ")
Sqladd("   AND M.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" order by M.Especie, M.Cupon ")
recorrer sql
Dfa()
Scn(w:1, 1)
Acn(w:2, 0)
if (Fac() > 1)
recorrer&i 2, Fac()
if (Eqstr(Fbn('Especie'), Val(a:&i)))
Acn(w:2, &i)
break
endif
proximo
endif
if (Val(w:2) = 0)
Ifa()
Act(a:fac, Fbn('Especie'))
Act(b:fac, Fbn('Nombre'))
Acn(d:fac, Fbn('NrSaldo'))
Act(e:fac, Fbn('TipoNegocio'))
Act(f:fac, Fbn('Vehiculo'))
Act(g:fac, Fbn('Book'))
Acn(w:2, Fac())
endif
Act(aa:Val(w:1), Fbn('Especie'))
Act(ab:Val(w:1), Fbn('Nombre'))
Act(ac:Val(w:1), Fbn('Cupon'))
Acn(ad:Val(w:1), Fbn('NrSaldo'))
Act(ae:Val(w:1), Fbn('TipoNegocio'))
Act(af:Val(w:1), Fbn('Vehiculo'))
Act(ag:Val(w:1), Fbn('Book'))
Acd(ah:Val(w:1), Fbn('FechaMov'))
Acn(ai:Val(w:1), Fbn('Cantidad'))
if (Eqstr(Fbn('Cotiza'), Fbn('ContraEspecie')))
Acn(aj:Val(w:1), Fbn('Precio'))
else 
Act(md:2, Query(" Select Modo From "~Dbo()~".MODOESPECIES Where Especie2 = '"~Fbn('Cotiza')~"' AND Especie1 = '"~Fbn('ContraEspecie')~"' "))
Acn(aj:Val(w:1), iif (Eqstr(Val(md:2), 'INV'), Fbn('Precio') / Fbn('CotOp'), Fbn('Precio') * Fbn('CotOp')))
endif
Act(ak:Val(w:1), Fbn('Cotiza'))
Acn(al:Val(w:1), CotizacionBNA(Fbn('Cotiza'), Val(v:2), 1, NO, NO))
Acn(ct:Val(w:1), CotizacionBNA(Fbn('Cotiza'), Fbn('FechaOp'), 1, NO, NO))
Acn(an:Val(w:1), Fbn('Cantidad') * Val(aj:Val(w:1)) * (Val(al:Val(w:1)) - Val(ct:Val(w:1))))
Acn(ao:Val(w:1), Val(w:2))
Act(ap:Val(w:1), Fbn('NrOperacion'))
Act(aq:Val(w:1), Fbn('TipoOp'))
Acd(ar:Val(w:1), Fbn('FechaOp'))
Act(as:Val(w:1), Fbn('ContraEspecie'))
Acn(at:Val(w:1), Fbn('CotOp'))
Scn(p:Val(w:2), Val(an:Val(w:1)))
proximo

if (Fac() > 1)
recorrer&i 2, Fac()
Acn(q:&i, Val(o:&i) + Val(p:&i))
Acn(rs:1, Val(q:&i))
Acn(ct:3, Val(al:&i))
Act(r:&i, Var('TIASDICASE'))
Sqladd("select MA.Codigo ")
Sqladd("  from "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
recorrer sql
Dfa()
Message(Val(a:&i)~' - Modelo: '~Fbn('Codigo'))
Acd(fv:1, Val(v:2))
Act(md:1, Fbn('Codigo'))
Sqladd(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
Sqladd(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, '' Cliente1, V.Codigo Vehiculo1, 0 Cantidad, 'DCTIT' NrOperacion ")
Sqladd(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" Where E.Codigo = '"~Val(a:&i)~"' ")
Sqladd(" AND V.Codigo = '"~Val(f:&i)~"' ")
recorrer sql
Dfa()
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where Modelo = '"~Val(md:1)~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(v:2))~"' AND Vehiculo = '"~Val(f:&i)~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
let(&modelocontable, Val(md:1))
Sqlgenerarasientoop(Val(md:1), '', '', '', 810, Val(v:2), Val(f:&i), null, null, null, null, null, null, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
proximo
proximo
endif

