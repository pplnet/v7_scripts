CrearDialogo
  NrOperacion1 : 'Operacion';1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'SEPTMV') o [EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1),'SEPVMV') y [BuscarCampo('OPERACIONES','CB1','NrOperacion',Dialogo.NrOperacion1)=0 o Vacio(BuscarCampo('OPERACIONES','CB1','NrOperacion',Dialogo.NrOperacion1))]];'Operacion Invalida - Debe Ingresar la Operacion ingresada manualmente';NO;;;;;; " TipoOp in ('SEPTMV', 'SEPVMV') AND CB1 <> 1 AND FechaVto >= '"~IdxDate(Fsys-30)~"' "; 
  Entero1      : 'Nr. Cuota' ;;;;;;Dialogo.Entero1<>0 y SQL("Select 1 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,0,0) )=1;'Nr. cuota invalido';NO;;SQL(" Select Max(NrCuota) From "~DBO~".CUOTAS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND Fecha2 <= '"~IdxDate(Fsys)~"' ")
FinDialogo

IF Not OK
   Cancelar
EndIf

CrearFont(1,"Arial,8,B")

SQL.ADD(" Select C.NrOperacion,C.NrCuota, C.Tasa1, C.Cantidad1, C.Plazo1, C.Fecha1, ")
SQL.ADD(" C.Fecha2, C.Cantidad2, C.Total9, C.Cantidad6, C.Cantidad7, C.Total7, ")
SQL.ADD(" C.Precio2, C.Precio4, C.Cantidad3, C.Total3, C.Total2, C.Total1, C.Precio4, ")
SQL.ADD(" O.Especie, O.ContraEspecie, O.FechaOp, O.RB8, O.RB6, O.TasaImp1, C.Total4, ")
SQL.ADD(" C.Tasa2, C.Cantidad6, O.ImpGastos2, O.NrOperacion3, O.TipoOp ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE C.NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and C.NrCuota="~Fstr(Dialogo.Entero1,0,0)~" ")
SQL.ADD(" and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACT(A:FAC,fbn('NrOperacion'))
  ACN(B:FAC,fbn('NrCuota'))
  ACN(C:FAC,fbn('Cantidad2'))
  ACN(D:FAC,CotizacionC(fbn('Especie'), 'CON',,,fbn('FechaOp'),1,SI,fbn('ContraEspecie')) )
  ACN(E:FAC,val(C:FAC)*val(D:FAC))
  ACT(F:FAC,fbn('Especie'))
  ACT(G:FAC,fbn('ContraEspecie'))
  ACN(H:FAC,fbn('Tasa1'))
  ACN(I:FAC,fbn('Cantidad1'))
  ACN(J:FAC,fbn('Plazo1'))
  ACD(K:FAC,fbn('Fecha1'))
  ACD(L:FAC,fbn('Fecha2'))
  ACN(M:FAC,fbn('Precio2'))
  ACN(N:FAC,fbn('Precio4'))
  ACT(T:FAC,fbn('RB8'))
  ACN(O:FAC,val(E:fac)*((val(m:fac)+val(n:fac))/100)*FACTORDIAS( val(k:fac),val(l:fac),Num(val(T:fac))+1 ) ) 
  ACN(Y:FAC,fbn('Cantidad7'))
  ACN(V:FAC,fbn('TasaImp1')) 
  ACT(W:FAC,fbn('RB6'))
  ACN(X:FAC,fbn('Cantidad6'))
  ACN(Z:FAC,val(I:FAC)*val(D:FAC))
  ACN(Q:FAC,val(Z:FAC) + val(O:FAC) )
  ACN(S:FAC,fbn('Precio4'))
  ACN(U:FAC, IIF(val(V:FAC)<>0,IIF( (VAR('DEFAINT')*val(O:FAC)/100) > ((val(E:FAC)*(VAR('TASAIMPINT')/100 )*val(J:FAC)) /365),((val(E:FAC)*(VAR('TASAIMPINT')/100)*val(J:FAC))/365),val(O:FAC)*(val(V:FAC)/100)), 0)  )      
  ACN(P:FAC,val(Y:FAC)+val(U:FAC)+ val(O:FAC)+IIF(Num(val(W:FAC))=1,val(X:FAC),0)  )
  ACN(R:FAC,val(Z:FAC) + val(P:FAC) )
  ACN(AA:FAC,val(O:FAC) * (fbn('ImpGastos2')/100 ))
  ACN(AB:FAC,fbn('Tasa2'))
  ACN(AC:FAC,fbn('Cantidad6'))
  ACN(AD:FAC,fbn('ImpGastos2'))
  ACT(ZZ:1, fbn('NrOperacion'))
  If Eqstr(fbn('TipoOp'),'SEPVMV')
    ACT(ZZ:2, fbn('NrOperacion3'))
  Endif
Proximo

CrearListBox; 'Arial,8,B';'Seteo de Precio Prestamos en Especie'
    'NrOp'                 ;A:1..A:Fac;NO;SI;'Error'; 70; STRING;12
    'Cuota'                ;B:1..B:Fac;NO;SI;'Error'; 50; NUMERO;'###'
    'V. Nominal'           ;C:1..C:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'
    'Precio'               ;D:1..D:Fac;SI;VAL(D:FLB)>0;'Debe ser Positivo'; 90; NUMERO;'###,###,###,###.########';
    'V.N. Valorizado'      ;E:1..E:Fac;NO;SI;'Error'; 120; NUMERO;'###,###,###,###.##';;val(C:FLB)*val(D:FLB);
    'Especie'              ;F:1..F:Fac;NO;SI;'Error'; 70; STRING;30
    'Moneda'               ;G:1..G:Fac;NO;SI;'Error'; 70; STRING;30
    'Tasa Amort'           ;H:1..H:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.######'
    'Imp Amort'            ;I:1..I:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'
    'Imp. Am. Valorizado'  ;Z:1..Z:Fac;NO;SI;'Error';120; NUMERO;'###,###,###,###.##';;val(I:FLB)*val(D:FLB);
    'Plazo'                ;J:1..J:Fac;NO;SI;'Error'; 60; NUMERO;'###,###,###,###.##'
    'F.Origen'             ;K:1..K:Fac;NO;SI;'Error:Fecha Invalida'; 80; FECHA; 
    'F.Vto'                ;L:1..L:Fac;NO;SI;'Error:Fecha Invalida'; 80; FECHA; 
    'Tasa Interes'         ;M:1..M:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.######' 
    'Spread'               ;N:1..N:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.######' 
    'Interes'              ;O:1..O:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##';;val(E:FLB) * ((val(M:FLB)+val(N:FLB))/100) * FACTORDIAS(val(K:FLB),val(L:FLB),Num(val(T:FLB))+1 ) 
    'Impto.Interes'        ;U:1..U:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'; ;IIF(val(V:FLB)<>0,IIF( (VAR('DEFAINT')*val(O:FLB)/100) > ((val(E:FLB)*(VAR('TASAIMPINT')/100 )*val(J:FLB)) /365),((val(E:FLB)*(VAR('TASAIMPINT')/100)*val(J:FLB))/365),val(O:FLB)*(val(V:FLB)/100)), 0)        
    'Interes Total'        ;P:1..P:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'; ;val(Y:FLB)+val(U:FLB)+ val(O:FLB)+IIF(Num(val(W:FLB))=1,val(X:FLB),0)
    'Monto'                ;Q:1..Q:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'; ;val(Z:FLB) + val(O:FLB);
    'Monto Total'          ;R:1..R:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##'; ;val(Z:FLB) + val(P:FLB);
    'Importe_Iva'          ;AA:1..AA:Fac;NO;SI;'Error'; 90; NUMERO;'###,###,###,###.##';;val(O:FLB) * (val(AD:FLB)/100 );
FinListBox


if Not Ok
  Cancelar
endif


Repetir
   Recorrer&j 1,Fac
      *actualiza la cuota
      SQL.ADD(" UPDATE "~DBO~".CUOTAS ")
      SQL.ADD(" Set Precio8 = "~Fstr(val(D:&j),0,8)~", Total8 = "~Fstr(val(E:&j),0,2)~", Total7 = "~Fstr(val(Z:&j),0,2)~",  ")
      SQL.ADD(" Cantidad3 = "~Fstr(val(O:&j),0,2)~" , Total9 = "~Fstr(val(U:&j),0,2)~" , Total3 = "~Fstr(val(P:&j),0,2)~", Total2 = "~Fstr(val(Q:&j),0,2)~", ")
      SQL.ADD(" Total1 = "~Fstr(val(R:&j),0,2)~", Total4 = "~Fstr(val(AA:&j),0,2)~" ")
      SQL.ADD(" Where  NrOperacion = '"~Val(ZZ:1)~"'  and  NrCuota = "~Fstr(Dialogo.Entero1,0,0)~"  ")
      SQL.NEW
      SQL.EXEC
      SQL.ActualizarMovimientos3(Val(ZZ:1),SI,NO,NO,SI,SI)
      SQL.EXEC
      ACN(bb:99,0)
      SQL.ADD(" Select NrBit from "~DBO~".OPERACIONESBITS  where NrOperacion = '"~Val(ZZ:1)~"' and Valor = 1 ")
      Recorrer SQL
         DFA
         ACN(bb:99, fbn('NrBit'))
         * Guardo los cambios de instancias
         SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
         SQL.ADD("( NrOperacion, NrInstancia, Usuario, Fecha ) ")
         SQL.ADD(" Values ")
         SQL.ADD("( '"~Val(ZZ:1)~"', "~Val(bb:99)~" , '"~UsuarioActivo~"', ")
         SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
         SQL.NEW
         SQL.EXEC
      Proximo
      If Not EqStr(VAL(ZZ:2),'') o EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',VAL(ZZ:1)),'SEPTMV') 
        *Actualizo Instancias
        If val(bb:99) <>0 
          SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD("SET Valor  = 0 ")
          SQL.ADD("WHERE NrOperacion = '"~Val(ZZ:1)~"' and Valor  = 1 ") 
          SQL.NEW
          SQL.EXEC
        EndIf
        *actualizo la instancia a 19
        SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD("SET Valor  = 1 ")
        SQL.ADD("WHERE NrOperacion = '"~Val(ZZ:1)~"' and NrBit  = 19 ") 
        SQL.NEW
        SQL.EXEC
      Endif
      If Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',VAL(ZZ:1)),'SEPVMV') y Not EqStr(VAL(ZZ:2),'')
        *Actualizo a la instancia que corresponda en la operacion vinculada
        SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD("SET Valor  = 0 ")
        SQL.ADD("WHERE NrOperacion = '"~Val(ZZ:2)~"' and Valor  = 1 ") 
        SQL.NEW
        SQL.EXEC
        SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD("SET Valor  = 1 ")
        ACT(ve:1,BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',VAL(ZZ:1)))
        ACT(ve:2,BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',VAL(ZZ:2)))
        If [Incluido(VAL(ve:1),VAR('VEHIEXTRAN')) o Incluido(VAL(ve:2),VAR('VEHIEXTRAN'))] y Incluido(VAL(ve:2),VAR('VLIQUIDA')~VAR('VLIQUIDA2'))
          SQL.ADD("WHERE NrOperacion = '"~Val(ZZ:2)~"' and NrBit  = 19 ")
        Else
          SQL.ADD("WHERE NrOperacion = '"~Val(ZZ:2)~"' and NrBit  = 15 ")
        Endif
        SQL.NEW
        SQL.EXEC
      Endif
   Proximo
   If CeldaVacia(ZZ:2)
      Break
   Else
      ***---Para setear la operacion contraria en la siguiente vuelta
      ACT(ZZ:1, Val(ZZ:2))
      ACT(ZZ:2, '')
   Endif
Proximo