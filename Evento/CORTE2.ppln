Sqladd("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, 101 NrSaldo, C.RazonSocial, ")
Sqladd("       '' CallPut, '' FechaEj, 0 PrecioEj, C.RecibePreaviso, S.Saldo, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
Sqladd("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
Sqladd("       E.DiasAnio, E.DiasMes,S.NrSaldo as NumSalOri")
Sqladd("FROM   "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E ")
Sqladd("WHERE  S.NrSaldo in ("~Pipe2Comillas(Val(dz14))~") ")
Sqladd("       AND S.Cliente = C.Codigo ")
Sqladd("       AND S.Especie='"~Val(b2)~"' and S.Cupon='"~FStr(Val(c2), 1, 0)~"' ")
Sqladd("       AND S.Especie = E.Codigo ")
Sqladd("       AND S.Cupon= "~FStr(dialogo.entero1, 0, 0)~" ")
