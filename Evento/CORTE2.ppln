Sqladd("       AND S.Mercado = '"~dialogo.mercado1~"'")
endif
if (NoVacio(dialogo.listatabla1))
Sqladd("       AND S.Cliente in ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd("       AND isnull(S.CallPut,'') NOT IN ('CALL','PUT') ")
Sqladd("       AND S.Saldo <> 0 ")
Sqladd("       AND S.Fecha=( ")
Sqladd("                    SELECT Max(S1.Fecha)  ")
Sqladd("                    FROM   "~Dbo()~".SALDOSDIA S1")
Sqladd("                    WHERE  S1.Cliente = S.Cliente ")
Sqladd("                           AND   S1.Especie = S.Especie ")
Sqladd("                           AND   S1.Mercado = S.Mercado ")
Sqladd("                           AND   S1.EnteCustodia = S.EnteCustodia ")
