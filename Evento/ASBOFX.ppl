* Asignar Nro. de Boleto a operaciones de FX y MM en forma automatica y secuencial
CrearDialogo
  NrOperacion1: 'Nro. Oper. :'
  Check1:       'Procesa'   ;;; ;NO;NO;;;;1;
  Check2:       'Manual'    ;;; ;NO;NO;;;;1;
FinDialogo
If Not OK
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, '# Op')
ACT(a:2, 'Check1')
ACT(a:3, 'TipoOp')
ACT(a:4, '# Boleto')
ACT(a:5, 'Nuevo')


ACT(b:1, Dialogo.NrOperacion1)
ACN(b:2, Dialogo.Check1)
ACT(b:3, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))
ACT(b:4, BuscarCampo('OPERACIONES','NrBoleto','NrOperacion',Dialogo.NrOperacion1))

iF Not incluido(Val(b:3),'FXC|FXV|FXJ|FXA|FXAT')
  if Dialogo.Check2=1
    MessageBox('TipoOp '~Val(b:3)~' invalido.')
  endif
  if Dialogo.Check1=1
    Cancelar
  endif
endif

iF NoVacio(Val(b:4))
  if Dialogo.Check2=1
    MessageBox('La operacion '~Val(b:1)~' ya tiene NrBoleto ('~Val(b:4)~').')
  endif
  if Dialogo.Check1=1
    Cancelar
  endif
else
  if Dialogo.Check1=1
    ACT(b:5, GetNumerador(800))
    SQL.ADD(" Update "~DBO~".OPERACIONES Set NrBoleto = '"~Val(b:5)~"' ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
    if Dialogo.Check2=1
      MessageBox('Boleto asignado a la operacion'~Val(b:1)~' ('~Val(b:5)~').')
    endif
  endif
endif

* Hasta que no verifique para que que no lo haga

IF NO


SQL.ADD(" Select NrOperacion,NrBoleto,Vehiculo1 from "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"'  ")
SQL.ADD(" and (NrBoleto='' or NrBoleto = Null) ")
SQL.ADD(" and (TipoOp like '%FX%' or TipoOp like '%MM%' )")

Recorrer SQL
  if Eqstr(FBN['Vehiculo1'],'INGBA')  
     ACT(y1, GetNumerador(98))
  endif
  if Eqstr(FBN['Vehiculo1'],'INGCURA')  
     ACT(y1, GetNumerador(97))
  Endif
  if Eqstr(FBN['Vehiculo1'],'INGSB')  
     ACT(y1, GetNumerador(96))
  endif
   
  * actualizar nro. boleto
  SQL.ADD(" Update "~DBO~".OPERACIONES set NrBoleto = '"~Val(y1)~"' ")
  SQL.ADD(" Where NrOperacion = '"~fbn['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC
proximo

ENDIF