creardialogo
fecha1: 'Fecha';;;;;;dialogo.fecha1 <= FSys() y dialogo.fecha1 > 0;'Fecha incorecta';NO;FSys()
entero1: 'Prueba';;;;;;dialogo.entero1 > 0;'Prueba incorecta';NO;0
especie1: 'Especie';;;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'MONEDA');'Especie incorecta';NO;'EUR'
cantidad1: 'Cantidad';;;;;;dialogo.cantidad1 <> 0;'Cantidad incorecta';NO;
vehiculo1: 'Vehiculo';;;;;;NoVacio(dialogo.vehiculo1);'Vehiculo incorecto';NO;Var('VEHICULODE')
string: 'Cta.Cont.';;;;;;NoVacio(dialogo.string);'Cta.Contable incorecta';NO;
radio1: 'Origen|FPA|Otro';;;;;;;;;1
check1: 'Procesa';;;;;;;;;1
findialogo
if (not ok)
Cancelar()
endif

Act(a:1, 'Mov.Prueba '~FStr(dialogo.entero1, 1, 0))
if (dialogo.radio1 = 0)
Act(a:2, 'FPA')
else
Act(a:2, 'OTRO')
endif
if (dialogo.check1 = 1)
Sqladd("INSERT INTO "~Dbo()~".MOVCTAVISTA ")
Sqladd("( CodigoSAP, Vehiculo, FechaCarga, FechaDoc, FechaValor, CuentaContable, Moneda, ImporteMonedaLocal, ImporteMonedaDoc, SistemaOrigen) ")
Sqladd(" Values ")
Sqladd("( '"~Val(a:1)~"'    , '"~dialogo.vehiculo1~"', '"~IdxDate(FSys())~"', '"~IdxDate(dialogo.fecha1)~"', '"~IdxDate(dialogo.fecha1)~"', '"~dialogo.string~"', '"~dialogo.especie1~"', "~FStr(dialogo.cantidad1, 1, 2)~", "~FStr(dialogo.cantidad1, 1, 2)~", '"~Val(a:2)~"') ")
Sqlnew()
Sqlexec()
endif

