CrearDialogo
  Cliente1 : 'Cliente'
  Especie1 : 'Especie'
  TipoOp1  : 'Tipo Op.'
  Operador : 'Operador';;;;;;;;;UsuarioActivo
FinDialogo


SQL.ADD("Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, TotalIntereses from "~DBO~".OPERACIONES where FechaVto = '"~IdxDate(FSys)~"'")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and TipoOp = '"~Dialogo.TipoOp1~"'")
else
  SQL.ADD("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPFP','MMPO','MMAD','MMDES','MMCA')")
endif
if NoVacio(Dialogo.Operador)
  SQL.ADD("and Operador = '"~Dialogo.Operador~"'")
endif
SQL.ADD("and (RB6 = '0' or RB6 is NULL)")
SQL.ADD("order by Cliente1, Especie, TipoOp")

ACN(z1, 0)
recorrer SQL
  ACT(a:fac, fbn('Cliente1'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('TipoOp'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('TotalIntereses'))
  ACN(g:fac, fbn('Plazo'))
  ACT(h:fac, fbn('NrOperacion'))
  SCN(z1, 1)
proximo

ACO(1,10)
ACO(2,6)
ACO(3,6)
ACO(4,12)
ACO(5,10)
ACO(6,10)
ACO(7,5)
ACO(8,8)


FormatoCeldas(d1..d:fac, Exe('F2'))
FormatoCeldas(e1..e:fac, Exe('F7'))
FormatoCeldas(f1..f:fac, Exe('F2'))
FormatoCeldas(g1..g:fac, Exe('F0'))

if Val(z1) > 0
  ListBox(a1..h:fac, 'Cliente      Especie TipoOp         Cantidad       Precio    Intereses  Plazo   #Oper.')
  if ok
    recorrerSel
      CrearDialogo
        TipoOp1       : 'Tipo Op' ;1;1; ;NO;;;;;Val(c:FilaCiclo)
        NrOperacion1  : 'Nro. Op' ;1;2; ;NO;;;;;Val(h:FilaCiclo)
        Cliente1      : 'Cliente' ;2;1; ;NO;;;;;Val(a:FilaCiclo)
        Especie1      : 'Especie' ; ; ; ;NO;;;;;Val(b:FilaCiclo)
        Cantidad1     : 'Cantidad'; ; ; ;NO;;;;;Val(d:FilaCiclo)
        Precio1       : 'Precio'  ; ; ; ;NO;;;;;Val(e:FilaCiclo)
        Precio2       : 'Pr.Base' ;5;2; ;NO;Incluido(Val(c:FilaCiclo), 'MMAD|MMDES|MMPO');;;;BuscarCampo('OPERACIONES','Precio4','NrOperacion',Val(a:FilaCiclo));
        Cantidad2     : 'Interés' ;6;1; ;NO;;;;;Val(f:FilaCiclo)
        Entero1       : 'Plazo'   ; ; ; ;NO;;;;;Val(g:FilaCiclo)
        String        : 'Observ.' ; ; ; ;;;;;;  
      FinDialogo
      if Ok
        SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '2' , Observaciones = '"~Dialogo.String~"' ")
        SQl.ADD("where NrOperacion = '"~Val(h:FilaCiclo)~"'")
        SQL.NEW
      endif
    proximo
    SQL.EXEC
  endif
else
  Cancelar('No existen operaciones')
endif
