MostrarCuadroDeMensajes()

Sqladd("Select DISTINCT O.TipoOp, O.NrOperacion, O.Mercado2, O.Mercado, O.FormaLiquidacion2, O.FormaLiquidacion1, O.FechaOp, O.FechaVto,    ")
Sqladd("       O.Cliente1, O.Especie, O.ContraEspecie, O.Cantidad, O.TotalNetoCli1, C.RazonSocial, O.CB7, O.NrBoleto, O.Cuenta1, O.Cuenta4, ")
Sqladd("       O.Cuenta2, O.Cuenta3, O.Vehiculo1, O.Plaza1, O.Cuenta5, O.Cuenta6 , O.CB4  , ConceptoBCRA, MB1, O.Cliente4                   ")
Sqladd(" from   "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".ESPECIES E           ")
Sqladd("where  O.Cliente1 = C.Codigo                                                            ")
Sqladd("      and  E.Jerarquia like '"~Var('JERMONEDA')~"%'                                     ")
Sqladd("      and  E.Codigo = O.Especie                                                         ")
Sqladd("      and  M.NrOperacion = O.NrOperacion                                                ")
Sqladd("      and  M.NrOperacion = B.NrOperacion                                                ")
Sqladd("      and  B.Valor  = '1'                                                               ")
Sqladd("      and  B.NrBit  in (10,7)                                                           ")
Sqladd("      and O.NrOperacion not in (select NrOperacion from "~Dbo()~".MOVEJECUTADOS ME        ")
Sqladd("                    where ME.NrOperacion = O.NrOperacion AND ME.NrSaldo IN (1,31) )     ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("   and  O.NrOperacion = '"~dialogo.nroperacion1~"'                                   ")
else
Sqladd("      and  O.Mercado = '"~dialogo.mercado1~"'   ")

endif

Sqladd("order by O.Cliente1, O.TipoOp, O.NrOperacion                                            ")
Watch(Sqlbatch())

recorrer sql
Scn(a:0, 1)
Message('Operacion '~Fbn('NrOperacion'))

Act(a:fac, Fbn('Cliente1'))
Act(b:fac, Fbn('RazonSocial'))
Act(c:fac, Fbn('TipoOp'))
Act(d:fac, Fbn('NrOperacion'))
if (Eqstr(Val(nt:1), 'SI'))
