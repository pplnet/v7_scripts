if (not Incluido(Fbn('TipoOp'), 'DDC|DDV'))

if (Eqstr(dialogo.mercado2, Fbn('Mercado')))
Act(r:fac, Fbn('Cuenta3'))
Act(t:fac, Fbn('Cuenta1'))
else
Act(r:fac, Query("select Codigo from "~Dbo()~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~iif (Eqstr(Val(nt:1), 'SI'), Val(w:fac), Val(a:fac))~"'  and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
Act(t:fac, Query("select Codigo from "~Dbo()~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
