creardialogo
nroperacion1: 'Op  Renovada'
nroperacion2: 'Op. Nueva'
precio1:'Variacion de Capital'
findialogo

if (not ok)
Cancelar()
endif

Acn(a1, Query("Select DeltaTasa FROM "~Dbo()~".OPERACIONES Where NrOperacion='"~dialogo.nroperacion1~"' "))

Message('Modificando Operacion '~dialogo.nroperacion1~'  ...')

Sqladd("Update "~Dbo()~".OPERACIONES Set NrOperacion3='"~dialogo.nroperacion2~"', ")
Sqladd("IntDevengados1="~FStr(dialogo.precio1 * Val(a1) / 100, 0, 2)~" Where NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

Act(i3, dialogo.nroperacion1)

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
Sqladd("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', Val(az5), 'nroperacion1', Val(az3))
endif

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
Sqlnew()
Sqlexec()




Sqlactualizarmovimientos(dialogo.nroperacion1, SI)
Sqlexec()


