creardialogo
nroperacion1: 'Op  Renovada'
nroperacion2: 'Op. Nueva'
precio1:'Variacion de Capital'
findialogo

if (not ok)
Cancelar()
endif

Acn(a1, sql("Select DeltaTasa FROM "~Dbo()~".OPERACIONES Where NrOperacion='"~dialogo.nroperacion1~"' "))

Message('Modificando Operacion '~dialogo.nroperacion1~'  ...')

sql.add("Update "~Dbo()~".OPERACIONES Set NrOperacion3='"~dialogo.nroperacion2~"', ")
sql.add("IntDevengados1="~FStr(dialogo.precio1 * Val(a1) / 100, 0, 2)~" Where NrOperacion='"~dialogo.nroperacion1~"' ")
sql.new
sql.exec

Act(i3, dialogo.nroperacion1)

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
sql.add("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
sql.new

if (sql(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
ejecutarevento('INSBIT', entero1 = Val(az5), nroperacion1 = Val(az3))
endif

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
sql.new
sql.exec




sql.actualizarmovimientos(dialogo.nroperacion1, SI)
sql.exec


