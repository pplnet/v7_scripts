fecha1:'Fecha';1;1;;;;;;;;FSys()
nrtrans1:"Nro. Transaccion";;;;;;;;;;;
lista1: 'Vehiculos';5;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select /*+ RULE */ Codigo from "~Dbo()~".VEHICULOS"), Val(vh: 1))
lista2: 'Bancos';;1;;;;;;;;;SQLSet(" Select /*+ RULE */ Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista3: 'Cuentas';-6;2;;;;;;;;;SQLSet(" Select /*+ RULE */ Codigo From "~Dbo()~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(dialogo.lista2)~") "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~") "))~"  ");
findialogo

if (not ok)
