Act(tr1, Trim(Mirt(dialogo.nrtrans1)))

Sqladd(" Select /*+ RULE */ A.*  from "~Dbo()~".Transacciones2 A ")
Sqladd("   where (A.CB4 IS NULL OR A.CB4 = '0') ")
Sqladd("     and (A.CB10 IS NULL OR A.CB10 = '0') ")
Sqladd("     and A.TipoTr2 in ('CRVM', 'DEVM') ")
if (NoVacio(dialogo.nrtrans1))
Sqladd("     and A.NrTrans = '"~dialogo.nrtrans1~"'  ")
endif

Sqladd("     AND A.Fecha1 >= "~IdxDate2(dialogo.fecha1)~" ")

if (NoVacio(dialogo.lista1))
Sqladd(" AND A.Vehiculo1  IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd("  AND A.Vehiculo1 IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif

if (NoVacio(dialogo.lista2))
Sqladd(" AND A.Cliente2  IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
endif

if (NoVacio(dialogo.lista3))
Sqladd(" AND A.Cuenta2  IN ("~Pipe2Comillas(dialogo.lista3)~")  ")
endif


recorrer sql
