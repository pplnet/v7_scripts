Sqladd("Select * from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B where")
Sqladd("NrSaldo = 1 ")
Sqladd("and M.FechaMov <= '"~IdxDate(FSys())~"' ")
Sqladd("and M.NrOperacion = B.NrOperacion ")
