Act(i:fac, Fbn()['Leyenda'])
Acn(k:fac, 1)
Acn(p:fac, Fbn()['NrMov'])
Act(r:fac, Fbn()['Especie'])
Act(s:fac, Fbn()['Cupon'])
endif
