creardialogo
fecha1:"F Real Ej.";1;1;;;;dialogo.fecha1 = dialogo.fecha2;'FECHA EJERCICIO REAL TIENE QUE SER IGUAL A FECHA RESET';NO;FSys()
nroperacion1:"Operacion";;;;;;Eqstr(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTSFV');'DEBE INGRESAR UNA OPERACION DE TIPO DTC';NO;;;SQLSet("Select NrOperacion from "~Dbo()~".OPERACIONES where TipoOp = 'DTSFV' ")
precio2:"Tasa Variable";;;;;;dialogo.precio2 <= Var('RTASA2') y dialogo.precio2 >= Var('RTASA1');'Tasa del Vehiculo Fuera de Rango:'~Var('RTASA1')~" Y "~Var('RTASA2');SI;0;;;;"###.#########"
fecha2:"F Reset";;;;NO;;;;;;BuscarCampo('Operaciones', 'FechaPrecan', 'NrOperacion', dialogo.nroperacion1);
fecha3:"F Settlement";;;;NO;;;;;;BuscarCampo('Operaciones', 'FechaPago', 'NrOperacion', dialogo.nroperacion1);
fecha4:"Fecha Fin Swap";;;;NO;;;;;;BuscarCampo('Operaciones', 'FechaEj', 'NrOperacion', dialogo.nroperacion1)
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

sql.add("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
sql.add("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
sql.add("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar()('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTSFV|'))
Cancelar()('La operacion N# '~dialogo.nroperacion1~' No es un Swap Fijo Variable')
endif

Acn(x1, sql("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar()('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~sql("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (ok)
Acn(x1, 0)


sql.add("Select * from "~Dbo()~".OPERACIONES ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")

recorrer sql

if (not EsHabil(dialogo.fecha3, Fbn()['TablaFeriados1']))
Messagebox('FECHA SETTLEMENT NO HABIL EN TABLA DE FERIADOS '~Fbn()['TablaFeriados1'])
break
endif


Acn(x1, 1)

Acn(z24, 0)
Acn(z20, 0)

Message('Calculando interes .... ')

if (Fbn()['RB9'] = 1)
Acn(z11, (Fbn()['RB8'] + 1))
Acn(z24, ((Fbn()['Cantidad'] * (dialogo.precio2 + Fbn()['Spread'])) / 100) * FactorDias(Fbn()['FechaOp2'], Fbn()['FechaEj'], Val(z11)))
Act(z26, Fbn()['Especie'])
Acn(z27, Val(z24))
else
Acn(z11, (Fbn()['RB5'] + 1))
Acn(z24, ((Fbn()['TotalBrutoCli1'] * (dialogo.precio2 + Fbn()['TotalNetoCli2'])) / 100) * FactorDias(Fbn()['FechaOp2'], Fbn()['FechaEj'], Val(z11)))
Act(z26, Fbn()['ContraEspecie'])
Acn(z27, -Val(z24))
endif

Message('Calculando resultado .... ')
if (Eqstr(Fbn()['Especie'], Fbn()['ContraEspecie']) y Fbn()['RB6'] = 0 y dialogo.precio2 <> 0)
if (Fbn()['RB9'] = 1)
Acn(z20, Fbn()['InteresesCorr'] - Val(z24))
else
Acn(z20, Val(z24) - Fbn()['TotalIntereses'])
endif
endif

if (dialogo.precio2 <> 0)
Act(zz1, '1')
else
Act(zz1, '0')
endif

Message('Actualizando la Opcion .... ')

sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("Set CB8 = '"~Val(zz1)~"', ")
sql.add("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
sql.add("FechaPrecan = '"~IdxDate(dialogo.fecha2)~"', ")
sql.add("Precio4   = "~FStr(Val(z20), 0, 2)~", ")

if (Fbn()['RB9'] = 1)
sql.add("Precio3   = "~FStr(dialogo.precio2, 0, 7)~",  ")
sql.add("TotalIntereses   = "~FStr(Val(z24), 0, 7)~"  ")
else
sql.add("TotalGanancias   = "~FStr(dialogo.precio2, 0, 7)~",  ")
sql.add("InteresesCorr   = "~FStr(Val(z24), 0, 7)~"  ")
endif

sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
sql.add("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
sql.new

if (sql(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
ejecutarevento('INSBIT', entero1 = Val(az5), nroperacion1 = Val(az3))
endif

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
sql.new
sql.exec




Act(or1, BuscarCampo('Operaciones', 'OperacionRef', 'NrOperacion', dialogo.nroperacion1))

if (not Eqstr(BuscarCampo('Operaciones', 'RB9', 'NrOperacion', dialogo.nroperacion1), '0') y NoVacio(Val(or1)))
ejecutarevento('TTNOP', nroperacion1 = Val(or1), entero1 = 0, nroperacion2 = dialogo.nroperacion1, lista1 = '')
endif

sql.actualizarmovimientos(dialogo.nroperacion1, SI)
sql.exec

proximo

if (Val(x1) = 0)
Cancelar()('La operacion N# '~dialogo.nroperacion1~' No puede ser Ejercida')
endif
endif


