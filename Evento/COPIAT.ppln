HojaVisible(NO)
creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;Habiles(Query("Select Max(Fecha) From "~Dbo()~".FLAGSMERCADO Where Registro = 'NCOP' "), 1, 'ARG', SI)
radio1:'|Provisorio|Definitivo';;;;;;;;;;0
fecha2:'Hasta Fecha';;;;;;;;;FSys();
check1:'MAE/BYMA';;;;NO;NO;;;;iif (Eqstr(Var('COPIATMB'), 'SI'), 1, 0);
check2:'ROFEX/NDF';;;;NO;NO;;;;iif (Eqstr(Var('COPIATROF'), 'SI'), 1, 0);
check3:'MAV';;;;NO;NO;;;;iif (Eqstr(Var('COPIATMAV'), 'SI'), 1, 0);
vehiculo1:'Vehiculo';;;;NO;NO;NoVacio(dialogo.vehiculo1);'Debe ingresar un vehiculo';NO;Var('VEHICULODE')
radio2:'|Manual|Evento';;;;NO;NO;;;;;0
especie1:'Moneda Totales';;;;NO;NO;NoVacio(dialogo.especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";
findialogo

if (not ok)
Cancelar()
endif

Linkearhoja('COPIAT', 0, 'fecha1', dialogo.fecha1, 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1, 'fecha2', dialogo.fecha2, 'radio2', dialogo.radio2, 'especie1', dialogo.especie1, 'check1', dialogo.check1, 'check2', dialogo.check2, 'check3', dialogo.check3)

if (NO)
recorrer&k dialogo.fecha1, dialogo.fecha2

if (EsHabil(&k, 'ARG'))
Acd(fe:10, &k)
Linkearhoja('COPIAT', 0, 'fecha1', Val(fe:10), 'radio1', dialogo.radio1, 'vehiculo1', dialogo.vehiculo1, 'fecha2', Val(fe:10), 'radio2', dialogo.radio2, 'especie1', dialogo.especie1, 'check1', dialogo.check1, 'check2', dialogo.check2, 'check3', dialogo.check3)
endif
proximo
endif
