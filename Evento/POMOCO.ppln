nrtrans1: 'NrTrans';;;;;;Eqstr(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'CUPON');'Transaccion Invalida';NO;;;;;;" TipoTr2 = 'CUPON' ";
fecha1:'F.Corte';;;;;;dialogo.fecha1 <> 0;'Fecha de Corte Invalida';NO;FSys()
fecha2:'F.Pago';;;;;;dialogo.fecha2 > dialogo.fecha1;'Fecha de Pago Invalida';NO;FSys()
especie1: 'Moneda Pago';;;;;;NoVacio(dialogo.especie1) y Eqstr(BuscarCampo('ESPECIES', 'MonedaEmision', 'Codigo', dialogo.especie1), 'MON');'Moneda de Pago Invalida';NO;;;;;;" Tipo = 'MON' ";
findialogo

if (not ok)
Cancelar()
endif

Act(bk:1, Var('BOOKCONTRA'))
Act(ml:1, Var('MONELOCA'))

Sqladd(" Select T.Precio1, T.Precio2, T.Precio3, T.Precio5, T.CB5, T.Especie, T.Especie2, ")
Sqladd(" T.Fecha1, M.Cantidad, T.Vehiculo1 ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPENDIENTES M ")
Sqladd(" Where T.NrTrans = M.NrOperacion ")
Sqladd(" AND T.Especie2 = M.Especie ")
Sqladd(" AND T.Vehiculo1 = M.Cliente ")
Sqladd(" AND T.NrTrans = '"~dialogo.nrtrans1~"' ")

Sqladd(" UNION ")

Sqladd(" Select T.Precio1, T.Precio2, T.Precio3, T.Precio5, T.CB5, T.Especie, T.Especie2, ")
Sqladd(" T.Fecha1, M.Cantidad, T.Vehiculo1 ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVEJECUTADOS M ")
Sqladd(" Where T.NrTrans = M.NrOperacion ")
Sqladd(" AND T.Especie2 = M.Especie ")
Sqladd(" AND T.Vehiculo1 = M.Cliente ")
Sqladd(" AND T.NrTrans = '"~dialogo.nrtrans1~"' ")
recorrer sql
Acn(rt:1, Fbn('Cantidad') * Fbn('Precio2') / 100)
Acn(at:1, Fbn('Cantidad') * Fbn('Precio1') / 100)
Acn(ic:1, Fbn('Cantidad') * Fbn('Precio3') / 100)
if (Fbn('CB5') = 1)
Acn(aj:1, Fbn('Precio5'))
else
Acn(aj:1, 1)
endif
Acn(ct:1, (Val(rt:1) + Val(at:1) + Val(ic:1)) * Val(aj:1))
Act(mn:1, dialogo.especie1)
if (Eqstr(Val(mn:1), Val(ml:1)))
Acn(pr:1, 1)
else
Acn(pr:1, Cotizacion(Val(mn:1), null, null, null, Fbn('Fecha1') - 1, 1, SI))
endif
if (dialogo.fecha1 <= FSys())
Sqladd(" Insert Into "~Dbo()~".MOVPOSEJE ")
else
Sqladd(" Insert Into "~Dbo()~".MOVPOSPEN ")
endif
Sqladd(" (FechaMov, Cliente, Vehiculo, ")
Sqladd(" NrSaldo, Especie, Cantidad, ")
Sqladd(" Precio, Book, NrOperacion) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Fbn('Vehiculo1')~"', '"~Fbn('Vehiculo1')~"', ")
Sqladd(" 31, '"~Val(mn:1)~"', "~FStr(Val(ct:1), 0, 2)~", ")
Sqladd(" "~FStr(Val(pr:1), 0, 8)~", '"~Val(bk:1)~"', '"~dialogo.nrtrans1~"') ")
Sqlnew()
if (dialogo.fecha2 <= FSys())
Sqladd(" Insert Into "~Dbo()~".MOVPOSEJE ")
else
Sqladd(" Insert Into "~Dbo()~".MOVPOSPEN ")
endif
Sqladd(" (FechaMov, Cliente, Vehiculo, ")
Sqladd(" NrSaldo, Especie, Cantidad, ")
Sqladd(" Precio, Book, NrOperacion) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha2)~"', '"~Fbn('Vehiculo1')~"', '"~Fbn('Vehiculo1')~"', ")
Sqladd(" 51, '"~Val(mn:1)~"', "~FStr(Val(ct:1), 0, 2)~", ")
Sqladd(" "~FStr(Val(pr:1), 0, 8)~", '"~Val(bk:1)~"', '"~dialogo.nrtrans1~"') ")
