Sqladd("Select O.NrOperacion, O.RB3 from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B where O.NrOperacion=B.NrOperacion and B.NrBit=5 and B.Valor='1' and O.Direccion=1")
recorrer sql
Sqladd("Delete from "~Dbo()~".EXCEPCIONES where NrOperacion='"~Fbn('NrOperacion')~"' and Tipo in ('xxx','yyy')")
Sqlnew()
if (Fbn('RB3') = 1)
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=1")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=2")
endif
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=5")
Sqlnew()
Sqladd("Insert into "~Dbo()~".EXCEPCIONES")
Sqladd("(NrOperacion, Tipo, Fecha, Descripcion) values")
Sqladd("('"~Fbn('NrOperacion')~"', 'RECHAZO', '"~IdxDate(FSys())~"', 'La Operacion fue rechazada por el supervisor')")
Sqlnew()
Sqlexec()
proximo

