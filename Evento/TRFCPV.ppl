CrearDialogo
  Fecha1     :'F.Transf'    ;1;1;;;;Dialogo.Fecha1 <= Fsys ;'Debe Ingresar una Fecha';NO;FSys
  Fecha2     :'F.Dividendo' ;1;2;;;;Dialogo.Fecha1 <= Fsys ;'Debe Ingresar una Fecha';NO;FSys
  Especie1   :'Especie'     ;3;1;;;;DesciendeDeEspecie(Dialogo.Especie1,'FONDOS');'Debe Ingresar una Especie de Fondos';NO;;;;;;" Codigo IN("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") "
  Vehiculo1  :'De Vehiculo' ;5;1;;;;NoVacio(Dialogo.Vehiculo1) y Eqstr(BuscarCampo('Vehiculos','TipoVehiculo','Codigo', Dialogo.Vehiculo1) , 'DIV') Y Not Eqstr(Dialogo.Vehiculo1, Dialogo.Vehiculo2);'Vehiculo Origen Invalido';NO;;;;;; " TipoVehiculo = 'DIV' "
  Vehiculo2  :'A Vehiculo'  ;5;2;;;;NoVacio(Dialogo.Vehiculo2) y Eqstr(BuscarCampo('Vehiculos','TipoVehiculo','Codigo', Dialogo.Vehiculo2) , 'DIV');'Vehiculo Destino Invalido';NO;;;;;; " TipoVehiculo = 'DIV' "
  Cliente1   :'De Banco'    ;7;1;;;;Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB');'Banco Origen Invalido';NO;;BuscarCampo('ESPECIES','Issuer','Codigo', Dialogo.Especie1);;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES','BANCOS'))~") and Status = 'HAB' ";
  Cliente2   :'A Banco'     ;7;2;;;;Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente2), 'HAB');'Banco Destino Invalido';NO;;BuscarCampo('ESPECIES','Issuer','Codigo', Dialogo.Especie1);;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES','BANCOS'))~") and Status = 'HAB' ";
  Cuenta1    :'De Cuenta'   ;9;1;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',Dialogo.Cuenta1), Dialogo.Cliente1) Y Eqstr(BuscarCampo('CUENTAS','Cliente','Codigo',Dialogo.Cuenta1), Dialogo.Vehiculo1);'Cuenta Origen Invalida';NO;;;;;;" Cliente = '"~Dialogo.Vehiculo1~"' and Estado='HAB' and (Especies LIKE '%"~Dialogo.Especie1~"%' or Especies LIKE '%FONDOS%') AND Comitente = '"~Dialogo.Cliente1~"' "
  Cuenta2    :'A Cuenta'    ;9;2;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',Dialogo.Cuenta2), Dialogo.Cliente2) Y Eqstr(BuscarCampo('CUENTAS','Cliente','Codigo',Dialogo.Cuenta2), Dialogo.Vehiculo2);'Cuenta Origen Invalida';NO;;;;;;" Cliente = '"~Dialogo.Vehiculo2~"' and Estado='HAB' and (Especies LIKE '%"~Dialogo.Especie1~"%' or Especies LIKE '%FONDOS%') AND Comitente = '"~Dialogo.Cliente2~"' "
  Book1:     'Book'         ;11;1;;NO;;;;;Var('BOOKDEF');
FinDialogo

if Not Ok
  Cancelar
endif

SQL.ADD(" Select NrOperacion ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where TipoOp = 'TRANFC' ")
SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND Vehiculo2 = '"~Dialogo.Vehiculo2~"' ")
SQL.ADD(" AND CB7 = '1' ")
Recorrer SQL
    Cancelar('Ya se realizo en la fecha una transferencia de '~Dialogo.Especie1~' de '~Dialogo.Vehiculo1~' a '~Dialogo.Vehiculo2)
Proximo

ACN(BD:1, 0)
***---Obtengo los pago de dividendo que debe hacer el Vehiculo1 al Vehiculo2
SQL.ADD(" Select O.NrOperacion, O.OperacionRef, TotalBrutoCli1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp = 'DIVIDE' ")
SQL.ADD(" AND O.FechaOp = '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.TipoOp In ('DIVIDE') ")
SQL.ADD(" AND O.MB3 = 1 ")
SQL.ADD(" AND O.MB4 = 4 ")
SQL.ADD(" AND O.TipoCambio3 = 101 ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND O.Vehiculo2 = '"~Dialogo.Vehiculo2~"' ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"' ")
SQL.ADD(" Order By O.NrOperacion ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('OperacionRef'))
    ACN(C:fac, fbn('TotalBrutoCli1'))
    SCN(VN:1, Val(C:fac))
    ACN(BD:1, 1)
Proximo

IF Val(BD:1) =0
   Cancelar('No hay Dividendos por Prestamos a Transferir para los datos Ingresados')
EndIf

ifa
ACT(A:fac, 'TOTAL')
ACN(C:fac, Val(VN:1))


CrearListBox ; 'MS Sans Serif,8,'; 'Transferencia FCI de '~Dialogo.Especie1~' de '~Dialogo.Vehiculo1~' a '~Dialogo.Vehiculo2
  'NrOperacion'        ;A:1..A:Fac;NO;SI;;90;STRING;
  'Op Contraria'       ;B:1..B:Fac;NO;SI;;90;STRING;
  'Cantidad'           ;C:1..C:Fac;NO;SI;;120;NUMERO;'###,###,###,###.##'
FinListBox

If Not Ok 
   Cancelar
Endif

ACN(NM:1, BuscarCampo('VEHICULOS','Alias1','Codigo', Dialogo.Vehiculo1))
ACT(CE:1, CotizaEn(Dialogo.Especie1))
Recorrer&k fac, fac
    ACT(OP:1, GetNumerador(Val(NM:1))) 
    SQL.ADD(" INSERT INTO "~DBO~".OPERACIONES ")
    SQL.ADD(" (TipoOp, NrOperacion, Especie, ")
    SQL.ADD(" Vehiculo1, Vehiculo2, Cantidad, Numerador, ")
    SQL.ADD(" FechaOp, FechaCarga, FechaCargaSys, ")
    SQL.ADD(" UsrInput, Operador, FechaVto, Cliente1, ")
    SQL.ADD(" Cliente2, Cuenta4, Cuenta1, Book1, ")
    SQL.ADD(" Book2, MB3, ContraEspecie, FechaPago, ")
    SQL.ADD(" CB7 ) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('TRANFC', '"~Val(OP:1)~"', '"~Dialogo.Especie1~"', ")
    SQL.ADD(" '"~Dialogo.Vehiculo1~"', '"~Dialogo.Vehiculo2~"', "~Fstr(Val(C:&k), 0, 2)~", "~Fstr(Val(NM:1), 0, 0)~", ")
    SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', "~SQLAhora~", '"~IdxDate(Fsys)~"', ")
    SQL.ADD(" '"~UsuarioActivo~"', '"~UsuarioActivo~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Dialogo.Cliente1~"', ")
    SQL.ADD(" '"~Dialogo.Cliente2~"', '"~Dialogo.Cuenta1~"', '"~Dialogo.Cuenta2~"', '"~Dialogo.Book1~"', ")
    SQL.ADD(" '"~Dialogo.Book1~"', 1, '"~Val(CE:1)~"', '"~IdxDate(Dialogo.Fecha2)~"', ")
    SQL.ADD(" '1' ) ")
    SQL.NEW
    SQL.EXEC
    Message('Generando - Op '~Val(OP:1)~' En Instancia Terminal')
    EjecutarEvento('INSBIT',String1='OPERACIONES',Entero1=19,NrOperacion1=Val(OP:1))
    SQL.ActualizarMovimientos2(Val(OP:1),SI,NO,NO,SI)
    SQL.EXEC
    EjecutarEvento('INVIMV',NrOperacion1=Val(OP:1),TipoOp1='TRANFC',Vehiculo1=Dialogo.Vehiculo2,Vehiculo2=Dialogo.Vehiculo1, String=" MB3=0, Cuenta4=Cuenta1, Cuenta1=Cuenta4 ", String1='', String2='')
Proximo
