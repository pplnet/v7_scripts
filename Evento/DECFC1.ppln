HojaVisible(NO)
creardialogo
nroperacion1: 'Nr.Operacion:';1;1;
findialogo

if (not ok)
Cancelar()
endif

Act(a:1, dialogo.nroperacion1)
Act(a:2, BuscarCampo('OPERACIONES', 'Especie', 'NrOperacion', dialogo.nroperacion1))
Acn(a:3, BuscarCampo('ESPECIES', 'Valor2', 'Codigo', Val(a:2)))
Acn(a:4, BuscarCampo('OPERACIONES', 'Cantidad', 'NrOperacion', dialogo.nroperacion1))
Acn(a:6, trunc2(Val(a:4), Val(a:3)))

FormatoCeldas(a:4..a:6, Exe('F8'))

Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set Cantidad = "~FStr(Val(a:6), 0, Val(a:3))~" ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

SqlActualizarmovimientos2(dialogo.nroperacion1, SI, NO, NO, SI)
Sqlexec()
