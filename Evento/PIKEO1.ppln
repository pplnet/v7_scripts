creardialogo
nroperacion1: 'Operacion';1;1;;;;Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMONM') y BuscarCampo('OPERACIONES', 'RB7', 'NrOperacion', dialogo.nroperacion1) = 1;'Operacion invalida';NO;;;;;;"TipoOp='MMONM' and RB7=1"
fecha1: 'FechaVto';2;1;;;;dialogo.fecha1 <> 0;'Ingrese la fecha de vencimiento';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

if (sql("Select 1 From "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ") <> 1)
Cancelar()('No hay emision que venza en esa fecha')
endif

if (sql("Select 1 From "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and Fecha2 = '"~IdxDate(dialogo.fecha1)~"' and Fecha2 < '"~IdxDate(sql("Select Max(Fecha2) From "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' "))~"' and (Check5 = 0 or Check5 is Null) and Check6 = 1 and Check7 = 0 ") = 1)
ejecutarevento('PIKEO2', nroperacion1 = dialogo.nroperacion1, fecha1 = dialogo.fecha1, radio1 = 1)
sql.actualizarmovimientos3(dialogo.nroperacion1, SI, NO, NO, SI, SI)
sql.exec
else
Cancelar()('Por la Emision '~dialogo.nroperacion1~' que vence el '~dialogo.fecha1~' no puede optarse pikear o ya fue pikeada')
endif
