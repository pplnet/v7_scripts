* DTEJEO: Ejercico de Swaps de Tasas F V MV
CrearDialogo
   Fecha1       : "F Real Ej."               ;1;1;;;;Dialogo.Fecha1=Dialogo.Fecha2;'FECHA EJERCICIO REAL TIENE QUE SER IGUAL A FECHA RESET';NO;Fsys
   NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTSFVM');'DEBE INGRESAR UNA OPERACION DE TIPO DTC';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'DTSFVM' ")
   Entero1      : "Nro. Settlement"          ;;;;;;Dialogo.Entero1>0;'DEBE INDICAR EL NUMERO DE SETTLEMENT';NO;0;
   Precio2      : "Tasa"                     ;;;;;;Dialogo.Precio2<=VAR('RTASA2') Y Dialogo.Precio2>=VAR('RTASA1');'Tasa del Vehiculo Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;0
   Fecha2       : "Fecha Reset"              ;;;;NO;;;;;;SQL("Select Fecha4 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
   Fecha3       : "F Settlement "            ;;;;NO;;;;;;SQL("Select Fecha3 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
   Fecha4       : "F Fin Settlement"         ;;;;NO;;;;;;SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
FinDialogo

If Not Ok
   Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTSFVM|')
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es un Swap Fijo Variable MV')
Endif

* Verifico que se encuentre en Back Office o Terminal
ACN(x1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If Val(x1)<>20 y Val(x1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf


If Ok
   * x1: Recupero la Operacion
   ACN(x1,0)

   * Veo si la operacion es del tipo COMPENSACION o FLUJO DE FONDOS
   ACN(x2,SQL("Select RB6 FROM "~DBO~".OPERACIONES Where NrOperacion='"~Dialogo.NrOperacion1~"'") )


   SQL.ADD("SELECT * FROM "~DBO~".CUOTAS ")
   SQL.ADD("WHERE  NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("       and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")

   Recorrer SQL
      *** CALCULA EL INT PAY Y RES SEGUN SEA FIX O FLOAT EL VEHICULO
          
      *** z11 DAY COUNT +1 YA QUE LA FUNCION LO REQUIERE ASI
      *** z24 ES EL INTEREST PAYMENT
      *** z20 ES EL RESULTADO
      ACN(x1,1)
      ACN (z11, (BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))
      ACN (z12, (BuscarCampo('Operaciones','RB5','NrOperacion',Dialogo.NrOperacion1)+1))
      ACN (z24, 0)
      ACN (z20, 0)    
          
      Message ('Calculando interes .... ')                  
      If EqStr(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1),'0')
         * Vehiculo Fijo ==> Calcula el interes para la contraparte
         ACN(z24, ((FBN['Cantidad2']*(Dialogo.Precio2+FBN['Total4']))/100)*FACTORDIAS(FBN['Fecha5'],FBN['Fecha6'],VAL(z12)))
      Else
         * Vehiculo Variable ==> Calcula el interes para el vehiculo
         ACN(z24, ((FBN['Cantidad1']*(Dialogo.Precio2+FBN['Total3']))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(z11)))
      Endif
           
      Message ('Calculando resultado .... ')     
      * z21: Especie 
      * z22: ContraEspecie
      ACT(z21,BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)) 
      ACT(z22,BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1)) 
           
      If EqStr(VAL(z21),VAL(z22)) y Val(x2)=0 y Dialogo.Precio2<>0
         If EqStr(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1),'0')
            ACN(z20, VAL(z24)-FBN['Cantidad3'])
         Else
            ACN(z20, FBN['Cantidad4']-VAL(Z24))
         Endif
      Endif

      if Dialogo.Precio2<>0
         ACT(zz1,'1')
      else
         ACT(zz1,'0')
      endif
            
      Message('Actualizando la Opcion .... Interes '~Fstr(val(z24),0,2)~' '~fbn('Cantidad4'))                  
      *** Marca la operacion como ejercida ***
      SQL.ADD("UPDATE "~DBO~".CUOTAS ")
      SQL.ADD("SET    Check1 = '"~Val(zz1)~"', ")
      SQL.ADD("       Fecha4 = '"~IdxDate(Dialogo.Fecha2)~"', ")
      *SQL.ADD("       Fecha3 = '"~IdxDate(Dialogo.Fecha3)~"', ")
      SQL.ADD("       Total2 = "~Fstr(VAL(z20),0,2)~", ")
      
      If EqStr(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1),'0')
         SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("Cantidad4   = "~Fstr(Val(z24),0,7)~",  ")
         SQL.ADD("Precio6   = "~Fstr(Val(z24),0,7)~"  ")
      Else
         SQL.ADD("Precio1   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("Cantidad3   = "~Fstr(Val(z24),0,7)~",  ")
         SQL.ADD("Precio5   = "~Fstr(Val(z24),0,7)~"  ")
      Endif
       
      SQL.ADD("WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("      and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
      *SQL.ADD("      and Check1='0' ")
      SQL.NEW
      SQL.EXEC


      ACT(or1,BuscarCampo('Operaciones','OperacionRef','NrOperacion',Dialogo.NrOperacion1)) 

      IF Not EqStr(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1),'0') y NoVacio(val(or1))
         *- Si el vehiculo es variable
         EjecutarEvento('TTNOP',NrOperacion1=val(or1),Entero1=0,NrOperacion2=Dialogo.NrOperacion1,Lista1=Fstr(Dialogo.Entero1,0,0)~'|')
      EndIf


        
      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)     
        
      * z23: Cliente de la Operacion  Z24: Vehiculo Z25: Especie de Mov. Z26: Signo 
      ACT(z23,BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)) 
      ACT(z24,BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)) 
        
      *** Actualiza movimientos y limites ****
      SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
      SQL.EXEC
   Proximo
           
   If Val(x1)=0
      Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   Endif
Endif