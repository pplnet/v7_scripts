hojavisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1    :"Fecha"            ;1;1;;NO;;;;;;FSYS
  Fecha2    :"Fecha a Procesar" ;2;1;;  ;;;;;HABILES(FSYS,-1,'ARG')
  String    :"Archivo"          ;3;1;;  ;;NOVACIO(Dialogo.String) ;'Archivo Invalido'   ;NO;VAR('DNCOBRA')
  String2   :"Nuevo Directorio" ;4;1;;  ;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(x:3,0)
ACN(x:4,0)

If ExisteArchivo(Dialogo.String)

  If ExisteArchivo(VAR("DNERROR"))
    BorrarArchivo(VAR("DNERROR"))
  EndIf

  SQL.ADD(" SELECT M.Vehiculo, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, M.DC, ")
  SQL.ADD(" M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, M.EstadoConciliacion ")
  SQL.ADD(" FROM " ~DBO~ ".MOVDATANET M, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE M.NrDatanet = D.NrDatanet ")
  SQL.ADD(" AND D.FechaBajada = '" ~Dialogo.Fecha1~ "' ")

  Recorrer SQL
    message('Recuperando MovDatanet del dia.')
    ACN(x:3,1)
    ACT(ba:fac,fbn("vehiculo"))
    ACT(bb:fac,fbn("sucursal"))
    ACT(bc:fac,fbn("cuenta"))
    ACT(bd:fac,fbn("moneda"))
    ACT(be:fac,fbn("importe"))
    ACT(bf:fac,fbn("dc"))
    ACT(bg:fac,fbn("fechaingreso"))
    ACT(bh:fac,fbn("fechaacreditacion"))
    ACT(bi:fac,fbn("tipomov"))
    ACT(bj:fac,fbn("comprobante"))
  Proximo

  AbrirAscii(Dialogo.String,0)


  Recorrer&i 0,1000000
    ACT(x:1,LEERASCII)
    message(' Registrando movimientos del archivo.')

    If Eqstrl(Val(x:1),"F",1)
      * Termino el archivo
      Break  
    Endif

    If Eqstrl(Val(x:1),"C",1)
      ACT(aa:&i,Copy(Val(x:1),1,1))
      ACT(ab:&i,Copy(Val(x:1),2,3))
      ACT(ac:&i,Copy(Val(x:1),5,2))
      ACT(z:&i,Copy(Val(x:1),7,17))

*      SQL.ADD("SELECT Cliente FROM "~DBO~".CUENTAS WHERE Numero like '%"~val(z:&i)~"%' AND ")
*      SQL.ADD(" Estado='HAB' ")
*      Recorrer SQL
*        ACT(ad:&i, fbn("Cliente"))
*      Proximo

      ACT(ad:&i, SQL(" SELECT Cliente FROM "~DBO~".CUENTAS WHERE Numero = '"~TRIM(MIRT(Val(z:&i)))~"' ") )

      ACT(ae:&i,Copy(Val(x:1),24,3))
      ACT(af:&i,Copy(Val(x:1),32,2)~'/'~Copy(Val(x:1),33,2)~'/'~Copy(Val(x:1),27,4))
      ACD(af:&i,Fecha(Val(af:&i)))
      ACT(ag:&i,Copy(Val(x:1),35,3))
      ACT(ah:&i,Copy(Val(x:1),42,2)~'/'~Copy(Val(x:1),44,2)~'/'~Copy(Val(x:1),38,4))
      ACD(ah:&i,Fecha(Val(ah:&i)))
      ACT(ai:&i,Copy(Val(x:1),46,16))
      ACT(aj:&i,Copy(Val(x:1),62,10))
      ACT(ak:&i,Copy(Val(x:1),72,24))
      ACT(al:&i,Copy(Val(x:1),96,4))
      ACT(am:&i,Copy(Val(x:1),100,1))
      ACN(an:&i, NUM(COPY(Val(an:&i),101,16)~'.'~COPY(Val(an:&i),117,2)))
      ACT(ao:&i,Copy(Val(x:1),119,1))
      ACT(ap:&i,Copy(Val(x:1),120,21))
      ACT(aq:&i, Val(x:1))
    EndIf
  Proximo
  CerrarAscii

  ACN(x:5, &i)

  ACT(x:2,getnumerador(7))
  AbrirAscii(VAR("DNERROR"),0)

  If val(x:3) = 1
    * Encontro MovDatanet del Dia.
    ACN(nm:1,0)
    Recorrer&i 0,val(x:5)
      SCN(nm:1,1)
      * Recorre los mov del ASCII

      If NoVacio(val(ad:&i))
        * Si tiene vehiculo 
        Repetir
          If val(ad:&i) = val(ba:val(x:4)) y val(ab:&i) = val(bb:val(x:4)) y val(ag:&i) = val(bc:val(x:4)) y val(ad:&i) = val(bd:val(x:4)) y val(ae:&i) = val(be:val(x:4)) y val(an:&i) = val(bf:val(x:4)) y val(ao:&i) = val(bg:val(x:4)) y val(ah:&i) = val(bh:val(x:4)) y val(af:&i) = val(bi:val(x:4)) y val(al:&i) = val(bj:val(x:4))
            Break
          Else
            SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
            SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, Banco, Sucursal, ")
            SQL.ADD(" Cuenta, Moneda, Importe, DC, FechaIngreso, ")
            SQL.ADD(" FechaAcreditacion, TipoMov, Comprobante, EstadoConciliacion ")
*            SQL.ADD(" ) VALUES ( '"~val(x:2)~"', "~fstr(Num(getnumerador(6)),0,0)~", ")
*            SQL.ADD(" '"~val(ad:&i)~"', '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(ad:&i)~"', ")
            SQL.ADD(" ) VALUES ( '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", ")
            SQL.ADD(" '"~val(ad:&i)~"', '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(z:&i)~"', ")
            SQL.ADD(" '"~trim(mirt(val(ae:&i)))~"', "~fstr(val(an:&i),1,2)~", '"~val(ao:&i)~"', ")
            SQL.ADD(" '"~val(ah:&i)~"', '"~val(af:&i)~"', 'CB', '"~val(al:&i)~"', 'P' )  ")
            SQL.NEW
            SQL.EXEC
            message(' Movimiento nuevo OK.')
          Endif
          SCN(x:4,1)
        Proximo
      Else
        message(' La cuenta '~Val(z:&i)~' no existe.')
        * Si no tiene vehiculo graba el error.
*        EscribirAscii(val(aa:&i)~val(ab:&i)~val(ac:&i)~val(z:&i)~val(ae:&i)~copy(val(af:&i),7,4)~copy(val(af:&i),1,2)~copy(val(af:&i),4,2)~val(ag:&i)~copy(val(ah:&i),7,4)~copy(val(ah:&i),1,2)~copy(val(ah:&i),4,2)~val(ai:&i)~val(aj:&i)~val(ak:&i)~val(al:&i)~val(am:&i)~Copy(val(an:&i),1,16)~Copy(val(an:&i),18,2)~val(ao:&i)~val(ap:&i))
        EscribirAscii(Val(aq:&i))
      Endif
    Proximo
    CerrarAscii

  Else
    * No hay MovDatanet del Dia
    ACN(nm:1,0)
    Recorrer&i 1,val(x:5)
      SCN(nm:1,1)
      If NoVacio(val(ad:&i))
        SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
        SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
        SQL.ADD(" Banco, Sucursal, Cuenta, ")
        SQL.ADD(" Moneda, Importe, DC, ")
        SQL.ADD(" FechaIngreso, FechaAcreditacion, TipoMov,  ")
        SQL.ADD(" Comprobante, EstadoConciliacion ")
        SQL.ADD(" ) VALUES ( ")
*        SQL.ADD(" '"~val(x:2)~"', "~fstr(Num(getnumerador(6)),0,0)~", '"~val(ad:&i)~"', ")
*        SQL.ADD("  '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(ad:&i)~"', ")

        SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ad:&i)~"', ")
        SQL.ADD("  '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(z:&i)~"', ")
        SQL.ADD(" '"~trim(mirt(val(ae:&i)))~"', "~fstr(val(an:&i),1,2)~", '"~val(ao:&i)~"', ")
        SQL.ADD(" '"~val(ah:&i)~"', '"~val(af:&i)~"', 'CB', ")
        SQL.ADD(" '"~val(al:&i)~"', 'P' ")
        SQL.ADD(" ) ")
        SQL.NEW
        message(' Movimiento nuevo OK.')
        SQL.EXEC          
      Else
        EscribirAscii(Val(aq:&i))
        *messagebox(val(ax:&i))
        *EscribirAscii(val(aa:&i)~val(ab:&i)~val(ac:&i)~val(z:&i)~val(ae:&i)~copy(val(af:&i),7,4)~copy(val(af:&i),1,2)~copy(val(af:&i),4,2)~val(ag:&i)~copy(val(ah:&i),7,4)~copy(val(ah:&i),1,2)~copy(val(ah:&i),4,2)~val(ai:&i)~val(aj:&i)~val(ak:&i)~val(al:&i)~val(am:&i)~Copy(val(an:&i),1,16)~Copy(val(an:&i),18,2)~val(ao:&i)~val(ap:&i))
        message(' La cuenta '~Val(z:&i)~' no existe.')
      Endif
    Proximo
    CerrarAscii

    SQL.ADD(" INSERT INTO "~DBO~".DATANET ( ")
    SQL.ADD(" NrDatanet, FechaBajada, Archivo, ")
    SQL.ADD(" FechaDesde, FechaHasta, Usuario, Estado ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~val(x:2)~"', '"~idxdate(Dialogo.Fecha1)~"', 'DNCOBR',  ")
*    SQL.ADD(" '"~idxdate(Dialogo.Fecha2-60)~"', '"~idxdate(Dialogo.Fecha2)~"', ")
    SQL.ADD(" '"~idxdate(Dialogo.Fecha2-VAR('DNTIEMPO'))~"', '"~idxdate(Dialogo.Fecha2)~"', ")
    SQL.ADD(" '"~UsuarioActivo~"', 'A' ) ")
    SQL.NEW
    SQL.EXEC
    If Dialogo.Radio1=0
      WinExec("COMMAND.COM /C copy "~Dialogo.String~" "~Dialogo.String2~"dncobr"~fstr(Dia(Dialogo.Fecha1),0,0)~fstr(Mes(Dialogo.Fecha1),0,0)~fstr(Anio(Dialogo.Fecha1),0,0)~".dat",1)
    Else
      WinExec("CMD.EXE /C copy "~Dialogo.String~" "~Dialogo.String2~"dncobr"~fstr(Dia(Dialogo.Fecha1),0,0)~fstr(Mes(Dialogo.Fecha1),0,0)~fstr(Anio(Dialogo.Fecha1),0,0)~".dat",1)
    Endif
    BorrarArchivo(Dialogo.String)
  Endif
Else
  Cancelar('El archivo '~Dialogo.String~' aun no se ha generado.')
EndIf