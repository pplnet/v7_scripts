Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '0' ")
Sqladd(" Where NrOperacion = '"~Val(a:2)~"' ")
Sqladd(" and Valor         =  '1'  ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
