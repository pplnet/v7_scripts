Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion,NrBit,Valor) ")
Sqladd("  SELECT '"~Val(a:2)~"' As NrOperacion,NrBit,Valor ")
Sqladd("    FROM "~Dbo()~".OPERACIONESBITS ")
Sqladd("   WHERE NrOperacion=(Select TOP 1 NrOperacion From "~Dbo()~".OPERACIONES Where TipoOp='SEPVMV') ")
