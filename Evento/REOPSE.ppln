DialogoVisible(NO)
creardialogo
fecha1: 'F.Liquid';;;;NO;NO;;;;FSys()
string1: 'Path';;;;NO;NO;;;;Var('PATHSENEB')
findialogo

if (not ok)
Cancelar()
endif

sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor = 0 where                  ")
sql.add(" NrOperacion in (select O.NrOperacion from "~Dbo()~".OPERACIONES O    ")
sql.add("                 where  O.TipoOp in ('TIC','TIV')                   ")
sql.add("                    and O.Mercado4 = 'BYMA'                         ")
sql.add("                    and O.CB3 = 1                                   ")
sql.add("                  and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"' )   ")
sql.new

sql.exec

sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor = 1 where NrBit = 10  and  ")
sql.add(" NrOperacion in (select O.NrOperacion from "~Dbo()~".OPERACIONES O    ")
sql.add("                    where  O.TipoOp in ('TIC','TIV')                ")
sql.add("                       and O.Mercado4 = 'BYMA'                      ")
sql.add("                       and O.CB3 = 1                                ")
sql.add("                    and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"')  ")
sql.new

sql.exec

