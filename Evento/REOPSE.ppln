Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor = 0 where                  ")
Sqladd(" NrOperacion in (select O.NrOperacion from "~Dbo()~".OPERACIONES O    ")
Sqladd("                 where  O.TipoOp in ('TIC','TIV')                   ")
Sqladd("                    and O.Mercado4 = 'BYMA'                         ")
Sqladd("                    and O.CB3 = 1                                   ")
Sqladd("                  and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"' )   ")
Sqlnew()

Sqlexec()

Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor = 1 where NrBit = 10  and  ")
Sqladd(" NrOperacion in (select O.NrOperacion from "~Dbo()~".OPERACIONES O    ")
Sqladd("                    where  O.TipoOp in ('TIC','TIV')                ")
Sqladd("                       and O.Mercado4 = 'BYMA'                      ")
Sqladd("                       and O.CB3 = 1                                ")
Sqladd("                    and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"')  ")
Sqlnew()

Sqlexec()

