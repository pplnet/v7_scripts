if (Val(t:Val(r:2)) > -0.01)
Acn(b:10, 0)
Acn(b:4, 0)
Act(c:4, 'Cobro')
else
Acn(b:4, 1)
Act(c:4, 'Pago')
if (Val(t:Val(r:2) - 1) >= 0)
Acn(b:10, -Val(t:Val(r:2)))
else
Acn(b:10, -(Val(t:Val(r:2)) - Val(t:Val(r:2) - 1)))
if (Val(b:10) < 0.01)
Acn(b:10, 0)
Acn(b:4, 0)
Act(c:4, 'Cobro')
endif
endif
endif
endif
endif
else
if (Val(b:9) > 0)
