SetFilaActual(0)
sql.add("Select * from "~Dbo()~".TRANSACCIONES2 ")
sql.add(" where TipoTr2   in ('OCTDEP','OCTRET') ")
sql.add("   and Fecha1    = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   and Vehiculo1 = '"~dialogo.vehiculo1~"' ")
if (dialogo.check1 = 0 y Val(c2) = 1)
sql.add("   and Precio5   < "~dialogo.precio1~" ")
endif
sql.add(" order by Precio5 ")
recorrer sql
Scn(f:2, 1)
Act(g:fac, Fbn('NrTrans'))
Act(h:fac, Fbn('TipoTr2'))
Acd(i:fac, Fbn('Fecha1'))
Acd(j:fac, Fbn('Fecha2'))
Acn(k:fac, Fbn('RB1'))
if (Fbn('RB1') = 0)
Act(l:fac, 'Autom')
else
Act(l:fac, 'Manual')
endif
Acn(m:fac, Fbn('Precio5'))
if (Fac() = 1)
if (Val(m:fac) <> 0)
Acn(e:2, 1)
Act(n:fac, 'Error 0')
endif
endif
if (Fac() > 1)
if (Val(m:fac) <> Val(m:fac - 1) + 1)
Acn(e:2, 1)
Act(n:fac, 'Error Ant')
endif
endif
Acn(o:fac, Fbn('Cantidad1'))
if (Eqstr(Fbn('TipoTr2'), 'OCTDEP'))
Acn(p:fac, Fbn('Cantidad1'))
Scn(ae:1, Fbn('Cantidad1'))
else
Acn(p:fac, -Fbn('Cantidad1'))
Scn(ae:2, -Fbn('Cantidad1'))
endif
proximo
Acn(b:8, Val(m:fac))
if (Val(e:2) = 1)
Acn(e:1, 1)
if (dialogo.radio1 = 0 y Val(c2) = 0)
Message('Error en Transacciones ya existentes.')
else
Messagebox('Error en Transacciones ya existentes.')
endif
endif
Acn(b:9, dialogo.precio1)
if (Val(f:2) > 0)
recorrer&i 1, Val(f:2)
if (Val(b:9) = Val(m:&i))
Acn(e:1, 1)
if (dialogo.radio1 = 0)
if (dialogo.check1 = 1 y Val(c2) = 0)
Message('Ya existe transaccion Paso '~FStr(Val(b:9), 1, 0)~' ('~Val(g:&i)~')')
else
Messagebox('Ya existe transaccion Paso '~FStr(Val(b:9), 1, 0)~' ('~Val(g:&i)~')')
