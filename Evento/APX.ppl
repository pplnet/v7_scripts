MostrarCuadroDeMensajes
HOJAVISIBLE(SI)
CrearDialogo
  Fecha1 :"Fecha: " ;1;1;;NO;;;;;;FSYS
  String :'Path:  ' ;2;1;;;;NOVACIO(Dialogo.String);'Path Invalido';NO;VAR('DIRDATANET');
  String3: 'Archivo';
  String2   :"Nuevo Directorio" ;;;;;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;0
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(fi:1,0)

AbrirAscii(Dialogo.String~Dialogo.String3,0)
messageBOX(' Abriendo Archivo '~MIRT(TRIM(Dialogo.String))~Dialogo.String3)

Recorrer&i 1,10000000
    * Lee el registro
    ACT(x:1,LEERASCII)

    * Guardo la fila por donde voy
    ACN(fi:1, &i)
    ACN(fi:2, &i)

    * Si esta vacio se va
    If Vacio(val(x:1))
      Break  
    Endif

    ACN(fi:3, 1)

    * Si es un registro de inicio
    If Incluido(Copy(Val(x:1),1,1),'I')

      ACT(nu:1, GetNumerador(10105))

      * --- Pregunta por el tipo de Archivo y crea el nombre correspondiente --- *

      If Incluido(Copy(Val(x:1),17,6),'DNCTAS')
        message('Tipo de Archivo encontrado: DNCTAS')
        * --- Nombre del archivo a generar
        ACT(a:&i, 'DNCTAS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        * --- Registro de Datos
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNAHMS')
        message('Tipo de Archivo encontrado: DNAHMS')
        * --- Nombre del archivo a generar
        ACT(a:&i, 'DNAHMS'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        * --- Registro de Datos
        ACT(b:&i,  Val(x:1))
      Endif

      If Incluido(Copy(Val(x:1),17,6),'DNCCDO')
        message('Tipo de Archivo encontrado: DNCCDO')
        * --- Nombre del archivo a generar
        ACT(a:&i, 'DNCCDO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        * --- Registro de Datos
        ACT(b:&i,  Val(x:1))
      Endif
 
      If Incluido(Copy(Val(x:1),17,6),'DNCADO')
        message('Tipo de Archivo encontrado: DNCADO')
        * --- Nombre del archivo a generar
        ACT(a:&i, 'DNCADO'~fstr(NUM(Val(nu:1)),0,0)~'.DAT')
        * --- Registro de Datos
        ACT(b:&i,  Val(x:1))
      Endif
    Else
      * --- Registro de Datos
      ACT(b:&i,  Val(x:1))
    Endif
Proximo
CerrarAscii

Recorrer&i 1, Val(fi:2)
 If NoVacio(Val(a:&i)) 
    If &i<>1
      * Como no es el primero lo cierro
      CerrarAscii
    Endif

    AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(a:&i),0)

    *Lista de Archivos generados
    ACT(li:1, Val(li:1)~Val(a:&i)~'|')

    message('Nuevo archivo: '~MIRT(TRIM(Dialogo.String))~Val(a:&i))
    EscribirAscii(Val(b:&i))
 Else
   If NoVacio(Val(b:&i))
     EscribirAscii(Val(b:&i))
   Else
     CerrarAscii
     Break
   Endif
 Endif
Proximo
CerrarAscii

if no

* Largo del nombre
ACN(ar:2, Longitud(Dialogo.String3))

* Le resto el .dat 
ACN(ar:3, Val(ar:2)-4)

* Guardo el nombre sin extension
ACT(ar:4, COPY(Dialogo.String3,1,Val(ar:3)))
ACT(ar:1, Val(ar:4)~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")

If Dialogo.Radio1=0
  * --- Copia el archivo en Procesados
  * Copia el archivo en Procesados
  WinExec("COMMAND.COM /C COPY  "~MIRT(TRIM(Dialogo.String))~Dialogo.String3~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
  Esperar(5)

  * --- Borra el archivo Procesado
  WinExec("COMMAND.COM /C del   "~MIRT(TRIM(Dialogo.String))~Dialogo.String3,0)
  Esperar(5)
Else
  * --- Copia el archivo en Procesados
  WinExec("CMD.EXE /C COPY  "~MIRT(TRIM(Dialogo.String))~Dialogo.String3~" "~MIRT(TRIM(Dialogo.String2))~Val(ar:1),0)
  Esperar(5)

  * --- Borra el archivo Procesado
  WinExec("CMD.EXE /C del   "~MIRT(TRIM(Dialogo.String))~Dialogo.String3,0)
  Esperar(5)
Endif



Esperar(10)

MESSAGEBOX(Val(li:1))

Recorrer&i 1,Elementos(Val(li:1))
   ACT(ww:1, ItemLista(Val(li:1),&i) )
   Message('Saldos y Movimientos '~Val(ww:1))
   act(zz:1, MIRT(TRIM(Dialogo.String))~Val(ww:1) )
   messagebox('proceso esto '~VAL(ZZ:1))
   EjecutarEvento('APBD3',Fecha1=Dialogo.Fecha1,Fecha2=HABILES(Dialogo.Fecha1,-1,'ARG'),String=MIRT(TRIM(Dialogo.String))~Val(ww:1),String2=VAR('DNPROCES'),Radio1=Dialogo.Radio1,Check10=0)
Proximo

endif


