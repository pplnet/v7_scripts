ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'FCS|');'El TipoOp debe ser FCS';NO;;;;;;" TipoOp in ('FCS') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACFCS')
FinDialogo

If Not OK
  Cancelar
Endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

SQL.ADD("Select O.TipoOp,O.TotalNetoCli1, O.Cliente1,O.Especie,O.Vehiculo1,O.NrOperacion,O.Cuenta2,O.Cuenta1,O.TotalNetoCli1,O.ContraEspecie, ")
SQL.ADD("C.Localidad, C.Telefono, C.Fax, C.CUIT, C.RazonSocial, C.Direccion,C.CodigoPostal,C.PaisDir,C.Provincia, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C   ")
SQL.ADD(" Where NrOperacion ='"~Dialogo.NrOperacion1~"' and O.Vehiculo1=C.Codigo  ")
Recorrer SQL
  ACT(zd:99,fbn['TipoOp'])
  ACT(zz:98,fbn['ContraEspecie'])
  ACT(zd:88,fbn['Cliente1'])  
  ACT(za:99,fbn['Cuenta2']) 
  ACN(zb:99,fbn['TotalNetoCli1'])
  let &localidad fbn['Localidad']
  ACT(zz:99,fbn['Vehiculo1'])
  let &nr_operacion fbn['NrOperacion']
  ACT(ab:99,fbn['Cuenta2']) 
  ACN(ac:99,fbn['TotalNetoCli1'])   
  ACT(ab:1,fbn['RazonSocial'])
  ACD(FE:1, fbn('FechaOp'))
  let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ])
  ACT(aa:1,BuscarCampo('ESPECIES','Extendido'     ,'Codigo',Fbn['Especie']))
  ACT(aa:2,BuscarCampo('ESPECIES','Nombre'     ,'Codigo',Fbn['Especie']))
  ACT(cc:1,BuscarCampo('ESPECIES','Codigo'     ,'Codigo',Fbn['Especie']))
  ACT(ad:1, BuscarCampo('CLIENTES','CUIT','Codigo',Fbn['Vehiculo1']))
  ACT(ee:1, BuscarCampo('CLIENTES', 'RazonSocial','Codigo', BuscarCampo('CUENTAS','Comitente'   ,'Codigo',Fbn['Cuenta2'])))
  ACT(af:1,BuscarCampo('CUENTAS','Alias9'      ,'Codigo',Fbn['Cuenta1']))
  ACT(cu:99,BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta2'])) 
  ACT(ta:1,fbn['Telefono'])
  ***---ACT(tb:1,fbn['Fax'])
  ACT(TB:1, BuscarCampo('CLIENTES','Fax','Codigo',Fbn['Vehiculo1']))
  ACT(tc:1,fbn['Direccion'])
  ACT(td:1,fbn['CodigoPostal'])
  ACT(te:1,BuscarCampo('PAISES','Nombre','Codigo',fbn['PaisDir']))
  ACT(tf:1,BuscarCampo('PROVINCIAS','Nombre','Codigo',fbn['Provincia']))
Proximo
if EqStr(val(zz:98),var('MONEEXTR')) 
   ACT(cc:88,'u$s' ) 
   ACT(cc:66,'dolares' ) 
   else
   if EqStr(val(zz:98),var('MONELOCA'))    
      ACT(cc:88,'$' )
      ACT(cc:66,'pesos' ) 
      else     
      ACT(cc:88,val(zz:98) )
   endif  
endif

let &fecha_larga FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)
let &usuario_activo UsuarioActivo

let &referencia ''

let &pieahorro1 ''
let &pieahorro2 ''
let &pieahorro3 ''
let &pieahorro4 ''
let &pieahorro5 ''
let &pieahorro6 ''



If EqStr(val(cc:1),var('AHORROPL'))

   let &oracion1 'De nuestra consideracion:'

   let &oracion21 '         Por intermedio de la presente les solicitamos a ustedes SUSCRIBIR la cantidad de '~val(cc:88)~PYC(val(zb:99),0,2)
   let &oracion22 ' al fondo '~val(aa:2)~' clase B de la cuenta Nº '~val(cu:99)~' a nombre de '~val(ab:1)~' y el importe sera transferido desde el banco de Valores.'
   
   let &oracion3 '         Asimismo nos comprometemos a enviar el original de la presente nota a vuestras oficinas y a retirar los formularios de liquidación correspondientes dentro de las 24 horas habiles.'
   
   let &oracion4 'Dejamos constancia que hemos recibido conocemos y adherimos al Reglamento de Gestion del Fondo Comun de Inversion respectivo.'~Chr(13)~'Asimismo:'~Chr(13)~'             ·'

   let &pieahorro1 var('PIEAHORRO1')
   let &pieahorro2 var('PIEAHORRO2')
   let &pieahorro3 var('PIEAHORRO3')
   let &pieahorro4 var('PIEAHORRO4')
   
   let &oracion5 Chr(13)~'             ·'
   
   let &pieahorro5 var('PIEAHORRO5')
   let &pieahorro6 var('PIEAHORRO6')
   
   let &oracion6 'La firma esta verificada:'


Else
                   **otra carta**
   let &referencia 'Ref.: Suscripcion Fondos'
   
   let &oracion1 'De mi mayor consideracion:'
   
   let &oracion21 '         Por intermedio de la presente solicito a Uds. tengan a bien suscribir '~val(cc:66)
   let &oracion22 Minusculas2(letras(val(ac:99),0,100))~' ('~val(cc:88)~PYC(val(ac:99),0,0) ~'.-) a '~val(ab:1)~' cuenta cuotapartista Nº '~val(af:1)~' en el fondo '~val(aa:1)~'.'
   
   let &oracion3 'Los fondos provienen del '~val(ee:1)
   
   let &oracion4 ''
   let &oracion5 ''
   let &oracion6 ''
   
Endif

let &razon_social2 val(ab:1)
let &cuit 'CUIT: '~val(ad:1)  
let &telefono 'Tel: '~val(ta:1)
let &fax 'Fax: '~val(tb:1)
let &direccion val(tc:1)
let &datos_geograficos val(td:1)~'-'~val(tf:1)~'-'~val(te:1)

EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, razon_social = &razon_social, localidad = &localidad, fecha_larga = &fecha_larga, usuario_activo = &usuario_activo, nr_operacion = &nr_operacion, referencia = &referencia, oracion1 = &oracion1, oracion21 = &oracion21, oracion22 = &oracion22, oracion3 = &oracion3, oracion4 = &oracion4, oracion5 = &oracion5, oracion6 = &oracion6, pieahorro1 = &pieahorro1, pieahorro2 = &pieahorro2, pieahorro3 = &pieahorro3, pieahorro4 = &pieahorro4, pieahorro5 = &pieahorro5, pieahorro6 = &pieahorro6, razon_social2 = &razon_social2, cuit = &cuit, telefono = &telefono, fax = &fax, direccion = &direccion, datos_geograficos = &datos_geograficos)

