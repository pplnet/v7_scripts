mostrarcuadrodemensajes
creardialogo
fecha1:'FechaVto';;;;;;;;;FSys()
cliente1:'Cliente';;
vehiculo1:'Vehiculo';;;;;;;;;Var('VEHICULODE')
mercado1:'Mercado';;;;;;NoVacio(dialogo.mercado1) y Eqstr(BuscarCampo('MERCADOS', 'NETEA', 'Codigo', dialogo.mercado1), 'SI');'Si desea Seleccionar debe ingresar Mercado que Netea';NO;Var('MERNETEODE');;;;;" NETEA='SI' "
nroperacion1: 'Operacion';;;;;;;;;;;;;;" Convenio='1' and Mercado='"~dialogo.mercado1~"' "
check2:'Procesa';;;;NO;NO;;;;1
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check2 = 0)
HojaVisible(SI)
endif

sql.add("Select   O.TipoOp, O.NrOperacion, mp.Mercado, O.FechaOp, O.FechaVto, O.Cliente1, O.Precio1,")
sql.add(" MP.Especie, O.ContraEspecie, MP.Cantidad CantPend,o.cantidad cantot , O.TotalNetoCli1, C.RazonSocial, O.FechaAltaSisExterno, O.Convenio")
sql.add(" from  "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".MOVPENDIENTES MP")
sql.add(" where  O.Cliente1    = C.Codigo                  ")
sql.add("AND   O.NrOperacion    = mp.NrOperacion                  ")
sql.add(" AND    O.Convenio    = '1'                       ")
sql.add(" AND    MP.FechaMov="~IdxDate2(dialogo.fecha1))
if (NoVacio(dialogo.vehiculo1))
sql.add(" and    O.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
endif
if (NoVacio(dialogo.cliente1))
sql.add(" and    O.Cliente1 = '"~dialogo.cliente1~"'    ")
endif
sql.add(" and    O.TipoOp In ('TIC','TIV','TIFV','TIFC')   ")
sql.add(" and   O.Mercado = '"~dialogo.mercado1~"'         ")
sql.add("AND MP.NrComprob > '1000' ")
sql.add(" order by O.NrOperacion                           ")

Acn(z:1, 0)
recorrer sql
Message(Fbn('NrOperacion'))
Acn(a:fac, 0)
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('TipoOp'))
Act(d:fac, Fbn('Cliente1'))
Act(e:fac, Fbn('RazonSocial'))

Acd(f:fac, Fbn('FechaAltaSisExterno'))
Acd(m:fac, Fbn('FechaVto'))

Act(g:fac, Fbn('Especie'))

if (Eqstr(Fbn('Especie'), Fbn('ContraEspecie')))
Acn(h:fac, Fbn('TotalNetoCli1'))
else
Acn(h:fac, Fbn('cantot'))
end

Acn(i:fac, Fbn('Precio1'))
Act(j:fac, Fbn('ContraEspecie'))
Acn(k:fac, Fbn('TotalNetoCli1'))
Act(l:fac, Fbn('Mercado'))
Acd(o:fac, Fbn('FechaOp'))

Acn(p:fac, Fbn('CantPend'))
Acn(r:fac, sql(" Select   MP.Cantidad from  "~Dbo()~".MOVPENDIENTES MP where MP.NrOperacion = '"~Fbn('NrOperacion')~"' AND MP.Especie = '"~Fbn('Especie')~"' AND MP.NrComprob < '1000' "))
if (Val(p:fac) > 0)
Acn(q:fac, 1)
else
Acn(q:fac, -1)
Acn(p:fac, -Val(p:fac))
Acn(r:fac, -Val(r:fac))
endif

Acn(z:1, 1)
proximo


if (Val(z:1) = 0)
Cancelar()('No se encontraron operaciones diferidas con vencimiento el '~dialogo.fecha1)
endif

crearlistbox;'Arial,8,';'Diferimiento de Operaciones con Vencimiento '~dialogo.fecha1
'Mod.';a:1..a:fac;SI;;;50;check;RGB(160, 160, 193)
'NrOperacion';b:1..b:fac;NO;;;70;string;;RGB(250, 250, 193)
'TipoOp';c:1..c:fac;NO;;;50;string;;RGB(250, 250, 193)
'Cliente';d:1..d:fac;NO;;;50;string;;RGB(250, 250, 193)
'RazonSocial';e:1..e:fac;NO;;;140;string;;RGB(250, 250, 193)
'FechaOp';o:1..o:fac;NO;;;90;fecha;RGB(250, 250, 193)
'FechaVto Original';f:1..f:fac;NO;;;90;fecha;RGB(250, 250, 193)
'Especie';g:1..g:fac;NO;;;60;string;;RGB(250, 250, 193)
'Cantidad Total';h:1..h:fac;NO;;;90;numero;'##,###,###,###.##';RGB(250, 250, 193)
'Precio';i:1..i:fac;NO;;;60;numero;'##,###.#######';RGB(250, 250, 193)
'C.Especie';j:1..j:fac;NO;;;60;string;;RGB(250, 250, 193)
'Mercado';l:1..l:fac;NO;;;60;string;;RGB(250, 250, 193)
'F.Diferimiento';m:1..m:fac;NO;;;90;fecha;RGB(250, 250, 193)
'C.Pendiente';r:1..r:fac;NO;;;90;numero;'##,###,###,###.##';RGB(250, 250, 193)
'C.diferida';p:1..p:fac;NO;;;90;numero;'##,###,###,###.##';RGB(250, 250, 193)
finlistbox

if (not ok)
if (dialogo.check2 = 1)
Cancelar()('Anulación cancelada')
else
Messagebox('Anulación cancelada - No Procesa')
endif
endif

recorrer&i 1, Fac()
if (Val(a:&i) = 1)
if (Round(Val(r:&i), 2) = Round(0, 2))
if (dialogo.check2 = 1)
sql.add(" UPDATE "~Dbo()~".MOVPENDIENTES SET                  ")
sql.add(" FechaMov            = "~IdxDate2(Val(f:&i))~"   ,  ")
sql.add(" NrComprob = NULL                                   ")
sql.add(" WHERE NrOperacion   = '"~Val(b:&i)~"'             ")
sql.add(" AND         Especie ='"~Val(g:&i)~"'              ")
sql.new
sql.exec
endif
else
if (dialogo.check2 = 1)
sql.add(" UPDATE "~Dbo()~".MOVPENDIENTES SET                 ")
sql.add(" NrComprob = NULL             ,                      ")
sql.add(" Cantidad            = "~FStr(((Val(r:&i) + Val(p:&i)) * Val(q:&i)), 0, 2))
sql.add(" WHERE NrOperacion   = '"~Val(b:&i)~"'             ")
sql.add("   and Especie = '"~Val(g:&i)~"'             ")
sql.add("   and FechaMov= "~IdxDate2(Val(f:&i)))
sql.new

sql.add(" DELETE "~Dbo()~".MOVPENDIENTES                ")
sql.add(" WHERE NrOperacion   = '"~Val(b:&i)~"'             ")
sql.add("   and Especie = '"~Val(g:&i)~"'             ")
sql.add("   and FechaMov= "~IdxDate2(Val(m:&i)))
sql.new
sql.exec
endif
endif

Message('Reversando Operacion '~Val(b:&i))
if (sql("SELECT 1 FROM "~Dbo()~".MOVPENDIENTES WHERE NrOperacion='"~Val(b:&i)~"' and NrComprob>1000") = 1)
if (dialogo.check2 = 1)
Acd(y:&i, sql("SELECT Max(FechaMov) FROM "~Dbo()~".MOVPENDIENTES WHERE NrOperacion='"~Val(b:&i)~"' and NrComprob>1000"))
sql.add(" UPDATE "~Dbo()~".OPERACIONES SET   ")
sql.add(" FechaVto            = "~IdxDate2(Val(y:&i))~"  ")
sql.add(" WHERE NrOperacion   = '"~Val(b:&i)~"'          ")
sql.new
sql.exec
endif
else
if (dialogo.check2 = 1)
sql.add(" UPDATE "~Dbo()~".OPERACIONES SET   ")
sql.add(" FechaAltaSisExterno = Null, ")
sql.add(" Convenio            = '0',                     ")
sql.add(" FechaVto            = "~IdxDate2(Val(f:&i))~"  ")
sql.add(" WHERE NrOperacion   = '"~Val(b:&i)~"'          ")
sql.new
sql.exec
endif
endif
if (sql(" Select 1 From "~Dbo()~".CUOTAS Where NrOperacion = '"~Val(b:&i)~"' AND Check1 = '1' AND Fecha1 = '"~IdxDate(Val(f:&i))~"' AND Fecha2 = '"~IdxDate(FSys())~"' ") = 1)
if (dialogo.check2 = 1)
sql.add(" Delete "~Dbo()~".CUOTAS ")
sql.add(" Where NrOperacion = '"~Val(b:&i)~"' ")
sql.add(" AND Fecha1 = '"~IdxDate(Val(f:&i))~"' ")
sql.add(" AND Fecha2 = '"~IdxDate(FSys())~"' ")
sql.add(" AND Check1 = '1' ")
sql.new
sql.exec
endif
else
Acn(nc:1, sql(" Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Val(b:&i)~"' ") + 1)
if (dialogo.check2 = 1)
sql.add(" Insert Into "~Dbo()~".CUOTAS ")
sql.add(" (NrOperacion, NrCuota, Check1, ")
sql.add(" Fecha1, Fecha2, Cliente1, Fecha3) ")
sql.add(" Values ")
sql.add(" ('"~Val(b:&i)~"', "~FStr(Val(nc:1), 0, 0)~", '0', ")
sql.add(" '"~IdxDate(Val(f:&i))~"', '"~IdxDate(FSys())~"', 'DAC', '"~IdxDate(Val(f:&i))~"') ")
sql.new
sql.exec
endif
endif
if (dialogo.check2 = 1)
sql.actualizarmovimientos3(Val(b:&i), NO, NO, NO, SI, NO)
sql.exec
endif
endif
proximo
if (dialogo.check2 = 1)
Messagebox('Los datos se actualizaron con éxito')
endif

