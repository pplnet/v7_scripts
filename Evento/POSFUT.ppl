* POSFUT
* Transforma Posiciones Futuras a Ctdo.
*CrearDialogo
*  Fecha1       : 'Fecha'               ;1;1;;;;Dialogo.Fecha1<=Fsys;'La Fecha de Transformacion de Posicion debe ser Inferior a la Fecha del Sistema';NO;Fsys;
*FinDialogo

*if Not Ok
*  Cancelar
*endif

Message('*-- Inserto las Posciones Contado ')

SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
SQL.ADD("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
SQL.ADD("Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
SQL.ADD(" SELECT FechaEj As FechaMov,Cliente,Vehiculo,")
SQL.ADD(" NrSaldo=(NrSaldo-100) ,Especie,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
SQL.ADD(" FROM "~DBO~".MOVPOSEJE Where NrSaldo>=200 and NrSaldo<=300 and ")
SQL.ADD(" FechaEj<='"~IdxDate(Fsys)~"' ")
SQL.NEW
SQL.EXEC

Message('*-- Reverso Posciones Futuraso ')
SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
SQL.ADD("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
SQL.ADD("FechaEj,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
SQL.ADD(" SELECT FechaMov,Cliente,Vehiculo,")
SQL.ADD(" NrSaldo,Especie,FechaEj,-Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
SQL.ADD(" FROM "~DBO~".MOVPOSEJE Where NrSaldo>=200 and NrSaldo<=300 and ")
SQL.ADD(" FechaEj<='"~IdxDate(Fsys)~"' ")
SQL.NEW
SQL.EXEC

