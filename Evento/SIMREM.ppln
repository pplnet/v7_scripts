HojaVisible(SI)
creardialogo
fecha1:'Fecha';;;;NO;;dialogo.fecha1 > 0 y dialogo.fecha1 <= FSys();'Fecha Inválida';NO;FSys();
check1:'Reporte';;;;NO;NO;;;;1;
findialogo

if (not ok)
Cancelar()
endif


CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

agregarbmp(a1, Exe('LOGO'))
SetFilaActual(Fac() + 5)
Acn(w1, Fac())

if (dialogo.check1 = 1)
Act(a:fac, 'Operaciones en instancias intermedias')
else
Act(a:fac, 'Simulacion de cierre de las operaciones en instancias intermedias')
endif
SetFont(a:fac..a:fac, 3)
Act(a:fac + 1, 'Fecha: '~dialogo.fecha1)
SetFont(a:fac..a:fac, 2)
SetFilaActual(Fac() + 3)
Act(a:fac, 'NrOperacion')
Act(b:fac, 'TipoOp')
Act(c:fac, 'Cantidad')
Act(d:fac, 'Especie')
Act(e:fac, 'Tasa')
Act(f:fac, 'Sector')
Act(g:fac, 'Instancia')

AgregarMarco(a:fac..g:fac, 1, 0, Exe('COLOR6'))
SetFont(a:fac..g:fac, 2)

if (Num(Query("SELECT count(1) FROM "~Dbo()~".OPERACIONESBITS B INNER JOIN "~Dbo()~".OPERACIONES O ON O.NrOperacion = B.NrOperacion WHERE B.NrBit IN ("~Var('INTERCREM')~") AND B.Valor = '1' AND TipoOp ='MMCREM'")) > 0)
Sqladd("SELECT O.NrOperacion, O.TipoOp,O.Cantidad, O.Especie, O.Precio1, O.Sector1, B.NrBit, I.Nombre FROM "~Dbo()~".OPERACIONESBITS B ")
Sqladd("INNER JOIN "~Dbo()~".OPERACIONES O ON O.NrOperacion = B.NrOperacion ")
Sqladd("INNER JOIN "~Dbo()~".INSTANCIAS I ON B.NrBit = I.NrInstancia ")
Sqladd("WHERE B.NrBit IN ("~Var('INTERCREM')~") AND B.Valor = '1' AND O.TipoOp ='MMCREM' AND I.Tabla = 'OPERACIONES'")
Sqladd(" ORDER BY O.NrOperacion ")

let(&cuentasrem, 0)
recorrer sql
let(&cuentasrem, &cuentasrem + 1)

Act(a:fac, Fbn('NrOperacion'))
Aclo(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Fbn('TipoOp'))
Acn(c:fac, Fbn('Cantidad'))
Act(d:fac, Fbn('Especie'))
Acn(e:fac, Fbn('Precio1'))
Act(f:fac, Fbn('Sector1'))
Act(g:fac, Fbn('NrBit')~' - '~Fbn('Nombre'))
proximo
endif
SetFilaActual(Fac() + 2)
FormatoCeldas(e:Val(w1) + 1..e:fac, Exe('F7'))



Act(a:fac, 'Fin del Informe.')
SetFont(a:fac..a:fac, 2)
LimitesVision(g:fac)

ACO(1, 10)
ACO(2, 10)
ACO(3, 12)
ACO(4, 6)
ACO(5, 9)
ACO(6, 13)
ACO(7, 20)

