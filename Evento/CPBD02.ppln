MostrarCuadroDeMensajes()

Act(vh:1, SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

creardialogo
fecha1:'D.FechaAcr.';1;1;;;;dialogo.fecha1 <= FSys();'Fecha Incorrecta';NO;Habiles(FSys(), -2, 'ARG')
fecha2:'H.FechaAcr.';1;2;;;;dialogo.fecha2 <= FSys();'Fecha Incorrecta';NO;FSys()
check1:'Fecha';2;1;;;;;;;0
check3:'Importe';3;1;;;;;;;1
cantidad1: 'Tolerancia';3;2;;;dialogo.check3 = 0;;;;1
check2:'NrComprob';4;1;;;;;;;0
lista1: 'Vehiculos';5;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), Val(vh: 1))
lista2: 'CtasMadres';;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Codigo IN (SELECT CtaPrincipal FROM "~Dbo()~".CUENTAS)  "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~")"))~" ");
lista3: 'CtasPag/Rec/Int';0;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE (Pagadora='SI' OR TipoCuenta IN ('REC','INT') ) "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~")"))~" "~iif (NoVacio(dialogo.lista2), " AND CtaPrincipal IN ("~Pipe2Comillas(dialogo.lista2)~")", " AND (CtaPrincipal IS NOT NULL OR CtaPrincipal<>'')")~" ");
check4:'Confirma';1;2;;NO;NO;;;;0
findialogo

if (not ok)
Cancelar()
endif

Ejecutarevento('CPBD01', 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha2, 'check1', dialogo.check1, 'check3', dialogo.check3, 'cantidad1', dialogo.cantidad1, 'check2', dialogo.check2, 'lista1', dialogo.lista1, 'lista2', dialogo.lista2, 'lista3', dialogo.lista3, 'check4', 0)
