creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'TCPCEM';;;;;;;;;;;;;;"TipoOp in ('TCPCEM')"
lista1: 'Mercados';;;;NO;;;;;;'MAE|BYMA';SQLSet("SELECT Codigo FROM "~Dbo()~".MERCADOS  ORDER BY Codigo ");SI
findialogo

if (not ok)
Cancelar()
endif

Acn(y:1, 1)
if (Val(y:1) = 0)
HojaVisible(SI)
endif

Sqladd(" Select O.NrOperacion, ")
Sqladd("  ISNULL((Select top(1) 'SI' from dbo.ORDENES  where NrOperacion1=O.NrOperacion and NrOperacion2 <> ''),'NO') NrTCOPRI, ")
Sqladd("  (Select Count(*)  from "~Dbo()~".ORDENES  where NrOperacion1=O.NrOperacion ) Ordenes, ")
Sqladd("  ISNULL((Select Top (1) 'SI'  from "~Dbo()~".ORDENES  where NrOperacion1=O.NrOperacion and  Cliente <> '"~Var('VEHICULODE')~"'),'NO') Terceros ")
Sqladd("   From "~Dbo()~".OPERACIONES O ")
Sqladd(" Where  O.TipoOp        = 'TCPCEM'                          ")
Sqladd("   and  O.RB8 = '0' ")
Sqladd("    and    O.FechaPago  = "~IdxDate2(dialogo.fecha1)~"      ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("AND  O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.lista1))
Sqladd("AND  O.Mercado4 In ("~Pipe2Comillas(dialogo.lista1)~") ")
endif

Watch(Sqlbatch())
Acn(co:1, 0)
Acn(co:2, 0)


recorrer sql

if (Fbn('Ordenes') = 0)
Acn(co:1, 1)
Acn(co:2, 2)
else
if (Eqstr(Fbn('NrTcopri'), 'SI'))
Acn(co:1, 2)
if (Eqstr(Fbn('Terceros'), 'SI'))
Acn(co:2, 1)
else
Acn(co:2, 2)
endif
else
Acn(co:1, 2)
Acn(co:2, 2)
endif
endif

if (Val(y:1) = 1)
Sqladd(" Update "~Dbo()~".OPERACIONES   ")
if (Val(co:1) = 2)
Sqladd(" Set RB8 = '1'            ")
else
Sqladd(" Set RB8 = '2'            ")
endif

Sqladd(" Where NrOperacion = '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()

Acn( in :1, Query("select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~Fbn()['NrOperacion']~"' and Valor = '1' "))

if (Val(co:2) = 1)
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOperacion'], 'radio1', 0, 'radio2', 2, 'entero1', Val( in :1), 'entero2', 10)
else
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOperacion'], 'radio1', 0, 'radio2', 2, 'entero1', Val( in :1), 'entero2', 70)
endif

endif

proximo








if (NO)
Sqladd(" Select O.NrOperacion, OD.NrOperacion1, OD.NrOperacion2  NrTCOPRI ")
Sqladd("   From "~Dbo()~".OPERACIONES O ")
Sqladd("         left outer join "~Dbo()~".ORDENES OD on O.NrOperacion = OD.NrOperacion1 ")
Sqladd(" Where  O.TipoOp        = 'TCPCEM'                          ")
Sqladd("   and  O.RB8 = '0' ")

Sqladd("    and    O.FechaPago  = "~IdxDate2(dialogo.fecha1)~"      ")

if (NoVacio(dialogo.nroperacion1))
Sqladd("AND  O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
if (NoVacio(dialogo.lista1))
Sqladd("AND  O.Mercado4 In ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Sqladd(" Group by O.NrOperacion , OD.NrOperacion1 , OD.NrOperacion2 ")
Watch(Sqlbatch())
Acn(co:1, 0)
Acn(co:10, 0)
Act(co:2, '')
Acn(co:3, 0)
Act(co:4, '')

recorrer sql
