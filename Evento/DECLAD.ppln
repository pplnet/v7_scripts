Act(co:2, Fbn()['NrOperacion'])
Acn(co:3, 1)
endif

if (Eqstr(Val(co:2), Fbn()['NrOperacion']))
Acn(co:20, Query(" SELECT Count(*) Desierta FROM   "~Dbo()~".ORDENES  WHERE NrOperacion1  ='"~Fbn()['NrOperacion']~"' "))
if (Vacio(Fbn('NrTcopri')))
Acn(co:1, 2)
else
if (Val(co:20) > 0)
Acn(co:1, 2)
else
Acn(co:1, 1)
endif
endif
if (Vacio(Fbn('NrTcopri')))
Acn(co:10, 2)
else
Acn(co:20, Query(" SELECT Count(*) Cerrada FROM   "~Dbo()~".ORDENES  WHERE NrOperacion1  ='"~Fbn()['NrOperacion']~"' and  Cliente <> '"~Var('VEHICULODE')~"' "))
if (Val(co:20) > 0)
Acn(co:10, 1)
else
Acn(co:10, 2)
endif
endif
else
if (Val(y:1) = 1)
Sqladd(" Update "~Dbo()~".OPERACIONES   ")
if (Val(co:1) = 2)
Sqladd(" Set RB8 = '1'            ")
else
Sqladd(" Set RB8 = '2'            ")
endif

Sqladd(" Where NrOperacion = '"~Val(co:2)~"' ")
Sqlnew()
Sqlexec()
endif

