*EXPORTACIONES A PDF Y EXCEL
CrearFont(1, "Tahoma,20,b")
CrearFont(2, "Arial,16,i")
HOJAVISIBLE(SI)
ACT(A1,"TITULO")
setfilaactual(2)
recorrer &i 1, 20
acn(a:fac,&i)
ifa
proximo

SetFont(a6..a10,1)
SetFont(a11..a15,2)
AGREGARMARCO(A6..A15,1,1,"RED")

ExportarXLS(a1..a4,c1..c4,"C:/USERS/CLOMAS/DESKTOP/INFORME-SIN-F.XLS",NO)
ExportarXLS(a6..a15,d6..d15,"C:/USERS/CLOMAS/DESKTOP/INFORME-CON-F.XLS",SI)
ImprimirHoja(NO)
*ExportarXLS(RangoOrigen, RangoDestino, Path, IncluyeFormatos)