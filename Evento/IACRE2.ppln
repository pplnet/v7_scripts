creardialogo
directorio1:'Ruta';1;1;;;;;;;Var('PATHACREM')
string2:'Archivo';2;1;;;;;;;Var('ACREM')
findialogo

if (not ok)
Cancelar()
endif

if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
Act(x:1, dialogo.directorio1~dialogo.string2)
else
Act(x:1, dialogo.directorio1~'\'~dialogo.string2)
endif

importarxls(a:2..h:1000, aa:2..ah:1000, Val(x:1))

if (not ok)
Cancelar()('Error al cargar el archivo '~Val(x:1))
endif

recorrer&i 2, Num(Var('IACREBUCLE'))
if (Vacio(Val(aa:&i)))
break
endif

sql.add("Select Codigo, Cliente, Especies, Comitente")
sql.add("FROM "~Dbo()~".CUENTAS")
sql.add("WHERE Numero = '"~FStr(Val(aa:&i), 0, 0)~"' ")
recorrer sql
Act(co:1, Fbn()['Codigo'])
Act(vh:1, Fbn()['Cliente'])
Act(es:1, Fbn()['Especies'])
Act(es:2, Copy(Val(es:1), 1, Longitud(Val(es:1)) - 1))
Act(cl:1, Fbn()['Comitente'])
proximo
Acn(nu:1, BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Val(vh:1)))
Act(nr:1, getnumerador(Val(nu:1)))
if (Val(af:&i) = 360)
Acn(rb:8, 0)
else
Acn(rb:8, 1)
endif
Acn(pr:1, Val(ae:&i))
Acn(pl:1, Fecha(Val(ac:&i)) - Fecha(Val(ab:&i)))
Act(pe:1, BuscarCampo('USUARIOS', 'Perfiles', 'Codigo', UsuarioActivo()))
Acn(cd:1, Val(ah:&i))
sql.add("INSERT INTO "~Dbo()~".OPERACIONES ( ")
sql.add("   TipoOp,          NrOperacion,    FechaOp,         FechaOp2,      FechaVto, ")
sql.add("   Plazo,           Vehiculo1,      Especie,         Cliente1,      Operador, ")
sql.add("   TipoTasa,        FechaPago,      Precio1,         RB8,           TablaFeriados1, ")
sql.add("   Cuenta1,         Book1,          Sector2,         MB3,           UsrInput, ")
sql.add("   FechaCarga,      FechaCargaSys,  Cantidad ")
sql.add("   ) VALUES (")
sql.add("   'MMRPAC'                 , '"~Val(nr:1)~"'           , '"~IdxDate(Val(ab:&i))~"' , '"~IdxDate(Val(ab:&i))~"' , '"~IdxDate(Val(ac:&i))~"', ")
sql.add("   "~FStr(Val(pl:1), 0, 0)~"  , '"~Val(vh:1)~"'           , '"~Val(es:2)~"'           , '"~Val(cl:1)~"'         , '"~UsuarioActivo()~"', ")
sql.add("   'FIJA'                   , '"~IdxDate(Val(ad:&i))~"' , "~FStr(Val(pr:1), 0, 2)~"   , "~FStr(Val(rb:8), 0, 0)~" , 'ARG', ")
sql.add("   '"~Val(co:1)~"'          , '"~Val(ag:&i)~"'          , '"~Val(pe:1)~"'           , '1'                     , '"~UsuarioActivo()~"', ")
sql.add("   "~SQLAhora()~"             , '"~IdxDate(FSys())~"'       , "~FStr(Val(ah:1), 0, 2)~"  ")
sql.add("   )")
Watch(sql.batch)
sql.new
sql.exec
ejecutarevento('INSBIT', string1 = 'OPERACIONES', entero1 = 1, nroperacion1 = Val(nr:1))
proximo

Messagebox('Evento Importacion Acuerdos Remuneradas Finalizado Correctamente.')



