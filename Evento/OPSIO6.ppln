Act(x2, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Act(l12, dialogo.nroperacion1)
Sqladd(" Delete from "~Dbo()~".EXCEPCIONES where NrOperacion='"~Val(l12)~"' ")
Sqlnew()
Sqlexec()

Sqladd(" Select O.* from "~Dbo()~".OPSIOPEL O where ")
Sqladd(" O.NrOperacion= '"~Val(l12)~"'            ")
recorrer sql
Act(l8, Fbn()['NrOperacion'])
Act(l7, Fbn()['CodigoTitulo'])
Act(c13, Val(l7))

Act(c21, Fbn()['CodigoRegistro'])
if (Eqstr(Val(c21), '0105'))
Act(l13, Fbn()['AgenteContra'])
Sqladd("Select Codigo,Status from "~Dbo()~".CLIENTES where NrMAE='"~Val(l13)~"' ")
recorrer sql
Act(l1, Fbn()['Codigo'])
Act(l28, Fbn()['Status'])
if (Eqstr(Val(l28), 'DES'))
Sqladd(" Insert Into "~Dbo()~".EXCEPCIONES ")
Sqladd(" (NrOperacion, Tipo, Fecha, Descripcion) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Cliente no HABILITADO en FPA') ")
Sqlnew()
Sqlexec()
endif
break
proximo
else
Act(l13, Fbn()['Agente'])
Sqladd("Select Codigo,Status from "~Dbo()~".CLIENTES where NrMAE='"~Val(l13)~"' ")
recorrer sql
Act(l1, Fbn()['Codigo'])
