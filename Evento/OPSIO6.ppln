endif

Act(c2, Query(" Select EspecieDestino1 From "~Dbo()~".EQUIVALENCIA_ESPECIES Where TipoCotizacion='O' AND TipoNegociacion='"~Fbn('CodigoNego')~"' AND EspecieOrigen='"~Val(c13)~"' "))
if (Vacio(Val(c2)))
