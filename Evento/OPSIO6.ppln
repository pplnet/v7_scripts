if (Eqstr(Val(l28), 'DES'))
Sqladd(" Insert Into "~Dbo()~".EXCEPCIONES ")
Sqladd(" (NrOperacion, Tipo, Fecha, Descripcion) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Cliente no HABILITADO en FPA') ")
