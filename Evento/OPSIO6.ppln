if ((Eqstr(Val(l1), 'SIOPEL') o (not Eqstr(Val(l1), 'SIOPEL') y Eqstr(Val(l28), 'DES'))) o Eqstr(Val(c2), 'xxx') o Eqstr(Val(c3), 'yyy') o (Eqstr(Val(c6), '') o Vacio(Val(c6))) o (Eqstr(Val(c8), '') o Vacio(Val(c8))))
