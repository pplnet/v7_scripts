creardialogo
fecha1:"Fecha";;;;;;;;;FSys()
especie1:"Especie";;;;;;NoVacio(dialogo.especie1);'DEBE INGRESAR UNA ESPECIE';NO;
radio1:"Tipo|Contado|O.Compra|O.Venta|Futuro";;;;;;;;;0
fecha2:"FechaEj";;;;(dialogo.radio1 = 1 o dialogo.radio1 = 2);(dialogo.radio1 = 1 o dialogo.radio1 = 2);;;;
precio2:"PrecioEj";;;;(dialogo.radio1 = 1 o dialogo.radio1 = 2);(dialogo.radio1 = 1 o dialogo.radio1 = 2);;;;
precio3:"Precio";;;;NO;;dialogo.precio3 > 0;'La Cotizacion No Existe !!';NO;;sql("Select Precio1 FROM "~Dbo()~".COTIZACIONES where Fecha='"~IdxDate(dialogo.fecha1)~"' and Codigo='"~dialogo.especie1~"' and CallPut In "~iif (dialogo.radio1 = 1, "('CAL')", iif (dialogo.radio1 = 2, "('PUT')", iif (dialogo.radio1 = 3, "('FUT')", "('CON','')")))~" "~iif (dialogo.radio1 = 1 o dialogo.radio1 = 2, " and FechaEj ='"~IdxDate(dialogo.fecha2)~"' and PrecioEj="~FStr(dialogo.precio2, 0, 9)~" ", " ")~" ")
precio1:"Pr.Cierre";;;;;;dialogo.precio1 > 0;'DEBE INGRESAR El Precio';NO;;;;;"###,###.#########"
findialogo

if (not ok)
Cancelar()
endif

Act(z1, " CallPut In ('CON','') ")

if (dialogo.radio1 = 1)
Act(z1, " CallPut In ('CAL') ")
endif
if (dialogo.radio1 = 2)
Act(z1, " CallPut In ('PUT') ")
endif
if (dialogo.radio1 = 3)
Act(z1, " CallPut In ('FUT') ")
endif

Message('Actualizando Cotizaciones ....')

sql.add("Update "~Dbo()~".COTIZACIONES ")
sql.add("Set")
sql.add("Precio1="~FStr(dialogo.precio1, 0, 9)~" ")
sql.add("where Fecha='"~IdxDate(dialogo.fecha1)~"' ")
sql.add("      and Codigo = '"~dialogo.especie1~"' and "~Val(z1)~" ")

if (dialogo.radio1 = 1 o dialogo.radio1 = 2)
sql.add("   and FechaEj ='"~IdxDate(dialogo.fecha2)~"' ")
sql.add("   and PrecioEj="~FStr(dialogo.precio2, 0, 9)~" ")
endif

sql.new
sql.exec

