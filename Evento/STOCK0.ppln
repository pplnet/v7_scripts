Sqladd("SELECT 0 Tipo, S.Cliente, S.Especie, S.Cupon, S.Mercado, S.Cuenta, S.FechaEj, ")
Sqladd("       S.NrSaldo, S.Saldo, C.RazonSocial, S.CallPut, S.PrecioEj, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
Sqladd("  from "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE S.Cliente      = C.Codigo  ")
Sqladd("   AND C.Status       = 'HAB' ")
Sqladd("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:2))~") ")
Sqladd("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
Sqladd("   AND S.Especie      = '"~Val(es:1)~"' ")
Sqladd("   and S.EnteCustodia = '"~Val(vh:1)~"' ")
Sqladd("   and S.Cuenta       = CU.Codigo ")
Sqladd("   and CU.Comitente   = '"~Val(vh:1)~"' ")
