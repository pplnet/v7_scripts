Sqladd("SELECT M.Cliente, M.Especie, M.Cupon, M.Mercado, M.Cuenta, M.FechaEj, ")
Sqladd("       M.NrSaldo, SUM(M.Cantidad) Cantidad, C.RazonSocial, M.CallPut, M.PrecioEj, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337 ")
Sqladd("  FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONES O, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE M.Cliente      = C.Codigo ")
Sqladd("   and C.Status       = 'HAB' ")
Sqladd("   AND M.NrSaldo      = 1 ")
Sqladd("   AND M.Especie      = '"~Val(es:1)~"' ")
Sqladd("   AND M.NrOperacion  = O.NrOperacion ")
Sqladd("   AND M.EnteCustodia = '"~Val(vh:1)~"' ")
Sqladd("   and M.Cuenta       = CU.Codigo ")
Sqladd("   and CU.Comitente   = '"~Val(vh:1)~"' ")
if (not celdavacia(mr:1))
