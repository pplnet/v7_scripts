Sqladd("                    where (S1.Mercado = S.Mercado or (S1.Mercado IS NULL and S.Mercado IS NULL)) ")
Sqladd("                     and  (S1.Cuenta  = S.Cuenta  or (S1.Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
Sqladd("                     and  (S1.Cupon   = S.Cupon   or (S1.Cupon   IS NULL and S.Cupon   IS NULL)) ")
