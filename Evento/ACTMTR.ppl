CrearDialogo
  Vehiculo1    : "Vehiculo"     ;;;;;;;;;
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  NrTrans1     : "Nr.Trans"
  TipoTr1      : "Tipo Trans"      ;;;
  Especie1     : "Especie"      ;;;
  Radio2       : 'Tipo|Movimientos|Posiciones|Limites' ;;;;;;;;;0;;
FinDialogo


if Not Ok
  Cancelar
endif

if NoVacio(Dialogo.NrTrans1)
  ACT(X1, " NrTrans = '"~Dialogo.NrTrans1~"'")
else
  IF NOVACIO(Dialogo.TipoTr1)
     ACT(X1, " TipoTr2 = '"~Dialogo.TipoTr1~"' ")
  Else
     ACT(X1, "Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
     if NoVacio(Dialogo.Vehiculo1)
        ACT(x1, Val(X1)~" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
     endif
  EndIf
Endif

if NoVacio(Dialogo.Especie1)
   ACT(X1, Val(X1)~" and Especie = '"~Dialogo.Especie1~"' ")
EndIf

MostrarCuadroDeMensajes

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2  Where "~VAL(X1)~" Order By TipoTr2,NrTrans ")

Recorrer SQL    

     Message(FBN['TipoTr2']~' '~FBN['NrTrans'])

     If Dialogo.Radio2=0 
        SQL.ActualizarMovimientosT2(FBN['NrTrans'],SI,NO,NO,NO)
     EndIf

     If Dialogo.Radio2=1 
        SQL.ActualizarMovimientosT2(FBN['NrTrans'],NO,NO,NO,SI)
     EndIf
     If Dialogo.Radio2=2
        SQL.ActualizarMovimientosT2(FBN['NrTrans'],NO,SI,NO,NO)
     ENDIF
     SQL.EXEC
proximo

