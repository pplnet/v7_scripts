sql.add(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
sql.add(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, '' Cliente1, V.Codigo Vehiculo1, ")
sql.add(" "~FStr(Abs(Val(ct:1)), 0, 0)~" Cantidad, E.Alias8, V.Alias4, E.Issuer ")
sql.add(" From "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
sql.add(" Where E.Codigo = '"~Val(a:fac)~"' ")
sql.add(" AND V.Codigo = '"~Val(f:fac)~"' ")
