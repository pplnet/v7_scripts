*-- CEPRES : Cesion de Prestamos Local/Off Shore MV.
*-- HOJAVISIBLE(SI)
*-- NrOperacion2 de la Operacion guarda el nro. de operacion originalmente cedida, o sea su padre
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;;;;" TipoOp In ('MMPOSM','MMPCLM') ";;
  Vehiculo1    : "Vehiculo"                 ;;;;NO;;;;;;BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1);;;;
  Radio3       : 'Fondeo|Local|Extranjero'  ;;;;NO;EqStr(Dialogo.TipoOp1,'MMPCLM');;;;;BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1);;;;
  Radio5       : 'Fondeo|BLocalFExt|BcoExt' ;;;;NO;EqStr(Dialogo.TipoOp1,'MMPOSM');;;;;BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1);;;;
  Cliente4     : "Colocador"                ;;;;NO;;NOT EQSTR(Dialogo.Cliente1, Dialogo.Cliente4);'Los Participantes no pueden ser iguales';NO;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Moneda"                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha1       : "Vto V_Nominal"            ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1)
  Cantidad1    : "VNA"                      ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1);;;"###,###,###,###.##"
  TipoOp1      : 'TipoOp'                   ;;;;NO;NO;Incluido(Dialogo.TipoOp1,'MMPOSM|MMPCLM');'Ingrese Una Operacion del Tipo MMPOSM o MMPCLM';NO;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cliente1     : "Tomador"                  ;2;2;;;;[[EqStr(Dialogo.TipoOp1,'MMPCLM') y [Dialogo.Radio4=0 y Dialogo.Radio3<=1 y DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS')] o [DESCIENDEDECLIENTE(Dialogo.Cliente1,'EMPRESAS') y Dialogo.Radio3=0 Y Dialogo.Radio4=0]] o [EqStr(Dialogo.TipoOp1,'MMPOSM') y Dialogo.Radio4=1]] y DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS');'Entidad Invalida => FONDEO LOCAL: Entidad o Banco Local, FONDEO EXTR: Banco Local Op.Off Shore: Banco Extranjero';NO;;
  Cantidad2    : "Valor Nominal"              ;;;;;;Dialogo.Cantidad2 >0 y Dialogo.Cantidad2<=Dialogo.Cantidad1;'El Valor Nominal de la Nueva Operacion debe ser Inferior al Valor Nominal del Original';NO; ; ;;;"###,###,###,###.##"
  Radio1       : "Ya Participa?|No|Si"        ;;;;NO;;;;;;IIF(NOVACIO(Dialogo.NrOperacion3),1,0)
  Radio2       : "Acumula a Existente?|No|Si" ;;;;;Dialogo.Radio1=1;;;;IIF(Dialogo.Radio1=1,1,0);IIF(Dialogo.Radio1=1,1,0)
  Fecha3       : "Concertacion"             ;;;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio1<>0 o Dialogo.Fecha3<=Dialogo.Fecha4;'Fecha de Concertacion Incorrecta';NO;Fsys
  Fecha4       : "F.Cesion"                 ;;;;Dialogo.Radio2=0;Dialogo.Radio2=0;ESHABIL(Dialogo.Fecha4,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1));'Fecha de Origen Incorrecta';NO;FSYS;
  Precio4      : 'Tasa WH'                  ;8;;;Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPOSM');Dialogo.Radio2=0 y EqStr(Dialogo.TipoOp1,'MMPOSM');Not EqStr(Dialogo.TipoOp1,'MMPOSM') o [EqStr(Dialogo.TipoOp1,'MMPOSM') y Incluido(Fstr(Dialogo.Precio4,2,4),VAR('TASAWH'))];'El Valor de Tasa WH es Invalido: '~Fstr(Dialogo.Precio4,2,4)~' '~VAR('TASAWH')~' ...';NO;;;;;"###.####"
  Precio5      : 'Tasa IVA'                 ;;;;Dialogo.Radio2=0 ;Dialogo.Radio2=0 ;[Not Dialogo.Radio2=0] o Incluido(Fstr(Dialogo.Precio5,2,2),VAR('IVA'));'El Valor de Tasa IVA es Invalido: '~Fstr(Dialogo.Precio5,2,2)~' '~VAR('IVA')~' ...';NO;;;;;"###.####"
  Precio6      : 'Tasa ImpInt'              ;;;;Dialogo.Radio2=0 y Not [EqStr(Dialogo.TipoOp1,'MMPOSM') Y Dialogo.Radio5=1];Dialogo.Radio2=0 y Not [EqStr(Dialogo.TipoOp1,'MMPOSM') Y Dialogo.Radio5=1];[Not [EqStr(Dialogo.TipoOp1,'MMPOSM') Y Dialogo.Radio5=1] y Incluido(Fstr(Dialogo.Precio6,2,4),VAR('TASAINT'))] o [EqStr(Dialogo.TipoOp1,'MMPOSM') Y Dialogo.Radio5=1];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;;;;;"###.####"
  NrOperacion3 : "Op.Participa"             ;;;;NO;;;;;;SQL("Select NrOperacion from "~DBO~".OPERACIONES where NrOperacion2='"~Dialogo.NrOperacion1~"' and Cliente1='"~Dialogo.Cliente1~"' and TipoOp='"~Dialogo.TipoOp1~"' ")
  Radio4       : 'Pmo.|Local|Extranjero'    ;2;2;;NO;NO;;;;;IIF(EQSTR(BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Vehiculo1),BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
FinDialogo


If Not Ok
   Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
(.'CONTROLVH'.)


* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
Else
   If Dialogo.Radio2=1 
      * Verifico que se encuentre en Back Office o Terminal
      ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion3~"' AND Valor='1'") )

      If VAL(X1)<>20 y VAL(X1)<>50
         *-- Busco la instancia actual
         Cancelar('La Operacion Participante '~Dialogo.NrOperacion3~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
      EndIf
   EndIf
EndIf

* Si el Cliente ya participa Verifico las instancias de la Operacion  Participante
If Ok
   acn (j1,0)

   If NoVacio(Dialogo.NrOperacion3) y Dialogo.Radio2=1
      *-- SI NO EXISTE LA TOMADORA GENERA NUEVA OPERACION
      SQL.ADD("Select 1 from "~DBO~".OPERACIONES ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
      Recorrer SQL
         acn (j1,1)
      Proximo  
   EndIf
   
   If val(j1)=0
      SetFilaActual(0)

      *- Pido el ingreso de las tasas de interes para calculo de iva y wh de la nueva operacion
      SQL.ADD(" SELECT NrCuota,Tasa1 PorAmor,Cantidad1 Amort,Precio2 as Tasa,Precio4 as Spread, ")
      SQL.ADD(" Tasa2 as TasaIntIva, Total6 as TasaIntWH ")
      SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
      Recorrer SQL
           acn(aa:fac,FBN['NrCuota'] )
           acn(ab:fac,FBN['PorAmor'] )
           acn(ac:fac,FBN['Amort']   )
           acn(ad:fac,FBN['Tasa']    )
           acn(ae:fac,FBN['Spread']  )
           acn(af:fac,FBN['TasaIntIva']  )
           acn(ag:fac,FBN['TasaIntWH']  )
      Proximo

      ACT(ba1,Dialogo.NrOperacion1)
      ACT(ba2,Dialogo.Cliente4)
      ACN(ba3,Dialogo.Radio3)
      ACN(ba4,Dialogo.Radio5)
      ACT(ba5,Dialogo.Especie1)
      ACD(ba6,Dialogo.Fecha1)
      ACN(ba7,Dialogo.Cantidad1)
      ACT(ba8,Dialogo.TipoOp1)
      ACT(ba9,Dialogo.Cliente1)
      ACN(ba10,Dialogo.Cantidad2)
      ACN(ba11,Dialogo.Radio1)
      ACD(ba12,Dialogo.Fecha3)
      ACD(ba13,Dialogo.Fecha4)
      ACN(ba14,Dialogo.Precio4)
      ACN(ba15,Dialogo.Precio5)
      ACN(ba16,Dialogo.Precio6)
      ACT(ba17,Dialogo.NrOperacion3)
      ACN(ba18,Dialogo.Radio4)
      ACN(ba20,Dialogo.Radio2)

      CrearDialogo
         NrOperacion1 : "Operacion"                ;1;1;;NO;;;;;val(ba1) ;
         Cliente4     : "Coloca"                   ; ; ;;NO;;;;;val(ba2) ;
         Especie1     : "Moneda"                   ; ; ;;NO;;;;;val(ba5) ;
         Fecha1       : "Vto V_Nominal"            ; ; ;;NO;;;;;val(ba6) ;
         Cantidad1    : "VNA"                      ; ; ;;NO;;;;;val(ba7) ;;;;;"###,###,###,###.##"
         Radio3       : 'Fondeo|Local|Extranjero'  ; ; ;;NO;EqStr(val(ba8),'MMPCLM');;;;val(ba3);;;;;
         Radio5       : 'Fondeo|BLocalFExt|BcoExt' ; ; ;;NO;EqStr(val(ba8),'MMPOSM');;;;val(ba4);;;;;
         Cliente1     : "Toma"                     ; ; ;;NO;;;;;val(ba9) ;
         Cantidad2    : "Valor Nominal"            ; ; ;;NO;;;;;val(ba10); ;;;"###,###,###,###.##"
         Radio1       : "Ya Participa?|No|Si"      ;1;2;;NO;;;;;val(ba11);
         Fecha3       : "Concertacion"             ; ; ;;NO;;;;;val(ba12);
         Fecha4       : "F.Cesion"                 ; ; ;;NO;;;;;val(ba13);
         TipoOp1      : 'TipoOp'                   ; ; ;;NO;;;;;val(ba8) ;
         Precio4      : 'Tasa WH'                  ; ; ;;NO;;;;;val(ba14);
         Precio5      : 'Tasa IVA'                 ; ; ;;NO;;;;;val(ba15);
         Precio6      : 'Tasa ImpInt'              ; ; ;;NO;;;;;val(ba16);
         NrOperacion3 : "Op.Participa"             ; ; ;;NO;val(ba11)=1;;;;val(ba17);
         Radio2       : "Acumula a Existente?|No|Si" ;;;;;val(ba11)=1;;;;val(ba20);
         Radio4       : 'Pmo.|Local|Extranjero'    ;10;1;1;NO;NO;;;;val(ba18);
         ListBox; 'Arial,8,N'; 480; 300
            'NrCuota'       ;aa:1..aa:FAC;NO;;;;60;NUMERO ;'###'
            'PorAmor'       ;ab:1..ab:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'Amor'          ;ac:1..ac:FAC;NO;;;;100;NUMERO;'###,###,###.##'
            'Tasa'          ;ad:1..ad:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'Spread'        ;ae:1..ae:FAC;NO;;;;80;NUMERO ;'##,###.#####'
            'TasaIntIva'    ;af:1..af:FAC; ;VAL(af:FLB)>=0;'Tasa Int. Calculo IVA Cuota '~Fstr(val(aa:flb),0,0)~' Incorrecta';;80;NUMERO;'##,###.#####'
            'TasaIntWH'     ;ag:1..ag:FAC;val(ba18)=1;VAL(ag:FLB)>=0 o val(ba18)=0;'Tasa Int. Calculo WH Cuota '~Fstr(val(aa:flb),0,0)~' Incorrecta';;80;NUMERO;'##,###.#####'
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      *- ah1: Cantidad de filas de cuotas 
      ACN(ah1,fac)
   EndIf

   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select NrOperacion,TipoOp,FechaOp2,FechaOp,RB10,Vehiculo1,OperacionRef,")
   SQL.ADD("Cuotas2,Cuotas1,RB6,Cliente1,Especie,")
   SQL.ADD("Cliente2,Cantidad,Plazo,FechaVto,")
   SQL.ADD("TipoTasa,RB8,TotalComisiones,")
   SQL.ADD("PrecioEj,ImpGastos2,TotalAux1,")
   SQL.ADD("TasaImp1,IntDevengados1,")
   SQL.ADD("Operador,Observac2,NrOperacion2,")
   SQL.ADD("TablaFeriados1,CB10,Precio2,")
   SQL.ADD("RB5,RB3,Impresa,Cotizacion1,Cotizacion2, ")
   SQL.ADD("RB11,Cuenta1,Cuenta2,Cuenta3,Cuenta4 ,Cuenta5, PlazoGracia,Precio3,MB1,DeltaTasa,")
   SQL.ADD("TotalIntereses,ImporteImp,Indice,Book1 FROM ")
   SQL.ADD(" "~DBO~".OPERACIONES ")
   SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
        acn(x1,1)

        ACD(fo1,FBN['FechaOp'])

        *-- A5: TotalComisiones   A6: ValorNominal Total  
        ACN(A6,Dialogo.Cantidad2)

        *-- A2: Entidad Local o Extranera -> CB10
        ACN(A2,IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1))

        Message('Actualizando la Operacion Original .... ')                  

        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set PrecioEj=PrecioEj-"~FStr(Dialogo.Cantidad2,0,2)~", ")
        SQL.ADD("    Cantidad=Cantidad-"~FStr(Dialogo.Cantidad2*FBN['Cantidad']/Dialogo.Cantidad1,0,2)~", ")
        SQL.ADD("    TotalComisiones=TotalComisiones-"~FStr(Dialogo.Cantidad2*FBN['TotalComisiones']/Dialogo.Cantidad1,0,2)~" ")
        SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and ")
        SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
        SQL.NEW
        SQL.EXEC

        Message('*-- Antes de PRPRES => Disminuye el Capital => - Precio1=Dialogo.Cantidad2')
        EjecutarEvento('PRPRES',NrOperacion2=Dialogo.NrOperacion1,String1=" Fecha2>='"~IdxDate(Dialogo.Fecha4)~"' ",Precio1=-Dialogo.Cantidad2)

        EjecutarEvento('INCOMV',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=Dialogo.NrOperacion1,String=" 1=1 ",String1=" Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' " )

        * Actualizo la Instancia de la Operacion a Supervision
        (.'MODIINSTAN'.)      

        * Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
        SQL.EXEC

        IF val(j1)=0
           Message('Generando la Nueva Operacion   .... ')          

           *** Z3 Nro. Operacion Contado
           ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

           * Genero el Nuevo FRN 
           SQL.ADD("Insert INTO "~DBO~".OPERACIONES ")
           SQL.ADD("(TipoOp,NrOperacion,")
           SQL.ADD("FechaOp2,FechaOp, ")
           SQL.ADD("RB10,OperacionRef,")
           SQL.ADD("Vehiculo1, ")
           SQL.ADD("Cliente1,Cliente2,")
           SQL.ADD("Especie,Plazo,")
           SQL.ADD("TipoTasa,")
           SQL.ADD("RB8, ")
           SQL.ADD("Cantidad,FechaVto,")
           SQL.ADD("TablaFeriados1,")
           SQL.ADD("Observac2,Operador,")
           SQL.ADD("CB10, ")
           SQL.ADD("ImpGastos2, RB3,")
           SQL.ADD("PrecioEj,Impresa, ")
           SQL.ADD("Cotizacion1,NrOperacion2,Cuotas1,TasaImp1,")
           SQL.ADD("Indice,Coeficiente,ResultadoIndice,CantidadOri,")
           SQL.ADD("Cuotas2,RB6,TotalComisiones,RB11, ")
           SQL.ADD("Cuenta1,Cuenta2,Cuenta3,Cuenta4 ,Cuenta5, PlazoGracia, ")
           SQL.ADD("Precio3,MB1,DeltaTasa,TotalIntereses,ImporteImp,FechaPago, ")
           SQL.ADD("RB5,IntDevengados1,Precio2,TotalAux1, Book1 ")
           SQL.ADD(") ")
           SQL.ADD(" Values ")
           SQL.ADD(" ('"~Dialogo.TipoOp1~"','"~VAL(Z3)~"',")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha3)~"','"~IdxDate(Dialogo.Fecha4)~"', ") 
           SQL.ADD(" '"~FBN['RB10']~"','"~FBN['OperacionRef']~"', ")
           SQL.ADD(" '"~FBN['Vehiculo1']~"', ")
           SQL.ADD(" '"~Dialogo.Cliente1~"','"~FBN['Cliente2']~"',")
           SQL.ADD(" '"~FBN['Especie']~"',"~FStr(FBN['FechaVto']-Dialogo.Fecha4,0,0)~", ")
           SQL.ADD(" '"~FBN['TipoTasa']~"', ")
           SQL.ADD(" '"~FStr(FBN['RB8'],0,0)~"', ")
           SQL.ADD(" "~FStr(Dialogo.Cantidad2,0,2)~", '"~IdxDate(FBN['FechaVto'])~"',")
           SQL.ADD(" '"~FBN['TablaFeriados1']~"',")
           SQL.ADD(" '"~FBN['Observac2']~"','"~USUARIOACTIVO~"', ")
           SQL.ADD(" '"~FBN['CB10']~"',")
           SQL.ADD(" "~Fstr(Dialogo.Precio5,0,7)~",'"~FBN['RB3']~"',")
           SQL.ADD(" "~Fstr(VAL(A6),0,2)~",'"~FBN['Impresa']~"',")
           SQL.ADD(" "~Fstr(FBN['Cotizacion1'],0,5)~",'"~Dialogo.NrOperacion1~"',"~Fstr(FBN['Cuotas1'],0,0)~","~Fstr(Dialogo.Precio6,0,7)~",")
           SQL.ADD(" '"~FBN['Indice']~"',1,0,"~FStr(Dialogo.Cantidad2,0,2)~", ")
           SQL.ADD(" "~Fstr(FBN['Cuotas2'],0,0)~",'"~FBN['RB6']~"',"~FStr(FBN['TotalComisiones']*Dialogo.Cantidad2/Dialogo.Cantidad1,0,2)~", '"~FBN['RB11']~"',")
           SQL.ADD(" '"~FBN['Cuenta1']~"','"~FBN['Cuenta2']~"','"~FBN['Cuenta3']~"','"~FBN['Cuenta4']~"','"~FBN['Cuenta5']~"', "~Fstr(FBN['PlazoGracia'],0,0)~", ")
           SQL.ADD(" "~Fstr(FBN['Precio3'],0,7)~",'"~FBN['MB1']~"',"~Fstr(FBN['DeltaTasa'],0,7)~", 0,0,'"~IdxDate(FBN['FechaOp'])~"', ")
           SQL.ADD(" '"~FBN['RB5']~"',"~Fstr(FBN['IntDevengados1'],0,7)~","~Fstr(FBN['Precio2'],0,7)~","~Fstr(FBN['TotalAux1'],0,7)~", '"~FBN['Book1']~"' ")
           SQL.ADD(" ) ")
           SQL.NEW

           Message('Insertando Settlements')
           SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
           SQL.ADD(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
           SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
           SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
           SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
           SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
           SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
           SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
           SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5, ")
           SQL.ADD(" Cantidad7,Cantidad8, ")
           SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice) ")
 
           SQL.ADD(" SELECT '"~VAL(z3)~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
           SQL.ADD(" Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
           SQL.ADD(" Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
           SQL.ADD(" Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
           SQL.ADD(" Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
           SQL.ADD(" Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
           SQL.ADD(" Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2, ")
           SQL.ADD(" Cantidad5, Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5, ")
           SQL.ADD(" Cantidad7,Cantidad8, ")
           SQL.ADD(" Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice  ")
           SQL.ADD(" FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
           SQL.ADD(" and  Fecha2>='"~IdxDate(Dialogo.Fecha4)~"'  ")
           SQL.NEW
           SQL.EXEC

           Recorrer&i 1,VAL(ah1)
              SQL.ADD("Update  "~DBO~".CUOTAS SET ")
              SQL.ADD("Tasa2="~Fstr(val(af:&i),0,8)~",")
              SQL.ADD("Total6="~Fstr(val(ag:&i),0,8)~" ")
              SQL.ADD("WHERE NrOperacion='"~VAL(z3)~"' and NrCuota="~val(aa:&i)~" ")
              SQL.NEW
              SQL.EXEC
           Proximo

           *-- Disminuye el Capital => - Precio1=Dialogo.Cantidad2
           EjecutarEvento('PRPRES',NrOperacion2=VAL(Z3),String1=" 1=1 ",Precio1=-Dialogo.Cantidad1+Dialogo.Cantidad2+Dialogo.Cantidad2)

           * Alta de Instancias Z3: Nro.Operacion
           (.'ALTAINSTAN'.)

           *- Recalculo ttn de operacion item y Cabecera
           EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion1,Entero1=0,NrOperacion2='',Lista1='')

           EjecutarEvento('TTNOP',NrOperacion1=VAL(z3),Entero1=0,NrOperacion2='',Lista1='')

        Else 
          Message('Existe la Entidad en otra Operacion ')

          SQL.ADD("Update "~DBO~".OPERACIONES ")
          SQL.ADD("Set Cantidad=Cantidad+"~FStr(Dialogo.Cantidad2,0,2)~",")
          SQL.ADD("    PrecioEj=PrecioEj+"~FStr(Dialogo.Cantidad2,0,2)~", ")
          SQL.ADD("CantidadOri=CantidadOri+"~FStr(Dialogo.Cantidad2,0,2)~" ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
          SQL.NEW

          SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' and ")
          SQL.ADD("Fecha1>='"~IdxDate(Dialogo.Fecha4)~"' ")
          SQL.NEW
          SQL.EXEC

          ACT(i3,Dialogo.NrOperacion3)
          ACT(Z3,VAL(I3))

          (.'MODIINSTAN'.)      

           *-- Aumenta el Capital => + Precio1=Dialogo.Cantidad2
           EjecutarEvento('PRPRES',NrOperacion2=Dialogo.NrOperacion3,String1=" Fecha2>='"~IdxDate(Dialogo.Fecha4)~"'  ",Precio1=+Dialogo.Cantidad2)
        Endif

        * Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(VAL(Z3),SI)
        SQL.EXEC

        *- Recalculo ttn de operacion item y Cabecera
        EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion3,Entero1=0,NrOperacion2='',Lista1='')

        EjecutarEvento('TTNOP',NrOperacion1=Dialogo.NrOperacion1,Entero1=0,NrOperacion2='',Lista1='')

   Proximo

   If Val(x1)=0
      Cancelar('La Operacion No '~Dialogo.NrOperacion1~' No pudo Desdoblarse')
   endif
endif
