'Posicion';ak:2..ak:fac;NO;;;100;numero;'###,###,###,###.##'
'Precio';al:2..al:fac;NO;;;100;numero;'###.########'
'Cant.a Transferir';an:2..an:fac;SI;Val(ao:flb) = 0 o (Val(an:flb) <= Val(ak:flb) y Val(an:flb) > 0);'Cantidad a transferir invalida. (Fila '~FStr(flb - 1, 1, 0)~')';100;numero;'###,###,###,###.##';RGB(160, 160, 193)
'Cuenta Destino';am:2..am:fac;SI;Val(ao:flb) = 0 o (NoVacio(Val(am:flb)) y (not Eqstr(Val(am:flb), Val(ai:flb)) o not Eqstr(Val(aj:flb), Val(at:flb))) y Incluido(Val(am:flb), SQLSet("select Codigo from "~Dbo()~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~Val(ag:flb)~"' and (Especies Like '%TITULO%' or Especies Like '%"~Val(aa:flb)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")));'Ingrese una Cuenta de Titulo con una combianacion de Cuenta+Tipo distinta a la de origen';120;tabla;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~Val(ag:flb)~"' and (Especies Like '%TITULO%' or Especies Like '%"~Val(aa:flb)~"%') ";RGB(160, 160, 193);;SI;SI;
'Destino Gar';ar:2..ar:fac;NO;;;30;string;;;iif (Vacio(Val(am:flb)), '', BuscarCampo('CUENTAS', 'CB2', 'Codigo', Val(am:flb)))
'Tipo Destino';as:2..as:fac;Eqstr(Val(ar:flb), 'SI');;;70;combo;'|GARINI|GARDIA|';RGB(160, 160, 193);
'Tipo Destino';at:2..at:fac;NO;;;0;string;;;iif (Val(as:flb) <= 0, '', iif (Val(as:flb) = 1, 'GARINI', 'GARDIA'))
