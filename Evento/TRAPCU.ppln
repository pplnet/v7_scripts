Sqladd(" SELECT DISTINCT P.Especie, P.Cupon, P.Cliente, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
Sqladd(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin, P.Fecha, P.PrecioFinCon, P.PrecioHistCon, ")
Sqladd(" P.PrecioReset, P.PrecioResetCon, P.Estrategia, P.TipoPosicion ")
Sqladd(" FROM "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E, "~Dbo()~".VEHICULOS V ")
Sqladd(" WHERE P.Especie = E.Codigo ")
Sqladd(" AND   P.Cliente = V.Codigo ")
Sqladd(" AND   P.Vehiculo= V.Codigo ")
Sqladd(" AND   P.Fecha  <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   P.CantidadFin <> 0 ")
if (NoVacio(dialogo.especie1))
Sqladd(" AND   P.Especie = '"~dialogo.especie1~"'  ")
endif
Sqladd(" AND P.Book Not IN ("~Pipe2Comillas(&bvaluapartida)~") ")
Sqladd(" AND   P.NrSaldo IN (122) ")
Sqladd(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES P1 ")
Sqladd("                   WHERE P1.Especie   = P.Especie  ")
Sqladd("                   AND   P1.Vehiculo  = P.Vehiculo ")
Sqladd("                   AND   P1.Cliente   = P.Cliente  ")
Sqladd("                   AND   P1.NrSaldo   = P.NrSaldo  ")
Sqladd("                   AND   P1.Book      = P.Book     ")
Sqladd("                   and   IsNull(P.Unidad,'')       = IsNull(P1.Unidad,'') ")
Sqladd("                   and   IsNull(P.Centro,'')       = IsNull(P1.Centro,'') ")
Sqladd("                   and   IsNull(P.Sector,'')       = IsNull(P1.Sector,'') ")
Sqladd("                   and   IsNull(P.Sucursal,'')     = IsNull(P1.Sucursal,'') ")
Sqladd("                   and   IsNull(P.PrecioEj,0)      = IsNull(P1.PrecioEj,0) ")
Sqladd("                   and   IsNull(P.FechaEj,0)       = IsNull(P1.FechaEj,0) ")
Sqladd("                   and   IsNull(P.CallPut,'')      = IsNull(P1.CallPut,'') ")
Sqladd("                   and   IsNull(P.Estrategia,'')   = IsNull(P1.Estrategia,'') ")
Sqladd("                   and   IsNull(P.Cartera,'')      = IsNull(P1.Cartera,'') ")
Sqladd("                   and   IsNull(P.Trader,'')       = IsNull(P1.Trader,'') ")
Sqladd("                   and   IsNull(P.TipoNegocio,'')  = IsNull(P1.TipoNegocio,'') ")
Sqladd("                   and   IsNull(P.Cupon,'')        = IsNull(P1.Cupon,'') ")
Sqladd("                   and   IsNull(P.Responsable,'')  = IsNull(P1.Responsable,'') ")
Sqladd("                   and   IsNull(P.TipoPosicion,'') = IsNull(P1.TipoPosicion,'') ")
Sqladd("                   and   IsNull(P.Producto,'')     = IsNull(P1.Producto,'') ")
Sqladd("                   and   IsNull(P.GrupoEspecie,'') = IsNull(P1.GrupoEspecie,'') ")
Sqladd("                   AND   P1.Fecha     <= "~IdxDate2(dialogo.fecha1)~" ")
Sqladd("                  ) ")
Sqladd(" ORDER BY P.Vehiculo, P.Book, P.NrSaldo, E.Tipo, P.Especie, P.Cupon, P.Estrategia, P.TipoPosicion ")

recorrer sql
Scn(y:1, 1)
Act(aa:fac, Fbn('Especie'))
