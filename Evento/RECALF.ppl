CrearDialogo
  Fecha1       : 'Fecha Conc.'  ;1;1; ;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
  NrOperacion1 : 'Nr.Operacion:'; ; ; ;;;Vacio(Dialogo.NrOperacion1) o [NoVacio(Dialogo.NrOperacion1) y Query("Select 1 from "~DBO~".OPERACIONES where NrOperacion='"~Dialogo.NrOperacion1~"' and Mercado4='BYMA' ")=1];'Operacion Invalida.';NO;
  Check1       : 'Procesa'      ; ; ; ;NO;NO;;;;1;
  Check2       : 'Visible'      ; ; ; ;NO;NO;;;;0;
FinDialogo
if Not OK
   Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

if Dialogo.Check2=1
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'NrOperacion')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'Merc.Nego.')
ACT(d:FAC, 'FechaOp')
ACT(e:FAC, 'RB5')
ACT(f:FAC, 'F.Vto Pre')
ACT(g:FAC, 'Inst.')
ACT(h:FAC, 'Instancia')
ACT(i:FAC, 'F.Vto Post')
ACT(j:FAC, '# Inst Post')
ACT(k:FAC, 'Inst.  Post')
ACT(l:FAC, 'Instancia Post')
SetFont(a:FAC..l:FAC,2)

SQL.ADD("Select O.NrOperacion,O.TipoOp,O.Mercado4,O.FechaOp,O.RB5,O.FechaVto,NrBit from "~DBO~".OPERACIONES  O, "~DBO~".OPERACIONESBITS  OB ")
SQL.ADD(" WHERE O.NrOperacion=OB.NrOperacion ")
SQL.ADD("  and Valor=1 ")
SQL.ADD("  and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and Mercado4 ='BYMA' ")
SQL.ADD("  and RB5 > 0 ")
if NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("  and O.NrOperacion ='"~Dialogo.NrOperacion1~"' ")
endif
SQL.ADD(" Order by O.NrOperacion,OB.NrBit ")

Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACT(c:FAC, fbn('Mercado4'))
  ACD(d:FAC, fbn('FechaOp'))
  ACN(e:FAC, fbn('RB5'))
  ACD(f:FAC, fbn('FechaVto'))
  ACN(g:FAC, fbn('NrBit'))
  ACT(h:FAC, Query("Select Nombre from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and NrInstancia='"~fbn['NrBit']~"' "))

  if Dialogo.Check1=1
    EjecutarEvento('RECALB', NrOperacion1=fbn['NrOperacion'])
  endif
  ACD(i:FAC, BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Val(a:FAC)))
  SQL.ADD("Select NrBit from "~DBO~".OPERACIONESBITS ")
  SQL.ADD(" WHERE NrOperacion = '"~Val(a:FAC)~"' ")
  SQL.ADD("   and Valor=1 ")
  SQL.ADD(" Order by NrOperacion,NrBit ")
  Recorrer SQL
    DFA
    SCN(j:FAC, 1)
    ACN(k:FAC, fbn('NrBit'))
    ACT(l:FAC, Query("Select Nombre from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and NrInstancia='"~fbn['NrBit']~"' "))
  proximo
proximo

if FAC>1
  FormatoCeldas(e:2..e:FAC,Exe('F0'))
  FormatoCeldas(g:2..g:FAC,Exe('F0'))
  FormatoCeldas(k:2..k:FAC,Exe('F0'))
else
  MessageBox('No se encontraron operaciones para recalcular.')
endif