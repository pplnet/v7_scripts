                        ACT(aa:1,COPY(VAL(aa:1),121,1300))
                    endif
                    
                    if Eqstr(COPY(VAL(aa:1),1,1), '0')
                        * TipoDocum
                        if not SQL("Select Count(*) from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='TIPODOCUMENTO' and ValorSistemaExterno='" ~COPY(VAL(aa:1),2,1)~ "'") = 0
                            SQL.ADD("(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='TIPODOCUMENTO' and ValorSistemaExterno='" ~COPY(VAL(aa:1),2,1)~ "'),")
                        else
                            SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " TipoDocum: " ~COPY(VAL(aa:1),2,1)~ "')")
                            SQL.ADD("NULL,")
                        endif
                        
                        * TipoInscripcion
                        SQL.ADD("'CIT',")
                        
                        if Eqstr(COPY(VAL(aa:1),1,2), '55')
                            ACT(aa:7,'55')                
                        endif
                    else
                        * TipoDocum
                        if not SQL("Select Count(*) from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='TIPODOCUMENTO' and ValorSistemaExterno='" ~COPY(VAL(aa:1),1,2)~ "'") = 0
                            SQL.ADD("(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='TIPODOCUMENTO' and ValorSistemaExterno='" ~COPY(VAL(aa:1),1,2)~ "'),")
                        else
                            SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " TipoDocum: " ~COPY(VAL(aa:1),1,2)~ "')")
                            SQL.ADD("NULL,")
                        endif
                        
                        * TipoInscripcion
                        if Eqstr(COPY(VAL(aa:1),1,2), '55')
                            ACT(aa:7,'55')                
