                        ELSE
                            SQL.ADD("'CIT',")
                        endif
                        
                    endif
                    ACT(aa:1,COPY(VAL(aa:1),3,1300))

                    *CNV
                    if Eqstr(VAL(aa:7), '55')
                       SQL.ADD("'" ~ReemplazarSTR(COPY(VAL(aa:1),1,11),"'","''",SI)~ "',")
                    ELSE
