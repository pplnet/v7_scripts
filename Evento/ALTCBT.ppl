                    SQL.ADD("Telefono,TipoDocum,TipoInscripcion,CodigoCNV,NrDocum,FechaApertura,ActividadBCRA,Persona,CondicionIVA,Pais,CondicionGan,FechaCierre,FechaInsc,Inscripcion,NroInsc,Tomo,Folio,")
                    SQL.ADD("DireccionEMail,Nacionalidad,CodigoBcra,Fax,Libro,OficialCuenta,Status,ClasificacionSE,Vinculado,Jerarquia,CategDepositante)")
                    SQL.ADD(" values (")
                    
                                                               
                    
                    * Codigo
                    SQL.ADD("'" ~COPY(VAL(aa:1),1,9)~ "',")
                    ACT(cc:1,COPY(VAL(aa:1),1,9))
                   * AliasBt
                    SQL.ADD("'" ~COPY(VAL(aa:1),1,9)~ "',")
