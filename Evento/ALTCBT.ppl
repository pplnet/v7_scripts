                        if not EqStr(VAL(aa:5),'')
                            ACT(aa:6,SQL("select jerarquia from dbo.clientes where codigo='"~Val(aa:5)~"'" ))
                            if Eqstr(COPY(VAL(aa:6),1,3),'003')
                                ACT(aa:6, Var("ULTJERARQ."))
                               *ACT(aa:6,GenerarJerarquiaByRef('CLIENTES',Val(aa:6) ,1))  
                                ACT(aa:6,GenerarJerarquiaPorReferencia('CLIENTES',Val(aa:6) ,'SI','NO'))          
                                
                                if Eqstr (COPY(VAL(bb:4),7,3),'999')
                                    ACN(bb:5,NUM(COPY(VAL(bb:4),3,4)))
                                    ACN(bb:5,VAL(BB:5)+1)
                                    ACT(bb:7,'00'~FStr(VAL(BB:5),4,0)~'000000000')
                                    SQL("UPDATE dbo.VARIABLES SET VALOR= '"~VAL(bb:7)~ "' WHERE CODIGO ='ULTJERARQ.'")
                                    if SQL("Select Count(*) from dbo.CLIENTES where Codigo ='CLIENTE" ~COPY(VAL(bb:5),2,3)~ "'") = 0
                                        SQL("INSERT INTO  dbo.CLIENTES (Jerarquia,Codigo,status,FechaApertura) SELECT '"~VAL(bb:7)~"','CLIENTE"~COPY(VAL(bb:5),2,3)~ "',status,FechaApertura FROM DBO.CLIENTES WHERE CODIGO='CLIENTES'")
                                    endif
                                    SQL.ADD("'" ~Val(aa:6)~ "',")
                                    
                                else        
                                    SQL.ADD("Jerarquia='" ~Val(aa:6)~ "',")
                                endif
                            else    
                                SQL.ADD("'" ~GenerarJerarquiaByRef('CLIENTES',Val(aa:6) ,1)~ "',")
                            endif
                        else
                            SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " Jerarquia: " ~Val(aa:4)~"."~Val(aa:3)~"')")
                        endif
                    endif

                    
                    * CategDepositante
                     if EqStr(VAL(aa:8),'13')
                        if not SQL("select Count(*) from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CLASIFCA' and ValorSistemaExterno='13'") = 0
                        SQL.ADD("CategDepositante=(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CLASIFCA' and ValorSistemaExterno='13'),")
                        else
                            * nose
                            SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " Jerarquia: " ~Val(aa:4)~"."~Val(aa:8)~"')")
                            SQL.ADD("CategDepositante=NULL,")
                        endif
                    else   
                        if EqStr(VAL(aa:8),'15')
                            if not SQL("select Count(*) from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CLASIF' and ValorSistemaExterno='15'") = 0
                                SQL.ADD("CategDepositante=(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CLASIF' and ValorSistemaExterno='15'),")
                            else 
                                SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " Jerarquia: " ~Val(aa:4)~"."~Val(aa:8)~"')")
                                SQL.ADD("CategDepositante=NULL,")
                            endif
                        else
                             if EqStr(COPY(VAL(aa:3),1,1),'0')
                             if not SQL("select Count(*) from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CATEGDEPO'and len(valorsistemaexterno)=1 and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"'" ) = 0
                                SQL.ADD("CategDepositante=(select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CATEGDEPO'and len(valorsistemaexterno)=1 and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"'),")
                                else
                                    SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " CategDepositante: " ~Val(aa:4)~"')")
                                    SQL.ADD("CategDepositante=NULL,")
                                endif
                             else
                                if not SQL("select Count(*) from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CATEGDEPO'and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"' and (len(Valorsistemaexterno)<> 3 or (len(Valorsistemaexterno)=3 and substring(valorsistemaexterno,3,1)='"~Val(aa:3)~"'))") = 0
                                SQL.ADD("CategDepositante=(select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CATEGDEPO'and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"' and (len(Valorsistemaexterno)<> 3 or (len(Valorsistemaexterno)=3 and substring(valorsistemaexterno,3,1)='"~Val(aa:3)~"'))),")
                                else
                                    SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " CategDepositante: " ~Val(aa:4)~"')")
                                    SQL.ADD("CategDepositante=NULL,")
                                endif
                            endif
                        endif
                    endif      
                    
                    * FechaModificacion
    *                SQL.ADD("FechaModificacion='" ~IdxDate(fsys)~ "'")
                    SQL.ADD("FechaModificacion=Getdate()")
                    
                    SQL.ADD("where Aliasbt='" ~VAL(cc:1)~ "'") 
                    
                    SQL.NEW
                    SQL.EXEC
                endif
                &ServicioCuenta.ConsultaIntegrantesCuentaYProductos(""~Val(cc:1)~"")
               
            endif
        CATCH
            ACT(bb:3,ReemplazarSTR(GetError(),"'","''",SI))
            SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','No se proceso la linea del Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " Error: " ~Val(bb:3)~"')")
        END
    Proximo
    CerrarASCII
    
    WinExec("CMD.EXE /C MOVE "~VAR("ALTACLI")~"\\"~Val(bb:1)~" "~VAR("ALTCLIPROC")~"\"~Val(bb:1)~"["~copy(VAL(bb:2),1,4)~copy(VAL(bb:2),6,2)~copy(VAL(bb:2),9,2)~"-"~copy(VAL(bb:2),12,2)~copy(VAL(bb:2),15,2)~copy(VAL(bb:2),18,2)~"]",0 ) 
    
    ACT(bb:1, ProximoArchivo)
    If Not Ok   
        Break
    EndIf
Proximo
 
MessageBox('El evento ha finalizado')    
HojaVisible(NO)
GrillaVisible(NO)

