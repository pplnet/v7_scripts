                    SQL.ADD("(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CONDICIONGAN' and CONVERT(INT,ValorSistemaExterno)=CONVERT(INT,'" ~COPY(VAL(aa:1),1,2)~ "')),")
                    else
