                           *NO guarda bien los valores 12/9
                           *ACT(aa:6,GenerarJerarquiaByRef('CLIENTES',Val(aa:6) ,1))
                            ACT(aa:6,GenerarJerarquiaPorReferencia('CLIENTES',Val(aa:6) ,'SI','NO'))
                            if Eqstr (COPY(VAL(aa:6),7,3),'999')
                                ACN(bb:5,NUM(COPY(VAL(aa:6),3,4)))
                                ACN(bb:5,VAL(BB:5)+1)
                                ACT(bb:7,'00'~FStr(VAL(bb:5),4,0)~'000000000')
                                SQL("UPDATE dbo.VARIABLES SET VALOR= '"~VAL(bb:7)~ "' WHERE CODIGO ='ULTJERARQ.'")
                                if SQL("Select Count(*) from dbo.CLIENTES where Codigo ='CLIENTE" ~COPY(VAL(BB:5),2,3)~ "'") = 0
                                    SQL("INSERT INTO  dbo.CLIENTES (Jerarquia,Codigo,status,FechaApertura) SELECT '"~VAL(bb:7)~"','CLIENTE"~COPY(VAL(BB:5),2,3)~ "',status,FechaApertura FROM DBO.CLIENTES WHERE CODIGO='CLIENTES'")
                                endif
                            endif        
                            SQL.ADD("'" ~VAL(aa:6)~ "',")
                         else
                           *SQL.ADD("'" ~GenerarJerarquiaByRef('CLIENTES',Val(aa:6) ,1)~ "',")
                            SQL.ADD("'" ~GenerarJerarquiaPorReferencia('CLIENTES',Val(aa:6) ,'SI','NO')~ "',")
                         
