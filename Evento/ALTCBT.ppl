                        SQL.ADD("RTRIM('" ~COPY(VAL(aa:1),1,3)~ "'),") 
                    else
                        SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " OficialCuenta: " ~COPY(VAL(aa:1),1,3)~ "')")
                        SQL.ADD("NULL,")
                    endif
                    if EqStr(COPY(VAL(aa:2),1,1),'H')
                        SQL.ADD("'HAB',")
                    else
                        SQL.ADD("'DES',")
                    endif
                    * ClasificacionSE
                    SQL.ADD("RTRIM('" ~VAL(aa:8)~ "'),") 
                    * Vinculado
                    if EqStr(VAL(aa:9),'1')
                        SQL.ADD("'SI',")
                    else
                        SQL.ADD("'NO',")
                    endif
                    * Jerarquia
                    if EqStr(VAL(aa:9),'1')
                        ACT(aa:5,SQL("select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='JERARQUIA' AND ValorSistemaExterno='V'"))
                    else
                        if EqStr(VAL(aa:8),'13')
                            ACT(aa:5,SQL("select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CLASIFJE' AND ValorSistemaExterno='13'"))
                        else
                            if EqStr(VAL(aa:8),'15')
                                ACT(aa:5,SQL("select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='CLASIFJE' AND ValorSistemaExterno='15'"))
                            else    
                                if EqStr(COPY(VAL(aa:3),1,1),'0')
                                    ACT(aa:5,SQL("select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='JERARQUIA'and len(valorsistemaexterno)=1 and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"'" ))
                                else
                                    ACT(aa:5,SQL("select valor from dbo.ConfigValExternos where codigoproceso='ALTCBT' and atributo='JERARQUIA'and substring(valorsistemaexterno,1,1)='"~Val(aa:4)~"' and (len(Valorsistemaexterno)<> 3 or (len(Valorsistemaexterno)=3 and substring(valorsistemaexterno,3,1)='"~Val(aa:3)~"'))"))
                                endif
                             endif   
                         endif
                    endif
                    
                    if not EqStr(VAL(aa:5),'')
                        ACT(aa:6,SQL("select jerarquia from dbo.clientes where codigo='"~Val(aa:5)~"'" ))
