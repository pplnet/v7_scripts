                    SQL.ADD("(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='CONDICIONIVA' and ValorSistemaExterno='" ~COPY(VAL(aa:1),1,1)~ "'),")
