                    else
                        SQL.ADD("'JUS',")
                    endif
                    ACT(aa:1,COPY(VAL(aa:1),9,1300))
                    * NroInsc
                    SQL.ADD("RTRIM('" ~ReemplazarSTR(COPY(VAL(aa:1),1,12),"'","''",SI)~ "'),") 
