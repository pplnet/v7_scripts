require '..\Lib\IntegracionBIND.dll'
Mostrarcuadrodemensajes

import ServCuenta, 'IntegracionBIND.ServiciosBT'
let &ServicioCuenta new ServCuenta(GetDataBase())

if NOt ExisteDirectorio(VAR("ALTACLI"))
     MessageBox("No existe el directorio"~VAR("ALTACLI"))
     Cancelar
endif


ACT(bb:1, PrimerArchivo(Var("ALTACLI")~"\\*.*"))
ACT(bb:2,SQL("Select CONVERT(VARCHAR(20),Getdate(),20)"))


If Not Ok 
  MessageBox('No hay archivos para procesar')    
  Cancelar
EndIf

if NOt ExisteDirectorio(VAR("ALTCLIPROC"))
    WinExec("CMD.EXE /C CD "~VAR("ALTACLI"), 0)
    WinExec("CMD.EXE /C MKDIR "~VAR("ALTCLIPROC"), 0)
endif   



Recorrer&I,2000

    MESSAGE("Se Esta procesando el archivo:"~Val(bb:1))
   
    AbrirASCII(Var("ALTACLI")~"\\"~Val(bb:1),0)

    Recorrer&ai 1,2000

    
        ACT(aa:1, LeerAscii)
        
        if Not Ok
            break
        endif

        ACT(bb:3,VAL(aa:1))  
        
        TRY
        
            if not Eqstr(COPY(VAL(aa:1),1,9), '')
