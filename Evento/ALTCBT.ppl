                    * SQL.ADD("Insert into dbo.CLIENTES (Jerarquia,Codigo,AliasBt,CUIT,RazonSocial,Direccion,CodigoPostal,Localidad,Provincia,Telefono,TipoDocum,NrDocum,ActividadBCRA,Persona")
