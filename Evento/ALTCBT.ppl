                        SQL("Insert into DBO.LOGINFORMES values('"~USUARIOACTIVO~"',GETDATE(),'EVE','ALTCBT','Archivo: " ~VAL(bb:1)~ " Cliente: " ~VAL(cc:1)~ " Nacionalidad: " ~COPY(VAL(aa:1),1,3)~ "')")
                        SQL.ADD("NULL,")
                    endif 
                    ACT(aa:1,COPY(VAL(aa:1),10,1300))
