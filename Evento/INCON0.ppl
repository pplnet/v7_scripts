CrearDialogo
  NrOperacion1 : 'NrOperacion' ;;;;;;NoVacio(Dialogo.NrOperacion1);'Operacion Invalida';NO;
  Fecha1       : 'Fecha Mov'   ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Invalida';NO;FSys;
FinDialogo

If Not Ok
   Cancelar
Endif

MostrarCuadroDeMensajes

ACN(BD:1, 0)
SQL.ADD(" Select NrOperacion From "~DBO~".MOVIMIENTOS ")
SQL.ADD(" Where Movimiento_Fecha = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    SCN(BD:1, 1)
Proximo

IF Val(BD:1) = 0
    MessageBox('No Hay Movimientos Transferidos que Concuerden con los Datos Ingresados')
ELSE
    SQL.ADD(" Delete "~DBO~".MOVIMIENTOS ")
    SQL.ADD(" Where Movimiento_Fecha = '"~IdxDate(Dialogo.Fecha1)~"'  ")
    SQL.ADD(" AND NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
    MessageBox(Fstr(Val(BD:1), 0, 0)~' :Registros Borrados')
ENDIF
