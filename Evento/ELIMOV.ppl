******************************************************************************
* ESTE EVENTO ELIMINA LOS MOVIMIENTOS PENDIENTES DE LAS OPERACIONES ANULADAS *
******************************************************************************

SQL.ADD("SELECT DISTINCT MP.NrOperacion ")
SQL.ADD("FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".MOVPENDIENTES MP ")
SQL.ADD("WHERE OB.NrBit = 30 AND ")
SQL.ADD("      OB.Valor = 1 AND ")
SQL.ADD("      OB.NrOperacion = MP.NrOperacion ")
SQL.ADD("ORDER BY MP.NrOperacion ")

Recorrer SQL
   EjecutarEvento('ANULO',NrOperacion1=FBN['NrOperacion'])
Proximo
