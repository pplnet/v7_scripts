Sqladd(" Select 1 ")
Sqladd(" From "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".OPERACIONES O  ")
Sqladd(" Where M.NrOperacion = O.NrOperacion ")
if (NoVacio(dialogo.fecha2))
Sqladd(" AND M.FechaEj = '"~IdxDate(dialogo.fecha2)~"' ")
endif
Sqladd(" AND M.NrMov > 100 ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND M.Cliente Not IN ("~Pipe2Comillas(Val(ls:1))~") ")
