endif
Sqladd(" AND M.NrMov > 100 ")
Sqladd(" AND M.NrSaldo = 1 ")
Sqladd(" AND M.Cliente IN ("~Pipe2Comillas(Val(ls:1))~") ")
Sqladd(" AND M.FechaMov = '"~IdxDate(Val(fe:1))~"' ")
if (NoVacio(dialogo.vehiculo1))
Sqladd(" AND O.Vehiculo1 = '"~dialogo.vehiculo1~"'")
endif
Sqladd(" and O.TipoOp in ('FXCF','FXVF') ")

