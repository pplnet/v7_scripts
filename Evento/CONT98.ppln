MostrarCuadroDeMensajes()
creardialogo
nrunicoasiento1: 'Asiento';;;;;;NoVacio(dialogo.nrunicoasiento1);'Asiento Invalido';;
fecha1: 'F.Valor Original';2;;;NO;;;;NO;;iif (Vacio(dialogo.nrunicoasiento1), FSys(), BuscarCampo('ASIENTOSCON', 'FechaValor', 'NrUnicoAsiento', dialogo.nrunicoasiento1))
fecha2: 'F.Valor Nueva';4;;;;;dialogo.fecha2 > 0 y dialogo.fecha2 < FSys();'Fecha Invalida';NO;

findialogo

if (not ok)
Cancelar()
endif

Acn(bd:1, 1)
Sqladd(" Select  FechaGeneracion, FechaValor,NrUnicoAsiento,NrOperacion, Fecha2, Estado ")
Sqladd(" From  "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' ")
Sqladd(" AND (Estado = 'E' OR Estado = 'COE' OR Estado = 'NCE' OR Estado = 'REE') ")
Sqladd(" order by NrUnicoAsiento ")
recorrer sql
Acn(bd:1, 0)
if (Eqstr(Fbn('Estado'), 'COE'))
Act(a:fac, 'COT')
else 
if (Eqstr(Fbn('Estado'), 'NCE'))
Act(a:fac, 'NC')
else 
Act(a:fac, 'REV')
endif
endif
Message('Operacion '~Fbn('NrOperacion'))
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
if (Eqstr(Fbn('Estado'), 'E'))
Sqladd(" Set Estado = Null, ")
else 
Sqladd(" Set Estado = '"~Val(a:fac)~"', ")
endif
Sqladd(" Fecha2 = Null, ")
Sqladd(" FechaValor = '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
proximo

if (Val(bd:1) = 0)
Messagebox('El Asiento '~dialogo.nrunicoasiento1~' esta disponible para Re-envio ')
else 
Messagebox('El Asiento '~dialogo.nrunicoasiento1~' no fue enviado previamente, No corresponde Proceso')
endif
