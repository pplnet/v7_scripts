DialogoVisible(NO)
creardialogo
nroperacion1:'Nr.Operacion';
tipoop1:'Tipo Op';;;
check1:'CB1';;;;;;;;;;;
vehiculo1:'Vehiculo1';;;;;;;;;;;
vehiculo2:'Vehiculo2';;;;;;;;;;;
cuenta1:'Cuenta1';;;;;
cuenta2:'Cuenta2';;;;;
cuenta3:'Cuenta4';;;;;
cuenta4:'Cuenta5';;;;;
findialogo
if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.nroperacion1))
if (dialogo.check1 = 0 o Vacio(dialogo.check1))
if (not Incluido(dialogo.vehiculo1, Var('VEHIEXTRAN')) y not Incluido(dialogo.vehiculo2, Var('VEHIEXTRAN')) y Incluido(dialogo.tipoop1, 'SEPVMV|SECTV|SEVTV|FXCSV|FXVSV|FXCTV|FXVTV|FCCPV|FCVPV'))
Sqladd(" UPDATE "~Dbo()~".OPERACIONES")
Sqladd("Set  Cuenta1='"~dialogo.cuenta3~"', Cuenta4='"~dialogo.cuenta1~"',    ")
Sqladd("     Cuenta2='"~dialogo.cuenta4~"', Cuenta5='"~dialogo.cuenta2~"'     ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos2(dialogo.nroperacion1, SI, NO, NO, NO)
Sqlexec()
endif

if (not Incluido(dialogo.vehiculo1, Var('VEHIEXTRAN')) y not Incluido(dialogo.vehiculo2, Var('VEHIEXTRAN')) y Incluido(dialogo.tipoop1, 'MMPCCM'))
Sqladd(" UPDATE "~Dbo()~".OPERACIONES SET ")
Sqladd(" Cuenta1='"~dialogo.cuenta2~"' , Cuenta2='"~dialogo.cuenta1~"'    ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos2(dialogo.nroperacion1, SI, NO, NO, NO)
Sqlexec()
endif

else
endif
else
endif







