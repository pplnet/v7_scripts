creardialogo
nroperacion1: 'Nr.Operacion';;;;;;;;;
fecha1:'Fecha Trans';;;;;;;;;
fecha2:'Fecha Conc ';;;;;;;;;
vehiculo1:'Vehiculo';;;;;;;;;
cliente1:'Cliente';;;;;;;;;
entero1:'Copias';;;;;;;;;1
radio1:'Tipo|Clasico|Intermed.';;;;;;;;;0;;;
findialogo

if (not ok)
Cancelar()
endif

if (not Vacio(dialogo.vehiculo1))
if (not Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) y not Vacio(UsrVehiculos(UsuarioActivo())))
Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
endif
endif

Act(zz6, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"'"))

if (NoVacio(dialogo.nroperacion1))

Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif

endif

CrearFont(1, "Arial,8,B")

Sqladd("Select Distinct T.NrOperacionRef2,T.Fecha1,O.Cliente1,O.TipoOp,")
Sqladd("O.Especie,O.Cantidad,O.ContraEspecie,O.NrOperacion From ")
Sqladd(" "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONES O where ")
Sqladd("T.NrOperacionRef1=O.NrOperacion and T.NrOperacionRef2 is not NULL and ")
Sqladd("T.TipoTr2 In ('RET','DEP') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("and T.NrOperacionRef1='"~dialogo.nroperacion1~"' ")
else
if (NoVacio(IdxDate(dialogo.fecha1)))
Sqladd("and T.Fecha1='"~IdxDate(dialogo.fecha1)~"'  ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd(" and O.Vehiculo1='"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and O.Vehiculo1 IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
if (NoVacio(dialogo.cliente1))
Sqladd("and O.Cliente1='"~dialogo.cliente1~"' ")
endif
if (NoVacio(IdxDate(dialogo.fecha2)))
Sqladd("and O.FechaOp='"~IdxDate(dialogo.fecha2)~"' ")
endif
endif

recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
Acd(b:fac, Fbn()['Fecha1'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['TipoOp'])
Act(e:fac, Fbn()['Especie'])
Acn(f:fac, Fbn()['Cantidad'])
Act(g:fac, Fbn()['NrOperacionRef2'])
Acn(z1, 1)
proximo

if (Val(z1) = 0)
Messagebox('No existen cartas para la operacion')
else
ACO(1, 7)
ACO(2, 8)
ACO(3, 8)
ACO(4, 5)
ACO(5, 5)
ACO(6, 13)
ACO(7, 5)
FormatoCeldas(f:1..f:fac, Exe('F2'))

listbox(a:1..g:fac, 'Nr.Oper. Fecha Trans. Cliente    Tipo   Especie        Cantidad Trans ')

if (ok)
recorrersel
if (Incluido(Val(d:filaciclo), Exe('CARTA1C')) o Incluido(Val(d:filaciclo), Exe('CARTA1V')))
recorrer&i 1, dialogo.entero1
Linkearhoja('CARTA1', 1, 'nroperacion1', Val(a:filaciclo), 'nroperacion2', Val(g:filaciclo), 'fecha1', Val(b:filaciclo), 'check1', 0, 'radio1', dialogo.radio1)
proximo
else
if (Incluido(Val(d:filaciclo), Exe('CARTA2')))
recorrer&i 1, dialogo.entero1
Linkearhoja('CARTA2', 1, 'nroperacion1', Val(a:filaciclo), 'nroperacion2', Val(g:filaciclo), 'fecha1', Val(b:filaciclo), 'check1', 0, 'radio1', dialogo.radio1)
proximo
else
Messagebox('Carta no definida para la Operacion')
endif
endif
proximo
endif
endif

