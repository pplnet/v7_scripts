sql.add(" Select M.*, C.Comitente Banco FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CUENTAS C ")
sql.add(" WHERE  M.Cuenta = C.Codigo (+)")
sql.add(" AND    M.FechaMov = "~IdxDate2(dialogo.fecha1)~" ")
sql.add(" AND    M.Cantidad >0  ")
sql.add(" AND    M.NrSaldo = 1 ")
sql.add(" AND    (M.Status IS NULL OR M.Status<>'FC' )")

if (NoVacio(dialogo.especie1))
sql.add(" AND M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND M.Cliente = '"~dialogo.vehiculo1~"' ")
endif
if (NoVacio(dialogo.cliente1))
sql.add(" AND C.Comitente = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.cuenta1))
sql.add(" AND M.Cuenta = '"~dialogo.cuenta1~"' ")
endif
sql.add(" ORDER BY M.Cliente, M.Especie, C.Comitente, M.Cuenta ")

Acn(z:1, 0)
recorrer sql
