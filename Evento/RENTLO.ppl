IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF
CrearDialogo
  Fecha1: 'Fecha Desde'          ;1;;;;;;;;FSys
  Fecha2: 'Fecha Hasta'          ;2;;;;;;;;FSys
  Radio1: 'Filtra Book|SI|NO'    ;3;;;;;;;;1;
  Lista1: 'Vehiculos'            ;4;;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Vehiculo1: 'Vehiculo'          ;4;;;;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2: 'Books'                ;5;;;;Dialogo.Radio1=0;NoVacio(Dialogo.Lista2) o Dialogo.Radio1=1;'Debe indicar book/s';NO;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Especie1: 'Especie'            ;;;;;;;
FinDialogo

If Not Ok
    Cancelar
Endif


If Dialogo.Radio1 =1
    let &vehiculo '' 
    If Vacio(Dialogo.Lista1)
        let &vehiculos Val(LS:1)
    Else
        let &vehiculos Dialogo.Lista1
    Endif
    let &books ''
Else
    let &vehiculo Dialogo.Vehiculo1
    let &vehiculos ''
    let &books Dialogo.Lista2
Endif

*****************************************************************************
*Si entra por aca es porque viene de cotizaciones - CINTIA 180823
IF NoVacio(Dialogo.Especie1)
    **Para recálculo de rentabilidad por ingreso de cotizaciones 
    **Se debe verificar a qué combinaciones de VH/BOOK afectan la especie y fecha que se está insertando/modificando de la tabla cotizaciones
    SQL.ADD("Select Distinct Vehiculo1 as 'Vehiculo',Book1 as 'Book' from "~DBO~".OPERACIONES Where Especie= '"~Dialogo.Especie1~"'")
    SQL.ADD(" and FechaOp<= '"~IdxDate(Dialogo.Fecha2)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"'")
    
    SQL.ADD("UNION")
    
    SQL.ADD("Select DISTINCT C.Cliente as 'Vehiculo', CASE When C.Alias1 is not null then C.Alias1 ELSE V.Alias5 END 'Book' ")
    SQL.ADD(" From "~DBO~".SALDOSBANCARIOS S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
    SQL.ADD(" Where S.NrCuenta = C.Numero ")
    SQL.ADD(" AND V.Codigo = C.Cliente ")
    ***VERIFICAR SI ACA HAY QUE CONTEMPLAR TAMBIEN LAS JERARQUIAS ASCENDENTES, EJ SI LA ESPECIE ES UN TITULO Y HAY UNA CUENTA QUE TIENE TITULOS EN EL CAMPO ESPECIES, VA?
    SQL.ADD("AND C.Especies like '%"~Dialogo.Especie1~"%' ")
    SQL.ADD(" AND S.FechaSaldo >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    
    SQL.ADD("UNION")
    
    SQL.ADD("Select DISTINCT C.Cliente as 'Vehiculo', CASE When C.Alias1 is not null then C.Alias1 ELSE V.Alias5 END 'Book' ")
    SQL.ADD(" From "~DBO~".SALDOSDIA S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
    SQL.ADD(" Where S.Cuenta = C.Codigo  and C.TipoCuenta IN ('CUS','INV') ")
    SQL.ADD(" AND S.Especie = '"~Dialogo.Especie1~"' ") 
    SQL.ADD(" AND S.NrSaldo=50 ")
    SQL.ADD(" AND V.Codigo = C.Cliente ")
    SQL.ADD(" AND S.Fecha >='"~IdxDate(Dialogo.Fecha1)~"' ")

    SQL.ADD("UNION")
    
    SQL.ADD(" Select DISTINCT P.Vehiculo as 'Vehiculo', P.Book as 'Book' ")
    SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
    SQL.ADD(" Where E.Codigo = P.Especie ")
    SQL.ADD(" AND P.Especie= '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND P.NrSaldo = 1 ")
    SQL.ADD(" AND P.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    
    SQL.ADD(" Order By Vehiculo,Book")
    Recorrer SQL
        If Not EqStr(fbn['Vehiculo'],&vehiculo)
            *Lo va a ejecutar por VH-Grupo de Books
            If NoVacio(&vehiculo)
                *cada vez que cambia de vh, previamente ejecuta la rentabilidad para el rango de fechas solicitado. Salvo en la primer iteración
                Recorrer&i  Dialogo.Fecha1, Dialogo.Fecha2    
                    If EsHabil(Fecha(&i),'ARG')
                        EjecutarEvento('RENTAB',Fecha1=Fecha(&i), Radio1=0, Vehiculo1=&vehiculo, Lista2=&books, Lista1='')
                    Endif    
                Proximo
            Endif
            **blanqueo la lista de books,seteo el proximo vh y el primer book
            let &books ''
            let &vehiculo fbn['Vehiculo']
            let &books &books~fbn['Book']~'|'
        Else
            let &books &books~fbn['Book']~'|'
        Endif
    Proximo  
Else
****************************************************************************
    Recorrer&i  Dialogo.Fecha1, Dialogo.Fecha2    
        If EsHabil(Fecha(&i),'ARG')
            EjecutarEvento('RENTAB',Fecha1=Fecha(&i), Radio1=0, Vehiculo1=&vehiculo, Lista2=&books, Lista1=&vehiculos)
        Endif    
    Proximo
Endif    