creardialogo
fecha1:'Desde';;;;;;;;;;;;;;;;;
cuenta1:'Cuenta';;;;;;;;;;;;;;;;;;
fecha2:'Hasta';;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

let(&cuenta, dialogo.cuenta1)
let(&nrcuenta, BuscarCampo('Cuentas', 'Numero', 'Codigo', &cuenta))
let(&banco, BuscarCampo('Clientes', 'Alias3', 'Codigo', BuscarCampo('Cuentas', 'Comitente', 'Codigo', &cuenta)))

let(&fechainicio, dialogo.fecha1)
let(&fechalimite, dialogo.fecha2)


recorrer&fecha &fechainicio, &fechalimite
if (EsHabil(&fecha, 'ARG'))
Message('Procesando el '~Fecha(&fecha))
Ejecutarevento('REMUN', 'fecha1', &fecha, 'cuenta1', dialogo.cuenta1)
endif
proximo



