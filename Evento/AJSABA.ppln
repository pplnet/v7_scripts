creardialogo
fecha1:'Fecha';;;;;;;;;;;;;
cuenta1:'Cuenta';;;;;;;;;;;;;
cantidad1:'Ajuste';;;;;;;;;;;;;
nrtrans1:'Nr.Trans.';;;;;;;;;;;;;
radio1:'Tipo:|Ajuste|Contraajuste';;;;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

let(&cuenta, dialogo.cuenta1)
let(&nrcuenta, BuscarCampo('Cuentas', 'Numero', 'Codigo', &cuenta))
let(&banco, BuscarCampo('Clientes', 'Alias3', 'Codigo', BuscarCampo('Cuentas', 'Comitente', 'Codigo', &cuenta)))
let(&fechalimiteaju, Habiles(dialogo.fecha1, 1, 'ARG', SI) - 1)
if (FinDeMes(dialogo.fecha1, SI) > Fecha(&fechalimiteaju))
let(&fechalimproceso, FinDeMes(dialogo.fecha1, SI))
else
let(&fechalimproceso, &fechalimiteaju)
endif

let(ajusteacumulado, 0)

recorrer&i dialogo.fecha1, &fechalimproceso
if (&i <= &fechalimiteaju)
if (dialogo.radio1 = 0)
let(&ajusteacumulado, &ajusteacumulado + dialogo.cantidad1)
else
let(&ajusteacumulado, &ajusteacumulado - dialogo.cantidad1)
endif
endif
Sqladd(" UPDATE "~Dbo()~".SALDOSBANCARIOS Set ")
if (&i <= &fechalimiteaju)
Sqladd(" NrTransAjuste = '"~dialogo.nrtrans1~"',")
if (dialogo.radio1 = 0)
Sqladd("Ajuste = "~FStr(dialogo.cantidad1, 0, 2)~", ")
else
Sqladd("Ajuste = "~FStr(0, 0, 2)~", ")
endif
Sqladd(" SaldoAcuCon = SaldoAcuCon + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoAcuOpe = SaldoAcuOpe + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoAcuIni = SaldoAcuIni + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoConPromedio = Round((SaldoAcuCon + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2), ")
Sqladd(" SaldoOpePromedio = Round((SaldoAcuOpe + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2), ")
Sqladd(" SaldoIniPromedio = Round((SaldoAcuIni + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2) ")
else
Sqladd(" SaldoAcuCon = SaldoAcuCon + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoAcuOpe = SaldoAcuOpe + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoAcuIni = SaldoAcuIni + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~", ")
Sqladd(" SaldoConPromedio = Round((SaldoAcuCon + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2), ")
Sqladd(" SaldoOpePromedio = Round((SaldoAcuOpe + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2), ")
Sqladd(" SaldoIniPromedio = Round((SaldoAcuIni + Ajuste + "~FStr(&ajusteacumulado, 0, 2)~") / DiasAcu, 2) ")
endif
Sqladd(" Where FechaSaldo = '"~IdxDate(&i)~"' ")
Sqladd(" AND Banco = '"~&banco~"' ")
Sqladd(" AND NrCuenta = '"~&nrcuenta~"'")
Sqladd(" AND Estado <> 'ANU' ")
Sqlnew()
Sqlexec()
proximo
