repetir
creardialogo
string1:'Tipo Neg:';1;1;;;;NoVacio(dialogo.string1) y Incluido(dialogo.string1, Var('TIPONEGOCT'));'Debe ingresar Tipo Negociacion valido';NO;;;;;'X'
string3:'Tipo Cot.:';2;1;;;;Incluido(dialogo.string3, Var('TIPOCOTOCT'));'Tipo Cotizacion incorrecto';NO;;;;;'X'
string2:'Especie MAE:';3;1;;Eqstr(dialogo.string3, 'O');Eqstr(dialogo.string3, 'O');NoVacio(dialogo.string2) o (not NoVacio(dialogo.string2) y Eqstr(dialogo.string3, 'F'));'Especie MAE incorrecto';NO;;;;;'XXXXX'
string4:'Metodo:';3;1;;Eqstr(dialogo.string3, 'F');Eqstr(dialogo.string3, 'F');Incluido(dialogo.string4, Var('TIPOMETOCT')) o (not NoVacio(dialogo.string4) y Eqstr(dialogo.string3, 'O'));'Metodo incorecto';NO;;;;;'X'
especie2:'Especie Cot';4;1;;;;NoVacio(dialogo.especie2);'Debe ingresar una especie para Cotizacion';NO;
especie1:'Especie Oper.';5;1;;;;NoVacio(dialogo.especie1);'Debe ingresar una especie para Operaciones';NO;
findialogo
if (not ok)
Cancelar()
endif

Acn(x1, 0)
sql.add("Select 1 from "~Dbo()~".EQUIVALENCIA_ESPECIES ")
sql.add(" where TipoNegociacion = '"~Copy(dialogo.string1, 1, 1)~"' ")
sql.add("   and TipoCotizacion  = '"~Copy(dialogo.string3, 1, 1)~"' ")
if (Eqstr(dialogo.string3, 'O'))
sql.add(" and EspecieOrigen = '"~Copy(dialogo.string2, 1, 5)~"' ")
else
sql.add(" and EspecieOrigen is Null ")
endif
if (Eqstr(dialogo.string3, 'F'))
sql.add(" and Metodo = '"~Copy(dialogo.string4, 1, 1)~"' ")
else
sql.add(" and Metodo is Null ")
endif
recorrer sql
Scn(x1, 1)
proximo
if (Val(x1) > 1)
Cancelar()('Error en tabla de equivalencias. Mas de un registro.')
endif

if (Val(x1) = 1)
sql.add(" Update "~Dbo()~".EQUIVALENCIA_ESPECIES ")
sql.add(" Set EspecieDestino2 = '"~dialogo.especie2~"' ")
sql.add(" , EspecieDestino1 = '"~dialogo.especie1~"' ")
sql.add(" where TipoNegociacion = '"~Copy(dialogo.string1, 1, 3)~"' ")
sql.add("   and TipoCotizacion  = '"~Copy(dialogo.string3, 1, 1)~"' ")
if (Eqstr(dialogo.string3, 'O'))
sql.add(" and EspecieOrigen = '"~Copy(dialogo.string2, 1, 5)~"' ")
else
sql.add(" and EspecieOrigen is Null ")
endif
if (Eqstr(dialogo.string3, 'F'))
sql.add(" and Metodo = '"~Copy(dialogo.string4, 1, 1)~"' ")
else
sql.add(" and Metodo is Null ")
endif
sql.new
sql.exec
endif

if (Val(x1) = 0)
sql.add(" Insert Into "~Dbo()~".EQUIVALENCIA_ESPECIES ( ")
sql.add(" TipoNegociacion, ")
sql.add(" TipoCotizacion, ")
if (Eqstr(dialogo.string3, 'O'))
sql.add(" EspecieOrigen, ")
endif
sql.add(" EspecieDestino1, ")
if (Eqstr(dialogo.string3, 'F'))
sql.add(" Metodo, ")
endif
sql.add(" EspecieDestino2 ")
sql.add(" ) Values ( ")
sql.add(" '"~Copy(dialogo.string1, 1, 3)~"', ")
sql.add(" '"~Copy(dialogo.string3, 1, 1)~"', ")
if (Eqstr(dialogo.string3, 'O'))
sql.add(" '"~Copy(dialogo.string2, 1, 5)~"', ")
endif
sql.add(" '"~dialogo.especie1~"', ")
if (Eqstr(dialogo.string3, 'F'))
sql.add(" '"~Copy(dialogo.string4, 1, 1)~"', ")
endif
sql.add(" '"~dialogo.especie2~"' ")
sql.add(" ) ")
sql.new
sql.exec
endif
proximo

