proximo
if (Val(x1) > 1)
Cancelar('Error en tabla de equivalencias. Mas de un registro.')
endif

if (Val(x1) = 1)
Sqladd(" Update "~Dbo()~".EQUIVALENCIA_ESPECIES ")
Sqladd(" Set EspecieDestino2 = '"~dialogo.especie2~"' ")
Sqladd(" , EspecieDestino1 = '"~dialogo.especie1~"' ")
Sqladd(" where TipoNegociacion = '"~Copy(dialogo.string1, 1, 3)~"' ")
Sqladd("   and TipoCotizacion  = '"~Copy(dialogo.string3, 1, 1)~"' ")
if (Eqstr(dialogo.string3, 'O'))
Sqladd(" and EspecieOrigen = '"~Copy(dialogo.string2, 1, 5)~"' ")
else
Sqladd(" and EspecieOrigen is Null ")
endif
if (Eqstr(dialogo.string3, 'F'))
Sqladd(" and Metodo = '"~Copy(dialogo.string4, 1, 1)~"' ")
else
Sqladd(" and Metodo is Null ")
endif
Sqlnew()
Sqlexec()
endif

if (Val(x1) = 0)
Sqladd(" Insert Into "~Dbo()~".EQUIVALENCIA_ESPECIES ( ")
Sqladd(" TipoNegociacion, ")
Sqladd(" TipoCotizacion, ")
if (Eqstr(dialogo.string3, 'O'))
Sqladd(" EspecieOrigen, ")
endif
