if (Eqstr(dialogo.string3, 'F'))
Sqladd(" Metodo, ")
endif
Sqladd(" EspecieDestino2 ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Copy(dialogo.string1, 1, 3)~"', ")
Sqladd(" '"~Copy(dialogo.string3, 1, 1)~"', ")
if (Eqstr(dialogo.string3, 'O'))
Sqladd(" '"~Copy(dialogo.string2, 1, 5)~"', ")
