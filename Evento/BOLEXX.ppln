linkearhoja(Val(az1), 1, nroperacion1 = dialogo.nroperacion1, string = 'ORIGINAL', radio2 = dialogo.radio2)
if (dialogo.radio1 = 0)
linkearhoja(Val(az1), 1, nroperacion1 = dialogo.nroperacion1, string = 'DUPLICADO', radio2 = dialogo.radio2)
