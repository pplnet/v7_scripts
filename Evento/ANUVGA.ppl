*- REPGAR: REPOSICION de Garantias
CrearDialogo
  Fecha1      : 'Fecha'      ;;;;  ;;;;;Fsys;
  NrOperacion1: 'Operacion'  ;;;;  ;;NoVacio(Dialogo.NrOperacion1) y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'GARANT');'Nr. Operacion incorrecta.';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'GARANT' and IsNull(RB4,'0')='1' ");;;"TipoOp = 'GARANT' and IsNull(RB4,'0')='1' "
  Check1      : 'Procesa'    ;;;;NO;;;;;1;
FinDialogo
If Not Ok
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(y:1, 'Procesa')
ACN(z:1, Dialogo.Check1)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)
ACT(aa:FAC, 'NrOperacion')
ACT(ab:FAC, 'TipoOp')
ACT(ac:FAC, 'MB3')
ACT(ad:FAC, 'Tipo Gar')
ACT(ae:FAC, 'Op Relac.')
ACT(af:FAC, 'FechaOp')
ACT(ag:FAC, 'Especie')
ACT(ah:FAC, 'Cantidad')
ACT(ai:FAC, 'Cot2 (TC)')
ACT(aj:FAC, 'Fecha Liq')
ACT(ak:FAC, 'Cerrada')
ACT(al:FAC, 'Fecha Cierre')
ACT(ap:FAC, 'Cliente')
ACT(aq:FAC, 'Vehiculo')
ACT(ar:FAC, 'Cuenta2')
ACT(as:FAC, 'Cant MovEje')
ACT(at:FAC, 'Error')
ACT(au:FAC, 'Procesada')

ACT(ba:FAC, 'NrOperacion')
ACT(bb:FAC, 'TipoOp')
ACT(bc:FAC, 'Especie')
ACT(bd:FAC, 'Cantidad')
ACT(be:FAC, 'FechaOp')
ACT(bf:FAC, 'FechaVto')
ACT(bg:FAC, 'Vence Hoy')

ACT(ca:FAC, 'NrOperacion')
ACT(cb:FAC, 'Fecha')
ACT(cc:FAC, 'Cliente')
ACT(cd:FAC, 'Especie')
ACT(ce:FAC, 'NrSaldo')
ACT(cf:FAC, 'Saldo')

SetFont(aa:FAC..cz:FAC, 2)

SQL.ADD("SELECT * ")
SQL.ADD("  FROM "~DBO~".OPERACIONES ")
SQL.ADD(" Where TipoOp = 'GARANT' ")
SQL.ADD(" and NrOperacion ='"~Dialogo.NrOperacion1~"'  ")
Recorrer SQL
  SCN(x:1,1)
  ACT(aa:FAC, FBN['NrOperacion'])
  ACT(ab:FAC, FBN['TipoOp'])
  ACN(ac:FAC, FBN['MB3'])
  ACT(ad:FAC, iif(FBN['MB3']=0,'Entregada','Recibida'))
  ACT(ae:FAC, FBN['OperacionRef'])
  ACD(af:FAC, FBN['FechaOp'])
  ACT(ag:FAC, FBN['ContraEspecie'])
  ACN(ah:FAC, FBN['Cantidad'])
  ACN(ai:FAC, FBN['Cotizacion2'])
  ACD(aj:FAC, FBN['FechaVto'])
  ACN(ak:FAC, FBN['RB4'])
  ACD(al:FAC, FBN['FechaVto2'])
  ACT(ap:FAC, FBN['Cliente1'])
  ACT(aq:FAC, FBN['Vehiculo1'])
  ACT(ar:FAC, FBN['Cuenta2'])

  if Val(ak:FAC)=0
    MessageBox('La Garantia no esta Cerrada.')
    ACN(at:FAC, 1)
  endif

  if Val(at:FAC)=0
    if Val(al:FAC)<>Dialogo.Fecha1
      MessageBox('La Garantia esta cerrada en una fecha distinta a la ingresada en el dialogo. Fecha Cierre: '~IdxDate(Val(al:FAC)))
      ACN(at:FAC, 1)
    endif
  endif

  if Not Incluido(Val(m:Val(h:&i)),Var('VLIQUIDAA'))
    ACN(as:FAC, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrSaldo = 1 and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' and NrMov >= 90 "))
  endif
  if Val(as:FAC)>0
    MessageBox('La Garantia tiene los movimientos del cierre liquidados.')
    ACN(at:FAC, 1)
  endif

  if Val(at:FAC)=0
    if Val(z:1)=1
      SQL.ADD("UPDATE "~DBO~".OPERACIONES SET FechaVto2 = Null, ")
      SQL.ADD("                               RB4 = '0' ")
      SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.NEW

      SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrSaldo     in (1,201) ")
      SQL.ADD("   and NrMov       >= 90 ")
      SQL.ADD("   and FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.NEW

      SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrSaldo     in (1,201) ")
      SQL.ADD("   and NrMov       >= 90 ")
      SQL.ADD("   and FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.NEW

      SQL.EXEC
    endif

    ACT(au:FAC, 'SI')
  endif
Proximo

if Val(x:1)=0
  MessageBox('Operacion No encontrada.')
endif
