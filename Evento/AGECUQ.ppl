    Cantidad3: 'Tasa:'           ;8;1;5;   ;;if(dialogo.Entero25 > 0 O DIALOGO.Radio5 = 4, dialogo.cantidad3 > 0, SI);'Debe ingresar una tasa';NO;;;;;'###,###,###.#####';;;
  FinDialogo
  If not OK
    Cancelar
  endif

  ACN(fe:1, Dialogo.Fecha1)
  ACN(fe:2, Dialogo.Fecha2)

  ACT(pp:1,SQL("SELECT 1 FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' "))

  If val(fe:1) = 0
    Cancelar('Se cancela la acción, falta completar Fecha de Emision de la especie')
  endif 
  If val(fe:2) = 0
    Cancelar('Se cancela la acción, falta completar Fecha de Maduración de la especie')
  endif 

  If ((CantDias(dialogo.fecha3, dialogo.fecha4, dialogo.cantidad1, dialogo.check2, dialogo.entero9 , dialogo.entero10, dialogo.entero11, dialogo.entero12, dialogo.entero13, dialogo.entero14, dialogo.entero15, dialogo.entero16,dialogo.TablaFeriados1, dialogo.Radio1) * dialogo.cantidad1) > 100)
    If (Messagebox("El porcentaje de amortizacion supera el 100%", 1, 1) = 2)
      Cancelar
    Endif
  Endif

  *GenerarCupon   (especie         ,fechaDesde     , fechaHasta    , tasa             , todosLosMeses , dia1            , dia2            , dia3            , dia4            , mes1            , mes2            , mes3            , mes4            , tipoCupon)
  If dialogo.cantidad > 0
    AgregarCupon(dialogo.Especie1, dialogo.fecha1, dialogo.fecha2, dialogo.cantidad , dialogo.check1, dialogo.entero1 , dialogo.entero2 , dialogo.entero3 , dialogo.entero4 , dialogo.entero5 , dialogo.entero6 , dialogo.entero7 , dialogo.entero8 , 1, dialogo.TablaFeriados1, dialogo.Radio1)
  Endif    

  If dialogo.cantidad1 > 0    
    AgregarCupon(dialogo.Especie1, dialogo.fecha3, dialogo.fecha4, dialogo.cantidad1, dialogo.check2, dialogo.entero9 , dialogo.entero10, dialogo.entero11, dialogo.entero12, dialogo.entero13, dialogo.entero14, dialogo.entero15, dialogo.entero16, 2, dialogo.TablaFeriados1, dialogo.Radio1)
  Endif

  If dialogo.cantidad2 > 0  
    AgregarCupon(dialogo.Especie1, dialogo.fecha5, dialogo.fecha6, dialogo.cantidad2, dialogo.check3, dialogo.entero17, dialogo.entero18, dialogo.entero19, dialogo.entero20, dialogo.entero21, dialogo.entero22, dialogo.entero23, dialogo.entero24, 3, dialogo.TablaFeriados1, dialogo.Radio1)
  Endif    

  If dialogo.cantidad3 > 0  
    AgregarCupon(dialogo.Especie1, dialogo.fecha7, dialogo.fecha8, dialogo.cantidad3, dialogo.check4, dialogo.entero25, dialogo.entero26, dialogo.entero27, dialogo.entero28, dialogo.entero29, dialogo.entero30, dialogo.entero31, dialogo.entero32, 4, dialogo.TablaFeriados1, dialogo.Radio1)
  Endif    

  If dialogo.cantidad > 0 O dialogo.cantidad1 > 0 O dialogo.cantidad2 > 0  O dialogo.cantidad3 > 0
    ProcesarAgendaCupon(Dialogo.Entero33)
    EjecutarEvento('CALREN',Especie1=Dialogo.Especie1,Check1=1)
    Messagebox('Los cupones fueron creados correctamente!')
  else
    Cancelar('No se completó ningún dato. Se cancela.')
  Endif
endif
