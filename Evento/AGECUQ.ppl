Repetir
  CrearDialogo:1,'General'
  ************GENERAL************
    Especie1:       'Especie:'        ;1;1;1;;;NoVacio(dialogo.Especie1);'Debe ingresar una Especie';NO;Val(a:1)
    String1:        'Zero Cupon:'     ;1;2;1;NO;EqStr(Dialogo.String1,'SI');;;;Val(a:2);BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1);;;'XX'
    Radio1:         'Feriados:|Fijo|Habil Anterior|Habil Siguiente';2;1;1;;;;;;Val(a:3)
    TablaFeriados1: 'Tabla Feriados:' ;3;1;1;Dialogo.Radio1 > 0;Dialogo.Radio1 > 0;IF(dialogo.Radio1 > 0,NoVacio(dialogo.TablaFeriados1),SI);'Debe ingresar Tabla Feriados';NO;Val(a:4)
    Entero33:       'Nro. Cupon'      ;4;1;1;Not EqStr(Dialogo.String1,'SI');;Dialogo.Entero33 > 0 o EqStr(Dialogo.String1,'SI');'Debe ingresar un número de cupón';NO;Val(a:5);if(EqStr(Dialogo.String1,'SI'),0,Dialogo.Entero33)
  FinDialogo
  If not OK
    Cancelar
  endif

  ACT(a:1, Dialogo.Especie1)
  ACT(a:2, Dialogo.String1)
  ACN(a:3, Dialogo.Radio1)
  ACT(a:4, Dialogo.TablaFeriados1)
  ACN(a:5, Dialogo.Entero33)

  ACT(pp:1,SQL("SELECT 1 FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' "))
  If incluido(val(pp:1),'1')
    MessageBox('Ya se genero el cupon de esta especie. Se cancela la accion!')
  else
    Break
  Endif
