creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Transacciones';1;2;;;;;;;;;;;;;'NrTrans';'NrTrans;Cliente1;TipoTr2,Especie;Fecha1';'TRANSACCIONES2'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;
findialogo

if (not ok)
raise('Evento Cancelado')
endif

Message('--- Asientos Transferencia de Carteras ---')

Act(me:1, Var('MONEEXTR'))
Act(ml:1, Var('MONELOCA'))
Acn(sl:1, Var('SALDOPOCON'))
Act(vc:1, dialogo.vehiculo1)
Acd(fe:1, Habiles(FSys(), -Var('FVALORCONT'), 'ARG'))
Acn(na:1, Var('ASINUM'))

sql.add(" Select T.Especie, T.NrTrans, CASE WHEN MA.Codigo <> 'TRPOTI' THEN T.TipoTr2 ELSE 'TIC' END AS TipoOp, T.Vehiculo1, MA.Codigo CodAsi, T.Cantidad3 , T.Book1, E.MonedaEmision, ")
sql.add(" E.Indexado, E.Jerarquia, T.Fecha1 FechaOp, T.Fecha1, T.Precio3, T.Cantidad1 Cantidad, T.Especie1 ContraEspecie, ")
sql.add(" T.Cantidad2 TotalBrutoCli1, T.Precio4 TCARP, T.Book2,E.EntidadEmisora, T.Precio2, T.Cupon1, T.RB6, T.Cliente1 Cliente, ")
sql.add(" E.Tipo TipoEspecie, T.Cuenta1 as CuentaCustodia, '' as Concepto, T.Cliente1, E.Issuer  ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ESPECIES E ")
sql.add(" Where T.TipoTr2 = 'TRPOS' ")
sql.add(" AND T.TipoTr2 = MA.TipoTr2 ")
sql.add(" AND E.Codigo = T.Especie ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASITRAN'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
if (dialogo.radio1 = 4)
sql.add(" AND (T.RB6 = 0 OR T.RB6 = 1) ")
else
if (dialogo.radio1 = 0)
sql.add(" AND T.RB6 = 0 ")
else
if (dialogo.radio1 = 1)
sql.add(" AND T.RB6 = 1 ")
endif
endif
endif
sql.add(" AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
if (NoVacio(dialogo.listatabla1))
sql.add(" AND T.NrTrans IN ("~pipe2comillas(dialogo.listatabla1)~") ")
endif
sql.add(" ORDER By T.NrTrans, MA.Codigo ")
Watch(sql.batch)

recorrer sql
Act(vh:1, Fbn('Vehiculo1'))
Acd(fv:1, Fbn('Fecha1'))
Acn(rv:1, Val(rr:1))
Acd(fo:1, Fbn('Fecha1'))
Act(bk:1, Fbn('Book2'))
Act(em:1, Fbn('MonedaEmision'))
Act(ix:1, Fbn('Indexado'))
Act(es:1, Fbn('Especie'))
Act(cu:1, Fbn('Cupon1'))
Acd(fe:88, Val(fv:1) - 1)
Acn(pp:99, Fbn('Precio2'))
Act(bk:1, Fbn('Book1'))
Act(bk:2, Fbn('Book2'))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrTrans2 = '"~Fbn('NrTrans')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message(Fbn('NrTrans')~'  - Modelo: '~Fbn('CodAsi'))
sql.generarasientoop(Fbn('CodAsi'), '', '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, Fbn('NrTrans'), null, null, null, null, FSys(), dialogo.fecha1)
sql.exec
endif
proximo
