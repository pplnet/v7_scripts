sql.add("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, ")
sql.add("S.NrSaldo, C.RazonSocial, S.CallPut, S.FechaEj, ")
sql.add("S.PrecioEj,C.RecibePreaviso,S.Saldo, ")
sql.add("C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.MonedaEmision Cotiza, ")
sql.add("E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
sql.add("E.DiasAnio, E.DiasMes ")
sql.add("FROM "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E ")
sql.add("WHERE S.Cliente = C.Codigo ")
sql.add(" AND  S.Especie = '"~Val(ec:1)~"' ")
sql.add(" and  S.Cupon   = '"~Val(x3)~"'   ")
sql.add(" AND  S.Especie = E.Codigo ")
sql.add(" and  S.Saldo  <> 0 ")
if (dialogo.radio1 = 0)
sql.add("and (NrSaldo NOT IN ("~pipe2comillas(Val(dz6))~") AND NrSaldo NOT IN ("~pipe2comillas(Var('BLOQGARA'))~") ) ")
else
if (dialogo.radio1 = 1)
sql.add("and NrSaldo IN ("~pipe2comillas(Val(dz6))~") ")
else
sql.add("and NrSaldo IN ("~pipe2comillas(Var('BLOQGARA'))~") ")
endif
endif
if (NoVacio(Val(aa13)))
sql.add("AND S.Cliente in ("~pipe2comillas(Val(aa13))~") ")
endif
if (NoVacio(Val(aa15)))
sql.add("AND S.Mercado='"~dialogo.mercado1~"' ")
endif
sql.add("AND S.Fecha=( SELECT Max(S1.Fecha) FROM "~Dbo()~".SALDOSDIA S1 ")
sql.add("              WHERE S1.Cliente = S.Cliente ")
sql.add("              AND   S1.Especie = S.Especie ")
sql.add("              AND   S1.Mercado = S.Mercado ")
sql.add("              AND   S1.Cupon   = S.Cupon   ")
sql.add("              AND   S1.EnteCustodia = S.EnteCustodia ")
sql.add("              AND   S1.NrSaldo = S.NrSaldo  ")
sql.add("              AND   S1.Cuenta  = S.Cuenta   ")
sql.add("              AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null) or (S1.CallPut='' and S.CallPut='')) ")
sql.add("              AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null) or (S1.FechaEj='' and S.FechaEj='')) ")
sql.add("              AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null) or (S1.PrecioEj='' and S.PrecioEj='')) ")
sql.add("              AND   S1.Fecha <= '"~IdxDate(Val(x5))~"' ) ")
sql.add("ORDER BY S.NrSaldo, S.Cliente, S.Especie, S.CallPut, S.FechaEj, S.PrecioEj, S.EnteCustodia, S.Mercado, S.Cuenta")

