Sqladd("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, ")
Sqladd("S.NrSaldo, C.RazonSocial, S.CallPut, S.FechaEj, ")
Sqladd("S.PrecioEj,C.RecibePreaviso,S.Saldo, ")
Sqladd("C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.MonedaEmision Cotiza, ")
Sqladd("E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
Sqladd("E.DiasAnio, E.DiasMes ")
Sqladd("FROM "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E ")
Sqladd("WHERE S.Cliente = C.Codigo ")
Sqladd(" AND  S.Especie = '"~Val(ec:1)~"' ")
Sqladd(" and  S.Cupon   = '"~Val(x3)~"'   ")
Sqladd(" AND  S.Especie = E.Codigo ")
Sqladd(" and  S.Saldo  <> 0 ")
if (dialogo.radio1 = 0)
Sqladd("and (NrSaldo NOT IN ("~Pipe2Comillas(Val(dz6))~") AND NrSaldo NOT IN ("~Pipe2Comillas(Var('BLOQGARA'))~") ) ")
else 
if (dialogo.radio1 = 1)
Sqladd("and NrSaldo IN ("~Pipe2Comillas(Val(dz6))~") ")
else 
Sqladd("and NrSaldo IN ("~Pipe2Comillas(Var('BLOQGARA'))~") ")
endif
endif
if (NoVacio(Val(aa13)))
Sqladd("AND S.Cliente in ("~Pipe2Comillas(Val(aa13))~") ")
endif
if (NoVacio(Val(aa15)))
Sqladd("AND S.Mercado='"~dialogo.mercado1~"' ")
endif
Sqladd("AND S.Fecha=( SELECT Max(S1.Fecha) FROM "~Dbo()~".SALDOSDIA S1 ")
Sqladd("              WHERE S1.Cliente = S.Cliente ")
Sqladd("              AND   S1.Especie = S.Especie ")
Sqladd("              AND   S1.Mercado = S.Mercado ")
Sqladd("              AND   S1.Cupon   = S.Cupon   ")
Sqladd("              AND   S1.EnteCustodia = S.EnteCustodia ")
Sqladd("              AND   S1.NrSaldo = S.NrSaldo  ")
Sqladd("              AND   S1.Cuenta  = S.Cuenta   ")
Sqladd("              AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null) or (S1.CallPut='' and S.CallPut='')) ")
Sqladd("              AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null) or (S1.FechaEj='' and S.FechaEj='')) ")
Sqladd("              AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null) or (S1.PrecioEj='' and S.PrecioEj='')) ")
Sqladd("              AND   S1.Fecha <= '"~IdxDate(Val(x5))~"' ) ")
Sqladd("ORDER BY S.NrSaldo, S.Cliente, S.Especie, S.CallPut, S.FechaEj, S.PrecioEj, S.EnteCustodia, S.Mercado, S.Cuenta")

