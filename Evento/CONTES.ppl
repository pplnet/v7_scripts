CrearDialogo
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

SQL.ADD(" Select NrOperacion, FechaOp, Vehiculo1, TipoOp From "~DBO~".OPERACIONES ")
Recorrer SQL
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(fbn('FechaOp'))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF

    IF Val(CK:1) = 0
        message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,fbn('FechaOp'),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
