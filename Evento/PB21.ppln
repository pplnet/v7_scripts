MostrarCuadroDeMensajes()
creardialogo
vehiculo1: 'Vehiculo';1;1;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO', 'Vehiculo', 'Codigo', UsuarioActivo());;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
nrtrans1:'Transaccion';;;;;;NoVacio(dialogo.nrtrans1);'Transaccion Invalida';NO;;

findialogo

if (not ok)
Cancelar()
endif

if (not Eqstr(Query(" Select Estado From "~Dbo()~".CHEQUES Where NrComprobante = '"~dialogo.nrtrans1~"' "), 'PAG'))
Cancelar('La transaccion no tiene cheques pagados.')
endif

Sqladd(" UPDATE "~Dbo()~".CHEQUES ")
Sqladd(" SET    Estado = 'ANU' ")
Sqladd(" Where  NrComprobante = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where  NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND    NrBit       = 20 ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where  NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND NrBit= 25 ")
Sqlnew()

Message('La transaccion pasa a la instancia ANULADAS.')

Sqladd(" INSERT INTO "~Dbo()~".MOVPENDIENTES ")
Sqladd(" SELECT * FROM "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqlnew()

Sqladd(" DELETE FROM "~Dbo()~".MOVEJECUTADOS ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nrtrans1~"' ")
Sqlnew()
Message('Los saldos se han desafectado.')

Sqlexec()


