let &MaxJerarquia Query("SELECT Max(Jerarquia) FROM "~DBO~".CLIENTES WHERE dbo.DesciendeDeCliente(Codigo,'VINCULADOS') = 1")

#ifdef BFSA
    IF &MaxJerarquia = NULL
        let &MaxJerarquia Query("SELECT Max(Jerarquia) FROM "~DBO~".CLIENTES")
        let &JerarquiaMaxima Int(Copy(&MaxJerarquia,1,3))+1
    ENDIF
#else    
    let &JerarquiaMaxima Int(Copy(&MaxJerarquia,4,3))+1
#endif

SQL.ADD(" SELECT Codigo, Descripcion ")
SQL.ADD(" FROM "~DBO~".VEHICULOS ")
SQL.ADD(" WHERE Codigo Not in (SELECT Codigo FROM "~DBO~".CLIENTES) ")
SQL.ADD(" ORDER BY Codigo ")
Recorrer SQL
    let &Codigo fbn('Codigo')
    let &RazonSocial fbn('Descripcion')
    #ifdef BFSA
        IF &JerarquiaMaxima > 99
            let &Jerarquia Fstr(&JerarquiaMaxima,0,0)~'000000000000'
        ELSE
            IF &JerarquiaMaxima > 9
                let &Jerarquia '0'~Fstr(&JerarquiaMaxima,0,0)~'00000000000'
            ELSE
                let &Jerarquia '00'~Fstr(&JerarquiaMaxima,0,0)~'00000000000'
            ENDIF
        ENDIF
    #else
        IF &JerarquiaMaxima < 10
            let &Jerarquia '00300'~Fstr(&JerarquiaMaxima,0,0)~'000000000'
        ELSE
            IF &JerarquiaMaxima < 100
                let &Jerarquia '0030'~Fstr(&JerarquiaMaxima,0,0)~'000000000'
            ELSE
                let &Jerarquia '003'~Fstr(&JerarquiaMaxima,0,0)~'000000000'
            ENDIF
        ENDIF
    #endif
        
    SQL.ADD(" INSERT INTO "~DBO~".CLIENTES ")
    SQL.ADD(" (Jerarquia,Codigo,RazonSocial,Status) ")
    SQL.ADD(" VALUES ")
    SQL.ADD(" ('"~&Jerarquia~"','"~&Codigo~"','"~&RazonSocial~"','HAB') ")
    SQL.NEW
    SQL.EXEC
    let &JerarquiaMaxima &JerarquiaMaxima+1
Proximo