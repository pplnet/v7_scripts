sql.add("Select ORD.NrOrden, OP.NrOperacion ")
sql.add("  From "~Dbo()~".ORDENES ORD ")
sql.add("    LEFT JOIN "~Dbo()~".OPERACIONES OP")
sql.add("       on ORD.NrOperacion2 = OP.NrOperacion ")
sql.add("Where ORD.NrOrden = '"~dialogo.nrorden1~"' ")
sql.add("  and  ORD.CB7 = 1 ")
sql.add("  and  (   ((OP.NrOperacion is null or OP.NrOperacion = '') ")
sql.add("             and ORD.Cantidad1 >="~FStr(Val(t:1), 0, 2)~" )")
sql.add("        Or  (Not(OP.NrOperacion is null or OP.NrOperacion = '')")
sql.add("             and not Exists(SELECT 1 FROM "~Dbo()~".MovEjecutados ME ")
sql.add("                            WHERE ME.NrOperacion = ORD.NrOperacion2  )")
sql.add("             and OP.Cantidad="~FStr(Val(t:1), 0, 2)~")        )")

