SQL.ADD("Select O.NrOperacion, O.Impresa, O.RB3 from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B where B.NrBit=6 and B.Valor='1' and O.NrOperacion=B.NrOperacion")
recorrer SQL
  message(fbn('NrOperacion'))
  ACN(z1, fbn('Impresa'))
  ACT(z3, fbn('RB3'))
  ACN(z2, Num(Val(z3)))
  SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='0' where NrOperacion='"~fbn('NrOperacion')~"' and NrBit=6")
  SQL.NEW

  if EqStr(Val(z1),'1')
     SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion='"~fbn('NrOperacion')~"' and NrBit=11")
  else
     SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion='"~fbn('NrOperacion')~"' and NrBit=10")
  endif
  SQL.NEW
proximo
SQL.EXEC
