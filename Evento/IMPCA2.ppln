Sqladd("Select T.* from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O ")
Sqladd("where  T.NrTrans = O.NrOperacion ")
Sqladd(" and   O.NrBit = 2 and O.Valor ='1' ")
Sqladd(" and   T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and   T.TipoTr2 In ('RET','DEP') ")
Sqladd(" and  T.Cuenta2 Is Not Null ")
if (NoVacio(Val(zz6)))
Sqladd("      and T.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
Sqladd(" order by T.NrOperacionRef1, T.NrTrans ")

recorrer sql
