MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha:';;;;;;NoVacio(dialogo.fecha1);'Fecha Invalida';NO;FSys()
findialogo
if (not ok)
Cancelar()
endif

SetFilaActual(0)
Act(me:1, Var('MERCOCT'))

Sqladd(" Select NrTrans ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T1 ")
Sqladd(" Where T1.Fecha1   = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND T1.TipoTr2 In ('FXDEP','FXRET') ")
Sqladd("   AND T1.CB10     = '1' ")
Sqladd("   AND T1.Mercado1 = '"~Val(me:1)~"' ")
Sqladd("   AND (T1.CB3 = '0' or T1.CB3 is Null) ")
Sqladd("   AND (T1.CB9 = '0' or T1.CB9 is Null) ")
Sqladd(" Order By NrTrans ")

recorrer sql
Message(Fbn('NrTrans'))
Ejecutarevento('ANUVO5', 'nrtrans1', Fbn('NrTrans'))
proximo

