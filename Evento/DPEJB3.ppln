Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DPBOS|'))
Cancelar('La operacion No '~dialogo.nroperacion1~' No es un Barrier Option Simple')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

Acd(d1, Query("Select Fecha2 FROM "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota=(Select Max(NrCuota) FROM "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"') "))

Message(Val(d1))

if (Vacio(Val(d1)))
Acd(d1, BuscarCampo('Operaciones', 'FechaPago', 'NrOperacion', dialogo.nroperacion1))
Message(Val(d1)~' Operaciones Simple ')
endif




if (NoVacio(IdxDate(Val(d1))) y dialogo.fecha1 > Val(d1))
Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
endif

if (ok)
Acn(x1, 0)

Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and ((TipoOpcion='0' and FechaEj = '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(dialogo.fecha1)~"')) ")


recorrer sql
Acn(x1, 1)

if ((dialogo.radio2 = 0 y dialogo.precio2 >= dialogo.precio3) o (dialogo.radio2 = 1 y dialogo.precio2 <= dialogo.precio3))

if (not EsHabil(dialogo.fecha2, Fbn()['TablaFeriados1']))
Messagebox('La Fecha de Liquidacion Final NO ES Doa Habil en la Tabla de Feriados '~Fbn()['TablaFeriados1'])
break
endif

if (dialogo.radio2 = 0)
if (Eqstr(Fbn()['MB4'], '3'))
if (dialogo.precio2 >= dialogo.precio4)
Acn(z3, (dialogo.precio2 - Fbn()['PrecioEj']))
endif
endif

if (Eqstr(Fbn()['MB4'], '2'))
if (dialogo.precio2 <= dialogo.precio4)
Acn(z3, (dialogo.precio2 - Fbn()['PrecioEj']))
endif
endif

if (Eqstr(Fbn()['MB4'], '1'))
if (dialogo.precio2 <= dialogo.precio4)
Acn(z3, (dialogo.precio2 - Fbn()['PrecioEj']))
endif
endif

if (Eqstr(Fbn()['MB4'], '0'))
if (dialogo.precio2 >= dialogo.precio4)
Acn(z3, (dialogo.precio2 - Fbn()['PrecioEj']))
endif
endif
else
if (Eqstr(Fbn()['MB4'], '3'))
if (dialogo.precio2 >= dialogo.precio4)
Acn(z3, (Fbn()['PrecioEj'] - dialogo.precio2))
endif
endif

if (Eqstr(Fbn()['MB4'], '2'))
if (dialogo.precio2 <= dialogo.precio4)
Acn(z3, (Fbn()['PrecioEj'] - dialogo.precio2))
endif
endif

if (Eqstr(Fbn()['MB4'], '1'))
if (dialogo.precio2 <= dialogo.precio4)
Acn(z3, (Fbn()['PrecioEj'] - dialogo.precio2))
endif
endif

if (Eqstr(Fbn()['MB4'], '0'))
if (dialogo.precio2 >= dialogo.precio4)
Acn(z3, (Fbn()['PrecioEj'] - dialogo.precio2))
endif
endif
endif

if (dialogo.radio3 = 1)
Acn(z3, -Val(z3))
endif

Acn(z2, Val(z3) * Fbn()['Cantidad'])

Message('Actualizando la Opcion  .... ')

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set CB8 = '1', ")
Sqladd("FechaPago = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("Precio2   = "~FStr(dialogo.precio2, 0, 7)~", ")
Sqladd("Precio3   = "~FStr(Val(z3), 0, 2)~", ")
Sqladd("Precio4   = "~FStr(Val(z2), 0, 2)~"  ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()


Sqlactualizarmovimientos(dialogo.nroperacion1, SI)
Sqlexec()

else
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set CB8 = '-1', ")
Sqladd("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("Precio2   = "~FStr(dialogo.precio2, 0, 7)~" ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
