Sqladd("SELECT R.*, ")
Sqladd("       C.Precio1 PrecioCotiz, E.Alias4, E.Tipo, E.Cotiza ")
Sqladd("FROM "~Dbo()~".POSICIONES R, "~Dbo()~".ESPECIES E, "~Dbo()~".COTIZACIONES C ")
Sqladd("WHERE R.TipoNegocio  = 'T' AND ")
Sqladd("      R.CantidadFin  <> 0 AND ")
Sqladd("      R.PrecioEj     IS NULL AND ")
Sqladd("      R.Especie      = E.Codigo AND ")
Sqladd("      R.Especie      = C.Codigo AND ")
Sqladd("      C.Fecha        = '"~IdxDate(Val(d1))~"' AND ")
Sqladd("      C.CallPut      = 'CON' AND ")
Sqladd("    ((R.PrecioReset  IS NULL) OR ")
Sqladd("     (R.PrecioReset  IS NOT NULL AND R.PrecioReset <> C.Precio1)) AND ")
if (NoVacio(dialogo.especie1))
Sqladd("   R.Especie      = '"~dialogo.especie1~"' AND ")
endif
Sqladd("      R.Fecha = (SELECT MAX(R1.Fecha) ")
Sqladd("                   FROM "~Dbo()~".POSICIONES R1 ")
Sqladd("                  WHERE R1.Vehiculo    = R.Vehiculo AND ")
Sqladd("                        R1.TipoNegocio = R.TipoNegocio AND ")
Sqladd("                        R1.Cliente     = R.Cliente AND ")
Sqladd("                        R1.Especie     = R.Especie AND ")
Sqladd("                        R1.Cupon       = R.Cupon AND ")
Sqladd("                        R1.PrecioEj   IS NULL AND ")
Sqladd("                        R1.NrSaldo     = R.NrSaldo AND ")
Sqladd("                        R1.Book        = R.Book AND ")
Sqladd("                        R1.Fecha      <= '"~IdxDate(Val(d1))~"') ")
Sqladd("ORDER BY R.Especie, R.Cupon, R.NrSaldo, R.Book ")

recorrer sql
if (Fbn()['Fecha'] = Val(d1))
Sqladd("UPDATE "~Dbo()~".POSICIONES ")
Sqladd("SET   PrecioReset = "~FStr(Fbn()['PrecioCotiz'], 0, 8)~" ")
Sqladd("WHERE Vehiculo    = '"~Fbn()['Vehiculo']~"' AND ")
Sqladd("      TipoNegocio = '"~Fbn()['TipoNegocio']~"' AND ")
Sqladd("      Cliente     = '"~Fbn()['Cliente']~"' AND ")
Sqladd("      Especie     = '"~Fbn()['Especie']~"' AND ")
Sqladd("      Cupon       = '"~Fbn()['Cupon']~"' AND ")
if (NoVacio(Fbn()['FechaEj']))
Sqladd("   FechaEj     = "~IdxDate2(Fbn()['FechaEj'])~" AND ")
endif
if (NoVacio(Fbn()['PrecioEj']))
Sqladd("   PrecioEj    = "~Fbn()['PrecioEj']~" AND ")
endif
Sqladd("      NrSaldo     = "~FStr(Fbn()['NrSaldo'], 0, 0)~" AND ")
Sqladd("      Book        = '"~Fbn()['Book']~"' AND ")
Sqladd("      Fecha       = '"~IdxDate(Val(d1))~"' AND ")
Sqladd("      IsNull(Unidad,'') = '"~Fbn()['Unidad']~"' AND ")
Sqladd("      IsNull(Centro,'') = '"~Fbn()['Centro']~"' AND ")
Sqladd("      IsNull(Sector,'') = '"~Fbn()['Sector']~"' AND ")
Sqladd("      IsNull(Sucursal,'') = '"~Fbn()['Sucursal']~"' AND ")
Sqladd("      IsNull(CallPut,'') = '"~Fbn()['CallPut']~"' AND ")
Sqladd("      IsNull(Estrategia,'') = '"~Fbn()['Estrategia']~"' AND ")
Sqladd("      IsNull(Cartera,'') = '"~Fbn()['Cartera']~"' AND ")
Sqladd("      IsNull(Trader,'') = '"~Fbn()['Trader']~"' AND ")
Sqladd("      IsNull(Responsable,'') = '"~Fbn()['Responsable']~"' AND ")
Sqladd("      IsNull(TipoPosicion,'') = '"~Fbn()['TipoPosicion']~"' AND ")
Sqladd("      IsNull(Producto,'') = '"~Fbn()['Producto']~"' AND ")
Sqladd("      IsNull(GrupoEspecie,'') = '"~Fbn()['GrupoEspecie']~"' AND ")
Sqladd("      IsNull(CarteraBCRA,'') = '"~Fbn()['CarteraBCRA']~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT "~Dbo()~".POSICIONES ( ")
Sqladd("Fecha, Cliente, Vehiculo, Unidad, Centro, ")
Sqladd("Sector, Sucursal, NrSaldo, Especie, PrecioEj, ")
Sqladd("FechaEj, CallPut, Precio1, Precio2, ValorUSD, ")
Sqladd("ValorARP, Estrategia, Cartera, Book, Trader, ")
Sqladd("TipoNegocio, Cantidad1, Cantidad2, Cantidad3, Cantidad4, ")
Sqladd("Cantidad5, Precio3, Precio4, Precio5, CantidadIni, ")
Sqladd("PrecioIni, CantidadFin, PrecioFin, Cupon, Responsable, ")
Sqladd("TipoPosicion, Producto, GrupoEspecie, CarteraBCRA, ")
Sqladd("PrecioHist, PrecioReset) ")
Sqladd("Values ( ")
Sqladd("'"~IdxDate(Val(d1))~"', '"~Fbn()['Cliente']~"', '"~Fbn()['Vehiculo']~"', '"~Fbn()['Unidad']~"', '"~Fbn()['Centro']~"', ")
Sqladd("   '"~Fbn()['Sector']~"', '"~Fbn()['Sucursal']~"', "~FStr(Fbn()['NrSaldo'], 0, 0)~", '"~Fbn()['Especie']~"', ")
if (Val(j:fac) = 0)
Sqladd("NULL, ")
else
Sqladd(""~FStr(Fbn()['PrecioEj'], 15, 8)~", ")
endif
if (Vacio(Fbn()['FechaEj']))
Sqladd("NULL, ")
else
Sqladd("'"~IdxDate(Fbn('FechaEj'))~"', ")
endif
Sqladd("   '"~Fbn()['CallPut']~"', "~FStr(Fbn()['Precio1'], 0, 10)~", "~FStr(Fbn()['Precio2'], 0, 10)~", "~FStr(Fbn()['ValorUSD'], 0, 10)~", ")
Sqladd("   "~FStr(Fbn()['ValorARP'], 0, 10)~", '"~Fbn()['Estrategia']~"', '"~Fbn()['Cartera']~"', '"~Fbn()['Book']~"', '"~Fbn()['Trader']~"', ")
Sqladd("   '"~Fbn()['TipoNegocio']~"', "~FStr(Fbn()['Cantidad1'], 0, 10)~", "~FStr(Fbn()['Cantidad2'], 0, 10)~", "~FStr(Fbn()['Cantidad3'], 0, 10)~", "~FStr(Fbn()['Cantidad4'], 0, 10)~", ")
Sqladd("   "~FStr(Fbn()['Cantidad5'], 0, 10)~", "~FStr(Fbn()['Precio3'], 0, 10)~", "~FStr(Fbn()['Precio4'], 0, 10)~", "~FStr(Fbn()['Precio5'], 0, 10)~", "~FStr(Fbn()['CantidadIni'], 0, 10)~", ")
Sqladd("   "~FStr(Fbn()['PrecioIni'], 0, 10)~", "~FStr(Fbn()['CantidadFin'], 0, 10)~", "~FStr(Fbn()['PrecioFin'], 0, 10)~", '"~Fbn()['Cupon']~"', '"~Fbn()['Responsable']~"', ")
Sqladd("   '"~Fbn()['TipoPosicion']~"', '"~Fbn()['Producto']~"', '"~Fbn()['GrupoEspecie']~"', '"~Fbn()['CarteraBCRA']~"', ")
Sqladd("   "~FStr(Fbn()['PrecioHist'], 0, 10)~", "~FStr(Fbn()['PrecioCotiz'], 0, 10)~") ")
Sqlnew()
Sqlexec()
endif

