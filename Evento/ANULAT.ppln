creardialogo
radio1: 'Tipo|Borrar|Truncar|';;;;;;;;;0
findialogo

if (not ok)
Cancelar()
endif

if (Messagebox('Esta seguro de borrar todos lo datos de la base?', 0, 1) = 2)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(a:1, "DELETE ")
else
Act(a:1, "TRUNCATE TABLE ")
endif

Sqladd(" INSERT INTO "~Dbo()~".PMAUDIT (Operador,Fecha,Accion,Tabla,Codigo,Campo,ValorAnterior,ValorActual) ")
Sqladd(" VALUES ('"~UsuarioActivo()~"',GETDATE(), 'B', 'EVENTOS', 'ANULAT', '','Datos cargados','Todos los datos borrados por "~Val(a:1)~"') ")
Sqlnew()
