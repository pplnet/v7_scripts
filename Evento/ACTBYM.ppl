CrearDialogo
     Fecha1   : 'Fecha Conc.'     ; 2;1;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
     Check1   : 'Solo Instancia'  ; ;1;;;
FinDialogo
if Not OK
   Cancelar
endif   

let &contador 0
SQL.ADD("Select O.NrOperacion,NrBit from "~DBO~".OPERACIONES  O, "~DBO~".OPERACIONESBITS  OB ")
SQL.ADD(" WHERE O.NrOperacion=OB.NrOperacion and Valor=1 ")
SQL.ADD("  and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' and Mercado4 ='BYMA' ")
SQL.ADD("  and O.Nroperacion not in ('T0023842','T0023857') ")
SQL.ADD(" and ((Book1 = '' or Book1 is Null) or (Cuenta1 = '' or Cuenta1 is Null) or (Cuenta4 = '' or Cuenta4 is Null))")
Recorrer SQL
    let &contador &contador + 1
    if Dialogo.Check1=0
       EjecutarEvento('RECALB', NrOperacion1=fbn['NrOperacion'])
    Endif 
    
    EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=0, Entero1=fbn['NrBit'], Entero2=7)
    IF &contador = 10
        Break
    ENDIF
proximo
