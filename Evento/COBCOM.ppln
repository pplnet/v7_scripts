Sqladd("SELECT DISTINCT M.NrOperacion from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C ")
Sqladd("Where M.NrOperacion = T.NrTrans ")
Sqladd("and   M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and   T.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
Sqladd("and   T.Cliente1 = C.Codigo ")
Sqladd("and   M.NrSaldo = 4 ")
if (dialogo.radio1 = 0)
Sqladd("and TipoTr2 IN ('DTP','RTP')")
Sqladd("and   (C.FrecuenciaCobro='DIA' ")
if (dialogo.fecha1 = FinDeMes(dialogo.fecha1))
Acn(z1, Mes(dialogo.fecha1) mod (3))
if (Val(z1) = 0)
Sqladd(" or C.FrecuenciaCobro='TRI' or C.FrecuenciaCobro ='' or C.FrecuenciaCobro IS Null ")
endif
Sqladd(" or C.FrecuenciaCobro='MEN' ")
endif
Sqladd(" ) ")
else
Sqladd("and TipoTr2 IN ('CUSSAL')")
Sqladd("and T.CB1='1' ")
endif
Sqladd("Order By 1")

