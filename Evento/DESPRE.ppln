Act(x1, BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1))
if (not Incluido(Val(x1), 'DEP|RET|MATCH'))
Cancelar()
endif

Sqladd("Select * from "~Dbo()~".MOVEJECUTADOS	")
Sqladd("Where NrTrans2 = '"~dialogo.nrtrans1~"' ")
Sqladd("  and NrOperacion <> '"~dialogo.nrtrans1~"' ")
Sqladd("  and Cantidad < 0 ")
recorrer sql
Act(a:fac, Fbn('NrOperacion'))
if (Incluido(Copy(Val(a:fac), 1, 1), 'T|F'))
Act(b:fac, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Val(a:fac)))
