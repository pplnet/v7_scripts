Act(k:fac, BuscarCampo('OPERACIONES', 'OperacionRef', 'NrOperacion', Val(a:fac)))
Acn(l:fac, Query("Select SUM(Monto) from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(k:fac)~"' and Limite = 'PRESETREPO' "))
Acn(m:fac, Query("Select SUM(Monto) from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(k:fac)~"' and Limite = 'PSRVN' "))
if (Val(l:fac) > 0)
Act(n:fac, 'PRESETREPO')
Sqladd("Select * from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(k:fac)~"' and Limite = 'PRESETREPO' ")
recorrer sql
Dfa()
Scn(o:fac, 1)
Sqladd("Insert into "~Dbo()~".MOVLIMITES (")
Sqladd("FechaMov, Cliente, Limite, ")
Sqladd("Especie, Monto, NrOperacion, ")
Sqladd("Descripcion, Usuario, Bits, ")
Sqladd("Vehiculo, PlazoDesde, PlazoHasta, ")
Sqladd("Sublimite, Commited ")
Sqladd(") values (")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~Fbn('Cliente')~"', '"~Fbn('Limite')~"', ")
Sqladd(" '"~Fbn('Especie')~"', "~FStr(-Val(l:fac), 0, 2)~", '"~Fbn('NrOperacion')~"', ")
Sqladd(" 'Conf. DVP', '', ")
if (dialogo.fecha1 <= FSys())
Sqladd(" 'P', ")
else
Sqladd(" 'N', ")
endif
Sqladd(" '"~Fbn('Vehiculo')~"', "~FStr(Fbn('PlazoDesde'), 0, 0)~", "~FStr(Fbn('PlazoHasta'), 0, 0)~", ")
Sqladd(" '"~Fbn('Sublimite')~"', '"~Fbn('Commited')~"' ")
Sqladd(" )")
Sqlnew()
break
proximo
endif
