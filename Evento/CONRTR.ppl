CrearDialogo
  NrOperacion1: '# Operacion' ;;;;;;Novacio(Dialogo.NrOperacion1);;NO;
* Para hacer pruebas usar la segunda linea
  Check1      : 'Procesa'     ;;;;NO;NO;;;;1
*  Check1      : 'Procesa'     ;;;;SI;SI;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

if Not Eqstr(VAR('INSTALACIO'),'MLASA')
  if Dialogo.Check1=0
    MessageBox('Evento Cancelado - No es MLASA')
  else
    Cancelar('Evento Cancelado')
  endif
endif

SQL.ADD("Select NrOperacion, TipoOp, RB6, IsNull(FechaEnvAltaSisExterno,0) FEASE, NrExterno ")
SQL.ADD("  from "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACT(a:1, fbn('NrOperacion'))
  ACN(a:2, fbn('RB6'))
  ACD(a:3, fbn('FEASE'))
  ACN(b:3, fbn('FEASE'))
  ACT(a:4, fbn('NrExterno'))
  if Incluido(FBN['TipoOp'],'TIC|TIV|')
    SQL.ADD("Select NrOperacion, Valor  ")
    SQL.ADD("  from "~DBO~".OPERACIONESBITS ")
    SQL.ADD(" Where NrOperacion= '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and NrBit = 68 ")
    Recorrer SQL
      dfa
      ACN(a:5, fbn('Valor'))
    Proximo
    if Val(a:2)<>2
      * Fuenta alta <> 2 (No es origen Raiden)
      if Val(a:3)>2
        * Tiene FechaEnvio a Raiden
        if Vacio(Val(a:4))
          * No tienen numero de Radien
          if Val(a:5)=1
            * Esta en 68
            if Dialogo.Check1=1 
              * Quito la fecha de enviada para que se vuelva a marcar
              SQL.ADD("Update "~DBO~".OPERACIONES ")
              SQL.ADD("   Set FechaEnvAltaSisExterno  = Null ")
              SQL.ADD(" where NrOperacion   = '"~Val(b:1)~"' ")
              SQL.NEW
              SQL.EXEC
            endif
          else
            MessageBox('La Operacion '~Val(b:1)~' no esta en la instancia de Informar al sistema Externo')
          endif
        else
          MessageBox('La Operacion '~Val(b:1)~' tiene numero de Radiden ('~Val(b:4)~')')
        endif
      else
        MessageBox('La Operacion '~Val(b:1)~' no tiene fecha de envio')
      endif
    else
      MessageBox('La Operacion '~Val(b:1)~' fue originada en Raiden')
    endif
  else
    MessageBox('El tipo de Operacion '~Val(b:1)~' es invalido')
  endif
Proximo
