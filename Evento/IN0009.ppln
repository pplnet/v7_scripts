Sqladd(" SELECT /*+ RULE */ T.Fecha1, T.Fecha2, T.Proveedor, T.Vehiculo1, T.Cantidad1, T.Especie, ")
Sqladd("        T.NrTrans, C1.Alias5 Cuenta1, C2.Alias5 Cuenta2, T.Cliente1 Banco1,   ")
Sqladd("        T.TipoTr2, O.NrBit ")
Sqladd("      , T.Cuenta1 cta1, T.Cuenta2 cta2, T.cb6 ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CUENTAS C1, "~Dbo()~".CUENTAS C2, ")
Sqladd("      "~Dbo()~".OPERACIONESBITS O ")
Sqladd(" WHERE T.Cuenta1 = C1.Codigo (+) ")
Sqladd("   AND T.Cuenta2 = C2.Codigo ")
Sqladd("   AND T.NrTrans = O.NrOperacion ")
Sqladd("   AND ((T.CB2 = '1' AND O.NrBit IN (17,18,20,50)) OR (T.CB2 <> '1' AND O.NrBit >= 1) ) ")
Sqladd("   AND O.Valor = '1' ")
Sqladd("   AND T.TipoTr2 = 'RET' ")
Sqladd("   AND T.CB10 = '1' ")

Sqladd("   AND ( ( (T.Fecha1 between "~IdxDate2(dialogo.fecha1)~" and "~IdxDate2(FSys())~") AND (T.CB6='0' OR T.CB6 IS NULL)) )")
Sqladd("   AND (T.CB4 IS NULL OR T.CB4 = '0' ) ")

if (NoVacio(dialogo.vehiculo1))
Sqladd("   AND T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif

Sqladd(" ORDER BY T.Vehiculo1, T.NrTrans ")

