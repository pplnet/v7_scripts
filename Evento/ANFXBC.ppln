creardialogo
nroperacion1:'Nro. Oper.';1;1;;;;;;;;;;
findialogo
if (not ok)
Cancelar()
endif

Message('Anula minuta FX BCRA relacionada a Op. # '~dialogo.nroperacion1)


if (BuscarCampo('OPERACIONES', 'RB2', 'NrOperacion', dialogo.nroperacion1) = 0)
Messagebox('La Operacion '~dialogo.nroperacion1~' no es por circular BCRA')
Cancelar()
endif

Act(aa1, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1))
if (Eqstr(Val(aa1), 'FXC'))
Act(aa2, 'FXV')
endif
if (Eqstr(Val(aa1), 'FXV'))
Act(aa2, 'FXC')
endif
Act(ab1, sql("SELECT NrOperacion from "~Dbo()~".OPERACIONES where OperacionRef='"~dialogo.nroperacion1~"' and TipoOp='"~Val(aa2)~"' and RB2='1' "))
if (Vacio(Val(ab1)))
Messagebox('No existe operacion BCRA relacionada.')
Cancelar()
endif

sql.add("Delete from "~Dbo()~".MOVPOSPEN Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".MOVPOSEJE Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".MOVPENDIENTES Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".MOVEJECUTADOS Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.add("Delete from "~Dbo()~".OPERACIONES Where NrOperacion = '"~Val(ab1)~"' ")
sql.new
sql.exec

