creardialogo
entero1:'Mes';;;;;;dialogo.entero1 > 0 y dialogo.entero1 < 13;'Debe selecionar un mes válido';NO;Mes(FSys()) - 1;;;;'##';;;;;;;
entero2:'Año';;;;;;dialogo.entero2 >= Anio(FSys()) - 1 y dialogo.entero2 <= Anio(FSys());'Debe seleccionar un año válido';NO;Anio(FSys());;;;'####';;;;;;;
cuenta1:'Cuenta';;;;;;Eqstr(BuscarCampo('Cuentas', 'Comitente', 'Codigo', dialogo.cuenta1), dialogo.cliente1);'La cuenta no pertenece al Banco Seleccionado';NO;;if (NoVacio(dialogo.nroperacion1), BuscarCampo('OPERACIONES', 'Cuenta1', 'NrOperacion', dialogo.nroperacion1), dialogo.cuenta1);;;;"Codigo in (SELECT Distinct Cuenta1 FROM "~Dbo()~".OPERACIONES WHERE TipoOp = 'MMRPAC' AND Cuenta1 <> '' AND MONTH(FechaOp) = "~dialogo.entero1~" AND YEAR(FechaOp) = "~dialogo.entero2~" )";;
cliente1: 'Banco';;;;;;NoVacio(dialogo.cliente1);'Banco Invalido';NO;;BuscarCampo('CUENTAS', 'Comitente', 'Codigo', dialogo.cuenta1);;;;"Codigo in (SELECT Distinct Cliente1 FROM "~Dbo()~".OPERACIONES WHERE TipoOp = 'MMRPAC' AND Cliente1 <> '' AND MONTH(FechaOp) = "~dialogo.entero1~" AND YEAR(FechaOp) = "~dialogo.entero2~")";
nroperacion1: 'Operacion';;;;NO;;NoVacio(dialogo.nroperacion1) y (BuscarCampo('OPERACIONES', 'CB1', 'NrOperacion', dialogo.nroperacion1) <> 1 o BuscarCampo('OPERACIONES', 'CB1', 'NrOperacion', dialogo.nroperacion1) = 0);'Acuerdo Invalido O El Saldo Promedio Cumple con el Minimo Requerido';NO;;Query(" Select NrOperacion FROM "~Dbo()~".OPERACIONES WHERE Cuenta1 = '"~dialogo.cuenta1~"' AND Cliente1 = '"~dialogo.cliente1~"' AND TipoOp = 'MMRPAC' AND (CB1 is null OR CB1 = 0) ");;;;;
entero3:'Saldo Minimo';;;;NO;;;;;;Query(" Select Cantidad FROM "~Dbo()~".OPERACIONES WHERE NrOperacion = '"~dialogo.nroperacion1~"' ");;;'############.##';
entero4:'Saldo Promedio';;;;NO;;;;;;Query(" Select TotalNetoCli1 FROM "~Dbo()~".OPERACIONES WHERE NrOperacion = '"~dialogo.nroperacion1~"' ");;;'############.##';
entero5:'Nuevo Sal Min';;;;;;dialogo.entero5 < dialogo.entero4;'El nuevo Minimo debe ser menor a '~dialogo.entero4~'';NO;;;;;'############.##';;;;;;;
fecha1:'FechaOp';;;;NO;NO;;;;;BuscarCampo('OPERACIONES', 'FechaOp', 'NrOperacion', dialogo.nroperacion1);;;;;;
fecha2:'FechaVto';;;;NO;NO;;;;;BuscarCampo('OPERACIONES', 'FechaVto', 'NrOperacion', dialogo.nroperacion1);;;;;;
findialogo

if (not ok)
Cancelar()
endif

let(&fecha, BuscarCampo('OPERACIONES', 'FechaOp', 'NrOperacion', dialogo.nroperacion1))

if (BuscarCampo('OPERACIONES', 'CB2', 'NrOperacion', dialogo.nroperacion1) = 1)
let(&maxfecha, dialogo.fecha2)
else
let(&maxfecha, Query(" Select Max(FechaSaldo) FechaSaldo from "~Dbo()~".SALDOSBANCARIOS Where FechaSaldo >= '"~IdxDate(dialogo.fecha1)~"' and FechaSaldo <= '"~IdxDate(dialogo.fecha2)~"' AND Banco = '"~BuscarCampo('CLIENTES', 'Alias3', 'Codigo', dialogo.cliente1)~"' AND NrCuenta = '"~BuscarCampo('CUENTAS', 'Numero', 'Codigo', dialogo.cuenta1)~"' AND Estado = 'PRO' "))
if (Vacio(&maxfecha))
let(&maxfecha, dialogo.fecha1)
endif
endif

ejecutarevento('ANUREM', fecha1 = &fecha, cuenta1 = dialogo.cuenta1)

sql.add(" UPDATE "~Dbo()~".OPERACIONES ")
sql.add(" Set CB2 = 1, ")
sql.add(" TotalNetoCli2 = "~FStr(dialogo.entero5, 0, 8)~" ")
sql.add(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec

if (EsHabil(dialogo.fecha1, 'ARG'))
let(&desde, dialogo.fecha1)
else
let(&desde, Habiles(dialogo.fecha1, -1, 'ARG', SI))
endif

ejecutarevento('REMUD', fecha1 = Fecha(&desde), cuenta1 = dialogo.cuenta1, fecha2 = Fecha(&maxfecha))

Messagebox('Evento Cambio de Saldo Minimo Finalizado Correctamente.')
