if (not EsHabil(dialogo.fecha3, Fbn()['TablaFeriados1']))
Messagebox('La Fecha de Settlement NO ES Dia Habil en la Tabla de Feriados '~Fbn()['TablaFeriados1'])
break
endif

Acn(x1, 1)

Acn(z20, 0)
