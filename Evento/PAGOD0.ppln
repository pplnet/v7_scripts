Sqladd("SELECT 0 Tipo, S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, S.NrSaldo, C.RazonSocial, ")
Sqladd("       S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125 ")
Sqladd("  from "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE S.Cliente      = C.Codigo ")
Sqladd("   and C.Status       = 'HAB' ")
Sqladd("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:2))~") ")
Sqladd("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
Sqladd("   AND S.NrSaldo      <> 1 ")
Sqladd("   AND S.Especie      ='"~dialogo.especie1~"' ")

Sqladd("   AND S.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("   and S.Cuenta       = CU.Codigo ")
Sqladd("   and CU.Comitente   = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.mercado1))
Sqladd(" AND S.Mercado      = '"~dialogo.mercado1~"' ")
endif
Sqladd("   AND S.Fecha IN (SELECT Max(S1.Fecha)  ")
Sqladd("                     FROM "~Dbo()~".SALDOSDIA S1")
Sqladd("                    WHERE S1.Cliente = S.Cliente ")
Sqladd("                      AND S1.Especie = S.Especie ")
Sqladd("                      AND S1.Mercado = S.Mercado ")
Sqladd("                      AND S1.EnteCustodia = S.EnteCustodia ")
Sqladd("                      AND S1.NrSaldo = S.NrSaldo  ")
Sqladd("                      AND S1.Cuenta  = S.Cuenta   ")
Sqladd("                      AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
Sqladd("                      AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
Sqladd("                      AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))")
Sqladd("                      AND S1.Fecha <= '"~IdxDate(dialogo.fecha2)~"') ")

Sqladd("union all ")

