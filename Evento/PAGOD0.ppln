Sqladd("SELECT M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
Sqladd("       M.CallPut,  M.PrecioEj, M.Book, M.FechaEj, M.NrSaldo, SUM(((M.Cantidad*"~dialogo.precio1~")/100)) Total, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, O.TipoOp Tipo ")
Sqladd("  FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONES O, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE M.Cliente      = C.Codigo ")
Sqladd("   and C.Status       = 'HAB' ")
Sqladd("   AND M.NrSaldo      = 1 ")
Sqladd("   AND M.Especie      ='"~dialogo.especie1~"' ")
Sqladd("   AND M.NrOperacion  = O.NrOperacion ")
Sqladd("   AND M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cuenta       = CU.Codigo ")
Sqladd("   and CU.Comitente   = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.mercado1))
Sqladd(" AND M.Mercado      = '"~dialogo.mercado1~"'")
endif

Sqladd("   AND M.FechaMov    <= '"~IdxDate(dialogo.fecha2)~"'  ")
Sqladd(" GROUP BY M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, C.RazonSocial, M.CallPut, M.FechaEj, M.PrecioEj, M.Book,  M.NrSaldo, ")
Sqladd("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, O.TipoOp ")

Sqladd(" Union ")

Sqladd("SELECT M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
Sqladd("       M.CallPut, M.PrecioEj, M.Book, M.FechaEj, M.NrSaldo, SUM(((M.Cantidad*"~dialogo.precio1~")/100)) Total, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2 Tipo ")
Sqladd("  FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".CLIENTES C, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE M.Cliente      = C.Codigo ")
Sqladd("   and C.Status       = 'HAB' ")
Sqladd("   AND M.NrSaldo      = "~FStr(Val(sl:1), 0, 0)~" ")
Sqladd("   AND M.Especie      = '"~dialogo.especie1~"' ")
Sqladd("   AND M.NrOperacion  = T.NrTrans ")
Sqladd("   AND (T.TipoTr2 not in ('PDIVID','DTP','RTP') or (CB6 = '0' and  T.TipoTr2 in ('DTP','RTP'))) ")
Sqladd("   AND M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cuenta       = CU.Codigo ")
Sqladd("   and CU.Comitente   = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.mercado1))
Sqladd(" AND M.Mercado      = '"~dialogo.mercado1~"'")
endif
Sqladd("   AND M.FechaMov    <= '"~IdxDate(dialogo.fecha2)~"'  ")
Sqladd(" GROUP BY M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, C.RazonSocial, M.CallPut, M.FechaEj, M.PrecioEj, M.Book, M.NrSaldo, ")
Sqladd("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2  ")

Sqladd(" Union ")

Sqladd("SELECT T.Cliente1 Cliente, T.Especie, T.Mercado1 Mercado, T.Cuenta1 Cuenta, '' EnteCustodia, T.Cantidad1 Cantidad, C.RazonSocial, ")
Sqladd("       '' CallPut, '' PrecioEj, '' Book, '' FechaEj, '101' NrSaldo, ((T.Cantidad1*"~dialogo.precio1~")/100) Total, ")
Sqladd("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2 Tipo  ")
Sqladd("  FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C, "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE T.Cliente1     = C.Codigo ")
Sqladd("   and C.Status       = 'HAB' ")
Sqladd("   AND T.Especie      = '"~dialogo.especie1~"' ")
Sqladd("   and T.TipoTr2      in ('DTP','RTP') ")
