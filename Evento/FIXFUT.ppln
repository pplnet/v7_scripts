if (sql(" Select 1 From "~Dbo()~".MOVPENDIENTES  Where "~iif (Eqstr(Val(me:1), Var('AMBROFEX')), " FechaMov = "~IdxDate2(Val(fe:3)), iif (Eqstr(Val(me:1), Var('AMBMAE')), " FechaMov = "~IdxDate2(Val(fe:2)), "FechaMov = "~IdxDate2(dialogo.fecha1)))~" AND NrOperacion = '"~Fbn('NrOperacion')~"'  AND NrGrupo > 1000 ") = 1)
sql.add(" Update "~Dbo()~".MOVPENDIENTES            ")
if (Eqstr(Fbn('Cliente1'), Fbn('Vehiculo1')))
sql.add(" Set Cantidad = "~FStr(-Val(ca:1), 0, 2)~", ")
else
sql.add(" Set Cantidad = "~FStr(Val(ca:1), 0, 2)~", ")
endif
sql.add("     Leyenda = '"~Val(le:1)~"' ")
sql.add(" Where  NrOperacion = '"~Fbn('NrOperacion')~"' ")
if (Eqstr(Val(me:1), Var('AMBROFEX')))
sql.add("   And  FechaMov = "~IdxDate2(Val(fe:3))~" ")
else
if (Eqstr(Val(me:1), Var('AMBMAE')))
sql.add("   And  FechaMov = "~IdxDate2(Val(fe:2))~" ")
else
sql.add("   And  FechaMov = "~IdxDate2(dialogo.fecha1)~" ")
endif
endif
sql.new
else
sql.add(" Insert into "~Dbo()~".MOVPENDIENTES ( ")
sql.add("  NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
sql.add("  Bits, NrSaldo, Cuenta, NrMov, ")
sql.add("  Book,  FechaMov, Cantidad, Leyenda, ")
sql.add("  NrGrupo, Concepto, ")
sql.add("  NrGrupo2, Nrinstan ")
sql.add(" ) values  ( ")
sql.add("  '"~Fbn('NrOperacion')~"', ")
sql.add("  '"~Val(es:1)~"', ")
sql.add("  '"~Fbn('Cliente1')~"', ")
sql.add("  '"~Fbn('Mercado2')~"', ")
sql.add("  '"~Fbn('Vehiculo1')~"', ")
sql.add("  'MV', ")
sql.add("  1, ")
sql.add("  '"~Fbn('Cuenta4')~"', ")
sql.add("  "~FStr(Val(nr:1) + Val(cu:1), 1, 0)~", ")
sql.add("  '"~Fbn('Book1')~"',  ")
if (Eqstr(Val(me:1), Var('AMBROFEX')))
sql.add("  "~IdxDate2(Val(fe:3))~", ")
else
if (Eqstr(Val(me:1), Var('AMBMAE')))
sql.add("  "~IdxDate2(Val(fe:2))~", ")
else
sql.add("  "~IdxDate2(dialogo.fecha1)~", ")
endif
endif
if (Eqstr(Fbn('Cliente1'), Fbn('Vehiculo1')))
sql.add("  "~FStr(-Val(ca:1), 0, 2)~", ")
else
sql.add("  "~FStr(Val(ca:1), 0, 2)~", ")
endif
sql.add("  '"~Val(le:1)~"', ")
sql.add("  0, ")
sql.add("  'FM', ")
sql.add("  "~FStr(Val(nr:1) + Val(cu:1), 1, 0)~", ")
sql.add("  "~FStr(0, 0, 0)~" ")
sql.add(" ) ")
sql.new
endif

escribirascii(Fecha(FSys(), 'DDMMYYYY')~' '~Hora(Ahora())~' '~'Corrida FIXFUT - ActualizarMovimientos3 '~Fbn('NrOperacion'))

