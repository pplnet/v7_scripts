if (Val(y:1) > Val(x:1))
recorrer&k 2, Val(y:1)
Act(d:&k, 'OK')
sql.add("Select O.Especie, O.ContraEspecie, O.FechaVto, O.Mercado, O.TablaFeriados1, O.Contraespecie2, ")
sql.add("       IsNull(O.Lotes,0) as DiasAnt,      ")
sql.add("       O.EsCaucionado as HabCorr, O.TasaEspecie MonLiquida        ")
sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" WHERE O.FechaVto = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   AND O.Mercado  = '"~Val(a:&k)~"' ")
if (Eqstr(Val(b:&k), 'Moneda'))
sql.add(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(b:&k), 'Titulo'))
sql.add(" AND O.TipoOp IN ('TICF','TIVF') ")
endif
if (NoVacio(dialogo.cliente1))
sql.add(" and O.Cliente1    = '"~dialogo.cliente1~"' ")
endif
sql.add("   and O.NrOperacion = B.NrOperacion ")
sql.add("   and B.NrBit       in (10,70) ")
sql.add("   and B.Valor       = '1' ")
sql.add(" Order By O.FechaVto, O.NrOperacion ")
Watch(sql.batch())
recorrer sql
Dfa()
Scn(c:&k, 1)
if (Eqstr(Val(d:&k), 'OK'))
Acd(fe:1, dialogo.fecha1)
Acn(nr:1, sql("Select 1 From "~Dbo()~".MERCADOS Where Codigo = '"~Fbn('Mercado')~"' AND Regulado = 'NO' "))
if (Val(nr:1) = 1)
if (Eqstr(Fbn('HabCorr'), '1'))
Acd(fe:1, Habiles(dialogo.fecha1, -1 * Fbn('DiasAnt'), Fbn()['TablaFeriados1']))
else
Acd(fe:1, Habiles(dialogo.fecha1, -1 * Fbn('DiasAnt'), Fbn()['TablaFeriados1'], NO))
