Sqladd("Select * ")
Sqladd("  from "~Dbo()~".OPERACIONESBITS OB, "~Dbo()~".OPERACIONES O")
Sqladd(" Where O.NrOperacion = OB.NrOperacion ")
Sqladd("   and OB.NrBit = 1 ")
Sqladd("   and OB.Valor = '1' ")
Sqladd("   and O.TipoOp in ('TIC','TIV') ")
Sqladd("   and O.Precio1 = 1 ")
Sqladd("   and O.RB6 = 3 ")
Sqladd("   and isNull(O.NrOrden1,'')<>'' ")
Sqladd(" Order by O.NrOperacion ")
recorrer sql
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Act(c:fac, Fbn('Mercado4'))
Acn(d:fac, Fbn('RB6'))
Acn(e:fac, Fbn('Cantidad'))
Acn(f:fac, Fbn('Precio1'))
Act(g:fac, Fbn('NrOrden1'))
Acn(h:fac, 1)
proximo

if (Fac() > 0)
recorrer&i 1, Fac()
if (Val(h:&i) = 1)
Ejecutarevento('ACTPRE', 'nroperacion1', Val(a:&i), 'check1', 1, 'check2', 1)
endif
proximo
else
Cancelar('No hay operaciones para modificar')
endif


