sql.add("Select O.NrOperacion, O.RB3 from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B where O.NrOperacion=B.NrOperacion and B.NrBit=5 and B.Valor='1' and O.Direccion=1")
recorrer sql
sql.add("Delete from "~Dbo()~".EXCEPCIONES where NrOperacion='"~Fbn('NrOperacion')~"' and Tipo in ('xxx','yyy')")
sql.new
if (Fbn('RB3') = 1)
sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=1")
else
sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=2")
endif
sql.new
sql.add("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=5")
sql.new
sql.add("Insert into "~Dbo()~".EXCEPCIONES")
sql.add("(NrOperacion, Tipo, Fecha, Descripcion) values")
sql.add("('"~Fbn('NrOperacion')~"', 'RECHAZO', '"~IdxDate(FSys())~"', 'La Operacion fue rechazada por el supervisor')")
sql.new
sql.exec
proximo

