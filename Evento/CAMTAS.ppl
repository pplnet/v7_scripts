* CAMTAS. Cambio de Tasas Impositivas y Comisiones PARA Operaciones MV.
CrearDialogo
  NrOperacion1 : "Operacion"       ;1;1;;;;VACIO(Dialogo.NrOperacion1) o Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM|MMCPM|MMFIMV|MMSIMV');'TIPOS DE OPERACION VALIDOS PARA ESTE EVENTO: MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM';NO;;;;;; "TipoOp in ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMONM','MMPCCM','MMCPM','MMFIMV','MMSIMV')"
  Fecha1       : "A Partir de"     ;1;2;;;;NOVACIO(Dialogo.Fecha1);'FECHA INCORRECTA';NO;Fsys;
  Precio6      : "WHT Actual"      ;2;1;;;;Dialogo.Check1=0 o Incluido(Fstr(Dialogo.Precio6,2,4),VAR('TASAWH'));'TASA WHT INCORRECTA: '~VAR('TASAWH');NO;iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)<>0] o [Incluido(Dialogo.String,'MMPOSM|MMONM|MMSIMV|MMFIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=2],BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1),0);iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)<>0] o [Incluido(Dialogo.String,'MMPOSM|MMONM|MMSIMV|MMFIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=2],BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1),0)
  Precio1      : "WHT Nueva"       ;3;1;;;;Dialogo.Check1=0 o [Incluido(Fstr(Dialogo.Precio1,2,4),VAR('TASAWH')) y Dialogo.Precio1<>Dialogo.Precio6];'TASAS IGUALES O TASA WHT INCORRECTA: '~VAR('TASAWH');NO;;
  Check1       : "Confirma?"       ;3;2;;;;;;;;;
  Precio7      : "IVA Actual"      ;4;1;;;;Dialogo.Check2=0 o Incluido(Fstr(Dialogo.Precio7,2,2),VAR('IVA'));'TASA IVA INCORRECTA: '~VAR('IVA');NO;Iif(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM|MMSIMV|MMFIMV'),BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1),0);Iif(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM|MMSIMV|MMFIMV'),BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1),0);
  Precio2      : "IVA Nueva"       ;5;1;;;;Dialogo.Check2=0 o [Incluido(Fstr(Dialogo.Precio2,2,2),VAR('IVA')) y Dialogo.Precio2<>Dialogo.Precio7];'TASAS IGUALES O TASA IVA INCORRECTA: '~VAR('IVA');NO;;
  Check2       : "Confirma?"       ;5;2;;;;;;;;;
  Precio8      : "CEC Actual"      ;6;1;;;;Dialogo.Check3=0 o Dialogo.Precio8>=0;'TASA CEC INCORRECTA';NO;iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMPCLM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1],BuscarCampo('Operaciones','Precio3','NrOperacion',Dialogo.NrOperacion1),0);iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMPCLM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1],BuscarCampo('Operaciones','Precio3','NrOperacion',Dialogo.NrOperacion1),0);
  Precio3      : "CEC Nueva"       ;7;1;;;;Dialogo.Check3=0 o [Dialogo.Precio3>=0 y Dialogo.Precio3<>Dialogo.Precio8];'TASAS IGUALES O TASA CEC INCORRECTA';NO;;0;
  Check3       : "Confirma?"       ;7;2;;;;;;;;;
  Cantidad3    : "CEN Actual"      ;8;1;;;;Dialogo.Check4=0 o Dialogo.Cantidad3>=0;'TASA CEN INCORRECTA';NO;iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPOSM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0],BuscarCampo('Operaciones','Precio2','NrOperacion',Dialogo.NrOperacion1),0);iif (NoVacio(Dialogo.NrOperacion1) y [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPOSM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0],BuscarCampo('Operaciones','Precio2','NrOperacion',Dialogo.NrOperacion1),0);
  Precio4      : "CEN Nueva"       ;9;1;;;;Dialogo.Check4=0 o [Dialogo.Precio4>=0 y Dialogo.Precio4<>Dialogo.Cantidad3];'TASAS IGUALES O TASA CEN INCORRECTA';NO;;0;
  Check4       : "Confirma?"       ;9;2;;;;;;;;;
  Cantidad2    : "Imp.Extr.Act."   ;10;1;;;;Dialogo.Check5=0 o Dialogo.Cantidad2<=30;'SI SE INGRESA, EL IMPUESTO EXTRANJERO DEBE SER <=30';NO;iif (NoVacio(Dialogo.NrOperacion1) y [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)>=3],BuscarCampo('Operaciones','TasaPrecan','NrOperacion',Dialogo.NrOperacion1),0);iif (NoVacio(Dialogo.NrOperacion1) y [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)>=3],BuscarCampo('Operaciones','TasaPrecan','NrOperacion',Dialogo.NrOperacion1),0);;;"###.#####"
  Precio5      : "Imp.Extr.Nva."   ;11;1;;;;Dialogo.Check5=0 o [Dialogo.Precio5<=30 y Dialogo.Precio5<>Dialogo.Cantidad2];'SI SE INGRESA, EL IMPUESTO EXTRANJERO DEBE SER <=30 Y DIFERENTE A LA TASA DE IMPUESTO ACTUAL';NO;;;
  Check5       : "Confirma?"       ;11;2;;;;;;;;;
  Cantidad1    : "Alic.Imp.Act."   ;12;1;;;;Dialogo.Check6=0 o Dialogo.Cantidad1>=0;'ALICUOTA POR MMCPM INCORRECTA';NO;IIF(DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1))),BuscarCampo('Operaciones','ImpGastos1','NrOperacion',Dialogo.NrOperacion1),0);IIF(DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1))),BuscarCampo('Operaciones','ImpGastos1','NrOperacion',Dialogo.NrOperacion1),0);;;"###.#####"
  Precio10     : "Alic.Imp.Nva."   ;13;1;;;;Dialogo.Check6=0 o [Dialogo.Precio10>=0 y Dialogo.Precio10<>Dialogo.Cantidad1];'ALICUOTAS POR MMCPM IGUALES O INCORRECTA';NO;;
  Check6       : "Confirma?"       ;13;2;;;;;;;;;
  Cantidad4    : "Perc.IVA_Act."   ;14;1;;;;Dialogo.Check7=0 o Dialogo.Cantidad4>=0;'PORCENTAJE PERCEPCION IVA INCORRECTO';NO;IIF(NOT DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1))),BuscarCampo('Operaciones','TotalAux2','NrOperacion',Dialogo.NrOperacion1),0);;;;"###.#####"
  Precio9      : "Perc.IVA_Nvo."   ;15;1;;;;Dialogo.Check7=0 o [Dialogo.Precio9>=0 y Dialogo.Precio9<>Dialogo.Cantidad4];'PORCENTAJES  DE PERCEPCION IVA IGUALES O INCORRECTO';NO;;
  Check7       : "Confirma?"       ;15;2;;;;;;;;;
  Cantidad5    : "Impto.Int_Act"   ;16;1;;;;Dialogo.Check8=0 o [Dialogo.Cantidad5<>Dialogo.Cantidad6];'El Valor de TASA Impuesto INTERES es Erroneo: '~VAR('TASAINT')~' ... o Son Iguales';NO;IIf(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM|MMSIMV|MMFIMV'),BuscarCampo('Operaciones','TasaImp1','NrOperacion',Dialogo.NrOperacion1),0);IIf(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM|MMPCCM|MMSIMV|MMFIMV'),BuscarCampo('Operaciones','TasaImp1','NrOperacion',Dialogo.NrOperacion1),IIf(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMONM'),SQL("Select Tasa3 FROM "~DBO~".CUOTAS Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' "),0))
  Cantidad6    : "Impto.Int_Nueva" ;17;1;;;;Dialogo.Check8=0 o [Dialogo.Cantidad5<>Dialogo.Cantidad6];'El Valor de TASA Impuesto INTERES es Erroneo: '~VAR('TASAINT')~' ... o Son Iguales';NO;;
  Check8       : "Confirma?"       ;17;2;;;;;;;;;
  Cantidad7    : "IVA_CEN_Act"     ;18;1;;;;Dialogo.Check9=0 o [Incluido(Fstr(Dialogo.Cantidad7,2,2),VAR('IVA')) y Dialogo.Cantidad7<>Dialogo.Cantidad8];'El Valor de TASA de IVA CEN es Erroneo: '~VAR('IVA')~' ... o Son Iguales';NO;Iif(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPOSM'),BuscarCampo('Operaciones','IntDevengados1','NrOperacion',Dialogo.NrOperacion1),0);Iif(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPOSM'),BuscarCampo('Operaciones','IntDevengados1','NrOperacion',Dialogo.NrOperacion1),0)
  Cantidad8    : "IVA_CEN_Nueva"   ;19;1;;;;Dialogo.Check9=0 o [Incluido(Fstr(Dialogo.Cantidad8,2,2),VAR('IVA')) y Dialogo.Cantidad7<>Dialogo.Cantidad8];'El Valor de TASA de IVA CEN es Erroneo: '~VAR('IVA')~' ... o Son Iguales';NO;;
  Check9       : "Confirma?"       ;19;2;;;;;;;;;
  Cantidad9    : 'Cs_Fin_CEC_Act'  ;20;1;;;;Dialogo.Check10=0 o [Incluido(Fstr(Dialogo.Cantidad9 ,2,4),VAR('TASAINT')) y Dialogo.Cantidad9<>Dialogo.Cantidad10];'La Tasa del Costo Financiero CEC Anterior es Erroneo: '~VAR('TASAINT')~' ... o Son Iguales';NO;IIf(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM'),BuscarCampo('Operaciones','DeltaTasa','NrOperacion',Dialogo.NrOperacion1),0);IIf(NoVacio(Dialogo.NrOperacion1) y Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM'),BuscarCampo('Operaciones','DeltaTasa','NrOperacion',Dialogo.NrOperacion1),0)
  Cantidad10   : 'Cs_Fin_CEC_Nueva';21;1;;;;Dialogo.Check10=0 o [Incluido(Fstr(Dialogo.Cantidad10,2,4),VAR('TASAINT')) y Dialogo.Cantidad9<>Dialogo.Cantidad10];'La Tasa del Costo Financiero CEC Actual   es Erroneo: '~VAR('TASAINT')~' ... o Son Iguales';NO;;
  Check10      : "Confirma?"       ;21;2;;;;;;;;;
  String       : "Tipo op"         ;21;2;;NO;NO;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1);
FinDialogo

If not Ok
   Cancelar
EndIf

*- Control de vehiculo habilitado para el usuario
ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
(.'CONTROLVH'.)

(.'VINSCAMTAS'.)

Message('Recuperando Operaciones .... ')
(.'SELCAMTAS'.)

ACN(x2,0)
ACN(BD:1,0)

Recorrer SQL
   ACN(BD:1,1)
   Message('Por Cada Operacion Recuperada Realizo la Modificacion de la Tasa y recalculo los importes ...'~fbn['NrOperacion'])
   IF VAL(x2)=0
      ACN(x2,1)
      ACT(x1,' ')
      If Dialogo.Check1=1
         If [Incluido(Dialogo.String,'MMPEM|MMPIM') y FBN['RB6']>=1] o [Incluido(Dialogo.String,'MMPOSM|MMONM|MMFIMV|MMSIMV') y FBN['RB6']=1] o [EqStr(Dialogo.String,'MMPCCM') y FBN['RB6']=2] o [EqStr(Dialogo.String,'MMFIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',FBN['NrOperacion'])=1] O [EqStr(Dialogo.String,'MMSIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',FBN['NrOperacion'])=1]
            ACT(X1,"TotalAux1 = "~Fstr(Dialogo.Precio1,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check2=1
         If Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM|MMPOSM|MMONM|MMPCCM|MMFIMV|MMSIMV') O [EqStr(Dialogo.String,'MMCPM') y NOT DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion']),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion'])))]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" ImpGastos2 = "~Fstr(Dialogo.Precio2,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check3=1
         If [Incluido(Dialogo.String,'MMPEM|MMPIM') y FBN['RB6']=0] o [EqStr(Dialogo.String,'MMPCLM') y FBN['RB6']=1]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf      
            ACT(X1,VAL(X1)~" Precio3 = "~Fstr(Dialogo.Precio3,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check4=1
         If [Incluido(Dialogo.String,'MMPEM|MMPIM') y FBN['RB6']=1] o [EqStr(Dialogo.String,'MMPOSM') y FBN['RB6']=0]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" Precio2 = "~Fstr(Dialogo.Precio4,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check5=1
         If [EqStr(Dialogo.String,'MMPCCM') y FBN['RB6']>=3]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" TasaPrecan = "~Fstr(Dialogo.Precio5,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check6=1
         If [EqStr(Dialogo.String,'MMCPM') Y DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion']),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion'])))]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf 
            ACT(X1,VAL(X1)~" ImpGastos1 = "~Fstr(Dialogo.Precio10,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check7=1
         If [EqStr(Dialogo.String,'MMCPM') y NOT DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion']),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',FBN['NrOperacion'])))]
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" TotalAux2 = "~Fstr(Dialogo.Precio9,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check8=1
         If Incluido(Dialogo.String,'MMPCLM|MMPOSM|MMPCLM|MMPEM|MMPIM|MMSIMV|MMFIMV') 
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" TasaImp1 = "~Fstr(Dialogo.Cantidad6,0,7)~" ")
         EndIf  
      EndIf
      If Dialogo.Check9=1
         If Incluido(Dialogo.String,'MMPEM|MMPIM|MMPOSM')
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" IntDevengados1= "~Fstr(Dialogo.Cantidad8,0,7)~" ")
         EndIf
      EndIf
      If Dialogo.Check10=1
         If Incluido(Dialogo.String,'MMPEM|MMPIM|MMPCLM')
            If Not EqStr(val(x1),' ')
               ACT(X1,VAL(X1)~", ")
            EndIf
            ACT(X1,VAL(X1)~" DeltaTasa= "~Fstr(Dialogo.Cantidad10,0,7)~" ")
         EndIf
      EndIf 
      If Not EqStr(val(x1),' ')
         SQL.ADD("Update "~DBO~".OPERACIONES")
         SQL.ADD("Set ")
         SQL.ADD(" "~VAL(x1)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.NEW
         SQL.EXEC
      EndIf
      If Dialogo.Check8=1 y Incluido(Dialogo.String,'MMONM') 
         SQL.ADD("Update "~DBO~".CUOTAS")
         SQL.ADD("Set ")
         SQL.ADD(" Tasa3 ="~Fstr(Dialogo.Cantidad6,0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.NEW
         SQL.EXEC
      EndIf
   EndIf

   SQL.ADD("Select C.*,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,O.MB3,")
   SQL.ADD("O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,")
   SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1 ClienteOp,")
   SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa ")
   SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
   SQL.ADD("where C.NrOperacion = '"~FBN['NrOperacion']~"' ")
   SQL.ADD("and C.NrOperacion=O.NrOperacion ")
   SQL.ADD("and C.Fecha2>='"~IdxDate(Dialogo.Fecha1)~"' ")

   Recorrer SQL
      Message('Recuperando Datos Operacion '~FBN['NrOperacion']~' Cuota '~FStr(fbn('NrCuota'),0,0))
      * Q1=iva, q2=wh, q3=interes, q4=interes total, q5=monto, q6=monto total, Q10=cec total
      * Q11=cen total, Q20=cec imp var, Q21=cen variable, Q30=impuesto 
      * Q50: Impto.Interes Q51: Imp.IVA.CEN Q52: Imp_Cs_Fin_CEC
      * ASIGNA CASO

      If Incluido(Dialogo.String, 'MMPEM|MMPIM')
         ACN(q20,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['OPrecio3']/100),0))
         ACN(Q10,FBN['Cantidad5']+val(q20))
         ACN(Q21,IIF(FBN['RB6']=1,FBN['Cantidad2']*FBN['OPrecio2']*FBN['Plazo1']/IIF(FBN['MB3']=0,36000,36500),0))
         ACN(Q11,val(q21)+FBN['Plazo3'])
         ACN(Q1,(FBN['ImpGastos2']/100)*(val(q10)+(FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2']/IIF(FBN['RB7']=0,36000,36500))))
         ACN(Q2,IIF(FBN['RB6']=0,0,IIF(FBN['RB6']=2,FBN['Cantidad2']*((FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)*(FBN['TotalAux1']/100),FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']/IIF(FBN['RB9']=1,36500,36000)*(FBN['TotalAux1']/100))))
         ACN(Q3,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))

         * Impto.Interes
         ACN(Q50,IIF(FBN['RB6']=0,VAL(Q3),IIf(FBN['RB6']=1,VAL(Q11),0))*(FBN['TasaImp1']/100))

         * Imp_Cs_Fin_CEC
         ACN(Q52,IIF(FBN['RB6']=0,VAL(Q10)*(FBN['DeltaTasa']/100),0))

         * Iva Cen
         ACN(Q51,VAL(Q11)*(FBN['IntDevengados1']/100))

         ACN(Q4,val(q52)+val(q50)+val(q3)+VAL(Q10)+VAL(Q11)+VAL(Q2))

         ACN(Q5,(FBN['Cantidad1']+val(q3)))
 
         ACN(Q6,(FBN['Cantidad1']+val(q4)))

         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Total8 = "~Fstr(val(q20),0,7)~", ")
         SQL.ADD("Precio8 = "~Fstr(val(q20),0,7)~", ")
         SQL.ADD("Cantidad6 = "~Fstr(val(q10),0,7)~", ")
         SQL.ADD("Cantidad4 = "~Fstr(val(q21),0,7)~", ")
         SQL.ADD("Plazo4 = "~Fstr(val(q11),0,7)~", ")
         SQL.ADD("Total4 = "~Fstr(val(q1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
         SQL.ADD("Total7 = "~Fstr(val(q2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
         SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
         SQL.ADD("Total9 = "~Fstr(val(q50),0,7)~", ")
         SQL.ADD("Tasa3  = "~Fstr(val(q51),0,7)~", ")
         SQL.ADD("Cantidad7 = "~Fstr(val(q52),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      If EQSTR(Dialogo.String, 'MMPCLM')
         * q20: Imp.Variable CEC q10: Imp.Total CEC q1: Importe IVA  q50: Imp.Interes
         * Q52: Imp_Cs_Fin_CEC    
         ACN(Q:20,IIF(FBN['RB6']=1,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Precio3']/100),0))
         ACN(Q:10,IIF(FBN['RB6']=1, FBN['Cantidad5']+val(q20), 0))
         ACN(Q:1,IIF(FBN['RB6']=1,((((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(FBN['RB7']=0,36000,36500))+val(q:10))*(FBN['ImpGastos2']/100)), ((FBN['Cantidad2']*((FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))+val(q:10))*(FBN['ImpGastos2']/100)))

         ACN(Q:3,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))

         * Impto.Interes
         ACN(Q:50,VAL(Q:3)*(FBN['TasaImp1']/100))

         * Imp_Cs_Fin_CEC
         ACN(Q:52,IIF(FBN['RB6']=1,VAL(Q:10)*(FBN['DeltaTasa']/100),0))
           
         ACN(Q:4, val(q:3)+IIF(FBN['RB6']=1,val(q:10)+VAL(q:52),0)+VAL(Q:50))

         ACN(Q:5,(FBN['Cantidad1']+val(q:3)))
         ACN(Q:6,(FBN['Cantidad1']+val(q:4)))

         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Cantidad4 = "~Fstr(val(q:20),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q:20),0,7)~", ")
         SQL.ADD("Cantidad6 = "~Fstr(val(q:10),0,7)~", ")
         SQL.ADD("Total4 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Total3 = "~Fstr(val(q:4),0,7)~", ")
         SQL.ADD("Total9 = "~Fstr(val(q:50),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q:5),0,7)~", ")
         SQL.ADD("Cantidad7 = "~Fstr(val(q:52),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q:6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      If EQSTR(Dialogo.String, 'MMPOSM')
         *- q21: Cen Variable q11: Cen Total  q1: Impte.Iva q2: Impte.WH
         *- q3: INTERES Q4: Interes Total q12:  Importe CEN en Equivalente
         ACN(Q:21,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['OPrecio2']*FBN['Plazo1'])/IIF(FBN['RB5']=0,36000,36500)),0))
         ACN(Q:11,IIF(FBN['RB6']=0, FBN['Cantidad5']+val(q:21), 0))

         ACN(Q:2,FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']/IIF(FBN['RB9']=1,36500,36000)*(FBN['TotalAux1']/100))
         ACN(Q:3,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
         ACN(Q:1,(val(q3)*(FBN['ImpGastos2']/100)))
         ACN(Q:12,FBN['Cantidad7']^IiF(EqStr(FBN['Check1'],'1'),1,-1)*VAL(Q11))

         * Impto.Interes
         ACN(Q:50,VAL(Q3)*(FBN['TasaImp1']/100))

         * Iva Cen
         ACN(Q51,VAL(Q11)*(FBN['IntDevengados1']/100))

         ACN(Q:4,val(q:2)+val(q:3)+val(q:11)+val(q:50))
         ACN(Q:5,FBN['Cantidad1']+val(q:3))
         ACN(Q:6,FBN['Cantidad1']+val(q:4))
  
         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Cantidad4 = "~Fstr(val(q:21),0,7)~", ")
         SQL.ADD("Precio8 = "~Fstr(val(q:21),0,7)~", ")
         SQL.ADD("Cantidad6 = "~Fstr(val(q:11),0,7)~", ")
         SQL.ADD("Cantidad8 = "~Fstr(val(q:12),0,2)~", ")
         SQL.ADD("Total4 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Total7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Total3 = "~Fstr(val(q:4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q:5),0,7)~", ")
         SQL.ADD("Total9 = "~Fstr(val(q:50),0,7)~", ")
         SQL.ADD("Tasa3  = "~Fstr(val(q:51),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q:6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      If EQSTR(Dialogo.String, 'MMONM')
         ACN(Q:3,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
         ACN(Q:1,IIF(FBN['ImpGastos2']=0,0,(val(q:3)*FBN['ImpGastos2']/100)))
         ACN(Q:2,IIF(FBN['CB10']=0,0,(val(q:3)*FBN['TotalAux1']/100)))

         ACN(Q:5,(FBN['Cantidad4']+val(q:3)))
         ACN(Q:6,FBN['Cantidad4']+val(q:4))

         * Impto.Interes -> Tasa3 es el % Imp.Interes
         ACN(Q:50,VAL(Q:3)*FBN['Tasa3']/100 )

         ACN(Q:4,val(q:3)+val(q:2)+val(q:50))
  
         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Precio1 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio3 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Cantidad5 = "~Fstr(val(q:4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q:5),0,7)~", ")
         SQL.ADD("Total9 = "~Fstr(val(q:50),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q:6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      If EQSTR(Dialogo.String, 'MMPCCM')
         ACN(Q:1,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(FBN['RB7']=0,36000,36500))*(FBN['ImpGastos2']/100),0))
         ACN(Q:2,IIF(FBN['RB6']=2 y FBN['MB3']=0,(((FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6'])/IIF(FBN['RB9']=1,36500,36000)) *(FBN['TotalAux1']/100)),0))
         ACN(Q:3,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))
         ACN(Q:30,IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=0],val(q:3)*FBN['TasaPrecan']/100,0))
         ACN(Q:4,val(q3)+IIF(FBN['RB6']=2 Y FBN['MB3']=0,val(q:2),0)+IIF(FBN['RB6']=4 Y FBN['MB3']=0,val(q:30),0))
         ACN(Q:5,(FBN['Cantidad1']+val(q:3)))
         ACN(Q:6,(FBN['Cantidad1']+val(q:4)))

         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Cantidad4 = "~Fstr(val(q:30),0,7)~", ")
         SQL.ADD("Precio8 = "~Fstr(val(q:30),0,7)~", ")
         SQL.ADD("Total4 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Total7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Total3 = "~Fstr(val(q:4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q:5),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q:6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      If Incluido(Dialogo.String, 'MMFIMV|MMSIMV')
         ACN(Q3,FBN['Cantidad2'] * ((FBN['Precio2'] + FBN['Precio4'])/100) * FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8'] +1))
         ACN(Q1,((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2']) / IIF(FBN['RB7']=0,36000,36500)) * (FBN['ImpGastos2']/100))
         ACN(Q2,((FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']) / IIF(FBN['RB9']=0,36000,36500)) * (FBN['TotalAux1']/100))

         * Impto.Interes
         ACN(Q50,VAL(Q3)*(FBN['TasaImp1']/100))

         ACN(Q:4,val(q:3)+iif(FBN['CB10']=1,val(q:2),0)+VAL(q:50))

         ACN(Q:5,(FBN['Cantidad4']+val(q:3)))
         ACN(Q:6,FBN['Cantidad4']+val(q:4))

         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Precio1 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q:1),0,7)~", ")
         SQL.ADD("Precio3 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q:2),0,7)~", ")
         SQL.ADD("Cantidad3 = "~Fstr(val(q:3),0,7)~", ")
         SQL.ADD("Cantidad5 = "~Fstr(val(q:4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q:5),0,7)~", ")
         SQL.ADD("Total9 = "~Fstr(val(q:50),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q:6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf
 
      If EqStr(Dialogo.String, 'MMCPM')
         * q1=iva, q2=importe percepcion iva, q3=interes, q20=importe neto iva, q21=imp imp
         * q4=interes neto, q5=monto, q6=monto neto

         ACN(Q:3,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,(fbn['Cantidad2']*(FBN['Spread']+fbn['Precio2'])*fbn['Plazo1'])/IIF(FBN['RB8']=0,36000,36500)))
         ACN(Q:1,IIF(NOT DESCIENDEDECLIENTE(FBN['ClienteOp'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['ClienteOp'])),VAL(Q:3)*FBN['ImpGastos2']/100,0))
         ACN(Q:2,IIF(NOT DESCIENDEDECLIENTE(FBN['ClienteOp'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['ClienteOp'])),val(q:3)*FBN['TotalAux2']/100,0))
         ACN(Q:20,IIF(NOT DESCIENDEDECLIENTE(FBN['ClienteOp'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['ClienteOp'])),VAL(Q:1) + VAL(Q:2),0))
         ACN(Q:21,IIF(DESCIENDEDECLIENTE(FBN['ClienteOp'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['ClienteOp'])),val(q:3)*FBN['ImpGastos1']/100,0))
         ACN(Q:4,val(q:3)-val(q:21))
         ACN(Q:5,FBN['Cantidad1']+val(q:3))
         ACN(Q:6,val(q:5)-val(q:21))

         SQL.ADD("Update "~DBO~".CUOTAS ")
         SQL.ADD("Set")
         SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
         SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
         SQL.ADD("Cantidad5 = "~Fstr(val(q1),0,7)~", ")
         SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
         SQL.ADD("Total5 = "~Fstr(val(q2),0,7)~", ")
         SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
         SQL.ADD("Cantidad6 = "~Fstr(val(q20),0,7)~", ")
         SQL.ADD("Cantidad4 = "~Fstr(val(q21),0,7)~", ")
         SQL.ADD("Precio8 = "~Fstr(val(q21),0,7)~", ")
         SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
         SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
         SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("and NrCuota = "~Fstr(FBN['NrCuota'],2,0)~" ")
         SQL.NEW
         SQL.EXEC
      EndIf

      *** Actualiza movimientos y limites ****
      SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
      SQL.EXEC

      ACT(i3,FBN['NrOperacion'])
      (.'MODIINSTAN'.)    
   Proximo
Proximo

If Val(BD:1)=0
   MessageBox('La operacion '~Dialogo.NrOperacion1~' no se encuentra vigente a la fecha '~Dialogo.Fecha1)  
EndIf