Acn(t:fac, Val(u:fac) + Fbn()['Plazo3'])
Acn(q:fac, (Fbn()['ImpGastos2'] / 100) * (Val(r:fac) + (Val(j:fac)) * ((Fbn()['Precio4'] + Val(av:fac)) / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], Fbn()['RB8'] + 1)))
Acn(p:fac, iif (Fbn()['RB6'] = 0, 0, iif (Fbn()['RB6'] = 2, Val(j:fac) * ((Fbn()['Precio4'] + Val(aw:fac)) / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], Fbn()['RB8'] + 1) * (Fbn()['TotalAux1'] / 100), Val(j:fac) * Val(aw:fac) / 100 * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], Fbn()['RB8'] + 1) * (Fbn()['TotalAux1'] / 100))))
Acn(o:fac, iif (Fbn()['NrCuota'] < Fbn()['PlazoGracia'], 0, Val(j:fac) * ((Fbn()['Precio4'] + Val(l:fac)) / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], Fbn()['RB8'] + 1)))
Acn(v:fac, iif (Fbn()['RB6'] = 0, Val(o:fac), iif (Fbn()['RB6'] = 1, Val(t:fac), 0)) * (Fbn()['TasaImp1'] / 100))
Acn(y:fac, iif (Fbn()['RB6'] = 0, Val(r:fac) * (Fbn()['DeltaTasa'] / 100), 0))
Acn(x:fac, Val(t:fac) * (Fbn()['IntDevengados1'] / 100))
Acn(ab:fac, Val(y:fac) + Val(v:fac) + Val(o:fac) + Val(r:fac) + Val(t:fac) + Val(p:fac))
Acn(z:fac, (Val(k:fac) + Val(o:fac)))
Acn(aa:fac, (Val(k:fac) + Val(ab:fac)))

