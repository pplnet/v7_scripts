* DTEXPO - Ingreso de Exposicion Mark to Market
*HojaVisible(Si)
CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;FSys
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))
  Cliente1 : 'ContraParte' ;;;;;;;;;;;
  Especie1 : 'Especie '    ;;;;;;;;;;;
FinDialogo

if not OK
  Cancelar
endif

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))
   EndIf
EndIf

SQL.ADD("Select O.*,0 NrCuota,0 Cant1,0 Cant2,'' Fecha1,'' Fecha2,'' Fecha5,'' Fecha6,0 Cant8 ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where ")
SQL.ADD(" ((TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(dialogo.fecha1)~"' and O.FechaEj>='"~IdxDate(dialogo.fecha1)~"')   ")
SQL.ADD(" or (TipoOp IN ('DTO','DTOV') and O.FechaOp2<='"~IdxDate(dialogo.fecha1)~"' and O.FechaEj>'"~IdxDate(dialogo.fecha1)~"')) ")
if NoVacio(Val(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie='"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD("  Union All ")
SQL.ADD("Select O.*,C.NrCuota, C.Cantidad1 Cant1,C.Cantidad2 Cant2,C.Fecha1,C.Fecha2,C.Fecha5,C.Fecha6,C.Cantidad8 Cant8 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and ((TipoOp IN ('DTC','DTF','DTK','DTKVI','DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(dialogo.fecha1)~"' and C.Fecha2>'"~IdxDate(dialogo.fecha1)~"') ")
SQL.ADD("  or (TipoOp IN ('DTOM','DTOMV') and  C.Fecha2>'"~IdxDate(dialogo.fecha1)~"') ")
SQL.ADD("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(dialogo.fecha1)~"')) ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie='"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD(" order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")

SetFilaActual(1)

Recorrer SQL

  If Incluido(FBN['TipoOp'],'DTO|DTOV|DTSFV|DTSFF|DTSVV|DTSFVV')
     acn(a:fac, fbn('TCComCor2'))
  Else
     acn(a:fac, fbn('Cant8'))
  EndIf

  ACT(b:FAC, FBN['NrOperacion'])
  ACT(c:FAC, FBN['Cliente1'])
  ACT(d:FAC, FBN['TipoOp'])
  ACT(e:FAC, FBN('TipoTasa'))
  ACN(f:FAC, FBN('PrecioEj'))
  ACN(g:FAC, FBN['Cantidad'])
  ACN(h:FAC, FBN['NrCuota'])

  If Incluido(FBN['TipoOp'],'DTSFV|DTSFF|DTSVV|DTSFVV')
     ACN(i:FAC, FBN['FechaOp2'])
     ACN(j:FAC, FBN['FechaEj'])
  EndIf

  If Incluido(FBN['TipoOp'],'DTO|DTOV')
     ACN(i:FAC, FBN['FechaEx1'])
     ACN(j:FAC, FBN['FechaEx2'])
  EndIf

  If Incluido(FBN['TipoOp'],'DTC|DTF|DTK|DTKVI|DTSFFM|DTSFVM|DTSFVX|DTSVVM|DTSNFV')
     ACN(i:FAC, FBN['Fecha1'])
     ACN(j:FAC, FBN['Fecha2'])
  EndIf

  If Incluido(FBN['TipoOp'],'DTOM|DTOMV')
     ACN(i:FAC, FBN['Fecha5'])
     ACN(j:FAC, FBN['Fecha6'])
  EndIf

Proximo

*- Valores del Dialogo
ACD(z1,Dialogo.Fecha1)
ACT(z2,Dialogo.Lista1)
ACT(z3,Dialogo.Cliente1)
ACT(z4,Dialogo.Especie1)
 

IF fac>2
   *-- Hay datos para mostrar
   Recorrer&j 1,1000
      CrearDialogo
          Fecha1   : 'Fecha'       ;1;1;;NO;;;;;VAL(z1)
          Cliente1 : 'ContraParte' ;1;2;;NO;;;;;VAL(z3);;
          String1  : 'Vehiculo'    ;2;1;;NO;;;;;VAL(Z2)
          Especie1 : 'Especie '    ; ; ;;NO;;;;;VAL(z4);;
          ListBox; 'Arial,8,N'; 500; 180
           'Exposicion'      ;a2..a:fac;  ;;;;80;NUMERO;'#,###,###,###.##'
           'Nr.Op'           ;b2..b:fac;NO;;;;60;STRING
           'Cliente'         ;c2..c:fac;NO;;;;50;STRING
           'Producto'        ;d2..d:fac;NO;;;;40;STRING
           'TTasa'           ;e2..e:fac;NO;;;;40;STRING
           'P.Strike'        ;f2..f:fac;NO;;;;50;STRING
           'Cantidad'        ;g2..g:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
           'NrCuota'         ;h2..h:fac;NO;;;;40;NUMERO;'###'
           'F.Inicio'        ;i2..i:fac;NO;;;;;FECHA
           'F.Fin'           ;j2..j:fac;NO;;;;;FECHA
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      ACN(k2,0)
      ACN(k1,0)

      *Recorrer&i 2,FAC
      *   If Val(a:&i)=0          
      *      ACN(k1,0)
      *      SCN(k2,1)
      *      ACN(k1,MessageBox("La Exposicion "~Val(b:&i)~"/"~Val(c:&i)~"-"~Val(d:&i)~" Es Incorrecta. Continua? ",2,1))

      *      IF VAL(k1)=2
      *         Break
      *      EndIf 
      *   EndIf 
      *Proximo

      IF VAL(k1)<>1 
         Break
      EndIf 
   Proximo

   * No cancelo y no hay valores en 0
   IF VAL(k1)<>2 y VAL(k2)=0
      *-- El primer renglon es de totales
      Recorrer&i 2,FAC

         If NoVacio(VAL(b:&i))

            Message("Actualizando "~Val(b:&i)~"/"~Val(c:&i)~" - "~Val(d:&i)~" ... ")

            If Incluido(Val(d:&i),'DTO|DTOV|DTSFV|DTSFF|DTSVV|DTSFVV')
               *-- Actualizo la Operacion SI ES UNICO VTO.
               SQL.ADD("UPDATE "~DBO~".OPERACIONES Set ")
               SQL.ADD(" TCComCor2="~Fstr(Val(a:&i),0,7)~" ")
               SQL.ADD(" Where NrOperacion='"~Val(b:&i)~"' ")
               SQL.NEW
            Else 
               *-- Actualizo el Nro. de cuota SI ES Multiple Vto.
               SQL.ADD("UPDATE "~DBO~".CUOTAS Set ")
               SQL.ADD(" Cantidad8="~Fstr(Val(a:&i),0,7)~" ")
               SQL.ADD(" Where NrOperacion='"~Val(b:&i)~"' ")
               SQL.ADD(" and NrCuota="~Fstr(Val(h:&i),0,0)~" ")
               SQL.NEW
            EndIf
            SQL.EXEC
         Endif
      Proximo
   EndIf
EndIf

