CrearDialogo
	Archivo1: "Path TXT Origen:" ;1;1;;;;NOVACIO(Dialogo.Archivo1);'Archivo TXT Origen Invalido';NO;;'C:\FPA\Lista.TXT';;;"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	Archivo2: "Carpeta Destino:" ;2;1;;;;NOVACIO(Dialogo.Archivo2);'Carpeta Destino Invalido' ;NO;;'C:\FPA\';;;"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	String3:  "Sufijo Archivos:" ;3;1;;;;NOVACIO(Dialogo.String3);'Sufijo Archivos Invalido';NO;;'_Nuevo.TXT'
FinDialogo

IF NOT Ok
	Cancelar
ENDIF

ACT(A1, ExportarPPL(Dialogo.Archivo1, Dialogo.Archivo2, Dialogo.String3))

IF EqStr(VAL(A1),'000-OK')
	MESSAGEBOX('Proceso Finalizo con Exito!')
ELSE
	MESSAGEBOX('Error '~VAL(A1))
ENDIF