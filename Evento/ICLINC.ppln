creardialogo
fecha1:'Fecha';;;;;;;;;;FSys()
fecha2:'Fecha FMes';;;;NO;;;;;;FinDeMes(Habiles(dialogo.fecha1, -1, 'ARG', SI), SI)
nroperacion1:'Operacion';;;;;;;;;;;;;;"TipoOp In ('CONU') and   FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' and (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1) "
cantidad1:'Interes';;;;;;dialogo.cantidad1 > 0;'Debe Ingresar Interes a Capitalizar';NO;
vehiculo1:'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
check1:'Manual';;;;NO;NO;;;;;1
findialogo

if (not ok)
Cancelar()
endif


Acn(co:1, Query("Select PrecioContable From "~Dbo()~".COTIZACIONES WHERE Codigo='"~Var('MONEEXTR')~"' and (CallPut='CON' or CallPut is Null) and Moneda = '"~Var('MONELOCA')~"' and Fecha= (Select max(C.Fecha) From "~Dbo()~".COTIZACIONES C WHERE Codigo='"~Var('MONEEXTR')~"' and (CallPut='CON' or CallPut is Null) and Moneda = '"~Var('MONELOCA')~"' and C.Fecha <= '"~IdxDate(dialogo.fecha2)~"')  "))

Acn(wt:1, Round(dialogo.cantidad1 * Var('ICLWTH') / 100, 2))

Acn(iv:1, Round(dialogo.cantidad1 * Var('ICLBIVA') / 100 * Var('ICLIVA') / 100, 2))
Acn(iv:2, dialogo.cantidad1 * Var('ICLBIVA') / 100)

Acn(fl:1, 0)

if (Query(" Select 1 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and  Fecha1= '"~IdxDate(dialogo.fecha1)~"' and Radio1 = '3'  ") > 0)
if (Query(" Select 1 from "~Dbo()~".MOVEJECUTADOS where NrOperacion='"~dialogo.nroperacion1~"' and  FechaMov = '"~IdxDate(dialogo.fecha1)~"' Group by NrOperacion  ") > 0)
if (dialogo.check1 = 1)
Messagebox('Hay Liquidaciones de Impuestos realizadas - debera anularla para porder reprocesar - CONU '~dialogo.nroperacion1)
Cancelar('Se cancela el proceso de Capitalizacion de Intereses ICL')
else
Acn(fl:1, 1)
endif
else
Message('Borrando devengados del dia ... ')
Sqladd("DELETE FROM "~Dbo()~".CUOTAS  ")
Sqladd(" WHERE Fecha1        = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND   Radio1        = '3'  ")
Sqladd(" AND   NrOperacion   = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Message('Borrando Movimientos del dia ... ')
Sqladd("DELETE FROM "~Dbo()~".MOVPENDIENTES  ")
Sqladd(" WHERE FechaMov      = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND   NrOperacion   = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
endif

endif

if (Val(fl:1) = 0)
Acn(ct:1, Query("Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion='"~dialogo.nroperacion1~"' ") + 1)

Message('Generando CUOTA Interes Capitalizado ... ')
Sqladd(" INSERT INTO "~Dbo()~".CUOTAS ( ")
Sqladd(" NrOperacion, NrCuota, Radio1, Fecha1, Cantidad1, Cantidad5, Cantidad2, ")
Sqladd(" Cantidad3, Cantidad6, Cantidad4, Precio1,  Precio2, Precio3, ")
Sqladd("  NrOperacion1")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~dialogo.nroperacion1~"', "~Val(ct:1)~",  '3', '"~IdxDate(dialogo.fecha1)~"', "~FStr((dialogo.cantidad1 - Val(wt:1)) * -1, 0, 2)~", "~FStr(dialogo.cantidad1, 0, 2)~", "~FStr(0, 0, 2)~",")
Sqladd(" "~FStr(Val(iv:1), 0, 2)~", "~FStr(Val(iv:2), 0, 2)~","~FStr(Val(wt:1), 0, 2)~", "~FStr(Val(co:1), 0, 8)~", "~FStr(Var('ICLIVA'), 0, 8)~", "~FStr(Var('ICLWTH'), 0, 8)~", ")
Sqladd(" '"~dialogo.nroperacion1~"' ")
Sqladd(" ) ")
Sqlnew()

Sqladd(" Select NrOperacion, Cliente2, ContraEspecie2, Cuenta1, Cuenta2, Mercado2, Book1 ")
Sqladd(" from "~Dbo()~".OPERACIONES ")
Sqladd(" where NrOperacion = '"~dialogo.nroperacion1~"' ")
Watch(Sqlbatch())

recorrer sql

Message('Generando Movimientos IVA - WTH ... ')
Act(mp1, dialogo.nroperacion1)
Acd(mp2, dialogo.fecha1)
Acd(mp17, dialogo.fecha1)
Act(mp3, Fbn()['Cliente2'])
Act(mp4, Fbn()['ContraEspecie2'])
Act(mp5, '')
Act(mp6, '')
Acn(mp7, 0)
Act(mp8, Fbn()['Mercado2'])
Act(mp9, dialogo.vehiculo1)
Acn(mp10, Val(iv:1) * Val(co:1))
Act(mp12, 'IVA por Intereses CONU '~Val(mp3)~' - '~Val(mp1))
Act(mp13, 'MV')
Acn(mp14, 1)
Acn(mp15, 1)
Act(mp16, 'MM')
Act(mp19, Fbn()['Cuenta2'])
Acn(mp22, 1)
Act(mp30, dialogo.vehiculo1)
if (Eqstr(Val(mp13), 'AV') y Val(mp2) <= FSys())
Sqladd("INSERT INTO "~Dbo()~".MOVEJECUTADOS (")
else
Sqladd("INSERT INTO "~Dbo()~".MOVPENDIENTES (")
endif
Sqladd("NrOperacion,FechaMov,")
Sqladd("Cliente,Especie,")
Sqladd("CallPut,")
if (Incluido(Val(mp5), 'CAL|PUT'))
Sqladd("FechaEj,PrecioEj,")
endif
Sqladd("Mercado,")
Sqladd("EnteCustodia,Cantidad,")
Sqladd("Formula,Leyenda,")
Sqladd("Bits,NrSaldo,")
Sqladd("NrGrupo,Concepto,")
Sqladd("FechaEje,UsuarioEje,")
Sqladd("Cuenta,NrGrupo2,")
Sqladd("Transaccion,NrMov,")
Sqladd("NrLiq,Status,")
Sqladd("NrComprob,NrInstan,")
Sqladd("Cupon,NrTrans2,")
Sqladd("Book,Vehiculo")
Sqladd(") Values (")
Sqladd(" '"~Val(mp1)~"',")
Sqladd(" '"~IdxDate(Val(mp2))~"',")
Sqladd(" '"~Val(mp3)~"', ")
Sqladd(" '"~Val(mp4)~"',")
Sqladd(" '"~Val(mp5)~"',")
if (Incluido(Val(mp5), 'CAL|PUT'))
Sqladd(" '"~IdxDate(Val(mp6))~"',"~FStr(Val(mp7), 0, 6)~", ")
endif
Sqladd(" '"~Val(mp8)~"',")
Sqladd(" '"~Val(mp9)~"',")
Sqladd(" "~FStr(Val(mp10), 0, 2)~", ")
Sqladd(" '"~Val(mp11)~"', ")
Sqladd(" '"~Copy(Val(mp12), 1, 50)~"', ")
Sqladd(" '"~Val(mp13)~"', ")
Sqladd(" "~FStr(Val(mp14), 0, 0)~", ")
Sqladd(" "~FStr(Val(mp15), 0, 0)~",")
Sqladd(" '"~Val(mp16)~"',")
Sqladd(" '"~IdxDate(FSys())~"','"~Val(mp18)~"',")
Sqladd(" '"~Val(mp19)~"',"~FStr(Val(mp20), 0, 0)~",")
Sqladd(" '"~Val(mp21)~"',"~FStr(Val(mp22), 0, 0)~",")
if (Vacio(Val(mp24)))
Sqladd(" "~FStr(Val(mp23), 0, 2)~",Null,")
else
Sqladd(" "~FStr(Val(mp23), 0, 2)~",'"~Val(mp24)~"',")
endif
Sqladd(" "~FStr(Val(mp25), 0, 0)~", ")
if (Val(mp:26) <> 0)
Sqladd(" "~FStr(Val(mp26), 0, 6)~",")
else
Sqladd(" "~FStr(Val(mp26), 0, 6)~",")
endif
Sqladd(" '"~Val(mp27)~"','"~Val(mp28)~"',")
Sqladd(" '"~Val(mp29)~"','"~Val(mp30)~"' ")
Sqladd(" )")
Sqlnew()
Sqlexec()

if (DesciendeDeEspecie(Val(mp4), 'MONEDA') y Eqstr(Val(mp8), Var('MERCADOBT')))
endif


Acn(mp10, Val(wt:1) * Val(co:1))
Act(mp12, 'WTH por CONU '~Val(mp3)~' - '~Val(mp1))
Act(mp16, 'MM')
Acn(mp22, 2)
if (Eqstr(Val(mp13), 'AV') y Val(mp2) <= FSys())
Sqladd("INSERT INTO "~Dbo()~".MOVEJECUTADOS (")
else
Sqladd("INSERT INTO "~Dbo()~".MOVPENDIENTES (")
endif
Sqladd("NrOperacion,FechaMov,")
Sqladd("Cliente,Especie,")
Sqladd("CallPut,")
if (Incluido(Val(mp5), 'CAL|PUT'))
Sqladd("FechaEj,PrecioEj,")
endif
Sqladd("Mercado,")
Sqladd("EnteCustodia,Cantidad,")
Sqladd("Formula,Leyenda,")
Sqladd("Bits,NrSaldo,")
Sqladd("NrGrupo,Concepto,")
Sqladd("FechaEje,UsuarioEje,")
Sqladd("Cuenta,NrGrupo2,")
Sqladd("Transaccion,NrMov,")
Sqladd("NrLiq,Status,")
Sqladd("NrComprob,NrInstan,")
Sqladd("Cupon,NrTrans2,")
Sqladd("Book,Vehiculo")
Sqladd(") Values (")
Sqladd(" '"~Val(mp1)~"',")
Sqladd(" '"~IdxDate(Val(mp2))~"',")
Sqladd(" '"~Val(mp3)~"', ")
Sqladd(" '"~Val(mp4)~"',")
Sqladd(" '"~Val(mp5)~"',")
if (Incluido(Val(mp5), 'CAL|PUT'))
Sqladd(" '"~IdxDate(Val(mp6))~"',"~FStr(Val(mp7), 0, 6)~", ")
endif
Sqladd(" '"~Val(mp8)~"',")
Sqladd(" '"~Val(mp9)~"',")
Sqladd(" "~FStr(Val(mp10), 0, 2)~", ")
Sqladd(" '"~Val(mp11)~"', ")
Sqladd(" '"~Copy(Val(mp12), 1, 50)~"', ")
Sqladd(" '"~Val(mp13)~"', ")
Sqladd(" "~FStr(Val(mp14), 0, 0)~", ")
Sqladd(" "~FStr(Val(mp15), 0, 0)~",")
Sqladd(" '"~Val(mp16)~"',")
Sqladd(" '"~IdxDate(FSys())~"','"~Val(mp18)~"',")
Sqladd(" '"~Val(mp19)~"',"~FStr(Val(mp20), 0, 0)~",")
Sqladd(" '"~Val(mp21)~"',"~FStr(Val(mp22), 0, 0)~",")
if (Vacio(Val(mp24)))
Sqladd(" "~FStr(Val(mp23), 0, 2)~",Null,")
else
Sqladd(" "~FStr(Val(mp23), 0, 2)~",'"~Val(mp24)~"',")
endif
Sqladd(" "~FStr(Val(mp25), 0, 0)~", ")
if (Val(mp:26) <> 0)
Sqladd(" "~FStr(Val(mp26), 0, 6)~",")
else
Sqladd(" "~FStr(Val(mp26), 0, 6)~",")
endif
Sqladd(" '"~Val(mp27)~"','"~Val(mp28)~"',")
Sqladd(" '"~Val(mp29)~"','"~Val(mp30)~"' ")
Sqladd(" )")
Sqlnew()
Sqlexec()

if (DesciendeDeEspecie(Val(mp4), 'MONEDA') y Eqstr(Val(mp8), Var('MERCADOBT')))
endif


proximo

Sqlexec()
endif
