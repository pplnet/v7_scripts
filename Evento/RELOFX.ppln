Sqladd(" Select * from "~Dbo()~".OPERACIONES T WHERE TipoOp in ('FXREPO','FXREPV') ")
Sqladd(" and (RB1='0' or RB1 IS NULL) ")
Sqladd(" ORDER BY NrOperacion ")

