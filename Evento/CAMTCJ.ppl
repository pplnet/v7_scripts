ACT(lo:1,'MMCAUT|MMCO|MMCT|MMPO|MMPOCE|MMOVNO|MMOVNT|MMDD|MMPF|')
ACT(lo:2,'MMPFV|MMPOV|')

HojaVisible(NO)
MostrarCuadrodeMensajes
CrearDialogo
  Fecha3      : 'D.Concert';;;;;;Dialogo.Fecha3 <= Dialogo.Fecha4;'Fecha_Desde no es Valida';NO;Habiles(Fsys,-2,Var('FERIDEF'),SI);IIf(MODI,Dialogo.Fecha3, Habiles(Dialogo.Fecha4,-2,Var('FERIDEF'),SI) ) 
  Fecha4      : 'H.Concert';;;;;;Dialogo.Fecha4 <= FSys ;'Fecha_Hasta no es Valida';NO;Fsys;
  Cliente1    : 'Cliente'
  Especie1    : 'Moneda'   ;;;;;;;;;;;SQLSet("Select Codigo From "~DBO~".ESPECIES Where Jerarquia Like '001%' and Codigo Not In ("~Pipe2Comillas(Var('JERMON'))~") order by Codigo ")
  TipoOp1     : 'TipoOper' ;;;;;;Vacio(Dialogo.TipoOp1) o Incluido(Dialogo.TipoOp1,Val(lo:1)~Val(lo:2));'TipoOp Erronea!!!';NO;;;SQLSet("Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ("~Pipe2Comillas(Val(lo:1)~Val(lo:2))~") ");;;
  NrOperacion1: 'Operacion';;;;;;;;;;;;;; IIF(Vacio(Dialogo.TipoOp1), " TipoOp In ("~Pipe2Comillas(Val(lo:1)~Val(lo:2))~") " , " TipoOp = '"~Dialogo.TipoOp1~"' " )~" and (RB6 Is Null or RB6='0') and FechaOp <= "~IdxDate2(Dialogo.Fecha3)~iif(Vacio(Dialogo.Especie1)," "," and Especie = '"~Dialogo.Especie1~"' ")~iif(Vacio(Dialogo.Cliente1)," "," and Cliente1 = '"~Dialogo.Cliente1~"' " )
FinDialogo


If Not OK
   Cancelar
Endif

message('Recuperando Operaciones...')
SQL.ADD("Select NrOperacion, 1 NrCuota, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, ")
SQL.ADD("       TasaBase,Precio4,Spread,Precio2,Vehiculo1, Cuenta3, TotalBrutoCli1,Observac4,")
SQL.ADD("       Precio3, FechaVto, TablaFeriados1,RB6,CB9,TipoCambio2,TipoCambio3,")
SQL.ADD("       OficialCuenta,Plazo2,TipoTasa,Ley10,LineaPrestamo,MB3,CB6 ")
SQL.ADD("  From "~DBO~".OPERACIONES ")
SQL.ADD(" Where FechaOp >= "~IdxDate2(Dialogo.Fecha3))
SQL.ADD("   and FechaOp <= "~IdxDate2(Dialogo.Fecha4))
SQL.ADD("   and NVL(RB6,0) Not In (0,1,2,7)  ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.TipoOp1)
  SQL.ADD(" and TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Val(lo:1))~") ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif


*-----------------------------------------------------------------------------------------
*--OJO PORQUE AYBAR NO DEFINIO LOS CROS para MMPOV y MMPFV !!!----------------------------

SQL.ADD(" Union all ")

SQL.ADD("Select O.NrOperacion,CU.NrCuota, O.Cliente1, O.Especie, O.TipoOp, CU.Cantidad12 Cantidad, CU.Cantidad28 Precio1, CU.Plazo1 Plazo, CU.Fecha9 FechaOp, ")
SQL.ADD("       CU.Cantidad31 TasaBase,O.Precio4,O.Spread,O.Precio2,O.Vehiculo1, O.Cuenta3, O.TotalBrutoCli1,O.Observac4,")
SQL.ADD("       O.Precio3, CU.Fecha2 FechaVto, O.TablaFeriados1,O.RB6,O.CB9,O.TipoCambio2,O.TipoCambio3,")
SQL.ADD("       O.OficialCuenta,O.Plazo2,O.TipoTasa,O.Ley10,O.LineaPrestamo,O.MB3,O.CB6 ")
SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".CUOTASPRESTAMO CU ")
SQL.ADD(" Where CU.Fecha9 >= "~IdxDate2(Dialogo.Fecha3))
SQL.ADD("   and CU.Fecha9 <= "~IdxDate2(Dialogo.Fecha4))
SQL.ADD("   and O.NrOperacion = CU.NrOperacion ")
SQL.ADD("   and (NVL(O.RB6,0) Not In (0,1,2,7) or NVL(CU.Check8,0)=1) ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.TipoOp1)
  SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Val(lo:2))~") ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif


SQL.ADD(" Order by 3, 4, 5, 1, 2 ")

ACN(az1, 0)
ACD(q1, Fsys)

Recorrer SQL

      message('...'~fbn['NrOperacion']) 

      ACN(ab:fac, 0)
      ACT(a:fac, fbn['Cliente1'])
      ACT(w:fac, Copy( IIf(NoVacio(fbn['Observac4']),fbn['Observac4'],BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])),1,15) )
      ACT(b:fac, fbn['Especie'])
      ACT(c:fac, fbn['TipoOp'])
      ACN(d:fac, iif(Eqstr(fbn['TipoOp'],'MMDD'),fbn['TotalBrutoCli1'],fbn['Cantidad'])  )
      ACT(g:fac, fbn['NrOperacion'])
      ACN(j:fac, fbn['Precio1'])
      ACN(k:fac, fbn['Spread'])
      ACT(m:fac, IIf(Vacio(fbn['LineaPrestamo']),'', fbn['LineaPrestamo']~'-'~Trim(BuscarCampo('LINEASPRESTAMO','Descripcion','Codigo',fbn['LineaPrestamo']) ))  )
      ACD(s:fac, fbn['FechaVto'])
      ACD(t:fac, fbn['FechaOp'])
      ACT(v:fac, fbn('Ley10'))
      ACT(av:fac, fbn('Ley10'))
      ACN(u:fac, fbn['TasaBase'] )
      ACN(au:fac, fbn['TasaBase'] )
      ACN(y:fac , iif(Eqstr(fbn['TipoOp'],'MMDD'),fbn['Plazo2'],fbn['Plazo']) )
      ACT(x:fac , iif(NoVacio(fbn['TipoTasa']),fbn['TipoTasa'],Var('TASAREFER')) )
      ACN(be:fac, Num(fbn['CB6']))
      ACT(jj:fac,fbn('RB6'))
      ACN(be:fac, iif(Not Incluido(fbn['TipoOp'],'MMCAUT|MMCT|MMCO|') y fbn['TasaBase']=0,0,1) )

      ACN(cu:fac, fbn['NrCuota'])
      ACN(h:fac, SQL("Select Sum(Cantidad2) From "~DBO~".CUOTAS Where NrOperacion='"~FBN('NrOperacion')~"' "))
      ACN(i:fac, Val(d:fac)-Val(h:fac))

      SCN(az1,1) 
Proximo


If Val(az1) = 0
  Cancelar('No existen operaciones con estas caracteristicas para Cambiarles la TCI!!!')
Endif

Recorrer&i 1,20

  CrearListBox ; 'Arial,8,' ; 'Cambio de TCI Operaciones VENCIDAS Concertadas del '~Fecha(Dialogo.Fecha3)~' al '~Fecha(Dialogo.Fecha4)
    'OK'            ;ab1..ab:fac;SI;;;30;CHECK;RGB(220,220,193)
    'TipoOp'        ;c1..c:fac;NO;;;45;STRING;;RGB(180,180,193)
    'Operacion'     ;g1..g:fac;NO;;;60;STRING;;RGB(180,180,193)
    'Cliente'       ;a1..a:fac;NO;;;70;STRING;;RGB(180,180,193)
    'RazonSocial'   ;w1..w:fac;NO;;;100;STRING;;RGB(180,180,193)
    'Especie'       ;b1..b:fac;NO;;;40;STRING;;RGB(180,180,193)
    'F.Concert'     ;t1..t:fac;NO;;;65;FECHA;RGB(180,180,193)
    'Plazo'         ;y1..y:fac;NO;;;35;NUMERO;'###';RGB(180,180,193)
    'Tasa'          ;j1..j:fac;NO;;;50;NUMERO;'###.######';RGB(180,180,193)
    'Spread'        ;k1..k:fac;NO;;;50;NUMERO;'###.######';RGB(180,180,193)
    'TasaRef'       ;x1..x:fac;SI;Val(ab:FLB)=0 o NoVacio(Val(x:FLB));'Error, debe seleccionar Tipo Tasa Referencial!';50;STRING;;RGB(220,220,193);
    Var('TASAREFER');u1..u:fac;SI;Val(ab:FLB)=0 o Val(u:FLB)>0;'ERROR, Falta TCI!!!';50;NUMERO;'###.######';RGB(220,220,193)
    'Especial'      ;be1..be:fac;NO;;;45;CHECK;RGB(220,220,193)
    'Autorizo_TCI'  ;v1..v:fac;SI;;;75;STRING;10;RGB(220,220,193);
    'Cros_Alta'     ;ac1..ac:fac;NO;;;65;FECHA;RGB(240,190,130)
    'F.Vto'         ;s1..s:fac;NO;;;65;FECHA;RGB(180,180,193)
    'Linea'         ;m1..m:fac;NO;;;90;STRING;;RGB(180,180,193)
    'Monto'         ;d1..d:fac;NO;;;85;NUMERO;'###,###,###.##';RGB(180,180,193)
    'Prepago'       ;h1..h:fac;NO;;;80;NUMERO;'###,###,###.##';RGB(180,180,193)
    'Saldo'         ;i1..i:fac;NO;;;80;NUMERO;'###,###,###.##';RGB(180,180,193)
    'Periodo'       ;cu1..cu:fac;NO;;;60;NUMERO;'###';RGB(180,180,193)
  FinListBox

  If Not OK
     Cancelar('Evento Cambio TCI para MMKTS, ha sido Cancelado!!!')
  Else
     If 1=Messagebox('Confirma Cambio de datos de TCI???',3,1)
       If Sum(ab:1..ab:fac) >0
          Break
       Else
          messagebox('ERROR, deberia seleccionar al menos una operacion para Cambiarle la TCI!!!')
       Endif
     Endif 
  Endif

Proximo


message('Actualizando Operaciones ')
Recorrer&i 1,Val(az1)

  If Val(ab:&i)=1

     message('...'~Val(g:&i))

     SQL.ADD("Update "~DBO~".OPERACIONES ")  
     SQL.ADD("   Set Ley10 = '"~Val(v:&i)~"', ")
     SQL.ADD("       TipoTasa = '"~Val(x:&i)~"', ")
     SQL.ADD("       TasaBase = "~Fstr(Val(u:&i),0,7)~",")
     SQL.ADD("       CB6 = '"~Fstr(Val(be:&i),0)~"' ")
     SQL.ADD(" Where NrOperacion = '"~Val(g:&i)~"' ")
     SQL.NEW

     If Not Eqstr(Val(v:&i),Val(av:&i)) 
        SQL.ADD("Insert into "~DBO~".EXCEPCIONES ")
        SQL.ADD("       (NrOperacion, Tipo, Fecha, Descripcion) ")
        SQL.ADD("Values ('"~Val(g:&i)~"','TCI',"~IdxDate2(FSys)~", ")
        SQL.ADD("  'Autorizo Spread Negativo "~Copy(Val(v:&i),0,10)~"' ) ")
        SQL.NEW
     Endif

     If Incluido(Val(c:&i),Val(lo:2))
        SQL.ADD("Update "~DBO~".CUOTASPRESTAMO Set Cantidad31 = "~Fstr(Val(u:&i),0,7)~",Cantidad32 = "~Fstr(Val(au:&i),0,7) )
        SQL.ADD(" Where NrOperacion = '"~Val(g:&i)~"' and NrCuota = "~Fstr(Val(cu:&i),0) )
        SQL.NEW
     Endif


     SQL.EXEC

  Endif

Proximo


Messagebox('Cambio de TCI Operaciones VENCIDAS, Finalizo OK!!!')
