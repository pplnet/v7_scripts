Sqladd("Select P.* From "~Dbo()~".POSICIONES P ")
Sqladd(" Where P.TipoNegocio      = 'SEC' ")
Sqladd("   and P.CantidadFin     <> 0 ")
Sqladd("   and P.NrSaldo         in (120,130) ")
Sqladd("   and P.Especie          = '"~Fbn('Especie2')~"' ")
Sqladd("   and P.Vehiculo         = '"~Fbn('Vehiculo1')~"' ")
Sqladd("   and IsNull(P.Cupon,'') = '"~Val(h:fac)~"' ")
Sqladd("   and P.Fecha           <= '"~IdxDate(Val(c:fac))~"' ")
Sqladd("   and P.Fecha = (Select MAX(P1.Fecha) ")
Sqladd("                    From "~Dbo()~".POSICIONES P1 ")
Sqladd("                   Where P1.Vehiculo        = P.Vehiculo ")
Sqladd("                     and P1.TipoNegocio     = P.TipoNegocio ")
Sqladd("                     and P1.Cliente         = P.Cliente ")
Sqladd("                     and P1.Especie         = P.Especie ")
Sqladd("                     and P1.Cupon           = P.Cupon ")
Sqladd("                     and P1.NrSaldo         = P.NrSaldo ")
Sqladd("                     and IsNull(P1.Book,'') = IsNull(P.Book,'') ")
Sqladd("                     and P1.Fecha           < '"~IdxDate(Val(c:fac))~"' ")
Sqladd("                 ) ")
Sqladd(" order by NrSaldo,Especie,Cupon,Vehiculo,Fecha ")
recorrer sql
