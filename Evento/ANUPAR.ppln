recorrer&i 1, Fac()
if (Val(a:&i) = 1)
Message('Actualizando Operacion '~Val(b:&i))

Sqladd(" UPDATE "~Dbo()~".MOVPENDIENTES SET                  ")
Sqladd(" Cantidad  = Cantidad + (SELECT Cantidad from      ")
Sqladd(" "~Dbo()~".MOVPENDIENTES WHERE NrOperacion = '"~Val(b:&i)~"' and NrComprob is not null)   ")
Sqladd(" WHERE NrOperacion   = '"~Val(b:&i)~"'             ")
Sqladd(" AND   Especie       = '"~Val(c:&i)~"'             ")
Sqladd(" AND   NrComprob is null                           ")
Sqlnew()

Sqladd(" DELETE FROM "~Dbo()~".MOVPENDIENTES                 ")
Sqladd(" WHERE NrOperacion  = '"~Val(b:&i)~"'              ")
Sqladd(" AND   Especie ='"~Val(c:&i)~"'                    ")
Sqladd(" AND   NrComprob is not null                       ")
Sqlnew()

Sqlexec()
