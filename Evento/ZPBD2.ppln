sql.add(" SELECT /*+ RULE */ DISTINCT T.Fecha1, T.Especie, T.Cantidad1, M.Cuenta Cuenta1, T.Cuenta2, T.Vehiculo1, T.Cliente1, ")
sql.add(" B1.Alias2 Banco1, B2.Alias2 Banco2, C1.Numero Numero1, C2.Numero Numero2, T.CB3,  ")
sql.add(" DECODE(C1.TipoCuenta, 'CC ','01','CA ','02','CCE','02','CCD','15','Error') Tipo1, ")
sql.add(" DECODE(C2.TipoCuenta, 'CC ','01','CA ','02','CCE','02','CCD','15','Error') Tipo2, ")
sql.add(" M.FechaMov, 'CTAR' Tipo, 'D' DC, ' ' CliDatanet, T.Fecha2, T.NrTrans, C1.Alias3 CtaDat, C2.Alias1 CBU ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B,  ")
sql.add(" "~Dbo()~".CUENTAS C1, "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".CUENTAS C2, "~Dbo()~".CLIENTES B1, "~Dbo()~".CLIENTES B2 ")
sql.add(" WHERE T.NrOperacionRef1 = O.NrOperacion ")
sql.add(" AND   T.NrTrans     = B.NrOperacion ")
sql.add(" AND   T.Cuenta2     = C2.Codigo ")
sql.add(" AND   M.Cuenta      = C1.Codigo ")
sql.add(" AND   T.NrOperacionRef1 = M.NrOperacion ")
sql.add(" AND   C1.Comitente   = B1.Codigo ")
sql.add(" AND   C2.Cliente     = B2.Codigo ")
sql.add(" AND   T.Fecha1    = "~IdxDate2(dialogo.fecha1)~"  ")
sql.add(" AND   O.TipoOp      IN ('MMCCR') ")
sql.add(" AND   T.Vehiculo1 = '"~dialogo.vehiculo1~"'  ")
sql.add(" AND   T.Especie     = 'ARP' ")
sql.add(" AND   B.Valor       = '1' ")
sql.add(" AND   B.NrBit       = 17 ")
sql.add(" AND   C2.TipoCuenta  = 'CCE' ")
sql.add(" AND   C1.TipoCuenta <> 'CCE' ")

sql.add(" UNION ALL ")

