*-- NDFEJE: Resultado de NDF
CrearDialogo
  NrOperacion1 : "Operacion"        ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;SQLSET("Select NrOperacion FROM "~DBO~".OPERACIONES WHERE (TipoOp In ('FXCT','FXVT','FXAT') Or (TipoOp In ('FXCTV','FXVTV','FXATV') and (CB1=0 or CB1 is null or CB1=''))) and CB9='1' and CB8='0' ");NO
  Fecha1       : "F Real Ej."       ;;;;;;SI O Dialogo.Fecha1>=Dialogo.Fecha2;'La Fecha de Ejercicio Real para esta Operacion es Invalida ';NO;Fsys
  Precio2      : "Precio_Ref"       ;;;;;;Dialogo.Precio2>0;'Precio Referencia Incorrecto';NO;
  Cantidad1    : "Cantidad"         ;;;;NO;;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Especie"          ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Especie2     : "ContraEspecie"    ;;;;NO;;;;;;BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1)
  Precio4      : "Resultado"        ;;;;NO;;;;;;((Dialogo.Precio2^Dialogo.Cantidad2)-(Dialogo.Precio3^Dialogo.Cantidad2))*Dialogo.Cantidad1*IIF(Incluido(Dialogo.TipoOp1,'FXVT|FXAT|FXVTV|FXATV|'),-1,1)
  Fecha2       : "Reset"            ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaVto2','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio"           ;;;;NO;;;;;;BuscarCampo('Operaciones','Precio1','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Vto M.Pago"       ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaPago','NrOperacion',Dialogo.NrOperacion1)
  TipoOp1      : "TipoOp"           ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cantidad2    : 'Modo'             ;;;;NO;;;;;;IIF(EqStr(Dialogo.TipoOp1,'FXAT'),IIf(EqStr(BuscarCampo('Operaciones','CB6','NrOperacion',Dialogo.NrOperacion1),'0'),-1,1),IIf(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Dialogo.Especie1~"' and Especie2='"~Dialogo.Especie2~"' "),'INV'),-1,1))
FinDialogo

if Not Ok
  Cancelar
endif

***---Variable IN:88: asignada con el numero de instancia
ACN(IN:88, 19)
***------***

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

* Verifico que se encuentre en Liquidacion o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en Liquidacion o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x:1,0)
   SQL.ADD("Select CB1, TipoOp, NrOperacion3, Vehiculo1, Vehiculo2 from "~DBO~".OPERACIONES ")
   SQL.ADD("Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD(" and (TipoOp In ('FXCT','FXVT','FXAT') Or (TipoOp In ('FXCTV','FXVTV','FXATV') and (CB1=0 or CB1 is null or CB1=''))) ")
   SQL.ADD(" and CB9='1' and CB8='0' ")  
   Recorrer SQL    
     acn(x:1,1)
     *** Marca la operacion como ejercida
     SQL.ADD("Update "~DBO~".OPERACIONES ")
     SQL.ADD("Set CB8='1', Precio2="~Fstr(Dialogo.Precio2,0,7)~", Precio3="~Fstr(Dialogo.Precio4,0,2)~"  ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     **// Si el TipoOp es vinculada marca como ejercida la operacion contraria tambien
     If Incluido(FBN('TipoOp'), 'FXCTV|FXVTV|FXATV|')
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set CB8='1', Precio2="~Fstr(Dialogo.Precio2,0,7)~", Precio3="~Fstr(Dialogo.Precio4,0,2)~"*(-1)  ")
        SQL.ADD("where NrOperacion = '"~FBN('NrOperacion3')~"' ")
        SQL.NEW
        SQL.EXEC
        SQL.ActualizarMovimientos2(FBN('NrOperacion3'),SI,SI,SI,SI)
     Endif
     SQL.EXEC
     SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,SI,SI,SI)
     SQL.EXEC
     **// La operacion pasa a instancia de Confirmacion
     ACT(i:3, Dialogo.NrOperacion1)
     (.'MODINSTAN2'.)
     **// La operacion contraria pasa a inst. de Confirmacion si tiene vehiculo con Pisa, de lo contrario va a Vinculadas en Espera.
     If Incluido(FBN('TipoOp'), 'FXCTV|FXVTV|FXATV|')
     If [Not Incluido(FBN('Vehiculo1'), VAR('VEHIEXTRAN')) Y Not Incluido(FBN('Vehiculo2'), VAR('VEHIEXTRAN'))] o Incluido(FBN('Vehiculo2'),VAR('VLIQUIDAA'))
           ACN(IN:88, 15)
        Endif
        ACT(i:3, FBN('NrOperacion3'))
        (.'MODINSTAN2'.)
     Endif
   Proximo
   If Val(x:1)=0
      Cancelar('La Operacion Nro '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif
