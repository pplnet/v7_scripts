**--INVIMV - Modifica Condiciones Settl.VINCULADAS

** Asi lo llama GARANT
** EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"' "                        ;Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=" Total3=Total8,Total1=Cantidad5,Total7=Total5,Precio3=Precio1,Cantidad4=Cantidad6 ";String2='';
** Asi lo llama MMPCCM
** EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"',Book1=4,Book2=Book1 ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1=" Total3=Total8,Total1=Cantidad5,Total7=Total5,Precio3=Precio1,Cantidad4=Cantidad6 ";String2='';
** Asi lo llama MMPRCO
** EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"',Book1=Book2,Book2=Book1 ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1='';String2='';
** Asi lo llama MMPREC
** EqStr(ABM,'A') y MB4=1;'INVIMV';NrOperacion1=NROPERACION;TipoOp1=TIPOOP;String="MB3='"~Fstr(IF(MB3=0,1,0),1,0)~"',Book1=Book2,Book2=Book1 ";Vehiculo1=VEHICULO2;Vehiculo2=VEHICULO1;String1='';String2='';

CrearDialogo
  NrOperacion1:'Op  Vehiculo'        
  TipoOp1     :'Tipo Vinculada' 
  String      :'Update Operacion'
  Vehiculo1   :'Veh. Nueva'
  Vehiculo2   :'Veh Contraparte Nueva'
  String1     :'Upd. Settlements1'
  String2     :'Upd. Settlements2'
FinDialogo
If not Ok
  Cancelar
EndIf

*HojaVisible(SI)

* Obtengo el Nro. de la Operacion Vinculada
ACT(A1,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1)))

Message('Generando Operacion '~VAL(A1)~' Vinculada ...')

