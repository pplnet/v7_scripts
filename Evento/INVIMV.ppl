* MessageBox ('Cambio de TipoContrato y books, de '~Dialogo.NrOperacion1~' a '~VAL(A1)~' ----')
IF NOVACIO(Dialogo.String)
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("   SET "~Dialogo.String~" ")
   SQL.ADD(" WHERE  NrOperacion='"~VAL(A1)~"' ")
   SQL.NEW
   SQL.EXEC
ENDIF

* MessageBox ('Cambio de Cuentas, de '~Dialogo.NrOperacion1~' a '~VAL(A1)~' ----')
IF Not Eqstr(Dialogo.TipoOp1, 'TRANFC')
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET Cuenta1=Cuenta2 , Cuenta2=Cuenta1 , ")
   SQL.ADD("    Cuenta4=Cuenta5 , Cuenta5=Cuenta4  ")
   SQL.ADD("WHERE  NrOperacion='"~VAL(A1)~"' ")
   SQL.NEW
   SQL.EXEC
ENDIF


**-- El NrOperacion renovable (Nroperacion4 en la operacion nueva) de las operaciones indicadas como Renovadas (son las que traen CB3=1 en la Operacion vieja)
**--    son generadas con el NrOperacion de la Vinculada (NrOperacion3 en la Operacion vieja) y con CB3 activado (en 1) 
 
ACT (W:1, BuscarCampo('OPERACIONES','TipoOp', 'NrOperacion', Dialogo.NrOperacion1 ))
ACT (CB:3, BuscarCampo('OPERACIONES','CB3', 'NrOperacion', Dialogo.NrOperacion1 ))

iF Incluido(Val(w:1),'MMPCCV|MMPCCM|SEPVMV') Y  EqStr(Val(CB:3), '1') 
   ACT (W:2, BuscarCampo('OPERACIONES','NrOperacion3', 'NrOperacion',BuscarCampo('OPERACIONES','NrOperacion4', 'NrOperacion', Dialogo.NrOperacion1  ) )  )
   SQL.ADD("Update "~DBO~".OPERACIONES SET ")
   SQL.ADD(" NrOperacion4 = '"~VAL(W:2)~"', CB3 = '1' WHERE  NrOperacion= '"~VAL(A1)~"'  ")                                     
   SQL.NEW
EndIf



* MessagebOX('Generando Instancias Operacion '~VAL(A1)~' Vinculada ...')
SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD(" (NrOperacion,NrBit,Valor) ")
SQL.ADD("SELECT '"~VAL(A1)~"' As NrOperacion,NrBit,Valor ")
SQL.ADD("  FROM "~DBO~".OPERACIONESBITS ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

* TRATAMIENTO DE VINCULADAS INSTANCIA 15
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor = '0' ")
SQL.ADD(" Where NrOperacion = '"~VAL(A1)~"' ")
SQL.ADD("   and NrBit       = '1' ")
SQL.NEW
SQL.EXEC

* La Vinculada creada queda en Instancia 15
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor = '1' ")
SQL.ADD(" Where NrOperacion = '"~VAL(A1)~"' ")
SQL.ADD("   and NrBit       = '15' ")
SQL.NEW
SQL.EXEC

SQL.ADD("INSERT INTO "~DBO~".CUOTAS ( ")
SQL.ADD("  NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
SQL.ADD("  Vehiculo2,   Especie1,     Especie2,     Especie3,     Especie4, ")
SQL.ADD("  Check1,      Check2,       Check3,       Check4,       Check5, ")
SQL.ADD("  Check6,      Check7,       Check8,       Check9,       Check10, ")
SQL.ADD("  Radio1,      Radio2,       Radio3,       Radio4,       Radio5, ")
SQL.ADD("  Radio6,      Radio7,       Radio8,       Radio9,       Radio10, ")
SQL.ADD("  Fecha1,      Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
SQL.ADD("  Fecha6,      Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
SQL.ADD("  Mercado1,    Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
SQL.ADD("  Plazo4,      Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
SQL.ADD("  Precio1,     Precio2,      Precio3,      Precio4,      Total1, ")
SQL.ADD("  Total2,      Total3,       Total4,       Total5,       Total6, ")
SQL.ADD("  Total7,      Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
SQL.ADD("  PrecioRef2,  Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
SQL.ADD("  Precio7,     Precio8,      Tasa3,        Total9,       Cotizacion1, ")
SQL.ADD("  Cotizacion2, Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
SQL.ADD("  Coeficiente, Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
SQL.ADD("  Cantidad9,   Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
SQL.ADD("  Total11,     Total12 ")
SQL.ADD(" )")

SQL.ADD("SELECT '"~VAL(A1)~"' As NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
SQL.ADD("       Vehiculo2,                    Especie1,     Especie2,     Especie3,     Especie4, ")
SQL.ADD("       Check1,                       Check2,       Check3,       Check4,       Check5, ")
SQL.ADD("       Check6,                       Check7,       Check8,       Check9,       Check10, ")
SQL.ADD("       Radio1,                       Radio2,       Radio3,       Radio4,       Radio5, ")
SQL.ADD("       Radio6,                       Radio7,       Radio8,       Radio9,       Radio10, ")
SQL.ADD("       Fecha1,                       Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
SQL.ADD("       Fecha6,                       Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
SQL.ADD("       Mercado1,                     Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
SQL.ADD("       Plazo4,                       Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
SQL.ADD("       Precio1,                      Precio2,      Precio3,      Precio4,      Total1, ")
SQL.ADD("       Total2,                       Total3,       Total4,       Total5,       Total6, ")
SQL.ADD("       Total7,                       Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
SQL.ADD("       PrecioRef2,                   Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
SQL.ADD("       Precio7,                      Precio8,      Tasa3,        Total9,       Cotizacion1, ")
SQL.ADD("       Cotizacion2,                  Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
SQL.ADD("       Coeficiente,                  Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
SQL.ADD("       Cantidad9,                    Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
