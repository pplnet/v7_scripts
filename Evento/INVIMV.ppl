SQL.ADD("  FROM "~DBO~".CUOTAS ")
SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

IF NOVACIO(Dialogo.String1)
  SQL.ADD("Update "~DBO~".CUOTAS ")
  SQL.ADD("   Set "~Dialogo.String1~" ")
  SQL.ADD(" WHERE  NrOperacion='"~VAL(A1)~"' ")
  SQL.NEW
  SQL.EXEC
ENDIF

IF NOVACIO(Dialogo.String2)
  SQL.ADD("Update "~DBO~".CUOTAS ")
  SQL.ADD("   Set "~Dialogo.String2~" ")
  SQL.ADD(" WHERE  NrOperacion='"~VAL(A1)~"' ")
  SQL.NEW
  SQL.EXEC
ENDIF

IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'MMPRCO')
  ***---En la MMPRCO ingresada a mano busco la MMPCCM que prorroga para obtener la MMPCCM generada automaticamente
  ***---y marcarle la relacion con la MMPRCO generada automaticamente
  ***---MMPCCM ingresada a mano (original)
  ACT(MM:1, BuscarCampo('OPERACIONES','NrOperacion6','NrOperacion', Dialogo.NrOperacion1))
  ***---MMPCCM automatica (original)
  ACT(MM:2, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(MM:1)))
  ***---MMPCCM o MMPRCO ingresada a mano (a prorrogar)
  ACT(MM:3, BuscarCampo('OPERACIONES','NrOperacion5','NrOperacion', Dialogo.NrOperacion1))
  ***---MMPCCM o MMPRCO automatica (a prorrogar)
  ACT(MM:4, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(MM:3)))
  ***---Actualizo MMPRCO generada
  SQL.ADD(" Update "~DBO~".OPERACIONES ")
  SQL.ADD(" Set NrOperacion6 = '"~Val(MM:2)~"', ")
  SQL.ADD("     NrOperacion5 = '"~Val(MM:4)~"' ")
  SQL.ADD(" Where NrOperacion = '"~Val(A:1)~"' ")
  SQL.NEW
  ***---Actualizo MMPCCM Automatica
  SQL.ADD(" Update "~DBO~".OPERACIONES ")
  SQL.ADD(" Set NrOperacion5 = '"~Val(A:1)~"' ")
  SQL.ADD(" Where NrOperacion = '"~Val(MM:2)~"' ")
  SQL.NEW
  SQL.EXEC
  ***---Actualiza movimientos, posiciones y limites Y Devengados de la MMPCCM automatica
  SQL.ActualizarMovimientos3(VAL(MM:2),SI,NO,NO,SI,SI)
  SQL.EXEC
ENDIF

IF Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'MMPREC')
  ACT(ab:1, 'Manual')
  ACT(ac:1, 'Automatica')
  ACT(ad:1, 'Vinculada')

  ACT(aa:2, 'Precan')
  ACT(aa:3, 'Orig.')
  ACT(aa:4, 'Ultima')

  ACT(ab:2, Dialogo.NrOperacion1)
  ACT(ac:2, Val(a:1))
  ACT(ab:3, BuscarCampo('OPERACIONES','NrOperacion6','NrOperacion', Dialogo.NrOperacion1))
  ACT(ac:3, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(ab:3)))
  ACT(ab:4, BuscarCampo('OPERACIONES','NrOperacion5','NrOperacion', Dialogo.NrOperacion1))
  ACT(ac:4, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(ab:4)))

  ***---Actualizo MMPREC generada
  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   Set NrOperacion5 = '"~Val(ac:4)~"', ")
  SQL.ADD("       NrOperacion6 = '"~Val(ac:3)~"' ")
  SQL.ADD(" Where NrOperacion = '"~Val(ac:2)~"' ")
  SQL.NEW
  ***---Actualizo MMPCCM Original Automatica
  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   Set NrOperacion6 = '"~Val(A:1)~"' ")
  SQL.ADD(" Where NrOperacion = '"~Val(ac:3)~"' ")
  SQL.NEW
  SQL.EXEC

  ACT(ad:2, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(ac:2)))
  ACT(ad:3, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(ac:3)))
  ACT(ad:4, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion', Val(ac:4)))

  EjecutarEvento('PRECM1', NrOperacion1=Val(ab:4), NrOperacion2=Val(ab:2))
  EjecutarEvento('PRECM1', NrOperacion1=Val(ac:4), NrOperacion2=Val(ac:2))

ENDIF

Message('Generando Calls y Puts Operacion '~VAL(A1)~' Vinculada ...')
SQL.ADD("INSERT INTO "~DBO~".OPSCALLSPUTS ( ")
SQL.ADD("  NrOperacion, TipoOpcion,  FechaEj,     PrecioEj,     Ejercida, ")
SQL.ADD("  FechaPago,   PorCancelar, VNCancelado, ImpVNCancela, IntCorridosEj, ")
SQL.ADD("  ImporteTotEj ")
SQL.ADD(" )")
SQL.ADD("SELECT '"~VAL(A1)~"' As NrOperacion, TipoOpcion,  FechaEj,     PrecioEj,     Ejercida,")
SQL.ADD("       FechaPago,                    PorCancelar, VNCancelado, ImpVNCancela, IntCorridosEj,")
SQL.ADD("       ImporteTotEj ")
SQL.ADD("  FROM "~DBO~".OPSCALLSPUTS ")
SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

Message('Generando Comisiones para la  Operacion '~VAL(A1)~' Vinculada ...')
*-- Insert de Comisiones
SQL.ADD("INSERT INTO "~DBO~".COMISIONES2 ( ")
SQL.ADD("  NrOperacion, Tipo,     Tasa1,    Tasa2,    Tasa3, ")
SQL.ADD("  Especie1,    Especie2, Fecha1,   Fecha2,   Cliente1, ")
SQL.ADD("  Cliente2,    Importe1, Importe2, Importe3, Importe4, ")
SQL.ADD("  RB1,         RB2,      RB3,      RB4,      NrComision, ")
SQL.ADD("  Importe5,    Precio1,  Precio2,  NrCuota,  Cotizacion1, ")
SQL.ADD("  Cotizacion2 ")
SQL.ADD(" )")
SQL.ADD("SELECT '"~VAL(A1)~"' As NrOperacion, Tipo,     Tasa1,    Tasa2,    Tasa3, ")
SQL.ADD("       Especie1,                     Especie2, Fecha1,   Fecha2,   Cliente1, ")
SQL.ADD("       Cliente2,                     Importe1, Importe2, Importe3, Importe4, ")
SQL.ADD("       RB1,                          RB2,      RB3,      RB4,      NrComision, ")
SQL.ADD("       Importe5,                     Precio1,  Precio2,  NrCuota,  Cotizacion1, ")
SQL.ADD("       Cotizacion2 ")
SQL.ADD("  FROM "~DBO~".COMISIONES2 ")
SQL.ADD("       WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

*** Actualiza movimientos, posiciones y limites Y Devengados ****
SQL.ActualizarMovimientos3(VAL(A1),SI,NO,NO,SI,SI)
SQL.EXEC

**-- Actualiza la Operacion Original con el nro. de la vinculada
SQL.ADD("Update "~DBO~".OPERACIONES ")
SQL.ADD("   Set NrOperacion3  = '"~VAL(A1)~"' ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

*- Calculo de TTN Op.Vinculada
EjecutarEvento('TTNOP',NrOperacion1=val(a1),Entero1=0,NrOperacion2='',Lista1='')

IF Not Eqstr('FIJA', BuscarCampo('OPERACIONES','TipoTasa','NrOperacion', Val(A:1)))
  ***---Valuaciones MM para calcular flujos futuros
  ***---EjecutarEvento('VALMM', Fecha1=Fsys, NrOperacion1 = Val(A:1))
ENDIF
