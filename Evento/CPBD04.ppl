MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
 Fecha1  : 'F.Conciliacion' ;1;1;;;;Dialogo.Fecha1<=FSYS ;'Fecha Incorrecta';NO;FSys
 Lista1  : 'Vehiculos'      ;3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista2  : 'CtasMadres'     ; ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Codigo IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS)  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" ");
 Lista3  : 'CtasPag/Rec/Int'   ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE (Pagadora='SI' OR TipoCuenta IN ('REC','INT') ) "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" "~IIF(NOVACIO(Dialogo.Lista2), " AND CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")")~" ");
 Check4  : 'Confirma'       ;1;2;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif  


SQL.ADD(" SELECT /*+ RULE */ EX.MNrDatanet, EX.MNrMovDatanet, M.Banco, M.Cuenta, M.Moneda, M.Importe, ")
SQL.ADD(" M.DC, M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, EX.Operador,  ")
SQL.ADD(" EX.HNrDatanet, EX.HNrMovDatanet, MH.Banco BancoH, MH.Cuenta CuentaH, MH.Moneda MonedaH, Mh.Importe ImporteH, ")
SQL.ADD(" MH.DC DCH, MH.FechaIngreso FechaIngresoH, MH.FechaAcreditacion FechaAcreditacionH, MH.TipoMov TipoMovH, MH.Comprobante ComprobanteH ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".CUENTAS C2, ")
SQL.ADD(" "~DBO~".EXTRACTOS EX, "~DBO~".MOVDATANET MH ")
SQL.ADD(" WHERE  M.NrDatanet     = EX.MNrDatanet ")
SQL.ADD(" AND    M.NrMovDatanet  = EX.MNrMovDatanet ")
SQL.ADD(" AND    MH.NrDatanet    = EX.HNrDatanet ")
SQL.ADD(" AND    MH.NrMovDatanet = EX.HNrMovDatanet ")
SQL.ADD(" AND    M.Cuenta        = C.Numero   (+) ")
SQL.ADD(" AND    MH.Cuenta       = C2.Numero  (+) ")
SQL.ADD(" AND    EX.Fecha        = "~IdxDate2(Dialogo.Fecha1)~" ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVAcio(Dialogo.Lista2)
  SQL.ADD(" AND C.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
  SQL.ADD(" AND C2.CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Else
  SQL.ADD(" AND C.Codigo  IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS) ")
Endif
If NoVAcio(Dialogo.Lista3)
  SQL.ADD(" AND C2.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista3)~")    ")
Else
  SQL.ADD(" AND (C2.TipoCuenta IN ('INT','REC') OR C2.Pagadora='SI') ")
Endif
SQL.ADD(" ORDER By EX.MNrDatanet, EX.MNrMovDatanet ")

ACN(bz:1,0)

Recorrer SQL
  ACT(a:fac, fbn('MNrDatanet'))
  ACN(b:fac, fbn('MNrMovDatanet'))
  ACT(c:fac, fbn('Banco'))
  ACT(e:fac, fbn('Cuenta'))
  ACT(f:fac, fbn('Moneda'))
  ACN(g:fac, fbn('Importe'))
  ACT(h:fac, fbn('DC'))
  ACD(i:fac, fbn('FechaIngreso'))
  ACD(j:fac, fbn('FechaAcreditacion'))
  ACT(k:fac, fbn('TipoMov'))
  ACT(l:fac, fbn('Comprobante'))
  ACN(xx:fac, 0)
  ACT(aa:fac, fbn('HNrDatanet'))
  ACN(ab:fac, fbn('HNrMovDatanet'))
  ACT(ac:fac, fbn('BancoH'))
  ACT(ae:fac, fbn('CuentaH'))
  ACT(af:fac, fbn('MonedaH'))
  ACN(ag:fac, fbn('ImporteH'))
  ACT(ah:fac, fbn('DCH'))
  ACD(ai:fac, fbn('FechaIngresoH'))
  ACD(aj:fac, fbn('FechaAcreditacionH'))
  ACT(ak:fac, fbn('TipoMovH'))
  ACT(al:fac, fbn('ComprobanteH'))
  ACT(am:fac, fbn('Operador'))
  SCN(bz:1,1)
Proximo

If Val(bz:1)=0
  Cancelar('No hay movimientos para desconciliar.')
Endif

  CrearListBox; 'Arial,8,'
   'Extracto'      ;a:1..a:Val(bz:1);NO;;;60;STRING;;RGB(232,232,232);
   'NrMov'         ;b:1..b:Val(bz:1);NO;;;40;NUMERO;'###,###,###';RGB(232,232,232);
   'Banco'         ;c:1..c:Val(bz:1);NO;;;50;STRING;;RGB(232,232,232);
   'CtaPpal'       ;e:1..e:Val(bz:1);NO;;;80;STRING;;RGB(232,232,232);
   'Moneda'        ;f:1..f:Val(bz:1);NO;;;50;STRING;;RGB(232,232,232);
   'Importe'       ;g:1..g:Val(bz:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'D/C'           ;h:1..h:Val(bz:1);NO;;;25;STRING;;RGB(232,232,232);
   'TipoMov'       ;k:1..k:Val(bz:1);NO;;;45;STRING;;RGB(232,232,232);
   'Comprobante'   ;l:1..l:Val(bz:1);NO;;;70;STRING;;RGB(232,232,232);
   'F.Ingreso'     ;i:1..i:Val(bz:1);NO;;;70;FECHA ; RGB(232,232,232);
   'F.Acredit'     ;j:1..j:Val(bz:1);NO;;;70;FECHA ; RGB(232,232,232);
   'OK'            ;xx:1..xx:Val(bz:1);SI;;;100;CHECK; RGB(232,255,215);
   'Extracto'      ;aa:1..aa:Val(bz:1);NO;;;60;STRING;;RGB(221,242,255);
   'NrMov'         ;ab:1..ab:Val(bz:1);NO;;;40;NUMERO;'###,###,###';RGB(221,242,255);
   'Banco'         ;ac:1..ac:Val(bz:1);NO;;;50;STRING;;RGB(221,242,255);
   'Cuenta'        ;ae:1..ae:Val(bz:1);NO;;;80;STRING;;RGB(221,242,255);
   'Moneda'        ;af:1..af:Val(bz:1);NO;;;50;STRING;;RGB(221,242,255);
   'Importe'       ;ag:1..ag:Val(bz:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(221,242,255);
   'D/C'           ;ah:1..ah:Val(bz:1);NO;;;25;STRING;;RGB(221,242,255);
   'TipoMov'       ;ak:1..ak:Val(bz:1);NO;;;45;STRING;;RGB(221,242,255);
   'Comprobante'   ;al:1..al:Val(bz:1);NO;;;70;STRING;;RGB(221,242,255);
   'F.Ingreso'     ;ai:1..ai:Val(bz:1);NO;;;70;FECHA ; RGB(221,242,255);
   'F.Acredit'     ;aj:1..aj:Val(bz:1);NO;;;70;FECHA ; RGB(221,242,255);
   'Operador'      ;am:1..am:Val(bz:1);NO;;;70;STRING;;RGB(221,242,255);
  FinListBox

  If Not Ok
    Cancelar
  Endif


Recorrer&i 1,Val(bz:1)
  If Val(xx:&i)=1
    SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".EXTRACTOS  ")
    SQL.ADD(" WHERE  MNrDatanet    = '"~Val(a:&i)~"' ")
    SQL.ADD(" AND    MNrMovDatanet = "~FSTR(Val(b:&i),0,0)~" ")
    SQL.ADD(" AND    HNrDatanet    = '"~Val(aa:&i)~"' ")
    SQL.ADD(" AND    HNrMovDatanet = "~FSTR(Val(ab:&i),0,0)~" ")
    SQL.NEW
    SQL.EXEC
    message('Movimiento desconciliado.')
  Endif
Proximo