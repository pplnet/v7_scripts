sql.add(" SELECT Case T.TipoTr2 When 'CUPON ' Then T.Especie Else T.Especie2 END Especie, ")
sql.add(" T.Fecha1, T.Fecha2, T.Vehiculo1,  T.NrTrans, T.Cantidad1, V.Valor1, V.Valor2, ")
sql.add(" E.Codigo, E.TasaIntVigente, E.TasaIntAnterior, E.InteresesC, E.CuponFeriado, E.Tasa1, ")
sql.add(" E.FechaCambioTasa, E.IntsCapitalizados, E.Cotiza, T.TipoTr2, E.ZeroCoupon, T.Cupon1, T.Precio2 Renta, ")
sql.add(" Case T.TipoTr2 When 'CUPON ' Then Precio1 Else Precio3 END Amort, T.Cuenta2, T.Cantidad5, T.Cantidad6, ")
sql.add(" '' Observaciones, T.Cliente1, T.Cantidad1 Cantidad, T.Cambio3, T.Cambio1 VTAnt, E.Alias8, E.Cotiza Moneda, ")
sql.add(" V.Alias4, E.Issuer Emisor, Cantidad9, E.TipoTasa ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".VEHICULOS V, "~Dbo()~".ESPECIES E ")
sql.add(" WHERE T.Vehiculo1 = V.Codigo ")
sql.add(" AND   (   (T.Especie  = E.Codigo AND T.TipoTr2 ='CUPON')   ")
sql.add("        OR (T.Especie2 = E.Codigo AND T.TipoTr2<>'CUPON') ) ")
sql.add(" AND   T.TipoTr2   IN ('CUPON','CCUPON','PCUPON') ")
sql.add(" AND   (T.Cantidad4=1 OR T.TipoTr2<>'CUPON') ")
sql.add(" AND   T.FechaCargaSys = "~IdxDate2(dialogo.fecha1)~"   ")
sql.add(" AND   T.Vehiculo1 Not IN ("~pipe2comillas(Var('VLIQUIDAA'))~") ")
if (NoVacio(dialogo.lista1))
sql.add(" AND (T.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~") OR T.Vehiculo1 is null OR T.Vehiculo1 = '' OR T.Vehiculo1 = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND T.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add("  ORDER BY T.NrTrans ")

recorrer sql
