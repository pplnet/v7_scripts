Sqladd("SELECT O.NrOperacion,    O.TipoOp,       O.Especie,       O.Rojo,               O.FechaOp,           ")
Sqladd("       O.PaseCB,         O.EsAforado,    O.TipoCambio2,   O.PorAforo,           O.Precio1,           ")
Sqladd("       O.CB6,            O.Plazo,        O.Cupon1,        O.PlazoGracia,        O.Mercado,           ")
Sqladd("       O.TablaFeriados1, O.FechaVto,     O.ContraEspecie, O.Cliente1,           O.OpSIOPEL,          ")
Sqladd("       O.Cantidad,       O.Mercado2,     O.TotalNetoCli1, O.FormaLiquidacion1, O.FormaLiquidacion2, ")
Sqladd("       O.NroAltaMAE,     O.NrOperacion3, O.EnteCus1,      O.Cuenta1,           ")
Sqladd("       O.Precio3,        O.Precio4,      O.ContraEspecie2 ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" Where O.NrOperacion = OB.NrOperacion ")
Sqladd("   and OB.NrBit = 60 ")
Sqladd("   and OB.Valor = '1' ")
Sqladd("   and IsNull(O.Plataforma,'SIOPEL') = 'SIOPEL' ")
Sqladd(" order by O.NrOperacion ")
