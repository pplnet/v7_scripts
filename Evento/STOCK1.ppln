sql.add(" SELECT Distinct T.Especie, T.Cupon1, T.Vehiculo1, T.Mercado1, T.Cliente1, T.Cuenta1, T.Cantidad1, T.Precio1, ")
sql.add(" T.Cantidad2, T.Cantidad3, T.NrTrans, T.FechaEj, T.PrecioEj, T.Cuenta4, T.RB1, ")
sql.add(" T.Cantidad9, T.Cantidad10, T.Cantidad11, ")
sql.add(" T.Cantidad12, T.Cantidad13, T.Cantidad14, T.Cantidad15, ")
sql.add(" T.Especie1, T.Especie2, ")
sql.add(" T.Cambio5, T.Cuenta2, T.Cliente2, ")
