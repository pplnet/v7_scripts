sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E ")
sql.add(" WHERE T.Cliente1 = C.Codigo ")
sql.add("   AND T.Especie  = E.Codigo ")
sql.add("   AND T.TipoTr2 = 'STOCK' ")
sql.add("   AND T.RB2 = 0 ")
sql.add("   AND T.RB1 > 0 ")
sql.add("   AND T.Vehiculo1 = '"~Val(vh:1)~"' ")
sql.add("   AND T.Especie = '"~Val(es:1)~"' ")
