Acd(z10, FinDeMes(FSys() - 35, NO, 'ARG'))


Sqladd("SELECT O.Vehiculo1,O.Vehiculo2,O.Especie,SUM(O.TotalIntereses) As Interes ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where O.TipoOp='VIMIND' and O.FechaOp<'"~IdxDate(dialogo.fecha1)~"'and ")
Sqladd(" (NrOperacion2 IS NULL Or NrOperacion2='') ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT * ")
Sqladd("from "~Dbo()~".OPERACIONES B")
Sqladd("where B.TipoOp='VIMINM' and B.FechaOp='"~IdxDate(dialogo.fecha1)~"' and ")
Sqladd("B.Vehiculo1=O.Vehiculo1 and B.Vehiculo2=O.Vehiculo2 and B.Especie=O.Especie) ")
Sqladd("Group By O.Vehiculo1,O.Vehiculo2,O.Especie ")
Sqladd("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

Acn(ab1, 0)

recorrer sql
Message('Procesando Vehiculo: '~Fbn()['Vehiculo1']~' Veh. ContraParte '~Fbn()['Vehiculo2']~' Especie:'~Fbn()['Especie']~' ...')

Ejecutarevento('VIMINM', 'fecha1', dialogo.fecha1, 'vehiculo1', Fbn()['Vehiculo1'], 'vehiculo2', Fbn()['Vehiculo2'], 'especie1', Fbn()['Especie'], 'precio1', Val(a1))

Scn(ab1, 1)
proximo

