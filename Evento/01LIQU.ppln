Sqladd("Select M.FechaMov,      M.Cliente,       M.Especie,  CASE WHEN  M.Cupon Is Null THEN '0' WHEN M.Cupon='' THEN '0' WHEN M.Cupon=' ' THEN '0' ELSE M.Cupon END Cupon,    ")
Sqladd("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
Sqladd("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
Sqladd("       O.TipoOp Tipo,   Case When TipoOp = 'CONU' Then O.Mercado2 Else O.Mercado End MercO, ")
Sqladd("       'OP' Voucher , O.NrOperacion OperOrig, O.RB10, O.Cuenta2, C.CategDepositante, M.NrGrupo, M.Leyenda, O.Mercado4 MercaNeg ")

Sqladd("FROM "~Dbo()~".MOVPENDIENTES M JOIN "~Dbo()~".OPERACIONES O ON M.NrOperacion = O.NrOperacion")
Sqladd("JOIN "~Dbo()~".OPERACIONESBITS B ON M.NrOperacion = B.NrOperacion ")
Sqladd("JOIN "~Dbo()~".CLIENTES C ON M.Cliente = C.Codigo ")

Sqladd("WHERE M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
Sqladd("and (M.Cliente = O.Cliente1 or M.Cliente = O.Cliente2  or M.Cliente = O.Cliente4) ")

Sqladd("and M.NrSaldo = 1   ")
if (dialogo.check1 = 0)
Sqladd("and M.Concepto <> 'TI' ")
endif
if (dialogo.check2 = 0)
Sqladd("and M.Concepto <> 'FX' ")
endif
if (dialogo.check3 = 0)
Sqladd("and M.Concepto <> 'MM' ")
endif
if (dialogo.check4 = 0)
Sqladd("and M.Concepto <> 'PM' ")
endif
if (dialogo.check12 = 0)
Sqladd("and M.Concepto not in ('FM','FT') ")
endif
if (dialogo.check13 = 1)
Sqladd("and M.NrGrupo in(15, 16)   ")
else 
Sqladd("and (M.NrGrupo not in(15, 16) or M.NrGrupo is Null)  ")
endif
if (dialogo.check11 = 0)
Sqladd("and M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
else 
Sqladd("and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
endif
Sqladd("and M.Bits in ('MV','MI') ")
if (NoVacio(dialogo.cliente1))
Sqladd("and M.Cliente = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.especie1))
Sqladd("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.mercado1))
Sqladd("and M.Mercado = '"~dialogo.mercado1~"' ")
endif
Sqladd("and M.Mercado not in("~Pipe2Comillas(Var('MERCAACMC'))~") ")
Sqladd("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("and ((M.Status <> 'MATCH' or M.Status = '' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
Sqladd("and (B.NrBit in ('10','70') and B.Valor = '1')  ")

Sqladd("and ((IsNull(O.CB4,'0')=0 and O.Cliente1<>O.Vehiculo1 and O.TipoOp in('TIC','TIV')) or (O.TipoOp Not in('TIC','TIV')) ) ")

