HojaVisible(NO)
CrearDialogo
  Fecha1       : 'Desde'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2       : 'Hasta'       ;;;;;;NoVacio(Dialogo.Fecha2);'Debe Ingresar una Fecha Desde';NO;FSys
  Especie1     : 'Especie'     ;;;;;;;;;
  String1      : 'Path Txt'    ;;;;NO;NO;;;;Var('DIRICOTIZ');;;;;;;;;;;;;;;;;  
  String2      : 'Nombre'      ;;;;NO;NO;;;;'SIA'~Pad0(Fstr(Dialogo.Entero1,0,0),2)~Fstr(Dialogo.Entero2,0,0);'SIA'~Pad0(Fstr(Dialogo.Entero1,0,0),2)~Fstr(Dialogo.Entero2,0,0)
  Entero1      : 'Juliana'     ;;;;NO;NO;;;;Num(Copy(Fstr(Anio(Fsys), 4, 0), 3, 2));Num(Copy(Fstr(Anio(Fsys), 4, 0), 3, 2))
  Entero2      : 'Juliana1'    ;;;;NO;NO;;;;Num(Pad0(Fstr(DifDias(Fsys, Fecha('01/01/'~Fstr(Anio(Fsys), 4, 0)), 'ARG', NO)+1, 0, 0), 3));Num(Pad0(Fstr(DifDias(Fsys, Fecha('01/01/'~Fstr(Anio(Fsys), 4, 0)), 'ARG', NO)+1, 0, 0), 3))
  Radio1       : 'Sist.Oper.|W98|NT'     ;1;2;;NO;NO;;;;1;
  Radio2       : 'Salida|Inf+TXT|TXT|Informe|'     ;2;2;;NO;NO;;;;0
FinDialogo

If Not Ok
   Cancelar
Endif

EjecutarEvento('ICOTIZ',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,String1=Dialogo.String1,String2=Dialogo.String2,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Radio1=-1,Radio2=2,Especie1=Dialogo.Especie1)
