MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:      'Fecha'           ; 1;;;;;;;;fsys
  Lista1:      'Vehiculos'       ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'     ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada';;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

Message('--- Asientos de Vencimiento ---')

***/// Vencimiento de ONs con PIKs
SQL.ADD(" SELECT O.NrOperacion, O.Especie, O.FechaOp, O.Cliente1, O.ContraEspecie, C.Fecha2, C.Cantidad3, C.Cantidad12, ")
SQL.ADD(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, V.Valor1, V.Valor2, ")
SQL.ADD(" MA.Codigo CodAsi, O.CB9, O.CB10, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, ")
SQL.ADD(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, V.Alias4, ")
SQL.ADD(" O.Especie Moneda, O.Cuenta2, O.ViaPago1, O.Indice, O.Precio5, O.Precio6  ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".OPERACIONESBITS B, "~DBO~".MODELOSASIENTO MA")
SQL.ADD(" WHERE O.NrOperacion    =  C.NrOperacion ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo ")
SQL.ADD(" AND   O.TipoOp IN ('MMONM') ")
SQL.ADD(" AND   O.RB7 = 1 ")
SQL.ADD(" AND   O.NrOperacion =  B.NrOperacion  ")
SQL.ADD(" AND   B.Valor       =  '1'      ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIVTO'))~") ")
SQL.ADD(" AND   C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
* -- Solo los vehiculos que liquidan contabilizan.
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
   Recorrer&i 1,Elementos(Dialogo.Lista1)
        SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
   proximo
   SQL.ADD(") ")      
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" ORDER BY O.NrOperacion ")

Recorrer SQL
   ACD(FV:1, fbn('Fecha2'))
   ACT(VH:1, fbn('Vehiculo1'))
   **// Capital cte a la fecha
   ACN(IM:1, SQL(" Select Sum(Cantidad4) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"' AND Fecha2 > '"~IdxDate(Val(FV:1))~"' ") )
   **//Capital no cte a la fecha
   ACN(IM:2, SQL(" Select Sum(Cantidad4) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"'  ") )
   **// Capital total
   ACN(IM:3, Val(IM:1)+Val(IM:2))
   **// Porcentaje de capital cte
   ACN(PR:1, Val(IM:1)/Val(IM:3))
   **// Porcentaje de capital no cte
   ACN(PR:2, Val(IM:2)/Val(IM:3))
   **// Interes pikeado cte.
   ACN(PK:1, FBN('Cantidad12')*Val(PR:1))
   **// Interes pikeado no cte.
   ACN(PK:2, FBN('Cantidad12')*Val(PR:2))

   **Messagebox('imp cte: '~Fstr(Val(IM:1),0,2))
   **Messagebox('imp no cte: '~Fstr(Val(IM:2),0,2))

   **Messagebox('pik cte: '~Fstr(Val(PK:1),0,2))
   **Messagebox('pik no cte: '~Fstr(Val(PK:2),0,2))

   ACN(CK:1, 0)
   IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(fbn('FechaOp'))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         ACN(CK:1, 0)
      ENDIF
   ENDIF
   IF Val(CK:1) = 0
      message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
      SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
   ENDIF
Proximo
