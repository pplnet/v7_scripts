Sqladd("Select O.NrOperacion, O.TipoOp, O.PaseCB, O.CB10, IsNull(RB6,0) FuenteAlta, ")
Sqladd("       O.CB5, O.Rojo, NrExterno, IsNull(NroAltaMAE,'NA') NroAltaMAE, FechaVto, IsNull(FechaEnvAltaSisExterno,0) FechaEnvAltaSE, ")
Sqladd("       O.Cuenta1, O.Cuenta2, O.Cuenta3, O.Cuenta4, ")
Sqladd("       O.CB4, O.Cuenta5, O.Cuenta6, O.NrOrden1 ")
Sqladd("  from "~Dbo()~".OPERACIONESBITS OB, "~Dbo()~".OPERACIONES O ")
Sqladd(" Where O.NrOperacion = OB.NrOperacion ")
Sqladd("   and OB.NrBit = 68 ")
Sqladd("   and OB.Valor = '1' ")
Sqladd(" Order by O.NrOperacion ")
