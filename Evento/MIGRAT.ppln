Act(va:1, Var('PATHEXTERN'))

creardialogo
fecha1:'Fecha desde';;;;;;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
check1:'ModoEspecies';;;;;;;;;0;
check2:'Cotizaciones';;;;;;;;;1;
fecha2:'Fecha desde';;;;NO;NO;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.check1 = 1)
Message('Actualizando ModoEspecies')
sql.add("Delete from "~Dbo()~".MODOESPECIES ")
sql.new

sql.add("Insert into "~Dbo()~".MODOESPECIES ")
sql.add("Select * from "~Val(va:1)~".MODOESPECIES ")
sql.new
sql.exec
endif

if (dialogo.check2 = 1)
Message('Actualizando Cotizaciones')
sql.add("Delete from "~Dbo()~".COTIZACIONES ")
sql.add("where Fecha >= "~IdxDate2(dialogo.fecha1))
sql.new

sql.add("Insert into "~Dbo()~".COTIZACIONES (Fecha, Codigo, CallPut, Precio1, PrecioContable, FechaActualizacion, Moneda)  ")
sql.add("Select C.Fecha, C.Codigo, C.CallPut, C.Precio1, C.PrecioContable, SYSDATETIME(), E.Cotiza ")
sql.add("from "~Val(va:1)~".COTIZACIONES C, "~Val(va:1)~".ESPECIES E  ")
sql.add("where  C.Fecha >= "~IdxDate2(dialogo.fecha1)~" and C.Codigo = E.Codigo ")
sql.add("  and  E.Cotiza is not null ")
sql.new
sql.exec
endif

