Act(va:1, Var('PATHEXTERN'))

creardialogo
fecha1:'Fecha desde';;;;;;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
check1:'ModoEspecies';;;;;;;;;0;
check2:'Cotizaciones';;;;;;;;;1;
fecha2:'Fecha desde';;;;NO;NO;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.check1 = 1)
Message('Actualizando ModoEspecies')
Sqladd("Delete from "~Dbo()~".MODOESPECIES ")
Sqlnew()

Sqladd("Insert into "~Dbo()~".MODOESPECIES ")
Sqladd("Select * from "~Val(va:1)~".MODOESPECIES ")
Sqlnew()
Sqlexec()
endif

if (dialogo.check2 = 1)
Message('Actualizando Cotizaciones')
Sqladd("Delete from "~Dbo()~".COTIZACIONES ")
Sqladd("where Fecha >= "~IdxDate2(dialogo.fecha1))
Sqlnew()

Sqladd("Insert into "~Dbo()~".COTIZACIONES (Fecha, Codigo, CallPut, Precio1, PrecioContable, FechaActualizacion, Moneda)  ")
Sqladd("Select C.Fecha, C.Codigo, C.CallPut, C.Precio1, C.PrecioContable, SYSDATETIME(), E.Cotiza ")
Sqladd("from "~Val(va:1)~".COTIZACIONES C, "~Val(va:1)~".ESPECIES E  ")
Sqladd("where  C.Fecha >= "~IdxDate2(dialogo.fecha1)~" and C.Codigo = E.Codigo ")
Sqladd("  and  E.Cotiza is not null ")
Sqlnew()
Sqlexec()
endif

