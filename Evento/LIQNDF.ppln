'Pend. Esp.Fix.';bz:1..bz:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Mercado ';bi:1..bi:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Book ';bo:1..bo:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Cta CLI';bj:1..bj:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Cta VEH';bk:1..bk:fac;NO;;;90;string;;RGB(180, 170, 193)
finlistbox

if (not ok)
Cancelar()('Evento Modificacion NDF, ha sido Cancelado!!!')
endif

Acn(cz:1, 0)
recorrer&j 1, Val(ca:1)
if (Val(a:&j) = 1)
if (NoVacio(Val(ai:&j)))
if (NoVacio(Val(i:&j)) y not Eqstr(Val(ai:&j), Val(i:&j)))
Scn(cz:1, 1)
Messagebox('ALERTA! la Cuenta '~Val(aj:&j)~' de la operacion '~Val(b:&j)~' no Corresponde al Mercado asignado '~Val(ai:&j)~'!!!')
endif
endif

if (NoVacio(Val(ai:&j)))
if (NoVacio(Val(i:&j)) y not Eqstr(Val(ai:&j), Val(i:&j)))
Scn(cz:1, 1)
Messagebox('ALERTA! la Cuenta '~Val(ak:&j)~' de la operacion '~Val(b:&j)~' no Corresponde al Mercado asignado '~Val(ai:&j)~'!!!')
endif
endif

endif
proximo

if (Val(cz:1) = 0)
if (1 = Messagebox('Confirma datos Ingresados???', 3, 1))
break
endif
endif
proximo


recorrer&i 1, Fac()
if (Val(a:&i) = 1)
sql.add("UPDATE "~Dbo()~".OPERACIONES ")
sql.add("   SET Arancel4='"~ItemLista(Val(ls:1), Val(ah:&i) + 1)~"', ")
sql.add("       FechaAltaSisExterno="~IdxDate2(Val(ag:&i))~", ")
sql.add("       FechaUltCupon="~IdxDate2(Val(aw:&i))~", ")
sql.add("       TipoTasa='"~Val(ai:&i)~"', ")
sql.add("       Book2='"~Val(ao:&i)~"', ")
sql.add("       Sector1='"~Val(aj:&i)~"', ")
sql.add("       Sector2='"~Val(ak:&i)~"', ")
sql.add("       Arancel3='"~Val(az:&i)~"', ")
sql.add("       MercadoRB='1' ")
sql.add(" WHERE NrOperacion='"~Val(b:&i)~"'  ")
sql.new
endif
proximo
sql.exec
Messagebox('Fin modificacion NDF')
else
Messagebox('No se encontraron operaciones para modificar')
endif

