'Cantidad';m:1..m:fac;NO;;;100;numero;;
'ConEspecie';e:1..e:fac;NO;;;50;string;;
'EspecieFix';z:1..z:fac;NO;;;50;string;;
'Fecha Op';f:1..f:fac;NO;;;80;string;;
'F.Vto Or.';g:1..g:fac;NO;;;80;fecha;
'M.Liq.Or.';h:1..h:fac;NO;;;50;string;;
'Mer.Liq.';i:1..i:fac;NO;;;60;string;;
'Book';o:1..o:fac;NO;;;60;string;;
'Cta.Mon.CLI';j:1..j:fac;NO;;;80;string;;
'Cta.Mon.VEH';k:1..k:fac;NO;;;80;string;;
'Nva.F.Vto.';ag:1..ag:fac;Val(a:flb) = 1;Val(a:flb) = 0 o (EsHabil(Val(ag:flb)) y (sql("Select 1 from "~Dbo()~".MTMDIARIO M1 where M1.NrOperacion = '"~Val(b:flb)~"' and M1.Fecha  >= '"~IdxDate(Val(ag:flb))~"'  ") <> 1));'Fecha Inválida';80;fecha;RGB(180, 180, 193)
'Nva.F.FIX.';aw:1..aw:fac;Val(a:flb) = 1;Val(a:flb) = 0 o (EsHabil(Val(aw:flb)) y (sql("Select 1 from "~Dbo()~".MTMDIARIO M1 where M1.NrOperacion = '"~Val(b:flb)~"' and M1.Fecha  >= '"~IdxDate(Val(aw:flb))~"'  ") <> 1));'Fecha Inválida';80;fecha;RGB(180, 180, 193)
'Nva.Mon.Liq.';ah:1..ah:fac;Val(a:flb) = 1;Val(a:flb) = 0 o NoVacio(Val(ah:flb));'Moneda inválida';50;combo;Val(ls:1);RGB(180, 180, 193)
'Nvo.Esp.Fix';az:1..az:fac;Val(a:flb) = 1;;;70;tabla;'ESPECIES';'Codigo';'Codigo;Nombre';;RGB(180, 180, 193);
'Nvo.M.Liq.';ai:1..ai:fac;Val(a:flb) = 1;;;60;tabla;'MERCADOS';'Codigo';'Codigo;Descripcion';"TipoNegocio Like '%M%' ";RGB(180, 180, 193);iif (Eqstr(Val(h:flb), ItemLista(Val(ls:1), Val(ah:flb) + 1)), Val(i:flb), MercadoDef(ItemLista(Val(ls:1), Val(ah:flb) + 1)));NO;
'Nvo. Book';ao:1..ao:fac;Val(a:flb) = 1;;;70;tabla;'BOOKS';'Codigo';'Codigo;Descripcion';;RGB(180, 180, 193);
'Nva.Cta.CLI';aj:1..aj:fac;SI;Val(a:flb) = 1 y Vacio(Val(aj:flb)) o (((ClienteCuenta(Val(c:flb), Val(aj:flb)) y Eqstr(Val(ac:flb), 'NO')) o (ClienteCuenta(Val(v:flb), Val(aj:flb)) y Eqstr(Val(ac:flb), 'SI'))) y EspecieCuenta(Val(ab:flb), Val(aj:flb)) y Eqstr(Val(i:flb), BuscarCampo('CUENTAS', 'Mercado', 'Codigo', Val(aj:flb))));'Nueva Cuenta Cliente Invalida';80;tabla;'CUENTAS';'Codigo';'Codigo;Nombre';"Cliente = '"~iif (Eqstr(BuscarCampo('MERCADOS', 'Netea', 'Codigo', Val(i:flb)), 'SI'), Query("SELECT Cliente1 FROM "~Dbo()~".MERCADOS WHERE Codigo='"~Val(i:flb)~"' "), Val(c:flb))~"' and (Especies Like '%MONEDA%' or Especies Like '%"~iif (Eqstr(BuscarCampo('MERCADOS', 'Regulado', 'Codigo', Val(l:flb)), 'NO'), Val(h:flb), Val(e:flb))~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and (TiposOperacion is NULL or TiposOperacion like '%"~Val(n:flb)~"|%') and Mercado='"~Val(i:flb)~"' ";RGB(180, 180, 193);iif (NoVacio(Val(o:flb)), iif (1 <= Val(ad:flb), ItemLista(Val(ae:flb), 1), Var('CTAMOD23')));NO;
'Nva.Cta.VEH';ak:1..ak:fac;SI;Val(a:flb) = 1 y Vacio(Val(ak:flb)) o (ClienteCuenta(Val(v:flb), Val(ak:flb)) y EspecieCuenta(Val(ab:flb), Val(ak:flb)) y Eqstr(iif (Eqstr(Val(aa:flb), 'SI'), Val(l:flb), iif (Incluido(Val(i:flb), Var('MERNOVEHI')), iif (Eqstr(Val(ab:flb), Var('MONELOCA')), Var('MERCBCRA'), iif (Eqstr(Val(ab:flb), Var('MONEEXTR')), Var('MERSWIFT'), Val(i:flb))), Val(i:flb))), BuscarCampo('CUENTAS', 'Mercado', 'Codigo', Val(ak:flb))));'Nueva Cuenta Vehiculo Invalida';80;tabla;'CUENTAS';'Codigo';'Codigo;Nombre';"Cliente = '"~Val(v:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~iif (Eqstr(BuscarCampo('MERCADOS', 'Regulado', 'Codigo', Val(l:flb)), 'NO'), Val(h:flb), Val(e:flb))~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~Val(n:flb)~"|%') and Mercado='"~iif (Incluido(Val(i:flb), Var('MERNOVEHI')), iif (Eqstr(iif (Eqstr(BuscarCampo('MERCADOS', 'Regulado', 'Codigo', Val(l:flb)), 'NO'), Val(h:flb), Val(e:flb)), Var('MONELOCA')), Var('MERCBCRA'), iif (Eqstr(iif (Eqstr(BuscarCampo('MERCADOS', 'Regulado', 'Codigo', Val(l:flb)), 'NO'), Val(h:flb), Val(e:flb)), Var('MONEEXTR')), Var('MERSWIFT'), Val(i:flb))), Val(i:flb))~"'";RGB(180, 180, 193);iif (modi, iif (NoVacio(Val(o:flb)), iif (Eqstr(Val(ac:flb), 'SI'), Val(j:flb), sql("SELECT Codigo FROM "~Dbo()~".CUENTAS WHERE Cliente = '"~Val(v:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(ab:flb)~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~Val(n:flb)~"|%') and Mercado='"~iif (Eqstr(Val(aa:flb), 'SI'), Val(l:flb), iif (Incluido(Val(i:flb), Var('MERNOVEHI')), iif (Eqstr(Val(ab:flb), Var('MONELOCA')), Var('MERCBCRA'), iif (Eqstr(Val(ab:flb), Var('MONEEXTR')), Var('MERSWIFT'), Val(i:flb))), Val(i:flb)))~"' ORDER by ISNull(Permanente,'NO') ASC")), Val(j:flb)));NO;NO;
'Pend. F.V.';bg:1..bg:fac;NO;;;80;fecha;RGB(180, 170, 193)
'Pend. F.Fix.';bw:1..bw:fac;NO;;;80;fecha;RGB(180, 170, 193)
