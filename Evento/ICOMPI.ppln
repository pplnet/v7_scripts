creardialogo
nroperacion1: 'Op  Desde'
nroperacion2: 'Op. Hasta'
string:'Condicion de Select Comisiones'
string1:'Condicion de Select Cuotas'
cantidad1:'Monto de la comision'
findialogo

if (not ok)
Cancelar()
endif

Message('Generando Comisiones Operacion '~dialogo.nroperacion2~' Vinculada ...')

sql.add(" SELECT C.*  FROM "~Dbo()~".COMISIONES2 C ")
sql.add(" WHERE  C.NrOperacion='"~dialogo.nroperacion1~"' AND "~dialogo.string~"  ")

Acn(w1, 1)

recorrer sql
Message('Recuperando Comision Nr: '~FStr(Fbn()['NrComision'], 0, 0)~' de Fecha '~Fbn()['Fecha1']~'... ')

Acn(x1, Fbn()['Tasa1'])
Acn(x2, iif (Eqstr(Fbn()['RB2'], '0'), 36000, 36500))
Act(x3, Fbn()['Tipo'])
Act(x4, Fbn()['Especie1'])
Act(x5, Fbn()['Cliente1'])
Act(x6, Fbn()['RB1'])
Acn(x7, Fbn()['Tasa2'])
Acn(x8, Fbn()['Tasa3'])
Act(x9, Fbn()['RB2'])
Act(x10, Fbn()['Precio1'])

Acn(z1, BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion2))
Acn(z2, BuscarCampo('Operaciones', 'Plazo', 'NrOperacion', dialogo.nroperacion2))
Acd(z3, BuscarCampo('Operaciones', 'FechaVto', 'NrOperacion', dialogo.nroperacion2))

Acn(a1, dialogo.cantidad1)
Acn(a2, Val(a1) * Fbn()['Tasa2'] / 100)
Acn(a3, Val(a1) * Fbn()['Tasa3'] / 100)
Acn(a5, Val(a1) * Fbn()['Precio1'] / 100)
Acn(a4, Val(a1) + Val(a3) + Val(a5))

sql.add(" Insert Into "~Dbo()~".COMISIONES2 ")
sql.add(" (NrOperacion,Tipo,Tasa1,Importe1,")
sql.add(" Especie1,Fecha1,Cliente1,")
sql.add(" RB1,Tasa2,Importe2,")
sql.add(" Tasa3,Importe3,")
sql.add(" RB2,Importe4,NrComision,Precio1,Precio2,Cotizacion1,Cotizacion2) ")
sql.add(" Values ")
sql.add(" ('"~dialogo.nroperacion2~"','"~Val(x3)~"',"~FStr(0, 0, 5)~","~FStr(Val(a1), 0, 2)~",")
sql.add(" '"~Val(x4)~"','"~IdxDate(Val(z3))~"','"~Val(x5)~"',")
sql.add(" '"~Val(x6)~"',"~FStr(Val(x7), 0, 5)~","~FStr(Val(a2), 0, 2)~",")
sql.add(" "~FStr(Val(x8), 0, 5)~","~FStr(Val(a3), 0, 2)~",")
sql.add(" '"~Val(x3)~"',"~FStr(Val(a4), 0, 2)~","~FStr(Val(w1), 0, 0)~", ")
sql.add(" "~FStr(Val(x10), 0, 5)~","~FStr(Val(a5), 0, 2)~",-1,-1) ")
sql.new
sql.exec
Scn(w1, 1)

proximo
