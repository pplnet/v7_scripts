MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;
fecha2: 'Ult. Fin Mes';;;;NO;NO;;;;FinDeMes(PriDeMes(dialogo.fecha1) - 1)
findialogo

if (not ok)
raise('Evento Cancelado')
endif

if (dialogo.radio1 = 2 o dialogo.radio1 = 4)
Message('--- Asientos Cobros/Pagos NDF ---')
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))
Act(ta:1, Var('TIPASILNDF'))
Acn(na:1, Var('ASINUM'))
Act(vc:1, dialogo.vehiculo1)
Acn(xx:1, 0)
Sqladd("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1,  O.Especie as EspBNA,")
Sqladd("       MO.Cantidad*-1 as Cantidad, MA.Codigo CodAsi, C.Jerarquia, C.PaisDir, O.Book1,")
Sqladd("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Mercado4, ")
Sqladd("       T.Especie, O.TipoOp, O.NrOperacion, O.Cliente1 Cliente , T.Cuenta2 as Cuenta2,")
Sqladd("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
Sqladd("       (Select sum(MTM) from "~Dbo()~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' ) as AcumMTM, ")
Sqladd("       (Select sum(MTMEspecie) from "~Dbo()~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'MTM') as AcumEspMTM, ")
Sqladd("       (Select MTMEspecie from "~Dbo()~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'FIX') as EspFIX, ")
Sqladd("       (Select sum(Case When DebitoCredito = 'DEB' Then Cantidad1 Else -1*Cantidad1 End) from "~Dbo()~".ASIENTOSCON1 AS1 Where AS1.NrOperacion = O.NrOperacion and AS1.NrUnicoAsiento in (Select NrUnicoAsiento from "~Dbo()~".ASIENTOSCON  Where Modelo='FXCVR' and Cuenta ='"~Var('CTADIFCBIO')~"')) as Revaluo ")
Sqladd("  FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".MERCADOS M, "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVEJECUTADOS MO ")
Sqladd(" WHERE O.TipoOp IN ('FXCF','FXVF') ")
Sqladd("   AND O.NrOperacion = MO.NrOperacion ")
Sqladd("   AND T.NrTrans = MO.NrTrans2 ")
Sqladd("   AND MO.Especie = O.TasaEspecie ")
Sqladd("   AND MO.NrSaldo = 1 ")
Sqladd("   AND T.Especie = O.TasaEspecie ")
Sqladd("   AND C.Codigo  = O.Cliente1 ")
Sqladd("   AND MA.TipoAsiento = '"~Var('TIPASILNDF')~"' ")
Sqladd("   AND T.TipoTr2 in ('RET','DEP') ")
Sqladd("   AND T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd("   AND O.Mercado4 = M.Codigo ")
Sqladd("   AND M.MTM          = 0 ")
Sqladd(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Watch(Sqlbatch())
recorrer sql
Acd(fv:1, Fbn('Fecha'))
Acd(fd:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, Fbn('TipoOp'))
Act(nr:1, Fbn('NrOperacion'))
Acn(co:1, Query("SELECT PrecioContable FROM "~Dbo()~".COTIZACIONES WHERE Codigo='"~Fbn('EspBNA')~"' and Fecha="~IdxDate2(Fbn('Fecha'))~" and CallPut='CON' And Moneda='"~Var('MONELOCA')~"' "))
Acn(no:1, Round(iif (Eqstr(Fbn('Especie'), Var('MONELOCA')), Fbn('Cantidad'), Fbn('Cantidad') * Val(co:1)), 2))
Acn(re:1, Fbn('AcumMTM') + ((Fbn('EspFIX') - Fbn('AcumEspMTM')) * Val(co:1)))
Acn(rv:1, Fbn('Revaluo'))
if (Val(re:1) > 0)
Acn(re:1, Round(Val(re:1) + Val(rv:1), 2))
else
Acn(re:1, Round(Val(re:1) - Val(rv:1), 2))
endif
Acn(re:2, Round(iif ((Val(no:1) < 0 y Val(re:1) > 0) o (Val(no:1) > 0 y Val(re:1) < 0), Abs(Val(re:1)) + Abs(Val(no:1)), iif (Abs(Val(no:1)) > Abs(Val(re:1)), Abs(Val(no:1)) - Abs(Val(re:1)), Abs(Val(re:1)) - Abs(Val(no:1)))), 2))
if (Eqstr(Fbn('Mercado4'), Var('MERROFEX')))
Act(ct:1, Var('RDOROFEX'))
else
Act(ct:1, Query("Select Cuenta from "~Dbo()~".RELACIONCUENTA   where Book = '"~Fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~Fbn('TipoOp')~"%' "))
endif

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
endif
