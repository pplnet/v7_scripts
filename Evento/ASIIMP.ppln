Sqladd(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
Sqladd(" C.CUIT, M.NrMov, M.Cuenta ")
Sqladd(" From "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND M.Cliente = C.Codigo ")
Sqladd(" AND O.NrOperacion = B.NrOperacion ")
Sqladd(" AND B.NrBit >= 19 ")
Sqladd(" AND B.Valor = '1' ")
Sqladd(" AND O.NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" AND M.Especie IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ")
Sqladd(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
Sqladd(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")
Sqladd(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")
Sqladd(" AND M.NrMov IN (Select M1.NrMov From "~Dbo()~".MOVPENDIENTES M1 ")
Sqladd("                 Where M1.NrOperacion = O.NrOperacion ")
Sqladd("                 AND M.NrMov Not IN (Select I.Plazo4 From "~Dbo()~".IMPUESTOS I ")
Sqladd("      	                          Where I.NrOperacion = O.NrOperacion ")
Sqladd("                                     AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
Sqladd("                                     AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' '))) ")
Sqladd(" AND M.FechaMov = (Select Min(M2.FechaMov) From "~Dbo()~".MOVPENDIENTES M2 ")
Sqladd("                   Where M2.NrOperacion = O.NrOperacion ")
Sqladd("                   AND (M2.FechaMov > O.FechaOp OR M2.NrMov > 1) ")
Sqladd("                   AND (M2.NrMov < 8000 OR M2.NrMov > 9000) ")
Sqladd("                   AND (M2.NrMov < 7000 OR M2.NrMov > 7100) ")
Sqladd("                   AND M2.NrMov Not IN (Select I1.Plazo4 From "~Dbo()~".IMPUESTOS I1 ")
Sqladd("                                        Where I1.NrOperacion = O.NrOperacion ")
Sqladd("                                        AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
Sqladd("                                        AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' '))) ")
recorrer sql
