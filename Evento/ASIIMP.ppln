Sqladd(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
Sqladd(" C.CUIT, 1 Estado, M.NrMov, M.Cuenta, I.Fecha1 FechaFac, I.Cantidad2 TotalFac, I.String21 CAI, I.String24 CBarra ")
Sqladd(" From "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".IMPUESTOS I, "~Dbo()~".CLIENTES C ")
Sqladd(" Where I.NrOperacion = M.NrOperacion ")
Sqladd(" AND M.Cliente = C.Codigo ")
Sqladd(" AND I.NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND I.NrSisExterno = '"~Val(nf:1)~"' ")
Sqladd(" AND M.NrMov = I.Plazo4 ")
Sqladd(" AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ') ")
Sqladd(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
Sqladd(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")

Sqladd(" UNION ")

Sqladd(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
Sqladd(" C.CUIT, 0 Estado, M.NrMov, M.Cuenta, M.FechaMov FechaFac, 0 TotalFac, '' CAI, '' CBarra ")
Sqladd(" From "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND M.Cliente = C.Codigo ")
Sqladd(" AND M.NrOperacion = '"~Val(nr:1)~"' ")
Sqladd(" AND M.NrMov Not IN (Select Plazo4 From "~Dbo()~".IMPUESTOS I ")
Sqladd("                     Where I.NrOperacion = M.NrOperacion ")
Sqladd("                     AND (I.Check2 = 0 OR I.Check2 Is Null OR I.Check2 = '' OR I.Check2 = ' ') ")
Sqladd("                     AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ')) ")
Sqladd(" AND M.FechaMov = (Select Max(Fecha2) From "~Dbo()~".IMPUESTOS I ")
Sqladd("                   Where I.NrOperacion = M.NrOperacion ")
Sqladd("                   AND (I.Check2 = 0 OR I.Check2 Is Null OR I.Check2 = '' OR I.Check2 = ' ') ")
Sqladd("                   AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ') ")
Sqladd("                   AND I.NrSisExterno = '"~Val(nf:1)~"') ")
Sqladd(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")
Sqladd(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
Sqladd(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")
Sqladd(" Order By Estado Desc ")
recorrer sql
