Sqladd(" Select O.NrOperacion, O.FechaOp, O.Cliente1, O.TipoOp, O.Especie, O.Cantidad, O.ContraEspecie, O.CB3, O.Vehiculo1 ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" where  O.NrOperacion = B.NrOperacion ")
Sqladd(" and B.NrBit > 19 and B.Valor ='1' ")
Sqladd(" and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and (O.NrOrden Is Null OR O.NrOrden = '') ")
if (NoVacio(Val(zz:6)))
Sqladd("   and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz:6))~") ")
endif
Sqladd(" order by O.NrOperacion ")
Watch(Sqlbatch())
recorrer sql
Act(aa:fac, Fbn()['NrOperacion'])
Acd(ab:fac, Fbn()['FechaOp'])
Act(ac:fac, Fbn()['Cliente1'])
Act(ad:fac, Fbn()['TipoOp'])
Act(ae:fac, Fbn()['Especie'])
Acn(af:fac, Fbn()['Cantidad'])
Act(ag:fac, Fbn()['ContraEspecie'])
Act(ah:fac, Fbn()['Vehiculo1'])
