Acn(bd:1, 0)
sql.add(" Select 1 From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVEJECUTADOS M ")
sql.add(" Where O.NrOperacion = M.NrOperacion ")
sql.add(" AND O.Mercado = '"~ItemLista(Val(ls:3), &k)~"' ")
if (Eqstr(Val(ab:fac), 'Moneda'))
sql.add(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(ab:fac), 'Titulo'))
sql.add(" AND O.TipoOp IN ('TICF','TIVF') ")
endif
sql.add(" AND M.FechaMov =  ")
sql.add(" CASE WHEN O.Mercado4 = '"~Var('AMBROFEX')~"' THEN '"~IdxDate(Val(fe:3))~"' ")
sql.add("      WHEN O.Mercado4 = '"~Var('AMBMAE')~"' THEN  '"~IdxDate(Val(fe:2))~"' ")
sql.add("      ELSE '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" END ")

sql.add(" AND M.NrMov >= 1000 ")
if (NoVacio(dialogo.cliente1))
sql.add("   and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
recorrer sql
