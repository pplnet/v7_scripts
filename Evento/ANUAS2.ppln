mostrarcuadrodemensajes
creardialogo
fecha1: 'D.Fecha';;;;;;;;;FSys()
fecha2: 'H.Fecha';;;;;;;;;FSys()
lista2: 'Vehiculos';4;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
lista1: 'Tipos de Asientos';-2;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".TIPOSASIENTO ");
listatabla1: 'Operaciones';0;1;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
findialogo
if (not ok)
Cancelar()
endif

Message('--- Anulacion de Asientos ---')

sql.add(" Select A.NrUnicoAsiento, MA.Codigo CodAsi, A.NrAsiento, A.Estado ")
sql.add(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO MA,"~Dbo()~".ASIENTOSCON1 A1 ")
sql.add(" Where MA.Codigo = A.Modelo ")
sql.add(" AND   A.NrUnicoAsiento = A1.NrUnicoAsiento  ")
sql.add(" AND   A.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND   A.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' ")
sql.add(" AND   (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'NC' OR A.Estado = 'REV' OR A.Estado = 'CI') ")

if (NoVacio(dialogo.lista2))
sql.add(" AND (A.Vehiculo IN ("~pipe2comillas(dialogo.lista2)~") OR A.Vehiculo is null OR A.Vehiculo = '' OR A.Vehiculo = ' ' ) ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND A.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif

if (NoVacio(dialogo.lista1))
sql.add(" AND  MA.TipoAsiento IN ("~pipe2comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.listatabla1))
sql.add(" AND  A.NrOperacion IN ("~pipe2comillas(dialogo.listatabla1)~") ")
endif

sql.add(" Order By 2 ")
recorrer sql
Message('Borrando Asientos Previos - Modelo '~Fbn('CodAsi'))
sql.add(" Delete "~Dbo()~".ASIENTOSCON1 ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.add(" Delete "~Dbo()~".ASIENTOSCON ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
if (Incluido(Fbn('Estado'), 'COT|NC|REV'))
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
sql.add(" Set NrAsiento = Null ")
sql.add(" Where NrAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
endif
sql.exec
proximo

