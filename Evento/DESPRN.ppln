sql.add("Select * from "~Dbo()~".MOVEJECUTADOS M            ")
sql.add("Where NrTrans2 = '"~dialogo.nrtrans1~"'          ")
sql.add("  and NrOperacion <> '"~dialogo.nrtrans1~"'      ")
sql.add("  and exists(select * from "~Dbo()~".OPERACIONES O ")
sql.add("             where M.NrOperacion=O.NrOperacion   ")
sql.add("             and O.TipoOp in ('FXCT','FXVT')     ")
sql.add("             and O.MB3='1'                       ")
sql.add("             and O.FormaLiquidacion1='1'         ")
sql.add("            )                                    ")
recorrer sql
