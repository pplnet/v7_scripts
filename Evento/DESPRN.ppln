Sqladd("Select * from "~Dbo()~".MOVEJECUTADOS M            ")
Sqladd("Where NrTrans2 = '"~dialogo.nrtrans1~"'          ")
Sqladd("  and NrOperacion <> '"~dialogo.nrtrans1~"'      ")
Sqladd("  and exists(select * from "~Dbo()~".OPERACIONES O ")
Sqladd("             where M.NrOperacion=O.NrOperacion   ")
Sqladd("             and O.TipoOp in ('FXCT','FXVT')     ")
Sqladd("             and O.MB3='1'                       ")
Sqladd("             and O.FormaLiquidacion1='1'         ")
Sqladd("            )                                    ")
recorrer sql
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Val(a:fac)))
Acn(c:fac, Query("Select SUM(Monto) from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(a:fac)~"' and Limite = 'PRESETTLEM' "))
Acn(d:fac, Query("Select SUM(Monto) from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(a:fac)~"' and Limite = 'PSVN' "))
if (Val(c:fac) > 0)
Act(e:fac, 'PRESET')
Sqladd("Select * from "~Dbo()~".MOVLIMITES Where NrOperacion = '"~Val(a:fac)~"' and Limite = 'PRESETTLEM' ")
recorrer sql
