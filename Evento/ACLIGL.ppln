creardialogo
radio1:'Tipo|Credito|Posicion';1;1;;;;;;;0
lista2:'Especies';2;1;;;;;;;;;SQLSet("Select Codigo  from "~Dbo()~".ESPECIES Where Codigo In ("~pipe2comillas(Var('LISCONTRA'))~")"))
lista1:'Clientes';-4;2;;;;;;;;;SQLSet("Select Distinct Cliente  from "~Dbo()~".LIMASIGNADOS Order By Cliente"))
lista3:'Limite';3;1;;;;;;;;;SQLSet("Select Codigo from "~Dbo()~".TIPOSLIMITE Where Clase= '"~iif (dialogo.radio1 = 0, 'C', 'P')~"' "))
findialogo

if (not ok)
Cancelar()
endif

sql.add(" Select * from "~Dbo()~".LIMASIGNADOS L,"~Dbo()~".TIPOSLIMITE T WHERE ")
sql.add(" L.Limite=T.Codigo and ")
if (dialogo.radio1 = 0)
sql.add(" T.Clase='C' ")
else
sql.add(" T.Clase='P' ")
endif
if (NoVacio(dialogo.lista1))
sql.add(" and L.Cliente In ("~pipe2comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.lista2))
sql.add(" and L.Especie In ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" and L.Limite In ("~pipe2comillas(dialogo.lista3)~") ")
endif

sql.add(" ORDER BY Cliente,Limite,Especie ")

Acn(x1, 0)

recorrer sql

Acn(x1, 1)
Message('*-- Recuperando Limites '~Fbn()['Cliente'])

Acn(a:fac + 1, 1)
Act(b:fac + 1, Fbn()['Cliente'])
Act(c:fac + 1, Fbn()['Limite'])
Act(d:fac + 1, Fbn()['Especie'])
Acn(e:fac + 1, Fbn()['Monto'])
Acd(f:fac + 1, Fbn()['FAsignacion'])
Acd(g:fac + 1, Fbn()['FRevision'])
Acd(h:fac + 1, Fbn()['FVencimiento'])
proximo

if (Val(x1) = 1)
creardialogo
fecha1:"Asignacion";;;;;;NoVacio(dialogo.fecha1) y dialogo.fecha1 >= FSys();'La Fecha de Asignacion no debe ser inferior a la Fecha del Sistema';;FSys()
fecha2:"Revision";;;;;;NoVacio(dialogo.fecha2) y dialogo.fecha2 >= dialogo.fecha1;'La Fecha de Revision no debe ser inferior a la Fecha de Asignacion';;FSys() + 180
fecha3:"Vencimiento";;;;;;NoVacio(dialogo.fecha3) y dialogo.fecha3 >= dialogo.fecha2;'La Fecha de Vencimiento no debe ser inferior a la Fecha de Revision';;FSys() + 365
listbox;'Arial,8,N';460;180
'Cambia?';a2..a: Fac() + 1;;;;;20;check
'Cliente';b2..b: Fac() + 1;NO;;;;60;string
'Limite';c2..c: Fac() + 1;NO;;;;60;string
'Especie';d2..d: Fac() + 1;NO;;;;35;tabla;'Especies';'Codigo';'Codigo;Nombre';
'Cantidad';e2..e: Fac() + 1;NO;;;;80;numero;'##,###,###.##'
'Asignacion';f2..f: Fac() + 1;NO;;;;;fecha
'Revision';g2..g: Fac() + 1;NO;;;;;fecha
'Vencimiento';h2..h: Fac() + 1;NO;;;;;fecha
finlistbox
findialogo

if (not ok)
Cancelar()
endif

recorrer&i 2, Fac() + 1
Message('Validando Renglon '~FStr(&i - 1, 2, 0)~' Cliente: '~Val(b:&i))

if (NoVacio(Val(a:&i)) y Val(a:&i) <> 0)
sql.add("Update "~Dbo()~".LIMASIGNADOS Set ")
sql.add("FAsignacion   ='"~IdxDate(dialogo.fecha1)~"', ")
sql.add("FRevision     ='"~IdxDate(dialogo.fecha2)~"', ")
sql.add("FVencimiento  ='"~IdxDate(dialogo.fecha3)~"' ")
sql.add("Where Cliente ='"~Val(b:&i)~"' and Limite='"~Val(c:&i)~"' and Especie='"~Val(d:&i)~"' ")
sql.new
endif

proximo
sql.exec
else
Messagebox('No existe ningun Limite Asignado a Modificar  ...')
endif
