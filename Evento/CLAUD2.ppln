sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("SET Valor = '0' ")
sql.add("where NrOperacion = '"~Val(aa:&i)~"' ")
sql.add("and NrBit = 2 ")
sql.new

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("SET Valor = '1' ")
sql.add("where NrOperacion = '"~Val(aa:&i)~"' ")
sql.add("and NrBit = 3 ")
