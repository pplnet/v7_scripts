creardialogo
vehiculo1: 'Vehiculo';;;;;;NoVacio(dialogo.vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
fecha1:'Fecha Cierre';;;;;;dialogo.fecha1 > 0;'Fecha incorrecta';NO;FSys();
check1:'Automatico';;1;;;;;;;0;
findialogo
if (not ok)
Cancelar()
endif

Act(y1, Fecha(FSys(), 'YYYY.MM.DD'))

SetFilaActual(0)
Sqladd("Select T.Mercado1, T.TipoTr2, T.Cliente1, T.CB5, T.NrOperacionRef1, ")
Sqladd("T.NrTrans, T.Especie, T.Cantidad1, T.Fecha2, T.Cuenta1, ")
Sqladd("T.Cuenta2, T.Especie1, T.Cantidad2, T.Cupon1, T.CB6, ")
Sqladd("T.CB7, T.CB8 ")
Sqladd("from "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" where T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd("   and T.TipoTr2   = 'TRANSP' ")
Sqladd("   and T.CB2      <> '1' ")
Sqladd("   and T.Fecha2 <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("Order By 1, 7, 3")

recorrer sql
Acn(p:fac, 1)
Act(bi:fac, Fbn()['NrTrans'])
Act(cb:fac, Fbn()['TipoTr2'])
Act(ba:fac, Fbn()['Cliente1'])
Act(be:fac, Fbn()['Especie'])
Acn(bg:fac, Fbn()['Cantidad1'])
Acd(bj:fac, Habiles(FSys(), 1, 'ARG', SI))
proximo

ACO(53, 9)
ACO(54, 4)
ACO(55, 3)
ACO(56, 7)
ACO(57, 9)
ACO(58, 12)
ACO(59, 12)
ACO(60, 4)
ACO(61, 7)
ACO(62, 9)
