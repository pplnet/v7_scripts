if (Fac() > 0)

if (dialogo.check1 = 0)
crearlistbox;'Arial,8,';'GENERACION FALLAS'
'Cliente';ba1..ba:fac;NO;;;150;string;;exe('COLOR6');
'Especie';be1..be:fac;NO;;;70;string;;exe('COLOR6');
'Moneda';bg1..bg:fac;NO;;;110;numero;'###,###,###,###.##';exe('COLOR6');
'Falla';bi1..bi:fac;NO;;;70;string;;exe('COLOR6');
'Fecha';bj1..bj:fac;NO;;;60;fecha;exe('COLOR6');
'Ok';p1..p:fac;;;;30;check;exe('COLOR3');;;;;;NO;;
finlistbox
endif


if (ok o dialogo.check1 = 1)
recorrer&i 1, Fac()
if (Val(p:&i) = 1)
sql.add("UPDATE "~Dbo()~".TRANSACCIONES2 ")
sql.add("SET Fecha4 = '"~IdxDate(Val(bj:&i))~"' ")
sql.add("Where NrTrans = '"~Val(bi:&i)~"' ")
sql.new
sql.exec

modificaroperacion(Val(bi:&i), 0, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, SI, NO, SI, NO, NO, NO, 1)
endif
proximo
endif
else
if (dialogo.check1 = 0)
Messagebox('No hay Fallas para Modificar.')
endif
