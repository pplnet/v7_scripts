Sqladd("Update "~Dbo()~".OPERACIONES SET ")
Sqladd(" NrOperacion4 = '"~Val(w:2)~"', CB3 = '1' WHERE  NrOperacion= '"~Val(a1)~"'  ")
Sqlnew()
endif



Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion,NrBit,Valor) ")
Sqladd("SELECT '"~Val(a1)~"' As NrOperacion,NrBit,Valor ")
Sqladd("  FROM "~Dbo()~".OPERACIONESBITS ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor = '0' ")
Sqladd(" Where NrOperacion = '"~Val(a1)~"' ")
Sqladd("   and NrBit       = '1' ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor = '1' ")
Sqladd(" Where NrOperacion = '"~Val(a1)~"' ")
Sqladd("   and NrBit       = '15' ")
Sqlnew()
Sqlexec()

