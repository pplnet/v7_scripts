CrearDialogo
    String1   : 'Codigo'                ;2;1;
FinDialogo

IF NOT OK
   Cancelar
Endif
ACT(A:1,'')
ACN(A:2,0)
SQL.ADD("select Codigo, RankingTiposValuacion from ModelosNegocio")
recorrer SQL
    Recorrer&i 1, Elementos(fbn('RankingTiposValuacion'))
        If Val(A:2)=0
            If Incluido(ItemLista(fbn('RankingTiposValuacion'),&i),Dialogo.String1)
                If eqstr(val(A:1),'')
                    ACT(A:1,fbn('Codigo'))
                Else
                    ACT(A:1,val(A:1)~', '~fbn('Codigo'))
                EndIf
                &i = Elementos(fbn('RankingTiposValuacion'))
            EndIf
        EndIf
    Proximo
    ACN(A:2,0)
Proximo
messagebox("No puede borrarse Rankings asociados a algun Modelo de Negocio. El Ranking "~Dialogo.String1~" esta asociado a los Modelos: "~val(A:1))