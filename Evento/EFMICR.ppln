let(&nroperacion, '')

sql.add("Select EnteCustodia Vehiculo1, Especie, S.Book, Cuenta CuentaCustodia,'' Concepto, Saldo ")
sql.add("from "~Dbo()~".SALDOSDIA S ")
sql.add("JOIN "~Dbo()~".CUENTAS C ON S.Cuenta = C.Codigo")
sql.add("Where C.Cliente = '"~dialogo.vehiculo1~"' ")
sql.add("AND C.EsEfMiCr = 'SI' ")
sql.add("AND S.NrSaldo = 101 ")
sql.add("AND S.Mercado = '"~Var('MERCACRYL')~"'")
sql.add("AND S.Cliente ='"~dialogo.vehiculo1~"' ")
sql.add("AND "~Dbo()~".DesciendedeEspecie(S.Especie,'TITULO')=1  ")
sql.add("AND S.Fecha = (SELECT Max(S1.Fecha) FROM "~Dbo()~".SALDOSDIA S1 ")
sql.add("              WHERE S1.Cliente = S.Cliente ")
sql.add("              AND   S1.Especie = S.Especie ")
sql.add("              AND   S1.Mercado = S.Mercado ")
sql.add("              AND   S1.EnteCustodia = S.EnteCustodia ")
sql.add("              AND   S1.NrSaldo = S.NrSaldo  ")
sql.add("              AND   S1.Cuenta  = S.Cuenta   ")
sql.add("              and   IsNull(S.PrecioEj,0)      = IsNull(S1.PrecioEj,0) ")
sql.add("              and   IsNull(S.FechaEj,0)       = IsNull(S1.FechaEj,0) ")
sql.add("              and   IsNull(S.CallPut,'')      = IsNull(S1.CallPut,'') ")
sql.add("              AND   S1.Fecha <= '"~IdxDate(Val(fv:1))~"' ) ")
sql.add(" and Saldo <> 0 ")
sql.add(" Group by EnteCustodia,Especie,S.Book,Cuenta, Saldo")
Watch(sql.batch)

recorrer sql

Act(cc:1, Fbn('CuentaCustodia'))
Act(bk:1, Fbn('Book'))
Act(vh:1, Fbn('Vehiculo1'))
Act(co:1, Fbn('Concepto'))
Acn(ca:1, Fbn('Saldo'))
let(&cuentacustodia, Fbn('CuentaCustodia'))

sql.add(" Select  Codigo,MonedaEmision, Tipo TipoEspecie, Issuer, Alias1 as EspBanTotal, VTeorico as VTeorico, Cotiza ")
sql.add(" From "~Dbo()~".ESPECIES ")
sql.add(" Where Codigo = '"~Fbn('Especie')~"' ")
recorrer sql
Act(ms:1, Fbn('MonedaEmision'))
Act(ts:1, Fbn('TipoEspecie'))
Act(is:1, Fbn('Issuer'))
Act(eb:1, Fbn('EspBanTotal'))
Act(es:1, Fbn('Codigo'))
Act(ec:1, Fbn('Cotiza'))
Acn(vt:1, Fbn('VTeorico'))


proximo


let(&valorresidual, 0)
let(&valorcontable, 0)
let(&valorcontadovaluado, 0)

let(&cotiza, Val(ec:1))
let(&especie, Val(es:1))
let(&fecharevaluo, Val(fv:1))
let(&book, Val(bk:1))

let(&nrcupon, NrCupon2(&especie, Val(fv:1)))
let(&tipocupon, sql("Select TipoCupon from "~Dbo()~".AGENDACUPONES where NrCupon = '"~FStr(&nrcupon, 0, 0)~"' AND Especie = '"~&especie~"' "))

if (Eqstr(&tipocupon, 'AMO'))
let(&tipocupon, 1)
else
if (Eqstr(&tipocupon, 'REN'))
let(&tipocupon, 2)
else
if (Eqstr(&tipocupon, 'RYA'))
let(&tipocupon, 3)
else
let(&tipocupon, 0)
endif
endif
endif

let(&valorcontable, Val(ca:1))

let(&valorresidual, iif (Val(vt:1) <> 0, Val(vt:1), 1) * &valorcontable)

let(&cotiniif, CotizacionNIIF(&especie, Val(fv:1), &book))

if (Vacio(&cotiniif))
let(&precioniif, 0)
else
let(&precioniif, &cotiniif.preciocotizaciondeterminada)
endif
Acn(co:1, Cotizacion(&especie, null, null, null, Val(fv:1), 1) * CotizacionC(BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', &especie), null, null, null, Val(fv:1), 25, SI, 'ARP'))

if (&precioniif = 0)
let(&precioniif, Val(co:1))
endif

if (not Eqstr(&cotiza, Val(ml:1)))
let(&monedaaconvertir, &cotiza)
let(&monedaexpresion, Val(ml:1))
let(&valorcontablevaluado, &valorcontable * &precioniif * EvalFormula('TCCONTABREVAL'))
else
let(&valorcontablevaluado, &valorcontable * &precioniif)
endif

let(&especiedecorte, Val(es:1))

let(&informafecinc, 'SI')


let(&cuentacontable, RelacionCuenta('', '', '', '', 'TIC', '', '', '', 'TITULO', '', Val(ms:1), '', '', '', Val(ts:1), '', Val(bk:1), EvalFormula('VEHICULO'), null, null, null, null, null, EvalFormula('CTACUSTODIA'), EvalFormula('CONCEPTO')))

let(&tiporegistro, 'S')

Message('Procesando Especie: '~&especie)
recorrer&i Val(fv:1), Habiles(Val(fv:1), 1, 'ARG', SI) - 1
sql.add("INSERT INTO "~Dbo()~"."~&tablainformada~" ( ")
sql.add("Fecha, Especie, TipCupon, CuentaContable, ValorResidual, ")
sql.add("ValorContable, ValorContValuado, FecIncorporacion, ")
sql.add("TipoRegistro, NrOperacion, Cotizacion, CuentaCustodia,InformaFecInc) ")
sql.add("VALUES ( ")
sql.add("'"~IdxDate(&i)~"','"~&especie~"', "~FStr(&tipocupon, 0, 0)~",'"~&cuentacontable~"',"~FStr(&valorresidual, 0, 0)~", ")
sql.add(" "~FStr(&valorcontable, 0, 0)~", "~FStr(&valorcontablevaluado, 0, 2)~", '"~IdxDate(&fechaproceso)~"', ")
sql.add("'"~&tiporegistro~"', '"~&nroperacion~"', "~FStr(&precioniif, 0, 8)~", '"~&cuentacustodia~"', '"~&informafecinc~"') ")
sql.new
sql.exec
