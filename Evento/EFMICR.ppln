Act(ml:1, Var('MONELOCA'))
Acd(fv:1, dialogo.fecha1)
let(&fechaproceso, Fecha(dialogo.fecha1))
let(&tablainformada, 'EFECTIVOMINIMOCRYL')

sql.add(" Delete "~Dbo()~"."~&tablainformada~" WHERE FecIncorporacion = '"~IdxDate(&fechaproceso)~"' ")
