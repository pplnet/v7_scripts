Cancelar('La operacion N# '~dialogo.nroperacion1~' No es un Swap Variable Variable MV')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
