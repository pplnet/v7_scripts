Acn(z24, ((Fbn()['Cantidad1'] * (dialogo.precio2 + Fbn()['Total3'])) / 100) * FactorDias(Fbn()['Fecha1'], Fbn()['Fecha2'], Val(z11)))
Acn(z25, ((Fbn()['Cantidad2'] * (dialogo.precio3 + Fbn()['Total4'])) / 100) * FactorDias(Fbn()['Fecha5'], Fbn()['Fecha6'], Val(z12)))

Message('Calculando resultado .... ')
if (Eqstr(BuscarCampo('Operaciones', 'Especie', 'NrOperacion', dialogo.nroperacion1), BuscarCampo('Operaciones', 'ContraEspecie', 'NrOperacion', dialogo.nroperacion1)) y Val(ck1) = 0 y dialogo.precio2 <> 0 y dialogo.precio3 <> 0)
Acn(z20, Val(z25) - Val(z24))
endif

if (dialogo.precio2 <> 0 y dialogo.precio3 <> 0)
Act(zz1, '1')
else
Act(zz1, '0')
endif

Message('Actualizando la Opcion .... ')
Sqladd("UPDATE "~Dbo()~".CUOTAS ")
Sqladd("SET    Check1 = '"~Val(zz1)~"', ")
Sqladd("       Fecha4 = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("       Fecha3 = '"~IdxDate(dialogo.fecha3)~"', ")
Sqladd("       Total2   = "~FStr(Val(z20), 0, 2)~", ")
Sqladd("       Precio1   = "~FStr(dialogo.precio2, 0, 7)~",  ")
Sqladd("       Cantidad3   = "~FStr(Val(z24), 0, 7)~",  ")
Sqladd("       Precio5   = "~FStr(Val(z24), 0, 7)~",  ")
Sqladd("       Precio2   = "~FStr(dialogo.precio3, 0, 7)~",  ")
Sqladd("       Cantidad4   = "~FStr(Val(z25), 0, 7)~",  ")
Sqladd("       Precio6   = "~FStr(Val(z25), 0, 7)~"  ")
Sqladd("WHERE  NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("       and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
Sqlnew()
Sqlexec()

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


