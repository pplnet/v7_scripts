precio3:"Tasa_C";;;;;;dialogo.precio3 <= Var('RTASA2') y dialogo.precio3 >= Var('RTASA1');'Tasa de la Contraparte Fuera de Rango:'~Var('RTASA1')~" Y "~Var('RTASA2');SI;0
