CrearDialogo
FinDialogo

If not ok
   Cancelar
EndIf

SQL.ADD("Select * from "~DBO~".OPERACIONES Where TipoOp like 'MM%' and (IntDevengados2=0 or IntDevengados2 is null)")

Recorrer  SQL
   Message("Operacion "~FBN['NrOperacion'])

   SQL.ADD("UPDATE "~DBO~".OPERACIONES Set IntDevengados2=-1 Where NrOperacion='"~FBN['NrOperacion']~"' ")
   SQL.NEW
   SQL.EXEC
Proximo

SQL.ADD("Select C.* FROM "~DBO~".CUOTAS C,"~DBO~".OPERACIONES O Where O.NrOperacion=C.NrOperacion and O.TipoOp like 'MM%' and (C.Cotizacion1=0 or C.Cotizacion1 is null or C.Cotizacion2=0 or C.Cotizacion2 is null)")

Recorrer SQL
      ACT(x1,'')

      Message("Operacion "~FBN['NrOperacion']~" "~Fstr(FBN['NrCuota'],0,0))

      IF FBN['Cotizacion1']=0 o Vacio(FBN['Cotizacion1'])
         ACT(x1,"Cotizacion1=-1 ")
      EndIf
      IF FBN['Cotizacion2']=0 o Vacio(FBN['Cotizacion2'])
         IF NoVacio(VAL(x1))
            ACT(x1,val(x1)~",")
         EndIf
         ACT(x1,val(x1)~"Cotizacion2=-1 ")
      EndIf

      SQL.ADD("UPDATE "~DBO~".CUOTAS Set ")
      SQL.ADD(" "~val(x1)~" ")
      SQL.ADD(" Where NrOperacion='"~FBN['NrOperacion']~"' and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
      SQL.NEW
      SQL.EXEC
Proximo

