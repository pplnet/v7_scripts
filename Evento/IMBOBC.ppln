creardialogo
fecha1:'Fecha Desde';1;1;;;;dialogo.fecha1 <> 0;'Fecha Desde Invalida';NO;FSys();
fecha2:'Fecha Hasta';1;2;;;;dialogo.fecha2 <> 0;'Fecha Hasta Invalida';NO;FSys();
radio5:'Salida|Impresion|Pantalla';2;1;;;;;;;1
radio6:'Estado|Todas|Vig|Anul';;1;;;;;;;0
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio6 <= 1)
Sqladd("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie1,")
Sqladd("T.Cliente1,T.Ley5 as NrCUIT,T.Ley2 as Direccion,T.Ley3 as Localidad,")
Sqladd("T.CEmpresa1 as Provincia,T.CEmpresa2 as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
Sqladd("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
Sqladd("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
Sqladd("T.Ley4 as Pagador,T.Cuenta1,T.Ley1 as Domicilio,T.CEmpresa4 as PaisPagador,T.Cambio4 as CodSwifPag,")
Sqladd("CB.Descripcion,'Vigente' as Estado,C.RazonSocial ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T,"~Dbo()~".CLIENTES C, "~Dbo()~".CONCEPTOSBCRA CB ")
Sqladd("WHERE ")
Sqladd(" T.Cliente1 = C.Codigo AND ")
Sqladd(" T.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' AND ")
Sqladd(" T.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' AND ")
Sqladd(" T.TipoTr2 = 'BOBCRA' AND ")
Sqladd(" T.Cambio1 = CB.Codigo  ")
endif
if (dialogo.radio6 = 0)
Sqladd(" Union All ")
endif
if (dialogo.radio6 = 2 o dialogo.radio6 = 0)
Sqladd("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie1,")
Sqladd("T.Cliente1,T.Ley5 as NrCUIT,T.Ley2 as Direccion,T.Ley3 as Localidad,")
Sqladd("T.CEmpresa1 as Provincia,T.CEmpresa2 as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
Sqladd("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
Sqladd("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
Sqladd("T.Ley4 as Pagador,T.Cuenta1,T.Ley1 as Domicilio,T.CEmpresa4 as PaisPagador,T.Cambio4 as CodSwifPag,")
Sqladd("CB.Descripcion,'Anulado' as Estado,C.RazonSocial ")
Sqladd("FROM "~Dbo()~".BTRANSACCIONES2 T,"~Dbo()~".CLIENTES C, "~Dbo()~".CONCEPTOSBCRA CB ")
Sqladd("WHERE ")
Sqladd(" T.Cliente1 = C.Codigo AND ")
Sqladd(" T.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' AND ")
Sqladd(" T.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' AND ")
Sqladd(" T.TipoTr2 = 'BOBCRA' AND ")
Sqladd(" T.Cambio1 = CB.Codigo ")
endif
Sqladd("   ORDER BY 1")

Acn(az1, 4)
SetFilaActual(Val(az1))

recorrer sql

Scn(az1, 1)
Acn(z:fac, 1)
Act(aa:fac, Fbn()['Estado'])
Act(ab:fac, Fbn()['NrTrans'])
Acd(ac:fac, Fbn()['Fecha1'])
Act(ad:fac, Fbn()['Especie1'])
Act(ae:fac, Fbn()['Cliente1']~' '~Fbn()['RazonSocial'])
Acn(af:fac, Fbn()['Importe'])
Acn(ag:fac, Fbn()['Tipo'])
Act(ah:fac, Fbn()['Operacion'])
Act(ai:fac, Fbn()['Cliente1'])

proximo

if (Val(az1) > 4)

crearlistbox;'MS Arial,8,';Val(a1)
'Marca';z5..z:Val(az1);SI;SI;;30;check;RGB(220, 220, 193)
'Tipo Trans.';ag5..ag:Val(az1);NO;SI;;45;combo;'Compra|Venta|';RGB(180, 180, 193)
'Boleto   ';ab5..ab:Val(az1);NO;SI;;60;string;;RGB(180, 180, 193)
'OpRef';ah5..ah:Val(az1);NO;SI;;60;string;;RGB(180, 180, 193)
'Fecha';ac5..ac:Val(az1);NO;SI;;60;fecha;RGB(180, 180, 193)
'Especie';ad5..ad:Val(az1);NO;SI;;45;string;;RGB(180, 180, 193)
'Cliente';ae5..ae:Val(az1);NO;SI;;180;string;;RGB(180, 180, 193)
'Cantidad';af5..af:Val(az1);NO;SI;;90;numero;'##,###,###.##';RGB(180, 180, 193)
'Estado  ';aa5..aa:Val(az1);NO;SI;;90;string;;RGB(180, 180, 193)
finlistbox

if (ok)
recorrer&j 5, Val(az1)
if (Val(z:&j) = 1)
if (Val(ag:&j) = 1)
Linkearhoja('IMBCRV', 1, 'nrtrans1', Val(ab:&j), 'radio5', dialogo.radio5)
else
Linkearhoja('IMBCRC', 1, 'nrtrans1', Val(ab:&j), 'radio5', dialogo.radio5)
endif
endif
proximo
endif
else
