creardialogo
fecha1: 'Fecha desde';1;1;;;;dialogo.fecha1 <> 0;'Fecha invalida';NO;FSys()
fecha2: 'Fecha hasta';;;;;;dialogo.fecha2 <> 0 y dialogo.fecha1 < dialogo.fecha2;'Fecha invalida';NO;FSys()
especie1: 'Especie';;;;;;NoVacio(dialogo.especie1);'Debe seleccionar una especie';NO;;;
entero1: 'NroCuponOrigen';;;;;;NoVacio(dialogo.entero1) y dialogo.entero1 > 0;'NroCupon incorrecto';NO;
entero2: 'NroCuponDestino';;;;;;NoVacio(dialogo.entero2) y dialogo.entero2 > 0 y dialogo.entero2 <> dialogo.entero1;'NroCupon incorrecto';NO;
check1: 'Ejecuta Recalculo';;;;;;;;;1
findialogo

if (not ok)
Cancelar()
endif

Act(a1, FStr(dialogo.entero1, 1, 0))
Act(a2, FStr(dialogo.entero2, 1, 0))


sql.add("UPDATE "~Dbo()~".MOVEJECUTADOS SET Cupon = '"~Val(a2)~"' ")
sql.add("WHERE Especie = '"~dialogo.especie1~"' ")
sql.add("AND Cupon = '"~Val(a1)~"'")
sql.add("AND NrOperacion NOT LIKE 'C%'")
sql.add("AND FechaMov BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
sql.new


sql.add("UPDATE "~Dbo()~".MOVPOSEJE SET Cupon = '"~Val(a2)~"' ")
sql.add("WHERE Especie = '"~dialogo.especie1~"'")
sql.add("AND Cupon = '"~Val(a1)~"'")
sql.add("AND NrOperacion NOT LIKE 'C%'")
sql.add("AND FechaMov BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
sql.new


sql.add("UPDATE "~Dbo()~".MOVPENDIENTES SET Cupon = '"~Val(a2)~"' ")
sql.add("WHERE Especie = '"~dialogo.especie1~"'")
sql.add("AND Cupon = '"~Val(a1)~"'")
sql.add("AND NrOperacion NOT LIKE 'C%'")
sql.add("AND FechaMov BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
sql.new


sql.add("UPDATE "~Dbo()~".MOVPOSPEN SET Cupon = '"~Val(a2)~"' ")
sql.add("WHERE Especie = '"~dialogo.especie1~"'")
sql.add("AND Cupon = '"~Val(a1)~"'")
sql.add("AND NrOperacion NOT LIKE 'C%'")
sql.add("AND FechaMov BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
