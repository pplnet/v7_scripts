sql.add("UPDATE "~Dbo()~".OPERACIONES SET Cupon1 = '"~Val(a2)~"' ")
sql.add("WHERE Especie = '"~dialogo.especie1~"'")
sql.add("AND Cupon1 = '"~Val(a1)~"'")
sql.add("AND NrOperacion NOT LIKE 'C%'")
sql.add("AND FechaVto BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
sql.new


sql.exec

if (dialogo.check1 = 0)
Messagebox('Debe a ejecutar eventos RECPOS y RECSAL')
else
ejecutarevento('RECPOS', fecha1 = dialogo.fecha1, fecha2 = dialogo.fecha2, cliente1 = Var('VEHICULODE'), vehiculo1 = Var('VEHICULODE'), especie1 = dialogo.especie1)
ejecutarevento('RECSAL', fecha1 = dialogo.fecha1, especie1 = dialogo.especie1)
