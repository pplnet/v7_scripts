Sqladd("AND Cupon = '"~Val(a1)~"'")
Sqladd("AND NrOperacion NOT LIKE 'C%'")
Sqladd("AND FechaMov BETWEEN '"~IdxDate(dialogo.fecha1)~"' AND '"~IdxDate(dialogo.fecha2)~"'")
