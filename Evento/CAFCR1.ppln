emitircartavisible(&pf, Copy(directorio.string1, 1, Longitud(directorio.string1) - 5)~'_'~dialogo.nroperacion1, razon_social = &razon_social, localidad = &localidad, fecha_larga = &fecha_larga, usuario_activo = &usuario_activo, nr_operacion = &nroperacion, referencia = &referencia, oracion1 = &oracion1, oracion2 = &oracion2, oracion31 = &oracion31, oracion32 = &oracion32, oracion4 = &oracion4, oracion5 = &oracion5, pieahorro1 = &pieahorro1, pieahorro2 = &pieahorro2, pieahorro3 = &pieahorro3, pieahorro4 = &pieahorro4, pieahorro5 = &pieahorro5, pieahorro6 = &pieahorro6, razon_social2 = &razon_social2, CUIT() = &cuit, telefono = &telefono, fax = &fax, direccion = &direccion, datos_geograficos = &datos_geograficos)

