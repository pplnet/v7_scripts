Sqladd("select 'OPB' tipo,")
Sqladd("op.nroperacion,op.tipoop,op.cliente1,op.fechaop,op.fechavto,op.plazo,op.especie,op.cantidad,op.precio1,op.TotalAux2 totalcomisiones,op.totalnetocli1, movp.nrmov, op.TotalGastos TotalDerechos, op.TotalIvaAdi ivaderechos ")
