**MessageBox('INICIO Evento GENTIT')
if Dialogo.Check1=0
  HojaVisible(SI)
endif
ACT(v:5, VAR('AGESIOP'))
ACT(w:2, VAR('CONTROLAPM'))
* FJL 18/07/19 - El mensaje pro especie sancionada lo saca de la variable
ACT(w:4, VAR('MSGSISEXT'))

ACT(s:1, 'Secuencia2')
ACT(s:2, 'TipoOp')
ACT(s:3, 'Especie')
ACT(s:4, 'Cupon MAE')
ACT(s:5, 'Ag.Contra')
ACT(s:6, 'Num Ag.Contra')
ACT(s:7, 'Clie.Tabla')
ACT(s:8, 'Cliente')
ACT(s:9, 'Op.Contra (A)')
ACT(s:10, 'VTXT3 (A)')
ACT(s:11, 'Cantidad')
ACT(s:12, 'C.Especie')
ACT(s:13, 'PrecioMAE')
ACT(s:14, 'Precio3')
ACT(s:15, 'Precio4')
ACT(s:16, 'Intrereses MAE')
ACT(s:17, 'Nro.Cupon')
ACT(s:18, 'FechaOp txt (A)')
ACT(s:19, 'FechaOp')
ACT(s:20, 'RB5')
ACT(s:21, 'Plazo')
ACT(s:22, 'Mercado')
ACT(s:23, 'F.Liq.1')
ACT(s:24, 'Feriados')
ACT(s:25, 'Operador')
ACT(s:26, 'Op.SIOPEL')
ACT(s:27, 'Cod.MAE Esp.')
ACT(s:28, 'Cuenta1')
ACT(s:29, 'Vechiculo1')
ACT(s:30, 'UND1')
ACT(s:31, 'Mercado4')
ACT(s:32, '# Rueda')
ACT(s:33, 'Pase')
ACT(s:34, 'MAE1 (A)')
ACT(s:35, '# Cta.Ord.')
ACT(s:36, 'Referencia')
ACT(s:37, '# Num.Ref. (A)')
ACT(s:38, 'Cart.Propia (A)')
ACT(s:39, '# Tipo Cli')
ACT(s:40, 'Observ')
ACT(s:41, 'Cant.Ops.')
ACT(s:42, 'Duplicada')
ACT(s:43, 'Op.Anterior')
ACT(s:44, 'Incompleto')
ACT(s:45, 'FechaVto')
ACT(s:46, 'Moneda de Liquidacion')
ACT(s:47, 'Responsable')
ACT(s:48, 'FechaEnvioMAE(txt)')
ACT(s:49, 'FechaEnvioMAE')
ACT(s:50, 'NrOrden')
ACT(s:51, 'z:1')
ACT(s:52, 'Mercado2')
ACT(s:53, 'Agente Contra')
ACT(s:58, 'ZeroCoupon')
* FJL 15/07/19 - Por Issue 3799 - Especies Sancionadas
ACT(s:59, 'EstadoOperativo')
ACT(s:60, 'A Compliance SE')
* FJL 24/11/20 - Por Comitente terceros
ACT(s:61, 'Comitente(C/V)')
ACT(s:62, 'Largo')
ACT(s:63, 'Tipo')
ACT(s:64, 'Codigo')
ACT(s:65, 'Cliente')
ACT(s:66, 'CatDepos')
ACT(s:67, 'VarLiqCli')
ACT(s:68, 'MerLiqCli')
ACT(s:70, 'AfectaLS')

if Dialogo.Check1=0
  recorrer&i 1,70
    ACT(bz:&i, Val(s:&i))
  proximo
endif

SQL.ADD("Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoRegistro in ('0105','0205')  ")
SQL.ADD("    and CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGTIT'))~")  ")
SQL.ADD("    and CodigoRueda Not in ("~Pipe2Comillas(Var('RUELICI'))~") ")
SQL.ADD("    and CodigoRueda Not in ("~Pipe2Comillas(Var('RUECORR'))~") ")
* FJL 10/02/22 - Como se incorpora el TipoNeg C a la variable se descartan tambien los registros de CPC1 que toma en GENORD
SQL.ADD("    and CodigoRueda Not in ("~Pipe2Comillas(Var('RUECPC1'))~") ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                      ")
SQL.ADD("    and Carga       is null                                    ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                            ")
*SQL.ADD("    and Secuencia2 in ('23082210041100005','23082210041500006','23082210042100007','23082210042500008')  ")
SQL.ADD("  order by Secuencia2 ")
watch(SQL.BATCH())
Recorrer SQL
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..t:70)
  BorrarCeldas(e:1..f:10)
  BorrarCeldas(es:1..es:2)
  BorrarCeldas(cl:1)
  if SI
    ***** Secuencia2
    ACT(t:1, fbn('Secuencia2'))
    ***** TipoOp
*    if EqStr(fbn('CodigoNego'),'1')
    if Incluido(fbn('CodigoNego'),'1|C')
      ACT(x:1, 'S')
    else
      ACT(x:1, 'F')
    endif
    if EqStr(fbn('Agente'),Val(v:5))
*      if EqStr(fbn('CodigoNego'),'1')
      if Incluido(fbn('CodigoNego'),'1|C')
        ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
        ACT(t:2,'TIV')
      else
        ACT(t:2,'TIFV')
      endif
      ACT(t:5, fbn('AgenteContra'))
    else
      if EqStr(fbn('AgenteContra'),Val(v:5))
*        if EqStr(fbn('CodigoNego'),'1')
        if Incluido(fbn('CodigoNego'),'1|C')
          ACT(t:50,Copy(fbn('NroOrdenComprador'),7,5))
          ACT(t:2,'TIC')
        else
          ACT(t:2,'TIFC')
        endif
        ACT(t:5, fbn('Agente'))
      else
        SCN(z:1,1)
        ACN((26+FAC):2, 1)
      endif
    endif
    ***** Especie
    ACT(t:27, fbn('CodigoTitulo'))
    ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    if Vacio(Val(t:3))
*      SCN(z:1,1)
** AA Verificar t:44 se utiliza en otros lugares del evento
      ACN(t:44, 1)
      ACN(es:1, 1)
      ACN((26+FAC):3, 1)
** FJL 18/11/20 - Se pasa a un evento para poder ponerle logica y que lo usen el resto de GENxxx
** AA - 09/02/18  
** Insertando Nuevo codigo en Especies - Deshabilitada
*        ACT(pp:4, GenerarJerarquiaPorReferencia('ESPECIES',Var('JERAUTOMA'),si))
*        SQL.ADD("Insert into "~DBO~".ESPECIES (")
*        SQL.ADD("Jerarquia, ")
*        SQL.ADD("Codigo, ")
*        SQL.ADD("CodMAEContado, ")
*        SQL.ADD("Nombre, ")
*        SQL.ADD("Extendido, ")        
*        SQL.ADD("Status, ")
** FJL 15/07/19 - Por Issue 3799 - Especies Sancionadas
*        SQL.ADD("EstadoOperativo ")
*        
*        SQL.ADD(") values (")
*
*        SQL.ADD(" '"~Val(pp:4) ~"', ")           
*        SQL.ADD(" '"~fbn('CodigoTitulo')~"', ")
*        SQL.ADD(" '"~fbn('CodigoTitulo')~"', ")
*        SQL.ADD(" '"~Copy(fbn('Mnemotecnico'),1,15)~"', ")
*        SQL.ADD(" '"~fbn('Mnemotecnico')~"', ")
*        SQL.ADD(" 'DES', ")        
** FJL 15/07/19 - Por Issue 3799 - Especies Sancionadas
*        SQL.ADD(" 'NE' ")        
*        SQL.ADD(")")
*        SQL.NEW
**       AA - La especie se graba en Operaciones        
*        ACT(t:3, fbn('CodigoTitulo'))
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
*      EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
      EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Entero1=Num(fbn('Nrocupon')),Check1=Dialogo.Check1)
      ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    else
      ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
      if Eqstr(Val(es:2),'DES')
        ACN(es:1,1)
      Endif
    endif
    ***** Cupon MAE
    ACT(t:4, fbn('Nrocupon'))
    if EqStr(fbn('CodigoRueda'),'MAE1')
      ACN(t:34, 1)
    endif
    ***** Cliente
    ACN(t:6, Num(Val(t:5)))
    ***** Cliente Tabla
    ACT(t:7, fbn('Cliente'))
    if EqStr(Val(t:5),'000') o EqStr(Val(t:5),Val(v:5))
      * Agente=0  o Agente=Vehiculo
** FJL 25/11/20 - Buscar codigo de tercero usando Comitente
      if NoVacio(fbn('ComitenteComprador'))
        ACT(t:61, fbn('ComitenteComprador'))
      else
        ACT(t:61, fbn('ComitenteVendedor'))
      endif
      ACN(t:62, Longitud(Val(t:61)))
      if Val(t:62)>1
        ACT(t:63, Copy(Val(t:61),1,2))
        if EqStr(Val(t:63),'*C')
          * es CUIT
          if Val(t:62)>2
            if Val(t:62)>13
              ACT(t:64, Copy(Val(t:61),3,11))
            else
              ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
            endif
            ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CUIT = '"~Val(t:64)~"' "))
          endif
        endif
        if Incluido(Val(t:63),'*F|*S')
          * es Fondo o Seguros
          * FJL 23/08/21 - Issue 5092 - Cambio criterio FCI
*          ACT(t:64, Copy(Val(t:61),2,Val(t:62)-1))
*          if EqStr(Val(t:63),'*F')
*            ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='FON' "))
*          endif
*          if EqStr(Val(t:63),'*S')
*            ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='CSE' "))
*          endif
          ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
          if EqStr(Val(t:63),'*F')
            ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='FON' "))
          endif
          if EqStr(Val(t:63),'*S')
            ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='CSE' "))
          endif
        endif
        if NoVacio(Val(t:65))
          ACT(t:8, Val(t:65))
        endif
      endif  
      if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
        * Agente=0  y FCI/AFJP
        ACN((26+FAC):8, 2)
      else
        if Val(t:34)=1
          * MAE1
          ACN((26+FAC):8, 3)
        else
** FJL 25/11/20 - Quito que se cancele por esta condicion
*          SCN(z:1,1)
          ACN((26+FAC):8, 1)
        endif
      endif
    else
      ***** Codigo MAE Cliente
      ACT(t:53, Val(t:5))
      ***** Codigo Cliente
      ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
      ***** Operador Contra
      ACT(t:9, fbn('OperadorContra'))
      if Vacio(Val(t:8))
        ACN(cl:1,1)
        ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
      endif
    endif

    ***** Mercado4
    ACT(t:31, Var('AMBMAE'))
    ***** Cantidad
    ACN(t:11, fbn('Cantidad'))
    if Val(t:11)=0
      SCN(z:1,1)
      ACN((26+FAC):11, 1)
    endif
    ***** ContraEspecie
    if EqStr(fbn('Moneda'),'D')
      ACT(t:12, 'USD')
* FJL 20/04/23 - Para nuevo mercado CABLE
*        ACT(t:52, 'SWIFT')
      * Varable para Mercado Liquidacion de monedas cuando es cliente
      ACT(t:67, 'MERLUSDCLI')
    else
      if EqStr(fbn('Moneda'),'$')
        ACT(t:12, 'ARP')
* FJL 20/04/23 - Para nuevo mercado CABLE
*        ACT(t:52, 'BCRA')
        * Varable para Mercado Liquidacion de monedas cuando es cliente
        ACT(t:67, 'MERLARPCLI')
      else
*        SCN(z:1,1)
        ACN(t:44, 1)
        ACN((26+FAC):12, 1)
      endif
    endif

* FJL 20/04/23 - Para nuevo mercado CABLE
    ACT(t:52, MercadoDef(Val(t:12)))
    if NoVacio(t:8)
      ACT(t:66, BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)))
    endif
    if Incluido(Val(t:66),Var('CATEGCLIE'))
      * Es cliente entonces usa el meracdo de la variable
      ACT(t:68, BuscarCampo('VARIABLES','Valor','Codigo',Val(t:67)))
      if NoVacio(t:68)
        ACT(t:52, Val(t:68))
      endif
    endif
    

    ***** PrecioMAE
    ACN(t:13, fbn('Precio'))
    ***** Precio3 / Precio4 / Precio1
    if Eqstr(Val(t:10),'CLE')
      ACN(t:14, Val(t:13))
    else
      ACN(t:15, Val(t:13))
    endif
    ***** InteresesMAE
    ACN(t:16, fbn('Interes'))
** FJL 29-03-19 - Por cupon 0/1 para especies ZeroCoupon
*    ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    ***** Es ZeroCupon
    ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
    ***** Nro Cupon
    if EqStr(Val(t:58),'SI')    
      ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    else
      ACT(t:17, Val(t:4))
    endif
    if Vacio(Val(t:17))
      ACT(t:17, '0')
    endif
* FJL 15/07/19 - Por Issue 3799 - Especies Sancionadas
    ***** EstadoOperativo
    ACT(t:59, BuscarCampo('ESPECIES','EstadoOperativo','Codigo',Val(t:3)))
    if Vacio(Val(t:59))
      ACT(t:59, 'NE')
    endif
    ***** A Compliance SE
    ACT(t:60, 'NO')
    if EqStr(Val(w:2),'SI')
      if Incluido(Val(t:59),'SI|NE')
       ACT(t:60, 'SI')
      endif
    endif
    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05')
      ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACD(t:19, Fecha(Val(t:18)))
    else
      SCN(z:1,1)
      ACN((26+FAC):19, 1)
    endif
    
    ***** Mercado
    if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
      ACT(t:22, 'AC')
      ACT(t:52, 'AC')
    else
      if EqStr(fbn('EnteLiquidador'),'2')
        ACT(t:22, 'CRYL')
** FJL 08/11/21 - Se cambia a CRYL cuando llega del MAE
*        ACT(t:52, 'BCRA')
** FJL 29/06/22 - Se vuelve a BCRA
*        ACT(t:52, 'CRYL')
        ACT(t:52, 'BCRA')
      else
        if EqStr(fbn('EnteLiquidador'),'3')
          ACT(t:22, 'CE')
          ACT(t:52, 'CE')
        else
          if EqStr(fbn('EnteLiquidador'),'4')
            ACT(t:22, 'EU')
            ACT(t:52, 'EU')
          else
            if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
              ACT(t:22, 'CV')
            else
** FJL 4/10/24 - Por nuevo EnteLiquidador - Issue EXTBOFA-7655 - Se Agrega la C
              if Incluido(fbn('EnteLiquidador'),'G|F|U|C')
              ACT(t:22, VAR('ENTELIQA3')) 
              *Para garantizado en dolares el mercado puede ser variable.
                if  EqStri(fbn('EnteLiquidador'),'G') y EqStri(fbn('Moneda'),'D')
                    ACT(t:52, VAR('ENTELIQGD'))
                else 
                    ACT(t:52, VAR('ENTELIQA3'))
                endif
             else
                  if Incluido(fbn('EnteLiquidador'),'W')
                    ACT(t:22, VAR('ENTELIQA3'))
                    ACT(t:52, VAR('MERMCMEP'))
                  else
    *                SCN(z:1,1)
                    ACN(t:44, 1)
                    ACN((26+FAC):22, 1)
                  endif
              endif
            endif
          endif
        endif
      endif
    endif

** FJL 17/08/23 - Por Issue 6614 BACS
    if EqStr(VAR('MERESBCRA'),'SI')
      * SI la variable esta en SI usa el criterio definido por BACS
      if EqStr(Val(t:8),VAR('CLIBCRA'))
        if Incluido(fbn('CodigoRueda'),VAR('MERESBCRAR')) o Vacio(VAR('MERESBCRAR'))
          ACT(t:22, VAR('MERESBCRAM'))
          if Vacio(Val(t:22))
            ACT(t:22, 'CRYL')
          endif
          ACT(t:52, 'BCRA')
          ACT(t:24, 'ARG')
        endif
      endif
    endif

    ***** FormaLiquidacion
** FJL 02/07/22 - Contemplar distintos tipos de acuerdo al mercado
*    if EqStr(fbn('TipoLiquidacion'),'2')
*      ACN(t:23, 0)
*    else
*      if EqStr(fbn('TipoLiquidacion'),'1')
*        ACN(t:23, 1)
*      else
*        if EqStr(fbn('TipoLiquidacion'),'6')
*          ACN(t:23, 2)
*        else
**          SCN(z:1,1)
*          ACN(t:44, 1)
*          ACN((26+FAC):23, 1)
*        endif
*      endif
*    endif
    if Incluido(Val(t:22),VAR('MERCADOCV'))
      if Incluido(fbn('TipoLiquidacion'),'2|4')
        ACN(t:23, 0)
      else
        if EqStr(fbn('TipoLiquidacion'),'1')
          ACN(t:23, 1)
        else
          if EqStr(fbn('TipoLiquidacion'),'6')
            ACN(t:23, 2)
          else
            ACN(t:44, 1)
            ACN((26+FAC):23, 1)
          endif
        endif
      endif
    else
      if Incluido(Val(t:22),VAR('MERCAVARI'))
        if EqStr(fbn('TipoLiquidacion'),'5')
          ACN(t:23, 0)
        else
          if EqStr(fbn('TipoLiquidacion'),'1')
            ACN(t:23, 1)
          else
            if EqStr(fbn('TipoLiquidacion'),'2')
              ACN(t:23, 2)
            else
              ACN(t:44, 1)
              ACN((26+FAC):23, 1)
            endif
          endif
        endif
      else
*        SCN(z:1,1)
        ACN(t:44, 1)
        ACN((26+FAC):23, 1)
      endif
    endif
    IF Incluido(Val(T:22), VAR('MERCAACMC'))
      ACN(T:23, 1)
    ENDIF
    ***** Operador / OperadorContra
    if Incluido(Val(t:2),'TIV')
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
      ACT(t:26, fbn('OperadorContra'))
    else
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
      ACT(t:26, fbn('Operador'))
    endif
    if Vacio(Val(t:25))
      ACT(t:25, UsuarioActivo)
    endif
    ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

    ***** Vehiculo1
    ACT(t:29, Var('VEHICULODE'))

    ***** Cuenta1
*    ACT(t:28, '')

    *** ContraEspecie2 Moneda de Liquidacion ****
    ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
    if EqStr(Val(t:12),'USD')
      if Incluido(Val(t:22),VAR('MERCAACMC'))
        ACT(t:46, 'USD')
        if EqStr(fbn('EnteLiquidador'),'B')
          ACT(t:46, 'USB')
        endif
      endif
      if EqStr(Val(t:22),'CRYL')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'CV')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'EU')
         if EqStr(fbn('TipoOpDestino'),'5') 
            * PZ 20/07/2020 por adaptación EU
            * o EqStr(BuscarCampo('CUENTAS','Global','Codigo',Val(t:28)),'S')
            ACT(t:46, 'USD')
         else
            * PZ 20/07/2020 por adaptación EU
            * ACT(t:46, 'USB')
            ACT(t:46, 'USD')
         endif
      endif
    endif

    ***** Tabla Feriados
    if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9|U')
      ACT(t:24, 'USA')
    endif
    if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
      ACT(t:24, 'ARG')
    endif
    if Incluido(Val(t:22),VAR('MERCAACMC'))
      ACT(t:24, 'ARG')
      if Incluido(Val(t:46),'ARP|USB')
        ACT(t:24, 'ARG')
      endif
      if EqStr(Val(t:46),'USD')
        ACT(t:24, 'USA')
      endif
    endif
    if Vacio(Val(t:24))
*      SCN(z:1,1)
      ACN(t:44, 1)
      ACN((26+FAC):24, 1)
    endif

*    if EqStr(fbn('CodigoNego'),'1')
    if Incluido(fbn('CodigoNego'),'1|C')
      * Es Spot
      ***** Plazo
      ACN(t:21, Num(fbn('Plazo'))*24)
      ***** RB5
      if Num(fbn('Plazo'))<=3
        ACT(t:20, FStr(fbn('Plazo'),1,0))
      else
        SCN(z:1,1)
        ACN((26+FAC):20, 1)
      endif
      ***** FechaVto
      ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))
    else
      * Es Futuro
      ***** PlazoGracia
      ACN(t:21, Num(fbn('Plazo')))
      ***** FechaVto
      ACD(t:45, Val(t:19)+Val(t:21))
    endif

    ***** UDN1
    ACT(t:30, 'MD')
    ***** Rueda (UDN2)
    ACT(t:32, fbn('CodigoRueda'))
    ***** PaseCB
    ACT(t:33, '0')
    ***** MAE1
    if Val(t:34)=1
      ***** Datos MAE1
      ACT(t:36, fbn('Referencia'))
      ACN(t:37, Num(Val(t:36)))
      if Val(t:37)=0
        ACN(t:35, 0)
        ACN(t:38, 1)
      else
        if EqStr(fbn('TipoOpOrigen'),'1')
          ** Terceros
          ACN(t:35, 0)
        else
          ACN(t:35, 1)
        endif
      endif

      if EqStr(fbn('TipoOpDestino'),'5')
        * Agente
        ACN(t:39, 0)
      else
        if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
          if EqStr(fbn('TipoOpDestino'),'2')
            * FCI
            ACN(t:39, 1)
          endif
          if EqStr(fbn('TipoOpDestino'),'4')
            * AFJP Fondo
            ACN(t:39, 2)
          endif
          if EqStr(fbn('TipoOpDestino'),'6')
            * AFJP Encaje
            ACN(t:39, 3)
          endif
          if EqStr(fbn('TipoOpDestino'),'7')
            * AFJP Adminis (Cartera Propia)
            ACN(t:39, 4)
          endif
        endif
      endif
    endif

    if DesciendeDeEspecie(Val(t:3),'LETES')
      *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
      ACN(x:2, 1)
    else
      ACN(x:2, 0)
    endif 

    if Vacio(Val(t:8)) y Val(t:34)=1
      * Vacio Cliente y MAE1
      ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
    else
      ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:8)~"' and CB5='1' "))
    endif
    if Val(t:41) = 1
      ACN(t:42, 1)
      if Vacio(Val(t:8)) y Val(t:34)=1
        * Vacio Cliente y MAE1
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
      else
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:8)~"' and CB5='1' "))
      endif
      SCN(z:1,1)
      ACN((26+FAC):41, 1)

      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = 'DUPLIC' ")
        SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    endif
    if Vacio(Val(t:8))
      * Vacio Cliente
      if Val(t:34)=0
        * NO MAE1
        ACN(t:44, 1)
      endif
      ACT(t:8, 'SIOPEL')
      ACN((26+FAC):8, 1)
    endif
    ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
    ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))

    if Val(z:1)=0
      * No tuvo errores
      ACT(b:FAC, 'OK')
      if Dialogo.Check1=1

        ACT(w:6, GetNumerador(1))
        ACT(c:FAC, Val(w:6))
        ACT(t:70,BuscarCampo('CANALES','AfectaPorDefecto','Codigo','MERCADO'))
        Message('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:8))
        SQL.ADD("Insert into "~DBO~".OPERACIONES (")
          
        SQL.ADD("NrOperacion, ")
        SQL.ADD("TipoOp, ")
        SQL.ADD("TipoTicket, ")
        SQL.ADD("Especie, ")
        SQL.ADD("Cliente1, ")
          
        SQL.ADD("Cantidad, ")
        SQL.ADD("ContraEspecie, ")
        SQL.ADD("Precio1, ")
          
** FJL 29-03-19 - Se saca por cupon 0/1, ahora simpre ponemos cupon
*        if Val(x:2) <> 1
*          * No es LETES
*          SQL.ADD("Cupon1,")
*        endif
        SQL.ADD("Cupon1,")
        SQL.ADD("FechaOp, ")
          
        if EqStr(Val(x:1),'S')
          * Spot        
          SQL.ADD("Plazo, ")
          SQL.ADD("RB5, ")
        else
          * Futuro
          SQL.ADD("PlazoGracia, ")
        endif
        SQL.ADD("RB6, ")
        SQL.ADD("FechaVto, ")
        SQL.ADD("Mercado, ")
        SQL.ADD("Mercado2, ")

        * PZ 20/07/2020 por adaptación EU
** FJL 04/10/2021 se cambia la condicion
*        if Eqstr(val(t:22),'EU')
** FJL 02/07/22 - Grabar las dos formas de liquidacion
*        IF Incluido(Val(t:22), VAR('MERCAVARI'))
*          SQL.ADD("FormaLiquidacion2, ")
*        else
*          SQL.ADD("FormaLiquidacion1, ")
*        endif
        SQL.ADD("FormaLiquidacion1, ")
        SQL.ADD("FormaLiquidacion2, ")
        SQL.ADD("TablaFeriados1, ")
        SQL.ADD("Operador, ")
        SQL.ADD("OpSIOPEL, ")
          
        SQL.ADD("EnteCus1, ")
        SQL.ADD("EnteCus2, ")
        SQL.ADD("Vehiculo1, ")
        SQL.ADD("Mercado4, ")
          
        SQL.ADD("CB5, ")
