        SQL.ADD(") values (")
          
        * NrOperacion
        SQL.ADD(" '"~Val(w:6)~"', ")
        * TipoOp
        SQL.ADD(" '"~Val(t:2)~"', ")
        * TipoTicket (Boden 2008)
        SQL.ADD(" '0', ")
        * Especie
