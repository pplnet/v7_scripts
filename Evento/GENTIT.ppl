        SQL.ADD("   Set Procesado   = '1',")
        SQL.ADD("       Carga       = '1', ")
        SQL.ADD("       NrOperacion = '"~Val(w:6)~"' ")
        SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
        SQL.NEW
        SQL.EXEC

        Message('Modificar Operacion '~Val(w:6))
        ModificarOperacion(Val(w:6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
** AA 12/02/2018 Se genera instancia con variables por error Especie/Cliente
IF NO
        IF Not Ok
** MessageBox('Error en operacion '~Val(w:6)~' Pasa a Carga Trader')
           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Values ('"~Val(w:6)~"',4,'1')  ")
           SQL.NEW
           SQL.ADD("insert "~DBO~".OPERACIONESBITS  ")
           SQL.ADD("Values ('"~Val(w:6)~"',1,'0')  ")
           SQL.NEW
           SQL.ADD("Update "~DBO~".OPERACIONES  ")
           SQL.ADD("   Set Direccion = 2,  ")
           SQL.ADD("       EsCaucionado='1'  ")
           SQL.ADD(" where NrOperacion = '"~Val(w:6)~"' ")
           SQL.NEW
        Else
** MessageBox('Operacion '~Val(w:6)~' Ok. Pasa a Instancia 5')
           ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
           SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w:6)~"' ")
           SQL.NEW
        Endif
        SQL.EXEC
Endif

        IF Ok
           ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
           SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w:6)~"' ")
