          SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
          * RB5 (N)
          SQL.ADD(" '"~Val(t:20)~"', ")
        else
          * Futuro        
          * PlazoGracia (N)
           SQL.ADD(" "~FStr(Val(t:21),1,0)~" , ")
        endif
        * RB6 (N) Fuente=0=Siopel
        SQL.ADD(" '0', ")
