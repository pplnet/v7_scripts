else
Acn(ai:fac, CotizacionC(Fbn('Especie'), 'FUT', Fbn('FechaVto'), null, Val(v:2), 1, SI, Fbn('ContraEspecie')))
Acn(aj:fac, Val(ag:fac) * (Val(ai:fac) - Val(ah:fac)))
