Acn(x1, sql("Select 1 from "~Dbo()~".VARIABLES where Codigo = 'DIASCONT' "))
if (Val(x1) = 1)
Acn(x1, Trunc(Var('DIASCONT'), 0))
endif
if (Val(x1) < 1)
Acn(x1, 1)
endif
Acd(x2, Habiles(PriDeMes(dialogo.fecha1, SI) - 1, Val(x1), 'ARG'))
Acd(x3, Habiles(Val(x2), 1, 'ARG'))

Acd(v:1, dialogo.fecha1)
Acd(v:2, Habiles(PriDeMes(dialogo.fecha1), -1, 'ARG'))
Acd(v:3, Habiles(Val(v:2), 1, 'ARG'))

Message('--- Asientos de tenencia FX FWD ---')

sql.add(" SELECT O.NrOperacion,  O.Especie, O.ContraEspecie, ")
sql.add("        O.FechaOp, O.FechaVto, O.Cliente1, ")
sql.add("        O.Vehiculo1, ")
sql.add("        O.TipoOp, O.Cantidad, O.Precio1, ")
sql.add("        C.CUIT, V.Valor1, V.Valor2, ")
sql.add("        M.Codigo CodAsi, E.Tipo, E.Cotiza, O.ContraEspecie Moneda, 'Vto' TipoRes, O.Plazo, ")
sql.add("        Case O.CB9 When 1 Then 'NDF' Else 'NONDF' END TipoFut, O.Observaciones, O.MB4, O.CB6, O.Precio2, E.Alias8 ")
sql.add(" FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".VEHICULOS V, ")
sql.add("      "~Dbo()~".MODELOSASIENTO M, "~Dbo()~".ESPECIES E ")
sql.add(" WHERE O.Cliente1    = C.Codigo ")
sql.add(" AND   O.Vehiculo1   = V.Codigo ")
sql.add(" AND   O.Especie     = E.Codigo ")
sql.add(" AND   O.FechaVto    = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND   O.TipoOp      IN ('FXCT','FXVT','FXAT') ")
sql.add(" AND   O.Vehiculo1  Not IN ("~pipe2comillas(Var('VLIQUIDAA'))~") ")
sql.add(" and   M.TipoAsiento IN ("~pipe2comillas(Var('TIPASITEFW'))~") ")
sql.add(" AND M.Habilitado = 'SI' ")
sql.add(" AND M.Entorno = '"~sigla~"' ")
if (NoVacio(dialogo.listatabla1))
sql.add(" AND O.NrOperacion IN ("~pipe2comillas(dialogo.listatabla1)~") ")
endif

if (NoVacio(dialogo.lista1))
sql.add(" AND O.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
sql.add(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
sql.add(" OR ")
endif
proximo
sql.add(") OR M.Vehiculo is null OR M.Vehiculo = '' OR M.Vehiculo = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
sql.add(" ORDER BY O.NrOperacion ")
recorrer sql
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(dialogo.fecha1)~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acd(d:fac, Fbn('FechaVto'))
Act(e:fac, Fbn('Especie'))
Act(f:fac, Fbn('ContraEspecie'))
Acn(g:fac, Fbn('Cantidad'))
Acn(h:fac, Fbn('Precio1'))
if (Incluido(Fbn('TipoOp'), 'FXAT'))
if (Fbn('CB6') = 1)
Acn(i:fac, Fbn('Precio2'))
Acn(j:fac, Val(g:fac) * (Val(i:fac) - Val(h:fac)))
else
Acn(i:fac, Fbn('Precio2'))
Acn(j:fac, ((Val(i:fac) ^ (-1)) - (Fbn('Precio1') ^ (-1))) * Fbn('Cantidad') * (-1))
Acn(j:fac, Val(j:fac) * (-1))
endif
else
Acn(i:fac, Fbn('Precio2'))
Acn(j:fac, Val(g:fac) * (Val(i:fac) - Val(h:fac)))
if (Incluido(Fbn('TipoOp'), 'FXCT'))
Acn(j:fac, Val(j:fac) * (-1))
endif
endif
Acn(z1, Val(j:fac))
Acd(fv:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Acn(v1, 0)
sql.add("Select FechaInicio, FechaFin    from "~Dbo()~".PERIODOSCONTABLES where ")
sql.add("    Vehiculo = '"~Val(vh:1)~"' ")
recorrer sql
if (Fbn()['FechaInicio'] <= Val(fv:1))
else
Acd(fv:1, Fbn()['FechaInicio'])
endif
proximo


Acn(rs:1, Val(j:fac))
let(&modelocontable, Fbn('CodAsi'))
sql.generarasientoop(&modelocontable, Fbn('NrOperacion'), '', '', 810, Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
sql.exec
endif
proximo

