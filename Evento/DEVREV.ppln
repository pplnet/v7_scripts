Sqladd(" Select  Sum(M.Monto) TotOperac, M.EspecieRef, M.TipoDevengado, M.Cliente, ")
Sqladd("         M.NrSaldo, M.Especie, M.FechaEj, M.Book, M.Cupon  ")
Sqladd(" FROM "~Dbo()~".MOVDEVENGADOS M, "~Dbo()~".OPERACIONES O ")
Sqladd(" Where  Fecha < "~IdxDate2(dialogo.fecha1))
Sqladd(" and    M.TipoDevengado Not in ('MTM')     ")
Sqladd(" and    O.NrOperacion = M.NrOperacion      ")
Sqladd(" and    M.Especie <> '"~Var('MONELOCA')~"' ")
Sqladd(" and    M.TipoDevengado not in ('INTFON','FONDEO')   ")
if (NO)
Sqladd(" and    (M.TipoDevengado not in ('INTFON','FONDEO')   ")
Sqladd("               or O.TipoOp in ('IMMPF')                ")
Sqladd("               or substring(O.OperacionRef,1,1) = 'M' ")
Sqladd("               or O.CB10 = '0' ) ")
endif
Sqladd(" and exists(Select 1 From "~Dbo()~".OPERACIONES  ")
Sqladd("             Where NrOperacion = M.NrOperacion ")
Sqladd("             and   (FechaVto>="~IdxDate2(dialogo.fecha1)~"  ")
Sqladd("                      or (RB3='1' and FechaVto2>="~IdxDate2(dialogo.fecha1)~" ")
Sqladd("                                  and TipoOp in ('TICO','TICT','TIDE','TIPO','ISL'))")
Sqladd("                    )")
Sqladd("            )")
Sqladd(" AND (O.FechaVto > "~IdxDate2(dialogo.fecha1)~" OR O.TipoOp NOT IN ('TICO','TIPO','TIDE','TICT') ) ")

Sqladd(" group by M.TipoDevengado, M.Cliente, M.NrSaldo, M.Book, ")
Sqladd("          M.Especie, M.Cupon, M.FechaEj, M.EspecieRef    ")
Sqladd(" order by M.Especie, M.Cupon, M.Book ")
recorrer sql
