Sqladd("Select D.PrecioDevARP  FROM "~Dbo()~".DEVENGADOS D ")
Sqladd("Where D.Fecha < "~IdxDate2(dialogo.fecha1))
Sqladd("  and D.TipoDevengado = '"~Fbn()['TipoDevengado']~"' ")
Sqladd("  and D.NrSaldo       = "~FStr(Fbn()['NrSaldo'], 3, 0)~" ")
Sqladd("  and D.Especie       = '"~Fbn()['Especie']~"'  ")
Sqladd("  and D.Book          = '"~Fbn()['Book']~"' ")
Sqladd("  and D.FechaEj       = "~IdxDate2(Fbn()['FechaEj'])~" ")
Sqladd("  and D.EspecieRef    = '"~Fbn()['EspecieRef']~"' ")
Sqladd("  and D.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".DEVENGADOS ")
Sqladd("                  Where Fecha < "~IdxDate2(dialogo.fecha1))
Sqladd("                    and D.TipoDevengado = TipoDevengado ")
Sqladd("                    and D.NrSaldo       = NrSaldo ")
Sqladd("                    and D.Especie       = Especie ")
Sqladd("                    and D.Book          = Book    ")
Sqladd("                    and (FechaEj = D.FechaEj OR (FechaEj IS NULL AND D.FechaEj IS NULL )) ")
Sqladd("                    and D.EspecieRef    = EspecieRef ) ")
recorrer sql
Dfa()
