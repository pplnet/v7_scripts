CrearDialogo
    TipoOp:       'TipoOp'            ;;;;;;;;;;;;;;;;;;
    Especie1:      'Moneda'           ;;;;;;;;;;;;;;;;;;
    Cantidad1:    'Importe'           ;;;;;;;;;;;;;;;;;;
    Book1:        'Book'              ;;;;;;;;;;;;;;;;;;
    NrOperacion:  'NrOperacion'       ;;;;;;;;;;;;;;;;;;
    Fecha1:       'FechaOp'           ;;;;;;;;;;;;;;;;;;
FinDialogo

If Not Ok
    Cancelar
Endif

If Incluido(Dialogo.TipoOp,VAR('TIPOOPRBA'))
    let &riesgo 'BA'
else
    let &restricciones BuscarCampo('BOOKS','Alias2','Codigo',Dialogo.Book1)
    if EqStr(Dialogo.Especie1,VAR('MONELOCA'))
        let &importe Dialogo.Cantidad1
    else
        let &importe CotizacionBNA(Dialogo.Especie1,Dialogo.Fecha1,1,NO,NO)*Dialogo.Cantidad1
    Endif

    let &modulos VAR('VALMODARP')*VAR('LIMMODRIE')
    If &restricciones > 0 o &importe<&modulos
        let &riesgo 'MB'
    else
        let &riesgo 'MD'
    endif
Endif

SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Riesgo = '"~&riesgo~"' Where NrOperacion = '"~Dialogo.NrOperacion~"'")
SQL.NEW
SQL.EXEC