Sqladd("SELECT ORD.NrOrden, B1.NrBit NrBitOrd, OP.NrOperacion, B2.NrBit NrBitOp ")
Sqladd("  FROM "~Dbo()~".ORDENES ORD, "~Dbo()~".OPERACIONESBITS B1, "~Dbo()~".OPERACIONES OP, "~Dbo()~".OPERACIONESBITS B2 ")
Sqladd(" WHERE ORD.NrOrden=B1.NrOperacion ")
Sqladd("   AND B1.NrBit in( 9, 11 ) ")
Sqladd("   AND B1.Valor=1 ")
Sqladd("   AND ORD.NrOrden=OP.NrOrden1 ")
Sqladd("   AND OP.NrOperacion=B2.NrOperacion ")
Sqladd("   AND B2.NrBit in( 7, 10 ) ")
Sqladd("   AND B2.Valor=1 ")
Sqladd("   AND ORD.FechaOrden="~IdxDate2(dialogo.fecha1))
Sqladd("   AND Not Exists (SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS M WHERE M.NrOperacion=OP.NrOperacion ) ")
Sqladd("   AND IsNull(ORD.CB7,0)=0 ")
Sqladd("   AND IsNull(OP.CB4,0)=1 ")


if (NoVacio(dialogo.mercado1))
Sqladd("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif

if (dialogo.radio1 = 0)
Sqladd("AND ORD.Lotes=0 ")
else
Sqladd("AND ORD.Lotes<>0 ")
endif

recorrer sql


Ejecutarevento('CBOINS', 'string1', Fbn()['NrOperacion'], 'radio1', 1, 'radio2', 0, 'entero1', Fbn()['NrBitOp'], 'entero2', 13)

