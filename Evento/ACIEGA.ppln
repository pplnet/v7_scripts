Sqladd("SELECT ORD.NrOrden, B.NrBit  ")
Sqladd("  FROM "~Dbo()~".ORDENES ORD, "~Dbo()~".OPERACIONESBITS B ")
Sqladd(" WHERE ORD.NrOrden=B.NrOperacion ")
Sqladd("   AND ORD.FechaOrden="~IdxDate2(dialogo.fecha1))
Sqladd("   AND B.NrBit in( 10 ) ")
Sqladd("   AND B.Valor=1 ")

if (NoVacio(dialogo.mercado1))
Sqladd("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif


if (dialogo.radio1 = 0)
Sqladd("AND ORD.Lotes=0 ")
else
Sqladd("AND ORD.Lotes<>0 ")
endif

recorrer sql


Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 0, 'entero1', 10, 'entero2', 8)

