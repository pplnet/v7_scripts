Sqladd("select DT.Fecha, DT.Especie, Case when DT.TipCupon='' then '0' else DT.TipCupon end TipCupon, /*T.Clasificacion Tipo ,*/ DT.Valorresidual Residual, DT.CuentaContable CuentaContable, DT.ValorContable Contable, ")
Sqladd("DT.ValorContValuado ContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores,FechaInicioTenencia FTenencia, ")
Sqladd("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, extendido, MonedaEmision, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo TipoE, ")
Sqladd("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' Then 'SI' else 'NO' end Accion, ISIN, ISSUER, TasaCER, Indice, Cupon,  ")
Sqladd("ESP.Indexado, DT.Cotizacion, DT.CuentaCustodia, CT.Nombre NombreCta, CT.Mercado, CT.Cliente ClienteCTA ")
Sqladd(" From "~Dbo()~".EFECTIVOMINIMOCRYL DT  ")
Sqladd("      inner  join "~Dbo()~".CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
Sqladd("      inner join "~Dbo()~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
Sqladd("      inner join "~Dbo()~".CUENTAS CT   on DT.CuentaCustodia  = CT.Codigo ")
Sqladd("  and ValorContable <> 0  ")
Sqladd("  and DT.Fecha >= "~IdxDate2(dialogo.fecha1)~"  ")
Sqladd("  and DT.Fecha <= "~IdxDate2(dialogo.fecha2)~"  ")
Sqladd(" Order By Dt.Especie, DT.Fecha")

Watch(Sqlbatch())

