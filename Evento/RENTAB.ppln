Sqladd(" Select Especie,Sum(VRMEDAY+RRMEDAY+CRMEDAY+INMEDAY) as 'Resultado' from "~Dbo()~".RESULTADOS2 Where Fecha ='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Vehiculo='"~&vehiculo~"' AND Book='"~&book~"' and NrSaldo=1 ")
Sqladd(" Group by Especie ")
recorrer sql
let(&espbonind, Fbn('Especie'))
let(&fechabonind1, dialogo.fecha1)
let(&fechabonind2, dialogo.fecha1)
let(&monto, 0)
let(&indiceesp, BuscarCampo('ESPECIES', 'Indice', 'Codigo', &espbonind))
let(&tipoindice, BuscarCampo('ESPECIES', 'TipoIndice', 'Codigo', &indiceesp))
if (NoVacio(&indiceesp) y Eqstr(&tipoindice, 'CAP'))
Sqladd("Select ABS(Cantidad1) as 'Nominales',Cambio3,Precio1,Precio2 from "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Where TipoTr2='CUPON' AND Cantidad4=3 AND Fecha1 >='"~IdxDate(&fechabonind1)~"' AND ")
Sqladd(" Fecha1 <='"~IdxDate(&fechabonind2)~"'AND Vehiculo1='"~&vehiculo~"' ")
Sqladd(" AND Book1='"~&book~"' AND Especie='"~&espbonind~"' ")
recorrer sql
Dfa()
let(&dif, Fbn('Cambio3') - 1)
let(&poramort, Fbn('Precio1') / 100)
let(&porrenta, Fbn('Precio2') / 100)
let(&montoini, Fbn('Nominales') * &dif)
let(&montoamort, &montoini * &poramort)
let(&montorenta, &montoini * &porrenta)
let(&monto, &montoamort + &montorenta)
proximo
