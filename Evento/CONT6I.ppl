MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:   'Fecha'      ;;;;;;;;;Fsys
  Lista1:  'Vehiculos'   ;3;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS"), SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))
  Check1:  'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not OK
   Cancelar
Endif
message('--- Asientos de Corte de Cupon ---')

SQL.ADD(" SELECT Codigo FROM "~DBO~".MODELOSASIENTO MA WHERE TipoAsiento IN ("~Pipe2Comillas(Var('TIPASOCORT'))~") AND Habilitado = 'SI' AND Entorno = '"~SIGLA~"' ")
If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND (( ")
   Recorrer&i 1,Elementos(Dialogo.Lista1)
   SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
   proximo
   SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")    
Endif

Recorrer SQL
  dfa
  ACT(la:1, Val(la:1)~fbn('Codigo')~'|')
Proximo

ACT(US:1, Descendientes('ESPECIES', 'U$S'))
ACD(FE:2, Habiles(PriDeMes(Dialogo.Fecha1,SI), -1, 'ARG'))

SQL.ADD(" SELECT Case T.TipoTr2 When 'CUPON ' Then T.Especie Else T.Especie2 END Especie, ")
SQL.ADD(" T.Fecha1, T.Fecha2, T.Vehiculo1,  T.NrTrans NrOperacion, T.Cantidad1, V.Valor1, V.Valor2, ")
SQL.ADD(" E.Codigo, E.TasaIntVigente, E.TasaIntAnterior, E.InteresesC, E.CuponFeriado, E.Tasa1, ")
SQL.ADD(" E.FechaCambioTasa, E.IntsCapitalizados, E.Cotiza, T.TipoTr2, E.ZeroCoupon, T.Cupon1, T.Precio2 Renta, ")
SQL.ADD(" Case T.TipoTr2 When 'CUPON ' Then Precio1 Else Precio3 END Amort, T.Cuenta2, T.Cantidad5, T.Cantidad6, ")
SQL.ADD(" '' Observaciones, T.Cliente1, T.Cantidad1 Cantidad, T.Cambio3, T.Cambio1 VTAnt, E.Alias8, E.Cotiza Moneda, ")
SQL.ADD(" V.Alias4 MonLocalVeh, E.Issuer Emisor, Cantidad9, E.TipoTasa ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".VEHICULOS V, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE T.Vehiculo1 = V.Codigo ") 
SQL.ADD(" AND   (   (T.Especie  = E.Codigo AND T.TipoTr2 ='CUPON')   ")
SQL.ADD("        OR (T.Especie2 = E.Codigo AND T.TipoTr2<>'CUPON') ) ")
SQL.ADD(" AND   T.TipoTr2   IN ('CUPON','CCUPON','PCUPON') ")
SQL.ADD(" AND   (T.Cantidad4=1 OR T.TipoTr2<>'CUPON') ") 
SQL.ADD(" AND   T.FechaCargaSys = "~Idxdate2(Dialogo.Fecha1)~"   ")
SQL.ADD(" AND   T.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND (T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") OR T.Vehiculo1 is null OR T.Vehiculo1 = '' OR T.Vehiculo1 = ' ' )")  
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD("  ORDER BY NrOperacion ")

Recorrer SQL
    message(fbn('Vehiculo1'))
     *MessageBox('Cont6: corte cupon') 
     *MessageBox(fbn('NrTrans')) 
    ACN(BD:1, 0)
    ACT(EM:1, fbn('Emisor'))
    ACT(TT:1, fbn('TipoTasa'))
    ACT(VH:11, fbn('Vehiculo1'))
    ACT(MN:1, fbn('Moneda'))
    **// Monto Renta PIK
    IF Eqstr(fbn('TipoTr2'), 'CUPON')
       ACN(PK:1, FBN('Cantidad5'))
    Else
       ACN(PK:1, FBN('Cantidad9'))
    Endif
    ***---Insteres Capit. Acumulado
    IF Eqstr(fbn('ZeroCoupon'), 'SI')
        ACN(IC:1, 1)
    ELSE
        ACN(IC:1, SQL(" Select IntsCapitalizados FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~fbn('Especie')~"' AND NrCupon = '"~FSTR(fbn('Cupon1'), 0, 0)~"' "))
        SCN(IC:1, 1)
    ENDIF
    IF Eqstr(fbn('TipoTr2'), 'CUPON')
        ***---Monto Amortizacion
        ACN(MA:1, fbn('Cantidad1') * Val(IC:1) * fbn('Amort') / 100)
        ***---Monto Renta
        ACN(MR:1, fbn('Cantidad1') * Val(IC:1) * fbn('Renta') * fbn('VTAnt') / 100)
        ***---Chequeo si tiene CER
        SQL.ADD(" Select Indice From "~DBO~".ESPECIES ")
        SQL.ADD(" Where Indice Is Not Null ")
        SQL.ADD(" AND Codigo = '"~fbn('Especie')~"' ")
        Recorrer SQL
            DFA
            ACN(BD:1, 1)
        Proximo
        IF Val(BD:1) = 0
            ACN(IN:1, 1)
        ELSE
            ACN(IN:1, fbn('Cambio3'))
        ENDIF
        ACN(MA:1, Val(MA:1) * Val(IN:1))
        ACN(MR:1, Val(MR:1) * Val(IN:1))
        ACN(IC:11, 0)
        ACN(IC:21, 0)
        ACN(IC:31, 0)
        ACN(IC:41, 0)
        ACN(ID:1, 0)
        ACN(ID:2, 0)
        ACN(ID:3, 0)
        ACN(AR:11, 0)
        ACN(AR:21, 0)
        ACN(AR:31, 0)
        ACN(AR:41, 0)
        ACN(YC:11, 0)
        ACN(YC:21, 0)
        ACN(YC:31, 0)
        ACN(YC:41, 0)
        ACN(IA:11, 0)
        ACN(IA:21, 0)
        ACN(IA:31, 0)
        ACN(IA:41, 0)
        ACN(AJ:11, 0)
        ACN(AJ:21, 0)
        ACN(AJ:31, 0)
        ACN(AJ:41, 0)
        IF EsHabil(fbn('Fecha1'), 'ARG')
            ACD(FE:1, fbn('Fecha1'))
        ELSE
            ACD(FE:1, Habiles(fbn('Fecha1'), 1, 'ARG'))
        ENDIF
        IF Not Eqstr(fbn('ZeroCoupon'), 'SI')
            ***---Intereses Cobrados
            ***---Los intereses los calculamos al dia habil anterior si el corte es un finde. No estoy seguro si con la amortizacion pasa lo mismo, asi que eso no lo toco.
            IF EsHabil(fbn('Fecha1'))
                ACD(FE:3, fbn('Fecha1'))
            ELSE
                ACD(FE:3, Habiles(fbn('Fecha1'), -1, 'ARG'))
            ENDIF
            SQL.ADD(" Select YCMEDAY, YCMFDAY, YCMCDAY, YCMLDAY, Vehiculo, Especie ")
            SQL.ADD(" From "~DBO~".RESULTADOS2 ")
            SQL.ADD(" Where (Vehiculo = '"~fbn('Vehiculo1')~"' OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' '  )")
            SQL.ADD(" AND NrSaldo = 2 ")
            SQL.ADD(" AND Especie = '"~fbn('Especie')~"' ")
            SQL.ADD(" AND Fecha = '"~Idxdate(Val(FE:3))~"' ")
            Recorrer SQL
                DFA
                ACN(IC:11, fbn('YCMFDAY'))
                ACN(IC:21, fbn('YCMLDAY'))
                ACN(IC:31, fbn('YCMCDAY'))
                ACN(IC:41, fbn('YCMEDAY'))
                IF NO
                ***--- Se deshabilita Bonos de tasa variable, nunca se probo. Lo estuvo viendo en su momento German Kennel en el 2014 (hace 3 anios. Simax 30576). 
                IF Not Eqstr(Val(TT:1), 'FIJA') Y Not CeldaVacia(TT:1)
                    ***---Bono con Tasa Variable => Debo ajustar la diferencia entre el YNMEMTD contabilizado a fin de mes anterior con tasa vieja, contra el actual con tasa
                    ***---definitiva
                    SQL.ADD(" Select YNMEMTD, YNMFMTD, YNMCMTD, YNMLMTD, Especie, Vehiculo ")
                    SQL.ADD(" From "~DBO~".RESULTADOS2 ")
                    SQL.ADD(" Where (Vehiculo = '"~fbn('Vehiculo')~"' OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' ' ) ")
                    SQL.ADD(" AND NrSaldo = 2 ")
                    SQL.ADD(" AND Especie = '"~fbn('Especie')~"' ")
                    SQL.ADD(" AND Fecha = '"~Idxdate(Val(FE:2))~"' ")
                    Recorrer SQL
                        DFA
                        ***---Interes del mes anterior con tasa definitiva
                        ACN(IA:11, fbn('YNMFMTD'))
                        ACN(IA:21, fbn('YNMLMTD'))
                        ACN(IA:31, fbn('YNMCMTD'))
                        ACN(IA:41, fbn('YNMEMTD'))
                        SQL.ADD(" Select Sum(Cantidad1) Fuerte, Sum(Cantidad2) Local, Sum(Cantidad3) Grupo, Sum(Valor1) Emision, A1.Alias7 Especie, ")
                        SQL.ADD(" A.Vehiculo  ")
                        SQL.ADD(" From "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M ")
                        SQL.ADD(" Where A1.NrUnicoAsiento = A.NrUnicoAsiento ")
                        SQL.ADD(" AND A.Modelo = M.Codigo ")
                        SQL.ADD(" AND (A.Vehiculo = '"~fbn('Vehiculo')~"' OR A.Vehiculo is null OR A.Vehiculo = '' OR A.Vehiculo = ' ' ) ")
                        SQL.ADD(" AND A1.Alias7 = '"~fbn('Especie')~"' ")
                        SQL.ADD(" AND A.FechaValor = '"~IdxDate(Val(FE:2))~"' ")
                        SQL.ADD(" AND M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITESE'))~") ")
                        SQL.ADD(" AND A1.DebitoCredito = 'CRE' ")
                        SQL.ADD(" AND A1.Valor1 > 0 ")
                        SQL.ADD(" AND A1.Alias1 = 'INTERES' ")
                        ***---SQL.ADD(" AND A.Estado = 'E' ")
                        SQL.ADD(" Group By A1.Alias7, A.Vehiculo ")
                        Recorrer SQL
                           ***---Asiento Contabilizado Fin de Mes anterior
                           ACN(YC:11, fbn('Fuerte'))
                           ACN(YC:21, fbn('Local'))
                           ACN(YC:31, fbn('Grupo'))
                           ACN(YC:41, fbn('Emision'))
                           ***---El asiento a fin de mes anterior a su vez estuvo ajustado por los intereses de las operaciones que fueron calculados a otra
                           ***---tasa, asi que le sumo ese ajuste porque sino lo estaria ajustando dos veces.
                           ***---Llamo a la fc de ajuste
                           ACT(K:fac, Val(MN:1))
                           ACD(V:2, Val(FE:2))
                           ACD(V:3, FinDeMes(PriDeMes(Val(V:2),SI)-1, NO))
                           (.'AJINTOPEME'.)
                           SCN(YC:11, Val(DF:1))
                           SCN(YC:21, Val(DF:2))
                           SCN(YC:31, Val(DF:3))
                           SCN(YC:41, Val(DF:4))
                        Proximo
                        ***---Interes a Ajustar = Interes actual menos interes contabilizado anterior
                        ACN(AJ:11, Val(IA:11) - Val(YC:11))
                        ACN(AJ:21, Val(IA:21) - Val(YC:21))
                        ACN(AJ:31, Val(IA:31) - Val(YC:31))
                        ACN(AJ:41, Val(IA:41) - Val(YC:41))
                        SCN(IC:11, Val(AJ:11))
                        SCN(IC:21, Val(AJ:21))
                        SCN(IC:31, Val(AJ:31))
                        SCN(IC:41, Val(AJ:41))
                    Proximo
                ENDIF
                ENDIF
            Proximo
        ENDIF
        IF fbn('Amort') > 0
            ***---Asiento por el resultado realizado al amortizar el precio
            SQL.ADD(" Select AMMEDAY, AMMFDAY, AMMCDAY, AMMLDAY, ARMEDAY, ARMFDAY, ARMCDAY, ARMLDAY ")
            SQL.ADD(" From "~DBO~".RESULTADOS2 ")
            SQL.ADD(" Where (Vehiculo = '"~fbn('Vehiculo1')~"' OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' ' ) ")
            SQL.ADD(" AND NrSaldo = 2 ")
            SQL.ADD(" AND Especie = '"~fbn('Especie')~"' ")
            SQL.ADD(" AND Fecha = '"~Idxdate(Val(FE:1))~"' ")
            Recorrer SQL
                DFA
                ACN(AR:11, fbn('AMMFDAY') + fbn('ARMFDAY'))
                ACN(AR:21, fbn('AMMLDAY') + fbn('ARMLDAY'))
                ACN(AR:31, fbn('AMMCDAY') + fbn('ARMCDAY'))
                ACN(AR:41, fbn('AMMEDAY') + fbn('ARMEDAY'))
            Proximo
        ENDIF
    ELSE
        ***---Monto Amortizacion
        ACN(MA:1, fbn('Cantidad6'))
        ***---Monto Renta
        ACN(MR:1, fbn('Cantidad5'))
    ENDIF
    Recorrer&i 1, Elementos(Val(la:1)) 
        ACD(FV:1, fbn('Fecha1'))
        ACT(VH:1, fbn('Vehiculo1'))
        (.'FECHAVALOR'.)
        ACN(CK:1, 0)
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
           ACN(CK:1, 1)
           IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~fbn('Especie')~"' AND A.Modelo = '"~ItemLista(Val(la:1),&i)~"' AND A.NrTrans2 = '"~fbn('NrOperacion')~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(FV:1))~"' AND A.Vehiculo = '"~fbn('Vehiculo1')~"' "))
              ACN(CK:1, 0)
           ENDIF
        ENDIF
        IF Val(CK:1) = 0
            Message('Modelo: '~ItemLista(Val(la:1),&i))
            let &modeloContable ItemLista(Val(la:1),&i)
            SQL.GenerarAsientoOp(ItemLista(Val(la:1),&i),'','','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,,,fbn('NrOperacion'),,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
    Proximo
Proximo