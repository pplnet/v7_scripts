radio2: "Salida|Impresora|Pantalla|PDF|Mail";5;2;1;;;dialogo.radio2 >= 0;'Tipo de Salida Invalida.';NO;-1;
check1: "Anulados ";4;2;1;;;;;NO;0;
cliente1:"Cliente  ";1;1;;Vacio(dialogo.string1) y Vacio(dialogo.nroperacion1)
fecha1:"F.Dde.   ";2;1;;Vacio(dialogo.string1) y Vacio(dialogo.nroperacion1);;dialogo.fecha1 <> 0;'Debe Ingresar una Fecha';NO;FSys();
fecha2:"F.Hta.   ";3;1;;Vacio(dialogo.string1) y Vacio(dialogo.nroperacion1);;dialogo.fecha2 <> 0;'Debe Ingresar una Fecha';NO;FSys();
