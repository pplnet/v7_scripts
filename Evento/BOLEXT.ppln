Sqladd("SELECT  O.NrOperacion,")
Sqladd("      O.TipoOp, ")
Sqladd("      O.UDN2, ")
Sqladd("      O.CB4, ")
Sqladd("      O.Cliente1, ")
Sqladd("       C.RazonSocial, ")
Sqladd("       C.Direccion, ")
Sqladd("       C.Localidad, ")
Sqladd("       C.CodigoPostal, ")
Sqladd("       C.CUIT, ")
Sqladd("       C.CondicionIVA, ")
Sqladd("       C.TipoInscripcion, ")
Sqladd("       C.Sucursal, ")
Sqladd("       C.Telefono ")

Sqladd("FROM   "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS OB  ")
Sqladd("WHERE  O.Cliente1 = C.Codigo and O.NrOperacion = OB.NrOperacion ")
Sqladd("       and OB.NrBit in (10,70) and Valor = '1' ")
if (NoVacio(dialogo.string1))
Sqladd("    and O.NrBoleto= '"~Pad0(dialogo.string1, 8)~"' ")
else
if (NoVacio(dialogo.nroperacion1))
Sqladd("  and O.NrOperacion= '"~dialogo.nroperacion1~"' ")
else
Sqladd("  and O.FechaOp Between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"'")
if (NoVacio(dialogo.cliente1))
Sqladd("   and O.Cliente1='"~dialogo.cliente1~"'")
endif
if (NoVacio(dialogo.lista1))
Sqladd("   and O.TipoOp In ("~Pipe2Comillas(dialogo.lista1)~")")
else
Sqladd("   and O.TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI') ")
endif
endif
endif
if (dialogo.check1 = 1)
Sqladd(" UNION ")
Sqladd("SELECT  O.NrOperacion,")
Sqladd("      O.TipoOp, ")
Sqladd("      O.UDN2, ")
Sqladd("      O.CB4, ")
Sqladd("      O.Cliente1, ")
Sqladd("       C.RazonSocial, ")
Sqladd("       C.Direccion, ")
Sqladd("       C.Localidad, ")
Sqladd("       C.CodigoPostal, ")
Sqladd("       C.CUIT, ")
Sqladd("       C.CondicionIVA, ")
Sqladd("       C.TipoInscripcion, ")
Sqladd("       C.Sucursal, ")
Sqladd("       C.Telefono ")
Sqladd("FROM   "~Dbo()~".BOPERACIONES O, "~Dbo()~".CLIENTES C  ")
Sqladd("WHERE  O.Cliente1 = C.Codigo  ")
if (NoVacio(dialogo.string1))
Sqladd("    and O.NrBoleto= '"~Pad0(dialogo.string1, 8)~"' ")
else
if (NoVacio(dialogo.nrboperacion))
Sqladd("  and O.NrOperacion= '"~dialogo.nrboperacion~"' ")
else
Sqladd("  and O.FechaOp Between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"'")
if (NoVacio(dialogo.cliente1))
Sqladd("   and O.Cliente1='"~dialogo.cliente1~"'")
endif
if (NoVacio(dialogo.lista1))
Sqladd("   and O.TipoOp In ("~Pipe2Comillas(dialogo.lista1)~")")
else
Sqladd("   and O.TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI') ")
endif
endif
endif

endif
Sqladd("ORDER BY 1, 2 ")
Watch(Sqlbatch())
