*HOJAVISIBLE(SI)
MostrarCuadrodeMensajes
CrearDialogo
 Fecha1  :'D.F.Gener.'    ;;;;;;;;;FSYS
 Fecha2  :'H.F.Gener.'    ;;;;;;;;;Fsys
 Radio1  :'Procesar|Nuevos|Enviados|Ambos|' ;;;;;;;;;0
 NrUnicoAsiento1 : 'Asiento'  ;;;;;;
 ListaTabla1: 'Operacion'   ;;;;NO;NO;
 ListaTabla2: 'Transaccion' ;;;;NO;NO;
FinDialogo

If Not Ok
  Cancelar
Endif

Message('Chequeando cuentas de asientos ...')

SQL.ADD(" SELECT A1.NrUnicoAsiento, A1.Cuenta, A1.Alias3 ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1  ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
IF NoVacio(Dialogo.ListaTabla1)
    SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
    SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
IF Vacio(Dialogo.ListaTabla1) Y Vacio(Dialogo.ListaTabla2)
    SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
    SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and  ( (A.Sector  IS NULL OR A.Sector  = '' OR A.Sector = ' ') OR (A.Sector <> 'NB' AND  A.Sector <> 'SC') ) ")
SQL.ADD("   and (A1.Cuenta IS NULL OR A1.Cuenta = '' ) ")
If Dialogo.Radio1=0
  SQL.ADD(" AND (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'NC') ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND (A.Estado = 'E' OR A.Estado = 'COE' OR A.Estado = 'NCE') ")
Endif
IF NoVacio(Dialogo.NrUnicoAsiento1)
  SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" order by 1 ")
watch(sql.batch)

Recorrer SQL
   Message('Asiento '~fbn('NrUnicoAsiento')~' item '~fbn('Alias3')~' sin cuenta.')
   SQL.ADD(" UPDATE "~DBO~".ASIENTOSCON SET Sector = 'SC' WHERE NrUnicoAsiento= '"~fbn('NrUnicoAsiento')~"' ")
   SQL.NEW
   SQL.EXEC
Proximo

Message('Chequeando importes de asientos ...')

SQL.ADD(" SELECT A.NrUnicoAsiento, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.Especie1, A1.DebitoCredito ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1  ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
IF NoVacio(Dialogo.ListaTabla1)
    SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
    SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
IF Vacio(Dialogo.ListaTabla1) Y Vacio(Dialogo.ListaTabla2)
    SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
    SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and  ( (A.Sector  IS NULL OR A.Sector  = '' OR A.Sector = ' ') OR (A.Sector <> 'NB' AND  A.Sector <> 'SC') ) ")
SQL.ADD("   and A1.DebitoCredito = 'DEB' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'NC') ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND (A.Estado = 'E' OR A.Estado = 'COE' OR A.Estado = 'NCE') ")
Endif
IF NoVacio(Dialogo.NrUnicoAsiento1)
  SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT A.NrUnicoAsiento, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.Especie1, A1.DebitoCredito ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1  ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
IF NoVacio(Dialogo.ListaTabla1)
    SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
    SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
IF Vacio(Dialogo.ListaTabla1) Y Vacio(Dialogo.ListaTabla2)
    SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
    SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and  ( (A.Sector  IS NULL OR A.Sector  = '' OR A.Sector = ' ') OR (A.Sector <> 'NB' AND  A.Sector <> 'SC') ) ")
SQL.ADD("   and A1.DebitoCredito = 'CRE' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'NC') ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND (A.Estado = 'E' OR A.Estado = 'COE' OR A.Estado = 'NCE') ")
Endif
IF NoVacio(Dialogo.NrUnicoAsiento1)
  SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito ")
SQL.ADD(" order by 1, A1.Especie1 ")
watch(sql.batch)

ACT(aa:1,'')
ACN(ab:1, 0)
ACN(ac:1, 0)

Recorrer SQL
   If Eqstr(fbn('NrUnicoAsiento'),Val(aa:1)) Y Eqstr(fbn('Especie1'),Val(vh:1))
      dfa
      ACN(ab:1,1)
   Else
      If Not Eqstr(fbn('NrUnicoAsiento'),Val(aa:1))
          If Val(ac:1)=1 Y Val(ab:1)=0
             ***+++Al asiento anterior le falta DEB o CRE, entonces no balancea.
             Message('El asiento '~Val(aa:1)~' no balancea.')
             SQL.ADD(" UPDATE "~DBO~".ASIENTOSCON SET Sector = 'NB' WHERE NrUnicoAsiento= '"~Val(aa:1)~"' ")
             SQL.NEW
             SQL.EXEC
          Endif
          message(fbn('NrUnicoAsiento'))
      EndIf
      ACN(ab:1,0)
   Endif

   ACT(a:fac, fbn('NrUnicoAsiento'))
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(b:fac, NUM(FSTR(fbn('Cantidad1'),0,8))*(-1))
      ACN(BA:fac, NUM(FSTR(fbn('Cantidad2'),0,8))*(-1))
      ACN(BB:fac, NUM(FSTR(fbn('Cantidad3'),0,8))*(-1))
      ACT(c:fac, fbn('Especie1'))
      ***---ACN(f:fac,  Val(b:fac)*iif( Eqstr(Modo(VAR('MONELOCA'),Val(c:fac)),'DIR'),  NUM(FSTR(fbn('Cantidad3'),0,4)) ,1/NUM(FSTR(fbn('Cantidad3'),0,4))))
   Else
      ACN(d:fac, NUM(FSTR(fbn('Cantidad1'),0,8)))
      ACN(DA:fac, NUM(FSTR(fbn('Cantidad2'),0,8)))
      ACN(DB:fac, NUM(FSTR(fbn('Cantidad3'),0,8)))
      ACT(e:fac, fbn('Especie1'))
      ***---ACN(g:fac,  Val(d:fac)*iif( Eqstr(Modo(VAR('MONELOCA'),Val(e:fac)),'DIR'),  NUM(FSTR(fbn('Cantidad3'),0,4)) ,1/NUM(FSTR(fbn('Cantidad3'),0,4))))
   Endif

   ***+++ACN(h:fac, Val(f:fac)+Val(g:fac))
   ACN(h:fac, Val(B:fac)+Val(D:fac))
   ACN(I:fac, Val(BA:fac)+Val(DA:fac))
   ACN(J:fac, Val(BB:fac)+Val(DB:fac))
   If Val(ab:1)=1
      If NUM(FSTR(Val(h:fac),0,2))<>0 O NUM(FSTR(Val(I:fac),0,2))<>0 O NUM(FSTR(Val(J:fac),0,2))<>0 
         message('El asiento '~fbn('NrUnicoAsiento')~' no balancea.')
         SQL.ADD(" UPDATE "~DBO~".ASIENTOSCON SET Sector = 'NB' WHERE NrUnicoAsiento= '"~fbn('NrUnicoAsiento')~"' ")
         SQL.NEW
         SQL.EXEC
      Endif
   Endif
   ACN(i:fac, fbn('Cantidad3'))
   ACT(aa:1, fbn('NrUnicoAsiento'))
   ACT(vh:1, fbn('Especie1'))
   ACN(ac:1, 1)
Proximo

If Val(ac:1)=1 Y Val(ab:1)=0
   ***+++Al ultimo asiento le falta DEB o CRE, entonces no balancea.
   Message('El asiento '~Val(aa:1)~' no balancea.')
   SQL.ADD(" UPDATE "~DBO~".ASIENTOSCON SET Sector = 'NB' WHERE NrUnicoAsiento= '"~Val(aa:1)~"' ")
   SQL.NEW
   SQL.EXEC
Endif
