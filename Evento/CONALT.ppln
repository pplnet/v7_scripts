sql.add("Select O.Especie,            O.ContraEspecie, O.FechaOp,        O.Precio1,        ")
sql.add("       O.TotalIntereses,     O.FechaVto,      O.Cantidad,       O.TipoOp,         ")
sql.add("       O.FormaLiquidacion1,  O.Mercado,       O.TablaFeriados1, O.TotalBrutoCli1, ")
sql.add("       O.NrOperacion,        OB.NrBit,        O.Precio3,        O.Precio4,        ")
sql.add("       O.ContraEspecie2  ")
sql.add("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" where O.FechaOp  = '"~IdxDate(Val(c6))~"' ")
if (Val(f7) > 1)
sql.add(" and O.Especie in ('"~Val(f6)~"') ")
else
sql.add(" and O.Especie = '"~Val(f6)~"' ")
endif
sql.add("   and O.Cupon1 = "~FStr(Val(u6), 0, 0)~" ")
sql.add("   and Round(O.Cantidad,4) = "~FStr(Val(i6), 1, 4)~" ")
sql.add(" and Round(O.Precio1*100000000,-1) = ROUND("~FStr(Val(j6), 1, 8)~"*100000000,-1) ")
if (Val(x1) = 1)
sql.add(" and O.Cliente1 = '"~Val(a6)~"' ")
endif
sql.add(" and IsNull(O.PaseCB,'0') = '"~Val(l6)~"' ")
if (Eqstr(Val(l6), '0'))
sql.add(" and O.TipoOp = '"~Val(b6)~"' ")
if (Val(n6) = 1)
sql.add(" and O.Plazo/24 = "~FStr(Val(e6), 1, 0)~" ")
endif
if (Val(o6) = 1)
sql.add(" and O.PlazoGracia = "~FStr(Val(e6), 1, 0)~" ")
endif
else
sql.add(" and ((O.TipoOp = '"~Val(b7)~"' and O.Plazo/24 = "~FStr(Val(e7), 1, 0)~") ")
sql.add("   or (O.TipoOp = '"~Val(b8)~"' and O.Plazo = "~FStr(Val(e8), 1, 0)~") ")
sql.add("     ) ")
endif
sql.add(" and O.ContraEspecie =  '"~Val(t6)~"' ")
sql.add(" and IsNull(O.NroAltaMAE,'') = '' ")
sql.add(" and O.NrOperacion   =  OB.NrOperacion ")
sql.add("   and IsNull(O.Plataforma,'SIOPEL') = 'SIOPEL' ")
sql.add(" and OB.NrBit        in (61,69) ")
sql.add(" and OB.Valor        =  '1' ")
recorrer sql
