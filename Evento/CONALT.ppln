sql.add(" Where Codigo    = 'CONALT' ")
sql.add("   and FechaMAE  = '"~Val(ab:2)~"' ")
sql.add("   and HoraMAE   = '"~Val(ab:3)~"' ")
sql.add("   and Secuencia = '"~Val(ab:4)~"' ")
sql.add("   and CodigoMAE = '"~Val(ab:5)~"' ")
sql.add("   and Estado    = 'PEN' ")
sql.new
sql.exec
else
Messagebox('- Confirma Operacion '~Val(m6)~' al MAE')
endif
endif
