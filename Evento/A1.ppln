Acn(q2, ((Fbn()['Cantidad2'] * Fbn()['Plazo1'] * Fbn()['Total6']) / iif (BuscarCampo('Operaciones', 'RB9', 'NrOperacion', dialogo.nroperacion1) = 0, 36000, 36500)) * (BuscarCampo('Operaciones', 'TotalAux1', 'NrOperacion', dialogo.nroperacion1) / 100))
Acn(q4, Val(q3) + iif (BuscarCampo('Operaciones', 'CB10', 'NrOperacion', dialogo.nroperacion1) = 1, Val(q2), 0))
