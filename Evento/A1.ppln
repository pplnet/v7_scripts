Acn(q2, iif (not DesciendeDeCliente(BuscarCampo('Operaciones', 'Cliente1', 'NrOperacion', dialogo.nroperacion1), 'BANCOS') y Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', BuscarCampo('Operaciones', 'Cliente1', 'NrOperacion', dialogo.nroperacion1))), Val(q3) * BuscarCampo('Operaciones', 'TotalAux2', 'NrOperacion', dialogo.nroperacion1) / 100, 0))
