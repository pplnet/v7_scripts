Message('----- Corte de Posicion Propia')

SetFilaActual(1)
Sqladd(" SELECT P.*,E.Cotiza, E.InteresesC, E.TamanioLote, 'Ejecutado' Estado ")
Sqladd(" FROM  "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E ")
Sqladd(" WHERE P.Cliente  = '"~Val(a:2)~"' ")
Sqladd(" AND   P.Especie  = E.Codigo ")
Sqladd(" AND   P.Fecha    <= '"~IdxDate(Val(g2))~"' ")
Sqladd(" AND   P.Vehiculo  = '"~Val(j2)~"' ")
Sqladd(" AND   P.Especie   = '"~Val(b2)~"' ")
Sqladd(" AND   P.Cupon     = "~FStr(Val(c2), 1, 0)~" ")
Sqladd(" AND   P.NrSaldo   >= 120 and P.NrSaldo < 140 ")
Sqladd(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES X")
Sqladd("                 WHERE  X.Cliente = P.Cliente ")
Sqladd("                 AND    X.Especie = P.Especie ")
Sqladd("                 AND    (X.TipoNegocio=P.TipoNegocio OR (X.TipoNegocio IS NULL AND P.TipoNegocio IS NULL)) ")
Sqladd("                 AND    X.Vehiculo     = P.Vehiculo ")
Sqladd("                 AND    X.NrSaldo      = P.NrSaldo  ")
Sqladd("                 AND    X.Cupon        = P.Cupon    ")
Sqladd("                 AND    X.Fecha       < '"~IdxDate(Val(g2))~"') ")
Sqladd(" ORDER By E.Cotiza, P.Especie, P.Vehiculo, P.Cliente, P.Book, P.NrSaldo, P.Fecha ")
recorrer sql
Message('Posiciones ')

Acd(aa:fac, Fbn('Fecha'))
Act(ab:fac, Fbn('Especie'))
Act(ac:fac, Fbn('Cupon'))
Act(ad:fac, Fbn('Cliente'))
Act(ae:fac, Fbn('Vehiculo'))
Act(af:fac, Fbn('Book'))
