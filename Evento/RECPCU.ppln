Sqladd("   '"~Fbn()['CallPut']~"', ")

Sqladd("   '"~Fbn()['Estrategia']~"', ")
Sqladd("   '"~Fbn()['Cartera']~"' ")
Sqladd(" ) ")
Sqlnew()
endif

