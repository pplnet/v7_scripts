Acn(al:fac, Query(" Select Count(*) from "~Dbo()~".MOVPOSPEN where NrOperacion = '"~Val(y1)~"' and NrSaldo = "~FStr(Fbn()['NrSaldo'], 1, 0)~" "))
Acn(am:fac, Query(" Select Count(*) from "~Dbo()~".MOVPOSEJE where NrOperacion = '"~Val(y1)~"' and NrSaldo = "~FStr(Fbn()['NrSaldo'], 1, 0)~" "))

if (Fbn('CantidadFin') <> 0)
Acn(z1, Fbn('CantidadFin'))
Acn(z2, Fbn('PrecioFin'))

if (Eqstr(BuscarCampo('ESPECIES', 'InteresesC', 'Codigo', Val(b2)), 'CLE'))
Acn(z4, (Val(l2) + Val(k2) * Val(z2) + Val(m2)) / 100)
Acn(z3, Val(z2))
else
Acn(z4, (Val(l2) + (Val(k2) * (Val(z2) - Val(l2) / 100 - Val(m2) / 100)) + Val(m2)) / 100)
Acn(z3, Val(z2) * (1 - Val(k2) / 100))
endif

Act(n:2, 'SI')
if (dialogo.check1 = 1)

Sqladd(" DELETE "~Dbo()~".MOVPOSPEN where NrOperacion = '"~Val(y1)~"' and NrSaldo = "~FStr(Fbn()['NrSaldo'], 1, 0)~" ")
Sqlnew()
Sqladd(" DELETE "~Dbo()~".MOVPOSEJE where NrOperacion = '"~Val(y1)~"' and NrSaldo = "~FStr(Fbn()['NrSaldo'], 1, 0)~" ")
Sqlnew()
Sqlexec()

Sqladd(" INSERT INTO "~Dbo()~".MOVPOSEJE ( ")
Sqladd("   Especie,    Cantidad,    NrOperacion, ")
Sqladd("   FechaMov,   Cliente,     Vehiculo, ")
Sqladd("   NrSaldo,    Precio,      Cupon, ")
Sqladd("   Tipo,       TipoNegocio, Trader, ")
Sqladd("   Book,       Unidad,      Centro, ")
Sqladd("   Sector,     Sucursal,    CallPut,  ")
Sqladd("   Estrategia, Cartera ")
Sqladd(" ) Values ( ")
Sqladd("   '"~Val(b2)~"', ")
Sqladd("   "~FStr(Val(z1) * (-1), 1, 2)~", ")
Sqladd("   '"~Val(y1)~"', ")

Sqladd("   '"~IdxDate(Val(g2))~"', ")
Sqladd("   '"~Fbn()['Cliente']~"', ")
Sqladd("   '"~Fbn()['Vehiculo']~"', ")

Sqladd("   "~FStr(Fbn()['NrSaldo'], 1, 0)~", ")
Sqladd("   "~FStr(Val(z2), 1, 8)~", ")
Sqladd("   '"~FStr(Val(c2), 1, 0)~"', ")

Sqladd("   '1', ")
Sqladd("   '"~Fbn()['TipoNegocio']~"', ")
Sqladd("   '"~Fbn()['Trader']~"', ")

Sqladd("   '"~Fbn()['Book']~"', ")
