sql.add("Select NrOperacion,TipoOp,FechaOp2,FechaOp,RB10,Vehiculo1,OperacionRef,")
sql.add("Cuotas2,Cuotas1,RB6,Cliente1,Especie,")
sql.add("Cliente2,Cantidad,Plazo,FechaVto,")
sql.add("TipoTasa,RB8,TotalComisiones,")
sql.add("PrecioEj,ImpGastos2,TotalAux1,")
sql.add("TasaImp1,IntDevengados1,")
sql.add("Operador,Observac2,NrOperacion,")
sql.add("TablaFeriados1,CB10,Precio2,")
sql.add("RB5,RB3,Impresa,Cotizacion1,Cotizacion2, ")
sql.add("RB11,Cuenta1,Cuenta2,Cuenta3,Cuenta4 ,Cuenta5, PlazoGracia,Precio3,MB1,DeltaTasa,")
sql.add("TotalIntereses,ImporteImp,Indice,")
sql.add("Precio1,Spread,TotalIntereses,TotalNetoCli2,TotalBrutoCli1,TotalNetoCli1,TotalAux4,")
sql.add("TotalIVA,TotalAux2,TotalAux3,ImpComCorEq1,ImpComCorEq2,PorComCor1,TotalGastos,ImpComCor1, ")
sql.add("TCComCor1, CB6,ImpComCor2,ImpGastos1 FROM ")
sql.add(" "~Dbo()~".OPERACIONES ")
sql.add("WHERE NrOperacion='"~dialogo.nroperacion1~"' ")

recorrer sql

Acn(x1, 1)

Acd(fo1, Fbn()['FechaOp'])

Acn(a6, Fbn()['PrecioEj'] - dialogo.cantidad2)

Acn(a2, iif (Eqstr('ARG', BuscarCampo('Clientes', 'PaisDir', 'Codigo', Fbn()['Cliente1'])), 0, 1))

Message('Actualizando la Operacion Original .... ')

Acn(b1, (Val(a6)) * ((Fbn()['Precio1'] + Fbn()['Spread']) / 100) * FactorDias(Fbn()['FechaOp'], Fbn()['FechaVto'], Fbn()['RB8'] + 1))

if (Eqstr(Fbn()['TipoOp'], 'MMPCL') y Fbn()['RB6'] = 1)
Acn(b5, (((Val(a6)) * ((Fbn()['Precio1'] + Fbn()['Spread']) / 100)) * FactorDias(Fbn()['FechaOp'], Fbn()['FechaVto'], Fbn()['RB8'] + 1)) * (Fbn()['TotalAux1'] / 100))
else
Acn(b5, (((Val(a6)) * (Fbn()['TotalAux2'] / 100)) * FactorDias(Fbn()['FechaOp'], Fbn()['FechaVto'], Fbn()['RB8'] + 1)) * (Fbn()['TotalAux1'] / 100))
endif


Acn(b6, (((Val(a6)) * (Fbn()['TotalAux4'] / 100)) * FactorDias(Fbn()['FechaOp'], Fbn()['FechaVto'], Fbn()['RB8'] + 1)) * (Fbn()['ImpGastos2'] / 100))

Acn(b17, 0)
Acn(b16, 0)
Acn(b15, 0)
Acn(b14, 0)


if (Eqstr(Fbn()['TipoOp'], 'MMPCOS') y Fbn()['RB6'] = 0)
Acn(b15, Val(a6) * Fbn()['Precio2'] * Fbn()['Plazo'] / iif (Fbn()['RB5'] = 0, 36000, 36500))
Acn(b14, Val(b15) + Fbn()['ImpComCor1'])
Acn(b13, Val(b14) * iif (Fbn()['CB6'] = 1, Fbn()['TCComCor1'], 1 / Fbn()['TCComCor1']))
Acn(b16, Val(b14) * Fbn()['IntDevengados1'] / 100)
Acn(b17, Val(b14) * (Fbn()['TasaImp1'] / 100))
endif

if (Eqstr(Fbn()['TipoOp'], 'MMPCL'))
if (Fbn()['Precio1'] > Var('TASAIMPINT'))
Acn(b17, (Fbn()['PrecioEj'] * (Var('TASAIMPINT') / 100) * Fbn()['Plazo']) / 36500)
else
Acn(b17, Val(b1) * (Fbn()['TasaImp1'] / 100))
endif
Acn(b14, 0)

if (Fbn()['RB6'] = 1)
Acn(b14, ((Fbn()['PrecioEj'] * Fbn()['ImpGastos1'] * Fbn()['Plazo']) / iif (Fbn()['MB1'] = 0, 36000, 36500)) * (Fbn()['Precio3'] / 100))
Acn(b18, Val(b14) + Fbn()['ImpComCor2'])
Acn(b19, Val(b18) + Fbn()['DeltaTasa'])
endif
endif

Acn(b2, Val(b1) + Val(b5) + Val(b17) + Val(b14))
Acn(b3, Val(b1) + (Val(a6)))
Acn(b4, Val(b2) + (Val(a6)))

sql.add("Update "~Dbo()~".OPERACIONES ")
sql.add("Set  ")
sql.add("    TotalIntereses="~FStr(Val(b1), 0, 2)~", ")
sql.add("    TotalNetoCli2="~FStr(Val(b2), 0, 2)~", ")
sql.add("    TotalBrutoCli1="~FStr(Val(b3), 0, 2)~", ")
sql.add("    TotalNetoCli1="~FStr(Val(b4), 0, 2)~", ")
sql.add("    TotalAux3="~FStr(Val(b5), 0, 2)~", ")
sql.add("    TotalIVA="~FStr(Val(b6), 0, 2)~", ")
sql.add("    ImporteImp="~FStr(Val(b17), 0, 2)~", ")
sql.add("    TotalGastos="~FStr(Val(b16), 0, 2)~", ")
sql.add("    ImpComCorEq1="~FStr(Val(b15), 0, 2)~", ")
sql.add("    ImpComCorEq2="~FStr(Val(b14), 0, 2)~", ")
sql.add("    PorComCor1="~FStr(Val(b13), 0, 2)~", ")
sql.add("    ImpComCor1="~FStr(Val(b18), 0, 2)~", ")
sql.add("    PeriodoInts="~FStr(Val(b19), 0, 2)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec

