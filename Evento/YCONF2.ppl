CrearDialogo
    Entero1:    'x-Accion'
    Fecha1:     'FechaValor'
    String1:    'r-Cupon'
    String2:    'a-NrCustodia'
    String3:    'm-Operacion'
    Fecha2:     'FechaConf'
    Entero2:    's-Estado'
    String4:    'b-TipoTransaccion'
FinDialogo


IF Dialogo.Entero1 = 0
   *- Confirma
   **- Marco la Transaccion que se esta matcheando          
   SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Dialogo.Fecha1)~"',Cupon2='"~Dialogo.String1~"'")
   SQL.ADD("WHERE  NrTrans= '"~Dialogo.String2~"' ")
   SQL.NEW

   * --- FO 28/04/2006  --------------------------- *
   * Se borran los movimientos de anulacion de liquidacion por fallas
   SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS ")
   SQL.ADD(" WHERE NrOperacion = '"~Dialogo.String3~"' AND Transaccion = 'Falla' ")
   SQL.NEW
   * ---------------------------------------------- *


   SQL.EXEC
   SQL.ActualizarMovimientosT2(Dialogo.String2,SI,NO,NO,SI,0,4)
   SQL.EXEC

   *- Pasa de Instancia
   ACT(az3,Dialogo.String2)
   ACT(az4,'TRANSACCIONES2')
   ACN(az5,70)
   ACN(az6,1 )

   (.'MODIINSTAN'.)

   IF NoVacio(Dialogo.String3)
      *** busco las operaciones y desafecto los limites, siempre tomo los pagos ***
      SQL.ADD("Select NrOperacion from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" where NrTrans2     = '"~Dialogo.String3~"' ")
      SQL.ADD("   and NrOperacion <> '"~Dialogo.String3~"'")
      SQL.ADD("   and Cantidad     < 0 ")
      SQL.ADD(" order by NrOperacion ")

      Recorrer SQL
        dfa
        SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
        SQL.ADD("  SET RB10        = '1',  ")
        SQL.ADD("      FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"' ")  
        SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
        SQL.ADD("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
        SQL.NEW
        SQL.EXEC
     
        ModificarOperacion(fbn['NrOperacion'],0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,0)
      Proximo

      ***if Dialogo.Entero2 = 2
         *** si viene de una falla se dan vuelta los movimientos de limites ****
         SQL.ADD("Insert Into "~DBO~".MOVLIMITES ")
         SQL.ADD(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
         SQL.ADD("  Descripcion, Bits, Vehiculo ) ") 
         SQL.ADD(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
         SQL.ADD("        M.FechaLim, (M.Monto*(-1)), M.NrOperacion,  ")
         SQL.ADD("        'Desafectacion Falla', M.Bits, M.Vehiculo ")
         SQL.ADD("   from "~DBO~".MOVLIMITES M ")
         SQL.ADD("Where NrOperacion = '"~Dialogo.String3~"' ")
         SQL.NEW
         SQL.EXEC
      ***endif

      ACT(az3,Dialogo.String3)
      ACT(az4,'TRANSACCIONES2')
      ACN(az5,70)
      ACN(az6,0 )
 
      (.'MODIINSTAN'.)
      
      Recorrer&i 1,1
          ACT(m:&i, Dialogo.String3)
          (.'MARCACONF'.)
      Proximo
   EndIf         

Else 
   IF Dialogo.Entero1 =1
      *- Falla
      *** arreglo del 04/10 ***
*XXX                  IF NO
      *** busco las operaciones y afecto los limites que seran del voucher ***
      SQL.ADD("Select NrOperacion from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" where NrTrans2     = '"~Dialogo.String3~"' ")
      SQL.ADD("   and NrOperacion <> '"~Dialogo.String3~"'")
      SQL.ADD("   and Cantidad     < 0 ")
      SQL.ADD(" order by NrOperacion ")

      Recorrer SQL
        dfa
        SQL.ADD("Insert Into "~DBO~".MOVLIMITES ")
        SQL.ADD(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
        SQL.ADD("  Descripcion, Bits, Vehiculo ) ") 
        SQL.ADD(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
        SQL.ADD("        '"~IdxDate(Dialogo.Fecha2)~"', M.Monto, '"~Dialogo.String3~"',  ")
        SQL.ADD("        'Afectacion Falla', M.Bits, M.Vehiculo ")
        SQL.ADD("   from "~DBO~".MOVLIMITES M ")
        SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
        SQL.ADD("  and FechaLim is not Null ")
        SQL.NEW
        SQL.EXEC
      Proximo
*XXX                  ENDIF

      * --- FO 28/04/2006 - Agrego Mov al voucher para que desafecten el Saldo --- *
      SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
      SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
      SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
      SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
      SQL.ADD(") ")
      SQL.ADD("select ")
      SQL.ADD("NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
      SQL.ADD("'"~'Falla '~Dialogo.String3~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
      SQL.ADD("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
      SQL.ADD("'"~UsuarioActivo~"', Cuenta, 'Falla', -Cantidad, Cupon")
      SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrOperacion = '"~Dialogo.String3~"' ")
      SQL.NEW  
      * -------------------------------------------------------------------------- *

      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Dialogo.String3~"' and NrBit=8 ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~Dialogo.String3~"' and NrBit in (3,6) ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 SET RB6      = 2, ")
      SQL.ADD("                               FechaTransp = '"~IdxDate(Dialogo.Fecha2)~"', ")
      SQL.ADD("                               FechaFalla  = '"~IdxDate(fsys)~"' ")
      SQL.ADD(" WHERE NrTrans = '"~Dialogo.String3~"' ")
      SQL.NEW
      SQL.EXEC
  Else
      *- Si vuelve a pendiente de una falla ***
      *** arreglo del 04/10 ***
      If Dialogo.Entero2 = 2
*XXX                     IF NO
         *** si es un cobro, vuelvo atras la fecha del limite de sett y max ****
         *** si viene de una falla se dan vuelta los movimientos de limites ****
         SQL.ADD("Insert Into "~DBO~".MOVLIMITES ")
         SQL.ADD(" (FechaMov, Cliente, Limite, Especie, FechaLim, Monto, NrOperacion,  ")
         SQL.ADD("  Descripcion, Bits, Vehiculo ) ") 
         SQL.ADD(" Select M.FechaMov, M.Cliente, M.Limite, M.Especie, ")
         SQL.ADD("        M.FechaLim, (M.Monto*(-1)), M.NrOperacion,  ")
         SQL.ADD("        'Desafectacion Falla', M.Bits, M.Vehiculo ")
         SQL.ADD("   from "~DBO~".MOVLIMITES M ")
         SQL.ADD("Where NrOperacion = '"~Dialogo.String3~"' ")
         SQL.NEW
*XXX                     ENDIF

        * --- FO 28/04/2006  --------------------------- *
        * Se borran los movimientos de anulacion de liquidacion por fallas
        SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE NrOperacion = '"~Dialogo.String3~"' AND Transaccion = 'Falla' ")
        SQL.NEW
        * ---------------------------------------------- *
           
         if EqStr(Dialogo.String4,'DEP')
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Dialogo.String3~"' and NrBit=3 ")
         else
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 1 WHERE NrOperacion = '"~Dialogo.String3~"' and NrBit=6 ")
         endif
         SQL.NEW
         SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = 0 WHERE NrOperacion = '"~Dialogo.String3~"' and NrBit=8 ")
         SQL.NEW
         SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 SET RB6 = 0, FechaFalla = Null WHERE NrTrans = '"~Dialogo.String3~"' ")
         SQL.NEW
        SQL.EXEC    
     Endif
  Endif
EndIf