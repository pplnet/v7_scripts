Sqladd(" PrecioRef4, TipoTasa2, TotalBrutoCli2, TotalBrutoCli3, ImpGastos2,RB3,Cliente1, ")
Sqladd(" Cuenta1, Cuenta2, CuentaContable1 ,Book1,Book2,CB1 ) ")
