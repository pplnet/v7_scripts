Sqladd(" '"~Fbn()['ContraEspecie']~"','"~Fbn()['RB5']~"','"~Fbn()['PrecioRef4']~"','"~Fbn()['TipoTasa2']~"',"~FStr(Fbn()['TotalBrutoCli2'], 0, 4)~", ")
