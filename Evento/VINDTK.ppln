Sqladd(" '"~Fbn()['PrecioRef3']~"','"~Fbn()['TipoTasa']~"',"~FStr(Fbn()['TotalAux3'], 0, 4)~","~FStr(Fbn()['TotalAux4'], 0, 4)~", "~FStr(Fbn()['ImpGastos2'], 0, 7)~",")
Sqladd(" '"~Fbn()['RB3']~"','"~Fbn()['Vehiculo1']~"', ")
Sqladd(" '"~Fbn()['Cuenta1']~"','"~Fbn()['Cuenta2']~"','"~Fbn()['CuentaContable1']~"', '"~Fbn()['Book2']~"', '"~Fbn()['Book1']~"', '1' )")
