MostrarCuadroDeMensajes
HojaVisible(SI)

CrearDialogo
  Fecha1: 'Fecha'                             ;;;;;;;;;FSYS
  Radio1: 'TipoCta|Intermedia|Pagadora|Ambas' ;;;;;;;;;2
  Lista1: 'Vehiculos'                         ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Lista2: 'Bancos'                            ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3: 'Cuentas'                           ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~ ") "~IIF(Dialogo.Radio1=0, " AND TipoCuenta='INT' ", IIF(Dialogo.Radio1=1, " AND Pagadora='SI' ", " AND (Pagadora='SI' OR TipoCuenta='INT') " ))~"  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') " ) )~"  ");
  Check2: 'HojaVisible'                       ;;1;;;;;;;1
  Check1: 'Confirma'                          ;;;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD(" SELECT M.Importe, M.Importe4*(-1) Importe4, M.Importe8, C1.Codigo Cuenta1, C2.Codigo Cuenta2, ")
SQL.ADD(" M.Vehiculo Vehiculo1, C2.Cliente Vehiculo2, M.Moneda, E.Codigo MonedaFPA, C1.Numero Numero1, C2.Numero Numero2, ")
SQL.ADD(" C1.Comitente Banco1, C2.Comitente Banco2, C1.TipoCuenta TC1, C2.TipoCuenta TC2, C1.Pagadora, M.DC ")
SQL.ADD(" FROM "~DBO~".CUENTAS C1, "~DBO~".DATANET D, "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C2, "~DBO~".ESPECIES E")
SQL.ADD(" WHERE D.NrDatanet = M.NrDatanet ")
SQL.ADD(" AND   C1.Numero   = M.Cuenta    ")
SQL.ADD(" AND   C1.Alias6   = C2.Codigo  (+) ")
SQL.ADD(" AND   M.Moneda    = E.Alias3   (+) ")
SQL.ADD(" AND   D.Archivo IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
SQL.ADD(" AND   D.FechaBajada = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   D.EstadoAprobacion <> 'P' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  C1.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  C1.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Else
  If Dialogo.Radio1=1
    SQL.ADD(" AND   C1.Pagadora = 'SI' ")
  Else
    If Dialogo.Radio1=0
      SQL.ADD(" AND   C1.TipoCuenta = 'INT' ")
    Else
      SQL.ADD(" AND   (C1.Pagadora = 'SI' OR C1.TipoCuenta = 'INT' ) ")
    Endif
  Endif
Endif 
SQL.ADD(" ORDER BY C1.TipoCuenta, C1.Codigo ")

*Registros encontrados
ACN(az:1,0)

*Errores encontrados
ACN(az:2,0)

Recorrer SQL
  ACN(az:1,1)
  * -------------------   DEBITOS   ----------------------- *
  ACD(ab:fac, Dialogo.Fecha1)
  ACD(ac:fac, Dialogo.Fecha1)

  ACN(ap:fac, fbn('Importe4'))
  ACN(aq:fac, fbn('Importe8'))
  If Eqstr(fbn('DC'),'D')
    ACN(ah:fac, fbn('Importe')*(-1))
    ACN(ar:fac, (fbn('Importe')*(-1))+fbn('Importe4')+fbn('Importe8'))
  Else
    ACN(ah:fac, fbn('Importe'))
    ACN(ar:fac, fbn('Importe')+fbn('Importe4')+fbn('Importe8'))
  Endif

  If Eqstr(fbn('Pagadora'),'SI')
    ACT(ao:fac, 'Pagadora')

    ACT(aj:fac, fbn('Vehiculo2'))
    ACT(al:fac, fbn('Banco2'))
    ACT(af:fac, fbn('Cuenta2'))
    ACT(ag:fac, fbn('Numero2'))

    ACT(ak:fac, fbn('Vehiculo1'))
    ACT(am:fac, fbn('Banco1'))
    ACT(ad:fac, fbn('Cuenta1'))
    ACT(ae:fac, fbn('Numero1'))
  Else
    ACT(ao:fac, 'Intermedia')

    ACT(aj:fac, fbn('Vehiculo1'))
    ACT(al:fac, fbn('Banco1'))
    ACT(af:fac, fbn('Cuenta1'))
    ACT(ag:fac, fbn('Numero1'))

    ACT(ak:fac, fbn('Vehiculo2'))
    ACT(am:fac, fbn('Banco2'))
    ACT(ad:fac, fbn('Cuenta2'))
    ACT(ae:fac, fbn('Numero2'))
  Endif
  ACT(ai:fac, fbn('MonedaFPA'))
  ACT(an:fac, fbn('Moneda'))

  If CeldaVacia(aj:fac) o CeldaVacia(al:fac) o CeldaVacia(af:fac) o CeldaVacia(ai:fac)
    ACN(aa:fac, 0)
  Else
    ACN(aa:fac, 1)
  Endif

Proximo

If Val(az:1)=0
  message('No se encontraron registros.')
  Esperar(5)
  Cancelar
Endif

If Dialogo.Check1=1
  CrearListBox; 'Arial,8,'
   'OK '           ;aa:1..aa:fac;SI;[NoVacio(Val(aj:FLB)) y NoVacio(Val(al:FLB)) y NoVacio(Val(af:FLB)) y NoVacio(Val(ai:FLB)) y NoVacio(Val(ak:FLB))] o Val(aa:FLB)=0;'Faltan datos para la transferencia';50;CHECK ;RGB(232,255,215);
   'F.Ingreso '    ;ab:1..ab:fac;NO;;;65;FECHA ; RGB(232,232,232);
   'F.Acredit.'    ;ac:1..ac:fac;SI;;;65;FECHA ; RGB(232,255,215);
   'Tipo Cuenta'   ;ao:1..ao:fac;NO;;;70;STRING;;RGB(232,232,232);
   'Vh.Origen'     ;aj:1..aj:fac;NO;;;70;STRING;;RGB(232,232,232);
   'Bco.Origen'    ;al:1..al:fac;NO;;;70;STRING;;RGB(232,232,232);
   'Cta Origen'    ;ag:1..ag:fac;NO;;;90;STRING;;RGB(232,232,232);
   'Saldo Contable';ah:1..ah:fac;NO;;;90;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Debitos 24 hs' ;ap:1..ah:fac;NO;;;90;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Creditos 24 hs';aq:1..ah:fac;NO;;;90;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Saldo Cuenta'  ;ar:1..ah:fac;NO;;;90;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'Moneda'        ;an:1..an:fac;NO;;;50;STRING;;RGB(232,232,232);
   'Vh.Destino'    ;ak:1..ak:fac;NO;;;70;STRING;;RGB(232,232,232);
   'Bco.Destino'   ;am:1..am:fac;NO;;;70;STRING;;RGB(232,232,232);
   'Cta Destino'   ;ae:1..ae:fac;NO;;;90;STRING;;RGB(232,232,232);
  FinListBox

  If Not OK
    Cancelar
  Endif
Endif

ACT(b:1, 'Generacion Automatica de Transferencias')
ACT(a:3, 'Errores encontrados - '~Dialogo.Fecha1)
SetFont(b:1,3)
SetFont(a:3,2)

ACT(a:4, 'Cuenta')
ACT(b:4, 'Numero')
ACT(c:4, 'Importe')
ACT(d:4, 'Error')

SetFont(a:4..d:4,2)
AgregarMarco(a:4..d:4,0,0,EXE('COLOR6'))

*Fila de errores
ACN(fi:1, 5)

Recorrer&i 1,fac
 If Val(aa:&i)=1 

   ACN(ct:1, 0)
   ACN(ct:1, SQL(" SELECT COUNT(*) FROM "~DBO~".TRANSACCIONES2 WHERE TipoTr2='TRANSF' AND CB6='1' AND Fecha1= "~IdxDate2(Val(ab:&i))~" AND Fecha2= "~IdxDate2(Val(ac:&i))~" AND Cliente2 = '"~Val(am:&i)~"' AND Cuenta2 = '"~Val(ad:&i)~"' AND Vehiculo1= '"~Val(aj:&i)~"' "))

   If ABS(Val(ar:&i))>0 y Val(ct:1)=0
     message('Generando Transferencia automatica ...')   
     ACT(ay:1, GetNumerador(10102))
     ACT(rb:1, IIF( Eqstr(Val(aj:&i),Val(ak:&i)),'0','2'))
     SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
     SQL.ADD(" NrTrans, TipoTr2, RB1, Vehiculo2, ")
     SQL.ADD(" Vehiculo1, Fecha1, Fecha2, ConceptoPago, ")
     SQL.ADD(" Especie, Cantidad1, Cantidad4, Cliente1, Cuenta1, ")
     SQL.ADD(" CB3, Cliente2, Cuenta2, CB5, ")
     SQL.ADD(" CB2, CB4, CB6, UsrInput, FechaCargaSys, FechaCarga ")
     SQL.ADD(" ) VALUES ( ")
     SQL.ADD(" '"~Val(ay:1)~"', 'TRANSF', '"~Val(rb:1)~"', '"~Val(ak:&i)~"', ")
     SQL.ADD(" '"~Val(aj:&i)~"',  "~IdxDate2(Val(ab:&i))~", "~IdxDate2(Val(ac:&i))~", 'TRANSF', ")
     SQL.ADD(" '"~Val(ai:&i)~"', "~fstr(abs(Val(ar:&i)),0,2)~", "~fstr(abs(Val(ar:&i)),0,2)~", '"~Val(al:&i)~"', '"~Val(af:&i)~"',")
     SQL.ADD(" '1', '"~Val(am:&i)~"', '"~Val(ad:&i)~"', '1', ")
     SQL.ADD(" '0', '0', '1', '"~USUARIOACTIVO~"', "~IdxDate2(FSYS)~", "~IdxDate2(FSYS)~" ")
     SQL.ADD(" ) ")
     SQL.NEW

     Recorrer&j 1,25
       ACT(jj:1, Fstr(&j,1,0))
       If Incluido(Val(jj:1),'15|16|17|18|20|25')
         SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS ")
         SQL.ADD(" (NrOperacion, NrBit, Valor) ")
         SQL.ADD(" Values ")
         SQL.ADD(" ('"~Val(ay:1)~"',"~Fstr(&j,1,0)~",'0') ")
         SQL.NEW        
       Endif
     Proximo 

     SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor='1' WHERE NrOperacion = '"~Val(ay:1)~"' AND NrBit=18 ")
     SQL.NEW

     message('Transferencia '~Val(ay:1)~' generada.')
     SQL.EXEC

     SQL.ActualizarMovimientosT4(Val(ay:1),SI,NO,NO,NO,NO,NO,0)
     SQL.EXEC
   Else

     If Val(ct:1)<>0
       message('El traslado para la cuenta '~Val(ad:&i)~' ya existe.')
       ACT(a:Val(fi:1), Val(ad:&i))
       ACT(b:Val(fi:1), Val(ae:&i))
       ACN(c:Val(fi:1), Val(ah:&i))
       ACT(d:Val(fi:1), 'El traslado para la cuenta '~Val(ad:&i)~' ya existe.' )
       SCN(fi:1, 1)
       ACN(az:2,1)
     Endif

     If ABS(Val(ar:&i))<=0
       message('El importe del traslado es menor a cero.')
       ACT(a:Val(fi:1), Val(ad:&i))
       ACT(b:Val(fi:1), Val(ae:&i))
       ACN(c:Val(fi:1), Val(ah:&i))
       ACT(d:Val(fi:1), 'El importe del traslado es menor a cero.' )
       SCN(fi:1, 1)
       ACN(az:2,1)
     Endif

   Endif
 Else
   If CeldaVacia(aj:&i)
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'Falta el Vehiculo Origen' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If Val(ar:&i)>0 y Eqstr(Val(ao:&i),'Pagadora')
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'La Cuenta es pagadora y tiene saldo acreedor' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If Val(ar:&i)<0 y Eqstr(Val(ao:&i),'Intermedia')
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'La Cuenta es Intermedia y tiene saldo deudor' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If CeldaVacia(ak:&i)
     ACT(a:Val(fi:1), Val(af:&i))
     ACT(b:Val(fi:1), Val(ag:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'Falta el Vehiculo Destino' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If CeldaVacia(al:&i)
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'Falta el Banco Origen' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If CeldaVacia(ag:&i)
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'La cuenta origen no existe o es incorrecta' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif

   If CeldaVacia(ai:&i)
     ACT(a:Val(fi:1), Val(ad:&i))
     ACT(b:Val(fi:1), Val(ae:&i))
     ACN(c:Val(fi:1), Val(ah:&i))
     ACT(d:Val(fi:1), 'El codigo de Moneda Datanet no tiene su equivalente en el alias3 de la tabla ESPECIES de FPA' )
     SCN(fi:1, 1)
     ACN(az:2,1)
   Endif
   SetFont(a:Val(fi:1)..c:Val(fi:1),1)
 Endif
Proximo

SetFilaActual(Val(fi:1))

ifa
ifa
ACT(a:fac,'Fin')

ACO(1,8)
ACO(2,15)
ACO(3,10)
ACO(4,40)


If Val(az:2)=1
  ACT(a:3, Val(a:3)~'  -  Hora: '~Hora(AHORA))
  SetFont(a:3,2)
  ACT(fe:1,Fecha(Dialogo.Fecha1))
  GrabarPMG(Val(fe:1), 'BPBD1 Hora: '~Hora(AHORA) )
Endif

Impresion(1,2)
LimitesVision(d:Val(fi:1)+5)
If Dialogo.Check2=0
  HojaVisible(NO)
Endif