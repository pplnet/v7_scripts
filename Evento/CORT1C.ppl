MostrarCuadroDeMensajes
CrearDialogo
   Especie1   :'Especie'      ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y Not DesciendeDeEspecie(Dialogo.Especie1,'CUPON');'Especie Invalida';NO;;;;;;"Status = 'HAB' "
   Especie2   :'Indice'       ;1;2;;NO;NoVacio(Dialogo.Especie3);;;;;Dialogo.Especie3
   Especie3   :'Indice'       ;1;2;;NO;NO;;;;;SQL("SELECT E.Indice FROM "~DBO~".ESPECIES E WHERE Indice IS NOT NULL and E.Codigo='"~Dialogo.Especie1~"' ")
   Fecha1     :'F.Corte'      ;2;1;;SI;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 >= Fsys;'Fecha de Corte Invalida';SI;IIF(Dialogo.Check1=1,FechaMaduracion(Dialogo.Especie1),ProxCupon2(Dialogo.Especie1, Fsys));IIF(Dialogo.Check1=1,FechaMaduracion(Dialogo.Especie1),ProxCupon2(Dialogo.Especie1, FSys))
   Cantidad1  :'Coeficiente'  ;2;2;;;NoVacio(Dialogo.Especie3);Vacio(Dialogo.Especie3) o Dialogo.Cantidad1>=1;'El Coeficiente debe ser >=1';NO;;IIf(Vacio(Dialogo.Especie3),1,Cotizacion(Dialogo.Especie2,,,,Dialogo.Fecha1-1,1,SI)/Cotizacion(Dialogo.Especie2,,,,Dialogo.Fecha5-1,1,SI));;;'####.########'
   Entero1    :'Nr.Cupon'     ;3;1;;NO;;Dialogo.Entero1>=0;'Nro de Cupon Invalido';NO;0;Num(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))
   Check3     :'Piks'         ;3;2;;;;;;
   Precio16   :'Tasa PikAnual';4;2;;;Dialogo.Check3=1;Dialogo.Check3 = 0 O Dialogo.Precio16 > 0;'Tasa Pik Invalida';NO;;IIF(Dialogo.Check3=1, SQL("SELECT PorPIK FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' AND Esquema = '1' "), 0);;;'####.########'
   Precio18   :'Tasa Piks'    ;5;2;;;Dialogo.Check3=1;Dialogo.Check3 = 0 O Dialogo.Precio18 > 0;'Tasa Pik Anual Invalida';NO;;(Dialogo.Precio16/Dialogo.Precio9)*Dialogo.Precio10;;;'####.########'
   Precio17   :'Tasa Penalty' ;6;2;;;Dialogo.Check3=1;;;;;IIF(Dialogo.Check3=1, SQL("SELECT PorPenalty FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' AND Esquema = '1' "), 0);;;'####.########'
   Precio1    :'% Amort.'     ;4;1;;;;Dialogo.Precio1>=0;'El % de Amortizacion debe ser Positivo';NO;;IIF(Dialogo.Check1=1,100,SQL("SELECT PorAmCapital FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"'"));;;'####.########'
   Precio2    :'% Renta'      ;5;1;;;;Dialogo.Precio2>=0;'El % de Renta debe ser Positivo'       ;NO;;(Dialogo.Precio11/Dialogo.Precio9)*Dialogo.Precio10;;;'####.########'
   Precio11   :'% RentaAnual' ;7;2;;;;Dialogo.Precio11>=0 Y [Eqstr(Dialogo.TipoTasa1,'FIJA') O [[Dialogo.Precio11 >= Dialogo.Precio14 O Dialogo.Precio14=0] Y [Dialogo.Precio11 <= Dialogo.Precio15 O Dialogo.Precio15=0]] O Eqstr(SQL(" Select TipoCupon From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' and NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' "),'AMO')];IIF(Dialogo.Precio11 < 0, 'El % de Renta Anual debe ser Positivo','La Tasa debe estar entre TasaCap y TasaFloor de la especie');Dialogo.Precio11>=0;;IIF(Eqstr(Dialogo.TipoTasa1,'FIJA') O Dialogo.Check2=0, SQL("SELECT PorRenta FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' AND Esquema = '"~Dialogo.String1~"' "), Dialogo.Precio13);;;'####.########'
   Precio3    :'% Am.Int.Cap.';6;1;;;;Dialogo.Precio3>=0;'El % de Cap.Int. debe ser Positivo'    ;NO;;SQL("SELECT PorAmIntCap  FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"'");;;'####.########'
   Precio4    :'Tasa.Cap.Int' ;7;1;;Dialogo.Entero1<=Dialogo.Entero2;Dialogo.Entero1<=Dialogo.Entero2;Dialogo.Precio4>=0;'La Tasa de Capitalizacion de Intereses debe ser Positivo'    ;NO;;IIF(Dialogo.Entero2>=Dialogo.Entero1,BuscarCampo('ESPECIES','TasaIntVigente','Codigo',Dialogo.Especie1)*100,0);;;'####.########'
   Precio6    :'IntCapAct'    ;8;1;;NO;Dialogo.Entero1<=Dialogo.Entero2;;;;((Dialogo.Precio4/100)/Dialogo.Precio9)*Dialogo.Precio10;((Dialogo.Precio4/100)/Dialogo.Precio9)*Dialogo.Precio10;;;'####.########'
   Precio7    :'IntCapAnt'    ;9;1;;NO;Dialogo.Entero1<=Dialogo.Entero2;;;;;SQL("SELECT IntsCapitalizados  FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie1~"' AND NrCupon='"~FSTR(Dialogo.Entero1-1,1,0)~"'");;;'####.########'
   Precio8    :'IntCapAcu'    ;10;1;;NO;;;;;IIF(Dialogo.Precio7<>0,Dialogo.Precio7+Dialogo.Precio6,Dialogo.Precio6);IIF(Dialogo.Precio7<>0,Dialogo.Precio7+Dialogo.Precio6,Dialogo.Precio6);;;'####.########'
   Precio5    :'V.T.Actual'   ;10;2;;NO;;Dialogo.Precio5>=0;'El % de V.Teorico al Corte debe ser Positivo';NO;ValorTeorico(Dialogo.ESPECIE1);ValorTeorico(Dialogo.ESPECIE1);;;'####.########'
   Precio9    :'DiasAnio'     ;14;1;;NO;NO;;;;;DiasA(EspecieDiasAnio(Dialogo.Especie1),Dialogo.Fecha1)
   Precio10   :'DiasMes'      ;15;1;;NO;NO;;;;;ABS(IIF(EspecieDiasAnio(Dialogo.Especie1)=0 y EspecieDiasMes(Dialogo.Especie1)=0,Dif360(Dialogo.Fecha6,Dialogo.Fecha5, 2),DifDias(Dialogo.Fecha6,Dialogo.Fecha5,'USA',NO)))
   Entero2    :'Ult.CuponCap' ;1;1;;NO;NO;;;;;BuscarCampo('ESPECIES','PeriodoIntereses','Codigo',Dialogo.Especie1);;;'####'
   Fecha5     :'FechaAnt'     ;12;1;;NO;Dialogo.Check1=0;;;;;UltCupon2(Dialogo.Especie1,Dialogo.Fecha1-1)
   Fecha6     :'FechaProx'    ;12;2;;NO;Dialogo.Check1=0;;;;;ProxCupon2(Dialogo.Especie1,Dialogo.Fecha1)
   Fecha3     :'FechaAct'     ;1;1;;NO;NO;Fsys=Dialogo.Fecha3;'Debe Actualizar la Especie 72 Hs. antes del corte !!!! ('~Dialogo.Fecha3~')'; ;Habiles(Dialogo.Fecha1,-3,'ARG');Habiles(Dialogo.Fecha1,-3,'ARG')
   Check1     :'ZeroCoupon'   ;1;1;;NO;NO;;;;;IIF(EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1)),1,0)
   Check2     :'Automatico'   ;11;2;;NO;NO;;;;;
   TipoTasa1  :'TipoTasa'     ;;;;NO;NO;;;;;IIF(Vacio(BuscarCampo('ESPECIES','TipoTasa','Codigo',Dialogo.Especie1)), 'FIJA', BuscarCampo('ESPECIES','TipoTasa','Codigo',Dialogo.Especie1));
   Precio12   :'TasaDia'      ;;;;NO;NO;;;;;SQL(" Select T.Valor1 From "~DBO~".TASASDIA T Where TipoTasa = '"~Dialogo.TipoTasa1~"' AND Fecha = (Select Max(Fecha) From "~DBO~".TASASDIA T1 Where T.TipoTasa = T1.TipoTasa AND T1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ");
   Precio13   :'TasaMod'      ;;;;NO;NO;;;;;IIF(Incluido(SQL(" Select TipoCupon From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' and NrCupon = '"~Fstr(Dialogo.Entero1,0,0)~"' "),'RYA|REN|'),IIF(Dialogo.Precio12 < Dialogo.Precio14 ,Dialogo.Precio14, IIF(Dialogo.Precio12 > Dialogo.Precio15 Y Dialogo.Precio15 <> 0, Dialogo.Precio15, Dialogo.Precio12)),0)
   Precio14   :'TasaFloor'    ;;;;NO;NO;;;;;BuscarCampo('ESPECIES','TasaFloor','Codigo',Dialogo.Especie1)
   Precio15   :'TasaCap'      ;;;;NO;NO;;;;;BuscarCampo('ESPECIES','TasaCap','Codigo',Dialogo.Especie1)
   String1    :'Esquema'      ;;;;NO;SI;;;;;IIF(Dialogo.Check3=1,'1','0');
FinDialogo

If Not Ok
   Cancelar
Endif


If Vacio(BuscarCampo('ESPECIES','Alias3','Codigo',Dialogo.Especie1)) 
   Cancelar('La Especie no tiene el Cupon Asociado.')
Endif

If Not EqStr(BuscarCampo('ESPECIES','Status','Codigo',Dialogo.Especie1),'HAB')
   Cancelar('La Especie debe estar Habilitada.')
Endif

If Num(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)) <> Dialogo.Entero1
   Cancelar('No Coincide el Nro. de Cupon corriente.')
Endif

ACT(X:100, SQL(" SELECT Estado FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' "))
If Eqstr(Val(x:100), 'PRO')
   Cancelar('El cupon ya esta procesado.')
Endif

*-- Fila 2 especie origen, fila 3 especie nueva, fila 4 cupon --*
SQL.ADD(" SELECT * FROM "~DBO~".ESPECIES WHERE Codigo = '"~Dialogo.Especie1~"'")

ACN(z1,0)

Recorrer SQL
   *--------------------------- Especie Origen ----------------------------*
   ACT(a2, FBN['Jerarquia'])
   ACT(b2, FBN['Codigo'])
   *- Nr Cupon
   ACN(c2, Dialogo.Entero1)
   ACT(d2, FBN['Nombre'])
   *- VT Corte
   ACN(e2, Dialogo.Precio5)
   *- Fecha de Corte
   ACD(g2, Dialogo.Fecha1)
   *- Amortizacion
   ACN(K:2, Dialogo.Precio1)
   *- Renta Mensual
   ACN(l2, Dialogo.Precio2)

   *- Renta Anual
   ACN(l3, Dialogo.Precio11)

   *- Cap Int
   ACN(m2, Dialogo.Precio3)

   *- Nr Cupon
   ACN(n2, Dialogo.Entero1)
   *- Tipo de Especie
   ACT(o2, FBN['Tipo'])

   *-----------------------------Nuevo Cupon--------------------------------*
   ACN(c3, Val(c2))
   If Dialogo.Check1=0
      *- Cupon Actual + 1
      ACN(c3, Val(c2)+1)
   EndIf

   ACN(E:99, Round(Val(e2), 7) - Round((Val(K:2)/100), 7))
   IF Val(E:99) <= 0
       ***---Ya Amortizo todo el capital, => no hay proximo cupon
       ACN(C:3, Val(C:2))
   ENDIF

   *- VT Actual - (%Amort /100 )
   ACN(e3, Val(e2)-(Dialogo.Precio1/100))
   ACN(f3, (Dialogo.Precio1+Dialogo.Precio2)/100)

   *---------------------------- Especie Cupon -----------------------------*
   ACT(b4, FBN['Alias3'])

   *- Fecha Proximo Corte
***---   ACD(h4, IIF(Dialogo.Check1=0,ProxCupon2(Val(b2),Fsys),FBN['Fecha']) )
   ACD(h4, Dialogo.Fecha1)
   ACN(h5, Dialogo.Check1)

   *- Cupon Nuevo
   ACN(c4, Val(c3))

   *- Datos de Capitalizacion de Interes ci1: Tasa Cap.Int
   ACN(ci1,Dialogo.Precio4)
   ACN(ci2,Dialogo.Precio8)

   *-- Indice => Valor10
   ACN(in1,Dialogo.Cantidad1)

   ACN(PR:18, Dialogo.Precio18)
   ACN(PR:17, Dialogo.Precio17)
   ACN(CK:3, Dialogo.Check3)

   *-- Confirma la actualizacion de las nuevas especies --*
   CrearDialogo
      Especie1       :'E. Origen'   ;1;1;;NO;;;;;Val(b2)
      Entero1        :'Nr.Cupon'    ; ; ;;NO;;;;;Val(n2)
      ContraEspecie2 :'Cupon'       ; ; ;;NO;val(h5)=0;;;;Val(b4)
      Fecha1         :'F.Corte'     ; ; ;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;Val(h:4)
      Fecha2         :'Fecha Pago'  ; ; ;;SI;;;;;Val(h4)
      Fecha3         :'Prox.Corte'  ; ; ;;NO;val(h5)=0;;;;ProxCupon2(Val(b2),Dialogo.Fecha1+1)
      Precio4        :'V.Teor.Nuevo'; ; ;;SI;;Dialogo.Precio4>=0;'El nuevo Valor Teorico no puede ser negativo !!!';NO;Val(e3);;;;'####.########'
   FinDialogo

   If Not OK
      ACN(z1,3)
      Break
   Endif

   *- Actualizar V.Teorico con el que ellos cargaron
   ACN(e3, Dialogo.Precio4)

   *----------- Modifico la especie ----------------*
   SQL.ADD("UPDATE "~DBO~".ESPECIES ")
   SQL.ADD("SET    Cupon = "~Fstr(Val(c3),0,0)~", VTeorico = "~Fstr(Val(e3),0,7)~", ")
   SQL.ADD("       FechaCorteCupon = '"~IdxDate(Val(g2))~"', ")
   SQL.ADD("       FechaPagoCupon = '"~IdxDate(Dialogo.Fecha2)~"', ")
   SQL.ADD("       FechaProximoCorte='"~IdxDate(Dialogo.Fecha3)~"', ")
   SQL.ADD("       Valor10           = "~FSTR(Val(in1),1,8)~", ")
   SQL.ADD("       IntsCapitalizados = "~FSTR(Val(ci2),1,8)~"  ")
   SQL.ADD("WHERE Codigo = '"~Dialogo.Especie1~"' ")
   SQL.NEW
   message(' Actualizando Especie ')

 
   *----------- Modifico LA ESPECIE CUPON -------------*
   SQL.ADD("UPDATE "~DBO~".ESPECIES ")
   SQL.ADD("SET    Cupon = "~Fstr(Val(c2),0,0)~", ")
   SQL.ADD("    Fecha = '"~IdxDate(Val(h4))~"', ")
   SQL.ADD("       FechaCorteCupon = '"~IdxDate(Val(g2))~"', ")
   SQL.ADD("       FechaPagoCupon = '"~IdxDate(Dialogo.Fecha2)~"', ")
   SQL.ADD("       VTeorico = "~Fstr(Val(f3),0,7)~" ")
   SQL.ADD("WHERE  Codigo = '"~Val(b4)~"' ")
   SQL.NEW
   message(' Actualizando Especie Cupon ')

   *---------- Actualiza Tabla AgendaCupon ------------*
   SQL.ADD(" UPDATE "~DBO~".AGENDACUPONES SET ")
   SQL.ADD("        FechaPago = '"~IdxDate(Dialogo.Fecha2)~"', ")
   SQL.ADD("        VTeoricoAnt = "~FSTR(Val(e:2),1,8)~", ")
   SQL.ADD("        PrecioCupon     = "~FSTR(Val(f:3),1,8)~", ")
   SQL.ADD("        FechaProceso    = '"~IdxDate(Fsys)~"', ")
   SQL.ADD("        Estado    = 'PRO', ")
   SQL.ADD("        PorAmCapital = "~FSTR(Val(k:2),1,8)~", ")
   SQL.ADD("        PorRenta     = "~FSTR(Val(l:2),1,8)~", ")
   SQL.ADD("        TNA     = "~FSTR(Val(l:3),1,8)~", ")
   SQL.ADD("        PorAmIntCap  = "~FSTR(Val(m:2),1,8)~", ")
   SQL.ADD("        TasaCapInt   = "~FSTR(Val(ci1),1,8)~", ")
   SQL.ADD("        PorPIK       = "~FSTR(Val(PR:18),1,8)~", ")
   SQL.ADD("        IntsCapitalizados  = "~FSTR(Val(ci2),1,8)~", ")
   If Val(k:2)=0
      *- Es renta
      SQL.ADD("        TipoCupon = 'REN' ")
   Else
      If Val(l:2)=0
         *- es amort  
         SQL.ADD("       TipoCupon = 'AMO' ")
      Else
         *- es renta y amo
         SQL.ADD("        TipoCupon = 'RYA' ")
      Endif
   Endif 
   SQL.ADD(" WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Val(c2),1,0)~"' ")
   SQL.NEW
   Message(' Actualizando Agenda de Cupones ')

   IF Val(CK:3) = 1 Y Val(PR:17) > 0
       ***---Sumo Tasa Penalty en cupones siguientes en ambos esquemas
       SQL.ADD(" Update "~DBO~".AGENDACUPONES ")
       SQL.ADD(" Set PorRenta = PorRenta + "~Fstr(Val(PR:17), 0, 8))
       SQL.ADD(" Where Especie = '"~Dialogo.Especie1~"' ")
       SQL.ADD(" AND NrCupon > '"~Fstr(Val(C:2), 0, 0)~"' ")
       SQL.NEW
   ENDIF

   SQL.EXEC
Proximo
