HojaVisible(NO)
creardialogo
radio2:'|Impresion|Reimpresion';;;;;;;;;;0
radio1:'|Por Operacion|Por Fecha';;;;;;;;;;0
nroperacion1:'Nro.Operacion';;;;dialogo.radio1 = 0;dialogo.radio1 = 0;;;;;;;;;"TipoOp In ('MMPF','MMPFCE') and FechaVto >= '"~IdxDate(FSys())~"'  "~iif (dialogo.radio2 = 0, " and (CantImpresiones1 is null or CantImpresiones1 = 0) ", " and CantImpresiones1 >= 1  ")
fecha1:'Fecha Conc.';;;;dialogo.radio1 = 1;dialogo.radio1 = 1;NoVacio(dialogo.fecha1);'Debe Ingresar un Fecha de Concertacion';NO;FSys();;;;;;

findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio2 = 0)
Act(aa1, ' IMPRESION DE COMPROBANTES ')


Sqladd("  Select O.NrOperacion, O.Cliente1, O.TipoOp, O.Especie, O.FechaOp, O.FechaVto,  ")
Sqladd("  O.Plazo, O.Cantidad, O.Precio1,O.TotalIntereses, O.TotalBrutoCli1              ")
Sqladd("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B                          ")
Sqladd("  where O.NrOperacion = B.NrOperacion                                            ")
Sqladd("  and   O.TipoOp In ('MMPF','MMPFCE')                                                     ")
Sqladd("  and   B.NrBit = 10 and Valor = '1'                                             ")

if (dialogo.radio1 = 1)
Sqladd(" and   O.FechaOp = '"~IdxDate(dialogo.fecha1)~"'                              ")
else
Sqladd("  and   O.FechaOp <= '"~IdxDate(FSys())~"'                                      ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("  and   O.NrOperacion='"~dialogo.nroperacion1~"'                              ")
endif
endif

Sqladd("  and  (O.FechaVto >= '"~IdxDate(FSys())~"'                                        ")
Sqladd("   or  (O.FechaVto < '"~IdxDate(FSys())~"'                                         ")
Sqladd("  and  O.NrOperacion Not In (Select M.NrOperacion from "~Dbo()~".MOVEJECUTADOS M where M.NrOperacion = '"~dialogo.nroperacion1~"' AND M.NrSaldo = 1 and M.FechaMov = O.FechaVto))) ")
Sqladd("  and (O.CantImpresiones1 is null or O.CantImpresiones1 = 0)  ")

else
Act(aa1, ' <<<< REIMPRESION DE COMPROBANTES >>>> ')


Sqladd(" Select O.NrOperacion, O.Cliente1, O.TipoOp, O.Especie, O.FechaOp, O.FechaVto,  ")
Sqladd(" O.Plazo, O.Cantidad, O.Precio1,O.TotalIntereses, O.TotalBrutoCli1              ")
Sqladd(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B                          ")
Sqladd(" where O.NrOperacion = B.NrOperacion                                            ")
Sqladd(" and   O.TipoOp In ('MMPF','MMPFCE')                                              ")
Sqladd(" and   B.NrBit = 10 and Valor = '1'                                             ")

if (dialogo.radio1 = 1)
Sqladd(" and   O.FechaOp = '"~IdxDate(dialogo.fecha1)~"'                              ")
else
Sqladd("  and   O.FechaOp <= '"~IdxDate(FSys())~"'                                      ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("  and   O.NrOperacion='"~dialogo.nroperacion1~"'                              ")
endif
endif

Sqladd(" and  (O.FechaVto >= '"~IdxDate(FSys())~"'                                        ")
Sqladd("   or (O.FechaVto < '"~IdxDate(FSys())~"'                                         ")
Sqladd("  and  O.NrOperacion Not In (Select M.NrOperacion from "~Dbo()~".MOVEJECUTADOS M  ")
Sqladd("                             where M.NrOperacion = '"~dialogo.nroperacion1~"'   ")
Sqladd("                               AND M.NrSaldo = 1 and M.FechaMov = O.FechaVto))) ")
Sqladd("  and O.CantImpresiones1 >= 1   ")


endif

SetFilaActual(2)
Acn(aa3, 0)

recorrer sql
Acn(aa3, 1)
Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Fbn()['Cliente1'])
Act(c:fac, Fbn()['TipoOp'])
Act(d:fac, Fbn()['Especie'])
Acd(e:fac, Fbn()['FechaOp'])
Acd(f:fac, Fbn()['FechaVto'])
Acn(g:fac, Fbn()['Plazo'])
Acn(h:fac, Fbn()['Cantidad'])
Acn(i:fac, Fbn()['Precio1'])
Acn(j:fac, Fbn()['TotalIntereses'])
Acn(k:fac, Fbn()['TotalBrutoCli1'])
Acn(x:fac, 1)

proximo

if (Val(aa3) = 0)
Cancelar('No hay operaciones para imprimir ')
endif


crearlistbox;'Arial,8,';Val(aa1)
'Imp?';x:3..x:fac;SI;;;30;check
'NrOperacion';a:3..a:fac;NO;;;70;string;;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Cliente';b:3..b:fac;NO;;;90;string;;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Tipo Op';c:3..c:fac;NO;;;60;string;;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Especie';d:3..d:fac;NO;;;60;string;;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Fecha Op';e:3..e:fac;NO;;;70;fecha;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Fecha Vto';f:3..f:fac;NO;;;70;fecha;iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))

'Plazo';g:3..g:fac;NO;;;40;numero;'###';iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Cantidad';h:3..h:fac;NO;;;80;numero;'##,###,###.##';iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Tasa';i:3..i:fac;NO;;;80;numero;'##.######';iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Interes';j:3..j:fac;NO;;;80;numero;'##,###,###.##';iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))
'Monto';k:3..k:fac;NO;;;80;numero;'##,###,###.##';iif (dialogo.radio2 = 0, RGB(181, 238, 190), RGB(250, 154, 154))

finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 3, Fac()
if (Val(x:&i) = 1)
Ejecutarevento('CONCER', 'nroperacion1', Val(a:&i), 'radio4', dialogo.radio2)
