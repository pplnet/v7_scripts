*--INSOPE - Insert de una Operacion Copiando datos de Otra
CrearDialogo
   NrOperacion1:'Op  Nueva';;;;;;;;;;
   NrOperacion2:'Op. Original'
FinDialogo

If not Ok
 Cancelar
EndIf

Message('Creando Operacion Nro '~Dialogo.NrOperacion1~' ....' )

SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
