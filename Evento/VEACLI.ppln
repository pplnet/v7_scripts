if (not Eqstr(BuscarCampo('CLIENTES', 'Codigo', 'Codigo', 'VINCULADOS'), 'VINCULADOS'))
Sqladd(" INSERT INTO "~Dbo()~".CLIENTES ")
Sqladd(" (Jerarquia,Codigo,RazonSocial,Status) ")
Sqladd(" VALUES ")
Sqladd(" ('003000000000000','VINCULADOS','Empresas Vinculadas','HAB') ")
Sqlnew()
Sqlexec()
endif

let(&maxjerarquia, Query("SELECT Max(Jerarquia) FROM "~Dbo()~".CLIENTES WHERE dbo.DesciendeDeCliente(Codigo,'VINCULADOS') = 1"))

let(&jerarquiamaxima, _int(Copy(&maxjerarquia, 4, 3)) + 1)

Sqladd(" SELECT Codigo, Descripcion ")
Sqladd(" FROM "~Dbo()~".VEHICULOS ")
Sqladd(" WHERE Codigo Not in (SELECT Codigo FROM "~Dbo()~".CLIENTES) ")
Sqladd(" ORDER BY Codigo ")
recorrer sql
let(&codigo, Fbn('Codigo'))
let(&razonsocial, Fbn('Descripcion'))
if (&jerarquiamaxima < 10)
let(&jerarquia, '00300'~FStr(&jerarquiamaxima, 0, 0)~'000000000')
else
if (&jerarquiamaxima < 100)
let(&jerarquia, '0030'~FStr(&jerarquiamaxima, 0, 0)~'000000000')
else
let(&jerarquia, '003'~FStr(&jerarquiamaxima, 0, 0)~'000000000')
endif
endif

Sqladd(" INSERT INTO "~Dbo()~".CLIENTES ")
Sqladd(" (Jerarquia,Codigo,RazonSocial,Status) ")
Sqladd(" VALUES ")
Sqladd(" ('"~&jerarquia~"','"~&codigo~"','"~&razonsocial~"','HAB') ")
Sqlnew()
Sqlexec()
let(&jerarquiamaxima, &jerarquiamaxima + 1)
proximo
