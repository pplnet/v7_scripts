  ***---Realizado en Moneda Local
  ***---ACN(RZ:2, fbn('CRMLDAY') + fbn('FTMLDAY') + fbn('RTMLDAY'))
  ACN(RZ:2, fbn('CRMLDAY') + fbn('FTMLDAY'))
  *acaACN(RZ:2, fbn('CRMLDAY') + fbn('RTMLDAY'))
  ***---Interes Realizado en Moneda Local
  ***---ACN(IZ:2, fbn('IRMLDAY'))
  ACN(IZ:2, fbn('YRMLDAY'))
  *ACN(IZ:2, -fbn('INMLDAY'))
  ***---RTMLDAY esta dentro de KRMLDAY
  ***---DKMLDAY es DC NO Realizada de la Posicion
  ***---DC Interes Realizado + DC Realizada de la Posicion + DC Revaluo Realizado
  ***---ACN(DZ:2, fbn('CIMLDAY') + fbn('KRMLDAY') + fbn('RTMLDAY'))
  ***---ACN(DZ:2, fbn('CIMLDAY') + fbn('XRMLDAY'))
  ACN(DZ:2, fbn('XRMLDAY'))
  ***---Realizado en Moneda Grupo
  ***---ACN(RZ:3, fbn('CRMCDAY') + fbn('FTMCDAY') + fbn('RTMCDAY'))
  ACN(RZ:3, fbn('CRMCDAY') + fbn('FTMCDAY'))
  *acaACN(RZ:3, fbn('CRMCDAY') + fbn('RTMCDAY'))
  ***---Interes Realizado en Moneda Grupo
  ***---ACN(IZ:3, fbn('IRMCDAY'))
  ACN(IZ:3, fbn('YRMCDAY'))
  *ACN(IZ:3, -fbn('INMCDAY'))
  ***---DC Interes Realizado + DC Realizada de la Posicion
  ***---ACN(DZ:3, fbn('CIMCDAY') + fbn('KRMCDAY') + fbn('RTMCDAY'))
  ***---ACN(DZ:3, fbn('CIMCDAY') + fbn('XRMCDAY'))
  ACN(DZ:3, fbn('XRMCDAY'))
  ***---Realizado en Moneda Emision
  ACN(RZ:4, fbn('CRMEDAY'))
  ***---Interes Realizado en Moneda Emision
  ***---ACN(IZ:4, fbn('IRMEDAY'))
  ACN(IZ:4, fbn('YRMEDAY'))
  *ACN(IZ:4, -fbn('INMEDAY'))
  ACT(ES:1, fbn('Especie'))
  ACT(VH:1, fbn('Vehiculo'))
  SQL.ADD(" Select MA.Codigo From "~DBO~".MODELOSASIENTO MA ")
  SQL.ADD(" Where MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIRZ'))~") ")
  Recorrer SQL
     DFA
     Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
     ***---ACD(FV:1, Dialogo.Fecha1)
     **//(.'FECHAVALOR'.)
     ACT(MD:1, fbn('Codigo'))
     SQL.ADD(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
     SQL.ADD(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, '' Cliente1, V.Codigo Vehiculo1, ")
     SQL.ADD(" "~Fstr(Abs(Val(CT:1)), 0, 0)~" Cantidad, E.Alias8, V.Alias4 ")
     SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
     SQL.ADD(" Where E.Codigo = '"~Val(ES:1)~"' ")
     SQL.ADD(" AND V.Codigo = '"~Val(VH:1)~"' ")
     Recorrer SQL
        DFA
        ACN(CK:1, 0)
        IF Dialogo.Fecha1 < Fsys
           ACN(CK:1, 1)
           IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~fbn('Especie')~"' AND A.Modelo = '"~Val(MD:1)~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(FV:1))~"' AND A.Vehiculo = '"~fbn('Vehiculo')~"' "))
              ACN(CK:1, 0)
           ENDIF
        ENDIF
        IF Val(CK:1) = 0
           SQL.GenerarAsientoOp(Val(MD:1), '','','',810,Val(FV:1),fbn('Vehiculo'),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
           SQL.EXEC
        ENDIF
     Proximo
  Proximo
*  ENDIF
Proximo
