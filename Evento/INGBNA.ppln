creardialogo
especie1: 'Moneda';2;1;;SI;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'MONEDA');'Debe ingresar una moneda.';SI;Var('MONEEXTR')
precio1:'Precio Compra';;;;;;dialogo.precio1 > 0;'Precio compra invalido';NO;
precio2:'Precio Venta';;;;;;dialogo.precio2 > 0;'Precio venta invalido';NO;
fecha1:'Fecha';1;1;;SI;;dialogo.fecha1 >= FSys();'La fecha es anterior a la del Sistema.';SI;FSys()
check1:'Procesa';1;2;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)
Act(a:fac, dialogo.especie1)
Acd(b:fac, dialogo.fecha1)
Acn(c:fac, dialogo.precio1)
Acn(d:fac, dialogo.precio2)

if (Query("SELECT 1 FROM "~Dbo()~".CIERREBNA WHERE Especie='"~Val(a:fac)~"' and Fecha='"~IdxDate(Val(b:fac))~"' ") = 1)
Act(e:fac, 'Update')
if (dialogo.check1 = 1)
Sqladd("UPDATE "~Dbo()~".CIERREBNA SET ")
Sqladd("       PrecioCompra    = "~FStr(Val(c:fac), 1, 8)~", ")
Sqladd("       PrecioVenta     = "~FStr(Val(d:fac), 1, 8)~" ")
Sqladd(" WHERE Especie = '"~Val(a:fac)~"' ")
Sqladd("   and Fecha   = '"~IdxDate(Val(b:fac))~"' ")
Sqlnew()
Sqlexec()
endif
else
Act(e:fac, 'Insert')
if (dialogo.check1 = 1)
Sqladd("INSERT INTO "~Dbo()~".CIERREBNA ")
Sqladd("(Fecha, Especie, PrecioCompra, PrecioVenta, PorCada ")
Sqladd(" ) VALUES (' ")
Sqladd(" "~IdxDate(Val(b:fac))~"', ")
Sqladd(" '"~Val(a:fac)~"', ")
Sqladd(" "~FStr(Val(c:fac), 0, 8)~", ")
Sqladd(" "~FStr(Val(d:fac), 0, 8)~", ")
Sqladd(" 1 ")
Sqladd(" )")
Sqlnew()
Sqlexec()
endif
endif

if (Query("SELECT 1 FROM "~Dbo()~".COTIZACIONES WHERE Codigo='"~Val(a:fac)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(b:fac))~"' and Moneda='ARP' ") = 1)
Act(f:fac, 'Update')
if (dialogo.check1 = 1)
Sqladd("UPDATE "~Dbo()~".COTIZACIONES SET ")
Sqladd("       Precio1            = "~FStr(Val(d:fac), 1, 8)~", ")
Sqladd("       PrecioContable     = "~FStr(Val(d:fac), 1, 8)~", ")
Sqladd("       FechaActualizacion = "~SQLAhora()~" ")
Sqladd(" WHERE Codigo = '"~Val(a:fac)~"' ")
Sqladd("   and ISNULL(CallPut,'CON')='CON' ")
Sqladd("   and Fecha = '"~IdxDate(Val(b:fac))~"' ")
Sqladd("   and Moneda = 'ARP' ")
Sqlnew()
Sqlexec()
endif
else
Act(f:fac, 'Insert')
if (dialogo.check1 = 1)
Sqladd("INSERT INTO "~Dbo()~".COTIZACIONES ")
Sqladd("(Fecha, Codigo, CallPut, Precio1, PrecioContable, Moneda, FechaActualizacion ")
Sqladd(" ) VALUES (' ")
Sqladd(" "~IdxDate(Val(b:fac))~"', ")
Sqladd(" '"~Val(a:fac)~"', ")
Sqladd(" 'CON', ")
Sqladd(" "~FStr(Val(d:fac), 0, 8)~", ")
Sqladd(" "~FStr(Val(d:fac), 0, 8)~", ")
Sqladd(" 'ARP', ")
Sqladd(" "~SQLAhora()~" ")
Sqladd(" )")
Sqlnew()
Sqlexec()
endif
endif


