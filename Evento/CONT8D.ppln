Sqladd(" Select O.NrOperacion, O.Precio1, O.Cantidad, O.Vehiculo1, O.FechaOp ")
Sqladd("  ")
Sqladd(" From "~Dbo()~".OPERACIONES O ")
Sqladd(" Where Fecha1 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND NrSaldo IN ("~Val(y:2)~") ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") OR Vehiculo1 is null OR Vehiculo1 = '' OR Vehiculo1 = ' ' )")
else 
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" AND Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
recorrer sql
