creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 > 0;'Fecha Invalida';NO;FSys()
nrtrans1: 'Nro.Voucher';;;;;;Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'OCTDEP|OCTRET');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('OCTDEP','OCTRET') and Fecha1 = '"~IdxDate(dialogo.fecha1)~"' and RB1 = '1' ";
check1:'Procesa';2;2;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

Act(a:1, 'Cantidad')
Act(a:2, 'Numero')
Act(a:3, 'Tipo')
Act(a:4, 'Fecha1')
Act(a:5, 'Fecha2')
Act(a:6, 'Paso')
Act(a:7, 'Cantidad')
Act(a:8, 'RB1')
Act(a:9, 'RB2')
Act(a:10, 'Max.Paso')

Sqladd("Select * from "~Dbo()~".TRANSACCIONES2")
Sqladd("where NrTrans='"~dialogo.nrtrans1~"' ")
recorrer sql
Dfa()
Scn(b:1, 1)
Act(b:2, Fbn('NrTrans'))
Act(b:3, Fbn('TipoTr2'))
Acd(b:4, Fbn('Fecha1'))
Acd(b:5, Fbn('Fecha2'))
Acn(b:6, Fbn('Precio5'))
Acn(b:7, Fbn('Cantidad1'))
Acn(b:8, Fbn('RB1'))
Acn(b:9, Fbn('RB2'))
proximo
if (Val(b:1) > 1)
Acn(x1, 1)
if (dialogo.check1 = 1)
Cancelar('Mas de una transaccion '~dialogo.nrtrans1)
else
Messagebox('Mas de una transaccion '~dialogo.nrtrans1)
endif
endif
Acn(b:10, Query("Select Max(Precio5) from "~Dbo()~".TRANSACCIONES2 where TipoTr2 in ('OCTDEP','OCTRET') and Fecha1 = '"~IdxDate(Val(b:4))~"' "))

if (Val(b:6) <> Val(b:10))
Acn(x1, 1)
if (dialogo.check1 = 1)
Cancelar('La transaccion '~dialogo.nrtrans1~' no corresponde al ultimo paso')
else
Messagebox('La transaccion '~dialogo.nrtrans1~' no corresponde al ultimo paso')
endif
endif
if (Val(b:8) <> 1)
Acn(x1, 1)
if (dialogo.check1 = 1)
Cancelar('La transaccion '~dialogo.nrtrans1~' no es manual')
else
Messagebox('La transaccion '~dialogo.nrtrans1~' no es manual')
endif
endif

if (Val(x1) = 0)
if (dialogo.check1 = 1)
Message('Anula Transaccion '~dialogo.nrtrans1)
Sqladd("Delete "~Dbo()~".TRANSACCIONES2")
Sqladd("where NrTrans='"~dialogo.nrtrans1~"' ")
Sqlnew()
Sqlexec()
else
Messagebox('Anula Transaccion '~dialogo.nrtrans1)
endif
endif

