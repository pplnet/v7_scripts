creardialogo
nroperacion1:'Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Operacion Incorrecta';NO;;;;;;
string1:'Excepcion';;;;;;

findialogo

if (not ok)
Cancelar()
endif

Sqladd("SELECT * FROM "~Dbo()~".EXCEPCIONES Where NrOperacion='"~dialogo.nroperacion1~"' ")
if (NoVacio(dialogo.string1))
Sqladd("   and Tipo in ("~Pipe2Comillas(dialogo.string1)~") ")
endif
recorrer sql
Act(a1, Fbn()['Autorizado']~" "~UsuarioActivo())
proximo

Sqladd("Update "~Dbo()~".EXCEPCIONES ")
Sqladd("   Set Autorizado = '"~Val(a1)~"' ")
Sqladd(" Where NrOperacion='"~dialogo.nroperacion1~"' ")
Sqladd("   and Autorizado is Null ")
if (NoVacio(dialogo.string1))
Sqladd("   and Tipo in ("~Pipe2Comillas(dialogo.string1)~") ")
endif

Sqlnew()
