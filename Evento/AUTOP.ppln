creardialogo
nroperacion1:'Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Operacion Incorrecta';NO;;;;;;
string1:'Excepcion';;;;;;
findialogo

if (not ok)
Cancelar()
endif

sql.add("SELECT * FROM "~Dbo()~".EXCEPCIONES Where NrOperacion='"~dialogo.nroperacion1~"' ")
if (NoVacio(dialogo.string1))
sql.add("   and Tipo in ("~pipe2comillas(dialogo.string1)~") ")
