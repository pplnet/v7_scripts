recorrer sql
Act(a1, Fbn()['Autorizado']~" "~UsuarioActivo())
proximo

sql.add("Update "~Dbo()~".EXCEPCIONES ")
sql.add("   Set Autorizado = '"~Val(a1)~"' ")
sql.add(" Where NrOperacion='"~dialogo.nroperacion1~"' ")
sql.add("   and Autorizado is Null ")
if (NoVacio(dialogo.string1))
sql.add("   and Tipo in ("~pipe2comillas(dialogo.string1)~") ")
endif

sql.new
sql.exec


