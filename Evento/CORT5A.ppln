sql.add("SELECT O.NrOperacion, O.TipoOp, O.Especie, O.FechaEj, O.PrecioEj, O.Cliente1, O.Mercado, O.Cantidad, O.Cotizacion2 ")
sql.add("from "~Dbo()~".OPERACIONES O ")
sql.add("where Vehiculo1 = '"~dialogo.vehiculo1~"' ")
sql.add("and   Especie = '"~dialogo.especie3~"' ")
sql.add("and   FechaEj >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("and  (CB6 is Null or CB6 = '0' ) ")
