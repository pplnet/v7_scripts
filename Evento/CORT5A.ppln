sql.add(" and   O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" and (O.TipoOp In ('CFTC','CFTP','VFTC','VFTP') ")
sql.add("  or (O.TipoOp In ('CTE','VTE') and CB6 = '1') ")
sql.add("  or (O.TipoOp In ('CTP','VTP') and CB10 = '1')) ")
sql.add(" and  RB4 = '1'  ")
sql.add(" order by O.TipoOp ")

