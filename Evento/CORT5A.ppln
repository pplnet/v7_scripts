sql.add("Update "~Dbo()~".OPCIONES ")
sql.add("Set    Precio1  = Precio2, ")
sql.add("       Precio2  = 0 ")
sql.add("where  Precio1  = "~FStr(Fbn('PrecioEj'), 0, 7)~" ")
sql.add("and    Codigo   = '"~Fbn('Especie')~"' ")
sql.add("and    Fecha    = '"~IdxDate(Fbn('FechaEj'))~"' ")
if (Incluido(Fbn('TipoOp'), 'CCP|CCE|VCE|VCP'))
sql.add("and CallPut  = 'CAL' ")
else
sql.add("and CallPut  = 'PUT' ")
endif
sql.new
endif

