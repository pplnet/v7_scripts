Sqladd(" Select * from "~Dbo()~".OPERACIONESBITS Where ( NrBit = 150 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
Sqladd(" Select NrOrden,TipoOrden,FechaEnvioMAE,Direccion,NroAltaMAE from "~Dbo()~".ORDENES Where NrOrden = '"~Fbn()['NrOperacion']~"' ")
recorrer sql
Dfa()
Act(b:fac, Fbn()['TipoOrden'])
if (Incluido(Val(b:fac), 'TMANIF|OTIC|OTIV'))
Acn(c:fac, Fbn()['Direccion'])
Act(d:fac, Fbn()['NroAltaMAE'])
Act(e:fac, 'Pasa a 160')
if (dialogo.check1 = 1)
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 0, 'entero1', 150, 'entero2', 160)
endif
endif
proximo
