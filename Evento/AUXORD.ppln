SetFilaActual(Fac() + 2)
Act(a:fac, 'NrOrden')
Act(b:fac, 'TipoOrden')
Act(c:fac, 'FechaEnvio')
Act(d:fac, 'Ahora')
Act(e:fac, 'Env + Espera')
Act(f:fac, 'Direccion')
Act(g:fac, 'NroAlta')
Act(h:fac, 'Excepcion')
Act(i:fac, 'Leyenda')
Act(j:fac, 'Accion')

Sqladd(" Select NrOperacion from "~Dbo()~".OPERACIONESBITS Where ( NrBit = 162 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
Sqladd(" Select NrOrden,TipoOrden,FechaEnvioMAE,Direccion,NroAltaMAE from "~Dbo()~".ORDENES Where NrOrden = '"~Fbn()['NrOperacion']~"' ")
recorrer sql
Dfa()
Act(b:fac, Fbn()['TipoOrden'])
if (Incluido(Fbn()['TipoOrden'], 'TMANIF|OTIC|OTIV'))
Act(c:fac, Hora(Fbn()['FechaEnvioMAE']))
Acn(d:fac, Num(Copy(Hora(SQLAhora()), 1, 2)) * 3600 + Num(Copy(Hora(SQLAhora()), 4, 2)) * 60 + Num(Copy(Hora(SQLAhora()), 7, 2)))
Acn(e:fac, Num(Copy(Val(c:fac), 1, 2)) * 3600 + Num(Copy(Val(c:fac), 4, 2)) * 60 + Num(Copy(Val(c:fac), 7, 2)) + (Var('ESPERA') * 60))
if (Num(Copy(Hora(SQLAhora()), 1, 2)) * 3600 + Num(Copy(Hora(SQLAhora()), 4, 2)) * 60 + Num(Copy(Hora(SQLAhora()), 7, 2)) > Num(Copy(Val(c:fac), 1, 2)) * 3600 + Num(Copy(Val(c:fac), 4, 2)) * 60 + Num(Copy(Val(c:fac), 7, 2)) + (Var('ESPERA') * 60))
Acn(f:fac, Fbn()['Direccion'])
Act(g:fac, Fbn()['NroAltaMAE'])
if (Fbn('Direccion') = 1)
Act(h:fac, 'ERRORBAJA')
Act(i:fac, 'MAE no respondio informacion de Baja')
else 
if (Vacio(Fbn('NroAltaMAE')))
Act(h:fac, 'ERRORALTA')
Act(i:fac, 'MAE no respondio informacion de Alta')
else 
Act(h:fac, 'ERRORMODI')
Act(i:fac, 'MAE no respondio informacion de Modificacion')
endif
endif
Act(j:fac, 'Pasa a 169')
if (dialogo.check1 = 1)
Sqladd(" Insert into "~Dbo()~".EXCEPCIONES ")
Sqladd(" (NrOperacion, Fecha, Tipo, Descripcion ) Values ")
Sqladd(" ('"~Fbn()['NrOrden']~"', "~SQLAhora()~" , '"~Val(h:fac)~"', '"~Val(i:fac)~"' ) ")
Sqlnew()
Sqlexec()
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 1, 'entero1', 162, 'entero2', 169)
endif
endif
endif
