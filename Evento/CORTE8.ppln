MostrarCuadroDeMensajes()
creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO') y not DesciendeDeEspecie(dialogo.especie1, 'CUPON');'Especie Invalida';NO;;;;;;"Status = 'HAB' "
check1:'PIKs';1;2;;NO;;;;;;iif (Eqstr(BuscarCampo('ESPECIES', 'PIKs', 'Codigo', dialogo.especie1), 'NO'), 0, 1);
fecha1:'F.Corte';2;1;;NO;;dialogo.fecha1 <> 0 y dialogo.fecha1 >= FSys();'Fecha de Corte Invalida';NO;ProxCupon2(dialogo.especie1, FSys());ProxCupon2(dialogo.especie1, FSys())
precio1:'TasaPIK%';2;2;;;dialogo.check1 = 1;dialogo.check1 = 0 o dialogo.precio1 > 0;'Tasa de Pikeo Invalida';NO;;;;;'###.########'
entero1:'Nr.Cupon';3;1;;NO;;dialogo.entero1 >= 0;'Nro de Cupon Invalido';NO;0;BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1)
precio3:'TasaIntPIK%';3;2;;;dialogo.check1 = 1;dialogo.check1 = 0 o dialogo.precio3 > 0;'Tasa de Interes Pik Invalida';NO;;;;;'###.########'
precio2:'Tasa%';5;1;;;;dialogo.precio2 > 0;'La Tasa de Interes debe ser Positiva';NO;;;;;'###.########'
precio4:'Spread%';5;2;;;Query(" Select 1 From "~Dbo()~".ESPECIES Where Codigo = '"~dialogo.especie1~"' AND TipoTasa Is Not Null AND TipoTasa <> 'FIJA' ") = 1;dialogo.precio4 > 0 o Query(" Select 1 From "~Dbo()~".ESPECIES Where Codigo = '"~dialogo.especie1~"' AND TipoTasa Is Not Null AND TipoTasa <> 'FIJA' ") <> 1;'El Spread debe ser Positivo';NO;;Query(" Select Spread From "~Dbo()~".ESPECIES Where Codigo = '"~dialogo.especie1~"' ");;;'###.########'
findialogo

if (not ok)
Cancelar()
endif

Act(st1, Query("SELECT SType FROM "~Dbo()~".ESPECIES WHERE Codigo='"~dialogo.especie1~"' "))

Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET    TasaIntAnterior = TasaIntVigente, ")
Sqladd("       TasaIntVigente = "~FStr((dialogo.precio2 + dialogo.precio4) / 100, 1, 8)~", ")
Sqladd("       TasaPIKsVigente = "~FStr(dialogo.precio1 / 100, 1, 8)~", ")
Sqladd("       TasaIntPiksVigente = "~FStr(dialogo.precio3 / 100, 1, 8)~", ")
Sqladd("       FechaCambioTasa = '"~IdxDate(FSys())~"' ")
if (not Eqstr(Mayusculas2(Val(st1)), 'FIJA'))
Sqladd(",       Alias4 = 'TASA_REAL'  ")
endif
if (dialogo.precio4 > 0)
Sqladd(",       Spread = "~FStr(dialogo.precio4, 1, 8)~" ")
endif
Sqladd("WHERE Codigo = '"~dialogo.especie1~"' ")
Sqlnew()
Message(' Actualizando Especie ')


Sqladd(" UPDATE "~Dbo()~".AGENDACUPONES SET ")
Sqladd(" PorRenta  = "~FStr((dialogo.precio2 + dialogo.precio4), 1, 8)~", ")
Sqladd(" PorRentaAnterior  = PorRenta, ")
Sqladd(" FechaCambioTasa = '"~IdxDate(FSys())~"'  ")
Sqladd(" WHERE Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' ")
Sqladd("  AND Esquema = '0' ")
Sqlnew()

if (dialogo.check1 = 1)
Sqladd(" UPDATE "~Dbo()~".AGENDACUPONES SET ")
Sqladd(" PorRenta  = "~FStr(dialogo.precio3, 1, 8)~", ")
Sqladd(" PorRentaAnterior  = PorRenta, ")
Sqladd(" PorPIK = "~FStr(dialogo.precio1, 1, 8)~", ")
Sqladd(" FechaCambioTasa = '"~IdxDate(FSys())~"'  ")
Sqladd(" WHERE Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' ")
Sqladd("  AND Esquema = '1' ")
endif
Sqlnew()


Message(' Actualizando Agenda de Cupones ')
Sqlexec()

