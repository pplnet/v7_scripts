Cancelar('No existen operaciones con estas caracteristicas para Cambiarles la TCI!!!')
endif

recorrer&i 1, 20

crearlistbox;'Arial,8,';'Cambio de TCI Operaciones VENCIDAS Concertadas del '~Fecha(dialogo.fecha3)~' al '~Fecha(dialogo.fecha4)
'OK';ab1..ab:fac;SI;;;30;check;RGB(220, 220, 193)
'TipoOp';c1..c:fac;NO;;;45;string;;RGB(180, 180, 193)
'Operacion';g1..g:fac;NO;;;60;string;;RGB(180, 180, 193)
'Cliente';a1..a:fac;NO;;;70;string;;RGB(180, 180, 193)
'RazonSocial';w1..w:fac;NO;;;100;string;;RGB(180, 180, 193)
