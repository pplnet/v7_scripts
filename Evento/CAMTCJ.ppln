fecha4:'H.Concert';;;;;;dialogo.fecha4 <= FSys();'Fecha_Hasta no es Valida';NO;FSys();
cliente1:'Cliente'
especie1:'Moneda';;;;;;;;;;;SQLSet("Select Codigo From "~Dbo()~".ESPECIES Where Jerarquia Like '001%' and Codigo Not In ("~Pipe2Comillas(Var('JERMON'))~") order by Codigo ")
tipoop1:'TipoOper';;;;;;Vacio(dialogo.tipoop1) o Incluido(dialogo.tipoop1, Val(lo: 1)~Val(lo: 2));'TipoOp Erronea!!!';NO;;;SQLSet("Select Codigo From "~Dbo()~".TIPOSOPERACION Where Codigo In ("~Pipe2Comillas(Val(lo: 1)~Val(lo: 2))~") ");;;
nroperacion1: 'Operacion';;;;;;;;;;;;;;iif (Vacio(dialogo.tipoop1), " TipoOp In ("~Pipe2Comillas(Val(lo: 1)~Val(lo: 2))~") ", " TipoOp = '"~dialogo.tipoop1~"' ")~" and (RB6 Is Null or RB6='0') and FechaOp <= "~IdxDate2(dialogo.fecha3)~iif (Vacio(dialogo.especie1), " ", " and Especie = '"~dialogo.especie1~"' ")~iif (Vacio(dialogo.cliente1), " ", " and Cliente1 = '"~dialogo.cliente1~"' ")

findialogo


if (not ok)
Cancelar()
endif

Message('Recuperando Operaciones...')
Sqladd("Select NrOperacion, 1 NrCuota, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, ")
Sqladd("       TasaBase,Precio4,Spread,Precio2,Vehiculo1, Cuenta3, TotalBrutoCli1,Observac4,")
Sqladd("       Precio3, FechaVto, TablaFeriados1,RB6,CB9,TipoCambio2,TipoCambio3,")
Sqladd("       OficialCuenta,Plazo2,TipoTasa,Ley10,LineaPrestamo,MB3,CB6 ")
Sqladd("  From "~Dbo()~".OPERACIONES ")
Sqladd(" Where FechaOp >= "~IdxDate2(dialogo.fecha3))
Sqladd("   and FechaOp <= "~IdxDate2(dialogo.fecha4))
Sqladd("   and NVL(RB6,0) Not In (0,1,2,7)  ")
if (NoVacio(dialogo.especie1))
Sqladd(" and Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" and Cliente1 = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.tipoop1))
Sqladd(" and TipoOp = '"~dialogo.tipoop1~"' ")
endif
Sqladd(" and TipoOp In ("~Pipe2Comillas(Val(lo:1))~") ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and NrOperacion = '"~dialogo.nroperacion1~"' ")
endif



Sqladd(" Union all ")

Sqladd("Select O.NrOperacion,CU.NrCuota, O.Cliente1, O.Especie, O.TipoOp, CU.Cantidad12 Cantidad, CU.Cantidad28 Precio1, CU.Plazo1 Plazo, CU.Fecha9 FechaOp, ")
Sqladd("       CU.Cantidad31 TasaBase,O.Precio4,O.Spread,O.Precio2,O.Vehiculo1, O.Cuenta3, O.TotalBrutoCli1,O.Observac4,")
Sqladd("       O.Precio3, CU.Fecha2 FechaVto, O.TablaFeriados1,O.RB6,O.CB9,O.TipoCambio2,O.TipoCambio3,")
Sqladd("       O.OficialCuenta,O.Plazo2,O.TipoTasa,O.Ley10,O.LineaPrestamo,O.MB3,O.CB6 ")
Sqladd("  From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTASPRESTAMO CU ")
Sqladd(" Where CU.Fecha9 >= "~IdxDate2(dialogo.fecha3))
Sqladd("   and CU.Fecha9 <= "~IdxDate2(dialogo.fecha4))
Sqladd("   and O.NrOperacion = CU.NrOperacion ")
Sqladd("   and (NVL(O.RB6,0) Not In (0,1,2,7) or NVL(CU.Check8,0)=1) ")
if (NoVacio(dialogo.especie1))
Sqladd(" and O.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd(" and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.tipoop1))
Sqladd(" and O.TipoOp = '"~dialogo.tipoop1~"' ")
endif
Sqladd(" and O.TipoOp In ("~Pipe2Comillas(Val(lo:2))~") ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif


Sqladd(" Order by 3, 4, 5, 1, 2 ")

Acn(az1, 0)
Acd(q1, FSys())

recorrer sql

Message('...'~Fbn()['NrOperacion'])

Acn(ab:fac, 0)
Act(a:fac, Fbn()['Cliente1'])
Act(w:fac, Copy(iif (NoVacio(Fbn()['Observac4']), Fbn()['Observac4'], BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1'))), 1, 15))
Act(b:fac, Fbn()['Especie'])
Act(c:fac, Fbn()['TipoOp'])
Acn(d:fac, iif (Eqstr(Fbn()['TipoOp'], 'MMDD'), Fbn()['TotalBrutoCli1'], Fbn()['Cantidad']))
Act(g:fac, Fbn()['NrOperacion'])
Acn(j:fac, Fbn()['Precio1'])
Acn(k:fac, Fbn()['Spread'])
Act(m:fac, iif (Vacio(Fbn()['LineaPrestamo']), '', Fbn()['LineaPrestamo']~'-'~Trim(BuscarCampo('LINEASPRESTAMO', 'Descripcion', 'Codigo', Fbn()['LineaPrestamo']))))
Acd(s:fac, Fbn()['FechaVto'])
Acd(t:fac, Fbn()['FechaOp'])
Act(v:fac, Fbn('Ley10'))
Act(av:fac, Fbn('Ley10'))
Acn(u:fac, Fbn()['TasaBase'])
Acn(au:fac, Fbn()['TasaBase'])
Acn(y:fac, iif (Eqstr(Fbn()['TipoOp'], 'MMDD'), Fbn()['Plazo2'], Fbn()['Plazo']))
Act(x:fac, iif (NoVacio(Fbn()['TipoTasa']), Fbn()['TipoTasa'], Var('TASAREFER')))
Acn(be:fac, Num(Fbn()['CB6']))
Act(jj:fac, Fbn('RB6'))
Acn(be:fac, iif (not Incluido(Fbn()['TipoOp'], 'MMCAUT|MMCT|MMCO|') y Fbn()['TasaBase'] = 0, 0, 1))

Acn(cu:fac, Fbn()['NrCuota'])
Acn(h:fac, Query("Select Sum(Cantidad2) From "~Dbo()~".CUOTAS Where NrOperacion='"~Fbn('NrOperacion')~"' "))
Acn(i:fac, Val(d:fac) - Val(h:fac))

Scn(az1, 1)
proximo


