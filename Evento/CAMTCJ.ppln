Sqladd("   Set Ley10 = '"~Val(v:&i)~"', ")
Sqladd("       TipoTasa = '"~Val(x:&i)~"', ")
Sqladd("       TasaBase = "~FStr(Val(u:&i), 0, 7)~",")
Sqladd("       CB6 = '"~FStr(Val(be:&i), 0)~"' ")
Sqladd(" Where NrOperacion = '"~Val(g:&i)~"' ")
Sqlnew()

if (not Eqstr(Val(v:&i), Val(av:&i)))
Sqladd("Insert into "~Dbo()~".EXCEPCIONES ")
Sqladd("       (NrOperacion, Tipo, Fecha, Descripcion) ")
Sqladd("Values ('"~Val(g:&i)~"','TCI',"~IdxDate2(FSys())~", ")
Sqladd("  'Autorizo Spread Negativo "~Copy(Val(v:&i), 0, 10)~"' ) ")
Sqlnew()
endif

if (Incluido(Val(c:&i), Val(lo:2)))
Sqladd("Update "~Dbo()~".CUOTASPRESTAMO Set Cantidad31 = "~FStr(Val(u:&i), 0, 7)~",Cantidad32 = "~FStr(Val(au:&i), 0, 7))
Sqladd(" Where NrOperacion = '"~Val(g:&i)~"' and NrCuota = "~FStr(Val(cu:&i), 0))
Sqlnew()
endif


