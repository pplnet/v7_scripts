CrearDialogo
   Fecha1     : 'Fecha Desde'               ;;;;;;;;;FSys
   Fecha2     : 'Fecha Hasta'               ;;;;;;;;;FSYs
FinDialogo

If Not Ok
   Cancelar
Endif

SetFilaActual(0)

ACN(qf:1, 0)

**- Selecciono las operaciones que se encuentran en la instancia BACKOFFICE y que estan dentro del rango de fechas
SQL.ADD("SELECT Distinct O.FechaOp,O.FechaVto,O.NrOperacion,O.Cantidad,O.Cliente1,O.Especie,O.TipoOp ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ,"~DBO~".OPERACIONESBITS OB ") 
SQL.ADD("WHERE  O.NrOperacion=OB.NrOperacion and OB.NrBit=20 and OB.Valor=1 ")
SQL.ADD("       and O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("ORDER BY O.NrOperacion,O.Cliente1 ")

MostrarCuadroDeMensajes
Message('Recuperando Informacion.')

Recorrer SQL
   ACT(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ACT(c:FAC, FBN['Cliente1'])
   ACT(d:FAC, FBN['Especie'])
   ACD(e:FAC, FBN['FechaOp'])
   ACD(f:FAC, FBN['FechaVto'])
   ACN(g:FAC, FBN['Cantidad'])
   ACN(q:FAC, 0)
   SCN(qf:1,  1)
Proximo

If Val(qf:1)>0 
   **- Armo la lista de las operaciones que puede seleccionar
   CrearListBox ; 'Arial,8,';'Seleccion de Operaciones'
      'Marca'        ;q:1..q:FAC;  ;;;18;CHECK ;RGB(160,160,193);;NO;NO;;NO;NO;NO;SI
      'Operacion'    ;a:1..a:FAC;NO;;;65;STRING;
      'TipoTrans '   ;b:1..b:FAC;NO;;;45;STRING;
      'Cliente'      ;c:1..c:FAC;NO;;;80;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
      'Especie'      ;d:1..d:FAC;NO;;;45;TABLA;'Especies';'Codigo';'Codigo;Nombre';
      'Fecha Op'     ;e:1..e:FAC;NO;;;60;FECHA;
      'Fecha Vto'    ;f:1..f:FAC;NO;;;60;FECHA;
      'Cantidad'     ;g:1..g:FAC;NO;;;90;NUMERO;'###,###,###';
   FinListBox

   If Not OK
      Cancelar('No se seleccionaron operaciones')
   Endif

   If Ok
      **- Recorro las filas para ver cual esta seleccionada
      Recorrer&i 1, FAC
         If Val(q:&i) = 1
            *- Pasa de Instancia la operacion

            Message('Modificando Instancias Operacion '~VAL(a:&i)~' ...')

            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
            SQL.ADD("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(a:&i)~"' ")
            SQL.NEW

            ***---Si no esta la instnacia, la crea
            IF SQL(" Select Count(1) From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~val(a:&i)~"' AND NrBit=50 ") = 0
               ***---No esta la instancia => la inserto
               EjecutarEvento('INSBIT', String1= 'OPERACIONES', Entero1 = 50, NrOperacion1=val(a:&i))
            ENDIF

            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
            SQL.ADD("Set Valor=1 Where NrBit=50 and NrOperacion='"~Val(a:&i)~"' ")
            SQL.NEW
            SQL.EXEC
         Endif
      Proximo
      Messagebox('Fin del pasaje de operaciones')
   Endif
Else
   Messagebox('No se encontraron operaciones para pasar')
Endif
