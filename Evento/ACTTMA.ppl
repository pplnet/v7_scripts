CrearDialogo
  NrOrden1    : 'Nr.TMANIF' ;1;1; ;SI;SI;;;;;
  NrOperacion1: 'Nr.TCOPRI' ;2;1; ;SI;SI;;;;;
  Check1      : 'Procesa'   ;3;1; ;SI;SI;;;;0;
FinDialogo
 
If Not Ok
   Cancelar
Endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, 'TMANIF')
ACT(a:2, 'TCPCEM')
ACT(a:3, 'TCOPRI')
ACT(a:4, 'Cantidad')
ACT(a:5, 'Dispon.TCPCEM')
ACT(a:6, 'Nuevo Dispon.')
ACT(a:7, 'Precio')
ACT(a:9, 'Merc.Neg.')
ACT(a:10, 'Error')

ACT(b:1, Dialogo.NrOrden1)
ACN(c:1, SQL("Select 1 from "~DBO~".ORDENES where NrOrden = '"~Val(b:1)~"' "))
if Val(c:1)=0
  if Dialogo.Check1=1
    Message('No existe orden '~Val(b:1))
  else
    MessageBox('No existe orden '~Val(b:1))
  endif
  ACN(b:10, 1)
endif

ACT(b:2, BuscarCampo('ORDENES','NrOperacion1','NrOrden',Dialogo.NrOrden1))
ACN(c:2, SQL("Select 1 from "~DBO~".OPERACIONES where NrOperacion = '"~Val(b:2)~"' "))
if Val(c:2)=0
  if Dialogo.Check1=1
    Message('No existe operacion '~Val(b:2))
  else
    MessageBox('No existe operacion '~Val(b:2))
  endif
  ACN(b:10, 2)
endif

ACT(b:3, Dialogo.NrOperacion1)
ACN(c:3, SQL("Select 1 from "~DBO~".OPERACIONES where NrOperacion = '"~Val(b:3)~"' "))
if Val(c:3)=0
  if Dialogo.Check1=1
    Message('No existe operacion '~Val(b:3))
  else
    MessageBox('No existe operacion '~Val(b:3))
  endif
  ACN(b:10, 3)
endif
* TCOPRI
ACN(b:4, BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1))
ACN(b:7, BuscarCampo('OPERACIONES','Precio1','NrOperacion',Dialogo.NrOperacion1))
*ACN(b:8, BuscarCampo('OPERACIONES','TotalNetoCli1','NrOperacion',Dialogo.NrOperacion1))
* TCPCEM
ACN(b:5, BuscarCampo('OPERACIONES','TotalNetoCli1','NrOperacion',Val(b:2)))
ACN(b:6, Val(b:5)-Val(b:4))
ACT(b:9, BuscarCampo('ORDENES','Mercado4','NrOrden',Dialogo.NrOrden1))

if Val(b:6)<0
  if Dialogo.Check1=1
    Message('Disponible TCPCEM '~Val(b:2)~' es negativo')
  else
    MessageBox('Disponible TCPCEM '~Val(b:2)~' es negativo')
  endif
  ACN(b:10, 6)
endif

if val(b:10)=0
  if Dialogo.Check1=1  
    SQL.ADD("Update "~DBO~".ORDENES  ")
    SQL.ADD("   Set NrOperacion2       = '"~Val(b:3)~"', ")
    SQL.ADD("       CantidadCompletada = "~FStr(Val(b:4),0,2)~", ")
    SQL.ADD("       PrecioReal         = "~FStr(Val(b:7),0,8)~", ")
    *    SQL.ADD("       CantidadEnProceso  = "~FStr(Val(b:8),0,2)~", ")
    SQL.ADD("       Estado             = '2' ")
    SQL.ADD(" where NrOrden = '"~Val(b:1)~"' ")
    SQL.NEW      
 
    SQL.ADD("Delete "~DBO~".MOVLIMITES  ")
    SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
    SQL.NEW      
    SQL.EXEC

    * Avanza la Orden a Terminal
    if EqStr(Val(b:9),Var('AMBBYMA'))
      EjecutarEvento('CBOINS', String1=Val(b:1), Radio1=1, Radio2=0, Entero1=54, Entero2=170)
    else
      EjecutarEvento('CBOINS', String1=Val(b:1), Radio1=1, Radio2=0, Entero1=104, Entero2=170)
    endif

    SQL.ADD("Update "~DBO~".OPERACIONES  ")
    SQL.ADD("   Set CB10 = '1',  ")
    SQL.ADD("       TotalNetoCli1 = "~FStr(Val(b:6),0,2)~"  ")
    SQL.ADD(" where NrOperacion = '"~Val(b:2)~"' ")
    SQL.NEW      

    SQL.EXEC
  endif
endif
