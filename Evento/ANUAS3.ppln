MostrarCuadroDeMensajes()
creardialogo
fecha1: 'D.Fecha';;;;;;;;;FSys()
fecha2: 'H.Fecha';;;;;;;;;FSys()
lista2: 'Vehiculos';4;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
lista1: 'Tipos de Asientos';-2;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".TIPOSASIENTO ");
listatabla1: 'Operaciones';0;1;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
findialogo
if (not ok)
Cancelar()
endif

Message('--- Anulacion de Asientos ---')

Sqladd(" Select A.NrUnicoAsiento, MA.Codigo CodAsi, A.NrAsiento, A.Estado ")
Sqladd(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".MODELOSASIENTO MA,"~Dbo()~".ASIENTOSCON1 A1 ")
Sqladd(" Where MA.Codigo = A.Modelo ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
Sqladd(" AND   A.NrUnicoAsiento = A1.NrUnicoAsiento  ")
Sqladd(" AND   A.Fecha1 >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND   A.Fecha1 <= '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd(" AND   (A.Estado IS NULL OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'NC' OR A.Estado = 'REV' OR A.Estado = 'CI') ")
if (NoVacio(dialogo.lista2))
Sqladd(" AND (A.Vehiculo IN ("~Pipe2Comillas(dialogo.lista2)~") OR A.Vehiculo is null OR A.Vehiculo = '' OR A.Vehiculo = ' ' ) ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND A.Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif

if (NoVacio(dialogo.lista1))
Sqladd(" AND  MA.TipoAsiento IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND  A.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif

Sqladd(" Order By 2 ")
recorrer sql
Message('Borrando Asientos Previos - Modelo '~Fbn('CodAsi'))
Sqladd(" Delete "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqladd(" Delete "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
if (Incluido(Fbn('Estado'), 'COT|NC|REV'))
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = Null ")
Sqladd(" Where NrAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
endif
Sqlexec()
proximo

