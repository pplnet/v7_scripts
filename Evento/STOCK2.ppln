sql.add(" SELECT T.Especie, T.Cupon1, T.Vehiculo1, T.Mercado1, T.Cliente1, T.Cuenta1, T.Cantidad1, T.Precio1, T.Precio1, ")
sql.add(" T.Cantidad2, T.Cantidad3, T.NrTrans, T.Cuenta4, T.RB1, C.RazonSocial, E.TamanioLote, ")
sql.add(" T.Especie1, T.Especie2, T.Cuenta2, T.Cuenta5, T.Cantidad9, T.Cantidad10, T.Cantidad11, T.Cambio5, T.Cliente2 ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E ")
sql.add(" WHERE T.Cliente1 = C.Codigo ")
sql.add(" AND   T.Especie  = '"~dialogo.especie1~"'")
sql.add(" AND   T.Especie  = E.Codigo ")
sql.add(" AND   T.TipoTr2  = 'STOCK' ")
