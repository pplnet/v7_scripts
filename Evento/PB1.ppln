sql.add(" Select /*+ RULE */ C.Chequera, F.Cliente1, F.Cuenta2 Cuenta1, '' as Proveedor, C.FechaEmision, ")
sql.add(" C.NrCheque, C.NrComprobante, C.Monto, C.Observaciones, C.Estado, F.CNFormaPago, ")
sql.add(" F.Cliente2, '', 1 as BD1, M.FechaMov, C.FechaPago ")
sql.add(" From "~Dbo()~".CHEQUES C, "~Dbo()~".TRANSACCIONES2 F,  "~Dbo()~".MOVPENDIENTES M ")
sql.add(" Where C.NrComprobante = F.NrTrans ")
sql.add(" AND   M.NrOperacion = C.NrComprobante ")
sql.add(" AND   M.FechaMov   <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND   M.NrGrupo     = TO_NUMBER(C.Chequera) ")
sql.add(" AND   M.NrComprob   = C.NrCheque ")
sql.add(" AND   F.TipoTr2 IN ('DEVM') ")
sql.add(" AND   C.Estado  IN ('ENT','ASI') ")
sql.add(" AND   F.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.cuenta1))
sql.add(" AND F.Cuenta2  = '"~dialogo.cuenta1~"' ")
sql.add(" AND C.Chequera = '"~dialogo.chequera1~"' ")
endif
if (dialogo.entero1 > 0)
sql.add(" AND C.NrCheque = "~dialogo.entero1~" ")
endif
sql.add(" Order By C.NrComprobante ")

recorrer sql
