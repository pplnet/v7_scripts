Sqladd(" Observac4,Contrato,Pais,TasaImp1,ImporteImp  ")
Sqladd(" FROM "~Dbo()~".OPERACIONES WHERE NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()

Message('Actualizando la Operacion ')

if (NoVacio(dialogo.string))
Sqladd("Update "~Dbo()~".OPERACIONES SET ")
Sqladd(" "~dialogo.string~dialogo.string1~" WHERE  NrOperacion='"~Val(a1)~"' ")
Sqlnew()
endif

Sqladd("Update "~Dbo()~".OPERACIONES SET ")
Sqladd(" Vehiculo1=' ', Vehiculo2=' ', Cliente1=' ' WHERE  NrOperacion='"~Val(a1)~"' ")
Sqlnew()


Message('Generando Instancias Operacion '~Val(a1)~' Vinculada ...')

Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SELECT '"~Val(a1)~"' As NrOperacion,NrBit,Valor ")
Sqladd(" FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()


Sqladd("Update "~Dbo()~".OPERACIONES SET ")
Sqladd(" NrOperacion3='"~Val(a1)~"' WHERE  NrOperacion='"~dialogo.nroperacion1~"' ")
Sqlnew()

Sqlexec()


