Sqladd(" SELECT Especie,'"~dialogo.tipoop1~"' As TipoOp,'"~Val(a1)~"' As NrOperacion,Cantidad,")
Sqladd(" Precio1,Spread,Precio2,InteresesCorr,PrecioEj,TipoCambio,PrecioMer,TasaPrecan, ")
Sqladd(" Precio3,Precio4,TipoCambio2,TipoCambio3,Mercado, '"~dialogo.vehiculo2~"' As Cliente1,")
