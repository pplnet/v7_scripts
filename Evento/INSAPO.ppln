Sqladd(" PorComCor2,ImpComMer1,ImpComMer2,ImpComCor1,ImpComCor2,ImpComMerEq1,ImpComMerEq2,ImpComCorEq1,")
Sqladd(" ImpComCorEq2,TCComCor1,TCComCor2,TCComMer1,TCComMer2,ImpGastos1,ImpGastos2,PrecioRef,UMedida,")
