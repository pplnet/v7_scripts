CrearDialogo
  Especie1: 'Moneda'       ;2;1;;SI;  ;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una moneda.';SI;VAR('MONEEXTR')
  Precio1 : 'Precio Compra'; ; ;;  ;  ;Dialogo.Precio1>0;'Precio compra invalido';NO;
  Precio2 : 'Precio Venta' ; ; ;;  ;  ;Dialogo.Precio2>0;'Precio venta invalido';NO;
  Fecha1  : 'Fecha'        ;1;1;;SI;  ;Dialogo.Fecha1>=FSYS;'La fecha es anterior a la del Sistema.';SI;FSYS
  Check1  : 'Procesa'      ;1;2;;NO;NO;;;;1;
FinDialogo
If Not OK
   Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)
ACT(a:FAC, Dialogo.Especie1)
ACD(b:FAC, Dialogo.Fecha1)
ACN(c:FAC, Dialogo.Precio1)
ACN(d:FAC, Dialogo.Precio2)

If SQL("SELECT 1 FROM "~DBO~".CIERREBNA WHERE Especie='"~Val(a:FAC)~"' and Fecha='"~IdxDate(Val(b:FAC))~"' ")=1
  ACT(e:FAC, 'Update')
  if Dialogo.Check1=1 
    SQL.ADD("UPDATE "~DBO~".CIERREBNA SET ")
    SQL.ADD("       PrecioCompra    = "~FStr(Val(c:FAC),1,8)~", ")
    SQL.ADD("       PrecioVenta     = "~FStr(Val(d:FAC),1,8)~" ")
    SQL.ADD(" WHERE Especie = '"~Val(a:FAC)~"' ")
    SQL.ADD("   and Fecha   = '"~IdxDate(Val(b:FAC))~"' ")
    SQL.NEW
    SQL.EXEC
  Endif
Else
  ACT(e:FAC, 'Insert')
  if Dialogo.Check1=1
    *- Insertar registro
    SQL.ADD("INSERT INTO "~DBO~".CIERREBNA ")
    SQL.ADD("(Fecha, Especie, PrecioCompra, PrecioVenta, PorCada ")
    SQL.ADD(" ) VALUES (' ")
    SQL.ADD(" "~IdxDate(val(b:FAC))~"', ")
    SQL.ADD(" '"~Val(a:FAC)~"', ")
    SQL.ADD(" "~Fstr(Val(c:FAC),0,8)~", ")
    SQL.ADD(" "~Fstr(Val(d:FAC),0,8)~", ")
    SQL.ADD(" 1 ")
    SQL.ADD(" )")
    SQL.NEW
    SQL.EXEC
  Endif
Endif

If SQL("SELECT 1 FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(a:FAC)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(b:FAC))~"' and Moneda='ARP' ")=1
  ACT(f:FAC, 'Update')
  if Dialogo.Check1=1
    SQL.ADD("UPDATE "~DBO~".COTIZACIONES SET ")
    SQL.ADD("       Precio1            = "~FStr(Val(d:FAC),1,8)~", ")
    SQL.ADD("       PrecioContable     = "~FStr(Val(d:FAC),1,8)~", ")
    SQL.ADD("       FechaActualizacion = "~SQLAhora~" ")
    SQL.ADD(" WHERE Codigo = '"~Val(a:FAC)~"' ")
    SQL.ADD("   and ISNULL(CallPut,'CON')='CON' ")
    SQL.ADD("   and Fecha = '"~IdxDate(Val(b:FAC))~"' ")
    SQL.ADD("   and Moneda = 'ARP' ")
    SQL.NEW
    SQL.EXEC
  Endif
Else
  ACT(f:FAC, 'Insert')
  if Dialogo.Check1=1
    *- Insertar registro
    SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
    SQL.ADD("(Fecha, Codigo, CallPut, Precio1, PrecioContable, Moneda, FechaActualizacion ")
    SQL.ADD(" ) VALUES (' ")
    SQL.ADD(" "~IdxDate(val(b:FAC))~"', ")
    SQL.ADD(" '"~Val(a:FAC)~"', ")
    SQL.ADD(" 'CON', ")
    SQL.ADD(" "~Fstr(Val(d:FAC),0,8)~", ")
    SQL.ADD(" "~Fstr(Val(d:FAC),0,8)~", ")
    SQL.ADD(" 'ARP', ")
    SQL.ADD(" "~SQLAhora~" ")
    SQL.ADD(" )")
    SQL.NEW
    SQL.EXEC
  Endif
Endif

