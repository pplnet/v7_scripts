sql.add(" SELECT DISTINCT T.Cliente1,T.Cliente2, T.Especie, T.Cantidad1 , T.Vehiculo1,          ")
sql.add(" T.NrTrans, T.Fecha1 , T.Fecha2 , T.TipoTr2, E.Nombre, T.Cuenta1, T.Cuenta2,           ")
sql.add(" T.Mercado1, T.Mercado2, T.CuentaContable1, T.CuentaContable2,                         ")
sql.add(" T.ConceptoPago, T.Book1, T.Observaciones                                              ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".ESPECIES E, "~Dbo()~".OPERACIONESBITS B          ")
sql.add(" WHERE  T.Especie  = E.Codigo                                                          ")
sql.add(" AND    T.NrTrans  = B.NrOperacion                                                     ")
sql.add(" AND    T.TipoTr2 IN  ('TRNOP','DENOP','RENOP')                                        ")
sql.add(" AND    B.Valor = '1'                                                                  ")
sql.add(" AND    B.NrBit = 111                                                                  ")
sql.add(" AND    T.CB5='1'                                                                      ")

if (NoVacio(dialogo.nrtrans1))
sql.add(" AND  T.NrTrans = '"~dialogo.nrtrans1~"'                                            ")
endif
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND  T.Vehiculo1 = '"~dialogo.vehiculo1~"'                                         ")
endif

sql.add(" ORDER BY T.Cliente1, T.TipoTr2                                                        ")

Acn(z:1, 0)
