CrearDialogo
  Radio1:       'Tipo|Oper|Trans';1;1;1;SI;SI;;;;0
** FJL 28/04/25 - Issue EXTBOFA-8155 - A pedido de Gustavo se agrega validadion de TIV
*  NrOperacion1: '# Oper'     ;2;1;1;Dialogo.Radio1=0;Dialogo.Radio1=0;;;;;;;;;"TipoOp in ('TIV') "
  NrOperacion1: '# Oper'     ;2;1;1;Dialogo.Radio1=0;Dialogo.Radio1=0;[Dialogo.Radio1=0 y NoVacio(Dialogo.NrOperacion1) y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIV')] o Dialogo.Radio1=1;'Debe ingresar una TIV';NO;;;;;;"TipoOp in ('TIV') "
  NrTrans1:     '# Trans'    ;3;1;1;Dialogo.Radio1=1;Dialogo.Radio1=1;[Dialogo.Radio1=1 y NOVacio(Dialogo.NrTrans1)     y EqStr(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'DRT') ]    o Dialogo.Radio1=0;'Debe ingresar una DRT';NO;;;;;;"TipoTr2 in ('DRT') "
  Check1 :      'Procesa'    ;4;1;1;SI;SI;;;;1
  Check2 :      'Reasig.'    ;5;1;1;SI;SI;;;;0
  Check3 :      'Ing.Manual' ;6;1;1;NO;SI;;;;1
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

if Dialogo.Radio1=0
  ** Operacion
  SetFilaActual(1)
  ACT(a:FAC, 'NrOpe')
  ACT(b:FAC, 'TipoOp')
  ACT(c:FAC, 'Especie')
  ACT(d:FAC, 'ContraEspecie')
  ACT(e:FAC, 'FechaOp')
  ACT(f:FAC, 'FechaVto')
  ACT(g:FAC, 'Cantidad')
  ACT(h:FAC, 'Ciente')
  ACT(i:FAC, 'Vehiculo')

  ACT(j:FAC, 'ParkMoneda')
  ACT(k:FAC, 'ParkTipoDol')
  ACT(l:FAC, 'ParkJuris')
  ACT(m:FAC, 'ParkAfecta')
  ACT(n:FAC, 'MonEmision')
  ACT(q:FAC, 'Orden')
  SetFont(a:FAC..w:FAC,2)
  
  SQL.ADD("Select O.* ") 
  SQL.ADD("from "~DBO~".OPERACIONES O")
  SQL.ADD("where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  recorrer SQL
    ACT(a:FAC, fbn('NrOperacion'))
    ACT(b:FAC, fbn('TipoOp'))
    ACT(c:FAC, fbn('Especie'))
    ACT(d:FAC, fbn('ContraEspecie'))
    ACD(e:FAC, fbn('FechaOp'))
    ACD(f:FAC, fbn('FechaVto'))
    ACN(g:FAC, fbn('Cantidad'))
    ACT(h:FAC, fbn('Cliente1'))
    ACT(i:FAC, fbn('Vehiculo1'))

    ACT(j:FAC, fbn('ParkMoneda'))
    ACT(k:FAC, fbn('ParkTipoDol'))
    ACT(l:FAC, fbn('ParkJuris'))
    ACT(m:FAC, fbn('ParkAfecta'))
    ACT(n:FAC, BuscarCampo('ESPECIES','MonedaEmision','Codigo',fbn('Especie')))
    
  proximo

** FJL 23/04/25 - Issue 8155 - Afectaba TIC como si fuera TIV
  if EqStr(Val(b:2),'TIC')
    if Dialogo.Check1=1
      Cancelar
    else
      Cancelar('Error - La Operaciones '~Val(a:2)~' es una TIC')
    endif
  endif
* 0 ARP LM
* 1 ARP Ext
* 2 USD MEP LM
* 3 USD MEP Ext
* 4 USD Cable LM
* 5 USD Cable Ext

  if EqStr(Val(j:2),'ARP')
    if EqStr(Val(l:2),'ARG')
      * ARP LM
      ACN(q:2, 0)
      ACN(q:3, 1)
      ACN(q:4, 2)
      ACN(q:5, 4)
      ACN(q:6, 3)
      ACN(q:7, 5)
    else
      * ARP Ext (No deberia existir)
      ACN(q:2, 1)
      ACN(q:3, 0)
      ACN(q:4, 4)
      ACN(q:5, 2)
      ACN(q:6, 5)
      ACN(q:7, 3)
    endif
  else
    * USD
    if EqStr(Val(k:2),'MEP')
      * USD MEP
      if EqStr(Val(l:2),'ARG')
        * USD MEP LM
        ACN(q:2, 2) 
        ACN(q:3, 4) 
        ACN(q:4, 3) 
        ACN(q:5, 5)
        ACN(q:6, 0)
        ACN(q:7, 1)
      else
      * USD MEP Ext (No deberia existir)
        ACN(q:2, 3)
        ACN(q:3, 5)
        ACN(q:4, 2)
        ACN(q:5, 4)
        ACN(q:6, 1)
        ACN(q:7, 0)
      endif
    else
      * USD CAB
      if EqStr(Val(l:2),'ARG')
        * USD CAB LM
        ACN(q:2, 4) 
        ACN(q:3, 2) 
        ACN(q:4, 5) 
        ACN(q:5, 3)
        ACN(q:6, 0)
        ACN(q:7, 1)
      else
        * USD CAB Ext
        ACN(q:2, 5)
        ACN(q:3, 3)
        ACN(q:4, 4)
        ACN(q:5, 2)
        ACN(q:6, 1)
        ACN(q:7, 0)
      endif
    endif
  endif
  
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'NrSaldo')
  ACT(b:FAC, 'Moneda')
  ACT(c:FAC, 'TipoUSD')
  ACT(d:FAC, 'Mercado')
  ACT(e:FAC, 'Saldo FOp')
  ACT(f:FAC, 'Existe PP')
  ACT(g:FAC, 'Dias Par')
  ACT(h:FAC, 'FechaSal')
  ACT(i:FAC, 'Saldo Ajus')
  ACT(j:FAC, 'Usado')
  ACT(l:FAC, 'Saldo FSal')
  ACT(m:FAC, '# M.Eje')
  ACT(n:FAC, 'Sum M.Eje DRT')
  ACT(o:FAC, '# M.Eje DRT')
  ACT(p:FAC, 'Sum M.Eje')
  SetFont(a:FAC..w:FAC,2)
  IFA 
  ACN(a:FAC, 131)
  ACT(b:FAC, 'ARP')
  ACT(d:FAC, 'ARG')
  ACN(a:FAC+1, 131)
  ACT(b:FAC+1, 'ARP')
  ACT(d:FAC+1, 'EXT')
  ACN(a:FAC+2, 132)
  ACT(b:FAC+2, 'USD')
  ACT(c:FAC+2, 'MEP')
  ACT(d:FAC+2, 'ARG')
  ACN(a:FAC+3, 132)
  ACT(b:FAC+3, 'USD')
  ACT(c:FAC+3, 'MEP')
  ACT(d:FAC+3, 'EXT')
  ACN(a:FAC+4, 133)
  ACT(b:FAC+4, 'USD')
  ACT(c:FAC+4, 'CAB')
  ACT(d:FAC+4, 'ARG')
  ACN(a:FAC+5, 133)
  ACT(b:FAC+5, 'USD')
  ACT(c:FAC+5, 'CAB')
  ACT(d:FAC+5, 'EXT')

  ACN(e:FAC+7, 0)
  ACN(i:FAC+7, 0)

  * Busca plazos parking para las condiciones de venta de la Op
  recorrer&i 0,5
    ACN(s:1, FAC+Val(q:2+&i))
    *                      Vehi     Esp         Mer               NrSaldo         Fecha
    ACN(e:Val(s:1), SaldoC(Val(i:2),Val(c:2),,,,Val(d:Val(s:1)),,,Val(a:Val(s:1)),Val(e:2)))
    if Val(e:Val(s:1))>0
      SCN(e:FAC+7, Val(e:Val(s:1)))
    endif
    ACN(f:Val(s:1), Query("Select Count(*) from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(n:2)~"' and MonedaCpra='"~Val(b:Val(s:1))~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(c:Val(s:1))~"','') and JurisCpra='"~Val(d:Val(s:1))~"' and MonedaVta='"~Val(j:2)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(k:2)~"','') and JurisVta='"~Val(l:2)~"' "))
    if Val(f:Val(s:1))>0
      ACN(g:Val(s:1), Query("Select Top(1) DiasParking from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(n:2)~"' and MonedaCpra='"~Val(b:Val(s:1))~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(c:Val(s:1))~"','') and JurisCpra='"~Val(d:Val(s:1))~"' and MonedaVta='"~Val(j:2)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(k:2)~"','') and JurisVta='"~Val(l:2)~"' "))
    endif
    ACD(h:Val(s:1), Habiles(Val(e:2),-Val(g:Val(s:1)),'ARG'))
    *                      Vehi     Esp         Mer               NrSaldo         Fecha
    ACN(l:Val(s:1), SaldoC(Val(i:2),Val(c:2),,,,Val(d:Val(s:1)),,,Val(a:Val(s:1)),Val(h:Val(s:1))))
    *** Busco los Movs de la operacion
    SQL.ADD("Select Cantidad ") 
    SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("  and NrSaldo = "~FStr(Val(a:Val(s:1)),1,0)~" ")
    SQL.ADD("  and Mercado = '"~Val(d:Val(s:1))~"' ")
    recorrer SQL
      DFA
      SCN(m:Val(s:1), 1)
      SCN(n:Val(s:1), fbn('Cantidad'))
    proximo
    if Dialogo.Check2=1
      * Es por Reasignacion    
      *** Busco los Movs de DRT
      SQL.ADD("Select Cantidad ") 
      SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrOperacion like 'TE%' ")
      SQL.ADD("  and Especie = '"~Val(c:2)~"' ")
      SQL.ADD("  and FechaMov = '"~IdxDate(Val(e:2))~"' ")
      SQL.ADD("  and NrSaldo = "~FStr(Val(a:Val(s:1)),1,0)~" ")
      SQL.ADD("  and Mercado = '"~Val(d:Val(s:1))~"' ")
      recorrer SQL
        DFA
        SCN(o:Val(s:1), 1)
        SCN(p:Val(s:1), fbn('Cantidad'))
      proximo
    endif
    *** Resto Los Movs de la operacion y de las DRT
    ACN(i:Val(s:1), Val(l:Val(s:1))-Val(n:Val(s:1))+Val(p:Val(s:1)))
    if Val(i:Val(s:1))>Val(e:Val(s:1))
      ACN(i:Val(s:1),  Val(e:Val(s:1)))
    endif
    if Val(i:Val(s:1))>0
      SCN(i:FAC+7, Val(i:Val(s:1)))
      SCN(aa:1, 1)
      ACN(ab:Val(aa:1), Val(s:1))
    endif
  proximo  

  if Dialogo.Check1=1
    * Borra las excepciones y movimientos de Parking
    SQL.ADD("Delete "~DBO~".EXCEPCIONES ")
    SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and Tipo in ('SALDOPARK','SDOPARNOEX') ")
    SQL.NEW
    SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and NrSaldo>130 ")
    SQL.ADD("   and NrSaldo<140 ")
    SQL.NEW
    SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and NrSaldo>130 ")
    SQL.ADD("   and NrSaldo<140 ")
    SQL.NEW
    SQL.EXEC
  endif
  if Val(i:FAC+7)<Val(g:2)
    * Saldo Insuficiente
    if EqStr(Val(j:2),'ARP')
      ACT(j:FAC+7, 'No hay suficente saldo para realizar la Operacion '~Dialogo.NrOperacion1~'. Disponible '~PyC(Val(i:FAC+7),1,2)~'.')
    else
      ACT(j:FAC+7, 'No hay suficente saldo que cumpla el aging para la Operacion '~Dialogo.NrOperacion1~'. Disponible '~PyC(Val(i:FAC+7),1,2)~'.')
    endif
    if Dialogo.Check3=1
      MessageBox(Val(j:FAC+7)~' Va a Supervision parking')
    else
      Message(Val(j:FAC+7)~' Va a Supervision parking')
    endif
    if Dialogo.Check1=1
      SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
      SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
      SQL.ADD(" ) Values ( ")
      SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
      SQL.ADD(" "~SQLAhora~", ")
      SQL.ADD(" 'SALDOPARK', ")
      SQL.ADD(" '"~Copy(Val(j:FAC+7),1,100)~"' ")
      SQL.ADD(" ) ")
      SQL.NEW
    endif
  endif
  if Val(i:FAC+7)<=0
    * Saldo total disponible es cero (o negativo por las dudas)
    ACT(j:FAC+8, 'No hay ningun saldo de donde descontar la venta.')
    if Dialogo.Check1=1
      SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
      SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
      SQL.ADD(" ) Values ( ")
      SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
      SQL.ADD(" "~SQLAhora~", ")
      SQL.ADD(" 'SDOPARNOEX', ")
      SQL.ADD(" '"~Copy(Val(j:FAC+8),1,100)~"' ")
      SQL.ADD(" ) ")
      SQL.NEW
    endif
  endif
  if Val(i:FAC+7)>=Val(g:2)
    * Saldo suficiente
    * Se genera movimientos para bajar el saldo
    ACN(z:1, Val(g:2))
    ACN(z:2, Val(g:2))
    if Val(aa:1)>0
      recorrer&j 1, Val(aa:1)
        if Val(i:Val(ab:&j))>=Val(z:2)
          ACN(j:Val(ab:&j), Val(z:2))
          SCN(z:2, -Val(j:Val(ab:&j)))
          ACN(ac:&j, 1)
          SCN(ad:&j, -Val(j:Val(ab:&j)))
        else
          ACN(j:Val(ab:&j), Val(i:Val(ab:&j)))
          SCN(z:2, -Val(j:Val(ab:&j)))
          ACN(ac:&j, 1)
          SCN(ad:&j, -Val(j:Val(ab:&j)))
        endif
        if Val(z:2)<=0
          ACT(k:Val(ab:&j), 'FIN')
          break
        endif
      proximo
      recorrer&j 1,Val(aa:1)
        if Val(ac:&j)=1
          ACT(ae:&j, 'Mov')
          ACT(af:&j, 'Venta de '~Val(c:2))
          if Dialogo.Check1=1
            If Val(e:2)<=Fsys
              SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
            Else
              SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ( ")
            EndIf
            SQL.ADD(" NrOperacion, ")
            SQL.ADD(" FechaMov, ")
            SQL.ADD(" Cliente, ")
            SQL.ADD(" Especie, ")
            SQL.ADD(" Mercado, ")
            SQL.ADD(" Cantidad, ")
            SQL.ADD(" Leyenda, ")
            SQL.ADD(" Bits, ")
            SQL.ADD(" NrSaldo, ")
            SQL.ADD(" NrGrupo, ")
            SQL.ADD(" FechaEje, ")
            SQL.ADD(" UsuarioEje, ")
            SQL.ADD(" NrGrupo2, ")
            SQL.ADD(" NrMov, ")
            SQL.ADD(" NrInstan, ")
            SQL.ADD(" Vehiculo ")
            SQL.ADD(" ) Values ( ")
            * NrOperacion
            SQL.ADD(" '"~val(a:2)~"', ")
            * FechaMov
            SQL.ADD(" '"~IdxDate(Val(e:2))~"', ")
*            SQL.ADD(" '"~IdxDate(Val(h:Val(ab:&j)))~"', ")
            * Cliente
            SQL.ADD(" '"~Val(i:2)~"', ")
            * Especie
            SQL.ADD(" '"~Val(c:2)~"', ")
            * Mercado
            SQL.ADD(" '"~Val(d:Val(ab:&j))~"', ")
            * Cantidad
            SQL.ADD(" "~Fstr(Val(ad:&j),0,2)~", ")
            * Leyenda
            SQL.ADD(" '"~val(af:&j)~"', ")
            * Bits
            SQL.ADD(" 'AV', ")
            * NrSaldo
            SQL.ADD(" "~Fstr(Val(a:Val(ab:&j)),0,0)~", ")
            * NrGrupo
            SQL.ADD(" 1, ")
            * FechaEj
            SQL.ADD(" '"~IdxDate(FSYS)~"',")
            * UsuarioEje
            SQL.ADD(" '"~UsuarioActivo~"', ")
            * NrGrupo2
            SQL.ADD(" 0, ")
            * NrMov
*** FJL 16/09/24 - Porque sumaba a los movimietnos de liquidacion
*            SQL.ADD(" 2, ")
            SQL.ADD(" "~Fstr(Val(a:Val(ab:&j)),0,0)~", ")
            * NrInstan
            SQL.ADD(" 0, ")
            * Vehiculo
            SQL.ADD(" '"~Val(i:2)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
          endif
********************************************
        endif
      proximo
    endif
  endif
  if Dialogo.Check1=1
    SQL.EXEC
  endif

  FormatoCeldas(a:5..a:12,Exe('F0'))
  FormatoCeldas(f:5..g:12,Exe('F0'))
  FormatoCeldas(e:5..e:12,Exe('F2'))
  FormatoCeldas(i:5..l:12,Exe('F2'))
  FormatoCeldas(m:5..m:12,Exe('F0'))
  FormatoCeldas(n:5..n:12,Exe('F2'))
  FormatoCeldas(o:5..o:12,Exe('F0'))
  FormatoCeldas(p:5..p:12,Exe('F2'))

ENDIF

if Dialogo.Radio1=1
  ** Transaccion DRT
  SetFilaActual(1)
  ACT(a:FAC, 'NrTrans')
  ACT(b:FAC, 'TipoOp')
  ACT(c:FAC, 'Especie')
  ACT(e:FAC, 'Fecha1')
  ACT(g:FAC, 'Cantidad')
  ACT(h:FAC, 'Ciente')
  ACT(i:FAC, 'Vehiculo')
  ACT(m:FAC, 'ParkAfecta')

  ACT(q:FAC, 'Orden')

  ACT(aa:FAC, 'Merc.Orig.')
  ACT(ab:FAC, 'Cta.Orig.')
  ACT(ac:FAC, 'Clie.Orig.')
  ACT(ad:FAC, 'Mon.Orig.')
  ACT(ae:FAC, 'TipoDol.Orig.')
  ACT(af:FAC, 'Mer.Par.Orig.')
  ACT(ag:FAC, 'NrSaldo Orig')
  
  ACT(an:FAC, 'Merc.Des.')
  ACT(ao:FAC, 'Cta.Des.')
  ACT(ap:FAC, 'Clie.Des.')
  ACT(aq:FAC, 'Mon.Des.')
  ACT(ar:FAC, 'TipoDol.Des.')
  ACT(as:FAC, 'Mer.Par.Des.')
  ACT(at:FAC, 'NrSaldo Des')
  ACT(au:FAC, 'Leyenda Des')

  SetFont(a:FAC..az:FAC,2)

  SQL.ADD("Select T.* ") 
  SQL.ADD("from "~DBO~".TRANSACCIONES2 T ")
  SQL.ADD("where T.NrTrans = '"~Dialogo.NrTrans1~"' ")
  recorrer SQL
    ACT(a:FAC, fbn('NrTrans'))
    ACT(b:FAC, fbn('TipoTr2'))
    ACT(c:FAC, fbn('Especie'))
    ACD(e:FAC, fbn('Fecha1'))
    ACN(g:FAC, fbn('Cantidad1'))
    ACT(h:FAC, fbn('Cliente1'))
    ACT(i:FAC, fbn('Vehiculo1'))
    ACT(m:FAC, fbn('ParkAfecta'))

    * Origen
    ACT(aa:FAC, fbn('Mercado2'))
    ACT(ab:FAC, fbn('Cuenta2'))
    ACT(ac:FAC, fbn('Cliente2'))
    if Incluido(fbn('Mercado2'),Var('MERPAREXT'))
      ACT(ad:FAC, 'USD')
      ACT(ae:FAC, 'CAB')
      ACT(af:FAC, 'EXT')
      ACN(ag:FAC, 133)
      ACT(ah:FAC, 'DRT de Exterior')
    else
      ACT(ad:FAC, 'ARP')
      ACT(ae:FAC, '')
      ACT(af:FAC, 'ARG')
      ACN(ag:FAC, 131)
      ACT(ah:FAC, 'DRT de Local Market')
    endif
    
    * Destino
    ACT(an:FAC, fbn('Mercado1'))
    ACT(ao:FAC, fbn('Cuenta1'))
    ACT(ap:FAC, fbn('Cliente1'))
    if Incluido(fbn('Mercado1'),Var('MERPAREXT'))
      ACT(aq:FAC, 'USD')
      ACT(ar:FAC, 'CAB')
      ACT(as:FAC, 'EXT')
      ACN(at:FAC, 133)
      ACT(au:FAC, 'DRT a Exterior')
    else
      ACT(aq:FAC, 'ARP')
      ACT(ar:FAC, '')
      ACT(as:FAC, 'ARG')
      ACN(at:FAC, 131)
      ACT(au:FAC, 'DRT a Local Market')
    endif

  Proximo

  if EqStr(Val(ad:2),'ARP')
    if EqStr(Val(af:2),'ARG')
      * ARP LM
      ACN(q:2, 0)
      ACN(q:3, 1)
      ACN(q:4, 2)
      ACN(q:5, 4)
      ACN(q:6, 3)
      ACN(q:7, 5)
    endif
  else
    * USD
    if EqStr(Val(ae:2),'MEP')
      * USD MEP
      if EqStr(Val(af:2),'ARG')
        * USD MEP LM
        ACN(q:2, 2) 
        ACN(q:3, 4) 
        ACN(q:4, 3) 
        ACN(q:5, 5)
        ACN(q:6, 0)
        ACN(q:7, 1)
      endif
    else
      * USD CAB
      if EqStr(Val(af:2),'ARG')
        * USD CAB LM
        ACN(q:2, 4) 
        ACN(q:3, 2) 
        ACN(q:4, 5) 
        ACN(q:5, 3)
        ACN(q:6, 0)
        ACN(q:7, 1)
      else
        * USD CAB Ext
        ACN(q:2, 5)
        ACN(q:3, 3)
        ACN(q:4, 4)
        ACN(q:5, 2)
        ACN(q:6, 1)
        ACN(q:7, 0)
      endif
    endif
  endif

  SetFilaActual(FAC+2)
  ACT(a:FAC, 'NrSaldo')
  ACT(b:FAC, 'Moneda')
  ACT(c:FAC, 'TipoUSD')
  ACT(d:FAC, 'Mercado')
  ACT(e:FAC, 'Saldo FOp')
  ACT(f:FAC, 'Existe PP')
  ACT(g:FAC, 'Dias Par')
  ACT(h:FAC, 'FechaSal')
  ACT(i:FAC, 'Saldo Ajus')
  ACT(j:FAC, 'Usado')
  ACT(l:FAC, 'Saldo FSal')
  ACT(m:FAC, '# M.Eje')
  ACT(n:FAC, 'Sum M.Eje')
  SetFont(a:FAC..w:FAC,2)
  IFA 
  ACN(a:FAC, 131)
  ACT(b:FAC, 'ARP')
  ACT(d:FAC, 'ARG')
  ACN(a:FAC+1, 131)
  ACT(b:FAC+1, 'ARP')
  ACT(d:FAC+1, 'EXT')
  ACN(a:FAC+2, 132)
  ACT(b:FAC+2, 'USD')
  ACT(c:FAC+2, 'MEP')
  ACT(d:FAC+2, 'ARG')
  ACN(a:FAC+3, 132)
  ACT(b:FAC+3, 'USD')
  ACT(c:FAC+3, 'MEP')
  ACT(d:FAC+3, 'EXT')
  ACN(a:FAC+4, 133)
  ACT(b:FAC+4, 'USD')
  ACT(c:FAC+4, 'CAB')
  ACT(d:FAC+4, 'ARG')
  ACN(a:FAC+5, 133)
  ACT(b:FAC+5, 'USD')
  ACT(c:FAC+5, 'CAB')
  ACT(d:FAC+5, 'EXT')

  ACN(e:FAC+7, 0)
  ACN(i:FAC+7, 0)

  * Busca plazos parking para las consiciones del origen dela DRT
  recorrer&i 0,5
    ACN(s:1, FAC+Val(q:2+&i))
    *                      Vehi     Esp         Mer               NrSaldo         Fecha
    ACN(e:Val(s:1), SaldoC(Val(i:2),Val(c:2),,,,Val(d:Val(s:1)),,,Val(a:Val(s:1)),Val(e:2)))
    if Val(e:Val(s:1))>0
      SCN(e:FAC+7, Val(e:Val(s:1)))
    endif
    ACN(f:Val(s:1), Query("Select Count(*) from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(n:2)~"' and MonedaCpra='"~Val(b:Val(s:1))~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(c:Val(s:1))~"','') and JurisCpra='"~Val(d:Val(s:1))~"' and MonedaVta='"~Val(j:2)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(k:2)~"','') and JurisVta='"~Val(l:2)~"' "))
    if Val(f:Val(s:1))>0
      ACN(g:Val(s:1), Query("Select Top(1) DiasParking from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(n:2)~"' and MonedaCpra='"~Val(b:Val(s:1))~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(c:Val(s:1))~"','') and JurisCpra='"~Val(d:Val(s:1))~"' and MonedaVta='"~Val(j:2)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(k:2)~"','') and JurisVta='"~Val(l:2)~"' "))
    endif
    ACD(h:Val(s:1), Habiles(Val(e:2),-Val(g:Val(s:1)),'ARG'))
    *                      Vehi     Esp         Mer               NrSaldo         Fecha
    ACN(l:Val(s:1), SaldoC(Val(i:2),Val(c:2),,,,Val(d:Val(s:1)),,,Val(a:Val(s:1)),Val(h:Val(s:1))))
    SQL.ADD("Select Cantidad ") 
    SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("where NrOperacion = '"~Dialogo.NrTrans1~"' ")
    SQL.ADD("  and NrSaldo = "~FStr(Val(a:Val(s:1)),1,0)~" ")
    SQL.ADD("  and Mercado = '"~Val(d:Val(s:1))~"' ")
    recorrer SQL
      DFA
      SCN(m:Val(s:1), 1)
      SCN(n:Val(s:1), fbn('Cantidad'))
    proximo
    ACN(i:Val(s:1), Val(l:Val(s:1))-Val(n:Val(s:1)))
    if Val(i:Val(s:1))>0
      SCN(i:FAC+7, Val(i:Val(s:1)))
      SCN(ca:1, 1)
      ACN(cb:Val(ca:1), Val(s:1))
    endif
  proximo  
  
  if Dialogo.Check1=1
    * Borra los movimientos de Parking
    SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" where NrOperacion='"~Dialogo.NrTrans1~"' ")
    SQL.ADD("   and NrSaldo>130 ")
    SQL.ADD("   and NrSaldo<140 ")
    SQL.NEW
    SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" where NrOperacion='"~Dialogo.NrTrans1~"' ")
    SQL.ADD("   and NrSaldo>130 ")
    SQL.ADD("   and NrSaldo<140 ")
    SQL.NEW
    SQL.EXEC
  endif

  * Movimientos del mercado origen  
  * Se genera movimientos para bajar el saldo
  ACN(z:1, Val(g:2))
  ACN(z:2, Val(g:2))
  if Val(ca:1)>0
      recorrer&j 1, Val(ca:1)
        if Val(i:Val(cb:&j))>=Val(z:2)
          ACN(j:Val(cb:&j), Val(z:2))
          SCN(z:2, -Val(j:Val(cb:&j)))
          ACN(cc:&j, 1)
          SCN(cd:&j, -Val(j:Val(cb:&j)))
        else
          ACN(j:Val(cb:&j), Val(i:Val(cb:&j)))
          SCN(z:2, -Val(j:Val(cb:&j)))
          ACN(cc:&j, 1)
          SCN(cd:&j, -Val(j:Val(cb:&j)))
        endif
        if Val(z:2)<=0
          ACT(k:Val(ab:&j), 'FIN')
          break
        endif
      proximo
      recorrer&j 1,Val(ca:1)
        if Val(cc:&j)=1
          ACT(ce:&j, 'Mov')
          ACT(cf:&j, Val(ah:2))
          if Dialogo.Check1=1
            If Val(e:2)<=Fsys
              SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
            Else
              SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ( ")
            EndIf
            SQL.ADD(" NrOperacion, ")
            SQL.ADD(" FechaMov, ")
            SQL.ADD(" Cliente, ")
            SQL.ADD(" Especie, ")
            SQL.ADD(" Mercado, ")
            SQL.ADD(" Cantidad, ")
            SQL.ADD(" Leyenda, ")
            SQL.ADD(" Bits, ")
            SQL.ADD(" NrSaldo, ")
            SQL.ADD(" NrGrupo, ")
            SQL.ADD(" FechaEje, ")
            SQL.ADD(" UsuarioEje, ")
            SQL.ADD(" NrGrupo2, ")
            SQL.ADD(" NrMov, ")
            SQL.ADD(" NrInstan, ")
            SQL.ADD(" Vehiculo ")
            SQL.ADD(" ) Values ( ")
            * NrOperacion
            SQL.ADD(" '"~val(a:2)~"', ")
            * FechaMov
            SQL.ADD(" '"~IdxDate(Val(e:2))~"', ")
*            SQL.ADD(" '"~IdxDate(Val(h:Val(ab:&j)))~"', ")
            * Cliente
            SQL.ADD(" '"~Val(i:2)~"', ")
            * Especie
            SQL.ADD(" '"~Val(c:2)~"', ")
            * Mercado
            SQL.ADD(" '"~Val(d:Val(cb:&j))~"', ")
            * Cantidad
            SQL.ADD(" "~Fstr(Val(cd:&j),0,2)~", ")
            * Leyenda
            SQL.ADD(" '"~Val(ah:2)~"', ")
            * Bits
            SQL.ADD(" 'AV', ")
            * NrSaldo
            SQL.ADD(" "~Fstr(Val(a:Val(cb:&j)),0,0)~", ")
            * NrGrupo
            SQL.ADD(" 1, ")
            * FechaEj
            SQL.ADD(" '"~IdxDate(FSYS)~"',")
            * UsuarioEje
            SQL.ADD(" '"~UsuarioActivo~"', ")
            * NrGrupo2
            SQL.ADD(" 0, ")
            * NrMov
*** FJL 16/09/24 - Porque sumaba a los movimietnos de liquidacion
*            SQL.ADD(" 2, ")
            SQL.ADD(" "~Fstr(Val(a:Val(cb:&j)),0,0)~", ")
            * NrInstan
            SQL.ADD(" 0, ")
            * Vehiculo
            SQL.ADD(" '"~Val(i:2)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
            ACT(cg:&j, 'Insertado')
          else
            ACT(cg:&j, 'Sin Procesar')
          endif
********************************************
        endif
      proximo
  endif
  if Val(z:2)>0
    * Queda importe sin asignar

    if Dialogo.Check1=1
      If Val(e:2)<=Fsys
        SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
      Else
        SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ( ")
      EndIf
      SQL.ADD(" NrOperacion, ")
      SQL.ADD(" FechaMov, ")
      SQL.ADD(" Cliente, ")
      SQL.ADD(" Especie, ")
      SQL.ADD(" Mercado, ")
      SQL.ADD(" Cantidad, ")
      SQL.ADD(" Leyenda, ")
      SQL.ADD(" Bits, ")
      SQL.ADD(" NrSaldo, ")
      SQL.ADD(" NrGrupo, ")
      SQL.ADD(" FechaEje, ")
      SQL.ADD(" UsuarioEje, ")
      SQL.ADD(" NrGrupo2, ")
      SQL.ADD(" NrMov, ")
      SQL.ADD(" NrInstan, ")
      SQL.ADD(" Vehiculo ")
      SQL.ADD(" ) Values ( ")
      * NrOperacion
      SQL.ADD(" '"~val(a:2)~"', ")
      * FechaMov
      SQL.ADD(" '"~IdxDate(Val(e:2))~"', ")
      * Cliente
      SQL.ADD(" '"~Val(ap:2)~"', ")
      * Especie
      SQL.ADD(" '"~Val(c:2)~"', ")
      * Mercado
      SQL.ADD(" '"~Val(as:2)~"', ")
      * Cantidad
      SQL.ADD(" "~Fstr(-Val(z:2),0,2)~", ")
      * Leyenda
      SQL.ADD(" '"~Val(ah:2)~"', ")
      * Bits
      SQL.ADD(" 'AV', ")
      * NrSaldo
      SQL.ADD(" "~Fstr(Val(at:2),0,0)~", ")
      * NrGrupo
      SQL.ADD(" 1, ")
      * FechaEj
      SQL.ADD(" '"~IdxDate(FSYS)~"',")
      * UsuarioEje
      SQL.ADD(" '"~UsuarioActivo~"', ")
      * NrGrupo2
      SQL.ADD(" 0, ")
      * NrMov
*** FJL 16/09/24 - Porque sumaba a los movimietnos de liquidacion
*      SQL.ADD(" 1, ")
      SQL.ADD(" "~Fstr(Val(at:2),0,0)~", ")
      * NrInstan
      SQL.ADD(" 0, ")
      * Vehiculo
      SQL.ADD(" '"~Val(i:2)~"' ")
      SQL.ADD(" ) ")
      SQL.NEW
      ACT(ai:2, 'Insertado')
    else
      ACT(ai:2, 'Sin Procesar')
    endif
  endif


  * Movimiento al mercado destino  
  if Dialogo.Check1=1
    If Val(e:2)<=Fsys
      SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
    Else
      SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ( ")
    EndIf
    SQL.ADD(" NrOperacion, ")
    SQL.ADD(" FechaMov, ")
    SQL.ADD(" Cliente, ")
    SQL.ADD(" Especie, ")
    SQL.ADD(" Mercado, ")
    SQL.ADD(" Cantidad, ")
    SQL.ADD(" Leyenda, ")
    SQL.ADD(" Bits, ")
    SQL.ADD(" NrSaldo, ")
    SQL.ADD(" NrGrupo, ")
    SQL.ADD(" FechaEje, ")
    SQL.ADD(" UsuarioEje, ")
    SQL.ADD(" NrGrupo2, ")
    SQL.ADD(" NrMov, ")
    SQL.ADD(" NrInstan, ")
    SQL.ADD(" Vehiculo ")
    SQL.ADD(" ) Values ( ")
    * NrOperacion
    SQL.ADD(" '"~val(a:2)~"', ")
    * FechaMov
    SQL.ADD(" '"~IdxDate(Val(e:2))~"', ")
    * Cliente
    SQL.ADD(" '"~Val(ap:2)~"', ")
    * Especie
    SQL.ADD(" '"~Val(c:2)~"', ")
    * Mercado
    SQL.ADD(" '"~Val(as:2)~"', ")
    * Cantidad
    SQL.ADD(" "~Fstr(Val(g:2),0,2)~", ")
    * Leyenda
    SQL.ADD(" '"~Val(au:2)~"', ")
    * Bits
    SQL.ADD(" 'AV', ")
    * NrSaldo
    SQL.ADD(" "~Fstr(Val(at:2),0,0)~", ")
    * NrGrupo   
    SQL.ADD(" 1, ")
    * FechaEj
    SQL.ADD(" '"~IdxDate(FSYS)~"',")
    * UsuarioEje
    SQL.ADD(" '"~UsuarioActivo~"', ")
    * NrGrupo2
    SQL.ADD(" 0, ")
    * NrMov
*** FJL 16/09/24 - Porque sumaba a los movimietnos de liquidacion
*    SQL.ADD(" 2, ")
    SQL.ADD(" "~Fstr(Val(at:2),0,0)~", ")
    * NrInstan
    SQL.ADD(" 0, ")
    * Vehiculo
    SQL.ADD(" '"~Val(i:2)~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
    ACT(av:2, 'Insertado')
  else
    ACT(av:2, 'Sin Procesar')
  endif
  if Dialogo.Check1=1
    SQL.EXEC
  endif
  
  FormatoCeldas(a:5..a:12,Exe('F0'))
  FormatoCeldas(f:5..g:12,Exe('F0'))
  FormatoCeldas(e:5..e:12,Exe('F2'))
  FormatoCeldas(i:5..l:12,Exe('F2'))
  FormatoCeldas(m:5..m:12,Exe('F0'))
  FormatoCeldas(n:5..n:12,Exe('F2'))
  FormatoCeldas(o:5..o:12,Exe('F0'))
  FormatoCeldas(p:5..p:12,Exe('F2'))

ENDIF
