sql.add(" AND   D.Archivo     = 'DNCCHY' ")
Act(ar:1, Val(pt:1)~'DNCCHY-'~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".TXT")
