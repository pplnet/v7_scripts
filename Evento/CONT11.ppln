MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;

findialogo

if (not ok)
Raise('Evento Cancelado')
endif


if (dialogo.radio1 = 2 o dialogo.radio1 = 4)
if (FinDeMes(dialogo.fecha1) = dialogo.fecha1)
Message('--- Asientos Revaluo Fin de Mes NDF ---')
Acd(fe:1, PriDeMes(dialogo.fecha1))
Act(ta:1, Var('TIPASRVNDF'))
Acn(na:1, Var('ASINUM'))
Act(vc:1, dialogo.vehiculo1)
Acn(xx:1, 0)
Acn(xx:2, 0)
Sqladd("SELECT '"~IdxDate(dialogo.fecha1)~"' as  Fecha, O.Vehiculo1, ")
Sqladd("       (Select sum(MTM) from "~Dbo()~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' and MD.Fecha >= "~IdxDate2(Val(fe:1))~" and MD.Fecha <= "~IdxDate2(dialogo.fecha1)~") as AcumARPMTM, ")
Sqladd("       O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, C.PaisDir,O.Cuenta4 as Cuenta1, ")
Sqladd("       O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Especie, O.Book1, ")
Sqladd("       (SELECT PrecioContable FROM "~Dbo()~".COTIZACIONES WHERE Codigo=O.Especie and Fecha="~IdxDate2(dialogo.fecha1)~" and CallPut='CON' And Moneda='"~Var('MONELOCA')~"' ) as Cotizacion ,")
Sqladd("       O.TipoOp, O.NrOperacion, O.Cliente1 Cliente , O.Mercado4, ")
Sqladd("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
Sqladd("       (Select sum(MTMEspecie) from "~Dbo()~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'MTM' and MD1.Fecha >= "~IdxDate2(Val(fe:1))~" and MD1.Fecha <= "~IdxDate2(dialogo.fecha1)~" ) as AcumEspMTM ")
Sqladd("  FROM "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".MERCADOS M, "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C ")
Sqladd(" WHERE O.TipoOp IN ('FXCF','FXVF') ")
Sqladd("   AND C.Codigo       = O.Cliente1 ")
Sqladd("   AND MA.TipoAsiento = '"~Var('TIPASRVNDF')~"' ")
Sqladd("   AND O.FechaOp      <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND O.FechaVto     >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   AND O.Mercado4     = M.Codigo ")
Sqladd("   AND M.MTM          = 0 ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
recorrer sql
Acd(fv:1, dialogo.fecha1)
Acd(fd:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, '')
Act(nr:1, Fbn('NrOperacion'))
Act(nr:2, '')
Acn(re:1, Fbn('AcumARPMTM') - (Fbn('AcumEspMTM') * Fbn('Cotizacion')))
if (Eqstr(Fbn('Mercado4'), Var('MERROFEX')))
Act(ct:1, Var('RDOROFEX'))
else 
Act(ct:1, Query("Select Cuenta from "~Dbo()~".RELACIONCUENTA   where Book = '"~Fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~Fbn('TipoOp')~"%' "))
endif
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~' - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
endif
endif
