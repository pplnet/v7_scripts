* Dar de Baja Variables de Seguridad

CrearDialogo
  Variable1 : 'Variable' ;;;;;;EqStr(BuscarCampo('VARIABLES','Cotiza','Codigo',Dialogo.Variable1),'S');'Codigo de Variable Invalido';NO;;;;;;"Cotiza ='S'";
FinDialogo
if not Ok
  Cancelar
else
  ACT(a1, SQL('Select Valor from '~DBO~'.VARIABLES where Codigo = "'~Dialogo.Variable1~'" '))
  ACT(a2, Dialogo.Variable1)
  CrearDialogo
    String    : 'Valor'   ;;;;NO;;;;;Val(a1)
    Variable1 : 'Variable';;;;NO;;;;;;Val(a2)
  FinDialogo
  if OK
    SQL.ADD('Delete '~DBO~'.VARIABLES  where Codigo="'~Dialogo.Variable1~'" ')
    SQL.NEW
    SQL.EXEC
  endif
endif


