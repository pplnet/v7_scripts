*- Este evento Testea las funciones de repactacion de tasas para el Sistema Frances
MostrarCuadroDeMensajes
HojaVisible(SI)
CrearDialogo
  Fecha1       : "Fecha Vigencia"    ;;;;NO;;Dialogo.Fecha1<>0 y Dialogo.Fecha1<=Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  NrOperacion1 : "Operacion"         ;;;;;; 
  Radio3:        "HOLA|UPDATE|1"                 ;;;;;;;;;;1;
FinDialogo

If Not Ok
   Cancelar
Endif
*- re1: 0 Real 1 Simulado
ACN(re1,1)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

SetFilaActual(1)

ACT(d:FAC  ,"Informe de Reseto de Tasas del "~Dialogo.Fecha1)
ACT(e:FAC+1," T A S A S     E S T I M A D A S")
SetFont(a:fac..e:fac+5,3)

SetFilaActual(fac+2)

ACT(a:FAC, 'Tasa Tipo')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'NrOperacion')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Entidad')
ACT(f:FAC, 'FInicio')
ACT(g:FAC, 'FFin')
ACT(h:FAC, 'Plazo')
ACT(i:FAC, 'Especie')
ACT(j:FAC, 'V.Nominal')
ACT(k:FAC, 'Imp.Amort.')
ACT(l:FAC, '% Tasa')
ACT(m:FAC, 'Spread')
ACT(n:FAC, 'Tasa Total')
ACT(o:FAC, 'Interes')
ACT(p:FAC, 'WHT')
ACT(q:FAC, 'IVA')
ACT(r:FAC, 'CEC Total')
ACT(s:FAC, 'CEC Var')
