*- av: Ut IVA aw: UT WH
ACT(av:fac, 'Tasa Int IVA')
ACT(aw:fac, 'Tasa Int WH')

SetFont(a:fac..ah:fac,2)
AgregarMarco(a:FAC..ah:FAC,2,0,Exe('COLOR'))
ifa

*- Operaciones Multiple Vto
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,O.Cuotas1,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,C.Cantidad1,C.Cantidad2,C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,' ' as Pata,C.Cantidad3,C.Cantidad4,O.OperacionRef,O.TotalAux4  ")
SQL.ADD(" from  "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
SQL.ADD("       and O.TipoOp In ('MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMONM','MMPCCM') ")
SQL.ADD("       and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
* SQL.ADD("       and O.TipoTasa<>'FIJA' ")
SQL.ADD(" Union ")
*- Operaciones Unico Vto
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,O.Cuotas1,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.Cantidad Cantidad1,O.Cantidad Cantidad2,0 Total5,O.Plazo Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaOp Fecha1,O.FechaVto Fecha2,0 Total6,0 Precio3,0 Cantidad7, '0' Check1,0 Cantidad4,0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,' ' as Pata, 0 Cantidad3,0 Cantidad4,O.OperacionRef,O.TotalAux4 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMFRN','MMFRNP','MMPSC','MMPSI','MMPCL','MMPCOS','MMPE','MMPI','MMPLME','MMON','MMPCCV') ")

IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
* SQL.ADD(" and O.TipoTasa<>'FIJA' ")

SQL.ADD(" Order By 1,2,3,4")

act(ct1,'')
acn(ct2,0)
act(ct3,'')
 

Recorrer SQL
  *- Por cada cambio de tipo de tasa Selecciono de la tabla de cotizaciones la cotizacion
     * Recupero la Tasa 
   MESSAGEBOX('Tipo Tasa '~FBN['TipoTasa'])
   MESSAGEBOX('TASA leida '~Dialogo.Fecha1)

     ACN(TS:1, 0)
     SQL.ADD(" Select T.Valor1 From "~DBO~".TASASDIA T ")
     SQL.ADD(" Where TipoTasa = '"~fbn('TipoTasa')~"' ")
     SQL.ADD(" AND Fecha = (Select Max(Fecha) From "~DBO~".TASASDIA T1 ")
     SQL.ADD("              Where T.TipoTasa = T1.TipoTasa ")
     SQL.ADD("              AND T1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
 
     Recorrer SQL
         DFA
         ACN(TS:1, fbn('Valor1'))
     Proximo
     acn(ct1,FBN['TipoTasa'])
   
   
  * MessageBox('Cargo Datos Tipo de Tasa:... '~FBN['TipoTasa'])

    MessageBox('Cargo Datos NrOperacion :... '~' '~FBN['NrOperacion'])
    MESSAGEBOX('TASA leida '~val(TS:1))


  ACT(a:fac, FBN['TipoTasa'])
  ACT(b:fac, FBN['TipoOp'])
  ACT(c:fac, FBN['NrOperacion'])
  ACLO(c:fac, FBN['NrOperacion'])
  ACT(d:fac, FBN['Vehiculo1'])
  ACT(e:fac, FBN['Cliente1'])
  ACT(i:fac, FBN['Especie'])

   ACD(f:fac, FBN['Fecha1'])
   ACD(g:fac, FBN['Fecha2'])
   ACN(h:fac, FBN['Plazo1'])

   *- j: VN k: Amor
   ACN(j:fac, FBN['Cantidad2'])
   ACN(k:fac, FBN['Cantidad1'])
   ACN(l:fac, VAL(ts1))
   FormatoCeldas(l:fac..l:fac,EXE('F8'))
   ACN(af:fac,FBN['NrCuota'] )
   ACN(w:fac,FBN['Cuotas1']-FBN['NrCuota'] +1 )

   If Incluido(FBN['TipoOp'],'MMFRNP|MMPSI|MMPCL|MMPCOS|MMPE|MMPI|MMPLME|MMON|MMPCCV|')
      ACD(f:fac, FBN['FechaOp'])
      ACD(g:fac, FBN['FechaVto'])
      ACN(h:fac, FBN['Plazo'])

      *- j: VN k: Amor
      ACN(j:fac, FBN['PrecioEj'])
      ACN(k:fac, FBN['PrecioEj'])
      ACN(m:fac, FBN['Spread'])
   EndIf

   If Incluido(FBN['TipoOp'],'MMFIMV|MMONM|MMSIMV|')
      ACN(k:fac, FBN['Cantidad4'])
      MessageBox('INPUT FUNCION pf (k:fac):. '~' '~FBN['Cantidad4'])
   EndIf

   If Incluido(FBN['TipoOp'],'MMFRN|MMPCCV|MMPSC|MMPSI|')
      ACN(j:fac, FBN['Cantidad'])
      ACN(k:fac, FBN['Cantidad'])
   EndIf

   * q:fac=iva, p:fac=wh, o:fac=interes, ab:fac=interes total, z:fac=monto, aa:fac=monto total, r:fac=cec total
   * t:fac=cen total, s:fac=cec imp var, u:fac=cen variable, ac:fac=impuesto extr
   * v:fac: Impto.Interes x:fac: Imp.IVA.CEN y:fac: Imp_Cs_Fin_CEC

   ACT(i3,val(c:fac))

   If Incluido(FBN['TipoOp'], 'MMPEM|MMPIM|')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])   
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      * IF Val(aS:fac) = 1 and Val(w:fac) = 6
       act(ZZ:1,'0')
       (.'RTPEMPIM'.)
       MessageBox (' Update  ')
       (.'RTUPPEMPIM'.)
      * endif
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPCLM')     
      ACN(av:fac, FBN['Tasa2'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(w:fac) = 5
         act(ZZ:1,'0')
*         MESSAGEBOX('TASA'~val(L:fac))
         (.'RTPCLM'.)
*         MessageBox (' Update  ')
         (.'RTUPPCLM'.)
      endif     
   EndIf

    If EQSTR(FBN['TipoOp'], 'MMPOSM')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])
      (.'RTPOSM'.)
      If Dialogo.Radio3=1
       MessageBox (' Update CUOTAS  '~val(av:fac))
         (.'RTUPPOSM'.)
      EndIf
   EndIf



       


   If EQSTR(FBN['TipoOp'], 'MMONM')
      ACN(av:fac, FBN['Tasa2'])    
      ACN(aw:fac, FBN['Total6'])
      
      MESSAGEBOX('Encontro el Registro: Marca Frances '~val(aS:fac))
      MESSAGEBOX('Nro de Cuota  '~val(w:fac))
        
      IF EQSTR (val(aS:fac),'1')   
         IF Val(w:fac) = 5
            act(ZZ:1,'0')
      MESSAGEBOX('TASA'~val(L:fac))
            (.'RTONM'.)
      MessageBox (' No Update  ')
*           (.'RTUPONM'.)
          endif
      endif
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPCCM')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])
      (.'RTPCCM'.)
      If Dialogo.Radio3=1
      MESSAGEBOX('MODIFICA MAESTRO')
         (.'RTUPPCCM'.)
      EndIf
   EndIf

 

   If Incluido(FBN['TipoOp'], 'MMFIMV|MMSIMV')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])  
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      MESSAGEBOX('aS...'~val(aS:fac)~'  w:fac...'~val(w:fac) )  
      IF EQSTR (val(aS:fac),'1')   
         IF Val(w:fac) = 6      
            act(ZZ:1,'0')
            MESSAGEBOX('J'~val(j:fac))              
            MESSAGEBOX('L'~val(L:fac))
            MESSAGEBOX('W'~val(W:fac))
         (.'RTFIMV'.)

            If Dialogo.Radio3=1
              (.'RTUPFIMV'.)
            EndIf      
         ENDif
       endif
       
   EndIf
 
   If Incluido(FBN['TipoOp'], 'MMPE|MMPI')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])     
      act(ZZ:1,'0')
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      (.'RTPEPI'.)
      If Dialogo.Radio3=1
       (.'RTUPPEPI'.)
      EndIf
*MESSAGEBOX('J'~val(j:fac))              
*MESSAGEBOX('L'~val(L:fac))
*MESSAGEBOX('W'~val(W:fac))
*MESSAGEBOX('K Amortiz.'~val(K:fac))              
*MESSAGEBOX('Z Cuota '~val(Z:fac))
*MESSAGEBOX('O Interes '~val(O:fac))
   EndIf

   If Incluido(FBN['TipoOp'],'MMPCL')
      ACN(av:fac, FBN['TotalAux4'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      act(ZZ:1,'1')
      (.'RTPCL'.)
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPCOS')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      act(ZZ:1,'1')
      (.'RTPCOS'.)
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMON')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      act(ZZ:1,'1')
      (.'RTON'.)
   EndIf

   If EQSTR(FBN['TipoOp'],'MMPCCV')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      act(ZZ:1,'1')
      (.'RTPCCV'.)
   EndIf

   If Incluido(FBN['TipoOp'],'MMPSI|MMFRNP|')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])
      IF Val(AV:fac) = 0
          ACN(av:fac, Val(TS:1))
      ENDIF
      IF Val(AW:fac) = 0
          ACN(AW:fac, Val(TS:1))
      ENDIF
      act(ZZ:1,'1')
      (.'RTPSI'.)
   EndIf

   If Incluido(FBN['TipoOp'],'MMPSC|')
      act(ZZ:1,'1')
      (.'RTPSC'.)
   EndIf


   If Incluido(FBN['TipoOp'],'MMFRN|')
      act(ZZ:1,'1')
      (.'RTFRN'.)
   EndIf

   SetFont(a:fac..ae:fac,1)
   FormatoCeldas(h:fac,EXE('F0'))
