mostrarcuadrodemensajes
creardialogo
fecha1: 'F.Desde ';2;;;;;;;;;FSys()
fecha2: 'F.Hasta';3;;;;;;;;;Habiles(FSys(), 2, 'ARG', NO)
check1: 'Precancela:';4;;;;;;;;0
findialogo

if (not ok)
Cancelar()
endif

Acn(ch:1, dialogo.check1)


sql.add(" Select O.NrOperacion, O.Cliente1, O.Especie, O.Cantidad, O.Precio1, O.TotalBrutoCli1, ")
sql.add(" O.TipoCambio3, O.FechaOp, O.FechaVto, O.FechaVto2, O.FechaPago, O.TipoOp, ")
sql.add(" O.ContraEspecie, O.Especie1, O.RB6, O.Precio2 ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where O.NrOperacion = B.NrOperacion ")
sql.add(" AND B.NrBit = 10 ")
sql.add(" AND B.Valor = '1' ")
sql.add(" AND O.TipoOp In ('FXVT','FXCT') ")
sql.add("  and (O.FechaVto2 Between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"') ")
sql.add("  and O.RB10 = '1' ")
Acn(z1, 0)
recorrer sql
if (sql(" Select 1 From "~Dbo()~".MOVEJECUTADOS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1)
Scn(z1, 1)
Act(a:Val(z1), Fbn()['NrOperacion'])
Act(b:Val(z1), Fbn()['Cliente1'])
Act(c:Val(z1), Fbn()['Especie'])
Acn(e:Val(z1), Fbn()['Cantidad'])
Acn(f:Val(z1), Fbn()['Precio1'])
Acn(g:Val(z1), Fbn()['TotalBrutoCli1'])
Acn(t:Val(z1), Fbn()['TipoCambio3'])
Acd(j:Val(z1), Fbn()['FechaOp'])
Acd(k:Val(z1), Fbn()['FechaVto'])
Acn(l:Val(z1), 0)
Acd(m:Val(z1), Fbn()['FechaVto2'])
Acd(n:Val(z1), Fbn()['FechaPago'])
Acn(v:Val(z:1), Fbn('Precio2'))
Act(p:Val(z1), Fbn()['TipoOp'])
if (Fbn('RB6') = 0 o Eqstr(Fbn('Especie1'), Fbn('ContraEspecie')))
Act(u:Val(z:1), Fbn('ContraEspecie'))
Acn(lc:Val(z:1), 1)
else
Act(u:Val(z:1), Fbn('Especie1'))
Acn(lc:Val(z:1), 0)
if (Eqstr(Fbn('Especie1'), Fbn('Especie')))
Acn(lq:Val(z:1), 1)
else
Acn(lq:Val(z:1), 0)
endif
endif
else
Dfa()
endif
proximo

if (Val(z1) = 0)
Cancelar()('No existen Non-Deliverable para Valuar')
endif

ACO(1, 9)
ACO(2, 9)
ACO(3, 6)
ACO(4, 6)
ACO(5, 12)
ACO(6, 12)
ACO(7, 15)

FormatoCeldas(f1..f:Val(z1), exe('F9'))
FormatoCeldas(i1..i:Val(z1), exe('F9'))

AlinearCeldas(e:1..g:fac, 'D')

crearlistbox;'Arial,8,'
'Confirma';l1..l:fac;SI;;;60;check;RGB(220, 220, 193);
'NrOperacion';a1..a:fac;NO;;;70;string;;RGB(220, 220, 220);
'TipoOp';p1..p:fac;NO;;;50;string;;RGB(220, 220, 220);
'FechaOp';j1..j:fac;NO;;;60;fecha;RGB(220, 220, 220);
'Fixing Date';m1..m:fac;Val(ch:1) = 1;;;60;fecha;iif (Val(ch:1) = 0, RGB(220, 220, 220), RGB(220, 220, 193));
'FechaVto';k1..k:fac;Val(ch:1) = 1;;;60;fecha;iif (Val(ch:1) = 0, RGB(220, 220, 220), RGB(220, 220, 193));
'FechaPago';n1..n:fac;Val(ch:1) = 1;;;60;fecha;iif (Val(ch:1) = 0, RGB(220, 220, 220), RGB(220, 220, 193));
'Cliente';b1..b:fac;NO;;;70;string;;RGB(220, 220, 220);
'Moneda';c1..c:fac;NO;;;50;string;;RGB(220, 220, 220);
'Moneda Liq.';u:1..u:fac;NO;;;70;string;;RGB(220, 220, 220);
'Cantidad';e1..e:fac;NO;;;90;numero;'##,###,###.##';RGB(220, 220, 220);
'PrecioOp';f1..f:fac;NO;;;80;numero;'##,###.########';RGB(220, 220, 220);
'Cierre en ARP';t1..t:fac;SI;Val(t:flb) > 0 o Val(l:flb) = 0;;80;numero;'##,###.########';RGB(220, 220, 193);
'Cot.ARP en Mon.Liq';v:1..v:fac;SI;Val(l:flb) = 0 o (Val(v:flb) > 0 y Val(lc:flb) <> 1 y Val(lq:flb) <> 1) o (Val(lc:flb) = 1 y Val(v:flb) = 0) o (Val(lq:flb) = 1 y Val(v:flb) = 0);;110;numero;'##,###.########';RGB(220, 220, 193);
'Resultado ARP';o1..o:fac;NO;;;90;numero;'##,###,###.##';RGB(220, 220, 220);iif (Val(t:flb) > 0, (Val(t:flb) - Val(f:flb)) * Val(e:flb) * iif (Eqstr(Val(p:flb), 'FXCT'), -1, 1), 0)
'Resultado Mon.Liq';w:1..w:fac;NO;;;100;numero;'##,###,###.##';RGB(220, 220, 220);iif (Val(t:flb) > 0, (Val(t:flb) - Val(f:flb)) * Val(e:flb) * iif (Eqstr(Val(p:flb), 'FXCT'), -1, 1) * iif (Val(lc:flb) = 1, 1, iif (Val(lq:flb) = 1, 1 / Val(t:flb), 1 / Val(v:flb))), 0)
finlistbox

if (ok)
recorrer&i 1, Fac()
if (Val(l:&i) = 1)
Message(' Actualizando Movimientos Operacion '~Val(a:&i))
sql.add(" Update "~Dbo()~".OPERACIONES Set ")
sql.add(" TipoCambio3   = "~FStr(Val(t:&i), 0, 8)~",  ")
if (Val(v:&i) > 0)
sql.add(" Precio2 = "~FStr(Val(v:&i), 0, 2)~", ")
endif
if (Val(ch:1) = 1)
sql.add(" FechaVto2 = "~IdxDate2(Val(m:&i))~", ")
sql.add(" FechaVto  = "~IdxDate2(Val(k:&i))~", ")
sql.add(" FechaPago = "~IdxDate2(Val(n:&i))~", ")
endif
sql.add(" TotalNetoCli1 = "~FStr(Val(w:&i), 0, 2)~" ")
sql.add(" Where NrOperacion ='"~Val(a:&i)~"'")
sql.new
sql.exec

if (Val(ch:1) = 1)
sql.actualizarmovimientos3(Val(a:&i), SI, NO, NO, SI, SI)
else
sql.actualizarmovimientos3(Val(a:&i), SI, NO, NO, SI, NO)
