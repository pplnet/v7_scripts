creardialogo
vehiculo1: 'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
fecha1:'Fecha';;;;;;SI o NoVacio(dialogo.fecha1) y dialogo.fecha1 >= FSys() - Var('DIASPAR');'Fecha Operacion Desde Incorrecta';NO;FSys()
book1:'Cartera';;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

Acn(mar1, 0)

sql.add("SELECT M.FechaMov ")
sql.add("FROM   "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVPOSEJE M ")
sql.add(" Where O.NrOperacion = M.NrOperacion ")
sql.add("   and M.FechaMov    <= '"~IdxDate(dialogo.fecha1)~"'  ")
sql.add("   and M.Cantidad   >= 0 ")
sql.add("   and M.NrSaldo     = '101' ")
sql.add("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.TipoNegocio = 'T' ")
sql.add("   and O.TipoOp = 'TIC'  ")
if (NoVacio(dialogo.book1))
sql.add("   and M.Book     = '"~dialogo.book1~"' ")
endif
sql.add("   and O.NrOperacion Not In  ")
sql.add("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
sql.add("GROUP BY M.FechaMov ")
sql.add(" UNION ALL ")
sql.add("SELECT M.FechaMov ")
sql.add("FROM   "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M ")
sql.add(" Where T.NrTrans     = M.NrOperacion ")
sql.add("   and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"'  ")
sql.add("   and M.Cantidad   >= 0 ")
sql.add("   and M.NrSaldo     = '101' ")
sql.add("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.TipoNegocio = 'T' ")
if (NoVacio(dialogo.book1))
sql.add("   and M.Book     = '"~dialogo.book1~"' ")
endif
sql.add("   and T.NrTrans     Not In  ")
sql.add("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
sql.add("GROUP BY M.FechaMov ")

Act(k1, '')
recorrer sql

sql.add(" Select M.NrSaldo, O.FechaOp, O.Vehiculo1, O.Especie, M.Cantidad, M.Precio, ")
sql.add("        O.FechaVto, O.TipoOp, O.NrOperacion, M.Book, M.Cupon, M.FechaMov ")
sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVPOSEJE M ")
sql.add(" Where O.NrOperacion = M.NrOperacion ")
sql.add("   and M.FechaMov    = '"~IdxDate(Fbn()['FechaMov'])~"' ")
sql.add("   and M.Cantidad   >= 0 ")
sql.add("   and M.NrSaldo     = '101' ")
sql.add("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.TipoNegocio = 'T' ")
if (NoVacio(dialogo.book1))
sql.add("   and M.Book     = '"~dialogo.book1~"' ")
endif
sql.add("   and O.NrOperacion Not In  ")
sql.add("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
sql.add(" Union All ")
sql.add(" Select M.NrSaldo, T.Fecha1 as FechaOp, T.Vehiculo1, T.Especie, M.Cantidad, ")
sql.add("        M.Precio, T.Fecha1 FechaVto, T.TipoTr2 TipoOp,T.NrTrans NrOperacion, ")
sql.add("        M.Book, M.Cupon, M.FechaMov ")
sql.add(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M ")
sql.add(" Where T.NrTrans     = M.NrOperacion ")
sql.add("   and M.FechaMov    = '"~IdxDate(Fbn()['FechaMov'])~"' ")
sql.add("   and M.Cantidad   >= 0 ")
sql.add("   and M.NrSaldo     = '101' ")
sql.add("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
sql.add("   and M.TipoNegocio = 'T' ")
if (NoVacio(dialogo.book1))
sql.add("   and M.Book     = '"~dialogo.book1~"' ")
endif
sql.add("   and T.NrTrans Not In  ")
sql.add("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
sql.add(" Order By 7, 3, 4, 10, 12, 1, 11")

Acn(aa5, 0)

recorrer sql
Scn(mar1, 1)

if ((Fbn()['FechaVto'] <> Val(aa3)) o (not Eqstr(Fbn()['Vehiculo1'], Val(aa2))) o (not Eqstr(Fbn()['Especie'], Val(aa1))) o (Fbn()['Cupon'] <> Val(aa7)) o (Fbn()['NrSaldo'] <> Val(aa4)) o (not Eqstr(Fbn()['Book'], Val(aa6)))) y (Val(aa5) <> 0)

Acn(e:fac, Val(ee1))
Acn(f:fac, Val(ff1) / Val(ee1))
Acd(j:fac, Val(j:fac - 1))
Acd(fe:1, dialogo.fecha1)
Acd(fe:2, Val(fe:99))

Acn(ts:1, 0)
sql.add(" Select TiposTasas, DiasMes, DiasAnio, Fecha, TasaCER, MonedaEmision, TasaIntVigente, TasaMin, TasaMax, Spread ")
sql.add(" From "~Dbo()~".ESPECIES ")
sql.add(" Where Codigo = '"~Val(aa:1)~"' ")
recorrer sql
Dfa()
Act(em:1, Fbn('MonedaEmision'))
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
Acn(ts:1, Fbn('TasaIntVigente'))
else
Acn(mi:1, Fbn('TasaMin'))
Acn(mx:1, Fbn('TasaMax'))
Acn(sp:1, Fbn('Spread'))
sql.add(" Select T.Valor1 From "~Dbo()~".TASASDIA T ")
sql.add(" Where TipoTasa = '"~Fbn('TiposTasas')~"' ")
sql.add(" AND Especie = '"~Fbn('MonedaEmision')~"' ")
sql.add(" AND Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T1 ")
sql.add("              Where T.TipoTasa = T1.TipoTasa ")
sql.add("              AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Dfa()
if (Val(mi:1) > Fbn('Valor1'))
Acn(ts:1, Val(mi:1))
else
if (Val(mx:1) < Fbn('Valor1'))
Acn(ts:1, Val(mx:1))
else
Acn(ts:1, Fbn('Valor1'))
endif
endif
Scn(ts:1, Val(sp:1))
proximo
endif
proximo

creardialogo:6
especie1:'Especie';1;1;;NO;;;;;Val(aa1)
entero1:'Cupon';2;1;;NO;NO;;;;Val(aa7)

vehiculo1:'Vehiculo';1;2;;NO;;;;;Val(aa2)
fecha2:'FechaOp';2;1;;NO;;;;;Val(fe: 99)
fecha1:'VtoOpe';2;2;;NO;;;;;Val(aa3)
especie2:'Moneda';4;1;;NO;;;;;Val(em: 1)
cuenta1:'Cta Custodia';4;2;;NO;;;;;&ctacustodia
cantidad1:'Cantidad';5;1;;NO;;dialogo.cantidad1 > 0;'La Cantidad debe ser positiva';NO;Val(e: Fac())
precio1:'PPP ME';;1;;NO;;dialogo.precio1 > 0;'El PPP debe ser positivo';NO;Val(f: Fac())
cantidad2:'Monto';;1;;NO;;dialogo.cantidad2 > 0;'La Cantidad debe ser positiva';NO;Val(e: Fac()) * Val(f: Fac())

book1:'Book';8;1;;NO;;;;;Val(aa6)

precio2:'TIR';10;1;;;;dialogo.precio2 <> 0;'La Tir debe ser distinta que cero';NO;tirespecie(dialogo.especie1, Val(fe: 2), dialogo.precio1, Val(ts: 1));;;;'###,###.###############';;;;
precio3:'TTransf';10;2;;;;dialogo.precio3 > 0;'La Tasa debe ser mayor que cero';NO;Var('COSTO')
findialogo

if (ok)
Act(nu1, getnumerador(17))

Message('Grabo Partida '~Val(nu1))
sql.add("Insert Into "~Dbo()~".OPERACIONES ")
sql.add("( FechaOp, Especie, Cantidad, Precio1, ")
sql.add("  TipoOp, NrOperacion, Vehiculo1,  ")
sql.add("  TotalNetoCli1, TotalNetoCli2,TotalNetoCli3 ,")
sql.add("  TotalBrutoCli1, TipoCambio, TipoCambio2, Cliente1, ")
sql.add("  FechaVto, Book1, Cupon1, ContraEspecie, ")
sql.add("  Cuenta1, FechaCargaSys, FechaCarga ")
sql.add(" ) Values ( ")
sql.add(" '"~IdxDate(Val(fe:2))~"', '"~dialogo.especie1~"', ")
sql.add(" "~FStr(dialogo.cantidad1, 0, 2)~", "~FStr(dialogo.precio1, 0, 8)~",")
sql.add(" 'PARTID', '"~Val(nu1)~"', '"~dialogo.vehiculo1~"', ")
sql.add(" "~FStr(dialogo.cantidad1, 0, 2)~", 0, 0, ")
sql.add(" "~FStr(dialogo.cantidad2, 0, 2)~", "~FStr(dialogo.precio2, 0, 8)~", ")
sql.add(" "~FStr(dialogo.precio3, 0, 8)~", '"~dialogo.vehiculo1~"', ")
sql.add(" '"~IdxDate(Val(fe:2))~"', '"~dialogo.book1~"', "~FStr(dialogo.entero1, 0, 0)~", '"~Val(em:1)~"', ")
sql.add(" '"~dialogo.cuenta1~"', '"~IdxDate(FSys())~"', "~SQLAhora()~" ")
sql.add(" ) ")
sql.new

sql.add(" Insert Into "~Dbo()~".OPERACIONESBITS ")
sql.add(" (NrOperacion, NrBit, Valor) ")
sql.add(" Values ")
sql.add(" ('"~Val(nu:1)~"', 70, '1') ")
sql.new

sql.add(" Select O.Cantidad, O.NrOperacion, O.TipoOp, O.FechaVto, O.Precio1, O.ContraEspecie, E.MonedaEmision, O.PrecioPartida, 0 Tipo ")
sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".ESPECIES E Where O.Especie = E.Codigo ")
sql.add(" AND O.NrOperacion In ("~pipe2comillas(Val(k:1))~") ")

sql.add(" Union All ")

sql.add(" Select T.Cantidad1, T.NrTrans as NrOperacion, T.TipoTr2 as TipoOp, ")
sql.add(" T.Fecha1 FechaVto, ")
sql.add(" Case T.TipoTr2 When 'TRPOS' Then T.Precio2 Else T.Precio1 End Precio1, ")
sql.add(" E.Cotiza ContraEspecie, E.MonedaEmision, T.PrecioPartida, 1 Tipo ")
sql.add(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".ESPECIES E ")
sql.add(" Where T.Especie = E.Codigo ")
sql.add(" AND T.NrTrans In ("~pipe2comillas(Val(k:1))~") ")
sql.add(" AND T.TipoTr2 IN ('DTP','TRPOS') ")
recorrer sql
Message('Registrando asociacion '~Fbn('NrOperacion')~'/'~Val(nu1))
let(&preciome, Fbn('PrecioPartida'))
sql.add(" Insert Into "~Dbo()~".PARTIDAS                            ")
sql.add(" ( NrOperacion,NrPartida,Cantidad,FechaDesde,FechaHasta,TipoAct, Precio1, Precio2) ")
sql.add(" Values (   '"~Fbn('NrOperacion')~"','"~Val(nu1)~"',             ")
sql.add(" "~FStr(Fbn('Cantidad'), 0, 2)~",'"~IdxDate(dialogo.fecha2)~"',    ")
sql.add(" '"~IdxDate(Fbn('FechaVto'))~"','"~Fbn('TipoOp')~"', "~FStr(Fbn('Precio1'), 0, 8)~", "~FStr(&preciome, 0, 8)~" )            ")
sql.new
if (Fbn('Tipo') = 0)
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set NrPartida = '"~Val(nu:1)~"' ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
else
sql.add(" Update "~Dbo()~".TRANSACCIONES2 ")
sql.add(" Set NrPartida = '"~Val(nu:1)~"' ")
sql.add(" Where NrTrans = '"~Fbn('NrOperacion')~"' ")
endif
sql.new
proximo
sql.exec
sql.add(" Select TiposTasas, DiasMes, DiasAnio, Fecha, TasaCER From "~Dbo()~".ESPECIES ")
sql.add(" Where Codigo = '"~dialogo.especie1~"' ")
recorrer sql
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
Dfa()
endif
proximo
endif



Acn(ee1, 0)
Acn(ff1, 0)
Act(k1, '')
endif

if ((Fbn()['FechaVto'] <> Val(aa3)) o (not Eqstr(Fbn()['Vehiculo1'], Val(aa2))) o (not Eqstr(Fbn()['Especie'], Val(aa1))) o (Fbn()['Cupon'] <> Val(aa7)) o (Fbn()['NrSaldo'] <> Val(aa4)) o (not Eqstr(Fbn()['Book'], Val(aa6))))
Acd(aa3, Fbn()['FechaVto'])
Act(aa2, Fbn()['Vehiculo1'])
Act(aa1, Fbn()['Especie'])
Acn(aa7, Fbn()['Cupon'])
Acn(aa4, Fbn()['NrSaldo'])
Act(aa6, Fbn()['Book'])
Acn(aa5, Fac())

Acn(ee1, 0)
Acn(ff1, 0)
Act(k1, '')
endif

Acd(b:fac, Fbn()['FechaOp'])
Act(c:fac, Fbn()['Vehiculo1'])
Act(d:fac, Fbn()['Especie'])
Scn(ee1, Fbn()['Cantidad'])
Scn(ff1, Fbn()['Cantidad'] * Fbn()['Precio'])
Acd(g:fac, Fbn()['FechaVto'])
Act(h:fac, Fbn()['TipoOp'])
Act(i:fac, Fbn()['NrOperacion'])
Acn(l:fac, Fbn()['Cupon'])
Act(m:fac, Fbn()['Book'])

Act(k1, Val(k1)~Fbn()['NrOperacion']~'|')
proximo

if (Val(aa5) <> 0)
Acn(e:fac, Val(ee1))
Acn(f:fac, Val(ff1) / Val(ee1))
Acd(j:fac, Val(j:fac - 1))
Acd(fe:1, dialogo.fecha1)
Acd(fe:2, Val(fe:99))

Acn(ts:1, 0)
sql.add(" Select TiposTasas, DiasMes, DiasAnio, Fecha, TasaCER, MonedaEmision, TasaIntVigente, TasaMin, TasaMax, Spread ")
sql.add(" From "~Dbo()~".ESPECIES ")
sql.add(" Where Codigo = '"~Val(aa:1)~"' ")
recorrer sql
Dfa()
Act(em:1, Fbn('MonedaEmision'))
if (Eqstr(Fbn('TiposTasas'), 'FIJA') o Eqstr(Fbn('TasaCER'), 'FIJ'))
Acn(ts:1, Fbn('TasaIntVigente'))
else
Acn(mi:1, Fbn('TasaMin'))
Acn(mx:1, Fbn('TasaMax'))
Acn(sp:1, Fbn('Spread'))
sql.add(" Select T.Valor1 From "~Dbo()~".TASASDIA T ")
sql.add(" Where TipoTasa = '"~Fbn('TiposTasas')~"' ")
sql.add(" AND Especie = '"~Fbn('MonedaEmision')~"' ")
sql.add(" AND Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T1 ")
sql.add("              Where T.TipoTasa = T1.TipoTasa ")
sql.add("              AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
recorrer sql
Dfa()
if (Val(mi:1) > Fbn('Valor1'))
Acn(ts:1, Val(mi:1))
else
if (Val(mx:1) < Fbn('Valor1'))
Acn(ts:1, Val(mx:1))
else
Acn(ts:1, Fbn('Valor1'))
endif
endif
Scn(ts:1, Val(sp:1))
proximo
endif
