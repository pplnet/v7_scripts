creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 <= FSys();'La Fecha NO DEBE ser superior a la fecha del sistema';NO;FSys()
especie1: 'Especie';
check1:'Procesa';;;;;;;;;0;
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.check1 = 0)
HojaVisible(SI)
endif



SetFilaActual(1)
Act(k:fac, 'Ini')
Act(m:fac, 'Fin')
Act(m:fac, 'His')
Act(q:fac, 'Con')
Act(t:fac, 'Res')
Sqladd(" SELECT  P.*  FROM "~Dbo()~".POSICIONES P  ")
Sqladd(" where P.Fecha <= "~IdxDate2(dialogo.fecha1)~"  ")
Sqladd(" AND   (P.CantidadFin <> 0  OR P.CantidadIni<>0 )  ")
Sqladd(" AND   (P.TipoNegocio <> 'TIT' OR P.TipoNegocio IS NULL)  ")
Sqladd(" AND   P.Especie     <> '"~Var('MONELOCA')~"'  ")
if (NoVacio(dialogo.especie1))
Sqladd(" AND  P.Especie = '"~dialogo.especie1~"'  ")
endif
Sqladd(" AND     P.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES ")
Sqladd("                    WHERE  Especie  = P.Especie  ")
Sqladd("                     AND   Fecha   <= "~IdxDate2(dialogo.fecha1))
Sqladd("                     AND   Especie     <> '"~Var('MONELOCA')~"'  ")
Sqladd("                     AND   NrSaldo  = P.NrSaldo  ")
Sqladd("                     AND   Vehiculo = P.Vehiculo ")
Sqladd("                     AND   Book     = P.Book     ")
Sqladd("                     AND   Cliente  = P.Cliente  ")
Sqladd("                     AND   (Trader       = P.Trader       OR ((Trader       IS NULL OR Trader=''       OR Trader=' ')       AND (P.Trader       IS NULL OR P.Trader=''       OR P.Trader=' '       )) )  ")
Sqladd("                     AND   (TipoNegocio  = P.TipoNegocio  OR ((TipoNegocio  IS NULL OR TipoNegocio=''  OR TipoNegocio=' ')  AND (P.TipoNegocio  IS NULL OR P.TipoNegocio=''  OR P.TipoNegocio=' '  )) )  ")
Sqladd("                     AND   (Responsable  = P.Responsable  OR ((Responsable  IS NULL OR Responsable=''  OR Responsable=' ')  AND (P.Responsable  IS NULL OR P.Responsable=''  OR P.Responsable=' '  )) )  ")
Sqladd("                     AND   (TipoPosicion = P.TipoPosicion OR ((TipoPosicion IS NULL OR TipoPosicion='' OR TipoPosicion=' ') AND (P.TipoPosicion IS NULL OR P.TipoPosicion='' OR P.TipoPosicion=' ' )) )  ")
Sqladd("                     AND   (Producto     = P.Producto     OR ((Producto     IS NULL OR Producto=''     OR Producto=' ')     AND (P.Producto     IS NULL OR P.Producto=''     OR P.Producto=' '     )) )  ")
Sqladd("                     AND   (GrupoEspecie = P.GrupoEspecie OR ((GrupoEspecie IS NULL OR GrupoEspecie='' OR GrupoEspecie=' ') AND (P.GrupoEspecie IS NULL OR P.GrupoEspecie='' OR P.GrupoEspecie=' ' )) )  ")
Sqladd("                     AND   (Unidad       = P.Unidad       OR ((Unidad       IS NULL OR Unidad=''       OR Unidad=' ')       AND (P.Unidad       IS NULL OR P.Unidad=''       OR P.Unidad=' '       )) )  ")
Sqladd("                     AND   (Centro       = P.Centro       OR ((Centro       IS NULL OR Centro=''       OR Centro=' ')       AND (P.Centro       IS NULL OR P.Centro=''       OR P.Centro=' '       )) )  ")
Sqladd("                     AND   (Sector       = P.Sector       OR ((Sector       IS NULL OR Sector=''       OR Sector=' ')       AND (P.Sector       IS NULL OR P.Sector=''       OR P.Sector=' '       )) )  ")
Sqladd("                     AND   (Sucursal     = P.Sucursal     OR ((Sucursal     IS NULL OR Sucursal=''     OR Sucursal=' ')     AND (P.Sucursal     IS NULL OR P.Sucursal=''     OR P.Sucursal=' '     )) )  ")
Sqladd("                     AND   (CallPut      = P.CallPut      OR ((CallPut      IS NULL OR CallPut=''      OR CallPut=' ')      AND (P.CallPut      IS NULL OR P.CallPut=''      OR P.CallPut=' '      )) )  ")
Sqladd("                     AND   (Estrategia   = P.Estrategia   OR ((Estrategia   IS NULL OR Estrategia=''   OR Estrategia =' ')   AND (P.Estrategia  IS NULL OR P.Estrategia=''   OR P.Estrategia=' '   )) )  ")
Sqladd("                     AND   (PrecioEj     = P.PrecioEj     OR ((PrecioEj     IS NULL OR PrecioEj=0) AND (P.PrecioEj IS NULL OR P.PrecioEj=0  )) )  ")
Sqladd("                     AND   (FechaEj      = P.FechaEj      OR (FechaEj IS NULL AND P.FechaEj IS NULL) )   ")
Sqladd("                     AND   (Cartera      = P.Cartera      OR ((Cartera      IS NULL OR Cartera=''      OR Cartera=' ')       AND (P.Cartera     IS NULL OR P.Cartera=''      OR P.Cartera=' '      )) )  ")
Sqladd("  ) ")

recorrer sql
