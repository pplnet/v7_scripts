MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'Nro emision';;;;;;NoVacio(dialogo.nroperacion1);'Debe Ingresar una Operacion TCPCEM';NO;;;;;;"TipoOp in ('TCPCEM')"
tipoop1: 'Tipo OP';;;;NO;NO;;;;;IIF(NoVacio(dialogo.nroperacion1), Query("SELECT TipoOp FROM "~Dbo()~".OPERACIONES  Where NrOperacion = '"~dialogo.nroperacion1~"' "), '')
check1: 'Procesa';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (not Eqstr(dialogo.tipoop1, 'TCPCEM'))
Cancelar('La Operacion Seleccionada no es TCPCEM --> '~dialogo.tipoop1)
endif
Acn(co:1, Query("select Count(*) from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~dialogo.nroperacion1~"' "))
Acn(in:1, Query("select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and Valor = '1' "))

if (Val(co:1) > 0)
Cancelar('La Operacion Seleccionada esta Liquidada (Anule la  Liquidacion) --> '~dialogo.nroperacion1)
endif

Message('Anulando Cierre Manifestaciones')
Sqladd("SELECT O.NrORDEN, O.Mercado4 ")
Sqladd("  FROM "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" WHERE OB.NrOperacion = O.NrORDEN ")
Sqladd("   AND OB.NrBit       in (170)  ")
Sqladd("   AND OB.Valor       = '1'   ")
Sqladd("   AND O.FechaVto     <="~IdxDate2(dialogo.fecha1))
Sqladd("   AND O.TipoOrden    = 'TMANIF' ")
Sqladd("   AND O.NrOperacion1 = '"~dialogo.nroperacion1~"' ")
Sqladd("   AND IsNull(O.CantidadCompletada,0) = 0 ")
Sqladd("ORDER BY O.NrOrden ")
Watch(Sqlbatch())
recorrer sql
if (dialogo.check1 = 1)
Message('Anulando Cierre Manifestacion '~Fbn('NrOrden'))

if (Eqstr(Fbn('Mercado4'), Var('AMBBYMA')))
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 1, 'entero1', 170, 'entero2', 54)
else
if (Eqstr(Fbn('Mercado4'), Var('AMBMAE')))
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 1, 'entero1', 170, 'entero2', 104)
else
Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 1, 'entero1', 170, 'entero2', 104)
endif
endif
Sqladd(" UPDATE "~Dbo()~".ORDENES")
Sqladd("   SET ESTADO = '' ")
Sqladd(" WHERE NrOrden  = '"~Fbn()['NrOrden']~"' ")
Sqlnew()

Sqladd("Delete "~Dbo()~".MOVLIMITES  ")
Sqladd("Where NrOperacion = '"~Fbn()['NrOrden']~"' and Monto < 0")
Sqlnew()
Sqlexec()
else
Messagebox('Anulando Cierre Manifestacion '~Fbn('NrOrden')~' - No Procesa')
endif
proximo

if (dialogo.check1 = 1)
Message('Anulando Cierre emisiones')

Sqladd(" Update "~Dbo()~".OPERACIONES   ")
Sqladd(" Set RB8 = '0'            ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()

Sqladd("Delete "~Dbo()~".MOVPENDIENTES  ")
Sqladd("Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()
Ejecutarevento('CBOINS', 'string1', dialogo.nroperacion1, 'radio1', 0, 'radio2', 2, 'entero1', Val(in:1), 'entero2', 16)
else
Messagebox('Anulando Cierre emisiones - No Procesa')
endif

