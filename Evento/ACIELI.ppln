mostrarcuadrodemensajes
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'Nro emision';;;;;;NoVacio(dialogo.nroperacion1);'Debe Ingresar una Operacion TCPCEM';NO;;;;;;"TipoOp in ('TCPCEM')"
tipoop1: 'Tipo OP';;;;NO;NO;;;;;if (NoVacio(dialogo.nroperacion1), sql("SELECT TipoOp FROM "~Dbo()~".OPERACIONES  Where NrOperacion = '"~dialogo.nroperacion1~"' "), '')
check1: 'Procesa';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (not Eqstr(dialogo.tipoop1, 'TCPCEM'))
Cancelar()('La Operacion Seleccionada no es TCPCEM --> '~dialogo.tipoop1)
endif
Acn(co:1, sql("select Count(*) from "~Dbo()~".MOVEJECUTADOS where NrOperacion = '"~dialogo.nroperacion1~"' "))
Acn( in :1, sql("select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and Valor = '1' "))

if (Val(co:1) > 0)
Cancelar()('La Operacion Seleccionada esta Liquidada (Anule la  Liquidacion) --> '~dialogo.nroperacion1)
endif

Message('Anulando Cierre Manifestaciones')
sql.add("SELECT O.NrORDEN, O.Mercado4 ")
sql.add("  FROM "~Dbo()~".ORDENES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" WHERE OB.NrOperacion = O.NrORDEN ")
sql.add("   AND OB.NrBit       in (170)  ")
sql.add("   AND OB.Valor       = '1'   ")
sql.add("   AND O.FechaVto     <="~IdxDate2(dialogo.fecha1))
sql.add("   AND O.TipoOrden    = 'TMANIF' ")
sql.add("   AND O.NrOperacion1 = '"~dialogo.nroperacion1~"' ")
sql.add("   AND IsNull(O.CantidadCompletada,0) = 0 ")
sql.add("ORDER BY O.NrOrden ")
Watch(sql.batch())
recorrer sql
if (dialogo.check1 = 1)
Message('Anulando Cierre Manifestacion '~Fbn('NrOrden'))

if (Eqstr(Fbn('Mercado4'), Var('AMBBYMA')))
ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 1, entero1 = 170, entero2 = 54)
else
if (Eqstr(Fbn('Mercado4'), Var('AMBMAE')))
ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 1, entero1 = 170, entero2 = 104)
else
ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 1, entero1 = 170, entero2 = 104)
endif
endif
sql.add(" UPDATE "~Dbo()~".ORDENES")
sql.add("   SET ESTADO = '' ")
sql.add(" WHERE NrOrden  = '"~Fbn()['NrOrden']~"' ")
sql.new

sql.add("Delete "~Dbo()~".MOVLIMITES  ")
sql.add("Where NrOperacion = '"~Fbn()['NrOrden']~"' and Monto < 0")
sql.new
sql.exec
else
Messagebox('Anulando Cierre Manifestacion '~Fbn('NrOrden')~' - No Procesa')
endif
proximo

if (dialogo.check1 = 1)
Message('Anulando Cierre emisiones')

sql.add(" Update "~Dbo()~".OPERACIONES   ")
sql.add(" Set RB8 = '0'            ")
sql.add(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new

sql.add("Delete "~Dbo()~".MOVPENDIENTES  ")
sql.add("Where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.new
sql.exec
ejecutarevento('CBOINS', string1 = dialogo.nroperacion1, radio1 = 0, radio2 = 2, entero1 = Val( in :1), entero2 = 16)
else
Messagebox('Anulando Cierre emisiones - No Procesa')
endif

