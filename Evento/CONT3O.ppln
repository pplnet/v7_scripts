Sqladd("                        Where CU.NrOperacion = O.NrOperacion ")
Sqladd("                        AND CU.Check8 = 1 and CU.Fecha2 <= "~IdxDate2(Val(v:5))~"  ) ")
Sqladd("        OR (Select Max(CU.Fecha2) From "~Dbo()~".CUOTAS CU ")
Sqladd("            Where CU.NrOperacion = O.NrOperacion ")
if (Val(v:2) = Val(v:5))
Sqladd("            AND CU.Fecha2 < '"~IdxDate(Val(v:2))~"') Is Null) ")
else
Sqladd("            AND CU.Fecha2 <= '"~IdxDate(Val(v:2))~"') Is Null) ")
endif
Sqladd(" AND ((Select Max(CU.Fecha2) From dbo.CUOTAS CU Where CU.NrOperacion = O.NrOperacion AND CU.Fecha2 = '"~IdxDate(Val(v:5))~"') Is Null AND O.TipoOp <> 'MMDPAC' ")
Sqladd("              OR O.TipoOp = 'MMDPAC') ")
Sqladd(" AND (    (O.FechaVto  > '"~IdxDate(Val(v:5))~"' AND (O.TipoOp like  'MM%' OR O.TipoOp in ('SEPVMV','SEPTMV')) ) ")
Sqladd("       OR (O.FechaVto2 > '"~IdxDate(Val(v:5))~"' AND O.TipoOp in ('SERP','SERA'))  ")
Sqladd("       OR (O.FechaEj   > '"~IdxDate(Val(v:5))~"' AND O.TipoOp in ('DTSFV','DTSFF')) ")
Sqladd("       OR (O.TipoOp IN ('MMRPAC')) ")

Sqladd("       OR (O.TipoOp in ('DTSFVM','DTSFFM') AND  ")
Sqladd("           (Select Max(CU.Fecha2) From dbo.CUOTAS CU Where CU.NrOperacion = O.NrOperacion ) > '"~IdxDate(Val(v:5))~"')  )   ")
Sqladd(" AND (O.TipoOp <> 'MMRPAC' OR (O.CB2 Is Null OR O.CB2 = '' OR O.CB2 = ' ' OR O.CB2 = 0)) ")
Sqladd(" group by O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo, O.Cliente1, O.NrOperacion, ")
Sqladd(" MD.TipoDevengado, O.Observaciones, O.Precio1, O.Plazo, O.Cantidad, O.MB3, O.CB5, V.Alias4, O.TotalNetoCli1, ")
Sqladd(" O.FechaVto, O.FechaVto2, O.Indice, O.FechaOp, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, O.Book1 ")

Sqladd(" UNION ")

Sqladd(" Select O.TipoOp, O.Vehiculo1, O.Especie, V.Valor1, V.Valor2, M.Codigo CodAsi, 0 Devengado, ")
Sqladd(" O.Especie Moneda, O.Cliente1, O.NrOperacion, 'INTLEN' TipoDevengado, O.Observaciones, O.Precio1, O.Plazo, ")
Sqladd(" O.Cantidad, O.MB3, '' Alias8, O.CB5, V.Alias4, O.TotalNetoCli1, O.FechaVto, O.FechaVto2, O.Indice, O.FechaOp, ")
Sqladd(" O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, O.Book1 Book ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V, "~Dbo()~".MODELOSASIENTO M ")
Sqladd("   Where O.FechaOp     <=  "~IdxDate2(Val(v:2))~" ")
Sqladd("   and ((O.TipoOp  like  'MM%' AND O.TipoOp <> 'MMDPAC') OR O.TipoOp in ('DTSFV','DTSFVM','DTSFF','DTSFFM','SERP','SERA','SEPVMV','SEPTMV')) ")
