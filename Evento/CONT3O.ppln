Acn(ck:99, 0)
Sqladd(" Select O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo CodAsi, Sum(MD.Monto) Devengado, ")
Sqladd(" MD.Especie Moneda, C.Fecha2 FechaVto, O.NrOperacion, O.Cliente1, MD.TipoDevengado, O.Observaciones, O.Precio1, ")
Sqladd(" O.Plazo, O.Cantidad, O.MB3, '' Alias8, O.CB5, C.Cantidad2, C.Fecha1, V.Alias4, O.FechaEj, O.TotalNetoCli1, ")
Sqladd(" O.FechaVto2, C.Cantidad2Ori CantOri, O.Indice, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, 'MV' Tipo, C.NrCuota ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVDEVENGADOS MD, "~Dbo()~".VEHICULOS V, "~Dbo()~".MODELOSASIENTO M, ")
Sqladd(" "~Dbo()~".CUOTAS C ")
Sqladd(" Where C.Fecha2 <= '"~IdxDate(dialogo.fecha1)~"' AND C.Fecha2 >= '"~IdxDate(Val(v:6))~"' ")
Sqladd("   and ( (O.TipoOp  like  'MM%' AND O.TipoOp <> 'MMDPAC' ) OR O.TipoOp in ('DTSFVM','DTSFFM','SEPVMV','SEPTMV') ) ")
Sqladd("   and O.NrOperacion =  MD.NrOperacion ")
Sqladd("   and O.NrOperacion =  C.NrOperacion ")
Sqladd("   and MD.Fecha      >= DATEADD(mm, DATEDIFF(mm,0,C.Fecha2), 0) ")
Sqladd("   and MD.Fecha      <=  C.Fecha2 ")
Sqladd("   AND (MD.Fecha > (Select Max(C1.Fecha2) From "~Dbo()~".CUOTAS C1 ")
Sqladd("                   Where C.NrOperacion = C1.NrOperacion ")
Sqladd("                   AND C1.Fecha2 < '"~IdxDate(Val(v:6))~"') ")
Sqladd("        OR (Select Max(C1.Fecha2) From "~Dbo()~".CUOTAS C1 ")
Sqladd("            Where C.NrOperacion = C1.NrOperacion ")
Sqladd("            AND C1.Fecha2 < '"~IdxDate(Val(v:6))~"') Is Null) ")
Sqladd("   and O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND M.Habilitado = 'SI' ")
Sqladd(" AND M.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") OR M.Vehiculo1 is null OR M.Vehiculo1 = '' OR M.Vehiculo1 = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd("   and O.Vehiculo1   =  V.Codigo ")
Sqladd("   and M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVT'))~") ")
Sqladd("   and M.TipoOp      = O.TipoOp ")
Sqladd(" group by O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo, C.Fecha2, O.NrOperacion, ")
Sqladd(" O.Cliente1, MD.TipoDevengado, O.Observaciones, O.Precio1, O.Plazo, O.Cantidad, O.MB3, O.CB5, C.Cantidad2, ")
Sqladd(" C.Fecha1, V.Alias4, O.FechaEj, O.TotalNetoCli1, O.FechaVto2, C.Cantidad2Ori, O.Indice, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, C.NrCuota ")

Sqladd(" UNION ")

Sqladd(" Select O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, MA.Codigo CodAsi, Sum(MD.Monto) Devengado, ")
Sqladd(" MD.Especie Moneda, O.FechaVto, O.NrOperacion, O.Cliente1, MD.TipoDevengado, O.Observaciones, O.Precio1, ")
Sqladd(" O.Plazo, O.Cantidad, O.MB3, '' Alias8, O.CB5, O.Cantidad Cantidad2, O.FechaOp Fecha1, V.Alias4, O.FechaEj, ")
Sqladd(" O.TotalNetoCli1, O.FechaVto2, O.CantidadOri CantOri, O.Indice, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, 'UV' Tipo, 0 NrCuota ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVDEVENGADOS MD, "~Dbo()~".VEHICULOS V, "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" Where  ( O.TipoOp IN  ('MMO','MMCAUA','MMCAUP','MMCCR','DTSFV','DTSFF','SERP','SERA','MMDC') OR    ")
Sqladd("          (O.TipoOp = 'MMDPAC' AND O.RB10 =1 )   )  ")
Sqladd(" AND (  (O.FechaVto  <= '"~IdxDate(dialogo.fecha1)~"' AND O.FechaVto  >= '"~IdxDate(Val(v:6))~"' AND  O.TipoOp IN ('MMO','MMCAUA','MMCAUP','MMCCR','MMDPAC','MMDC') )")
Sqladd("     OR (O.FechaVto2 <= '"~IdxDate(dialogo.fecha1)~"' AND O.FechaVto2 >= '"~IdxDate(Val(v:6))~"' AND O.TipoOp IN ('SERP','SERA')  )")
Sqladd("     OR (O.FechaEj   <= '"~IdxDate(dialogo.fecha1)~"' AND O.FechaEj   >= '"~IdxDate(Val(v:6))~"' AND O.TipoOp in ('DTSFV','DTSFF')  )")
Sqladd("  )  ")
Sqladd("   and O.NrOperacion =  MD.NrOperacion ")
Sqladd("   and MD.Fecha   >= "~IdxDate2(Val(v:4))~" ")
Sqladd("   and O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") OR MA.Vehiculo1 is null OR MA.Vehiculo1 = '' OR MA.Vehiculo1 = ' ' ) ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd("   and O.Vehiculo1   =  V.Codigo ")
Sqladd("   and MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVT'))~") ")
Sqladd("   and MA.TipoOp      = O.TipoOp ")
Sqladd(" AND (O.Cuotas1 Is Null OR O.Cuotas1 = '' OR O.Cuotas1 = 0) ")
Sqladd(" group by O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, MA.Codigo, O.FechaVto, O.NrOperacion, ")
Sqladd(" O.Cliente1, MD.TipoDevengado, O.Observaciones, O.Precio1, O.Plazo, O.Cantidad, O.MB3, O.CB5, ")
Sqladd(" O.Cantidad, O.FechaOp, V.Alias4, O.FechaEj, O.TotalNetoCli1, O.FechaVto2, O.CantidadOri, O.Indice, ")
Sqladd(" O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16 ")

Sqladd(" UNION ")

Sqladd(" Select O.TipoOp, O.Vehiculo1, O.Especie, V.Valor1, V.Valor2, M.Codigo CodAsi, 0 Devengado, ")
Sqladd(" O.Especie Moneda, C.Fecha2 FechaVto, O.NrOperacion, O.Cliente1, 'INTLEN' TipoDevengado, O.Observaciones, O.Precio1, ")
Sqladd(" O.Plazo, O.Cantidad, O.MB3, '' Alias8, O.CB5, C.Cantidad2, C.Fecha1, V.Alias4, O.FechaEj, O.TotalNetoCli1, ")
Sqladd(" O.FechaVto2, C.Cantidad2Ori CantOri, O.Indice, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, 'UV' Tipo, C.NrCuota ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V, "~Dbo()~".MODELOSASIENTO M, "~Dbo()~".CUOTAS C ")
Sqladd(" Where C.Fecha2 <= '"~IdxDate(dialogo.fecha1)~"' AND C.Fecha2 >= '"~IdxDate(Val(v:6))~"' ")
Sqladd("   and ( (O.TipoOp  like  'MM%' AND O.TipoOp <> 'MMDPAC' ) OR O.TipoOp in ('DTSFVM','DTSFFM','SEPVMV','SEPTMV') ) ")
Sqladd("   and O.NrOperacion =  C.NrOperacion ")
Sqladd(" AND (Select Distinct MD.NrOperacion from MOVDEVENGADOS MD Where MD.NrOperacion = O.NrOperacion and TipoDevengado = 'INTLEN') is NULL ")
Sqladd("   and O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND M.Habilitado = 'SI' ")
Sqladd(" AND M.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") OR M.Vehiculo1 is null OR M.Vehiculo1 = '' OR M.Vehiculo1 = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND O.Vehiculo1 IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd("   and O.Vehiculo1   =  V.Codigo ")
Sqladd("   and M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVT'))~") ")
Sqladd("   and M.TipoOp      = O.TipoOp ")
Sqladd(" group by O.TipoOp, O.Vehiculo1, O.Especie, V.Valor1, V.Valor2, M.Codigo, C.Fecha2, O.NrOperacion, ")
Sqladd(" O.Cliente1, O.Observaciones, O.Precio1, O.Plazo, O.Cantidad, O.MB3, O.CB5, C.Cantidad2, ")
Sqladd(" C.Fecha1, V.Alias4, O.FechaEj, O.TotalNetoCli1, O.FechaVto2, C.Cantidad2Ori, O.Indice, O.RB10, O.Indice, O.Precio5, O.TipoTasa, O.RB16, C.NrCuota ")

recorrer sql
