Acn(cp:2, Query(" Select Sum(Cantidad3Ori) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(fv:1) + Var('PLCAPCORR'))~"'  "))
else
