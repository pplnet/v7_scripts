if (Incluido(Fbn('TipoOp'), 'MMPEM|MMPIM|MMPCCM|SEPVMV|'))
Acn(cp:1, Query(" Select Sum(Cantidad1) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(fv:1) + Var('PLCAPCORR'))~"' AND Fecha2 >= '"~IdxDate(Val(fv:1))~"' "))
