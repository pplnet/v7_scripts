MostrarCuadroDeMensajes
Recorrer&k 1, 2
    IF &k = 1
        SQL.ADD(" Update "~DBO~".MOVPENDIENTES ")
    ELSE
        SQL.ADD(" Update "~DBO~".MOVEJECUTADOS ")
    ENDIF
    SQL.ADD(" Set Leyenda = 'IVA Comision CEN' ")
    SQL.ADD(" Where Leyenda = 'Vto. Comision CEN' ")
    SQL.ADD(" AND (NrMov = 7 OR NrMov = 8 OR NrMov > 3000) ")
    SQL.NEW
Proximo
SQL.EXEC

