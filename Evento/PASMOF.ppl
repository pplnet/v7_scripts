* Pasar de la Instancia Rechazadas Sup MOF (8) o CF (9) a Concertacion MOF (1) o Concertacion CF (2)
CrearDialogo
  NrOperacion1 : '# Operacion';;;;;;;;;
FinDialogo

if not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

ACN(x1,0)
SQL.ADD("Select O.NrOperacion, RB3 , NrBit from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  where ")
SQL.ADD("O.NrOperacion='"~Dialogo.NrOperacion1~"' and  O.NrOperacion=B.NrOperacion ")
SQL.ADD("and ((NrBit = 8 and Valor = '1' and RB3='1') or (NrBit = 9 and Valor = '1' and (RB3<>'1' or RB3 is null)))  ")
Recorrer SQL
  ACN(x1,1)

  ACN(x2,SQL("Select count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrOperacion')~"' and NrSaldo =1 "))

*  if Val(x2)=0
    if EqStr(fbn('RB3'),'1')
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" SET Valor = '0' ")
      SQL.ADD(" where NrBit=8 and NrOperacion= '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" SET Valor = '1' ")
      SQL.ADD(" where NrBit=1 and NrOperacion= '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.ADD("Update "~DBO~".OPERACIONES set LInstancia= 1 where NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.EXEC       
    else
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" SET Valor = '0' ")
      SQL.ADD(" where NrBit=9 and NrOperacion= '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" SET Valor = '1' ")
      SQL.ADD(" where NrBit=2 and NrOperacion= '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.ADD("Update "~DBO~".OPERACIONES set LInstancia= 2 where NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.NEW
      SQL.EXEC       
    endif
*  else
*    messagebox('La Operacion tiene Liquidaciones')
*  endif
Proximo
if Val(x1)=0
  messagebox('La Operacion no se encuentra en la instancia Rechazadas Sup MOF/CF Correcta')
endif



