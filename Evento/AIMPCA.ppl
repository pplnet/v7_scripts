CrearDialogo
 Fecha1   :'R.Date Desde'                                   ;1;1;;;;;;;Fsys
 Fecha2   :'R.Date Hasta'                                   ;2;1;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'El R.Date Hasta debe ser posterior al R.Date Desde';NO;Fsys
 Fecha3   :'F.Pago Desde'                                   ;1;2;;;;;;;Fsys
 Fecha4   :'F.Pago Hasta'                                   ;2;2;;;;Dialogo.Fecha4>=Dialogo.Fecha3;'La F.Pago Hasta debe ser posterior a la F.Pago Desde';NO;Fsys
 Especie1 :'Especie'                                        ;4;1;;;;;;;
 Cliente1 :'Cliente'                                        ;5;1;;;;[Vacio(Dialogo.Cliente1)] O [Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo', Dialogo.Cliente1), 'CLI') Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo', Dialogo.Cliente1), 'HAB')];'Cliente Invalido';NO;
 Mercado1 :'Mercado'                                        ;4;2;;;;;;;
 Vehiculo1:'Vehiculo'                                       ;5;2;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
 Radio1   :'Tipo|Obligatorias|Optativas'                    ;7;1;;;;;;;0
 Radio2   :'C.Action|P.Divid.|Spin Off|Stk Split|C.de Cupon';8;1;;;Dialogo.Radio1=0;;;;0
 Radio3   :'C.Action|Canje|Rescate|Tender Offer'            ;8;1;;;Dialogo.Radio1=1;;;;0
FinDialogo

if Not Ok
 Cancelar
endif

if [Dialogo.Radio1=0] y [Dialogo.Radio2=0]
 * Pago de Dividendos
 LinkearHoja('IMTPDI',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=0] y [Dialogo.Radio2=1]
 * Spin Off
 LinkearHoja('IMTSPO',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=0] y [Dialogo.Radio2=2]
 * Stock Split
 LinkearHoja('IMTSSP',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=0] y [Dialogo.Radio2=3]
 * Corte de Cupon
 LinkearHoja('IMTCCU',1,Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=1] y [Dialogo.Radio3=0]
 * Canje
 LinkearHoja('IMTCAN',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=1] y [Dialogo.Radio3=1]
 * Rescate
 LinkearHoja('IMTRES',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif

if [Dialogo.Radio1=1] y [Dialogo.Radio3=2]
 * Tender Offer
 LinkearHoja('IMTTEN',1,Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Fecha4=Dialogo.Fecha4, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Mercado1=Dialogo.Mercado1, Vehiculo1=Dialogo.Vehiculo1)
endif
