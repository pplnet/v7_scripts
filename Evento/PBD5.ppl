(.'DNLISTA'.)
ACT(ll:1, Val(l:1))
ACT(l:1, '')

MostrarCuadroDeMensajes
CrearDialogo
  Especie1 : 'Moneda'            ;1;1;;;;NOVACIO(Dialogo.Especie1) ;'Moneda Invalida';NO;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
  Vehiculo1: 'Vehiculo'          ;1;2;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Fecha1   : 'Fecha Mov'         ;2;1;;;;;;;FSYS
  Radio1   : 'Desde|FPA|DATANET' ;3;1;;;;;;;0
  Cuenta1  : 'Cuenta'            ;4;1;;;Dialogo.Radio1=0;;;;;;;;;"Estado = 'HAB' AND Cliente='"~Dialogo.Vehiculo1~"' AND (Especies LIKE '%"~Dialogo.Especie1~"%' OR Especies LIKE '%MONEDA%' ) "
  Label1   : ''          ;5; ;;NO;;;;;'Concilia por ______________________________________________________________________'
  Check1   : 'Fecha'     ;6; ;;;;;;;1
  Check2   : 'NrComprob' ;7; ;;;;;;;1
  Check3   : 'Importe'   ;8; ;;;;;;;1
  Cantidad1: 'Tolerancia';8;2;;;Dialogo.Check3=0;Dialogo.Cantidad1>0;'Rango de Tolerancia Invalido';NO;1
  Label1   : ''          ;9;1;;NO;;;;;'_______________________________________________________________________________________'
  Lista1   : 'Archivo'   ; ;;;Dialogo.Radio1=1;;Novacio(Dialogo.Lista1) o Dialogo.Radio1=0;'Codigo de Archivo Invalido';NO;;;Val(ll:1)
FinDialogo

If Not Ok
   Cancelar
Endif

ACN(ch:3, Dialogo.Check3)
ACN(ch:1, Dialogo.Check1)
ACN(ch:2, Dialogo.Check2)
ACN(tl:1, Dialogo.Cantidad1)
ACD(fe:1, Dialogo.Fecha1)
ACT(vh:1, Dialogo.Vehiculo1)

* ---- DE FPA A DATANET ----- *
If Dialogo.Radio1=0
  SQL.ADD(" SELECT /*+ RULE */ M.NrOperacion, M.FechaMov, M.Cuenta, M.Especie, M.Cantidad, ")
  SQL.ADD(" M.NrComprob, M.NrMov, C.Comitente, C.Numero CuentaD, ")
  SQL.ADD(" M.Cliente VehiculoD ")
  SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C, "~DBO~".OPERACIONESBITS B ")
  SQL.ADD(" WHERE M.Cuenta      = C.Codigo ")
  SQL.ADD(" AND   M.NrOperacion = B.NrOperacion ")
  If Dialogo.Fecha1<>0
     SQL.ADD(" AND M.FechaMov = "~IdxDate2(Dialogo.Fecha1)~" ")
  Endif
  SQL.ADD(" AND   B.NrBit       = 18  ")
  SQL.ADD(" AND   B.Valor       = '1' ")
  SQL.ADD(" AND   M.Cliente     = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD(" AND   M.Especie     = '"~Dialogo.Especie1~"' ")
  If NoVacio(Dialogo.Cuenta1)
     SQL.ADD(" AND M.Cuenta  = '"~Dialogo.Cuenta1~"' ")
  Endif
  IF Dialogo.Fecha1 <> 0
     SQL.ADD(" ORDER BY M.Cuenta, M.Especie, C.Comitente ")
  ELSE
     SQL.ADD(" ORDER BY M.FechaMov, M.Cuenta, M.Especie, C.Comitente ")
  ENDIF

  ACN(z:1, 0)
  Recorrer SQL
    message('Transaccion: '~fbn('NrOperacion'))
    SCN(z:1, 1)
    ACN(a:fac, 0)
    ACD(b:fac, fbn('FechaMov') )
    ACT(c:fac, fbn('Comitente') )
    ACT(d:fac, fbn('Cuenta') )
    ACT(e:fac, fbn('Especie') )
    ACN(f:fac, fbn('Cantidad') )
    ACT(g:fac, fbn('NrOperacion') )
    ACT(h:fac, fbn('CuentaD') )
    IF Not Eqstr(fbn('Especie'), Val(ES:1))
        ACT(i:fac, BuscarCampo('ESPECIES','Alias3','Codigo', fbn('Especie')))
    ELSE
        ACT(I:fac, Val(I:fac-1))
    ENDIF
    IF Not Eqstr(fbn('Comitente'), Val(CM:1))
        ACT(J:fac, BuscarCampo('CLIENTES','Alias2','Codigo', fbn('Comitente')))
    ELSE
        ACT(J:fac, Val(J:fac-1))
    ENDIF
    ACT(k:fac, fbn('VehiculoD') )
    If NoVacio(fbn('NrComprob'))
      ACN(l:fac, fbn('NrComprob') )
    Endif
    ACN(m:fac, fbn('NrMov') )
    ACT(p:fac, fbn('CuentaD') )
    ACT(ES:1, fbn('Especie') )
    ACT(CM:1, fbn('Comitente') )
  Proximo

  If Val(z:1)=0
     Message('No se encontraron Movimientos de FPA para conciliar.')
     Cancelar
  Endif

  CrearListBox; 'Arial,8,'
    'OK'            ;a:1..a:FAC;SI;;;30;CHECK;RGB(232,255,215);
    'Fecha Valor'   ;b:1..b:FAC;NO;;;80;FECHA;RGB(232,232,232);
    'Banco'         ;c:1..c:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Cuenta'        ;d:1..d:FAC;NO;;;80;STRING;;RGB(232,232,232);
    'Numero'        ;p:1..p:FAC;NO;;;95;STRING;;RGB(232,232,232);
    'Moneda'        ;e:1..e:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Cantidad'      ;f:1..f:FAC;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
    'Transaccion'   ;g:1..g:FAC;NO;;;70;STRING;;RGB(232,232,232);
  FinListBox

  If Not Ok
     Cancelar('Evento Cancelado.')
  Endif

  Recorrer&i 1,fac
    If Val(a:&i)=1
      message('Transaccion: '~Val(g:&i))
      SQL.ADD(" SELECT /*+ RULE */ M.* FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D ")
      SQL.ADD(" WHERE  M.NrDatanet = D.NrDatanet ")
      If Val(ch:1)=1
         * Misma Fecha
         SQL.ADD(" AND  M.FechaAcreditacion = "~IdxDate2(Val(b:&i))~" ")
      Endif
      SQL.ADD(" AND    M.Vehiculo = '"~Val(k:&i)~"' ")
*05/07/2004 Interfaz Rio  SQL.ADD(" AND    M.Banco    = '"~Val(j:&i)~"' ")
      SQL.ADD(" AND    (M.Banco   = '"~Val(j:&i)~"' OR M.Banco   = '"~Val(c:&i)~"') ")
      SQL.ADD(" AND    M.Cuenta   = '"~Val(p:&i)~"' ")
      SQL.ADD(" AND    M.Moneda   = '"~Val(i:&i)~"' ")
      SQL.ADD(" AND    M.EstadoConciliacion = 'P' ")
      SQL.ADD(" AND    D.EstadoAprobacion   = 'OK' ")
      If Val(ch:2)=1
         * Mismo comprobante
         If Val(l:&i)<>0
            SQL.ADD(" AND M.Comprobante = "~fstr(Val(l:&i),0,0)~" ")
         Else
            SQL.ADD(" AND (M.Comprobante = 0 OR M.Comprobante IS NULL ) ")
         Endif
      Endif
      SQL.ADD(" ORDER BY M.NrDataNet, M.NrMovDatanet ")

      ACN(dz:1, 0)

      Recorrer SQL
        message('NrDatanet: '~fbn('NrDatanet')~' Movimiento: '~fbn('NrMovDatanet'))
        SCN(dz:1, 1)
        ACN(da:Val(dz:1), 0)
        ACT(db:Val(dz:1), fbn('NrDatanet'))
        ACN(dc:Val(dz:1), fbn('NrMovDatanet'))
        ACT(dd:Val(dz:1), fbn('Vehiculo'))
        ACD(de:Val(dz:1), fbn('FechaIngreso'))
        ACD(df:Val(dz:1), fbn('FechaAcreditacion'))
        ACT(dg:Val(dz:1), fbn('Banco'))
        ACT(dh:Val(dz:1), fbn('Cuenta'))
        ACT(di:Val(dz:1), fbn('Moneda'))
        If Eqstr(fbn('DC'),'D')        
           ACN(dj:Val(dz:1), fbn('Importe')*(-1))
        Else
           ACN(dj:Val(dz:1), fbn('Importe'))
        Endif
        ACN(dk:Val(dz:1), fbn('Comprobante'))
      Proximo

      Recorrer&k 1,100000000
      CrearDialogo
        ListBox; 'Arial,8,N';510;100
         'Fecha Valor'   ;b:&i..b:&i;NO;;;;80;FECHA
         'Banco'         ;c:&i..c:&i;NO;;;;70;STRING
         'Cuenta'        ;d:&i..d:&i;NO;;;;80;STRING
         'Moneda'        ;e:&i..e:&i;NO;;;;70;STRING
         'Cantidad'      ;f:&i..f:&i;NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;l:&i..l:&i;NO;;;;70;STRING
         'Transaccion'   ;g:&i..g:&i;NO;;;;70;STRING
        FinListBox

        ListBox; 'Arial,8,N';510;300
         'OK'            ;da:1..de:Val(dz:1);SI;;;;80;CHECK
         'Fecha Valor'   ;df:1..df:Val(dz:1);NO;;;;80;FECHA
         'Banco'         ;dg:1..dg:Val(dz:1);NO;;;;70;STRING
         'Cuenta'        ;dh:1..dh:Val(dz:1);NO;;;;80;STRING
         'Moneda'        ;di:1..di:Val(dz:1);NO;;;;70;STRING
         'Cantidad'      ;dj:1..dj:Val(dz:1);NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;dk:1..dk:Val(dz:1);NO;;;;70;NUMERO;'###,###,###,###'
         'Fecha Ingreso' ;de:1..de:Val(dz:1);NO;;;;80;FECHA
        FinListBox        
      FinDialogo

      If Ok 
        ACN(tt:1,0)
        ACN(tt:2,0)
        ACN(tt:3,0)

        Recorrer&j 1,Val(dz:1)
          If Val(da:&j)=1
             SCN(tt:1,Val(dj:&j))
          Endif
        Proximo

        If Messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'.'~Chr(13)~Chr(10)~'Confirma?',3,2)=6
          If Val(ch:3)=1
            * Concilia por importe
            message('Concilia por importe ...')
            If Val(f:&i)<0
              If [ABS(Val(tt:1)) = ABS(Val(f:&i))] y Val(tt:1)<0
                 ACN(tt:2,1)
              Else
                 ACN(tt:2,0)
              Endif
            Else   
              If [ABS(Val(tt:1)) = ABS(Val(f:&i))] y Val(tt:1)>0
                 ACN(tt:2,1)
              Else
                 ACN(tt:2,0)
              Endif
            Endif
            If Val(tt:2)=0
               messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'.'~Chr(13)~Chr(10)~'La suma de los item es incorrecta.')
            Endif
          Else
            message('No concilia por importe ...')
            * No Concilia por importe, verifico que este dentro del rango de tolerancia

            If ( ABS(ABS(Val(f:&i))-ABS(Val(tt:1))) ) <= Val(tl:1)
               ACN(tt:3,ABS(Val(f:&i))-ABS(Val(tt:1)))
               ACN(tt:2,1)
            Else
               ACN(tt:2,0)
               messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'. '~Chr(13)~Chr(10)~'La suma de los item es incorrecta. Supera el rango de tolerancia.')
            Endif
          Endif

          If Val(tt:2)= 1
             If Val(tt:3)<>0
               SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET Cantidad3 = "~FSTR(Val(tt:3),0,4)~" ")
               SQL.ADD(" WHERE  NrTrans = '"~Val(g:&i)~"' ")
               SQL.NEW
               message('Actualizando Transaccion FPA ...')
             Endif

             SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES SET ")
             SQL.ADD(" Status   = 'OK', ")
             If Val(f:&i)<0
               SQL.ADD(" Cantidad = Cantidad+"~FSTR(Val(tt:3),0,4)~" ")
             Else
               SQL.ADD(" Cantidad = Cantidad-"~FSTR(Val(tt:3),0,4)~" ")
             Endif
             SQL.ADD(" WHERE NrOperacion = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrMov       = "~FSTR(Val(m:&i),0,0)~" ")
             SQL.NEW

             SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
             SQL.ADD(" SELECT /*+ RULE */ * FROM "~DBO~".MOVPENDIENTES ")
             SQL.ADD(" WHERE NrOperacion = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrMov       = "~FSTR(Val(m:&i),0,0)~" ")
             SQL.NEW

             SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES ")
             SQL.ADD(" WHERE NrOperacion = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrMov       = "~FSTR(Val(m:&i),0,0)~" ")
             SQL.NEW

             SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '0' ")
             SQL.ADD(" WHERE NrOperacion = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrBit       = 18 ")
             SQL.NEW

             SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '1' ")
             SQL.ADD(" WHERE NrOperacion = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrBit       = 20 ")
             SQL.NEW
             SQL.EXEC
             message('Actualizando Movimientos FPA ...')
             * ------------------------------------------------------------------------- *

             Recorrer&j 1,Val(dz:1)
               If Val(da:&j)=1
                 * --------------------- Actualiza MovDatanet ------------------------------ *
                 SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVDATANET SET ")
                 SQL.ADD(" EstadoConciliacion = 'OK' ")
                 SQL.ADD(" WHERE NrDatanet    = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrMovDatanet = "~FSTR(Val(dc:&j),0,0)~" ")
                 SQL.NEW
                 message('Actualizando Movimientos Datanet ...')
                 * ----------------- Actualiza Conciliaciones ------------------------------ *
                 SQL.ADD(" INSERT INTO "~DBO~".CONCILIACIONES ( ")
                 SQL.ADD(" Fecha, NrOperacion, NrMovimiento, NrDatanet, NrMovDatanet ")
                 SQL.ADD(" ) VALUES ( ")
                 SQL.ADD(" "~IdxDate2(Fsys)~", '"~Val(g:&i)~"', "~FSTR(Val(m:&i),0,0)~", ")
                 SQL.ADD(" '"~Val(db:&j)~"', "~FSTR(Val(dc:&j),0,0)~" ) ")
                 SQL.NEW
                 SQL.EXEC
                 message('Estado de Conciliaciones ...')
                 * ------------------------------------------------------------------------- *

                 ACN(xx:1, SQL(" SELECT /*+ RULE */ 1 FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(db:&j)~"' AND EstadoConciliacion='P' ") )
                 If Val(xx:1) <> 1
                    Message('Cerrando Conciliacion '~Val(db:&j) )
                    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".DATANET SET Estado = 'C' WHERE NrDatanet = '"~Val(db:&j)~"' ")
                    SQL.NEW
                    SQL.EXEC
                 Endif
                 * ------------------------------------------------------------------------- *
               Endif
             Proximo
            * Fin Importe OK
          Endif

          * Hace que salga del Recorrer K
          Break

        *Del Messagebox
        Endif
      Else
        Break
        * Fin Ok Dialogo de grillas
      Endif

      *Recorrer &K
      Proximo

       * Fin ok de la primer grilla (mov * mov de FPA)
    Endif
  Proximo
  * Para que no siga con la conciliacion DE DATANET A FPA
  Cancelar
Endif

* ---- DE DATANET A FPA ----- *
If Dialogo.Radio1=1
  SQL.ADD(" SELECT /*+ RULE */ M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion, M.Banco, ")
  SQL.ADD(" M.Cuenta, M.Moneda, M.Importe, M.Comprobante, M.TipoMov, M.DC, C.Comitente, ")
  SQL.ADD(" C.Codigo CuentaFPA, E.Codigo MonedaFPA, C.Comitente BancoFPA, M.Vehiculo VehiculoFPA ")
*  SQL.ADD(" C.Comitente BancoFPA, V.Codigo VehiculoFPA ")
  SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, ")
  SQL.ADD(" "~DBO~".DATANET D, "~DBO~".CLIENTES B ")
*  SQL.ADD(" "~DBO~".VEHICULOS V, "~DBO~".DATANET D, "~DBO~".CLIENTES B ")
  SQL.ADD(" WHERE M.Cuenta      = C.Numero  ")
  SQL.ADD(" AND   M.NrDatanet   = D.NrDatanet ")
  SQL.ADD(" AND   M.Moneda      = E.Alias3  ")
  SQL.ADD(" AND   C.Comitente   = B.Codigo  ")
*05/07/2004   SQL.ADD(" AND   M.Banco       = B.Alias2 ")
   SQL.ADD(" AND   (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
*  SQL.ADD(" AND   M.Vehiculo    = V.Codigo  ")
  If Dialogo.Fecha1<>0
    SQL.ADD(" AND M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
  Endif
*  SQL.ADD(" AND   V.Codigo      = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD(" AND   M.Vehiculo     = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD(" AND   E.Codigo      = '"~Dialogo.Especie1~"'   ")
  SQL.ADD(" AND   M.EstadoConciliacion = 'P'  ")
  SQL.ADD(" AND   D.EstadoAprobacion   = 'OK' ")
If NO
* 05/07/2005 - INTERFAZ RIO
  If Dialogo.Radio2=0
    SQL.ADD(" AND   D.Archivo = 'DNCTAS' ")
  Endif
  If Dialogo.Radio2=1
    SQL.ADD(" AND   D.Archivo = 'DNCCDO' ")
  Endif
  If Dialogo.Radio2=2
    SQL.ADD(" AND   D.Archivo = 'DNAHMS' ")
  Endif
  If Dialogo.Radio2=3
    SQL.ADD(" AND   D.Archivo = 'DNCADO' ")
  Endif
  If Dialogo.Radio2=4
    SQL.ADD(" AND   D.Archivo = 'DNOTRO' ")
  Endif
Endif
  SQL.ADD(" AND   D.Archivo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  If NoVacio(Dialogo.Cuenta1)
     SQL.ADD(" AND C.Codigo  = '"~Dialogo.Cuenta1~"' ")
  Endif
  SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion, M.Cuenta ")

  ACN(z:1, 0)
  Recorrer SQL
    message('Datanet: '~fbn('NrDatanet')~' - Mov: '~fbn('NrMovDatanet'))
    SCN(z:1, 1)
    ACN(a:fac, 0)
    ACD(b:fac, fbn('FechaAcreditacion') )
    ACT(c:fac, fbn('Banco') )
    ACT(d:fac, fbn('Cuenta') )
    ACT(e:fac, fbn('Moneda') )
    ACN(f:fac, fbn('Importe') )
    ACT(g:fac, fbn('NrDatanet') )
    ACT(h:fac, fbn('CuentaFPA') )
    ACT(i:fac, fbn('MonedaFPA') )
    ACT(j:fac, fbn('BancoFPA') )
    ACT(k:fac, fbn('VehiculoFPA') )
    If NoVacio(fbn('Comprobante'))
      ACN(l:fac, fbn('Comprobante') )
    Endif
    ACN(m:fac, fbn('NrMovDatanet') )
    ACT(n:fac, fbn('TipoMov') )
    ACT(o:fac, fbn('DC') )
    IF Not Eqstr(fbn('TipoMov'), Val(N:fac-1))
        ACT(DS:fac, BuscarCampo('CODIGOSDATANET','Descripcion','Codigo', fbn('TipoMov')))
    ELSE
        ACT(DS:fac, Val(DS:fac-1))
    ENDIF
  Proximo

  If Val(z:1)=0
    Cancelar('No se encontraron Movimientos de DATANET para conciliar.')
  Endif

  CrearListBox; 'Arial,8,'
    'OK'            ;a:1..a:FAC;SI;;;30;CHECK;RGB(232,255,215);
    'Fecha Valor'   ;b:1..b:FAC;NO;;;80;FECHA;RGB(232,232,232);
    'Banco'         ;c:1..c:FAC;NO;;;60;STRING;;RGB(232,232,232);
    'Cuenta'        ;d:1..d:FAC;NO;;;80;STRING;;RGB(232,232,232);
    'Moneda'        ;e:1..e:FAC;NO;;;50;STRING;;RGB(232,232,232);
    'Cantidad'      ;f:1..f:FAC;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
    'D/C'           ;o:1..o:FAC;NO;;;40;STRING;;RGB(232,232,232);
    'Comprobante'   ;l:1..l:FAC;NO;;;80;NUMERO;'###,###,###';RGB(232,232,232);
    'TipoMov'       ;n:1..n:FAC;NO;;;60;STRING;;RGB(232,232,232);
    'Descripcion'   ;DS:1..DS:fac;NO;;;200;STRING;;RGB(232,232,232);
  FinListBox

  If Not Ok
    Cancelar('Evento Cancelado.')
  Endif

  Recorrer&i 1,fac
    If Val(a:&i)=1
      SQL.ADD(" SELECT /*+ RULE */ M.*, C.Comitente, T.Fecha1 ")
      SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".CUENTAS C, ")
      SQL.ADD(" "~DBO~".TRANSACCIONES2 T ")
      SQL.ADD(" WHERE  M.NrOperacion  = B.NrOperacion ")
      SQL.ADD(" AND    M.NrOperacion  = T.NrTrans ")
      SQL.ADD(" AND    M.Cuenta       = C.Codigo  ")
      If Val(ch:1)=1
        * Misma Fecha
        SQL.ADD(" AND  M.FechaMov = "~IdxDate2(Val(b:&i))~" ")
      Endif
      SQL.ADD(" AND    C.Comitente    = '"~Val(j:&i)~"' ")
      SQL.ADD(" AND    M.Cuenta       = '"~Val(h:&i)~"' ")
      SQL.ADD(" AND    M.Especie      = '"~Val(i:&i)~"' ")
      SQL.ADD(" AND    M.EnteCustodia = '"~Val(k:&i)~"' ")
      SQL.ADD(" AND    B.NrBit       = 18  ")
      SQL.ADD(" AND    B.Valor       = '1' ")
      If Val(ch:2)=1
        * Mismo comprobante
        If Val(l:&i)=0
          SQL.ADD(" AND (M.NrComprob IS NULL OR M.NrComprob = 0) ")
        Else
          SQL.ADD(" AND M.NrComprob = "~fstr(Val(l:&i),0,0)~" ")
        ENdif
      Endif
      SQL.ADD(" ORDER BY M.NrOperacion, M.NrMov ")

      ACN(dz:1, 0)

      Recorrer SQL
        message('Operacion: '~fbn('NrOperacion'))
        SCN(dz:1, 1)
        ACN(da:Val(dz:1), 0)
        ACT(db:Val(dz:1), fbn('NrOperacion'))
        ACN(dc:Val(dz:1), fbn('NrMov'))
        ACT(dd:Val(dz:1), fbn('EnteCustodia'))
        ACD(de:Val(dz:1), fbn('Fecha1'))
        ACD(df:Val(dz:1), fbn('FechaMov'))
        ACT(dg:Val(dz:1), fbn('Comitente'))
        ACT(dh:Val(dz:1), fbn('Cuenta'))
        ACT(di:Val(dz:1), fbn('Especie'))
        ACN(dj:Val(dz:1), fbn('Cantidad'))
        ACN(dk:Val(dz:1), fbn('NrComprob'))
      Proximo

      Recorrer&k 1,100000000
      CrearDialogo
        ListBox; 'Arial,8,N';510;100
         'Fecha Valor'   ;b:&i..b:&i;NO;;;;80;FECHA
         'Banco'         ;c:&i..c:&i;NO;;;;70;STRING
         'Cuenta'        ;d:&i..d:&i;NO;;;;80;STRING
         'Moneda'        ;e:&i..e:&i;NO;;;;70;STRING
         'Cantidad'      ;f:&i..f:&i;NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;l:&i..l:&i;NO;;;;70;STRING
         'NrDatanet'     ;g:&i..g:&i;NO;;;;70;STRING
         'Movimiento'    ;M:&i..M:&i;NO;;;;80;NUMERO;'###,###,###'
        FinListBox

        ListBox; 'Arial,8,N';510;300
         'OK'            ;da:1..de:Val(dz:1);SI;;;;80;CHECK
         'Fecha Valor'   ;df:1..df:Val(dz:1);NO;;;;80;FECHA
         'Banco'         ;dg:1..dg:Val(dz:1);NO;;;;70;STRING
         'Cuenta'        ;dh:1..dh:Val(dz:1);NO;;;;80;STRING
         'Moneda'        ;di:1..di:Val(dz:1);NO;;;;70;STRING
         'Cantidad'      ;dj:1..dj:Val(dz:1);NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;dk:1..dk:Val(dz:1);NO;;;;70;NUMERO;'###,###,###,###'
         'Fecha Ingreso' ;de:1..de:Val(dz:1);NO;;;;80;FECHA
         'Operacion'     ;db:1..db:Val(dz:1);NO;;;;80;STRING
        FinListBox        
      FinDialogo

      If Ok 
        *Suma Cantidad FPA
        ACN(tt:1,0)

        *Marca si el importe es identico
        * 0 Cancela // 1 = confirma // 2 <> confirma.

        ACN(tt:2,0)
        ACN(tt:3,0)

        *Importe de la transaccion por la diferencia.
        ACN(tt:4,0)

        *Tipo Trans
        ACT(tt:5,'')

        Recorrer&j 1,Val(dz:1)
          If Val(da:&j)=1
            SCN(tt:1,Val(dj:&j))
          Endif
        Proximo

        If Messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'.'~Chr(13)~Chr(10)~'Confirma?',3,2)=6

          If Val(ch:3)=1
            *Concilia por Importe
            If Eqstr(Val(o:&i),'D')
              If [ABS(Val(tt:1)) = ABS(Val(f:&i))] y Val(tt:1)<0
                ACN(tt:2,1)
              Else
                ACN(tt:2,0)
              Endif
            Else   
              If [ABS(Val(tt:1)) = ABS(Val(f:&i))] y Val(tt:1)>0
                ACN(tt:2,1)
              Else
                ACN(tt:2,0)
              Endif
            Endif
            If Val(tt:2)=0
              messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'.'~Chr(13)~Chr(10)~'La suma de los item es incorrecta.')
            Endif
          Else
            If (ABS(ABS(Val(f:&i))-ABS(Val(tt:1)))) <= Val(tl:1)
               ACN(tt:2,2)
            Else
               ACN(tt:2,0)
               messagebox('Total seleccionado '~PYC(Val(tt:1),1,2)~'. '~Chr(13)~Chr(10)~'La suma de los item es incorrecta. Supera el rango de tolerancia.')
            Endif
          Endif

          If Val(tt:2)<>0
*          Else
             * ------------------------- Actualiza MovDATANET ------------------------------ *
 
             SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVDATANET SET ")
             SQL.ADD(" EstadoConciliacion = 'OK' ")
             SQL.ADD(" WHERE NrDatanet    = '"~Val(g:&i)~"' ")
             SQL.ADD(" AND   NrMovDatanet = "~FSTR(Val(m:&i),0,0)~" ")
             SQL.NEW
             SQL.EXEC

*             ACN(xx:1, SQL(" SELECT COUNT(*) FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(g:&i)~"' AND EstadoConciliacion='P' ") )
             ACN(xx:1, SQL(" SELECT /*+ RULE */ 1 FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(g:&i)~"' AND EstadoConciliacion='P' ") )

             If Val(xx:1) <> 1
               Message('Cerrando Conciliacion '~Val(g:&i) )
               SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".DATANET SET Estado = 'C' WHERE NrDatanet = '"~Val(g:&i)~"' ")
               SQL.NEW
               SQL.EXEC
             Endif

             Recorrer&j 1,Val(dz:1)
               If Val(da:&j)=1
                 * ----------------- Actualiza Conciliaciones ------------------------------ *
                 SQL.ADD(" INSERT INTO "~DBO~".CONCILIACIONES ( ")
                 SQL.ADD(" Fecha, NrOperacion, NrMovimiento, NrDatanet, NrMovDatanet ")
                 SQL.ADD(" ) VALUES ( ")
                 SQL.ADD(" "~IdxDate2(Fsys)~", '"~Val(db:&j)~"', "~FSTR(Val(dc:&j),0,0)~", ")
                 SQL.ADD(" '"~Val(g:&i)~"', "~FSTR(Val(m:&i),0,0)~" ) ")
                 SQL.NEW
                 SQL.EXEC
                 * ------------------------------------------------------------------------- *
                 message('Actualizando Transaccion: '~Val(db:&j))
                 SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES SET ")
                 SQL.ADD(" Status   = 'OK' ")
                 SQL.ADD(" WHERE NrOperacion = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrMov       = "~FSTR(Val(dc:&j),0,0)~" ")
                 SQL.NEW

                 SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
                 SQL.ADD(" SELECT /*+ RULE */ * FROM "~DBO~".MOVPENDIENTES ")
                 SQL.ADD(" WHERE NrOperacion = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrMov       = "~FSTR(Val(dc:&j),0,0)~" ")
                 SQL.NEW

                 SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES ")
                 SQL.ADD(" WHERE NrOperacion = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrMov       = "~FSTR(Val(dc:&j),0,0)~" ")
                 SQL.NEW

                 SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '0' ")
                 SQL.ADD(" WHERE NrOperacion = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrBit       = 18 ")
                 SQL.NEW

                 SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '1' ")
                 SQL.ADD(" WHERE NrOperacion = '"~Val(db:&j)~"' ")
                 SQL.ADD(" AND   NrBit       = 20 ")
                 SQL.NEW
                 SQL.EXEC
                 * ------------------------------------------------------------------------- *
               Endif
             Proximo

             * ----- No concilia por importe exacto  --------------------------------------- *

             ACN(tt:4, ABS(ABS(Val(tt:1))-ABS(Val(f:&i))) ) 

             If Val(tt:2)=2 y Val(tt:4)<>0
               * El importe no es exacto.
               If Eqstr(Val(o:&i), 'D')
                 If ABS(Val(f:&i))<ABS(Val(tt:1))
                   ACT(tt:5, 'CRVM')
                   ACT(tt:6, GETNUMERADOR(10100))
                   ACT(tt:7, 'AJUSTC')
                 Else
                   ACT(tt:5, 'DEVM')
                   ACT(tt:6, GETNUMERADOR(10101))
                   ACT(tt:7, 'AJUSTD')
                 Endif
               Else
                 If ABS(Val(f:&i))<ABS(Val(tt:1))
                   ACT(tt:5, 'DEVM')
                   ACT(tt:6, GETNUMERADOR(10101))
                   ACT(tt:7, 'AJUSTD')
                 Else
                   ACT(tt:5, 'CRVM')
                   ACT(tt:6, GETNUMERADOR(10100))
                   ACT(tt:7, 'AJUSTC')
                 Endif
               Endif
               * ----------------- Inserta Nueva Transaccion ----------------------------- *

               SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
               SQL.ADD(" ConceptoPago, Fecha1, Fecha2, Fecha3, ")
               SQL.ADD(" Especie, Cantidad1, Cliente2, ")
               SQL.ADD(" Cuenta2, Vehiculo1, UsrInput, ")
               SQL.ADD(" NrTrans, TipoTr2, FechaCarga, FechaCargaSys, ")
               SQL.ADD(" CNFormaPago, Cantidad2, CB2, CB3, CB4, Observaciones ")
               SQL.ADD(" ) VALUES ( ")
               SQL.ADD(" '"~Val(tt:7)~"', "~IdxDate2(Val(fe:1))~", "~IdxDate2(Val(fe:1))~", "~IdxDate2(Val(fe:1))~", ")
               SQL.ADD(" '"~Val(i:&i)~"', "~FSTR(ABS(Val(tt:4)),1,2)~", '"~Val(j:&i)~"', ")
               SQL.ADD(" '"~Val(h:&i)~"', '"~Val(vh:1)~"', '"~USUARIOACTIVO~"', ")
               SQL.ADD(" '"~Val(tt:6)~"', '"~Val(tt:5)~"', "~IdxDate2(fsys)~", "~IdxDate2(fsys)~", ")
               SQL.ADD(" 'DATANE', "~FSTR(Val(tt:4),1,0)~", '0', '0', '0', 'Ajuste de Movimientos Datanet' ")
               SQL.ADD(" ) ")
               SQL.NEW

               Recorrer&k 1,30
                 ACT(jj:1, Fstr(&k,1,0))
                 If Incluido(Val(jj:1),'15|16|17|18|20|25')
                   SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS ")
                   SQL.ADD(" (NrOperacion, NrBit, Valor) ")
                   SQL.ADD(" Values ")
                   SQL.ADD(" ('"~Val(tt:6)~"',"~Fstr(&k,1,0)~",'0') ")
                   SQL.NEW        
                 Endif
               Proximo 

               SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor='1' WHERE NrOperacion = '"~Val(tt:6)~"' AND NrBit=20 ")
               SQL.NEW
               SQL.EXEC

               message('Transaccion '~Val(tt:6)~' generada.')
 
               SQL.ActualizarMovimientosT4(Val(tt:6),SI,NO,NO,NO,NO,NO,0)
               SQL.EXEC
               * ------------------------------------------------------------------------- *

               * ----------------- Actualiza Conciliaciones ------------------------------ *
               SQL.ADD(" INSERT INTO "~DBO~".CONCILIACIONES ( ")
               SQL.ADD(" Fecha, NrOperacion, NrMovimiento, NrDatanet, NrMovDatanet ")
               SQL.ADD(" ) VALUES ( ")
               SQL.ADD(" "~IdxDate2(Fsys)~", '"~Val(tt:6)~"', 1, ")
               SQL.ADD(" '"~Val(g:&i)~"', "~FSTR(Val(m:&i),0,0)~" ) ")
               SQL.NEW
               SQL.EXEC
               * ------------------------------------------------------------------------- *
               message('Actualizando Transaccion: '~Val(tt:6))
               SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES SET ")
               SQL.ADD(" Status   = 'OK' ")
               SQL.ADD(" WHERE NrOperacion = '"~Val(tt:6)~"' ")
               SQL.ADD(" AND   NrMov       = 1 ")
               SQL.NEW
               SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
               SQL.ADD(" SELECT /*+ RULE */ * FROM "~DBO~".MOVPENDIENTES ")
               SQL.ADD(" WHERE NrOperacion = '"~Val(tt:6)~"' ")
               SQL.ADD(" AND   NrMov       = 1 ")
               SQL.NEW

               SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES ")
               SQL.ADD(" WHERE NrOperacion = '"~Val(tt:5)~"' ")
               SQL.ADD(" AND   NrMov       = 1 ")
               SQL.NEW
               SQL.EXEC
             Endif

            * Fin Importe OK
          Endif
          * Hace que salga del Recorrer K
          Break
          *Del Messagebox
        Endif
      Else
        Break
        * Fin Ok Dialogo de grillas
      Endif

      *recorrer k
      Proximo
       * Fin ok de la primer grilla (mov * mov de FPA)
    Endif
  Proximo
Endif