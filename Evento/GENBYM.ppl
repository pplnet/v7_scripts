*** Lee Excel verifica que la orden exista y este en Instancia 54 para mercado variable AMBBYMA
*** Genera ejecuaciones y Operacion
CrearDialogo
  Fecha1  : 'Fecha'              ;;;;NO;;;;;;FSYS
  String1 : 'Path'               ;;;;;;;;;Var('PATHADBYMA')
  String2 : 'Adj BYMA'           ;;;;;;;;;'ADJBYMA.XLS'
  Check1  : 'Generar Operaciones'
FinDialogo
if Not OK
  Cancelar
endif


If Not ExisteDirectorio(Var('PATHADBYMA'))
   Cancelar('Debe Crear el Directorio '~Var('PATHADBYMA'))
Endif

*- Excel Adjudicaciones BYMA
ImportarXLS(a:2..ac:200,ba:1..bc:200,Dialogo.String1~Dialogo.String2)

If Vacio(val(a:2))
   Cancelar('No se ha podido recuperar el archivo Adjudicaciones BYMA')
EndIf

SetFilaActual(1)


ACT(v:5, VAR('AGESIOP'))

ACT(s:1, 'Secuencia2')
ACT(s:2, 'TipoOp')
ACT(s:3, 'Especie')
ACT(s:4, 'Cupon MAE')
ACT(s:5, 'Ag.Contra')
ACT(s:6, 'Num Ag.Contra')
ACT(s:7, 'Clie.Tabla')
ACT(s:8, 'Cliente')
ACT(s:9, 'Op.Contra (A)')
ACT(s:10, 'VTXT3 (A)')
ACT(s:11, 'Cantidad')
ACT(s:12, 'C.Especie')
ACT(s:13, 'PrecioMAE')
ACT(s:14, 'Precio3')
ACT(s:15, 'Precio4')
ACT(s:16, 'Intrereses MAE')
ACT(s:17, 'Nro.Cupon')
ACT(s:18, 'FechaOp txt (A)')
ACT(s:19, 'FechaOp')
ACT(s:20, 'RB5')
ACT(s:21, 'Plazo')
ACT(s:22, 'Mercado')
ACT(s:23, 'F.Liq.1')
ACT(s:24, 'Feriados')
ACT(s:25, 'Operador')
ACT(s:26, 'Op.SIOPEL')
ACT(s:27, 'Cod.MAE Esp.')
ACT(s:28, 'Cuenta1')
ACT(s:29, 'Vechiculo1')
ACT(s:30, 'UND1')
ACT(s:31, 'Mercado4')
ACT(s:32, '# Rueda')
ACT(s:33, 'Pase')
ACT(s:34, 'MAE1 (A)')
ACT(s:35, '# Cta.Ord.')
ACT(s:36, 'Referencia')
ACT(s:37, '# Num.Ref. (A)')
ACT(s:38, 'Cart.Propia (A)')
ACT(s:39, '# Tipo Cli')
ACT(s:40, 'Observ')
ACT(s:41, 'Cant.Ops.')
ACT(s:42, 'Duplicada')
ACT(s:43, 'Op.Anterior')
ACT(s:44, 'Incompleto')
ACT(s:45, 'FechaVto')
ACT(s:46, 'Moneda de Liquidacion')
ACT(s:47, 'Responsable')
ACT(s:48, 'FechaEnvioMAE(txt)')
ACT(s:49, 'FechaEnvioMAE')
ACT(s:50, 'NrOrden')
ACT(s:51, 'z:1')
ACT(s:52, 'Mercado2')
ACT(s:53, 'Nr TMANIF')
ACT(s:54, 'Cli TMANIF')
ACT(s:55, 'Cartera Propia')
ACT(s:56, 'Cliente TCOPRI')
ACT(s:57, 'Agente Contra')
ACT(s:58, 'ZeroCoupon')


ACN(zx:1,0)
Recorrer&i 2,200

   ** Analizar que columnas contienen valor a relacionar con la Orden
   ** buscar datos de la orden para generar la TCOPRI   
   IF Vacio(Val(a:&i))
      Break
   Endif
   SCN(zx:3,1)
   
   IF Not Vacio(Val(c:&i))

        ACT(x:1, 'S')
        ACT(t:2,'TCOPRI')
        ACT(t:5, fbn('AgenteContra'))
        ACT(t:53, fbn('NrOrden'))
        ACT(t:54, BuscarCampo('ORDENES','Cliente','NrOrden',fbn('NrOrden')))
        if Novacio(Val(t:54))
          ACT(u:54, BuscarCampo('CLIENTES','Alias1','Codigo',Val(t:54)))
          ACT(v:54, BuscarCampo('VEHICULOS','Cliente','Codigo',BuscarCampo('ORDENES','Vehiculo','NrOrden',fbn('NrOrden'))))
          if EqStr(Val(u:54),'CP') o EqStr(Val(v:54),Val(t:54))
            * Es Cartera Propia
            ACN(t:55, 1)
          endif
      else
        SCN(z:1,1)
        ACN((26+FAC):2, 1)
      endif
    else
      if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
        ACT(x:1, 'S')
      else
        ACT(x:1, 'F')
      endif
      if EqStr(fbn('Agente'),Val(v:5))
        ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
        if Incluido(fbn('CodigoNego'),'1')
          ACT(t:2,'TIV')
        else
          ACT(t:2,'TIFV')
        endif
        ACT(t:5, fbn('AgenteContra'))
      else
        if EqStr(fbn('AgenteContra'),Val(v:5))
          if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
            ACT(t:50,Copy(fbn('NroOrdenComprador'),7,5))
            if Incluido(fbn('CodigoRueda'),Var('RUELICI'))
              ACT(t:2,'TCOPRI')
            else
              ACT(t:2,'TIC')
            endif
          else
            ACT(t:2,'TIFC')
          endif
          ACT(t:5, fbn('Agente'))
        else
          SCN(z:1,1)
          ACN((26+FAC):2, 1)
        endif
      endif
    endif
    ***** Especie
    ACT(t:27, fbn('CodigoTitulo'))
    ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    if Vacio(Val(t:3))
      EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
      ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
    else
      ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
      if Eqstr(Val(es:2),'DES')
        ACN(es:1,1)
      Endif
    endif
    ***** Cupon MAE
    ACT(t:4, fbn('NroCupon'))
    if EqStr(fbn('CodigoRueda'),'MAE1')
      ACN(t:34, 1)
    endif
    ***** Cliente
    ACN(t:6, Num(Val(t:5)))
    ***** Cliente Tabla
    ACT(t:7, fbn('Cliente'))
    if EqStr(Val(t:5),'000') o EqStr(Val(t:5),Val(v:5))
    * Agente=0  o Agente=Vehiculo
      if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
        * Agente=0  y FCI/AFJP
        ACN((26+FAC):8, 2)
      else
        if Val(t:34)=1
          * MAE1
          ACN((26+FAC):8, 3)
        else
          SCN(z:1,1)
          ACN((26+FAC):8, 1)
        endif
      endif
    else
      ***** Codigo MAE Cliente
      ACT(t:57, Val(t:5))
      ***** Codigo Cliente
      ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
      ***** Operador Contra
      ACT(t:9, fbn('OperadorContra'))
      if Vacio(Val(t:8)) y Not EqStr(Val(t:2),'TCOPRI')
        ACN(cl:1,1)
        ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
      endif
    endif

    ***** Mercado4
    ACT(t:31, Var('AMBMAE'))
    ***** VTXT3
***///***
*    ACT(t:10, CampoMercado(Val(t:31),Val(t:3),Val(t:8),2))
    ***** Cantidad
    ACN(t:11, fbn('Cantidad'))
    if Val(t:11)=0
      SCN(z:1,1)
      ACN((26+FAC):11, 1)
    endif
    ***** ContraEspecie / Mercado2
    if EqStr(fbn('Moneda'),'D')
      ACT(t:12, 'USD')
    else
      if EqStr(fbn('Moneda'),'$')
        ACT(t:12, 'ARP')
      else
*        SCN(z:1,1)
        * Marca Incompleto
        ACN(t:44, 1)
        ACN((26+FAC):12, 1)
      endif
    endif
    ***** PrecioMAE
    ACN(t:13, fbn('Precio'))
    ***** Precio3 / Precio4 / Precio1
    if Eqstr(Val(t:10),'CLE')
      ACN(t:14, Val(t:13))
    else
      ACN(t:15, Val(t:13))
    endif
    ***** InteresesMAE
    ACN(t:16, fbn('Interes'))
** FJL 29-03-19 - Por cupon 0/1 para especies ZeroCoupon
*    ***** Nro Cupon
*    ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    ***** Es ZeroCupon
    ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
    ***** Nro Cupon
    if EqStr(Val(t:58),'SI')    
      ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
    else
      ACT(t:17, Val(t:4))
    endif
    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05') o (EqStr(fbn('CodigoRegistro'),'7020') y EqStr(Copy(fbn('CodRegContestado'),3,2),'05'))
      ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACD(t:19, Fecha(Val(t:18)))
    else
      SCN(z:1,1)
      ACN((26+FAC):19, 1)
    endif
    
    ***** Mercado2 default por contraespecie
    if EqStr(fbn('Moneda'),'D')
      ACT(t:52, 'SWIFT')
    else
      if EqStr(fbn('Moneda'),'$')
        ACT(t:52, 'BCRA')
      else
        * Marca Incompleto
        ACN(t:44, 1)
        ACN((26+FAC):52, 1)
      endif
    endif
    ***** Mercado
    if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
      ACT(t:22, 'AC')
      ACT(t:52, 'AC')
    else
      if EqStr(fbn('EnteLiquidador'),'2')
        ACT(t:22, 'CRYL')
        ACT(t:52, 'BCRA')
      else
        if EqStr(fbn('EnteLiquidador'),'3')
          ACT(t:22, 'CE')
          ACT(t:52, 'CE')
        else
          if EqStr(fbn('EnteLiquidador'),'4')
            ACT(t:22, 'EU')
            ACT(t:52, 'EU')
          else
            if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
              ACT(t:22, 'CV')
            else
              if Incluido(fbn('EnteLiquidador'),'G|F|W|U')
                ACT(t:22, 'MC')
                ACT(t:52, 'MC')
              else
*                SCN(z:1,1)
                * Marca Incompleto
                ACN(t:44, 1)
                ACN((26+FAC):22, 1)
              endif
            endif
          endif
        endif
      endif
    endif

    if Val(t:55)=0
      * La TCOPRI no es Cartera Propia
      ACT(t:22, 'CV')
      ACT(t:52, 'BCRA')
    endif

    ***** FormaLiquidacion
    if EqStr(fbn('TipoLiquidacion'),'2')
      ACN(t:23, 0)
    else
      if EqStr(fbn('TipoLiquidacion'),'1')
        ACN(t:23, 1)
      else
        if EqStr(fbn('TipoLiquidacion'),'6')
          ACN(t:23, 2)
        else
*          SCN(z:1,1)
          * Marca Incompleto
          ACN(t:44, 1)
          ACN((26+FAC):23, 1)
        endif
      endif
    endif
    IF Incluido(Val(T:22), VAR('MERCAACMC'))
      ***** FormaLiquidacion1 = DVP
      ACN(T:23, 1)
    ENDIF
    ***** Operador / OperadorContra
    if Incluido(Val(t:2),'TIV')
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
      ACT(t:26, fbn('OperadorContra'))
    else
      ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
      ACT(t:26, fbn('Operador'))
    endif
    if Vacio(Val(t:25))
      ACT(t:25, UsuarioActivo)
    endif
    ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

    ***** Vehiculo1
    ACT(t:29, Var('VEHICULODE'))

    *** ContraEspecie2 Moneda de Liquidacion ****
    ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
    if EqStr(Val(t:12),'USD')
      if Incluido(Val(t:22),VAR('MERCAACMC'))
        ACT(t:46, 'USD')
        if EqStr(fbn('EnteLiquidador'),'B')
          ACT(t:46, 'USB')
        endif
      endif
      if EqStr(Val(t:22),'CRYL')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'CV')
        ACT(t:46, 'USB')
      endif
      if EqStr(Val(t:22),'EU')
        if EqStr(fbn('TipoOpDestino'),'5') o EqStr(BuscarCampo('CUENTAS','Global','Codigo',Val(t:28)),'S')
          ACT(t:46, 'USD')
        else
          ACT(t:46, 'USB')
        endif
      endif
    endif

    ***** Tabla Feriados
    if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9')
      ACT(t:24, 'USA')
    endif
    if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
      ACT(t:24, 'ARG')
    endif
    if Incluido(Val(t:22),VAR('MERCAACMC'))
      if Incluido(Val(t:46),'ARP|USB')
        ACT(t:24, 'ARG')
      endif
      if EqStr(Val(t:46),'USD')
        ACT(t:24, 'USA')
      endif
    endif
    if Vacio(Val(t:24))
*      SCN(z:1,1)
      * Marca Incompleto
      ACN(t:44, 1)
      ACN((26+FAC):24, 1)
    endif

    if Incluido(fbn('CodigoNego'),'1') o Incluido(fbn('CodigoNego'),Var('TIPONEGLIC'))
      * Es Spot
***/// FJL 24-01-18     
      ***** Plazo
      ACN(t:21, Num(fbn('Plazo'))*24)
      ***** RB5
      if Num(fbn('Plazo'))<=3
        ACT(t:20, FStr(fbn('Plazo'),1,0))
      else
        SCN(z:1,1)
        ACN((26+FAC):20, 1)
      endif
      ***** FechaVto
      ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))
    else
      * Es Futuro
      ***** PlazoGracia
      ACN(t:21, Num(fbn('Plazo')))
      ***** FechaVto
      ACD(t:45, Val(t:19)+Val(t:21))
    endif

    ***** UDN1
    ACT(t:30, 'MD')
    ***** Rueda (UDN2)
    ACT(t:32, fbn('CodigoRueda'))
    ***** PaseCB
    ACT(t:33, '0')
    ***** MAE1
    if Val(t:34)=1
      ***** Datos MAE1
      ACT(t:36, fbn('Referencia'))
      ACN(t:37, Num(Val(t:36)))
      if Val(t:37)=0
        ACN(t:35, 0)
        ACN(t:38, 1)
      else
        if EqStr(fbn('TipoOpOrigen'),'1')
          ** Terceros
          ACN(t:35, 0)
        else
          ACN(t:35, 1)
        endif
      endif

      if EqStr(fbn('TipoOpDestino'),'5')
        * Agente
        ACN(t:39, 0)
      else
        if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
          if EqStr(fbn('TipoOpDestino'),'2')
            * FCI
            ACN(t:39, 1)
          endif
          if EqStr(fbn('TipoOpDestino'),'4')
            * AFJP Fondo
            ACN(t:39, 2)
          endif
          if EqStr(fbn('TipoOpDestino'),'6')
            * AFJP Encaje
            ACN(t:39, 3)
          endif
          if EqStr(fbn('TipoOpDestino'),'7')
            * AFJP Adminis (Cartera Propia)
            ACN(t:39, 4)
          endif
        endif
      endif
    endif

    if DesciendeDeEspecie(Val(t:3),'LETES')
      *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
      ACN(x:2, 1)
    else
      ACN(x:2, 0)
    endif 

    * FJL 10/04/18 - Las TCOPRI llevan el cliente de las TMANIF
    * Cliente definitivo a la Operacion
    * ACT(t:56, Val(t:8))
    ACT(t:56, Val(t:54))
    *if NoVacio(Val(t:53)) 
    *  * FJL 12/04/18 - Solo para las que no son de Cartera Propia
    *  if Val(t:55)=0
    *    ACT(t:56, SQL("Select Cliente From "~DBO~".ORDENES Where NrOrden = '"~Val(t:53)~"' "))
    *  endif
    *endif
    if Vacio(Val(t:56)) y Val(t:34)=1
      * Vacio Cliente y MAE1
      ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
    else
      ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
    endif
    if Val(t:41) = 1
      ACN(t:42, 1)
      if Vacio(Val(t:56)) y Val(t:34)=1
        * Vacio Cliente y MAE1
        ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
      else
      ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
      endif
      SCN(z:1,1)
      ACN((26+FAC):41, 1)

    endif
    if Vacio(Val(t:56))
      * Vacio Cliente
      if Val(t:34)=0
        * NO MAE1
        * Marca Incompleto
        ACN(t:44, 1)
      endif
      ACT(t:56, 'SIOPEL')
      ACN((26+FAC):8, 1)
    endif
    ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
    ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
    ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))

    if Val(z:1)=0
      ACT(b:FAC, 'OK')
      if Dialogo.Check1=1
        ACT(w:6, GetNumerador(1))
        ACT(c:FAC, Val(w:6))
        Message('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:56))
        SQL.ADD("Insert into "~DBO~".OPERACIONES (")
          
        SQL.ADD("NrOperacion, ")
        SQL.ADD("TipoOp, ")
        SQL.ADD("TipoTicket, ")
        SQL.ADD("Especie, ")
        SQL.ADD("Cliente1, ")
          
        SQL.ADD("Cantidad, ")
        SQL.ADD("ContraEspecie, ")
        SQL.ADD("Precio1, ")
          
        SQL.ADD("Cupon1,")
        SQL.ADD("FechaOp, ")
          
        if EqStr(Val(x:1),'S')
          * Spot        
          SQL.ADD("Plazo, ")
          SQL.ADD("RB5, ")
        else
          * Futuro
          SQL.ADD("PlazoGracia, ")
        endif
        SQL.ADD("RB6, ")
        SQL.ADD("FechaVto, ")
        SQL.ADD("Mercado, ")
        SQL.ADD("Mercado2, ")
        SQL.ADD("FormaLiquidacion1, ")
          
        SQL.ADD("TablaFeriados1, ")
        SQL.ADD("Operador, ")
        SQL.ADD("OpSIOPEL, ")
          
        SQL.ADD("EnteCus1, ")
        SQL.ADD("EnteCus2, ")
        SQL.ADD("Vehiculo1, ")
        SQL.ADD("Mercado4, ")
          
        SQL.ADD("CB5, ")
        SQL.ADD("NroAltaMAE, ")
        SQL.ADD("UDN2, ")
        SQL.ADD("PaseCB, ")
          
        SQL.ADD("AceptaMAE, ")
        SQL.ADD("FechaAltaMAE, ")
          
        SQL.ADD("FechaEnvioMAE, ")
        SQL.ADD("Cuenta1, ")
        SQL.ADD("Observaciones, ")
        SQL.ADD("Numerador, ")
          
        SQL.ADD("FechaCarga, ")
        SQL.ADD("FechaCargaSys, ")
        SQL.ADD("UsrInput, ")

        SQL.ADD("Direccion, ")
        SQL.ADD("NrOrden, ")
        SQL.ADD("Corporate, ")
        SQL.ADD("NrOrden1 ")

        SQL.ADD(") values (")
          
        * NrOperacion
        SQL.ADD(" '"~Val(w:6)~"', ")
        * TipoOp
        SQL.ADD(" '"~Val(t:2)~"', ")
        * TipoTicket (Boden 2008)
        SQL.ADD(" '0', ")
        * Especie
        SQL.ADD(" '"~Val(t:3)~"', ")
        * Cliente1
        SQL.ADD(" '"~Val(t:56)~"', ")
          
        * Cantidad
        SQL.ADD(" "~FStr(Val(t:11),0,2)~", ")
        * ContraEspecie
        SQL.ADD(" '"~Val(t:12)~"', ")
        * Precio1
        SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
        * Cupon1
        SQL.ADD(" '"~Val(t:17)~"', ")
        * FechaOp
        SQL.ADD(" '"~IdxDate(Val(t:19))~"', ")
          
        if EqStr(Val(x:1),'S')
          * Spot        
          * Plazo (N)
          SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
          * RB5 (N)
          SQL.ADD(" '"~Val(t:20)~"', ")
        else
          * Futuro        
          * PlazoGracia (N)
           SQL.ADD(" "~FStr(Val(t:21),1,0)~" , ")
        endif
        * RB6 (N) Fuente=0=Siopel
        SQL.ADD(" '0', ")
        * FechaVto
