HojaVisible(SI)

creardialogo
radio1:'Tipo|Op.|Duplicados|Todos'
findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,8,B")

SetFilaActual(4)

Act(g:2, 'Fecha : '~Fecha(FSys()))
SetFont(g:2..g:2, 1)

Act(a:fac, "Listado de Operaciones Corregidas")
SetFont(a:fac..a:fac, 2)
SetFilaActual(Fac() + 2)

Act(a:fac, 'Tipo Op.')
Act(b:fac, 'Número')
Act(c:fac, 'F.Operacion')
Act(d:fac, 'Vehiculo')
Act(e:fac, 'Correccion')
Act(f:fac, 'Liq.Manual')

AgregarMarco(a:fac..f:fac, 2, 0, exe('COLOR'))
SetFont(a:fac..f:fac, 2)

if (dialogo.radio1 <> 1)
sql.add("Select * FROM "~Dbo()~".OPERACIONES O ")
sql.add("Where TipoOp IN ")
sql.add(" ('DPOA','MMFCMV','MMFIMV','MMFRN','MMON','MMONM','MMPCCM','MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSC','MMSCMV','MMSIMV','DTK','DTKVI')  ")
sql.add("Order By O.TipoOp,O.Vehiculo1,O.NrOperacion ")

Acn(z1, 0)

recorrer sql

if (Val(z1) = 0)
Act(a:fac, ' Correcion de OPERACIONES MODIFICADAS ....')
Ifa()
endif

Acn(z1, 1)

Act(a:fac, Fbn()['TipoOp'])
Act(b:fac, Fbn()['NrOperacion'])
Aclo(b:fac, Fbn('NrOperacion'))
Acd(c:fac, BuscarCampo('OPERACIONES', 'FechaOp', 'NrOperacion', Fbn()['NrOperacion']))
Act(d:fac, Fbn('Vehiculo1'))
Act(e:fac, 'Mov.Duplicado')
if (not Incluido(Fbn()['Vehiculo1'], Var('VLIQUIDA')~Var('VLIQUIDA2')))
Act(f:fac, 'Automatica')
SetFont(a:fac..f:fac, 1)
else
Acn(aa1, 0)

Acn(aa1, sql("Select Count(*) from "~Dbo()~".TRANSACCIONES2 where NrOperacionRef1='"~Fbn()['NrOperacion']~"' "))

if (Val(aa1) > 0)
ejecutarevento('ELILIQ', nroperacion1 = Fbn()['NrOperacion'])
Act(f:fac, 'Manual')
else
Act(f:fac, 'Manual. No posee Vouchers')
endif

SetFont(a:fac..f:fac, 2)
endif
ejecutarevento('ACTMOV', vehiculo1 = Fbn()['Vehiculo1'], fecha1 = FSys(), fecha2 = FSys(), nroperacion1 = Fbn()['NrOperacion'], tipoop1 = Fbn()['TipoOp'], radio1 = -1)
proximo
endif

if (dialogo.radio1 <> 0)
sql.add("Select O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov,COUNT(*) FROM "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".OPERACIONES O ")
sql.add("Where M.NrOperacion=O.NrOperacion ")
sql.add("Group By O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov Having COUNT(*)>1")
sql.add("Order By O.Vehiculo1,O.TipoOp,O.NrOperacion ")

Acn(z1, 0)

recorrer sql

if (Val(z1) = 0)
Ifa()
Act(a:fac, ' Correcion de MOV.EJECUTADOS Duplicados ....')
SetFont(a:fac..f:fac, 1)
