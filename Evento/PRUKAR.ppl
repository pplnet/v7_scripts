HojaVisible(NO)
MostrarCuadroDeMensajes
CrearDialogo
   Vehiculo1: "Vehiculo" ;;;;;;;;
   Fecha1   : "F.Desde"  ;1;;;;;;;;FSys-200;
   Fecha2   : "F.Hasta"  ;;;;;;Dialogo.Fecha2>0 Y Dialogo.Fecha2 <= Fsys;'Fecha Hasta Invalida';NO;FSys;
   Especie1 : "Especie"  ;;;;;;
   Cliente1 : "Entidad"  ;;;;;;
   ***Check1   : 'Netea Partidas' ;;;;NO;NO;;;;1;
  *** Lista2   : 'Tipo Op.' ;0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Nombre not like '%Back%' ");
FinDialogo

If Not OK
   Cancelar
Endif


CrearFont(1,"Arial,8,B")



MostrarCuadroDeMensajes

if NoVacio(Dialogo.Vehiculo1)
  ACT(z:1, Val(z:1)~"Vehiculo1 = '"~Dialogo.Vehiculo1~"' and ")
endif

if NoVacio(Dialogo.Especie1)
  ACT(z:1, "Especie = '"~Dialogo.Especie1~"' and ")
endif


if NoVacio(Dialogo.Cliente1)
  ACT(z:1, Val(z:1)~"Cliente1 = '"~Dialogo.Cliente1~"' and ")
endif


 
ACT(z:1, Val(z:1)~"FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")

***---Select

SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.FechaVto,O.Especie, O.Plazo, O.Precio1, O.Cantidad, O.Vehiculo1, C.RazonSocial ")
SQL.ADD("   from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("   where  "~Val(z:1)~" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" Order by 1, 2 ")

Recorrer SQL

   ACT(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])
   ***ACT(c:FAC, fbn('RazonSocial'))
   ***ACD(d:FAC, FBN['FechaOp'])
   ACT(e:FAC, FBN['Vehiculo1'])
   ***ACD(f:FAC, FBN['FechaVto'])
   ***ACN(g:FAC, FBN['Cantidad'])
   ACT(h:FAC, FBN['Especie'])

Proximo

If FAC>0

    CrearListBox;'Arial,8,B'
         'Liquida'                  ; j1..j:fac; SI; SI;;60; COMBO;'Si|No|'
         'NroOperacion'             ; a1..a:fac; NO; SI;;80; STRING
         'Tipo Operacion'           ; b1..b:Fac; No;SI;;90;STRING
         'Vehiculo'                 ; e1..e:fac; SI; SI;;70; TABLA; 'Vehiculos';'Codigo';'Codigo;Descripcion';
         'Especie'                  ; h1..h:fac; NO; SI;;70; STRING
      FinListBox
 
EndIf
     