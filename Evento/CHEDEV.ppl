MostrarCuadroDeMensajes
CrearDialogo
  NrTrans1 : 'NrTrans' 
  Vehiculo1: 'Vehiculo'
  Radio1   : 'ABM|Alta|Baja|ChequeReusado|Cheque para Reusar'
  Chequera1       :'Nr.Chequera'  ;;;;;;;;;;
  Entero1         :'Nr.Cheque'    ;;;;;;;;;;;;;'###############';
FinDialogo

IF Not Ok
  Cancelar
ENDIF

ACT(TR:1, Dialogo.NrTrans1)
ACT(VE:1, Dialogo.Vehiculo1)

SQL.ADD(" Select Fecha2, Cantidad1, Cuenta2, Cantidad2, Chequera1, Fecha1 ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" Where NrTrans = '"~Dialogo.NrTrans1~"' ")
Recorrer SQL
  ACD(FE:1, fbn('Fecha1'))
  ACD(FE:2, fbn('Fecha2'))
  ACN(CA:1, fbn('Cantidad1'))
  ACN(ch:1, fbn('Cantidad2'))
  ACT(ch:2, fbn('Chequera1'))
  ACT(CU:2, fbn('Cuenta2'))
Proximo

IF NO
***---Inserto el Cheque

message(' Asignando Numero de Cheque ...')
ACT(OB:1, 'Pago de Transaccion DEVM Nr. '~Val(TR:1))
SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
SQL.ADD(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
SQL.ADD(" NrComprobante, Monto, Observaciones, Estado) ")
SQL.ADD(" Values ")
SQL.ADD(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~fstr(Val(ch:1),0,0)~", "~IdxDate2(Val(fe:2))~", ")
SQL.ADD(" '"~Val(TR:1)~"', "~fstr(Val(ca:1),1,2)~", '"~Val(OB:1)~"', 'ASI') ")
SQL.NEW

***---Actualizo los datos del cheque en los movimientos
SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES ")
SQL.ADD(" Set NrGrupo = "~Fstr(Num(Val(ch:2)), 0, 0)~", ")
SQL.ADD(" NrComprob   = "~Fstr(Val(ch:1), 0, 0)~" ")
SQL.ADD(" Where NrOperacion = '"~Val(TR:1)~"' ")
SQL.NEW
SQL.EXEC
ENDIF

If Dialogo.Radio1=0
  message(' Asignando Numero de Cheque ...')
  ACT(OB:1, 'Pago de Transaccion DEVM Nr. '~Val(TR:1))
  SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
  SQL.ADD(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
  SQL.ADD(" NrComprobante, Monto, Observaciones, Estado) ")
  SQL.ADD(" Values ")
  SQL.ADD(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~fstr(Val(ch:1),0,0)~", "~IdxDate2(Val(fe:2))~", ")
  SQL.ADD(" '"~Val(TR:1)~"', "~fstr(Val(ca:1),1,2)~", '"~Val(OB:1)~"', 'ASI') ")
  SQL.NEW
Endif

If Dialogo.Radio1=1
  If SQL("SELECT COUNT(*) FROM "~DBO~".CHEQUES WHERE NrCheque = "~fstr(Val(ch:1),0,0)~" AND Chequera = '"~Val(ch:2)~"' ")<>0
    message(' Actualizando datos del Cheque ...')
    SQL.ADD(" UPDATE "~DBO~".CHEQUES SET ")
    SQL.ADD(" Monto        =  "~fstr(Val(ca:1),1,2)~", ")
    SQL.ADD(" FechaEmision =  "~IdxDate2(Val(fe:1))~", ")
    SQL.ADD(" FechaPago    =  "~IdxDate2(Val(fe:2))~", ")
    SQL.ADD(" Estado       = 'ASI' ")
    SQL.ADD(" WHERE  NrComprobante = '"~Val(TR:1)~"' ")
    SQL.ADD(" AND    NrCheque      = "~fstr(Val(ch:1),0,0)~" ")
    SQL.ADD(" AND    Chequera      = '"~Val(ch:2)~"' ")
    SQL.NEW
  Else
    message(' Asignando Numero de Cheque ...')
    ACT(OB:1, 'Pago de Transaccion DEVM Nr. '~Val(TR:1))
    SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
    SQL.ADD(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
    SQL.ADD(" NrComprobante, Monto, Observaciones, Estado) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~fstr(Val(ch:1),0,0)~", "~IdxDate2(Val(fe:2))~", ")
    SQL.ADD(" '"~Val(TR:1)~"', "~fstr(Val(ca:1),1,2)~", '"~Val(OB:1)~"', 'ASI') ")
    SQL.NEW
  Endif
Endif

IF Dialogo.Radio1 = 2
    ***---El cheque se uso anteriormente en una Tr. anulada.
    Message(' Actualizando datos del Cheque ...')
    ACT(OB:1, 'Pago de Transaccion DEVM Nr. '~Val(TR:1))
    SQL.ADD(" UPDATE "~DBO~".CHEQUES SET ")
    SQL.ADD(" Monto = "~Fstr(Val(CA:1),1,2)~", ")
    SQL.ADD(" FechaEmision = '"~IdxDate(Val(FE:1))~"', ")
    SQL.ADD(" FechaPago = '"~IdxDate(Val(FE:2))~"', ")
    SQL.ADD(" Estado = 'ASI', ")
    SQL.ADD(" NrComprobante = '"~Val(TR:1)~"', ")
    SQL.ADD(" Observaciones = '"~Val(OB:1)~"' ")
    SQL.ADD(" Where NrCheque = "~Fstr(Val(CH:1),0,0)~" ")
    SQL.ADD(" AND Chequera = '"~Val(CH:2)~"' ")
    SQL.NEW
ENDIF

IF Dialogo.Radio1 = 3
    ***---Se cargo y se borro la transaccion, => se borra el cheque para que se pueda reusar.
    SQL.ADD(" Delete "~DBO~".CHEQUES ")
    SQL.ADD(" Where NrCheque = "~Fstr(Dialogo.Entero1,0,0)~" ")
    SQL.ADD(" AND Chequera = '"~Dialogo.Chequera1~"' ")
    SQL.ADD(" AND Estado = 'ASI' ")
    SQL.ADD(" AND NrComprobante = '"~Val(TR:1)~"' ")
    SQL.NEW
ENDIF

***---Actualizo los datos del cheque en los movimientos
SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES ")
SQL.ADD(" Set NrGrupo = "~Fstr(Num(Val(ch:2)), 0, 0)~", ")
SQL.ADD(" NrComprob   = "~Fstr(Val(ch:1), 0, 0)~" ")
SQL.ADD(" Where NrOperacion = '"~Val(TR:1)~"' ")
SQL.NEW
SQL.EXEC