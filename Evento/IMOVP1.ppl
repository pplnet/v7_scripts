* IMOVPE
* Insert de Mov.Pendientes
* Recibe: Nr.Operacion,FechaMov,Cliente,Especie,EnteCustodia,NrSaldo,Cantidad,Leyenda,Visible,Automatico,NrMov.
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;NO;;;;;;;
  Fecha1       : "FechaMov"                 ;;;;NO;;;;;;;
  Cliente1     : 'Cliente'                  ;;;;NO;;;;;;;
  Especie1     : "Especie"                  ;;;;NO;;;;;;
  Vehiculo1    : 'Vehiculo1'                ;;;;NO;;;;;;
  Entero1      : "Nro.Saldo"                ;;;;NO;;;;;;
  Precio1      : "Cantidad"                 ;;;;NO;;;;;;
  String       : 'Leyenda'                  ;;;;NO;;;;;;
  Entero2      : "Nro.Mov"                  ;;;;NO;;;;;;
  Entero3      : "Nro.Cuota"                ;;;;NO;;;;;;
  String1      : 'Tabla'                    ;;;;NO;;;;;;
FinDialogo

if Not Ok
  Cancelar
endif


* Si liquida genera un Mov. Pendiente
IF Incluido(Dialogo.Vehiculo1,Var('VLIQUIDA')~Var('VLIQUIDA2'))
   Message('Insertando Movimiento Pendiente '~Dialogo.NrOperacion1~'/'~Dialogo.Especie1~'...')

   SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
Else

   Message('Insertando Movimiento Ejecutados '~Dialogo.NrOperacion1~'/'~Dialogo.Especie1~'...')
   SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
EndIf

SQL.ADD("(NrOperacion,FechaMov,Cliente,")
SQL.ADD(" Especie,EnteCustodia,")
SQL.ADD(" NrSaldo, Cantidad,")
SQL.ADD(" Leyenda,NrMov,")
SQL.ADD(" Bits, NrGrupo, NrInstan, NrGrupo2,Concepto) ")
SQL.ADD(" Values ")
SQL.ADD(" ('"~Dialogo.NrOperacion1~"','"~IdxDate(Dialogo.Fecha1)~"','"~Dialogo.Cliente1~"', ")
SQL.ADD(" '"~Dialogo.Especie1~"','"~Dialogo.Vehiculo1~"', ")
SQL.ADD(" "~FsTr(Dialogo.Entero1,0,0)~","~Fstr(Dialogo.Precio1,0,2)~", ")
SQL.ADD(" '"~Dialogo.String~"',"~FsTr(Dialogo.Entero2,0,0)~", ")
SQL.ADD(" 'MV',0,0,"~FsTr(Dialogo.Entero3,0,0)~",'"~Dialogo.String1~"') ")
SQL.NEW
SQL.EXEC
