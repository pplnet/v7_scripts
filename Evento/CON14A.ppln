tipoop1:'TipoOp';;;;NO;NO;;
lista1:'Vehiculos';;;;NO;NO;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))
check1:'Contab.Procesada';;;;NO;NO;
findialogo

if (not ok)
