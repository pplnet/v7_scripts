******************************************************************************
* I00002 
*
* Interfase J.D. Edwards -> FPA Emision de pagos. 
*
* Generador de lista de archivos a leer
*
* Fecha..............: 15/MAY/2002 
* Ultima modificaci¢n: 20/MAY/2002 13:30
* Autor..............: A.L. GRAZIADIO 
*
*  Referencias:
*  ------------
*  WW:1..WW:nn = Lista de archivos a leer
*
**************************************************************************
*
* HOJAVISIBLE(SI)
CrearDialogo
  String :'Archivo'           ;1;1;;;;NOVACIO(Dialogo.String);'Nombre de archivo INVALIDO';NO;VAR('CAPORG');;;;;;;;;SI
  String1:'Nuevo directorio'  ;;;;;;NOVACIO(Dialogo.String1);'Nombre de camino/path INVALIDO';NO;VAR('CAPDST');;;;;;;;;
  Radio1 :'Valida anio|Si|No' ;;;;;;;;;0
  Radio2 :'Crea excel|Si|No'  ;;;;;;;;;0
  Radio3 :'Sist.Oper.|W98|NT' ;;;;;;;;;0
  Radio4 :'Mueve TXT |No|Si'  ;;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

ACT(ww:1, PrimerArchivo(MIRT(TRIM(Dialogo.String))~'\*.TXT') )

If NOT Vacio(VAL(ww:1))
   EjecutarEvento('IN0002', String=MIRT(TRIM(Dialogo.String))~'\'~VAL(ww:1), String1=Dialogo.String1, Radio1=Dialogo.Radio1, Radio2=Dialogo.Radio2, Radio3=Dialogo.Radio3, Radio4=Dialogo.Radio4 )
EndIf

RECORRER&i 2,1000000
  ACT(ww:&i, ProximoArchivo)
  If Not OK
     Break
  EndIf
  EjecutarEvento('IN0002', String=MIRT(TRIM(Dialogo.String))~'\'~VAL(ww:&i), String1=Dialogo.String1, Radio1=Dialogo.Radio1, Radio2=Dialogo.Radio2, Radio3=Dialogo.Radio3, Radio4=Dialogo.Radio4 )
PROXIMO
