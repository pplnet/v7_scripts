Act(vh:1, SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

creardialogo
radio1:'Sist.Oper.|W98|NT';1;1;;;;;;;1;
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(so1, "COMMAND.COM /C ")
else
Act(so1, "CMD.EXE /C ")
endif

Message('Eliminando archivos Texto')

winexec(Val(so1)~" del "~Var('DIRICOTIZ')~'\SIAGGL.TXT', 0)
esperar(5)

Message('Borro siaggl.txt')
winexec(Val(so1)~" del "~Var('DIRICOTIZ')~'\MVINCONT.bat', 0)
esperar(5)

Message('Borro mvincont.txt')
Message('Construyendo linea FTP ')
AbrirAscii(Var('DIRICOTIZ')~'\SIAGGL.TXT', 0)

Act(t1, Var('TECOUSR'))
EscribirAscii(Val(t1))

Act(t1, Var('TECOPASW'))
EscribirAscii(Val(t1))

Act(t1, "lcd "~Var('SIAFCOTIZ1')~" ")
EscribirAscii(Val(t1))

Act(t1, "cd "~Var('SIAFCOTIZ2')~" ")
EscribirAscii(Val(t1))

Acd(fe:1, FSys())
Act(fe:2, Copy(FStr(Trunc((Anio(Val(fe:1)) / 100) + 1), 0, 0), 2, 1))
Act(fe:2, Val(fe:2)~Copy(FStr(Anio(Val(fe:1)), 4, 0), 3, 2))
Act(fe:2, Val(fe:2)~Pad0(FStr(DifDias(Val(fe:1), Fecha('01/01/'~FStr(Anio(Val(fe:1)), 4, 0)), 'ARG', NO) + 1, 0, 0), 3))





Acn(ct1, 0)

Act(v2, Var('DIRICOTIZ')~"\SIA"~Copy(Val(fe:2), 2, 5)~'*')
Act(v3, Val(v2))

AbrirAscii(Var('DIRICOTIZ')~'\MVINCONT.bat', 0)
EscribirAscii('Move '~Val(v2)~' '~Var('SIAFCOTIZ3'))
CerrarAscii()

if (ok)
if (NoVacio(Val(v2)))
Act(t1, "put "~Val(v2)~" ")
AbrirAscii(Var('DIRICOTIZ')~'\SIAGGL.TXT', 0)
EscribirAscii(Val(t1))
CerrarAscii()
endif
Acn(ct1, 1)
endif


AbrirAscii(Var('DIRICOTIZ')~'\SIAGGL.TXT', 0)

Act(t1, "close ")
EscribirAscii(Val(t1))

Act(t1, "quit ")
EscribirAscii(Val(t1))
CerrarAscii()

if (Val(ct1) = 1)
Messagebox("Envio Cotizaciones")

endif

esperar(5)

if (ok)
winexec('c:\as400\CAP\COTIZ\HSIAGgl1.bat')
winexec(Var('DIRICOTIZ')~'\HSIAGgl2.bat')
endif



