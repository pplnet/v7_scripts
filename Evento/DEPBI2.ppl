MostrarCuadroDeMensajes
***---Operaciones
SQL.ADD(" Select /*+ RULE */ O.NrOperacion ")
SQL.ADD(" From "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND (O.Observac4 <> 'SI' OR O.Observac4 Is Null) ")
SQL.ADD(" AND B.NrBit = 50 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND M.NrSaldo = 1 ")
Recorrer SQL
    IF SQL(" Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1
        ***---No le quedan ptes.
        Message('Borrando Bits Operacion '~fbn('NrOperacion'))
        SQL.ADD(" Delete "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" AND NrBit <> 50 ")
        SQL.NEW
        SQL.EXEC
        SQL.ADD(" Update "~DBO~".OPERACIONES ")
        SQL.ADD(" Set Observac4 = 'SI' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.NEW
        SQL.EXEC
    ENDIF
Proximo
***---Transacciones
SQL.ADD(" Select /*+ RULE */ T.NrTrans NrOperacion ")
SQL.ADD(" From "~DBO~".OPERACIONESBITS B, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where T.NrTrans = M.NrOperacion ")
SQL.ADD(" AND T.NrTrans = B.NrOperacion ")
SQL.ADD(" AND (T.Ley5 <> 'SI' OR T.Ley5 Is Null) ")
SQL.ADD(" AND B.NrBit = 20 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND M.NrSaldo = 1 ")
Recorrer SQL
    IF SQL(" Select 1 From "~DBO~".MOVPENDIENTES Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrSaldo = 1 ") <> 1
        ***---No le quedan ptes.
        Message('Borrando Bits Transaccion '~fbn('NrOperacion'))
        SQL.ADD(" Delete "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" AND NrBit <> 20 ")
        SQL.NEW
        SQL.EXEC
        SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
        SQL.ADD(" Set Ley5 = 'SI' ")
        SQL.ADD(" Where NrTrans = '"~fbn('NrOperacion')~"' ")
        SQL.NEW
        SQL.EXEC
    ENDIF
Proximo
