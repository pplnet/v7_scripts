entero4:"Mes";2;1;;dialogo.radio2 = 1;dialogo.radio2 = 1;dialogo.entero4 >= 1 y dialogo.entero4 <= 12;'Nro. de Mes Incorrecto';NO;Mes(FSys());;;;'##'
