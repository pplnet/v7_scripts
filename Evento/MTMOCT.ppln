sql.add("Select O.NrOperacion,   O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
sql.add("       O.Precio1,       O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        ")
sql.add("       O.FechaOp,       O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    ")
sql.add("       O.FechaUltCupon, O.PrecioEj,      O.FechaEj,        O.MB1,         O.ObsErrorMAE,  ")
sql.add("       O.TotalAux1,     O.TotalAux3,     O.ContraEspecie2, O.EnteCus1     ")
sql.add("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".CLIENTES C , "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where C.Codigo    = O.Cliente1 ")
sql.add("   and O.TipoOp In ('FXOCTC','FXOCTV') ")
sql.add("   and O.FechaOp  <= "~IdxDate2(dialogo.fecha1)~" ")
sql.add("   and O.FechaVto >= "~IdxDate2(dialogo.fecha1)~" ")
sql.add("   and (O.FechaPrecan is Null or O.FechaPrecan >= "~IdxDate2(dialogo.fecha1)~") ")
sql.add("   and O.NrOperacion = B.NrOperacion ")
sql.add("   and B.NrBit       = 30 ")
sql.add("   and B.Valor       = '0' ")
if (NoVacio(dialogo.cliente1))
sql.add("   and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
sql.add(" order by C.NrMAE,O.FechaVto,O.ObsErrorMAE,O.NrOperacion ")
Acn(az:1, 0)
recorrer sql
Scn(az:1, 1)
Message('Operacion '~Fbn()['TipoOp']~' '~Fbn()['NrOperacion'])
Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Fbn()['TipoOp'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Especie'])
Acn(e:fac, Fbn()['Cantidad'])
Acn(f:fac, Fbn()['Precio1'])
Act(g:fac, Fbn()['ContraEspecie'])
Acn(h:fac, Fbn()['TotalBrutoCli1'])
Act(i:fac, Fbn()['Vehiculo1'])
Act(j:fac, Fbn()['Book1'])
Acd(k:fac, Fbn()['FechaOp'])
Acd(l:fac, Fbn()['FechaVto'])
Acd(m:fac, Fbn()['FechaPago'])
Acd(n:fac, Fbn()['FechaPrecan'])

Acn(av:fac, sql("Select Valor from "~Dbo()~".OPERACIONESBITS where NrOperacion='"~Val(a:fac)~"' and NrBit=70 "))
if (Val(av:fac) = 0)
Acn(aw:fac, sql("Select Count(*) from "~Dbo()~".MOVEJECUTADOS where NrOperacion='"~Val(a:fac)~"' and NrSaldo=100 "))
if (Val(aw:fac) = 0)
Acn(ax:fac, 1)
else
Acn(ax:fac, 2)
endif
endif

if (Val(ax:fac) = 0 y Val(ay:fac) = 0)
if (Fbn()['FechaOp'] = dialogo.fecha1)
Acn(o:fac, 1)
endif
if (Fbn()['FechaVto'] = dialogo.fecha1 o Fbn()['FechaPrecan'] = dialogo.fecha1)
Acn(p:fac, 1)
endif
endif
if (Val(ax:fac) = 0 y Val(ay:fac) = 0)
Acn(q:fac, Fbn()['PrecioMer'])
Acd(r:fac, Fbn()['FechaUltCupon'])
Acn(s:fac, Fbn()['PrecioEj'])
Acd(t:fac, Fbn()['FechaEj'])
Act(x:fac, Fbn()['ObsErrorMAE'])
Act(y:fac, Copy(Fbn()['ObsErrorMAE'], 1, 1))
Act(z:fac, Copy(Fbn()['ObsErrorMAE'], 2, 5))
Act(aa:fac, Copy(Fbn()['ObsErrorMAE'], 7, 7))
Acn(v:fac, Fbn()['MB1'])
if (Eqstr(Val(d:fac), 'USD'))
if (Val(v:fac) = 0)
Act(au:fac, 'E')
else
if (Val(v:fac) = 1)
Act(au:fac, 'A')
endif
endif
endif
Act(u:fac, Fbn()['EnteCus1'])

if (Vacio(Val(u:fac)))
Act(at:fac, 'Error 2')
Acn(ay:fac, 1)
endif
endif
if (Val(ax:fac) = 0 y Val(ay:fac) = 0)
Act(w:fac, Fbn()['ContraEspecie2'])
if (Vacio(Val(w:fac)))
Act(at:fac, 'Error 3')
Acn(ay:fac, 1)
endif
endif
if (Val(ax:fac) = 0 y Val(ay:fac) = 0)
if (dialogo.fecha1 < Fbn('FechaEj'))
Act(at:fac, 'Error 4')
Acn(ay:fac, 1)
endif
endif
if (Val(ax:fac) = 0 y Val(ay:fac) = 0)
if (dialogo.fecha1 = Fbn('FechaEj'))
Acn(ar:fac, 1)
Acn(ab:fac, Fbn()['PrecioMer'])
if (Val(o:fac) = 0)
Acd(ac:fac, Fbn()['FechaUltCupon'])
endif
else
if (Val(o:fac) = 1)
Acn(ab:fac, Fbn()['Precio1'])
else
if (Fbn()['FechaEj'] > 0)
Acn(ab:fac, Fbn()['PrecioEj'])
Acd(ac:fac, Fbn()['FechaEj'])
else
Acn(ab:fac, Fbn()['Precio1'])
endif
endif
endif
if (Val(p:fac) = 1)
Acn(ad:fac, CotizacionC(Val(w:fac), null, null, null, dialogo.fecha1, 1, null, Fbn()['ContraEspecie']))
else
Acn(ad:fac, CotizacionC(Val(u:fac), 'FUT', Fbn()['FechaVto'], null, dialogo.fecha1, 1, null, Fbn()['ContraEspecie']))
endif
Acd(ae:fac, dialogo.fecha1)
if (Eqstr(Fbn('TipoOp'), 'FXOCTC'))
Acn(af:fac, Val(e:fac) * (Val(ad:fac) - Val(ab:fac)))
else
Acn(af:fac, Val(e:fac) * (Val(ab:fac) - Val(ad:fac)))
endif

Acn(ag:fac, Val(ae:fac) - Val(k:fac) + 1)

sql.add("Select Cantidad from "~Dbo()~".MOVEJECUTADOS ")
sql.add(" Where NrOperacion = '"~Val(a:fac)~"' ")
sql.add("   and FechaMov    = "~IdxDate2(Val(ae:fac))~" ")
sql.add("   and NrSaldo     = 100 ")
recorrer sql
Dfa()
Scn(ai:fac, 1)
Scn(ak:fac, Fbn('Cantidad'))
proximo

sql.add("Select Cantidad from "~Dbo()~".MOVPENDIENTES ")
sql.add(" Where NrOperacion = '"~Val(a:fac)~"' ")
sql.add("   and FechaMov    = "~IdxDate2(Val(ae:fac))~" ")
sql.add("   and NrSaldo     = 100 ")
recorrer sql
Dfa()
Scn(aj:fac, 1)
Scn(ak:fac, Fbn('Cantidad'))
proximo
Acn(am:fac, Fbn()['TotalAux1'])
Acn(an:fac, Fbn()['TotalAux3'])
Acn(ao:fac, Val(am:fac) - Val(ak:fac) + Val(af:fac))

if (Eqstr(Fbn('TipoOp'), 'FXOCTC'))
Acn(ap:fac, Val(e:fac) * (Val(ad:fac) - Val(f:fac)))
else
Acn(ap:fac, Val(e:fac) * (Val(f:fac) - Val(ad:fac)))
endif
if (Val(ar:fac) = 1)
if (Val(af:fac) - Val(ak:fac) >= 0.01 o Val(af:fac) - Val(ak:fac) <= -0.01)
Acn(as:fac, 1)
Acn(az:2, 1)
endif
else
Acn(as:fac, 1)
Acn(az:2, 1)
endif
Acn(bi:2, 0)
if (Val(bi:1) > 0)
recorrer&i 1, Val(bi:1)
if (Eqstr(Fbn()['Cliente1'], Val(ba:&i)) y Eqstr(Fbn()['Especie'], Val(bb:&i)) y Fbn()['FechaVto'] = Val(bc:&i) y Eqstr(Copy(Fbn()['ObsErrorMAE'], 1, 12), Copy(Val(bd:&i), 1, 12)))
Acn(bi:2, &i)
break
endif
proximo
endif
if (Val(bi:2) = 0)
Scn(bi:1, 1)
Acn(bi:2, Val(bi:1))
endif
Act(ba:Val(bi:2), Fbn()['Cliente1'])
Act(bb:Val(bi:2), Fbn()['Especie'])
Acd(bc:Val(bi:2), Fbn()['FechaVto'])
Act(bd:Val(bi:2), Fbn()['ObsErrorMAE'])
Act(be:Val(bi:2), Copy(Val(x:fac), 1, 1))
Act(bf:Val(bi:2), Copy(Val(x:fac), 2, 5))
Act(bg:Val(bi:2), Copy(Val(x:fac), 7, 7))
Scn(bh:Val(bi:2), Val(af:fac))
Scn(bj:1, Val(af:fac))
Acn(bk:4, 0)

if (Val(bk:2) > 0)
recorrer&i 2, Val(bk:2) + 1
if (Eqstr(Val(bm:&i), Val(c:fac)))
Acn(bk:4, &i)
endif
proximo

if (Val(bk:4) = 0)
Scn(bk:2, 1)
Acn(bk:4, Val(bk:2) + 1)
Act(bm:Val(bk:4), Val(c:fac))
endif
else
Scn(bk:2, 1)
Acn(bk:4, 2)
Act(bm:Val(bk:4), Val(c:fac))
endif

Scn(bq:Val(bk:4), 1)
Scn(br:Val(bk:4), Val(af:fac))
Acn(ca:fac, BuscarCampo('OPERACIONES', 'Cartera', 'NrOperacion', Val(a:fac)))

sql.add("Select * from "~Dbo()~".BOOKS ")
sql.add("where Vehiculo    = '"~Val(i:fac)~"' ")
sql.add("  and Alias2      = 'I' ")
sql.add("  and TipoNegocio = 'SPO' ")
recorrer sql
Dfa()
Act(cb:fac, Fbn('Codigo'))
proximo

Acn(cc:fac, CotizacionC(Val(d:fac), null, null, null, dialogo.fecha1, 1, SI, 'USD'))
Acn(cd:fac, Val(e:fac) * Val(cc:fac))
Acn(ce:fac, Val(e:fac) * Val(ad:fac))
Act(cf:fac, iif (Eqstr(Modo(Val(g:fac), 'USD'), 'INV'), 'INV', 'DIR'))
Acn(cg:fac, iif (Eqstr(Val(cf:fac), 'INV'), Val(ce:fac) / Val(cd:fac), Val(cd:fac) / Val(ce:fac)))
Acn(ch:fac, 1)
endif
if (Val(ax:fac) > 0)
Scn(az:4, 1)
if (Val(ax:fac) = 2)
Scn(az:5, 1)
endif
endif
if (Val(ay:fac) > 0)
Scn(az:3, 1)
Act(bv:Val(az:3), Fbn('NrOperacion'))
Act(bw:Val(az:3), Val(at:fac))
endif
proximo
if (Val(az:1) = 0 y Val(cz:1) = 0)
Messagebox('No existen OCT para Valuar.')
if (dialogo.check1 = 1)
Cancelar()('Evento Cancelado')
else
Messagebox('Evento Cancelado')
endif
endif
if (Val(az:4) > 0)
if (dialogo.check1 = 1)
Cancelar()('Hay operaciones que NO estan en la Instancia Terminal y NO seran incluidas en el calculo')
else
Acn(az:6, Messagebox('Hay operaciones que NO estan en la Instancia Terminal y NO fueron incluidas en el calculo', 1, 1))
if (Val(az:6) = 2)
Cancelar()('Evento Cancelado')
endif
endif
endif
if (Val(az:5) > 0)
Messagebox('Hay operaciones que NO estan en Terminal y tienen MTM.')
recorrer&i 2, Val(az:1) + 1
if (Val(ax:&i) = 2)
Messagebox('Error Operacion '~Val(a:&i)~': No esta en Terminal y tiene MTM')
endif
proximo
if (dialogo.check1 = 1)
Cancelar()('Evento Cancelado')
else
Messagebox('Evento Cancelado')
endif
endif
if (Val(az:3) > 0)
recorrer&i 2, Val(az:1) + 1
if (Val(ay:&i) > 0)
if (Eqstr(Val(at:&i), 'Error 1'))
Messagebox('Error 1 Operacion '~Val(a:&i)~': Alta y Fixing')
endif
if (Eqstr(Val(at:&i), 'Error 2'))
Messagebox('Error 2 Operacion '~Val(a:&i)~': Falta Especie MTM')
endif
if (Eqstr(Val(at:&i), 'Error 3'))
Messagebox('Error 3 Operacion '~Val(a:&i)~': Falta Especie Fixing')
endif
if (Eqstr(Val(at:&i), 'Error 4'))
Messagebox('Error 4 Operacion '~Val(a:&i)~': Reproceso anterior a ultimo MTM')
endif
endif
