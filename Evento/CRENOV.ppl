CrearDialogo
  Fecha1   : 'Fecha';;;;;;;;;;FSYS  
  Cliente1 : 'Cliente'
  Especie1 : 'Especie'
  TipoOp1  : 'Tipo Op.'
  Operador : 'Operador';;;;;;;;;UsuarioActivo
FinDialogo


if not ok
  Cancelar
endif

SQL.ADD(" Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, ")
SQL.ADD(" TotalIntereses, TotalRetenciones, RB5, Operador, Precio4, FechaVto, TotalGanancias, ")
SQL.ADD(" TablaFeriados1, DiasAnio, Opsiopel,Direccion, Linstancia, Observacdoc,Precio3, ")
SQL.ADD(" Cliente3, PorComision, TotalBrutoCli2, Cartera, TotalComisiones, MB2, ")
SQL.ADD(" MB6, RB7, CB5 ")
SQL.ADD(" from "~DBO~".OPERACIONES ")
SQL.ADD(" where FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and TipoOp = '"~Dialogo.TipoOp1~"'")
else
  SQL.ADD("and TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPO','MMCA')")
endif
SQL.ADD("and (RB6 = '0' or RB6 is NULL)")
if NoVacio(Dialogo.Operador)
  SQL.ADD("and Operador = '"~Dialogo.Operador~"'")
endif
SQL.ADD("order by Cliente1, Especie, TipoOp ")


ACN(z1, 0)
recorrer SQL

  ACT(a:fac, fbn('Cliente1'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('TipoOp'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('TotalIntereses'))
  ACN(g:fac, fbn('Plazo'))
  ACT(h:fac, fbn('NrOperacion'))
  IF Incluido(fbn('TipoOp'), 'MMPF|MMPFCE')
      ACN(I:fac, fbn('TotalGanancias'))
  ELSE
      ACN(i:fac, fbn('TotalRetenciones'))
  ENDIF
  ACN(j:fac, fbn('RB5'))  
  ACT(k:fac, fbn('Operador'))
  ACN(l:fac, 0)
  ACN(m:fac, fbn('Precio4'))

  SCN(z1, 1)

proximo

ACO(1,10)
ACO(2,6)
ACO(3,6)
ACO(4,12)
ACO(5,10)
ACO(6,10)
ACO(7,5)
ACO(8,8)

FormatoCeldas(d1..d:fac, Exe('F2'))
FormatoCeldas(e1..e:fac, Exe('F7'))
FormatoCeldas(f1..f:fac, Exe('F2'))
FormatoCeldas(g1..g:fac, Exe('F0'))


if Val(z1) > 0
  CrearListBox ; 'Arial,8,'
   'Accion ?'      ;l1..l:FAC;SI;;;80;COMBO;'Renueva|Cancela'
   'Tipo'          ;c1..c:FAC;NO;;;50;STRING
   'Especie'       ;b1..b:FAC;NO;;;50;TABLA;'Especies';'Codigo';'Codigo;Nombre';
   'Cliente'       ;a1..a:FAC;NO;;;150;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
   'Cantidad'      ;d1..d:FAC;NO;;;90;NUMERO;'##,###,###.##'
   'Tasa (%)'      ;e1..e:FAC;NO;;;80;NUMERO;'##,###.#######'
   'Intereses'     ;f1..f:FAC;NO;;;90;NUMERO;'##,###,###.##'
   'Plazo'         ;g1..g:FAC;NO;;;50;NUMERO;'####'
   'Nro.Op.'       ;h1..h:FAC;NO;;;70;STRING
   'Operador'      ;k1..k:FAC;NO;;;70;STRING

  FinListBox

  if Ok 
    Recorrer&i 1,fac
      if Val(l:&i)=0

        *********** Renueva ***********

         if Not Eqstr(Val(c:&i),'MMPFCE')

            CrearDialogo:6
               TipoOp1       : 'Tipo Op'           ;1;1;;NO;;;;;Val(c:&i)
               NrOperacion1  : 'NrOperacion'       ;1;2;;NO;;;;;Val(h:&i)
               Especie1      : 'Especie'           ;2;1;;NO;;;;;Val(b:&i)
               Cliente1      : 'Cliente'           ;3;1;;NO;;;;;Val(a:&i)
               Fecha1        : 'Fecha Op'          ;2;2;;NO;;;;;FSys
               Entero1       : 'Plazo'             ;3;2; ;  ;;Dialogo.Entero1>0;'El plazo debe ser mayor que cero';NO;Val(g:&i);Dialogo.Fecha2-Dialogo.Fecha1
               Fecha2        : 'Fecha Vto'         ;4;2; ;  ;;ESHABIL(Dialogo.Fecha2,'ARG') Y [ESHABIL(Dialogo.Fecha2,'USA') O NOT EQSTR(Dialogo.Especie1,'USD') O NOT EQSTR(Dialogo.TipoOp1,'MMCA')];'No es un dia habil';NO;Dialogo.Fecha1+Dialogo.Entero1;Dialogo.Fecha1+Dialogo.Entero1;
               Cantidad1     : 'Cantidad'          ;4;1; ; ;;Dialogo.Cantidad1>0;'La Cantidad debe ser positiva';NO;IIF(EqStr(Val(c:&i),'MMPF'),Val(d:&i)+Val(f:&i)-Val(i:&i),Val(d:&i))
               Precio1       : 'Tasa (%)'          ; ; ; ; ;;Dialogo.Precio1>0;'La Tasa de ser positiva';NO;Val(e:&i)
               Precio3       : 'Plazo mas prox'    ;5;2; ;NO;NO;;;;;SQL("Select Min(ABS("~Dialogo.Entero1~"-PlazoHasta)) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"'");
               Precio4       : 'Fecha Tasa'        ;5;2; ;NO;NO;;;;;SQL("Select Max(Fecha) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" ");
               *Precio2       : 'T.Base (%)'        ;6;1; ;Dialogo.Radio2=1;;Dialogo.Precio2>0;'La Tasa Base debe ser mayor que cero';NO;Val(m:&i);IIF(Dialogo.Radio2=0,SQL("Select Valor1 from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and  Fecha='"~IdxDate(Dialogo.Precio4)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" "),Dialogo.Precio2)
               Precio2       : 'T.Base (%)'        ;6;1; ;Dialogo.Radio2=1;;Dialogo.Precio2>0;'La Tasa Base debe ser mayor que cero';NO;Val(m:&i);IIF(Dialogo.Radio2=0,TASADIA('TRANSF',Dialogo.Especie1,Dialogo.Fecha1,Dialogo.Entero1,1),Dialogo.Precio2)
               Radio2        : 'Tipo T.base|Transferencia|Call';6;2;;Incluido(Val(c:&i),'MMAD|MMDES|MMPO');NO;;;;Val(j:&i);
               Cantidad2     : 'Interes'           ;7;1; ;NO;;;;NO;Val(f:&i);Dialogo.Cantidad1*Dialogo.Precio1*Dialogo.Entero1/36500;
***---         Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');;;;0
               Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');NO;;;;1
            FinDialogo

        else

            CrearDialogo:6
               TipoOp1       : 'Tipo Op'           ;1;1;;NO;;;;;Val(c:&i)
               NrOperacion1  : 'NrOperacion'       ;1;2;;NO;;;;;Val(h:&i)
               Especie1      : 'Especie'           ;2;1;;NO;;;;;Val(b:&i)
               Cliente1      : 'Cliente'           ;3;1;;NO;;;;;Val(a:&i)
               Fecha1        : 'Fecha Op'          ;2;2;;NO;;;;;FSys
               Entero1       : 'Plazo'             ;3;2;;  ;;Dialogo.Entero1>0;'El plazo debe ser mayor que cero';NO;Val(g:&i);Dialogo.Fecha2-Dialogo.Fecha1
               Fecha2        : 'Fecha Vto'         ;4;2;;  ;;ESHABIL(Dialogo.Fecha2,'ARG') Y [ESHABIL(Dialogo.Fecha2,'USA') O NOT EQSTR(Dialogo.Especie1,'USD') O NOT EQSTR(Dialogo.TipoOp1,'MMCA')];'No es un dia habil';NO;Dialogo.Fecha1+Dialogo.Entero1;Dialogo.Fecha1+Dialogo.Entero1;

               Cantidad3     : 'Cantidad'          ;4;1;;   ;;Dialogo.Cantidad3>0;'La Cantidad debe ser positiva';NO;Val(d:&i)+Val(f:&i)-Val(i:&i) 

               Cantidad1     : 'Cantidad Ind'      ;5;1;;NO ;;Dialogo.Cantidad1>0;'La Cantidad debe ser positiva';NO;(Dialogo.Cantidad3 * Dialogo.Precio6/Dialogo.Precio5);(Dialogo.Cantidad3 * Dialogo.Precio6/Dialogo.Precio5)
              

               Precio1       : 'Tasa (%)'          ; ; ;; ;;Dialogo.Precio1>0;'La Tasa de ser positiva';NO;Val(e:&i)
               Precio3       : 'Plazo mas prox'    ;5;2;;NO;NO;;;;;SQL("Select Min(ABS("~Dialogo.Entero1~"-PlazoHasta)) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"'");
               Precio4       : 'Fecha Tasa'        ;7;2;;NO;NO;;;;;SQL("Select Max(Fecha) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" ");
               Precio2       : 'T.Base (%)'        ;7;1;;Dialogo.Radio2=1;;Dialogo.Precio2>0;'La Tasa Base debe ser mayor que cero';NO;Val(m:&i);IIF(Dialogo.Radio2=0,SQL("Select Valor1 from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and  Fecha='"~IdxDate(Dialogo.Precio4)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" "),Dialogo.Precio2)
               Radio2        : 'Tipo T.base|Transferencia|Call';6;2;;Incluido(Val(c:&i),'MMAD|MMDES|MMPO');NO;;;;Val(j:&i);

               Especie2      : 'Coef.Indexacion'   ;9;1;;NO;;;;;'CER'
               Precio5       : 'Indice.Desde'      ;10;1;;NO;;;;;;COTIZACION(Dialogo.Especie2,,,,Dialogo.Fecha1-1,1);;;;;
               Precio6       : 'Indice.Hasta'      ;10;2;;NO;;;;;;COTIZACION(Dialogo.Especie2,,,,Dialogo.Fecha2-1,1);;;;;

               Fecha3        : 'Fecha CER Hasta'   ;11;2;;NO;;;;;;SQL("SELECT Max(Fecha) FROM "~DBO~".COTIZACIONES WHERE Codigo='CER' AND Fecha<="~IdxDate2(Dialogo.Fecha2-1));

               Cantidad2     : 'Interes'           ;12;1;;NO;;;;NO;Dialogo.Cantidad1*Dialogo.Precio1*Dialogo.Entero1/36500;Dialogo.Cantidad1*Dialogo.Precio1*Dialogo.Entero1/36500;
               Cantidad4     : 'Interes S/ind'     ;  ;1;;NO;;;;NO;Dialogo.Cantidad3*Dialogo.Precio1*Dialogo.Entero1/36500;Dialogo.Cantidad3*Dialogo.Precio1*Dialogo.Entero1/36500;

***---               Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF');Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF');;;;0
               Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF');NO;;;;1

            FinDialogo
           


        Endif

        if Ok
          ACT(z1, GetNumerador(10))
          BorrarCeldas(z2..z9)
          recorrer ("Select * from "~DBO~".OPERACIONES where NrOperacion = '"~Val(h:&i)~"'")
              
            * TotalIntereses
            ACN(z9,Dialogo.Cantidad1*Dialogo.Precio1*Dialogo.Entero1/36500)
            * Operador (Gestor)
            if EqStr(fbn('Corporate'),'1')
              act(z8, SQL("Select Responsable from "~DBO~".CLIENTES where Codigo ='"~fbn('Cliente1')~"'"))
            else
              act(z8,UsuarioActivo)
            endif

            SQL.ADD("Insert into "~DBO~".OPERACIONES (")          
            SQL.ADD("FechaOp, OperacionRef, Especie, ContraEspecie ,")       
            SQL.ADD("Cliente1, Cantidad, Precio1, ")     
            SQL.ADD("Plazo, FechaVto, Precio4, ")      
            SQL.ADD("RB5, TotalIntereses, Operador, ")      
            SQL.ADD("Book1, Vehiculo1,  Corporate,")         
            SQL.ADD("Mercado, Mercado2, RB6, ")           
            SQL.ADD(" NrOperacion, TipoOp, ")
            SQL.ADD(" Cuenta1, Cuenta2, Cuenta3, Cuenta4 , ")
            
            if Incluido(fbn('TipoOp'),'MMCT|MMCO')
               SQL.ADD(" TablaFeriados1, DiasAnio, Opsiopel, ")
               SQL.ADD(" Observacdoc, ")
               SQL.ADD(" Precio3, Cliente3, PorComision, ")
               SQL.ADD(" TotalBrutoCli2, ")
               SQL.ADD(" Cartera, TotalComisiones, MB2, ")
               SQL.ADD(" MB6, RB7, CB5, ")
            endif     
            

            if Incluido(fbn('TipoOp'),'MMAD|MMDES')
              SQL.ADD("TotalImpuestos, TotalRetenciones, Precio3, ")
              SQL.ADD("PorImpuesto, TotalBrutoCli3, TotalBrutoCli1,")
            endif
            if EqStr(fbn('TipoOp'),'MMCA')
              SQL.ADD("TotalRetenciones, Precio3, TotalBrutoCli1,")
            endif
            if EqStr(fbn('TipoOp'),'MMCO')
              SQL.ADD("TotalBrutoCli3, MB1, TotalBrutoCli1,")
            endif
            if EqStr(fbn('TipoOp'),'MMCT')
              SQL.ADD("TotalBrutoCli3, MB1, TotalBrutoCli1, ")
            endif

            if Incluido(fbn('TipoOp'),'MMPF|MMPFCE')
***---              SQL.ADD("TotalRetenciones, Precio3, TotalBrutoCli1, ")
              SQL.ADD("TotalGanancias, Precio3, TotalBrutoCli1, ")
              SQL.ADD("CB5, RB4, DiasAnio, Precio2, MB1, ")
            endif

            if Incluido(fbn('TipoOp'),'MMPFCE')
              SQL.ADD("TotalAux3, Especie1, Cotizacion1, ")
              SQL.ADD("Cotizacion2, FechaVto2, InteresesCorr, ")
            endif

            if Incluido(fbn('TipoOp'),'MMPO')
              SQL.ADD("TotalImpuestos, TotalRetenciones, Precio3, ")
              SQL.ADD("PorImpuesto, TotalBrutoCli3, TotalBrutoCli1, ")
              SQL.ADD("MB2, ContraEspecie, TotalBrutoCli2, MB2, MB6, ")
              SQL.ADD("MB1, ")
            endif

            SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput ")
            SQL.ADD(") Values (")
            SQL.ADD("'"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('NrOperacion')~"', '"~fbn('Especie')~"', '"~fbn('ContraEspecie')~"',")
            SQL.ADD("'"~fbn('Cliente1')~"', "~FStr(Dialogo.Cantidad1,1,2)~", "~FStr(Dialogo.Precio1,1,8)~",  ")
            SQL.ADD(""~FStr(Dialogo.Entero1,1,0)~", '"~IdxDate(Dialogo.Fecha2)~"', "~FStr(Dialogo.Precio2,1,8)~", ")
            SQL.ADD("'"~FStr(Dialogo.Radio2,1,0)~"', "~FStr(Val(z9),1,2)~", '"~Val(z8)~"', ")
            SQL.ADD("'"~fbn('Book1')~"', '"~fbn('Vehiculo1')~"',  '"~fbn('Corporate')~"',")         
            SQL.ADD("'"~fbn('Mercado')~"','"~fbn('Mercado2')~"',  '0', ")           
            SQL.ADD("'"~Val(z1)~"', '"~fbn('TipoOp')~"', ")
            SQL.ADD("'"~fbn('Cuenta1')~"', '"~fbn('Cuenta2')~"',  '"~fbn('Cuenta3')~"',  '"~fbn('Cuenta4')~"',")         
            if Incluido(fbn('TipoOp'),'MMCT|MMCO')
               SQL.ADD("'"~fbn('TablaFeriados1')~"', '"~fbn('DiasAnio')~"','"~fbn('OpSiopel')~"',  ")         
               SQL.ADD("'Renovacion',  ")         
               SQL.ADD(FSTR(fbn('Precio3'),0,2)~", '"~fbn('Cliente3')~"', "~FSTR(fbn('PorComision'),0,2)~", ")         
               if EQSTR(fbn('Especie'),'USD')
                  SQL.ADD(FSTR(Dialogo.Cantidad1,0,2)~", ")
               else   
                  SQL.ADD(FSTR(Dialogo.Cantidad1*COTIZACIONC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'),0,2)~", ")
               endif   
               SQL.ADD("'"~fbn('Cartera')~"', '"~fbn('TotalComisiones')~"','"~fbn('MB2')~"',  ")         
               SQL.ADD("'"~fbn('MB6')~"', '"~fbn('RB7')~"','"~fbn('CB5')~"',   ")         
            endif

            if Incluido(fbn('TipoOp'),'MMAD|MMDES')
              * PorImpuesto  (% Percepcion)
              if EqStr(BuscarCampo('CLIENTES','Res3337','Codigo',fbn('Cliente1')),'SI')
                ACN(z2,Var('PERCEP'))
                * TotalRetenciones (Percep)
                if Val(z9)>=Var('PERCMINIMO')
                  acn(z5,Val(z9)*Val(z2)/100)
                else
                  acn(z5,0)
                endif
              else
                ACN(z2,0)
              endif
              * Precio3 (%Iva)
              ACN(z3,Var('IVA'))
              * TotalImpuestos (IVA)
              ACN(z4,Val(z9)*Val(z3)/100)
              * TotalBrutoCli1
              ACN(z6,Dialogo.Cantidad1+Val(z9)+Val(z4)+Val(z5))
              SQL.ADD(""~FStr(Val(z4),1,2)~", "~FStr(Val(z5),1,2)~", "~FStr(Val(z3),1,8)~", ")
              SQL.ADD(""~FStr(Val(z2),1,8)~", "~FStr(fbn('Cantidad')+fbn('TotalIntereses'),1,2)~", "~FStr(Val(z6),1,2)~",")
            endif
            if EqStr(fbn('TipoOp'),'MMCA')
              * Precio3 (% Ret.Gan.)
              acn(z2,fbn('Precio3'))
              * TotalRetenciones (Ret.Ganan)
              acn(z5,Val(z9)*Val(z2)/100)
              * TotalBrutoCli1  (Monto)
              acn(z6,Dialogo.Cantidad1+Val(z9)-Val(z5))
              SQL.ADD(" "~FStr(Val(z5),1,2)~", "~FStr(Val(z2),1,8)~", "~FStr(Val(z6),1,2)~",")
            endif
            if EqStr(fbn('TipoOp'),'MMCO')
              * TotalBrutoCli1
              ACN(z6,Dialogo.Cantidad1+Val(z9))
              SQL.ADD(" "~FStr(fbn('Cantidad')+fbn('TotalIntereses'),1,2)~", '"~FStr(Dialogo.Radio1,1,0)~"', "~FStr(Val(z6),1,2)~",")
            endif
            if EqStr(fbn('TipoOp'),'MMCT')
              * TotalBrutoCli1
              ACN(z6,Dialogo.Cantidad1+Val(z9))
              SQL.ADD(" "~FStr(fbn('Cantidad')+fbn('TotalIntereses'),1,2)~", '"~FStr(Dialogo.Radio1,1,0)~"', "~FStr(Val(z6),1,2)~",")
            endif

            if Incluido(fbn('TipoOp'),'MMPF|MMPFCE')
              * Precio3 (% Ret.Gan.)
              acn(z2,fbn('Precio3'))
              * TotalReteciones (Ret.Ganan)
              acn(z5,Val(z9)*Val(z2)/100)
              * TotalBrutoCli1  (Monto)
              acn(z6,Dialogo.Cantidad1+Val(z9)-Val(z5))
              * Precio1 (Tasa 360)
              if EqStr(fbn('DiasAnio'),'0')
                acn(z7,(Dialogo.Precio1*365)/360)
              else
                acn(z7,Dialogo.Precio1)
              endif
              SQL.ADD(" "~FStr(Val(z5),1,2)~", "~FStr(Val(z2),1,8)~", "~FStr(Val(z6),1,2)~",")
              SQL.ADD(" '"~FStr(fbn('CB5'),1,0)~"', '"~FStr(fbn('RB4'),1,0)~"', '"~FStr(fbn('DiasAnio'),1,0)~"', "~FStr(Val(z7),1,8)~", '"~FStr(Dialogo.Radio1,1,0)~"', ")
            endif

            if Incluido(fbn('TipoOp'),'MMPFCE')

               SQL.ADD(" "~FStr(Dialogo.Cantidad3,1,2)~" , '"~Dialogo.Especie2~"' , "~FStr(Dialogo.Precio5,1,8)~" , ")
               SQL.ADD(" "~FStr(Dialogo.Precio6,1,8)~", '"~IdxDate(Dialogo.Fecha3)~"' , "~FStr(Dialogo.Cantidad4,1,2)~" ,   ")

            endif

            if Incluido(fbn('TipoOp'),'MMPO')
              * PorImpuesto  (% Percepcion)
              if EqStr(BuscarCampo('CLIENTES','Res3337','Codigo',fbn('Cliente1')),'SI')
                ACN(z2,Var('PERCEP'))
                * TotalRetenciones (Percep)
                if Val(z9)>=Var('PERCMINIMO')
                  acn(z5,Val(z9)*Val(z2)/100)
                else
                  acn(z5,0)
                endif
              else
                ACN(z2,0)
              endif
              * Precio3 (%Iva)
              ACN(z3,Var('IVA'))
              * TotalImpuestos (IVA)
              ACN(z4,Val(z9)*Val(z3)/100)
              * TotalBrutoCli1
              ACN(z6,Dialogo.Cantidad1+Val(z9)+Val(z4)+Val(z5))
              SQL.ADD(" "~FStr(Val(z4),1,2)~", "~FStr(Val(z5),1,2)~", "~FStr(Val(z3),1,8)~", ")
              SQL.ADD(" "~FStr(Val(z2),1,8)~", "~FStr(fbn('Cantidad')+fbn('TotalIntereses'),1,2)~", "~FStr(Val(z6),1,2)~",")
              SQL.ADD(" '"~FStr(fbn('MB2'),1,0)~"', '"~fbn('ContraEspecie')~"', "~FStr(fbn('TotalBrutoCli2'),1,2)~", ")
              SQL.ADD("'"~FStr(Dialogo.Radio1,1,0)~"', ")
            endif
            SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~UsuarioActivo~"' ")
            SQL.ADD(")")
            SQL.NEW
            recorrer&J 1, 81
              ACT(A1, FStr(&J,1,0))
              if Incluido(Val(A1),'1|3|7|10|30|70|')
                SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
                SQL.ADD(" Values ('"~Val(z1)~"',"~FStr(&J,1,0)~",'0') ")
                SQL.NEW
              endif
            proximo
            SQL.ADD(" Update "~DBO~".OPERACIONESBITS set Valor='1' ")
            SQL.ADD(" where  NrBit=1 and NrOperacion= '"~Val(z1)~"' ")
            SQL.NEW
            
            SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '1' where NrOperacion = '"~Val(h:&i)~"'")
            SQL.NEW
            SQL.EXEC
            SQL.ActualizarMovimientos3(Val(Z:1),SI,SI,NO,SI,SI)
            SQL.EXEC
          proximo
        endif
      endif

      if Val(l:&i)=1
        *********** Cancela *********
        CrearDialogo:13
          TipoOp1       : 'Tipo Op'     ;1;1;;NO;;;;;Val(c:&i)
          NrOperacion1  : 'NrOperacion' ;1;2;;NO;;;;;Val(h:&i)
          Especie1      : 'Especie'     ;2;1;;NO;;;;;Val(b:&i)
          Cliente1      : 'Cliente'     ;3;1;;NO;;;;;Val(a:&i)
          Fecha1        : 'Fecha Op'    ;2;2;;NO;;;;;FSys
          Entero1       : 'Plazo'       ;3;2;;NO;;;;;Val(g:&i)
          Fecha2        : 'Fecha Vto'   ;4;2;;NO;;;;;Dialogo.Fecha1+Dialogo.Entero1
          Cantidad1     : 'Cantidad'    ;4;1;;NO;;;;;Val(d:&i)
          Precio1       : 'Tasa (%)'    ; ; ;;NO;;;;;Val(e:&i)
          Precio2       : 'T.Base (%)'  ;6;1;;NO;;;;;Val(j:&i)
          Radio2        : 'Tipo T.base|Transferencia|Call';6;2;;NO;NO;;;;Val(j:&i);
          Cantidad2     : 'Interes'     ;7;1;;NO;;;;;Val(f:&i)
          String        : 'Observ.'     ; ; ;;;;;;;  
        FinDialogo
        if Ok
          SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '2' , Observaciones = '"~Dialogo.String~"' ")
          SQL.ADD("where NrOperacion = '"~Val(h:&i)~"'")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    proximo
  endif

else
  Cancelar('No existen operaciones')
endif
