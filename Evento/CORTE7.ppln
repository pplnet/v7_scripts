sql.add(" Select A.Especie, A.FechaCorte, A.NrCupon, A.FechaPago, A.PrecioCupon, E.Cupon, E.FEmision, ")
sql.add(" E.MonedaEmision, A.Estado  from "~Dbo()~".AGENDACUPONES A, "~Dbo()~".ESPECIES E ")
sql.add(" Where A.FechaCorte = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" and A.Especie = E.Codigo ")

recorrer sql
if (Eqstr(Fbn('Estado'), 'PRO'))
Act(a:fac, Fbn('Especie'))
Acd(b:fac, Fbn('FechaCorte'))
Acn(c:fac, Fbn('Cupon'))
Acn(d:fac, iif (Val(c:fac) = sql(" Select Max(convert(int, NrCupon)) From "~Dbo()~".AGENDACUPONES Where Especie = '"~Fbn('Especie')~"' "), Val(c:fac), Val(c:fac) - 1))
Acd(e:fac, iif (Fbn('FechaPago') >= FSys(), ProxCupon2(Val(a:fac), FSys()), Fbn('FechaPago')))
Act(g:fac, Fbn('MonedaEmision'))
Acn(h:fac, Fbn('PrecioCupon'))
Acn(i:fac, iif (Val(c:fac) > 0, Val(d:fac) + 1, 0))
Acd(j:fac, Fbn('FEmision'))
Act(ei:fac, sql(" Select Especie3 From "~Dbo()~".TRANSACCIONES2 Where TipoTr2 = 'ACUPON' AND Especie = '"~Val(a:fac)~"' AND Cupon1 = "~FStr(Val(d:fac), 0, 0)~" "))
Acn(ci:fac, sql(" Select CB5 From "~Dbo()~".TRANSACCIONES2 Where TipoTr2 = 'ACUPON' AND Especie = '"~Val(a:fac)~"' AND Cupon1 = "~FStr(Val(d:fac), 0, 0)~" "))
Acn(pc:fac, iif (Val(ci:fac) = 1, Cotizacion(Val(ei:fac), null, null, null, Val(b:fac), 1, SI), 0))
Acn(pi:fac, iif (Val(ci:fac) = 1, Cotizacion(Val(ei:fac), null, null, null, Val(j:fac), 1, SI), 0))

ejecutarevento('CORTE2', especie1 = Val(a:fac), mercado1 = '', fecha1 = Val(b:fac), fecha2 = Val(e:fac), especie2 = Val(g:fac), entero3 = Val(c:fac), entero1 = Val(d:fac), vehiculo1 = Val(vh:1), check1 = 1, check3 = 1, check2 = 1, check4 = 1, check5 = 1, entero2 = Val(i:fac), check6 = 1, fecha3 = Val(j:fac), especie4 = Val(ei:fac), precio2 = Val(pc:fac), precio3 = Val(pi:fac), radio1 = 2, listatabla1 = '', check7 = Val(ci:fac), especie5 = Val(ei:fac), check8 = 1, radio2 = 1)
