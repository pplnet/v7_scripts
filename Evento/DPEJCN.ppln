Sqladd(" '"~Fbn()['Operador']~"', '"~Fbn()['Observac2']~"', ")
Sqladd(" '0',")
Sqladd(" '"~IdxDate(Fbn()['FechaOp2'])~"',"~FStr(Fbn()['Plazo'], 0, 0)~",")
Sqladd(" "~FStr(Fbn()['Cuotas1'], 0, 0)~", '"~IdxDate(Fbn()['FechaEj'])~"','"~Fbn()['RB3']~"' ) ")
Sqlnew()

Sqlactualizarmovimientos(Val(z3), SI)
