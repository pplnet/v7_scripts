Sqladd(" MB3,MB1,")
Sqladd(" TipoOpcion,")
Sqladd(" PrecioRef,Cliente1,")
Sqladd(" Especie, PrecioEj,")
Sqladd(" Cantidad,")
Sqladd(" ContraEspecie,Precio1,")
Sqladd(" FechaVto, TotalNetoCli1,")
