endif

Acd(d1, Query("Select Fecha2 FROM "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota=(Select Max(NrCuota) FROM "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"') "))

Message(Val(d1))

if (Vacio(Val(d1)))
Acd(d1, BuscarCampo('Operaciones', 'FechaPago', 'NrOperacion', dialogo.nroperacion1))
Message(Val(d1)~' Operaciones Simple ')
endif




if (dialogo.fecha1 > Val(d1))
Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
endif


if (ok)
Acn(x1, 0)

Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and ((TipoOpcion='0' and FechaEx1 = '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd(" or (TipoOpcion='1' and FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and FechaEx1>= '"~IdxDate(dialogo.fecha1)~"')) ")


