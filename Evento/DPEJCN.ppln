if (Fbn()['MB2'] = 0)
Act(z1, 'DPOA')
else
if (Fbn()['MB2'] = 1)
Act(z1, 'DPOD')
else
Act(z1, 'DPOS')
endif
endif

Message('Generando Operacion .... ')

Sqladd("INSERT INTO "~Dbo()~".OPERACIONES ")
