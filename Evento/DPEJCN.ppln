Sqladd(" '"~IdxDate(FSys())~"','"~Fbn()['Vehiculo1']~"', ")
Sqladd(" '"~Fbn()['MB3']~"', '"~Fbn()['MB1']~"',")
Sqladd(" '"~Fbn()['TipoOpcion']~"', ")
Sqladd(" '"~Fbn()['PrecioRef']~"', '"~Fbn()['Cliente1']~"',")
Sqladd(" '"~Fbn()['Especie']~"', "~FStr(Fbn()['PrecioEj'], 0, 7)~", ")
Sqladd(" "~FStr(Fbn()['Cantidad'], 0, 4)~", ")
Sqladd(" '"~Fbn()['ContraEspecie']~"', "~FStr(Fbn()['TipoCambio'], 0, 7)~", ")
Sqladd(" '"~IdxDate(dialogo.fecha2)~"', "~FStr(Val(z4), 0, 2)~",")
Sqladd(" '"~Fbn()['CB9']~"','"~Val(x12)~"', "~Fbn()['TotalAux2']~", ")
