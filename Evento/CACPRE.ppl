ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPCL|MMPCLM|MMPCOS|MMPOSM|MMFCMV|MMFRN|MMPE|MMPEM|MMPI|MMPIM|MMPSC|MMSCMV|MMON|MMONM|');'El TipoOp debe ser MMPCL|MMPCLM|MMPCOS|MMPOSM|MMFCMV|MMFRN|MMPE|MMPEM|MMPI|MMPIM|MMPSC|MMSCMV|MMON|MMONM|';NO;;;;;;" TipoOp in ('MMPCL','MMPCLM','MMPCOS','MMPOSM','MMFCMV','MMFRN','MMPE','MMPEM','MMPI','MMPIM','MMPSC','MMSCMV','MMON','MMONM') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACPRE')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

ACT(ml:99, var('MONELOCA'))
ACT(me:99, var('MONEEXTR'))

SQL.ADD("Select TipoOp, Cliente1, Cantidad, Especie, Cuenta1, Vehiculo1, FechaOp, FechaVto, Precio1, Plazo ")
SQL.ADD("From "~DBO~".OPERACIONES  where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACN(zd:98, fbn['Cantidad'])
   ACT(ze:99, fbn['Cuenta1'])
   ACT(zf:99, fbn['Vehiculo1'])
   ACD(zg:99, fbn['FechaOp'])
   ACD(zh:99, fbn['FechaVto'])
   ACN(zi:99, fbn['Plazo'])
   ACT(zj:99, fbn['Precio1'])
Proximo


ACT(mo:99, BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99)))

If EqStr(val(zc:99),val(ml:99))
    act(ms:99, '$')
else
    If EqStr(val(zc:99),val(me:99))
       act(ms:99, 'u$s')
    Else
       act(ms:99, Val(zc:99)~' ')
    Endif
Endif

let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))
let &fecha_larga FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)
let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99))

If Eqstr(val(za:99), 'MMFCMV') o Eqstr(val(za:99), 'MMFRN')
   ACT(PX:99, 'un Floating rate note (FRN)')
Else
   If Eqstr(val(za:99), 'MMPE') o Eqstr(val(za:99), 'MMPEM')  
      ACT(PX:99, 'una Prefinanciaci'~Chr(243)~'n de exportaciones')
   Else   
      If Eqstr(val(za:99), 'MMPI') o Eqstr(val(za:99), 'MMPIM')  
         ACT(PX:99, 'una PostFinanciaci'~Chr(243)~'n de importaciones')
      Else
         If Eqstr(val(za:99), 'MMPSC') o Eqstr(val(za:99), 'MMSCMV')  
            ACT(PX:99, 'un Pr'~Chr(233)~'stamo sindicado')
         Else
            If Eqstr(val(za:99), 'MMON') o Eqstr(val(za:99), 'MMONM')  
               ACT(PX:99, 'una Obligaci'~Chr(243)~'n negociable')
            Else
               If Incluido(val(za:99),'MMPCL|MMPCLM|MMPCOS|MMPOSM|')
                  ACT(PX:99, 'un pr'~Chr(233)~'stamo financiero')
               EndIf
            EndIf
         EndIf
      EndIf
   EndIf
EndIf



If Incluido(val(za:99),'MMPCL|MMPCOS|MMFRN|MMPE|MMPI|MMPSC|MMON|')

   let &oracion11 'Por medio de la presente, confirmamos a Uds. haberles tomado '~Val(PX:99)~' por la suma de '~IIF(EqStr(val(zc:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zc:99),val(me:99)),val(ms:99),val(zc:99) ) )
   let &oracion12 ' '~val(zd:99)~' ('~val(mo:99)~': '~Letras(val(zd:98),0,100)~') con fecha de inicio '~FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)~' por '~Fstr(val(zi:99), 0, 0)~' d'~Chr(237)~'as'
   let &oracion13 ', cuyo vencimiento se producir'~Chr(225)~' el '~FStr(Dia(val(zh:99)),1,0)~' de '~Meses(Mes(val(zh:99)))~' de '~FStr(Anio(val(zh:99)),4,0)~' a una T.N.A. de '~val(zj:99) ~'%. '
   
   let &oracion21 'Con los '~val(mo:99)~' a nuestra disposici'~Chr(243)~'n en vuestro Banco por la suma de '~val(ms:99)~' '~val(zd:99)~' solicitamos a Uds. acreditarlo en nuestra'
   let &oracion22 ' cuenta corriente en '~val(mo:99)~' en vuestro Banco, Cuenta Nro. '~BuscarCampo('CUENTAS','Numero','Codigo',val(ze:99))~'. '

Else
   ACT(TS:1, Fstr(SQL(" Select Precio2 From "~DBO~".CUOTAS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrCuota = 1 "), 0, 2))
   
   let &oracion11 'Por medio de la presente, confirmamos a Uds. haberles tomado '~Val(PX:99)~' por la suma de '~IIF(EqStr(val(zc:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zc:99),val(me:99)),val(ms:99),val(zc:99) ) )
   let &oracion12 ' '~val(zd:99)~' ('~val(mo:99)~': '~Letras(val(zd:98),0,100)~') con fecha de inicio '~FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)~' por '~Fstr(val(zi:99), 0, 0)~' d'~Chr(237)~'as'
   let &oracion13 ', a una T.N.A. de '~val(ts:1)~'% para el primer per'~Chr(237)~'odo cuyo vencimiento se producir'~Chr(225)~' seg'~Chr(250)~'n el siguiente cronograma '


   If Eqstr(val(za:99), 'MMONM')
      ACT(MT:99, 'Cantidad4')
   Else
      ACT(MT:99, 'Cantidad1')
   Endif
   
   let &cronograma ''
   
   SQL.ADD(" Select Fecha2, "~Val(MT:99)~" From "~DBO~".CUOTAS Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   Recorrer SQL
        let &cronograma &cronograma~Chr(13)~FBN['Fecha2']~'  '~val(ms:99)~FBN[Val(MT:99)]
   Proximo
   
   
   let &oracion21 'Con los '~val(mo:99)~' a nuestra disposici'~Chr(243)~'n en vuestro Banco por la suma de '~val(ms:99)~' '~val(zd:99)~' solicitamos a Uds. acreditarlo en nuestra'
   let &oracion22 ' cuenta corriente en '~val(mo:99)~' en vuestro Banco, Cuenta Nro. '~BuscarCampo('CUENTAS','Numero','Codigo',val(ze:99))~'. '
   
EndIf

EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion11 = &oracion11, oracion12 = &oracion12, oracion13 = &oracion13, oracion21 = &oracion21, oracion22 = &oracion22, cronograma = &cronograma)
