creardialogo
nroperacion1:'Operacion';;;;;;;;;
radio1:'Comision|FPD|CDO';;;;;;;;;
fecha1:'Desde Op.';;;;;;;;;FSys()
fecha2:'Hasta Op.';;;;;;;;;FSys()
lista1:'Vehiculos';;;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))
findialogo

if (NoVacio(dialogo.nroperacion1))

Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif

endif

Act(z1, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

Sqladd("Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaOp2, ")
Sqladd("       C. Cliente1, C.Tipo, C.Tasa1, C.Fecha1, C.Importe4, C.NrComision ")
Sqladd("from   "~Dbo()~".OPERACIONES O, "~Dbo()~".COMISIONES2 C")
Sqladd("where  O.NrOperacion=C.NrOperacion  and ")
Sqladd("       O.FechaOp >= '"~IdxDate(dialogo.fecha1)~"' and ")
Sqladd("       O.FechaOp <= '"~IdxDate(dialogo.fecha2)~"' and ")
Sqladd("       (C.Tipo='2' or C.Tipo='0') ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("     and O.NrOperacion='"~dialogo.nroperacion1~"' ")
endif
if (dialogo.radio1 = 0)
Sqladd("    and C.Tipo='0' ")
endif
if (dialogo.radio1 = 1)
Sqladd("    and C.Tipo='2' ")
endif
if (NoVacio(dialogo.lista1))
Sqladd("       and O.Vehiculo1 in ("~Pipe2Comillas(dialogo.lista1)~") ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd("    and O.Vehiculo1 IN ("~Pipe2Comillas(Val(z1))~") ")
endif
endif

Sqladd(" order by O.NrOperacion")

recorrer sql

Message('Procesando Operacion '~Fbn()['NrOperacion']~' ...')

Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Act(c:fac, Fbn('Cliente1'))

if (Eqstr(Fbn('Tipo'), '0'))
Act(d:fac, 'FPD')
endif
if (Eqstr(Fbn('Tipo'), '1'))
Act(d:fac, 'FFC')
endif
if (Eqstr(Fbn('Tipo'), '2'))
Act(d:fac, 'CDO')
endif
if (Eqstr(Fbn('Tipo'), '3'))
Act(d:fac, 'CPI')
endif
if (Eqstr(Fbn('Tipo'), '4'))
Act(d:fac, 'CF')
endif
if (Eqstr(Fbn('Tipo'), '5'))
Act(d:fac, 'EF')
endif

Acn(e:fac, Fbn('Tasa1'))
Acd(f:fac, Fbn('Fecha1'))
Acn(g:fac, Fbn('Importe4'))
Acn(h:fac, Fbn('NrComision'))
Acd(k:fac, Fbn('FechaOp'))
Acd(j:fac, Fbn('FechaOp2'))
proximo

ACO(3, 15)
ACO(4, 5)
ACO(5, 6)
ACO(6, 8)
ACO(7, 12)
ACO(8, 2)

FormatoCeldas(g1..g:fac, Exe('F2'))
FormatoCeldas(e1..e:fac, Exe('F2'))
FormatoCeldas(h1..h:fac, Exe('F0'))

* listbox stripped

if (ok)
* recorrersel stripped





































endif

