creardialogo
fecha1: 'Fecha';1;1;;;;NoVacio(dialogo.fecha1);'Debe ingresar una fecha';NO;FSys()
cuenta1: 'Cuenta';;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.cuenta1))
let(&cuenta, dialogo.cuenta1)
let(&nrcuenta, BuscarCampo('Cuentas', 'Numero', 'Codigo', &cuenta))
let(&banco, BuscarCampo('Clientes', 'Alias3', 'Codigo', BuscarCampo('Cuentas', 'Comitente', 'Codigo', &cuenta)))
if (Query("SELECT 1 FROM "~Dbo()~".SALDOSBANCARIOS WHERE Estado = 'REC' AND Banco = '"~&banco~"' AND NrCuenta = '"~&nrcuenta~"' AND FechaSaldo < '"~IdxDate(dialogo.fecha1)~"' ") > 0)
Cancelar('Hay Saldos pendientes por procesar.')
endif
else
if (Query("SELECT 1 FROM "~Dbo()~".SALDOSBANCARIOS WHERE Estado = 'REC' AND FechaSaldo < '"~IdxDate(dialogo.fecha1)~"' ") > 0)
Cancelar('Hay Saldos pendientes por procesar.')
endif
endif

let(&fechalimite, Habiles(dialogo.fecha1, 1, 'ARG', SI))

recorrer&i dialogo.fecha1, &fechalimite - 1
Sqladd("SELECT FechaSaldo, SaldoConPromedio, NrCuenta, Banco, SaldoContable + Ajuste as SaldoContable")
Sqladd("FROM "~Dbo()~".SALDOSBANCARIOS")
Sqladd("WHERE FechaSaldo = '"~IdxDate(&i)~"'")
Sqladd("AND Estado = 'REC'")
Sqladd("AND SignoInicial = 'C'")
if (NoVacio(dialogo.cuenta1))
Sqladd("AND Banco = '"~&banco~"' AND NrCuenta = '"~&nrcuenta~"'")
endif
recorrer sql
if (Vacio(dialogo.cuenta1))
let(&comitente, BuscarCampo('Clientes', 'Codigo', 'Alias3', Fbn()['Banco']))
let(&numero, Fbn()['NrCuenta'])
Sqladd("SELECT Codigo")
Sqladd("FROM "~Dbo()~".CUENTAS")
Sqladd("WHERE Numero = '"~&numero~"' AND Comitente = '"~&comitente~"'")
recorrer sql
let(&cuenta, Fbn()['Codigo'])
proximo
endif

let(&saldopromedio, Fbn()['SaldoConPromedio'])
let(&saldocontable, Fbn()['SaldoContable'])

let(&fechasaldo, Fbn()['FechaSaldo'])

Sqladd("SELECT FechaOp, FechaOp2, FechaVto, Plazo, Vehiculo1, Cliente1, Especie, Precio1, RB8, NrOperacion, TotalIntereses, Cuenta1, ")
Sqladd(" Cantidad, CB2, TotalNetoCli2 ")
Sqladd("FROM "~Dbo()~".OPERACIONES")
Sqladd("WHERE TipoOp = 'MMRPAC' AND ")
Sqladd("FechaOp <= '"~IdxDate(Fbn()['FechaSaldo'])~"' AND FechaVto >= '"~IdxDate(Fbn()['FechaSaldo'])~"' ")
Sqladd("AND Cuenta1 = '"~&cuenta~"' ")
recorrer sql
if (Fbn('CB2') = 1)
let(&saldominimo, Fbn()['TotalNetoCli2'])
else
let(&saldominimo, Fbn()['Cantidad'])
endif
let(&operacionmmrpac, Fbn()['NrOperacion'])
if (&fechasaldo = FinDeMes(dialogo.fecha1, SI, 'ARG') y &saldominimo > &saldopromedio)
Sqladd("DELETE FROM "~Dbo()~".OPERACIONES")
Sqladd("WHERE TipoOp = 'MMCCR' AND OperacionRef = '"~&operacionmmrpac~"'")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONES")
Sqladd(" SET TotalIntereses = 0, ")
Sqladd(" TotalNetoCli1 = "~&saldopromedio~"")
Sqladd("WHERE NrOperacion = '"~&operacionmmrpac~"'")
Sqlnew()
Sqlexec()

Sqladd("DELETE FROM "~Dbo()~".CUOTAS")
Sqladd("WHERE NrOperacion = '"~&operacionmmrpac~"'")
Sqlnew()
Sqlexec()

else
let(&fechaop, &i)
let(&fechaop2, &i)
let(&plazo, 1)
let(&fechavto, &i + &plazo)
let(&vehiculo1, Fbn()['Vehiculo1'])
let(&cliente1, Fbn()['Cliente1'])
let(&especie, Fbn()['Especie'])
let(&precio1, Fbn()['Precio1'])
let(&rb8, Fbn()['RB8'])
let(&operacionref, Fbn()['NrOperacion'])
let(&cuenta1, Fbn()['Cuenta1'])
let(&totalintereses, &saldopromedio * &precio1 * &plazo / iif (&rb8 = 0, 36000, 36500))
let(&numerador, BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', &vehiculo1))
let(&nroperacion, getnumerador(Num(&numerador)))

let(&totalinteresesmmrpac, Fbn()['TotalIntereses'] + &totalintereses)

Sqladd("Insert Into "~Dbo()~".OPERACIONES ( ")
Sqladd("TipoOp,     Operador,      FechaOp,         FechaOp2,")
Sqladd("FechaVto,   Plazo,         Vehiculo1,       Cliente1,")
Sqladd("Especie,    Precio1,       UsrInput,        NrOperacion,")
Sqladd("FechaEj,    Cantidad,      TotalIntereses,  Cuenta1,")
Sqladd("FechaCarga, FechaCargaSys, TablaFeriados1,  CB1,")
Sqladd("OperacionRef, TotalNetoCli1 ")
Sqladd("   ) VALUES (")
Sqladd(" 'MMCCR',                       '"~UsuarioActivo()~"',          '"~IdxDate(&fechaop)~"',     '"~IdxDate(&fechaop2)~"', ")
Sqladd(" '"~IdxDate(&fechavto)~"',      '1',                          '"~&vehiculo1~"',            '"~&cliente1~"',")
Sqladd(" '"~&especie~"',                "~FStr(&precio1, 0, 8)~",       '"~UsuarioActivo()~"',         '"~&nroperacion~"',         ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', "~FStr(&saldopromedio, 0, 2)~", "~FStr(&totalintereses, 0, 2)~", '"~&cuenta1~"',")
Sqladd(" "~SQLAhora()~",                  '"~IdxDate(FSys())~"',          'ARG',                       '1',")
Sqladd(" '"~&operacionref~"',           "~FStr(&saldocontable, 0, 2)~" ")
Sqladd("   )")
Sqlnew()
Sqlexec()

SqlActualizarmovimientos3(&nroperacion, NO, NO, NO, NO, SI)
Sqlnew()
Sqlexec()

Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 50, 'nroperacion1', &nroperacion)

let(&nrcuota, 0)
Sqladd("SELECT Max(NrCuota) as NrCuota")
Sqladd("FROM "~Dbo()~".CUOTAS")
Sqladd("WHERE NrOperacion = '"~&operacionref~"'")
recorrer sql
let(&nrcuota, Fbn()['NrCuota'])
proximo
Sqladd("Insert Into "~Dbo()~".CUOTAS (NrOperacion, Fecha1, Cantidad1, Cantidad2, Total1, NrCuota) ")
Sqladd("VALUES")
Sqladd(" ('"~&operacionref~"','"~IdxDate(&fechaop)~"',"~FStr(&saldocontable, 0, 2)~","~FStr(&saldopromedio, 0, 2)~","~FStr(&totalintereses, 0, 2)~","~FStr(&nrcuota + 1, 0, 0)~") ")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONES")
Sqladd("SET TotalIntereses = "~FStr(&totalinteresesmmrpac, 0, 2)~"")
if (&fechasaldo = FinDeMes(dialogo.fecha1, SI, 'ARG'))
Sqladd(",CB1 = 1")
Sqladd(", TotalNetoCli1 = "~&saldopromedio~"")
endif
Sqladd("WHERE NrOperacion = '"~&operacionref~"'")
Sqlnew()
Sqlexec()

if (&fechasaldo = FinDeMes(dialogo.fecha1, SI, 'ARG'))
SqlActualizarmovimientos3(&operacionref, SI, NO, NO, NO, SI)
Sqlnew()
Sqlexec()
endif
endif
