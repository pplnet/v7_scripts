CrearDialogo
  Vehiculo1    : 'Vehiculo'     ;;;;;;;;;;;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO WHERE Codigo = '"~USUARIOACTIVO~"') ")
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  NrOperacion1 : "Nr.Operacion" ;
  TipoOp1      : "Tipo Op"      ;;;
  Especie1     : "Especie"      ;;;
  Radio1       : 'Grupo|FX|DP|DT|MM|SE|FC|Todos';;;;;;;;6;
  Radio2       : 'Tipo|Movimientos|Posiciones|Limites|Devengados';;;;;;;;0;
FinDialogo
 
If Not Ok
  Cancelar
Endif
***---HojaVisible(SI)

If NoVacio(Dialogo.NrOperacion1)
  ACT(X1, "O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Else
  If NOVACIO(Dialogo.TipoOp1)
    ACT(X1, "O.TipoOp = '"~Dialogo.TipoOp1~"' ")
  Else
    ACT(X1, "FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
    IF Dialogo.Radio1=0
      ACT(x1, Val(X1)~" and TipoOp LIKE 'FX%' ")   
    EndIf
    IF Dialogo.Radio1=1
      ACT(x1, Val(X1)~" and TipoOp LIKE 'DP%' ")
    EndIf
    IF Dialogo.Radio1=2
      ACT(x1, Val(X1)~" and TipoOp LIKE 'DT%' ")   
    EndIf
    IF Dialogo.Radio1=3
      ACT(x1, Val(X1)~" and TipoOp LIKE 'MM%' ")   
    EndIf
    IF Dialogo.Radio1=4
      ACT(x1, Val(X1)~" and TipoOp LIKE 'SE%' ")   
    EndIf
    IF Dialogo.Radio1=5
      ACT(x1, Val(X1)~" and TipoOp LIKE 'FC%' ")   
    EndIf

    if NoVacio(Dialogo.Especie1)
      ACT(X1, Val(X1)~" and O.Especie = '"~Dialogo.Especie1~"' ")
    EndIf
    If NoVacio(Dialogo.Vehiculo1)
      ACT(x1, Val(X1)~" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
    Endif
  Endif
Endif

SQL.ADD("Select * from "~DBO~".OPERACIONES O Where "~VAL(X1)~" Order By TipoOp,NrOperacion ")
Recorrer SQL    
     Message(FBN['TipoOp']~' '~FBN['NrOperacion'])
     ACT(a:FAC, FBN['NrOperacion'])
     ACT(b:FAC, FBN['TipoOp'])
     If Dialogo.Radio2=0
       if Not Incluido(fbn['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
         SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS Where NrOperacion='"~FBN['NrOperacion']~"'  ")              
         SQL.NEW

         SQL.ADD("DELETE "~DBO~".MOVAJUSTE Where NrOperacion='"~FBN['NrOperacion']~"'  ")              
         SQL.NEW
         SQL.EXEC        
       endif
       *     SQL.ADD("DELETE "~DBO~".MOVPENDIENTES Where NrOperacion='"~FBN['NrOperacion']~"'  ")              
       *     SQL.NEW
       *     SQL.EXEC        

       *     SQL.ADD("DELETE "~DBO~".MOVPOSEJE Where NrOperacion='"~FBN['NrOperacion']~"'  ")              
       *     SQL.NEW
       *     SQL.EXEC        
       SQL.ActualizarMovimientos3(FBN['NrOperacion'],SI,NO,NO,NO,NO)
       SQL.EXEC
     EndIf

     If Dialogo.Radio2=1 
       SQL.ActualizarMovimientos2(FBN['NrOperacion'],NO,NO,NO,SI)
     EndIf

     If Dialogo.Radio2=2
       SQL.ActualizarMovimientos2(FBN['NrOperacion'],NO,SI,NO,NO)
     EndIf

     If Dialogo.Radio2=3
       SQL.ActualizarMovimientos3(FBN['NrOperacion'],NO,NO,NO,NO,SI)
     EndIf
     SQL.EXEC
proximo
