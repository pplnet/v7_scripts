MostrarCuadroDeMensajes
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo
If Not Ok
   Cancelar
Endif

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
  ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
  ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
ACD(x3, Habiles(Val(x2),1,'ARG'))

* Fecha Proceso
ACD(v:1, Dialogo.Fecha1)
* Ultimo Dia Habil mes anterior
ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
* Primer Dia Mes
ACD(v:3, Habiles(Val(v:2),1,'ARG'))

message('--- Asientos de tenencia FX FWD ---')

*** Asientos al Vencimiento ***
SQL.ADD(" SELECT O.NrOperacion,  O.Especie, O.ContraEspecie, ")
SQL.ADD("        O.FechaOp, O.FechaVto, O.Cliente1, ")
SQL.ADD("        O.Vehiculo1, ")
SQL.ADD("        O.TipoOp, O.Cantidad, O.Precio1, ")
SQL.ADD("        C.CUIT, V.Valor1, V.Valor2, ")
SQL.ADD("        M.Codigo CodAsi, E.Tipo, E.Cotiza, O.ContraEspecie Moneda, 'Vto' TipoRes, O.Plazo, ")
SQL.ADD("        Case O.CB9 When 1 Then 'NDF' Else 'NONDF' END TipoFut, O.Observaciones, O.MB4, O.CB6, O.Precio2, E.Alias8 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, ")
SQL.ADD("      "~DBO~".MODELOSASIENTO M, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.Cliente1    = C.Codigo ")
SQL.ADD(" AND   O.Vehiculo1   = V.Codigo ")
SQL.ADD(" AND   O.Especie     = E.Codigo ")
SQL.ADD(" AND   O.FechaVto    = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   O.TipoOp      IN ('FXCT','FXVT','FXAT') ")
SQL.ADD(" AND   O.Vehiculo1  Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" and   M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFW'))~") ")
SQL.ADD(" AND M.Habilitado = 'SI' ")
SQL.ADD(" AND M.Entorno = '"~SIGLA~"' ")
If NoVacio(Dialogo.ListaTabla1)
  SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND (O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") OR O.Vehiculo1 is null OR O.Vehiculo1 = '' OR O.Vehiculo1 = ' '  )")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
SQL.ADD(" ORDER BY O.NrOperacion ")
Recorrer SQL
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Dialogo.Fecha1)~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
          ACN(CK:1, 0)
      ENDIF
    ENDIF
    IF Val(CK:1) = 0
      ACT(a:FAC, fbn('NrOperacion'))
      ACT(b:FAC, fbn('TipoOp'))
      ACD(c:FAC, fbn('FechaOp'))
      ACD(d:FAC, fbn('FechaVto'))
      ACT(e:FAC, fbn('Especie'))
      ACT(f:FAC, fbn('ContraEspecie'))
      ACN(g:FAC, fbn('Cantidad'))
      ACN(h:FAC, fbn('Precio1'))
      IF Incluido(fbn('TipoOp'), 'FXAT')
          IF fbn('CB6') = 1
              ***---ACN(i:FAC, CotizacionC(fbn('Especie'),'CON',,,Dialogo.Fecha1,1,SI,fbn('ContraEspecie')))
              ACN(I:fac, fbn('Precio2'))
              ACN(j:FAC, Val(g:FAC)*(Val(i:FAC)-Val(h:FAC))) 
          ELSE
              ***---Las cotizaciones son en Especie, pero el asiento es en ContraEspecie => calculo resultado en contraespecie
              ***---Calculo copiado del evento NDFEJE
              ***---ACN(i:FAC, CotizacionC(fbn('ContraEspecie'),'CON',,,Dialogo.Fecha1,1,SI,fbn('Especie')))
              ACN(I:fac, fbn('Precio2'))
              ACN(J:fac, ((Val(I:fac)^(-1))-(fbn('Precio1')^(-1)))*fbn('Cantidad')*(-1))
              ***---Le cambio el signo ya que en los modelos el resultado + es perdida y los - son ganancia
              ACN(J:fac, Val(J:fac) * (-1))
          ENDIF
      ELSE
          ***---ACN(i:FAC, CotizacionC(fbn('Especie'),'CON',,,Dialogo.Fecha1,1,SI,fbn('ContraEspecie')))
          ACN(I:fac, fbn('Precio2'))
          ACN(j:FAC, Val(g:FAC)*(Val(i:FAC)-Val(h:FAC)))
          IF Incluido(fbn('TipoOp'), 'FXCT')
              ***---Le cambio el signo porque los modelos estan con el signo desde el pto de vista de una venta.
              ACN(J:fac, Val(J:fac) * (-1))                  
          ENDIF
      ENDIF
      ACN(z1, Val(j:FAC))
      ACD(FV:1, Dialogo.Fecha1)
      ACT(VH:1, fbn('Vehiculo1'))
      (.'FECHAVALOR'.)
      ACN(RS:1, Val(J:fac))
      SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC    
  ENDIF
proximo

*************************
*** Asientos Fin de Mes
*************************
if Dialogo.Fecha1=Val(x2)
  SQL.ADD(" SELECT O.NrOperacion,  O.Especie, O.ContraEspecie, ")
  SQL.ADD("        O.FechaOp, O.FechaVto, O.Cliente1, ")
  SQL.ADD("        O.Vehiculo1, ")
  SQL.ADD("        O.TipoOp, O.Cantidad, O.Precio1, ")
  SQL.ADD("        C.CUIT, V.Valor1, V.Valor2, ")
  SQL.ADD("        M.Codigo CodAsi, E.Tipo, E.Cotiza, O.ContraEspecie Moneda, 'Fin' TipoRes, O.Plazo, ")
  SQL.ADD("        Case O.CB9 When 1 Then 'NDF' Else 'NONDF' END TipoFut, O.Observaciones, O.MB4, O.CB6, E.Alias8 ")
  SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, ")
  SQL.ADD("      "~DBO~".MODELOSASIENTO M, "~DBO~".ESPECIES E ")
  SQL.ADD(" WHERE O.Cliente1    = C.Codigo ")
  SQL.ADD(" AND   O.Vehiculo1   = V.Codigo ")
  SQL.ADD(" AND   O.Especie     = E.Codigo ")
  SQL.ADD(" AND   O.FechaOp     <= '"~IdxDate(Val(v:2))~"' ")
  SQL.ADD(" AND   O.FechaVto    > '"~IdxDate(Val(v:2))~"' ")
  SQL.ADD(" AND   O.TipoOp      IN ('FXCT','FXVT','FXAT') ")
  SQL.ADD(" AND   O.Vehiculo1  Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
  SQL.ADD(" and   M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFW'))~") ")
  SQL.ADD(" AND M.Habilitado = 'SI' ")
  SQL.ADD(" AND M.Entorno = '"~SIGLA~"' ")
  If NoVacio(Dialogo.ListaTabla1)
    SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
  Endif
  If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND (O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") OR O.Vehiculo1 is null OR O.Vehiculo1 = '' OR O.Vehiculo1 = ' ' )  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
    Endif
  Endif
  SQL.ADD(" ORDER BY O.NrOperacion ")
  Recorrer SQL
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
       ACN(CK:1, 1)
       IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(V:2))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
       ENDIF
    ENDIF

    IF Val(CK:1) = 0
      ACT(aa:FAC, fbn('NrOperacion'))
      ACT(ab:FAC, fbn('TipoOp'))
      ACD(ac:FAC, fbn('FechaOp'))
      ACD(ad:FAC, fbn('FechaVto'))
      ACT(ae:FAC, fbn('Especie'))
      ACT(af:FAC, fbn('ContraEspecie'))
      ACN(ag:FAC, fbn('Cantidad'))
      ACN(ah:FAC, fbn('Precio1'))
      IF Incluido(fbn('TipoOp'), 'FXAT')
          IF fbn('CB6') = 1
              ACN(ai:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('ContraEspecie')))
              ACN(aj:FAC, Val(AG:FAC)*(Val(AI:FAC)-Val(AH:FAC))) 
          ELSE
              ACN(ai:FAC, CotizacionC(fbn('ContraEspecie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('Especie')))
              ***---Las cotizaciones son en Especie, pero el asiento es en ContraEspecie => calculo resultado en contraespecie
              ***---Calculo copiado del evento NDFEJE
              ACN(AJ:fac, ((Val(AI:fac)^(-1))-(fbn('Precio1')^(-1)))*fbn('Cantidad')*(-1))
              ***---Le cambio el signo ya que en los modelos el resultado + es perdida y los - son ganancia
              ACN(AJ:fac, Val(AJ:fac) * (-1))
          ENDIF
      ELSE
          ACN(ai:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('ContraEspecie')))
          ACN(aj:FAC, Val(AG:FAC)*(Val(AI:FAC)-Val(AH:FAC))) 
          IF Incluido(fbn('TipoOp'), 'FXCT')
              ***---Le cambio el signo porque los modelos estan con el signo desde el pto de vista de una venta.
              ACN(AJ:fac, Val(AJ:fac) * (-1))
          ENDIF
      ENDIF
      ACN(z1, Val(aj:FAC))
      ACD(FV:1, Val(V:2))
      ACT(VH:1, fbn('Vehiculo1'))
      (.'FECHAVALOR'.)
      ACN(RS:1, Val(AJ:fac))
      SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
    ENDIF
  proximo
endif

*******************************
*** Reversa Asientos Fin de Mes
*******************************
if Dialogo.Fecha1=Val(x3)
  SQL.ADD(" SELECT O.NrOperacion,  O.Especie, O.ContraEspecie, ")
  SQL.ADD("        O.FechaOp, O.FechaVto, O.Cliente1, ")
  SQL.ADD("        O.Vehiculo1, ")
  SQL.ADD("        O.TipoOp, O.Cantidad, O.Precio1, ")
  SQL.ADD("        C.CUIT, V.Valor1, V.Valor2, ")
  SQL.ADD("        M.Codigo CodAsi, E.Tipo, E.Cotiza, O.ContraEspecie Moneda, 'Rev' TipoRes, O.Plazo, ")
  SQL.ADD("        Case O.CB9 When 1 Then 'NDF' Else 'NONDF' END TipoFut, O.Observaciones, O.MB4, O.CB6, E.Alias8 ")
  SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, ")
  SQL.ADD("      "~DBO~".MODELOSASIENTO M, "~DBO~".ESPECIES E ")
  SQL.ADD(" WHERE O.Cliente1    = C.Codigo ")
  SQL.ADD(" AND   O.Vehiculo1   = V.Codigo ")
  SQL.ADD(" AND   O.Especie     = E.Codigo ")
  SQL.ADD(" AND   O.FechaOp     <= '"~IdxDate(Val(v:2))~"' ")
  SQL.ADD(" AND   O.FechaVto    > '"~IdxDate(Val(v:2))~"' ")
  SQL.ADD(" AND   O.TipoOp      IN ('FXCT','FXVT','FXAT') ")
  SQL.ADD(" AND   O.Vehiculo1 Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
  SQL.ADD(" and   M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFW'))~") ")
  SQL.ADD(" AND M.Habilitado = 'SI' ")
  SQL.ADD(" AND M.Entorno = '"~SIGLA~"' ")
  If NoVacio(Dialogo.ListaTabla1)
    SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
  Endif
  If NoVAcio(Dialogo.Lista1)
      SQL.ADD(" AND (O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  OR O.Vehiculo1 is null OR O.Vehiculo1 = '' OR O.Vehiculo1 = ' ' )")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
    Endif
  Endif
  SQL.ADD(" ORDER BY O.NrOperacion ")
  Recorrer SQL
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
       ACN(CK:1, 1)
       IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(V:3))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
       ENDIF
    ENDIF

    IF Val(CK:1) = 0    
      ACT(ba:FAC, fbn('NrOperacion'))
      ACT(bb:FAC, fbn('TipoOp'))
      ACD(bc:FAC, fbn('FechaOp'))
      ACD(bd:FAC, fbn('FechaVto'))
      ACT(be:FAC, fbn('Especie'))
      ACT(bf:FAC, fbn('ContraEspecie'))
      ACN(bg:FAC, fbn('Cantidad'))
      ACN(bh:FAC, fbn('Precio1'))
      IF Incluido(fbn('TipoOp'), 'FXAT')
          IF fbn('CB6') = 1
              ACN(BI:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('ContraEspecie')))
              ACN(bj:FAC, Val(BG:FAC)*(Val(BI:FAC)-Val(BH:FAC))) 
          ELSE
              ACN(BI:FAC, CotizacionC(fbn('ContraEspecie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('Especie')))
              ***---Las cotizaciones son en Especie, pero el asiento es en ContraEspecie => calculo resultado en contraespecie
              ***---Calculo copiado del evento NDFEJE
              ACN(BJ:fac, ((Val(BI:fac)^(-1))-(fbn('Precio1')^(-1)))*fbn('Cantidad')*(-1))
              ***---Le cambio el signo ya que en los modelos el resultado + es perdida y los - son ganancia
              ACN(BJ:fac, Val(BJ:fac) * (-1))
          ENDIF
      ELSE
          ACN(BI:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Val(v:2),1,SI,fbn('ContraEspecie')))
          ACN(bj:FAC, Val(BG:FAC)*(Val(BI:FAC)-Val(BH:FAC))) 
          IF Incluido(fbn('TipoOp'), 'FXCT')
              ***---Le cambio el signo porque los modelos estan con el signo desde el pto de vista de una venta.
              ACN(BJ:fac, Val(BJ:fac) * (-1))
          ENDIF
      ENDIF
      ACN(z1, Val(aj:FAC))
      ACD(FV:1, Val(V:3))
      ACT(VH:1, fbn('Vehiculo1'))
      (.'FECHAVALOR'.)
      ACN(RS:1, Val(BJ:fac))
      SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC    
    ENDIF
  proximo
endif
