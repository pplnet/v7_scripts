sql.add(" Select  /*+ RULE */ T.NrTrans ")
sql.add(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" Where T.NrTrans = B.NrOperacion ")
sql.add(" and (t.cb3 is null or t.cb3 = '0') ")
sql.add(" and (t.cb2 is null or t.cb2 = '0') ")
sql.add(" and (t.cb4 is null or t.cb4 = '0') ")
sql.add(" AND B.NrBit < 11 ")
sql.add(" AND B.Valor = '1' ")
sql.add(" and t.nroperacionref1 is not null ")


