creardialogo
string1: 'Nro. Op./Orden';;;;;;NoVacio(dialogo.string1);'Debe ingresar una Operacion';NO;
radio1:'Tabla|OPERAC|ORDEN';;;;;;;;;0;;
radio2:'Direcc|0NULL|1RETRO|2AVANZ';;;;;;;;;0;;
entero1: "NrInstDesde";;;;;;NoVacio(dialogo.entero1) y dialogo.entero1 >= 0;'Debe ingresar una Instancia ';NO;
entero2: "NrInstHacia";;;;;;NoVacio(dialogo.entero2) y dialogo.entero2 <> 0;'Debe ingresar una Instancia ';NO;

findialogo

if (not ok)
Cancelar()
endif

Sqladd("Update "~Dbo()~".OPERACIONESBITS Set ")
Sqladd("  Valor = '0' ")
Sqladd("where NrOperacion = '"~dialogo.string1~"' ")
if (dialogo.entero1 <> 0)
Sqladd("  and NrBit       = "~dialogo.entero1)
endif
Sqlnew()
if (Query("SELECT 1 FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion='"~dialogo.string1~"' and NrBit="~FStr(dialogo.entero2, 1, 0)) = 1)
Sqladd("Update "~Dbo()~".OPERACIONESBITS Set ")
Sqladd("  Valor = '1' ")
Sqladd("where NrOperacion = '"~dialogo.string1~"' ")
Sqladd("  and NrBit       = "~dialogo.entero2)
Sqlnew()
else 
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd(" (NrOperacion, NrBit, Valor ")
Sqladd("  ) VALUES( ")
Sqladd("  '"~dialogo.string1~"', "~dialogo.entero2~", 1) ")
Sqlnew()
endif

if (dialogo.radio1 = 0)
Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set Direccion   = "~dialogo.radio2)
Sqladd(" where NrOperacion = '"~dialogo.string1~"' ")
Sqlnew()
endif

Act(x1, 'Evento CBOINS mueve a '~FStr(dialogo.entero2, 1, 0))
Sqladd("Insert Into "~Dbo()~".INSTANCIASOP ")
Sqladd(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.string1~"', "~dialogo.entero1~", '"~UsuarioActivo()~"', '"~Val(x1)~"', "~SQLAhora()~" )")
Sqlnew()


Sqlexec()

