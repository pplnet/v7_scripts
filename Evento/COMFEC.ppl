CrearDialogo
  NrOperacion1 : 'Operacion'        ;;;;;;;;;
  Radio1       : 'Comision|FPD|CDO' ;;;;;;;;;
  Fecha1       : 'Desde Op.'        ;;;;;;;;;FSys
  Fecha2       : 'Hasta Op.'        ;;;;;;;;;FSys
  Lista1       : 'Vehiculos'        ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

If NoVacio(Dialogo.NrOperacion1)
   *- Control de vehiculo habilitado para el usuario
   *- vh1: vehiculo de la operacion o transaccion
   *- Cancela si el vehiculo no esta habilitado para el usuario activo
    
   ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
    
   (.'CONTROLVH'.)
Endif

* Vehiculos permitidos por el usuario
ACT(z1,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

SQL.ADD("Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaOp2, ")
SQL.ADD("       C. Cliente1, C.Tipo, C.Tasa1, C.Fecha1, C.Importe4, C.NrComision ")
SQL.ADD("from   "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C" )
SQL.ADD("where  O.NrOperacion=C.NrOperacion  and ")
SQL.ADD("       O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("       O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' and ")
SQL.ADD("       (C.Tipo='2' or C.Tipo='0') ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("     and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
Endif
If Dialogo.Radio1=0
   SQL.ADD("    and C.Tipo='0' ")
Endif
If Dialogo.Radio1=1
   SQL.ADD("    and C.Tipo='2' ")
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD("    and O.Vehiculo1 IN ("~Pipe2Comillas(val(z1))~") ")
   EndIf
Endif
   
SQL.ADD(" order by O.NrOperacion")

recorrer SQL

  Message('Procesando Operacion '~FBN['NrOperacion']~' ...')

  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1'))

  IF EQSTR(FBN('Tipo'),'0')
     ACT(d:fac, 'FPD')
  ENDIF
  IF EQSTR(FBN('Tipo'),'1')
     ACT(d:fac, 'FFC')
  ENDIF
  IF EQSTR(FBN('Tipo'),'2')
     ACT(d:fac, 'CDO')
  ENDIF
  IF EQSTR(FBN('Tipo'),'3')
     ACT(d:fac, 'CPI')
  ENDIF
  IF EQSTR(FBN('Tipo'),'4')
     ACT(d:fac, 'CF')
  ENDIF
  IF EQSTR(FBN('Tipo'),'5')
     ACT(d:fac, 'EF')
  ENDIF

  ACN(e:fac, fbn('Tasa1'))
  ACD(f:fac, fbn('Fecha1'))
  ACN(g:fac, fbn('Importe4'))
  ACN(h:fac, fbn('NrComision'))
  ACD(k:fac, fbn('FechaOp'))
  ACD(j:fac, fbn('FechaOp2'))
proximo

ACO(3,15)
ACO(4,5)
ACO(5,6)
ACO(6,8)
ACO(7,12)
ACO(8,2)

FormatoCeldas(g1..g:fac, Exe('F2'))
FormatoCeldas(e1..e:fac, Exe('F2'))
FormatoCeldas(h1..h:fac, Exe('F0'))

ListBox(a1..j:fac, '# Op     Tipo     Destinatario      Tipo      Tasa       Fecha       Importe')

if ok
  RecorrerSel
       
       * Verifico que se encuentre en Back Office o Terminal
       ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~VAL(a:FilaCiclo)~"' AND Valor='1'") )

       If VAL(X1)<>20 y VAL(X1)<>50
          *-- Busco la instancia actual
          Cancelar("La Operacion "~VAL(a:FilaCiclo)~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
       EndIf
 
       CrearDialogo
          NrOperacion1 : 'Operacion'   ;;;;NO;;;;;VAL(a:FilaCiclo)
          TipoOp1      : 'TipoOp'      ;1;2;;NO;;;;;VAL(b:FilaCiclo)
          Fecha2       : 'F.Origen'    ;3;2;;NO;;;;;VAL(k:FilaCiclo) 
          Fecha3       : 'F.Concert.'  ;;;;NO;;;;;VAL(j:FilaCiclo)
          String       : 'Comision'    ;2;1;;NO;;;;;VAL(d:FilaCiclo)
          Precio1      : 'Importe '    ;;;;NO;;;;;VAL(g:FilaCiclo)
          Fecha1       : 'Fecha Nueva' ;;;;;;[[EqStr(VAL(d:FilaCiclo),'FPD') y Dialogo.Fecha1>=VAL(k:FilaCiclo)] o [Dialogo.Fecha1>=VAL(k:FilaCiclo)]] y ESHABIL(Dialogo.Fecha1,'ARG');"La Fecha debe ser Habil y Posterior a la Fecha "~IIF(EqStr(VAL(d:FilaCiclo),'FPD'),'Origen','Concertacion');NO;VAL(f:FilaCiclo)
       FinDialogo

       IF ok
          Message('Actualizando Fecha de Comision ....')
          SQL.ADD("Update "~DBO~".COMISIONES2 ")
          SQL.ADD("Set")
          SQL.ADD("Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
          SQL.ADD("and NrComision = "~Fstr(VAL(h:FilaCiclo),2,0)~" ")
          SQL.NEW
          SQL.EXEC    

          * Actualizo la Instancia de la Operacion a Supervision
          (.'MODIINSTAN'.)      

          *** Actualiza movimientos y limites ****
          SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
          SQL.EXEC
       ENDIF
  proximo
EndIf
