Sqladd("Select NrInstancia, '"~dialogo.nrtrans1~"', '0'")
Sqladd("from "~Dbo()~".INSTANCIAS ")
Sqladd("where Tabla = 'TRANSACCIONES2'")

recorrer sql
if (Query("SELECT 1 FROM DBO.OPERACIONESBITS WHERE NrOperacion='"~dialogo.nrtrans1~"' and NrBit="~FStr(Fbn()['NrInstancia'], 1, 0)) = 1)
Sqladd("UPDATE DBO.OPERACIONESBITS SET Valor=0 WHERE NrOperacion='"~dialogo.nrtrans1~"' and  NrBit="~FStr(Fbn()['NrInstancia'], 1, 0))
Sqlnew()
else
Sqladd("INSERT INTO DBO.OPERACIONESBITS (NrOperacion, NrBit,Valor) VALUES ('"~dialogo.nrtrans1~"','"~Fbn()['NrInstancia']~"','0')")
Sqlnew()
endif
if (Fbn()['NrInstancia'] = dialogo.entero1)
Sqladd("UPDATE DBO.OPERACIONESBITS SET Valor=1 WHERE NrOperacion='"~dialogo.nrtrans1~"' and  NrBit="~FStr(Fbn()['NrInstancia'], 1, 0))
Sqlnew()
endif
