creardialogo
fecha1:'Fecha';1;;;;;;;;FSys();
nrtrans1: 'Transaccion';;;;;;NoVacio(dialogo.nrtrans1);'Debe ingresar una transaccion';NO;;;;;;"Fecha1>="~IdxDate2(dialogo.fecha1)~" and Fecha1<"~IdxDate2(dialogo.fecha1 + 1)~" and TipoTr2 in('DEP','RET')";;
entero1:'Pasar a Instancia';;;;;;dialogo.entero1 > 0;'Debe ingresar una instancia';NO;12;;;;'###';
entero2:'Nr.Instancias';1;;;NO;NO;;;;;sql("SELECT Count(1) FROM "~Dbo()~".OPERACIONESBITS WHERE NrOperacion='"~dialogo.nrtrans1~"'");
entero3:'Cant.Instancias';;;;NO;NO;;;;;sql("SELECT Count(1) FROM "~Dbo()~".INSTANCIAS WHERE Tabla = 'TRANSACCIONES2'");
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.entero2 = dialogo.entero3)
Cancelar()('El voucher no está en condiciones de regenerar instancias')
endif

sql.add("Select NrInstancia, '"~dialogo.nrtrans1~"', '0'")
sql.add("from "~Dbo()~".INSTANCIAS ")
sql.add("where Tabla = 'TRANSACCIONES2'")

recorrer sql
if (sql("SELECT 1 FROM DBO.OPERACIONESBITS WHERE NrOperacion='"~dialogo.nrtrans1~"' and NrBit="~FStr(Fbn()['NrInstancia'], 1, 0)) = 1)
sql.add("UPDATE DBO.OPERACIONESBITS SET Valor=0 WHERE NrOperacion='"~dialogo.nrtrans1~"' and  NrBit="~FStr(Fbn()['NrInstancia'], 1, 0))
sql.new
else
sql.add("INSERT INTO DBO.OPERACIONESBITS (NrOperacion, NrBit,Valor) VALUES ('"~dialogo.nrtrans1~"','"~Fbn()['NrInstancia']~"','0')")
sql.new
endif
if (Fbn()['NrInstancia'] = dialogo.entero1)
sql.add("UPDATE DBO.OPERACIONESBITS SET Valor=1 WHERE NrOperacion='"~dialogo.nrtrans1~"' and  NrBit="~FStr(Fbn()['NrInstancia'], 1, 0))
sql.new
endif
proximo
sql.exec

Messagebox("Instancias generadas. Debe correr la confirmacion de operaciones")


