*** GENREPO. Generacion de  Arbitrajes desde REPO(FX)
CrearDialogo
  NrOperacion1 : "Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'FXREPO|FXREPV')
   Cancelar('La operacion N? '~Dialogo.NrOperacion1~' No es un Repo')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   Message(' --- Generando Arbitrajes ...')

   * Toma la operacion verificando que no se hayan generado arbitrajes
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and (RB1='0' or RB1 IS NULL) and ")
   SQL.ADD(" Especie<>'ARP' and ContraEspecie<>'ARP' ")
   ACN(A1,0)

   Recorrer SQL
     ACN(A1,1)
     
     *** Determina los tipos de operacion a utilizar ****
     *** Z1 operacion contado, z2 operacion futuro   ****    
     *** FXREPO : FXAS y FXAT
     If EqStr(FBN['TipoOp'],'FXREPO')     
        ACT(z1,'FXAS')        
        ACT(z2,'FXAT')        
     endif

     *** FXREPV : FXASV y FXATV
     If EqStr(FBN['TipoOp'],'FXREPV')     
        ACT(z1,'FXASV')        
        ACT(z2,'FXATV')        
     endif

     *** Z3 Nro. Operacion Contado
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     ***- Arbitraje Spot
     ACT(z4,VAL(z3))

     *** Z6: Recupero CB6: Modo Cotizacion ContraEspecie/Especie para el arbitraje a termino
     ACN(Z6,1)
     IF EqStr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~FBN['Especie']~"' "),'INV')
        ACN(Z6,0)
     ENDIF

     *** Envia el valor del repo al valor del arbitraje SPOT ***
     IF FBN['Puesto']=1
        ACN(Z10,FBN['Plazo'])
        IF VAL(Z10) > 3 
           * Toma el Valor 'Otro'
           ACN(Z10,4)           
        ENDIF
     ELSE 
        ACN(Z10,FBN['Plazo']-1)
        IF VAL(Z10)>4 
           * Toma el Valor 'Otro'
           ACN(Z10,4)           
        ENDIF
     ENDIF

     * Calcula RB2 
     ACN(Z11,FBN['Plazo2'])
     IF VAL(Z11) > 3 
        * Toma el Valor 'Otro'
        ACN(Z11,4)           
     ENDIF

     Message(' ---- Generando Arbitraje Spot ...')     
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, Especie, Cliente1, Cantidad, Precio1, ")
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, ContraEspecie, ")
     SQL.ADD(" FechaOp, FechaVto, FechaPago, ")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" ValorRB1, Puesto, Observac2, OperacionRef, TablaFeriados1, TablaFeriados2, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6,PaseCB, ") 
     SQL.ADD(" ValorRB2,RB6,RB3) ") 
     SQL.ADD("Values")
     SQL.ADD("('"~Val(z1)~"', '"~Val(z3)~"', '"~FBN['Especie']~"', ")
     SQL.ADD(" '"~FBN['Cliente1']~"', "~Fstr(FBN['Cantidad'],0,4)~","~Fstr(FBN['Precio1'],0,7)~" , ")
     SQL.ADD(" "~Fstr(FBN['TotalBrutoCli1'],0,4)~", "~Fstr(FBN['TotalNetoCli1'],0,4)~", '"~FBN['ContraEspecie']~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaVto'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaPago'])~"', ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~Fstr(Val(z10),2,0)~"', '"~FBN['Puesto']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', '"~FBN['TablaFeriados1']~"', '"~FBN['TablaFeriados2']~"', ")
     SQL.ADD(" "~Fstr(FBN['Precio4'],0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', '"~FBN['MB4']~"', ")
     SQL.ADD(" '"~FBN['RB10']~"','"~FBN['CB6']~"','1',")
     SQL.ADD(" '"~Fstr(Val(z11),2,0)~"','1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (."ALTAINSTER".)

     *** Z3 Nro. Operacion Futuro
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     Message(' ---- Generando Operacion de Arbitraje Termino ...')     
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, Especie, Cliente1, Cantidad, Precio1, ")
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, ContraEspecie, ")
     SQL.ADD(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" Observac2, OperacionRef, TablaFeriados1, TablaFeriados2, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6,PaseCB,RB3 ) ") 
     SQL.ADD("Values")
     SQL.ADD("('"~Val(z2)~"', '"~Val(z3)~"', '"~FBN['ContraEspecie']~"',  ")
     SQL.ADD(" '"~FBN['Cliente1']~"', "~Fstr(FBN['TotalBrutoCli2'],0,4)~", "~Fstr(FBN['Precio2'],0,7)~" , ")
     SQL.ADD(" "~Fstr(FBN['Cantidad'],0,4)~", "~Fstr(FBN['Cantidad'],0,4)~", '"~FBN['Especie']~"' , ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaOp2'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaVto2'])~"', "~Fstr(FBN['Plazo4'],2,0)~", "~Fstr(FBN['Plazo3'],2,0)~", ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', '"~FBN['TablaFeriados2']~"', '"~FBN['TablaFeriados1']~"', ")
     SQL.ADD(" "~Fstr(FBN['Precio4'],0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', '"~FBN['MB4']~"', ")
     SQL.ADD(" '"~FBN['RB10']~"','"~VAL(Z6)~"','1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (."ALTAINSTER".)

     *** Marco la Operacion de Arbitraje como Generada Indicador RB1
     SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET RB1 = '1' ")
     SQL.ADD(" Where (NrOperacion = '"~FBN['NrOperacion']~"')  ")
     SQL.NEW    
     SQL.EXEC
   proximo

   IF VAL(A1)=0
      MessageBox('Se han generado con anterioridad las Operaciones de ARBITRAJE para esta Operacion !!!')
   ELSE 
      * Genera las Compras Ventas  
      EjecutarEvento('GCVARB',NrOperacion1=Val(z4))    

      EjecutarEvento('GCVARB',NrOperacion1=Val(z3))    
   ENDIF
endif