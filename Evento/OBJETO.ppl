*
* Depuracion Tabla Objeto
*
*********************************************************************

HojaVisible(NO)

CrearDialogo
   Fecha1       : "Fecha Hasta"              ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha Hasta';NO;FSys-5;
   Radio1       : "Monitoreo:|Con ListBox|Sin ListBox"     ;;;;;;;;;0
FinDialogo

if not Ok
  Cancelar
endif


*-- Busco INFORMACION

    SQL.ADD("Select * from  "~DBO~".OBJETOS M ")
    SQL.ADD("where M.Codigo <='"~Dialogo.Fecha1~"'  ")
    SQL.ADD("order by M.Codigo ")

*-- 
If Dialogo.Radio1=0
    Recorrer SQL
       Message(' Registro '~FBN['Codigo']~' '~FBN['Extension']~' ...')
       ACT(a:fac, FBN['Codigo'])
       ACT(b:fac, FBN['Extension'])
       ACN(k:fac, 1 )
    Proximo
       
    If fac>0
            
       CrearListBox;'Arial,10,B'
         'Elimino'              ; k1..k:fac; SI; SI;;120; COMBO; 'Si|No|'
         'Codigo'               ; a1..a:fac; NO; SI;;110; STRING
         'Extension'            ; b1..b:fac; NO; SI;;230; STRING
       FinListBox
        
       If Ok 
          Recorrer&i 1,fac
           If Val(k:&i)=0
             SQL.ADD("Delete from "~DBO~".OBJETOS  ")
             SQL.ADD("where Codigo    = '"~val(a:&i)~"'  ")
             SQL.ADD("  and Extension = '"~val(b:&i)~"'  ")
             SQL.NEW
             SQL.EXEC
*            Message('Eliminaci¢n Exitosa para: '~Dialogo.Fecha1)
             Message('Eliminaci¢n Exitosa ')
             Message('                    para: '~val(a:&i)~val(b:&i))
           endif
          Proximo
       else
          Cancelar
       Endif
    Else
       Message('No hubo eliminacion: ')
      
    EndIf

else
          Recorrer SQL
            ACT(a:fac,FBN['Codigo'])
            ACT(b:fac,FBN['Extension'])
          Proximo

          Recorrer&i 1,fac
             SQL.ADD("Delete from "~DBO~".OBJETOS  ")
             SQL.ADD("where Codigo    = '"~val(a:&i)~"'  ")
             SQL.ADD("  and Extension = '"~val(b:&i)~"'  ")
             SQL.NEW
             SQL.EXEC
             Message('Eliminaci¢n Exitosa ')
             Message('                    para: '~val(a:&i)~val(b:&i))
          Proximo
endif
          SQL.ADD("ALTER TABLE "~DBO~".OBJETOS  DEALLOCATE UNUSED")
          SQL.NEW
          SQL.EXEC
