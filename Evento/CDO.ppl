CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1; ;  ;  ;NoVacio(Dialogo.NrOperacion1);'DEBE INGRESAR UNA OPERACION';NO;
  Fecha1       : "F. Conc."                 ; ; ; ;NO;  ;;;;;BuscarCampo('Operaciones','FechaOp2','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : 'Tipo|CDO|CPI'             ; ; ; ;  ;  ;;;;0
  Entero1      : "Nro. Settlement"          ; ; ; ;Dialogo.Radio3=1;Dialogo.Radio3=1;Dialogo.Entero1=0 o SQL("Select Count(*) from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,0,0)~" ")=1;'El nro.de Settlement es Erroneo';NO;0;
  Entero2      : "Plazo"                    ; ; ; ;NO;Dialogo.Radio3=1;;;;;Iif(Dialogo.Entero1>0,SQL("Select Plazo1 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,0,0)~" "),SQL("Select Plazo from "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' "))
  Especie1     : "Especie"                  ; ; ; ;  ;  ;NOVACIO(Dialogo.Especie1);'DEBE INGRESAR UNA ESPECIE';NO;
  Fecha2       : "Fecha"                    ; ; ; ;  ;  ;Dialogo.Fecha2>=Dialogo.Fecha1 Y ESHABIL(Dialogo.Fecha2,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1));'LA FECHA DE LA CDO DEBE SER DIA HABIL EN LA TABLA DE FERIADOS SELECCIONADA EN LA OPERACION RELACIONADA Y MAYOR O IGUAL A LA FECHA DE CONCERTACION DE LA MISMA';NO;
  Cliente1     : "Destinatario"             ; ; ; ;  ;  ;NOVACIO(Dialogo.Cliente1);'DEBE INGRESAR EL DESTINATARIO';NO
  Radio1       : "Estranjero?|Loc|Ext"      ; ; ; ;NO;;;;;;IIF(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
  Precio2      : "Tasa IVA"                 ;1;2; ;;;INCLUIDO(FSTR(Dialogo.Precio2,2,2),VAR('IVA'));"EL VALOR DE LA TASA IVA ES ERRONEO: "~VAR('IVA');NO;VAR('TASAIVA');
  Cantidad2    : "Importe IVA"              ; ; ; ;NO;;;;;;(Dialogo.Cantidad1 * Dialogo.Precio2 / 100)+Dialogo.Precio1;;;"###,###,###,###.##"
  Precio3      : "Tasa WH"                  ;3;2; ;;Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));[Dialogo.Radio1=0] o [Dialogo.Radio1=1 y Incluido(Fstr(Dialogo.Precio3,2,4),VAR('TASAWH'))];'EL VALOR DE LA TASA WH ES ERRONEO: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');
  Cantidad3    : "Importe WH"               ; ; ; ;NO;Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));;;;;Iif(Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),(Dialogo.Cantidad1 * Dialogo.Precio3 / 100)+Dialogo.Precio1-Dialogo.Precio1,0);;;"###,###,###,###.##"
  Precio5      : "% Imp_Int"                ;5;2; ;;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));[Dialogo.Radio1=1] o [Dialogo.Radio1=0 y INCLUIDO(FSTR(Dialogo.Precio5,2,4),VAR('TASAINT'))];"El Valor de TASA INTERES es Erroneo: "~VAR('TASAINT');NO;VAR('DEFAINT');
  Cantidad6    : "Impto.Imp.Int"            ; ; ; ;NO;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));;;;;Iif(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),(Dialogo.Cantidad1 * Dialogo.Precio5 / 100)+Dialogo.Precio1-Dialogo.Precio1,0);;;"###,###,###,###.##"
  Cantidad4    : "Imp. a Pagar"             ;7;2; ;NO;;;;;;Dialogo.Cantidad1+Dialogo.Cantidad3+Dialogo.Cantidad6+Dialogo.Precio1;;;"###,###,###,###.##"
  Precio1      : "Tasa"                     ;9;1; ;  ;  ;Dialogo.Precio1>0;'DEBE INGRESAR UNA TASA DE CDO';NO;;IIf(Dialogo.Cantidad1<>0,Dialogo.Cantidad1*100/Dialogo.Precio4,Dialogo.Precio1)
  Cantidad1    : "Importe"                  ; ; ; ;  ;  ;;;;;Iif(Dialogo.Radio3=0,Dialogo.Precio4*Dialogo.Precio1/100,(Dialogo.Precio4*Dialogo.Precio1*Dialogo.Entero2)/IIF(Dialogo.Radio2=0,36000,36500));;;"###,###,###,###.##"
  Precio4      : "V.Nominal"                ; ; ; ;NO;  ;;;;;Iif(Dialogo.Entero1=0,BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1),SQL("Select Cantidad2-Cantidad1 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,0,0)~" ") );;;"###,###,###,###.##"
  Radio2       : "UT|360|365"               ; ; ; ;  ;  ;;;;1;
FinDialogo

If Not Ok
   Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

ACT(x1,BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1))

If Not Incluido(Val(x1),'MMFRN|MMON|MMONM|MMP|MMPCL|MMPCLM|MMPCOS|MMPE|MMPEM|MMPI|MMPIM|MMPOSM|MMPSC|MMPV|MMSCMV|MMFCMV')
   Cancelar('LA OPERACION N# '~Dialogo.NrOperacion1~' No es un Tipo de Operacion Habilitada para ingresar estos tipos de comision')
endif

acn(a1,Dialogo.Precio2)
acn(a2,Dialogo.Cantidad2)
acn(b1,Dialogo.Precio3)
acn(b2,Dialogo.Cantidad3)
acn(c1,Dialogo.Precio5)
acn(c2,Dialogo.Cantidad6)

*-- Obtengo el ultimo nro de Comision
ACN(y13,SQL("Select MAX(NrComision) from "~DBO~".COMISIONES2 WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")+1)

SQL.ADD(" Insert Into "~DBO~".COMISIONES2 ")
SQL.ADD(" (NrOperacion,Tipo,Tasa1,Importe1,")
SQL.ADD(" Especie1,Fecha1,Cliente1,")
SQL.ADD(" Tasa2,Importe2,")
SQL.ADD(" Tasa3,Importe3,")
SQL.ADD(" Precio1,Precio2,")
SQL.ADD(" RB2, Importe4, NrComision,NrCuota,Cotizacion1,Cotizacion2) ")
SQL.ADD(" Values ")
SQL.ADD(" ('"~Dialogo.NrOperacion1~"','"~IIf(Dialogo.Radio3=0,'2','3')~"' ,"~Fstr(Dialogo.Precio1,0,5)~","~Fstr(Dialogo.Cantidad1,0,2)~",")
SQL.ADD(" '"~Dialogo.Especie1~"','"~IdxDate(Dialogo.Fecha2)~"','"~Dialogo.Cliente1~"',")
SQL.ADD(" "~Fstr(val(a1),0,5)~","~Fstr(val(a2),0,2)~",")
SQL.ADD(" "~Fstr(val(b1),0,5)~","~Fstr(val(b2),0,2)~",")
SQL.ADD(" "~Fstr(val(c1),0,5)~","~Fstr(val(c2),0,2)~",")
SQL.ADD(" '"~Fstr(Dialogo.Radio2,0,0)~"', ")
SQL.ADD(" "~Fstr(Dialogo.Cantidad4,0,2)~", ")
SQL.ADD(" "~Fstr(VAL(y13),0,0)~", "~Fstr(Dialogo.Entero1,0,0)~",-1,-1 ) ")
SQL.NEW
SQL.EXEC         

**** actualiza movimientos por la nueva comision
SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
SQL.EXEC

* Actualizo la Instancia de la Operacion a Supervision
act(i3,Dialogo.NrOperacion1)
(.'MODIINSTAN'.)      

If Incluido(Val(x1),'MMFRN|MMPSC|MMFCMV|MMSCMV') y Dialogo.Radio3=1
   *-- Actualizo tambien los Items solamente para la comision CPI

   *** ingresa el periodo en las participantes
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL

     If Dialogo.Radio3=0
        * String  
        ACT(X2," Tipo IN ('2') and NrComision="~Fstr(VAL(y13),0,0)~" ")
        ACT(X3,"")
     Else 
        If Dialogo.Entero1=0
           * CPI general
           ACT(X2," Tipo  IN ('3') and NrComision="~Fstr(VAL(y13),0,0)~" ")
           ACT(X3,"")
        Else
           ACT(X2," Tipo  IN ('3') and NrCuota="~FStr(VAL(y2),0,0)~" and NrComision="~Fstr(VAL(y13),0,0)~" ")
           ACT(X3," NrCuota="~FStr(VAL(y2),0,0)~" ")
        EndIf
     EndIf

     *-- Inserto al Nueva Comision en la Participante
     EjecutarEvento('INCOMV',NrOperacion1=Dialogo.NrOperacion1,NrOperacion2=fbn['NrOperacion'],String=VAL(X2),String1=VAL(X3) )


     **** actualiza movimientos por la nueva comision
     SQL.ActualizarMovimientos(fbn['NrOperacion'],SI)
     SQL.EXEC

     * Actualizo la Instancia de la Operacion a Supervision
     act(i3,FBN['NrOperacion'])
     (.'MODIINSTAN'.)      
   Proximo

EndIf

