sql.add("Select M.FechaMov,      M.Cliente,       M.Especie,  CASE WHEN  M.Cupon Is Null THEN '0' WHEN M.Cupon='' THEN '0' WHEN M.Cupon=' ' THEN '0' ELSE M.Cupon END Cupon,    ")
sql.add("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
sql.add("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
sql.add("       O.TipoOp Tipo,   O.Mercado MercO, 'OP' Voucher , O.NrOperacion OperOrig, O.RB10, O.Cuenta2, C.CategDepositante, M.NrGrupo ")
sql.add("from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B,"~Dbo()~".CLIENTES C ")
sql.add("where M.NrOperacion = O.NrOperacion")
sql.add("and M.NrOperacion = B.NrOperacion")
sql.add("and M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
sql.add("and M.Cliente = O.Cliente1 ")
sql.add("and M.Cliente = C.Codigo ")
sql.add("and M.NrSaldo = 1   ")

if (dialogo.check1 = 0)
sql.add("and M.Concepto <> 'TI' ")
else
sql.add("and O.TipoOp in ('TIC','TIV') and O.Mercado4 = '"~dialogo.mercado2~"' ")
if (dialogo.check14 = 1)
sql.add("and O.CB3 = '1' ")
else
sql.add("and O.CB3 = '0' ")
endif
endif
if (dialogo.check2 = 0)
sql.add("and M.Concepto <> 'FX' ")
endif
if (dialogo.check3 = 0)
sql.add("and M.Concepto <> 'MM' ")
endif
if (dialogo.check4 = 0)
sql.add("and M.Concepto <> 'PM' ")
endif
if (dialogo.check12 = 0)
sql.add("and M.Concepto <> 'RF' ")
endif
if (dialogo.check13 = 1)
sql.add("and M.NrGrupo = 15   ")
else
sql.add("and (M.NrGrupo <> 15 or M.NrGrupo is Null)  ")
endif
if (dialogo.check11 = 0)
sql.add("and M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
else
sql.add("and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
endif
sql.add("and M.Bits in ('MV','MI') ")
if (NoVacio(dialogo.cliente1))
sql.add("and M.Cliente = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.especie1))
sql.add("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.mercado1))
sql.add("and M.Mercado = '"~dialogo.mercado1~"' ")
endif
sql.add("and M.Mercado not in("~pipe2comillas(Var('MERCAACMC'))~") ")
sql.add("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
sql.add("and ((M.Status <> 'MATCH' or M.Status = '' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
sql.add("and B.NrBit in ('10','70') and B.Valor = '1'  ")

sql.add("union ")
sql.add("Select M.FechaMov,      M.Cliente,       M.Especie,  CASE WHEN  M.Cupon Is Null THEN '0' WHEN M.Cupon='' THEN '0' WHEN M.Cupon=' ' THEN '0' ELSE M.Cupon END Cupon,    ")
sql.add("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
sql.add("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
sql.add("       T.TipoTr2 Tipo,  T.Mercado1 MercO , 'TR' Voucher , T.NrOperacionRef1 OperOrig, 0 RB10, '' Cuenta2 , C.CategDepositante, M.NrGrupo ")
sql.add("from "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B,"~Dbo()~".CLIENTES C ")
sql.add("where M.NrOperacion = T.NrTrans")
sql.add("and M.NrOperacion = B.NrOperacion")
sql.add("and M.EnteCustodia = '"~dialogo.vehiculo1~"' ")
sql.add("and M.Cliente = T.Cliente1 ")
sql.add("and M.Cliente = C.Codigo ")
sql.add("and M.NrSaldo = 1 ")
if (dialogo.check1 = 0)
sql.add("and M.Concepto <> 'TI' ")
endif
if (dialogo.check2 = 0)
sql.add("and M.Concepto <> 'FX' ")
endif
if (dialogo.check3 = 0)
sql.add("and M.Concepto <> 'MM' ")
endif
if (dialogo.check4 = 0)
sql.add("and M.Concepto <> 'PM' ")
endif
if (dialogo.check12 = 0)
sql.add("and M.Concepto <> 'RF' ")
endif
if (dialogo.check10 = 0)
sql.add("and M.Concepto <> 'OCT' ")
endif
if (dialogo.check11 = 0)
sql.add("and M.FechaMov = '"~IdxDate(dialogo.fecha1)~"' ")
else
sql.add("and M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"' ")
endif
if (dialogo.check13 = 1)
sql.add("and M.NrGrupo = 15   ")
else
sql.add("and (M.NrGrupo <> 15 or M.NrGrupo is Null)  ")
endif
sql.add("and M.Bits in ('MV','MI') ")
if (NoVacio(dialogo.cliente1))
sql.add("and M.Cliente = '"~dialogo.cliente1~"' ")
endif
if (NoVacio(dialogo.especie1))
sql.add("and M.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.mercado1))
sql.add("and M.Mercado = '"~dialogo.mercado1~"' ")
endif
sql.add("and M.Mercado not in("~pipe2comillas(Var('MERCAACMC'))~") ")
sql.add("and T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
sql.add(" AND ((B.NrBit = 5 AND T.TipoTr2 <> 'LIQOCT') OR (B.NrBit = 4 AND T.TipoTr2 = 'LIQOCT')) ")
sql.add("and B.Valor = '1' ")
sql.add("Order By 2, 9, 10, 3, 4, 11, 1, 6 ")

