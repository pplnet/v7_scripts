creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';;;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;

findialogo

if (not ok)
Raise('Evento Cancelado')
endif

Act(me:1, Var('MONEEXTR'))
Act(ml:1, Var('MONELOCA'))
Acn(na:1, Var('ASINUM'))
Acn(sl:1, Var('SALDOPOCON'))
Act(vc:1, dialogo.vehiculo1)
Message('--- Asientos de Liquidacion ---')
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))

Message('Liquidacion de Comisiones y Derechos')
Sqladd(" Select T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, Abs(M.Cantidad) as Cantidad, MA.Codigo CodAsi, ")
Sqladd(" CL.Jerarquia, CL.PaisDir, Case when T.Tipotr2 = 'MATCH' Then T.Cuenta3 else T.Cuenta1 end Cuenta1, ")
Sqladd(" O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Mercado4, ")
Sqladd(" Case when T.Tipotr2 = 'MATCH' Then T.Cuenta4 else T.Cuenta2 end Cuenta2, ")
Sqladd(" O.Cuenta3, Case when T.TipoTr2 = 'MATCH' then T.Especie1 else T.Especie end Especie, ")
Sqladd(" O.TipoOp, O.NrOperacion, ")
Sqladd(" '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, ")
Sqladd(" O.Cliente1 Cliente, Abs(M.Cantidad) ImporteVoucher, M.Especie MonedaLiq, C.Mercado, O.TotalBrutoCli1, O.FechaVto, ")
Sqladd(" M.Cuenta, T.Fecha2, T.Fecha1, O.FechaPago, O.FechaOp, O.Cliente1, O.Precio1, O.Plazo, O.Book1, C.CuentaContable2, ")
Sqladd(" C.CuentaContable1, CL.CategDepositante, T.Cliente1 ClienteVoucher, O.TotalComisiones Comision, T.TipoTr2, ")
Sqladd(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, Case when O.TipoOp = 'FXC' OR O.TipoOp='FXV' then O.Especie else O.ContraEspecie End Moneda, O.Cupon1, T.Fecha1, T.Fecha2, ME.Netea, ")
Sqladd(" O.CB4, T.Cantidad26 ConceptoLiq, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos1 ELSE O.TotalAux2 END ComisionOp, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos2 ELSE O.TotalIva END IvaComision, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalDerechos ELSE O.TotalGastos END DerechoMercado, ")
Sqladd(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalIva ELSE O.TotalIvaAdi END IvaDerechos, ")
Sqladd(" E.Tipo TipoEspecie,TotalBrutoCli3, E.Issuer, E.Alias1 as EspBanTotal, O.Mercado2 MerLiqMon,O.Especie EspecieOp, T.Especie MonedaVou, O.TotalIntereses Interes, ")
Sqladd(" MA.TipoAsiento, O.Mercado4 MerNegociacion, O.CB5 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("    INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON MA.TipoAsiento = '"~Var('TIPASILGAS')~"' ")
Sqladd("    INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV'))) ")
Sqladd("    INNER JOIN "~Dbo()~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
Sqladd("    INNER JOIN "~Dbo()~".CUENTAS C ON M.Cuenta = C.Codigo ")
Sqladd("    INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")
Sqladd("    INNER JOIN dbo.MERCADOS ME ON O.Mercado2 = ME.Codigo ")
Sqladd("  Where O.NrOperacion = M.NrOperacion ")
Sqladd("   AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
Sqladd("   AND T.NrTrans = M.NrTrans2 ")
Sqladd("   AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV')))")
Sqladd("   AND M.NrSaldo = 1 ")
Sqladd("   AND T.Cantidad26 in ('1') ")
Sqladd("   AND M.NrMov in (11,4,15) ")
Sqladd("   AND C.Codigo  = M.Cuenta ")
Sqladd("   AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd("   AND MA.Habilitado = 'SI' ")
Sqladd("   AND T.TipoTr2 in ('RET','DEP','MATCH') ")
Sqladd("   AND ((T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
Sqladd("   AND ((T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
if (dialogo.radio1 = 4)
Sqladd(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO','TICF','TIVF','FXCF','FXVF','FXK','FXC','FXV')) ")
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
else 
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
endif
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ')) ")
Sqladd(" OR O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
Sqladd(") ")
else 
if (dialogo.radio1 = 0)
Sqladd(" AND ((O.TipoOp IN ('TICF','TIVF')) ")
if (Eqstr(Var('INSTALACIO'), 'MLASA'))
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
else 
Sqladd("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
endif
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
else 
if (dialogo.radio1 = 1)
Sqladd(" AND O.TipoOp IN ('FXK','FXC','FXV')")
else 
if (dialogo.radio1 = 2)
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
else 
if (dialogo.radio1 = 3)
Sqladd(" AND O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
endif
endif
endif
endif
endif
Watch(Sqlbatch())
recorrer sql
if (Eqstr(Fbn('Netea'), 'SI') o Fbn('CB5') = 1 o Eqstr(Fbn('Cliente'), Fbn('Vehiculo1')))
Acd(fv:1, Fbn('Fecha1'))
else 
Acd(fv:1, Fbn('Fecha2'))
endif
Act(fv:2, Fbn('FechaVto'))
Acd(fd:1, dialogo.fecha1)
Act(vh:1, Fbn('Vehiculo1'))
Act(mn:99, Fbn('MonedaLiq'))
Act(bk:1, Fbn('Book1'))
Act(cp:99, Fbn('Cupon1'))
Act(to:1, Fbn('CodAsi'))
Act(ti:1, Fbn('TipoOp'))
Act(nr:1, Fbn('NrOperacion'))
Act(nr:2, Fbn('NrTrans'))
Acn(ck:1, 0)

if (Eqstr(Var('MERCTAPTE'), 'NEG'))
let(&merctapte, Fbn('MerNegociacion'))
else 
let(&merctapte, Fbn('MerLiqMon'))
endif
if (Fbn('CB4') = 1)
if (Eqstr(Fbn('Mercado4'), 'MAE'))
if (Eqstr(Fbn('ContraEspecie'), 'ARP'))
Act(ct:55, '321179003')
else 
Act(ct:55, '325179003')
endif
else 
if (Eqstr(Fbn('ContraEspecie'), 'ARP'))
Act(ct:55, '321179004')
else 
Act(ct:55, '325179004')
endif
endif
endif
if (Incluido(Fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO') y EvalFormula('ESLIQVTO'))
Sqladd("select SUM(Cantidad1) DevCont from ASIENTOSCON1 A1, ASIENTOSCON A ")
Sqladd("where A1.NrUnicoAsiento=A.NrUnicoAsiento ")
Sqladd("and A.NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd("and A1.NrItem=1 ")
Sqladd("and (A.NrAsiento = ''  or A.NrAsiento is NULL) ")
Sqladd("and A.Modelo in (Select Codigo from MODELOSASIENTO where TipoAsiento IN ("~Pipe2Comillas(Var('TIPASDEV'))~")) ")
Watch(Sqlbatch())
recorrer sql
Acn(dc:1, Fbn('DevCont'))
proximo
endif
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrOperacion = '"~Fbn('NrOperacion')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND NrTrans2 = '"~Fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrOperacion')~'  - Modelo: '~Fbn('CodAsi'))
Sqlgenerarasientoop(&codasi, Fbn('NrOperacion'), '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoOp'), null, Fbn('NrTrans'), null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
