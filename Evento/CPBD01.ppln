sql.add(" SELECT /*+ RULE */ DISTINCT M.NrDatanet, M.NrMovDatanet, M.Banco, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, ")
sql.add(" M.DC, M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, E.Codigo MonedaFPA, ")
sql.add(" C.Codigo CuentaFPA, B.Codigo BancoFPA, CD.Tipo TipoDatanet, C2.Numero CtaPpal ")
sql.add(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".DATANET D, "~Dbo()~".VEHICULOS V, "~Dbo()~".ESPECIES E,")
sql.add(" "~Dbo()~".CUENTAS C, "~Dbo()~".CLIENTES B, "~Dbo()~".CODIGOSDATANET CD, "~Dbo()~".TIPOSCODIGODATANET TD, "~Dbo()~".CUENTAS C2 ")
sql.add(" WHERE  M.NrDatanet    = D.NrDatanet   ")
sql.add(" AND    C.CtaPrincipal = C2.Codigo     ")
sql.add(" AND    M.Vehiculo     = V.Codigo  (+) ")
sql.add(" AND    M.Cuenta       = C.Numero   (+) ")
sql.add(" AND    M.Moneda       = E.Alias3  (+) ")
sql.add(" AND    M.Banco        = B.Alias2  (+) ")
sql.add(" AND    M.TipoMov      = CD.Codigo (+) ")
sql.add(" AND    CD.Tipo        = TD.Codigo  ")
sql.add(" AND    M.FechaAcreditacion >= "~IdxDate2(dialogo.fecha1)~" ")
sql.add(" AND    M.FechaAcreditacion <= "~IdxDate2(dialogo.fecha2)~" ")
sql.add(" AND    D.Archivo      IN ("~pipe2comillas(Val(ll:1))~")  ")
sql.add(" AND    TD.Codigo     IN ("~pipe2comillas(Var('CPBD021'))~")  ")
sql.add(" AND    M.NrMovDatanet NOT IN (SELECT HNrMovDatanet FROM "~Dbo()~".EXTRACTOS WHERE HNrDatanet=M.NrDatanet ) ")
if (NoVacio(dialogo.lista1))
sql.add(" AND V.Codigo  IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND V.Codigo IN ("~pipe2comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
sql.add(" AND C.CtaPrincipal IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND C.Codigo  IN ("~pipe2comillas(dialogo.lista3)~")  ")
else
sql.add(" AND (C.TipoCuenta IN ('INT','REC') OR C.Pagadora='SI') ")
sql.add(" AND (C.CtaPrincipal IS NOT NULL OR C.CtaPrincipal <> '') ")
endif
sql.add(" ORDER By M.Banco, M.Cuenta, M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion ")

recorrer sql
Message('Extracto '~Fbn('NrDatanet')~' - Mov: '~Fbn('NrMovDatanet'))

recorrer&i 1, Val(bz:1)
Acn(kk:1, 1)
Acn(mt:1, 0)

if (Eqstr(Val(e:&i), Fbn('CtaPpal')) y not Eqstr(Val(h:&i), Fbn('DC')) y Val(aa:&i) <> 1)
if (dialogo.check1 = 1 y Fbn('FechaAcreditacion') <> Val(j:&i))
Message('No es la misma fecha.')
Acn(kk:1, 0)
endif
if (dialogo.check2 = 1 y Eqstr(Val(l:&i), Fbn('Comprobante')))
Message('No es el mismo comprobante.')
Acn(kk:1, 0)
endif
if (dialogo.check3 = 1)
if (Abs(Fbn('Importe')) <> Abs(Val(g:&i)))
Message('No es la misma cantidad.')
Acn(kk:1, 0)
endif
else
if (Abs(Abs(Fbn('Importe')) - Abs(Val(g:&i))) > dialogo.cantidad1)
Message('Supera el rango de tolerancia.')
Acn(kk:1, 0)
else
Acn(mt:1, (Abs(Fbn('Importe')) - Abs(Val(g:&i))))
endif
endif
else
if (Val(aa:&i) = 1)
Message('Matcheo con el Extracto '~Val(ab:&i)~' - Movimiento: '~FStr(Val(ac:&i), 0, 0))
endif
Acn(kk:1, 0)
endif

if (Val(kk:1) = 1)
Acn(aa:&i, 1)
Act(ab:&i, Fbn('NrDatanet'))
Acn(ac:&i, Fbn('NrMovDatanet'))
Act(ad:&i, Fbn('Banco'))
Act(ae:&i, Fbn('Cuenta'))
Act(af:&i, Fbn('Moneda'))
Acn(ag:&i, Val(mt:1))
Acn(ah:&i, Fbn('Importe'))
Act(ai:&i, Fbn('DC'))
Act(aj:&i, Fbn('Comprobante'))
Act(ak:&i, Fbn('TipoMov'))
Acd(al:&i, Fbn('FechaIngreso'))
Acd(am:&i, Fbn('FechaAcreditacion'))
Message('Movimiento encontrado.')
break
endif
proximo

