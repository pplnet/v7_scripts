MostrarCuadroDeMensajes
CrearDialogo
   Fecha1: 'Fecha'          ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una fecha';NO;FSYS;
   Check2: 'Interfase'      ;;;;NO;NO;;;;1;
FinDialogo

if Not Ok
   Cancelar
endif

SQL.ADD("SELECT V.*, C.RazonSocial ")
SQL.ADD("  FROM "~DBO~".VOUCONSOLIDADOS V, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE V.Fecha="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   AND V.Estado='NOK' ")
SQL.ADD("   AND V.Cliente=C.Codigo ")
*SQL.ADD("   AND ((Round(MontoABloquear,0)<>Round(MontoBloqueado,0) AND Round(MontoABloquear,0)<>0) ")
*SQL.ADD("     OR (Round(MontoADebCred,0)<>Round(MontoDebCred,0)    AND Round(MontoADebCred,0)<>0)) ")
SQL.ADD(" ORDER BY V.Id ")
watch(SQL.BATCH())

Recorrer SQL

  SCN(z:1, 1)
  ACN(x:fac, 1)
  
  ACT(a:fac, fbn['Id'])
  ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
  ACT(c:fac, fbn['Cuenta'])
  ACT(d:fac, fbn['Accion'])
  ACT(e:fac, fbn['Estado'])
  ACD(f:fac, fbn['Fecha'])
  ACD(g:fac, fbn['FechaValor'])
  ACT(h:fac, fbn['Especie'])
  ACN(i:fac, fbn['MontoAbloquear'])
  ACN(j:fac, fbn['MontoADebCred'])
  ACT(k:fac, fbn['Referencia'])
  ACT(l:fac, fbn['RefCorte'])
  ACT(m:fac, fbn['RefAccion'])
  ACT(n:fac, fbn['RefCamest'])
  ACT(o:fac, TRIM(fbn['Referencia'])~TRIM(fbn['RefCorte'])~TRIM(fbn['RefAccion'])~TRIM(fbn['RefCamest']))

Proximo

If Val(z:1)=0
  Cancelar('No hay Voucheres para reenviar ')
Endif


CrearListBox ; 'Arial,8,';'Reenvio de Vouconsolidados '
   'Actualizar'    ; x:1..x:fac ;SI;SI;; 60;CHECK ;RGB(255,255,213);
   'Id'            ; a:1..a:fac ;NO;SI;; 80;STRING;;; 
   'Cliente'       ; b:1..b:fac ;NO;SI;;150;STRING;;; 
   'Cuenta'        ; c:1..c:fac ;NO;SI;; 90;STRING;;; 
   'Accion'        ; d:1..d:fac ;NO;SI;; 70;STRING;;; 
   'Estado'        ; e:1..e:fac ;NO;SI;; 70;STRING;;; 
   'Fecha'         ; f:1..f:fac ;NO;SI;; 80;FECHA;; 
   'FechaValor'    ; g:1..g:fac ;NO;SI;; 80;FECHA;; 
   'Moneda'        ; h:1..h:fac ;NO;SI;; 80;STRING;;; 
   'Desbloqueo'    ; i:1..i:fac ;NO;  ;;100 ;NUMERO;'##,###,###.##';;
   'Deb/Cred'      ; j:1..j:fac ;NO;  ;;100 ;NUMERO;'###.########';; 
   'Referencia'    ; o:1..o:fac ;NO;SI;;200;STRING;;; 
*   'Referencia 1'  ; k:1..k:fac ;NO;SI;;200;STRING;;; 
*   'Referencia 2'  ; l:1..l:fac ;NO;SI;;200;STRING;;; 
*   'Referencia 3'  ; m:1..m:fac ;NO;SI;;200;STRING;;;         
*   'Referencia 4'  ; n:1..n:fac ;NO;SI;;200;STRING;;;         
   
FinListBox

if not ok
    Cancelar('Evento Cancelado.')
Endif

Recorrer&i 1, val(z:1)
  If Val(x:&i)=1      
     Message('Enviando '~val(a:&i))
     SQL.ADD("SELECT * from "~DBO~".VOUCONSOLIDADOS WHERE Id='"~val(a:&i)~"'")
     Recorrer SQL
*        #ifdef BIND
          * Parámetros Salida
          * RR:1  'OK/NOK’  
          * RR:2  'Mensaje'  

          * Parámetros entrada
          * RR:10  'Referencia'  
          * RR:11  'Sucursal'  
          * RR:12  'Cuenta(1a7)'    
          * RR:13  'SubOperacion-Cuenta (9a10)'
          * RR:14  'Moneda'
          * RR:15  'Importe'
          * RR:16  'Observaciones'
          * RR:17  'Importe a Bloquear'
          * RR:18  'Importe a Debitar / Acreditar'
          * RR:19  'Cliente'
          * RR:20  'Cuenta'
          * RR:21  'Especie'
          * RR:22  'Importe Bloqueado'
          * RR:23  'Importe Debitado / Acreditado'
          * RR:24  'Tipo operacion'
          * RR:25  'Mercado'
          * RR:26  'Tipo Transferencia'
          * RR:27  'Capital'
          * RR:28  'Comisiones'
          * RR:29  'Derechos'
          * RR:30  'Iva'
          * RR:31  'Intereses'
          * RR:32  'Cod Evento (producto)'
          * RR:33  'Fecha Valor'
          * RR:34  'Referencia Corte'
          * RR:35  'Referencia Accion'
          * RR:36  'Transaccion'
          * RR:37  'Fecha Cont'
          * RR:38  'Modulo' 
          * RR:39  'Relacion'
          * RR:40  'Tipo: 1 Resta_Liquidacion/'
          * RR:41  'Referencia CAMEST'
          * RR:47  'Capital Accion'
          * RR:48  'Comisiones Accion'
          * RR:49  'Derechos Accion'
          * RR:50  'Iva Accion'
          * RR:51  'Intereses Accion'
          * RR:57  'Capital Cupon'
          * RR:58  'Comisiones Cupon'
          * RR:59  'Derechos Cupon'
          * RR:60  'Iva Cupon'
          * RR:61  'Intereses Cupon'
          * RR:67  'Capital Camest'
          * RR:68  'Comisiones Camest'
          * RR:69  'Derechos Camest'
          * RR:70  'Iva Camest'
          * RR:71  'Intereses Camest'
        
          * Cliente / Especie / Cuenta / 
          *  Interfase Bantotal
          BorrarCeldas(rr:1..rr:50)
          ACT(rr:1, 'NOK')
          ACT(rr:10, FBN['Referencia'])
          ACT(rr:12, Copy(FBN['Cuenta'],1,7))
          ACT(rr:13, Copy(FBN['Cuenta'],9,2))
          ACN(rr:17, FBN['MontoABloquear'])
          ACN(rr:18, FBN['MontoADebCred'])
          ACT(rr:19, FBN['Cliente'])
          ACT(rr:20, FBN['Cuenta'])
          ACT(rr:21, FBN['Especie'])
          ACT(rr:25, FBN['Mercado'])
          ACT(rr:26, FBN['Tipo'])
          ACT(rr:27, FBN['Capital'])
          ACT(rr:28, FBN['Comisiones'])
          ACT(rr:29, FBN['Derechos'])
          ACT(rr:30, FBN['Iva'])
          ACT(rr:31, FBN['Intereses'])
          ACT(rr:32, FBN['CodEvento'])
          ACT(rr:33, Dialogo.Fecha1)
          ACT(rr:34, fbn['RefCorte'])
          ACT(rr:35, fbn['RefAccion'])
          ACT(rr:41, fbn['RefCamest'])
          
          Message(FBN['Referencia']~FBN['RefCorte']~FBN['RefAccion']~fbn['RefCamest'])
          if FBN['MontoABloquear']>0
             * Desbloqueo de Saldo
             ACN(rr:15, ABS(FBN['MontoABloquear']))
             if Dialogo.Check2=1
                (.'DESBSALCTA'.)
                if Eqstr(Val(rr:1),'OK')
                   acn(rr:22, val(rr:17))
                endif
             else
                act(rr:1,'OK')
                acn(rr:22, val(rr:17))
                Messagebox('Bloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
             endif   
          else
             if FBN['MontoABloquear']<0
                * Desbloqueo de Saldo
                ACN(rr:15, ABS(FBN['MontoABloquear']))
                if Dialogo.Check2=1
                   (.'BLOQSALCTA'.)
                   if Eqstr(Val(rr:1),'OK')
                      acn(rr:22, val(rr:17))
                   endif
                else
                   act(rr:1,'OK')
                   acn(rr:22, val(rr:17))
                   Messagebox('Bloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                endif   
             else
                act(rr:1,'OK')
             endif   
          endif   
          If Eqstr(val(rr:1),'OK')
             if FBN['MontoADebCred']<0
                * Debito de Saldo
                ACN(rr:15, ABS(FBN['MontoADebCred']))
                ACT(rr:24, 'DB')
                ACT(rr:1, 'NOK')
*                ACT(rr:2, 'Sin comunicacion')
                if Dialogo.Check2=1
                   (.'DEBISALCTA'.)
                   if Eqstr(Val(rr:1),'OK')
                      acn(rr:23, val(rr:18))
                   endif
                else
                   act(rr:1,'OK')
                   acn(rr:23, val(rr:18))
                   Messagebox('Debito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                endif   
             else   
                if FBN['MontoADebCred']>0
                   * Credito de Saldo
                   ACN(rr:15, ABS(FBN['MontoADebCred']))
                   ACT(rr:24, 'CR')
                   ACT(rr:1, 'NOK')
                   ACT(rr:2, 'Sin comunicacion')
                   if Dialogo.Check2=1
                      (.'ACRESALCTA'.)
                      if Eqstr(Val(rr:1),'OK')
                         acn(rr:23, val(rr:18))
                      endif
                   else
                      act(rr:1,'OK')
                      acn(rr:23, val(rr:18))
                      Messagebox('Credito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                   endif   
                Endif                                   
             Endif
          Endif
          If Eqstr(val(rr:1),'OK')
             SQL.ADD("Select * FROM "~DBO~".TRANSACCIONES2 ")
             SQL.ADD("WHERE NrTrans in("~Pipe2Comillas(FBN['Referencia'])~") ")
             watch(SQL.BATCH())

             Recorrer SQL         
                Message('Confirmando '~FBN['NrTrans'])
                if Eqstr(val(rr:26),'LIQNET')
                   EjecutarEvento('ZCONFI', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha1, Cliente1='', Cuenta1='', Especie1='',Vehiculo1=VAR('VEHICULODE'),Mercado1=FBN['Mercado1'], NrTrans1=FBN['NrTrans'], Check1=1)
                else
                    if Eqstr(val(rr:26),'LIQEPA')
                       EjecutarEvento('03CONF', Radio1=2, Mercado1='', Especie1='', Vehiculo1=VAR('VEHICULODE'), Radio2=0, Fecha1=Dialogo.Fecha1, Cliente1='', NrTrans1=FBN['NrTrans'], Check1=1, Check2=0)
                    endif
                endif   
             Proximo  
             SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
             SQL.ADD(" NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
             SQL.ADD(" Bits, NrSaldo, Cuenta, NrMov,  ")
             SQL.ADD(" Book,    ")
             SQL.ADD(" FechaMov, Cantidad, Leyenda,         ")
             SQL.ADD(" NrGrupo, Concepto,         ")     
             SQL.ADD( " NrGrupo2, Nrinstan                        ")   
             SQL.ADD(" ) values  ( ")
             SQL.ADD(" '"~FSTR(FBN['ID'],1,0)~"', ")
             SQL.ADD(" '"~FBN['Especie']~"', ")
             SQL.ADD(" '"~FBN['Cliente']~"', ")
             SQL.ADD(" '"~FBN['Mercado']~"', ")
             SQL.ADD(" '"~VAR('VEHICULODE')~"', ")
             SQL.ADD(" 'MV', ")
             SQL.ADD(" 1, ")
             SQL.ADD(" '"~FBN['Cuenta']~"', ")
             SQL.ADD(" "~Fstr(5001)~", ")
             SQL.ADD(" '', ")
             SQL.ADD(" "~idxdate2(FBN['FechaValor'])~", ")
             SQL.ADD(" "~Fstr(-fbn['MontoADebCred'],0,2)~", ")
             If fbn['MontoADebCred']>0
                SQL.ADD(" 'Credito cuenta cliente', ")
             else
                SQL.ADD(" 'Debito cuenta cliente', ")
             endif
             SQL.ADD(" 0, ")
             SQL.ADD(" '', ")
             SQL.ADD(" "~Fstr(1)~" , ")
             SQL.ADD(" "~Fstr(0,0,0)~" ")
             SQL.ADD("         ) ")
             SQL.NEW
          Endif
          SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS ")
          SQL.ADD("  SET MontoBloqueado="~FSTR(Val(RR:22),0,2)~",  ")
          SQL.ADD("      MontoDebCred="~FSTR(Val(RR:23),0,2)~",    ")
          SQL.ADD("      Estado='"~Val(rr:1)~"',                   ")
          SQL.ADD("      DetalleError='"~Val(rr:2)~"',             ")
          SQL.ADD("      IdRespuesta='"~Val(rr:3)~"',              ")
          SQL.ADD("      Batch='SI'                                ")
          SQL.ADD("WHERE Id="~FSTR(FBN['ID'],1,0)                   )
          SQL.NEW
          SQL.EXEC
*        #endif
     Proximo   
  Endif 
Proximo