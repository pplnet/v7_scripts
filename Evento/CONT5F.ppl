MostrarCuadroDeMensajes
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:   'Fecha'    ; 1; ;;;;;;;fsys
  Especie1: 'Especie'  ; 1;2;
  Lista1:   'Vehiculos'; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Resultados por Tenencia Fondos ---')

ACN(x:1, SQL(" Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
ACN(x:3, Val(X:1))

IF Val(X:1) = 1
  ACN(x:1, Trunc(Var('DIASCONT'),0))
ENDIF
IF Val(X:1) < 1
  ACN(X:1, 1)
ENDIF
ACD(x:2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x:1),'ARG'))
IF Dialogo.Fecha1<>Val(x:2)
  Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
ENDIF

ACD(v:1, Dialogo.Fecha1)
ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:3, Habiles(PriDeMes(Val(v:2)),-1,'ARG'))

***---V:1 = 07/08/08 ******* fECHA DE pROCESO (QUINTO DIA HABIL DEL MES)
***---V:2 = 31/07/08 ******* fIN DE ULTIMO MES (DONDE SE TOMAN LAS OPERACIONES)  
***---V:3 = 30/06/08 ******* FIN DE MES ANTERIOR (BASE DE POSICION PARA EMPEZAR EL CALCULO)

ACT(y:1, Dialogo.Lista1)
ACT(y:2, '101')

SetFilaActual(1)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Cupon')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'TipoNegocio')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'CantidadFin')
ACT(j:FAC, 'PrecioFin')
ACT(k:FAC, 'Cotiza')
ACT(l:FAC, 'Cot.Mes Ant')
ACT(m:FAC, 'Cot.Actual')
ACT(n:FAC, 'Dif.Cotiz.')
ACT(o:FAC, 'Res.Saldo Ant.')
ACT(p:FAC, 'Res.Operac.')
ACT(q:FAC, 'Res.TOTAL')
ACT(r:FAC, 'Tipos Asi')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Nombre')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'NrSaldo')
ACT(ae:FAC, 'TipoNegocio')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'FechaMov')
ACT(ai:FAC, 'Cantidad')
ACT(aj:FAC, 'Precio')
ACT(ak:FAC, 'Cotiza')
ACT(al:FAC, 'Cotizacion')
ACT(am:FAC, 'Dif.Cotiz.')
ACT(an:FAC, 'Resultado')
ACT(ao:FAC, 'Linea')
ACT(ap:FAC, 'NrOperacion')
ACT(aq:FAC, 'TipoOp')
ACT(ar:FAC, 'FechaOp')


********************************
**********   FONDOS   **********
********************************
SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       Sum(P.CantidadFin) as Cantidad, P.Vehiculo Vehiculo1, ")
SQL.ADD("       Sum(P.CantidadFin*P.PrecioFin) as Monto, V.Valor1, V.Valor2, E.Cotiza Moneda, P.Cliente, '' Observaciones, E.Alias8 ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD(" AND P.Vehiculo = V.Codigo ")
SQL.ADD("   and P.NrSaldo     in ("~Val(y:2)~") ")
SQL.ADD("   and P.TipoNegocio = 'FC' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie     = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
SQL.ADD("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(v:2))~" ) ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND P.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, V.Valor1, V.Valor2, P.Cliente, E.Alias8 ")
Recorrer SQL
  ACT(a:FAC, FBN('Especie'))
  ACT(b:FAC, FBN('Nombre'))
  ACN(d:FAC, FBN('NrSaldo'))
  ACT(e:FAC, FBN('TipoNegocio'))
  ACT(f:FAC, FBN('Vehiculo'))
  ACN(i:FAC, FBN('Cantidad'))
  ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
  ACT(k:FAC, FBN('Cotiza'))
  ACN(l:FAC, CotizacionC(FBN('Especie'),,,,Val(v:3),1,SI,FBN('Cotiza')))
  ACN(m:FAC, CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(n:FAC, Val(m:FAC)-Val(l:FAC))
  ACN(o:FAC, Val(i:FAC)*Val(n:FAC))           ************ RESULTADO MES ANTERIOR O:fAC
  * messagebox('Cotiz Posicion'~ Val(n:FAC) ~'Cantidad Posicion '~ Val(i:FAC)~'Especie '~ Val(a:FAC)~'Resultado O:Fac '~ Val(o:FAC))
  ACT(S:fac, fbn('Cliente'))
proximo

***** ACA SE INSERTA El resultado Operativo (del mes en curso)         ******************
ACN(w:1, 1)
SQL.ADD("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
SQL.ADD("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8, O.Precio1 ")
SQL.ADD("  from "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
SQL.ADD(" where M.NrSaldo     in ("~Val(y:2)~") ")
SQL.ADD(" AND V.Codigo = M.Vehiculo ")
SQL.ADD("   and M.TipoNegocio = 'FC' ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("  and M.Especie    = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" order by M.Especie, M.Vehiculo ")
Recorrer SQL
  DFA
  SCN(w:1,1)
  ACN(w:2,0)
  if FAC>1
    recorrer&i 2,FAC
       if EqStr(FBN('Especie'),Val(a:&i)) y EqStr(FBN('Vehiculo'),Val(f:&i))
         ACN(w:2, &i)
         * messagebox('ESPECIE '~ Val(a:&i) ~'VEHICULO '~ Val(f:&i) )
         Break
       endif
    proximo
  endif
  if Val(w:2)=0
    IFA
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
    ACN(d:FAC, FBN('NrSaldo'))
    ACT(e:FAC, FBN('TipoNegocio'))
    ACT(f:FAC, FBN('Vehiculo'))
    ACT(g:FAC, FBN('Book'))
    ACN(w:2, FAC)
  endif

  ACT(aa:Val(w:1), FBN('Especie'))
  ACT(ab:Val(w:1), FBN('Nombre'))
  ACT(ac:Val(w:1), FBN('Cupon'))
  ACN(ad:Val(w:1), FBN('NrSaldo'))
  ACT(ae:Val(w:1), FBN('TipoNegocio'))
  ACT(af:Val(w:1), FBN('Vehiculo'))
  ACT(ag:Val(w:1), FBN('Book'))
  ACD(ah:Val(w:1), FBN('FechaMov'))
  ACN(ai:Val(w:1), FBN('Cantidad'))
  ACN(aj:Val(w:1), FBN('Precio1'))
  
  ACT(ak:Val(w:1), FBN('Cotiza'))
  ACN(al:Val(w:1), CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(am:Val(w:1), Val(al:Val(w:1))-Val(aj:Val(w:1)))
  ACN(an:Val(w:1), Val(ai:Val(w:1))*Val(am:Val(w:1)))
  ACN(ao:Val(w:1), Val(w:2))
  ACT(ap:Val(w:1), FBN('NrOperacion'))
  ACT(aq:Val(w:1), FBN('TipoOp'))
  ACD(ar:Val(w:1), FBN('FechaOp'))
  ACT(AS:Val(w:1), fbn('ContraEspecie'))
  ACN(AT:Val(w:1), fbn('CotOp'))
  SCN(p:Val(w:2), Val(an:Val(w:1)))                  *********** RESULTADO MES en curso P:fAC 
  * messagebox('RESULTADO OPERATIVO P:FAC ... '~ Val(p:Val(w:2))~ 'Dif Precio '~ Val(am:Val(w:1)) ~ 'Cantidad '~ Val(ai:Val(w:1)) ~ 'Especie '~ Val(aa:Val(w:1)))
proximo

***** ACA SE completo la insercion de LA POSICION OPERATIVA          -------------------*******************
    
if FAC>0
  recorrer&i 2,FAC
    ACN(q:&i, Val(o:&i)+Val(p:&i))
    * messagebox('MES ACUMULADO O:FAC '~ Val(o:&i) ~'MES OPERATIVO P:Fac '~ Val(P:&i)~'Especie '~ Val(a:&i) )
    ACT(r:&i, Var('TIPASITEFC'))
    ACN(CT:1, Val(I:&i))
    ACD(FV:1, Val(V:2))
    SQL.ADD("select MA.Codigo ")
    SQL.ADD("  from "~DBO~".MODELOSASIENTO MA ")
    SQL.ADD(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
    Recorrer SQL    
      DFA
      * Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
      ACT(MD:1, fbn('Codigo'))
      ACN(RS:1, Val(Q:&i))
      SQL.ADD(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, V.Valor1, V.Valor2, E.Cotiza Moneda, ")
      SQL.ADD(" C.Codigo Cliente1, '' Observaciones, V.Codigo Vehiculo1, "~Fstr(Val(CT:1), 0, 0)~" Cantidad, E.Alias8 ")
      SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C ")
      SQL.ADD(" Where E.Codigo = '"~Val(A:&i)~"' ")
      SQL.ADD(" AND V.Codigo = '"~Val(F:&i)~"' ")
      SQL.ADD(" AND C.Codigo = '"~Val(S:&i)~"' ")
      Recorrer SQL
          DFA
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~Val(MD:1)~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~Val(F:&i)~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              SQL.GenerarAsientoOp(Val(MD:1), '','','',810,Val(v:2),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
          ENDIF
          SQL.EXEC
      Proximo
    proximo
  proximo
endif
