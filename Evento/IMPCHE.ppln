Sqladd("   '"~Var('BOOKDD')~"',    '"~FStr(Val(bk:&i), 0, 0)~"',  "~FStr(&mb2, 0, 0)~", "~FStr(&cb2, 0, 0)~", '"~Val(cn:&i)~"', '"~Val(bt:&i)~"',")
