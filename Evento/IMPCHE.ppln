Sqladd("   '"~IdxDate(Val(bn:&i))~"', "~FStr(Val(bo:&i), 0, 2)~", "~FStr(Val(bp:&i), 0, 2)~", "~FStr(Val(bq:&i), 0, 2)~", "~FStr(Val(br:&i), 0, 2)~", "~FStr(Val(cm:&i), 0, 2)~", '"~&vehiculo~"', ")
Sqladd("   '"~Val(bx:&i)~"',          '"~Var('MONELOCA')~"',    "~FStr(Val(bz:&i), 0, 2)~", "~FStr(&cb3, 0, 0)~",   '"~IdxDate(Val(bi:&i))~"', ")
Sqladd("   "~FStr(&plazo, 0, 0)~",   '"~FStr(Val(ce:&i), 0, 0)~"', "~FStr(&cb4, 0, 0)~",  "~FStr(&cb5, 0, 0)~",   '"~UsuarioActivo()~"', ")
Sqladd("   "~IdxDate2(SQLAhora())~",  "~IdxDate2(FSys())~",       "~FStr(32, 0, 0)~",  "~FStr(&cantidad, 0, 2)~",   '"~UsuarioActivo()~"', "~FStr(&cb8, 1, 0)~", ")
