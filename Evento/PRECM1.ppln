creardialogo
nroperacion1: 'Op Origen';
nroperacion2: 'Op Destino';
findialogo
if (not ok)
Cancelar()
endif

Acn(a:1, BuscarCampo('OPERACIONES', 'Cuotas1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("   Set Cuotas1     = "~FStr(Val(a:1), 1, 0)~" ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion2~"' ")
Sqlnew()
Sqlexec()

Sqladd("Delete "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion2~"' ")
Sqlnew()
Sqlexec()

Sqladd("INSERT INTO "~Dbo()~".CUOTAS ( ")
Sqladd("  NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
Sqladd("  Vehiculo2,   Especie1,     Especie2,     Especie3,     Especie4, ")
Sqladd("  Check1,      Check2,       Check3,       Check4,       Check5, ")
Sqladd("  Check6,      Check7,       Check8,       Check9,       Check10, ")
Sqladd("  Radio1,      Radio2,       Radio3,       Radio4,       Radio5, ")
Sqladd("  Radio6,      Radio7,       Radio8,       Radio9,       Radio10, ")
Sqladd("  Fecha1,      Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
Sqladd("  Fecha6,      Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
Sqladd("  Mercado1,    Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
Sqladd("  Plazo4,      Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
Sqladd("  Precio1,     Precio2,      Precio3,      Precio4,      Total1, ")
Sqladd("  Total2,      Total3,       Total4,       Total5,       Total6, ")
Sqladd("  Total7,      Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
Sqladd("  PrecioRef2,  Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
Sqladd("  Precio7,     Precio8,      Tasa3,        Total9,       Cotizacion1, ")
Sqladd("  Cotizacion2, Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
Sqladd("  Coeficiente, Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
Sqladd("  Cantidad9,   Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
Sqladd("  Total11,     Total12 ")
Sqladd(" )")

Sqladd("SELECT '"~dialogo.nroperacion2~"' As NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
Sqladd("       Vehiculo2,                                 Especie1,     Especie2,     Especie3,     Especie4, ")
Sqladd("       Check1,                                    Check2,       Check3,       Check4,       Check5, ")
Sqladd("       Check6,                                    Check7,       Check8,       Check9,       Check10, ")
Sqladd("       Radio1,                                    Radio2,       Radio3,       Radio4,       Radio5, ")
Sqladd("       Radio6,                                    Radio7,       Radio8,       Radio9,       Radio10, ")
Sqladd("       Fecha1,                                    Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
Sqladd("       Fecha6,                                    Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
Sqladd("       Mercado1,                                  Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
Sqladd("       Plazo4,                                    Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
Sqladd("       Precio1,                                   Precio2,      Precio3,      Precio4,      Total1, ")
Sqladd("       Total2,                                    Total3,       Total4,       Total5,       Total6, ")
Sqladd("       Total7,                                    Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
Sqladd("       PrecioRef2,                                Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
Sqladd("       Precio7,                                   Precio8,      Tasa3,        Total9,       Cotizacion1, ")
Sqladd("       Cotizacion2,                               Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
Sqladd("       Coeficiente,                               Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
Sqladd("       Cantidad9,                                 Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
Sqladd("       Total11,                                   Total12 ")
Sqladd("  FROM "~Dbo()~".CUOTAS ")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
Sqlexec()

