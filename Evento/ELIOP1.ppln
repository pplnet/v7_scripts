creardialogo
nroperacion1:'Nro. Operacion';;;;;;NoVacio(dialogo.nroperacion1);'Debe ingresar un numero de Op.';NO
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


Acn(z1, Query("Select count(*) from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
Act(z6, Query("Select Vehiculo1 from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
if (Val(z1) = 0)
Cancelar('La Operacion no existe')
else
if (Incluido(Val(z6), Var('VLIQUIDA')~Var('VLIQUIDA2')))
Cancelar('La operacion es de un Vehiculo que liquida')
else
Acn(z3, Query("Select count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and NrBit in (20,50) and Valor = '1'"))
if (Val(z3) = 0)
Cancelar('La operacion no esta en BackOffice ni en Terminal')
else
Acn(z4, Query("Select RB3 from "~Dbo()~".OPERACIONES where NrOperacion = '"~dialogo.nroperacion1~"'"))
Sqladd("Update "~Dbo()~".OPERACIONES set Impresa='1', Direccion=1 where NrOperacion='"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()
Sqladd(" Select NrBit from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nroperacion1~"' and Valor = '1' ")
recorrer sql
Dfa()
if (Fbn('NrBit') = 50)
if (Query(" Select Count(*) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~dialogo.nroperacion1~"' ") = 1)
Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 50, 'nroperacion1', dialogo.nroperacion1)
endif
endif
proximo
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=20")
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=50")
Sqlnew()
if (Val(z4) > 0)
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=10")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~dialogo.nroperacion1~"' and NrBit=12")
endif
Sqlnew()
Sqlexec()
Act(z5, Query("Select Alias4 from "~Dbo()~".VEHICULOS where Codigo = '"~Val(z6)~"'"))
Sendmail(Val(z5), 'Eliminacion de Operaciones', 'Se elimino la operacion : '~dialogo.nroperacion1)
endif
endif
