MostrarCuadroDeMensajes
*DialogoVisible(SI)
CrearDialogo
  Fecha1 :"Fecha: " ;1;1;;NO;;;;;;FSYS
  String :'Path:  ' ;2;1;;;;NOVACIO(Dialogo.String);'Path Invalido';NO;VAR('DIRDNCTA');
  Radio1:  '|W98|NT';;;;;;;;;0
  Entero1: 'Registros' ;;;;;;;;;VAR('DNREGISTRO')
FinDialogo

If Not Ok
  Cancelar
Endif


* --------------------- Primero divide los archivos que son de S y M ---------------- *

*message(' Ejecutando divisor de archivos de saldos y movimientos ...')
*EjecutarEvento('SIA005',Fecha1=Dialogo.Fecha1,String=Dialogo.String,String2=VAR('DNPROCES'),Radio1=Dialogo.Radio1,Entero1=Dialogo.Entero1)

* ----------------------------------------------------------------------------------- *


* ------------ Ahora recorre los archivos del directorio para procesar -------------- *

ACT(ww:1, PrimerArchivo(MIRT(TRIM(Dialogo.String))~'\*.dat') )

If NOT Vacio(VAL(ww:1))
  * --- Abre el primer archivo que encuentra
  AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(ww:1),0)
  ACN(nn:2, 0)
  Recorrer&i 1,2

    ACT(x:1,LEERASCII)
    If &i=2
      If Incluido(Copy(Val(x:1),1,1),'H|M')
        Message('Saldos y Movimientos '~Val(ww:1))
        CerrarAscii
        ACN(nn:2, 1)
        EjecutarEvento('APBD3B',Fecha1=Dialogo.Fecha1,Fecha2=HABILES(Dialogo.Fecha1,-62,'ARG'),String=MIRT(TRIM(Dialogo.String))~Val(ww:1),String2=VAR('DNPROCES'),Radio1=Dialogo.Radio1,Check10=0)
      Endif
    Endif
  Proximo
EndIf

If Val(nn:2)=0
  CerrarAscii
  ACN(nn:2, 1)
Endif

Recorrer&j 2,1000000
  ACT(ww:&j, ProximoArchivo)

  If Not OK
     Break
  EndIf

  * --- Abre el proximo archivo que encuentra
  AbrirAscii(MIRT(TRIM(Dialogo.String))~Val(ww:&j),0)
  ACN(nn:2, 0)

  Recorrer&i 1,2
    ACT(x:1,LEERASCII)
    If &i=2
      If Incluido(Copy(Val(x:1),1,1),'H|M')
        ** Llamar al divisor y pasarle el nombre del archivo
        CerrarAscii
        ACN(nn:2, 1)
        Message('Saldos y Movimientos '~Val(ww:&j))
        EjecutarEvento('APBD3B',Fecha1=Dialogo.Fecha1,Fecha2=HABILES(Dialogo.Fecha1,-62,'ARG'),String=MIRT(TRIM(Dialogo.String))~Val(ww:&j),String2=VAR('DNPROCES'),Radio1=Dialogo.Radio1,Check10=0)
      Endif
    Endif
  Proximo
  If Val(nn:2)=0
    CerrarAscii
    ACN(nn:2, 1)
  Endif
Proximo

If Val(nn:2)=0
  CerrarAscii
  ACN(nn:2, 1)
Endif
