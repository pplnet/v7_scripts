CrearDialogo 
  Fecha1    :   'Fecha'             ;1;;;;;EsHabil(Dialogo.Fecha1,'ARG') y NoVacio(Dialogo.Fecha1);'La fecha debe ser un dia habil';NO;FSYS;
  Lista1    :    'Vehiculos'        ;3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'")) 
  Check1    :    'Contab.Procesada' ;;;;NO;NO;
FinDialogo

IF Not OK
  Cancelar
ENDIF

let &monedaLocal Var('MONELOCA')

*************************************************SQL****************************************************
SQL.ADD("Select S.Fecha,S.Saldo,S.EnteCustodia as 'Vehiculo', S.Especie as 'Moneda' ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S ")
SQL.ADD(" WHERE   S.Fecha IN (SELECT MAX(SD.Fecha) FROM "~DBO~".SALDOSDIA SD") 
SQL.ADD("                   WHERE SD.NrSaldo = S.NrSaldo  ")
SQL.ADD("                   AND SD.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   AND SD.Especie = S.Especie ")
SQL.ADD("                   AND SD.Fecha  <= '"~IdxDate(Dialogo.Fecha1)~"') ")
If NoVAcio(Dialogo.Lista1)
     SQL.ADD(" and S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
ENDIF  
SQL.ADD("and NrSaldo = '50'")
SQL.ADD("and S.Especie <> '"~&monedalocal~"'")
SQL.ADD("Order By Vehiculo,Fecha")   

Recorrer SQL
    let &monto fbn('Saldo')
    let &fechaDC fbn('Fecha')
    let &fechaDesde &fechaDC-1
    let &moneda fbn('Moneda')
    ***---tipoCotizacion BNA
    let &tipoCotizacion 0
    ***---Tipo de Cambio Vendedor
    let &tipoCambio 2 
    (.'DIFCAM'.)
Proximo