creardialogo
fecha1: 'Fecha';1;;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Transacciones';1;2;;;;;;;;;;;;;'NrTrans';'NrTrans;Cliente1;Fecha1;Fecha2;Especie;Cantidad1;Cuenta2';'TRANSACCIONES2'
check1: 'Contab.Procesada';;;;NO;NO;

findialogo

if (not ok)
raise('Evento Cancelado')
endif

Message('--- Asientos de Cobro de Dividendos en Efectivo ---')

Act(me:1, Var('MONEEXTR'))
Act(ml:1, Var('MONELOCA'))
Acn(na:1, Var('ASINUM'))
Acd(fe:1, Habiles(FSys(), -Var('FVALORCONT'), 'ARG'))
Act(vc:1, dialogo.vehiculo1)

sql.add(" SELECT T.Especie2 ContraEspecie, T.Especie, T.Fecha2 FechaOp, T.Cliente1 Cliente1, T.Vehiculo1, T.Especie2 MonedaLiq,")
sql.add(" MA.Codigo CodAsi, E.Cotiza, E.MonedaEmision, T.TipoTr2, E.Indexado, E.Jerarquia, T.Book1, T.Fecha2, T.RB10, ")
sql.add(" T.NrTrans, Case When T.RB10=0 Then T.Cantidad9 Else T.Cantidad2 End Cantidad, T.Cantidad3, E.EntidadEmisora, T.Cliente1 Cliente, E.Issuer, E.Alias1 as EspBanTotal, E.Tipo TipoEspecie, ")
sql.add(" T.Especie2 Moneda, CASE WHEN T.RB10=0 THEN T.Cuenta2 ELSE T.Cuenta1 END Cuenta2, 'TIC' as TipoOp, ")
sql.add(" '' as CuentaCustodia, '' as Concepto, T.Mercado1, T.Cantidad14,T.Cantidad15 ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ESPECIES E ")
sql.add(" Where T.TipoTr2 = MA.TipoTr2 ")
sql.add(" AND T.Especie = E.Codigo ")
sql.add(" AND T.TipoTr2 IN ('PDIVID') ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASIDIVI'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND T.Fecha3 = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' ")
if (NoVacio(dialogo.listatabla1))
sql.add(" AND T.NrTrans IN ("~pipe2comillas(dialogo.listatabla1)~") ")
endif

sql.add(" ORDER BY T.NrTrans ")
Watch(sql.batch)
recorrer sql
let(&comi3eros, Fbn('Cantidad14'))
let(&ivacomi3eros, Fbn('Cantidad15'))
Acd(fv:1, Fbn('Fecha2'))
Act(vh:1, Fbn('Vehiculo1'))
Acd(fo:1, Fbn('FechaOp'))
Act(bk:1, Fbn('Book1'))
Act(em:1, Fbn('MonedaEmision'))
Act(ix:1, Fbn('Indexado'))
let(&merctapte, BuscarCampo('CUENTAS', 'Mercado', 'Codigo', Fbn('Cuenta2')))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(sql(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where NrTrans2 = '"~Fbn('NrTrans')~"' AND Modelo = '"~Fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~Fbn('Vehiculo1')~"' ")))
Acn(ck:1, 0)
endif
endif
let(&codasi, Fbn('CodAsi'))
if (Val(ck:1) = 0)
Message(Fbn('NrTrans')~' - Modelo: '~Fbn('CodAsi'))
sql.generarasientoop(&codasi, '', '', '', Val(na:1), Val(fv:1), Fbn('Vehiculo1'), null, null, null, null, null, Fbn('TipoTr2'), null, Fbn('NrTrans'), null, null, null, null, FSys(), dialogo.fecha1)
sql.exec
endif
proximo
