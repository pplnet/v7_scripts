MostrarCuadroDeMensajes
(.'DNLISTA'.)
ACT(ll:1, Val(l:1)~'DNCCDI|DNAGDI|DNCDDI|DNADDI|')
ACT(l:1, '')

CrearDialogo
  Radio1:    'FechaBajada|Seleccionar|Todas' ;1;1;;;;;;;1
  Fecha1:    ' '             ;1;2;;Dialogo.Radio1=0;Dialogo.Radio1=0;;;;;FSYS
  Vehiculo1: 'Vehiculo'      ;2;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Radio2:    'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;3;1;;;;;;;4
  Check1:    'Incluye Pagadoras';4;1;;;;;;;1
  Label1:    ''            ; 5;1;;;;;;;'__________________________________________________________________________________________'
  Lista1:    'Bancos'      ; 6;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista2:    'Cuentas'     ; 0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~")"~IIF(Dialogo.Check1=0," AND (Pagadora <>'SI' OR Pagadora IS NULL)"));
*  Lista3:    'Archivo'     ;  ;1;;;;;;;;;VAR('DNAPROB')
  Lista3:    'Archivo'     ;  ;1;;;;;;;;;VAL(ll:1)
  Lista4:    'NrDatanet'   ;-5;2;;;;;;;;;SQLSet(" SELECT Distinct D.NrDatanet FROM "~DBO~".DATANET D, "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C WHERE D.NrDatanet = M.NrDatanet AND C.Numero=M.Cuenta AND D.EstadoAprobacion = 'P' AND M.Vehiculo = '"~Dialogo.Vehiculo1~"' AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~")"~IIF(Dialogo.Check1=0," AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL)"))
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ ")
SQL.ADD(" DISTINCT D.NrDatanet, D.FechaBajada, D.Archivo, M.Banco, M.Cuenta, C.Codigo, ")
SQL.ADD(" C.Comitente, D.Usuario ")
SQL.ADD(" FROM "~DBO~".DATANET D, "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C ")
SQL.ADD(" WHERE D.NrDatanet = M.NrDatanet ")
SQL.ADD(" AND C.Numero      = M.Cuenta    ")
If Dialogo.Radio1=0
   SQL.ADD(" AND D.FechaBajada    = "~IdxDate2(Dialogo.Fecha1)~" ")
Endif
SQL.ADD(" AND (D.EstadoAprobacion = 'P' OR D.EstadoAprobacion IS NULL) ")
SQL.ADD(" AND M.Vehiculo         = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Endif
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND D.Archivo IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If Dialogo.Radio2=1
   SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
   SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
   SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
   SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
SQL.ADD(" ORDER By D.NrDatanet ")

ACN(z:1,0)

Recorrer SQL
  ACN(z:1,1)
  ACN(a:fac, 1)
  ACT(b:fac, fbn('NrDatanet'))
  ACD(c:fac, fbn('FechaBajada'))
  ACT(e:fac, fbn('Archivo'))
  ACT(f:fac, fbn('Banco'))
  ACT(g:fac, fbn('Comitente'))
  ACT(h:fac, fbn('Cuenta'))
  ACT(i:fac, fbn('Codigo'))
  ACT(j:fac, fbn('Usuario'))
Proximo

If Val(z:1)=0
  Cancelar('No se encontaron extractos pendientes.')
Endif

CrearListBox; 'Arial,8,'
  'OK'            ;a:1..a:FAC;SI;;;30;CHECK;RGB(232,255,215);
  'Extracto'      ;b:1..b:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'Fecha Bajada'  ;c:1..c:FAC;NO;;;80;FECHA;RGB(232,232,232);
  'Archivo'       ;e:1..e:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'Banco'         ;f:1..f:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'CodigoFPA'     ;g:1..g:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'Cuenta'        ;h:1..h:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'CodigoFPA'     ;i:1..i:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'Usuario'       ;j:1..j:FAC;NO;;;80;STRING;;RGB(232,232,232);
FinListBox

If Not Ok
   Cancelar
Endif

Recorrer&i 1,fac
  If Val(a:&i)=1
    message('Recuperando datos del Extracto ... ')
    SQL.ADD(" SELECT /*+ RULE */ M.*, E.Codigo MonedaFPA, C.Codigo CuentaFPA, B.Codigo BancoFPA ")
    SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E ")
    SQL.ADD(" WHERE  M.Moneda   = E.Alias3 ")  
    SQL.ADD(" AND    M.Cuenta   = C.Numero ")  
* 05/07/2004   SQL.ADD(" AND    M.Banco    = B.Alias2 ")  
    SQL.ADD(" AND    (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
    SQL.ADD(" AND    M.NrDatanet = '"~Val(b:&i)~"' ")
    SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet ")
    ACN(z:2,0)
    ACN(fi:1,fac+1)
    Recorrer SQL
      ACN(z:2,1)
      ACT(aa:fac, fbn('Vehiculo'))
      ACT(ab:fac, fbn('Banco'))
      ACT(ac:fac, fbn('Sucursal'))
      ACT(ad:fac, fbn('Cuenta'))
      ACT(ae:fac, fbn('Moneda'))
      ACN(af:fac, fbn('Importe'))
      If Eqstr(fbn('DC'), 'D')
         ACN(ag:fac, 0)
      Else
         ACN(ag:fac, 1)
      Endif
      ACD(ah:fac, fbn('FechaIngreso'))
      ACD(ai:fac, fbn('FechaAcreditacion'))
      ACT(aj:fac, fbn('TipoMov'))
      ACT(ak:fac, fbn('Comprobante'))
      If Eqstr(fbn('EstadoConciliacion'),'P')
         ACN(al:fac, 0)
      Endif
      If Eqstr(fbn('EstadoConciliacion'),'OK')
         ACN(al:fac, 1)
      Endif
      If Eqstr(fbn('EstadoConciliacion'),'FC')
         ACN(al:fac, 2)
      Endif
      ACN(ba:fac, fbn('Importe2'))
      If Eqstr(fbn('DC2'), 'D')
         ACN(bb:fac, 0)
      Else
         ACN(bb:fac, 1)
      Endif
      ACN(bc:fac, fbn('Importe3'))
      If Eqstr(fbn('DC3'), 'D')
         ACN(bd:fac, 0)
      Else
         ACN(bd:fac, 1)
      Endif
      ACN(be:fac, fbn('Importe4'))
      ACN(bf:fac, fbn('Importe5'))
      ACN(bg:fac, fbn('Importe6'))
      ACN(bh:fac, fbn('Importe7'))
      ACN(bi:fac, fbn('Importe8'))
      ACN(bj:fac, fbn('Importe9'))
      ACN(bk:fac, fbn('Importe10'))
      ACN(bl:fac, fbn('Importe11'))
      ACN(bm:fac, fbn('Importe12'))
      ACN(am:fac, 0)
      ACN(an:fac, 0)
      ACT(ao:fac, fbn('NrDatanet'))
      ACN(ap:fac, fbn('NrMovDatanet'))
      ACT(aq:fac, fbn('BancoFPA'))
    Proximo

    If Val(z:1)=0
       MessageBox('No se encontraron movimientos para el extracto '~fbn('NrDatanet')~'.')
    Endif

    CrearListBox; 'Arial,8,'
     'NrDatanet'     ;ao:Val(fi:1)..ao:fac;NO;;;70;STRING;;RGB(232,232,232);
     'NrMov'         ;ap:Val(fi:1)..ap:fac;NO;;;80;NUMERO;'###,###,###';RGB(232,232,232);
     'Vehiculo'      ;aa:Val(fi:1)..aa:fac;NO;;;70;STRING;;RGB(232,232,232);
     'BancoDatanet'  ;ab:Val(fi:1)..ab:fac;NO;;;70;STRING;;RGB(232,232,232);
     'BancoFPA'      ;aq:Val(fi:1)..aq:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Suc'           ;ac:Val(fi:1)..ac:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Cuenta'        ;ad:Val(fi:1)..ad:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Moneda'        ;ae:Val(fi:1)..ae:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Cantidad'      ;af:Val(fi:1)..af:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Deb/Cre'       ;ag:Val(fi:1)..ag:fac;NO;;;40;COMBO;'D|C'    ;RGB(232,232,232)
     'Cantidad'      ;ba:Val(fi:1)..ba:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Deb/Cre'       ;bb:Val(fi:1)..bb:fac;NO;;;40;COMBO;'D|C'   ;RGB(232,232,232)
     'Cantidad'      ;bc:Val(fi:1)..bc:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Deb/Cre'       ;bd:Val(fi:1)..bd:fac;NO;;;40;COMBO;'D|C'   ;RGB(232,232,232)
     'Cantidad'      ;be:Val(fi:1)..be:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bf:Val(fi:1)..bf:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bg:Val(fi:1)..bg:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bh:Val(fi:1)..bh:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bi:Val(fi:1)..bi:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bj:Val(fi:1)..bj:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bk:Val(fi:1)..bk:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bl:Val(fi:1)..bl:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'Cantidad'      ;bm:Val(fi:1)..bm:fac;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
     'F.Ingreso'     ;ah:Val(fi:1)..ah:fac;NO;;;80;FECHA;RGB(232,232,232);
     'F.Acredit'     ;ai:Val(fi:1)..ai:fac;NO;;;80;FECHA;RGB(232,232,232);
     'TipoMov'       ;aj:Val(fi:1)..aj:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Comprobante'   ;ak:Val(fi:1)..ak:fac;NO;;;70;STRING;;RGB(232,232,232);
     'Estado'        ;al:Val(fi:1)..al:fac;NO;;;40;COMBO;'P|OK|FC'    ;RGB(232,232,232)
    FinListBox

    If Ok           
       SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".DATANET SET EstadoAprobacion='OK', Supervisor= '"~USUARIOACTIVO~"', FechaAprobacion="~IdxDate2(FSYS)~" WHERE NrDatanet = '"~Val(b:&i)~"' ")
*      SQL.ADD(" UPDATE "~DBO~".DATANET SET EstadoAprobacion='OK' WHERE NrDatanet = '"~Val(b:&i)~"' ")
       SQL.NEW
       SQL.EXEC
       Message('Extracto '~Val(b:&i)~' aprobado por '~USUARIOACTIVO~'.' )
    Endif
  Endif
Proximo