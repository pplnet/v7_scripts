sql.add("SELECT ORD.NrOrden ")
sql.add("  FROM "~Dbo()~".ORDENES ORD ")
sql.add(" WHERE ORD.FechaOrden="~IdxDate2(dialogo.fecha1))
sql.add("   AND ORD.CantidadTotalOrden>Cantidad1 ")
sql.add("   AND ORD.TipoOrden in ('OTIC','OTIV') ")

if (NoVacio(dialogo.mercado1))
sql.add("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif

if (dialogo.radio1 = 0)
sql.add("AND ORD.Lotes=0 ")
else
sql.add("AND ORD.Lotes<>0 ")
endif

recorrer sql
sql.add("UPDATE "~Dbo()~".ORDENES ")
sql.add("   SET Cantidad5=CantidadTotalOrden-Cantidad1 ")
sql.add(" WHERE NrOrden='"~Fbn()['NrOrden']~"' ")
sql.new
sql.exec

