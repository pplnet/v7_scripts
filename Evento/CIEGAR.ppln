creardialogo
fecha1:'Fecha';;;;NO;;dialogo.fecha1 > 0;'Fecha Inválida';NO;FSys();
mercado1: 'Mercado';;;;;NO;;;;;;
radio1:'Plazo|Contado|Otros';;;;;;dialogo.radio1 >= 0;'Debe elegir una Opcion';NO;-1;
findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,14,B")
CrearFont(2, "Arial,10,B")
CrearFont(3, "Arial,8,B")
CrearFont(4, "Arial,8,")
agregarbmp(c1, exe('LOGO'), 90)

if (sql("Select 1 From "~Dbo()~".FLAGSMERCADO Where Fecha = "~IdxDate2(dialogo.fecha1)~" and Paso = "~FStr(dialogo.radio1, 1, 0)~" and Registro = 'CGAR' and Estado='PRO' ") = 1)
Cancelar()('El cierre de la Rueda Garantizada para el Plazo '~iif (dialogo.radio1 = 0, '-Contado-', '-Otros-')~' ya fue realizado. Debe ser anulado para volver a ejecutarlo')
endif

if (sql("Select top 1 1 From   "~Dbo()~".ORDENES O INNER JOIN "~Dbo()~".OPERACIONESBITS OB ON O.NrOrden = OB.NrOperacion Where OB.Valor='1' and NrBit = 33") = 1)
Cancelar()('Hay Ordenes con Anulacion de Ejecuciones Pendientes - El cierre de la Rueda Garantizada no puede realizarce')
endif

sql.add("SELECT ORD.NrOrden, B.NrBit  ")
sql.add("  FROM "~Dbo()~".ORDENES ORD INNER JOIN "~Dbo()~".OPERACIONESBITS B ON ORD.NrOrden=B.NrOperacion")
sql.add("   WHERE ORD.FechaOrden="~IdxDate2(dialogo.fecha1))
sql.add("   AND ORD.TipoOrden in('OTIC','OTIV') ")
sql.add("   AND B.NrBit in( 8 ) ")
sql.add("   AND B.Valor=1 ")

if (NoVacio(dialogo.mercado1))
sql.add("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif


if (dialogo.radio1 = 0)
sql.add("AND ORD.Lotes=0 ")
else
sql.add("AND ORD.Lotes<>0 ")
endif

recorrer sql


ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 0, entero1 = 8, entero2 = 10)

proximo

sql.add("SELECT ORD.NrOrden, /*B1.NrBit NrBitOrd,*/ OP.NrOperacion, B2.NrBit NrBitOp, OP.Udn2 Rueda ")
sql.add("  FROM "~Dbo()~".ORDENES ORD INNER JOIN "~Dbo()~".OPERACIONES OP ON ORD.NrOrden=OP.NrOrden1 INNER JOIN "~Dbo()~".OPERACIONESBITS B2 ON OP.NrOperacion=B2.NrOperacion")
sql.add(" WHERE  ")
sql.add("   ORD.TipoOrden in('OTIC','OTIV') ")
sql.add("   AND OP.TipoOp in('TIC','TIV') ")
sql.add("   AND B2.NrBit in( 13 ) ")
sql.add("   AND B2.Valor=1 ")
sql.add("   AND ORD.FechaOrden="~IdxDate2(dialogo.fecha1))

if (NoVacio(dialogo.mercado1))
sql.add("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif

if (dialogo.radio1 = 0)
sql.add("AND ORD.Lotes=0 ")
else
sql.add("AND ORD.Lotes<>0 ")
endif
Watch(sql.batch)
recorrer sql



if (Eqstr(Var('INSTALACIO'), 'MLASA') y Incluido(Fbn()['Rueda'], Var('RUECPC1')))
ejecutarevento('CBOINS', string1 = Fbn()['NrOperacion'], radio1 = 1, radio2 = 0, entero1 = 13, entero2 = 68)
else
if (Vacio(sql("SELECT 1 From "~Dbo()~".OPERACIONES WHERE NrOperacion = '"~Fbn()['NrOperacion']~"' and Cuenta1 is Null or Cuenta2 is Null or Cuenta3 is Null or Cuenta4 is Null or Cuenta5 is Null  or  Cuenta6 is Null ")))
ejecutarevento('CBOINS', string1 = Fbn()['NrOperacion'], radio1 = 1, radio2 = 0, entero1 = 13, entero2 = 7)
else
ejecutarevento('CBOINS', string1 = Fbn()['NrOperacion'], radio1 = 1, radio2 = 0, entero1 = 13, entero2 = 10)
endif
endif
proximo
