if (Query("Select 1 From "~Dbo()~".FLAGSMERCADO Where Fecha = "~IdxDate2(dialogo.fecha1)~" and Paso = "~FStr(dialogo.radio1, 1, 0)~" and Registro = 'CGAR' and Estado='PRO' ") = 1)
Cancelar('El cierre de la Rueda Garantizada para el Plazo '~iif (dialogo.radio1 = 0, '-Contado-', '-Otros-')~' ya fue realizado. Debe ser anulado para volver a ejecutarlo')
endif

if (Query("Select top 1 1 From   "~Dbo()~".ORDENES O INNER JOIN "~Dbo()~".OPERACIONESBITS OB ON O.NrOrden = OB.NrOperacion Where OB.Valor='1' and NrBit = 33") = 1)
Cancelar('Hay Ordenes con Anulacion de Ejecuciones Pendientes - El cierre de la Rueda Garantizada no puede realizarce')
endif

Sqladd("SELECT ORD.NrOrden, B.NrBit  ")
Sqladd("  FROM "~Dbo()~".ORDENES ORD INNER JOIN "~Dbo()~".OPERACIONESBITS B ON ORD.NrOrden=B.NrOperacion")
Sqladd("   WHERE ORD.FechaOrden="~IdxDate2(dialogo.fecha1))
Sqladd("   AND ORD.TipoOrden in('OTIC','OTIV') ")
Sqladd("   AND B.NrBit in( 8 ) ")
Sqladd("   AND B.Valor=1 ")

if (NoVacio(dialogo.mercado1))
Sqladd("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif


if (dialogo.radio1 = 0)
Sqladd("AND ORD.Lotes=0 ")
else
Sqladd("AND ORD.Lotes<>0 ")
endif

recorrer sql


Ejecutarevento('CBOINS', 'string1', Fbn()['NrOrden'], 'radio1', 1, 'radio2', 0, 'entero1', 8, 'entero2', 10)

proximo

Sqladd("SELECT ORD.NrOrden, /*B1.NrBit NrBitOrd,*/ OP.NrOperacion, B2.NrBit NrBitOp, OP.Udn2 Rueda ")
Sqladd("  FROM "~Dbo()~".ORDENES ORD INNER JOIN "~Dbo()~".OPERACIONES OP ON ORD.NrOrden=OP.NrOrden1 INNER JOIN "~Dbo()~".OPERACIONESBITS B2 ON OP.NrOperacion=B2.NrOperacion")
Sqladd(" WHERE  ")
Sqladd("   ORD.TipoOrden in('OTIC','OTIV') ")
Sqladd("   AND OP.TipoOp in('TIC','TIV') ")
Sqladd("   AND B2.NrBit in( 13 ) ")
Sqladd("   AND B2.Valor=1 ")
Sqladd("   AND ORD.FechaOrden="~IdxDate2(dialogo.fecha1))

if (NoVacio(dialogo.mercado1))
Sqladd("AND ORD.Mercado3='"~dialogo.mercado1~"' ")
endif

if (dialogo.radio1 = 0)
Sqladd("AND ORD.Lotes=0 ")
else
Sqladd("AND ORD.Lotes<>0 ")
endif
Watch(Sqlbatch())
recorrer sql



