MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;
findialogo

if (not ok)
raise('Evento Cancelado')
endif


Message('--- Asientos de Egreso de Titulos ---')

Act(me:1, Var('MONEEXTR'))
Act(ml:1, Var('MONELOCA'))
Acn(na:1, Var('ASINUM'))
Acn(sl:2, Var('SALDOPOCON'))
Act(vc:1, dialogo.vehiculo1)
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))
Act(cm:1, Var('CLIENTEMAE'))

let(&tipoasiento, Var('TIPASIEGTI'))
let(&saldodeldia, 0)
let(&saldodeoperaciones, 0)

let(&bookpartidas, '')
Sqladd(" Select Books From "~Dbo()~".MODELOSNEGOCIO ")
Sqladd(" Where ValuaCarteraPartida = 'SI' ")



recorrer sql
let(&bookpartidas, &bookpartidas~Fbn('Books'))
proximo

Sqladd("Select E.MonedaEmision, P.Vehiculo Vehiculo1, 'TIC' TipoOp, E.Tipo TipoEspecie, P.Book Book1, ")
Sqladd("P.Estrategia CuentaCustodia, '' Concepto, P.Especie, Sum(P.CantidadFin) Cantidad ")
Sqladd("from "~Dbo()~".POSICIONES P ")
Sqladd("   JOIN "~Dbo()~".ESPECIES E ON P.Especie = E.Codigo ")
Sqladd("   JOIN "~Dbo()~".CUENTAS C ON P.Estrategia = C.Codigo ")
Sqladd("where P.Book Not IN ("~Pipe2Comillas(&bookpartidas)~") ")
Sqladd("AND (C.CB2 Is Null OR C.CB2 = '' OR C.CB2 =' ' OR C.CB2='NO') ")
Sqladd("AND P.NrSaldo = "~FStr(Val(sl:2), 0, 0)~" ")
Sqladd("AND P.Fecha IN (Select Max(Fecha) From "~Dbo()~".POSICIONES P1 ")
Sqladd("      Where P1.Especie = P.Especie ")
Sqladd("      AND P1.Vehiculo = P.Vehiculo ")
Sqladd("      AND P1.Cliente = P.Cliente ")
Sqladd("      AND P1.NrSaldo = P.NrSaldo ")
Sqladd("      AND P1.Book = P.Book ")
Sqladd("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
Sqladd("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
Sqladd("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
Sqladd("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
Sqladd("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
Sqladd("      AND (P1.Estrategia = P.Estrategia OR ((P1.Estrategia Is Null OR P1.Estrategia = '' OR P1.Estrategia = ' ') AND (P.Estrategia Is Null OR P.Estrategia = '' OR P.Estrategia = ' ' ))) ")
Sqladd("      AND P1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd("Group by P.Especie, P.Book, P.Estrategia, E.MonedaEmision, P.Vehiculo, E.Tipo, P.Book, P.Estrategia")
Sqladd("Order by P.Especie, P.Book, P.Estrategia ")

Watch(Sqlbatch())

recorrer sql
Acd(fv:1, dialogo.fecha1)
let(&tipoop, Fbn('TipoOp'))
let(&posicion, Fbn('Cantidad'))
let(&vehiculo, Fbn('Vehiculo1'))

if (Vacio(&especieanterior) y Vacio(&cuentacustodiaanterior) y Vacio(&bookanterior))
let(&especieanterior, Fbn('especie'))
let(&cuentacustodiaanterior, Fbn('CuentaCustodia'))
let(&bookanterior, Fbn('Book1'))
let(&monedaemisionanterior, Fbn('MonedaEmision'))
let(&tipoespecieanterior, Fbn('tipoEspecie'))
let(&sumaposiciones, 0)
else
let(&especieanterior, &especieactual)
let(&cuentacustodiaanterior, &cuentacustodiaactual)
let(&bookanterior, &bookactual)
let(&monedaemisionanterior, &monedaemisionactual)
let(&tipoespecieanterior, &tipoespecieactual)
endif

let(&especieactual, Fbn('especie'))
let(&cuentacustodiaactual, Fbn('CuentaCustodia'))
let(&bookactual, Fbn('Book1'))
let(&monedaemisionactual, Fbn('MonedaEmision'))
let(&tipoespecieactual, Fbn('tipoEspecie'))

if (Eqstr(&especieanterior, &especieactual) y Eqstr(&cuentacustodiaactual, &cuentacustodiaanterior) y Eqstr(&bookactual, &bookanterior))
let(&precioniif, CotizacionNIIF(&especieactual, dialogo.fecha1, &bookactual))
if (Vacio(&precioniif))
let(&cotizacionniif, 0)
else
let(&cotizacionniif, &precioniif.preciocotizaciondeterminada)
endif
let(&posicionvaluada, &posicion)

let(&sumaposiciones, &sumaposiciones + &posicionvaluada)
let(&nominales, &nominales + &posicion)
else
if (&sumaposiciones >= 0)
let(&sumacantopvaluada, 0)
Sqladd("SELECT Cantidad  from "~Dbo()~".OPERACIONES O")
Sqladd("JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("WHERE O.TipoOp in ('TIPO','TIPP') ")
Sqladd("AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("AND O.Cuenta1 = '"~&cuentacustodiaanterior~"' ")
Sqladd("AND O.Book1 = '"~&bookanterior~"' ")
Sqladd("AND E.Codigo = '"~&especieanterior~"' ")
recorrer sql
let(&cantidadoperacion, Fbn('Cantidad'))
let(&precioniif, CotizacionNIIF(&especieanterior, dialogo.fecha1, &bookanterior))
if (Vacio(&precioniif))
let(&cotizacionniif, 0)
else
let(&cotizacionniif, &precioniif.preciocotizaciondeterminada)
endif

let(&cantidadopvaluada, &cantidadopvaluada)
let(&sumacantopvaluada, &sumacantopvaluada + &cantidadopvaluada)
let(&nominales, &nominales + &cantidadoperacion)
proximo
let(&sumaposiciones, &sumaposiciones + &sumacantopvaluada)
endif
if (&sumaposiciones < 0)
let(&issuer, BuscarCampo('ESPECIES', 'issuer', 'Codigo', &especieanterior))
Sqladd(" SELECT '"~&especieanterior~"' Especie, '"~&monedaemisionanterior~"' MonedaEmision, ")
Sqladd(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookanterior~"' Book1, '"~&tipoespecieanterior~"' TipoEspecie, ")
Sqladd(" Codigo CodAsi, '"~&cuentacustodiaanterior~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
Sqladd(" '"~&issuer~"' Issuer, "~FStr(&nominales, 0, 0)~" Cantidad  ")
Sqladd(" From "~Dbo()~".MODELOSASIENTO ")
Sqladd(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoasiento)~") ")
Sqladd(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND Habilitado = 'SI' ")
recorrer sql
let(&codasi, Fbn('CodAsi'))
Act(bk:1, &bookanterior)
Act(mn:99, Fbn('MonedaEmision'))

Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where Modelo = '"~&codasi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~&vehiculo~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message('Modelo: '~&codasi)
Sqlgenerarasientoop(&codasi, '', '', '', Val(na:1), Val(fv:1), &vehiculo, null, null, null, null, null, &tipoop, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
endif
let(&sumaposiciones, 0)
let(&precioniif, CotizacionNIIF(&especieactual, dialogo.fecha1, &bookactual))
if (Vacio(&precioniif))
let(&cotizacionniif, 0)
else
let(&cotizacionniif, &precioniif.preciocotizaciondeterminada)
endif
let(&posicionvaluada, &posicion)

let(&sumaposiciones, &sumaposiciones + &posicionvaluada)
let(&nominales, &nominales + &posicion)
endif
proximo

if (&sumaposiciones >= 0)
let(&sumacantopvaluada, 0)
Sqladd("SELECT Cantidad  from "~Dbo()~".OPERACIONES O")
Sqladd("JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("WHERE O.TipoOp in ('TIPO','TIPP') ")
Sqladd("AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"'")
Sqladd("AND O.Cuenta1 = '"~&tipoespecieactual~"' ")
Sqladd("AND O.Book1 = '"~&bookactual~"' ")
Sqladd("AND E.Tipo = '"~&especieactual~"' ")
recorrer sql
let(&cantidadoperacion, Fbn('Cantidad'))
let(&precioniif, CotizacionNIIF(&especieactual, dialogo.fecha1, &bookactual))
if (Vacio(&precioniif))
let(&cotizacionniif, 0)
else
let(&cotizacionniif, &precioniif.preciocotizaciondeterminada)
endif
let(&cantidadopvaluada, &cantidadopvaluada)
let(&sumacantopvaluada, &sumacantopvaluada + &cantidadopvaluada)
let(&nominales, &nominales + &cantidadoperacion)
proximo
let(&sumaposiciones, &sumaposiciones + &sumacantopvaluada)
endif
if (&sumaposiciones < 0)

let(&especie, &especieactual)
let(&issuer, BuscarCampo('ESPECIES', 'issuer', 'Codigo', &especieanterior))

Sqladd(" SELECT '"~&especieactual~"' Especie, '"~&monedaemisionactual~"' MonedaEmision, ")
Sqladd(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookactual~"' Book1, '"~&tipoespecieactual~"' TipoEspecie, ")
Sqladd(" Codigo CodAsi, '"~&cuentacustodiaactual~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
Sqladd(" '"~&issuer~"' Issuer , "~FStr(&nominales, 0, 0)~" Cantidad ")
Sqladd(" From "~Dbo()~".MODELOSASIENTO ")
Sqladd(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoasiento)~") ")
Sqladd(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND Habilitado = 'SI' ")
recorrer sql
let(&codasi, Fbn('CodAsi'))
Act(bk:1, &bookanterior)
Act(mn:99, Fbn('MonedaEmision'))
Acn(ck:1, 0)
if (dialogo.check1 = 1 o dialogo.fecha1 < FSys())
Acn(ck:1, 1)
if (Vacio(Query(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where Modelo = '"~&codasi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(fv:1))~"' AND Vehiculo = '"~&vehiculo~"' ")))
Acn(ck:1, 0)
endif
endif
if (Val(ck:1) = 0)
Message('Modelo: '~&codasi)
Sqlgenerarasientoop(&codasi, '', '', '', Val(na:1), Val(fv:1), &vehiculo, null, null, null, null, null, &tipoop, null, null, null, null, null, null, FSys(), dialogo.fecha1)
Sqlexec()
endif
proximo
endif


Message('--- Reversa asientos de Egreso de Titulos ---')
Acd(fv:2, Habiles(dialogo.fecha1, -1, 'ARG'))

Sqladd(" Select FechaValor, NrUnicoAsiento ")
Sqladd(" From "~Dbo()~".ASIENTOSCON A ")
Sqladd(" JOIN "~Dbo()~".MODELOSASIENTO MA ON A.Modelo = MA.Codigo ")
Sqladd(" Where MA.TipoAsiento IN ("~Pipe2Comillas(&tipoasiento)~") ")
Sqladd(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND (A.Estado is NULL OR A.Estado = '' OR A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
Sqladd(" AND A.FechaGeneracion = '"~IdxDate(Val(fv:2))~"' ")
Watch(Sqlbatch())

recorrer sql
Act(as:1, Fbn('NrUnicoAsiento'))
Acd(fv:3, Fbn('FechaValor'))
Ejecutarevento('CONT46', 'fecha1', dialogo.fecha1, 'nrunicoasiento1', Val(as:1), 'fecha2', Val(fv:3), 'radio1', 0)
proximo

