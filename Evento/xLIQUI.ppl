*HojaVisible(SI)

CrearDialogo
  Vehiculo1: "Vehiculo" ;;;;;;NoVacio(Dialogo.Vehiculo1) IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' "));NO
  Fecha1   : "Fecha"    ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha';NO;FSys;
  Especie1 : "Especie"  ;;;;;;
  Cliente1 : "Entidad"  ;;;;;;
  Vehiculo2: "Vehiculo" ;;;;;;NoVacio(Dialogo.Vehiculo2);'Debe ingresar un Vehiculo';NO;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "));
FinDialogo
if not OK
  Cancelar
endif


CrearFont(1,"Arial,8,B")
if not Incluido(Dialogo.Vehiculo1, Var('VLIQUIDA')~Var('VLIQUIDA2'))
  Cancelar('El Vehiculo '~Dialogo.Vehiculo1~' no liquida operaciones')
endif
 MessageBox ('Testeo Positivo ') 
SQL.ADD("Select * from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B where")
SQL.ADD("NrSaldo = 1 ")
SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.Bits = 'MV' ")
if Novacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if Novacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("and M.NrOperacion = B.NrOperacion ")
SQL.ADD("and ((B.NrBit = 20 and B.Valor = '1') or (B.NrBit = 50 and B.Valor = '1'))")
SQL.ADD("order by M.NrOperacion,M.FechaMov,M.Cliente,M.Especie")

recorrer SQL

  ACT(z1, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn('NrOperacion')))
  if Incluido(Val(z1),Exe('CARTA1C')) o Incluido(Val(z1),Exe('CARTA1V')) o Incluido(Val(z1),Exe('CARTA2'))
    ACT(a:fac, FBN['NrOperacion'])
    ACD(b:fac, FBN['FechaMov'])
    ACT(c:fac, FBN['Cliente'])
    ACT(d:fac, FBN['Especie']~' '~FBN['Cupon'])
    ACN(e:fac, -FBN['Cantidad'])
    ACT(g:fac, FBN['Transaccion'])
    ACT(h:fac, FBN['Cuenta'])
    ACT(i:fac, FBN['Leyenda'])
    ACN(k:fac, 1)
    ACN(p:fac, FBN['NrMov'])
    ACT(r:fac, FBN['Especie'])
    ACT(s:fac, FBN['Cupon'])
  else
    dfa
  endif
proximo

if FAC>0
  ACN(z3,FAC)

*MessageBox("Fin Armar Lista")

  recorrer&i 1, Val(z3)
    ACN(w3, 0)
    ACT(w1, Val(r:&i))
    ACT(w2, BuscarCampo('ESPECIES','Jerarquia','Codigo',Val(r:&i)))
    if Not EqStr(Copy(Val(w2),1,3),'000')
      SCN(w3,1)
    endif
    if Not EqStr(Copy(Val(w2),4,3),'000')
      SCN(w3,1)
    endif
    if Not EqStr(Copy(Val(w2),7,3),'000')
      SCN(w3,1)
    endif
    if Not EqStr(Copy(Val(w2),10,3),'000')
      SCN(w3,1)
    endif
    if Not EqStr(Copy(Val(w2),12,3),'000')
      SCN(w3,1)
    endif

    recorrer&j 1,Val(w3)
      if &j=1
        ACT(w4, Copy(Val(w2),1,3))
      else
        ACT(w4, Val(w4)~Copy(Val(w2),(&j-1)*3+1,3))
        ACT(q:&i, Val(q:&i)~'|')
      endif
      ACT(q:&i, Val(q:&i)~BuscarCampo('ESPECIES','Codigo','Jerarquia',Copy(Val(w4)~'000000000000000',1,15)))
    proximo

    recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Comitente = '"~Val(c:&i)~"'  and Permanente = 'SI' and Estado = 'HAB'")
      dfa
      if Incluido(Val(q:&i),FBN['Especies'],1)
        ACT(f:&i, FBN['Codigo'])
        ACT(l:&i, 'Perm.')
        if Val(e:&i)>0
          ACT(g:&i, 'CREDIT')
        else
          ACT(g:&i, 'DEBITO')
        endif
        break
      endif
    proximo

    if Vacio(Val(f:&i))
      recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Comitente = '"~Val(c:&i)~"' and Estado = 'HAB'")
        dfa
        if Incluido(Val(q:&i),FBN['Especies'],1)
          ACT(f:&i, FBN['Codigo'])
          if Val(e:&i)>0
            ACT(g:&i, 'CREDIT')
          else
            ACT(g:&i, 'DEBITO')
          endif
          break
        endif
      proximo
    endif

    if Vacio(Val(f:&i))
      recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Permanente = 'SI' and Estado = 'HAB'")
        dfa
        if Incluido(Val(q:&i),FBN['Especies'],1)
          ACT(f:&i, FBN['Codigo'])
          ACT(l:&i, 'Perm.')
          ACT(g:&i, 'TRANSF')
          break
        endif
      proximo
      if Vacio(Val(f:&i))
        recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Estado = 'HAB'")
          dfa
          if Incluido(Val(q:&i),FBN['Especies'],1)
            ACT(f:&i, FBN['Codigo'])
            ACT(g:&i, 'TRANSF')
            break
          endif
        proximo
      endif
      if NoVacio(Val(f:&i))
        recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Permanente = 'SI' and Estado = 'HAB' ")
          dfa
          if Incluido(Val(q:&i),FBN['Especies'],1)
            ACT(h:&i, FBN['Codigo'])
            break
          endif
        proximo
        if Vacio(Val(h:&i))
          recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Estado = 'HAB' ")
            dfa
            if Incluido(Val(q:&i),FBN['Especies'],1)
              ACT(h:&i, FBN['Codigo'])
              break
            endif
          proximo
        endif
      endif
    endif
  proximo

*MessageBox("Fin Buscar Cuenta")

* CLB Columna ListBox
* FLB Fila ListBox
  Recorrer&j 1,100

     CrearListBox;'Arial,8,B'
       'Liquida'                  ; k1..k:fac; SI; SI;;60; COMBO; 'Si|No|'
       '# Operacion'              ; a1..a:fac; NO; SI;;80; STRING
       'Fecha'                    ; b1..b:fac; NO; SI;;70; FECHA
       'Entidad'                  ; c1..c:fac; NO; SI;;70; STRING
       'Especie'                  ; d1..d:fac; NO; SI;;70; STRING
       'Cantidad'                 ; e1..e:fac; NO; SI;;100; NUMERO;'###,###,###.##p'
       'Cuenta '~Dialogo.Vehiculo1; f1..f:fac; SI; [Incluido(Val(g:FLB),'COMP') y Vacio(Val(CLB:FLB))] o [[NoVacio(Val(CLB:FLB)) y EqStr(Dialogo.Vehiculo1,BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB))) y [Not Incluido(Val(g:FLB),'CREDIT|DEBITO') o EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Comitente','Codigo',Val(CLB:FLB)))]]] o Val(k:FLB)=1; "Error Cuenta "~Dialogo.Vehiculo1; 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
       'Transaccion'              ; g1..g:fac; SI; NoVacio(Val(CLB:FLB)) o Val(k:FLB)=1; "Error Transaccion"              ; 90; TABLA; 'TiposTransaccion';'Codigo';'Codigo;Descripcion';
       'Cuenta Entidad'           ; h1..h:fac; SI; [Incluido(Val(g:FLB),'CREDIT|DEBITO|EMI_CH|COMP') y Vacio(Val(CLB:FLB))] o [Incluido(Val(g:FLB),'TRANSF|C_4090') y [[Val(e:FLB)<0 y NoVacio(Val(CLB:FLB)) y EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))] o [Val(e:FLB)>0 y [Vacio(Val(CLB:FLB)) o EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))]]]] o Val(k:FLB)=1; "Error Cuenta "~Val(c:FLB); 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
       'Leyenda'                  ; i1..i:fac; NO; SI;;150; STRING
     FinListBox

     If Ok
        * Verifico que liquide en conjunto de NrOp, Fecha, Entidad y Especie
        * ab1: NrOperacion~Fecha~Entidad~Especie
        ACN(ab3,0)

        Recorrer&i 1,FAC
           If Not EqStr(val(ab1),Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i)) 
              ACT(ab1,Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i))
              ACN(ab2,Val(k:&i))
           Else 
              If val(k:&i)<>val(ab2)
                 MessageBox('Liquidacion Inconsistente para '~val(ab1))
                 ACN(ab3,1)
              EndIf
           EndIf                
        Proximo

        If val(ab3)=1
           ACN(ab4,0)
           ACN(ab4,MessageBox('Existen Liquidaciones Inconsistentes. Corrige la Seleccion ? ',2,1))

           If VAL(ab4)=2
              Cancelar
           EndIf 
        Else 
           * Selecciono los mov. correctamente
           Break
        EndIf 
     Else 
        Cancelar 
     EndIf
  Proximo

  If val(ab3)=0
     Recorrer&i 1,FAC

      if Val(k:&i)=0
        if Incluido(Val(g:&i),'CREDIT|DEBITO')
          ACT(h:&i, '')
        endif
        if Not EqStr(Val(g:&i),'EMI_CH')
          ACT(j:&i, '')
        endif
        ACT(x1, Val(q:&i))
        ACT(x2, Pad(Val(g:&i),6)~'    ')
        ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I E')
        if Val(e:&i)>0
          ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
          ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
        endif
        if Val(e:&i)<0
          ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
          ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
        endif

        ***** Valida Cuenta Propia
        If NoVacio(Val(f:&i))
           if Not EqStr(Dialogo.Vehiculo1,BuscarCampo('CUENTAS','Cliente','Codigo',Val(f:&i)))
              MessageBox('La cuenta '~Val(f:&i)~' no corresponde a '~Dialogo.Vehiculo1)
              ACN(m:&i,1)
           endif
           if Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(f:&i)),1)
              MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(f:&i))
              ACN(m:&i,1)
           endif
           if Not Incluido(Val(x2),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)),1)
              MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(f:&i))
              ACN(m:&i,1)
           endif
           if Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(f:&i)))
              MessageBox('La cuenta '~Val(f:&i)~' no esta habilitada')
              ACN(m:&i,1)
          endif
        endif

        ***** Valida Cuenta Entidad
        if NoVacio(Val(h:&i))
          if Not EqStr(Val(c:&i),BuscarCampo('CUENTAS','Cliente','Codigo',Val(h:&i)))
            MessageBox('La cuenta '~Val(h:&i)~' no corresponde a '~Val(c:&i))
            ACN(n:&i,1)
          endif
          if Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(h:&i)),1)
            MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(h:&i))
            ACN(n:&i,1)
          endif
          if Not Incluido(Val(x3),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(h:&i)),1)
            MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(h:&i))
            ACN(n:&i,1)
          endif
          if Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(h:&i)))
            MessageBox('La cuenta '~Val(h:&i)~' no esta habilitada')
            ACN(n:&i,1)
          endif
        endif

        * Verifico que los mov. que esta tomando esten Pendientes
        ACN(o:&i,1) 

        SQL.ADD("Select * from "~DBO~".MOVPENDIENTES M where")
        SQL.ADD("NrSaldo=1 ")
        SQL.ADD("and M.FechaMov   <='"~IdxDate(val(b:&i))~"' ")
        SQL.ADD("and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and M.Bits = 'MV' ")
        SQL.ADD("and M.Especie = '"~VAL(r:&i)~"' ")
        SQL.ADD("and M.Cliente = '"~VAL(c:&i)~"' ")
        SQL.ADD("and M.NrOperacion='"~VAL(a:&i)~"' ")
        SQL.ADD("and M.NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")

        Recorrer SQL
             Message('Verifico que el Mov. no se haya liquidado Previamente '~val(a:&i)~' '~Fstr(VAL(p:&i),0,0)~' ...' )
             ACN(o:&i,0) 
        Proximo

        If val(o:&i)=1
           MessageBox('El Mov. de la Operacion '~val(a:&i)~' Nro. '~Fstr(VAL(p:&i),0,0)~' fue liquidado Previamente por Otro Usuario ....')
        EndIf

        if Val(m:&i)=0 y Val(n:&i)=0 y Val(o:&i)=0

           *----   Genera Voucher de Liquidacion
           ACT(t:&i,GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo',Dialogo.Vehiculo1)))

          SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")
          SQL.ADD("Especie, ")
          SQL.ADD("Fecha1, ")
          SQL.ADD("Fecha2, ")
          SQL.ADD("Cliente1, ")
          SQL.ADD("Vehiculo1, ")
          SQL.ADD("NrOperacionRef1, ")
          SQL.ADD("TipoTr2, ")
          SQL.ADD("Cantidad1, ")
          SQL.ADD("Cuenta1, ")
          SQL.ADD("Cuenta2, ")
          SQL.ADD("Cuenta5, ")
          SQL.ADD("Cuenta6, ")
          SQL.ADD("Cupon1, ")
          SQL.ADD("Ley1, ")
          SQL.ADD("NrTrans ")
          SQL.ADD(") Values (")
          SQL.ADD("'"~Val(r:&i)~"', ")
          SQL.ADD("'"~IdxDate(FSys)~"', ")
*         SQL.ADD("'"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD("'"~IdxDate(Val(b:&i))~"', ")
          SQL.ADD("'"~Val(c:&i)~"', ")
          SQL.ADD("'"~Dialogo.Vehiculo1~"', ")

          SQL.ADD("'"~Val(a:&i)~"', ")
          if Val(e:&i) > 0
            SQL.ADD("'DEP', ")
            SQL.ADD(""~FStr(Val(e:&i),1,2)~", ")
          else
            SQL.ADD("'RET', ")
            SQL.ADD(""~FStr(-Val(e:&i),1,2)~", ")
          endif
          SQL.ADD("'"~Val(h:&i)~"', ")
          SQL.ADD("'"~Val(f:&i)~"', ")
          SQL.ADD("'"~Val(h:&i)~"', ")
          SQL.ADD("'"~Val(f:&i)~"', ")
          SQL.ADD("'"~Val(s:&i)~"', ")
          SQL.ADD("'"~Val(g:&i)~"', ")
          SQL.ADD("'"~Val(t:&i)~"' ")
          SQL.ADD(")")
          SQL.NEW

          SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
          SQL.ADD("(NrBit, NrOperacion, Valor) ")
          SQL.ADD("Select NrInstancia, '"~Val(t:&i)~"', '0'")
          SQL.ADD("from "~DBO~".INSTANCIAS ")
          SQL.ADD("where Tabla = 'TRANSACCIONES2'")
          SQL.NEW

          SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
          SQL.ADD(" SET Valor = '1' ")
          SQL.ADD(" Where NrBit = 2 and NrOperacion = '"~Val(t:&i)~"' ")
          SQL.NEW

          Message('Genera Voucher '~Val(t:&i))

          Message('Genera Movimientos de la Transaccion')
          if Dialogo.Fecha1>FSys
             SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")
          else
            SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
            SQL.ADD("FechaEje, ")
            SQL.ADD("UsuarioEje, ")
          endif
        
          SQL.ADD("NrTrans2, ")
          SQL.ADD("NrOperacion, ")
          SQL.ADD("Leyenda, ")
          SQL.ADD("Cantidad, ")
          SQL.ADD("Cliente, ")

          SQL.ADD("Especie, ")
          SQL.ADD("CallPut, ")
          SQL.ADD("NrSaldo, ")
          SQL.ADD("NrGrupo, ")
          SQL.ADD("NrGrupo2, ")

          SQL.ADD("Bits, ")
          SQL.ADD("Cupon, ")
          SQL.ADD("NrMov, ")
          SQL.ADD("NrInstan, ")
          SQL.ADD("FechaMov, ")

          SQL.ADD("EnteCustodia, ")
          SQL.ADD("Cuenta, ")
          SQL.ADD("Transaccion ")
          
          SQL.ADD(") Values (")
         
          if Dialogo.Fecha1<=FSys
            SQL.ADD("'"~IdxDate(Hoy)~"', ")
            SQL.ADD("'"~UsuarioActivo~"', ")
          endif
          
          SQL.ADD("'"~Val(t:&i)~"', ")
          SQL.ADD("'"~Val(t:&i)~"', ")
          if Val(e:&i) > 0
            SQL.ADD("'Cobro', ")
          else
            SQL.ADD("'Pago', ")
          endif
          SQL.ADD(""~FStr(Val(e:&i),1,2)~", ")
          SQL.ADD("'"~Dialogo.Vehiculo1~"',")

          SQL.ADD("'"~Val(r:&i)~"', ")
          SQL.ADD("'', ")
          SQL.ADD(""~FStr(1,1,0)~", ")
          SQL.ADD(""~FStr(0,1,0)~", ")
          SQL.ADD(""~FStr(0,1,0)~", ")

          SQL.ADD("'AV', ")
          SQL.ADD("'"~Val(s:&i)~"', ")
          SQL.ADD(""~FStr(0,0,0)~", ")
          SQL.ADD(""~FStr(0,1,0)~", ")
          SQL.ADD("'"~IdxDate(Dialogo.Fecha1)~"', ")

          SQL.ADD("'"~Dialogo.Vehiculo1~"', ")
          SQL.ADD("'"~Val(f:&i)~"', ")
          SQL.ADD("'"~Val(g:&i)~"' ")
          
          SQL.ADD(")")
          SQL.NEW
*
*****   Genera Movimientos Ejecutados de la Operacion

          SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
          SQL.ADD("NrOperacion, ")
          SQL.ADD("FechaMov, ")
          SQL.ADD("Cliente, ")
          SQL.ADD("Especie, ")
          SQL.ADD("NrSaldo, ")

          SQL.ADD("CallPut, ")
          SQL.ADD("FechaEj, ")
          SQL.ADD("PrecioEj, ")
          SQL.ADD("EnteCustodia, ")
          SQL.ADD("Mercado, ")

          SQL.ADD("Formula, ")
          SQL.ADD("Leyenda, ")
          SQL.ADD("Bits, ")
          SQL.ADD("NrGrupo, ")
          SQL.ADD("Concepto, ")

          SQL.ADD("NrGrupo2, ")
          SQL.ADD("NrMov, ")
          SQL.ADD("NrLiq, ")
          SQL.ADD("Status, ")
          SQL.ADD("NrComprob, ")

          SQL.ADD("NrInstan, ")
          SQL.ADD("FechaEje, ")
          SQL.ADD("UsuarioEje, ")
          SQL.ADD("Cuenta, ")
          SQL.ADD("Transaccion, ")

          SQL.ADD("Cupon, ")
          SQL.ADD("NrTrans2, ")
          SQL.ADD("Cantidad ")

          SQL.ADD(") select ")

          SQL.ADD("NrOperacion, ")
          SQL.ADD("FechaMov, ")
          SQL.ADD("Cliente, ")
          SQL.ADD("Especie, ")
          SQL.ADD("NrSaldo, ")

          SQL.ADD("CallPut, ")
          SQL.ADD("FechaEj, ")
          SQL.ADD("PrecioEj, ")
          SQL.ADD("EnteCustodia, ")
          SQL.ADD("Mercado, ")

          SQL.ADD("Formula, ")
          SQL.ADD("Leyenda, ")
          SQL.ADD("Bits, ")
          SQL.ADD("NrGrupo, ")
          SQL.ADD("Concepto, ")

          SQL.ADD("NrGrupo2, ")
          SQL.ADD("NrMov, ")
          SQL.ADD("NrLiq, ")
          SQL.ADD("Status, ")
          SQL.ADD("NrComprob, ")

          SQL.ADD("NrInstan, ")
          SQL.ADD("'"~IdxDate(Hoy)~"', ")
          SQL.ADD("'"~UsuarioActivo~"', ")
          SQL.ADD("Cuenta, ")
          SQL.ADD("Transaccion, ")

          SQL.ADD("Cupon, ")
          SQL.ADD("'"~Val(t:&i)~"', ")
          SQL.ADD("Cantidad ")

          SQL.ADD(" from "~DBO~".MOVPENDIENTES ")
          SQL.ADD("where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("and NrSaldo = 1 ")
          SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
          SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
          SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
          if NoVacio(Val(s:&i))
            SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
          else
            SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
          endif

*         SQL.ADD("and Cantidad = "~FStr(-Val(e:&i),1,8)~" ")
          SQL.ADD("and NrMov = "~FStr(Val(p:&i),1,0)~" ")
          SQL.NEW


          Message(' Se Borran los Movs Pendientes de la operacion')

          SQL.ADD("DELETE FROM "~DBO~".MOVPENDIENTES ")
* messagebox('NrOperacion: '~Val(a:&i))
          SQL.ADD("where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("and NrSaldo = 1 ")
          SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
* messagebox('fecha: '~Val(b:&i))
          SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
* messagebox('cliente: '~Val(c:&i))
          SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
* messagebox('especie: '~Val(r:&i))
          if NoVacio(Val(s:&i))
            SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
* messagebox('cupon1: '~Val(s:&i))
          else
            SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
          endif
*          SQL.ADD("and Cantidad = "~FStr(-Val(e:&i),1,8)~" ")
* messagebox('cantidad: '~FStr(-Val(e:&i),1,8))
          SQL.ADD("and NrMov = "~FStr(Val(p:&i),1,0)~" ")
* messagebox('nrmov: '~FStr(Val(p:&i),1,0))
          SQL.NEW
          SQL.EXEC
        endif
      endif
    proximo
  else
    Cancelar
  endif
else
  Cancelar("No Hay Movimientos a Liquidar")
endif

SetFont(w1..z6,1)
