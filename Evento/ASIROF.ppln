creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 >= 0 o dialogo.fecha1 >= FSys();'Debe ingresar una Fecha valida';NO;FSys()
especie1:'Especie';;;;;;;;;
vehiculo1:'Vehiculo';;;;NO;NO;NoVacio(dialogo.vehiculo1);'Debe ingresar un vehiculo';NO;Var('VEHICULODE')
mercado1:'Ubicacion';;;;NO;NO;NoVacio(dialogo.mercado1);'Debe Ingresar un Mercado ';NO;Var('MERROFEX');;

findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)


Sqladd("Delete from "~Dbo()~".MOVLIMITES      ")
Sqladd("Where Limite      = 'ACROFEX'       ")
Sqladd("  AND NrOperacion = 'GARANTIA'      ")
if (NoVacio(dialogo.especie1))
Sqladd("  AND GrupoEspecie     = '"~dialogo.especie1~"'    ")
endif

Sqlnew()


Sqladd("SELECT S1.Especie, S1.Cliente, SUM(S1.Saldo) Saldo                                             ")
Sqladd("FROM "~Dbo()~".SALDOSDIA S1 WITH (NOLOCK)                                                        ")
Sqladd("     INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK)                                               ")
Sqladd("           ON S1.Cliente = C.Codigo                                                            ")
Sqladd("     INNER JOIN "~Dbo()~".ESTADOSCUSTODIA EC WITH (NOLOCK)                                       ")
Sqladd("           ON S1.NrSaldo='"~Var('BLOQGROFEX')~"'                                               ")

Sqladd("WHERE S1.EnteCustodia = '"~dialogo.vehiculo1~"' AND                                            ")
Sqladd("      S1.Saldo <> 0 AND                                                                        ")
Sqladd("      EC.Codigo = 'GROFEX' AND                                                                 ")
if (NoVacio(dialogo.especie1))
Sqladd("  S1.Especie  = '"~dialogo.especie1~"'  AND  ")
endif

Sqladd("      S1.Fecha = (SELECT MAX(S2.Fecha)                                                         ")
Sqladd("                  FROM "~Dbo()~".SALDOSDIA S2 WITH (NOLOCK)                                      ")
Sqladd("                  WHERE S2.Cliente = S1.Cliente AND S2.Especie = S1.Especie AND                ")
Sqladd("                        S2.Cupon = S1.Cupon AND S2.EnteCustodia = S1.EnteCustodia AND          ")
Sqladd("                        S2.Mercado = S1.Mercado AND S2.NrSaldo = S1.NrSaldo AND                ")
Sqladd("                        S2.Cuenta = S1.Cuenta AND S2.Fecha <= '"~IdxDate(dialogo.fecha1)~"' )  ")
Sqladd("GROUP BY S1.Especie,S1.Cliente                                                                 ")
Sqladd("ORDER BY S1.Especie                                                                            ")

recorrer sql

Acn(co:fac, CotizacionC(Fbn()['Especie'], null, null, null, dialogo.fecha1 - 1, 1, SI, 'ARP'))
Acn(ca:fac, Fbn()['Saldo'] * Val(co:fac))


Sqladd("Insert into "~Dbo()~".MOVLIMITES (                                  ")
Sqladd("  FechaMov,    Cliente,   Limite,                                 ")
Sqladd("  Especie,     Monto,     NrOperacion,                            ")
Sqladd("  Descripcion, Bits,      Vehiculo, GrupoEspecie                  ")
Sqladd(") values (                                                        ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~Var('CLIROFEX')~"', 'ACROFEX',  ")
Sqladd(" 'ARP',  "~FStr(Val(ca:fac), 0, 2)~", 'GARANTIA',                   ")
Sqladd(" ' Asistencia garantias ROFEX ',                                  ")
if (dialogo.fecha1 <= FSys())
Sqladd(" 'P', ")
else
Sqladd(" 'N', ")
endif
Sqladd(" '"~dialogo.vehiculo1~"' , '"~Fbn()['Especie']~"'                    ")
Sqladd(" )                                                                 ")
Sqlnew()


proximo


Sqlexec()









