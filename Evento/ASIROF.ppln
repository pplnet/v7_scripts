creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 >= 0 o dialogo.fecha1 >= FSys();'Debe ingresar una Fecha valida';NO;FSys()
especie1:'Especie';;;;;;;;;
vehiculo1:'Vehiculo';;;;NO;NO;NoVacio(dialogo.vehiculo1);'Debe ingresar un vehiculo';NO;Var('VEHICULODE')
mercado1:'Ubicacion';;;;NO;NO;NoVacio(dialogo.mercado1);'Debe Ingresar un Mercado ';NO;Var('MERROFEX');;

findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)


sql.add("Delete from "~Dbo()~".MOVLIMITES      ")
sql.add("Where Limite      = 'ACROFEX'       ")
sql.add("  AND NrOperacion = 'GARANTIA'      ")
if (NoVacio(dialogo.especie1))
sql.add("  AND GrupoEspecie     = '"~dialogo.especie1~"'    ")
endif

sql.new


sql.add("SELECT S1.Especie, S1.Cliente, SUM(S1.Saldo) Saldo                                             ")
sql.add("FROM "~Dbo()~".SALDOSDIA S1 WITH (NOLOCK)                                                        ")
sql.add("     INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK)                                               ")
sql.add("           ON S1.Cliente = C.Codigo                                                            ")
sql.add("     INNER JOIN "~Dbo()~".ESTADOSCUSTODIA EC WITH (NOLOCK)                                       ")
sql.add("           ON S1.NrSaldo='"~Var('BLOQGROFEX')~"'                                               ")

sql.add("WHERE S1.EnteCustodia = '"~dialogo.vehiculo1~"' AND                                            ")
sql.add("      S1.Saldo <> 0 AND                                                                        ")
sql.add("      EC.Codigo = 'GROFEX' AND                                                                 ")
if (NoVacio(dialogo.especie1))
sql.add("  S1.Especie  = '"~dialogo.especie1~"'  AND  ")
endif

sql.add("      S1.Fecha = (SELECT MAX(S2.Fecha)                                                         ")
sql.add("                  FROM "~Dbo()~".SALDOSDIA S2 WITH (NOLOCK)                                      ")
sql.add("                  WHERE S2.Cliente = S1.Cliente AND S2.Especie = S1.Especie AND                ")
sql.add("                        S2.Cupon = S1.Cupon AND S2.EnteCustodia = S1.EnteCustodia AND          ")
sql.add("                        S2.Mercado = S1.Mercado AND S2.NrSaldo = S1.NrSaldo AND                ")
sql.add("                        S2.Cuenta = S1.Cuenta AND S2.Fecha <= '"~IdxDate(dialogo.fecha1)~"' )  ")
sql.add("GROUP BY S1.Especie,S1.Cliente                                                                 ")
sql.add("ORDER BY S1.Especie                                                                            ")

recorrer sql

Acn(co:fac, CotizacionC(Fbn()['Especie'], null, null, null, dialogo.fecha1 - 1, 1, SI, 'ARP'))
Acn(ca:fac, Fbn()['Saldo'] * Val(co:fac))


sql.add("Insert into "~Dbo()~".MOVLIMITES (                                  ")
sql.add("  FechaMov,    Cliente,   Limite,                                 ")
sql.add("  Especie,     Monto,     NrOperacion,                            ")
sql.add("  Descripcion, Bits,      Vehiculo, GrupoEspecie                  ")
sql.add(") values (                                                        ")
sql.add(" '"~IdxDate(dialogo.fecha1)~"', '"~Var('CLIROFEX')~"', 'ACROFEX',  ")
sql.add(" 'ARP',  "~FStr(Val(ca:fac), 0, 2)~", 'GARANTIA',                   ")
sql.add(" ' Asistencia garantias ROFEX ',                                  ")
if (dialogo.fecha1 <= FSys())
sql.add(" 'P', ")
else
sql.add(" 'N', ")
endif
sql.add(" '"~dialogo.vehiculo1~"' , '"~Fbn()['Especie']~"'                    ")
sql.add(" )                                                                 ")
sql.new


proximo


sql.exec









