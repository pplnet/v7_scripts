ModoReproceso(SinDialogo())
creardialogo
nroperacion1: 'Operacion';;;;;;Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'TRANTI');'El TipoOp debe ser TRANTI';NO;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('CACTRA'))~") "
fecha1:'Fecha';;;;;;;;;FSys()
directorio1: 'Path carta';;;;;;NoVacio(dialogo.directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
string1: 'File carta';;;;;;NoVacio(dialogo.string1);'Debe ingresar un documento';NO;Var('FILECACTRA')
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar('El directorio '~dialogo.directorio1~' no existe')
endif


let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

recorrer&i 1, 2
Sqladd("Select NrOperacion,TipoOp,Vehiculo1,Especie,Cantidad,FechaOp,FechaVto,ContraEspecie,FechaPago,Precio1,Cliente1,Cliente2,Cuenta4,Cuenta1 from "~Dbo()~".OPERACIONES")
Sqladd(" WHERE NrOperacion = '"~dialogo.nroperacion1~"'")
recorrer sql
let(&nombre_especie, BuscarCampo('ESPECIES', 'Nombre', 'Codigo', Fbn()['Especie']))
let(&desc_vehiculo, BuscarCampo('Vehiculos', 'Descripcion', 'Codigo', Fbn()['Vehiculo1']))
if (&i = 1)
let(&razon_social, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente1']))
let(&numero_cuenta, BuscarCampo('CUENTAS', 'Numero', 'Codigo', Fbn()['Cuenta4']))
let(&cod_comitente, BuscarCampo('CLIENTES', 'CodComitente', 'Codigo', Fbn()['Cliente1']))
let(&localidad, BuscarCampo('CLIENTES', 'Localidad', 'Codigo', Fbn()['Cliente1']))
else
let(&razon_social, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Fbn()['Cliente2']))
let(&cuenta, BuscarCampo('CUENTAS', 'Numero', 'Codigo', Fbn()['Cuenta1']))
let(&localidad, BuscarCampo('CLIENTES', 'Localidad', 'Codigo', Fbn()['Cliente2']))
endif
let(&fecha_larga, FStr(Dia(dialogo.fecha1), 1, 0)~' de '~Val(aa:mes(dialogo.fecha1))~' de '~FStr(Anio(dialogo.fecha1), 4, 0))
let(&oracion, 'Por medio de la presente, solicitamos a UDS, transferir la cantidad de VN ')
if (&i = 2)
let(&oracion, 'Por medio de la presente, confirmamos a UDS, haberles transferido la cantidad de VN ')
endif

emitircartavisible(&pf, Copy(dialogo.string1, 1, Longitud(dialogo.string1) - 5)~'_'~dialogo.nroperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion = &oracion, monto = PYC(Fbn()['Cantidad'], 1, 2), nombre_especie = &nombre_especie, cod_comitente = &cod_comitente, desc_vehiculo = &desc_vehiculo, numero_cuenta = &numero_cuenta)
proximo
