sql.add(" SELECT /*+ RULE */ C.NrOperacion, T.TipoTr2, T.CNFormaPago, FP.Tipo, M.Cuenta, T.Cliente2, ")
sql.add(" M.Cantidad, C.Fecha, T.NrTrans, T.Fecha1, M.FechaMov, M.Especie, T.Cantidad2, T.Vehiculo1  ")
sql.add(" FROM "~Dbo()~".CONCILIACIONES C, "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CNFORMASPAGOCOBRO FP, "~Dbo()~".MOVEJECUTADOS M ")
sql.add(" WHERE C.NrOperacion = T.NrTrans     ")
sql.add(" AND   T.NrTrans     = M.NrOperacion ")
sql.add(" AND   T.CNFormaPago = FP.Codigo ")
sql.add(" AND   C.Fecha       >= "~IdxDate2(dialogo.fecha1)~" ")
sql.add(" AND   C.Fecha       <= "~IdxDate2(dialogo.fecha2)~" ")
sql.add(" AND   T.TipoTr2     = 'DEVM' ")
sql.add(" AND   FP.Tipo       = 'CHE' ")
sql.add(" AND   (T.CB5 = '0' OR T.CB5 IS NULL OR T.CB5='') ")
if (NoVacio(dialogo.lista2))
sql.add(" AND T.Cliente2 IN ("~pipe2comillas(dialogo.lista2)~")  ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND M.Cuenta IN ("~pipe2comillas(dialogo.lista3)~")  ")
endif
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
endif
sql.add(" ORDER BY T.Vehiculo1, T.Cliente2, M.Cuenta, M.FechaMov, T.Cantidad2 ")

