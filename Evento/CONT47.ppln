Sqladd(" Select MA.Codigo From "~Dbo()~".MODELOSASIENTO MA ")
Sqladd(" Where MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIRZ'))~") ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND MA.Entorno = '"~Sigla()~"' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (( ")
recorrer&i 1, Elementos(dialogo.lista1)
