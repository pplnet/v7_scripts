Sqladd(" Select CRMEDAY, IRMEDAY, CRMLDAY, CIMLDAY, KRMLDAY, IRMLDAY, CRMCDAY, CIMCDAY, RTMCDAY, IRMCDAY, CRMFDAY, CIMFDAY, RTMFDAY, IRMFDAY, ")
Sqladd(" KRMFDAY, KRMCDAY, RTMFDAY, RTMCDAY, RTMLDAY, XRMFDAY, XRMCDAY, XRMLDAY, Especie, Vehiculo, Book, FTMCDAY, FTMFDAY, FTMLDAY, Especie, ")
Sqladd(" Vehiculo, NrSaldo, INMEDAY, INMLDAY, INMCDAY, INMFDAY, YRMFDAY, YRMEDAY, YRMLDAY, YRMCDAY ")
Sqladd(" From "~Dbo()~".RESULTADOS2 ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND NrSaldo IN ("~Val(y:2)~") ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND (Vehiculo IN ("~Pipe2Comillas(dialogo.lista1)~") OR Vehiculo is null OR Vehiculo = '' OR Vehiculo = ' ' )")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND Vehiculo IN (Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"') ")
endif
endif
Sqladd(" AND Vehiculo Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
recorrer sql
Acn(rz:1, Fbn('CRMFDAY') + Fbn('FTMFDAY') + Fbn('RTMFDAY'))
Acn(iz:1, Fbn('YRMFDAY'))
Acn(dz:1, Fbn('XRMFDAY') - Fbn('RTMFDAY'))
Acn(rz:2, Fbn('CRMLDAY') + Fbn('FTMLDAY') + Fbn('RTMLDAY'))
Acn(iz:2, Fbn('YRMLDAY'))
