* ESTE EVENTO PREPARA TODA LA INFORMACION DE LA OPERACION Y SE LA MANDA A LA ESTACION 
* MONITORA PARA INFORMAR AL MAE (PARA TODA LAS OPERACIONES CON ESPECIES VALIDAS
* MENOS LOS PASES YA QUE SE INFORMAN LAS OPERACIONES DERIVADAS DE LOS MISMOS)

CrearDialogo
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

*- Seleccion de las operaciones que se encuentran en la instancia Informar al MAE (60)
SQL.ADD("SELECT O.NrOperacion,    O.TipoOp,       O.Especie,       O.Rojo,               O.FechaOp,           ")
SQL.ADD("       O.PaseCB,         O.EsAforado,    O.TipoCambio2,   O.PorAforo,           O.Precio1,           ")
SQL.ADD("       O.CB6,            O.Plazo,        O.Cupon1,        O.PlazoGracia,        O.Mercado,           ")
SQL.ADD("       O.TablaFeriados1, O.FechaVto,     O.ContraEspecie, O.Cliente1,           O.OpSIOPEL,          ")
*SQL.ADD("       O.Cantidad,       O.Mercado2,     O.TotalNetoCli1, O.TotalInteresesOrig, O.FormaLiquidacion1, ")
*SQL.ADD("       O.NroAltaMAE,     O.NrOperacion3, O.EnteCus1,      O.TotalBrutoCli1Orig, O.Cuenta1,           ")
*SQL.ADD("       O.Precio3,        O.Precio4,      O.InteresMAE,    O.ContraEspecie2 ")
SQL.ADD("       O.Cantidad,       O.Mercado2,     O.TotalNetoCli1, O.FormaLiquidacion1, O.FormaLiquidacion2, ")
SQL.ADD("       O.NroAltaMAE,     O.NrOperacion3, O.EnteCus1,      O.Cuenta1,           ")
SQL.ADD("       O.Precio3,        O.Precio4,      O.ContraEspecie2 ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 60 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD("   and IsNull(O.Plataforma,'SIOPEL') = 'SIOPEL' ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL
  if Incluido(FBN['TipoOp'], 'TIC|TIV|TIFV|TIFC')
    ACN(z1,0)
    BorrarCeldas(a:1..t:10)
    ACT(l:1, 'Plazo de liq. la Especie1')
    ACT(l:2, 'EsCupon de Especie1')
    ACT(l:3, 'CotizaMAE de Especie1')
    ACT(l:4, 'NrMAE de Cliente1')
    ACT(l:5, 'NrAgenteBolsa de Cliente1')
    ACT(l:6, 'Num(NrAgenteBolsa)')
    ACT(l:7, 'CampoMercado')
    ACT(l:8, 'Cuenta1')
    ACT(l:9, 'TipoMAE')
* FJL 02/08/19 - Por si cambio el codigo de la especie.
    ACT(l:10, 'CodMAECont')
    ACT(l:16, 'Tipo Esp.')

    ACN(m:1, BuscarCampo('ESPECIES','PlazoLiq','Codigo',FBN['Especie'])*24)
    ACT(m:2, BuscarCampo('ESPECIES','EsCupon','Codigo',FBN['Especie']))
    ACT(m:3, BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']))
    ACT(m:4, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),3))
    ACT(m:5, Pad0(BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',FBN['Cliente1']),3))
    ACN(m:6, Num(Val(m:5)))
***///*** Funcion No existente
*    ACT(m:7, CampoMercado(FBN['Mercado2'],FBN['Especie'],FBN['Cliente1'],2))
    ACT(m:8, fbn('Cuenta1'))
***///*** Campo TipoMAE No existe en CUENTAS
*    ACT(m:9, BuscarCampo('CUENTAS','TipoMAE','Codigo',fbn('Cuenta1')))
    ACT(m:9, '5')
* FJL 02/08/19 - Por si cambio el codigo de la especie.
    ACT(m:10, BuscarCampo('ESPECIES','CodMAEContado','Codigo',FBN['Especie']))
    ACT(n:10, FBN['EnteCus1'])
    ACT(m:16, BuscarCampo('ESPECIES','Tipo','Codigo',FBN['Especie']))

    ************ Prepara info para Bloque de Control ******************************************
    * Longitud             PIC(4)                                                             *
    * Mercado              PIC(1)                                                             *
    * Agente               PIC(3)                                                             *
    * Operador             PIC(2)                                                             *
    * Fecha                PIC(6)                                                             *
    * Hora                 PIC(6)                                                             *
    * Secuencia            PIC(5)                                                             *
    * Cod. de Registro     PIC(4)                                                             *
    *******************************************************************************************
    ACN(Y1, Ahora)
    ACT(Y2, Hora(Val(Y1)))
    if Eqstr(FBN['Rojo'],'1') 
      ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
      ACT(Y4, Fecha(FSYS, 'YYYYMMDD'))
    else
      ACT(Y3, Fecha(fbn('FechaOp'), Exe('FORFECMAE')))
      ACT(Y4, Fecha(FSYS, 'YYYYMMDD'))      
    endif
    *** Mercado
    ACT(A2, Var('MERSIOP'))
    *** Agente                                        
    ACT(A2, Val(A2)~Var('AGESIOP'))
    ************************************************
    *** Operador (Por ahora informar siempre 99) ***
    ************************************************
* FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
*    ACT(A2, Val(A2)~'99')
    ACT(A2, Val(A2)~Var('OPESIOPEL'))
    *** Fecha
    ACT(A2, Val(A2)~Val(Y3))
    *** Hora
    ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),4,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),7,2))
    *** Secuencia (Comienza con 0 (alta) o 9 (baja) )
    if Not Eqstr(FBN['Rojo'],'1')
      * Alta
      ACT(A2, Val(A2)~'0')
      ACT(s:1, 'AL')
    else
      * Baja
      ACT(A2, Val(A2)~'9')
      ACT(s:1, 'BA')
    endif
    ACT(A2, Val(A2)~Copy(FBN['NrOperacion'],5,4))
    *** Cod. de Registro
    if Incluido(FBN['TipoOp'],'TIV|TIFV')
      ACT(A2, Val(A2)~'03')
      ACT(s:2, 'VT')
    else
      if Incluido(FBN['TipoOp'],'TIC|TIFC')
        ACT(A2, Val(A2)~'04')
        ACT(s:2, 'CO')
      else
        * Error en TipoOp
        ACN(z1,1)
        ACT(A2, Val(A2)~'00')
      endif
    endif
    if Not Eqstr(FBN['Rojo'],'1')
      * Alta Operacion (Forma parte del Cod. de Reg.)
      if [FBN['FechaOp'] = FSYS]
        ACT(A2, Val(A2)~'01')
      else
        if [FBN['FechaOp'] < FSYS]
          ACT(A2, Val(A2)~'03')
        else
          * Error en FechaOp
          ACN(z1,1)
          ACT(A2, Val(A2)~'00')
        endif
      endif
    else
      * Baja Operacion (Forma parte del Cod. de Reg.)
      if [FBN['FechaOp'] = FSYS]
        ACT(A2, Val(A2)~'02')
      else
        if [FBN['FechaOp'] < FSYS]
          ACT(A2, Val(A2)~'04')
        else
          * Error en FechaOp
          ACN(z1,1)
          ACT(A2, Val(A2)~'00')
        endif
      endif
    endif
    if EqStr(Val(m:9),'5')
      if Vacio(Val(m:4)) o EqStr(val(m:4),'000')
        ACT(s:3, 'TR')
      else
        ACT(s:3, 'AG')
      endif
    else
      if EqStr(Val(m:9),'3')
        if Vacio(Val(m:5)) o EqStr(val(m:5),'000')
          ACT(s:3, 'TR')
        else
          ACT(s:3, 'BO')
        endif
      else
        ACT(s:3, 'TR')
      endif
    endif
    
    ****************************************
    *** Aca termina el Bloque de Control ***
    ****************************************

    if Not Eqstr(FBN['Rojo'],'1')
      ACN(r1,2)
      ************************ Alta Operacion MAE *********************************************
      ************************ Prepara info para Codigo de Titulo *****************************
      * Negociacion PIC(1) reservado                                                          *
      * Cod especie PIC(5)                                                                    *
      * Cupon       PIC(1) " " (negocia lamina) o "C" (negocia cupon)                         * 
      * Nro Cupon   PIC(3) nro. cupon adherido                                                *
      * Plazo dias  PIC(3) habiles para CV o corridos para pases                              *
      * Moneda      PIC(1) "A" (pesos) o "D" (dolares)                                        *
      * Indica tipo PIC(1) 1(Tit.Pub.) 2(ON) 3(Acc.Ord.) 4(Acc.Pref.) 5(Pases) 6(Caucion) 7(Pase Af)*
      *****************************************************************************************
      *** Negociacion  
      if FBN['PaseCB'] = 1 
        * Pase
        *************************************************************
        *** Falta Definir Compos de Operaciones de Pases Aforados ***
        *************************************************************
        if EqStr(fbn('EsAforado'),'1')
          * Es un Pase Aforado
          ACT(A3,'7') 
          * Guardar % Aforo
          ***ACN(z4, 1-(fbn('PorAforo')/100))
          ACN(z4, 1)
        else
          ACT(A3,'5')
          * No lleva %  de aforo
          ACN(z4, 1)
        endif
      else
        * NO Pase
        if Incluido(FBN['CB6'], '1')
          * Ejercicio de Opcion
          ACT(A3,'8')
        else
          * Compra/Venta
          if Incluido(FBN['TipoOp'],'TIV|TIC')
            * Spot
            if fbn['Plazo']/24<=3
              ACT(A3,'1')
            else
              ACT(A3,'9')
            endif
          else
            if Incluido(FBN['TipoOp'],'TIFV|TIFC')
              * Futuro
              ACT(A3,'9')
            else
              * Error en Tipo de Operacion
              ACN(z1,1)
              ACT(A3,'0')
            endif
          endif
        endif
        *** No lleva %  de aforo
        ACN(z4, 1)
      endif
            
      *** Especie
* FJL 02/08/19 - Por si cambio el codigo de la especie.
*      ACT(A3, Val(A3)~Pad(FBN['EnteCus1'],5))
      ACT(A3, Val(A3)~Pad(Copy(Val(m:10),1,5),5))
      *** Cupon     
      if EqStr(Val(m:2),'SI')
        ACT(A3, Val(A3)~'C')
      else
        ACT(A3, Val(A3)~' ')
      endif
      *** Nro Cupon 
* FJL 26/04/18 - Cambio en SIOPEL
*      ACT(A3, Val(A3)~PAD0(FStr(Num(FBN['Cupon1']),1,0),3))
      if Num(FBN['Cupon1'])=0
        ACT(A3, Val(A3)~'   ')
      else
        ACT(A3, Val(A3)~PAD0(FStr(Num(FBN['Cupon1']),1,0),3))
      endif
      *** Plazo
      if Incluido(FBN['TipoOp'], 'TIV|TIC')
        if FBN['PaseCB'] = 1
          *- Si es un pase informo dias corridos sino dias habiles
* FJL 3/12/19 - Por BBYMA - En STD no se usa PlazoGracia
*          ACT(A3, Val(A3)~Pad0(FStr(fbn['PlazoGracia'],1,0),3))
          ACT(A3, Val(A3)~Pad0(FStr(fbn['FechaVto']-fbn['FechaOp'],1,0),3))
        else
***///***
*          if fbn['Plazo']<=3
          if fbn['Plazo']<=72
***///***
*            ACT(A3, Val(A3)~Pad0(FStr(fbn['Plazo'],1,0),3))
            ACT(A3, Val(A3)~Pad0(FStr(fbn['Plazo']/24,1,0),3))
          else
            if Not Incluido(fbn['Mercado'],'AC|CRYL|CE|EU') y EqStr(fbn['TablaFeriados1'],'USA') y Not EsHabil(Habiles(fbn['FechaVto'],-1,'ARG'),'USA')
              ACT(A3, Val(A3)~Pad0(FStr(Habiles(fbn['FechaVto'],-1,'ARG')-fbn['FechaOp'],1,0),3))
            else
              ACT(A3, Val(A3)~Pad0(FStr(fbn['FechaVto']-fbn['FechaOp'],1,0),3))
            endif
          endif
        endif
      else
        if Incluido(FBN['TipoOp'], 'TIFV|TIFC')
* FJL 3/12/19 - Por BBYMA - En STD no se usa PlazoGracia
*          ACT(A3, Val(A3)~Pad0(FStr(FBN['PlazoGracia'],1,0),3))
          ACT(A3, Val(A3)~Pad0(FStr(FBN['Plazo'],1,0),3))
        else
          * Error en Tipo de Operacion
          ACN(z1,1)
          ACT(A3, Val(A3)~Pad0(FStr(0,1,0),3))
        endif
      endif
      *** Moneda 
      if Incluido(FBN['ContraEspecie'], 'USD')
        ACT(A3, Val(A3)~'D')
      else
        if Incluido(FBN['ContraEspecie'], 'ARP')
          ACT(A3, Val(A3)~'$')
        else
          ACT(A3, Val(A3)~'E')
        endif
      endif
      *** Indicador de Tipo
      if DesciendeDeEspecie(FBN['Especie'], 'TITULO') 
* FJL 28/06/22 - Para independizarse de la jerarquia (BOFA)
*        ACT(A3, Val(A3)~'1')
        ACT(n:16, '1')
        if Incluido(Val(m:16),'ONE|ON')
          ACT(n:16, '2')
        endif
        ACT(A3, Val(A3)~Val(n:16))
      else
        if DesciendeDeEspecie(FBN['Especie'], 'ON')
          ACT(A3, Val(A3)~'2')
        else
          ACT(A3, Val(A3)~'0')
        endif
      endif
      ACT(A2, Val(A2)~Val(A3))
      *************************** Codigo de Agente Contraparte ********************************
      * Mercado Contra   PIC(1)                                                               *
      * Agente Contra    PIC(3)                                                               *
      * Operador Contra  PIC(2)                                                               *
      *****************************************************************************************
      *** Mercado / Agente / Operador
      if EqStr(Val(s:3),'AG')
        * Agente MAE
        ACT(A4, Var('MERSIOP')) 
        ACT(A4, Val(A4)~COPY(Val(m:4),1,3))
        ACT(A4, Val(A4)~FBN['OpSIOPEL'])
      else
        if EqStr(Val(s:3),'BO')
          * Agente de bolsa
          ACT(A4, '5') 
          ACT(A4, Val(A4)~Copy(Val(m:5),1,3))
          ACT(A4, Val(A4)~'01')
        else
          * Tercero
          ACT(A4, '0')
          ACT(A4, Val(A4)~'000')
          ACT(A4, Val(A4)~'00')
        endif
      endif
      ACT(A2, Val(A2)~Val(A4))
      ************************************ Otros datos ****************************************
      * Cantidad          PIC(14)V(4)                                                         *
      * Precio            PIC(10)V(8)                                                         *
      * Tipo Op.Origen    PIC(1)      1 (AMA)          2 (BCRA)           5 (Cartera Propia)  *
      * Tipo Op.Destino   PIC(1)      0 (No Agente)    1 (AMA)            2 (BCRA)            *
      *                               3 (Ag.Bolsa)     4 (AFJP Fondo)     5 (Cartera Propia)  *
      *                               6 (AFJP Encaje)                                         *
      * Ente Liquidador   PIC(1) (Op.Compra) 1/D (ARGENCLEAR) 3/6 (CEDEL)  2 (CRYL)           *
      *                                      4/6 (EUROCLEAR)  5/6 (MERVAL) 6 (E/PARTES USA)   *
      * Tipo Liquidacion  PIC(1) (Op.Compra) 1 (DVP)          2 (FP)       3 (DVP&F)          *
      *                                      4 (FT)                                           *
      * Codigo de Rueda   PIC(4)                                                              *
      * Interes           PIC(16)V(2)                                                         *
      *****************************************************************************************
      *- Cantidad
      ACT(A5, Pad0(FStr(FBN['Cantidad']*10000,1,0),18))
      *- Precio
***///***
*      if Eqstr(Val(m:3),'CLE')
*        *- Si la especie se informa al MAE clean
*        ACN(z3, FBN['Precio3'])
*      else
*        *- Si la especie se informa al MAE dirty
*        ACN(z3, FBN['Precio4'])
*      endif
      ACN(z3, FBN['Precio1'])
      ACT(A5, Val(A5)~Pad0(FStr(Val(z3)*Val(z4)*100000000,1,0),18))


if NO
**Anterior
      *** Tipo Op.Origen
      ACT(A5, Val(A5)~'5')
      *** Tipo Op.Destino
      if Vacio(Val(m:9))
        * Tercero
        ACT(A5, Val(A5)~'0')
      else
        ACT(A5, Val(A5)~Val(m:9))
      endif
endif

      ***** Tipo Op.Origen
      ***********************************************************************************************
      * Por Siopel 8
      * ACT(A5, Val(A5)~'5')
      *----------------------------------------------------------------------------------------------
      *    5 Cartera Propia 
      *    7 Comitente Cartera Propia
      *    8 Por cuenta de un Cliente 
      * Aparentemente se informa Cartera propia en origen
      if NO y Incluido(fbn['TipoOp'],'TIV|TIFV|')
        * Por ahora no hay diferencia entre compra y venta
        If DesciendeDeCliente(FBN['Cliente1'],'DIRECTORIO')
          ACT(A5, Val(A5)~'7')
          ACT(TO1,'7')
        else
          BorrarCeldas(xx:1..xx:1)
          ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
          If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
            ACT(A5, Val(A5)~'8')
            ACT(TO1,'8')
          Else
            ACT(A5, Val(A5)~'5')
            ACT(TO1,'5')
          Endif
        endif
      else
        ACT(A5, Val(A5)~'5')
        ACT(TO1,'5')
      endif

      ***** Tipo Op.Destino 
      BorrarCeldas(xx:1..xx:1)
      if SI o Incluido(fbn['TipoOp'],'TIC|TIFC|')
        *- Tercero Vinculado
        If DesciendeDeCliente(FBN['Cliente1'], 'DIRECTORIO')
          ACT(A5, Val(A5)~'4')
          ACT(TD1,'4')
        else
          *- Agente Bolsa
          If Num(BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',FBN['Cliente1'])) > 0
            ACT(A5, Val(A5)~'3')
            ACT(TD1,'3')
          Else
            *- Agente mae
            If novacio(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1'])) y Not Eqstr(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),'000')
              ACT(A5, Val(A5)~'5')
              ACT(TD1,'5')
            Else
              *- Tercero
              ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
              If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
                ACT(A5, Val(A5)~'6')
                ACT(TD1,'6')
              else
                ACT(A5, Val(A5)~'5')
                ACT(TD1,'5')
              endif
            endif
          endif
        Endif
      else
        * Por ahora no hay diferencia entre compra y venta
        ACT(A5, Val(A5)~'5')
        ACT(TD1,'5')
      endif

      *** Ente Liquidador
      if EqStr(FBN['Mercado'],'AC')
        if EqStr(FBN['TablaFeriados1'],'USA')
          ACT(A5,Val(A5)~'D')
        else
          if EqStr(FBN['ContraEspecie'],'USD') y EqStr(FBN['ContraEspecie2'],'USB')
            ACT(A5,Val(A5)~'B')
          else
            ACT(A5,Val(A5)~'1')
          endif
        endif
      else
        if EqStr(FBN['Mercado'],'CRYL')
          ACT(A5,Val(A5)~'2')
        else
          if EqStr(FBN['Mercado'],'CE')
            if EqStr(FBN['TablaFeriados1'],'USA')
              ACT(A5,Val(A5)~'6')
            else
              ACT(A5,Val(A5)~'3')
            endif
          else
            if EqStr(FBN['Mercado'],'EU')
              if EqStr(FBN['TablaFeriados1'],'USA')
                ACT(A5,Val(A5)~'6')
              else
                ACT(A5,Val(A5)~'4')
              endif
            else
              if EqStr(FBN['Mercado'],'CV')
                if EqStr(FBN['TablaFeriados1'],'USA')
                  ACT(A5,Val(A5)~'6')
                else
                  ACT(A5,Val(A5)~'5')
                endif
              else
** FJL 17/07/25 - Issue EXTBOFA-8175 Por nuevo Mercado liquidacion A3C
*                if EqStr(FBN['Mercado'],'MC')
                if Incluido(FBN['Mercado'],'MC|A3C')
* FJL 02/10/18 - Nuevo criterio para MC - Definido con Alcira
*                 if EqStr(FBN['TablaFeriados1'],'USA')
*                    ACT(A5,Val(A5)~'U')
*                  else
*                    ACT(A5,Val(A5)~'W')
*                  endif
                  if Incluido(FBN['ContraEspecie'], 'USD')
* Dolar Mep 19/05/2020  
*                    ACT(A5, Val(A5)~'U')
                     if EqStr(FBN['Mercado2'],VAR('MERMCMEP'))
                        ACT(A5, Val(A5)~'W')
                     Else   
                        ACT(A5, Val(A5)~'U')
                     Endif
                  else
                    if Incluido(FBN['ContraEspecie'], 'ARP')
                      ACT(A5, Val(A5)~'F')
                    else
                      ACT(A5, Val(A5)~'F')
                    endif
                  endif
                else
                  if EqStr(FBN['TablaFeriados1'],'USA')
                    ACT(A5,Val(A5)~'6')
                  else
                    ACT(A5,Val(A5)~'5')
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
      *** Tipo de Liquidacion
* FJL 01/10/18 - por error detectado en produccion      
      if Incluido(FBN['Mercado'],VAR('MERCADOCV'))
        if FBN['FormaLiquidacion1'] = 0
          ACT(A5,Val(A5)~'2')
        endif
        if FBN['FormaLiquidacion1'] = 1
          ACT(A5,Val(A5)~'1')
        endif
        if FBN['FormaLiquidacion1'] = 2
          ACT(A5,Val(A5)~'6')
        endif
      else
        if Incluido(FBN['Mercado'],VAR('MERCAVARI'))
          if FBN['FormaLiquidacion2'] = 0
            ACT(A5,Val(A5)~'5')
          endif
          if FBN['FormaLiquidacion2'] = 1
            ACT(A5,Val(A5)~'1')
          endif
          if FBN['FormaLiquidacion2'] = 2
            ACT(A5,Val(A5)~'2')
          endif
        else
          * En caso de no estar el mercado en ninguna de las dos variables - No deberia pasar
          ACT(A5,Val(A5)~'4')
        endif
      endif
      *** Codigo de Rueda
      ACT(A5, Val(A5)~'    ')
      *** Interes
      if Eqstr(Val(m:3),'CLE')
        * Si la especie se informa al MAE clean
        ACT(A5, Val(A5)~Pad0(FStr(fbn('InteresMAE')*100,1,0),18))
      else
        * Si la especie se informa al MAE dirty
        ACT(A5, Val(A5)~'000000000000000000')
      endif
      ACT(A2, Val(A2)~Val(A5))
      If FBN['FechaOp'] = FSYS 
        ***********************************************************************************************
        * Por Siopel 8
        *----------------------------------------------------------------------------------------------
        * Porc.Riesgo Pago        9(5)
        * Porc.Riesgo Precio      9(5)
        * Plazo cobertura         9(1)
        * Comitente Origen        X(18)
        * Comitente Contraparte   X(18)
        ***********************************************************************************************
        *** Porc.Riesgo Pago
        ACT(A2, Val(A2)~'00000')        
        *** Porc.Riesgo Precio
        ACT(A2, Val(A2)~'00000')
        *** Plazo cobertura
        ACT(A2, Val(A2)~'0')
        if SI o Incluido(fbn['TipoOp'],'TIC|TIFC|')
          *** Comitente Origen
          ACT(A2, Val(A2)~Pad(' ',18))
          *** Comitente Contraparte
          BorrarCeldas(xx:1..xx:1)
          ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
          If [Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))] y Not Incluido(val(TD1),'3')
            Borrarceldas(yy:1..yy:1)
            ACT(yy:2,FBN['Cliente1'])
            (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*            ACT(A2, Val(A2)~Pad(Val(yy:10),18))
            ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),18),1,18))
          Else
            ACT(A2, Val(A2)~Pad(' ',18))
          Endif 
        else
          *** Comitente Origen
          BorrarCeldas(xx:1..xx:1)
          ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
          If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
            Borrarceldas(yy:1..yy:1)
            ACT(yy:2,FBN['Cliente1'])
            (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*            ACT(A2, Val(A2)~Pad(Val(yy:10),18))
            ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),18),1,18))
          Else
            ACT(A2, Val(A2)~Pad(' ',18))
          Endif 
          *** Comitente Contraparte
          ACT(A2, Val(A2)~Pad(' ',18))
        endif
      endif
      *----------------------------------------------------------------------------------------------
    else
      if Eqstr(FBN['Rojo'],'1')
        ACN(r1,1)
        ************************************ Baja Operacion MAE *******************************
        *** Fecha Alta al MAE (ojo ver si esta con separadores, sacarlos)
        BorrarCeldas(k1..k6)
        ACN(K1, Trunc2(SQL("Select FechaAltaMAE from "~DBO~".OPERACIONES where NrOperacion = '"~FBN['NrOperacion']~"' ")))
        ACT(K2, Fecha(Val(K1)))
        ACT(K3, Copy(Val(K2),9,2)~Copy(Val(K2),4,2)~Copy(Val(K2),1,2))
        if EqStr(Val(s:3),'AG')
          * Operacion con Agente
          if Val(K1) > FSys-5
            ACT(A2, Val(A2)~Val(K3))  
          else
            ACT(A2, Val(A2)~Val(Y3))       
          endif
        else
          * Operacion con Tercero o Ag.Bolsa
          ACT(A2, Val(A2)~Val(K3))  
        endif
        *** Nro. MAE de la Operacion (Secuencia)
        ACT(A2, Val(A2)~Pad0(Copy(FBN['NroAltaMAE'],1,5),5))
        *** Mercado / Agente / Operador
        if EqStr(Val(s:3),'AG')
          * Agente MAE
          ACT(A4, Var('MERSIOP')) 
          ACT(A4, Val(A4)~Copy(Val(m:4),1,3))
          ACT(A4, Val(A4)~FBN['OpSIOPEL'])
        else
          if EqStr(Val(s:3),'BO')
            * Agente de bolsa
            ACT(A4, '5') 
            ACT(A4, Val(A4)~Copy(Val(m:5),1,3))
            ACT(A4, Val(A4)~'01')
          else
            * Tercero
            ACT(A4, '0') 
            ACT(A4, Val(A4)~'000')
            ACT(A4, Val(A4)~'00')
          endif
        endif
        ACT(A2, Val(A2)~Val(A4))
** FJL 23-08-18 - Se agrega estos datos para la baja
        if Incluido(fbn['TipoOp'],'TIC|TIFC|')
          *** Comitente Comprador
          ACT(A2, Val(A2)~Pad(' ',18))
          *** Comitente Vendedor
          BorrarCeldas(xx:1..xx:1)
          ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
          If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
            Borrarceldas(yy:1..yy:1)
            ACT(yy:2,FBN['Cliente1'])
            (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*            ACT(A2, Val(A2)~Pad(Val(yy:10),18))
            ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),18),1,18))
          Else
            ACT(A2, Val(A2)~Pad(' ',18))
          Endif 
        Else
          *** Comitente Comprador
          BorrarCeldas(xx:1..xx:1)
          ACT(xx:1, SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
          If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
            Borrarceldas(yy:1..yy:1)
            ACT(yy:2,FBN['Cliente1'])
            (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*            ACT(A2, Val(A2)~Pad(Val(yy:10),18))
            ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),18),1,18))
          Else
            ACT(A2, Val(A2)~Pad(' ',18))
          Endif 
          *** Comitente Vendedor
          ACT(A2, Val(A2)~Pad(' ',18))
        Endif 
        * Hora Op Baja
        ACN(k:4, SQL("Select FechaAltaMAE from "~DBO~".OPERACIONES where NrOperacion = '"~FBN['NrOperacion']~"' "))
        ACT(k:5, Hora(Val(k:4)))
        ACT(k:6, Copy(Val(k:5),1,2)~Copy(Val(k:5),4,2)~Copy(Val(k:5),7,2))
        ACT(A:2, Val(A2)~Pad(Val(k:6),6))
      endif
    endif

    *********************** Datos en caso de envio con demora (ayer) **************************
    * Codigo de Motivo   PIC(2) (Ver Codigos de demoras)                                      *
    * Motivo de Demora   PIC(78)                                                              *
    *******************************************************************************************
    if FBN['FechaOp'] < FSYS y Not Eqstr(FBN['Rojo'],'1')
      *** Codigo
      ACT(A6, '12')
      *** Descripcion
      ACT(A6, Val(A6)~Pad('Problemas de soft/hard',78))
      ACT(A2, Val(A2)~Val(A6))
      ***********************************************************************************************
      * Por Siopel 8
      *----------------------------------------------------------------------------------------------
      (.'MSG303403'.)
      *----------------------------------------------------------------------------------------------
    endif
    *************************************** Envio de Datos ************************************
    * Envia los Datos a la Estacion Monitora, pasa la operacion a la Instancia Siguiente y    *
    * actualiza la operacion con los datos de envio                                           *
    *******************************************************************************************
    *- Longitud Total del Paquete en Caracteres
    ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4) )
    ACT(A2, Val(P1)~Val(A2))
    if Val(z1)=0
      if Dialogo.Check1=1
        Socket.Enviar(Val(A2))
        if Not OK
          Message('Error Enviando Op. Nro : '~FBN['NrOperacion'])
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Error Enviando Op.'~FBN['NrOperacion'],30))
            CerrarASCII
          endif
        else
          if Eqstr(Var('LOGEAMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.TXT',0)
            EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
            CerrarASCII
          endif
          ACT(t:1, Val(s:1)~Val(s:2)~Val(s:3))
          ACT(t:2, Copy(Val(A2),11,6))
          ACT(t:3, Copy(Val(A2),17,6))
          ACT(t:4, Copy(Val(A2),23,5))
          ACT(t:5, Copy(Val(A2),28,4))
          ACT(t:6, 'INF')
          ACT(t:7, Copy(Val(A2),1,250))
          if Longitud(Val(A2))>250
            ACT(t:8, Copy(Val(A2),251,250))
          endif
          if Longitud(Val(A2))>500
            ACT(t:9, Copy(Val(A2),501,250))
          endif
          (.'GRAMENMAE'.)
          
          ACT(a1, SQLAhora)
          SQL.ADD("Update "~DBO~".OPERACIONES ")
          SQL.ADD("   Set FechaEnvioMAE = "~Val(a:1)~", ")
* FJL 02/08/19 - Por si cambio el codigo de la especie.
          SQL.ADD("       EnteCus1      = '"~Val(m:10)~"' ")
          SQL.ADD(" Where NrOperacion   = '"~FBN['NrOperacion']~"' ")
          SQL.NEW
          if FBN['FechaOp'] < FSYS
            SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
            SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
            SQL.ADD(" ) Values ( ")
            SQL.ADD(" '"~FBN['NrOperacion']~"', ")
            SQL.ADD(" "~SQLAhora~", ")
            SQL.ADD(" 'MAEFVALOR', ")
            SQL.ADD(" '"~Copy(Val(A6),1,2)~'-'~Copy(Val(A6),3,55)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
          endif
          ************************* Operaciones derivadas de pases ****************************
          *           Si es una operacion derivada de un pase y ya fue enviada la otra        *
          *           operacion entonces paso el Pase de instancia                            *
          *************************************************************************************
          if EqStr(FBN['PaseCB'],'1')
            if Eqstr(FBN['Rojo'],'1')
              ACT(N1, BuscarCampo('OPERACIONES','NroBajaMAE','NrOperacion',FBN['NrOperacion3']))
              if Incluido(FBN['TipoOp'],'TIC|TIV')
                ACT(N2, 'ENV '~Copy(Val(N1),5,4))
              else
                ACT(N2, Copy(Val(N1),1,4)~'ENV ')
              endif
              SQL.ADD("Update "~DBO~".OPERACIONES ")
              SQL.ADD("   Set NroBajaMAE    = '"~Val(N:2)~"', ")
              SQL.ADD("       FechaEnvioMAE = "~Val(a:1)~", ")
* FJL 02/08/19 - Por si cambio el codigo de la especie.
              SQL.ADD("       EnteCus1      = '"~Val(m:10)~"' ")
              SQL.ADD(" Where NrOperacion   = '"~FBN['NrOperacion3']~"' ")
              SQL.NEW
            else
              ACT(N:1, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',FBN['NrOperacion3']))
              if Incluido(FBN['TipoOp'],'TIC|TIV')
                ACT(N:2, 'ENV '~Copy(Val(N:1),5,4))
              else
                ACT(N:2, Copy(Val(N:1),1,4)~'ENV ')
              endif
              SQL.ADD("Update "~DBO~".OPERACIONES ")
              SQL.ADD("   Set NroAltaMAE    = '"~Val(N:2)~"', ")
              SQL.ADD("       FechaEnvioMAE = "~Val(a:1)~", ")
* FJL 02/08/19 - Por si cambio el codigo de la especie.
              SQL.ADD("       EnteCus1      = '"~Val(m:10)~"' ")
              SQL.ADD(" Where NrOperacion   = '"~FBN['NrOperacion3']~"' ")
              SQL.NEW
            endif
          endif
          SQL.EXEC
          if EqStr(Val(s:3),'AG')
            * Agente MAE
            EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=Val(r1), Entero1=60, Entero2=62)
          else
            * Tercero o Ag.Bolsa
            EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=Val(r1), Entero1=60, Entero2=61)
          endif
        endif
      else
        MessageBox('Operacion '~fbn['NrOperacion']~' OK')  
        ACT(aa:FAC, Val(a:2))
      endif
    else
      * Error z1<>0
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Error z1<>0 INFMAE ('~FBN['NrOperacion']~')',30))
        CerrarASCII
      endif
      if Dialogo.Check1=0
        MessageBox('Operacion '~fbn['NrOperacion']~' Not OK (z1<>0)')  
      endif
    endif
  else
    * Error en Tipo de Operacion
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Error TipoOp INFMAE ('~FBN['NrOperacion']~')',30))
      CerrarASCII
    endif
    if Dialogo.Check1=0
      MessageBox('Operacion '~fbn['NrOperacion']~' Not OK (TipoOp)')  
    endif
  endif
Proximo
ACO(12,15)
