creardialogo
nrtrans1: 'Nro.Voucher';;;;;;Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'FXDEP|FXRET|FXCOMP');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('FXDEP','FXRET','FXCOMP') AND Fecha1 = '"~IdxDate(FSys())~"' ";
findialogo
if (not ok)
Cancelar()
endif

if (BuscarCampo('TRANSACCIONES2', 'CB10', 'NrTrans', dialogo.nrtrans1) <> 1)
Cancelar('El Voucher '~dialogo.nrtrans1~' NO es de OCT ')
endif
if (BuscarCampo('TRANSACCIONES2', 'CB9', 'NrTrans', dialogo.nrtrans1) = 1)
Cancelar('El Voucher '~dialogo.nrtrans1~' esta confirmado')
endif
if (Incluido(BuscarCampo('TRANSACCIONES2', 'TipoTr2', 'NrTrans', dialogo.nrtrans1), 'FXDEP|FXRET'))
Act(x1, Query("Select Valor from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~dialogo.nrtrans1~"' and NrBit = 2 "))
if (Eqstr(Val(x1), '1'))
Cancelar('El Voucher '~dialogo.nrtrans1~' esta fallado')
endif
endif

