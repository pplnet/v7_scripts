creardialogo
fecha1:'Fecha';;;;;;;;;;;;;
string1:'Cuenta';2;1;;;;;;;;;;;;"Select DISTINCT(NrCuenta),Nombre  from "~Dbo()~".SALDOSBANCARIOS"
cantidad1:'Ajuste';;;;;;;;;;;;;
findialogo

Sqladd(" UPDATE "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" SET Ajuste='"~FStr(dialogo.cantidad1, 0, 2)~"' ")
Sqladd(" WHERE FechaSaldo = '"~IdxDate(dialogo.fecha1)~"' and NrCuenta = '"~dialogo.string1~"' ")
Sqlnew()
Sqlexec()


let(&contable, 0)
let(&operativo, 0)
let(&inicial, 0)
let(&dias, 0)

Sqladd(" Select SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, FechaSaldo from "~Dbo()~".SALDOSBANCARIOS")
Sqladd(" Where FechaSaldo >= '"~IdxDate(dialogo.fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(dialogo.fecha1, SI))~"' and NrCuenta = '"~dialogo.string1~"' and Estado <> 'ANU' ")
recorrer sql
let(&contable, Fbn()['SaldoAcuCon'] + dialogo.cantidad1)
let(&operativo, Fbn()['SaldoAcuOpe'] + dialogo.cantidad1)
let(&inicial, Fbn()['SaldoAcuIni'] + dialogo.cantidad1)
let(&dias, Fbn()['DiasAcu'])

Sqladd(" UPDATE "~Dbo()~".SALDOSBANCARIOS ")
Sqladd(" SET SaldoAcuCon="~FStr(&contable, 0, 2)~",SaldoAcuOpe="~FStr(&operativo, 0, 2)~",SaldoAcuIni="~FStr(&inicial, 0, 2)~" ")
Sqladd(" ,SaldoOpePromedio="~FStr(&contable / &dias, 0, 2)~" ,SaldoConPromedio="~FStr(&contable / &dias, 0, 2)~",SaldoIniPromedio="~FStr(&contable / &dias, 0, 2)~" ")
Sqladd(" WHERE FechaSaldo = '"~IdxDate(Fbn()['FechaSaldo'])~"' and NrCuenta = '"~dialogo.string1~"' and Estado <> 'ANU' ")
Sqlnew()
Sqlexec()
proximo
