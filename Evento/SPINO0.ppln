sql.add(" SELECT S.Cliente, S.Especie, S.Cupon, S.Mercado, S.Cuenta, S.EnteCustodia, S.FechaEj, ")
sql.add(" S.NrSaldo, S.Saldo, C.RazonSocial, E.ISIN, E.TamanioLote, S.CallPut, S.PrecioEj, ")
sql.add(" C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3337, C.TIngBru ")
sql.add(" from "~Dbo()~".SALDOSDIA S, "~Dbo()~".CLIENTES C, "~Dbo()~".ESPECIES E")
sql.add(" WHERE S.Cliente      = C.Codigo ")
sql.add(" AND   S.Especie      = E.Codigo ")
sql.add(" AND   '"~Val(w:1)~"' = S.Especie ")
sql.add("   AND S.NrSaldo      in ("~pipe2comillas(Val(sl:2))~") ")
sql.add("   AND S.NrSaldo      Not in ("~pipe2comillas(Val(sl:4))~") ")

sql.add(" AND   'HAB' = C.Status ")
sql.add(" AND (( 'CLI'=C.CategDepositante AND '"~Val(w:10)~"'=S.EnteCustodia ) OR ('"~Val(w:10)~"'=C.Codigo)) ")
sql.add(" AND   S.Fecha   <= "~IdxDate2(Val(w:2))~" ")
sql.add(" AND   S.Fecha IN (select MAX(Fecha) ")
sql.add("                    from  "~Dbo()~".SALDOSDIA ")
sql.add("                    where (Mercado = S.Mercado or (Mercado IS NULL and S.Mercado IS NULL)) ")
sql.add("                     and  (Cuenta  = S.Cuenta  or (Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
sql.add("                     and  (Cupon   = S.Cupon   or (Cupon   IS NULL and S.Cupon   IS NULL)) ")
sql.add("                     and  Cliente      = S.Cliente ")
sql.add("                     and  Especie      = S.Especie ")
sql.add("                     and  EnteCustodia = S.EnteCustodia ")
sql.add("                     and  NrSaldo      = S.NrSaldo ")
sql.add("                     and  Fecha       <= "~IdxDate2(Val(w:2))~") ")
sql.add(" ORDER BY S.Cliente, S.Cuenta, S.Especie, S.Cupon, S.EnteCustodia, S.Mercado ")

