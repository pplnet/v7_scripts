

      SQL.ADD("Update "~DBO~". OPERACIONESBITS")
      SQL.ADD("Set ")
      SQL.ADD(" Valor='1' ")
      SQL.ADD("where NrBit=50 and ")
      SQL.ADD(" NrOperacion in (select NrOperacion from OPERACIONES where Vehiculo1='REFISAN') ")
      SQL.ADD(" and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=20) ")
      SQL.NEW      
      SQL.EXEC

      SQL.ADD("Update "~DBO~". OPERACIONESBITS")
      SQL.ADD("set Valor='0' ")
      SQL.ADD(" where NrBit=20 and NrOperacion in (select NrOperacion from OPERACIONES where Vehiculo1='REFISAN') ")
      SQL.ADD("and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=20) ")
      SQL.ADD("and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=50) ")
      SQL.NEW      
      SQL.EXEC



*update OPERACIONESBITS set Valor='1' where NrBit=50 and NrOperacion in (select NrOperacion from OPERACIONES where Vehiculo1='REFISAN') and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=20)
*update OPERACIONESBITS set Valor='0' where NrBit=20 and NrOperacion in (select NrOperacion from OPERACIONES where Vehiculo1='REFISAN') and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=20) and NrOperacion in (select NrOperacion from OPERACIONESBITS where Valor='1' and NrBit=50)
