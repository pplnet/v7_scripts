creardialogo
check1: 'Procesa';1;2;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif

Acn(x:2, dialogo.check1)

Message('Eliminando operaciones anuladas')
ejecutarevento('ANUOPE')

Message('    - Iniciando Evento Auxiliar Titulos MAE')
ejecutarevento('AUXMAE', check1 = Val(x2))

Message('    - Iniciando Evento Auxiliar Ordenes MAE')
ejecutarevento('AUXORD', check1 = Val(x2))

Message('    - Iniciando Evento Emision de Boletos')
ejecutarevento('EMIBOL')

Message('    - Iniciando Evento Envia a Sistema Externo')
ejecutarevento('INFSIS')

Message('    - Iniciando Evento Generacion de patas de pase')
ejecutarevento('GENTIP', check1 = Val(x2))


Message('    - Iniciando Evento Generacion de Pases por Oferta')
ejecutarevento('GENPAS', check1 = Val(x2))

Message('    - Iniciando Evento Generacion de Op Titulos por Oferta')
ejecutarevento('GENTIT', check1 = Val(x2))
Message('    - Iniciando Evento Generacion de Op Titulos por Migracion Rueda TRD')
ejecutarevento('GENTA3', fecha1 = FSys(), check1 = Val(x2))
Message('    - Iniciando Evento Informar Operaciones por Migracion Rueda TRD')
ejecutarevento('INFA3R', check1 = Val(x2))

Message('    - Iniciando Evento Generacion de Adjudicaciones por Oferta')
ejecutarevento('GENADJ', check1 = Val(x2))

Message('    - Iniciando Generacion de Ops de Corretaje')
ejecutarevento('GENCOR', check1 = Val(x2))

Message('    - Iniciando Generacion de Ops por Ejecuciones de Ofertas')
ejecutarevento('GENORD', check1 = Val(x2))
ejecutarevento('GENCA3', fecha1 = FSys(), check1 = Val(x2))

Message('    - Libera Op. no encontradas CPC1')
ejecutarevento('GENOR2', check1 = Val(x2))

Message('    - Iniciando Evento Baja Operacion x oferta')
ejecutarevento('BAJOFE', check1 = Val(x2))

Message('    - Iniciando Generacion de plazos de ROFEX')
ejecutarevento('RFXCOT', fecha1 = FSys(), label1 = '')
Message('    - Iniciando Generacion de Ops de ROFEX')
ejecutarevento('GENRFX', fecha1 = FSys(), check1 = Val(x2))

Message('    - Iniciando Generacion de Ops de Sistema Externo 1')
ejecutarevento('GENEX1', fecha1 = FSys(), check1 = Val(x2))

Message('    - Iniciando Desbloqueo Cuentas Por Orden')
ejecutarevento('DBLKOR', nrorden1 = '')

Message('    - Iniciando Evento Generacion de Op FX por Oferta')
ejecutarevento('GENFXO', check1 = Val(x2))

Message('    - Iniciando Evento Generacion de Op OCT por Oferta')
ejecutarevento('GENOCT', fecha1 = FSys(), check1 = Val(x2))

Message('    - Iniciando Evento Generacion de Op FX Canje por Oferta')
ejecutarevento('GENFXJ', check1 = Val(x2))


