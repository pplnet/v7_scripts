Act(vh:1, SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

creardialogo
fecha1:'F.Conciliacion';1;1;;;;dialogo.fecha1 <= FSys();'Fecha Incorrecta';NO;FSys()
lista1:'Vehiculos';3;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), Val(vh: 1))
lista2:'CtasMadres';;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Codigo IN (SELECT CtaPrincipal FROM "~Dbo()~".CUENTAS)  "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~")"))~" ");
lista3:'CtasPag/Rec/Int';-2;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE (Pagadora='SI' OR TipoCuenta IN ('REC','INT') ) "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~")"))~" "~iif (NoVacio(dialogo.lista2), " AND CtaPrincipal IN ("~Pipe2Comillas(dialogo.lista2)~")")~" ");
check4:'Confirma';1;2;;NO;NO;;;;1
findialogo

if (not ok)
Cancelar()
endif


Sqladd(" SELECT /*+ RULE */ EX.MNrDatanet, EX.MNrMovDatanet, M.Banco, M.Cuenta, M.Moneda, M.Importe, ")
Sqladd(" M.DC, M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, EX.Operador,  ")
Sqladd(" EX.HNrDatanet, EX.HNrMovDatanet, MH.Banco BancoH, MH.Cuenta CuentaH, MH.Moneda MonedaH, Mh.Importe ImporteH, ")
Sqladd(" MH.DC DCH, MH.FechaIngreso FechaIngresoH, MH.FechaAcreditacion FechaAcreditacionH, MH.TipoMov TipoMovH, MH.Comprobante ComprobanteH ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".CUENTAS C, "~Dbo()~".CUENTAS C2, ")
Sqladd(" "~Dbo()~".EXTRACTOS EX, "~Dbo()~".MOVDATANET MH ")
Sqladd(" WHERE  M.NrDatanet     = EX.MNrDatanet ")
Sqladd(" AND    M.NrMovDatanet  = EX.MNrMovDatanet ")
Sqladd(" AND    MH.NrDatanet    = EX.HNrDatanet ")
Sqladd(" AND    MH.NrMovDatanet = EX.HNrMovDatanet ")
Sqladd(" AND    M.Cuenta        = C.Numero   (+) ")
Sqladd(" AND    MH.Cuenta       = C2.Numero  (+) ")
Sqladd(" AND    EX.Fecha        = "~IdxDate2(dialogo.fecha1)~" ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND M.Vehiculo  IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND C.Codigo  IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
Sqladd(" AND C2.CtaPrincipal IN ("~Pipe2Comillas(dialogo.lista2)~")  ")
else
Sqladd(" AND C.Codigo  IN (SELECT CtaPrincipal FROM "~Dbo()~".CUENTAS) ")
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND C2.Codigo  IN ("~Pipe2Comillas(dialogo.lista3)~")    ")
else
Sqladd(" AND (C2.TipoCuenta IN ('INT','REC') OR C2.Pagadora='SI') ")
endif
Sqladd(" ORDER By EX.MNrDatanet, EX.MNrMovDatanet ")

Acn(bz:1, 0)

recorrer sql
Act(a:fac, Fbn('MNrDatanet'))
Acn(b:fac, Fbn('MNrMovDatanet'))
