Act(ae:fac, Fbn('CuentaH'))
Act(af:fac, Fbn('MonedaH'))
Acn(ag:fac, Fbn('ImporteH'))
Act(ah:fac, Fbn('DCH'))
Acd(ai:fac, Fbn('FechaIngresoH'))
Acd(aj:fac, Fbn('FechaAcreditacionH'))
Act(ak:fac, Fbn('TipoMovH'))
Act(al:fac, Fbn('ComprobanteH'))
Act(am:fac, Fbn('Operador'))
