Endif

************ELIMINO LA OP DE LA TABLA OPERACIONES (POR TRIGGER SE ELIMINARÁ TAMBIEN DE LAS TABLAS CUOTAS Y OPERACIONESBITS)
SQL.ADD("DELETE From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"'")
SQL.NEW
SQL.EXEC

********Ajusto Check 'Renovada' y OperacionRef en la OP original
SQL.ADD("UPDATE "~DBO~".OPERACIONES Set CB8='0', OperacionRef=null Where OperacionRef='"~Dialogo.NrOperacion1~"'")
SQL.NEW
SQL.EXEC


