CrearDialogo
    NrOperacion1:  'NrOperacion'   ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMCPM') y BuscarCampo('OPERACIONES','CB9','NrOperacion',Dialogo.NrOperacion1)=1 ;'La operacion debe ser una renovacion y de tipo MMCPM';NO;;;;;;"TipoOp='MMCPM' and CB9='1'"
FinDialogo

If Not Ok
    Cancelar
Endif
   
If QUERY("Select 1 from "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrSaldo=1")=1
    Cancelar ('La operacion seleccionada se encuentra liquidada. Desliquidela e intente nuevamente')
Endif

*************************************************************SQL************************************************************************************
SQL.ADD("Select O.Vehiculo1,O.Book1,O.Cliente1,O.Cuenta1,O.FechaOp,O.Plazo,O.FechaVto,O.Cantidad,O.Precio1 as 'TasaInt',O.ImpGastos1 as 'TasaRet',")
SQL.ADD("C.Cantidad3 as 'Intereses',C.Cantidad4 as 'Retenciones'")
SQL.ADD("From "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS C  ON O.NrOperacion = C.NrOperacion ")
SQL.ADD("Where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SetFilaActual(1)

ACT(A:fac,Dialogo.NrOperacion1)
dfa
Recorrer SQL
    ACT(B:fac,fbn['Vehiculo1'])
    ACT(C:fac,fbn['Book1'])
    ACT(D:fac,fbn['Cliente1'])
    ACT(E:fac,fbn['Cuenta1'])
    ACD(F:fac,fbn['FechaOp'])
    ACN(G:fac,fbn['Plazo'])
    ACD(H:fac,fbn['FechaVto'])
    ACN(I:fac,fbn['TasaInt'])
    ACN(J:fac,fbn['Intereses'])
    ACN(K:fac,fbn['TasaRet'])
    ACN(L:fac,fbn['Retenciones'])
