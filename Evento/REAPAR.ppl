ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1  : 'Fecha'   ; ; ; ;  ;  ;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys;'Fecha incorrecta';NO;Habiles(FSys,0,'ARG');
  Especie1: 'Especie' ; ; ; ;  ;  ;
  Check1  : 'Procesa' ;4;1;1;NO;NO;;;;1
  Check2  : 'Cierre'  ;4;1;1;NO;NO;;;;0
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0 o SI
  HojaVisible(SI)
endif

ACT(z:1, Hora(Ahora))
ACN(v:2, 1)
ACN(w:2, 1)
 
SetFilaActual(1)

ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'TipoTr')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Fecha1')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Ciente')
ACT(g:FAC, 'Vehiculo')
ACT(h:FAC, 'ParkAfecta')
ACT(i:FAC, 'De Local')
ACT(j:FAC, 'A Exterior')
ACT(k:FAC, 'Recalculo')
ACT(l:FAC, 'Boora')
ACT(m:FAC, 'Control')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Desde Li')
ACT(ac:FAC, 'Cant DRT')
ACT(ad:FAC, 'Hasta Li')
ACT(ae:FAC, 'Observ')
ACT(af:FAC, 'Cant TIV')
ACT(ag:FAC, 'TIV desde')
ACT(ah:FAC, 'TIV hasta')

ACT(al:FAC, 'Lin. Esp.')
ACT(am:FAC, 'NrOper')
ACT(an:FAC, 'TipoOp')
ACT(ao:FAC, 'Especie')
ACT(ap:FAC, 'FechaOp')
ACT(aq:FAC, 'Cantidad')
ACT(ar:FAC, 'Ciente')
ACT(as:FAC, 'Vehiculo')
ACT(at:FAC, 'ParkAfecta')
ACT(au:FAC, 'Boora')
ACT(av:FAC, 'Control')

ACT(ba:FAC, 'Merc.Orig.')
ACT(bb:FAC, 'Cta.Orig.')
ACT(bc:FAC, 'Clie.Orig.')
ACT(bd:FAC, 'Mon.Orig.')
ACT(be:FAC, 'TipoDol.Orig.')
ACT(bf:FAC, 'Mer.Par.Orig.')
ACT(bg:FAC, 'NrSaldo Orig')
ACT(bh:FAC, 'Leyenda Orig')
  
ACT(bn:FAC, 'Merc.Des.')
ACT(bo:FAC, 'Cta.Des.')
ACT(bp:FAC, 'Clie.Des.')
ACT(bq:FAC, 'Mon.Des.')
ACT(br:FAC, 'TipoDol.Des.')
ACT(bs:FAC, 'Mer.Par.Des.')
ACT(bt:FAC, 'NrSaldo Des')
ACT(bu:FAC, 'Leyenda Des')

SetFont(a:FAC..bz:FAC,2)

SQL.ADD("SELECT * from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" where TipoTr2 in ('DRT') ")
SQL.ADD("   and Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Especie1)
  SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD("   and IsNull(ParkAfecta,'NO') = 'SI' ")
SQL.ADD("order by Especie,NrTrans ")
Recorrer SQL
  SCN(x:1, 1)
  if Not EqStr(fbn('Especie'),Val(v:1))
    * Es una especie Nueva
    if Val(v:2)>1
      ACN(ad:Val(v:2), FAC)
      ACT(ae:Val(v:2), 'Cambio Esp')
      * No es la primera especie
      *Cierre de Especie Anterior
    endif
    
    SCN(v:2,1)
    ACT(aa:Val(v:2), fbn('Especie'))
    ACN(ab:Val(v:2), FAC)
    SCN(ac:Val(v:2), 1)
  else
    * Es la misma especie
    SCN(bc:Val(v:2), 1)
  endif
  ACT(a:FAC, fbn('NrTrans'))
  ACT(b:FAC, fbn('TipoTr2'))
  ACT(c:FAC, fbn('Especie'))
  ACD(d:FAC, fbn('Fecha1'))
  ACN(e:FAC, fbn('Cantidad1'))
  ACT(f:FAC, fbn('Cliente1'))
  ACT(g:FAC, fbn('Vehiculo1'))
  ACT(h:FAC, fbn('ParkAfecta'))

  * Origen
  if Not Incluido(fbn('Mercado2'),Var('MERPAREXT'))
    ACT(i:FAC, 'SI')
  endif
  * Destino
  if Incluido(fbn('Mercado1'),Var('MERPAREXT'))
    ACT(j:FAC, 'SI')
  endif
    
  * Origen
  ACT(ba:FAC, fbn('Mercado2'))
  ACT(bb:FAC, fbn('Cuenta2'))
  ACT(bc:FAC, fbn('Cliente2'))
  if Incluido(fbn('Mercado2'),Var('MERPAREXT'))
    ACT(bd:FAC, 'USD')
    ACT(be:FAC, 'CAB')
    ACT(bf:FAC, 'EXT')
    ACN(bg:FAC, 133)
    ACT(bh:FAC, 'DRT de Exterior')
  else
    ACT(bd:FAC, 'ARP')
    ACT(be:FAC, '')
    ACT(bf:FAC, 'ARG')
    ACN(bg:FAC, 131)
    ACT(bh:FAC, 'DRT de Local Market')
  endif

  * Destino
  ACT(bn:FAC, fbn('Mercado1'))
  ACT(bo:FAC, fbn('Cuenta1'))
  ACT(bp:FAC, fbn('Cliente1'))
  if Incluido(fbn('Mercado1'),Var('MERPAREXT'))
    ACT(bq:FAC, 'USD')
    ACT(br:FAC, 'CAB')
    ACT(bs:FAC, 'EXT')
    ACN(bt:FAC, 133)
    ACT(bu:FAC, 'DRT a Exterior')
  else
    ACT(bq:FAC, 'ARP')
    ACT(br:FAC, '')
    ACT(bs:FAC, 'ARG')
    ACN(bt:FAC, 131)
    ACT(bu:FAC, 'DRT a Local Market')
  endif
  if EqStr(Val(i:FAC),'SI') y EqStr(Val(j:FAC),'SI')
    ACT(k:FAC, 'SI')
  endif
proximo
if Val(v:2)>1
  * Al menos 1 Especie
  ACN(ad:Val(v:2), FAC)
  ACT(ae:Val(v:2), 'Ultima Esp')
  * Busco TIV del DIA
  SQL.ADD("SELECT O.* from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
  SQL.ADD(" where TipoOp in ('TIV') ")
  SQL.ADD("   and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and Especie = '"~Val(aa:Val(v:2))~"' ")
*  SQL.ADD("   and IsNull(ParkAfecta,'NO') = 'SI' ")
  SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
  SQL.ADD("   and (OB.NrBit Not in (30,31) and OB.Valor=1)")
  SQL.ADD("order by O.NrOperacion ")
  Recorrer SQL
    DFA
    SCN(w:1, 1)
    SCN(w:2, 1)
    SCN(af:Val(v:2), 1)
    if Val(af:Val(v:2))=1
      * Si es la primera Op de la especie guardo la linea
      ACN(ag:Val(v:2), Val(w:2))
    endif
    ACN(al:Val(w:2), Val(v:2))
    ACT(am:Val(w:2), fbn('NrOperacion'))
    ACT(an:Val(w:2), fbn('TipoOp'))
    ACT(ao:Val(w:2), fbn('Especie'))
    ACD(ap:Val(w:2), fbn('FechaOp'))
    ACN(aq:Val(w:2), fbn('Cantidad'))
    ACT(ar:Val(w:2), fbn('Cliente1'))
    ACT(as:Val(w:2), fbn('Vehiculo1'))
    ACT(at:Val(w:2), fbn('ParkAfecta'))
  proximo
  if Val(af:Val(v:2))>0
    * Hay alguna TIV para la especie
    ACN(ah:Val(v:2), Val(w:2))
  endif
  **********************************************
  ** Borro los movimietnos de afectacion Parking
  **********************************************
  ** recorro las DRT de la especie
  Recorrer&i Val(ab:Val(v:2)),Val(ad:Val(v:2))
    ACT(l:&i, 'SI - Ult')
    if Dialogo.Check1=1
      * Borra los movimientos de Parking
      SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" where NrOperacion='"~Val(a:&i)~"' ")
      SQL.ADD("   and NrSaldo>130 ")
      SQL.ADD("   and NrSaldo<140 ")
      SQL.NEW
      SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" where NrOperacion='"~Val(a:&i)~"' ")
      SQL.ADD("   and NrSaldo>130 ")
      SQL.ADD("   and NrSaldo<140 ")
      SQL.NEW
      SQL.EXEC
      ACT(n:&i, 'SI - Ult')
    endif
  proximo
  ** recorro las TIV de la especie
  if Val(af:Val(v:2))>0
    Recorrer&i Val(ag:Val(v:2)),Val(ah:Val(v:2))
      ACT(au:&i, 'SI - Ult')
      if Dialogo.Check1=1
        * Borra los movimientos de Parking
        SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
        SQL.ADD(" where NrOperacion='"~Val(am:&i)~"' ")
        SQL.ADD("   and NrSaldo>130 ")
        SQL.ADD("   and NrSaldo<140 ")
        SQL.NEW
        SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" where NrOperacion='"~Val(am:&i)~"' ")
        SQL.ADD("   and NrSaldo>130 ")
        SQL.ADD("   and NrSaldo<140 ")
        SQL.NEW
        SQL.EXEC
      endif
    proximo
  endif
  **********************************************
  ** Regenero la afectacion Parking
  **********************************************
  ** recorro las DRT de la especie
  Recorrer&i Val(ab:Val(v:2)),Val(ad:Val(v:2))
    ACT(m:&i, 'SI - Ult')
    if Dialogo.Check1=1
      EjecutarEvento('CONPAR',Radio1=1,NrOperacion1='',NrTrans1=Val(a:&i),Check1=Dialogo.Check1,Check2=0,Check3=1)
    endif
  proximo
  ** recorro las TIV de la especie
  if Val(af:Val(v:2))>0
    Recorrer&i Val(ag:Val(v:2)),Val(ah:Val(v:2))
      ACT(av:&i, 'SI - Ult')
      if Dialogo.Check1=1
        EjecutarEvento('CONPAR',Radio1=0,NrOperacion1=Val(am:&i),NrTrans1='',Check1=Dialogo.Check1,Check2=0,Check3=1)
      endif
    proximo
  endif
endif

if Val(x:1)>0
  * Al menos 1 DRT
  FormatoCeldas(e:2..e:Val(x:1)+1,Exe('F2'))
else
  if Dialogo.Check2=0
    MessageBox('No hay DRT que utilicen parking.')
  else
    Message('No hay DRT que utilicen parking.')
  endif
endif

ACO(5, 8)
* bb
ACO(54, 8)
* be
ACO(57, 8)
ACO(58, 8)
ACO(59, 8)
ACO(60, 12)
* bo
ACO(67, 8)
* br
ACO(70, 8)
ACO(71, 8)
ACO(72, 8)
ACO(73, 12)
