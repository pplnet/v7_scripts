modoreproceso(sindialogo)
creardialogo
fecha1:'Fecha ';;;;;;dialogo.fecha1 <> 0;'Debe Ingresar una Fecha';NO;FSys()
findialogo

if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Acn(x1, 0)

sql.add(" SELECT *                   ")
sql.add(" FROM   "~Dbo()~".OPERACIONES ")
sql.add(" WHERE  FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("        and TipoOp = 'PARTID'  ")
sql.add("        and TotalNetoCli1 >0 ")
sql.add(" ORDER BY NrOperacion  ")

recorrer sql
Act(a:fac, Fbn('NrOperacion'))
Acd(b:fac, Fbn('FechaOp'))
Acd(c:fac, Fbn('FechaVto'))
Act(d:fac, Fbn('Especie'))
Acn(e:fac, Fbn('Cantidad'))
Acn(f:fac, Fbn('Precio1'))
Acn(g:fac, Fbn('TipoCambio'))
Acn(h:fac, Fbn('RB8'))
Acn(i:fac, Fbn('TotalNetoCli1'))
Acn(n:fac, Fbn('TotalBrutoCli1'))
Acn(r:fac, Fbn('Cartera'))
Act(s:fac, Fbn('Book1'))
Acn(l:fac, 0)
Acn(p:fac, 0)
Acn(nt:fac, tirespecie(Fbn('Especie'), dialogo.fecha1, Fbn('Precio1')))
Scn(x1, 1)
proximo

if (Val(x1) > 0)
crearlistbox;'Arial,8,'
'Marca';l1..l:fac;SI;SI;;30;check;exe('COLOR9')
'Partida';a1..a:fac;NO;;;70;string;;exe('COLOR10')
'Book   ';s1..s:fac;NO;;;70;string;;exe('COLOR10')
'Tipo';h1..h:fac;NO;;;80;combo;'Compra|Venta';exe('COLOR10')
'Especie';d1..d:fac;NO;;;50;tabla;'Especies';'Codigo';'Codigo;Nombre';;exe('COLOR10')
'Cantidad';e1..e:fac;NO;;;90;numero;'##,###,###.##';exe('COLOR10')
'Precio ';f1..f:fac;NO;;;80;numero;'##,###.#######';exe('COLOR10')
'TIR';g1..g:fac;NO;;;80;numero;'##,###.#######';exe('COLOR10')
'Nueva TIR';nt1..nt:fac;SI;Val(nt:flb) <> 0;'La TIR debe ser distinta a cero';80;numero;'##,###.########';exe('COLOR7')
'Fecha ';b1..b:fac;NO;;;70;fecha;exe('COLOR10')
finlistbox

if (ok)
recorrer&i 1, Fac()
if (Val(l:&i) = 1)
if (Val(nt:&i) <> Val(g:&i)) y (Val(nt:&i) <> 0)
sql.add("UPDATE "~Dbo()~".OPERACIONES ")
sql.add("SET TipoCambio = "~FStr(Val(nt:&i), 0, 8)~" ")
sql.add("WHERE NrOperacion = '"~Val(a:&i)~"' ")
sql.new
sql.exec
endif
endif
proximo
else
Cancelar()
endif
else
Messagebox('No hay partidas para el '~dialogo.fecha1)
endif

