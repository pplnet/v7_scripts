mostrarcuadrodemensajes
creardialogo
radio1:'Desmarca |Asiento|Contrasiento';;;;;;;;;;0
nrunicoasiento1: 'Numero';;;;;;;;;;;;;;iif (dialogo.radio1 = 0, " Estado IN ('E')", " Estado IN ('COE')")
findialogo

if (not ok)
Cancelar()
endif
Acn(b:1, 0)

if (NoVacio(dialogo.nrunicoasiento1))
Acn(bd:1, 1)
sql.add(" Select  NrUnicoAsiento,NrOperacion, Estado  ")
sql.add(" From  "~Dbo()~".ASIENTOSCON ")
sql.add(" Where NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' AND ")
if (dialogo.radio1 = 0)
sql.add("   Estado = 'E'  ")
else
sql.add("   Estado = 'COE'  ")
endif
sql.add(" order by NrUnicoAsiento ")
recorrer sql
Acn(bd:1, 0)
if (Eqstr(Fbn('Estado'), 'COE'))
Act(a:fac, 'COT')
else
Act(a:fac, Fbn('Estado'))
endif
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
if (Eqstr(Fbn('Estado'), 'E'))
sql.add(" Set Estado = Null ")
else
sql.add(" Set Estado = '"~Val(a:fac)~"' ")
endif
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.exec
proximo
if (Val(bd:1) = 0)
Messagebox('Asiento '~dialogo.nrunicoasiento1~' esta Desmarcado')
else
Messagebox('El Asiento '~dialogo.nrunicoasiento1~' No Fue Enviado')
endif
else
sql.add(" Select  NrUnicoAsiento,NrOperacion, Estado  ")
sql.add(" From  "~Dbo()~".ASIENTOSCON ")
sql.add(" Where  ")
if (dialogo.radio1 = 0)
sql.add("   Estado = 'E'  ")
else
sql.add("  Estado = 'COE' ")
endif
sql.add(" order by NrUnicoAsiento ")
recorrer sql
if (Eqstr(Fbn('Estado'), 'COE'))
Act(a:fac, 'COT')
endif
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
if (dialogo.radio1 = 0)
sql.add(" Set Estado = Null ")
else
sql.add(" Set Estado = '"~Val(a:fac)~"' ")
endif
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.exec
Message('Modificacion Total:   Asiento: '~Fbn('NrUnicoAsiento')~'ESTADO: '~Fbn('Estado'))
Scn(b:1, 1)
proximo
Messagebox('Se Modificaron  '~Val(b:1)~' Asientos')
endif
