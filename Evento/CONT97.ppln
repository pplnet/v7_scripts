MostrarCuadroDeMensajes()
creardialogo
radio1:'Desmarca |Asiento|Contrasiento';;;;;;;;;;0
nrunicoasiento1: 'Numero';;;;;;;;;;;;;;iif (dialogo.radio1 = 0, " Estado IN ('E')", " Estado IN ('COE')")
findialogo

if (not ok)
Cancelar()
endif
Acn(b:1, 0)

if (NoVacio(dialogo.nrunicoasiento1))
Acn(bd:1, 1)
Sqladd(" Select  NrUnicoAsiento,NrOperacion, Estado  ")
Sqladd(" From  "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' AND ")
if (dialogo.radio1 = 0)
Sqladd("   Estado = 'E'  ")
else
Sqladd("   Estado = 'COE'  ")
endif
Sqladd(" order by NrUnicoAsiento ")
recorrer sql
Acn(bd:1, 0)
if (Eqstr(Fbn('Estado'), 'COE'))
Act(a:fac, 'COT')
else
Act(a:fac, Fbn('Estado'))
endif
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
if (Eqstr(Fbn('Estado'), 'E'))
Sqladd(" Set Estado = Null ")
else
Sqladd(" Set Estado = '"~Val(a:fac)~"' ")
endif
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
proximo
if (Val(bd:1) = 0)
Messagebox('Asiento '~dialogo.nrunicoasiento1~' esta Desmarcado')
else
Messagebox('El Asiento '~dialogo.nrunicoasiento1~' No Fue Enviado')
endif
else
Sqladd(" Select  NrUnicoAsiento,NrOperacion, Estado  ")
Sqladd(" From  "~Dbo()~".ASIENTOSCON ")
Sqladd(" Where  ")
if (dialogo.radio1 = 0)
Sqladd("   Estado = 'E'  ")
else
Sqladd("  Estado = 'COE' ")
endif
Sqladd(" order by NrUnicoAsiento ")
recorrer sql
if (Eqstr(Fbn('Estado'), 'COE'))
Act(a:fac, 'COT')
endif
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
if (dialogo.radio1 = 0)
Sqladd(" Set Estado = Null ")
else
Sqladd(" Set Estado = '"~Val(a:fac)~"' ")
endif
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
Message('Modificacion Total:   Asiento: '~Fbn('NrUnicoAsiento')~'ESTADO: '~Fbn('Estado'))
Scn(b:1, 1)
proximo
Messagebox('Se Modificaron  '~Val(b:1)~' Asientos')
endif
