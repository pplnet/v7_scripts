creardialogo
fecha1:'Fecha Saldo';;;;;;dialogo.fecha1 <> 0;'Fecha Incorrecta';NO;FSys();
findialogo

if (not ok)
Cancelar()
endif

Sqladd("SELECT S1.Especie as Esp, E.Nombre as NombreEspecie,SUM(S1.Saldo) as Saldo")
Sqladd("FROM "~Dbo()~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK)")
Sqladd("           ON S1.Cliente = C.Codigo ")
Sqladd("     INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ")
Sqladd("           ON E.Codigo = S1.Especie ")
Sqladd("     INNER JOIN "~Dbo()~".CUENTAS CU WITH (NOLOCK) ")
Sqladd("           ON CU.Codigo = S1.Cuenta ")
Sqladd("     INNER JOIN "~Dbo()~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
Sqladd("           ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
Sqladd("WHERE S1.EnteCustodia = '"~Var('VEHICULODE')~"' AND ")
Sqladd("      ISNULL(S1.Cliente,'') =ISNULL(S1.EnteCustodia,'') AND")
Sqladd("      S1.Especie IN (select E.Codigo from  "~Dbo()~".ESPECIES E where E.FechaInicioTenencia IS NOT NULL AND S1.Especie = E.Codigo) AND ")
Sqladd("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
Sqladd("                  FROM "~Dbo()~".SALDOSDIA S2 WITH (NOLOCK) ")
Sqladd("                  WHERE ISNULL(S2.Cliente,'') = ISNULL(S1.Cliente,'') AND ")
Sqladd("                        ISNULL(S2.Especie,'') = ISNULL(S1.Especie,'') AND")
Sqladd("                        ISNULL(S2.Cupon,'') = ISNULL(S1.Cupon,'') AND")
Sqladd("                        ISNULL(S2.EnteCustodia,'') = ISNULL(S1.EnteCustodia,'') AND")
Sqladd("                        ISNULL(S2.Mercado,'') = ISNULL(S1.Mercado,'') AND")
Sqladd("                        ISNULL(S2.NrSaldo,'') = ISNULL(S1.NrSaldo,'') AND")
Sqladd("                        ISNULL(S2.Cuenta,'') = ISNULL(S1.Cuenta,'') AND")
Sqladd("                        ISNULL(S2.Book,'') =ISNULL(S1.Book,'') AND")
Sqladd("                        ISNULL(S2.CallPut,'') =ISNULL(S1.CallPut,'') AND")
Sqladd("                        S2.Fecha <= '"~IdxDate(dialogo.fecha1)~"' ) ")
Sqladd("GROUP BY S1.Especie, E.Nombre ")

recorrer sql
Act(a:fac, Fbn()["Esp"])
Act(b:fac, Fbn()["NombreEspecie"])
Acn(c:fac, Fbn()["Saldo"])
if (Round(Val(c:fac), 2) = Round(0, 2))
Sqladd("UPDATE "~Dbo()~".ESPECIES SET FechaInicioTenencia = NULL WHERE Codigo = '"~Fbn()['Esp']~"'")
Sqlnew()
Sqlexec()
endif
proximo






