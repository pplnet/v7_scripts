HojaVisible(SI)
CrearDialogo
  Fecha1 :'Fecha';;;;;;;;;FSys
FinDialogo

if not Ok
  Cancelar
endif

*ImportarWKS(a2..az50, a2..az50, 'C:\PM\PRESUPUE.WKS')
*ImportarWKS(a2..az50, a2..az50, Var('NOMPRESUP'))
ACT(b1, Var('NOMPRESUP'))
messagebox(val(b1))
ImportarWKS(a2..az50, a2..az50, Val(b1))
CrearFont(1, 'Arial,8,B')
SetFont(a1..az50, 1)

** Ojo. Claudia 30.12.98
* SQL.ADD("and FechaOp2 = '"~IdxDate(Dialogo.Fecha1)~"'")
*

SQL.ADD("Delete from "~DBO~".OPERACIONES where")
SQL.ADD("TipoOp = 'AJUSCF' ")

SQL.NEW

recorrer&i 3, 50
  if NoVacio(Val(a:&i)) 
    if SQL("Select Count(*) from "~DBO~".VEHICULOS where Codigo='"~Val(a:&i)~"'")=1
      recorrer&j 2, 70 
        if Vacio(Val(&j:2))
          break
        endif
        if Val(&j:&i)<>0
          SQL.ADD("Insert into "~DBO~".OPERACIONES (")      
          SQL.ADD("Vehiculo1, Operador, Especie, ")
          SQL.ADD("FechaOp, FechaOp2, Cantidad,")
          SQL.ADD("TipoOp, NrOperacion, Cliente1 ")
          SQL.ADD(") Values (")
          SQL.ADD(" '"~Val(a:&i)~"', '"~UsuarioActivo~"', '"~VAR('MONELOCA')~"', ")
          SQL.ADD(" '"~IdxDate(Val(&j:2))~"', '"~IdxDate(Dialogo.Fecha1)~"', "~FStr(Val(&j:&i)*1000,1,2)~", ")
          ACT(y1, GetNumerador(2))
          SQL.ADD(" 'AJUSCF', '"~Val(y1)~"', '"~Val(a:&i)~"'")
          SQL.ADD(")")
          SQL.NEW

          * Generar Bits y poner en Terminal
          recorrer&k 1,50
            ACT(a1,FStr(&k,1,0))
            if Incluido(Val(a1),'1|5|6|10|11|20|50')
              SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
              SQL.ADD(" Values ('"~Val(y1)~"',"~Val(a1)~",'0') ")
              SQL.NEW
            endif
          proximo

          SQL.ADD("Update "~DBO~".OPERACIONESBITS SET Valor = '1' ")
          SQL.ADD("where  NrBit=50 and NrOperacion= '"~Val(y1)~"' ")
          SQL.NEW
          SQL.EXEC
        endif
      proximo

    else
      message('Vehiculo no hallado '~Val(a:&i))
    endif
  endif
proximo


