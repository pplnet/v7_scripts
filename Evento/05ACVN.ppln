MostrarCuadroDeMensajes()

creardialogo
fecha1:'Fecha Confir';;;;;;;;;FSys()
findialogo

if (not ok)
Cancelar()
endif

Message('Generando datos de confirmacion')
Sqladd("SELECT T.Cliente1, T.Mercado1, T.TipoTr2, T.Especie, T.Especie1,              ")
Sqladd("       T.Cantidad1, T.Cantidad2, T.NrTrans, T.Fecha2, T.Fecha1                ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS  OB                    ")
Sqladd("Where OB.NrOperacion = T.NrTrans                                              ")
Sqladd("  and T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"'                                ")
Sqladd("  and ( OB.NrBit in ('70') AND OB.Valor = 1 )                                 ")
Sqladd("  and T.CB9 = 1                                                               ")
Sqladd("  and T.TipoTr2 IN ('DEP','RET','COMP','MATCH')                               ")
Sqladd("  and T.Mercado1 not in("~Pipe2Comillas(Var('MERCAACMC'))~")                  ")
Sqladd("  Order By T.NrTrans                                                          ")


recorrer sql

Acn(ok1, 1)
Act(a:fac, Fbn()['Cliente1'])
Act(b:fac, Fbn()['Mercado1'])
Acn(l:fac, 0)

if (Eqstr(Fbn()['TipoTr2'], 'MATCH'))
Act(d:fac, 'Matcheo')
Act(e:fac, Fbn()['Especie']~'/'~Fbn()['Especie1'])
Acn(f:fac, -Fbn()['Cantidad1'])
Acn(g:fac, -Fbn()['Cantidad2'])

else
if (Incluido(Fbn()['TipoTr2'], 'DEP|RET'))
Act(e:fac, Fbn()['Especie'])
if (Eqstr(Fbn()['TipoTr2'], 'DEP'))
Act(d:fac, 'Cobro')
if (DesciendeDeEspecie(Fbn()['Especie'], 'TITULO'))
Acn(f:fac, Fbn()['Cantidad1'])
Acn(g:fac, 0)
else
Acn(f:fac, 0)
Acn(g:fac, Fbn()['Cantidad1'])
endif
else
Act(d:fac, 'Pago')
if (DesciendeDeEspecie(Fbn()['Especie'], 'TITULO'))
Acn(f:fac, -Fbn()['Cantidad1'])
Acn(g:fac, 0)
else
Acn(f:fac, 0)
Acn(g:fac, -Fbn()['Cantidad1'])
endif
endif
else
Act(d:fac, '   ')
endif
endif

Act(i:fac, Fbn()['NrTrans'])
Acd(j:fac, Fbn()['Fecha2'])
Acd(k:fac, Fbn()['Fecha1'])


proximo

if (Val(ok1) = 0)
Cancelar(' No existen Vouchers CONFIRMADOS para anular en esta Fecha ')
endif


crearlistbox;'Arial,8,';'Anulacion Manual de VOUCHERS CONFIRMADOS para la fecha '~dialogo.fecha1

'OK';l:1..l:fac;SI;;;40;check;
'Cliente ';a:1..a:fac;NO;;;80;string;;
'Mercado ';b:1..b:fac;NO;;;70;string;;
'        ';d:1..d:fac;NO;;;70;string;;
'Especie ';e:1..e:fac;NO;;;70;string;;
'Titulos ';f:1..f:fac;NO;;;100;numero;'###,###,###,###.##'
'Moneda  ';g:1..g:fac;NO;;;100;numero;'###,###,###,###.##'
'Voucher ';i:1..i:fac;NO;;;70;string;;
'Fecha ingreso ';k:1..k:fac;NO;;;80;fecha;;
'Fecha Cob/Pag ';j:1..j:fac;NO;;;80;fecha;;

finlistbox


if (not ok)
Cancelar()
endif

Message('Procesando datos')
recorrer&j 1, Fac()

if (Val(l:&j) = 1)
Message(' Anulando Voucher CONFIRMADO '~Val(i:&j))
Ejecutarevento('05ACVT', 'nrtrans1', Val(i:&j))
endif

proximo


