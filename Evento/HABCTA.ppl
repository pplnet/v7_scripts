HojaVisible(NO) 
MostrarCuadroDeMensajes

SQL.ADD("SELECT C.Cliente, C.Codigo, C.Nombre, C.Numero, C.Comitente ")
SQL.ADD("FROM "~DBO~".CUENTAS C ")
SQL.ADD("WHERE C.Estado = 'PEN' and C.TipoCuenta = 'CUS' ")
SQL.ADD("ORDER BY C.Codigo,C.Cliente ")
watch(SQL.Batch)
ACN(XX:1,0)

Recorrer SQL
    ACT(a:fac,fbn('Cliente'))
    ACT(b:fac,fbn('Codigo'))
    ACT(c:fac,fbn('Nombre'))
    ACN(XX:1,val(XX:1)+1)
Proximo

CrearListBox ; 'MS Sans Serif,8,';'Supervisión de cuentas comitente.'
   'OK'            ; f1..f:fac   ;SI;SI;; 30;CHECK ; RGB(251,253,181)
   'Numero Cuenta' ; b1..b:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Cuenta'        ; c1..c:fac   ;NO;SI;;200;STRING;;RGB(232,232,255); 
   'Cliente'       ; a1..a:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
FinListBox

if not ok
   Cancelar('Evento Cancelado.')
Endif

Recorrer&i 1, val(XX:1)
    IF val(f:&i) = 1
        message('Cuenta comitente '~val(b:&i)~' habilitada')
        SQL.ADD("UPDATE "~DBO~".CUENTAS SET Estado = 'HAB' WHERE Codigo = '"~val(b:&i)~"'")
        SQL.NEW
        SQL.EXEC
        message('Cliente '~val(a:&i)~' habilitada')
        SQL.ADD("UPDATE "~DBO~".CLIENTES SET Status = 'HAB' WHERE Codigo = '"~val(a:&i)~"'")
        SQL.NEW
        SQL.EXEC
        message('Cuentas monetarias para cliente '~val(a:&i)~' habilitadas')
        SQL.ADD("UPDATE "~DBO~".CUENTAS SET Estado = 'HAB' WHERE Cliente = '"~val(a:&i)~"' AND TipoCuenta <> 'CUS'")
        SQL.NEW
        SQL.EXEC
    ENDIF
Proximo

Cancelar('Evento Finalizado.')