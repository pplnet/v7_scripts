creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 < FSys();'Fecha Invalida';NO;FSys() - 1;
nroperacion1: 'Operacion';;;;;;;;;;;;;;"TipoOp in( 'FXCF', 'FXVF' )";
findialogo
if (not ok)
Cancelar()
endif

Sqladd("Select * from "~Dbo()~".OPERACIONES o inner join "~Dbo()~".OPERACIONESBITS ob on o.NrOperacion = ob.NrOperacion where ob.NrBit='10' and ob.Valor ='1' and FechaVto <= '"~IdxDate(dialogo.fecha1)~"' and TipoOp in( 'FXCF', 'FXVF' )")
Sqladd("AND not Exists (SELECT 1 FROM "~Dbo()~".MOVPENDIENTES mov WHERE mov.NrOperacion = o.NrOperacion)")
if (not Vacio(dialogo).nroperacion1)
Sqladd("And o.NrOperacion = '"~dialogo.nroperacion1~"'")
endif

recorrer sql
Acn(aa:1, 1)
Act(a:fac, Fbn('NrOperacion'))
Act(b:fac, Fbn('TipoOp'))
Acd(c:fac, Fbn('FechaOp'))
Acd(d:fac, Fbn('FechaVto'))
Acn(e:fac, 0)
Act(f:fac, Fbn('Cliente1'))
Act(g:fac, Fbn('Especie'))
Acn(h:fac, Fbn('Cantidad'))
Acn(i:fac, Fbn('TotalBrutoCli1'))
proximo
if (Val(aa:1) = 0)
Cancelar("No hay operaciones para modificar")
endif
crearlistbox;'MS Sans SerIf,8,'

'Marca';e:1..e:fac;SI;SI;;70;check;RGB(160, 160, 193);
'Numero Operacion';a:1..a:fac;NO;SI;;130;string;;RGB(232, 232, 255);
'TipoOp';b:1..b:fac;NO;SI;;50;string;;RGB(232, 232, 255);
'FechaOp';c:1..c:fac;NO;SI;;80;fecha;RGB(232, 232, 255);
'FechaVto';d:1..d:fac;NO;SI;;80;fecha;RGB(232, 232, 255);
'Cliente';f:1..f:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Especie';g:1..g:fac;NO;SI;;80;string;;RGB(232, 232, 255);
'Cantidad';h:1..h:fac;NO;SI;;80;numero;;RGB(232, 232, 255);
'Total';i:1..i:fac;NO;SI;;80;numero;;RGB(232, 232, 255);
finlistbox
recorrer&i 1, Fac()
if (Val(e:&i) = 1)
Ejecutarevento('CBOINS', 'string1', Val(a:&i), 'radio1', 0, 'radio2', 2, 'entero1', 0, 'entero2', 70)
endif
proximo
Messagebox("Operacion modificada correctamente")

