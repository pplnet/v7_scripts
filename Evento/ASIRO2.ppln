creardialogo
vehiculo1:'Vehiculo';;;;;;NoVacio(dialogo.vehiculo1);'Debe ingresar un vehiculo';NO;Var('VEHICULODE')
fecha1:'Fecha';;;;;;dialogo.fecha1 >= 0 o dialogo.fecha1 >= FSys();'Debe ingresar una Fecha valida';NO;FSys()
nrtrans1:'NrTrans';;;;;;NoVacio(dialogo.nrtrans1);'Debe Ingresar una Transaccion ';NO;
findialogo

if (not ok)
Cancelar()
endif

SetFilaActual(1)

Sqladd("Delete from "~Dbo()~".MOVLIMITES                  ")
Sqladd("Where Limite      = 'ACROFEX'                   ")
Sqladd("  AND NrOperacion = '"~dialogo.nrtrans1~"'      ")
Sqlnew()

Sqladd("SELECT Especie, Cliente, Cantidad               ")
Sqladd("FROM "~Dbo()~".MOVPENDIENTES                      ")
Sqladd("Where NrOperacion = '"~dialogo.nrtrans1~"'      ")
Sqladd("  and NrSaldo  = '"~Var('BLOQGROFEX')~"'        ")

recorrer sql
Acd(f1, dialogo.fecha1)
Acn(co:fac, CotizacionC(Fbn()['Especie'], null, null, null, Val(f1) - 1, 1, SI, 'ARP'))
Acn(ca:fac, Fbn()['Cantidad'] * Val(co:fac))


Sqladd("Insert into "~Dbo()~".MOVLIMITES (                                  ")
Sqladd("  FechaMov,    Cliente,   Limite,                                 ")
Sqladd("  Especie,     Monto,     NrOperacion,                            ")
Sqladd("  Descripcion, Bits,      Vehiculo, GrupoEspecie                  ")
Sqladd(") values (                                                        ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~Var('CLIROFEX')~"' , 'ACROFEX', ")
Sqladd(" 'ARP',  "~FStr(Val(ca:fac), 0, 2)~", '"~dialogo.nrtrans1~"',        ")
Sqladd(" ' Asistencia garantias ROFEX ',                                  ")

if (dialogo.fecha1 <= FSys())
Sqladd(" 'P', ")
else
Sqladd(" 'N', ")
endif

Sqladd(" '"~dialogo.vehiculo1~"' , '"~Fbn()['Especie']~"'                    ")
Sqladd(" )                                                                 ")
Sqlnew()

proximo


Sqlexec()









