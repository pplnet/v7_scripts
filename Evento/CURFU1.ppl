* HOJAVISIBLE(SI)

CrearDialogo
  String1  : 'Path'        ;;;;;;;;;VAR('DIRDEFAULT')
  String2  : 'Arch. Texto' ;;;;NO;;;;;;'CURVA.WKS';
FinDialogo

if not OK
  Cancelar
endif

If SQL("SELECT Count(*) FROM "~DBO~".CURVAFUTUROSCOMM ")>0
   Cancelar('La Tabla ya fue creada !!!')
EndIf

*-- Creacion Inicial de la Curva de Futuros
ImportarWKS(a4..b:1196,i19..j:1211,Dialogo.String1~Dialogo.String2)

If Vacio(val(a4))
   Cancelar('No se ha podido recuperar el archivo wks')
EndIf

SetFont(a:4..b:1196, 1)
FormatoCeldas(b:4..b:1196, Exe('F7'))

ACN(x1,0)
SetFilaActual(4)
SetFont(a:fac..c:fac, 1)

*-- Recorrer valores
Recorrer&i 1,1192

  SCN(z2,1)

  * Verifico si Existe el dia en la curva, sino lo creo
  SQL.ADD(" INSERT "~DBO~".CURVAFUTUROSCOMM ")
  SQL.ADD(" (Especie,Fecha,PrecioFut,PrecioCon) ")
  SQL.ADD(" Values ")
  SQL.ADD(" ('WTI','"~IdxDate(VAL(a:fac))~"',"~FStr(VAL(b:fac),0,7)~",0) ")
  SQL.NEW
  SQL.EXEC 
  Ifa
Proximo

ACO(1,10)
ACO(2,10)
ACO(3,10)

