proximo

SQL.ADD(" Select O.* from "~DBO~".OPSIOPEL O ")
SQL.ADD("  where O.CodigoNego   in ("~Pipe2Comillas(Var('TIPONEGOCT'))~") ")
SQL.ADD("    and O.CodigoRueda  in ("~Pipe2Comillas(Var('RUEOCT'))~")  ")
SQL.ADD("    and O.Fecha        = '"~IdxDate(+Dialogo.Fecha1)~"'           ")
SQL.ADD("    and O.Carga      is null  ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                            ")
*SQL.ADD("    and Secuencia2      = '22111412320100023' ")
*SQL.ADD("    and Secuencia2      = '24121113054400335' ")
SQL.ADD("  order by O.Secuencia2 ")
watch(SQL.BATCH())
Recorrer SQL
  Message('Sec2: '~fbn('Secuencia2'))
  ACT(a:FAC, fbn('Secuencia2'))
  ACT(b:FAC, fbn('CodigoRueda'))
  ACT(c:FAC, fbn('Cliente'))
  ACT(d:FAC, fbn('Fecha'))
  ACD(e:FAC, fbn('Fecha'))

  BorrarCeldas(t:1..t:100)
  ACN(z1, 0)
  ACN(z2, 0)
  ACN(z3, 0)
  ACT(t:18, fbn('CodigoNego'))
  ACT(t:20, Copy(Val(v3),1,12))
  ACN(t:21, 0)
  if Not Incluido(Val(t:18),Var('TIPONEGOCT'))
    SCN(z1,1)
    ACT(er:4,PAD('Problema con el Tipo Neg.',40))
    ACN((26+FAC):18, 1)
  endif
  if Incluido(Val(t:18),Var('TIPONEGOCT'))
    ***** TipoOp
    if EqStr(fbn('Agente'),Var('AGESIOP'))
      ACT(t:1,'FXVF')
      ACT(t:35, fbn('AgenteContra'))
    else
      if EqStr(fbn('AgenteContra'),Var('AGESIOP'))
        ACT(t:1,'FXCF')
        ACT(t:35, fbn('Agente'))
      else
        SCN(z1,1)
        ACT(er:4,PAD('Problema con el Tipo Op.',40))
        ACN((26+FAC):1, 1)
      endif
    endif
    ***** Especie
    ACT(t:19, fbn('CodigoTitulo'))
    ACT(t:2, SQL(" Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoCotizacion='O' AND TipoNegociacion='"~Val(t:18)~"' and EspecieOrigen='"~Val(t:19)~"' "))
    if Vacio(Val(t:2))
*      SCN(z1,1)
      ACN(t:86, 1)
      ACT(er:4,PAD('Problema con la Especie ',40))
      ACN((26+FAC):2, 1)
    endif
    ***** Cliente
    ACN(t:36, Num(Val(t:35)))
*    if Val(t:36)=0 o Val(t:36)=Var('AGESIOP')
*    endif
    if EqStr(Val(t:35),'000') o EqStr(Val(t:35),Var('AGESIOP'))
      SCN(z1,1)
      ACT(er:4,PAD('Problema con el Cliente',40))
      ACN((26+FAC):3, 1)
    else
      ***** Codigo Cliente
*      ACT(t:3, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = "~FStr(Val(t:36), 3, 0)))
      ACT(t:3, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:35)~"' "))
      ACT(t:25, Val(t:3))
      ***** Operador Contra
      ACT(t:4, fbn('OperadorContra'))
      if Vacio(Val(t:3))
        ACT(t:5, 'Cliente no existente en FPA. Nr MAE : '~Val(t:35))
      else
        ACT(t:87, SQL("Select Status From "~DBO~".CLIENTES Where Codigo = '"~Val(t:3)~"' "))
        if Not EqStr(Val(t:87),'HAB')
          ACN(t:86, 1)
          ACT(t:5, 'Cliente NO habilitado')
        endif
      endif
    endif
    ***** Mercado2
    if Incluido(fbn('EnteLiquidador'),'O')
      ACT(t:6, Var('MERCOCT'))
    else
*      SCN(z1,1)
      ACN(t:86, 1)
      ACT(er:4,PAD('Problema con el Mercado',40))
      ACN((26+FAC):6, 1)
    endif
    ***** Tabla Feriados
    if Incluido(fbn('EnteLiquidador'),'O')
      ACT(t:7, 'ARG')
    else
      SCN(z1,1)
      ACT(er:4,PAD('Problema con el Feriado',40))
      ACN((26+FAC):7, 1)
    endif
    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05')
      ACT(x1,fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACD(t:8, Fecha(Val(x1)))
    else
      SCN(z1,1)
      ACT(er:4,PAD('Problema con la Fecha Op.',40))
      ACN((26+FAC):8, 1)
    endif
    ***** Plazo
    if EqStr(Val(t:18),'O')
      * CodigoNego = O (OCT Dolar)
      ACN(t:9, Num(fbn('Plazo')))
    else
      SCN(z1,1)
      ACT(er:4,PAD('Problema con el Plazo',40))
      ACN((26+FAC):9, 1)
    endif
    ***** Fecha Vto
    if EqStr(Val(t:18),'O')
      * CodigoNego = O (OCT Dolar)
      ACD(t:10, Val(t:8)+Val(t:9))
    else
      SCN(z1,1)
      ACT(er:4,PAD('Problema con la Fecha Vto.',40))
      ACN((26+FAC):10, 1)
    endif
    ***** Metodo
*    if EqStr(fbn('TipoLiquidacion'),'C')
*      ACT(t:15, 'A')
*    else
*      ACT(t:15, fbn('TipoLiquidacion'))
*    endif
    ACT(t:15, fbn('TipoLiquidacion'))
    ***** ContraEspecie2
    ACT(t:16, SQL(" Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoCotizacion='F' and TipoNegociacion='"~Val(t:18)~"' and Metodo='"~Val(t:15)~"' and EspecieDestino1='"~Val(t:2)~"' "))
    if Vacio(Val(t:16))
      SCN(z1,1)
      ACT(er:4,PAD('Problema con la Especie Fixing',40))
      ACN((26+FAC):16, 1)
    endif
    ***** EnteCus1
    ACT(t:17, SQL(" Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoCotizacion='O' and TipoNegociacion='"~Val(t:18)~"' and EspecieOrigen='"~Val(t:19)~"' and EspecieDestino1='"~Val(t:2)~"' "))
    if Vacio(Val(t:17))
*      SCN(z1,1)
      ACT(er:4,PAD('Problema con la Especie para Tamanio Lote',40))
      ACN((26+FAC):17, 1)
    endif
    ***** Cant. Contratos
    ACN(t:89, fbn('Cantidad'))
    ***** Cantidad por Contrato
    ACN(t:90, BuscarCampo('ESPECIES','TamanioLote','Codigo',Val(t:17)))
    if Val(t:90)=0
      ACN(t:90, 1)
    endif
    ***** Cantidad
    ACN(t:11, Val(t:89)*Val(t:90))
    if Val(t:11)=0
      SCN(z1,1)
      ACT(er:4,PAD('Problema con la Cantidad',40))
      ACN((26+FAC):11, 1)
    endif
    ***** Precio1
    ACN(t:12, Round(fbn('Precio'),6))
    ACN(t:83, fbn('Precio'))
    ACN(t:84, Round(fbn('Precio'),7))
    ACN(t:85, Round(fbn('Precio'),8))
    if Val(t:12)=0
      SCN(z1,1)
      ACT(er:4,PAD('Problema con el Precio',40))
      ACN((26+FAC):12, 1)
    endif
    ***** TotalBrutoCli1
    ACN(t:13, Round(Val(t:11)*Val(t:12),2))
    ***** ContraEspecie
    if EqStr(fbn('Moneda'),'$')
      ACT(t:14, 'ARP')
    else
      SCN(z1,1)
      ACT(er:4,PAD('Problema con la ContraEspecie',40))
      ACN((26+FAC):14, 1)
    endif
    ***** Cuenta2
    ACT(t:34, CuentaCliente(VAR('VEHICULODE'),Val(t:14),,Val(t:6),Val(t:1)))
    ***** MB1
    if EqStr(fbn('TipoLiquidacion'),'E')
      * TipoLiquidacion = EMTA
      ACN(t:23, 0)
      ACT(t:24, 'EMTA')
      ACT(t:88, 'OCTEMTA')
    else
      if EqStr(fbn('TipoLiquidacion'),'C')
        * TipoLiquidacion = Com A-3500
        ACN(t:23, 1)
        ACT(t:24, 'Com A 3500')
        ACT(t:88, 'OCT3500')
      else
        ACN(t:23, 2)
        ACT(t:24, 'Otro')
        SCN(z1,1)
        ACT(er:4,PAD('Problema con el Fixing',40))
        ACN((26+FAC):23, 1)
      endif
    endif
    ***** Operador
    if Incluido(Val(t:1),'FXVF')
      ACT(t:26, fbn('OperadorContra'))
      ACT(t:27, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', fbn('Operador')))
    else
      if Incluido(Val(t:1),'FXCF')
        ACT(t:26, fbn('Operador'))
        ACT(t:27, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', fbn('OperadorContra')))
      endif
    endif
    if Vacio(Val(t:27))
      ACN(t:86, 1)
*      ACT(t:27, UsuarioActivo)
    endif
    ***** Vehiculo1
    ACT(t:28, Var('VEHICULODE'))
    if Vacio(Val(t:28))
      SCN(z1,1)
      ACT(er:4,PAD('Vehiculo invalido',40))
      ACN((26+FAC):28, 1)
    endif
    ***** Responsable1
    ACT(t:56, SQL("Select Alias1 from "~DBO~".USUARIOS where Codigo ='"~Val(t:27)~"'"))
    ***** Book1 (Ver Definicion)
    ACT(t:29, BookDefault(Val(t:28),Val(t:1),Val(t:56)))
*    ACT(t:29, SQL("Select Book from "~DBO~".VALIDACIONESBOOK where Vehiculo='"~Val(t:28)~"' and TipoOp='"~Val(t:1)~"' and Responsable='"~Val(t:56)~"' and Book like '"~Val(t:88)~"%' "))
    if Vacio(Val(t:29))
*      SCN(z1,1)
      ACT(er:4,PAD('Book no encontrado',40))
      ACN((26+FAC):29, 1)
    endif
    ***** FormaLiquidacion1
    ACN(t:30, 0)
    ***** Tipocambio
**** Error
*    ACN(t:31, (CotizacionFX('LIBRE','USD',FSYS,0,'SI',1,NO,'LOC')+CotizacionFX('LIBRE','USD',FSYS,0,'SI',2,NO,'LOC'))/2)
**********************
    ***** Rueda (UDN2)
    ACT(t:37, fbn('CodigoRueda'))
    ***** NroAltaMAE
    ACT(t:38, fbn('Secuencia'))

    ***** Mercado4
    ACT(t:58, Var('AMBOCT'))

    ***** ObsservacDOC
    **ACT(t:39, Copy(fbn('Mnemotecnico'),1,15))
**  FJL 13/01/2025 - para usar PLAZOSMERCADO como ROFEX
*    ACT(t:98, SQL("Select Variable From "~DBO~".PLAZOSOCT Where Fecha = '"~IdxDate(Val(t:10))~"' AND Especie = '"~Val(t:2)~"' AND TipoNegociacion = '"~Val(t:18)~"' "))
    ACT(t:98, Copy(fbn('Mnemotecnico'),1,20))
    ACT(t:39, Copy(Val(t:18),1,1)~Copy(Val(t:19),1,5)~Copy(Val(t:98),8,7)~fbn['Moneda']~fbn['Clase'])

    ACT(t:99, SQL("Select CodigoMercado from  "~DBO~".PLAZOSMERCADO Where MercadoNegociacion = '"~Val(t:58)~"' and Especie='"~Val(t:2)~"' and FechaVto='"~IdxDate(Val(t:10))~"' "))

    ***** Numerador
    ACN(t:40, 51)
    ***** Numerador Boleto
    ACN(t:42, 198)
    ***** Secuencia2 (*)
    ACT(t:44, fbn('Secuencia2'))
    ***** PlazoGracia
    ACN(t:45, Val(t:10)-Val(t:8))
    ***** VCAN5
*    ACN(t:46, TasaProducto('PFEOCT',Val(t:1),Val(t:2),Val(t:45),1,NO,Val(t:8)))
    ***** VCAN19
    ACN(t:47, Val(t:11)*Val(t:46))
    ***** TotalAux2
    if Val(t:47)>0
      ACN(t:48, Val(t:47))
    else
      ACN(t:48, 0)
    endif
    ***** TotalGanancias
    ACN(t:49, Val(t:48))
    ***** Sector2
    ACT(t:50, '0010' )
    ***** MB2
    if EqStr(Val(t:18),'O')
      ACN(t:51, 0)
    else
      ACN(t:51, 1)
    endif
    ***** Plaza1
    ACT(t:52, IIF(Incluido('BLOCAL',Ascendientes('CLIENTES',Val(t:3)),1),'TRAN',IIF(Incluido('BEXTER',Ascendientes('CLIENTES',Val(t:3)),1),'BCEX','DIVI')))
    ***** MB6
    ACN(t:53, 4)
    ***** Cartera
    ACN(t:54, 0)
    ***** Cliente5
    ACT(t:55, SQL("Select Controlante from "~DBO~".GRUPOSECONOMICOS where TipoGrupo = 'LC' and Cliente = '"~Val(t:3)~"' "))
    ***** UDN1
    ACT(t:57, SQL("Select UDN from "~DBO~".USRVEHICULO where Codigo='"~Val(t:27)~"' and Vehiculo='"~Val(t:28)~"'"))
    ***** ConceptoEmp
    ACT(t:59, SQL("Select Alias8 from "~DBO~".CLIENTES where Codigo ='"~Val(t:3)~"'"))
    ***** CB7
    ACN(t:60, 0)
    ***** Sector2
    ACT(t:61, '0030' )
    ***** RB6
    ACN(t:62, 2)
    ***** FechaOp2
    ACD(t:63, FSys)
    ***** Plazo4 (*)
    ACN(t:64, DifDias(Val(t:8),Val(t:10),'ARG'))
    ***** Puesto (*)
    ACN(t:65, 1)
    ***** TotalRetenciones
    ACN(t:66, 0)
    ***** RB8 (*)
    ACN(t:67, iif(Val(t:66)=0,0,1))
    ***** ValorRB1
    ACN(t:68, iif(Val(t:66)=1,SQL("Select PlazoSpot from "~DBO~".ESPECIES where Codigo ='"~Val(t:2)~"'"),0))
    ***** TotalNetoCli3
**** Error
*    ACN(t:69, CotizacionFX(Val(t:6),'USD',FSYS,Val(t:64),iif(Val(t:65)=1,'SI','NO'),2,NO,iif(Val(t:67)=0,'LOC','INT')))
    ***** ModoCotiza
    ACN(t:70, iif(EqStr(Modo(Val(t:2),CotizaEn(Val(t:2))),'DIR'),0,1))
    ***** MB3 (Garantizada)
    if EqStr(fbn('Garantizada'),'S')
      ACN(t:71, 1)
    else
      ACN(t:71, 0)
    endif
    ***** Mercado3
    ACT(t:72, SQL("Select Equipo from "~DBO~".CLIENTES where Codigo ='"~Val(t:3)~"'"))
    ***** VPRE7
**** Error
*    ACN(t:73, CotizacionFX(Val(t:6),Val(t:2),FSYS,Val(t:64),iif(Val(t:65)=1,'SI','NO'),2,NO,iif(Val(t:67)=0,'LOC','INT')))
    ***** Cotizacion1
    if Val(t:53)=1                      
      * MB6 = 1
      ACN(t:32, 0)
    else 
      if Val(t:66)=0 
        * TotalRetenciones = 0
        ACN(t:32, 1)
      else 
        if Val(t:70)=0 
          * ModoCotiza = 0
          ACN(t:32, Val(t:73))
        else 
          if Val(t:73)=0 
            ACN(t:32, 0)
          else 
**** Error
*            ACN(t:32, 1/(CotizacionFX(Val(t:6),Val(t:2),FSYS,Val(t:64),iif(Val(t:65)=1,'SI','NO'),1,NO,iif(Val(t:67)=0,'LOC','INT'))) )
          endif
        endif
      endif
    endif
    ***** Cotizacion2
    if Val(t:53)=1 y Val(t:66)=0 
      ACN(t:33, Val(t:69))
    else 
      if Val(t:66)=0 
        ACN(t:33, Val(t:69))
      else 
        ACN(t:33, Val(t:32)*Val(t:69))
      endif
    endif
    ***** Centro1
    ACT(t:74, 'FXL')
    ***** TotalImpuestos
    if Eqstr(Val(t:69),'FXL')
      ACN(t:75, Val(t:48))
    else
      ACN(t:75, 0)
    endif
    ***** RB3
    ACN(t:76, 0)
    ***** VCAN7
    ACN(t:77, DiasA(EspecieDiasAnio(Val(t:2))))
    ***** VCAN8
    ACN(t:78, DiasA(EspecieDiasAnio(Val(t:14))))
    ***** MB4
    ACN(t:79, 1)
    ***** TasaPrecan
*    ACN(t:80, TasaProducto('LIBOR',Val(t:1),Var('FEXTERFX'),Val(t:64),1,SI,Val(t:8)) )
    ***** TasaBase
    ACN(t:81, (((Val(t:12))/Val(t:31)*(1+Val(t:80)*Val(t:9)/Val(t:77)))-1)*(Val(t:78)/Val(t:9)))
    ***Fecha de ingreso en SIOPEL
    act(t:91, Fbn['Fecha_aa'])
    act(t:92, Fbn['Fecha_mm'])
    act(t:93, Fbn['Fecha_dd'])
    act(t:94, Fbn['Hora_hh'])
    act(t:95, Fbn['Hora_mm'])
    act(t:96, Fbn['Hora_ss'])
    act(t:97, val(t:92)~'/'~Val(t:93)~'/'~Val(t:91)~' '~Val(t:94)~':'~Val(t:95)~':'~Val(t:96))

    if Vacio(Val(t:3))
      * Vacio Cliente
      ACT(t:3, 'SIOPEL')
      ACN((26+FAC):36, 1)
    endif
*    MessageBox('Antes de z2 ')
    * Controlo que no haya otra operacion igual
    *****ACN(z2, SQL("Select Count(*) from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:1)~"' and FechaOp='"~IdxDate(Val(t:8))~"' and Especie='"~Val(t:2)~"' and Cliente1='"~Val(t:3)~"' and CB5='1' "))
    ACN(z:2, SQL("Select Count(*) from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:1)~"' and FechaOp='"~IdxDate(Val(t:8))~"' and Especie='"~Val(t:2)~"' and Cliente1='"~Val(t:3)~"' "))
    if Val(z:2)>0
      ACN(t:21, 1)
      SCN(z:1,1)
      ACN((26+FAC):38, 1)
      ACT(er:4, PAD('Problema de op duplicada',40))
    endif
    if Vacio(Val(t:3))
      ACN(t:86, 1)
      ACT(t:3,'SIOPEL')
      ACN((26+FAC):4, 1)
      ACT(er:4,PAD('Agente Inexistente',40))
    endif
    if Vacio(Val(t:1))
      ACT(t:82, 'NO genera x Vacio(t:1)')
      if Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".OPSIOPEL ")
        SQL.ADD("   Set Procesado= '1', ")
