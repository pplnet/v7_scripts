Sqladd(" Select M.NrSaldo, O.FechaOp, O.Vehiculo1, O.Especie, M.Cantidad, M.Precio, ")
Sqladd("        O.FechaVto, O.TipoOp, O.NrOperacion, M.Book, M.Cupon, M.FechaMov ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVPOSEJE M ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd("   and M.FechaMov   <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and M.Cantidad    < 0 ")
Sqladd("   and M.NrSaldo     = '101' ")
Sqladd("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.TipoNegocio = 'T' ")
if (NoVacio(dialogo.book1))
Sqladd("   and M.Book     = '"~dialogo.book1~"' ")
endif
Sqladd(" Union All ")
Sqladd(" Select M.NrSaldo, T.Fecha1 as FechaOp, T.Vehiculo1, T.Especie, M.Cantidad, ")
Sqladd("        M.Precio, T.Fecha1 FechaVto, T.TipoTr2 TipoOp,T.NrTrans NrOperacion, ")
Sqladd("        M.Book, M.Cupon, M.FechaMov ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M ")
Sqladd(" Where T.NrTrans     = M.NrOperacion ")
Sqladd("   and M.FechaMov   <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("   and M.Cantidad    < 0 ")
Sqladd("   and M.NrSaldo     = '101' ")
Sqladd("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.TipoNegocio = 'T' ")
if (NoVacio(dialogo.book1))
