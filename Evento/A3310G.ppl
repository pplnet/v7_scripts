*- Las Especies son Titulos, sin importar si son privados o publicos. 
*- Los valores de los campos Valor Nominal Tenencia y Valores de Mercado Tenencia son los mismo 
*-  que los valores  de los campos Valor Nominal Posicion y Valor de Mercado Posicion.
*- El Nombre del archivo depende del Radio3.


MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1 : "Vehiculo"                                ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1    : "Fecha"                                   ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'La fecha debe ser menor';NO;FinDeMes(Fsys,NO,'ARG')
  Radio3    : 'Cartera|BCRA|RML|Otros valores|Terceros' ; ; ;;NO;NO;;;;0
  Radio2    : "Salida|Informe|Inf+TXT"                  ; ; ;;NO;NO;;;;1
  String1   : 'Path'                                    ; ; ;;;;;;; VAR('PATHBCRA');
  String2   : 'Arch. BCRA'                              ; ; ;;NO;;;;; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS1.TXT'; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS1.TXT'
  String3   : 'Arch. RML'                               ; ; ;;NO;;;;; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS2.TXT'; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS2.TXT'
  String4   : 'Arch. Ot.Vals.'                          ; ; ;;NO;;;;; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS3.TXT'; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS3.TXT'
  String5   : 'Arch. Tceros.'                           ; ; ;;NO;;;;; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS4.TXT'; PAD0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1),5)~'CPIS4.TXT'
  Radio1    : 'Sist.Oper.|W98|NT'                       ; ; ;;NO;NO;;;;1; 
FinDialogo

IF Not Ok
  Cancelar
ENDIF


Recorrer&i 0,3

  *- Cartera del Tipo BCRA
  If &i=0
     EjecutarEvento('A3310',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Radio3=0,Radio2=Dialogo.Radio2,String1=Dialogo.String1,String2=Dialogo.String2,Radio1=Dialogo.Radio1)
  Endif 

  *- Cartera del Tipo RML
  If &i=1
     EjecutarEvento('A3310',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Radio3=1,Radio2=Dialogo.Radio2,String1=Dialogo.String1,String2=Dialogo.String3,Radio1=Dialogo.Radio1)
  Endif 

  *- Cartera del Tipo Otros Valores
  If &i=2
     EjecutarEvento('A3310',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Radio3=2,Radio2=Dialogo.Radio2,String1=Dialogo.String1,String2=Dialogo.String4,Radio1=Dialogo.Radio1)
  Endif 

  *- Cartera del Tipo Terceros
  If &i=3
     EjecutarEvento('A3310T',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Radio3=3,Radio2=Dialogo.Radio2,String1=Dialogo.String1,String2=Dialogo.String5,Radio1=Dialogo.Radio1)
  Endif 

Proximo
