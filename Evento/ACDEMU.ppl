CrearDialogo
  NrOperacion1 : 'Prorroga'                 ;;;;
  NrOperacion2 : 'Operacion Prorrogada'     ;;;;
  Radio1       : 'Accion|Avanza|Retrocede'  ;;;;
  NrOperacion3 : 'Op. vehiculo Contrario '  ;;;;
FinDialogo


if not Ok
  Cancelar
endif

*** A1= Contraria de la Operacion Prorrogada
ACT(A:1,BuscarCampo('OPERACIONES','NrOperacion3', 'NrOperacion', Dialogo.NrOperacion2))

*** Avanza Instancia 19 a 20
if Dialogo.Radio1=0
   *Activa Prorroga
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=1 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=1 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion3~"' ")
   SQL.NEW
   *Desactiva Op
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=0 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion2~"' ")
   SQL.NEW
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=0 ")
   SQL.ADD("WHERE  NrOperacion='"~Val(A:1)~"' ")
   SQL.NEW
   SQL.EXEC
   *Act todos los movimientos
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion2,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion3,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Val(A:1),SI,NO,NO,NO)
   SQL.EXEC
endif

*** Retrocede Instancia 20 a 19
if Dialogo.Radio1=1
   *Desactiva Prorroga
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=0 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=0 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion3~"' ")
   SQL.NEW
   *Act Op
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=1 ")
   SQL.ADD("WHERE  NrOperacion='"~Dialogo.NrOperacion2~"' ")
   SQL.NEW   
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("SET CB6=1 ")
   SQL.ADD("WHERE  NrOperacion='"~Val(A:1)~"' ")
   SQL.NEW
   SQL.EXEC
   *Act todos los movimientos
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion2,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Dialogo.NrOperacion3,SI,NO,NO,NO)
   SQL.EXEC
   SQL.ActualizarMovimientos2(Val(A:1),SI,NO,NO,NO)
   SQL.EXEC
endif

