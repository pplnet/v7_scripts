creardialogo
especie3:'Especie';1;;;;;NoVacio(dialogo.especie3) y DesciendeDeEspecie(dialogo.especie3, 'TITULO');'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
especie1:'Cupon';2;1;;NO;;NoVacio(dialogo.especie1) y EsTerminal(dialogo.especie1, especie);'Debe Ingresar un Especie que sea Cupon';NO;BuscarCampo('ESPECIES', 'Alias9', 'Codigo', dialogo.especie3);BuscarCampo('ESPECIES', 'Alias9', 'Codigo', dialogo.especie3);;;;"Status = 'HAB' "
entero1:'Nr.Cupon';3;;;NO;;dialogo.entero1 >= 0;'Debe Ingresar el Numero de Cupon';NO;0;BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1)
fecha1:'F.Corte';4;;;NO;;;;;Query(" SELECT FechaPago FROM "~Dbo()~".AGENDACUPONES WHERE Especie = '"~dialogo.especie3~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' ");Query(" SELECT FechaCorte FROM "~Dbo()~".AGENDACUPONES WHERE Especie = '"~dialogo.especie3~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' ")
findialogo

if (not ok)
Cancelar()
endif

Sqladd("SELECT 1 as Nro FROM "~Dbo()~".MOVEJECUTADOS WHERE Especie='"~dialogo.especie3~"' and Cupon='"~FStr(dialogo.entero1 + 1, 1, 0)~"' ")
recorrer sql
Dfa()
Acn(at2, Fbn()['Nro'])
proximo

if (Val(at2) = 1)
Cancelar('Ejecute Previamente la CANCELACION COBRO/PAGO y/o CANCELACION DE CORTE  ')
endif

Acn(z1, 0)
Sqladd(" SELECT * FROM "~Dbo()~".AGENDACUPONES  ")
Sqladd(" WHERE Especie = '"~dialogo.especie3~"' AND NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' ")

recorrer sql

if (Eqstr(Fbn()['Estado'], 'PEN'))
Messagebox('Se ha Cancelado con anterioridad la Actualizacion de la Especie !!!')
Acn(z1, 1)
else
Acn(z1, 0)

Sqladd("SELECT Max(Convert(Float,NrCupon)) as NrCupon FROM "~Dbo()~".AGENDACUPONES  WHERE Especie='"~dialogo.especie3~"' AND Convert(Float,NrCupon)>"~FStr(dialogo.entero1, 0, 0)~" and Estado='PRO' ")
recorrer sql
Dfa()
Acn(z1, Fbn()['NrCupon'])
proximo

if (Val(z1) > dialogo.entero1)
Messagebox('Debe Cancelar Previamente la Actualizacion del Cupon '~FStr(Val(z1), 0, 0)~' !!!')
endif

if (Val(z1) = 0)
Sqladd(" UPDATE "~Dbo()~".AGENDACUPONES SET ")
Sqladd(" FechaProceso    =  NULL, ")
Sqladd(" Estado          = 'PEN', ")
Sqladd(" IntsCapitalizados = 0 ")
Sqladd(" WHERE Especie = '"~Fbn()['Especie']~"' AND NrCupon = '"~Fbn()['NrCupon']~"' ")
Sqlnew()

Message(' Actualizando Especie ')

if (dialogo.entero1 > 1)
Acn(ck1, dialogo.entero1 - 1)
else
Acn(ck1, dialogo.entero1)
endif

Sqladd(" SELECT A.FechaCorte, A.FechaPago, A.VTeoricoAnt, A.PorAmCapital, E.VTeorico, A.Especie, A.NrCupon ")
Sqladd(" FROM "~Dbo()~".AGENDACUPONES A, "~Dbo()~".ESPECIES E ")
Sqladd(" WHERE A.Especie = E.Codigo ")
Sqladd(" AND   A.Especie ='"~dialogo.especie3~"' AND A.NrCupon='"~FStr(Val(ck1), 0, 0)~"' ")
recorrer sql
Dfa()
if (dialogo.entero1 > 1)
Acn(z2, Fbn()['VTeoricoAnt'] - (Fbn()['PorAmCapital'] / 100))
else
Acn(z2, Fbn()['VTeoricoAnt'])
endif
Acd(z3, Fbn()['FechaCorte'])
Acd(z4, Fbn()['FechaPago'])
Acn(z5, Fbn()['VTeoricoAnt'])
proximo

Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET Cupon = "~FStr(Fbn()['NrCupon'], 0, 0)~", ")
Sqladd("VTeorico = "~FStr(Val(z2), 0, 9)~", ")
Sqladd("    Valor4 = 0, Valor5 = 0, Valor6 = 0,")
Sqladd("    FechaProximoCorte = FechaCorteCupon,")
Sqladd("    FechaCorteCupon   = '"~IdxDate(Val(z3))~"', ")
Sqladd("    FechaPagoCupon    = '"~IdxDate(Val(z4))~"', ")
Sqladd("    IntsCapitalizados = "~FStr(Fbn('IntsCapitalizados'), 0, 9)~" ")
Sqladd("WHERE Codigo = '"~Fbn()['Especie']~"' ")
Sqlnew()
Sqlexec()


Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET Cupon = "~FStr(Fbn()['NrCupon'] - 1, 0, 0)~", ")
Sqladd("    Valor1 = 0, Valor2 = 0, Valor3 = 0, ")
Sqladd("    FechaProximoCorte=FechaCorteCupon,")
Sqladd("    FechaCorteCupon='"~IdxDate(Val(z3))~"',")
Sqladd("    FechaPagoCupon='"~IdxDate(Val(z4))~"', ")
Sqladd("    VTeorico = "~FStr(Val(z5), 0, 9)~" ")
Sqladd("WHERE  Codigo = '"~dialogo.especie1~"' ")
Sqlnew()
Sqlexec()
endif
endif
proximo

Ejecutarevento('CORTEZ', 'especie1', dialogo.especie3, 'entero1', dialogo.entero1, 'fecha1', 0)

Messagebox('Finalizo la Actualizacion de la Especie !!!')
