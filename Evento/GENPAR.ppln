Sqladd("SELECT M.FechaMov ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O, "~Dbo()~".MOVPOSEJE M ")
Sqladd(" Where O.NrOperacion = M.NrOperacion ")
Sqladd(" AND M.FechaMov    <= '"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd(" AND M.FechaMov >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
Sqladd("   and M.Cantidad   >= 0 ")
Sqladd("   and M.NrSaldo     = '101' ")
Sqladd("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.TipoNegocio = 'T' ")
Sqladd("   and O.TipoOp = 'TIC'  ")
if (NoVacio(dialogo.book1))
Sqladd("   and M.Book     = '"~dialogo.book1~"' ")
else
Sqladd(" AND M.Book IN ("~Pipe2Comillas(Val(bk:1))~") ")
endif
Sqladd("   and O.NrOperacion Not In  ")
Sqladd("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
Sqladd("GROUP BY M.FechaMov ")

Sqladd(" UNION ALL ")

Sqladd("SELECT M.FechaMov ")
Sqladd("FROM   "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M ")
Sqladd(" Where T.NrTrans     = M.NrOperacion ")
Sqladd(" AND M.FechaMov <= '"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd(" AND M.FechaMov >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
Sqladd("   and M.Cantidad   >= 0 ")
Sqladd("   and M.NrSaldo     = '101' ")
Sqladd("   and M.Vehiculo    = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.Cliente     = '"~dialogo.vehiculo1~"' ")
Sqladd("   and M.TipoNegocio = 'T' ")
Sqladd(" AND T.TipoTr2 IN ('DTP','TRPOS') ")
if (NoVacio(dialogo.book1))
Sqladd(" and M.Book  = '"~dialogo.book1~"' ")
Sqladd(" AND (T.Book2 = '"~dialogo.book1~"' OR T.TipoTr2 <> 'TRPOS') ")
else
Sqladd(" AND M.Book IN ("~Pipe2Comillas(Val(bk:1))~") ")
Sqladd(" AND (T.Book2 IN ("~Pipe2Comillas(Val(bk:1))~") OR T.TipoTr2 <> 'TRPOS') ")
endif
Sqladd("   and T.NrTrans     Not In  ")
Sqladd("       (Select NrOperacion FROM "~Dbo()~".PARTIDAS) ")
Sqladd("GROUP BY M.FechaMov ")
