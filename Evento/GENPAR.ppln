Sqladd("        M.Precio, T.Fecha1 FechaVto, T.TipoTr2 TipoOp,T.NrTrans NrOperacion, ")
Sqladd("        M.Book, M.Cupon, M.FechaMov, E.Cotiza, E.MonedaEmision, T.Cuenta1 CtaCustodia, 1 as Tipo, E.Cotiza ContraEspecie ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVPOSEJE M, "~Dbo()~".ESPECIES E ")
