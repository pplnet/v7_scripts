MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "F.Op.Desde" ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una FechaOp Desde';NO;FSys;
  Fecha2     : "F.Op.Hasta" ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

if Not Ok
  Cancelar
endif

ACN(W:1,0)
ACN(W:2,0)

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, O.Especie ")
SQL.ADD(" From    "~DBO~".OPERACIONES O   ")
SQL.ADD(" where  O.TipoOp IN ('FCS','FCR')  ")
SQL.ADD(" AND O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" order by O.FechaOp, O.NrOperacion ")
Recorrer SQL
   Message('Procesando Operaciones')
   SCN(W:1,1)
   ACT(B:1,fbn('Especie'))
   ACT(B:2,fbn('NrOperacion'))
   ACD(B:3,fbn('FechaOp'))
   SQL.ActualizarMovimientos3(Val(B:2), NO, SI, NO, NO, NO, 0)
   SQL.NEW
   SQL.EXEC
Proximo

Recorrer&i Dialogo.Fecha1, Dialogo.Fecha2
   IF EsHabil(&i, 'ARG') O EsHabil(&i, 'URU')
      ACD(B:4,&i)
      Message('Ajustando Dia '~Fecha(&i))
      EjecutarEvento('AJULIM', Fecha1=Val(B:4))
   ENDIF
Proximo

    