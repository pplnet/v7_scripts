*- Deriva las operaciones segun sus caracteristicas
*- Recupero el nombre del tipo de operacion
*-HojaVisible(SI)
CrearDialogo
   NrOperacion1: 'NrOper' ;;;;;;;;;'AO000030';;;;;;;;;;;;;;
   TipoOp1     : 'TipoOp' ;;;;;;;;;'MMCP';;;;;;;;;;;;;;
   String1     : 'Instancias'  ;;;;;;;;;"Instancia In (14,15)";;;;;;;;;;;;;;
FinDialogo
If Not Ok
   Cancelar
EndIf

ACT(p1,VAR('WPLAZO1'))
ACT(p2,VAR('WPLAZO2'))
ACT(m1,VAR('WMONTO1'))
ACT(m2,VAR('WMONTO2'))
ACT(P:3, Var('WPLAZO3'))
ACT(M:3, Var('WMONTO3'))

*- Condicion para que vaya a Gerente o CEO 
*- Al primer cumplimiento de condicion se para en esa instancia
SQL.ADD("SELECT Instancia,Condicion FROM  "~DBO~".TIPOSOPCONDICIONES WHERE TipoOp='"~Dialogo.TipoOp1~"' ")
If NoVacio(Dialogo.String1)
   SQL.ADD("and "~Dialogo.String1)
EndIf
SQL.ADD(" Order By Instancia")

Recorrer SQL
  dfa
  message(FBN['Condicion'])
  ACT(a1,ReemplazarSTR(FBN['Condicion'],"WPLAZO1",VAL(P1),SI) )
  ACT(a11,ReemplazarSTR(val(a1),"WPLAZO2",VAL(P2),SI) )
  ACT(a12,ReemplazarSTR(val(a11),"WMONTO1",VAL(M1),SI) )
  ACT(a13,ReemplazarSTR(val(a12),"WMONTO2",VAL(M2),SI) )
  ACT(A:14, ReemplazarSTR(val(A:13),"WMONTO3",VAL(M:3),SI))
  ACT(A:15, ReemplazarSTR(val(A:14),"WPLAZO3",VAL(P:3),SI))
  ACN(a2,FBN['Instancia'])
  SQL.ADD("SELECT COUNT(*) as Cuenta FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND "~val(A:15)~" ")
  *- message("SELECT COUNT(*) as Cuenta FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND "~val(a13)~" ")
  Recorrer SQL
    dfa
    ACN(n1,FBN['Cuenta'])
  Proximo
  *-message(VAL(N1))
  If val(n1)>0 
     message(' Derivo Operacion '~Dialogo.NrOperacion1~' a '~Fstr(val(a2),0,0)~" !!!!" )
     ACT(az3,Dialogo.NrOperacion1)
     ACT(az4,'OPERACIONES')
     ACN(az5,VAL(a2))
     (.'MODINSTGR'.)
     Break
  EndIf
Proximo

   
