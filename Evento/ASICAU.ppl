CrearDialogo  
  Radio1       : 'Tipo|Activa|Borrada'  ;1;1;1;  ;  ;;;;0;
  NrOperacion1 : '# Operacion:'         ; ; ; ;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 o [NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'CAUC|CAUT')];'Debe ingresar una operacion Caucion';NO;;;;;;"TipoOp in ('CAUC','CAUT') "
  NrBOperacion : 'Op.Borrada :'         ;2; ; ;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o [NoVacio(Dialogo.NrBOperacion) y Incluido(BuscarCampo('BOPERACIONES','TipoOp','NrOperacion',Dialogo.NrBOperacion),'CAUC|CAUT')];'Debe ingresar una operacion anulada Caucion';NO;;;;;;"TipoOp in ('CAUC','CAUT') "
  Check1       : 'Procesa'              ; ; ; ;NO;NO;;;;1;
FinDialogo
If Not OK
   Cancelar('Evento Cancelado')
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, '# Op')
ACT(a:2, 'Tipo Op')
ACT(a:3, '# Boleto')
ACT(a:4, '# Alta')
ACT(a:5, 'Fecha Alta')
ACT(a:6, 'Hora Alta')

ACN(x:1, Dialogo.Check1)
If Dialogo.Radio1=0
  ACT(b:1, Dialogo.NrOperacion1)
  ACT(b:2, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Val(b:1)))
  ACT(b:3, BuscarCampo('OPERACIONES','NrBoleto','NrOperacion',Val(b:1)))
  ACT(c:3, BuscarCampo('OPERACIONES','NrBoleto2','NrOperacion',Val(b:1)))
  ACT(b:4, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',Val(b:1)))
  ACT(c:4, BuscarCampo('OPERACIONES','Observac2','NrOperacion',Val(b:1)))
  ACD(b:5, BuscarCampo('OPERACIONES','FechaAltaMAE','NrOperacion',Val(b:1)))
Else
  ACT(b:1,Dialogo.NrBOperacion)
  ACT(b:2, BuscarCampo('BOPERACIONES','TipoOp','NrOperacion',Val(b:1)))
  ACT(b:3, BuscarCampo('BOPERACIONES','NrBoleto','NrOperacion',Val(b:1)))
  ACT(c:3, BuscarCampo('BOPERACIONES','NrBoleto2','NrOperacion',Val(b:1)))
  ACT(b:4, BuscarCampo('BOPERACIONES','NroAltaMAE','NrOperacion',Val(b:1)))
  ACT(c:4, BuscarCampo('BOPERACIONES','Observac2','NrOperacion',Val(b:1)))
  ACD(b:5, BuscarCampo('BOPERACIONES','FechaAltaMAE','NrOperacion',Val(b:1)))
EndIf
if Vacio(Val(b:3)) o Vacio(Val(c:3))
  * Falta algun boleto
  ACN(x:2, 1)
  if Vacio(Val(b:3))
    * Falta boleto Spot
    ACN(x:3, 1)
  endif
  if Vacio(Val(c:3))
    * Falta boleto Spot
    ACN(x:4, 1)
  endif
endif

CrearDialogo  
  Radio1       : 'Tipo|Activa|Borrada'  ;1;1;1;NO;  ;;;;0;
  NrOperacion1 : '# Operacion:'         ;2;1; ;NO;Dialogo.Radio1=0;Dialogo.Radio1=1 o NoVacio(Dialogo.NrOperacion1);'Debe ingresar una operacion';NO;Val(b:1)
  NrBOperacion : 'Op.Borrada :'         ;2;1; ;NO;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.NrBOperacion);'Debe ingresar una operacion anulada';NO;Val(b:1)
  TipoOp1      : 'TipoOp :'             ;3;1; ;NO;  ;;;;Val(b:2)

  String1      : '# Boleto Spot:'       ;5;1; ;NO;  ;;;;Val(b:3);;;;'XXXXXXXX'
  String2      : '# Boleto Fut'         ;5;2; ;NO;  ;;;;Val(c:3);;;;'XXXXXXXX'
  Check2       : 'Genera Boletos'       ;6;1; ;Val(x:2)=1;SI;;;;0;
  
  String3      : '# Alta Mae Spot:'     ;8;1; ;  ;  ;;;;Val(b:4);;;;'XXXXX'
  String14     : '# Alta Mae Fut:'      ;8;2; ;  ;  ;;;;Val(c:4);;;;'XXXXX'

  Fecha10      : 'Fecha Operacion:'     ;9;1; ;NO;  ;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion1);  
  Fecha1       : 'Fecha Alta Mae:'      ;10;1; ;  ;  ;;;;Val(b:5);
  Entero1      : 'Hora:'                ;11;1; ;  ;  ;Dialogo.Entero1>=0 y Dialogo.Entero1<24;'La hora no puede ser superior a 24'        ;NO;;Num(Copy(Dialogo.String5,1,2));;;'XX'
  Entero2      : 'Minutos:'             ;  ; ; ;  ;  ;Dialogo.Entero2>=0 y Dialogo.Entero2<60;'Los minutos no pueden ser superiores a 60' ;NO;;Num(Copy(Dialogo.String5,4,2));;;'XX'
  Entero3      : 'Segundos:'            ;  ; ; ;  ;  ;Dialogo.Entero3>=0 y Dialogo.Entero3<60;'Los segundos no pueden ser superiores a 60';NO;;Num(Copy(Dialogo.String5,7,2));;;'XX'

  String4      : '# Orden'              ;10;2; ;  ;  ;;;;;iif(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','NrOrden'   ,'NrOperacion',Dialogo.NrOperacion1),BuscarCampo('BOPERACIONES','NrOrden'   ,'NrOperacion',Dialogo.NrBOperacion));;;'XXXXX'
  Entero4      : 'Hora:'                ; ; ; ;  ;  ;Dialogo.Entero4<24;'La hora no puede ser superior a 24'        ;NO;;Num(Copy(Dialogo.String6,1,2));;;'XX'
  Entero5      : 'Minutos:'             ; ; ; ;  ;  ;Dialogo.Entero5<60;'Los minutos no pueden ser superiores a 60' ;NO;;Num(Copy(Dialogo.String6,4,2));;;'XX'
  Entero6      : 'Segundos:'            ; ; ; ;  ;  ;Dialogo.Entero6<60;'Los segundos no pueden ser superiores a 60';NO;;Num(Copy(Dialogo.String6,7,2));;;'XX'
  String5      : 'Hora Operacion'       ; ; ; ;NO;NO;;;;;iif(Dialogo.Radio1=0,Hora(BuscarCampo('OPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrOperacion1)),Hora(BuscarCampo('BOPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrBOperacion)));
  String6      : 'Hora Orden'           ; ; ; ;NO;NO;;;;;BuscarCampo('LIBORDENES','HoraOp','NrOperacionRef',Dialogo.NrOperacion1);      

   Check1       : 'Procesa'              ; ; ; ;NO;NO;;;;Val(x:1);
FinDialogo
If Not OK
   Cancelar('Evento Cancelado')
EndIf

if Val(x:1)=1
  SQL.ADD("Update ")
  If Dialogo.Radio1=0
    SQL.ADD(" "~DBO~".OPERACIONES SET         ")
  Else
    SQL.ADD(" "~DBO~".BOPERACIONES SET         ")
  EndIf

  if NoVacio(Dialogo.String3)
    SQL.ADD("NroAltaMAE   = '"~Copy(Pad0(Dialogo.String3,5),1,5)~"', ")
    SQL.ADD("AceptaMAE    = 'SI', ")
  else
    SQL.ADD("NroAltaMAE   = Null, ")
    SQL.ADD("AceptaMAE    = Null, ")
  EndIf
  if NoVacio(Dialogo.String14)
    SQL.ADD("Observac2   = '"~Copy(Pad0(Dialogo.String14,5),1,5)~"', ")
  else
    SQL.ADD("Observac2   = Null, ")
  EndIf

  if NoVacio(Dialogo.String4)
    SQL.ADD("NrOrden       = '"~Copy(Pad0(Dialogo.String4,5),1,5)~"', ")
  else
    SQL.ADD("NrOrden       = Null, ")
  EndIf  
  
  if Dialogo.Check2=1
    * Genera Boleto
    if Val(x:3)=1
      ACT(b:3, GetNumerador(98))
      SQL.ADD("NrBoleto  = '"~Copy(Pad0(Val(b:3),8),1,8)~"', ")
    endif
    if Val(x:4)=1
      ACT(b:4, GetNumerador(98))
      SQL.ADD("NrBoleto2  = '"~Copy(Pad0(Val(b:4),8),1,8)~"',")
    endif
  EndIf

  if Dialogo.Fecha1>0
    ACT(f:2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~FStr(Dialogo.Entero1,2,0)~':'~FStr(Dialogo.Entero2,2,0)~':'~FStr(Dialogo.Entero3,2,0))  
    SQL.ADD("FechaAltaMAE  = Convert(datetime,'"~Val(f:2)~"',120) ")
  else
    SQL.ADD("FechaAltaMAE  = Null ")
  EndIf
  SQL.ADD("where NrOperacion = '"~Val(b:1)~"'")
  SQL.NEW
  SQL.EXEC

if Dialogo.Fecha1>0
  ACT(aa2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~FStr(Dialogo.Entero4,2,0)~':'~FStr(Dialogo.Entero5,2,0)~':'~FStr(Dialogo.Entero6,2,0))  
  ACT(ho1,PAD0(Dialogo.Entero4,2)~':'~PAD0(Dialogo.Entero5,2)~':'~PAD0(Dialogo.Entero6,2))  
  If Dialogo.Radio1=0
     ACD(fe:1, SQL("SELECT FechaOp FROM "~DBO~".OPERACIONES  WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  "))
  Else
     ACD(fe:1, SQL("SELECT FechaOp FROM "~DBO~".BOPERACIONES  WHERE NrOperacion='"~Dialogo.NrBOperacion~"'  "))
  Endif
  
  ACN(or:1, SQL("SELECT 1 FROM "~DBO~".LIBORDENES  WHERE NrOperacionRef='"~Dialogo.NrOperacion1~"'  "))  

  If Val(or:1) <> 1
    SQL.ADD(" Insert into "~DBO~".LIBORDENES ( ")
    SQL.ADD(" Mercado, Fecha,  FechaOP, NrOperacionRef, FechaHo,  HoraOp, SecuenciaHO  ")
    SQL.ADD(" ) Values ( ")
    SQL.ADD(" '1', ")
    SQL.ADD(" "~IdxDate2(FSys)~", ")
    SQL.ADD(" "~IdxDate2(val(fe:1))~", ")
    SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
    SQL.ADD(" "~IdxDate2(val(fe:1))~", ")
    SQL.ADD(" '"~Val(ho:1)~"', ")
    SQL.ADD(" '"~Copy(Pad0(Dialogo.String4,5),1,5)~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
  Else
    SQL.ADD("Update ")
    SQL.ADD(" "~DBO~".LIBORDENES SET         ")
    SQL.ADD("FechaHO = "~IdxDate2(val(fe:1))~", HoraOp = '"~Val(ho:1)~"', SecuenciaHO = '"~Copy(Pad0(Dialogo.String4,5),1,5)~"'  ")
    SQL.ADD("where NrOperacionRef = '"~Dialogo.NrOperacion1~"'")
    SQL.NEW
  Endif
Endif  
  SQL.EXEC  

  Messagebox('Operacion modificada con exito')
else
  Messagebox('Fin sin procesar')
endif
