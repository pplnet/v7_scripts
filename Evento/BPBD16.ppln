Sqladd(" SELECT /*+ RULE */ T.NrTrans, T.Vehiculo1, T.Vehiculo2, T.Cuenta1, T.Cuenta2, T.Cliente1, T.Cliente2, ")
Sqladd(" T.Cantidad1, T.Fecha1, T.Fecha2, T.Especie ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CUENTAS C2, "~Dbo()~".CUENTAS C1")
Sqladd(" Where T.Cuenta2 = C2.Codigo ")
Sqladd(" AND   T.Cuenta1 = C1.Codigo ")
Sqladd(" AND   T.Fecha1  = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   T.CB6     = '1' ")
Sqladd(" AND   T.TipoTr2 = 'TRANSF' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND   T.Vehiculo2 IN ("~Pipe2Comillas(dialogo.lista1)~") ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo2 IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND  T.Cliente2 IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND  T.Cuenta2 IN ("~Pipe2Comillas(dialogo.lista3)~") ")
endif
if (dialogo.radio1 = 0)
Sqladd(" AND  C1.TipoCuenta = 'INT' ")
endif
if (dialogo.radio1 = 1)
Sqladd(" AND  C2.Pagadora = 'SI' ")
endif
if (dialogo.radio1 = 2)
Sqladd(" AND  (C1.TipoCuenta = 'INT' OR C2.Pagadora = 'SI' )")
endif
Sqladd(" ORDER BY T.NrTrans ")

Acn(z:1, 0)
recorrer sql
