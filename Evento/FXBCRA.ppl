EjecutarEvento('OPSBIT',NrOperacion1=Val(ab1))

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   SET Valor = '1' ")
SQL.ADD(" WHERE NrBit = 2 ")
SQL.ADD("   AND NrOperacion = '"~Val(ab1)~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES ")
SQL.ADD("WHERE NrOperacion='"~Val(ab1)~"' ")
Recorrer SQL
  ACT(k:1, iif(Incluido(fbn('Especie'),'USD|USB'),'INTRAUSD','INTRAOM'))
  ACN(l:1,  LimAsignado(fbn('Vehiculo1'),Val(k:1)   ,'USD',fbn('Vehiculo1')))
  ACN(l:2,  LimAsignado(fbn('Vehiculo1'),'OVNGLOBAL','USD',fbn('Vehiculo1')))
  ACN(l:3,  LimAsignado(fbn('Vehiculo1'),'OVNOM'    ,'USD',fbn('Vehiculo1')))
  ACN(m:1, LimConsumido(fbn('Vehiculo1'),Val(k:1)   ,'USD',fbn('FechaOp'),fbn('Vehiculo1'),,,fbn('NrOperacion')))
  ACN(m:2, LimConsumido(fbn('Vehiculo1'),'OVNGLOBAL','USD',fbn('FechaOp'),fbn('Vehiculo1'),,,fbn('NrOperacion')))
  ACN(m:3, LimConsumido(fbn('Vehiculo1'),'OVNOM'    ,'USD',fbn('FechaOp'),fbn('Vehiculo1'),,,fbn('NrOperacion')))
  ACN(n:1, iif(Val(m:1)+fbn('TotalBrutoCli2')-Val(l:1)>0,Val(m:1)+fbn('TotalBrutoCli2')-Val(l:1),0))
  ACN(n:2, iif(Val(m:2)+fbn('TotalBrutoCli2')-Val(l:2)>0,Val(m:2)+fbn('TotalBrutoCli2')-Val(l:2),0))
  ACN(n:3, iif(Not Incluido(fbn('Especie'),'USD|USB') y Val(m:3)+fbn('TotalBrutoCli2')-Val(l:3)>0,Val(m:3)+fbn('TotalBrutoCli2')-Val(l:3),0))
proximo

SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
SQL.ADD("Set MinDerechoMercado = "~FStr(Val(n:1),0,2)~", ")
SQL.ADD("    MinDerechoBolsa = "~FStr(Val(n:2),0,2)~", ")
SQL.ADD("    MinImpuestoBolsa = "~FStr(Val(n:3),0,2)~" ")
SQL.ADD("WHERE NrOperacion='"~Val(ab1)~"' ")
SQL.NEW
SQL.EXEC

EjecutarEvento('EXBCRA',NrOperacion1=Val(ab1))

SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES ")
SQL.ADD("WHERE NrOperacion='"~Val(ab1)~"' ")
Recorrer SQL

  ACD(f1,fbn['FechaOp'])
  **********************************
  * Posicion Spot Concertada Especie
  **********************************
  if Val(f1)<=FSys
    SQL.ADD("Insert Into "~DBO~".MOVPOSEJE ( ")
  else
    SQL.ADD("Insert Into "~DBO~".MOVPOSPEN ( ")
  endif
  SQL.ADD("   FechaMov, Cliente, Especie, Vehiculo, ")
  SQL.ADD("   NrSaldo, Cantidad, Precio, Book, ")
  SQL.ADD("   TipoNegocio, TipoPosicion, NrOperacion ")

  SQL.ADD(" ) Values ( ")

  SQL.ADD("  '"~IdxDate(fbn['FechaOp'])~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
  SQL.ADD("  '"~fbn('Especie')~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
      
  SQL.ADD("   31, ")
  if Incluido(fbn['TipoOp'],'FXC|FXA|')
    SQL.ADD("  "~FStr(fbn('Cantidad'),1,2)~", ")
  else
    SQL.ADD("  ("~FStr(-fbn('Cantidad'),1,2)~"), ")
  endif
  SQL.ADD("  "~FStr(fbn('Precio1'),1,8)~", ")
  SQL.ADD(" '"~fbn['Book1']~"', ")
    
  SQL.ADD("   'FX', ")
  SQL.ADD("   'FX', ")
  SQL.ADD("   '"~Val(ab1)~"' ")

  SQL.ADD(" ) ")
  SQL.NEW
  SQL.EXEC

  ********************************
  * Posicion Spot Concertada PESOS
  ********************************
  if Val(f1)<=FSys
     SQL.ADD("Insert Into "~DBO~".MOVPOSEJE ( ")
  else
     SQL.ADD("Insert Into "~DBO~".MOVPOSPEN ( ")
  endif
  SQL.ADD("   FechaMov, Cliente, Especie, Vehiculo, ")
  SQL.ADD("   NrSaldo, Cantidad, Precio, Book, ")
  SQL.ADD("   TipoNegocio, TipoPosicion, NrOperacion ")

  SQL.ADD(" ) Values ( ")
  
  SQL.ADD("  '"~IdxDate(fbn['FechaOp'])~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
  SQL.ADD("  '"~fbn('ContraEspecie')~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
      
  SQL.ADD("   35, ")
  if EqStr(fbn['TipoOp'],'FXC')
     SQL.ADD("  "~FStr(-fbn('TotalBrutoCli1'),1,2)~", ")
  else
     SQL.ADD("  "~FStr(fbn('TotalBrutoCli1'),1,2)~", ")
  endif
  SQL.ADD("  "~FStr(1,1,8)~", ")
  SQL.ADD(" '"~fbn['Book1']~"', ")
    
  SQL.ADD("   'FX', ")
  SQL.ADD("   'FX', ")
  SQL.ADD("   '"~Val(ab1)~"' ")
  
  SQL.ADD(" ) ")
  SQL.NEW
  SQL.EXEC

  *********************************
  * Posicion Spot Liquidada Especie
  *********************************
  ACD(f1,fbn['FechaVto'])
  if Val(f1)<=FSys
    SQL.ADD("Insert Into "~DBO~".MOVPOSEJE ( ")
  else
    SQL.ADD("Insert Into "~DBO~".MOVPOSPEN ( ")
  endif
  SQL.ADD("   FechaMov, Cliente, Especie, Vehiculo, ")
  SQL.ADD("   NrSaldo, Cantidad, Precio, Book, ")
  SQL.ADD("   TipoNegocio, TipoPosicion, NrOperacion ")

  SQL.ADD(" ) Values ( ")

  SQL.ADD("  '"~IdxDate(fbn['FechaVto'])~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
  SQL.ADD("  '"~fbn('Especie')~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
      
  SQL.ADD("   51, ")
  if Incluido(fbn['TipoOp'],'FXC|FXA|')
    SQL.ADD("  "~FStr(fbn('Cantidad'),1,2)~", ")
  else
    SQL.ADD("  ("~FStr(-fbn('Cantidad'),1,2)~"), ")
  endif
  SQL.ADD("  "~FStr(fbn('Precio1'),1,8)~", ")
  SQL.ADD(" '"~fbn['Book1']~"', ")
    
  SQL.ADD("   'FX', ")
  SQL.ADD("   'FX', ")
  SQL.ADD("   '"~Val(ab1)~"' ")

  SQL.ADD(" ) ")
  SQL.NEW
  SQL.EXEC

  *******************************
  * Posicion Spot Liquidada PESOS
  *******************************
  ACD(f1,fbn['FechaVto'])
  if Val(f1)<=FSys
    SQL.ADD("Insert Into "~DBO~".MOVPOSEJE ( ")
  else
    SQL.ADD("Insert Into "~DBO~".MOVPOSPEN ( ")
  endif
  SQL.ADD("   FechaMov, Cliente, Especie, Vehiculo, ")
  SQL.ADD("   NrSaldo, Cantidad, Precio, Book, ")
  SQL.ADD("   TipoNegocio, TipoPosicion, NrOperacion ")  
 
  SQL.ADD(" ) Values ( ")
 
  SQL.ADD("  '"~IdxDate(fbn['FechaVto'])~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
  SQL.ADD("  '"~fbn('ContraEspecie')~"', ")
  SQL.ADD("  '"~fbn('Vehiculo1')~"', ")
         
  SQL.ADD("   55, ")
  if EqStr(fbn['TipoOp'],'FXC')
    SQL.ADD("  "~FStr(-fbn('TotalBrutoCli1'),1,2)~", ")
  else
    SQL.ADD("  "~FStr(fbn('TotalBrutoCli1'),1,2)~", ")
  endif
  SQL.ADD("  "~FStr(1,1,8)~", ")
  SQL.ADD(" '"~fbn['Book1']~"', ")
     
  SQL.ADD("   'FX', ")
  SQL.ADD("   'FX', ")
  SQL.ADD("   '"~Val(ab1)~"' ")  

  SQL.ADD(" ) ")
  SQL.NEW 
  SQL.EXEC

Proximo
