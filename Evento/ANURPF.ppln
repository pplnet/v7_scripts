creardialogo
nroperacion1: 'NrOperacion';;;;;;Eqstr(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'MMCPM') y BuscarCampo('OPERACIONES', 'CB9', 'NrOperacion', dialogo.nroperacion1) = 1;'La operacion debe ser una renovacion y de tipo MMCPM';NO;;;;;;"TipoOp='MMCPM' and CB9='1'"
findialogo

if (not ok)
Cancelar()
endif

if (Query("Select 1 from "~Dbo()~".MOVEJECUTADOS Where NrOperacion = '"~dialogo.nroperacion1~"' AND NrSaldo=1") = 1)
Cancelar('La operacion seleccionada se encuentra liquidada. Desliquidela e intente nuevamente')
endif

Sqladd("Select O.Vehiculo1,O.Book1,O.Cliente1,O.Cuenta1,O.FechaOp,O.Plazo,O.FechaVto,O.Cantidad,O.Precio1 as 'TasaInt',O.ImpGastos1 as 'TasaRet',")
Sqladd("C.Cantidad3 as 'Intereses',C.Cantidad4 as 'Retenciones'")
Sqladd("From "~Dbo()~".OPERACIONES O JOIN "~Dbo()~".CUOTAS C  ON O.NrOperacion = C.NrOperacion ")
Sqladd("Where O.NrOperacion = '"~dialogo.nroperacion1~"' ")
SetFilaActual(1)

Act(a:fac, dialogo.nroperacion1)
Dfa()
recorrer sql
Act(b:fac, Fbn()['Vehiculo1'])
Act(c:fac, Fbn()['Book1'])
Act(d:fac, Fbn()['Cliente1'])
Act(e:fac, Fbn()['Cuenta1'])
Acd(f:fac, Fbn()['FechaOp'])
Acn(g:fac, Fbn()['Plazo'])
Acd(h:fac, Fbn()['FechaVto'])
Acn(i:fac, Fbn()['TasaInt'])
Acn(j:fac, Fbn()['Intereses'])
Acn(k:fac, Fbn()['TasaRet'])
Acn(l:fac, Fbn()['Retenciones'])
Acn(m:fac, Fbn()['Cantidad'])
proximo


crearlistbox;'Arial,8,B'
'NrOperacion';a:1..a:fac;NO;NO;;100;string;;Exe('COLOR8')
'Vehiculo';b:1..b:fac;NO;NO;;100;string;;Exe('COLOR8')
'Book';c:1..c:fac;NO;NO;;100;string;;Exe('COLOR8')
'Cliente';d:1..d:fac;NO;NO;;100;string;;Exe('COLOR8')
'Cuenta';e:1..e:fac;NO;NO;;100;string;;Exe('COLOR8')
'FechaOp';f:1..f:fac;NO;NO;;80;fecha;Exe('COLOR8')
'Plazo';g:1..g:fac;NO;NO;;60;numero;'####';Exe('COLOR8')
'FechaVto';h:1..h:fac;NO;NO;;80;fecha;Exe('COLOR8')
'TasaInt';i:1..i:fac;NO;NO;;100;numero;'###.########';Exe('COLOR8')
'Intereses';j:1..j:fac;NO;NO;;100;numero;'###,###,###,###.##';Exe('COLOR8')
'TasaRet';k:1..k:fac;NO;NO;;100;numero;'###.########';Exe('COLOR8')
'Retenciones';l:1..l:fac;NO;NO;;100;numero;'###,###,###,###.##';Exe('COLOR8')
'Cantidad';m:1..m:fac;NO;NO;;100;numero;'###,###,###,###.##';Exe('COLOR8')
finlistbox
if (not ok)
Cancelar()
endif

Sqladd("DELETE From "~Dbo()~".OPERACIONES Where NrOperacion = '"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()

Sqladd("UPDATE "~Dbo()~".OPERACIONES Set CB8='0', OperacionRef=null Where OperacionRef='"~dialogo.nroperacion1~"'")
Sqlnew()
Sqlexec()


Messagebox("El proceso de Anulacion de la Renovacion de PF finalizó correctamente")

