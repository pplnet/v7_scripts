sql.add("and M.Tipo_Movimiento_Codigo='DEP' ")
sql.add("and M.Tipo_Operacion_Codigo=O.TipoOp ")
sql.add("and M.NrOperacion=O.NrOperacion ")
sql.add("and M.Movimiento_Numero=1) ")
sql.new
sql.exec

sql.add("Select * ")
sql.add("from "~Dbo()~".OPERACIONES where")
sql.add("FechaOp= '"~IdxDate(dialogo.fecha1)~"' and TipoOp in ('SEI','SED')")
sql.add(" and NrOperacion in (select NrOperacion from OPERACIONESBITS where (NrBit = 20 and Valor = '1') or (NrBit = 50 and Valor = '1')) ")

if (Vacio(dialogo.nroperacion1))
