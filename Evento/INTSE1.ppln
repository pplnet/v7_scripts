sql.add("DELETE "~Dbo()~".MOVIMIENTOS where ")
sql.add("NrOperacion IN ")
sql.add("(Select  O.NrOperacion from "~Dbo()~".OPERACIONES O,"~Dbo()~".MOVIMIENTOS M , "~Dbo()~".OPERACIONESBITS B where ")
sql.add("O.FechaOp= '"~IdxDate(dialogo.fecha1)~"' and O.TipoOp in ('SEI','SED') ")

if (Vacio(dialogo.nroperacion1))
if (NoVacio(dialogo.especie1))
sql.add("and O.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
sql.add("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
