Act(z5, SQLAhora())
Acn(z6, 1)
Act(z7, 'Convert(varbinary(8),'~SQLAhora()~')')
Act(z8, Fbn()['TipoOp']~' '~Fbn()['Especie'])

Act(z9, 'DEP')

if (Eqstr(Fbn()['TipoOp'], 'SED'))
Act(z9, 'RET')
endif

Sqladd("Insert into "~Dbo()~".MOVIMIENTOS (")
Sqladd("Tipo_Operacion_Codigo, Tipo_Movimiento_Codigo, NrOperacion, ")
Sqladd("Compania_Codigo_FPA, Entidad_Codigo, Moneda_Codigo, ")
Sqladd("Movimiento_Fecha, Movimiento_Monto, Tipo_de_Cambio, ")
Sqladd("Estado, Add_Uid, Add_Date, ")
Sqladd("Update_Uid, Update_Date, Movimiento_Numero, Concepto")
Sqladd(") Values (")
Sqladd(" '"~Val(z2)~"', '"~Val(z9)~"', '"~Fbn()['NrOperacion']~"', ")
Sqladd(" '"~Fbn('Vehiculo1')~"', '"~Fbn('Cliente1')~"', '"~Fbn('Especie')~"', ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', "~FStr(Fbn('Cantidad'), 1, 2)~", "~FStr(Val(z3), 1, 6)~", ")
Sqladd(" 'Pendiente', "~Val(z4)~", "~Val(z5)~",  ")
Sqladd(" "~Val(z4)~", "~Val(z5)~", "~FStr(Val(z6), 1, 0)~", '"~Val(z8)~"' ")
Sqladd(")")
Sqlnew()
Sqlexec()
else
Dfa()
endif

proximo

if (Val(z1) = 0)
Messagebox('No se encontraron Registros')
endif

Act(a:fac + 2, 'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)
FormatoCeldas(e1..e:fac, Exe('F2'))
LimitesVision(g:fac + 1)

