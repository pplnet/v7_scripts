HojaVisible(SI)
creardialogo
fecha1:'Fecha';;;;;;NoVacio(dialogo.fecha1);'Debe Ingresar una Fecha';NO;FSys()
especie1:'Especie';;;;;;;;;
vehiculo1:'Vehiculo';;;;;;;;;
lista2:'TipoOp';;;;;;;;;;;SQLSet("Select Codigo from "~Dbo()~".TIPOSOPERACION Where Codigo in ('SEI','SED') ")
nroperacion1:'NrOperacion';;;;;;;;;

findialogo

if (not ok)
Cancelar()
endif

if (not Vacio(dialogo.vehiculo1))
if (not Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) y not Vacio(UsrVehiculos(UsuarioActivo())))
Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
endif
endif

Act(zz6, SQLSet("Select Vehiculo from "~Dbo()~".USRVEHICULO where Codigo = '"~UsuarioActivo()~"'"))


if (NoVacio(dialogo.nroperacion1))

Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif

endif

Act(a1, 'Listado de Movimientos Generados para Interfase Contable')
Act(a2, 'Operaciones de incremento y decremento de cartera')

SetFilaActual(Fac() + 4)

if (NoVacio(dialogo.vehiculo1))
Act(a:fac, 'Vehiculo: '~dialogo.vehiculo1)
else
Act(a:fac, 'Vehiculo: Todos')
endif

if (NoVacio(dialogo.especie1))
Act(a:fac + 1, 'Especie: '~dialogo.especie1)
else
Act(a:fac + 1, 'Especie: Todas')
endif

SetFilaActual(Fac() + 2)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

Act(a:fac, 'Especie')
Act(b:fac, 'Vehiculo')
Act(c:fac, 'TipoOp')
Act(d:fac, 'NrOperacion')
Act(e:fac, 'Cantidad')
Act(f:fac, 'Cotiz.')
Act(g:fac, 'Imp.Total')
AgregarMarco(a:fac..g:fac, 1, 0, Exe('COLOR'))

SetFont(a1..g:fac, 1)
Messagebox('Testeo Positivo ')
Sqladd("DELETE "~Dbo()~".MOVIMIENTOS where ")
Sqladd("NrOperacion IN ")
Sqladd("(Select  O.NrOperacion from "~Dbo()~".OPERACIONES O,"~Dbo()~".MOVIMIENTOS M , "~Dbo()~".OPERACIONESBITS B where ")
Sqladd("O.FechaOp= '"~IdxDate(dialogo.fecha1)~"' and O.TipoOp in ('SEI','SED') ")

if (Vacio(dialogo.nroperacion1))
if (NoVacio(dialogo.especie1))
Sqladd("and O.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and Vehiculo IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd("and O.TipoOp In ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
else
Sqladd("and O.NrOperacion='"~dialogo.nroperacion1~"' ")
endif

Sqladd("and M.Tipo_Movimiento_Codigo='RET' ")
Sqladd("and M.Tipo_Operacion_Codigo=O.TipoOp ")
Sqladd("and M.NrOperacion=O.NrOperacion ")
Sqladd("and M.Movimiento_Numero=1) ")
Sqlnew()

Sqladd("DELETE "~Dbo()~".MOVIMIENTOS where ")
Sqladd("NrOperacion IN ")
Sqladd("(Select  O.NrOperacion from "~Dbo()~".OPERACIONES O,"~Dbo()~".MOVIMIENTOS M where ")
Sqladd("O.FechaOp= '"~IdxDate(dialogo.fecha1)~"' and O.TipoOp in ('SEI','SED')")

if (Vacio(dialogo.nroperacion1))
if (NoVacio(dialogo.especie1))
Sqladd("and O.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and Vehiculo IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd("and O.TipoOp In ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
else
Sqladd("and O.NrOperacion='"~dialogo.nroperacion1~"' ")
endif
Sqladd("and M.Tipo_Movimiento_Codigo='DEP' ")
Sqladd("and M.Tipo_Operacion_Codigo=O.TipoOp ")
Sqladd("and M.NrOperacion=O.NrOperacion ")
Sqladd("and M.Movimiento_Numero=1) ")
Sqlnew()
Sqlexec()

Sqladd("Select * ")
Sqladd("from "~Dbo()~".OPERACIONES where")
Sqladd("FechaOp= '"~IdxDate(dialogo.fecha1)~"' and TipoOp in ('SEI','SED')")
Sqladd(" and NrOperacion in (select NrOperacion from OPERACIONESBITS where (NrBit = 20 and Valor = '1') or (NrBit = 50 and Valor = '1')) ")

if (Vacio(dialogo.nroperacion1))
if (NoVacio(dialogo.especie1))
Sqladd("and Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.vehiculo1))
Sqladd("and O.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and Vehiculo IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd("and TipoOp In ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
else
Sqladd("and NrOperacion='"~dialogo.nroperacion1~"' ")
endif
Sqladd("order by Especie,Vehiculo1,TipoOp,NrOperacion")

Acn(z1, 0)

recorrer sql

if (Incluido(Fbn()['Vehiculo1'], Var('VLIQUIDA')~Var('VLIQUIDA2')))
Message('Procesando '~Fbn()['Especie']~' '~Fbn()['Vehiculo1']~' '~Fbn()['TipoOp']~' '~Fbn()['NrOperacion']~' ...')

if (not Eqstr(Val(aa1), Fbn()['Especie']~' '~Fbn()['Vehiculo1']~' '~Fbn()['TipoOp']))
Act(aa1, Fbn()['Especie']~' '~Fbn()['Vehiculo1']~' '~Fbn()['TipoOp'])
Act(a:fac, Fbn()['Especie'])
Act(b:fac, Fbn()['Vehiculo1'])
Act(c:fac, Fbn()['TipoOp'])
SetFont(a:fac..c:fac, 1)
endif

Act(d:fac, Fbn()['NrOperacion'])
Acn(e:fac, Fbn()['Cantidad'])
Act(f:fac, Fbn()['Precio1'])
Act(g:fac, Fbn()['TotalNetoCli1'])

SetFont(d:fac..g:fac, 2)

Acn(z1, 1)
Act(z2, Fbn()['TipoOp'])
Acn(z3, Fbn()['Precio1'])
