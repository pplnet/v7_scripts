FormatoCeldas(g1..g:Val(z1), Exe('F2'))

crearlistbox;'Arial,8,';'Operaciones Mercado no Neteado '
'Mod.';az:1..az:Val(x:1);SI;;;50;check;RGB(160, 160, 193)
'Mov';aa:1..aa:Val(x:1);NO;;;70;string;;RGB(250, 250, 193)
'Cliente';ab:1..ab:Val(x:1);NO;;;80;string;;RGB(250, 250, 193)
'Nombre';ac:1..ac:Val(x:1);NO;;;200;string;;RGB(250, 250, 193)
'Especie';ad:1..ad:Val(x:1);NO;;;60;string;;RGB(250, 250, 193)
'Cuenta';ae:1..ae:Val(x:1);NO;;;80;string;;RGB(250, 250, 193)
'Monto';af:1..af:Val(x:1);NO;;;100;numero;'##,###,###.##';RGB(250, 250, 193)
'Mercado';ag:1..ag:Val(x:1);NO;;;50;string;;RGB(250, 250, 193)
'Impreso';ah:1..ah:Val(x:1);NO;;;50;string;;RGB(250, 250, 193)
'Referencia';ai:1..ai:Val(x:1);NO;;;300;string;;RGB(250, 250, 193)
finlistbox

if (ok)
recorrer&i 1, Val(x:1)
if (Val(az:&i) = 1)
Sqladd("SELECT T.NrTrans From TRANSACCIONES2 T ")
Sqladd(" Where NrTrans in("~Pipe2Comillas(Val(ai:&i))~") ")
Sqladd("   and Cantidad26=0 ")
Watch(Sqlbatch())
recorrer sql
Act(y:1, Val(ai:&i))
if (Eqstr(Val(ah:&i), '') o Eqstr(Val(ah:&i), '0') o Vacio(Val(ah:&i)))
Linkearhoja('EVOUV1', 1, 'nrtrans1', Fbn()['NrTrans'], 'check1', 0, 'check3', 0, 'string', Val(y:1))
else
Linkearhoja('EVOUV1', 1, 'nrtrans1', Fbn()['NrTrans'], 'check1', 1, 'check3', 0, 'string', Val(y:1))
