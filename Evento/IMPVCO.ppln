Sqladd("Update "~Dbo()~".TRANSACCIONES2 ")
Sqladd("   Set  CB1 = '1' ")
Sqladd(" Where NrTrans in("~Pipe2Comillas(Val(ai:&i))~") ")
Sqlnew()

Sqladd("Update "~Dbo()~".VOUCONSOLIDADOS ")
Sqladd("   Set    Impreso = '1' ")
Sqladd(" Where Id ="~FStr(Val(aa:&i), 1, 0))
