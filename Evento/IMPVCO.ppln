creardialogo
fecha1: 'F.Liquid';;;;;;;;;FSys()
mercado1: 'Mercado';
check1: 'Reimpresion'
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select V.*,E. Nombre, C.RazonSocial ")
Sqladd("   from "~Dbo()~".VOUCONSOLIDADOS V, "~Dbo()~".ESPECIES E, "~Dbo()~".CLIENTES C ")
Sqladd("  where V.Especie = E.Codigo      ")
Sqladd("    and V.Cliente = C.Codigo      ")
Sqladd("    and V.Fecha="~IdxDate2(dialogo.fecha1))
Sqladd("    and V.MontoADebCred=V.MontoDebCred")

if (NoVacio(dialogo.mercado1))
Sqladd(" and V.Mercado = '"~dialogo.mercado1~"' ")
endif
if (dialogo.check1 = 0)
Sqladd(" and (V.Impreso is Null or V.Impreso=0) ")
else
Sqladd(" and (V.Impreso =1) ")
endif

Watch(Sqlbatch())
recorrer sql
Acn(az:fac, 1)
Act(aa:fac, Fbn()['Id'])
Act(ab:fac, Fbn()['Cliente'])
Act(ac:fac, Fbn()['RazonSocial'])
Act(ad:fac, Fbn()['Especie'])
Act(ae:fac, Fbn()['Cuenta'])
Acn(af:fac, Fbn()['MontoDebCred'])
Act(ag:fac, Fbn()['Mercado'])
Act(ah:fac, Fbn()['Impreso'])
Act(ai:fac, Fbn()['Referencia'])
Scn(z1, 1)
Acn(x1, Fac())
proximo

if (Val(z1) = 0)
Cancelar('No existen Vouchers para imprimir')
else
ACO(1, 9)
