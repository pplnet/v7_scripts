CrearDialogo
  String1: 'Cod.MAE'     ;1;1; ;SI;SI;;;;;;;;'XXXXX'
  String2: 'Memotecnico' ;2;1; ;SI;SI;;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
  Entero1: 'Cupon'       ;3;1; ;SI;SI;;;;;;;;'999'
  Check1:  'Procesa'     ;1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, 'Codidgo MAE')
ACT(a:2, 'Memotecnico MAE')
ACT(a:3, 'Procesa')
ACT(a:4, 'Cant.Esp Cod MAE')
ACT(a:5, 'Codigo alta')

ACT(a:6, 'Iteracion')
ACT(a:7, 'Cant.Esp Codigo')
ACT(a:8, 'Jerarquia')
ACT(a:9, 'Error')
ACT(a:10, 'Accion')

ACT(b:1, Dialogo.String1)
ACT(b:2, Dialogo.String2)
ACN(b:3, Dialogo.Check1)

** Voy a controlar por las dudas.
ACN(b:4, SQL("Select Count(*) From "~DBO~".ESPECIES Where CodMAEContado='"~Val(b:1)~"' "))
if Val(b:4)>0
  ACN(b:9, 1)
endif
if Val(b:9)=0
  ACT(b:5, Dialogo.String1)
  recorrer&i 0,9
    ACN(b:6, &i)
    ACN(d:&i+1, Val(b:6))
    ACT(e:&i+1, Val(b:5))
    ACN(b:7, SQL("Select Count(*) From "~DBO~".ESPECIES Where Codigo='"~Val(b:5)~"' "))
    ACN(f:&i+1, Val(b:7))
    if Val(b:7)=0
      ACT(g:&i+1, 'break 1')
      break
    else
      if &i=9
        ACN(b:9, 1)
        ACT(g:&i+1, 'break 2')
        break
      endif
      ACT(b:5, Dialogo.String1~FStr(&i,1,0))
    endif
  proximo
endif

if Val(b:9)=0
  * No hubo errores
  if Dialogo.Check1=1
    ACT(b:8, GenerarJerarquiaPorReferencia('ESPECIES',Var('JERAUTOMA'),si))
    SQL.ADD("Insert into "~DBO~".ESPECIES (")
    SQL.ADD("Jerarquia, ")
    SQL.ADD("Codigo, ")
    SQL.ADD("CodMAEContado, ")
    SQL.ADD("Nombre, ")
    SQL.ADD("Extendido, ")        
    SQL.ADD("Status, ")
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
    SQL.ADD("Cupon, ")
    SQL.ADD("EstadoOperativo ")
        
    SQL.ADD(") values (")

    SQL.ADD(" '"~Val(b:8) ~"', ")           
    SQL.ADD(" '"~Val(b:5)~"', ")
    SQL.ADD(" '"~Dialogo.String1~"', ")
    SQL.ADD(" '"~Copy(Dialogo.String2,1,15)~"', ")
    SQL.ADD(" '"~Dialogo.String2~"', ")
    SQL.ADD(" 'DES', ")        
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
    SQL.ADD(" "~FStr(Dialogo.Entero1,1,0)~", ")
    SQL.ADD(" 'NE' ")        
    SQL.ADD(")")
    SQL.NEW
    SQL.EXEC
  endif
  ACT(b:10, 'Alta especie '~Val(b:5))
endif

ACO(1,15)
ACO(2,10)
