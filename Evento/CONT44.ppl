MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:   'Fecha'    ;1;;;;;;;;fsys
  Especie1: 'Especie'  ;;;;;;NoVacio(Dialogo.Especie1);'Especie Invalida';NO;;;;;;
  Vehiculo1:'Vehiculo' ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalida';NO;;;;;;
  Check1:   'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

***---Se pueden reversar asientos enviados, para una especie y vehiculo

SQL.ADD(" Select MA.Codigo CodAsi ")
SQL.ADD(" From "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" Where MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEFC'))~") ")
Recorrer SQL
    ***---Busco Asientos de cada modelo
    SQL.ADD(" Select Distinct AC.FechaGeneracion,  AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
    SQL.ADD(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
    SQL.ADD(" From "~DBO~".ASIENTOSCON AC, "~DBO~".ASIENTOSCON1 AC1 ")
    SQL.ADD(" Where AC.NrUnicoAsiento = AC1.NrUnicoAsiento ")
    SQL.ADD(" AND AC.Modelo = '"~fbn('CodAsi')~"' ")
    SQL.ADD(" AND AC.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND AC1.Alias7 = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND AC.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD(" AND AC.Estado = 'E' ")
    SQL.ADD(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
    Recorrer SQL
        Message('Reversando Asiento '~fbn('NrUnicoAsiento'))
        ACT(NN:1, GetNumerador(810))
        SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
        SQL.ADD(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
        SQL.ADD(" Modelo, Book, UDN, Centro, ")
        SQL.ADD(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
        SQL.ADD(" NrOperacion, NrTrans2, Estado, Fecha1) ")
        SQL.ADD(" VALUES ")
        SQL.ADD(" ('"~Idxdate(fsys)~"', '"~Idxdate(fbn('FechaValor'))~"', '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
        SQL.ADD(" '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
        SQL.ADD(" '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(NN:1)~"', ")
        SQL.ADD(" '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', 'REV', '"~Idxdate(Dialogo.Fecha1)~"') ")
        SQL.NEW
        SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"'  ")
        Recorrer SQL
           SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
           SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
           SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
           SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
           SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
           SQL.ADD(" Detalle, CentroCosto, Book, ")
           SQL.ADD(" Alias6, Alias7, Alias8, ")
           SQL.ADD(" Alias9, Alias10, Valor1, ")
           SQL.ADD(" Valor2, Valor3 ")
           SQL.ADD(" ) VALUES ( ")
           SQL.ADD(" '"~Val(NN:1)~"', '"~fbn('Cuenta')~"', ")
           If Eqstr(fbn('DebitoCredito'), 'DEB')
              SQL.ADD(" 'CRE', ")
           Else
              SQL.ADD(" 'DEB', ")
           Endif
           SQL.ADD(" '"~fbn('Especie1')~"', ")
           SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,8)~", "~fstr(fbn('Cantidad2'),0,8)~", ")
           SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
           SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', ")
           SQL.ADD(" '"~fbn('Detalle')~"', '"~fbn('CentroCosto')~"', '"~fbn('Book')~"', ")
           SQL.ADD(" '"~fbn('Alias6')~"', '"~fbn('Alias7')~"', '"~fbn('Alias8')~"', ")
           SQL.ADD(" '"~fbn('Alias9')~"', '"~fbn('Alias10')~"', "~Fstr(fbn('Valor1'), 0, 2)~", ")
           SQL.ADD(" "~Fstr(fbn('Valor2'), 0, 8)~", "~Fstr(fbn('Valor3'), 0, 0)~") ")
           SQL.NEW
        Proximo
        SQL.EXEC
        ***---Marco el asiento
        SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
        SQL.ADD(" Set NrAsiento = '"~Val(NN:1)~"' ")
        SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
        SQL.NEW
        SQL.EXEC
        MessageBox('Asiento '~fbn('NrUnicoAsiento')~' Reversado')
        EjecutarEvento('CONT5', Fecha1=Dialogo.Fecha1, Especie1=Dialogo.Especie1, Lista1=Dialogo.Vehiculo1, Check1=1)
    Proximo
Proximo