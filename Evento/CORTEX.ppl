CrearDialogo
  Especie1   :'Especie'      ;;;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y NOT DesciendeDeEspecie(Dialogo.Especie1,'CUPON');'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' "
  Fecha1     :'F.Corte'      ;2;1;;NO;;Dialogo.Fecha1<>0 y Dialogo.Fecha1>=SQL(" SELECT FechaCorte FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ");'La fecha ingresada es anterior a la fecha de corte del proximo cupon.';SI;FSys;SQL(" SELECT FechaCorte FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
  Fecha2     :'F.Pago'       ;3;1;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2>= Fsys;'Fecha de Pago Invalida';NO;;IIF(SQL(" Select FechaPago From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ") >= Fsys, ProxCupon2(Dialogo.Especie1, Fsys), Fsys)
  Especie2   :'Pago en'      ;;;;NO;;NoVacio(Dialogo.Especie2);'Debe Actualizar la Especie Cupon';NO;CotizaEn(Dialogo.Especie1);CotizaEn(Dialogo.Especie1)
  Entero3    : 'num cupon'   ;;;;NO;NO;;;;;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
  Entero1    :'Nr.Cupon'     ;;;;;;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;0;IIF(Dialogo.Entero3>0, Dialogo.Entero3,0)
  Entero2    :'CupActual'    ;;;;;;Dialogo.Entero2>=0;'Debe Ingresar el Numero de Cupon Nuevo';NO;0;IIF(Dialogo.Entero3>0, Dialogo.Entero1+1,0)
  Fecha4     :'F.Actualiz'   ;;;;;;;;;fsys
  Precio6    :'Pr.Cupon'     ;;;;;;;
  Precio7    :'Pr.$.Cupon'   ;;;;;;;
  **// Se agrego, lo usaba CORTE1
  Check6     :'CB5'          ;;;;;;;
** FJL 30/07/2020 - Agrego estos capmpos que los estaba pasando el CORTE1
  Fecha5     :'F.Inicio'       ;  ; ;;NO;Dialogo.Check6=1;Dialogo.Check6 = 0 o Dialogo.Fecha5>0         ;'Fecha de Inicio de Indice Ivalida';NO;BuscarCampo('ESPECIES','FEmision','Codigo',Dialogo.Especie1);BuscarCampo('ESPECIES','FEmision','Codigo',Dialogo.Especie1);
  Especie4   :'Indice'         ;  ; ;;NO;Dialogo.Check6=1;Dialogo.Check6 = 0 o NoVacio(Dialogo.Especie4);'Indice Invalido'       ;NO;BuscarCampo('ESPECIES','Indice','Codigo',Dialogo.Especie1);BuscarCampo('ESPECIES','Indice','Codigo',Dialogo.Especie1);
  Precio2    :'Indice Corte'   ;  ; ;;NO;Dialogo.Check6=1;Dialogo.Precio2>=0 o Dialogo.Check6=0         ;'Indice Corte Invalido' ;NO;IIF(Dialogo.Check6=1, Cotizacion(Dialogo.Especie4,,,,Dialogo.Fecha1,1,SI), 0);IIF(Dialogo.Check6=1, Cotizacion(Dialogo.Especie4,,,,Dialogo.Fecha1,1,SI), 0)
  Precio3    :'Indice Inicio'  ;  ; ;;NO;Dialogo.Check6=1;Dialogo.Precio3>=0 o Dialogo.Check6=0         ;'Indice Icinio Invalido';NO;IIF(Dialogo.Check6=1, Cotizacion(Dialogo.Especie4,,,,Dialogo.Fecha5,1,SI), 0);IIF(Dialogo.Check6=1, Cotizacion(Dialogo.Especie4,,,,Dialogo.Fecha5,1,SI), 0)
FinDialogo

SQL.ADD(" SELECT A.*, E.Jerarquia, E.Nombre, E.Tipo, E.Alias9 FROM "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E")
SQL.ADD(" WHERE  A.Especie = E.Codigo ") 
SQL.ADD(" AND    A.Especie = '"~Dialogo.Especie1~"'") 
SQL.ADD(" AND    A.NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")

Recorrer SQL
   *--------------------------- Especie Origen ----------------------------*
   ACT(a:2, fbn['Jerarquia'])
   ACT(b:2, fbn['Especie'])

   * Nr Cupon
   ACN(c:2, Dialogo.Entero1)
   ACT(d:2, fbn['Nombre'])

   * VT Corte
   ACN(e:2, fbn('VTeoricoAnt'))

   * Fecha de Corte
   ACD(g:2, fbn('FechaCorte'))

   ACT(j:2, VAR('VEHICULODE'))

   * Amortizacion
   ACN(k:2, fbn('PorAmCapital'))

** FJL 27/06/18 - Ingreso de TNA
   * TNA
   ACN(s:2, fbn('TNA'))
   * Renta
   ACN(l:2, fbn('PorRenta'))

   * Cap Int
   ACN(m:2, fbn('PorAmIntCap'))

   * Nr Cupon
   ACN(n:2, Dialogo.Entero1)

   * Tipo de Especie
   ACT(o:2, fbn['Tipo'])

   *-----------------------------Nuevo Cupon--------------------------------*
   * Cupon Actual + 1

   ACN(c:3, Dialogo.Entero2)

   * VT Actual - (%Amort /100 )
   ACN(e:3, Val(e2)-(Val(k2)/100))

   ACN(E:99, Round(Val(e2), 7) - Round((Val(k2)/100), 7))

   ACN(f:3, Val(k2)/100)

   IF Val(E:99) <= 0
       message('Amortizo todo el capital, => no hay proximo cupon')
       ACN(C:3, 0)
   ENDIF
   *---------------------------- Especie Cupon -----------------------------*
   ACT(b:4, fbn('Alias9'))

   * Fecha Proximo Corte
   ACD(h:4, SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Val(b2)~"' AND NrCupon = '"~FSTR(VAL(c2),0,0)~"' ") )

   * Cupon Nuevo
   ACN(c:4, Val(c:3))
Proximo

*- Variables para Calcular el Efectivo en el caso que genere movimientos de pago en forma automatica
*- aa8: Amortizacion   aa9: Renta   aa10: Ints. Cap

ACN(aa:8, val(k:2)/100 )
ACN(aa:9, Val(l:2)/100 )
ACN(aa:10, Val(m:2)/100 )

if Dialogo.Check6 = 1
   ACN(aa:31, Dialogo.Precio2/Dialogo.Precio3 )
   act(aa:12, Dialogo.Especie4)
else
   ACN(aa:31, 1)
   act(aa:12, '')
endif

* --- Precio del Cupon - Viene del evento CORTE1.
ACN(aa:5, Dialogo.Precio6)

* --- Precio del Cupon en $ - Viene del evento CORTE1.
ACN(aa:6, Dialogo.Precio7)

ACT(aa:7, Dialogo.Especie2)

* --------------------------------------------------------------------------------------- *
*FO 15/03/2006 ACT(Y1,GetNumerador(1))
ACT(Y:1,GetNumerador(80))
Message('Generando transaccion ACUPON '~Val(y1))
SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
SQL.ADD(" Especie, Especie2, Cupon1, ")
SQL.ADD(" Fecha1, Fecha2, Fecha3,    ")
SQL.ADD(" Precio1, Precio2, ")
** FJL 27/06/18 - Ingreso de TNA
SQL.ADD(" Precio4, ")
******
SQL.ADD(" Precio3, Cambio1, ")
SQL.ADD(" Cambio2, Vehiculo1, ")
SQL.ADD(" TipoTr2, NrTrans,  ") 
SQL.ADD(" FechaCarga, FechaCargaSys, ") 
SQL.ADD(" UsrInput,Cupon2, ")
SQL.ADD(" CB5, Especie3, ") 
SQL.ADD(" Precio5, Cambio3, ") 
SQL.ADD(" Cambio4, Especie4  ")
SQL.ADD(" ) VALUES ( ")
SQL.ADD(" '"~Val(b:2)~"', '"~Val(b:4)~"', '"~FStr(Val(c:2),1,0)~"',")
SQL.ADD(" '"~IdxDate(Val(g:2))~"', '"~IdxDate(Val(h:4))~"', '"~IdxDate(Dialogo.Fecha4)~"', ")
SQL.ADD(" "~FStr(Val(k:2),1,10)~", "~FStr(Val(l:2),1,10)~", ")    
** FJL 27/06/18 - Ingreso de TNA
SQL.ADD(" "~FStr(Val(s:2),1,10)~", ")
******
SQL.ADD(" "~FStr(Val(m:2),1,10)~", "~FStr(Val(e:2),1,9)~", ")
SQL.ADD(" "~FStr(Val(e:3),1,9)~", '"~VAL(j:2)~"', ")
SQL.ADD(" 'ACUPON', '"~Val(Y:1)~"'," )
SQL.ADD(" "~SQLAhora~", "~IDXDATE2(FSYS)~", ") 
SQL.ADD(" '"~UsuarioActivo~"','"~FStr(Val(c:3),1,0)~"', ")
SQL.ADD(" '"~Fstr(Dialogo.Check6,0,0)~"', '"~Val(aa:12)~"', ") 
SQL.ADD(" "~FStr(Val(aa:31),1,8)~", "~FStr(Val(aa:5),1,8)~", ") 
SQL.ADD(" "~FStr(Val(aa:6),1,8)~", '"~Dialogo.Especie2~"' ")
SQL.ADD(" ) ")
SQL.NEW  
SQL.EXEC

*- Alta en la Instancia nro. 4
ACT(az3,val(y:1))
ACT(az4,'TRANSACCIONES2')
ACT(az5,'4|')
(.'ALTAINSTAN'.)   
* ---------------------------------------------------------------------------------------- *

*MESSAGEBOX(Dialogo.Especie1)
*MESSAGEBOX(Val(fr:1))
ACT(er:1, Dialogo.Especie1)
ACD(fr:1, Habiles(Dialogo.FECHA4,-1,'ARG') )
ACN(cr:1, Cotizacion(Dialogo.Especie1,,,,Val(fr:1),5))
If Val(c:3)<=0 y Val(cr:1)<>0
   * Cuando amortiza 100% restea precio de posicion
   ACN(cr:2, 1)
   (.'CUPONRESET'.)
Endif

Message('Corte de Posiciones. ')
SQL.ADD(" Select Max(Fecha) as Fecha,Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,")
* FJL 25/06/20 - Se agrega el campo Estrategia que utilizan los saldos 121 y 122
*SQL.ADD(" Book,Cupon,Sector From "~DBO~".POSICIONES P1 ")
SQL.ADD(" Book,Cupon,Sector,Estrategia, IsNull(TipoPosicion,'') TipoPosicion ")
SQL.ADD(" From "~DBO~".POSICIONES P1 ")
SQL.ADD(" Where P1.Especie = '"~Dialogo.Especie1~"'    ")
SQL.ADD(" and   P1.Fecha  <= '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" and   P1.Cupon   = '"~FSTR(VAL(c:2),1,0)~"'   ")
* FJL 24/04/18 - Se agregan Posiciones Nuevas
* SQL.ADD(" and   P1.NrSaldo IN (171,172)                ")
* FJL 06/11/19 - Se saca esta condicion para que corte todos las posiciones
* SQL.ADD(" and   (P1.NrSaldo IN (171,172) or (P1.NrSaldo >= 190 and P1.NrSaldo < 200)) ")
* FJL 25/06/20 - Se agrega el campo Estrategia que utilizan los saldos 121 y 122
*SQL.ADD(" Group By Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,Book,Cupon,Sector ")
SQL.ADD(" Group By Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,Book,Cupon,Sector,Estrategia, IsNull(TipoPosicion,'') ")
Recorrer SQL
   DFA
   Message("Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0)~' '~FBN['Vehiculo']~' '~FBN['PrecioEj']~' '~FBN['FechaEj']~' '~FBN['Book'])

   SQL.ADD("Select * From "~DBO~".POSICIONES P ") 
   SQL.ADD(" Where Especie     = '"~Dialogo.Especie1~"' ") 
   SQL.ADD("   and CantidadFin <> 0 ") 
   SQL.ADD("   and Fecha       = '"~IdxDate(FBN['Fecha'])~"' ")
   SQL.ADD("   and Cliente     = '"~FBN['Cliente']~"' ") 
   SQL.ADD("   and Vehiculo    = '"~FBN['Vehiculo']~"' ")
   SQL.ADD("   and NrSaldo     = "~Fstr(FBN['NrSaldo'],0,0)~" ")
   If NoVacio(FBN['PrecioEj'])
     SQL.ADD(" and PrecioEj    =  "~Fstr(FBN['PrecioEj'],0,8)~" ")
   Else 
     SQL.ADD(" and (PrecioEj   = '' or PrecioEj Is Null or PrecioEj = ' ') ")
   EndIf
   If NoVacio(FBN['FechaEj'])
     SQL.ADD(" and FechaEj     = '"~IdxDate(FBN['FechaEj'])~"' ")
   Else 
     SQL.ADD(" and (FechaEj    = '' or FechaEj Is Null or FechaEj = ' ') ")
   EndIf
   If NoVacio(FBN['CallPut'])
     SQL.ADD(" and CallPut     = '"~FBN['CallPut']~"' ")
   Else 
     SQL.ADD(" and (CallPut    = '' or CallPut Is Null or CallPut = ' ') ")
   EndIf  
   If NoVacio(FBN['Sector'])
     SQL.ADD(" and Sector      = '"~FBN['Sector']~"' ")
   Else 
     SQL.ADD(" and (Sector     = '' or Sector Is Null or Sector = ' ') ")
   EndIf
* FJL 25/06/20 - Se agrega el campo Estrategia que utilizan los saldos 121 y 122
   If NoVacio(FBN['Estrategia'])
     SQL.ADD(" and Estrategia      = '"~FBN['Estrategia']~"' ")
   Else 
     SQL.ADD(" and (Estrategia     = '' or Estrategia Is Null or Estrategia = ' ') ")
   EndIf  
* PZ 12/07/24 - Se agrega el campo TipoPosicion que utilizan los saldos 121 y 122
   If NoVacio(FBN['TipoPosicion'])
     SQL.ADD(" and TipoPosicion      = '"~FBN['TipoPosicion']~"' ")
   Else 
     SQL.ADD(" and (TipoPosicion     = '' or TipoPosicion Is Null or TipoPosicion = ' ') ")
   EndIf  
   
   SQL.ADD(" and Book          = '"~FBN['Book']~"' ") 
   SQL.ADD(" and Cupon         = '"~FBN['Cupon']~"'  ")

   Recorrer SQL
      ACN(y:2, 0)   
      Message("Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0)~' '~FBN['Vehiculo']~' '~FBN['PrecioEj']~' '~FBN['FechaEj']~' '~FBN['Book'])    

      ACN(x:1,FBN['Fecha'])
      ACN(z:1,FBN['CantidadFin'])
      ACN(z:2,FBN['PrecioFin'])

      If Not Eqstr(Dialogo.Especie2,VAR('MONELOCA') )
        ACN(z:93, Val(z:2)-Val(aa:6))
      Else
        ACN(z:93, Val(z:2)-Val(aa:5))
      Endif

      (.'CUPINSPOSA'.)
   Proximo
Proximo
