Message('Calculando los Plazos .... ')

Acn(z4, dialogo.fecha3 - FSys())
Acn(z5, dialogo.fecha3 - FSys())

Acd(z14, dialogo.fecha3)
Acd(z15, dialogo.fecha3)

Acn(a1, Val(z4))
Acn(a2, 1)

if (Val(z10) = 0)
Acn(z9, CotizacionC(Val(z17), null, null, null, FSys(), 1, SI, 'ARP') / CotizacionC(Val(z16), null, null, null, FSys(), 1, SI, 'ARP'))
else
Acn(z9, CotizacionC(Val(z16), null, null, null, FSys(), 1, SI, 'ARP') / CotizacionC(Val(z17), null, null, null, FSys(), 1, SI, 'ARP'))
endif

Message('Generando Operacion de Ejercicio .... ')
Sqladd("INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd("(TipoOp, Book1,NrOperacion, Especie, ")
Sqladd(" Cliente1, Precio1, ")
Sqladd(" ContraEspecie, ")
Sqladd(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
Sqladd(" Operador, Vehiculo1, ")
Sqladd(" ValorRB1, Puesto, Observac2, OperacionRef, TablaFeriados1, ")
Sqladd(" Precio4, RB7, CB6, ")
Sqladd(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,ValorRB2,RB6,TablaFeriados2, ")
Sqladd(" Cantidad, TotalBrutoCli1, TotalNetoCli1,RB3,PaseCB,Arbitraje,Cuenta1,Cuenta2) ")
Sqladd(" Values ")
Sqladd("('"~Val(z1)~"','"~Fbn()['Book1']~"', '"~Val(z3)~"', '"~Val(z16)~"', ")
Sqladd(" '"~Fbn()['Cliente1']~"', "~FStr(Fbn()['PrecioEj'], 0, 7)~", ")
Sqladd(" '"~Val(z17)~"', ")
Sqladd(" '"~IdxDate(FSys())~"', '"~IdxDate(Val(z14))~"', ")
Sqladd(" '"~IdxDate(Val(z15))~"', "~FStr(Val(z4), 2, 0)~", "~FStr(Val(z5), 2, 0)~", ")
Sqladd(" '"~Fbn()['Operador']~"', '"~Fbn()['Vehiculo1']~"', ")
Sqladd(" '"~FStr(Val(a1), 1, 0)~"', '"~FStr(Val(a2), 1, 0)~"', ")
Sqladd(" '"~Fbn()['Observac2']~"', '"~Fbn()['NrOperacion']~"', '"~Fbn()['TablaFeriados1']~"', ")
Sqladd(" "~FStr(Val(z9), 0, 7)~", '"~Fbn()['RB7']~"', '"~FStr(Fbn()['CB6'], 1, 0)~"', ")
Sqladd(" '"~Fbn()['UsrInput']~"', '"~IdxDate(FSys())~"', '"~Fbn()['Vehiculo2']~"', '"~Fbn()['MB4']~"', '"~Fbn()['RB10']~"', ")
Sqladd(" '"~FStr(Val(z6), 1, 0)~"','"~Val(z8)~"' ,'"~Val(z7)~"', ")
Sqladd(" "~Val(z11)~",'"~Fbn()['RB3']~"','0','0','"~Fbn()['Cuenta1']~"','"~Fbn()['Cuenta2']~"') ")
Sqlnew()
Sqlexec()

Sqlactualizarmovimientos(Val(z3), SI)
Sqlexec()

Message('Ingresando Instancias Operacion '~Val(az3)~' ...')

Sqladd("SELECT NrInstancia FROM "~Dbo()~".INSTANCIAS Where Tabla='"~Val(az4)~"' ")
Sqladd("ORDER BY NrInstancia ")

recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ")
Sqladd("(NrOperacion,NrBit,Valor) ")
Sqladd(" Values ")
Sqladd("('"~Val(az3)~"',"~FStr(Fbn()['NrInstancia'], 3, 0)~",")
if (Incluido(Fbn()['NrInstancia'], Val(az5)))
Sqladd("'1')")
else
Sqladd("'0')")
endif
Sqlnew()
Sqlexec()
proximo

