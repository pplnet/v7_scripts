endif

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
