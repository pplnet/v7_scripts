Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DFXO|'))
Cancelar('La Operacion '~dialogo.nroperacion1~' No es un Call o Put de Moneda')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (ok)
Acn(x1, 0)

Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and (CB8 is Null or CB8='0') ")
Sqladd("and ((TipoOpcion='0' and FechaEj = '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("and FechaOp2 <= '"~IdxDate(dialogo.fecha1)~"')) ")

recorrer sql
if (not EsHabil(dialogo.fecha3, Fbn()['TablaFeriados1']))
Messagebox('La Fecha de Settlement NO ES D¦a Habil en la Tabla de Feriados '~Fbn()['TablaFeriados1'])
break
endif

Acn(x1, 1)

Act(z16, Fbn()['Especie'])
Act(z17, Fbn()['ContraEspecie'])

Act(z11, " "~FStr(Fbn()['Cantidad'], 0, 7)~","~FStr(Fbn()['TotalAux1'], 0, 4)~","~FStr(Fbn()['TotalAux1'], 0, 4)~" ")

if (Eqstr(Fbn()['ContraEspecie'], 'ARP') o Eqstr(Fbn()['Especie'], 'ARP'))
if ((Eqstr(Fbn()['MB3'], '0') y Eqstr(Fbn()['MB1'], '0')) o (Eqstr(Fbn()['MB3'], '1') y Eqstr(Fbn()['MB1'], '1')))
Act(z1, 'FXCS')
else
Act(z1, 'FXVS')
endif
if (Eqstr(Fbn()['Especie'], 'ARP'))
Act(z16, Fbn()['ContraEspecie'])
Act(z17, Fbn()['Especie'])
if (Eqstr(Val(z1), 'FXCS'))
Act(z1, 'FXVS')
else
Act(z1, 'FXCS')
endif
endif
else
Act(z1, 'FXAS')
Acn(z6, 0)
Act(z7, BuscarCampo('Especies', 'PaisOrigen', 'Codigo', Val(z17)))
Act(z8, '1')

if (not ((Eqstr(Fbn()['MB3'], '0') y Eqstr(Fbn()['MB1'], '0')) o (Eqstr(Fbn()['MB3'], '1') y Eqstr(Fbn()['MB1'], '1'))))
Act(z16, Fbn()['ContraEspecie'])
Act(z17, Fbn()['Especie'])

Act(z11, " "~FStr(Fbn()['TotalAux1'], 0, 4)~","~FStr(Fbn()['Cantidad'], 0, 4)~","~FStr(Fbn()['Cantidad'], 0, 4)~" ")
endif
endif

Acn(z10, iif (Eqstr(Query(" Select Modo from "~Dbo()~".MODOESPECIES where Especie1='"~Fbn()['Especie']~"' and Especie2='"~Fbn()['ContraEspecie']~"' "), 'INV'), 0, 1))

if (Fbn()['MB1'] = 0)
if (Val(z10) = 0)
Acn(z2, (Fbn()['PrecioEj'] / dialogo.precio2) - 1)
if (0 > Val(z2))
Acn(z2, 0)
endif
else
Acn(z2, (dialogo.precio2 / Fbn()['PrecioEj']) - 1)
if (0 > Val(z2))
Acn(z2, 0)
endif
endif
else
if (Val(z10) = 0)
Acn(z2, 1 - (Fbn()['PrecioEj'] / dialogo.precio2))
if (0 > Val(z2))
Acn(z2, 0)
endif
else
Acn(z2, 1 - (dialogo.precio2 / Fbn()['PrecioEj']))
if (0 > Val(z2))
Acn(z2, 0)
endif
endif
endif

Acn(z2, Val(z2) * Fbn()['TotalAux1'])

if (Val(z10) = 0)
Acn(z2, Val(z2) / dialogo.precio3)
else
Acn(z2, Val(z2) * dialogo.precio3)
endif

if (Eqstr(Fbn()['MB3'], '1'))
Acn(z2, -Val(z2))
endif

Acn(z10, iif (Eqstr(Query(" Select Modo from "~Dbo()~".MODOESPECIES where Especie1='"~Val(z16)~"' and Especie2='"~Val(z17)~"' "), 'INV'), 0, 1))

if (Fbn()['RB10'] = 1 y Val(z2) <> 0)
Message('Obteniendo los Nros. de Operaciones a Generar .... ')

