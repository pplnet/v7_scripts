Sqladd("Where NrOperacion='"~Val(az3)~"' ")
Sqlnew()
Sqlexec()



endif

Message('Actualizando la Opcion .... ')

Acn(c1, CotizacionC(Fbn()['ContraEspecie'], null, null, null, dialogo.fecha1, 1, SI, Var('MONEEXTR')) ** iif (Eqstr(Modo(Fbn()['ContraEspecie'], 'USD'), 'DIR'), 1, -1))

Sqladd("Update "~Dbo()~".OPERACIONES ")
Sqladd("Set CB8 = '1', OperacionRef = '"~Val(z3)~"', ")
Sqladd("FechaPago = '"~IdxDate(dialogo.fecha3)~"', ")
Sqladd("FechaVto2 = '"~IdxDate(dialogo.fecha1)~"', ")
Sqladd("Precio4   = "~FStr(Val(z2), 0, 2)~", ")
Sqladd("Cotizacion2 = "~FStr(Val(c1), 0, 7)~",  ")
Sqladd("Precio2   = "~FStr(dialogo.precio2, 0, 7)~"  ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
