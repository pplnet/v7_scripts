creardialogo
nroperacion1:"Operacion";1;1;;;;Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DFXO');'El TipoOp ingresado debe ser  DFXO ';NO;;;;;;" TipoOp IN ('DFXO') and (CB8 is Null or CB8='0') ";
fecha1:"F Real Ej.";;;;NO;;dialogo.fecha1 <= dialogo.fecha4;'La Fecha de Ejercicio Real para esta Operacion es Invalida';NO;FSys()
precio2:"Precio_Ref";;;;;;dialogo.precio2 > 0;'El precio ref debe ser mayor a cero';NO
fecha3:"F Settlement";;;;dialogo.radio1 = 1;;EsHabil(dialogo.fecha3, 'ARG') y dialogo.fecha3 >= FSys();'La Fecha de Settlement es Incorrecta';NO;;FSys()
especie1:"Especie";;;;NO;;;;;;BuscarCampo('Operaciones', 'Especie', 'NrOperacion', dialogo.nroperacion1)
especie2:"ContraEspecie";;;;NO;;;;;;BuscarCampo('Operaciones', 'ContraEspecie', 'NrOperacion', dialogo.nroperacion1)
