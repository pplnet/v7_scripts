Sqladd(" Select DISTINCT O.NrOperacion,O.TipoOp,O.RB6 From ")
Sqladd(" "~Dbo()~".OPERACIONES O,"~Dbo()~".CUOTAS C ")
Sqladd(" where O.NrOperacion=C.NrOperacion ")
Sqladd(" and O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMONM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') ")
Sqladd(" and C.Fecha2>='"~IdxDate(dialogo.fecha1)~"' ")
if (dialogo.check1 = 1)
Sqladd("and O.TotalAux1 = "~FStr(dialogo.precio6, 0, 7)~" ")
endif
if (dialogo.check2 = 1)
Sqladd("and O.ImpGastos2 = "~FStr(dialogo.precio7, 0, 7)~" ")
endif
if (dialogo.check3 = 1)
Sqladd("and O.Precio3 = "~FStr(dialogo.precio8, 0, 7)~" ")
endif
if (dialogo.check4 = 1)
Sqladd("and O.Precio2 = "~FStr(dialogo.cantidad3, 0, 7)~" ")
endif
if (dialogo.check5 = 1)
Sqladd("and O.TasaPrecan = "~FStr(dialogo.cantidad2, 0, 7)~" ")
endif
if (dialogo.check6 = 1)
Sqladd("and O.ImpGastos1 = "~FStr(dialogo.cantidad1, 0, 7)~" ")
endif
if (dialogo.check7 = 1)
Sqladd("and O.TotalAux2 = "~FStr(dialogo.cantidad4, 0, 7)~" ")
endif
if (dialogo.check8 = 1)
if (dialogo.cantidad5 > 0)
Sqladd(" and ((O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') and O.TasaImp1="~FStr(dialogo.cantidad5, 0, 7)~")  ")
Sqladd(" or (O.TipoOp In ('MMONM') and C.Tasa3="~FStr(dialogo.cantidad5, 0, 7)~"))  ")
else
Sqladd(" and ((O.TipoOp In ('MMPEM','MMPIM','MMPCLM','MMPOSM','MMPCCM','MMCPM','MMFIMV','MMSIMV','MMCPM') and (O.TasaImp1 Is NULL or O.TasaImp1=0))  ")
Sqladd(" or (O.TipoOp In ('MMONM') and (C.Tasa3 IS NULL or C.Tasa3=0)))  ")
endif
endif
if (dialogo.check9 = 1)
Sqladd(" and O.IntDevengados1="~FStr(dialogo.cantidad7, 0, 7)~" ")
endif
if (dialogo.check10 = 1)
Sqladd(" and O.DeltaTasa="~FStr(dialogo.cantidad9, 0, 7)~" ")
endif
if (NoVacio(dialogo.nroperacion1))
Sqladd("and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif

recorrer sql

