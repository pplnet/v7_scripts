**-- VIMIML: Minuta Mesual de Capitalizacion de Intereses en LOTES
* HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;NOVACIO(Dialogo.Fecha1);'Debe Ingresar la Fecha';NO;Fsys
FinDialogo

if not Ok
  Cancelar
endif

* Obtengo el Ultimo Dia Habil Del Mes Anterior 
ACD(Z10,FinDeMes(Fsys-35,NO,'ARG'))

* Obtengo Todos los Pares de Vehiculos
** SQL.ADD("O.FechaOp>='"~IdxDate(VAL(Z10))~"' ")

SQL.ADD("SELECT O.Vehiculo1,O.Vehiculo2,O.Especie,SUM(O.TotalIntereses) As Interes ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where O.TipoOp='VIMIND' and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"'and ")
SQL.ADD(" (NrOperacion2 IS NULL Or NrOperacion2='') ")
SQL.ADD(" AND NOT EXISTS ")
SQL.ADD(" (SELECT * ")
SQL.ADD("from "~DBO~".OPERACIONES B")
SQL.ADD("where B.TipoOp='VIMINM' and B.FechaOp='"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("B.Vehiculo1=O.Vehiculo1 and B.Vehiculo2=O.Vehiculo2 and B.Especie=O.Especie) ")
SQL.ADD("Group By O.Vehiculo1,O.Vehiculo2,O.Especie ")
SQL.ADD("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

ACN(AB1,0)

Recorrer SQL
   Message('Procesando Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Vehiculo2']~' Especie:'~FBN['Especie']~' ...')

   * Envia Precio1=Tasa que es 0 
   EjecutarEvento('VIMINM',Fecha1=Dialogo.Fecha1,Vehiculo1=FBN['Vehiculo1'],Vehiculo2=FBN['Vehiculo2'],Especie1=FBN['Especie'],Precio1=VAL(A1))

   SCN(AB1,1)
Proximo  
  
IF VAL(AB1)=0
   * No se generaron intereses
   MessageBox('No Existen Operaciones Vinculadas para la fecha ...')
ENDIF
