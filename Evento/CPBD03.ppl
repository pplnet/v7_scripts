MostrarCuadroDeMensajes

(.'DNLISTA'.)
ACT(LL:1, VAl(l:1))
ACT(L:1, '')


CrearDialogo
  Especie1 : 'Moneda'    ;1;1;;;;NOVACIO(Dialogo.Especie1) ;'Moneda Invalida';NO;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
  Vehiculo1: 'Vehiculo'  ;1;2;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Fecha1   : 'FechaAcr'  ;2;1;;;;;;;FSYS
  Cuenta1  : 'Cuenta'    ;4;1;;;;NoVacio(Dialogo.Cuenta1);'Cuenta Invalida';NO;;;;;;"Estado = 'HAB' AND Cliente='"~Dialogo.Vehiculo1~"' AND (Especies LIKE '%"~Dialogo.Especie1~"%' OR Especies LIKE '%MONEDA%' ) "

  Label1   : ''          ;5; ;;NO;;;;;'Concilia por ______________________________________________________________________'
  Check1   : 'Fecha'     ;6; ;;;;;;;1
  Check2   : 'NrComprob' ;7; ;;;;;;;0
  Check3   : 'Importe'   ;8; ;;;;;;;1
  Cantidad1: 'Tolerancia';8;2;;;Dialogo.Check3=0;Dialogo.Cantidad1>0;'Rango de Tolerancia Invalido';NO;1
  Label1   : ''          ;9;1;;NO;;;;;'_______________________________________________________________________________________'
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(ch:3, Dialogo.Check3)
ACN(ch:1, Dialogo.Check1)
ACN(ch:2, Dialogo.Check2)
ACN(tl:1, Dialogo.Cantidad1)
ACD(fe:1, Dialogo.Fecha1)
ACT(vh:1, Dialogo.Vehiculo1)
ACT(ct:1, Dialogo.Cuenta1)
ACT(es:1, Dialogo.Especie1)


SQL.ADD(" SELECT /*+ RULE */ M.*, C.Comitente, C.Codigo CuentaFPA, E.Codigo MonedaFPA, C.Comitente BancoFPA, V.Codigo VehiculoFPA ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".DATANET D, "~DBO~".CLIENTES B, "~DBO~".CODIGOSDATANET CD ")
SQL.ADD(" WHERE M.Cuenta      = C.Numero  ")
SQL.ADD(" AND   M.NrDatanet   = D.NrDatanet ")
SQL.ADD(" AND   M.Moneda      = E.Alias3  ")
SQL.ADD(" AND   C.Comitente   = B.Codigo  ")
*SQL.ADD(" AND   M.Banco       = B.Alias2 ")
SQL.ADD(" AND   (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
SQL.ADD(" AND   M.Vehiculo    = V.Codigo  ")
SQL.ADD(" AND   M.TipoMov     = CD.Codigo (+) ")
SQL.ADD(" AND   V.Codigo      = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND   E.Codigo      = '"~Dialogo.Especie1~"'  ")
* 06/07/04 interfaz rio SQL.ADD(" AND   D.Archivo     IN ('DNCTAS','DNAHMS','DNCCDO','DNCADO','DNOTRO')  ")
SQL.ADD(" AND    D.Archivo      IN ("~Pipe2Comillas(Val(ll:1))~")  ")
SQL.ADD(" AND   CD.Tipo       IN ("~Pipe2Comillas(VAR('CPBD020'))~")  ")
SQL.ADD(" AND   M.NrMovDatanet NOT IN (SELECT MNrMovDatanet FROM "~DBO~".EXTRACTOS WHERE MNrDatanet=M.NrDatanet ) ")
If NoVacio(Dialogo.Cuenta1)
  SQL.ADD(" AND C.Codigo  = '"~Dialogo.Cuenta1~"' ")
Endif
SQL.ADD(" AND M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion, M.Cuenta ")

ACN(z:1, 0)
Recorrer SQL
    message('Datanet: '~fbn('NrDatanet')~' - Mov: '~fbn('NrMovDatanet'))
    SCN(z:1, 1)
    ACN(a:fac, 0)
    ACD(b:fac, fbn('FechaAcreditacion') )
    ACT(c:fac, fbn('Banco') )
    ACT(d:fac, fbn('Cuenta') )
    ACT(e:fac, fbn('Moneda') )
    ACN(f:fac, fbn('Importe') )
    ACT(g:fac, fbn('NrDatanet') )
    ACT(h:fac, fbn('CuentaFPA') )
    ACT(i:fac, fbn('MonedaFPA') )
    ACT(j:fac, fbn('BancoFPA') )
    ACT(k:fac, fbn('VehiculoFPA') )
    If NoVacio(fbn('Comprobante'))
      ACN(l:fac, fbn('Comprobante') )
    Endif
    ACN(m:fac, fbn('NrMovDatanet') )
    ACT(n:fac, fbn('TipoMov') )
    ACT(o:fac, fbn('DC') )
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron Movimientos de DATANET para conciliar.')
Endif

CrearListBox; 'Arial,8,'
  'OK'            ;a:1..a:FAC;SI;;;30;CHECK;RGB(232,255,215);
  'Extracto'      ;g:1..g:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'NrMov'         ;m:1..m:FAC;NO;;;40;NUMERO;'###,###';RGB(232,232,232);
  'Fecha Valor'   ;b:1..b:FAC;NO;;;80;FECHA;RGB(232,232,232);
  'Banco'         ;c:1..c:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'Cuenta'        ;d:1..d:FAC;NO;;;80;STRING;;RGB(232,232,232);
  'Moneda'        ;e:1..e:FAC;NO;;;70;STRING;;RGB(232,232,232);
  'Cantidad'      ;f:1..f:FAC;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'D/C'           ;o:1..o:FAC;NO;;;40;STRING;;RGB(232,232,232);
  'Comprobante'   ;l:1..l:FAC;NO;;;80;NUMERO;'###,###,###';RGB(232,232,232);
  'TipoMov'       ;n:1..n:FAC;NO;;;70;STRING;;RGB(232,232,232);
FinListBox

If Not Ok
  Cancelar('Evento Cancelado.')
Endif

Recorrer&i 1,fac
    If Val(a:&i)=1
      SQL.ADD(" SELECT /*+ RULE */ M.NrDatanet, M.NrMovDatanet, M.Vehiculo, M.FechaIngreso, M.FechaAcreditacion,")
      SQL.ADD(" C.Comitente, C.Codigo CuentaFPA, E.Codigo MonedaFPA, C.Comitente BancoFPA, ")
      SQL.ADD(" V.Codigo VehiculoFPA, M.Banco, M.Moneda, M.Comprobante, M.Cuenta, ")
      SQL.ADD(" DECODE(M.DC,'D',M.Importe*(-1),M.Importe) Importe  ")
      SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, ")
      SQL.ADD(" "~DBO~".VEHICULOS V, "~DBO~".DATANET D, "~DBO~".CLIENTES B, "~DBO~".CODIGOSDATANET CD ")
      SQL.ADD(" WHERE M.Cuenta      = C.Numero  ")
      SQL.ADD(" AND   M.NrDatanet   = D.NrDatanet ")
      SQL.ADD(" AND   M.Moneda      = E.Alias3  ")
      SQL.ADD(" AND   C.Comitente   = B.Codigo  ")
*      SQL.ADD(" AND   M.Banco       = B.Alias2 ")
      SQL.ADD(" AND   (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
      SQL.ADD(" AND   M.Vehiculo    = V.Codigo  ")
      SQL.ADD(" AND   M.TipoMov     = CD.Codigo  ")
      If Val(ch:1)=1
        * Misma Fecha
        SQL.ADD(" AND  M.FechaAcreditacion = "~IdxDate2(Val(b:&i))~" ")
      Endif
      SQL.ADD(" AND   V.Codigo      = '"~Val(vh:1)~"' ")
      SQL.ADD(" AND   E.Codigo      = '"~Val(es:1)~"' ")
      SQL.ADD(" AND   C.CtaPrincipal= '"~Val(ct:1)~"' ")
* interfaz rio 05/07/04     SQL.ADD(" AND   D.Archivo     IN ('DNCTAS','DNAHMS','DNCCDO','DNCADO','DNOTRO')  ")
      SQL.ADD(" AND    D.Archivo      IN ("~Pipe2Comillas(Val(ll:1))~")  ")
      SQL.ADD(" AND   CD.Tipo       IN ("~Pipe2Comillas(VAR('CPBD021'))~")  ")
      SQL.ADD(" AND   M.NrMovDatanet NOT IN (SELECT HNrMovDatanet FROM "~DBO~".EXTRACTOS WHERE HNrDatanet=M.NrDatanet ) ")
      If Val(ch:2)=1
         * Mismo comprobante
         If Val(l:&i)=0
            SQL.ADD(" AND (M.Comprobante IS NULL OR M.Comprobante = 0) ")
         Else
            SQL.ADD(" AND M.Comprobante = "~fstr(Val(l:&i),0,0)~" ")
         ENdif
      Endif
      SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion ")
      ACN(dz:1, 0)

      Recorrer SQL
        message('Extracto: '~fbn('NrDatanet')~' - '~fstr(fbn('NrMovDatanet'),0,0))
        SCN(dz:1, 1)
        ACN(da:Val(dz:1), 0)
        ACT(db:Val(dz:1), fbn('NrDatanet'))
        ACN(dc:Val(dz:1), fbn('NrMovDatanet'))
        ACT(dd:Val(dz:1), fbn('Vehiculo'))
        ACD(de:Val(dz:1), fbn('FechaIngreso'))
        ACD(df:Val(dz:1), fbn('FechaAcreditacion'))
        ACT(dg:Val(dz:1), fbn('Banco'))
        ACT(dh:Val(dz:1), fbn('Cuenta'))
        ACT(di:Val(dz:1), fbn('Moneda'))
        ACN(dj:Val(dz:1), fbn('Importe'))
        ACN(dk:Val(dz:1), fbn('Comprobante'))
      Proximo

      CrearDialogo
        ListBox; 'Arial,8,N';510;100
         'Fecha Valor'   ;b:&i..b:&i;NO;;;;80;FECHA
         'Banco'         ;c:&i..c:&i;NO;;;;70;STRING
         'Cuenta'        ;d:&i..d:&i;NO;;;;80;STRING
         'Moneda'        ;e:&i..e:&i;NO;;;;60;STRING
         'D/C'           ;o:&i..o:&i;NO;;;;40;STRING
         'Importe'       ;f:&i..f:&i;NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;l:&i..l:&i;NO;;;;70;NUMERO;'###,###,###,###'
         'Extracto'      ;g:&i..g:&i;NO;;;;70;STRING
         'Movimiento'    ;M:&i..M:&i;NO;;;;70;NUMERO;'###,###,###'
        FinListBox

        ListBox; 'Arial,8,N';510;300
         'OK'            ;da:1..de:Val(dz:1);SI;;;;80;CHECK
         'Fecha Valor'   ;df:1..df:Val(dz:1);NO;;;;80;FECHA
         'Banco'         ;dg:1..dg:Val(dz:1);NO;;;;70;STRING
         'Cuenta'        ;dh:1..dh:Val(dz:1);NO;;;;80;STRING
         'Moneda'        ;di:1..di:Val(dz:1);NO;;;;70;STRING
         'Importe'       ;dj:1..dj:Val(dz:1);NO;;;;80;NUMERO;'###,###,###,###.##'
         'Comprobante'   ;dk:1..dk:Val(dz:1);NO;;;;70;NUMERO;'###,###,###,###'
         'Fecha Ingreso' ;de:1..de:Val(dz:1);NO;;;;80;FECHA
         'Extracto'      ;db:1..db:Val(dz:1);NO;;;;70;STRING
         'Movimiento'    ;dc:1..dc:Val(dz:1);NO;;;;70;NUMERO;'###,###,###'
        FinListBox        
      FinDialogo

      If Ok 
        *Suma Cantidad FPA
        ACN(tt:1,0)

        *Marca si el importe es identico
        * 0 Cancela // 1 = confirma // 2 <> confirma.

        ACN(tt:2,0)
        ACN(tt:3,0)

        *Importe de la transaccion por la diferencia.
        ACN(tt:4,0)

        *Tipo Trans
        ACT(tt:5,'')

        Recorrer&j 1,Val(dz:1)
          If Val(da:&j)=1
            SCN(tt:1,Val(dj:&j))
          Endif
        Proximo

        If Val(ch:3)=1
          *Concilia por Importe
          If [ABS(Val(tt:1)) = ABS(Val(f:&i))]
             ACN(tt:2,1)
           Else
             ACN(tt:2,0)
           Endif
        Else
          If (ABS(ABS(Val(f:&i))-ABS(Val(tt:1)))) <= Val(tl:1)
             ACN(tt:2,2)
          Else
             ACN(tt:2,0)
          Endif
        Endif

        If Val(tt:2)=0
          messagebox('La suma de los item seleccionados es incorrecta. Supera el rango de tolerancia.')
        Else
           * ------------------------- Actualiza MovDATANET ------------------------------ *
           Recorrer&j 1,Val(dz:1)
             If Val(da:&j)=1
               message('Confirma Matcheo.')
               SQL.ADD(" INSERT INTO "~DBO~".EXTRACTOS ( ")
               SQL.ADD(" CtaPrincipal, MNrDatanet, MNrMovDatanet, ")
               SQL.ADD(" CtaHija, HNrDatanet, HNrMovDatanet, ")
               SQL.ADD(" Fecha, Operador ")
               SQL.ADD(" ) VALUES ( ")
               SQL.ADD(" '"~Val(d:&i)~"', '"~Val(g:&i)~"', "~FSTR(Val(m:&i),0,0)~", ")
               SQL.ADD(" '"~Val(dh:&j)~"', '"~Val(db:&j)~"', "~fstr(Val(dc:&j),0,0)~", ")
               SQL.ADD(" "~Idxdate2(fsys)~", '"~USUARIOACTIVO~"' ")
               SQL.ADD(" ) ")
               SQL.NEW
               SQL.EXEC
             Endif
           Proximo
          * Fin Importe OK
        Endif
        * Fin Ok Dialogo de grillas
      Endif
       * Fin ok de la primer grilla (mov * mov de FPA)
    Endif
Proximo
