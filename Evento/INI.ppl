SQL.ADD("Select C.* from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O Where O.NrOperacion=C.NrOperacion and O.TipoOp='MMPOSM'")
Recorrer SQL








      Message("Operacion "~FBN['NrOperacion']~" "~Fstr(FBN['NrCuota'],0,0))

      SQL.ADD("UPDATE "~DBO~".CUOTAS Set ")



             SQL.ADD("Cantidad7 = 1,  ")

             SQL.ADD("Cantidad8 = "~Fstr(fbn['Cantidad6'],0,7)~",  ")

          SQL.ADD("Check1 = '1' ")

      SQL.ADD(" Where NrOperacion='"~FBN['NrOperacion']~"' and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")

      SQL.NEW
      SQL.EXEC

Proximo


* inicializa por tasa + spread
SQL.ADD("Select C.* from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O Where O.NrOperacion=C.NrOperacion and O.TipoOp In ('MMPOSM','MMPCLM')")
Recorrer SQL

      Message("Operacion "~FBN['NrOperacion']~" "~Fstr(FBN['NrCuota'],0,0))

      SQL.ADD("UPDATE "~DBO~".CUOTAS Set ")

             ACN(M1,fbn['Precio2']+fbn['Precio4'])

             SQL.ADD("Cotizacion2 = "~Fstr(val(M1),0,7)~" ")

      SQL.ADD(" Where NrOperacion='"~FBN['NrOperacion']~"' and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")

      SQL.NEW
      SQL.EXEC

Proximo
