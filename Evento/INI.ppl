SQL.ADD("Select * from "~DBO~".OPERACIONES Where TipoOp='MMPCOS'")
Recorrer  SQL
   Message("Operacion "~FBN['NrOperacion'])
          SQL.ADD("Update "~DBO~".OPERACIONES ")
          SQL.ADD("Set")

             SQL.ADD("TCComCor1 = 1,  ")
             SQL.ADD("PorComCor1 = "~Fstr(fbn['ImpComCorEq2'],0,7)~",  ")
          SQL.ADD("CB6 = '1' ")
          SQL.ADD("where NrOperacion = '"~fbn['NrOperacion']~"' ")
          SQL.NEW
          SQL.EXEC

