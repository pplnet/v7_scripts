CrearDialogo
  Especie3 : 'Especie'      ;1;1;;  ;;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3,'TITULO');'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
  Especie1 : 'Cupon'        ; ; ;; ;;;;;;BuscarCampo('ESPECIES','Alias3', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB' "
  Entero1  : 'Nr.Cupon'     ; ; ;;;;Dialogo.Entero1>0 O Dialogo.Check1=1;'Debe Ingresar el Numero de Cupon';NO;0;Num(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))
  Fecha1   : 'F.Pago/Cobro' ; ; ;; ;;;;;;IIf(Dialogo.Check1=0,SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' "),FechaMaduracion(Dialogo.Especie3))
  Vehiculo1: 'Vehiculo'     ;1;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Check1   : 'ZeroCoupon'   ;1;1;;NO;NO;;;;;IIF(EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie3)),1,0)
FinDialogo

*  Especie1 : 'Cupon'        ;;;;NO;;;;;BuscarCampo('ESPECIES','Alias3', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES','Alias3', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB'  "
*  Fecha1   : 'F.Pago/Cobro' ;;;;NO;;SQL("SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"'")=Dialogo.Fecha1;'La Fecha de Pago no es Correcta';;SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ");SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")

MostrarCuadroDeMensajes

If Not OK 
 Cancelar
EndIf

ACN(x:1, 0)
 
SQL.ADD(" SELECT Fecha1, Cliente1, Especie, Cupon1, Cantidad1, Especie1, Cantidad2, ")
SQL.ADD(" Cuenta6, Cuenta2, NrTrans, TipoTr2 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" WHERE  TipoTr2 IN ('PCUPON', 'CCUPON') ")
SQL.ADD(" AND    Especie   = '"~Dialogo.Especie1~"'")
SQL.ADD(" AND    Cupon1    = '"~FSTR(Dialogo.Entero1,1,0)~"'")
SQL.ADD(" AND    Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" ORDER BY Cliente1, TipoTr2 ")

Recorrer SQL
  IF Eqstr(fbn('TipoTr2'), 'PCUPON')
     ACT(a:fac, 'Pago de Cupon')
  ELSE
     ACT(a:fac, 'Cobro de Cupon')
  ENDIF
  ACD(b:fac, fbn('Fecha1'))
  ACT(c:fac, fbn('Cliente1'))
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('Cupon1'))
  ACN(f:fac, fbn('Cantidad1'))
  ACT(g:fac, fbn('Especie1'))
  ACN(h:fac, fbn('Cantidad2'))
  ACT(i:fac, fbn('Cuenta6'))
  ACT(j:fac, fbn('Cuenta2'))
  ACT(l:fac, fbn('NrTrans'))
  ACN(x:1, 1)
Proximo

IF Val(x:1)<>1
   Cancelar('No hay transacciones de Pago o Cobro para la Especie y Cupon solicitados')
ENDIF

CrearListBox ; 'Arial,8,'
   'OK'               ;k1..k:fac;SI;;; 40;CHECK
   'Tipo Transaccion' ;a1..a:FAC;NO;;; 90;STRING;                ;RGB(220,220,193)
   'Fecha'            ;b1..b:FAC;NO;;; 70;STRING;                ;RGB(220,220,193)
   'Cliente'          ;c1..c:FAC;NO;;; 70;STRING;                ;RGB(220,220,193)
   'Especie'          ;d1..d:FAC;NO;;; 60;STRING;                ;RGB(220,220,193)
   'Cupon'            ;e1..e:FAC;NO;;; 50;STRING;                ;RGB(220,220,193)
   'Cantidad'         ;f1..f:FAC;NO;;; 80;NUMERO;'##,###,###.##' ;RGB(220,220,193)
   'Moneda'           ;g1..g:FAC;NO;;; 60;STRING;                ;RGB(220,220,193)
   'Total'            ;h1..h:FAC;NO;;; 80;NUMERO;'###,###,###.##';RGB(220,220,193)
   'De Cuenta'        ;i1..i:FAC;NO;;;100;STRING;                ;RGB(220,220,193)
   'A Cuenta'         ;j1..j:FAC;NO;;;100;STRING;                ;RGB(220,220,193)
FinListBox

IF NOT OK 
   Cancelar
ENDIF

Recorrer&i 1,fac
   IF Val(k:&i)=1
      SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS  WHERE NrTrans2 = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE NrTrans2 = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE2  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN2  WHERE NrOperacion = '"~Val(l:&i)~"'")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~Val(l:&i)~"'")
      SQL.NEW

      message('Transaccion '~Val(l:&i)~' eliminada.')
   ENDIF
Proximo

