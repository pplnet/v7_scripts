if (dialogo.check1 = 1)
sql.add("select * from ( ")
endif
sql.add("select '1' TipoReg,DT.Fecha, DT.Especie, Case when DT.TipCupon='' then '0' else DT.TipCupon end TipCupon, DT.Valorresidual Residual, DT.CuentaContable CuentaContable, DT.ValorContable Contable, ")
sql.add("DT.ValorContValuado ContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, FechaInicioTenencia FTenencia,")
sql.add("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, extendido, MonedaEmision, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo TipoE, ")
sql.add("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%'Then 'SI' else 'NO' end Accion, ISIN, ISSUER, TasaCER, Indice, Cupon,  ")
sql.add("ESP.Indexado, DT.Cotizacion, DT.CuentaCustodia, CT.Nombre NombreCta, CT.Mercado, CT.Cliente ClienteCTA ")
sql.add(" From "~Dbo()~".CAPITALESMINIMOS DT  ")
sql.add("      inner  join "~Dbo()~".CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
sql.add("      inner join "~Dbo()~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
sql.add("      Left  join "~Dbo()~".CUENTAS CT   on CT.Codigo = DT.CuentaCustodia ")
sql.add("  and ValorContable <> 0  ")
sql.add("  Where DT.Fecha = "~IdxDate2(dialogo.fecha1)~"  ")
if (dialogo.check1 = 1)
sql.add("UNION ALL ")
sql.add("select '2' TipoReg,DT.Fecha1, DT.Especie, DT.RB1 TipCupon, DT.Cantidad1 Valorresidual, DT.CuentaContable1 CuentaContable, DT.Cantidad2 ValorContable, ")
sql.add("DT.Cantidad3 ValorContValuado, DT.Fecha2 FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, FechaInicioTenencia FTenencia, ")
sql.add("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, extendido, MonedaEmision, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo TipoE, ")
sql.add("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%' Then 'SI' else 'NO' end Accion, ISIN, ISSUER, TasaCER, Indice, Cupon,")
sql.add("ESP.Indexado, DT.Precio1 Cotizacion, DT.Cuenta1 CuentaCustodia, '' NombreCta, '' Mercado, '' ClienteCTA ")
sql.add(" From "~Dbo()~".TRANSACCIONES2 DT  ")
sql.add("      inner join dbo.CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable1 ")
sql.add("      inner join "~Dbo()~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
sql.add("  and  DT.TipoTr2='AJUTFI'")
sql.add("  and CO.Titofin='SI' ")
sql.add("  and cantidad2 <> 0  ")
sql.add("  and DT.Fecha1 = "~IdxDate2(dialogo.fecha1)~" ")
endif
if (dialogo.check1 = 1)
sql.add("   ) as AUX ")
endif
sql.add(" Order By Especie")

Watch(sql.batch)

recorrer sql


