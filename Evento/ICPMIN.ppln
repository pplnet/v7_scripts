Acd(zb:fac, sql("select min(P.fecha) from "~Dbo()~".POSICIONES P where P.fecha <= "~IdxDate2(Val(za:fac))~"  AND P.Especie= '"~Fbn()['Especie']~"' and P.NrSaldo=122 and CantidadIni=0 "))
