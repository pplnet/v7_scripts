creardialogo
fecha1: 'Fecha';;;;;;;;;;FSys()
termsheet: 'TermSheet';;;;;;NoVacio(dialogo.termsheet);'Debe ingresar una TermSheet Valida';NO;
findialogo
if (not ok)
Cancelar()
endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

Acn(su:1, sql("select Count(*) from CUOTAS where NrOperacion in (Select NrOperacion from OPERACIONES O, ICLTERMSHEET T where TipoOp = 'CONU' and  O.TermSheet=T.Codigo and Termsheet = '"~dialogo.termsheet~"'  and FechaOp < '"~IdxDate(dialogo.fecha1)~"') and Radio2=1"))

if (Val(su:1) > 0)
Cancelar()('Termsheet '~dialogo.termsheet~' tiene '~PYC(Val(su:1), 1, 0)~' autorizaciones pendientes')
endif

Acn(x:1, 0)
sql.add("Select NrOperacion,Termsheet,T.Monto,T.Utilizado,FechaOp,CB1,CB9,CB10,FechaVto,FechaPrecan,Cantidad, Cliente1, Especie,")
sql.add("  Isnull((select SUM(CU.cantidad1*-1) from CUOTAS CU where CU.NrOperacion=O.NrOperacion and (CU.Radio1=1 or CU.Radio1=2)),0) as SaldoUti, ")
sql.add("  Isnull((select SUM(CU.cantidad1*-1) from CUOTAS CU where CU.NrOperacion=O.NrOperacion and CU.Radio1=4),0) as SaldoPICD ")
sql.add("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".ICLTERMSHEET T ")
sql.add(" where TipoOp = 'CONU' ")
sql.add("   and  O.TermSheet=T.Codigo ")
sql.add("   and Termsheet = '"~dialogo.termsheet~"' ")
sql.add("   and FechaOp < '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" Order by NrOperacion ")
Watch(sql.batch)
recorrer sql
Scn(x:1, 1)
Act(a:Val(x:1), Fbn('NrOperacion'))
Act(b:Val(x:1), Fbn('TermSheet'))
Acd(c:Val(x:1), Fbn('FechaOp'))
Act(d:Val(x:1), iif (Fbn('CB1') = 1, 'SI', 'NO'))
Act(e:Val(x:1), iif (Fbn('CB9') <> 0, 'SI', 'NO'))
Act(f:Val(x:1), iif (Fbn('CB10') <> 1, 'Ok', 'Falta Sup.'))
Acn(g:Val(x:1), Fbn('Cantidad'))
Acn(h:Val(x:1), Fbn('SaldoUti'))
Acn(j:Val(x:1), Fbn('Monto'))
Acn(k:Val(x:1), Fbn('Utilizado'))
Act(l:Val(x:1), Fbn('Cliente1'))
Act(m:Val(x:1), Fbn('Especie'))
Acn(n:Val(x:1), Fbn('SaldoPICD'))
Acn(i:Val(x:1), iif (Val(g:Val(x:1)) = Val(n:Val(x:1)), Fbn('SaldoPICD'), 0))

SetFont(aa:Val(x:1)..ah:Val(x:1), 1)
proximo

repetir

crearlistbox;'Arial,8,';'Actualizacion saldo TermSheet  '~dialogo.termsheet~' Monto '~PYC(Val(j:1), 1, 0)~' Utilizado '~PYC(Val(k:1), 1, 0)
'Operacion ';a:1..a:Val(x1);NO;;;70;string;;
'Fecha Op  ';c:1..c:Val(x1);NO;;;100;fecha;;
'Evergreen ';d:1..d:Val(x1);NO;;;70;string;;
'Bloqueada ';e:1..e:Val(x1);NO;;;70;string;;
'Supervisada ';f:1..f:Val(x1);NO;;;70;string;;
'Cantidad  ';g:1..g:Val(x1);NO;;;100;numero;'###,###,###,###.##';
'Canc.PICD ';n:1..n:Val(x1);NO;;;100;numero;'###,###,###,###.##';
'Utilizado';h:1..h:Val(x1);NO;;;100;numero;'###,###,###,###.##';
'Nueva Cantidad  ';i:1..i:Val(x1);not Val(g:flb) = Val(n:flb) y not Eqstr(Val(e:flb), 'SI') y Eqstr(Val(f:flb), 'Ok');Val(i:flb) >= (Val(h:flb) + Val(n:flb));'El Valor deber ser mayor o igual al Cancelado+Utilizado';100;numero;'###,###,###,###.##';RGB(232, 232, 255);
finlistbox

if (not ok)
Cancelar()('No se Actualizan las Cantidades')
endif

recorrer&i 1, Val(x1)
Scn(x2, Val(g:&i))
Scn(x3, Val(i:&i))
proximo

if (Val(x2) <> Val(x3))
Messagebox('Los nuevos valores deben dar la sumatoria de CONUs')
Act(x4, 'NOK')
else
Act(x4, 'OK')
endif

if (Eqstr(Val(x4), 'OK'))
break
endif
proximo

recorrer&j 1, Val(x1)

if (Val(g:&j) <> Val(i:&j))
Acn(ct:1, sql("Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion='"~Val(a:&j)~"' ") + 1)

Message('Generando CUOTA Cantidad Actualizada a Supervisar ... ')
sql.add(" INSERT INTO "~Dbo()~".CUOTAS ( ")
sql.add(" NrOperacion, NrCuota, Radio1, Radio2, Fecha1, Cantidad1, Cantidad2, Cliente1, Especie1")
sql.add(" ) VALUES ( ")
sql.add(" '"~Val(a:&j)~"', "~Val(ct:1)~",  '5', '1', '"~IdxDate(dialogo.fecha1)~"', "~FStr(Val(i:&j), 0, 2)~", "~FStr(Val(g:&j), 0, 2)~", '"~Val(l:&j)~"','"~Val(m:&j)~"' ")
sql.add(" ) ")
sql.new
sql.exec

Scn(x5, 1)
endif

proximo

if (Val(x5) > 0)
Messagebox('Actualizacion Realizada')
else
Messagebox('No hubo modificaciones en los montos')
endif

