MostrarCuadroDeMensajes
CrearDialogo
   NrOperacion1: 'Operacion'            ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), Var('TIPOOPNC'));'El Tipo de Operacion no Esta Habilitado para Nota de Credito';NO;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('TIPOOPNC'))~") ";
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(BD:1, 0)
***---Busco Facturas de la Operacion
SQL.ADD(" Select Distinct NrSisExterno Factura, Cantidad2 MontoFactura, Cliente1 ")
SQL.ADD(" From "~DBO~".IMPUESTOS ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
SQL.ADD(" Order By NrSisExterno ")
Recorrer SQL
    IF Incluido(Copy(fbn('Factura'), 5, 1), Var('TIPONCVAL'))
        ACN(BD:1, 1)
        ACT(NF:fac, fbn('Factura'))
        ACN(MF:fac, fbn('MontoFactura'))
        ACT(CL:fac, fbn('Cliente1'))
    ENDIF
Proximo
IF Val(BD:1) = 0
    Cancelar(" La Operacion "~Dialogo.NrOperacion1~" No Tiene Factura Asignada")
ENDIF
IF Val(BD:1) > 0
    CrearListBox;'Arial,8,B';'Seleccione La Factura a Anular'
       'OK'               ;W:1..W:fac;;Sum(W:1..W:fac) = 1;'Debe Eligir Una Factura';45;CHECK;
       'Factura'          ;NF:1..NF:fac;NO;;;150;STRING
    FinListBox
    IF Not OK
        Cancelar
    ENDIF
ENDIF
Recorrer&k 1, fac
    IF Val(W:&k) = 1
        ACT(NF:1, Val(NF:&k))
        ACN(MF:1, Val(MF:&k))
        ACT(CL:1, Val(CL:&k))
        Break
    ENDIF
Proximo

CrearListBox;'Arial,8,B';'Ingreso de Datos de Nota de Credito para la Factura '~Val(NF:1)
   'Centro Emisor'    ;CE:1..CE:1;;Longitud(Val(CE:FLB)) = 4;'Centro Emisor Invalido -  Debe ser de 4 Caracteres';85;STRING;;RGB(2,255,255)
   'Tipo NC'          ;TF:1..TF:1;;;;75;COMBO;Var('TIPONCVAL')
   'Nro. NC'          ;FA:1..FA:1;;Longitud(Val(FA:FLB)) = 8;'Nro. de NC Invalido - Debe ser de 8 Caracteres';70;STRING
   'Fecha NC'         ;FX:1..FX:1;;Val(FX:FLB) <= Fsys Y Anio(Val(FX:FLB)) > 2000;'Fecha de NC Invalida';60;FECHA;RGB(2,255,255)
   'Codigo Barra'     ;CB:1..CB:1;;Longitud(Val(CB:FLB)) = 40;'Codigo de Barra Invalido';250;STRING;50;RGB(2,255,255)
   'C.A.I.'           ;CA:1..CA:1;NO;Longitud(Val(CA:FLB)) = 14;'C.A.I. Invalido';100;STRING;;;Copy(Val(CB:FLB), 18, 14);
   'F.Vto.C.A.I.'     ;FC:1..FC:1;NO;Anio(Val(FC:FLB)) > 2000;'Vto. del CAI Invalido';65;FECHA;;Fecha(Copy(Val(CB:FLB), 38, 2)~'/'~Copy(Val(CB:FLB), 36, 2)~'/'~Copy(Val(CB:FLB), 32, 4));
   'Monto Factura'    ;MF:1..MF:1;NO;;;85;NUMERO;'###,###,###,###.##';;;;;
FinListBox
IF Not OK
    Cancelar
ENDIF
***---Nro. Factura Legal
ACT(LW:1, Var('TIPONCVAL'))
ACT(TF:2, ItemLista(Val(LW:1), Num(Val(TF:1))+1))
ACT(FL:1, Val(CE:1)~Val(TF:2)~Val(FA:1))
IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where String26 = '"~Val(FL:1)~"' AND Cliente1 = '"~Val(CL:1)~"' ") = 1
    Cancelar(" Nro. NC Legal "~Val(FL:1)~" Ya Existente para el Proveedor "~Val(CL:1))
ENDIF
SQL.ADD(" Update "~DBO~".IMPUESTOS ")
SQL.ADD(" Set String26 = '"~Val(FL:1)~"', ")
SQL.ADD(" Fecha6 = '"~IdxDate(Val(FX:1))~"', ")
SQL.ADD(" String27 = '"~Val(CB:1)~"', ")
SQL.ADD(" String28 = '"~Val(CA:1)~"', ")
SQL.ADD(" Fecha7 = '"~IdxDate(Val(FC:1))~"', ")
SQL.ADD(" Check2 = 1 ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND NrSisExterno = '"~Val(NF:1)~"' ")
SQL.ADD("  ")
SQL.NEW
SQL.EXEC

***---Elimino Vouchers asociados a la factura
SQL.ADD(" Select Distinct NrTrans1 From "~DBO~".IMPUESTOS ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND NrSisExterno = '"~Val(NF:1)~"' ")
Recorrer SQL
    ACT(NR:1, fbn('NrTrans1'))
    ***---Busco Vouchers de Impuestos de movimientos incluidos en la factura
    SQL.ADD(" Select NrMov From "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD(" AND NrTrans2 = '"~fbn('NrTrans1')~"' ")
    Recorrer SQL
        ***---Con el NrMov Obtengo Vouchers de Impuestos. En NrGrupo2 del impuesto tengo el NrMov del Mov al que le
        ***---corresponde
        DFA
        SQL.ADD(" Select NrTrans2 From "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.ADD(" AND NrTrans2 <> '"~Val(NR:1)~"' ")
        SQL.ADD(" AND NrGrupo2 = "~Fstr(fbn('NrMov'), 0, 0)~" ")
        Recorrer SQL
            DFA
            EjecutarEvento('ANUVOU', NrTrans1 = fbn('NrTrans2'), Check1 = 1)
        proximo
    Proximo
    EjecutarEvento('ANUVOU', NrTrans1 = fbn('NrTrans1'), Check1 = 1)
Proximo
