creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO');'Debe Ingresar una Especie Valida';NO;;;;;;" Jerarquia Like '"~jerarquia('ESPECIES', 'TITULO')~"%' "
fecha1:'Record_Date';1;2;;;;dialogo.fecha1 <> 0;'Debe Ingresar una Fecha valida ';NO;FSys()
fecha2:'Fecha_Pago';2;2;;;;dialogo.fecha2 <> 0 y dialogo.fecha2 >= dialogo.fecha1;'Debe Ingresar una Fecha valida ';NO;FSys()
cliente1:'Cliente';3;1;;;;(Vacio(dialogo.cliente1)) o (((Eqstr(BuscarCampo('CLIENTES', 'CategDepositante', 'Codigo', dialogo.cliente1), 'CLI')) o (Eqstr(dialogo.cliente1, dialogo.vehiculo1))) y Eqstr(BuscarCampo('CLIENTES', 'Status', 'Codigo', dialogo.cliente1), 'HAB') y not Eqstr(BuscarCampo('CLIENTES', 'BloqueoFondos', 'Codigo', dialogo.cliente1), 'SI'));'Cliente Invalido';NO;;;;;;" Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) AND (CategDepositante='CLI' OR Codigo='"~dialogo.vehiculo1~"') ";
mercado1:'Mercado';4;1;;;;
especie2:'Moneda';4;2;;;;NoVacio(dialogo.especie2) y DesciendeDeEspecie(dialogo.especie2, 'MONEDA');'Debe Ingresar una Moneda Valida';NO;;CotizaEn(dialogo.especie1);'ARP|USD|';;;" Codigo IN ( "~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
vehiculo1:'Vehiculo';6;1;;;;NoVacio(dialogo.vehiculo1);'Debe Ingresar el vehículo';NO;Var('VEHICULODE');
operador1:'Operador';6;2;;NO;;NoVacio(dialogo.operador1);'Debe Ingresar el Operador';NO;UsuarioActivo()
findialogo

if (not ok)
Cancelar()
endif

Ejecutarevento('RESGLC', 'especie1', dialogo.especie1, 'fecha1', dialogo.fecha1, 'fecha2', dialogo.fecha2, 'cliente1', dialogo.cliente1, 'mercado1', dialogo.mercado1, 'operador1', dialogo.operador1, 'vehiculo1', dialogo.vehiculo1)
