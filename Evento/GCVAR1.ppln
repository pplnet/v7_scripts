creardialogo
nroperacion1:"Operacion";;;;;;NoVacio(dialogo.nroperacion1);'Debe Ingresar una Operacion';NO;
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'FXAS|FXAT|FXASV|FXATV|'))
Cancelar('La operacion N? '~dialogo.nroperacion1~' No es un Arbitraje')
endif

Acn(x1, Query("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~Query("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (ok)

Message(' --- Generando Compra/Venta desde Arbitraje ...')
Sqladd("Select * from "~Dbo()~".OPERACIONES ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' and (RB1='0' or RB1 IS NULL)")

Acn(a1, 0)
recorrer sql

Acn(a1, 1)


if (Eqstr(Fbn()['TipoOp'], 'FXAS'))
Act(z1, 'FXCS')
Act(z2, 'FXVS')
endif

if (Eqstr(Fbn()['TipoOp'], 'FXAT') o Eqstr(Fbn()['TipoOp'], 'FXREPO'))
Act(z1, 'FXCT')
Act(z2, 'FXVT')
endif

if (Eqstr(Fbn()['TipoOp'], 'FXASV'))
Act(z1, 'FXCSV')
Act(z2, 'FXVSV')
endif

if (Eqstr(Fbn()['TipoOp'], 'FXATV') o Eqstr(Fbn()['TipoOp'], 'FXREPV'))
Act(z1, 'FXCTV')
Act(z2, 'FXVTV')
endif

Act(z3, getnumerador(BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Fbn()['Vehiculo1'])))

Acn(z4, Fbn()['FechaVto'] - Fbn()['FechaOp'])

Acn(z5, Fbn()['FechaPago'] - Fbn()['FechaOp'])


Acn(z6, 1)
if (Eqstr(Query(" Select Modo from "~Dbo()~".MODOESPECIES where Especie1='"~Fbn()['ContraEspecie']~"' and Especie2='ARP' "), 'INV'))
Acn(z6, 0)
endif

Acn(z16, 1)
if (Eqstr(Query(" Select Modo from "~Dbo()~".MODOESPECIES where Especie1='"~Fbn()['Especie']~"' and Especie2='ARP' "), 'INV'))
Acn(z16, 0)
endif

if (Eqstr(Fbn()['ContraEspecie'], 'USD'))
Acn(z7, CotizacionC(Fbn()['ContraEspecie'], null, null, null, Fbn()['FechaOp'], 1, SI, 'ARP'))
Acn(z8, Fbn()['TotalBrutoCli1'] * Val(z7))
Acn(z9, Val(z8) / Fbn()['Cantidad'])

if (Val(z6) = 0)
Acn(z7, 1 / CotizacionC(Fbn()['ContraEspecie'], null, null, null, Fbn()['FechaOp'], 1, SI, 'ARP'))
Acn(z8, Fbn()['TotalBrutoCli1'] / Val(z7))
Acn(z9, Val(z8) * Fbn()['Cantidad'])
endif
else
Acn(z9, CotizacionC(Fbn()['Especie'], null, null, null, Fbn()['FechaOp'], 1, SI, 'ARP'))
Acn(z8, Fbn()['Cantidad'] * Val(z9))
Acn(z7, Val(z8) / Fbn()['TotalBrutoCli1'])

if (Val(z16) = 0)
Acn(z9, 1 / CotizacionC(Fbn()['Especie'], null, null, null, Fbn()['FechaOp'], 1, SI, 'ARP'))
Acn(z8, Fbn()['Cantidad'] / Val(z9))
Acn(z7, Val(z8) * Fbn()['TotalBrutoCli1'])
endif
endif

Message(' ---- Generando Operacion de Compra ...')
Sqladd("INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd("(TipoOp, NrOperacion, Especie, Cliente1, Cantidad, Precio1, ")
Sqladd(" TotalBrutoCli1, TotalNetoCli1, ContraEspecie, ")
Sqladd(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
Sqladd(" Operador, Vehiculo1, ")
Sqladd(" ValorRB1, Puesto, Observac2, OperacionRef, TablaFeriados1, ")
Sqladd(" Precio4, RB7, CB6, ")
Sqladd(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,Arbitraje,RB3) ")
Sqladd("Values")
Sqladd("('"~Val(z1)~"', '"~Val(z3)~"', '"~Fbn()['Especie']~"', ")
Sqladd(" '"~Fbn()['Cliente1']~"', "~FStr(Fbn()['Cantidad'], 0, 4)~", "~FStr(Val(z9), 0, 7)~", ")
Sqladd(" "~FStr(Val(z8), 0, 4)~", "~FStr(Val(z8), 0, 4)~", 'ARP', ")
Sqladd(" '"~IdxDate(Fbn()['FechaOp'])~"', '"~IdxDate(Fbn()['FechaVto'])~"', ")
Sqladd(" '"~IdxDate(Fbn()['FechaPago'])~"', "~FStr(Val(z4), 2, 0)~", "~FStr(Val(z5), 2, 0)~", ")
Sqladd(" '"~Fbn()['Operador']~"', '"~Fbn()['Vehiculo1']~"', ")
Sqladd(" '"~Fbn()['ValorRB1']~"', '"~Fbn()['Puesto']~"', ")
Sqladd(" '"~Fbn()['Observac2']~"', '"~Fbn()['NrOperacion']~"', '"~Fbn()['TablaFeriados1']~"', ")
Sqladd(" "~FStr(Val(z9), 0, 7)~", '"~Fbn()['RB7']~"', '"~FStr(Val(z16), 1, 0)~"', ")
Sqladd(" '"~Fbn()['UsrInput']~"', '"~IdxDate(FSys())~"', '"~Fbn()['Vehiculo2']~"', '"~Fbn()['MB4']~"', ")
Sqladd(" '"~Fbn()['RB10']~"','1','"~Fbn()['RB3']~"') ")
Sqlnew()

Message('Ingresando Instancias Operacion '~Val(z3)~' ...')

Acn(i1, 50)

Sqladd("SELECT * FROM "~Dbo()~".INSTANCIAS ")
Sqladd(" Where Tabla = 'OPERACIONES' ")
Sqladd(" ORDER BY NrInstancia ")
recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ( ")
Sqladd(" NrOperacion, NrBit, Valor ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(z3)~"', ")
Sqladd(" "~FStr(Fbn()['NrInstancia'], 2, 0)~", ")
Sqladd(" '"~iif (Val(i1) = Fbn()['NrInstancia'], '1', '0')~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
proximo



Act(z3, getnumerador(BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Fbn()['Vehiculo1'])))

Message(' ---- Generando Operacion de Venta ...')
Sqladd("INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd("(TipoOp, NrOperacion, Especie, Cliente1, Cantidad, Precio1, ")
Sqladd(" TotalBrutoCli1, TotalNetoCli1, ContraEspecie, ")
Sqladd(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
Sqladd(" Operador, Vehiculo1, ")
Sqladd(" ValorRB1, Puesto, Observac2, OperacionRef, TablaFeriados1, ")
Sqladd(" Precio4, RB7, CB6, ")
Sqladd(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,Arbitraje,RB3) ")
Sqladd("Values")
Sqladd("('"~Val(z2)~"', '"~Val(z3)~"', '"~Fbn()['ContraEspecie']~"',  ")
Sqladd(" '"~Fbn()['Cliente1']~"', "~FStr(Fbn()['TotalBrutoCli1'], 0, 4)~", "~FStr(Val(z7), 0, 7)~", ")
Sqladd(" "~FStr(Val(z8), 0, 4)~", "~FStr(Val(z8), 0, 4)~", 'ARP', ")
Sqladd(" '"~IdxDate(Fbn()['FechaOp'])~"', '"~IdxDate(Fbn()['FechaVto'])~"', ")
Sqladd(" '"~IdxDate(Fbn()['FechaPago'])~"', "~FStr(Val(z4), 2, 0)~", "~FStr(Val(z5), 2, 0)~", ")
Sqladd(" '"~Fbn()['Operador']~"', '"~Fbn()['Vehiculo1']~"', ")
Sqladd(" '"~Fbn()['ValorRB1']~"', '"~Fbn()['Puesto']~"', ")
Sqladd(" '"~Fbn()['Observac2']~"', '"~Fbn()['NrOperacion']~"', '"~Fbn()['TablaFeriados2']~"', ")
Sqladd(" "~FStr(Val(z7), 0, 7)~", '"~Fbn()['RB7']~"', '"~FStr(Val(z6), 1, 0)~"', ")
Sqladd(" '"~Fbn()['UsrInput']~"', '"~IdxDate(FSys())~"', '"~Fbn()['Vehiculo2']~"', '"~Fbn()['MB4']~"', ")
Sqladd(" '"~Fbn()['RB10']~"','1','"~Fbn()['RB3']~"') ")
Sqlnew()

Message('Ingresando Instancias Operacion '~Val(z3)~' ...')

Acn(i1, 50)

Sqladd("SELECT * FROM "~Dbo()~".INSTANCIAS ")
Sqladd(" Where Tabla = 'OPERACIONES' ")
Sqladd(" ORDER BY NrInstancia ")
recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ( ")
Sqladd(" NrOperacion, NrBit, Valor ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(z3)~"', ")
Sqladd(" "~FStr(Fbn()['NrInstancia'], 2, 0)~", ")
Sqladd(" '"~iif (Val(i1) = Fbn()['NrInstancia'], '1', '0')~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
proximo



Sqladd(" UPDATE "~Dbo()~".OPERACIONES SET RB1 = '1' ")
Sqladd(" Where (NrOperacion = '"~Fbn()['NrOperacion']~"')  ")
Sqlnew()
Sqlexec()
proximo

if (Val(a1) = 0)
Messagebox('Se han generado con anterioridad las Operaciones de Compra y Venta para esta Operacion !!!')
endif
endif
