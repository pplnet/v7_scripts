recorrer&i 10, Val(a1)
  if EqStr(LinkH(2,5:&i),'Excedido')
    SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de Maturity Maxima (Pesos): '~Mirt(LinkH(2, 1:&i)))
  endif
  if EqStr(LinkH(2,9:&i),'Excedido')
    SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de Maturity Maxima (M.E.): '~Mirt(LinkH(2, 1:&i)))
  endif
proximo
CerrarLink(2)

LinkearHoja('LPOSI2',3,Fecha1=FSys,Vehiculo1='',Radio1=0)
