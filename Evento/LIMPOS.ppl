HojaVisible(NO)

LinkearHoja('LPOSIC',1,Fecha1=FSys,Vehiculo1='')

ACN(a1, LinkH(1,22:1))


recorrer&i 9, Val(a1)
  if EqStr(LinkH(1,5:&i),'Excedido')
     SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de % de Total de Activos : '~Mirt(LinkH(1, 1:&i)))
  endif
  if EqStr(LinkH(1,8:&i),'Excedido')
     SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de % de Total de Grupo : '~Mirt(LinkH(1, 1:&i)))
  endif
  if EqStr(LinkH(1,11:&i),'Excedido')
     SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de % de Pesos : '~Mirt(LinkH(1, 1:&i)))
  endif
  if EqStr(LinkH(1,14:&i),'Excedido')
     SendMail(Exe('USRLIMPOS'),'Exceso de Limites de Posicion','Hay Exceso del limite de % de M.Extranjera : '~Mirt(LinkH(1, 1:&i)))
  endif
proximo
CerrarLink(1)

LinkearHoja('LMATMX',2,Fecha1=FSys,Vehiculo1='')
