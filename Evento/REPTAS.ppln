if (dialogo.radio1 = 1 y dialogo.radio2 = 0)
Sqladd(" and ((C.Check10 Is Null or C.Check10='' or C.Check10='0') and (((C.Precio1=0  or C.Precio1 Is Null or  C.Precio1='') and O.TipoOp Not In ('MMPCCM','MMFIMV','MMSIMV')) or ((C.Precio2=0  or C.Precio2 Is Null or  C.Precio2='') and O.TipoOp In ('MMPCCM','MMFIMV','MMSIMV')) )) ")
endif

Sqladd("       and O.TipoOp In ('MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMONM','MMPCCM','MMCPM') ")
