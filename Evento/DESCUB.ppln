mostrarcuadrodemensajes
creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 = FinDeMes(dialogo.fecha1, SI);'Debe ser Fin de Mes';NO;FinDeMes(PriDeMes(FSys(), SI) - 1, SI);
cuenta1:'Cuenta';;;;;;NoVacio(dialogo.cuenta1);'Cuenta Invalida';NO;;;
findialogo

if (not ok)
Cancelar()
endif

sql.add(" Select Count(NrOperacion) Cont ")
sql.add(" From "~Dbo()~".OPERACIONES ")
sql.add(" Where TipoOp = 'MMDC' ")
sql.add(" AND FechaOp >= '"~IdxDate(PriDeMes(dialogo.fecha1, SI))~"' ")
sql.add(" AND (Cuenta1 = '"~dialogo.cuenta1~"' OR Cuenta4 = '"~dialogo.cuenta1~"') ")
recorrer sql
if (Fbn('Cont') > 0)
Cancelar()('Existen descubiertos procesados para el mes seleccionado (o posterior). Anule primero.')
endif
proximo
Acd(fx:1, PriDeMes(dialogo.fecha1, SI))
recorrer&k Val(fx:1), dialogo.fecha1
Watch(&k)
Message(Fecha(&k))
ejecutarevento('DESCUX', fecha1 = &k, cuenta1 = dialogo.cuenta1)
proximo
Acd(fe:1, Habiles(dialogo.fecha1, 1, 'ARG'))

sql.add(" Select Sum(TotalIntereses) Interes, Sum(Cantidad) Cantidad, OperacionRef, Min(FechaOp) FechaDesde, Max(FechaVto) FechaHasta ")
sql.add(" From "~Dbo()~".OPERACIONES ")
sql.add(" Where TipoOp = 'MMDC' ")
sql.add(" AND FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.cuenta1))
sql.add(" AND (Cuenta1 = '"~dialogo.cuenta1~"' OR Cuenta4 = '"~dialogo.cuenta1~"') ")
endif
sql.add(" AND FechaOp >= '"~IdxDate(PriDeMes(dialogo.fecha1, SI))~"' ")
sql.add(" AND FechaOp <= '"~IdxDate(FinDeMes(dialogo.fecha1, SI))~"' ")
sql.add(" Group By OperacionRef ")
recorrer sql;;SI
Acd(fe:2, sql(" Select FechaVto From "~Dbo()~".OPERACIONES Where NrOperacion = '"~Fbn('OperacionRef')~"' "))
if (Val(fe:2) > dialogo.fecha1)
Acd(fe:2, dialogo.fecha1 + 1)
endif
if (sql(" Select 1 From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('OperacionRef')~"' AND Fecha1 = '"~IdxDate(Val(fe:1))~"' ") = 1)
sql.add(" Update "~Dbo()~".CUOTAS ")
sql.add(" Set Cantidad1 = "~FStr(Fbn('Cantidad'), 0, 2)~", ")
sql.add(" Cantidad2 = "~FStr(Fbn('Interes'), 0, 2)~", ")
sql.add(" Fecha2 = "~IdxDate(Fbn('FechaDesde'))~", ")
sql.add(" Fecha3 = "~IdxDate(Fbn('FechaHasta'))~" ")
sql.add(" Where NrOperacion = '"~Fbn('OperacionRef')~"' ")
sql.add(" AND Fecha1 = '"~IdxDate(Val(fe:1))~"' ")
sql.new
else
Acn(ct:1, sql(" Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('OperacionRef')~"' ") + 1)
sql.add(" Insert Into "~Dbo()~".CUOTAS ")
sql.add(" (NrOperacion, NrCuota, Fecha1, ")
sql.add(" Cantidad1, Cantidad2, Fecha2, Fecha3) ")
sql.add(" Values ")
sql.add(" ('"~Fbn('OperacionRef')~"', "~FStr(Val(ct:1), 0, 0)~", '"~IdxDate(Val(fe:1))~"', ")
sql.add(" "~FStr(Fbn('Cantidad'), 0, 2)~", "~FStr(Fbn('Interes'), 0, 2)~", '"~IdxDate(Fbn('FechaDesde'))~"', '"~IdxDate(Fbn('FechaHasta'))~"') ")
sql.new
endif
sql.exec

sql.actualizarmovimientos4(Fbn('OperacionRef'), SI, NO, NO, NO, SI, NO)
sql.exec
ejecutarevento('INSBIT', string1 = 'OPERACIONES', entero1 = 19, nroperacion1 = Fbn('OperacionRef'))
proximo


