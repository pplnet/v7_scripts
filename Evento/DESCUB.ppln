MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 = FinDeMes(dialogo.fecha1, SI);'Debe ser Fin de Mes';NO;FinDeMes(PriDeMes(FSys(), SI) - 1, SI);
cuenta1:'Cuenta';;;;;;NoVacio(dialogo.cuenta1);'Cuenta Invalida';NO;;;
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" Select Count(NrOperacion) Cont ")
Sqladd(" From "~Dbo()~".OPERACIONES ")
Sqladd(" Where TipoOp = 'MMDC' ")
Sqladd(" AND FechaOp >= '"~IdxDate(PriDeMes(dialogo.fecha1, SI))~"' ")
Sqladd(" AND (Cuenta1 = '"~dialogo.cuenta1~"' OR Cuenta4 = '"~dialogo.cuenta1~"') ")
recorrer sql
if (Fbn('Cont') > 0)
Cancelar('Existen descubiertos procesados para el mes seleccionado (o posterior). Anule primero.')
endif
proximo
Acd(fx:1, PriDeMes(dialogo.fecha1, SI))
recorrer&k Val(fx:1), dialogo.fecha1
Watch(&k)
Message(Fecha(&k))
Ejecutarevento('DESCUX', 'fecha1', &k, 'cuenta1', dialogo.cuenta1)
proximo
Acd(fe:1, Habiles(dialogo.fecha1, 1, 'ARG'))

Sqladd(" Select Sum(TotalIntereses) Interes, Sum(Cantidad) Cantidad, OperacionRef, Min(FechaOp) FechaDesde, Max(FechaVto) FechaHasta ")
Sqladd(" From "~Dbo()~".OPERACIONES ")
Sqladd(" Where TipoOp = 'MMDC' ")
Sqladd(" AND FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.cuenta1))
Sqladd(" AND (Cuenta1 = '"~dialogo.cuenta1~"' OR Cuenta4 = '"~dialogo.cuenta1~"') ")
endif
Sqladd(" AND FechaOp >= '"~IdxDate(PriDeMes(dialogo.fecha1, SI))~"' ")
Sqladd(" AND FechaOp <= '"~IdxDate(FinDeMes(dialogo.fecha1, SI))~"' ")
Sqladd(" Group By OperacionRef ")
recorrer sql
Acd(fe:2, Query(" Select FechaVto From "~Dbo()~".OPERACIONES Where NrOperacion = '"~Fbn('OperacionRef')~"' "))
if (Val(fe:2) > dialogo.fecha1)
Acd(fe:2, dialogo.fecha1 + 1)
endif
if (Query(" Select 1 From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('OperacionRef')~"' AND Fecha1 = '"~IdxDate(Val(fe:1))~"' ") = 1)
Sqladd(" Update "~Dbo()~".CUOTAS ")
Sqladd(" Set Cantidad1 = "~FStr(Fbn('Cantidad'), 0, 2)~", ")
Sqladd(" Cantidad2 = "~FStr(Fbn('Interes'), 0, 2)~", ")
Sqladd(" Fecha2 = "~IdxDate(Fbn('FechaDesde'))~", ")
Sqladd(" Fecha3 = "~IdxDate(Fbn('FechaHasta'))~" ")
Sqladd(" Where NrOperacion = '"~Fbn('OperacionRef')~"' ")
Sqladd(" AND Fecha1 = '"~IdxDate(Val(fe:1))~"' ")
Sqlnew()
else
Acn(ct:1, Query(" Select Max(NrCuota) From "~Dbo()~".CUOTAS Where NrOperacion = '"~Fbn('OperacionRef')~"' ") + 1)
Sqladd(" Insert Into "~Dbo()~".CUOTAS ")
Sqladd(" (NrOperacion, NrCuota, Fecha1, ")
Sqladd(" Cantidad1, Cantidad2, Fecha2, Fecha3) ")
Sqladd(" Values ")
Sqladd(" ('"~Fbn('OperacionRef')~"', "~FStr(Val(ct:1), 0, 0)~", '"~IdxDate(Val(fe:1))~"', ")
Sqladd(" "~FStr(Fbn('Cantidad'), 0, 2)~", "~FStr(Fbn('Interes'), 0, 2)~", '"~IdxDate(Fbn('FechaDesde'))~"', '"~IdxDate(Fbn('FechaHasta'))~"') ")
Sqlnew()
endif
Sqlexec()

SqlActualizarmovimientos4(Fbn('OperacionRef'), SI, NO, NO, NO, SI, NO)
Sqlexec()
Ejecutarevento('INSBIT', 'string1', 'OPERACIONES', 'entero1', 19, 'nroperacion1', Fbn('OperacionRef'))
proximo


