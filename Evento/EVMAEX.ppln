creardialogo
check1: 'Procesa';1;2;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif

Acn(x:2, dialogo.check1)

Message('    - Iniciando Evento Generacion de Op Titulos por Oferta')
ejecutarevento('GENTIT', check1 = Val(x2))

Message('    - Iniciando Evento Generacion de Adjudicaciones por Oferta')
abrirascii(Var('PATHSIOPEL')~'\LOGGENADJ.txt', 0)
escribirascii(Fecha(Ahora() - 1, 'DDMMYYYY')~'-'~Hora(Ahora())~' - EVMAEX antes llamar al GENADJ')
cerrarascii
ejecutarevento('GENADJ', check1 = Val(x2))

abrirascii(Var('PATHSIOPEL')~'\LOGGENADJ.txt', 0)
escribirascii(Fecha(Ahora() - 1, 'DDMMYYYY')~'-'~Hora(Ahora())~' - EVMAEX despues llamar al GENADJ')
cerrarascii

Message('    - Iniciando Generacion de Ops de Corretaje')
ejecutarevento('GENCOR', check1 = Val(x2))


