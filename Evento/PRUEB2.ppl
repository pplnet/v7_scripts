MostrarCuadroDeMensajes
CrearDialogo
  Fecha1    : 'Fecha'   ;;;;;;Dialogo.Fecha1 = FinDeMes(Dialogo.Fecha1, SI);'Debe ser Fin de Mes';;FinDeMes(PriDeMes(Fsys, SI)-1, SI);
  Cuenta1   : 'Cuenta'  ;;;;;;NoVacio(Dialogo.Cuenta1);'Cuenta Invalida';NO;;;
  Vehiculo1 : 'Vehiculo';;;;;;
  Especie1  : 'Moneda' ;;;;;
FinDialogo

If Not OK
  Cancelar
EndIf

        ACT(CT:1, Dialogo.Cuenta1)
        ACT(VH:1, Dialogo.Vehiculo1)
        ACT(MN:1, Dialogo.Especie1)

Recorrer&k PriDeMes(Dialogo.Fecha1, SI), Dialogo.Fecha1
    IF EsHabil(&k, 'ARG')
        ACT(NR:1, GetNumerador(99))
        CrearDialogo
           Entero1 : 'Saldo' ;;;;;;;;;;;;;'###,###,###.##'
        FinDialogo
        SQL.ADD(" INSERT INTO "~DBO~".OPSEVENTUALES ")
        SQL.ADD(" ( TipoOp,      FechaOp,           Cantidad,              Cuenta1,       Especie,          Vehiculo1,      NrOperacion,    Observac3 )")
        SQL.ADD(" VALUES ")
        SQL.ADD(" ( 'MMEVDE', '"~IdxDate(&k)~"', '"~Dialogo.Entero1~"', '"~Val(CT:1)~"', '"~Val(MN:1)~"', '"~Val(VH:1)~"', '"~Val(NR:1)~"', 'PRUEBA' )") 
        SQL.NEW
        MessageBox(Val(NR:1))
    ENDIF
