ACT(aa:1, 'Codigo')
ACT(aa:2, 'FechaMAE')
ACT(aa:3, 'HoraMAE')
ACT(aa:4, 'Secuencia')
ACT(aa:5, 'CodigoMAE')
ACT(aa:6, 'Estado')

SQL.ADD("Select O.NrOperacion, O.NroAltaMAE ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit      = 77 ")
SQL.ADD("   and OB.Valor      = '1' ")
SQL.ADD("   order by O.NrOperacion")
Recorrer SQL
  ACN(x1, 0)
  ACT(z1, fbn('NrOperacion'))
  ACT(z2, fbn('NroAltaMAE'))
  SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
  SQL.ADD(" where Codigo ='CONBAJ' ")
  SQL.ADD("   and Estado ='A76' ")
  Recorrer SQL
    ACT(ab:1, fbn('Codigo'))
    ACT(ab:2, fbn('FechaMAE'))
    ACT(ab:3, fbn('HoraMAE'))
    ACT(ab:4, fbn('Secuencia'))
    ACT(ab:5, fbn('CodigoMAE'))
    ACT(ab:6, fbn('Estado'))
      
    Message('Preparando Informacion de Busqueda de Ops. (Bajas)')
    ACT(a2, fbn('Mensaje1'))
    if NoVacio(fbn('Mensaje2'))
      ACT(a2, Val(a2)~fbn('Mensaje2'))
    endif
    if NoVacio(fbn('Mensaje3'))
      ACT(a2, Val(a2)~fbn('Mensaje3'))
    endif
      
    if EqStr(Val(z2), Copy(Val(a2),113,5))
      ACT(p1,Copy(Val(a2),11,6))
      ***** Secuencia a confirmar
      ACT(p2,Copy(Val(a2),23,5))
      EjecutarEvento('CONMAE',NrOperacion1=Val(z1), String=Val(p1)~Val(p2), Check1=1, Check2=1)
      
      SQL.ADD("Update "~DBO~".MENSAJESMAE ")
      SQL.ADD("   Set Estado    = 'CON' ")
      SQL.ADD(" Where Codigo    = 'CONBAJ' ")
      SQL.ADD("   and FechaMAE  = '"~Val(ab:2)~"' ")
      SQL.ADD("   and HoraMAE   = '"~Val(ab:3)~"' ")
      SQL.ADD("   and Secuencia = '"~Val(ab:4)~"' ")
      SQL.ADD("   and CodigoMAE = '"~Val(ab:5)~"' ")
      SQL.ADD("   and Estado    = 'A76' ")
      SQL.NEW
      SQL.EXEC
      ACN(x1, 1)
      Break
    endif  
  proximo
  if Val(x1)=1
    SQL.ADD("Update "~DBO~".OPERACIONES ")
    SQL.ADD("   set Rojo = '1' ")
    SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion')~"'")
    SQL.NEW
    SQL.EXEC
  endif
Proximo
