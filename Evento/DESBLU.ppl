ModoReproceso(ConDialogo)
CrearDialogo
  Operador1: 'Usuario' ;;;;  ;  ;;;;;;;;;
  Check1:    'Procesa' ;;;;NO;NO;;;;1
FinDialogo
if Not OK
  Cancelar
Endif

** Procesa - 0=NO, 1=SI
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,10,B')

SQL.ADD(" SELECT DISTINCT A.*, U.Nombre, U.FAcceso, U.Perfil ")
SQL.ADD(" FROM "~DBO~".USUARIOS U, "~DBO~".USUARIOSACTIVOS A ")
SQL.ADD(" WHERE  A.Codigo  = U.Codigo ")
if NoVacio(Dialogo.Operador1)
  SQL.ADD("   AND  A.Codigo  = '"~Dialogo.Operador1~"' ")
endif
SQL.ADD(" ORDER BY A.Codigo  ")

SetFilaActual(1)
ACT(a:FAC, 'Codigo')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Perfil')
ACT(d:FAC, 'F.Acceso')
ACT(e:FAC, 'IP')
ACT(f:FAC, 'Desblouea')
SetFont(a:FAC..f:FAC, 2)

ACN(z:1, 0)
Recorrer SQL
  SCN(z:1, 1)
  ACT(a:FAC, fbn('Codigo'))
  ACT(b:FAC, fbn('Nombre'))
  ACT(c:FAC, fbn('Perfil'))
  ACD(d:FAC, fbn('FAcceso'))
  ACT(e:FAC, fbn('IP'))
  ACN(f:FAC, 0)
Proximo
if val(z:1)=0
  * No nay Usuarios activos
  if Novacio(Dialogo.Operador1)
    MessageBox('El Usuario '~Dialogo.Operador1~' no esta activo')
  else
    MessageBox('No existen Usuarios Activos')
  endif
  if Dialogo.Check1=1
    Cancelar
  else
    ACN(z:2, 1)
  endif
endif

if Val(z:2)=0
  CrearListBox ; 'MS Sans SerIf,8,'
    'Desbloquea'; f:2..f:Fac;SI;SI;; 70;CHECK
    'Codigo'    ; a:2..a:fac;NO;SI;; 80;STRING;;RGB(232,232,255); 
    'Nombre'    ; b:2..b:fac;NO;SI;;150;STRING;;RGB(232,232,255); 
    'Perfil'    ; c:2..c:fac;NO;SI;; 70;STRING;;RGB(232,232,255); 
    'F.Acceso'  ; d:2..d:fac;NO;SI;; 70;FECHA;RGB(232,232,255); 
    'IP'        ; e:2..e:fac;NO;SI;;100;STRING;;RGB(232,232,255); 
  FinListBox

  if not ok
    if Dialogo.Check1=1
      * Procesa
      Cancelar('Evento Cancelado.')
    else
      MessageBox('Evento Cancelado. No Procesa')
      ACN(z:2, 1)
    Endif
  endif
endif
  
if Val(z:2)=0
  Recorrer&i 2, Fac
    If Val(f:&i)=1
      Message('Desbloqueando Usuario...')
      if Dialogo.Check1=1
        SQL.ADD(" Delete "~DBO~".USUARIOSACTIVOS ")
        SQL.ADD("  where Codigo = '"~Val(a:&i)~"' ")
        SQL.NEW
        SQL.EXEC
      Endif
    Endif
  proximo
  MessageBox('Evento finalizo correctamente')
endif
   
ACO(2,15)
ACO(5,10)
