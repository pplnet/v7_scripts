* Cuando el numerador llega al maximo nro. cambiamos el tipo y volvemos a 0 el numero
* MODNUM Reseteo de Numeradores 
CrearDialogo
  Entero1 : 'Codigo'     ;;;;;;SQL("Select count(*) from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ")>0;'El Numerador es INEXISTENTE !!!';NO;
  String2 : 'Tipo'       ;;;;NO;;;;;;SQL("Select Tipo from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ");;;  
  Entero2 : 'Numero'     ;;;;NO;;Dialogo.Entero2=999999;'El Numero para resetear el valor debe ser 999999';NO;;SQL("Select Numero from "~DBO~".NUMERADORES where Codigo="~Fstr(Dialogo.Entero1,0,0)~" ");;;'######'  
  String1 : 'Nuevo Tipo' ;;;;;;Not Vacio(Dialogo.String1);'Ingrese un Tipo de Numerador de dos Caracteres en Mayusculas';NO;;;;;  
FinDialogo

if not Ok  
  Cancelar
endif

If Not EqStr(Pad(Copy(Dialogo.String1,1,2),2),Dialogo.String1)
   Cancelar('El tipo de Numerador debe contener dos caracteres!!!')
EndIf

If Not EqStr(Mayusculas2(Dialogo.String1),Dialogo.String1)
   Cancelar('Ingrese el Tipo de Numerador en Mayusculas !!!')
EndIf

act(a2,Copy(Dialogo.String1,1,2))

SQL.ADD("UPDATE "~DBO~".NUMERADORES Set Tipo='"~val(a2)~"', Numero=0 Where  Codigo="~Fstr(Dialogo.Entero1,0,0)~" ")
SQL.NEW
SQL.EXEC


