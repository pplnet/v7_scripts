            acn(o:fac,((FBN['TotalBrutoCli1']*(val(l:fac)+FBN['TotalNetoCli2']))/100)*FACTORDIAS(FBN['FechaOp2'],FBN['FechaEj'],FBN['RB5']+1)) 
