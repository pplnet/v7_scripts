         If EqStr(FBN['Pata'],'VEHI') 
            acn(o:fac,((FBN['Cantidad']*(val(l:fac)+FBN['Spread']))/100)*FACTORDIAS(FBN['FechaOp2'],FBN['FechaEj'],FBN['RB8']+1) )
            *- Calculo del resultado
            If FBN['RB6']=0
               ACN(ae:fac,FBN['InteresesCorr']-val(o:fac))
