*- Este evento toma tasas estimadas o reales de la
*- tabla de cotizaciones, las impacta en las operaciones y recalcula
*- intereses e impuestos
HojaVisible(SI)

MostrarCuadroDeMensajes
CrearDialogo
  Fecha1       : "Fecha Vigencia"        ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1<=Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  NrOperacion1 : "Operacion"             ;;;;;;
  Radio3       : 'Actualiza|NO|SI'       ;3;1;;;;;;;1;;;
  Lista2       : 'Tipo Op.'              ;;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where (Codigo Like 'MM%' or Codigo In ('DTSFVM','DTSVVM','DTSVV','DTSFV','DTCAP','DTFLO')) and (ClaseOperacion<>'BACKUP' or ClaseOperacion is NULL) ");
  Lista1       : "Vehiculo"              ;1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")); 
  Check1       : 'Automatico'            ;;;;NO;NO;;;;0
  Radio1       : 'Tipo|Reales|Simuladas' ;;2;;;NO;;;;0;;;
  Radio2       : 'Recalcula|NO|SI'       ;;2;;;NO;;;;0;;;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

ACT(ls:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet("Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo='"~UsuarioActivo~"' AND U.Vehiculo=V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(ls:1100, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' or Codigo In ('DTSFVM','DTSVVM','DTSVV','DTSFV','DTCAP','DTFLO')"))

SetFilaActual(1)

***---Grilla con tasas a aplicar
***---(.'REPTAS1'.)

ACT(d:FAC  ,"Informe de Reseto de Tasas del "~Dialogo.Fecha1)
ACT(e:FAC+1," T A S A S     E S T I M A D A S")
ACT(e:FAC+1," T A S A S     D E F I N I T I V A S")

ACT(d:FAC+2," Recalcula : "~IIF(Dialogo.Radio2=0,'NO','SI') )
ACT(d:FAC+3," Actualiza : "~IIF(Dialogo.Radio3=0,'NO','SI') )

SetFont(a:fac..e:fac+5,3)

SetFilaActual(fac+6)
if NoVacio(Dialogo.NrOperacion1)
   ACT(a:fac, 'Operacion: '~Dialogo.NrOperacion1)
else
   ACT(a:fac, 'Operacion: Todas')
endif
if NoVacio(Dialogo.Lista2)
   ACT(a:fac+1, 'Tipo Op.: '~Dialogo.Lista2)
else
   ACT(a:fac+1, 'Tipo Op.: Todas')
endif
if NoVacio(Dialogo.Lista1)
   ACT(a:fac+2, 'Vehiculos : '~Dialogo.Lista1)
else
   ACT(a:fac+2, 'Vehiculos : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
endif
SetFont(a:fac..a:fac+2,2)
SetFilaActual(fac+2)
ACN(xx1,fac+2)

ACT(a:FAC, 'Tasa Tipo')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'NrOperacion')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Entidad')
ACT(f:FAC, 'FInicio')
ACT(g:FAC, 'FFin')
ACT(h:FAC, 'Plazo')
ACT(i:FAC, 'Especie')
ACT(j:FAC, 'V.Nominal')
ACT(k:FAC, 'Imp.Amort.')
ACT(l:FAC, '% Tasa')
ACT(m:FAC, 'Spread')
ACT(n:FAC, 'Tasa Total')
ACT(o:FAC, 'Interes')
ACT(p:FAC, 'WHT')
ACT(q:FAC, 'IVA')
ACT(r:FAC, 'CEC Total')
ACT(s:FAC, 'CEC Var')
ACT(t:FAC, 'CEN Total')
ACT(u:FAC, 'CEN Var')
ACT(v:FAC, 'Imp.Interes')

ACT(x:FAC, 'IVA.CEN')
ACT(y:FAC, 'Cs_Fin_CEC')
ACT(z:FAC, 'Monto')
ACT(aa:FAC, 'Monto Total')
ACT(ab:fac, 'Interes Total')
ACT(ac:fac, 'Impuesto Extr.')
ACT(ad:fac, 'CEN Equiv')
ACT(ae:fac, 'Resultado')
ACT(af:fac, 'Cuota')

*- av: Ut IVA aw: UT WH
ACT(av:fac, 'Tasa Int IVA')
ACT(aw:fac, 'Tasa Int WH')

SetFont(a:fac..ah:fac,2)
AgregarMarco(a:FAC..ah:FAC,2,0,Exe('COLOR'))
ifa

*- re1: 0 Real 1 Simulado
ACN(re1,Dialogo.Radio1)

*- Operaciones Multiple Vto
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,C.Cantidad1,C.Cantidad2,C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,' ' as Pata,C.Cantidad3,C.Cantidad4,O.OperacionRef,O.TotalAux4, O.CB2, C.Fecha3 ")
SQL.ADD(" from  "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("       AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
   SQL.ADD("       AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
IF Dialogo.Radio1=1 y Dialogo.Radio2=0
   * Tasas Simuladas -> Que no se haya ingresado ya la tasa simulada
   SQL.ADD(" and ((C.Check10 Is Null or C.Check10='' or C.Check10='0') and (((C.Precio1=0  or C.Precio1 Is Null or  C.Precio1='') and O.TipoOp Not In ('MMPCCM','MMFIMV','MMSIMV')) or ((C.Precio2=0  or C.Precio2 Is Null or  C.Precio2='') and O.TipoOp In ('MMPCCM','MMFIMV','MMSIMV')) )) ")
ENDIF

SQL.ADD("       and O.TipoOp In ('MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMONM','MMPCCM','MMCPM') ")
SQL.ADD("       and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
***Si la tasa se setea antes del inicio del período, es solo con ese día***
SQL.ADD("       and ((C.Fecha4 = '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=0) ")
***Si la tasa se setea antes del vto, se setea desde el inicio hasta la fecha reset***
SQL.ADD("       or (C.Fecha4 >= '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=1)) ")
SQL.ADD("       and O.TipoTasa<>'FIJA' ")
SQL.ADD(" Union ")
*- Operaciones Unico Vto
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.Cantidad Cantidad1,O.Cantidad Cantidad2,0 Total5,O.Plazo Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaOp Fecha1,O.FechaVto Fecha2,0 Total6,0 Precio3,0 Cantidad7, '0' Check1,0 Cantidad4,0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,' ' as Pata, 0 Cantidad3,0 Cantidad4,O.OperacionRef,O.TotalAux4, O.CB2, O.FechaOp Fecha3 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMFRN','MMFRNP','MMPSC','MMPSI','MMPCL','MMPCOS','MMPE','MMPI','MMPLME','MMON','MMPCCV','MMCP') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
IF Dialogo.Radio1=1 y Dialogo.Radio2=0
   * Tasas Simuladas -> Que no se haya ingresado ya la tasa simulada
   SQL.ADD(" and ((O.ValorRB1 Is Null or O.ValorRB1='' or O.ValorRB1='0') and (O.Precio1=0  or O.Precio1 Is Null or O.Precio1='')) ")
ENDIF

SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoTasa<>'FIJA' ")
SQL.ADD(" Union ")
***---Swap Datos Vehiculo
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,C.Cantidad1 ,C.Cantidad2 , C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,'VEHI' as Pata,C.Cantidad3,C.Cantidad4,O.OperacionRef,O.TotalAux4, O.CB2, O.FechaOp Fecha3 ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD(" AND O.TipoOp IN ('DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
***Si la tasa se setea antes del inicio del período, es solo con ese día***
SQL.ADD("       and ((C.Fecha4 = '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=0) ")
***Si la tasa se setea antes del vto, se setea desde el inicio hasta la fecha reset***
SQL.ADD("       or (C.Fecha4 >= '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=1)) ")
SQL.ADD(" AND O.TipoTasa<>'FIJA' AND O.TipoTasa Is Not Null AND O.TipoTasa<>' ' ")
SQL.ADD(" Union ")
***---Swap Datos Contraparte
SQL.ADD("SELECT O.TipoTasa2 TipoTasa,O.TipoOp,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,C.Cantidad1 ,C.Cantidad2 , C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,'CONT' as Pata,C.Cantidad3,C.Cantidad4,'' OperacionRef,O.TotalAux4, O.CB2, O.FechaOp Fecha3 ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O  ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
EndIf
SQL.ADD(" AND O.TipoOp IN ('DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
***Si la tasa se setea antes del inicio del período, es solo con ese día***
SQL.ADD("       and ((C.Fecha4 = '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=0) ")
***Si la tasa se setea antes del vto, se setea desde el inicio hasta la fecha reset***
SQL.ADD("       or (C.Fecha4 >= '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' and O.RB16=1)) ")
SQL.ADD(" AND O.TipoTasa2<>'FIJA' AND O.TipoTasa2 Is Not Null AND O.TipoTasa2<>' ' ")
SQL.ADD(" UNION ")
***---Swaps Unico Vto Datos Vehiculo
SQL.ADD("SELECT O.TipoTasa,O.TipoOp,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,0 Cantidad1,0 Cantidad2,0 Total5,0 Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaCargaSys Fecha1,O.FechaCargaSys Fecha2,0 Total6,0 Precio3,0 Cantidad7, '0' Check1,0 Cantidad4,0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,'VEHI' as Pata, 0 Cantidad3,0 Cantidad4,O.OperacionRef, O.TotalAux4, O.CB2, O.FechaOp Fecha3")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('DTSFV','DTSVV')  ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoTasa<>'FIJA' AND O.TipoTasa Is Not Null AND O.TipoTasa<>' ' ")
SQL.ADD(" UNION ")
***--- Swaps Unico Vto Datos Contraparte
SQL.ADD("SELECT O.TipoTasa2 TipoTasa,O.TipoOp,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,O.Vehiculo1,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaOp,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,0 Cantidad1,0 Cantidad2,0 Total5,0 Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaCargaSys Fecha1,O.FechaCargaSys Fecha2,0 Total6,0 Precio3,0 Cantidad7,'0' Check1,0 Cantidad4, 0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,'CONT' as Pata, 0 Cantidad3,0 Cantidad4,'' OperacionRef,O.TotalAux4, O.CB2, O.FechaOp Fecha3 ")
SQL.ADD(" From "~DBO~".OPERACIONES O")
SQL.ADD(" Where ")
SQL.ADD(" O.TipoOp IN ('DTSFV','DTSVV') ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
