sql.add(" Select  MP.NrOperacion,  MP.FechaMov, MP.Cliente,     MP.Especie,    MP.Mercado, ")
sql.add("         MP.EnteCustodia, MP.Cantidad, MP.Leyenda,     MP.Bits,       MP.NrSaldo, ")
sql.add("         MP.Cuenta,       MP.NrMov,    MP.Transaccion, MP.Book,       MP.Vehiculo,   ")
sql.add("         MP.NrGrupo,      MP.Concepto, MP.Status,      MP.Cupon,      MP.Formula, ")
sql.add("         MP.NrGrupo2,     MP.NrInstan, O.TipoOp,       ")
sql.add("         O.ConceptoFail ")
sql.add(" from  "~Dbo()~".MOVPENDIENTES MP, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS B ,"~Dbo()~".OPERACIONES O ")
sql.add(" where  MP.Cliente    = C.Codigo ")
if (NoVacio(dialogo.nroperacion1))
sql.add(" AND    MP.NrOperacion = '"~dialogo.nroperacion1~"'      ")
endif
sql.add(" AND    MP.NrOperacion = B.NrOperacion                 ")
sql.add(" AND    MP.NrOperacion = O.NrOperacion                 ")
sql.add(" AND    B.NrBit       = 10                             ")
sql.add(" AND    B.Valor       = '1'                            ")
sql.add(" AND    MP.FechaMov   = "~IdxDate2(dialogo.fecha1)~"   ")
sql.add(" and    O.TipoOp In ('TIC','TIV','TIFC','TIFV','TCOPRI')  ")
if (NoVacio(dialogo.vehiculo1))
sql.add(" AND    MP.EnteCustodia = '"~dialogo.vehiculo1~"'       ")
endif
if (NoVacio(dialogo.cliente1))
sql.add(" AND    MP.Cliente = '"~dialogo.cliente1~"'         ")
endif
sql.add(" AND    O.Mercado = '"~dialogo.mercado1~"'            ")
sql.add(" AND Exists (SELECT 1 FROM "~Dbo()~".MOVPENDIENTES MP2 ")
sql.add("              WHERE MP2.NrOperacion=MP.NrOperacion ")
sql.add("                AND MP2.Especie=MP.Especie ")
sql.add("              GROUP BY MP2.NrOperacion, MP2.Especie ")
sql.add("              HAVING COUNT(1)=1) ")

sql.add(" ORDER  BY MP.NrOperacion                              ")
Watch(sql.batch)
Acn(z:1, 0)
recorrer sql
Message(Fbn('NrOperacion'))

Acn(a:fac, 0)
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('Especie'))
Act(d:fac, Fbn('Cliente'))
Act(e:fac, Fbn('Mercado'))
Act(f:fac, Fbn('EnteCustodia'))
Act(g:fac, Fbn('Bits'))
