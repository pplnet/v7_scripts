creardialogo
fecha1:'FechaMov';;;;;;dialogo.fecha1 <= FSys();'FechaMov Invalida. No puede ser mayor que FSys.';NO;FSys()
cliente1:'Cliente';;;;;;
vehiculo1:'Vehiculo';;;;;;;;;
mercado1:'Mercado';;;;;;NoVacio(dialogo.mercado1) y Eqstr(BuscarCampo('MERCADOS', 'NETEA', 'Codigo', dialogo.mercado1), 'NO');'Si desea Seleccionar debe ingresar Mercado que no Netea';NO;'CV';;;;;" NETEA='NO' "
nroperacion1: 'Operacion';;;;;;;;;;;;;;" NrOperacion in (SELECT NrOperacion from "~Dbo()~".MOVPENDIENTES where OPERACIONES.NrOperacion=MOVPENDIENTES.NrOperacion ) and TipoOP in ('TIC','TIV','TIFC','TIFV','TCOPRI')"
check2:'Procesa';;;;NO;NO;;;;1
findialogo
if (not ok)
