Sqladd(" SELECT DISTINCT T.*, C.RazonSocial, E.TamanioLote, CU.Especie1 CUEspecie1, ")
Sqladd(" CU.Cantidad1 CUCantidad1, CU.Cliente1 CUCliente1, CU.Mercado1 CUMercado1, CU.Cuenta1 ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CLIENTES C, "~Dbo()~".MOVPENDIENTES M,  ")
Sqladd(" "~Dbo()~".ESPECIES E, "~Dbo()~".CUOTAS CU")
Sqladd(" WHERE T.Cliente1 = C.Codigo  ")
Sqladd(" AND   T.Cliente1 = M.Cliente ")
Sqladd(" AND   T.NrTrans  = CU.NrOperacion ")
Sqladd(" AND   M.Especie  = CU.Especie1    ")
Sqladd(" AND   T.Especie  = E.Codigo  ")
Sqladd(" AND   T.NrTrans  = M.NrOperacion ")
Sqladd(" AND  C.Status = 'HAB' ")
Sqladd(" AND ((C.CategDepositante='CLI' ) OR (C.Codigo='"~dialogo.vehiculo1~"')) ")
Sqladd(" AND   T.TipoTr2  = 'SPINOF' ")
Sqladd(" AND   T.Especie  = '"~dialogo.especie1~"'")
Sqladd(" AND   T.Fecha1   = '"~IdxDate(dialogo.fecha2)~"'")
Sqladd(" AND   T.Fecha2   = '"~IdxDate(dialogo.fecha1)~"'")
if (NoVacio(dialogo.mercado1))
Sqladd(" AND   T.Mercado1 = '"~dialogo.mercado1~"'")
endif
Sqladd(" AND  T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" ORDER BY T.Cliente1, T.NrTrans")

