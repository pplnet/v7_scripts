MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Fecha';1;1;;;;;;;FSys()
vehiculo1: 'Vehiculo';2;;;NO;;;;;Var('VEHICON')
listatabla1: 'Operaciones';1;2;;;;;;;;;;;;;'NrOperacion';'NrOperacion;Cliente1;FechaOp;Especie;FechaVto';'OPERACIONES'
check1: 'Contab.Procesada';3;1;;NO;NO;
radio1: 'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos';4;1;;NO;NO;;;;4;

findialogo

if (not ok)
Raise('Evento Cancelado')
endif


Message('--- Asientos de Concertacion ---')

Act(me:1, Var('MONEEXTR'))
Act(ml:1, Var('MONELOCA'))
Acn(na:1, Var('ASINUM'))
Acn(sl:1, Var('SALDOPOCON'))
Act(vc:1, dialogo.vehiculo1)
Acd(fe:1, Habiles(dialogo.fecha1, -Var('FVALORCONT'), 'ARG'))
Act(cm:1, Var('CLIENTEMAE'))

Sqladd(" SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, ")
Sqladd(" O.Mercado4, C.PaisDir, O.Cuenta1, ")
Sqladd(" Case When O.TipoOp = 'FXCF' Then O.TotalBrutoCli1 When O.TipoOp = 'FXVF' Then O.TotalBrutoCli1 Else O.TotalNetoCli1 End TotalNetoCli1, ")
Sqladd(" O.ContraEspecie, O.Especie, O.FechaOp, ")
Sqladd(" Case When O.TipoOp = 'TCOPRI' Then Case when O.ContraEspecie = 'ARP' then O.Precio1 else O.PorDerechoMercado*O.Precio1 end WHEN O.TipoOp = 'FXCF' THEN O.Precio1 WHEN O.TipoOp = 'FXVF' THEN O.Precio1 ELSE O.PorDerechoMercado END PorDerechoMercado, ")
Sqladd("'#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
Sqladd("(CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as Cliente, ")
Sqladd(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
Sqladd(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, Case when O.TipoOp = 'FXC' OR O.TipoOp='FXV' then O.Especie else O.ContraEspecie End Moneda, ")
Sqladd(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
Sqladd(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4, O.Cuenta3 CtaBcoOp, ")
Sqladd(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
Sqladd(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
Sqladd("       INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON O.Cliente1 = C.Codigo ")
Sqladd(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
Sqladd(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
Sqladd(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" AND O.FechaCargaSys >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd(" AND O.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
if (dialogo.radio1 = 4)
Sqladd(" AND ((O.TipoOp IN ('TICF','TIVF','FXK', 'TIPP','TIPA','FXCF','FXVF','TCOPRI','FXC','FXV','FXJ')) ")
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
else 
if (dialogo.radio1 = 0)
Sqladd(" AND ((O.TipoOp IN ('TICF','TIVF','TIPP','TIPA','TCOPRI')) ")
Sqladd("   OR (O.TipoOp IN ('TIC','TIV')  ")
Sqladd("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
else 
if (dialogo.radio1 = 1)
Sqladd(" AND O.TipoOp IN ('FXK','FXC','FXV','FXJ')")
else 
if (dialogo.radio1 = 2)
Sqladd(" AND O.TipoOp IN ('FXCF','FXVF') ")
else 
if (dialogo.radio1 = 3)
endif
endif
endif
endif
endif
if (dialogo.radio1 = 0 o dialogo.radio1 = 4)
Sqladd(" UNION ")
Sqladd("SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
Sqladd("C.PaisDir, O.Cuenta1, ABS(MO.Cantidad) as TotalNetoCli1,  MO.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
Sqladd("O.PorDerechoMercado, ")
Sqladd("'#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, ")
Sqladd(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
Sqladd(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, O.ContraEspecie Moneda, ")
Sqladd(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
Sqladd(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4,O.Cuenta3 CtaBcoOp, ")
Sqladd(" E.Issuer, E.Alias1 as EspBanTotal,O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
Sqladd(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
Sqladd("       INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON O.Cliente1 = C.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".MOVPENDIENTES MO ON MO.NrOperacion = O.NrOperacion ")
Sqladd(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
Sqladd(" and MO.NrGrupo=2 ")
Sqladd(" AND MA.TipoAsiento = '"~Var('TIPASIC')~"' ")
Sqladd(" AND O.TipoOp in ('TCPCEM') ")
Sqladd(" AND O.CB10 = 1 ")
Sqladd(" AND O.FechaVto2 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd(" AND O.FechaVto2 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND O.NrOperacion IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" UNION ")
Sqladd("SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
Sqladd("C.PaisDir, O.Cuenta1, ABS(MO.Cantidad) as TotalNetoCli1,  MO.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
Sqladd("O.PorDerechoMercado, ")
Sqladd("'#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, ")
Sqladd(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
Sqladd(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, O.ContraEspecie Moneda, ")
Sqladd(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
Sqladd(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4,O.Cuenta3 CtaBcoOp, ")
Sqladd(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
Sqladd(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
Sqladd(" FROM "~Dbo()~".OPERACIONES O ")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
Sqladd("       INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON O.Cliente1 = C.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".MOVEJECUTADOS MO ON MO.NrOperacion = O.NrOperacion ")
Sqladd(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
