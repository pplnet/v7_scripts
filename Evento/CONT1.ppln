Sqladd(" SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4,  ")
Sqladd(" C.PaisDir, O.Cuenta1, O.TotalNetoCli1 TotalNetoCli1, O.ContraEspecie, O.Especie, O.FechaOp, O.PorDerechoMercado PorDerechoMercado, ")
Sqladd("'#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, O.Cliente1 as Cliente, ")
Sqladd(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
Sqladd(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo,  O.Especie Moneda, ")
Sqladd(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
Sqladd(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4, O.Cuenta3 CtaBcoOp, ")
