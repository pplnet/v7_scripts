endif


if Dialogo.Radio1=0
  if Dialogo.Check1=0
    MessageBox('EjecutarEvento() Sin procesar')
AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - MAEFAC EjeEve() - Sin Procesar')
CerrarASCII
    EjecutarEvento('EVMAEX',Check1=0)
  else
    MessageBox('EjecutarEvento() Con procesar')
AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - MAEFAC EjeEve() - Procesa')
CerrarASCII
    EjecutarEvento('EVMAEX',Check1=1)
  endif
else
  if Dialogo.Check1=0
    MessageBox('EjecutarEvento2() Sin procesar')
AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - MAEFAC EjeEve2() - Sin Procesar')
CerrarASCII
    EjecutarEvento2('EVMAEX',Check1=0)
  else
    MessageBox('EjecutarEvento2() Con procesar')
AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - MAEFAC EjeEve2() - Procesa')
CerrarASCII
    EjecutarEvento2('EVMAEX',Check1=1)
  endif
endif

AbrirASCII(VAR('PATHSIOPEL')~'\LOGGENADJ.txt',0)
EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~' - Fin MAEFAC')
CerrarASCII

