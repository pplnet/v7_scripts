creardialogo
lista1:'Especies';1;1;;;;;;;;;SQLSet("Select Codigo  from "~Dbo()~".ESPECIES")
string1:'Codigo';2;1;
findialogo

if (not ok)
Cancelar()
endif
Act(a:1, SQLSet("select Especies from RankingsTiposValuacion WHERE Codigo <> '"~dialogo.string1~"'"))
Act(a:2, '')
Act(a:3, '')
recorrer&i 1, Elementos(dialogo.lista1)
if (Incluido(ItemLista(dialogo.lista1, &i), Val(a:1)))
if (Eqstr(Val(a:2), ''))
Act(a:2, ItemLista(dialogo.lista1, &i))
else
Act(a:2, Val(a:2)~'|'~ItemLista(dialogo.lista1, &i))
endif
else
if (Eqstr(Val(a:3), ''))
Act(a:3, ItemLista(dialogo.lista1, &i)~'|')
else
Act(a:3, Val(a:3)~''~ItemLista(dialogo.lista1, &i)~'|')
endif
endif
proximo
Sqladd("UPDATE RankingsTiposValuacion SET Especies = '"~Val(a:3)~"' WHERE Codigo = '"~dialogo.string1~"'")
Sqlnew()
Sqlexec()
if (not Eqstr(Val(a:2), ''))
Messagebox('Las siguientes especies ya estan asignadas a otros Rankings:'~Val(a:2))
endif
