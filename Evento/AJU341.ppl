    SQL.ADD(" WHERE Estrategia  = '"~Val(b:2)~"' ")
    if NoVacio(Dialogo.Especie1)
      SQL.ADD(" WHERE Especie  = '"~Dialogo.Especie1~"' ")
    endif
    SQL.NEW
    
