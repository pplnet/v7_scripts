*messagebox('Inicio INFBOL')
* Este evento toma las operaciones que se encuentran en la instancia Env¡o de Boletos al MAE (65)
* y con el nro. del mismo ya asignado lo informa al MAE

*HojaVisible(SI)

ACT(x:1, 'SI')
ACT(x:2, BuscarCampo('VARIABLES','Valor','Codigo','INFBOLMAE'))
if EqStr(Val(x:2),'NO')
  ACT(x:1, 'NO')
endif

SQL.ADD("Select O.Operador, O.FechaAltaMAE, O.NrOperacion, O.TipoOp,  ")
** FJL 15/07/21 - Se agrega campo para TCOPRI por Contingencia
*SQL.ADD("       O.CB7,      O.Cliente1,     O.NroAltaMAE,  O.NrBoleto ")
SQL.ADD("       O.CB7,      O.CB10, O.Cliente1,     O.NroAltaMAE,  O.NrBoleto ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 65 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD("   and IsNull(O.Plataforma,'SIOPEL') = 'SIOPEL' ")
*SQL.ADD("   and O.NrOperacion = 'T0027371' ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL     
  if Incluido(fbn('TipoOp'), 'TIC|TIV|TIFV|TIFC|TCOPRI') y NoVacio(fbn('FechaAltaMAE'))
    if Not EqStr(fbn('CB7'),'1') y EqStr(Val(x:1),'SI')
      * No es NoMAE
      *************************** Prepara info para Bloque de Control *************************
      * Longitud             PIC(4)                                                           *
      * Mercado              PIC(1)                                                           *
      * Agente               PIC(3)                                                           *
      * Operador             PIC(2)                                                           *
      * Fecha                PIC(6)                                                           *
      * Hora                 PIC(6)                                                           *
      * Secuencia            PIC(5)                                                           *
      * C¢d. de Registro     PIC(4)                                                           *
      *****************************************************************************************
      ACN(Y1, Ahora)
      ACT(Y2, Hora(Val(Y1)))
      ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
      ***** Mercado         
      ACT(A2, Var('MERSIOP'))          
      ***** Agente          
      ACT(A2, Val(A2)~Var('AGESIOP'))
      ***** Operador (Por ahora va siempre 99)
      ACN(M7,0)             
* FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
*      ACT(A2, Val(A2)~'99')
      ACT(A2, Val(A2)~Var('OPESIOPEL'))
      ***** Fecha           
      ACT(A2, Val(A2)~Val(Y3))
      ***** Hora            
      ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
      ACT(A2, Val(A2)~Copy(Val(Y2),4,2))
      ACT(A2, Val(A2)~Copy(Val(Y2),7,2))
      ***** Secuencia       
      ACT(A2, Val(A2)~'1')  
      ACT(A2, Val(A2)~Copy(FBN['NrOperacion'],5,4))
      ***** Cod. de Registro (1era parte) 
      If Incluido(FBN['TipoOp'],'TIV|TIFV')
        ACT(A2, Val(A2)~'03')
      Endif                 
      If Incluido(FBN['TipoOp'],'TIC|TIFC|TCOPRI')
        ACT(A2, Val(A2)~'04')
      Endif                 
      ***** Cod. de Registro (2da parte) (05 FSYS, 06 ayer)
      ACT(y5, Fecha(Trunc2(fbn('FechaAltaMAE'))))
      ACN(y4, Fecha(Val(y5)))
      if Val(y4) > FSYS
        ACN(y4, FSYS)
      endif
      if Val(y4) < FSYS
        ACT(A2, Val(A2)~'06')
      EndIf                 
      if Val(y4) = FSYS
        ACT(A2, Val(A2)~'05') 
      endif
      *****************************  Datos Operaci¢n  *****************************************
      * Fecha            PIC(6)  (Que forma parte del nro de alta del MAE)                    *
      * Secuencia        PIC(5)  (NroAltaMAE)                                                 *
      *****************************************************************************************
      BorrarCeldas(ac:1..ac:2)
      ACT(ac:1, FBN['NrOperacion'])
*****************************************************
* Reemplazo esto porque no lo entiendo (FJL 29/06/05)
*      SQL.ADD("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' ")
*      Recorrer SQL
*        ACN(ac:2, Trunc2(SQL("Select FechaAltaMAE from "~DBO~".OPERACIONES where NrOperacion = '"~Val(ac:1)~"' ")))
*        if Val(ac:2)>FSYS
*          ACN(ac:2, FSYS)
*        endif
*        ACT(y6, Fecha(Val(ac:2), Exe('FORFECMAE')))
*        ACT(A2, Val(A2)~Val(y6))
*      Proximo           
      ACN(ac:2, Trunc2(SQL("Select FechaAltaMAE from "~DBO~".OPERACIONES where NrOperacion = '"~Val(ac:1)~"' ")))
      if Val(ac:2)>FSYS
        ACN(ac:2, FSYS)
      endif
      ACT(y6, Fecha(Val(ac:2), Exe('FORFECMAE')))
      ACT(A2, Val(A2)~Val(y6))
************************
      *****  Secuencia          
      ACT(A2, Val(A2)~Pad0(Copy(FBN['NroAltaMAE'],1,5),5))
      *********************** C¢digo de Agente Contraparte ************************************
      * Mercado Contra   PIC(1)                                                               *
      * Agente Contra    PIC(3)                                                               *
      * Operador Contra  PIC(2)                                                               *
      *****************************************************************************************
      ACT(A4, Var('MERSIOP'))                            
      ACT(A4, Val(A4)~Var('AGESIOP'))
* FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
*      ACT(A4, Val(A4)~'99') 
      ACT(A4, Val(A4)~Var('OPESIOPEL'))
      ACT(A2, Val(A2)~Val(A4))  
      ********************************  Datos Del Boleto **************************************
      * N£mero del Boleto   PIC(7)                                                            *
      * Tipo de Dolar       PIC(1)                                                            *
      *****************************************************************************************
      *****  NroBoleto   
      ACT(A2, Val(A2)~Copy(Pad0(FStr(Num(FBN['NrBoleto']),1,0),7),1,7))
      ***** Tipo de Dolar       
      ACT(A2, Val(A2)~'0')
***********************************************************************************************
* Por Siopel 8
*----------------------------------------------------------------------------------------------
* Minuta      PIC 9(9)                                                                  *
* Comitente   X(15) Si campo NrMae = 0 o vacio, el CUIT-MAE se informa en este campo
* Contraparte X(15) Si campo NrMae <> 0 o vacio, el CUIT-MAE se informa en este campo
***********************************************************************************************
      ***********************************************************************************************
      *** Minuta       
      ACT(A2, Val(A2)~'000000000') 
      *** Comitente y Contraparte
      Borrarceldas(yy:1..yy:1)
      ACT(yy:2,FBN['Cliente1'])
      (.'CUITMAE'.)        
      ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
      If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
         *** Comitente
*   Solo se debe informar cuit si es modificacion de Comitente
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*         ACT(A2, Val(A2)~Pad(Val(yy:10),15))
** FJL 21/04/23 - En las pruebas de LICI rechazaba esto
         if Incluido(fbn('TipoOp'),'TCOPRI')
           ACT(A2, Val(A2)~Pad(' ',15))
         else
           ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),15),1,15))
         endif
*         ACT(A2, Val(A2)~Pad(' ',15))
         *** Contraparte
         ACT(A2, Val(A2)~Pad(' ',15))
      Else
         *** Comitente
         ACT(A2, Val(A2)~Pad(' ',15))
         *** Contraparte
*   Solo se debe informar cuit si es modificacion de Contraparte
*         ACT(A2, Val(A2)~Pad(Val(yy:10),15))
         ACT(A2, Val(A2)~Pad(' ',15))
      Endif



      *****  Longitud del Mensaje
      ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4) )
      ACT(A2, Val(P1)~Val(A2))  
      Socket.Enviar(Val(A2))
      if Not OK
        Message('Error Enviando '~' Operacion Nro : '~FBN['NrOperacion'])
      else
        if Eqstr(Var('LOGEAMAE'),'SI')
          AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.txt',0)
          EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
          CerrarASCII
        endif

*        SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
*        SQL.ADD("   Set Valor       = '1' ")
*        SQL.ADD(" Where NrBit       = 66 ")
*        SQL.ADD("   and NrOperacion = '"~FBN['NrOperacion']~"' ")
*        SQL.NEW                   
*        SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
*        SQL.ADD("   Set Valor       = '0' ")    
*        SQL.ADD(" Where NrBit       = 65 ")
*        SQL.ADD("   and NrOperacion = '"~FBN['NrOperacion']~"' ")
*        SQL.NEW                   
*        SQL.EXEC        
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=65, Entero2=66)
      endif
    else
      if EqStr(fbn('CB7'),'1') o EqStr(Val(x:1),'NO')
        * Es NoMAE
*        SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
*        SQL.ADD("   Set Valor       = '1' ")
*        SQL.ADD(" where NrBit       = 67 ")
*        SQL.ADD("   and NrOperacion = '"~fbn('NrOperacion')~"' ")
*        SQL.NEW                   
*        SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
*        SQL.ADD("   Set Valor       = '0' ")    
*        SQL.ADD(" where NrBit       = 65 ")
*        SQL.ADD("   and NrOperacion = '"~fbn('NrOperacion')~"' ")
*        SQL.NEW                   
*        SQL.EXEC        
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=65, Entero2=67)
      endif
    endif   
** FJL 15/07/21 - Se agrega condicion para TCOPRI por Contingencia
  else
    if Incluido(fbn('TipoOp'),'TCOPRI') y EqStr(fbn('CB10'),'1')
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=65, Entero2=67)
    endif                         
  endif                         
Proximo                           
*messagebox('Fin')
