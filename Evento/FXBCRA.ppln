Message('Genera Minuta FX BCRA por op.# '~dialogo.nroperacion1)

if (BuscarCampo('OPERACIONES', 'RB2', 'NrOperacion', dialogo.nroperacion1) = 0)
Messagebox('La Operacion '~dialogo.nroperacion1~' no es por circular BCRA')
Cancelar()
endif

Act(aa1, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', dialogo.nroperacion1))
if (Eqstr(Val(aa1), 'FXC'))
Act(aa2, 'FXV')
endif
if (Eqstr(Val(aa1), 'FXV'))
Act(aa2, 'FXC')
endif
Act(ab1, Query("SELECT NrOperacion from "~Dbo()~".OPERACIONES where OperacionRef='"~dialogo.nroperacion1~"' and TipoOp='"~Val(aa2)~"' and RB2='1' "))
if (NoVacio(Val(ab1)))
Messagebox('Ya existe operacion BCRA relacionada. '~Val(ab1))
Cancelar()
endif

Act(ab1, getnumerador(1))

