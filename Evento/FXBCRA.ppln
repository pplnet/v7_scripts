sql.add("  "~FStr(Fbn('Cantidad'), 1, 2)~", ")
else
sql.add("  ("~FStr(-Fbn('Cantidad'), 1, 2)~"), ")
endif
sql.add("  "~FStr(Fbn('Precio1'), 1, 8)~", ")
sql.add(" '"~Fbn()['Book1']~"', ")

sql.add("   'FX', ")
sql.add("   'FX', ")
sql.add("   '"~Val(ab1)~"' ")

sql.add(" ) ")
