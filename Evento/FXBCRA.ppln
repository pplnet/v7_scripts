Sqladd("  '"~Fbn('Vehiculo1')~"', ")

Sqladd("   31, ")
if (Incluido(Fbn()['TipoOp'], 'FXC|FXA|'))
Sqladd("  "~FStr(Fbn('Cantidad'), 1, 2)~", ")
else
Sqladd("  ("~FStr(-Fbn('Cantidad'), 1, 2)~"), ")
endif
Sqladd("  "~FStr(Fbn('Precio1'), 1, 8)~", ")
Sqladd(" '"~Fbn()['Book1']~"', ")

Sqladd("   'FX', ")
