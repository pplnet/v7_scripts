Sqladd("SELECT O.Cliente1, O.Cuenta1, O.NrOperacion, O.Cantidad, O.FechaOp,")
Sqladd("O.Plazo, O.Precio1, O.Precio4, CL.OficialCuenta, O.FechaVto")
Sqladd("FROM "~Dbo()~".OPERACIONES O INNER JOIN "~Dbo()~".CUENTAS CU ")
Sqladd("ON O.Cliente1 = CU.Cliente AND O.Cuenta1 = CU.Codigo")
Sqladd("INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo")
Sqladd("INNER JOIN "~Dbo()~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
Sqladd("WHERE O.TipoOp = 'MMCREM' AND O.FechaVto >= "~IdxDate2(&diahabil)~" AND  O.FechaVto <= "~IdxDate2(dialogo.fecha1)~" AND O.Especie = '"~dialogo.string1~"'")
if (Eqstr(dialogo.string2, 'TEM'))
Sqladd("AND CU.TEM = 'SI'")
else
Sqladd("AND ISNULL(CU.TEM, 'NO') = 'NO'")
endif
if (NoVacio(dialogo.listatabla1))
Sqladd("AND O.Cliente1 IN ("~Pipe2Comillas(dialogo.listatabla1)~")")
endif
if (NoVacio(dialogo.listatabla2))
Sqladd("AND CL.OficialCuenta IN ("~Pipe2Comillas(dialogo.listatabla2)~")")
endif
Sqladd("AND O.Sector1 = '"~dialogo.string3~"'")
Sqladd("AND O.Cliente1 NOT IN (SELECT cliente FROM "~Dbo()~".GRUPOSECONOMICOS WHERE cliente IS NOT NULL)")
Sqladd("AND ISNULL(TRIM(NrOperacion4), '') = ''")
Sqladd("AND OB.NrBit IN ('70','93') ")
Sqladd("AND O.FechaOp <> O.FechaVto")


