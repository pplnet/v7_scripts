entero1:'Instancia';;;;;;;;;;;;;;;;;;;;;;;
radio1:'Avanza|SI|NO';;;;;;;;;;;;;;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif


Acn(ga:1, 10)
Acn(gf:1, 12)
Acn(gm:1, 13)
Acn(fo:1, 14)
Acn(gg:1, 15)
Acn(iv:1, 16)
Acn(ip:1, 17)
Acn(ic:1, 19)

if (dialogo.radio1 = 0)
Acn( in :1, 0)
Acn( in :2, 0)
Sqladd(" Select O.TipoOp, O.TotalAux3, O.PrecioMer, O.CantImpresiones3, O.Plazo, C.MontoR1, ")
Sqladd(" C.MontoR2, C.MontoR3, C.PlazoR1, C.PlazoR2, C.PlazoR3 ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".TIPOSOPERACION T, "~Dbo()~".CLASESOPERACION C ")
Sqladd(" Where T.Codigo = O.TipoOp ")
Sqladd(" AND T.ClaseOperacion = C.Codigo ")
Sqladd(" AND O.NrOperacion = '"~dialogo.nroperacion1~"' ")
recorrer sql
Acn(mn:1, Fbn('MontoR1'))
Acn(mn:2, Fbn('MontoR2'))
Acn(mn:3, Fbn('MontoR3'))
Acn(pl:1, Fbn('PlazoR1'))
Acn(pl:2, Fbn('PlazoR2'))
Acn(pl:3, Fbn('PlazoR3'))
if (Incluido(Fbn('TipoOp'), 'DFXO|DSEO'))
Acn(md:1, Fbn('TotalAux3'))
else
Acn(md:1, Fbn('PrecioMer'))
endif
if (dialogo.entero1 = Val(ga:1) o dialogo.entero1 = Val(gf:1) o dialogo.entero1 = Val(gm:1))
if (Val(mn:1) > 0)
if (Fbn('CantImpresiones3') = 1)
if (Val(md:1) <= Val(mn:1) y Fbn('Plazo') <= Val(pl:1))
Acn( in :1, Val(ic:1))
else
Acn( in :1, Val(fo:1))
endif
endif
Acn(cm:3, Fbn('CantImpresiones3') + 1)
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set CantImpresiones3 = "~FStr(Val(cm:3), 0, 0)~" ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqlnew()
else
Acn( in :1, Val(fo:1))
endif
else
if (dialogo.entero1 = Val(fo:1))
if (Val(md:1) <= Val(mn:2) y Fbn('Plazo') <= Val(pl:2))
Acn( in :1, Val(ic:1))
else
Acn( in :1, Val(gg:1))
endif
else
if (dialogo.entero1 = Val(gg:1))
if (Val(md:1) <= Val(mn:3) y Fbn('Plazo') <= Val(pl:3))
Acn( in :1, Val(ic:1))
else
Acn( in :1, Val(iv:1))
Acn( in :2, Val(ip:1))
endif
else
if (dialogo.entero1 = Val(iv:1))
Acn( in :1, Val(ic:1))
else
if (dialogo.entero1 = Val(ip:1))
Acn( in :1, Val(ic:1))
endif
endif
endif
endif
endif
Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '0' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
if (Val( in :1) = 0)
Sqladd(" AND NrBit = "~dialogo.entero1~" ")
endif
Sqlnew()
if (Val( in :1) > 0)
Sqladd(" Update "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Set Valor = '1' ")
Sqladd(" Where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd(" AND (NrBit = "~Val( in :1)~" ")
if (Val( in :2) > 0)
Sqladd(" OR NrBit = "~Val( in :2)~" ")
endif
Sqladd(" ) ")
Sqlnew()
endif
Sqlexec()
