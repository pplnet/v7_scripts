sql.add(" SELECT T.Especie, T.Especie Moneda, T.Fecha1, T.Vehiculo1,  T.NrTrans, T.Cantidad1 Cantidad, V.Valor1, V.Valor2, ")
sql.add(" E.Codigo, E.Cotiza, T.TipoTr2, T.Cuenta1, T.Cliente1, V.Alias4, T.Cantidad2 TotalIVA, T.NrTrans NrOperacion, T.Book1 Book ")
