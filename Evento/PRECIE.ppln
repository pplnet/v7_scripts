sql.add("Select * FROM ( ")
sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'LIQ' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1 ")
sql.add(" FROM "~Dbo()~".OPERACIONES O ")
sql.add("    INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
sql.add("    INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion ")
sql.add("    INNER JOIN "~Dbo()~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
sql.add("    INNER JOIN "~Dbo()~".CUENTAS C ON M.Cuenta = C.Codigo ")
sql.add("    INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")
sql.add("    INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
sql.add("    INNER JOIN "~Dbo()~".MERCADOS ME ON O.Mercado = ME.Codigo ")
sql.add(" Where O.NrOperacion = M.NrOperacion ")
sql.add(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
sql.add(" AND T.NrTrans = M.NrTrans2 ")
sql.add(" AND M.Especie = O.Especie ")
sql.add(" AND M.NrSaldo = 1 ")
sql.add(" AND C.Codigo  = M.Cuenta ")
sql.add(" AND O.TipoOp = MA.TipoOp ")
sql.add(" AND MA.TipoAsiento = '"~Var('TIPASILT')~"' ")
sql.add(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
sql.add("   AND ((T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(dialogo.fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
sql.add("   AND ((T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(fe:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
sql.add(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO','TIC','TIV'))) ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" UNION ALL ")

sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'REV' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1  ")
sql.add("FROM "~Dbo()~".OPERACIONES O ")
sql.add("      INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
sql.add("      INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
sql.add("      INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add("      INNER JOIN "~Dbo()~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASRETID'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND O.TipoOp IN ('TIPP','TIPA','TICT','TIDE','TIPO','TICO') ")
sql.add(" AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND '"~IdxDate(dialogo.fecha1)~"' >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" UNION ALL ")

Acd(fv:1, dialogo.fecha1)
Act(ta:1, Var('TIPASIRETO'))
sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'OPVIG' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1 ")
sql.add("FROM "~Dbo()~".OPERACIONES O ")
sql.add("      INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON MA.TipoAsiento = '"~Val(ta:1)~"' AND MA.TipoOp = O.TipoOp ")
sql.add("      INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
sql.add("      INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND MA.TipoAsiento = '"~Val(ta:1)~"' ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND O.TipoOp IN ('TIC','TIV') ")
sql.add(" AND O.FechaVto > '"~IdxDate(Val(fv:1))~"' ")
sql.add(" AND O.FechaOp <= '"~IdxDate(Val(fv:1))~"' ")
sql.add(" AND (O.CB4 <> 1 OR O.CB4 is null OR O.CB4 = '' OR O.CB4 = ' ') ")
sql.add(" AND '"~IdxDate(Val(fv:1))~"' >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
sql.add(" AND O.Book1 Not IN ("~pipe2comillas(&bvaluapartida)~") ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" UNION ALL ")
sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'OPVIG' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1 ")
sql.add(" FROM "~Dbo()~".OPERACIONES O ")
sql.add("       INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
sql.add("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON MA.TipoAsiento = '"~Val(ta:1)~"' AND MA.TipoOp = O.TipoOp ")
sql.add("       INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add("       INNER JOIN "~Dbo()~".MOVPENDIENTES M ON O.NrOperacion = M.NrOperacion AND O.Especie = M.Especie ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND M.NrSaldo = 1 ")
sql.add(" AND MA.TipoAsiento = '"~Val(ta:1)~"' ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND O.TipoOp IN ('TIC','TIV') ")
sql.add(" AND O.FechaVto <= '"~IdxDate(Val(fv:1))~"' ")
sql.add(" AND O.FechaOp <= '"~IdxDate(Val(fv:1))~"' ")
sql.add(" AND (O.CB4 <> 1 OR O.CB4 is null OR O.CB4 = '' OR O.CB4 = ' ') ")
sql.add(" AND '"~IdxDate(Val(fv:1))~"' >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
sql.add(" AND O.Book1 Not IN ("~pipe2comillas(&bvaluapartida)~") ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" UNION ALL ")

sql.add(" SELECT Distinct P.Especie Especie, '"~IdxDate(Val(fe:99))~"' FechaOp, '"~IdxDate(Val(fe:99))~"' FechaVto, E.Nombre, E.Cotiza, 'REVPOS' as TipoAsi, '' TipoOp, 'N/A' Tipo, P.Book Book1 ")
sql.add(" FROM "~Dbo()~".POSICIONES P, "~Dbo()~".ESPECIES E ")
sql.add(" where E.Codigo = P.Especie ")
sql.add("    AND E.EsCupon <> 'SI' ")
sql.add("    AND P.Book not IN ("~pipe2comillas(&bvaluapartida)~") ")
sql.add("    AND P.Fecha      <= "~IdxDate2(Val(fe:99))~" ")
sql.add("    AND ((P.Fecha="~IdxDate2(Val(fe:99))~" and (Round(P.CantidadFin,2) <> 0 OR Round(P.CantidadIni,2)<>0 OR Round(P.Cantidad1,2)<>0 OR Round(P.Cantidad2,2)<>0 ))")
sql.add("        OR  (P.Fecha<"~IdxDate2(Val(fe:99))~" and (Round(P.CantidadFin,2) <> 0 ))")
sql.add("        )")
sql.add("    AND P.NrSaldo = "~FStr(Val(sl:2), 0, 0)~" ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("    AND P.Fecha IN (SELECT MAX(Fecha) from "~Dbo()~".POSICIONES ")
sql.add("                   WHERE  Especie  = P.Especie  ")
sql.add("                   AND    Vehiculo = P.Vehiculo ")
sql.add("                   AND    NrSaldo  = P.NrSaldo  ")
sql.add("                   AND    Cliente  = P.Cliente  ")
sql.add("                   AND    Book     = P.Book     ")
sql.add("                   and   IsNull(Unidad,'')       = IsNull(P.Unidad,'') ")
sql.add("                   and   IsNull(Centro,'')       = IsNull(P.Centro,'') ")
sql.add("                   and   IsNull(Sector,'')       = IsNull(P.Sector,'') ")
sql.add("                   and   IsNull(Sucursal,'')     = IsNull(P.Sucursal,'') ")
sql.add("                   and   IsNull(PrecioEj,0)      = IsNull(P.PrecioEj,0) ")
sql.add("                   and   IsNull(FechaEj,0)       = IsNull(P.FechaEj,0) ")
sql.add("                   and   IsNull(CallPut,'')      = IsNull(P.CallPut,'') ")
sql.add("                   and   IsNull(Estrategia,'')   = IsNull(P.Estrategia,'') ")
sql.add("                   and   IsNull(Cartera,'')      = IsNull(P.Cartera,'') ")
sql.add("                   and   IsNull(Trader,'')       = IsNull(P.Trader,'') ")
sql.add("                   and   IsNull(TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
sql.add("                   and   IsNull(Cupon,'')        = IsNull(P.Cupon,'') ")
sql.add("                   and   IsNull(Responsable,'')  = IsNull(P.Responsable,'') ")
sql.add("                   and   IsNull(TipoPosicion,'') = IsNull(P.TipoPosicion,'') ")
sql.add("                   and   IsNull(Producto,'')     = IsNull(P.Producto,'') ")
sql.add("                   and   IsNull(GrupoEspecie,'') = IsNull(P.GrupoEspecie,'') ")
sql.add("                   and   IsNull(CarteraBCRA,'')  = IsNull(P.CarteraBCRA,'') ")
sql.add("                   AND   Fecha     <= "~IdxDate2(Val(fe:99))~") ")
sql.add(" UNION ALL ")

sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'DEV' as TipoAsi, O.TipoOp, 'Hoy' Tipo, O.Book1 ")
sql.add("FROM "~Dbo()~".OPERACIONES O ")
sql.add("      INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
sql.add("      INNER JOIN "~Dbo()~".MOVDEVENGADOS M ON M.NrOperacion = O.NrOperacion ")
sql.add("      INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add("      INNER JOIN "~Dbo()~".CLIENTES C ON C.Codigo = O.Cliente1 ")
sql.add("      INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo  ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASDEV'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND M.NrSaldo = 140 ")
sql.add(" AND O.TipoOp IN ('TIDE','TICT','TICO','TIPO') ")
sql.add(" And M.TipoDevengado = 'TIDEV' ")
sql.add(" AND O.FechaVto >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND '"~IdxDate(dialogo.fecha1)~"' >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND M.Fecha <= '"~IdxDate(&fechadevhoy)~"' ")
sql.add(" UNION ")
sql.add(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'DEV' as TipoAsi, O.TipoOp, 'Ayer' Tipo, O.Book1 ")
sql.add("FROM "~Dbo()~".OPERACIONES O ")
sql.add("      INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
sql.add("      INNER JOIN "~Dbo()~".MOVDEVENGADOS M ON M.NrOperacion = O.NrOperacion ")
sql.add("      INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add("      INNER JOIN "~Dbo()~".CLIENTES C ON C.Codigo = O.Cliente1 ")
sql.add("      INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo  ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASDEV'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND M.NrSaldo = 140 ")
sql.add(" AND O.TipoOp IN ('TIDE','TICT','TICO','TIPO') ")
sql.add(" And M.TipoDevengado = 'TIDEV' ")
sql.add(" AND O.FechaVto >= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND O.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" AND '"~IdxDate(dialogo.fecha1)~"' >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND M.Fecha <= '"~IdxDate(&fechadevayer)~"' ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" UNION ALL ")

sql.add(" SELECT Distinct E.Codigo Especie,O.FechaVto FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'VTO' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1 ")
sql.add(" FROM "~Dbo()~".OPERACIONES O ")
sql.add("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")
sql.add("       INNER JOIN "~Dbo()~".ESPECIES E ON O.Especie = E.Codigo ")
sql.add("       INNER JOIN "~Dbo()~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")
sql.add("       INNER JOIN "~Dbo()~".CLIENTES C ON O.Cliente1 = C.Codigo ")
sql.add(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
sql.add(" AND MA.TipoAsiento IN ("~pipe2comillas(Var('TIPASIVTO'))~") ")
sql.add(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
sql.add(" AND MA.Habilitado = 'SI' ")
sql.add(" AND O.FechaVto >= '"~IdxDate(Val(fe:1))~"' ")
sql.add(" AND ((O.FechaVto >= O.FechaCargaSys AND O.FechaVto = '"~IdxDate(dialogo.fecha1)~"') ")
sql.add("       OR (O.FechaVto < O.FechaCargaSys AND O.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' )) ")
sql.add(" AND O.TipoOp IN ('TIPA','TIPP') ")
sql.add(" AND     E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")

sql.add(" ) a ")
sql.add(" ORDER By Especie,FechaOp,FechaVto,Book1 ")

