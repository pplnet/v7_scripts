sql.add(" WITH")
sql.add(" SaldosRecientes AS ( ")
sql.add("     SELECT ")
sql.add("         S.Especie, ")
sql.add("         S.Cliente, ")
sql.add("         S.Cuenta, ")
sql.add("         S.NrSaldo, ")
sql.add("         ROW_NUMBER() OVER ( ")
sql.add("             PARTITION BY S.Cliente, S.Especie, S.Cupon, ")
sql.add("                          S.EnteCustodia, S.Mercado, S.NrSaldo, S.Cuenta ")
sql.add("             ORDER BY S.Fecha DESC ")
sql.add("         ) AS rn ")
sql.add("     FROM "~Dbo()~".SALDOSDIA S WITH (NOLOCK) ")
sql.add("     WHERE S.EnteCustodia = '"~Var('VEHICULODE')~"' ")
sql.add("       AND S.Saldo <> 0 ")
sql.add("       AND S.Fecha <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("       AND (S.NrSaldo = 101 OR S.NrSaldo > 201) ")
sql.add(" ), ")

sql.add(" PosicionesRecientes AS ( ")
sql.add("   SELECT P.Especie, P.Vehiculo, P.Cliente, P.NrSaldo, P.Book, P.Fecha, P.CantidadFin, ")
sql.add("          ISNULL(NULLIF(P.Cupon, ' '), '') AS Cupon, ")
sql.add("          ISNULL(NULLIF(P.Sector, ' '), '') AS Sector, ")
sql.add("          ISNULL(NULLIF(P.Estrategia, ' '), '') AS Estrategia, ")
sql.add("          ISNULL(NULLIF(P.TipoPosicion, ' '), '') AS TipoPosicion, ")
sql.add("          ISNULL(NULLIF(P.CallPut, ' '), '') AS CallPut, ")
sql.add("          ISNULL(NULLIF(P.FechaEj, ' '), '') AS FechaEj, ")
sql.add("          ISNULL(NULLIF(P.PrecioEj, ' '), '') AS PrecioEj, ")
sql.add("          ROW_NUMBER() OVER (PARTITION BY P.Especie, P.Vehiculo, P.Cliente, P.NrSaldo, P.Book, ")
sql.add("                                          ISNULL(NULLIF(P.Cupon, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.Sector, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.Estrategia, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.TipoPosicion, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.CallPut, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.FechaEj, ' '), ''), ")
sql.add("                                          ISNULL(NULLIF(P.PrecioEj, ' '), '') ")
sql.add("                             ORDER BY P.Fecha DESC) AS rn ")
sql.add("   FROM "~Dbo()~".POSICIONES P ")
sql.add("   WHERE P.Cliente = P.Vehiculo ")
sql.add("     AND P.Fecha <= "~IdxDate2(dialogo.fecha1)~" ")
sql.add("     AND P.NrSaldo IN (121, 171, 191) ")
sql.add(" ) ")

sql.add(" SELECT SR.Especie, E.Nombre ")
sql.add(" FROM SaldosRecientes SR ")
sql.add("     INNER JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ")
sql.add("         ON C.Codigo = SR.Cliente ")
sql.add("     INNER JOIN "~Dbo()~".ESPECIES E WITH (NOLOCK) ")
sql.add("         ON E.Codigo = SR.Especie ")
sql.add("     INNER JOIN "~Dbo()~".CUENTAS CU WITH (NOLOCK) ")
sql.add("         ON CU.Codigo = SR.Cuenta ")
sql.add("     INNER JOIN "~Dbo()~".ESTADOSCUSTODIA EC WITH (NOLOCK) ")
sql.add("         ON EC.NrSaldo = CASE ")
sql.add("                             WHEN SR.NrSaldo > 201 THEN SR.NrSaldo - 100 ")
sql.add("                             WHEN SR.NrSaldo = 101 THEN SR.NrSaldo ")
sql.add("                         END ")
sql.add(" WHERE SR.rn = 1 ")
sql.add("   AND E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" GROUP BY SR.Especie, E.Nombre ")

sql.add("UNION ")

sql.add(" SELECT DISTINCT PR.Especie, E.Nombre")
sql.add(" FROM PosicionesRecientes PR ")
sql.add(" INNER JOIN "~Dbo()~".ESPECIES E ON PR.Especie = E.Codigo ")
sql.add(" WHERE PR.rn = 1 ")
sql.add("   AND PR.CantidadFin <> 0 ")
sql.add("   AND E.Jerarquia LIKE '"~Trim(Val(z:8))~"%' ")
sql.add("   AND E.Fecha > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" ORDER BY 1 ")


Acn(z:5, 0)
recorrer sql
