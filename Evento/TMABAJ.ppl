SQL.ADD("SELECT O.NrORDEN ")
SQL.ADD("  FROM "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" WHERE  O.NrORDEN = OB.NrOperacion ")
SQL.ADD("   AND OB.NrBit in(101,102,103,104 ")
SQL.ADD("   AND OB.Valor='1'   ")
SQL.ADD("       AND O.FechaLimite <="~idxdate2(Dialogo.Fecha1))
SQL.ADD("       AND  O.TipoOrden = 'TMANIF' ")
SQL.ADD("AND  O.NrOperacion2 is NULL ")
SQL.ADD("ORDER BY O.NrOrden ")

Recorrer SQL

  Message('Pasando Manifestacion a Terminal '~FBN('NrOrden'))
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
  SQL.ADD(" SET Valor = 0 ")
  SQL.ADD(" Where  valor=1 and NrOperacion= '"~FBN['NrOrden']~"' ")
  SQL.NEW   

  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
  SQL.ADD(" SET Valor = 1 ")
  SQL.ADD(" Where  NrBit=170 and NrOperacion= '"~FBN['NrOrden']~"' ")
  SQL.NEW   
  SQL.EXEC
   
