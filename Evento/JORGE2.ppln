Sqladd("Select Especie, NrOperacion, Cantidad, Precio1 from "~Dbo()~".OPERACIONES where TipoOp='FCS' ")

recorrer sql
Act(a:fac, Fbn()['Especie'])
Act(b:fac, Fbn()['NrOperacion'])
Acn(c:fac, Fbn()['Cantidad'])
Acn(d:fac, Fbn()['Precio1'])
proximo

crearlistbox;'Arial,8,B'
'Especie';a:1..a:fac;NO;;;40;string;;
'NrOperacion';b:1..b:fac;NO;;;50;string;;
'Cantidad';c:1..c:fac;NO;;;50;numero;'###########.##';
'Precio';d:1..d:fac;NO;;;50;numero;'###########.########';
finlistbox

