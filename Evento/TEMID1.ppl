**-- VIMD: Minuta Diaria de Cuenta Corriente Vinculadas
*HojaVisible(SI)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;HABILES(FSYS-1,1,'ARG',SI)
  Vehiculo1  : 'Vehiculo1'    ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo es Invalido';NO;
  Cliente1   : 'Cliente1'     ;;;;;;NOVACIO(Dialogo.Cliente1);'El Vehiculo es Invalido';NO;;;;
  Especie1   : 'Moneda'       ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;
  Precio1    : 'Tasa'         ;;;;NO;;Dialogo.Precio1<>0;'Debe Existir la Tasa para esta Seleccion';NO;;SQL("SELECT Tasa from "~DBO~".TASASTERCEROS where Vehiculo='"~Dialogo.Vehiculo1~"' and Cliente='"~Dialogo.Cliente1~"' and Especie ='"~Dialogo.Especie1~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")
FinDialogo

if not Ok
  Cancelar
endif

* Divisor del par de Vehiculos
SQL.ADD("SELECT Divisor from "~DBO~".IMPTERCEROS where Vehiculo='"~Dialogo.Vehiculo1~"' and Cliente='"~Dialogo.Cliente1~"' ")

ACN(Z11,0)

Recorrer SQL
  ACN(Z11,IIF(EqStr('360',FBN['Divisor']),360,365))
Proximo

IF VAL(Z11)=0
   Cancelar('Falta Ingresar los Impuestos para el Par de Vehiculos '~Dialogo.Vehiculo1~'/'~Dialogo.Cliente1)
ENDIF

ACT(AV1,Dialogo.Vehiculo1)
ACT(AV2,Dialogo.Cliente1)
ACT(AE1,Dialogo.Especie1)
ACD(AF1,Dialogo.Fecha1)

* Verifico que todas las operaciones esten en BackOffice O Terminal
(."VERIINSTER".)
 
* Recupero el Saldo para el Par de Vehiculos => Deja el resultado en Z1 
(."SALDIATER".)

IF VAL(Z1)<>0 
   Message('Obteniendo los Nros. de Operaciones a Generar .... ')          
 
   *-- Z3 Nro. Minuta Diaria z4: Fecha de Vto. z5: Plazo en Dias Corridos
   *-- z6: Interes  Z7: MB3 Z8: Nro. Operacion Referencia Z9: MB3 de la Vinculada

   *-- Z7: MB3
   ACT(Z7,IIF(VAL(Z1)>0,'1','0') )
   ACT(Z9,IIF(VAL(Z1)>0,'0','1') )

   IF VAL(Z1)<0
      ACN(Z1,-VAL(Z1))
   ELSE
      ACT(AV1,Dialogo.Cliente1)
      ACT(AV2,Dialogo.Vehiculo1)
   ENDIF

   ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1)))

   ACD(Z4,HABILES(Dialogo.Fecha1,1,'ARG',SI))
   ACN(Z5,VAL(Z4)-Dialogo.Fecha1)

   ACN(Z6,Dialogo.Precio1*VAL(Z1)*VAL(z5)/(100*VAL(Z11)) )

   * Obtengo el Nro de Caso para la Minuta Vinculada AB6: Caso
   (."CASOVINCU".)    

   Message('Calculando los Impuestos para Operacion Directa ')

   ACT(AV1,Dialogo.Vehiculo1)
   ACT(AV2,Dialogo.Cliente1)

   * Determina los Impuestos de Vinculadas
   * Y5 : Imp.Ret.IVA  Y6 : Alicuota de IVA  Y12: Alicuota Percepcion  Y13: Importe  de Percepcion
   * Y16: IvaNeto  Y17: MontoCapitalizable Y19:TTN
   * I1: Tasa Impuesto Extr I2: Importe de Impuesto Ext
   * W1: Tasa WH  W2: Importe de WH Directa  

   (."IMPVINTER".)

   Message('Generando Minuta de Diaria .... ')          
   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, NrOperacion,FechaOp,Vehiculo1,Cliente1,Especie, ")
   SQL.ADD(" MB3,Cantidad,TotalIntereses,Plazo,")
   SQL.ADD(" FechaVto,Precio1,RB8,")
   SQL.ADD(" FechaCarga,UsrInput,Operador,Precio4,Precio2,TotalAux1,")
   SQL.ADD(" RB6,TasaPrecan,RB3 ) ") 
   SQL.ADD("Values")
   SQL.ADD("('TEMIND','"~Val(z3)~"','"~IdxDate(Dialogo.Fecha1)~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Cliente1~"','"~Dialogo.Especie1~"',")
   SQL.ADD(" '"~Val(z7)~"', "~Fstr(VAL(Z1),0,2)~","~Fstr(VAL(Z6),10,5)~","~Fstr(VAL(Z5),0,0)~",")
   SQL.ADD(" '"~IdxDate(VAL(Z4))~"',"~Fstr(Dialogo.Precio1,0,5)~",'"~IIF(VAL(Z11)=360,"0","1")~"',")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"','"~USUARIOACTIVO~"','"~USUARIOACTIVO~"',"~Fstr(VAL(Y19),0,5)~","~Fstr(VAL(Y15),0,5)~","~Fstr(VAL(W1),0,5)~", ")
   SQL.ADD(" '"~Fstr(Val(AB6),0,0)~"', "~Fstr(Val(I1),0,2)~",'1' ) ")
   SQL.NEW 
   SQL.EXEC

   *** Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(Val(z3),SI)
   SQL.EXEC

   * Insert de Instancias: Recibe z3: Nro.Op.
   (."ALTAINSSU".)

ELSE
   * No se generaron intereses
   Message('El par '~Dialogo.Vehiculo1~' - '~Dialogo.Cliente1~' no posee saldos para esta fecha y moneda ...')
ENDIF