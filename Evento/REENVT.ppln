Sqladd("SELECT V.*, C.RazonSocial ")
Sqladd("  FROM "~Dbo()~".VOUCONSOLIDADOS V, "~Dbo()~".CLIENTES C ")
Sqladd(" WHERE V.Fecha="~IdxDate2(dialogo.fecha1))
Sqladd("   AND V.Estado='NOK' ")
Sqladd("   AND V.Cliente=C.Codigo ")
Sqladd(" ORDER BY V.Id ")
Watch(Sqlbatch())

recorrer sql

Scn(z:1, 1)
Acn(x:fac, 1)

Act(a:fac, Fbn()['Id'])
