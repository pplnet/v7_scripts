MostrarCuadroDeMensajes()
creardialogo
fecha1: 'Desde';;;;;;dialogo.fecha1 < dialogo.fecha2;'La Fecha Desde debe ser menor a la Fecha Hasta';NO;FSys()
fecha2: 'Hasta';;;;;;dialogo.fecha2 <= FSys();'La Fecha Hasta debe ser menor a la Fecha del Sistema';NO;FSys()
findialogo

if (not ok)
Cancelar()
endif

recorrer&k dialogo.fecha1, dialogo.fecha2
if (EsHabil(&k, 'ARG'))
Message('Procesando el '~Fecha(&k))
Ejecutarevento('APERTU', 'fecha1', &k, 'radio1', 1)
Ejecutarevento('CIERRE', 'fecha1', &k, 'check1', 1)
endif
proximo
