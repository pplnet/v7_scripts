CrearDialogo
   Especie1    :'Especie'        ;;;;;;NoVacio(Dialogo.Especie1) y EsTerminal(Dialogo.Especie1,ESPECIE) y [DesciendeDeEspecie(Dialogo.Especie1,'TITULO') o DesciendeDeEspecie(Dialogo.Especie1,'FONDOS')];'Debe Ingresar una Especie Valida';NO;
   Cantidad1   :'Capital'
   Fecha1      :'Fecha Op.'
   Plazo1      :'Plazo'
   Vehiculo1   :'Veh Tomador'
   Vehiculo2   :'Veh Colocador'
   Book1       :'Book'
   Precio2     :'Tasa Interes'
FinDialogo

If not Ok
 Cancelar
EndIf


ACN(A:1,BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1))
ACT(A:2,GetNumerador(Val(A:1)))

**ContraEspecie
ACT(A:13,CotizaEn(Dialogo.Especie1))

**Precio1
ACN(A:3,CotizacionC(Dialogo.Especie1,'CON',,,Dialogo.Fecha1,1,SI,Val(A:13)))

**PrecioMer
ACN(A:4,Dialogo.Cantidad1*CotizacionC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))

**TotalBrutoCli1
ACN(A:5,Dialogo.Cantidad1*Val(A:3))

**Cuenta1
ACT(A:6,CuentaCliente(Dialogo.Vehiculo1,Dialogo.Especie1,Dialogo.Vehiculo2,,'SEPVMV','HAB'))

**Cuenta2
ACT(A:7,CuentaCliente(Dialogo.Vehiculo2,Val(A:13),Dialogo.Vehiculo2,,'SEPVMV','HAB'))

**Sector2
ACT(A:8,BuscarCampo('USUARIOS','Perfiles','Codigo',USUARIOACTIVO))

**Numerador
ACN(NU:1, BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1))

IF Not Incluido(Dialogo.Vehiculo1,Var('VEHIEXTRAN'))
   ACN(A:14,Var('TASAIVA'))
Else
   ACN(A:14,0)
EndIf

**FechaVto
ACD(A:15,Dialogo.Fecha1+Dialogo.Plazo1)

If Not EsHabil(Val(A:15),'ARG')
   ACD(A:15,Habiles(Val(A:15), 1, 'ARG', SI))
EndIf


SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
SQL.ADD(" (Especie, TipoOp, NrOperacion, Cantidad, Precio1, ")
SQL.ADD(" PrecioEj, PrecioMer, Cliente1, Operador, ContraEspecie, ")
SQL.ADD(" FechaOp, FechaVto, Plazo, TotalBrutoCli1, TotalNetoCli1, ")
SQL.ADD(" RB3, MB1, MB3, MB4, UsrInput, ")
SQL.ADD(" FechaCarga, Numerador, Impresa, FechaCargaSys, Cuotas1, ")
SQL.ADD(" Cuotas2, TablaFeriados1, FechaOp2, PlazoGracia, RB6, ")
SQL.ADD(" RB7, RB8, RB9, RB10, CB10, Vehiculo1, ")
SQL.ADD(" Vehiculo2, TipoTasa, Cuenta1, Cuenta2, ImpGastos2, ")
SQL.ADD(" PrecioRef, Sector2, Cuenta4, Cuenta5, CantidadOri, ")
SQL.ADD(" ResultadoIndice, Book1, Book2, CB1, CB3, ")
SQL.ADD(" NrOperacion4, Fecha1, CB13, CB15, CB2) ")
SQL.ADD(" Values")
SQL.ADD(" ('"~Dialogo.Especie1~"', 'SEPVMV', '"~Val(A:2)~"', "~Fstr(Dialogo.Cantidad1, 0, 2)~", "~Fstr(Val(A:3), 0, 8)~", ")
SQL.ADD(" "~Fstr(Dialogo.Cantidad1, 0, 2)~", "~Fstr(Val(A:4), 0, 8)~", '"~Dialogo.Vehiculo2~"', '"~UsuarioActivo~"', '"~Val(A:13)~"', ")
SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Val(A:15))~"', '"~Dialogo.Plazo1~"', "~Fstr(Val(A:5), 0, 2)~", '"~Dialogo.Cantidad1~"', ")
SQL.ADD(" '1', '0', '0', '1', '"~UsuarioActivo~"', ")
SQL.ADD(" "~SQLAhora~", '"~Fstr(Val(NU:1), 0, 0)~"', '0', '"~IdxDate(FSys)~"', '1', ")
SQL.ADD(" '1', 'ARG', '"~IdxDate(Dialogo.Fecha1)~"', '1', '0', ")
SQL.ADD(" '-1', '1', '1', '1', '0', '"~Dialogo.Vehiculo1~"', ")
SQL.ADD(" '"~Dialogo.Vehiculo2~"', 'FIJA', '"~Val(A:6)~"', '"~Val(A:7)~"', "~Fstr(Val(A:14), 0, 6)~", ")
SQL.ADD(" '"~Var('TASADEFA')~"', '"~Val(A:8)~"', '"~Val(A:6)~"', '"~Val(A:7)~"', '"~Dialogo.Cantidad1~"', ")
SQL.ADD(" '"~Dialogo.Cantidad1~"', '"~Dialogo.Book1~"', '"~Dialogo.Book1~"', '0', '0', ")
SQL.ADD(" '', NULL, '0', NULL, '1') ")
SQL.NEW
SQL.EXEC


**Cantidad3 y Total3
ACN(A:9,Val(A:5)*(Dialogo.Precio2/100)*(Dialogo.Plazo1/365))

**Total1 y Total2
ACN(A:10,Val(A:5)+Val(A:9))

**Total4
ACN(A:11,Val(A:9)*(Var('TASAIVA')/100))

**PrecioRef1
ACN(A:12,Val(A:9)*(Var('DEFAINT')/100))


SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
SQL.ADD(" (NrOperacion, NrCuota, Check9, Check10, Fecha1, ")
SQL.ADD(" Fecha2, Fecha3, Fecha4, Plazo1, Cantidad1, ")
SQL.ADD(" Cantidad2, Cantidad3, Cantidad4, Precio2, Precio3, ")
SQL.ADD(" Precio4, Total1, Total2, Total3, Total4,  ")
SQL.ADD(" Total5, Total7, Total8, Tasa1, Tasa2, ")
SQL.ADD(" PrecioRef1, Cantidad5, Cantidad6, Precio5, Precio6, ")
SQL.ADD(" Precio7, Precio8, Total9, Cotizacion1, Cotizacion2, ")
SQL.ADD(" Cantidad7, Cantidad8, Coeficiente, Cantidad1Ori, Cantidad2Ori, ")
SQL.ADD(" Cantidad3Ori, ResultadoIndice, Cantidad12) ")
SQL.ADD(" Values")
SQL.ADD(" ('"~Val(A:2)~"', '1', '0', '0', '"~IdxDate(Dialogo.Fecha1)~"', ")
SQL.ADD(" '"~IdxDate(Val(A:15))~"', '"~IdxDate(Val(A:15))~"', '"~IdxDate(Val(A:15))~"', '"~Dialogo.Plazo1~"', "~Fstr(Dialogo.Cantidad1, 0, 2)~", ")
SQL.ADD(" "~Fstr(Dialogo.Cantidad1, 0, 8)~", "~Fstr(Val(A:9), 0, 2)~", '0', "~Fstr(Dialogo.Precio2, 0, 6)~", '0', ")
SQL.ADD(" '0', "~Fstr(Val(A:10), 0, 2)~", "~Fstr(Val(A:10), 0, 2)~", "~Fstr(Val(A:9), 0, 2)~", "~Fstr(Val(A:11), 0, 2)~", ")
SQL.ADD(" '0', "~Fstr(Val(A:5), 0, 2)~", "~Fstr(Val(A:5), 0, 2)~", 100, '0', ")
SQL.ADD(" "~Fstr(Val(A:12), 0, 2)~", '0', '0', "~Fstr(Val(A:9), 0, 6)~", "~Fstr(Val(A:11), 0, 6)~", ")
SQL.ADD(" '0', "~Fstr(Val(A:3), 0, 8)~", '0', '-1', '2', ")
SQL.ADD(" '0', '0', '1', "~Fstr(Dialogo.Cantidad1, 0, 2)~", "~Fstr(Dialogo.Cantidad1, 0, 2)~", ")
SQL.ADD(" '0', '0', "~Fstr(Dialogo.Cantidad1, 0, 2)~" ) ")
SQL.NEW
SQL.EXEC

SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD(" (NrOperacion,NrBit,Valor) ")
SQL.ADD("  SELECT '"~Val(A:2)~"' As NrOperacion,NrBit,Valor ")
SQL.ADD("    FROM "~DBO~".OPERACIONESBITS ")
SQL.ADD("   WHERE NrOperacion=(Select TOP 1 NrOperacion From "~DBO~".OPERACIONES Where TipoOp='SEPVMV') ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '0' ")
SQL.ADD(" Where NrOperacion = '"~Val(A:2)~"' ")
SQL.ADD(" and Valor         =  '1'  ") 
SQL.NEW

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '1' ")
SQL.ADD(" Where NrOperacion = '"~Val(A:2)~"' ")
SQL.ADD(" and NrBit         =  '1'  ") 
SQL.NEW
SQL.EXEC

*** Actualiza movimientos, limites, posiciones y Devengados
SQL.ActualizarMovimientos3(Val(A:2),SI,SI,NO,SI,SI)
SQL.EXEC

*- Calculo de TTN Op.Vinculada
EjecutarEvento('TTNOP',NrOperacion1=Val(A:2),Entero1=0,NrOperacion2='',Lista1='')


EjecutarEvento('INSEVI',NrOperacion1=Val(A:2),TipoOp1='SEPVMV',String=" MB3='1' ",Vehiculo1=Dialogo.Vehiculo2,Vehiculo2=Dialogo.Vehiculo1,String1='')


