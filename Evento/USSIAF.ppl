HojaVisible(SI)
acn(ze1, Num(Copy(Fstr(Anio(Fsys), 4, 0), 3, 2)) )
acn(ze2,Num(Pad0(Fstr(DifDias(Fsys, Fecha('01/01/'~Fstr(Anio(Fsys), 4, 0)), 'ARG', NO)+1, 0, 0), 3)))

CrearDialogo
  Fecha1       : 'F.Acceso'    ;1;1;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha ';NO;Fsys
  String1      : 'Usuario'     ;1;2;;;;;;;;;;;;;;;;; 
  String3      : 'Path Txt'    ;2;1;;NO;;;;;Var('DIRUSSIAF');;;;;;;;;;;;;;;;;  
  String2      : 'Nombre'      ; ; ;;NO;;;;;'CASSIAF_'~Pad0(Fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(Fstr(Mes(Dialogo.Fecha1),0,0),2)~Pad0(Copy(Fstr(Anio(Dialogo.Fecha1),0,0),3,2),2)~'.TXT'
  Radio1       : 'Sist.Oper.|W98|NT'     ;;;;;;;;;1;
  Radio2       : 'Salida|Inf+TXT|TXT|Informe|'     ;;;;NO;NO;;;;0
FinDialogo

If Not Ok
   Cancelar
Endif

*- no2: Nombre del directorio
ACT(no2,Var('DIRUSSIAF'))

*- no1: Nombre del Txt
ACT(no1,'CASSIAF_'~Pad0(Fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(Fstr(Mes(Dialogo.Fecha1),0,0),2)~Pad0(Copy(Fstr(Anio(Dialogo.Fecha1),0,0),3,2),2)~'.TXT')

MostrarCuadroDeMensajes

IF Not ExisteDirectorio(val(no2))
   Cancelar('Debe crear el directorio '~val(no2))
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(a:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC,   'Usuarios que Acceden a SIAF al '~Dialogo.Fecha1)
ACT(a:FAC+1, 'Genera '~IIF(Dialogo.Radio2=0,'Informe y TXT',IIF(Dialogo.Radio2=1,'TXT','Informe')))
ACT(a:FAC+2, IIF(Dialogo.Radio2<2,'Archivo :'~val(no2)~val(no1)))
If NoVacio(Dialogo.String1)
   ACT(a:FAC+3, 'Codigo: '~Dialogo.String1)
Else 
   ACT(a:FAC+3, 'Todos los usuario ')
EndIf
SetFont(a:FAC..a:FAC+2,3)

SetFilaActual(FAC+1)
ACN(w1,FAC)

SetFilaActual(FAC+3)

ACT(Z1,'')

ACT(a:FAC,'UserId')
ACT(b:FAC,'Nombre')
ACT(c:FAC,'Perfil')
ACT(d:FAC,'Last Login')

SetFont(a:FAC..d:FAC,2)
AgregarMarco(a:FAC..d:FAC,2,0,Exe('COLOR'))


IF Dialogo.Radio2<2 y ExisteArchivo(val(no2)~val(no1)) 
   IF Dialogo.Radio1 = 0
      WinExec('COMMAND.COM /C DEL '~val(no2)~val(no1), 0)
   ELSE
      WinExec('CMD.EXE /C DEL '~val(no2)~val(no1), 0)
   ENDIF

   ***---A veces ejecuta lo que sigue y el S.O. todavia no borro el archivo
   Esperar(3)
EndIf

IF Dialogo.Radio2<=1 
   ACT(aa1, val(no2)~val(no1))

   Message('Creando Archivo '~val(no1))

   AbrirASCII(val(aa1),0)
EndIf



*- Usuario donde el status sea normal
SQL.ADD("Select * From "~DBO~".USUARIOS WHERE Status=0 ")
If NoVacio(Dialogo.String1)
   SQL.ADD("and Codigo='"~Trim(Dialogo.String1)~"' ")
EndIF
SQL.ADD("order by Codigo")

Recorrer SQL

  ACT(a:fac, FBN['Codigo'])
  ACT(b:fac, FBN['Nombre'])
  ACT(c:fac, FBN['Perfil'])
  ACD(d:fac, FBN['FAcceso'])
  SetFont(a:fac..d:FAC, 1)

  IF Dialogo.Radio2<=1 
     ACT(aa:1,Pad(val(a:fac),10)~';' )
     ACT(aa:1,val(aa:1)~Pad(val(c:fac),10)~';' )
     ACT(aa:1,val(aa:1)~Pad0(Fstr(Dia(val(d:fac)),0,0),2)~'/'~Pad0(Fstr(Mes(val(d:fac)),0,0),2)~'/'~Copy(Fstr(Anio(val(d:fac)),4,0),3,2)  )
     EscribirASCII(val(aa:1))
  EndIf
Proximo

ACO(1,10)
ACO(2,15)
ACO(3,10)
ACO(4,10)

CerrarASCII


If Dialogo.Radio2=1
   HojaVisible(NO)
EndIF

If Dialogo.Radio1=0 o Dialogo.Radio1=1
   MessageBox('Se Genero el Archivo '~val(no2)~val(no1))
EndIF

LimitesVision(d:fac)

