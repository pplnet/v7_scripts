creardialogo
especie1:'Especie';1;1;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'TITULO') y not DesciendeDeEspecie(dialogo.especie1, 'CUPON');'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' "
check1:'Procesa';5;1;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Act(x:1, dialogo.especie1)
Acn(y:1, dialogo.check1)


Act(a:1, 'Especie')
Act(a:3, 'Base')
Act(a:9, 'Mon.Emision')
Act(a:10, 'DevengaTasa')
Act(a:13, 'Fecha Base')
Act(d:1, 'Error')

Act(f:1, 'NrCupon')
Act(g:1, 'NrCupon')
Act(h:1, 'Fecha')
Act(i:1, 'Fecha Ant')
Act(j:1, 'Plazo')
Act(k:1, 'Base')
Act(l:1, 'Indice')
Act(m:1, 'TNA')
Act(n:1, '% Renta base')
Act(o:1, '% Renta Cal')

SetFont(a:1..o:13, 2)

Sqladd("SELECT * FROM "~Dbo()~".ESPECIES WHERE Codigo = '"~dialogo.especie1~"'")
recorrer sql
Act(b:1, Fbn('Codigo'))
Act(b:3, Fbn('DiasAnio'))
Act(b:9, Fbn('MonedaEmision'))
Act(b:10, Fbn('DevengaTasa'))
proximo
if (Eqstr(Val(b:10), 'COR'))
Act(b:13, 'F.Corte')
else
if (Eqstr(Val(b:10), 'PAG'))
Act(b:13, 'F.Pago')
else
Act(b:13, 'F.Pago Orig')
endif
endif

SetFilaActual(1)
Sqladd("SELECT * FROM "~Dbo()~".AGENDACUPONES WHERE Especie = '"~dialogo.especie1~"' order by Convert(Float,NrCupon)")
recorrer sql
Act(f:fac, Fbn('NrCupon'))
Acn(g:fac, Num(Fbn('NrCupon')))

if (Eqstr(Val(b:10), 'COR'))
Acd(h:fac, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac), 0, 0)~"' "))
else
if (Eqstr(Val(b:10), 'PAG'))
Acd(h:fac, Query(" Select FechaPago From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac), 0, 0)~"' "))
else
Acd(h:fac, Query(" Select FechaPagoOriginal From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac), 0, 0)~"' "))
endif
endif
if (Val(g:fac) = 1)
Acd(i:fac, BuscarCampo('ESPECIES', 'FEmision', 'Codigo', dialogo.especie1))
else
if (Eqstr(Val(b:10), 'COR'))
Acd(i:fac, Query(" Select FechaCorte From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac) - 1, 0, 0)~"' "))
else
if (Eqstr(Val(b:10), 'PAG'))
Acd(i:fac, Query(" Select FechaPago From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac) - 1, 0, 0)~"' "))
else
Acd(i:fac, Query(" Select FechaPagoOriginal From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(g:fac) - 1, 0, 0)~"' "))
endif
endif
endif
Acn(j:fac, Val(h:fac) - Val(i:fac))
if (Eqstr(Val(b:3), 'REA'))
Acn(k:fac, DiasA(2, Val(h:fac)))
else
if (Eqstr(Val(b:3), '360'))
Acn(k:fac, 360)
else
Acn(k:fac, 365)
endif
endif
Acn(l:fac, Val(j:fac) / (Val(k:fac)))
Acn(m:fac, Fbn('TNA'))
Acn(n:fac, Fbn('PorRenta'))
Acn(o:fac, Val(m:fac) * Val(l:fac))

if (dialogo.check1 = 1)
Sqladd("UPDATE "~Dbo()~".AGENDACUPONES ")
Sqladd("   Set PorRenta = "~FStr(Val(o:fac), 1, 9)~" ")
Sqladd(" WHERE Especie = '"~dialogo.especie1~"' ")
Sqladd("  AND NrCupon = '"~FStr(Val(g:fac), 1, 0)~"' ")
Sqlnew()
Sqlexec()
endif
proximo

if (Fac() > 1)
FormatoCeldas(g:2..g:fac, Exe('F0'))
FormatoCeldas(j:2..j:fac, Exe('F0'))
FormatoCeldas(l:2..l:fac, Exe('F8'))
FormatoCeldas(n:2..o:fac, Exe('F8'))
endif

