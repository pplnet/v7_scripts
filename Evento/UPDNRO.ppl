HOJAVISIBLE(SI)

CrearDialogo
   Radio1   : 'Tipo|Op.|Duplicados|Todos' 
FinDialogo

If Not OK
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Fecha(FSys))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Listado de Operaciones Corregidas")
SetFont(a:fac..a:fac,2)
SetFilaActual(FAC+2)

ACT(a:FAC, 'Tipo Op.')
ACT(b:FAC, 'Número')
ACT(c:FAC, 'F.Operacion')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Correccion')
ACT(f:FAC, 'Liq.Manual')

AgregarMarco(a:FAC..f:FAC,2,0,Exe('COLOR'))
SetFont(a:fac..f:fac,2)

If Dialogo.Radio1<>1
* Recupero los Tipos de Operaciones Modificadas
SQL.ADD("Select * FROM "~DBO~".OPERACIONES O ")
SQL.ADD("Where TipoOp IN ")
SQL.ADD(" ('DPOA','MMFCMV','MMFIMV','MMFRN','MMON','MMONM','MMPCCM','MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSC','MMSCMV','MMSIMV','DTK','DTKVI')  ")
SQL.ADD("Order By O.TipoOp,O.Vehiculo1,O.NrOperacion ")

ACN(z1,0)

Recorrer SQL    

     IF Val(z1)=0
        ACT(a:fac,' Correcion de OPERACIONES MODIFICADAS ....')
        IFA
     EndIf

     ACN(z1,1)

     ACT(a:FAC, FBN['TipoOp'])
     ACT(b:FAC, FBN['NrOperacion'])
     ACLO(b:FAC, fbn('NrOperacion'))
     ACD(c:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',FBN['NrOperacion']))
     ACT(d:FAC, fbn('Vehiculo1'))
     ACT(e:FAC, 'Mov.Duplicado')         
     if Not Incluido(FBN['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
        ACT(f:FAC, 'Automatica')        
        SetFont(a:fac..f:fac,1)
     Else 
        acn(aa1,0)

        * Recupero los Nros. de Vouchers de Transacciones2
        ACN(aa1,SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~FBN['NrOperacion']~"' "))

        if Val(aa1)>0
           EjecutarEvento('ELILIQ',NrOperacion1=FBN['NrOperacion'])
           ACT(f:FAC, 'Manual')          
        Else 
           ACT(f:FAC, 'Manual. No posee Vouchers')          
        endif

        SetFont(a:fac..f:fac,2)
     endif
     * Se ejecuta el actualizar Movimiento
     EjecutarEvento('ACTMOV',Vehiculo1=FBN['Vehiculo1'],Fecha1=Fsys,Fecha2=Fsys,NrOperacion1=FBN['NrOperacion'],TipoOp1=fbn['TipoOp'],Radio1=-1)
Proximo
EndIf

If Dialogo.Radio1<>0
* Recupero las Operaciones con Mov. Duplicados para Actualizar los Movimientos
SQL.ADD("Select O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov,COUNT(*) FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("Where M.NrOperacion=O.NrOperacion ")
SQL.ADD("Group By O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov Having COUNT(*)>1")
SQL.ADD("Order By O.Vehiculo1,O.TipoOp,O.NrOperacion ")

ACN(z1,0)

Recorrer SQL    

     IF Val(z1)=0
        ifa
        ACT(a:fac,' Correcion de MOV.EJECUTADOS Duplicados ....')
        SetFont(a:fac..f:fac,1)
        IFA
     EndIf

     * Corte de Control por Operacion     
     IF Not EqStr(VAL(ab1),FBN['NrOperacion'])
        ACT(a:FAC, FBN['TipoOp'])
        ACT(b:FAC, FBN['NrOperacion'])
        ACLO(b:FAC, fbn('NrOperacion'))
        ACD(c:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',FBN['NrOperacion']))
        ACT(d:FAC, fbn('Vehiculo1'))
        ACT(e:FAC, 'Mov.Duplicado')         

        if Not Incluido(FBN['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
           ACT(f:FAC, 'Automatica')        
           SetFont(a:fac..f:fac,1)
        Else 
           acn(aa1,0)

           * Recupero los Nros. de Vouchers de Transacciones2
           ACN(aa1,SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~FBN['NrOperacion']~"' "))
   
           if Val(aa1)>0
              * Desliquido la Operacion
              EjecutarEvento('ELILIQ',NrOperacion1=FBN['NrOperacion'])
              ACT(f:FAC, 'Manual')          
           Else 
              ACT(f:FAC, 'Manual. No posee Vouchers')          
           Endif
           SetFont(a:fac..f:fac,2)
        EndIf

        *-- Se ejecuta el actualizar Movimiento
        EjecutarEvento('ACTMOV',Vehiculo1=FBN['Vehiculo1'],Fecha1=Fsys,Fecha2=Fsys,NrOperacion1=FBN['NrOperacion'],TipoOp1=fbn['TipoOp'],Radio1=-1)
  
        act(ab1,FBN['NrOperacion'])
     Else
        dfa
     EndIf

     ACN(z1,1)
Proximo

* Recupero las Operaciones con Mov. Duplicados para Actualizar los Movimientos
SQL.ADD("Select O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov,COUNT(*) FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD("Where M.NrOperacion=O.NrOperacion ")
SQL.ADD("Group By O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov Having COUNT(*)>1")
SQL.ADD("Order By O.Vehiculo1,O.TipoOp,O.NrOperacion ")

ACN(z1,0)

Recorrer SQL    

     IF Val(z1)=0
        ifa
        ACT(a:fac,' Correcion de MOV.PENDIENTES Duplicados ....')
        SetFont(a:fac..f:fac,1)
        IFA
     EndIf

     * Corte de Control por Operacion     
     IF Not EqStr(VAL(ab1),FBN['NrOperacion'])
        ACT(a:FAC, FBN['TipoOp'])
        ACT(b:FAC, FBN['NrOperacion'])
        ACLO(b:FAC, fbn('NrOperacion'))
        ACD(c:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',FBN['NrOperacion']))
        ACT(d:FAC, fbn('Vehiculo1'))
        ACT(e:FAC, 'Mov.Duplicado')         

        if Not Incluido(FBN['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
           ACT(f:FAC, 'Automatica')        
           SetFont(a:fac..f:fac,1)
        Else 
           acn(aa1,0)

           * Recupero los Nros. de Vouchers de Transacciones2
           ACN(aa1,SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~FBN['NrOperacion']~"' "))
   
           if Val(aa1)>0
              * Desliquido la Operacion
              EjecutarEvento('ELILIQ',NrOperacion1=FBN['NrOperacion'])
              ACT(f:FAC, 'Manual')          
           Else 
              ACT(f:FAC, 'Manual. No posee Vouchers')          
           Endif
        EndIf

        *-- Se ejecuta el actualizar Movimiento
        EjecutarEvento('ACTMOV',Vehiculo1=FBN['Vehiculo1'],Fecha1=Fsys,Fecha2=Fsys,NrOperacion1=FBN['NrOperacion'],TipoOp1=fbn['TipoOp'],Radio1=-1)
  
        SetFont(a:fac..f:fac,1)

        act(ab1,FBN['NrOperacion'])
        SetFont(a:fac..f:fac,2)
     Else
        dfa
     EndIf

     ACN(z1,1)
Proximo

*-- Recupero las Operaciones con Mov. Duplicados para Actualizar los Movimientos
SQL.ADD("Select O.NrOperacion,O.TipoOp,O.Vehiculo1,M.NrMov,COUNT(*) FROM "~DBO~".MOVAJUSTE M, "~DBO~".OPERACIONES O ")
SQL.ADD("Where M.NrOperacion=O.NrOperacion ")
SQL.ADD("Group By O.NrOperacion,O.TipoOp,O.Vehiculo1,NrMov ")
SQL.ADD("Order By O.Vehiculo1,O.TipoOp,O.NrOperacion ")

ACN(z1,0)

Recorrer SQL    

     IF Val(z1)=0
        ifa
        ACT(a:fac,' Correcion de MOV.AJUSTES  ....')
        SetFont(a:fac..f:fac,1)
        IFA
     EndIf

     * Corte de Control por Operacion     
     IF Not EqStr(VAL(ab1),FBN['NrOperacion'])
        ACT(a:FAC, FBN['TipoOp'])
        ACT(b:FAC, FBN['NrOperacion'])
        ACLO(b:FAC, fbn('NrOperacion'))
        ACD(c:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',FBN['NrOperacion']))
        ACT(d:FAC, fbn('Vehiculo1'))
        ACT(e:FAC, 'Mov.Duplicado')         

        if Not Incluido(FBN['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
           ACT(f:FAC, 'Automatica')        
           SetFont(a:fac..f:fac,1)
        Else 
           acn(aa1,0)

           * Recupero los Nros. de Vouchers de Transacciones2
           ACN(aa1,SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~FBN['NrOperacion']~"' "))
   
           if Val(aa1)>0
              * Desliquido la Operacion
              EjecutarEvento('ELILIQ',NrOperacion1=FBN['NrOperacion'])
              ACT(f:FAC, 'Manual')          
           Else 
              ACT(f:FAC, 'Manual. No posee Vouchers')          
           Endif
        EndIf

        *-- Se ejecuta el actualizar Movimiento
        EjecutarEvento('ACTMOV',Vehiculo1=FBN['Vehiculo1'],Fecha1=Fsys,Fecha2=Fsys,NrOperacion1=FBN['NrOperacion'],TipoOp1=fbn['TipoOp'],Radio1=-1)
  
        SetFont(a:fac..f:fac,1)

        act(ab1,FBN['NrOperacion'])
        SetFont(a:fac..f:fac,2)
     Else
        dfa
     EndIf

     ACN(z1,1)
Proximo

* Recupero los Tipos de Operaciones Modificadas
SQL.ADD("Select * FROM "~DBO~".OPERACIONES O ")
SQL.ADD("Where TipoOp IN ")
SQL.ADD(" ('DPSV')  ")
SQL.ADD(" and Cuotas1>4  ")
SQL.ADD("Order By O.TipoOp,O.Vehiculo1,O.NrOperacion ")

ACN(z1,0)

Recorrer SQL    

     IF Val(z1)=0
        ACT(a:fac,'Correcion de OPERACIONES Con Cuotas > 4 MODIFICADAS ....')
        IFA
     EndIf

     ACN(z1,1)

     ACT(a:FAC, FBN['TipoOp'])
     ACT(b:FAC, FBN['NrOperacion'])
     ACLO(b:FAC, fbn('NrOperacion'))
     ACD(c:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',FBN['NrOperacion']))
     ACT(d:FAC, fbn('Vehiculo1'))
     ACT(e:FAC, 'Mov.Duplicado')         
     if Not Incluido(FBN['Vehiculo1'], VAR('VLIQUIDA')~Var('VLIQUIDA2'))
        ACT(f:FAC, 'Automatica')        
        SetFont(a:fac..f:fac,1)
     Else 
        acn(aa1,0)

        * Recupero los Nros. de Vouchers de Transacciones2
        ACN(aa1,SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1='"~FBN['NrOperacion']~"' "))

        if Val(aa1)>0
           EjecutarEvento('ELILIQ',NrOperacion1=FBN['NrOperacion'])
           ACT(f:FAC, 'Manual')          
        Else 
           ACT(f:FAC, 'Manual. No posee Vouchers')          
        endif

        SetFont(a:fac..f:fac,2)
     endif
     * Se ejecuta el actualizar Movimiento
     EjecutarEvento('ACTMOV',Vehiculo1=FBN['Vehiculo1'],Fecha1=Fsys,Fecha2=Fsys,NrOperacion1=FBN['NrOperacion'],TipoOp1=fbn['TipoOp'],Radio1=-1)
Proximo
EndIf

ACO(5,25)
LimitesVision(f:FAC)