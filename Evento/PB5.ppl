MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1: 'Vehiculo'        ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Especie1:  'Moneda'          ;;;;;;Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo',Dialogo.Especie1),'MON');'Moneda Invalida';NO;'ARP';;;;;" Tipo = 'MON' "
  Fecha1:    'Fecha Acredit.'  ;;;;;;;;;FSYS
  Fecha2:    'Fecha Ingreso'   ;;;;;;;;;FSYS
  Cliente1:  'Banco'           ;;;;;;Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN');'Banco Invalido';NO;;;;;;" Sector = 'BAN' "
  Cuenta1:   'Cuenta'          ;;;;;;Eqstr(BuscarCampo('CUENTAS', 'Comitente','Codigo',Dialogo.Cuenta1),Dialogo.Cliente1) y Eqstr(BuscarCampo('CUENTAS','Cliente','Codigo',Dialogo.Cuenta1),Dialogo.Vehiculo1);'Cuenta Invalida';NO;;;;;;" Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente = '"~Dialogo.Cliente1~"' AND (Especies LIKE '%"~Dialogo.Especie1~"%' OR Especies LIKE '%MONEDA%') "
  Entero1:   'Cant.Movimientos';;;;;;;;;100
FinDialogo

If Not Ok
  Cancelar
Endif

ACT(cc:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
ACT(ee:1, BuscarCampo('CUENTAS','Numero','Codigo',Dialogo.Cuenta1))

message('Cargando grilla inicial ... ')

Recorrer&i 1,Dialogo.Entero1
  ACN(a:&i, 0)
  ACT(b:&i, Dialogo.Cliente1)
  ACT(c:&i, Val(cc:1))
  ACT(d:&i, Dialogo.Cuenta1)
  ACT(e:&i, Val(ee:1))
  ACD(f:&i, Dialogo.Fecha1)
  ACN(g:&i, 0)
  ACT(h:&i, Dialogo.Vehiculo1)
  ACD(i:&i, Dialogo.Fecha2)
  ACN(j:&i, 0)
Proximo


CrearListBox  ; 'Arial,8,'
 'OK'              ;a:1..a:Dialogo.Entero1;SI;;; 30;CHECK ; RGB(232,255,215);IIF(Val(G:FLB)<>0,1,0);NO;NO;;;;;SI
 'Vehiculo'        ;h:1..h:Dialogo.Entero1;NO;;; 80;STRING;;RGB(232,232,232);
 'Cod.Banco'       ;b:1..b:Dialogo.Entero1;NO;;; 80;STRING;;RGB(232,232,232);
 'Razon Social'    ;c:1..c:Dialogo.Entero1;NO;;;150;STRING;;RGB(232,232,232);
 'Cod.Cuenta'      ;d:1..d:Dialogo.Entero1;NO;;; 80;STRING;;RGB(232,232,232);
 'Numero'          ;e:1..e:Dialogo.Entero1;NO;;;120;STRING;;RGB(232,232,232);
 'Monto'           ;g:1..g:Dialogo.Entero1;SI;;; 90;NUMERO;'###,###,###,###,###.##';RGB(221,242,255);;NO;NO;;;;;SI
 'FechaAcredit'    ;f:1..f:Dialogo.Entero1;SI;;; 70;FECHA ; RGB(221,242,255);;NO;NO;;;;;SI
 'FechaIngreso'    ;i:1..i:Dialogo.Entero1;SI;;; 70;FECHA ; RGB(221,242,255);;NO;NO;;;;;SI
 'Ingreso'         ;j:1..j:Dialogo.Entero1;SI;;; 80;COMBO;'Ejecutado|Pendiente';RGB(221,242,255);;NO;NO;;;;;SI
 'Concepto'        ;k:1..k:Dialogo.Entero1;SI;Val(a:flb)=0 o NOVACIO(Val(k:flb));; 70;TABLA ;'CNCONCEPTOSPAGOCOBRO';'Codigo';'Codigo;Descripcion';;RGB(221,242,255);;NO;NO;;;;;SI
 'Forma Pago/Cobro';l:1..l:Dialogo.Entero1;SI;Val(a:flb)=0 o NOVACIO(Val(l:flb));;110;TABLA ;'CNFORMASPAGOCOBRO'   ;'Codigo';'Codigo;Cuenta;Descripcion';;RGB(221,242,255);;NO;NO;;;;;SI
 'Chequera'        ;m:1..m:Dialogo.Entero1;EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:flb)),'CHE') y Val(g:flb)<0;NOVACIO(Val(m:flb)) o Val(a:flb)=0 o Not EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:flb)),'CHE');; 65;TABLA;'CNCHEQUERASBANCO';'Chequera';'Chequera;NrChequeDesde;NrChequeHasta';"Estado='HAB' and Vehiculo='"~Dialogo.Vehiculo1~"' and Cuenta='"~Val(d:flb)~"' ";RGB(221,242,255);;NO;NO;;;;;SI
 'Cheque'          ;n:1..n:Dialogo.Entero1;EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:flb)),'CHE') y Val(g:flb)<0;Val(n:flb)<>0 o Val(a:flb)=0 o Not EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:flb)),'CHE') o [Val(g:flb)>0 y Val(n:flb)=0] ;; 65;NUMERO;'###############';RGB(221,242,255);;NO;NO;;;;;SI
 'Boleta'          ;o:1..o:Dialogo.Entero1;Not EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:flb)),'CHE');;; 65;NUMERO;'###############';RGB(221,242,255);;NO;NO;;;;;SI
 'Proveedor'       ;p:1..p:Dialogo.Entero1;SI;;; 70;TABLA ;'CNPROVEEDORES';'Codigo';'Codigo;Nombre';;RGB(221,242,255);;NO;NO;;;;;SI
FinListBox

If Not Ok
  Cancelar
Endif

Recorrer&i 1,Dialogo.Entero1
 If Val(a:&i)=1
   If Val(g:&i)>0
     *CRVM
     ACT(nu:1, GETNUMERADOR(10100) )
     ACT(tt:1, 'CRVM')
   Else
     *DEVM
     ACT(nu:1, GETNUMERADOR(10101) )
     ACT(tt:1, 'DEVM')
   Endif

   SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
   SQL.ADD(" ConceptoPago, Fecha1, Fecha2, Fecha3, ")
   SQL.ADD(" Especie, Cantidad1, Cliente2, ")
   SQL.ADD(" Cuenta2, Vehiculo1, UsrInput, ")
   SQL.ADD(" NrTrans, TipoTr2, FechaCarga, FechaCargaSys, ")
   SQL.ADD(" Proveedor, CNFormaPago, Chequera1, ")
   SQL.ADD(" Cantidad2, CB2, CB3, Cambio1, CB4 ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" '"~Val(k:&i)~"', "~IdxDate2(Val(i:&i))~", "~IdxDate2(Val(f:&i))~", "~IdxDate2(Val(f:&i))~", ")
   SQL.ADD(" '"~Dialogo.Especie1~"', "~FSTR(ABS(Val(g:&i)),1,4)~", '"~Val(b:&i)~"', ")
   SQL.ADD(" '"~Val(d:&i)~"', '"~Dialogo.Vehiculo1~"', '"~USUARIOACTIVO~"', ")
   SQL.ADD(" '"~Val(nu:1)~"', '"~Val(tt:1)~"', "~IdxDate2(Dialogo.Fecha1)~", "~IdxDate2(Dialogo.Fecha1)~", ")
   SQL.ADD(" '"~Val(p:&i)~"', '"~Val(l:&i)~"', '"~Val(m:&i)~"', ")
   SQL.ADD(" "~FSTR(Val(n:&i),1,0)~", '0', ")
   If Val(j:&i)=0
     SQL.ADD(" '0', ")
   Else
     SQL.ADD(" '1', ")
   Endif
   SQL.ADD(" "~FSTR(Val(o:&i),1,0)~", '1' ")
   SQL.ADD(" ) ")
   SQL.NEW

    Recorrer&j 1,30
      ACT(jj:1, Fstr(&j,1,0))
      If Incluido(Val(jj:1),'15|16|17|18|20|25')
        SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" (NrOperacion, NrBit, Valor) ")
        SQL.ADD(" Values ")
        SQL.ADD(" ('"~Val(nu:1)~"',"~Fstr(&j,1,0)~",'0') ")
        SQL.NEW        
      Endif
    Proximo 

    If Val(j:&i)=0
      message('Ingresa Ejecutado')
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor='1' WHERE NrOperacion = '"~Val(nu:1)~"' AND NrBit=20 ")
      SQL.NEW
    Else
      message('Ingresa Pendiente')
      SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor='1' WHERE NrOperacion = '"~Val(nu:1)~"' AND NrBit=16 ")
      SQL.NEW
    Endif

    message('Transaccion '~Val(nu:1)~' generada.')
    SQL.EXEC

    SQL.ActualizarMovimientosT4(Val(nu:1),SI,NO,NO,NO,NO,NO,0)
    SQL.EXEC

    If Eqstr(Val(tt:1),'DEVM') 

    If EqStr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(l:&i)),'CHE')
      message(' Asignando Numero de Cheque ...')
      ACT(OB:1, 'Pago de Transaccion DEVM Nr. '~Val(TR:1))

      SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
      SQL.ADD(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
      SQL.ADD(" NrComprobante, Monto, Observaciones, Estado) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Val(m:&i)~"', '"~IdxDate(Val(i:&i))~"', "~fstr(Val(n:&i),0,0)~", "~IdxDate2(Val(f:&i))~", ")
      SQL.ADD(" '"~Val(nu:1)~"', "~fstr(abs(Val(g:&i)),1,2)~", '"~Val(OB:1)~"', 'ASI') ")
      SQL.NEW

      ***---Actualizo los datos del cheque en los movimientos
      SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" Set NrGrupo = "~Fstr(Num(Val(m:&i)), 0, 0)~", ")
      SQL.ADD(" NrComprob   = "~Fstr(Val(n:&i), 0, 0)~" ")
      SQL.ADD(" Where NrOperacion = '"~Val(nu:1)~"' ")
      SQL.NEW
      SQL.EXEC
    Endif
    Endif

    If Val(j:&i)=0
      SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS SELECT * FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(nu:1)~"' ")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(nu:1)~"' ")
      SQL.NEW
      SQL.EXEC
    Endif


 Endif
Proximo
