creardialogo
radio1:'Tipo|Activa|Borrada';1;1;1;;;;;;0;
nroperacion1:'# Operacion:';;;;dialogo.radio1 = 0;dialogo.radio1 = 0;dialogo.radio1 = 1 o NoVacio(dialogo.nroperacion1);'Debe ingresar una operacion';NO;
nrboperacion:'Op.Borrada :';2;;;dialogo.radio1 = 1;dialogo.radio1 = 1;dialogo.radio1 = 0 o NoVacio(dialogo.nrboperacion);'Debe ingresar una operacion anulada';NO;
string1:'Boleta ROFEX :';;;;;;;;;;iif (dialogo.radio1 = 0, BuscarCampo('OPERACIONES', 'NroAltaMAE', 'NrOperacion', dialogo.nroperacion1), BuscarCampo('BOPERACIONES', 'NroAltaMAE', 'NrOperacion', dialogo.nrboperacion));;;'XXXXXXXXX'
fecha1:'Fecha Alta ROFEX:';;;;;;;;;;iif ((dialogo.radio1 = 0 y Vacio(dialogo.nroperacion1)) o (dialogo.radio1 = 1 y Vacio(dialogo.nrboperacion)), FSys(), iif (dialogo.radio1 = 0, BuscarCampo('OPERACIONES', 'FechaAltaMAE', 'NrOperacion', dialogo.nroperacion1), BuscarCampo('BOPERACIONES', 'FechaAltaMAE', 'NrOperacion', dialogo.nrboperacion)));
entero1:'Hora:';;;;;;dialogo.entero1 < 24;'La hora no puede ser superior a 24';NO;;Num(Copy(dialogo.string5, 1, 2))
entero2:'Minutos:';;;;;;dialogo.entero2 < 60;'Los minutos no pueden ser superiores a 60';NO;;Num(Copy(dialogo.string5, 4, 2))
entero3:'Segundos:';;;;;;dialogo.entero3 < 60;'Los segundos no pueden ser superiores a 60';NO;;Num(Copy(dialogo.string5, 7, 2))
string2:'# Boleto';;;;;;;;;;iif (dialogo.radio1 = 0, BuscarCampo('OPERACIONES', 'NrBoleto', 'NrOperacion', dialogo.nroperacion1), BuscarCampo('BOPERACIONES', 'NrBoleto', 'NrOperacion', dialogo.nrboperacion));;;'XXXXXXXX'
string5:'Hora Operacion';;;;NO;NO;;;;;iif (dialogo.radio1 = 0, Hora(BuscarCampo('OPERACIONES', 'FechaAltaMAE', 'NrOperacion', dialogo.nroperacion1)), Hora(BuscarCampo('BOPERACIONES', 'FechaAltaMAE', 'NrOperacion', dialogo.nrboperacion)));
findialogo
if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(op:1, dialogo.nroperacion1)
else
Act(op:1, dialogo.nrboperacion)
endif


Sqladd("Update ")
if (dialogo.radio1 = 0)
Sqladd(" "~Dbo()~".OPERACIONES SET         ")
else
Sqladd(" "~Dbo()~".BOPERACIONES SET         ")
endif

if (NoVacio(dialogo.string1))
Sqladd("NroAltaMAE   = '"~Copy(Pad0(dialogo.string1, 5), 1, 8)~"', ")
Sqladd("AceptaMAE    = 'SI', ")
else
Sqladd("NroAltaMAE   = Null, ")
Sqladd("AceptaMAE    = Null, ")
endif

if (NoVacio(dialogo.string2))
Sqladd("NrBoleto  = '"~Copy(Pad0(dialogo.string2, 8), 1, 8)~"',")
else
Sqladd("NrBoleto  = Null, ")
endif

if (dialogo.fecha1 > 0)
Act(a2, Copy(dialogo.fecha1, 7, 4)~'-'~Copy(dialogo.fecha1, 4, 2)~'-'~Copy(dialogo.fecha1, 1, 2)~' '~FStr(dialogo.entero1, 2, 0)~':'~FStr(dialogo.entero2, 2, 0)~':'~FStr(dialogo.entero3, 2, 0))
Sqladd("FechaAltaMAE  = Convert(datetime,'"~Val(a2)~"',120) ")
else
Sqladd("FechaAltaMAE  = Null ")
endif
Sqladd("where NrOperacion = '"~Val(op:1)~"'")
Sqlnew()
Sqlexec()

Messagebox('Operacion modificada con exito')

