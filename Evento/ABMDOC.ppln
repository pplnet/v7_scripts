creardialogo
cliente1: 'Cliente';;;;;;NoVacio(dialogo.cliente1);'Ingrese un Cliente';;;
radio1:'Accion|Alta|Modif.';;;;;;;;;0
findialogo

if (not ok)
Cancelar()
endif

if (dialogo.radio1 = 0)
Act(l1, dialogo.cliente1)
Acd(b1, FSys())
crearlistbox;'Arial,8,'
'Cliente';l1..l1;NO;;;60;string;
'Documento';a1..a1;SI;;;90;string;
'Fecha';b1..b1;SI;;;80;fecha;
'Recibido';c1..c1;SI;;;30;combo;'  |SI|NO'
'COPERS';d1..d1;SI;;;80;string;
finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 1, 1
if (Query("Select 1 from "~Dbo()~".CLIENTESDOCUMENTACION where Codigo = '"~dialogo.cliente1~"' and Documento = '"~Val(a:&i)~"'") = 0)

Sqladd("INSERT INTO "~Dbo()~".CLIENTESDOCUMENTACION (Codigo,Documento,Fecha,Recibido,NrCOPERS) Values ")
Sqladd("('"~Val(l:&i)~"', ")
Sqladd(" '"~Val(a:&i)~"', ")
Sqladd(" '"~IdxDate(Val(b:&i))~"', ")
Sqladd(" '"~iif (Val(c:&i) = 0, '', iif (Val(c:&i) = 1, 'SI', 'NO'))~"', ")
Sqladd(" '"~Val(d:&i)~"') ")
Sqlnew()
Sqlexec()
else
Messagebox('El Cliente ya tiene Documentacion '~Val(a:&i)~' cargada - ingrese por Modificacion')
endif
proximo


else
Sqladd("Select * from "~Dbo()~".CLIENTESDOCUMENTACION ")
Sqladd("Where ")
Sqladd(" Codigo = '"~dialogo.cliente1~"' ")
Sqladd("Order by Documento ")
Watch(Sqlbatch())
SetFilaActual(0)

recorrer sql
Acn(x:fac, 0)
Act(a:fac, Fbn('Documento'))
Acd(b:fac, Fbn('Fecha'))
Act(c:fac, Fbn('Recibido'))
Act(d:fac, Fbn('NrCOPERS'))
Scn(xy:1, 1)
proximo

if (Val(xy:1) > 0)

crearlistbox;'Arial,8,';'Actualizacion Documentacion Cliente'~dialogo.cliente1
'Accion ?';x1..x:fac;SI;;;40;combo;'Modifica|Elimina'
'Documento';a1..a:fac;NO;;;60;string;
'Fecha';b1..b:fac;SI;;;80;fecha;
'Recibido';c1..c:fac;SI;;;80;combo;'  |SI|NO'
'COPERS';d1..d:fac;SI;;;80;string;
finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 1, Val(xy:1)

if (Val(x:&i) = 0)
Sqladd("UPDATE "~Dbo()~".CLIENTESDOCUMENTACION SET ")
Sqladd("  Recibido = '"~iif (Val(c:&i) = 0, '', iif (Val(c:&i) = 1, 'SI', 'NO'))~"',")
Sqladd("  NrCOPERS = '"~Val(d:&i)~"',")
Sqladd("  Fecha   = '"~IdxDate(Val(b:&i))~"'")
Sqladd("Where ")
Sqladd("  Codigo  = '"~dialogo.cliente1~"' and ")
Sqladd("  Documento = '"~Val(a:&i)~"'  ")
else
Sqladd("DELETE "~Dbo()~".CLIENTESDOCUMENTACION  ")
Sqladd("Where ")
Sqladd("  Codigo  = '"~dialogo.cliente1~"' and ")
Sqladd("  Documento = '"~Val(a:&i)~"'  ")
endif
Sqlnew()
Sqlexec()

proximo

else
Messagebox('El Cliente - '~dialogo.cliente1~' - no tiene Documentacion cargada ')
endif
endif


