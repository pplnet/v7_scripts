CrearDialogo
  Especie1: 'Especie'      ;;;;;;NOVACIO(Dialogo.Especie1) y NOT DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Especie invalida';NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' "
  Fecha1:   'Record Date'  ;;;;;;NOVACIO(Dialogo.Fecha1);'Fecha invalida';NO;fsys
  Fecha2:   'Fecha Pago'   ;;;;;;NOVACIO(Dialogo.Fecha2);'Fecha invalida';NO;fsys
  Mercado1: 'Mercado'      ;;;;;;
  Vehiculo1:'Vehiculo'     ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
  Operador1:'Operador'     ;1;2;;NO;;NoVacio(Dialogo.Operador1);'Operador Invalido';NO;USUARIOACTIVO
  Check1   :'Impacta SE'   ;5; ; ;  ;  ;;;;0;
  Check2   :'Interfase'    ;6; ; ;NO;NO;;;;1;
FinDialogo

IF NOT OK
   Cancelar
ENDIF

ACT(ES:1, Dialogo.Especie1)
ACD(FE:1, Dialogo.Fecha1)
ACD(FE:2, Dialogo.Fecha2)
ACT(MR:1, Dialogo.Mercado1)
ACT(VH:1, Dialogo.Vehiculo1)


***---Obtengo datos de la especie
SQL.ADD(" Select Nombre, ISIN, LaminaMinima ")
SQL.ADD(" From "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")

Recorrer SQL
  DFA
  ACT(NM:1, fbn('Nombre'))
  ACT(AI:1, fbn('ISIN'))
  ACN(LM:1, IIF(fbn('LaminaMinima')=0,1,fbn('LaminaMinima')))
Proximo

* Saldos Libre
