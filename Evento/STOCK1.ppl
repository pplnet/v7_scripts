***--- SALDOS Y MOVIMIENTOS
SQL.ADD(" SELECT Distinct T.Especie, T.Cupon1, T.Vehiculo1, T.Mercado1, T.Cliente1, T.Cuenta1, T.Cantidad1, T.Precio1, ")
SQL.ADD(" T.Cantidad2, T.Cantidad3, T.NrTrans, T.FechaEj, T.PrecioEj, T.Cuenta4, T.RB1, ")
* FJL 18/12/21 - Se Traen datos Comisiones
SQL.ADD(" T.Cantidad9, T.Cantidad10, T.Cantidad11, ")
** FJL 25/8/22 - Se agrgan Comisiones CV
SQL.ADD(" T.Cantidad12, T.Cantidad13, T.Cantidad14, T.Cantidad15, ")
SQL.ADD(" T.Especie1, T.Especie2, ")
SQL.ADD(" T.Cambio5, T.Cuenta2, T.Cliente2, ")
SQL.ADD(" C.RazonSocial, E.TamanioLote ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE T.Cliente1 = C.Codigo ")
SQL.ADD("   AND T.Especie  = E.Codigo ")
SQL.ADD("   AND T.TipoTr2 = 'STOCK' ")
SQL.ADD("   AND T.RB2 = 0 ")
SQL.ADD("   AND T.RB1 > 0 ")
SQL.ADD("   AND T.Vehiculo1 = '"~Val(VH:1)~"' ")
SQL.ADD("   AND T.Especie = '"~Val(ES:1)~"' ")
SQL.ADD("   AND T.Fecha1 = '"~IdxDate(Val(FE:2))~"' ")
SQL.ADD("   AND T.Fecha2 = '"~IdxDate(Val(FE:1))~"' ")
If Not CeldaVacia(MR:1)
   SQL.ADD(" AND T.Mercado1 = '"~Val(MR:1)~"' ")
ENDIF
SQL.ADD(" ORDER BY T.Cliente1, T.NrTrans")

ACN(z:1,0)
ACN(z:10,0)

Recorrer SQL
  ACN(z:2,fbn('TamanioLote'))
  if Incluido(fbn('Cambio5'),Val(sl:4))
    DFA
    SCN(z:10, 1)
    ACT(bb:Val(z:10), fbn('Mercado1'))
    ACT(bc:Val(z:10), fbn('Cliente1'))
    ACT(bd:Val(z:10), fbn('Especie1'))
    ACT(be:Val(z:10), fbn('Especie2'))
    ACT(bf:Val(z:10), fbn('NrTrans'))
    ACT(bj:Val(z:10), fbn('Cuenta4'))
    ACT(bv:Val(z:10), fbn('Mercado1'))

    ACN(bl:Val(z:10), fbn('Cantidad9')) 
    ACN(bm:Val(z:10), fbn('Cantidad10'))
    ACN(bn:Val(z:10), fbn('Cantidad11'))
    ACN(bo:Val(z:10), fbn('Cambio5'))
    ACT(br:Val(z:10), fbn('Cuenta2'))
    ACT(bs:Val(z:10), fbn('Cliente2'))
  else
    SCN(z:1, 1) 
    ACT(a:fac, fbn('Especie'))
    ACT(b:fac, fbn('Cupon1'))
    ACT(d:fac, fbn('Vehiculo1'))
    ACT(e:fac, fbn('Mercado1'))
    ACT(f:fac, fbn('RazonSocial'))
    ACT(g:fac, fbn('Cliente1'))
    ACT(h:fac, fbn('Cuenta1'))
    ACN(k:fac, fbn('Precio1'))
    ACN(PR:1, fbn('Precio1'))
    ACN(j:fac, fbn('Cantidad1'))
    ACN(l:fac, fbn('Cantidad2'))
    ACN(m:fac, fbn('Cantidad3'))
    ACT(n:fac, fbn('NrTrans'))
    ACD(p:fac, fbn('FechaEj'))
    ACN(q:fac, fbn('PrecioEj'))
    ACN(r:fac, fbn('TamanioLote'))
    ACT(s:fac, fbn('Especie2'))
    ACT(NN:fac, fbn('Cuenta4'))
    * FJL 18/12/21 - Se Traen datos Comisiones
    ACN(ad:fac, fbn('Cantidad9'))
    ACN(ae:fac, fbn('Cantidad10'))
    ACN(af:fac, fbn('Cantidad11'))
    ACN(ag:fac, fbn('Cambio5'))
** FJL 25/8/22 - Se agrgan Comisiones CV
    ACN(ah:fac, fbn('Cantidad12')+fbn('Cantidad14'))
    ACN(ai:fac, fbn('Cantidad13')+fbn('Cantidad15'))
** FJL 26/8/22 - Se agrga Estado
    if fbn('Cambio5')>201
      ACN(aj:fac, fbn('Cambio5')-100)
    else
      ACN(aj:fac, fbn('Cambio5'))
    endif
    ACT(ak:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(aj:fac)))
    ACN(x:fac, 1) 
  endif
Proximo

If Val(z:1) = 0
   MessageBox('No se registran Split de Saldos y Movimientos pendientes de Confirmacion.')
Else
   CrearListBox ; 'Arial,8,';'Confirmacion Split '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') - SALDOS Y MOVPENDIENTES'
     'Ok?'           ;x:1..x:fac;NO;;;30 ;CHECK ;RGB(255,255,193);;;;;;;;SI
     'NrTrans'       ;n:1..n:FAC;NO;;;60 ;STRING;;RGB(220,220,193);
     'Especie'       ;a:1..a:FAC;NO;;;60 ;STRING;;RGB(220,220,193);
     'Vehiculo'      ;d:1..d:FAC;NO;;;80 ;STRING;;RGB(220,220,193);
     'Mercado'       ;e:1..e:FAC;NO;;;60 ;STRING;;RGB(220,220,193);
     'Cliente'       ;f:1..f:FAC;NO;;;90 ;STRING;;RGB(220,220,193);
     'Cuenta'        ;h:1..h:FAC;NO;;;100;STRING;;RGB(220,220,193);
     'Saldo'         ;j:1..j:FAC;NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193);
     '%'             ;k:1..k:FAC;NO;;;40;NUMERO;'###.##';RGB(220,220,193);
     'Total'         ;l:1..l:FAC;NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193);
     'Nuevo saldo'   ;m:1..m:FAC;NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193);
     'Mon.Comision'  ;s:1..s:FAC;NO;;;80;STRING;;RGB(220,220,193)
     'Cta.Comision'  ;nn:1..nn:fac;SI;Val(X:FLB)=0 o ClienteCuenta(Val(g:FLB),Val(nn:FLB),Val(s:FLB));'Cuenta Pesos Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Eqstr(Val(G:FLB),Val(VH:1)),"Cliente='"~Val(G:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')", "Cliente='"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')");RGB(255,255,193);IIF(Eqstr(Val(G:FLB), Val(VH:1)), SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') ") , SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(s:FLB)~"%' OR Especies LIKE '%MONEDA%') "));NO;NO;'18';;;;SI
* FJL 18/12/21 - Se Traen datos Comisiones
     'Total Moneda'  ;ad:1..ad:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
     'Comision'      ;ae:1..ae:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
     'IVA Comision'  ;af:1..af:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 25/8/22 - Se agrgan Comisiones CV
     'Comision CV'   ;ah:1..ah:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
     'IVA Com CV'    ;ai:1..ai:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 26/8/22 - Se agrga Estado
     'Estado'        ;ak:1..ak:fac;NO;;;100;STRING;;RGB(220,220,193)
   FinListBox
   
   IF NOT OK
      Cancelar
   ENDIF
   
   Recorrer&i 1,fac 
     IF Val(x:&i)=1
        *------------------Pasa MovPendientes a Ejecutados --------------------*
        SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
        SQL.ADD("   Set Cuenta4 = '"~Val(NN:&i)~"', ")
        SQL.ADD("       Fecha3  = '"~IdxDate(FSys)~"', ")
        SQL.ADD("       RB2     = '1' ")
        SQL.ADD(" Where NrTrans = '"~Val(n:&i)~"' ")
        SQL.NEW
        SQL.EXEC
        
        SQL.ActualizarMovimientosT2(Val(n:&i),SI,NO,NO,NO)
        SQL.EXEC
        #ifdef BIND
        
            SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, SUM(Cantidad) Cantidad, SUM(Comision) Comision, SUM(Iva) Iva ")
            SQL.ADD(" FROM ( ")        
                SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, ")
                SQL.ADD("CASE WHEN M.NrGrupo=2 Then Sum(Cantidad) ELSE 0 End Cantidad, ")
                SQL.ADD("CASE WHEN M.NrGrupo in(41,51) Then Sum(Abs(Cantidad)) ELSE 0 End Comision, ")
                SQL.ADD("CASE WHEN M.NrGrupo in(42,52) Then Sum(Abs(Cantidad)) ELSE 0 End Iva ")
                SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M ")
                SQL.ADD(" WHERE NrOperacion='"~Val(n:&i)~"' ")
                SQL.ADD("   AND "~DBO~".DesciendeDeEspecie(M.Especie,'MONEDA') = 1 ")
                SQL.ADD("   AND Mercado='"~VAR('MERCADOBT')~"' ")
                SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado, NrGrupo  ")
            SQL.ADD(" ) ACCIONES ")        
            SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado ")        
            watch(SQL.BATCH())   

            Recorrer SQL
              (.'PAGOACCION'.)
            Proximo
        #endif        
        message('Transaccion '~Val(n:&i)~' Confirmada.')
        
        *----------------------------------------------------------------------*
     ENDIF
   Proximo
   ACN(z:3,Val(z:2)+Val(z:2)*Val(PR:1)/100)
   
   SQL.ADD("UPDATE "~DBO~".ESPECIES ")
   SQL.ADD("   SET TamanioLote = "~FSTR(Val(z:3),1,0)~" ")
   SQL.ADD(" WHERE Codigo      = '"~Val(ES:1)~"' ")
   SQL.NEW
   SQL.EXEC
   
   Message('Lote de la Especie actualizado.')

   if Val(z:10)>0
     recorrer&i 1,Val(z:10)
       SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
       SQL.ADD("   Set Fecha3  = '"~IdxDate(FSys)~"', ")
       SQL.ADD("       RB2     = '1' ")
       SQL.ADD(" where NrTrans = '"~Val(bf:&i)~"' ")
       SQL.NEW
       SQL.EXEC
           
       SQL.ActualizarMovimientosT2(Val(bf:&i),SI,NO,NO,NO)
       SQL.EXEC
*      messageBox('Transaccion: '~Val(bf:&i)~' Especie: '~Val(bd:&i)~' confirmada.')
     Proximo
   EndIf

EndIf

ACN(FI:1,fac+1)

* FJL 03/11/2021 Saco los pagos de Posiciones
IF NO
    ***--- POSICIONES
    SQL.ADD(" SELECT Distinct T.Especie, T.Cupon1, T.Vehiculo1, T.Mercado1, T.Cliente1, T.Cuenta1, T.Cantidad1, T.Precio1, ")
    SQL.ADD(" T.Cantidad2, T.Cantidad3, T.NrTrans, T.FechaEj, T.PrecioEj, T.Cuenta4, T.Book1, C.RazonSocial, E.TamanioLote ")
    SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
    SQL.ADD(" WHERE T.Cliente1 = C.Codigo ")
    SQL.ADD("   AND T.Especie  = E.Codigo ")
    SQL.ADD("   AND T.TipoTr2 = 'STOCK' ")
    SQL.ADD("   AND T.RB2 = 0 ")
    SQL.ADD("   AND T.RB1 = 0 ")
    SQL.ADD("   AND T.Vehiculo1 = '"~Val(VH:1)~"' ")
    SQL.ADD("   AND T.Especie = '"~Val(ES:1)~"' ")
    SQL.ADD("   AND T.Fecha1 = '"~IdxDate(Val(FE:2))~"' ")
    SQL.ADD("   AND T.Fecha2 = '"~IdxDate(Val(FE:1))~"' ")
    If Not CeldaVacia(MR:1)
       SQL.ADD(" AND T.Mercado1 = '"~Val(MR:1)~"' ")
    ENDIF
    SQL.ADD(" ORDER BY T.Cliente1, T.NrTrans")

    ACN(z:1,fac)
    ACN(z:4,0)

    Recorrer SQL
      ACN(z:2,fbn('TamanioLote'))
      ACT(a:fac, fbn('Especie'))
      ACT(b:fac, fbn('Cupon1'))
      ACT(d:fac, fbn('Vehiculo1'))
      ACT(e:fac, fbn('Mercado1'))
      ACT(f:fac, fbn('RazonSocial'))
      ACT(g:fac, fbn('Cliente1'))
      ACT(h:fac, fbn('Book1'))
      ACN(j:fac, fbn('Cantidad1'))
      ACN(k:fac, fbn('Precio1'))
      ACN(PR:1, fbn('Precio1'))
      ACN(l:fac, fbn('Cantidad2'))
      ACN(m:fac, fbn('Cantidad3'))
      ACT(n:fac, fbn('NrTrans'))
      ACD(p:fac, fbn('FechaEj'))
      ACN(q:fac, fbn('PrecioEj'))
      ACN(r:fac, fbn('TamanioLote'))
      ACT(NN:fac, fbn('Cuenta4'))
      ACN(x:fac, 1) 
      SCN(z:1,1)
      ACN(z:4,1)
    Proximo

    If Val(z:4) = 0
       MessageBox('No se registran Split de Posiciones pendientes de Confirmacion.')
    Else
       CrearListBox ; 'Arial,8,';'Confirmacion Split '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') - POSICIONES'
         'Ok?'           ;x:Val(FI:1)..x:Val(z:1);SI;;;30 ;CHECK ;RGB(255,255,193);;;;;;;;SI
         'NrTrans'       ;n:Val(FI:1)..n:Val(z:1);NO;;;60 ;STRING;;RGB(220,220,193);
         'Especie'       ;a:Val(FI:1)..a:Val(z:1);NO;;;60 ;STRING;;RGB(220,220,193);
         'Vehiculo'      ;d:Val(FI:1)..d:Val(z:1);NO;;;80 ;STRING;;RGB(220,220,193);
         'Mercado'       ;e:Val(FI:1)..e:Val(z:1);NO;;;60 ;STRING;;RGB(220,220,193);
         'Cliente'       ;f:Val(FI:1)..f:Val(z:1);NO;;;90 ;STRING;;RGB(220,220,193);
         'Book'          ;h:Val(FI:1)..h:Val(z:1);NO;;;100;STRING;;RGB(220,220,193);
         'Saldo'         ;j:Val(FI:1)..j:Val(z:1);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193);
         '%'             ;k:Val(FI:1)..k:Val(z:1);NO;;;40;NUMERO;'###.##';RGB(220,220,193);
         'Total'         ;l:Val(FI:1)..l:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193);
         'Nuevo saldo'   ;m:Val(FI:1)..m:Val(z:1);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193);
         'Cta.Pesos'     ;nn:Val(FI:1)..nn:Val(z:1);SI;Val(X:FLB)=0 o ClienteCuenta(Val(g:FLB),Val(nn:FLB),VAR('MONELOCA'));'Cuenta Pesos Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Eqstr(Val(G:FLB),Val(VH:1)),"Cliente='"~Val(G:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')", "Cliente='"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') AND TipoCuenta In ('CC','CA','CUS')");RGB(255,255,193);IIF(Eqstr(Val(G:FLB), Val(VH:1)), SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') ") , SQL(" Select Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(G:FLB)~"' AND Estado = 'HAB' AND (Especies LIKE '"~VAR('MONELOCA')~"%' OR Especies LIKE '%MONEDA%') "));NO;NO;'18';;;;SI
       FinListBox
       
       IF NOT OK
          Cancelar
       ENDIF
       
       Recorrer&i 1,fac 
         IF Val(x:&i)=1
            *------------------Pasa MovPendientes a Ejecutados --------------------*
            SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD(" Set Cuenta4 = '"~Val(NN:&i)~"', ")
            SQL.ADD("     RB2 = '1' ")
            SQL.ADD(" Where NrTrans = '"~Val(n:&i)~"' ")
            SQL.NEW
            SQL.EXEC
            
            SQL.ActualizarMovimientosT2(Val(n:&i),NO,NO,NO,SI)
            SQL.EXEC
            
            message('Transaccion '~Val(n:&i)~' Confirmada.')
            
            *----------------------------------------------------------------------*
         ENDIF
       Proximo
       ACN(z:3,Val(z:2)+Val(z:2)*Val(PR:1)/100)
       
       SQL.ADD(" UPDATE "~DBO~".ESPECIES SET TamanioLote = "~FSTR(Val(z:3),1,0)~" ")
       SQL.ADD(" WHERE Codigo = '"~Val(ES:1)~"' ")
       SQL.NEW
       SQL.EXEC
       
       Message('Lote de la Especie actualizado.')
       
    EndIf
