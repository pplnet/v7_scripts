CrearDialogo
    Radio1:        'Filtrar Por|Operacion|FechaVto.'  ;;;;;;;;;0
    NrOperacion1:  'NrOperacion'                      ;3;;;;Dialogo.Radio1=0;If(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)<=FSYS y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMCPM') y BuscarCampo('OPERACIONES','CB8','NrOperacion',Dialogo.NrOperacion1)<>1,);'La operacion debe estar vencida,ser de tipo MMCPM y no haberse renovado previamente';NO;;;;;;"TipoOp='MMCPM' and FechaVto<= '"~IdxDate(FSYS)~"' and (CB8='0' or CB8='' or CB8=' ' or CB8 is Null)"
    Fecha1:        'FechaVto.'                        ;3;;;;Dialogo.Radio1=1;If(Dialogo.Radio1=1,Dialogo.Fecha1<=FSYS,);'No puede renovar plazos que aun no han vencido';NO;;FSYS
FinDialogo

If Not Ok
    Cancelar
Endif

HojaVisible(SI)

**********************************************************SQL************************************************************************
SQL.ADD("Select O.NrOperacion,O.Vehiculo1,O.Book1,O.Cliente1,O.Cuenta1, O.FechaOp, O.Plazo, O.FechaVto,O.Cantidad, O.Precio1 as 'Tasa Intereses',")
SQL.ADD(" O.RB8 as 'U.Tiempo', C.Cantidad3 as 'Intereses' ,O.ImpGastos1 as 'TasaRet.', C.Cantidad4 as 'Retenciones' ")
SQL.ADD("From "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS C  ON O.NrOperacion = C.NrOperacion ")

If Dialogo.Radio1=1
    SQL.ADD("Where FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' and TipoOp='MMCPM' and (CB8='0' or CB8='' or CB8=' ' or CB8 is Null) ")
Else
    SQL.ADD("Where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif  
  
****************************************************************DATOS DE OP A RENOVAR***********************************************

Recorrer SQL
        If Dialogo.Radio1=1
            ACN(A:fac,1)
        Else
            ACN(A:fac,0)
        Endif
        ACT(B:fac,fbn['NrOperacion'])
        ACT(C:fac,fbn['Vehiculo1'])
        ACT(D:fac,fbn['Book1'])
        ACT(E:fac,fbn['Cliente1'])
        ACT(F:fac,fbn['Cuenta1'])
        ACD(G:fac,fbn['FechaOp'])
        ACN(H:fac,fbn['Plazo'])
        ACD(I:fac,fbn['FechaVto'])
        ACN(J:fac,fbn['Tasa Intereses'])
        ACN(K:fac,fbn['Intereses'])
        ACN(L:fac,fbn['TasaRet.'])
        ACN(M:fac,fbn['Retenciones'])
        ACN(N:fac,fbn['Cantidad'])
        ACN(O:fac,fbn['U.Tiempo'])
        
Proximo
*********************************************************SELECCION DE OP A RENOVAR**************************************************
let &UltimaFila FAC

If Dialogo.Radio1=1
    CrearListBox;'Arial,8,B'
        'Renovar'        ; a:1..a:fac; SI; SI;;60; COMBO;'Si|No|'
        'NrOperacion'    ; b:1..b:fac; NO; NO;;100; STRING
        'Vehiculo'       ; c:1..c:fac; NO; NO;;100; STRING
        'Book'           ; d:1..d:fac; NO; NO;;100; STRING
        'Cliente'        ; e:1..e:fac; NO; NO;;100; STRING
        'Cuenta'         ; f:1..f:fac; NO; NO;;100; STRING
        'FechaOp'        ; g:1..g:fac; NO; NO;;100; FECHA
        'Plazo'          ; H:1..H:fac; NO; NO;;60;  NUMERO;'####'
        'FechaVto'       ; I:1..I:fac; NO; NO;;100; FECHA
        'Tasa Intereses' ; J:1..J:fac; NO; NO;;100; NUMERO;'###.########'
        'Intereses'      ; K:1..K:fac; NO; NO;;100; NUMERO;'###,###,###,###.##'
        'TasaRet.'       ; L:1..L:fac; NO; NO;;100; NUMERO;'###.########'
        'Retenciones'    ; M:1..M:fac; NO; NO;;100; NUMERO;'###,###,###,###.##'
        'Cantidad'       ; N:1..N:fac; NO; NO;;100; NUMERO;'###,###,###,###.##'
    FinListBox
        
        If Not Ok
            Cancelar
        Endif
        
    Endif
*********************************************************GRILLA CON DATOS PARA LA NUEVA OP******************************************
let &FilaCarga 0
Recorrer&i 1,&UltimaFila
    If Val(A:&i)=0
        let &FilaCarga &FilaCarga+1
        *NrOperacion
        ACT(AB:&FilaCarga,Val(B:&i))
        *Vehiculo1
        ACT(AC:&FilaCarga,Val(C:&i))
        *Book1
        ACT(AD:&FilaCarga,Val(D:&i))
        *Cliente1
        ACT(AE:&FilaCarga,Val(E:&i))
        *Cuenta1
        ACT(AF:&FilaCarga,Val(F:&i))
        *FechaOpOri
        ACD(AG:&FilaCarga,Val(G:&i))
        *Plazo
        ACN(AH:&FilaCarga,Val(H:&i))
        *FechaVtoOri
        ACD(AI:&FilaCarga,Val(I:&i))
        *Tasa Intereses
        ACN(AJ:&FilaCarga,Val(J:&i))
        *U. Tiempo
        IF Val(O:&i)=0
            ACN(AO:&FilaCarga,360)
            ACN(O:&i,360)
        ELSE
            ACN(AO:&FilaCarga,365)
            ACN(O:&i,365)
        ENDIF
        *Cantidad1
        ACN(AN:&FilaCarga,Val(N:&i)+Val(K:&i)-Val(M:&i))
        *Intereses
        ACN(AK:&FilaCarga,((Val(N:&i)+Val(K:&i)-Val(M:&i))*(Val(J:&i)/100)*VAL(H:&i))/Val(O:&i))
        *Tasa Ret
        ACN(AL:&FilaCarga,Val(L:&i))
        *Retenciones
        ACN(AM:&FilaCarga,[Val(K:&i)*Val(L:&i)]/100)
        *FechaVtoNuevaOp
        ACD(AP:&FilaCarga,Val(I:&i)+Val(H:&i))
    Endif
Proximo

*****************************************************LIST BOX CON LOS CAMPOS DE LA NUEVA OP****************************************
    CrearListBox;'Arial,9,B'
        'Op. a Renovar' ; AB:1..AB:&FilaCarga; NO; NO;;100; STRING
        'Vehiculo'      ; AC:1..AC:&FilaCarga; NO; NO;;100; STRING
        'Book'          ; AD:1..AD:&FilaCarga; NO; NO;;100; STRING
        'Cliente'       ; AE:1..AE:&FilaCarga; NO; NO;;100; STRING
        'Cuenta'        ; AF:1..AF:&FilaCarga; NO; NO;;100; STRING
        'FechaOp'       ; AI:1..AI:&FilaCarga; NO; NO;;100; FECHA
        'Plazo'         ; AH:1..AH:&FilaCarga; SI; Val(AH:FLB)>0;'El Plazo debe ser mayor a cero';40;NUMERO;'####';;DifDias(Val(AP:FLB),Val(AI:FLB),'ARG',NO);NO;NO;;;;;SI
        'FechaVto'      ; AP:1..AP:&FilaCarga; SI; [Val(AP:FLB)>Val(AI:FLB)] y EsHabil(Val(AP:FLB)); 'La Fecha de vencimiento debe ser habil y mayor a la fecha de la operacion';100;FECHA;;Val(AI:FLB)+Val(AH:FLB);NO;NO;;;;;SI
        'Cantidad'      ; AN:1..AN:&FilaCarga; NO; NO;;100;NUMERO;'###,###,###,###.##'
        'Tasa Intereses'; AJ:1..AJ:&FilaCarga; SI; Val(AJ:FLB)>=VAR('RTASA1') y Val(AJ:FLB)<=VAR('RTASA2'); 'La tasa se encuentra fuera de rango';100;NUMERO;'###.########'
        'U.Tiempo'      ; AO:1..AO:&FilaCarga; NO; NO;;50;NUMERO;'###'
        'Intereses'     ; AK:1..AK:&FilaCarga; NO; NO;;100;NUMERO;'###,###,###,###.##';;(Val(AN:FLB)*(Val(AJ:FLB)/100)*VAL(AH:FLB))/Val(AO:FLB);NO;NO;;;;;SI
        'TasaRet.'      ; AL:1..AL:&FilaCarga; SI; Val(AL:FLB)>=0;'La tasa de retencion no puede ser negativa';60;NUMERO;'###.########'
        'Retenciones'   ; AM:1..AM:&FilaCarga; NO; ;;100; NUMERO;'###,###,###,###.##';;[Val(AK:FLB)*Val(AL:FLB)]/100;NO;NO;;;;;SI
    FinListBox
    
    If Not Ok
        Cancelar
    Endif

**********************************************************INSERT A OPERACIONES******************************************************
   
    
Recorrer&j 1,&FilaCarga
    ACN(NU:1,BuscarCampo('VEHICULOS','Alias1','Codigo',Val(AC:&j)))
    ACT(NO:1,GetNumerador(Val(NU:1)))
    
    **INSERT EN OPERACIONES DE LA NUEVA OP
    SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
    SQL.ADD("(Especie,TipoOp,NrOperacion,Cantidad,Precio1,Spread,PrecioMer,Cliente1,Operador,FechaOp,FechaVto,Plazo,RB3,MB3,")
    SQL.ADD("UsrInput,FechaCarga,Observac2,Numerador,Impresa,FechaCargaSys,Cuotas1,TablaFeriados1,FechaOp2,Plazo2,Plazo4,TotalAux2,")
    SQL.ADD("Cotizacion1,PlazoGracia,RB7,RB8,RB9,Vehiculo1,TipoTasa,DeltaTasa,PeriodoInts,Cuenta1,Cuenta2,Cotizacion2,ImpGastos1,")
    SQL.ADD("ImpGastos2,PrecioRef,RB11,Indice,Coeficiente,CantidadOri,ResultadoIndice,Book1,Precio6,CB13,CB15,RB15,RB16,TotalAux5,")
    SQL.ADD("TotalAux6,RB10,Precio3,FechaVto2,Plazo3,TipoGracia,Precio7,ContraEspecie6,TotalAux7")

    
    SQL.ADD("Select ")
    SQL.ADD("Especie,")
    SQL.ADD("TipoOp,")
    SQL.ADD("'"~Val(NO:1)~"',")
    SQL.ADD("'"~Val(AN:&j)~"',")
    SQL.ADD("'"~Val(AL:&j)~"',")
    SQL.ADD("Spread,")
    **PrecioMer
    ACN(PM:1,Val(AN:&j)*COTIZACIONC(BuscarCampo('OPERACIONES','Especie','NrOperacion',Val(AB:&j)),,,,Val(AI:&j),1,SI,VAR('MONEEXTR')))
    **
    SQL.ADD("'"~Val(PM:1)~"',")
    SQL.ADD("'"~Val(AE:&j)~"',")
    SQL.ADD("'"~UsuarioActivo~"'")
    SQL.ADD("'"~IdxDate(Val(AI:&j))~"',")
    SQL.ADD("'"~IdxDate(Val(AP:&j))~"',")
    SQL.ADD("'"~Val(AH:&j)~"',")
******RB3-MOF -VER CON JOSÉ SEGÚN INSTANCIA (VER DEFAULT MMCPM)
    SQL.ADD("1,")
    **
    SQL.ADD("MB3,")
    SQL.ADD("'"~UsuarioActivo~"'")
    SQL.ADD("'"~IdxDate(Ahora)~"'")
    SQL.ADD("Observac2,")
    SQL.ADD("Numerador,")
    SQL.ADD("Impresa,")
    SQL.ADD("'"~IdxDate(Fsys)~"'")
    SQL.ADD("Cuotas1,")
    SQL.ADD("TablaFeriados1,")
    SQL.ADD("'"~IdxDate(Val(AI:&j))~"',")
    SQL.ADD("'"~Val(AI:&j)~"',")
    SQL.ADD("Plazo2,") 
    SQL.ADD("Plazo4,")
    SQL.ADD("TotalAux2,")
    **Cotizacion1 
    ACT(EO:1,BuscarCampo('OPERACIONES','Especie','NrOperacion',Val(AB:&j)))
    IF EqStr(Val(EO:1),VAR('MONEEXTR'))
        ACN(CO:1,1)
    Else
        ACN(CO:1,COTIZACIONC(VAR('MONEEXTR'),,,,Val(AI:&j),1,SI,Val(EO:1)))
    Endif
    SQL.ADD("'"~Val(CO:1)~"',")
    **
    SQL.ADD("PlazoGracia,")
    SQL.ADD("RB7,")
    SQL.ADD("'"~Val(AO:&j)~"',")
    SQL.ADD("RB9,")
    SQL.ADD("'"~Val(AC:&j)~"',")
    SQL.ADD("TipoTasa,") 
    SQL.ADD("DeltaTasa,")
    **PeriodoInts(Imp.DB/CR) y VPRE3(Imp_Cheque CR)
    ACN(DT:1,BuscarCampo('OPERACIONES','DeltaTasa','NrOperacion',Val(AB:&j)))
    If Val(DT:1)<>0
        SQL.ADD("'"~(Val(AN:&j)*(Val(DT:1)/100))~"',")
        SQL.ADD("'"~(Val(AN:&j)*(Val(DT:1)/100))~"',")
    Else
        SQL.ADD("'0',")
        SQL.ADD("'0',")
    Endif
    **
    SQL.ADD("Cuenta1,")
    SQL.ADD("Cuenta2,")
    SQL.ADD("Cotizacion2,")
    SQL.ADD("'"~Val(AL:&j)~"',")
    SQL.ADD("ImpGastos2,")
    SQL.ADD("PrecioRef,")  
    SQL.ADD("RB11,")
    SQL.ADD("Indice,")
    SQL.ADD("Coeficiente,")
******CANTIDADORI (PREGUNTAR A JOSE SI ES DE ESTA MANERA O SIEMPRE ES CANTIDAD)
    If BuscarCampo()=0
        SQL.ADD("'"~Val(AN:&j)~"',")
    Else
        SQL.ADD("CantidadOri,")
    Endif
