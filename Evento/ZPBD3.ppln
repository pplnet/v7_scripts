MostrarCuadroDeMensajes()

Act(vh:1, SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

creardialogo
fecha1: 'F.Carga';;;;;;;;;FSys()
radio1: 'Estado|Pendientes|Ya informadas|Todas';;;;;;;;;0
lista1: 'Vehiculos';3;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), Val(vh: 1))
lista2: 'Bancos';;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista3: 'Cuentas';-2;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(dialogo.lista2)~") "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~Pipe2Comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~Pipe2Comillas(Val(vh: 1))~") "))~"  ");
findialogo

if (not ok)
Cancelar()
endif

Sqladd(" SELECT /*+ RULE */ T.NrTrans, T.Cuenta1, T.Cuenta2, T.Fecha1, T.Fecha2, T.Cliente1, T.Cliente2, ")
Sqladd(" T.Vehiculo1, T.Vehiculo2, T.Proveedor, T.RB1, T.ConceptoPago, T.Especie, T.Cantidad1, ")
Sqladd(" T.Cliente3, T.CNCuentaProveedor1, C1.Numero Numero1, C2.Numero Numero2, CP.Numero Numero3, T.CB5, T.CB3, OB.NrBit ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CUENTAS C1, "~Dbo()~".CUENTAS C2, "~Dbo()~".CLIENTES B1, ")
Sqladd(" "~Dbo()~".CLIENTES B2, "~Dbo()~".CLIENTES B3, "~Dbo()~".CNCUENTASPROVEEDOR CP, "~Dbo()~".OPERACIONESBITS OB ")
Sqladd(" WHERE T.Cuenta1 = C1.Codigo ")
Sqladd(" AND   T.NrTrans = OB.NrOperacion ")
Sqladd(" AND   T.Cliente1 = B1.Codigo ")
Sqladd(" AND   T.Cuenta2 = C2.Codigo (+) ")
Sqladd(" AND   T.CNCuentaProveedor1 = CP.Codigo (+) ")
Sqladd(" AND   T.Cliente2 = B2.Codigo (+) ")
Sqladd(" AND   T.Cliente3 = B3.Codigo (+) ")
Sqladd(" AND   T.Fecha1   = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   T.TipoTr2  = 'TRANSF' ")
if (dialogo.radio1 = 0)
Sqladd(" AND (T.CB7='0' OR T.CB7 IS NULL) ")
Sqladd(" AND OB.NrBit = 17 ")
Sqladd(" AND OB.Valor = '1' ")
else
Sqladd(" AND OB.NrBit IN (17,18,20) ")
Sqladd(" AND OB.Valor = '1' ")
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND  T.Cliente1 IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista3))
Sqladd(" AND  T.Cuenta1 IN ("~Pipe2Comillas(dialogo.lista3)~") ")
endif
Sqladd("ORDER BY T.Cuenta1 ")

Acn(z:1, 0)
recorrer sql
Message(Fbn('NrTrans'))
Act(a:fac, Fbn('NrTrans'))
Acd(b:fac, Fbn('Fecha1'))
Acd(c:fac, Fbn('Fecha2'))
Act(d:fac, Fbn('RB1'))
Act(e:fac, Fbn('Especie'))
Acn(f:fac, Fbn('Cantidad1'))
Act(g:fac, Fbn('Cuenta1'))
Act(i:fac, Fbn('Cliente1'))
Act(k:fac, Fbn('Numero1'))
if (Eqstr(Fbn('RB1'), '1'))
Act(h:fac, Fbn('CNCuentaProveedor1'))
Act(j:fac, Fbn('Cliente3'))
Act(l:fac, Fbn('Numero3'))
Act(o:fac, Fbn('Proveedor'))
else
Act(h:fac, Fbn('Cuenta2'))
Act(j:fac, Fbn('Cliente2'))
Act(l:fac, Fbn('Numero2'))
Act(o:fac, Fbn('Vehiculo2'))
endif
Act(m:fac, Fbn('RB1'))
if (Eqstr(Fbn('RB1'), '0'))
Act(m:fac, 'Ctas.Propias')
endif
if (Eqstr(Fbn('RB1'), '1'))
Act(m:fac, 'Proveedor')
endif
if (Eqstr(Fbn('RB1'), '2'))
Act(m:fac, 'Intercompany')
endif
Act(n:fac, Fbn('Vehiculo1'))
Act(p:fac, Fbn('CB3'))
Act(q:fac, Fbn('CB5'))
Acn(r:fac, Fbn('NrBit'))

Acn(x:fac, 1)
Acn(z:1, 1)
proximo

if (Val(z:1) = 0)
Cancelar('No se encontraron Transferencias para informar.')
