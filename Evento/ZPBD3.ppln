mostrarcuadrodemensajes

Act(vh:1, SQLSet(" Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))

creardialogo
fecha1: 'F.Carga';;;;;;;;;FSys()
radio1: 'Estado|Pendientes|Ya informadas|Todas';;;;;;;;;0
lista1: 'Vehiculos';3;1;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo from "~Dbo()~".VEHICULOS"), Val(vh: 1))
lista2: 'Bancos';;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista3: 'Cuentas';-2;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Comitente IN ("~pipe2comillas(dialogo.lista2)~") "~iif (NoVacio(dialogo.lista1), " AND Cliente IN ("~pipe2comillas(dialogo.lista1)~")", iif (NoVacio(UsrVehiculos(UsuarioActivo())), " AND Cliente IN ("~pipe2comillas(Val(vh: 1))~") "))~"  ");
findialogo

if (not ok)
Cancelar()
endif

sql.add(" SELECT /*+ RULE */ T.NrTrans, T.Cuenta1, T.Cuenta2, T.Fecha1, T.Fecha2, T.Cliente1, T.Cliente2, ")
sql.add(" T.Vehiculo1, T.Vehiculo2, T.Proveedor, T.RB1, T.ConceptoPago, T.Especie, T.Cantidad1, ")
sql.add(" T.Cliente3, T.CNCuentaProveedor1, C1.Numero Numero1, C2.Numero Numero2, CP.Numero Numero3, T.CB5, T.CB3, OB.NrBit ")
sql.add(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".CUENTAS C1, "~Dbo()~".CUENTAS C2, "~Dbo()~".CLIENTES B1, ")
sql.add(" "~Dbo()~".CLIENTES B2, "~Dbo()~".CLIENTES B3, "~Dbo()~".CNCUENTASPROVEEDOR CP, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" WHERE T.Cuenta1 = C1.Codigo ")
sql.add(" AND   T.NrTrans = OB.NrOperacion ")
sql.add(" AND   T.Cliente1 = B1.Codigo ")
sql.add(" AND   T.Cuenta2 = C2.Codigo (+) ")
sql.add(" AND   T.CNCuentaProveedor1 = CP.Codigo (+) ")
sql.add(" AND   T.Cliente2 = B2.Codigo (+) ")
sql.add(" AND   T.Cliente3 = B3.Codigo (+) ")
sql.add(" AND   T.Fecha1   = "~IdxDate2(dialogo.fecha1)~" ")
sql.add(" AND   T.TipoTr2  = 'TRANSF' ")
if (dialogo.radio1 = 0)
sql.add(" AND (T.CB7='0' OR T.CB7 IS NULL) ")
sql.add(" AND OB.NrBit = 17 ")
sql.add(" AND OB.Valor = '1' ")
else
sql.add(" AND OB.NrBit IN (17,18,20) ")
sql.add(" AND OB.Valor = '1' ")
endif
if (NoVacio(dialogo.lista1))
sql.add(" AND T.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~")  ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
sql.add(" AND T.Vehiculo1 IN ("~pipe2comillas(Val(vh:1))~") ")
endif
endif
if (NoVacio(dialogo.lista2))
sql.add(" AND  T.Cliente1 IN ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND  T.Cuenta1 IN ("~pipe2comillas(dialogo.lista3)~") ")
endif
sql.add("ORDER BY T.Cuenta1 ")

Acn(z:1, 0)
recorrer sql
Message(Fbn('NrTrans'))
Act(a:fac, Fbn('NrTrans'))
Acd(b:fac, Fbn('Fecha1'))
Acd(c:fac, Fbn('Fecha2'))
Act(d:fac, Fbn('RB1'))
Act(e:fac, Fbn('Especie'))
Acn(f:fac, Fbn('Cantidad1'))
Act(g:fac, Fbn('Cuenta1'))
Act(i:fac, Fbn('Cliente1'))
Act(k:fac, Fbn('Numero1'))
if (Eqstr(Fbn('RB1'), '1'))
Act(h:fac, Fbn('CNCuentaProveedor1'))
Act(j:fac, Fbn('Cliente3'))
Act(l:fac, Fbn('Numero3'))
Act(o:fac, Fbn('Proveedor'))
else
Act(h:fac, Fbn('Cuenta2'))
Act(j:fac, Fbn('Cliente2'))
Act(l:fac, Fbn('Numero2'))
Act(o:fac, Fbn('Vehiculo2'))
endif
Act(m:fac, Fbn('RB1'))
if (Eqstr(Fbn('RB1'), '0'))
Act(m:fac, 'Ctas.Propias')
endif
if (Eqstr(Fbn('RB1'), '1'))
Act(m:fac, 'Proveedor')
endif
if (Eqstr(Fbn('RB1'), '2'))
Act(m:fac, 'Intercompany')
endif
Act(n:fac, Fbn('Vehiculo1'))
Act(p:fac, Fbn('CB3'))
Act(q:fac, Fbn('CB5'))
Acn(r:fac, Fbn('NrBit'))

Acn(x:fac, 1)
Acn(z:1, 1)
proximo

if (Val(z:1) = 0)
Cancelar()('No se encontraron Transferencias para informar.')
endif


crearlistbox;'Arial,8,'
'OK';x:1..x:fac;SI;;;30;check;RGB(232, 255, 215);
'NrTrans';a:1..a:fac;NO;;;65;string;;RGB(232, 232, 232);
'Vehiculo';n:1..n:fac;NO;;;70;string;;RGB(232, 232, 232);
'Tipo';m:1..m:fac;NO;;;70;string;;RGB(232, 232, 232);
'F.Emision';b:1..b:fac;SI;;;65;fecha;RGB(232, 255, 215);
'F.Tranf';c:1..c:fac;NO;;;65;fecha;RGB(232, 232, 232);
'Moneda';e:1..e:fac;NO;;;50;string;;RGB(232, 232, 232);
'Monto';f:1..f:fac;NO;;;80;numero;'###,###,###,###,###.##';RGB(232, 232, 232);
'De Banco';i:1..i:fac;NO;;;60;string;;RGB(232, 232, 232);
'De Cuenta';g:1..g:fac;NO;;;60;string;;RGB(232, 232, 232);
'Numero';k:1..k:fac;NO;;;80;string;;RGB(232, 232, 232);
'A Banco';j:1..j:fac;NO;;;60;string;;RGB(232, 232, 232);
'A Cuenta';h:1..h:fac;NO;;;60;string;;RGB(232, 232, 232);
'Numero';l:1..l:fac;NO;;;80;string;;RGB(232, 232, 232);
'Destinatario';o:1..o:fac;NO;;;80;string;;RGB(232, 232, 232);
finlistbox

if (not ok)
Cancelar()
endif

recorrer&i 1, Fac()
if (Val(x:&i) = 1)
linkearhoja('PBTRF1', 1, fecha1 = Val(b:&i), nrtrans1 = Val(a:&i))
endif
if (Val(r:&i) = 17)
Message('Actualizando instancias ... ')
sql.add(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '0' WHERE NrOperacion = '"~Val(a:&i)~"' AND NrBit=17 ")
sql.new

if (Eqstr(Val(p:&i), '1') o Eqstr(Val(q:&i), '1'))
Message('Pasa a Conciliacion ')
sql.add(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '1' WHERE NrOperacion = '"~Val(a:&i)~"' AND NrBit=18 ")
sql.new
sql.exec

sql.add(" INSERT INTO "~Dbo()~".INSTANCIASOP ")
sql.add(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
sql.add(" VALUES ('"~Val(a:&i)~"', '17', '"~UsuarioActivo()~"', 'ZPBD3', "~IdxDate2(FSys())~") ")
sql.new
sql.exec
else
Message('Pasa a Termninal ')
sql.add(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET ")
sql.add(" Valor = '1' WHERE NrOperacion = '"~Val(a:&i)~"' AND NrBit=20 ")
sql.new

Message('Pasando movimientos a ejecutados ...')
sql.add(" INSERT INTO "~Dbo()~".MOVEJECUTADOS (SELECT * FROM "~Dbo()~".MOVPENDIENTES ")
sql.add(" WHERE NrOperacion = '"~Val(a:&i)~"') ")
sql.new
sql.exec
sql.add(" DELETE /*+ RULE */ FROM "~Dbo()~".MOVPENDIENTES WHERE NrOperacion='"~Val(a:&i)~"' ")
sql.new
sql.exec

sql.add(" INSERT INTO "~Dbo()~".INSTANCIASOP ")
sql.add(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
sql.add(" VALUES ('"~Val(a:&i)~"', '17', '"~UsuarioActivo()~"', 'ZPBD3', "~IdxDate2(FSys())~") ")
sql.new
sql.exec
endif
endif
sql.add(" UPDATE /*+ RULE */ "~Dbo()~".TRANSACCIONES2 SET ")
sql.add(" CB7 = '1' WHERE NrTrans = '"~Val(a:&i)~"' ")
sql.new
sql.exec
proximo

