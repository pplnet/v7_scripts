*HojaVisible(SI)
*MostrarCuadrodeMensajes
CrearDialogo 
  Fecha1 :'Fecha'    ;2;1;;SI;SI;Dialogo.Fecha1<>0 y EsHabil(Dialogo.Fecha1,Var('FERIDEF'));'En fecha a tomar como base, debe Ingresar un dia habil';NO;Fsys;
  Label1 :''         ;1;1;;NO;;;;;;'Cotizaciones a procesar';;;
FinDialogo

If Not OK
  Cancelar
Endif

*If SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Registro='COT' and Estado='PRO' ") = 1
*   If MessageBox('Ya se habian procesado la cotizaciones. Continua????',3,2)<>6
*      Cancelar('El procesamiento de las cotizaciones ha sido cancelado!!!') 
*   Endif
*Endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Arial,10,B')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

act(a3,'Cotizaciones ROFEX del '~Fecha(Dialogo.Fecha1))
SetFont(a3,3)

act(a:5,'Fecha')
act(b:5,'Posicion')
act(c:5,'Precio')
act(d:5,'Fecha Vto.')
act(e:5,'Codigo FPA')
SetFont(a:5..e:5,1)
AgregarMarco(a:5..e:5,2,0,Exe('COLOR6'))
AlinearCeldas(a:5..e:5,'C')

SetFilaActual(6)
acn(z:1,0)

message('Recuperando Cotiz. Rofex...')
SQL.ADD("Select * From "~DBO~".COTIZACIONESROFEX ")
SQL.ADD(" where isnull(Procesado,'0')='0' ")
SQL.ADD("   and SUBSTRING(Posicion,1,3) = 'DLR' ")
SQL.ADD("   and Convert(Date,FechaReal)="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("Order by SUBSTRING(Posicion,1,3),FechaVto ")
watch(SQL.Batch)

Recorrer SQL
  message('...'~fbn['Posicion'])
  act(a:fac,fbn['Fecha'])
  act(b:fac,fbn['Posicion'])
  acn(c:fac,fbn['Ajuste'])
  act(d:fac,fbn['FechaVto'])
  act(e:fac, BuscarCampo('PLAZOSMERCADO', 'Especie', 'NombreExtendido', fbn['Posicion']) )
  act(fp:fac, BuscarCampo('PLAZOSMERCADO', 'FechaVto', 'NombreExtendido', fbn['Posicion']) )
  ACN(fs:fac,Sql("Select 1 From "~DBO~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))

  If Val(fs:fac)=1
     ACD(fv:fac,Sql("Select MaturityDate From "~DBO~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))
  Else
     act(ft:fac, Copy(val(b:fac),longitud(val(b:fac))-3,4)~'-'~Copy(val(b:fac),longitud(val(b:fac))-5,2)~'-01')
     acd(fv:fac,FinDeMes(Fecha(Val(ft:fac)),NO,'ARG'))
  Endif  
  ACN(tb:fac,0) 
  
  If NoVacio(Val(e:fac))
     *  Actualizar FechaVto si Cambió
     If Val(fp:fac)<>Val(fv:fac)
        SQL.ADD("Update "~DBO~".PLAZOSMERCADO ")
        SQL.ADD("   Set FechaVto =  "~IdxDate2(val(fv:fac))~" ")
        SQL.ADD(" Where MercadoNegociacion = '"~Var('MERROFEX')~"' ")
        SQL.ADD("   And NombreExtendido    = '"~Val(b:fac)~"' ")
        SQL.ADD("   And Especie            = '"~Val(e:fac)~"' ")        
        SQL.NEW
        SQL.EXEC 
     Endif
     ACN(tb:fac,1)
  Else
     If val(fv:fac) >= Dialogo.Fecha1 
     *-Verifico si puedo agregar la nueva EspecieRofex---
       *act(e:fac, BuscarCampo('ESPECIES','Codigo','Alias10',Copy(Val(b:fac),1,3)) )
       ACT(e:fac, Sql("Select Codigo From "~DBO~".ESPECIES Where Alias10 = '"~Copy(val(b:fac),1,longitud(val(b:fac))-6)~"' "))
       If NoVacio(Val(e:fac))
          SQL.ADD("Insert INTO "~DBO~".PLAZOSMERCADO ")
          SQL.ADD(" (NombreExtendido, Especie, FechaVto, MercadoNegociacion) ")
          SQL.ADD("VALUES ")
          SQL.ADD(" ('"~Val(b:fac)~"','"~Val(e:fac)~"', "~IdxDate2(val(fv:fac))~", '"~Var('MERROFEX')~"') ")
          SQL.NEW
          SQL.EXEC 
          ACN(tb:fac,1)
       Else
*          act(e:fac, 'No esta Alias10')
       Endif 
     Else
*       act(e:fac, 'Fecha Vto. Menor')  
     Endif  
  Endif
 
  If Val(tb:fac)=1
* FJL 16/04/25 - Issue EXTBIND-8151 - Actualizaba cotizaciones de OCT
*     If SQL("select 1 from "~DBO~".COTIZACIONESFUT where Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and FechaFut="~IdxDate2(val(fv:fac))~" and CallPut='FUT' ")=0
     If SQL("select 1 from "~DBO~".COTIZACIONESFUT where Mercado='"~Var('MERROFEX')~"' and Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and FechaFut="~IdxDate2(val(fv:fac))~" and CallPut='FUT' ")=0
        Message('Generando cotizaciones...')
        SQL.ADD(" Insert into "~DBO~".COTIZACIONESFUT ")
        SQL.ADD("  (Fecha, CallPut, Codigo, Precio1, FechaFut, ")
        SQL.ADD("   Moneda, Mercado, PrecioEj, FechaUltAct, UsuarioUltAct) ")
        SQL.ADD("Values ("~IdxDate2(Dialogo.Fecha1)~",'FUT','"~Val(e:fac)~"',"~Fstr(fbn['Ajuste'],0,9)~","~IdxDate2(val(fv:fac))~", ")
        SQL.ADD("        '"~VAR('MONELOCA')~"','"~Var('MERROFEX')~"',"~Fstr(0,0,0)~","~SQLAhora~",'"~UsuarioActivo~"') ")
        SQL.NEW
     Else
        Message('Actualizando cotizaciones...')
        SQL.ADD("Update "~DBO~".COTIZACIONESFUT ")
        SQL.ADD("   Set Precio1="~Fstr(fbn['Ajuste'],0,9)~", ")
        SQL.ADD("       FechaUltAct= "~SQLAhora~", ")
        SQL.ADD("       UsuarioUltAct='"~UsuarioActivo~"' ")
* FJL 16/04/25 - Issue EXTBIND-8151 - Actualizaba cotizaciones de OCT
*        SQL.ADD(" where Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and FechaFut="~IdxDate2(val(fv:fac))~" and CallPut='FUT' ")
        SQL.ADD(" where Mercado='"~Var('MERROFEX')~"' and Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and FechaFut="~IdxDate2(val(fv:fac))~" and CallPut='FUT' ")
        SQL.NEW
     Endif
     
     scn(z:1,1)

     Message('Procesado COTIZACIONESROFEX...')     
     SQL.ADD("Update "~DBO~".COTIZACIONESROFEX ")
     SQL.ADD("   Set Procesado='1' ")
     SQL.ADD(" where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Posicion='"~Val(b:fac)~"' ")
     SQL.NEW     
     SQL.EXEC
     
  Endif
  FormatoCeldas(c:fac,Exe('F8'))
  AlinearCeldas(a:fac..b:fac,'C')
  AlinearCeldas(d:fac..e:fac,'C')
  SetFont(a:fac..e:fac,2)

Proximo

If Val(z:1)>0

   ** Grabo el registro en FLAGSMERCADO
   If 0=Sql("Select 1 From "~DBO~".FLAGSMERCADO  Where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Registro='COT' ")
      SQL.ADD(" Insert into "~DBO~".FLAGSMERCADO ")
      SQL.ADD(" (Fecha, Registro, Cantidad, HoraMercado, Estado,FechaMercado,Mercado) Values  ")
      SQL.ADD(" ("~IdxDate2(Dialogo.Fecha1)~",'COT', "~Fstr(Val(z:1),0,0)~", '"~Copy(Hora(Ahora),1,2)~Copy(Hora(Ahora),4,2)~Copy(Hora(Ahora),7,2)~"', ")
      SQL.ADD("  'PRO',"~Copy(IdxDate2(Fsys),3,2)~Copy(IdxDate2(Fsys),6,2)~Copy(IdxDate2(Fsys),9,2)~",'"~Var('MERROFEX')~"' ) ")
   Else
      SQL.ADD("Update "~DBO~".FLAGSMERCADO Set Estado='PRO', Cantidad= "~Fstr(Val(z:1),0,0) )
      SQL.ADD(" Where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Registro='COT' ")
   Endif
   SQL.NEW
   SQL.EXEC

   *     MessageBox('El proceso de cotizaciones finalizo correctamente!!!') 
Else
   *  MessageBox('No existen cotizaciones para procesar!!!') 
Endif

SetFilaActual(fac+2)
act(a:fac,'Fin listado')
SetFont(a:fac,1)

ACO(1,10)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,6)
ACO(7,1)

LimitesVision(g:fac+2)


