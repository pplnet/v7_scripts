**-- INMETE Calculo de Interes Minuta Mensual Terceros
**-- HojaVisible(SI)
CrearDialogo
  Fecha1     : 'FechaOp'      ;;;;;;NOVACIO(Dialogo.Fecha1);'Debe Ingresar la Fecha';NO;Fsys
  Precio1    : 'Tasa'         ;;;;NO;NO;;;;0;;
  Lista1     : 'Vehiculos'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not Ok
  Cancelar
endif

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

* Obtengo Todos los Pares de Vehiculos
SQL.ADD("SELECT * from "~DBO~".OPERACIONES O")
SQL.ADD("where  O.TipoOp='TEMINM' and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Val(zz6))
   SQL.ADD("       and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")    
EndIf
SQL.ADD("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

Recorrer SQL

   Message('Procesando Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Cliente1']~' Especie:'~FBN['Especie']~' ...')

   * Divisor del par de Vehiculos
   ACN(Z11,IIF(EqStr('360',SQL("SELECT Divisor from "~DBO~".IMPTERCEROS where Vehiculo='"~FBN['Vehiculo1']~"' and Cliente='"~FBN['Cliente1']~"' ")),360,365))
   ACN(Z12,SQL("SELECT Tasa from "~DBO~".TASASTERCEROS where Vehiculo='"~FBN['Vehiculo1']~"' and Cliente='"~FBN['Cliente1']~"' and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))

   IF VAL(Z12)=0 
      MessageBox("Debe Ingresar la Tasa para "~FBN['Vehiculo1']~"/"~FBN['Cliente1']~"-"~FBN['Especie']~" "~Dialogo.Fecha1~" ...")
   Else
      *-- z6: Interes  Z7: MB3 Z8: Nro. Operacion Referencia Z9: MB3 de la Vinculada
      *-- Z7: MB3
      ACT(Z7,FBN['MB3'])

      * AB6: Caso
      ACN(AB6,FBN['RB6'])

      ACN(Z6,VAL(Z12)*FBN['TotalBrutoCli1']*FBN['Plazo']/(100*VAL(Z11)) )

      Message('Calculando los Impuestos para Operacion Directa ')
   
      ACT(AV1,FBN['Vehiculo1'])
      ACT(AV2,FBN['Cliente1'])
 
      * Determina los Impuestos de Vinculadas
      * Y5 : Imp.Ret.IVA  Y6 : Alicuota de IVA  Y12: Alicuota Percepcion  Y13: Importe  de Percepcion
      * Y16: IvaNeto  Y17: MontoCapitalizable Y19:TTN
      * I1: Tasa Impuesto Extr I2: Importe de Impuesto Ext
      * W1: Tasa WH  W2: Importe de WH Directa  

      (.'IMPVINTER'.)

      *** Recupero los Impuestos de Directo el Inverso

      Message('Actualizando Minuta Mensual .... ')          
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set Precio1="~Fstr(VAL(Z12),10,5)~", ")
      SQL.ADD(" Precio4="~Fstr(VAL(Y19),0,5)~", ")
      SQL.ADD(" Precio2="~Fstr(VAL(Y15),0,5)~", ")
      SQL.ADD(" TotalIntereses="~Fstr(VAL(Z6),0,5)~",")
      SQL.ADD(" TotalAux1= "~Fstr(VAL(W1),0,5)~", ")
      SQL.ADD(" RB8 = '"~IIF(VAL(Z11)=360,"0","1")~"' ")
      SQL.ADD(" WHERE NrOperacion='"~FBN['NrOperacion']~"' ")
      SQL.NEW 
      SQL.EXEC

      *** Actualiza movimientos y limites ****
      SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
      SQL.EXEC
   EndIf
Proximo
 

