Sqladd(" O.Especie, O.ContraEspecie, O.FechaOp, O.RB8, O.RB6, O.TasaImp1, C.Total4, ")
Sqladd(" C.Tasa2, C.Cantidad6, O.ImpGastos2, O.NrOperacion3, O.TipoOp ")
