creardialogo
fecha1:'Fecha Op D';1;1;;;;;;;FSys() - 365;
fecha2:'Fecha Op H';1;2;;;;;;;FSys();
fecha3:'Fecha Vto D';2;1;;;;;;;FSys();
fecha4:'Fecha Vto H';2;2;;;;;;;FSys() + 365;
especie1: 'Moneda Liquidacion';;1;;;;;;;;;;;;
nroperacion1: 'Operacion';;;;;;;;;;;;;;" Tipoop in('FXCF','FXVF') and MercadoRB='1' "
findialogo

if (not ok)
Cancelar()
endif

Act(ls:1, Var('MONNDF'))

Sqladd("SELECT O.NrOperacion, O.Cliente1, Especie, O.ContraEspecie, O.ContraEspecie2, O.FechaOp, O.FechaVto, O.FechaVto2, O.TasaEspecie, O.FechaUltCupon, O.Book1, ")
Sqladd("       O.Arancel4, O.Arancel3, O.FechaAltaSisExterno, O.MercadoRB, O.Mercado4, O.EsCaucionado EsHabil, TipoTasa, O.Sector1, O.Sector2, M.Regulado, O.Book2, ")
Sqladd("       O.Plazo2, O.TablaFeriados1 ")
Sqladd("  FROM "~Dbo()~".OPERACIONES O, "~Dbo()~".MERCADOS M ")
Sqladd(" WHERE Tipoop in('FXCF','FXVF')")
Sqladd("   AND O.Mercado4=M.Codigo ")
if (NoVacio(dialogo.nroperacion1))
Sqladd("   AND NrOperacion='"~dialogo.nroperacion1~"'")
else
Sqladd("   AND (O.FechaOp>="~IdxDate2(dialogo.fecha1)~" and O.FechaOp<="~IdxDate2(dialogo.fecha2)~")  ")
Sqladd("   AND (O.FechaVto>="~IdxDate2(dialogo.fecha3)~" and O.FechaVto<="~IdxDate2(dialogo.fecha4)~")  ")
if (NoVacio(dialogo.especie1))
Sqladd("   AND TasaEspecie='"~dialogo.especie1~"'")
endif
endif
Sqladd(" and MercadoRB='1' ")
Sqladd(" ORDER BY Mercado4, FechaVto, NrOperacion ")

Acn(ca:1, 0)

recorrer sql
Acn(a:fac, 0)
Act(b:fac, Fbn()['NrOperacion'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Especie'])
Act(e:fac, Fbn()['ContraEspecie'])
Act(z:fac, Fbn()['ContraEspecie2'])
Act(f:fac, Fbn()['FechaOp'])
Acd(g:fac, Fbn()['FechaVto'])
Act(h:fac, Fbn()['TasaEspecie'])
Act(i:fac, Fbn()['Mercado4'])
Act(o:fac, Fbn()['Book1'])
Act(m:fac, Fbn()['Regulado'])
Acn(p:fac, Fbn()['FechaAltaSisExterno'] - Fbn()['FechaOp'])
Acd(w:fac, Fbn()['FechaVto2'])
Acn(x:fac, DifDias(Fbn()['FechaAltaSisExterno'], Fbn()['FechaUltCupon'], 'USA', iif (Fbn()['Eshabil'] = 1, SI, NO)))
Acd(ag:fac, Fbn()['FechaVto'])
Acn(ah:fac, buscarlista(Fbn()['TasaEspecie'], Val(ls1)) - 1)
Acd(bg:fac, Fbn()['FechaAltaSisExterno'])
Act(bh:fac, Fbn()['Arancel4'])
Act(bz:fac, Fbn()['Arancel3'])
Act(bi:fac, Fbn()['TipoTasa'])
Act(bj:fac, Fbn()['Sector1'])
Act(bk:fac, Fbn()['Sector2'])
Act(bo:fac, Fbn()['Book2'])
Acd(bl:fac, Fbn()['FechaUltCupon'])

Acd(ap:fac, Habiles(Fbn()['FechaAltaSisExterno'], (Fbn()['Plazo2'] div 24), Fbn()['TablaFeriados1'], SI))
Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';'Autorizacion Modificacion Futuros'
'Accion ?';a:1..a:fac;SI;;;40;combo;'Autoriza|Rechaza'
'Operacion';b:1..b:fac;NO;;;70;string;;
'Cliente';c:1..c:fac;NO;;;70;string;;
'Especie';d:1..d:fac;NO;;;70;string;;
'ContraEspecie';e:1..e:fac;NO;;;70;string;;
'Especie Fix';e:1..e:fac;NO;;;70;string;;
'Mercado';i:1..i:fac;NO;;;70;string;;
'Book';o:1..o:fac;NO;;;60;string;;
'Fecha Op';f:1..f:fac;NO;;;80;string;;
'Fecha Vto Original';g:1..g:fac;NO;;;80;fecha;
'Fecha FIX Original';w:1..w:fac;NO;;;80;fecha;
'Mon. Liq. Original';h:1..h:fac;NO;;;100;string;;
'Pend. F.V.';bg:1..bg:fac;NO;;;100;fecha;RGB(180, 170, 193)
'Pend. Esp. Fix.';bz:1..bz:fac;NO;;;100;string;;RGB(180, 170, 193)
'Pend. Mon. Liq.';bh:1..bh:fac;NO;;;100;string;;RGB(180, 170, 193)
'Pend. Mercado ';bi:1..bi:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Book ';bo:1..bo:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Cta CLI';bj:1..bj:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. Cta VEH';bk:1..bk:fac;NO;;;90;string;;RGB(180, 170, 193)
'Pend. F.Fix';bl:1..bl:fac;NO;;;80;fecha;RGB(180, 170, 193)
finlistbox
if (not ok)
Cancelar()
endif

if (ok)
recorrer&i 1, Fac()
if (Val(a:&i) = 0)
Sqladd("UPDATE "~Dbo()~".OPERACIONES ")
Sqladd("  Set  FechaVto            = FechaAltaSisExterno, ")
Sqladd("       FechaPago           = FechaAltaSisExterno, ")
Sqladd("       FechaVto2           = FechaUltCupon, ")
Sqladd("       Plazo               = "~Val(p:&i)~", ")
Sqladd("       Lotes               = "~Val(x:&i)~", ")
Sqladd("       FechaPrecan         = "~IdxDate2(Val(ap:&i))~", ")
Sqladd("       FechaAltaSisExterno = null, ")
Sqladd("       FechaUltCupon       = null, ")
if (not Eqstr(Val(m:&i), 'SI'))
Sqladd("     TasaEspecie    = Arancel4, ")
Sqladd("     ContraEspecie2 = Arancel3, ")
Sqladd("     Mercado2       = '"~Val(bi:&i)~"', ")
Sqladd("     Book1          = '"~Val(bo:&i)~"', ")
Sqladd("     Cuenta4        = '"~Val(bj:&i)~"', ")
Sqladd("     Cuenta3        = '"~Val(bk:&i)~"', ")
Sqladd("     Arancel4       = null, ")
Sqladd("     Arancel3       = null, ")
Sqladd("     TipoTasa       = null, ")
Sqladd("     Book2          = null, ")
Sqladd("     Sector1        = null, ")
Sqladd("     Sector2        = null, ")
endif
Sqladd("       MercadoRB    = '0' ")
Sqladd(" WHERE NrOperacion  = '"~Val(b:&i)~"'  ")
Sqlnew()
Sqlexec()
SqlActualizarmovimientos3(Val(b:&i), NO, SI, NO, SI, SI)
Sqlexec()
else
Sqladd("UPDATE "~Dbo()~".OPERACIONES ")
Sqladd("   SET FechaAltaSisExterno = null, ")
Sqladd("       FechaUltCupon       = null, ")
Sqladd("       Arancel4            = null, ")
Sqladd("       Arancel3            = null, ")
Sqladd("       TipoTasa            = null, ")
Sqladd("       Book2               = null, ")
Sqladd("       Sector1             = null, ")
Sqladd("       Sector2             = null, ")
Sqladd("       MercadoRB           = '0' ")
Sqladd(" WHERE NrOperacion         = '"~Val(b:&i)~"'  ")
Sqlnew()
Sqlexec()
endif
proximo
Messagebox('Fin autorizacion modificacion futuros')
endif
else
Messagebox('No se encontraron operaciones para autorizar modificaciones')
endif

