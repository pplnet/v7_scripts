Sqladd("SELECT O.*, C.RazonSocial, C.Direccion as Address, C.CodigoPostal, C.Localidad, C.Codigo, C.CondicionIVA, C.CUIT, C.CodComitente ")
Sqladd(", C.Calle, C.Altura, C.Piso, C.Depto ")

Sqladd("FROM   "~Dbo()~".OPERACIONES O,"~Dbo()~".CLIENTES C ")
Sqladd("WHERE  O.NrOperacion  = '"~dialogo.nroperacion1~"'")
Sqladd("       and O.Cliente1 = C.Codigo  ")




recorrer sql
SetFilaActual(13)
Act(a:fac, Fbn('RazonSocial'))

if (Vacio(Fbn('Address')))
Act(a:fac + 1, Fbn('Calle')~" "~Fbn('Altura')~" "~Fbn('Piso')~" "~Fbn('Depto'))
else
Act(a:fac + 1, Fbn('Address'))
endif

Act(a:fac + 2, Fbn('CodigoPostal')~' - '~Fbn('Localidad'))
let(&condiva, Fbn('CondicionIVA'))
let(&textoiva, 'IVA: Responsable Inscripto')
if (Eqstr(&condiva, 'NO5'))
let(&textoiva, 'IVA: No inscripto Adic 50%')
endif
if (Eqstr(&condiva, 'NOI'))
let(&textoiva, 'IVA: No Inscripto')
endif
if (Eqstr(&condiva, 'EXE'))
let(&textoiva, 'IVA: Exento')
endif
if (Eqstr(&condiva, 'GRA'))
let(&textoiva, 'IVA: Gran Consumidor')
endif
if (Eqstr(&condiva, 'FIN'))
let(&textoiva, 'IVA: Consumidor Final')
endif
if (Eqstr(&condiva, 'MON'))
let(&textoiva, 'IVA: Monotibutista')
endif
if (Eqstr(&condiva, 'NOC'))
let(&textoiva, 'IVA: No Categorizado')
endif
if (Eqstr(&condiva, 'OTR'))
let(&textoiva, 'IVA: Otro')
endif
Act(a:fac + 3, &textoiva)
if (NoVacio(Fbn('CUIT')) y not Eqstr(Fbn('CUIT'), '000000000000000'))
if (Eqstr(Copy(Fbn('CUIT'), 1, 4), '0000'))
Act(zb:10, Copy(Fbn('CUIT'), 5, 11))
else
if ((Eqstr(Copy(Fbn('CUIT'), 3, 1), '-')) y (Eqstr(Copy(Fbn('CUIT'), 12, 1), '-')))
Act(zb:10, Copy(Fbn('CUIT'), 1, 13))
Act(zb:11, Copy(Fbn('CUIT'), 1, 13))
else
Act(zb:10, Copy(Fbn('CUIT'), 1, 11))
Act(zb:11, Copy(Fbn('CUIT'), 1, 2)~'-'~Copy(Fbn('CUIT'), 3, 8)~'-'~Copy(Fbn('CUIT'), 11, 1))
endif
endif
let(&cuit, Val(zb:10))
else
Act(zb:10, '')
let(&cuit, Fbn()['Cliente1'])
endif
Act(a:fac + 4, 'CUIT: '~&cuit)





Act(a:fac + 5, 'Comitente: '~Fbn('CodComitente'))

Act(d:fac + 1, 'Comprobante')
