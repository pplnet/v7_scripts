creardialogo
nrorden1: 'Nro.Orden';1;1;;;;;;;;
check1:'Procesa';;1;;SI;SI;;;;0;
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

Act(a:1, 'NrOrden')
Act(a:2, 'TipoOrden')
Act(a:3, 'Cliente')
Act(a:4, 'Cuenta1')
Act(a:5, 'Cuenta4')
Act(a:6, 'Cuenta5')
Act(a:7, 'Especie')
Act(a:8, 'CantidadTotalOrden')
Act(a:9, 'ContraEspecie')
Act(a:10, 'CantidadEnProceso')
Act(a:11, 'TotalAux1')
Act(a:13, 'Mercado')
Act(a:14, 'AfectaLS')
Act(a:15, 'MB2')
Act(a:16, 'Leyenda3')
Act(a:20, 'Bloquea')
Act(a:21, 'Pone Ley3')
Act(a:22, 'Num 900')
SetFont(a:1..a:25, 2)

Sqladd("Select * From "~Dbo()~".ORDENES Where NrOrden='"~dialogo.nrorden1~"' ")
recorrer sql
Scn(x:1, 1)
Act(b:1, Fbn('NrOrden'))
Act(b:2, Fbn('TipoOrden'))
Act(b:3, Fbn('Cliente'))
Act(b:4, Fbn('Cuenta1'))
Act(b:5, Fbn('Cuenta4'))
Act(b:6, Fbn('Cuenta5'))
Act(b:7, Fbn('Especie'))
Acn(b:8, Fbn('CantidadTotalOrden'))
Act(b:9, Fbn('ContraEspecie'))
Acn(b:10, Fbn('CantidadEnProceso'))
Acn(b:11, Fbn('TotalAux1'))
Act(b:13, Fbn('Mercado2'))
Act(b:14, Fbn('AfectaLS'))
Acn(b:15, Fbn('MB2'))
Act(b:16, Fbn('Leyenda3'))
proximo

if (Val(x:1) = 0)
if (dialogo.check1 = 0)
Messagebox('INGRBO '~dialogo.nrorden1~' no encontrada.')
else
Cancelar()
endif
else
if (Eqstr(Val(b:2), 'OTIC') y Eqstr(Val(b:13), Var('MERCADOBT')) y Eqstr(Val(b:14), 'Saldos') y Val(b:15) = 1)
Act(b:20, 'SI')
else
Act(b:20, 'NO')
endif
if (Eqstr(Val(b:20), 'SI'))
Act(b:21, 'ERROR')

if (Eqstr(Val(b:21), 'OK'))
if (dialogo.check1 = 1)
Act(b:22, getnumerador(900))
Sqladd("UPDATE "~Dbo()~".ORDENES ")
Sqladd("  SET Leyenda3 = '"~Val(b:22)~"' ")
Sqladd("Where NrOrden  = '"~Val(b:1)~"' ")
Sqlnew()
Sqlexec()
else
Messagebox('Pone Leyenda3 de orden '~Val(b:1)~'.')
endif
endif
endif

SetFont(b:1..b:25, 1)
FormatoCeldas(b:8..b:11, Exe('F2'))
FormatoCeldas(b:15..b:15, Exe('F0'))
endif

ACO(1, 15)
ACO(2, 15)


