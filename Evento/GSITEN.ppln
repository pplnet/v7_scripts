Sqladd(" Select *, case when ComitenteAux Is null then case when Nrcuenta = '' then ElCUIT else Nrcuenta end else ComitenteAux end Codcomitente from ")
else 
Sqladd(" Select *, ComitenteAux CodComitente from ")
endif
Sqladd(" (SELECT O.NrOperacion,Case When (PaseCB= 1 and (E.Jerarquia LIKE '"~Var('JERLEBACS')~"%' or E.Issuer = '"~Var('CLIBCRA')~"')) Then '99' When PaseCB= 1 Then '09' Else '01' End  Pase, ")
Sqladd(" CASE WHEN (Cliente1 <> '"~dialogo.vehiculo1~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then O.TotalNetoCli1*-1  else O.TotalNetoCli1 end ")
Sqladd("      WHEN (Cliente1 <> '"~dialogo.vehiculo1~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then O.TotalNetoCli1  else O.TotalNetoCli1*-1 end  ELSE ")
Sqladd(" Case when Cliente1 = '"~dialogo.vehiculo1~"' then (case when TipoOp in ('TIC','TCOPRI','TIFC') Then O.TotalNetoCli1 else O.TotalNetoCli1*-1 end) else (case when TipoOp in ('TIC','TCOPRI','TIFC') then O.TotalNetoCli1 else O.TotalNetoCli1*-1 end) end  END Monto, ")
Sqladd(" CASE WHEN (TipoOp in ('TIC','TCOPRI','TIFV') and PaseCB=1) THEN '1' WHEN (TipoOp in ('TIV','TIFC') and PaseCB=1) THEN '0'  ELSE '9' END Posicion, ")
Sqladd(" CASE WHEN TipoOp in ('TIC','TIV') THEN '0'  ELSE '1' END Plazo, ")
Sqladd(" CASE WHEN (Cliente1 <> '"~dialogo.vehiculo1~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then 2  else 1 end ELSE Case when TipoOp in ('TIC','TIFC','TCOPRI') then 1 else 2 end END TipoCV, ")
Sqladd("     O.FechaVto, O.Especie, O.ContraEspecie, ")
Sqladd(" Case When E.Jerarquia LIKE '"~Var('JERONESP')~"%' Then '06' When E.Jerarquia LIKE '"~Var('JERFIDESP')~"%' Then '05' When E.Jerarquia LIKE '"~Var('JERFONESP')~"%' Then '04' When E.Jerarquia LIKE '"~Var('JERACCION')~"%' Then '02' When E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' Then '01' Else '11' End TipoOPX, PaseCB, E.Issuer, E.MonedaEmision,")
Sqladd(" CASE WHEN O.ContraEspecie in ('ARP') THEN '001'  When O.ContraEspecie in ('USD') then '004' When O.ContraEspecie in ('EUR') then '006' When O.ContraEspecie in ('BRL') then '040' else '000' END Moneda,TipoOp, ")
Sqladd(" CASE WHEN (E.Indexado = 'NO' and E.MonedaEmision in ('"~Var('MONELOCA')~"')) THEN 1 WHEN (E.Indexado = 'SI' and E.MonedaEmision in ('"~Var('MONELOCA')~"')) THEN 2 ELSE 3 END Emision, C.Alias10 NIF, ")
Sqladd("  1  Exencion, C.Calle, C.Altura, C.Piso, C.Depto, C.RazonSocial,IsNull(C.NrCuenta,'') Nrcuenta,O.Cuenta1,")
if (Isdefined("MLASA"))
Sqladd("  C.Direccion, C.Localidad,C.CategDepositante , P.AliasDGI Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
Sqladd(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONCLI')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")
else 
Sqladd("  C.Direccion, C.Localidad,C.CategDepositante , P.AliasAFIP Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
Sqladd(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")
endif
Sqladd(" C.Persona, C.TipoInscripcion, C.Pais Pais, C.TipoDocum, C.NrDocum,C.CodComitente as ComitenteCli, C.Alias9 Puerta, PA.Alias PaisAFIP,O.Cliente1, C.CUIT ElCUIT,")
if (Isdefined("MLASA"))
Sqladd(" C.CUIT, C.CodComitente ComitenteAux")
else 
Sqladd("  Case When C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE C.CUIT END END CUIT, ")
if (Isdefined("BACS"))
Sqladd(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~dialogo.vehiculo1~"' then (select CodComitente from CLIENTES where Codigo ='"~dialogo.vehiculo1~"') else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end ComitenteAux ")
else 

Sqladd(" Case when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~dialogo.vehiculo1~"' ) Then (select NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1)  ")
Sqladd(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~dialogo.vehiculo1~"' ) then Nrcuenta ")
Sqladd(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~dialogo.vehiculo1~"') then (select Top(1) CT.NrDepositante from dbo.CUENTAS CT Where CT.Cliente = O.Cliente1 and TipoCuenta = 'CUS' and NrDepositante is not Null) else Nrcuenta  end ComitenteAux ")
endif
endif
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("       Left JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
Sqladd("       Left JOIN "~Dbo()~".PROVINCIAS P WITH (NOLOCK) ON C.Provincia=P.Codigo ")
