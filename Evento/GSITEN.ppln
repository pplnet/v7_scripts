Sqladd("O.Cliente Cliente, Persona ")
Sqladd("FROM  "~Dbo()~".MOVEJECUTADOS O ")
Sqladd("       Left JOIN dbo.TRANSACCIONES2 T  on O.NrOperacion=T.NrTrans ")
Sqladd("       Left JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  O.Cliente=C.Codigo ")
Sqladd("       ,"~Dbo()~".ESPECIES E, "~Dbo()~".ESPECIES ET ")
Sqladd("where O.Especie    =  E.Codigo  ")
