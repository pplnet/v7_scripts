Sqladd(" Select sum(ABS(CPA)) UmbralCPA, sum(ABS(VTA)) UmbralVTA,Persona, Cliente1 from ")
Sqladd(" (SELECT O.TotalNetoCli1 CPA, 0 VTA, C.Persona,Cliente1 FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("       Left JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
Sqladd("    , "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".ESPECIES E ")
Sqladd("where O.NrOperacion=B.NrOperacion  ")
Sqladd("  and O.Especie    =  E.Codigo  ")
Sqladd("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
Sqladd("  and O.Vehiculo1  =  '"~dialogo.vehiculo1~"' ")
