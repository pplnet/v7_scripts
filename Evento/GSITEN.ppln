Sqladd(" Select TipoMov, Cliente, SUM(MontoARP) Umbral,Persona  from  ")
Sqladd(" (SELECT CASE WHEN TipoOp in ('TIC','TIFC') THEN '0'  ELSE '1' END TipoMov, ")
Sqladd("  CASE WHEN O.ContraEspecie in ('ARP') THEN O.TotalNetoCli1 else (Select Top(1) PrecioContable*O.TotalNetoCli1 From "~Dbo()~".COTIZACIONES C Where Codigo = O.ContraEspecie and Moneda = '"~Var('MONELOCA')~"' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc) END MontoARP, ")
Sqladd(" O.Cliente1 Cliente, C.Persona ")
Sqladd("FROM   "~Dbo()~".OPERACIONES O ")
Sqladd("       Left JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
Sqladd("       , "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".ESPECIES E ")
Sqladd("where O.NrOperacion=B.NrOperacion  ")
Sqladd("  and O.Especie    =  E.Codigo  ")
Sqladd("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
Sqladd("  and O.Vehiculo1  =  '"~dialogo.vehiculo1~"' ")
Sqladd("  and B.NrBit=30 and B.Valor='0'  ")
Sqladd("  and O.FechaVto between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd("  and O.TipoOp In ('TIC','TIFC','TIV','TIFV','TCOPRI')  ")
Sqladd("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
Sqladd("  and PaseCB <> 1  ")
Sqladd("UNION")
Sqladd(" SELECT  '2' TipoMov, ")
Sqladd("  CASE WHEN O.ContraEspecie in ('ARP') THEN (Select Top(1) PrecioContable*O.TotalIntereses From "~Dbo()~".COTIZACIONES C Where Codigo = O.Especie and Moneda = '"~Var('MONELOCA')~"' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc) ")
Sqladd("       else (Select Top(1) PrecioContable*O.TotalIntereses From "~Dbo()~".COTIZACIONES C Where Codigo = O.Especie and Moneda = O.ContraEspecie AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc) END MontoARP, ")
Sqladd(" O.Cliente1 Cliente, C.Persona ")
