Sqladd("SELECT  '3' TipoMov,C.DeposDelComitente, ")
if (Isdefined("BACS"))
Sqladd(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) <> '"~dialogo.vehiculo1~"' then (select CodComitente from CLIENTES where Codigo ='"~dialogo.vehiculo1~"') else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) end ComitenteAux, ")
else 
Sqladd(" Case when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) = O.Cliente and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) = '"~dialogo.vehiculo1~"' ) Then (select NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta)  ")
Sqladd(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) = O.Cliente and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) <> '"~dialogo.vehiculo1~"' ) then Nrcuenta ")
Sqladd(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta) = '"~dialogo.vehiculo1~"') then (select Top(1) CT.NrDepositante from dbo.CUENTAS CT Where CT.Cliente = O.Cliente and TipoCuenta = 'CUS' and NrDepositante is not Null) else Nrcuenta  end ComitenteAux, ")
endif
Sqladd("CASE WHEN T.Especie1 in ('ARP') THEN '001'  When T.Especie1 in ('USD') then '004' When T.Especie1 in ('EUR') then '006' When T.Especie2 in ('BRL') then '040' else '000' END  Moneda, ")
Sqladd("CAse when T.especie1 in ('ARP') THEN 1 else (Select Top(1) Precio1 From dbo.COTIZACIONES C Where Codigo = T.Especie1 AND Moneda ='"~Var('MONELOCA')~"' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc) END as Precio, ")
Sqladd("Cantidad, O.Cantidad  as Monto,   ")
Sqladd("T.Especie, ET.CodNumCajaValores,ET.Nombre, IsNull(C.Nrcuenta,'') Nrcuenta, O.Cliente Cliente,C.CUIT ")
Sqladd("FROM  "~Dbo()~".MOVEJECUTADOS O ")
Sqladd("       Left JOIN dbo.TRANSACCIONES2 T  on O.NrOperacion=T.NrTrans ")
Sqladd("       Left JOIN "~Dbo()~".CLIENTES C WITH (NOLOCK) ON  O.Cliente=C.Codigo ")
Sqladd("       ,"~Dbo()~".ESPECIES E, "~Dbo()~".ESPECIES ET ")
Sqladd("where O.Especie    =  E.Codigo  ")
Sqladd("  and T.Especie    =  ET.Codigo ")
Sqladd("  and E.Tipo    <> 'TBL'  ")
Sqladd("  and T.TipoTr2    =  'LCUPON' ")
Sqladd("    and O.FechaMov between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha2)~"' ")
Sqladd("  and NrSaldo = 1   ")
Sqladd("  and E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
Sqladd("  and Leyenda like 'liq. Amort%'    ")
Sqladd("  ) as Aux ")
Sqladd("   ) as Aux1 ")
Sqladd("   ) as Aux2 ")
if (Fecha(dialogo.fecha1, 'YYYYMMDD') > Var('SITERANT'))
if (not Vacio(dialogo.cliente1))
Sqladd("  where Cliente = '"~dialogo.cliente1~"' ")
else 
if (Isdefined("BIND"))
Sqladd("  where Cliente in ("~Pipe2Comillas(Val(eb:3))~") and Cliente <> '"~dialogo.vehiculo1~"' ")
else 
Sqladd("  where Cliente in ("~Pipe2Comillas(Val(eb:3))~")  ")
endif
endif
else 
if (not Vacio(dialogo.cliente1))
