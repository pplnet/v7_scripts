Sqladd("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
Sqladd("UNION")
Sqladd(" Select TipoMov, Case when Moneda = '001' then Monto Else Monto*Precio End  MontoARP, ")
Sqladd("    Cliente, Persona  from   ")
Sqladd("(SELECT  '4' TipoMov, ")
Sqladd("CASE WHEN T.Especie1 in ('ARP') THEN '001'  When T.Especie1 in ('USD') then '004' When T.Especie1 in ('EUR') then '006' When T.Especie1 in ('BRL') then '040' else '000' END  Moneda, ")
Sqladd("CAse when T.especie1 in ('ARP') THEN 1 else (Select Top(1) Precio1 From dbo.COTIZACIONES C Where Codigo = T.Especie AND Moneda ='"~Var('MONELOCA')~"' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc) END as Precio, ")
