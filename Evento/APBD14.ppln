fecha1: ' ';1;2;;dialogo.radio1 = 0;dialogo.radio1 = 0;;;;;FSys()
vehiculo1: 'Vehiculo';2;1;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO', 'Vehiculo', 'Codigo', UsuarioActivo());;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
radio2: 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos';3;1;;;;;;;4
check1: 'Incluye Pagadoras';4;1;;;;;;;1
label1: '';5;1;;;;;;;'__________________________________________________________________________________________'
lista1: 'Bancos';6;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CLIENTES WHERE Sector='BAN' ");
lista2: 'Cuentas';0;2;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".CUENTAS  WHERE Cliente = '"~dialogo.vehiculo1~"' AND Comitente IN ("~pipe2comillas(dialogo.lista1)~")"~iif (dialogo.check1 = 0, " AND (Pagadora <>'SI' OR Pagadora IS NULL)"));
lista3: 'Archivo';;1;;;;;;;;;Val(ll: 1)
lista4: 'NrDatanet';-5;2;;;;;;;;;SQLSet(" SELECT Distinct D.NrDatanet FROM "~Dbo()~".DATANET D, "~Dbo()~".MOVDATANET M, "~Dbo()~".CUENTAS C WHERE D.NrDatanet = M.NrDatanet AND C.Numero=M.Cuenta AND D.EstadoAprobacion = 'P' AND M.Vehiculo = '"~dialogo.vehiculo1~"' AND C.Codigo IN ("~pipe2comillas(dialogo.lista2)~") AND C.Comitente IN ("~pipe2comillas(dialogo.lista1)~")"~iif (dialogo.check1 = 0, " AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL)"))
findialogo

if (not ok)
Cancelar()
endif

sql.add(" SELECT /*+ RULE */ ")
sql.add(" DISTINCT D.NrDatanet, D.FechaBajada, D.Archivo, M.Banco, M.Cuenta, C.Codigo, ")
sql.add(" C.Comitente, D.Usuario ")
sql.add(" FROM "~Dbo()~".DATANET D, "~Dbo()~".MOVDATANET M, "~Dbo()~".CUENTAS C ")
sql.add(" WHERE D.NrDatanet = M.NrDatanet ")
sql.add(" AND C.Numero      = M.Cuenta    ")
if (dialogo.radio1 = 0)
sql.add(" AND D.FechaBajada    = "~IdxDate2(dialogo.fecha1)~" ")
endif
sql.add(" AND (D.EstadoAprobacion = 'P' OR D.EstadoAprobacion IS NULL) ")
sql.add(" AND M.Vehiculo         = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.lista2))
sql.add(" AND C.Codigo IN ("~pipe2comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista1))
sql.add(" AND C.Comitente IN ("~pipe2comillas(dialogo.lista1)~")  ")
endif
if (NoVacio(dialogo.lista3))
sql.add(" AND D.Archivo IN ("~pipe2comillas(dialogo.lista3)~")  ")
endif
if (dialogo.radio2 = 1)
sql.add(" AND C.TipoCuenta IN ('INT')")
endif
if (dialogo.radio2 = 2)
sql.add(" AND C.TipoCuenta IN ('REC')")
endif
if (dialogo.radio2 = 3)
sql.add(" AND C.TipoCuenta IN ('CA')")
endif
if (dialogo.check1 = 0)
sql.add(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
endif
sql.add(" ORDER By D.NrDatanet ")

Acn(z:1, 0)

recorrer sql
Acn(z:1, 1)
Acn(a:fac, 1)
Act(b:fac, Fbn('NrDatanet'))
Acd(c:fac, Fbn('FechaBajada'))
Act(e:fac, Fbn('Archivo'))
Act(f:fac, Fbn('Banco'))
Act(g:fac, Fbn('Comitente'))
Act(h:fac, Fbn('Cuenta'))
Act(i:fac, Fbn('Codigo'))
Act(j:fac, Fbn('Usuario'))
proximo

