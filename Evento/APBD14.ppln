sql.add(" SELECT /*+ RULE */ M.*, E.Codigo MonedaFPA, C.Codigo CuentaFPA, B.Codigo BancoFPA ")
sql.add(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".CLIENTES B, "~Dbo()~".CUENTAS C, "~Dbo()~".ESPECIES E ")
sql.add(" WHERE  M.Moneda   = E.Alias3 ")
sql.add(" AND    M.Cuenta   = C.Numero ")
sql.add(" AND    (M.Banco = B.Alias2 OR M.Banco = B.Codigo) ")
sql.add(" AND    M.NrDatanet = '"~Val(b:&i)~"' ")
sql.add(" ORDER BY M.NrDatanet, M.NrMovDatanet ")
