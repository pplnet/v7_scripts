CrearDialogo
  NrTrans1: 'Op.CUPON' ;;;;  ;;NoVacio(Dialogo.NrTrans1) y EqStr(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'CUPON');'Transaccion incorrecta';NO
  Check1  : 'Procesa'  ;;;;NO;;;;;1
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

SetFilaActual(1)
ACT(a:FAC, 'Cliente1')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Cupon1')
ACT(g:FAC, 'Fecha1')
ACT(j:FAC, 'Vehiculo')
ACT(k:FAC, 'Precio1')
ACT(l:FAC, 'Precio2')
ACT(m:FAC, 'Precio3')
ACT(n:FAC, 'Esp.Vie.')
ACT(o:FAC, 'Esp.Nue.')
ACT(p:FAC, 'Cupon')
ACT(q:FAC, 'Accion')

ACT(aa:FAC, 'Fecha')
ACT(ab:FAC, 'Especie')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'Cliente')
ACT(ae:FAC, 'Vehiculo')
ACT(af:FAC, 'Book')
ACT(ag:FAC, 'CantidadIni')
ACT(ah:FAC, 'PrecioIni')
ACT(ai:FAC, 'CantidadFin')
ACT(aj:FAC, 'PrecioFin')
ACT(ak:FAC, 'Nr.Saldo')
ACT(al:FAC, '# M.Pen')
ACT(am:FAC, '# M.Eje')

SetFont(a:FAC..am:FAC,2)

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" where NrTrans = '"~Dialogo.NrTrans1~"' ")
recorrer SQL
  ACT(a:2, fbn('Cliente1'))
  ACT(b:2, fbn('Especie'))
  ACN(c:2, fbn('Cupon1'))
  ACD(g:2, fbn('Fecha1'))
  ACT(j:2, fbn('Vehiculo1'))
  ACN(k:2, fbn('Precio1'))
  ACN(l:2, fbn('Precio2'))
  ACN(m:2, fbn('Precio3'))
  ACN(c:3, fbn('Cupon2'))
  ACN(e:3, fbn('Cambio2'))
  ACT(b:4, fbn('Especie2'))
  ACT(Y1, fbn('NrTrans'))
proximo

Message('----- Corte de Posicion Propia')

SetFilaActual(1)
SQL.ADD(" SELECT P.*,E.Cotiza, E.InteresesC, E.TamanioLote, 'Ejecutado' Estado ")
SQL.ADD(" FROM  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE P.Cliente  = '"~Val(a:2)~"' ")
SQL.ADD(" AND   P.Especie  = E.Codigo ")
SQL.ADD(" AND   P.Fecha    <= '"~IdxDate(Val(g2))~"' ")
SQL.ADD(" AND   P.Vehiculo  = '"~Val(j2)~"' ")
SQL.ADD(" AND   P.Especie   = '"~Val(b2)~"' ")
SQL.ADD(" AND   P.Cupon     = "~FStr(Val(c2),1,0)~" ")
SQL.ADD(" AND   P.NrSaldo   >= 120 and P.NrSaldo < 140 ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES X")
SQL.ADD("                 WHERE  X.Cliente = P.Cliente ")
SQL.ADD("                 AND    X.Especie = P.Especie ")
SQL.ADD("                 AND    (X.TipoNegocio=P.TipoNegocio OR (X.TipoNegocio IS NULL AND P.TipoNegocio IS NULL)) ")
SQL.ADD("                 AND    X.Vehiculo     = P.Vehiculo ") 
SQL.ADD("                 AND    X.NrSaldo      = P.NrSaldo  ") 
*SQL.ADD("                 AND    (X.Trader=P.Trader OR (X.Trader IS NULL AND P.Trader IS NULL))  ") 
SQL.ADD("                 AND    X.Cupon        = P.Cupon    ") 
SQL.ADD("                 AND    X.Fecha       < '"~IdxDate(Val(g2))~"') ")
SQL.ADD(" ORDER By E.Cotiza, P.Especie, P.Vehiculo, P.Cliente, P.Book, P.NrSaldo, P.Fecha ")
Recorrer SQL
  Message('Posiciones ')

  ACD(aa:FAC, fbn('Fecha'))
  ACT(ab:FAC, fbn('Especie'))
  ACT(ac:FAC, fbn('Cupon'))
  ACT(ad:FAC, fbn('Cliente'))
  ACT(ae:FAC, fbn('Vehiculo'))
  ACT(af:FAC, fbn('Book'))
  ACN(ag:FAC, fbn('CantidadIni'))
  ACN(ah:FAC, fbn('PrecioIni'))
  ACN(ai:FAC, fbn('CantidadFin'))
  ACN(aj:FAC, fbn('PrecioFin'))
  ACN(ak:FAC, fbn('NrSaldo'))
  ACN(al:FAC, SQL(" Select Count(*) from "~DBO~".MOVPOSPEN where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" "))
  ACN(am:FAC, SQL(" Select Count(*) from "~DBO~".MOVPOSEJE where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" "))

  if fbn('CantidadFin')<>0
    ACN(z1, fbn('CantidadFin'))
    ACN(z2, fbn('PrecioFin'))

    * Precio Final actualizado
    if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b2)),'CLE')
      ACN(z4, (Val(l2)+Val(k2)*Val(z2)+Val(m2))/100)
      ACN(z3, Val(z2))
    else
      ACN(z4, (Val(l2) + (Val(k2) * (Val(z2)-Val(l2)/100-Val(m2)/100)) + Val(m2))/100 )
      ACN(z3,  Val(z2) * (1 - Val(k2)/100) )
    endif 

    * Actualizar movimientos de posicion para la especie vieja
    *------ Posicion del Cliente ----------------*
    ACT(n:2, 'SI')
    if Dialogo.Check1=1

      SQL.ADD(" DELETE "~DBO~".MOVPOSPEN where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" ")
      SQL.NEW
      SQL.ADD(" DELETE "~DBO~".MOVPOSEJE where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" ")
      SQL.NEW
      SQL.EXEC

      SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
      SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
      SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
      SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
      SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
      SQL.ADD("   Book,       Unidad,      Centro, ")
      SQL.ADD("   Sector,     Sucursal,    CallPut,  ")
      SQL.ADD("   Estrategia, Cartera ")
      SQL.ADD(" ) Values ( ")
      * Especie
      SQL.ADD("   '"~Val(b2)~"', ")
      SQL.ADD("   "~Fstr(val(z1)*(-1),1,2)~", ")
      SQL.ADD("   '"~Val(Y1)~"', ")

      SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
      SQL.ADD("   '"~FBN['Cliente']~"', ")
      SQL.ADD("   '"~FBN['Vehiculo']~"', ")

      SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
      * Precio
      SQL.ADD("   "~FStr(Val(z2),1,8)~", ")
      * Cupon
      SQL.ADD("   '"~FStr(Val(c2),1,0)~"', ")

      SQL.ADD("   '1', ")
      SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
      SQL.ADD("   '"~FBN['Trader']~"', ")

      SQL.ADD("   '"~FBN['Book']~"', ")
      SQL.ADD("   '"~FBN['Unidad']~"', ")
      SQL.ADD("   '"~FBN['Centro']~"', ")

      SQL.ADD("   '"~FBN['Sector']~"', ")
      SQL.ADD("   '"~FBN['Sucursal']~"', ")
      SQL.ADD("   '"~FBN['CallPut']~"', ")

      SQL.ADD("   '"~FBN['Estrategia']~"', ")
      SQL.ADD("   '"~FBN['Cartera']~"' ")
      SQL.ADD(" ) ")
      SQL.NEW
    endif

    If Round2(Val(e:3),3)<>0
      * Actualizar movimientos de posicion para la especie nueva
      ACT(o:2, 'SI')
      if Dialogo.Check1=1
        SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
        SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
        SQL.ADD("   Book,       Unidad,      Centro, ")
        SQL.ADD("   Sector,     Sucursal,    CallPut,  ")
        SQL.ADD("   Estrategia, Cartera ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b2)~"', ")
        SQL.ADD("   "~Fstr(val(z1),1,2)~", ")
        SQL.ADD("   '"~Val(Y1)~"', ")

        SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        * Precio
        SQL.ADD("   "~FStr(Val(z3),1,8)~", ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c3),1,0)~"', ")

        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '"~FBN['Book']~"', ")
        SQL.ADD("   '"~FBN['Unidad']~"', ")
        SQL.ADD("   '"~FBN['Centro']~"', ")

        SQL.ADD("   '"~FBN['Sector']~"', ")
        SQL.ADD("   '"~FBN['Sucursal']~"', ")
        SQL.ADD("   '"~FBN['CallPut']~"', ")

        SQL.ADD("   '"~FBN['Estrategia']~"', ")
        SQL.ADD("   '"~FBN['Cartera']~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      Endif
    Endif

    If val(l2)+val(k2)<>0
      * Actualizar movimientos de posicion para el cupon
      ACT(p:2, 'SI')
      if Dialogo.Check1=1
        SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
        SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
        SQL.ADD("   Book,       Unidad,      Centro, ")
        SQL.ADD("   Sector,     Sucursal,    CallPut,  ")
        SQL.ADD("   Estrategia, Cartera ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b4)~"', ")
        SQL.ADD("   "~Fstr(val(z1),1,2)~", ")
        SQL.ADD("   '"~Val(Y1)~"', ")

        SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        * Precio
        SQL.ADD("   "~FStr(Val(z4),1,8)~",  ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c2),1,0)~"', ")

        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '"~FBN['Book']~"', ")
        SQL.ADD("   '"~FBN['Unidad']~"', ")
        SQL.ADD("   '"~FBN['Centro']~"', ")

        SQL.ADD("   '"~FBN['Sector']~"', ")
        SQL.ADD("   '"~FBN['Sucursal']~"', ")
        SQL.ADD("   '"~FBN['CallPut']~"', ")

        SQL.ADD("   '"~FBN['Estrategia']~"', ")
        SQL.ADD("   '"~FBN['Cartera']~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      endif 
    endif 
    if Dialogo.Check1=1
      ACT(q:2, 'Ejecuta')
      SQL.EXEC
    else
      ACT(q:2, 'NO Ejecuta')
    endif 
  endif 
Proximo
SetFont(a:2..q:4,1)
SetFont(y:1..z:4,1)
if FAC>1
  SetFont(aa:2..am:FAC,1)
endif
