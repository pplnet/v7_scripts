Act(x:2, Var("DNLIQUID")~"Reproc-"~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".XLS")

Sqladd(" SELECT /*+ RULE */ T.NrTrans, B.NrBit, T.TipoTr2, ")
Sqladd(" T.Vehiculo1, T.Fecha1, T.Fecha2, T.Especie, T.Cantidad1,  ")
Sqladd(" T.Cliente1, T.Cuenta1, T.Cliente2, T.Cuenta2  ")
Sqladd(" FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".INSTANCIASOP I ")
Sqladd(" WHERE T.NrTrans = B.NrOperacion ")
Sqladd(" AND T.NrTrans = I.NrOperacion ")
Sqladd(" AND I.Fecha = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND T.TipoTr2 IN('DEP','RET') ")
Sqladd(" AND T.Vehiculo1 = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND T.Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND I.NrInstancia = '17' ")
Sqladd(" AND I.Mensaje = 'ZPBD2' ")
Sqladd(" AND B.Valor = 1 ")
recorrer sql
if (Fbn("NrBit") = 18)
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor='0' ")
Sqladd(" WHERE NrBit='18' AND NrOperacion='"~Fbn("NrTrans")~"' ")
Sqlnew()
Sqlexec()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor='1' ")
Sqladd(" WHERE NrBit='17' AND NrOperacion='"~Fbn("NrTrans")~"' ")
Sqlnew()
Sqlexec()
else
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor='0' ")
Sqladd(" WHERE NrBit='3' AND NrOperacion='"~Fbn("NrTrans")~"' ")
Sqlnew()
Sqlexec()
Sqladd(" UPDATE /*+ RULE */ "~Dbo()~".OPERACIONESBITS SET Valor='1' ")
Sqladd(" WHERE NrBit='17' AND NrOperacion='"~Fbn("NrTrans")~"' ")
Sqlnew()
Sqlexec()
endif
