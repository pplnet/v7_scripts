Sqladd(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, V.Valor1, V.Valor2, E.Cotiza Moneda, ")
Sqladd(" C.Codigo Cliente1, '' Observaciones, V.Codigo Vehiculo1 ")
