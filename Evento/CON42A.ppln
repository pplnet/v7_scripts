Sqladd("select DISTINCT O.FechaOp, O.NrOperacion, O.Cantidad, O.Especie, O.Vehiculo1, O.Cliente1, O.TipoOp ")
Sqladd("  from "~Dbo()~".BOPERACIONES O ")
Sqladd("where CONVERT (Char(10), O.FechaDel, 103) = '"~Fecha(dialogo.fecha1, 'DD/MM/YYYY')~"' and TipoOp in ('FCS','FCR')")
Sqladd("  order by O.NrOperacion ")
Acd(f:2, dialogo.fecha1) * -----> Fecha()deeliminaciondelaop.
recorrer sql
