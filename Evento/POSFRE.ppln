Sqladd(" SELECT P.* FROM "~Dbo()~".POSICIONESFUT P ")
Sqladd("  where P.Fecha      <= "~IdxDate2(dialogo.fecha2)~" ")
Sqladd("    AND P.NrSaldo    = 47 ")
Sqladd("    AND P.Fecha IN (SELECT MAX(Fecha) from "~Dbo()~".POSICIONESFUT ")
Sqladd("                   WHERE  Especie  = P.Especie  ")
Sqladd("                   AND    Vehiculo = P.Vehiculo ")
Sqladd("                   AND    NrSaldo  = P.NrSaldo  ")
Sqladd("                   AND    Cliente  = P.Cliente  ")
Sqladd("                   AND    Mercado  = P.Mercado  ")
Sqladd("                   AND    FechaFut = P.FechaFut ")
Sqladd("                   AND    Moneda   = P.Moneda  ")
Sqladd("                   AND    Book     = P.Book     ")
Sqladd("                   AND   (Sector   = P.Sector   OR (Sector   IS NULL AND P.Sector   IS NULL) ) ")
Sqladd("                   AND   (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
Sqladd("                   AND   (Cupon    = P.Cupon    OR (Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
Sqladd("                   AND   (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
Sqladd("                   AND   (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
Sqladd("                   AND   Fecha     <= "~IdxDate2(dialogo.fecha2)~" ")
Sqladd("                  ) ")
Watch(Sqlbatch())

recorrer sql

