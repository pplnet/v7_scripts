Sqladd("       T.Vehiculo1, T.Cuenta1, T.Cuenta2, T.Fecha1, T.Fecha2, T.NrOperacionRef4, T.NrOperacionRef1, T.Cantidad11 ")
Sqladd("from "~Dbo()~".MOVEJECUTADOS M  with (NOLOCK Index = INDME5),"~Dbo()~".TRANSACCIONES2 T,                             ")
Sqladd("     "~Dbo()~".ESPECIES E, "~Dbo()~".CLIENTES C, "~Dbo()~".OPERACIONESBITS OB                                          ")
Sqladd("where ((T.TipoTr2 ='COMP' AND M.NrTrans2 = T.NrTrans) OR (T.TipoTr2 <>'COMP' AND M.NrOperacion = T.NrTrans))     ")
Sqladd("  AND M.Especie=E.Codigo                                                                                         ")
Sqladd("  AND M.Cliente=C.Codigo                                                                                         ")

