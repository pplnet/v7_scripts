CrearDialogo
  Fecha1: 'Fecha' ;;;;;;;;;fsys
FinDialogo

If Not OK 
  Cancelar
Endif


SQL.ADD(" SELECT Codigo, Extension FROM "~DBO~".OBJETOS WHERE Codigo = '"~Fecha(Dialogo.Fecha1)~"' AND Extension LIKE 'IN0001%' ")
SQL.ADD(" ORDER BY 2 ")

ACN(z:1, 0)
Recorrer SQL
   ACN(z:1, 1)
   ACT(Aa:fac, fbn('Codigo'))
   ACT(Ab:fac, fbn('Extension'))
   ACN(Ac:fac, 1)
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron registros.')
Endif

CrearListBox; 'Arial,8,'
 'OK '  ;Ac:1..Ac:fac;SI;;; 50;CHECK ;RGB(232,255,215);
 ' '    ;Ab:1..Ab:fac;NO;;;500;STRING;;RGB(232,255,215);
FinListBox

If Not Ok
  Cancelar
Endif

Recorrer&i 1,fac
  If Val(Ac:&i)=1
    EjecutarEvento('IN0006',Fecha1=Dialogo.Fecha1,String=Val(Ab:&i))
  Endif
Proximo


