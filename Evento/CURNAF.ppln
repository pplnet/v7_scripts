HojaVisible(NO)
creardialogo
especie1:'Especie';;;;;;;;;'NAFTA';;;;;;
string1:'Path';;;;;;;;;Var('DIRDEFAULT')
findialogo

if (not ok)
Cancelar()
endif

Message('*-- Importacion de Datos de '~dialogo.especie1)
importarwks(a1..d:100, a1..d:100, dialogo.string1~dialogo.especie1~'.WKS')

Act(z6, BuscarCampo('Feriados', 'Codigo', 'Codigo', BuscarCampo('Especies', 'PaisOrigen', 'Codigo', dialogo.especie1)))

recorrer&i 1, 100

if (Vacio(Val(a:&i)))
break
endif

Acn(z1, DifDias(Val(b:&i), Val(a:&i), Val(z6), SI) + 1)
Acd(z4, Val(a:&i))

recorrer&j 1, Val(z1)
Message("  Actualizando Precio "~FStr(Val(c:&i), 0, 2)~"/"~FStr(Val(d:&i), 0, 2)~" al "~Val(z4)~" ...")

if (Query("SELECT Count(*) FROM "~Dbo()~".CURVAFUTUROSCOMM Where Especie='"~dialogo.especie1~"' and Fecha='"~IdxDate(Val(z4))~"' ") = 1)
Sqladd("UPDATE "~Dbo()~".CURVAFUTUROSCOMM Set PrecioFut="~FStr(Val(c:&i), 0, 7)~",PrecioCon="~FStr(Val(d:&i), 0, 7)~" Where ")
Sqladd("Especie='"~dialogo.especie1~"' and ")
Sqladd("Fecha='"~IdxDate(Val(z4))~"' ")
else
Sqladd(" INSERT "~Dbo()~".CURVAFUTUROSCOMM ")
Sqladd(" (Especie,Fecha,PrecioFut,PrecioCon) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.especie1~"','"~IdxDate(Val(z4))~"',"~FStr(Val(c:&i), 0, 7)~","~FStr(Val(d:&i), 0, 7)~") ")
endif

Sqlnew()
Sqlexec()

Acd(z4, Habiles(Val(z4), 1, Val(z6), SI))
proximo
proximo

Messagebox('Actualizacion Finalizada !!!')

