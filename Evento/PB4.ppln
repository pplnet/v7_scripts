Sqladd(" SELECT /*+ RULE */ C.Codigo, C.Numero, C.Comitente, B.RazonSocial ")
Sqladd(" FROM "~Dbo()~".CUENTAS C, "~Dbo()~".CLIENTES B ")
Sqladd(" WHERE C.Comitente = B.Codigo ")
Sqladd(" AND   C.Cliente   = '"~dialogo.vehiculo1~"' ")
if (NoVacio(dialogo.lista2))
Sqladd(" AND   C.Codigo IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND   C.Comitente IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (dialogo.radio2 = 0)
Sqladd(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
endif
if (dialogo.radio2 = 1)
Sqladd(" AND C.TipoCuenta IN ('INT')")
endif
if (dialogo.radio2 = 2)
Sqladd(" AND C.TipoCuenta IN ('REC')")
endif
if (dialogo.radio2 = 3)
Sqladd(" AND C.TipoCuenta IN ('CA')")
endif
if (dialogo.check1 = 0)
Sqladd(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
endif
Sqladd(" AND (C.Especies LIKE '%"~dialogo.especie1~"%' OR C.Especies LIKE '%MONEDA%' ) ")
Sqladd(" ORDER BY C.Comitente, C.Codigo ")

Acn(z:1, 0)
recorrer sql
Message('Cuenta: '~Fbn('Codigo')~' - '~Fbn('Numero'))
