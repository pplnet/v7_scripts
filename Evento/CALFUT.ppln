mostrarcuadrodemensajes
creardialogo
fecha1:'Fecha';1;1;;;;EsHabil(dialogo.fecha1, 'ARG') y dialogo.fecha1 <= FSys();'Fecha Invalida';NO;FSys();
vehiculo1: 'Vehiculo:';2;1;;NO;SI;NoVacio(dialogo.vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
cliente1:'Cliente';3;1;;NO;NO;
check1:'Procesa';1;2;;NO;NO;;;;1;
check2:'Ejec.Liq.';2;2;;NO;NO;;;;1;
check3:'Contingencia';3;2;;NO;NO;;;;0;
lista1:'Mercado';;1;;SI;;;;;;;SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where TipoNegocio Like '%FM%'  and Regulado ='NO' and MTM in(1)  ")
lista2:'Producto';;1;;NO;NO;;;;;'Moneda';'Moneda'
findialogo

if (not ok)
Cancelar()
endif
if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (Eqstr(Var('MTMRFXSIG'), 'SI'))
Acd(fe:3, Habiles(dialogo.fecha1, +1, 'ARG'))
else
Acd(fe:3, dialogo.fecha1)
endif

if (Eqstr(Var('MTMMAESIG'), 'SI'))
Acd(fe:2, Habiles(dialogo.fecha1, +1, 'ARG'))
else
Acd(fe:2, dialogo.fecha1)
endif


Act(aa1, Var('PATHLOGAUD')~'LOGMTM.TXT')


CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

if (NoVacio(dialogo.lista1))
Act(ls:1, dialogo.lista1)
else
Act(ls:1, SQLSet("Select Codigo from "~Dbo()~".MERCADOS Where TipoNegocio Like '%FM%'  and Regulado ='NO' and MTM in(1)  "))
endif
if (NoVacio(dialogo.lista2))
Act(ls:2, dialogo.lista2)
else
Act(ls:2, 'Titulo|Moneda')
endif

SetFilaActual(1)
Act(a:fac, 'Mercado')
Act(b:fac, 'Producto')
Act(c:fac, 'Cant Ops')
Act(d:fac, 'Cont.Precio')
Act(e:fac, 'Ult fecha')
Act(f:fac, 'Cont.Fecha')
Act(g:fac, 'Tipo Error')
Act(h:fac, 'Hay Operaciones')
SetFont(a:fac..l:fac, 2)

Act(aa:fac, 'Mercado')
Act(ab:fac, 'Producto')
Act(ac:fac, 'Nr Op')
Act(ad:fac, 'Tipo Op')
Act(ae:fac, 'Cot Hoy')
Act(af:fac, 'Cot Ayer')
Act(ag:fac, 'Cot Ant')
Act(ah:fac, 'Difer.')
Act(ai:fac, 'MTM')
Act(aj:fac, '')

SetFont(aa:fac..al:fac, 2)

Acn(x:1, Fac())
recorrer&k 1, Elementos(Val(ls:1))
recorrer&j 1, Elementos(Val(ls:2))
Ifa()
Act(a:fac, ItemLista(Val(ls:1), &k))
Act(b:fac, ItemLista(Val(ls:2), &j))
proximo
proximo
Acn(y:1, Fac())

if (Val(y:1) = Val(x:1))
if (dialogo.check1 = 1)
Cancelar()('No existe Mercado+Producto para analizar')
else
Messagebox('No existe Mercado+Producto para analizar')
endif
endif

if (Val(y:1) > Val(x:1))
recorrer&k 2, Val(y:1)
Act(d:&k, 'OK')
sql.add("Select O.Especie, O.ContraEspecie, O.FechaVto,O.Mercado MercadoOp, MercadoCotizacion MercadoCot  ")
sql.add(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B , "~Dbo()~".MERCADOS M ")
sql.add(" Where O.FechaOp  <= '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   AND O.FechaVto > '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("   AND O.Mercado  = '"~Val(a:&k)~"' ")
sql.add("   AND M.Codigo = O.Mercado ")
if (Eqstr(Val(b:&k), 'Moneda'))
sql.add(" AND O.TipoOp IN ('FXCF','FXVF') ")
endif
if (Eqstr(Val(b:&k), 'Titulo'))
sql.add(" AND O.TipoOp IN ('TICF','TIVF') ")
endif
sql.add("   and O.NrOperacion = B.NrOperacion ")
sql.add("   and B.NrBit       in (10,70) ")
sql.add("   and B.Valor       = '1' ")
sql.add(" Group by O.Especie, O.ContraEspecie, O.FechaVto,MercadoCotizacion,Mercado ")
sql.add(" Order By FechaVto, Mercado ")
Watch(sql.batch())

recorrer sql
Dfa()
Scn(c:&k, 1)

Acd(e:&k, sql("select MAX(FechaFut) from COTIZACIONESFUT where  Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Mercado='"~Fbn('MercadoCot')~"' and FechaFut < '"~IdxDate(Fbn('FechaVto'))~"' "))
Acd(xe:&k, sql("select MAX(fecha) from COTIZACIONESFUT PZ1 where Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Fecha <= '"~IdxDate(dialogo.fecha1)~"' and FechaFut = (select MAX(FechaFut) from COTIZACIONESFUT where Mercado='"~Fbn('MercadoCot')~"' and FechaFut < '"~IdxDate(Fbn('FechaVto'))~"') and Mercado='"~Fbn('MercadoCot')~"' "))

Acd(f:&k, sql("select MIN(FechaFut) from COTIZACIONESFUT where Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Mercado='"~Fbn('MercadoCot')~"' and FechaFut >= '"~IdxDate(Fbn('FechaVto'))~"' "))
Acd(xf:&k, sql("select MAX(fecha) from COTIZACIONESFUT PZ1 where Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Fecha <= '"~IdxDate(dialogo.fecha1)~"' and FechaFut = (select MIN(FechaFut) from COTIZACIONESFUT where Mercado='"~Fbn('MercadoCot')~"' and FechaFut >= '"~IdxDate(Fbn('FechaVto'))~"') and Mercado='"~Fbn('MercadoCot')~"' "))

Acd(xy10, Fecha('18991230'))
if (Val(f:&k) = Val(xy10))
Acd(f:&k, Val(e:&k))
Acd(xf:&k, Val(xe:&k))
Acd(e:&k, sql("select MAX(FechaFut) from COTIZACIONESFUT where  Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Mercado='"~Fbn('MercadoCot')~"' and FechaFut < '"~IdxDate(Val(f:&k))~"' "))
Acd(xe:&k, sql("select MAX(fecha) from COTIZACIONESFUT PZ1 where Codigo = '"~Fbn('Especie')~"' and Moneda = '"~Fbn('ContraEspecie')~"' and CallPut = 'FUT' and Fecha <= '"~IdxDate(dialogo.fecha1)~"' and FechaFut = (select MAX(FechaFut) from COTIZACIONESFUT where Mercado='"~Fbn('MercadoCot')~"' and FechaFut < '"~IdxDate(Val(f:&k))~"') and Mercado='"~Fbn('MercadoCot')~"' "))
endif

if (Eqstr(Val(b:&k), 'Moneda'))
Acn(ct:1, sql("Select Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Val(e:&k))~"' AND Mercado = '"~Fbn('MercadoCot')~"' AND CallPut = 'FUT' AND Fecha = '"~IdxDate(Val(xe:&k))~"' "))
Acn(ct:2, sql("Select Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Val(f:&k))~"' AND Mercado = '"~Fbn('MercadoCot')~"' AND CallPut = 'FUT' AND Fecha = '"~IdxDate(Val(xf:&k))~"' "))
Acn(g:&k, Dif360(Val(e:&k), Val(f:&k)))
if (Fbn('FechaVto') < Val(f:&k))
Acn(h:&k, Dif360(Val(e:&k), Fbn('FechaVto')))
Acn(i:&k, ((Val(ct:2) - Val(ct:1)) / Val(g:&k) * Val(h:&k)) + Val(ct:1))
else
Acn(h:&k, Dif360(Val(f:&k), Fbn('FechaVto')))
Acn(i:&k, ((Val(ct:2) - Val(ct:1)) / Val(g:&k) * Val(h:&k)) + Val(ct:2))
endif
endif


if (Eqstr(Val(b:&k), 'Titulos'))
Acn(ct:1, sql("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Val(e:&k))~"' AND Mercado = '"~Fbn('MercadoCot')~"' AND CallPut = 'FUT' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
Acn(ct:2, sql("Select Top(1) Precio1 From "~Dbo()~".COTIZACIONESFUT Where Codigo = '"~Fbn('Especie')~"' AND Moneda = '"~Fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(Val(f:&k))~"' AND Mercado = '"~Fbn('MercadoCot')~"' AND CallPut = 'FUT' AND Fecha <= '"~IdxDate(dialogo.fecha1)~"' Order By Fecha Desc "))
endif

if (sql("select 1 from "~Dbo()~".COTIZACIONESFUT where Codigo='"~Fbn('Especie')~"' and Fecha="~IdxDate2(dialogo.fecha1)~" and FechaFut="~IdxDate2(Fbn('FechaVto'))~" and CallPut='FUT' AND Mercado = '"~Fbn('MercadoOp')~"' ") = 0)
Message('Generando cotizaciones...')
sql.add(" Insert into "~Dbo()~".COTIZACIONESFUT ")
sql.add("  (Fecha, CallPut, Codigo, Precio1, FechaFut, ")
sql.add("   Moneda, Mercado, PrecioEj, FechaUltAct, UsuarioUltAct) ")
sql.add("Values ("~IdxDate2(dialogo.fecha1)~",'FUT','"~Fbn('Especie')~"',"~FStr(Val(i:&k), 0, 9)~","~IdxDate2(Fbn('FechaVto'))~", ")
sql.add("        '"~Var('MONELOCA')~"','"~Fbn('MercadoOp')~"',"~FStr(0, 0, 0)~","~SQLAhora()~",'"~UsuarioActivo()~"') ")
sql.new
sql.exec
else
Message('Actualizando cotizaciones...')
sql.add("Update "~Dbo()~".COTIZACIONESFUT ")
sql.add("   Set Precio1="~FStr(Val(i:&k), 0, 9)~", ")
sql.add("       FechaUltAct= "~SQLAhora()~", ")
sql.add("       UsuarioUltAct='"~UsuarioActivo()~"' ")
sql.add(" where Codigo='"~Fbn('Especie')~"' and Fecha="~IdxDate2(dialogo.fecha1)~" and FechaFut="~IdxDate2(Fbn('FechaVto'))~" and CallPut='FUT' AND Mercado = '"~Fbn('MercadoOp')~"' ")
sql.new
sql.exec
endif


proximo

proximo
endif



