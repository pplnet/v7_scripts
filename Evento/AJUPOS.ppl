CrearDialogo
  Especie1: 'Especie'     ;1;1;1;  ;  ;Novacio(Dialogo.Especie1) y (DesciendeDeEspecie(Dialogo.Especie1,'TITULO') o DesciendeDeEspecie(Dialogo.Especie1,'CUPON'));'Debe ingresar un titulo.';NO;;;;;;
  Fecha1:   'Fecha'       ;2;1;1;  ;  ;;;;FSys
  Radio1   : '|General|Concertada|Liquidada' ;3;1;1;SI;SI;;;;0
  Check1:   'Procesa'     ;4;1;1;NO;NO;;;;1;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

**

ACT(h:1, 'Vehiculo')
ACT(h:2, 'Cupon Vig')

ACT(i:1, Var('VEHICULODE'))
ACN(i:2, BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))

SetFilaActual(1)
ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Book')
ACT(ac:FAC, 'NrSaldo')
ACT(ad:FAC, 'Cupon')
ACT(ae:FAC, 'Fecha')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Cliente')
ACT(ah:FAC, 'Sector')
ACT(ai:FAC, 'Estrategia')
ACT(aj:FAC, 'TipoPosicion')
ACT(ak:FAC, 'CantidadFin')
ACT(al:FAC, 'PrecioFin')
ACT(am:FAC, 'Real')
ACT(an:FAC, 'Ajuste')
ACT(ao:FAC, 'Confirmado')
ACT(aq:FAC, 'Nr Trans')
ACT(ar:FAC, 'Merc.Cta.')

SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.Cliente, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
SQL.ADD(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin, P.Fecha, P.PrecioFinCon, P.PrecioHistCon, ")
SQL.ADD(" P.PrecioReset, P.PrecioResetCon, P.Estrategia, P.TipoPosicion ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
SQL.ADD(" AND P.Book Not IN ("~Pipe2Comillas(&BValuaPartida)~") ")
if Dialogo.Radio1<>1
  * General(Ambas) o Liquidada
  SQL.ADD(" AND   P.NrSaldo IN (122) ")
else
  SQL.ADD(" AND   P.NrSaldo IN (121) ")
endif
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   and   IsNull(P.Unidad,'')       = IsNull(P1.Unidad,'') ")
SQL.ADD("                   and   IsNull(P.Centro,'')       = IsNull(P1.Centro,'') ")
* Sector se usa para saldos 101-102
SQL.ADD("                   and   IsNull(P.Sector,'')       = IsNull(P1.Sector,'') ")
SQL.ADD("                   and   IsNull(P.Sucursal,'')     = IsNull(P1.Sucursal,'') ")
SQL.ADD("                   and   IsNull(P.PrecioEj,0)      = IsNull(P1.PrecioEj,0) ")
SQL.ADD("                   and   IsNull(P.FechaEj,0)       = IsNull(P1.FechaEj,0) ")
SQL.ADD("                   and   IsNull(P.CallPut,'')      = IsNull(P1.CallPut,'') ")
* Estrategia se usa para saldos 121-122
SQL.ADD("                   and   IsNull(P.Estrategia,'')   = IsNull(P1.Estrategia,'') ")
SQL.ADD("                   and   IsNull(P.Cartera,'')      = IsNull(P1.Cartera,'') ")
SQL.ADD("                   and   IsNull(P.Trader,'')       = IsNull(P1.Trader,'') ")
* TipoNegocio se usa siempre
SQL.ADD("                   and   IsNull(P.TipoNegocio,'')  = IsNull(P1.TipoNegocio,'') ")
SQL.ADD("                   and   IsNull(P.Cupon,'')        = IsNull(P1.Cupon,'') ")
SQL.ADD("                   and   IsNull(P.Responsable,'')  = IsNull(P1.Responsable,'') ")
* TipoPosicion se usa para saldos 121-122
SQL.ADD("                   and   IsNull(P.TipoPosicion,'') = IsNull(P1.TipoPosicion,'') ")
SQL.ADD("                   and   IsNull(P.Producto,'')     = IsNull(P1.Producto,'') ")
SQL.ADD("                   and   IsNull(P.GrupoEspecie,'') = IsNull(P1.GrupoEspecie,'') ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Book, P.NrSaldo, E.Tipo, P.Especie, P.Cupon, P.Estrategia, P.TipoPosicion ")

recorrer SQL
  SCN(y:1, 1)
  ACT(aa:FAC, fbn('Especie'))
  ACT(ab:FAC, fbn('Book'))
  ACN(ac:FAC, fbn('NrSaldo'))
  ACN(ad:FAC, fbn('Cupon'))
  ACD(ae:FAC, fbn('Fecha'))
  ACT(af:FAC, fbn('Vehiculo'))
  ACT(ag:FAC, fbn('Cliente'))
  * Cuenta
  ACT(ai:FAC, fbn('Estrategia'))
  * TipoGarantia
  ACT(aj:FAC, fbn('TipoPosicion'))
  ACN(ak:FAC, fbn('CantidadFin'))
  ACN(al:fac, fbn('PrecioHistCon'))
  * Cuenta Destino
  ACN(am:FAC, 0)
  * VN a pasar
  ACN(an:FAC, 0)
  * Confirmado
  ACN(ao:FAC, 0)
  * Afecta Concertada - CB1
  if Dialogo.Radio1=2
    * Liquidada
    ACN(at:FAC, 0)
  else
    ACN(at:FAC, 1)
  endif
  * Afecta Liquidada - CB2
  if Dialogo.Radio1=1
    * Concertada
    ACN(au:FAC, 0)
  else
    ACN(au:FAC, 1)
  endif
proximo

if Val(y:1)=0
  MessageBox('No hay posiciones para transferir')
  if Dialogo.Check1=1
    Cancelar
  endif
endif

if Val(y:1)>0
  CrearListBox ; 'Arial,8,';Val(di:1)
    'Conf'              ;ao:2..ao:Fac ;;;;40;CHECK;RGB(160,160,193)
    'Vehiculo'          ;af:2..af:Fac ;NO;;;70 ;STRING;;
    'Cliente'           ;ag:2..ag:Fac ;NO;;;70 ;STRING;;
    'Especie '          ;aa:2..aa:Fac ;NO;;;70 ;STRING;;
    'Cupon'             ;ad:2..ad:Fac ;NO;;;70 ;STRING;;
    'Book'              ;ab:2..ab:Fac ;NO;;;80 ;STRING;;
    'Cuenta'            ;ai:2..ai:Fac ;NO;;;100;STRING;;
    'Tipo Gar'          ;aj:2..aj:Fac ;NO;;;70 ;STRING;;
    'Posicion'          ;ak:2..ak:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'
    'Precio'            ;al:2..al:Fac ;NO;;;100;NUMERO;'###.########'
    'Posicion real'     ;am:2..am:Fac ;SI;;;100;NUMERO;'###,###,###,###.##';RGB(160,160,193)
    'Ajuste a Realizar' ;an:2..an:Fac ;NO;Val(ao:FLB)=0 o Val(an:FLB)<>0;'Cantidad a ajustar invalida. (Fila '~FStr(FLB-1,1,0)~')';100;NUMERO;'###,###,###,###.##';;iif(Val(ao:FLB)=1,Val(am:FLB)-Val(ak:FLB),0)
  FinListBox
  IF NOT OK 
    Cancelar('Evento Cancelado')
  ENDIF
  
  ACN(y:2, Sum(ao:2..ao:fac))
  if Val(y:2)=0
    MessageBox('No se selecciono ninguna fila para realizar pasaje de posicion')
  else
    recorrer&i 2,Val(y:1)+1
      if Val(ao:&i)=1
        * Linea Confirmada
        SCN(y:3, 1)
        ACT(ar:&i, BuscarCampo('CUENTAS','Mercado','Codigo', Val(ai:&i)))
        ***************************
        ** Insert Transaccion TRPOS
        ***************************
        if Dialogo.Check1=1
          ACT(ap:&i, GetNumerador(27))
          SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
          SQL.ADD("   TipoTr2, NrTrans, Cliente1,  Fecha1, Especie, ")
          SQL.ADD("   Cupon1,  Book1,   Cantidad1, Precio1, ")
          SQL.ADD("   Cantidad2, Cantidad3, Vehiculo1, ")
          SQL.ADD("   Cuenta1, ConceptoPago, Mercado1, ")
          SQL.ADD("   CB1, CB2, ")
          SQL.ADD("   FechaCarga, FechaCargaSys, UsrInput ")
          SQL.ADD(" ) VALUES( ")
          * TipoTr2
          SQL.ADD("   'TRAJUP', ")
          * Nr Trans
          SQL.ADD("   '"~Val(ap:&i)~"', ")
          * Cliente
          SQL.ADD("   '"~Val(ag:&i)~"', ")
          SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
          * Especie
          SQL.ADD("   '"~Val(aa:&i)~"', ")
    
          * Cupon1
          SQL.ADD("   "~FSTR(Val(ad:&i),1,0)~", ")
          * Book1
          SQL.ADD("   '"~Val(ab:&i)~"', ")
          * Cantidad1 - Original
          SQL.ADD("   "~FStr(Val(ak:&i),1,2)~",")
          * Precio1
          SQL.ADD("   "~FStr(Val(al:&i),1,8)~", ")

          * Cantidad2 - Real
          SQL.ADD("   "~FStr(Val(am:&i),1,2)~",")
          * Cantidad3 - A Ajustar
          SQL.ADD("   "~FStr(Val(an:&i),1,2)~",")
          * Vehiculo1
          SQL.ADD("   '"~Val(af:&i)~"', ")

          * Cuenta1 (Estrategia)
          SQL.ADD("   '"~Val(ai:&i)~"', ")
          * ConceptoPago (TipoPosicion)
          SQL.ADD("   '"~Val(aj:&i)~"', ")
          * Mercado1 - Mercado Cuenta1
          SQL.ADD("   '"~Val(ar:&i)~"', ")

          * CB1 - Afecta Concertada
          SQL.ADD("   "~FStr(Val(at:&i),1,0)~",")
          * CB2 - Afecta Liquidada
          SQL.ADD("   "~FStr(Val(au:&i),1,0)~",")

          SQL.ADD(" "~SQLAhora~","~idxdate2(fsys)~", '"~USUARIOACTIVO~"') ")
          SQL.NEW
          SQL.EXEC    

          SQL.ActualizarMovimientosT2(Val(ap:&i),NO,NO,NO,SI)
          SQL.EXEC 

          *- Alta de Instancias
          EjecutarEvento('INBIT2',String1='TRANSACCIONES2', Entero1=70, NrOperacion1=Val(ap:&i))
        endif
      endif
    proximo
    if Val(y:3)=1
      MessageBox('Se realizo '~FStr(Val(y:3),1,0)~' passaje de posicion')
    else
      MessageBox('Se realizaron '~FStr(Val(y:3),1,0)~' pasajes de posicion')
    endif
  endif
endif

