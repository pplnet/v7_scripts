Sqladd("Select O.NrOperacion, O.Impresa, O.RB3 from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B where B.NrBit=6 and B.Valor='1' and O.NrOperacion=B.NrOperacion")
recorrer sql
Message(Fbn('NrOperacion'))
Acn(z1, Fbn('Impresa'))
Act(z3, Fbn('RB3'))
Acn(z2, Num(Val(z3)))
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='0' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=6")
Sqlnew()

if (Eqstr(Val(z1), '1'))
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=11")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS set Valor='1' where NrOperacion='"~Fbn('NrOperacion')~"' and NrBit=10")
endif
Sqlnew()
proximo
Sqlexec()

