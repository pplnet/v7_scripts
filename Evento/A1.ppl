CrearDialogo
  NrOperacion1 : "nr op."          ;1;1;;NO;NO;;;;;
  Entero1      : "nr cta."         ;1;1;;NO;NO;;;;;
  Fecha1       : "A Partir de"     ;1;1;;;;;;;Fsys;
  NrOperacion2 : "si ingresa una sola" ;1;1;;NO;NO;;;;;
  Precio1      : "Tasa WHT"        ;3;1;;;;Dialogo.Check1=0 o Incluido(Fstr(Dialogo.Precio1,2,4),VAR('TASAWH'));'TASA WHT INCORRECTA: '~VAR('TASAWH');NO;VAR('DEFWH1');
  Check1       : "Confirma?"       ;3;2;;;;;;;;;
  Precio2      : "Tasa IVA"        ;4;1;;;;Dialogo.Check2=0 o Incluido(Fstr(Dialogo.Precio2,2,2),VAR('IVA'));'TASA IVA INCORRECTA: '~VAR('IVA');NO;VAR('TASAIVA');
  Check2       : "Confirma?"       ;4;2;;;;;;;;;
  Precio3      : "Tasa CEC"        ;5;1;;;;Dialogo.Check3=0 o Dialogo.Precio3>=0;'TASA CEC INCORRECTA';NO;;0;
  Check3       : "Confirma?"       ;5;2;;;;;;;;;
  Precio4      : "Tasa CEN"        ;6;1;;;;Dialogo.Check4=0 o Dialogo.Precio4>=0;'TASA CEN INCORRECTA';NO;;0;
  Check4       : "Confirma?"       ;6;2;;;;;;;;;
  Precio5      : "Al.Imp.Extr"     ;7;1;;;;Dialogo.Check5=0 o Dialogo.Precio5>=30;'SI SE INGRESA, EL IMPUESTO EXTRANJERO DEBE SER >=30';NO;;VAR('ALICIMPU');
  Check5       : "Confirma?"       ;7;2;;;;;;;;;
  Precio10     : "Alic.CPM.Nva."   ;8;1;;;;Dialogo.Check6=0 o [Dialogo.Precio10>=0 y Dialogo.Precio10<>Dialogo.Cantidad1];'ALICUOTAS POR MMCPM IGUALES O INCORRECTA';NO;;;;;"###.#####"
  Check6       : "Confirma?"       ;8;2;;;;;;;;;
  Precio9      : "Perc.IVA Nvo."   ;9;1;;;;Dialogo.Check7=0 o [Dialogo.Precio9>=0 y Dialogo.Precio9<>Dialogo.Cantidad4];'PORCENTAJES  DE PERCEPCION IVA IGUALES O INCORRECTO';NO;;
  Check7       : "Confirma?"       ;9;2;;;;;;;;;
  String       : "Tipo op"         ; ; ;;NO;NO;;;;;;
FinDialogo

If not Ok
 Cancelar
EndIf

******* TOMA DEL EVENTO RAIZ LOS VALORES DEL DIALOGO (WHT, IVA, CEC, CEN, IMP) Y LOS
******* GRABA SEGUN LAS OPERACIONES Y DENTRO DE ELLAS SEGUN EL CASO QUE CORRESPONDA

Message('Generando Calculos Tipo '~Dialogo.String~' - Operacion '~Dialogo.NrOperacion1~' - Cuota '~Dialogo.Entero1~'')

ACT(X1,'')

* Ej. si pongo cec pregunto por la operacion correspondiente porque precio3 se usa en otras operaciones para otras cosas
if Dialogo.Check1=1
    if [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)<>0] o [EqStr(Dialogo.String,'MMPOSM')] o [EqStr(Dialogo.String,'MMONM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=2] o [EqStr(Dialogo.String,'MMFIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=1] O [EqStr(Dialogo.String,'MMSIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=1]
        ACT(X1,"TotalAux1 = "~Fstr(Dialogo.Precio1,0,7)~" ")
    endif
endif


if Dialogo.Check2=1
    if [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)<>2] o [EqStr(Dialogo.String,'MMPCLM')] o [EqStr(Dialogo.String,'MMPOSM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMONM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMFIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=0] O [EqStr(Dialogo.String,'MMSIMV') y BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=0] O [EqStr(Dialogo.String,'MMCPM') y NOT DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)))]

       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf

       ACT(X1,VAL(X1)~" ImpGastos2 = "~Fstr(Dialogo.Precio2,0,7)~" ")
    endif
endif

if Dialogo.Check3=1
    if [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0] o [EqStr(Dialogo.String,'MMPCLM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1]
       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf
       
       ACT(X1,VAL(X1)~" Precio3 = "~Fstr(Dialogo.Precio3,0,7)~" ")
    endif
endif

if Dialogo.Check4=1
    if [Incluido(Dialogo.String,'MMPEM|MMPIM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1] o [EqStr(Dialogo.String,'MMPOSM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0]

       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf

       ACT(X1,VAL(X1)~" Precio2 = "~Fstr(Dialogo.Precio4,0,7)~" ")
    endif
endif

if Dialogo.Check5=1
    if [EqStr(Dialogo.String,'MMPCCM') y BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)>=3]

       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf

       ACT(X1,VAL(X1)~" TasaPrecan = "~Fstr(Dialogo.Precio5,0,7)~" ")
    endif
endif

if Dialogo.Check6=1
    if [EqStr(Dialogo.String,'MMCPM') y EQSTR(BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1),'ARP') Y DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)))]

       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf

       ACT(X1,VAL(X1)~" ImpGastos1 = "~Fstr(Dialogo.Precio10,0,7)~" ")
    endif
endif


if Dialogo.Check7=1
    if [EqStr(Dialogo.String,'MMCPM') y NOT DESCIENDEDECLIENTE(BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)))]

       IF NoVacio(VAL(X1))
          ACT(X1,VAL(X1)~", ")
       EndIf

       ACT(X1,VAL(X1)~" TotalAux2 = "~Fstr(Dialogo.Precio9,0,7)~" ")
    endif
endif


IF NoVacio(VAL(X1))
   SQL.ADD("Update "~DBO~".OPERACIONES")
   SQL.ADD("Set ")
   SQL.ADD(" "~VAL(x1)~" ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.EXEC
EndIf


***** REALIZA LOS CALCULOS PARA TODA LA CUOTA AFECTADA TOMANDO LOS DATOS NUEVOS GRABADOS
***** LUEGO METE ESOS CALCULOS EN LA CUOTA

SQL.ADD("Select * from "~DBO~".CUOTAS ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")

Recorrer SQL


  * q1=iva, q2=wh, q3=interes, q4=interes total, q5=monto, q6=monto total, Q10=cec total
  * Q11=cen total, Q20=cec imp var, Q21=cen variable, Q30=impuesto

       * ASIGNA CASO
       acn(j1, BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1))

       if Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPEM|MMPIM')
             ACN(q20,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500))*(BuscarCampo('Operaciones','Precio3','NrOperacion',Dialogo.NrOperacion1)/100),0))
             ACN(Q10,FBN['Cantidad5']+val(q20))
             ACN(Q21,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1,FBN['Cantidad2'] * BuscarCampo('Operaciones','Precio2','NrOperacion',Dialogo.NrOperacion1) * FBN['Plazo1'] / IIF(BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500),0))
             ACN(Q11,val(q21)+FBN['Plazo3'])
             ACN(Q1,(BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100)*(val(q11)+val(q10)+(FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2']/IIF(BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500))))
             ACN(Q2,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0,0,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=2,FBN['Cantidad2']*((FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)*(BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1)/100), FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']/IIF(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1)=1,36500,36000)*(BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1)/100))))
             ACN(Q3,IIF(Dialogo.Entero1<BuscarCampo('Operaciones','PlazoGracia','NrOperacion',Dialogo.NrOperacion1),0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)))
             ACN(Q4,val(q3)+ IIF(VAL(J1)=0,VAL(Q10),IIF(VAL(J1)=1,VAL(Q11)+VAL(Q2),val(q2))))
             ACN(Q5,(FBN['Cantidad1']+val(q3)))
             ACN(Q6,(FBN['Cantidad1']+val(q4)))

             SQL.ADD("Update "~DBO~".CUOTAS ")
             SQL.ADD("Set")
             SQL.ADD("Total8 = "~Fstr(val(q20),0,7)~", ")
             SQL.ADD("Precio8 = "~Fstr(val(q20),0,7)~", ")
             SQL.ADD("Cantidad6 = "~Fstr(val(q10),0,7)~", ")
             SQL.ADD("Cantidad4 = "~Fstr(val(q21),0,7)~", ")
             SQL.ADD("Plazo4 = "~Fstr(val(q11),0,7)~", ")
             SQL.ADD("Total4 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Total7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
             SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
             SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")

             SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
             SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
             SQL.NEW
             SQL.EXEC
       endif
       if EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPCLM')
             ACN(Q20,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500))*(BuscarCampo('Operaciones','Precio3','NrOperacion',Dialogo.NrOperacion1)/100),0))
             ACN(Q10,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1, FBN['Cantidad5']+val(q20), 0))
             ACN(Q1,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1,((((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500))+val(q10))*(BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100)), ((FBN['Cantidad2']*((FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))+val(q10))*(BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100)))
             ACN(Q3,IIF(Dialogo.Entero1<BuscarCampo('Operaciones','PlazoGracia','NrOperacion',Dialogo.NrOperacion1),0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)))
             ACN(Q4, val(q3)+IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=1,val(q10),0))
             ACN(Q5,(FBN['Cantidad1']+val(q3)))
             ACN(Q6,(FBN['Cantidad1']+val(q4)))

             SQL.ADD("Update "~DBO~".CUOTAS ")
             SQL.ADD("Set")
             SQL.ADD("Cantidad4 = "~Fstr(val(q20),0,7)~", ")
             SQL.ADD("Precio7 = "~Fstr(val(q20),0,7)~", ")
             SQL.ADD("Cantidad6 = "~Fstr(val(q10),0,7)~", ")
             SQL.ADD("Total4 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
             SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
             SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
             SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
             SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
             SQL.NEW
             SQL.EXEC
       endif
       if EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPOSM')
             ACN(Q21,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0,((FBN['Cantidad2']*BuscarCampo('Operaciones','Precio2','NrOperacion',Dialogo.NrOperacion1)*FBN['Plazo1'])/IIF(BuscarCampo('Operaciones','RB5','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500)),0))
             ACN(Q11,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0, FBN['Cantidad5']+val(q21), 0))
             ACN(Q1,IIF (BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0,(val(q11)*(BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100)),0))
             ACN(Q2,FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']/IIF(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1)=1,36500,36000)*(BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1)/100))
             ACN(Q3,IIF(Dialogo.Entero1<BuscarCampo('Operaciones','PlazoGracia','NrOperacion',Dialogo.NrOperacion1),0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)))
             ACN(Q4,val(q2)+val(q3)+val(q11))
             ACN(Q5,FBN['Cantidad1']+val(q3))
             ACN(Q6,FBN['Cantidad1']+val(q4))

             SQL.ADD("Update "~DBO~".CUOTAS ")
             SQL.ADD("Set")
             SQL.ADD("Cantidad4 = "~Fstr(val(q21),0,7)~", ")
             SQL.ADD("Precio8 = "~Fstr(val(q21),0,7)~", ")
             SQL.ADD("Cantidad6 = "~Fstr(val(q11),0,7)~", ")
             SQL.ADD("Total4 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Total7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
             SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
             SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
             SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
             SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
             SQL.NEW
             SQL.EXEC
       endif
       if EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMONM')
             ACN(Q3,IIF(Dialogo.Entero1<BuscarCampo('Operaciones','PlazoGracia','NrOperacion',Dialogo.NrOperacion1),0,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)))
             ACN(Q1,IIF(BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=1,0,(val(q3)*BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100)))
             ACN(Q2,IIF(BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1)=0,0,(val(q3)*BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1)/100)))
             ACN(Q4,val(q3)+val(q2))
             ACN(Q5,(FBN['Cantidad4']+val(q3)))
             ACN(Q6,FBN['Cantidad4']+val(q4))

             SQL.ADD("Update "~DBO~".CUOTAS ")
             SQL.ADD("Set")
             SQL.ADD("Precio1 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio3 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Cantidad5 = "~Fstr(val(q4),0,7)~", ")
             SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
             SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
             SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
             SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
             SQL.NEW
             SQL.EXEC
       endif
       if EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMPCCM')
            * ASIGNA PRESTAMO O COLOCACION
            ACN(J2,BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1))

            ACN(Q1,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=0,((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1)=0,36000,36500))*(BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100),0))
            ACN(Q2,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=2 y BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)=0,(((FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6'])/IIF(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1)=1,36500,36000)) *(BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1)/100)),0))
            ACN(Q3,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))
            ACN(Q30,IIF(BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=3 O [BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)=4 y BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)=0],val(q3)*BuscarCampo('Operaciones','TasaPrecan','NrOperacion',Dialogo.NrOperacion1)/100,0))
            ACN(Q4,val(q3)+IIF(VAL(J1)=2 Y VAL(J2)=0,val(q2),0)+IIF(VAL(J1)=4 Y VAL(J2)=0,val(q30),0))
            ACN(Q5,(FBN['Cantidad1']+val(q3)))
            ACN(Q6,(FBN['Cantidad1']+val(q4)))

             SQL.ADD("Update "~DBO~".CUOTAS ")
             SQL.ADD("Set")
             SQL.ADD("Cantidad4 = "~Fstr(val(q30),0,7)~", ")
             SQL.ADD("Precio8 = "~Fstr(val(q30),0,7)~", ")
             SQL.ADD("Total4 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Precio6 = "~Fstr(val(q1),0,7)~", ")
             SQL.ADD("Total7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Precio7 = "~Fstr(val(q2),0,7)~", ")
             SQL.ADD("Cantidad3 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Precio5 = "~Fstr(val(q3),0,7)~", ")
             SQL.ADD("Total3 = "~Fstr(val(q4),0,7)~", ")
             SQL.ADD("Total2 = "~Fstr(val(q5),0,7)~", ")
             SQL.ADD("Total1 = "~Fstr(val(q6),0,7)~" ")
             SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
