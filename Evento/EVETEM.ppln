creardialogo
radio1:'Ajuste|TB725|GD38|T2X5P|BPJ25';;;;;;;;;0
check1:'Procesa';;;;SI;SI;;;;1
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

if (dialogo.check1 = 0)
HojaVisible(SI)
endif

if (dialogo.radio1 = 0)
SetFilaActual(1)
Act(a:fac, 'Especie')
Act(b:fac, 'Operacion')
Act(c:fac, 'MovsPosEje')
Act(d:fac, 'MPEje Pr 0')
SetFont(a:fac..d:fac, 2)

Ifa()
Act(a:fac, 'TB725')
Act(b:fac, 'T0453700')
Acn(c:fac, Query("Select Count(*) from "~Dbo()~".MOVPOSPEN WHERE Especie = '"~Val(a:fac)~"' and NrOperacion = '"~Val(b:fac)~"' "))
Acn(d:fac, Query("Select Count(*) from "~Dbo()~".MOVPOSEJE WHERE Especie = '"~Val(a:fac)~"' and NrOperacion = '"~Val(b:fac)~"' and Estrategia = 'APROPIAEC' "))
if (Val(d:fac) = 0)
if (dialogo.check1 = 1)
Cancelar('Error en movimientos operacion '~Val(b:fac)~'. Puede ser que el ajuste ya se haya ejecutado.')
else
Messagebox('Error en movimientos operacion '~Val(b:fac)~'. Puede ser que el ajuste ya se haya ejecutado.')
endif
endif
SetFont(a:2..d:fac, 1)

if (dialogo.check1 = 1)
Sqladd("INSERT INTO "~Dbo()~".MOVPOSEJE ( ")
Sqladd("FechaMov,    Cliente, ")
Sqladd("Vehiculo,    Sector, ")
Sqladd("NrSaldo,     Especie, ")
Sqladd("PrecioEj,    FechaEj, ")
Sqladd("Cantidad,    Precio, ")
Sqladd("Estrategia,  Book, ")
Sqladd("TipoNegocio, NrOperacion, ")
Sqladd("Cupon,       Tipo ) ")
Sqladd("SELECT FechaMov, Cliente, ")
Sqladd("       Vehiculo, Sector, ")
Sqladd("       NrSaldo, Especie, ")
Sqladd("       PrecioEj, FechaEj, ")
Sqladd("       Cantidad, Precio, ")
Sqladd("       'APROEUTB', Book, ")
Sqladd("       TipoNegocio, NrOperacion, ")
Sqladd("       Cupon, Tipo ")
Sqladd("  from "~Dbo()~".MOVPOSEJE ")
Sqladd(" WHERE Especie     = '"~Val(a:fac)~"' ")
Sqladd("   AND NrOperacion = '"~Val(b:fac)~"' ")
Sqladd("   AND Estrategia = 'APROPIAEC' ")
Sqlnew()

Sqladd("Delete "~Dbo()~".MOVPOSEJE ")
Sqladd(" WHERE Especie     = '"~Val(a:fac)~"' ")
Sqladd("   AND NrOperacion = '"~Val(b:fac)~"' ")
Sqladd("   AND Estrategia = 'APROPIAEC' ")
Sqlnew()

Sqlexec()
Messagebox('Ajuste '~Val(a:fac)~' - '~Val(b:fac)~' realizado.')
endif
