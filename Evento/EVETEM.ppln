Acn(c:fac, Query("Select Count(*) from "~Dbo()~".POSICIONES WHERE Especie = '"~Val(a:fac)~"' and (CantidadFin>-0.01 and CantidadFin<0.01 and CantidadFin<>0 )"))
Acn(d:fac, Query("Select Count(*) from "~Dbo()~".POSICIONES WHERE CantidadFin>-0.01 and CantidadFin<0.01 and CantidadFin<>0 "))
if (Val(d:fac) = 0)
