sql.add("and ")
sql.add("( ")
sql.add("  ( ")
if (dialogo.radio2 = 0)
sql.add("    T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
else
sql.add("    T.Fecha2 <= '"~IdxDate(dialogo.fecha1)~"' ")
endif
sql.add("    and (T.CB3 = '0' or T.CB3 is NULL) ")
sql.add("  )  ")
sql.add("  or ")
sql.add("  (  ")
sql.add("    T.Fecha2 < '"~IdxDate(dialogo.fecha1)~"' ")
sql.add("    and T.CB3 = '1' ")
