CrearDialogo
  Vehiculo1: "Vehiculo" ;;;;;;NoVacio(Dialogo.Vehiculo1) IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "));NO
FinDialogo

if not ok
Cancelar
endif

