Sqladd(" AND T.Cantidad1 > 0 ")
Sqladd(" AND T.NrOperacionRef1 Not IN (Select S.NrOperacion From "~Dbo()~".MOVIMIENTOS S ")
Sqladd("                              Where S.NrOperacion = T.NrOperacionRef1 ")
Sqladd("                              AND S.Movimiento_Numero = M.NrMov ")
Sqladd("                              AND S.Estado = 'Pendiente') ")
Sqladd(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~Dbo()~".MOVIMIENTOS S ")
Sqladd("                              Where S.NrOperacion = O.NrOperacion ")
Sqladd("                              AND S.Movimiento_Numero = M.NrMov ")
Sqladd("                              AND S.Estado = 'Pendiente') ")
Sqladd(" AND ((((M.Concepto <> 'COMISI' AND M.Concepto <> 'CUPON') OR M.Concepto Is Null)) ")
Sqladd("        OR (M.Concepto = 'COMISI' AND (Leyenda Like '%IVA%' OR Leyenda Like '%WH%' OR Leyenda Like '%Impto.Int%') )) ")
Sqladd(" AND M.Leyenda Not like '%CEC%' ")
