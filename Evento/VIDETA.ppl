* VIDETA
* Elimina Tasas de Pares no Existentes
CrearDialogo
 Fecha1     : "Fecha"        ;;;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;HABILES(FSYS,-1,'ARG',SI)
FinDialogo

if Not Ok
  Cancelar
endif

SQL.ADD("Select * from "~DBO~".TASASVEHICULO T Where Fecha='"~IdxDate(Dialogo.Fecha1)~"' Order By Vehiculo1,Vehiculo2,Especie")

Recorrer SQL
   Message('Pares de Vehiculos: '~FBN['Vehiculo1']~'/'~FBN['Vehiculo2']~'  ...')

   ACT(AV1,FBN['Vehiculo1'])
   ACT(AV2,FBN['Vehiculo2'])
   ACT(AE1,FBN['Especie'])

   *-- Verifico que este en ParesVehiculos
   SQL.ADD(" Select * FROM "~DBO~".PARESVEHICULO P Where Estado='HAB' and ")
   SQL.ADD(" ((P.Vehiculo1='"~FBN['Vehiculo1']~"' and P.Vehiculo2='"~FBN['Vehiculo2']~"') ")
   SQL.ADD("  or (P.Vehiculo2='"~FBN['Vehiculo1']~"' and P.Vehiculo1='"~FBN['Vehiculo2']~"')) ")

   ACN(x1,0)

   Recorrer SQL
      * Verifico que la Especie de la Tasa Este incluida en ParesVehiculo
      SQL.ADD("SELECT Codigo FROM  "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(FBN['ListaEspecies'])~") and Codigo='"~VAL(AE1)~"' ") 

      Recorrer SQL
         ACN(x1,1)        
      Proximo
   Proximo

   IF VAL(x1)=0 
      * No existe el Par de Vehiculos
      SQL.ADD("DELETE "~DBO~".TASASVEHICULO  Where ")
      SQL.ADD("Fecha='"~IdxDate(Dialogo.Fecha1)~"' and ")
      SQL.ADD("Vehiculo1='"~FBN['Vehiculo1']~"' and ")
      SQL.ADD("Vehiculo2='"~FBN['Vehiculo2']~"' and ")
      SQL.ADD("Especie='"~FBN['Especie']~"' ")                 
      SQL.NEW
      SQL.EXEC
   EndIf
Proximo
