Sqladd("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ")
Sqladd(" FROM  "~Dbo()~".ESPECIES                                                              ")
Sqladd(" WHERE Codigo = '"~&cod_src~"'                                                       ")

recorrer sql
