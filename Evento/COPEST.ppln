sql.add("  CodEsCuponAdherido, Codigo1, Codigo2, Codigo3, Codigo4, FechaCorteCupon,           ")
sql.add("  FechaPresentaCupon, FechaProximoCorte, FechaPagoCupon, FechaCambioTasa,            ")
sql.add("  TasaIntVigente, TasaIntAnterior, IntsCapitalizados, ISIN, CUSIP, Cedel,            ")
sql.add("  EuroClear, PeriodoIntereses, FormaCalculoInts, TasaAmortProxCupon, EsCupon,        ")
sql.add("  CuponFeriado, PaisOrigen, Tranche, ISO, ContraespecieCupon, Indexado,              ")
sql.add("  Indice, Reestructurado, ZeroCoupon, Fecha1, Fecha2, Fecha3, Fecha4,                ")
sql.add("  Fecha5, Fecha6, Fecha7, Fecha8, Fecha9, Fecha10, LocalRating1, LocalRatingSource1, ")
sql.add("  LocalRating2, LocalRatingSource2, Marketability, CommonCode, MaxHoldingPeriod,     ")
sql.add("  FechaAsigHoldingP, FechaVtoHoldingP, FechaRevHoldingP, FuenteCotizacion,           ")
sql.add("  CodigoCotizacion, CotizaMAE, VolumenMinimo, GrupoEspecie, CantEmitida, CutOffTime, ")
sql.add("  EntidadEmisora, Tipocartera, Aforo, Comprobante, OrdenFirmada, CodMAEContado,      ")
sql.add("  AforoPesos, AforoDolares, MonedaEmision, TasaCER, SWIFT                            ")
sql.add(" FROM  "~Dbo()~".ESPECIES                                                              ")
sql.add(" WHERE Codigo = '"~&cod_src~"'                                                       ")

recorrer sql
