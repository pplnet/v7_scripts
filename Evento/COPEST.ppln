creardialogo
especie1:'Especie a copiar';;;;;;;;;
string1:'Nuevo codigo';;;;;;;;;;upcase(dialogo.string1);;;'XXXXXX'
findialogo

if (not ok)
Cancelar()
endif

let(&tabla, "ESPECIES")
let(&cod_abm, "ESPECI")
let(&claves, array("Jerarquia", "Codigo"))

if (not dobleconf(&cod_abm))
Cancelar('El abm de Especies no requiere doble confirmacion. No se puede generar el registro en temporales.')
endif

let(&cod_src, dialogo.especie1)
let(&cod_new, upcase(dialogo.string1))

let(&existe, Query("Select 1 from "~Dbo()~".ESPECIES where Codigo = '"~&cod_new~"'"))

if (&existe = 1)
Cancelar('El codigo de especie "'~&cod_new~'" ya existe, utilice otro.')
endif

let(&jer_src, Query("Select Jerarquia from "~Dbo()~".ESPECIES where Codigo = '"~&cod_src~"'"))
let(&jer_new, generarjerarquiabyref(&tabla, &jer_src, NO))

Sqladd(" SELECT                                                                              ")
Sqladd("  Jerarquia, Codigo,   Cupon, Nombre, Extendido, Cotiza, InteresesC,                 ")
Sqladd("  FEmision, Fecha, cupones, TamanioLote, VTeorico, VNominal,  Factor,                ")
Sqladd("  DiasMes, DiasAnio, MercadoDef, Tasa1, Tasa2, Tasa3, Observaciones,                 ")
Sqladd("  Valor1, Valor2, Valor3, Valor4, Valor5, Valor6, Valor7, Valor8,                    ")
Sqladd("  Valor10, Alias1, Alias2, Alias3, Alias4, Alias5, Alias6, Alias7,                   ")
Sqladd("  Alias8, Alias9, Alias10, Caracter, MaxGraficar, MinGraficar,                       ")
Sqladd("  MaxSupuesto, MinSupuesto, Intervalos, TipoOpcionDef, PlazoLiq,                     ")
Sqladd("  Security, ExNumber, ExNumbers, Issue, SType, Issuer, Guarantor, CalDate,           ")
Sqladd("  PutDate, ConDate, CodAlfCajaValores, CodNumCajaValores, Tipo, TipoEC, LaminaMinima,")
Sqladd("  TipoAccion, CantidadVotos, SyPRating, MoodysRating, Status, Sector,                ")
Sqladd("  IndustryGroup, CallPrice, PutPrice, DenominCajaValores, Habilitada,                ")
Sqladd("  FecDeshabilitacion, CodEsCuponAnterior, CodEsProximoCupon,                         ")
Sqladd("  CodEsCuponAdherido, Codigo1, Codigo2, Codigo3, Codigo4, FechaCorteCupon,           ")
Sqladd("  FechaPresentaCupon, FechaProximoCorte, FechaPagoCupon, FechaCambioTasa,            ")
Sqladd("  TasaIntVigente, TasaIntAnterior, IntsCapitalizados, ISIN, CUSIP, Cedel,            ")
Sqladd("  EuroClear, PeriodoIntereses, FormaCalculoInts, TasaAmortProxCupon, EsCupon,        ")
