MostrarCuadroDeMensajes()
creardialogo
fecha1:'Fecha';1;1;;NO;;;;;FSys()
nrunicoasiento1: 'Asiento';;;;;;NoVacio(dialogo.nrunicoasiento1);'Asiento Invalido';NO;
fecha2:'F.Valor';;;;;;;;;;;;;;;;
string1:"Nro de Batch";;;;;NO;;;;;
findialogo

if (not ok)
Cancelar()
endif

Acd(fe:1, dialogo.fecha1)
Acn(bd:1, 0)
Act(na:1, Pad0(dialogo.nrunicoasiento1, 8))

Sqladd("select DISTINCT  MA.Codigo as CodAsi, AC.FechaGeneracion,  ")
Sqladd(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
Sqladd(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
Sqladd("  from  "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ASIENTOSCON AC ")
Sqladd(" Where AC.NrUnicoAsiento = '"~Val(na:1)~"' ")
Sqladd(" and MA.Codigo = AC.Modelo      ")
Sqladd(" order by AC.NrUnicoAsiento ")
recorrer sql
Message('Operacion '~Fbn('NrOperacion'))
Act(nn:1, getnumerador(810))
Acn(bd:1, 1)
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON ")
Sqladd(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
Sqladd(" Modelo, Book, UDN, Centro, ")
Sqladd(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
Sqladd(" NrOperacion, NrTrans2, Estado, Fecha1) ")
Sqladd(" VALUES ")
Sqladd(" ("~IdxDate2(FSys())~", '"~IdxDate(dialogo.fecha2)~"', '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
Sqladd(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
Sqladd(" '"~Fbn('Sector')~"', '"~Fbn('NrLote')~"', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', 'REV', "~IdxDate2(dialogo.fecha1)~")  ")
Sqlnew()
Sqladd(" SELECT Cuenta,DebitoCredito,Especie1,Especie2,Especie3,Cantidad1,Cantidad2,Cantidad3,NrOperacion,NrTrans2,")
Sqladd(" Alias1,Alias2,Alias3,Alias4,Alias5,Detalle,CentroCosto,Book,Valor1,")
Sqladd(" Valor2,Valor3, TablaRC, NrItem ")
Sqladd(" FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
Sqladd(" Especie2, Especie3, Cantidad1, Cantidad2, ")
Sqladd(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
Sqladd(" Alias2, Alias3, Alias4, Alias5, ")
Sqladd(" Detalle, CentroCosto, Book, ")
Sqladd(" Valor1, Valor2, Valor3 ")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
Sqladd(" 'CRE', ")
else
Sqladd(" 'DEB', ")
endif
Sqladd(" '"~Fbn('Especie1')~"', ")
Sqladd(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
Sqladd(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
Sqladd(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', '"~Fbn('Alias4')~"', '"~Fbn('Alias5')~"', ")
Sqladd(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', ")
Sqladd(" "~FStr(Fbn('Valor1'), 0, 2)~", "~FStr(Fbn('Valor2'), 0, 8)~", "~FStr(Fbn('Valor3'), 0, 2)~") ")
Sqlnew()
proximo
Sqlexec()
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = '"~Val(nn:1)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
proximo


