creardialogo
fecha1:"Fecha";;;;;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;FSys()
nroperacion1:"NrOperacion";;;;;;;
findialogo


Message('Re-estructurando Cap.Int. '~dialogo.nroperacion1)

Sqladd(" Select O.NrOperacion, O.TipoOp, C.NrCuota, C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad5, C.Cantidad6, C.Cantidad9, C.Cantidad10, ")
Sqladd(" C.Tasa1, C.Tasa2, C.Tasa6, C.Tasa7, C.Tasa8, C.Precio2, C.Precio4, C.Fecha1, C.Fecha2, C.Plazo1, C.Total5, ")
Sqladd(" C.Total6, C.Total7, C.Total9, O.Precio2 Precio2OP, O.RB5, O.RB6, O.RB8, O.DeltaTasa, O.MB1, ")
Sqladd(" O.Cantidad, O.TotalComisiones, O.TasaImp1, O.ImpGastos2, O.TotalAux1, O.Cuotas1, O.CantidadOri, C.Cantidad1Ori, C.Cantidad2Ori, C.Coeficiente  ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".CUOTAS C")
Sqladd(" Where O.NrOperacion = C.NrOperacion ")
if (NoVacio(dialogo.nroperacion1))
Sqladd(" and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
Sqladd("   and O.TipoOp in ('MMPOSM','MMPCLM') ")
Sqladd("   and O.CB2 = 1 ")
Sqladd("   and C.Fecha3 >= (Select Fecha3 From "~Dbo()~".CUOTAS S ")
Sqladd("                Where S.NrOperacion = O.NrOperacion ")
Sqladd("                AND S.Fecha3 = '"~IdxDate(dialogo.fecha1)~"') ")
Sqladd(" Order by 1, 3 ")

Ifa()
Ifa()
Act(a:fac, 'NrCuota')
Act(b:fac, 'Tasa Amort')
Act(c:fac, 'Imp Amort')
Act(d:fac, 'Valor Nominal')
Act(e:fac, 'Interes')
Act(f:fac, 'Interes Capitalizado')
Act(g:fac, 'Interes Total')
Act(h:fac, 'Imp Interes')
Act(i:fac, 'Monto')
Act(j:fac, 'Monto Total')
Act(k:fac, 'Importe IVA')
Act(l:fac, 'Importe WHT')
Act(m:fac, 'CEN Variable')
Act(n:fac, 'MOD Imp al Interes')

Act(o:fac, 'Imp.Var._CEC')
Act(p:fac, 'Imp.Tot._CEC')
Act(q:fac, 'Imp_Cs_Fin_CEC')
Act(r:fac, 'ImpAmor Orig')
Act(s:fac, 'VN Orig')
Act(t:fac, 'Resultado')

recorrer sql
if (Eqstr(Val(z:1), Fbn('NrOperacion')))
Act(z:1, Fbn('NrOperacion'))
Scn(z:2, 1)

Acn(d:fac, Val(d:fac - 1) - Val(c:fac - 1) + Val(f:fac - 1))
Acn(e:fac, Val(d:fac) * ((Fbn('Precio4') + Fbn('Precio2')) / 100) * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1))
Acn(f:fac, Val(e:fac) * Fbn('Tasa6') / 100)
Acn(c:fac, Val(d:fac) * Fbn('Tasa1') / 100)

if (Eqstr(Fbn('TipoOp'), 'MMPOSM'))
if (Fbn('RB6') = 0)
Acn(h:fac, Val(e:fac) * Fbn('TASAIMP1') / 100)
else
Acn(h:fac, 0)
endif
Acn(k:fac, Val(d:fac) * Fbn('TASA2') / 100 * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1) * (Fbn('ImpGastos2') / 100))
Acn(l:fac, Val(d:fac) * Fbn('TOTAL6') / 100 * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1) * (Fbn('TotalAux1') / 100))
if (Fbn('RB6') = 0)
Acn(m:fac, (Val(d:fac) * Fbn('Precio2OP') * Fbn('Plazo1')) / iif (Fbn('RB5') = 0, 36000, 36500))
else
Acn(m:fac, 0)
endif
Acn(g:fac, Val(h:fac) + Val(l:fac) + Val(e:fac) + Fbn('Cantidad6'))
else
Acn(x:1, Var('DEFAINT') * Val(e:fac) / 100)
Acn(x:2, (Val(d:fac) * Var('TASAIMPINT') / 100 * Fbn('Plazo1')) / 365)
if (Fbn('TASAIMP1') <> 0)
if (Val(x:1) > Val(x:2))
Acn(h:fac, Val(x:2))
else
Acn(h:fac, Val(e:fac) * Fbn('TASAIMP1') / 100)
endif
else
Acn(h:fac, 0)
endif
Acn(o:fac, iif (Fbn('RB6') = 1, Val(d:fac) * Fbn('Total5') * Fbn('Plazo1') / iif (Fbn('MB1') = 0, 36000, 365000), 0))
Acn(p:fac, iif (Fbn('RB6') = 1, Fbn('Cantidad5') + Val(o:fac), 0))
Acn(q:fac, iif (Fbn('RB6') = 1, Val(p:fac) * Fbn('DeltaTasa') / 100, 0))
if (Fbn('RB6') = 1)
Acn(k:fac, (Val(d:fac) * Fbn('TASA2') / 100 * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1) + Val(p:fac)) * (Fbn('ImpGastos2') / 100))
else
Acn(k:fac, Val(d:fac) * (Fbn('Precio2') + Fbn('Precio4')) / 100 * FactorDias(Fbn('Fecha1'), Fbn('Fecha2'), Fbn('RB8') + 1) * (Fbn('ImpGastos2') / 100))
endif
Acn(g:fac, Val(q:fac) + Val(h:fac) + Val(e:fac) + iif (Fbn('RB6') = 1, Val(p:fac), 0))
if (Fbn('Coeficiente') = 1)
Acn(r:fac, Val(c:fac))
Acn(s:fac, Val(d:fac))
else
Acn(r:fac, Fbn('Cantidad1Ori'))
Acn(s:fac, Fbn('Cantidad2Ori'))
endif
Acn(t:fac, Val(c:fac) - Val(r:fac))
endif

Acn(i:fac, Val(c:fac) + Val(e:fac))
Acn(j:fac, Val(c:fac) + Val(g:fac))
Act(n:fac, FStr(Val(e:fac) * Fbn('TASAIMP1') / 100, 0, 2))

Sqladd(" Update "~Dbo()~".CUOTAS ")
Sqladd(" Set Cantidad3 = "~Val(e:fac)~", ")
Sqladd("     Cantidad2 = "~Val(d:fac)~", ")
Sqladd("     Cantidad9 = "~Val(f:fac)~", ")
Sqladd("     Cantidad1 = "~Val(c:fac)~", ")
Sqladd("     Total3 = "~Val(g:fac)~", ")
Sqladd("     Total4 = "~Val(k:fac)~", ")
Sqladd("     Total9 = "~Val(h:fac)~", ")
if (Eqstr(Fbn('TipoOp'), 'MMPOSM'))
Sqladd("     Total7 = "~Val(l:fac)~", ")
Sqladd("     Cantidad4 = "~Val(m:fac)~", ")
Sqladd("     Precio7 = "~Val(l:fac)~", ")
Sqladd("     Precio8 = "~Val(m:fac)~", ")
else
Sqladd("     Cantidad4 = "~Val(o:fac)~", ")
Sqladd("     Cantidad6 = "~Val(p:fac)~", ")
Sqladd("     Cantidad7 = "~Val(q:fac)~", ")
Sqladd("     Cantidad8 = "~Val(q:fac)~", ")
Sqladd("     Precio7 = "~Val(o:fac)~", ")
Sqladd("     Cantidad1Ori = "~Val(r:fac)~", ")
Sqladd("     Cantidad2Ori = "~Val(s:fac)~", ")
Sqladd("     ResultadoIndice = "~Val(t:fac)~", ")
endif
Sqladd("     Total2 = "~Val(i:fac)~", ")
Sqladd("     Total1 = "~Val(j:fac)~", ")
Sqladd("     PrecioRef1 = '"~Val(n:fac)~"', ")
Sqladd("     Precio5 = "~Val(e:fac)~", ")
Sqladd("     Precio6 = "~Val(k:fac)~" ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd("     and NrCuota = "~Fbn('NrCuota')~" ")
Sqlnew()
Sqlexec()

if (Fbn('NrCuota') = Fbn('Cuotas1'))
SqlActualizarmovimientos2(Fbn()['NrOperacion'], SI, NO, NO, SI)
Sqlexec()
endif
else
Acn(c:fac, Fbn('Cantidad1'))
Acn(d:fac, Fbn('Cantidad2'))
Acn(f:fac, Fbn('Cantidad3') * Fbn('Tasa6') / 100)

Sqladd(" Update "~Dbo()~".CUOTAS ")
Sqladd(" Set Cantidad9 = "~Val(f:fac)~" ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd("    and NrCuota = "~Fbn('NrCuota')~" ")
Sqlnew()
Sqlexec()

Act(z:1, Fbn('NrOperacion'))
endif
