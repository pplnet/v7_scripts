HojaVisible(SI)
mostrarcuadrodemensajes

creardialogo
directorio1: 'Path ';;;;SI;SI;;;;
string1: 'Archivo ';;;;SI;SI;;;;
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar()('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar()('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar()('El directorio '~dialogo.directorio1~' no existe')
endif

let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

importarxls(a:4..g:1000, aa:4..ag:1000, &pf)

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

Act(c:1, 'Nuevas Relaciones Cuenta')
SetFont(c:1, 1)

Act(a:2, 'Nueva - Original')
SetFont(a:2, 2)

SetFilaActual(2)

recorrer&i 4, 1000
if (NoVacio(Val(aa:&i)))
sql.add(" SELECT TiposOperacion, TiposGrupoEsp, Tabla, Residente, Vinculado ")
sql.add(" FROM "~Dbo()~".RELACIONCUENTA ")
sql.add(" WHERE Codigo = '"~Val(aa:&i)~"' ")
recorrer sql
let(&tiposoperacion, Fbn('TiposOperacion'))
let(&tiposgrupoesp, Fbn('TiposGrupoEsp'))
let(&tabla, Fbn('Tabla'))
let(&residente, Fbn('Residente'))
let(&vinculado, Fbn('Vinculado'))

let(&vehiculos, 'BACS|')

let(&cuenta, Val(ae:&i))

sql.add(" SELECT MAX(TRY_CAST(Codigo AS INT))+1 Codigo ")
sql.add(" FROM "~Dbo()~".RELACIONCUENTA ")
recorrer sql
Dfa()
let(&codigo, Fbn('Codigo'))
proximo

sql.add(" INSERT INTO "~Dbo()~".RELACIONCUENTA ")
sql.add(" (Codigo,TiposOperacion,TiposGrupoEsp,Tabla,Residente,Vinculado,Cuenta,Vehiculos) ")
sql.add(" VALUES ")
sql.add(" ('"~FStr(&codigo, 0, 0)~"','"~&tiposoperacion~"','"~&tiposgrupoesp~"','"~&tabla~"','"~&residente~"','"~&vinculado~"','"~FStr(&cuenta, 0, 0)~"','"~&vehiculos~"') ")
sql.new
sql.exec
Act(a:fac, FStr(&codigo, 0, 0)~' - '~FStr(Val(aa:&i), 0, 0))
SetFont(a:fac, 3)

sql.add(" UPDATE "~Dbo()~".RELACIONCUENTA ")
sql.add(" Set Vehiculos = 'BIND|' ")
sql.add(" WHERE Codigo = '"~Val(aa:&i)~"' ")
sql.new
sql.exec
proximo
else
break
endif
proximo

Act(a:fac + 2, 'Fin del informe')
LimitesVision(g:fac + 3)
ACO(1, 12)
