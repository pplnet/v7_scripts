creardialogo
fecha1:"F Real Ej.";1;1;;;;dialogo.fecha1 >= Query("Select Fecha1 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ") y dialogo.fecha1 <= Query("Select Fecha2 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ");'FECHA EJERCICIO REAL TIENE QUE ESTAR EN EL PLAZO DEL PERIODO A EJERCER';NO;FSys()
nroperacion1:"Operacion";;;;;;Eqstr(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTOM');'DEBE INGRESAR UNA OPERACION DE TIPO DTC';NO;;;SQLSet("Select NrOperacion from "~Dbo()~".OPERACIONES where TipoOp = 'DTOM' ")
entero1:"Nro. Settlement";;;;;;dialogo.entero1 > 0;'Debe Indicar el Nro. de Settlement';NO;0;
precio2:"Precio_Ref";;;;;;dialogo.precio2 <= Var('RTASA2') y dialogo.precio2 >= Var('RTASA1');'Tasa Fuera de Rango:'~Var('RTASA1')~" Y "~Var('RTASA2');SI;0
fecha3:"F Settlement";;;;;;dialogo.fecha3 >= dialogo.fecha4;'La Fecha de Settlement debe ser mayor o igual a la Fecha de Fin de Settlement';NO;;Query("Select Fecha3 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
radio1:"Opcion|Europea|Americana|Asiatica";1;2;;NO;;;;;;BuscarCampo('Operaciones', 'TipoOpcion', 'NrOperacion', dialogo.nroperacion1)
radio2:"Tipo|Call|Put";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB1', 'NrOperacion', dialogo.nroperacion1)
radio3:"Operacion de|Compra|/Venta";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB3', 'NrOperacion', dialogo.nroperacion1)
cantidad1:"Notional";;;;NO;;;;;;Query("Select Cantidad1  from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
fecha4:"Fecha Fin Opcion";;;;NO;;;;;;Query("Select Fecha2  from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
precio3:"Precio Ej";;;;NO;;;;;;Query("Select Precio1 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTOM|'))
Cancelar('La operacion N# '~dialogo.nroperacion1~' No es una Opcion MV')
endif

if (ok)
Acn(x1, 0)

Sqladd("Select C.*,O.FechaOp2,O.Plazo2,O.RB8,O.MB1,O.MB3,")
Sqladd("O.TablaFeriados1,O.Cliente1,O.ContraEspecie,O.Vehiculo1,O.Especie ")
Sqladd("from "~Dbo()~".CUOTAS C, "~Dbo()~".OPERACIONES O ")
Sqladd("where C.NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and C.NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
Sqladd("and C.NrOperacion=O.NrOperacion ")

recorrer sql
if (dialogo.radio1 = 1 y (dialogo.fecha1 < Fbn()['Fecha1'] o dialogo.fecha1 > Fbn()['Fecha2']))
Messagebox('NO SE PUEDE EJERCER EN ESTA FECHA PARA UNA OPCION AMERICANA')
break
endif

if (dialogo.radio1 <> 1 y dialogo.fecha1 <> Fbn()['Fecha2'])
Messagebox('NO SE PUEDE EJERCER EN ESTA FECHA PARA UNA OPCION EUROPEA O ASIATICA')
break
endif

Acn(x1, 1)

Message('Verificando Fecha de Settlement .... ')

if (not EsHabil(dialogo.fecha3, Fbn()['TablaFeriados1']))
Messagebox('La Fecha de Settlement NO ES Dia Habil en la Tabla de Feriados '~Fbn()['TablaFeriados1'])
break
endif

Acn(x1, 1)

Acn(z20, 0)
Acd(z10, Fbn()['FechaOp2'] + Fbn()['Plazo2'])
Acn(z11, Fbn()['RB8'])
Acn(z11, Val(z11) + 1)

if (Eqstr(Fbn()['MB1'], '0') y Eqstr(Fbn()['MB3'], '0'))
if (dialogo.precio3 >= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad1'] * (dialogo.precio2 - dialogo.precio3)) / 100) * FactorDias(Fbn()['Fecha5'], Fbn()['Fecha6'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '0') y Eqstr(Fbn()['MB3'], '1'))
if (dialogo.precio3 >= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad1'] * (dialogo.precio3 - dialogo.precio2)) / 100) * FactorDias(Fbn()['Fecha5'], Fbn()['Fecha6'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '1') y Eqstr(Fbn()['MB3'], '0'))
if (dialogo.precio3 <= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad1'] * (dialogo.precio3 - dialogo.precio2)) / 100) * FactorDias(Fbn()['Fecha5'], Fbn()['Fecha6'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '1') y Eqstr(Fbn()['MB3'], '1'))
if (dialogo.precio3 <= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad1'] * (dialogo.precio2 - dialogo.precio3)) / 100) * FactorDias(Fbn()['Fecha5'], Fbn()['Fecha6'], Val(z11)))
endif
endif

Sqladd("Update "~Dbo()~".CUOTAS ")
Sqladd("Set ")
Sqladd("Total1 = "~FStr(Val(z20), 0, 5)~", ")
Sqladd("Fecha3 ='"~IdxDate(dialogo.fecha3)~"', ")
Sqladd("Precio2="~FStr(dialogo.precio2, 0, 5)~", ")
Sqladd("Fecha4 ='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("where NrOperacion = '"~dialogo.nroperacion1~"' ")
Sqladd("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
Sqlnew()
Sqlexec()

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
Sqladd("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', Val(az5), 'nroperacion1', Val(az3))
endif

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
Sqlnew()
Sqlexec()




if (Val(z20) <> 0)
endif

Sqlactualizarmovimientos(dialogo.nroperacion1, SI)
Sqlexec()
proximo

if (Val(x1) = 0)
Cancelar('La operacion N# '~dialogo.nroperacion1~' No puede ser Ejercida')
