creardialogo
nroperacion1: 'Op  Desde'
nroperacion2: 'Op. Hasta'
string:'Condicion de Insert'
findialogo

if (not ok)
Cancelar()
endif

Message('Generando Comisiones Operacion '~dialogo.nroperacion2~' Vinculada ...')

Sqladd("INSERT INTO "~Dbo()~".COMISIONES2 ")
Sqladd(" SELECT '"~dialogo.nroperacion2~"' As NrOperacion,Tipo,Tasa1,Tasa2,Tasa3,  ")
Sqladd(" Especie1,Especie2,Fecha1,Fecha2,Cliente1,Cliente2,Importe1,Importe2,Importe3,")
Sqladd(" Importe4,RB1,RB2,RB3,RB4,NrComision,Importe5,Precio1,Precio2,NrCuota,Cotizacion1,Cotizacion2,Cantidad1,Cantidad2,Alias1,Alias2  ")
Sqladd(" FROM "~Dbo()~".COMISIONES2 WHERE NrOperacion='"~dialogo.nroperacion1~"' AND "~dialogo.string~" ")
Sqlnew()
Sqlexec()

Acn(z1, BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', dialogo.nroperacion2))
Acn(z2, BuscarCampo('Operaciones', 'Plazo', 'NrOperacion', dialogo.nroperacion2))
Acd(z3, BuscarCampo('Operaciones', 'FechaVto', 'NrOperacion', dialogo.nroperacion2))

Sqladd(" SELECT  NrOperacion, Tipo,Tasa1,Tasa2,Tasa3,Especie1,Especie2,Fecha1,Fecha2,Cliente1,Cliente2,Importe1,Importe2,Importe1,    ")
Sqladd("   Importe2,Importe3,Importe4,RB1,RB2,RB3,RB4,NrComision,Importe5,Precio1,Precio2,NrCuota,Cotizacion1,Cotizacion2,Cantidad1,Cantidad2,Alias1,Alias2 ")
Sqladd(" FROM "~Dbo()~".COMISIONES2 WHERE NrOperacion='"~dialogo.nroperacion2~"' AND "~dialogo.string~" ")
recorrer sql


if (Incluido(Fbn()['Tipo'], '0|1|2|5'))
Acn(a1, Val(z1) * Fbn()['Tasa1'] / 100)
endif

if (Incluido(Fbn()['Tipo'], '3'))
Acn(a1, Val(z1) * Fbn()['Tasa1'] * Val(z2) / iif (Eqstr(Fbn()['RB2'], '0'), 36000, 36500))
endif

Acn(a2, Val(a1) * Fbn()['Tasa2'] / 100)
Acn(a3, Val(a1) * Fbn()['Tasa3'] / 100)
Acn(a5, Val(a1) * Fbn()['Precio1'] / 100)
Acn(a4, Val(a1) + Val(a3) + Val(a5))

Sqladd("Update "~Dbo()~".COMISIONES2 SET ")
Sqladd(" Fecha1= '"~IdxDate(Fbn()['Fecha1'])~"', ")
Sqladd(" Importe1= "~FStr(Val(a1), 0, 2)~", ")
Sqladd(" Importe2= "~FStr(Val(a2), 0, 2)~", ")
Sqladd(" Importe3= "~FStr(Val(a3), 0, 2)~", ")
Sqladd(" Precio2 = "~FStr(Val(a5), 0, 2)~", ")
Sqladd(" Importe4= "~FStr(Val(a4), 0, 2)~" ")
Sqladd(" WHERE NrOperacion='"~dialogo.nroperacion2~"' AND NrComision="~Fbn()['NrComision']~" ")
Sqlnew()
Sqlexec()
proximo

