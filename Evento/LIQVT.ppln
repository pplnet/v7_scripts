MostrarCuadroDeMensajes()
creardialogo
nrtrans1: 'NrTrans'

findialogo

if (not ok)
Cancelar()
endif

if (Query(" SELECT 1 FROM "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T WHERE M.NrTrans2 = '"~dialogo.nrtrans1~"' AND M.NrOperacion = T.NrTrans AND T.TipoTr2 = 'TRANSP' ") = 1)
Sqladd(" SELECT M.NrOperacion, 'TR' Tipo, M.NrTrans2 FROM "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T ")
Sqladd(" WHERE  M.NrTrans2    = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND    M.NrOperacion = T.NrTrans ")
Sqladd(" AND    M.NrOperacion <> M.NrTrans2 ")
Sqladd(" UNION ")
Sqladd(" SELECT M.NrOperacion, 'OP' Tipo, M.NrTrans2 FROM "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".OPERACIONES T ")
Sqladd(" WHERE  M.NrTrans2    = '"~dialogo.nrtrans1~"' ")
Sqladd(" AND    M.NrOperacion = T.NrOperacion ")
Sqladd(" AND    M.NrOperacion <> M.NrTrans2 ")
recorrer sql
Act(a:fac, dialogo.nrtrans1)
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('NrTrans2'))
Message(Val(a:fac)~' - '~Val(b:fac)~' - '~Val(c:fac))
Sqladd("INSERT INTO "~Dbo()~".LIQUIDACIONESVT (NrTrans, NrOperacion, NrTrans2, Fecha1) VALUES ('"~Val(a:fac)~"', '"~Val(b:fac)~"', '"~Val(c:fac)~"', "~IdxDate2(FSys())~") ")
Sqlnew()
if (Eqstr(Fbn('Tipo'), 'TR'))
Act(op:1, Fbn('NrOperacion'))
recorrer&i 1, 10000
Acn(x:1, 0)
Sqladd(" SELECT T.NrTrans, M.NrOperacion, 'OP' Tipo, M.NrTrans2 FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".OPERACIONES O  ")
Sqladd(" WHERE  T.NrTransRef1 = '"~Val(op:1)~"' AND T.NrTrans =M.NrTrans2 AND M.NrOperacion = O.NrOperacion AND M.NrOperacion <> M.NrTrans2  ")
Sqladd(" UNION ")
Sqladd(" SELECT T.NrTrans, M.NrOperacion, 'TR' Tipo, M.NrTrans2 FROM "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".MOVEJECUTADOS M, "~Dbo()~".TRANSACCIONES2 T2  ")
Sqladd(" WHERE  T.NrTransRef1 = '"~Val(op:1)~"' AND T.NrTrans =M.NrTrans2 AND M.NrOperacion = T2.NrTrans AND M.NrOperacion <> M.NrTrans2  ")
recorrer sql
if (Eqstr(Fbn('Tipo'), 'TR'))
Act(op:1, Fbn('NrOperacion'))
Acn(x:1, 1)
endif
Act(a:fac, dialogo.nrtrans1)
Act(b:fac, Fbn('NrOperacion'))
Act(c:fac, Fbn('NrTrans2'))
Message(Val(a:fac)~' - '~Val(b:fac)~' - '~Val(c:fac))
Sqladd("INSERT INTO "~Dbo()~".LIQUIDACIONESVT (NrTrans, NrOperacion, NrTrans2, Fecha1) VALUES ('"~Val(a:fac)~"', '"~Val(b:fac)~"', '"~Val(c:fac)~"', "~IdxDate2(FSys())~") ")
Sqlnew()
proximo
if (Val(x:1) = 0)
Message('* Ya no encontro mas VT.')
break
endif
proximo
endif
proximo
Sqlexec()
endif

