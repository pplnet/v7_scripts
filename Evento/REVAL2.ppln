creardialogo
fecha1:'Fecha';;;;;;dialogo.fecha1 <= FSys();'La Fecha NO DEBE ser superior a la fecha del sistema';NO;FSys()
especie1: 'Especie';
findialogo

if (not ok)
Cancelar()
endif



sql.add(" SELECT  P.*  FROM "~Dbo()~".POSICIONES P  ")
sql.add(" where P.Fecha <= "~IdxDate2(dialogo.fecha1)~"  ")
sql.add(" AND   (P.CantidadFin <> 0  OR P.CantidadIni<>0 )  ")
sql.add(" AND   (P.TipoNegocio <> 'TIT' OR P.TipoNegocio IS NULL)  ")
sql.add(" AND   P.Especie     <> '"~Var('MONELOCA')~"'  ")
if (NoVacio(dialogo.especie1))
sql.add(" AND  P.Especie = '"~dialogo.especie1~"'  ")
endif
sql.add(" AND     P.Fecha IN (SELECT MAX(Fecha) FROM "~Dbo()~".POSICIONES ")
sql.add("                    WHERE  Especie  = P.Especie  ")
sql.add("                     AND   Fecha   <= "~IdxDate2(dialogo.fecha1))
sql.add("                     AND   Especie     <> '"~Var('MONELOCA')~"'  ")
sql.add("                     AND   NrSaldo  = P.NrSaldo  ")
sql.add("                     AND   Vehiculo = P.Vehiculo ")
sql.add("                     AND   Book     = P.Book     ")
sql.add("                     AND   Cliente  = P.Cliente  ")
sql.add("                     AND   (Trader       = P.Trader       OR ((Trader       IS NULL OR Trader=''       OR Trader=' ')       AND (P.Trader       IS NULL OR P.Trader=''       OR P.Trader=' '       )) )  ")
sql.add("                     AND   (TipoNegocio  = P.TipoNegocio  OR ((TipoNegocio  IS NULL OR TipoNegocio=''  OR TipoNegocio=' ')  AND (P.TipoNegocio  IS NULL OR P.TipoNegocio=''  OR P.TipoNegocio=' '  )) )  ")
sql.add("                     AND   (Responsable  = P.Responsable  OR ((Responsable  IS NULL OR Responsable=''  OR Responsable=' ')  AND (P.Responsable  IS NULL OR P.Responsable=''  OR P.Responsable=' '  )) )  ")
sql.add("                     AND   (TipoPosicion = P.TipoPosicion OR ((TipoPosicion IS NULL OR TipoPosicion='' OR TipoPosicion=' ') AND (P.TipoPosicion IS NULL OR P.TipoPosicion='' OR P.TipoPosicion=' ' )) )  ")
sql.add("                     AND   (Producto     = P.Producto     OR ((Producto     IS NULL OR Producto=''     OR Producto=' ')     AND (P.Producto     IS NULL OR P.Producto=''     OR P.Producto=' '     )) )  ")
sql.add("                     AND   (GrupoEspecie = P.GrupoEspecie OR ((GrupoEspecie IS NULL OR GrupoEspecie='' OR GrupoEspecie=' ') AND (P.GrupoEspecie IS NULL OR P.GrupoEspecie='' OR P.GrupoEspecie=' ' )) )  ")
sql.add("                     AND   (Unidad       = P.Unidad       OR ((Unidad       IS NULL OR Unidad=''       OR Unidad=' ')       AND (P.Unidad       IS NULL OR P.Unidad=''       OR P.Unidad=' '       )) )  ")
sql.add("                     AND   (Centro       = P.Centro       OR ((Centro       IS NULL OR Centro=''       OR Centro=' ')       AND (P.Centro       IS NULL OR P.Centro=''       OR P.Centro=' '       )) )  ")
sql.add("                     AND   (Sector       = P.Sector       OR ((Sector       IS NULL OR Sector=''       OR Sector=' ')       AND (P.Sector       IS NULL OR P.Sector=''       OR P.Sector=' '       )) )  ")
sql.add("                     AND   (Sucursal     = P.Sucursal     OR ((Sucursal     IS NULL OR Sucursal=''     OR Sucursal=' ')     AND (P.Sucursal     IS NULL OR P.Sucursal=''     OR P.Sucursal=' '     )) )  ")
sql.add("                     AND   (CallPut      = P.CallPut      OR ((CallPut      IS NULL OR CallPut=''      OR CallPut=' ')      AND (P.CallPut      IS NULL OR P.CallPut=''      OR P.CallPut=' '      )) )  ")
sql.add("                     AND   (Estrategia   = P.Estrategia   OR ((Estrategia   IS NULL OR Estrategia=''   OR Estrategia =' ')   AND (P.Estrategia  IS NULL OR P.Estrategia=''   OR P.Estrategia=' '   )) )  ")
sql.add("                     AND   (PrecioEj     = P.PrecioEj     OR ((PrecioEj     IS NULL OR PrecioEj=0) AND (P.PrecioEj IS NULL OR P.PrecioEj=0  )) )  ")
sql.add("                     AND   (FechaEj      = P.FechaEj      OR (FechaEj IS NULL AND P.FechaEj IS NULL) )   ")
sql.add("                     AND   (Cartera      = P.Cartera      OR ((Cartera      IS NULL OR Cartera=''      OR Cartera=' ')       AND (P.Cartera     IS NULL OR P.Cartera=''      OR P.Cartera=' '      )) )  ")
sql.add("  ) ")

recorrer sql
