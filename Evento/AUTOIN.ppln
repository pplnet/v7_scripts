Sqladd("SELECT Tipo, Autorizado FROM "~Dbo()~".EXCEPCIONES")
Sqladd(" Where NrOperacion='"~dialogo.nroperacion1~"' ")

if (dialogo.cantidad1 = 19)
Sqladd(" AND Tipo in ('TASATMOD','RANGOTRANS')")
else
if (dialogo.cantidad1 = 8)
Sqladd(" AND Tipo in ('FVALOR')")
else
if (dialogo.cantidad1 = 2)
Sqladd(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
else
if (dialogo.cantidad1 = 3)
Sqladd(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
endif
endif
endif
endif

