sql.add("SELECT Tipo, Autorizado FROM "~Dbo()~".EXCEPCIONES")
sql.add(" Where NrOperacion='"~dialogo.nroperacion1~"' ")

if (dialogo.cantidad1 = 19)
sql.add(" AND Tipo in ('TASATMOD','RANGOTRANS')")
else
if (dialogo.cantidad1 = 8)
sql.add(" AND Tipo in ('FVALOR')")
else
if (dialogo.cantidad1 = 2)
sql.add(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
else
if (dialogo.cantidad1 = 3)
sql.add(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
endif
endif
endif
endif

recorrer sql
