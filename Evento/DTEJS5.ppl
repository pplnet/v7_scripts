CrearDialogo
  Fecha1       : "F Real Ej."               ;1;1;;;;Dialogo.Fecha1=Dialogo.Fecha2;'FECHA EJERCICIO REAL TIENE QUE SER IGUAL A FECHA RESET';NO;Fsys
  NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTSFVV');'DEBE INGRESAR UNA OPERACION DE TIPO DTC';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'DTSFVV' ")
  Precio2      : "Tasa Variable"            ;;;;;;Dialogo.Precio2<=VAR('RTASA2') Y Dialogo.Precio2>=VAR('RTASA1');'Tasa del Vehiculo Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;0;;;;"###.#########"
  Fecha2       : "F Reset"                  ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaPrecan','NrOperacion',Dialogo.NrOperacion1);
  Fecha3       : "F Settlement"             ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaPago','NrOperacion',Dialogo.NrOperacion1);
  Fecha4       : "Fecha Fin Swap"           ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
  NrOperacion2 : "Op. Cpte."                ;;;;NO;;;;;;BuscarCampo('Operaciones','NrOperacion3','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTSFVV|')
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es un Swap Fijo Variable')
endif

If BuscarCampo('Operaciones','CB6','NrOperacion',Dialogo.NrOperacion1)=0
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es la operacion Original')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )
ACN(X2,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion2~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Original Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

if BuscarCampo('Operaciones','MB4','NrOperacion',Dialogo.NrOperacion1)=0
If VAL(X2)<>20 y VAL(X2)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Vinculada Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X2),0,0)~" AND Tabla='OPERACIONES'") )
EndIf
ENDIF

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)


   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
*   SQL.ADD("and (CB8 is Null or CB8='0') ")  

   Recorrer SQL

      IF [NOT ESHABIL(Dialogo.Fecha3,FBN['TablaFeriados1'])]
         MESSAGEBOX('FECHA SETTLEMENT NO HABIL EN TABLA DE FERIADOS '~FBN['TablaFeriados1'] )        
         Break     
      ENDIF

      *** CALCULA EL INT PAY Y RES SEGUN SEA FIX O FLOAT EL VEHICULO
  
      *** Z11 DAY COUNT +1 YA QUE LA FUNCION LO REQUIERE ASI
      *** Z24 ES EL INTEREST PAYMENT
      *** Z20 ES EL RESULTADO
      acn(x1,1)

      ACN (Z24, 0)
      ACN (z20, 0)    

      Message ('Calculando interes .... ')                  
      *** interes

      ** Z26: Especie del Movimiento Z27: Signo del Interes
      IF FBN['RB9']=1
         ACN (Z11, (FBN['RB8']+1))
         ACN (Z24, ((FBN['Cantidad']*(Dialogo.Precio2+FBN['Spread']))/100)*FACTORDIAS(FBN['FechaOp2'],FBN['FechaEj'],VAL(Z11)))
         ACT(Z26,FBN['Especie'])
         ACN(Z27,VAL(Z24))
      ELSE
         ACN (Z11, (FBN['RB5']+1))
         ACN (Z24, ((FBN['TotalBrutoCli1']*(Dialogo.Precio2+FBN['TotalNetoCli2']))/100)*FACTORDIAS(FBN['FechaOp2'],FBN['FechaEj'],VAL(Z11)))
         ACT(Z26,FBN['ContraEspecie'])
         ACN(Z27,-VAL(Z24))
      ENDIF

      Message ('Calculando resultado .... ')                       
      IF EqStr(FBN['Especie'], FBN['ContraEspecie'])
         IF FBN['RB9']=1
            ACN (Z20, FBN['InteresesCorr']-VAL(Z24))
         ELSE
            ACN (Z20, VAL(Z24)-FBN['TotalIntereses'])
         ENDIF
      ENDIF
 
      Message ('Actualizando la Opcion .... ')                  
 
      *** Marca la operacion como ejercida ***
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set CB8 = '1', ")
      SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
      SQL.ADD("FechaPrecan = '"~IdxDate(Dialogo.Fecha2)~"', ")
      SQL.ADD("Precio4   = "~Fstr(VAL(z20),0,2)~", ")
 
      IF FBN['RB9']=1
         SQL.ADD("Precio3   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("TotalIntereses   = "~Fstr(VAL(z24),0,7)~"  ")
      else
         SQL.ADD("TotalGanancias   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("InteresesCorr   = "~Fstr(VAL(Z24),0,7)~"  ")
      endif    

      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.NEW
      SQL.EXEC

      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)      

     *** Actualiza movimientos y limites ****
     SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
     SQL.EXEC

    if BuscarCampo('Operaciones','MB4','NrOperacion',Dialogo.NrOperacion1)=0
      Message ('Actualizando la Opcion vinculada .... ')                  
 
      *** Marca la operacion vin como ejercida
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set CB8 = '1', ")
      SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
      SQL.ADD("FechaPrecan = '"~IdxDate(Dialogo.Fecha2)~"', ")
      SQL.ADD("Precio4   = "~Fstr(-VAL(z20),0,2)~", ")
 
      IF FBN['RB9']=1
         SQL.ADD("TotalGanancias   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("InteresesCorr   = "~Fstr(VAL(Z24),0,7)~"  ")
      else
         SQL.ADD("Precio3   = "~Fstr(Dialogo.Precio2,0,7)~",  ")
         SQL.ADD("TotalIntereses   = "~Fstr(VAL(z24),0,7)~"  ")
      endif    

      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion2~"' ")
      SQL.NEW
      SQL.EXEC

      * Actualizo la Instancia de la Operacion a Supervision
      act(i3, Dialogo.NrOperacion2)
      (.'MODIINSTAN'.)      

     *** Actualiza movimientos y limites ****
     SQL.ActualizarMovimientos(Dialogo.NrOperacion2,SI)
     SQL.EXEC

    ENDIF

   proximo

   If Val(x1)=0
      Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif

