MostrarCuadroDeMensajes()
creardialogo
nrunicoasiento1: 'Asiento';;;;;dialogo.check1 = 0;dialogo.check1 = 1 o NoVacio(dialogo.nrunicoasiento1);'Asiento Invalido';NO;
radio1: 'Genera|Anulacion|N.Credito';;;;;;dialogo.radio1 >= 0;'Indique si Genera Anulacion o Nota de Credito';NO;
check1: 'Filtra Fechas';;;;;;;;;;;;;;;;;;;
fecha1: 'Fecha Ejec';5;;;;dialogo.check1 = 1;;;;FSys();
fecha2: 'Fecha Gen';6;;;;dialogo.check1 = 1;;;;FSys();
lista1: 'Asientos';8;;;;dialogo.check1 = 1;dialogo.check1 = 0 o Elementos(dialogo.lista1) >= 1;'Debe Elegir al Menos un Asiento';NO;;;iif (dialogo.check1 = 1, SQLSet(" Select NrUnicoAsiento From "~Dbo()~".ASIENTOSCON Where FechaGeneracion = '"~IdxDate(dialogo.fecha2)~"' AND Fecha1 = '"~IdxDate(dialogo.fecha1)~"' "))
findialogo

if (not ok)
Cancelar()
endif

Acn(bd:1, 0)
Sqladd(" Select DISTINCT MA.Codigo as CodAsi, AC.FechaGeneracion, AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, ")
Sqladd(" AC.NrLote, AC.NrUnicoAsiento, AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento, AC.Fecha1 ")
Sqladd(" From "~Dbo()~".MODELOSASIENTO MA, "~Dbo()~".ASIENTOSCON AC ")
if (dialogo.check1 = 0)
Sqladd(" Where AC.NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' ")
else
Sqladd(" Where AC.NrUnicoAsiento IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
Sqladd(" AND MA.Codigo = AC.Modelo ")
Sqladd(" AND AC.Estado = 'E' ")
Sqladd(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
Sqladd(" order by AC.NrUnicoAsiento ")
recorrer sql
Message('Operacion '~Fbn('NrOperacion'))
if (dialogo.radio1 = 0)
Act(tp:1, 'COT')
else
Act(tp:1, 'NC')
endif
Acn(bd:1, 1)
Act(nn:1, getnumerador(810))
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON ")
Sqladd(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
Sqladd(" Modelo, Book, UDN, Centro, ")
Sqladd(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
Sqladd(" NrOperacion, NrTrans2, Estado, Fecha1) ")
Sqladd(" VALUES ")
Sqladd(" ("~IdxDate2(FSys())~", "~IdxDate2(Fbn('FechaValor'))~", '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
Sqladd(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
Sqladd(" '"~Fbn('Sector')~"', '"~Fbn('NrLote')~"', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Val(tp:1)~"', "~IdxDate2(Fbn('Fecha1'))~")  ")
Sqlnew()
Sqladd(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
Sqladd(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
Sqladd(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
Sqladd(" Especie2, Especie3, Cantidad1, Cantidad2, ")
Sqladd(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
Sqladd(" Alias2, Alias3, Alias4, Alias5, ")
Sqladd(" Detalle, CentroCosto, Book, ")
Sqladd(" Alias6, Alias7, Alias8, ")
Sqladd(" Alias9, Alias10, Valor1, ")
Sqladd(" Valor2, Valor3 ")
Sqladd(" ) VALUES ( ")
Sqladd(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
Sqladd(" 'CRE', ")
else
Sqladd(" 'DEB', ")
endif
Sqladd(" '"~Fbn('Especie1')~"', ")
Sqladd(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
Sqladd(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
Sqladd(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', '"~Fbn('Alias4')~"', '"~Fbn('Alias5')~"', ")
Sqladd(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', ")
Sqladd(" '"~Fbn('Alias6')~"', '"~Fbn('Alias7')~"', '"~Fbn('Alias8')~"', ")
Sqladd(" '"~Fbn('Alias9')~"', '"~Fbn('Alias10')~"', "~FStr(Fbn('Valor1'), 0, 2)~", ")
Sqladd(" "~FStr(Fbn('Valor2'), 0, 8)~", "~FStr(Fbn('Valor3'), 0, 2)~") ")
Sqlnew()
proximo
Sqlexec()
Sqladd(" Update "~Dbo()~".ASIENTOSCON ")
Sqladd(" Set NrAsiento = '"~Val(nn:1)~"' ")
Sqladd(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
Sqlnew()
Sqlexec()
