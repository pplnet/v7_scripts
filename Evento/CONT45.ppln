Act(nn:1, getnumerador(810))
sql.add(" INSERT INTO "~Dbo()~".ASIENTOSCON ")
sql.add(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
sql.add(" Modelo, Book, UDN, Centro, ")
sql.add(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
sql.add(" NrOperacion, NrTrans2, Estado, Fecha1) ")
sql.add(" VALUES ")
sql.add(" ("~IdxDate2(FSys())~", "~IdxDate2(Fbn('FechaValor'))~", '"~Fbn('Vehiculo')~"', '"~Fbn('Libro')~"', ")
sql.add(" '"~Fbn('Modelo')~"', '"~Fbn('Book')~"', '"~Fbn('UDN')~"', '"~Fbn('Centro')~"', ")
sql.add(" '"~Fbn('Sector')~"', '"~Fbn('NrLote')~"', '"~Fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
sql.add(" '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Val(tp:1)~"', "~IdxDate2(Fbn('Fecha1'))~")  ")
sql.new
sql.add(" SELECT * FROM "~Dbo()~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"'  ")
recorrer sql
sql.add(" INSERT INTO "~Dbo()~".ASIENTOSCON1 ")
sql.add(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
sql.add(" Especie2, Especie3, Cantidad1, Cantidad2, ")
sql.add(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
sql.add(" Alias2, Alias3, Alias4, Alias5, ")
sql.add(" Detalle, CentroCosto, Book, ")
sql.add(" Alias6, Alias7, Alias8, ")
sql.add(" Alias9, Alias10, Valor1, ")
sql.add(" Valor2, Valor3 ")
sql.add(" ) VALUES ( ")
sql.add(" '"~Val(nn:1)~"', '"~Fbn('Cuenta')~"', ")
if (Eqstr(Fbn('DebitoCredito'), 'DEB'))
sql.add(" 'CRE', ")
else
sql.add(" 'DEB', ")
endif
sql.add(" '"~Fbn('Especie1')~"', ")
sql.add(" '"~Fbn('Especie2')~"', '"~Fbn('Especie3')~"', "~FStr(Fbn('Cantidad1'), 0, 8)~", "~FStr(Fbn('Cantidad2'), 0, 8)~", ")
sql.add(" "~FStr(Fbn('Cantidad3'), 0, 8)~", '"~Fbn('NrOperacion')~"', '"~Fbn('NrTrans2')~"', '"~Fbn('Alias1')~"', ")
sql.add(" '"~Fbn('Alias2')~"', '"~Fbn('Alias3')~"', '"~Fbn('Alias4')~"', '"~Fbn('Alias5')~"', ")
sql.add(" '"~Fbn('Detalle')~"', '"~Fbn('CentroCosto')~"', '"~Fbn('Book')~"', ")
sql.add(" '"~Fbn('Alias6')~"', '"~Fbn('Alias7')~"', '"~Fbn('Alias8')~"', ")
sql.add(" '"~Fbn('Alias9')~"', '"~Fbn('Alias10')~"', "~FStr(Fbn('Valor1'), 0, 2)~", ")
sql.add(" "~FStr(Fbn('Valor2'), 0, 8)~", "~FStr(Fbn('Valor3'), 0, 2)~") ")
sql.new
proximo
sql.exec
sql.add(" Update "~Dbo()~".ASIENTOSCON ")
sql.add(" Set NrAsiento = '"~Val(nn:1)~"' ")
sql.add(" Where NrUnicoAsiento = '"~Fbn('NrUnicoAsiento')~"' ")
sql.new
sql.exec
