ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

********************************************************************
* Retrocedo Instancias de Transacciones de Operaciones
* Fecha..............: 01/Sept/2004
* Ultima modificacisn: 
