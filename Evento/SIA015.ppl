*********************************************************************

HojaVisible(NO)

CrearDialogo
   String1     : 'Nr.Operacion'         ;;;;;;;;;;;;;;;;
FinDialogo


If Not OK
   Cancelar
endif

*-- Select
  SQL.ADD(" Select /*+ RULE */ a.*, b.nrbit, b.valor   " )
  SQL.ADD("   from   "~DBO~".transacciones2 a  " )
  SQL.ADD("     ,    "~DBO~".operacionesbits b  " )
  SQL.ADD("   where a.nroperacionref1 ='"~Dialogo.String1~"'  ")
  SQL.ADD("     and b.nroperacion = a.nrtrans  ")
  SQL.ADD("     and b.nrbit > 17 and b.nrbit < 21 ")
  SQL.ADD("     and b.valor = '1'                 ")

*-- Busco Transaccion
        If NoVacio(UsrVehiculos(UsuarioActivo))
           SQL.ADD("  AND A.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
        endif

  SQL.ADD("      order by a.nrtrans ")
*-- 

Recorrer SQL
   Message(' Usuario '~FBN['Nrtrans']~' '~FBN['Tipotr2']~' ...')

       ACT(a:fac,FBN['Nrtrans'])
       ACT(b:fac,FBN['Tipotr2'])
       ACT(c:fac,FBN['Especie'])
       ACT(d:fac,FBN['Cliente1'])
       ACT(e:fac,FBN['Cuenta1'])
       ACT(f:fac,FBN['Cliente2'])
       ACT(g:fac,FBN['Cuenta2'])
       ACN(h:fac,FBN['Cantidad1'])
       ACD(i:fac,FBN['Fecha1'])
       ACD(j:fac,FBN['Fecha2'])
       ACT(k:fac,FBN['CB2'])
       ACT(l:fac,FBN['CB4'])
       ACT(n:fac,FBN['Vehiculo1'])
       ACT(o:fac,FBN['CB6'])
       ACT(p:fac,FBN['CB8'])
       ACD(q:fac,FBN['Fecha5'])
       ACT(r:fac,FBN['CB10'])

       ACN(z:fac, 1 )

Proximo

If fac>0

   CrearListBox;'Arial,10,B'
     'Retroce'              ; z1..k:fac; SI; SI;;70; COMBO; 'Si|No|'
     'Nrtrans'              ; a1..a:fac; NO; SI;;70; STRING
     'Tipo T'               ; b1..b:fac; NO; SI;;70; STRING
     'Especie'              ; c1..c:fac; NO; SI;;70; STRING
     'Cliente1'             ; d1..d:fac; NO; SI;;80; STRING
     'Cuenta1'              ; e1..e:fac; NO; SI;;90; STRING
     'Cliente2'             ; f1..f:fac; NO; SI;;80; STRING
     'Cuenta2'              ; g1..g:fac; NO; SI;;90; STRING
     'Cantidad1'            ; h1..h:fac; NO; SI;;100; STRING
     'Fecha1'               ; i1..i:fac; NO; SI;;70; STRING
     'Fecha2'               ; j1..j:fac; NO; SI;;70; STRING
     'CB2'                  ; k1..k:fac; NO; SI;;50; STRING
     'CB4'                  ; l1..l:fac; NO; SI;;50; STRING
     'Vehiculo'             ; n1..n:fac; NO; SI;;80; STRING
     'CB6'                  ; o1..o:fac; NO; SI;;50; STRING
     'CB8'                  ; p1..p:fac; NO; SI;;50; STRING
     'Fecha5'               ; q1..q:fac; NO; SI;;230; STRING
     'CB10'                 ; r1..r:fac; NO; SI;;50; STRING

   FinListBox

   If Ok 
      Recorrer&i 1,fac
       If Val(z:&i)=0
 
        SQL.ADD(" Update /*+ RULE */ "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '0' ")
*        SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.ADD(" Where NrOperacion = '"~val(a:&i)~"' ")
        SQL.ADD(" AND NrBit > 17 and NrBit < 21 ")
        SQL.ADD(" AND Valor = '1' ")
        SQL.NEW


        ACN(XX:2, 0)
        ACN(xx:2, SQL(" SELECT /*+ RULE */ 1 FROM "~DBO~".Operacionesbits WHERE NrOperacion = '"~val(a:&i)~"' and nrbit = 1 "))
*         MessageBox('Que encontro: '~val(xx:2))
        IF Val(XX:2) > 0
            ACN(XX:2, 0)
            SQL.ADD(" Update /*+ RULE */ "~DBO~".OPERACIONESBITS ")
            SQL.ADD(" Set Valor = '1' ")
*           SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
            SQL.ADD(" Where NrOperacion = '"~val(a:&i)~"' ")
            SQL.ADD(" AND NrBit = 1 ")
            SQL.NEW
        ELSE
            SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS ")
            SQL.ADD("( NrOperacion, NrBit, Valor ) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~val(a:&i)~"',  ")
            SQL.ADD("  1,  '1' ) ")
            SQL.NEW
        ENDIF


        SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
        SQL.ADD("( NrOperacion, NrInstancia, Usuario, Mensaje, Fecha ) ")
        SQL.ADD(" Values ")
*        SQL.ADD("( '"~Copy(Val(a:&i)), 1, 8)~"', ")
        SQL.ADD("( '"~val(a:&i)~"', ")
        SQL.ADD(" 1, '"~UsuarioActivo~"',  ")
        SQL.ADD("  'SIA015', ")
        SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
        SQL.NEW
        SQL.EXEC

         MessageBox('En Aprobacion de Voucher: '~val(a:&i))
      endif
      Proximo
   else
      Cancelar
   Endif
Else
   MessageBox('No existen transacciones para la seleccion')

EndIf

