sql.add("Select * from "~Dbo()~".POSICIONES P ")
sql.add(" where P.Fecha       <= "~IdxDate2(dialogo.fecha1)~" ")
sql.add("   and P.Especie     = '"~dialogo.especie1~"' ")
sql.add("   and P.Vehiculo    = '"~Val(i:1)~"' ")
sql.add("   and P.Cupon       = "~FStr(Val(i:2), 1, 0)~" ")
sql.add("   and P.Book        = '"~dialogo.book1~"' ")
sql.add("   and P.NrSaldo in (31,51) ")
sql.add("   and P.CantidadFin <> 0  ")
sql.add("   AND P.Fecha IN (SELECT MAX(Fecha) from "~Dbo()~".POSICIONES P1 ")
sql.add("                   WHERE P1.Especie    = P.Especie  ")
sql.add("                   AND   P1.Vehiculo   = P.Vehiculo ")
sql.add("                   AND   P1.NrSaldo    = P.NrSaldo  ")
sql.add("                   AND   P1.Cliente    = P.Cliente  ")
sql.add("                   AND   P1.Book       = P.Book     ")
sql.add("                   AND  (P1.Sector     = P.Sector     OR (P1.Sector     IS NULL AND P.Sector     IS NULL) ) ")
sql.add("                   AND  (P1.CallPut    = P.CallPut    OR (P1.CallPut    IS NULL AND P.CallPut    IS NULL) ) ")
sql.add("                   AND  (P1.Cupon      = P.Cupon      OR (P1.Cupon      IS NULL AND P.Cupon      IS NULL) ) ")
sql.add("                   AND  (P1.Estrategia = P.Estrategia OR (P1.Estrategia IS NULL AND P.Estrategia IS NULL) ) ")
sql.add("                   AND  (P1.FechaEj    = P.FechaEj    OR (P1.FechaEj    IS NULL AND P.FechaEj    IS NULL) ) ")
sql.add("                   AND  (P1.PrecioEj   = P.PrecioEj   OR (P1.PrecioEj   IS NULL AND P.PrecioEj   IS NULL) ) ")
sql.add("                   AND  P1.Fecha      <= "~IdxDate2(dialogo.fecha1)~" ")
sql.add("                 ) ")
sql.add("order by Especie,Book,NrSaldo,Cupon,Fecha                 ")

recorrer sql
