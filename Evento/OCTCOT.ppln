Acn(bd:1, 0)
Sqladd(" Select * From "~Dbo()~".COTIZACIONES_TEMPORAL ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Acn(bd:1, 1)
if (Eqstr(Fbn('CallPut'), 'CON'))
if (Query(" Select 1 From "~Dbo()~".COTIZACIONES Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Codigo = '"~Fbn('Codigo')~"' AND CallPut = 'CON'  ") <> 1)
Message('Alta Cotizacion Contado '~Fbn('Codigo'))
Sqladd(" Insert Into "~Dbo()~".COTIZACIONES ")
Sqladd(" (Fecha, Codigo, CallPut, ")
Sqladd(" Precio1, Precio2, Precio3) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Fbn('Codigo')~"', '"~Fbn('CallPut')~"', ")
Sqladd(" "~FStr(Fbn('Precio1'), 0, 8)~", "~FStr(Fbn('Precio1'), 0, 8)~", "~FStr(Fbn('Precio1'), 0, 8)~") ")
Sqlnew()
else
Message('Modificacion Cotizacion Contado '~Fbn('Codigo'))
Sqladd(" Update "~Dbo()~".COTIZACIONES ")
Sqladd(" Set Precio1 = "~FStr(Fbn('Precio1'), 0, 8)~", ")
Sqladd(" Precio2 = "~FStr(Fbn('Precio1'), 0, 8)~", ")
Sqladd(" Precio3 = "~FStr(Fbn('Precio1'), 0, 8)~" ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Codigo = '"~Fbn('Codigo')~"' ")
Sqladd(" AND CallPut = 'CON' ")
Sqlnew()
endif
else
if (Query(" Select 1 From "~Dbo()~".COTIZACIONES Where Fecha = '"~IdxDate(dialogo.fecha1)~"' AND Codigo = '"~Fbn('Codigo')~"' AND CallPut = '"~Fbn('CallPut')~"' AND FechaEj = '"~IdxDate(Fbn('FechaEj'))~"'  ") <> 1)
Message('Alta Cotizacion Futura '~Fbn('Codigo'))
Sqladd(" Insert Into "~Dbo()~".COTIZACIONES ")
Sqladd(" (Fecha, Codigo, CallPut, ")
Sqladd(" Precio1, FechaEj, Precio2, ")
Sqladd(" Precio3) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~Fbn('Codigo')~"', '"~Fbn('CallPut')~"', ")
Sqladd(" "~FStr(Fbn('Precio1'), 0, 8)~", '"~IdxDate(Fbn('FechaEj'))~"', "~FStr(Fbn('Precio1'), 0, 8)~", ")
Sqladd(" "~FStr(Fbn('Precio1'), 0, 8)~") ")
Sqlnew()
else
Message('Modificacion Cotizacion Futura '~Fbn('Codigo'))
Sqladd(" Update "~Dbo()~".COTIZACIONES ")
Sqladd(" Set Precio1 = "~FStr(Fbn('Precio1'), 0, 8)~", ")
Sqladd(" Precio2 = "~FStr(Fbn('Precio1'), 0, 8)~", ")
Sqladd(" Precio3 = "~FStr(Fbn('Precio1'), 0, 8)~" ")
Sqladd(" Where Fecha = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND Codigo = '"~Fbn('Codigo')~"' ")
Sqladd(" AND CallPut = '"~Fbn('CallPut')~"' ")
Sqladd(" AND FechaEj = '"~IdxDate(Fbn('FechaEj'))~"' ")
Sqlnew()
endif
endif
proximo
