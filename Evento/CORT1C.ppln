Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET    Cupon = "~FStr(Val(c2), 0, 0)~", ")
Sqladd("    Fecha = '"~IdxDate(Val(h4))~"', ")
Sqladd("       FechaCorteCupon = '"~IdxDate(Val(g2))~"', ")
Sqladd("       FechaPagoCupon = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("       VTeorico = "~FStr(Val(f3), 0, 7)~" ")
Sqladd("WHERE  Codigo = '"~Val(b4)~"' ")
Sqlnew()
