Sqladd("UPDATE "~Dbo()~".ESPECIES ")
Sqladd("SET    Cupon = "~FStr(Val(c3), 0, 0)~", VTeorico = "~FStr(Val(e3), 0, 7)~", ")
Sqladd("       FechaCorteCupon = '"~IdxDate(Val(g2))~"', ")
Sqladd("       FechaPagoCupon = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("       FechaProximoCorte='"~IdxDate(dialogo.fecha3)~"', ")
Sqladd("       Valor10           = "~FStr(Val(in1), 1, 8)~", ")
Sqladd("       IntsCapitalizados = "~FStr(Val(ci2), 1, 8)~"  ")
Sqladd("WHERE Codigo = '"~dialogo.especie1~"' ")
