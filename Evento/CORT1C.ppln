Sqladd(" UPDATE "~Dbo()~".AGENDACUPONES SET ")
Sqladd("        FechaPago = '"~IdxDate(dialogo.fecha2)~"', ")
Sqladd("        VTeoricoAnt = "~FStr(Val(e:2), 1, 8)~", ")
Sqladd("        PrecioCupon     = "~FStr(Val(f:3), 1, 8)~", ")
Sqladd("        FechaProceso    = '"~IdxDate(FSys())~"', ")
Sqladd("        Estado    = 'PRO', ")
Sqladd("        PorAmCapital = "~FStr(Val(k:2), 1, 8)~", ")
Sqladd("        PorRenta     = "~FStr(Val(l:2), 1, 8)~", ")
Sqladd("        TNA     = "~FStr(Val(l:3), 1, 8)~", ")
Sqladd("        PorAmIntCap  = "~FStr(Val(m:2), 1, 8)~", ")
Sqladd("        TasaCapInt   = "~FStr(Val(ci1), 1, 8)~", ")
Sqladd("        PorPIK       = "~FStr(Val(pr:18), 1, 8)~", ")
Sqladd("        IntsCapitalizados  = "~FStr(Val(ci2), 1, 8)~", ")
if (Val(k:2) = 0)
Sqladd("        TipoCupon = 'REN' ")
else
if (Val(l:2) = 0)
Sqladd("       TipoCupon = 'AMO' ")
else
Sqladd("        TipoCupon = 'RYA' ")
endif
endif
Sqladd(" WHERE Especie = '"~dialogo.especie1~"' AND NrCupon = '"~FStr(Val(c2), 1, 0)~"' ")
Sqlnew()
Message(' Actualizando Agenda de Cupones ')

if (Val(ck:3) = 1 y Val(pr:17) > 0)
Sqladd(" Update "~Dbo()~".AGENDACUPONES ")
Sqladd(" Set PorRenta = PorRenta + "~FStr(Val(pr:17), 0, 8))
Sqladd(" Where Especie = '"~dialogo.especie1~"' ")
Sqladd(" AND NrCupon > '"~FStr(Val(c:2), 0, 0)~"' ")
Sqlnew()
endif

