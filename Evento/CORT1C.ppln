especie3:'Indice';1;2;;NO;NO;;;;;Query("SELECT E.Indice FROM "~Dbo()~".ESPECIES E WHERE Indice IS NOT NULL and E.Codigo='"~dialogo.especie1~"' ")
fecha1:'F.Corte';2;1;;SI;;dialogo.fecha1 <> 0 y dialogo.fecha1 >= FSys();'Fecha de Corte Invalida';SI;iif (dialogo.check1 = 1, FechaMaduracion(dialogo.especie1), ProxCupon2(dialogo.especie1, FSys()));iif (dialogo.check1 = 1, FechaMaduracion(dialogo.especie1), ProxCupon2(dialogo.especie1, FSys()))
cantidad1:'Coeficiente';2;2;;;NoVacio(dialogo.especie3);Vacio(dialogo.especie3) o dialogo.cantidad1 >= 1;'El Coeficiente debe ser >=1';NO;;iif (Vacio(dialogo.especie3), 1, Cotizacion(dialogo.especie2, null, null, null, dialogo.fecha1 - 1, 1, SI) / Cotizacion(dialogo.especie2, null, null, null, dialogo.fecha5 - 1, 1, SI));;;'####.########'
entero1:'Nr.Cupon';3;1;;NO;;dialogo.entero1 >= 0;'Nro de Cupon Invalido';NO;0;Num(BuscarCampo('ESPECIES', 'Cupon', 'Codigo', dialogo.especie1))
check3:'Piks';3;2;;;;;;
precio16:'Tasa PikAnual';4;2;;;dialogo.check3 = 1;dialogo.check3 = 0 o dialogo.precio16 > 0;'Tasa Pik Invalida';NO;;iif (dialogo.check3 = 1, Query("SELECT PorPIK FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' AND Esquema = '1' "), 0);;;'####.########'
precio18:'Tasa Piks';5;2;;;dialogo.check3 = 1;dialogo.check3 = 0 o dialogo.precio18 > 0;'Tasa Pik Anual Invalida';NO;;(dialogo.precio16 / dialogo.precio9) * dialogo.precio10;;;'####.########'
precio17:'Tasa Penalty';6;2;;;dialogo.check3 = 1;;;;;iif (dialogo.check3 = 1, Query("SELECT PorPenalty FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' AND Esquema = '1' "), 0);;;'####.########'
precio1:'% Amort.';4;1;;;;dialogo.precio1 >= 0;'El % de Amortizacion debe ser Positivo';NO;;iif (dialogo.check1 = 1, 100, Query("SELECT PorAmCapital FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"'"));;;'####.########'
precio2:'% Renta';5;1;;;;dialogo.precio2 >= 0;'El % de Renta debe ser Positivo';NO;;(dialogo.precio11 / dialogo.precio9) * dialogo.precio10;;;'####.########'
precio11:'% RentaAnual';7;2;;;;dialogo.precio11 >= 0 y (Eqstr(dialogo.tipotasa1, 'FIJA') o ((dialogo.precio11 >= dialogo.precio14 o dialogo.precio14 = 0) y (dialogo.precio11 <= dialogo.precio15 o dialogo.precio15 = 0)) o Eqstr(Query(" Select TipoCupon From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' and NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "), 'AMO'));iif (dialogo.precio11 < 0, 'El % de Renta Anual debe ser Positivo', 'La Tasa debe estar entre TasaCap y TasaFloor de la especie');dialogo.precio11 >= 0;;iif (Eqstr(dialogo.tipotasa1, 'FIJA') o dialogo.check2 = 0, Query("SELECT PorRenta FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"' AND Esquema = '"~dialogo.string1~"' "), dialogo.precio13);;;'####.########'
precio3:'% Am.Int.Cap.';6;1;;;;dialogo.precio3 >= 0;'El % de Cap.Int. debe ser Positivo';NO;;Query("SELECT PorAmIntCap  FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon = '"~FStr(dialogo.entero1, 1, 0)~"'");;;'####.########'
precio4:'Tasa.Cap.Int';7;1;;dialogo.entero1 <= dialogo.entero2;dialogo.entero1 <= dialogo.entero2;dialogo.precio4 >= 0;'La Tasa de Capitalizacion de Intereses debe ser Positivo';NO;;iif (dialogo.entero2 >= dialogo.entero1, BuscarCampo('ESPECIES', 'TasaIntVigente', 'Codigo', dialogo.especie1) * 100, 0);;;'####.########'
precio6:'IntCapAct';8;1;;NO;dialogo.entero1 <= dialogo.entero2;;;;((dialogo.precio4 / 100) / dialogo.precio9) * dialogo.precio10;((dialogo.precio4 / 100) / dialogo.precio9) * dialogo.precio10;;;'####.########'
precio7:'IntCapAnt';9;1;;NO;dialogo.entero1 <= dialogo.entero2;;;;;Query("SELECT IntsCapitalizados  FROM "~Dbo()~".AGENDACUPONES WHERE Especie='"~dialogo.especie1~"' AND NrCupon='"~FStr(dialogo.entero1 - 1, 1, 0)~"'");;;'####.########'
precio8:'IntCapAcu';10;1;;NO;;;;;iif (dialogo.precio7 <> 0, dialogo.precio7 + dialogo.precio6, dialogo.precio6);iif (dialogo.precio7 <> 0, dialogo.precio7 + dialogo.precio6, dialogo.precio6);;;'####.########'
precio5:'V.T.Actual';10;2;;NO;;dialogo.precio5 >= 0;'El % de V.Teorico al Corte debe ser Positivo';NO;ValorTeorico(dialogo.especie1);ValorTeorico(dialogo.especie1);;;'####.########'
precio9:'DiasAnio';14;1;;NO;NO;;;;;DiasA(EspecieDiasAnio(dialogo.especie1), dialogo.fecha1)
precio10:'DiasMes';15;1;;NO;NO;;;;;Abs(iif (EspecieDiasAnio(dialogo.especie1) = 0 y EspecieDiasMes(dialogo.especie1) = 0, Dif360(dialogo.fecha6, dialogo.fecha5, 2), DifDias(dialogo.fecha6, dialogo.fecha5, 'USA', NO)))
entero2:'Ult.CuponCap';1;1;;NO;NO;;;;;BuscarCampo('ESPECIES', 'PeriodoIntereses', 'Codigo', dialogo.especie1);;;'####'
fecha5:'FechaAnt';12;1;;NO;dialogo.check1 = 0;;;;;UltCupon2(dialogo.especie1, dialogo.fecha1 - 1)
fecha6:'FechaProx';12;2;;NO;dialogo.check1 = 0;;;;;ProxCupon2(dialogo.especie1, dialogo.fecha1)
fecha3:'FechaAct';1;1;;NO;NO;FSys() = dialogo.fecha3;'Debe Actualizar la Especie 72 Hs. antes del corte !!!! ('~dialogo.fecha3~')';;Habiles(dialogo.fecha1, -3, 'ARG');Habiles(dialogo.fecha1, -3, 'ARG')
check1:'ZeroCoupon';1;1;;NO;NO;;;;;iif (Eqstr('SI', BuscarCampo('ESPECIES', 'ZeroCoupon', 'Codigo', dialogo.especie1)), 1, 0)
check2:'Automatico';11;2;;NO;NO;;;;;
tipotasa1:'TipoTasa';;;;NO;NO;;;;;iif (Vacio(BuscarCampo('ESPECIES', 'TipoTasa', 'Codigo', dialogo.especie1)), 'FIJA', BuscarCampo('ESPECIES', 'TipoTasa', 'Codigo', dialogo.especie1));
precio12:'TasaDia';;;;NO;NO;;;;;Query(" Select T.Valor1 From "~Dbo()~".TASASDIA T Where TipoTasa = '"~dialogo.tipotasa1~"' AND Fecha = (Select Max(Fecha) From "~Dbo()~".TASASDIA T1 Where T.TipoTasa = T1.TipoTasa AND T1.Fecha <= '"~IdxDate(dialogo.fecha1)~"') ");
precio13:'TasaMod';;;;NO;NO;;;;;iif (Incluido(Query(" Select TipoCupon From "~Dbo()~".AGENDACUPONES Where Especie = '"~dialogo.especie1~"' and NrCupon = '"~FStr(dialogo.entero1, 0, 0)~"' "), 'RYA|REN|'), iif (dialogo.precio12 < dialogo.precio14, dialogo.precio14, iif (dialogo.precio12 > dialogo.precio15 y dialogo.precio15 <> 0, dialogo.precio15, dialogo.precio12)), 0)
precio14:'TasaFloor';;;;NO;NO;;;;;BuscarCampo('ESPECIES', 'TasaFloor', 'Codigo', dialogo.especie1)
precio15:'TasaCap';;;;NO;NO;;;;;BuscarCampo('ESPECIES', 'TasaCap', 'Codigo', dialogo.especie1)
string1:'Esquema';;;;NO;SI;;;;;iif (dialogo.check3 = 1, '1', '0');
