Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad'] * (dialogo.precio2 - Fbn()['PrecioEj'])) / 100) * FactorDias(Fbn()['FechaEx1'], Fbn()['FechaEx2'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '0') y Eqstr(Fbn()['MB3'], '1'))
if (Fbn()['PrecioEj'] >= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad'] * (Fbn()['PrecioEj'] - dialogo.precio2)) / 100) * FactorDias(Fbn()['FechaEx1'], Fbn()['FechaEx2'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '1') y Eqstr(Fbn()['MB3'], '0'))
if (Fbn()['PrecioEj'] <= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad'] * (Fbn()['PrecioEj'] - dialogo.precio2)) / 100) * FactorDias(Fbn()['FechaEx1'], Fbn()['FechaEx2'], Val(z11)))
endif
endif

if (Eqstr(Fbn()['MB1'], '1') y Eqstr(Fbn()['MB3'], '1'))
if (Fbn()['PrecioEj'] <= dialogo.precio2)
Acn(z20, 0)
else
Acn(z20, ((Fbn()['Cantidad'] * (dialogo.precio2 - Fbn()['PrecioEj'])) / 100) * FactorDias(Fbn()['FechaEx1'], Fbn()['FechaEx2'], Val(z11)))
endif
endif


