if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTOV|'))
Cancelar()('La operacion N# '~dialogo.nroperacion1~' No es un Call o Put de Tasas Vinculada')
endif

if (BuscarCampo('Operaciones', 'CB6', 'NrOperacion', dialogo.nroperacion1) = 0)
Cancelar()('La operacion N# '~dialogo.nroperacion1~' No es la operacion Original')
endif

Acn(x1, sql("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))
Acn(x2, sql("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion2~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar()('La Operacion Original Debe estar en BackOffice o Terminal. Instancia Actual='~sql("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

if (BuscarCampo('Operaciones', 'MB4', 'NrOperacion', dialogo.nroperacion1) = 0)
if (Val(x2) <> 20 y Val(x2) <> 50)
Cancelar()('La Operacion Vinculada Debe estar en BackOffice o Terminal. Instancia Actual='~sql("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x2), 0, 0)~" AND Tabla='OPERACIONES'"))
endif
endif

