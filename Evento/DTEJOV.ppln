fecha1:"F Real Ej.";1;1;;;;dialogo.fecha1 >= BuscarCampo('Operaciones', 'FechaOp2', 'NrOperacion', dialogo.nroperacion1) y dialogo.fecha1 <= BuscarCampo('Operaciones', 'FechaEj', 'NrOperacion', dialogo.nroperacion1);'FECHA EJERCICIO REAL TIENE QUE ESTAR EN EL PLAZO DE LA OPERACION';NO;FSys()
nroperacion1:"Operacion";;;;;;Eqstr(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DTOV');'DEBE INGRESAR UNA OPERACION DE TIPO DTOV';NO;;;SQLSet("Select NrOperacion from "~Dbo()~".OPERACIONES where TipoOp = 'DTOV' ")
precio2:"Precio_Ref";;;;;;dialogo.precio2 <= Var('RTASA2') y dialogo.precio2 >= Var('RTASA1');'Tasa del Vehiculo Fuera de Rango:'~Var('RTASA1')~" Y "~Var('RTASA2');SI;0
fecha3:"F Settlement";;;;;;dialogo.fecha3 >= dialogo.fecha4;'LA FECHA DE SETTLEMENT DEBE SER MAYOR O IGUAL A LA FECHA DE FIN DEL SETTLEMENT';NO;;BuscarCampo('Operaciones', 'FechaPago', 'NrOperacion', dialogo.nroperacion1)
radio1:"Opcion|Europea|Americana|Asiatica";;;;NO;;dialogo.radio1 = 1 o (dialogo.radio1 <> 1 y dialogo.fecha1 = BuscarCampo('Operaciones', 'FechaEj', 'NrOperacion', dialogo.nroperacion1));'NO SE PUEDE EJERCER EN ESTA FECHA PARA UNA OPCION EUROPEA O ASIATICA';NO;;BuscarCampo('Operaciones', 'TipoOpcion', 'NrOperacion', dialogo.nroperacion1)
radio2:"Tipo|Call|Put";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB1', 'NrOperacion', dialogo.nroperacion1)
radio3:"Operacion de|Compra|/Venta";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB3', 'NrOperacion', dialogo.nroperacion1)
fecha4:"Fecha Fin Opcion";;;;NO;;;;;;BuscarCampo('Operaciones', 'FechaEj', 'NrOperacion', dialogo.nroperacion1)
precio3:"Precio Ej";;;;NO;;;;;;BuscarCampo('Operaciones', 'PrecioEj', 'NrOperacion', dialogo.nroperacion1)
nroperacion2:"Op Cpte";;;;NO;;;;;;BuscarCampo('Operaciones', 'NrOperacion2', 'NrOperacion', dialogo.nroperacion1)
