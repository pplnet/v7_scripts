Acn(x1, 0)

sql.add("Select * from "~Dbo()~".OPERACIONES ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and (CB8 is Null or CB8='0') ")
sql.add("and ((TipoOpcion<>'1' and FechaEj = '"~IdxDate(dialogo.fecha1)~"') ")
sql.add(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(dialogo.fecha1)~"')) ")

recorrer sql

