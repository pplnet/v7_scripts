CrearDialogo
   NrOperacion1    : 'Operacion'
   NrOperacion2    : 'Operacion Prorrogada'
FinDialogo
If not Ok
  Cancelar
EndIf

***---Marco las cuotas que fueron prorrogadas y las que son prorrogables

SQL.ADD("Select NrCuota, Radio1, Cantidad9 ")
SQL.ADD("  From "~DBO~".CUOTAS ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ***---Marco Operacion Prorrogada
  SQL.ADD("Update "~DBO~".CUOTAS ")
  SQL.ADD("   Set Radio1      = '"~fbn('Radio1')~"', ")
  SQL.ADD("       Cantidad9   = "~Fstr(fbn('Cantidad9'), 0, 0)~" ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion2~"' ")
  SQL.ADD("   AND NrCuota     = "~Fstr(fbn('NrCuota'), 0, 0)~" ")
  SQL.NEW
  SQL.EXEC

  SQL.ADD(" Select NrOperacion3, TipoOp ")
  SQL.ADD("   From "~DBO~".OPERACIONES ")
  SQL.ADD("  Where NrOperacion = '"~Dialogo.NrOperacion2~"' ")
  Recorrer SQL
    IF Eqstr(fbn('TipoOp'), 'MMPCCM')
      ACT(NR:3, fbn('NrOperacion3'))
      ***---Marco en operacion vinculada contraria
      SQL.ADD("Select NrCuota, Radio1, Cantidad9 ")
      SQL.ADD("  From "~DBO~".CUOTAS ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      Recorrer SQL
        SQL.ADD("Update "~DBO~".CUOTAS ")
        SQL.ADD("   Set Radio1    = '"~fbn('Radio1')~"', ")
        SQL.ADD("       Cantidad9 = "~Fstr(fbn('Cantidad9'), 0, 0)~" ")
        SQL.ADD(" Where NrOperacion = '"~Val(NR:3)~"' ")
        SQL.ADD("   AND NrCuota     = "~Fstr(fbn('NrCuota'), 0, 0)~" ")
        SQL.NEW
      Proximo
    ENDIF
  Proximo
  SQL.EXEC
Proximo
