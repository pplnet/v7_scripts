Sqladd(" Select * from "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where ( NrBit = 50 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
EscribirAscii(Fbn()['NrOperacion'])
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where NrBit=80 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where NrBit=50 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
proximo


Sqladd(" Select B.NrOperacion, O.PaseCB from "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".OPERACIONES O ")
Sqladd(" Where B.NrOperacion = O.NrOperacion     ")
Sqladd(" and   B.NrBit = 65  and  B.Valor = '1'  ")
Sqladd(" Order by B.NrOperacion ")
recorrer sql
EscribirAscii(Fbn()['NrOperacion'])
if (Eqstr(Fbn('PaseCB'), '1'))
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where NrBit=73 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
else 
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where NrBit=80 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
endif

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where NrBit=65 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()

if (Eqstr(Fbn('PaseCB'), '1'))
Message('- Iniciando Generacion de Pase x Oferta')
Ejecutarevento('PASESG')
esperar2(500)
endif
proximo


Sqladd(" Select * from "~Dbo()~".OPERACIONESBITS ")
Sqladd(" Where ( NrBit = 60 ) and ( Valor = '1' ) ")
Sqladd(" Order by NrOperacion ")
recorrer sql
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where NrBit=30 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where NrBit=60 and NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
proximo

