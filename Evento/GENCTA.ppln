cliente1: "Cliente";;;;;;Query("select count(*) from "~Dbo()~".Clientes where codigo='"~dialogo.cliente1~"' and Status='HAB' and Jerarquia like '003%'") = 1;"Status o Jerarquia no valido";NO;;;;;;"Status='HAB' and Jerarquia like '003%'"
findialogo

if (not ok)
Cancelar()
endif

Act(z95, Query("select razonsocial from dbo.clientes where codigo = '"~dialogo.cliente1~"'"))
Act(z96, Query("select nombre from dbo.especies where codigo = '"~Var('MONELOCA')~"'"))
Act(d:1, Var('DEPOSITANT'))
if (Query("SELECT count(*) FROM "~Dbo()~".Cuentas where Cliente ='"~dialogo.cliente1~"' and comitente = '"~Var('VEHICULODE')~"' and Especies like '%"~Var('MONELOCA')~"|%' and TipoCuenta = 'VIS' and Mercado = '"~Var('MERCADOBT')~"'") = 0)
Sqladd("INSERT INTO "~Dbo()~".Cuentas (Codigo, Nombre, Cliente, Comitente, Mercado, Especies,TipoCuenta, Estado,fechaalta)")
Sqladd("VALUES('"~getnumerador(901)~"', substring('"~Mayusculas2(Copy(Val(z95), 1, 36))~" - "~Val(z96)~"',1,50)  , '"~dialogo.cliente1~"','"~Var('VEHICULODE')~"','"~Var('MERCADOBT')~"' , '"~Var('MONELOCA')~"|','VIS' ,'HAB','"~IdxDate(FSys())~"')")
Sqlnew()
Sqlexec()
Message("Cuenta Moneda Local")
endif

