CrearDialogo
  NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MRF') y 0<BuscarCampo('Operaciones','TotalBrutoCli1','NrOperacion',Dialogo.NrOperacion1) y 0=BuscarCampo('Operaciones','CB8','NrOperacion',Dialogo.NrOperacion1);'Debe Ingresar Una Operacion del tipo MRF que aun no se haya cerrado definitivamente!!!';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'MRF' and CB8=0 and TotalBrutoCli1 <> 0  ");NO;
  Fecha1       : "Last Tr Date"             ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaEx4','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : 'Settlement|Cash|Delivery' ;;;;NO;;;;;;BuscarCampo('Operaciones','MB2'     ,'NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio_Ref"               ; ; ;;Dialogo.Fecha1<=Fsys y Dialogo.Radio3=0;Dialogo.Fecha1<=Fsys y Dialogo.Radio3=0;[Dialogo.Fecha1<=Fsys y Dialogo.Radio3=0 y Dialogo.Precio3>0] o Not [Dialogo.Fecha1<=Fsys y Dialogo.Radio3=0];'Indique un Precio de Referencia para Generar el movimiento de cierre!!';NO;0;
  Precio2      : "Precio"                   ;4;2;;NO;Dialogo.Fecha1<=Fsys y Dialogo.Radio3=0;;;;iif(EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MRO'),BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1),BuscarCampo('Operaciones','Precio1','NrOperacion',Dialogo.NrOperacion1));iif(EQSTR(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MRO'),BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1),BuscarCampo('Operaciones','Precio1','NrOperacion',Dialogo.NrOperacion1))

  TipoOp1      : "Tipo Operacion"           ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Radio1       : "Opcion|Call|Put"          ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Operacion|Compra|Venta"   ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
  String1      : "Contrato"                 ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','Contrato','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','Contrato','NrOperacion',Dialogo.NrOperacion1)
  Vehiculo1    : "Vehiculo"                 ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
  Cliente1     : "Intermediario"            ;1;1;3;NO;NO;;;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo
ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

*- re1 Resultado por unidad   re2 Precio de referencia
ACN(re1,Dialogo.Precio3-Dialogo.Precio2)
ACN(re2,Dialogo.Precio3)

act(y1,Dialogo.TipoOp1)
act(y2,Dialogo.String1)
acn(y3,Dialogo.Precio2)
act(y4,BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1))
act(y5,BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1))
act(d10,Dialogo.NrOperacion1)
acn(d15, 0)
*- last trading date
acd(d17,Dialogo.Fecha1)

SQL.ADD(" Select * from "~DBO~".OPERACIONES WHERE TipoOp in ('"~Dialogo.TipoOp1~"') ")
SQL.ADD(" and MB3 <> '"~Fstr(Dialogo.Radio2,0,0)~"'  ")
SQL.ADD(" and TotalBrutoCli1 <> 0  and CB8=0 ")
SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"'  ")
SQL.ADD(" and Contrato = '"~Dialogo.String1~"'  ")
SQL.ADD(" ORDER BY NrOperacion ")

ACN(x1,0)
acn(w1,0)

Recorrer SQL
    ACN(x1,1)
    Message('*-- Recuperando Operacion '~FBN['NrOperacion'])

    ** Muestro los datos
    ACT(b:FAC+1,FBN['NrOperacion'])
    ACN(c:FAC+1,FBN['MB3'])
    ACN(d:FAC+1,fbn['Precio1'])
    ACN(e:FAC+1,FBN['TotalBrutoCli1'])
    ACN(f:FAC+1,0)
    acn(w1,val(w1)+1)
Proximo

IF VAL(x1)=1 
   *-- Hay datos para mostrar de operaciones de distintos signos
   CrearDialogo
     TipoOp2   : "Tipo Oper."         ;1;1;;NO;;;;;val(y1);val(y1)
     String1   : "Contrato"           ;1;2;;NO;;;;;val(y2);val(y2)
     Precio3   : "Precio"             ;4;2;;NO;;;;;val(y3);val(y3)
     Fecha1    : "Liquida"            ;3;1;;;;;;;Habiles(Fsys,1,'ARG',SI);
     Cantidad1 : "Cant. Ctos."        ;2;2;;NO;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',val(d10))
     Cantidad2 : "Saldo Ctos."        ;3;2;;NO;;;;;BuscarCampo('Operaciones','TotalBrutoCli1','NrOperacion',val(d10))
     Radio3    : "Tipo|Compra|Venta"  ;2;1;;NO;;;;;iif(EqStr(val(y4),'0'),0,1);iif(EqStr(val(y4),'0'),0,1)
     Radio4    : "Tipo|Call|Put"      ;4;1;;NO;NO;;;;iif(EqStr(val(y5),'0'),0,1);iif(EqStr(val(y5),'0'),0,1)
     ListBox; 'Arial,8,N'; 460; 180
        'Nro.Op.'       ;b2..b:FAC+1;NO;;;;60;STRING
        'C/V'           ;c2..c:FAC+1;NO;;;;60;COMBO;'Compra|Venta'
        'Precio'        ;d2..d:FAC+1;NO;;;;80;NUMERO;'##,###,###.##'
        'Cantidad'      ;e2..e:FAC+1;NO;;;;80;NUMERO;'##,###,###.##'
        'Cancela'       ;f2..f:FAC+1;;VAL(f:FLB)>=0 Y VAL(f:FLB)<=VAL(e:FLB);'LA CANCELACION DEBE SER >=0 Y <= CANTIDAD';;80;NUMERO;'###,###,###.##'
      FinListBox  
   FinDialogo

   IF Not OK
      Cancelar
   EndIf

   Recorrer&i 2,(1+val(w1))
      if Val(f:&i) > 0
         * Cambia la cantidad Actualizada en la operacion
         ACN(L10,Val(e:&i)-Val(f:&i))
         SQL.ADD("Update "~DBO~".OPERACIONES ")
         SQL.ADD("Set")
         SQL.ADD("TotalBrutoCli1 = "~Fstr(val(L10),0,7)~" ")
         SQL.ADD("where NrOperacion = '"~Val(b:&i)~"' ")
         SQL.NEW
         SQL.EXEC

         * actualiza la cantidad de la operacion original
         acn(d15, val(d15)+Val(f:&i))

         * inserta cuota para cada operacion de cierre con informacion de la operacion original
         * lo mismo para la operacion original
         acn(m2,BuscarCampo('Operaciones','Cuotas1','NrOperacion',val(d10))+1)

         * ingreso el notional cerrado
         acn(O1, (Val(f:&i)*BuscarCampo('Operaciones','TotalAux1','NrOperacion',val(d10))) / BuscarCampo('Operaciones','Cantidad','NrOperacion',val(d10)))
         acn(N1, (Val(f:&i)*BuscarCampo('Operaciones','TotalAux1','NrOperacion',Val(b:&i))) / BuscarCampo('Operaciones','Cantidad','NrOperacion',Val(b:&i)))

         * calcula la comision de cada una de las contraoperaciones
         acn(D1,BuscarCampo('Operaciones','ImpComMer1','NrOperacion',Val(b:&i))*Val(f:&i))
         acn(D2,BuscarCampo('Operaciones','ImpComCor1','NrOperacion',Val(b:&i))*Val(f:&i))
         acn(D3,BuscarCampo('Operaciones','ImpComMer1','NrOperacion',Val(d10))*Val(f:&i))
         acn(D4,BuscarCampo('Operaciones','ImpComCor1','NrOperacion',Val(d10))*Val(f:&i))
         acn (j20, BuscarCampo('Operaciones','Cuotas1','NrOperacion',Val(b:&i))+1)

         * inserta una cuota en la operacion participante
         SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
         SQL.ADD("(NrOperacion, NrCuota, ")
         SQL.ADD(" Fecha1,Mercado2,Cantidad1, Cantidad2,")
         SQL.ADD(" Cantidad3, Cantidad4, Fecha2) ")
         SQL.ADD("Values")
         SQL.ADD("('"~Val(b:&i)~"', "~Fstr(Val(j20),2,0)~", ")
         SQL.ADD(" '"~IdxDate(Fsys)~"','"~Val(d10)~"',"~Fstr(Val(f:&i),0,7)~", "~Fstr(val(N1),0,7)~", ")
         SQL.ADD(" "~Fstr(Val(d2),0,7)~", "~Fstr(val(d1),0,7)~",'"~IdxDate(Dialogo.Fecha1)~"') ")
         SQL.NEW
         SQL.EXEC

         * modifica la cantidad de cuotas de la operacion participante
         SQL.ADD("Update "~DBO~".OPERACIONES ")
         SQL.ADD("Set")
         SQL.ADD("Cuotas1 = "~Fstr(BuscarCampo('Operaciones','Cuotas1','NrOperacion',Val(b:&i))+1,2,0)~" ")
         SQL.ADD("where NrOperacion = '"~VAL(b:&i)~"' ")
         SQL.NEW
         SQL.EXEC

         * inserta una cuota en la operacion original
         SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
         SQL.ADD("(NrOperacion, NrCuota, ")
         SQL.ADD(" Fecha1,Mercado2,Cantidad1, Cantidad2, ") 
         SQL.ADD(" Cantidad3, Cantidad4, Fecha2) ")
         SQL.ADD("Values")
         SQL.ADD("('"~Val(d10)~"', "~Fstr(Val(m2),2,0)~", ")
         SQL.ADD(" '"~IdxDate(Fsys)~"','"~Val(b:&i)~"',"~Fstr(Val(f:&i),0,7)~", "~Fstr(val(O1),0,7)~", ")
         SQL.ADD(" "~Fstr(Val(d4),0,7)~", "~Fstr(val(d3),0,7)~",'"~IdxDate(Dialogo.Fecha1)~"') ")
         SQL.NEW
         SQL.EXEC

         * modifica la cantidad de cuotas de la operacion participante
         SQL.ADD("Update "~DBO~".OPERACIONES ")
         SQL.ADD("Set")
         SQL.ADD("Cuotas1 = "~Fstr(BuscarCampo('Operaciones','Cuotas1','NrOperacion',Val(d10))+1,2,0)~" ")
         SQL.ADD("where NrOperacion = '"~VAL(d10)~"' ")
         SQL.NEW
         SQL.EXEC

         *** Actualiza movimientos y limites ****
         SQL.ActualizarMovimientos(VAL(d10),SI)
         SQL.EXEC

         SQL.ActualizarMovimientos(VAL(b:&i),SI)
         SQL.EXEC
      endif
   Proximo
   * actualiza la operacion original respecto a la cantidad cerrada
   acn(d16, BuscarCampo('Operaciones','TotalBrutoCli1','NrOperacion',val(d10)) - val(d15))
        
   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set")
   SQL.ADD("TotalBrutoCli1 = "~Fstr(val(d16),0,7)~" ")
   SQL.ADD("where NrOperacion = '"~val(d10)~"' ")
   SQL.NEW
   SQL.EXEC
else 
   messagebox('La operacion N# '~Dialogo.NrOperacion1~' No Tiene Operaciones Relacionadas para Cerrar Posicion')
endif


*- Verifico la fecha del last trading  date para cerrar el resto de los contratos
*- por la diferencia del subyacente
IF val(d17)<=Fsys

   ACN(d18, Messagebox('Las Trading Date '~val(d17)~' Vencido, Desea Generar el movimiento por la diferencia del Subyacente? ',1,2))

   If val(d18)=6
      *- Marco la Operacion como cerrada definitivamente y ejecuto el movimiento por el subyacente
      *- re1 Resultado por unidad   re2 Precio de referencia
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set")
      SQL.ADD("CB8 = '1',Precio4= "~Fstr(val(re1),0,8)~",Precio2= "~Fstr(val(re2),0,8)~"  ")
      SQL.ADD("where NrOperacion = '"~val(d10)~"' ")
      SQL.NEW
      SQL.EXEC

      SQL.ActualizarMovimientos(VAL(d10),SI)
      SQL.EXEC
  EndIf
EndIf


