MostrarCuadroDeMensajes()
creardialogo
nrtrans1:'NrTrans'
vehiculo1: 'Vehiculo'
radio1:'ABM|Alta|Baja|ChequeReusado|Cheque para Reusar'
chequera1:'Nr.Chequera';;;;;;;;;;
entero1:'Nr.Cheque';;;;;;;;;;;;;'###############';
findialogo

if (not ok)
Cancelar()
endif

Act(tr:1, dialogo.nrtrans1)
Act(ve:1, dialogo.vehiculo1)

Sqladd(" Select Fecha2, Cantidad1, Cuenta2, Cantidad2, Chequera1, Fecha1 ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 ")
Sqladd(" Where NrTrans = '"~dialogo.nrtrans1~"' ")
recorrer sql
Acd(fe:1, Fbn('Fecha1'))
Acd(fe:2, Fbn('Fecha2'))
Acn(ca:1, Fbn('Cantidad1'))
Acn(ch:1, Fbn('Cantidad2'))
Act(ch:2, Fbn('Chequera1'))
Act(cu:2, Fbn('Cuenta2'))
proximo

if (NO)

Message(' Asignando Numero de Cheque ...')
Act(ob:1, 'Pago de Transaccion DEVM Nr. '~Val(tr:1))
Sqladd(" INSERT INTO "~Dbo()~".CHEQUES ")
Sqladd(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
Sqladd(" NrComprobante, Monto, Observaciones, Estado) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~FStr(Val(ch:1), 0, 0)~", "~IdxDate2(Val(fe:2))~", ")
Sqladd(" '"~Val(tr:1)~"', "~FStr(Val(ca:1), 1, 2)~", '"~Val(ob:1)~"', 'ASI') ")
Sqlnew()

Sqladd(" UPDATE "~Dbo()~".MOVPENDIENTES ")
Sqladd(" Set NrGrupo = "~FStr(Num(Val(ch:2)), 0, 0)~", ")
Sqladd(" NrComprob   = "~FStr(Val(ch:1), 0, 0)~" ")
Sqladd(" Where NrOperacion = '"~Val(tr:1)~"' ")
Sqlnew()
Sqlexec()
endif

if (dialogo.radio1 = 0)
Message(' Asignando Numero de Cheque ...')
Act(ob:1, 'Pago de Transaccion DEVM Nr. '~Val(tr:1))
Sqladd(" INSERT INTO "~Dbo()~".CHEQUES ")
Sqladd(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
Sqladd(" NrComprobante, Monto, Observaciones, Estado) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~FStr(Val(ch:1), 0, 0)~", "~IdxDate2(Val(fe:2))~", ")
Sqladd(" '"~Val(tr:1)~"', "~FStr(Val(ca:1), 1, 2)~", '"~Val(ob:1)~"', 'ASI') ")
Sqlnew()
endif

if (dialogo.radio1 = 1)
if (Query("SELECT COUNT(*) FROM "~Dbo()~".CHEQUES WHERE NrCheque = "~FStr(Val(ch:1), 0, 0)~" AND Chequera = '"~Val(ch:2)~"' ") <> 0)
Message(' Actualizando datos del Cheque ...')
Sqladd(" UPDATE "~Dbo()~".CHEQUES SET ")
Sqladd(" Monto        =  "~FStr(Val(ca:1), 1, 2)~", ")
Sqladd(" FechaEmision =  "~IdxDate2(Val(fe:1))~", ")
Sqladd(" FechaPago    =  "~IdxDate2(Val(fe:2))~", ")
Sqladd(" Estado       = 'ASI' ")
Sqladd(" WHERE  NrComprobante = '"~Val(tr:1)~"' ")
Sqladd(" AND    NrCheque      = "~FStr(Val(ch:1), 0, 0)~" ")
Sqladd(" AND    Chequera      = '"~Val(ch:2)~"' ")
Sqlnew()
else
Message(' Asignando Numero de Cheque ...')
Act(ob:1, 'Pago de Transaccion DEVM Nr. '~Val(tr:1))
Sqladd(" INSERT INTO "~Dbo()~".CHEQUES ")
Sqladd(" (Chequera, FechaEmision, NrCheque, FechaPago, ")
Sqladd(" NrComprobante, Monto, Observaciones, Estado) ")
Sqladd(" Values ")
Sqladd(" ('"~Val(ch:2)~"', '"~IdxDate(Val(fe:1))~"', "~FStr(Val(ch:1), 0, 0)~", "~IdxDate2(Val(fe:2))~", ")
Sqladd(" '"~Val(tr:1)~"', "~FStr(Val(ca:1), 1, 2)~", '"~Val(ob:1)~"', 'ASI') ")
Sqlnew()
endif
endif

if (dialogo.radio1 = 2)
Message(' Actualizando datos del Cheque ...')
Act(ob:1, 'Pago de Transaccion DEVM Nr. '~Val(tr:1))
Sqladd(" UPDATE "~Dbo()~".CHEQUES SET ")
Sqladd(" Monto = "~FStr(Val(ca:1), 1, 2)~", ")
Sqladd(" FechaEmision = '"~IdxDate(Val(fe:1))~"', ")
Sqladd(" FechaPago = '"~IdxDate(Val(fe:2))~"', ")
Sqladd(" Estado = 'ASI', ")
Sqladd(" NrComprobante = '"~Val(tr:1)~"', ")
Sqladd(" Observaciones = '"~Val(ob:1)~"' ")
Sqladd(" Where NrCheque = "~FStr(Val(ch:1), 0, 0)~" ")
Sqladd(" AND Chequera = '"~Val(ch:2)~"' ")
Sqlnew()
endif

if (dialogo.radio1 = 3)
Sqladd(" Delete "~Dbo()~".CHEQUES ")
Sqladd(" Where NrCheque = "~FStr(dialogo.entero1, 0, 0)~" ")
Sqladd(" AND Chequera = '"~dialogo.chequera1~"' ")
Sqladd(" AND Estado = 'ASI' ")
Sqladd(" AND NrComprobante = '"~Val(tr:1)~"' ")
Sqlnew()
endif

Sqladd(" UPDATE "~Dbo()~".MOVPENDIENTES ")
Sqladd(" Set NrGrupo = "~FStr(Num(Val(ch:2)), 0, 0)~", ")
Sqladd(" NrComprob   = "~FStr(Val(ch:1), 0, 0)~" ")
Sqladd(" Where NrOperacion = '"~Val(tr:1)~"' ")
Sqlnew()
