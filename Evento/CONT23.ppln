Sqladd(" Select O.TipoOp, O.Vehiculo1, M.Codigo CodAsi, O.Cliente1, O.NrOperacion, O.Precio1, O.Plazo, ")
Sqladd(" O.Cantidad, O.MB3, O.Cantidad, O.Especie, O.ContraEspecie, O.FechaOp, O.ContraEspecie Moneda, ")
Sqladd(" O.FechaPago, O.FechaVto, V.Alias4, '' TipoDevengado, '' Tipo, E.Cotiza, O.Observaciones, O.TotalNetoCli1 ")
Sqladd(" From "~Dbo()~".OPERACIONES O, "~Dbo()~".VEHICULOS V, "~Dbo()~".MODELOSASIENTO M, "~Dbo()~".ESPECIES E ")
Sqladd("   Where O.FechaOp  < "~IdxDate2(Val(v:2))~" ")
Sqladd("   and O.FechaVto   >  "~IdxDate2(Val(v:2))~" ")
Sqladd("   and O.TipoOp in ('SECS','SEVS','SECT','SEVT') ")
Sqladd("   and O.Especie = E.Codigo ")
Sqladd("   and O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
Sqladd(" AND M.Habilitado = 'SI' ")
if (NoVacio(dialogo.lista1))
Sqladd(" AND O.Vehiculo1 IN ("~Pipe2Comillas(dialogo.lista1)~") AND ( ")
recorrer&i 1, Elementos(dialogo.lista1)
Sqladd(" '|'+rtrim(M.Vehiculo)+'|' like '%|"~ItemLista(dialogo.lista1, &i)~"|%' ")
if (not Elementos(dialogo.lista1) = &i)
Sqladd(" OR ")
endif
proximo
Sqladd(") ")
else
