Sqladd(" Select Sum(Cantidad1) Capital, Sum(Cantidad3) Interes ")
Sqladd(" From "~Dbo()~".CUOTAS ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqladd(" AND Fecha2 >= '"~IdxDate(dialogo.fecha1)~"' ")
recorrer sql
Dfa()
Acn(cp:1, Fbn('Capital'))
Acn(it:1, Fbn('Interes'))
proximo
Acn(rs:1, Val(cp:1) * (Val(ct:1) - Val(ct:2)))
Acn(rs:2, Val(it:1) * (Val(ct:1) - Val(ct:2)))
