Acn(ct:1, CotizacionBNA(Fbn('Especie'), Val(v:2), 1, NO, NO))
if (Val(v:3) > Fbn('FechaOp'))
Acn(ct:2, CotizacionBNA(Fbn('Especie'), Val(v:3), 1, NO, NO))
else 
Acn(ct:2, CotizacionBNA(Fbn('Especie'), Fbn('FechaOp'), 1, NO, NO))
