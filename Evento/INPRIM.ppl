* INPRIM - Ingreso de Primas Vigentes
* HojaVisible(Si)
CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;HABILES(Fsys,-1,'ARG',SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1 : 'ContraParte' ;;;;;;;;;;;
  Especie1 : 'Especie '    ;;;;;;NOVACIO(Dialogo.Especie1);'Especie Inexistente';NO;'WTI';;
  Radio1   : 'Tipo|Reales|Simuladas' ;;;;;;;;;0;;
FinDialogo

if not OK
  Cancelar
endif

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

SetFilaActual(1)
SQL.ADD("Select Distinct O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.CB9='1' ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
if NoVacio(Val(zz6))
   SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
SQL.ADD("and (O.TipoOp in ('DPDSO','DPDSS','DPBOD','DPOA','DPOD','DPRC','DPRRS','DPRS','DPBOA','DPC','DPF','DPFW','DPOGA','DPOGD') ")
SQL.ADD(" or (O.TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL)) )")
SQL.ADD("Union ")
SQL.ADD("Select Distinct O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES O")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.CB9='1' ")
SQL.ADD("and TipoOp In ('DPOS','DPBOS','DPOGS') and O.FechaEj>'"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
if NoVacio(Val(zz6))
   SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
endif
SQL.ADD("order by O.Vehiculo1,")
If Dialogo.Radio1=0 
   SQL.ADD("TCComCor1, O.Cliente1")
Else
   SQL.ADD("TCComCor2, O.Cliente1")
EndIf


Recorrer SQL
  If Dialogo.Radio1=0 
     acn(a:fac, fbn('TCComCor1'))
  Else
     acn(a:fac, fbn('TCComCor2'))
  EndIf

  act(b:fac, fbn('NrOperacion'))
  act(c:fac, fbn('Cliente1'))
  act(d:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))

  * determinar el signo
  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
    act(f:fac, fbn('TipoCambio2'))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
      act(f:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
    else
      act(f:fac, fbn('PrecioEj'))
    endif
  endif

  if fbn('FechaOp2') > Dialogo.Fecha1
    ACD(z2, fbn('FechaOp2'))
  else
    ACD(z2, Dialogo.Fecha1)
  endif
  if fbn('FechaEj') <= Dialogo.Fecha1
    ACD(z3, fbn('FechaEj'))
  else
    ACD(z3, Dialogo.Fecha1)
  endif

  * dif dias
  ACN(z4, (Val(z3)-Val(z2))+1)

  * dif meses
  ACN(z6, DifMeses(Val(z3),Val(z2))+1)

  * determinar el signo
  if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(e:fac,'Producer')
      acn(z5,1)
    else
      act(e:fac,'Consumer')
      acn(z5,-1)
    endif
  endif

  if Incluido(fbn('TipoOp'),'DPOD|DPBOD|DPOA')
     if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(e:fac,'Compra PUT')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(e:fac,'Venta CALL')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(e:fac,'Venta PUT')
        acn(z5,-1)
     endif
     if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(e:fac,'Compra CALL')
        acn(z5,-1)
     endif
  endif

  if EqStr(fbn('TipoOp'),'DPSN')
     if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
        act(e:fac,'Compra Producer')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(e:fac,'Venta Consumer')
        acn(z5,1)
     endif
     if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
        act(e:fac,'Compra Consumer')
        acn(z5,-1)
     endif
     if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
        act(e:fac,'Venta Producer')
        acn(z5,-1)
     endif
  endif

  acn(g:fac, fbn('Cantidad'))
  act(h:fac, fbn('UMedida'))
  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acd(i:fac, fbn('FechaOp'))
  Else
     acd(i:fac, fbn('FechaOp2'))
  EndIf
  acd(j:fac, fbn('FechaEj'))

  If no
     acn(j:fac, fbn('TotalAux2')*Val(z5))

     if EqStr(fbn('UMedida'),'BBLSD')
        * Barriles por dia
        acn(k:fac, fbn('Cantidad')*Val(z4)*Val(z5))
     else
        if Incluido(fbn('UMedida'),'BBLSM|TN/MES')
           * por meses
           acn(k:fac, fbn('Cantidad')*Val(z6)*Val(z5))
        endif
     endif
     acn(l:fac, fbn('TotalAux1')*Val(z5))
     acn(m:fac, (fbn('TotalAux1')*ABS(Val(k:fac))/fbn('TotalAux2'))*Val(z5))

     * 'Vol.Total'       ;j2..j:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
     * 'Vol.Per'         ;k2..k:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
     * 'Not.Total'       ;l2..l:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
     * 'Not.Per'         ;m2..m:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
  EndIf 

  FormatoCeldas(j:fac..m:fac, Exe('F2N'))
proximo

*- Valores del Dialogo
ACD(z1,Dialogo.Fecha1)
ACT(z2,Dialogo.Lista1)
ACT(z3,Dialogo.Cliente1)
ACT(z4,Dialogo.Especie1)
ACN(z5,Dialogo.Radio1)
* 

IF fac>2
   *-- Hay datos para mostrar
   Recorrer&j 1,1000
      CrearDialogo
          Fecha1   : 'Fecha'       ;1;1;;NO;;;;;VAL(z1)
          Cliente1 : 'ContraParte' ;1;2;;NO;;;;;VAL(z3);;
          String1  : 'Vehiculo'    ;2;1;;NO;;;;;VAL(Z2)
          Especie1 : 'Especie '    ; ; ;;NO;;;;;VAL(z4);;
          Radio1   : 'Tipo|Reales|Simuladas' ;;;;NO;;;;;;VAL(Z5);
          ListBox; 'Arial,8,N'; 460; 180
           'Prima'           ;a2..a:fac;  ;;;;50;NUMERO;'###.#####'
           'Nr.Op'           ;b2..b:fac;NO;;;;60;STRING
           'Cliente'         ;c2..c:fac;NO;;;;60;STRING
           'Producto'        ;d2..d:fac;NO;;;;80;STRING
           'Tipo'            ;e2..e:fac;NO;;;;80;STRING
           'P.Strike'        ;f2..f:fac;NO;;;;50;STRING
           'Volumen'         ;g2..g:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
           'Un.M.'           ;h2..h:fac;NO;;;;30;STRING
           'F.Inicio'        ;i2..i:fac;NO;;;;;FECHA
           'F.Fin'           ;j2..j:fac;NO;;;;;FECHA
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      ACN(k2,0)
      ACN(k1,0)

      Recorrer&i 2,FAC

         If Val(a:&i)=0          
            ACN(k1,0)
            SCN(k2,1)
            ACN(k1,MessageBox("La Prima "~Val(b:&i)~"/"~Val(c:&i)~"-"~Val(d:&i)~" Es Incorrecta. Continua? ",2,1))

            IF VAL(k1)=2
               Break
            EndIf 
         EndIf 
      Proximo

      IF VAL(k1)<>1 
         Break
      EndIf 
   Proximo

   * No cancelo y no hay valores en 0
   IF VAL(k1)<>2 y VAL(k2)=0

      *-- El primer renglon es de totales
      Recorrer&i 2,FAC

         If Val(a:&i)<>0 y NoVacio(VAL(b:&i))
            Message("Actualizando "~Val(b:&i)~"/"~Val(c:&i)~" - "~Val(d:&i)~" ... ")

            * Si es Real actualiza TCCOMCOR1 y Si es Simulada TCCOMCOR2
            *-- Actualizo la Operacion
            SQL.ADD("UPDATE "~DBO~".OPERACIONES Set ")
            If Dialogo.Radio1=0 
               SQL.ADD(" TCComCor1="~Fstr(Val(a:&i),0,7)~" ")
            Else
               SQL.ADD(" TCComCor2="~Fstr(Val(a:&i),0,7)~" ")
            EndIf
            SQL.ADD(" Where NrOperacion='"~Val(b:&i)~"' ")
            SQL.NEW
            SQL.EXEC
         Endif
      Proximo
   EndIf
EndIf
