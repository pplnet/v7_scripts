*- Este evento toma las operaciones pasivas afectadas por un indice
*- Actualiza el factor del indice correspondiente y modifica las operaciones
HojaVisible(Si)
ModoReproceso(SinDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1       : "Fecha Vigencia"        ;1;1;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1<=Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Especie1     : "Indice"                ;1;2;;;;NoVacio(Dialogo.Especie1);'Indique el Codigo del Indice';NO;;;
  NrOperacion1 : "Operacion"             ;;;;;;
  Radio3       : 'Actualiza|NO|SI'       ;;;;;;;;;1;;;
  Lista2       : 'Tipo Op.'              ;5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMPEM','MMPIM','MMPCLM','MMONM','MMPCCM','MMFIMV','MMSIMV','MMFCMV','MMSCMV','MMPE','MMPI','MMPCL','MMON','MMPCCV','MMPLME','MMPSI','MMFRNP','MMPSC','MMFRN') ");
  Lista1       : "Vehiculo"              ;-1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")); 
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

ACT(ls:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet("Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo='"~UsuarioActivo~"' AND U.Vehiculo=V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(ls:1100, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' or Codigo Like 'CE%'"))

* Valor del Indice a la Fecha
acn(ts1,Cotizacion(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI) )


SetFilaActual(1)

ACT(d:FAC  ,"Actualizacion de Indices Operaciones de Deuda al "~Dialogo.Fecha1~" Indexadas Por "~Dialogo.Especie1)
ACT(d:FAC+1," Valor del Indice "~PYC(val(ts1),0,6)~"   Actualiza : "~IIF(Dialogo.Radio3=0,'NO','SI') )

SetFont(a:fac..e:fac+1,3)

SetFilaActual(fac+3)
if NoVacio(Dialogo.NrOperacion1)
   ACT(a:fac, 'Operacion: '~Dialogo.NrOperacion1)
else
   ACT(a:fac, 'Operacion: Todas')
endif
if NoVacio(Dialogo.Lista2)
   ACT(a:fac+1, 'Tipo Op.: '~Dialogo.Lista2)
else
   ACT(a:fac+1, 'Tipo Op.: Todas')
endif
if NoVacio(Dialogo.Lista1)
   ACT(a:fac+2, 'Vehiculos : '~Dialogo.Lista1)
else
   ACT(a:fac+2, 'Vehiculos : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
endif
SetFont(a:fac..a:fac+2,2)
SetFilaActual(fac+2)

ACT(a:FAC  , 'O   P   E   R   A   C   I   O   N ')
ACT(a:FAC+1, 'FechaOp')
ACT(b:FAC+1, 'Indice Ini')
ACT(c:FAC+1, 'TipoOp')
ACT(d:FAC+1, 'NrOperacion')
ACT(e:FAC+1, 'Entidad')
ACT(f:FAC+1, 'Especie')
ACT(g:FAC+1, 'FInicio')
ACT(h:FAC+1, 'FFin')
ACT(i:FAC  , ' C A L C U L O     D E    I N T E R E S E S/I M P U E S T O S/C O M I S I O N E S')
ACT(i:FAC+1, 'TipoTasa')
ACT(j:FAC+1, 'V.Nominal')
ACT(k:FAC+1, 'Imp.Amort.')
ACT(l:FAC+1, '% Tasa')
ACT(m:FAC+1, 'Spread')
ACT(n:FAC+1, 'Tasa Total')
ACT(o:FAC+1, 'Interes')
ACT(p:FAC+1, 'WHT')
ACT(q:FAC+1, 'IVA')
ACT(r:FAC+1, 'CEC Total')
ACT(s:FAC+1, 'CEC Var')
ACT(t:FAC+1, 'CEN Total')
ACT(u:FAC+1, 'CEN Var')
ACT(v:FAC+1, 'Imp.Interes')
ACT(x:FAC+1, 'IVA.CEN')
ACT(y:FAC+1, 'Cs_Fin_CEC')
ACT(z:FAC+1, 'Monto')
ACT(aa:FAC+1, 'Monto Total')
ACT(ab:fac+1, 'Interes Total')
ACT(ac:fac+1, 'Impuesto Extr.')
ACT(ad:fac+1, 'CEN Equiv')
ACT(ae:fac+1, 'Resultado')
ACT(af:fac+1, 'Cuota')
ACT(ag:FAC  , ' C A L C U L O      D E     R E S U L T A D O ')
ACT(ag:FAC+1, 'Coeficiente')
ACT(ah:FAC+1, 'Cant Orig')
ACT(ai:FAC+1, 'Cant Idx')
ACT(aj:FAC+1, 'EF Orig')
ACT(ak:FAC+1, 'EF Idx')
ACT(al:FAC+1, 'VN Orig')
ACT(am:FAC+1, 'VN Idx')
ACT(an:FAC+1, 'Amor Orig')
ACT(ao:FAC+1, 'Amor Idx ')
ACT(ap:FAC+1, 'VR Orig')
ACT(aq:FAC+1, 'VR Idx ')
ACT(ar:fac+1, 'Res.Idx')
ACT(as:fac+1, 'VNActual FRN')
ACT(at:fac+1, 'VNUtil FRN')
ACT(au:fac+1, 'VNDispon FRN')

*- av: Ut IVA aw: UT WH
ACT(av:fac, 'Tasa Int IVA')
ACT(aw:fac, 'Tasa Int WH')

SetFont(a:fac..ar:fac+1,2)
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
AgregarMarco(m:FAC..s:FAC,2,0,Exe('COLOR'))
AgregarMarco(a:FAC+1..s:FAC+1,2,0,Exe('COLOR'))
ifa

*- Operaciones Multiple Vto
SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.TipoOp,O.TipoTasa,O.NrOperacion,C.NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.CantidadOri,O.Precio1,O.OperacionRef,O.Precio4 as OPrecio4,O.TotalBrutoCli3,O.TotalBrutoCli2,O.TotalNetoCli3,O.Coeficiente,")
SQL.ADD("C.Cantidad1,C.Cantidad2,C.Total5,C.Plazo1,C.Cantidad5,C.Cantidad2,C.Plazo3,")
SQL.ADD("C.Tasa2, C.Precio4,C.Fecha1,C.Fecha2,C.Total6,C.Precio3,C.Cantidad7,C.Check1,C.Cantidad4,C.Tasa3, ")
SQL.ADD("C.Total3,C.Total4,C.Fecha5,C.Fecha6,' ' as Pata,C.Cantidad3,C.Cantidad4,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.Precio2,O.ValorRB1,C.Check10,O.TotalAux4 ")
SQL.ADD(" from  "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("       AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
   SQL.ADD("       AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Indice = '"~Dialogo.Especie1~"'")
ENDIF
SQL.ADD("       and O.TipoOp In ('MMFCMV','MMSCMV','MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMONM','MMPCCM') ")
SQL.ADD("       and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"'   ")
SQL.ADD(" Union ")
*- Operaciones Unico Vto
SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.TipoOp,O.TipoTasa,O.NrOperacion,0 NrCuota,O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,")
SQL.ADD("O.MB3,O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia, ")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.FechaVto,O.Plazo,O.Cantidad,")
SQL.ADD("O.PrecioEj,O.ImpComCor1,O.ImpComCor2,O.FechaVto2,O.TotalBrutoCli2,O.TotalComisiones,O.TotalIntereses,O.InteresesCorr,O.ContraEspecie,")
SQL.ADD("O.TCComCor1,O.CantidadOri,O.Precio1,O.OperacionRef,O.Precio4 as OPrecio4,O.TotalBrutoCli3,O.TotalBrutoCli2,O.TotalNetoCli3,O.Coeficiente,")
SQL.ADD("O.Cantidad Cantidad1,O.Cantidad Cantidad2,0 Total5,O.Plazo Plazo1,0 Cantidad5,0 Cantidad2,0 Plazo3,")
SQL.ADD("0 Tasa2,0 Precio4,O.FechaOp Fecha1,O.FechaVto Fecha2,0 Total6,0 Precio3,0 Cantidad7, '0' Check1,0 Cantidad4,0 Tasa3, ")
SQL.ADD("0 Total3,0 Total4,O.FechaOp Fecha5,O.FechaVto Fecha6,' ' as Pata, 0 Cantidad3,0 Cantidad4,0 Cantidad1Ori,0 Cantidad2Ori,0 Cantidad3Ori,0 as Precio2,O.ValorRB1,' ' Check10,O.TotalAux4 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMFRN','MMFRNP','MMPSC','MMPSI','MMPCL','MMPE','MMPI','MMPLME','MMON','MMPCCV') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
SQL.ADD("       and O.FechaOp<'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'   ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Indice = '"~Dialogo.Especie1~"'")
ENDIF
SQL.ADD(" Order By 1,2,3,4 ")

act(ct1,'')
acn(ts2,0)
act(ct3,'')

Recorrer SQL

  If Not EqStr(val(ct1),FBN['Vehiculo1']) 
     act(ct1,FBN['Vehiculo1'])
     ACT(a:fac,val(ct1))
     SetFont(a:fac..ar:fac,5)
  EndIf

  If val(ct3)<>FBN['FechaOp']
     *- Recupero el Indice por cada Fecha de Operacion
     acd(ct3,FBN['FechaOp'])
     acn(ts2,Cotizacion(Dialogo.Especie1,,,,FBN['FechaOp']-1,1,SI) )
     acn(co1,val(ts1)/val(ts2))
  EndIf

  Message('Recorriendo '~FBN['Vehiculo1']~' '~FBN['FechaOp']~' '~FBN['TipoOp']~' '~FBN['NrOperacion'])

  ACD(a:fac, FBN['FechaOp'])
  ACN(b:fac, val(ts2))
  ACT(c:fac, FBN['TipoOp'])
  ACT(d:fac, FBN['NrOperacion'])
  ACLO(d:fac, FBN['NrOperacion'])

  ACT(e:fac, FBN['Cliente1'])
  ACT(f:fac, FBN['Especie'])

  ACD(g:fac, FBN['Fecha1'])
  ACD(h:fac, FBN['Fecha2'])
  ACT(i:fac, FBN['TipoTasa'])
  If Vacio(val(i:fac))
     ACT(i:fac, 'Fija')
  EndIf

  If  Incluido(FBN['TipoOp'],'MMFRNP|MMPSI|MMPCL|MMPE|MMPI|MMPLME|MMON|MMPCCV|CEPCL|MMPLME|')
      ACD(g:fac, FBN['FechaOp'])
      ACD(h:fac, FBN['FechaVto'])
  EndIf

  *- Cantidad 
  ACN(ag:fac, val(co1))
  ACN(ah:fac, FBN['CantidadOri'])
  ACN(ai:fac, val(ah:fac)*val(co1))

  *- EF
  If NoVacio(FBN['OperacionRef'])
     ACN(aj:fac, SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~FBN['OperacionRef']~"' AND Tipo='5'"))
  Else
     ACN(aj:fac, SQL("Select Tasa1 from "~DBO~".COMISIONES2 where NrOperacion='"~FBN['NrOperacion']~"' AND Tipo='5'"))
  EndIf

  *- Cantidad + EF
  ACN(aj:fac, val(aj:fac)*val(ah:fac)/100)  
  ACN(ak:fac, val(aj:fac)*val(co1))

  ACN(al:fac, val(ah:fac)+val(aj:fac))
  ACN(am:fac, val(ai:fac)+val(ak:fac))

  ACN(an:FAC, val(al:fac))  
  ACN(ao:fac, val(am:fac))

  ACN(ap:FAC, val(al:fac))
  ACN(aq:FAC, val(am:fac))

  If Not Incluido(FBN['TipoOp'],'MMPSC|MMPSI|MMFRN|MMFRNP|MMPCL|MMPE|MMPI|MMPLME|MMON|MMPCCV|')
     ACN(an:FAC, FBN['Cantidad1Ori'])  
     ACN(ao:fac, val(an:fac)*val(co1))

     ACN(ap:FAC, FBN['Cantidad2Ori'])
     ACN(aq:FAC, val(ap:fac)*val(co1))
  EndIf

  ACN(ar:fac,val(ao:fac) - val(an:fac) )

  ACN(as:fac,0)
  ACN(at:fac,0)
  ACN(au:fac,0)

  If Incluido(FBN['TipoOp'],'MMFRN|MMPSC|MMFRNP|MMPSI|MMFCMV|MMSCMV|MMFIMV|MMSIMV|')  
     ACN(as:fac,(FBN['TotalBrutoCli3']/FBN['Coeficiente'])*val(co1))
     ACN(at:fac,(FBN['TotalBrutoCli2']/FBN['Coeficiente'])*val(co1))
     ACN(au:fac,(FBN['TotalNetoCli3']/FBN['Coeficiente'])*val(co1))
  EndIF

  *- Para Calcular Intereses   e Impuestos
  *- j: VN k: Amor
  ACN(j:fac, val(aq:fac))
  ACN(k:fac, val(ao:fac))
  ACN(l:fac, FBN['Precio2'])
  ACN(n:fac, FBN['Precio3'])
  ACN(af:fac,FBN['NrCuota'] )

  If Incluido(FBN['TipoOp'],'MMFRN|MMPSC|MMFRNP|MMPSI|MMPCL|MMPE|MMPI|MMPLME|MMON|MMPCCV|MMPLME|')
     *- j: VN k: Amor
     ACN(m:fac, FBN['Spread'])
     ACN(n:fac, FBN['OPrecio4'])
     ACN(l:fac, FBN['Precio1'])
  EndIf

  If Incluido(FBN['TipoOp'],'MMFCMV|MMSCMV|MMSIMV|MMFIMV|')
     ACN(n:fac, FBN['Total3'])
  EndIf

  * q:fac=iva, p:fac=wh, o:fac=interes, ab:fac=interes total, z:fac=monto, aa:fac=monto total, r:fac=cec total
  * t:fac=cen total, s:fac=cec imp var, u:fac=cen variable, ac:fac=impuesto extr
  * v:fac: Impto.Interes x:fac: Imp.IVA.CEN y:fac: Imp_Cs_Fin_CEC

  ACT(i3,val(d:fac))

  *- Tasa Real o Simulada
  If Incluido(FBN['TipoOp'],'MMFRN|MMPSC|MMFRNP|MMPSI|MMPCL|MMPE|MMPI|MMPLME|MMON|MMPCCV|MMPLME|')
     *- Unico Vto
     ACN(re1,FBN['ValorRB1'])
  Else
     ACN(re1,FBN['Check10'])
  EndIf


  If Incluido(FBN['TipoOp'], 'MMPEM|MMPIM')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])

     (.'RTPEMPIM'.)
     If Dialogo.Radio3=1
        (.'RTUPPEMPIM'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If EQSTR(FBN['TipoOp'], 'MMPCLM')
      ACN(av:fac, FBN['Tasa2'])
     (.'RTPCLM'.)
     If Dialogo.Radio3=1
        (.'RTUPPCLM'.)
        (.'IXGRAL'.)
     EndIF
  EndIf

  If EQSTR(FBN['TipoOp'], 'MMONM')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])
     (.'RTONM'.)
     If Dialogo.Radio3=1
        (.'RTUPONM'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If EQSTR(FBN['TipoOp'], 'MMPCCM')
      ACN(av:fac, FBN['Tasa2'])
      ACN(aw:fac, FBN['Total6'])

     (.'RTPCCM'.)
     If Dialogo.Radio3=1
        (.'RTUPPCCM'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If Incluido(FBN['TipoOp'], 'MMFIMV|MMSIMV')
     ACN(av:fac, FBN['Tasa2'])
     ACN(aw:fac, FBN['Total6'])

     (.'RTFIMV'.)
     If Dialogo.Radio3=1
       (.'RTUPFIMV'.)
       (.'IXGRAL'.)
     EndIf
  EndIf

  If Incluido(FBN['TipoOp'], 'MMFCMV|MMSCMV')
     (.'RTFIMV'.)
     If Dialogo.Radio3=1
       (.'RTUPFIMV'.)
       (.'IXGRAL'.)
     EndIf
  EndIf
 
  If Incluido(FBN['TipoOp'], 'MMPE|MMPI')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])

     (.'RTPEPI'.)
     If Dialogo.Radio3=1
        (.'RTUPPEPI'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCL')
      ACN(av:fac, FBN['TotalAux4'])
     (.'RTPCL'.)
     If Dialogo.Radio3=1
        (.'RTUPPCL'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If EQSTR(FBN['TipoOp'], 'MMON')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])

     (.'RTON'.)
     If Dialogo.Radio3=1
        (.'RTUPON'.)
        (.'IXGRAL'.)
     EndIf
  EndIf

  If EQSTR(FBN['TipoOp'],'MMPCCV|')
      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])

     (.'RTPCCV'.)
     If Dialogo.Radio3=1
        (.'RTUPPCCV'.)
        (.'IXGRAL'.)
     EndIf
  EndIf


   If EQSTR(FBN['TipoOp'],'MMPLME')
      (.'RTPLME'.)
      If Dialogo.Radio3=1
         (.'RTUPPLME'.)
         (.'IXGRAL'.)
      EndIf
   EndIf

   If Incluido(FBN['TipoOp'],'MMPSI|MMFRNP|')

      ACN(av:fac, FBN['TotalAux4'])
      ACN(aw:fac, FBN['TotalAux2'])

      (.'RTPSI'.)
      If Dialogo.Radio3=1
         (.'RTUPPSI'.)
         (.'IXFRNP'.)
      EndIf
   EndIf

   If Incluido(FBN['TipoOp'],'MMPSC|')
      (.'RTPSC'.)
      If Dialogo.Radio3=1
        (.'RTUPPSC'.)
         (.'IXFRN'.)
      EndIF
   EndIf

   If Incluido(FBN['TipoOp'],'MMFRN|')
      (.'RTFRN'.)
      If Dialogo.Radio3=1
         (.'RTUPFRN'.)
         (.'IXFRN'.)
       EndIf
   EndIf

   If Dialogo.Radio3=1
      *- Borro las excepciones anteriores
      SQL.ADD(" DELETE "~DBO~".EXCEPCIONES Where ")
      SQL.ADD(" NrOperacion='"~Val(i3)~"' and Tipo='MODEVENTO' ")
      SQL.NEW

      *- Siempre queda la ultima actualizacion
      SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
      SQL.ADD(" (NrOperacion, Fecha, Tipo, Descripcion ) Values ")
      SQL.ADD(" ('"~Val(i3)~"', '"~IdxDate(FSYS)~"' , 'MODEVENTO','Modificada Evento "~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~" - "~Hora(Ahora)~"' ) ")
      SQL.NEW

      (.'MODIINSIX'.)      
      SQL.ActualizarMovimientos(val(i3),SI)
      SQL.EXEC
   EndIf

  SetFont(a:fac..ar:fac,1)
  FormatoCeldas(b:fac,EXE('F8'))
  FormatoCeldas(ag:fac,EXE('F8'))
  FormatoCeldas(s:fac,EXE('F0'))
  FormatoCeldas(al:fac,EXE('F2'))
Proximo


FijarFila(8)
FijarCol(4)

Recorrer&i 1,9
   ACO(&i,7)
Proximo

Recorrer&i 10,48
  ACO(&i,9)
Proximo
ACO(23,0)
SetFilaActual(fac+2)

ACT(a:fac, 'FIN DEL INFORME')
ACT(xx:3,VAR('PATHREPTAS')~'IDXDEUDA'~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")

ExportarXLS(a:1..ar:fac, a1..ar:fac, val(xx3))

SetFont(a:fac, 2)
SetMargins(0, 0, 0, 0)
SetPrintFit(3, 80)
LimitesVision(ar:fac)
Impresion(1,2)






