creardialogo
nroperacion1:'# Operacion';;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

Sqladd("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
Sqladd("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
Sqladd("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


Acn(x1, 0)
Sqladd("Select O.NrOperacion, RB3 , NrBit from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B  where ")
Sqladd("O.NrOperacion='"~dialogo.nroperacion1~"' and  O.NrOperacion=B.NrOperacion ")
Sqladd("and ((NrBit = 8 and Valor = '1' and RB3='1') or (NrBit = 9 and Valor = '1' and (RB3<>'1' or RB3 is null)))  ")
recorrer sql
Acn(x1, 1)

Acn(x2, Query("Select count(*) from "~Dbo()~".MOVEJECUTADOS where NrOperacion='"~Fbn('NrOperacion')~"' and NrSaldo =1 "))

if (Eqstr(Fbn('RB3'), '1'))
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" where NrBit=8 and NrOperacion= '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" where NrBit=1 and NrOperacion= '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONES set LInstancia= 1 where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqlexec()
else
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
Sqladd(" where NrBit=9 and NrOperacion= '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" where NrBit=2 and NrOperacion= '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONES set LInstancia= 2 where NrOperacion = '"~Fbn('NrOperacion')~"' ")
Sqlnew()
Sqlexec()
endif
proximo
if (Val(x1) = 0)
