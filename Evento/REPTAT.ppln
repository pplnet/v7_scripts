HojaVisible(NO)
mostrarcuadrodemensajes
creardialogo
radio1:'Tipo|Reales|Simuladas';1;1;;NO;NO;;;;1;;;
entero1:'Dias+';2;1;;NO;NO;;;;dialogo.radio1 + 1;dialogo.radio1 + 1;;
fecha1:"Fecha Vigencia";1;1;;NO;;dialogo.fecha1 <> 0 y dialogo.fecha1 <= FSys();'Fecha Vigencia Invalida';NO;FSys();
nroperacion1:"Operacion";;;;;;
radio2:'Recalcula|NO|SI';;;;;;;;;1;;;
radio3:'Actualiza|NO|SI';;;;;;;;;1;;;
lista2:'Tipo Op.';5;1;;;;;;;;;SQLSet(" Select Codigo From "~Dbo()~".TIPOSOPERACION Where Codigo In ('SEPTMV','SEPVMV') ");
lista1:"Vehiculo";-1;2;;;;;;;;;iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet(" Select Codigo From "~Dbo()~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~Dbo()~".USRVEHICULO U, "~Dbo()~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo()~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
findialogo

if (not ok)
Cancelar()
endif

Act(ls:1000, iif (Vacio(UsrVehiculos(UsuarioActivo())), SQLSet("Select Codigo From "~Dbo()~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~Dbo()~".USRVEHICULO U, "~Dbo()~".VEHICULOS V Where U.Codigo='"~UsuarioActivo()~"' AND U.Vehiculo=V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
Act(ls:1100, SQLSet(" Select Codigo From "~Dbo()~".TIPOSOPERACION Where Codigo In ('SEPTMV','SEPVMV')"))

sql.add("SELECT DISTINCT O.TablaFeriados1, O.Plazo4 dias ")
sql.add(" from  "~Dbo()~".CUOTAS C, "~Dbo()~".OPERACIONES  O ")
sql.add(" where O.NrOperacion = C.NrOperacion ")
if (NoVacio(dialogo.lista1))
sql.add("       AND O.Vehiculo1 IN ("~pipe2comillas(dialogo.lista1)~") ")
else
sql.add("       AND O.Vehiculo1 IN ("~pipe2comillas(Val(ls:1000))~") ")
endif
if (NoVacio(dialogo.lista2))
sql.add("       AND O.TipoOp IN ("~pipe2comillas(dialogo.lista2)~") ")
else
sql.add("       AND O.TipoOp IN ("~pipe2comillas(Val(ls:1100))~") ")
endif
if (NoVacio(dialogo.nroperacion1))
sql.add(" and O.NrOperacion = '"~dialogo.nroperacion1~"'")
endif
if (dialogo.radio1 = 1 y dialogo.radio2 = 0)
sql.add(" and ((C.Check10 Is Null or C.Check10='' or C.Check10='0') and (((C.Precio1=0  or C.Precio1 Is Null or  C.Precio1='') and O.TipoOp Not In ('MMPCCM','MMFIMV','MMSIMV')) or ((C.Precio2=0  or C.Precio2 Is Null or  C.Precio2='') and O.TipoOp In ('MMPCCM','MMFIMV','MMSIMV')) )) ")
endif
sql.add("       and O.TipoOp In ('SEPTMV','SEPVMV') ")
sql.add("       and O.FechaOp<='"~IdxDate(dialogo.fecha1)~"' ")
sql.add("       and '"~IdxDate(dialogo.fecha1)~"' >= C.Fecha3 ")
sql.add("       and '"~IdxDate(dialogo.fecha1)~"' <= C.Fecha2 ")
sql.add("       and O.TipoTasa<>'FIJA' ")
sql.add(" Order By 1 ")
recorrer sql
Message(Fbn()['TablaFeriados1'])
Act(tf1, Fbn()['TablaFeriados1'])

Acd(f5, Habiles(dialogo.fecha1, -1, Var('FERIADODEF'), SI))

Acd(f6, Habiles(Val(f5), 1, null, SI))

recorrer&j Val(f6), dialogo.fecha1

if (DiaSem(&j) <> 1 y DiaSem(&j) <> 7)
Acd(fe2, Habiles(&j, -Fbn('dias'), null, SI))

if (not Eqstr(Val(tf1), Var('FERIADODEF')))
Acd(fe4, Habiles(&j, Fbn('dias'), Val(tf1), SI))
else
Acd(fe4, Habiles(&j, Fbn('dias'), null, SI))
endif

Acd(fe3, Habiles(&j, -Fbn('dias'), null, SI) + Fbn('dias'))
Acd(fe5, Habiles(&j, -Fbn('dias'), null, SI) + Fbn('dias'))

if (DiaSem(&j) = 5)
Acd(fe2, Habiles(&j, -Fbn('dias'), null, NO))
Acd(fe3, Habiles(&j, -Fbn('dias'), null, NO) + Fbn('dias'))
endif

Message('*- No Es Sabado o Domingo       ')
ejecutarevento('REPTAX', fecha1 = &j, fecha2 = &j, fecha4 = &j, fecha3 = Val(fe2), fecha5 = Val(fe4), nroperacion1 = dialogo.nroperacion1, radio1 = dialogo.radio1, radio2 = dialogo.radio2, radio3 = dialogo.radio3, entero1 = Fbn('dias'), lista2 = dialogo.lista2, lista1 = dialogo.lista1, feriado1 = Val(tf1))
endif
proximo
