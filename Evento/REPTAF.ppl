***---Swaps Unico Vto Datos Vehiculo
SQL.ADD("SELECT DISTINCT O.TablaFeriados1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('DTSFV','DTSVV')  ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPrecan > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoTasa<>'FIJA' AND O.TipoTasa Is Not Null AND O.TipoTasa<>' ' ")
SQL.ADD(" UNION ")
***--- Swaps Unico Vto Datos Contraparte
SQL.ADD("SELECT DISTINCT O.TablaFeriados1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O")
SQL.ADD(" Where ")
SQL.ADD(" O.TipoOp IN ('DTSFV','DTSVV') ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1000))~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
   SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:1100))~") ")
ENDIF
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPrecan > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoTasa2<>'FIJA' AND O.TipoTasa2 Is Not Null AND O.TipoTasa2<>' '  ")
SQL.ADD(" Order By 1")
Recorrer SQL
     Message(FBN['TablaFeriados1'])
     ACT(tf:1,FBN['TablaFeriados1'])

     *- f5: Ultimo dia en que ejecute el Informe
     ACD(f:5,HABILES(Dialogo.Fecha1,-1,VAR('FERIADODEF'),SI) )
     *- f6: Dia Siguiente que tendria que haberlo Ejecutado
     ACD(f:6,Habiles(VAL(f:5),1,,SI) )
     Recorrer&j val(f6),Dialogo.Fecha1
          If DiaSem(&j)<>1 y DiaSem(&j)<>7
             
             ACD(fe:2,Habiles(&j,Dialogo.Entero1,,SI))
    
             If Not EqStr(val(tf:1),VAR('FERIADODEF'))
                ACD(fe:4,Habiles(&j,Dialogo.Entero1,val(tf:1),SI))
             Else
                ACD(fe:4,Habiles(&j,Dialogo.Entero1,,SI))
             EndIf
             
             ACD(fe:3,Habiles(&j,Dialogo.Entero1,,SI)+Dialogo.Entero1 )
             ACD(fe:5,Habiles(&j,Dialogo.Entero1,,SI)+Dialogo.Entero1 )

             If DiaSem(&j)=5
                *- Jueves => Resetea Sabado, Domingo y Lunes
                ACD(fe:2,Habiles(&j,Dialogo.Entero1,,NO))    
                ACD(fe:3,Habiles(&j,Dialogo.Entero1,,NO)+Dialogo.Entero1 )
             EndIf
             Message('*- No Es Sabado o Domingo       ')
             EjecutarEvento('REPTAS',Fecha1=&j,Fecha2=&j,Fecha4=&j,Fecha3=val(fe:2),Fecha5=val(fe:4),NrOperacion1=Dialogo.NrOperacion1,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Entero1=Dialogo.Entero1,Lista2=Dialogo.Lista2,Lista1=Dialogo.Lista1,Feriado1=val(tf1), Check1 = Dialogo.Check1)
          EndIf
