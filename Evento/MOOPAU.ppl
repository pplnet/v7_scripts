* HojaVisible(SI)
CrearDialogo
  Fecha1: 'Fecha'  ;1;;;  ;  ;Dialogo.Fecha1<=FSys;'Fecha inválida';NO;Fsys
  Check1: 'Procesa'; ;;;SI;SI;;;;0
FinDialogo
If Not OK
    Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(m:1, Var('LINSPAUCIE'))

SQL.ADD("SELECT DISTINCT O.NrOperacion, O.TipoOp, O.FechaOp, O.FechaVto, O.Cliente1, O.Especie, B.NrBit ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE O.NrOperacion = B.NrOperacion ")
SQL.ADD("   AND B.Valor = '1' ")
SQL.ADD("   AND B.NrBit in ("~Var('LINSPAUCIE')~") ")
SQL.ADD("   AND O.TipoOp Not in('MMCO', 'MMCT', 'MMCREM', 'MMPF') ")

SQL.ADD(" ORDER BY O.NrOperacion, B.NrBit ")
Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACD(d:FAC, fbn('FechaVto'))
  ACT(e:FAC, fbn('Cliente1'))
  ACT(f:FAC, fbn('Especie'))
  ACN(g:FAC, fbn('NrBit'))

  if Val(g:FAC)<>69
    if Dialogo.Check1=1
      ***** Pone la instancia en la que esta en 'CERO'
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD("   SET InstAnterior  = "~FStr(Val(g:FAC),1,0)~" ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.NEW

      ***---Si no esta la instnacia 69, la crea
      IF SQL(" Select Count(1) From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Val(a:FAC)~"' AND NrBit=69 ") = 0
        ***---No estan las otras instancias => las inserto
        EjecutarEvento('INSBIT', Entero1 = 69, NrOperacion1=Val(a:FAC))
      ENDIF
      ***** Pone la instancia en la que esta en 'CERO'
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor       = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.ADD("   and NrBit       = "~FStr(Val(g:FAC),1,0)~" ")
      SQL.NEW

      ***** Pone la instancia 69 en 'UNO'
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor       = '1' ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.ADD("   and NrBit       = "~FStr(69,1,0)~" ")
      SQL.NEW
 
      *** Registro cambio en INSTANCIASOP
      ACT(h:FAC, 'Evento MOOPAU mueve a 69')
      SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
      SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Val(a:FAC)~"', "~FStr(Val(g:FAC),1,0)~", '"~USUARIOACTIVO~"', '"~Val(h:FAC)~"', "~SQLAhora~" )")
      SQL.NEW

      ACT(i:FAC, 'Pasaje automatico a Inst 69 desde '~FStr(Val(g:FAC),1,0))
      SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
      SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
      SQL.ADD(" ) Values ( ")
      SQL.ADD(" '"~Val(a:FAC)~"', ")
      SQL.ADD(" "~SQLAhora~", ")
      SQL.ADD(" 'A69AUTOM', ")
      SQL.ADD(" '"~Val(i:FAC)~"' ")
      SQL.ADD(" ) ")
      SQL.NEW

      SQL.EXEC
    endif
  endif
proximo
if FAC=0
  if Dialogo.Check1=0
     MessageBox('No hay operaciones para pasar a Compliance (69)')
  endif
endif

