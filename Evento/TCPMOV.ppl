*        SQL.ADD("                        ) ")        
*        SQL.New
endif        

        SQL.ADD("UPDATE "~DBO~".OPERACIONES                                      ")
        SQL.ADD("   SET Cuenta2='"~FBN['Cuenta2']~"', Cuenta3='"~FBN['Cuenta3']~"' ")
        SQL.ADD(" WHERE NrOperacion in (SELECT Op.NrOperacion                      ")
        SQL.ADD("                         From "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES OP, "~DBO~".ORDENES OD, "~DBO~".OPERACIONES OPTCP           ")
        SQL.ADD("                        WHERE OP.TipoOp = 'TCOPRI'                                                    ")
        SQL.ADD("                          and M.NrOperacion = OP.NrOperacion                                          ")
        SQL.ADD("                          and OP.NrOperacion = OD.NrOperacion2                                        ")
        SQL.ADD("                          and  OPTCP.NrOperacion = '"~FBN['NrTCPCEM']~"'                              ")
        SQL.ADD("                          and OP.FechaVto = "~IdxDate2(Val(fe:1))~"                                                                    ")
        SQL.ADD("                          and not exists(SELECT 1 FROM "~DBO~".MOVEJECUTADOS ME WHERE ME.NrOperacion=OD.NrOperacion1 )                 ")
        SQL.ADD("                          and OP.Cliente1<>OP.Vehiculo1 and OP.Cliente1<>'"~FBN['CliTCP']~"'                                          ")
        SQL.ADD("                        ) ")        
        SQL.New

        SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
        SQL.ADD("   SET FechaVto="~IdxDate2(Val(fe:1))~" ")
        SQL.ADD(" WHERE NrOperacion='"~FBN['NrTCPCEM']~"' ")
        SQL.New
        
        ACN(in:1,SQL("select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~FBN['NrTCPCEM']~"' and Valor = '1' "))
        EjecutarEvento('CBOINS', String1=FBN['NrTCPCEM'], Radio1=0, Radio2=2, Entero1=Val(in:1), Entero2=10)
        
        if no
        SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" SET Valor = '0' ")
        SQL.ADD(" Where (NrOperacion = '"~FBN['NrTCPCEM']~"') ")        
        SQL.New
        
        SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" SET Valor = '1' ")
        SQL.ADD(" Where NrOperacion = '"~FBN['NrTCPCEM']~"' and NrBit = 10 ")
        SQL.NEW
        endif
        
        ACT(co:2,FBN['NrTCPCEM'])
    endif
    SCN(co:1,1) 
    ACN(q:fac, fbn('Cantidad')     )
    ACT(a:fac, fbn('Especie')      )
    ACT(b:fac, fbn('NrTCPCEM')     )
    ACT(c:fac, fbn('Especie')      )
    ACT(d:fac, SQL("SELECT Cliente1 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~FBN('NrTCPCEM')~"'")      )
    if Eqstr(fbn('EspO'),fbn('Especie'))
        ACT(e:fac, fbn('Mercado')      )
    else
        ACT(e:fac, fbn('Mercado2')      )
    endif
    ACT(f:fac, fbn('EnteCustodia') )
    ACN(h:fac, fbn('NrSaldo')      )
    if DesciendeDeEspecie(fbn('Especie'),'TITULO')
        ACT(i:fac, fbn('Cuenta1')      )
    ELSE
        ACT(i:fac, fbn('Cuenta4')      )
    ENDIF
    ACT(l:fac, fbn('Book')         )
    ACD(n:fac, fbn('FechaMov')     )
    ACT(k:fac, fbn('Concepto')     )
    ACT(p:fac, fbn('Cupon')        )
    ACN(r:fac, fbn('Nrinstan')     )
    ACN(s:fac, fbn('NrGrupo2')     )
    ACN(t:fac, fbn('NrGrupo')      )
    ACT(u:fac, fbn('TipoCliente')      )
    * Revisar liquidacion
    *    ACT(v:fac, IIF(Incluido(fbn('Mercado'),'CV'),IIF(Eqstr(fbn('FormaLiquidacion1'),'1'),'CONF',IIF(Eqstr(fbn('FormaLiquidacion1'),'2'),'RVP' )),IIF(Eqstr(fbn('FormaLiquidacion2'),'1'),'MATCH')))

    SQL.ADD(" Insert into "~DBO~".MOVPENDIENTES           ")
    SQL.ADD(" (NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
    SQL.ADD("  Bits, NrSaldo, Cuenta, NrMov, Status, ")
    SQL.ADD(" Book,  FechaMov, Cantidad, Leyenda,         ")
    SQL.ADD(" NrGrupo, Concepto, Cupon, NrComprob,        ")     
    SQL.ADD(" NrGrupo2, Nrinstan)                         ")   
    SQL.ADD(" values  (                                   ")
    SQL.ADD(" '"~Val(b:fac)~"'  , '"~Val(a:fac)~"', '"~Val(d:fac)~"', '"~Val(e:fac)~"', '"~Val(f:fac)~"',                  ")
    SQL.ADD(" 'MV'  , "~fstr(Val(h:fac),0,0)~",  '"~Val(i:fac)~"', "~Fstr(Val(co:1),0,0)~", '"~val(v:fac)~"' ,             ")
*    SQL.ADD(" '"~Val(l:fac)~"'  ,  "~idxdate2(Val(n:fac))~", "~Fstr(-Val(q:fac),0,2)~", '"~val(u:fac)~" - "~Val(a:fac)~"', ")
    SQL.ADD(" '"~Val(l:fac)~"'  ,  "~idxdate2(Val(n:fac))~", "~Fstr(Val(q:fac),0,2)~", '"~val(u:fac)~" - "~Val(a:fac)~"', ")
    SQL.ADD(" '"~Val(t:fac)~"'  , '"~Val(k:fac)~"', '"~Val(p:fac)~"', '"~Fstr(1000+Val(co:1),1,0)~"',                      ")
    SQL.ADD(" '"~Val(s:fac)~"' , '"~Val(r:fac)~"'         ")
    SQL.ADD("         )                                   ")
    SQL.NEW
  else
    * NO Procesa
    MessageBox('No Procesa - Generando movimientos '~fbn('NrTCPCEM')~' '~fbn('TipoCliente')~' '~fbn('Especie'))
  endif
Proximo
IF Val(y:1)=1
  * Procesa
  SQL.EXEC
else
  * NO Procesa
  Messagebox('No Procesa - Fin')
endif
  
IF NO
  If val(co:1)=0
    Cancelar('No hay emisiones pendientes de liquidacion')
  else
    Messagebox('Movimientos de emisiones generados')   
