*        SQL.ADD("                          and  OPTCP.NrOperacion = '"~FBN['NrTCPCEM']~"'                              ")
*        SQL.ADD("                          and OP.FechaVto = "~IdxDate2(Val(fe:1))~"                                                                    ")
