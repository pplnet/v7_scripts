MostrarCuadroDeMensajes
CrearDialogo
   Radio1:       'Factura|Alta|Modif.'  ;1;1;;;;Dialogo.Radio1 >= 0;'Debe Elegir Alta o Modificacion';NO;-1;
   NrOperacion1: 'Operacion'            ;3;1;;;;;;;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('OPEIMPUEST'))~") ";
***---   NrOperacion1: 'Operacion'            ;3;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), Var('OPEIMPUEST'));'Operacion Invalida';NO;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('OPEIMPUEST'))~") ";
***---   String1:      'Nr.Factura'           ;3;1;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 O Longitud(Dialogo.String1) = 13;'Factura Invalida - Debe Ingresar 13 Caracteres';NO;
FinDialogo

If Not Ok
  Cancelar
Endif

***---Las Retenciones suelen ser 4 o 5, por lo que se reservan 10 campos para guardarlos, 
***---de String1 a String10
***---Los Tipos Impuesto por Indicador suelen ser 4 o 5, por lo que se reservan 10 campos para
***---guardarlos, de String11 a String20. Hablado con Silvana.

ACN(BD:8, 0)

IF Dialogo.Radio1 = 0
    ***---Alta de Factura
    ACT(TO:1, BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1))
    IF Eqstr(Val(TO:1), 'MMONM')
        IF BuscarCampo('OPERACIONES','MB3','NrOperacion', Dialogo.NrOperacion1) <= 0
            Cancelar(" La Obligacion Negociable no es una Emision Propia ")
        ENDIF
    ELSE 
        IF Eqstr(Val(TO:1), 'MMSELN')
           IF BuscarCampo('OPERACIONES','MB3','NrOperacion', Dialogo.NrOperacion1) = 1
             Cancelar(" Al Seller Notes Colocacion no se le asignan Impuestos")
           ENDIF       
        Endif 
    ENDIF
    ACN(BD:1, 0)
    ACT(NR:1, Dialogo.NrOperacion1)
    SQL.ADD(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
    SQL.ADD(" C.CUIT, M.NrMov, M.Cuenta ")
    SQL.ADD(" From "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B ")
    SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND M.Cliente = C.Codigo ")
    SQL.ADD(" AND O.NrOperacion = B.NrOperacion ")
    ***---Operacion Autorizada
    SQL.ADD(" AND B.NrBit >= 19 ")
    SQL.ADD(" AND B.Valor = '1' ")
    SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD(" AND M.Especie IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ")
    ***---Excluyo los movimientos de impuestos y los de WHT
    SQL.ADD(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
    SQL.ADD(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")
    ***---No se toma el alta del prestamo (NrMov=1)
    SQL.ADD(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")
    ***---Que el Movimiento no este Asignado y sin Liquidar
    SQL.ADD(" AND M.NrMov IN (Select M1.NrMov From "~DBO~".MOVPENDIENTES M1 ")
    SQL.ADD("                 Where M1.NrOperacion = O.NrOperacion ")
    SQL.ADD("                 AND M.NrMov Not IN (Select I.Plazo4 From "~DBO~".IMPUESTOS I ")
    SQL.ADD("      	                          Where I.NrOperacion = O.NrOperacion ")
    SQL.ADD("                                     AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
    SQL.ADD("                                     AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' '))) ")
    ***---Solo los del proximo vto.
    SQL.ADD(" AND M.FechaMov = (Select Min(M2.FechaMov) From "~DBO~".MOVPENDIENTES M2 ")
    SQL.ADD("                   Where M2.NrOperacion = O.NrOperacion ")
    SQL.ADD("                   AND (M2.FechaMov > O.FechaOp OR M2.NrMov > 1) ")
    SQL.ADD("                   AND (M2.NrMov < 8000 OR M2.NrMov > 9000) ")
    SQL.ADD("                   AND (M2.NrMov < 7000 OR M2.NrMov > 7100) ")
    SQL.ADD("                   AND M2.NrMov Not IN (Select I1.Plazo4 From "~DBO~".IMPUESTOS I1 ")
    SQL.ADD("                                        Where I1.NrOperacion = O.NrOperacion ")
    SQL.ADD("                                        AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
    SQL.ADD("                                        AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' '))) ")
    Recorrer SQL
        ACD(A:fac, fbn('FechaMov'))
        ACT(B:fac, fbn('Leyenda'))
        ACT(C:fac, fbn('Especie'))
        ACN(D:fac, fbn('Cantidad'))
        ACT(E:fac, fbn('Cliente'))
        ACT(F:fac, fbn('EnteCustodia'))
        ACT(G:fac, fbn('CUIT'))
        ACT(H:fac, fbn('Cuenta'))
        ACN(V:fac, fbn('NrMov'))
        ACN(BD:1, 1)
    Proximo
    IF Val(BD:1) = 1
        CrearListBox;'Arial,8,B';'Alta de Factura Operacion '~Dialogo.NrOperacion1~' - Seleccione los Conceptos para aplicarles los Impuestos'
           'Aplica'           ;Z:1..Z:fac;SI;[[Val(Y:FLB) = 1 Y Val(Z:FLB) = 1] O Val(Y:FLB) = 0];'Si el Concepto Es Exento, debe Aplicarse el Impuesto';45;CHECK;RGB(2,255,255);IIF(Val(Y:FLB) = 1, 1, Val(Z:FLB));
***---Se comenta porque existe un indicadorIVA exento
***---           'Exento'           ;Y:1..Y:fac;SI;;;45;CHECK;RGB(2,255,255);
           'FechaVto'         ;A:1..A:fac;NO;;;70;FECHA
           'Concepto'         ;B:1..B:fac;NO;;;150;STRING
           'Moneda'           ;C:1..C:fac;NO;;;50;STRING
           'Cantidad'         ;D:1..D:fac;NO;;;100;NUMERO;'###,###,###,###.##'
           'Proveedor'        ;E:1..E:fac;NO;;;70;STRING
           'Vehiculo'         ;F:1..F:fac;NO;;;100;STRING
           'CUIT'             ;G:1..G:fac;NO;;;100;STRING
        FinListBox
        IF Not OK
            Cancelar
        ENDIF
    ELSE
        Cancelar(" La Op. "~Dialogo.NrOperacion1~" No Tiene Mov. Ptes. de Liquidacion sin Impuestos Aplicados O No Esta Autorizada ")
    ENDIF
ELSE
    ***---Modificacion de Factura
    ACN(BD:1, 0)
    ACN(FI:6, 0)
    SQL.ADD(" Select Distinct NrSisExterno Factura From "~DBO~".IMPUESTOS ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD(" AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') ")
    SQL.ADD(" AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' ') ")
    Recorrer SQL
        DFA
        SCN(BD:1, 1)
        ACT(NF:Val(BD:1), fbn('Factura'))
        ACT(NX:Val(BD:1), Dialogo.NrOperacion1)
    Proximo
    IF Val(BD:1) = 0
        Cancelar(" La Operacion "~Dialogo.NrOperacion1~" No Tiene Factura Asignada - Elija Alta de Factura ")
    ENDIF
    IF Val(BD:1) > 1
        CrearListBox;'Arial,8,B';'Seleccione La Factura a Modificar'
           'OK'               ;W:1..W:Val(BD:1);;Sum(W:1..W:Val(BD:1)) = 1;'Debe Eligir Una Factura';45;CHECK;
           'Factura'          ;NF:1..NF:Val(BD:1);NO;;;150;STRING
           'Operacion'        ;NX:1..NX:Val(BD:1);NO;;;150;STRING
        FinListBox
        IF Not OK
            Cancelar
        ENDIF
    ENDIF
    ACT(NR:1, Dialogo.NrOperacion1)
    Recorrer&k 1, Val(BD:1)
        IF Val(W:&k) = 1
            ACT(NF:1, Val(NF:&k))
            Break
        ENDIF
    Proximo
    ACN(BD:7, 0)
    ***---Chequeo que no haya algun movimiento de la factura liquidado
    SQL.ADD(" Select M.NrOperacion ")
    SQL.ADD(" From "~DBO~".MOVEJECUTADOS M, "~DBO~".IMPUESTOS I ")
    SQL.ADD(" Where I.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND I.NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD(" AND I.NrSisExterno = '"~Val(NF:1)~"' ")
    SQL.ADD(" AND M.NrMov = I.Plazo4 ")
    Recorrer SQL
        DFA
        ACN(BD:7, 1)
    Proximo
    IF Val(BD:7) = 1
        Cancelar('La Factura '~Val(NF:1)~' Tiene Movimientos Liquidados -  Anule la Liquidacion Previamente')
    ENDIF
    ***---Movimientos Asignados a la Factura
    SQL.ADD(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
    SQL.ADD(" C.CUIT, 1 Estado, M.NrMov, M.Cuenta, I.Fecha1 FechaFac, I.Cantidad2 TotalFac, I.String21 CAI, I.String24 CBarra ")
    SQL.ADD(" From "~DBO~".MOVPENDIENTES M, "~DBO~".IMPUESTOS I, "~DBO~".CLIENTES C ")
    SQL.ADD(" Where I.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND M.Cliente = C.Codigo ")
    SQL.ADD(" AND I.NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD(" AND I.NrSisExterno = '"~Val(NF:1)~"' ")
    SQL.ADD(" AND M.NrMov = I.Plazo4 ")
    SQL.ADD(" AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ') ")
    ***---Excluyo los movimientos de impuestos y WHT
    SQL.ADD(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
    SQL.ADD(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")

    SQL.ADD(" UNION ")

    ***---Movimientos de la operacion no Asignados a ninguna Factura de la misma fechaMov a los
    ***---ya Asignados
    SQL.ADD(" Select M.Cantidad, M.Leyenda, M.FechaMov, M.Cliente, M.Especie, M.EnteCustodia, ")
    SQL.ADD(" C.CUIT, 0 Estado, M.NrMov, M.Cuenta, M.FechaMov FechaFac, 0 TotalFac, '' CAI, '' CBarra ")
    SQL.ADD(" From "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
    SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND M.Cliente = C.Codigo ")
    SQL.ADD(" AND M.NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD(" AND M.NrMov Not IN (Select Plazo4 From "~DBO~".IMPUESTOS I ")
    SQL.ADD("                     Where I.NrOperacion = M.NrOperacion ")
    SQL.ADD("                     AND (I.Check2 = 0 OR I.Check2 Is Null OR I.Check2 = '' OR I.Check2 = ' ') ")
    SQL.ADD("                     AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ')) ")
***---    SQL.ADD("                     AND I.NrSisExterno = '"~Val(NF:1)~"') ")
    SQL.ADD(" AND M.FechaMov = (Select Max(Fecha2) From "~DBO~".IMPUESTOS I ")
    SQL.ADD("                   Where I.NrOperacion = M.NrOperacion ")
    SQL.ADD("                   AND (I.Check2 = 0 OR I.Check2 Is Null OR I.Check2 = '' OR I.Check2 = ' ') ")
    SQL.ADD("                   AND (I.Check3 = 0 OR I.Check3 Is Null OR I.Check3 = '' OR I.Check3 = ' ') ")
    SQL.ADD("                   AND I.NrSisExterno = '"~Val(NF:1)~"') ")
    ***---No se toma el alta del prestamo (NrMov=1)
    SQL.ADD(" AND (M.FechaMov > O.FechaOp OR M.NrMov > 1) ")
    ***---Excluyo los movimientos de impuestos y WHT
    SQL.ADD(" AND (M.NrMov < 8000 OR M.NrMov > 9000) ")
    SQL.ADD(" AND (M.NrMov < 7000 OR M.NrMov > 7100) ")
    SQL.ADD(" Order By Estado Desc ")
    Recorrer SQL
        ACD(A:fac, fbn('FechaMov'))
        ACT(B:fac, fbn('Leyenda'))
        ACT(C:fac, fbn('Especie'))
        ACN(D:fac, fbn('Cantidad'))
        ACT(E:fac, fbn('Cliente'))
        ACT(F:fac, fbn('EnteCustodia'))
        ACT(G:fac, fbn('CUIT'))
        ACT(H:fac, fbn('Cuenta'))
        ACN(R:fac, fbn('Estado'))
        ACN(V:fac, fbn('NrMov'))
        IF fbn('Estado') = 1
            ACD(FX:1, fbn('FechaFac'))
            ACN(MN:1, fbn('TotalFac'))
            ACT(CA:1, fbn('CAI'))
            ACT(CB:1, fbn('CBarra'))
            ACD(FC:1, Fecha(Copy(Val(CB:1), 38, 2)~'/'~Copy(Val(CB:1), 36, 2)~'/'~Copy(Val(CB:1), 32, 4)))
        ENDIF
        ACN(BD:1, 1)
    Proximo
    CrearListBox;'Arial,8,B';'Modificacion de Factura '~Val(NF:1)~' - Seleccione los Conceptos para aplicarles los Impuestos'
       'Aplica'           ;Z:1..Z:fac;SI;Sum(Z:1..Z:fac) > 0 Y [[Val(Y:FLB) = 1 Y Val(Z:FLB) = 1] O Val(Y:FLB) = 0];IIF(Sum(Z:1..Z:fac) = 0, 'Debe Elegir Al Menos un Concepto a Incluir en La Factura', 'Si el Concepto Es Exento, debe Aplicarse el Impuesto');45;CHECK;RGB(2,255,255);IIF(Val(Y:FLB) = 1, 1, Val(Z:FLB));
       ***---Se comenta porque existe un indicadorIVA exento
       ***---       'Exento'           ;Y:1..Y:fac;SI;;;45;CHECK;RGB(2,255,255)
       'Aplicado'         ;R:1..R:fac;NO;;;55;CHECK;
       'FechaVto'         ;A:1..A:fac;NO;;;70;FECHA
       'Concepto'         ;B:1..B:fac;NO;;;150;STRING
       'Moneda'           ;C:1..C:fac;NO;;;50;STRING
       'Cantidad'         ;D:1..D:fac;NO;;;100;NUMERO;'###,###,###,###.##'
       'Proveedor'        ;E:1..E:fac;NO;;;70;STRING
       'Vehiculo'         ;F:1..F:fac;NO;;;100;STRING
       'CUIT'             ;G:1..G:fac;NO;;;100;STRING
    FinListBox
    IF Not OK
        Cancelar
    ENDIF
ENDIF
ACN(BD:1, 0)
ACN(BD:3, 0)
***---Contador Filas para ListBox de Iva y Percepcion
ACN(FI:3, 0)
ACN(BD:6, 0)
Recorrer&k 1, fac
    SCN(BD:3, 1)
    IF Val(Z:&k) = 1
        SCN(BD:1, 1)
        IF DesciendeDeCliente(Val(E:&k), 'BANCOS')
            ACN(BD:2, 1)
        ELSE
            ACN(BD:2, 0)
        ENDIF
        IF Val(BD:1) = 1
            ***---Primer concepto a aplicar => Ingresa Datos Factura Legal
            IF Dialogo.Radio1 = 0
                ***---Alta de Factura
                IF  Val(BD:2) = 1
                    ***---Es un banco => busco nro correlativo por operacion como Centro Emisor
                    ACN(CE:2, SQL(" Select Max(Convert(int, SubString(NrSisExterno, 1, 4))) From "~DBO~".IMPUESTOS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ')  "))
                    SCN(CE:2, 1)
                    ACT(CE:1, Pad0(Fstr(Val(CE:2), 0, 0), 4))
                    ***---Tipo de Factura = Caracter Fijo
                    ACT(TF:1, 'X')
                    ***---Nro de Factura = NrOperacion
                    ACT(FA:1, Val(NR:1))
                ENDIF
                ***---Nro. Factura Legal
                (.'ASIIMP1'.)
            ELSE
                ***---Modif. de Factura
                IF Val(BD:1) = 1
                    ***---Primer concepto a aplicar => Ingresa Datos Factura Legal
                    ***---Nro. Factura Legal
                    ACT(CE:1, Copy(Val(NF:1), 1, 4))
                    IF Val(BD:2) = 1
                        ACT(TF:1, Copy(Val(NF:1), 5, 1))
                    ENDIF
                    ACT(FA:1, Copy(Val(NF:1), 6, 8))
                    (.'ASIIMP1'.)
                ENDIF
            ENDIF
        ENDIF
        ACN(FI:1, 0)
        ***---Retenciones
        SQL.ADD(" Select RP.TipoRetencion, RP.Indicador, R.PorcentajeRetencion ")
        SQL.ADD(" From "~DBO~".RETENCIONESPROV RP, "~DBO~".RETENCIONES R ")
        SQL.ADD(" Where RP.TipoRetencion = R.TipoRetencion ")
        SQL.ADD(" AND RP.Indicador = R.Indicador ")
        SQL.ADD(" AND RP.Cliente = '"~Val(E:&k)~"' ")
        SQL.ADD(" AND RP.Vehiculo = '"~Val(F:&k)~"' ")
        Recorrer SQL
            DFA
            SCN(FI:1, 1)
            ACT(TR:Val(FI:1), fbn('TipoRetencion'))
            ACT(ID:Val(FI:1), fbn('Indicador'))
            ACN(PR:Val(FI:1), fbn('PorcentajeRetencion'))
            ACN(X:Val(FI:1), 1)
            ***---Lista de Indicadores para cada Tipo de retencion
            SQL.ADD(" Select Indicador From "~DBO~".RETENCIONES ")
            SQL.ADD(" Where TipoRetencion = '"~fbn('TipoRetencion')~"' ")
            Recorrer SQL
                DFA
                ACT(LI:Val(FI:1), Val(LI:Val(FI:1))~fbn('Indicador')~'|')
            Proximo
        Proximo
        IF Val(FI:1) > 0
            CrearListBox;'Arial,8,B';'Aplicacion de RETENCIONES al Concepto '~Val(B:&k)
               'TipoRet'          ;TR:1..TR:Val(FI:1);NO;;;150;STRING
               'Indicador'        ;ID:1..ID:Val(FI:1);;Incluido(Val(ID:FLB), Val(LI:FLB));" Indicador No Habilitado para el Tipo de Retencion ";60;TABLA;'RETENCIONES';'Indicador';'Indicador;DescripcionIndicador';" TipoRetencion = '"~Val(TR:FLB)~"' ";RGB(2,255,255)
               'Porcentaje'       ;PR:1..PR:Val(FI:1);NO;;;100;NUMERO;'###.########';;SQL(" Select PorcentajeRetencion From "~DBO~".RETENCIONES Where TipoRetencion = '"~Val(TR:FLB)~"' AND Indicador = '"~Val(ID:FLB)~"' ");
               'Aplica'           ;X:1..X:Val(FI:1);SI;;;45;CHECK;RGB(2,255,255)
            FinListBox
            IF Not OK
                Cancelar
            ENDIF
            ACN(BD:4, 0)
            SCN(BD:6, 1)
            IF Val(BD:6) = 1 Y Dialogo.Radio1 = 1
                ***---Se aplico una Retencion => Elimino Aplicaciones anteriores de la Factura
                ***---SQL.ADD(" Delete "~DBO~".IMPUESTOS ")
                ***---SQL.ADD(" Where NrSisExterno = '"~Val(NF:1)~"' ")
                ***---SQL.NEW
                ***---SQL.EXEC
                ***---Se aplico una Retencion => Marco la Factura como anulada
                SQL.ADD(" Update "~DBO~".IMPUESTOS ")
                SQL.ADD(" Set Check3 = '1' ")
                SQL.ADD(" Where NrSisExterno = '"~Val(NF:1)~"' ")
                SQL.NEW
                SQL.EXEC
            ENDIF
            Recorrer&j 1, Val(FI:1)
                IF Val(X:&j) = 1
                    ***---Guardo Retenciones aplicadas
                    SCN(BD:4, 1)
                    ACT(ST:Val(BD:4), Val(TR:&j)~'|'~Val(ID:&j))
                ENDIF
            Proximo
            IF Val(BD:4) > 0
                ***---Se aplico al menos un TipoRetencion al concepto => Se graba
                ACN(MX:1, SQL(" Select Max(NrCuota) From "~DBO~".IMPUESTOS Where NrOperacion = '"~Val(NR:1)~"' ") + 1)
                SQL.ADD(" Insert Into "~DBO~".IMPUESTOS ")
                SQL.ADD(" (NrOperacion, NrCuota, Plazo4, ")
                Recorrer&j 1, Val(BD:4)
                    SQL.ADD(" String"~Fstr(&j, 0, 0)~", ")
                Proximo
                SQL.ADD(" Cliente1, NrSisExterno, Vehiculo1, Especie1, ")
                SQL.ADD(" Cantidad1, Fecha1, Fecha2, ")
                SQL.ADD(" Fecha3, Check1, Fecha4, ")
                SQL.ADD(" String21, String22, String23, Cuenta1, String24) ")
                SQL.ADD(" Values ")
                SQL.ADD(" ('"~Val(NR:1)~"', "~Fstr(Val(MX:1), 0, 0)~", "~Fstr(Val(V:&k), 0, 0)~", ")
                Recorrer&j 1, Val(BD:4)
                    SQL.ADD(" '"~Val(ST:&j)~"', ")
                Proximo
                SQL.ADD(" '"~Val(E:&k)~"', '"~Val(FL:1)~"', '"~Val(F:&k)~"', '"~Val(C:&k)~"', ")
                SQL.ADD(" "~Fstr(Val(D:&k), 0, 2)~", '"~IdxDate(Val(FX:1))~"', '"~IdxDate(Val(A:&k))~"', ")
                SQL.ADD(" '"~IdxDate(Fsys)~"', "~Fstr(Val(Y:&k), 0, 0)~", '"~IdxDate(Val(FC:1))~"', ")
                SQL.ADD(" '"~Val(CA:1)~"', '"~Val(B:&k)~"', '"~UsuarioActivo~"', '"~Val(H:&k)~"', '"~Val(CB:1)~"') ")
                SQL.NEW
                SQL.EXEC
                ACN(BD:8, 1)
                MessageBox('Retenciones Aplicadas al Concepto '~Val(B:&k))
            ENDIF
        ELSE
            MessageBox('El Proveedor '~Val(E:&k)~' No Tiene Retenciones con el Vehiculo '~Val(F:&k))
        ENDIF
        ***---Guardo los datos para IVA y Percepcion
        SCN(FI:3, 1)
        ACD(AA:Val(FI:3), Val(A:&k))
        ACT(BB:Val(FI:3), Val(B:&k))
        ACT(CC:Val(FI:3), Val(C:&k))
        ACN(DD:Val(FI:3), Val(D:&k))
        ACT(EE:Val(FI:3), Val(E:&k))
        ACT(FF:Val(FI:3), Val(F:&k))
        ACT(HH:Val(FI:3), Val(H:&k))
        ACN(VV:Val(FI:3), Val(V:&k))
        ACN(YY:Val(FI:3), Val(Y:&k))
        IF Val(Y:&k) = 1
            ***---Exento
            ACT(IX:Val(FI:3), 'Exento')
        ENDIF
    ENDIF
    IF Val(BD:3) = fac Y Val(BD:1) > 0
        ***---Ultimo Concepto y se eligio al menos uno => Aplico IVA y Percepcion
        CrearListBox;'Arial,8,B';'Aplicacion de IVA y Percepcion'
           'Concepto'         ;BB:1..BB:Val(FI:3);NO;SI;;150;STRING
           'Moneda'           ;CC:1..CC:Val(FI:3);NO;SI;;50;STRING
           'Cantidad'         ;DD:1..DD:Val(FI:3);NO;SI;;100;NUMERO;'###,###,###,###.##'
           'Indicador'        ;IX:1..IX:Val(FI:3);Val(YY:FLB) = 0;NoVacio(Val(IX:FLB));'Indicador Invalido';60;TABLA;'INDICADORIVAPER';'Codigo';'Codigo;Descripcion';;RGB(2,255,255)
        FinListBox
        IF Not OK
            Cancelar
        ENDIF
        ***---TT1 = SubTotal Impuestos por Concepto
        ***---TT2 = Total Impuestos
        ***---TT3 = Total Cantidad
        ACN(FI:2, 0)
        ACN(TT:2, 0)
        ACN(TT:3, 0)
        Recorrer&j 1, Val(FI:3)
            ***---Calculo IVA y Percepcion de acuerdo al indicador elegido
            IF Val(YY:&j) = 1
                ***---Exento
                SCN(FI:2, 1)
                ACT(WA:Val(FI:2), Val(BB:&j))
                ACT(WB:Val(FI:2), Val(CC:&j))
                ACT(WC:Val(FI:2), Fstr(Val(DD:&j), 0, 2))
                ACT(WG:Val(FI:2), Val(CC:&j))
                ACT(WH:Val(FI:2), Fstr(0, 0, 2))
                ACT(WD:Val(FI:2), Val(IX:&j))
                SCN(FI:2, 1)
                ACT(WA:Val(FI:2), 'Total Concepto')
                ACT(WB:Val(FI:2), Val(CC:&j))
                ACT(WC:Val(FI:2), Fstr(Val(DD:&j), 0, 2))
                ACT(WG:Val(FI:2), Val(CC:&j))
                ACT(WH:Val(FI:2), Fstr(0, 0, 2))
                SCN(TT:3, Round(Val(DD:&j), 2))
                SCN(FI:2, 1)
            ELSE
                ACN(TT:1, 0)
                ACN(BD:5, 0)
                ***---Obtengo Impuestos del Indicador
                SQL.ADD(" Select D.TipoImpuesto, D.Porcentaje, T.Descripcion ")
                SQL.ADD(" From "~DBO~".DETALLEIVAPER D, "~DBO~".TIPOSIMPUESTO T ")
                SQL.ADD(" Where D.Codigo = '"~Val(IX:&j)~"' ")
                SQL.ADD(" AND D.TipoImpuesto = T.Codigo ")
                Recorrer SQL
                    DFA
                    SCN(BD:5, 1)
                    SCN(FI:2, 1)
                    IF Val(BD:5) = 1
                        ACT(WA:Val(FI:2), Val(BB:&j))
                    ENDIF
                    ACT(WB:Val(FI:2), Val(CC:&j))
                    ACT(WC:Val(FI:2), Fstr(Val(DD:&j), 0, 2))
                    ACT(WD:Val(FI:2), Val(IX:&j))
                    ACT(WE:Val(FI:2), fbn('TipoImpuesto'))
                    ACT(WF:Val(FI:2), fbn('Descripcion'))
                    ACT(WG:Val(FI:2), Fstr(fbn('Porcentaje'), 0, 2))
                    ACT(WH:Val(FI:2), Fstr(Val(DD:&j) * fbn('Porcentaje') / 100, 0, 2))
                    SCN(TT:1, Val(DD:&j) * fbn('Porcentaje') / 100)
                    ***---Marca para saber que fila son TipoImpuesto y grabarla
                    ACN(ZX:Val(FI:2), 1)
                Proximo
                SCN(FI:2, 1)
                ACT(WA:Val(FI:2), 'Total Concepto')
                ACT(WB:Val(FI:2), Val(CC:&j))
                ACT(WC:Val(FI:2), Fstr(Val(DD:&j), 0, 2))
                ACT(WG:Val(FI:2), Val(CC:&j))
                ACT(WH:Val(FI:2), Fstr(Val(TT:1), 0, 2))
                ***---Marca para saber que es fila fin del concepto
                ACN(ZY:Val(FI:2), 1)
                SCN(TT:2, Round(Val(TT:1), 2))
                SCN(TT:3, Round(Val(DD:&j), 2))
                SCN(FI:2, 1)
            ENDIF
        Proximo
        ***---No Hago el Break para el ultimo concepto
        ACN(ZY:Val(FI:2)-1, 0)
        SCN(FI:2, 2)
        ACT(WA:Val(FI:2), 'Total Factura')
        ACT(WB:Val(FI:2), Val(CC:&j))
        ACT(WC:Val(FI:2), Fstr(Val(TT:3), 0, 2))
        ACT(WG:Val(FI:2), Val(CC:&j))
        ACT(WH:Val(FI:2), Fstr(Val(TT:2), 0, 2))
        ACT(WI:Val(FI:2), Fstr(Val(TT:2) + Val(TT:3), 0, 2))
        ACT(WJ:Val(FI:2), Fstr(Val(MN:1), 0, 2))
        CrearListBox;'Arial,8,B';'Detalle Calculos de IVA y Percepcion'
           'Concepto'         ;WA:1..WA:Val(FI:2);NO;SI;;150;STRING;;;
           'Mon.'             ;WB:1..WB:Val(FI:2);NO;SI;;30;STRING
           'Cantidad'         ;WC:1..WC:Val(FI:2);NO;SI;;85;STRING;
           'Indicador'        ;WD:1..WD:Val(FI:2);NO;SI;;60;STRING
           'TipoImpuesto'     ;WE:1..WE:Val(FI:2);NO;SI;;85;STRING
           'Descripcion'      ;WF:1..WF:Val(FI:2);NO;SI;;150;STRING
           '%'                ;WG:1..WG:Val(FI:2);NO;SI;;40;STRING
           'Total Impuestos'  ;WH:1..WH:Val(FI:2);NO;SI;;90;STRING
           'Total Factura'    ;WI:1..WI:Val(FI:2);NO;SI;;80;STRING;
           'Monto Ingresado'  ;WJ:1..WJ:Val(FI:2);SI;Num(Val(WI:FLB)) = Num(Val(WJ:FLB)) O Num(Val(WJ:FLB)) = 0;'Total Factura No Coincide con Monto Ingresado para Control';100;STRING
        FinListBox
        IF Not OK
            Cancelar
        ENDIF
        ACN(MN:1, Num(Val(WJ:Val(FI:2))))
        ***---Fila Inicio de cada concepto en la grilla
        ACN(FI:5, 1)
        IF Dialogo.Radio1=1
            ***---Anulo la Factura.
            SQL.ADD(" Update "~DBO~".IMPUESTOS ")
            SQL.ADD(" Set Check3 = '1' ")
            SQL.ADD(" Where NrSisExterno = '"~Val(NF:1)~"' ")
            SQL.NEW
            SQL.EXEC
        ENDIF
        Recorrer&j 1, Val(FI:3)
            ***---Grabo Datos de IVA y Percepcion
            ***---TA1 = Cantidad de TiposImpuesto por Indicador
            ACN(TA:1, 0)
            Recorrer&i Val(FI:5), Val(FI:2)
                ***---Por cada Concepto Recorro cada TipoImpuesto del Indicador
                IF Val(ZX:&i) = 1
                    SCN(TA:1, 1)
                    ACT(TE:Val(TA:1), Val(WE:&i))
                    ACN(TG:Val(TA:1), Num(Val(WG:&i)))
                    ACN(TH:Val(TA:1), Num(Val(WH:&i)))
                ENDIF
                IF Val(ZY:&i) = 1
                    ***---El Proximo Recorrer&i arranca en &i del recorrer actual
                    ACN(FI:5, &i+1)
                    Break
                ENDIF
            Proximo
            IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where NrOperacion = '"~Val(NR:1)~"' AND Plazo4 = "~Val(VV:&j)~" AND (Check2 = 0 OR Check2 Is Null OR Check2 = '' OR Check2 = ' ') AND (Check3 = 0 OR Check3 Is Null OR Check3 = '' OR Check3 = ' ') ") = 1
                ***---Se aplico Retencion o IvaPer al NrMov
                SQL.ADD(" Update "~DBO~".IMPUESTOS ")
                SQL.ADD(" Set ")
                IF Val(YY:&j) = 0
                    ***---No Exento
                    Recorrer&i 1, Val(TA:1)
                        SQL.ADD(" String"~Fstr(&i+10, 0, 0)~" = '"~Val(TE:&i)~"', ")
                        SQL.ADD(" Precio"~Fstr(&i, 0, 0)~" = "~Fstr(Val(TG:&i), 0, 2)~", ")
                        SQL.ADD(" Total"~Fstr(&i, 0, 0)~" = "~Fstr(Val(TH:&i), 0, 2)~", ")
                    Proximo
                ELSE
                    Recorrer&i 1, 10
                        SQL.ADD(" String"~Fstr(&i+10, 0, 0)~" = '', ")
                        SQL.ADD(" Precio"~Fstr(&i, 0, 0)~" = 0, ")
                        SQL.ADD(" Total"~Fstr(&i, 0, 0)~" = 0, ")
                    Proximo
                        SQL.ADD(" Check1 = 1, ")
                ENDIF
                SQL.ADD(" Sucursal = '"~Val(IX:&j)~"', ")
                SQL.ADD(" String23 = '"~UsuarioActivo~"', ")
                SQL.ADD(" String24 = '"~Val(CB:1)~"', ")
                SQL.ADD(" Fecha4 = '"~IdxDate(Val(FC:1))~"', ")
                SQL.ADD(" Cantidad2 = "~Fstr(Val(MN:1), 0, 2)~" ")
                SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
                SQL.ADD(" AND Plazo4 = "~Val(VV:&j)~" ")
                SQL.NEW
                ACN(BD:8, 1)
            ELSE
                ***---No se aplicaron Retenciones
                ACN(MX:1, SQL(" Select Max(NrCuota) From "~DBO~".IMPUESTOS Where NrOperacion = '"~Val(NR:1)~"' ") + 1)
                SQL.ADD(" Insert Into "~DBO~".IMPUESTOS ")
                SQL.ADD(" (NrOperacion, NrCuota, Plazo4, ")
                SQL.ADD(" Sucursal, NrSisExterno, Cliente1, ")
                SQL.ADD(" Vehiculo1, Especie1, Cantidad1, ")
                SQL.ADD(" Fecha1, Fecha2, Fecha3, ")
                IF Val(YY:&j) = 0
                    ***---No Exento
                    Recorrer&i 1, Val(TA:1)
                        SQL.ADD(" String"~Fstr(&i+10, 0, 0)~", ")
                        SQL.ADD(" Precio"~Fstr(&i, 0, 0)~", ")
                        SQL.ADD(" Total"~Fstr(&i, 0, 0)~", ")
                    Proximo
                ENDIF
                SQL.ADD(" Check1, String22, String23, Cuenta1, ")
                SQL.ADD(" String21, Cantidad2, Fecha4, String24) ")
                SQL.ADD(" Values ")
                SQL.ADD(" ('"~Val(NR:1)~"', "~Fstr(Val(MX:1), 0, 0)~", "~Fstr(Val(VV:&j), 0, 0)~", ")
                SQL.ADD(" '"~Val(IX:&j)~"', '"~Val(FL:1)~"', '"~Val(EE:&j)~"', ")
                SQL.ADD(" '"~Val(FF:&j)~"', '"~Val(CC:&j)~"', "~Fstr(Val(DD:&j), 0, 2)~", ")
                SQL.ADD(" '"~IdxDate(Val(FX:1))~"', '"~IdxDate(Val(AA:&j))~"', '"~IdxDate(Fsys)~"', ")
                IF Val(YY:&j) = 0
                    ***---No Exento
                    Recorrer&i 1, Val(TA:1)
                        SQL.ADD(" '"~Val(TE:&i)~"', ")
                        SQL.ADD(" "~Fstr(Val(TG:&i), 0, 2)~", ")
                        SQL.ADD(" "~Fstr(Val(TH:&i), 0, 2)~", ")
                    Proximo
                ENDIF
                SQL.ADD(" "~Fstr(Val(YY:&j), 0, 0)~", '"~Val(BB:&j)~"', '"~UsuarioActivo~"', '"~Val(HH:&j)~"', ")
                SQL.ADD(" '"~Val(CA:1)~"', "~Fstr(Val(MN:1), 0, 2)~", '"~IdxDate(Val(FC:1))~"', '"~Val(CB:1)~"') ")
                SQL.NEW
                ACN(BD:8, 1)
            ENDIF
            SQL.EXEC
        Proximo
    ENDIF
Proximo
SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,SI,NO,NO,NO,NO)
SQL.EXEC
IF Val(BD:8) = 1
    LinkearHoja('ASIIMP', 1, NrOperacion1=Dialogo.NrOperacion1, String1=Val(FL:1))
ENDIF