creardialogo
fecha1:"Fecha Desde";;;;;;dialogo.fecha1 <> 0 y dialogo.fecha1 < FSys();'Debe Ingresar la Fecha Desde';NO;Habiles(FSys(), -1, 'ARG', SI)
fecha2:"Fecha Hasta";;;;;;dialogo.fecha2 >= dialogo.fecha1;'Debe Ingresar la Fecha Hasta';NO;FSys()
vehiculo1:'Vehiculo1';;;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'El Vehiculo  es Invalido';NO;
cliente1:'Cliente1';;;;;;NoVacio(dialogo.cliente1);'El Cliente Tomador es Invalido';NO;;;;
especie1:'Moneda';;;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'MONEDA');'Debe Ingresar una Especie Valida';NO;
precio1:'Tasa';;;;;;dialogo.precio1 <> 0;'Tasa Incorrecta';NO;;
string:'ListaEspecies';;;;NO;NO;NoVacio(dialogo.string);'No Existe el Par de Vehiculo/Cliente';NO;;sql("SELECT ListaEspecies FROM "~Dbo()~".IMPTERCEROS  Where Estado='HAB' and Vehiculo='"~dialogo.vehiculo1~"' and Cliente='"~dialogo.cliente1~"'  ")
findialogo

if (not ok)
Cancelar()
endif

if (not Incluido(dialogo.especie1, dialogo.string))
Cancelar()('La Especie no esta habilitada para el par de Vehiculo/Cliente')
endif

SetFilaActual(1)

Acd(af1, dialogo.fecha1)

Acn(h2, 1)

Acn(aa2, DifDias(dialogo.fecha1, dialogo.fecha2, 'ARG', SI))

recorrer&i 1, Val(aa2) + 1

Acn(a1, 0)
Acn(a1, sql("SELECT Tasa from "~Dbo()~".TASASTERCEROS where Vehiculo='"~dialogo.vehiculo1~"' and Cliente='"~dialogo.cliente1~"' and Especie ='"~dialogo.especie1~"' and Fecha='"~IdxDate(Val(af1))~"' "))

if (Val(a1) = 0)
Message('Creando Tasa : '~Val(af1)~' ...')
sql.add("INSERT INTO "~Dbo()~".TASASTERCEROS ")
sql.add(" (Fecha,Vehiculo,Cliente,")
sql.add(" Especie,Tasa) ")
sql.add(" Values ")
sql.add(" ('"~IdxDate(Val(af1))~"','"~dialogo.vehiculo1~"','"~dialogo.cliente1~"', ")
sql.add(" '"~dialogo.especie1~"',"~FStr(dialogo.precio1, 0, 5)~") ")
sql.new
sql.exec
else
break
endif

Acd(af1, Habiles(Val(af1), 1, 'ARG', SI))
proximo

if (Val(a1) <> 0)
Cancelar()(' El par de Vehiculos Ya tenia tasa para el Dia '~Val(af1)~' ....!')
endif

