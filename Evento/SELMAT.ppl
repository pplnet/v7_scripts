**- Selecciona los movs. pendientes de transacciones de saldos 101, -**
**- que se encuentren en la instancia de confirmacion, para la lista -**
**- con las transacciones que desee elegir para matchear. -**
*HojaVisible(SI)
MostrarCuadroDeMensajes
ACT(es1,SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo "))
CrearDialogo
   Vehiculo1  : 'Vehiculo'            ;;;;;;;;;VAR('VEHICULODE')
   Fecha1     : 'FechaValor'          ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(FSys,0,'ARG',SI)
   Fecha2     : 'FechaConf'           ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha de Confirmacion';NO;FSys
   Lista1     : 'Casas Custodia'      ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".MERCADOS WHERE Observaciones LIKE '%T|%' ORDER BY Codigo ");
   Lista2     : "Especies"                          ;  ;1;;;;;;;;;VAL(es1);SI
   Lista3     : "Excluye Especies"                  ;-5;2;;;;;;;;;VAL(es1);SI
FinDialogo

If Not Ok
   Cancelar
Endif

**- Nro. de Saldo Libre Disponibilidad 
ACN(a:1, BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')) )

SetFilaActual(3)

ACN(qf:1, 0)

**- Selecciono los Mov. de Transacciones de Saldos 101 que esten en Instancia de Confirmacion
SQL.ADD("SELECT Distinct T.NrTrans, T.TipoTr2, T.Fecha1, T.Cliente1, T.Cliente2, ")
SQL.ADD("       T.Cuenta1, T.Cuenta2, T.Especie, T.Cantidad1, T.Precio1, T.Cambio1, ")
SQL.ADD("       T.Mercado1, T.CB6, T.NrOperacionRef1, T.CB1, T.CB2, M.NrOperacion,CT1.NrDepositante as NrDepositante1 ")
SQL.ADD("FROM   "~DBO~".MOVPENDIENTES M WITH (NOLOCK index = INDMP1), "~DBO~".TRANSACCIONES2 T, ")
SQL.ADD("       "~DBO~".CUENTAS CT1,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("WHERE  M.NrOperacion = T.NrTrans ")
SQL.ADD("       and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and OB.NrOperacion=T.NrTrans ")
SQL.ADD("       and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("       and T.TipoTr2  IN ('DTP','RTP','DRT') ")
SQL.ADD("       and CT1.Codigo  = T.Cuenta1 ")
*** se agrega para tomar solo los DTP/RTP manuales ***
*SQL.ADD("       and T.CB1      <> '1' ")
*CAMBIA CB1 X CB6 PORQUE DEJA AFUERA LAS QUE NO SON TRF. CB6 = AUTOMATICA.
SQL.ADD("       and (T.CB6 <> '1' or T.CB6 is null) ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       and T.Mercado1 In ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Endif
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("    AND T.Especie IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF NoVacio(Dialogo.Lista3)
   SQL.ADD("    AND T.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
ENDIF
SQL.ADD("       and OB.NrBit=1 and OB.Valor='1' ")
SQL.ADD("       and M.NrSaldo = "~Fstr(val(a1),0,0)~" ")
SQL.ADD("ORDER BY T.Fecha1,T.Especie,CT1.NrDepositante,T.Cuenta2  ")

ACT(z1,'')
ACT(z2,'')

Message('Recuperando Informacion.')

Recorrer SQL
   If Not EqStr(FBN['Cuenta2'],val(z2))
      ACT(z2,FBN['Cuenta2'])
      ACT(aa2,'')
      If NoVacio(val(z2))
         ACT(aa2,BuscarCampo('CUENTAS','NrDepositante','Codigo',FBN['Cuenta2']))
      EndIf
   EndIf

   ACT(a:FAC, FBN['NrTrans'])
   ACT(b:FAC, FBN['TipoTr2'])
   ACD(c:FAC, FBN['Fecha1'])
   ACT(d:FAC, FBN['Cliente1'])
   ACT(e:FAC, FBN['Cliente2'])
   ACT(f:FAC, FBN['NrDepositante1'])
   ACT(g:FAC, val(aa2))
   ACT(h:FAC, FBN['Especie'])

   *- Por cada cambio de especie recupero el cupon actual
   If Not EqStr(FBN['Especie'],val(z1))
      ACT(z1,FBN['Especie'])
      ACT(r:fac,Fstr(NrCupon2(val(z1),Dialogo.Fecha1),0,0))
   Else
      ACT(r:fac,val(r:fac-1))
   EndIf

   ACN(i:FAC, FBN['Cantidad1'])
   ACN(j:FAC, FBN['Precio1'])
   ACN(k:FAC, FBN['Cambio1'])
   ACT(l:FAC, FBN['Mercado1'])
   ACT(m:FAC,'')

   *- DEP/RET que dio origen al DTP/RTP Automatico 
   If EqStr(FBN['CB6'],'1')
      ACT(m:FAC,FBN['NrOperacionRef1'])
   EndIf

   ACN(n:FAC, NUM(FStr(FBN['CB1'],0,0)))
   ACN(o:FAC, NUM(FStr(FBN['CB2'],0,0)))
   ACT(p:FAC, FBN['NrOperacion'])
   ACN(q:FAC, 0)
   SCN(qf:1, 1)
Proximo

If Val(qf:1)>0 

   **- Armo la lista de las transacciones que puede seleccionar
   CrearListBox ; 'Arial,8,';'Seleccion de Transacciones para Matcheo '
      'Matcheo'      ;q:4..q:FAC;  ;;;18;CHECK ;RGB(220,220,193);;NO;NO;;NO;NO;NO;SI
      'Especie'      ;h:4..h:FAC;NO;;;45;TABLA;'Especies';'Codigo';'Codigo;Nombre';
      'CuponMatch'   ;r:4..r:FAC;NO;;;30;STRING;
      'Comit.Cta1'   ;f:4..f:FAC;NO;;;75;TABLA;'Cuentas';
      'Cliente1'     ;d:4..d:FAC;NO;;;80;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
      'Cantidad VN'  ;i:4..i:FAC;NO;;;90;NUMERO;'###,###,###';
      'Fecha'        ;c:4..c:FAC;NO;;;60;FECHA;
      'TipoTrans '   ;b:4..k:FAC;NO;;;45;STRING;
      'NrTrans'      ;a:4..k:FAC;NO;;;65;STRING;
      'Transf'       ;n:4..n:FAC;NO;;;18;CHECK;
      'Interna'      ;o:4..o:FAC;NO;;;18;CHECK;
      'C.Cust'       ;l:4..l:FAC;NO;;;37;STRING;
      'Cliente2'     ;e:4..e:FAC;NO;;;80;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
      'Comit.Cta2'   ;g:4..g:FAC;NO;;;75;TABLA;'Cuentas';
      'Precio'       ;j:4..j:FAC;NO;;;65;NUMERO;'##,###,###.########';
      'Monto'        ;k:4..k:FAC;NO;;;90;NUMERO;'###,###,###.##';
   FinListBox

   If Not OK
      Cancelar('No se seleccionaron transaciones para matchear')
   Endif

   If Ok
      **- Recorro las filas para ver cual esta seleccionada
      Recorrer&i 4, FAC

         If Val(q:&i) = 1
            **- Marco la Transaccion que se esta matcheando          
            SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Dialogo.Fecha1)~"',Cupon2='"~val(r:&i)~"'")
            SQL.ADD("WHERE  NrTrans= '"~Val(a:&i)~"' ")
            SQL.NEW
            SQL.EXEC

            SQL.ActualizarMovimientosT2(Val(a:&i),SI,NO,NO,SI,0,4)
            SQL.EXEC

            *- Pasa de Instancia
            ACT(az3,Val(a:&i))
            ACT(az4,'TRANSACCIONES2')
            ACN(az5,70)
            ACN(az6,1 )
            
            (.'MODIINSTAN'.)

            IF NoVacio(val(m:&i))
               *- Recupero los nros. de operacion que originaron la transaccion
               SQL.ADD("SELECT DISTINCT NrOperacion ")
               SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS WITH (INDEX = INDME5 ) ")
               SQL.ADD("WHERE  NrTrans2 = '"~val(m:&i)~"'")
               SQL.ADD("       and NrOperacion  <> '"~val(m:&i)~"'")

               Recorrer SQL
                  DFA
                  *- Confirmo la operacion para sacar los movimientos de limites
                  ACT(op:1,FBN['NrOperacion'])
                  (.'CONFOPEXTR'.)
               Proximo

               *- Muevo el DEP o RET  a la instancia Termial '~val(m:&i)
               ACT(az3,val(m:&i))
               ACT(az4,'TRANSACCIONES2')
               ACN(az5,70)
               ACN(az6,0 )
            
               (.'MODIINSTAN'.)
               (.'MARCACONF'.)
            EndIf

         Endif
      Proximo
      Messagebox('Fin del Matcheo')
   Endif
Else
   Messagebox('No se encontraron transacciones para matchear')
Endif
