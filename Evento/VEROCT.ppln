creardialogo
fecha1:'Fecha';1;1;;NO;;;;;FSys();
lista1:'TiposOp';2;1;;;;;;;;;'FXOCTC|FXOCTV'
string1:'NroSec. Dde';3;1;;;;;;;SQLSet("Select Min(Secuencia) from "~Dbo()~".OPSIOPEL where Fecha = '"~IdxDate(dialogo.fecha1)~"' ");;;;'#####'
string2:'NroSec. Hta';3;2;;;;;;;SQLSet("Select Max(Secuencia) from "~Dbo()~".OPSIOPEL where Fecha = '"~IdxDate(dialogo.fecha1)~"' ");;;;'#####'
especie1:'Moneda';4;1
cliente1:'Cliente';4;2
cantidad1:'Cantidad Dde.';5;1
cantidad2:'Cantidad Hta.';5;2;;;;;;;999999999;;
findialogo
if (not ok)
Cancelar()
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,12,B")
SetFilaActual(0)

Act(aa1, Copy(getnumerador(890), 4, 5))


Sqladd("UPDATE "~Dbo()~".OPERACIONES  Set NrOrden = '"~Val(aa1)~"' ")
Sqladd("where NrOperacion In                                     ")
Sqladd("   (Select O.NrOperacion")
Sqladd("    from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
Sqladd("    where O.NrOperacion = B.NrOperacion ")
Sqladd("    and   O.RB6 = '2'   ")
Sqladd("    and   O.MB6 = '4'   ")
Sqladd("    and   B.NrBit = 1  ")
Sqladd("    and   B.Valor = '1' ")
Sqladd("    and ((O.NroAltaMAE between '"~dialogo.string1~"' and '"~dialogo.string2~"') ")
Sqladd("        or O.NroAltaMAE is Null) ")
Sqladd("    and   (O.NrOrden = ' ' or O.NrOrden is Null) ")
if (NoVacio(dialogo.lista1))
Sqladd("   and   O.TipoOp In ("~Pipe2Comillas(dialogo.lista1)~")")
endif
if (NoVacio(dialogo.especie1))
Sqladd("   and   O.Especie = '"~dialogo.especie1~"' ")
endif
if (NoVacio(dialogo.cliente1))
Sqladd("and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
if (dialogo.cantidad1 <> 0)
Sqladd("   and   O.Cantidad >= "~dialogo.cantidad1~" ")
endif
if (dialogo.cantidad2 <> 0)
Sqladd("   and   O.Cantidad <= "~dialogo.cantidad2~" ")
endif
Sqladd("   )")
Sqlnew()
Sqlexec()

Acn(zz1, 0)
Act(az1, '')

Sqladd("Select  ")
Sqladd(" O.TipoOp, O.Especie, O.NrOperacion,O.Cliente1, O.Cantidad,O.Puesto, O.Plazo4, O.Plazo, ")
Sqladd(" O.Mercado2, O.PrecioMer,O.NroAltaMAE,O.Cotizacion2,O.TipoCambio3,O.Precio2,O.TotalBrutoCli1, ")
Sqladd(" O.Book1,O.FormaLiquidacion1, O.OficialCuenta, O.Vehiculo1, O.Precio1, O.FechaVto, O.MB1, ")
Sqladd(" E.Descripcion, O.CB7, O.NrOperacion2 ")
Sqladd("from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".EXCEPCIONES E ")
Sqladd("where  O.NrOperacion = B.NrOperacion ")
Sqladd("       and   O.NrOperacion *= E.NrOperacion ")
Sqladd("       and   O.RB6 = '2' ")
Sqladd("       and   O.MB6 = '4'   ")
Sqladd("       and   B.NrBit = 1 ")
Sqladd("       and   B.Valor = '1' ")
Sqladd("       and   O.NrOrden = '"~Val(aa1)~"'")
Sqladd("Order by O.NrOperacion, O.NroAltaMAE, Cantidad, TipoOp, Especie  ")
recorrer sql
if (not Eqstr(Val(az1), Fbn()['NrOperacion']))
Acn(zz1, 1)
Acn(a:fac, 0)
Act(b:fac, Fbn()['TipoOp'])
Act(c:fac, Fbn()['Especie'])
Act(d:fac, Fbn()['NrOperacion'])
Act(e:fac, Fbn()['Cliente1'])
Act(f:fac, PYC(Fbn()['Cantidad'], 1, 2))
Act(i:fac, FStr(Fbn()['Plazo'], 0, 0))
Act(j:fac, Fbn()['Mercado2'])
Act(n:fac, PYC(Fbn()['Precio1'], 1, 7))
Act(o:fac, PYC(Fbn()['TotalBrutoCli1'], 1, 2))
Act(p:fac, Fbn()['Book1'])
Act(r:fac, Fbn()['OficialCuenta'])
Act(s:fac, Fbn()['Vehiculo1'])
Act(t:fac, Fbn()['NroAltaMAE'])
Acd(u:fac, Fbn()['FechaVto'])
Act(v:fac, Fbn()['MB1'])
if (Eqstr(Fbn()['MB1'], '0'))
Act(w:fac, 'EMTA')
else
if (Eqstr(Fbn()['MB1'], '1'))
Act(w:fac, 'A 3500')
else
Act(w:fac, 'Otro')
endif
endif
if (Eqstr(Fbn()['CB7'], '1'))
Act(y:fac, 'Manual')
else
Act(y:fac, 'Siopel')
endif
Act(az1, Fbn()['NrOperacion'])
endif
Act(x:fac, Fbn()['Descripcion'])
Act(ab:fac, Fbn()['NrOperacion2'])
proximo

if (Val(zz1) = 0)
Messagebox('NO hay Operaciones OCT desde SIOPEL')
Cancelar()
endif

crearlistbox;'Times New Roman,9,';'Operaciones Informadas desde SIOPEL'
'TipoOp';b:1..b:fac;NO;;;60;string;;Exe('COLOR9');
'Moneda';c:1..c:fac;NO;;;40;string;;Exe('COLOR9');
'Secuencia';t:1..t:fac;NO;;;55;string;;Exe('COLOR9');
'Cliente';e:1..e:fac;NO;;;80;string;;Exe('COLOR9');
'Cantidad';f:1..f:fac;NO;;;90;string;;Exe('COLOR9');
'Plazo';i:1..i:fac;NO;;;30;string;;Exe('COLOR9');
'Precio';n:1..n:fac;NO;;;95;string;;Exe('COLOR9');
'Origen';y:1..y:fac;NO;;;70;string;;Exe('COLOR9');
'Ok';a:1..a:fac;NoVacio(Val(d:flb));;;30;check;;;;;;;NO;;
'Monto $';o:1..o:fac;NO;;;90;string;;Exe('COLOR9');
'Book';p:1..p:fac;NoVacio(Val(d:flb));;;55;tabla;'Books';'Codigo';'Codigo,Descripcion';;;;
'Responsable';r:1..r:fac;NO;;;70;string;;Exe('COLOR9');
'NrOperacion';d:1..d:fac;NO;;;70;string;;Exe('COLOR9');
'F.Vencimiento';u:1..u:fac;NO;;;70;string;;Exe('COLOR9');
'Fixing';w:1..w:fac;NO;;;70;string;;Exe('COLOR9');
'Excepciones';x:1..x:fac;NO;;;150;string;;Exe('COLOR9');
'Mercado';j:1..j:fac;NO;;;55;string;;Exe('COLOR9');
'Observaciones';ob:1..ob:fac;NoVacio(Val(d:flb));;;150;string;250;;
finlistbox

if (not ok)
Sqladd("Update "~Dbo()~".OPERACIONES     ")
Sqladd("   Set NrOrden = Null           ")
Sqladd(" where NrOrden = '"~Val(aa1)~"' ")
Sqlnew()
Sqlexec()
Cancelar()
endif

recorrer&i 1, Fac()
if (Val(a:&i) = 1)
if (Query("Select Count(*) from "~Dbo()~".OPERACIONESBITS where NrOperacion = '"~Val(d:&i)~"' and NrBit = 1 and Valor = '1' ") <> 0)
Sqladd("Update "~Dbo()~".OPERACIONES set")

Sqladd(" Book1 = '"~Val(p:&i)~"',")
Sqladd(" Observaciones = '"~Val(ob:&i)~"'")
Sqladd("  where NrOperacion = '"~Val(d:&i)~"'  ")
Sqlnew()

Sqladd("Update "~Dbo()~".OPERACIONES                                 ")
Sqladd("   Set Direccion = 2                                        ")
Sqladd(" where NrOperacion = '"~Val(d:&i)~"'                        ")
Sqlnew()

Sqladd("Update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor = '0' ")
Sqladd(" where NrOperacion = '"~Val(d:&i)~"' ")
Sqlnew()

if (Vacio(Val(ab:&i)) o Eqstr(Val(ab:&i), '') o Eqstr(Val(ab:&i), ' ') o Eqstr(Val(ab:&i), '00000'))
Sqladd("Update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor = '1' ")
Sqladd(" where NrOperacion = '"~Val(d:&i)~"' ")
Sqladd(" and NrBit = 80 ")
else
Sqladd("Update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor = '1' ")
Sqladd(" where NrOperacion = '"~Val(d:&i)~"' ")
Sqladd(" and NrBit = 80 ")
endif
Sqlnew()
Sqlexec()
else
Messagebox('La Operacion '~Val(d:&i)~' no se encuentra en la instancia Alta SIOPEL')
endif
endif

proximo

Sqladd("Update "~Dbo()~".OPERACIONES     ")
Sqladd("   Set NrOrden = Null           ")
Sqladd(" where NrOrden = '"~Val(aa1)~"' ")
Sqlnew()
Sqlexec()
