HojaVisible(SI)
MostrarCuadroDeMensajes

CrearDialogo
    Fecha1:  'Fecha Saldos'               ;1;1;1;SI;SI;EsHabil(Dialogo.Fecha1,'ARG');'Dia no habil';SI;FSYS
    Directorio1:    'Path XLS'        ;2;1;1;SI;SI;;;;Var('PATHDN')
    String1:    'Archivo XLS'         ;3;1;1;SI;SI;;;;Var('FILEDN')
FinDialogo

If not ok
    Cancelar
Endif

(.'VALIDPATH'.)

*** Corregir path
let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

ACT(C:1,'Importacion de Saldos Bancarios')
SetFont(C:1,1)

ImportarXLS(F:4..G:10000,Y:4..Z:100000, &pf)
If Not Ok
    Cancelar('Error al cargar el archivo'~&pf)
Endif

let &fecSaldos Val(ZZ:4)

**-Validación de la fecha--**
If &fecSaldos <> Dialogo.Fecha1
    HojaVisible(NO)
    Cancelar('Fecha Saldos('~Dialogo.Fecha1~') y fecha del CSV('~&fecSaldos~') son distintas')
Endif

Message('Insertando registros en la Base de Datos')


***------------------- PROCESAMIENTO DE DATOS A LA BASE ---------------------------*
Recorrer&j 5, 100000
    
    If NoVacio(Val(ZY:&j))
    
    **let &nombreCta BuscarCampo('CUENTAS','Nombre','NrCuenta',Val(ZY:&j))
        **let &bancoCta BuscarCampo('CUENTAS','Banco','NrCuenta',Val(ZY:&j))
        * If Not SQL(" Select 1 from "~dbo~".CUENTAS Where NrCuenta ='"~Val(ZY:&j)~"' ")=1
        *ACT(M:&j, 'No existe la cuenta Nr:'~Val(ZY:&j)~' ')
        *Else
            If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo >= '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(ZY:&j)~"' and Estado <> 'ANU'  ")=1
                IF SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(ZY:&j)~"' and Estado <> 'ANU'  ")=1
                    ACT(M:&j, 'Ya existe saldo para '~Val(ZY:&j)~' al '~Dialogo.Fecha1~' ')
                Else
                    ACT(M:&j, 'Existen saldos posteriores para '~Val(ZY:&j)~' al '~Dialogo.Fecha1~' ')
                Endif
                ColorCeldas(M:&j, clRED)
            Else
            
                ACD(DD:1,Fecha(PriDeMes(&fecSaldos,SI)))
                let &contable 0
                let &operativo 0
                let &inicial 0
                let &dias 0
                ****-------------- Buscar saldos anteriores (del mismo mes) para calcular promedios --------******
                If Val(DD:1) < &fecSaldos
                    SQL.ADD(" Select TOP 1 SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu from "~dbo~".SALDOSBANCARIOS ")
                    SQL.ADD(" where NrCuenta = '"~Val(ZY:&j)~"' and FechaSaldo < '"~IdxDate(&fecSaldos)~"' and  FechaSaldo >= '"~IdxDate(Val(DD:1))~"' and Estado <> 'ANU' ")
                    SQL.ADD(" Order by FechaSaldo DESC ")
                    Recorrer SQL
                        let &contable FBN['SaldoAcuCon']
                        let &operativo FBN['SaldoAcuOpe']
                        let &inicial FBN['SaldoAcuIni']
                        let &dias FBN['DiasAcu']
                        break
                    Proximo
                Endif
                
                let &contable &contable+Val(ZZ:&j)

                let &inicial &inicial+Val(ZZ:&j)

                let &operativo &operativo+Val(ZZ:&j)
                
                let &flag2 0

                ***--------------- Insertar saldo de siguiente/s fecha/s no habil/es  --------***
                Recorrer&k &fecSaldos, Habiles(&fecSaldos,+1,'ARG')-1
                    let &dias &dias+1
                    If &flag2=0 y Fecha(&k) > FinDeMes(&fecSaldos,SI)
                        ***---Cambio de Mes
                        let &dias 1
                        let &flag2 1 
                        let &operativo Val(ZZ:&j)
                        let &contable Val(ZZ:&j)
                        let &inicial Val(ZZ:&j)
                    ELSE
                        IF &k > &fecSaldos
                            ***---Los dias no hábiles sumo al acumulado el saldo del dia hábil anterior
                            let &operativo &operativo + Val(ZZ:&j)
                            let &contable &contable + Val(ZZ:&j)
                            let &inicial &inicial + Val(ZZ:&j)
                        ENDIF
                    Endif
                    SQL.ADD(" INSERT INTO "~dbo~".SALDOSBANCARIOS ")
                    SQL.ADD(" (FechaSaldo, FechaBajada, FechaCarga, NrCuenta, SaldoContable, ")
                    SQL.ADD(" SaldoInicio, SaldoOperativo, Proyectado24h, Proyectado48h, ")
                    SQL.ADD(" Estado, ")
                    SQL.ADD(" SaldoOpePromedio, SaldoConPromedio, Usuario, SaldoIniPromedio, ")
                    SQL.ADD(" SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, Ajuste ) ")
                    SQL.ADD(" Values('"~IdxDate(Fecha(&k))~"' , '"~IdxDate(FSYS)~"' , "~SQLAhora~" , '"~Val(ZY:&j)~"' , "~Fstr(Val(ZZ:&j),1,2)~" , ")
                    SQL.ADD(" "~Fstr(Val(ZZ:&j),1,2)~" , "~Fstr(Val(ZZ:&j),1,2)~" , "~Fstr(Val(ZZ:&j),1,2)~" , "~Fstr(Val(ZZ:&j),1,2)~" , ")
                    SQL.ADD(" 'REC' , ")
                    SQL.ADD(" "~Fstr(&operativo/&dias,1,2)~" , "~Fstr(&contable/&dias,1,2)~" , '"~UsuarioActivo~"' , "~Fstr(&inicial/&dias,1,2)~" , ")
                    SQL.ADD(" "~Fstr(&contable,1,2)~", "~Fstr(&operativo,1,2)~", "~Fstr(&inicial,1,2)~", "~Fstr(&dias,1,0)~", 0)  ")
                    SQL.NEW
                    SQL.EXEC
                Proximo
                
            Endif
            *Endif
    Else
        Cancelar('Finalizando Evento, no se encontraron más Cuentas')
    Endif
    
Proximo


