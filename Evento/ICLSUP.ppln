creardialogo
fecha1:'Fecha';;;;;;;;;;FSys()
nroperacion1: 'CONU';;;;;;;;;;;;;;"TipoOp In ('CONU') and  CB10=1"
vehiculo1:'Vehiculo';;;;NO;;NoVacio(dialogo.vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
findialogo

if (not ok)
Cancelar()
endif

sql.add(" Select * From ")
sql.add(" (Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, CB1, FechaVto, ")
sql.add("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',1)) as Saldo, ")
sql.add("  (Select "~Dbo()~".SaldoCONU(O.NrOperacion,'"~IdxDate(dialogo.fecha1)~"',2)) as Utilizado, ")
sql.add("  CB8,CB9,CB10 ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" where O.NrOperacion = OB.NrOperacion ")
if (NoVacio(dialogo.nroperacion1))
sql.add("  and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
else
sql.add("   and (FechaVto >= '"~IdxDate(dialogo.fecha1)~"'  or CB1=1) and CB2=1 ")
endif
sql.add("   and ISNULL(O.CB10,'0') = '1' ")
sql.add("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")
sql.add("and TipoOp in ('CONU') ) as Aux")
sql.add(" Where Saldo > 0  ")
Watch(sql.batch)

recorrer sql

Acn(a:fac, 1)
Act(b:fac, Fbn()['NrOperacion'])
Act(c:fac, Fbn()['Cliente1'])
Act(d:fac, Fbn()['Especie'])
Acn(e:fac, Fbn()['Cantidad'])
Act(f:fac, Fbn()['FechaOp'])
if (Fbn()['CB1'] = 1)
Act(g:fac, '')
else
Act(g:fac, Fbn()['FechaVto'])
endif
Act(h:fac, Fbn()['Book1'])
Acn(i:fac, Fbn()['Saldo'])
Acn(j:fac, Fbn()['Utilizado'])
Acn(k:fac, Fbn()['Saldo'])
Act(l:fac, iif (Eqstr(Fbn()['CB9'], '1'), 'Bloqueo', 'DesBloqueo'))
Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';'Supervision Bloqueo/Desbloqueo CONU'
'Accion ?';a:1..a:fac;SI;;;60;combo;'Ok|Rechaza'
'Operacion';b:1..b:fac;NO;;;70;string;;
'Opcion';l:1..l:fac;NO;;;70;string;;
'Cliente';c:1..c:fac;NO;;;70;string;;
'Especie';d:1..d:fac;NO;;;70;string;;
'Monto Original';e:1..e:fac;NO;;;100;numero;'##,###,###,###.##';
'Fecha Op';f:1..f:fac;NO;;;80;string;;
'Fecha Vto';g:1..g:fac;NO;;;80;string;
'Book';h:1..h:fac;NO;;;60;string;
'Imp. utilizado';j:1..j:fac;NO;;;100;numero;'##,###,###,###.##';
'Saldo Capital';i:1..i:fac;NO;;;100;numero;'##,###,###,###.##';
'Imp. a Cancelar';k:1..k:fac;NO;;;100;numero;'##,###,###,###.##';
finlistbox

if (not ok)
Cancelar()
endif

if (ok)
recorrer&i 1, Fac()
if (Val(a:&i) = 0)
Message('Supervision Bloqueo/Desbloqueo CONU ... ')
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" SET CB10 = '0' ")
sql.add(" Where NrOperacion = '"~Val(b:&i)~"' ")
sql.new
sql.exec
else
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set CB9 = CB8, ")
sql.add(" CB10 = '0' ")
sql.add(" Where NrOperacion = '"~Val(b:&i)~"' ")
sql.new
sql.exec
endif
proximo
endif
else
Messagebox('No se encontraron operaciones para Supervisar')
endif

