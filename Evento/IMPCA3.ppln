sql.add(" Select O.NrOperacion, O.FechaOp, O.Cliente1, O.TipoOp, O.Especie, O.Cantidad, O.ContraEspecie, O.CB3, O.Vehiculo1 ")
sql.add(" from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B ")
sql.add(" where  O.NrOperacion = B.NrOperacion ")
sql.add(" and B.NrBit > 19 and B.Valor ='1' ")
sql.add(" and O.FechaOp = '"~IdxDate(dialogo.fecha1)~"' ")
sql.add(" and (O.NrOrden Is Null OR O.NrOrden = '') ")
if (NoVacio(Val(zz:6)))
sql.add("   and O.Vehiculo1 In ("~pipe2comillas(Val(zz:6))~") ")
endif
sql.add(" order by O.NrOperacion ")
recorrer sql
