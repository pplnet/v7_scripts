Sqladd(" SELECT /*+ RULE */ M.*, C.NrOperacion Operacion, C.NrMovimiento NrMov, C.Fecha ")
Sqladd(" FROM "~Dbo()~".MOVDATANET M, "~Dbo()~".DATANET D, "~Dbo()~".CONCILIACIONES C, ")
Sqladd(" "~Dbo()~".CUENTAS CU ")
Sqladd(" WHERE M.NrDataNet    = D.NrDatanet ")
Sqladd(" AND   M.NrDataNet    = C.NrDatanet ")
Sqladd(" AND   M.NrMovDataNet = C.NrMovDatanet ")
Sqladd(" AND   M.Cuenta       = CU.Numero ")
Sqladd(" AND   D.FechaBajada  = "~IdxDate2(dialogo.fecha1)~" ")
Sqladd(" AND   M.Vehiculo     = '"~dialogo.vehiculo1~"' ")
Sqladd(" AND   M.EstadoConciliacion <> 'P' ")
Sqladd(" AND   D.Archivo IN ("~Pipe2Comillas(dialogo.lista3)~") ")
if (NO)
if (dialogo.radio1 = 0)
Sqladd(" AND   D.Archivo = 'DNCTAS' ")
endif
if (dialogo.radio1 = 1)
Sqladd(" AND   D.Archivo = 'DNAHMS' ")
endif
if (dialogo.radio1 = 2)
Sqladd(" AND   D.Archivo = 'DNCCDO' ")
endif
if (dialogo.radio1 = 3)
Sqladd(" AND   D.Archivo = 'DNCADO' ")
endif
if (dialogo.radio1 = 4)
Sqladd(" AND   D.Archivo = 'DNCOBR' ")
endif
if (dialogo.radio1 = 5)
Sqladd(" AND   D.Archivo = 'DNOTRO' ")
endif
endif
if (NoVacio(dialogo.lista1))
Sqladd(" AND   CU.Comitente IN ("~Pipe2Comillas(dialogo.lista1)~") ")
endif
if (NoVacio(dialogo.lista2))
Sqladd(" AND   CU.Codigo IN ("~Pipe2Comillas(dialogo.lista2)~") ")
endif
Sqladd(" ORDER BY M.Banco, M.Cuenta, M.Moneda ")

Acn(z:1, 0)

recorrer sql
Acn(z:1, 1)
