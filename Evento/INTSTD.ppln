MostrarCuadroDeMensajes()
creardialogo
radio1:'Proceso|Default|Excel';;;;;;;;;;;;
string1:'Archivo';;;;;;;;;;;;;
directorio2:'Path Pend.';;;;;;;;;;;;;
directorio3:'Path Proc.';;;;;;;;;;;;;
nrunicoasiento1: 'Nr Asiento';;;;;;;;;;;;;
nroperacion1:'Operacion';;;;;;;;;;;;;
tipoop1:'Tipo de Op.';;;;;;;;;;;;;
fecha3:'F.Valor Desde';;;;;;;;;;;;;
fecha4:'F.Valor Hasta';;;;;;;;;;;;;
lista1:'Vehiculo';;;;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

if (Vacio(dialogo.nrunicoasiento1) y dialogo.radio1 = 0)
Acn(mg:1, Messagebox('No ingreso NrAsiento, Confirma?', 1, 1))
if (Val(mg:1) = 2)
Cancelar()
endif
endif

if (Eqstr(Var('INTASIENTO'), 'SI'))
Cancelar('Se esta ejecutando el proceso contable con SAP...Por favor intente en unos minutos')
else
if (Eqstr(Var('GENASIENTO'), 'SI'))
Cancelar('Ya esta siendo ejecutado el proceso contable...Por favor intente en unos minutos')
endif
endif

Sqladd(" Update "~Dbo()~".VARIABLES Set Valor='SI' Where Codigo='INTASIENTO' ")
Sqlnew()
Sqlexec()

if (NoVacio(dialogo.lista1))
Act(zz:6, dialogo.lista1)
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Act(zz:6, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"' "))
endif
endif

Acn(co:1, 0)
Act(ml:2, Var('MONELOCA'))
Act(cl:66, Var('CLDOCNOSAP'))
Act(vh:1, Var('VEHIEXTRAN'))
Acd(fi:1, Fecha(Var('FEVAINI')))

Act(nl:1, FStr(Exe('NRLOTE') + 1, 0, 0))
Act(fe:1, FStr(Anio(FSys()), 0, 0)~Pad0(FStr(Mes(FSys()), 0, 0), 2)~Pad0(FStr(Dia(FSys()), 0, 0), 2))

Sqladd(" Select A.NrUnicoAsiento, A.FechaGeneracion, A.Vehiculo, A.FechaValor, A.Modelo, A.Libro, A.NrOperacion, A.Estado, ")
Sqladd(" A1.Alias6, A1.DebitoCredito, A1.Cuenta, A1.Valor1, A1.Cantidad1, A1.Cantidad2, A1.Cantidad3, A1.CentroCosto, A1.Alias2,  A1.Alias3, A1.Alias5, A1.Alias7 Especie, A1.Alias8, ")
Sqladd(" A1.Alias9, A1.Alias10, A.Fecha1 FechaEjecucion, A1.Valor3, M.ClaseDocumento, M.TipoOp, A.NrAsiento ")
Sqladd(" from "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1, "~Dbo()~".MODELOSASIENTO M ")
Sqladd(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ")
Sqladd(" AND A.Modelo = M.Codigo ")
Sqladd(" AND M.Codigo IN ("~Pipe2Comillas(Var('MODCONINT'))~") ")

if (dialogo.radio1 = 0)
Sqladd(" AND (A.Estado IS Null OR A.Estado = '' OR A.Estado = ' ' OR A.Estado = 'COT' OR A.Estado = 'REV') ")
Sqladd(" AND (A.Sector Is Null OR A.Sector = '' OR A.Sector = ' ') ")
if (NoVacio(dialogo.nrunicoasiento1))
Sqladd(" AND A.NrUnicoAsiento = '"~dialogo.nrunicoasiento1~"' ")
endif
if (NoVacio(dialogo.nroperacion1))
Sqladd(" AND A.NrOperacion = '"~dialogo.nroperacion1~"' ")
endif
if (Vacio(dialogo.nrunicoasiento1) y Vacio(dialogo.nroperacion1))
if (dialogo.fecha3 > 0)
Sqladd("and A.FechaValor between '"~IdxDate(dialogo.fecha3)~"' and '"~IdxDate(dialogo.fecha4)~"'  ")
endif
if (NoVacio(Val(zz:6)))
Sqladd("and A.Vehiculo in ("~Pipe2Comillas(Val(zz:6))~") ")
endif
if (NoVacio(dialogo.tipoop1))
Sqladd("and M.TipoOp in ('"~dialogo.tipoop1~"') ")
endif
endif
else
Message('Importando asientos por excel...')


Act(vr:1, dialogo.directorio2~dialogo.string1)

let(&directorio, dialogo.directorio2)
let(&archivo, dialogo.string1)

if (existedirectorio(&directorio))
if (Eqstr(Copy(&directorio, Longitud(&directorio), 1), '\'))
if (not existearchivo(&directorio~&archivo))
Cancelar('1.El Archivo '~&archivo~' no existe en el directorio: '~&directorio)
endif
else
if (not existearchivo(&directorio~'\'~&archivo))
Cancelar('2.El Archivo '~&archivo~' no existe en el directorio: '~&directorio)
endif
endif
else
Cancelar('El directorio '~&directorio~' no existe')
endif


importarxls(a:1..a:10000, as:1..as:10000, Val(vr:1))

if (not ok)
Cancelar('No se pudo abrir el archivo '~dialogo.string1~' (Verifique que el archivo no este abierto)')
endif

Sqladd(" AND A.NrUnicoAsiento in ( ")
recorrer&i 1, 10000
if (NoVacio(Val(as:&i)) y not Eqstr(Val(as:&i), '') y not Eqstr(Val(as:&i), ' '))
if (EsNumero(Val(as:&i)))
endif
Sqladd(" '"~Val(as:&i)~"', ")
Act(at:&i, 'Asiento no encontrado!')
endif
proximo
Sqladd(" 'FIN' )")


endif

Sqladd(" AND A.FechaValor >= '"~IdxDate(Val(fi:1))~"' ")
Sqladd(" Order by 1, 2, A1.Alias3 Desc ")

Message('Buscando asientos...')
recorrer sql
Acn(er:1, 0)
Act(es:9, 'Asiento no procesado')
if (dialogo.radio1 = 1)
if (Eqstr(Fbn('Estado'), 'E'))
Act(es:9, 'Asiento ya enviado')
