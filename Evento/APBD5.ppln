Act(ba:2, dialogo.string2~"DNCDDI-"~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".dat")
Act(ba:3, Val(pt:1)~'DNCDDI-'~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".XLS")
