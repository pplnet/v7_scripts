if (NoVacio(Val(ta:3)) o Vacio(Val(ta:1)))
break
endif
endif
proximo
CerrarAscii()

Sqladd(" SELECT /*+ RULE */ Codigo, Especies, Alias3, TipoCuenta FROM "~Dbo()~".CUENTAS WHERE Codigo = '"~Val(ta:3)~"' ")
recorrer sql
Dfa()
