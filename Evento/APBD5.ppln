Act(av:&i, Query(" SELECT /*+ RULE */ Cliente FROM "~Dbo()~".CUENTAS WHERE Numero = '"~Trim(Mirt(Val(au:&i)))~"' "))
endif

Act(aq:&i, Val(x:1))
Acn(x:5, &i)
