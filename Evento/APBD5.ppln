Sqladd(" '"~Val(ab:&i)~"', '', '"~Val(au:&i)~"', ")
if (Val(ta:1) = 2 o Val(ta:1) = 1)
Sqladd(" '$', "~FStr(Val(af:&i), 1, 2)~", '"~Val(ae:&i)~"', ")
