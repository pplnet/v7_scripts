Sqladd(" AND Cuenta       = '"~Val(au:&i)~"' ")
Sqladd(" AND Vehiculo     = '"~Val(av:&i)~"' ")
Sqladd(" AND FechaIngreso = '"~IdxDate(dialogo.fecha1)~"' ")
Sqlnew()
