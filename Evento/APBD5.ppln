MostrarCuadroDeMensajes()
creardialogo
fecha1:"Fecha";1;1;;NO;;;;;;FSys()
string:"Archivo";2;1;;;;NoVacio(dialogo.string);'Archivo Invalido';NO;Var('DNCCDI');;;;;;;;;SI
