if (Val(ta:1) = 2)
Sqladd(" AND   D.Archivo     = 'DNCCDI' ")
Act(ba:1, Val(pt:1)~'DNCCDI-'~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".TXT")
Act(ba:2, dialogo.string2~"DNCCDI-"~Pad0(FStr(Dia(dialogo.fecha1), 0, 0), 2)~Pad0(FStr(Mes(dialogo.fecha1), 0, 0), 2)~FStr(Anio(dialogo.fecha1), 0, 0)~"-"~Reemplazar(Hora(Ahora()), ":", "-")~".dat")
