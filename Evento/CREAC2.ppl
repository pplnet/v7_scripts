HojaVisible(SI)
CrearDialogo
  Fecha1     : "Fecha"    ;;;;;;;;NO;FSys
FinDialogo

if Not Ok
  Cancelar
endif

MESSAGE("AGREGA CUENTAS A CLIENTES ,Un Momento por Favor !!!")

SetFilaInicial(1)


ImportarWKS(A1..ZZ3000,A1..ZZ3000,'C:\RNB\CEDEL.WKS')


SetFilaInicial(1)

Recorrer&j 1,3000
 ACT(jk1,' ') 
 ACT(cc1,' ') 
 ACT(cd1,' ') 
 ACT(co1,' ') 
 ACT(rz1,' ') 

 IF CeldaVacia(a:&j)   
    Break
 ELSE 
    IF Eqstr(Val(c:&j),'CE')
       ACT(co1,FStr(Val(a:&j),1,0))
       ACT(cc1,val(co1)~' CE')
       ACT(no1,Copy(Val(b:&j),1,38))     
       ACT(ct1,FStr(Val(i:&j),1,0)~FStr(Val(j:&j),1,0)~FStr(Val(k:&j),1,0)~FStr(Val(l:&j),1,0)~FStr(Val(m:&j),1,0))     

       SQL.ADD(" INSERT INTO "~DBO~".CUENTAS  ")
       SQL.ADD(" (Codigo,Nombre ,Numero , Especies, Mercado) ")
       SQL.ADD(" Values ")
       SQL.ADD("('"~VAL(cc1)~"','"~VAL(no1)~"','"~VAL(ct1)~"','USD|ARP|TITULO|','CE') ")
       SQL.NEW
       SQL.EXEC 

    ENDIF


    IF Eqstr(Val(c:&j),'EU')
       ACT(co1,FStr(Val(a:&j),1,0))
       ACT(cc1,val(co1)~' CE')
       ACT(no1,Copy(Val(b:&j),1,38))     
       ACT(ct1,FStr(Val(i:&j),1,0)~FStr(Val(j:&j),1,0)~FStr(Val(k:&j),1,0)~FStr(Val(l:&j),1,0)~FStr(Val(m:&j),1,0))        
         
       SQL.ADD(" INSERT INTO "~DBO~".CUENTAS  ")
       SQL.ADD(" (Codigo,Nombre ,Numero , Especies, Mercado) ")
       SQL.ADD(" Values ")
       SQL.ADD("('"~VAL(cc1)~"','"~VAL(no1)~"','"~VAL(ct1)~"','USD|TITULO|','EU') ")
       SQL.NEW
       SQL.EXEC 
    ENDIF


 ENDIF
Proximo

