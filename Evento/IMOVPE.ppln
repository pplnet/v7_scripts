creardialogo
nroperacion1:"Operacion";1;1;;NO;;;;;;;
fecha1:"FechaMov";;;;NO;;;;;;;
cliente1:'Cliente';;;;NO;;;;;;;
especie1:"Especie";;;;NO;;;;;;
vehiculo1:'Vehiculo1';;;;NO;;;;;;
entero1:"Nro.Saldo";;;;NO;;;;;;
precio1:"Cantidad";;;;NO;;;;;;
string:'Leyenda';;;;NO;;;;;;
entero2:"Nro.Mov";;;;NO;;;;;;
entero3:"Nro.Cuota";;;;NO;;;;;;
string1:'Tabla';;;;NO;;;;;;
findialogo

if (not ok)
Cancelar()
endif


if (not Incluido(dialogo.vehiculo1, Var('VLIQUIDAA')))
Message('Insertando Movimiento Pendiente '~dialogo.nroperacion1~'/'~dialogo.especie1~'...')

Sqladd("INSERT INTO "~Dbo()~".MOVPENDIENTES ")
else

Message('Insertando Movimiento Ejecutados '~dialogo.nroperacion1~'/'~dialogo.especie1~'...')
Sqladd("INSERT INTO "~Dbo()~".MOVEJECUTADOS ")
endif

Sqladd("(NrOperacion,FechaMov,Cliente,")
Sqladd(" Especie,EnteCustodia,")
Sqladd(" NrSaldo, Cantidad,")
Sqladd(" Leyenda,NrMov,")
Sqladd(" Bits, NrGrupo, NrInstan, NrGrupo2,Concepto) ")
Sqladd(" Values ")
Sqladd(" ('"~dialogo.nroperacion1~"','"~IdxDate(dialogo.fecha1)~"','"~dialogo.cliente1~"', ")
Sqladd(" '"~dialogo.especie1~"','"~dialogo.vehiculo1~"', ")
Sqladd(" "~FStr(dialogo.entero1, 0, 0)~","~FStr(dialogo.precio1, 0, 2)~", ")
Sqladd(" '"~dialogo.string~"',"~FStr(dialogo.entero2, 0, 0)~", ")
Sqladd(" 'MV',0,0,"~FStr(dialogo.entero3, 0, 0)~",'"~dialogo.string1~"') ")
Sqlnew()
Sqlexec()

