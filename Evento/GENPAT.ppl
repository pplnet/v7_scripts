        ACT(n:1, Val(z:4))
        ** Busco Instancia activa de Spot
        SQL.ADD("Select NrBit FROM "~DBO~".OPERACIONESBITS where NrOperacion = '"~Val(z:4)~"' and Valor = 1 ")
        Recorrer SQL
          DFA
          SCN(o:1, 1)
          ACN(p:1, fbn('NrBit'))
        proximo
        ACT(m:2, Val(y:3))
        ACT(n:2, Val(y:4))
        ** Busco Instancia activa de Futuro
        SQL.ADD("Select NrBit FROM "~DBO~".OPERACIONESBITS where NrOperacion = '"~Val(y:4)~"' and Valor = 1 ")
        Recorrer SQL
          DFA
          SCN(o:2, 1)
          ACN(p:2, fbn('NrBit'))
        proximo
        
        if EqStr(fbn('CB5'),'1')
** FJL 18/03/21 - Por Workflow reducido ahora no siempre esta 
*          EjecutarEvento('CBOINS', String1=Val(z:4), Radio1=0, Radio2=0, Entero1=1, Entero2=71)
*          EjecutarEvento('CBOINS', String1=Val(y:4), Radio1=0, Radio2=0, Entero1=1, Entero2=71)
          EjecutarEvento('CBOINS', String1=Val(z:4), Radio1=0, Radio2=0, Entero1=Val(p:1), Entero2=71)
          EjecutarEvento('CBOINS', String1=Val(y:4), Radio1=0, Radio2=0, Entero1=Val(p:2), Entero2=71)
          * asignar nro. de boleto automaticamente
          EjecutarEvento('ASIBOL',Radio1=1,NrOperacion1=Val(z:4))
          EjecutarEvento('ASIBOL',Radio1=1,NrOperacion1=Val(y:4))
        else
** FJL 18/03/21 - Por Workflow reducido ahora no siempre esta 
*          EjecutarEvento('CBOINS', String1=Val(z:4), Radio1=0, Radio2=0, Entero1=1, Entero2=50)
*          EjecutarEvento('CBOINS', String1=Val(y:4), Radio1=0, Radio2=0, Entero1=1, Entero2=50)
          if Val(p:1)<>50
            EjecutarEvento('CBOINS', String1=Val(z:4), Radio1=0, Radio2=0, Entero1=Val(p:1), Entero2=50)
          endif
          if Val(p:2)<>50
            EjecutarEvento('CBOINS', String1=Val(y:4), Radio1=0, Radio2=0, Entero1=Val(p:2), Entero2=50)
          endif
        endif
        *** marca el pase ***
        SQL.ADD("update "~DBO~".OPERACIONES ")
        SQL.ADD("   set NrOperacion3 = '"~Val(z:4)~"', ")
        SQL.ADD("       NrOperacion4 = '"~Val(y:4)~"', ")
        If EqStr(fbn('CB5'),'1')
          SQL.ADD("     NroAltaMAE = 'OK  OK  ', ")
          SQL.ADD("     NroBajaMAE = '' ")
        Else
          SQL.ADD("      NroAltaMAE = 'INI INI ' ")
        Endif
        SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion')~"'")
        SQL.NEW
        SQL.EXEC
        ** Muevo el pase a Auxiliar alta Pases (73)
        EjecutarEvento('CBOINS', String1=fbn('NrOperacion'), Radio1=0, Radio2=0, Entero1=72, Entero2=73)
      endif
    endif
  endif
Proximo
if FAC=0
  if Dialogo.Check1=1
    Message('GENPAT - Operacion no Encontrada')
  else
  MessageBox('GENPAT - Operacion no Encontrada')
  endif
endif

ACO(9, 20)
ACO(10, 20)
ACO(11, 20)
