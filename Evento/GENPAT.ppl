    endif
  endif
  **** Graba Spot ****
  if EqStr(fbn('TipoOp'), 'TIPA')
    ACT(z:3, 'TIC')
  else
    ACT(z:3, 'TIV')
  endif
  **** Graba Futuro ****
  if EqStr(fbn('TipoOp'), 'TIPA')
    ACT(y:3, 'TIFV')
  else
    ACT(y:3, 'TIFC')
  endif
  ACT(f:FAC, Val(z:3))
  ACT(g:FAC, Val(y:3))
