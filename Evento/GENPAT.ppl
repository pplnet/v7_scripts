SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.NrOperacion   = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("   and O.TipoOp       in ('TIPA','TIPP') ")
SQL.ADD("   and IsNull(O.NrOperacion3,'') = '' ")
SQL.ADD("   and IsNull(O.NrOperacion4,'') = '' ")

