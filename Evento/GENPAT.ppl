      ACT(i:FAC, SQLFechaStr(Fecha(Trunc(fbn('FechaEnvioMAE'),0))~' '~Hora(fbn('FechaEnvioMAE')),Exe('FORFECHOR')))
    endif
    * FechaAltaMAE
