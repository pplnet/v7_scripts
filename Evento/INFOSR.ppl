(.'CONECTASIS'.)

CrearDialogo
  NrOperacion1: '# Operacion' ;;;;;;Novacio(Dialogo.NrOperacion1);;NO;
  Check1      : 'Procesa'     ;;;;SI;SI;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, 'NrOperacion')
ACT(a:26, 'FechaEnvAlta')
ACT(a:27, 'FechaEnvBaja')
ACT(a:28, 'Mercado')
ACT(a:29, 'CodExt1')
ACT(a:30, 'errores')
ACT(a:31, 'Respuesta')
ACT(a:32, 'Nue FEASE')

ACT(d:1, 'Largo Resp')
ACT(d:2, 'Mensaje')
ACT(d:3, 'Tipo Excep')
ACT(d:4, '# Excep Tipo')
ACT(d:5, '# Excep Desc')

SQL.ADD("Select NrOperacion, NroAltaMAE, TipoOp, Especie, Mercado, ")
SQL.ADD("       Cliente1, Cantidad, Precio1, ContraEspecie, ")
SQL.ADD("       PorDerechoMercado, Book1, FechaOp, FechaVto, ")
SQL.ADD("       FechaCargaSys, Plazo, Operador, RB6, ")
SQL.ADD("       CB5, CodSisExterno, NrExterno, FechaEnvAltaSisExterno, ")
SQL.ADD("       FechaEnvBajaSisExterno, TotalAux8, TotalAux5  ")
SQL.ADD("  from "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion= '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACN(z:1, 0)
  ACT(b:1, fbn('NrOperacion'))
  ACT(b:2, fbn('NroAltaMAE'))
  ACN(b:3, fbn('RB6'))
  ACN(b:4, fbn('CB5'))
  ACT(b:5, fbn('CodSisexterno'))
  ACT(b:6, fbn('NrExterno'))

  ACT(b:7, fbn('TipoOp'))
  if EqStr(fbn('TipoOp'),'TIC')
    ACT(b:8, 'Buy')
  endif
  if EqStr(fbn('TipoOp'),'TIV')
    ACT(b:8, 'Sell')
  endif
  if Vacio(b:8)
    SCN(z:1, 1)
    ACT(c:8, 'Tipo operacion invalido')
    ACT(aa:Val(z:1), 'Tipo operacion invalido')
  endif
  
  ACT(b:9, fbn('Especie'))
  ACT(b:10, BuscarCampo('ESPECIES','ISIN','Codigo',fbn('Especie')))
  if NoVacio(Val(b:10))
    ACT(b:11, 'ISIN')
  else
    ACT(b:10, BuscarCampo('ESPECIES','Codigo2','Codigo',fbn('Especie')))
    if NoVacio(Val(b:10))
      ACT(b:11, 'BBGID')
    endif
  endif
  if Vacio(b:11)
    SCN(z:1, 1)
    ACT(c:11, 'Especie sin codigo para informar a Raiden')
    ACT(aa:Val(z:1), 'Especie sin codigo para informar a Raiden')
  endif

  ACT(b:12, fbn('Cliente1'))
  SQL.ADD("Select NrCOPERS  ")
  SQL.ADD("  from "~DBO~".CLIENTESDOCUMENTACION ")
  SQL.ADD(" Where Codigo    = '"~fbn('Cliente1')~"' ")
  SQL.ADD("   and Documento = 'COPERS' ")
  Recorrer SQL
    dfa
    ACT(b:13, fbn('NrCopers'))
  proximo
  if Vacio(Val(b:13))
    SCN(z:1, 1)
    ACT(c:13, 'Cliente sin Coper')
    ACT(aa:Val(z:1), 'Cliente sin Coper')
  endif

  ACN(b:14, fbn('Cantidad'))
  ACN(b:15, fbn('Precio1'))

  ACT(b:16, fbn('ContraEspecie'))
  ACT(b:17, BuscarCampo('ESPECIES','ISO','Codigo',fbn('ContraEspecie')))
  if Vacio(Val(b:17))
    ACT(b:17, Val(b:16))
  endif

* FJL 19/12/19 - Se cambia para operaciones con moneda cruzada
*  ACN(b:18, fbn('PorDerechoMercado'))
* FJL 26/12/19 - Se cambia nuevo criterio operaciones con moneda cruzada
*  ACN(b:18, fbn('TotalAux8'))
  ACN(b:18, fbn('TotalAux5'))
  ACT(b:19, fbn('Book1'))

  ACD(b:20, fbn('FechaOp'))
  ACD(b:21, fbn('FechaVto'))
  ACD(b:22, fbn('FechaCargaSys'))

  ACN(b:23, fbn('Plazo'))
  ACN(b:24, fbn('Plazo')/24)
  ACT(b:25, fbn('Operador'))

  ACD(b:26, fbn('FechaEnvAltaSisExterno'))
  if Val(b:26)>0
    SCN(z:1, 1)
    ACT(c:26, 'Operacion ya Informada')
    ACT(aa:Val(z:1), 'Operacion ya Informada')
  endif
  ACD(b:27, fbn('FechaEnvBajaSisExterno'))
  ACT(b:28, fbn('Mercado'))
  ACT(b:29, BuscarCampo('MERCADOS','CodigoExterno1','Codigo',fbn('Mercado')))
  if Vacio(Val(b:29))
    ACT(b:29, fbn('Mercado'))
  endif
  
  ACN(b:30, Val(z:1))
  if Val(z:1)=0
* FJL 25/11/19 - Se invierte FechaOp y fecha Carga - mail de PDomoni
*    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('PorDerechoMercado'),fbn('Book1'),fbn('FechaOp'),fbn('FechaVto'),fbn('FechaCarga'),Val(b:24),fbn('Operador')))
* FJL 19/12/19 - Se cambia TC para operaciones con moneda cruzada
*    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('PorDerechoMercado'),fbn('Book1'),fbn('FechaCargaSys'),fbn('FechaVto'),fbn('FechaOp'),Val(b:24),fbn('Operador')))
* FJL 26/12/19 - Se cambia nuevo criterio operaciones con moneda cruzada
*    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('TotalAux8'),fbn('Book1'),fbn('FechaCargaSys'),fbn('FechaVto'),fbn('FechaOp'),Val(b:24),fbn('Operador')))
* PZ 10/09/2020 se incorpora el Mercado como parámetro
*    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('TotalAux5'),fbn('Book1'),fbn('FechaCargaSys'),fbn('FechaVto'),fbn('FechaOp'),Val(b:24),fbn('Operador')))
* FJL 21/07/25 - Issue EXTBOFA-8417 - Se informa CodigoExterno1 del mercado
*    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('TotalAux5'),fbn('Book1'),fbn('FechaCargaSys'),fbn('FechaVto'),fbn('FechaOp'),Val(b:24),fbn('Operador'),fbn('Mercado')))
    ACT(b:31, DealCreateSiopelCont(fbn('NrOperacion'), fbn('NroAltaMAE'), Val(b:8), Val(b:10),Val(b:11),fbn('Cliente1'),Val(b:13),fbn('Cantidad'),fbn('Precio1'),Val(b:17),fbn('TotalAux5'),fbn('Book1'),fbn('FechaCargaSys'),fbn('FechaVto'),fbn('FechaOp'),Val(b:24),fbn('Operador'),Val(b:29)))
    if EqStr(Copy(Val(b:31),1,2),'OK')
      ACT(b:32, SQLAhora)
      if Dialogo.Check1=1
        * marco la Op como enviada
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set FechaEnvAltaSisExterno  = "~Val(b:32)~" ")
        SQL.ADD(" where NrOperacion   = '"~Val(b:1)~"' ")
        SQL.NEW
        SQL.EXEC
      
* FJL 18/12/19 - Lo deja en la 68 a esperar la respuesta. Esto se controla en el INFSIS
*        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
      endif
    else
      ACN(e:1, Longitud(Val(b:31)))
      ACT(e:2, Copy(Val(b:31),9,Val(e:1)-8))
      ACT(e:3, 'INFSEXTNOK')
      ACN(e:4, Query("Select Count(*) from "~DBO~".EXCEPCIONES where NrOperacion='"~Val(b:1)~"' and Tipo='"~Val(e:3)~"' "))
      ACN(e:5, Query("Select Count(*) from "~DBO~".EXCEPCIONES where NrOperacion='"~Val(b:1)~"' and Tipo='"~Val(e:3)~"' and Descripcion='"~Val(e:2)~"' "))
      if Dialogo.Check1=1
        if Val(e:5)=0
          SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
          SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD(" '"~Val(b:1)~"', ")
          SQL.ADD(" "~SQLAhora~", ")
          SQL.ADD(" '"~Val(e:3)~"', ")
          SQL.ADD(" '"~Copy(Val(e:2),1,100)~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          SQL.EXEC
        endif
* FJL 18/12/19 - Se deja en 68 e intenta nuevamente. PZIMEL
*        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=9)
      endif
    endif
  else
    * Le genero excepciones y la paso la operacion a Compliance SE
    recorrer&i 1,Val(z:1)
      if Dialogo.Check1=1
        SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
        SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~Val(b:1)~"', ")
        SQL.ADD(" "~SQLAhora~", ")
        SQL.ADD(" 'ERRINFSEXT', ")
        SQL.ADD(" '"~Copy(Val(aa:&i),1,100)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC
      endif
    proximo
    if Dialogo.Check1=1
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=9)
    endif
  endif

Proximo
