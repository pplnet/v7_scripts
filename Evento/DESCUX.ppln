Sqladd(" Set CB5 = 1 ")
Sqladd(" Where TipoOp = 'MMDC' ")
Sqladd(" AND FechaOp < '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND FechaOp >= '"~IdxDate(PriDeMes(dialogo.fecha1))~"' ")
Sqladd(" AND FechaCargaSys = '"~IdxDate(FSys())~"' ")
Sqladd(" AND Cuenta1 = '"~Fbn('Cuenta1')~"' ")
Sqladd(" AND Especie = '"~Fbn('Especie')~"' ")
