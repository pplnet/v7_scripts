creardialogo
fecha1:'Fecha';;;;;;;;;;
cuenta1:'Cuenta';;;;;;;;;;;
findialogo

if (not ok)
Cancelar()
endif

Act(us:99, UsuarioActivo())
Acn(pl:1, Habiles(dialogo.fecha1, 1, 'ARG') - dialogo.fecha1)
Acd(fv:1, dialogo.fecha1 + Val(pl:1))

Sqladd(" Select O.FechaOp, O.Cantidad, O.Cuenta1, O.Especie, O.Vehiculo1, O.NrOperacion, O.Observac3 ")
Sqladd(" from "~Dbo()~".OPSEVENTUALES O ")
Sqladd(" where O.TipoOp = 'MMEVDE' ")
Sqladd(" and O.FechaOp  = (Select Max(EV.FechaOp) From "~Dbo()~".OPSEVENTUALES EV ")
Sqladd("                  Where EV.TipoOp = O.TipoOp ")
Sqladd("                  AND EV.FechaOp <= '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd("                  AND O.Cuenta1 = EV.Cuenta1 ")
Sqladd("                  AND O.Especie = EV.Especie) ")
if (NoVacio(dialogo.cuenta1))
Sqladd(" AND O.Cuenta1 = '"~dialogo.cuenta1~"' ")
endif
if (EsHabil(dialogo.fecha1, Var('FERIADODEF')))
endif
Sqladd(" Order By 1 ")
recorrer sql
if (Fbn('Cantidad') < 0)
Acd(a:fac, dialogo.fecha1)
Acd(fe:1, Fbn('FechaOp'))
Acn(b:fac, Abs(Fbn('Cantidad')))
Act(c:fac, Fbn('Cuenta1'))
Act(d:fac, Fbn('Especie'))
Act(e:fac, Fbn('Vehiculo1'))
Act(f:fac, Fbn('NrOperacion'))
Act(ob:1, Fbn('Observac3'))
Acn(jj:99, 0)
Acn(ca:99, Val(b:fac))
Acn(oo:99, 0)
Act(op:99, Val(f:fac))
Sqladd(" Select FechaOp, Cantidad, Cuenta1, FechaVto, Especie, Precio1, Vehiculo1, RB8, RB10, ")
Sqladd(" Spread, NrOperacion, TipoTasa, Book1, Observac2, PrecioRef, TablaFeriados1, Cuenta4 ")
Sqladd(" from "~Dbo()~".OPERACIONES ")
Sqladd(" where TipoOp = 'MMDPAC' and (Cuenta1 = '"~Val(c:fac)~"' OR Cuenta4 = '"~Val(c:fac)~"') ")
Sqladd(" and Especie = '"~Val(d:fac)~"' and FechaVto > '"~IdxDate(Val(a:fac))~"' ")
Sqladd(" AND FechaOp <= '"~IdxDate(Val(a:fac))~"' ")
Sqladd(" Order by RB10 desc, FechaOp, FechaCarga")
Watch(Sqlbatch())
recorrer sql
Acd(zz:fac, Fbn('FechaOp'))
Acn(aa:fac, Fbn('Cantidad'))
if (Eqstr(Fbn('Cuenta1'), dialogo.cuenta1))
Act(bb:fac, Fbn('Cuenta1'))
else
Act(bb:fac, Fbn('Cuenta4'))
endif
Acd(cc:fac, Fbn('FechaVto'))
Act(dd:fac, Fbn('Especie'))
Acn(ee:fac, Fbn('Precio1'))
Act(ff:fac, Fbn('Vehiculo1'))
Acn(gg:fac, Fbn('RB8'))
Acn(hh:fac, Fbn('Spread'))
Acn(tt:1, Val(aa:fac))
Acn(nu:1, BuscarCampo('VEHICULOS', 'Alias1', 'Codigo', Fbn('Vehiculo1')))
Act(co:99, BuscarCampo('Cuentas', 'Comitente', 'Codigo', Val(bb:fac)))
if (Val(a:fac) < Val(cc:fac))
Acn(xy:98, Val(aa:fac) - Val(ca:99))
Acn(xy:99, Val(xy:98))
if (Val(xy:98) < 0)
Acn(ca:99, Val(xy:98) * (-1))
endif
if (Fbn('RB10') = 0)
if (Val(xy:99) >= 0)
if (Val(gg:fac) = 1)
Acn(rb:99, 36500)
else
Acn(rb:99, 36000)
endif
Acn( in :99, (Val(ca:99) * (Val(ee:fac) + Val(hh:fac)) * 1) / Val(rb:99))
Act(nr:1, getnumerador(Val(nu:1)))
Message('Generando MMDC... '~Val(nr:1))
Sqladd(" INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd(" (FechaOp2, FechaCargaSys, FechaCarga, ")
Sqladd(" FechaOp, NrOperacion, TipoOp, ")
Sqladd(" Especie, Cantidad, Cuenta1, ")
Sqladd(" Vehiculo1, Precio1, ")
Sqladd(" TablaFeriados1, Numerador, Operador, ")
Sqladd(" Cliente1, RB8, Spread, ")
Sqladd(" Plazo, TotalIntereses, TipoTasa, ")
Sqladd(" FechaVto, FechaVto2, Book1, ")
Sqladd(" Observac2, PrecioRef, Observac3, ")
Sqladd(" OperacionRef, CB5) ")
Sqladd(" VALUES ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"','"~IdxDate(FSys())~"', "~SQLAhora()~", ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~Val(nr:1)~"','MMDC', ")
Sqladd(" '"~Val(dd:fac)~"','"~Val(ca:99)~"','"~Val(bb:fac)~"', ")
Sqladd(" '"~Val(ff:fac)~"', '"~Val(ee:fac)~"', ")
Sqladd(" '"~Fbn('TablaFeriados1')~"', "~FStr(Val(nu:1), 0, 0)~", '"~UsuarioActivo()~"', ")
Sqladd(" '"~Val(co:99)~"', "~FStr(Val(gg:fac), 0, 0)~", '"~Val(hh:fac)~"', ")
Sqladd(" 1, "~FStr(Val( in :99), 0, 2)~", '"~Fbn('TipoTasa')~"', ")
Sqladd(" '"~IdxDate(dialogo.fecha1 + 1)~"', '"~IdxDate(dialogo.fecha1 + 1)~"', '"~Fbn('Book1')~"', ")
Sqladd(" '"~Fbn('Observac2')~"', '"~Fbn('PrecioRef')~"', '"~Val(ob:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', 0) ")
Sqlnew()
Sqlexec()
Acn(oo:99, 1)
Act(z:3, Val(nr:1))
Message('Ingresando Instancias Operacion '~Val(z3)~' ...')

Acn(i1, 50)

Sqladd("SELECT * FROM "~Dbo()~".INSTANCIAS ")
Sqladd(" Where Tabla = 'OPERACIONES' ")
Sqladd(" ORDER BY NrInstancia ")
recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ( ")
Sqladd(" NrOperacion, NrBit, Valor ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(z3)~"', ")
Sqladd(" "~FStr(Fbn()['NrInstancia'], 2, 0)~", ")
Sqladd(" '"~iif (Val(i1) = Fbn()['NrInstancia'], '1', '0')~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
proximo


SqlActualizarmovimientos3(Val(nr:1), NO, NO, NO, NO, SI)
Sqlexec()
break
else
if (Val(oo:99) = 0)
if (Val(gg:fac) = 1)
Acn(rb:99, 36500)
else
Acn(rb:99, 36000)
endif
Acn( in :99, (Val(aa:fac) * (Val(ee:fac) + Val(hh:fac)) * 1) / Val(rb:99))
Acn(xy:100, Val(xy:99) * (-1))
Act(nr:1, getnumerador(Val(nu:1)))
Message('Generando MMDC... '~Val(nr:1))
Sqladd(" INSERT INTO "~Dbo()~".OPERACIONES ")
Sqladd(" (FechaOp2, FechaCargaSys, FechaCarga, ")
Sqladd(" FechaOp, NrOperacion, TipoOp, ")
Sqladd(" Especie, Cantidad, Cuenta1, ")
Sqladd(" Vehiculo1, Precio1, ")
Sqladd(" TablaFeriados1, Numerador, Operador, ")
Sqladd(" Cliente1, RB8, Spread, ")
Sqladd(" Plazo, TotalIntereses, TipoTasa, ")
Sqladd(" FechaVto, FechaVto2, Book1, ")
Sqladd(" Observac2, PrecioRef, Observac3, ")
Sqladd(" OperacionRef, CB5) ")
Sqladd(" VALUES ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"', '"~IdxDate(FSys())~"', "~SQLAhora()~", ")
Sqladd(" '"~IdxDate(dialogo.fecha1)~"', '"~Val(nr:1)~"','MMDC', ")
Sqladd(" '"~Val(dd:fac)~"', '"~Val(aa:fac)~"', '"~Val(bb:fac)~"', ")
Sqladd(" '"~Val(ff:fac)~"', '"~Val(ee:fac)~"', ")
Sqladd(" '"~Fbn('TablaFeriados1')~"', "~FStr(Val(nu:1), 0, 0)~", '"~UsuarioActivo()~"', ")
Sqladd(" '"~Val(co:99)~"', "~FStr(Val(gg:fac), 0, 0)~", '"~Val(hh:fac)~"', ")
Sqladd(" 1, "~FStr(Val( in :99), 0, 2)~", '"~Fbn('TipoTasa')~"', ")
Sqladd(" '"~IdxDate(dialogo.fecha1 + 1)~"', '"~IdxDate(dialogo.fecha1 + 1)~"', '"~Fbn('Book1')~"', ")
Sqladd(" '"~Fbn('Observac2')~"', '"~Fbn('PrecioRef')~"', '"~Val(ob:1)~"', ")
Sqladd(" '"~Fbn('NrOperacion')~"', 0) ")
Sqlnew()
Sqlexec()
Acn(zz:99, Val(xy:99) * (-1))
Act(z:3, Val(nr:1))
Message('Ingresando Instancias Operacion '~Val(z3)~' ...')

Acn(i1, 50)

Sqladd("SELECT * FROM "~Dbo()~".INSTANCIAS ")
Sqladd(" Where Tabla = 'OPERACIONES' ")
Sqladd(" ORDER BY NrInstancia ")
recorrer sql
Dfa()
Sqladd("INSERT INTO "~Dbo()~".OPERACIONESBITS ( ")
Sqladd(" NrOperacion, NrBit, Valor ")
Sqladd(" ) Values ( ")
Sqladd(" '"~Val(z3)~"', ")
Sqladd(" "~FStr(Fbn()['NrInstancia'], 2, 0)~", ")
Sqladd(" '"~iif (Val(i1) = Fbn()['NrInstancia'], '1', '0')~"' ")
Sqladd(" ) ")
Sqlnew()
Sqlexec()
proximo


SqlActualizarmovimientos3(Val(nr:1), NO, NO, NO, NO, SI)
Sqlexec()
endif
endif
else
if (Val(xy:99) >= 0)
Acn(cn:1, Val(ca:99))
else
Acn(cn:1, Val(aa:fac))
endif
Sqladd(" Update "~Dbo()~".OPERACIONES ")
Sqladd(" Set TotalAux1 = "~FStr(Val(cn:1), 0, 2)~" ")
Sqladd(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
