sql.actualizarmovimientos3(Val(nr:1), NO, NO, NO, NO, SI)
sql.exec
endif
endif
else
if (Val(xy:99) >= 0)
Acn(cn:1, Val(ca:99))
else
Acn(cn:1, Val(aa:fac))
endif
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set TotalAux1 = "~FStr(Val(cn:1), 0, 2)~" ")
sql.add(" Where NrOperacion = '"~Fbn('NrOperacion')~"' ")
