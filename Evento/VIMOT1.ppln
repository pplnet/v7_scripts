creardialogo
fecha1:"Fecha";;;;;;dialogo.fecha1 <= FSys();'Debe Ingresar la Fecha';NO;FSys()
vehiculo1:'Vehiculo1';;;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'El Vehiculo Colocador es Invalido';NO;
vehiculo2:'Vehiculo2';;;;;;NoVacio(dialogo.vehiculo2) y (Incluido(dialogo.vehiculo2, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'El Vehiculo Tomador es Invalido';NO;;;;
especie1:'Moneda';;;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'MONEDA');'Debe Ingresar una Especie Valida';NO;
precio1:'Tasa';;;;;;dialogo.precio1 <> 0;'Debe Existir la Tasa para esta Seleccion';NO;;Query("SELECT Tasa from "~Dbo()~".TASASVEHICULO where ((Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"') or (Vehiculo1='"~dialogo.vehiculo2~"' and Vehiculo2='"~dialogo.vehiculo1~"')) and Especie ='"~dialogo.especie1~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' ")
radio1:'U.T.|360|365';;;;;;dialogo.radio1 >= 0;'Unidad de Tiempo Invalida';NO;;iif (Eqstr(Query("SELECT Divisor from "~Dbo()~".PARESVEHICULO where Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"' "), '360'), 0, 1)
findialogo

if (not ok)
Cancelar()
endif

Sqladd("SELECT * from "~Dbo()~".OPERACIONES O")
Sqladd("where O.TipoOp='VIMIND' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"' ")
Sqladd(" and Especie='"~dialogo.especie1~"' and (NrOperacion2 is null or NrOperacion2='') ")
Sqladd("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

Acn(x1, 0)

recorrer sql
Scn(x1, 1)
proximo

if (Val(x1) > 0)
Message('Modificando la Tasa ... ')
Sqladd("UPDATE "~Dbo()~".TASASVEHICULO Set Tasa="~FStr(dialogo.precio1, 0, 5)~" Where ")
Sqladd(" ((Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"') or ")
Sqladd(" (Vehiculo1='"~dialogo.vehiculo2~"' and Vehiculo2='"~dialogo.vehiculo1~"')) ")
Sqladd(" and Fecha='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and Especie='"~dialogo.especie1~"' ")
Sqlnew()

Message('Modificando la Unidad de Tiempo en Pares de Vehiculos ... ')
Sqladd("UPDATE "~Dbo()~".PARESVEHICULO Set Divisor='"~iif (dialogo.radio1 = 0, '360', '365')~"' Where ")
Sqladd(" Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"' ")
Sqlnew()

Sqladd("UPDATE "~Dbo()~".PARESVEHICULO Set Divisor='"~iif (dialogo.radio1 = 0, '360', '365')~"' Where ")
Sqladd(" Vehiculo1='"~dialogo.vehiculo2~"' and Vehiculo2='"~dialogo.vehiculo1~"' ")
Sqlnew()
Sqlexec()
else
Messagebox('Se han generado Las Minutas Mensuales, No se puede modificar la Tasa !!!')
endif

Sqladd("SELECT * from "~Dbo()~".OPERACIONES O")
Sqladd("where O.TipoOp='VIMIND' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"' ")
Sqladd(" and Especie='"~dialogo.especie1~"' ")
Sqladd("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")

Acn(x1, 0)

recorrer sql

if (Vacio(Fbn()['NrOperacion2']) o Eqstr(Fbn()['NrOperacion2'], ' '))
Scn(x1, 1)

Message('Obteniendo los Nros. de Operaciones a Generar .... ')

Acn(ab6, Fbn()['RB6'])

Acn(z6, dialogo.precio1 * Fbn()['Cantidad'] * Fbn()['Plazo'] / (100 * iif (dialogo.radio1 = 0, 360, 365)))

Message('Calculando los Impuestos para Operacion Directa ')

Act(av1, dialogo.vehiculo1)
Act(av2, dialogo.vehiculo2)
Act(z7, Fbn()['MB3'])


Act(y13, " Ganancias1a2 G,WHT1a2 W ")

if (Eqstr(Val(z7), '1'))
Act(y13, " Ganancias2a1 G,WHT2a1 W ")
endif


Sqladd("SELECT "~Val(y13)~",Divisor FROM "~Dbo()~".PARESVEHICULO WHERE Vehiculo1='"~Val(av1)~"' AND Vehiculo2='"~Val(av2)~"' ")

recorrer sql
Dfa()
Acn(y15, Fbn()['W'] / 100)
Acn(y17, Fbn()['W'])
Acn(y18, iif (Eqstr('360', Fbn()['Divisor']), 360, 365))

Acn(y30, Fbn()['G'])
proximo


Acn(y19, iif (dialogo.precio1 = 0, Val(z12), dialogo.precio1) / Val(y18) * 365)

if (Val(ab6) >= 2)
Acn(y19, iif (dialogo.precio1 = 0, Val(z12), dialogo.precio1) * (1 + Val(y15)) / Val(y18) * 365)
endif

Acn(y20, Val(z11))

Acn(y4, 0)
Acn(y5, 0)
Acn(y6, 0)
Acn(y12, 0)
Acn(y13, 0)
Acn(y16, 0)


if (Val(ab6) = 0)



Act(a1, BuscarCampo('CLIENTES', 'Res3337', 'Codigo', BuscarCampo('VEHICULOS', 'Cliente', 'Codigo', Val(av1))))
Act(a2, BuscarCampo('CLIENTES', 'Res3337', 'Codigo', BuscarCampo('VEHICULOS', 'Cliente', 'Codigo', Val(av2))))


if (Eqstr(Val(z7), '1'))
Act(a3, Val(a1))
Act(a1, Val(a2))
Act(a2, Val(a3))
endif


Acn(y4, Val(z11) * Val(y17) / 100)
Acn(y5, 0)


Acn(y6, Val(y17))
Acn(y12, 0)
Acn(y13, 0)

if (Eqstr(Val(a1), 'SI') y Eqstr(Val(a2), 'NO'))
if (Val(z11) >= Var('RG3337MINI'))
Acn(y12, Var('RG3337'))
Acn(y13, Val(z11) * Var('RG3337') / 100)
endif
endif


if (Eqstr(Val(a1), 'NO') y Eqstr(Val(a2), 'SI'))
if (Val(y4) >= Var('IVAMINIMO'))
Acn(y5, Val(y4) * Var('IVARETEN') / 100)
endif
endif


Acn(y16, Val(y4) - Val(y5) + Val(y13))
Acn(y20, Val(z11) + Val(y16))
endif

Acn(w1, 0)
Acn(w2, 0)

if (Val(ab6) = 2)
Acn(w1, Val(y17))


if (Eqstr(Val(z7), '1'))
Acn(w2, Val(z11) * Val(w1) / 100)
endif
endif


Acn(i1, 0)
Acn(i2, 0)

if (Val(ab6) >= 3)

Acn(i1, Val(y17))


if (Val(ab6) = 3 o Eqstr(Val(z7), '1'))


Acn(i2, Val(z11) * Val(i1) / 100)

endif
endif

if (Val(ab6) = 2 y Eqstr(Val(z7), '1'))
Acn(y31, 0)

if (Eqstr(Val(z7), '1'))
Acn(y31, Val(z11) * Val(y30) / 100)
endif
Acn(y6, Val(y30))
Acn(y4, Val(y31))
Acn(y16, Val(y31))
endif




Message('Modificando la Minuta de Diaria .... '~Fbn()['NrOperacion'])
Sqladd(" UPDATE "~Dbo()~".OPERACIONES Set ")
Sqladd(" Precio1="~FStr(dialogo.precio1, 0, 5)~", ")
Sqladd(" TotalIntereses="~FStr(Val(z6), 10, 5)~", ")
Sqladd(" Precio4="~FStr(Val(y19), 0, 5)~", ")
Sqladd(" TotalAux1="~FStr(Val(w1), 0, 5)~", ")
Sqladd(" RB8='"~FStr(dialogo.radio1, 0, 0)~"', ")
Sqladd(" TasaPrecan="~FStr(Val(i1), 0, 2)~" ")
Sqladd(" Where NrOperacion='"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()

Act(i3, Fbn()['NrOperacion'])

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
Sqladd("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
Sqlnew()

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', Val(az5), 'nroperacion1', Val(az3))
endif

Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
Sqlnew()
Sqlexec()




Message('Calculando los Impuestos para la Inversa ')

Act(av1, dialogo.vehiculo2)
