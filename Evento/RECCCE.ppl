CrearDialogo
  Fecha1:   'Fec.Desde' ;1;1;;  ;;;;;FSys
  Fecha2:   'Fec.Hasta' ; ; ;;  ;;;;;FSys
  Especie1: 'Especie'   ; ; ;;  ;;;;;
  Check2:   'Ej.RECPCU' ; ; ;;SI;;;;;1
  Check1:   'Procesa'   ; ; ;;SI;;;;;1
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0 o Dialogo.Check2=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)

ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'TipoTr2')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Especie1')
ACT(e:FAC, 'Especie2')
ACT(f:FAC, 'Fecha1')
ACT(g:FAC, 'Saldo 2')
ACT(h:FAC, 'Vehiculo')
ACT(i:FAC, 'Book')
ACT(j:FAC, 'Cant4 (Saldo)')
ACT(k:FAC, 'Cliente1')
ACT(l:FAC, 'Accion')

SetFont(a:FAC..l:FAC,2)

SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 ")
SQL.ADD("  where Fecha1 >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("    and Fecha1 < "~IdxDate2(Dialogo.Fecha2+1)~" ")
SQL.ADD("    and TipoTr2  in ('CUPON') ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("    and Especie = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD(" Order By Fecha1,Especie,NrTrans")
Recorrer SQL
  ACT(a:FAC, fbn('NrTrans'))
  ACT(b:FAC, fbn('TipoTr2'))
  ACT(c:FAC, fbn('Especie'))
  ACT(d:FAC, fbn('Especie1'))
  ACT(e:FAC, fbn('Especie2'))
  ACD(f:FAC, fbn('Fecha1'))

  if fbn('Cantidad4')=2
    ACT(g:FAC, 'Saldo = 2')
    ACT(h:FAC, fbn('Vehiculo1'))
    ACT(i:FAC, fbn('Ley1'))
    ACN(j:FAC, fbn('Cantidad4'))
    ACT(k:FAC, fbn('Cliente1'))

    if Dialogo.Check2=1
      if Dialogo.Check1=1
        ACT(l:FAC, 'Ejecuta RECPCU y procesa')
      else
        ACT(l:FAC, 'Ejecuta RECPCU sin procesar')
      endif
      EjecutarEvento('RECPCU',NrTrans1=fbn('NrTrans'),Check1=Dialogo.Check1)
    else
      ACT(l:FAC, 'No Ejecuta')
    endif
  else
    Message('NO corta Posiciones Nuevas')
  endif
proximo

if FAC>1
  SetFont(a:2..l:FAC,1)
endif
