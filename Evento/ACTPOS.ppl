****************************************************
* Recalcula posiciones regenerando desde una fecha *
****************************************************
CrearDialogo
   Fecha1     : 'F. Desde'  ;1;1; ;  ;  ;Dialogo.Fecha1<=FSys;'La fecha desde no puede ser mayor a FSYS';NO;Fecha('2024-05-01')
   Fecha2     : 'F. Hasta'  ;1;2; ;NO;NO;;;;FSys
   Cliente1   : 'Cliente'   ;2;1; ;  ;  ;;;;VAR('VEHICULODE')
   Vehiculo1  : 'Vehiculo'  ;3; ; ;  ;  ;;;;VAR('VEHICULODE')
   Especie1   : 'Especie'   ;4; ; ;  ;  ;;;;
   Check1     : 'Procesa'   ;5;1; ;SI;SI;;;;0
FinDialogo
If not Ok
  Cancelar
Endif

* Es para pruebas
ACN(x:1, 0)

if Dialogo.Check1=0 o Val(x:1)=1
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'Jerarquia')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Linea')

ACT(f:FAC, 'Fecha')
ACT(g:FAC, 'EsHabil')

ACT(i:FAC, 'Psiciones')
ACT(j:FAC, 'Resultados')
if Dialogo.Check1=0 o Val(x:1)=1
  ACT(l:FAC, 'Psiciones')
  ACT(m:FAC, 'Resultados')
  ACT(o:FAC, 'Psiciones')
  ACT(p:FAC, 'Resultados')
  ACT(r:FAC, 'Psiciones')
  ACT(s:FAC, 'Resultados')
  ACT(u:FAC, 'Psiciones')
  ACT(v:FAC, 'Resultados')
endif

SQL.ADD("SELECT Codigo,Jerarquia FROM "~DBO~".ESPECIES ")
SQL.ADD(" where Codigo in ( ")
SQL.ADD("       SELECT Distinct P.Especie FROM "~DBO~".POSICIONES P ")
SQL.ADD("        where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
IF NoVacio(Dialogo.Especie1)
  SQL.ADD("        AND P.Especie = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("          AND P.NrSaldo > 100 ")
SQL.ADD("          AND P.CantidadFin <> 0 ")
SQL.ADD("          AND P.Fecha IN ( ")
SQL.ADD("              SELECT MAX(Fecha) from "~DBO~".POSICIONES ")
SQL.ADD("               WHERE  Especie  = P.Especie  ")
SQL.ADD("                 AND  Vehiculo = P.Vehiculo ")
SQL.ADD("                 AND  NrSaldo  = P.NrSaldo  ")
SQL.ADD("                 AND  Cliente  = P.Cliente  ")
SQL.ADD("                 AND  Book     = P.Book     ")
SQL.ADD("                 and  IsNull(Unidad,'')       = IsNull(P.Unidad,'') ")
SQL.ADD("                 and  IsNull(Centro,'')       = IsNull(P.Centro,'') ")
SQL.ADD("                 and  IsNull(Sector,'')       = IsNull(P.Sector,'') ")
SQL.ADD("                 and  IsNull(Sucursal,'')     = IsNull(P.Sucursal,'') ")
SQL.ADD("                 and  IsNull(PrecioEj,0)      = IsNull(P.PrecioEj,0) ")
SQL.ADD("                 and  IsNull(FechaEj,0)       = IsNull(P.FechaEj,0) ")
SQL.ADD("                 and  IsNull(CallPut,'')      = IsNull(P.CallPut,'') ")
SQL.ADD("                 and  IsNull(Estrategia,'')   = IsNull(P.Estrategia,'') ")
SQL.ADD("                 and  IsNull(Cartera,'')      = IsNull(P.Cartera,'') ")
SQL.ADD("                 and  IsNull(Trader,'')       = IsNull(P.Trader,'') ")
SQL.ADD("                 and  IsNull(TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
SQL.ADD("                 and  IsNull(Cupon,'')        = IsNull(P.Cupon,'') ")
SQL.ADD("                 and  IsNull(Responsable,'')  = IsNull(P.Responsable,'') ")
SQL.ADD("                 and  IsNull(TipoPosicion,'') = IsNull(P.TipoPosicion,'') ")
SQL.ADD("                 and  IsNull(Producto,'')     = IsNull(P.Producto,'') ")
SQL.ADD("                 and  IsNull(GrupoEspecie,'') = IsNull(P.GrupoEspecie,'') ")
SQL.ADD("                 and  IsNull(CarteraBCRA,'')  = IsNull(P.CarteraBCRA,'') ")
SQL.ADD("                 AND  Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                         ) ")
SQL.ADD("                 ) ")
SQL.ADD(" Order by Jerarquia  ")
  
watch(SQL.batch())

Recorrer SQL
  Message('Especie: '~fbn('Codigo'))
  ACT(a:FAC, fbn('Jerarquia'))
  ACT(b:FAC, fbn('Codigo'))
  ACN(c:FAC, FAC-1)
  if Dialogo.Check1=0 o Val(x:1)=1
    ACN(i:FAC, Query("Select Count(*) from "~DBO~".POSICIONES where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    ACN(j:FAC, Query("Select Count(*) from "~DBO~".RESULTADOS where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
  endif
  if Dialogo.Check1=1
    SQL.ADD("Delete "~DBO~".RESULTADOS ")
    SQL.ADD("where Especie = '"~fbn('Codigo')~"' ")
    SQL.ADD("  and Fecha   >= "~idxdate2(Dialogo.Fecha1)~" ")
    SQL.ADD("  and NrSaldo >  100 ")
    SQL.NEW

    if Dialogo.Check1=0 o Val(x:1)=1
      SQL.EXEC
      ACN(l:FAC, Query("Select Count(*) from "~DBO~".POSICIONES where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    endif

    SQL.ADD("Delete "~DBO~".POSICIONES ")
    SQL.ADD("where Especie = '"~fbn('Codigo')~"' ")
    SQL.ADD("  and Fecha   >= "~idxdate2(Dialogo.Fecha1)~" ")
    SQL.ADD("  and NrSaldo >  100 ")
    SQL.NEW
    SQL.EXEC

    if Dialogo.Check1=0 o Val(x:1)=1
      ACN(m:FAC, Query("Select Count(*) from "~DBO~".RESULTADOS where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    endif
    SQL.ADD("Delete "~DBO~".RESULTADOS ")
    SQL.ADD("where Especie = '"~fbn('Codigo')~"' ")
    SQL.ADD("  and Fecha   >= "~idxdate2(Dialogo.Fecha1)~" ")
    SQL.ADD("  and NrSaldo >  100 ")
    SQL.NEW
    SQL.EXEC
  
    if Dialogo.Check1=0 o Val(x:1)=1
      ACN(o:FAC, Query("Select Count(*) from "~DBO~".POSICIONES where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
      ACN(p:FAC, Query("Select Count(*) from "~DBO~".RESULTADOS where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    endif
    EjecutarEvento('RECPOS', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Cliente1=Dialogo.Cliente1, Vehiculo1=Dialogo.Vehiculo1, Especie1=fbn('Codigo'))
  endif
  if Dialogo.Check1=0 o Val(x:1)=1
    ACN(r:FAC, Query("Select Count(*) from "~DBO~".POSICIONES where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    ACN(s:FAC, Query("Select Count(*) from "~DBO~".RESULTADOS where Especie = '"~fbn('Codigo')~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
  endif
proximo    
ACN(y:1, FAC)

SetFilaActual(1)
recorrer&i Dialogo.Fecha1,Dialogo.Fecha2
  IFA
  ACD(f:fac, &i)
  if EsHabil(&i,'ARG')
    ACT(g:FAC, 'SI')
    if Dialogo.Check1=1
      Message('RESPCO para fecha '~Fecha(&i))
      EjecutarEvento('RESPCO', Fecha1=&i,Especie1=Dialogo.Especie1,Check3=1,Check4=1,Check1=Dialogo.Check1,Check2=Dialogo.Check1 )
    else
      MessageBox('RESPCO para fecha '~Fecha(&i))
    endif
  endif
proximo
if Dialogo.Check1=0 o Val(x:1)=1
  if Val(y:1)>1
    recorrer&i 2,Val(y:1)
      ACN(u:&i, Query("Select Count(*) from "~DBO~".POSICIONES where Especie = '"~Val(b:&i)~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
      ACN(v:&i, Query("Select Count(*) from "~DBO~".RESULTADOS where Especie = '"~Val(b:&i)~"' and Fecha >= "~idxdate2(Dialogo.Fecha1)~" and NrSaldo > 100 "))
    proximo
  endif
endif

ACO(1, 12)
