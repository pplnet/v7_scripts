Sqladd(" Precio6= "~FStr(Val(a7), 0, 2)~", ")
Sqladd(" Precio3= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Precio7= "~FStr(Val(a8), 0, 2)~", ")
Sqladd(" Total2= "~FStr(Val(a5), 0, 2)~", ")
Sqladd(" Total9= "~FStr(Val(a41), 0, 2)~", ")
if (Incluido(Val(a35), 'MMONM'))
Sqladd(" Tasa3= "~FStr(Val(a40), 0, 2)~", ")
endif
Sqladd(" Total1= "~FStr(Val(a6), 0, 2)~", ")
Sqladd(" Cantidad1Ori     ="~FStr(Val(a9), 0, 2)~", ")
Sqladd(" Cantidad2Ori     ="~FStr(Val(a3), 0, 2)~", ")
Sqladd(" ResultadoIndice  =0 ")
Sqladd(" WHERE NrOperacion='"~dialogo.nroperacion2~"' ")
Sqladd(" AND NrCuota="~FStr(Fbn()['NrCuota'], 2, 0)~" ")
Sqlnew()
Sqlexec()

Acn(a3, Val(a3) - Val(a9))
proximo








