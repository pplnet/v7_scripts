creardialogo
fecha1: 'F.Liquid';;;;;;;;;FSys()
mercado1: 'Mercado';
findialogo
if (not ok)
Cancelar()
endif

if (Vacio(dialogo.mercado1))
Act(z2, " ")
else
Act(z2, "and T.Mercado1 = '"~dialogo.mercado1~"' ")
endif

Sqladd(" Select T.NrTrans,T.Fecha2,T.Cliente1,T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, ")
Sqladd("        T.CB8, T.CB7 ,T.CB6 ,T.Mercado1 ,T.CB1                                                             ")
Sqladd("   from "~Dbo()~".TRANSACCIONES2 T, "~Dbo()~".OPERACIONESBITS O ")
Sqladd(" where  T.NrTrans = O.NrOperacion ")
Sqladd(" and    O.NrBit In (3,70,6) and O.Valor ='1' ")
Sqladd(" and    ((T.CB1 = '1' AND T.Mercado1<>'AC') OR (T.CB5='1' AND T.Mercado1='AC')) ")
Sqladd(" and    T.Fecha2 = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and    T.TipoTr2 In ('RET','DEP','COMP','MATCH') ")
Sqladd(" and    (T.Cuenta2 Is Not Null or T.TipoTr2 = 'COMP' or T.Mercado1='AC') ")
Sqladd(Val(z2))
Sqladd(" order by T.NrTrans ")

Acn(z1, 0)
recorrer sql
Scn(z1, 1)
Act(a:Val(z1), Fbn()['NrTrans'])
Act(b:Val(z1), Fbn()['Fecha2'])
Act(c:Val(z1), Fbn()['Cliente1'])
Act(d:Val(z1), Fbn()['TipoTr2'])
Act(e:Val(z1), Fbn()['Especie'])
if (Eqstr(Fbn()['TipoTr2'], 'MATCH'))
Act(e:Val(z1), Val(e:Val(z1))~'/'~Fbn()['Especie1'])
endif
if (Eqstr(Fbn()['TipoTr2'], 'RET'))
Acn(f:Val(z1), -Fbn()['Cantidad1'])
else
Acn(f:Val(z1), Fbn()['Cantidad1'])
endif
if (Eqstr(Fbn()['TipoTr2'], 'MATCH'))
Acn(g:Val(z1), Fbn()['Cantidad2'])
else
Act(g:Val(z1), ' ')
endif
if (Eqstr(Fbn()['Cuenta5'], 'CV'))
if (Fbn()['CB8'] = 1)
Act(g:Val(z1), 'CONF')
endif
if (Fbn()['CB6'] = 1)
Act(g:Val(z1), 'DVP')
endif
if (Fbn()['CB7'] = 1)
Act(g:Val(z1), 'RVP')
endif
endif
Act(h:Val(z1), ' '~Fbn()['Mercado1'])
Act(aa:Val(z1), Fbn()['Mercado1'])
Act(ab:Val(z1), Fbn()['CB1'])
proximo

if (Val(z1) = 0)
Cancelar('No existen Vouchers para imprimir')
else
ACO(1, 9)
ACO(2, 11)
ACO(3, 11)
ACO(4, 7)
ACO(5, 11)
ACO(6, 15)
ACO(7, 15)
ACO(8, 7)
FormatoCeldas(f1..f:Val(z1), Exe('F2'))
FormatoCeldas(g1..g:Val(z1), Exe('F2'))

* listbox stripped

if (ok)
* recorrersel stripped





















endif
endif

