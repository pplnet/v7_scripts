* 6/8
*SETMAN - LIMITS - BAJA MANUAL DE SETTLEMENT

CrearDialogo
  NrOperacion1 :
  Fecha1       : 'Fecha' ;;;;;;;;;FSys
FinDialogo

if not Ok
  Cancelar
endif


SQL.ADD("Update "~DBO~".OPERACIONES set FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"' where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.ADD("Update "~DBO~".MOVLIMITES set Bits = 'P' where Limite = 'SETTLEMENT' and NrOperacion = '"~Dialogo.NrOperacion1~"' and Bits = 'N' and FechaMov <= '"~IdxDate(Dialogo.Fecha1+2)~"' and Monto < 0")
SQL.NEW
SQL.ADD("Delete "~DBO~".MOVLIMITES where Limite = 'PRESETTLEM' and NrOperacion = '"~Dialogo.NrOperacion1~"' and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.NEW
SQL.EXEC
