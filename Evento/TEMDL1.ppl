**-- TEMDLO: Minuta Diaria de Cuenta Corriente Terceros POR LOTES
* HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(FSYS-1,1,'ARG',SI)
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")  
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))


(."TEVERITASA".)

* Obtengo Todos los Pares de Vehiculos CB6=1 => Todos los Originales
SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.Cliente1,O.Especie  ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("where ((O.TipoOp='TEMD' and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("    or (O.TipoOp='TEMINM' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("    or (O.TipoOp='TEMIND' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"')) ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
SQL.ADD(" and NOT EXISTS ")
SQL.ADD(" (SELECT * ")
SQL.ADD("from "~DBO~".OPERACIONES Op")
SQL.ADD("where Op.TipoOp='TEMIND' and Op.FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("      and Op.Vehiculo1=O.Vehiculo1 and Op.Cliente1=O.Cliente1  and Op.Especie=O.Especie) ")
SQL.ADD("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

ACN(AB1,0)

Recorrer SQL
   Message('Procesando Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Cliente1']~' Especie:'~FBN['Especie']~' ...')

   ACT(AV1,FBN['Vehiculo1'])
   ACT(AV2,FBN['Cliente1'])
   ACT(AE1,FBN['Especie'])
   ACD(AF1,Dialogo.Fecha1)

   * Verifico que todas las operaciones esten en BackOffice O Terminal
   (."VERIINSTER".)

   * Recupero la tasa para los pares de vehiculos
   * Si no lo encuentro cancelo
   ACN(a1,SQL("SELECT Tasa from "~DBO~".TASASTERCEROS where Vehiculo='"~FBN['Vehiculo1']~"' and Cliente='"~FBN['Cliente1']~"' and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))

   IF Val(a1)<>0
      EjecutarEvento('TEMIND',Fecha1=Dialogo.Fecha1,Vehiculo1=FBN['Vehiculo1'],Cliente1=FBN['Cliente1'],Especie1=FBN['Especie'],Precio1=VAL(a1))
   Else
      Cancelar(' Falta cargar la Tasa Diaria para '~FBN['Vehiculo1']~'/'~FBN['Cliente1']~' '~FBN['Especie']~' ....')
   Endif

   SCN(AB1,1)
Proximo  
  
IF VAL(AB1)=0
   * No se generaron intereses
   MessageBox('No Existen Operaciones Terceros para la fecha ...')
ENDIF
