SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD(" (NrOperacion,NrBit,Valor) ")

SQL.ADD(" SELECT '"~VAL(Z3)~"' As NrOperacion,NrBit,Valor ")
SQL.ADD(" FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

*************** Las Operaciones Nuevas se generan en la Instancia 15 ************
SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '0' ")
SQL.ADD("  WHERE NrOperacion='"~VAL(Z3)~"' ")
SQL.ADD(" and NrBit         =  '1'  ")
SQL.NEW
SQL.EXEC

SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD("   Set Valor       = '1' ")
SQL.ADD("  WHERE NrOperacion='"~VAL(Z3)~"' ")
SQL.ADD(" and NrBit         =  '15'  ") 
SQL.NEW
SQL.EXEC















