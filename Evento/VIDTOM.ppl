SQL.ADD("Select * from "~DBO~".OPERACIONES ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL

if eqstr(fbn['MB3'],'0')
  act(L1,'1')
else
  act(L1,'0')
endif

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")

   SQL.ADD("(TipoOp, NrOperacion, Operador, ")

   SQL.ADD(" FechaOp, Vehiculo1, Vehiculo2,MB4, ")

   SQL.ADD(" TablaFeriados1, CB9, Cuotas1, ")

   SQL.ADD(" Especie, RB8, TipoTasa, ")

   SQL.ADD(" ContraEspecie, CB6, ")

   SQL.ADD(" MB2, MB3, MB1, TipoOpcion, ")

   SQL.ADD(" PrecioRef, FechaOp2, Plazo, ")

   SQL.ADD(" FechaEj, Cantidad, Precio1, ")

   SQL.ADD(" Plazo2, TotalNetoCli1, FechaVto, TCComCor1, ")

   SQL.ADD(" NrOperacion2, TipoCambio2, CB7, Impresa, ")

   SQL.ADD(" RB3,Cliente1,Book1,Book2,CB1 ) ")

   SQL.ADD("Values")

   SQL.ADD("('DTOMV', '"~VAL(Z3)~"', '"~FBN['Operador']~"', ")

   SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"','"~FBN['Vehiculo2']~"','"~FBN['Vehiculo1']~"','"~FBN['MB4']~"', ")

   SQL.ADD(" '"~FBN['TablaFeriados1']~"','"~FBN['CB9']~"', "~Fstr(FBN['Cuotas1'],2,0)~",")

   SQL.ADD(" '"~FBN['Especie']~"','"~FBN['RB8']~"','"~FBN['TipoTasa']~"', ")

   SQL.ADD(" '"~FBN['ContraEspecie']~"','0', ")

   SQL.ADD(" '"~FBN['MB2']~"', '"~val(L1)~"', '"~FBN['MB1']~"', '"~FBN['TipoOpcion']~"', ")

   SQL.ADD(" '"~FBN['PrecioRef']~"', '"~IdxDate(FBN['FechaOp2'])~"', "~Fstr(FBN['Plazo'],2,0)~", ")

   SQL.ADD(" '"~IdxDate(FBN['FechaEj'])~"', "~Fstr(fbn['Cantidad'],0,2)~", "~Fstr(fbn['Precio1'],0,2)~",")

   SQL.ADD(" "~Fstr(FBN['Plazo2'],2,0)~", "~Fstr(fbn['TotalNetoCli1'],0,2)~",'"~IdxDate(FBN['FechaVto'])~"', "~Fstr(fbn['TCComCor1'],0,2)~",")

   SQL.ADD(" '"~fbn['NrOperacion']~"', "~Fstr(fbn['TipoCambio2'],0,2)~", '"~FBN['CB7']~"', '"~FBN['Impresa']~"',")

   SQL.ADD(" '"~FBN['RB3']~"','"~FBN['Vehiculo1']~"', '"~FBN['Book2']~"', '"~FBN['Book1']~"', '1' )")

   SQL.NEW
   SQL.EXEC

Proximo


* Cuotas de la vinc
SQL.ADD("Select * from "~DBO~".CUOTAS ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")

   SQL.ADD("(NrOperacion, NrCuota, ")

   SQL.ADD(" Cantidad1, Fecha1, Plazo1, Fecha2, ")

   SQL.ADD(" Precio1, Fecha3, Fecha5, Plazo2, ")

   SQL.ADD(" Fecha6, Precio2, ")

   SQL.ADD(" Total1) ")

   SQL.ADD("Values")

   SQL.ADD("('"~VAL(Z3)~"', "~Fstr(FBN['NrCuota'],2,0)~", ")

   SQL.ADD(" "~Fstr(fbn['Cantidad1'],0,2)~", '"~IdxDate(FBN['Fecha1'])~"', "~Fstr(FBN['Plazo1'],2,0)~", '"~IdxDate(FBN['Fecha2'])~"',")

   SQL.ADD(" "~Fstr(fbn['Precio1'],0,2)~", '"~IdxDate(FBN['Fecha3'])~"', '"~IdxDate(FBN['Fecha5'])~"', "~Fstr(FBN['Plazo2'],2,0)~",")

   SQL.ADD("  '"~IdxDate(FBN['Fecha6'])~"', "~Fstr(fbn['Precio2'],0,2)~",")

   SQL.ADD("  "~Fstr(fbn['Total1'],0,2)~") ")

   SQL.NEW
   SQL.EXEC

Proximo

