modificaroperacion(dialogo.nroperacion1, 0, SI, SI, SI, NO, SI, NO, NO, NO, NO, NO, NO, NO, NO, NO, NO, SI, NO, NO, NO, SI, NO, SI, NO, 0, NO, NO)
