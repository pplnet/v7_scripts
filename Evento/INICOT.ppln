Sqladd("Select C.* FROM "~Dbo()~".CUOTAS C,"~Dbo()~".OPERACIONES O Where O.NrOperacion=C.NrOperacion and O.TipoOp like 'MM%' and (C.Cotizacion1=0 or C.Cotizacion1 is null or C.Cotizacion2=0 or C.Cotizacion2 is null)")

recorrer sql
Act(x1, '')

Message("Operacion "~Fbn()['NrOperacion']~" "~FStr(Fbn()['NrCuota'], 0, 0))

if (Fbn()['Cotizacion1'] = 0 o Vacio(Fbn()['Cotizacion1']))
Act(x1, "Cotizacion1=-1 ")
endif
if (Fbn()['Cotizacion2'] = 0 o Vacio(Fbn()['Cotizacion2']))
if (NoVacio(Val(x1)))
Act(x1, Val(x1)~",")
endif
Act(x1, Val(x1)~"Cotizacion2=-1 ")
endif

Sqladd("UPDATE "~Dbo()~".CUOTAS Set ")
Sqladd(" "~Val(x1)~" ")
Sqladd(" Where NrOperacion='"~Fbn()['NrOperacion']~"' and NrCuota="~FStr(Fbn()['NrCuota'], 0, 0)~" ")
Sqlnew()
Sqlexec()
proximo


