HojaVisible(NO)
CrearDialogo
    Fecha1: 'Fecha'              ;1;1;1;SI;SI;EsHabil(Dialogo.Fecha1);'Debe ser fecha habil';NO;FSYS;;;;
    Radio1: '|Manual|Automatico' ;3;1;1;SI;NO;;;;0
FinDialogo

SQL.ADD(" Select NrOperacion, FechaVto, Plazo2, Precio6, Cantidad, Indice, TablaFeriados1 from "~dbo~".OPERACIONES ")
SQL.ADD(" where TipoOp = 'MMCPM' and TipoGracia = 'CUP' ")
SQL.ADD(" and Indice is not null and FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")

SetFilaActual(0)
Recorrer SQL
    ACT(A:fac,fbn['NrOperacion'])
    ACD(B:fac,fbn['FechaVto'])
    ACN(C:fac,fbn['Cantidad'])
    ACD(D:fac,Habiles(fbn['FechaVto'],-fbn['Plazo2'],fbn['TablaFeriados1'],SI))
    ACT(E:fac,fbn['Indice'])
    ACN(F:fac,COTIZACION(fbn['Indice'],,,,Habiles(fbn['FechaVto'],-fbn['Plazo2'],fbn['TablaFeriados1'],SI),1,SI))
    ACN(G:fac,fbn['Cantidad']*(Val(F:fac) - fbn['Precio6']))
    ACN(HH:fac,fbn['Precio6'])
    ifa
Proximo

dfa

If Dialogo.Radio1 = 0
    CrearListBox ;'Arial,8';'Valor UVA Cierre'
        'NrOperacion'       ; A:1..A:fac; NO; NO; ; 100; STRING
        'FechaVto'          ; B:1..B:fac; NO; NO; ; 100; FECHA
        'Cantidad'          ; C:1..C:fac; NO; NO; ; 100; NUMERO
        'FechaCierreIndice' ; D:1..D:fac; NO; NO; ; 100; FECHA
        'Indice'            ; E:1..E:fac; NO; NO; ; 100; STRING
        'Tasa Indice'       ; F:1..F:fac; SI; [Val(CLB:FLB) > 0];'Tasa Indice debe ser mayor a 0' ; 100; NUMERO; '####.###,###,##'
        'Resultado Indice'  ; G:1..G:fac; NO; NO; ; 100; NUMERO; '###,###,###.##p';;Val(C:FLB)*(Val(F:FLB) - Val(HH:FLB))
    FinListBox
Endif

Recorrer&i 1,fac
    SQL.ADD(" UPDATE "~dbo~".OPERACIONES ")
    SQL.ADD(" SET Precio7 = "~Fstr(Val(F:&i),0,8)~", ResultadoIndice = "~Fstr(Val(G:&i),0,2)~" ")
    SQL.ADD(" Where NrOperacion = '"~Val(A:&i)~"' ")
    SQL.NEW
    SQL.EXEC
    SQL.ActualizarMovimientos4(Val(A:&i),SI,,,,SI)
    SQL.EXEC
    ifa
proximo