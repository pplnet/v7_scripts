creardialogo
fecha1:"Fecha";;;;;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;FSys()
vehiculo1:"Vehiculo";;;;;;;;;;;;;;iif (NoVacio(UsrVehiculos(UsuarioActivo())), " Codigo in (Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"') ")
findialogo

if (not ok)
Cancelar()
endif

if (not Vacio(dialogo.vehiculo1))
if (not Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) y not Vacio(UsrVehiculos(UsuarioActivo())))
Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
endif
endif

Act(zz6, SQLSet("Select Vehiculo From "~Dbo()~".USRVEHICULO Where Codigo = '"~UsuarioActivo()~"'"))

SetFilaActual(1)

Acd(af1, dialogo.fecha1)

Acn(h2, 1)

Sqladd("SELECT  P.Vehiculo,P.Cliente,P.ListaEspecies FROM  "~Dbo()~".IMPTERCEROS P ")
Sqladd("Where Estado='HAB' ")
if (NoVacio(dialogo.vehiculo1))
Sqladd(" and P.Vehiculo='"~dialogo.vehiculo1~"' ")
else
if (NoVacio(UsrVehiculos(UsuarioActivo())))
Sqladd(" and P.Vehiculo IN ("~Pipe2Comillas(Val(zz6))~") ")
endif
endif
Sqladd("Order By P.Vehiculo,P.Cliente")

recorrer sql

Dfa()
Message('Pares de Vehiculos: '~Fbn()['Vehiculo']~'/'~Fbn()['Cliente']~'  ...')

Act(av1, Fbn()['Vehiculo'])
Act(av2, Fbn()['Cliente'])

Sqladd("SELECT Codigo FROM  "~Dbo()~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Fbn()['ListaEspecies'])~") ")

recorrer sql
Acn(h1, 0)

recorrer&i 1, Fac() - 1
if (Eqstr(Val(a:&i), Val(av2)) y Eqstr(Val(b:&i), Val(av1)) y Eqstr(Fbn()['Codigo'], Val(c:&i)))
Acn(h1, 1)
break
endif
proximo

recorrer&i 1, Val(h2)
if (Eqstr(Val(za:&i), Val(av2)) y Eqstr(Val(zb:&i), Val(av1)) y Eqstr(Fbn()['Codigo'], Val(zc:&i)))
Acn(h1, 1)
break
endif
proximo

if (Val(h1) = 0)
Act(a:fac, Val(av1))
Act(b:fac, Val(av2))
Act(c:fac, Fbn()['Codigo'])

Acd(ah1, 0)

Sqladd("SELECT DISTINCT O.Vehiculo1,O.Cliente1,O.Especie  ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((O.TipoOp='TEMD' and O.FechaOp='"~IdxDate(dialogo.fecha1)~"') or ")
Sqladd("       (O.TipoOp='TEMIND' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"' ) or ")
Sqladd("       (O.TipoOp='TEMINM' and O.FechaVto='"~IdxDate(dialogo.fecha1)~"' )) ")
Sqladd("and O.Vehiculo1='"~Val(av1)~"'  and O.Cliente1='"~Val(av2)~"' ")
Sqladd("and O.Especie='"~Fbn()['Codigo']~"' ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT * ")
Sqladd("from "~Dbo()~".OPERACIONES Op ")
Sqladd("where Op.TipoOp='TEMIND' and Op.FechaOp='"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd("      and Op.Vehiculo1=O.Vehiculo1 and Op.Cliente1=O.Cliente1  and Op.Especie=O.Especie) ")
Sqladd("Order By O.Vehiculo1,O.Cliente1,O.Especie ")

recorrer sql
Dfa()
Acn(ah1, 1)

Act(av1, Fbn()['Vehiculo1'])
Act(av2, Fbn()['Cliente1'])

Message('Saldos Vehiculo: '~Fbn()['Vehiculo1']~' Veh. ContraParte '~Fbn()['Cliente1']~' Especie:'~Fbn()['Especie']~' ...')

Act(ae1, Fbn()['Especie'])

Sqladd("SELECT O.* ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where ((TipoOp='TEMD' and FechaOp='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='TEMIND' and FechaVto='"~IdxDate(Val(af1))~"') ")
Sqladd(" or (TipoOp='TEMINM' and FechaVto='"~IdxDate(Val(af1))~"')) ")
Sqladd(" and O.Especie='"~Val(ae1)~"' ")
Sqladd(" and O.Vehiculo1='"~Val(av1)~"' and O.Cliente1='"~Val(av2)~"' ")
Sqladd(" AND NOT EXISTS ")
Sqladd(" (SELECT TipoOp ")
Sqladd("from "~Dbo()~".OPERACIONES O")
Sqladd("where TipoOp='TEMIND' and FechaOp='"~IdxDate(Val(af1))~"' ")
Sqladd(" and O.Especie ='"~Val(ae1)~"' ")
Sqladd(" and O.Vehiculo1='"~Val(av1)~"' and O.Cliente1='"~Val(av2)~"') ")
Sqladd(" Order By O.FechaOp,O.NrOperacion ")

Acn(z1, 0)

recorrer sql

Dfa()

if (Eqstr(Fbn()['TipoOp'], 'TEMINM'))
Acn(z1, Val(z1) + (Fbn()['TotalBrutoCli1'] * iif (Eqstr(Fbn()['MB3'], '0'), -1, 1)))
else
Acn(z1, Val(z1) + (Fbn()['Cantidad'] * iif (Eqstr(Fbn()['MB3'], '0'), -1, 1)))
endif

proximo


Acn(z1, Round(Val(z1), 2))


Acn(e:fac, Val(z1))
Act(d:fac, iif (Val(e:fac) < 0, 'COLOCA', 'TOMA'))
Acn(e:fac, iif (Val(z1) < 0, -Val(z1), Val(z1)))
Acn(f:fac, Query("SELECT Tasa    from "~Dbo()~".TASASTERCEROS where Vehiculo='"~Val(av1)~"' and Cliente='"~Val(av2)~"' and Especie ='"~Fbn()['Especie']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))
proximo

if (Val(ah1) = 0)
Sqladd("SELECT * ")
Sqladd("from "~Dbo()~".OPERACIONES ")
Sqladd("where TipoOp='TEMIND'  and Vehiculo1='"~Val(av1)~"'  and Cliente1='"~Val(av2)~"' ")
Sqladd("and Especie='"~Fbn()['Codigo']~"' ")
Sqladd("and FechaOp='"~IdxDate(dialogo.fecha1)~"'  ")
Sqladd("Order By Vehiculo1,Cliente1,Especie ")

recorrer sql
Dfa()
Act(d:fac, iif (Fbn()['MB3'] = 0, 'COLOCA', 'TOMA'))
Acn(e:fac, Fbn()['Cantidad'])
Acn(f:fac, Query("SELECT Tasa    from "~Dbo()~".TASASTERCEROS where Vehiculo='"~Val(av1)~"' and Cliente='"~Val(av2)~"' and Especie ='"~Fbn()['Especie']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))
Acn(g:fac, 0)
Acn(ah1, 1)
proximo
endif

if (Val(ah1) = 0)
Act(za:Val(h2), Val(av1))
Act(zb:Val(h2), Val(av2))
Act(zc:Val(h2), Fbn()['Codigo'])
Acn(ze:Val(h2), 0)
Act(zd:Val(h2), 'Sin SALDO')
Acn(zf:Val(h2), Query("SELECT Tasa  from "~Dbo()~".TASASTERCEROS where Vehiculo='"~Val(av1)~"' and Cliente='"~Val(av2)~"' and Especie ='"~Fbn()['Codigo']~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))
Acn(zg:Val(h2), 1)
Scn(h2, 1)
Dfa()
endif
else
Dfa()
endif
proximo
proximo

recorrer&j 1, Val(h2) - 1
Ifa()
Act(a:fac, Val(za:&j))
Act(b:fac, Val(zb:&j))
Act(c:fac, Val(zc:&j))
Acn(e:fac, Val(ze:&j))
Act(d:fac, Val(zd:&j))
Acn(f:fac, Val(zf:&j))
Acn(g:fac, Val(zg:&j))
proximo

Acn(k1, 0)

if (Val(k1) <> 2)
recorrer&j 1, 1000
creardialogo
fecha1:"Fecha";1;1;;NO;;dialogo.fecha1 <> 0;'Debe Ingresar la Fecha';NO;Val(af1)
listbox;'Arial,8,N';460;180
'Vehiculo1';a2..a: Fac();NO;;;;70;string
'Cliente1';b2..b: Fac();NO;;;;70;string
'Especie';c2..c: Fac();NO;;;;40;string
'Saldo';e2..e: Fac();NO;;;;70;numero;'#,###,###,###.##'
'Tipo';d2..d: Fac();NO;;;;60;string
'Tasa';f2..f: Fac();;;;;50;numero;'###.#####'
'Clase';g2..g: Fac();NO;;;;40;combo;'Activo|Pasivo'
finlistbox
findialogo

if (not ok)
Cancelar()
endif

Acn(k1, 0)

recorrer&i 2, Fac()
if (Val(f:&i) = 0)
Acn(k1, 0)
Acn(k1, Messagebox("La Tasa '"~Val(a:&i)~"'/'"~Val(b:&i)~"'-'"~Val(c:&i)~"' Es Incorrecta. Continua? ", 2, 1))
if (Val(k1) = 2)
break
endif
endif
proximo

if (Val(k1) <> 1)
break
endif
proximo

if (Val(k1) <> 2)

recorrer&i 2, Fac()

if (Val(f:&i) <> 0 y NoVacio(Val(a:&i)))
Message("Actualizando '"~Val(a:&i)~"'/'"~Val(b:&i)~"' - '"~Val(c:&i)~"' ... ")

Acn(h:&i, 0)
Acn(h:&i, Query("SELECT Count(*) FROM "~Dbo()~".TASASTERCEROS Where Vehiculo='"~Val(a:&i)~"' and Cliente='"~Val(b:&i)~"' and Especie='"~Val(c:&i)~"' and Fecha='"~IdxDate(dialogo.fecha1)~"' "))

if (Val(h:&i) > 0)
Sqladd("UPDATE "~Dbo()~".TASASTERCEROS Set Tasa="~FStr(Val(f:&i), 0, 5)~" Where ")
Sqladd(" Vehiculo='"~Val(a:&i)~"' and Cliente='"~Val(b:&i)~"' ")
Sqladd(" and Fecha='"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" and Especie='"~Val(c:&i)~"' ")
Sqlnew()
Sqlexec()
else
Sqladd("INSERT INTO "~Dbo()~".TASASTERCEROS ")
Sqladd(" (Fecha,Vehiculo,Cliente,")
Sqladd(" Especie,Tasa) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(dialogo.fecha1)~"','"~Val(a:&i)~"','"~Val(b:&i)~"', ")
Sqladd(" '"~Val(c:&i)~"',"~FStr(Val(f:&i), 0, 5)~") ")
Sqlnew()
Sqlexec()
endif
endif
proximo
endif
endif

