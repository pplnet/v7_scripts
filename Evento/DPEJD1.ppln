creardialogo
nroperacion1:"Operacion";1;1;;;;NoVacio(dialogo.nroperacion1);'Debe Ingresar una Operacion';NO;
entero1:"Nro.Settlement";;;;;;dialogo.entero1 > 0;'El Nro. de Settlement es Incorrecto';NO
fecha1:"F Real Ej.";;;;NO;;dialogo.fecha1 >= dialogo.fecha4;'La Fecha de Ejercicio Real para esta Operacion es Invalida';NO;FSys()
precio2:"Floating Price";;;;;;dialogo.precio2 <> 0;'Indique el Precio de Referencia';NO;;;;;"###,###,###.########"
entero2:"Doas_Ejercio";6;1;;;;dialogo.entero2 <= dialogo.entero3;'La Cant. de Doas en que se Ejercio no debe superar los Doas Habiles del Settlement';NO;
especie1:"Commodity";1;2;;NO;;;;;;BuscarCampo('Operaciones', 'Especie', 'NrOperacion', dialogo.nroperacion1)
fecha4:"Fecha Settlement";2;2;;NO;;;;;;sql(" Select Fecha1 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
precio3:"Precio Ej";;;;NO;;;;;;BuscarCampo('Operaciones', 'PrecioEj', 'NrOperacion', dialogo.nroperacion1)
radio2:"Tipo|Call|Put";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB1', 'NrOperacion', dialogo.nroperacion1)
radio3:"    |Compra|Venta";;;;NO;;;;;;BuscarCampo('Operaciones', 'MB3', 'NrOperacion', dialogo.nroperacion1)
entero3:"Doas_Habiles";;;;NO;;;;;;sql("Select Plazo2 from "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"' and NrCuota="~FStr(dialogo.entero1, 2, 0)~" ")
findialogo

if (not ok)
Cancelar()
endif


Act(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', dialogo.nroperacion1))

sql.add("SELECT U.Vehiculo FROM "~Dbo()~".USRVEHICULO U,"~Dbo()~".VEHICULOS V ")
sql.add("WHERE  U.Codigo='"~UsuarioActivo()~"' and U.Vehiculo=V.Codigo ")
sql.add("       and (Status='HAB' or Status Is Null or Status='')")

recorrer sql
Dfa()
Act(vh2, Fbn()['Vehiculo']~'|'~Val(vh2))
proximo
if (not Incluido(Val(vh1), Val(vh2)) y NoVacio(Val(vh2)))
Cancelar()('Usuario no Habilitado para Trabajar con el Vehiculo ')
endif


if (not Incluido(BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', dialogo.nroperacion1), 'DPOD'))
Cancelar()('La operacion No '~dialogo.nroperacion1~' No es un Call o Put Diario')
endif

if (dialogo.entero2 = 0 y ((dialogo.radio2 = 0 y dialogo.precio2 >= dialogo.precio3) o (dialogo.radio2 = 1 y dialogo.precio2 <= dialogo.precio3)))
Cancelar()('Si desea ejercer la operacion Debe indicar la Cantidad de Dias de Ejercicio')
endif

Acn(x1, sql("Select NrBit FROM "~Dbo()~".OPERACIONESBITS  Where NrOperacion='"~dialogo.nroperacion1~"' AND Valor='1'"))

if (Val(x1) <> 20 y Val(x1) <> 50)
Cancelar()('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~sql("Select Nombre FROM "~Dbo()~".INSTANCIAS  Where NrInstancia="~FStr(Val(x1), 0, 0)~" AND Tabla='OPERACIONES'"))
endif

Acd(d1, sql("Select Fecha2 FROM "~Dbo()~".CUOTAS where NrOperacion = '"~dialogo.nroperacion1~"' and NrCuota=(Select Max(NrCuota) FROM "~Dbo()~".CUOTAS where NrOperacion='"~dialogo.nroperacion1~"') "))

Message(Val(d1))

if (Vacio(Val(d1)))
Acd(d1, BuscarCampo('Operaciones', 'FechaPago', 'NrOperacion', dialogo.nroperacion1))
Message(Val(d1)~' Operaciones Simple ')
endif




if (dialogo.fecha1 > Val(d1))
Cancelar()('La Operacion ya fue Liquidada, No se puede Modificar !!!')
endif

if (ok)
Acn(x1, 0)

sql.add("Select * from "~Dbo()~".CUOTAS ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")


recorrer sql

Acn(x1, 1)

if (dialogo.radio2 = 0 y dialogo.precio2 >= dialogo.precio3) o (dialogo.radio2 = 1 y dialogo.precio2 <= dialogo.precio3)
if (dialogo.radio2 = 0)
Acn(z3, (dialogo.precio2 - dialogo.precio3))
else
Acn(z3, (dialogo.precio3 - dialogo.precio2))
endif

if (dialogo.radio3 = 1)
Acn(z3, -Val(z3))
endif

Acn(z2, Val(z3) * Fbn()['Cantidad1'] * dialogo.entero2)


Message('Actualizando la Opcion  .... ')

sql.add("Update "~Dbo()~".CUOTAS ")
sql.add("Set ")
sql.add("Precio1   = "~FStr(dialogo.precio2, 0, 8)~", ")
sql.add("Precio2   = "~FStr(Val(z3), 0, 8)~", ")
sql.add("Total1    = "~FStr(Val(z2), 0, 8)~", ")
sql.add("Cantidad2 = "~FStr(dialogo.entero2, 0, 0)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
sql.new
sql.exec


sql.actualizarmovimientos(dialogo.nroperacion1, SI)
sql.exec

else
sql.add("Update "~Dbo()~".CUOTAS ")
sql.add("Set ")
sql.add("Precio1   = "~FStr(dialogo.precio2, 0, 8)~" ")
sql.add("where NrOperacion = '"~dialogo.nroperacion1~"' ")
sql.add("and NrCuota = "~FStr(dialogo.entero1, 2, 0)~" ")
sql.new
sql.exec
endif

Message('Modificando Instancias Operacion '~Val(az3)~' ...')


sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=0 Where Valor=1 and NrOperacion='"~Val(az3)~"' ")
if (Val(az6) <> 0)
sql.add("and NrBit="~FStr(Val(az6), 0, 0)~"  ")
endif
sql.new

if (sql(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~Val(az3)~"' AND NrBit="~FStr(Val(az5), 0, 0)~" ") = 0)
ejecutarevento('INSBIT', entero1 = Val(az5), nroperacion1 = Val(az3))
endif

sql.add("UPDATE "~Dbo()~".OPERACIONESBITS ")
sql.add("Set Valor=1 Where NrBit="~FStr(Val(az5), 0, 0)~" and NrOperacion='"~Val(az3)~"' ")
sql.new
sql.exec



proximo

if (Val(x1) = 0)
Cancelar()('La operacion No '~dialogo.nroperacion1~' Cuota No '~FStr(dialogo.entero1, 2, 0)~' No puede ser Ejercida')
endif
endif


