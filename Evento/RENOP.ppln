'Intereses';ak:1..ak:&filacarga;NO;NO;;100;numero;'###,###,###,###.##';;(Val(an:flb) * (Val(aj:flb) / 100) * Val(ah:flb)) / Val(ao:flb);NO;NO;;;;;SI
'TasaRet.';al:1..al:&filacarga;SI;Val(al:flb) >= 0;'La tasa de retencion no puede ser negativa';60;numero;'###.########'
'Retenciones';am:1..am:&filacarga;NO;;;100;numero;'###,###,###,###.##';;(Val(ak:flb) * Val(al:flb)) / 100;NO;NO;;;;;SI
