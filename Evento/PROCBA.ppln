sql.add("Select O.NrOperacion, O.NroAltaMAE ")
sql.add("  from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS OB ")
sql.add(" Where O.NrOperacion = OB.NrOperacion ")
sql.add("   and OB.NrBit      = 77 ")
sql.add("   and OB.Valor      = '1' ")
sql.add("   order by O.NrOperacion")
recorrer sql
