sql.add(" AND M.Especie = 'ARP' ")
endif
if (Incluido(dialogo.string, 'DNCCDO|DNCADO'))
sql.add(" AND M.Especie = 'USD' ")
endif
if (dialogo.radio2 = 0)
sql.add(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
