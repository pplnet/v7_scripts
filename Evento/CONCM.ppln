sql.add(" SELECT MIN(M.FechaMov) Fecha FROM "~Dbo()~".MOVPENDIENTES M, "~Dbo()~".OPERACIONESBITS B, "~Dbo()~".CUENTAS C ")
sql.add(" WHERE M.NrOperacion = B.NrOperacion ")
sql.add(" AND   M.Cuenta      = C.Codigo      ")
sql.add(" AND   B.Valor       =  '1' ")
sql.add(" AND   B.NrBit       =  18  ")
