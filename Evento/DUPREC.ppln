HojaVisible(SI)
MostrarCuadroDeMensajes()

creardialogo
directorio1: 'Path ';;;;SI;SI;;;;
string1: 'Archivo ';;;;SI;SI;;;;
findialogo

if (not ok)
Cancelar()
endif

if (existedirectorio(dialogo.directorio1))
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
if (not existearchivo(dialogo.directorio1~dialogo.string1))
Cancelar('1.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
else
if (not existearchivo(dialogo.directorio1~'\'~dialogo.string1))
Cancelar('2.El Archivo '~dialogo.string1~' no existe en el directorio: '~dialogo.directorio1)
endif
endif
else
Cancelar('El directorio '~dialogo.directorio1~' no existe')
endif

let(&pf, '')
if (Eqstr(Copy(dialogo.directorio1, Longitud(dialogo.directorio1), 1), '\'))
let(&pf, dialogo.directorio1~dialogo.string1)
else
let(&pf, dialogo.directorio1~'\'~dialogo.string1)
endif

importarxls(a:2..g:1000, aa:2..ag:1000, &pf)

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

Act(c:1, 'Nuevas Relaciones Cuenta')
SetFont(c:1, 1)

Act(a:2, 'Nueva - Original')
SetFont(a:2, 2)

SetFilaActual(2)

recorrer&i 2, 1000
if (NoVacio(Val(aa:&i)))
Sqladd(" SELECT TiposOperacion, TiposGrupoEsp, Tabla, Moneda ")
Sqladd(" FROM "~Dbo()~".RELACIONCUENTA ")
Sqladd(" WHERE Codigo = '"~FStr(Val(aa:&i), 0, 0)~"' ")
recorrer sql
let(&tiposoperacion, Fbn('TiposOperacion'))
let(&tiposgrupoesp, Fbn('TiposGrupoEsp'))
let(&tabla, Fbn('Tabla'))
let(&moneda, Fbn('Moneda'))

let(&vehiculos, 'BACS|')

let(&cuenta, Val(ac:&i))
if (NoVacio(Val(af:&i)))
let(&book, iif (Eqstr(Copy(Val(af:&i), Longitud(Val(af:&i)), 1), '|'), Val(af:&i), Val(af:&i)~'|'))
else
let(&book, '')
endif

Sqladd(" SELECT MAX(TRY_CAST(Codigo AS INT))+1 Codigo ")
Sqladd(" FROM "~Dbo()~".RELACIONCUENTA ")
recorrer sql
Dfa()
let(&codigo, Fbn('Codigo'))
proximo

Sqladd(" INSERT INTO "~Dbo()~".RELACIONCUENTA ")
if (NoVacio(&book))
Sqladd(" (Codigo,TiposOperacion,TiposGrupoEsp,Tabla,Moneda,Vehiculos,Cuenta,Book) ")
Sqladd(" VALUES ")
Sqladd(" ('"~FStr(&codigo, 0, 0)~"','"~&tiposoperacion~"','"~&tiposgrupoesp~"','"~&tabla~"','"~&moneda~"','"~&vehiculos~"','"~FStr(&cuenta, 0, 0)~"','"~&book~"') ")
else
Sqladd(" (Codigo,TiposOperacion,TiposGrupoEsp,Tabla,Moneda,Vehiculos,Cuenta) ")
Sqladd(" VALUES ")
Sqladd(" ('"~FStr(&codigo, 0, 0)~"','"~&tiposoperacion~"','"~&tiposgrupoesp~"','"~&tabla~"','"~&moneda~"','"~&vehiculos~"','"~FStr(&cuenta, 0, 0)~"') ")
endif
Sqlnew()
Sqlexec()
Act(a:fac, FStr(&codigo, 0, 0)~' - '~FStr(Val(aa:&i), 0, 0))
SetFont(a:fac, 3)

Sqladd(" UPDATE "~Dbo()~".RELACIONCUENTA ")
Sqladd(" Set Vehiculos = 'BIND|' ")
Sqladd(" WHERE Codigo = '"~FStr(Val(aa:&i), 0, 0)~"' ")
Sqlnew()
Sqlexec()
proximo
else
break
endif
proximo

Act(a:fac + 2, 'Fin del informe')
LimitesVision(g:fac + 3)
ACO(1, 12)
