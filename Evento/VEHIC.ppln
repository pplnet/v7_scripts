sql.add(" Select Codigo, Vehiculos From "~Dbo()~".RELACIONCUENTA Where Vehiculos like '%"~Val(a:&i)~"%' ")

recorrer sql
Act(vh:1, '')
sql.add(" Select Codigo Vehic From "~Dbo()~".VEHICULOS Where Codigo in ("~pipe2comillas(Fbn()['Vehiculos'])~") ")
recorrer sql
if (Eqstr(Val(vh:1), ''))
if (Eqstr(Fbn()['Vehic'], Val(a:&i)))
Act(vh:1, Val(b:&i))
else
Act(vh:1, Fbn()['Vehic'])
endif
else
if (Eqstr(Fbn()['Vehic'], Val(a:&i)))
Act(vh:1, Val(vh:1)~'|'~Val(b:&i))
else
Act(vh:1, Val(vh:1)~'|'~Fbn()['Vehic'])
endif
endif
proximo
sql.add(" Update "~Dbo()~".RELACIONCUENTA Set Vehiculos= '"~Val(vh:1)~"' Where Codigo= '"~Fbn()['Codigo']~"' ")
sql.new
sql.exec
