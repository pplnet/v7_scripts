*- AUTOP: Indica quien Autoriza un Excepcion
CrearDialogo
   NrOperacion1 : 'Operacion' ;;;;;;NoVacio(Dialogo.NrOperacion1);'Operacion Incorrecta';NO;;;;;;
   String1      : 'Excepcion' ;;;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

SQL.ADD("SELECT * FROM "~DBO~".EXCEPCIONES Where NrOperacion='"~Dialogo.NrOperacion1~"' ")
if NoVacio(Dialogo.String1)
   SQL.ADD("   and Tipo in ("~Pipe2Comillas(Dialogo.String1)~") ")
endif
Recorrer SQL
   ACT(a1, FBN['Autorizado']~" "~USUARIOACTIVO )
Proximo

SQL.ADD("Update "~DBO~".EXCEPCIONES ")
SQL.ADD("   Set Autorizado = '"~val(a1)~"' ")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD("   and Autorizado is Null ")
if NoVacio(Dialogo.String1)
   SQL.ADD("   and Tipo in ("~Pipe2Comillas(Dialogo.String1)~") ")
endif

SQL.NEW
SQL.EXEC

