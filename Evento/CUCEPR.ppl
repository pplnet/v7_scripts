*- NrOperacion1 es la operacion que cedio 
*- NrOperacion2 es la operacion nuevo que genero
CrearDialogo
   NrOperacion1:'Op  Cabecera'
   NrOperacion2:'Op. Participante'
FinDialogo

If not Ok
 Cancelar
EndIf

ACN(B1,SQL(" SELECT Sum(Tasa1) as SumTasa FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' "))

SQL.ADD("SELECT Tasa1,NrCuota FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' Order By NrCuota ")

* B2 Contador de Cuotas
ACN(B3,0)

Recorrer SQL
  ACN(B2,100*FBN['Tasa1']/VAL(B1))
  SQL.ADD(" Update "~DBO~".CUOTAS SET ")
  SQL.ADD(" Tasa1= "~Fstr(VAL(B2),0,2)~" ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
  SQL.ADD(" and NrCuota="~FStr(FBN['NrCuota'],2,0)~" ")
  SQL.NEW
  SQL.EXEC
  SCN(B3,1)
Proximo

SQL.ADD("SELECT PrecioEj,TipoOp,RB8,ImpGastos2,TotalAux1,TasaImp1,CB10,RB6,MB1,Precio3,DeltaTasa")
SQL.ADD("FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")

Recorrer SQL
    dfa

    ACN(A36,FBN['PrecioEj'])
    *-- A35: Tipo de Operacion que prorrateo
    ACT(A35,FBN['TipoOp'])

    *-- A10: Unidad de Tiempo Calculo de Intereses
    ACN(A10,FBN['RB8'])

    *-- VN del periodo
    ACN(A3,FBN['PrecioEj'])


    *-- A20: TasaIva   A21: TasaWH  a40: %Imp.Interes
    ACN(A20,FBN['ImpGastos2'])
    ACN(A21,FBN['TotalAux1'])
    ACN(A40,FBN['TasaImp1'])

    *-- LOCAL O EXTRANJERO
    ACT(A26,FBN['CB10'])

    *- RB6 => Caso
    ACN(A22,FBN['RB6'])

    *- MB1 => UT_CEC|360|365
    ACT(A23,FBN['MB1'])

    *- Tasa CEC
    ACN(A25,FBN['Precio3'])

    *- %_Cs_Fin_CEC
    ACN(A26,FBN['DeltaTasa'])
Proximo

*-- Calculo CUOTAS
SQL.ADD("SELECT * FROM "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
SQL.ADD("order By NrCuota ")

Recorrer SQL
  dfa
  *-- INTERES
  acn (a4, val(a3) * ((FBN['Precio2']+FBN['Precio4'])/100) * FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))

  * A4 es el interes
  * A11 es el interes total
  * A5 es el monto
  * A6 es el monto total
  * A7 es el importe iva
  * A8 es el importe wh
  * A9 es el importe de amortizaci¦n del per¦odo
  * A30 Y 31 360 O 365 PARA IVA Y WH

  ACN(A7,0)
  ACN(A8,0)
  ACN(A41,0)

  If EqStr('MMPCLM',val(a35)) 
     *- El prestamo local Fondeo local no habilita Tasa Interes para el calculo del iva
     ACN(A7,((val(a3)*(FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(A10)+1))*(VAL(A20)/100))
  Else
     ACN(A7,((val(a3)*FBN['Tasa2']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(A10)+1))*(VAL(A20)/100))
  EndIf

  *-- Calculo de Imp.Interes
  acn(a41,VAL(a4)*VAL(a40)/100)  

  *-- Para Extranjeros
  IF Not EqStr(val(A26),'0') y EqStr('MMPOSM',val(a35))
     ACN (A8, ((val(a3)*FBN['Total6']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)) * (VAL(A21)/100))
  ENDIF

  *-- calcula el importe de amortizacion del per¦odo
  acn(A9, val(a36)*FBN['Tasa1']/100)

  *- Para MMPCLM 
  *- Si RB6=1 Calculo importe variable cec en A23 
  *- a27 => Costo Financiero Cec a28: Importe Total cec
  ACN(A24, 0)
  ACN(A27, 0)
  IF VAL(A22)=1 y EqStr('MMPCLM',val(a35))
     ACN(A24, ((val(a3)*FBN['Total5']*FBN['Plazo1'])/IIF(val(a23)=0,36000,36500)*(val(A25)/100))  )
     ACN(A28,FBN['Cantidad5']+val(a24) )
     ACN(A27,val(a26)*val(a28)/100)
     ACN(A7,((val(a3)*FBN['Tasa2']/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(A10)+1)+VAL(A28))*(VAL(A20)/100))
  ENDIF

  *-- INTERES TOTAL
  acn (a11, VAL(A27)+VAL(A41)+VAL(A4)+VAL(A28))

  *-- MONTO
  ACN (A5, val(a9) +VAL(A4))

  *-- MONTO TOTAL
  ACN (A6, val(a9) +VAL(A11))

  SQL.ADD("Update "~DBO~".CUOTAS SET ")
  SQL.ADD(" Cantidad1= "~Fstr(VAL(A9),0,2)~", ")
  SQL.ADD(" Cantidad2= "~Fstr(VAL(A3),0,2)~", ")
  SQL.ADD(" Cantidad4= "~Fstr(VAL(A24),0,2)~", ")
  SQL.ADD(" Cantidad6= "~Fstr(VAL(A28),0,2)~", ")
  SQL.ADD(" Cantidad7= "~Fstr(VAL(A27),0,2)~", ")
  SQL.ADD(" Cantidad3= "~Fstr(VAL(A4),0,2)~", ")
  SQL.ADD(" Total4= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Total9= "~Fstr(VAL(A41),0,2)~", ")
  SQL.ADD(" Total3= "~Fstr(val(a11),0,2)~", ")
  SQL.ADD(" Total2= "~Fstr(VAL(A5),0,2)~", ")
  SQL.ADD(" Total1= "~Fstr(VAL(A6),0,2)~", ")
  *- Campos de mod. especial de operaciones
  SQL.ADD(" Precio5= "~Fstr(VAL(A4),0,2)~", ")
  SQL.ADD(" Precio6= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Precio7= "~Fstr(VAL(A24),0,2)~", ")
  SQL.ADD(" PrecioRef1= "~Fstr(VAL(A41),0,2)~", ")
  SQL.ADD(" Cantidad8= "~Fstr(VAL(A27),0,2)~", ")
  SQL.ADD(" Cantidad1Ori     ="~Fstr(VAL(A9),0,2)~", ")
  SQL.ADD(" Cantidad2Ori     ="~Fstr(VAL(A3),0,2)~", ")
  SQL.ADD(" ResultadoIndice  =0 ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
  SQL.ADD(" AND NrCuota="~FStr(FBN['NrCuota'],2,0)~" ")
  SQL.NEW
  SQL.EXEC

  *-- amortiza
  ACN(A3, val(A3)-VAL(A9))
Proximo


* Actualizo la Cantidad de Cuotas
SQL.ADD("Update "~DBO~".OPERACIONES SET ")
SQL.ADD(" Cuotas1= "~Fstr(VAL(B3),0,0)~" ")
SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
SQL.NEW
SQL.EXEC


