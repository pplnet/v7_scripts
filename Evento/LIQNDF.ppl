CrearDialogo
    Fecha1  :     'Fecha Op D' ;1;1;;;;;;;Fsys-30;
    Fecha2  :     'Fecha Op H' ;1;2;;;;;;;Fsys;
    Fecha3  :     'Fecha Vto D';2;1;;;;Dialogo.Fecha3<>0 y Dialogo.Fecha3 >=Fsys;'Debe Ingresar Fecha Vto Desde Valida';NO;FSys;
    Fecha4  :     'Fecha Vto H';2;2;;;;Dialogo.Fecha4<>0 y Dialogo.Fecha4 >= Dialogo.Fecha3;'Debe Ingresar Fecha Vto Hasta Valida';NO;FSys+30;    
    Especie1:     'Moneda Liquidacion' ;;1;;;;;;;
    NrOperacion1: 'Operacion';;;;;;Vacio(Dialogo.NrOperacion1) o [Fsys <= BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1) y 1<>SQL("SELECT 1 FROM "~DBO~".MTMDIARIO Where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha = "~IdxDate2(Fsys)~" ")];'Operacion Vencida/MTM-FIX generado';;;;;;;" Tipoop in('FXCF','FXVF')  "
    Mercado1:     'Mercado'
    Check1:       'Marca todas'
FinDialogo

if Not Ok
   Cancelar
endif
ACT(LS:1, VAR('MONNDF'))

SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Cliente1, O.Especie, O.ContraEspecie, O.FechaOp, O.FechaVto, O.Cantidad, O.TasaEspecie, O.TipoTasa, O.Book1, O.Book2, ")   
SQL.ADD("       O.Arancel4, O.FechaAltaSisExterno, O.FechaUltCupon, O.Mercado2, O.Mercado4, O.MercadoRB, O.Cuenta3, O.Cuenta4, O.FechaVto2,")
SQL.ADD("       O.Arancel3, O.Sector1, O.Sector2, O.Vehiculo1, IsNull(O.Lotes,0) as DiasAnt, O.TablaFeriados1, O.EsCaucionado as HabCorr, ContraEspecie2 ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".MERCADOS M  ")   
SQL.ADD(" WHERE O.Tipoop in('FXCF','FXVF')")   
SQL.ADD("   AND O.Mercado4=M.Codigo ")   
SQL.ADD("   AND M.Regulado='NO' ")
SQL.ADD("   and Not Exists( ")
SQL.ADD("                  SELECT 1 FROM "~DBO~".MTMDIARIO MT1 ")
SQL.ADD("                   WHERE MT1.Fecha="~IdxDate2(Fsys)~" ")
SQL.ADD("                     and MT1.NrOperacion=O.NrOperacion)")
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("   AND O.NrOperacion='"~Dialogo.NrOperacion1~"'")
ELSE
   If Not (Dialogo.Fecha1=0 and Dialogo.Fecha2=0)
      SQL.ADD("   AND (O.FechaOp>="~IdxDate2(Dialogo.Fecha1)~" and O.FechaOp<="~IdxDate2(Dialogo.Fecha2)~")  ")
   Endif
   SQL.ADD("   AND (O.FechaVto>="~IdxDate2(Dialogo.Fecha3)~" and O.FechaVto<="~IdxDate2(Dialogo.Fecha4)~")  ")
   if NoVacio(Dialogo.Mercado1)
      SQL.ADD("   AND Mercado4='"~Dialogo.Mercado1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD("   AND O.TasaEspecie='"~Dialogo.Especie1~"'")
   endif
ENDIF
Watch(sql.Batch)

* Cantidad de ops
acn(ca:1,0)
Recorrer SQL
    if Dialogo.Check1=1
       acn(a:fac,1)
    else
       acn(a:fac,0)
    endif    
    act(b:fac,FBN['NrOperacion'])
    act(c:fac,FBN['Cliente1'])
    act(d:fac,FBN['Especie'])
    act(e:fac,FBN['ContraEspecie'])
    act(f:fac,FBN['FechaOp'])
    acd(g:fac,FBN['FechaVto'])
    act(h:fac,FBN['TasaEspecie'])
    act(i:fac,FBN['Mercado2'])
    act(j:fac,FBN['Cuenta4'])
    act(k:fac,FBN['Cuenta3'])
    act(l:fac,FBN['Mercado4'])    
    acn(m:fac,FBN['Cantidad'])
    act(n:fac,FBN['TipoOp'])
    act(o:fac,FBN['Book1'])      
    act(v:fac,FBN['Vehiculo1'])
    acd(w:fac,FBN['FechaVto2'])    
    act(z:fac,FBN['ContraEspecie2'])
    ** VTXT1
    act(aa:fac,BuscarCampo('MERCADOS','Regulado','Codigo',Val(l:FAC)))
    ** VTXT2
    act(ab:fac,IIF(EQSTR(Val(aa:fac),'NO'),Val(h:FAC),Val(e:FAC)))
    ** VTXT12
    act(ac:fac,BuscarCampo('MERCADOS','Netea','Codigo',Val(i:fac)))
    ** VTXT5 
    act(ae:fac,IIF(NoVacio(Val(o:fac)),QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente='"~IIF(EqStr(Val(ac:fac),'SI'),QUERY("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(i:fac)~"' "),Val(c:fac))~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(ab:fac)~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and  "~IIF(NOT Eqstr(Val(ac:fac),'SI')," Mercado='"~Val(i:fac)~"' "," Mercado IN ('BCRA','AC','MC','SWIFT') ")~" and (TiposOperacion is NULL or TiposOperacion like '%"~Val(n:fac)~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")) )
    ** VCAN2
    acn(ad:fac,IIF(NoVacio(Val(o:fac)),IIF(NoVacio(Val(ae:fac)),Elementos(Val(ae:fac)),0)))

    acd(ag:fac,FBN['FechaVto'])
    acn(ah:fac,BuscarLista(FBN['TasaEspecie'],Val(ls1))-1)
    act(ai:fac,FBN['Mercado2'])
    act(aj:fac,FBN['Cuenta4'])
    act(ak:fac,FBN['Cuenta3'])
    acn(al:fac,fbn('DiasAnt'))
    act(am:fac,fbn['TablaFeriados1'])
    act(an:fac,fbn['HabCorr'])
    act(ao:fac,FBN['Book1']) 
    acd(aw:fac,FBN['FechaVto2'])        
    act(az:fac,FBN['ContraEspecie2'])        
    if Eqstr(FBN['MercadoRB'],'1')
        acd(bg:fac,FBN['FechaAltaSisExterno'])
        act(bh:fac,FBN['Arancel4'])
        act(bi:fac,FBN['TipoTasa'])
        act(bj:fac,FBN['Sector1'])        
        act(bk:fac,FBN['Sector2'])
        act(bo:fac,FBN['Book2'])
        acd(bw:fac,FBN['FechaUltCupon'])        
        act(bz:fac,FBN['Arancel3'])        
    ENDIF
    scn(ca:1,1)
Proximo

If Val(ca:1)>0 
