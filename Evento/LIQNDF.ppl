*           'Nvo.Esp.Fix'           ;az:1..az:Fac ;Val(a:FLB)=1;;;70 ;TABLA;'ESPECIES';'Codigo';'Codigo;Nombre';"Codigo in (Select EspecieFIX from "~DBO~".MERCADOS where Codigo = '"~Val(l:FLB)~"')";RGB(180,180,193);
           'Nvo.Esp.Fix'           ;az:1..az:Fac ;Val(a:FLB)=1;;;70 ;TABLA;'ESPECIES';'Codigo';'Codigo;Nombre';;RGB(180,180,193);           
           'Nvo.M.Liq.'            ;ai:1..ai:Fac ;Val(a:FLB)=1;;;60 ;TABLA;'MERCADOS';'Codigo';'Codigo;Descripcion';"TipoNegocio Like '%M%' ";RGB(180,180,193);IIF(EqStr(Val(h:FLB),ItemLista(Val(LS:1), val(ah:FLB)+1)),Val(i:FLB),MercadoDef(ItemLista(Val(LS:1), val(ah:FLB)+1)));NO;
           'Nvo. Book'             ;ao:1..ao:Fac ;Val(a:FLB)=1;;;70 ;TABLA;'BOOKS';'Codigo';'Codigo;Descripcion';;RGB(180,180,193);
