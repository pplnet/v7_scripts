           'Nva.Cta.CLI'           ;aj:1..aj:Fac ;SI;Val(a:FLB)=1 y Vacio(Val(aj:FLB)) o [[[CLIENTECUENTA(Val(c:FLB),Val(aj:FLB)) y EqStr(Val(ac:FLB),'NO')] o [CLIENTECUENTA(Val(v:FLB),Val(aj:FLB)) y EqStr(Val(ac:FLB),'SI')]] y ESPECIECUENTA(Val(ab:FLB),Val(aj:FLB)) y EqStr(Val(i:FLB), BuscarCampo('CUENTAS','Mercado','Codigo',Val(aj:FLB)))];'Nueva Cuenta Cliente Invalida' ;80 ;TABLA;'CUENTAS';'Codigo';'Codigo;Nombre';"Cliente = '"~IIF(EqStr(BuscarCampo('MERCADOS','Netea','Codigo',Val(i:FLB)),'SI'),QUERY("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(I:FLB)~"' "),Val(C:FLB))~"' and (Especies Like '%MONEDA%' or Especies Like '%"~IIF(EQSTR(BuscarCampo('MERCADOS','Regulado','Codigo',Val(l:FLB)),'NO'),Val(h:FLB),Val(e:FLB))~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and (TiposOperacion is NULL or TiposOperacion like '%"~Val(N:FLB)~"|%') and Mercado='"~Val(I:FLB)~"' ";RGB(180,180,193);IIF(NoVacio(Val(o:FLB)),IIF(1<=Val(ad:FLB),ItemLista(Val(ae:FLB),1),VAR('CTAMOD23')));NO;
           ** Cuenta3 - La validacion nofunciona
