           'Nva.F.FIX.'            ;aw:1..aw:Fac ;Val(a:FLB)=1;Val(a:FLB)=0 O [EsHabil(val(aw:FLB)) y [SQL("Select 1 from "~DBO~".MTMDIARIO M1 where M1.NrOperacion = '"~Val(b:FLB)~"' and M1.Fecha  >= '"~IdxDate(Val(aw:FLB))~"'  ") <>1]] ;'Fecha Inválida';80 ;FECHA;RGB(180,180,193)           
           'Nva.Mon.Liq.'          ;ah:1..ah:Fac ;Val(a:FLB)=1;Val(a:FLB)=0 O NoVacio(Val(ah:FLB));'Moneda inválida';50 ;COMBO;Val(LS:1);RGB(180,180,193)
