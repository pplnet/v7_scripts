sql.add("   AND P.Fecha IN (Select Max(Fecha) From "~Dbo()~".POSICIONES P1 ")
sql.add("      Where P1.Especie = P.Especie ")
sql.add("      AND P1.Vehiculo = P.Vehiculo ")
sql.add("      AND P1.Cliente = P.Cliente ")
sql.add("      AND P1.NrSaldo = P.NrSaldo ")
sql.add("      AND P1.Book = P.Book ")
sql.add("      AND P1.Cupon = P.Cupon ")
sql.add("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
sql.add("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
sql.add("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
sql.add("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
sql.add("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
sql.add("      AND (P1.Estrategia = P.Estrategia) ")
sql.add("      AND P1.Fecha <= '"~IdxDate(&fechapospartida)~"') ")
