Sqladd(" Select T.NrTrans, T.Especie4 Moneda, T.Vehiculo1, T.Cupon1, T.Fecha1, T.Precio2 PorRenta, T.Precio1+T.Precio3 PorAmort, ")
Sqladd(" CASE WHEN M.NrSaldo = "~Var('BLOQMAE')~" THEN 'GTIAMAE' WHEN M.NrSaldo = "~Var('BLOQGROFEX')~" THEN 'GTIAROFEX' ELSE 'CARTERA' END Saldo, ")
Sqladd(" M.Cantidad, MA.Codigo CodAsi, T.Cambio2 VT, M.Cliente, C.Jerarquia,T.Especie Especie, 'TIC' TipoOp, C.CategDepositante, ")
Sqladd(" T.Especie4 ContraEspecie, T.Especie2 EspecieCupon, E.MonedaEmision, E.Tipo TipoEspecie, ")
Sqladd(" Case When '"~&usapartidas~"' = 'SI' Then '"~&booktrd~"' Else '' END Book1, ")
Sqladd(" M.NrSaldo, E.Issuer, M.Cliente Cliente1, ")
Sqladd(" E.Fecha FMaduracion, T.Fecha1 FCorte, M.Cuenta CuentaCustodia, '' Concepto, E.VTeorico, T.Cupon1 CuponActual ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T ")
Sqladd("       INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON  T.NrTrans = M.NrOperacion and T.Especie2 = M.Especie")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON T.TipoTr2 = MA.TipoTr2  ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON C.Codigo  = M.Cliente ")
Sqladd("       INNER JOIN dbo.ESPECIES E ON E.Codigo  = T.Especie ")
Sqladd(" Where T.TipoTr2 = 'CUPON' ")
Sqladd(" AND MA.TipoAsiento = '"~Val(ta:1)~"' ")
Sqladd(" AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND T.NrTrans IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")
Sqladd(" ORDER BY T.NrTrans, M.Cuenta ")
