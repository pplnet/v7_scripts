Sqladd(" Select T.NrTrans, E.Alias9 Especie, T.Vehiculo1, T.Cupon1, T.Fecha1, M.NrSaldo, ")
Sqladd(" MA.Codigo CodAsi, T.Especie4 Moneda,M.Cliente, C.Jerarquia, ")
Sqladd(" 'TIC' TipoOp, C.CategDepositante,T.Cuenta1 Cuenta,T.Especie4 as ContraEspecie, ")
Sqladd(" M.Cantidad Cantidad, M.Cuenta Cuenta1, E.MonedaEmision, M.NrGrupo, E.Issuer, M.Cliente Cliente1, M.Mercado, T.PrecioEj Cotizacion, ")
Sqladd(" Case When '"~&usapartidas~"' = 'SI' Then '"~&booktrd~"' Else '' END Book1, ")
Sqladd(" T.Cuenta1 Cuenta2, ")
Sqladd(" T.Cantidad12, T.Cantidad13, E.Tipo TipoEspecie,'' Concepto, T.Cupon1 CuponActual, M.Book CuentaCustodia ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T ")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON T.TipoTr2 = MA.TipoTr2 ")
Sqladd("       INNER JOIN "~Dbo()~".MOVEJECUTADOS M ON T.NrTrans = M.NrOperacion and M.Especie = T.Especie4 ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON M.Cliente = C.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".ESPECIES E ON E.Codigo = (SELECT Alias9 FROM "~Dbo()~".ESPECIES WHERE Codigo = T.Especie) ")
Sqladd(" Where T.TipoTr2 = 'LCUPON' ")
Sqladd(" AND MA.TipoAsiento = '"~Val(ta:1)~"' ")
Sqladd(" AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd(" AND M.NrSaldo = 1 ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND T.NrTrans IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")

Sqladd(" UNION ALL ")

Sqladd(" Select T.NrTrans, E.Alias9 Especie, T.Vehiculo1, T.Cupon1, T.Fecha1, M.NrSaldo, ")
Sqladd(" MA.Codigo CodAsi, T.Especie4 Moneda, M.Cliente, C.Jerarquia,  ")
Sqladd(" 'TIC' TipoOp,T.Cuenta1 Cuenta,C.CategDepositante,T.Especie4 as ContraEspecie, ")
Sqladd(" M.Cantidad Cantidad, M.Cuenta Cuenta1, E.MonedaEmision, M.NrGrupo, E.Issuer, M.Cliente Cliente1, M.Mercado, T.PrecioEj Cotizacion, ")
Sqladd(" Case When '"~&usapartidas~"' = 'SI' Then '"~&booktrd~"' Else '' END Book1, ")
Sqladd(" T.Cuenta1 Cuenta2, ")
Sqladd(" T.Cantidad12, T.Cantidad13, E.Tipo TipoEspecie,'' Concepto, T.Cupon1 CuponActual, M.Book CuentaCustodia ")
Sqladd(" From "~Dbo()~".TRANSACCIONES2 T ")
Sqladd("       INNER JOIN "~Dbo()~".MODELOSASIENTO MA ON T.TipoTr2 = MA.TipoTr2 ")
Sqladd("       INNER JOIN "~Dbo()~".MOVPENDIENTES M ON T.NrTrans = M.NrOperacion and M.Especie = T.Especie4 ")
Sqladd("       INNER JOIN "~Dbo()~".CLIENTES C ON M.Cliente = C.Codigo ")
Sqladd("       INNER JOIN "~Dbo()~".ESPECIES E ON E.Codigo = (SELECT Alias9 FROM "~Dbo()~".ESPECIES WHERE Codigo = T.Especie) ")
Sqladd(" Where T.TipoTr2 = 'LCUPON' ")
Sqladd(" AND MA.TipoAsiento = '"~Val(ta:1)~"' ")
Sqladd(" AND T.FechaCargaSys = '"~IdxDate(dialogo.fecha1)~"' ")
Sqladd(" AND T.Fecha1 >= '"~IdxDate(Val(fe:1))~"' ")
Sqladd(" AND M.NrSaldo = 1 ")
if (NoVacio(dialogo.listatabla1))
Sqladd(" AND T.NrTrans IN ("~Pipe2Comillas(dialogo.listatabla1)~") ")
endif
Sqladd(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~Val(vc:1)~"|%' ")
Sqladd(" AND MA.Habilitado = 'SI' ")

Sqladd(" ORDER BY T.NrTrans ")
