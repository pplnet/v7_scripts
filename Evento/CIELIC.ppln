mostrarcuadrodemensajes
creardialogo
fecha1: 'Fecha';1;;;;;dialogo.fecha1 >= Habiles(FSys(), -Var('FVALORMAX'), 'ARG') y dialogo.fecha1 <= FSys();'Fecha fuera de rango permitido';NO;FSys()
nroperacion1: 'TCPCEM';;;;;;;;;;;;;;"TipoOp in ('TCPCEM')"
lista1: 'Mercados';;;;;;;;;;Var('CIELICDEF');SQLSet("SELECT Codigo FROM "~Dbo()~".MERCADOS  ORDER BY Codigo ");SI
tipoop1: 'Tipo OP';;;;NO;NO;;;;;if (NoVacio(dialogo.nroperacion1), sql("SELECT TipoOp FROM "~Dbo()~".OPERACIONES  Where NrOperacion = '"~dialogo.nroperacion1~"' "), '')
check1: 'Procesa';;;;NO;NO;;;;1;
findialogo
if (not ok)
Cancelar()
endif

if (NoVacio(dialogo.nroperacion1) y not Eqstr(dialogo.tipoop1, 'TCPCEM'))
Cancelar()('La Operacion Seleccionada no es TCPCEM --> '~dialogo.tipoop1)
endif

if (dialogo.check1 = 1)
Message('Cerrando manifestaciones')
ejecutarevento('TMESTA', fecha1 = dialogo.fecha1, nroperacion1 = dialogo.nroperacion1, lista1 = dialogo.lista1)

Message('Generando movimientos de emisiones')
ejecutarevento('TCPMOV', fecha1 = dialogo.fecha1, nroperacion1 = dialogo.nroperacion1, lista1 = dialogo.lista1)

Message('Cerrando emisiones')
ejecutarevento('DECLAD', fecha1 = dialogo.fecha1, nroperacion1 = dialogo.nroperacion1, lista1 = dialogo.lista1)
else
Messagebox('No Procesa Eventos Auxiliares')
endif

Message('Pasando a terminal Manifestaciones x TCPCEM')
sql.add("Select OB.NrBit, ORD.NrOrden  ")
sql.add("  from ORDENES ORD, OPERACIONESBITS OB  ")
sql.add(" where ORD.NrOrden = OB.NrOperacion ")
sql.add("   and OB.Valor    = 1 ")
sql.add("   and OB.NrBit    not in (30,170) ")
sql.add("   and TipoOrden   = 'TMANIF' ")
sql.add("   and '2'         = (Select RB8 from OPERACIONES OP where OP.NrOperacion = ORD.NrOperacion1)")
recorrer sql
if (dialogo.check1 = 1)
Message('Pasa orden '~Fbn()['NrOrden']~' de Inst '~FStr(Fbn()['NrBit'], 1, 0)~' a Inst '~FStr(170, 1, 0))
ejecutarevento('CBOINS', string1 = Fbn()['NrOrden'], radio1 = 1, radio2 = 2, entero1 = Fbn()['NrBit'], entero2 = 170)
else
Messagebox('Pasa orden '~Fbn()['NrOrden']~' de Inst '~FStr(Fbn()['NrBit'], 1, 0)~' a Inst '~FStr(170, 1, 0))
endif
