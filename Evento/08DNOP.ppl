CrearDialogo
  NrTrans1 : 'NrTrans'  ;;;;;;;;;;;;;;"NrTrans IN (SELECT B.NrOperacion FROM "~DBO~".OPERACIONESBITS B WHERE B.NrOperacion = NrTrans AND B.NrBit = 70 AND B.Valor = '1') "
  Vehiculo1: 'Vehiculo' ;;;;;;;;;VAR('VEHICULODE')
  Check1: 'Lo llamo desde la Operacion';;;;NO;NO;;;;0
FinDialogo

IF NOT OK
   Cancelar
Endif

SQL.ADD(" SELECT DISTINCT T.Cliente1,T.Cliente2, T.Especie, T.Cantidad1 , T.Vehiculo1,          ")
SQL.ADD(" T.NrTrans, T.Fecha1 , T.Fecha2 , T.TipoTr2, E.Nombre, T.Cuenta1, T.Cuenta2,           ")
SQL.ADD(" T.Mercado1, T.Mercado2, T.CuentaContable1, T.CuentaContable2,                         ")
SQL.ADD(" T.ConceptoPago, T.Book1, T.Observaciones                                              ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B          ")
SQL.ADD(" WHERE  T.Especie  = E.Codigo                                                          ")
SQL.ADD(" AND    T.NrTrans  = B.NrOperacion                                                     ")
SQL.ADD(" AND    T.TipoTr2 IN  ('TRNOP','DENOP','RENOP')                                        ")
SQL.ADD(" AND    B.Valor = '1'                                                                  ")
SQL.ADD(" AND    B.NrBit = 111                                                                  ")
SQL.ADD(" AND    IsNull(T.CB6,0)='0'                                                            ")
SQL.ADD(" AND    IsNull(T.CB5,0)='1'                                                            ")

If NoVacio(Dialogo.NrTrans1)
   SQL.ADD(" AND  T.NrTrans = '"~Dialogo.NrTrans1~"'                                            ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                         ")
Endif

SQL.ADD(" ORDER BY T.Cliente1, T.TipoTr2                                                        ")

ACN(z:1, 0)
Recorrer SQL

  ACN(z:1, 1)

  ACT(a:fac, fbn('Cliente1')~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente1')) )
  ACT(b:fac, fbn('NrTrans') )
  ACT(c:fac, fbn('TipoTr2') )
  ACD(d:fac, fbn('Fecha2') )
  ACD(e:fac, fbn('Fecha1') )
  ACT(f:fac, fbn('Especie')~' - '~fbn('Nombre'))
  ACN(g:fac, fbn('Cantidad1'))

  ACT(m:fac, fbn('Cuenta1'))
  ACT(r:fac, fbn('Mercado1'))
  ACT(u:fac, fbn('CuentaContable1'))

  if INCLUIDO(fbn('TipoTr2'), 'TRNOP')

     ACT(m:fac, fbn('Cuenta1'))
     ACT(n:fac, fbn('Cuenta2'))
     ACT(r:fac, fbn('Mercado1'))
     ACT(s:fac, fbn('Mercado2'))
     ACT(u:fac, fbn('CuentaContable1'))
     ACT(v:fac, fbn('CuentaContable2'))
     ACT(h:fac, fbn('Cliente2')~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente2')) )
  Else

     ACT(n:fac, '' )
     ACT(s:fac, '' )
     ACT(v:fac, '' )
     ACT(h:fac, '' )

  Endif

  ACT(q:fac, fbn('Vehiculo1'))
  ACT(o:fac, fbn('Observaciones'))

  ACN(x:fac, 0)

Proximo

If Val(z:1)=0
   Cancelar('No se encontraron Movimientos no Operativos para Confirmar.')
Endif

CrearListBox ; 'MS Sans SerIf,8,'
   'Transaccion'       ; b1..b:fac   ;NO;SI;; 70;STRING;;RGB(232,232,255); 
   'TipoTr'            ; c1..c:fac   ;NO;SI;; 50;STRING;;RGB(232,232,255); 

   'FechaOp'           ; d1..d:fac   ;NO;SI;; 70;STRING;;RGB(232,232,255); 
   'FechaValor'        ; e1..e:fac   ;NO;SI;; 70;STRING;;RGB(232,232,255); 

   'Especie'           ; f1..f:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Cantidad'          ; g1..g:fac   ;NO;;;80 ;NUMERO;'##,###,###.##';RGB(232,232,255); 

   'Confirma'          ; x1..x:fac   ;SI;SI;; 30;CHECK ;RGB(255,255,213);

   'Cliente Dep.'      ; a1..a:fac   ;NO;SI;; 100;STRING;;RGB(232,232,255); 
   'Mercado Dep.'      ; r1..r:fac   ;NO;SI;; 80;STRING;;RGB(232,232,255); 
   'Cta. Dep '         ; m1..m:fac   ;NO;SI;; 80;STRING;;RGB(232,232,255); 
   'Cta.Contable Dep.' ; u1..u:fac   ;NO;SI;; 100;STRING;;RGB(232,232,255); 


   'Cliente Ret.'      ; h1..h:fac   ;NO;SI;; 100;STRING;;RGB(232,232,255); 
   'Mercado Ret.'      ; s1..s:fac   ;NO;SI;; 80;STRING;;RGB(232,232,255); 
   'Cta. Ret.'         ; n1..n:fac   ;NO;SI;; 80;STRING;;RGB(232,232,255); 
   'Cta.Contable Ret.' ; v1..v:fac   ;NO;SI;; 100;STRING;;RGB(232,232,255); 

   'Vehiculo'          ; q1..q:fac   ;NO;SI;;  70;STRING;;RGB(232,232,255); 

   'Observaciones'     ; o1..o:fac   ;SI;  ;;150;STRING;200;RGB(255,255,213); 

FinListBox

if not ok
   Cancelar('Evento Cancelado.')
Endif

Recorrer&i 1, fac


   If Val(x:&i)=1
      SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2  SET ")
      SQL.ADD(" CB5 = 0,                           ")
      SQL.ADD(" Observaciones = '"~Val(o:&i)~"'    ")
      SQL.ADD(" WHERE NrTrans  = '"~Val(b:&i)~"'   ")
      SQL.NEW
      SQL.EXEC
   Endif
Proximo