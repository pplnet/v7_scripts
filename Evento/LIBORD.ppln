Sqladd(" SELECT Mercado,Agente,OpSIOPEL,L.Fecha,L.Hora,Secuencia as NrOrden, ")
Sqladd("        FechaCarga,FechaOp,HoraOp,SecuenciaOp,TipoOpEv,TipoMov, ")
Sqladd("        FechaOr,HoraOr,SecuenciaOr,FechaHo,HoraHo,SecuenciaHo, ")
Sqladd("        Case When TipoMov = 'A' THEN 'Alta' When TipoMov = 'B' THEN 'Baja' Else 'Modif.' End as 'TipMov', ")
Sqladd("        Case When TipoOpOr = 'C' THEN 'Compra' When TipoOpOr = 'V' THEN 'Venta' When TipoOpOr = 'O' THEN 'Otras' Else '' End as 'TipoOp', ")
Sqladd("        Especie,Plazo,Cantidad,Precio, DatosEspecie,")
Sqladd("        TipoMod,Comitente,TipoModDe,ComitenteDe,NroOrdenMe, ")
Sqladd("        TipoOrd,NrOrdHo,NrOferta,MercadoMeOr,MercadoMeDe, ")
Sqladd("        UsrInput,L.Cupon,NrOperacionRef ")
Sqladd(" FROM "~Dbo()~".LIBORDENES L ")
if (NoVacio(dialogo.fecha1))
Sqladd(" Where L.Fecha >= '"~IdxDate(dialogo.fecha1)~"' ")
endif
if (NoVacio(dialogo.fecha2))
Sqladd(" AND  L.Fecha <= '"~IdxDate(dialogo.fecha2)~"' ")
endif
Sqladd(" ORDER BY 1")

recorrer sql
