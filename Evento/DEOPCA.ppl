*-- Anula las Operaciones relacionadas 
CrearDialogo
  NrOperacion1: 'Nr.Operacion:'
FinDialogo

If Not OK
  Cancelar
EndIf

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

ACN(z2, SQL("Select count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrSaldo = 1"))

if Val(z2)<>0
    Cancelar('La operacion Tiene liquidaciones')
EndIf

IF Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'|MMPV|MMP|MMFRN|MMFCMV|MMPSC|MMSCMV')
   EjecutarEvento('ANCABE',NrOperacion1=Dialogo.NrOperacion1)    
EndIf

ACT(A1,BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))
ACT(A2,VAR('OPEPARTIDA'))

IF Incluido(VAL(A1),VAL(A2))
   EjecutarEvento('ANITEM',NrOperacion1=Dialogo.NrOperacion1)    

EndIf


