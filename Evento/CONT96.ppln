Sqladd(" From "~Dbo()~".ASIENTOSCON A, "~Dbo()~".ASIENTOSCON1 A1, "~Dbo()~".MODELOSASIENTO M, "~Dbo()~".CONTABILIDAD C, "~Dbo()~".VEHICULOS V ")
Sqladd(" Where A.NrOperacion = '"~Val(nr:1)~"' ")
