Sqladd(" AND M.Codigo = A.Modelo ")
Sqladd(" AND C.Codigo = A1.Cuenta ")
Sqladd(" AND V.Codigo = A.Vehiculo ")
Sqladd(" AND (C.Alias = 'I' OR (C.Alias = 'DC' AND A1.Alias5 = 'DCI')) ")
Sqladd(" AND M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEVF'))~") ")
Sqladd(" AND (A.FechaValor > (Select Max(C.Fecha1) From "~Dbo()~".CUOTAS C ")
Sqladd("                   Where A.NrOperacion = C.NrOperacion ")
Sqladd("                   AND C.Fecha1 < '"~IdxDate(dialogo.fecha1)~"')) ")
