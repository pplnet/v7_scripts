MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;3;1;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
  Fecha2:       'Ult. Fin Mes'   ;;;;NO;NO;;;;FinDeMes(PriDeMes(Dialogo.Fecha1)-1)
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif

IF Dialogo.Radio1 = 2 O Dialogo.Radio1 = 4
    message('--- Asientos Cobros/Pagos NDF ---')
    ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))
    ACT(TA:1, Var('TIPASILNDF'))
    ACN(NA:1, Var('ASINUM'))
    ACT(VC:1, Dialogo.Vehiculo1)
    ACN(XX:1,0)
    SQL.ADD("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1,  O.Especie as EspBNA,")
    SQL.ADD("       MO.Cantidad*-1 as Cantidad, MA.Codigo CodAsi, C.Jerarquia, C.PaisDir, O.Book1,")
    SQL.ADD("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Mercado4, ")
    SQL.ADD("       T.Especie, O.TipoOp, O.NrOperacion, O.Cliente1 Cliente , T.Cuenta2 as Cuenta2,")
    SQL.ADD("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
    SQL.ADD("       (Select sum(MTM) from "~DBO~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' ) as AcumMTM, ")
    SQL.ADD("       (Select sum(MTMEspecie) from "~DBO~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'MTM') as AcumEspMTM, ")
    SQL.ADD("       (Select MTMEspecie from "~DBO~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'FIX') as EspFIX, ")
    SQL.ADD("       (Select sum(Case When DebitoCredito = 'DEB' Then Cantidad1 Else -1*Cantidad1 End) from "~DBO~".ASIENTOSCON1 AS1 Where AS1.NrOperacion = O.NrOperacion and AS1.NrUnicoAsiento in (Select NrUnicoAsiento from "~DBO~".ASIENTOSCON  Where Modelo='FXCVR' and Cuenta ='"~Var('CTADIFCBIO')~"')) as Revaluo ")
    SQL.ADD("  FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".MERCADOS M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS MO ")
    SQL.ADD(" WHERE O.TipoOp IN ('FXCF','FXVF') ")
    SQL.ADD("   AND O.NrOperacion = MO.NrOperacion ")
    SQL.ADD("   AND T.NrTrans = MO.NrTrans2 ")
    SQL.ADD("   AND MO.Especie = O.TasaEspecie ")
    SQL.ADD("   AND MO.NrSaldo = 1 ")
    SQL.ADD("   AND T.Especie = O.TasaEspecie ")
    SQL.ADD("   AND C.Codigo  = O.Cliente1 ")
    SQL.ADD("   AND MA.TipoAsiento = '"~Var('TIPASILNDF')~"' ")
    SQL.ADD("   AND T.TipoTr2 in ('RET','DEP') ")
    SQL.ADD("   AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   AND T.Fecha2 >= '"~IdxDate(val(FE:1))~"' ")
    SQL.ADD("   AND O.Mercado4 = M.Codigo ")
    SQL.ADD("   AND M.MTM          = 0 ")
    SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    watch (SQL.batch)
    Recorrer SQL
      ACD(FV:1, fbn('Fecha'))
      ACD(FD:1, Dialogo.Fecha1)
      ACT(VH:1, fbn('Vehiculo1'))
      ACT(TO:1, fbn('CodAsi'))
      ACT(TI:1, fbn('TipoOp'))
      ACT(NR:1, fbn('NrOperacion'))
      ACN(CO:1, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo='"~fbn('EspBNA')~"' and Fecha="~IdxDate2(fbn('Fecha'))~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' "))
      ACN(NO:1, Round(iif(Eqstr(fbn('Especie'),Var('MONELOCA')),fbn('Cantidad'),fbn('Cantidad')*Val(CO:1)),2))
      ACN(RE:1, fbn('AcumMTM')+((fbn('EspFIX')-fbn('AcumEspMTM'))*Val(CO:1)))
      ACN(RV:1, fbn('Revaluo'))
      If Val(RE:1) > 0
         ACN(RE:1,Round(Val(RE:1)+Val(RV:1),2))
      Else
         ACN(RE:1,Round(Val(RE:1)-Val(RV:1),2))
      Endif    
      *ACN(RE:2, Round(iif(ABS(val(NO:1))>ABS(val(RE:1)),ABS(val(NO:1))-ABS(val(RE:1)),ABS(val(RE:1))-ABS(val(NO:1))),2))  
      ACN(RE:2, Round(iif((Val(NO:1)<0 y Val(RE:1)>0) o (Val(NO:1)>0 y Val(RE:1)<0),ABS(val(RE:1))+ABS(val(NO:1)),IIF(ABS(val(NO:1))>ABS(val(RE:1)),ABS(val(NO:1))-ABS(val(RE:1)),ABS(val(RE:1))-ABS(val(NO:1)))),2))
      If EqStr(fbn('Mercado4'),Var('MERROFEX'))
         ACT(CT:1,var('RDOROFEX'))
      Else
         ACT(CT:1,SQL("Select Cuenta from "~DBO~".RELACIONCUENTA   where Book = '"~fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~fbn('TipoOp')~"%' ")) 
      Endif

      ***---(.'GENASIENTO'.)
      ACN(CK:1, 0)
      IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
      ENDIF
      let &codAsi fbn('CodAsi')
      IF Val(CK:1) = 0
        Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(&codAsi, fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,Fsys,Dialogo.Fecha1)
        SQL.EXEC
      ENDIF
    Proximo
ENDIF