creardialogo
modeloasiento1: 'Modelo Origen';;;;;;NoVacio(dialogo.modeloasiento1);'Elegir un Modelo Origen';NO;;
string:'Item Origen';;;;;;NoVacio(dialogo.string) y Num(dialogo.string) > 0;'Nro de Item debe ser mayor a cero';NO;;
modeloasiento2: 'Modelo Destino';;;;;;NoVacio(dialogo.modeloasiento2);'Elegir un Modelo Destino';NO;;
string2:'Item Destino';;;;;;NoVacio(dialogo.string2) y Num(dialogo.string2) > 0 y not Incluido(dialogo.string2, SQLSet("Select NrItem FROM "~Dbo()~".MODELOSASIENTO1 Where Modelo  = '"~dialogo.modeloasiento2~"' "));iif (Num(dialogo.string2) > 0, 'El Item ya existe en el Modelo '~dialogo.modeloasiento2, 'Nro de Item debe ser mayor a cero');NO;;Query("SELECT Max(NrItem) + 1 FROM "~Dbo()~".MODELOSASIENTO1 Where Modelo  = '"~dialogo.modeloasiento2~"'  ");
findialogo

if (not ok)
Cancelar()
endif

if (Query("Select count(1) from "~Dbo()~".MODELOSASIENTO1 where Modelo  = '"~dialogo.modeloasiento1~"' and NrItem = '"~dialogo.string~"' ") = 0)
Cancelar('El Item '~dialogo.string~' no pertenece al modelo '~dialogo.modeloasiento1)
endif


Act(ca:1, "'"~dialogo.string2~"'")

Message('Copiando Item en el Modelo '~dialogo.modeloasiento2~'   ...')


Sqladd("INSERT INTO "~Dbo()~".MODELOSASIENTO1 ")
Sqladd("(Modelo,NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,Alias3,Detalle, ")
Sqladd(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3,  ")
Sqladd(" CC1,MN1,MN2,MN3,AL1,AL2,AL3,CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Book, Book1, Bk1)  ")
Sqladd("Select '"~dialogo.modeloasiento2~"' Modelo, "~dialogo.string2~" NrItem,CuentaContable,FormaCalculo1,FormaCalculo2,CondicionValidez,DebitoCredito,Moneda1,Moneda2,Alias1,'"~Val(ca:1)~"' Alias3,Detalle, ")
Sqladd(" FormaCalculo3, Moneda3, Alias2, Alias4, Alias5, CentroCosto, CuentaContable1, Alias6, Alias7, Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3, ")
Sqladd(" CC1,MN1,MN2,MN3,AL1,AL2,AL3,CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Book, Book1, Bk1  ")
Sqladd("from "~Dbo()~".MODELOSASIENTO1 Where Modelo= '"~dialogo.modeloasiento1~"' and NrItem = "~FStr(Num(dialogo.string), 0, 0)~" ")

Sqlnew()
Sqlexec()

Messagebox('Copia Finalizada ')
