SQL.ADD("Select Count(*) as pp from "~DBO~".EXCEPCIONES E, "~DBO~".TIPOSEXCEPCION T ")
SQL.ADD("where  E.NrOperacion='"~DIALOGO.NrOperacion1~"' and E.Tipo = T.Codigo and ")

*-- para exceco de crdito ------
IF dialogo.Radio1=0
  SQL.ADD(" T.Tipo='C'")
ENDIF

*-- para exceco de Posici¢n  ------
IF dialogo.Radio1=1
  SQL.ADD(" T.Tipo='P'")
ENDIF

*-- para exceco de crdito y Posici¢n------
IF dialogo.Radio1=2
  SQL.ADD(" (T.Tipo='C' or T.Tipo='P') ")
ENDIF



