modoreproceso(sindialogo)
creardialogo
fecha1:'Fecha Desde';1;1;;;;dialogo.fecha1 <> 0 y (dialogo.fecha1 = dialogo.fecha2 o dialogo.fecha1 < dialogo.fecha2);'Fecha Desde Invalida';NO;PriDeMes(FSys());
fecha2:'Fecha Hasta';1;2;;;;dialogo.fecha2 <> 0 y (dialogo.fecha2 = FSys() o dialogo.fecha2 < FSys());'Fecha Hasta Invalida';NO;FSys();
cliente1:'Cliente';;1;;;;
nroperacion1:'Operacion';;1;;;;Vacio(dialogo.nroperacion1) o Incluido(dialogo.nroperacion1, SQLSet(" Select NrOperacion From "~Dbo()~".OPERACIONES Where TipoOp in ('TIDE','TIPO','TICT','TICO') and CB2=1  "));'Debe ingresar una Operacion Valida';NO;;;;;;"TipoOp in ('TIDE','TIPO','TICT','TICO') and CB2=1"
findialogo

if (not ok)
Cancelar()
endif

sql.add("Select O.NrOperacion, Cliente1, TipoOp,FechaOp, FechaVto, Cantidad, Especie,Totalintereses, Precio1, Plazo, DiasAnio, Precio2 ")
sql.add("from "~Dbo()~".OPERACIONES O, "~Dbo()~".OPERACIONESBITS B")
sql.add("where O.NrOperacion = B.NrOperacion")
sql.add("and O.FechaVto > '"~IdxDate(FSys())~"' ")
if (NoVacio(dialogo.nroperacion1))
sql.add("and O.NrOperacion = '"~dialogo.nroperacion1~"' ")
else
if (NoVacio(dialogo.cliente1))
sql.add("and O.Cliente1 = '"~dialogo.cliente1~"' ")
endif
sql.add("and O.FechaOp >= '"~IdxDate(dialogo.fecha1)~"' and O.FechaOp <= '"~IdxDate(dialogo.fecha2)~"'")
endif
sql.add("and TipoOp in ('TIDE','TIPO','TICT','TICO') and CB2=1 and (CB8 Is Null or CB8='' or CB8='0') ")
sql.add("and (B.NrBit in ('10','70') and B.Valor = '1')  ")
Watch(sql.batch)

recorrer sql

Acn(q:fac, 0)
Act(a:fac, Fbn()['Cliente1'])
Act(b:fac, Fbn()['NrOperacion'])
Act(c:fac, Fbn()['TipoOp'])
Act(d:fac, Fbn()['Especie'])
Acd(e:fac, Fbn()['FechaOp'])
Acd(f:fac, Fbn()['FechaVto'])
Acd(g:fac, FSys())
Acn(h:fac, Fbn()['Cantidad'])
Acn(i:fac, Fbn()['TotalIntereses'])
Acn(k:fac, Val(g:fac) - Val(e:fac))
Acn(l:fac, iif (Fbn()['DiasAnio'] = 0, 36000, 36500))
Acn(m:fac, Fbn()['Precio1'])
Acn(j:fac, Val(h:fac) * Val(m:fac) * Val(k:fac) / Val(l:fac))
Acn(p:fac, Fbn()['Precio2'])

Scn(ca:1, 1)
proximo

if (Val(ca:1) > 0)
crearlistbox;'Arial,8,';'Precancelacion Prestamos y Plazos Fijos'
'OK';q:1..q:fac;;;;40;check;RGB(255, 255, 213)
'Cliente';a:1..a:fac;NO;;;70;string;;
'Nro.Op.';b:1..b:fac;NO;;;60;string;;
'Tipo   ';c:1..c:fac;NO;;;50;string;;
'Especie ';d:1..d:fac;NO;;;70;string;;
'Fecha Op';e:1..e:fac;NO;;;110;fecha;;
'Fecha Vto';f:1..f:fac;NO;;;110;fecha;;
'VN';h:1..h:fac;NO;;;100;numero;'###,###,###,###.##';
'Tasa';m:1..m:fac;NO;;;100;numero;'###.####';
'Fecha Precan';g:1..g:fac;SI;Val(g:flb) < Val(f:flb) y Val(g:flb) >= FSys();'Fecha Precan invalida';110;fecha;RGB(255, 255, 213)
'Plazo Precan';k:1..k:fac;NO;;;60;numero;'####';;Val(g:flb) - Val(e:flb)
'Interes Actual VN';i:1..i:fac;NO;;;120;numero;'###,###,###,###.#######';;
'Interes Precan ';j:1..j:fac;NO;;;120;numero;'###,###,###,###.#######';RGB(232, 232, 255);Val(h:flb) * Val(m:flb) * Val(k:flb) / Val(l:flb)
finlistbox


if (ok)
recorrer&i 1, Fac()
if (Val(q:&i) = 1)
Message('Precancelando Operacion'~Val(b:&i))
sql.add(" Update "~Dbo()~".OPERACIONES ")
sql.add(" Set FechaVto = '"~IdxDate(Val(g:&i))~"', ")
sql.add("  FechaVto2 = '"~IdxDate(Val(f:&i))~"', ")
sql.add("  Plazo = "~FStr(Val(k:&i), 0, 0)~", ")
sql.add("  TotalIntereses = "~FStr(Val(j:&i), 0, 7)~", ")
sql.add("  TotalBrutoCli3 = "~FStr(Val(j:&i) * Val(p:&i), 0, 4)~" ")
sql.add(" Where NrOperacion = '"~Val(b:&i)~"' ")
sql.new
sql.exec

sql.actualizarmovimientos4(Val(b:&i), SI, NO, NO, NO, SI, NO)
sql.exec

ejecutarevento('CIEINT', vehiculo1 = Var('VEHICULODE'), fecha1 = FSys(), check1 = 1, nroperacion1 = Val(b:&i))

endif
proximo
endif
else
if (NoVacio(dialogo.cliente1))
Messagebox('El Cliente '~dialogo.cliente1~' no posee operaciones para precancelar')
else
Messagebox('No se encontraron operaciones para precancelar')
endif
endif
