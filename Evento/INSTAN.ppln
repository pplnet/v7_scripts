creardialogo
nroperacion1: '# Operación :'
precio1:'Inst. Anterior';;;;;;;;;0
precio2:'Inst. Nueva'

findialogo

if (not ok)
Cancelar()
endif

if (Query(" Select Count(1) From "~Dbo()~".OPERACIONESBITS Where NrOperacion = '"~dialogo.nroperacion1~"' AND NrBit="~FStr(dialogo.precio2, 0, 0)~" ") = 0)
Ejecutarevento('INSBIT', 'entero1', dialogo.precio2, 'nroperacion1', dialogo.nroperacion1)
endif


Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '0' ")
if (dialogo.precio1 <> 0)
Sqladd(" Where (NrOperacion = '"~dialogo.nroperacion1~"') and (NrBit = "~FStr(dialogo.precio1, 1, 0)~" ) ")
else 
Sqladd(" Where (NrOperacion = '"~dialogo.nroperacion1~"') ")
endif
Sqlnew()
Sqlexec()

Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd(" SET Valor = '1' ")
Sqladd(" Where (NrOperacion = '"~dialogo.nroperacion1~"') and (NrBit = "~FStr(dialogo.precio2, 1, 0)~" ) ")
Sqlnew()
Sqlexec()
