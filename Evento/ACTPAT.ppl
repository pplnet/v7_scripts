CrearDialogo
  Cliente1: 'Banco';;;;;;NoVacio(Dialogo.Cliente1) y DesciendeDeCliente(Dialogo.Cliente1,'BANCOS');'Debe Ingresar un Banco';NO;
FinDialogo
if Not OK
  Cancelar
endif

ACT(a:1, Dialogo.Cliente1)

CrearDialogo
  Cliente1 : 'Banco'        ;;;;NO;;;;;Val(a:1);
  Fecha1   : 'Fecha Balance';;;;;;;;;BuscarCampo('CLIENTES','FechaBal','Codigo',Dialogo.Cliente1);
  Cantidad1: 'Patrimonio'   ;;;;;;;;;BuscarCampo('CLIENTES','Patrimonio','Codigo',Dialogo.Cliente1);;;;'###,###,###,###.##';
  Cantidad2: 'RPC'          ;;;;;;;;;BuscarCampo('CLIENTES','RPC','Codigo',Dialogo.Cliente1);;;;'###,###,###.##';
FinDialogo
if Not OK
  Cancelar
endif


SQL.ADD(" UPDATE "~DBO~".CLIENTES ")
SQL.ADD(" SET FechaBal = '"~IdxDate(Dialogo.Fecha1)~"', Patrimonio = "~Dialogo.Cantidad1~", RPC = "~Dialogo.Cantidad2~" ")
SQL.ADD(" Where Codigo = '"~Dialogo.Cliente1~"' ")
SQL.NEW

SQL.EXEC
