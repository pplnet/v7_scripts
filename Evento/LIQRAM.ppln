if ((NoVacio(dialogo.vehiculo1)) y (not Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo()))) y (not Vacio(UsrVehiculos(UsuarioActivo()))))
Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
endif

Acn(za:01, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU')) + 100)

if (Vacio(dialogo.listatabla2))
Sqladd("SELECT DISTINCT M.Cliente, T2.NrTrans, T2.Cupon1, T2.Fecha1, ")
Sqladd("       CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ")
Sqladd("FROM "~Dbo()~".TRANSACCIONES2 T2, ")
Sqladd("     "~Dbo()~".CLIENTES C,        ")
Sqladd("     "~Dbo()~".MOVEJECUTADOS M    ")
Sqladd("WHERE T2.Especie   = '"~dialogo.especie1~"' ")
if (dialogo.entero1 <> 0)
Sqladd("  AND T2.Cupon1    =  '"~FStr(dialogo.entero1, 1, 0)~"' ")
endif
Sqladd("  AND T2.TipoTr2   = '"~Var('LCUPON')~"' ")
Sqladd("  AND T2.Vehiculo1 =  '"~dialogo.vehiculo1~"' ")
if (dialogo.fecha1 > 0 y dialogo.fecha3 > 0)
Sqladd("  AND T2.Fecha1 between '"~IdxDate(dialogo.fecha1)~"' and '"~IdxDate(dialogo.fecha3)~"' ")
endif
Sqladd("  AND M.Concepto  <> "~FStr(Val(za:01), 1, 0)~" ")
Sqladd("  AND M.Cliente = C.Codigo ")
Sqladd("  AND M.NrSaldo = 1      ")

if (NoVacio(dialogo.listatabla1))
Sqladd("  AND C.Codigo IN ("~Pipe2Comillas(dialogo.listatabla1)~")")
endif
Sqladd("  AND T2.NrTrans = M.NrOperacion ")

recorrer sql
