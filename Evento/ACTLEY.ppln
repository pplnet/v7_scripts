mostrarcuadrodemensajes
recorrer&k 1, 2
if (&k = 1)
Message('Actualizando Leyendas CEC Pendientes')
sql.add(" Update "~Dbo()~".MOVPENDIENTES ")
else
Message('Actualizando Leyendas CEC Ejecutadas')
sql.add(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
sql.add(" Set Leyenda = 'Vto. Comision CEC' ")
sql.add(" Where Leyenda like '%Comision Concert. Pmo. en Ctas. Locales%' ")
sql.add("    OR Leyenda like '%Comision Concert. PreFinanc. Export.%' ")
sql.add("    OR Leyenda like '%Vto.CEC%' ")
sql.add("    OR Leyenda like '%Comision CEC PostFinanc. Import.%' ")
sql.new
if (&k = 1)
sql.add(" Update "~Dbo()~".MOVPENDIENTES ")
else
sql.add(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
sql.add(" Set Leyenda = 'Costo Financiero CEC' ")
sql.add(" Where Leyenda like '%Imp_Cs_Fin_Comision Conc Pmo en Ctas Locales%' ")
sql.add("    OR Leyenda like '%Imp_Cs_Fin_Comision Concert PreFinanc Export%' ")
sql.add("    OR Leyenda like '%Imp_Cs_Fin_CEC%' ")
sql.add("    OR Leyenda like '%Imp_Cs_Fin_Comision CEN PostFinanc Import%' ")
sql.new
if (&k = 1)
Message('Actualizando Leyendas CEN Pendientes')
sql.add(" Update "~Dbo()~".MOVPENDIENTES ")
else
Message('Actualizando Leyendas CEN Ejecutadas')
sql.add(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
sql.add(" Set Leyenda = 'Vto. Comision CEN' ")
sql.add(" Where (Leyenda like '%Comision Neg. PreFinanc. Export%' ")
sql.add("    OR Leyenda like '%Vto.CEN%' ")
sql.add("    OR Leyenda like '%Comision CEN PostFinanc. Import.%' ")
sql.add("    OR Leyenda like '%Comision Neg. Pmo. en Cta. Off Shore%') ")
sql.add(" AND Leyenda Not Like '%IVA%' ")
sql.new
if (&k = 1)
sql.add(" Update "~Dbo()~".MOVPENDIENTES ")
else
sql.add(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
sql.add(" Set Leyenda = 'IVA Comision CEN' ")
sql.add(" Where Leyenda like '%IVA Comision Concert. PreFinanc. Export.%' ")
sql.add("    OR Leyenda like '%IVA CEN%' ")
sql.add("    OR Leyenda like '%IVA Comision CEN PostFinanc. Import.%' ")
sql.add("    OR Leyenda like '%IVA Comision Neg. Pmo. en Cta. Off Shore%' ")
sql.new
proximo
sql.exec


