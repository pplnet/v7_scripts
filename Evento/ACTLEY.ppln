recorrer&k 1, 2
if (&k = 1)
Message('Actualizando Leyendas CEC Pendientes')
Sqladd(" Update "~Dbo()~".MOVPENDIENTES ")
else
Message('Actualizando Leyendas CEC Ejecutadas')
Sqladd(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
Sqladd(" Set Leyenda = 'Vto. Comision CEC' ")
Sqladd(" Where Leyenda like '%Comision Concert. Pmo. en Ctas. Locales%' ")
Sqladd("    OR Leyenda like '%Comision Concert. PreFinanc. Export.%' ")
Sqladd("    OR Leyenda like '%Vto.CEC%' ")
Sqladd("    OR Leyenda like '%Comision CEC PostFinanc. Import.%' ")
Sqlnew()
if (&k = 1)
Sqladd(" Update "~Dbo()~".MOVPENDIENTES ")
else
Sqladd(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
Sqladd(" Set Leyenda = 'Costo Financiero CEC' ")
Sqladd(" Where Leyenda like '%Imp_Cs_Fin_Comision Conc Pmo en Ctas Locales%' ")
Sqladd("    OR Leyenda like '%Imp_Cs_Fin_Comision Concert PreFinanc Export%' ")
Sqladd("    OR Leyenda like '%Imp_Cs_Fin_CEC%' ")
Sqladd("    OR Leyenda like '%Imp_Cs_Fin_Comision CEN PostFinanc Import%' ")
Sqlnew()
if (&k = 1)
Message('Actualizando Leyendas CEN Pendientes')
Sqladd(" Update "~Dbo()~".MOVPENDIENTES ")
else
Message('Actualizando Leyendas CEN Ejecutadas')
Sqladd(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
Sqladd(" Set Leyenda = 'Vto. Comision CEN' ")
Sqladd(" Where (Leyenda like '%Comision Neg. PreFinanc. Export%' ")
Sqladd("    OR Leyenda like '%Vto.CEN%' ")
Sqladd("    OR Leyenda like '%Comision CEN PostFinanc. Import.%' ")
Sqladd("    OR Leyenda like '%Comision Neg. Pmo. en Cta. Off Shore%') ")
Sqladd(" AND Leyenda Not Like '%IVA%' ")
Sqlnew()
if (&k = 1)
Sqladd(" Update "~Dbo()~".MOVPENDIENTES ")
else
Sqladd(" Update "~Dbo()~".MOVEJECUTADOS ")
endif
Sqladd(" Set Leyenda = 'IVA Comision CEN' ")
Sqladd(" Where Leyenda like '%IVA Comision Concert. PreFinanc. Export.%' ")
Sqladd("    OR Leyenda like '%IVA CEN%' ")
Sqladd("    OR Leyenda like '%IVA Comision CEN PostFinanc. Import.%' ")
Sqladd("    OR Leyenda like '%IVA Comision Neg. Pmo. en Cta. Off Shore%' ")
Sqlnew()
