 CrearDialogo
    Cliente1 : 'Cliente'     ;;;;;;NoVacio(Dialogo.Cliente1);"Debe ingresar un Cliente";NO;;;;
    Cuenta1  : 'Cuenta'      ;;;;;;NoVacio(Dialogo.Cuenta1);"Debe ingresar una Cuenta";NO;;SQL("Select TOP 1 Codigo FROM "~DBO~".CUENTAS Where Cliente = '"~Dialogo.Cliente1 ~"' and (TipoCuenta = 'CC' or TipoCuenta = 'CA') and ISNULL(NoRemunerable,'NO') = 'NO'");;;;"Cliente = '"~ Dialogo.Cliente1 ~"' and (TipoCuenta = 'CC' or TipoCuenta = 'CA') and ISNULL(NoRemunerable,'NO') = 'NO'" ;;
    String3  : "Forma de cálculo"    ;;;;NO;;;;;;IIF(SQL("SELECT 1 FROM "~dbo~".CUENTAS WHERE Codigo = '"~Dialogo.Cuenta1~"' AND TEM = 'SI'") = 1,'TEM','TNA');;;;;;;
    String2  : 'Codigo Tasa' ;;;;NO;;;;;;SQL("SELECT CodigoTasa FROM "~DBO~".CUENTAS WHERE Codigo = '"~Dialogo.Cuenta1~"'");;;;;;;
    Especie1 : 'Moneda'      ;;;;NO;SI;;;;;ItemLista(SQL("SELECT Especies FROM CUENTAS WHERE Codigo= '"~Dialogo.Cuenta1~"'"),1)
    Fecha1   : 'Fecha'       ;;;;;;Dialogo.Fecha1 <= FSYS;'Fecha incorrecta';NO;;FSYS
FinDialogo
if not OK
    Cancelar
endif

* VALIDAR SI CLIENTE TIENE GRUPO ECONOMICO
ACN(ab:1,SQL("SELECT CASE WHEN EXISTS (SELECT 1 FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente = '"~Dialogo.Cliente1~"') THEN 1  ELSE 0 END "))

* OPERACIONES DE LA CUENTA DEL DIALOGO
SQL.ADD("SELECT O.Cliente1, O.Especie, O.Cuenta1, O.Cliente1, O.Precio1, O.Precio4, O.Cantidad, O.NrOperacion, C.CodigoTasa, C.Codigo, C.TipoCuenta, C.Comitente,  O.FechaOp, O.FechaVto, O.Plazo")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".OPERACIONESBITS B")
SQL.ADD(" WHERE O.Cuenta1 = C.Codigo ")
SQL.ADD("  AND O.TipoOp = 'MMCREM' ")
SQL.ADD("  AND O.Cliente1 = '"~Dialogo.Cliente1~"'")
SQL.ADD("  AND O.Cuenta1 = '"~Dialogo.Cuenta1~"'")
SQL.ADD("  AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'" )
SQL.ADD("  AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  AND C.TipoCuenta IN ('CA', 'CC') ")
SQL.ADD("  AND C.Comitente = '"~Var('VEHICULODE')~"'")
SQL.ADD("  AND O.Especie = '"~Dialogo.Especie1~"'")
SQL.ADD("  AND B.NrOperacion = O.NrOperacion")
SQL.ADD("  AND B.NrBit in(93,70) AND B.Valor = 1") 
if Eqstr(Dialogo.String3, 'TEM') 
    SQL.ADD("AND TEM = 'SI'")
else
    SQL.ADD("AND ISNULL(TEM, 'NO') = 'NO'")
endif 
    

Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACT(b:fac,SQL("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente = '"~Dialogo.Cliente1~"'"))
    ACT(c:fac,FBN['Cliente1'])
    ACT(d:fac,FBN['Cuenta1'])
    ACT(e:fac,FBN['Especie'])
    ACT(f:fac,FBN['CodigoTasa'])
    ACD(g:fac,FBN['FechaOp'])
    ACD(h:fac,FBN['FechaVto'])
    ACT(i:fac,FBN['Plazo'])
    ACT(j:fac,FBN['Cantidad'])
    ACT(k:fac,FBN['Precio1'])
    ACT(l:fac,FBN['Precio4'] - FBN['Precio1'])
    ACD(m:fac,Dialogo.Fecha1)
    ACN(n:fac, Dialogo.Fecha1 - FBN['FechaOp'])
    ACN(o:fac,1)
    SCN(p:1,1) 
Proximo


IF Val(ab:1) = 1
*OPERACIONES DEL CLIENTE DEL DIALOGO QUE NO SEAN DE LA CUENTA DEL DIALOGO
SQL.ADD("SELECT O.NrOperacion,Cuenta1, O.Cliente1, O.Precio1, O.Precio4, O.FechaVto, O.Cantidad, O.Especie, O.TipoOp, C.Codigo, C.Comitente, C.CodigoTasa, O.FechaOp, O.FechaVto, O.Plazo")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".OPERACIONESBITS B")
SQL.ADD(" WHERE C.Cliente= '"~Dialogo.Cliente1~"'")
SQL.ADD("  AND O.Cuenta1<>'"~Dialogo.Cuenta1~"'")
SQL.ADD("  AND O.TipoOp = 'MMCREM'")
SQL.ADD("  AND O.Cuenta1 = C.Codigo")
SQL.ADD("  AND C.TipoCuenta IN ('CA', 'CC')")
SQL.ADD("  AND C.Comitente = '"~Var('VEHICULODE')~"'")
SQL.ADD("  AND ISNULL(C.NoRemunerable, 'NO') = 'NO'")
SQL.ADD("  AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'" )
SQL.ADD("  AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  AND O.Especie = '"~Dialogo.Especie1~"'") 
SQL.ADD("  AND B.NrOperacion = O.NrOperacion")
SQL.ADD("  AND B.NrBit in(93,70) AND B.Valor = 1") 
if Eqstr(Dialogo.String3, 'TEM') 
    SQL.ADD("AND TEM = 'SI'")
else
    SQL.ADD("AND ISNULL(TEM, 'NO') = 'NO'")
endif 
Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACT(b:fac,SQL("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente = '"~Dialogo.Cliente1~"'"))
    ACT(c:fac,FBN['Cliente1'])
    ACT(d:fac,FBN['Cuenta1'])
    ACT(e:fac,FBN['Especie'])
    ACT(f:fac,FBN['CodigoTasa'])
    ACD(g:fac,FBN['FechaOp'])
    ACD(h:fac,FBN['FechaVto'])
    ACT(i:fac,FBN['Plazo'])
    ACT(j:fac,FBN['Cantidad'])
    ACT(k:fac,FBN['Precio1'])
    ACT(l:fac,FBN['Precio4'] - FBN['Precio1'])
    ACD(m:fac,Dialogo.Fecha1)
    ACN(n:fac,Dialogo.Fecha1 - FBN['FechaOp'])
    ACN(o:fac,1)
    SCN(p:1,1) 
Proximo


    *GRUPO ECONOMICO MENOS CLIENTE DEL DIALOGO
    SQL.ADD("SELECT O.NrOperacion, O.Cuenta1, O.Cliente1, O.Precio1, O.Precio4, C.Cliente, C.CodigoTasa, C.Comitente, O.FechaVto, O.Cantidad, O.Especie, O.TipoOp, O.FechaOp, O.Plazo")
    SQL.ADD("  FROM "~DBO~".CUENTAS C, "~DBO~".GRUPOSECONOMICOS G, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B")
    SQL.ADD(" WHERE C.Cliente= G.Cliente and C.Codigo = O.Cuenta1")
    SQL.ADD("  AND O.Cliente1 <> '"~Dialogo.Cliente1~"'")
    SQL.ADD("  AND C.Codigo<>'"~Dialogo.Cuenta1~"'")
    SQL.ADD("  AND O.TipoOp = 'MMCREM'")
    SQL.ADD("  AND C.TipoCuenta IN ('CA', 'CC')")
    SQL.ADD("  AND C.Comitente = '"~Var('VEHICULODE')~"'")
    SQL.ADD("  AND ISNULL(C.NoRemunerable, 'NO') = 'NO'")
    SQL.ADD("  AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'" )
    SQL.ADD("  AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  AND O.Especie = '"~Dialogo.Especie1~"'") 
    SQL.ADD("  AND G.Controlante=(SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente=(SELECT Cliente from "~DBO~".CUENTAS where Codigo='"~Dialogo.Cuenta1~"'))")
    SQL.ADD("  AND B.NrOperacion = O.NrOperacion")
    SQL.ADD("  AND B.NrBit in(93,70) AND B.Valor = 1") 
    if Eqstr(Dialogo.String3, 'TEM') 
        SQL.ADD("AND TEM = 'SI'")
    else
        SQL.ADD("AND ISNULL(TEM, 'NO') = 'NO'")
    endif 

Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACT(b:fac,SQL("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente = '"~Dialogo.Cliente1~"'"))
    ACT(c:fac,FBN['Cliente1'])
    ACT(d:fac,FBN['Cuenta1'])
    ACT(e:fac,FBN['Especie'])
    ACT(f:fac,FBN['CodigoTasa'])
    ACD(g:fac,FBN['FechaOp'])
    ACD(h:fac,FBN['FechaVto'])
    ACT(i:fac,FBN['Plazo'])
    ACT(j:fac,FBN['Cantidad'])
    ACT(k:fac,FBN['Precio1'])
    ACT(l:fac,FBN['Precio4'] - FBN['Precio1'])
    ACD(m:fac,Dialogo.Fecha1)
    ACN(n:fac,Dialogo.Fecha1 - FBN['FechaOp'])
    ACN(o:fac,1)
    SCN(p:1,1)
Proximo
ENDIF

If Val(h:1)=0
  Cancelar('No se encontraron Operaciones para Anular.')
Endif

CrearListBox ; 'Arial,8,'

   'Nr Operacion'                    ; a1..a:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Grupo Economico'                 ; b1..b:fac   ;NO;SI;;150;STRING;;RGB(232,232,255); 
   'Cliente'                         ; c1..c:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Cuenta'                          ; d1..d:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Moneda'                          ; e1..e:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
   'Codigo de tasa'                  ; f1..f:fac   ;NO;SI;;120;STRING;;RGB(232,232,255); 
   'Fecha Concertacion Original'     ; g1..g:fac   ;NO;SI;;210;FECHA ;;RGB(232,232,255); 
   'Fecha Vto Original'              ; h1..h:fac   ;NO;SI;;150;FECHA ;;RGB(232,232,255); 
   'Plazo Original'                  ; i1..i:fac   ;NO;SI;;120;NUMERO;'XXXX';RGB(232,232,255); 
   'Cantidad Original'               ; j1..j:fac   ;NO;SI;;150;NUMERO;;RGB(232,232,255);    
   'Tasa Original'                   ; k1..k:fac   ;NO;SI;;120;NUMERO;'XXXX.XXXXXX';RGB(232,232,255); 
   'Spread Original'                 ; l1..l:fac   ;NO;SI;;120;NUMERO;'XXXX.XXXXXX';RGB(232,232,255); 
   'Fecha Precancelacion'            ; m1..m:fac   ;NO;SI;;170;FECHA ;;RGB(232,232,255);
   'Plazo Nuevo'                     ; n1..n:fac   ;NO;SI;;170;NUMERO;'XXXX';RGB(232,232,255); 
FinListBox

if not OK
    Cancelar('Evento Cancelado.')
Endif

Recorrer&i 1, fac
  If Val(o:&i)=1      
     SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
     SQL.ADD("SET FechaVto = '"~IdxDate(Val(m:&i))~"' , Plazo= "~FSTR(Val(n:&i),1,0)~ " , Observac2 = 'B' , FechaPrecan = '"~IdxDate(Val(h:&i))~"'")
     SQL.ADD("Where NrOperacion = '"~Val(a:&i)~"' and TipoOp = 'MMCREM'")
     SQL.NEW
     EjecutarEvento('CBOINS', String1= Val(a:&i), Radio1=0, Radio2=1, Entero1=0, Entero2=92)
  Endif
Proximo

SQL.EXEC

