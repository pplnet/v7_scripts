creardialogo
fecha1:"Fecha Desde";;;;;;dialogo.fecha1 <> 0 y dialogo.fecha1 < FSys();'Debe Ingresar la Fecha Desde';NO;Habiles(FSys(), -1, 'ARG', SI)
fecha2:"Fecha Hasta";;;;;;dialogo.fecha2 >= dialogo.fecha1;'Debe Ingresar la Fecha Hasta';NO;FSys()
vehiculo1:'Vehiculo1';;;;;;NoVacio(dialogo.vehiculo1) y (Incluido(dialogo.vehiculo1, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'El Vehiculo Colocador es Invalido';NO;
vehiculo2:'Vehiculo2';;;;;;NoVacio(dialogo.vehiculo2) y (Incluido(dialogo.vehiculo2, UsrVehiculos(UsuarioActivo())) o Vacio(UsrVehiculos(UsuarioActivo())));'El Vehiculo Tomador es Invalido';NO;;;;
especie1:'Moneda';;;;;;NoVacio(dialogo.especie1) y DesciendeDeEspecie(dialogo.especie1, 'MONEDA');'Debe Ingresar una Especie Valida';NO;
precio1:'Tasa';;;;;;dialogo.precio1 <> 0;'Tasa Incorrecta';NO;;
string:'ListaEspecies';;;;NO;NO;NoVacio(dialogo.string);'No Existe el Par de Vehiculos';NO;;Query("SELECT ListaEspecies FROM "~Dbo()~".PARESVEHICULO  Where Estado='HAB' and ((Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"') or (Vehiculo1='"~dialogo.vehiculo2~"' and Vehiculo2='"~dialogo.vehiculo1~"')) ")
findialogo

if (not ok)
Cancelar()
endif

if (not Incluido(dialogo.especie1, dialogo.string))
Cancelar('La Especie no esta habilitada para el par de Vehiculos')
endif

SetFilaActual(1)

Acd(af1, dialogo.fecha1)

Acn(h2, 1)

Acn(aa2, DifDias(dialogo.fecha1, dialogo.fecha2, 'ARG', SI))

recorrer&i 1, Val(aa2) + 1

Acn(a1, 0)
Acn(a1, Query("SELECT Tasa from "~Dbo()~".TASASVEHICULO where ((Vehiculo1='"~dialogo.vehiculo1~"' and Vehiculo2='"~dialogo.vehiculo2~"') or (Vehiculo1='"~dialogo.vehiculo2~"' and Vehiculo2='"~dialogo.vehiculo1~"')) and Especie ='"~dialogo.especie1~"' and Fecha='"~IdxDate(Val(af1))~"' "))

if (Val(a1) = 0)
Message('Creando Tasa : '~Val(af1)~' ...')
Sqladd("INSERT INTO "~Dbo()~".TASASVEHICULO ")
Sqladd(" (Fecha,Vehiculo1,Vehiculo2,")
Sqladd(" Especie,Tasa) ")
Sqladd(" Values ")
Sqladd(" ('"~IdxDate(Val(af1))~"','"~dialogo.vehiculo1~"','"~dialogo.vehiculo2~"', ")
Sqladd(" '"~dialogo.especie1~"',"~FStr(dialogo.precio1, 0, 5)~") ")
Sqlnew()
Sqlexec()
else
break
endif

Acd(af1, Habiles(Val(af1), 1, 'ARG', SI))
proximo

if (Val(a1) <> 0)
Cancelar(' El par de Vehiculos Ya tenia tasa para el Dia '~Val(af1)~' ....!')
endif

