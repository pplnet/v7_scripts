MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1: 'Vehiculo' ;1;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  NrTrans1  :'Transaccion' ;;;;;;NoVacio(Dialogo.NrTrans1) ;'Transaccion Invalida';NO;;
FinDialogo

If Not Ok
  Cancelar
EndIf

If Not Eqstr(SQL(" Select Estado From "~DBO~".CHEQUES Where NrComprobante = '"~Dialogo.NrTrans1~"' "), 'PAG')
  Cancelar('La transaccion no tiene cheques pagados.')
Endif

SQL.ADD(" UPDATE "~DBO~".CHEQUES ")
SQL.ADD(" SET    Estado = 'ANU' ")
SQL.ADD(" Where  NrComprobante = '"~Dialogo.NrTrans1~"' ")
SQL.NEW

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
SQL.ADD(" Where  NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.ADD(" AND    NrBit       = 20 ")
SQL.NEW

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
SQL.ADD(" Where  NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.ADD(" AND NrBit= 25 ")
SQL.NEW

message('La transaccion pasa a la instancia ANULADAS.')

SQL.ADD(" INSERT INTO "~DBO~".MOVPENDIENTES ")
SQL.ADD(" SELECT * FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.NEW

SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.NEW
message('Los saldos se han desafectado.')

SQL.EXEC

