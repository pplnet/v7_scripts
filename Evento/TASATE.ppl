**-- TASATE: Carga Masiva de Tasas Terceros
* HOJAVISIBLE(SI)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")  
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))

SetFilaActual(1)

ACD(AF1,Dialogo.Fecha1)

* H2 Contador de Sin Saldo
ACN(H2,1)

SQL.ADD("SELECT  P.Vehiculo,P.Cliente,P.ListaEspecies FROM  "~DBO~".IMPTERCEROS P ")
SQL.ADD("Where Estado='HAB' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and P.Vehiculo='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and P.Vehiculo IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
SQL.ADD("Order By P.Vehiculo,P.Cliente")

Recorrer SQL

   DFA  
   Message('Pares de Vehiculos: '~FBN['Vehiculo']~'/'~FBN['Cliente']~'  ...')

   ACT(AV1,FBN['Vehiculo'])
   ACT(AV2,FBN['Cliente'])

   * Recupero las Especies contenidas en Pares de Vehiculo
   SQL.ADD("SELECT Codigo FROM  "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(FBN['ListaEspecies'])~") ") 

   * Displayo una vez cada Par de Vehiculos
   Recorrer SQL
      * H1=1 Si esta duplicado 
      ACN(H1,0)

      * Para que no se repita el par
      Recorrer&i  1,FAC-1
        IF EqStr(VAL(A:&i),VAL(AV2)) y EqStr(VAL(B:&i),VAL(AV1)) y EqStr(FBN['Codigo'],VAL(C:&i))
           * Encontre el Par Buscado
           ACN(H1,1)
           Break 
        ENDIF
      Proximo

      * Para que no se repita el par No Activos
      Recorrer&i  1,VAL(H2)
        IF EqStr(VAL(za:&i),VAL(AV2)) y EqStr(VAL(zb:&i),VAL(AV1)) y EqStr(FBN['Codigo'],VAL(zc:&i))
           * Encontre el Par Buscado
           ACN(H1,1)
           Break 
        ENDIF
      Proximo
  
      IF VAL(H1)=0
         ACT(a:fac, VAL(AV1))
         ACT(b:fac, VAL(AV2))
         ACT(c:fac, fbn['Codigo'])   

         ACD(AH1,0)

         * Verifico que tenga Minutas Diarias y no Minutas Mensuales
         *-- Parametros de la Funcion AV1: Vehiculo1 AV2: Cliente1 AF1: Fecha AE1: Especie
         SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.Cliente1,O.Especie  ")
         SQL.ADD("from "~DBO~".OPERACIONES O")
         SQL.ADD("where ((O.TipoOp='TEMD' and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"') or ")
         SQL.ADD("       (O.TipoOp='TEMIND' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"' ) or ")
         SQL.ADD("       (O.TipoOp='TEMINM' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"' )) ")
         SQL.ADD("and O.Vehiculo1='"~VAL(AV1)~"'  and O.Cliente1='"~VAL(AV2)~"' ")
         SQL.ADD("and O.Especie='"~FBN['Codigo']~"' ")
         SQL.ADD(" AND NOT EXISTS ")
         SQL.ADD(" (SELECT * ")
         SQL.ADD("from "~DBO~".OPERACIONES Op ")
         SQL.ADD("where Op.TipoOp='TEMIND' and Op.FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
         SQL.ADD("      and Op.Vehiculo1=O.Vehiculo1 and Op.Cliente1=O.Cliente1  and Op.Especie=O.Especie) ")
         SQL.ADD("Order By O.Vehiculo1,O.Cliente1,O.Especie ")
    
         Recorrer SQL       
            DFA
            ACN(AH1,1)

            ACT(AV1,FBN['Vehiculo1'])
            ACT(AV2,FBN['Cliente1'])

            Message('Saldos Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Cliente1']~' Especie:'~FBN['Especie']~' ...')

            *-- Parametros de la Funcion AV1: Vehiculo1 AV2: Cliente1 AF1: Fecha AE1: Especie
            ACT(AE1,FBN['Especie'])
 
            (.'SALDIATER'.)

            ACN(e:fac, VAL(Z1))
            ACT(d:fac, IIF(VAL(e:fac)<0,'COLOCA','TOMA'))
            ACN(e:fac, IIF(VAL(Z1)<0,-VAL(Z1),VAL(Z1)))
            ACN(f:fac, SQL("SELECT Tasa    from "~DBO~".TASASTERCEROS where Vehiculo='"~VAL(AV1)~"' and Cliente='"~VAL(AV2)~"' and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
         Proximo

         * No encontro el Mov. Diario => Busco el Mov. Mensual
         IF VAL(AH1)=0
            SQL.ADD("SELECT * ")
            SQL.ADD("from "~DBO~".OPERACIONES ")
            SQL.ADD("where TipoOp='TEMIND'  and Vehiculo1='"~VAL(AV1)~"'  and Cliente1='"~VAL(AV2)~"' ")
            SQL.ADD("and Especie='"~FBN['Codigo']~"' ")
            SQL.ADD("and FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
            SQL.ADD("Order By Vehiculo1,Cliente1,Especie ")

            Recorrer SQL
               DFA
               ACT(d:fac, IIF(FBN['MB3']=0,'COLOCA','TOMA'))
               ACN(e:fac, FBN['Cantidad'])
               ACN(f:fac, SQL("SELECT Tasa    from "~DBO~".TASASTERCEROS where Vehiculo='"~VAL(AV1)~"' and Cliente='"~VAL(AV2)~"' and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
               ACN(g:fac, 0)
               ACN(AH1,1)
            Proximo
         EndIf

         IF VAL(AH1)=0
            * Sin Saldo
            ACT(za:VAL(h2), VAL(AV1))
            ACT(zb:VAL(h2), VAL(AV2))
            ACT(zc:VAL(h2), fbn['Codigo'])   
            ACN(ze:VAL(h2), 0)
            ACT(zd:VAL(h2), 'Sin SALDO')
            ACN(zf:VAL(h2), SQL("SELECT Tasa  from "~DBO~".TASASTERCEROS where Vehiculo='"~VAL(AV1)~"' and Cliente='"~VAL(AV2)~"' and Especie ='"~FBN['Codigo']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
            ACN(zg:VAL(h2), 1)
            SCN(h2,1)
            DFA
         ENDIF
      Else
         DFA
      EndIf
   Proximo
Proximo

Recorrer&j 1,VAL(H2)-1
   ifa
   ACT(a:fac, VAL(za:&j))
   ACT(b:fac, VAL(zb:&j))
   ACT(c:fac, VAL(zc:&j))   
   ACN(e:fac, VAL(ze:&j))
   ACT(d:fac, VAL(zd:&j))
   ACN(f:fac, VAL(zf:&j))
   ACN(g:fac, VAL(zg:&j))
Proximo

ACN(k1,0) 

IF VAL(k1)<>2
   *-- Hay datos para mostrar
   Recorrer&j 1,1000
      CrearDialogo
        Fecha1    : "Fecha"        ;1;1;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;VAL(AF1)
        ListBox; 'Arial,8,N'; 460; 180
           'Vehiculo1'       ;a2..a:fac;NO;;;;70;STRING
           'Cliente1'        ;b2..b:fac;NO;;;;70;STRING
           'Especie'         ;c2..c:fac;NO;;;;40;STRING
           'Saldo'           ;e2..e:fac;NO;;;;70;NUMERO;'#,###,###,###.##'
           'Tipo'            ;d2..d:fac;NO;;;;60;STRING
           'Tasa'            ;f2..f:fac;  ;;;;50;NUMERO;'###.#####'
           'Clase'           ;g2..g:fac;NO;;;;40;COMBO;'Activo|Pasivo'
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      ACN(k1,0)

      Recorrer&i 2,FAC
         If Val(f:&i)=0          
            ACN(k1,0)
            ACN(k1,MessageBox("La Tasa '"~Val(a:&i)~"'/'"~Val(b:&i)~"'-'"~Val(c:&i)~"' Es Incorrecta. Continua? ",2,1))
            IF VAL(k1)=2
               Break
            EndIf 
         EndIf 
      Proximo

      IF VAL(k1)<>1 
         Break
      EndIf 
   Proximo

   IF VAL(k1)<>2

      *-- El primer renglon es de totales
      Recorrer&i 2,FAC

         If Val(f:&i)<>0 y NoVacio(VAL(a:&i))
            Message("Actualizando '"~Val(a:&i)~"'/'"~Val(b:&i)~"' - '"~Val(c:&i)~"' ... ")

            *-- Actualizo la Tabla de TASASTERCEROS
            ACN(h:&i,0)
            ACN(h:&i, SQL("SELECT Count(*) FROM "~DBO~".TASASTERCEROS Where Vehiculo='"~Val(a:&i)~"' and Cliente='"~Val(b:&i)~"' and Especie='"~Val(c:&i)~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))

            If VAL(h:&i)>0 
               *-- Update
               SQL.ADD("UPDATE "~DBO~".TASASTERCEROS Set Tasa="~Fstr(Val(f:&i),0,5)~" Where ")
               SQL.ADD(" Vehiculo='"~Val(a:&i)~"' and Cliente='"~Val(b:&i)~"' ")
               SQL.ADD(" and Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")            
               SQL.ADD(" and Especie='"~Val(c:&i)~"' ")      
               SQL.NEW
               SQL.EXEC
            ELSE
               SQL.ADD("INSERT INTO "~DBO~".TASASTERCEROS ")
               SQL.ADD(" (Fecha,Vehiculo,Cliente,")
               SQL.ADD(" Especie,Tasa) ")
               SQL.ADD(" Values ")
               SQL.ADD(" ('"~IdxDate(Dialogo.Fecha1)~"','"~Val(a:&i)~"','"~Val(b:&i)~"', ")
               SQL.ADD(" '"~Val(c:&i)~"',"~Fstr(Val(f:&i),0,5)~") ")
               SQL.NEW
               SQL.EXEC
            ENDIF
         Endif
      Proximo
   EndIf
EndIf
