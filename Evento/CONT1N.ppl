MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif


message('--- Asientos de Reclasificacion Deuda Descubiertos ---')

***---DI:1 = Nro. de dia Habil del mes a ejecutarse el evento
***---DI:2 = Fecha de ejecucion del evento
ACN(DI:1, SQL(" Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
ACN(x3, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
IF Val(DI:1) = 1
    ACN(DI:1, Trunc(Var('DIASCONT'),0))
ENDIF
IF Val(DI:1) < 1
    ACN(DI:1, 1)
ENDIF
ACD(DI:2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1, Val(DI:1),'ARG'))
IF Dialogo.Fecha1 <> Val(DI:2)
    Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
ENDIF

***---FE:1 = Fecha que se procesa
***---FE:2 = Ultimo dia Habil del mes anterior al que se procesa
***---FE:3 = Ultimo dia Habil de dos meses anteriores al que se procesa

ACD(FE:1, Dialogo.Fecha1)
***---ACD(FE:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(FE:2, FinDeMes(PriDeMes(Dialogo.Fecha1, SI)-1, NO))
***---ACD(FE:3, Habiles(PriDeMes(Val(FE:2)),-1,'ARG'))
ACD(FE:3, FinDeMes(PriDeMes(Val(FE:2), SI)-1, NO))

ACT(CT:1,'')

SQL.ADD(" Select Distinct O.Especie, O.Vehiculo1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp = 'MMDPAC' AND FechaOp <= '"~IdxDate(Val(FE:2))~"' AND FechaVto > '"~IdxDate(Val(FE:2))~"'  ")

Recorrer SQL
   ***---Proceso la ultima operacion del mes por cada moneda-vehiculo
   ACD(FV:1, Val(FE:2))
   ACT(TA:1, Var('TIPASOREDE'))
   ACT(VH:1, fbn('Vehiculo1'))
   SQL.ADD(" SELECT O.Especie Moneda, O.NrOperacion, O.Especie, O.ContraEspecie, O.TipoOp, MA.Codigo CodAsi, V.Valor1, ")
   SQL.ADD(" V.Valor2, O.FechaVto, O.Vehiculo1, E.Tipo, O.FechaOp, O.Cliente1, O.Observaciones, E.Alias8, V.Alias4, ")
   SQL.ADD(" MA.Libro, O.Cuenta2, O.Cantidad, O.Cuenta1 ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".CLIENTES C, "~DBO~".VEHICULOS V, ")
   SQL.ADD(" "~DBO~".ESPECIES E ")
   SQL.ADD(" Where O.Cliente1 = C.Codigo ")
   SQL.ADD(" AND O.Vehiculo1 = V.Codigo ")
   SQL.ADD(" AND O.Especie = E.Codigo ")
   SQL.ADD(" AND O.Especie = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND O.Vehiculo1 = '"~fbn('Vehiculo1')~"' ")
   SQL.ADD(" AND O.TipoOp = 'MMDPAC' ")
   SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Val(TA:1))~") ")
   SQL.ADD(" AND MA.Habilitado = 'SI' ")
   SQL.ADD(" AND MA.Entorno = '"~SIGLA~"' ")
   SQL.ADD(" AND O.Vehiculo1 Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
   SQL.ADD(" AND FechaOp <= '"~IdxDate(Val(FE:2))~"' AND FechaVto > '"~IdxDate(Val(FE:2))~"'  ")
   IF NoVacio(Dialogo.ListaTabla1)
       SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
   ELSE
      IF NoVAcio(Dialogo.Lista1)
           SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  AND (( ")
           Recorrer&i 1,Elementos(Dialogo.Lista1)
                SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
                If NOT Elementos(Dialogo.Lista1)=&i
                    SQL.ADD(" OR ")
                EndIf
           proximo
           SQL.ADD(") OR O.Vehiculo1 is null OR O.Vehiculo1 = '' OR O.Vehiculo1 = ' ' )")       
      ELSE
         IF NoVacio(UsrVehiculos(UsuarioActivo))
            SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
         ENDIF
      ENDIF
   ENDIF
   SQL.ADD(" ORDER By O.Cuenta1, O.NrOperacion, MA.Codigo ")
   Recorrer SQL
      ***///(.'FECHAVALOR'.)
      **// Busco la ultima eventual para tomar el saldo actual
         ACN(RC:1, 0)
         SQL.ADD(" SELECT O.Cantidad FROM "~DBO~".OPSEVENTUALES O ")
         SQL.ADD(" WHERE O.TipoOp = 'MMEVDE' ")
         SQL.ADD(" AND O.FechaOp  = (Select Max(EV.FechaOp) From "~DBO~".OPSEVENTUALES EV ")
         SQL.ADD("                  Where EV.TipoOp = O.TipoOp ")
         SQL.ADD("                  AND EV.FechaOp <= '"~IdxDate(Val(FE:2))~"' ")
         SQL.ADD("                  AND O.Cuenta1 = EV.Cuenta1 ")
         SQL.ADD("                  AND O.Especie = EV.Especie) ")
         SQL.ADD(" AND O.Cuenta1 = '"~FBN('Cuenta1')~"' ")
         Recorrer SQL
            If FBN('Cantidad')<0
               ACN(RC:1, ABS(FBN('Cantidad')))
            Endif
         Proximo

      ACN(CK:1, 0)
      IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
         ACN(CK:1, 1)
         ***///IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
            ACN(CK:1, 0)
         ENDIF
      ENDIF
      If Not Eqstr(FBN('Cuenta1'), Val(CT:1))
         IF Val(CK:1) = 0
            SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
         ENDIF
         ACT(NA:1, SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         **//MessageBox(Val(NA:1))
         ***/// Reverso al asiento con fecha valor al primer dia habil del mes siguiente
         EjecutarEvento('CONT46', Fecha1=Dialogo.Fecha1, NrUnicoAsiento1=Val(NA:1), String1='', Fecha2=Val(FV:1))
      Endif
      ACT(CT:1, FBN('Cuenta1'))
   Proximo
Proximo
