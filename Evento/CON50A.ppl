MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:      'Fecha'           ; 1;;;;;;;;fsys
  Lista1:      'Vehiculos'       ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'     ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada';;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

Message('--- Asientos de RXT Prestamos ---')

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
    ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
    ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))


***--- Fecha Proceso
ACD(v:1, Dialogo.Fecha1)
***--- Ultimo Dia Habil mes anterior
***---ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:2, FinDeMes(PriDeMes(Dialogo.Fecha1,SI)-1, NO))
***--- Primer Dia Mes Anterior
ACD(v:3, PriDeMes(Val(v:2),SI))
***--- Primer Dia del Mes
ACD(v:4, PriDeMes(Val(v:1),SI))
***--- Ultimo Dia del Mes anterior
ACD(v:5, Val(v:4)-1)
***--- Obtengo el sabado si hoy es lunes. Sino V:6 = Dialogo.Fecha1
ACD(V:6, Habiles(Dialogo.Fecha1, -1) + 1)
***--- Ultimo dia del mes anterior anterior
ACD(v:7, Val(v:3)-1)


***/// Resultados por tenencia de prestamos en especie al Vto
SQL.ADD(" SELECT O.NrOperacion, O.Especie, O.FechaOp, O.Cliente1, O.ContraEspecie Moneda, C.Fecha2, C.Cantidad2, ")
SQL.ADD(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, V.Valor1, V.Valor2, ")
SQL.ADD(" MA.Codigo CodAsi, O.CB9, O.CB10, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, ")
SQL.ADD(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, V.Alias4, C.Cantidad1, E.Cotiza ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".VEHICULOS V, "~DBO~".MODELOSASIENTO MA, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.NrOperacion    =  C.NrOperacion ")
SQL.ADD(" AND   O.Especie   =  E.Codigo ")
SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo ")
SQL.ADD(" AND   O.TipoOp IN ('SEPVMV','SEPTMV') ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEPR'))~") ")
SQL.ADD(" AND   C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' AND C.Fecha2 >= '"~IdxDate(Val(V:6))~"' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
* -- Solo los vehiculos que liquidan contabilizan.
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
   Recorrer&i 1,Elementos(Dialogo.Lista1)
        SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
   proximo
   SQL.ADD(") ")   
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" ORDER BY O.NrOperacion ")

Recorrer SQL
   ACN(CK:1, 0)
   ACT(VH:1, fbn('Vehiculo1'))
   ***---ACD(FV:1, FBN('FechaVto'))
   ACD(FV:1, FBN('Fecha2'))
   IF fbn('FechaOp') > Val(V:5)
       ACD(FD:1, fbn('FechaOp'))
   ELSE
       ACD(FD:1, Val(V:5))
   ENDIF
   ***---ACN(CT:1, CotizacionC(FBN('Especie'),,,,Val(v:5),1,SI,FBN('Moneda')))
   ACN(CT:1, CotizacionC(FBN('Especie'),,,,Val(FD:1),1,SI,FBN('Moneda')))
   ***---ACN(CT:2, CotizacionC(FBN('Especie'),,,,FBN('FechaVto'),1,SI,FBN('Moneda')))
   ACN(CT:2, CotizacionC(FBN('Especie'),,,,Val(FV:1),1,SI,FBN('Moneda')))
   ACN(CT:3, Val(CT:2)-Val(CT:1))

   ACN(CT:3, Val(CT:2)-Val(CT:1))
   ***---ACN(RS:1, FBN('Cantidad2')*Val(CT:3))
   ACN(RS:1, FBN('Cantidad1')*Val(CT:3))
   IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrOperacion = '"~fbn('NrOperacion')~"' And A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~fbn('Especie')~"' AND A.Modelo = '"~fbn('CodAsi')~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(FV:1))~"' AND A.Vehiculo = '"~Val(VH:1)~"' AND A.NrOperacion = '"~fbn('NrOperacion')~"' "))
         ACN(CK:1, 0)
      ENDIF
   ENDIF
   IF Val(CK:1) = 0
       message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
       SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
       SQL.EXEC
   ENDIF
Proximo



***/// Resultados por tenencia de prestamos en especie a Fin de Mes
If Dialogo.Fecha1=Val(x2)
   ***/// Resultados por tenencia de prestamos en especie al Vto
   SQL.ADD(" SELECT O.NrOperacion, O.Especie, O.FechaOp, O.Cliente1, O.ContraEspecie Moneda, C.Fecha1, C.Fecha2, C.Cantidad2, ")
   SQL.ADD(" O.Vehiculo1, O.TipoOp, O.Cantidad, O.TotalBrutoCli1, O.TotalNetoCli1, V.Valor1, V.Valor2, ")
   SQL.ADD(" MA.Codigo CodAsi, O.CB9, O.CB10, O.TotalNetoCli2, O.FechaVto, O.FechaVto2, O.PrecioMer, O.TotalIntereses, ")
   SQL.ADD(" O.ImpGastos1, O.PlazoRenovPredeter, O.MB3, O.TotalAux1, O.Observaciones, O.Precio1, O.Plazo, V.Alias4, E.Cotiza ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".VEHICULOS V, "~DBO~".MODELOSASIENTO MA, "~DBO~".ESPECIES E ")
   SQL.ADD(" WHERE O.NrOperacion    =  C.NrOperacion ")
   SQL.ADD(" AND   O.Especie   =  E.Codigo ")
   SQL.ADD(" AND   O.Vehiculo1   =  V.Codigo ")
   SQL.ADD(" AND   O.TipoOp IN ('SEPVMV','SEPTMV') ")
   SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
   SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITEPR'))~") ")
   SQL.ADD(" AND   C.Fecha2  >  "~IdxDate2(Val(v:5))~"  ")
   SQL.ADD(" AND   C.Fecha1  <= "~IdxDate2(Val(v:2))~"   ")
   If NoVacio(Dialogo.ListaTabla1)
      SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
   Endif
   * -- Solo los vehiculos que liquidan contabilizan.
   SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
   SQL.ADD(" AND MA.Habilitado = 'SI' ")
   If NoVAcio(Dialogo.Lista1)
       SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
       Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
       proximo
       SQL.ADD(") ")      
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
   SQL.ADD(" ORDER BY O.NrOperacion ")
   
   Recorrer SQL
      ACN(CK:1, 0)
      ACT(VH:1, fbn('Vehiculo1'))
      ACD(FV:1, Val(V:5))
      ***---If FBN('Fecha1') > Val(v:7)
      IF fbn('FechaOp') > Val(v:7)
         ***---ACN(CT:1, CotizacionC(FBN('Especie'),,,,FBN('Fecha1'),1,SI,FBN('Moneda')))
         ACN(CT:1, CotizacionC(FBN('Especie'),,,,fbn('FechaOp'),1,SI,FBN('Moneda')))
      Else
         ACN(CT:1, CotizacionC(FBN('Especie'),,,,Val(v:7),1,SI,FBN('Moneda')))
      Endif

      ACN(CT:2, CotizacionC(FBN('Especie'),,,,Val(v:5),1,SI,FBN('Moneda')))
      ACN(CT:3, Val(CT:2)-Val(CT:1))
      ACN(RS:1, FBN('Cantidad2')*Val(CT:3))

      IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
         ACN(CK:1, 1)
         IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrOperacion = '"~fbn('NrOperacion')~"' And A.NrUnicoAsiento = A1.NrUnicoAsiento AND A1.Alias7 = '"~fbn('Especie')~"' AND A.Modelo = '"~fbn('CodAsi')~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(FV:1))~"' AND A.Vehiculo = '"~Val(VH:1)~"' AND A.NrOperacion = '"~fbn('NrOperacion')~"' "))
            ACN(CK:1, 0)
         ENDIF
      ENDIF
      IF Val(CK:1) = 0
          message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
          SQL.GenerarAsientoOp(fbn('CodAsi'),fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
          SQL.EXEC
      ENDIF
   Proximo
Endif
