*Afectacion de Limite tipo COTOR (Credito Otorgado) de Fondos Comunes
* ejecutar al cierre de cada dia
* Recupero la Fecha desde para Procesar el Informe
* Modificacion del dia
ACD(f5,HABILES(FSys,-1, VAR('FERIADODEF')) )


ACT(f1,SQL("Select Min(FechaVto) from "~DBO~".PMAUDIT, "~DBO~".OPERACIONES Where Tabla='OPERACIONES' and ValorAnterior<>ValorActual and Fecha Between '"~IdxDate(Fsys)~"' and  '"~IdxDate(Fsys+1)~"' and Codigo=NrOperacion and TipoOp like 'FC%' Having Min(FechaVto) is not null"))

Message(' Verificando dia de Proceso por Modificaciones .... '~val(f5)~' '~val(f1))
If NoVacio(val(f1)) y Fecha(val(f1))<val(f5) 
   ACD(f5,Fecha(VAL(f1)))
EndIf


ACT(f2,SQL("Select Min(FechaVto) from "~DBO~".OPERACIONES Where TipoOp like 'FC%' and FechaCargaSys='"~IdxDate(Fsys)~"' and FechaOp<>FechaCargaSys "))
Message(' Verificando dia de Proceso por Operaciones Fecha Valor .... '~val(f2))
If NoVacio(val(f2)) y Fecha(val(f2))<val(f5)
   ACD(f5,Fecha(VAL(f2)))
EndIf



ACT(f3,SQL("Select Min(FechaVto) from "~DBO~".BOPERACIONES Where TipoOp like 'FC%' and FechaDel = '"~IdxDate(Fsys)~"' "))
Message(' Verificando Bajas de Operaciones  .... '~val(f3))

If NoVacio(val(f3)) y Fecha(VAL(f3))<val(f5)
   ACD(f5,Fecha(VAL(f3)))
EndIf

CrearDialogo
  Fecha1  : 'Fecha'   ;;;;;;EsHabil(Dialogo.Fecha1,'ARG');'Debe Ingresar un D¡a H bil en Argentina';NO;val(f5)
FinDialogo

if not OK
  Cancelar
endif

ACD(f6,Dialogo.Fecha1)
ACD(f7,FSys-1)

Recorrer&j val(f6),val(f7)
   ACD(f6,&j)
   if EsHabil(val(f6))
      Message('Procesando fecha '~val(f6))
      EjecutarEvento('AFELI1',Fecha1=val(f6))
   else 
      Message('NO es habil, no la procesa '~val(f6))
   EndIf
Proximo 

*Recorrer&j 1,DifDias(Dialogo.Fecha1,HABILES(FSys,-1, VAR('FERIADODEF')),VAR('FERIADODEF'),SI)+1
