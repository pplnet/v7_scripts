Cancelar()
Sqladd(" Select NrOperacion,TipoOp,Clietne1 from "~Dbo()~".OPERACIONES ")
Sqladd("  Where FechaOp <  '"~IdxDate(FSys())~"' ")
Sqladd("    and TipoOp  in ('TIV','TIFV','TIC','TIFC') ")
Sqladd("    and IsNull(NroAltaMAE,'') = '' ")
recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
Act(b:fac, Pad0(BuscarCampo('CLIENTES', 'NrMAE', 'Codigo', Fbn()['Cliente1']), 3))
if (Vacio(Val(b:fac)) o Eqstr(Val(b:fac), '000'))
Acn(x1, 0)
else
Acn(x1, 1)
endif
if (Incluido(Fbn()['TipoOp'], 'TIV|TIFV') o (Incluido(Fbn()['TipoOp'], 'TIC|TIFC') y Val(x1) = 0))
Act(b:fac, Fbn()['NrOperacion'])
Sqladd("UPDATE "~Dbo()~".OPERACIONESBITS ")
Sqladd("   SET Valor = '1' ")
Sqladd(" Where Valor = '1' ")
Sqladd("   and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd("Update "~Dbo()~".OPERACIONESBITS ")
Sqladd("   Set Valor       = '0' ")
Sqladd(" Where NrBit       = 51 ")
Sqladd("   and NrOperacion = '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqlexec()
endif
proximo

if (NO)
