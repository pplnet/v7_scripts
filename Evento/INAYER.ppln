Sqladd(" and (NroAltaMAE = ' ' or NroAltaMAE is NULL)")
recorrer sql
Act(a:fac, Fbn()['NrOperacion'])
if (Incluido(Fbn()['TipoOp'], 'TIV|TIFV') o (Incluido(Fbn()['TipoOp'], 'TIC|TIFC') y BuscarCampo('CLIENTES', 'NrMAE', 'Codigo', Fbn()['Cliente1']) = 0))
Act(b:fac, Fbn()['NrOperacion'])
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '1' ")
Sqladd(" Where Valor = '1' and NrOperacion= '"~Fbn()['NrOperacion']~"' ")
Sqlnew()
Sqladd(" UPDATE "~Dbo()~".OPERACIONESBITS SET Valor = '0' ")
Sqladd(" Where (NrBit = 50 ) and (NrOperacion = '"~Fbn()['NrOperacion']~"') ")
Sqlnew()
Sqlexec()
endif
proximo
