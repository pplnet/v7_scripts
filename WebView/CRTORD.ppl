** ============================================================================
** PPL WebView: Creacion de Ordenes
** ============================================================================
** Descripcion: Formulario para crear ordenes con notificacion en tiempo real
** Autor: Sistema V7
** Fecha: 2026-01-28
** ============================================================================

** ============================================================================
** Funcion: Obtener lista de clientes activos
** Usa la tabla CLIENTES real
** ============================================================================
def GetClientes()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(RazonSocial) as RazonSocial,
            RTRIM(CUIT) as CUIT
        FROM CLIENTES
        WHERE RTRIM(Status) = 'ACT'
        ORDER BY RazonSocial
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener lista de especies disponibles
** Usa la tabla ESPECIES real
** ============================================================================
def GetEspecies()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre,
            RTRIM(Tipo) as Tipo,
            RTRIM(MonedaEmision) as MonedaEmision,
            ISNULL(VTeorico, 0) as VTeorico
        FROM ESPECIES
        WHERE RTRIM(Habilitada) = 'SI'
        ORDER BY Codigo
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener tipos de orden disponibles
** Usa la tabla TIPOSORDEN real
** ============================================================================
def GetTiposOrdenDisponibles()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre
        FROM TIPOSORDEN
        ORDER BY Nombre
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Crear una nueva orden
** Parametros separados para evitar problemas con JSON
** ============================================================================
def CrearOrden(tipoOrden, clienteId, especie, cantidad, precio, observaciones)
    ** Obtener proximo numero de orden (formato ORD00001)
    &sqlNextNro := <<
        SELECT 'ORD' + RIGHT('00000' + CAST(ISNULL(MAX(CAST(REPLACE(NrOrden, 'ORD', '') AS INT)), 0) + 1 AS VARCHAR(5)), 5) FROM ORDENES
    >>
    &nrOrden := Query(&sqlNextNro)

    ** Calcular direccion (1 = Compra, -1 = Venta)
    If EqStr(tipoOrden, "VENTA")
        &direccion := -1
    Else
        &direccion := 1
    EndIf

    ** Insertar orden en tabla ORDENES (usando LEFT para truncar campos)
    &sqlInsert := "INSERT INTO ORDENES ("
    &sqlInsert := &sqlInsert ~ "NrOrden, TipoOrden, FechaOrden, Cliente, Especie, "
    &sqlInsert := &sqlInsert ~ "CantidadTotalOrden, PrecioLimite, Estado, Operador, "
    &sqlInsert := &sqlInsert ~ "Direccion, Observaciones, FechaCarga, Mercado"
    &sqlInsert := &sqlInsert ~ ") VALUES ("
    &sqlInsert := &sqlInsert ~ "'" ~ &nrOrden ~ "', "
    &sqlInsert := &sqlInsert ~ "LEFT('" ~ tipoOrden ~ "', 6), "
    &sqlInsert := &sqlInsert ~ "GETDATE(), "
    &sqlInsert := &sqlInsert ~ "LEFT('" ~ clienteId ~ "', 10), "
    &sqlInsert := &sqlInsert ~ "LEFT('" ~ especie ~ "', 6), "
    &sqlInsert := &sqlInsert ~ Str(cantidad) ~ ", "
    &sqlInsert := &sqlInsert ~ Str(precio) ~ ", "
    &sqlInsert := &sqlInsert ~ "'PEN', "
    &sqlInsert := &sqlInsert ~ "LEFT('WEBVIEW', 30), "
    &sqlInsert := &sqlInsert ~ Str(&direccion) ~ ", "
    &sqlInsert := &sqlInsert ~ "LEFT('" ~ observaciones ~ "', 255), "
    &sqlInsert := &sqlInsert ~ "GETDATE(), "
    &sqlInsert := &sqlInsert ~ "'BYMA'"
    &sqlInsert := &sqlInsert ~ ")"

    Execute(&sqlInsert)

    ** Retornar numero de orden creada
    return ${ NrOrden = &nrOrden, Success = true }
end

** ============================================================================
** Funcion: Obtener vehiculos disponibles
** ============================================================================
def GetVehiculos()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Descripcion) as Descripcion
        FROM VEHICULOS
        ORDER BY Codigo
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end
