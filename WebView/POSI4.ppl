** ============================================================================
** PPL WebView: Posiciones en Tiempo Real (POSI4)
** ============================================================================
** Descripcion: Dashboard de posiciones calculadas desde OPERACIONES
**              Agrupa compras y ventas por Especie/Book
**              Muestra posicion inicial (antes del dia) + movimientos del dia
**              Actualizacion automatica via WebSocket
** ============================================================================

** ============================================================================
** Funcion: Obtener posiciones netas agrupadas
** Pos. Inicial = acumulado antes del dia
** Compras/Ventas = solo del dia filtrado
** Posicion Neta = PosInicial + Compras - Ventas
** ============================================================================
def GetPosiciones(fec, especie, book, tipoEspecie)
    &sql := "SELECT "
    &sql := &sql ~ "RTRIM(O.Especie) as Especie, "
    &sql := &sql ~ "RTRIM(ISNULL(E.Nombre, '')) as EspecieNombre, "
    &sql := &sql ~ "RTRIM(ISNULL(O.ContraEspecie, '')) as ContraEspecie, "
    &sql := &sql ~ "RTRIM(ISNULL(O.Book1, '')) as Book, "

    ** Posicion inicial: acumulado de operaciones ANTES del dia
    &sql := &sql ~ "SUM(CASE WHEN O.FechaOp < CONVERT(datetime, '" ~ fec ~ "', 126) THEN "
    &sql := &sql ~ "  CASE WHEN O.TipoOp LIKE '%TIC%' OR O.TipoOp = 'COMPRA' THEN ISNULL(O.Cantidad, 0) "
    &sql := &sql ~ "       WHEN O.TipoOp LIKE '%TIV%' OR O.TipoOp = 'VENTA' THEN -ISNULL(O.Cantidad, 0) "
    &sql := &sql ~ "       ELSE 0 END ELSE 0 END) as PosInicial, "

    ** Compras del dia
    &sql := &sql ~ "SUM(CASE WHEN O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) "
    &sql := &sql ~ "  AND (O.TipoOp LIKE '%TIC%' OR O.TipoOp = 'COMPRA') THEN ISNULL(O.Cantidad, 0) ELSE 0 END) as Compras, "

    ** Ventas del dia
    &sql := &sql ~ "SUM(CASE WHEN O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) "
    &sql := &sql ~ "  AND (O.TipoOp LIKE '%TIV%' OR O.TipoOp = 'VENTA') THEN ISNULL(O.Cantidad, 0) ELSE 0 END) as Ventas, "

    ** Posicion neta: PosInicial + Compras - Ventas (todo junto)
    &sql := &sql ~ "SUM(CASE WHEN O.TipoOp LIKE '%TIC%' OR O.TipoOp = 'COMPRA' THEN ISNULL(O.Cantidad, 0) "
    &sql := &sql ~ "     WHEN O.TipoOp LIKE '%TIV%' OR O.TipoOp = 'VENTA' THEN -ISNULL(O.Cantidad, 0) "
    &sql := &sql ~ "     ELSE 0 END) as PosicionNeta, "

    ** Precio fin: ultimo precio del dia (o promedio del dia si no hay precio de cierre)
    &sql := &sql ~ "CASE WHEN SUM(CASE WHEN O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) THEN O.Cantidad ELSE 0 END) <> 0 "
    &sql := &sql ~ "  THEN SUM(CASE WHEN O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) THEN ISNULL(O.TotalBrutoCli1, 0) ELSE 0 END) "
    &sql := &sql ~ "     / SUM(CASE WHEN O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) THEN O.Cantidad ELSE NULL END) "
    &sql := &sql ~ "  ELSE 0 END as PrecioFin, "

    ** Valuacion total
    &sql := &sql ~ "SUM(CASE WHEN O.TipoOp LIKE '%TIC%' OR O.TipoOp = 'COMPRA' THEN ISNULL(O.TotalBrutoCli1, 0) "
    &sql := &sql ~ "     ELSE -ISNULL(O.TotalBrutoCli1, 0) END) as Valuacion "

    &sql := &sql ~ "FROM OPERACIONES O "
    &sql := &sql ~ "LEFT JOIN ESPECIES E ON RTRIM(O.Especie) = RTRIM(E.Codigo) "
    &sql := &sql ~ "WHERE O.FechaOp <= CONVERT(datetime, '" ~ fec ~ "', 126) "

    ** Filtro por especie
    If NoVacio(especie)
        &sql := &sql ~ "AND O.Especie = '" ~ especie ~ "' "
    EndIf

    ** Filtro por book
    If NoVacio(book)
        &sql := &sql ~ "AND O.Book1 IN (" ~ book ~ ") "
    EndIf

    ** Filtro por tipo de especie (jerarquia)
    If NoVacio(tipoEspecie)
        &sql := &sql ~ "AND E.Jerarquia >= (SELECT Jerarquia FROM ESPECIES WHERE RTRIM(Codigo) = '" ~ tipoEspecie ~ "') "
        &sql := &sql ~ "AND E.Jerarquia <= (SELECT Jerarquia + REPLICATE('9', 15 - LEN(Jerarquia)) FROM ESPECIES WHERE RTRIM(Codigo) = '" ~ tipoEspecie ~ "') "
    EndIf

    &sql := &sql ~ "GROUP BY O.Especie, E.Nombre, O.ContraEspecie, O.Book1 "
    &sql := &sql ~ "ORDER BY O.Especie, O.Book1"

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener detalle de operaciones para una especie/book (solo del dia)
** ============================================================================
def GetResultados(especie, book, fec)
    &sql := "SELECT "
    &sql := &sql ~ "RTRIM(O.TipoOp) as TipoOp, "
    &sql := &sql ~ "RTRIM(O.NrOperacion) as NrOperacion, "
    &sql := &sql ~ "CONVERT(VARCHAR(10), O.FechaOp, 103) as FechaOp, "
    &sql := &sql ~ "RTRIM(O.Cliente1) as Cliente, "
    &sql := &sql ~ "ISNULL(O.Cantidad, 0) as Cantidad, "
    &sql := &sql ~ "ISNULL(O.Precio1, 0) as Precio, "
    &sql := &sql ~ "ISNULL(O.TotalBrutoCli1, 0) as Monto "
    &sql := &sql ~ "FROM OPERACIONES O "
    &sql := &sql ~ "WHERE O.Especie = '" ~ especie ~ "' "
    If NoVacio(book)
        &sql := &sql ~ "AND O.Book1 = '" ~ book ~ "' "
    EndIf
    &sql := &sql ~ "AND O.FechaOp = CONVERT(datetime, '" ~ fec ~ "', 126) "
    &sql := &sql ~ "ORDER BY O.FechaOp DESC, O.NrOperacion DESC"

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener vehiculos disponibles
** ============================================================================
def GetVehiculos()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Descripcion, '')) as Descripcion
        FROM VEHICULOS
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener books disponibles
** ============================================================================
def GetBooks()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo FROM BOOKS ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener tipos de especie raiz para el filtro
** ============================================================================
def GetTiposEspecie()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Nombre, Codigo)) as Nombre
        FROM ESPECIES
        WHERE RTRIM(Codigo) IN ('TITULO', 'MONEDA', 'FONDOS')
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end
