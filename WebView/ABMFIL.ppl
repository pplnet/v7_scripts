** ============================================================================
** PPL WebView: ABM de Filtros
** ============================================================================
** Descripcion: Alta, Baja y Modificacion de Filtros de instancias.
**              Accede a la tabla FILTROS.
** Autor: Sistema V7
** Fecha: 2026-03-09
** ============================================================================

** Variables globales
&filtros := $[]

** ============================================================================
** Funcion: Obtener todos los filtros
** ============================================================================
def GetFiltros()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(ISNULL(Nombre, '')) as Nombre,
            RTRIM(ISNULL(Perfiles, '')) as Perfiles,
            RTRIM(ISNULL(Tabla, '')) as Tabla,
            RTRIM(ISNULL(Columnas, '')) as Columnas,
            RTRIM(ISNULL(Condiciones, '')) as Condiciones,
            RTRIM(ISNULL(Orden, '')) as Orden,
            ISNULL(NrInstancia, 0) as NrInstancia
        FROM FILTROS
        ORDER BY Codigo
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener un filtro especifico por codigo
** ============================================================================
def GetFiltro(codigo)
    &sql := "SELECT "
    &sql := &sql ~ "RTRIM(Codigo) as Codigo, "
    &sql := &sql ~ "RTRIM(ISNULL(Nombre, '')) as Nombre, "
    &sql := &sql ~ "RTRIM(ISNULL(Perfiles, '')) as Perfiles, "
    &sql := &sql ~ "RTRIM(ISNULL(Tabla, '')) as Tabla, "
    &sql := &sql ~ "RTRIM(ISNULL(Columnas, '')) as Columnas, "
    &sql := &sql ~ "RTRIM(ISNULL(Condiciones, '')) as Condiciones, "
    &sql := &sql ~ "RTRIM(ISNULL(Orden, '')) as Orden, "
    &sql := &sql ~ "ISNULL(NrInstancia, 0) as NrInstancia "
    &sql := &sql ~ "FROM FILTROS "
    &sql := &sql ~ "WHERE Codigo = '" ~ codigo ~ "'"

    &resultado := QueryTable(&sql)

    If &resultado.count > 0
        return &resultado.itemAt(0)
    EndIf

    return ${}
end

** ============================================================================
** Funcion: Alta de filtro
** ============================================================================
def InsertFiltro(codigo, nombre, perfiles, tabla, columnas, condiciones, orden, nrInstancia)
    &sql := "INSERT INTO FILTROS (Codigo, Nombre, Perfiles, Tabla, Columnas, Condiciones, Orden, NrInstancia) "
    &sql := &sql ~ "VALUES ("
    &sql := &sql ~ "'" ~ codigo ~ "', "
    &sql := &sql ~ "'" ~ nombre ~ "', "
    &sql := &sql ~ "'" ~ perfiles ~ "', "
    &sql := &sql ~ "'" ~ tabla ~ "', "
    &sql := &sql ~ "'" ~ columnas ~ "', "
    &sql := &sql ~ "'" ~ condiciones ~ "', "
    &sql := &sql ~ "'" ~ orden ~ "', "
    &sql := &sql ~ nrInstancia ~ ")"
    SQL.Add(&sql)
    SQL.Exec()
    return "OK"
end

** ============================================================================
** Funcion: Modificacion de filtro
** ============================================================================
def UpdateFiltro(codigo, nombre, perfiles, tabla, columnas, condiciones, orden, nrInstancia)
    &sql := "UPDATE FILTROS SET "
    &sql := &sql ~ "Nombre = '" ~ nombre ~ "', "
    &sql := &sql ~ "Perfiles = '" ~ perfiles ~ "', "
    &sql := &sql ~ "Tabla = '" ~ tabla ~ "', "
    &sql := &sql ~ "Columnas = '" ~ columnas ~ "', "
    &sql := &sql ~ "Condiciones = '" ~ condiciones ~ "', "
    &sql := &sql ~ "Orden = '" ~ orden ~ "', "
    &sql := &sql ~ "NrInstancia = " ~ nrInstancia ~ " "
    &sql := &sql ~ "WHERE Codigo = '" ~ codigo ~ "'"

    SQL.Add(&sql)
    SQL.Exec()
    return "OK"
end

** ============================================================================
** Funcion: Baja de filtro
** ============================================================================
def DeleteFiltro(codigo)
    &sql := "DELETE FROM FILTROS WHERE Codigo = '" ~ codigo ~ "'"

    SQL.Add(&sql)
    SQL.Exec()
    return "OK"
end
