** Variables del sistema
def GetVariables()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre
        FROM VARIABLES
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** Instancias de workflow
def GetInstancias()
    &sql := <<
        SELECT
            RTRIM(Tabla) as Tabla,
            NrInstancia,
            RTRIM(ISNULL(Nombre, '')) as Nombre
        FROM INSTANCIAS
        ORDER BY Tabla, NrInstancia
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** Vistas Web (cargados desde el servidor, no desde la BD)
def GetWebViews()
    &resultado := ListScripts('WebView')
    return &resultado
end

** Canales de mensajes
def GetCanales()
    &sql := <<
        SELECT
            Id,
            RTRIM(Nombre) as Nombre
        FROM MENSAJECANALES
        ORDER BY Id
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end
