** ============================================================================
** PPL WebView: Perfiles de Usuario
** ============================================================================
** Descripcion: Alta, Baja y Modificacion de Perfiles de Usuario.
**              Accede a la tabla PERFILES2.
**              El campo Script contiene las siglas de permisos del perfil.
** Autor: Sistema V7
** Fecha: 2026-02-12
** ============================================================================

** Variables globales
&perfiles := $[]

** ============================================================================
** Funcion: Obtener todos los perfiles
** ============================================================================
def GetPerfiles()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre
        FROM PERFILES2
        ORDER BY Codigo
    >>

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener un perfil especifico con su script
** ============================================================================
def GetPerfil(codigo)
    &sql := "SELECT "
    &sql := &sql ~ "RTRIM(Codigo) as Codigo, "
    &sql := &sql ~ "RTRIM(Nombre) as Nombre, "
    &sql := &sql ~ "RTRIM(ISNULL(CAST(Script AS VARCHAR(MAX)), '')) as Script "
    &sql := &sql ~ "FROM PERFILES2 "
    &sql := &sql ~ "WHERE Codigo = '" ~ codigo ~ "'"

    &resultado := QueryTable(&sql)

    If &resultado.count > 0
        return &resultado.itemAt(0)
    EndIf

    return ${}
end

** ============================================================================
** Funcion: Alta de perfil
** ============================================================================
def InsertPerfil(codigo, nombre, script)
    &sql := "INSERT INTO PERFILES2 (Codigo, Nombre, Script) "
    &sql := &sql ~ "VALUES ("
    &sql := &sql ~ "'" ~ codigo ~ "', "
    &sql := &sql ~ "'" ~ nombre ~ "', "
    &sql := &sql ~ "'" ~ script ~ "')"

    SQL.ADD(&sql)
    SQL.EXEC()
    return "OK"
end

** ============================================================================
** Funcion: Modificacion de perfil
** ============================================================================
def UpdatePerfil(codigo, nombre, script)
    &sql := "UPDATE PERFILES2 SET "
    &sql := &sql ~ "Nombre = '" ~ nombre ~ "', "
    &sql := &sql ~ "Script = '" ~ script ~ "' "
    &sql := &sql ~ "WHERE Codigo = '" ~ codigo ~ "'"

    SQL.ADD(&sql)
    SQL.EXEC()
    return "OK"
end

** ============================================================================
** Funcion: Baja de perfil
** ============================================================================
def DeletePerfil(codigo)
    &sql := "DELETE FROM PERFILES2 WHERE Codigo = '" ~ codigo ~ "'"

    SQL.ADD(&sql)
    SQL.EXEC()
    return "OK"
end

** ============================================================================
** Funciones de catalogo: cargan datos reales de las tablas de permisos
** ============================================================================

** Items de menu (desde ABMS con JOIN a TIPOSABM para el nombre del submenu)
def GetItemsMenu()
    &sql := <<
        SELECT
            RTRIM(A.Codigo) as Codigo,
            RTRIM(A.Nombre) as Nombre,
            RTRIM(A.Menu) as Menu,
            RTRIM(ISNULL(T.Descripcion, '')) as SubMenu
        FROM ABMS A
        LEFT JOIN TIPOSABM T ON RTRIM(A.Tipo) = RTRIM(T.Codigo)
        WHERE A.Menu IS NOT NULL AND RTRIM(A.Menu) <> '' AND RTRIM(A.Menu) <> '0'
        ORDER BY T.Descripcion, A.Menu
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** Tablas ABM (desde ABMS con prefijo de acceso)
def GetTablasAbm()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre,
            RTRIM(Acceso) as Acceso
        FROM ABMS
        WHERE Acceso IS NOT NULL AND RTRIM(Acceso) <> ''
        ORDER BY Nombre
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

