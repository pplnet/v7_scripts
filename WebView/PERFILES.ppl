** Variables del sistema
def GetVariables()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre
        FROM VARIABLES
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** Instancias de workflow
def GetInstancias()
    &sql := <<
        SELECT
            RTRIM(Tabla) as Tabla,
            NrInstancia,
            RTRIM(ISNULL(Nombre, '')) as Nombre
        FROM INSTANCIAS
        ORDER BY Tabla, NrInstancia
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** Vistas Web (cargados desde el servidor, no desde la BD)
def GetWebViews()
    &resultado := ListScripts('WebView')
    return &resultado
end

** ============================================================================
** Canales de mensajes
** ----------------------------------------------------------------------------
** La tabla del subsistema de mensajeria es MENSAJES_CANALES (la que leen
** ProfileService y MessagesService). MENSAJECANALES (sin guion) es una tabla
** legacy con otros Id: leerla dejaba los permisos apuntando a canales que no
** existen para el runtime.
** ============================================================================
def GetCanales()
    &sql := <<
        SELECT
            Id,
            RTRIM(Nombre) as Nombre,
            RTRIM(ISNULL(Descripcion, '')) as Descripcion
        FROM MENSAJES_CANALES
        ORDER BY Id
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Modo de acceso de cada canal para un perfil
** ----------------------------------------------------------------------------
** MENSAJES_CANALES_PERFIL.Modo: 0 = Restringido, 2 = Asignado.
** El 1 (Opcional) es historico y ya no se ofrece: se muestra como Asignado
** (ambos modos son visibles para el usuario) y al guardar se reescribe como 2.
** ============================================================================
def GetCanalesPerfil(codigo)
    ** Alias de UNA palabra a proposito: capitalizeKey() del webview solo normaliza
    ** claves simples ('idcanal' quedaria como 'Idcanal').
    &sql := "SELECT IdCanal as Id, Modo "
    &sql := &sql ~ "FROM MENSAJES_CANALES_PERFIL "
    &sql := &sql ~ "WHERE Perfil = '" ~ codigo ~ "' "
    &sql := &sql ~ "ORDER BY IdCanal"

    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Guardar los canales asignados a un perfil
** ----------------------------------------------------------------------------
** 'asignados' es la lista de IdCanal separados por coma que quedan en modo
** Asignado (2). Se escribe una fila POR CADA canal existente -- los que no
** estan en la lista van con Modo 0 (Restringido) EXPLICITO, no por ausencia:
** ProfileService trata "el perfil no tiene ninguna fila" como "sin permisos
** configurados" y en ese caso permite TODOS los canales. Sin las filas en 0,
** dejar todo restringido tendria el efecto exactamente inverso.
** ============================================================================
def SaveCanalesPerfil(codigo, asignados)
    &lista := asignados
    If Vacio(&lista)
        ** IN () no es SQL valido: sentinela que no matchea ningun Id.
        &lista := '-1'
    EndIf

    SQL.ADD("DELETE FROM MENSAJES_CANALES_PERFIL WHERE Perfil = '" ~ codigo ~ "'")
    SQL.NEW

    &sql := "INSERT INTO MENSAJES_CANALES_PERFIL (IdCanal, Perfil, Modo) "
    &sql := &sql ~ "SELECT Id, '" ~ codigo ~ "', "
    &sql := &sql ~ "CASE WHEN Id IN (" ~ &lista ~ ") THEN 2 ELSE 0 END "
    &sql := &sql ~ "FROM MENSAJES_CANALES"

    SQL.ADD(&sql)
    SQL.EXEC()
    return "OK"
end
