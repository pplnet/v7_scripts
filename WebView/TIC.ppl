** ============================================================================
** PPL WebView: Compra de Titulos - Operacion (Full Dialog Replica)
** ============================================================================
** Descripcion: Backend PPL para el formulario completo de carga de
**              operaciones TIC con todos los campos del dialogo original.
**              Notificacion en tiempo real al monitor POSI4.
** ============================================================================

** ============================================================================
** Funcion: Obtener lista de clientes activos
** ============================================================================
def GetClientes()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(RazonSocial) as RazonSocial
        FROM CLIENTES
        ORDER BY RazonSocial
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener lista de especies (titulos habilitados)
** ============================================================================
def GetEspecies()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre,
            RTRIM(ISNULL(Jerarquia, '')) as Tipo,
            RTRIM(ISNULL(Cotiza, '')) as MonedaEmision
        FROM ESPECIES
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener contraespecies (monedas habilitadas)
** ============================================================================
def GetContraEspecies()
    &sql := <<
        SELECT
            RTRIM(Codigo) as Codigo,
            RTRIM(Nombre) as Nombre
        FROM ESPECIES
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener vehiculos
** ============================================================================
def GetVehiculos()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Descripcion, Codigo)) as Descripcion
        FROM VEHICULOS ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener mercados de negociacion
** ============================================================================
def GetMercadosNeg()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Descripcion, Codigo)) as Descripcion
        FROM MERCADOS
        WHERE IsNull(EsNegociacion, 'NO') = 'SI'
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener mercados de liquidacion
** ============================================================================
def GetMercadosLiq()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Descripcion, Codigo)) as Descripcion
        FROM MERCADOS
        WHERE IsNull(EsLiquidacion, 'NO') = 'SI'
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener books
** ============================================================================
def GetBooks()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo FROM BOOKS ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener corredores
** ============================================================================
def GetCorredores()
    &sql := <<
        SELECT RTRIM(Codigo) as Codigo, RTRIM(ISNULL(Nombre, Codigo)) as Nombre
        FROM CORREDORES
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener tablas de feriados disponibles
** ============================================================================
def GetFeriados()
    &sql := <<
        SELECT DISTINCT RTRIM(Codigo) as Codigo
        FROM FERIADOS
        ORDER BY Codigo
    >>
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener operador activo
** ============================================================================
def GetOperador()
    return UsuarioActivo()
end

** ============================================================================
** Funcion: Obtener ContraEspecie default (CotizaEn)
** ============================================================================
def GetCotizaEn(especie)
    &resultado := CotizaEn(especie)
    return &resultado
end

** ============================================================================
** Funcion: Obtener propiedades de la especie
** ============================================================================
def GetEspecieProps(especie)
    &sql := "SELECT RTRIM(ISNULL(Cotiza,'')) as MonedaEmision, "
    &sql := &sql ~ "RTRIM(ISNULL(InteresesC,'')) as InteresesC, "
    &sql := &sql ~ "RTRIM(ISNULL(Jerarquia,'')) as Tipo, "
    &sql := &sql ~ "RTRIM(ISNULL(Cotiza,'')) as Cotiza, "
    &sql := &sql ~ "RTRIM(ISNULL(DiasMes,'')) as PlazoLiq "
    &sql := &sql ~ "FROM ESPECIES WHERE Codigo = '" ~ especie ~ "'"
    &resultado := QueryTable(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Obtener PlazoLiq de la especie
** ============================================================================
def GetPlazoLiq(especie)
    &resultado := BuscarCampo('ESPECIES', 'DiasMes', 'Codigo', especie)
    return &resultado
end

** ============================================================================
** Funcion: Obtener NrMAE del cliente
** ============================================================================
def GetClienteNrMAE(cliente)
    &resultado := BuscarCampo('CLIENTES', 'Alias2', 'Codigo', cliente)
    return &resultado
end

** ============================================================================
** Funcion: Obtener CondicionIVA del vehiculo (como en el dialogo original)
** ============================================================================
def GetClienteCondIVA(vehiculo)
    &resultado := BuscarCampo('CLIENTES', 'Alias1', 'Codigo', vehiculo)
    return &resultado
end

** ============================================================================
** Funcion: Verificar si el cliente es CP (Cartera Propia)
** ============================================================================
def GetClienteCP(cliente, vehiculo)
    &sql := "Select '1' from " ~ DBO ~ ".CLIENTES where Codigo='" ~ cliente ~ "' and (Alias1='CP' or Codigo = '" ~ vehiculo ~ "') "
    &resultado := Query(&sql)
    return &resultado
end

** ============================================================================
** Funcion: Calcular Fecha de Vencimiento
** ============================================================================
def CalcFechaVto(fechaOp, diasHabiles, tablaFeriados)
    &resultado := Habiles(fechaOp, diasHabiles, tablaFeriados, SI)
    return &resultado
end

** ============================================================================
** Funcion: Recalcular todos los campos computados del dialogo
** Recibe los campos principales y devuelve los valores calculados
** ============================================================================
def RecalcularCampos(especie, contraespecie, cliente, vehiculo, cantidad, precio, fechaOp, fechaVto, mercado4, mercado, corredor, book)
    &result := ${}

    ** TotalBrutoCli1 = Precio * Cantidad (simplificado, sin InteresesC/CLE)
    &bruto := precio * cantidad
    &result.TotalBrutoCli1 := &bruto

    ** Intereses (VCAN22) - simplificado
    &interesC := BuscarCampo('ESPECIES', 'InteresesC', 'Codigo', especie)
    &vcan22 := 0
    &result.VCAN22 := &vcan22

    ** Neto s/Com (VCAN33) = bruto (simplificado sin intereses capitalizados)
    &vcan33 := &bruto
    &result.VCAN33 := &vcan33

    ** TotalNetoCli1 = VCAN33 + comisiones (simplificado)
    &result.TotalNetoCli1 := &vcan33

    ** TotalIntereses
    &result.TotalIntereses := &vcan22

    ** TotalComisiones del corredor
    &result.TotalComisiones := 0

    ** TipoCambio (tasa) - solo aplica si es especie tasa
    &result.TipoCambio := 0

    ** Cotizacion
    If NoVacio(especie) y NoVacio(contraespecie)
        &result.Precio4 := CotizacionC(especie, , , , fechaOp, 1, SI, contraespecie)
    EndIf

    ** Propiedades especie
    &result.VTXT3 := &interesC
    &result.VTXT14 := BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', especie)
    &result.VTXT13 := BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', especie)

    ** ClienteNoLim (VCAN1)
    If NoVacio(cliente) y NoVacio(vehiculo)
        &vcan1 := Query("Select 1 from " ~ DBO ~ ".CLIENTES where Codigo='" ~ cliente ~ "' and (Alias1='CP') ")
        If NoVacio(&vcan1)
            &result.VCAN1 := 1
        Else
            &result.VCAN1 := 0
        EndIf
    EndIf

    ** Especie Tasa (VPRE21)
    &result.VPRE21 := 0

    ** Cupon
    If NoVacio(especie) y NoVacio(fechaVto)
        &result.Cupon1 := NrCupon2(especie, fechaVto)
        &result.FechaUltCupon := UltCupon2(especie, fechaVto)
    EndIf

    ** Parking
    If Incluido(contraespecie, 'ARP|USD')
        &result.ParkMoneda := contraespecie
    EndIf

    ** DDJJ
    &result.DDJJRequiere := 'NO'

    return &result
end

** ============================================================================
** Funcion: Crear operacion TIC completa
** Recibe todos los campos del formulario como parametros individuales
** ============================================================================
def CrearOperacionTIC(pFechaOp, pFechaVto, pFechaPago, pEspecie, pContraEspecie, pCliente1, pCantidad, pPrecio1, pCorredor, pMercado4, pPlataforma, pMercado, pMercado2, pBook1, pVehiculo1, pFeriados, pNrExterno, pNrOrden1, pOpSIOPEL, pObs, pRb5, pPlazo, pFormaLiq1, pFormaLiq2, pRb6, pRb9, pCartera, pCb6, pCb7, pCb10, pConvenio, pFechaAltaSisExt, pCuenta1, pCuenta2, pCuenta3, pCuenta4, pCuenta5, pCuenta6, pAfectaLS, pOperacionRef, pTotalAux8)

    ** Obtener proximo numero de operacion con prefijo TI
    ** Considera tanto operaciones con prefijo TI como operaciones numericas puras
    &sqlNext := <<
        SELECT 'TI' + RIGHT('000000' + CAST(
            ISNULL(MAX(
                CASE
                    WHEN NrOperacion LIKE 'TI%' THEN TRY_CAST(SUBSTRING(NrOperacion, 3, LEN(NrOperacion) - 2) AS INT)
                    ELSE TRY_CAST(NrOperacion AS INT)
                END
            ), 0) + 1
        AS VARCHAR(6)), 6)
        FROM OPERACIONES
    >>
    &nrOperacion := Query(&sqlNext)

    &operador := UsuarioActivo()

    ** Determinar fecha de pago
    &tmpFechaPago := pFechaVto
    If NoVacio(pFechaPago)
        &tmpFechaPago := pFechaPago
    EndIf

    ** Determinar fecha alta sistema externo
    &tmpFechaAlta := "NULL"
    If NoVacio(pFechaAltaSisExt)
        &tmpFechaAlta := "'" ~ pFechaAltaSisExt ~ "'"
    EndIf

    ** Construir INSERT con todos los campos
    &sql := "INSERT INTO OPERACIONES ("
    &sql := &sql ~ "NrOperacion, TipoOp, FechaOp, FechaVto, FechaPago, "
    &sql := &sql ~ "Cliente1, Especie, ContraEspecie, "
    &sql := &sql ~ "Cantidad, Precio1, Corredor, "
    &sql := &sql ~ "Mercado4, Mercado, Mercado2, "
    &sql := &sql ~ "Book1, Vehiculo1, Operador, "
    &sql := &sql ~ "RB5, Plazo, FormaLiquidacion1, FormaLiquidacion2, "
    &sql := &sql ~ "TablaFeriados1, NrExterno, NrOrden1, OpSIOPEL, Observaciones, "
    &sql := &sql ~ "RB6, RB9, Cartera, CB6, CB7, CB10, Convenio, "
    &sql := &sql ~ "AfectaLS, OperacionRef, TotalAux8, "
    &sql := &sql ~ "Cuenta1, Cuenta2, Cuenta3, Cuenta4, Cuenta5, Cuenta6, "
    &sql := &sql ~ "FechaAltaSisExterno, "
    &sql := &sql ~ "FechaCarga, TotalBrutoCli1"
    &sql := &sql ~ ") VALUES ("
    &sql := &sql ~ "'" ~ &nrOperacion ~ "', "
    &sql := &sql ~ "'TIC', "
    &sql := &sql ~ "'" ~ pFechaOp ~ "', "
    &sql := &sql ~ "'" ~ pFechaVto ~ "', "
    &sql := &sql ~ "'" ~ &tmpFechaPago ~ "', "
    &sql := &sql ~ "LEFT('" ~ pCliente1 ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pEspecie ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pContraEspecie ~ "', 10), "
    &sql := &sql ~ pCantidad ~ ", "
    &sql := &sql ~ pPrecio1 ~ ", "
    &sql := &sql ~ "LEFT('" ~ pCorredor ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pMercado4 ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pMercado ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pMercado2 ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pBook1 ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pVehiculo1 ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ &operador ~ "', 30), "
    &sql := &sql ~ pRb5 ~ ", "
    &sql := &sql ~ pPlazo ~ ", "
    &sql := &sql ~ pFormaLiq1 ~ ", "
    &sql := &sql ~ pFormaLiq2 ~ ", "
    &sql := &sql ~ "LEFT('" ~ pFeriados ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pNrExterno ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pNrOrden1 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pOpSIOPEL ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pObs ~ "', 255), "
    &sql := &sql ~ pRb6 ~ ", "
    &sql := &sql ~ pRb9 ~ ", "
    &sql := &sql ~ pCartera ~ ", "
    &sql := &sql ~ pCb6 ~ ", "
    &sql := &sql ~ pCb7 ~ ", "
    &sql := &sql ~ pCb10 ~ ", "
    &sql := &sql ~ pConvenio ~ ", "
    &sql := &sql ~ "LEFT('" ~ pAfectaLS ~ "', 10), "
    &sql := &sql ~ "LEFT('" ~ pOperacionRef ~ "', 20), "
    &sql := &sql ~ pTotalAux8 ~ ", "
    &sql := &sql ~ "LEFT('" ~ pCuenta1 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pCuenta2 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pCuenta3 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pCuenta4 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pCuenta5 ~ "', 20), "
    &sql := &sql ~ "LEFT('" ~ pCuenta6 ~ "', 20), "
    &sql := &sql ~ &tmpFechaAlta ~ ", "
    &sql := &sql ~ "GETDATE(), "
    &tmpBruto := pCantidad * pPrecio1
    &sql := &sql ~ &tmpBruto
    &sql := &sql ~ ")"

    Execute(&sql)

    &importe := pCantidad * pPrecio1

    return ${ NrOperacion = &nrOperacion, Importe = &importe, Success = true }
end
