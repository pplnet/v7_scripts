act(z95,sql("select razonsocial from dbo.clientes where codigo = '"~dialogo.cliente1~"'"))
act(z96,sql("select nombre from dbo.especies where codigo = '"~VAR('MONELOCA')~"'"))
act(d:1,VAR('DEPOSITANT'))
If SQL("SELECT count(*) FROM "~DBO~".Cuentas where Cliente ='"~Dialogo.Cliente1~"' and comitente = '"~VAR('VEHICULODE')~"' and Especies like '%"~VAR('MONELOCA')~"|%' and TipoCuenta = 'VIS' and Mercado = '"~VAR('MERCADOBT')~"'") = 0
    SQL.ADD("INSERT INTO "~DBO~".Cuentas (Codigo, Nombre, Cliente, Comitente, Mercado, Especies,TipoCuenta, Estado,fechaalta)")
    SQL.ADD("VALUES('"~Getnumerador(901)~"', substring('"~Mayusculas2(COPY(val(z95),1,36))~" - "~val(z96)~"',1,50)  , '"~Dialogo.Cliente1~"','"~VAR('VEHICULODE')~"','"~VAR('MERCADOBT')~"' , '"~VAR('MONELOCA')~"|','VIS' ,'HAB','"~idxdate(Fsys)~"')")
    SQL.NEW
    SQL.EXEC
    Message("Cuenta Moneda Local")
EndIf

*act(z96,sql("select nombre from dbo.especies where codigo = '"~VAR('MONEEXTR')~"'"))
act(z96,'Dolar')
If SQL("SELECT count(*) FROM "~DBO~".Cuentas where Cliente ='"~Dialogo.Cliente1~"' and comitente = '"~VAR('VEHICULODE')~"' and  Especies like '%"~VAR('MONEEXTR')~"|%' and TipoCuenta = 'VIS' and Mercado = '"~VAR('MERCADOBT')~"'") = 0
    SQL.ADD("INSERT INTO "~DBO~".Cuentas (Codigo, Nombre, Cliente,Comitente, Mercado, Especies,TipoCuenta, Estado,fechaalta)")
    SQL.ADD("VALUES('"~Getnumerador(901)~"', substring('"~Mayusculas2(COPY(val(z95),1,36))~" - "~val(z96)~" MEP ',1,50), '"~Dialogo.Cliente1~"','"~VAR('VEHICULODE')~"','"~VAR('MERCADOBT')~"' , '"~VAR('MONEEXTR')~"|' ,'VIS' ,'HAB','"~idxdate(Fsys)~"')")
    SQL.NEW
    SQL.EXEC
    Message("Cuenta Dolares Local")
EndIf

*act(z96,sql("select nombre from dbo.especies where codigo = '"~VAR('MONEEXTR')~"'"))
act(z96,'Dolar')
If SQL("SELECT count(*) FROM "~DBO~".Cuentas where Cliente ='"~Dialogo.Cliente1~"' and Especies like '%"~VAR('MONEEXTR')~"|%'  and TipoCuenta = 'VIS' and Mercado = '"~VAR('MERINCAB')~"'") = 0
    SQL.ADD("INSERT INTO "~DBO~".Cuentas (Codigo, Nombre, Cliente, Mercado, Especies,TipoCuenta, Estado,fechaalta)")
    SQL.ADD("VALUES('"~Getnumerador(901)~"', substring('"~Mayusculas2(COPY(val(z95),1,36))~" - "~val(z96)~" Cable ',1,50), '"~Dialogo.Cliente1~"','"~VAR('MERINCAB')~"' , '"~VAR('MONEEXTR')~"|' ,'VIS' ,'HAB','"~idxdate(Fsys)~"')")
    SQL.NEW
    SQL.EXEC
    Message("Cuenta Dolares Exterior")
EndIf

If SQL("SELECT count(*) FROM "~DBO~".Cuentas where Cliente ='"~Dialogo.Cliente1~"' and Especies = 'TITULO|' and TipoCuenta = 'CUS' and Mercado = 'CV'") = 0
    SQL.ADD("INSERT INTO "~DBO~".Cuentas (Codigo, Nombre, Cliente, Comitente, NrDepositante, Mercado, Especies,TipoCuenta, Estado,fechaalta)")
    SQL.ADD("VALUES('"~Getnumerador(901)~"', substring('"~Mayusculas2(COPY(val(z95),1,36))~" - Custodia ',1,50), '"~Dialogo.Cliente1~"','"~VAR('VEHICULODE')~"' ,'"~VAL(d1)~"' ,'CV' , 'TITULO|' ,'CUS' ,'HAB','"~idxdate(Fsys)~"')")
    SQL.NEW
    SQL.EXEC
    Message("Cuenta Custodia")
EndIf


