Recorrer SQL

   Message('Reversando Especie '~FBN['Codigo'] )

   SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
   SQL.ADD("(FechaMov,Cliente,Vehiculo,NrSaldo,Especie, ")
   SQL.ADD("FechaEj,Cantidad,Precio,TipoNegocio,NrOperacion,Tipo) ")
   SQL.ADD(" SELECT FechaMov,Cliente,Vehiculo,")
   SQL.ADD(" NrSaldo,Especie,FechaEj,-Cantidad,Precio,TipoNegocio,NrOperacion,Tipo  ")
   SQL.ADD(" FROM "~DBO~".MOVPOSEJE Where ")
   SQL.ADD(" Especie = '"~FBN['Codigo']~"' ")
   SQL.NEW
   SQL.EXEC

   *- Reverso los saldos 2 y 10 no afectados por la liquidacion de cupon
   SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("(NrOperacion,FechaMov,Cliente,Especie, ")
   SQL.ADD("Cantidad,Leyenda,Bits,NrSaldo,NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan) ")
   SQL.ADD(" SELECT NrOperacion,FechaMov,Cliente,Especie,Cantidad,Leyenda,Bits,NrSaldo,NrGrupo,FechaEje,NrGrupo2,NrMov,NrInstan ")
   SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS Where ")
   SQL.ADD(" Especie = '"~FBN['Codigo']~"' and NrSaldo in (2,10)")
   SQL.NEW
   SQL.EXEC
