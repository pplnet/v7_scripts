      recorrer&i 1,Fac
        if Val(q:&i) = 1
           if Val(bo:&i)=1
              * Voucher MATCH
              * Inicio Func GENMATDBO
              ***********************
              (.'GENMATDBO'.)
              ***********************
              * Fin Func GENMATDBO
           else
              * Vouchers DEP,RET,COMP
              * Inicio Func GENVOUDBO
              ***********************
              (.'GENVOUDBO'.)
              ***********************
              * Fin Func GENVOUDBO
           endif
           SQL.EXEC
            
           if Val(k:&i)=0 
* FJL 16/06/23 - Por error de Memoria Insuficiente
*               EjecutarEvento('DESPRF',NrTrans1=Val(n:&i),Fecha1=Habiles(Dialogo.Fecha1,1,'ARG'),Fecha2=Dialogo.Fecha1)
               EjecutarEvento2('DESPRF',NrTrans1=Val(n:&i),Fecha1=Habiles(Dialogo.Fecha1,1,'ARG'),Fecha2=Dialogo.Fecha1)
           endif
           if NoVacio(Val(i:&i))
             if EqStr(Val(me:&i),'TITULO')
               SQL.ADD(" Update "~DBO~".OPERACIONES ")
* FJL 26/01/24 - Por Issue 6591 de BACS - Operaciones de Garantizado CP va Cuenta1
*               SQL.ADD(" Set Cuenta2 = '"~Val(s:&i)~"', ")
*               SQL.ADD("     Plaza1  = '"~Val(s:&i)~"' ")
*PZ 18/07/2024 agrego cta cliente por si la cambiaron
               SQL.ADD(" Set Cuenta2 = '"~Val(s:&i)~"', ")
               SQL.ADD("     Cuenta1 = '"~Val(r:&i)~"'  ")              
               SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
               SQL.NEW
               SQL.EXEC
            
* FJL 26/01/24 - Por Issue 6591 de BACS - Operaciones de Garantizado CP va Cuenta1
               SQL.ADD("Update "~DBO~".OPERACIONES ")
               SQL.ADD("   Set Plaza1  = Cuenta1 ")
               SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
               SQL.ADD("   and Cliente1    = Vehiculo1 ")
               SQL.NEW
               SQL.ADD("Update "~DBO~".OPERACIONES ")
               SQL.ADD("   Set Plaza1  = Cuenta2 ")
               SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
               SQL.ADD("   and Cliente1    <> Vehiculo1 ")
               SQL.NEW
               SQL.EXEC

               * FJL 14/2/19 - Saco esto porque falla en liquidacion con diferimientos parciales
* Hay que hacerlo en forma manual para saldos 122
               ** Actualizo Movimientos de Posicion de la operacion
*               SQL.ActualizarMovimientos3(Val(i:&i),NO,NO,NO,SI,NO)
*               SQL.EXEC
             endif
             if EqStr(Val(me:&i),'MONEDA')
               if Incluido(val(ts:&i),'MMCO|MMCT|')
                  SQL.ADD(" Update "~DBO~".OPERACIONES ")
                  SQL.ADD(" Set Cuenta1 = '"~Val(s:&i)~"', ")
                  SQL.ADD("     Cuenta2 = '"~Val(s:&i)~"', ")
                  SQL.ADD("     Cuenta3 = '"~Val(r:&i)~"', ")
                  SQL.ADD("     Cuenta4 = '"~Val(r:&i)~"'  ")
                  SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
                  SQL.NEW
                  SQL.EXEC
               else
                  * Posiblemente no se necesite en general
                  IF Not Incluido(val(ts:&i), 'FXC|FXV|FXJ|')
                     SQL.ADD(" Update "~DBO~".OPERACIONES ")
                     SQL.ADD(" Set Cuenta3 = '"~Val(s:&i)~"' ")
                     SQL.ADD(" Where NrOperacion = '"~Val(i:&i)~"' ")
                     SQL.NEW
                     SQL.EXEC
                  endif   
               endif   
             endif
           endif
           if Eqstr(VAR('LIQUNPASO'),'SI')
              Message('Generando Transaccion de Custodia ...')
* FJL 16/06/23 - Por error de Memoria Insuficiente
*              EjecutarEvento('CONFOP',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,Especie1=Dialogo.Especie1,Mercado1=Dialogo.Mercado1,Cuenta1='',Vehiculo1=Dialogo.Vehiculo1, String1=Val(nu:1),NrTrans1=Val(n:&i),Check1=0,Check2=1) 
              EjecutarEvento2('CONFOP',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,Especie1=Dialogo.Especie1,Mercado1=Dialogo.Mercado1,Cuenta1='',Vehiculo1=Dialogo.Vehiculo1, String1=Val(nu:1),NrTrans1=Val(n:&i),Check1=0,Check2=1) 
           endif
        endif

        *Message('Pasando Operaciones a Terminal ...')
        *EjecutarEvento('PPASE',NrOperacion=val(i:&i), Mercado1='')
      proximo
   endif
   
   *   message('Generando Transaccion de Custodia ...')
   *      EjecutarEvento('CONCUS',Vehiculo1=Dialogo.Vehiculo1, String1=Val(nu1)) 
   *   messageBOX('SALE...'~Val(nu1))

endif
