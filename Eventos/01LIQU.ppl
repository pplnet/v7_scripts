(.'CONTMEM'.)

CrearDialogo
  Vehiculo1: 'Vehiculo'      ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   : 'Fecha Liq.'    ; 2;1;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
  Check11  : 'Incluye Pend'  ; 2;2;;;;;;;0;
  Mercado1 : 'Mercado'       ; 3;1;;;;[NoVacio(Dialogo.Mercado1) y Not Incluido(Dialogo.Mercado1, VAR('MERCTITULO'))] o Dialogo.Check6=0;'Debe ingresar un Mercado';NO;;;;;;" (Netea='NO' or Netea is Null) and Observaciones like ('T|') "
  Cliente1 : 'Cliente'       ; 4;1;;;;NoVacio(Dialogo.Cliente1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar un Cliente';NO;
  Especie1 : 'Especie'       ; 5;1;;;;NoVacio(Dialogo.Especie1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar una Especie';NO;
  Check1   : 'Titulos'       ; 7;1;;;Dialogo.Check12=0 o SI;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check10+Dialogo.Check12>0;'Debe seleccionar un grupo de operaciones';NO;1;IIF(Dialogo.Check12=1,0,Dialogo.Check1)
  Check2   : 'F.Exchange'    ; 8;1;;;Dialogo.Check12=0 o SI ;;;;1;
  Check3   : 'M.Market'      ; 7;2;;;Dialogo.Check12=0 o SI ;;;;1;IIF(Dialogo.Check12=1,0,Dialogo.Check3)
  Check4   : 'Prestamos'     ; 8;2;;;Dialogo.Check12=0  ;;;;0;
  *Check12  : 'Futuros'       ; 9;1;;;;Dialogo.Check5+Dialogo.Check12=2 o Dialogo.Check12=0;'Liquidando ROFEX se debera COMPENSAR';NO;IIF(Dialogo.Check13=1,0,Dialogo.Check12);IIF(Dialogo.Check13=1,0,Dialogo.Check12)
  Check12  : 'Futuros'       ; 9;1;;;;Dialogo.Check5+Dialogo.Check12+Dialogo.Check13=2 o Dialogo.Check12=0;'Liquidando Futuros se debera COMPENSAR';NO;;  
  Check9   : 'Netea Mon.'    ; 3;2;;Dialogo.Check6=1;Dialogo.Check6=1;;;;0;
  *  AA 31-01-2023 para Comisiones FM ROFEX saque default y recalculo y funciona ok
  *  Check5   : 'Compensar Op.' ; 4;2;;;;Dialogo.Check5+Dialogo.Check6<2;'No se puede Compensar y Seleccionar al mismo tiempo';NO;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,1,0);IIF(Dialogo.Check12=1 o Dialogo.Check13=1,1,0)
  Check5   : 'Compensar Op.' ; 4;2;;;;Dialogo.Check5+Dialogo.Check6<2;'No se puede Compensar y Seleccionar al mismo tiempo';NO;IIF(Dialogo.Check13=1,0,IIF(Dialogo.Check12=1,1,0));IIF(Dialogo.Check13=1,0,IIF(Dialogo.Check12=1,1,0))
  Check6   : 'Seleccionar'   ; 5;2;;  ;  ;;;;0;
** FJL Poner defalt=1-No Editable-visible
  Check8   : 'Procesa'       ;11;1;;NO;NO;;;;1;
  Check7   : 'Liq.Automatica';11;2;;NO;NO;;;;0;
  Check10  : 'Falla OCT'     ; 1;2;;NO;NO;;;;0;IIF(Dialogo.Check12=1 o Dialogo.Check13=1,0,Dialogo.Check10)
  *  AA 31-01-2023 para comisiones FM ROFEX saque default y recalculo y funciona ok
  *  Check13  : 'Comisiones'    ;10;1;;SI;SI;Dialogo.Check5+Dialogo.Check13=2 o Dialogo.Check13=0 o SI;'Liquidando Comision MAE1 se debera COMPENSAR';NO;IIF(Dialogo.Check12=1,0,Dialogo.Check13);IIF(Dialogo.Check12=1,0,Dialogo.Check13)
  Check13  : 'Comisiones'    ;10;1;;SI;SI;Dialogo.Check5+Dialogo.Check13=2 o Dialogo.Check13=0 o SI;'Liquidando Comisiones se debera COMPENSAR';NO;;  
FinDialogo

if Not Ok
   Cancelar
endif

If Dialogo.Check8=0
   HojaVisible(SI)
endif

if NoVacio(Dialogo.Mercado1)
   if Incluido(Dialogo.Mercado1,Var('MERCAACMC'))
     Cancelar('No es posible liquidar un mercado neteado, se cancela')
   endif
endif


SQL.ADD("Select M.FechaMov,      M.Cliente,       M.Especie,  CASE WHEN  M.Cupon Is Null THEN '0' WHEN M.Cupon='' THEN '0' WHEN M.Cupon=' ' THEN '0' ELSE M.Cupon END Cupon,    ")
SQL.ADD("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
SQL.ADD("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
SQL.ADD("       O.TipoOp Tipo,   Case When TipoOp = 'CONU' Then O.Mercado2 Else O.Mercado End MercO, ")
SQL.ADD("       'OP' Voucher , O.NrOperacion OperOrig, O.RB10, O.Cuenta2, C.CategDepositante, M.NrGrupo, M.Leyenda, O.Mercado4 MercaNeg ")

SQL.ADD("FROM "~DBO~".MOVPENDIENTES M JOIN "~DBO~".OPERACIONES O ON M.NrOperacion = O.NrOperacion")
SQL.ADD("JOIN "~DBO~".OPERACIONESBITS B ON M.NrOperacion = B.NrOperacion ")
SQL.ADD("JOIN "~DBO~".CLIENTES C ON M.Cliente = C.Codigo ")

SQL.ADD("WHERE M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
**SQL.ADD("and M.Cliente = O.Cliente1 ")
**Para ICL el cliente es AFIP Cliente2
**Para MAV el cliente es CLIMAV Cliente4
SQL.ADD("and (M.Cliente = O.Cliente1 or M.Cliente = O.Cliente2  or M.Cliente = O.Cliente4) ")

SQL.ADD("and M.NrSaldo = 1   ")
if Dialogo.Check1=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'PM' ")
endif
if Dialogo.Check12=0
  SQL.ADD("and M.Concepto not in ('FM','FT') ")
endif
if Dialogo.Check13=1
   SQL.ADD("and M.NrGrupo in(15, 16)   ") 
else
   SQL.ADD("and (M.NrGrupo not in(15, 16) or M.NrGrupo is Null)  ") 
endif
if Dialogo.Check11=0
   SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
else
   SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
endif
SQL.ADD("and M.Bits in ('MV','MI') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("and M.Mercado not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and ((M.Status <> 'MATCH' or M.Status = '' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
SQL.ADD("and (B.NrBit in ('10','70') and B.Valor = '1')  ")

* No se liquida el Garantizado por aca
SQL.ADD("and ((IsNull(O.CB4,'0')=0 and O.Cliente1<>O.Vehiculo1 and O.TipoOp in('TIC','TIV')) or (O.TipoOp Not in('TIC','TIV')) ) ")

SQL.ADD("union ")                
SQL.ADD("Select M.FechaMov,      M.Cliente,       M.Especie,  CASE WHEN  M.Cupon Is Null THEN '0' WHEN M.Cupon='' THEN '0' WHEN M.Cupon=' ' THEN '0' ELSE M.Cupon END Cupon,    ")
SQL.ADD("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
SQL.ADD("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
SQL.ADD("       T.TipoTr2 Tipo,  T.Mercado1 MercO , 'TR' Voucher , T.NrOperacionRef1 OperOrig, 0 RB10, '' Cuenta2 , C.CategDepositante, M.NrGrupo, M.Leyenda, '' MercaNeg  ")

SQL.ADD("FROM "~DBO~".MOVPENDIENTES M JOIN "~DBO~".TRANSACCIONES2 T ON M.NrOperacion = T.NrTrans ")
SQL.ADD("JOIN "~DBO~".OPERACIONESBITS B ON M.NrOperacion = B.NrOperacion ") 
SQL.ADD("JOIN "~DBO~".CLIENTES C ON M.Cliente = C.Codigo ")

SQL.ADD("WHERE M.Cliente = T.Cliente1 ")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check1=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'PM' ")
endif
if Dialogo.Check12=0
*  SQL.ADD("and M.Concepto <> 'RF' ")
  SQL.ADD("and M.Concepto not in ('FM','FT') ")
endif
*if Dialogo.Check10=0
*  SQL.ADD("and M.Concepto <> 'OCT' ")
*ENDIF
if Dialogo.Check11=0
   SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
else
   SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
endif
if Dialogo.Check13=1
   SQL.ADD("and M.NrGrupo in(15,16)   ") 
else
   SQL.ADD("and (M.NrGrupo not in(15,16) or M.NrGrupo is Null)  ") 
endif
SQL.ADD("and M.Bits in ('MV','MI') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("and M.Mercado not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
***---Las OCT estan en Terminal
***---SQL.ADD(" AND ((B.NrBit = 5 AND T.TipoTr2 <> 'LIQOCT') OR (B.NrBit = 4 AND T.TipoTr2 IN ('LIQOCT','PDIVID'))) ")
SQL.ADD(" AND ((B.NrBit = 5 AND T.TipoTr2 <> 'LIQOCT') OR (B.NrBit = 4 AND T.TipoTr2 IN ('LIQOCT'))) ")
SQL.ADD("and B.Valor = '1' ")
* Cliente / MercM / Cuenta / Especie / Cupon / Concepto / Fecha / NrOperacion / NrGrupo / MercaNeg / NrMov
SQL.ADD("Order By 2, 9, 10, 3, 4, 11, 1, 6, 20, 22, 8 ")
watch(SQL.Batch)
ACT(aa:0, 'aa DVP')
ACT(ab:0, 'ab RVP')
ACT(ac:0, 'ac Conf')
ACT(ad:0, 'ad MATCH')
ACT(ae:0, 'ae Vacio')
ACT(af:0, 'af (aa..ae)')
ACT(ag:0, 'ag DVP')
ACT(ah:0, 'ah RVP')
ACT(ai:0, 'ai Conf')
ACT(aj:0, 'aj MATCH')
ACT(ak:0, 'ak Vacio')
ACT(al:0, 'al (ag..ak)')
ACT(am:0, 'am DVP')
ACT(an:0, 'an RVP')
ACT(ao:0, 'ao Conf')
ACT(ap:0, 'ap MATCH')
ACT(aq:0, 'aq Vacio')
ACT(ar:0, 'ar (am..aq)')
ACT(as:0, 'as (al+ar)')
ACT(at:0, 'at')
