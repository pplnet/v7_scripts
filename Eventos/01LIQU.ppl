ACT(bh:0, 'bh RVP')
ACT(bi:0, 'bi Conf')
ACT(bj:0, 'bj MATCH')
ACT(bk:0, 'bk Vacio')
ACT(bl:0, 'bl (bg..bk)')

ACT(a:0,'Cliente'  )
ACT(b:0,'Mercado'  )
ACT(c:0,'Concepto' )
ACT(d:0,'Accion'   )
ACT(e:0,'Especie'  )

*ACT(f:0,  )
*ACT(g:0,  )
*ACT(h:0,  )

ACT(i:0,'Operacion '  )

*ACT(j:0,  )
*ACT(k:0,  )

ACT(r:0,'Cta Cliente'  )
ACT(s:0,'Cta propia '  )
ACT(nr:0,'Nro de Grupo'  )
ACT(bn:0,'M.Negociacion'  )

ACT(bp:0,'Tipo Transf' )
ACT(bq:0,'Matching ' )
ACT(br:0,'Ejecucion ' )
ACT(bs:0,'Color Fila ' )

ACT(cr:0,'Cta Cliente Original'  )

recorrer SQL;;SI
  SCN(bz:1,1)
  ACT(ca:Val(bz:1), FBN['NrOperacion'])
  ACT(cb:Val(bz:1), FBN['Tipo'])
  ACT(cc:Val(bz:1), FBN['MercM'])
  ACT(cd:Val(bz:1), FBN['Especie'])
  ACN(ce:Val(bz:1), FBN['Cantidad'])
  ACT(cf:Val(bz:1), FBN['Cliente'])
  ACD(cg:Val(bz:1), FBN['FechaMov'])
  ACT(ch:Val(bz:1), FBN['Status'])
  ACT(ci:Val(bz:1), FBN['Cuenta'])
  ACT(cj:Val(bz:1), FBN['Concepto'])
  ACN(ck:Val(bz:1), FBN['NrGrupo2'])
  ACT(cm:Val(bz:1), FBN['OperOrig'])
  ACN(cn:Val(bz:1), IIF(EqStr(fbn('CategDepositante'),'CLI'),1,0) )
  ACT(cz:Val(bz:1), FBN['Leyenda'])
  ACN(kl:Val(bz:1), Val(bz:1) )
  ACT(mn:Val(bz:1), FBN['MercaNeg'])

** FJL 16/10/22 - Para desbloqueqar TIDE
  ACN(dj:Val(bz:1), 2)
  if EqStr(Val(cb:Val(bz:1)),'TIDE')
    ACD(co:Val(bz:1), BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Val(cm:Val(bz:1))))
    *    if Val(co:Val(bz:1))=Val(co:Val(bz:1))
    if Val(cg:Val(bz:1))=Val(co:Val(bz:1))
      * El movimiento es de la fecha de la operacion
      ACN(dj:Val(bz:1), 1)
      ACN(dk:Val(bz:1), -FBN['Cantidad'])
    endif
  endif
  SCN(x4,1)


*MessageBox(' Clie '~FBN['Cliente']~'  v1 '~Val(v1)  )
*MessageBox(' Concepto '~FBN['Concepto']~'  v2 '~Val(v2)  )
*messageBox(' MercM  '~FBN['MercM']~'  v3 '~Val(v3)  )
*MessageBox(' Cuenta '~FBN['Cuenta']~'  v4 '~Val(v4)  )
*MessageBox(' Especie  '~FBN['Especie']~'  v5 '~Val(v5)  )
*MessageBox(' Cupon '~FBN['Cupon']~'  v6 '~Val(v6)  )


  if Not EqStr(FBN['Cliente'],Val(v1)) o  Not [EqStr(FBN['Concepto'],Val(v2)) o Dialogo.Check9=1] o Not EqStr(FBN['MercM'],Val(v3)) o Not EqStr(FBN['Cuenta'],Val(v4)) o Not EqStr(FBN['Especie'],Val(v5)) o Not EqStr(FBN['Cupon'],Val(v6)) o Not EqStr(FBN['NrGrupo'],Val(v7)) o Incluido(FBN['MercM'], VAR('MERCTITULO')) o [Dialogo.Check5 = 0 y Dialogo.Check13=0] o [Dialogo.Check13=1 y Incluido(FBN['Tipo'],'DDC|DDV|FXCF|FXVF|TCOPRI|') y Not EqStr(FBN['NrOperacion'],Val(v8)) ] o Not EqStr(FBN['MercaNeg'],Val(v9))
  
    if FAC>1
      DFA
** FJL 13/12/18 - Por Neteo de MTM Futuros Moneda
      if Val(l:FAC)>1
        ACT(ts:fac, 'Neteo Ops')
      endif
      * Inicio Func LIQUIDADBO
      ***********************
      (.'LIQUIDADBO'.)
      ***********************
      * Fin Func LIQUIDADBO
      IFA
    endif

    BorrarCeldas(v1..v20)
    ACT(v1, FBN['Cliente'])
    ACT(v2, FBN['Concepto'])
    ACT(v3, FBN['MercM'])
    ACT(v4, FBN['Cuenta'])
    ACT(v5, FBN['Especie'])
    ACT(v6, FBN['Cupon'])
    ACT(v7, FBN['NrGrupo'])
    ACT(v8, FBN['NrOperacion'])
    ACT(v9, FBN['MercaNeg'])

    ACN(q:FAC,1) 
    ACT(a:FAC, FBN['Cliente'])
    ACT(b:FAC, FBN['MercM'])
    ACT(c:FAC, FBN['Concepto'])
    ACT(e:FAC, FBN['Especie'])
    ACT(ea:FAC, FBN['Especie'])
    ACT(eb:FAC, FBN['Especie'])
    * Nuevo Nro de Grupo para las comisiones
    ACT(nr:FAC, FSTR(FBN['NrGrupo'],1,0))
    ACT(bn:FAC, FBN['MercaNeg'])

    ACT(TR:fac, fbn('Tipo'))
** FJL 13/12/18 - Por Neteo de MTM Futuros Moneda
    ACT(ts:fac, fbn('Tipo'))
         
    if Eqstr(Val(c:Fac),'MM') y Not Incluido(val(ts:fac), 'DDC|DDV|')
       ACN(q:FAC,0) 
    endif

    if Dialogo.Check5=0
      * NO Compensa
      ACT(i:FAC, FBN['NrOperacion'])
      if Incluido(FBN['Tipo'],'PME')
        ACT(i:FAC, Val(i:FAC)~' Cta.'~FStr(fbn('NrGrupo2'),0,0))
      endif
    endif

    ACT(j:FAC, FBN['Especie'])
    IF Incluido(FBN['Tipo'],'DDC|DDV|')
       ACT(m:FAC, FBN['MercM'])
    else
       ACT(m:FAC, FBN['MercO'])
    endif   
    ACT(r:FAC, FBN['Cuenta'])
    ACT(cr:FAC,FBN['Cuenta'])
    ACT(t:FAC, FBN['Cupon'])
    ACT(z:FAC, FBN['Leyenda'])    

    if Incluido(Val(b:FAC), VAR('MERCTITULO'))
       ACT(u:FAC, FBN['NrOperacion'])
    endif
    ACN(w:FAC, FBN['NrGrupo2'])
    ACT(y:FAC, FBN['NrMov'])
  else
    DFA
    if Not EqStr(FBN['Concepto'],Val(v2))
       ACT(c:FAC, 'Net')
    endif
  endif
  ACN(cl:Val(bz:1), FAC)

** FJL 13/12/2018 - Cambio el criterio por mercados regulados
**                  La celda da: se  usa para mostrar el cliente en la listbox
**                  La celda db: se  usa en la funcion GENVOUDBO para cambiar cliente
  ACT(da:fac, Val(a:FAC))
  ACT(db:fac, Dialogo.Vehiculo1)
  ACN(dc:FAC, 1)
  if Incluido(FBN['Tipo'],'FXCF|FXVF|')
    ACT(dd:fac, BuscarCampo('MERCADOS','Regulado','Codigo',Val(b:fac)))
** FJL 14/12/2018 - Se anula esta modificacion
    if EqStr(Val(dd:fac),'SI') y NO
      ACT(da:fac, BuscarCampo('MERCADOS','Cliente1','Codigo',Val(b:fac)))
      if Vacio(Val(da:fac))
        ACT(da:fac, Val(a:FAC))
      else
        ACT(db:fac, Val(da:FAC))
      endif
      ACN(dc:FAC, -1)
    endif
  endif

** FJL 13/12/2018 - Nuevo Criterio por Futuros de Moneda Regualdo
*  SCN(k:FAC, FBN['Cantidad'])
  SCN(k:FAC, FBN['Cantidad']*Val(dc:FAC))

  SCN(l:FAC, 1)

  if DesciendeDeEspecie(Val(e:FAC),'TITULO') o DesciendeDeEspecie(Val(e:FAC),'CUPON')    
     act(me:Fac,'TITULO') 
     if Incluido(FBN['Voucher'],'TR')
        ACT(s:FAC, BuscarCampo('TRANSACCIONES2','Cuenta2','NrTrans',FBN['NrOperacion']))
     else
        ACT(s:FAC, BuscarCampo('OPERACIONES','Cuenta2','NrOperacion',FBN['NrOperacion']))
     endif
     act(bw:fac,BuscarCampo('CUENTAS','Comitente','Codigo',Val(r:Fac)) )

     if Eqstr(val(b:fac),VAR('CLHODEFA')) y Not EqStr(Val(bw:Fac),VAR('VEHICULODE'))
        ACN(bt:FAC,1) 
     else
        ACN(bt:FAC,0)
*       PZ 22/07/2022 Porque las Ops de de Prestamos obligan a trf inmediata. Ver si hay que poner todas lados Ops asi
*       No hace falta se vuelve a dejar como estaba
*        if Incluido(FBN['Tipo'],'TICO|TICT|TIPO|TIDE')          
*           ACN(bt:FAC,1)
*        else
*           ACN(bt:FAC,0)
*        endif
     Endif

     SCN(f:FAC, -FBN['Cantidad'])

     if EqStr(FBN['Status'],'MATCH')
        ACN(bo:FAC, 1)
        ACT(bp:FAC, BuscarCampo('OPERACIONES','ContraEspecie','NrOperacion',FBN['NrOperacion']))
        ACT(eb:FAC, Val(bp:fac) )

* FJL 02/06/21 - Por opeeraciones con diferimientos parciales
*                Dejo la forma de calcular el monto de la moneda anterior.
*                lo que ponia en bq ahora lo dejo en bx
        if Incluido(FBN['Tipo'],'TIC|TIV|TIFC|TIFV') y BuscarCampo('OPERACIONES','TotalCaucion','NrOperacion',FBN['NrOperacion'])>0
          if Incluido(FBN['Tipo'],'TIC|TIFC|TIADJ')
            ACN(bx:FAC, BuscarCampo('OPERACIONES','TotalCaucion','NrOperacion',FBN['NrOperacion']))
          else
            ACN(bx:FAC, -BuscarCampo('OPERACIONES','TotalCaucion','NrOperacion',FBN['NrOperacion']))
          endif
        else
          if Incluido(FBN['Tipo'],'TIC|TIFC|TIADJ|TCOPRI|')
            ACN(bx:FAC, BuscarCampo('OPERACIONES','TotalNetoCli1','NrOperacion',FBN['NrOperacion']))
          else
            ACN(bx:FAC, -BuscarCampo('OPERACIONES','TotalNetoCli1','NrOperacion',FBN['NrOperacion']))
          endif
        endif
* FJL 02/06/21 - Nuevo criterio x operaciones con diferimientos parciales
        if Dialogo.Check11=0
          ACN(bq:FAC, SQL("SELECT Sum(Cantidad) FROM "~DBO~".MOVPENDIENTES WHERE Nroperacion='"~FBN['NrOperacion']~"' and Especie='"~Val(bp:FAC)~"' and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' "))
        else
          ACN(bq:FAC, SQL("SELECT Sum(Cantidad) FROM "~DBO~".MOVPENDIENTES WHERE Nroperacion='"~FBN['NrOperacion']~"' and Especie='"~Val(bp:FAC)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' "))
        endif

        ACT(br:FAC, BuscarCampo('OPERACIONES','Cuenta4','NrOperacion',FBN['NrOperacion']))
        ACT(bs:FAC, BuscarCampo('OPERACIONES','Cuenta2','NrOperacion',FBN['NrOperacion']))

        ACT(e:FAC, Val(e:FAC)~'/'~Val(bp:FAC))
        ACN(g:FAC, -Val(bq:FAC))
    else
        ACN(g:FAC, 0)
    endif
  else
     act(me:Fac,'MONEDA')
     ACN(f:FAC, 0)
** FJL 13/12/2018 - Por Futuros de Moneda Regualdo
*     SCN(g:FAC, -FBN['Cantidad'])
     SCN(g:FAC, -FBN['Cantidad']*Val(dc:FAC))

     If Incluido(FBN['Voucher'],'TR')
        ACT(s:FAC, BuscarCampo('TRANSACCIONES2','Cuenta2','NrTrans',FBN['NrOperacion']))
     Else
     * PZ 02/10/2018 agregué los futuros
     If Incluido(FBN['Tipo'],'TIC|TIV|TIFC|TIFV|TICO|TICT|TIDE|TIPO|TCOPRI|FXCF|FXVF|TCPCEM')
          ACT(s:FAC, BuscarCampo('OPERACIONES','Cuenta3','NrOperacion',FBN['NrOperacion']))
          If fbn('NrGrupo')=15 o fbn('NrGrupo')=16
             * NrGrupo = 15 -> Mov de Comision MAE1
* FO 24/10/2006 Agrego HAB a la funcion
* FJL 19/02/19 - Se reemplaza por orden nuevo
*             ACT(s:FAC, CUENTACLIENTE(Dialogo.Vehiculo1,Val(e:fac),,fbn('MercM'),fbn('Tipo'),'HAB') )
             SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
             SQL.ADD(" WHERE Cliente  = '"~Dialogo.Vehiculo1~"' ")
             SQL.ADD("   and (Especies Like '%MONEDA%' or Especies LIKE '%"~Val(e:fac)~"%') ")
             SQL.ADD("   AND Estado   = 'HAB' ")
             SQL.ADD("   AND Mercado  = '"~fbn('MercM')~"' ")
             SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")
             Recorrer SQL
               dfa
               act(s:FAC, FBN['Codigo'])
             Proximo
          Endif
       Else
*messagebox(fbn['NrOperacion'])       
          IF (Incluido(fbn('Tipo'), 'FXCT|FXVT') Y fbn('RB10') = 1) or Incluido(FBN['Tipo'],'PICO|PICD|CONU')
             ***---NDF
             ACT(S:fac, fbn('Cuenta2'))
          ELSE
             if Incluido(FBN['Tipo'],'DDC|DDV|')
                ACT(s:FAC, BuscarCampo('OPERACIONES','Cuenta3','NrOperacion',FBN['NrOperacion']))
             else   
                If EqStr(Val(e:FAC),BuscarCampo('OPERACIONES','Especie','NrOperacion',FBN['NrOperacion']))
                   ACT(s:FAC, BuscarCampo('OPERACIONES','Cuenta1','NrOperacion',FBN['NrOperacion']))
                Else
                   ACT(s:FAC, BuscarCampo('OPERACIONES','Cuenta2','NrOperacion',FBN['NrOperacion']))
                Endif
           Endif     
          ENDIF
       Endif
     Endif
  endif

  if FBN['Cantidad']<0
    ACN(x2,0)
  else
    ACN(x2,6)
  endif
  if EqStr(FBN['Status'],'DVP')
    ACN(aa:FAC ,1)
    SCN(33+Val(x2):FAC ,FBN['Cantidad'])
    ACN(47+Val(x2):FAC ,1)
  endif
  if EqStr(FBN['Status'],'RVP')
     ACN(ab:FAC, 1)
     SCN(34+Val(x2):FAC, FBN['Cantidad'])
     ACN(48+Val(x2):FAC, 1)
  endif
  if EqStr(FBN['Status'],'CONF')
    ACN(ac:FAC, 1)
    SCN(35+Val(x2):FAC, FBN['Cantidad'])
    ACN(49+Val(x2):FAC, 1)
  endif
  if EqStr(FBN['Status'],'MATCH')
    ACN(ad:FAC, 1)
    SCN(36+Val(x2):FAC, FBN['Cantidad'])
    ACN(50+Val(x2):FAC, 1)
  endif
  if Vacio(FBN['Status'])
    ACN(ae:FAC, 1)
    SCN(37+Val(x2):FAC, FBN['Cantidad'])
    ACN(51+Val(x2):FAC, 1)
  endif
  
proximo


if Val(x4)>0
** FJL 13/12/18 - Por Neteo de MTM Futuros Moneda
  if Val(l:FAC)>1
    ACT(ts:fac, 'Neteo Ops')
  endif
  * Inicio Func LIQUIDADBO
  ***********************
  (.'LIQUIDADBO'.)
  ***********************
  * Fin Func LIQUIDADBO
else
  if NoVacio(Dialogo.Cliente1)
    if NoVacio(Dialogo.Especie1)
      Cancelar('El Cliente '~Dialogo.Cliente1~' no tiene movimientos pendientes en la especie '~Dialogo.Especie1~'.')
    else
      Cancelar('El Cliente '~Dialogo.Cliente1~' no tiene movimientos pendientes.')
    endif
  else
    if NoVacio(Dialogo.Especie1)
      Cancelar('No existen movimientos pendientes en la especie '~Dialogo.Especie1~'.')
    else
      Cancelar('No existen movimientos pendientes.')
    endif
  endif
endif

