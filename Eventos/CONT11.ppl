MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;3;1;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif


IF Dialogo.Radio1 = 2 O Dialogo.Radio1 = 4
    IF FinDeMes(Dialogo.Fecha1)=Dialogo.Fecha1
       message('--- Asientos Revaluo Fin de Mes NDF ---')
       ACD(FE:1, PriDeMes(Dialogo.Fecha1))
       ACT(TA:1, Var('TIPASRVNDF'))
       ACN(NA:1, Var('ASINUM'))
       ACT(VC:1, Dialogo.Vehiculo1)
       ACN(XX:1,0)
       ACN(XX:2,0)
       SQL.ADD("SELECT '"~IdxDate(Dialogo.Fecha1)~"' as  Fecha, O.Vehiculo1, ")
       SQL.ADD("       (Select sum(MTM) from "~DBO~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' and MD.Fecha >= "~IdxDate2(Val(FE:1))~" and MD.Fecha <= "~IdxDate2(Dialogo.Fecha1)~") as AcumARPMTM, ")
       SQL.ADD("       O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, C.PaisDir,O.Cuenta4 as Cuenta1, ")
       SQL.ADD("       O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Especie, O.Book1, ")
       SQL.ADD("       (SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo=O.Especie and Fecha="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' ) as Cotizacion ,")
       SQL.ADD("       O.TipoOp, O.NrOperacion, O.Cliente1 Cliente , O.Mercado4, ")
       SQL.ADD("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
       SQL.ADD("       (Select sum(MTMEspecie) from "~DBO~".MTMDIARIO MD1 Where MD1.NrOperacion = O.NrOperacion and MD1.TipoMTM = 'MTM' and MD1.Fecha >= "~IdxDate2(Val(FE:1))~" and MD1.Fecha <= "~IdxDate2(Dialogo.Fecha1)~" ) as AcumEspMTM ")
       SQL.ADD("  FROM "~DBO~".MODELOSASIENTO MA, "~DBO~".MERCADOS M, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
       SQL.ADD(" WHERE O.TipoOp IN ('FXCF','FXVF') ")
       SQL.ADD("   AND C.Codigo       = O.Cliente1 ")
       SQL.ADD("   AND MA.TipoAsiento = '"~Var('TIPASRVNDF')~"' ")
       SQL.ADD("   AND O.FechaOp      <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("   AND O.FechaVto     >= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("   AND O.Mercado4     = M.Codigo ")
       SQL.ADD("   AND M.MTM          = 0 ")
       SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
       SQL.ADD(" AND MA.Habilitado = 'SI' ")
       Recorrer SQL
         ACD(FV:1, Dialogo.Fecha1)
         ACD(FD:1, Dialogo.Fecha1)
         ACT(VH:1, fbn('Vehiculo1'))
         ACT(TO:1, fbn('CodAsi'))
         ACT(TI:1, '')  
         ACT(NR:1, fbn('NrOperacion'))
         ACT(NR:2, '')  
         ACN(RE:1, fbn('AcumARPMTM')-(fbn('AcumEspMTM')*fbn('Cotizacion')))
         If EqStr(fbn('Mercado4'),Var('MERROFEX'))
            ACT(CT:1,var('RDOROFEX'))
         Else
            ACT(CT:1,SQL("Select Cuenta from "~DBO~".RELACIONCUENTA   where Book = '"~fbn('Book1')~"' and CodigoRelacion = 'RDONDF' and TiposOperacion Like '%"~fbn('TipoOp')~"%' ")) 
         Endif         
         ***---(.'GENASIENTO'.)
         ACN(CK:1, 0)
         IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                ACN(CK:1, 0)
            ENDIF
         ENDIF
         IF Val(CK:1) = 0
            Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
            SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
            ENDIF
       Proximo
    ENDIF
ENDIF