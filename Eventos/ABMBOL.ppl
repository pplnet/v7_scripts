*FO 03/01/2007                ACN(FE:1, Val(AB:&k))
                ACN(FE:1, Val(AB:fac))
                ACT(SW:1, SQL("SELECT SWIFT FROM "~DBO~".ESPECIES WHERE Codigo = '"~Val(am:fac)~"' ") )
                ACT(NR:1, GetNumerador(79))
                message("Generando Boleto de Venta "~Val(nr:1)~" ... ")
                SQL.ADD(" Insert Into "~DBO~".TRANSACCIONES2 ")
                SQL.ADD(" (NrTrans, TipoTr2, ")
                IF Val(FE:1) <> 0
                   SQL.ADD(" Fecha2, ")
                ENDIF
                SQL.ADD(" Especie, Cliente1, Ley3, ")
                SQL.ADD(" Cantidad1, Precio1, ")
                SQL.ADD(" Cambio1, Cantidad2, Cantidad3, ")
                SQL.ADD(" Ley2, Ley1, ")
                SQL.ADD(" CEmpresa4, Ley5, RB1, ")
                SQL.ADD(" Especie1, Ley4, ")
                SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, ")
                SQL.ADD(" Numerador, Vehiculo1, Fecha1) ")
                SQL.ADD(" Values ")
                SQL.ADD(" ('"~Val(NR:1)~"', 'BOBCRA', ")
                IF Val(FE:1) <> 0
                   SQL.ADD(" '"~IdxDate(Val(AB:fac))~"', ")
                ENDIF
                SQL.ADD(" '"~Val(SW:1)~"', '"~Val(AL:fac)~"', '"~Copy(Val(AF:fac), 1, 30)~"', ")
                SQL.ADD(" "~Fstr(Val(AN:fac), 0, 2)~", "~Fstr(Val(AO:fac), 0, 8)~", ")
                SQL.ADD(" "~Fstr(Num(Val(AA:fac)), 0, 0)~", "~Fstr(Num(Val(AC:fac)), 0, 0)~", "~Fstr(Num(Val(AD:fac)), 0, 0)~", ")
                SQL.ADD(" '"~Copy(Val(AE:fac), 1, 300)~"', '"~Copy(Val(AG:fac), 1, 300)~"', ")
                SQL.ADD(" '"~Copy(Val(AH:fac), 1, 10)~"', '"~Copy(Val(AI:fac), 1, 30)~"', 1, ")
                SQL.ADD(" '"~Val(AM:fac)~"', '"~Val(AJ:fac)~"', ")
                SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', ")
                SQL.ADD(" 79, '"~Dialogo.Vehiculo1~"', '"~IdxDate(Val(AK:fac))~"') ")
                SQL.NEW
            ENDIF
            SQL.EXEC
        ENDIF
    ENDIF

