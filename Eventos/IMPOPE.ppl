***---HojaVisible(SI)
CrearDialogo
  NrOperacion1:  'NrOperacion';;;;;;NoVacio(Dialogo.NrOperacion1) Y Not Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'FCR|FCS|') Y NOT EqStr(VAR('CLASEOPVIN'),BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1)));'La operacion no es valida';NO;   
  Radio1:        'Imprimir|NO|SI';;;;;;;;;0;
FinDialogo

If Not OK
  Cancelar
Endif

*** De esta manera imprime los campos con las cuotas***
If Dialogo.Radio1=1
    ***---ImprimirOperacion(Dialogo.NrOperacion1,SI,'TRADE TICKET',,SI,SI)
    LinkearHoja('TTICKE',1, NrOperacion1=Dialogo.NrOperacion1)
Endif