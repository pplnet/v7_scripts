
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:  'Fecha'  ;1;1; ;  ;  ;;;;fsys
  Check1:  'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo

if Not OK
  Cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(v:1, 'Oper en OPROFEX')
ACT(v:2, 'OpROFEX en USR')
ACT(v:3, 'Operador Default')
ACT(v:5, VAR('AGESIOP'))
ACT(T:99,'A3')
ACN(w:1, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'OPA3' AND COLUMN_NAME in ('RootPartyID') "))
ACN(w:4, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'OPA3' AND COLUMN_NAME in ('RootPartyRole') "))
ACN(w:2, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'USUARIOS' AND COLUMN_NAME in ('OpROFEX') "))
if SQL("SELECT 1 FROM "~DBO~".VARIABLES where Codigo='OPROFEXDEF' ")=1
  ACT(w:3, Var('OPROFEXDEF'))
  if SQL("SELECT 1 FROM "~DBO~".USUARIOS where Codigo='"~Val(w:3)~"' ")=0
    ACT(w:3, USUARIOACTIVO)
  endif
endif
if Vacio(Val(w:3))
  ACT(w:3, USUARIOACTIVO)
endif

Message('Recuperando Op CPC1 A3...')
SQL.ADD("Select * from "~DBO~".OPA3")
SQL.ADD(" where isnull(Procesado,'0')='0' ")
SQL.ADD("   and Convert(Date,FechaReal)="~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and MarketID  = 'XMAB' ")
**SQL.ADD("   and SegmentID  = 'TIVA' ")
SQL.ADD("   and isnull(Anulada,'NO')  = 'NO' ")
** que TrdRptStatus se toman?? 0=confirmada, 3=Cancelada, 4=Transitoria
**SQL.ADD("   and TrdRptStatus  in ('0','3') ")
SQL.ADD("   and TrdRptStatus  in ('4','0') ")
SQL.ADD("   and isnull(ExecId,'')  <> '' ")
**SQL.ADD("   and Boleta='31817405' ")
**SQL.ADD("   and  Orderid='14147388' ")
SQL.ADD(" Order by Fecha,Boleta ")  
watch(sql.batch)
Recorrer SQL
 
     ACT(WA:1,'')
     BorrarCeldas(t:1..u:90)
     BorrarCeldas(xy:1..xy:10)
 
     ACT(t:1, fbn('Boleta'))
     if Dialogo.Check1=1
        Message('...'~fbn('Boleta'))
     else
        MessageBox('...'~fbn('Boleta'))
     endif
     ACT(aa:FAC, fbn('Boleta'))
     ACT(ab:FAC, fbn('Posicion'))
     
     ACT(u:1,fbn('TradeNumber'))    
     ACT(FE:1, FBN('Fecha'))
     ACT(HO:1, FBN('Hora'))        
     ACD(VT:1, FBN('Vto'))   

   * Se toma del GENRFX FJL 12/07/20 - Operador segun informacon de ROFEX
     if Val(w:1)+Val(w:4)+Val(w:2)=3
        * Existen los tres campor nuevos en la base
        if EqStr(fbn('RootPartyRole'),'12')
           ACT(ae:FAC, fbn('RootPartyID'))
        endif
        if NoVacio(Val(ae:FAC))
           ACT(af:fac, SQL("Select Codigo from "~DBO~".USUARIOS Where OpROFEX = '"~Val(ae:FAC)~"'"))
           if Vacio(Val(af:fac))
              ACT(af:fac, Val(w:3))
           endif
        else
           ACT(af:fac, Val(w:3))
        endif
     else
        ACT(af:fac, Val(w:3))
     endif     
     
     **// Warning por default
     ACT(WA:1, 'Falta info ')
     
     ** idcomitente es la relacion con CLIENTE FPA por campo NrROFEX
   
     ACT(xy:2,SQL("Select Nrorden From "~DBO~".EJECUCIONES Where cast(Fecha As Date) = '"~IdxDate(fbn('Fecha'))~"' and NrSecuencia = '"~fbn('TradeNumber')~"' "))
  
     **Si hay Ejecucion actualizar OPA3 con warning de duplicado
     IF NoVacio(val(xy:2))
         ACT(WA:1, 'Ya existe Trade Number '~PAD0(fbn('TradeNumber'),10)~'. para Orden '~Val(xy:2))
  
         if Dialogo.Check1=1
              SQL.ADD("Update "~DBO~".OPA3 ")
              SQL.ADD("   Set Procesado   = '1',")
              SQL.ADD("       Warning       = '"~Trim(Copy(Val(WA:1),1,255))~"', ")
              SQL.ADD("       NrOperacion = 'DUPLIC' ")
              SQL.ADD(" where Boleta  = '"~fbn('Boleta')~"' ")
              SQL.NEW
              SQL.EXEC
         endif
    ELSE
        **Si no, Es un alta o actualizacion de Orden.
        IF Not Incluido(FBN('IdCpraVta'),'1|3')
           ACT(WA:1, 'No es un movimiento de compra-venta - Trade Number '~PAD0(fbn('TradeNumber'),10))
  
           if Dialogo.Check1=1
              SQL.ADD("Update "~DBO~".OPA3 ")
              SQL.ADD("   Set Procesado   = '1',")
              SQL.ADD("       Warning       = '"~Trim(Copy(Val(WA:1),1,255))~"', ")
              SQL.ADD("       NrOperacion = 'Erroneo' ")
              SQL.ADD(" where Boleta  = '"~fbn('Boleta')~"' ")
              SQL.NEW
              SQL.EXEC
           endif
        Else
            **Es un alta o actualizacion de Orden.
            ACT(xy:3, 'OK')
            ACN(t:44, 0)
       
            **Ejecucion Nueva
            ACT(x:1, 'S')
            ACT(xy:1,'NN')
           
            ACT(t:5,SQL("SELECT Codigo FROM "~DBO~".Clientes WHERE NrRofex  = '"~FBN['IdComitente']~"' "))

            If vacio(val(t:5))
               * Marca Incompleto
               ACN(t:44, 1)
               ACT(WA:1, val(WA:1)~' Cliente inexistente '~FBN['IdComitente'])            
            Endif   

            * Buscar Codigo FPA de especie
            ***** Especie
            
            SQL.ADD("Select * From "~DBO~".ESPECIESMERCADOS Where Mercado = '"~VAR('AMBMAE')~"' and Codigo = '"~fbn('Posicion')~"' ")
            ACN(z10,0)
            Recorrer Sql
               dfa
               ACN(z10,1)
               ACT(t:3, FBN['Especie'])
               ACT(z12, FBN['Moneda']) 
               ACN(z13, FBN['UnidadPrecio'])
               ACT(z14, FBN['MercadoE']) 
               ACT(z15, FBN['MercadoM']) 
            Proximo

            if Vacio(Val(t:3))
               * Marca Incompleto
               ACN(t:44, 1)
               ACT(WA:1, val(WA:1)~' EspecieMercado No existe'~FBN('Posicion'))            
            else
               ***** PrecioA3 
               ACN(t:13, fbn('Precio')/Val(z13))
            endif        
 
            IF Val(t:44)=1
               if Dialogo.Check1=1
                  SQL.ADD("Update "~DBO~".OPA3 ")
                  SQL.ADD("   Set Procesado   = '1',")
                  SQL.ADD("       Warning       = '"~Trim(Copy(Val(WA:1),1,255))~"', ")
                  SQL.ADD("       NrOperacion = 'Erroneo' ")
                  SQL.ADD(" where Boleta  = '"~fbn('Boleta')~"' ")
                  SQL.NEW
                  SQL.EXEC
               endif
            Else
            ** TODO OK, se genera Ejecucion 
         
            ***** Cantidad
            ACN(t:11, fbn('Cantidad'))
            if Val(t:11)=0
               SCN(z:1,1)
               **messagebox('Cantidad')
               ACN((26+FAC):11, 1)
            endif

            ***** Cupon MAE
            ACT(t:4, '0')
         
            ***** Cliente
            ACN(t:6, Num(Val(t:5)))
            ACT(t:8, Val(t:5))
            ACT(t:54,Val(t:8))
         
            ** messagebox(Val(t:54)~' '~fbn('RootPartyID')~' '~Var('RUECPC1'))
            ** 11-08-2024 BOFA verificar para cartera propia con Variable CLIEGARCP
            #ifdef MLASA
               if Incluido(Val(t:54),Var('CLIEGARCP')) o  Eqstr(Val(t:54),Var('VEHICULODE'))  
                  ACN(t:55,1)
               Else
                  ACN(t:55,0)   
               Endif
            #else   
               if Eqstr(Val(t:54),Var('VEHICULODE'))    
                  ACN(t:55,1)
               Else
                  ACN(t:55,0)   
               Endif
            #endif

            ** Cta y Ord 3ros   
            ** 11-08-2024 BOFA verificar para cartera propia con Variable CLIEGARCP
            #ifdef MLASA
              if not Incluido(Val(t:54),Var('CLIEGARCP')) y  Not Eqstr(Val(t:54),Var('VEHICULODE'))  
                 ACT(t:73,'1')
              Else   
                 ACT(t:73,'0')
              Endif                  
            #else      
               if Not Eqstr(Val(t:54),Var('VEHICULODE'))    
                  ACT(t:73,'1')
               Else   
                  ACT(t:73,'0')
               Endif
            #endif   
        
            **Mercado Especie y Mercado Contraespecie Orden 
 
            ***** Mercado4
            ACT(t:31, Var('AMBMAE'))
            ***** Especie T:3/ Mercado T:22
            **ACT(t:22, Var('MERLIQCPC1'))
            ** AA 17-06-2025 mercado EspeciesMercado
            ACT(t:22, Val(z14))
         
            ***** ContraEspecie T:12 / Mercado2 T:52
            ACT(t:12, val(z12))
         
            **ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:6)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
            ** AA 17-0-2025  mercadoLiq especiesMercado
            ACT(t:52, Val(z15))
         
            ** Cuentas
            *         ACT(t:28,'')
            *         ACT(t:80,'')
            *         ACT(t:81,'')
         

            ***** Es ZeroCupon
            ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
            ***** Nro Cupon
            if EqStr(Val(t:58),'SI')    
               ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
            else
               ACT(t:17, Val(t:4))
            endif
            ***** Fecha Op
            ACT(t:18, fbn('Fecha'))
            ACD(t:19, Fecha(Val(t:18)))
    
            ***** Mercado
            IF Incluido(Val(T:22), VAR('MERCAVARI'))
               ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
               ACN(T:23, 1)
               ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
               ACN(U:23, 1)
            Else
               ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
               ACN(T:23, 1)
               ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
               ACN(U:23, 1)         
            ENDIF
            ***** Operador / OperadorContra
            * Se toma del GENRFX FJL 12/07/20 - Operador segun informacon de ROFEX
            ACT(t:25,Val(af:fac))
            ACT(t:26,'01')

            ***** Vehiculo1
            ACT(t:29, Var('VEHICULODE'))

            *** ContraEspecie2 Moneda de Liquidacion ****
            If Eqstr(Val(t:12),VAR('MONELOCA'))
               ACT(T:46,Val(t:12))
            Else
               ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
            Endif
            if EqStr(Val(t:12),'USD')
               if Incluido(Val(t:22),VAR('MERCAACMC'))
                  ACT(t:46, 'USD')
               endif
            endif
            ***** Tabla Feriados
            ACT(t:24, VAR('FERIDEF'))

            ***** Plazo / Lote
            **calcular plazo
            ACN(t:21, DifDias(FBN['Fecha'],FBN['Vto'],'ARG')*24)

            ***** RB5
            ACT(t:20, Fstr(DifDias(FBN['Fecha'],FBN['Vto'],'ARG'),1,0))

            ***** FechaVto
            ACD(t:45, fbn('vto'))

            ***** UDN1
            ACT(t:30, 'MD')
            ***** Rueda 
            ACT(t:32, 'CPC1')
            ***** PaseCB
            ACT(t:33, '0')

            if DesciendeDeEspecie(Val(t:3),'LETES')
               *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
               ACN(x:2, 1)
            else
               ACN(x:2, 0)
            endif 

            * Cliente definitivo a la Operacion
            ACT(t:56, Val(t:54))

            ACT(t:48, fbn('FechaReal'))
            ACT(t:84, fbn('FechaReal'))
            ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
            ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))
        
            **ACT(t:51, fbn('ExcecID'))
            ACT(t:51, fbn('Boleta'))
            ACT(t:70,'MERCADO')
            ACT(t:71,BuscarCampo('CANALES','AfectaPorDefecto','Codigo',Val(t:70)))
            ACT(t:72,copy(fbn('Hora'),1,2)~':'~copy(fbn('Hora'),3,2)~':'~copy(fbn('Hora'),5,2))
            ACT(t:74,fbn['TradeNumber'])
        
        
            **Definir Tipo de orden y Cliente por el mensaje
            ACT(v:1,fbn('OrderID'))
            **ACT(u:60, Copy(fbn('Fecha'),5,2)~'/'~Copy(fbn('Fecha'),3,2)~'/20'~Copy(fbn('Fecha'),1,2)~' '~Copy(fbn('Hora'),1,2)~':'~Copy(fbn('Hora'),3,2)~':'~Copy(fbn('Hora'),5,2))
            **ACT(u:60, fbn('Fecha'))
            ACT(u:60, Val(fe:1)~' '~Copy(val(ho:1),1,2)~':'~Copy(val(ho:1),3,2)~':'~Copy(val(ho:1),5,2))
            ACT(t:60, SQLFechaStr(Val(u:60),Exe('FORFECHOR')))
            
            ACT(u:2,  SQL("Select TipoOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('OrderID')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"' "))
            IF NoVacio(u:2)
               ACT(t:53, SQL("Select NrOrden   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('OrderID')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
               ACT(t:54, SQL("Select Cliente   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('OrderID')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
               ACT(t:59, SQL("Select NrOperacion2   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('OrderID')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))               
            Endif
            
            If EqStr(FBN('IdCpraVta'),'1')
               ACT(u:3,'OTIV')
               ACT(t:2,'TIV')
            Else
               ACT(u:3,'OTIC')
               ACT(t:2,'TIC')
            Endif
           
            ** generar Orden si NO existe
            If Vacio(Val(u:2))
               ACT(u:2,Val(u:3))
        
               *  messagebox('Grabo orden')
               ACT(wa:1,'')
               ** GENORDENES
               if Dialogo.Check1=1
                  (.'GENAC3ORD'.)
               Endif             
            Else   
               ** Ya existe Orden - Actualizar operacion y Orden. inser nuevo ejecucion
               (.'ACTAC3ORD'.)
            Endif
         Endif
       Endif
            
     ** Fin proceso
     ENDIF 
Proximo 


if no
Message('Eliminando Operaciones TIVA...')
SQL.ADD("Select * from "~DBO~".OPA3")
SQL.ADD(" where isnull(Procesado,'0')='0' ")
SQL.ADD("   and Convert(Date,FechaReal)="~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and MarketID  = 'XMAB' ")
SQL.ADD("   and OPB.TrdRptStatus='3' ")
SQL.ADD("   and isnull(ExecId,'')  <> '' ")
SQL.ADD(" Order by Fecha,Boleta ")  
watch(sql.batch)
Recorrer SQL
   if SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~FBN['Nroperacion']~"' ")=1
      SQL.ADD(" Update "~DBO~".OPA3 ")
      SQL.ADD("    Set Warning = 'Intento de baja. La operacion se encuentra liquidada' ")
      SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
      SQL.NEW
      SQL.EXEC
   else
      acn(IN:2,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~FBN['Nroperacion']~"' and Valor=1 "))
      EjecutarEvento('DESAFE',NrOperacion1=FBN['Nroperacion'])
      EjecutarEvento('CBOINS', String1=FBN['Nroperacion'], Radio1=0, Radio2=1, Entero1=Val(IN:2), Entero2=30)

      Message('Operacion dada de baja '~FBN['Nroperacion'])
      SQL.ADD(" Update "~DBO~".OPA3 ")
      SQL.ADD("    Set Procesado = '1', Warning = null")
      SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
      SQL.NEW
      SQL.EXEC
   endif   
Proximo
endif

if Dialogo.Check1=0 y FAC>0
  FormatoCeldas(t:6..t:6,Exe('F0'))
  FormatoCeldas(t:11..t:11,Exe('F2'))
  FormatoCeldas(t:13..t:15,Exe('F8'))
  FormatoCeldas(t:16..t:16,Exe('F2'))
  FormatoCeldas(t:21..t:55,Exe('F0'))

  FormatoCeldas(ca:6..(78+FAC):6,Exe('F0'))
  FormatoCeldas(ca:11..(78+FAC):11,Exe('F2'))
  FormatoCeldas(ca:13..(78+FAC):15,Exe('F8'))
  FormatoCeldas(ca:16..(78+FAC):16,Exe('F2'))
  FormatoCeldas(ca:21..(78+FAC):55,Exe('F0'))
  ACO(1, 10)
  ACO(19,15)
  ACO(20,12)
  ACO(78,15)
endif