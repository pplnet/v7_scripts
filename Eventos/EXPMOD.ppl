MostrarCuadroDeMensajes
CrearDialogo
   String1    : 'Archivo' ;;;;;;;;;'.sql'
   String2    : 'Path'    ;;;;;;;;;'C:\Querys\';
   Check1     : 'Delete'  ;;;;;;;;;1
   Lista1     : 'Modelos' ;1;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".MODELOSASIENTO ");
FinDialogo

If not Ok
 Cancelar
EndIf

ACT(MN:1, Dialogo.Lista1)

**// Elimino modelos prexistentes antes de las sentencias insert.
If Dialogo.Check1=1
   IFA
   ACT(a:fac, "-- Delete de modelos prexistentes")
   IFA
   ACT(a:fac, "DELETE FROM "~DBO~".MODELOSASIENTO ")
   IFA
   ACT(a:fac, "WHERE Codigo in ("~Pipe2Comillas(Val(MN:1))~") ")
   IFA
   IFA
Endif

SQL.ADD(" Select Codigo, Descripcion, Vehiculo, Libro, Book, UDN, Centro, Sector, TipoOp, TipoAsiento, ClaseDocumento ")
SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
SQL.ADD(" Where Codigo in ("~Pipe2Comillas(Val(MN:1))~") ")
Recorrer SQL
   Message('Exportando Modelo '~FBN('Codigo')~'...')
   ACT(a:fac, "-- Modelo "~FBN('Codigo'))
   IFA
   ACT(a:fac, "INSERT INTO "~DBO~".MODELOSASIENTO ")
   IFA
   ACT(a:fac, "(Codigo, Descripcion, Vehiculo, Libro, ")
   IFA
   ACT(a:fac, "Book, UDN, Centro, Sector,")
   IFA
   ACT(a:fac, "TipoOp, TipoAsiento, ClaseDocumento)")
   IFA
   ACT(a:fac, "Values")
   IFA
   ACT(a:fac, "('"~FBN('Codigo')~"', '"~FBN('Descripcion')~"', '"~FBN('Vehiculo')~"', '"~FBN('Libro')~"', ")
   IFA
   ACT(a:fac, " '"~FBN('Book')~"', '"~FBN('UDN')~"', '"~FBN('Centro')~"', '"~FBN('Sector')~"', ")
   IFA
   ACT(a:fac, " '"~FBN('TipoOp')~"', '"~FBN('TipoAsiento')~"', '"~FBN('ClaseDocumento')~"') ")
   IFA
   ACT(a:fac, "")
   IFA
   Esperar(0.5)

   **// Recorro items y genero sentencias insert en MODELOSASIENTO1
   SQL.ADD(" Select Modelo, NrItem, CuentaContable, FormaCalculo1, FormaCalculo2, FormaCalculo3, ")
   SQL.ADD("        CondicionValidez, DebitoCredito, Moneda1, Moneda2, Moneda3, Alias1, ")
   SQL.ADD("        Alias2, Alias3, Detalle, CentroCosto, CC1, MN1, ")
   SQL.ADD("        MN2, MN3, AL1, AL2, AL3, CuentaContable1, ")
   SQL.ADD("        CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Alias4, ")
   SQL.ADD("        Alias5, Book, Book1, Bk1, Alias6, Alias7,")
   SQL.ADD("        Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3 ")
   SQL.ADD(" From "~DBO~".MODELOSASIENTO1 ")
   SQL.ADD(" Where Modelo = '"~FBN('Codigo')~"' ")
   Recorrer SQL
      Message('Generando insert - Item '~FBN('NrItem'))
      ACT(a:fac, "-- Modelo "~FBN('Modelo')~" -- Item: "~FBN('NrItem'))
      IFA
      ACT(a:fac, "INSERT INTO "~DBO~".MODELOSASIENTO1 ")
      IFA
      ACT(a:fac, "(Modelo, NrItem, CuentaContable, FormaCalculo1, FormaCalculo2, FormaCalculo3, ")
      IFA
      ACT(a:fac, " CondicionValidez, DebitoCredito, Moneda1, Moneda2, Moneda3, Alias1, ")
      IFA
      ACT(a:fac, " Alias2, Alias3, Detalle, CentroCosto, CC1, MN1, ")
      IFA
      ACT(a:fac, " MN2, MN3, AL1, AL2, AL3, CuentaContable1, ")
      IFA
      ACT(a:fac, " CentroCosto1, Moneda11, Moneda12, Moneda13, CT1, Alias4, ")
      IFA
      ACT(a:fac, " Alias5, Book, Book1, Bk1, Alias6, Alias7,")
      IFA
      ACT(a:fac, " Alias8, Alias9, Alias10, FormulaValor1, FormulaValor2, FormulaValor3) ")
      IFA
      ACT(a:fac, "Values")
      IFA
      ACT(a:fac, "( '"~FBN('Modelo')~"', "~FBN('NrItem')~", '"~FBN('CuentaContable')~"', '"~FBN('FormaCalculo1')~"', '"~FBN('FormaCalculo2')~"', '"~FBN('FormaCalculo3')~"', ")
      IFA
      If NoVacio(FBN('Alias1'))
         ACT(AL:1, "'"~FBN('Alias1')~"'")
      Else
         ACT(AL:1, "")
      Endif
      ACT(a:fac, " '"~FBN('CondicionValidez')~"', ''"~FBN('DebitoCredito')~"'', '"~FBN('Moneda1')~"', '"~FBN('Moneda2')~"', '"~FBN('Moneda3')~"', '"~Val(AL:1)~"', ")
      IFA
      ACT(a:fac, " '"~FBN('Alias2')~"', '''"~FBN('NrItem')~"''', '"~FBN('Detalle')~"', '"~FBN('CentroCosto')~"', '"~FBN('CC1')~"', '"~FBN('MN1')~"', ")
      IFA
      ACT(a:fac, " '"~FBN('MN2')~"', '"~FBN('MN3')~"', '"~FBN('AL1')~"', '"~FBN('AL2')~"', '"~FBN('AL3')~"', '"~FBN('CuentaContable1')~"', ")
      IFA
      ACT(a:fac, " '"~FBN('CentroCosto1')~"', '"~FBN('Moneda11')~"', '"~FBN('Moneda12')~"', '"~FBN('Moneda13')~"', '"~FBN('CT1')~"', '"~FBN('Alias4')~"', ")
      IFA
      ACT(a:fac, " '"~FBN('Alias5')~"', '"~FBN('Book')~"', '"~FBN('Book1')~"', '"~FBN('Bk1')~"', '"~FBN('Alias6')~"', '"~FBN('Alias7')~"',")
      IFA
      ACT(a:fac, " '"~FBN('Alias8')~"', '"~FBN('Alias9')~"', '"~FBN('Alias10')~"', '"~FBN('FormulaValor1')~"', '"~FBN('FormulaValor2')~"', '"~FBN('FormulaValor3')~"') ")
      IFA
      ACT(a:fac, "")
      IFA
      Esperar(0.2)
   Proximo
   IFA
   ACT(a:fac, "")
Proximo
Esperar(0.5)

**// Depuracion de sentencia
Recorrer&i 1, FAC
*    ACT(a:&i, ReemplazarSTR(Val(a:&i), "''DEB''" ,"'''DEB'''", SI))
*    ACT(a:&i, ReemplazarSTR(Val(a:&i), " '''," ," '',", SI))
*    ACT(a:&i, ReemplazarSTR(Val(a:&i), " ''')" ," '')", SI))
Proximo



Message('Generando Archivo '~Dialogo.String2~Dialogo.String1)
AbrirAscii(Dialogo.String2~Dialogo.String1, 0)
Recorrer&i 1, FAC
   EscribirAscii(Val(a:&i))
   Esperar(0.1)
Proximo
Esperar(1)
CerrarAscii

MessageBox('Se debe ajustar el script a mano para los campos string que contengan comillas')