CrearDialogo
  String1 : 'Ruta'         ;1;1;;;;;;;'G:\Corporate\BICE Fideicomisos\Demos'
  String2 : 'Archivo'      ;2;1;;;;;;;'Fondep FINAL CPD_FPA.xlsx'
FinDialogo

if Not Ok
  Cancelar
endif

If EqStr(Copy(Dialogo.String1,Longitud(Dialogo.String1),1),'\')
   ACT(x:1, Dialogo.String1~Dialogo.String2)
Else
   ACT(x:1, Dialogo.String1~'\'~Dialogo.String2)
EndIf

* Lineas a levantar del archivo y despues recorrer
ImportarXLS(a:6..au:1000, ba:1..cu:1000, Val(x:1))

If Not Ok
  Cancelar('Error al cargar el archivo '~Val(x:1))
EndIf

If SQL("Select 1 From "~DBO~".OPERACIONES where TipoOp='DTODOC' ")>0
   SQL.ADD("Delete From "~DBO~".OPERACIONES ")
   SQL.ADD(" Where TipoOp='DTODOC' ")
   SQL.NEW
   SQL.EXEC
EndIf

Recorrer&i 1,1000
  If Vacio(Val(ba:&i))
     Break
  EndIf
  
  ** Numerador
  ACN(NU:1,BuscarCampo('VEHICULOS','Alias1','Alias5',Val(bt:&i)))
  
  **NrOperacion
  ACT(NR:1,GetNumerador(Val(NU:1)))
  
  ** Especie
  If EqStr(Trim(Val(bc:&i)),'$')
     ACT(ES:1,VAR('MONELOCA'))
  Else
     ACT(ES:1,VAR('MONEEXTR'))
  EndIf
  
  ** RB1
  If EqStr(Trim(Val(bd:&i)),'C')
     ACN(RB:1,0)
  Else
     ACN(RB:1,1)
  EndIf
  
  ** Cliente1
  ACT(CL:1,BuscarCampo('CLIENTES','Codigo','Valor10',Val(bf:&i)))
  
  ** Cliente2
  ACT(CL:2,BuscarCampo('CLIENTES','Codigo','Valor10',Val(bl:&i)))
  
  ** Plazo2
  ACN(PL:2, Fecha(Val(bi:&i)) - Fecha(Val(bh:&i)))
  
  ** Vehiculo1
  ACT(VH:1,BuscarCampo('VEHICULOS','Codigo','Alias5',Val(bt:&i)))
  
  ** RB2
  If EqStr(Trim(Val(cc:&i)),'No') o EqStr(Trim(Val(cc:&i)),'NO')
     ACN(RB:2,0)
  Else
     ACN(RB:2,1)
  EndIf
  
  ** Plazo
  ACN(PL:1, Fecha(Val(cd:&i)) - Fecha(Val(bh:&i)))
  
  ** RB3
  If EqStr(Trim(Val(cf:&i)),'No') o EqStr(Trim(Val(cf:&i)),'NO')
     ACN(RB:3,0)
  Else
     ACN(RB:3,1)
  EndIf
  
  ** RB4
  If EqStr(Trim(Val(cg:&i)),'No') o EqStr(Trim(Val(cg:&i)),'NO')
     ACN(RB:4,0)
  Else
     ACN(RB:4,1)
  EndIf
  
  ** RB5
  If EqStr(Trim(Val(cu:&i)),'ECHEQ')
     ACN(RB:5,0)
  Else
     If EqStr(Trim(Val(cu:&i)),'CPD')
        ACN(RB:5,1)
     Else
        ACN(RB:5,2)
     EndIf
  EndIf
  
  ** Cantidad
  ACN(CA:1,Val(bp:&i) - Val(bq:&i))
  
  SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ( ")
  SQL.ADD("   TipoOp,          NrOperacion,    TotalAux1,       ObservacDoc,   Especie, ")
  SQL.ADD("   RB1,             Precio1,        Cliente1,        FechaOp,       FechaVto, ")
  SQL.ADD("   Plazo2,          TotalAux2,      TotalAux3,       Cliente2,      TotalAux4,")
  SQL.ADD("   FechaPago,       TotalNetoCli1,  TotalIntereses,  TotalDerechos, Vehiculo1, ")
  SQL.ADD("   MensajeChequeo,  ContraEspecie,  TipoCambio,      RB2,           FechaVto2, ")
  SQL.ADD("   Plazo,           NrSucursal,     RB3,             RB4,           UsrInput, ")
  SQL.ADD("   FechaCarga,      FechaCargaSys,  Numerador,       Cantidad,      Operador, ")
  SQL.ADD("   RB5,             TotalIVA,       TotalNetoCli2 ")
  SQL.ADD("   ) VALUES (")
  SQL.ADD("   'DTODOC',                  '"~Val(NR:1)~"',          "~FStr(Val(ba:&i),0,0)~", '"~Val(bb:&i)~"',          '"~Val(ES:1)~"', ")
  SQL.ADD("   "~Fstr(Val(RB:1),0,0)~",   "~FStr(Val(be:&i),1,8)~", '"~Val(CL:1)~"',          '"~IdxDate(Val(bh:&i))~"', '"~IdxDate(Val(bi:&i))~"', ")
  SQL.ADD("   "~Fstr(Val(PL:2),0,0)~",   "~FStr(Val(bj:&i),0,0)~", "~FStr(Val(bk:&i),0,0)~", '"~Val(CL:2)~"',           "~FStr(Val(bn:&i),0,0)~", ")
  SQL.ADD("   '"~IdxDate(Val(bo:&i))~"', "~FStr(Val(bp:&i),0,2)~", "~FStr(Val(bq:&i),0,2)~", "~FStr(Val(br:&i),0,2)~",  '"~Val(VH:1)~"', ")
  SQL.ADD("   '"~Val(by:&i)~"',          '"~VAR('MONELOCA')~"',    "~FStr(Val(ca:&i),0,2)~", "~FStr(Val(RB:2),0,0)~",   '"~IdxDate(Val(cd:&i))~"', ")
  SQL.ADD("   "~Fstr(Val(PL:1),0,0)~",   "~FStr(Val(ce:&i),0,0)~", "~FStr(Val(RB:3),0,0)~",  "~FStr(Val(RB:4),0,0)~",   '"~USUARIOACTIVO~"', ")
  SQL.ADD("   "~SQLAhora~",              "~IdxDate2(FSys)~",       "~FStr(Val(NU:1),0,0)~",  "~FStr(Val(CA:1),0,2)~",   '"~USUARIOACTIVO~"', ")
  SQL.ADD("   "~Fstr(Val(RB:5),0,0)~",   "~FStr(Val(co:&i),0,2)~", "~FStr(Val(ct:&i),0,2)~" ")
  SQL.ADD("   )")
  SQL.NEW
  SQL.EXEC
  
  ** Genero los bits de la operacion
  EjecutarEvento('INSBIT', String1='OPERACIONES', Entero1=1, NrOperacion1=Val(NR:1))
Proximo

MessageBox('Evento Finalizado Correctamente.')


