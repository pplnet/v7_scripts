Repetir 
    CrearDialogo

        Cliente1    : 'Cliente'             ;1;1;;;;NoVacio(Dialogo.Cliente1);'Debe seleccionar un cliente';NO;;;;;;;;;  
        *Trae la default si no trae la primera que encuentre
        Cuenta1     : 'Cuenta'              ;2;1;;;;NoVacio(Dialogo.Cuenta1) Y NoVacio(SQL("Select Codigo FROM "~DBO~".CUENTAS Where Codigo = '"~Dialogo.Cuenta1~"' and Cliente = '"~Dialogo.Cliente1 ~"' and (TipoCuenta = 'CC' or TipoCuenta = 'CA') and ISNULL(NoRemunerable,'NO') = 'NO' AND Comitente ='"~Var('VEHICULODE')~"'"));"Debe ingresar una Cuenta Válida!";NO;;SQL("SELECT TOP 1 Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~Dialogo.Cliente1 ~"' AND (TipoCuenta = 'CC' OR TipoCuenta = 'CA') AND ISNULL(NoRemunerable,'NO') = 'NO' AND Comitente ='"~Var('VEHICULODE')~"' ORDER BY CASE WHEN ISNULL(Permanente,'NO') = 'SI' THEN 1 ELSE 2 END, Codigo ASC");;;;"Cliente = '"~Dialogo.Cliente1~"' and (TipoCuenta = 'CC' or TipoCuenta = 'CA') and ISNULL(NoRemunerable,'NO') = 'NO' AND Comitente ='"~Var('VEHICULODE')~"'";;
        TipoTasa    : 'Tipo Tasa'          ;3;1;;NO;;;;;;SQL("Select Codigo from  "~DBO~".TIPOSTASA WHERE TiposOperacion LIKE ('%MMCREM|%')");;;;;;
        String1     : 'Codigo Tasa'         ;4;1;;NO;;;;;;SQL("SELECT CodigoTasa FROM "~DBO~".CUENTAS WHERE Codigo = '"~Dialogo.Cuenta1~"'");;;;;;;
        *Precio1     : 'Tasa'                ;5;1;;;;(Dialogo.Precio1 >= Dialogo.Precio3 Y Dialogo.Precio1 <= Dialogo.Precio4) O (Dialogo.Precio1 < Dialogo.Precio5 O Dialogo.Precio1 > Dialogo.Precio6)  O (Dialogo.Precio1 > 0);'Fuera de Rango'~Chr(13)~Chr(10)~'Tasa minima: '~Dialogo.Precio3~Chr(13)~Chr(10)~'Tasa maxima:'~Dialogo.Precio4~Chr(13)~Chr(10);;;;;;;;;
        *Tasa negativa
        Precio1     : 'Tasa'                ;5;1;;;;((Dialogo.Precio1 >= Dialogo.Precio3 Y Dialogo.Precio1 <= Dialogo.Precio4) O (Dialogo.Precio1 < Dialogo.Precio5 O Dialogo.Precio1 > Dialogo.Precio6))  Y (Dialogo.Precio1 > 0);IIF(Dialogo.Precio1 >0,'Fuera de Rango'~Chr(13)~Chr(10)~'Tasa minima: '~Dialogo.Precio3~Chr(13)~Chr(10)~'Tasa maxima:'~Dialogo.Precio4~Chr(13)~Chr(10), 'La tasa debe ser mayor a 0 ');IF(Dialogo.Precio1 <= 0 ,NO);;;;;;;;
        Fecha1      : 'Fecha rem'           ;6;1;;;;;;;FSYS
        Fecha4      : 'Fecha vto'           ;8;1;;;;Dialogo.Fecha4 > Dialogo.Fecha1;"La Fecha Vto tiene tiene que ser mayor la Fecha Rem";NO;FSYS+Dialogo.Entero1;Dialogo.Fecha1 + Dialogo.Entero1
        Entero1     : 'Plazo'               ;7;1;;;;;;;VAR('PLAZOREM');Dialogo.Fecha4 - Dialogo.Fecha1;;;;;  

        Especie1    : 'Moneda'              ;1;2;;NO;SI;;;;;ItemLista(SQL("SELECT Especies FROM "~DBO~".CUENTAS WHERE Codigo= '"~Dialogo.Cuenta1~"'"),1)
        Check6      : 'Tasa Transf modificada';10;3;;;NO;(Dialogo.Check5 = 0) ;Chr(13)~Chr(10)~"Original: "~(Dialogo.Precio8 )~Chr(13)~Chr(10)~"Modificada: "~(Dialogo.Precio2)~Chr(13)~Chr(10);;;;;;;
        Precio2     : 'Tasa Transf'         ;2;2;;;;((Dialogo.Precio2 >= Dialogo.Precio9 Y Dialogo.Precio2 <= Dialogo.Precio10) O (Dialogo.Precio2 < Dialogo.Precio12 O Dialogo.Precio2 > Dialogo.Precio13))  Y (Dialogo.Precio2 > 0);IIF(Dialogo.Precio2 >0,'Fuera de Rango'~Chr(13)~Chr(10)~'Tasa minima: '~Dialogo.Precio9~Chr(13)~Chr(10)~'Tasa maxima:'~Dialogo.Precio10~Chr(13)~Chr(10), 'La tasa debe ser mayor a 0 ');IF(Dialogo.Precio2 <= 0 ,NO);;Dialogo.Precio8        
        String2     : "Forma de cálculo"    ;3;2;;NO;;;;;;IIF(SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Codigo = '"~Dialogo.Cuenta1~"' AND TEM = 'SI'") = 1,'TEM','TNA');;;;;;;
        Cantidad1   : 'Saldo Minimo'        ;4;2;;;;Dialogo.Cantidad1 > 0;'El saldo debe ser mayor a cero';NO;;;;;'###,###,###,###.##';;;;
        Precio15    : 'Encaje'              ;5;2;;NO;SI;;;;;SQL("SELECT ISNULL((SELECT Porcentaje FROM "~DBO~".PORENCAJETASAT WHERE CodJerarquia IN ("~Pipe2Comillas(Ascendientes('CLIENTES',Dialogo.Cliente1))~")),0)")
        *Variables para tasa 
        Precio3     : 'Minimo'              ;6;2;;;NO;;;;;Dialogo.Precio2 *(1-Var('RANGOREM')/100);;;;;;;;;
        Precio4     : 'Maximo'              ;7;2;;;NO;;;;;Dialogo.Precio2 *(1+Var('RANGOREM')/100);;;;;;;;;
        Precio5     : 'Minimo EXC'          ;8;2;;;NO;;;;;Dialogo.Precio2 *(1-Var('EXCESOREM')/100);;;;;;;;;
        Precio6     : 'Maximo EXC'          ;9;2;;;NO;;;;;Dialogo.Precio2 *(1+Var('EXCESOREM')/100);;;;;;;;;

        *Variables para tasa transf 
        Precio8     : 'Var Tasa Transf'     ;10;2;;SI;NO;;;;;IF(Eqstr(var('BASEXPILAR'), 'SI'),(SQL("SELECT dbo.ObtenerTasaTransferencia("~IdxDate2(Dialogo.Fecha1)~",'"~Dialogo.TipoTasa~"' ,'"~Dialogo.Especie1~"','"~Dialogo.Entero1~"')")+ Dialogo.Precio15),(TasaDia(Dialogo.TipoTasa, Dialogo.Especie1, Dialogo.Fecha1, Dialogo.Entero1, 1) + Dialogo.Precio15));;;;        
        Precio9     : 'Minimo TS'           ;11;2;;;NO;;;;;Dialogo.Precio8 *(1-Var('RANGOREM')/100);;;;;;;;;
        Precio10    : 'Maximo TS'           ;12;2;;;NO;;;;;Dialogo.Precio8 *(1+Var('RANGOREM')/100);;;;;;;;;
        Precio12    : 'Minimo TS EXC'       ;13;2;;;NO;;;;;Dialogo.Precio8 *(1-Var('EXCESOREM')/100);;;;;;;;;
        Precio13    : 'Maximo TS EXC'       ;14;2;;;NO;;;;;Dialogo.Precio8 *(1+Var('EXCESOREM')/100);;;;;;;;;
        *Excepciones
        Check1      : 'Exc tasa'            ;1;3;;;NO;;;;;IF(Dialogo.Precio1 < Dialogo.Precio3 O Dialogo.Precio1  > Dialogo.Precio4,1,0);;;;
        Check2      : 'Exc Fecha'           ;2;3;;;NO;;;;;IF(Dialogo.Fecha1 < FSYS,1,0);;;;
        Check3      : 'Exc tasa transf'     ;3;3;;;NO;;;;;IF(Dialogo.Precio2 < Dialogo.Precio9 O Dialogo.Precio2  > Dialogo.Precio10,1,0);;;;
        Check4      : 'Spread Negativo'     ;7;3;;;NO;;;;;IF(Dialogo.Precio1 > Dialogo.Precio2 ,1,0);;;;
        Check5      : 'Mod tasa transf'     ;9;3;;;NO;;;;;IF(Dialogo.Precio2 <> Dialogo.Precio8 ,1,0);;;;
        
        
        Fecha2      : 'Fecha error'         ;3;3;;;NO; Dialogo.Fecha2 <= FSys Y Dialogo.Fecha2 >= (FSys-num(var('CHKFVLMMCR'))) ;'Fecha incorrecta';NO;;Dialogo.Fecha1
        Fecha3      :   ''                  ;4;3;;;NO;Dialogo.Fecha1 >= FSYS;"Es una Operacion FechaValor"~Chr(13)~Chr(10);SI;;Dialogo.Fecha1
        Precio7     : 'Error Tasa'          ;5;3;;;NO;NOT(Dialogo.Precio1 < Dialogo.Precio5 O Dialogo.Precio1 > Dialogo.Precio6 );'Tasa: fuera de rango'~Chr(13)~Chr(10)~'minima: '~Dialogo.Precio5~Chr(13)~Chr(10)~'maxima: '~Dialogo.Precio6~Chr(13)~Chr(10);NO;;;;;;

        Precio11    : 'Error Tasa Transf'   ;6;3;;;NO;NOT(Dialogo.Precio2 < Dialogo.Precio12 O Dialogo.Precio2 > Dialogo.Precio13 );'Tasa Transf: fuera de rango'~Chr(13)~Chr(10)~'minima: '~Dialogo.Precio12~Chr(13)~Chr(10)~'maxima: '~Dialogo.Precio13~Chr(13)~Chr(10);NO;;;;;;
        Precio14    : 'Spread Negativo'     ;8;3;;;NO;NOT(Dialogo.Precio1 > Dialogo.Precio2);Chr(13)~Chr(10)~"Diferencia: "~(Dialogo.Precio14 )~Chr(13)~Chr(10);SI;;(Dialogo.Precio1-Dialogo.Precio2);;;;

    FinDialogo
        
    if not ok
       Cancelar("Evento Cancelado.")
    Endif
    *a: Cliente
    *b: Cuenta
    *c: Codigo de tasa
    *d: NrOperacion
    *e: Valor de tasa Actual
    *f: Valor de tasa Nueva
    *g: Saldo minimo actual
    *h: Saldo minimo NUEVO
    *j: Procesa
    *k: Tasa de Transferencia
    *l: Responsable (OficialCuenta)
    *m: Query que las trae
    *n: FechaOp (caso en la que haya que cambiarle la Fecha Vto para calcular el plazo)
    *o: Instancia en la que se encuentra la operacion
    *p:FechaVto de la operacion
    *aa: NrOperacion si existe MMCREM en instancias intermedias
    *ab:1 Flag si tiene grupo economico 1(Si)/0(No)
    *az8 Sector del que pertenece el operador
        
    *&CantidadOperaciones cantidad de operaciones para recorrer en el bucle de insert
    *Dialogo.Fecha4 FechaVto 
    
    *Se guarda la tasa original de la transferencia en la base con la columna Precio2
    ACT(az8,SQL("SELECT SECTOR FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~USUARIOACTIVO~"'"))
    *Instancias por las que puede pasar la operaciones MMCREM 
    *ACT(az6,"1,2,7,8,10,30,70,91,92,93")
    ACT(az6,"1|2|7|8|10|30|70|91|92|93|")
    *Vehiculo Depositante
    ACT(az7,Var('VEHICULODE'))

    SetFilaActual(0)
    &CantOperaciones := 0
    &EntroBucle := FALSE
    &Control := FALSE
    &OperacionSolapada := 0 
    
    ACN(ab:1,SQL("SELECT CASE WHEN EXISTS (SELECT 1 FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente = '"~Dialogo.Cliente1~"')THEN 1  ELSE 0 END "))
    
************************************CONTROLES QUE VERIFICA SI AL CREAR LA OPERACION NO SE SOLAPARAN CON UNA YA EXISTENTE**********************************************************************************************
        
***********************************CONTROL PARA EL DIALOGO***********************************************************************************************        
        SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad, O.FechaVto, O.FechaOp FROM "~DBO~".OPERACIONES  O ")
        SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
        SQL.ADD( "WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~Dialogo.Cuenta1~"' AND  O.FechaOp >= "~IdxDate2(Dialogo.Fecha1)~"  AND O.FechaOp <  "~IdxDate2(Dialogo.Fecha4))
        SQL.ADD("AND O.FechaOp <> O.FechaVto")
        SQL.ADD("AND OB.NrBit <> 30")
        *Traer solo las cuentas con la misma tasa
        Recorrer SQL
            dfa
            *ANOTAR FECHAS PARA EL MESSAGE BOX
            MessageBox("Hay operaciones vigentes."~Chr(13)~Chr(10)~"FechaOp:  "~FBN['FechaOp']~Chr(13)~Chr(10)~"FechaVto: "~FBN['FechaVto'],2,0)
            *Cancelar("Evento Cancelado.")
            &OperacionSolapada := 1 
            BREAK
        Proximo
***********************************FIN CONTROL PARA EL DIALOGO***********************************************************************************************                

***********************************CONTROL PARA EL LAS DEMAS CUENTAS DEL CLIENTE***********************************************************************************************                
        *Flag para saber si existe el grupo economico Termina antes de QUERY PARA RECUPERAR OPERACIONES PARA LA CUENTA DEL DIALOGO
        *1=> SI tiene grupo economico || 0=> NO tiene grupo economico
        IF Val(ab:1) = 1        
            IF &OperacionSolapada = 0
                SQL.ADD("SELECT Codigo AS Cuenta ,Cliente")
                SQL.ADD("FROM "~DBO~".CUENTAS ")
                SQL.ADD("WHERE  Codigo<>'"~Dialogo.Cuenta1~"'")
                SQL.ADD("AND TipoCuenta IN ('CA', 'CC')")
                SQL.ADD("AND ISNULL(NoRemunerable, 'NO') = 'NO'")
                SQL.ADD("AND Cliente = '"~Dialogo.Cliente1~"'")
                SQL.ADD("AND Especies LIKE '%"~Dialogo.Especie1~"%'")
                if Eqstr(Dialogo.String2, 'TEM') 
                    SQL.ADD("AND TEM = 'SI'")
                else
                    SQL.ADD("AND ISNULL(TEM, 'NO') = 'NO'")
                endif 
                SQL.ADD("AND Comitente ='"~Val(az7)~"'")
                Recorrer SQL
                    dfa
                        SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad, O.FechaVto, O.FechaOp FROM "~DBO~".OPERACIONES  O ")
                        SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
                        SQL.ADD( "WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~FBN['Cuenta']~"' AND  O.FechaOp >= "~IdxDate2(Dialogo.Fecha1)~"  AND O.FechaOp <  "~IdxDate2(Dialogo.Fecha4))
                        SQL.ADD("AND O.FechaOp <> O.FechaVto")
                        SQL.ADD("AND OB.NrBit <> 30")
                        Recorrer SQL
                            dfa
                            MessageBox("Hay operaciones vigentes."~Chr(13)~Chr(10)~"FechaOp:  "~FBN['FechaOp']~Chr(13)~Chr(10)~"FechaVto: "~FBN['FechaVto'],2,0)
                            &OperacionSolapada := 1 
                            BREAK
                        Proximo
                    Proximo
                Endif
    ***********************************FIN CONTROL PARA EL LAS DEMAS CUENTAS DEL CLIENTE***********************************************************************************************                        
            
    ***********************************CONTROL PARA EL LAS  CUENTAS DEL GRUPO ECONOMICO***********************************************************************************************                
            
            IF &OperacionSolapada = 0
                SQL.ADD("SELECT C.Codigo AS Cuenta, C.Cliente AS Cliente")
                SQL.ADD("FROM "~DBO~".CUENTAS C, "~DBO~".GRUPOSECONOMICOS G")
                SQL.ADD("WHERE C.Cliente= G.Cliente ")
                SQL.ADD("AND C.Cliente <>'"~Dialogo.Cliente1~"'")
                SQL.ADD("AND C.TipoCuenta IN ('CA', 'CC')")
                SQL.ADD("AND ISNULL(C.NoRemunerable, 'NO') = 'NO'")
                SQL.ADD("AND C.Especies LIKE '%"~Dialogo.Especie1~"%'")
                SQL.ADD("AND G.Controlante=(SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente=(SELECT Cliente from "~DBO~".CUENTAS where Codigo='"~Dialogo.Cuenta1~"'))")
                if Eqstr(Dialogo.String2, 'TEM') 
                    SQL.ADD("AND C.TEM = 'SI'")
                else
                    SQL.ADD("AND ISNULL(C.TEM, 'NO') = 'NO'")
                endif 
                    SQL.ADD("AND Comitente ='"~Val(az7)~"'")
                Recorrer SQL
                    dfa
                    SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad, O.FechaVto, O.FechaOp FROM "~DBO~".OPERACIONES  O ")
                    SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
                    SQL.ADD( "WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~FBN['Cuenta']~"' AND  O.FechaOp >= "~IdxDate2(Dialogo.Fecha1)~"  AND O.FechaOp <  "~IdxDate2(Dialogo.Fecha4))
                    SQL.ADD("AND O.FechaOp <> O.FechaVto")
                    SQL.ADD("AND OB.NrBit <> 30")
                    Recorrer SQL
                        dfa
                        MessageBox("Hay operaciones vigentes."~Chr(13)~Chr(10)~"FechaOp:  "~FBN['FechaOp']~Chr(13)~Chr(10)~"FechaVto: "~FBN['FechaVto'],2,0)
                        &OperacionSolapada := 1
                        BREAK 
                        Proximo
                Proximo
            Endif
        Endif
***********************************FIN CONTROL PARA EL LAS  CUENTAS DEL GRUPO ECONOMICO***********************************************************************************************                    

********************************************FIN DEL CONTROL DE OPERACIONES************************************************************************************************    
   
****************************************QUERY PARA RECUPERAR OPERACIONES PARA LA CUENTA DEL DIALOGO******************************************************
    IF &OperacionSolapada = 0
    SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad,O.FechaOp,O.FechaVto,CASE WHEN O.NrExterno IS NOT NULL THEN 'SI' ELSE 'NO' END AS EnvSisExterno FROM "~DBO~".OPERACIONES O") 
        SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
        SQL.ADD("WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~Dialogo.Cuenta1~"' AND O.FechaOp <> O.FechaVto")
        SQL.ADD("AND FechaOP < "~IdxDate2(Dialogo.Fecha4))
        SQL.ADD("AND (NOT EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O2 WHERE  O2.TipoOp = O.TipoOp AND O2.Cuenta1 = O.Cuenta1 ")
        SQL.ADD("AND O2.FechaOp = O.FechaVto")
        SQL.ADD("AND O2.FechaOP <  "~IdxDate2(Dialogo.Fecha4)~")")
        SQL.ADD("AND EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O3 WHERE  O3.TipoOp = O.TipoOp AND O3.Cuenta1 = O.Cuenta1 ")
        SQL.ADD("AND   O.FechaVto > "~IdxDate2(Dialogo.Fecha1)~")")
        SQL.ADD("OR EXISTS(SELECT 1 FROM "~DBO~".OPERACIONES O4 WHERE  O4.TipoOp = O.TipoOp AND O4.Cuenta1 = O.Cuenta1")         
        SQL.ADD("AND   O.FechaVto = "~IdxDate2(Dialogo.Fecha1)~"))")
        SQL.ADD("AND OB.NrBit <> 30")

        Recorrer SQL 
            &CantOperaciones := &CantOperaciones + 1
            &EntroBucle := TRUE
            ACT(a:fac,FBN['Cliente1'])
            ACT(b:fac,FBN['Cuenta1'])
            ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~Dialogo.Cuenta1~"'),0)"))
            ACT(d:fac,FBN['NrOperacion'])
            ACT(e:fac,FBN['Precio1'])
            ACN(f:fac, Dialogo.Precio1)
            ACT(g:fac, FBN['Cantidad'])
            IF Dialogo.Cantidad1 = 0
                ACT(h:fac, FBN['Cantidad'])
            else
                ACT(h:fac, Dialogo.Cantidad1)
            endif
            ACN(i:fac, 1)
            ACT(j:fac, 'Procesa')
            ACN(k:fac,Dialogo.Precio2) 
            ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~FBN['Cliente1']~"'"))
            ACN(m:fac, 1)
            ACD(n:fac, FBN['FechaOp'])
            ACN(o:fac,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion= '"~Val(d:fac)~"' AND Valor = 1"))
            ACD(p:fac, FBN['FechaVto'])
            if Val(p:fac) <> Dialogo.Fecha1
                If Not Incluido(Val(o:fac),'70|93')
                    MessageBox("Hay operaciones en instancias intermedias.",2,0)
                    Cancelar("Evento Cancelado.")
                endif
            endif
            ACT(q:fac,FBN['EnvSisExterno'])
        Proximo
    ****************************************SI NO EXISTE OPERACION PARA RECUPERAR, CREO UNA CON LOS DATOS DEL DIALOGO******************************************************    
        if NOT &EntroBucle
            &CantOperaciones := &CantOperaciones + 1
            SetFilaActual(1)
            ACT(a:fac,Dialogo.Cliente1)
            ACT(b:fac,Dialogo.Cuenta1)
            ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~Dialogo.Cuenta1~"'),0)"))
            ACT(e:fac,'0')
            ACN(f:fac,Dialogo.Precio1)
            ACT(g:fac,'0')
            ACT(h:fac,Dialogo.Cantidad1)        
            ACN(i:fac, 1)
            ACT(j:fac, 'Procesa')
            ACN(k:fac,Dialogo.Precio2) 
            ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~Dialogo.Cliente1~"'"))
            ACN(m:fac, 2)
        Endif 
        &EntroBucle := FALSE
    *************************************FIN QUERY PARA RECUPERAR OPERACIONES PARA LA CUENTA DEL DIALOGO******************************************************    
        
        
    *************************************QUERY PARA RECUPERAR OPERACIONES PARA LAS DEMAS CUENTAS DEL DIALOGO******************************************************
        IF Val(ab:1) = 1
            SQL.ADD("SELECT Codigo AS Cuenta ,Cliente")
            SQL.ADD("FROM "~DBO~".CUENTAS ")
            SQL.ADD("WHERE  Codigo<>'"~Dialogo.Cuenta1~"'")
            SQL.ADD("AND TipoCuenta IN ('CA', 'CC')")
            SQL.ADD("AND ISNULL(NoRemunerable, 'NO') = 'NO'")
            SQL.ADD("AND Cliente = '"~Dialogo.Cliente1~"'")
            SQL.ADD("AND Especies LIKE '%"~Dialogo.Especie1~"%'")
            *Traer solo las cuentas con la misma tasa
            if Eqstr(Dialogo.String2, 'TEM') 
                SQL.ADD("AND TEM = 'SI'")
            else
                SQL.ADD("AND ISNULL(TEM, 'NO') = 'NO'")
            endif 
            SQL.ADD("AND Comitente ='"~Val(az7)~"'")
            Recorrer SQL
            
            SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad,O.FechaOp,O.FechaVto,CASE WHEN O.NrExterno IS NOT NULL THEN 'SI' ELSE 'NO' END AS EnvSisExterno FROM "~DBO~".OPERACIONES O")
                SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1") 
                SQL.ADD("WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~FBN['Cuenta']~"' AND O.FechaOp <> O.FechaVto")
                SQL.ADD("AND FechaOP < "~IdxDate2(Dialogo.Fecha4))
                SQL.ADD("AND (NOT EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O2 WHERE  O2.TipoOp = O.TipoOp AND O2.Cuenta1 = O.Cuenta1 ")
                SQL.ADD("AND O2.FechaOp = O.FechaVto")
                SQL.ADD("AND O2.FechaOP <  "~IdxDate2(Dialogo.Fecha4)~")")
                SQL.ADD("AND EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O3 WHERE  O3.TipoOp = O.TipoOp AND O3.Cuenta1 = O.Cuenta1 ")
                SQL.ADD("AND   O.FechaVto > "~IdxDate2(Dialogo.Fecha1)~")")
                SQL.ADD("OR EXISTS(SELECT 1 FROM "~DBO~".OPERACIONES O4 WHERE  O4.TipoOp = O.TipoOp AND O4.Cuenta1 = O.Cuenta1")         
                SQL.ADD("AND   O.FechaVto = "~IdxDate2(Dialogo.Fecha1)~"))")
                SQL.ADD("AND OB.NrBit <> 30")
                    Recorrer SQL
                        &CantOperaciones := &CantOperaciones + 1
                        &EntroBucle := TRUE
                        dfa
                        ACT(a:fac,FBN['Cliente1'])
                        ACT(b:fac,FBN['Cuenta1'])
                        ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~FBN['Cuenta1']~"'),0)"))
                        ACT(d:fac,FBN['NrOperacion'])
                        ACT(e:fac,FBN['Precio1'])
                        ACN(f:fac, Dialogo.Precio1)
                        ACT(g:fac, FBN['Cantidad'])
                        IF Dialogo.Cantidad1 = 0
                            ACT(h:fac, FBN['Cantidad'])
                        else
                            ACT(h:fac, Dialogo.Cantidad1)
                        endif
                        ACN(i:fac, 1)
                        ACT(j:fac, 'Procesa')
                        ACN(k:fac,Dialogo.Precio2)  
                        ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~FBN['Cliente1']~"'"))
                        ACN(m:fac, 3)
                        ACD(n:fac, FBN['FechaOp'])
                        ACN(o:fac,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion= '"~Val(d:fac)~"' AND Valor = 1"))
                        ACD(p:fac, FBN['FechaVto'])
                        if Val(p:fac) <> Dialogo.Fecha1
                            If Not Incluido(Val(o:fac),'70|93')
                                MessageBox("Hay operaciones en instancias intermedias.",2,0)
                                Cancelar("Evento Cancelado.")
                            endif
                        endif
                        ACT(q:fac,FBN['EnvSisExterno'])
                    Proximo

        ****************************************SI NO EXISTE OPERACION PARA RECUPERAR, CREO UNA CON LOS DATOS DE LAS CUENTAS******************************************************                
                if NOT &EntroBucle
                    &CantOperaciones := &CantOperaciones + 1
                    ACT(a:fac,FBN['Cliente'])
                    ACT(b:fac,FBN['Cuenta'])
                    ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~FBN['Cuenta']~"'),0)"))
                    ACT(e:fac,'0')
                    ACN(f:fac,Dialogo.Precio1)
                    ACT(g:fac,'0')
                    ACT(h:fac,Dialogo.Cantidad1)
                    ACN(i:fac, 1)
                    ACT(j:fac, 'Procesa')
                    ACN(k:fac,Dialogo.Precio2) 
                    ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~FBN['Cliente']~"'"))
                    ACN(m:fac, 4)
                endif
                &EntroBucle := FALSE
            Proximo
        *************************************FIN QUERY PARA RECUPERAR OPERACIONES PARA LAS DEMAS CUENTAS DEL DIALOGO******************************************************
            

        *************************************QUERY PARA RECUPERAR OPERACIONES EL GRUPO ECONOMICO******************************************************
            SQL.ADD("SELECT C.Codigo AS Cuenta, C.Cliente AS Cliente")
            SQL.ADD("FROM "~DBO~".CUENTAS C, "~DBO~".GRUPOSECONOMICOS G")
            SQL.ADD("WHERE C.Cliente= G.Cliente ")
            SQL.ADD("AND C.Cliente <>'"~Dialogo.Cliente1~"'")
            SQL.ADD("AND C.TipoCuenta IN ('CA', 'CC')")
            SQL.ADD("AND ISNULL(C.NoRemunerable, 'NO') = 'NO'")
            SQL.ADD("AND C.Especies LIKE '%"~Dialogo.Especie1~"%'")
            SQL.ADD("AND G.Controlante=(SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente=(SELECT Cliente from "~DBO~".CUENTAS where Codigo='"~Dialogo.Cuenta1~"'))")
            *Traer solo las cuentas con la misma tasa
            if Eqstr(Dialogo.String2, 'TEM') 
                SQL.ADD("AND C.TEM = 'SI'")
            else
                SQL.ADD("AND ISNULL(C.TEM, 'NO') = 'NO'")
            endif 
            SQL.ADD("AND Comitente ='"~Val(az7)~"'")
            Recorrer SQL

            SQL.ADD("SELECT O.Cliente1, O.Cuenta1, O.Precio1, O.NrOperacion,O.Cantidad,O.FechaOp,O.FechaVto,CASE WHEN O.NrExterno IS NOT NULL THEN 'SI' ELSE 'NO' END AS EnvSisExterno FROM "~DBO~".OPERACIONES O") 
                SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
                SQL.ADD("WHERE O.TipoOp = 'MMCREM' AND Cuenta1 = '"~FBN['Cuenta']~"' AND O.FechaOp <> O.FechaVto")
                SQL.ADD("AND FechaOP < "~IdxDate2(Dialogo.Fecha4))
                SQL.ADD("AND (NOT EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O2 WHERE  O2.TipoOp = O.TipoOp AND O2.Cuenta1 = O.Cuenta1 ")
                SQL.ADD("AND O2.FechaOp = O.FechaVto")
                SQL.ADD("AND O2.FechaOP <  "~IdxDate2(Dialogo.Fecha4)~")")
                SQL.ADD("AND EXISTS (SELECT 1 FROM "~DBO~".OPERACIONES O3 WHERE  O3.TipoOp = O.TipoOp AND O3.Cuenta1 = O.Cuenta1 ")
                SQL.ADD("AND   O.FechaVto > "~IdxDate2(Dialogo.Fecha1)~")")
                SQL.ADD("OR EXISTS(SELECT 1 FROM "~DBO~".OPERACIONES O4 WHERE  O4.TipoOp = O.TipoOp AND O4.Cuenta1 = O.Cuenta1")         
                SQL.ADD("AND   O.FechaVto = "~IdxDate2(Dialogo.Fecha1)~"))")
                SQL.ADD("AND OB.NrBit <> 30")
                    Recorrer SQL
                        &CantOperaciones := &CantOperaciones + 1
                        &EntroBucle := TRUE
                        dfa
                        ACT(a:fac,FBN['Cliente1'])
                        ACT(b:fac,FBN['Cuenta1'])
                        ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~FBN['Cuenta1']~"'),0)"))
                        ACT(d:fac,FBN['NrOperacion'])
                        ACT(e:fac,FBN['Precio1'])
                        ACN(f:fac, Dialogo.Precio1)
                        ACT(g:fac, FBN['Cantidad'])
                        IF Dialogo.Cantidad1 = 0
                            ACT(g:fac, FBN['Cantidad'])
                        else
                            ACT(h:fac, Dialogo.Cantidad1)
                        endif
                        ACN(i:fac, 1)
                        ACN(k:fac,Dialogo.Precio2) 
                        ACT(j:fac, 'Procesa') 
                        ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~FBN['Cliente1']~"'"))
                        ACN(m:fac, 5)
                        ACD(n:fac, FBN['FechaOp'])
                        ACN(o:fac,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion= '"~Val(d:fac)~"' AND Valor = 1"))
                        ACD(p:fac, FBN['FechaVto'])
                        *Control para instancias intermedias
                        if Val(p:fac) <> Dialogo.Fecha1
                            If Not Incluido(Val(o:fac),'70|93')
                                MessageBox("Hay operaciones en instancias intermedias.",2,0)
                                Cancelar("Evento Cancelado.")
                            endif
                        endif
                        ACT(q:fac,FBN['EnvSisExterno'])
                    Proximo
                if NOT &EntroBucle
        ******************************SI NO EXISTE OPERACION PARA RECUPERAR, CREO UNA CON LOS DATOS DE LAS CUENTAS DEL GRUPO ECONOMICO******************************************************                
                    &CantOperaciones := &CantOperaciones + 1
                    ACT(a:fac,FBN['Cliente'])
                    ACT(b:fac,FBN['Cuenta'])
                    ACN(c:fac, SQL("Select COALESCE((SELECT CodigoTasa FROM "~DBO~".Cuentas WHERE Codigo= '"~FBN['Cuenta']~"'),0)"))
                    ACT(e:fac,'0')
                    ACN(f:fac,Dialogo.Precio1)
                    ACT(g:fac,'0')
                    ACT(h:fac,Dialogo.Cantidad1)
                    ACN(i:fac, 1)
                    ACT(j:fac, 'Procesa')
                    ACN(k:fac,Dialogo.Precio2) 
                    ACT(l:fac, SQL("SELECT OficialCuenta FROM "~DBO~".Clientes WHERE Codigo = '"~FBN['Cliente']~"'"))
                    ACN(m:fac, 6)
                endif
                &EntroBucle := FALSE
            Proximo
        Endif
    *************************************FIN QUERY PARA RECUPERAR OPERACIONES EL GRUPO ECONOMICO******************************************************
            CrearListBox ; 'Arial,8,'
        
            'Check'                  ; i1..i:fac   ;SI;Val(i:1) = 1;'La cuenta principal debe estar seleccionada';50;CHECK;RGB(232,232,255); 
            'Cliente'                ; a1..a:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
            'Cuenta'                 ; b1..b:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
            'Codigo de tasa'         ; c1..c:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
            'Nro de operacion'       ; d1..d:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
            'Valor de tasa actual'   ; e1..e:fac   ;NO;SI;;150;NUMERO;'######.######';RGB(232,232,255); 
            'Valor de tasa nueva'    ; f1..f:fac   ;NO;SI;;150;NUMERO;'######.######';RGB(232,232,255); 
            'Saldo minimo actual'    ; g1..g:fac   ;NO;SI;;150;NUMERO;;RGB(232,232,255);
            'Saldo minimo nuevo'     ; h1..h:fac   ;SI;NUM(Val(h:FLB)) > 0;'El saldo debe ser mayor a cero';150;NUMERO;'###,###,###,###.##';RGB(180,180,193);

            'Tasa de Transferencia'  ; k1..k:fac   ;NO;SI;;150;NUMERO;'#######.######';RGB(232,232,255); 
            *'QUERY'                  ; m1..m:fac   ;SI;SI;;150;NUMERO;;RGB(180,180,193);
           
           
        FinListBox

        if not ok
           Cancelar('Evento Cancelado.')
        Endif
        
        &NrOperacionPrincipal := NULL
        &TotalOp := 0
        &Renovacion := 0
        &Repac := 0

        
        Recorrer&i  1 ,&CantOperaciones 
            if Val(i:&i) = 1 
            &NrOperacion := GetNumerador(10)
                If  NoVacio(Val(d:&i))
                        &DifDias := DifDias(Dialogo.Fecha1,Val(n:&i),no,no)
                        If Val(p:&i) = Dialogo.Fecha1
                        IF  Eqstr(Val(q:&i),'SI')
                                SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS")
                                SQL.ADD("SET Valor =")
                                SQL.ADD("CASE WHEN NrBit = 70 THEN 1 ELSE 0 END")
                                SQL.ADD("Where NrOperacion ='"~Val(d:&i)~"'")
                                SQL.NEW
                            endif
                            SQL.ADD("UPDATE "~DBO~".OPERACIONES")
                            SQL.ADD("SET NrOperacion4 = '"~&NrOperacion~"'")
                            SQL.ADD("Where NrOperacion ='"~Val(d:&i)~"'")
                            SQL.NEW
                            &Renovacion := 1
                        else
                            SQL.ADD("UPDATE "~DBO~".OPERACIONES")
                            SQL.ADD("SET FechaVto = "~IdxDate2(Dialogo.Fecha1)~",")
                            SQL.ADD("Plazo = '"~FStr(&DifDias,1,0)~"',")
                            SQL.ADD("Observac2 = 'B',")
                            SQL.ADD("NrOperacion4 = '"~&NrOperacion~"',")
                            SQL.ADD("FechaPrecan = "~IdxDate2(Val(p:&i)))
                            SQL.ADD("Where NrOperacion ='"~Val(d:&i)~"'")
                            SQL.NEW
                            
                            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS")
                            SQL.ADD("SET Valor =")
                            SQL.ADD("CASE WHEN NrBit = 92 THEN 1 ELSE 0 END")
                            SQL.ADD("Where NrOperacion ='"~Val(d:&i)~"'")
                            SQL.NEW
                            &Renovacion := 1
                            &Repac := 1
                        
                        endif
                endif
                

                
                if  &i = 1
                    &NrOperacionPrincipal := &NrOperacion
                endif
                
                SQL.ADD(" Insert INTO "~DBO~".OPERACIONES                                           ")
                SQL.ADD(" (  TipoOp,           NrOperacion,       FechaOp,         Especie,         ")
                SQL.ADD("  Cliente1,              Cantidad,       Vehiculo1,         FechaVto,      ")
                SQL.ADD("  Operador,              TipoTasa,       Cuenta1,         Precio1,         ")
                SQL.ADD("  FechaCarga,        FechaCargaSys,     OficialCuenta,     Precio4,        ")
                SQL.ADD("  NrOperacion3,              Plazo,         Observac2,    Precio2,         ")
                SQL.ADD("PorBonificacion,         Sector1                                           ")
                If &Renovacion = 1
                    SQL.ADD(",NrOperacion2,Observac3")
                endif
                SQL.ADD(")")
                SQL.ADD(" Values  ")
                * TipoOp
                SQL.ADD("(      'MMCREM',        '"~&NrOperacion~"', "~IdxDate2(Dialogo.Fecha1)~", '"~Dialogo.Especie1~"',      ")
                * Cliente1
                SQL.ADD("'"~Val(a:&i)~"',        "~Fstr(Val(h:&i),0,2)~",'"~VAR('VEHICULODE')~"',"~IdxDate2(Dialogo.Fecha4)~",  ")
                * Operador
                SQL.ADD("'"~USUARIOACTIVO~"',    '"~Dialogo.TipoTasa~"' ,'"~Val(b:&i)~"',     "~Fstr(Val(f:&i),0,6)~",          ")
                * FechaCarga
                SQL.ADD(      SQLAhora~",          "~IdxDate2(FSYS)~", '"~Val(l:&i)~"',  "~Fstr(Val(k:&i),0,6)~",               ")
                *NrOperacion3
                SQL.ADD("'"~&NrOperacionPrincipal~"',"~FStr(Dialogo.Entero1,1,0)~", 'A', '"~Dialogo.Precio8~"',                 ")                                                               
                *Spread
                SQL.ADD(Fstr(Dialogo.Precio15,0,6)~",'"~Val(az:8)~"'")
                If &Renovacion = 1
                    SQL.ADD(",'"~Val(d:&i)~"'")
                    if &Repac = 1
                        SQL.ADD(",'REPAC'")
                    else
                        SQL.ADD(",'RENOV'")
                    endif
                endif
                SQL.ADD(")")
                SQL.NEW
                
                if  &i = 1
                    ACT(az3, &NrOperacion)
                    ACT(az4, 'OPERACIONES')
                    ACT(az5, '1|') 
                    (.'ALTAINSTA2'.)         
                else
                    ACT(az3, &NrOperacion)
                    ACT(az4, 'OPERACIONES')
                    ACT(az5, '91|') 
                    (.'ALTAINSTA2'.) 
                endif
                
                if NUM(Val(c:&i)) = 0
                    SQL.ADD(" UPDATE "~DBO~".CUENTAS ")
                    SQL.ADD("SET CodigoTasa = '"~GetNumerador(41)~"'")
                    SQL.ADD("Where Codigo ='"~Val(b:&i)~"'")
                    SQL.NEW
                endif
                
                if Dialogo.Check1 =  1
                    SQL.ADD(" Insert INTO "~DBO~".EXCEPCIONES")
                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~&NrOperacion~"','RANGOTASA',"~IdxDate2(FSYS)~",'Tasa Fuera de Rango: "~Dialogo.Precio3~" y "~Dialogo.Precio4~"')")
                    SQL.NEW 
                endif
                
                if Dialogo.Check3 =  1
                    SQL.ADD(" Insert INTO "~DBO~".EXCEPCIONES")
                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~&NrOperacion~"','RANGOTRANS',"~IdxDate2(FSYS)~",'Tasa Transferencia Fuera de Rango: "~Dialogo.Precio9~" y "~Dialogo.Precio10~"')")
                    SQL.NEW 
                endif
                
                 if Dialogo.Check2 =  1
                    SQL.ADD(" Insert INTO "~DBO~".EXCEPCIONES")
                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~&NrOperacion~"','FVALOR',"~IdxDate2(FSYS)~", 'Es una Operacion FechaValor')")
                    SQL.NEW 
                endif
                 if Dialogo.Check4 =  1
                    SQL.ADD(" Insert INTO "~DBO~".EXCEPCIONES")
                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~&NrOperacion~"','SPREADNEG',"~IdxDate2(FSYS)~", 'Spread Negativo: "~Dialogo.Precio14~"')")
                    SQL.NEW 
                endif
                
                if Dialogo.Check5 =  1
                    SQL.ADD(" Insert INTO "~DBO~".EXCEPCIONES")
                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~&NrOperacion~"','TASATMOD',"~IdxDate2(FSYS)~", 'Tasa Transferencia: "~Dialogo.Precio8~". Tasa Transferencia Modificada: "~Dialogo.Precio2~". ')")
                    SQL.NEW 
                endif

                
                &TotalOp := &TotalOp + 1  
        endif
            PROXIMO
            SQL.EXEC
            If &TotalOp = 1
                MessageBox("Se cargo "~FStr(&TotalOp,1,0)~" operacion")
            Else
                MessageBox("Se cargaron "~FStr(&TotalOp,1,0)~" operaciones")
            Endif

            BorrarCeldas(a:1..ab:&CantOperaciones)
        Endif    
Proximo

    
