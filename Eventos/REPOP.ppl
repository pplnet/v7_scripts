
MostrarCuadroDeMensajes
SQL.ADD(" select o.NrOrden from "~dbo~".ORDENES o join "~dbo~".OPERACIONESBITS ob on o.NrOrden = ob.NrOperacion where ob.NrBit = 18 and ob.Valor = 1")
Recorrer SQL
     Message("Procesando Orden Nr: "~fbn['NrOrden'])
     EjecutarEvento2('ACTOME', NrOrden1=fbn['NrOrden'])
     Esperar(2)
proximo
SQL.ADD(" select * from "~dbo~".OPERACIONES o inner join "~dbo~".OPERACIONESBITS")
SQL.ADD(" b on o.NrOperacion = b.NrOperacion and b.NrBit = 18 and b.Valor =1")
Recorrer SQL
     Message("Procesando operacion Nr: "~fbn['NrOperacion'])
     EjecutarEvento2('RECALB', NrOperacion1=fbn['NrOperacion'])
     Esperar(2)
proximo
OcultarCuadroDeMensajes
