CrearDialogo
Fecha1: 'Fecha' ;;;;;;;;;Fsys;

FinDialogo

SetFilaActual(2)

ACT(a:3, 'Fecha')

  SQL.ADD("Select FechaMov From "~DBO~".MOVPENDIENTES ")
  SQL.ADD(" Where FechaMov = '"~Dialogo.Fecha1~"' ")
  
Recorrer SQL
    
    ACT(a:4, fbn('FechaMov'))

Proximo

If NoVacio(Dialogo.Fecha1)
   ACT(a:4, Fecha(Dialogo.Fecha1, 'ddmmyyyy'))
Endif

messagebox(PYC(5684.4526,1,1))
messagebox(Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
messagebox(SQLFechaStr(Dialogo.Fecha1~Hora(AHORA), 'dd/mm/yyyy hh:mm:ss'))

ACT(b:2, PYC(5684,1,1))
ACT(a:1, Val(a4))
