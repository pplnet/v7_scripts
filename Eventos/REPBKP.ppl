** R1 - ** Dialogo por Informacion de trabajo y Construccion
HojaVisible(NO)
ACN(WI:1,0)  * Acumulador Registros Grabados 
ACN(WD:1,0)  * Acumulador Registros Borrados 
ACN(WT:1,0)  * Flag de Proceso 
ACT(cu:1, '') * Comparacion con String Blancos  

CrearDialogo   
  Fecha1       : 'Fecha'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha Desde';NO;Fsys
  Radio1       : 'Tipo|Procesa|No Procesa|Informe ' ;2;1;;SI;No;;;;1;;;
FinDialogo

If Not Ok
  Cancelar
Endif

If Dialogo.Radio1=1
   Cancelar ('Este evento No se puede ejecutar manual !!! ')
   Else 
      If Dialogo.Radio1=2   
                 HojaVisible(Si)
                 ENDIF  
ENDIF  

SQL.ADD(" SELECT TD.Fecha    From "~DBO~".TASASDIA TD ")
SQL.ADD(" WHERE TD.Fecha = '"~IdxDate(Dialogo.Fecha1-1)~"' ")
Recorrer SQL
ACN(WT:1,1)
Proximo
if Val(WT:1) = 0
   Cancelar ('Falta fecha para replicar '~IdxDate(Dialogo.Fecha1-1) ) 
ENDIF

ACD(WF:1,HABILES(Dialogo.Fecha1,-1,VAR('FERIADODEF'),SI)) 
** R2 - Construye la planilla de salida 
*----------   
MostrarCuadroDeMensajes
CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(4,"Arial,12,B")
CrearFont(3,"Arial,8,")
SetFilaActual(2)
ACT(a:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC, Dialogo.Fecha1~'Informe de Control de Replicacion de Tasas Dia al '~val(WF:1))
SetFont(A:Fac..A:Fac,1)
SetFilaActual(FAC+1)
ifa


ACT(A:FAC,'Fecha')
ACT(B:FAC,'Especie')
ACT(C:FAC,'TipoTasa')
ACT(D:FAC,'P.Desde')
ACT(E:FAC,'P.Hasta')
ACT(F:FAC,'Tasa')
ACT(G:FAC,'Fact.Desc.')
ACT(H:Fac,'Accion')

SetFont(a:FAC..H:FAC,2)
AlinearCeldas(a:FAC..H:FAC,'C')
AgregarMarco(a:FAC..H:FAC,1,1,Exe('COLOR'))


** R4 - Accede a la Base de Datos en busca de informacion
*--------
SQL.ADD(" SELECT TD.Especie, TD.Fecha, TD.PlazoDesde, TD.PlazoHasta, TD.TipoTasa, ")
SQL.ADD(" TD.Valor1, TD.Valor2, TD.Valor3, TD.Valor4, TD.Valor5 ")
SQL.ADD(" FROM   "~DBO~".TASASDIA TD ")
SQL.ADD(" WHERE TD.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" ORDER BY TD.PlazoHasta, TD.Especie ")

SetFont(A:4..A:5, 2)
Recorrer SQL
*     MESSAGEBOX("!!!!!!!!! PASO 2 - Elimino Registros")
SCN (WD:1,1)
SQL.ADD(" Delete "~DBO~".TASASDIA ")
    SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"'  ")
    SQL.NEW
    SQL.EXEC
DFA
Proximo

SQL.ADD(" SELECT TD.Especie, TD.Fecha, TD.PlazoDesde, TD.PlazoHasta, TD.TipoTasa, ")
SQL.ADD(" TD.Valor1, TD.Valor2, TD.Valor3, TD.Valor4, TD.Valor5 ")
SQL.ADD(" FROM   "~DBO~".TASASDIA TD ")
SQL.ADD(" WHERE TD.Fecha = '"~IdxDate(Dialogo.Fecha1-1)~"' ")
SQL.ADD(" ORDER BY TD.PlazoHasta, TD.Especie ")

SetFont(A:4..A:5, 2)
Recorrer SQL
************ R5 - Campos Fac para listar

ACT(a:fac, Dialogo.Fecha1) 
ACT(b:fac, fbn('Especie'))           
ACT(c:fac, fbn('TipoTasa'))   
ACT(D:fac, fbn('PlazoDesde'))
ACT(E:fac, fbn('PlazoHasta'))
ACT(h:Fac,'Grabado')             
ACN(F:fac, fbn('Valor1')) 
ACN(G:fac, fbn('Valor4'))  
FormatoCeldas(F:fac..G:fac,Exe('F8')) 
AlinearCeldas(a:FAC..H:FAC,'C') 
SetFont(A:Fac..H:Fac,3)
ACN(V:fac, fbn('Valor2')) 
ACN(W:fac, fbn('Valor3'))
ACN(Z:fac, fbn('Valor5'))   
SCN (WI:1,1)
 ***---Inserto registros del dia copia dia anterior
SQL.ADD(" Insert Into "~DBO~".TASASDIA ")

SQL.ADD(" (Especie, Fecha, PlazoDesde, PlazoHasta, TipoTasa, ")
SQL.ADD("  Valor1, Valor2, Valor3, Valor4, Valor5 ) ")
SQL.ADD(" Values ")
SQL.ADD(" ( '"~Val(B:FAC)~"','"~IdxDate(Dialogo.Fecha1)~"', '"~Val(D:FAC)~"', '"~Val(E:FAC)~"',  ")
SQL.ADD(" '"~Val(C:FAC)~"', '"~Val(F:FAC)~"', '"~Val(V:FAC)~"', '"~Val(W:FAC)~"', ")
SQL.ADD(" '"~Val(G:FAC)~"', '"~Val(Z:FAC)~"' )  ")

SQL.NEW
SQL.EXEC
  
Proximo
ifa

** R7 -  ENVIA MESAGEBOX  (VISUAL E IMPRESAS)
*-------
LimitesVision(e:Fac)
ACO(1,10)     * Fecha.  
ACO(2,9)      * Especie. 
ACO(3,8)      * Tipo Tasa. 
ACO(4,8)      * Plazo Desde
ACO(5,8)      * Plazo Hasta
ACO(6,12)     * Valor1 (Tasa) 
ACO(7,12)     * Valor4 (Factor Descuento)
ACO(8,10)     * Accion   

Message(" Registros Grabados= "~VAL(WI:1)~" Registros Borrados= "~VAL(WD:1))
MessageBox('Se Genero el Archivo Replica de tasas para el dia: '~Dialogo.Fecha1)

ACT(a:FAC+1, 'Total Registros Grabados = ')
ACn(D:FAC+1, VAL(WI:1))
FormatoCeldas (d:Fac+1, exe('F0')) 
ACT(a:FAC+2, 'Total Registros Borrados = ')
ACn(D:FAC+2, VAL(WD:1))
FormatoCeldas (d:Fac+2, exe('F0'))

IMPRESION(1,2)