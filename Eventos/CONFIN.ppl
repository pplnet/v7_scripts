* Este evento muestra un listbox con las transacciones inmediatas no confirmadas para seleccionar
* aquellas que se quieran confirmar.


ACN(a1,BuscarCampo('ESTADOSCUSTODIA','NrSaldo','Codigo',VAR('SALLIBRECU')) )


* Selecciono las Transferencias Inmediatas que no esten confirmadas de Saldos 101
SQL.ADD("SELECT T.NrTrans, T.TipoTr2, T.Fecha1, T.Fecha2, T.Especie, T.Cliente1, T.Cliente3, ")
SQL.ADD("       T.Cliente4, T.ComitenteExt, T.Cantidad1, T.Cantidad2, T.Cambio1,T.CB6,T.NrOperacionRef1 ")
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE T.RB1 = 2 AND ")
SQL.ADD("      T.CB1 = 1 AND ")
SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
SQL.ADD("      T.NrTrans IN (SELECT DISTINCT M.NrOperacion ")
SQL.ADD("                    FROM "~DBO~".MOVPENDIENTES M ")
SQL.ADD("                    WHERE M.NrSaldo = "~FSTR(Val(a1),0,0)~" AND ")
SQL.ADD("                          M.NrOperacion = T.NrTrans) ")
SQL.ADD("ORDER BY T.NrTrans ")

ACN(de1, 1)
ACN(ha1, 0)
SetFilaActual(Val(de1)-1)

Recorrer SQL

   SCN(ha1, 1)
   ACT(ab:Val(ha1), FBN['NrTrans'])
   ACT(ac:Val(ha1), FBN['TipoTr2'])
   ACD(ad:Val(ha1), FBN['Fecha1'])
   ACD(ae:Val(ha1), FBN['Fecha2'])
   ACT(af:Val(ha1), FBN['Especie'])
   ACT(ag:Val(ha1), FBN['Cliente1'])
   ACT(ah:Val(ha1), FBN['Cliente3'])
   ACT(ai:Val(ha1), FBN['Cliente4'])
   ACT(aj:Val(ha1), FBN['ComitenteExt'])
   ACN(ak:Val(ha1), FBN['Cantidad1'])
   ACN(al:Val(ha1), FBN['Cantidad2'])
   ACN(am:Val(ha1), FBN['Cambio1'])

   ACT(an:FAC,'')

   *- DEP/RET que dio origen al DTP/RTP Automatico 
   If EqStr(FBN['CB6'],'1')
      ACT(an:val(ha1),FBN['NrOperacionRef1'])
   EndIf
Proximo

IF Val(ha1) < Val(de1)
   Cancelar("No se encontraron Transferencias Inmediatas sin confirmar")
ENDIF

CrearListBox ; 'MS Sans Serif,8,';'Confirmacion de Transferencias Inmediatas'
   'Marca'         ; aa:Val(de1)..aa:Val(ha1);SI;SI;; 30;CHECK ; RGB(251,253,181)
   'Nr Trans'      ; ab:Val(de1)..ab:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Tipo'          ; ac:Val(de1)..ac:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'F. Trans'      ; ad:Val(de1)..ad:Val(ha1);NO;SI;; 80;FECHA ;RGB(175,200,228)
   'F. Matcheo'    ; ae:Val(de1)..ae:Val(ha1);NO;SI;; 80;FECHA ;RGB(175,200,228)
   'Especie'       ; af:Val(de1)..af:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Cliente'       ; ag:Val(de1)..ag:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Depos. Origen' ; ah:Val(de1)..ah:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Codigo Depos.' ; ai:Val(de1)..ai:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Comitente Ext.'; aj:Val(de1)..aj:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'C.N.'          ; ak:Val(de1)..ak:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.####';RGB(175,200,228)
   'C.R.'          ; al:Val(de1)..al:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.####';RGB(175,200,228)
   'Monto'         ; am:Val(de1)..am:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.##';RGB(175,200,228)
FinListBox

IF Not Ok
   Cancelar
ENDIF

* Aca confirmo los movimientos 101 de las Transferencias Inmediatas
Recorrer&j Val(de1), Val(ha1)
   IF Val(aa:&j) = 1
      **- Marco la Transaccion que se esta matcheando          
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Fsys)~"',Cupon2='"~Fstr(NrCupon2(val(af:&j),Fsys),0,0)~"'")
      SQL.ADD("WHERE  NrTrans= '"~Val(ab:&j)~"' ")
      SQL.NEW
      SQL.EXEC

      SQL.ActualizarMovimientosT2(Val(ab:&j),SI,NO,NO,SI,0,4)
      SQL.EXEC


      *- Pasa de Instancia
      ACT(az3,Val(ab:&j))
      ACT(az4,'TRANSACCIONES2')
      ACN(az5,70)
      ACN(az6,1 )
            
     (.'MODIINSTAN'.)

     IF NoVacio(val(an:&j))
        *- Recupero los nros. de operacion que originaron la transaccion
        SQL.ADD("SELECT DISTINCT NrOperacion ")
        SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS ")
        SQL.ADD("WHERE  NrTrans2 = '"~val(an:&j)~"'")
        SQL.ADD("       and NrOperacion  <> '"~val(an:&j)~"'")

        Recorrer SQL
            DFA
            *- Confirmo la operacion para sacar los movimientos de limites
            ACT(op:1,FBN['NrOperacion'])
            (.'CONFOPEXTR'.)
        Proximo

        *- Muevo el DEP o RET  a la instancia Termial '~val(an:&j)
        ACT(az3,val(an:&j))
        ACT(az4,'TRANSACCIONES2')
        ACN(az5,70)
        ACN(az6,0 )   
        (.'MODIINSTAN'.)
     EndIf
   ENDIF
Proximo
