CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;;FSYS
  Fecha4   : 'Pri mes'     ;;;;NO;;;;;;PriDeMes(Dialogo.Fecha1,NO,'ARG')
  Fecha2   : 'Fecha 1Mes'  ;;;;NO;;;;;;PriDeMes(Habiles(Dialogo.Fecha1,-1,'ARG',SI),SI)
  Fecha3   : 'Fecha FMes'  ;;;;NO;;;;;;FinDeMes(Habiles(Dialogo.Fecha1,-1,'ARG',SI),SI)    
  Fecha5   : 'Habil FMes'  ;;;;NO;;;;;;FinDeMes(Dialogo.Fecha2,NO,'ARG')    
  Vehiculo1: 'Vehiculo'    ;;;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
FinDialogo

if not ok
  Cancelar
endif

**
** 1er dia habil del mes capitalizar interes, calcular IVA y WTH
IF Dialogo.Fecha1= Dialogo.Fecha4
     SQL.ADD(" Select SUM(Monto) as Interes, NrOperacion ")
     SQL.ADD(" from "~DBO~".MOVDEVENGADOS ")
     SQL.ADD(" where Fecha Between '"~IdxDate(Dialogo.Fecha2)~"'  and '"~IdxDate(Dialogo.Fecha3)~"' ")
     SQL.ADD("   and (Select "~DBO~".SaldoCONU(NrOperacion,'"~IdxDate(Dialogo.Fecha3)~"',2))>0")
     SQL.ADD("   and TipoDevengado = 'INTICL' ")
     SQL.ADD("   and NrSaldo = 110 ")
     SQL.ADD(" Group by NrOperacion ")
     watch(SQL.Batch)
     recorrer SQL
            **llamar evento WTH - IVA - Capitalizacion Intereses
            **EjecutarEvento('ICLINC', Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha3,NrOperacion1=FBN['NrOperacion'],Cantidad1=FBN['Interes'],Vehiculo1=Var('VEHICULODE') )
            EjecutarEvento('ICLINC', Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha5,NrOperacion1=FBN['NrOperacion'],Cantidad1=FBN['Interes'],Vehiculo1=Var('VEHICULODE'),Check1=0)
     Proximo
Endif

