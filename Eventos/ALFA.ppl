CrearDialogo
  Fecha1       : "F Real Ej."               ;1;1;;NO;;[Dialogo.Radio1=0 y Dialogo.Fecha1>=Dialogo.Fecha4] o [Dialogo.Radio1=1 y Dialogo.Fecha1>=Dialogo.Fecha2];iif(Dialogo.Radio1=0,'OPCION EUROPEA, FECHA DE EJERCICIO DEBE SER >= LAST TRADING DATE','OPCION AMERICANA, FECHA DE EJERCICIO DEBE SER >= FECHA CONCERTACION');NO;Fsys
  NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MRO');'DEBE INGRESAR UNA OPERACION DE TIPO MRO NO EJERCIDA';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'MRO' and CB8<>'1' ")
  Radio4       : "Ejerce?|Si|No"            ;;;;;;;;;0;
  Radio1       : "Opcion|Europea|Americana" ;1;2;;NO;;;;;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Call|Put"            ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : "Operacion de|Compra|/Venta" ;;;;NO;;;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "LastTrading"              ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaEx4','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Ej"                ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Fecha2       : "Concertacion"             ;;;;NO;NO;;;;;BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Especie"                  ;;;;NO;NO;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
FinDialogo


if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

if Dialogo.Radio4=1
     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)
     messagebox('LA OPCION SE ENVIO A SUPERVISION ESPECIAL MOF')
     Cancelar
endif

if Dialogo.Radio4=0

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MRO|')
   Cancelar('LA OPERACION N# '~Dialogo.NrOperacion1~' NO ES UNA OPCION DE MERCADO REGULADO')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

if Ok
   * Recupero la operacion
   SQL.ADD("Select MensajeChequeo as Opcion,* from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL

    If Incluido(BuscarCampo('OPCIONES2','ClaseContrato','Codigo',FBN('Opcion')),'FUT')  o Not Incluido(BuscarCampo('OPCIONES2','ClaseContrato','Codigo',FBN('Opcion')),'FUT') 
       *- Para que genere la operacion para cualquier opcion hasta que juan agregue si es de futuro
       
       * numerador operacion futuro
       ACT (Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',fbn['Vehiculo1'])))

       Message('Actualizando la Opcion .... ')                  
       *** Marca la operacion como ejercida ***
       SQL.ADD("Update "~DBO~".OPERACIONES ")
       SQL.ADD("Set CB8 = '1', ")
       SQL.ADD("NrOperacion2 = '"~VAL(Z3)~"', ")
       SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
       SQL.NEW
       SQL.EXEC

       acn (a1, BuscarCampo('Contratos','Tamanio','Codigo',fbn['Contrato']) * fbn['Cantidad'] * fbn['PrecioEj'])

       * Actualizo la Instancia de la Operacion a Supervision
       (.'MODIINSTAN'.)      
       messagebox('LA OPCION SE ENVIO A SUPERVISION ESPECIAL MOF')


       * Genero la operacion de futuro   
       * compra o venta
       if [fbn['MB3']=0 Y fbn['MB1']=0] O [fbn['MB3']=1 Y fbn['MB1']=1]
          ACT(Z10,'0')
       else
          ACT(Z10,'1')
       endif
 
       SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
       SQL.ADD("(TipoOp, Book1, NrOperacion, ")
       SQL.ADD(" FechaOp, Vehiculo1, MB3, ContraEspecie3, ")
       SQL.ADD(" MB2, MB4, Contrato, TotalBrutoCli1, ")
       SQL.ADD(" Cliente1, Observac2, Cantidad, ")
       SQL.ADD(" TotalAux1, Precio1, Operador, ")
       SQL.ADD(" Especie, Mercado, FechaEx4, ")
       SQL.ADD(" OperacionRef, RB3, TablaFeriados1, Cotizacion1) ") 
       SQL.ADD("Values")
       SQL.ADD("('MRF','"~FBN['Book1']~"', '"~VAL(Z3)~"', ")
       SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN['Vehiculo1']~"', '"~val(z10)~"', 'USD', ")
       SQL.ADD(" '"~FBN['MB2']~"', '"~FBN['MB4']~"', '"~FBN['Contrato']~"', "~Fstr(FBN['Cantidad'],0,4)~", ")
       SQL.ADD(" '"~FBN['Cliente1']~"', '"~FBN['Observac2']~"', "~Fstr(FBN['Cantidad'],0,4)~", ")
       SQL.ADD(" "~Fstr(val(a1),0,4)~", "~Fstr(fbn['PrecioEj'],0,2)~", '"~FBN['Operador']~"', ")
       SQL.ADD(" '"~FBN['Especie']~"', '"~FBN['Mercado']~"', '"~IdxDate(FBN['FechaEx4'])~"', ")
       SQL.ADD(" '"~Dialogo.NrOperacion1~"', '"~FBN['RB3']~"', '"~FBN['TablaFeriados1']~"', "~Fstr(FBN['Cotizacion1'],0,4)~") ")
       SQL.NEW
       SQL.EXEC

       (.'INSTCONMOF'.)

       MESSAGEBOX('LA NUEVA MRF SE ENCUENTRA EN CONCERTACION CON CODIGO '~VAL(Z3))
    EndIf

   Proximo
endif
endif