SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Especie, O.Cliente1, ")
SQL.ADD("       O.NrOperacion3, NrOperacion4,O.FechaAltaMAE, O.FechaBajaMAE ")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.NrOperacion in ('T0007998','T0007999','T0008000','T0008001') ")
*SQL.ADD(" where O.NrOperacion in ('T0007998') ")

Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACT(d:FAC, fbn('Especie'))
  ACT(e:FAC, fbn('Cliente1'))
  ACT(f:FAC, fbn('NrOperacion3'))
  ACD(g:FAC, fbn('FechaAltaMAE'))
  ACT(h:FAC, Fecha(Trunc(fbn('FechaAltaMAE'),0))~' '~Hora(fbn('FechaAltaMAE')))
  ACT(i:FAC, SQLFechaStr(Fecha(Trunc(fbn('FechaAltaMAE'),0))~' '~Hora(fbn('FechaAltaMAE')),Exe('FORFECHOR')))
  
  ACT(k:FAC, fbn('NrOperacion4'))
  ACD(l:FAC, fbn('FechaBajaMAE'))
  ACT(m:FAC, Fecha(Trunc(fbn('FechaBajaMAE'),0))~' '~Hora(fbn('FechaBajaMAE')))
  ACT(n:FAC, SQLFechaStr(Fecha(Trunc(fbn('FechaBajaMAE'),0))~' '~Hora(fbn('FechaBajaMAE')),Exe('FORFECHOR')))


*  SQL.ADD("   and FechaAltaMAE = Convert(datetime,'"~Val((3+FAC):24)~"',120) ")
* SQLFechaStr(Val(K9),Exe('FORFECHOR'))  
  if Dialogo.Check1=1
    SQL.ADD("update "~DBO~".OPERACIONES Set ")
*    SQL.ADD("       FechaAltaMAE = Convert(datetime,'"~Fecha(Trunc(fbn('FechaAltaMAE'),0))~' '~Hora(fbn('FechaAltaMAE'))~"',120)  ")
    SQL.ADD("       FechaAltaMAE = "~Val(i:FAC)~"  ")
    SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion3')~"'")
    SQL.NEW
    SQL.ADD("update "~DBO~".OPERACIONES Set ")
*    SQL.ADD("       FechaAltaMAE = Convert(datetime,'"~Fecha(Trunc(fbn('FechaBajaMAE'),0))~' '~Hora(fbn('FechaBajaMAE'))~"',120)  ")
    SQL.ADD("       FechaAltaMAE = "~Val(n:FAC)~"  ")
    SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion4')~"'")
    SQL.NEW
    SQL.EXEC
  endif
Proximo
        
