** FJL 18/11/21 - Se agrega cotizacion de la Accion para calcular comisiones
ACN(co:1, CotizacionC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,Val(z:10)))
ACN(co:2, 1)
ACN(co:3, CotizacionC(Var('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
ACN(co:4, Cotizacion(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI))
ACN(SL:1, BuscarCampo('EstadosCustodia','NrSaldo','Codigo', VAR('SALLIBRECU')))
* Saldos Libre
ACT(sl:2, VAR('LIBREDISP'))
* Saldos Bloquedos
ACT(sl:3, VAR('BLOQUEOS'))
* Saldos Parking
ACT(sl:4, VAR('SALPARK'))

** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
* Mercado Liquidacion Saldo Bloquedos
ACT(ml:1, VAR('MERAUXLIQ'))

Recorrer&i 1,Val(z:5)
  * Por cada Especie Destino
  CrearDialogo
    Precio1 : 'Rel.Origen'  ;2;2;;  ;;Dialogo.Precio1>0;'Debe especificar un valor positivo';NO;1;;;;'##0.0000'
    Precio2 : 'Rel.Destino' ;3;2;;  ;;Dialogo.Precio2>0;'Debe especificar un valor positivo';NO;1;;;;'##0.0000'
    Label1  : ''            ;1;1;;NO;;;;;'Relacion entre Especies'
    Especie1: 'Esp.Actual'  ;2;1;;NO;;;;;Val(z:1)
    Especie2: 'Esp.Nueva'   ;3;1;;NO;;;;;ItemLista(Val(z:3),&i)
  FinDialogo
  If Not Ok
    Cancelar
  Else
    ACT(z:2,Val(z:2)~FStr(Dialogo.Precio1,1,4)~'|')
    ACT(z:4,Val(z:4)~FStr(Dialogo.Precio2,1,4)~'|')
  Endif
