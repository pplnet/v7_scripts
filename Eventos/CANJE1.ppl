*#define PRUEBA
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1    :'Record Date'      ;1;1;;  ;  ;Dialogo.Fecha1<>0;'Debe ingresar un Record Date valido';NO;FSys
  Fecha2    :'Fecha Pago'       ;2;1;;  ;  ;Dialogo.Fecha2<>0;'Debe ingresar una Fecha valida'     ;NO;FSys
  Especie1  :'Especie'          ;3;1;;  ;  ;NoVacio(Dialogo.Especie1) y Not DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una Especie valida'   ;NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' " 
  Mercado1  :'Mercado'          ;4;1;;  ;  ;
  Lista1    :'Nuevas Especies ' ;1;2;;  ;  ;NoVacio(Dialogo.Lista1);'Debe Seleccionar Nuevas Especies';NO;;;SQLSet("select Codigo from "~DBO~".ESPECIES where Jerarquia LIKE '"~Jerarquia('ESPECIES','ACCION')~"%' order by Codigo ")
  Especie2  :'Moneda Fraccion'  ;0;1;;NO;  ;NoVacio(Dialogo.Especie2);'Debe ingresar moneda Fraccion';NO;VAR('MONELOCA');IF(NoVacio(Dialogo.Especie1),QUERY(" Select MonedaEmision from "~DBO~".ESPECIES where Codigo='"~Dialogo.Especie1~"' "));'ARP|USD|';;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Cantidad1 :'Valor Fraccion'   ;1;1;;  ;  ;Dialogo.Cantidad1>0;'Debe especificar un Valor de Fraccion positivo';NO
  Vehiculo1 :'Vehiculo'         ;2;1;;  ;  ;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el vehiculo';NO;VAR('VEHICULODE')
  Operador1 :'Operador'         ;3;1;;NO;  ;NoVacio(Dialogo.Operador1);'Debe Ingresar el Operador';NO;USUARIOACTIVO
FinDialogo

If Not Ok
  Cancelar
Endif
#ifdef PRUEBA
  HojaVisible(SI)
#endif 

ACD(FE:1, Dialogo.Fecha1)
ACD(FE:2, Dialogo.Fecha2)
ACT(VH:1, Dialogo.Vehiculo1)
ACT(z:1 ,Dialogo.Especie1)
ACT(z:3 ,Dialogo.Lista1)
* Cantidad de Especies Destino
ACN(z:5 ,Elementos(Dialogo.Lista1))
ACD(z:6 ,Dialogo.Fecha1)
ACD(z:7 ,Dialogo.Fecha2)
ACT(z:9 ,Dialogo.Mercado1)
ACT(z:10,Dialogo.Especie2)
ACN(z:11,Dialogo.Cantidad1)
ACT(z:12,Dialogo.Vehiculo1)
ACN(SA:1, 0)
ACN(SA:2, 0)
ACT(xx:1, '*')

***---Obtengo datos de la especie
SQL.ADD(" Select Nombre, ISIN, LaminaMinima ")
SQL.ADD(" From "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")

Recorrer SQL
  DFA
  ACT(NM:1, fbn('Nombre'))
  ACT(AI:1, fbn('ISIN'))
  ACN(LM:1, IIF(fbn('LaminaMinima')=0,1,fbn('LaminaMinima')))
