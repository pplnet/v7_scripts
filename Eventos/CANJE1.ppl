* FJL 22/01/23 - Saco lo de Pendientes para mostrar en Demo
IF NO
   ACT(xx:1, '*')
   ACN(FI:1, fac+1)
   ***---MOVPENDIENTES
   SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Mercado, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
   SQL.ADD("       C.CondicionGan, C.CondicionIVA, C.Res3337, C.TipoCliente, C.TIngBru, '"~Val(VH:1)~"' Alias1 ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*   SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O ")
   SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS CU ")
   SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
   SQL.ADD("   and C.Status       = 'HAB' ")   
   SQL.ADD("   AND M.NrSaldo      = 1 ")
   SQL.ADD("   AND M.Especie      = '"~Val(z:1)~"' ")
   SQL.ADD("   AND M.NrOperacion  = O.NrOperacion ")
** FJL 24/05/21 - Cambio de criterio
*   SQL.ADD(" AND M.Cliente = '"~Val(VH:1)~"'")
*   SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Val(VH:1)~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*   SQL.ADD("       OR ('"~Val(VH:1)~"' = C.Codigo AND 'HAB' = C.Status )) ")
   SQL.ADD("   and M.EnteCustodia = '"~Val(VH:1)~"' ")
   SQL.ADD("   and M.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(VH:1)~"' ")
   If Not CeldaVacia(z:9)
     SQL.ADD(" AND M.Mercado      = '"~Val(z:9)~"'")
   EndIf
   SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Val(z:6))~"'  ")
   SQL.ADD(" GROUP BY M.Cliente, M.Cuenta, M.Mercado, C.RazonSocial, C.CondicionGan, ")
   SQL.ADD("          C.CondicionIVA, C.TipoCliente, C.Res3337, C.TipoCliente, C.TIngBru ")
   
   SQL.ADD(" Union ")
   
   SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Mercado, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
   SQL.ADD("       C.CondicionGan, C.CondicionIVA, C.Res3337, C.TipoCliente, C.TIngBru, '"~Val(VH:1)~"' Alias1 ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*   SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS CU ")
   SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
   SQL.ADD("   and C.Status       = 'HAB' ")   
   SQL.ADD("   AND M.NrSaldo      = "~Fstr(Val(SL:1), 0, 0)~" ")
   SQL.ADD("   AND M.Especie      = '"~Val(z:1)~"' ")
   SQL.ADD("   AND M.NrOperacion  = T.NrTrans ")
   SQL.ADD("   AND (T.TipoTr2 not in ('CANJE','DTP','RTP') or (CB6 = '0' and  T.TipoTr2 in ('DTP','RTP'))) ")
** FJL 24/05/21 - Cambio de criterio
*   SQL.ADD(" AND M.Cliente = '"~Val(VH:1)~"'")
*   SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Val(VH:1)~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*   SQL.ADD("       OR ('"~Val(VH:1)~"' = C.Codigo AND 'HAB' = C.Status )) ")
   SQL.ADD("   and M.EnteCustodia = '"~Val(VH:1)~"' ")
   SQL.ADD("   and M.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(VH:1)~"' ")
   If Not CeldaVacia(z:9)
     SQL.ADD(" AND M.Mercado      = '"~Val(z:9)~"'")
   EndIf
   SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Val(z:6))~"'  ")
   SQL.ADD(" GROUP BY M.Cliente, M.Cuenta, M.Mercado, C.RazonSocial, C.CondicionGan, ")
   SQL.ADD("          C.CondicionIVA, C.TipoCliente, C.Res3337, C.TipoCliente, C.TIngBru ")
   
   SQL.ADD(" ORDER BY M.Cliente, M.Mercado, M.Cuenta ")
   
   ACN(aa:5,fac)
   ACN(ZZ:2,fac)
   
   Recorrer SQL
     SCN(aa:5,1)
     ACT(aa:1,fbn('Cuenta'))
     ACT(aa:3,fbn('Mercado'))
   
     Recorrer&i 1,Val(z:5)
       If &i = 1
         ACT(a:fac, fbn('Cliente'))
         ACT(b:fac, fbn('Cuenta'))
         ACT(c:fac, fbn('Mercado'))
         ACN(e:fac, -fbn('Cantidad'))
         ACT(p:fac, fbn('RazonSocial'))
         ACT(r:fac, fbn('RazonSocial'))
         ACT(TC:1, fbn('TipoCliente'))
         ACT(AA:21, fbn('Cliente'))
          
         If Not Eqstr(Val(AA:21), fbn('Cliente'))
           ACN(xp:fac-1, 1)
           ACT(AA:21, fbn('Cliente'))
           message('Cliente: '~fbn('Cliente'))
         Endif
          
         ***---Por default se asigna a la primer especie destino el total del saldo
         ACN(f:fac, 1)
         ACN(g:fac, -fbn('Cantidad'))
         ** FJL 18/11/21 - Valuacion de la accion origen para calcular comisiones
         ACN(t:fac, Val(e:fac)*Val(co:1))
       Else
         ACN(f:fac,0)
         ACN(g:fac,0)
         SCN(aa:5,1)
         ifa
       Endif  
       
       ACN(se:fac,fbn('Cantidad'))
       ACT(me:fac,fbn('Mercado'))
       
       If NoVacio(Val(a:fac))
          ***---Guardo el Cliente
          ACT(cc:1, Val(a:fac))
          ACT(cl:fac, Val(a:fac))
       Else
          ACT(cl:fac, Val(cc:1))
       Endif
       
       ACN(h:fac,Num(ItemLista(Val(z:2),&i)))
       ACT(i:fac,ItemLista(Val(z:3),&i))
       ACN(j:fac,Num(ItemLista(Val(z:4),&i)))
       ACT(q:fac,'')
       
** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar la cuenta. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
       IF Not Eqstr(Val(cl:fac), Val(vh:1))
          ***---Los Aranceles son solo para los 'CLI'
          ***---Uso la celda BD como marca porque cuando se canjea por mas de una especie, en la
          ***---grilla no se repiten los datos del cliente.
          ACN(BD:fac, 1)
*          ACT(CF:fac, SQL(" SELECT Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND Especies LIKE '"~Val(Z:10)~"%' "))
          ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          ACN(BB:fac, 0)
          ACN(PI:fac, 0)
       ELSE
*          ACT(CF:fac, SQL(" SELECT Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') "))
          ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          ACN(BD:fac, 0)
          ACN(PI:fac, 0)
       ENDIF
       ACN(aa:4,Val(g:fac)*Val(j:fac)/Val(h:fac))
       ACN(n:fac,Trunc(Val(aa:4)))
       ACN(o:fac,(Val(aa:4)-Val(n:fac))*Val(z:11))

       If &i = 1
         if Not EqStr(Val(a:fac),Val(vh:1)) y Val(t:fac)>0
           ACT(de:fac, 'CANJE')
           ACN(dg:fac, COTIZACIONC(Val(z:10),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
           ACN(dh:fac, iif(EqStr(Modo(Val(z:10),VAR('MONELOCA')),'INV'),1/val(dg:fac),val(dg:fac)))
       
           ACN(df:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1)        ,Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),4,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))
           ACN(da:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1)        ,Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),0,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))

           * Cond IVA
           ACT(dc:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
           * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*           ACN(dd:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(dc:fac))/100)
           ACN(dd:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(dc:fac))/100)
          
           * IVA
           ACN(db:fac, Val(da:fac)*Val(dd:fac))
         else
           ACN(da:fac, 0)
           ACN(db:fac, 0)
         endif  
       endif  
  
     Proximo
   Proximo
   
   ACN(xp:fac-1, 1)
   
   If Val(aa:5) = Val(ZZ:2)
      MessageBox('No se encontraron Movimientos de la especie solicitada')
   Else
      CrearListBox ; 'Arial,8,';'Canje: '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') - MOVPENDIENTES'
       'Cliente'        ;r:Val(FI:1)..r:Val(aa:5)  ;NO;;;90;STRING;;RGB(220,220,193)
       'Cuenta'         ;b:Val(FI:1)..b:Val(aa:5)  ;NO;;;80;STRING;;RGB(220,220,193)
       'Mercado'        ;c:Val(FI:1)..c:Val(aa:5)  ;NO;;;60;STRING;;RGB(220,220,193)
       'Cantidad'       ;e:Val(FI:1)..e:Val(aa:5);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
       'Ok?'            ;f:Val(FI:1)..f:Val(aa:5)  ;;;;40;CHECK ;RGB(255,255,193)
       'Cant.Orig.'     ;g:Val(FI:1)..g:Val(aa:5);SI;;;120;NUMERO;'##,###,###.##';RGB(255,255,193);;;;;;;;SI
       'Rel.Origen'     ;h:Val(FI:1)..h:Val(aa:5)  ;NO;;;70;NUMERO;'###,###';RGB(220,220,193)
       'Nueva Especie'  ;i:Val(FI:1)..i:Val(aa:5)  ;NO;;;90;STRING;;RGB(220,220,193)
       'Rel.Destino'    ;j:Val(FI:1)..j:Val(aa:5)  ;NO;;;70;NUMERO;'###,###';RGB(220,220,193)
       'Cant.Dest.'     ;n:Val(FI:1)..n:Val(aa:5);NO;;;120;NUMERO;'##,###,###.##';RGB(220,220,193);Trunc(Val(g:flb)*Val(j:flb)/Val(h:flb))
       'Fraccion '~ Val(z:10) ;o:Val(FI:1)..o:Val(aa:5);NO;;;100;NUMERO;'##,###,###.##';RGB(220,220,193);((Val(g:flb)*Val(j:flb)/Val(h:flb))-Trunc(Val(g:flb)*Val(j:flb)/Val(h:flb)))*Val(z:11)
** FJL 24/05/21 - Ojo que, cuando el cliente NO es el vehiculo, en el SQL() usa mercado = Val(c:fac) y es el mercado de las acciones
       'Cta.Fraccion'   ;cf:Val(FI:1)..cf:Val(aa:5);SI;Val(f:FLB)=0 o ClienteCuenta(Val(cl:FLB),Val(cf:FLB),Val(z:10));'Cuenta de Fraccion Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Val(bd:FLB)=0, "'"~Val(cl:FLB)~"'=Cliente AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%')"," Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND Mercado='"~Val(c:FLB)~"' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%')");RGB(255,255,193);Iif(EqStr(Val(cl:FLB),Val(vh:1)),SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') "),SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') AND Mercado='"~Val(c:FLB)~"'"));NO;NO;iif(EqStr(Val(cl:FLB),Val(VH:1)),'12');;;;SI 
       'Valuacion'      ;t:Val(FI:1)..t:Val(aa:5);NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
       'Comision'       ;da:Val(FI:1)..da:Val(aa:5);NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
       'IVA'            ;db:Val(FI:1)..db:Val(aa:5);NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
      FinListBox
      
      If NOT Ok
        Cancelar
      Endif
#ifdef PRUEBA
  MessageBox('Despues ListBox 2')
#else
      
      Recorrer&j Val(FI:1), fac
        ***---Sumo las cantidades seleccionadas para los 'CLI'
        If Val(F:&j)=1 y Val(BD:&j)=1
          SCN(SA:1, Val(G:&J))
        Endif
        ***---Sumo las cantidades seleccionadas para el Vehiculo
        If Val(F:&j)=1 y Val(BD:&j)=0
          SCN(SA:2, Val(G:&J))
        Endif
      Proximo
      
      * Controles  ------------------------------------------------------------------------------ *
      
      Recorrer&i Val(FI:1),Val(aa:5)
        * a: Cliente   b: Cuenta   c: Mercado   e: cantidad   p: razon Social
        If Not CeldaVacia(a:&i)
          ACN(aa:8,&i)
          ACT(aa:6, Val(a:&i))
          ACT(aa:10,Val(b:&i))
          ACT(aa:11,Val(c:&i))
          ACN(aa:9, Val(e:&i))
          ACT(aa:7, Val(p:&i))
        Endif
      
        If Val(f:&i) = 1
          * --- gg: Cantidad Origen
          If Val(g:&i) < 0
             SCN(aa:9,(-1)*Val(gg:&i))
          Else
             SCN(aa:9,Val(gg:&i))
          EndIf
          If Val(aa:9) < 0
            MessageBox('Se ha excedido el saldo de '~Val(z:1)~' del Cliente '~Val(aa:7)~' para la Cuenta '~Val(aa:10)~'.'~Chr(13)~Chr(10)~'No se grabaran sus movimientos.')
            Recorrer&j Val(aa:8),&i
              ACN(f:&j,0)
            Proximo
          Endif
        Endif
      Proximo
      
      * Grabo la Informacion -------------------------------------------------------------------- *
      
      Recorrer&i Val(FI:1),Val(aa:5)
        If Not CeldaVacia(a:&i)
           * a: Cliente  b: Cuenta  c: Mercado
           ACT(aa:6 ,Val(a:&i))
           ACT(aa:10,Val(b:&i))
           ACT(aa:11,Val(c:&i))
           ACT(aa:14,SQL("select * from "~DBO~".CUENTAS where Cliente='"~Val(z:12)~"' and Mercado='"~Val(aa:11)~"' and (Especies LIKE '%TITULO%' or Especies LIKE '%"~Val(z:1)~"%')  and Estado='HAB' "))
        Endif
        
        If Val(f:&i) = 1
           If Not Eqstr(Val(b:&i), Val(xx:1)) y NoVacio(Val(r:&i))
              ACN(FR:1,0)
              
              * Genero los mov de la transaccion anterior
              SQL.EXEC
              SQL.ActualizarMovimientosT2(Val(aa:13),SI,NO,NO,NO)
              
              SQL.EXEC
              ACT(aa:13,GetNumerador(405))
              
              **** Grabo Transaccion ****
      
              SQL.ADD("insert into "~DBO~".TRANSACCIONES2 ")
              SQL.ADD("(TipoTr2, NrTrans, Cliente1, Numerador, UsrInput, ")
              SQL.ADD(" Vehiculo1, Mercado1, Especie, Especie2, ")
              SQL.ADD(" Fecha1, Fecha2, FechaCarga, FechaCargaSys, ")
              SQL.ADD(" Cuenta1, Cuenta5, Cantidad1,  Cantidad3, ")
              SQL.ADD(" Cambio2, Cambio3, Cambio4, Cliente2, ")
              * FJL 26/09/21 - Comisiones Eventos Corporativos
              SQL.ADD(" Cantidad10, Cantidad11, ")
              SQL.ADD(" RB1, RB2) ")
              SQL.ADD(" values ")
              SQL.ADD("('CANJE','"~Val(aa:13)~"','"~Val(aa:6)~"', 405, '"~USUARIOACTIVO~"', ")
              SQL.ADD(" '"~Val(z:12)~"', '"~Val(me:&i)~"', '"~Val(z:1)~"','"~Val(z:10)~"', ")
              SQL.ADD(" "~IdxDate2(Val(z:6))~","~IdxDate2(Val(z:7))~","~IdxDate2(FSys)~","~IdxDate2(FSys)~", ")
              SQL.ADD(" '"~Val(aa:10)~"', '"~Val(cf:&i)~"', "~Val(se:&i)~", "~Val(o:&i)~", ")
              SQL.ADD(" "~Val(h:&i)~","~Val(j:&i)~","~Val(z:11)~", '"~Val(CR:&i)~"', ")
              * FJL 26/09/21 - Comisiones Eventos Corporativos
              SQL.ADD(" "~FStr(Val(da:&i),0,0)~", "~FStr(Val(db:&i),0,0)~", ")
              SQL.ADD(" '2', '0') ")
              SQL.NEW
      
              **** Va a la instancia 51 - Corporate Actions ****
      
              SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ")
              SQL.ADD(" ( NrOperacion, NrBit, Valor ) ") 
              SQL.ADD(" VALUES ")
              SQL.ADD(" ( '"~Val(aa:13)~"',51, '1') ")
              SQL.NEW
      
              message('Transaccion Nro. '~Val(aa:13)~' generada.')
              ACN(nc:1, 0)
              SQL.EXEC
           Endif
           
           * En FR:1 sumo las fracciones
           SCN(FR:1,Val(o:&i))
           SQL.ADD(" Update "~DBO~".TRANSACCIONES2 Set ")
           SQL.ADD(" Cantidad3 = "~FStr(Trunc(Val(FR:1),2),0,2)~" ")
           SQL.ADD(" Where NrTrans = '"~Val(aa:13)~"' ")
           SQL.NEW
           
           * Siempre grabo la cuota que esta OK
           SCN(nc:1, 1) 
           message(Fstr(Val(nc:1),0,0)~' - '~Val(i:&i) )
      
           SQL.ADD(" INSERT INTO "~DBO~".CUOTAS ( ")
           SQL.ADD(" NrOperacion, NrCuota, Especie1, ")
           SQL.ADD(" Cantidad1, Cantidad2, Cantidad3, Cantidad4 ")
           SQL.ADD(" ) VALUES ( ")
           SQL.ADD(" '"~Val(aa:13)~"', "~Fstr(Val(nc:1),0,0)~", '"~Val(i:&i)~"', ")
           SQL.ADD(" "~Fstr(Val(n:&i),0,2)~", "~Fstr(Val(h:&i),0,0)~", "~Fstr(Val(j:&i),0,0)~", "~Fstr(Val(g:&i),0,2)~" ")
           SQL.ADD(" ) ")
           SQL.NEW
           SQL.EXEC
           
           SQL.ActualizarMovimientosT2(Val(aa:13),SI,NO,NO,NO)
           SQL.EXEC
           
           ACT(xx:1, Val(b:&i))
        Endif
      Proximo
#endif 
      
   EndIf

ENDIF
