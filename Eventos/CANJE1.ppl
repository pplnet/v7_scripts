       'Cta.Fraccion'   ;cf:1..cf:Val(fi:2);SI;Val(f:FLB)=0 o ClienteCuenta(Val(cl:FLB),Val(cf:FLB),Val(z:10));'Cuenta de Fraccion Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';IIF(Val(bd:FLB)=0, " '"~Val(cl:FLB)~"'=Cliente AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%')"," Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND Mercado='"~Val(c:FLB)~"' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%')");RGB(255,255,193);Iif(EqStr(Val(cl:FLB),Val(vh:1)),SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') "),SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~Val(cl:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') "));NO;NO;iif(EqStr(Val(cl:FLB),Val(VH:1)),'12');;;;SI 
       'Valuacion'      ;t:1..t:Val(fi:2);NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193);iif(Val(k:FLB)=1,Val(g:FLB)*Val(co:1))
       'Comision'       ;da:1..da:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193);iif(Val(k:FLB)=1,MontoArancelC(,Val(a:FLB),Val(z:1),Val(vh:1),Val(de:FLB),VAL(t:FLB)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:FLB)),0,,,,'CANJE',Val(d:FLB),,,SI,SI,,SI))
       'IVA'            ;db:1..db:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193);iif(Val(k:FLB)=1,Val(da:flb)*Val(dd:FLB))
