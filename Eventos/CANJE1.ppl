* Preparacion del ListBox ----------------------------------------------------------------- *

SetFilaActual(0)
ACN(aa:5,0)
ACN(ZZ:1,0)

If Not CeldaVacia(z:9)
   If SQL(" Select 1 From "~DBO~".TRANSACCIONES2 Where TipoTr2='CANJE' and Especie='"~Val(z:1)~"' and Fecha1='"~IdxDate(Val(z:6))~"' and Vehiculo1='"~Val(VH:1)~"' and Mercado1='"~Val(z:9)~"' and RB1>0 ") = 1
      MessageBox('Canje ya Ejectutado para Especie '~Val(z:1)~', Fecha '~Fecha(Val(z:6))~', Vehiculo '~Val(VH:1)~' y Mercado '~Val(z:9))
      ACN(ZZ:1,1)
   EndIf
Else
   If SQL(" Select 1 From "~DBO~".TRANSACCIONES2 Where TipoTr2='CANJE' and Especie='"~Val(z:1)~"' and Fecha1='"~IdxDate(Val(z:6))~"' and Vehiculo1='"~Val(VH:1)~"' and RB1>0 ") = 1
      MessageBox('Canje ya Ejectutado para Especie '~Val(z:1)~', Fecha '~Fecha(Val(z:6))~' y Vehiculo '~Val(VH:1))
      ACN(ZZ:1,1)
   EndIf
EndIf

If Val(ZZ:1)=0
   * No hay Canje Anterior
   SQL.ADD("Select 0 Tipo, S.Cliente, S.Cuenta, S.Mercado, S.Saldo, S.NrSaldo, C.RazonSocial, C.CondicionGan, ")
   SQL.ADD("       C.CondicionIVA, C.Res3337, C.TipoCliente, C.TIngBru, '"~Val(VH:1)~"' Alias1 ")
** FJL 21/05/21 - Cambio de criterio - Depedne de la cuenta
*   SQL.ADD(" FROM "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C ")    
   SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
   SQL.ADD(" where S.Cliente      = C.Codigo ")
   SQL.ADD("   AND C.Status       = 'HAB' ")
   SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:2))~") ")
   SQL.ADD("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
   SQL.ADD("   and S.Especie      = '"~Val(z:1)~"' ")
** FJL 21/05/21 - Cambio de criterio
*   SQL.ADD("    AND S.Cliente = '"~Val(VH:1)~"'")
** FJL 21/05/21 - Cambio de criterio
*   SQL.ADD(" AND (('CLI'=C.CategDepositante AND '"~Val(z:12)~"' = S.EnteCustodia AND 'HAB' = C.Status) OR ('"~Val(z:12)~"'=C.Codigo AND 'HAB' = C.Status)) ")
   SQL.ADD("   and S.EnteCustodia = '"~Val(z:12)~"' ")
   SQL.ADD("   and S.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(z:12)~"' ")
** FJL 21/05/21 - Esta condicion no la tiene si PAGOD0 ni STOCK0
   SQL.ADD("   AND (C.BloqueoFondos = 'NO' or C.BloqueoFondos IS NULL ) ")
   If Not CeldaVacia(z:9)
     SQL.ADD(" AND S.Mercado      = '"~Val(z:9)~"' ")
   Endif
   SQL.ADD("   and S.Fecha IN (select MAX(S1.Fecha) ")
   SQL.ADD("                    from  "~DBO~".SALDOSDIA S1 ")
   SQL.ADD("                    where (S1.Mercado = S.Mercado or (S1.Mercado IS NULL and S.Mercado IS NULL)) ")
   SQL.ADD("                      and (S1.Cuenta  = S.Cuenta  or (S1.Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
   SQL.ADD("                      and (S1.Cupon   = S.Cupon   or (S1.Cupon   IS NULL and S.Cupon   IS NULL)) ")
   SQL.ADD("                      and (S1.CallPut = S.CallPut or (S1.CallPut IS Null and S.CallPut IS Null)) ")
   SQL.ADD("                      and S1.Cliente      = S.Cliente ")
   SQL.ADD("                      and S1.Especie      = S.Especie ")
   SQL.ADD("                      and S1.NrSaldo      = S.NrSaldo ")
   SQL.ADD("                      and S1.Fecha       <= "~IdxDate2(Val(z:6))~") ")

   SQL.ADD("union all ")

   * Saldos Bloqueo
   SQL.ADD("Select 0 Tipo, S.Cliente, S.Cuenta, S.Mercado, S.Saldo, S.NrSaldo, C.RazonSocial, C.CondicionGan, ")
   SQL.ADD("       C.CondicionIVA, C.Res3337, C.TipoCliente, C.TIngBru, '"~Val(VH:1)~"' Alias1 ")
   SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
   SQL.ADD(" where S.Cliente      = C.Codigo ")
   SQL.ADD("   AND C.Status       = 'HAB' ")
   SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:3))~") ")
   SQL.ADD("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
   SQL.ADD("   and S.Especie      = '"~Val(z:1)~"' ")
   SQL.ADD("   and S.EnteCustodia = '"~Val(z:12)~"' ")
   SQL.ADD("   and S.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(z:12)~"' ")
   SQL.ADD("   AND (C.BloqueoFondos = 'NO' or C.BloqueoFondos IS NULL ) ")
   If Not CeldaVacia(z:9)
     SQL.ADD(" AND S.Mercado      = '"~Val(z:9)~"' ")
   Endif
   SQL.ADD("   and S.Fecha IN (select MAX(S1.Fecha) ")
   SQL.ADD("                    from  "~DBO~".SALDOSDIA S1 ")
   SQL.ADD("                    where (S1.Mercado = S.Mercado or (S1.Mercado IS NULL and S.Mercado IS NULL)) ")
   SQL.ADD("                      and (S1.Cuenta  = S.Cuenta  or (S1.Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
   SQL.ADD("                      and (S1.Cupon   = S.Cupon   or (S1.Cupon   IS NULL and S.Cupon   IS NULL)) ")
   SQL.ADD("                      and (S1.CallPut = S.CallPut or (S1.CallPut IS Null and S.CallPut IS Null)) ")
   SQL.ADD("                      and S1.Cliente      = S.Cliente ")
   SQL.ADD("                      and S1.Especie      = S.Especie ")
   SQL.ADD("                      and S1.NrSaldo      = S.NrSaldo ")
   SQL.ADD("                      and S1.Fecha       <= "~IdxDate2(Val(z:6))~") ")

   SQL.ADD("union all ")

   * Saldos Parking
   SQL.ADD("Select 1 Tipo, S.Cliente, S.Cuenta, S.Mercado, S.Saldo, S.NrSaldo, C.RazonSocial, C.CondicionGan, ")
   SQL.ADD("       C.CondicionIVA, C.Res3337, C.TipoCliente, C.TIngBru, '"~Val(VH:1)~"' Alias1 ")
   SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
   SQL.ADD(" where S.Cliente      = C.Codigo ")
   SQL.ADD("   AND C.Status       = 'HAB' ")
   SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:4))~") ")
   SQL.ADD("   and S.Especie      = '"~Val(z:1)~"' ")
   SQL.ADD("   and S.EnteCustodia = '"~Val(z:12)~"' ")
   SQL.ADD("   and S.Cuenta       = CU.Codigo ")
   SQL.ADD("   and CU.Comitente   = '"~Val(z:12)~"' ")
   SQL.ADD("   AND (C.BloqueoFondos = 'NO' or C.BloqueoFondos IS NULL ) ")
   If Not CeldaVacia(z:9)
     SQL.ADD(" AND S.Mercado      = '"~Val(z:9)~"' ")
   Endif
   SQL.ADD("   and S.Fecha IN (select MAX(S1.Fecha) ")
   SQL.ADD("                    from  "~DBO~".SALDOSDIA S1 ")
   SQL.ADD("                    where (S1.Mercado = S.Mercado or (S1.Mercado IS NULL and S.Mercado IS NULL)) ")
   SQL.ADD("                      and (S1.Cuenta  = S.Cuenta  or (S1.Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
   SQL.ADD("                      and (S1.Cupon   = S.Cupon   or (S1.Cupon   IS NULL and S.Cupon   IS NULL)) ")
   SQL.ADD("                      and (S1.CallPut = S.CallPut or (S1.CallPut IS Null and S.CallPut IS Null)) ")
   SQL.ADD("                      and S1.Cliente      = S.Cliente ")
   SQL.ADD("                      and S1.Especie      = S.Especie ")
   SQL.ADD("                      and S1.NrSaldo      = S.NrSaldo ")
   SQL.ADD("                      and S1.Fecha       <= "~IdxDate2(Val(z:6))~") ")
   SQL.ADD(" ORDER BY Tipo, S.Cliente, S.NrSaldo, S.Cuenta, S.Mercado ")
   
   ACT(UU:fac, '')
   Recorrer SQL
    If fbn('Saldo')>0 
      IF fbn('Tipo')=0
        SCN(fi:2, 1)
      else
        #ifdef PRUEBA
          * Tambien muestra saldos parking
          SCN(fi:2, 1)
        #endif 
      endif
      SCN(aa:5,1)
      ACT(aa:1,fbn('Cuenta'))
      ACT(aa:3,fbn('Mercado'))
   
      Recorrer&i 1,Val(z:5)
        ACN(u:fac, fbn('NrSaldo'))
        ACN(v:fac, fbn('Tipo'))
        ACN(w:fac, Val(u:fac))
        if Val(u:fac)>201
          ACN(w:fac, Val(u:fac)-100)
        endif
        ACT(x:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(w:fac)))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
        ACN(y:fac, 0)
        if Incluido(Val(u:fac),Val(sl:3))
          ACN(y:fac, 1)
        endif
        
        If &i = 1
          ACT(a:fac,fbn('Cliente'))
          ** ListBox - Cuenta
          ACT(b:fac,fbn('Cuenta'))
          ACT(c:fac,fbn('Mercado'))
          ** ListBox - Mercado
          ACT(d:fac,fbn('Mercado'))
          ** ListBox - Saldo Inicial
          ACN(e:fac,fbn('Saldo'))
          ACT(p:fac,fbn('RazonSocial'))
          ** ListBox - Cliente
          ACT(r:fac,fbn('RazonSocial'))
          ACT(TC:1, fbn('TipoCliente'))
          ACT(AA:21, fbn('Cliente'))
   
          If Not Eqstr(Val(AA:21), fbn('Cliente'))
            ACN(xp:fac-1, 1)
            ACT(AA:21, fbn('Cliente'))
            message('Cliente: '~fbn('Cliente'))
          Endif
   
          ***---Por default se asigna a la primer especie destino el total del saldo
          ** ListBox - OK
          ACN(f:fac, 1)
          ** ListBox - Cantidad a Canjear
          ACN(g:fac, fbn('Saldo'))
          ** FJL 18/11/21 - Valuacion de la accion origen para calcular comisiones
          ** ListBox - Valuacion
          ACN(t:fac, Val(e:fac)*Val(co:1))
          ** ListBox - Estado
          ACT(ax:fac, Val(x:fac))
          ACT(l:fac, BookDefault2(Val(vh:1),'TIC','',Val(z:1),'','','','','HAB'))          
        Else
          ifa
          ACT(c:fac,fbn('Mercado'))
          ** ListBox - OK
          ACN(f:fac, 1)
          ** ListBox - Cantidad a Canjear
          ACN(g:fac, fbn('Saldo'))
          ** ListBox - Estado
          ACT(ax:fac, Val(ax:fac-1))

          SCN(aa:5,1)
          IF fbn('Tipo')=0
            SCN(fi:2, 1)
          else
            #ifdef PRUEBA
              * Tambien muestra saldos parking
              SCN(fi:2, 1)
            #endif 
          endif
        Endif  
        ACN(k:fac, &i)

        ACN(se:fac, fbn('Saldo'))
        ACN(SD:fac, fbn('NrSaldo'))
        ACT(me:fac, fbn('Mercado'))

        
        If NoVacio(Val(a:fac))
          ***---Guardo el Cliente
          ACT(cc:1, Val(a:fac))
          ACT(cl:fac, Val(a:fac))
        Else
          ACT(cl:fac, Val(cc:1))
        Endif
   
        * ListBox - Relacion Origen
        ACN(h:fac,Num(ItemLista(Val(z:2),&i)))
        * ListBox - Especie Destino
        ACT(i:fac,ItemLista(Val(z:3),&i))
        * ListBox - Relacion Destino
        ACN(j:fac,Num(ItemLista(Val(z:4),&i)))
        ACT(q:fac,'')
        
** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar la cuenta. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
        IF Not Eqstr(Val(cl:fac), Val(vh:1))
          ***---Los Aranceles son solo para los 'CLI'
          ***---Uso la celda BD como marca porque cuando se canjea por mas de una especie, en la
          ***---grilla no se repiten los datos del cliente.
          ACN(BD:fac, 1)
*          ACT(CF:fac, SQL(" SELECT Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND Especies LIKE '"~Val(Z:10)~"%' "))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*          ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          if Val(y:fac)=1
            * Saldo bloqueado
** FJL 20/07/22 - Solo encontraba si Especies de la cuetna empezaba con la Moneda
*            ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
            ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          else
** FJL 20/07/22 - Solo encontraba si Especies de la cuetna empezaba con la Moneda
*            ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
            ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          endif
          ACN(BB:fac, 0)
          ACN(PI:fac, 0)
        ELSE
*          ACT(CF:fac, SQL(" SELECT Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') "))
          ACT(CF:fac, SQL(" SELECT TOP 1 Codigo From "~DBO~".CUENTAS Where Cliente = '"~Val(CL:fac)~"' AND Estado = 'HAB' AND (Especies LIKE '"~Val(Z:10)~"%' OR Especies LIKE '%MONEDA%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
          ACN(BD:fac, 0)
          ACN(PI:fac, 0)
        ENDIF
        ACN(aa:4,Val(g:fac)*Val(j:fac)/Val(h:fac))
        * ListoBox - Cant.Destino
        ACN(n:fac, Trunc(Val(aa:4)))
        ACN(o:fac, (Val(aa:4)-Val(n:fac))*Val(z:11))

        If &i = 1
          if Not EqStr(Val(a:fac),Val(vh:1)) y Val(t:fac)>0
            ACT(de:fac, 'CANJE')
            ACN(dg:fac, COTIZACIONC(Val(z:10),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
            ACN(dh:fac, iif(EqStr(Modo(Val(z:10),VAR('MONELOCA')),'INV'),1/val(dg:fac),val(dg:fac)))
       
            ACN(df:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),4,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))
            ACN(da:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1),Val(de:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(dh:fac)),0,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))

            * Cond IVA
            ACT(dc:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
            * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*            ACN(dd:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(dc:fac))/100)
            ACN(dd:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(dc:fac))/100)
          
            * IVA
            ACN(db:fac, Val(da:fac)*Val(dd:fac))
          else
            ACN(da:fac, 0)
            ACN(db:fac, 0)
          endif  
          ** FJL 25/8/22 - Se agrgan Comisiones CV
          if Val(t:fac)>0
            if EqStr(Val(a:fac),Val(z:12))
              * Cartera Propia
              ACN(ei:fac, 1)
            else
              * Terceros
              ACN(ei:fac, 0)
            endif
            ACT(ee:fac, 'CVCANJ')
            ACN(eg:fac, COTIZACIONC(Val(z:10),,,,Val(fe:1),25,SI,VAR('MONELOCA')))     
            ACN(eh:fac, iif(EqStr(Modo(Val(z:10),VAR('MONELOCA')),'INV'),1/val(eg:fac),val(eg:fac)))
       
            ACN(ef:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1),Val(ee:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(eh:fac)),4,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))
            ACN(ea:fac, MontoArancelC(,Val(a:fac),Val(z:1),Val(vh:1),Val(ee:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(eh:fac)),0,,,,'CANJE',VAL(d:fac),,,SI,SI,,SI))

            * Cond IVA
            ACT(ec:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Val(vh:1)))
            * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*            ACN(ed:fac, MontoImpuesto('IVARGCOM',Val(fe:1),3,Val(ec:fac))/100)
            ACN(ed:fac, MontoImpuesto('IVACOMECA',Val(fe:1),3,Val(ec:fac))/100)
          
            * IVA
            ACN(eb:fac, Val(ea:fac)*Val(ed:fac))
          else
            ACN(ea:fac, 0)
            ACN(eb:fac, 0)
          endif  
        else
          ACT(e:fac, '')
          ACT(t:fac, '')
          ACT(da:fac, '')
          ACT(db:fac, '')
          ACT(ea:fac, '')
          ACT(eb:fac, '')
        endif  

      Proximo   
    Else
      DFA
    Endif
   proximo
   
   ACN(xp:fac-1, 1)
   
