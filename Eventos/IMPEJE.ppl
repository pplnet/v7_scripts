HojaVisible(NO)
CrearDialogo
  Fecha1  : 'Fecha Orden' ;;;;SI;;;'Fecha Inválida';;Fsys;
  NrOrden1: 'Nr.Orden'    ;;;;  ;;Novacio(Dialogo.NrOrden1);'Orden Invalida.';NO;;;;;;"FechaOrden = "~IdxDate2(dialogo.Fecha1)~""
  Archivo : 'Archivo'     ;;;;Si;;ExisteArchivo(Dialogo.Archivo);'Elija un archivo';;VAR('PATHIMPEJE')
FinDialogo

if Not OK
  Cancelar
endif

AbrirASCII(Dialogo.Archivo)
ACT(a:1, '')
ACT(b:1, 'Número de operación')
ACT(c:1, 'Agente Contraparte')
ACT(d:1, 'Estado de la Operación')
ACT(e:1, 'Cantidad Operada')
ACT(f:1, 'Precio')
ACT(g:1, 'Hora')
ACT(h:1, 'Especie')
ACT(i:1, 'Unidad')

SetFilaActual(1)
Let &NrodeEje 0

act(ab:1,SQL("SELECT Especie FROM "~DBO~".ORDENES WHERE NrOrden='"~Dialogo.NrOrden1~"'"))
acn(ab:2,SQL("SELECT UnidadPrecio FROM "~DBO~".ESPECIESMERCADOS WHERE Codigo='"~val(ab:1)~"'"))

Repetir
  ACT(ln:1, LeerAscii)
  If Vacio(Val(ln:1))
    CerrarASCII
    break
  EndIf
  If fac > 1 
      ACN(aa:1,Posicion('"',Val(ln:1),0,1000)+1)
      ACN(aa:2,Posicion('"',Val(ln:1),Val(aa:1),1000)+1)
      ACN(aa:3,Posicion('"',Val(ln:1),Val(aa:2),1000)+1)
      ACN(aa:4,Posicion('"',Val(ln:1),Val(aa:3),1000)+1)
      ACN(aa:5,Posicion('"',Val(ln:1),Val(aa:4),1000)+1)
      ACN(aa:6,Posicion('"',Val(ln:1),Val(aa:5),1000)+1)
      
      ACT(a:fac, Copy(Val(ln:1),     01       , Val(aa:1)-2))
      ACT(b:fac, Copy(Val(ln:1),     Val(aa:1), Val(aa:2)-Val(aa:1)-1))
      ACT(c:fac, Copy(Val(ln:1),     Val(aa:2), Val(aa:3)-Val(aa:2)-1))
      ACT(d:fac, Copy(Val(ln:1),     Val(aa:3), Val(aa:4)-Val(aa:3)-1))
      ACN(e:fac, Num(Copy(Val(ln:1), Val(aa:4), Val(aa:5)-Val(aa:4)-1)))
      ACT(h:fac,val(ab:1))
      ACN(i:fac,val(ab:2))
      ACN(f:fac, Num(Copy(Val(ln:1), Val(aa:5), Val(aa:6)-Val(aa:5)-1))/val(i:fac))
      ACT(g:fac, Copy(Val(ln:1)    , Val(aa:6)+1, 6))
     
      ACN(t:1, Val(t:1)+(Val(e:fac)))
      
      Let &NrodeEje &NrodeEje+1
      
      scn(pp:1,val(e:fac)*val(f:fac))
      scn(pp:2,val(e:fac))
      
      
  EndIf
  ifa
Proximo

ACN(e:fac+1, Val(t:1))

SQL.ADD("Select ORD.NrOrden, OP.NrOperacion, OP.Precio1  ")
SQL.ADD("  From "~DBO~".ORDENES ORD,"~DBO~".OPERACIONES OP ")
SQL.ADD(" Where ORD.NrOperacion2 = OP.NrOperacion ")
SQL.ADD("   and  ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
Recorrer SQL
    act(pp:3, FBN['NrOperacion'])
    acn(pp:4, FBN['Precio1'])
    acn(pp:5, val(pp:1)/val(pp:2))
    if Round(FBN['Precio1'],6)<>Round(val(pp:5),6)
       Messagebox("Error: las ejecuciones no fueron agregadas. El precio promedio difiere. "~Chr(13)~Chr(10)~"Ejecuciones: "~FSTR(Round(val(pp:5),6),0,6)~"  Orden: "~FSTR(Round(FBN['Precio1'],6),0,6))
       Cancelar
    endif    
Proximo

SQL.ADD("Select ORD.NrOrden, OP.NrOperacion ")
SQL.ADD("  From "~DBO~".ORDENES ORD ")
SQL.ADD("    LEFT JOIN "~DBO~".OPERACIONES OP")
SQL.ADD("       on ORD.NrOperacion2 = OP.NrOperacion ")
SQL.ADD( "Where ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
SQL.ADD("  and  ORD.CB7 = 1 ")      
SQL.ADD("  and  (   ((OP.NrOperacion is null or OP.NrOperacion = '') ")
SQL.ADD("             and ORD.Cantidad1 >="~Fstr(Val(t:1),0,2)~" )") 
SQL.ADD("        Or  (Not(OP.NrOperacion is null or OP.NrOperacion = '')")
SQL.ADD("             and not Exists(SELECT 1 FROM "~DBO~".MovEjecutados ME ")
SQL.ADD("                            WHERE ME.NrOperacion = ORD.NrOperacion2  )")
SQL.ADD("             and OP.Cantidad="~Fstr(Val(t:1),0,2)~")        )")

Recorrer SQL
    SQL.ADD("SELECT NrOrden, NrOperacion, Fecha, Cantidad, Precio, Cantidad2 ")   
    SQL.ADD("FROM "~DBO~".EJECUCIONES ")   
    SQL.ADD("WHERE NrOrden='"~Dialogo.NrOrden1~"'")   
    acn(ax:1,0)
    Recorrer SQL
       SQL.ADD("DELETE "~DBO~".EJECUCIONES WHERE NrOrden='"~Dialogo.NrOrden1~"'")
       watch(SQL.BATCH())
       SQL.New
       SQL.EXEC
       Recorrer&i 1, &NrodeEje
            SCN(ax:1,1)
            Message('Insertando ejecucion '~FSTR(val(ax:1),1,0))
            SQL.ADD("INSERT INTO "~DBO~".EJECUCIONES " )
            SQL.ADD("(NrOrden, NrEjecucion, NrOperacion, Fecha, Cantidad, Precio, Cantidad2, NrSecuencia) ")
            SQL.ADD("VALUES ")
            SQL.ADD("('"~FBN['NrOrden']~"',"~FSTR(val(ax:1),1,0)~", '"~FBN['NrOperacion']~"', "~IdxDate2(FBN['Fecha'])~", ")
            SQL.ADD(FSTR(VAL(e:&i+1),0,2)~","~FSTR(VAL(f:&i+1),0,2)~", "~FSTR(VAL(e:&i+1)*VAL(f:&i+1),0,2)~", "~FSTR(VAL(b:&i+1),1,0)~")")
            watch(SQL.BATCH())
            SQL.New
            SQL.EXEC
       Proximo
       SQL.ADD("UPDATE "~DBO~".ORDENES SET Cuotas1="~FSTR(&NrodeEje,1,0)~" WHERE NrOrden='"~Dialogo.NrOrden1~"' ")
       watch(SQL.BATCH())
       SQL.New
       SQL.EXEC
       BREAK
    Proximo 
    Messagebox("Las ejecuciones fueron agregadas")
Proximo
IF Val(ax:1)=0
    ACT(AT:1,           "Select ORD.NrOrden, OP.NrOperacion  ")
    ACT(AT:1, val(AT:1)~"From "~DBO~".ORDENES ORD ")
    ACT(AT:1, val(AT:1)~"LEFT JOIN "~DBO~".OPERACIONES OP")
    ACT(AT:1, val(AT:1)~"        on ORD.NrOperacion2 = OP.NrOperacion ")
    ACT(AT:1, val(AT:1)~"Where  ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
    ACT(AT:1, val(AT:1)~"  and  ORD.CB7 = 1")      
    If Vacio(SQL(val(AT1)))
        Messagebox("Error: las ejecuciones no fueron agregadas. La orden no ingresó por  contingencia")
        Cancelar 
    Endif
    
    ACT(AT:1,           "Select ORD.NrOrden, OP.NrOperacion  ")
    ACT(AT:1, val(AT:1)~"From "~DBO~".ORDENES ORD, ")
    ACT(AT:1, val(AT:1)~DBO~".OPERACIONES OP")
    ACT(AT:1, val(AT:1)~" WHERE ORD.NrOperacion2 = OP.NrOperacion ")
    ACT(AT:1, val(AT:1)~"  and  ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
    ACT(AT:1, val(AT:1)~"  and  ORD.CB7 = 1")    
    ACT(AT:1, val(AT:1)~"  and Exists(SELECT 1 FROM "~DBO~".MovEjecutados ME ")
    ACT(AT:1, val(AT:1)~"              WHERE ME.NrOperacion = ORD.NrOperacion2  )")

    If NoVacio(SQL(val(AT1)))
        Messagebox("Error: las ejecuciones no fueron agregadas. La orden contien una operacion liquidada")
        Cancelar 
    Endif
    
    ACT(AT:1,           "Select ORD.NrOrden, OP.NrOperacion  ")
    ACT(AT:1, val(AT:1)~"From "~DBO~".ORDENES ORD, ")
    ACT(AT:1, val(AT:1)~DBO~".OPERACIONES OP")
    ACT(AT:1, val(AT:1)~" WHERE ORD.NrOperacion2 = OP.NrOperacion ")
    ACT(AT:1, val(AT:1)~"  and  ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
    ACT(AT:1, val(AT:1)~"  and  ORD.CB7 = 1")    
    ACT(AT:1, val(AT:1)~"  and Not Exists(SELECT 1 FROM "~DBO~".MovEjecutados ME ")
    ACT(AT:1, val(AT:1)~"                  WHERE ME.NrOperacion = ORD.NrOperacion2  )")
    ACT(AT:1, val(AT:1)~"  and OP.Cantidad<>"~Fstr(Val(t:1),0,2))

    If NoVacio(SQL(val(AT1)))
        Messagebox("Error: las ejecuciones no fueron agregadas. El monto difiere:"~Chr(13)~Chr(10)~"Ejecuciones: "~FSTR(Num(Val(t:1)),0,2)~"  Operacion: "~FSTR(BuscarCampo('Operaciones', 'Cantidad', 'NrOperacion', BuscarCampo('Ordenes', 'NrOperacion2', 'NrOrden', Dialogo.NrOrden1)),0,2))
        Cancelar 
    Endif

    ACT(AT:1,           "Select ORD.NrOrden, OP.NrOperacion  ")
    ACT(AT:1, val(AT:1)~"From "~DBO~".ORDENES ORD ")
    ACT(AT:1, val(AT:1)~"LEFT JOIN "~DBO~".OPERACIONES OP")
    ACT(AT:1, val(AT:1)~"        on ORD.NrOperacion2 = OP.NrOperacion ")
    ACT(AT:1, val(AT:1)~"Where  ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
    ACT(AT:1, val(AT:1)~"  and  ORD.CB7 = 1")      
    ACT(AT:1, val(AT:1)~"  and  isNull(OP.NrOperacion,'')='' ")
    ACT(AT:1, val(AT:1)~"  and ORD.Cantidad1 <"~Fstr(Val(t:1),0,2)) 
    
    If NoVacio(SQL(val(AT1)))
       Messagebox("Error: las ejecuciones no fueron agregadas. El monto difiere. "~Chr(13)~Chr(10)~"Ejecuciones: "~FSTR(Num(Val(t:1)),0,2)~"  Orden: "~FSTR(BuscarCampo('Ordenes', 'Cantidad1', 'NrOrden', Dialogo.NrOrden1),0,2))
       Cancelar
    Endif
    
EndIf
FormatoCeldas(f2..f:fac, Exe('F6'))

ACO(1, 10)
ACO(2, 15)
ACO(3, 15)
ACO(4, 15)
ACO(5, 15)
ACO(6, 10)
ACO(7, 10)

LimitesVision(j:fac+1)
