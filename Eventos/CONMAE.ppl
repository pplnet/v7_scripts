* ESTE EVENTO PREPARA TODA LA INFORMACION PARA LA CONFIRMACION DE LA OPERACION
* Y SE LA MANDA A LA ESTACION MONITORA PARA INFORMAR AL MAE (ARMA EL MENSAJE 0510)
* UNO DE LOS PARAMETROS DEL DIALOGO ES UN CHECK1 QUE INDICA SI ACEPTA O RECHAZA LA OPERACION
* POR LA CUAL RECIBIO UN PEDIDO DE CONFIRMACION, EL OTRO ELEMENTO DEL DIALOGO ES UN STRING
* QUE RECIBIRA DEL EVENTO QUE LO INVICA CON LA FECHA Y SECUENCIA A CONFIRMAR QUE SIRVE PARA
* PODER CONTESTAR EL 500
* En String paso la fecha(AAMMDD) y la Secuencia (xxxxx) (juntos y luego lo divido)
*HOJAVISIBLE(SI)
CrearDialogo
  NrOperacion1: '# Operacion :'   ;
  String      : 'fec y sec a conf';
  Check1      : 'Confirmada'      ;
  Check2      : 'Es Baja'         ;
FinDialogo
If Not OK
  Cancelar
EndIf
SQL.ADD("Select TipoOp, Cliente1, NrOperacion, Cuenta1 ")
SQL.ADD("  from "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion= '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  If Incluido(FBN['TipoOp'], 'TIC|TIFC|TIV|TIFV')

*************************** Prepara info para Bloque de Control *******************************
* Longitud             PIC(4)                                                                 *
* Mercado              PIC(1)                                                                 *
* Agente               PIC(3)                                                                 * 
* Operador             PIC(2)                                                                 *
* Fecha                PIC(6)                                                                 *
* Hora                 PIC(6)                                                                 *
* Secuencia            PIC(5)                                                                 *
* C¢d. de Registro     PIC(4)                                                                 *
***********************************************************************************************
    ACN(Y1, Ahora)
    ACT(Y2, Hora(Val(Y1)))
    ACT(Y3, Fecha(FSYS, Exe ('FORFECMAE')))
***///***
*    ACT(w2, Pad0(BuscarCampo('CUENTAS','TipoMAE','Codigo',FBN['Cuenta1']),1))

** FJL 04/01/18 Traje esto de INFMAE
            *- Tercero Vinculado
            If DesciendeDeCliente(FBN['Cliente1'], 'DIRECTORIO')
              ACT(w2,'4')
            else
               *- Agente Bolsa
               If Num(BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',FBN['Cliente1'])) > 0
                  ACT(w2,'3')
               Else
                  *- Agente mae
                  If novacio(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1'])) y Not Eqstr(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),'000')
                     ACT(w2,'5')
                  Else
                     *- Tercero
                     ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
                     If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
                        ACT(w2,'6')
                     else
                        ACT(w2,'5')
                     endif
                  endif
               endif
            Endif
************************

    if EqStr(Val(w2),'5')
      ACT(w1, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),3))
    endif
    if Vacio(Val(w1)) o EqStr(Val(w1),'000')
      * Operacion con tercero
      ACN(x1, 0)
    else
      * Operacion con Agente
      ACN(x1, 1)
    endif
    ***** Mercado
    ACT(A2, Var('MERSIOP'))
    ***** Agente                 
    ACT(A2, Val(A2)~Var('AGESIOP'))
    ***** Operador  
* FJL 10/02/21 - En BIND se usa otro operador por eso uso lavariable
*    ACT(A2, Val(A2)~'99')
    ACT(A2, Val(A2)~Var('OPESIOPEL'))
    ***** Fecha
    ACT(A2, Val(A2)~Val(Y3))
    ***** Hora
    ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),4,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),7,2))
    ***** Secuencia 
    if Dialogo.Check2=0
      ACT(A2, Val(A2)~'2')
    else
      ACT(A2, Val(A2)~'8')
    endif
    ACT(A2, Val(A2)~Copy(FBN['NrOperacion'],5,4))
    ***** Cod. de Registro
    ACT(A2, Val(A2)~'0510')
*************************** Prepara informaci¢n del bloque de Datos ***************************
* Fecha a Conf.        PIC(6)                                                                 *
* Secuencia a Conf.    PIC(5)                                                                 *
* C¢d.Op.Contestada    PIC(4)                                                                 * 
* C¢digo de Rpta.      PIC(1)                                                                 *
* Tipo de Op. Destino  PIC(1)                                                                 *
* C¢digo Rechazo       PIC(2) Cuando es OK es '00'                                            *
***********************************************************************************************
    ***** Fecha a Confirmar                           
    ACT(A2, Val(A2)~Copy(Dialogo.String,1,6))
        
    ***** Secuencia a Confirmar   
    ACT(A2, Val(A2)~Copy(Dialogo.String,7,5))
        
    ***** C¢d.Op. Contestada    
    if Val(x1)=1
      * Operacion con Agente
      ACT(A2, Val(A2)~'03')
    else
      * Operacion con terceros
      If Incluido(FBN['TipoOp'],'TIV|TIFV')
        ACT(A2, Val(A2)~'03')
      else
        ACT(A2, Val(A2)~'04')
      endif
    endif
    ACT(Z5, Copy(Dialogo.String,5,2)~'/'~Copy(Dialogo.String,3,2)~'/'~Copy(Dialogo.String,1,2))
    if Fecha(Val(z5)) < FSYS
      if Dialogo.Check2=0
        ACT(A2, Val(A2)~'03')
      else
        ACT(A2, Val(A2)~'04')
      endif
    Else
      if Dialogo.Check2=0
        ACT(A2, Val(A2)~'01')
      else
        ACT(A2, Val(A2)~'02')
      endif
    EndIf
        
    ***** C¢d. de Rpta = 1 (confirma) 2 (no confirma)
    If Dialogo.Check1=1
      ACT(A2, Val(A2)~'1')
    Else
      ACT(A2, Val(A2)~'2')
    EndIf
        
    *** Tipo Op.Destino
    ACT(A2, Val(A2)~Val(w2))
       
    ***** C¢d. de Rechazo
    if Dialogo.Check1=1
      ACT(A2, Val(A2)~'00')
    else
      ACT(A2, Val(A2)~'01')
    endif

    ***********************************************************************************************
    * Por Siopel 8 
    *----------------------------------------------------------------------------------------------
    * Porcentaje Riesgo Pago    9(5)
    * Porcentaje Riesgo Precio  9(5)
    * Plazo de Cobertura        9(1)
    * Comitente que confirma    X(18)
    ***********************************************************************************************
    *** Porcentaje Riesgo Pago
    ACT(A2, Val(A2)~'00000') 
    *** Porcentaje Riesgo Precio
    ACT(A2, Val(A2)~'00000') 
    *** Plazo Cobertura
    ACT(A2, Val(A2)~'0') 
    *** Comitente que confirma
    BorrarCeldas(xx:1..xx:1)
    ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
    If [Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))]
       Borrarceldas(yy:1..yy:1)
       ACT(yy:2,FBN['Cliente1'])
       (.'CUITMAE'.)        
** FJL 31/03/20 - Se agrga el Copy para evitar que se envien string mas larga
*       ACT(A2, Val(A2)~Pad(Val(yy:10),18))
       ACT(A2, Val(A2)~Copy(Pad(Val(yy:10),18),1,18))
    Else
       ACT(A2, Val(A2)~Pad(' ',18))
    Endif 

** FJL 25/04/23 - Para Agregar el campo TipoConfirmacion agregado en la version 8.60 se agrega un filler para cubrir los campos
**                optativos anteriores y despues el nuevo
    ACT(A2, Val(A2)~Pad(' ',280))
    *** Tipo confirmacion
    ACT(A2, Val(A2)~'I')
    
        
    ***** Longitud Total del Paquete en Caracteres
    ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4))
    ACT(A2, Val(P1)~Val(A2))
************************************* Env¡o de Datos ******************************************
* Env¡a los Datos a la Estaci¢n Monitora, pasa la operaci¢n a la Instancia Siguiente y        *
* actualiza la operaci¢n con los datos de env¡o                                               *                               
***********************************************************************************************
    Socket.Enviar(Val(A:2))
    if Not OK
      Cancelar('Error Enviando Confirmaci¢n '~'Operacion Nro : '~FBN['NrOperacion'])
    else
      if EqStr(Var('LOGEAMAE'),'SI')
        AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.TXT',0)
        EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
        CerrarASCII
      endif
      ACT(a1, SQLAhora)
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("   Set FechaEnvioMAE = "~Val(a1)~" ")
      SQL.ADD(" Where NrOperacion   = '"~FBN['NrOperacion']~"' ")
      SQL.NEW
      SQL.EXEC
      if Val(x1)=1
        * Operacion con Agente
        if Dialogo.Check2=0
          * Es Alta
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=63, Entero2=64)
        else
          * Es Baja
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=1, Entero1=77, Entero2=64)
        endif
      else
        * Operacion con terceros
        if Dialogo.Check2=0
          * Es Alta
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=63, Entero2=62)
        else
          * Es Baja
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=1, Entero1=77, Entero2=62)
        endif
      endif
    endif 
  else
    * Error en Tipo de Operacion CONMAE
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Error en TipoOp CONMAE',30))
      CerrarASCII
    endif
  endif
proximo
