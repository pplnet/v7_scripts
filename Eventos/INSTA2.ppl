* HojaVisible(SI)
CrearDialogo
    NrTrans1: '# Transaccion :'
    Precio1 :'Inst. Anterior';;;;;;;;;0
    Precio2 :'Inst. Nueva'
FinDialogo

If Not OK
    Cancelar
EndIf

***---Si no esta la instnacia, la crea
IF SQL(" Select Count(1) From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrTrans1~"' AND NrBit="~Fstr(Dialogo.Precio2,0,0)~" ") = 0
   ***---No estan las otras instancias => las inserto
   EjecutarEvento('INSBIT', Entero1 = Dialogo.Precio2, NrOperacion1=Dialogo.NrTrans1)
ENDIF


***** Pone la/las instancia/s anterior/res en 'CERO'
SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '0' ")
If Dialogo.Precio1<>0
    * solo a la instancia anterior ingresada
    SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrTrans1~"') and (NrBit = "~FStr(Dialogo.Precio1,1,0)~" ) ")
  Else
    * a todas las instancias 
    SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrTrans1~"') ")
EndIf
SQL.NEW
SQL.EXEC

***** Pone la instancia siguiente en 'UNO'
SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '1' ")
SQL.ADD(" Where (NrOperacion = '"~Dialogo.NrTrans1~"') and (NrBit = "~FStr(Dialogo.Precio2,1,0)~" ) ")
SQL.NEW
SQL.EXEC