CrearDialogo
  Check1: 'Datanet'       ;;;;;;;;;1
  Check2: 'Conciliaciones';;;;;;;;;1
  Check3: 'Extractos'     ;;;;;;;;;1
FinDialogo

IF NOT OK
  Cancelar
ENDIF

If Dialogo.Check1=1
  SQL.ADD(" TRUNCATE TABLE "~DBO~".MOVDATANET ")
  SQL.NEW

  SQL.ADD(" TRUNCATE TABLE "~DBO~".DATANET ")
  SQL.NEW
Endif
If Dialogo.Check2=1
  SQL.ADD(" TRUNCATE TABLE "~DBO~".CONCILIACIONES ")
  SQL.NEW
Endif
If Dialogo.Check3=1
  SQL.ADD(" TRUNCATE TABLE "~DBO~".EXTRACTOS ")
  SQL.NEW
Endif


SQL.EXEC