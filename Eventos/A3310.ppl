MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1 : "Vehiculo"                                ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1    : "Fecha"                                   ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FinDeMes(Fsys,NO,'ARG')
  Radio3    : 'Cartera|BCRA|RML|Otros valores|Terceros' ; ; ;;;;;;;
  Radio2    : "Salida|Informe|Inf+TXT"                  ; ; ;;;;;;;
  String1   : 'Path'                                    ; ; ;;;;;;;
  String2   : 'Archivo'                                 ; ; ;;;;;;;
  Radio1    : 'Sist.Oper.|W98|NT'                       ; ; ;;;;;;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

 *- Se ejecutan las carteras BCRA, RML y Otros Valores
HojaVisible(SI)
If Dialogo.Radio2=1 y Not ExisteDirectorio(Dialogo.String1)
   Messagebox('No existe el path '~Dialogo.String1~'. Debera crearlo.')
   Cancelar
Endif

IF Dialogo.Radio2=1 y ExisteArchivo(Dialogo.String1~Dialogo.String2) 
   IF Dialogo.Radio1 = 0
     * WinExec('COMMAND.COM /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ELSE
     * WinExec('CMD.EXE /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ENDIF

   ***---A veces ejecuta lo que sigue y el S.O. todavia no borro el archivo
   Message('Borrando el archivo '~Dialogo.String2)
   Esperar(3)
EndIf

IF Dialogo.Radio2=1 
   ACT(aa1, Dialogo.String1~Dialogo.String2)
   Message('Creando Archivo '~Dialogo.String2)
   AbrirASCII(val(aa1),0)
EndIf
 
CrearFont(2,"Arial,8,")
CrearFont(1,"Arial,8,I")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT E.Codigo as Especie, E.Extendido, E.ISIN as CodigoISIN, E.Tipo, ")
SQL.ADD("       E.CodMAEContado as CodigoMAE, E.CodNumCajaValores as CodigoCValores, ")
SQL.ADD("       E.LocalRating1 as TipoValor, E.PaisOrigen, SUM(PS1.CantidadFin) Cantidad, ")
SQL.ADD("       E.MonedaEmision AS Cotiza, FechaCambioTasa, TasaIntAnterior, TasaIntVigente, InteresesC, ")
SQL.ADD("       CASE PS1.NrSaldo WHEN 107 THEN '0'  ELSE '1'END idTipo, PS1.NrSaldo as TCartera ")
SQL.ADD("FROM "~DBO~".POSICIONES PS1 WITH (NOLOCK),"~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("WHERE E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND ")
SQL.ADD("      E.Codigo = PS1.Especie                     AND ")
SQL.ADD("      PS1.Vehiculo = '"~Dialogo.Vehiculo1~"'     AND ")
SQL.ADD("      PS1.Cliente  = PS1.Vehiculo                AND ")
SQL.ADD("      PS1.NrSaldo in ('107','108','109')         AND ")
SQL.ADD("      PS1.CantidadFin <> 0                       AND ")
SQL.ADD("      PS1.Fecha = (SELECT MAX(PS2.Fecha) ")
SQL.ADD("                   FROM "~DBO~".POSICIONES PS2 WITH (NOLOCK) ")
SQL.ADD("                   WHERE PS2.Cliente = PS1.Cliente                   AND ")
SQL.ADD("                         PS2.Especie = PS1.Especie                   AND ")
SQL.ADD("                         PS2.Vehiculo = PS1.Vehiculo                 AND ")
SQL.ADD("                         PS2.Sector = PS1.Sector                     AND ")
SQL.ADD("                         PS2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'  AND ")
SQL.ADD("                         PS2.NrSaldo = PS1.NrSaldo) ")
SQL.ADD("GROUP BY E.Codigo, E.Extendido, E.ISIN, E.CodMAEContado, E.CodNumCajaValores, E.LocalRating1, E.Tipo,")
SQL.ADD("         E.PaisOrigen, E.MonedaEmision, PS1.NrSaldo, FechaCambioTasa, TasaIntAnterior, TasaIntVigente, InteresesC")
*- Pases con BCRA Vigentes que no entran en saldo
SQL.ADD("Union ALL")
SQL.ADD("SELECT E.Codigo as Especie, E.Extendido, E.ISIN as CodigoISIN, E.Tipo,")
SQL.ADD("       E.CodMAEContado as CodigoMAE, E.CodNumCajaValores as CodigoCValores, ")
SQL.ADD("       E.LocalRating1 as TipoValor, E.PaisOrigen, SUM(O.Cantidad) Cantidad, ")
SQL.ADD("       E.MonedaEmision as Cotiza, FechaCambioTasa, TasaIntAnterior, TasaIntVigente, InteresesC, '2' as idTipo, '999' as TCartera ")
SQL.ADD("FROM "~DBO~".OPERACIONES O WITH (NOLOCK) ,"~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("WHERE E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND ")
SQL.ADD("      E.Codigo = O.Especie                       AND ")
SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'      AND ")
SQL.ADD("      O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"'   AND ")
SQL.ADD("      O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"'   AND ")
SQL.ADD("      O.TipoOp='TIBCRA' ")
SQL.ADD("GROUP BY E.Codigo, E.Extendido, E.ISIN, E.CodMAEContado, E.CodNumCajaValores, E.LocalRating1, E.Tipo,")
SQL.ADD("         E.PaisOrigen, E.MonedaEmision, FechaCambioTasa, TasaIntAnterior, TasaIntVigente, InteresesC")
SQL.ADD("ORDER BY 3,1,10")

*- AZ2: Codigo de BCRA de sudameris
ACN(az22,BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1)) 

ACT(a1, 'Circular "A" 3310 a la fecha '~Dialogo.Fecha1~' Entidad Informante : '~Fstr(val(az22),0,0))
ACT(h1, 'Fecha: '~Var('FECHASYS'))
SetFont(a1..h1,3)

ACT(a3, 'Cartera Propia: '~IIF(Dialogo.Radio3=0,'BCRA',IIF(Dialogo.Radio3=1,'RML',IIF(Dialogo.Radio3=2,'Otros Valores','Terceros')))) 
SetFont(a3..e3,3) 

ACT(a5, 'Tipo Cartera: I- Cartera de Investment  T- Cartera de Trading   P- Pases con el BCRA')
SetFont(a5..e5,1)

ACT(a:8, 'Fecha ')
ACT(b:8, 'Codigo ')
ACT(b:9, ' ISIN ')
ACT(c:8, 'Codigo ')
ACT(c:9, ' MAE ')
ACT(d:8, 'Caja de ')
ACT(d:9, 'Valores ')
ACT(e:8, 'Denominacion')
ACT(f:8, ' Tipo ')
ACT(f:9, ' Valor ')
ACT(g:8, ' Pais ')
ACT(g:9, ' emisor ')
ACT(h:8, 'Moneda')
ACT(i:8, ' Tipo')
ACT(i:9, 'Cartera')
ACT(j:8, 'Valor Nominal ')
ACT(j:9, ' Tenencia (en miles)   ')
ACT(k:8, '  Valor de Mercado ')
ACT(k:9, 'Tenencia (en miles de pesos)')
ACT(l:8, 'Precio')
ACT(m:8, '  Valor Nominal ')
ACT(m:9, ' Posicion (en miles)')
ACT(n:8, '  Valor de Mercado ')
ACT(n:9, 'Posicion (en miles de pesos)')
SetFont(a:8..n:9,3)
AlinearCeldas(a:8..n:9,'C')

ACT(ml1,VAR('MONELOCA'))
ACT(me1,VAR('MONEEXTR')) 

ACN(fi1, 10)
SetFilaActual(Val(fi1)-1) 

Message('Recuperando Datos ')

Recorrer SQL

 If FBN['idTipo']=Dialogo.Radio3

   *- a: Fecha
   ACT(a:fac, Dialogo.Fecha1)

   *- b: Codigo ISIN
   *- c: Codigo Mae
   *- d: Codigo Caja Valores
   *-Si no Tiene Codigo ISIN se pone el Codigo Mae y el Codigo de Caja de Valores
   If Vacio(FBN['CodigoISIN'])  
      ACT(c:fac,Copy(FBN['CodigoMAE'],1,5))
      ACT(d:fac,Copy(FBN['CodigoCValores'],2,4))
   Else
      ACT(b:fac,FBN['CodigoISIN'])
   Endif
    
   *- e: Denominacion   
   ACT(e:fac, Copy(FBN['Extendido'],1,60))

   *- f: Codigo del Tipo Valor
   ACT(f:fac, Copy(FBN['TipoValor'],1,2))
    
   *- g: Codigo del Pais Emisor
   ACT(g:fac, Copy(FBN['PaisOrigen'],1,3))
    
   *- h: Moneda en que se cotiza
      ACT(h:fac,FBN['Cotiza'])
*   If EqStr(FBN['Cotiza'],val(ml1))
*      ACT(h:fac,val(ml1))
*   Else
*      ACT(h:fac,val(me1))
*   Endif  
    
   *- l: Precio
   ACN(l:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,val(ml1))) 
   
   *- i: Tipo Cartera
   IF EqStr(FBN['idTipo'], '2')
      ACT(i:fac, 'P')  
   Else
      ACT(i:fac,IIF(EqStr(FStr(FBN['TCartera'],0,0), '107'),'T','I'))
   Endif

   *- j: Valor Nominal  
   ACN(j:fac, FBN['Cantidad'])

   * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, FBN['Cantidad'])
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)
   ACN(ca:fac, Val(zz:fac))
   ACN(cc:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))

   *- Alias4
   ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))  
 
   *- K: Valuacion--> Valor Mercado
   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(k:fac, Val(j:fac)*Val(cc:fac)*Val(l:fac)+(Val(ca:fac)*Val(cc:fac)))
      ELSE
         ACN(k:fac, Val(j:fac)*Val(cc:fac)*Val(l:fac)+Val(ca:fac))
      ENDIF
   ELSE
      ACN(k:fac, Val(j:fac)*Val(l:fac)+Val(ca:fac))
   ENDIF

*   ACN(j:fac, Round2(Val(j:fac)/1000,2))
*   ACN(k:fac, Round2(Val(k:fac)/1000,2))
   ACT(j:fac, FStr(Round2(Val(j:fac)/1000,2),0,0))
   ACT(k:fac, FStr(Round2(Val(k:fac)/1000,2),0,0))

*   ACN(m:fac, 0)
*   ACN(n:fac, 0)
   ACT(m:fac, '0')
   ACT(n:fac, '0')

   *-Si es distinto de RML Valor Nominal Posicion y Valor Mercado Posicion 
   *-son iguales a Valor Nominal Tenencia y Valor Mercado Tenencia   
   If Dialogo.Radio3<>1 
*      ACN(m:fac, Val(j:fac))
*      ACN(n:fac, Val(k:fac))
      ACT(m:fac, Val(j:fac))
      ACT(n:fac, Val(k:fac))
   Endif
   
   SetFont(a:fac..n:fac,1)   
   AlinearCeldas(j:fac..K:fac,'D') 
   AlinearCeldas(m:fac..n:fac,'D') 

 Else
   SetFilaActual(fac-1)         
 Endif    

Proximo

   If Dialogo.Radio2=1
        *- Genero el TXT en columna aa
        Recorrer&j val(fi1),fac
            If NoVacio(val(b:&j)) o NoVacio(val(c:&j)) o NoVacio(val(d:&j))
               ACT(aa:&j,val(a:&j))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(b:&j),12))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(c:&j),5))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(d:&j),4))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(e:&j),60))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(f:&j),2))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(g:&j),2))
               ACT(aa:&j,val(aa:&j)~','~Pad(val(h:&j),3))
               ACT(aa:&j,val(aa:&j)~','~val(i:&j))

               If LtStr(Val(j:&j),'0')
                  ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(j:&j),2,longitud(val(j:&j))),6))
               Else
                  ACT(aa:&j,val(aa:&j)~','~Pad0(val(j:&j),7))
               Endif

               If LtStr(Val(k:&j),'0')
                  ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(k:&j),2,longitud(val(k:&j))),9))
               Else
                  ACT(aa:&j,val(aa:&j)~','~Pad0(val(k:&j),10))
               Endif

               ACT(aa:&j,val(aa:&j)~','~Pad0(FStr(val(l:&j),0,8),12))
               
               *-Si es distinto de RML Valor Nominal Posicion y Valor Mercado Posicion
               *-van los valores de Valor Nominal Tenencia y Valor Mercado Tenencia
               If Dialogo.Radio3<>1 
                  If LtStr(Val(m:&j),'0')
                     ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(m:&j),2,longitud(val(m:&j))),6))
                  Else
                     ACT(aa:&j,val(aa:&j)~','~Pad0(val(m:&j),7))
                  Endif

                  If LtStr(Val(n:&j),'0')
                     ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(n:&j),2,longitud(val(n:&j))),9))
                  Else
                     ACT(aa:&j,val(aa:&j)~','~Pad0(val(n:&j),10))
                  Endif

               Endif 
                
               EscribirASCII(val(aa:&j))
            EndIf
        Proximo
*        Messagebox('Finalizo el Proceso')
   EndIf

SetfilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac,3)

FormatoCeldas(l:1..l:fac,Exe('F9'))  

ACO(1,7)
ACO(2,9)
ACO(3,5)
ACO(4,5)
ACO(5,35)
ACO(6,4)
ACO(7,5)
ACO(8,6)
ACO(9,6)
ACO(10,15)
ACO(11,18)
ACO(12,8)
ACO(13,15)
ACO(14,18)

FijarFila(Val(fi1))
