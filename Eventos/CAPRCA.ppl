CrearDialogo
    NrOperacion1: 'NrOperacion' ;;;;;;Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NrOperacion1),'MMCPM') Y Eqstr(BuscarCampo('OPERACIONES','CB7','NrOperacion',NrOperacion1),'1') Y Eqstr(BuscarCampo('OPERACIONES','RB10','NrOperacion',NrOperacion1),'0');'Debe ingresar una operacion MMCPM precancelable que haya sido precancelada';NO;;;;;;"TipoOp = 'MMCPM' AND CB7 = 1"
FinDialogo

IF Not Ok
    Cancelar
Endif

SQL.ADD(" SELECT 1 FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" WHERE FechaMov = '"~IdxDate(BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1))~"' AND NrSaldo = 1 ")
Recorrer SQL
    Cancelar('La operacion que seleccionó tiene una liquidación ya hecha. Anule la liquidación e intente de nuevo')
Proximo

*Campos a Levantar con el SQL. Usando la operacion del dialogo.

*FechaOp, Plazo , FechaVto, Cantidad, Precio1 as 'Tasa', Cantidad3 (de CUOTAS con Numero de Operacion del dialogo) as 'Interes', Precio3 as 'Tasa Penalidad', TotalAux1 as 'Penalidad'
*Plazo3 as 'Plazo Ori', FechaVto2 as 'Vto Ori', Precio4 as 'Penalidad Ori', Cantidad10 (De Cuotas) as 'Interes Ori
SQL.ADD(" SELECT O.FechaOp, O.Plazo, O.FechaVto, O.Cantidad, O.Precio1 'Tasa', O.Precio3 'Tasa Penalidad', ")
SQL.ADD(" O.TotalAux1 'Penalidad', O.Plazo3 'Plazo Ori', O.FechaVto2 'Vto Ori', O.Precio4 'Penalidad Ori',C.Cantidad3 'Interes', C.Cantidad10 'Interes Ori'")
SQL.ADD(" FROM "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS C ")
SQL.ADD(" ON O.NrOperacion = C.NrOperacion ")
SQL.ADD(" WHERE O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    ACD(A:1,fbn('FechaOp'))
    ACN(B:1,fbn('Plazo'))
    ACD(C:1,fbn('FechaVto'))
    ACN(D:1,fbn('Cantidad'))
    ACN(E:1,fbn('Tasa'))
    ACN(F:1,fbn('Interes'))
    ACN(G:1,fbn('Tasa Penalidad'))
    ACN(H:1,fbn('Penalidad'))
    ACN(I:1,fbn('Plazo Ori'))
    ACD(J:1,fbn('Vto Ori'))
    ACN(K:1,fbn('Interes Ori'))
    ACN(L:1,fbn('Penalidad Ori'))
Proximo

CrearListBox ; 'Arial,8,' ; 'Anulacion de Precancelacion '~Dialogo.NrOperacion1
    'Fecha Op'        ;A1;NO;SI;;80;FECHA
    'Plazo'           ;B1;NO;SI;;60;NUMERO;'##'
    'Fecha Vto'       ;C1;NO;SI;;80;FECHA
    'Cantidad'        ;D1;NO;SI;;100;NUMERO;'###,###,###.##'
    'Tasa '           ;E1;NO;SI;;100;NUMERO;'##.########'
    'Interes '        ;F1;NO;SI;;100;NUMERO;'##,###,###.##'
    'Tasa Penalidad'  ;G1;NO;SI;;100;NUMERO;'##.########'
    'Penalidad'       ;H1;NO;SI;;100;NUMERO;'##,###,###.##'
    'Plazo Ori'       ;I1;NO;SI;;60;NUMERO;'##';Exe('COLOR6')
    'Vto Ori'         ;J1;NO;SI;;80;FECHA;Exe('COLOR6')
    'Interes Ori'     ;K1;NO;SI;;100;NUMERO;'##,###,###.##';Exe('COLOR6')
    'Penalidad Ori'   ;L1;NO;SI;;100;NUMERO;'##,###,###.##';Exe('COLOR6')
FinListBox

If Not Ok
    Cancelar
Endif

SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
SQL.ADD(" Set FechaVto = FechaVto2, ")
SQL.ADD(" Plazo = Plazo3, ")
SQL.ADD(" CB7 = '0', ")
SQL.ADD(" TotalAux1 = 0, ")
SQL.ADD(" Precio3 = Precio4, ")
SQL.ADD(" FechaPrecan = null ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD(" UPDATE "~DBO~".CUOTAS ")
SQL.ADD(" Set Cantidad3 = Cantidad10, ")
SQL.ADD(" Cantidad4 = Cantidad11, ")
SQL.ADD(" Cantidad5 = Cantidad7, ")
SQL.ADD(" Total5 = Total6, ")
SQL.ADD(" Cantidad6 = Cantidad8, ")
SQL.ADD(" Total3 = Total4, ")
SQL.ADD(" Total2 = Total7, ")
SQL.ADD(" Total1 = Total8, ")
SQL.ADD(" Fecha2 = '"~IdxDate(BuscarCampo('OPERACIONES','FechaVto2','NrOperacion',Dialogo.NrOperacion1))~"' ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrCuota = 1 ")
SQL.NEW
SQL.EXEC

SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,SI,NO,NO,NO,SI)
SQL.NEW
SQL.EXEC

EjecutarEvento('INSBIT', String1 = 'OPERACIONES', Entero1 = 11, NrOperacion1 = Dialogo.NrOperacion1)

MessageBox('Evento de Anulación de Precancelacion de Plazo Fijo terminó correctamente')