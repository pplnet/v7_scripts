FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif


Message('--- Asientos de Egreso de Titulos ---')

ACT(ME:1, Var('MONEEXTR'))
ACT(ML:1, Var('MONELOCA'))
ACN(NA:1, Var('ASINUM'))
ACN(SL:2, Var('SALDOPOCON'))
ACT(VC:1, Dialogo.Vehiculo1)
ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))
ACT(CM:1, Var('CLIENTEMAE'))
ACD(FV:1, Dialogo.Fecha1)

let &tipoAsiento Var('TIPASIEGTI')
let &saldoDelDia 0
let &saldoDeOperaciones 0
let &cantidadPosCombinaciones 0 

*Busco books de partidas que son de INV
let &bookPartidas ''
(.'BOOKPARTID'.)
Recorrer SQL
    let &bookPartidas &bookPartidas~fbn('Books')
Proximo

SQL.ADD("Select E.MonedaEmision, P.Vehiculo Vehiculo1, 'TIC' TipoOp, E.Tipo TipoEspecie, P.Book Book1, ")
SQL.ADD("P.Estrategia CuentaCustodia, '' Concepto, P.Especie, Sum(P.CantidadFin) Cantidad ")
SQL.ADD("from "~DBO~".POSICIONES P ")
SQL.ADD("   JOIN "~DBO~".ESPECIES E ON P.Especie = E.Codigo ")
SQL.ADD("   JOIN "~DBO~".CUENTAS C ON P.Estrategia = C.Codigo ")
**Book trading
SQL.ADD("where P.Book Not IN ("~Pipe2Comillas(&bookPartidas)~") ")
**Cuenta no de garantia
SQL.ADD("AND (C.CB2 Is Null OR C.CB2 = '' OR C.CB2 =' ' OR C.CB2='NO') ")
**Saldo 122
SQL.ADD("AND P.NrSaldo = "~Fstr(Val(SL:2), 0, 0)~" ")
SQL.ADD("AND P.Fecha IN (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD("      Where P1.Especie = P.Especie ")
SQL.ADD("      AND P1.Vehiculo = P.Vehiculo ")
SQL.ADD("      AND P1.Cliente = P.Cliente ")
SQL.ADD("      AND P1.NrSaldo = P.NrSaldo ")
SQL.ADD("      AND P1.Book = P.Book ")
SQL.ADD("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
SQL.ADD("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
SQL.ADD("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
SQL.ADD("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
SQL.ADD("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
SQL.ADD("      AND (P1.Estrategia = P.Estrategia OR ((P1.Estrategia Is Null OR P1.Estrategia = '' OR P1.Estrategia = ' ') AND (P.Estrategia Is Null OR P.Estrategia = '' OR P.Estrategia = ' ' ))) ")
SQL.ADD("      AND P1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
*SQL.ADD("Order by E.Codigo, P.Book, P.Estrategia ")
SQL.ADD("Group by P.Especie, P.Book, E.MonedaEmision, P.Vehiculo, E.Tipo, P.Book, P.Estrategia ")
SQL.ADD("Order by P.Especie, P.Book ")

watch(SQL.batch)

Recorrer SQL
    let &tipoOp fbn('TipoOp')
    let &posicion fbn('Cantidad')
    let &vehiculo fbn('Vehiculo1')

    If Vacio(&especieAnterior) AND Vacio(&bookAnterior)
        let &especieAnterior fbn('especie')
        let &cuentaCustodiaAnterior fbn('CuentaCustodia') 
        let &bookAnterior fbn('Book1') 
        let &monedaEmisionAnterior fbn('MonedaEmision')
        let &tipoEspecieAnterior fbn('tipoEspecie')
        let &sumaPosiciones 0  
    Else
        let &especieAnterior &especieActual
        let &cuentaCustodiaAnterior &cuentaCustodiaActual 
        let &bookAnterior &bookActual        
        let &monedaEmisionAnterior &monedaEmisionActual
        let &tipoEspecieAnterior &tipoEspecieActual
    EndIf

    let &especieActual fbn('especie')
    let &cuentaCustodiaActual fbn('CuentaCustodia')
    let &bookActual fbn('Book1') 
    let &monedaEmisionActual fbn('MonedaEmision') 
    let &tipoEspecieActual fbn('tipoEspecie')     
    **Eliana 3-9-25 - el corto de control solo va a ser por Especie
    **If EqStr(&especieAnterior,&especieActual) AND EqStr(&bookActual,&bookAnterior)

    If EqStr(&especieAnterior,&especieActual) 
        **Si entro por aca uso las variables Actual
        let &posicion fbn('Cantidad')
        
        ***La posicion valuda como en POSICO (cotizacionNiif, si es 0 uso Cotizacion) si es posicion < 0 
        ***La posicion por precio fin si es posicion > 0
        *If &posicion > 0
        *    let &precioFin fbn('PrecioFin')
        *    let &precio &precioFin
        *Else
        *    let &ppp 0
        *    let &sumaCantidadPPP 0
        *    **Calculo del ppp por si es negativo la posicion
        *    SQL.ADD("Select Cantidad, Precio1 Precio, FechaOp Fecha from "~DBO~".OPERACIONES ")
        *    SQL.ADD("where TipoOp='TIV' ")
        *    SQL.ADD("and Especie ='"~&especieActual~"' ")
        *    SQL.ADD("and Book1 = '"~&bookActual~"' ")
        *    SQL.ADD("and Cuenta2 = '"~&cuentaCustodiaActual~"' ")
        *    SQL.ADD("and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        *    SQL.ADD("UNION ALL ")
        *    SQL.ADD("Select Cantidad1, Precio1 Precio, Fecha1 Fecha from "~DBO~".TRANSACCIONES2 ")
        *    SQL.ADD("where TipoTr2='RTP' ")
        *    SQL.ADD("and Especie ='"~&especieActual~"' ")
        *    SQL.ADD("and Book1 = '"~&bookActual~"' ")
        *    SQL.ADD("and Cuenta1 = '"~&cuentaCustodiaActual~"' ")
        *    SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"'")            
        *    SQL.ADD("ORDER BY Fecha DESC")
        *    Recorrer SQL
        *        if fbn('Cantidad') > (&posicion - &sumaCantidadPPP)
        *            let &sumaCantidadPPP &sumaCantidadPPP+(&posicion - &sumaCantidadPPP)*fbn('Precio')
        *        Else
        *            let &sumaCantidadPPP &sumaCantidadPPP+fbn('Cantidad')*fbn('Precio')
        *        EndIf
        *        let &ppp &sumaCantidadPPP/&posicion
        *    Proximo
        *    let &precio &ppp

            Let &PrecioNIIF CotizacionNIIF(&especieActual, Dialogo.Fecha1, &bookActual)
            IF Vacio(&PrecioNIIF)
                let &precioNiif 0
            ELSE
                let &precioNiif &PrecioNIIF.PrecioCotizacionDeterminada
            ENDIF
            if &precioNiif=0
              let &precioNiif COTIZACION(&especieActual,,,,Dialogo.Fecha1,1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',&especieActual),,,,Dialogo.Fecha1,25,SI,'ARP')
            endif
            let &precio &precioNiif            
        *EndIf
        let &posicionValuada &posicion * &precio

        **Guardo la suma de posiciones * precio
        let &sumaPosiciones &sumaPosiciones + &posicionValuada
        **Las posiciones vienen en MonedaLocal, por lo cual tengo que ver la moneda de las operaciones para pasar solo ese valor a monedalocal
        *IF(Eqstr(fbn('Cotiza'),VAR('MONELOCA')), Round(#POSICIONEGRETIT,2), Round(#POSICIONEGRETIT * #TCCONTABLE,2))
        *EndIf
        
        **Guardo las posiciones 
        let &nominales &nominales + &posicion
    Else
        **Cambia los valores del corte de control Especie/Book
        **Si entro por acá uso las variables Anterior
        **Busco siempre las operaciones para restarlas a las posiciones
        let &sumaCantOpValuada 0
        **Busco Operaciones TIPO y TIPP vigentes valuadas al dia de hoy para el tipo de especie, cuenta custodia y book
        SQL.ADD("SELECT O.Cantidad, O.Precio4 Precio, E.Cotiza from "~DBO~".OPERACIONES O")
        SQL.ADD("JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
        SQL.ADD("JOIN "~DBO~".CUENTAS C ON C.Codigo = O.Cuenta1 ")
        SQL.ADD("WHERE O.TipoOp in ('TIPO','TIPP') ")
        SQL.ADD("AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'" )
        SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
        *SQL.ADD("AND O.Book1 = '"~&bookAnterior~"' ")
        SQL.ADD("AND E.Codigo = '"~&especieAnterior~"' ")
        **Cuenta no de garantia
        SQL.ADD("AND (C.CB2 Is Null OR C.CB2 = '' OR C.CB2 =' ' OR C.CB2='NO') ")
        Recorrer SQL
            let &cantidadOperacion fbn('Cantidad')
            
            Let &PrecioNIIF CotizacionNIIF(&especieAnterior, Dialogo.Fecha1, &bookAnterior)
            IF Vacio(&PrecioNIIF)
                let &precioNiif 0
            ELSE
                let &precioNiif &PrecioNIIF.PrecioCotizacionDeterminada
            ENDIF     
            Let &Precio &precioNiif
            *Let &Precio fbn('Precio')
            
            let &cantidadOpValuada &cantidadOperacion * &Precio
            If Not EqStr(fbn('Cotiza'),VAR('MONELOCA'))
                ACT(MN:99,fbn('Cotiza'))
                let &cantidadOpValuada &cantidadOpValuada * #TCCONTABLE
            EndIf
            let &sumaCantOpValuada &sumaCantOpValuada + &cantidadOpValuada
            **Guardo posiciones sin valuar + cantidad operaciones sin valuar
            let &nominales &nominales + &cantidadOperacion
        
            Proximo
        **Guardo sumaposiciones valuada - suma cantidad de operaciones valuada
        let &sumaPosiciones &sumaPosiciones - &sumaCantOpValuada

        **Vuelvo a controlar si es negativo por si pasò por el if anterior ya que las op compensan la cantidad de la posicion
        If &sumaPosiciones < 0
            *let &especie &especieAnterior
            let &Issuer BuscarCampo('ESPECIES','issuer','Codigo', &especieAnterior)
            let &Cotiza BuscarCampo('ESPECIES','Cotiza','Codigo', &especieAnterior)
            SQL.ADD(" SELECT '"~&especieAnterior~"' Especie, '"~&monedaEmisionAnterior~"' MonedaEmision, ")
            SQL.ADD(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookAnterior~"' Book1, '"~&tipoEspecieAnterior~"' TipoEspecie, ")
            SQL.ADD(" Codigo CodAsi, '"~&cuentaCustodiaAnterior~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
            SQL.ADD(" '"~&Issuer~"' Issuer, "~FStr(&nominales,0,0)~" Cantidad, '"~&Cotiza~"' Cotiza  ")
            SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
            SQL.ADD(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoAsiento)~") ")
            SQL.ADD(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
            SQL.ADD(" AND Habilitado = 'SI' ")
            Recorrer SQL
                let &codAsi fbn('CodAsi')
                ACT(BK:1, &bookAnterior)
                *ACT(MN:99, fbn('MonedaEmision'))
                
                ACN(CK:1, 0)
                IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
                    ACN(CK:1, 1)
                    IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~&codAsi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~&vehiculo~"' "))
                        ACN(CK:1, 0)
                    ENDIF
                ENDIF
                IF Val(CK:1) = 0
                    Message('Modelo: '~&codAsi)
                    SQL.GenerarAsientoOp(&codAsi, '','','',Val(NA:1),Val(FV:1),&vehiculo,,,,,,&tipoOp,,,,,,,fsys,Dialogo.Fecha1)
                    SQL.EXEC
                    let &cantidadPosCombinaciones &cantidadPosCombinaciones+1
                    ACT(ZA:&cantidadPosCombinaciones,&especieAnterior)
                    *ACT(ZB:&cantidadPosCombinaciones,&bookAnterior)
                ENDIF
            Proximo
        EndIf
        **Reseteo los valores y sumo la posicion del registro que estoy procesando
        **A partir de aca uso las variable Actual
        let &sumaPosiciones 0
        
        let &posicion fbn('Cantidad')
        **La posicion por Precio como en POSICO si es posicion < 0 
        **La posicion por precio fin si es posicion > 0
        *If &posicion > 0
        *    let &precioFin fbn('PrecioFin')
        *    let &precio &precioFin
        *Else
            **La posicion valuda como en POSICO (cotizacionNiif, si es 0 uso Cotizacion)
            Let &PrecioNIIF CotizacionNIIF(&especieActual, Dialogo.Fecha1, &bookActual)
            IF Vacio(&PrecioNIIF)
                let &precioNiif 0
            ELSE
                let &precioNiif &PrecioNIIF.PrecioCotizacionDeterminada
            ENDIF
            if &precioNiif=0
              let &precioNiif COTIZACION(&especieActual,,,,Dialogo.Fecha1,1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',&especieActual),,,,Dialogo.Fecha1,25,SI,'ARP')
            endif
            let &precio &precioNiif  
            
            *let &ppp 0
            *let &sumaCantidadPPP 0
            ***Calculo del ppp por si es negativo la posicion
            *SQL.ADD("Select Cantidad, Precio1 Precio, FechaOp Fecha from "~DBO~".OPERACIONES ")
            *SQL.ADD("where TipoOp='TIV' ")
            *SQL.ADD("and Especie ='"~&especieActual~"' ")
            *SQL.ADD("and Book1 = '"~&bookActual~"' ")
            *SQL.ADD("and Cuenta2 = '"~&cuentaCustodiaActual~"' ")
            *SQL.ADD("and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'")
            *SQL.ADD("UNION ALL ")
            *SQL.ADD("Select Cantidad1, Precio1 Precio, Fecha1 Fecha from "~DBO~".TRANSACCIONES2 ")
            *SQL.ADD("where TipoTr2='RTP' ")
            *SQL.ADD("and Especie ='"~&especieActual~"' ")
            *SQL.ADD("and Book1 = '"~&bookActual~"' ")
            *SQL.ADD("and Cuenta1 = '"~&cuentaCustodiaActual~"' ")
            *SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"'")            
            *SQL.ADD("ORDER BY FechaOp DESC")
            *Recorrer SQL
            *    if fbn('Cantidad') > (&posicion - &sumaCantidadPPP)
            *        let &sumaCantidadPPP &sumaCantidadPPP+(&posicion - &sumaCantidadPPP)*fbn('Precio')
            *    Else
            *        let &sumaCantidadPPP &sumaCantidadPPP+fbn('Cantidad')*fbn('Precio')
            *    EndIf
            *    let &ppp &sumaCantidadPPP/&posicion
            *Proximo
            *let &precio &ppp
        *EndIf
        let &posicionValuada &posicion * &precio
        
        **Guardo la suma de posiciones * precio
        let &sumaPosiciones &sumaPosiciones + &posicionValuada

        **Guardo las posiciones 
        let &nominales &nominales + &posicion  
    EndIf
Proximo

**Caso de ultimo registro
**Valido si la suma hasta aca es negativa para generar asiento
If &sumaPosiciones <> 0
    let &sumaCantOpValuada 0
    **Busco Operaciones TIPO y TIPP vigentes valuadas al dia de hoy para el tipo de especie, cuenta custodia y book

    SQL.ADD("SELECT O.Cantidad, O.Precio4, E.Cotiza  from "~DBO~".OPERACIONES O")
    SQL.ADD("JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
    SQL.ADD("JOIN "~DBO~".CUENTAS C ON C.Codigo = O.Cuenta1 ")
    SQL.ADD("WHERE O.TipoOp in ('TIPO','TIPP') ")
    SQL.ADD("AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'" )
    SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
    *SQL.ADD("AND O.Book1 = '"~&bookActual~"' ")
    SQL.ADD("AND E.Codigo = '"~&especieActual~"' ")
    **Cuenta no de garantia
    SQL.ADD("AND (C.CB2 Is Null OR C.CB2 = '' OR C.CB2 =' ' OR C.CB2='NO') ")
    Recorrer SQL
        let &cantidadOperacion fbn('Cantidad')
        Let &PrecioNIIF CotizacionNIIF(&especieActual, Dialogo.Fecha1, &bookActual)
        IF Vacio(&PrecioNIIF)
            let &precioNiif 0
        ELSE
            let &precioNiif &PrecioNIIF.PrecioCotizacionDeterminada
        ENDIF     
        Let &Precio &precioNiif
        *Let &Precio fbn('Precio4')
        
        let &cantidadOpValuada &cantidadOperacion * &Precio
        If Not EqStr(fbn('Cotiza'),VAR('MONELOCA'))
            ACT(MN:99,fbn('Cotiza'))
            let &cantidadOpValuada &cantidadOpValuada * #TCCONTABLE
        EndIf
        let &sumaCantOpValuada &sumaCantOpValuada + &cantidadOpValuada
        let &nominales &nominales + &cantidadOperacion 
    Proximo
    let &sumaPosiciones &sumaPosiciones - &sumaCantOpValuada
EndIf
**Vuelvo a controlar si es negativo por si pasò por el if anterior ya que las op compensan la cantidad de la posicion
If &sumaPosiciones < 0
    let &especie &especieActual
    let &Issuer BuscarCampo('ESPECIES','issuer','Codigo', &especieActual)
    let &Cotiza BuscarCampo('ESPECIES','Cotiza','Codigo', &especieActual)
    SQL.ADD(" SELECT '"~&especieActual~"' Especie, '"~&monedaEmisionActual~"' MonedaEmision, ")
    SQL.ADD(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookActual~"' Book1, '"~&tipoEspecie~"' TipoEspecie, ")
    SQL.ADD(" Codigo CodAsi, '"~&cuentaCustodiaActual~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
    SQL.ADD(" '"~&Issuer~"' Issuer , "~FStr(&nominales,0,0)~" Cantidad, '"~&Cotiza~"' Cotiza ")
    SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
    SQL.ADD(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoAsiento)~") ")
    SQL.ADD(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND Habilitado = 'SI' ")
    Recorrer SQL
        let &codAsi fbn('CodAsi')
        ACT(BK:1, &bookActual)
        *ACT(MN:99, fbn('MonedaEmision'))
        ACN(CK:1, 0)
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~&codAsi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~&vehiculo~"' "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        IF Val(CK:1) = 0
            Message('Modelo: '~&codAsi)
            SQL.GenerarAsientoOp(&codAsi, '','','',Val(NA:1),Val(FV:1),&vehiculo,,,,,,&tipoOp,,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
            let &cantidadPosCombinaciones &cantidadPosCombinaciones+1
            ACT(ZA:&cantidadPosCombinaciones,&especieActual)
            *ACT(ZB:&cantidadPosCombinaciones,&bookAnterior)            
        ENDIF
    Proximo
EndIf

**Genero Asiento por las operaciones que no tienen posiciones
let &especieActualOp ''
let &bookActualOp ''
let &especieAnteriorOp ''
let &bookAnteriorOp ''
let &sumaCantOpValuada 0
let &nominales 0

SQL.ADD("SELECT Cantidad, E.Tipo, E.Issuer, E.Cotiza, O.Cuenta2 CuentaCustodia, O.Vehiculo1, O.Especie, O.Book1, E.MonedaEmision, O.Precio4 Precio, O.ContraEspecie ")
SQL.ADD("from "~DBO~".OPERACIONES O")
SQL.ADD("JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
SQL.ADD("JOIN "~DBO~".CUENTAS C ON C.Codigo = O.Cuenta1 ")
SQL.ADD("WHERE O.TipoOp in ('TIPO','TIPP') ")
SQL.ADD("AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'" )
SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
Recorrer&i 1, &cantidadPosCombinaciones
    let &especieActual val(ZA:&i)
    *let &bookActual val(ZB:&i)
    If &i = 1
        SQL.ADD(" AND NOT ( ")
    EndIf
    *SQL.ADD("(O.Book1 = '"~&bookActual~"' ")
    SQL.ADD("E.Codigo = '"~&especieActual~"' ")
    If &i <> &cantidadPosCombinaciones
        **SI no es el ultimo registro le pongo OR
        SQL.ADD(" OR ")
    EndIf
    If &i = &cantidadPosCombinaciones
        SQL.ADD(")")
    EndIf
Proximo
**Cuenta no de garantia
SQL.ADD("AND (C.CB2 Is Null OR C.CB2 = '' OR C.CB2 =' ' OR C.CB2='NO') ")
Recorrer SQL
    **Por cada combinacion de Especie/Book de Operaciones no procesadas en el qry anterior de posiciones tengo que hacer corte de control y contabilizar
    If Vacio(&especieActualOp)
        let &especieActualOp fbn('Especie')
        let &bookActualOp fbn('Book1')
        let &especieAnteriorOp fbn('Especie')
        let &bookAnteriorOp fbn('Book1')
        let &sumaPosiciones 0
        let &nominales 0
    Else
        let &especieAnteriorOp &especieActualOp
        let &bookAnteriorOp &bookActualOp  
        let &especieActualOp fbn('Especie')
        let &bookActualOp fbn('Book1')        
    EndIf
    **Eliana 3-9-25 - el corto de control solo va a ser por Especie
    *If EqStr(&especieActualOp,&especieAnteriorOp) AND EqStr(&bookActualOp,&bookAnteriorOp)
    If EqStr(&especieActualOp,&especieAnteriorOp)
        let &cantidadOperacion fbn('Cantidad')
        Let &PrecioNIIF CotizacionNIIF(&especieActualOp, Dialogo.Fecha1, &bookActualOp)
        IF Vacio(&PrecioNIIF)
            let &precioNiif 0
        ELSE
            let &precioNiif &PrecioNIIF.PrecioCotizacionDeterminada
        ENDIF     
        Let &Precio &precioNiif        
        *let &Precio fbn('Precio')
        
        let &cantidadOpValuada &cantidadOperacion * &Precio
        If Not EqStr(fbn('Cotiza'),VAR('MONELOCA'))
            ACT(MN:99,fbn('Cotiza'))
            let &cantidadOpValuada &cantidadOpValuada * #TCCONTABLE
        EndIf        
        let &sumaPosiciones &sumaPosiciones + &cantidadOpValuada
        let &nominales &nominales + &cantidadOperacion
        
        **Todos estos datos se usan para generacion del asiento
        let &Issuer fbn('Issuer')
        let &Cotiza fbn('Cotiza')
        let &vehiculo fbn('Vehiculo1')
        let &tipoEspecie fbn('Tipo')
        let &cuentaCustodia fbn('CuentaCustodia')
        let &monedaEmision fbn('MonedaEmision') 
        let &cantidadOperacion fbn('Cantidad')        
    Else
        SQL.ADD(" SELECT '"~&especieAnteriorOp~"' Especie, '"~&monedaEmision~"' MonedaEmision, ")
        SQL.ADD(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookAnteriorOp~"' Book1, '"~&tipoEspecie~"' TipoEspecie, ")
        SQL.ADD(" Codigo CodAsi, '"~&cuentaCustodia~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
        SQL.ADD(" '"~&Issuer~"' Issuer , "~FStr(&nominales,0,0)~" Cantidad, '"~&Cotiza~"' Cotiza ")
        SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
        SQL.ADD(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoAsiento)~") ")
        SQL.ADD(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND Habilitado = 'SI' ")
        Recorrer SQL
            let &codAsi fbn('CodAsi')
            ACT(BK:1, &bookAnteriorOp)
            *ACT(MN:99, fbn('MonedaEmision'))
            ACN(CK:1, 0)
            IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
                ACN(CK:1, 1)
                IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~&codAsi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~&vehiculo~"' "))
                    ACN(CK:1, 0)
                ENDIF
            ENDIF
            IF Val(CK:1) = 0
                Message('Modelo: '~&codAsi)
                SQL.GenerarAsientoOp(&codAsi, '','','',Val(NA:1),Val(FV:1),&vehiculo,,,,,,&tipoOp,,,,,,,fsys,Dialogo.Fecha1)
                SQL.EXEC
            ENDIF
        Proximo 
        let &sumaPosiciones 0
        let &nominales 0
        let &sumaCantOpValuada 0
        
        let &cantidadOperacion fbn('Cantidad')
        let &Precio fbn('Precio')
        
        let &cantidadOpValuada &cantidadOperacion * &Precio
        If Not EqStr(fbn('Cotiza'),VAR('MONELOCA'))
            ACT(MN:99,fbn('Cotiza'))
            let &cantidadOpValuada &cantidadOpValuada * #TCCONTABLE
        EndIf
        let &sumaPosiciones &sumaPosiciones + &cantidadOpValuada
        let &nominales &nominales + &cantidadOperacion     
        
        **Todos estos datos se usan para generacion del asiento
        let &Issuer fbn('Issuer')
        let &Cotiza fbn('Cotiza')
        let &vehiculo fbn('Vehiculo1')
        let &tipoEspecie fbn('Tipo')
        let &cuentaCustodia fbn('CuentaCustodia')
        let &monedaEmision fbn('MonedaEmision') 
        let &cantidadOperacion fbn('Cantidad')
        
    EndIf
Proximo

**Utimo registo de Operaciones sin posiciones para procesar
If &sumaPosiciones >0
    SQL.ADD(" SELECT '"~&especieActualOp~"' Especie, '"~&monedaEmisionActual~"' MonedaEmision, ")
    SQL.ADD(" '"~&vehiculo~"' Vehiculo1, 'TIC' TipoOp, '"~&bookActualOp~"' Book1, '"~&tipoEspecie~"' TipoEspecie, ")
    SQL.ADD(" Codigo CodAsi, '"~&cuentaCustodia~"' CuentaCustodia, '' Concepto, '"~&vehiculo~"' Cliente, ")
    SQL.ADD(" '"~&Issuer~"' Issuer , "~FStr(&nominales,0,0)~" Cantidad, '"~&Cotiza~"' Cotiza ")
    SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
    SQL.ADD(" Where TipoAsiento IN ("~Pipe2Comillas(&tipoAsiento)~") ")
    SQL.ADD(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND Habilitado = 'SI' ")
    Recorrer SQL
        let &codAsi fbn('CodAsi')
        ACT(BK:1, &bookActualOp)
        *ACT(MN:99, fbn('MonedaEmision'))
        ACN(CK:1, 0)
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~&codAsi~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~&vehiculo~"' "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        IF Val(CK:1) = 0
            Message('Modelo: '~&codAsi)
            SQL.GenerarAsientoOp(&codAsi, '','','',Val(NA:1),Val(FV:1),&vehiculo,,,,,,&tipoOp,,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
    Proximo 
EndIf
    
**-----------------------------------------**
Message('--- Reversa asientos de Egreso de Titulos ---')
**--Reversamos los asientos de ayer
ACD(FV:2,Habiles(Dialogo.Fecha1,-1,'ARG'))

SQL.ADD(" Select FechaValor, NrUnicoAsiento ")
SQL.ADD(" From "~DBO~".ASIENTOSCON A ")
SQL.ADD(" JOIN "~DBO~".MODELOSASIENTO MA ON A.Modelo = MA.Codigo ")
SQL.ADD(" Where MA.TipoAsiento IN ("~Pipe2Comillas(&tipoAsiento)~") ")
SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND (A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
SQL.ADD(" AND A.FechaValor = '"~IdxDate(Val(FV:2))~"' ")
watch(SQL.batch)

Recorrer SQL
    *ACD(FV:3, fbn('FechaValor'))
    ACT(AS:1, fbn('NrUnicoAsiento'))
    *ACD(FV:3, fbn('FechaValor'))
    ***---Llamo a evento que realiza ContraAsiento
    EjecutarEvento('CONT46', Fecha1=Dialogo.Fecha1, NrUnicoAsiento1=Val(AS:1), Fecha2=Dialogo.Fecha1, Radio1=0)
Proximo
