CrearDialogo
  NrOperacion1   :'NrOperacion'  ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar un NrOperacion';NO;
  Cantidad1      :'Cantidad'     ;;;;;;Dialogo.Cantidad1>0;'Debe Ingresar Cantidad';NO;
  Fecha1         :'Desde'        ;;;;;;Dialogo.Fecha1>0;'Debe Ingresar Fecha Desde';NO;
  Fecha2         :'Hasta'        ;;;;;;Dialogo.Fecha2>0;'Debe Ingresar Fecha Hasta';NO;
  Precio1        :'Precio en ME' ;;;;;;Dialogo.Precio1>0;'Debe Ingresar Precio en ME';NO;
  Especie1       :'Especie'      ;;;;;;NoVacio(Dialogo.Especie1);'Debe Ingresar una Especie';NO;
FinDialogo

If Not OK
  Cancelar
Endif


* **+Busco la tasa del bono
* (.'TASABONO'.)     
* let &tirEspecie TIREspecie(Dialogo.Especie1,Dialogo.Fecha1,Dialogo.Precio1,Val(TS:1))
* **+Actualizo la TIR Inicial de la Operacion
* SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
* SQL.ADD("SET TipoCambio = "~Fstr(&tirEspecie, 0, 8)~" ")
* SQL.ADD("WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
* SQL.NEW

**+Inserto la Operacion en PARTIDAS
SQL.ADD(" INSERT INTO "~DBO~".PARTIDAS ")
SQL.ADD(" ( NrOperacion,NrPartida,Cantidad,FechaDesde,FechaHasta,TipoAct, Precio1, Precio2) ")
SQL.ADD(" VALUES (   '"~Dialogo.NrOperacion1~"','"~Dialogo.NrOperacion1~"',             ")
SQL.ADD(" "~Fstr(Dialogo.Cantidad1,0,2)~",'"~IdxDate(Dialogo.Fecha1)~"',    ")
SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"','TIC', "~Fstr(Dialogo.Precio1,0,8)~", "~Fstr(Dialogo.Precio1,0,8)~" )            ")
SQL.NEW

SQL.EXEC
