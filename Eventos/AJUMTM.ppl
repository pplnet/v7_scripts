MostrarCuadrodeMensajes
CrearDialogo
  NrOperacion1 : 'Operacion'      ;;;;;;;;;'FM000026';
  Fecha1       : 'Fecha'          ;;;;;;;;;FSys;
  Cantidad     : 'TotalResultado' ;;;;;;;;;0; 
FinDialogo

if not OK
   Cancelar
endif   

Message('Borrando MTM')
SQL.ADD("DELETE "~DBO~".MTMDIARIO  ")
SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  ")
SQL.ADD("  AND Fecha="~Idxdate2(Dialogo.Fecha1))
SQL.ADD("  AND TipoMTM='MTM' ")
SQL.NEW

Message('Borrando Liquidacion')
SQL.ADD("DELETE "~DBO~".MOVPENDIENTES  ")
SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  ")
SQL.ADD("  AND Fechamov="~Idxdate2(Dialogo.Fecha1))
SQL.NEW


Message('Actualizando Resultado')
SQL.ADD("UPDATE "~DBO~".OPERACIONES  ")
SQL.ADD("   SET TotalAux3="~FSTR(Dialogo.Cantidad,0,2))
SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  ")
SQL.NEW
SQL.EXEC
