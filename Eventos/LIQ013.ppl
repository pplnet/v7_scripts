              'Cta.Moneda'    ;s:1..s:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(s:flb));'Ingrese una Cuenta de Moneda'; 80;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"(Estado='HAB' and TipoCuenta IN ('CC','CA') and Cliente='"~Val(a:flb)~"' and (Mercado='"~Val(g:flb)~"' ) and (MercadoLiq='"~Val(g:flb)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%')) ";RGB(160,160,193);SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA') and Cliente='"~Val(a:flb)~"' and (Mercado='"~Val(g:flb)~"' ) and (MercadoLiq='"~Val(g:flb)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;
