ACT(ba:2,SQLSet("Select Codigo FROM "~DBO~".MERCADOS WHERE Netea='SI'"))
CrearDialogo
 Especie1 :    'Especie'        ;;1;;;;;;;;;;;;"Jerarquia like '"~VAR('JERTITULOS')~"%'"
 Cliente1 :    'Cliente'        ;;1;;;;;;
 Especie2 :    'CEspecie'       ;;1;;;;;;
 Vehiculo1:    'Vehiculo'       ;;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo'                 ;NO;VAR('VEHICULODE')
 NrOperacion1: 'Nr.Operacion'   ;;1;;  ;;                          ;;;
 Mercado1 :    'Mercado Actual' ;;1;;Vacio(Dialogo.NrOperacion1)  ;;(NoVacio(Dialogo.Mercado1) y Incluido('T',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado1)) o NoVacio(Dialogo.NrOperacion1));'Debe ingresar Mercado Actual habilitado para Titulos';NO;;IIF(NoVacio(Dialogo.NrOperacion1),BuscarCampo('OPERACIONES','Mercado','NrOperacion',Dialogo.NrOperacion1),Dialogo.Mercado1);;;;" Observaciones like '%T%' "
   **Mercado2 :    'Mercado Nuevo'  ;;1;;NO(EQSTR('TIDE',BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Dialogo.NrOperacion1)));;If(No(EQSTR('TIDE',BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Dialogo.NrOperacion1))), NoVacio(Dialogo.Mercado2) y Incluido('T',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado2)));'Debe ingresar Mercado Nuevo habilitado para Titulos' ;NO;;If(EQSTR('TIDE',BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Dialogo.NrOperacion1)),BuscarCampo('OPERACIONES','Mercado','NrOperacion',Dialogo.NrOperacion1),"");;;;" Observaciones like '%T%' "
 Mercado2 :    'Mercado Nuevo'  ;;1;;  ;;NoVacio(Dialogo.Mercado2) y Incluido('T',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado2));'Debe ingresar Mercado Nuevo habilitado para Titulos' ;NO;;;;;;" Observaciones like '%T%' "
 Mercado3 :    'Mercado Moneda' ;;1;;  ;;Vacio(Dialogo.Mercado3) o Incluido('M',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado3));'Debe ingresar Mercado de moneda habilitado'          ;NO;;;;;;" Observaciones like '%M%' "
FinDialogo 

If Not Ok
 Cancelar
Endif

let &TipoOp BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', Dialogo.NrOperacion1)
let &JerarquiaTitulos Jerarquia("ESPECIES","TITULO") ~ "%"

ACN(a:0,0)

If SQL("SELECT IsNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado2~"' ")='SI'
ACT(ba:1,'SI')
else
ACT(ba:1,'NO')
endif

If Vacio(Dialogo.Mercado3)
  ACT(ba:3,val(ba:1))
Else   
   If SQL("SELECT IsNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado3~"' ")='SI'
     ACT(ba:3,'SI')
  else
     ACT(ba:3,'NO')
  endif
Endif

** Operaciones de CV con Movimientos pendientes **
MostrarCuadroDeMensajes

SQL.ADD("Select DISTINCT O.TipoOp, O.NrOperacion, O.Mercado2, O.Mercado, O.FormaLiquidacion2, O.FormaLiquidacion1, O.FechaOp, O.FechaVto,    ")
SQL.ADD("       O.Cliente1, O.Especie, O.ContraEspecie, O.Cantidad, O.TotalNetoCli1, C.RazonSocial, O.CB7, O.NrBoleto, O.Cuenta1, O.Cuenta4, ")
SQL.ADD("       O.Cuenta2, O.Cuenta3, O.Vehiculo1, O.Plaza1, O.Cuenta5, O.Cuenta6 , O.CB4                 ")
SQL.ADD(" from   "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M,/* "~DBO~".OPERACIONESBITS B,*/ "~DBO~".ESPECIES E            ")
SQL.ADD("where  O.Cliente1 = C.Codigo                                                            ")
SQL.ADD("      and  E.Jerarquia like '"~VAR('JERTITULOS')~"%'                                    ")
SQL.ADD("      and  M.NrOperacion = O.NrOperacion                                                ")
**SQL.ADD("      and  M.NrOperacion = B.NrOperacion                                                ")
**SQL.ADD("      and  O.TipoOp NOT In ('TIPP','TIPA','TIDE')                                              ")
**AA 16-11-2023 incorporacion jerarqui titulos y diferenciacion Prestamos y depositos
SQL.ADD("      and  O.TipoOp NOT In ('TIPP','TIPA')                                              ")
** AA 05-05-2026 se omite la verificacion de instancias
**SQL.ADD("      and  B.Valor  = '1'                                                               ")
**SQL.ADD("      and  B.NrBit  in (10,7)                                                           ")
SQL.ADD("      and Exists (select 1 FROM "~DBO~".MOVPENDIENTES MP2                               ")
SQL.ADD("                   where MP2.NrOperacion=M.NrOperacion                                  ")
SQL.ADD("                    and MP2.Especie=M.Especie                                           ")
SQL.ADD("                    group by MP2.NrOperacion, MP2.Especie                               ")
SQL.ADD("                    having count(1)>=1 ) ") 
** AA 15-01-2024 Se elimina control de cantidad movpendientes, en todos los casos deberar de haber  al menos 1, no importando los ejecutados
**SQL.ADD("                    having count(1)=Case when TipoOp in ('TIDE','TIPO','TICT','TICO') then 2 else 1 end ) ") 
**SQL.ADD("      and O.NrOperacion not in (select NrOperacion from "~DBO~".MOVEJECUTADOS ME        ")
**SQL.ADD("                    where ME.NrOperacion = O.NrOperacion AND ME.NrSaldo IN (1,31) )     ")

If NoVacio(Dialogo.NrOperacion1)   
   SQL.ADD("   and  O.NrOperacion = '"~Dialogo.NrOperacion1~"'                                   ")
Else
 SQL.ADD("      and  O.Mercado = '"~Dialogo.Mercado1~"'   ") 
   
   If NoVacio(Dialogo.Cliente1)   
      SQL.ADD("   and  O.Cliente1 = '"~Dialogo.Cliente1~"'                                          ")
 Endif
 If NoVacio(Dialogo.Especie1)
    SQL.ADD("   and  O.Especie  = '"~Dialogo.Especie1~"'                                          ")
 Endif
 If NoVacio(Dialogo.Especie2)
    SQL.ADD("   and  O.ContraEspecie  = '"~Dialogo.Especie2~"'                                    ")
 Endif
Endif
SQL.ADD("order by O.Cliente1, O.TipoOp, O.NrOperacion                                            ")
watch(SQL.BATCH())

Recorrer SQL
 SCN(a:0,1)
 Message('Operacion '~fbn('NrOperacion'))
 
   ACT(a:fac, fbn('Cliente1'))
 ACT(b:fac, fbn('RazonSocial'))
 ACT(c:fac, fbn('TipoOp'))
 ACT(d:fac, fbn('NrOperacion'))
 If Eqstr(val(ba:1),'SI')
   ** Netea DVP
   ACN(e:fac,1)
 else
     IF Eqstr(Dialogo.Mercado2,'EU')
          ** DVP
        ACN(e:fac, 1)
     else
        if Incluido(Dialogo.Mercado2,VAR('MERCADOCV'))
           ACN(e:fac, fbn('FormaLiquidacion1'))
        else
           ACN(e:fac, fbn('FormaLiquidacion2'))
        endif
     endif   
   Endif
   ** AA 11-02-2022 Mercado Titulos
 ACT(f:fac, Dialogo.Mercado2)
   ** AA 11-02-2022 Mercado Moneda
 if Vacio(Dialogo.Mercado3)
     If Eqstr(val(ba:1),'SI')
        ACT(g:fac, Dialogo.Mercado2)
     else
         ** FJL 21-09-18 por pedido de Alcira - issue 3295
         *     ACT(g:fac, fbn('Mercado2'))
       IF Not Incluido(Dialogo.Mercado2,VAR('MERCADOCV')) Y fbn('FormaLiquidacion2')<2
          ACT(g:fac, Dialogo.Mercado2)
       else
          ACT(g:fac, MercadoDef(fbn('ContraEspecie')) )
       endif
     endif
 else
     ACT(g:fac, Dialogo.Mercado3)
 endif   
   
   ** AA 21-07-2023 Mercado Vehiculo BCRA-VISTA
 if Eqstr(Val(g:fac),'VISTA')
    #ifdef MLASA
        ACT(xy:fac,IIF(Incluido(Val(g:fac),VAR('MERNOVEHI')),Var('MERCA3C'),'VISTA'))
    #else
        ACT(xy:fac,IIF(Incluido(Val(g:fac),VAR('MERNOVEHI')),Var('MERCBCRA'),'VISTA'))
    #endif    
       
 Else
    #ifdef MLASA
        ACT(xy:fac,Var('MERCA3C'))   
    #else
        ACT(xy:fac,Var('MERCBCRA'))  
    #endif
 endif
 
 ACD(h:fac, fbn('FechaOp'))
 ACD(i:fac, fbn('FechaVto'))
 ACT(j:fac, fbn('Especie'))
 ACT(k:fac, fbn('ContraEspecie'))
 ACN(l:fac, fbn('Cantidad'))
 ACN(m:fac, fbn('TotalNetoCli1'))
 ACT(o:fac, fbn('Mercado2'))
 ACT(p:fac, fbn('Mercado'))
 ACN(q:fac, 0)
 ACT(v:fac, fbn('Plaza1'))
 ACT(w:fac, fbn('Vehiculo1'))
 ACN(aq:fac, fbn('CB4'))
 
   **AA 11-02-2022 Mercado Titulos/Especie
 If EqStr(Dialogo.Mercado2,fbn('Mercado'))
    ACT(r:fac, fbn('Cuenta1'))
    ACT(t:fac, fbn('Cuenta2'))
 Else
    ACT(r:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~IIF(EqStr(Val(ba:1),'SI'),Val(w:fac),Val(a:fac))~"'  and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
    ACT(t:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
 Endif

   **AA 11-02-2022 Mercado Moneda
 If EqStr(Dialogo.Mercado3,fbn('Mercado2'))
    ACT(s:fac,  fbn('Cuenta4'))
    ACT(u:fac,  fbn('Cuenta3'))
    ACT(as:fac, fbn('Cuenta5'))
    ACT(au:fac, fbn('Cuenta6'))
 Else
    if Eqstr(val(ba:1),'SI')
         ** Netea
       ACT(s:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CUS','CCO','CC','CA','VIS') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Var('MERCBCRA')~"' or Mercado='"~Var('MERCA3C')~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
       ACT(u:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CUS','CCO','CC','CA','VIS') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Val(xy:fac)~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
       ACT(as:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(a:fac)~"' and (Mercado='"~Val(g:fac)~"' ) and (MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
       ACT(au:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(w:fac)~"' and (Mercado='"~Val(g:fac)~"' ) and (MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
    else
         ** No Netea
       ACT(s:fac,  SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(a:fac)~"' and Mercado='"~Val(g:fac)~"' and (MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
       ACT(u:fac,  SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(w:fac)~"' and (Case when ('"~Val(g:fac)~"' in  ('MERINT','VISTA') and '"~Val(c:fac)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:fac)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:fac)~"' end = Mercado) and (MercadoLiq=(Case when ('"~Val(g:flb)~"' in  ('MERINT','VISTA')  and '"~Val(c:fac)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:fac)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:fac)~"' end) or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
       ACT(as:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(a:fac)~"' and Mercado='"~Val(g:fac)~"' and (MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
       ACT(au:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~Val(w:fac)~"' and (Case when ('"~Val(g:fac)~"' in  ('MERINT','VISTA') and '"~Val(c:fac)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:fac)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:fac)~"' end = Mercado) and (MercadoLiq=(Case when ('"~Val(g:flb)~"' in  ('MERINT','VISTA')  and '"~Val(c:fac)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:fac)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:fac)~"' end) or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
    endif
 Endif   

