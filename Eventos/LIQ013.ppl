  MostrarCuadroDeMensajes
Message('Actualizando Operaciones...')

Recorrer&i 1,Val(a:0)
  If Eqstr(val(ba:1),'SI')
    ACT(v:&i, VAR('CTAVEHIC'))
  else
    ACT(v:&i, Val(t:&i))
  Endif

  If Val(q:&i)=1
    Message(Val(d:&i))
      **Messagebox(Val(ba:1)~' '~Val(e:&i)~' '~Val(f:&i)~' '~Val(g:&i))
    SQL.ADD("update "~DBO~".OPERACIONES ")
** AA18-02-2022 se cambia definicion para Forma de Liqidacion para CV siempre FormaLiquidacion1 sin importar neteo
*      If Eqstr(val(ba:1),'SI')
*        SQL.ADD(" set FormaLiquidacion1 = "~FStr(Val(e:&i),1,0)~", ")
*        SQL.ADD("     FormaLiquidacion2 = "~FStr(0,1,0)~", ") 
*      else
*        SQL.ADD(" set FormaLiquidacion2 = "~FStr(Val(e:&i),1,0)~", ")
*        SQL.ADD("     FormaLiquidacion1 = "~FStr(0,1,0)~", ") 
*      endif
    If INCLUIDO(val(f:&i),VAR('MERCADOCV'))
      SQL.ADD(" set FormaLiquidacion1 = "~FStr(Val(e:&i),1,0)~", ")
      SQL.ADD("     FormaLiquidacion2 = "~FStr(0,1,0)~", ") 
      else
      SQL.ADD(" set FormaLiquidacion2 = "~FStr(Val(e:&i),1,0)~", ")
      SQL.ADD("     FormaLiquidacion1 = "~FStr(0,0,0)~", ") 
      endif
    SQL.ADD("     Cuenta1 = '"~Val(r:&i)~"', ")
    SQL.ADD("     Cuenta4 = '"~Val(s:&i)~"', ")
    SQL.ADD("     Cuenta2 = '"~Val(t:&i)~"', ")
    SQL.ADD("     Cuenta3 = '"~Val(u:&i)~"', ")
    SQL.ADD("     Cuenta5 = '"~Val(as:&i)~"', ")
    SQL.ADD("     Cuenta6 = '"~Val(au:&i)~"', ")
    SQL.ADD("     Plaza1  = '"~Val(v:&i)~"', ")
    SQL.ADD("     Mercado = '"~Val(f:&i)~"', ")
    SQL.ADD("     Mercado2 = '"~Val(g:&i)~"' ")
    SQL.ADD(" where NrOperacion = '"~Val(d:&i)~"' ")
    SQL.NEW
    SQL.EXEC
    SQL.ActualizarMovimientos3(Val(d:&i),SI,NO,NO,SI,NO)
    SQL.EXEC
  Endif
Proximo
MessageBox('Mercado cambiado correctamente')
OcultarCuadroDeMensajes
else
if Vacio(Dialogo.NrOperacion1)
  MessageBox('No hay Operaciones sin Liquidar')
else
  MessageBox('La Operacion '~Dialogo.NrOperacion1~' no puede modificarse.')
endif
Endif
