              'Cta.Veh.Moneda';u:1..u:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(u:flb));'Ingrese una Cuenta de Vehiculo de Moneda'; 100;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CUS','CCO','CC','CA','VIS) and Cliente='"~IIF(EqStr(Val(ba:3),'SI'),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(g:flb)~"' "),Val(w:flb))~"' and (Case when ('"~Val(xy:flb)~"' in  ('MERINT','VISTA') and '"~Val(c:flb)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:flb)~"' = 'ARP' then '"~Val(xy:flb)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(xy:flb)~"' end = Mercado) and (MercadoLiq=(Case when ('"~Val(g:flb)~"' in  ('MERINT','VISTA')  and '"~Val(c:flb)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:flb)~"' = 'ARP' then '"~Val(xy:flb)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:flb)~"' end) or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%') ";RGB(160,160,193);SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS') and Cliente='"~IIF(EqStr(Val(ba:3),'SI'),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(xy:flb)~"' "),Val(w:flb))~"' and (Case when ('"~Val(g:flb)~"' in  ('MERINT','VISTA') and '"~Val(c:flb)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:flb)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:flb)~"' end = Mercado) and (MercadoLiq=(Case when ('"~Val(g:flb)~"' in  ('MERINT','VISTA')  and '"~Val(c:flb)~"' in ('TIC','TIV','TIDE','TIPO','TCOPRI')) then Case when '"~Val(k:flb)~"' = 'ARP' then '"~Val(xy:fac)~"' Else '"~Var('MERSWIFT')~"' end else '"~Val(g:flb)~"' end) or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%')) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;    

