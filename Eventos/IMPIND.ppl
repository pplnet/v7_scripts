MostrarCuadrodeMensajes
CrearDialogo
  Fecha1  : 'Fecha'      ; ; ;;NO;;;;;;FSYS
  String1 : 'Path'       ; ; ;;  ;  ;;;;Var('PATHIMPO')
  String2 : 'Archivo'    ; ; ;;  ;  ;;;;'INDICES.XLS'  
  Check1  : 'Procesa'    ;1;2;;NO;NO;;;;1;
FinDialogo
If Not OK
   Cancelar
EndIf
HojaVisible(SI)

If Not ExisteDirectorio(Var('PATHIMPO'))
   Cancelar('Debe Crear el Directorio '~Var('PATHIMPO'))
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

ACN(x:1, 1000)
*- Excel Indices
ImportarXLS(a:1..c:Val(x:1),aa:1..ac:Val(x:1),Dialogo.String1~Dialogo.String2)

If Vacio(val(aa:1))
   Cancelar('No se ha podido recuperar el archivo de indices:'~Dialogo.String1~Dialogo.String2)
EndIf

SetFilaActual(1)
Recorrer&i 2,Val(x:1)
  if Vacio(Val(aa:&i))
    ACN(x:2, &i-1)
    Break
  endif

  act(af:&i,SQL(" Select Codigo From "~DBO~".ESPECIES Where Codigo = '"~val(aa:&i)~"' "))   
  if Vacio(af:&i)
    SCN(ae:&i, 1)
    ACT(al:&i, 'No existe en Especies')
  endif  

  IF Val(ae:&i)=0
    IF DesciendeDeEspecie(val(aa:&i),'INDICE')
      ACT(ag:&i, 'OK')
    else
      SCN(ae:&i, 1)
      ACT(al:&i, 'No desciende de INDICE')
    endif  
  endif  

  IF Val(ae:&i)=0
    IF Esterminal(val(aa:&i))
      ACT(ah:&i, 'OK')
    else
      SCN(ae:&i, 1)
      ACT(al:&i, 'No es Terminal')
    endif  
  endif  

  IF Val(ae:&i)=0
    ACT(ai:&i, BuscarCampo('ESPECIES','CodigoExterno','Codigo',Val(aa:&i)))
    ACT(aj:&i, BuscarCampo('ESPECIES','Tenor','Codigo',Val(aa:&i)))
    IF NoVacio(val(ai:&i)) o Novacio(val(aj:&i))
      SCN(ae:&i, 1)
      ACT(al:&i, 'Es indice para spread ICL')
    endif  
  endif  
proximo
  
SetFilaActual(3)
ACT(a:FAC, 'Importacion de Indices')
SetFont(a:Fac, 3)
  
SetFilaActual(fac+2)
ACT(a:FAC, 'Fecha: '~Dialogo.Fecha1)
ACT(a:FAC+1, 'Archivo importado: '~Dialogo.String1~Dialogo.String2)
SetFont(a:FAC..a:FAC+1, 2)

SetFilaActual(fac+3)
ACT(a:FAC, 'Indice')
ACT(b:FAC, 'Fecha')
ACT(c:FAC, 'Valor')
ACT(d:FAC, 'Accion')
ACT(e:FAC, 'Observacion')
SetFont(a:FAC..e:FAC, 2)
AgregarMarco(a:FAC..e:FAC,1,0,Exe('COLOR6'))

if Val(x:2)>1
  Recorrer&i 2,Val(x:2)
    IFA
    
    ACT(a:FAC, Val(aa:&i))
    ACD(b:FAC, Val(ab:&i))
    ACN(c:FAC, Val(ac:&i))
    IF Val(ae:&i)=0
      If SQL("SELECT 1 FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(aa:&i)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(ab:&i))~"' and Moneda='ARP' ")=1
        ACT(d:FAC, 'Update')
        if Dialogo.Check1=1
          SQL.ADD("UPDATE "~DBO~".COTIZACIONES SET ")
          SQL.ADD("Precio1            = "~FStr(Val(ac:&i),1,8)~", ")
          SQL.ADD("FechaActualizacion = "~SQLAhora~" ")
          SQL.ADD("WHERE  Codigo='"~Val(aa:&i)~"' and ISNULL(CallPut,'CON')='CON' and Fecha='"~IdxDate(Val(ab:&i))~"' and Moneda='ARP' ")
          SQL.NEW
          SQL.EXEC
        Endif
      Else
        ACT(d:FAC, 'Insert')
        if Dialogo.Check1=1
          *- Insertar registro
          SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
          SQL.ADD("(Fecha, Codigo, CallPut, Precio1, Moneda, FechaActualizacion) ")
          SQL.ADD(" VALUES ('"~IdxDate(val(ab:&i))~"', '"~Val(aa:&i)~"', 'CON', ")
          SQL.ADD(" "~Fstr(Val(ac:&i),0,8)~", 'ARP',"~SQLAhora~" )")
          SQL.NEW
          SQL.EXEC
        Endif
      Endif
    ELSE
      ACT(d:FAC, 'ERROR')
      ACT(e:FAC, Val(al:&i))
    ENDIF
  Proximo
  SetFont(a:FAC-Val(x:2)+2..e:FAC, 1)
  FormatoCeldas(c:FAC-Val(x:2)+2..c:FAC, exe('F8'))

else
  SetFilaActual(fac+2)
  ACT(a:FAC, 'No registros para importar')
  SetFont(a:FAC, 2)
endif

SetFilaActual(fac+2)
ACT(a:FAC, 'Fin Listado')
SetFont(a:FAC, 2)

ACO(1,10)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,20)

LimitesVision(e:fac)
