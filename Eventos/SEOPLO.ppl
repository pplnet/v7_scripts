CrearDialogo
  TipoOp1   : "Tipo Oper."   ;;;;NO;;NoVacio(Dialogo.TipoOp1);'Debe Ingresar un Tipo de Operacion';NO;'DSEO'
  Vehiculo1 : "Vehiculo"     ;;;;;;;;;
FinDialogo

IF Not OK
   Cancelar
EndIf

ACT(Z1,Dialogo.TipoOp1)
ACT(Z2,Dialogo.Vehiculo1)

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

SQL.ADD(" Select * from "~DBO~".OPERACIONES WHERE TipoOp in ('"~Dialogo.TipoOp1~"') ")
SQL.ADD(" and (CB8 is Null or CB8='0') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
*SQL.ADD("and ((TipoOpcion='0' and FechaEj = '"~IdxDate(Fsys)~"') ")
*SQL.ADD(" or (TipoOpcion='1' and FechaEj >= '"~IdxDate(Fsys)~"' ")
*SQL.ADD(" and FechaOp2 <= '"~IdxDate(Fsys)~"')) ")
SQL.ADD(" ORDER BY NrOperacion ")

ACN(x1,0)

Recorrer SQL 
 
    ACN(x1,1)
    Message('*-- Recuperando Operacion '~FBN['NrOperacion'])
   
    ** Muestro los datos
    ACT(b:FAC+1,FBN['NrOperacion'])
    ACD(c:FAC+1,FBN['FechaOp'])
    ACD(d:FAC+1,FBN['FechaOp2'])
    ACD(e:FAC+1,FBN['FechaEj'])
    ACN(f:FAC+1,FBN['MB1'])
    ACN(g:FAC+1,FBN['TipoOpcion'])
    ACT(h:FAC+1,FBN['Especie'])
    ACN(i:FAC+1,FBN['PrecioEj'])
    ACN(j:FAC+1,FBN['Cantidad'])
    ACT(k:FAC+1,FBN['ContraEspecie'])
    ACN(l:FAC+1,FBN['PrecioMer'])
    ACT(aa:FAC+1,FBN['TablaFeriados1'])
    ACD(o:fac+1,HABILES(Fsys,(BuscarCampo('Especies','PlazoLiq','Codigo',FBN['Especie']) DIV 24),'ARG',SI))
    ACN(p:FAC+1,FBN['MB3'])
Proximo

IF VAL(x1)=1 
    *-- Hay datos para mostrar
   CrearDialogo
     TipoOp2   : "Tipo Oper."   ;1;1;;NO;;;;;VAL(Z1)
     Vehiculo1 : "Vehiculo"     ;2;1;;NO;;;;;VAL(Z2) 
     ListBox; 'Arial,8,N'; 460; 180
        'Ejerce?'       ;a2..a:FAC+1;  ;;;;20;CHECK
        'Nro.Op.'       ;b2..b:FAC+1;NO;;;;60;STRING
        'F.Operacion'   ;c2..c:FAC+1;NO;;;;;FECHA
        'F.Inicio'      ;d2..d:FAC+1;NO;;;;;FECHA
        'F.Fin'         ;e2..e:FAC+1;NO;;;;;FECHA
        'C/V'           ;p2..p:FAC+1;NO;;;;35;COMBO;'Compra|Venta'
        'Tipo'          ;f2..f:FAC+1;NO;;;;35;COMBO;'Call|Put'
        'Opcion'        ;g2..g:FAC+1;NO;;;;50;COMBO;'Europea|Americana'
        'Especie'       ;h2..h:FAC+1;NO;;;;35;TABLA;'Especies';'Codigo';'Codigo;Nombre';
        'PrecioEj'      ;i2..i:FAC+1;NO;;;;60;NUMERO;'##,###.#####'
        'Cantidad'      ;j2..j:FAC+1;NO;;;;80;NUMERO;'##,###,###.##'
        'ContraEspecie' ;k2..k:FAC+1;NO;;;;35;TABLA;'Especies';'Codigo';'Codigo;Nombre';
        'Precio Ref'    ;m2..m:FAC+1;  ;VAL(a:FLB)=0 O val(m:FLB)<>0;'Ingrese precio de Refernecia';;60;NUMERO;'##,###,###,###.##'
        'F.Settlement'  ;o2..o:FAC+1;;VAL(a:FLB)=0 O ESHABIL(VAL(o:FLB),VAL(aa:FLB));'La Fecha de Settlement tiene que ser habil en la Tabla de Feriados de '~VAL(aa:FLB);;;FECHA
      FinListBox  
   FinDialogo

   IF Not OK
      Cancelar
   EndIf

   *-- El primer renglon es de totales
   Recorrer&i 2,10

      Message('Validando Renglon '~Fstr(&i-1,2,0)~' Operacion: '~Val(b:&i))

      If NoVacio(Val(a:&i)) y Val(a:&i)<>0
         * Verifico que se encuentre en Back Office o Terminal
         ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~VAL(b:&i)~"' AND Valor='1'") )

         If VAL(X1)<>20 y VAL(X1)<>50
            *-- Busco la instancia actual
            Cancelar("La Operacion "~VAL(b:&i)~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
         Else
            EjecutarEvento('SEEJEO',NrOperacion1=VAL(b:&i),Fecha1=Fsys,Precio2=VAL(m:&i),Fecha3=VAL(o:&i),Fecha4=VAL(e:&i),Precio3=VAL(i:&i),Radio1=VAL(g:&i),Radio2=VAL(f:&i),Especie1=VAL(h:&i))
         EndIf
      Endif
   Proximo
ELSE
   MessageBox('No existe ninguna Opcion para Ejercer a la Fecha para el Vehiculo '~Dialogo.Vehiculo1~' ...')
ENDIF