* DTEJCF: Ejercico de Caps y Floor
CrearDialogo
   Fecha1       : "F Real Ej."       ;1;1;;;;Dialogo.Fecha1=Dialogo.Fecha2;'Fecha de Ejercicio Real no corresponde con la Fecha de Reset';NO;Fsys
   NrOperacion1 : "Operacion"        ;;;;;;Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTCAP|DTFLO');'DEBE INGRESAR UNA OPERACION DE TIPO DTCAP o DTFLO';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp In ('DTCAP','DTFLO') ")
   Entero1      : "Nro. Settlement"  ;;;;;;Dialogo.Entero1>0;'Debe Indicar el Nro. de Settlement';NO;0;
   Precio2      : "Tasa"             ;;;;;;Dialogo.Precio2<=VAR('RTASA2') y Dialogo.Precio2>=VAR('RTASA1');'Tasa Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;0
   Fecha2       : "F.Reset"          ;;;;NO;;;;;;SQL("Select Fecha4 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
   Fecha3       : "F.Sett"           ;;;;NO;;;;;;SQL("Select Fecha7 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
   Fecha4       : "F.Fin"            ;;;;NO;;;;;;SQL("Select Fecha6 from "~DBO~".CUOTAS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
FinDialogo

If Not Ok
   Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTCAP|DTFLO')
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es un Cap o Floor de Tasa')
Endif

* Verifico que se encuentre en Back Office o Terminal
ACN(x1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If Val(x1)<>20 y Val(x1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   * x1: Recupero la Operacion
   ACN(x1,0)

   SQL.ADD("SELECT C.*,O.RB8,O.PrecioEj,O.TipoOp FROM "~DBO~".CUOTAS C,"~DBO~".OPERACIONES O ")
   SQL.ADD("WHERE  C.NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("       and C.NrOperacion =O.NrOperacion ")
   SQL.ADD("       and C.NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
   SQL.ADD("       and C.Check1='0' ")

   Recorrer SQL
      ACN(x1,1)
      ACN (z11, FBN['RB8'])
          
      Message ('Calculando interes .... ')                  

      *- z24: Interes de Contraparte
      ACN(z24, ((FBN['Cantidad2']*(Dialogo.Precio2+FBN['Total4']))/100)*FACTORDIAS(FBN['Fecha5'],FBN['Fecha6'],FBN['RB8']+1))

      *- z25: Tasa del Vehiculo z26: Interes del Vehiculo z27: Diferencia
      ACN(z25,Dialogo.Precio2)

      IF Dialogo.Precio2>FBN['PrecioEj'] y EqStr(FBN['TipoOp'],'DTCAP') 
         ACN(z25,FBN['PrecioEj'])
      EndIf
      IF Dialogo.Precio2<FBN['PrecioEj'] y EqStr(FBN['TipoOp'],'DTFLO') 
         ACN(z25,FBN['PrecioEj'])
      EndIf

      ACN(z26, ((FBN['Cantidad1']*(val(z25)+FBN['Total3']))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))

      If EqStr(FBN['TipoOp'],'DTCAP') 
         ACN(z27,-val(z26)+val(z24))
      Else
         ACN(z27,+val(z26)-val(z24))
      EndIf

           
      Message('Actualizando la operacion  .... Resultado '~Fstr(val(z27),0,2))                  

      SQL.ADD("UPDATE "~DBO~".CUOTAS ")
      SQL.ADD("SET    Check1 = '1', ")
      SQL.ADD("Fecha4  = '"~IdxDate(Dialogo.Fecha2)~"',")
      SQL.ADD("Total2  = "~Fstr(VAL(z27),0,2)~",")      
      SQL.ADD("Precio2 = "~Fstr(Dialogo.Precio2,0,7)~",")
      SQL.ADD("Precio1 = "~Fstr(val(z25),0,7)~", ")       
      SQL.ADD("Cantidad4 = "~Fstr(val(z24),0,7)~",")
      SQL.ADD("Cantidad3 = "~Fstr(val(z26),0,7)~" ")
      SQL.ADD("WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("      and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
      SQL.ADD("      and Check1='0' ")
      SQL.NEW
      SQL.EXEC

      ACT(or1,BuscarCampo('Operaciones','OperacionRef','NrOperacion',Dialogo.NrOperacion1)) 

      IF NoVacio(val(or1))
         *- Si el vehiculo es variable
         EjecutarEvento('TTNOP',NrOperacion1=val(or1),Entero1=0,NrOperacion2=Dialogo.NrOperacion1,Lista1=Fstr(Dialogo.Entero1,0,0)~'|')
      EndIf
        
      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)            
       
      *** Actualiza movimientos y limites ****
      SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
      SQL.EXEC
   Proximo
           
   If Val(x1)=0
      Cancelar('La operacion Nro.'~Dialogo.NrOperacion1~' No puede ser Ejercida')
   Endif
Endif
