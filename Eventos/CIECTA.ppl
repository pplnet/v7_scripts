   Cuenta1  : 'Cuenta'           ;1;1;;;;
   String1  : 'Nombre'           ;1;2;;NO;;;;;;BuscarCampo('CUENTAS','Nombre','Codigo',Dialogo.Cuenta1);;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'  
   String2  : 'Estado'           ;2;2;;NO;;;;;;BuscarCampo('CUENTAS','Estado','Codigo',Dialogo.Cuenta1)
