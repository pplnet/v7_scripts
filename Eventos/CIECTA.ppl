endif
   
message('Cuenta comitente '~val(b:&i)~' habilitada')
SQL.ADD("UPDATE "~DBO~".CUENTAS ")
SQL.ADD("SET Estado = 'CER', FechaEstado= "~IdxDate2(Dialogo.Fecha1)~"")
