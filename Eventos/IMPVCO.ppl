CrearDialogo
  Fecha1:    'F.Liquid'  ;;;;;;;;;Fsys
  Mercado1:  'Mercado';
  Check1:    'Reimpresion'
FinDialogo

if not Ok
  Cancelar
endif

SQL.ADD(" Select V.*,E. Nombre, C.RazonSocial ")
SQL.ADD("   from "~DBO~".VOUCONSOLIDADOS V, "~DBO~".ESPECIES E, "~DBO~".CLIENTES C ")
SQL.ADD("  where V.Especie = E.Codigo      ")
SQL.ADD("    and V.Cliente = C.Codigo      ")
SQL.ADD("    and V.Fecha="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("    and V.MontoADebCred=V.MontoDebCred")

If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and V.Mercado = '"~Dialogo.Mercado1~"' ")
endif
If Dialogo.Check1=0
   SQL.ADD(" and (V.Impreso is Null or V.Impreso=0) ")
Else
   SQL.ADD(" and (V.Impreso =1) ")
Endif

watch(SQL.BATCH())
Recorrer SQL
   ACN(az:fac, 1)   
   ACT(aa:fac, FBN['Id'])   
   ACT(ab:fac, FBN['Cliente'])
   ACT(ac:fac, FBN['RazonSocial'])   
   ACT(ad:fac, FBN['Especie'])   
   ACT(ae:fac, FBN['Cuenta'])   
   ACN(af:fac, FBN['MontoDebCred'])   
   ACT(ag:fac, FBN['Mercado'])  
   ACT(ah:fac, FBN['Impreso'])  
   ACT(ai:fac, FBN['Referencia'])  
   SCN(z1,1)
   ACN(x1,fac) 
Proximo

if Val(z1)=0
  Cancelar('No existen Vouchers para imprimir')
else
  ACO(1,9)
  ACO(2,15)
  ACO(3,15)
  ACO(4,7)
  ACO(5,11)
  ACO(6,15)
  ACO(7,15)
  ACO(8,7)
  FormatoCeldas(f1..f:Val(z1),Exe('F2'))
  FormatoCeldas(g1..g:Val(z1),Exe('F2'))
        
  CrearListBox;'Arial,8,';'Operaciones Mercado no Neteado '
    'Mod.'       ;az:1..az:Val(x:1);SI;;; 50;CHECK ;RGB(160,160,193)
    'Mov'        ;aa:1..aa:Val(x:1);NO;;; 70;STRING;;RGB(250,250,193)
    'Cliente'    ;ab:1..ab:Val(x:1);NO;;; 80;STRING;;RGB(250,250,193)
    'Nombre'     ;ac:1..ac:Val(x:1);NO;;;200;STRING;;RGB(250,250,193)
    'Especie'    ;ad:1..ad:Val(x:1);NO;;; 60;STRING;;RGB(250,250,193)
    'Cuenta'     ;ae:1..ae:Val(x:1);NO;;; 80;STRING;;RGB(250,250,193)
    'Monto'      ;af:1..af:Val(x:1);NO;;;100;NUMERO;'##,###,###.##';RGB(250,250,193)
    'Mercado'    ;ag:1..ag:Val(x:1);NO;;; 50;STRING;;RGB(250,250,193)
    'Impreso'    ;ah:1..ah:Val(x:1);NO;;; 50;STRING;;RGB(250,250,193)
    'Referencia' ;ai:1..ai:Val(x:1);NO;;;300;STRING;;RGB(250,250,193)
  FinListBox
        
  if Ok
    Recorrer&i 1,Val(x:1)
      If val(az:&i)=1
         SQL.ADD("SELECT T.NrTrans From TRANSACCIONES2 T ")
         SQL.ADD(" Where NrTrans in("~Pipe2Comillas(Val(ai:&i))~") ")
         SQL.ADD("   and Cantidad26=0 ")
         watch(SQL.BATCH())
         Recorrer SQL
            act(y:1,Val(ai:&i))            
            If EqStr(Val(ah:&i),'') o EqStr(Val(ah:&i),'0') o Vacio(Val(ah:&i))
               LinkearHoja('EVOUV1',1,NrTrans1=FBN['NrTrans'],Check1=0,Check3=0,String=Val(y:1))
            else
               LinkearHoja('EVOUV1',1,NrTrans1=FBN['NrTrans'],Check1=1,Check3=0,String=Val(y:1))
            endif
            * Marca de ya impreso  
            If [EqStr(Val(ah:&i),'') o EqStr(Val(ah:&i),'0')]
               SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
               SQL.ADD("   Set  CB1 = '1' ") 
               SQL.ADD(" Where NrTrans in("~Pipe2Comillas(Val(ai:&i))~") ")
               SQL.NEW

               SQL.ADD("Update "~DBO~".VOUCONSOLIDADOS ")
               SQL.ADD("   Set    Impreso = '1' ") 
               SQL.ADD(" Where Id ="~FSTR(val(aa:&i),1,0))
               SQL.NEW
               SQL.EXEC 
             Endif     
         Proximo
      Endif     
    Proximo
  endif
endif  
