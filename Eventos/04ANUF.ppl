MostrarCuadroDeMensajes

CrearDialogo
    Fecha1:       'Fecha Liquid'  ;;;;;;;;;Fsys
    Check2   :    'Interfase'     ;;;;NO;NO;;;;1;
FinDialogo
if Not OK
  Cancelar
endif


SQL.ADD("SELECT T.Cliente1, T.Mercado1, T.TipoTr2, T.Especie, T.Especie1, T.cantidad11, ")
SQL.ADD("       T.Cantidad1, T.Cantidad2, T.NrTrans, T.Fecha2, T.Fecha1, T.Cuenta1      ") 
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS  OB                     ") 
SQL.ADD("Where OB.NrOperacion = T.NrTrans                                               ")
SQL.ADD("  and T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"'                                 ")
SQL.ADD("  and (( OB.NrBit in ('3','6','14') AND OB.Valor=1 )  OR                       ")
SQL.ADD("       ( OB.NrBit in ('70')    AND OB.Valor=1 AND T.TipoTr2='COMP') )          ")
SQL.ADD("  and (T.CB9 is null or T.CB9 = 0)                                             ")
SQL.ADD("  and T.TipoTr2 IN ('DEP','RET','COMP','MATCH')                                ")
SQL.ADD("  and T.Mercado1 not in("~Pipe2Comillas(VAR('MERCAACMC'))~")                   ")
SQL.ADD("  and IsNull(T.Ley4,'') Not In ("~Pipe2Comillas(VAR('RUECPC1'))~")             ")
SQL.ADD("  Order By T.NrTrans                                                           ")
watch(SQL.BATCH())

ACN(ok1,0)

Recorrer SQL
  ACN(ok1,1)
  ACT(a:FAC, FBN['Cliente1'])
  ACT(b:FAC, FBN['Mercado1'])
  ACN(l:FAC, 0 )

  if EqStr(FBN['TipoTr2'],'MATCH')
    ACT(d:FAC, 'Matcheo')
    ACT(e:FAC, FBN['Especie']~'/'~FBN['Especie1'])
    ACN(f:FAC, -FBN['Cantidad1'])
    ACN(g:FAC, -FBN['Cantidad2'])

  else
    if Incluido(FBN['TipoTr2'],'DEP|RET')
       ACT(e:FAC, FBN['Especie'])
       if EqStr(FBN['TipoTr2'],'DEP')
          ACT(d:FAC, 'Cobro')
          if DesciendeDeEspecie(FBN['Especie'],'TITULO')
             ACN(f:FAC, FBN['Cantidad1'])
             ACN(g:FAC, 0)
          else
             ACN(f:FAC, 0)
             ACN(g:FAC, FBN['Cantidad1'])
          endif
       else
          ACT(d:FAC, 'Pago')
          if DesciendeDeEspecie(FBN['Especie'],'TITULO')
             ACN(f:FAC, -FBN['Cantidad1'])
             ACN(g:FAC, 0)
          else
             ACN(f:FAC, 0)
             ACN(g:FAC, -FBN['Cantidad1'])
          endif
       endif
    else
      ACT(d:FAC, '   ')
    endif
  endif

  ACT(i:FAC, FBN['NrTrans'])
  ACD(j:FAC, FBN['Fecha2'])
  ACD(k:FAC, FBN['Fecha1'])
  ACT(m:FAC, FBN['Cuenta1'])
  ACT(n:FAC, FBN['TipoTr2'])
  ACN(o:FAC, FBN['Cantidad1'])
  ACN(p:FAC, FBN['Cantidad11'])

#ifdef BIND
  SQL.ADD("SELECT Id,Referencia, Estado FROM "~DBO~".VOUCONSOLIDADOS WHERE Referencia Like '%"~FBN['NrTrans']~"|%'")
  watch(SQL.BATCH())
  Recorrer SQL
    dfa
    ACT(q:FAC, FBN['Id'])
    ACT(r:FAC, FBN['Referencia'])
    ACT(s:FAC, FBN['Estado'])
  Proximo
#endif
  scn(x:102,1)
Proximo

IF Val(ok1) = 0
   Cancelar(' No existen Vouchers para anular en esta Fecha ')
ENDIF


CrearListBox ; 'Arial,8,';'Anulacion Manual de VOUCHERS para la fecha '~Dialogo.Fecha1

   'OK'                 ;l:1..l:Fac   ;SI;;;40 ;CHECK;
   'Cliente '           ;a:1..a:Fac   ;NO;;;80 ;STRING;;
   'Mercado '           ;b:1..b:Fac   ;NO;;;70 ;STRING;;
    '        '          ;d:1..d:Fac   ;NO;;;70 ;STRING;;
   'Especie '           ;e:1..e:Fac   ;NO;;;70 ;STRING;;
   'Titulos '           ;f:1..f:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Moneda  '           ;g:1..g:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Voucher '           ;i:1..i:Fac   ;NO;;;70 ;STRING;;
   'Fecha ingreso '     ;k:1..k:Fac   ;NO;;;80 ;FECHA;;
   'Fecha Cob/Pag '     ;j:1..j:Fac   ;NO;;;80 ;FECHA;;
#ifdef BIND
   'Id'                 ;q:1..q:Fac   ;NO;;;80 ;STRING;;
   'Referencia'         ;r:1..r:Fac   ;NO;;;180;STRING;;
#endif
   

FinListBox

IF NOT OK 
   Cancelar
else
   Recorrer&i 1, val(x:102)
      If val(l:&i) = 1
         Recorrer&j 1, Elementos(val(r:&i))
            * ver si es -1
            ACT(x:100,ItemLista(val(r:&i),&j))
            ACN(x:101,0)
            Recorrer&k 1, val(x:102)
                If val(l:&k) = 1 y Eqstr(Val(i:&k),val(x:100))
                   acn(x:101,1)
                   break
                Endif
            Proximo
            if val(x:101)=0
               Cancelar("El Voucher "~Val(x:100)~" debe ser cancelado en el siguiente grupo "~val(r:&i))
            endif
         Proximo
      Endif
   Proximo
   
ENDIF

Recorrer&i 1,Fac

  if Val(l:&i) = 1 
    Message(' Anulando Voucher '~Val(i:&i) )
    EjecutarEvento('04ANUV', NrTrans1=Val(i:&i), Check3=1, Check2=1,Fecha1=Dialogo.Fecha1)
    If DesciendeDeEspecie(Val(e:&i),'MONEDA') y Eqstr(Val(b:&i),VAR('MERCADOBT'))
      #ifdef BIND
       IF Eqstr(val(s:&i),'OK')
        * Parámetros Salida
        * RR:1  'OK/NOK  
        * RR:2  'Mensaje'  

        * Parámetros entrada
        * RR:10  'Referencia'  
        * RR:11  'Sucursal'  
        * RR:12  'Cuenta(1a7)'    
        * RR:13  'SubOperacion-Cuenta (9a10)'
        * RR:14  'Moneda'
        * RR:15  'Importe'
        * RR:16  'Observaciones'
        * RR:17  'Importe a Bloquear'
        * RR:18  'Importe a Debitar / Acreditar'
        * RR:19  'Cliente'
        * RR:20  'Cuenta'
        * RR:21  'Especie'
        * RR:22  'Importe Bloqueado'
        * RR:23  'Importe Debitado / Acreditado'
        * RR:24  'Tipo operacion'
        * RR:25  'Mercado'
        * RR:26  'Tipo Transferencia'
        * RR:27  'Capital'
        * RR:28  'Comisiones'
        * RR:29  'Derechos'
        * RR:30  'Iva'
        * RR:31  'Intereses'
        * RR:32  'Cod Evento (producto)'
        * RR:33  'Fecha Valor'
        * RR:34  'Referencia Corte'
        * RR:35  'Referencia Acciones'
        * RR:36  'Transaccion'
        * RR:37  'Fecha Cont'
        * RR:38  'Modulo' 
        * RR:39  'Relacion'
        * RR:40  'Tipo: 1 Resta_Liquidacion/'
        * RR:41  'Referencia CAMEST'
        * RR:47  'Capital Accion'
        * RR:48  'Comisiones Accion'
        * RR:49  'Derechos Accion'
        * RR:50  'Iva Accion'
        * RR:51  'Intereses Accion'
        * RR:57  'Capital Cupon'
        * RR:58  'Comisiones Cupon'
        * RR:59  'Derechos Cupon'
        * RR:60  'Iva Cupon'
        * RR:61  'Intereses Cupon'
        * RR:67  'Capital Camest'
        * RR:68  'Comisiones Camest'
        * RR:69  'Derechos Camest'
        * RR:70  'Iva Camest'
        * RR:71  'Intereses Camest'
      
        * Cliente / Especie / Cuenta / 
        IF Not Eqstr(val(a:&i)~val(e:&i)~val(m:&i),val(bz:1)) y NoVacio(val(bz:1))
           *  Interfase Bantotal
           BorrarCeldas(rr:1..rr:50)
           ACT(rr:10, Val(br:val(bz:2)))
           ACT(rr:12, Copy(Val(bh:val(bz:2)),1,7))
           ACT(rr:13, Copy(Val(bh:val(bz:2)),9,2))
           ACN(rr:17, Val(bw:val(bz:2)))
           ACN(rr:18, Val(bf:val(bz:2)))
           ACT(rr:19, Val(by:val(bz:2)))
           ACT(rr:20, Val(bh:val(bz:2)))
           ACT(rr:21, Val(bb:val(bz:2)))
           ACT(rr:25, Val(b:&i))
           ACT(rr:26, 'ANUEPA')
           ACT(rr:27, '0')
           ACT(rr:28, '0')
           ACT(rr:29, '0')
           ACT(rr:30, '0')
           ACT(rr:31, '0')
           ACT(rr:32, '0')
           ACT(rr:32, '2')
           ACT(rr:33, Dialogo.Fecha1)

           SQL.ADD("SELECT * FROM "~DBO~".VOUCONSOLIDADOS WHERE Id="~FSTR(val(bq:val(bz:2))))
           Recorrer SQL
              dfa
              act(rr:11, FBN['Sucursal'])
              act(rr:34, FBN['RefCorte'])
              act(rr:35, FBN['RefAccion'])
              act(rr:41, FBN['RefCamest'])
              act(rr:36, FBN['Transaccion'])
              act(rr:37, FBN['FechaCont'])
              act(rr:38, FBN['Modulo'])
              act(rr:39, FBN['Relacion'])
              
              act(rr:57, FBN['CapCupon'])
              act(rr:47, FBN['CapAccion'])
              act(rr:67, FBN['CapCamest'])
              act(rr:58, FBN['ComCupon'])
              act(rr:48, FBN['ComAccion'])
              act(rr:68, FBN['ComCamest'])
              act(rr:59, FBN['DerCupon'])
              act(rr:49, FBN['DerAccion'])
              act(rr:69, FBN['DerCamest'])
              act(rr:60, FBN['IvaCupon'])
              act(rr:50, FBN['IvaAccion'])
              act(rr:70, FBN['IvaCamest'])
              act(rr:61, FBN['IntCupon'])
              act(rr:51, FBN['IntAccion'])
              act(rr:71, FBN['IntCamest'])

              act(rr:9, FBN['Id'])
           Proximo
           
           if Val(bw:val(bz:2))<>0
              * Desbloqueo de Saldo
              ACN(rr:15, ABS(Val(bw:val(bz:2))))
              ACT(rr:27, val(rr:15))
              if Dialogo.Check2=1
                 (.'BLOQSALCTA'.)
                 if Eqstr(Val(rr:1),'OK')
                    acn(rr:22, val(rr:17))
                 endif
              else
                 act(rr:1,'OK')
                 acn(rr:22, val(rr:17))
                 Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
              endif   
           else
              act(rr:1,'OK')
           endif
           (.'ANULMOVCON'.)    
           * Resta la liquidacion de Ops
           if NoVacio(Trim(val(rr:34))~Trim(val(rr:35))~Trim(val(rr:41)))
              ACN(rr:40,1)
              (.'DESDVOUCON'.)    
           endif
           SCN(bz:2,1)   
           ACN(bz:3,1)   
        endif
        ACN(bq:val(bz:2), Num(val(q:&i)))
        ACT(bh:val(bz:2), Val(m:&i))
        ACT(br:val(bz:2), val(br:val(bz:2))~Val(i:&i)~'|')
        ACT(by:val(bz:2), Val(a:&i))
        ACT(bb:val(bz:2), Val(e:&i))                       
        if Eqstr(Val(n:&i),'RET')
           SCN(bf:val(bz:2), -Val(o:&i))
        else
           SCN(bf:val(bz:2), Val(o:&i))
        endif   
        SCN(bw:val(bz:2), Val(p:&i))
        * Lista de Vouchers
        ACT(bu:val(bz:3), Val(i:&i))
        SCN(bz:3,1)
        act(bz:1,val(a:&i)~val(e:&i)~val(m:&i))
       else 
        SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS         ")
        SQL.ADD("   Set       Estado='ANU'              ")
        SQL.ADD(" WHERE Id="~FSTR(Val(q:&i),1,0)         )
        SQL.NEW

        SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS         ")
        SQL.ADD(" WHERE NrOperacion='"~FSTR(Val(q:&i),1,0)~"'" )
        SQL.NEW
        
        SQL.EXEC
       Endif  
      #endif
    Endif          
  Endif

Proximo
If DesciendeDeEspecie(Val(e:&i),'MONEDA') y Eqstr(Val(b:&i),VAR('MERCADOBT'))
  #ifdef BIND
   IF Eqstr(val(s:&i),'OK')
  
    * Parámetros Salida
    * RR:1  'OK/NOK  
    * RR:2  'Mensaje'  

    * Parámetros entrada
    * RR:10  'Referencia'  
    * RR:11  'Sucursal'  
    * RR:12  'Cuenta(1a7)'    
    * RR:13  'SubOperacion-Cuenta (9a10)'
    * RR:14  'Moneda'
    * RR:15  'Importe'
    * RR:16  'Observaciones'
    * RR:17  'Importe a Bloquear'
    * RR:18  'Importe a Debitar / Acreditar'
    * RR:19  'Cliente'
    * RR:20  'Cuenta'
    * RR:21  'Especie'
    * RR:22  'Importe Bloqueado'
    * RR:23  'Importe Debitado / Acreditado'
    * RR:24  'Tipo operacion'
    * RR:25  'Mercado'
    * RR:26  'Tipo Transferencia'
    * RR:27  'Capital'
    * RR:28  'Comisiones'
    * RR:29  'Derechos'
    * RR:30  'Iva'
    * RR:31  'Intereses'
    * RR:32  'Cod Evento (producto)'
    * RR:33  'Fecha Valor'

    * Cliente / Especie / Cuenta / 
    *  Interfase Bantotal
    BorrarCeldas(rr:1..rr:50)
    ACT(rr:10, Val(br:val(bz:2)))
    ACT(rr:12, Copy(Val(bh:val(bz:2)),1,7))
    ACT(rr:13, Copy(Val(bh:val(bz:2)),9,2))
    ACN(rr:17, Val(bw:val(bz:2)))
    ACN(rr:18, Val(bf:val(bz:2)))
    ACT(rr:19, Val(by:val(bz:2)))
    ACT(rr:20, Val(bh:val(bz:2)))
    ACT(rr:21, Val(bb:val(bz:2)))
    ACT(rr:25, Val(b:&i))
    ACT(rr:26, 'ANUEPA')
    ACT(rr:27, '0')
    ACT(rr:28, '0')
    ACT(rr:29, '0')
    ACT(rr:30, '0')
    ACT(rr:31, '0')
    ACT(rr:32, '0')
    ACT(rr:32, '2')
    ACT(rr:33, Dialogo.Fecha1)
    SQL.ADD("SELECT * FROM "~DBO~".VOUCONSOLIDADOS WHERE Id="~FSTR(val(bq:val(bz:2))))
    Recorrer SQL
      dfa
      act(rr:11, FBN['Sucursal'])
      act(rr:34, FBN['RefCorte'])
      act(rr:35, FBN['RefAccion'])
      act(rr:41, FBN['RefCamest'])
      act(rr:36, FBN['Transaccion'])
      act(rr:37, FBN['FechaCont'])
      act(rr:38, FBN['Modulo'])
      act(rr:39, FBN['Relacion'])
      
      act(rr:57, FBN['CapCupon'])
      act(rr:47, FBN['CapAccion'])
      act(rr:67, FBN['CapCamest'])
      act(rr:58, FBN['ComCupon'])
      act(rr:48, FBN['ComAccion'])
      act(rr:68, FBN['ComCamest'])
      act(rr:59, FBN['DerCupon'])
      act(rr:49, FBN['DerAccion'])
      act(rr:69, FBN['DerCamest'])
      act(rr:60, FBN['IvaCupon'])
      act(rr:50, FBN['IvaAccion'])
      act(rr:70, FBN['IvaCamest'])
      act(rr:61, FBN['IntCupon'])
      act(rr:51, FBN['IntAccion'])
      act(rr:71, FBN['IntCamest'])
      
      act(rr:9, FBN['Id'])
    Proximo
   
    if Val(bw:val(bz:2))<>0
      * Desbloqueo de Saldo
      ACN(rr:15, ABS(Val(bw:val(bz:2))))
      ACT(rr:27, val(rr:15))
      if Dialogo.Check2=1
         (.'BLOQSALCTA'.)
         if Eqstr(Val(rr:1),'OK')
            acn(rr:22, val(rr:17))
         endif
      else
         act(rr:1,'OK')
         acn(rr:22, val(rr:17))
         Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
      endif   
    else
      act(rr:1,'OK')
    endif   
    (.'ANULMOVCON'.)    
    * Resta la liquidacion de Ops
    if NoVacio(Trim(val(rr:34))~Trim(val(rr:35))~Trim(val(rr:41)))
       ACN(rr:40,1)
       (.'DESDVOUCON'.)    
    endif
    SCN(bz:2,1)   
    ACN(bz:3,1)   
   else 
    SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS         ")
    SQL.ADD("   Set       Estado='ANU'              ")
    SQL.ADD(" WHERE Id="~FSTR(Val(q:&i),1,0)         )
    SQL.NEW
    SQL.EXEC
   endif
  #endif
Endif          
