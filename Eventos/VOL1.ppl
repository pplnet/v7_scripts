**HojaVisible(SI)
CrearDialogo
   Fecha1    : 'Fecha'    ;;;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
   Lista1    : 'Especies' ;;;;;;NoVacio(Dialogo.Lista1);'Debe seleccionar una Especie';NO;;;SQLSet("Select Codigo  from "~DBO~".ESPECIES where Status = 'HAB' and (Fecha> '"~IdxDate(Dialogo.Fecha1)~"' or Fecha is null   ) and  "~DBO~".EsTerminalEspecie(Codigo)=1   ")
FinDialogo

IF NOT OK
   Cancelar
Endif

SetFilaActual(1)

Recorrer&i 1, Elementos(Dialogo.Lista1)
   ACN(a:&i,1)
   ACT(c:&i,ItemLista(Dialogo.Lista1,&i))
   ACT(d:&i,BuscarCampo('ESPECIES','Extendido','Codigo',Val(c:&i)))
   ACT(k:&i,SQL("Select 1 FROM "~DBO~".VOLATILIDADESPECIE where Especie='"~Val(c:&i)~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
Proximo

SetFilaActual(Elementos(Dialogo.Lista1))

CrearListBox ; 'Arial,8,';'Volatidad Manual'
   'OK'                ;a:1..a:Fac ;;;;40;CHECK;RGB(255,255,213)
   'Metodo'            ;b:1..b:Fac ;;;;90 ;COMBO;'Manual|STD|';RGB(180,180,193)
   'Especie '          ;c:1..c:Fac ;NO;;;60 ;STRING;;
   'Nombre Extendido ' ;d:1..d:Fac ;NO;;;60 ;STRING;;
   'Ruedas Max.'       ;e:1..e:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Ruedas Min.'       ;f:1..f:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Ruedas Utilizadas.';g:1..g:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'
   'Volatidad'         ;h:1..h:Fac ;  ;Val(h:FLB)>=0;'La Volatilidad debe ser mayor a 0';100;NUMERO;'###,###,###,###.########';RGB(255,255,213)
   'Volatidad Origen'  ;i:1..i:Fac ;NO;;;100;NUMERO;'###,###,###,###.##'   
   'Zona'              ;j:1..j:Fac ;  ;Val(h:FLB)>=0;'La Zona debe ser mayor a 0';100;NUMERO;'###,###,###,###.########';RGB(255,255,213)
   *'Existe'            ;k:1..k:Fac ;NO;;;60 ;STRING;;
FinListBox

IF NOT OK
   Cancelar
Endif

Recorrer&j 1, Elementos(Dialogo.Lista1)
   If Val(a:&j)=1
      If Val(b:&j)=1 
         ACT(b:&j,'STD')
      Else
         ACT(b:&j,'MAN')
      EndIf
      If EQSTR(Val(k:&j),'1')
         SQL.ADD(" Update  "~DBO~".VOLATILIDADESPECIE ")
         SQL.ADD(" set  Volatilidad="~Val(h:&j)~",Zona="~Val(j:&j)~" ,FechaActualizacion='"~IdxDate(SQLAHORA)~' '~Hora(Ahora)~"'     ")
         SQL.ADD("  where Especie='"~Val(c:&j)~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"'   ")
         SQL.NEW
         SQL.EXEC
      Else
         SQL.ADD(" Insert  "~DBO~".VOLATILIDADESPECIE ")
         SQL.ADD(" (Fecha,Especie,Tipo,Metodo,Modo,FechaActualizacion,Volatilidad,VolatilidadOriginal,RuedasMax,RuedasMin,EspecieRef,Zona) ")
         SQL.ADD("  Values  ")
         SQL.ADD("  ('"~IdxDate(Dialogo.Fecha1)~"','"~Val(c:&j) ~"','"~Val(b:&j)~"','MANUAL','','"~IdxDate(SQLAHORA)~' '~Hora(Ahora)~"',"~Val(h:&j)~",0,0,0,'',"~Val(j:&j)~") ")
         SQL.NEW
         SQL.EXEC
      EndIf
   EndIf
Proximo


