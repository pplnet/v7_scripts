HojaVisible(SI)
GrillaVisible(NO)
CrearDialogo
   NrTrans1: 'Nrtrans' ;;;;;;;;;;;;;;;;;;;;;
FinDialogo

If Not OK
   Cancelar
EndIf

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(8)
AgregarBMP(b:fac,Exe('LOGO'),Exe('ESCALOGO'))

SetFilaActual(fac+7)
ACN(fi1, fac)
ACT(g:fac, 'Buenos Aires, '~FStr(Dia(FSYS),0,0)~' de '~Meses(FSYS)~' de '~FStr(Anio(FSYS), 0,0))

SetFilaActual(fac+3)
ACT(b:fac, 'Senores')
ACT(b:fac+1, 'Mercado Abierto Electronico')
ACT(b:fac+2, 'PRESENTE')

ACT(b:fac+6, 'De nuestra consideracion:')

ACN(za1, BuscarCampo('TRANSACCIONES2','Cantidad1','NrTrans',Dialogo.NrTrans1))

ACT(b:fac+8, '                        Informamos a Uds. que segun lo dispuesto por el Articulo 14.2 del Reglamento')
ACT(b:fac+9, 'Operativo hemos procedido a acreditar $'~PYC(Val(za1),1,2)~'.- ')
ACT(b:fac+10, '(Pesos '~Letras(Val(za1),0,100)~')')
ACT(b:fac+11, 'en la cuenta OCT-MAE MTM correspondiente a la liquidacion del MTM Multilateral de esta entidad.')

SetFilaActual(fac+11)
ACT(b:fac+3,'                         Sin otro particular, saludamos a Uds. muy atentamente.')

SetFont(a:Val(fi1)..i:fac+5, 1)
ACO(1,8)
SetFilaActual(fac+11)
LimitesVision(k:fac)
Impresion(3,0)
Impresion(2,0)
