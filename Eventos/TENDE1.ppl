CrearDialogo
  Especie1    :'Especie'      ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe Ingresar una Especie Valida';NO;
  Fecha1      :'Record_Date'  ;1;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha valida ';NO;FSys
  Cliente1    :'Cliente'      ;2;1;;;;[Vacio(Dialogo.Cliente1)] O [Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI') Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB') Y Not Eqstr(BuscarCampo('CLIENTES','BloqueoFondos','Codigo',Dialogo.Cliente1), 'SI')];'Cliente invalido';NO;;;;;;" CategDepositante='CLI' AND Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) ";
  Fecha2      :'Fecha_Pago'   ;2;2;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1;'Debe Ingresar una Fecha valida ';NO;FSys
  Especie2    :'Moneda'       ;3;1;;;;NoVacio(Dialogo.Especie2) y DesciendeDeEspecie(Dialogo.Especie2,'MONEDA');'Debe Ingresar una Moneda Valida';NO;'ARP';;'ARP|USD|';;;" Codigo IN ( "~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
  Radio1      :'Tipo|Exterior|Local|';3;2;2;NO;NO;;;;;0  
  Mercado1    :'Mercado'      ;4;1;;;;
  Precio1     :'Porcentaje'   ;5;1;;;;Dialogo.Precio1 > 0;'Porcentaje Invalido';
  Vehiculo1   :'Vehiculo'     ;6;1;;;;NOVACIO(Dialogo.Vehiculo1);'Debe Ingresar el vehículo';NO;VAR('VEHICULODE');
  Operador1   :'Operador'     ;7;1;;NO;;NOVACIO(Dialogo.Operador1);'Debe Ingresar el Operador';NO;USUARIOACTIVO
  Especie3    :'Moneda Gastos';3;2;;  ;;NoVacio(Dialogo.Especie3);;;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|'
  Cantidad3   :'W.H.T.'       ;4;2;;  ;;Dialogo.Cantidad3>=0;'With Holding Tax Debe Ser Mayor que Cero ';NO
  Cantidad4   :'GASTOS'       ;5;2;;  ;;Dialogo.Cantidad4>=0;'Los Gastos Debe Ser Mayor que Cero';NO
  Cantidad5   :'IVA Gastos'   ;6;2;;  ;;Dialogo.Cantidad5>=0;'El IVA Debe Ser Mayor que Cero'    ;NO;;Dialogo.Cantidad4 * Dialogo.Precio2/100
  Cantidad6   :'Tot.Gastos'   ;7;2;;NO;;Dialogo.Cantidad6>=0;'El Tot. de Gastos debe ser positivo';NO;;Dialogo.Cantidad4 + Dialogo.Cantidad5
  Precio2     :'%IVA BOSEC'   ;8;2;;NO;NO;;;;21

FinDialogo

if Not Ok
  Cancelar
endif

EjecutarEvento('RESGLN', Especie1=Dialogo.Especie1, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Cliente1=Dialogo.Cliente1, Especie2=Dialogo.Especie2, Mercado1=Dialogo.Mercado1 ,Precio1=Dialogo.Precio1, Operador1=Dialogo.Operador1 ,Vehiculo1=Dialogo.Vehiculo1, Radio1=Dialogo.Radio1, Cantidad3=Dialogo.Cantidad3, Cantidad4=Dialogo.Cantidad4, Cantidad5=Dialogo.Cantidad5, Cantidad6=Dialogo.Cantidad6, Especie3=Dialogo.Especie3)