*ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1   : 'Fecha'                    ;;;;;;;;;FSys
   Fecha2   : 'FechaHta'                 ;;;;;;;;;Dialogo.Fecha1;Dialogo.Fecha1
   Cliente1 : 'Cliente'                  ;3;1;;SI;SI
   Cantidad1: 'Monto Minimo'             ;;;;;NO;;;;
   Radio2   : "Salida|Informe|Inf+TXT"   ;4;;;;;;;;1
   String1  : 'Path'                     ;;;;NO;Dialogo.Radio2=1;;;;VAR('PATHBCRA');
   String2  : 'Operaciones SOS'          ;;;;NO;Dialogo.Radio2=1;;;;'LAVOPER_'~Fecha(Dialogo.Fecha1,'YYYYMMDD')~'.TXT';'LAVOPER_'~Fecha(Dialogo.Fecha1,'YYYYMMDD')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!'
   String3  : 'Clientes SOS'             ;;;;NO;Dialogo.Radio2=1;;;;'LAVCTAS_'~Fecha(Dialogo.Fecha1,'YYYYMMDD')~'.TXT';'LAVCTAS_'~Fecha(Dialogo.Fecha1,'YYYYMMDD')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!'
   Check1   : 'Saldo 81|SI|NO'           ;;;;NO;NO;;;;1;
FinDialogo
**VAR('MONTOBCRA')
If Not OK
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


If Dialogo.Radio2=1 y Not ExisteDirectorio(Dialogo.String1)
   Messagebox('No existe el path '~Dialogo.String1~'. Debera crearlo.')
   Cancelar
Endif

Message(' - Borrando Archivos SOS')

* Borro Archivos Anteriores
IF Dialogo.Radio2=1 y ExisteArchivo(Dialogo.String1~Dialogo.String2) 
   WinExec('CMD.EXE /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   Esperar(5)
EndIf

IF Dialogo.Radio2=1 y ExisteArchivo(Dialogo.String1~Dialogo.String3) 
   WinExec('CMD.EXE /C DEL '~Dialogo.String1~Dialogo.String3, 0)
   Esperar(5)
EndIf

* Creo el archivo 
IF Dialogo.Radio2=1 
   ACT(aa1, Dialogo.String1~Dialogo.String2)
   Message('Creando Archivo '~Dialogo.String2)
   AbrirASCII(val(aa1),0)
EndIf

ACT(yy:4,'Interfase Lavado de Dinero SOS')
ACT(yy:5,'LAVDIN')
** Incluir control en Mov Monedas que la cuenta sea con Comitente=Vehiculo
**  Depositos Plazo Fijo
SQL.ADD("SELECT 1 as TP, '"~VAR('OPDEPTIT')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT,  ")
SQL.ADD(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.Cantidad*Precio3 Monto, C.Sucursal, O.FechaOP FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
SQL.ADD(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
SQL.ADD("     LEFT JOIN dbo.CUENTAS CU on O.Cuenta1=CU.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ") 
SQL.ADD("     LEFT JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
SQL.ADD("WHERE  O.TipoOp in ('TIDE') ")
SQL.ADD("       and B.Valor='1' and B.NrBit not in (30) ")
**SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ') and C.CategDepositante='CLI'  ")
SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ')   ")
SQL.ADD("       and (O.FechaOP >= "~IdxDate2(Dialogo.Fecha1)~" and O.FechaOP<="~IdxDate2(Dialogo.Fecha2)~" )")
SQL.ADD("UNION")
** Pases Pasivos Titulos (Moneda)
SQL.ADD("SELECT 1 as TP, '"~VAR('OPPPASTI')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT,  ")
SQL.ADD(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.TotalNetoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
SQL.ADD(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
SQL.ADD("     LEFT JOIN dbo.CUENTAS CU on O.Cuenta1=CU.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion ")
SQL.ADD("     LEFT JOIN "~DBO~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ") 
SQL.ADD("     LEFT JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
SQL.ADD("WHERE  O.TipoOp in ('TIC','TIFV')  and PaseCB=1 ")
SQL.ADD("       and B.Valor='1' and B.NrBit not in (30) ")
**SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ') and C.CategDepositante='CLI'  ")
SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ')   ")
SQL.ADD("       and  (MO.FechaEje >= "~IdxDate2(Dialogo.Fecha1)~" and MO.FechaEje<="~IdxDate2(Dialogo.Fecha2)~" )")
SQL.ADD("       and O.ContraEspecie  =MO.Especie ")
SQL.ADD("UNION")
** Pases Activos Titulos (Moneda)
SQL.ADD("SELECT 1 as TP, '"~VAR('OPPACTTI')~"' as Operacion, O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT, ")
