**  Giros y Transferencias en el Pais para TIC/TIV/TIFC/TIFV
**  Emitidos Y Recibidos
SQL.ADD("SELECT 1 as TP, ")
SQL.ADD(" CASE WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPTRSRARG')~"'  else '"~VAR('OPTRSEARG')~"' end ")
SQL.ADD("      WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPTRSEARG')~"'  else '"~VAR('OPTRSRARG')~"' end  ELSE ")
