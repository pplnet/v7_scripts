SQL.ADD(" O.TipoOP, O.NrOperacion, O.FechaOp, O.TotalBrutoCli1 Cantidad, O.Cuenta4 Cuenta1, O.Cliente1, C.AliasBT,  ")
SQL.ADD(" O.ContraEspecie ContraEsp, O.ContraEspecie Especie, E.Cotiza, O.TotalBrutoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal, ")
