** Compra y Venta Titulos Privados (Moneda)
SQL.ADD("SELECT 1 as TP, ")
SQL.ADD(" CASE WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPVTAPRI')~"'  else '"~VAR('OPCPRAPRI')~"' end ")
SQL.ADD("      WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPCPRAPRI')~"'  else '"~VAR('OPVTAPRI')~"' end  ELSE ")
SQL.ADD(" Case when O.Cliente1 = '"~Var('VEHICULODE')~"' then (case when TipoOp in ('TIC','TCOPRI','TIFC') Then '"~VAR('OPCPRAPRI')~"' else '"~VAR('OPVTAPRI')~"' end) else (case when TipoOp in ('TIC','TCOPRI','TIFC') then '"~VAR('OPVTAPRI')~"' else '"~VAR('OPCPRAPRI')~"' end) end  END Operacion, ")
SQL.ADD(" O.TipoOP, O.NrOperacion, O.FechaOp, O.Cantidad, O.Cuenta1, O.Cliente1, C.AliasBT, ")
SQL.ADD(" O.ContraEspecie ContraEsp, O.Especie, E.Cotiza, O.TotalBrutoCli1 Monto, C.Sucursal, MO.FechaEje FechaLiq, C.NrCuenta, SWIFTAddress, CO.Nombre Corresponsal,  ")
SQL.ADD(" E.CodNumCajaValores,C.RazonSocial,O.FechaVto,O.Plazo, C.Persona, C.CUIT, C.FechaApertura, C.ActividadBCRA, C.Pais, C.OficialCuenta, E1.ISO CodEspecie, 'AR' PaisSwift, E1.CodBCRA  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("     LEFT JOIN dbo.CLIENTES C on O.Cliente1=C.Codigo ")
SQL.ADD("     LEFT JOIN dbo.CUENTAS CU on Cuenta1=CU.Codigo ")
IF Dialogo.Check1=1
   SQL.ADD("     LEFT JOIN "~DBO~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion and Nrsaldo=81 ")
Else
   SQL.ADD("     LEFT JOIN "~DBO~".MOVEJECUTADOS MO WITH (NOLOCK) ON O.NrOperacion=MO.NrOperacion ")
Endif
SQL.ADD("     LEFT JOIN "~DBO~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".ESPECIES E1 WITH (NOLOCK) ON O.ContraEspecie=E1.Codigo ")
SQL.ADD("     LEFT JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ") 
SQL.ADD("     LEFT JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
SQL.ADD("WHERE  O.TipoOp in ('TIC','TIFC','TIV','TCOPRI','TIFV') and PaseCB<>1 ")
SQL.ADD("       and B.Valor='1' and B.NrBit not in (30) ")
SQL.ADD("       and E.Tipo in (select Codigo from "~DBO~".TIPOESPECIE where Clasificacion ='PRI')  ")
SQL.ADD("       and O.Mercado not in  ("~Pipe2Comillas(VAR('UIFRTIMERC'))~") ")
**SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ') and C.CategDepositante='CLI' ")
SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null or C.Alias1='' or C.Alias1=' ')   ")
SQL.ADD("       and  (MO.FechaEje >= "~IdxDate2(Dialogo.Fecha1)~" and MO.FechaEje<="~IdxDate2(Dialogo.Fecha2)~" )")
SQL.ADD("       and O.ContraEspecie  =MO.Especie ")
SQL.ADD("UNION")
