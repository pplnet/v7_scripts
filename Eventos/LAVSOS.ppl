**  Giros y Transferencias en el Exterior para TIC/TIV
**  Emitidos y Recibidos
SQL.ADD("SELECT 1 as TP, ")
SQL.ADD(" CASE WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPTRSREXT')~"'  else '"~VAR('OPTRSEEXT')~"' end ")
SQL.ADD("      WHEN (O.Cliente1 <> '"~Var('VEHICULODE')~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then '"~VAR('OPTRSEEXT')~"'  else '"~VAR('OPTRSREXT')~"' end  ELSE ")
