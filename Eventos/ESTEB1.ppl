**Ejercicio 1: Consultas por Especies de TIPO Publicas.

** Crear los campos a completar:
CrearDialogo
   Vehiculo1 : 'Vehiculo'       ;2;1;;SI;;; 'Debe ingresar un Vehiculo';NO;
FinDialogo

** Para cerrar el evento sin devolver resultado:
IF Not Ok
  Cancelar
ENDIF

SQL.ADD(" Select Codigo, Cliente, Descripcion, Jerarquia, TipoVehiculo, Valor1 ")
SQL.ADD(" From "~DBO~".VEHICULOS ")

IF NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" Where Codigo = '"~Dialogo.Vehiculo1~"' ")
ENDIF

Recorrer SQL
   ACT(A:fac, fbn('Codigo'))
   ACT(B:fac, fbn('Cliente'))
   ACT(C:fac, fbn('Descripcion'))
   ACT(E:fac, fbn('Jerarquia'))
   ACT(F:fac, fbn('TipoVehiculo'))
   ACN(G:fac, fbn('Valor1'))
   
   ACN(P:1, Val(P:1) + 1)
Proximo

      CrearListBox;'Arial,10,B'
         'Vehiculo'                 ; a1..a:fac; SI; SI;;60; TABLA; 'Vehiculos'; 'Codigo'
         'Cliente'                  ; b1..b:fac; NO; SI;;70; STRING
         'Descripcion'              ; c1..c:fac; SI; SI;;80; STRING
         'Año'                      ; d1..d:fac; SI; SI;;70; COMBO; '2015|2016|2017' 
         'Jerarquia'                ; e1..e:fac; SI; SI;;80; STRING
         'Tipo de Vehiculo'         ; f1..f:fac; SI; SI;;80; STRING
         'Valor'                    ; g1..g:fac; SI; SI;;70; NUMERO; '###,###,###.##'
      FinListBox

IF OK
   Recorrer&j 1,Val(P:1)
      IF Val(G:&i) > 10

      ELSE

      ENDIF

   Proximo
ENDIF


