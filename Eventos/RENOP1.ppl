CrearDialogo
    Radio1:        'Filtrar Por|Operacion|FechaVto.'  ;;;;;;;;;0
    NrOperacion1:  'NrOperacion'                      ;3;;;;Dialogo.Radio1=0;If(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)<=FSYS y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMCPM') y BuscarCampo('OPERACIONES','CB8','NrOperacion',Dialogo.NrOperacion1)<>1 y BuscarCampo('OPERACIONES','CB7','NrOperacion',Dialogo.NrOperacion1)<>1,);'La operacion debe estar vencida,ser de tipo MMCPM y no haberse renovado ni precancelado previamente';NO;;;;;;"TipoOp='MMCPM' and FechaVto<= '"~IdxDate(FSYS)~"' and (CB8='0' or CB8='' or CB8=' ' or CB8 is Null) and (CB7='0' or CB7='' or CB7=' ' or CB7 is Null)"
    Fecha1:        'FechaVto.'                        ;3;;;;Dialogo.Radio1=1;If(Dialogo.Radio1=1,Dialogo.Fecha1<=FSYS,);'No puede renovar plazos que aun no han vencido';NO;;FSYS
FinDialogo

If Not Ok
    Cancelar
Endif

If Dialogo.Radio1=1
    If Query("Select Count(O.NrOperacion) from "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS C  ON O.NrOperacion = C.NrOperacion Where FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' and TipoOp='MMCPM' and (CB8='0' or CB8='' or CB8=' ' or CB8 is Null)") = 0
        Cancelar ('No existen operaciones vencidas en la fecha seleccionada')
    Endif
Endif

*Hojavisible(SI)
    **********************************************************SQL************************************************************************
SQL.ADD("Select ")
SQL.ADD("O.Especie,O.TipoOp,O.NrOperacion,O.Cantidad,")
SQL.ADD("O.Precio1 as 'TasaInt',O.Spread,O.Cliente1,")
SQL.ADD("O.FechaOp,O.FechaVto,O.Plazo,O.MB3,O.Observac2,")
SQL.ADD("O.Numerador,O.Cuotas1,O.TablaFeriados1,")
SQL.ADD("O.FechaOp2,O.Plazo2,O.Plazo4,O.TotalAux2,")
SQL.ADD("O.PlazoGracia,O.RB7,O.RB8 as 'UTiempo',")
SQL.ADD("O.RB9,O.Vehiculo1,O.TipoTasa,O.DeltaTasa,")
SQL.ADD("O.Cuenta1,O.Cuenta2,O.ImpGastos1 as 'TasaRet',")
SQL.ADD("O.ImpGastos2,O.PrecioRef,O.RB11,O.Indice,")
SQL.ADD("O.Coeficiente,O.Book1,O.CB13,O.CB15,")
SQL.ADD("O.RB15,O.RB16,O.Precio3,O.TipoGracia,")
SQL.ADD("O.RB10,O.ContraEspecie6,")
SQL.ADD(" C.Cantidad3 as 'Intereses', C.Cantidad4 as 'Retenciones',C.Coeficiente as 'CoeficienteCuo' ")
SQL.ADD("From "~DBO~".OPERACIONES O JOIN "~DBO~".CUOTAS C  ON O.NrOperacion = C.NrOperacion ")
    
If Dialogo.Radio1=1
    SQL.ADD("Where FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' and TipoOp='MMCPM' and (CB8='0' or CB8='' or CB8=' ' or CB8 is Null) ")
Else
    SQL.ADD("Where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif  

    ****************************************************************DATOS DE OP A RENOVAR***********************************************

Recorrer SQL
        If Dialogo.Radio1=1
            ACN(A:fac,0)
        Else
            ACN(A:fac,1)
        Endif
        ACT(B:fac,fbn['NrOperacion'])
        ACT(C:fac,fbn['Vehiculo1'])
        ACT(D:fac,fbn['Book1'])
        ACT(E:fac,fbn['Cliente1'])
        ACT(F:fac,fbn['Cuenta1'])
        ACD(G:fac,fbn['FechaOp'])
        ACN(H:fac,fbn['Plazo'])
        ACD(I:fac,fbn['FechaVto'])
        ACN(J:fac,fbn['TasaInt'])
        ACN(K:fac,fbn['Intereses'])
        ACN(L:fac,fbn['TasaRet'])
        ACN(M:fac,fbn['Retenciones'])
        ACN(N:fac,fbn['Cantidad'])
        ACT(O:fac,fbn['UTiempo'])
        ACT(Q:fac,fbn['Especie'])
        ACT(R:fac,fbn['TipoOp'])
        ACN(S:fac,fbn['Spread'])
        ACT(T:fac,fbn['MB3'])
        ACT(U:fac,fbn['Observac2'])
        ACN(V:fac,fbn['Numerador'])
        ACN(W:fac,fbn['Cuotas1'])
        ACT(X:fac,fbn['TablaFeriados1'])
        ACD(Y:fac,fbn['FechaOp2'])
        ACN(Z:fac,fbn['Plazo2'])
        ACN(AA:fac,fbn['Plazo4'])
        ACN(AB:fac,fbn['TotalAux2'])
        ACN(AC:fac,fbn['PlazoGracia'])
        ACT(AD:fac,fbn['RB7'])
        ACT(AE:fac,fbn['RB9'])
        ACT(AF:fac,fbn['TipoTasa'])
        ACN(AG:fac,fbn['DeltaTasa'])
        ACT(AH:fac,fbn['Cuenta1'])
        ACT(AI:fac,fbn['Cuenta2'])
        ACN(AJ:fac,fbn['ImpGastos2'])
        ACT(AK:fac,fbn['PrecioRef'])
        ACT(AL:fac,fbn['RB11'])
        ACT(AM:fac,fbn['Indice'])
        ACN(AN:fac,fbn['Coeficiente'])
        ACT(AO:fac,fbn['CB13'])
        ACT(AP:fac,fbn['CB15'])
        ACT(AQ:fac,fbn['RB15'])
        ACT(AR:fac,fbn['RB16'])
        ACN(AS:fac,fbn['Precio3'])
        ACT(AT:fac,fbn['TipoGracia'])
        ACT(AU:fac,fbn['RB10'])
        ACT(AV:fac,fbn['ContraEspecie6'])
        ACT(AW:fac,fbn['CoeficienteCuo'])
        ACT(AX:fac,Var('RISKRPFCA'))
Proximo

    *********************************************************SELECCION DE OP A RENOVAR**************************************************
let &UltimaFila FAC

If Dialogo.Radio1=1
    Recorrer &j 1,1000
        CrearListBox;'Arial,8,B'
            'Renovar'        ; a:1..a:fac; SI; SI;;35; COMBO;'No|Si|'
            'NrOperacion'    ; b:1..b:fac; NO; NO;;100; STRING;;EXE('COLOR8')
            'Vehiculo'       ; c:1..c:fac; NO; NO;;100; STRING;;EXE('COLOR8')
            'Book'           ; d:1..d:fac; NO; NO;;100; STRING;;EXE('COLOR8')
            'Cliente'        ; e:1..e:fac; NO; NO;;100; STRING;;EXE('COLOR8')
            'Cuenta'         ; f:1..f:fac; NO; NO;;100; STRING;;EXE('COLOR8')
            'FechaOp'        ; g:1..g:fac; NO; NO;;80; FECHA;EXE('COLOR8')
            'Plazo'          ; H:1..H:fac; NO; NO;;60;  NUMERO;'####';EXE('COLOR8')
            'FechaVto'       ; I:1..I:fac; NO; NO;;80; FECHA;EXE('COLOR8')
            'TasaInt'        ; J:1..J:fac; NO; NO;;100; NUMERO;'###.########';EXE('COLOR8')
            'Intereses'      ; K:1..K:fac; NO; NO;;100; NUMERO;'###,###,###,###.##';EXE('COLOR8')
            'TasaRet'        ; L:1..L:fac; NO; NO;;100; NUMERO;'###.########';EXE('COLOR8')
            'Retenciones'    ; M:1..M:fac; NO; NO;;100; NUMERO;'###,###,###,###.##';EXE('COLOR8')
            'Cantidad'       ; N:1..N:fac; NO; NO;;100; NUMERO;'###,###,###,###.##';EXE('COLOR8')
        FinListBox
        If Not Ok
            Cancelar
        Endif
        
        Recorrer &i 1,fac
            If Val(a:&i)=1
                ACN(ZZ:1,Val(ZZ:1)+1)
            Endif
        Proximo
    
        If CeldaVacia(ZZ:1)
            MessageBox('Debe seleccionar al menos una operacion a renovar')
        Else
            Break
        Endif
        
    Proximo 
Endif
    
    *********************************************************GRILLA CON DATOS PARA LA NUEVA OP******************************************
let &FilaCarga 0
Recorrer&i 1,&UltimaFila
    If Val(A:&i)=1
        let &FilaCarga &FilaCarga+1
        ACT(BB:&FilaCarga,Val(B:&i))
        ACT(BC:&FilaCarga,Val(C:&i))
        ACT(BD:&FilaCarga,Val(D:&i))
        ACT(BE:&FilaCarga,Val(E:&i))
        ACT(BF:&FilaCarga,Val(F:&i))
        ACD(BG:&FilaCarga,Val(G:&i))
        ACN(BH:&FilaCarga,Val(H:&i))
        ACD(BI:&FilaCarga,Val(I:&i))
        ACN(BJ:&FilaCarga,Val(J:&i))
        IF EqStr(Val(O:&i),'0')
            ACT(BO:&FilaCarga,'0')
            ACN(O:&i,360)
        ELSE
            ACT(BO:&FilaCarga,'1')
            ACN(O:&i,365)
        ENDIF
        ACN(BN:&FilaCarga,Val(N:&i)+Val(K:&i)-Val(M:&i))
        ACN(BK:&FilaCarga,((Val(N:&i)+Val(K:&i)-Val(M:&i))*(Val(J:&i)/100)*VAL(H:&i))/Val(O:&i))
        ACN(BL:&FilaCarga,Val(L:&i))
        ACN(BM:&FilaCarga,[Val(BK:&FilaCarga)*Val(BL:&FilaCarga)]/100)
        ACD(BP:&FilaCarga,Val(I:&i)+Val(H:&i))
        ACT(BQ:&FilaCarga,Val(Q:&i))
        ACT(BR:&FilaCarga,Val(R:&i))
        ACN(BS:&FilaCarga,Val(S:&i))
        ACT(BT:&FilaCarga,Val(T:&i))
        ACT(BU:&FilaCarga,Val(U:&i))
        ACN(BV:&FilaCarga,Val(V:&i))
        ACN(BW:&FilaCarga,Val(W:&i))
        ACT(BX:&FilaCarga,Val(X:&i))
        ACD(BY:&FilaCarga,Val(Y:&i))
        ACN(BZ:&FilaCarga,Val(Z:&i))
        ACN(CA:&FilaCarga,Val(AA:&i))
        ACN(CB:&FilaCarga,Val(AB:&i))
        ACN(CC:&FilaCarga,Val(AC:&i))
        ACT(CD:&FilaCarga,Val(AD:&i))
        ACT(CE:&FilaCarga,Val(AE:&i))
        ACT(CF:&FilaCarga,Val(AF:&i))
        ACN(CG:&FilaCarga,Val(AG:&i))
        ACT(CH:&FilaCarga,Val(AH:&i))
        ACT(CI:&FilaCarga,Val(AI:&i))
        ACN(CJ:&FilaCarga,Val(AJ:&i))
        ACT(CK:&FilaCarga,Val(AK:&i))
        ACT(CL:&FilaCarga,Val(AL:&i))
        ACT(CM:&FilaCarga,Val(AM:&i))
        ACN(CN:&FilaCarga,Val(AN:&i))
        ACT(CO:&FilaCarga,Val(AO:&i))
        ACT(CP:&FilaCarga,Val(AP:&i))
        ACT(CQ:&FilaCarga,Val(AQ:&i))
        ACT(CR:&FilaCarga,Val(AR:&i))
        ACN(CS:&FilaCarga,Val(AS:&i))
        ACT(CT:&FilaCarga,Val(AT:&i))
        ACT(CU:&FilaCarga,Val(AU:&i))
        ACT(CV:&FilaCarga,Val(AV:&i))
        ACT(CW:&FilaCarga,Val(AW:&i))
        ACT(CX:&FilaCarga,Val(AX:&i))
    Endif
Proximo

    *****************************************************LIST BOX CON LOS CAMPOS DE LA NUEVA OP****************************************
    CrearListBox;'Arial,9,B'
        'Op. a Renovar' ; BB:1..BB:&FilaCarga; NO; NO;;85; STRING;;EXE('COLOR8')
        'Vehiculo'      ; BC:1..BC:&FilaCarga; NO; NO;;90; STRING;;EXE('COLOR8')
        'Book'          ; BD:1..BD:&FilaCarga; NO; NO;;100; STRING;;EXE('COLOR8')
        'Cliente'       ; BE:1..BE:&FilaCarga; NO; NO;;100; STRING;;EXE('COLOR8')
        'Cuenta'        ; BF:1..BF:&FilaCarga; NO; NO;;100; STRING;;EXE('COLOR8')
        'FechaOp'       ; BI:1..BI:&FilaCarga; NO; NO;;80; FECHA;EXE('COLOR8')
        'Plazo'         ; BH:1..BH:&FilaCarga; SI; [DESCIENDEDECLIENTE(Val(BE:FLB),'BLOCAL') Y Val(BH:FLB)>=VAR('PLAZOBLOCA')] O [NOT DESCIENDEDECLIENTE(Val(BE:FLB),'BLOCAL') Y Val(BH:FLB)>=0];'Plazo invalido';40;NUMERO;'####';;DifDias(Val(BP:FLB),Val(BI:FLB),'ARG',NO);NO;NO;;;;NO;SI
        'FechaVto'      ; BP:1..BP:&FilaCarga; SI; [Val(BP:FLB)>Val(BI:FLB)] y EsHabil(Val(BP:FLB)); 'La Fecha de vencimiento debe ser habil y mayor a la fecha de la operacion';80;FECHA;;Val(BI:FLB)+Val(BH:FLB);NO;NO;;;;NO;SI
        'Cantidad'      ; BN:1..BN:&FilaCarga; NO; NO;;120;NUMERO;'###,###,###,###.##';EXE('COLOR8')
        'TasaInt'       ; BJ:1..BJ:&FilaCarga; SI; Val(BJ:FLB)>=0; 'La tasa debe ser positiva';90;NUMERO;'###.########'
        'UTiempo'       ; O:1..O:&FilaCarga; NO; NO;;50;NUMERO;'###';EXE('COLOR8')
        'Intereses'     ; BK:1..BK:&FilaCarga; NO; NO;;110;NUMERO;'###,###,###,###.##';EXE('COLOR8');(Val(BN:FLB)*(Val(BJ:FLB)/100)*VAL(BH:FLB))/Val(O:FLB);NO;NO;;;;NO;SI
        'TasaRet'       ; BL:1..BL:&FilaCarga; SI; [Not DESCIENDEDECLIENTE(Val(BE:FLB),'BANCOS') O  Incluido(Fstr(Val(BL:FLB),2,2),VAR('LISTIMPU'))] Y Val(BL:FLB)>=0;'La tasa de retencion no puede ser negativa.Si el cliente es Banco debe ser' ~VAR('LISTIMPU');80;NUMERO;'###.########'
        'Retenciones'   ; BM:1..BM:&FilaCarga; NO; ;;100; NUMERO;'###,###,###,###.##';EXE('COLOR8');[Val(BK:FLB)*Val(BL:FLB)]/100;NO;NO;;;;NO;SI
        #ifdef bfsa
        'Riesgo'        ; CX:1..CX:&FilaCarga; NO; NoVacio(Val(CX:FLB));'Debe indicar el riesgo de la operacion';50; TABLA;'RIESGOOPERACIONES';'Codigo';'Descripcion';
        #endif
    FinListBox
    
    If Not Ok
        Cancelar
    Endif

Recorrer&j 1,&FilaCarga
    ACT(NO:1,GetNumerador(Val(BV:&j)))
    ACN(PM:1,Val(BN:&j)*COTIZACIONC(Val(BQ:&j),,,,Val(BI:&j),1,SI,VAR('MONEEXTR')))
    ACN(PS:6,COTIZACION(Val(CM:&j),,,,Habiles(Val(BI:&j),-Val(BZ:&j),Val(BX:&j),SI),1,SI))
    ACN(PS:7,COTIZACION(Val(CM:&j),,,,Habiles(Val(BP:&j),-Val(BZ:&j),Val(BX:&j),SI),1,SI))
    IF EqStr(Val(BQ:&j),VAR('MONEEXTR'))
        ACN(MO:1,1)
    Else
        ACN(MO:1,COTIZACIONC(VAR('MONEEXTR'),,,,Val(BI:&j),1,SI,Val(BQ:&j)))
    Endif
    ACN(PI:1,Val(BN:&j)*(Val(CG:&j)/100))
    IF EqStr('CAP',Val(CT:&j))
        ACN(RI:1,Val(BN:&j))
    Else
        ACN(RI:1,Val(BN:&j)* (Val(PS:7)-Val(PS:6)))
    Endif
    ACN(TA:5,Val(BN:&j)*Val(PS:6))
    ACN(TA:7,Val(BN:&j)/Val(PS:6))
    **VTXT6
    ACT(VT:6,QUERY("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~Val(BE:&j)~"' AND Limite='COTOR' "))
    **VCAN10
    ACN(VC:10,IIF(EqStr(Val(BQ:&j),Val(VT:6)),Val(BN:&j),Val(BN:&j)*COTIZACIONC(Val(BQ:&j),,,,Fsys,1,SI,Val(VT:6))))
    **VCAN7
    ACN(VC:7,Val(VC:10)+LIMCONSUMIDO(Val(BE:&j),'COTOR',Val(VT:6),0,,,,Val(NO:1)))
    ****************************************EXCEPCIONES-Si hay alguna excepcion excluyente,no renueva esa OP**************************************************
    If Not EsHabil(Val(BI:&j))
        ACT(EX:1,Val(EX:1)~'A')

    Endif
    If Not EsHabil(Val(BP:&j))
        ACT(EX:1,Val(EX:1)~'B')

    Endif
    If EqStr('DES',BuscarCampo('Clientes','Status','Codigo',Val(BE:&j)))
        ACT(EX:1,Val(EX:1)~'C')
    Endif
    If EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',Val(BE:&j)))
        ACT(EX:1,Val(EX:1)~'D')

    Endif    
    If Not EQSTR(Val(CF:&j),'FIJA') Y Not [Val(BS:&j)>=VAR('RSPREAD1') Y Val(BS:&j)<=VAR('RSPREAD2')]
        ACT(EX:1,Val(EX:1)~'F')

    Endif      
    If Not Val(BI:&j)=Fsys
        ACT(EX:1,Val(EX:1)~'G')

    Endif    
    If [VACIO(Val(BE:&j))] Y Not ExisteLimite('COTOR',Val(BE:&j),Val(VT:6))
        ACT(EX:1,Val(EX:1)~'H')

    Endif     
    If [VACIO(Val(BE:&j))] Y ExisteLimite('COTOR',Val(BE:&j),Val(VT:6)) Y Not VtoLimite('COTOR',Val(BE:&j),Val(VT:6)) >= Val(BI:&j)
        ACT(EX:1,Val(EX:1)~'I')

    Endif
    If [VACIO(Val(BE:&j))] y Not LimAsignado(Val(BE:&j),'COTOR',Val(VT:6)) >= Val(VC:7) 
        ACT(EX:1,Val(EX:1)~'J')

    Endif       
    If Not EqStr(BuscarCampo('ESPECIES','Status','Codigo',Val(BQ:&j)),'HAB') 
        ACT(EX:1,Val(EX:1)~'K')
    Endif    
    If Not ((Val(BJ:&j)>=VAR('RTASA1') Y Val(BJ:&j)<=VAR('RTASA2')))
        ACT(EX:1,Val(EX:1)~'L')
    Endif
    
    If Incluido('C',Val(EX:1)) o Incluido('K',Val(EX:1))
        MessageBox('La operacion ' ~Val(BB:&j)) ~ ' no pudo ser renovada. Verificar estado Cliente y Especie'
    Else
        


            If Incluido('A',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")
                SQL.ADD("('"~Val(NO:1)~"','ORIGINH','"~IdxDate(Fsys)~"','La Fecha de Origen no es Dia Habil en Argentina')")
            Endif
            If Incluido('B',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','VTOINH','"~IdxDate(Fsys)~"','La Fecha de Vencimiento NO ES DIA HABIL en Argentina')")
            Endif
            If Incluido('D',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','CLIOBS','"~IdxDate(Fsys)~"','El Cliente esta Observado')")
            Endif
            If Incluido('F',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','RANGOSPREAD','"~IdxDate(Fsys)~"','El Spread esta Fuera de Rango '"~VAR('RSPREAD1')~"' '"~VAR('RSPREAD2')~"')")
            Endif
            If Incluido('G',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','CONCFVALOR','"~IdxDate(Fsys)~"','La Fecha de Concertacion no coincide con la de Sistema'),")
                SQL.ADD("('"~Val(NO:1)~"','ORIGFVALOR','"~IdxDate(Fsys)~"','La Fecha de Origen no coincide con la de Sistema')")
            Endif
            If Incluido('H',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','COTORNOAS','"~IdxDate(Fsys)~"','Lim.Credito no asignado')")
            Endif
            If Incluido('I',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','COTORVENC','"~IdxDate(Fsys)~"','Lim.Credito vencido el '"~FECHA(VtoLimite('COTOR',Val(BE:&j),Val(VT:6)))~"')")
            Endif
            If Incluido('J',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','COTOREXCE','"~IdxDate(Fsys)~"','Lim.Credito excedido '"~PYC(-(LimAsignado(Val(BE:&j),'COTOR',Val(VT:6))-Val(VC:7)),1,0)~"'.-')")
            Endif           
            If Incluido('L',Val(EX:1))
                SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES (NrOperacion,Tipo,Fecha,Descripcion) VALUES ")            
                SQL.ADD("('"~Val(NO:1)~"','RTASA','"~IdxDate(Fsys)~"','La Tasa esta fuera de rango')")

            SQL.NEW
            SQL.EXEC
        Endif
    **********************************************************INSERT A OPERACIONES******************************************************
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
        SQL.ADD("(Especie,TipoOp,NrOperacion,Cantidad,Precio1,")
        SQL.ADD("Spread,PrecioMer,Cliente1,Operador,FechaOp,")
        SQL.ADD("FechaVto,Plazo,RB3,MB3,UsrInput,FechaCarga,")
        SQL.ADD("Observac2,Numerador,Impresa,FechaCargaSys,Cuotas1,")
        SQL.ADD("TablaFeriados1,FechaOp2,Plazo2,Plazo4,TotalAux2,")
        SQL.ADD("Cotizacion1,PlazoGracia,RB7,RB8,RB9,")
        SQL.ADD("Vehiculo1,TipoTasa,DeltaTasa,PeriodoInts,Cuenta1,")
        SQL.ADD("Cuenta2,ImpGastos1,ImpGastos2,PrecioRef,RB11,")
        SQL.ADD("Indice,Coeficiente,CantidadOri,ResultadoIndice,Book1,")
        SQL.ADD("Precio6,CB13,CB15,RB15,RB16,TotalAux5,")
        SQL.ADD("TotalAux6,RB10,Precio3,FechaVto2,Plazo3,TipoGracia,")
        SQL.ADD("Precio7,ContraEspecie6,TotalAux7,CB8,CB9")
        #ifdef bfsa
            SQL.ADD(",Riesgo")
        #endif
        SQL.ADD(")")
        
        SQL.ADD("VALUES (")
        
        SQL.ADD("'"~Val(BQ:&j)~"','"~Val(BR:&j)~"','"~Val(NO:1)~"',"~Fstr(Val(BN:&j),0,2)~","~Fstr(Val(BJ:&j),0,8)~",")
        SQL.ADD(" "~Fstr(Val(BS:&j),0,8)~","~Fstr(Val(PM:1),0,8)~",'"~Val(BE:&j)~"','"~UsuarioActivo~"','"~IdxDate(Val(BI:&j))~"',")
        SQL.ADD("'"~IdxDate(Val(BP:&j))~"',"~Fstr(Val(BH:&j),0,0)~",'1','"~Val(BT:&j)~"','"~UsuarioActivo~"','"~IdxDate(Ahora)~"',")
        SQL.ADD("'"~Val(BU:&j)~"',"~Fstr(Val(BV:&j),0,0)~",'0','"~IdxDate(Fsys)~"',"~Fstr(Val(BW:&j),0,0)~",")
        SQL.ADD(" '"~Val(BX:&j)~"','"~IdxDate(Val(BI:&j))~"',"~Fstr(Val(BZ:&j),0,0)~","~Fstr(Val(CA:&j),0,0)~","~Fstr(Val(CB:&j),0,8)~",")
        SQL.ADD(" "~Fstr(Val(MO:1),0,2)~","~Fstr(Val(CC:&j),0,0)~",'"~Val(CD:&j)~"','"~Val(BO:&j)~"','"~Val(CE:&j)~"',")
        SQL.ADD("'"~Val(BC:&j)~"','"~Val(CF:&j)~"',"~Fstr(Val(CG:&j),0,2)~","~Fstr(Val(PI:1),0,8)~",'"~Val(CH:&j)~"',")
        SQL.ADD("'"~Val(CI:&j)~"',"~Fstr(Val(BL:&j),0,8)~","~Fstr(Val(CJ:&j),0,8)~",'"~Val(CK:&j)~"','"~Val(CL:&j)~"',")
        SQL.ADD("'"~Val(CM:&j)~"',"~Fstr(Val(CN:&j),0,0)~","~Fstr(Val(BN:&j),0,2)~","~Fstr(Val(RI:1),0,8)~",'"~Val(BD:&j)~"',")
        SQL.ADD(" "~Fstr(Val(PS:6),0,8)~",'"~Val(CO:&j)~"','"~Val(CP:&j)~"','"~Val(CQ:&j)~"','"~Val(CR:&j)~"',"~Fstr(Val(TA:5),0,8)~",")
        SQL.ADD(" "~Fstr(0,0,8)~",'"~Val(CU:&j)~"',"~Fstr(Val(CS:&j),0,0)~",'"~IdxDate(Val(BP:&j))~"',"~Fstr(Val(BH:&j),0,0)~",'"~Val(CT:&j)~"',")
        SQL.ADD(" "~Fstr(Val(PS:7),0,8)~",'"~Val(CV:&j)~"',"~Fstr(Val(TA:7),0,0)~",'0','1' ")
        #ifdef bfsa
            SQL.ADD(",'"~Val(CX:&j)~"' ")
        #endif
        SQL.ADD(")")
        SQL.NEW
    **************************************************************UPDATE CAMPO CB8 OP ORIGINAL***********************************************
        SQL.ADD("UPDATE "~DBO~".OPERACIONES Set CB8='1', OperacionRef= '"~Val(NO:1)~"' Where NrOperacion = '"~Val(BB:&j)~"' ")
        SQL.NEW
        SQL.EXEC
    *******************************************************************INSERT A CUOTAS*******************************************************
        **FECHA4
        ACD(FE:4,HABILES(IIF(Val(CR:&j)=0,Val(BI:&j),Val(BP:&j)),-Val(CA:&j),Val(BX:&j),SI))
        **CANTIDAD3
        ACN(XX:1,(Val(BN:&j)*(Val(BS:&j)+Val(BJ:&j))*Val(BH:&j))/IIF(Val(BO:&j)=0,36000,36500))
        **CANTIDAD4
        ACN(XX:2,IIF(DESCIENDEDECLIENTE(Val(BE:&j),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Val(BE:&j))),Val(XX:1)*Val(BL:&j)/100,0))
        **TOTAL2
        ACN(XX:4,Val(BN:&j)+Val(XX:1))
        **TOTAL1
        ACN(XX:3,Val(XX:4)-Val(XX:2))
        **TOTAL3
        ACN(XX:5,Val(XX:1)-Val(XX:2))
        **TOTAL5
        ACN(XX:6,IIF(NOT DESCIENDEDECLIENTE(Val(BE:&j),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Val(BE:&j))),Val(XX:1)*Val(CB:&j)/100,0))
        **CANTIDAD5
        ACN(XX:7,IIF(NOT DESCIENDEDECLIENTE(Val(BE:&j),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Val(BE:&j))),Val(XX:1)*Val(CJ:&j)/100,0))
        **CANTIDAD6
        ACN(XX:8,IIF(NOT DESCIENDEDECLIENTE(Val(BE:&j),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Val(BE:&j))),Val(XX:7)+Val(XX:6),0))
        **PRECIO5
        ACN(XX:9,(Val(BN:&j)*(Val(BS:&j)+Val(BJ:&j))*Val(BH:&j))/IIF(Val(BO:&j)=0,36000,36500))
        **PRECIO6
        ACN(XX:10,IIF(NOT DESCIENDEDECLIENTE(Val(BE:&j),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Val(BE:&j))),Val(XX:1)*Val(CJ:&j)/100,0))
        **CANTIDAD1ORI
        ACN(XX:12,IIF(Val(CW:&j)=1,Val(BN:&j),(Val(BN:&j)*(1+Val(VC:10)/100))*100/100))
        **CANTIDAD2ORI
        ACN(XX:13,IIF(Val(CW:&j)=1,Val(BN:&j),(Val(BN:&j)*(1+Val(VC:10)/100))))
        **CANTIDAD3ORI
        ACN(XX:14,(Val(BN:&j)))
        **RESULTADOINDICE
        ACN(XX:15,-Val(XX:12)+Val(BN:&j))
        
        
        SQL.ADD("INSERT INTO "~DBO~".CUOTAS")
        SQL.ADD("(NrOperacion,NrCuota,Check10,Fecha1,Fecha2,")
        SQL.ADD("Fecha3,Fecha4,Plazo1,Cantidad1,Cantidad2,")
        SQL.ADD("Cantidad3,Cantidad4,Precio2,Total1,")
        SQL.ADD("Total2,Total3,Total5,Tasa1,Cantidad5,Cantidad6,")
        SQL.ADD("Precio5,Precio6,Precio7,Precio8,Coeficiente,")
        SQL.ADD("Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice,")
        SQL.ADD("Cantidad10,Cantidad11,Tasa7)")
        
        SQL.ADD("VALUES (")

        SQL.ADD("'"~Val(NO:1)~"','1','0','"~IdxDate(Val(BI:&j))~"','"~IdxDate(Val(BP:&j))~"',")
        SQL.ADD("'"~IdxDate(Val(BP:&j))~"','"~IdxDate(Val(FE:4))~"',"~Fstr(Val(BH:&j),0,0)~","~Fstr(Val(BN:&j),0,2)~","~Fstr(Val(BN:&j),0,2)~",")
        SQL.ADD(" "~Fstr(Val(XX:1),0,2)~","~Fstr(Val(XX:2),0,2)~","~Fstr(Val(BJ:&j),0,8)~","~Fstr(Val(XX:3),0,2)~",")
        SQL.ADD(" "~Fstr(Val(XX:4),0,2)~","~Fstr(Val(XX:5),0,2)~","~Fstr(Val(XX:6),0,2)~", "~Fstr(100,0,2)~", "~Fstr(Val(XX:7),0,2)~","~Fstr(Val(XX:8),0,2)~",")
        SQL.ADD(" "~Fstr(Val(XX:9),0,2)~","~Fstr(Val(XX:10),0,2)~","~Fstr(Val(XX:6),0,2)~","~Fstr(Val(XX:2),0,2)~","~Fstr(Val(CW:&j),0,2)~",")
        SQL.ADD(" "~Fstr(Val(XX:12),0,2)~","~Fstr(Val(XX:13),0,2)~","~Fstr(Val(XX:14),0,2)~","~Fstr(Val(XX:15),0,2)~",")
        SQL.ADD(" "~Fstr(Val(XX:1),0,2)~","~Fstr(Val(XX:2),0,2)~","~Fstr(100,0,2)~" )")
        
        SQL.NEW
        SQL.EXEC
    *********************************************************INSERT OPERACIONESBITS NUEVA OP**********************************************
    EjecutarEvento('INSBIT',String1 = 'OPERACIONES',Entero1 = 1,NrOperacion1 = Val(NO:1))
    *********************************************************ACTUALIZAR MOVIMIENTOS**********************************************        
        SQL.ActualizarMovimientos3(Val(NO:1),SI,NO,NO,SI,SI)
        SQL.NEW
        SQL.EXEC
    Endif
