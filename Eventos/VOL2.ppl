*HojaVisible(SI)
CrearDialogo
   Fecha1    : 'Fecha'         ;;;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
   Entero1   : 'Ruedas Min'    ;;;;;; ;;;Num(SQL("Select Top 1 RuedasMin  from "~DBO~".METODOSVOLATILIDAD where Formula='STD' and  FechaVigencia>='"~IdxDate(Dialogo.Fecha1)~"' order by FechaVigencia "));
   Entero2   : 'Ruedas Max'    ;;;;;;; ;;Num(SQL("Select Top 1 RuedasMax  from "~DBO~".METODOSVOLATILIDAD where Formula='STD' and  FechaVigencia>='"~IdxDate(Dialogo.Fecha1)~"' order by FechaVigencia "));
  ** Radio2    : 'Metodo|STD|MAN';;;;NO;;  ; ;;0;
   Radio1    : 'Moneda|Emision|Cotizacion';;;;NO;;  ; ;;1;
   Lista1    : 'Especies' ;;;;;;NoVacio(Dialogo.Lista1);'Se ejecutara para todas las especies';SI;;;SQLSet("Select Codigo  from "~DBO~".ESPECIES where Status = 'HAB' and (Fecha> '"~IdxDate(Dialogo.Fecha1)~"' or Fecha is null   ) and  "~DBO~".EsTerminalEspecie(Codigo)=1   ")
FinDialogo

IF NOT OK
   Cancelar
Endif

ACT(RU:1,Dialogo.Entero1)
ACT(RU:2,Dialogo.Entero2)

If Vacio(Dialogo.Lista1)
   SQL.ADD("  Select Codigo,CotizaEn  from "~DBO~".ESPECIES where Status = 'HAB' and (Fecha> '"~IdxDate(Dialogo.Fecha1)~"' or Fecha is null   ) and  "~DBO~".EsTerminalEspecie(Codigo)=1 ")
   Recorrer SQL
     ACT(A:Fac,FBN['Codigo'])
     EjecutarEvento('VOL3', Fecha1=Dialogo.Fecha1, Especie1=Val(A:Fac), Entero1=Dialogo.Entero1, Entero2=Dialogo.Entero2, Check1=0)
   Proximo
Else
   Recorrer&i 1, Elementos(Dialogo.Lista1)
      ACT(A:Fac,ItemLista(Dialogo.Lista1,&i))
      EjecutarEvento('VOL3', Fecha1=Dialogo.Fecha1, Especie1=Val(A:Fac), Entero1=Dialogo.Entero1, Entero2=Dialogo.Entero2, Check1=0)
   Proximo
EndIf


