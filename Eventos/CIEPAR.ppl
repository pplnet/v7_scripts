*HojaVisible(SI)
CrearDialogo  
   ***---Se deja editable Fecha1 para las pruebas
  Fecha1     : 'Fecha'                 ; ; ;;;;EsHabil(Dialogo.Fecha1, 'ARG') Y Dialogo.Fecha1 = Habiles(Var('CIEPAR'),1, 'ARG');'Fecha Invalida';NO;Habiles(Var('CIEPAR'),1, 'ARG');
  Fecha2     : 'Cierre de Mes'         ;1;1;;NO;NO;;;;;FinDeMes(Dialogo.Fecha1,SI,'ARG')
  Fecha3     : 'Fecha Partida'         ; ; ;;NO;NO;;;;;FinDeMes(Dialogo.Fecha1,SI)
  Radio1     : 'Valuacion|Cupon|TIR'   ;;;;;NO;;;;1
FinDialogo

If Not Ok
   Cancelar
EndIf

IF Dialogo.Fecha1 = Fecha(Var('CIEPAR'))
    Cancelar('Ya fue realido el cierre del día para la fecha '~Dialogo.Fecha1)
ENDIF

let &opsNoAsignadasPartidas 0
(.'OPNOASPAR'.)
Recorrer SQL
    let &opsNoAsignadasPartidas &opsNoAsignadasPartidas+1
Proximo
IF &opsNoAsignadasPartidas > 0
    Cancelar('Quedan operaciones sin Asignar')
ENDIF


*SQL.ADD(" Select O.NrOperacion ")
*SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
*SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
*SQL.ADD(" AND O.TipoOp = 'PARTID' ")
*SQL.ADD(" AND C.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("  ")
*SQL.ADD("  ")
*Recorrer SQL
*    Cancelar('Ya fue realido el cierre del día para la fecha '~Dialogo.Fecha1)
*Proximo

SQL.ADD(" Select O.NrOperacion, E.TiposTasas, O.Especie, O.TipoCambio, O.FechaVto, E.DiasAnio, O.Cantidad, O.Precio1, O.TotalNetoCli1, ")
SQL.ADD(" E.TasaCER, O.FechaOp, O.FechaCargaSys ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = O.Especie ")
***---Se realiza el cierre para tasa fija tambien
***---SQL.ADD(" AND E.TiposTasas <> 'FIJA' ")
***---SQL.ADD(" AND E.TiposTasas is Not Null ")
SQL.ADD(" AND O.TipoOp IN ('PARTID') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TotalNetoCli1 > 0 ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
***---Solo se generan devengados hasta el dia anterior al vto de la especie
SQL.ADD(" AND E.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Order By O.Especie, O.NrOperacion ")
Recorrer SQL
    IF Not Eqstr(fbn('Especie'), Val(ES:1))
        ACT(AA:1, fbn('Especie'))
        (.'TASABONO'.)
    ENDIF
    ACT(ES:1, fbn('Especie'))
    ACT(TT:1, fbn('TiposTasas'))
    ACT(CE:1, fbn('TasaCER'))
    ACN(TR:1, fbn('TipoCambio'))
    ***---IF Dialogo.Fecha1 = fbn('FechaVto')
    IF Dialogo.Fecha1 = fbn('FechaCargaSys')
        ***---Empieza a procesar el dia que se carga la operacion, desde FechaOp a Dialogo.Fecha1
        ***---El primer dia arrancamos desde el precio de la operacion
        ACN(PR:1, fbn('Precio1'))
        IF Eqstr(fbn('TiposTasas'), 'FIJA') O Eqstr(fbn('TasaCER'), 'FIJ')
            ACN(PR:2, fbn('TipoCambio'))
        ELSE
            ACT(AA:1, fbn('Especie'))
            ACN(PR:2, TIREspecie(fbn('Especie'), Dialogo.Fecha1, Val(TS:1), fbn('Precio1')))
        ENDIF
        ***---Provisorio tomamos TIR de la partida hasta que probemos bien TIRESpecie
        ACN(PR:2, fbn('TipoCambio'))
        ACN(NC:1, 0)
        ACD(FE:2, fbn('FechaOp'))
    ELSE
        ***---Desde t+1 tomamos el precio fin del dia anterior para calcular la TIR
        SQL.ADD(" Select C.Precio4, C.NrCuota, C.Precio4 TIRDA, C.Precio2, C.Cantidad3 From "~DBO~".CUOTAS C ")
        SQL.ADD(" Where C.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" AND C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
        Recorrer SQL
            ACN(PR:1, fbn('Precio2'))
            IF Eqstr(Val(TT:1), 'FIJA') O Eqstr(Val(CE:1), 'FIJ')
                ACN(PR:2, Val(TR:1))
            ELSE
                ACN(PR:2, TIREspecie(Val(ES:1), Dialogo.Fecha1, Val(TS:1), fbn('Precio2')))
            ENDIF
            ACN(CA:3, fbn('Cantidad3'))
            ACN(NC:1, fbn('NrCuota'))
        Proximo
        ***---Provisorio tomamos TIR de la partida hasta que probemos bien TIRESpecie
        ACN(PR:2, Val(TR:1))
        ACD(FE:2, Dialogo.Fecha1)
    ENDIF
    ***---ACD(FE:2, Dialogo.Fecha1)
    ***---ACD(FE:2, fbn('FechaVto'))
    ACD(FE:3, Dialogo.Fecha1)
    IF Eqstr(fbn('DiasAnio'), 'REA')
        ACN(DA:1, DiasAnio2(fbn('Especie'), Fecha('01/01/'~Fstr(Anio(fbn('FechaOp')), 0, 0)), Fecha('31/12/'~Fstr(Anio(fbn('FechaOp')), 0, 0))))
    ELSE
        ACN(DA:1, fbn('DiasAnio'))
    ENDIF
    ***---ACN(CA:1, fbn('Cantidad'))
    ACN(CA:1, fbn('TotalNetoCli1'))
    ACT(NU:1, fbn('NrOperacion'))
    ACN(CA:3, 0)
    (.'DEVPARTIR'.)
Proximo

SQL.ADD(" Update "~DBO~".VARIABLES ")
SQL.ADD(" Set Valor = '"~Fecha(Dialogo.Fecha1)~"' ")
SQL.ADD(" Where Codigo = 'CIEPAR' ")
SQL.NEW
SQL.EXEC

IF NO
***---Desactivo version original, para tener de consulta

*- Pido que tenga disponible o que el disponible se haya utilizado
*- en el mes corriente o posterior
ACD(au1 , PriDeMes( Dialogo.Fecha1, NO,'ARG') )

SQL.ADD(" SELECT Distinct OP.Especie ")
SQL.ADD(" FROM  "~DBO~".OPERACIONES OP")
SQL.ADD(" WHERE OP.TipoOp in ('PARTID') ")
SQL.ADD("       and OP.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("       and ( OP.TotalNetoCli1 > 0 or ")
SQL.ADD("      '"~IdxDate(Val(au1))~"' <= (SELECT Max(P.FechaDesde) FROM "~DBO~".PARTIDAS P WHERE P.NrPartida=OP.NrOperacion AND TipoAct='VENTA') )  ")
SQL.ADD(" ORDER BY OP.Especie ")
ACN(zz1,0)
Recorrer SQL
       ACN(zz1,1)
Proximo

If Val(zz1)=0
     Cancelar('No hay Especies que tengan partidas en las fechas solicitadas')
EndIf

*- Ejecuto el Informe Resultados y Partidas de Investment
LinkearHoja('INVRES',1,Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio1,Check1=1, Radio2=0)

SetFilaActual(1)


*- Datos para actualizar la partida con el costo de funding de vtas.
Recorrer&i 1,100

 *-- Datos de la venta por partida
 *- h: Operacion i: Partida j: C.Funding Venta  n: Resultado de Ventas
 ACT(h:fac, LinkH(1, ai:&i))
 ACT(i:fac, LinkH(1, aj:&i))
 ACN(j:fac, LinkH(1, ak:&i))
 ACN(n:fac, LinkH(1, al:&i))

 *- Actualizo las cuotas de las partidas
 If Vacio(val(h:fac))
    Break
 EndIf

 *- En Partidas guardo el acumulado del costo de funding de las venta 
 SQL.ADD("UPDATE "~DBO~".PARTIDAS Set Cantidad1="~Fstr(val(j:fac),0,8)~" ")
 SQL.ADD("Where NrOperacion='"~val(h:fac)~"' and NrPartida='"~val(i:fac)~"' ")
 SQL.NEW

 SQL.ADD("UPDATE "~DBO~".OPERACIONES Set ")
 SQL.ADD("TipoCambio3=TipoCambio3 + "~Fstr(val(n:fac),0,2)~" ")
 SQL.ADD("Where NrOperacion='"~val(i:fac)~"' ")
 SQL.NEW
 SQL.EXEC
Proximo

Recorrer&i 1,100
 *- a: Nro. Partida b: Devengado c: Especie e: Precio Clean f: Precio Dirty g: Funding Compra
 *- m: Dev.en Efectivo del Periodo
 ACT(a:fac, LinkH(1, aa:&i))
 ACN(b:fac, LinkH(1, ab:&i))
 ACT(c:fac, LinkH(1, ac:&i))
 ACN(e:fac, LinkH(1, ae:&i))
 ACN(f:fac, LinkH(1, af:&i))
 ACN(g:fac, LinkH(1, ag:&i))

 *- Actualizo las cuotas de las partidas
 If Vacio(val(a:fac))
    Break
 EndIf

 acd(pm1,PriDeMes(Dialogo.Fecha1,SI,'ARG'))

 *- Resto el costo de funding de la venta asignado previamente
 SQL.ADD("SELECT Sum(Cantidad1) CFund FROM "~DBO~".PARTIDAS Where ")
 SQL.ADD("NrPartida='"~val(a:fac)~"' and TipoAct<>'COMPRA' and ")
 SQL.ADD("FechaDesde Between '"~IdxDate(val(pm1))~"' and '"~IdxDate(Dialogo.Fecha1)~"' ")

 Recorrer SQL
    dfa
    ACN(g:fac, val(g:fac)-FBN['CFund'])
 Proximo

 ACN(m:fac, LinkH(1, am:&i))

 *- k: Clean Anterior l: Dirty Anterior
 ACN(k:fac, val(e:fac))
 ACN(l:fac, val(f:fac))


 acn(vc1,0)
 acn(vc2,0)
 acn(vc2,0)

 *- Recupero Los precios anteriores clean y dirty de la cuota que vuelvo a correr
 SQL.ADD("SELECT Precio3 as Clean, Precio4 as Dirty,NrCuota FROM "~DBO~".CUOTAS Where NrOperacion='"~val(a:fac)~"' and Fecha1='"~IdxDate(Dialogo.Fecha1)~"' ")

 Recorrer SQL
    acn(vc1,FBN['Clean'])
    acn(vc2,FBN['Dirty'])
    acn(vc2,FBN['NrCuota']-1)
 Proximo

 If val(vc1)<>0
    *- Vuelve a ejecutar el cierre ya efectuado, recupero la cuota anterior para sacar el costo de funding
    acn(vc4,SQL("SELECT Cantidad2 FROM "~DBO~".CUOTAS Where NrOperacion='"~val(a:fac)~"' and NrCuota="~Fstr(val(vc2),0,0)~" ") ) 
    acn(vc5,SQL("SELECT Cantidad3 FROM "~DBO~".CUOTAS Where NrOperacion='"~val(a:fac)~"' and NrCuota="~Fstr(val(vc2),0,0)~" ") ) 

    SQL.ADD("UPDATE "~DBO~".OPERACIONES Set Precio1="~Fstr(val(vc1),0,8)~",Precio3="~Fstr(val(vc2),0,8)~", ")
    SQL.ADD("                               TotalAux2="~Fstr(val(vc4),0,2)~",TotalBrutoCli2=TotalBrutoCli2 - "~Fstr(val(vc5),0,8)~" ")
    SQL.ADD("Where NrOperacion='"~val(a:fac)~"' ")
    SQL.NEW
    SQL.EXEC
 EndIf

 *- Elimino los datos del cierre anterior
 SQL.ADD(" DELETE "~DBO~".CUOTAS Where NrOperacion='"~val(a:fac)~"' and Fecha1='"~IdxDate(Dialogo.Fecha1)~"'   ")
 SQL.NEW
 SQL.EXEC

 *- Recupero la ultima cuota ingresada para la partida
 ACN(u1,SQL("SELECT Max(NrCuota) FROM "~DBO~".CUOTAS Where NrOperacion='"~val(a:fac)~"'")+1)

***********************************************************************************
* If val(b:fac)<>0
*    *- Hubo devengado de TIR, calculo los nuevos precios sino dejo los que estan
*    *- f: Calculo el Nuevo PPP Dirty de la Partida (Dirty Anterior + Devengado)
*    SCN(f:fac,val(b:fac))
* 
*    *- e: Calculo el Nuevo PPP Clean de la Partida, Ensucio el Precio hasta el cierre 
*    ACN(e:fac, PrecioaResidual(val(c:fac),val(f:fac),Dialogo.Fecha1) )
* EndIf
***********************************************************************************
 If val(b:fac)<>0
    *- Hubo devengado de TIR, calculo los nuevos precios sino dejo los que estan
    *- f: Calculo el Nuevo PPP Dirty de la Partida (Dirty Anterior + Devengado)
    SCN(f:fac,val(b:fac))

    ACN(e:fac, Val(f:fac))  
    If EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(c:fac)),'CLE')
    *- e: Calculo el Nuevo PPP Clean de la Partida, Ensucio el Precio hasta el cierre 
       ACN(e:fac, PrecioaResidual(val(c:fac),val(f:fac),Dialogo.Fecha1) )
    EndIf
 EndIf
***********************************************************************************

 *- Actualizo los precios actuales en la partida
 SQL.ADD("UPDATE "~DBO~".OPERACIONES Set Precio1="~Fstr(val(e:fac),0,8)~",Precio3="~Fstr(val(f:fac),0,8)~",  ")
 SQL.ADD("                               TotalAux2="~Fstr(val(g:fac),0,2)~", ")
 SQL.ADD("                               TotalBrutoCli2=TotalBrutoCli2+"~Fstr(val(m:fac),0,2)~" ")
 SQL.ADD("Where NrOperacion='"~val(a:fac)~"' ")
 SQL.NEW

 SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
 SQL.ADD(" (NrOperacion,Cantidad1,Fecha1,NrCuota,  ")
 SQL.ADD("  Precio1,Precio2,Cantidad2,")
 SQL.ADD("  Precio3,Precio4,Cantidad3,Check1) Values ")
 SQL.ADD(" ('"~val(a:fac)~"',"~Fstr(val(b:fac),0,8)~",'"~IdxDate(Dialogo.Fecha1)~"',"~Fstr(val(u1),0,0)~", ")
 SQL.ADD(" "~Fstr(val(e:fac),0,8)~","~Fstr(val(f:fac),0,8)~","~Fstr(val(g:fac),0,2)~",")
 SQL.ADD(" "~Fstr(val(k:fac),0,8)~","~Fstr(val(l:fac),0,8)~","~Fstr(val(m:fac),0,2)~",'1') ")
 SQL.NEW
 SQL.EXEC
Proximo

ENDIF