       Recorrer&i 4, val(b1)
          *** toma solo lo marcado ***
          if val(k:&i) = 1

***************************************************************************
*** pasa los movimientos de Ejecutados pendientes a ejecutados ***
***************************************************************************
** Le Resto 30 al NrSaldo para dejarla como estab originalmente 
**

            ACN(zz1, 0)
*            ACN(zz1, SQL("Select 1 from "~DBO~".CLIENTES where Codigo='"~Val(b:&i)~"' and (CategDepositante='CLI' OR Alias1='CP') ") )
*            ACN(zz2, IIF(DesciendeDeEspecie(Val(d:&i),'MONEDA'),1,0))

            SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES  ")
            SQL.ADD("( Especie, FechaEj, PrecioEj, CallPut, Cliente, Cantidad, ")
            SQL.ADD("  FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, EnteCustodia, ")
            SQL.ADD("  Bits, NrGrupo, Concepto, Formula, ")
            SQL.ADD("  NrMov, NrLiq, Mercado,Book, Cupon, Vehiculo) ")

            SQL.ADD("SELECT M.Especie, M.FechaEj, M.PrecioEj, M.CallPut, M.Cliente, M.Cantidad, ")
            SQL.ADD(" M.FechaMov, M.NrOperacion, M.Cuenta, M.Leyenda, M.NrSaldo - 30 , M.EnteCustodia, ")
            SQL.ADD(" M.Bits, M.NrGrupo, M.Concepto, "~IIF(Val(zz1)=1 y Val(zz2)=0,'10','NULL')~", " )
*            SQL.ADD(" M.NrMov, M.NrLiq,  Mercado,Book, Cupon, Vehiculo ")
            SQL.ADD(" M.NrMov, M.NrLiq,  '"~val(m:&i)~"',Book, Cupon, Vehiculo ")
            SQL.ADD("from "~DBO~".MOVEJECUTADOS M ")

            SQL.ADD("where M.Transaccion  = '"~Val(a1)~"' ")
            SQL.ADD("  and M.NrTrans2     = '"~Val(g:&i)~"' ")
            SQL.NEW

***************************************************************************
*** Borro las cuotas de las derivaciones de liquidaciones 20/12/04
***************************************************************************
            SQL.ADD(" DELETE from "~DBO~".CUOTAS  ")
            SQL.ADD(" where NrOperacion IN (SELECT M.NrOperacion FROM "~DBO~".MOVEJECUTADOS M WHERE M.Transaccion = '"~Val(a1)~"' and M.NrTrans2 = '"~Val(g:&i)~"' and M.NrOperacion = NrOperacion)  ")
            SQL.ADD("  and Vehiculo1 = 'DERIVA'  ")
            SQL.NEW


***************************************************************************
*** Borro los movimientos Ejecutados  ***
***************************************************************************
            SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS  ")
            SQL.ADD("where Transaccion  = '"~Val(a1)~"' ")
            SQL.ADD("  and NrTrans2     = '"~Val(g:&i)~"' ")
            SQL.NEW




***************************************************************************
*** Borro la Transaccion  ***
***************************************************************************
 
            SQL.ADD("DELETE from "~DBO~".TRANSACCIONES2  ")
            SQL.ADD("where NrTrans = '"~Val(g:&i)~"' ")
            SQL.NEW

            *** Borro los movimientos de la transaccion
            SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS   ")
            SQL.ADD("where NrOperacion = '"~Val(g:&i)~"' ")
            SQL.NEW
            SQL.EXEC 

          endif
      Proximo 
   endif

else  
   MessageBox('No existen transacciones para ANULAR con esas especificaciones ')
endif

*********************************************************************
** fin de Anulacion desmarca los movimientos Ejecutados         ******
*********************************************************************

SQL.ADD("Update "~DBO~".MOVEJECUTADOS       ")
SQL.ADD("   Set Transaccion = Null          ")
SQL.ADD(" where Transaccion = '"~val(a1)~"' ")
SQL.NEW
SQL.EXEC
