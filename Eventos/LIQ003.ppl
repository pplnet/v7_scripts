  Cliente1 : 'Cliente'                                               ;5;1;;Dialogo.Radio6<>2;;;;;IIF(Dialogo.Radio6=2,SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'');IIF(Dialogo.Radio6=2,SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'')
