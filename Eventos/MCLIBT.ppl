CrearDialogo
     Cliente1:'Ciente'
FinDialogo

*MessageBox("No existe el directorio"~Dialogo.Cliente1)

IF NOT OK
  Cancelar
Endif




SQL.ADD(" SELECT NrMAE, NrBYMA, NrRofex, TipoCliente, CodigoCNV, ")
SQL.ADD(" Case CatPrestamosBCRA when 'NOR' then 0 when 'RPO' then 1 when 'CPR' then 2 when 'IRR' then 3 when 'IRA' then 4 end CatPrestamosBCRA FROM dbo.CLIENTES ")
SQL.ADD("Where codigo='"~Dialogo.Cliente1~"'")

Recorrer SQL
  ACT(a:fac, fbn('NrMAE'))
  ACT(b:fac, fbn('NrBYMA'))
  ACT(c:fac, fbn('NrRofex'))
  ACT(d:fac, fbn('TipoCliente'))
  ACT(e:fac, fbn('CodigoCNV'))
  ACN(f:fac, fbn('CatPrestamosBCRA'))

Proximo

CrearListBox ; 'Arial,8,'
   'Nro. Mae'              ;a1..a:FAC;SI;;;60;STRING;3
   'Nro. BYMA'             ;b1..b:FAC;SI;;;70;STRING;3
   'Nro. Rofex'            ;c1..c:FAC;SI;;;80;STRING;5
   'Tipo Cliente'          ;d1..d:FAC;SI;;;100;TABLA;'TIPOSCLIENTE';'Codigo';'Codigo;Descripcion';
   'CodigoCNV'             ;e1..e:FAC;SI;;;150;STRING;20
   'Cat.Prest BCRA'        ;f1..f:FAC;SI;;;100;COMBO;'Normal|Riesgo Bajo|Riesgo Medio|Riesgo Alto|Irrecuperable|';

FinListBox

if Ok 
    Recorrer&i 1,fac
        SQL.ADD("Update dbo.CLIENTES set ")
        SQL.ADD("NrMAE='"~Val(a:&i)~"', ")
        SQL.ADD("NrBYMA='"~Val(b:&i)~"', ")
        SQL.ADD("NrRofex='"~Val(c:&i)~"', ")
        SQL.ADD("TipoCliente='"~Val(d:&i)~"', ")
        SQL.ADD("CodigoCNV='"~Val(e:&i)~"', ")
        SQL.ADD("CatPrestamosBCRA='"~iif(Val(f:&i)=0,'NOR',iif(Val(f:&i)=1,'RPO',iif(Val(f:&i)=2,'CPR',iif(Val(f:&i)=3,'IRR','IRA'))))~"' ")
        SQL.ADD("Where codigo='"~Dialogo.Cliente1~"'")
        SQL.NEW
        SQL.EXEC

    proximo
endif
MessageBox('El evento ha finalizado')
