(.'DNLISTA'.)
ACT(ll:1, Val(l:1)~'DNCOBR|')
ACT(l:1, '')

MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'FechaBajada';1;;;;;;;;FSYS
*  Radio1   : 'Archivo|CC $|CC U$|CA $|CA U$|Cobranzas|Otros' ;2;;;;;;;;0
  Vehiculo1: 'Vehiculo'   ;3;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Lista1:    'Bancos'     ; 4;1;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista2:    'Cuentas'    ;-2;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ");
  Lista3:    'Archivo'    ;  ;1;1;;;Novacio(Dialogo.Lista3);'Codigo de Archivo Invalido';NO;;;Val(ll:1)
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ M.*, C.NrOperacion Operacion, C.NrMovimiento NrMov, C.Fecha ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".CONCILIACIONES C, ")
SQL.ADD(" "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE M.NrDataNet    = D.NrDatanet ")
SQL.ADD(" AND   M.NrDataNet    = C.NrDatanet ")
SQL.ADD(" AND   M.NrMovDataNet = C.NrMovDatanet ")
SQL.ADD(" AND   M.Cuenta       = CU.Numero ")
SQL.ADD(" AND   D.FechaBajada  = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.Vehiculo     = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND   M.EstadoConciliacion <> 'P' ")
SQL.ADD(" AND   D.Archivo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
IF NO
* 05/07/2004 INTERFAZ RIO
If Dialogo.Radio1=0
  SQL.ADD(" AND   D.Archivo = 'DNCTAS' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND   D.Archivo = 'DNAHMS' ")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND   D.Archivo = 'DNCCDO' ")
Endif
If Dialogo.Radio1=3
  SQL.ADD(" AND   D.Archivo = 'DNCADO' ")
Endif
If Dialogo.Radio1=4
  SQL.ADD(" AND   D.Archivo = 'DNCOBR' ")
Endif
If Dialogo.Radio1=5
  SQL.ADD(" AND   D.Archivo = 'DNOTRO' ")
Endif
ENDIF
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND   CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND   CU.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" ORDER BY M.Banco, M.Cuenta, M.Moneda ")

ACN(z:1,0)

Recorrer SQL
  ACN(z:1,1)
  ACN(x:fac, 0)
  ACT(a:fac, fbn('NrDatanet'))
  ACN(b:fac, fbn('NrMovDatanet'))
  ACD(c:fac, fbn('FechaIngreso'))
  ACD(d:fac, fbn('FechaAcreditacion'))
  ACT(e:fac, fbn('Banco'))
  ACT(f:fac, fbn('Cuenta'))
  ACT(g:fac, fbn('Moneda'))
  ACN(h:fac, fbn('Importe'))
  ACT(i:fac, fbn('EstadoConciliacion'))
  ACD(j:fac, fbn('Fecha'))
  ACT(k:fac, fbn('Operacion'))
  ACN(l:fac, fbn('NrMov'))
  ACT(m:fac, fbn('DC'))
  ACT(n:fac, fbn('TipoMov'))
  ACT(o:fac, fbn('Comprobante'))
Proximo

If Val(z:1)=0
   Cancelar
Endif

* 05/07/04 Interfaz Rio CrearListBox; 'Arial,8,';'Vehiculo: '~Dialogo.Vehiculo1~' - Archivo: '~IIF(Dialogo.Radio1=0,'CC $',iif(Dialogo.Radio1=1,'CC U$',iif(Dialogo.Radio1=2,'CA $',iif(Dialogo.Radio1=3,'CA U$','Cobranzas'))))
CrearListBox; 'Arial,8,';'Vehiculo: '~Dialogo.Vehiculo1~' - Archivo: '~Dialogo.Lista3
  'Banco'         ;e:1..e:fac;SI;;;70;STRING;;RGB(232,232,232);
  'Cuenta'        ;f:1..f:fac;SI;;;80;STRING;;RGB(232,232,232);
  'Moneda'        ;g:1..g:fac;SI;;;60;STRING;;RGB(232,232,232);
  'Cantidad'      ;h:1..h:fac;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'D/C'           ;m:1..m:fac;SI;;;25;STRING;;RGB(232,232,232);
  'TipoMov'       ;n:1..n:fac;SI;;;45;STRING;;RGB(232,232,232);
  'Comprobante'   ;o:1..o:fac;SI;;;70;STRING;;RGB(232,232,232);
  'F.Ingreso'     ;c:1..c:fac;SI;;;70;FECHA ; RGB(232,232,232);
  'F.Valor'       ;d:1..d:fac;SI;;;70;FECHA ; RGB(232,232,232);
  'Estado'        ;i:1..i:fac;SI;;;60;STRING;;RGB(232,232,232);
  'OK'            ;x:1..x:fac;SI;;;70;CHECK ; RGB(232,255,215);
  'NrOperacion'   ;k:1..k:fac;SI;;;70;STRING;;RGB(221,242,255);
  'F.Conciliacion';j:1..j:fac;SI;;;70;FECHA ; RGB(221,242,255);
FinListBox

If Not Ok
   Cancelar
Endif

Recorrer&i 1,fac
 If Val(x:&i)=1
   message('Actualizando Movimiento Datanet ... ')
   SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVDATANET SET EstadoConciliacion = 'P' WHERE NrDatanet = '"~Val(a:&i)~"' AND NrMovDatanet = "~Fstr(Val(b:&i),0,0)~" ")
   SQL.NEW

   message('Actualizando Movimiento FPA ... ')

* 05/07/04 Interfaz Rio  If Eqstr(Val(i:&i),'OK') y Dialogo.Radio1<>4 y Not Eqstr(BuscarCampo('TRANSACCIONES2','CNFormaPago','NrTrans',Val(k:&i)), 'DATANE')
   If Eqstr(Val(i:&i),'OK') y Not Incluido('DNCOBR',Dialogo.Lista3) y Not Eqstr(BuscarCampo('TRANSACCIONES2','CNFormaPago','NrTrans',Val(k:&i)), 'DATANE')
     SQL.ADD(" INSERT INTO "~DBO~".MOVPENDIENTES ")
     SQL.ADD(" SELECT /*+ RULE */ * FROM "~DBO~".MOVEJECUTADOS ")
     SQL.ADD(" WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~" ")
     SQL.NEW
     SQL.EXEC

*     ACN(xx:1, sql("SELECT /*+ RULE */ NrComprob FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~"  "))
*     ACN(xx:2, sql("SELECT /*+ RULE */ NrGrupo FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~"  "))

     SQL.ADD(" SELECT /*+ RULE */ NrComprob, NrGrupo ")
     SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS ")
     SQL.ADD(" WHERE NrOperacion = '"~Val(k:&i)~"' ")
     SQL.ADD(" AND NrMov = "~Fstr(Val(l:&i),0,0)~" ")
     Recorrer SQL
         DFA
         ACN(XX:1, fbn('NrComprob'))
         ACN(XX:2, fbn('NrGrupo'))
     Proximo

     SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES SET ")
     SQL.ADD(" Status = '' ")
     SQL.ADD(" WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~"  ")
     SQL.NEW

***---     SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET ")
***---     SQL.ADD(" Fecha2 = Fecha3 ")
***---     SQL.ADD(" WHERE NrTrans = '"~Val(k:&i)~"' ")
***---     SQL.NEW
***---Se comenta porque en la conciliacion no se esta actualizando Fecha3, lo que hace que quede
***---en blanco Fecha2.
 
     SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVEJECUTADOS ")
     SQL.ADD(" WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~" ")
     SQL.NEW

     SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor= '0' WHERE NrOperacion = '"~Val(k:&i)~"' AND NrBit = 20 ")
     SQL.NEW
     SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor= '1' WHERE NrOperacion = '"~Val(k:&i)~"' AND NrBit = 18 ")
     SQL.NEW
     SQL.EXEC

     SQL.ActualizarMovimientosT4(Val(k:&i),SI,NO,NO,NO,NO,NO,0)
     SQL.EXEC

     SQL.ADD(" SELECT /*+ RULE */ Fecha3, Chequera1, Cantidad2, CNFormaPago ")
     SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~Val(k:&i)~"' ")
     Recorrer SQL
       dfa
       ACD(fe:1, fbn('Fecha3'))
       ACT(ch:1, fbn('Chequera1'))
       ACN(ch:2, fbn('Cantidad2'))
       ACT(fp:1, fbn('CNFormaPago'))
     Proximo

     If Eqstr(BuscarCampo('CNFORMASPAGOCOBRO','Tipo','Codigo',Val(fp:1)),'CHE') 
       SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES ")
       SQL.ADD(" SET Estado = 'ENT', ")
       SQL.ADD(" FechaPago  = "~idxdate2(Val(fe:1))~" ")
       SQL.ADD(" WHERE  Chequera = '"~Val(ch:1)~"' AND NrCheque = "~FSTR(Val(ch:2),1,0)~" ")
       SQL.NEW
     Endif

     SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVPENDIENTES SET ")
     SQL.ADD(" NrGrupo    = "~Fstr(Val(xx:2), 0, 0)~", ")
     SQL.ADD(" NrComprob  = "~Fstr(Val(xx:1), 0, 0)~" ")
     SQL.ADD(" WHERE NrOperacion = '"~Val(k:&i)~"' AND NrMov = "~Fstr(Val(l:&i),0,0)~"  ")
     SQL.NEW
     SQL.EXEC
   Else
     SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVEJECUTADOS   WHERE NrOperacion = '"~Val(k:&i)~"' ")
     SQL.NEW
     SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES   WHERE NrOperacion = '"~Val(k:&i)~"' ")
     SQL.NEW
     SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion = '"~Val(k:&i)~"' ")
     SQL.NEW
     SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".TRANSACCIONES2  WHERE NrTrans = '"~Val(k:&i)~"' ")
     SQL.NEW
   Endif

   SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".CONCILIACIONES ")
   SQL.ADD(" WHERE NrDatanet = '"~Val(a:&i)~"' AND NrMovDatanet = "~Fstr(Val(b:&i),0,0)~" ")
   SQL.NEW

   Message('Abriendo Conciliacion '~Val(a:&i) )
   SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".DATANET SET Estado = 'A' WHERE NrDatanet = '"~Val(a:&i)~"' ")
   SQL.NEW
   SQL.EXEC
 Endif
Proximo