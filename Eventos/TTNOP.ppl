*- TTNOP: Calculo de TTN para Operaciones
*- Si se llama de una op. de SWAP entro con el nro. de op. de mm asociado
CrearDialogo
   NrOperacion1: "NrOperacion"       ;;;;;;;;;;;;;;" TipoOp Like 'MM%' "
   Entero1     : 'CuotaOpMM'         ;;;;;;;;;1;;;
   NrOperacion2: "OpSwap"            ;;;;;;;;;;;;;;" TipoOp Like 'DT%' "
   Lista1      : 'CuotaOpSwap'       ;;;;;;
FinDialogo

If not Ok
   Cancelar
EndIf

***---Formula: BA1 + BB2 + BC3
***---BA1 = [(Tasa+Spread)*(1+WHT/100)*(1+Endeudamiento/100)+Suma Comisiones en %]*DA1
***---BB1 = (Suma montos Comisiones Flat * 100) / (plazo en dias / 360) / Monto Notional sin EF (Sin EF s/Mail de Alicia del 21.11.02)
***---BC1 = (Suma montos comisiones AGCY * 100) / Monto Notional sin EF (Sin EF s/Mail de Alicia del 19.11.02)
***---BD1 = (Suma montos Comisiones EF * 100) / (plazo en dias / 360) / Monto Inicial sin EF
***---MO2 = MO1 / (1+(Tasa/100))
***---DA1 = 1 Si Day/Acount de la operacion es ACT/360, sino 365/360

*- Las comisiones que se relacionan con el pago de cuota se tienen en cuenta para esa cuota solamnete.
*- El resto de las comisiones se aplica para cada cuota

SQL.ADD(" Select O.NrOperacion,0 NrCuota,O.*,0 CPrecio2,0 CPrecio4,")
SQL.ADD(" 0 CPrecio3,0 CTasa3,0 Cantidad3, 0 Capital, 0 CEC, 0 FinCEC, 0 CEN, O.FechaOp as Fecha,O.FechaVto as Fecha2")
SQL.ADD(" FROM "~DBO~".OPERACIONES O Where ")
SQL.ADD(" O.NrOperacion='"~Dialogo.NrOperacion1~"' and ")
SQL.ADD(" O.TipoOp In ('MMCCR','MMCP','MMDCA','MMFRN','MMFRNP','MMO','MMON','MMPCCV','MMPCL','MMPCOS','MMPSC','MMPSI','MMPE','MMPI')")
SQL.ADD(" Union All ")
SQL.ADD(" Select O.NrOperacion,C.NrCuota,O.*,C.Precio2 CPrecio2,C.Precio4 CPrecio4,")
SQL.ADD(" C.Precio3 CPrecio3,C.Tasa3 CTasa3,C.Cantidad3, C.Cantidad2 Capital, C.Cantidad6 CEC, ")
SQL.ADD(" C.Cantidad7 FinCEC, C.Plazo4 CEN, C.Fecha1 as Fecha,C.Fecha2 as Fecha2 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C Where ")
SQL.ADD(" O.NrOperacion='"~Dialogo.NrOperacion1~"' and O.NrOperacion=C.NrOperacion and ")
SQL.ADD(" O.TipoOp In ('MMCPM','MMSCMV','MMFCMV','MMFIMV','MMONM','MMPCCM','MMPCLM','MMPOSM','MMSIMV','MMPEM','MMPIM') ")
If Dialogo.Entero1>0
   SQL.ADD(" and C.NrCuota="~Fstr(Dialogo.Entero1,0,0)~" ")
EndIf
SQL.ADD(" Order By 1,2 ")

*- tt1: TTN
*- ta1: Tasa
*- sp1: Spread
*- im1: Impuestos
*- at1: Nombre del Atributo a Grabar la Tasa
***---MO1 = Monto Notional
***---MO2 = Monto Notional sin EF
***---CF:1 = Comision Flat
***---CA:1 = Comision AGCY
***---CE:1 = Comision EF
***---CC:1 = Comision Restantes

Recorrer SQL

  *--- RB8:'Day Count|ActAct|Act365F|Act360|360360|30E360';;;;NO;;RB8>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;;OPREF.RB8
  IF fbn('RB8') = 2
      ***---ACT/360
      ACN(DA:1, 1)
  ELSE
      ACN(DA:1, 365/360)
  ENDIF

  ACN(PL:1, fbn('Plazo')/360)
  IF Incluido(fbn('TipoOp'), 'MMCP|MMDCA|MMFRNP|MMO|MMON|MMPCCV|MMPCL|MMPCOS|MMPSC|MMPSI|MMPE|MMPI')
      ACN(MO:1, fbn('Cantidad'))
  ENDIF
  IF Incluido(fbn('TipoOp'), 'MMFRN|')
      ACN(MO:1, fbn('PrecioEj'))
  ENDIF
  IF Incluido(fbn('TipoOp'), 'MMCPM|MMFCMV|MMFIMV|MMONM|MMPCCM|MMPCLM|MMPOSM|MMSCMV|MMSIMV|MMPEM|MMPIM')
      ACN(MO:1, fbn('Capital'))
  ENDIF

  *---- Corte de Control por Operacion
  If Not EqStr(val(co1),FBN['NrOperacion'])
     ACT(co1,FBN['NrOperacion'])
     ACN(CF:2, 0)
     ACN(CA:2, 0)
     ACN(CC:2, 0)
     ACN(CE:2, 0)

     *- Recupero las comisiones de la operacion Para Distribuir en todas las cuotas
     SQL.ADD("Select * FROM "~DBO~".COMISIONES2 Where ")
     SQL.ADD("NrOperacion='"~Dialogo.NrOperacion1~"' ")
     SQL.ADD(" and (NrCuota Is Null or NrCuota=0) ")
      SQL.ADD(" AND Tipo Not IN ('4') ")
     SQL.ADD("Order By Fecha1")

     Recorrer SQL
        dfa
        IF Incluido(fbn('Tipo'), '0|1|')
            ***---Comisiones Flat: FPD o FFC => tomo el monto
            SCN(CF:2, fbn('Importe1'))
        ENDIF
        IF Eqstr(fbn('Tipo'), '2')
            ***---Comisiones AgencyFee: CDO => tomo el monto
            SCN(CA:2, fbn('Importe1'))
        ENDIF
        IF Incluido(fbn('Tipo'), '3|4')
            ***---Comisiones CPI o CF => tomo la tasa
            SCN(CC:2, fbn('Tasa1'))
        ENDIF
        IF Eqstr(fbn('Tipo'), '5')
            ***---Comision EF => tomo el monto y la tasa
            SCN(CE:2, fbn('Importe1'))
            ACN(TE:1, val(ce:2)*100/(val(mo1)-val(ce:2)))
        ENDIF
     Proximo

  *- Partidas Relacionadas
  ACT(OF:1,'')
  ACT(OF:1, BuscarCampo('OPERACIONES','OperacionRef','NrOperacion', Dialogo.NrOperacion1))

  If NoVacio(val(of:1))
      *- of2: Capital de la Operacion cabecera para calcular 
      *- el importe de la comision correspondiente al item 

      *- of3: Capital de la operacion item
      ACN(OF:2, BuscarCampo('OPERACIONES','Cantidad+TotalComisiones','NrOperacion', val(of:1)))
   
      ACN(OF:3, FBN['Cantidad']+FBN['TotalComisiones'])

      ***---Busco las comisiones de la cabecera. Las CPI y EF ya las tienen.
      SQL.ADD("Select * FROM "~DBO~".COMISIONES2 Where ")
      SQL.ADD(" NrOperacion='"~Val(OF:1)~"' ")
      SQL.ADD(" and (NrCuota Is Null or NrCuota=0) ")
      SQL.ADD(" AND Tipo Not IN ('3','5','4') ")
      SQL.ADD(" Order By Fecha1")

      Recorrer SQL

         dfa

         IF Incluido(fbn('Tipo'), '0|1|')
             ***---Comisiones Flat: FPD o FFC => tomo el monto 
             SCN(CF:2, (fbn('Importe1')*val(of:3))/val(of:2) )
         ENDIF
         IF Eqstr(fbn('Tipo'), '2')
             ***---Comisiones AgencyFee: CDO => tomo el monto
             SCN(CA:2, (fbn('Importe1')*val(of:3))/val(of:2) )
         ENDIF
         IF Incluido(fbn('Tipo'), '4')
             ***---Comision CF => tomo la tasa
             SCN(CC:2, fbn('Tasa1'))
         ENDIF
      Proximo
  ENDIF
  EndIf


  ACN(CF:1, Val(CF:2))
  ACN(CA:1, Val(CA:2))
  ACN(CE:1, Val(CE:2))
  ACN(CC:1, Val(CC:2))

  If Incluido(FBN['TipoOp'],'MMCP|MMDCA|MMO|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['ImpGastos1']+FBN['DeltaTasa'])
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPSI|MMPSC|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['TasaImp1']+FBN['TotalAux1'])
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMFRNP|MMFRN|MMON|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMCPM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['ImpGastos1']+FBN['DeltaTasa'])
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMFIMV|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     ACT(at1,'Total3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMONM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['CTasa3']+FBN['TotalAux1'])
     ACT(at1,'Total3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCCM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,IIf(FBN['RB6']=2,FBN['TotalAux1'],0)+IIF(FBN['RB6']=3 o FBN['RB6']=4,FBN['TasaPrecan'],0)+IIF(FBN['MB3']=1,FBN['TasaBase'],0))
     ACT(at1,'Precio3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCCV|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,IIf(FBN['RB6']=2,FBN['TotalAux1'],0)+IIF(FBN['RB6']=3 o FBN['RB6']=4,FBN['TasaPrecan'],0)+IIF(FBN['MB3']=1,FBN['TasaBase'],0))
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCL|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['TasaImp1'])
     SCN(CA:1, fbn('ImpComCor1') + fbn('PeriodoInts'))
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCLM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['TasaImp1'])
     SCN(CA:1, fbn('CEC') + fbn('FinCEC'))
     ACT(at1,'Precio3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPCOS|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     SCN(CA:1, fbn('ImpComCorEq2'))
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPOSM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     SCN(CA:1, fbn('CEC'))
     ACT(at1,'Precio3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPEM|MMPIM|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     SCN(CA:1, fbn('CEC') + fbn('CEN'))
     ACT(at1,'Precio3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMPE|MMPI|')
     ACN(ta1,FBN['Precio1'])
     ACN(sp1,FBN['Spread'])
     ACN(im1,FBN['TotalAux1']+FBN['TasaImp1'])
     SCN(CA:1, fbn('ImpComCorEq2')+fbn('PorComMer1'))
     ACT(at1,'Precio4')
  EndIf

  If Incluido(FBN['TipoOp'],'MMSIMV|')
     ACN(ta1,FBN['CPrecio2'])
     ACN(sp1,FBN['CPrecio4'])
     ACN(im1,FBN['TasaImp1']+FBN['TotalAux1'])
     ACT(at1,'Total3')
  EndIf

  If FBN['NrCuota']>0
     *- Recupero las comisiones de la operacion y distribuyo porcentajes
     SQL.ADD("Select * FROM "~DBO~".COMISIONES2 Where ")
     SQL.ADD("NrOperacion='"~Dialogo.NrOperacion1~"' ")
     SQL.ADD("and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
      SQL.ADD(" AND Tipo Not IN ('4') ")
     SQL.ADD("Order By Fecha1")
     Recorrer SQL
       dfa
       IF Incluido(fbn('Tipo'), '0|1|')
           ***---Comisiones Flat: FPD o FFC => tomo el monto
           SCN(CF:1, fbn('Importe1'))
       ENDIF
       IF Eqstr(fbn('Tipo'), '2')
           ***---Comisiones AgencyFee: CDO => tomo el monto
           SCN(CA:1, fbn('Importe1'))
       ENDIF
       IF Incluido(fbn('Tipo'), '3|4')
           ***---Comisiones CPI o CF => tomo la tasa
           SCN(CC:1, fbn('Tasa1'))
       ENDIF
       IF Eqstr(fbn('Tipo'), '5')
           ***---Comision EF => tomo el monto y la tasa
           SCN(CE:1, fbn('Importe1'))
           ACN(TE:1, fbn('Tasa1'))
       ENDIF
     Proximo  
  EndIf

  ACD(fe1,FBN['Fecha'])
  ACD(fe2,FBN['Fecha2'])

  *- Si la operacion tiene swap solo se toman los fees de la op. ppal y la tasa de los swaps
  SQL.ADD("Select O.FechaOp,O.*,O.Cantidad VResidual,O.Precio3 Tasa,O.Spread ,O.FechaOp2 Fecha1,O.TotalBrutoCli1 Cantidad2,")
  SQL.ADD("       O.TotalGanancias Tasa2,O.TotalNetoCli2 Total4,O.FechaOp2 Fecha5,Cantidad Cantidad6,")
  SQL.ADD("       TotalBrutoCli1 Cantidad5,0 NrCuota,O.FechaOp Fecha2,O.FechaVto Fecha6,O.TipoOp,O.TotalIntereses InteresC ")
  SQL.ADD("from   "~DBO~".OPERACIONES O ")
  SQL.ADD("where  O.OperacionRef='"~val(co1)~"' ")
  SQL.ADD("       and TipoOp In ('DTSFF','DTSFV','DTSVV') ")
  SQL.ADD("Union All ")
  SQL.ADD("Select O.FechaOp,O.*, C.Cantidad1 VResidual,C.Precio1 Tasa,C.Total3 Spread,C.Fecha1,C.Cantidad2, ")
  SQL.ADD("       C.Precio2 Tasa2,C.Total4,C.Fecha5,C.Cantidad6,C.Cantidad5,C.NrCuota,C.Fecha2,C.Fecha6,O.TipoOp,C.Cantidad3 as InteresC ")
  SQL.ADD("from   "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
  SQL.ADD("where  O.NrOperacion = C.NrOperacion  ")
  SQL.ADD("       and O.OperacionRef = '"~val(co1)~"' ")
  If NoVacio(Dialogo.NrOperacion2) y NoVacio(Dialogo.Lista1)
     SQL.ADD("   and (( O.NrOperacion='"~Dialogo.NrOperacion2~"' and C.NrCuota In ("~Pipe2Comillas(Dialogo.Lista1)~")) or O.OperacionRef = '"~val(co1)~"') ")   
  EndIf
  SQL.ADD("       and TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
  *- Cuota vigente de DT o cuya fecha de reset sea 
  SQL.ADD("       and ((C.Fecha1<="~IdxDate2(Fsys)~" and C.Fecha2>="~IdxDate2(Fsys)~") or ("~IdxDate2(Fsys)~">=C.Fecha4 and "~IdxDate2(Fsys)~"<=C.Fecha1)) ")   
  SQL.ADD("       and (C.Fecha2>="~IdxDate2(val(fe1))~" and C.Fecha1<="~IdxDate2(val(fe2))~")")   
  SQL.ADD("Order By 1")      

  ACN(pi1,0)
  ACN(ts1,0)
  ACN(ss1,0)
  ACT(os1,'')

  Recorrer SQL   
     Message(fbn('NrOperacion')~' '~fbn('NrCuota'))
     dfa 
     If val(pi1)=0
        ACN(pi1,1)
        ACN(ta1,0)
        ACN(sp1,0)
        ACN(im1,0)
     EndIf

     If Not EqStr(val(os1),fbn('NrOperacion'))
        ACT(os1,fbn('NrOperacion'))
        *- Solo para la 1er. cuota
        SCN(ts1,FBN['Tasa'])         
        SCN(ss1,FBN['Spread_1'])         
     EndIf
  Proximo

  ACN(IM:1, Val(IM:1)/100)
  ACN(CF:1, Val(CF:1)*100)
  ACN(CA:1, Val(CA:1)*100)
  ACN(CE:1, Val(CE:1)*100)
  ACN(MO:2, Val(MO:1) / (1+(Val(TE:1)/100)))

  ACN(BA:1, ((Val(TA:1)+Val(SP:1))*(1+Val(IM:1))+Val(CC:1))*Val(DA:1))
  ACN(BB:1, (Val(CF:1) / Val(PL:1)) / Val(MO:2))

  *- AgCy Fee dividido Monto sin EF
  ACN(BC:1, Val(CA:1) / Val(MO:2))

  *- EF dividido por el monto inicial de la operacion
  * ACN(BD:1, (Val(CE:1) / Val(PL:1)) / Val(MO:2))
  ACN(BD:1, (Val(CE:1) / Val(PL:1)) / FBN['Cantidad'])

*messageBOX('[(Tasa+Spread)*(1+WHT/100)*(1+Endeudamiento/100)+Suma Comisiones en %]*DA1 '~Fstr(Val(ba:1),0,10))
*messageBOX('(Suma montos Comisiones Flat * 100) / (plazo en dias / 360) / Monto Notional sin Ef '~Fstr(Val(bb:1),0,10))
*messageBOX('(Suma montos comisiones AGCY * 100) / Monto Notional sin Ef '~fstr(Val(bc:1),0,10))
*messageBOX('(Suma montos Comisiones EF * 100) / (plazo en dias/360) / Monto Inicial sin EF '~Fstr(Val(bd:1),0,4))

  ACN(TT:1, Val(BA:1) + Val(BB:1) + Val(BC:1) + Val(BD:1))

  If val(pi1)=1
     *- Tiene swap relacionados => tt1 adiciono tasa + spread del swap
     SCN(TT:1, val(ts1)+val(ss1))
  EndIf

  If Incluido(FBN['TipoOp'],'MMFCMV|MMSCMV|')
     *- Para Sindicados y Frn cabecera se hace Suma de capital * Ttn del item dividido la suma de capitales
     ACN(TT1,SQL("Select SUM(C.Cantidad2*C.Total3)/SUM(C.Cantidad2) from "~DBO~".CUOTAS C,"~DBO~".OPERACIONES O where O.NrOperacion=C.NrOperacion and O.OperacionRef='"~Dialogo.NrOperacion1~"' and C.NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ") )
     ACT(at1,'Total3')
  EndIf

  If Incluido(FBN['TipoOp'],'MMCCR')
     *- Para Sindicados y Frn cabecera se hace Suma de capital * Ttn del item dividido la suma de capitales
     ACN(TT1,FBN['Precio1'])
     ACT(at1,'Precio4')
  EndIf


  If FBN['NrCuota']=0
     SQL.ADD("Update "~DBO~".OPERACIONES Set "~val(at1)~"="~Fstr(val(tt1),0,8)~" Where ")
     SQL.ADD("NrOperacion = '"~FBN['NrOperacion']~"' ")
  Else
     SQL.ADD("Update "~DBO~".CUOTAS Set "~val(at1)~"="~Fstr(val(tt1),0,8)~" Where ")
     SQL.ADD("NrOperacion = '"~FBN['NrOperacion']~"' and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
  EndIf
  SQL.NEW
  SQL.EXEC
Proximo


