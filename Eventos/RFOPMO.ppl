CrearDialogo
  Fecha6      : 'F.Renovacion'  ; 1;;;;;;;;;FSYS
  NrOperacion1: 'Nr.Operacion'  ; 2;;;;;NOVACIO(Dialogo.NrOperacion1) Y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'PMU|PME');'La operacion debe ser PMU o PME';NO;;;;;;" TipoOp in ('PMU','PME') "
  Cliente1    : 'Cliente'       ; 4;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Especie1    : 'Especie'       ; 5;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1)
  Cantidad1   : 'Cantidad'      ; 6;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1)
  Precio1     : 'Tasa Cliente'  ; 7;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Precio1','NrOperacion',Dialogo.NrOperacion1)
  Cantidad3   : 'Prevision'     ; 8;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','TotalRetenciones','NrOperacion',Dialogo.NrOperacion1)
  Fecha1      : 'F.Op'          ; 9;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion1)
  Fecha2      : 'F.Vto'         ;10;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)
  Vehiculo1   : 'Vehiculo'      ;11;;;NO;NoVacio(Dialogo.NrOperacion1);;;;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
  Fecha5      : 'F.Vto2'        ;12;;;NO;SI;;;;;BuscarCampo('OPERACIONES','FechaVto2','NrOperacion',Dialogo.NrOperacion1)
  Book1       : 'Book'          ;13;;;NO;SI;;;;;BuscarCampo('OPERACIONES','Book1','NrOperacion',Dialogo.NrOperacion1)
  TipoOp1     : 'TipoOp'        ;14;;;NO;SI;;;;;BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1)  

  NrOperacion2: 'Op.Fondeo'     ; 2;2;;;;NOVACIO(Dialogo.NrOperacion2) Y EQSTR(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion2),'IMM');'La operacion debe ser IMM';NO;;;;;;" TipoOp ='IMM' and Cliente1= '"~Dialogo.Cliente1~"' and Especie= '"~Dialogo.Especie1~"' and Vehiculo1= '"~Dialogo.Vehiculo1~"' "
  Cliente2    : 'Cliente'       ; 4;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion2)
  Especie2    : 'Especie'       ; 5;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion2)
  Cantidad2   : 'Cantidad'      ; 6;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion2)
  Precio2     : 'Tasa Sales'    ; 7;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Precio2','NrOperacion',Dialogo.NrOperacion2)
  Precio3     : 'Tasa Trader'   ; 8;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Precio3','NrOperacion',Dialogo.NrOperacion2)
  Fecha3      : 'F.Op'          ; 9;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion2)
  Fecha4      : 'F.Vto'         ;10;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion2)
  Vehiculo2   : 'Vehiculo'      ;11;2;;NO;NoVacio(Dialogo.NrOperacion2);;;;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion2)
  NrOperacion3: 'NrOperacion2'  ;12;2;;NO;SI;;;;;BuscarCampo('OPERACIONES','NrOperacion2','NrOperacion',Dialogo.NrOperacion2)
FinDialogo

if not OK
  Cancelar
endif

if NOVACIO(Dialogo.NrOperacion3)
   Cancelar('La IMM ya esta vinculada a un prestamo')
endif

*if not Dialogo.Fecha5<=Dialogo.Fecha6
*endif
if Dialogo.Fecha5 > Dialogo.Fecha6
   MessageBox('D.F5: '~Dialogo.Fecha5~' > D.F6: '~Dialogo.Fecha6)
   Cancelar('La FechaVto del Fondeo debe ser menor o igual a la Fecha de Renovacion')
endif

if Eqstr(Dialogo.TipoOp1,'PMU')
   if not Dialogo.Fecha4<=Dialogo.Fecha2
      Cancelar('La FechaVto de la IMM debe ser menor o igual a la del prestamo')
   endif
   if not (Dialogo.Cantidad2+Dialogo.Cantidad3)>=Dialogo.Cantidad1
      Cancelar('La Cantidad de la IMM mas la Prevision debe ser mayor o igual a la del Prestamo')
   endif
else
   if Eqstr(Dialogo.TipoOp1,'PME')
      ACD(f1,SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 > '"~IdxDate(Dialogo.Fecha5)~"' and Fecha2 <= '"~IdxDate(Dialogo.Fecha5)~"' "))
      if Dialogo.Fecha4 <= val(f1)
         Cancelar('La FechaVto de la IMM debe ser menor o igual a la cuota vigente del prestamo')
      endif
      ACN(f2,SQL("Select Cantidad5 from "~DBO~".CUOTAS where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 > '"~IdxDate(Dialogo.Fecha5)~"' and Fecha2 <= '"~IdxDate(Dialogo.Fecha5)~"' "))
      if not (Dialogo.Cantidad2+Dialogo.Cantidad3)>=val(f2)
         Cancelar('La Cantidad de la IMM mas la Prevision debe ser mayor o igual al saldo de la cuota vigente')
      endif
   endif
endif

if not EQSTR(Dialogo.Vehiculo2,Dialogo.Vehiculo1)
   Cancelar('El Vehiculo de la IMM debe ser igual al del prestamo')
endif

if not EQSTR(Dialogo.Cliente2,Dialogo.Cliente1)
   Cancelar('La Cliente de la IMM debe ser igual al del prestamo')
endif

if not EQSTR(Dialogo.Especie2,Dialogo.Especie1)
   Cancelar('La Especie de la IMM debe ser igual a la del prestamo')
endif

* Guardo la IMM y la fecha de fondeo en la PMU
SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion2='"~Dialogo.NrOperacion2~"', ")
SQL.ADD("FechaVto2='"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"'")
SQL.NEW

* Guardo la PMU y el book del prestamo en la IMM
SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion2='"~Dialogo.NrOperacion1~"', ")
SQL.ADD("ObsErrorMAE='"~Dialogo.Book1~"' ")
SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion2~"'")
SQL.NEW

SQL.EXEC

*** Actualizacion de Devengados de la IMM ***
SQL.ActualizarMovimientos3(Dialogo.NrOperacion2,NO,NO,NO,NO,SI,0)
SQL.EXEC

Messagebox('Renovacion del fondeo del prestamo satisfactoria')



