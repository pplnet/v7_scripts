CrearDialogo
    Directorio1: "Ruta";;;;;;;;;Var('PATHINFUT')
    String1:    "Archivo" ;;;;;;;;;'ROFEX-MigracionContratos.xls'
FinDialogo

If Not Ok
    Cancelar
EndIf

HojaVisible(SI)

@VALIDPATH

ACT(z1, IIF(EqStr(Copy(Dialogo.Directorio1, Longitud(Dialogo.Directorio1), 1), "\"), Dialogo.Directorio1, Dialogo.Directorio1~'\'))

ImportarXLS(a1..p:10000, a1..p:10000, Val(z1)~Dialogo.String1)

SetFilaActual(2)

&OpCargadas := 0
&OpNoCargadas := 0
&OpDuplicadas := 0

Recorrer&i 2, 10000
    If Vacio(Val(a:FAC))
        Break
    EndIf
   
    *Verificar si ya existe esa boleta
    &boleta := Query("SELECT 1 FROM "~DBO~".OPROFEX WHERE Boleta = '"~FStr(Val(c:FAC),1,0)~"' ") 
    
    If &boleta = 1
        *Si existe no la cargo 
        &OpDuplicadas := &OpDuplicadas + 1
    
    Else
        &IdComitente := Query("SELECT Top(1) NrRofex FROM "~DBO~".Clientes WHERE AliasBt = '"~Val(d:FAC)~"'")
        
        If Vacio(&IdComitente)
            *MessageBox("La boleta: "~FStr(Val(c:FAC),1,0)~" no se cargo."~Chr(13)~Chr(10)~"Debido a que no cuenta con un codigo de cliente asociado.") 
            AgregarMarco(a:FAC..p:FAC,1,0, EXE('COLOR5'))
            &OpNoCargadas := &OpNoCargadas + 1
        Else
            
            If Eqstr(Mayusculas2(Copy(Val(f:FAC),1,1)),"C")
                ACN(f:FAC,3)
                &IdCpraVta := 3
            Else
                ACN(f:FAC,1)
                &IdCpraVta := 1
            EndIf
            
            SQL.ADD("INSERT INTO "~DBO~".OPROFEX ")
            SQL.ADD("(  Boleta,     IdContrato,     Origen,         TipoEjecucion,      ")
            SQL.ADD("   Posicion,   TipoContrato,   Ejercicio,      IdCpraVta,          ")
            SQL.ADD("   Precio,     Cantidad,       IdComitente,    Fecha,              ")
            SQL.ADD("   Hora,       Vto,            Procesado,      NrOperacion,        ")
            SQL.ADD("   FechaReal,  Warning,        Anulada,        Currency,           ")
            SQL.ADD("   MarketId,   TrdRptStatus,   RootPartyId,    RootPartyIdSource   ")
            
            SQL.ADD(" ) Values ( ")
            
            SQL.ADD("   '"~FStr(Val(c:FAC),1,0)~"',                     '0',                            '0',                    '0',                        ")
            SQL.ADD("   '"~Val(k:FAC)~"',                               '1',                             0,                     "~FStr(&IdCpraVta,1,0)~",   ")
            SQL.ADD("   "~Val(l:FAC)~",                                 "~FStr(Val(h:FAC),1,0)~",       '"~&IdComitente~"',     '"~IdxDate(Val(a:FAC))~"',        ")
            SQL.ADD("   '"~ReemplazarSTR(Val(b:FAC),":","",SI)~"',      '"~IdxDate(Val(n:FAC))~"',      '0',                    '',                         ")
            SQL.ADD("   '"~(IdxDate(FSYS)~" "~Val(B:FAC))~"',     '',                             'NO',                   'ARS',                      ")
            SQL.ADD("   'ROFX',                                         0,                              '',                     ''                          )")
            SQL.NEW
            SQL.EXEC
            
            &OpCargadas := &OpCargadas + 1
            EndIf
    EndIf
    
    ACD(a:FAC,Val(a:FAC))
    ACD(n:FAC,Val(n:FAC))
    ACT(c:FAC,FStr(Val(c:FAC),1,0))
    
    IFA
Proximo

AlinearCeldas(a:1..p:FAC,'I')
 
ACO(1,10)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,25)
ACO(6,7)
ACO(7,10)
ACO(8,10)
ACO(9,7)
ACO(10,7)
ACO(11,10)
ACO(12,8)
ACO(13,6)
ACO(14,8)
ACO(15,12)
ACO(16,8)

MessageBox("Total de Operaciones: "~FStr(&OpCargadas+&OpNoCargadas+&OpDuplicadas,1,0)~"."~Chr(13)~Chr(10)~"Operaciones Cargadas: "~FStr(&OpCargadas,1,0)~"."~Chr(13)~Chr(10)~"Operaciones Duplicadas - No Cargadas: "~FStr(&OpDuplicadas,1,0)~"."~Chr(13)~Chr(10)~"Operaciones no Cargadas: "~FStr(&OpNoCargadas,1,0)~".")







