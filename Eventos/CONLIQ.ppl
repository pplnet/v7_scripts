* Este evento pasa las operaciones desde la instancia 80 (Confirmacion) a la 10 (Liquidacion).
* Este evento se hizo para no modificar los eventos del mae y maeaux y dejarlo como en las otras
* instalaciones, y que para cuando se confirman, automaticamente pasen a la instancia 10        

SQL.ADD("SELECT O.NrOperacion,O.NrOrden1,O.TipoOp,O.PaseCB,O.MinDerechoBolsa,O.MinArancel,MinDerechoMercado, ")
SQL.ADD("O.NrOperacion,O.Cantidad, O.CB7, O.CB8, O.CB5, C.NrMAE ")
SQL.ADD("FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("WHERE O.Cliente1 = C.Codigo  AND ")
SQL.ADD("      OB.NrBit = 80  AND ")
SQL.ADD("      OB.Valor = '1' AND ")
SQL.ADD("      OB.NrOperacion = O.NrOperacion ")
SQL.ADD("ORDER BY O.NrOperacion ")
        
Recorrer SQL
   IF Incluido(FBN['TipoOp'], 'TIC|TIV|TIFV|TIFC|TCOPRI')
      IF EqStr(FBN['PaseCB'],'0')
         IF NoVacio(FBN['NrOrden1'])
            * -------Para ordenes de clientes, no va en dbo. --------- *
            *--------------------------------------------------------- *
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
            SQL.ADD("WHERE NrBit = 10 AND ")
            SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
            SQL.NEW
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
            SQL.ADD("WHERE (NrBit = 80 OR ")
            SQL.ADD("       NrBit = 9) AND ")
            SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
            SQL.NEW
            SQL.EXEC
         ELSE
               IF Incluido(FBN['TipoOp'], 'TCOPRI|TIC|TIV|TIFC|TIFV') y Eqstr(fbn('CB5'),'1') y Not Eqstr(fbn('CB8'),'1')
                  * --- FO 12/10/05 Operaciones que vienen del MAE, tienen que ir a carga trader 
                  * --- para que le asignen book
                  SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
                  SQL.ADD("WHERE NrBit = 1 AND ")
                  SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
                  SQL.NEW             
               Else
                  IF NO 
                  * FO 29/09/2006
                    * --- RESTO DE LAS OP Y TCOPRI MANUALES
                    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
                    If NOVACIO(fbn('NrMAE')) y NOt eqstr(fbn('NrMAE'),'0') y NOt eqstr(fbn('NrMAE'),'00') y NOt eqstr(fbn('NrMAE'),'000')
                       * FO 11/10/2005 Las op de agentes van directo a liquidacion, el resto va Confirmarcion.
                       SQL.ADD("WHERE NrBit = 10 AND ")
                    Else
                       * FO 11/10/2005 Si no es agente o la op no va al mae, va a confirmacion
                       SQL.ADD("WHERE NrBit = 7 AND ")
                    Endif
                    SQL.ADD(" NrOperacion = '"~FBN['NrOperacion']~"' ")
                    SQL.NEW
                  ENDIF

                  * FO 29/09/2006 El resto de las op son NO Ofertas u Ofertas MAE1, todas van a liquidacion
                  SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
                  SQL.ADD("WHERE NrBit = 10 AND ")
                  SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
                  SQL.NEW             
               Endif

            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
            SQL.ADD("WHERE NrBit = 80 AND ")
            SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
            SQL.NEW
            SQL.EXEC
         ENDIF
      ELSE
         * ES PASE
         IF Incluido(FBN['TipoOp'], 'TCOPRI|TIC|TIV|TIFC|TIFV') y Eqstr(fbn('CB5'),'1')
            * --- Pases (patas) que vienen del MAE, tienen que ir a instancia Aux
            * --- para que se genere el pase
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
            SQL.ADD("WHERE NrOperacion = '"~FBN['NrOperacion']~"'   ")
            SQL.NEW
            SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
            SQL.ADD("WHERE NrBit = 73 AND ")
            SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
            SQL.NEW
            SQL.EXEC
         else
            SQL.ADD("SELECT COUNT(1) Cantidad ")
            SQL.ADD("FROM "~DBO~".OPERACIONESBITS ")
            SQL.ADD("WHERE NrOperacion IN (SELECT OperacionRef ")
            SQL.ADD("                      FROM "~DBO~".OPERACIONES ")
            SQL.ADD("                      WHERE NrOperacion = '"~FBN['NrOperacion']~"') AND ")
            SQL.ADD("      Valor = 1 AND ")
            SQL.ADD("      NrBit IN (2,3,30,74) ")
            ACT(z1, 'NO')
            Recorrer SQL
               IF FBN['Cantidad'] = 0
                  ACT(z1, 'SI')
               ENDIF
            Proximo
            IF EqStr(Val(z1),'SI')
               SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
               If NOVACIO(fbn('NrMAE')) y NOt eqstr(fbn('NrMAE'),'0') y NOt eqstr(fbn('NrMAE'),'00') y NOt eqstr(fbn('NrMAE'),'000')
                  * Las op de agentes van directo a liquidacion, el resto va Confirmarcion.
                  SQL.ADD("WHERE NrBit = 10 AND ")
               Else
                   SQL.ADD("WHERE NrBit =  7 AND ")
               Endif
               SQL.ADD(" NrOperacion = '"~FBN['NrOperacion']~"' ")
               SQL.NEW
               SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
               SQL.ADD("WHERE NrBit = 80 AND ")
               SQL.ADD("      NrOperacion = '"~FBN['NrOperacion']~"' ")
               SQL.NEW
               SQL.EXEC
            ENDIF
         Endif
      ENDIF
   ENDIF
Proximo

*message('Afectacion Limites de Manifestaciones')
*EJECUTAREVENTO('AFLICP',Fecha1=fsys,NrOrden1='')

       