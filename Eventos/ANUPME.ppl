CrearDialogo
  NrOperacion1: 'Nr.Operacion'  ; 1;1;;;;;;;;;;;;" TipoOp ='PME' "
  Fecha1      : 'Fecha'         ; 2;1;;;;;;;;FSys
  Radio1      : 'Llamado|NO|SI'; 3;1;;NO;  ;;;;0;
FinDialogo

if Not ok
  Cancelar
endif

if Dialogo.Radio1=0

messagebox("codigo evento")
ACN(t1, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov="~Idxdate2(Dialogo.Fecha1)~" and NrSaldo = 1 and NrGrupo<>1 "))
if val(t1)>0
  Cancelar("No puede Anular el Pago. Existen Mov. Liquidados")
endif
if SQL("Select count(*) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov= "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ") = 0
  Cancelar('No Existe una Cancelacion de '~Dialogo.NrOperacion1~' a fecha '~Dialogo.Fecha1)
else
  if SQL("Select count(*) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov > "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ") > 0
    ACD(f1, SQL("Select Max(FechaMov) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov > "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ")) 
    Cancelar('Existe una Cancelacion de '~Dialogo.NrOperacion1~' a fecha '~val(f1))
  endif
endif

************************************************************************************************
******* Si es 2412 con Vehiculo INGCURA, el Prestamo asociado no debe tener Mov.de Pago ********
SQL.ADD("Select Vehiculo1,RB1,NrOperacion3,Especie from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACT(p1,FBN['Vehiculo1'])
  ACT(p2,FBN['RB1'])
  ACT(p3,FBN['NrOperacion3'])
  ACT(a1,FBN['Especie'])
Proximo
if NoVacio(val(p3)) y Eqstr(val(p1),'INGCURA') y Eqstr(val(p2),'1')
  if SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~val(p3)~"' and FechaMov >= "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo = 1 ")>0
    Cancelar('No puede Anular el Pago. Existen Mov.en '~val(p3)~' de INGBA')
  endif
endif

endif

*************************************************************************************************
if Messagebox('Confirma Anulacion de Pago Prestamo '~Dialogo.NrOPeracion1~' a fecha '~Dialogo.Fecha1~' ?',3,1) = 1
  ACT(z1,Dialogo.NrOperacion1)
  ACD(z2,Dialogo.Fecha1)
  ******************** Saldos anteriores a la Cancelacion de ese Pago ****************************
  ACN(x1,0)

  SQL.ADD("Select Cantidad,NrSaldo,NrGrupo2 from "~DBO~".MOVEJECUTADOS  ")
  SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
  SQL.ADD("and   FechaMov    = '"~IdxDate(val(z2))~"' ")
  SQL.ADD("and   NrSaldo in (130,140,141,142,143,150,160,180,181,182,183,190) ")
  SQL.ADD("order by NrGrupo2,NrSaldo ")
  Recorrer SQL
    if val(aa:val(x1))<>FBN['NrGrupo2']
      SCN(x1,1)
      ACN(aa:val(x1),FBN['NrGrupo2'])
      ACN(ab:val(x1),0)
      ACN(ac:val(x1),0)
      ACN(ad:val(x1),0)
      ACN(ae:val(x1),0)
      ACN(af:val(x1),0)
      ACN(ag:val(x1),0)
      ACN(ah:val(x1),0)
      ACN(ai:val(x1),0)
      ACN(aj:val(x1),0)
      ACN(ak:val(x1),0)
      ACN(al:val(x1),0)
      ACN(am:val(x1),0)
    endif

    if FBN['NrSaldo'] = 130
      ACN(ab:val(x1),FBN['Cantidad'])
    else
      if FBN['NrSaldo'] = 140
        ACN(ac:val(x1),FBN['Cantidad'])
      else
        if FBN['NrSaldo'] = 141
          ACN(ad:val(x1),FBN['Cantidad'])
        else
          if FBN['NrSaldo'] = 142
            ACN(ae:val(x1),FBN['Cantidad'])
          else
            if FBN['NrSaldo'] = 143
              ACN(af:val(x1),FBN['Cantidad'])
            else
              if FBN['NrSaldo'] = 150
                ACN(ag:val(x1),FBN['Cantidad'])
              else
                if FBN['NrSaldo'] = 160
                  ACN(ah:val(x1),FBN['Cantidad'])
                else
                  if FBN['NrSaldo'] = 180
                    ACN(ai:val(x1),FBN['Cantidad'])
                  else
                    if FBN['NrSaldo'] = 181
                      ACN(aj:val(x1),FBN['Cantidad'])
                    else
                      if FBN['NrSaldo'] = 182
                        ACN(ak:val(x1),FBN['Cantidad'])
                      else
                        if FBN['NrSaldo'] = 183
                          ACN(al:val(x1),FBN['Cantidad'])
                        else
                          if FBN['NrSaldo'] = 190
                            ACN(am:val(x1),FBN['Cantidad'])
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
    endif
  Proximo

  ******************** Actualizacion de las Cuotas *********************************************
  if val(x1)>0 
    Recorrer&i 1,val(x1)

      *** Fecha de Pago anterior ***
      ACD(ff:&i,SQL("Select Max(FechaMov) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(aa:&i)~" and FechaMov <> '"~IdxDate(val(z2))~"' "))
      if val(ff:&i)>0
        ACT(fg:&i,'0')
      else
        ACT(fg:&i,' ')
      endif

      *** Saldo Capital anterior ***
      ACN(fh:&i,SQL("Select Cantidad3 from "~DBO~".CUOTAS where NrOperacion='"~val(z1)~"' and NrCuota= "~val(aa:&i)~" "))
      *** Capital Cobrado
      SCN(fh:&i,SQL("Select Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(aa:&i)~" and FechaMov = '"~IdxDate(val(z2))~"' and NrSaldo = 30 "))

      SQL.ADD("Update "~DBO~".CUOTAS set  ")
      if val(ab:&i)>0
         SQL.ADD("Cantidad5 = "~val(ab:&i)~", ")
      endif
      if val(ac:&i)>0
         SQL.ADD("Cantidad6 = "~val(ac:&i)~", ")
      endif
      if val(ad:&i)>0
         SQL.ADD("Cantidad9 = "~val(ad:&i)~", ")
      endif
      if val(ae:&i)>0
         SQL.ADD("Cantidad10 = "~val(ae:&i)~", ")
      endif
      if val(af:&i)>0
         SQL.ADD("Cantidad11 = "~val(af:&i)~", ")
      endif
      if val(ag:&i)>0
         SQL.ADD("Cantidad7 = "~val(ag:&i)~", ")
      endif
      if val(ah:&i)>0
         SQL.ADD("Cantidad8 = "~val(ah:&i)~", ")
      endif
      if val(ai:&i)>0
         SQL.ADD("Cantidad12 = "~val(ai:&i)~", ")
      endif
      if val(aj:&i)>0
         SQL.ADD("Cantidad13 = "~val(aj:&i)~", ")
      endif
      if val(ak:&i)>0
         SQL.ADD("Cantidad14 = "~val(ak:&i)~", ")
      endif
      if val(al:&i)>0
         SQL.ADD("Cantidad15 = "~val(al:&i)~", ")
      endif
      if val(am:&i)>0
         SQL.ADD("Total8 = "~val(am:&i)~", ")
      endif
      SQL.ADD("Cantidad3= "~val(fh:&i)~", ")
      SQL.ADD("Radio6= '"~val(fg:&i)~"', ")
      if val(ff:&i)>0
        SQL.ADD(" Fecha4 = '"~IdxDate(val(ff:&i))~"' ")
      else
        SQL.ADD(" Fecha4 = Null ")
      endif
      SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
      SQL.ADD("and   NrCuota     = "~val(aa:&i)~" ")
      SQL.NEW
      SQL.EXEC

      ACT(pc1,Fstr(val(aa:&i),0,0))
      ACN(x3,val(ab:&i)+val(ac:&i)+val(ad:&i)+val(ae:&i)+val(af:&i)+val(ag:&i)+val(ah:&i)+val(ai:&i)+val(aj:&i)+val(ak:&i)+val(al:&i)+val(am:&i))
      (.'CANPRE16'.)
      
      *** Borrado de MOVDEVENGADOS de Compensatorios y Punitorios negativos generados ***
      SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' ")
      SQL.ADD("and Fecha>="~IdxDate2(val(z2))~" ")
      SQL.ADD("and NrSaldo in (150,160) ")
      SQL.ADD("and Monto < 0 ")
      SQL.NEW
      SQL.EXEC
   
    Proximo

    ********************* Actualizacion en OPERACIONES ********************************************
    ACD(fm1,SQL("Select Max(Fecha4) from "~DBO~".CUOTAS where NrOperacion='"~val(z1)~"' "))
    SQL.ADD("Update "~DBO~".OPERACIONES set   ")  
    if val(fm1)>0
      SQL.ADD(" FechaEj = '"~IdxDate(val(fm1))~"' ")
    else
      SQL.ADD(" FechaEj = Null ")
    endif
    SQL.ADD(",CB6=Null ")
    SQL.ADD(" where NrOperacion='"~val(z1)~"' ")
    SQL.NEW
    SQL.EXEC
  endif

  ***********************************************************************************************
  ******************** Borrado de los MOVEJECUTADOS *********************************************
  SQL.ADD("Delete "~DBO~".MOVEJECUTADOS where NrOperacion = '"~val(z1)~"' ")
  SQL.ADD("and FechaMov= '"~IdxDate(val(z2))~"' ")
  SQL.ADD("and NrSaldo in (130,140,141,142,143,150,151,152,153,160,161,162,163,173,174,175,176,177,178,180,181,182,183,185,186,187,188,190,191,192,193,200,201,202,203, ")
  SQL.ADD("                 30, 40, 41, 42, 43, 50, 51, 52, 53, 60, 61, 62, 63, 73, 74, 75, 76, 77, 78, 80, 81, 82, 83, 85, 86, 87, 88, 90, 91, 92, 93) ")
  SQL.NEW

  ***********************************************************************************************
  ******************** Borrado de los MOVPENDIENTES *********************************************
  SQL.ADD("Delete "~DBO~".MOVPENDIENTES where NrOperacion = '"~val(z1)~"' ")
  SQL.ADD("and FechaMov= '"~IdxDate(val(z2))~"' ")
  SQL.ADD("and NrSaldo = 1 ")
  SQL.NEW
  SQL.EXEC

  ***********************************************************************************************
  **** Si es 2412 con Vehiculo INGCURA, Actualizacion del Prestamo asociado *********************

  if Eqstr(val(p1),'INGCURA') y Eqstr(val(p2),'1')
    SQL.ADD("Select PorComision,DiasAnio from "~DBO~".OPERACIONES where NrOperacion = '"~val(p3)~"' ")
    Recorrer SQL
       ACN(z6,FBN['PorComision'])
       ACN(z7,FBN['DiasAnio'])
    Proximo
    EjecutarEvento('R2412',NrOperacion1=val(p3),NrOperacion2=val(z1),Radio1=0,Cantidad1=val(z6),Entero1=val(z7))    
  endif

  ***********************************************************************************************
  ******************** Precancelada, generacion de los DEVENGADOS borrados **********************
  ACD(f1,SQL("Select FechaPrecan from "~DBO~".OPERACIONES where NrOperacion = '"~val(z1)~"' "))
  if val(f1)>0
    *** Si existe un registro en DELDEVENGADOS lo proceso
    if SQL("Select count(*) from  "~DBO~".DELDEVENGADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and Fecha= '"~IdxDate(val(f1))~"' ") > 0
       SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~Dialogo.NrOperacion1~"' ")
       SQL.ADD("and Fecha>="~IdxDate2(val(f1)-1)~" ")
       SQL.ADD("and NrSaldo in (140,180) ")
       SQL.NEW

       SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~Dialogo.NrOperacion1~"' ")
       SQL.NEW
       SQL.EXEC
    endif

    *** Si es 2412 ***
    if Eqstr(val(p1),'INGCURA') y Eqstr(val(p2),'1')
      if SQL("Select count(*) from  "~DBO~".DELDEVENGADOS where NrOperacion='"~val(p3)~"' and Fecha= '"~IdxDate(val(f1))~"' ") > 0
         SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(p3)~"' ")
         SQL.ADD("and Fecha>="~IdxDate2(val(f1)-1)~" ")
         SQL.ADD("and NrSaldo in (140,180) ")
         SQL.NEW

         SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~val(p3)~"' ")
         SQL.NEW
         SQL.EXEC
      endif
    endif
   
    *** Datos de la Operacion ***
    SQL.ADD("Select Vehiculo1,Especie,Book1,TablaFeriados1,DiasAnio,RB9,RB10,PorComision,Cantidad ")
    SQL.ADD("from "~DBO~".OPERACIONES where NrOperacion = '"~val(z1)~"' ")
    Recorrer SQL
      ACT(zz1,val(z1))
      ACT(zz6,FBN['Vehiculo1'])
      ACT(zz7,FBN['Vehiculo1'])
      ACT(zz9,FBN['Especie'])
      ACT(zz10,FBN['Book1'])
      ACT(zz12,FBN['Especie'])      
      ACT(zz13,FBN['TablaFeriados1'])
      ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
      ACN(zz17,IIF(FBN['DiasAnio']=0,360,365))
      ACN(za1,FBN['RB9'])
      ACN(za2,FBN['RB10'])
      ACN(za3,FBN['PorComision'])
    Proximo

    SQL.ADD("Select NrCuota,Fecha1,Fecha2,Tasa1,Cantidad2,Cantidad3,Total7 ") 
    SQL.ADD("from "~DBO~".CUOTAS where NrOperacion = '"~val(z1)~"' ")
    SQL.ADD("and Fecha2 > '"~IdxDate(val(z2))~"' ")
    SQL.ADD("order by NrCuota")
    Recorrer SQL
      if val(z2) > FBN['Fecha1']
         ACD(zz2,val(z2)-1)
      else
         ACD(zz2,FBN['Fecha1'])
      endif
      ACD(zz3,FBN['Fecha2']-1)
      ACN(zz11,FBN['NrCuota'])
      ACN(zz15,FBN['Cantidad3'])
      ACN(zz16,FBN['Tasa1'])
      ACD(zz19,val(zz2)-1)   
      ACT(zz7,val(zz6))
      ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))      
      ACT(zz4,'INTLEN')
      ACN(zz5,val(zz15)*val(zz16)*(val(zz3)-val(zz2)+1)/(val(zz17)*100))
      ACN(zz8,140)
      ACN(zz18,1)
      if val(zz16) > 0
         (.'CANPRE12'.)
      endif
   
      if val(za1)=2 y val(za2)=1
         ACT(zz4,'COMIS')
         ACN(zz8,180)
         ACN(zz16,val(za3))
         ACN(zz18,2)
         ACN(zz5,val(zz15)*val(zz16)*(val(zz3)-val(zz2)+1)/(val(zz17)*100))
         (.'CANPRE12'.)
      endif
 
      *** Si es 2412 ***
      if Eqstr(val(p1),'INGCURA') y Eqstr(val(p2),'1')
         ACT(zx1,val(zz1))
         ACT(zx2,val(zz6))
         ACT(zx3,val(zz10))
         ACN(zx4,val(zz14))
         ACN(zx5,val(zz17))

         ACT(zz1,val(p3))
         ACT(zz4,'COMIS')
         ACT(zz6,BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',val(p3)))
         ACT(zz7,val(zz6))
         ACN(zz8,180)
         ACN(zz16,BuscarCampo('OPERACIONES','PorComision','NrOperacion',val(p3)))
         ACT(zz10,BuscarCampo('OPERACIONES','Book1','NrOperacion',val(p3)))
         ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
         ACN(zz17,IIF(BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',val(p3))=0,360,365))
         ACN(zz18,2)
         ACN(zz5,val(zz15)*val(zz16)*(val(zz3)-val(zz2)+1)/(val(zz17)*100))
         (.'CANPRE12'.)
         ACT(zz1, val(zx1))
         ACT(zz6, val(zx2))
         ACT(zz10,val(zx3))
         ACN(zz14,val(zx4))
         ACN(zz17,val(zx5))
      endif
    Proximo
    
    SQL.ADD("Update "~DBO~".OPERACIONES set FechaPrecan=Null,CB6=Null where NrOperacion='"~val(z1)~"' ")  
    SQL.NEW
    SQL.EXEC
   
  endif
  ************************************************************************************************
  ** Evento que vuleve atras la Asistencia Crediticia BCRA
  if EqStr(Val(p1),Var('VEHICULODE'))
    EjecutarEvento('DESASI',NrOperacion1=Dialogo.NrOperacion1, Fecha1=Dialogo.Fecha1, Radio1=1, Radio2=0, Check1=1)
  endif
  EjecutarEvento('DESLHO',NrOperacion1=Dialogo.NrOperacion1, Fecha1=Dialogo.Fecha1, Radio1=1, Radio2=0, Check1=1)
endif
