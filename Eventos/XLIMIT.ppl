SQL.ADD("Select O.NrOperacion from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B where O.NrOperacion=B.NrOperacion and B.NrBit=5 and B.Valor='1' and O.Direccion=2")
recorrer SQL
  SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='1' where NrOperacion='"~fbn('NrOperacion')~"' and NrBit=6")
  SQL.NEW
  SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor='0' where NrOperacion='"~fbn('NrOperacion')~"' and NrBit=5")
  SQL.NEW
proximo
SQL.EXEC
