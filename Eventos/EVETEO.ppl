** FJL 08/04/2023 - Ajuste Saldo Custodia S30J3
CrearDialogo
  Check1 : 'Procesa'                ;;;;;;;;;0
FinDialogo
if not OK
  Cancelar
endif   

IF Dialogo.Check1=0 o SI
  HOJAVISIBLE(SI) 
Endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:1, 'Especie')  
ACT(a:2, 'Trans')  
ACT(a:3, 'MovsPen')  
ACT(a:4, 'MovsPen MV')  
ACT(a:5, 'MovsPen AV')  
ACT(a:6, 'MovsEje')  

ACT(b:1, 'S30J3')
ACT(b:2, 'TE028017')
ACN(b:3, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))
ACN(b:4, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' and Bits ='MV' "))
ACN(b:5, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' and Bits ='AV' "))
ACN(b:6, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))

if Val(b:4)=0
  MessageBox('Error en movimientos transaccion '~Val(b:2)~'. Puede ser que el ajuste ya se haya ejecutado.')
  ACN(x:2, 1)
endif

SetFilaActual(7)
SQL.ADD("Select * from "~DBO~".MOVPENDIENTES ")
SQL.ADD(" WHERE Especie       = '"~Val(b:1)~"' ")
SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACD(c:fac, fbn('FechaMov'))
  ACT(d:fac, fbn('Mercado'))
  ACT(e:fac, fbn('Cuenta'))
  ACN(f:fac, fbn('NrSaldo'))
  ACN(g:fac, fbn('Cantidad'))
  ACT(h:fac, fbn('Bits'))
proximo

if Dialogo.Check1=1 y Val(x:2)=0
  SQL.ADD("Update "~DBO~".MOVPENDIENTES ")
  SQL.ADD("   Set Cantidad  = -75000000, ")
  SQL.ADD("       Bits  = 'AV' ")
  SQL.ADD(" WHERE Especie     = '"~Val(b:1)~"' ")
  SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
  SQL.NEW

  SQL.EXEC
  MessageBox('Se ajusto la transacccion '~Val(d:2)~' - Especie '~Val(d:1))
  ACT(c:2, 'Ajustada')
endif

ACN(c:3, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))
ACN(c:4, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' and Bits ='MV' "))
ACN(c:5, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' and Bits ='AV' "))
ACN(c:6, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS WHERE Especie = '"~Val(b:1)~"' and NrOperacion='"~Val(b:2)~"' "))

IFA
SQL.ADD("Select * from "~DBO~".MOVPENDIENTES ")
SQL.ADD(" WHERE Especie       = '"~Val(b:1)~"' ")
SQL.ADD("   AND NrOperacion = '"~Val(b:2)~"' ")
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACD(c:fac, fbn('FechaMov'))
  ACT(d:fac, fbn('Mercado'))
  ACT(e:fac, fbn('Cuenta'))
  ACN(f:fac, fbn('NrSaldo'))
  ACN(g:fac, fbn('Cantidad'))
  ACT(h:fac, fbn('Bits'))
proximo

if Dialogo.Check1=0
  MessageBox('Evento finalizo Sin Procesar')
else
  MessageBox('Evento finalizo correctamente')
endif
