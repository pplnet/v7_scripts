CrearDialogo
   NrTrans1     : "Nr.Transaccion";4;;;;Dialogo.Radio3=1;;;;;;
   TipoTr1      : "Tipo Tr"      ;;;;;Dialogo.Radio3=1;;
   Vehiculo1    : 'Vehiculo'     ;1;;;;;;;;;;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO WHERE Codigo = '"~USUARIOACTIVO~"') ")
   Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
   NrOperacion1 : "Nr.Operacion" ;;;;;Dialogo.Radio3=0;
   TipoOp1      : "Tipo Op"      ;;;;;Dialogo.Radio3=0;;
   Especie1     : "Especie"      ;;;
   Radio1       : 'Grupo|FX|DP|DT|MM|TI|FC|DD'         ;;;;;;Dialogo.Radio1>=0;'Debe elegir una opcion de Grupo';NO;;;
   Radio2       : 'Tipo|Movimientos|Posiciones|Limites|Devengados';;;;;;;;0;
   Radio3       : 'Tipo|Operaciones|Transacciones|';;;;;;;;;0;
FinDialogo
 
If Not Ok
   Cancelar
Endif

if Dialogo.Radio3=0
    If NoVacio(Dialogo.NrOperacion1)
      ACT(X1, "O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
    Else
      If NOVACIO(Dialogo.TipoOp1)
        ACT(X1, "O.TipoOp = '"~Dialogo.TipoOp1~"' ")
      Else
        ACT(X1, "FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
        If NoVacio(Dialogo.Vehiculo1)
          ACT(x1, Val(X1)~" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
        Endif
      Endif
    Endif


    IF Dialogo.Radio1=0
       ACT(x1, Val(X1)~" and TipoOp LIKE 'FX%' ")   
    EndIf
    IF Dialogo.Radio1=1
       ACT(x1, Val(X1)~" and TipoOp LIKE 'DP%' ")
    EndIf
    IF Dialogo.Radio1=2
       ACT(x1, Val(X1)~" and TipoOp LIKE 'DT%' ")   
    EndIf
    IF Dialogo.Radio1=3
       ACT(x1, Val(X1)~" and TipoOp LIKE 'MM%' ")   
    EndIf
    IF Dialogo.Radio1=4
* FJL 30/05/25 - Para actualizar tambien TCOPRI
*       ACT(x1, Val(X1)~" and TipoOp LIKE 'TI%' ")   
       ACT(x1, Val(X1)~" and (TipoOp LIKE 'TI%' or TipoOp LIKE 'TC%') ")   
    EndIf
    IF Dialogo.Radio1=5
       ACT(x1, Val(X1)~" and TipoOp LIKE 'FC%' ")   
    EndIf
    IF Dialogo.Radio1=6
        ACT(x1, Val(X1)~" and TipoOp LIKE 'DD%' ")   
    EndIf

    if NoVacio(Dialogo.Especie1)
      ACT(X1, Val(X1)~" and O.Especie = '"~Dialogo.Especie1~"' ")
    EndIf


    SQL.ADD("Select * from "~DBO~".OPERACIONES O Where "~VAL(X1)~" Order By TipoOp,NrOperacion ")

    Recorrer SQL    

          Message(FBN['TipoOp']~' '~FBN['NrOperacion'])

          If Dialogo.Radio2=0
             SQL.ActualizarMovimientos2(FBN['NrOperacion'],SI,NO,NO,SI)
             SQL.EXEC
          EndIf

          If Dialogo.Radio2=1 
             SQL.ActualizarMovimientos2(FBN['NrOperacion'],NO,NO,NO,SI)
          EndIf
     
         If Dialogo.Radio2=2
             SQL.ActualizarMovimientos2(FBN['NrOperacion'],NO,SI,NO,NO)
         EndIf

         If Dialogo.Radio2=3
           SQL.ActualizarMovimientos3(FBN['NrOperacion'],NO,NO,NO,NO,SI)
         EndIf

         SQL.EXEC  
    proximo
else
    If NoVacio(Dialogo.NrTrans1)
       ACT(X1, "T.NrTrans = '"~Dialogo.NrTrans1~"'")
    Else
      If NOVACIO(Dialogo.TipoOp1)
         ACT(X1, "T.TipoTr2 = '"~Dialogo.TipoOp1~"' ")
      Else
        ACT(X1, "Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
         If NoVacio(Dialogo.Vehiculo1)
            ACT(x1, Val(X1)~" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
         Endif
      Endif
    Endif

    if NoVacio(Dialogo.Especie1)
      ACT(X1, Val(X1)~" and O.Especie = '"~Dialogo.Especie1~"' ")
    EndIf

    SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 T Where TipoTr2 in('DTP','RTP','DRT') and "~VAL(X1)~" Order By TipoTr2,NrTrans ")
    Recorrer SQL    

          Message(FBN['TipoTr2']~' '~FBN['NrTrans'])

          If Dialogo.Radio2=0
             SQL.ActualizarMovimientos2(FBN['NrTrans'],SI,NO,NO,SI)
             SQL.EXEC
          EndIf

          If Dialogo.Radio2=1 
             SQL.ActualizarMovimientos2(FBN['NrTrans'],NO,NO,NO,SI)
          EndIf
     
         If Dialogo.Radio2=2
             SQL.ActualizarMovimientos2(FBN['NrTrans'],NO,SI,NO,NO)
         EndIf

         If Dialogo.Radio2=3
           SQL.ActualizarMovimientos3(FBN['NrTrans'],NO,NO,NO,NO,SI)
         EndIf

         SQL.EXEC  
    proximo
endif
