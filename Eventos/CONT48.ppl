MostrarCuadroDeMensajes
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'Fecha'       ;;;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;fsys
  ListaTabla1: 'Operaciones' ;;;;NO;NO;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES'
  TipoOp1    : 'TipoOp'      ;;;;NO;NO;;
  Lista1     : 'Vehiculos'   ;;;;NO;NO;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1     : 'Contab.Procesada' ;;;;NO;NO;
  Fecha2     : 'FechaEjec'    ;;;;  ;  ;;;;fsys  
FinDialogo

If Not Ok
   Cancelar
Endif

Message('Evento Reversa INTSEC e INTSECBP')
***---Reverso asiento de intereses devengados del mes anterior
Message('Reversa de Devengados de Fin de Mes')
SQL.ADD(" Select A.NrUnicoAsiento, A.FechaValor ")
SQL.ADD(" From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO MA, "~DBO~".ASIENTOSCON1 A1 ")
SQL.ADD(" Where MA.Codigo = A.Modelo ")
SQL.ADD(" AND A.Vehiculo in (SELECT Codigo FROM "~DBO~".VEHICULOS WHERE Status = 'HAB') ")
SQL.ADD(" AND A.NrUnicoAsiento = A1.NrUnicoAsiento ")
SQL.ADD(" AND A1.NrItem = (SELECT MIN(NrItem) FROM "~DBO~".ASIENTOSCON1 B1 WHERE B1.NrUnicoAsiento = A1.NrUnicoAsiento ) ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASINTSE'))~") ")
***---Que no haya sido ya Reversado
SQL.ADD(" AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') ")
SQL.ADD(" AND A.FechaValor = (Select Max(B.FechaValor) From "~DBO~".ASIENTOSCON B, "~DBO~".ASIENTOSCON1 B1 ")
SQL.ADD("         Where A.NrUnicoAsiento = B.NrUnicoAsiento ")
SQL.ADD("         AND A1.NrItem = B1.NrItem ")
SQL.ADD("         AND A.Modelo = B.Modelo ")
SQL.ADD("         AND A.Vehiculo = B.Vehiculo ")
***---SQL.ADD("         AND Estado = 'E' ")
SQL.ADD("         AND B.FechaValor <= '"~IdxDate(Dialogo.Fecha1)~"') ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND A.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND A.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
SQL.ADD(" AND A.Vehiculo Not IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" AND A.FechaValor >= '"~IdxDate(Fecha(Var('FECHAMIGRA')))~"' ")
Recorrer SQL
*MessageBox('Va a Reversar Asiento '~fbn('NrUnicoAsiento'))
    ACD(FV:9, fbn('FechaValor'))
    ACT(NA:1, fbn('NrUnicoAsiento'))
    ***---Llamo a evento que realiza ContraAsiento
    EjecutarEvento('CONT46', Fecha1=Dialogo.Fecha2, NrUnicoAsiento1=Val(NA:1), Fecha2=Val(FV:9), Radio1=0)
Proximo