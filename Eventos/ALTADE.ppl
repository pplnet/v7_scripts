CrearDialogo
   Vehiculo1  : 'Vehiculo';;;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
   Fecha1     : 'F. Desde'   ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Fecha2     : 'F. Hasta'   ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
   NrTrans1   : 'Nr.Trans'
FinDialogo

If Not ok
   Cancelar
Endif

SQL.ADD(" SELECT T1.Vehiculo1,T1.Cliente1,T1.Cuenta1,T1.Cuenta2,T1.Fecha1,T1.Especie,T1.Mercado1,T1.Cantidad1, ")
SQL.ADD(" T1.TipoTr2,T1.NrTrans,T1.NrTransRef1,T1.Cupon1,T1.Cantidad2, T1.RB5 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T1 ")
SQL.ADD(" WHERE T1.TipoTr2 IN ('DTP','RTP') and T1.CB1=1 ")
SQL.ADD(" and T1.Fecha1 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2) )
SQL.ADD(" and T1.RB5<>3 ")
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD(" and T1.NrTrans='"~Dialogo.NrTrans1~"' ")
EndIf
SQL.ADD(" and NOT EXISTS (SELECT T2.NrTrans FROM "~DBO~".TRANSACCIONES2 T2 WHERE T2.NrTransRef1=T1.NrTrans) ")
SQL.ADD(" Order By Fecha1 ")

Recorrer SQL

    IF EqStr(FBN['RB5'],'1') o EqStr(FBN['RB5'],'0')
       ACT(a1,'RESCAT')
    Else
       ACT(a1,'CANPRE')
    Endif
     
    IF EqStr(FBN['TipoTr2'],'RTP')
        ACT(c1, FBN['Cuenta2'])
        ACT(c2, FBN['Cuenta1'])       
    Else
        ACT(c1, FBN['Cuenta1'])
        ACT(c2, FBN['Cuenta2'])
    Endif

    *- Si la especie es Arancelada tomo la No Arancelada
    ACN(es2, BuscarCampo('ESPECIES','Valor1','CodNumCajaValores',FBN['Especie']))
    if Val(es2)<>0
       ACT(es1, FStr(Val(es2),0,0))
    else
       ACT(es1, FBN['Especie'])
    endif

    Message('Creando transaccion de '~FBN['NrTrans'])
    ACT(ta4, GetNumerador(2))
    SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
    SQL.ADD("(Vehiculo1,Cliente1,Cuenta2,Fecha1,Especie,Mercado1,Cantidad1, ")
    SQL.ADD(" TipoTr2,NrTrans,NrTransRef1,Cupon1,Cantidad2,FechaCarga, FechaCargaSys) ")
    SQL.ADD(" Values ('"~FBN['Vehiculo1']~"','"~FBN['Cliente1']~"','"~Val(c2)~"','"~IdxDate(FBN['Fecha1'])~"','"~Val(es1)~"','"~FBN['Mercado1']~"',"~FBN['Cantidad1']~",")
    SQL.ADD(" '"~Val(a1)~"','"~Val(ta4)~"','"~FBN['NrTrans']~"',"~FBN['Cupon1']~", "~FBN['Cantidad2']~", GetDate(),'"~IdxDate(FSys)~"' ) ")
    SQL.NEW
    SQL.EXEC

    SQL.ActualizarMovimientosT2(Val(ta4),SI,NO,NO,NO)           
    SQL.EXEC

    SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS (NrOperacion,NrBit,Valor) Values ('"~Val(ta4)~"',70,1) ")
    SQL.NEW
    SQL.EXEC

