CrearDialogo
  Fecha1      : 'D.FechaOp'    ;;;;;Vacio(Dialogo.NrOperacion1) Y Vacio(Dialogo.String1);Dialogo.Fecha1 <> 0 O NoVacio(Dialogo.NrOperacion1) O NoVacio(Dialogo.String1);'FechaOp Desde Invalida';NO;Fsys;
  Fecha2      : 'H.FechaOp'    ;;;;;Vacio(Dialogo.NrOperacion1) Y Vacio(Dialogo.String1);Dialogo.Fecha2 >= Dialogo.Fecha1 O NoVacio(Dialogo.NrOperacion1) O NoVacio(Dialogo.String1);'FechaOp Hasta Invalida';NO;Fsys; 
  NrOperacion1:'Operacion'     ;;;;;Vacio(Dialogo.String1);Vacio(Dialogo.NrOperacion1) O Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'FXC|FXV|FXCF|FXVF|FXA|FXAT|FXJ');'Operacion Invalida';NO;;;;;;" TipoOp IN ('FXC','FXV','FXCF','FXVF','FXA','FXAT','FXJ') " ;
  String1     : 'NrBoleto'     ;;;;;Vacio(Dialogo.NrOperacion1);;;;
  *Check1     : 'Impresora'    ;;;;;;;;
  Radio2      :'|Impresora|Pantalla|PDF|Mail' ;;;1;;;Dialogo.Radio2>=0;;;1
  Lista1      : 'TipoOp'       ;1;2;;;Vacio(Dialogo.NrOperacion1) Y Vacio(Dialogo.String1);;;;;;'FXC|FXV|FXCF|FXVF|FXA|FXAT|FXJ';
FinDialogo

if Not Ok
  Cancelar
endif

ACN(BD:1, 0)
SQL.ADD(" Select NrOperacion, TipoOp, Cantidad, Cliente1, FechaOp, NrBoleto ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ELSE
    IF NoVacio(Dialogo.String1)
        SQL.ADD(" Where NrBoleto = '"~Dialogo.String1~"' ")
    ELSE
        IF NoVacio(Dialogo.Lista1)
            SQL.ADD(" Where TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
        ELSE
            SQL.ADD(" Where TipoOp IN ('FXC','FXV','FXCF','FXVF','FXA','FXAT','FXJ') ")
        ENDIF
        SQL.ADD(" AND FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    ENDIF
ENDIF
SQL.ADD(" Order By NrOperacion ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('TipoOp'))
    ACD(C:fac, fbn('FechaOp'))
    ACT(D:fac, fbn('Cliente1'))
    ACN(E:fac, fbn('Cantidad'))
    ACT(G:fac, fbn('NrBoleto'))
    ACN(BD:1, 1)
Proximo
IF Val(BD:1) = 0
    Cancelar('No Hay Operaciones FX que Coincidan con los Datos Ingresados')
ENDIF
CrearListBox ; 'Arial,8,'
   'OK'            ;F:1..F:fac;SI;;;40;CHECK;
   'Nro.Op.'       ;A:1..A:fac;NO;;;70;STRING
   'TipoOp'        ;B:1..B:fac;NO;;;70;STRING
   'FechaOp'       ;C:1..C:fac;NO;;;70;FECHA
   'Cliente'       ;D:1..D:fac;NO;;;150;STRING
   'Cantidad'      ;E:1..E:fac;NO;;;90;NUMERO;'##,###,###.##'
   'NrBoleto'      ;G:1..G:fac;NO;;;70;STRING
FinListBox
IF Not OK
   Cancelar
ENDIF
Recorrer&k 1, fac
    IF Val(F:&k) = 1
    EjecutarEvento('BOLEFX', NrOperacion1 = Val(A:&k), Radio2 = Dialogo.Radio2)
    ENDIF
Proximo
