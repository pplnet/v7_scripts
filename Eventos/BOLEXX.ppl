CrearDialogo
  NrOperacion1:  "NrOperacion" 
  Cliente1:      "Cliente"
  TipoOp1:       "Tipo OP"
  Radio3:        "CB4|No|Si"
  Radio2:        "Salida|Impresora|Pantalla|PDF|Mail"
  Radio1:        "Boleto|Orig. y Dup|Original"
FinDialogo
if Not OK
  Cancelar
endif

   If (Dialogo.Radio3=1 o (EQSTR(Dialogo.Cliente1,Var('VEHICULO')) y Dialogo.Radio3=0))  and Incluido(Dialogo.TipoOP1,'TIC|TIV')
       ACT(az1,'BOLCPC')
       LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='ORIGINAL', Radio2=Dialogo.Radio2)
       if Dialogo.Radio1=0
          LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='DUPLICADO', Radio2=Dialogo.Radio2)
       endif   
   Else
      if Incluido(Dialogo.TipoOP1,'TIC|TIV|TIFC|TIFV|TCOPRI')
         ACT(az1,'BOLEXT')
         LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='ORIGINAL', Radio2=Dialogo.Radio2)
         if Dialogo.Radio1=0
            LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='DUPLICADO', Radio2=Dialogo.Radio2)
         endif
      else
         if Incluido(Dialogo.TipoOP1,'TICO|TIPO|TIDE|TICT')
            ACT(az1,'BOCALL')
            LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='ORIGINAL', Radio2=Dialogo.Radio2)
            if Dialogo.Radio1=0
               LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='DUPLICADO', Radio2=Dialogo.Radio2)
            endif
         else
            ACT(az1,'BOEXTR')
            LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='ORIGINAL', Radio2=Dialogo.Radio2)
            if Dialogo.Radio1=0
               LinkearHoja(Val(az1), 1, NrOperacion1=Dialogo.NrOperacion1, String='DUPLICADO', Radio2=Dialogo.Radio2)
            endif
         endif
      endif
   Endif