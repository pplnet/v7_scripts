CrearDialogo
  Vehiculo1: 'Vehiculo'      ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   : 'Fecha Liq.'    ; 1;2;;;;Dialogo.Fecha1<>0 ;'Fecha Incorrecta';NO;FSys;
  Cliente1 : 'Cliente'       ; 3;1;;;;NoVacio(Dialogo.Cliente1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar un Cliente';NO;
  Especie1 : 'Especie'       ;  ;1;;;;NoVacio(Dialogo.Especie1) o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar una Especie';NO;
  Mercado1 : 'Mercado'       ; 3;2;;;;[NoVacio(Dialogo.Mercado1)] o Dialogo.Check6=0;'Si desea Seleccionar debe ingresar Mercado';NO;
  Check10  : 'OCT'           ; 5;1;;NO;;;;;1;
  Check9   : 'Netea Mon.'    ; 5;2;;NO;NO;;;;0;
  Check5   : 'Compensar Op.' ;  ;2;;NO;NO;Dialogo.Check5+Dialogo.Check6<2;'No se puede Compensar y Seleccionar al mismo tiempo';NO;0;
  Check6   : 'Seleccionar'   ;  ;2;;NO;NO;;;;0;
  Check8   : 'Procesa'       ; 6;1;;NO;NO;;;;1;
  Check7   : 'Liq.Automatica';  ;1;;NO;NO;;;;0;
FinDialogo
if Not Ok
  Cancelar
endif
if Dialogo.Check8=0
  HojaVisible(SI)
endif

SQL.ADD("Select M.FechaMov,      M.Cliente,       M.Especie,  M.Cupon,    ")
SQL.ADD("       M.Cantidad,      M.NrOperacion,   M.Status,   M.NrMov,    ")
SQL.ADD("       M.Mercado MercM, M.Cuenta,        M.Concepto, M.NrGrupo2, ")
SQL.ADD("       T.TipoTr2 Tipo,  T.Mercado1 MercO ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = T.NrTrans")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.Cliente = T.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check10=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
ENDIF
SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and M.Bits = 'MV' ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
***---Las OCT estan en Terminal
SQL.ADD(" AND ((B.NrBit = 5 AND T.TipoTr2 <> 'LIQOCT') OR (B.NrBit = 2 AND T.TipoTr2 = 'LIQOCT')) ")
SQL.ADD("and B.Valor = '1' ")
SQL.ADD("Order By 2, 9, 10, 3, 4, 11, 1, 6")

ACT(aa:0, 'aa DVP')
ACT(ab:0, 'ab RVP')
ACT(ac:0, 'ac Conf')
ACT(ad:0, 'ad MATCH')
ACT(ae:0, 'ae Vacio')
ACT(af:0, 'af (aa..ae)')
ACT(ag:0, 'ag DVP')
ACT(ah:0, 'ah RVP')
ACT(ai:0, 'ai Conf')
ACT(aj:0, 'aj MATCH')
ACT(ak:0, 'ak Vacio')
ACT(al:0, 'al (ag..ak)')
ACT(am:0, 'am DVP')
ACT(an:0, 'an RVP')
ACT(ao:0, 'ao Conf')
ACT(ap:0, 'ap MATCH')
ACT(aq:0, 'aq Vacio')
ACT(ar:0, 'ar (am..aq)')
ACT(as:0, 'as (al+ar)')
ACT(at:0, 'at')
ACT(au:0, 'au DVP')
ACT(av:0, 'av RVP')
ACT(aw:0, 'aw Conf')
ACT(ax:0, 'ax MATCH')
ACT(ay:0, 'ay Vacio')
ACT(az:0, 'az (au..ay)')
ACT(ba:0, 'ba DVP')
ACT(bb:0, 'bb RVP')
ACT(bc:0, 'bc Conf')
ACT(bd:0, 'bd MATCH')
ACT(be:0, 'be Vacio')
ACT(bf:0, 'bf (ba..be)')
ACT(bg:0, 'bg DVP')
ACT(bh:0, 'bh RVP')
ACT(bi:0, 'bi Conf')
ACT(bj:0, 'bj MATCH')
ACT(bk:0, 'bk Vacio')
ACT(bl:0, 'bl (bg..bk)')

recorrer SQL;;SI
  SCN(bz:1,1)
  ACT(ca:Val(bz:1), FBN['NrOperacion'])
  ACT(cb:Val(bz:1), FBN['Tipo'])
  ACT(cc:Val(bz:1), FBN['MercM'])
  ACT(cd:Val(bz:1), FBN['Especie'])
  ACN(ce:Val(bz:1), FBN['Cantidad'])
  ACT(cf:Val(bz:1), FBN['Cliente'])
  ACD(cg:Val(bz:1), FBN['FechaMov'])
  ACT(ch:Val(bz:1), FBN['Status'])
  ACT(ci:Val(bz:1), FBN['Cuenta'])
  ACT(cj:Val(bz:1), FBN['Concepto'])
  ACN(ck:Val(bz:1), FBN['NrGrupo2'])
  SCN(x4,1)
  if Not EqStr(FBN['Cliente'],Val(v1)) o Not [EqStr(FBN['Concepto'],Val(v2)) o Dialogo.Check9=1] o Not EqStr(FBN['MercM'],Val(v3)) o Not EqStr(FBN['Cuenta'],Val(v4)) o Not EqStr(FBN['Especie'],Val(v5)) o Not EqStr(FBN['Cupon'],Val(v6)) o Dialogo.Check5 = 0
    if FAC>1
      DFA
      (.'LIQUIDA1'.)
      IFA
    endif
    BorrarCeldas(v1..v6)
    ACT(v1, FBN['Cliente'])
    ACT(v2, FBN['Concepto'])
    ACT(v3, FBN['MercM'])
    ACT(v4, FBN['Cuenta'])
    ACT(v5, FBN['Especie'])
    ACT(v6, FBN['Cupon'])
    ACT(a:FAC, FBN['Cliente'])
    ACT(b:FAC, FBN['MercM'])
    ACT(c:FAC, FBN['Concepto'])
    ACT(e:FAC, FBN['Especie'])
    ACT(TR:fac, fbn('Tipo'))
    if Dialogo.Check5=0
      * NO Compensa
      ACT(i:FAC, FBN['NrOperacion'])
    endif
    ACT(j:FAC, FBN['Especie'])
    ACT(m:FAC, FBN['MercO'])
    if Dialogo.Check7=0
       *** pedido de back que siempre este marcado ***
       ACN(p:FAC, 1)
      else
       *** habilita la liquidacion automatica ***
       ACN(p:FAC, 1)
    endif
    ACT(r:FAC, FBN['Cuenta'])
    ACT(t:FAC, FBN['Cupon'])
    ACN(w:FAC, FBN['NrGrupo2'])
    ACT(y:FAC, FBN['NrMov'])
  else
    DFA
    if Not EqStr(FBN['Concepto'],Val(v2))
      ACT(c:FAC, 'Net')
    endif
  endif
  ACN(cl:Val(bz:1), FAC)
  SCN(k:FAC, FBN['Cantidad'])
  SCN(l:FAC, 1)

  ACN(f:FAC, 0)
  SCN(g:FAC, -FBN['Cantidad'])
  if Incluido(Copy(FBN['NrOperacion'],1,2),'LO')
     ACT(s:FAC, BuscarCampo('TRANSACCIONES2','Cuenta2','NrTrans',FBN['NrOperacion']))
     if Vacio(val(s:fac))
        ACT(s:fac, SQL("select Codigo from "~DBO~".CUENTAS WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Estado = 'HAB' and Especies Like '%ARP%' and Permanente = 'SI' ") )
     endif
    else
     ACT(s:fac, SQL("select Codigo from "~DBO~".CUENTAS WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Estado = 'HAB' and Especies Like '%ARP%' and Permanente = 'SI' ") )
     if Vacio(val(r:fac))
        ACT(r:fac, SQL("select Codigo from "~DBO~".CUENTAS WHERE Cliente = '"~val(a:fac)~"' AND Estado = 'HAB' and Especies Like '%ARP%' and Permanente = 'SI' ") )
     endif
  endif
  if FBN['Cantidad']<0
    ACN(x2,0)
  else
    ACN(x2,6)
  endif
  if Vacio(FBN['Status'])
    ACN(ae:FAC, 1)
    SCN(37+Val(x2):FAC, FBN['Cantidad'])
    ACN(51+Val(x2):FAC, 1)
  endif
proximo


if Val(x4)>0
  (.'LIQUIDA1'.)
else
  if NoVacio(Dialogo.Cliente1)
    if NoVacio(Dialogo.Especie1)
      Cancelar('El Cliente '~Dialogo.Cliente1~' no tiene movimientos pendientes en la especie '~Dialogo.Especie1~'.')
    else
      Cancelar('El Cliente '~Dialogo.Cliente1~' no tiene movimientos pendientes.')
    endif
  else
    if NoVacio(Dialogo.Especie1)
      Cancelar('No existen movimientos pendientes en la especie '~Dialogo.Especie1~'.')
    else
      IF Dialogo.Check7=0
         Cancelar('No existen movimientos pendientes.')
        else
         Cancelar
      endif
    endif
  endif
endif

*** Cantidad Total de Operaciones ?
ACN(x10,FAC)

ACO(1,9)
ACO(2,4)
ACO(3,3)
ACO(4,7)
ACO(5,9)
ACO(6,11)
ACO(7,12)
ACO(8,4)
ACO(9,11)
FormatoCeldas(f:1..g:FAC,Exe('F2'))
FormatoCeldas(k:1..k:FAC,Exe('F2'))

IF Dialogo.Check7=0
  * Liquidacion Automatica NO
  if Dialogo.Check6=0
     CrearListBox ; 'Arial,8,';'LIQUIDACION de Operaciones OCT'
        'Cliente'    ; a1..a:fac;NO;;;120;STRING;;Exe('COLOR6');
        'Mercado'    ; b1..b:fac;NO;;;50;STRING;;Exe('COLOR6');
        'Leyenda'    ; d1..d:fac;NO;;;50;STRING;;Exe('COLOR6');
        'Especie'    ; e1..e:fac;NO;;;70;STRING;;Exe('COLOR6');
        'Moneda'     ; g1..g:fac;NO;;;110;NUMERO;'###,###,###,###.##';Exe('COLOR6');
        'Operacion'  ; i1..i:fac;NO;;;70;STRING;;Exe('COLOR6');
        'Instruccion'; r1..r:fac;Not EqStr(val(b:flb),'OCT');SI;'Error'; 80;TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';" Cliente = '"~val(a:flb)~"' and Estado = 'HAB' ";Exe('COLOR6')
        'Cta.Propia' ; s1..s:fac;  ;SI;'Error'; 80;TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';" Cliente = '"~Var('VEHICULODE')~"' and Estado = 'HAB' ";Exe('COLOR6')
        'Ok'         ; p1..p:fac;  ;;;30;CHECK ;Exe('COLOR10');;;;;;;NO;; 
     FinListBox
  else
     * Selecciona
     **//Falta implementar titulo de ventana
     **//ListBox(a1..i:FAC,'Cliente     Mercado            Especie            Titulos          Moneda      Operacion','Seleccione las operaciones a netear')
     ListBox(a1..i:FAC,'Cliente     Mercado            Especie            Titulos          Moneda      Operacion')
  endif
Else
  * Liquidacion Automatica SI
  if Dialogo.Check6=0
     * NO Selecciona
     **** ListBox(a1..i:FAC,'Cliente     Mercado            Especie            Titulos          Moneda      Operacion','Seleccione las operaciones a liquidar',SI,NO)
  else
     * Selecciona
     **//ListBox(a1..i:FAC,'Cliente     Mercado            Especie            Titulos          Moneda      Operacion','Seleccione las operaciones a netear',SI,NO)
     ListBox(a1..i:FAC,'Cliente     Mercado            Especie            Titulos          Moneda      Operacion')
  endif
Endif

if OK o Dialogo.Check7=1
  if Dialogo.Check6=1
    * Selecciona
    (.'GENNETEO'.)
  else
    recorrer&I 1,FAC
      *-Si OK
      If Val(p:&i)=1
         ** Vouchers DEP,RET,COMP
         (.'GENVOUCH'.)
         SQL.EXEC
      EndIf
    proximo
  endif
else
  Cancelar
endif

recorrer&i 27,32
  ACO(&i,9)
proximo
recorrer&i 33,45
  ACO(&i,12)
proximo
recorrer&i 47,64
  ACO(&i,9)
proximo
