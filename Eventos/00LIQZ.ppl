   'Cta.Mon.Cli'  ; o1..o:fac ;NO;[Incluido(Val(s:flb),var('MERCAACMC')) y ClienteCuenta(SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' "),Val(o:flb))] o [[Val(ab:flb)=0 y ClienteCuenta(Val(aa:flb),Val(o:flb),Val(t:flb))] o [Val(ab:flb)=1 y [Vacio(BuscarCampo('CUENTAS','Cliente','Codigo',val(l:flb))) o ClienteCuenta(Val(aa:flb),Val(o:flb),Val(t:flb))]]] o Eqstr(Val(o:flb),VAR('CTAMOD23')) o Val(x:flb)=0 O Eqstr(Copy(Val(C:FLB), 1, 2), 'MM');'La Cta Moneda '~Val(o:FLB)~' del Cliente '~Val(aa:FLB)~' es incorrecta Op. '~Val(b:flb);70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';IIF(Incluido(Val(r:flb),var('MERCAACMC'))," Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' ")~"' and Estado='HAB' AND (Especies like '%"~Val(t:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%')",IIF(val(ab:flb)=0," (Cliente='"~Val(aa:flb)~"' and Estado='HAB' AND (Especies like '%"~Val(t:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%') and "~IIF(NoVacio(Val(s:FLB)),"Mercado = '"~Val(s:FLB)~"' "," Codigo=Codigo ")~")"," ((Cliente='"~Val(aa:flb)~"' or Cliente Is Null or Cliente='') and Estado='HAB' AND (Especies like '%"~Val(t:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%') and "~IIF(NoVacio(Val(s:FLB)),"Mercado = '"~Val(s:FLB)~"' "," Codigo=Codigo ")~")"));RGB(232,232,255);
   'Cta.Esp.Vh'   ; m1..m:fac ;NO;[Incluido(Val(r:flb),var('MERCAACMC')) y Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',Val(m:flb)),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' "))] o ClienteCuenta(Val(q:flb),Val(m:flb),Val(ff:flb)) o Val(x:flb)=0 o Val(ab:flb)=1 ;'La Cta Especie '~Val(m:FLB)~' del Vehiculo '~Val(q:FLB)~' es incorrecta Op.'~Val(b:flb);70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';IIF(Incluido(Val(r:flb),var('MERCAACMC'))," Comitente = '"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' ")~"' and Estado='HAB' AND (Especies like '%"~Val(ff:flb)~"%' OR Especies LIKE '%"~Val(ff:flb)~"%')", " (Cliente='"~Val(q:flb)~"'  and Estado='HAB' AND (Especies like '%"~Val(ff:flb)~"%' OR Especies LIKE '%"~Val(tt:flb)~"%') and "~IIF(NoVacio(Val(r:FLB)),"Mercado = '"~Val(r:FLB)~"' "," Codigo=Codigo ")~")");RGB(232,232,255);
   'Cta.Mon.Vh'   ; n1..n:fac ;NO;[Incluido(Val(s:flb),var('MERCAACMC')) y ClienteCuenta(SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' "),Val(n:flb))] o ClienteCuenta(Val(q:flb),Val(n:flb),Val(t:flb))  o Val(x:flb)=0  o Eqstr(Copy(Val(C:FLB), 1, 2), 'MM') o Val(ab:flb)=1 ;'La Cta Moneda '~Val(n:FLB)~' del Vehiculo '~Val(q:FLB)~' es incorrecta Op.'~Val(b:flb);70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';IIF(Incluido(Val(r:flb),var('MERCAACMC'))," Cliente   = '"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' ")~"' and Estado='HAB' AND (Especies like '%"~Val(t:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%')", " (Cliente='"~Val(q:flb)~"'  and Estado='HAB' AND (Especies like '%"~Val(t:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%') and "~IIF(NoVacio(Val(s:FLB)),"Mercado = '"~Val(s:FLB)~"' "," Codigo=Codigo ")~")");RGB(232,232,255);


   'Depos.'       ; ae1..ae:fac ;NO;;;80 ;STRING;100;RGB(232,232,255);BuscarCampo('CUENTAS','Comitente','Codigo',Val(l:FLB))
