CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;;;;;;;;;" NrOperacion IN (SELECT B.NrOperacion FROM "~DBO~".OPERACIONESBITS B WHERE B.NrOperacion = NrOperacion AND B.NrBit = 10 AND B.Valor = '1')  AND (TipoOp='TIDE' OR NrOperacion NOT IN (Select M.NrOperacion  From "~DBO~".MOVEJECUTADOS M Where M.NrOperacion = NrOperacion )) AND (NroAltaMAE IS Null or NroAltaMAE = '') "
  Vehiculo1:    'Vehiculo'  ;;;;;;;;;VAR('VEHICULODE')
  Check1: 'Lo llamo desde la Operacion';;;;NO;NO;;;;0
FinDialogo

IF NOT OK
   Cancelar
Endif

SQL.ADD(" SELECT DISTINCT O.Cliente1, O.Especie, O.ContraEspecie, O.Cantidad, O.Vehiculo1, ")
SQL.ADD(" O.Precio1, O.NrOperacion, O.TotalNetoCli1, O.TotalIntereses, O.TotalBrutoCli1, ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.TipoOp, C.RazonSocial, E.Nombre, O.Cuenta1, O.Cuenta2, ")
SQL.ADD(" O.Cuenta3, O.Cuenta4, O.Mercado, O.Mercado2, O.Especie1, O.RB10, O.RB6,C.CategDepositante , O.FechaPago ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE  O.Cliente1    = C.Codigo ")
SQL.ADD(" AND    O.Especie     = E.Codigo ")
SQL.ADD(" AND    O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND    O.TipoOp NOT IN ('FXOCTC','FXOCTV','FXCTC','FXVTC')  ")
SQL.ADD(" AND    (O.NroAltaMAE IS Null or O.NroAltaMAE = '')  ")
SQL.ADD(" AND    (O.TipoOp='TIDE' OR O.NrOperacion NOT IN (Select M.NrOperacion  From "~DBO~".MOVEJECUTADOS M Where M.NrOperacion = O.NrOperacion))  ")

SQL.ADD(" AND    B.Valor = '1'   ")
If Dialogo.Check1=0
   SQL.ADD(" AND    B.NrBit =  10 ")
Endif
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND  O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" ORDER BY O.Cliente1, O.TipoOp   ")

ACN(z:1, 0)
Recorrer SQL
  ACN(z:1, 1)
  ACT(a:fac, fbn('Cliente1')~' - '~fbn('RazonSocial'))
  ACT(aa:fac, fbn('Cliente1'))
  ACN(ab:fac, IIF(EqStr(fbn('CategDepositante'),'CLI'),1,0) )
  ACT(b:fac, fbn('NrOperacion'))
  ACT(c:fac, fbn('TipoOp'))
  ACD(d:fac, fbn('FechaOp'))
  ACD(e:fac, fbn('FechaVto'))
  ACT(f:fac, fbn('Especie')~' - '~fbn('Nombre'))
  ACT(ff:fac, fbn('Especie'))
  ACN(g:fac, fbn('Cantidad'))
  ACN(h:fac, fbn('Precio1'))
  ACN(i:fac, fbn('TotalBrutoCli1'))
  ACN(j:fac, fbn('TotalIntereses'))
  ACN(k:fac, fbn('TotalNetoCli1'))
  iF NOT INCLUIDO(fbn('TipoOp'), 'TIC|TIV|TIFC|TIFV|TIDE|TIPO|TICO|TICT|TCOPRI|TCPCEM')
     ACT(tt:fac, 'MONEDA')
     ACT(mm:fac, 'MONEDA')
     * ctas cliente
     ACT(l:fac, fbn('Cuenta3'))
     ACT(o:fac, fbn('Cuenta4'))
     * cta vehiculo
     ACT(m:fac, fbn('Cuenta1'))
     ACT(n:fac, fbn('Cuenta2'))
  Else
     ACT(tt:fac, 'TITULO')
     ACT(mm:fac, 'MONEDA')
     * ctas cliente
     ACT(l:fac, fbn('Cuenta1'))
     ACT(o:fac, fbn('Cuenta4'))
     * cta vehiculo
     ACT(m:fac, fbn('Cuenta2'))
     ACT(n:fac, fbn('Cuenta3'))
  Endif
  ACT(p:fac, '')
  ACT(u:fac, '')
  ACT(q:fac, fbn('Vehiculo1'))
  ACT(r:fac, fbn('Mercado'))
  ACT(s:fac, fbn('Mercado2'))
  IF Incluido(fbn('TipoOp'), 'FXCT|FXVT') Y fbn('RB10') = 1 Y fbn('RB6') = 1
      ***---NDF Internacional
      ACT(T:fac, fbn('Especie1'))
  ELSE
      ACT(t:fac, fbn('ContraEspecie'))
  ENDIF
  ACN(x:fac, 0)

  if Incluido(fbn('TipoOp'), 'FXC|FXV|FXA|FXCT|FXVT|FXAT|')
    acd(al:fac,FBN['FechaPago'])
  else
    acd(al:fac,FBN['FechaVto'])
  Endif

  act(ae:fac,BuscarCampo('CUENTAS','Comitente','Codigo',Val(l:fac)) )
  act(af:fac,BuscarCampo('CUENTAS','NrDepositante','Codigo',Val(l:fac)) )
  act(ag:fac,BuscarCampo('CUENTAS','Numero','Codigo',Val(l:Fac)) )
  act(ah:fac,BuscarCampo('CUENTAS','Corresponsal','Codigo',Val(l:fac))  )
  act(ai:fac,BuscarCampo('CUENTAS','Alias3','Codigo',Val(l:Fac)) )
  act(aj:fac,BuscarCampo('CUENTAS','Alias1','Codigo',Val(l:Fac)) )
  act(ak:fac,BuscarCampo('CUENTAS','Alias2','Codigo',Val(l:Fac)) )


Proximo

If Val(z:1)=0
   Cancelar('No se encontraron Operaciones para Confirmar.')
Endif

CrearListBox ; 'MS Sans SerIf,8,"DESCONFIRMAR Operacion - MANUAL -" '
   'Cliente'      ; a1..a:fac ;NO;SI;;100;STRING;;RGB(232,232,255); 
