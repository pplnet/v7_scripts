       SQL.ADD(" DELETE "~DBO~".CONFIRMACIONESOP  ")
       SQL.ADD(" Where NrOperacion = '"~Val(b:&i)~"'                 ")
       SQL.ADD("  and  NrConfirmacion = "~FSTR(Val(cf:1),0,0)~"      ")
