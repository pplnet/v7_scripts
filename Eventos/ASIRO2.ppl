CrearDialogo
   Vehiculo1   : 'Vehiculo'      ; ; ; ; ;  ;NoVacio(Dialogo.Vehiculo1)   ;'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1      : 'Fecha'         ; ; ; ; ;  ;Dialogo.Fecha1>=0 o Dialogo.Fecha1>=FSys;'Debe ingresar una Fecha valida';NO;FSys
   NrTrans1    : 'NrTrans'       ; ; ; ; ;  ;NoVacio(Dialogo.NrTrans1)   ;'Debe Ingresar una Transaccion ';NO;
FinDialogo

if Not OK
   Cancelar
endif

SetFilaActual(1)

SQL.ADD("Delete from "~DBO~".MOVLIMITES                  ")
SQL.ADD("Where Limite      = 'ACROFEX'                   ")
SQL.ADD("  AND NrOperacion = '"~Dialogo.NrTrans1~"'      ")
SQL.NEW

SQL.ADD("SELECT Especie, Cliente, Cantidad               ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES                      ")
SQL.ADD("Where NrOperacion = '"~Dialogo.NrTrans1~"'      ")
SQL.ADD("  and NrSaldo  = '"~VAR('BLOQGROFEX')~"'        ")

Recorrer SQL
     ACD(F1,Dialogo.Fecha1 )
     ACN(co:Fac, CotizacionC(fbn['Especie'],,,,Val(F1)-1,1,SI,'ARP')  )
     ACN(ca:Fac, FBN['Cantidad']*Val(co:Fac) )


     ****** Movimiento de Afectacion
     SQL.ADD("Insert into "~DBO~".MOVLIMITES (                                  ")
     SQL.ADD("  FechaMov,    Cliente,   Limite,                                 ")
     SQL.ADD("  Especie,     Monto,     NrOperacion,                            ")
     SQL.ADD("  Descripcion, Bits,      Vehiculo, GrupoEspecie                  ")
     SQL.ADD(") values (                                                        ")
*     SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN['Cliente']~"' , 'ACROFEX', ")
     SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~VAR('CLIROFEX')~"' , 'ACROFEX', ")
     SQL.ADD(" 'ARP',  "~FStr(Val(ca:fac),0,2)~", '"~Dialogo.NrTrans1~"',        ")
     SQL.ADD(" ' Asistencia garantias ROFEX ',                                  ")

     if Dialogo.Fecha1<=FSys
        SQL.ADD(" 'P', ")
     else
        SQL.ADD(" 'N', ")
     endif

     SQL.ADD(" '"~Dialogo.Vehiculo1~"' , '"~fbn['Especie']~"'                    ")
     SQL.ADD(" )                                                                 ")
     SQL.NEW

Proximo


SQL.EXEC








