        SQL.ADD(" Select Nrorden, Cliente, TipoOrden, FechaOrden, Especie, ContraEspecie, CantidadTotalOrden, ")
        SQL.ADD("        Mercado, Mercado2, Mercado3, Mercado4, NroAltamae Secuencia, FechaVto, ")
        SQL.ADD("        Vehiculo, Cantidad4, Operador, RB9, RB10, Book1, Lotes Plazo, RB5, ")
        SQL.ADD("        Cuotas1, CB10, Cupon1, AfectaLS, TablaFeriados1, Operador1, ")
        SQL.ADD("        Cuenta1, Cuenta4, Cuenta5, MB2 ,RuedaMAE, FechaAltaMae ")
        SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~Dialogo.NrOrden1~"' ")
        Recorrer SQL
          DFA
          ACT(u:2,  fbn('TipoOrden'))
          ACT(t:3, fbn('Especie'))
          ACN(t:11, fbn('CantidadTotalOrden'))
          ACT(t:12, fbn('ContraEspecie'))
          ACN(t:13, fbn('Cantidad4'))
          ACT(t:17, fbn('Cupon1'))
          ACD(t:19, fbn('FechaOrden'))
          ACT(t:20, fbn('RB5'))
          ACN(t:21, fbn('Plazo'))
          ACT(t:22, fbn('Mercado')) 
          ACN(t:23, fbn('RB9'))
          ACT(t:24, fbn('TablaFeriados1'))
          ACT(t:25, fbn('Operador'))
          ACT(t:26, fbn('Operador1'))
          ACT(t:29, fbn('Vehiculo'))
          ACT(t:31, fbn('Mercado3'))
          ACT(t:32, fbn('RuedaMAE'))
          ACT(t:33, '0')
          ACD(t:45, fbn('FechaVto'))
          ACT(t:52, fbn('Mercado2'))
          ACT(t:53, fbn('NrOrden'))
          ACT(t:56, fbn('Cliente')) 
          if  Eqstr(Val(t:56),Var('VEHICULO'))    
             ACN(t:55,1)
          Else
             ACN(t:55,0)   
          Endif        
          ACT(t:71, fbn('AfectaLS'))         
          ACT(t:75, fbn('Book1'))
          ACT(t:28, fbn('Cuenta1'))
          ACT(t:80, fbn('Cuenta4'))
          ACT(t:81, fbn('Cuenta5'))
          ACT(t:82, fbn('MB2'))
          ACT(t:84, Copy(Fecha(fbn('FechaAltaMae')),7,4)~'-'~Copy(Fecha(fbn('FechaAltaMae')),4,2)~'-'~Copy(Fecha(fbn('FechaAltaMae')),1,2)~' '~Copy(Hora(fbn('FechaAltaMae')),1,2)~':'~Copy(Hora(fbn('FechaAltaMae')),4,2)~':'~Copy(Hora(fbn('FechaAltaMae')),7,2))
          ACT(t:49,"Convert(datetime,'"~Val(t:84)~"',120)")
          *messagebox(Val(t:84)~' - '~Val(t:49))
          if Incluido(fbn('RuedaMAE'),Var('RUECPC1')) y Not Eqstr(Val(t:56),Var('VEHICULO'))    
            ACT(t:73,'1')
         Else   
            ACT(t:73,'0')
         Endif
          
          if EqStr(Val(u:2),'OTIC')
            ACT(t:2,'TIC')
          else
             if EqStr(Val(u:2),'OTIV')
               ACT(t:2,'TIV')
             else
               ACT(t:2,'NOENCONTRADA')
             endif   
          endif

        
   
          ACT(x:1, 'S')
          ACT(t:27, SQL("Select CodMAEContado From "~DBO~".ESPECIES Where Codigo='"~Val(t:3)~"' "))
          (.'AUXGENORDA'.)
          SQL.EXEC


        Message('Modificar Operacion '~Val(w6))
        ModificarOperacion(Val(w6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
        
        IF Ok
           ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
            SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w6)~"' ")
            SQL.NEW
            SQL.EXEC                   
        Endif
        ** Actualiza ejecuciones y Orden con NrOperacion
         SQL.ADD("Update "~DBO~".EJECUCIONES  ")
         SQL.ADD("Set NrOperacion='"~Val(w6)~"'  ")
         SQL.ADD(" where NrOrden = '"~Val(t:53)~"' ")
         SQL.NEW
         SQL.ADD("Update "~DBO~".ORDENES  ")
         SQL.ADD("Set NrOperacion2='"~Val(w6)~"'  ")
         SQL.ADD(" where NrOrden = '"~Val(t:53)~"' ")
         SQL.NEW
         SQL.EXEC           
        
        ** Instancia Orden 9 Ejecutada  
         SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
         SQL.ADD("Set Valor='0'  ")
         SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Valor = '1' ")
         SQL.NEW
         SQL.EXEC           
         SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
         SQL.ADD("Set Valor='1'  ")
         SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Nrbit = 9 ")
         SQL.NEW
         ** Instancia Operacion 13 Ejecutada Se elimina (va a 13 despues de poner boleto)
         ** Instancia Operacion 65 envia Boleto MAE                   
         SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
         SQL.ADD("Set Valor='0'  ")
         SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Valor = '1' ")
         SQL.NEW
         SQL.EXEC  
         * asignar nro. de boleto automaticamente
         EjecutarEvento('ASIBOL',Radio1=1,NrOperacion1=Val(w6))
         SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
         SQL.ADD("Set Valor='1'  ")
         SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Nrbit = 65 ")
         SQL.NEW
         SQL.EXEC
   
        Proximo 