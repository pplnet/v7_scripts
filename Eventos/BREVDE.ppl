*--- Traigo los Dias en los que la Operacion devengo resultados ----
SQL.ADD(" Select Sum(Monto), EspecieRef,TipoDevengado,Cliente,Vehiculo,Responsable,Producto, ")
SQL.ADD("          GrupoEspecie,NrSaldo,Especie,FechaEj,CallPut,Book,Fecha, ")
SQL.ADD("          TipoNegocio,Cupon,TipoPosicion ")
SQL.ADD("          FROM "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD("       and  Fecha < "~IdxDate2(Dialogo.Fecha1)) 
SQL.ADD(" group by EspecieRef,TipoDevengado,Cliente,Vehiculo,Responsable,Producto, ")
SQL.ADD("          GrupoEspecie,NrSaldo,Especie,FechaEj,CallPut,Book,Fecha, ")
SQL.ADD("          TipoNegocio,Cupon,TipoPosicion ")
SQL.ADD(" order by TipoDevengado,Fecha  ")     

