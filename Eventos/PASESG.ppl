MostrarCuadroDeMensajes
*****************************************************************
* GENERA UN PASE A PARTIR DE UNA OPERACION CONTADO Y UNA FUTURO *
*****************************************************************

SQL.ADD(" Select O.NrOperacion3, Sum(1) cuantas, min(TipoOp) Tipo, O.Vehiculo1, O.FechaOp, O.Especie ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
SQL.ADD(" where O.NrOperacion=B.NrOperacion and NrBit IN (10,70,80)  and Valor = '1' ")
SQL.ADD(" and   O.TipoOp in ('TIC','TIV','TIFC','TIFV')  ")
SQL.ADD(" and   O.NrOperacion3 is NOT NUll               ")
SQL.ADD(" and   O.PaseCB ='1' and O.CB5 ='1'             ")
SQL.ADD(" and (O.OperacionRef is  NUll OR O.OperacionRef = '' ) ")
SQL.ADD(" Group by O.NrOperacion3, O.Vehiculo1, O.FechaOp, O.Especie ")
Recorrer SQL
  Message('Operaciones encontradas ... ')
  If fbn('cuantas') = 2 
     If Eqstr(fbn('Tipo'),'TIC') o Eqstr(fbn('Tipo'),'TIFV') 
        ACT(tp1, 'TIPA')
     Else
        ACT(tp1, 'TIPP')
     Endif

     SQL.ADD(" Select * From "~DBO~".OPERACIONES   ")
     SQL.ADD(" WHERE TipoOp in ('TIC','TIV')       ")
     SQL.ADD(" AND Vehiculo1 = '"~fbn('Vehiculo1')~" '         ")
     SQL.ADD(" AND NrOperacion3 = '"~fbn('NrOperacion3')~"'    ")
     SQL.ADD(" AND (OperacionRef is NUll OR OperacionRef = '') ")
     SQL.ADD(" AND PaseCB ='1' and CB5 ='1'                    ")
     SQL.ADD(" AND FechaOp  = "~idxdate2(fbn('FechaOp'))~"     ")
     SQL.ADD(" AND Especie  = '"~fbn('Especie')~"'             ")
     Recorrer SQL
       ACT(nu1, GetNumerador(1))
       Message('Generando Pase '~Val(nu1)~' ... ')
       * Genero operacion de Pase
       SQL.ADD(" Insert Into "~DBO~".OPERACIONES ")
       SQL.ADD(" ( FechaOp, Especie, Cliente1,DiasAnio, ")
       SQL.ADD(" Cantidad, Precio1, Corredor, EnteCus1, ")
       SQL.ADD(" Plazo, FechaVto, PorComision, ")
       SQL.ADD(" ContraEspecie, FormaLiquidacion1, TotalIntereses, TotalDerechos, ")
       SQL.ADD(" TotalNetoCli1, TotalBrutoCli1, Mercado, ")
       SQL.ADD(" Operador, TablaFeriados1, Observaciones,Book1, ")
       SQL.ADD(" TotalComisiones, PaseCB, OperacionRef, ")
       SQL.ADD(" FechaPago, FormaLiquidacion2, FechaUltCupon, ")
       SQL.ADD(" TasaInteresesCupon, PorImpuesto, TotalGanancias, ")
       SQL.ADD(" PorArancel, TotalRetenciones, Cartera,Corporate,TasaBase, ")
       SQL.ADD(" Vehiculo1, OpSIOPEL, CB5, CB6, CB7,Cupon1, RB10, ")
       SQL.ADD(" NrOperacion, TipoCambio2, EsAforado, PorAforo, TotalCaucion, RB9, ")
       SQL.ADD(" TipoOp, FechaCarga, FechaCargaSys")
       SQL.ADD(", FechaAltaMAE, NroAltaMAE, AceptaMAE, FechaEnvioMAE,MB1, ")
       SQL.ADD(" CanPosInv1, CanPosInv2, CanPosTrad, CanPosOSoc, Precio3, RB5 ")
       SQL.ADD(" ) Values ( ")
       * FechaOp
       SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~FBN['Especie']~"', '"~FBN['Cliente1']~"','1', ")
       * Cantidad
       SQL.ADD(" "~FStr(fbn('Cantidad'),1,2)~", "~FStr(fbn('Precio1'),1,8)~", '0000', '"~FBN['EnteCus1']~"', ")
       * Plazo
       SQL.ADD(" "~FStr(Difdias(FBN['FechaOp'],FBN['FechaVto'],'ARG',NO),1,0)~", '"~IdxDate(FBN['FechaVto'])~"', "~FStr(0,1,7)~", ")
       * Contraesp
       SQL.ADD(" '"~FBN['ContraEspecie']~"',")
       If Eqstr(fbn('Mercado'),'CV')
          SQL.ADD(" '"~FBN['FormaLiquidacion1']~"',")
       Else
          SQL.ADD(" '"~FBN['FormaLiquidacion2']~"',")
       Endif
       SQL.ADD(" "~FStr(fbn('TotalIntereses'),1,2)~", "~FStr(fbn('TotalIntereses'),1,2)~", ")
       *TotalNeto
       SQL.ADD(" "~FStr(fbn('TotalNetoCli1'),1,2)~", "~FStr(fbn('TotalBrutoCli1'),1,2)~", '"~FBN['Mercado']~"', ")
       *Operador
       SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['TablaFeriados1']~"', '"~FBN['Observaciones']~"', '"~fbn('Book1')~"',")
       * TotalCOMISIONES
       SQL.ADD(" "~FStr(0,1,2)~", '1', '"~FBN['NrOperacion']~"', ")
       * FECHAPAGO
       SQL.ADD(" '"~IdxDate(FBN['FechaVto'])~"', '"~FBN['FormaLiquidacion2']~"', '"~IdxDate(FBN['FechaUltCupon'])~"', ")
       SQL.ADD(" "~Fstr(FBN['Precio4'],1,6)~", "~FStr(FBN['PorImpuesto'],1,2)~", "~FStr(FBN['TotalGanancias'],1,2)~", ")
       SQL.ADD(" "~FStr(FBN['PorArancel'],1,2)~", "~FStr(FBN['TotalRetenciones'],1,2)~", '0','"~fbn('Corporate')~"','"~fbn('TipoCambio3')~"', ")
       SQL.ADD(" '"~FBN['Vehiculo1']~"', '"~FBN['OpSIOPEL']~"', '"~fbn('CB5')~"', '0', '"~fbn('CB7')~"','"~fbn('Cupon1')~"', '"~fbn('RB10')~"',")
       SQL.ADD(" '"~Val(nu1)~"', "~FStr(fbn('TipoCambio2'),1,8)~", '"~fbn['EsAforado']~"', "~FStr(FBN['PorAforo'],1,2)~", "~FStr(fbn('TotalCaucion'),1,2)~", '"~fbn('RB9')~"',")
       SQL.ADD(" '"~Val(tp1)~"'  ")
       SQL.ADD(", "~SQLFecha(fbn('FechaCarga'))~", '"~IdxDate(fbn('FechaCargaSys'))~"' ")
       SQL.ADD(", '"~IdxDate(fbn('FechaAltaMAE'))~"', '"~fbn('NroBajaMAE')~"', 'SI', '"~IdxDate(fbn('FechaAltaMAE'))~"' ,'0', ")
       SQL.ADD(" 0, 0, "~FStr(fbn('Cantidad'),1,2)~", 0, "~FStr(fbn('Precio2'),1,8)~", '"~fbn('RB5')~"' ")
       SQL.ADD(" ) ")
       SQL.NEW

*       EJECUTAREVENTO('ESTCLI',NrOperacion1=Val(nu:1),Cliente1=fbn('Cliente1'))
     Proximo

     SQL.ADD(" Select Precio1, Plazo, FormaLiquidacion1, TotalIntereses, TotalBrutoCli1, FechaVto, TipoCambio2, TotalCaucion ")
     SQL.ADD(" From "~DBO~".OPERACIONES    ")
     SQL.ADD(" WHERE TipoOp in ('TIFC','TIFV')      ")
     SQL.ADD(" AND   Vehiculo1    = '"~fbn('Vehiculo1')~"'      ")
     SQL.ADD(" AND   NrOperacion3 = '"~fbn('NrOperacion3')~"'   ")
     * FO 20061011 - Agrego esto por NrOperacion3 (Nr Ref que envia MAE) se puede repetir
     SQL.ADD(" AND PaseCB   = '1' and CB5 ='1'            ")
     SQL.ADD(" AND FechaOp  = "~idxdate2(fbn('FechaOp'))~" ")
     SQL.ADD(" AND Especie  = '"~fbn('Especie')~"'        ")
     * Actualiza el pase con los datos de la pata futuro
     Recorrer SQL
       Message('Actualizando Pase '~Val(nu1)~'... ')
       SQL.ADD(" Update "~DBO~".OPERACIONES                    ")
       SQL.ADD(" set Precio2 = "~FStr(fbn('Precio1'),1,8)~",   ")
       SQL.ADD("     Plazo   = "~FStr(fbn('Plazo'),1,0)~",     ")
       SQL.ADD("     FormaLiquidacion2   = "~FStr(fbn('FormaLiquidacion1'),1,0)~",  ")
       SQL.ADD("     TotalAux1  ="~FStr(fbn('TotalIntereses'),1,2)~",")
       SQL.ADD("     TotalBrutoCli2  ="~FStr(fbn('TotalBrutoCli1'),1,2)~",")
       SQL.ADD("     FechaVto   ='"~IdxDate(FBN['FechaVto'])~"', ")
       SQL.ADD("     FechaVto2  ='"~IdxDate(FBN['FechaVto'])~"' ")
       If Var('AFOROMAE')>0
          SQL.ADD(", EsAforado = '1', ")
          SQL.ADD("  PorAforo  = "~fstr(VAR('AFOROMAE'),0,2)~", ")
          SQL.ADD("  TipoCambio2 = "~fstr(fbn('TipoCambio2'),0,8)~", ")
          SQL.ADD("  TotalGastos = "~fstr(fbn('TotalCaucion'),0,2)~" ")
       Endif
       SQL.ADD(" where  NrOperacion =  '"~Val(nu1)~"'   ")
       SQL.NEW
     Proximo

     If Var('AFOROMAE')>0
        Message('Actualizando Aforo de Operacion Contado ... ')
        SQL.ADD(" Select TipoCambio2, TotalCaucion ")
        SQL.ADD(" From "~DBO~".OPERACIONES         ")
        SQL.ADD(" WHERE TipoOp in ('TIC','TIV')    ")
        SQL.ADD(" AND   Vehiculo1    = '"~fbn('Vehiculo1')~"'    ")
        SQL.ADD(" AND   NrOperacion3 = '"~fbn('NrOperacion3')~"' ")
        * FO 20061011 - Agrego esto por NrOperacion3 (Nr Ref que envia MAE) se puede repetir
        SQL.ADD(" AND PaseCB   = '1' and CB5 ='1'            ")
        SQL.ADD(" AND FechaOp  = "~idxdate2(fbn('FechaOp'))~" ")
        SQL.ADD(" AND Especie  = '"~fbn('Especie')~"' ")
        Recorrer SQL
          SQL.ADD(" Update "~DBO~".OPERACIONES SET ")
          SQL.ADD(" TipoCambio   = "~fstr(fbn('TipoCambio2'),0,8)~", ")
          SQL.ADD(" TotalCaucion = "~fstr(fbn('TotalCaucion'),0,2)~" ")
          SQL.ADD(" where  NrOperacion =  '"~Val(nu1)~"' ")
          SQL.NEW
        Proximo
     Endif

     SQL.ADD("SELECT NrInstancia FROM "~DBO~".INSTANCIAS Where Tabla='OPERACIONES' ")
     SQL.ADD("ORDER BY NrInstancia ")
     Recorrer SQL 
        dfa
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
        SQL.ADD("(NrOperacion,NrBit,Valor) ")
        SQL.ADD(" Values ")
        SQL.ADD("('"~Val(nu1)~"',"~Fstr(FBN['NrInstancia'],3,0)~",")
        IF Incluido(FBN['NrInstancia'], '70')
           SQL.ADD("'1')")
        ELSE
           SQL.ADD("'0')")
        ENDIF
        SQL.NEW
        SQL.EXEC
     Proximo

     SQL.ADD(" Update "~DBO~".OPERACIONES set OperacionRef = '"~val(nu1)~"'  ")
     SQL.ADD(" where  NrOperacion3 =  '"~fbn('NrOperacion3')~"' ")
     SQL.ADD(" AND PaseCB   = '1' and CB5 ='1'             ")
     SQL.ADD(" AND FechaOp  = "~idxdate2(fbn('FechaOp'))~" ")
     SQL.ADD(" AND Especie  = '"~fbn('Especie')~"' ")
     SQL.NEW
     SQL.EXEC
     sql.ActualizarMovimientos3(val(nu1),NO,NO,NO,NO,SI)
     SQL.EXEC
  Endif 
Proximo
