ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1: 'Nr. Operacion' ;1;1;1;  ;  ;Novacio(Dialogo.NrOperacion1);'Operacion Invalida.';NO;
  Check1:       'Procesa'       ; ; ;1;SI;SI;;;;0;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

*MessageBox('MOPEXT '~Dialogo.NrOperacion1)

ACT(w:2, VAR('CONTROLAPM'))
* FJL 17/07/19 - El plazo maximo se lee de la variable
ACN(w:3, VAR('PLAMAXSESS'))

ACT(a:1, 'Nr Operacion')
ACT(a:2, 'Cod SE')
ACT(a:3, 'ID SE')
ACT(a:4, 'Nr SE')
ACT(a:5, 'TipoOp')
ACT(a:6, 'Especie')
ACT(a:7, 'Cliente1')
ACT(a:8, 'ContraEspecie')
ACT(a:9, 'Cant OpExt')
ACT(a:10, 'Errores')
ACT(a:11, 'Accion')
ACT(a:12, 'Cant. Excep')

ACT(s:1, 'ID SE')
ACT(s:2, 'Cod SE')
ACT(s:3, 'Nr SE')
ACT(s:4, 'TipoOp SE')
ACT(s:5, 'TipoOp')
ACT(s:6, 'T.Esp. SE')
ACT(s:7, 'Especie SE')
ACT(s:8, 'Especie FPA')
ACT(s:9, 'Especie OK')
ACT(s:10, 'Esp Valida')
ACT(s:11, 'T.Cli. SE')
ACT(s:12, 'Cli. SE')
ACT(s:13, 'Cliente')
ACT(s:14, 'Cliente OK')
ACT(s:15, 'Cantidad')
ACT(s:16, 'Precio SE')
ACT(s:17, 'T.CEsp. SE')
ACT(s:18, 'CEsp. SE')
ACT(s:19, 'CEsp. FPA')
ACT(s:20, 'ContraEspecie OK')
ACT(s:21, 'FechaOp SE')
ACT(s:22, 'FechaOp')
ACT(s:23, 'Plazo SE')
ACT(s:24, 'Plazo')
ACT(s:25, 'RB5')
ACT(s:26, 'Operador SE')
ACT(s:27, 'Operador')
ACT(s:28, 'Book SE')
ACT(s:29, 'Book')
ACT(s:30, 'Vehiculo')
ACT(s:31, 'Feriados')
ACT(s:32, 'FechaVto')

ACT(s:38, 'Estado')
ACT(s:39, 'Op Generada')
ACT(s:40, 'A Compliance')

SQL.ADD("Select * from "~DBO~".OPERACIONES ")
SQL.ADD(" where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  ACT(b:1, fbn['NrOperacion'])
  ACT(b:2, fbn['CodSisExterno'])
  ACN(b:3, fbn['IDSisExterno'])
  ACT(b:4, fbn['NrExterno'])
  ACT(b:5, fbn['TipoOp'])
  ACT(b:6, fbn['Especie'])
  ACT(b:7, fbn['Cliente1'])
  ACT(b:8, fbn['ContraEspecie'])
  ACN(b:9, 0)
  ACN(b:10, 0)

  SQL.ADD("Select * from "~DBO~".OPEXTERNAS ")
  SQL.ADD("  where CodSisExterno = Upper('"~Val(b:2)~"')  ")
  SQL.ADD("    and IDSisExterno = "~FStr(Val(b:3),1,0)~"  ")
  Recorrer SQL
    SCN(b:9, 1)
    BorrarCeldas(t:1..t:53)
    * Estado
    ACT(t:38, fbn('Estado'))
    * Op.Generada
    ACT(t:39, fbn('NrOperacion'))
    * A Compliance
    ACT(t:40, 'NO')
    ***** IDSisExterno
    ACN(t:1, fbn('IDSisExterno'))
    ***** SisExterno
    ACT(t:2, fbn('CodSisExterno'))
    ***** NrExterno
    ACT(t:3, fbn('NrExterno'))
    ***** TipoOp
    ACT(t:4, fbn('TipoOp'))
    if EqStr(fbn('TipoOp'),'TC')
      ACT(t:5,'TIC')
    endif
    if EqStr(fbn('TipoOp'),'TV')
      ACT(t:5,'TIV')
    endif

    ***** TipoEspecie
    ACT(t:6, fbn('TipoEspecie'))
    ***** Especie
    ACT(t:7, fbn('Especie'))
    if EqStr(Val(t:6),'ISIN')
      ACT(t:8, BuscarCampo('ESPECIES','Codigo','ISIN',Val(t:7)))
    endif
    if EqStr(Val(t:6),'BBG')
     ACT(t:8, BuscarCampo('ESPECIES','Codigo','Codigo2',Val(t:7)))
    endif
    if Vacio(Val(t:8))
      ACT(t:9, 'Error')
      * A compliance
      ACT(t:40, 'SI')
    else
      ACT(t:9, 'OK')
      ACT(t:10, BuscarCampo('ESPECIES','EstadoOperativo','Codigo',Val(t:8)))
      if Vacio(Val(t:10))
        ACT(t:10, 'NE')
      endif
    endif
  
    ***** TipoCliente
    ACT(t:11, fbn('TipoCliente'))
    ***** Especie
    ACT(t:12, fbn('Cliente'))
    if EqStr(Val(t:11),'COPER')
      ACT(t:13, BuscarCampo('CLIENTESDOCUMENTACION','Codigo','NrCOPERS',Val(t:12)))
    endif
    if Vacio(Val(t:13))
      ACT(t:14, 'Error')
      * A compliance
      ACT(t:40, 'SI')
    else
      ACT(t:14, 'OK')
    endif

    ***** Cantidad SE
    ACN(t:15, fbn('Cantidad'))
    ***** Precio SE
    ACN(t:16, fbn('Precio'))
  
    ***** TipoContraEspecie
    ACT(t:17, fbn('TipoContraEspecie'))
    ***** ContraEspecie
    ACT(t:18, fbn('ContraEspecie'))
    if EqStr(Val(t:17),'ISO')
      ACT(t:19, BuscarCampo('ESPECIES','Codigo','ISO',Val(t:18)))
    endif
    if Vacio(Val(t:19))
      ACT(t:20, 'Error')
      * A compliance
      ACT(t:40, 'SI')
    else
      ACT(t:20, 'OK')
    endif

    ***** FechaOp SE
    ACD(t:21, fbn('FechaOp'))
    ***** Fecha Op
    ACD(t:22, fbn('FechaOp'))

    ***** Plazo SE
    ACN(t:23, fbn('Plazo'))
    ***** Plazo
    ACN(t:24, Num(fbn('Plazo'))*24)
    ***** RB5
    ACT(t:25, FStr(fbn('Plazo'),1,0))

    ***** Operador SE
    ACT(t:26, fbn('Operador'))
    ***** Operador FPA (Usuario)
    ACT(t:27, BuscarCampo('USUARIOS','Codigo','Codigo',fbn('Operador')))

    ***** Book SE
    ACT(t:28, fbn('Book'))
    ***** Book FPA
    ACT(t:29, BuscarCampo('BOOKS','Codigo','Codigo',fbn('Book')))

    ***** Vehiculo1
    ACT(t:30, Var('VEHICULODE'))
  proximo
  if Val(b:9)<>1
    ACN(b:10, 1)
    ACT(b:11, 'Error ID - Sin Accion')
  endif
  if Val(b:10)=0
    ACN(b:12, SQL("Select Count(*) from "~DBO~".EXCEPCIONES where NrOperacion = '"~Val(b:1)~"' and Tipo in ('ERRORSISEX') "))
    if Val(b:12)>0
      ACT(t:40, 'SI')
    endif
    if Dialogo.Check1=1
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("   Set Especie       = '"~Val(t:8)~"',")
      SQL.ADD("       Cliente1      = '"~Val(t:13)~"', ")
      SQL.ADD("       ContraEspecie = '"~Val(t:19)~"' ")
      SQL.ADD(" where NrOperacion   = '"~Val(b:1)~"' ")
      SQL.NEW
** FJL 11/07/19 - Agrego esto xq el ModOpe() las duplicaba
      SQL.ADD("Delete "~DBO~".EXCEPCIONES ")
      SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
      SQL.ADD("   and Tipo        Not in ('ERRORSISEX') ")
      SQL.NEW
      SQL.EXEC
    endif

    If EqStr(Val(t:40),'SI')
      * Queda en Compliance
      ACT(b:11, 'Update y Queda')
      Message('Modificar Operacion '~Val(b:1)~' - Sin Movimientos')
      if Dialogo.Check1=1
        ModificarOperacion(Val(b:1),0,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
      Endif
      Message('Operacion '~Val(b:1)~' Ok. Queda a Instancia 9')
      if Dialogo.Check1=1
        EjecutarEvento('CBOINS', String1=Val(b:1), Radio1=0, Radio2=0, Entero1=1, Entero2=9)
      Endif
* FJL 12/07/19 - Generacion de Excepciones
      if EqStr(Val(t:9),'Error')
        ACT(e:1, 'Error Especie. El codigo '~Val(t:6)~' '~Val(t:7)~' no existe en FPA.')
        SCN(t:48, 1)
        ACT(f:Val(t:48), Val(e:1))
        if Dialogo.Check1=1
          SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
          SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
          SQL.ADD(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
          SQL.NEW
        endif
      endif
      if EqStr(Val(t:14),'Error')
        ACT(e:1, 'Error Cliente. El codigo '~Val(t:11)~' '~Val(t:12)~' no existe en FPA.')
        SCN(t:48, 1)
        ACT(f:Val(t:48), Val(e:1))
        if Dialogo.Check1=1
          SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
          SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
          SQL.ADD(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
          SQL.NEW
        endif
      endif
      if EqStr(Val(t:20),'Error')
        ACT(e:1, 'Error Contraespecie. El codigo '~Val(t:17)~' '~Val(t:18)~' no existe en FPA.')
        SCN(t:48, 1)
        ACT(f:Val(t:48), Val(e:1))
        if Dialogo.Check1=1
          SQL.ADD(" Insert into "~DBO~".EXCEPCIONES ")
          SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion ) Values ")
          SQL.ADD(" ('"~Val(b:1)~"', 'WARNSISEX', '"~IdxDate(FSYS)~"' , '"~Val(e:1)~"' ) ")
          SQL.NEW
        endif
      endif
      if Dialogo.Check1=1
        SQL.EXEC                   
      endif
      MessageBox('Operacion '~Val(b:1)~' No cumple alguna condicion y queda en Compliance.  Verifique Excepciones')
    else
      ACT(b:11, 'Update y pasa')
      Message('Modificar Operacion '~Val(b:1))
      if Dialogo.Check1=1
        ModificarOperacion(Val(b:1),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
        IF Ok
          ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
          SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 0 where NrOperacion = '"~Val(b:1)~"' ")
          SQL.NEW
          SQL.EXEC                   
        Endif
      Endif
*      MessageBox('Operacion '~Val(b:1)~' pasa a 1')
    endif
  endif
proximo


if Dialogo.Check1=0 y FAC>0
  FormatoCeldas(b:3..b:3,Exe('F0'))
  FormatoCeldas(t:15..t:15,Exe('F2'))
  FormatoCeldas(t:16..t:16,Exe('F8'))
  FormatoCeldas(t:23..t:25,Exe('F0'))
  FormatoCeldas(t:41..t:42,Exe('F0'))
  FormatoCeldas(t:44..t:44,Exe('F0'))

  ACO(1, 10)
  ACO(2, 12)
  ACO(19,15)
  ACO(20,12)
endif
