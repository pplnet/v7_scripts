CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif

message('--- Asientos de Revaluo Pendientes de liquidacion Moneda Extranjera ---')
ACT(TA:1, Var('TIPASIREVM'))
ACT(ML:1, Var('MONELOCA'))
ACN(NA:1, Var('ASINUM'))
ACT(VC:1, Dialogo.Vehiculo1)
ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))

IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 4
    ***--- Operaciones a Revaluar cargadas Hoy Fecha Valor (Tipo 1)
    SQL.ADD("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1 ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND FechaCargaSys = "~IdxDate2(Dialogo.Fecha1)~" AND FechaOp < "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    SQL.ADD(" AND O.FechaVto > O.FechaOp ")
    SQL.ADD("UNION ")
    ** --- Revaluo TCPCEM para Terceros tomando las TCOPRI MovPendientes
    SQL.ADD("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov,  OO.Cliente1 as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ORDENES OD, "~DBO~".OPERACIONES OO ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = OO.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND OD.NrOrden=O.NrOrden1 and OO.NrOperacion=OD.NrOperacion1 ")
    SQL.ADD("AND O.FechaCargaSys = "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaOp < "~IdxDate2(Dialogo.Fecha1)~" AND O.ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.Corporate <> 1 ")
    SQL.ADD("AND O.TipoOp in ('TCOPRI') ")
    SQL.ADD(" AND O.FechaVto > O.FechaOp ")
    SQL.ADD("UNION ")
    SQL.ADD("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND FechaCargaSys = "~IdxDate2(Dialogo.Fecha1)~" AND FechaOp < "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    SQL.ADD(" AND O.FechaVto > O.FechaOp ")
    SQL.ADD("UNION ")
    ** --- Revaluo TCPCEM para Terceros tomando las TCOPRI MovEjecutados
    SQL.ADD("SELECT M.Cantidad, 1 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov,  OO.Cliente1 as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ORDENES OD, "~DBO~".OPERACIONES OO ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = OO.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND OD.NrOrden=O.NrOrden1 and OO.NrOperacion=OD.NrOperacion1 ")
    SQL.ADD("AND O.FechaCargaSys = "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaOp < "~IdxDate2(Dialogo.Fecha1)~" AND O.ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.Corporate <> 1 ")
    SQL.ADD("AND O.TipoOp in ('TCOPRI') ")
    SQL.ADD(" AND O.FechaVto > O.FechaOp ")
    SQL.ADD("UNION ")
    ***---Operaciones vigentes a revaluar HOY ingresadas anteriormente (Tipo 2)
    SQL.ADD("SELECT M.Cantidad, 2 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVPENDIENTES M,"~DBO~".CLIENTES C  ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND FechaVto >= "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND M.FechaMov <= O.FechaVto ")
    SQL.ADD("UNION ")
    ** --- Revaluo TCPCEM para Terceros tomando las TCOPRI MovPendientes
    SQL.ADD("SELECT M.Cantidad, 2 Tipo, O.NrOperacion, 'TCPCEM' TipoOp, 'TCPCEM_RV' CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov,  OO.Cliente1 as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".ORDENES OD, "~DBO~".OPERACIONES OO  ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = OO.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND OD.NrOrden=O.NrOrden1 and OO.NrOperacion=OD.NrOperacion1 ")
    SQL.ADD("AND O.FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaVto >= "~IdxDate2(Dialogo.Fecha1)~" AND O.ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.Corporate <> 1 ")
    SQL.ADD("AND O.TipoOp in ('TCOPRI') ")
    SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND M.FechaMov <= O.FechaVto ")
    SQL.ADD("UNION ")
    SQL.ADD("SELECT M.Cantidad, 2 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C  ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND FechaVto >= "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND M.FechaMov <= O.FechaVto ")
    SQL.ADD("UNION ")
    ** --- Revaluo TCPCEM para Terceros tomando las TCOPRI MovEjecutados
    SQL.ADD("SELECT M.Cantidad, 2 Tipo, O.NrOperacion, 'TCPCEM' TipoOp, 'TCPCEM_RV' CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov,  OO.Cliente1 as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ORDENES OD, "~DBO~".OPERACIONES OO  ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = OO.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND OD.NrOrden=O.NrOrden1 and OO.NrOperacion=OD.NrOperacion1 ")
    SQL.ADD("AND O.FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaVto >= "~IdxDate2(Dialogo.Fecha1)~" AND O.ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.Corporate <> 1 ")
    SQL.ADD("AND O.TipoOp in ('TCOPRI') ")
    SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND M.FechaMov <= O.FechaVto ")
    SQL.ADD("UNION ")
    ***---Movimientos Diferidos (Tipo 3)
    SQL.ADD("SELECT M.Cantidad, 3 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    SQL.ADD(" M.FechaMov, (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente , C.Jerarquia, O.Especie, ")
    SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante, O.Cliente1  ")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C  ")
    SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    SQL.ADD("AND FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND FechaVto < "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    *SQL.ADD("UNION ")
    *SQL.ADD("SELECT M.Cantidad, 3 Tipo, O.NrOperacion, O.TipoOp, MA.Codigo CodAsi, O.Vehiculo1, O.FechaOp, O.ContraEspecie, ")
    *SQL.ADD(" M.FechaMov, O.Cliente1 Cliente, C.Jerarquia, O.Especie, ")
    *SQL.ADD("'Revaluo MonExt (' + rtrim(O.NrOperacion) + ') ,' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, C.CategDepositante ")
    *SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ModelosAsiento MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C  ")
    *SQL.ADD("WHERE MA.TipoAsiento = '"~Val(TA:1)~"' AND MA.TipoOp = O.TipoOp AND C.Codigo = O.Cliente1 ")
    *SQL.ADD("AND O.NrOperacion = M.NrOperacion AND M.Especie = O.ContraEspecie ")
    *SQL.ADD("AND FechaCargaSys < "~IdxDate2(Dialogo.Fecha1)~" AND FechaVto < "~IdxDate2(Dialogo.Fecha1)~" AND ContraEspecie <> '"~Val(ML:1)~"' ")
    *SQL.ADD("AND Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    *SQL.ADD("AND O.TipoOp in ('TIC','TIV','TCOPRI','TCPCEM') ")
    *SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    watch(SQL.BATCH)
    ACN(XX:2,0)
    ACN(XX:1,0)
    Recorrer SQL
        IF fbn('Tipo') = 1
          *varios dias
          ACD(FE:2, Habiles(fbn('FechaOp'),1,'ARG'))
          ***---ACD(FE:2, fbn('FechaOp'))
          IF fbn('FechaMov') > Dialogo.Fecha1
            ACD(FE:3, Dialogo.Fecha1)
          ELSE
            ACD(FE:3, fbn('FechaMov'))
          ENDIF
          Recorrer&i Val(FE:2), Val(FE:3)
              IF &i > Val(FE:1)
                if EsHabil(&i,Var('FERIDEF'))
                 *ACN(XZ:1,Sql("Select Precio1 from "~DBO~".COTIZACIONES WHERE Fecha = "~IdxDate2(&i)~" AND Codigo = '"~fbn('ContraEspecie')~"' AND Moneda = '"~Val(ML:1)~"' AND CALLPUT = 'CON'"))
                 *ACN(XZ:2,Sql("Select Precio1 from "~DBO~".COTIZACIONES WHERE Fecha = "~IdxDate2(HABILES(&i,-1,'ARG'))~" AND Codigo = '"~fbn('ContraEspecie')~"' AND Moneda = '"~Val(ML:1)~"' AND CALLPUT = 'CON'"))
                  acd(xy:1,&i)             
                  acd(xy:2,HABILES(&i,-1,'ARG'))             
                  ACN(XZ:1,CotizacionC(fbn('ContraEspecie'),'CON',,,val(xy:1),25,,Val(ML:1)))
                  ACN(XZ:2,CotizacionC(fbn('ContraEspecie'),'CON',,,val(xy:2),25,,Val(ML:1)))
                  ACN(RE:1,fbn('Cantidad')*(val(XZ:1)-val(XZ:2)))
                  ACD(FV:1, &i)
                  ACD(FD:1, Dialogo.Fecha1)
                  ACT(VH:1, fbn('Vehiculo1'))
                  ACT(TO:1, fbn('CodAsi'))
                  ACT(TI:1, fbn('TipoOp'))
                  ACT(NR:1, fbn('NrOperacion'))
                  ACT(NR:2, '')             
                  ***---(.'GENASIENTO'.)
                  ACN(CK:1, 0)
                  IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
                      ACN(CK:1, 1)
                      IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                          ACN(CK:1, 0)
                      ENDIF
                  ENDIF
                  let &codAsi fbn('CodAsi')
                  IF Val(CK:1) = 0
                      Message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
                      SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
                      SQL.EXEC
                  ENDIF
                endif
              ENDIF
          Proximo
        ELSE
          *Un solo dia
         *ACN(XZ:1,Sql("Select Precio1 from "~DBO~".COTIZACIONES WHERE Fecha = "~IdxDate2(Dialogo.Fecha1)~" AND Codigo = '"~fbn('ContraEspecie')~"' AND Moneda = '"~Val(ML:1)~"' AND CALLPUT = 'CON'"))
         *ACN(XZ:2,Sql("Select Precio1 from "~DBO~".COTIZACIONES WHERE Fecha = "~IdxDate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" AND Codigo = '"~fbn('ContraEspecie')~"' AND Moneda = '"~Val(ML:1)~"' AND CALLPUT = 'CON'"))
          acd(xy:1,Dialogo.Fecha1)             
          acd(xy:2,HABILES(Dialogo.Fecha1,-1,'ARG'))             
          ACN(XZ:1,CotizacionC(fbn('ContraEspecie'),'CON',,,val(xy:1),25,,Val(ML:1)))
          ACN(XZ:2,CotizacionC(fbn('ContraEspecie'),'CON',,,val(xy:2),25,,Val(ML:1)))
          ACN(RE:1,fbn('Cantidad')*(val(XZ:1)-val(XZ:2)))
          ACD(FV:1, Dialogo.Fecha1)
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACT(NR:1, fbn('NrOperacion'))
          ACT(NR:2, '')
          ***---(.'GENASIENTO'.)
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
               ENDIF
          ENDIF
          let &codAsi fbn('CodAsi')
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        ENDIF
    Proximo
ENDIF
