(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

let &de_date 'DATE: '
let &fecha ''

SetFilaActual(fac+5)

SQL.ADD(" Select O.TipoOp,O.FormaLiquidacion1,O.ContraEspecie,O.Cantidad,O.Precio1,O.TotalBrutoCli1,O.TotalIntereses,O.FechaOp,O.FechaVto,O.Cliente1,E.Extendido,E.ISIN ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" LEFT JOIN "~DBO~".ESPECIES E ")
SQL.ADD(" on O.Especie=E.Codigo ")
SQL.ADD(" where O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
