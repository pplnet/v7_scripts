SQL.ADD("select Fecha, Especie, TipCupon, Sum(Valorresidual) Residual, Sum(ValorContable) Contable, Sum(ValorContValuado) ContValuado, FecIncorporacion, RubroContable, ")
SQL.ADD("CodAlfCajaValores, Codmaecontado, CodNumCajaValores, Fvto, Denomincajavalores, clasecajavalores, nombre, cotiza, CodSISCEN , Tipo, Accion, ISIN from ")
SQL.ADD("(select DT.Fecha, DT.Especie, DT.TipCupon TipCupon, DT.Valorresidual Valorresidual, DT.CuentaContable CuentaContable, DT.ValorContable ValorContable, ")
SQL.ADD("DT.ValorContValuado ValorContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, ")
SQL.ADD("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo, ")
SQL.ADD("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' Then 'SI' else 'NO' end Accion, ISIN ")
SQL.ADD(" From "~DBO~".DETITOFIN DT  ")
SQL.ADD("      inner join dbo.CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
SQL.ADD("      inner join "~DBO~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
SQL.ADD("  and CO.Titofin='SI' ")
SQL.ADD("  and ValorContable <> 0  ")
SQL.ADD("  and DT.Fecha = "~IdxDate2(Dialogo.Fecha1)~" ) as Aux ")
SQL.ADD("Group By fecha, especie, tipcupon, fecincorporacion, rubrocontable, CodAlfCajaValores, CodMAEContado, ")
SQL.ADD("         CodNumCajaValores, FVto, DenominCajaValores, ClaseCajaValores, Nombre, Cotiza,CodSISCEN, Tipo, Accion, ISIN ")

watch(SQL.Batch)
ACN(ct:1,80000)

Recorrer SQL
*--agrego la linea 3901----------
    *-campo 1 Código de diseño 
    ACT(a:fac, '3901') 
    *-campo 2 Código de entidad
    ACT(b:fac, Val(cb:1)) 
    *-campos 3,4,5 Fecha de información, Sin uso, Nivel de Consolidación 
    ACT(c:fac, Val(fe:1)~Pad0('0',8)~'3') 
    *-campo 6 Cod.Siscen
    ACT(bd:1,FBN['CodSISCEN'])
    *ACT(d:fac, iif(Eqstr(Val(bd:1),'0000'),'9999',Pad0(Copy(Fstr(Val(bd:1),0),1,4),4)) )     
    ACT(d:fac, iif(Vacio(Trim(Val(bd:1))),'9999',Pad0(Copy(Fstr(Val(bd:1),0),1,4),4)) ) 
    *-campo 7 Cod.CV
    ACT(be:1,FBN['CodNumCajaValores'])
    If Vacio(Trim(Val(be:1)))
      SCN(ct:1,1)
      ACT(e:fac, Pad0(Copy(Fstr(Val(ct:1),0),1,5),5) ) 
    Else
      ACT(e:fac, Pad0(Copy(Fstr(Val(be:1),0),1,5),5)) 
    Endif   
    *-campo 8 TipoCupon
    ACT(f:fac, IIF(Vacio(FBN['TipCupon']),'0',FBN['TipCupon']) ) 
    *-campo 9, 10, 11 Cuenta balance - Valor Contable -  Valor Residual
    ACT(g:fac, Pad0(FBN['RubroContable'],6) ) 
    *ACT(h:fac, iif(EqStr(Copy(Fstr(FBN['Residual'],0),1,1),'-'),'-'~Pad0(Copy(Fstr(FBN['Residual'],0),2,Longitud(FBN['Residual'])-1),10),Pad0(Fstr(FBN['Residual'],0),11)))
    ACN(xy1,FBN['Contable']/1000)
    ACT(h:fac, iif(EqStr(Copy(Fstr(Val(xy1),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(xy1),0),2,Longitud(Val(xy1))-1),10),Pad0(Fstr(Val(xy1),0),11)))
    *ACT(i:fac, iif(EqStr(Copy(Fstr(FBN['ContValuado'],0),1,1),'-'),'-'~Pad0(Copy(Fstr(FBN['ContValuado'],0),2,Longitud(FBN['ContValuado'])-1),10),Pad0(Fstr(FBN['ContValuado'],0),11))) 
    ACN(xy2,FBN['ContValuado']/1000)
    ACT(i:fac, iif(EqStr(Copy(Fstr(Val(xy2),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(xy2),0),2,Longitud(Val(xy2))-1),10),Pad0(Fstr(Val(xy2),0),11))) 
    *-campo 12 Fecha Tenencia
    **ACT(w:fac,SQL("select max(P.fecha) from "~DBO~".POSICIONES P where P.fecha <= "~IdxDate2(Dialogo.Fecha1)~" and P.fecha > (select min(PO.fecha) from "~DBO~".POSICIONES PO where PO.Especie='"~FBN['Especie']~"' and PO.NrSaldo=122 and PO.CantidadFin=PO.CantidadIni ) AND P.Especie= '"~FBN['Especie']~"' and P.NrSaldo=122 and P.CantidadFin=P.CantidadIni "))
    ACT(w:fac,SQL("select min(P.fecha) from "~DBO~".POSICIONES P where P.fecha <= "~IdxDate2(Dialogo.Fecha1)~"  AND P.Especie= '"~FBN['Especie']~"' and P.NrSaldo=122 and P.CantidadFin=P.CantidadIni "))
    ACT(bq:1,Copy(Val(w:fac),7,4)~Copy(Val(w:fac),4,2)~Copy(Val(w:fac),1,2))
    ACT(j:fac, iif(Vacio(Val(bq:1)),'00000000',Val(bq:1)))
    *-campos 13 Fideicomiso financiero de obra pública
    If Eqstr(FBN['Tipo'],'FCM')
       ACT(k:fac, '1')
    Else
       ACT(k:fac, '0')
    Endif
    *-campos 14,15,16 (33 ceros) SIN USO
    ACT(l:fac, Pad0('0',33) )
    
    *-Campo 17 Fecha de vencimiento
    if Eqstr(FBN['Accion'],'SI')
       ACT(m:fac, Fecha(Dialogo.fecha3,'YYYYMMDD') )
    else
       ACT(m:fac, Fecha(FBN['FVto'],'YYYYMMDD') )
    endif
    *-Campo 18  Riesgo de Mercado
    ** Es solo para Acciones
    if Eqstr(Val(d:fac),'9999')
       if Eqstr(FBN['Accion'],'SI')
          ACT(bh:1,'2')
       else
          ACT(bh:1,'0') 
       endif      
    else
       ACT(bh:1,'1')
    endif   
    ACT(n:fac, Val(bh:1) ) 
    *-Campo 19  Mercado
    ** Es solo para Acciones y va el codigo Swift??
    if Eqstr(Val(d:fac),'9999') y Eqstr(FBN['Accion'],'SI')
       ACT(bi:1,copy(FBN['ISIN'],1,2))
    else  
       ACT(bi:1,'  ') 
    endif
    ACT(o:fac, Val(bi:1) )  
    *-campo 20 Posit.Trading
    ACT(bi:1,'2  ')
    ACT(p:fac, Val(bi:1))
    *-campo 21 Sin Uso
    ACT(q:fac, '  ') 
    *-campo 22 Sin Uso
    ACT(r:fac, '0') 
    *-campo 23 Cupon
    ACT(by:1,'00000')
    ACT(s:fac, Val(by:1)) 
    *-campo 24 Descripcion
    **Codigo Siscen - Codigo CNV - Especie para Riesgo
    If [Eqstr(Val(bd:1),'0000') o Vacio(Trim(Val(be:1))) ] y Incluido(Val(bh:1),'1|2|') 
       ACT(bz:1, fbn['Especie'] ~' '~ fbn['DenominCajaValores'] ~' '~ fbn['Cotiza']  )
       ACT(bz:1, Pad(Val(bz:1),32) )
    Else
       ACT(bz:1, Pad(' ',32) )
    Endif
    ACT(t:fac, Val(bz:1)) 
    *-campo 25 rectif
    ACT(u:fac, Val(rt:1)) 

    ACT(v:fac, FBN['Especie']) 
    ACT(ab:fac, iif(Eqstr(Val(tb:2),'NO'),'NO SE INFORMA','') ) 
    
    AlinearCeldas(j:fac..l:fac,'C') 
    SetFont(a:fac..aa:fac, 2)

    *---- grabar linea TXT---------------------
       ACT(re:1, '')
       Recorrer&i 1,21
            ACT(re:1, Val(re:1)~Val(&i:fac)) 
       Proximo
       If Not Eqstr(Val(tb:2),'NO')
              EscribirASCII(Val(re:1))
       Endif
Proximo

If Not Eqstr(Val(tb:2),'NO')
   CerrarASCII    
Endif

