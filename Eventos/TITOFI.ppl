HojaVisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1 : 'Fecha'        ;1;1;;  ;;Dialogo.Fecha1<=Fsys;'La Fecha DEBE ser menor o igual a la fecha del sistema';NO;FSys-Dia(FSys)
  Fecha2 : 'UltHabil'     ;1;2;;NO;;;;;;FindeMes(Dialogo.Fecha1,NO,Var('FERIDEF'))
  Fecha3 : 'FechaAccion'  ;2;2;;NO;;;;;;FindeMes(Dialogo.Fecha2+4,NO,Var('FERIDEF'))
  Radio2 : 'Rectifica? |NO|SI';2;1;;;;;;;0
  Radio1 : 'Genera_txt?|SI|NO' ;3;1;;;;;;;0;IIF(MODI,Dialogo.Radio1,0)
  String : 'Arch.Output'   ; ; ;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 o NoVacio(Dialogo.String) ;'Debe especificar un Archivo Output Titofin' ;NO;;VAR('PATHTITOFI')~'TITOFIN-'   ~Fecha(Dialogo.Fecha1,'yyyymm')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
  ** Check1 siempre en Cero. se utiliza en funcion TITOFITXT para IVSA 
  Check1 : 'IVSA'         ; ;1;;NO;NO;;;;0
FinDialogo


If Not OK
   Cancelar
Endif


*-Fecha ------- 
ACT(fe:1,Fecha(Dialogo.Fecha1,'yyyymmdd'))
ACD(fe:2,Dialogo.Fecha1)

*Se informa
ACT(tb:2,iif(Dialogo.Radio1=0,'SI','NO'))

*-Rectifica ------- 
ACT(rt:1,iif(Dialogo.Radio2=0,'N','R'))

*-Cod.BCRA---
ACT(cb:1,Pad0(BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Var('VEHICULODE')),5) )


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")
CrearFont(4,"Arial,9,B")
CrearFont(5,"Arial,11,B")

* Borro Archivos Anteriores
IF Dialogo.Radio1=0 y ExisteArchivo(Dialogo.String) 
   WinExec('CMD.EXE /C DEL '~Dialogo.String, 0)
   Esperar(5)
EndIf

* Creo el archivo 
IF Dialogo.Radio1=0 
   ACT(aa1, Dialogo.String)
   Message('Creando Archivo '~Dialogo.String)
   AbrirASCII(val(aa1),0)
EndIf

AgregarBMP(a1,EXE('LOGO'),80)

SetFilaActual(3)
ACT(i:fac,'Interfaz Comunicado "A" 658 - Titulos al '~Dialogo.Fecha1)
SetFont(i:fac, 3)

If NoVacio(Dialogo.String)
   ACT(r:fac,Dialogo.String)
   SetFont(r:fac, 2)
Endif

*---Encabezado ---------------------------------------
SetFilaActual(fac+2)
ACT(a:fac  , 'Const')
ACT(b:fac  , 'Entid')
ACT(c:fac  , 'F.Inf+FPos')
ACT(c:fac+1, '+NivConsol')
ACT(d:fac  , 'Sisc')
ACT(e:fac  , 'CodCV')
ACT(e:fac+1, '/CRYL')
ACT(f:fac  , 'Tipo')
ACT(f:fac+1, 'Cupon')
ACT(g:fac  , 'Cuenta')
ACT(g:fac+1, 'Balance')
ACT(h:fac  , 'Valor')
ACT(h:fac+1, 'Residual')
ACT(i:fac  , 'Valor')
ACT(i:fac+1, 'Contable')
ACT(j:fac  , 'Ultima')
ACT(j:fac+1, 'Compra')
ACT(k:fac  , 'Fid')
ACT(l:fac  , 'Varios')
ACT(m:fac  , 'Fec.Vto')
ACT(n:fac  , 'Riesgo')
ACT(n:fac+1, 'Mercado')
ACT(o:fac  , 'Mercado')
ACT(p:fac  , 'Posic')
ACT(p:fac+1, 'Trading')
ACT(q:fac  , '')
ACT(r:fac  , '')
ACT(s:fac  , 'Cupon')
ACT(t:fac  , 'Descripcion')
ACT(u:fac  , 'Rectif')
ACT(v:fac  , 'Especie')
ACT(v:fac+1, 'FPA')

AlinearCeldas(a:fac..z:fac+1, 'C')
SetFont(a:fac..aa:fac+1, 2)
AgregarMarco(a:fac..v:fac+1,1,2,EXE('COLOR6'))
SetFilaActual(fac+1)


SQL.ADD("select TipoReg, Fecha, Especie, TipCupon, Sum(Valorresidual) Residual, Sum(ValorContable) Contable, Sum(ValorContValuado) ContValuado, FecIncorporacion, RubroContable, ")
SQL.ADD("CodAlfCajaValores,  FTenencia, Codmaecontado, CodNumCajaValores,  FVto, Denomincajavalores, clasecajavalores, nombre, cotiza, CodSISCEN , Tipo, Accion, ISIN,InformaFecInc, Campo24 from ")
SQL.ADD("(select '1' TipoReg,DT.Fecha, DT.Especie, DT.TipCupon TipCupon, DT.Valorresidual Valorresidual, DT.CuentaContable CuentaContable, DT.ValorContable ValorContable, ")
SQL.ADD("DT.ValorContValuado ValorContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, FechaInicioTenencia FTenencia, ")
SQL.ADD("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo, ")
SQL.ADD("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%' Then 'SI' else 'NO' end Accion, ISIN, DT.InformaFecInc, '' Campo24 ")
SQL.ADD(" From "~DBO~".DETITOFIN DT  ")
SQL.ADD("      inner join dbo.CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
SQL.ADD("      inner join "~DBO~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
SQL.ADD("  and CO.Titofin='SI' ")
SQL.ADD("  and (ValorContable <> 0 or ValorContValuado <> 0)  ")
SQL.ADD("  and DT.Fecha = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("  ) as Aux ")
**SQL.ADD("  and DT.Especie = 'DICA') as Aux ")
SQL.ADD("Group By TipoReg,fecha, especie, tipcupon, fecincorporacion, rubrocontable, CodAlfCajaValores, CodMAEContado, ")
SQL.ADD("         CodNumCajaValores, FVto, DenominCajaValores, ClaseCajaValores, FTenencia, Nombre, Cotiza,CodSISCEN, Tipo, Accion, ISIN, InformaFecInc, Campo24 ")
**Eliana - Si hay registros que sumados dan 0 pero que en titofin se informan (por ser de distinto book), en el txt no se deben informar.
*SQL.ADD("HAVING Sum(ValorContable)<>0 ")
** AA 15-12-2025 por intereses se cambia ValorContable por ValorContValuado
**SQL.ADD("HAVING Sum(ValorContable)>0 ")
SQL.ADD("HAVING Sum(ValorContValuado)>0 ")

watch(SQL.Batch)
ACN(ct:1,80000)

** AA 18-08-2025
** Proceso genera informe TITOFI - TITALL
ACN(de:1,fac+1)
(.'TITOFIPROC'.)
ACN(ha:1,fac)

** AA 23-10-2025 Generacion TXT 
(.'TITOFITXT'.)

If Not Eqstr(Val(tb:2),'NO')
   CerrarASCII    
Endif

ACO(3,15)
ACO(12,25)
ACO(14,12)
ACO(20,15)

LimitesVision(v:fac)

SetPrintFit(3,80)
Impresion(1,2)
Impresion(4,1)
