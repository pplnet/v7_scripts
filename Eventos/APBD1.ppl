CrearDialogo
  Fecha1:    'FechaBajada'    ;1;1;;;;;;;FSYS
  Cliente2:  'Entidad '       ;1;2;;;;NOVACIO(Dialogo.Cliente2);'Entidad Invalida ';NO;; ;;;;" Codigo IN (SELECT DISTINCT Entidad FROM "~DBO~".CODIGOSDATANET)  ";
  String:    'Archivo'        ;2;1;;;;;;;'DNCTAS';;;;;'XXXXXXXX'
  Fecha2:    'D.Fecha'        ;3;1;;;;;;;FSYS
  Fecha3:    'H.Fecha'        ;3;2;;;;;;;FSYS

  Cliente1:  'Banco '         ;5;1;;  ;;NOVACIO(Dialogo.Cliente1) y Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN') ;'Banco Invalido ';NO;; ;;;;" Sector = 'BAN'  ";
  String1 :  'Cod.Bco.'       ;5;2;;NO;;NOVACIO(Dialogo.String1);'Falta el Codigo Datanet del Banco (Alias2/Tabla CLIENTES)';NO;BuscarCampo('CLIENTES','Alias2','Codigo',Dialogo.Cliente1);BuscarCampo('CLIENTES','Alias2','Codigo',Dialogo.Cliente1)  ;;;'XXX'

  Especie1:  'Moneda '        ; 6;1;;  ;;NOVACIO(Dialogo.Especie1) y Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo',Dialogo.Especie1),'MON') ;'Moneda Invalidao ';NO;'ARP';'ARP';;;;" Tipo = 'MON'  ";
  String2 :  'Cod.Moneda'     ; 6;2;;NO;;NOVACIO(Dialogo.String2);'Falta el Codigo de Moneda (Alias3/Tabla ESPECIES)';NO;BuscarCampo('ESPECIES','Alias3','Codigo',Dialogo.Especie1);BuscarCampo('ESPECIES','Alias3','Codigo',Dialogo.Especie1)  ;;;'XXX'
  Vehiculo1: 'Vehiculo'       ; 7;1;;  ;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Cuenta1 :  'Cuenta'         ; 8; ;;  ;;NOVACIO(Dialogo.Cuenta1) y Eqstr(BuscarCampo('CUENTAS','Cliente','Codigo',Dialogo.Cuenta1),Dialogo.Vehiculo1) y Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',Dialogo.Cuenta1),Dialogo.Cliente1) ;'Cuenta Invalido ';NO;; ;;;;"  Estado='HAB' AND Comitente = '"~Dialogo.Cliente1~"' AND Cliente = '"~Dialogo.Vehiculo1~"'    ";  
  String3 :  'Numero'         ; 8;2;;NO;;NOVACIO(Dialogo.String3);'Falta el Nro de Cuenta';NO;BuscarCampo('CUENTAS','Numero','Codigo',Dialogo.Cuenta1);BuscarCampo('CUENTAS','Numero','Codigo',Dialogo.Cuenta1)  ;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
  Entero1:   'Cant.Registros' ; 9;2;;  ;;;;;10
  Fecha4:    'FechaSaldo'     ;10;1;;  ;;;;;Dialogo.Fecha1-1;
  Cantidad1: 'Saldo'          ;11;1;;NO;;;;;;IIF(NoVacio(Dialogo.Cuenta1),SaldoD(Dialogo.Vehiculo1,Dialogo.Especie1,,,,,,Dialogo.Cuenta1,1,Dialogo.Fecha4))
  Cantidad4: 'SaldoInicial'   ;11;2;;  ;;;;;;Dialogo.Cantidad1
FinDialogo

If Not Ok
   Cancelar
Endif

ACT(vr:1, SQL("SELECT Valor FROM "~DBO~".VARIABLES WHERE Codigo IN (SELECT Alias4 FROM "~DBO~".CLIENTES WHERE Codigo='"~Dialogo.Cliente2~"' )"))

If Not Incluido(Dialogo.String, Val(vr:1))
   Cancelar('Codigo de Archivo Invalido.'~CHR(13)~'No corresponde a la entidad. Verificar Alias4 del cliente '~Dialogo.Cliente2~'.')
Endif

Recorrer&i 1,Dialogo.Entero1
   IFA
   ACT(a:fac, Dialogo.Vehiculo1)
   ACT(b:fac, Dialogo.String1)
   ACT(q:fac, Dialogo.Cliente1)
   ACT(c:fac,' ')

   ACT(d:fac, Dialogo.String3)
   ACT(e:fac, Dialogo.String2)
 
   ACD(h:fac, habiles(Dialogo.Fecha1,-1,'ARG'))
   ACD(i:fac, habiles(Dialogo.Fecha1,-1,'ARG'))
Proximo


message('Recuperando Saldo Inicial Cta.: '~Dialogo.String3)
*ACN(sa:1,SaldoC(Dialogo.Vehiculo1,Dialogo.Especie1,,,,,,Dialogo.Cuenta1,1,Dialogo.Fecha1-1))
ACN(sa:1,Dialogo.Cantidad4)

*--Linea  -----
ACT(a:Dialogo.Entero1+1,'   TOTALES')
ACN(f:Dialogo.Entero1+1, Val(sa:1))

CrearListBox; 'Arial,8,';'Carga Manual de Extractos - Saldo inicial: '~PyC(Val(sa:1),0,4)
  'Vehiculo'      ;a:1..a:Dialogo.Entero1+1  ;NO;;;70;TABLA ; 'Vehiculos';'Codigo';'Codigo;Descripcion';" Status ='HAB' ";RGB(232,232,232) ;;SI;SI;'1;2;3;4;5;6;7';;SI;SI;SI
  'Banco Datanet' ;b:1..b:Dialogo.Entero1+1  ;NO;NOVACIO(Val(b:flb));'Falta el Alias2 en el Banco';70;TABLA ; 'Clientes';'Alias2';'Alias2;Codigo;RazonSocial';" Sector = 'BAN'  and Alias2 is not null ";RGB(232,232,232) ;;SI;SI;'1;2;3;4;5;6;7';;SI;SI;SI
  'BancoFPA'      ;q:1..q:fac  ;NO;;;70;STRING;;RGB(232,232,232);BuscarCampo('CLIENTES','Codigo','Alias2',Val(b:flb));NO;NO;
  'Suc'           ;c:1..c  :Dialogo.Entero1+1;SI;;;70;STRING;;RGB(232,232,232);
  'Cuenta'        ;d:1..d  :Dialogo.Entero1+1;NO;NOVACIO(Val(d:flb));'Falta el numero de Cuenta';70;TABLA ; 'Cuentas';'Numero';'Numero;Codigo;Nombre';" (Comitente='"~Val(Q:FLB)~"' and Cliente='"~Val(A:FLB)~"' and Estado='HAB') ";RGB(232,232,232);;SI;SI;'1;2;3;4';;SI;SI;SI
  'Moneda'        ;e:1..e  :Dialogo.Entero1+1;NO;NOVACIO(Val(e:flb));'Falta el alias3 de Especies';70;TABLA ; 'Especies';'Alias3';'Alias3;Nombre';" Tipo = 'MON'  and Alias3 is not null ";RGB(232,232,232)

  'Cantidad'      ;f:1..f  :Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232); IIF(FLB=Dialogo.Entero1+1,Val(sa:1)+ SUM(f:1..f:Dialogo.Entero1), Val(f:FLB) ) ;;;
  'Deb/Cre'       ;g:1..g  :Dialogo.Entero1+1;NO;;;40;COMBO;'D|C'    ;RGB(232,232,232);IIF(Val(f:FLB)<=0.00,0,1)

  'Cantidad'      ;aa:1..aa:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Deb/Cre'       ;ab:1..ab:Dialogo.Entero1+1;NO;;;40;COMBO;'D|C'   ;RGB(232,232,232);IIF(Val(aa:FLB)<=0.00,0,1)

  'Cantidad'      ;ac:1..ac:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Deb/Cre'       ;ad:1..ad:Dialogo.Entero1+1;NO;;;40;COMBO;'D|C'   ;RGB(232,232,232);IIF(Val(ac:FLB)<=0.00,0,1)

  'Cantidad'      ;ae:1..ae:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;af:1..af:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ag:1..ag:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ah:1..ah:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ai:1..ai:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;aj:1..aj:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ak:1..ak:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;al:1..al:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;am:1..am:Dialogo.Entero1+1;SI;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);

  'F.Ingreso'     ;h:1..h:Dialogo.Entero1+1;SI;;;80;FECHA;RGB(232,232,232);
  'F.Acredit'     ;i:1..i:Dialogo.Entero1+1;SI;;;80;FECHA;RGB(232,232,232);
  'TipoMov'       ;j:1..j:Dialogo.Entero1+1;SI;[NOVACIO(Val(j:flb)) y Eqstr(BUSCARCAMPO('CODIGOSDATANET','Entidad','Codigo',Val(j:flb)),Dialogo.Cliente2)] o flb=Dialogo.Entero1+1;'Tipo de Movimiento Invalido.';70;TABLA ; 'CodigosDatanet'  ;'Codigo';'Codigo;Descripcion;Tipo';" Entidad = '"~Dialogo.Cliente2~"' ";RGB(232,232,232);
  'Comprobante'   ;k:1..k:Dialogo.Entero1+1;SI;;;70;STRING;;RGB(232,232,232);
FinListBox

*  'TipoMov'       ;j:1..j:Dialogo.Entero1;SI;;;70;COMBO;'Cheque|Gastos|Cobranzas|Comisiones|Saldos|Disp.'  ;RGB(232,232,232)

If Not Ok
   Cancelar
Endif

ACN(mo:1,0)

Recorrer&i 1,Dialogo.Entero1
 If Val(f:&i)<>0 o Val(aa:&i)<>0 o Val(ac:&i)<>0 o Val(ae:&i)<>0 o Val(af:&i)<>0 o Val(ag:&i)<>0 o Val(ah:&i)<>0 o Val(ai:&i)<>0 o Val(aj:&i)<>0 o Val(ak:&i)<>0 o Val(al:&i)<>0 o Val(am:&i)<>0
   If Val(mo:1)=0
      ACT(z:1,GetNumerador(7))
   Endif
   If CeldaVacia(q:&i)
      * 05/07/2004
      * Es para garbar el codigo de banco FPA en vez del codigo DATANET y que esto evento sirva para cualquier clase de archivo
      ACT(q:&i, BuscarCampo('CUENTAS','Comitente','Numero',Val(d:&i)))
   Endif
   SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
   SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
   SQL.ADD(" Banco, Sucursal, ")
   SQL.ADD(" Cuenta, Moneda, Importe, ")
   SQL.ADD(" DC, FechaIngreso, FechaAcreditacion, ")
   SQL.ADD(" TipoMov, Comprobante, EstadoConciliacion, ")
   SQL.ADD(" Importe2, DC2, Importe3, DC3, ")
   SQL.ADD(" Importe4, Importe5, Importe6, Importe7, ")
   SQL.ADD(" Importe8, Importe9, Importe10, Importe11, Importe12 ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" '"~Val(z:1)~"', "~FSTR(&i,0,0)~", '"~Val(a:&i)~"', ")
*  05/07/2004 SQL.ADD(" '"~Val(b:&i)~"', '"~Val(c:&i)~"', ")
   SQL.ADD(" '"~Val(q:&i)~"', '"~Val(c:&i)~"', ")
   SQL.ADD(" '"~Val(d:&i)~"', '"~Val(e:&i)~"', "~FSTR(ABS(Val(f:&i)),0,2)~", ")
   SQL.ADD(" '"~iif(Val(g:&i)=1,'C','D')~"', "~IdxDate2(Val(h:&i))~", "~IdxDate2(Val(i:&i))~", ")
   SQL.ADD(" '"~Val(j:&i)~"', '"~Val(k:&i)~"', 'P', ")
   SQL.ADD(" "~FSTR(ABS(Val(aa:&i)),0,2)~", '"~iif(Val(ab:&i)=1,'C','D')~"', "~FSTR(ABS(Val(ac:&i)),0,2)~", '"~iif(Val(ad:&i)=1,'C','D')~"', ")
   SQL.ADD(" "~FSTR(Val(ae:&i),0,2)~",  "~FSTR(Val(af:&i),0,2)~",  "~FSTR(Val(ag:&i),0,2)~",  "~FSTR(Val(ah:&i),0,2)~", ")
   SQL.ADD(" "~FSTR(Val(ai:&i),0,2)~",  "~FSTR(Val(aj:&i),0,2)~",  "~FSTR(Val(ak:&i),0,2)~",  "~FSTR(Val(al:&i),0,2)~", "~FSTR(Val(am:&i),0,2)~" )")
   SQL.NEW
   ACN(mo:1,1)
 Endif
Proximo 

If Val(mo:1)<>0
  SQL.ADD(" INSERT INTO "~DBO~".DATANET ( ")
  SQL.ADD(" NrDatanet, FechaBajada, Archivo, ")
  SQL.ADD(" FechaDesde, FechaHasta, Usuario, Estado, EstadoAprobacion  ")
  SQL.ADD(" ) VALUES ( ")
  SQL.ADD(" '"~Val(z:1)~"' , "~IdxDate2(Dialogo.Fecha1)~", '"~MAYUSCULAS2(Dialogo.String)~"', ")
  SQL.ADD(IdxDate2(Dialogo.Fecha2)~", "~IdxDate2(Dialogo.Fecha3)~", '"~USUARIOACTIVO~"', 'A', 'P' ) ")
  SQL.NEW
  SQL.EXEC
Else
  messagebox('No se ingreso el extracto, todos los movimientos estan en 0 (cero).')
Endif