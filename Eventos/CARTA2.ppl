*HojaVisible(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;;;;;
  Fecha1      : 'Fecha'     ;;;;;;;;;Fsys
  NrOperacion2: 'NrCarta'   ;;;;;NO;
  Check1      : 'del evento';;;;;NO;
  Radio1      : 'Tipo|Clasico|Intermed.' ;;;;;NO;;;;0;;;
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECARTA2')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif


*- Cuentas cuyos movimientos no salen en la liquidacion
ACT(cn1,Pipe2Comillas(VAR('CTANOCAR')) )

SQL.ADD("Select * from "~DBO~".OPERACIONES")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"'")

Recorrer SQL  

  DFA
  SetFilaActual(6)

  let &fecha_larga FStr(Dia(Dialogo.Fecha1),1,0)~' de '~Val(aa:Mes(Dialogo.Fecha1))~' de '~FStr(Anio(Dialogo.Fecha1),4,0)
  
  let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
  let &direccion Copy(BuscarCampo('CLIENTES','Direccion','Codigo',fbn['Cliente1']),1,30)~' '~Copy(BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente1']),1,18)~' ('~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn['Cliente1'])~')'
  
  let &ref 'REF: Nuestro Nro. Operacion '~fbn['NrOperacion']~' / '~Dialogo.NrOperacion2

  SetFont(a:FAC..e:FAC+11,1)
  SetFilaActual(fac+13)

  *ACT(a:FAC, 'De nuestra mayor consideracion:')
  *ACT(a:FAC+2, 'Por medio de la presente confirmamos haber realizado con Uds. la operacion de referencia, con los datos ')
  *ACT(a:FAC+3, 'indicados a continuacion.')
  SetFont(a:FAC..e:FAC+3,1)

  SetFilaActual(fac+5)
  ACN(y3,FAC)
  ACT(a:FAC, 'Tipo de Operacion:')
  let &nombre_tipoop BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn['TipoOp'])
  IFA
  ACN(z1, SQL("Select Fecha2 from "~DBO~".TRANSACCIONES2 where NrOperacionRef1 = '"~Dialogo.NrOperacion1~"' and NrOperacionRef2 = '"~Dialogo.NrOperacion2~"' "))
  ACT(a:FAC, 'Momento de Liq.:')
  if Val(z1)=fbn['FechaOp']
    ACT(b:FAC, 'Origen')
  else
    ACT(b:FAC, 'Vencimiento')
  endif
  let &momento val(b:fac)

  let &nombre_especie BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie'])

  let &monto PYC(fbn['Cantidad'],1,2)

  let &fecha_op2 fbn['FechaOp2']

  let &fecha_vto fbn['FechaVto']

  let &plazo FStr(fbn['Plazo'],1,0)

  let &tipo_tasa fbn['TipoTasa']

  let &tasa FStr(fbn['Precio1'],1,7)
  SetFont(a:Val(y3)..a:FAC,2)
  SetFont(b:Val(y3)..b:FAC,1)
    
  SetFilaActual(FAC+2)
  ACT(a:FAC+1, 'A tal efecto, informamos los movimientos que se realizaran por la liquidacion de la misma:')
  SetFont(a:FAC..a:FAC+1,1)

  SetFilaActual(FAC+2)
  **************************************ESTO****************************************************************
  SQL.ADD("Select DISTINCT T.* from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVEJECUTADOS M  ")
  SQL.ADD("where T.NrTrans = B.NrOperacion AND T.NrTrans=M.NrTrans2 ")
  SQL.ADD("and T.NrOperacionRef1 = '"~Dialogo.NrOperacion1~"' ")
  *SQL.ADD("and T.NrOperacionRef2 = '"~Dialogo.NrOperacion2~"' ")
  SQL.ADD("and M.Cuenta Not In ("~val(cn1)~") ") 
  if Dialogo.Check1=1
  *SQL.ADD("and B.NrBit = 2 ")
  else
  *SQL.ADD("and B.NrBit in (2,3,4,5,10,20)")
  endif
  SQL.ADD("and B.Valor ='1' ")
  SQL.ADD("order by TipoTr2")

  ACT(ab1 ,'')  
  ACT(ab11,'')  
  
  let &concepto ''
  let &especie ''
  let &valor_nominal ''
  let &fecha_valor ''
  let &forma_liquidacion ''
  let &concepto2 ''
  let &especie2 ''
  let &valor_nominal2 ''
  let &fecha_valor2 ''
  let &forma_liquidacion2 ''

  recorrer SQL  

    *- Si la transaccion es de compensacion -> Imprimo las Observaciones
    If Vacio(val(ab1))
       ACT(ab1,FBN['Observaciones'])
    Else
       If Vacio(val(ab11))
          ACT(ab11,FBN['Observaciones'])
       EndIf
    EndIf

    ACT(ab2,'')

    if EqStr(FBN['TipoTr2'],'DEP')
      if Val(x1)=0
        IFA
        ACT(a:FAC, 'A nuestro favor:')
        SetFont(a:FAC,1)
        IFA
        ACT(a:FAC, 'Concepto')
        ACT(b:FAC, 'Especie')
        ACT(c:FAC, 'Valor Nominal')
        ACT(d:FAC, 'Fecha Valor')
        ACT(e:FAC, 'Forma de Liquidacion')
        AlinearCeldas(a:FAC..e:FAC,'C')
        AgregarMarco(a:FAC..e:FAC,2,2)
        SetFont(a:FAC..e:FAC,1)

        IFA
        ACN(x1,1)
      endif

      ACT(j:FAC, FBN['NrTrans'])
      ACT(k:FAC, FBN['Cuenta1'])
      ACT(l:FAC, FBN['Cuenta2'])

      *- Recupero Datos de la Cuenta
      SQL.ADD(" SELECT * FROM "~DBO~".CUENTAS WHERE Codigo='"~Val(l:FAC)~"' ")
      Recorrer SQL
         dfa 
         ACT(al1,FBN['Alias1'])
         ACT(al2,FBN['Alias2'])
         ACT(al4,FBN['Alias4'])
         ACT(nu1,FBN['Numero'])
         ACT(co1,FBN['Comitente'])
         ACT(cl1,FBN['Cliente'])
         ACT(ch1,FBN['ABA']~'/'~FBN['CHIPS'])
      Proximo

      if Eqstr(&especie, '')
        let &especie Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15)
        let &valor_nominal PYC(FBN['Cantidad1'],1,2)
        let &fecha_valor FBN['Fecha2']
      else
        let &especie &especie~Chr(13)~Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15)
        let &valor_nominal &valor_nominal~Chr(13)~PYC(FBN['Cantidad1'],1,2)
        let &fecha_valor &fecha_valor~Chr(13)~FBN['Fecha2']
      endif
      ACT(b:FAC, Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15))
      ACN(c:FAC, FBN['Cantidad1'])
      ACT(d:FAC, FBN['Fecha2'])
      SQL.ADD("Select NrOperacion, Leyenda, Cuenta, Transaccion from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrTrans2 = '"~Val(j:FAC)~"' ")
      SQL.ADD("Union ")
      SQL.ADD("Select NrOperacion, Leyenda, Cuenta, Transaccion from "~DBO~".MOVPENDIENTES ")
      SQL.ADD("where NrTrans2 = '"~Val(j:FAC)~"' ")

      Recorrer SQL  
        DFA
        if EqStr(FBN['NrOperacion'],Val(j:FAC))
           ACT(m:FAC, FBN['Cuenta'])
           ACT(n:FAC, FBN['Transaccion'])
        else
           ACT(a:FAC, FBN['Leyenda'])
           SetFont(a:FAC,5)
           if Eqstr(&concepto, '')
            let &concepto FBN['Leyenda']
          else
            let &concepto &concepto~Chr(13)~FBN['Leyenda']
          endif
        endif
      Proximo

      ACN(y1, FAC)

      If Incluido(Val(n:FAC),'COMP')
         ACT(ab2,'COMP')
         ACT(e:FAC, val(al1))
         IFA
         ACT(e:FAC, val(al2))
         if Eqstr(&forma_liquidacion, '')
            let &forma_liquidacion val(al1)~Chr(13)~val(al2)
         else
            let &forma_liquidacion &forma_liquidacion~Chr(13)~val(al1)~Chr(13)~val(al2)
         endif
      Endif

      If EqStr(Val(n:FAC),'CREDIT')
         ACT(e:FAC, 'Credito en Cuenta Nr. '~val(nu1))
         if Eqstr(&forma_liquidacion, '')
            let &forma_liquidacion 'Credito en Cuenta Nr. '~Val(nu1)
         else
            let &forma_liquidacion &forma_liquidacion~Chr(13)~'Credito en Cuenta Nr. '~Val(nu1)
         endif
         If Dialogo.Radio1=1
            ACT(e:FAC+1,'Banco:'~val(co1))
            ACT(e:FAC+2,'Sucursal:'~val(al1))
            ACT(e:FAC+3,'Beneficiario:'~val(cl1))
            ACT(e:FAC+4,'Swift (ABA,CHIPS):'~val(ch1))
            SetFilaActual(fac+4)
            let &forma_liquidacion &forma_liquidacion~Chr(13)~'Banco:'~val(co1)~Chr(13)~'Sucursal:'~val(al1)~Chr(13)~'Beneficiario:'~val(cl1)~Chr(13)~'Swift (ABA,CHIPS):'~val(ch1)
         EndIf
      Endif

      If EqStr(Val(n:FAC),'TRANSF')
         ACT(e:FAC, 'Transferencia a Cuenta Nr. '~BuscarCampo('CUENTAS','Numero','Codigo',Val(l:FAC)))
         IFA
         ACT(e:FAC, 'del '~BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Comitente','Codigo',Val(l:Val(y1))))~'.')
         IFA
         ACT(e:FAC, BuscarCampo('CUENTAS','Alias4','Codigo',Val(l:FAC-2)))
         let &forma_liquidacion 'Transferencia a Cuenta Nr. '~Val(nu1)~Chr(13)~'del '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(co1))~'.'~Chr(13)~val(al4)
      Endif

      If EqStr(Val(n:FAC),'CHEQUE')
         ACT(e:FAC, 'Emision de Cheque a nuestro favor.')
         let &forma_liquidacion 'Emision de Cheque a nuestro favor.'
      Endif

      AlinearCeldas(b:Val(y1)..b:FAC,'C')
      AlinearCeldas(d:Val(y1)..d:FAC,'C')
      AgregarMarco(a:Val(y1)..e:FAC,1,2)
      SetFont(b:Val(y1)..e:FAC,1)

*** +++ era a:
      SetFont(j:Val(y1)..p:FAC,3)
    endif
    if EqStr(FBN['TipoTr2'],'RET')
      if Val(x2)=0
        IFA
        ACT(a:FAC, 'A su favor:')
        SetFont(a:FAC,1)
        IFA
        ACT(a:FAC, 'Concepto')
        ACT(b:FAC, 'Especie')
        ACT(c:FAC, 'Valor Nominal')
        ACT(d:FAC, 'Fecha Valor')
        ACT(e:FAC, 'Forma de Liquidacion')
        AlinearCeldas(a:FAC..e:FAC,'C')
        AgregarMarco(a:FAC..e:FAC,2,2)
        SetFont(a:FAC..e:FAC,1)
        IFA
        ACN(x2,1)
      endif
      ACT(j:FAC, FBN['NrTrans'])
      ACT(k:FAC, FBN['Cuenta1'])
      ACT(l:FAC, FBN['Cuenta2'])

      *- Recupero Datos de la Cuenta
      SQL.ADD(" SELECT * FROM "~DBO~".CUENTAS WHERE Codigo='"~Val(l:FAC)~"' ")
      Recorrer SQL
         dfa 
         ACT(al1,FBN['Alias1'])
         ACT(al2,FBN['Alias2'])
         ACT(al4,FBN['Alias4'])
         ACT(nu1,FBN['Numero'])
         ACT(co1,FBN['Comitente'])
         ACT(cl1,FBN['Cliente'])
         ACT(ch1,FBN['ABA']~'/'~FBN['CHIPS'])
      Proximo

      ACT(b:FAC, Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15))
      ACN(c:FAC, FBN['Cantidad1'])
      ACT(d:FAC, FBN['Fecha2'])
      if Eqstr(&especie2, '')
        let &especie2 Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15)
        let &valor_nominal2 PYC(FBN['Cantidad1'],1,2)
        let &fecha_valor2 FBN['Fecha2']
      else
        let &especie2 &especie2~Chr(13)~Copy(BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']),1,15)
        let &valor_nominal2 &valor_nominal2~Chr(13)~PYC(FBN['Cantidad1'],1,2)
        let &fecha_valor2 &fecha_valor2~Chr(13)~FBN['Fecha2']
      endif
      
      SQL.ADD("Select NrOperacion, Leyenda, Cuenta, Transaccion from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrTrans2 = '"~Val(j:FAC)~"'  AND Cuenta Not In ("~val(cn1)~")  ")
      SQL.ADD("Union ")
      SQL.ADD("Select NrOperacion, Leyenda, Cuenta, Transaccion from "~DBO~".MOVPENDIENTES ")
      SQL.ADD("where NrTrans2 = '"~Val(j:FAC)~"'  AND Cuenta Not In ("~val(cn1)~")  ")

      recorrer SQL  
        DFA
        if EqStr(FBN['NrOperacion'],Val(j:FAC))
          ACT(m:FAC, FBN['Cuenta'])
          ACT(n:FAC, FBN['Transaccion'])
        else
          ACT(a:FAC, FBN['Leyenda'])
          SetFont(a:FAC,5)
          if Eqstr(&concepto2, '')
                let &concepto2 FBN['Leyenda']
           else
                let &concepto2 &concepto2~Chr(13)~FBN['Leyenda']
           endif
        endif
      proximo

      ACN(y2, FAC)

      if Incluido(Val(n:FAC),'COMP')
         ACT(ab2,'COMP')
         *- Tomo de Alias1 y Alias2 la Leyenda de la Compensacion
         ACT(e:FAC, val(al1))
         IFA
         ACT(e:FAC, val(al2))
         if Eqstr(&forma_liquidacion2, '')
            let &forma_liquidacion2 val(al1)~Chr(13)~val(al2)
         else
            let &forma_liquidacion2 &forma_liquidacion2~Chr(13)~val(al1)~Chr(13)~val(al2)
         endif
      endif

      *- Recupero Datos de la Cuenta
      SQL.ADD(" SELECT * FROM "~DBO~".CUENTAS WHERE Codigo='"~Val(m:FAC)~"' ")
      Recorrer SQL
         dfa 
         ACT(al1,FBN['Alias1'])
         ACT(al2,FBN['Alias2'])
         ACT(al4,FBN['Alias4'])
         ACT(nu1,FBN['Numero'])
         ACT(co1,FBN['Comitente'])
         ACT(cl1,FBN['Cliente'])
         ACT(ch1,FBN['ABA']~'/'~FBN['CHIPS'])
      Proximo


      If EqStr(Val(n:FAC),'DEBITO')
         ACT(e:FAC, 'Debito en Cuenta Nr. '~val(nu1))
         If Dialogo.Radio1=1
            ACT(e:FAC+1,'Banco:'~val(co1))
            ACT(e:FAC+2,'Sucursal:'~val(al1))
            ACT(e:FAC+3,'Beneficiario:'~val(cl1))
            ACT(e:FAC+4,'Swift (ABA,CHIPS):'~val(ch1))
            SetFilaActual(fac+4)
            let &forma_liquidacion2 &forma_liquidacion2~Chr(13)~'Banco:'~val(co1)~Chr(13)~'Sucursal:'~val(al1)~Chr(13)~'Beneficiario:'~val(cl1)~Chr(13)~'Swift (ABA,CHIPS):'~val(ch1)
         EndIf
      Endif

      if EqStr(Val(n:FAC),'TRANSF')
        ACT(e:FAC, 'Transferencia a Cuenta Nr. '~BuscarCampo('CUENTAS','Numero','Codigo',Val(k:FAC)))
        IFA
        ACT(e:FAC, 'del '~BuscarCampo('CUENTAS','Nombre','Codigo',Val(k:Val(y2)))~'.')
        IFA
        ACT(e:FAC, BuscarCampo('CUENTAS','Alias4','Codigo',Val(k:FAC-2)))
        let &forma_liquidacion2 'Transferencia a Cuenta Nr. '~BuscarCampo('CUENTAS','Numero','Codigo',Val(k:FAC))~Chr(13)~'del '~BuscarCampo('CUENTAS','Nombre','Codigo',Val(k:Val(y2)))~'.'~Chr(13)~BuscarCampo('CUENTAS','Alias4','Codigo',Val(k:FAC-2))
      endif
      if EqStr(Val(n:FAC),'EMI_CH')
        ACT(e:FAC, 'Emision de Cheque a su favor.')
        let &forma_liquidacion2 'Emision de Cheque a su favor.'
      endif
      AlinearCeldas(b:Val(y2)..b:FAC,'C')
      AlinearCeldas(d:Val(y2)..d:FAC,'C')
      AgregarMarco(a:Val(y2)..e:FAC,1,2)
      SetFont(b:Val(y2)..e:FAC,1)
      SetFont(j:Val(y2)..p:FAC,3)
    endif
  proximo
  **************************************************************************************************************************
  IFA

  If [NoVacio(val(ab1)) o NoVacio(val(ab11))] y EqStr(val(ab2),'COMP') 
     IFA
     ACT(a:FAC  , val(ab1))
     SetFont(a:fac..a:fac,4)
     IFA
     ACT(a:FAC, val(ab11))
     SetFont(a:fac..a:fac,4)
     IFA
  Else 
     SQL.ADD("Select * from "~DBO~".LEYENDAS ")
     SQL.ADD("where Vehiculo = '"~fbn['Vehiculo1']~"' ")
     SQL.ADD("and TipoOp = '"~fbn['TipoOp']~"' ")
     SQL.ADD("order by Cliente DESC")
     recorrer SQL  
       ABT(a:FAC..e:FAC+3, LeerLeyenda(fbn['Cliente'],fbn['TipoOp'],fbn['Vehiculo']),1)
       SetFilaActual(FAC+4)
     proximo
  EndIf

  IFA
  ACT(a:FAC, 'Sin otro particular saludamos muy atentamente.')
  SetFont(a:FAC,1)
proximo

EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, fecha_larga = &fecha_larga, razon_social = &razon_social, direccion = &direccion, ref = &ref, nombre_tipoop = &nombre_tipoop, momento = &momento, nombre_especie = &nombre_especie, monto = &monto, fecha_op2 = &fecha_op2, fecha_vto = &fecha_vto, plazo = &plazo, tipo_tasa = &tipo_tasa, tasa = &tasa, concepto = &concepto, especie = &especie, valor_nominal = &valor_nominal, fecha_valor = &fecha_valor, forma_liquidacion = &forma_liquidacion, concepto2 = &concepto2, especie2 = &especie2, valor_nominal2 = &valor_nominal2, fecha_valor2 = &fecha_valor2, forma_liquidacion2 = &forma_liquidacion2)

