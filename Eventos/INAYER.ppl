Cancelar
*********************************************
**** Operaciones de Ayer sin NroAltaMAE *****
*********************************************
SQL.ADD(" Select NrOperacion,TipoOp,Clietne1 from "~DBO~".OPERACIONES ")
*SQL.ADD("  Where FechaOp =  '"~IdxDate(Habiles(FSys,-1,'ARG'))~"' ")
SQL.ADD("  Where FechaOp <  '"~IdxDate(FSys)~"' ")
SQL.ADD("    and TipoOp  in ('TIV','TIFV','TIC','TIFC') ")
SQL.ADD("    and IsNull(NroAltaMAE,'') = '' ")
Recorrer SQL
  ACT(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),3))
  if Vacio(Val(b:FAC)) o EqStr(Val(b:FAC),'000')
    * Operacion con terceros
    ACN(x1, 0)
  else
    * Operacion con Agente
    ACN(x1, 1)
  endif
*  if Incluido(FBN['TipoOp'],'TIV|TIFV') o [Incluido(FBN['TipoOp'],'TIC|TIFC') y BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1'])=0]
*  endif
  if Incluido(FBN['TipoOp'],'TIV|TIFV') o [Incluido(FBN['TipoOp'],'TIC|TIFC') y Val(x1)=0]
    * Ventas o Compras con terceros
    ACT(b:FAC, FBN['NrOperacion'])
    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   SET Valor = '1' ")
    SQL.ADD(" Where Valor = '1' ")
    SQL.ADD("   and NrOperacion= '"~FBN['NrOperacion']~"' ")
    SQL.NEW
    SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = '0' ")
    SQL.ADD(" Where NrBit       = 51 ")
    SQL.ADD("   and NrOperacion = '"~FBN['NrOperacion']~"' ")
    SQL.NEW
    SQL.EXEC
  endif
proximo

***************************************
** ASI ESTABA ANTES (11/05/05) idem ING
***************************************
IF NO
*HojaVisible(SI)
*********************************************
**** Operaciones de Ayer sin NroAltaMAE *****
*********************************************
SQL.ADD(" Select * from "~DBO~".OPERACIONES Where FechaOp = '"~IdxDate(Habiles(FSys,-1,'ARG'))~"' ")
SQL.ADD(" and (NroAltaMAE = ' ' or NroAltaMAE is NULL)")
Recorrer SQL
  ACT(a:FAC, FBN['NrOperacion'])
  if Incluido(FBN['TipoOp'],'TIV|TIFV') o [Incluido(FBN['TipoOp'],'TIC|TIFC') y BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1'])=0]
    ACT(b:FAC, FBN['NrOperacion'])
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
    SQL.ADD(" Where Valor = '1' and NrOperacion= '"~FBN['NrOperacion']~"' ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
    SQL.ADD(" Where (NrBit = 50 ) and (NrOperacion = '"~FBN['NrOperacion']~"') ")
    SQL.NEW
    SQL.EXEC
  endif
proximo
ENDIF

