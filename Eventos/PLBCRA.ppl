    Precio3  : '% RPC Vinculados';14;2;;;;;;;Num(VAR('RPCVIN'));;;;'######.##'
    Precio4  : '% RPC Clientes';15;2;;;;;;;Num(VAR('RPCCLI'));;;;'######.##'
FinDialogo

if not ok
    cancelar
Endif

