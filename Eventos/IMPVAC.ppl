CrearDialogo
  Fecha1:       'F.Trans'   ;;;;;;;;;Fsys
  Check3:       'Impresora' ;
FinDialogo

if not Ok
  Cancelar
endif
SQL.ADD(" Select T.NrTrans,T.Fecha2,T.Cliente1,T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, ")
SQL.ADD("        T.Mercado1 ,T.CB1, T.CB5                                              ")
SQL.ADD("   from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O ")
SQL.ADD(" where  T.NrTrans = O.NrOperacion ")
SQL.ADD(" and    O.NrBit In (3,6,51,70) and O.Valor ='1'      ")
SQL.ADD(" and    T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and    T.TipoTr2 In ('PDIVID','CANJE','STOCK') ")
SQL.ADD(" and    T.Cambio5 = 101 ")
SQL.ADD(" order by T.NrTrans ")

watch(sql.batch)
acn(z1,0)
Recorrer SQL
    SCN(z1,1)
    ACT(a:Val(z1), fbn['NrTrans'])
    ACT(b:Val(z1), fbn['Fecha2'])
    ACT(c:Val(z1), fbn['Cliente1'])
    ACT(d:Val(z1), fbn['TipoTr2'])
    ACT(e:Val(z1), fbn['Especie'])
    ACN(f:Val(z1), ABS(fbn['Cantidad1']))

    ACT(ab:Val(z1), fbn['CB5'])

proximo

if Val(z1)=0
  Cancelar('No existen Vouchers para imprimir')
else
  ACO(1,9)
  ACO(2,11)
  ACO(3,11)
  ACO(4,7)
  ACO(5,11)
  ACO(6,15)
  FormatoCeldas(f1..f:Val(z1),Exe('F2'))
  
  ListBox(a:1..f:Val(z1),'Voucher     Fecha         Cliente        Tipo     Especie                 Cantidad')
        
  if Ok
    recorrerSel

      IF EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0')
         if EqStr(Val(d:FilaCiclo),'PDIVID')
            LinkearHoja('IMPPDI',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=Dialogo.Check3)
         else
            IF EqStr(Val(d:FilaCiclo),'CANJE')
               LinkearHoja('IMPCAN',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=Dialogo.Check3)
            else
               LinkearHoja('IMPSSP',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=Dialogo.Check3)
            endif
         endif
      ELSE
         if EqStr(Val(d:FilaCiclo),'PDIVID')
            LinkearHoja('IMPPDI',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=Dialogo.Check3)
         else
            IF EqStr(Val(d:FilaCiclo),'CANJE')
               LinkearHoja('IMPCAN',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=Dialogo.Check3)
            else
               LinkearHoja('IMPSSP',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=Dialogo.Check3)
            endif
         endif
      ENDIF
        
      * Marca de ya impreso  
      If EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0') 
           SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
           SQL.ADD("Set    CB5 = '1' ") 
           SQL.ADD("where  NrTrans = '"~Val(a:FilaCiclo)~"' ") 
           SQL.NEW
           SQL.EXEC 
      Endif     
     
    proximo
  endif
endif  
