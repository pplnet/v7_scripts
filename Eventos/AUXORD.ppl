SetFilaActual(FAC+2)
ACT(a:FAC, 'NrOrden')
ACT(b:FAC, 'TipoOrden')
ACT(c:FAC, 'FechaEnvio')
ACT(d:FAC, 'Direccion')
ACT(e:FAC, 'NroAlta')
ACT(f:FAC, 'Leyenda')


SQL.ADD(" Select NrOperacion from "~DBO~".OPERACIONESBITS Where ( NrBit = 71 ) and ( Valor = '1' ) ")
SQL.ADD(" Order by NrOperacion ")
Recorrer SQL
  ACT(a:FAC, FBN['NrOperacion'])
  SQL.ADD(" Select NrOrden,TipoOrden,FechaEnvioMAE,Direccion,NroAltaMAE,Leyenda1 from "~DBO~".ORDENES Where NrOrden = '"~FBN['NrOperacion']~"' ")
  Recorrer SQL
    ACT(a:fac,fbn['NrOrden'])
    ACT(b:fac,fbn['TipoOrden'])
    ACT(c:fac,fbn['fechaEnvioMAE'])
    ACT(d:fac,fbn['direccion'])
    ACT(e:fac,fbn['NroAltaMAE'])
    ACT(f:fac,fbn['Leyenda1'])
    
    *** Generar la operacion a partir de la Orden
    EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=1, Entero1=71, Entero2=9)
    EjecutarEvento('GEOPOR', NrOrden1=fbn['NrOrden'], Check1=1)
  proximo
proximo

