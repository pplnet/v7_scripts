*BID Compra, ASK venta. ASK > BID
* Actualizar Cotizaciones a partir del informe
* que toma los precios de Bloombergs (Spot y Futuros)

ACT(yy:2, HORA(AHORA))
ACT(zz:2, Copy(Val(yy:2),1,2)~Copy(Val(yy:2),4,2)~Copy(Val(yy:2),7,2))
ACD(yy:3, Fsys)
ACT(zz:3, Copy(Val(yy:3),1,2)~Copy(Val(yy:3),4,2)~Copy(Val(yy:3),9,2))

*Limite de precios tomados
ACN(x1, VAR('ACTCONFILA')+1)

*Valida si existe el directorio para crear el txt
If ExisteDirectorio(VAR('PATLGESP'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATLGESP'),Longitud(VAR('PATLGESP')),1),'\')
      ACT(pl:1, VAR('PATLGESP')~'PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   Else
       ACT(pl:1, VAR('PATLGESP')~'\PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   EndIf
   **
Else
    Cancelar('El directorio '~VAR('PATLGESP')~' no existe')
EndIf

ACN(tx:2, 0)
ACT(fh:1, FECHA(HOY)~' '~HORA(AHORA)~' ACTCON')

HojaVisible(SI)

***---A: 'Especie
***---B: 'Cotizacion
***---C: 'Moneda
***---D: 'Fecha
***---E: 'codigo Valuacion
borrarceldas(er2)

LinkearHoja('BLOOMN',1)


*- Variables
* z2 : Primera fila con contenido
* z3 : Ultima fila con contenido
* z4 : Primera Celda asignada
* z5 : Ultima Celda asignada
* z6 : Celda corriente

ACN(z2,2)
ACN(z3,Val(x1))
ACN(bd:7, 0)

SetFilaActual(4)
ACN(z4,fac)
ACN(z5,fac)

*- Recorrer valores
Recorrer&i Val(z2),Val(z3)
   try
      ACT(a:Val(z5), Trim(Mirt(LinkH(1,a:Val(z5)))))
   catch
      Cancelar("Hubo un problema con el archivo NO se puede procesar ")
   end
   *ACT(a:Val(z5), Trim(Mirt(LinkH(1,a:Val(z5)))))
   ACN(b:Val(z5), LinkH(1,b:Val(z5)))
   ACT(c:Val(z5), LinkH(1,c:Val(z5)))
   ACD(d:Val(z5), LinkH(1,d:Val(z5)))
   ACT(e:Val(z5), LinkH(1,e:Val(z5)))
   If eqstr(val(a:Val(z5)),'') Y NoVacio(VAL(W3)) y eqstr(val(e:Val(z5)),'')
      Break
   EndIf

   **// Fecha de la cotizacion
   If NoVacio(Val(d:Val(z5))) Y Val(d:Val(z5))>0
      ACD(FC:1, Val(d:Val(z5)))
   Else
      ACD(FC:1, FSYS)
   Endif
   
   ACT(es:1, Val(a:Val(z5))) 
   
   If Novacio(Val(a:Val(z5))) o [Vacio(Val(a:Val(z5))) y Novacio(Val(e:Val(z5)))]
       *** Contador de Leidos
       SCN(W:3,1)
   endif
   If Novacio(Val(a:Val(z5))) 
      SCN(W:5,1)      
   EndIf
   If SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(a:Val(z5))~"' ")=1 Y Novacio(Val(a:Val(z5)))
        if SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(c:Val(z5))~"' ")=1 Y Novacio(Val(c:Val(z5)))
          If Val(b:Val(z5)) <> 0 
             Message('Actualizando Cotizacion: '~Val(b:Val(z5)))
             *- Buscar Cotizacion Contado de hoy para ver si UPDATE o INSERT
             ACN(x:3,SQL("SELECT Count(*) FROM "~DBO~".COTIZACIONESESP WHERE especie='"~Val(a:Val(z5))~"' and Fecha='"~IdxDate(Val(FC:1))~"' and codigovaluacion=SUBSTRING('"~Val(e:Val(Z:5))~"',1,6)"))
             *- Actualizar Precio         Precio1: Close Precio2: Ask Precio3: Bid Precio4: Last
             If Val(x:3)=1 
                SQL.ADD("UPDATE "~DBO~".COTIZACIONESESP SET ")           
                SQL.ADD("cotizacion="~FStr(Val(b:Val(z5)),1,8)~", ")
                SQL.ADD("moneda='"~Val(c:Val(Z:5))~"', ")
                SQL.ADD("codigovaluacion=SUBSTRING('"~Val(e:Val(Z:5))~"',1,6)")
                SQL.ADD("WHERE especie='"~Copy(Val(a:Val(z5)),1,6)~"' and Fecha='"~IdxDate(Val(FC:1))~"' and codigovaluacion=SUBSTRING('"~Val(e:Val(Z:5))~"',1,6)")
                SQL.NEW
                SQL.EXEC       
             Else
                *- Insertar registro : PAPELES Y MONEDAS (MAYO 2012) 
                SQL.ADD("INSERT INTO "~DBO~".COTIZACIONESESP ")
                SQL.ADD("(Fecha, especie, cotizacion, moneda,codigovaluacion) ")
                SQL.ADD(" VALUES ('"~IdxDate(Val(FC:1))~"', '"~Copy(Val(a:Val(Z:5)),1,6)~"',"~Fstr(Val(b:Val(Z:5)),0,8)~", ")
                SQL.ADD(" upper('"~Val(c:Val(Z:5))~"'),SUBSTRING('"~Val(e:Val(Z:5))~"',1,6))")
                SQL.NEW
                SQL.EXEC
                ***---NO OPERATIVO ACTUALIZAR DIA ANTERIOR       
             Endif
             Else
             * --- No se considera el spot si llega cotizacion de Bloomberg en 0 (para los 4 campos)
             * --- W:9 = Contador de Ignorados 
             If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie') O Not EqStr(Val(a:Val(z5)), '')
             if val(b:Val(z5)) = 0 
                  SCN(W:9,1)       
                  If Val(bd:7)=0
                     AbrirAscii(Val(pl:1),0)    
                     EscribirAscii(Val(fh:1))
                     AgregarMarco(b:Val(Z:5)..b:Val(Z:5),2,0,Exe('COLOR'))
                     ACN(tx:2,9)
                     (.'MENSAJETXT'.)
                     ACN(bd:7, 1)
                  Else 
                    ACN(tx:2,9)
                    AgregarMarco(b:Val(Z:5)..b:Val(Z:5),2,0,Exe('COLOR'))
                    (.'MENSAJETXT'.)
                  EndIf
                else
                    if val(b:Val(z5))=0 
                       AgregarMarco(b:Val(Z:5)..b:Val(Z:5),2,0,Exe('COLOR'))
                       ACN(tx:2,12)
                       (.'MENSAJETXT'.)
                    endif
                endif
             Endif
          EndIf
      else
          ***Moneda
          If vacio(Val(c:Val(z5)))
             If Val(bd:7)=0
                AbrirAscii(Val(pl:1),0)    
                EscribirAscii(Val(fh:1))
                ACT(es:1, LinkH(1,ac:Val(w3))) 
                AgregarMarco(c:Val(Z:5)..c:Val(Z:5),2,0,Exe('COLOR'))
                ACN(tx:2,1)
                (.'MENSAJETXT'.)
                ACN(bd:7, 1)
             Else
                AgregarMarco(c:Val(Z:5)..c:Val(Z:5),2,0,Exe('COLOR'))
                ACT(es:1, LinkH(1,ac:Val(w3)))
                ACN(tx:2,1)
                (.'MENSAJETXT'.)
             EndIf
          EndIf     
      endif
   Else
      If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie')
         If Val(bd:7)=0
            AbrirAscii(Val(pl:1),0)    
            EscribirAscii(Val(fh:1))
            ACT(es:1, LinkH(1,aa:Val(w3))) 
            ACN(tx:2,1)
            (.'MENSAJETXT'.)
            ACN(bd:7, 1)
         Else
            ACT(es:1, LinkH(1,aa:Val(w3))) 
            AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
            ACN(tx:2,1)
            (.'MENSAJETXT'.)
         EndIf
      else
          If vacio(Val(a:Val(z5))) y not eqstr(val(e:Val(z5)),'')
            ACT(es:1, LinkH(1,aa:Val(w3))) 
            AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
            ACN(tx:2,1)
            (.'MENSAJETXT'.)
          endif
      EndIf
   endif
   SCN(z5,1)
Proximo

CerrarASCII
CerrarHoja('BLOOMN',1)
ACT(a1, 'Cotizaciones Automaticas')
ACT(a3, 'Especie')
ACT(b3, 'Cotizacion')
ACT(c3, 'Moneda')
ACT(d3, 'Fecha')
ACT(e3, 'Valuacion')

borrarCeldas(a2..i2)

AlinearCeldas(a3..i3, 'D')
AgregarMarco(a3..e3,2,0,Exe('COLOR'))

LinkearHoja('ERRCOT',1,String1=Val(pl:1),Radio1=0)

**// La conversion de cotizaciones se hace unicamente para la fecha del sistema
**// Las cotizaciones que se ingresen de dias anteriores, no realiza esta conversion.

ACD(FC:1, FSYS)

ACT(ME:1, Var('MONEEXTR'))
*ACT(MU:1, Var('MONEURU'))
LimitesVision(f:Val(z5)-1)