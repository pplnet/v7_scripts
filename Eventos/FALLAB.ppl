* Este evento es invocado desde el Cierre y modifica la fecha de afectacion ****
* de cashflow para los TRANSP *****
*HojaVisible(SI)
CrearDialogo
  Vehiculo1: 'Vehiculo'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   : 'Fecha Cierre';;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
  Check1   : 'Automatico'  ;;1;;;;;;;0;
FinDialogo
if Not Ok
  Cancelar
endif

ACT(y1, Fecha(FSys, 'YYYY.MM.DD'))

************************************************
* Selecciona Fallas para modificar la afectacion 
************************************************
SetFilaActual(0)
SQL.ADD("Select T.Mercado1, T.TipoTr2, T.Cliente1, T.CB5, T.NrOperacionRef1, ")
SQL.ADD("T.NrTrans, T.Especie, T.Cantidad1, T.Fecha2, T.Cuenta1, ")
SQL.ADD("T.Cuenta2, T.Especie1, T.Cantidad2, T.Cupon1, T.CB6, ")
SQL.ADD("T.CB7, T.CB8 ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and T.TipoTr2   = 'TRANSP' ")
SQL.ADD("   and T.CB2      <> '1' ")
SQL.ADD("   and T.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("Order By 1, 7, 3")

recorrer SQL;;SI
  acn(p:fac, 1)
  ACT(bi:FAC, FBN['NrTrans'])
  ACT(cb:FAC, FBN['TipoTr2'])
  ACT(ba:FAC, FBN['Cliente1'])
  ACT(be:FAC, FBN['Especie'])
  ACN(bg:FAC, FBN['Cantidad1'])
  ACD(bj:FAC, Habiles(Fsys,1,'ARG',SI))
proximo

ACO(53,9)
ACO(54,4)
ACO(55,3)
ACO(56,7)
ACO(57,9)
ACO(58,12)
ACO(59,12)
ACO(60,4)
ACO(61,7)
ACO(62,9)
FormatoCeldas(bf:1..bg:FAC,Exe('F2'))

if FAC>0

if Dialogo.Check1 = 0
   CrearListBox ; 'Arial,8,';'GENERACION FALLAS'
     'Cliente'        ; ba1..ba:fac;NO;;;150;STRING;;Exe('COLOR6');
     'Especie'        ; be1..be:fac;NO;;;70;STRING;;Exe('COLOR6');
     'Moneda'         ; bg1..bg:fac;NO;;;110;NUMERO;'###,###,###,###.##';Exe('COLOR6');
     'Falla'          ; bi1..bi:fac;NO;;;70;STRING;;Exe('COLOR6');
     'Fecha'          ; bj1..bj:fac;NO;;;60;FECHA;Exe('COLOR6');
     'Ok'             ;  p1..p:fac ;  ;;;30;CHECK;Exe('COLOR3');;;;;;NO;; 
   FinListBox
endif


   if Ok o Dialogo.Check1=1
      Recorrer&i 1,fac
         If Val(p:&i) = 1
            SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD("SET Fecha4 = '"~IdxDate(Val(bj:&i))~"' ")
            SQL.ADD("Where NrTrans = '"~Val(bi:&i)~"' ")
            SQL.NEW
            SQL.EXEC             

            ModificarOperacion(Val(bi:&i),0,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,SI,NO,NO,NO,1)
         EndIf
      Proximo
   EndIf
Else
   if Dialogo.Check1=0
      MessageBox('No hay Fallas para Modificar.')
   endif
EndIf

