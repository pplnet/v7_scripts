* Atencion!!!!!! Revisar todo el control de saldos con lo de CYO
* Chequea el saldo de una unica cuenta del vehiculo en el momento incorrecto
     ** Control de Saldo de Cartera Propia **
     (.'SALDOCPARG'.)

     If EqStr(Val(at1), 'SI')
        MostrarCuadroDeMensajes
        
        Recorrer&i 4,val(z1)
           If val(ag:&i) = 1
              ** Chequeo que no se hayan liquidado previamente **
              If Num(SQL("select 1 as Hay from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T where M.NrTrans2=T.NrTrans and M.NrOperacion IN ("~Pipe2Comillas(val(ah:&i))~") and M.NrSaldo=31 and M.Especie='"~Val(ab:&i)~"' and M.Mercado='"~Dialogo.Mercado1~"' and T.Cantidad26="~Fstr(val(ap:&i),1,0)~" ")) = 0
              * Si es CyO o Garantizado para CP
                 if [val(am:&i)=1 o Eqstr(Val(aj:&i), val(y1))] y Eqstr(Val(y14),'NO')
                    ACT(al:&i,iif(Val(af:&i)=0,'COMP',iif(Val(af:&i)<0,'RET','DEP')))
                 else
                    ACT(al:&i,iif(Val(af:&i)=0,'COMP',iif(Val(af:&i)<0,'DEP','RET')))
                 endif   
*FO28/11/05 Cambio por numerador solo AC    ACT(aq:&i,GetNumerador(1))
                 ACT(aq:&i,GetNumerador(21))
                 
                 if EqStr(val(y14),'SI')
                    ACT(av:&i,iif(Incluido('TITULO',Val(au:&i)),Dialogo.Cuenta1,iif(EqStr(Val(ab:&i),VAR('MONELOCA')),Dialogo.Cuenta2,Dialogo.Cuenta3)))
                 else
                    ACT(av:&i,val(ak:&i))
                 endif
                 * Paso los Movimientos a Ejecutados con NrSaldo+30 --------------------------------------------------------------- *
                  
                 Message("Ejecutando Movimientos de "~Val(ab:&i))
                 SQL.ADD("insert into "~DBO~".MOVEJECUTADOS ")
                 SQL.ADD("    (Especie, FechaEj, PrecioEj, CallPut, Cliente, Cantidad, FechaMov, NrOperacion, ")
                 SQL.ADD("     Cuenta, Leyenda, NrSaldo, EnteCustodia, Bits, NrGrupo, FechaEje, ")
                 SQL.ADD("     Concepto, NrMov, NrLiq, NrTrans2,  ")
                 SQL.ADD("     Mercado,  ")
                 SQL.ADD("     Book, Cupon) ")
                 SQL.ADD("select Especie, FechaEj, PrecioEj, CallPut, Cliente, Cantidad, FechaMov, NrOperacion, ")
                 SQL.ADD("     '"~Val(av:&i)~"' Cuenta, Leyenda, NrSaldo+30 , EnteCustodia, Bits, NrGrupo, '"~IdxDate(Fsys)~"', ")
                 SQL.ADD("     Concepto, NrMov, NrLiq, '"~Val(aq:&i)~"',  ")
*                 SQL.ADD("     Mercado,  ")
                 SQL.ADD("     CASE WHEN Cliente = '"~VAR('VEHICULODE')~"' then (SELECT IsNull(Mercado,'') FROM "~DBO~".CUENTAS WHERE Codigo='"~Val(av:&i)~"') ELSE Mercado END Mercado,  ")
                 SQL.ADD("     Book, Cupon ")
                 SQL.ADD(" from  "~DBO~".MOVPENDIENTES M ")
                 SQL.ADD(" Where Especie = '"~Val(ab:&i)~"' ")
                 SQL.ADD("  and  NrSaldo = 1 ")
                 SQL.ADD("  and  NrGrupo = "~FSTR(val(ar:&i),1,0)~" ")
                 
                 if EqStr(val(y14),'SI')
                    SQL.ADD("  and  Mercado = '"~Dialogo.Mercado1~"' ")
                 else
                    SQL.ADD("  and  Mercado = '"~val(an:&i)~"' ")
                 endif   
                 SQL.ADD("  and  NrOperacion IN ("~Pipe2Comillas(val(ah:&i))~") ")
                 SQL.ADD("  and  EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
                 SQL.ADD("  and  FechaMov  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
                 If NoVacio(Dialogo.Cliente1)   
                    SQL.ADD("and Cliente = '"~Dialogo.Cliente1~"' ")
                 Endif
                 If NoVacio(Dialogo.Especie1)
                    SQL.ADD("and Especie = '"~Dialogo.Especie1~"' ")
* Creo que no hace falta porque ya está la lista de Operaciones
*                    SQL.ADD("and Exists(Select 1 FROM "~DBO~".OPERACIONES O WHERE O.NrOperacion=MOVEJECUTADOS.NrOperacion and O.Mercado4='"~val(ao:&i)~"' ) ")
                 Endif
                 SQL.NEW
                 SQL.EXEC
                 
                 SQL.ADD("delete from "~DBO~".MOVPENDIENTES ")
                 SQL.ADD(" where Especie = '"~Val(ab:&i)~"' ")
                 SQL.ADD("  and  NrSaldo = 1 ")
                 SQL.ADD("  and  NrGrupo = "~FSTR(val(ar:&i),1,0)~" ")
                 if EqStr(val(y14),'SI')
                    SQL.ADD("  and  Mercado = '"~Dialogo.Mercado1~"' ")
                 else
                    SQL.ADD("  and  Mercado = '"~val(an:&i)~"' ")
* Creo que no hace falta porque ya está la lista de Operaciones
*                    SQL.ADD("and Exists(Select 1 FROM "~DBO~".OPERACIONES O WHERE O.NrOperacion=MOVPENDIENTES.NrOperacion and O.Mercado4='"~val(ao:&i)~"' ) ")
                 endif   
                 SQL.ADD("  and  NrOperacion IN ("~Pipe2Comillas(val(ah:&i))~") ")
                 SQL.ADD("  and  EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
                 SQL.ADD("  and  FechaMov  <= '"~IdxDate(Dialogo.Fecha1)~"' ")

                 If NoVacio(Dialogo.Cliente1)   
                    SQL.ADD("and Cliente = '"~Dialogo.Cliente1~"' ")
                 Endif
                 If NoVacio(Dialogo.Especie1)
                    SQL.ADD("and  Especie = '"~Dialogo.Especie1~"' ")
                 Endif
                 SQL.NEW
                 
                 * Genero la Transaccion ------------------------------------------------------------------------------------------ *
                  
                 Message("Generando Transaccion "~Val(al:&i)~" "~Val(aq:&i))

                 
                 SQL.ADD("insert into "~DBO~".TRANSACCIONES2 ")
                 SQL.ADD("(TipoTr2, NrTrans, Vehiculo1, Especie, ")
                 SQL.ADD(" Cliente1, ")
                 SQL.ADD(" Cuenta1, ")
                 SQL.ADD(" Cuenta2 ,")
                 SQL.ADD(" Fecha1, Fecha2, ")
                 SQL.ADD(" Cantidad1, Ley1, Ley2, CB1, CB2, ")
                 SQL.ADD(" Ley3, ")
                 SQL.ADD(" RB1, Fecha4, Fecha3, ")
                 SQL.ADD(" Cupon1, Mercado1, Cuenta3, Cantidad3, Observaciones, ")
                 SQL.ADD(" Book1, Ley4, Cantidad11,  ")
                 SQL.ADD(" Cantidad25, ")
                 SQL.ADD(" Cantidad12,  ")
                 SQL.ADD(" Cantidad26, ")
                 SQL.ADD(" Especie3)  ")
                 SQL.ADD("Values")
                 SQL.ADD("('"~Val(al:&i)~"', '"~Val(aq:&i)~"', '"~Dialogo.Vehiculo1~"', '"~Val(ab:&i)~"', ")
                 if EqStr(val(y14),'SI')
                    SQL.ADD(" '"~Dialogo.Cliente2~"',  ")
                 else
                    SQL.ADD(" '"~val(aj:&i) ~"',  ")
                 endif
                 SQL.ADD(" '"~val(av:&i)~"', ")
                 if EqStr(val(y14),'SI')
                     If Incluido('TITULO',Val(au:&i))
                        if val(y22)=1
                           SQL.ADD(" '"~Val(da:&i)~"', ")
                        else
                           IF val(y24)=1
                              SQL.ADD(" '"~val(av:&i)~"', ")
                           else
                              * si mrtcadollevacustodia          
                              SQL.ADD(" '"~Val(y8)~"', ")
                           endif   
                        endif
                     else   
                        If Incluido(VAR('MONELOCA'),Val(au:&i))
                            SQL.ADD(" '"~Dialogo.String1~"', ")
                        else
                            SQL.ADD(" '"~Dialogo.String2~"', ")
                        Endif
                     Endif
                 else
                    SQL.ADD(" '"~val(at:&i)~"', ")
                 endif
                 SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"','"~IdxDate(Fsys)~"', ")
                 SQL.ADD(" "~FStr(Abs(Val(af:&i)),0,2)~",'"~IIf(val(ai:&i)>1,'NETO','')~"','"~Val(au:&i)~"', '1', '0', ")
                 SQL.ADD(" '"~val(db:&i)~"',")
                 SQL.ADD(" '2', Null, Null, ")

                 ACN(cp1, NrCupon2(Val(ab:&i),Dialogo.Fecha1))
                 If Val(cp1) <> 0
                    SQL.ADD(" '"~FStr(Val(cp1),0,0)~"', ")
                 Else
                    SQL.ADD(" NULL, ")
                 Endif
                 
                 SQL.ADD(" '"~Dialogo.Mercado1~"','"~val(av:&i)~"',"~FStr(Abs(Val(af:&i)),0,2)~", '"~Val(ah:&i)~"', ")
                 ACT(bk1,BuscarCampo('MOVEJECUTADOS','Book','NrTrans2',Val(aq:&i)) )
                 
                 SQL.ADD(" '"~Val(bk1)~"','"~VAL(ax:1)~"', "~FSTR(val(aw:&i),0,2)~",")
                 if Eqstr(val(as:&i),'Saldos')
                    if val(az:&i)=1
                       SQL.ADD(" '1',")
                    else
                       SQL.ADD(" '4',")
                    endif   
                 else
                     if Eqstr(val(as:&i),'Limites')
                        SQL.ADD(" '2',")
                     else
                        SQL.ADD(" '0',")
                     endif
                 endif
                 SQL.ADD(FSTR(SQL("SELECT PlazoParking From "~DBO~".ESPECIES WHERE Codigo='"~val(ay:&i)~"' "),1,0)~",")
                 SQL.ADD(FSTR(val(ap:&i),1,0)~",")
                 SQL.ADD(" '"~val(ay:&i)~"' ) ")
                 SQL.NEW
                 SQL.EXEC
                 
                 EjecutarEvento2("AMT2", String1 = Val(aq:&i))
                  
                 ** Alta en Instancia 12 - Pre-liquidacion **
                 ACT(az3, Val(aq:&i))
                 ACT(az4, 'TRANSACCIONES2')
                 ACT(az5, '12|') 
                 (.'ALTAINSTAN'.) 

                 if Eqstr(VAR('LIQUNPASO'),'SI')
                    Message('Generando Transaccion de Custodia ...')
* FJL 16/06/23 - Por error de Memoria Insuficiente
*                    EjecutarEvento('LIQ012',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Mercado1=Dialogo.Mercado1,NrTrans1=Val(aq:&i),Check1=1,Check2=1,Check3=0) 
                    EjecutarEvento2('LIQ012',Vehiculo1=Dialogo.Vehiculo1,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Mercado1=Dialogo.Mercado1,NrTrans1=Val(aq:&i),Check1=1,Check2=1,Check3=0) 
                 endif
                 
                 * ---------------------------------------------------------------------------------------------------------------- *
                 
                 Message(" ")
              Else 
                 Cancelar("Imposible pre-liquidar "~Val(ab:&i)~"."~Chr(13)~Chr(10)~"Otro usuario puede estar liquidando estas operaciones o falta confirmar lo ya liquidado.")
              Endif 
           Endif
        Proximo
        
        *        Message('Pasando Operaciones a Terminal ...')
        *        EjecutarEvento('PPASE',NrOperacion='', Mercado1=Dialogo.Mercado1)
        
        OcultarCuadroDeMensajes
        
     Endif
  Endif 
Break
Proximo

