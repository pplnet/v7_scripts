* ex codigo -> PRELAR
*HojaVisible(SI)
Repetir
  * FJL 5/9/19 - Control de Memoria disponible
  (.'CONTMEM'.)
  
  If Val(b1)>0
    BorrarCeldas(a:4..l:Val(b1))
    BorrarCeldas(cr:4..cr:Val(b1))
  Endif
   
  If Val(z1)>0
    BorrarCeldas(aa:4..az:Val(z1))
    BorrarCeldas(ba:4..bz:Val(z1))
    * Continuacion de az
    BorrarCeldas(da:4..dz:Val(z1))
    * Continuacion de bz
    BorrarCeldas(ea:4..ez:Val(z1))
  Endif
   
  CrearDialogo
     Fecha1   :'Fecha PreLiq.' ;1;1;;;;Dialogo.Fecha1<>0 ;'Debe Ingresar una Fecha';NO;FSys;
     Especie1 :'Especie'       ; ;1;;;;;;;
     Cliente1 :'Cliente'       ; ;1;;;;;;;;
     Radio1   :'MAE OK|No|Si'  ; ;1;;NO;NO;;;;0;
     Vehiculo1:'Vehiculo'      ; ;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');
     Mercado2 :'Mercado Neg.'  ; ; ;;  ;;NoVacio(Dialogo.Mercado2);'Debe ingresar un Mercado de Negociacion';NO;VAR('AMBMAE');;;;;" EsNegociacion='SI' "
     Mercado1 :'Mercado Liq'   ; ;1;;  ;;NoVacio(Dialogo.Mercado1) ;'Debe ingresar un Mercado';NO;VAR('MERNETEODE');;;;;" ((NETEA='SI' and EsLiquidacion='SI') or (Codigo in("~Pipe2Comillas(VAR('MERNONET'))~"))) "
     Cliente2 :'ClienteMercado'; ;1;;NO;EqStr(Dialogo.String1,'SI');[NoVacio(Dialogo.Cliente2) y EqStr(Dialogo.String1,'SI')] o EqStr(Dialogo.String1,'NO');'Debe definir el Cliente Mercado';NO; ;SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' ");
     Check2   :'Lici 3ros'     ; ; ;;;;;;;;;
     Check1   :'Liq.Moneda'    ; ; ;;NO;NO;;;;;IF(EqStr(Dialogo.String1,'NO'),0,0);
     String1  :'Mercado Neteo' ; ; ;;NO;NO;;;;;SQL("SELECT isNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' ");
     NrOperacion1 : 'Operacion'; ; ;;NO;NO;;;;;
  FinDialogo

  If Not Ok
     Break
  Endif  
  
  *- Saldo Libre Disponibilidad
  ACN(sl0,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')) )
  
  ACT(y14,Dialogo.String1)
  ACT(y15,Dialogo.Mercado2)
  ACN(y20,0)
  ACN(y21,0)
  ACN(y22,Dialogo.Check2)
  ACN(y23,0)
  ACN(y24,SQL("SELECT 1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' AND Afectacustodia='SI'"))
 
  *- Selecciona los movimientos agrupandolos por nro.operacion
  SQL.ADD("Select DISTINCT M.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.FechaVto,O.Especie,O.ContraEspecie, O.Cantidad, O.TotalNetoCli1, ")
  SQL.ADD("       C.RazonSocial,O.CB7,O.NrBoleto,M.Cantidad as CantMov,M.Especie as EspeMov,M.NrMov, O.CB4 CYO ") 
  
  SQL.ADD("FROM "~DBO~".MOVPENDIENTES M INNER JOIN "~DBO~".OPERACIONES O ON M.NrOperacion = O.NrOperacion")
  SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion")
  SQL.ADD("INNER JOIN "~DBO~".CLIENTES C ON M.Cliente = C.Codigo")

  SQL.ADD("WHERE (B.NrBit = 10  or B.NrBit = 70)              ")
  *23/12/04  SQL.ADD("  and B.NrBit = 10                        ")
  SQL.ADD("  and B.Valor = '1'                                ")
  SQL.ADD("  and M.Mercado = '"~Dialogo.Mercado1~"'           ") 
  SQL.ADD("  and O.Mercado4 = '"~Dialogo.Mercado2~"'          ") 
  SQL.ADD("  and M.EnteCustodia = '"~Dialogo.Vehiculo1~"'     ")
  SQL.ADD("  and M.FechaMov  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  If NoVacio(Dialogo.NrOperacion1)   
     SQL.ADD("  and O.NrOperacion = '"~Dialogo.NrOperacion1~"'   ")
  Endif   
  If NoVacio(Dialogo.Cliente1)   
     SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"'          ")
  Endif
  If NoVacio(Dialogo.Especie1)
     SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"'          ")
  Endif
  if EqStr(val(y14),'NO')
     SQL.ADD("and O.TipoOp in('TIC','TIV') and (O.CB4=1 or O.Cliente1=O.Vehiculo1 )  ")
     * Poner la rueda de la ope cuando estén todas
     ACT(ax:1, 'CPC1')
  endif
  if Dialogo.Check2=1
     SQL.ADD("and O.TipoOp in('TCOPRI') and (O.Cliente1<>O.Vehiculo1 ) and "~DBO~".DesciendeDeEspecie(M.Especie,'TITULO') = 1   ")
  else   
     SQL.ADD("and Not (O.TipoOp in('TCOPRI') and (O.Cliente1<>O.Vehiculo1 ) and "~DBO~".DesciendeDeEspecie(M.Especie,'TITULO') = 1)  ")
  endif
  SQL.ADD(" order by O.Especie, O.ContraEspecie, M.NrOperacion")
    watch(SQL.BATCH())
  
  *- Con esta seleccion preparo un listbox complementario
  ACT(a0,'Marca')
  ACT(c0,'Cliente')
  ACT(d0,'Operacion')
  ACT(e0,'TipoOp')
  ACT(f0,'FechaOp')
  ACT(g0,'FechaVto')
  ACT(h0,'Especie')
  ACT(i0,'ContraEspecie')
  ACT(j0,'Cantidad')
  ACT(k0,'TotalNetoCli1')
  ACT(m0,'CyO')
  
  SetFilaActual(3)
  ACN(b1,3)
  
  MostrarCuadroDeMensajes

  ACT(ck1,'')  
  Recorrer SQL     
     ** Chequeo si las operaciones extrabursatiles pasaron completamente por el MAE **
     
     If [NoVacio(fbn('NrBoleto')) y Dialogo.Radio1=1] o Dialogo.Radio1=0
         
        Message('Operacion '~fbn('NrOperacion'))

        If Not EqStr(val(ck1),fbn('NrOperacion'))
           ACT(ck1,fbn('NrOperacion'))
           SCN(b1,1)
        EndIf

        ACN(a:val(b1),1)

        ACT(c:val(b1),fbn('Cliente1'))
        ACT(cr:val(b1),fbn('RazonSocial'))
        ACT(d:val(b1),fbn('NrOperacion'))
        ACT(e:val(b1),fbn('TipoOp'))
        ACD(f:val(b1),fbn('FechaOp'))
        ACD(g:val(b1),fbn('FechaVto'))
        ACT(h:val(b1),fbn('Especie'))
        ACT(i:val(b1),fbn('ContraEspecie'))

        If EqStr(FBN['Especie'],FBN['EspeMov'])
           SCN(j:val(b1),fbn('CantMov'))
           SCN(xj:val(b1),fbn('CantMov')*-1)
        Else 
           SCN(k:val(b1),fbn('CantMov'))
           SCN(xk:val(b1),fbn('CantMov')*-1)
        EndIf
        ACT(L:val(b1), '')
        if fbn['CYO']=1
           ACT(m:val(b1),'CyO')
        else   
           ACT(m:val(b1),'CP')
        endif   
     Endif
  Proximo
   
  OcultarCuadroDeMensajes
  
  If Val(b1) = 3
     Messagebox('No existen operaciones para Preliquidar')
  Else
    CrearListBox;'Arial,8,';'Operaciones a PRELIQUIDAR '~Dialogo.Mercado1
        'Marca'        ;a4..a:Val(b1)  ;SI;;; 30;CHECK ;RGB(160,160,193)
        'Cliente'      ;c4..c:Val(b1)  ;NO;;; 80;STRING;;RGB(250,250,193)
        'Nombre'       ;cr4..cr:Val(b1);NO;;;150;STRING;;RGB(250,250,193)
        'Operacion'    ;d4..d:Val(b1)  ;NO;;; 60;STRING;;RGB(250,250,193)
        'TipoOp'       ;e4..e:Val(b1)  ;NO;;; 50;STRING;;RGB(250,250,193)
        'Especie'      ;h4..h:Val(b1)  ;NO;;; 50;STRING;;RGB(250,250,193)
        'ContraEspecie';i4..i:Val(b1)  ;NO;;; 50;STRING;;RGB(250,250,193)
        'FechaOp'      ;f4..f:Val(b1)  ;NO;;; 60;FECHA;RGB(250,250,193)
        'FechaVto'     ;g4..g:Val(b1)  ;NO;;; 60;FECHA;RGB(250,250,193)
        'Cantidad'     ;xj4..xj:Val(b1)  ;NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193)
        'Monto'        ;xk4..xk:Val(b1)  ;NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193)
        'Tipo'         ;m4..m:Val(b1);NO;;;50;STRING;;RGB(250,250,193)
        * ---------------------------------------------------------------- *
     FinListBox
     
     If Not OK
        Cancelar
     Endif
     
     *****************************************************************
     * Todas las Operaciones que estan marcadas forman parte del Neteo
     *****************************************************************
     * z2: Especie Corte de Control
     * z4: Marca -> 0: Especie / 1:Moneda
     *****************************************************************
     * z1: Puntero para Especies
     *
     * aa: Especie Nro.
     * ab: Especie Alfabetico
     * ac: Denominacion
     * ad: A Entregar
     * ae: A Recibir
     * af: Neto
     * ag: Marca
     * ah: Lista Op. involucradas
     * ai: Elementos(ah)
     * aj: Si liquida CP el Veh, si no cada Cliente
     * ak: Cuenta
     * al: Tipo Transaccion
     * am: CyO
     * an: MercadoLiq
     * ao: MercadoNeg
     * ap: Tipo Voucher segun NrGrupo
     * aq: Numerador
     * ar: Numero de Grupo
     * as: Afecta por limites o saldos
     * at: Cuenta Vehiculo
     * au: Ascendientes
     * ay: Contraespecie de la operacion
     * az: Bloquea saldos
     *****************************************************************
     * z3: Puntero para Monedas
     *
     * ba: Moneda Nro.
     * bb: Especie
     * bc: Denominacion
     * bd: A Entregar
     * be: A Recibir
     * bf: Neto 
     * bg: Marca
     * bh: Lista Op. involucradas
     * bi: Elementos(bh)
     * bj: Si liquida CP el Veh, si no cada Cliente
     * bk: Cuenta
     * bm: CyO
     * bn: MercadoLiq
     * bo: MercadoNeg
     * bp: Tipo Voucher segun NrGrupo
     * br: NrGrupo
     * bs: Afecta por limites o saldos
     * bu: Ascendientes
     *****************************************************************
     
     ACN(z1,3)
     ACT(z2,'')
     ACN(z3,3)
     ACN(z4,0)
     
     ACT(xa:1,'')
     Recorrer&i 4,Val(b1)
        If Val(a:&i)=1
           ACT(xa:1,Val(xa:1)~Val(d:&i)~'|')
        Endif
     Proximo

     ** Selecciona los Movimientos agrupandolos por NrOperacion **
     
     SQL.ADD("SELECT M.*, E.CodNumCajaValores, E.Nombre, O.CB4 CYO, O.Mercado4 MercaNeg, O.TipoOp, O.Cliente1 CliOpe, O.Vehiculo1 VehOpe, ")
     SQL.ADD("       CASE WHEN O.CB4=1 THEN M.Cliente ELSE M.EnteCustodia END AS CarteraCyO, O.ContraEspecie, O.AfectaLS, O.MB2, O.Especie EspOpe, ")
     SQL.ADD("       O.Cuenta2, O.Cuenta3 ")
     SQL.ADD(" from  "~DBO~".MOVPENDIENTES M,"~DBO~".ESPECIES E,"~DBO~".OPERACIONES O  ")
     SQL.ADD(" where M.NrOperacion IN ("~Pipe2Comillas(Val(xa:1))~") ")
     SQL.ADD("  and  ((M.Especie     = E.Codigo AND O.TipoOp not in('DDC','DDV') ) OR (O.TipoOp in('DDC','DDV') and E.Codigo=O.ContraEspecie)   ) ")
     SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
     SQL.ADD("  and  O.Mercado4    = '"~Dialogo.Mercado2~"' ")
     If Dialogo.Check1=1
        SQL.ADD("  and  O.Mercado     = '"~Dialogo.Mercado1~"' ")
     else
        SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"' ")
     endif   
     SQL.ADD("  and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
     SQL.ADD("  and M.FechaMov  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
     If NoVacio(Dialogo.Cliente1)   
        SQL.ADD("  and M.Cliente = '"~Dialogo.Cliente1~"' ")
     Endif
     If NoVacio(Dialogo.Especie1)
        SQL.ADD("  and M.Especie = '"~Dialogo.Especie1~"' ")
     Endif
     if Val(y22)=1
        SQL.ADD("and O.TipoOp in('TCOPRI') and (O.Cliente1<>O.Vehiculo1 ) and "~DBO~".DesciendeDeEspecie(M.Especie,'TITULO') = 1   ")
     else   
        SQL.ADD("and Not (O.TipoOp in('TCOPRI') and (O.Cliente1<>O.Vehiculo1 ) and "~DBO~".DesciendeDeEspecie(M.Especie,'TITULO') = 1)  ")
     endif
     
     SQL.ADD(" order by CarteraCyO, M.Especie, M.Cuenta, O.CB4, O.Contraespecie,O.AfectaLS, O.MB2, M.NrGrupo, M.NrOperacion, M.NrMov ")
     *     watch(SQL.BATCH())
     MostrarCuadroDeMensajes
     * Hay titulos?
     ACN(ca:1,0)              
     * Hay pesos?
     ACN(ca:2,0)              
     * Hay dolares?
     ACN(ca:3,0)              
     Recorrer SQL
        dfa       
        If Not EqStr(Val(z2),fbn('CarteraCyO')~fbn('Especie')~fbn('Cuenta')~FSTR(fbn('CYO'),1,0)~fbn('ContraEspecie')~fbn('AfectaLS')~fbn('MB2')~FSTR(fbn('NrGrupo'),3,0))
           If Not DesciendeDeEspecie(fbn('Especie'),'MONEDA')
              ACN(z4,0)
              SCN(z1,1)
              ACT(aa:Val(z1),fbn('CodNumCajaValores'))
              ACT(ab:Val(z1),fbn('Especie'))
              ACT(ac:Val(z1),fbn('Nombre'))
              ACN(ag:Val(z1),1)  
              ACT(aj:val(z1),fbn('CarteraCyO'))
              ACT(ak:val(z1),fbn('Cuenta'))
              ACN(am:val(z1),fbn('CyO'))
              ACT(an:val(z1),fbn('Mercado'))
              ACT(ao:val(z1),fbn('MercaNeg'))
              if fbn('NrGrupo')=15
                 ACN(ap:val(z1),1)
              else
                 if fbn('NrGrupo')=16
                    ACN(ap:val(z1),2)
                 else
                    ACN(ap:val(z1),0)
                 endif
              endif
              ACN(ar:val(z1),fbn('NrGrupo'))
              ACT(as:val(z1),fbn('AfectaLS'))
*             Para saldos de titulos bloquea siempre 
*              ACN(az:val(z1),fbn('MB2'))
              ACN(az:val(z1),1)
              ACT(au:Val(z1),Ascendientes('ESPECIES',fbn('Especie')))
              ACT(ay:val(z1),fbn('ContraEspecie'))
              * Cta tit Veh
              If Val(y22)=1
                 ACT(da:val(z1),fbn('Cuenta2'))
                 ACT(db:val(z1),'LICI3RO')
                 ACN(y23,90)
              endif   
              * Hay al menos una especie titulos a liquidar
              ACN(ca:1,1)              
              if Vacio(TRIM(val(ak:val(z1))))
                 acn(y20,1)
              endif   
           Else
              ACN(z4,1)
              SCN(z3,1)
              ACT(bb:Val(z3),fbn('Especie'))  
              ACT(bc:Val(z3),fbn('Nombre'))
              ACT(bj:val(z3),fbn('CarteraCyO'))
              ACT(bk:val(z3),fbn('Cuenta'))
              ACN(bm:val(z3),fbn('CyO'))
              ACT(bn:val(z3),fbn('Mercado'))
              ACT(bo:val(z3),fbn('MercaNeg'))
              if fbn('NrGrupo')=15
                 ACN(bp:val(z3),1)
              else
                 if fbn('NrGrupo')=16
                    ACN(bp:val(z3),2)
                 else
                    ACN(bp:val(z3),0)
                 endif
              endif
              ACN(br:val(z3),fbn('NrGrupo'))
              ACT(bs:val(z3),fbn('AfectaLS'))
              ACN(bz:val(z3),fbn('MB2'))
              * Cta Mon Veh
              If Val(y22)=1
                 ACT(ea:val(z1),fbn('Cuenta3'))
              else    
                 ACT(ea:val(z1),val(y13))
              endif   
              

              ACT(bu:Val(z3),Ascendientes('ESPECIES',fbn('Especie')))
              if Eqstr(fbn('Especie'),VAR('MONELOCA'))
                 * Hay al menos una especie Pesos a liquidar
                 ACN(ca:2,1)              
              else
                 if Eqstr(fbn('Especie'),VAR('MONEEXTR'))
                    * Hay al menos una especie DOLAR a liquidar
                    ACN(ca:3,1)              
                 endif
              endif
           Endif

           ACT(z2,fbn('CarteraCyO')~fbn('Especie')~fbn('Cuenta')~FSTR(fbn('CYO'),1,0)~fbn('ContraEspecie')~fbn('AfectaLS')~fbn('MB2')~FSTR(fbn('NrGrupo'),3,0))
        Endif
        
        Message('Operacion: '~fbn('NrOperacion')~' Mov. '~Fstr(fbn('NrMov'),1,0))
        
        If Val(z4) = 0
           If fbn('Cantidad') > 0
              * A Entregar 
              SCN(ad:Val(z1),Abs(fbn('Cantidad')))
           Else
              * A Recibir 
              SCN(ae:Val(z1),Abs(fbn('Cantidad')))
           Endif

           If Incluido(FBN['TipoOp'],'TIV|') y [fbn['CYO']=1 o Eqstr(fbn['CliOpe'],fbn['VehOpe'])]
              SCN(aw:Val(z1),Abs(fbn('Cantidad')))
           endif                 
           
           SCN(af:Val(z1),(-1) * fbn('Cantidad'))
           ACT(ah:Val(z1),Val(ah:Val(z1))~fbn('NrOperacion')~'|')
           ACN(ai:Val(z1),Elementos(Val(ah:Val(z1))) )
           * Cuenta Vehiculo
           SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
           SQL.ADD(" WHERE Especies   LIKE '%TITULO%' ")
           SQL.ADD("   AND Estado     = 'HAB' ")
           SQL.ADD("   AND TipoCuenta = 'CUS' ")
           if EqStr(val(y14),'SI')
              SQL.ADD("   AND Mercado    = '"~Dialogo.Mercado1~"' ")
              SQL.ADD("   AND Alias1 like '%CP%' ")
              SQL.ADD("   AND Cliente='"~Dialogo.Vehiculo1~"' ")
           else
    * Evaluar si hace falta filtrar cliente MAECLEAR y como
              SQL.ADD("   AND Alias1 like '%TER%' ")
              SQL.ADD("   AND MercadoNeg = '"~Dialogo.Mercado2~"'")
              if Val(af:Val(z1))>0
                 SQL.ADD("   and (Transacciones like '%RTP|%' or Transacciones is Null) ")
              else   
                 SQL.ADD("   and (Transacciones like '%DTP|%' or Transacciones is Null) ")
              endif
           endif   
           SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")
*           watch(SQL.BATCH())
           Recorrer SQL
              dfa
              act(at:val(z1), FBN['Codigo'])
           Proximo
           if Vacio(TRIM(val(at:val(z1))))
              acn(y21,1)
           endif   
        Else
           If fbn('Cantidad') > 0
              * A Entregar 
              SCN(bd:Val(z3),Abs(fbn('Cantidad')))
           Else
              * A Recibir 
              SCN(be:Val(z3),Abs(fbn('Cantidad')))
           Endif 
           SCN(bf:Val(z3),(-1) * fbn('Cantidad'))
           ACT(bh:Val(z3),Val(bh:Val(z3))~fbn('NrOperacion')~'|')
           ACN(bi:Val(z3),Elementos(Val(bh:Val(z3))) )

           If Incluido(FBN['TipoOp'],'TIC|') y [fbn['CYO']=1 o Eqstr(fbn['CliOpe'],fbn['VehOpe'])] y Eqstr(fbn['AfectaLS'],'Saldos') y fbn['MB2']=1
              SCN(bw:Val(z3),Abs(fbn('Cantidad')))
           endif                 
           
           
          if Val(bp:Val(z3))=1
          *                   SQL.ADD(" '"~Dialogo.Cuenta7~"', ") 
             SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
             SQL.ADD(" where Estado     = 'HAB' ")
             SQL.ADD("   and Especies   Like '%"~fbn('Especie')~"%' ")
             SQL.ADD("   and TipoCuenta In ('CC','CA') ")
             SQL.ADD("   and Alias1 like '%COM%' ")
             SQL.ADD("   and MercadoNeg = '"~Dialogo.Mercado2~"'")
             * Solo se filtra en BACS porque lo necesitan y no se sabe si aplica al resto de los mercados
             #ifdef BACS
                SQL.ADD("   and MercadoLiq = '"~Dialogo.Mercado1~"'")
             #endif
             * si no es Dialogo.Mercado2 y15
             SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")
             *watch(SQL.BATCH())
             Recorrer SQL
                dfa
                act(bt:val(z3), FBN['Codigo'])
             Proximo
          else
             if Val(bp:Val(z3))=2
            *                   SQL.ADD(" '"~Dialogo.Cuenta8~"', ")
                SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
                SQL.ADD(" where Estado     = 'HAB' ")
                SQL.ADD("   and Especies   Like '%"~fbn('Especie')~"%' ")
                SQL.ADD("   and TipoCuenta In ('CC','CA') ")
                SQL.ADD("   and Alias1 like '%DER%' ")
                SQL.ADD("   and MercadoNeg = '"~Dialogo.Mercado2~"'")
                * Solo se filtra en BACS porque lo necesitan y no se sabe si aplica al resto de los mercados
                #ifdef BACS
                   SQL.ADD("   and MercadoLiq = '"~Dialogo.Mercado1~"'")
                #endif
                SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")
                *watch(SQL.BATCH())
                Recorrer SQL
                  dfa
                  act(bt:val(z3), FBN['Codigo'])
                Proximo
             else
                if Val(bf:Val(z3))>0
              *                          SQL.ADD(" '"~Dialogo.Cuenta2~"', ")
               * los positivos dol pesos
              
                   SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
                   SQL.ADD(" where Especies   Like '%"~fbn('Especie')~"%' ")
                   SQL.ADD("   and Estado     = 'HAB' ")
                   SQL.ADD("   and TipoCuenta In ('CC','CA') ")
                   if EqStr(val(y14),'SI')
                      SQL.ADD("   and MercadoLiq = '"~Val(y9)~"' ")
                      SQL.ADD("   and Alias1 like '%CP%' ")
                      SQL.ADD("   and Cliente    = '"~Dialogo.Cliente2~"' ")
                   else
            * Evaluar si hace falta filtrar cliente MAECLEAR y como
                      SQL.ADD("   and Alias1 like '%TER%' ")
                      SQL.ADD("   and MercadoNeg = '"~Dialogo.Mercado2~"'")
                      SQL.ADD("   and (Transacciones like '%DEP|%' or Transacciones is Null) ")
                      * Solo se filtra en BACS porque lo necesitan y no se sabe si aplica al resto de los mercados
                      #ifdef BACS
                         SQL.ADD("   and MercadoLiq = '"~Dialogo.Mercado1~"'")
                      #endif
                   endif
                   SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")
                   watch(SQL.BATCH())

                   Recorrer SQL
                      dfa
                      act(bt:val(z3), FBN['Codigo'])
                   Proximo
                else
               *                      SQL.ADD(" '"~Dialogo.Cuenta5~"', ")
               * los neg dol pesos
                   SQL.ADD("Select Top(1) Codigo from "~DBO~".CUENTAS ")
                   SQL.ADD(" where Especies   Like '%"~fbn('Especie')~"%' ")
                   SQL.ADD("   and Estado     = 'HAB' ")
                   SQL.ADD("   and TipoCuenta In ('CC','CA') ")
                   SQL.ADD("   and Alias1 like '%TER%' ")
                   SQL.ADD("   and MercadoNeg = '"~Dialogo.Mercado2~"'")
                   SQL.ADD("   and (Transacciones like '%RET|%' or Transacciones is Null) ")
                   * Solo se filtra en BACS porque lo necesitan y no se sabe si aplica al resto de los mercados
                   #ifdef BACS
                      SQL.ADD("   and MercadoLiq = '"~Dialogo.Mercado1~"'")
                   #endif
                   SQL.ADD(" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ")
                   Recorrer SQL
                      dfa
                      act(bt:val(z3), FBN['Codigo'])
                   Proximo
                endif   
             Endif
          endif    
           
           
        Endif
