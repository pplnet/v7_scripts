            Cuenta3  : 'M.Extra Cta'   ;8;1;;  ;;[ClienteCuenta(Dialogo.Cliente2, Dialogo.Cuenta3,VAR('MONEEXTR')) y 1=SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Codigo='"~Dialogo.Cuenta3~"' AND Estado='HAB' AND TipoCuenta In ('CC','CA') ")                                             ] o val(ca:3)=0 ;'Cuenta Moneda Extranjera Neteo Incorrecta';NO;Val(y7) ;Val(y7) ;SQLSET("Select Codigo FROM "~DBO~".CUENTAS Where Estado='HAB' and Cliente='"~Dialogo.Cliente2~"'  and Especies Like '%"~VAR('MONEEXTR')~"%' and TipoCuenta In ('CC','CA')                                                                                                                ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");;;"Estado='HAB' and Cliente='"~Dialogo.Cliente2~"'  and Especies Like '%"~VAR('MONEEXTR')~"%' and TipoCuenta In ('CC','CA') "
            String1  : 'M.Local Propia';7;2;;  ;; ClienteCuenta(Dialogo.Vehiculo1,Dialogo.String1,VAR('MONELOCA')) y 1=SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Codigo='"~Dialogo.String1~"' AND Estado='HAB' AND TipoCuenta In ('CC','CA') ")                                              ;'Cuenta Moneda Local Propia Incorrecta'    ;NO;Val(y11);Val(y11);SQLSET("Select Codigo FROM "~DBO~".CUENTAS Where Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Especies Like '%"~VAR('MONELOCA')~"%' and TipoCuenta In ('CC','CA')                                                                                                                ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");;;"Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Especies Like '%"~VAR('MONELOCA')~"%' and TipoCuenta In ('CC','CA') "
            String2  : 'M.Extra Propia';8;2;;  ;; ClienteCuenta(Dialogo.Vehiculo1,Dialogo.String2,VAR('MONEEXTR')) y 1=SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Codigo='"~Dialogo.String2~"' AND Estado='HAB' AND TipoCuenta In ('CC','CA') ")                                              ;'Cuenta Moneda Local Extranjera Incorrecta';NO;Val(y12);Val(y12);SQLSET("Select Codigo FROM "~DBO~".CUENTAS Where Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Especies Like '%"~VAR('MONEEXTR')~"%' and TipoCuenta In ('CC','CA')                                                                                                                ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");;;"Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Especies Like '%"~VAR('MONEEXTR')~"%' and TipoCuenta In ('CC','CA') "
            Cuenta4  : 'Cta.Ppia'      ;9;1;;  ;Not val(y22); ClienteCuenta(Dialogo.Vehiculo1,Dialogo.Cuenta4,'TITULO'       ) y 1=SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Codigo='"~Dialogo.Cuenta4~"' AND Estado='HAB' AND TipoCuenta In ('OTR','CUS','CCO') AND Mercado = 'CV'                   ") ;'Cuenta Propia Incorrecta'                 ;NO;Val(y13);Val(y13);SQLSET("Select Codigo FROM "~DBO~".CUENTAS Where Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Patindex('%TITULO%',Especies)<>0      and TipoCuenta In ('OTR','CUS','CCO')  and Mercado='CV'                  and (TiposOperacion is Null or Patindex('%TIC%',TiposOperacion)<>0) ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");;;"Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' and Patindex('%TITULO%',Especies)<>0      and TipoCuenta In ('OTR','CUS','CCO') and Mercado='CV'                   and (TiposOperacion is Null or Patindex('%TIC%',TiposOperacion)<>0) "

