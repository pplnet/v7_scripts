        'Cta.Moneda'      ;n:Val(FI:1)..n:fac;SI;Val(A:FLB)=0 o Incluido(Val(N:FLB), SQLSet(" Select Codigo From "~DBO~".CUENTAS Where Cliente='"~Val(C:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Dialogo.Especie2~"%' OR Especies LIKE '%MONEDA%')"));'Cuenta Moneda Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';" Cliente = '"~Val(C:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA') AND (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%')";RGB(255,255,193);
        'Comision'        ;aa:Val(FI:1)..aa:fac;NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'IVA'             ;ab:Val(FI:1)..ab:fac;NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
      FinListBox
   Else
      * Acciones
      CrearListBox ; 'Arial,8,';'  Pago de Dividendos: '~Val(NM:1)~' (ISIN: '~Val(AI:1)~') Pago en Acciones. - MOVPENDIENTES'
        'Ok?'            ;a:Val(FI:1)..a:fac;SI;;;30;CHECK ;
        'Mercado'        ;b:Val(FI:1)..b:fac;NO;;;100;STRING;;RGB(220,220,193)
        'Cliente'        ;c:Val(FI:1)..c:fac;NO;;;100;STRING;;RGB(220,220,193)
        ** 'Book'           ;BK:Val(FI:1)..BK:fac;NO;;;100;STRING;;RGB(220,220,193)
        ** 'Fecha Mov'      ;Q:Val(FI:1)..Q:fac;NO;;;100;FECHA;RGB(220,220,193)
        'Cantidad'       ;h:Val(FI:1)..h:fac;NO;;;120;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        '%'              ;i:Val(FI:1)..i:fac;NO;;;100;NUMERO;'###,###.#####';RGB(220,220,193)
