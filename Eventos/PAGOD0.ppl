****---SALDOS Libre
SQL.ADD("SELECT 0 Tipo, S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, S.NrSaldo, C.RazonSocial, ")
SQL.ADD("       S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125 ")
** FJL 21/05/21 - Cambio de criterio - Depedne de la cuenta
*SQL.ADD(" FROM "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C ")
SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE S.Cliente      = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
*SQL.ADD("   AND S.NrSaldo      = "~Fstr(Val(SL:1), 0, 0)~" ")
SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:2))~") ")
SQL.ADD("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
SQL.ADD("   AND S.NrSaldo      <> 1 ")
SQL.ADD("   AND S.Especie      ='"~Dialogo.Especie1~"' ")

** FJL 21/05/21 - Cambio de criterio
***---SQL.ADD(" AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
**SQL.ADD(" AND S.Cliente = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Dialogo.Vehiculo1~"' = S.EnteCustodia AND 'HAB' = C.Status) ")
*SQL.ADD("       OR ('"~Dialogo.Vehiculo1~"' = C.Codigo AND 'HAB' = C.Status )) ")   
SQL.ADD("   AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and S.Cuenta       = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND S.Mercado      = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("   AND S.Fecha IN (SELECT Max(S1.Fecha)  ")
SQL.ADD("                     FROM "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE S1.Cliente = S.Cliente ")
SQL.ADD("                      AND S1.Especie = S.Especie ")
SQL.ADD("                      AND S1.Mercado = S.Mercado ")
SQL.ADD("                      AND S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                      AND S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                      AND S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                      AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
SQL.ADD("                      AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
SQL.ADD("                      AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))")
SQL.ADD("                      AND S1.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")

SQL.ADD("union all ")

* Saldos Bloqueo
SQL.ADD("SELECT 0 Tipo, S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, S.NrSaldo, C.RazonSocial, ")
SQL.ADD("       S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125 ")
SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE S.Cliente      = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:3))~") ")
SQL.ADD("   AND S.NrSaldo      Not in ("~Pipe2Comillas(Val(sl:4))~") ")
SQL.ADD("   AND S.Especie      ='"~Dialogo.Especie1~"' ")
SQL.ADD("   AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and S.Cuenta       = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND S.Mercado      = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("   AND S.Fecha IN (SELECT Max(S1.Fecha)  ")
SQL.ADD("                     FROM "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE S1.Cliente = S.Cliente ")
SQL.ADD("                      AND S1.Especie = S.Especie ")
SQL.ADD("                      AND S1.Mercado = S.Mercado ")
SQL.ADD("                      AND S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                      AND S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                      AND S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                      AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
SQL.ADD("                      AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
SQL.ADD("                      AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))")
SQL.ADD("                      AND S1.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")

SQL.ADD("union all ")

* Saldos Parking
SQL.ADD("SELECT 1 Tipo, S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, S.NrSaldo, C.RazonSocial, ")
SQL.ADD("       S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125 ")
SQL.ADD("  from "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE S.Cliente      = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
SQL.ADD("   AND S.NrSaldo      in ("~Pipe2Comillas(Val(sl:4))~") ")
SQL.ADD("   AND S.Especie      ='"~Dialogo.Especie1~"' ")

SQL.ADD("   AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and S.Cuenta       = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND S.Mercado      = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("   AND S.Fecha IN (SELECT Max(S1.Fecha)  ")
SQL.ADD("                     FROM "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE S1.Cliente = S.Cliente ")
SQL.ADD("                      AND S1.Especie = S.Especie ")
SQL.ADD("                      AND S1.Mercado = S.Mercado ")
SQL.ADD("                      AND S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                      AND S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                      AND S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                      AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null))")
SQL.ADD("                      AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null))")
SQL.ADD("                      AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null))")
SQL.ADD("                      AND S1.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")

SQL.ADD(" ORDER BY Tipo, S.NrSaldo, S.Cliente, S.Especie, S.CallPut, S.FechaEj, S.PrecioEj, S.EnteCustodia, S.Mercado, S.Cuenta ")

watch(SQL.Batch)

ACN(Z:1,0)
Recorrer SQL
#ifdef PRUEBA
*     MessageBox('Prueba '~fbn('RazonSocial')~' - NrSaldo '~FStr(fbn('NrSaldo'))~' - Saldo '~PyC(fbn('Saldo'),1,2))
#endif 

  IF fbn('Saldo') <> 0
     IF fbn('Tipo')=0
       SCN(fi:2, 1)
     else
       #ifdef PRUEBA
         * Tambien muestra saldos parking
         SCN(fi:2, 1)
       #endif 
     endif
     ACN(BJ:1, 1)
     Message(fbn('RazonSocial'))
     ACN(A:fac, 1)
     ACT(b:fac, fbn('Mercado'))
     ACT(c:fac, fbn('Cliente'))
     ACT(d:fac, fbn('RazonSocial'))
     ACT(e:fac, fbn('CallPut'))
     ACD(f:fac, fbn('FechaEj'))
     ACN(g:fac, fbn('PrecioEj'))
     ACN(h:fac, fbn('Saldo'))
     ACN(i:fac, Dialogo.Precio1)
     ACT(M:fac, fbn('Cuenta'))
     ACT(TC:fac, fbn('TipoCliente'))
     ACT(R:fac, Dialogo.Especie2)
     ACN(SD:fac, fbn('NrSaldo'))
     ACN(u:fac, fbn('NrSaldo'))
     ACN(v:fac, fbn('Tipo'))
     ACN(w:fac, Val(u:fac))
     if Val(u:fac)>201
       ACN(w:fac, Val(u:fac)-100)
     endif
     ACT(x:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(w:fac)))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
     ACN(y:fac, 0)
     if Incluido(Val(u:fac),Val(sl:3))
       ACN(y:fac, 1)
     endif
     
     If Dialogo.Radio1 = 0
        * Efvo
** FJL 28/08/23 - Issue EXTBIND 6032
*        ACN(j:fac, Val(h:fac)*Val(i:fac)/100)
        ACN(j:fac, 0)
        ACN(k:fac, 0)
        ACN(l:fac, 0)                                                                                                                                                                                        
** FJL 19/11/21 - Se agrega monto en Moneda - Base para Comisiones
** FJL 28/08/23 - Issue EXTBIND 6032
*        ACN(t:fac, Val(j:fac)*Val(ct:2))
        ACN(t:fac, Val(h:fac)*Val(i:fac)/100)
     Else
        * Acciones
        ACN(j:fac, Val(h:fac)*Val(i:fac)/100 )
        ACN(k:fac, Dialogo.Precio2)
*        ACN(ln:fac, (((Val(j:fac)/Val(lm:1)) - (Val(j:fac) DIV Val(lm:1)))*Val(lm:1)))
        ACN(lo:fac, Val(j:fac)/Val(lm:1) )
        ACN(lp:fac, Trunc(Val(j:fac)/Val(lm:1),0) )
        ACN(lq:fac, (Val(lo:fac) - Val(lp:fac))*Val(lm:1))
        ACN(ln:fac, Val(lq:fac))
        ACN(l:fac, Val(ln:fac)*Val(k:fac))
        ACN(j:fac, Val(j:fac)-Val(ln:fac))
        ACN(PR:fac, Dialogo.Precio2*Val(CT:1))
** FJL 19/11/21 - Se agrega monto en Moneda - Base para Comisiones
        ACN(t:fac, Val(j:fac)*Val(ct:2))
     Endif
** FJL 26/04/22 - Si es saldo de parking no tiene monto moneda
     if Val(v:fac)=1
        ACN(t:fac, 0)
     endif

     ***---Cuenta Moneda
** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
*     ACT(N:fac, SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA')  "))

** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*     ACT(N:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
     if Val(y:fac)=1
       * Saldo bloqueado
       ACT(N:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('VIS') and Mercado='"~Val(ml:1)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
     else
       ACT(N:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
     endif
     ACN(Z:1,1)

     if Not EqStr(Val(c:fac),Dialogo.Vehiculo1) y Val(t:fac)>0
       If Dialogo.Radio1 = 0
         * Efvo
         ACT(ae:fac, 'DIVEFE')
       else
         * Acciones
         ACT(ae:fac, 'DIVACC')
       endif
       ACN(ag:fac, COTIZACIONC(val(r:fac),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))     
       ACN(ah:fac, iif(EqStr(Modo(val(r:fac),VAR('MONELOCA')),'INV'),1/val(ag:fac),val(ag:fac)))
       
** FJL 19/11/21 - Se agrega monto en Moneda - Base para Comisiones
*       ACN(af:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(j:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),4,,,,'PDIVID',,,,,,,SI))
*       ACN(aa:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(j:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),0,,,,'PDIVID',,,,,,,SI))
       ACN(af:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),4,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))
       ACN(aa:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),0,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))

       * Cond   
       ACT(ac:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Dialogo.Vehiculo1))
       * Tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*       ACN(ad:fac, MontoImpuesto('IVARGCOM',Dialogo.Fecha1,3,Val(ac:fac))/100)
       ACN(ad:fac, MontoImpuesto('IVACOMECA',Dialogo.Fecha1,3,Val(ac:fac))/100)

       * IVA
       ACN(ab:fac, Val(aa:fac)*Val(ad:fac))
     else
       ACN(aa:fac, 0)
       ACN(ab:fac, 0)
     endif  
     
     ** FJL 23/8/22 - Se agrgan Comisiones CV
     if Val(t:fac)>0
       if EqStr(Val(c:fac),Dialogo.Vehiculo1)
         * Cartera Propia
         ACN(bl:fac, 1)
       else
         * Terceros
         ACN(bl:fac, 0)
       endif
       If Dialogo.Radio1 = 0
         * Efvo
         ACT(be:fac, 'CVDIVE')
       else
         * Acciones
         ACT(be:fac, 'CVDIVA')
       endif
       ACN(bg:fac, COTIZACIONC(val(r:fac),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))     
       ACN(bh:fac, iif(EqStr(Modo(val(r:fac),VAR('MONELOCA')),'INV'),1/val(bg:fac),val(bg:fac)))
       
       ACN(bf:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(be:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(bh:fac)),4,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))
       ACN(ba:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(be:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(bh:fac)),0,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))

       * Cond IVA
       ACT(bc:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Dialogo.Vehiculo1))
       * Tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*       ACN(bd:fac, MontoImpuesto('IVARGCOM',Dialogo.Fecha1,3,Val(bc:fac))/100)
       ACN(bd:fac, MontoImpuesto('IVACOMECA',Dialogo.Fecha1,3,Val(bc:fac))/100)

       * IVA
       ACN(bb:fac, Val(ba:fac)*Val(bd:fac))
     else
       ACN(ba:fac, 0)
       ACN(bb:fac, 0)
     endif  
  ELSE
     DFA
  ENDIF
Proximo

