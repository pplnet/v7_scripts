   Endif

   If NOT OK
      MessageBox('Pago de dividendos de SALDOS cancelado')
   ELSE
#ifdef PRUEBA
  MessageBox('Despues ListBox 1')
#else

      Recorrer&k Val(FI:1), fac
        IF Val(A:&k) = 1
           ***---Genero PDIVID de Saldos
           ACT(XX:1, GetNumerador(45))
           SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ")
           SQL.ADD("(TipoTr2, NrTrans, Cliente1, Especie, ")
           SQL.ADD(" Fecha1, Fecha2, Especie2, ")
           SQL.ADD(" Cantidad1, Cantidad2, Cantidad3, ")
           SQL.ADD(" Precio1, Precio2, RB1, ")
           SQL.ADD(" RB10, Mercado1, Numerador, ")
           SQL.ADD(" Cuenta1, Cuenta2, Cupon1, ")
           SQL.ADD(" Vehiculo1, FechaCargaSys, FechaCarga, ")
           SQL.ADD(" Cantidad4, Cliente2, ")
* FJL 26/08/21 - Comisiones Eventos Corporativos
           SQL.ADD(" Cantidad10, Cantidad11, ")
* FJL 18/12/21 - Se guarda Monto Moneda (Base Comisiones)
           SQL.ADD(" Cantidad9, ")
* FJL 24/08/22 - se agregan Comisiones e IVA CV
           if Val(bl:&k)=1
             * Cartera Propia
             SQL.ADD(" Cantidad12, Cantidad13, ")
           else
             * Terceros
             SQL.ADD(" Cantidad14, Cantidad15, ")
           endif
* FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*                En CB3 se guarda si es bloqueado
           SQL.ADD(" CB3, ")
* FJL 26/04/22 - Se guarda NrSaldo para usar en los movimientos
           SQL.ADD(" Cambio5, ")
           SQL.ADD("RB2, CB1) ")
           SQL.ADD(" VALUES ")
           SQL.ADD("('PDIVID', '"~Val(XX:1)~"', '"~Val(c:&k)~"', '"~Dialogo.Especie1~"', ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Dialogo.Especie2~"', ")
           SQL.ADD(" "~FStr(Val(h:&k),0,4)~", "~FStr(Val(j:&k),0,4)~", "~FStr(Val(l:&k),0,4)~", ")
           SQL.ADD(" "~FStr(Dialogo.Precio1,0,6)~", "~FStr(Val(PR:&k),0,6)~", '1', ")
           SQL.ADD(" "~Fstr(Dialogo.Radio1, 0, 0)~", '"~Val(b:&k)~"', 45, ")
           SQL.ADD(" '"~Val(m:&k)~"', '"~Val(n:&k)~"', '0', ")
           SQL.ADD(" '"~Dialogo.Vehiculo1~"', '"~IdxDate(Fsys)~"', "~SQLAhora~", ")
           SQL.ADD(" "~FStr(Val(SD:&k),0,0)~", '"~Val(O:&k)~"', ")
* FJL 26/08/21 - Comisiones Eventos Corporativos
           SQL.ADD(" "~FStr(Val(aa:&k),0,2)~", "~FStr(Val(ab:&k),0,2)~", ")
* FJL 18/12/21 - Se guarda Monto Moneda (Base Comisiones)
           SQL.ADD(" "~FStr(Val(t:&k),0,2)~", ")
* FJL 24/08/22 - se agregan Comisiones e IVA CV
           SQL.ADD(" "~FStr(Val(ba:&k),0,2)~", "~FStr(Val(bb:&k),0,2)~", ")
* FJL 01/07/22 - Cuanta Vista para saldos bloquedas
*                En CB3 se guarda si es bloqueado
           SQL.ADD(" "~FStr(Val(y:&k),0,0)~", ")
* FJL 26/04/22 - Se guarda NrSaldo para usar en los movimientos
           SQL.ADD(" "~FStr(Val(u:&k),0,0)~", ")
           SQL.ADD(" '0', '0') ")
           SQL.NEW
           SQL.EXEC
           SQL.ActualizarMovimientosT2(Val(XX:1),SI,NO,NO,NO)   
           SQL.EXEC
           SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ") 
           SQL.ADD(" (NrOperacion, NrBit, Valor) ")
           SQL.ADD(" VALUES ")
           SQL.ADD(" ('"~Val(XX:1)~"',51, '1') ")
           SQL.NEW
           SQL.EXEC
           ***---IF Eqstr(Val(C:&k), Dialogo.Vehiculo1) Y Val(BJ:2) = 0 Y Dialogo.Radio1 = 1
** FJL - Se saca la parte de Posiciones para STD
           IF Eqstr(Val(C:&k), Dialogo.Vehiculo1) Y Not Eqstr(Val(B:&k), Val(B:&k-1)) y NO
              ***---Corto Posiciones a VTO
              ACN(BJ:2, 1)
              SQL.ADD(" Select Cliente, CantidadFin, Sector as Mercado, 'Spot' Posicion, Fecha, NrSaldo, Book ")
              SQL.ADD(" From "~DBO~".POSICIONES P ")
              SQL.ADD(" Where Especie = '"~Dialogo.Especie1~"' ")
              SQL.ADD(" AND Cliente = '"~Dialogo.Vehiculo1~"' ")
              SQL.ADD(" AND Vehiculo = '"~Dialogo.Vehiculo1~"' ")
              SQL.ADD(" and NrSaldo = 111 ")
              SQL.ADD(" AND Sector = '"~Val(B:&k)~"' ")
              SQL.ADD(" AND Fecha = (Select Max(Fecha) From "~DBO~".POSICIONES ")
              SQL.ADD("               Where P.Especie = P2.Especie ")
              SQL.ADD("               AND P.Cliente = P2.Cliente ")
              SQL.ADD("               AND P.Vehiculo = P2.Vehiculo ")
              SQL.ADD("               AND P.NrSaldo = P2.NrSaldo ")
              SQL.ADD("               AND P.Sector = P2.Sector ")
              SQL.ADD("               AND P.Book = P2.Book ")
              SQL.ADD("               AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")
              Watch(SQL.BATCH)
              Recorrer SQL
                IF fbn('CantidadFin') <> 0
                   ACN(BJ:1, 1)
                   ACN(A:fac, 1)
                   ACT(b:fac, fbn('Mercado'))
                   ACT(c:fac, fbn('Cliente'))
                   ACD(D:fac, fbn('Fecha'))
                   ACT(BK:fac, fbn('Book'))
                   ACT(E:fac, fbn('Posicion'))
                   ACN(h:fac, fbn('CantidadFin'))
                   ACN(i:fac, Dialogo.Precio1)
                   ACT(R:fac, Dialogo.Especie2)
                   ACN(SD:fac, fbn('NrSaldo'))
                   If Dialogo.Radio1 = 0
                       ACN(j:fac, Val(h:fac)*Val(i:fac)/100)
                       ACN(k:fac, 0)
                       ACN(l:fac, 0)                                                                                                                                                                                        
                   Else
                      ACN(j:fac, Val(h:fac)*Val(i:fac)/100 )
                      ACN(k:fac, Dialogo.Precio2)
                      ACN(ln:fac, (((Val(j:fac)/Val(lm:1)) - (Val(j:fac) DIV Val(lm:1)))*Val(lm:1)))
                      ACN(l:fac, Val(ln:fac)*Val(k:fac))
                      ACN(j:fac, Val(j:fac)-Val(ln:fac))
                   Endif
                   ***---Genero PDIVID de POSICIONES
                   ACT(XX:1, GetNumerador(45))
                   SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ")
                   SQL.ADD("(TipoTr2, NrTrans, Cliente1, Especie, ")
                   SQL.ADD(" Fecha1, Fecha2, Especie2, ")
                   SQL.ADD(" Cantidad1, Cantidad2, Cantidad3, ")
                   SQL.ADD(" Precio1, Precio2, RB1, ")
                   SQL.ADD(" RB10, Mercado1, Numerador, ")
                   SQL.ADD(" Cuenta1, Cuenta2, Book1, Cupon1, ")
                   SQL.ADD(" Vehiculo1, FechaCargaSys, FechaCarga, ")
                   SQL.ADD(" Cantidad4, Cliente2, ")
* FJL 26/08/21 - Comisiones Eventos Corporativos
                   SQL.ADD(" Cantidad10, Cantidad11, ")
                   SQL.ADD("RB2, CB1) ")
                   SQL.ADD(" VALUES ")
                   SQL.ADD("('PDIVID', '"~Val(XX:1)~"', '"~Val(c:fac)~"', '"~Dialogo.Especie1~"', ")
                   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Dialogo.Especie2~"', ")
                   SQL.ADD(" "~FStr(Val(h:fac),0,4)~", "~FStr(Val(j:fac),0,4)~", "~FStr(Val(l:fac),0,4)~", ")
                   SQL.ADD(" "~FStr(Dialogo.Precio1,0,6)~", "~FStr(Dialogo.Precio2*Val(CT:1),0,6)~", '0', ")
                   SQL.ADD(" "~Fstr(Dialogo.Radio1, 0, 0)~", '"~Val(b:fac)~"', 45, ")
                   SQL.ADD(" '"~Val(m:fac)~"', '"~Val(n:fac)~"', '"~Val(BK:fac)~"', '0', ")
                   SQL.ADD(" '"~Dialogo.Vehiculo1~"', '"~IdxDate(Fsys)~"', "~SQLAhora~", ")
                   SQL.ADD(" "~FStr(Val(SD:fac),0,0)~", '"~Dialogo.Vehiculo1~"', ")
* FJL 26/08/21 - Comisiones Eventos Corporativos
                   SQL.ADD(" "~FStr(Val(aa:fac),0,0)~", "~FStr(Val(ab:fac),0,0)~", ")
                   SQL.ADD(" '0', ")
                   If Dialogo.Radio1 = 0
                      SQL.ADD(" '1' ")
                   Else
                      SQL.ADD(" '0' ")
                   EndIf
                   SQL.ADD(" ) ")
                   SQL.NEW
                   SQL.EXEC
                   SQL.ActualizarMovimientosT2(Val(XX:1),NO,NO,NO,SI)   
                   SQL.EXEC
                   SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ") 
                   SQL.ADD(" (NrOperacion, NrBit, Valor) ")
                   SQL.ADD(" VALUES ")
                   SQL.ADD(" ('"~Val(XX:1)~"',51, '1') ")
                   SQL.NEW
                   SQL.EXEC
                ELSE
                   DFA
                ENDIF
              Proximo
           ENDIF
* Hasta aca se saco
        ENDIF
      Proximo
#endif 
   Endif
ENDIF

* FJL 22/01/23 - Saco lo de Pendientes para mostrar en Demo
IF NO
ACN(FI:1, fac+1)
ACN(BJ:1, 0)

***---MOVPENDIENTES
SQL.ADD("SELECT M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
SQL.ADD("       M.CallPut,  M.PrecioEj, M.Book, M.FechaEj, M.NrSaldo, SUM(((M.Cantidad*"~Dialogo.Precio1~")/100)) Total, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, O.TipoOp Tipo ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O ")
SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
SQL.ADD("   AND M.NrSaldo      = 1 ")
SQL.ADD("   AND M.Especie      ='"~Dialogo.Especie1~"' ")
SQL.ADD("   AND M.NrOperacion  = O.NrOperacion ")
** FJL 24/05/21 - Cambio de criterio
***---SQL.ADD(" AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD("   AND M.Cliente = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD("   AND (('CLI' = C.CategDepositante AND '"~Dialogo.Vehiculo1~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*SQL.ADD("        OR ('"~Dialogo.Vehiculo1~"' = C.Codigo AND 'HAB' = C.Status )) ")
SQL.ADD("   AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.Cuenta       = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND M.Mercado      = '"~Dialogo.Mercado1~"'")
EndIf

SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD(" GROUP BY M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, C.RazonSocial, M.CallPut, M.FechaEj, M.PrecioEj, M.Book,  M.NrSaldo, ")
SQL.ADD("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, O.TipoOp ")

SQL.ADD(" Union ")

SQL.ADD("SELECT M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, SUM(M.Cantidad) Cantidad, C.RazonSocial, ")
SQL.ADD("       M.CallPut, M.PrecioEj, M.Book, M.FechaEj, M.NrSaldo, SUM(((M.Cantidad*"~Dialogo.Precio1~")/100)) Total, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2 Tipo ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE M.Cliente      = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
SQL.ADD("   AND M.NrSaldo      = "~Fstr(Val(SL:1), 0, 0)~" ")
SQL.ADD("   AND M.Especie      = '"~Dialogo.Especie1~"' ")
SQL.ADD("   AND M.NrOperacion  = T.NrTrans ")
SQL.ADD("   AND (T.TipoTr2 not in ('PDIVID','DTP','RTP') or (CB6 = '0' and  T.TipoTr2 in ('DTP','RTP'))) ")
** FJL 24/05/21 - Cambio de criterio
***---SQL.ADD(" AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD("   AND M.Cliente = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD(" AND (('CLI' = C.CategDepositante AND '"~Dialogo.Vehiculo1~"' = M.EnteCustodia AND 'HAB' = C.Status) ")
*SQL.ADD("       OR ('"~Dialogo.Vehiculo1~"' = C.Codigo AND 'HAB' = C.Status )) ")
SQL.ADD("   AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.Cuenta       = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND M.Mercado      = '"~Dialogo.Mercado1~"'")
EndIf
SQL.ADD("   AND M.FechaMov    <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD(" GROUP BY M.Cliente, M.Especie, M.Mercado, M.Cuenta, M.EnteCustodia, C.RazonSocial, M.CallPut, M.FechaEj, M.PrecioEj, M.Book, M.NrSaldo, ")
SQL.ADD("          C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2  ")

SQL.ADD(" Union ")

SQL.ADD("SELECT T.Cliente1 Cliente, T.Especie, T.Mercado1 Mercado, T.Cuenta1 Cuenta, '' EnteCustodia, T.Cantidad1 Cantidad, C.RazonSocial, ")
SQL.ADD("       '' CallPut, '' PrecioEj, '' Book, '' FechaEj, '101' NrSaldo, ((T.Cantidad1*"~Dialogo.Precio1~")/100) Total, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, T.TipoTr2 Tipo  ")
** FJL 24/05/21 - Cambio de criterio - Depedne de la cuenta
*SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C ")
SQL.ADD("  FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE T.Cliente1     = C.Codigo ")
SQL.ADD("   and C.Status       = 'HAB' ")   
SQL.ADD("   AND T.Especie      = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and T.TipoTr2      in ('DTP','RTP') ")
SQL.ADD("   AND T.CB6          = '1' ")
SQL.ADD("   AND T.CB9          <> 1 ")
** FJL 24/05/21 - Cambio de criterio
*SQL.ADD("   AND T.Cliente1     = '"~Dialogo.Vehiculo1~"'")
*SQL.ADD("   AND (('CLI' = C.CategDepositante AND 'HAB' = C.Status) ")
*SQL.ADD("       OR ('"~Dialogo.Vehiculo1~"' = C.Codigo AND 'HAB' = C.Status )) ")
SQL.ADD("   and T.Cuenta1      = CU.Codigo ")
SQL.ADD("   and CU.Comitente   = '"~Dialogo.Vehiculo1~"' ")

If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" AND T.Mercado1     = '"~Dialogo.Mercado1~"'")
EndIf
SQL.ADD("   AND T.Fecha1      <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
* FJL 25/08/21 - Daba error SQL
*SQL.ADD(" ORDER BY Cliente, Especie, Mercado, Cuenta ")
SQL.ADD(" ORDER BY 1,2,3,4 ")
ACN(Z:3,0)
Recorrer SQL
  ACN(Z:4,SQL(" select 1 from "~DBO~".TRANSACCIONES2 where TipoTr2='PDIVID' and Especie='"~fbn('Especie')~"' and Fecha1='"~IdxDate(Dialogo.Fecha1)~"' and Fecha2='"~IdxDate(Dialogo.Fecha2)~"' and Cuenta1='"~fbn('Cuenta')~"' and Especie2='"~Dialogo.Especie2~"' and Cantidad1="~FStr(fbn('Cantidad'),0,4)~" and RB1='2' and Vehiculo1='"~Dialogo.Vehiculo1~"' "))
  If Val(Z:4)=1
     DFA
  Else
     ACN(BJ:1, 1)
     ACN(A:fac, 1)
     ACT(b:fac, fbn('Mercado'))
     ACT(c:fac, fbn('Cliente'))
     ACT(d:fac, fbn('RazonSocial'))
     ACT(e:fac, fbn('CallPut'))
     ACD(f:fac, fbn('FechaEj'))
     ACN(g:fac, fbn('PrecioEj'))
     If Not EqStr(fbn('Tipo'),'DTP')
        ACN(h:fac, -fbn('Cantidad'))
        ACN(j:fac, -fbn('Total'))
     Else
        ACN(h:fac, fbn('Cantidad'))
        ACN(j:fac, fbn('Total'))
     EndIf
     * ACD(Q:fac, fbn('FechaMov'))
     ACN(i:fac, Dialogo.Precio1)
     ACT(M:fac, fbn('Cuenta'))
     ACT(BK:fac, fbn('Book'))
     ACT(TC:fac, fbn('TipoCliente'))
     ACT(R:fac, Dialogo.Especie2)
     ACN(SD:fac, fbn('NrSaldo'))
     If Dialogo.Radio1 = 0
        * Efvo
*        ACN(j:fac, Val(h:fac)*Val(i:fac)/100)
        ACN(k:fac, 0)
        ACN(l:fac, 0)                                                                                                                                                                                        
        ACN(t:fac, Val(h:fac)*Val(i:fac)/100)
     Else
        * Acciones
*        ACN(j:fac, Val(h:fac)*Val(i:fac)/100 )
        ACN(k:fac, Dialogo.Precio2)
        ACN(ln:fac, (((Val(j:fac)/Val(lm:1)) - (Val(j:fac) DIV Val(lm:1)))*Val(lm:1)))
        ACN(l:fac, Val(ln:fac)*Val(k:fac))
        ACN(j:fac, Val(j:fac)-Val(ln:fac))
        ACN(PR:fac, Dialogo.Precio2*Val(CT:1))
** FJL 19/11/21 - Se agrega monto en Moneda - Base para Comisiones
        ACN(t:fac, Val(j:fac)*Val(ct:2))
     Endif
     ***---Cuenta Moneda
** FJL 24/05/21 - No utilizaba Mercado ni orden para buscar. Le agregue el orden
**                El mercado habria de determinarlo cuando es CV.
*     ACT(N:fac, SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA') "))
     ACT(N:fac, SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
     ACN(Z:3,1)

     if Not EqStr(Val(c:fac),Dialogo.Vehiculo1) y Val(t:fac)>0
       If Dialogo.Radio1 = 0
         * Efvo
         ACT(ae:fac, 'DIVEFE')
       else
         * Acciones
         ACT(ae:fac, 'DIVACC')
       endif
       ACN(ag:fac, COTIZACIONC(val(r:fac),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))     
       ACN(ah:fac, iif(EqStr(Modo(val(r:fac),VAR('MONELOCA')),'INV'),1/val(ag:fac),val(ag:fac)))
       
       ACN(af:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),4,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))
       ACN(aa:fac, MontoArancelC(,Val(c:fac),Dialogo.Especie1,Dialogo.Vehiculo1,Val(ae:fac),VAL(t:fac)*iif(Eqstr(VAR('LIQCOMMO'),'SI'),1,Val(ah:fac)),0,,,,'PDIVID',Val(b:fac),,,SI,SI,,SI))

       * Cond IVA
       ACT(ac:fac, BuscarCampo('CLIENTES','CondicionIVA','Codigo',Dialogo.Vehiculo1))
       * tasa iva  
** FJL 17/03/25 - BIND Issue 7163 - No usar IVA General
*       ACN(ad:fac, MontoImpuesto('IVARGCOM',Dialogo.Fecha1,3,Val(ac:fac))/100)
       ACN(ad:fac, MontoImpuesto('IVACOMECA',Dialogo.Fecha1,3,Val(ac:fac))/100)

       * IVA
       ACN(ab:fac, Val(aa:fac)*Val(ad:fac))
     else
       ACN(aa:fac, 0)
       ACN(ab:fac, 0)
     endif  
  EndIf
Proximo

If Val(Z:1)=0 y Val(Z:3)=0
   MessageBox('No hay Saldos ni Movimientos Pendientes para los datos ingresados')
Else
   If Val(Z:1)=0 y Val(Z:3)=1
      MessageBox('No hay Saldos para los datos ingresados')
   Else
      If Val(Z:1)=1 y Val(Z:3)=0
         MessageBox('No hay Movimientos Pendientes para los datos ingresados')
      EndIf
   EndIf
EndIf

