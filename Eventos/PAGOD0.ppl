        'Cta.Especie'   ;m:Val(FI:1)..m:Val(fi:2);NO;;;100;STRING;;RGB(220,220,193)
        'Cta.Moneda'    ;n:Val(FI:1)..n:Val(fi:2);SI;Val(A:FLB)=0 o Incluido(Val(N:FLB), SQLSet(" Select Codigo From "~DBO~".CUENTAS Where Cliente='"~Val(C:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Dialogo.Especie2~"%' OR Especies LIKE '%MONEDA%')"));'Cuenta Moneda Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';" Cliente = '"~Val(C:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','VIS') AND (Especies Like '%MONEDA%' or Especies Like '%"~Dialogo.Especie2~"%')";RGB(255,255,193);
        'Comision'      ;aa:Val(FI:1)..aa:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'IVA Com'       ;ab:Val(FI:1)..ab:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        ** FJL 23/8/22 - Se agrgan Comisiones CV
        'Comision CV'   ;ba:Val(FI:1)..ba:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'IVA Com CV'    ;bb:Val(FI:1)..bb:Val(fi:2);NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'Estado'        ;x:Val(FI:1)..x:Val(fi:2);NO;;;100;STRING;;RGB(220,220,193)
        #ifdef PRUEBA
          'NrSaldo'       ;u:Val(FI:1)..u:Val(fi:2);NO;;;80;NUMERO;'###';RGB(220,220,193)
