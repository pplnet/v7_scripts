        'Saldo'         ;h:Val(FI:1)..h:Val(fi:2);NO;;;100;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        '%'             ;i:Val(FI:1)..i:Val(fi:2);NO;;;100;NUMERO;'###,###.#####';RGB(220,220,193)
        'Total Acciones';j:Val(FI:1)..j:Val(fi:2);NO;;;100;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'Pre.Fracc.'    ;k:Val(FI:1)..k:Val(fi:2);NO;;;100;NUMERO;'###.########';RGB(220,220,193)
        'Tot.Fracc.'    ;l:Val(FI:1)..l:Val(fi:2);NO;;;100;NUMERO;'#,###,###,###.##';RGB(220,220,193)
        'Moneda'        ;r:Val(FI:1)..r:Val(fi:2);NO;;;60;STRING;;RGB(220,220,193)
