CrearDialogo
  String1     :'Tabla'
  Entero1     :'NrBit'
  NrOperacion1:'Operacion'
FinDialogo

If Not Ok
   Cancelar
EndIf

SQL.ADD(" Select NrInstancia From "~DBO~".INSTANCIAS ")
SQL.ADD(" Where Tabla = '"~Dialogo.String1~"' ")
Recorrer SQL
  IF SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit = "~Fstr(fbn('NrInstancia'), 0, 0)~" ") <> 1
     ***---No existe Instancia => la inserto
     SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS ")
     SQL.ADD(" (NrOperacion, NrBit, Valor) ")
     SQL.ADD(" Values ")
     SQL.ADD(" ('"~Dialogo.NrOperacion1~"', "~Fstr(fbn('NrInstancia'), 0, 0)~", '0') ")
     SQL.NEW
  ENDIF
Proximo
SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Set Valor = '1' ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND NrBit = "~Fstr(Dialogo.Entero1, 0, 0)~" ")
SQL.NEW
SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Set Valor = '0' ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND NrBit <> "~Fstr(Dialogo.Entero1, 0, 0)~" ")
SQL.NEW
SQL.EXEC
