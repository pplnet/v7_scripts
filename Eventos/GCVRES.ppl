*** GCVRES. Generacion de Compras Ventas para REPO 
CrearDialogo
  NrOperacion1 : "Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'SERA|SERAV|SERP|SERPV')
   Cancelar('La operacion N? '~Dialogo.NrOperacion1~' No es un Repo')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   Message(' --- Generando Compra/Venta ...')

   * Toma la operacion verificando que no se hayan generado las compras/ventas
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and (RB1='0' or RB1 IS NULL) ")

   ACN(A1,0)

   Recorrer SQL

     ACN(A1,1)

     *** Determina los tipos de operacion a utilizar ***
     *** Z1 operacion contado, z2 operacion futuro ****    

     ** SERA :SEVS y SECT
     If EqStr(FBN['TipoOp'],'SERA') 
        ACT(z1,'SEVS')        
        ACT(z2,'SECT')        
     endif

     ** SERP 
     If EqStr(FBN['TipoOp'],'SERP') 
        ACT(z1,'SECS')        
        ACT(z2,'SEVT')        
     endif

     ** SERAV: SEVSV y SECTV
     If EqStr(FBN['TipoOp'],'SERAV') 
        ACT(z1,'SEVSV')        
        ACT(z2,'SECTV')        
     endif

     ** SERPV: SECSV y SEVTV
     If EqStr(FBN['TipoOp'],'SERPV') 
        ACT(z1,'SECSV')        
        ACT(z2,'SEVTV')        
     endif

     *** Z4: TipoCambio => Tasa
     ACN(Z4,IIF(DESCIENDEDEESPECIE(FBN['Especie'],'LETES'),(1-FBN['Precio1'])*36000/(FechaMaduracion(FBN['Especie'])-FBN['FechaVto']),0))

     *** Z3 Nro. Operacion Contado
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     Message(' ---- Generando Operacion Contado  ...')     

     *---- Operacion Contado
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, ")
     SQL.ADD(" Cliente1, FechaOp2, ")
     SQL.ADD(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
     SQL.ADD(" RB5,RB6,")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" Observac2, OperacionRef, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6, ")
     SQL.ADD(" Especie, ContraEspecie, Cantidad, ") 
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, ")
     SQL.ADD(" TablaFeriados1, TablaFeriados2, Precio1, ")
     SQL.ADD(" FormaLiquidacion1,TipoCambio,Mercado, ")
     SQL.ADD(" ContraEspecie3,PorComMer1,TCComMer1, ")
     SQL.ADD(" ImpComMer1,ImpComMerEq1,Corredor, ")
     SQL.ADD(" ContraEspecie2,PorComCor1,TCComCor1, ")
     SQL.ADD(" ImpComCor1,ImpComCorEq1,RB7, ")
     SQL.ADD(" Cupon1,TasaInteresesCupon,FechaUltCupon, ")
     SQL.ADD(" TipoCambio2,Cotizacion2,ImpGastos1,TotalIntereses,PaseCB,RB3 ) ")
     SQL.ADD(" Values" )
     SQL.ADD("( '"~Val(z1)~"', '"~Val(z3)~"',")
     SQL.ADD(" '"~FBN['Cliente1']~"', '"~IdxDate(FBN['FechaOp2'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaVto'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaPago'])~"', "~Fstr(FBN['Plazo'],2,0)~", "~Fstr(FBN['Plazo2'],2,0)~", ")
     SQL.ADD(" '"~FBN['RB5']~"', '"~FBN['RB6']~"', ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', ")
     SQL.ADD(" "~Fstr(FBN['Precio4'],0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', ")
     SQL.ADD(" '"~FBN['MB4']~"', '"~FBN['RB10']~"', '"~FBN['CB6']~"',")
     SQL.ADD(" '"~FBN['Especie']~"', '"~FBN['ContraEspecie']~"', "~Fstr(FBN['Cantidad'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['TotalBrutoCli1'],0,4)~", "~Fstr(FBN['TotalNetoCli1'],0,4)~", ")
     SQL.ADD(" '"~FBN['TablaFeriados1']~"', '"~FBN['TablaFeriados2']~"', "~Fstr(FBN['Precio1'],0,7)~", ")
     SQL.ADD(" '"~FBN['FormaLiquidacion1']~"',"~Fstr(VAL(Z4),0,4)~" ,'"~FBN['Mercado']~"', ")
     SQL.ADD(" '"~FBN['ContraEspecie3']~"',"~Fstr(FBN['PorComMer1'],0,4)~","~Fstr(FBN['TCComMer1'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['ImpComMer1'],0,4)~","~Fstr(FBN['ImpComMerEq1'],0,4)~",'"~FBN['Corredor']~"', ")
     SQL.ADD(" '"~FBN['ContraEspecie2']~"',"~Fstr(FBN['PorComCor1'],0,4)~","~Fstr(FBN['TCComCor1'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['ImpComCor1'],0,4)~","~Fstr(FBN['ImpComCorEq1'],0,4)~",'"~FBN['RB7']~"', ")
     SQL.ADD(" '"~Fstr(FBN['Cupon1'],0,0)~"',"~Fstr(FBN['TasaInteresesCupon'],0,7)~", '"~IdxDate(FBN['FechaUltCupon'])~"', ")
     SQL.ADD(" "~Fstr(FBN['TipoCambio2'],0,7)~", ")
     SQL.ADD(" "~Fstr(FBN['Cotizacion2'],0,7)~","~Fstr(FBN['ImpGastos1'],0,4)~","~Fstr(FBN['TotalIntereses'],0,4)~",'1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (.'ALTAINSTER'.)

     *** Z3 Nro. Operacion Futuro
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     *** Z4: TipoCambio => Tasa
     ACN(Z4,IIF(DESCIENDEDEESPECIE(FBN['Especie'],'LETES'),(1-FBN['Precio1'])*36000/(FechaMaduracion(FBN['Especie'])-FBN['FechaVto2']),0))

     Message(' ---- Generando Operacion Futuro  ...')       
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, ")
     SQL.ADD(" Cliente1, FechaOp2, ")
     SQL.ADD(" FechaOp, FechaVto, ")
     SQL.ADD(" FechaPago, Plazo, Plazo2, ")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" Observac2, OperacionRef, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6, ")
     SQL.ADD(" Especie, ContraEspecie, Cantidad, ") 
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, ")
     SQL.ADD(" TablaFeriados1, TablaFeriados2, Precio1, ")
     SQL.ADD(" FormaLiquidacion1,TipoCambio,Mercado, ")
     SQL.ADD(" ContraEspecie3,PorComMer1,TCComMer1, ")
     SQL.ADD(" ImpComMer1,ImpComMerEq1,Corredor, ")
     SQL.ADD(" ContraEspecie2,PorComCor1,TCComCor1, ")
     SQL.ADD(" ImpComCor1,ImpComCorEq1,RB7, ")
     SQL.ADD(" Cupon1,TasaInteresesCupon,FechaUltCupon, ")
     SQL.ADD(" TipoCambio2,Cotizacion2,ImpGastos1,TotalIntereses,PaseCB,RB3 ) ")
     SQL.ADD(" Values" )
     SQL.ADD("( '"~Val(z2)~"', '"~Val(z3)~"',")
     SQL.ADD(" '"~FBN['Cliente1']~"', '"~IdxDate(FBN['FechaOp2'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaVto2'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaEj'])~"', "~Fstr(FBN['Plazo3'],2,0)~", "~Fstr(FBN['Plazo4'],2,0)~", ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', ")
     SQL.ADD(" "~Fstr(FBN['Precio4'],0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', ")
     SQL.ADD(" '"~FBN['MB4']~"', '"~FBN['RB10']~"', '"~FBN['CB6']~"',")
     SQL.ADD(" '"~FBN['Especie']~"', '"~FBN['ContraEspecie']~"', "~Fstr(FBN['Cantidad'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['TotalBrutoCli2'],0,4)~", "~Fstr(FBN['TotalNetoCli2'],0,4)~", ")
     SQL.ADD(" '"~FBN['TablaFeriados1']~"', '"~FBN['TablaFeriados2']~"', "~Fstr(FBN['Precio2'],0,7)~", ")
     SQL.ADD(" '"~FBN['FormaLiquidacion1']~"',"~Fstr(VAL(Z4),0,4)~" ,'"~FBN['Mercado2']~"', ")
     SQL.ADD(" '"~FBN['ContraEspecie4']~"',"~Fstr(FBN['PorComMer2'],0,4)~","~Fstr(FBN['TCComMer2'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['ImpComMer2'],0,4)~","~Fstr(FBN['ImpComMerEq2'],0,4)~",'"~FBN['Corredor2']~"', ")
     SQL.ADD(" '"~FBN['ContraEspecie5']~"',"~Fstr(FBN['PorComCor2'],0,4)~","~Fstr(FBN['TCComCor2'],0,4)~", ")
     SQL.ADD(" "~Fstr(FBN['ImpComCor2'],0,4)~","~Fstr(FBN['ImpComCorEq2'],0,4)~",'"~FBN['MB1']~"', ")
     SQL.ADD(" '"~Fstr(FBN['Cupon1'],0,0)~"',"~Fstr(FBN['TasaBase'],0,7)~", '"~IdxDate(FBN['FechaUltCupon'])~"', ")
     SQL.ADD(" "~Fstr(FBN['Comision'],0,7)~","~Fstr(FBN['TipoCambio'],0,0)~",")
     SQL.ADD(" "~Fstr(FBN['ImpGastos2'],0,4)~","~Fstr(FBN['TotalDerechos'],0,4)~",'1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (.'ALTAINSTER'.)

     *** Marco la Operacion de Repo como Generada Indicador RB1
     SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET RB1 = '1' ")
     SQL.ADD(" Where (NrOperacion = '"~FBN['NrOperacion']~"')  ")
     SQL.NEW    
     SQL.EXEC
   proximo

   IF VAL(A1)=0
      MessageBox('Se han generado con anterioridad las Operaciones de Compra y Venta para esta Operacion !!!')
   ENDIF
endif