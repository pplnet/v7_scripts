CrearDialogo
  Cliente1 : 'Cliente'
  Especie1 : 'Especie'
  Fecha1   : 'Fecha'   ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha de Ejercicio Incorrecta';NO;;FSys
FinDialogo

MostrarCuadroDeMensajes

If Not OK
   Cancelar
EndIf

** QUERY OPERACIONES A PROCESAR **
SQL.ADD("SELECT OP.NrOperacion, '' AS Liquid, OP.Cliente1, OP.Especie, OP.ContraEspecie, OP.TipoOp, ")
SQL.ADD(" OP.Cantidad, OP.PrecioEj, OP.Plazo, OP.FechaOp, OP.FechaVto, OP.FechaEj, OP.FechaPago, OP.Precio1, OP.Vehiculo1, OP.Mercado ")
*-i
*SQL.ADD(" FROM "~DBO~".OPERACIONES OP,  "~DBO~".MOVEJECUTADOS ME WHERE ")
SQL.ADD(" FROM "~DBO~".OPERACIONES OP LEFT OUTER JOIN  "~DBO~".MOVEJECUTADOS ME ON OP.NrOperacion = ME.NrOperacion WHERE ")
*SQL.ADD(" OP.NrOperacion *= ME.NrOperacion AND ME.Leyenda like '%Prima%' AND ME.NrSaldo=1 AND ")
SQL.ADD(" ME.Leyenda like '%Prima%' AND ME.NrSaldo=1 AND ")
*-f
** SQL.ADD(" OP.NrOperacion IN ('T0006811','PM000068') ")
SQL.ADD(" OP.TipoOp in ('OCC','OVC','OCP','OVP')")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND OP.Especie = '"~Dialogo.Especie1~"'")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND OP.Cliente1 = '"~Dialogo.Cliente1~"'")
EndIf
SQL.ADD(" AND (OP.CB5 = '0' or OP.CB5 is NULL)")
SQL.ADD(" AND ((OP.FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' AND OP.TipoOpcion='0') or (OP.FechaEj='"~IdxDate(Dialogo.Fecha1)~"'))")
SQL.ADD(" ORDER BY OP.Cliente1, OP.Especie, OP.TipoOp")
ACN(s1, 0)
Recorrer SQL
  ACN(a:fac,1)
  ACT(b:fac, fbn('Cliente1'))
  ACT(c:fac, fbn('Especie'))
  ACT(d:fac, fbn('TipoOp'))
  ACN(e:fac, fbn('Cantidad'))
  ACN(f:fac, fbn('PrecioEj'))
  ACN(g:fac, fbn('Plazo'))
  ACT(h:fac, fbn('FechaOp'))
  ACT(i:fac, fbn('FechaEj'))
  ACT(j:fac, fbn('NrOperacion'))
  ACT(k:fac, IIF(EqStr(fbn['Liquid'],''),'NO','SI'))
  ACN(l:fac, fbn['Precio1'])
  ACT(m:fac, fbn('ContraEspecie'))
  ACT(n:fac, fbn('Vehiculo1'))
  ACT(o:fac, fbn('FechaVto'))
  ACT(p:fac, fbn('Mercado'))
  ACN(q:fac, 0)
  ACT(r:fac, '')
  ACT(t:fac, '')
  SCN(s1, 1)
Proximo
If Val(s1) > 0
   CrearListBox; 'MS Sans Serif,8,'
     'Marca'         ;a1..a:val(s1);SI;;;60 ;CHECK  ;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
     'Cliente'       ;b1..b:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Especie'       ;c1..c:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'TipoOp'        ;d1..d:val(s1);NO;;;50 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Cantidad'      ;e1..e:val(s1);NO;;;120;NUMERO;'##,###,###.##';RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'PrecioEj'      ;f1..f:val(s1);NO;;;120;NUMERO;'##,###,###.#######';RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Plazo'         ;g1..g:val(s1);NO;;;40 ;NUMERO;'###';RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'FechaOp'       ;h1..h:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'FechaEj'       ;i1..i:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Operacion'     ;j1..j:val(s1);NO;;;60 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Liquid'        ;k1..k:val(s1);NO;;;50 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Precio1'       ;l1..l:val(s1);NO;;;120;NUMERO;'##,###,###.#######';RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'ContraEspecie' ;m1..m:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Vehiculo'      ;n1..n:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'FechaVto'      ;o1..o:val(s1);NO;;;80 ;STRING;;RGB(200,200,193); ; NO;NO;;NO;NO;NO;
     'Mercado'       ;p1..p:val(s1);SI;;;80 ;TABLA;'MERCADOS';'Codigo';'Codigo;Descripcion;Observaciones';;RGB(250,250,193);
     'FormaLiquid.'  ;q1..q:val(s1);SI;;;80 ;COMBO;'STD|DVP|RVP|';RGB(250,250,193);
*     'CuentaEspecie' ;r1..r:val(s1);SI;;;80 ;TABLA;'CUENTAS';'Codigo';'Codigo;Nombre';IIF(NoVacio(Val(p:FLB)),IIF(NOT EqStr(Val(p:FLB), Var('MERCARGC')),"Estado='HAB' AND TipoCuenta IN ('CUS','CCO') AND Cliente='"~Val(b:FLB)~"' AND Mercado='"~Val(p:FLB)~"' ","Estado='HAB' AND TipoCuenta IN ('CUS','CCO') AND Cliente='"~Val(n:FLB)~"' AND Mercado='"~Val(p:FLB)~"' "),"Estado='HAB' AND TipoCuenta IN ('CUS','CCO')");RGB(250,250,193);
     'CuentaEspecie' ;r1..r:val(s1);SI;;;80 ;TABLA;'CUENTAS';'Codigo';'Codigo;Nombre';" Cliente='"~IIF(EqStr(Val(p:FLB),VAR('MERCARGC')),VAL(n:FLB),VAL(b:FLB))~"' And (Especies='"~Val(c:FLB)~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' And TipoCuenta in ('CUS', 'CCO') And Mercado='"~Val(p:FLB)~"' ";RGB(250,250,193);
*     'CuentaContEsp' ;t1..t:val(s1);SI;;;80 ;TABLA;'CUENTAS';'Codigo';'Codigo;Nombre';IIF(Val(q:FLB)=2,"(Estado='HAB' AND TipoCuenta IN ('CC','CA') AND Cliente='"~Val(b:FLB)~"' AND Mercado='"~Val(p:FLB)~"' AND (Especies LIKE '%MONEDA%' OR Especies LIKE '%"~Val(c:FLB)~"%')) OR Codigo='"~VAR('CTAMOD23')~"' ","Estado='HAB' AND TipoCuenta IN ('CC','CA') AND Cliente='"~Var('CLIARGC')~"' AND (Mercado='"~Var('MERCBCRA')~"' OR Mercado='"~Var('MERSWIFT')~"' ) AND (Especies LIKE '%MONEDA%' OR Especies LIKE '%"~Val(c:FLB)~"%') ");RGB(250,250,193);
     'CuentaContEsp' ;t1..t:val(s1);SI;;;80 ;TABLA;'CUENTAS';'Codigo';'Codigo;Nombre';" Cliente='"~IIF(EqStr(Val(p:FLB),VAR('MERCARGC')),VAR('CLIARGC'),VAL(b:FLB))~"' And (Especies Like '%MONEDA%' or Especies Like '%"~VAL(m:FLB)~"%') And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') And "~IIF(Not Incluido(Val(p:FLB),VAR('MERCARGC'))," Mercado='"~BuscarCampo('OPERACIONES','Mercado2','NrOperacion',VAL(j:FLB))~"' "," Mercado in ('BCRA','AC','SWIFT') ")~" ";RGB(250,250,193);
   FinListBox
   If OK
      Recorrer&i 1, val(s1)
        If VAL(a:&i) = 1
           Message("Procesando Opcion "~VAL(j:&i))
           **--TIPO OPERACIONES
           If DesciendeDeEspecie(Val(c:&i),'MONEDA')
              ACT(z1,GetNumerador(35))
              If DesciendeDeEspecie(Val(c:&i),'MROFEX')
                 If Incluido(Val(d:&i),'OCC|OCP')
                    ACT(z2,'FXCT')
                 Else
                    ACT(z2,'FXVT')
                 EndIf
              Else
                 If Incluido(Val(d:&i),'OCC|OCP')
                    ACT(z2,'FXC')
                 Else
                    ACT(z2,'FXV')
                 EndIf
              EndIf
           Else
              If DesciendeDeEspecie(Val(c:&i),'COMMOD')
                 ACT(z1,GetNumerador(80))
                 If Incluido(Val(d:&i),'OCC|OCP')
                    ACT(z2,'COMMC')
                 Else
                    ACT(z2,'COMMV')
                 EndIf
              Else
                 If DesciendeDeEspecie(Val(c:&i),'ACCION')
                    ACT(z1,GetNumerador(1))
                    If Incluido(Val(d:&i),'OCC|OCP')
                       ACT(z2,'EQC')
                    Else
                       ACT(z2,'EQV')
                    EndIf
                 Else
                    ACT(z1,GetNumerador(1))
                    If Incluido(Val(d:&i),'OCC|OCP')
                       ACT(z2,'TIC')
                    Else
                       ACT(z2,'TIV')
                    EndIf
                 EndIf
              EndIf
           EndIf
           **--FECHAS
           ACD(z3,Fecha(Val(h:&i)))
           ACD(z4,Fecha(Val(i:&i)))
           ACD(z5,Fecha(Val(o:&i)))
           ACD(z6,Fecha(BuscarCampo('ESPECIES','Fecha','Codigo',VAL(c:&i))))
           ACD(z39,HABILES(Val(z6),-2, 'ARG',SI))
           
           ACT(z7,BuscarCampo('ESPECIES','MercadoDef','Codigo',VAL(m:&i)))
           ACT(z8,BuscarCampo('OPERACIONES','Book1','NrOperacion',VAL(j:&i)))
           
           If EqStr(BuscarCampo('CLIENTES','CategDepositante','Codigo',VAL(b:&i)),'CLI')
              ACN(ZZ:1,1)
           Else
              ACN(ZZ:1,0)
           EndIf
           If Val(ZZ:1)=0
              ACT(z9,CuentaCliente(VAL(n:&i),VAL(m:&i),,VAL(z7),Val(z2),'HAB'))
              ACT(z10,CuentaCliente(VAL(b:&i),VAL(c:&i),,VAL(p:&i),Val(z2),'HAB'))
           EndIf
           
           ACN(z11,COTIZACIONC(VAL(c:&i),,,,Val(z3),1,SI,'USD'))
           ACN(z12,COTIZACIONC(VAL(c:&i),,,,Val(z3),1,SI,'ARP'))
           If Incluido(VAL(c:&i),'USD|USB|GBP|EUR')
              ACN(z13,Val(z12))
           Else
              ACN(z13,1/Val(z12))
           EndIf
           If EqStr(Modo(VAL(c:&i), 'USD'),'INV')
              ACN(z14,1/Val(z11))
           Else
              ACN(z14,Val(z11))
           EndIf
           If EqStr(Modo(VAL(m:&i), 'USD'),'INV')
              ACN(z15,VAL(l:&i)/Val(z11))
           Else
              ACN(z15,Val(z11)/VAL(l:&i))
           EndIf
           
           ACT(z16,BuscarCampo('ESPECIES','CodMAEContado','Codigo',VAL(c:&i)))
           
           If Vacio(BuscarCampo('ESPECIES','PlazoLiq','Codigo',VAL(c:&i)))
              If Incluido(Val(z2),'TIC|TIV')
                 ACN(z17,72)
              Else
                 ACN(z17,0)
              EndIf
           Else
              ACN(z17,BuscarCampo('ESPECIES','PlazoLiq','Codigo',VAL(c:&i)))
           EndIf
           
           ACD(z18,HABILES(VAL(z3),(Val(z17)/24),'ARG',SI))
           ACT(z19,COTIZAEN(VAL(c:&i)))
           
           If Caracteristica(VAL(b:&i),'CE')
              ACT(z20,'CE')
           Else
              If Caracteristica(VAL(b:&i),'CV')
                 ACT(z20,'CV')
              Else
                 ACT(z20,BuscarCampo('ESPECIES','MercadoDef','Codigo',VAL(c:&i)))
              EndIf
           EndIf
           
           If Incluido(Val(z20),'CRYL|CE|EU|AC')
              ACT(z21,'1')
           Else
              ACT(z21,'0')
           EndIf
           
           If Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',VAL(c:&i)),'CLE')
              ACN(z22,VAL(f:&i)*VAL(e:&i)*ValorTeorico2(VAL(c:&i),VAL(z18)))
           Else
              ACN(z22,VAL(f:&i)*VAL(e:&i))
           EndIf
           
           If Not EqStr(VAL(z20),'CV') Y VAL(z21)<2
              ACT(z23,VAL(z20))
           Else
              ACT(z23,BuscarCampo('ESPECIES','MercadoDef','Codigo',VAL(z19)))
           EndIf
           
           ACT(z24,SQL("Select CodOperador from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~VAL(b:&i)~"' and Estado='DEF'"))
           
           If EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',VAL(c:&i)),'SIG')
              ACN(z25,1)
           Else
              If EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',VAL(c:&i)),'ANT')
                 ACN(z25,-1)
              Else
                 ACN(z25,0)
              EndIf
           EndIf
           
           If EsHabil(UltCupon2(VAL(c:&i),VAL(z18)),'USA')
              ACD(z26,UltCupon2(VAL(c:&i),VAL(z18)))
           Else
              ACD(z26,Habiles(UltCupon2(VAL(c:&i),VAL(z18)),Val(z25),'USA'))
           EndIf
           
           ACN(z27,NrCupon2(VAL(c:&i),VAL(z18)))
           
           IF Incluido(Val(z2),'TIC|TIV')
              ACT(ES:1,'TITULO')
           Else
              IF Incluido(Val(z2),'EQC|EQV')
                 ACT(ES:1,'ACCION')
              EndIf
           EndIf
           
           SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
           SQL.ADD ("  Where Cliente='"~IIF(EqStr(VAL(z20),VAR('MERCARGC')),VAL(n:&i),VAL(b:&i))~"' ")
           SQL.ADD ("    And (Especies='"~Val(c:&I)~"' OR Especies LIKE '%"~Val(ES:1)~"%') AND Estado='HAB' ")
           SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And Mercado='"~VAL(z20)~"' ")
           SQL.ADD (" Order by Codigo ASC ")
           Recorrer SQL
             ACT(z28,FBN['Codigo'])
           Proximo
           
           If EqStr(VAL(z20),VAR('MERCARGC'))
              ACT(z29,Val(z28))
           Else
              ACT(z29,CuentaCliente(VAL(n:&i),VAL(c:&i),,VAL(z20),Val(z2),'HAB'))
           EndIf
           
           SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
           SQL.ADD ("  Where Cliente='"~IIF(EqStr(VAL(z20),VAR('MERCARGC')),VAR('CLIARGC'),VAL(b:&i))~"' ")
           SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~VAL(z19)~"%') ")
           SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
           SQL.ADD ("    And  "~IIF(Not Incluido(VAL(z20),VAR('MERCARGC'))," Mercado='"~VAL(z23)~"' "," Mercado in ('BCRA','AC','SWIFT') ")~" ")
           Recorrer SQL
             ACT(z31,FBN['Codigo'])
           Proximo
           
           If EqStr(VAL(z20),VAR('MERCARGC'))
              ACT(z30,Val(z31))
           Else
              ACT(z30,CuentaCliente(VAL(n:&i),VAL(z19),,VAL(z23),Val(z2),'HAB'))
           EndIf
           
           ACN(z32,CotizacionC(VAL(z19),,,,VAL(z3),1,SI,VAR('MONEEXTR')))
           ACN(z33,CotizacionC(VAL(z19),,,,VAL(z3),1,SI,VAR('MONELOCA')))
           
           If EqStr(Modo(VAL(z19),VAR('MONEEXTR')),'INV')
              ACN(z34,1/Val(z32))
           Else
              ACN(z34,Val(z32))
           EndIf
           
           If EqStr(Modo(VAL(z19),VAR('MONELOCA')),'INV')
              ACN(z35,1/Val(z33))
           Else
              ACN(z35,Val(z33))
           EndIf
           
           If EqStr(Modo(VAL(z19), BuscarCampo('ESPECIES','MonedaEmision','Codigo',VAL(c:&i))),'INV')
              ACN(z36,1/CotizacionC(VAL(z19),,,,VAL(z3),1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',VAL(c:&i))))
           Else
              ACN(z36,CotizacionC(VAL(z19),,,,VAL(z3),1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',VAL(c:&i))))
           EndIf
           
           ACN(z37,CotizacionC(VAR('MONEEXTR'),,,,VAL(z3),1,SI,VAR('MONELOCA')))
           
           ACN(z38,(VAL(e:&i)*VAL(f:&i)) * CotizacionC(VAL(z19),,,,FSYS,1,SI,VAR('MONEEXTR')))
           
           If EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',VAL(c:&i)),'CLE')
              ACN(w1,IntsCapitalizados2(VAL(c:&i),VAL(z18)))
           Else
              ACN(w1,0)
           EndIf
           ACN(w2,VAL(e:&i)*ValorTeorico2(VAL(c:&i),VAL(z18))*(1+IntsCapitalizados2(VAL(c:&i),VAL(z18))))
           ACD(w3,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',VAL(c:&i)))
           ACD(w4,UltCupon2(VAL(c:&i),VAL(z18)))
           ACN(w5,EspecieDiasMes(VAL(c:&i)))
           If Val(w5)=0 o EsHabil(Val(w4),'USA')
              ACD(w6,Val(w4))
           Else
              ACD(w6,Habiles(Val(w4),BuscarCampo('ESPECIES','Valor10','Codigo',VAL(c:&i)),'USA'))
           EndIf
           ACN(w7,EspecieDiasAnio(VAL(c:&i)))
           ACN(w8,BuscarCampo('ESPECIES','TasaIntVigente','Codigo',VAL(c:&i)))
           ACN(w9,Val(w8)*100)

           If Val(w7)=0 y Val(w5)=0
              ACN(w10,1)
           Else
              ACN(w10,0)
           EndIf

           If Val(w10)=1
              ACN(w11,Dif360(Val(w3)-1,VAL(z18),2))
           Else
              ACN(w11,DifDias(Val(w3)-1,VAL(z18),'USA',NO))
           EndIf
           
           If Val(w10)=1
              ACN(w12,Dif360(Val(w6),Val(w3)-1,2))
           Else
              ACN(w12,DifDias(Val(w6),Val(w3)-1,'USA',NO))
           EndIf
           
           If Val(w10)=1
              ACN(w13,Dif360(Val(w6),VAL(z18),2))
           Else
              ACN(w13,DifDias(Val(w6),VAL(z18),'USA',NO)*100)
           EndIf

           ACN(w14,((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',VAL(c:&i))*Val(w12))+(Val(w8)*Val(w11)))/Val(w13))
           
           If Val(w3)>Val(w6) y Val(w3)<=VAL(z18)
              ACN(w15,Val(w14))
           Else
              ACN(w15,Val(w9))
           EndIf
           
           ACT(w16,BuscarCampo('ESPECIES','MonedaEmision','Codigo',VAL(c:&i)))
           ACN(w17,COTIZACIONC(Val(w16),,,,VAL(z3),1,SI,VAL(z19)))
           
           If Val(w10)=1
              ACN(w18,Dif360(Val(w6),VAL(z18),2))
           Else
              ACN(w18,DifDias(Val(w6),VAL(z18),'USA',NO))
           EndIf
           
           If Not Eqstr(Val(w16),VAL(z19))
              ACN(w19,Val(w17))
           Else
              ACN(w19,1)
           EndIf

           ACN(w20,Val(w15)*Val(w18)/(DiasAnio2(VAL(c:&i),UltCupon2(VAL(c:&i),VAL(z3)),ProxCupon2(VAL(c:&i),VAL(z3)))*100)*Val(w19))
           ACN(w21,SQL(" SELECT TasaCapInt FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~VAL(c:&i)~"' AND NrCupon= '"~VAL(z27)~"' "))

           If Val(w10)=1
              ACN(w22,Dif360(Val(w6),VAL(z18),2))
           Else
              ACN(w22,DifDias(Val(w6),VAL(z18),'USA',NO))
           EndIf

           ACN(w23,Val(w21)*Val(w22)/(DiasAnio2(VAL(c:&i),UltCupon2(VAL(c:&i),VAL(z3)),ProxCupon2(VAL(c:&i),VAL(z3)))*100))
           ACN(w24,(Val(w2)*Val(w20))+(Val(w2)*Val(w23)*VAL(f:&i)))
           ACT(w25,BuscarCampo('ESPECIES','InteresesC','Codigo',VAL(c:&i)))
           
           If Val(w1)=0
              ACN(w26,1)
           Else
              ACN(w26,(1+IntsCapitalizados2(VAL(c:&i),VAL(z18))))
           EndIf
           
           If EqStr(Val(w25),'CLE')
              ACN(w27,Val(w24)*VAL(f:&i))
           EndIf
           
           If EqStr(Val(w25),'CLE')
              ACN(w28,Val(w24))
           EndIf
           
           If Incluido(BuscarCampo('ESPECIES','Alias4','Codigo',VAL(c:&i)),'1585')
              ACN(w29,(Val(z22)*Val(w26))+Val(w27))
           Else
              ACN(w29,(Val(z22)*Val(w26))+Val(w28))
           EndIf
           
           ACT(X:1,BuscarCampo('ESPECIES','MercadoDef','Codigo',VAL(c:&i)))
           ACT(X:2,BuscarCampo('ESPECIES','MercadoDef','Codigo',VAL(z19)))
           
           ACN(X:3,MontoGastos(Val(z:2),VAL(c:&i),VAL(n:&i),'DMERC',0,4))
           ACN(X:4,MontoArancel(Val(z:2),VAL(c:&i),VAL(n:&i),'AOPER',0,4))
           
           If EqStr(Val(z:2),'EQC')
              ACN(X:5,(VAL(e:&i)*VAL(f:&i) + ((VAL(e:&i)*VAL(f:&i)*Val(X:3))/100) + ((VAL(e:&i)*VAL(f:&i)*Val(X:4))/100)))
           Else
              ACN(X:5,(VAL(e:&i)*VAL(f:&i) - ((VAL(e:&i)*VAL(f:&i)*Val(X:3))/100) - ((VAL(e:&i)*VAL(f:&i)*Val(X:4))/100)))
           EndIf
           
           ACN(X:6,COTIZACIONC(VAL(c:&i),,,,VAL(z3),1,SI,VAL(z19)))
           
           ACN(X:7,VAL(X:5) * CotizacionC(VAL(z19),,,,FSYS,1,SI,VAR('MONEEXTR')))
           
           **--GENERA OPERACIONES
           If Incluido(Val(z2),'FXCT|FXVT')
              SQL.ADD(" INSERT INTO "~DBO~".OPERACIONES ")
              SQL.ADD("  (NrOperacion, TipoOp, Cliente1, Especie, Cantidad, ")
              SQL.ADD("  Precio1, TotalBrutoCli1, FechaOp, FechaVto, FormaLiquidacion1, ")
              SQL.ADD("  ContraEspecie, RB10, RB6, FechaVto2, Vehiculo1, Operador, ")
              SQL.ADD("  Mercado, Mercado2, Book1, TablaFeriados1, Cuenta1, Cuenta2, Cuenta3, ")
              SQL.ADD("  Cuenta4, FechaPago, FechaCarga, FechaCargaSys, UsrInput, Arbitraje, PaseCB) ")
              SQL.ADD(" VALUES ")
