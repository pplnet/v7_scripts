CrearDialogo
  Operador1     : "Origen"       ;;;;;;Dialogo.Radio4=1 o NoVacio(Dialogo.Operador1);'ALGUN OPERADOR VACIO U OPERADORES IGUALES';NO;;;SQLSET("Select Codigo from "~DBO~".USUARIOS ")
  Operador2     : "Destinatario"       ;;;;;;Dialogo.Radio4=1 o [NoVacio(Dialogo.Operador2) y Not EqStr(Dialogo.Operador1,Dialogo.Operador2)];'ALGUN OPERADOR VACIO U OPERADORES IGUALES';NO;;;SQLSET("Select Codigo from "~DBO~".USUARIOS ")
  Radio1        : "Modifica?|Si|No"    ;4;;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;1;
  Radio2        : "Ver Actual?|Si|No"   ;4;2;;Dialogo.Radio1=1;Dialogo.Radio1=1;;;;0;
  Radio4       : "Confirma?|Si|No"     ;6;1;;;;;;;1;
  Fecha1        : "Fecha Sistema"      ;;;;NO;NO;;;;Fsys
FinDialogo

if Not Ok
  Cancelar
endif

if Dialogo.Radio4=1
Cancelar ('NO SE REALIZARON CAMBIOS')
endif

  ACN(x10, SQL('Select count(*) from '~DBO~'.OPERACIONES where Operador = "'~Dialogo.Operador1~'" '))
  if val(x10)=0
     Cancelar('EL OPERADOR QUE SALE NO TIENE MINUTAS ASIGNADAS: La Operacion queda abortada')
  endif

if Dialogo.Radio2=0
LinkearHoja('BETA1',1,Operador=Dialogo.Operador1,String='Operaciones Vigentes Anteriores al Cambio de: ',Fecha1=Dialogo.Fecha1)
LinkearHoja('BETA1',1,Operador=Dialogo.Operador2,String='Operaciones Vigentes Anteriores al Cambio de: ',Fecha1=Dialogo.Fecha1)
Cancelar
endif

*acn(d1, 0)
*acn(d2, 0)
*acn(d3, 0)
*acn(d4, 0)
*acn(d5, 0)
*acn(d6, 0)
