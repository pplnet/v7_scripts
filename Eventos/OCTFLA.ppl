ACT(z2, Var('PATHSIOPEL'))
if Vacio(Val(z2))
  ACT(z2, 'C:\FPA')
endif
AbrirASCII(Val(z2)~'\REC-4430-I.TXT',0)

Repetir
  IFA
  ACT(aa:FAC, LeerAscii)
  if Vacio(Val(aa:FAC))
    CerrarASCII
    break
  endif
  SCN(x1,1)
Proximo
if Val(x1)>0
  recorrer&i 1,Val(x1)
    ACT(a:2, Val(aa:&i))
    (.'RECMAE14'.)
  proximo
endif
