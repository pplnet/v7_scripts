CrearDialogo
  Fecha1       : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;Fsys;
FinDialogo

if Not Ok
  Cancelar
endif

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Precio5, O.Indice as Indice, C.NrOperacion, C.NrCuota, C.Cantidad13, C.Cantidad14, C.Cantidad15,")
SQL.ADD(" C.Cantidad16, C.Precio3, C.Precio1, C.Cantidad17, C.Fecha5, O.Especie, C.Cantidad4, C.Cantidad3 ")
SQL.ADD(" From   "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O   ")
SQL.ADD(" where C.NrOperacion=O.NrOperacion   AND O.TipoOp IN ('MMONM')     ")
SQL.ADD(" and O.Precio5 = '1'    AND C.Fecha5  = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Indice Is Not null AND O.Indice <> ''  ")                                 
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL 
   ACT(b:1,fbn('Especie'))
   ACT(b:2,fbn('NrOperacion'))
   ACN(b:3,fbn('NrCuota')) 
   ACT(e:1,CotizaEn(fbn('Indice')) ) 
* Calculo de la cotizacion del indice a la Fecha5      
   ***---ACN(W:9, CotizacionC(Val(b:1) ,,,,Dialogo.Fecha1,1,SI,Val(e:1)))      
   ACN(W:9, CotizacionC(fbn('Indice') ,,,,Dialogo.Fecha1,1,SI,Val(e:1)))      
   ACN(c:13,fbn('Cantidad4') * val(W:9))
   ACN(c:14,fbn('Cantidad3') * val(W:9))
   ACN(c:15,fbn('Precio3') * val(W:9))
   ACN(c:16,fbn('Precio1') * val(W:9))     
   SQL.ADD(" UPDATE "~DBO~".CUOTAS SET ")
   SQL.ADD(" Cantidad13 = "~Fstr(Val(c:13), 0, 2)~", ")    
   SQL.ADD(" Cantidad14 = "~Fstr(Val(c:14), 0, 2)~", ")
   SQL.ADD(" Cantidad15 = "~Fstr(Val(c:15), 0, 2)~", ")
   SQL.ADD(" Cantidad16 = "~Fstr(Val(c:16), 0, 2)~", ")
   SQL.ADD(" Cantidad17 = "~Fstr(Val(W:9), 0, 8)~" ")
   SQL.ADD(" where NrOperacion = '"~val(b:2)~"' AND  NrCuota = "~Fstr(val(b:3),2,0)~" ")
   SQL.NEW      
   SQL.EXEC 
   SQL.ActualizarMovimientos3(Val(B:2), SI, NO, NO, NO, SI, 0)

   SQL.EXEC 
Proximo

  



  


