Cancelar("Evento no operativo")
*HojaVisible(SI)
CrearDialogo
  Fecha1     : 'FechaValor'                         ;1;2;;NO;NO;Dialogo.Fecha1>=Habiles(Fsys,-1,'ARG',SI) y Dialogo.Fecha1<=Fsys  y EsHabil(Dialogo.Fecha1,'ARG');'Debe ingresar una Fecha Habil no inferior al dia habil anterior';NO;FSys
  Radio4     : "Tipo Cliente|"~Var('LABEL')~"|Caja|Todos"  ;1;1;;NO;NO;;;;2;
  Cliente1   : "Cliente"                            ;1;1;;;;[[Vacio(Dialogo.Especie1) y NoVacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Especie1) y Vacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Cliente1) y NoVacio(Dialogo.Especie1)]];'Debe ingresar un Cliente o Especie';NO;
  Especie1   : "Especie"                            ;2;2;;;;[Vacio(Dialogo.Especie1) y NoVacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Especie1) y Vacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Cliente1) y NoVacio(Dialogo.Especie1)];'Debe ingresar un Cliente o Especie';NO;
  Vehiculo1  : "Vehiculo"                           ;4;1;;;;;;;VAR('VEHICULODE');Dialogo.Vehiculo1;
  Radio2     : "Bloqueo Tipo|Especie|Efectivo"      ;5;1;;;;;;;0;Dialogo.Radio2;
  Radio1     : "Cantidad|Nominal|Residual"          ;6;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0;IIF(Dialogo.Radio2=0,Dialogo.Radio1,-1);
  Radio3     : "Operacion|Bloqueo|Desbloqueo"       ;7;1;;;;;;;0;Dialogo.Radio3;
  ListaTabla3: 'Cuentas'                            ; ; ;;;;;;;;;;;;;'Codigo' ; 'Codigo;Nombre';'CUENTAS'
  Cantidad1  : 'a Reponer'                          ;1;1;;NO;SI;;;;0;
  Entero1    : 'Saldo a Reponer'                    ;1;1;;NO;SI
  Especie2   : 'Moneda a Reponer'                   ;1;1;;NO;SI
  Cantidad2  : 'Cantidad Exigida' ;1;1;1;NO;NO;;;;0
FinDialogo

if Not Ok
   Cancelar
endif

* Cuando se termine de usar hay que comentarla
*(.'ABCDARIO'.)

IF Dialogo.Radio3=0
   ACT(z2, 'BLOQUEO ')
ELSE
   ACT(z2, 'DESBLOQUEO ')
ENDIF

IF Dialogo.Radio2=0
   IF Dialogo.Radio1=0
      ACT(z2, Val(z2)~' en V.N.')
   ELSE
      ACT(z2, Val(z2)~' en V.R.')
   ENDIF
ELSE
   ACT(z2, Val(z2)~' de Monto')
ENDIF

ACT(z2, Val(z2)~' a Fecha '~Dialogo.Fecha1)

If Dialogo.Cantidad1<>0
   acn(z6,0 )
   act(y2,Fstr(Dialogo.Entero1-100,0,0))
   act(y3,BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',val(y2) ) )

   *- Viene de Reposicion de Garantias
   ACT(z2, 'REPOSICION: '~Fstr(Dialogo.Cantidad1,0,2)~' '~Dialogo.Especie2~' '~val(y3) )
EndIf


ACN(sd1,BuscarCampo('ESTADOSCUSTODIA','NrSaldo','Codigo',VAR('SALLIBRECU')))


IF Dialogo.Radio3=0
   SQL.ADD("SELECT Descripcion, NrSaldo+100 NrSaldo ")
ELSE
   SQL.ADD("SELECT Descripcion, NrSaldo ")
ENDIF
SQL.ADD("FROM "~DBO~".ESTADOSCUSTODIA ")
SQL.ADD("WHERE ISNULL(Habilitado, '') <> 'NO' AND ")
IF Dialogo.Radio3=0
   SQL.ADD("   Codigo <> '"~VAR('SALLIBRECU')~"'  and Codigo <> '"~VAR('SALBLOQVTA')~"' ")
ELSE
   SQL.ADD("   Codigo = '"~VAR('SALLIBRECU')~"' ")
ENDIF
SQL.ADD("ORDER BY Jerarquia ")

ACN(y1, 0)
ACT(z5, '')
Recorrer SQL 
   ACT(z5, Val(z5)~FBN['Descripcion']~'|')
   ACN(x:Val(y1), FBN['NrSaldo'])
   SCN(y1, 1)


Proximo

ACT(ta1,'SALDOS')

If Dialogo.Fecha1<Fsys
   ACT(ta1,'SALDOSDIA')
EndIf

*- Select desde Saldos
SQL.ADD("SELECT 1 Marca, S.Cliente, S.Cuenta, S.Saldo, S.Especie, S.Cupon, S.NrSaldo, S.Mercado, S.EnteCustodia, ")
SQL.ADD("       E.Descripcion, ESP.FechaCambioTasa, ESP.TasaIntAnterior, ESP.TasaIntVigente,ESP.Cotiza, ESP.InteresesC ")
SQL.ADD("FROM "~DBO~"."~val(ta1)~" S, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA E, "~DBO~".ESPECIES ESP ")
SQL.ADD("WHERE S.Cliente = C.Codigo ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("   AND S.Cliente ='"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD("      AND (C.Alias1 IS NULL OR C.Alias1 = ' ' OR (C.Codigo = '"~Dialogo.Vehiculo1~"') ) ")
**SQL.ADD("       C.Alias1 = ' ' OR ")
**SQL.ADD("       C.Alias1 <> 'CP') ")
SQL.ADD("      AND S.Especie = ESP.Codigo  ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND S.Especie = '"~Dialogo.Especie1~"'  ")
ENDIF
SQL.ADD("    AND  S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    AND  S.Saldo <> 0  ")
IF NoVacio(Dialogo.ListaTabla3)
   SQL.ADD(" AND S.Cuenta IN ("~Pipe2Comillas(Dialogo.ListaTabla3)~")" )
ENDIF
IF Dialogo.Radio4 = 0
   *- Solamente Clientes de Sudameris
   SQL.ADD(" AND C.TipoCliente = '"~VAR('CLISUD')~"' ")
EndIf
IF Dialogo.Radio4 = 1
   *- Solamente Clientes CAJA
   SQL.ADD(" AND C.TipoCliente = '"~VAR('CLICAJA')~"' ")
EndIf
IF Dialogo.Radio3 = 0
   SQL.ADD(" AND S.NrSaldo = E.NrSaldo ")
   SQL.ADD(" AND E.Codigo = '"~VAR('SALLIBRECU')~"' ")
EndIf
IF Dialogo.Radio3 = 1
   SQL.ADD(" AND S.NrSaldo = E.NrSaldo+100 AND S.NrSaldo <> 207 ")
   SQL.ADD(" AND E.Codigo <> '"~VAR('SALLIBRECU')~"' ")
   If Dialogo.Cantidad1<>0 
      SQL.ADD(" AND S.NrSaldo = "~Fstr(Dialogo.Entero1,0,0)~" ")      
   EndIf
EndIf
If Dialogo.Fecha1<Fsys
   *- Condicion Adicional para Saldos dia
   SQL.ADD("      and S.Fecha = (SELECT MAX(S2.Fecha) ")
   SQL.ADD("      FROM "~DBO~"."~val(ta1)~" S2 ")
   SQL.ADD("      WHERE S2.Cliente = S.Cliente AND ")
   SQL.ADD("      S2.Especie = S.Especie AND ")
   SQL.ADD("      S2.EnteCustodia = S.EnteCustodia AND ")
   SQL.ADD("      S2.Mercado = S.Mercado AND ")
   SQL.ADD("      S2.NrSaldo = S.NrSaldo AND ")
   SQL.ADD("      S2.Cuenta = S.Cuenta AND ")
   SQL.ADD("      S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
EndIf
SQL.ADD("ORDER BY S.Cliente, S.Cuenta, S.Especie ")

ACN(z1, 4)

SetFilaActual(Val(z1))

Recorrer SQL
   ACN(a:fac, FBN['Marca'])
   ACT(b:fac, FBN['Cliente'])
   ACT(c:fac, FBN['Cuenta'])
   ACN(ac:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))

   IF Dialogo.Radio3 = 0
      SQL.ADD("SELECT SUM(Cantidad) CantPend FROM "~DBO~".MOVPENDIENTES ")
      SQL.ADD("WHERE Cantidad < 0 AND ")
      SQL.ADD("      Cliente = '"~FBN['Cliente']~"' AND ")
      SQL.ADD("      Especie = '"~FBN['Especie']~"' AND ")
      SQL.ADD("      Cuenta = '"~FBN['Cuenta']~"' AND ")
      SQL.ADD("      Mercado = '"~FBN['Mercado']~"' AND ")
      SQL.ADD("      EnteCustodia = '"~FBN['EnteCustodia']~"' AND ")
      IF NoVacio(FBN['Cupon']) o FBN['Cupon']<>0
         SQL.ADD("   Cupon = '"~FBN['Cupon']~"' AND ")
      ENDIF
      SQL.ADD("      NrSaldo = "~FStr(Val(sd1),0,0)~" ")

      ACN(sm:fac, 0)
      ACT(w1, 'NO')
      Recorrer SQL
         ACT(w1, 'SI')
         ACN(sm:fac-1, FBN['CantPend'])
      Proximo
      IF EqStr(Val(w1),'SI')
         dfa
      ENDIF
   ENDIF

   ACN(sl:fac, FBN['Saldo']+Val(sm:fac))

   IF Dialogo.Radio2 = 0
      IF Dialogo.Radio1 = 0
         ACN(d:fac, Val(sl:fac))
      ELSE
         ACN(d:fac, Val(sl:fac) * Val(ac:fac))
      ENDIF
   ELSE
      ACN(d:fac, Val(sl:fac))
   ENDIF

   ACN(ad:fac, Val(sl:fac))
   ACT(e:fac, FBN['Especie'])
   ACT(f:fac, FBN['Cupon'])
   ACN(g:fac, FBN['NrSaldo'])
   ACT(h:fac, FBN['Descripcion'])
   ACT(m:fac, FBN['Mercado'])


   ACN(n:fac, Dialogo.Cantidad2)
   ACN(aa:fac, COTIZACION(FBN['Especie'],,,,Dialogo.Fecha1,1) )

   *- p: Cotizacion en la Moneda que desea Bloquear
   ACN(p:fac , COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1,25,SI,FBN['Cotiza']))
 

   ACT(ae:fac, FBN['Cotiza'] )

   *- Moneda de Emision si bloquea en Efectivo o Especie si bloquea en Especie
* PZ 19/09/2018
   *   ACT(o:fac, FBN['Especie'])
   ACT(o:fac, FBN['Cotiza'])
   If Dialogo.Radio2=1
      ACT(o:fac, FBN['Cotiza'])
   EndIf
   IF NoVacio(Dialogo.Especie2)
      ACT(o:fac, Dialogo.Especie2)
   EndIf
   If Dialogo.Radio2=0
      ACT(o:fac, FBN['Especie'])
   EndIf

   * Resolucion 1585
   ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))

   * Parametros para la funcion INTERESCLE, el interes lo devuelve en zz:fac
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, Val(sl:fac)*(1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1)))
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])

IF NO
   *-- 22/07/2005
   (.'INTERESCLE'.)
   *-- Intereses (INTERESCLE)
   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(i:fac, Val(ad:fac) * Val(ac:fac) * Val(aa:fac) + (Val(zz:fac)*Val(aa:fac)))
      ELSE
         ACN(i:fac, Val(ad:fac) * Val(ac:fac) * Val(aa:fac) + Val(zz:fac))
      ENDIF
   ELSE
      ACN(i:fac, Val(ad:fac) * Val(aa:fac) + Val(zz:fac))
   ENDIF
ENDIF
if no
*12/09/2005
   IF EqStr(FBN['InteresesC'],'CLE')
      ACN(zc:fac, InteresEspecieCap(FBN['Especie'],Dialogo.Fecha1,Val(sl:fac),,CampoAgenda(FBN['Especie'],Val(f:fac),4),(1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1)),Val(aa:fac)))
      ACN(zz:fac, InteresEspecie(FBN['Especie'],Dialogo.Fecha1,Val(sl:fac)*(1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1)) ) )
      *--- messagebox('SALDO '~vAL(SL:FAC)~' PRECIO '~Val(aa:fac)~' icash '~Val(zz:fac)~' icap '~val(zc:fac))
      IF Incluido(Val(al4), '1585')
         ACN(i:fac, (Val(ad:fac) * (1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1)) * Val(ac:fac) * Val(aa:fac)) + (Val(zz:fac)*Val(aa:fac)) + Val(zc:fac) )
      ELSE
         ACN(i:fac, (Val(ad:fac) * (1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1)) * Val(ac:fac) * Val(aa:fac)) + Val(zz:fac) + Val(zc:fac) )
      ENDIF
   ELSE
      ACN(i:fac, Val(ad:fac) * Val(aa:fac))
   ENDIF
endif

   ACN(i:fac, Val(ad:fac) * COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1,25,SI,Dialogo.Especie2) )

   ACN(ab:fac, BuscarCampo('Especies','LaminaMinima','Codigo',FBN['Especie']))

   *- Si es un bloqueo de VN
   If Dialogo.Radio3=0 y Dialogo.Radio2=0
      ACN(k:fac, Val(d:fac))
   EndIf

   scn(z1, 1)
Proximo

IF Val(z1) <=4 
   CANCELAR('No se encontraron saldos')
ENDIF

Recorrer&i 1, 1000
   CrearListBox ; 'MS Sans Serif,8,';Val(z2)
      'Marca'           ; a5..a:Val(z1);SI;SI;   ; 30;CHECK;RGB(220,220,193)
      'Cliente'         ; b5..b:Val(z1);NO;SI;   ; 80;STRING;;RGB(180,180,193)
      'Cuenta'          ; c5..c:Val(z1);NO;SI;   ; 80;STRING;;RGB(180,180,193)
      'Saldo'           ; d5..d:Val(z1);NO;SI;   ; 80;NUMERO;'###,###,###,###.##';RGB(180,180,193)
      'Especie'         ; e5..e:Val(z1);NO;SI;   ; 80;STRING;;RGB(180,180,193)
      'Cupon'           ; f5..f:Val(z1);NO;SI;   ; 40;STRING;;RGB(180,180,193)
      'Estado '         ; h5..h:Val(z1);NO;SI;   ;100;STRING;;RGB(180,180,193)
      'Valuacion '      ; i5..i:Val(z1);NO;SI;   ; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193);COTIZACIONC(val(e:flb),,,,Dialogo.Fecha1,25,SI,val(o:flb))*val(d:flb)
      'En Especie'      ; o5..o:Val(z1);Val(a:FLB)=1 y Dialogo.Radio2=1;Val(a:FLB)=0 o Dialogo.Radio2=0 o DesciendeDeEspecie(Val(o:flb),'MONEDA');'Debe Seleccionar una Moneda para el Bloqueo en Efectivo !!!'; 80;TABLA;'Especies';'Codigo';'Codigo;Nombre';;iif(Dialogo.Radio2=0,RGB(180,180,193),RGB(220,220,193));;;;'8,14';
      'A Mover (EnEspecie)'   ; k5..k:Val(z1);Val(a:FLB)=1;SI;  ; 80;NUMERO;'##,###,###.##';RGB(220,220,193);
      'Estado Nuevo'    ; j5..j:Val(z1);Val(a:FLB)=1;SI;  ;120;COMBO;Val(z5);RGB(220,220,193)
      'Gtia Exigida'    ; n5..n:Val(z1);Val(a:FLB)=1 y Dialogo.Cantidad2=0 y Dialogo.Radio3=0 y Dialogo.Radio2=1;[Val(n:flb)<=Val(k:flb) y Val(n:flb)>0] o Val(n:flb)=0;'Monto de Garantia a Controlar Invalido';80;NUMERO;'##,###,###.##';RGB(220,220,193);IIf(Dialogo.Cantidad2<>0,Dialogo.Cantidad2,IIf(Dialogo.Radio3=0 y Dialogo.Radio2=1,Val(k:flb),0));NO;NO;
      'Fecha Vto.'      ; l5..l:Val(z1);Val(a:FLB)=1;[Vacio(Val(l:FLB)) y Val(l:FLB)>FSys] o NoVacio(Val(l:FLB));'La fecha de venc. debe ser mayor a la del dia'; 80;FECHA;RGB(220,220,193)
      'CotizacionC'     ; p5..p:Val(z1);NO;SI;   ; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193);COTIZACIONC(val(e:flb),,,,Dialogo.Fecha1,25,SI,val(o:flb))
   FinListBox

*- ;;NO;NO;
*- 

   IF Not Ok
      Cancelar
   ENDIF

   * Aca valido monto/cantidad, si hay un monto que no es multiplo de laminaminima, vuelvo al
   * list box, sino voy calculando cada valor nominal para guardarlo en las respectivas tablas
   ACN(z3, 0)
   ACN(z6, 0)

   Recorrer&j 5, Val(z1)
      * si es marcado
      IF Val(a:&j)=1 
         * si monto/cant = 0
         IF Val(k:&j)=0 
            ACN(z3, 1)
         ELSE
            * si es especie
            IF Dialogo.Radio2=0 
               * si monto/cant > saldo
               IF Val(k:&j)>Val(d:&j)
                  ACN(z3, 2)
               ELSE
                  * si es nominal
                  IF Dialogo.Radio1=0 
                     ACN(mn:&j, Val(k:&j))
                  ELSE
                     * si es residual
                     ACN(mn:&j, Round(Val(k:&j)/Val(ac:&j),5))
                  ENDIF
                  * si tiene laminaminima
                  IF Val(ab:&j) > 0
                     * si monto/cant no es multiplo de LaminaMinima
                     IF [Val(mn:&j) Mod2(Val(ab:&j))<>0]
                        ACN(z3, 3)
                     ENDIF
                  ENDIF
               ENDIF
            ELSE
               *- Si proviene de una Reposicion, voy acumulando en Z6 los montos bloqueados
               If Dialogo.Cantidad1<>0
                  scn(z6,val(k:&j)*CotizacionC(val(ae:&j),,,,Fsys,1,SI) )
                  IF Not EqStr(val(y2),FStr(Val(x:Val(j:&j))-100,3,0) ) y Dialogo.Radio3=0
                     acn(z3,5)
                  EndIf
                  IF Not EqStr(val(y3),Val(h:fac)) y Dialogo.Radio3=1
                     acn(z3,5)
                  EndIf
               EndIf

               * Si es efectivo
               * Si monto/cant > valuacion
               IF Val(k:&j) > Val(i:&j)
                  ACN(z3, 4)
               ELSE
                  * mo: nueva valuacion en base a la nueva cantidad mult. de laminaminima
                  * mp: nueva cantidad nominal mult. de laminaminima

                  ACN(mn:&j, Round(Val(ad:&j)*Val(k:&j)/Val(i:&j),5))
                  * si tiene laminaminima
                  IF Val(ab:&j) > 0
                     * si monto/cant no es multiplo de LaminaMinima
*** MessageBox('* si monto/cant no es multiplo de LaminaMinima '~Fstr(Val(mn:&j),1,2)~' '~Fstr(Val(ab:&j),1,2)~' Mod '~Fstr(Val(mn:&j) Mod2(Val(ab:&j)),1,2) )
                     IF [Val(mn:&j) Mod2(Val(ab:&j))<>0]
                        *******ACN(z3, 3)
                        * me quedo con la parte entera de la division entre el monto y laminaminima
                        * y le sumo uno y multimplico por laminaminima, para poder obtener la 
                        * siguiente cantidad multiplo a bloquear
                        ACN(mp:&j, Val(mn:&j) DIV (Val(ab:&j)))
*** MessageBox('Division entera '~Fstr(Val(mp:&j),1,2)~' '~Fstr(Val(mn:&j)-(Val(mn:&j) Mod2(Val(ab:&j))),1,2))
*** Nueva cuentita (modificado por Carlos 06/09/2004)
                        ACN(mp:&j,Val(mn:&j)-(Val(mn:&j) Mod2(Val(ab:&j))))
                        ACN(mp:&j, (Val(mp:&j)+1)*Val(ab:&j))

                        * Nuevo monto en base a la nueva cantidad nominal multiplo de laminaminima
                        ACN(mo:&j, Round(Val(mp:&j)*Val(i:&j)/Val(ad:&j),5))

*** MessageBox('* Nuevo monto en base a la nueva cantidad nominal multiplo de laminaminima '~Fstr(Val(mp:&j),1,2)~' '~Fstr(Val(i:&j),1,2)~' '~Fstr(Val(ab:&j),1,2))
                        * Si el nuevo monto es > a la valuacion del saldo
                        IF Val(mo:&j) > Val(i:&j)
                           * me quedo con la parte entera de la division entre el monto y laminaminima
                           * y le resto uno y multimplico por laminaminima, para poder obtener la 
                           * anterior cantidad multiplo a bloquear
                           ACN(mp:&j, Val(mn:&j) DIV (Val(ab:&j)))
                           ACN(mp:&j, (Val(mp:&j)-1)*Val(ab:&j))

                           * Nuevo monto en base a la nueva cantidad nominal multiplo de laminaminima
                           ACN(mo:&j, Round(Val(mp:&j)*Val(i:&j)/Val(ad:&j),5))
                           IF Val(mo:&j) > Val(i:&j)
                              ACN(z3, 4)
                           ENDIF
                        ENDIF
                        IF Val(z3) = 0
                           ACN(vl1, MessageBox('Cliente: '~Val(b:&j)~', Nuevo Monto a Mover: '~FStr(Val(mo:&j),0,0)~', V.N.: '~FStr(Val(mp:&j),0,0),0,1))
                           IF Val(vl1) = 1
                              ACN(mn:&j, Val(mp:&j)) 
                              ACN(k:&j, Val(mo:&j))
                           ELSE
                              ACN(z3, 99)
                           ENDIF
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
      ENDIF

      IF Val(z3) <> 0
         IF Val(z3) = 1
            MessageBox("Error. El dato 'A Mover' no puede ser cero")
         ENDIF
         IF Val(z3) = 2
            MessageBox("Error. El dato 'A Mover' es mayor al Saldo")
         ENDIF
         IF Val(z3) = 3
            MessageBox("Error. El dato 'A Mover' "~val(b:&j)~" "~val(c:&j)~" "~val(e:&j)~" Saldo "~Fstr(Val(mn:&j),0,0)~" No es multiplo de Lamina Minima "~Fstr(Val(ab:&j),0,0))
         ENDIF
         IF Val(z3) = 4
            MessageBox("Error. El dato 'A Mover' es mayor que la Valuacion")
         ENDIF
         IF Val(z3) = 5 y Dialogo.Radio3=0
            MessageBox("Error. El Estado Nuevo no es "~val(y3)~" ... ")
         ENDIF
         IF Val(z3) = 5 y Dialogo.Radio3=1
            MessageBox("Error. El Estado Anterior no es "~val(y3)~" ... ")
         ENDIF

         BREAK
      Else  
         If Dialogo.Fecha1<Fsys y Val(a:&j)=1 
            *- Si es un bloqueo fecha valor, valido que no quede negativo a hoy
            ACN(ac5,SaldoC(Val(b:&j),Val(e:&j),,,,Val(m:&j),Dialogo.Vehiculo1,,val(g:&j),Fsys))
            SCN(ac5,val(sm:&j))

            IF Dialogo.Radio2=0 y (val(ac5)-val(k:&j))<0 
               *- Quedo negativo a hoy y es bloqueo por cantidad
               MessageBox("Error. El dato 'A Mover' es mayor al Saldo para la Fecha del Sistema")
               ACN(z3, 2)
               BREAK
            EndIf
         
            IF Dialogo.Radio2=1 
               *- Valuo el saldo a Hoy
               ACN(ad:&j,val(ac5))
   
               * Parametros para la funcion INTERESCLE, el interes lo devuelve en zz:fac
               ACN(yt1, &j)
               ACD(yu:&j, Fsys)
               * Especie
               ACT(yv:&j, Val(e:&j))
               ACN(yw:&j, Val(sl:&j))
               SQL.ADD("SELECT FechaCambioTasa,TasaIntAnterior,TasaIntVigente,InteresesC FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(e:&j)~"' ")
               Recorrer SQL
                  dfa
                  ACD(yx:&j, FBN['FechaCambioTasa'])
                  ACN(yy:&j, FBN['TasaIntAnterior'])
                  ACN(yz:&j, FBN['TasaIntVigente'])
                  ACT(yt2,   FBN['InteresesC'])
               Proximo

IF NO
*22/07/05 
               (.'INTERESCLE'.)
               * Intereses (INTERESCLE)
               IF EqStr(Val(yt2),'CLE')
                  IF Incluido(Val(al4), '1585')
                     ACN(i:&j, Val(ad:&j) * Val(ac:&j) * Val(aa:&j) + (Val(zz:&j)*Val(aa:&j)))
                  ELSE
                     ACN(i:&j, Val(ad:&j) * Val(ac:&j) * Val(aa:&j) + Val(zz:&j))
                  ENDIF
               ELSE
                  ACN(i:&j, Val(ad:&j) * Val(aa:&j) + Val(zz:&j))
               ENDIF
ENDIF
               *--- Claudia 06.09.05 Valuacion con otra moneda
               ACN(i:&j, Val(ad:&j) * Val(p:&j))

               IF NO 
               IF EqStr(Val(yt2),'CLE')
                  ACN(zc:&j, InteresEspecieCap(Val(yv:&j),Dialogo.Fecha1,Val(sl:&j),,CampoAgenda(Val(yv:&j),Val(f:&j),4),(1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)),Val(aa:&j)))
                  ACN(zz:&j,    InteresEspecie(Val(yv:&j),Dialogo.Fecha1,Val(sl:&j)*(1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)) ) )
                  IF Incluido(Val(al4), '1585')
                     ACN(i:&j, (Val(ad:&j) * (1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)) * Val(ac:&j) * Val(aa:&j)) + (Val(zz:&j)*Val(aa:&j)) + InteresEspecieCap(Val(yv:&j),Dialogo.Fecha1,Val(sl:&j),,CampoAgenda(Val(yv:&j),Val(f:&j),4),(1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)),Val(aa:&j)) )
                  ELSE
                     ACN(i:&j, (Val(ad:&j) * (1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)) * Val(ac:&j) * Val(aa:&j)) + Val(zz:&j) + InteresEspecieCap(Val(yv:&j),Dialogo.Fecha1,Val(sl:&j),,CampoAgenda(Val(yv:&j),Val(f:&j),4),(1+IntsCapitalizados2(Val(yv:&j),Dialogo.Fecha1)),Val(aa:&j)) )
                  ENDIF
               ELSE
                  ACN(i:&j, Val(ad:&j) * Val(aa:&j))
               ENDIF
               ENDIF
   

               IF Val(k:&j)>Val(i:&j)
                  MessageBox("Error. El dato 'A Mover' es mayor que la Valuacion para la Fecha del Sistema.")
                  ACN(z3, 5)
                  BREAK
               EndIf
            EndIf       
         EndIf       
      ENDIF
   Proximo

   If Dialogo.Cantidad1<>0 y Round(val(z6),2)>Round(Abs(Dialogo.Cantidad1),2)
      acn(z4,MessageBox("Continua? El dato 'A REPONER' "~Fstr(Round(val(z6),2),0,2)~" es mayor que la Cantidad a REVALUAR "~Fstr(Round(Abs(Dialogo.Cantidad1),2),0,2)~"... ",1,2))
      If val(z4)=6
         *- Ok
         acn(z3,0)
      Else 
         *- Cancel
         acn(z6,0 )
         acn(z3,6)
      EndIf
      * MessageBox(val(z4))
   EndIf
   If Val(z3) = 0
      BREAK
   EndIf
Proximo


ACN(aa1, 0)
Recorrer&j 5, Val(z1)
   * si es marcado
   IF Val(a:&j)=1
*////
      ACT(at:&j, GetNumerador(27))
      SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" (Cliente1, Cuenta1, Vehiculo1, Especie, ")
      SQL.ADD("  RB1, RB2, RB3, RB4, ")
      SQL.ADD("  Cantidad1, Cantidad2, Precio1, Cupon1, Precio2, ")
      SQL.ADD("  Precio3, Precio4, Fecha1, TipoTr2, NrTrans, Fecha2,CB1,  ")
      SQL.ADD("  FechaCarga, FechaCargaSys, UsrInput, Cantidad3, Especie1 ) ")
      SQL.ADD("  VALUES ")
      SQL.ADD(" ('"~Val(b:&j)~"', '"~Val(c:&j)~"', '"~Dialogo.Vehiculo1~"', '"~Val(e:&j)~"', ")
      SQL.ADD("'"~FSTR(Dialogo.Radio1,1,0)~"', '"~FSTR(Dialogo.Radio2,1,0)~"', '"~FSTR(Dialogo.Radio3,1,0)~"', '"~FSTR(Dialogo.Radio4,1,0)~"', ")
      SQL.ADD(FStr(Val(g:&j),3,0)~", "~FStr(Val(x:Val(j:&j)),3,0)~", "~FStr(Val(d:&j),15,4)~", '"~Val(f:&j)~"', "~FStr(Val(mn:&j),15,4)~", ")
      SQL.ADD(FStr(Val(k:&j),15,4)~", "~FStr(Val(az:&j),15,4)~", '"~IdxDate(Dialogo.Fecha1)~"', 'CAMEST', '"~Val(at:&j)~"', '"~IdxDate(Val(l:&j))~"',"~IIf(Dialogo.Cantidad1=0,'0','1')~",  ")
      SQL.ADD(" "~idxdate2(fsys)~","~idxdate2(fsys)~", '"~USUARIOACTIVO~"', "~FStr(Val(n:&j),3,0)~",'"~Val(o:&j)~"') ")
      SQL.NEW
      SQL.EXEC    

      SQL.ActualizarMovimientosT2(Val(at:&j),SI,NO,NO,NO)
      SQL.EXEC 
*////

      *- Alta de Instancias
      act(az3,Val(at:&j) )
      act(az4,'TRANSACCIONES2')
      act(az5,'70')
      (.'ALTAINSTAN'.)
 

      If Eqstr(FStr(Val(x:Val(j:&j)),3,0),VAR('BLOQGROFEX') ) o  Eqstr(FStr(Val(g:&j),3,0),VAR('BLOQGROFEX') )

         *---- Asistencia ROFEX ------------------
         EjecutarEvento('ASIROF',Fecha1=Dialogo.Fecha1, Especie1=Val(e:&j), Vehiculo1=VAR('VEHICULODE'), Mercado1=VAR('MERROFEX')  )
         *-

      Endif


      SCN(aa1, 1)
   ENDIF
Proximo

IF Val(aa1) > 0
   MessageBox("El proceso finalizo con exito.")
ENDIF
