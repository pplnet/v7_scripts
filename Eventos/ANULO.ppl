* Ante la anulacion de una operacion: (instancia 30)
* Desactivo todas las Instancias activas.
* Borrar las Excepciones.
* Borrar los movimientos.
* Borrar los Revaluos de Devengados.
* Borrar las Operaciones RELACIONADAS.
* Rever ANUAUT!!! (x patas)

*MESSAGEBOX('ANULO')

CrearDialogo
   NrOperacion1:'Codigo Operacion'
FinDialogo

IF NOT OK
   CANCELAR
ENDIF

* Desactivo todas las Instancias activas.
SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '0' ")
SQL.ADD(" Where NrBit <> 30 and NrBit <> 60 and (NrOperacion = '"~DIALOGO.NrOperacion1~"') ")
SQL.NEW
SQL.EXEC

* Borrar los movimientos.
EjecutarEvento('ANUMOV',NrOperacion1=DIALOGO.NrOperacion1)

* PZ las borra el trigger. Sirve para contestar en Raiden
* Borrar las Excepciones.
*SQL.ADD(" Delete "~DBO~".EXCEPCIONES ")
*SQL.ADD(" Where  NrOperacion = '"~DIALOGO.NrOperacion1~"' ")
*SQL.NEW
*SQL.EXEC

* Deshacer Revaluos de Devengados de esa operacion
EjecutarEvento('BREVDE',Fecha1=FSYS,NrOperacion1=DIALOGO.NrOperacion1)

*---- Marca de Riego queda como ONA Observada NO Aprobada
SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
SQL.ADD(" SET ObservacDoc = 'No Aprobada' ")
SQL.ADD(" Where NrOperacion = '"~DIALOGO.NrOperacion1~"' ")
SQL.NEW

IF NO
   *---- Borra Operaciones relacionadas de IFX autom ticos---
   ACT(z1, SQL("Select NrOperacion from "~DBO~".OPERACIONES where OperacionRef = '"~Dialogo.NrOperacion1~"' and TipoOp = 'IFX'"))
   SQL.ADD("Delete "~DBO~".OPERACIONES where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".MOVPOSEJE where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".MOVPOSPEN where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".MOVPENDIENTES where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".MOVEJECUTADOS where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".EXCEPCIONES where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".MOVLIMITES where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".OPERACIONESBITS where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.ADD("Delete "~DBO~".INSTANCIASOP where NrOperacion='"~Val(z1)~"'")
   SQL.NEW
   SQL.EXEC
ENDIF