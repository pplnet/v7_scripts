CrearDialogo
  Fecha1:'Fecha';;;;;;;;;FSYS
  Vehiculo1: 'Vehiculo'
  Book1: 'Book'
  Especie1: 'Especie'
*  String1: 'PriMes' ;;;;;;;;;'NO';;;;;;
FinDialogo

if not OK 
  Cancelar
endif

if NoVacio(Dialogo.Especie1)
  ACT(a1, ", '"~Dialogo.Especie1~"'")
else
  ACT(a1, ", ' '")
endif
if NoVacio(Dialogo.Vehiculo1)
  ACT(a1, Val(a1)~" , '"~Dialogo.Vehiculo1~"'")
else
  ACT(a1, Val(a1)~" , ' '")
endif
if NoVacio(Dialogo.Book1)
  ACT(a1, Val(a1)~" , '"~Dialogo.Book1~"'")
else
  ACT(a1, Val(a1)~" , ' '")
endif
*ACT(a1, Val(a1)~" , '"~Dialogo.String1~"' ")

SQL.ADD("exec CalcularPrecioReset '"~IdxDate(Dialogo.Fecha1)~"' "~Val(a1))
SQL.NEW
SQL.EXEC

