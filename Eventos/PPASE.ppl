*- Este evento toma las operaciones que se encuentren en la instancia de LIQUIDACION (10)
*- y que se encuentren liquidadas (tanto la especie como la contraespecie)
*- y las pase a la instancia TERMINAL (70).

HojaVisible(NO)

CrearDialogo
    Nroperacion1: 'Operacion'           ;;;;;;;;;;
    Mercado1    : 'Mercado'             ;;;;;;;;;;
FinDialogo

SQL.ADD("SELECT O.NrOperacion FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion = OB.NrOperacion ")
SQL.ADD("       AND OB.NrBit = 10 AND OB.Valor='1'   ")
If Novacio(Dialogo.Mercado1) 
    SQL.ADD("       AND O.Mercado = '"~Dialogo.Mercado1~"'         ")
Endif
If Novacio(Dialogo.Nroperacion1)
    SQL.ADD("       AND O.NrOperacion = '"~Dialogo.Nroperacion1~"' ")
Endif
SQL.ADD("       AND NOT EXISTS (SELECT M.NrOperacion FROM "~DBO~".MOVPENDIENTES M ")
SQL.ADD("                       WHERE  M.NrOperacion = O.NrOperacion ) ")
*SQL.ADD("       AND  (O.TipoOp NOT IN ('FXCT','FXVT','FXAT') AND O.RB10='1' AND O.TotalNetoCli1=0 ) ")
SQL.ADD("       AND  (O.TipoOp NOT IN ('FXCF','FXVF','FXAT') OR O.RB10<>'1' OR O.TotalNetoCli1<>0 ) ")
***---SQL.ADD("       AND  (O.TipoOp Not IN ('MMPFCE') OR O.CB9 = 1) ")
SQL.ADD("ORDER BY O.NrOperacion ")

Recorrer SQL
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '1' ")
   SQL.ADD(" Where  NrBit=70 and NrOperacion= '"~FBN['NrOperacion']~"' ")
   SQL.NEW   

   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '0' ")
   SQL.ADD(" Where  NrBit=10 and NrOperacion= '"~FBN['NrOperacion']~"' ")
   SQL.NEW   

   SQL.EXEC
Proximo