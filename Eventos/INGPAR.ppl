MostrarCuadroDeMensajes
CrearDialogo
  NrTrans1   : 'Nro.Voucher'          ;;;;;;NoVacio(Dialogo.NrTrans1) y Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'FXDEP|FXRET') y BuscarCampo('TRANSACCIONES2','CB10','NrTrans',Dialogo.NrTrans1)=1;'Tipo de Comprobante incorrecto';NO;;;;;;"TipoTr2 In ('FXDEP','FXRET') and CB10='1' and IsNull(CB3,'0')='0' and IsNull(CB9,'0')='0' and Mercado1='BCRA' and NrTrans in (Select NrOperacion from "~DBO~".OPERACIONESBITS where (NrBit=6 or NrBit=7) and Valor='1')"
  Radio1     : 'Cierre OCT|SI|NO'     ;;;;NO;NO;;;;1;
  Cantidad2  : 'Cantidad Confirma OCT';;;;NO;NO;;;;0;
  Check1     : 'Procesa'              ;;;;NO;NO;;;;1;
FinDialogo
if Not OK
  Cancelar
endif
ACN(y1, Dialogo.Check1)
if Dialogo.Check1=0
  HojaVisible(SI)
endif

if Dialogo.Radio1=1 Y Eqstr(BuscarCampo('TRANSACCIONES2','Mercado1','NrTrans',Dialogo.NrTrans1), Var('MERCOCT'))
  Cancelar('Los Vouchers OCT no Pueden Confirmarse con este Proceso')
endif
if BuscarCampo('TRANSACCIONES2','CB9','NrTrans',Dialogo.NrTrans1)=1
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta confirmado')
endif

ACT(x1, SQL("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrTrans1~"' and NrBit = 2 "))
if EqStr(Val(x1),'1')
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta fallado')
endif

ACT(a:1, 'Nr.Voucher:')
ACT(a:2, 'Cliente:')
ACT(a:3, 'Especie:')
ACT(a:4, 'Tipo:')
ACT(a:5, 'Monto:')
ACT(a:6, 'Importe:')
ACT(a:7, 'Falla:')
ACT(a:8, 'Imp.Falla:')
ACT(a:9, 'DVP:')
ACT(a:10, 'RVP:')
ACT(a:11, 'CONF:')
ACT(a:12, 'Transporte:')
ACT(a:13, 'Mercado:')
ACT(a:14, 'Concepto:')
ACT(a:15, 'Vehiculo:')
ACT(a:16, 'Cupon:')
ACT(a:17, 'Cuenta1:')
ACT(a:18, 'Cuenta2:')
ACT(a:19, 'F.Liq.Vouch')
ACT(a:20, 'F.Liq.Falla')
ACT(a:21, 'Mercado Falla')

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 where NrTrans = '"~Dialogo.NrTrans1~"' ")
recorrer SQL
  ACT(b:1, FBN['NrTrans'])
  ACT(b:2, FBN['Cliente1'])
  ACT(b:3, FBN['Especie'])
  ACT(b:4, FBN['TipoTr2'])
  ACN(b:5, FBN['Cantidad1'])
  ACN(b:9, FBN['CB6'])
  ACN(b:10, FBN['CB7'])
  ACN(b:11, FBN['CB8'])
  ACT(b:13, FBN['Mercado1'])
  SQL.ADD("Select Concepto from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Dialogo.NrTrans1~"'")
  recorrer SQL
    DFA
    ACT(b:14, FBN['Concepto'])
  proximo
  ACT(b:15, FBN['Vehiculo1'])
  ACT(b:16, FBN['Cupon1'])
  ACT(b:17, FBN['Cuenta1'])
  ACT(b:18, FBN['Cuenta2'])
  ACD(b:19, FBN['Fecha2'])
  if Dialogo.Radio1 = 0
    * Cierre OCT
    ACD(b:20, Habiles(Val(b:19), 1, 'ARG', SI))
  else
*    ACD(b:20, FSys)
    ACD(b:20, Habiles(Val(b:19), 1, 'ARG', SI))
  endif
  if Eqstr(fbn('TipoTr2'),'FXDEP')
    ACN(x1, 1)
  else
    ACN(x1, -1)
  endif

  IF Dialogo.Radio1 = 1
    * No es por Cierre de OCT
    if EqStr(FBN['TipoTr2'],'FXDEP')
      CrearDialogo
        Cantidad2: 'Cant.Cobrada'    ;8;1;;  ;;Dialogo.Cantidad2>0 y Dialogo.Cantidad2<Val(b:5);'La cantidad esta fuera del rango.';NO;
        NrTrans1 : '# Vocher'        ;1;1;;NO;;;;;FBN['NrTrans'];
        Cliente1 : 'Cliente'         ; ; ;;NO;;;;;FBN['Cliente1'];
        Especie1 : 'Especie'         ; ; ;;NO;;;;;FBN['Especie'];
        Fecha1   : 'Fecha Liq'       ; ; ;;NO;;;;;FBN['Fecha2'];
        Cuenta1  : 'Cta. Cliente'    ; ; ;;NO;;;;;FBN['Cuenta1'];
        Cuenta2  : 'Cta. Propia'     ; ; ;;NO;;;;;FBN['Cuenta2'];
        Cantidad1: 'Cant.a Cobrar'   ; ; ;;NO;;;;;FBN['Cantidad1'];
        Radio1   : 'Cierre OCT|SI|NO';9;1;;NO;Val(y1)=0;;;;1;
        Check1   : 'Procesa'         ;9;2;;NO;Val(y1)=0;;;;Val(y1);
      FinDialogo
    else
      CrearDialogo
        Cantidad2: 'Cant.Pagada'     ;8;1;;  ;;Dialogo.Cantidad2>0 y Dialogo.Cantidad2<Val(b:5);'La cantidad esta fuera del rango.';NO;
        NrTrans1 : '# Vocher'        ;1;1;;NO;;;;;FBN['NrTrans'];
        Cliente1 : 'Cliente'         ; ; ;;NO;;;;;FBN['Cliente1'];
        Especie1 : 'Especie'         ; ; ;;NO;;;;;FBN['Especie'];
        Fecha1   : 'Fecha Liq'       ; ; ;;NO;;;;;FBN['Fecha2'];
        Cuenta1  : 'Cta. Cliente'    ; ; ;;NO;;;;;FBN['Cuenta1'];
        Cuenta2  : 'Cta. Propia'     ; ; ;;NO;;;;;FBN['Cuenta2'];
        Cantidad1: 'Cant.a Pagar'    ; ; ;;NO;;;;;FBN['Cantidad1'];
        Radio1   : 'Cierre OCT|SI|NO';9;1;;NO;Val(y1)=0;;;;1;
        Check1   : 'Procesa'         ;9;2;;NO;Val(y1)=0;;;;Val(y1);
      FinDialogo
    endif
    if Not OK
      Cancelar('Evento cancelado')
    endif
    ACT(b:21, FBN['Mercado1'])
  else
    * Cierre de OCT
    ACT(b:21, 'BCRA')
  endif
  ACN(b:6, Dialogo.Cantidad2)
  ACN(b:7, FBN['Cantidad1']-Dialogo.Cantidad2)
  ACN(b:8, (FBN['Cantidad1']-Dialogo.Cantidad2)*Val(x1))

*****************************
** Caja de Valores/Financiero
*****************************
  if Dialogo.Check1=1
    Message('Generacion de Transporte Voucher '~Val(b:1)~'.')
*    Message('Actualiza InstanciasOp Voucher '~Val(b:1))
    SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
    SQL.ADD("Where NrOperacion = '"~Val(b:1)~"' ")
    if EqStr(Val(b:4),'FXDEP')
      SQL.ADD("and NrInstancia = 7 ")
    else
      SQL.ADD("and NrInstancia = 6 ")
    endif
    SQL.NEW

    SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
    SQL.ADD("NrOperacion, ")
    SQL.ADD("NrInstancia, ")
    SQL.ADD("Usuario, ")
    SQL.ADD("Mensaje, ")
    SQL.ADD("Fecha ")
    SQL.ADD(") Values (")
    SQL.ADD("'"~Val(b:1)~"', ")
    if EqStr(Val(b:4),'FXDEP')
      SQL.ADD("7, ")
    else
      SQL.ADD("6, ")
    endif
    SQL.ADD("'"~UsuarioActivo~"', ")
    SQL.ADD("'Generacion de Falla Parcial', ")
    SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
    SQL.ADD(")")
    SQL.NEW

*    Message('Actualiza Voucher '~Val(b:1))
    ACT(b:12, GetNumerador(13))
    SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
    SQL.ADD("   SET Fecha3      = '"~IdxDate(FSys)~"', ")
    SQL.ADD("       NrTransRef1 = '"~Val(b:12)~"', ")
    SQL.ADD("       Cantidad3   = "~FStr(Val(b:8),1,2)~", ")
    SQL.ADD("       Cantidad4   = "~FStr(Val(b:6),1,2)~", ")
    SQL.ADD("       CB3         = '1'")
    SQL.ADD(" Where NrTrans = '"~Val(b:1)~"' ")
    SQL.NEW

*    Message('Actualiza OperacionesBits Voucher '~Val(b:1))
    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor = '0' ")
    SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
    if EqStr(Val(b:4),'FXDEP')
      SQL.ADD(" and NrBit = 7 ")
    else
      SQL.ADD(" and NrBit = 6 ")
    endif
    SQL.NEW

    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor = '1' ")
    SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
    SQL.ADD("   and NrBit = 2 ")
    SQL.NEW

    Message('Genera Transporte '~Val(b:12))
    SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")

    SQL.ADD("TipoTr2, ")
    SQL.ADD("Especie, ")
    SQL.ADD("Fecha1, ")
    SQL.ADD("Fecha2, ")
    SQL.ADD("Fecha4, ")
    SQL.ADD("Cliente1, ")

    SQL.ADD("Cantidad1, ")
    SQL.ADD("Vehiculo1, ")
    SQL.ADD("Mercado1, ")
    SQL.ADD("Observaciones, ")
    SQL.ADD("NrTransRef1, ")

    SQL.ADD("CB6, ")
    SQL.ADD("CB7, ")
    SQL.ADD("CB8, ")
    SQL.ADD("Cupon1, ")
    SQL.ADD("Cuenta1, ")

    SQL.ADD("Cuenta2, ")
    SQL.ADD("NrTrans ")

    SQL.ADD(" ,FechaCarga, FechaCargaSys, UsrInput ")
    SQL.ADD(") Values (")

    SQL.ADD("'TRANSP', ")
    SQL.ADD("'"~Val(b:3)~"', ")
    SQL.ADD("'"~IdxDate(FSys)~"', ")
    SQL.ADD("'"~IdxDate(Val(b:20))~"', ")
    SQL.ADD("'"~IdxDate(Val(b:20))~"', ")
    SQL.ADD("'"~Val(b:2)~"', ")

    SQL.ADD(""~FStr(Val(b:8),1,2)~", ")
    SQL.ADD("'"~Val(b:15)~"', ")
    SQL.ADD("'"~Val(b:21)~"', ")
    SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', ")
    SQL.ADD("'"~Val(b:1)~"', ")

    SQL.ADD("'"~FStr(Val(b:9),1,0)~"', ")
    SQL.ADD("'"~FStr(Val(b:10),1,0)~"', ")
    SQL.ADD("'"~FStr(Val(b:11),1,0)~"', ")
    SQL.ADD("'"~Val(b:16)~"', ")
    SQL.ADD("'"~Val(b:17)~"', ")

    SQL.ADD("'"~Val(b:18)~"', ")
    SQL.ADD("'"~Val(b:12)~"' ")
    SQL.ADD(" ,"~SQLAhora~", "~IdxDate2(FSys)~", '"~UsuarioActivo~"' ")

    SQL.ADD(")")
    SQL.NEW

*    Message('Genera Instancias Transporte '~Val(b:12))
    SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
    SQL.ADD("(NrBit, NrOperacion, Valor) ")
    SQL.ADD(" Select NrInstancia, '"~Val(b:12)~"', '0'")
    SQL.ADD("   from "~DBO~".INSTANCIAS ")
    SQL.ADD("  where Tabla = 'TRANSACCIONES2'")
    SQL.NEW

    SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
    SQL.ADD("   Set Valor       = '1' ")
    SQL.ADD(" Where NrBit       = 5 ")
    SQL.ADD("   and NrOperacion = '"~Val(b:12)~"' ")
    SQL.NEW

*    Message('Genera MovPendiente Transporte '~Val(b:12))
    SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")

    SQL.ADD("FechaMov, ")
    SQL.ADD("Cliente, ")
    SQL.ADD("Especie, ")
    SQL.ADD("EnteCustodia, ")
    SQL.ADD("Cantidad, ")

    SQL.ADD("Leyenda, ")
    SQL.ADD("NrSaldo, ")
    SQL.ADD("NrMov, ")
    SQL.ADD("NrGrupo, ")
    SQL.ADD("Bits, ")

    SQL.ADD("Status, ")
    SQL.ADD("Cupon, ")
    SQL.ADD("Mercado, ")
    SQL.ADD("Concepto, ")
    SQL.ADD("Cuenta, ")

    SQL.ADD("NrOperacion ")

    SQL.ADD(") Values (")
    SQL.ADD("'"~IdxDate(Val(b:20))~"', ")
    SQL.ADD("'"~Val(b:2)~"', ")
    SQL.ADD("'"~Val(b:3)~"', ")
    SQL.ADD("'"~Val(b:15)~"', ")
    SQL.ADD(""~FStr(-Val(b:8),1,2)~", ")

    SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', ")
    SQL.ADD(""~FStr(1,1,0)~", ")
    SQL.ADD(""~FStr(1,1,0)~", ")
    SQL.ADD(""~FStr(1,1,0)~", ")
    SQL.ADD("'MV', ")

    if Val(b:9)=1
      SQL.ADD("'CONF', ")
    else
      if Val(b:10)=1
        SQL.ADD("'DVP', ")
      else
        if Val(b:11)=1
          SQL.ADD("'RVP', ")
        else
          SQL.ADD("'', ")
        endif
      endif
    endif
    SQL.ADD("'"~Val(b:16)~"', ")
    SQL.ADD("'"~Val(b:21)~"', ")
    SQL.ADD("'"~Val(b:14)~"', ")
    SQL.ADD("'"~Val(b:17)~"', ")

    SQL.ADD("'"~Val(b:12)~"' ")
    SQL.ADD(")")
    SQL.NEW

*    Message('Insert MovEjecutados Transporte '~Val(b:12))
    SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
    SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
    SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
    SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
    SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
    SQL.ADD(") ")
    SQL.ADD("select ")
    SQL.ADD(" '"~Val(b:12)~"', FechaMov, Cliente, Especie, CallPut, ")
    SQL.ADD(" FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
    SQL.ADD(" '"~'Transporte Parcial '~Val(b:1)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
    SQL.ADD(" NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
    SQL.ADD(" '"~UsuarioActivo~"', Cuenta, Transaccion, "~FStr(-Val(b:8),1,2)~", Cupon")
    SQL.ADD("  from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
    SQL.NEW

    SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
    SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
    SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
    SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
    SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
    SQL.ADD(") ")
    SQL.ADD("select ")
    SQL.ADD("'"~Val(b:12)~"', FechaMov, Cliente, Especie, CallPut, ")
    SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
    SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
    SQL.ADD("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
    SQL.ADD("'"~UsuarioActivo~"', Cuenta, Transaccion, "~FStr(Val(b:8),1,2)~", Cupon ")
    SQL.ADD("  from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" where NrOperacion <> '"~Val(b:1)~"' ")
    SQL.ADD("   and NrTrans2    = '"~Val(b:1)~"' ")
    SQL.NEW
    SQL.EXEC

    Message('Modificar Operacion Transporte '~Val(b:12))
    ModificarOperacion(Val(b:12),0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,SI,NO,NO,NO,1)
  else
    MessageBox('Generacion de Transporte Voucher '~Val(b:1)~'.')
  endif

  break
proximo

ACO(1,10)
