CrearDialogo
  Fecha1       : "Fecha"        ;;;;;;Dialogo.Fecha1<=Fsys;'Debe Ingresar la Fecha';NO;FSYS 
*  Especie1     : 'Especie'       ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Moneda';NO;;;;;;"Codigo IN ("~pipe2comillas(descendientes('ESPECIES','MONEDA'))~") "
  Especie1         : 'Especie'       ;;;;;;
  ContraEspecie1   : 'Contraespecie'       ;;;;;;
FinDialogo

if not Ok
  Cancelar
endif

SQL.ADD(" Select C.*, E.Cotiza ")
SQL.ADD("   from "~DBO~".COTIZACIONES C, "~DBO~".ESPECIES E ")
SQL.ADD("  where C.Codigo = E.Codigo ")
SQL.ADD("  ANd C.Codigo = '"~Dialogo.Especie1~"'    ")
SQL.ADD("    and C.Fecha  = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("Order by C.CallPut, C.FechaEj, C.Codigo ")
recorrer SQL
   SCN(x:1, 1)
   ACD(a:FAC, fbn('Fecha'))
   ACT(b:FAC, fbn('Codigo')) 
   ACN(f:FAC, fbn('Precio1'))
   ACN(g:FAC, fbn('Precio2'))
   ACN(h:FAC, fbn('Precio3'))
   ACN(i:FAC, fbn('Precio4'))
   ACN(j:FAC, fbn('Precio5'))
   ACN(k:FAC, fbn('Precio6'))
   ACN(l:FAC, fbn('Precio7'))
   ACT(m:FAC, fbn('Cotiza'))
proximo

  ACN(WW:2,  CotizacionC(Val(b:Fac) ,,,,Dialogo.Fecha1,1,SI,VAR('MONEGRUPO')))
  ACN(WW:1,  CotizacionC(Val(b:Fac)             ,,,,Dialogo.Fecha1,1,SI,VAR('MONEFUERTE')))

  if EqStr(Val(m:fac),'ARP')        
     ACN(t:1, Val(f:fAC)*CotizacionBNABCU('USD',Dialogo.Fecha1,1,SI,NO))
  else       
     ACN(t:1, Val(f:fac)*CotizacionBCU(Val(m:fac),Dialogo.Fecha1,1,SI,NO))
  endif
