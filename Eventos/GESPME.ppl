HojaVisible(NO)

ModoReproceso(SinDialogo)
CrearDialogo
  Especie1   : ''                ;;;;;;;;;
  String1    : ''                ;;;;;;;;;
  String2    : ''                ;;;;;;;;;
  String3    : ''                ;;;;;;;;;    
FinDialogo
IF Not Ok
  Cancelar
Endif
  *messagebox("Se ejecuta GESPME especie:"~Dialogo.especie1~" string1:"~Dialogo.String1~" String2:"~Dialogo.String2~" String3:"~Dialogo.String3)

  ACT(ME:0,Var('MERSENEBI'))
  ACN(UN:1,iif(DesciendeDeEspecie(Dialogo.Especie1,'ACCION'),1,100))
  
  if EqStr(Dialogo.String2,'A')
     If Not EqStr(Dialogo.String1,'')
        SQL.ADD("Delete "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String1~"'  or Codigo ='"~Dialogo.String1~"C' or Codigo ='"~Dialogo.String1~"D'")
        SQL.ADD("                                   or Codigo ='"~Dialogo.String1~"X' or Codigo ='"~Dialogo.String1~"Z' or Codigo ='"~Dialogo.String1~"Y'")
        SQL.NEW
        SQL.EXEC

        ACT(ES:1,Dialogo.String1)
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERCBCRA'))
        ACT(ME:3,Var('MERCADOBT'))
        ACT(MO:1,Var('MONELOCA'))
        
        (.'GRABESPMER'.)
        
        ACT(ES:1,Dialogo.String1~'C')
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERSWIFT'))
        ACT(ME:3,Var('MERSWIFT'))
        ACT(MO:1,Var('MONEEXTR'))
        
        (.'GRABESPMER'.)
        
        ACT(ES:1,Dialogo.String1~'D')
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERCBCRA'))
        ACT(ME:3,Var('MERCADOBT'))
        ACT(MO:1,Var('MONEEXTR'))
        
        (.'GRABESPMER'.)
        
        ACT(ES:1,Dialogo.String1~'X')
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERCBCRA'))
        ACT(ME:3,Var('MERCADOBT'))
        ACT(MO:1,Var('MONELOCA'))
        
        (.'GRABESPMER'.)

        ACT(ES:1,Dialogo.String1~'Z')
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERSWIFT'))
        ACT(ME:3,Var('MERSWIFT'))
        ACT(MO:1,Var('MONEEXTR'))
        
        (.'GRABESPMER'.)
        
        ACT(ES:1,Dialogo.String1~'Y')
        ACT(ME:1,Var('MERCACV'))
        ACT(ME:2,Var('MERCBCRA'))
        ACT(ME:3,Var('MERCADOBT'))
        ACT(MO:1,Var('MONEEXTR'))
        
        (.'GRABESPMER'.)
     Endif
     
  Else
     *Especie, especie modificada
     *String1 valor actual
     *String2 operacion(M A)
     *String3 valor anterior
     if EqStr(Dialogo.String2,'M')
        if sql("select count(*) from "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String1~"'")=0 y [Not EqStr(Dialogo.String1,'') o novacio(Dialogo.String1)] y [EqStr(Dialogo.String3,'') o vacio(Dialogo.String3)]
            *NUEVO PURO NO tiene parametros cargados en tabla tiene valor actual y no tiene valor anterior
            *SQL.ADD("Delete "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String3~"' or Codigo ='"~Dialogo.String3~"C' or Codigo ='"~Dialogo.String3~"D'")
            SQL.ADD("Delete "~DBO~".ESPECIESMERCADOS where ESPECie =  '"~Dialogo.especie1~"'")
            *Messagebox("Delete "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String3~"' or Codigo ='"~Dialogo.String3~"C' or Codigo ='"~Dialogo.String3~"D'")
            *Messagebox("Nuevo Delete "~DBO~".ESPECIESMERCADOS where ESPECie =  '"~Dialogo.especie1~"'")
            SQL.NEW
            SQL.EXEC
            If Not EqStr(Dialogo.String1,'') o novacio(Dialogo.String1) 
               ACT(ES:1,Dialogo.String1)
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERCBCRA'))
               ACT(ME:3,Var('MERCADOBT'))
               ACT (MO:1,Var('MONELOCA'))
               *messagebox("insert 1 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONELOCA:"~Var('MONELOCA'))
               (.'GRABESPMER'.)
            
               ACT(ES:1,Dialogo.String1~'C')
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERSWIFT'))
               ACT(ME:3,Var('MERSWIFT'))
               ACT(MO:1,Var('MONEEXTR'))
               *messagebox("insert 2 MERCACV:"~Var('MERCACV')~" MERSWIFT:"~Var('MERSWIFT')~" MERSWIFT:"~Var('MERSWIFT')~" MONEEXTR:"~Var('MONEEXTR'))
               (.'GRABESPMER'.)
            
               ACT(ES:1,Dialogo.String1~'D')
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERCBCRA'))
               ACT(ME:3,Var('MERCADOBT'))
               ACT(MO:1,Var('MONEEXTR'))
               *messagebox("insert 3 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONEEXTR:"~Var('MONEEXTR'))
               (.'GRABESPMER'.)
               
               ACT(ES:1,Dialogo.String1~'X')
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERCBCRA'))
               ACT(ME:3,Var('MERCADOBT'))
               ACT(MO:1,Var('MONELOCA'))
               *messagebox("insert 1 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONELOCA:"~Var('MONELOCA'))
               (.'GRABESPMER'.)
            
               ACT(ES:1,Dialogo.String1~'Z')
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERSWIFT'))
               ACT(ME:3,Var('MERSWIFT'))
               ACT(MO:1,Var('MONEEXTR'))
               *messagebox("insert 2 MERCACV:"~Var('MERCACV')~" MERSWIFT:"~Var('MERSWIFT')~" MERSWIFT:"~Var('MERSWIFT')~" MONEEXTR:"~Var('MONEEXTR'))
               (.'GRABESPMER'.)
            
               ACT(ES:1,Dialogo.String1~'Y')
               ACT(ME:1,Var('MERCACV'))
               ACT(ME:2,Var('MERCBCRA'))
               ACT(ME:3,Var('MERCADOBT'))
               ACT(MO:1,Var('MONEEXTR'))
               *messagebox("insert 3 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONEEXTR:"~Var('MONEEXTR'))
               (.'GRABESPMER'.)
            endif
        else
            *Tenia un valor y se lo estoy cambiando
            if [Not EqStr(Dialogo.String1,'') o novacio(Dialogo.String1)] y [Not EqStr(Dialogo.String3,'') o novacio(Dialogo.String3)] y not Eqstr(Dialogo.String1 ,Dialogo.String3)
                *Si tiene parametros el nuevo pongo cartel
                if sql("select count(*) from "~DBO~".ESPECIESMERCADOS where                  Codigo ='"~Dialogo.String1~"' or Codigo ='"~Dialogo.String1~"C' or Codigo ='"~Dialogo.String1~"D' or Codigo ='"~Dialogo.String1~"X' or Codigo ='"~Dialogo.String1~"Y' or Codigo ='"~Dialogo.String1~"Z'")<>0
                    act(z95,sql("select distinct especie from "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String1~"' or Codigo ='"~Dialogo.String1~"C' or Codigo ='"~Dialogo.String1~"D' or Codigo ='"~Dialogo.String1~"X' or Codigo ='"~Dialogo.String1~"Y' or Codigo ='"~Dialogo.String1~"Z'"))
                    Messagebox("CodigoBYMA ARP :"~Dialogo.String1~" Ya utilizado por "~val(z95))
                    SQL("update dbo.especies set CodAlfCajaValores = '"~Dialogo.String3~"' where codigo = '"~Dialogo.Especie1~"'")
                    Cancelar
                else
                    *si se lo cambio a blanco limpio parametros
                    ACT(ES:1,Dialogo.String1)
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERCBCRA'))
                    ACT(ME:3,Var('MERCADOBT'))
                    ACT(MO:1,Var('MONELOCA'))
                    *messagebox("insert 1 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONELOCA:"~Var('MONELOCA'))
                    (.'GRABESPMER'.)
                    ACT(ES:1,Dialogo.String1~'C')
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERSWIFT'))
                    ACT(ME:3,Var('MERSWIFT'))
                    ACT(MO:1,Var('MONEEXTR'))
                    *messagebox("insert 2 MERCACV:"~Var('MERCACV')~" MERSWIFT:"~Var('MERSWIFT')~" MERSWIFT:"~Var('MERSWIFT')~" MONEEXTR:"~Var('MONEEXTR'))
                    (.'GRABESPMER'.)
                    ACT(ES:1,Dialogo.String1~'D')
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERCBCRA'))
                    ACT(ME:3,Var('MERCADOBT'))
                    ACT(MO:1,Var('MONEEXTR'))
                    *messagebox("insert 3 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONEEXTR:"~Var('MONEEXTR'))
                    (.'GRABESPMER'.)
                    ACT(ES:1,Dialogo.String1~'X')
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERCBCRA'))
                    ACT(ME:3,Var('MERCADOBT'))
                    ACT(MO:1,Var('MONELOCA'))
                    *messagebox("insert 1 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONELOCA:"~Var('MONELOCA'))
                    (.'GRABESPMER'.)
                    ACT(ES:1,Dialogo.String1~'Z')
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERSWIFT'))
                    ACT(ME:3,Var('MERSWIFT'))
                    ACT(MO:1,Var('MONEEXTR'))
                    *messagebox("insert 2 MERCACV:"~Var('MERCACV')~" MERSWIFT:"~Var('MERSWIFT')~" MERSWIFT:"~Var('MERSWIFT')~" MONEEXTR:"~Var('MONEEXTR'))
                    (.'GRABESPMER'.)
                    ACT(ES:1,Dialogo.String1~'Y')
                    ACT(ME:1,Var('MERCACV'))
                    ACT(ME:2,Var('MERCBCRA'))
                    ACT(ME:3,Var('MERCADOBT'))
                    ACT(MO:1,Var('MONEEXTR'))
                    *messagebox("insert 3 MERCACV:"~Var('MERCACV')~" MERCBCRA:"~Var('MERCBCRA')~" MERCADOBT:"~Var('MERCADOBT')~" MONEEXTR:"~Var('MONEEXTR'))
                    (.'GRABESPMER'.)
                endif
                *si el anterior tiene parametros los borro
                if sql("select count(*) from "~DBO~".ESPECIESMERCADOS where Codigo ='"~Dialogo.String3~"' or Codigo ='"~Dialogo.String3~"C' or Codigo ='"~Dialogo.String3~"D' or Codigo ='"~Dialogo.String3~"X' or Codigo ='"~Dialogo.String3~"Y' or Codigo ='"~Dialogo.String3~"Z' ")<>0
                    SQL.ADD("Delete "~DBO~".ESPECIESMERCADOS          where Codigo ='"~Dialogo.String3~"' or Codigo ='"~Dialogo.String3~"C' or Codigo ='"~Dialogo.String3~"D' or Codigo ='"~Dialogo.String3~"X' or Codigo ='"~Dialogo.String3~"Y' or Codigo ='"~Dialogo.String3~"Z' ")
                    SQL.NEW
                    SQL.EXEC
                endif
            endif
            if [EqStr(Dialogo.String1,'') o vacio(Dialogo.String1)]
               SQL.ADD("Delete "~DBO~".ESPECIESMERCADOS where ESPECie =  '"~Dialogo.especie1~"'")
               *Messagebox("Blanqueo Delete "~DBO~".ESPECIESMERCADOS where ESPECie =  '"~Dialogo.especie1~"'")
               SQL.NEW
               SQL.EXEC
            endif
        endif
     Endif
  Endif

