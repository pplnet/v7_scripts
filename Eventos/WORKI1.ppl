*- Chequea  las operaciones segun sus caracteristicas y determina el 
*- grupo para saber a que instancias 
*-HojaVisible(SI)
CrearDialogo
   NrOperacion1: 'NrOper' ;;;;;;;;;'AO000030';;;;;;;;;;;;;;
   TipoOp1     : 'TipoOp' ;;;;;;;;;'MMCP';;;;;;;;;;;;;;
   String1     : 'Instancias'  ;;;;;;;;;"Instancia In (14,15)";;;;;;;;;;;;;;
FinDialogo
If Not Ok
   Cancelar
EndIf

*- Actualizo la variable SECTORRB para ver si esta dentro o fuera de lo parametros de MERCADO
SQL.ADD("UPDATE "~DBO~".OPERACIONES SET ")
SQL.ADD("SectorRB=(SELECT COUNT(*) FROM  "~DBO~".EXCEPCIONES Where NrOperacion='"~Dialogo.NrOperacion1~"' and Tipo='RANGOPRECI') ")
SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC


ACT(p1,VAR('WPLAZO1'))
ACT(p2,VAR('WPLAZO2'))
ACT(m1,VAR('WMONTO1'))
ACT(m2,VAR('WMONTO2'))

*- Condicion para que vaya a Gerente o CEO 
*- Al primer cumplimiento de condicion se para en esa instancia
SQL.ADD("SELECT Instancia,Condicion FROM  "~DBO~".TIPOSOPCONDICIONES WHERE TipoOp='"~Dialogo.TipoOp1~"' ")
If NoVacio(Dialogo.String1)
   SQL.ADD("and "~Dialogo.String1)
EndIf
SQL.ADD(" Order By Instancia")

Recorrer SQL
  dfa
  *-messagebox(FBN['Condicion'])
  ACT(a1,ReemplazarSTR(FBN['Condicion'],"WPLAZO1",VAL(P1),SI) )
  ACT(a11,ReemplazarSTR(val(a1),"WPLAZO2",VAL(P2),SI) )
  ACT(a12,ReemplazarSTR(val(a11),"WMONTO1",VAL(M1),SI) )
  ACT(a13,ReemplazarSTR(val(a12),"WMONTO2",VAL(M2),SI) )
  ACN(a2,FBN['Instancia'])
  SQL.ADD("SELECT COUNT(*) as Cuenta FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND "~val(a13)~" ")
  *-messagebox("SELECT COUNT(*) as Cuenta FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' AND "~val(a13)~" ")
  Recorrer SQL
    dfa
    ACN(n1,FBN['Cuenta'])
  Proximo
  *-messagebox(val(n1))
  If val(n1)>0 
     *-Derivo Operacion '~Dialogo.NrOperacion1~' a '~Fstr(val(a2),0,0)~" !!!!
     *- Este es el caso de operaciones de grupo 2 y 3 que necesitan solo una autorizacion
     *- de los gerentes => Actualizo Intereses Corridos
     SQL.ADD("UPDATE "~DBO~".OPERACIONES SET ")
     SQL.ADD("InteresesCorr=1 ")
     SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
  EndIf
Proximo

SQL.EXEC

   
