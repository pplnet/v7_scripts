MostrarCuadroDeMensajes
CrearDialogo
  Fecha1: 'Fecha'     ;;;;;;;;;FSYS
  Radio1: 'TipoCta|Intermedia|Pagadora|Ambas';;;;NO;NO;;;;1
  Lista1: 'Vehiculos' ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))
  Lista2: 'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3: 'Cuentas'   ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~ ") "~IIF(Dialogo.Radio1=0, " AND TipoCuenta='INT' ", IIF(Dialogo.Radio1=1, " AND Pagadora='SI' ", " AND (Pagadora='SI' OR TipoCuenta='INT') " ))~"  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') " ) )~"  ");
  Check2: 'HojaVisible';;1;;;;;;;1
  Check1: 'Confirma'  ;;;;NO;NO;;;;0
FinDialogo

If Not Ok
  Cancelar
Endif

EjecutarEvento('BPBD1',Fecha1=Dialogo.Fecha1,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Check2=Dialogo.Check2,Check1=0,Radio1=Dialogo.Radio1)