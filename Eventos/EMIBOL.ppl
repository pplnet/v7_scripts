* ESTE EVENTO TOMA LAS OPERACIONES QUE ESTAN EN LA INSTANCIA
* EMISION DE BOLETOS Y LAS PASA A LA INSTANCIA LIQUIDACION (10)
* Antes an el caso de No mae mandaba a (80) - Confirmacion pero ahora 10
* O INFORMAR AL MAE (60) para bajas de ofertas
SQL.ADD("Select O.NrOperacion, O.TipoOp, O.PaseCB, O.CB10, ")
* FJL 26/07/19- Raiden - Baja de Ofertas
SQL.ADD("       O.CB5, O.Rojo, ")
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
SQL.ADD("       O.Cuenta1, O.Cuenta2, O.Cuenta3, O.Cuenta4, ")
* FJL 26/01/21 - Control de Cuentas Comisiones
SQL.ADD("       O.CB4, O.Cuenta5, O.Cuenta6, ")
* AA 11/02/21 - Garantizado va a instancia 13
SQL.ADD("       O.UDN2 Rueda ")
SQL.ADD("  from "~DBO~".OPERACIONESBITS OB, "~DBO~".OPERACIONES O")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 67 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD(" Order by O.NrOperacion ")
Recorrer SQL
* FJL 11/04/18 - Por TCOPRI de contingencia
  if Incluido(fbn('TipoOp'),'TCOPRI') y fbn('CB10')=1
** FJL 15/07/21 - Cambia workflow para TCOPRI por Contingencia
*    EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=80)
    ACT(a:1, 'SI')
    if Vacio(fbn('Cuenta1')) o Vacio(fbn('Cuenta2')) o Vacio(fbn('Cuenta3')) o Vacio(fbn('Cuenta4')) 
      ACT(a:1, 'NO')
    endif
    if EqStr(Val(a:1),'SI')
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=10)
    else
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=7)
    endif
  else
* FJL 26/07/19- Raiden - Baja de Ofertas
    if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV') and fbn('CB5')=1 and fbn('Rojo')=1
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=60)
    else
      * PZ 02/09/2019 por Raiden se agrega una inst intermedia
      if Eqstr(VAR('INSTALACIO'),'MLASA')
         IF incluido(fbn['Rueda'],Var('RUECPC1'))
            EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=13)
         else   
            EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=68)
         Endif   
      else   
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
*        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=10)
        ACT(a:1, 'SI')
        if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV|TCOPRI')
          if Vacio(fbn('Cuenta1')) o Vacio(fbn('Cuenta2')) o Vacio(fbn('Cuenta3')) o Vacio(fbn('Cuenta4')) 
            ACT(a:1, 'NO')
          endif
        endif
* FJL 26/01/21 - Control de Cuentas Comisiones
        if Incluido(fbn('TipoOp'),'TIC|TIV') y fbn('CB4')=1 
          if Vacio(fbn('Cuenta5')) o Vacio(fbn('Cuenta6'))
            ACT(a:1, 'NO')
          endif
        endif
        IF incluido(fbn['Rueda'],Var('RUECPC1'))
           EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=13)
        Else
          if EqStr(Val(a:1),'SI')
             EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=10)
          else
             EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=67, Entero2=7)
          endif
        Endif
      endif   
    endif
  endif
