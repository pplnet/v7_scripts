SQL.NEW

** FJL 23/04/20 - 
if Dialogo.Fecha1>0
  ACT(aa2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~FStr(Dialogo.Entero4,2,0)~':'~FStr(Dialogo.Entero5,2,0)~':'~FStr(Dialogo.Entero6,2,0))  
  ACT(ho1,PAD0(Dialogo.Entero4,2)~':'~PAD0(Dialogo.Entero5,2)~':'~PAD0(Dialogo.Entero6,2))  
  If Dialogo.Radio1=0
     ACD(fe:1, SQL("SELECT FechaOp FROM "~DBO~".OPERACIONES  WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  "))
  Else
     ACD(fe:1, SQL("SELECT FechaOp FROM "~DBO~".BOPERACIONES  WHERE NrOperacion='"~Dialogo.NrBOperacion~"'  "))
  Endif
  ** Verificar si hay Orden asociada
  **ACN(or:1, SQL("SELECT 1 FROM "~DBO~".ORDENES  WHERE NrOperacion='"~Val(op:1)~"'  "))
  ACN(or:1, SQL("SELECT 1 FROM "~DBO~".LIBORDENES  WHERE NrOperacionRef='"~Val(op:1)~"'  "))  

  ** AA -- 04-05-2023 Actualizacion fecha y hora Orden
  
  ACT(A2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~PAD0(Dialogo.Entero4,2)~':'~PAD0(Dialogo.Entero5,2)~':'~PAD0(Dialogo.Entero6,2))  
  SQL.ADD("Update ")
  SQL.ADD(" "~DBO~".ORDENES SET         ")
  SQL.ADD("FechaAltaMAE  = Convert(datetime,'"~Val(A2)~"',120), ")
  SQL.ADD("HoraOrden = '"~Val(ho:1)~"' ")    
  SQL.ADD("where NrOperacion2 = '"~Val(op:1)~"'")
  SQL.NEW
 
  If Val(or:1) <> 1

    SQL.ADD(" Insert into "~DBO~".LIBORDENES ( ")
    SQL.ADD(" Mercado, Fecha,  FechaOP, NrOperacionRef, FechaHo,  HoraOp, SecuenciaHO, Agente  ")
    SQL.ADD(" ) Values ( ")
    SQL.ADD(" '1', ")
    SQL.ADD(" "~IdxDate2(FSys)~", ")
    SQL.ADD(" "~IdxDate2(val(fe:1))~", ")
    SQL.ADD(" '"~Val(op:1)~"', ")
    SQL.ADD(" "~IdxDate2(val(fe:1))~", ")
    SQL.ADD(" '"~Val(ho:1)~"', ")
    SQL.ADD(" '"~Copy(Pad0(Dialogo.String4,8),1,8)~"', ")
    SQL.ADD(" '"~VAR('AGESIOP')~"' ")
    SQL.ADD(" ) ")
    SQL.NEW

  Else
    SQL.ADD("Update ")
    SQL.ADD(" "~DBO~".LIBORDENES SET         ")
    SQL.ADD("FechaHO = "~IdxDate2(val(fe:1))~", HoraOp = '"~Val(ho:1)~"', SecuenciaHO = '"~Copy(Pad0(Dialogo.String4,5),1,5)~"'  ")
    SQL.ADD("where NrOperacionRef = '"~Val(op:1)~"'")
    SQL.NEW
  Endif
endif
SQL.EXEC

SQL.ADD("SELECT *  FROM "~DBO~".EJECUCIONES ")   
SQL.ADD(" WHERE NrOperacion= '"~Val(op:1)~"'")
ACN(xy:1,0)
Recorrer SQL

   SCN(xy:1,1)
   act(z:Val(xy1),FBN['NrEjecucion'])
   act(a:Val(xy1),FBN['NrOrden'])
   act(b:Val(xy1),FBN['NrOperacion'])
   acn(c:Val(xy1),FBN['Cantidad'])
   acn(d:Val(xy1),FBN['Precio'])
   act(e:Val(xy1),FBN['NrSecuencia'])
   acd(f:Val(xy1),FECHA(FBN['Fecha']))
   acn(g:Val(xy1),Num(Copy(HORA(FBN['Fecha']),1,2)) )
   acn(h:Val(xy1),Num(Copy(HORA(FBN['Fecha']),4,2)) )
   acn(i:Val(xy1),Num(Copy(HORA(FBN['Fecha']),7,2)) )
    
Proximo

If Val(xy:1) > 0

     CrearListBox;'Arial,8,';'Actualizacion de Ejecuciones Ordenes'
          'NrOrden'       ;a:1..a:Val(xy1);NO;;; 70;STRING;;RGB(250,250,193)
          'NrOperacion'   ;b:1..b:Val(xy1);NO;;; 70;STRING;;RGB(250,250,193)
          'Cantidad'      ;c:1..c:Val(xy1);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)  
          'Precio'        ;d:1..d:Val(xy1);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)  
          'Secuencia'     ;e:1..e:Val(xy1);NO;;; 70;STRING;;RGB(250,250,193)
          'Fecha Eje'     ;f:1..f:Val(xy1);SI;;; 75;FECHA;;
          'Hora Eje'      ;g:1..g:Val(xy1);SI;Val(g:flb)<24;'La hora debe ser menor a 24'; 60;NUMERO;'##';
          'Min. Eje'      ;h:1..h:Val(xy1);SI;Val(h:flb)<60;'Los minutos no pueden ser superiores a 60'; 60;NUMERO;'##';
          'Seg. Eje'      ;i:1..i:Val(xy1);SI;Val(i:flb)<60;'Los segundos no pueden ser superiores a 60'; 60;NUMERO;'##';
      FinListBox

  If Not Ok
    Cancelar
  Endif
    
  Recorrer&i 1,Val(xy1)
      ACT(xy2,Copy(Val(f:&i),7,4)~'-'~Copy(Val(f:&i),4,2)~'-'~Copy(Val(f:&i),1,2)~' '~PAD0(Val(g:&i),2)~':'~PAD0(Val(h:&i),2)~':'~PAD0(Val(i:&i),2))  
  
      SQL.ADD("update "~DBO~".EJECUCIONES ")
      SQL.ADD("   set Fecha = Convert(datetime,'"~Val(xy2)~"',120) ")
      SQL.ADD(" where NrOperacion = '"~Val(b:&i)~"'  and NrEjecucion = '"~Val(z:&i)~"' ")
      SQL.NEW
      SQL.EXEC
  Proximo
  
Endif
  
Messagebox('Operacion modificada con exito')
