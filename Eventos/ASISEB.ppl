***MAC 14/08/2023 Actualiza numero de boleto

ACT(x:5,Var('LICINUMESP'))

If Dialogo.Radio1=0 y no EqStr(BuscarCampo('OPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrOperacion1), Dialogo.String2)
    ** Si es mae y no tiene boleto
    if EqStr(BuscarCampo('OPERACIONES','Mercado4','Nroperacion',Dialogo.Nroperacion1),'MAE') y Vacio(BuscarCampo('OPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrOperacion1))
       ACT(es:1, BuscarCampo('OPERACIONES','Especie','Nroperacion',Dialogo.Nroperacion1))
       if EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
           ** TCOPRI = SI
           ACT(y:1, GetNumerador(1098))
       else 
           ACT(x:1, BuscarCampo('ESPECIES','CodMAEContado','Codigo',val(es:1)))
           if EqStr(Val(x:5), 'SI')
               ** LICINUMSEP = SI
               if NoVacio(Val(x:1))
                   ACT(y:1, GetNumerador(98))
               else
                   ACT(y:1, GetNumerador(99))
               endif
           endif
       endif
       SQL.ADD("NrBoleto  = '"~val(y:1)~"',")
    else
        if Eqstr(BuscarCampo('OPERACIONES','Mercado4','Nroperacion',Dialogo.Nroperacion1),'MAE') y no Eqstr(BuscarCampo('OPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrOperacion1),Dialogo.string2)
            if NoVacio(Dialogo.String2)  
                SQL.ADD("NrBoleto  = '"~Copy(Pad0(Dialogo.String2,8),1,8)~"',")
                ACT(es:1, BuscarCampo('OPERACIONES','Especie','Nroperacion',Dialogo.Nroperacion1))
                ACT(x:1, BuscarCampo('ESPECIES','CodMAEContado','Codigo',val(es:1)))
                if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                   *ACT(y:1, GetNumerador(1098))
                   ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 1098"))
                   if num(Dialogo.String2)=val(nr:1)+1
                         sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '1098'")
                   endif
                else
                   if NoVacio(Val(x:1))
                       *ACT(y:1, GetNumerador(98))
                       ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 98"))
                       if num(Dialogo.String2)=val(nr:1)+1
                           sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '98'")
                       endif
                   else
                        *ACT(y:1, GetNumerador(99))
                        ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 99"))
                        if num(Dialogo.String2)=val(nr:1)+1
                            sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '99'")
                        endif
                    endif
                endif     
            else
                 SQL.ADD("NrBoleto  = Null, ")
            EndIf
        else 
            if Eqstr(BuscarCampo('OPERACIONES','Mercado4','Nroperacion',Dialogo.Nroperacion1),'BYMA') y vacio(BuscarCampo('OPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrOperacion1))
            if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                    ACT(y:1, GetNumerador(1096))
                else
                    ACT(y:1, GetNumerador(96))
                endif
                SQL.ADD("NrBoleto  = '"~val(y:1)~"',")
            else 
                if NoVacio(Dialogo.String2)  
                   SQL.ADD("NrBoleto  = '"~Copy(Pad0(Dialogo.String2,8),1,8)~"',")
                   if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 1096"))
                      if num(Dialogo.String2)=val(nr:1)+1
                        SQL("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '1096'")
                      endif
                   else
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 96"))
                      if num(Dialogo.String2)=val(nr:1)+1
                          SQL("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '96'")
                      endif
                   endif
                else
                    SQL.ADD("NrBoleto  = Null, ")
                EndIf
            endif
        endif
    endif
else
    if Dialogo.Radio1=1 y no Eqstr(BuscarCampo('BOPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrbOperacion),Dialogo.String2)
        if Eqstr(BuscarCampo('BOPERACIONES','Mercado4','Nroperacion',Dialogo.Nrboperacion),'MAE') y vacio(BuscarCampo('BOPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrOperacion1))
           ACT(es:1, BuscarCampo('BOPERACIONES','Especie','Nroperacion',Dialogo.Nrboperacion))
           if EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
               ** TCOPRI = SI
               ACT(y:1, GetNumerador(1098))
           else 
               ACT(x:1, BuscarCampo('ESPECIES','CodMAEContado','Codigo',val(es:1)))
               if EqStr(Val(x:5), 'SI')
               ** LICINUMESP = SI
                   if NoVacio(Val(x:1))
                       ACT(y:1, GetNumerador(98))
                   else
                       ACT(y:1, GetNumerador(99))
                   endif
               endif
           endif
           SQL.ADD("NrBoleto  = '"~val(y:1)~"',")
        else
           if Eqstr(BuscarCampo('BOPERACIONES','Mercado4','Nroperacion',Dialogo.Nrboperacion),'MAE') y no eqstr(BuscarCampo('BOPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrbOperacion),Dialogo.string2)
              if NoVacio(Dialogo.String2)  
                 SQL.ADD("NrBoleto  = '"~Copy(Pad0(Dialogo.String2,8),1,8)~"',")
                 ACT(es:1, BuscarCampo('BOPERACIONES','Especie','Nroperacion',Dialogo.Nrboperacion))
                 ACT(x:1, BuscarCampo('ESPECIES','CodMAEContado','Codigo',val(es:1)))
                 if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                   *ACT(y:1, GetNumerador(1098))
                   ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 1098"))
                   if num(Dialogo.String2)=val(nr:1)+1
                      sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '1098'")
                   endif
                 else
                   if NoVacio(Val(x:1))
                      *ACT(y:1, GetNumerador(98))
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 98"))
                      if num(Dialogo.String2)=val(nr:1)+1
                         sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '98'")
                      endif
                   else
                      *ACT(y:1, GetNumerador(99))
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 99"))
                      if num(Dialogo.String2)=val(nr:1)+1
                         sql("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '99'")
                      endif
                   endif
                 endif 
              else
                 SQL.ADD("NrBoleto  = Null, ")
              EndIf
           else 
             if Eqstr(BuscarCampo('BOPERACIONES','Mercado4','Nroperacion',Dialogo.Nrboperacion),'BYMA') y vacio(BuscarCampo('BOPERACIONES','NrBoleto'  ,'NrOperacion',Dialogo.NrbOperacion))
                if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                    ACT(y:1, GetNumerador(1096))
                else
                    ACT(y:1, GetNumerador(96))
                endif
                SQL.ADD("NrBoleto  = '"~val(y:1)~"',")
             else 
                if NoVacio(Dialogo.String2)  
                   SQL.ADD("NrBoleto  = '"~Copy(Pad0(Dialogo.String2,8),1,8)~"',")
                   if EqStr(Val(x:5), 'SI') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TCOPRI')
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 1096"))
                      if num(Dialogo.String2)=val(nr:1)+1
                        SQL("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '1096'")
                      endif
                   else
                      ACN(nr:1,sql("select numero from "~DBO~".numeradores where codigo = 96"))
                      if num(Dialogo.String2)=val(nr:1)+1
                          SQL("update "~DBO~".numeradores set numero = "~Dialogo.String2~" where codigo = '96'")
                      endif
                   endif
                else
                    SQL.ADD("NrBoleto  = Null, ")
                EndIf
             endif
           endif
        endif
    endif
endif

