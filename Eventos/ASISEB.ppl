if Dialogo.Fecha1>0
  ACT(A2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~PAD0(Dialogo.Entero1,2)~':'~PAD0(Dialogo.Entero2,2)~':'~PAD0(Dialogo.Entero3,2))  
