CrearDialogo
  Fecha1:       'F.Liquid'  ;;;;;;;;;Fsys
  Mercado1:     'Mercado';
FinDialogo

if not Ok
  Cancelar
endif

If Vacio(Dialogo.Mercado1)
   act(z2," ")
  else
   act(z2,"and T.Mercado1 = '"~Dialogo.Mercado1~"' ")
endif

SQL.ADD(" Select T.NrTrans,T.Fecha2,T.Cliente1,T.TipoTr2,T.Especie, T.Especie1, T.Cantidad1,T.Cantidad2, T.Cuenta5, ")
SQL.ADD("        T.CB8, T.CB7 ,T.CB6 ,T.Mercado1 ,T.CB1, E.Tipo, T.CB5 , T.CB3, T.Cantidad4                         ")
SQL.ADD("   from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O, "~DBO~".ESPECIES E ")
SQL.ADD(" where  T.NrTrans = O.NrOperacion ")
SQL.ADD(" AND    T.Especie = E.Codigo      ")
SQL.ADD(" AND    (E.Tipo = 'MON' OR  T.Mercado1 <> 'AC')   ")

*Se agrega instancia 8 para transacciones falladas. CAL 28/11/2022
SQL.ADD(" and    O.NrBit In (3,6,8,70) and O.Valor ='1'      ")

*fo28/11/2005SQL.ADD(" and    (T.CB1 Is Null or T.CB1 ='') ")
* la marca de impreso para AC es el CB5, resto CB1
* FJL 07/11/18 - En BofA se pueden reemprimir - Pto 5 Issue 3351
*SQL.ADD(" and    ((T.CB1 Is Null or T.CB1 ='') OR T.Mercado1  = 'AC') ")
*SQL.ADD(" and    ((T.CB5 Is Null or T.CB5 ='') OR T.Mercado1 <> 'AC') ")
SQL.ADD(" and    T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and    T.TipoTr2 In ('RET','DEP','COMP','MATCH') ")
SQL.ADD(" and    (T.Cuenta2 Is Not Null or T.TipoTr2 = 'COMP' OR T.Mercado1='AC') ")
SQL.ADD(Val(z2))
SQL.ADD(" order by T.NrTrans ")

watch(SQL.Batch)

acn(z1,0)
Recorrer SQL
    SCN(z1,1)
    ACT(a:Val(z1), fbn['NrTrans'])
    ACT(b:Val(z1), fbn['Fecha2'])
    ACT(c:Val(z1), fbn['Cliente1'])
    ACT(d:Val(z1), fbn['TipoTr2'])
    ACT(e:Val(z1), fbn['Especie'])
    if EqStr(fbn['TipoTr2'],'MATCH')
      ACT(e:Val(z1), Val(e:Val(z1))~'/'~fbn['Especie1'])
    endif
    if EqStr(fbn['TipoTr2'],'RET')
      *Si es una transacción fallada, se muestra lo que se pagó. Si no, el total. CAL 28/11/2022
      if(fbn['CB3'] = 1)
        ACN(f:Val(z1), -fbn['Cantidad4'])
      else
        ACN(f:Val(z1), -fbn['Cantidad1'])
      endif
    else
      if(fbn['CB3'] = 1)
        ACN(f:Val(z1), fbn['Cantidad4'])
      else
        ACN(f:Val(z1), fbn['Cantidad1'])
      endif
    endif
    if EqStr(fbn['TipoTr2'],'MATCH')
      ACN(g:Val(z1), fbn['Cantidad2'])
    else
      ACT(g:Val(z1), ' ')
    endif
    if EqStr(fbn['Cuenta5'],'CV')
      if fbn['CB8']=1
        ACT(g:Val(z1), 'CONF')
      endif
      if fbn['CB6']=1
        ACT(g:Val(z1), 'DVP')
      endif
      if fbn['CB7']=1
        ACT(g:Val(z1), 'RVP')
      endif
    endif
    ACT(h:Val(z1), ' '~fbn['Mercado1'])
    ACT(aa:Val(z1), fbn['Mercado1'])
    ACT(ab:Val(z1), fbn['CB1'])
    ACT(ac:Val(z1), fbn['Tipo'])
    ACT(ad:Val(z1), fbn['CB5'])
proximo

if Val(z1)=0
  Cancelar('No existen Vouchers para imprimir')
else
  ACO(1,9)
  ACO(2,11)
  ACO(3,11)
  ACO(4,7)
  ACO(5,11)
  ACO(6,15)
  ACO(7,15)
  ACO(8,7)
  FormatoCeldas(f1..f:Val(z1),Exe('F2'))
  FormatoCeldas(g1..g:Val(z1),Exe('F2'))
        
*  ListBox(a:1..h:Val(z1),'Voucher  Fecha      Cliente    Tipo   Especie           Cantidad       Moneda')
  ListBox(a:1..h:Val(z1),'Voucher     Fecha         Cliente      Tipo      Especie              Cantidad       Moneda')
        
  if Ok
    recorrerSel
      *** Para no permitir sacar copias solo imprime los originales***
*FO28/11/2005      If Not EqStr(Val(ab:FilaCiclo),'1')
* FJL 07/11/18 - En BofA se pueden reemprimir - Pto 5 Issue 3351
*      If [Not EqStr(Val(ab:FilaCiclo),'1') y Not EqStr(Val(aa:FilaCiclo),'AC')] o [Not EqStr(Val(ad:FilaCiclo),'1') y EqStr(Val(aa:FilaCiclo),'AC')]
       
        if Not Incluido(Val(aa:FilaCiclo), VAR('MERCTITULO'))
          If EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0')
          LinkearHoja('EVOUV1',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=0,string='')
          else
            LinkearHoja('EVOUV1',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=0,string='')
          endif
        endif
IF NO        
        if EqStr(Val(aa:FilaCiclo),'CRYL')
           If EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0')
              LinkearHoja('EVOUR1',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=0)
           else
              LinkearHoja('EVOUR1',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=0)
           endif
        endif
ENDIF        
        if Incluido(Val(aa:FilaCiclo),'CE|EU|CRYL')
           If EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0')
              LinkearHoja('EVOUE1',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=0,Mercado1=Val(aa:FilaCiclo))
           else
              LinkearHoja('EVOUE1',1,NrTrans1=Val(a:FilaCiclo),Check1=1,Check3=0,Mercado1=Val(aa:FilaCiclo))
           endif   
        endif

IF NO
        if Incluido(Val(aa:FilaCiclo),'AC') y Incluido(Val(ac:FilaCiclo),'MON')
           LinkearHoja('EVOUA1',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=0)
        endif
endif
        
        if Incluido(Val(aa:FilaCiclo),VAR('MERCAACMC'))
           LinkearHoja('EVOUM1',1,NrTrans1=Val(a:FilaCiclo),Check1=0,Check3=0,string='')
        endif
        
        * Marca de ya impreso  
        If [EqStr(Val(ab:FilaCiclo),'') o EqStr(Val(ab:FilaCiclo),'0') Y not Incluido(Val(aa:FilaCiclo),'AC')] o [EqStr(Val(ad:FilaCiclo),'') o EqStr(Val(ad:FilaCiclo),'0') Y Incluido(Val(aa:FilaCiclo),'AC')]
           SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
           If not Incluido(Val(aa:FilaCiclo),'AC')
              SQL.ADD("Set    CB1 = '1' ") 
           Else
              SQL.ADD("Set    CB5 = '1' ") 
           Endif
           SQL.ADD("where  NrTrans = '"~Val(a:FilaCiclo)~"' ") 
           SQL.NEW
           SQL.EXEC 
        Endif     
* FJL 07/11/18 - En BofA se pueden reemprimir - Pto 5 Issue 3351
*      Endif 
    proximo
  endif
endif  
