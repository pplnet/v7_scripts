CrearDialogo
  Fecha1 : 'Fecha';;;;;;;;;FSys
FinDialogo

MostrarCuadrodeMensajes

If not Ok
   Cancelar
endif

ACN(ci1,0)

SQL.ADD("Update "~DBO~".VARIABLES ")
SQL.ADD("Set Valor = 'NO'")
SQL.ADD("where Codigo = 'DESCONFLU'")
SQL.NEW
SQL.EXEC

Repetir

  SCN(ci1,1)
  Message('Corrida numero: '~FStr(val(ci1),0,0))

  If Trunc(val(ci1)/100)*100 = val(ci1)
     If EqStr(Var('MAILPOSIC'), 'SI')
        Message('Control de Limites de Posicion')
        EjecutarEvento('LIMPOS')
     Endif
  Endif

  *- Actualizo cotizaciones desde Bloomberg
  If (val(ci1) Mod 5)=0 o val(ci1)=1
     Message('Cotizaciones de Bloomberg ....')
     EjecutarEvento('ACTCOT')
  EndIf

  *--------------------------------------
  *- Limits/WorkFl y Limrwd es Un Grupo
  EjecutarEvento('LIMITS')

  EjecutarEvento('WORKFL')

  EjecutarEvento('LIMRWD')
  *--------------------------------------

  *- Llamador Interfaz CAP-SIAF
  EjecutarEvento('I00002',String=VAR('CAPORG'),String1=VAR('CAPDST'),Radio1=0,Radio2=0,Radio3=1,Radio4=1)

  *- Llamada Eventos de Datanet
  EjecutarEvento('DATANE')

  EjecutarEvento('WORKFL')

  If EqStr(Var('DESCONFLU'),'SI')
     Message('Termina Control de operaciones')
     Cancelar('Control de Flujo Cancelado. Corrio '~FStr(val(ci1),0,0)~' veces.')
  Endif      

Proximo
 	