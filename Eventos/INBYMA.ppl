HojaVisible(SI)
Mostrarcuadrodemensajes
GrillaVisible(SI)
CrearDialogo
   Fecha1   : 'Fecha Cotizacion';;;;;;Dialogo.Fecha1<=FSYS;"Fecha Incorrecta ";NO;Habiles(FSys,-1,Var('FERIDEF'))
   String   : 'Archivo';;;;;;;;;;VAR('PATHINBYMA')
   Vehiculo1: 'Vehiculo';;;;;;NOVACIO(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
FinDialogo

if Not Ok
  Cancelar
endif  

*(.'ABCDARIO'.)
AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))


*-- Verif. existencia archivo--
If Not ExisteArchivo(Dialogo.String)
   MESSAGEBOX("No existe el archivo "~Dialogo.String~" de precios ")
   Cancelar
endif

ACT(z0,'Inicio/Fin Bloque datos')


*------------- Informe -------------------------------
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)
ACT(a:FAC, 'Interfase Precios BYMA')
SetFont(a:FAC..a:FAC,3)
ACT(a:FAC+2, 'Fecha: '~Dialogo.Fecha1)


ACT(a:FAC+4, 'Codigo Byma')
ACT(b:FAC+4, 'Especie')
ACT(c:FAC+4, 'Moneda')
ACT(d:FAC+4, 'UnidadPrecio')
ACT(e:FAC+4, 'Vencimiento')
ACT(f:FAC+4, 'Ultimo Precio')
ACT(g:FAC+4, 'Total Negociado')
ACT(h:FAC+4, 'Precio Max')
ACT(i:FAC+4, 'Precio Min')
ACT(j:FAC+4, 'Precio Prom')

AlinearCeldas(d:FAC+4..e:FAC+4,'D')
SetFont(a:fac+4..j:FAC+4,2)
AgregarMarco(a:FAC+4..j:FAC+4,2,0,Exe('COLOR6'))

SetFilaActual(FAC+4)
ACN(w1,FAC)

*--- Fila Impresion Informe---
ACN(z3,fac+1)

*--Variables Fin OK--
ACT(z4,'MAL')

AbrirASCII(Dialogo.String,0)

Recorrer&i 1,30000
   ACT(aa:1, LeerAscii)

*   acn(zz:1, 1)
   if Not Ok
      break
   else 
      ACT(z4,'OK')
   endif

*Tiporeg CodEspecie Vencimiento Ult.Precio TotalNeg PrecioMax PrecioMin PrecioProm
*E"A2E2 "0"2675"19000"2675"2675"2675
*E"A2E2 "2"2650"250000"2680"2635"2661.694
*E"A2E2D"2"96.7"554000"97.5"96.4"96.826
*E"A2E3D"0"90"4000"90"90"90
*E"A2E3D"1"90"4000"90"90"90
*E"A2E3D"2"89.7"6000"89.7"89.7"89.7

   *-Tipo Registro---------
   ACT(ab:1, COPY(VAL(aa:1),1,1) )
   If Not EqStr(Val(ab:1),'E')
      Break
   Endif
   
   ACN(ac:1,Longitud(Val(aa:1)))
   ACN(s:Val(z3),Longitud(Val(aa:1)))   
   
   ACN(z1,3) 
   
      *---Cod.Especie
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(a:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      * Buscar Codigo FPA de especie
     
      SQL.ADD("Select Especie,Moneda,UnidadPrecio From "~DBO~".ESPECIESMERCADOS Where Mercado = 'BYMA' and Codigo = '"~Val(a:Val(z3))~"' ")
      ACN(z10,0)
      Recorrer Sql
         ACN(z10,1)
         ACT(b:Val(z3), FBN['Especie'])
         ACT(c:Val(z3), FBN['Moneda'])
         ACN(d:Val(z3), FBN['UnidadPrecio'])
      Proximo
      
      *---Vencimiento
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      *      ACT(e:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)))
      ACT(e:Val(z3),COPY(VAL(aa:1),Val(z1),1))
      ACT(e:Val(z3),iif(Val(e:Val(z3))='0','0',iif(Val(e:Val(z3))='1','24','48')))
      ACN(z1,Val(z2)+1)

      *---Ultimo Precio Negociacion
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(f:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Total Negociado
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(g:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)
 
      *---Precio Maximo
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(h:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Precio Minimo
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(i:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Precio Promedio
      ACN(z2, VAL(ac:1))
      ACT(p:Val(z3),COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)+1  ) )
      
      *---Precio Promedio con Decimales
      ACN(z4,Longitud(VAL(p:Val(z3))))
      ACN(r:Val(z3),Val(z4))
      ACN(z2, Posicion('.',VAL(p:Val(z3)),1,Val(z4) )  )
      ACN(q:Val(z3), Val(z2))
      if Val(z2) > 0
         ACN(j:Val(z3),Num(COPY(VAL(p:Val(z3)),1,Val(z2)-1  )~COPY(VAL(p:Val(z3)),Val(z2)+1,Val(z4)-Val(z2)))/(10 ^ (Val(z4)-Val(z2))) )      
      Else
         ACN(j:Val(z3),Num(VAL(p:Val(z3))))
      Endif
      If Val(z10)=1
         if Val(d:Val(z3)) > 0
         *messagebox(Val(z10)~' '~Val(d:Val(z3)))
            ACN(j:Val(z3),Val(j:Val(z3))/Val(d:Val(z3)))
         Endif
      Endif
      
      ACN(z1,Val(z2)+1)
 
      If Val(z10)=1
         If SQL("select 1 from "~DBO~".COTIZACIONES where Codigo='"~Val(b:Val(z3))~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and Moneda ='"~val(c:Val(z3))~"'  and CallPut='CON' and PlazoLiq = '"~Val(e:Val(z3))~"' ")=0
            Message('Generando cotizaciones...')
            SQL.ADD("Insert into "~DBO~".COTIZACIONES ")
            SQL.ADD("(Fecha,Codigo,Moneda, PrecioContable,Precio1, PlazoLiq, FechaActualizacion, CallPut) ")
            SQL.ADD("Values ")
            SQL.ADD("("~IdxDate2(Dialogo.Fecha1)~",'"~Val(b:Val(z3))~"','"~val(c:Val(z3))~"', "~FSTR(val(j:Val(z3)),1,8)~", "~FSTR(val(j:Val(z3)),1,8)~", '"~Val(e:Val(z3))~"',"~SQLAhora~", 'CON')")
            SQL.New
            SQL.EXEC
         Else
            Message('Actualizando cotizaciones...')
            SQL.ADD("Update "~DBO~".COTIZACIONES ")
            SQL.ADD("   Set PrecioContable="~FSTR(val(j:Val(z3)),1,8)~", ")
            SQL.ADD("       Precio1="~FSTR(val(j:Val(z3)),1,8)~", ")            
            SQL.ADD("       FechaActualizacion= "~SQLAhora~" ")
            SQL.ADD("  where Codigo='"~Val(b:Val(z3))~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and Moneda ='"~val(c:Val(z3))~"'  and CallPut='CON' and PlazoLiq = '"~Val(e:Val(z3))~"' ")
            SQL.NEW
            SQL.EXEC
         Endif
      Endif
 
      *-- Incremento Linea de Impresion---
      SCN(z3,1)
  
Proximo

CerrarASCII


ACT(p:1, Copy(Dialogo.Fecha1,7,4)~Copy(Dialogo.Fecha1,4,2)~Copy(Dialogo.Fecha1,1,2))
act(p:2, Dialogo.String~' BYMA'~Val(p:1)~'.DAT')
IF ExisteArchivo(Dialogo.String) 
   WinExec('CMD.EXE /C "Ren '~Val(p:2)~'"',1)
ENDIF
SetFilaActual(Val(z3))

SetFont(a:Val(w1)+1..f:fac,1)
FormatoCeldas(j:Val(w1)+1..j:fac,Exe('F8'))

ACO(1,8)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)

Impresion(1,2)
