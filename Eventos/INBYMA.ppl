ACT(b:FAC, 'Aquellos Precios que no poseen Especie, Moneda y UnidadPrecio no han sido cargados en Cotizaciones - verifique EspeciesMercados')
SetFont(b:FAC,2)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

LimitesVision(j:FAC)
RangoTitulo(a:1..j:FAC, Val(w1))

