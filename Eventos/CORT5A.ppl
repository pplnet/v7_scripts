*HojaVisible(SI)
CrearDialogo
  Especie3 : 'Especie'     ;1;1;;  ;;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3,'TITULO');'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
  Especie1 : 'Cupon'       ; ; ;;NO;;;;;;BuscarCampo('ESPECIES','Alias3', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB' "
  Entero1  : 'Nr.Cupon'    ; ; ;;NO;;;;;;Num(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))
  Fecha1   :'F.Corte'      ; ; ;;NO;;;;;;IIF(Dialogo.Check5=1,FechaMaduracion(Dialogo.Especie3),SQL(" SELECT FechaCorte FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' "))
  Check1   : 'Anula_Espe'  ;;;;  ;;;;;0
  Check5     :'ZeroCoupon' ;;;;NO;SI;;;;;IIF(EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1)),1,0)
  Vehiculo1: 'Vehiculo'    ;1;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

If Not OK 
   Cancelar
EndIf

MostrarCuadroDeMensajes

ACT(ca:1, BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie3))

*--------------- ANULA LOS CORTES DE SALDOS, PENDIENTES y OPCIONES ---------------*

message(' Saldos, pendientes y opciones.')

SQL.ADD(" SELECT Especie2, Fecha1, Cliente1, Especie, Cupon1, Cantidad1, Precio1, Precio2, Precio3, ")
SQL.ADD(" Cambio1, Cambio2, NrTrans, NrOperacionRef1  ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" WHERE TipoTr2 = 'CUPON' ")
SQL.ADD(" AND   Especie = '"~Dialogo.Especie3~"'")
SQL.ADD(" AND   Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
SQL.ADD(" AND   Cupon1  = '"~FSTR(Dialogo.Entero1,1,0)~"'")
SQL.ADD(" ORDER BY Cliente1, NrTrans ")

ACN(z:1,0)
Recorrer SQL
  SQL.ADD(" SELECT Especie FROM "~DBO~".TRANSACCIONES2 ")
  SQL.ADD(" WHERE TipoTr2 IN ('CCUPON', 'PCUPON') ")
  SQL.ADD(" AND   Especie = '"~fbn('Especie2')~"'")
  SQL.ADD(" AND   Cupon1  = '"~FSTR(Dialogo.Entero1,1,0)~"'")
  SQL.ADD(" AND   Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
  SQL.ADD(" ORDER BY Cliente1, NrTrans ")  
  Recorrer SQL 
      Cancelar('Existen transacciones de Cobro o Pago para esta Especie '~fbn('Especie')~' y Cupon '~FSTR(Dialogo.Entero1,1,0))
  Proximo

  ACN(z:1,1)
  ACD(b:fac, fbn('Fecha1'))
  ACT(c:fac, fbn('Cliente1'))
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('Cupon1'))
  ACN(g:fac, fbn('Cantidad1'))
  ACN(h:fac, fbn('Precio1'))
  ACN(i:fac, fbn('Precio2'))
  ACN(j:fac, fbn('Precio3'))
  ACN(k:fac, fbn('Cambio1'))
  ACN(l:fac, fbn('Cambio2'))
  ACT(m:fac, fbn('NrTrans'))
  ACT(n:fac, fbn('NrOperacionRef1'))
  FormatoCeldas(a:fac..l:fac,EXE('F8'))
Proximo

IF Val(z:1)<>1
   MessageBox('No hay transacciones de Corte de Cupon para la Especie y Cupon solicitados')
ELSE
  CrearListBox ; 'Arial,8,'
    'OK'               ;a1..a:fac;SI;;;40;CHECK
    'Transaccion'      ;m1..m:FAC;NO;;;80;STRING;               ;RGB(220,220,193)
    'F.Corte'          ;b1..b:FAC;NO;;;70;STRING;               ;RGB(220,220,193)
    'Cliente'          ;c1..c:FAC;NO;;;70;STRING;               ;RGB(220,220,193)
    'Especie'          ;d1..d:FAC;NO;;;60;STRING;               ;RGB(220,220,193)
    'Cupon Ant.'       ;e1..e:FAC;NO;;;50;STRING;               ;RGB(220,220,193)
    'Cantidad'         ;g1..g:FAC;NO;;;120;NUMERO;'##,###,###,###.##';RGB(220,220,193)
    '%Renta'           ;h1..h:FAC;NO;;;80;NUMERO;'###.########' ;RGB(220,220,193)
    '%Amortizacion'    ;i1..i:FAC;NO;;;80;NUMERO;'###.########' ;RGB(220,220,193)
    '%Int.Capit.'      ;j1..j:FAC;NO;;;80;NUMERO;'###.########' ;RGB(220,220,193)
    '%V.Teorico Ant.'  ;k1..k:FAC;NO;;;80;NUMERO;'###.########' ;RGB(220,220,193)
    '%V.Teorico Act.'  ;l1..l:FAC;NO;;;80;NUMERO;'###.########' ;RGB(220,220,193)
    'Operacion'        ;n1..n:FAC;NO;;;80;STRING;               ;RGB(220,220,193)
  FinListBox

  IF NOT OK 
    Cancelar
  ENDIF

  Recorrer&i 1,fac
    IF Val(a:&i)=1

      message(Val(m:&i))

      SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS  WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE2 WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN2 WHERE NrOperacion = '"~Val(m:&i)~"'")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~Val(m:&i)~"'")
      SQL.NEW

      *- Borro las posiciones que quedaron en 0 por haber anulado las transacciones
      SQL.ADD(" DELETE FROM "~DBO~".POSICIONES WHERE Especie='"~Val(d:&i)~"' and CantidadFin=0 and PrecioFin=0 and Fecha='"~IdxDate(Dialogo.Fecha1)~"' and Vehiculo='"~Dialogo.Vehiculo1~"'")
      SQL.NEW

      *- Borro los saldos que quedaron en 0 por haber anulado las transacciones
      SQL.ADD(" DELETE FROM "~DBO~".SALDOSDIA WHERE Especie='"~Val(d:&i)~"' and Saldo=0 and Fecha='"~IdxDate(Dialogo.Fecha1)~"'  and EnteCustodia='"~Dialogo.Vehiculo1~"' ")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".SALDOS WHERE Especie = '"~Val(d:&i)~"' and Saldo=0  and EnteCustodia='"~Dialogo.Vehiculo1~"'  ")
      SQL.NEW

      message('Transaccion '~Val(m:&i)~' eliminada.')
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET RB4='0' WHERE NrOperacion = '"~Val(n:&i)~"' ")
      SQL.NEW
    ENDIF

    IF Dialogo.Check1=1
      SQL.ADD("UPDATE "~DBO~".ESPECIES ")
      SQL.ADD("SET Cupon = "~Val(e:&i)~", VTeorico = "~Val(k:&i)~" ")
      SQL.ADD("WHERE Codigo = '"~Val(d:&i)~"' ")
      SQL.NEW
      message(' Actualizando Especie. ')

      *----------- Modifico LA ESPECIE CUPON -------------*
      SQL.ADD("UPDATE "~DBO~".ESPECIES ")
      SQL.ADD("SET Cupon = "~FSTR(Num(Val(e:&i))-1,1,0)~", ")
      SQL.ADD("    FechaCorteCupon = NULL, ")
      SQL.ADD("    FechaPagoCupon = NULL, ")
      SQL.ADD("    VTeorico = 1 ")
      SQL.ADD("WHERE  Codigo = '"~Dialogo.Especie1~"' ")
      SQL.NEW
      message(' Actualizando Especie Cupon. ')

      *---------- Actualiza Tabla AgendaCupon ------------*
      SQL.ADD(" UPDATE "~DBO~".AGENDACUPONES SET ")
      SQL.ADD(" FechaProceso    =  NULL, ")
      SQL.ADD(" Estado          = 'PEN' ")
      SQL.ADD(" WHERE Especie = '"~Val(d:&i)~"' AND NrCupon = '"~Val(e:&i)~"' ")
      SQL.NEW
      message(' Actualizando Agenda de Cupones. ')
    ENDIF
  Proximo
  SQL.EXEC
ENDIF


*------------ ANULA LOS CORTES DE OP A LIQUIDAR ----------*

SQL.ADD(" SELECT Distinct O.* FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD(" where M.NrOperacion = O.NrOperacion ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and   M.Especie   = '"~Dialogo.Especie3~"' ")
SQL.ADD(" AND   M.Cupon     = '"~Val(ca:1)~"' ")
SQL.ADD(" and   O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.TipoOp In ('CFTC','CFTP','VFTC','VFTP') ")
SQL.ADD("  or (O.TipoOp In ('CTE','VTE') and CB6 = '1') ")
SQL.ADD("  or (O.TipoOp In ('CTP','VTP') and CB10 = '1')) ")
SQL.ADD(" and  RB4 = '1'  ")
SQL.ADD(" order by O.TipoOp ")

message('Operaciones a Liquidar.')

Recorrer SQL

   message(fbn('NrOperacion'))

   ACN(tn:1, fbn('TotalNetoCli1'))
   ACN(tn:2, fbn('TotalNetoCli2'))

   SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
   SQL.ADD(" RB4 = '0', ")
   IF Not Incluido(fbn('TipoOp'),'CTE|VTE')
      SQL.ADD(" Precio1        = "~Fstr(fbn('Precio2'),0,7)~", ")
      SQL.ADD(" TotalBrutoCli1 = "~Fstr(fbn('TotalBrutoCli2'),0,7)~", ")
      SQL.ADD(" TotalNetoCli1  = "~Fstr(fbn('TotalNetoCli2'),0,7)~",  ")
      *-----------------------------------------------------*
      SQL.ADD(" Precio2        = 0, ")
      SQL.ADD(" TotalBrutoCli2 = 0, ")
      SQL.ADD(" TotalNetoCli2  = 0  ")
   ELSE
      SQL.ADD(" Precio1        = "~Fstr(fbn('Cotizacion1'),0,7)~", ")
      SQL.ADD(" TotalBrutoCli2 = "~Fstr(fbn('TotalBrutoCli3'),0,7)~", ")
      SQL.ADD(" TotalBrutoCli1 = "~Fstr(fbn('TotalNetoCli3'),0,7)~",  ")
      *-----------------------------------------------------*
      SQL.ADD(" Cotizacion1    = 0, ")
      SQL.ADD(" TotalBrutoCli3 = 0, ")
      SQL.ADD(" TotalNetoCli3  = 0  ")
   ENDIF
   SQL.ADD("WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.NEW


   IF Not Incluido(fbn('TipoOp'),'CTE|VTE')

    IF Incluido(fbn('TipoOp'),'CTP|CFTP|CFTC')
       SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET ")
       SQL.ADD(" Cantidad = "~Fstr(Val(tn:2)*(-1),0,7)~" ")
       SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
       SQL.ADD(" AND   ABS(Cantidad)= "~fstr(Val(tn:1),1,2)~" ")
       SQL.ADD(" AND   Especie     = '"~fbn('ContraEspecie')~"' ")
       SQL.NEW

       SQL.ADD(" UPDATE "~DBO~".MOVPOSPEN SET ")
       SQL.ADD(" Cantidad = "~Fstr(Val(tn:2)*(-1),0,7)~" ")
       SQL.ADD(" WHERE NrOperacion  = '"~fbn('NrOperacion')~"' ")
       SQL.ADD(" AND   ABS(Cantidad)= "~fstr(Val(tn:1),1,2)~" ")
       SQL.ADD(" AND   Especie      = '"~fbn('ContraEspecie')~"' ")
       SQL.NEW
     ELSE
       SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET ")
       SQL.ADD(" Cantidad = "~Fstr(Val(tn:2),0,7)~" ")
       SQL.ADD(" WHERE NrOperacion  = '"~fbn('NrOperacion')~"' ")
       SQL.ADD(" AND   ABS(Cantidad)= "~fstr(Val(tn:1),1,2)~" ")
       SQL.ADD(" AND   Especie      = '"~fbn('ContraEspecie')~"' ")
       SQL.NEW

       SQL.ADD(" UPDATE "~DBO~".MOVPOSPEN SET ")
       SQL.ADD(" Cantidad = "~Fstr(Val(tn:2),0,7)~" ")
       SQL.ADD(" WHERE NrOperacion  = '"~fbn('NrOperacion')~"' ")
       SQL.ADD(" AND   ABS(Cantidad)= "~fstr(Val(tn:1),1,2)~" ")
       SQL.ADD(" AND   Especie      = '"~fbn('ContraEspecie')~"' ")
       SQL.NEW
     ENDIF

      *FALTA PARA OPERACIONES DEL EXTERIOR

   Endif

   SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET ")
   SQL.ADD(" Cupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
   SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.ADD(" AND   Especie     = '"~Dialogo.Especie3~"' ")
   SQL.ADD(" AND   Cupon       = '"~Val(ca:1)~"' ")
   SQL.NEW

   SQL.ADD(" UPDATE "~DBO~".MOVPOSPEN SET ")
   SQL.ADD(" Cupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
   SQL.ADD(" WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.ADD(" AND   Especie     = '"~Dialogo.Especie3~"' ")
   SQL.ADD(" AND   Cupon       = '"~Val(ca:1)~"' ")
   SQL.NEW

   SQL.EXEC
Proximo

*---------- ANULA LOS CORTES DE OPCIONES VIGENTES -----------------------*

SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Especie, O.FechaEj, O.PrecioEj, O.Cliente1, O.Mercado, O.Cantidad, O.Cotizacion2 ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and   Especie = '"~Dialogo.Especie3~"' ")
SQL.ADD("and   FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and  (CB6 is Null or CB6 = '0' ) ")
SQL.ADD("and   RB4 = '1' ")
SQL.ADD("and   TipoOp In ('CCE','CCP','CPE','CPP','VCE','VCP','VPE','VPP') ")
SQL.ADD("order by TipoOp, Especie ")

message('Opciones Vigentes.')

ACN(z:1, 0)

Recorrer SQL
   message(fbn['NrOperacion'])

   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set RB4      = '0', ")
   SQL.ADD("    PrecioEj = "~Fstr(fbn('Cotizacion2'),0,7)~", ")
   SQL.ADD("    Cotizacion2 = 0 ")
   SQL.ADD("where  NrOperacion = '"~fbn('NrOperacion')~"' ")
   SQL.NEW

   *----------------------------------------------------------*
   IF Val(z:1)=0
      SQL.ADD("Update "~DBO~".OPCIONES ")
      SQL.ADD("Set    Precio1  = Precio2, ")
      SQL.ADD("       Precio2  = 0 ")
      SQL.ADD("where  Precio1  = "~Fstr(fbn('PrecioEj'),0,7)~" ")
      SQL.ADD("and    Codigo   = '"~fbn('Especie')~"' ")
      SQL.ADD("and    Fecha    = '"~IdxDate(fbn('FechaEj'))~"' ")
      IF Incluido(fbn('TipoOp'), 'CCP|CCE|VCE|VCP')
         SQL.ADD("and CallPut  = 'CAL' ")
      ELSE
         SQL.ADD("and CallPut  = 'PUT' ")
      ENDIF
      SQL.NEW
   ENDIF

   ACN(z:1,1)

   SQL.EXEC
Proximo


