SQL.ADD("   AND Especie     = '"~Val(a:2)~"' ")
*SQL.ADD("   AND FechaMov    = '"~Idxdate(Dialogo.Fecha1)~"' ")
SQL.NEW 


SQL.ADD("UPDATE "~DBO~".MOVPOSPEN ")
SQL.ADD("   SET Cupon       = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
SQL.ADD(" WHERE NrOperacion = '"~Val(a:1)~"'  ")
SQL.ADD("   AND Especie     = '"~Val(a:2)~"' ")
SQL.ADD("   AND NrSaldo     = 2 ")
SQL.ADD("   AND Cupon       > '"~FSTR(Dialogo.Entero1,1,0)~"' ")
SQL.NEW 


SQL.ADD("DELETE FROM "~DBO~".MOVPOSEJE ")
SQL.ADD(" WHERE NrOperacion = '"~Val(a:1)~"'  ")
SQL.ADD("   AND Especie     = '"~Val(a:3)~"' ")
*SQL.ADD("   AND FechaMov    = '"~Idxdate(Dialogo.Fecha1)~"' ")
