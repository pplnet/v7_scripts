CrearDialogo
  Fecha1       : 'Fecha'    ;;;;;;Dialogo.Fecha1 >= Fsys;'Fecha incorrecta';NO;Fsys
  NrOperacion1 : 'Operacion';;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;;;;;;"TipoOp in ('PME','PMU') and FechaVto >=  '"~IdxDate(Dialogo.Fecha1)~"' "
FinDialogo

if Not Ok
  Cancelar
endif

ACT(x1,Dialogo.NrOperacion1)
ACD(x3,Dialogo.Fecha1)



SQL.ADD("Select O.Cliente1,O.Especie,O.FechaOp,O.Plazo,O.FechaVto,O.Cantidad,O.TotalAux1,O.TasaInteresesCupon, ")
SQL.ADD("O.DiasAnio,O.Precio1,O.PorImpuesto,O.PorImpuestoBolsa,O.PorDerechoBolsa, ")
SQL.ADD("O.RB9,O.RB10,O.PorComision,O.Vehiculo1,O.TipoOp, O.RB1, O.RB2, O.NrOperacion3, ")
SQL.ADD("O.Cuotas1,O.TablaFeriados1,O.Book1, ")
SQL.ADD("C.CondicionIVA, C.AgPercepcionIVA, C.ExIVA, C.PorcExIVA, C.FDesdeExIVA, C.FHastaExIVA, C.IVAPISE ") 
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("where O.NrOperacion='"~val(x1)~"' ")
SQL.ADD("and   C.Codigo = O.Cliente1 ")

Recorrer SQL
  ACT(x2,FBN['TipoOp'])
  ACT(aa1,FBN['Cliente1'])
  ACD(pf1,FBN['FechaOp'])
  ACN(ac1,FBN['Plazo'])
  ACD(ad1,FBN['FechaVto'])
  ACN(ae1,FBN['TotalAux1'])
  ACN(af1,FBN['Cantidad'])
  ACT(ag1,FBN['Especie'])
  ACN(ah1,FBN['Precio1'])
  ACN(ai1,FBN['DiasAnio'])
  ACT(aj1,FBN['Vehiculo1'])
  ACN(ak1,FBN['TasaInteresesCupon'])
  ACT(al1,FBN['RB1'])
  ACT(bl1,FBN['RB2'])
  ACT(am1,FBN['NrOperacion3'])
  ACT(cl1,FBN['Cuotas1'])
  ACT(cm1,FBN['Book1'])
  ACT(cn1,FBN['TablaFeriados1'])

  *** 2412 ***
  if Eqstr(val(al1),'1')   
     ACN(rr1,BuscarCampo('OPERACIONES','PorComision','NrOperacion',val(am1)))
     ACN(rr2,BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',val(am1)))
     ACT(rr3,BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',val(am1)))
     ACT(rr4,BuscarCampo('OPERACIONES','Book1','NrOperacion',val(am1)))
  endif

  ACT(j1,FBN['CondicionIVA'])
  ACT(k1,FBN['AgPercepcionIVA'])
  ACT(l1,FBN['ExIVA'])
  ACN(m1,FBN['PorcExIVA'])
  ACD(n1,FBN['FDesdeExIVA'])
  ACD(o1,FBN['FHastaExIVA'])

  if Eqstr(FBN['RB9'],'2') y Eqstr(FBN['RB10'],'1')
     ACN(aq1,FBN['PorComision'])
  endif
Proximo

***
if Eqstr(val(x2),'PME')
  ACN(z3,SQL("select count(*) from "~DBO~".CUOTAS where NrOperacion='"~val(x1)~"' and isnull(Radio6,'0')<>'1' "))
  if val(z3)=0
    Cancelar('El Prestamo '~val(x1)~' esta totalmente cancelado ')
  endif
else
  if Eqstr(val(x2),'PMU')
    ACN(z3,SQL("select CB6 from "~DBO~".OPERACIONES where NrOperacion='"~val(x1)~"' "))
    if val(z3)>0
      Cancelar('El Prestamo '~val(x1)~' esta totalmente cancelado ')
    endif
  endif
endif


*** Validacion de que se pueda modificar la Tasa Punitoria ***
if Eqstr(val(x2),'PMU')
   if val(ad1)<val(x3)
      Cancelar('El prestamo esta vencido, no se puede modificar la Tasa punitoria')
   endif
else
   *** Cuotas anteriores canceladas ***
   ACN(x4,0)
   SQL.ADD("Select Radio6 from "~DBO~".CUOTAS where NrOperacion='"~val(x1)~"' ")
   SQL.ADD("and Fecha1 <= '"~IdxDate(val(x3))~"' ")
   SQL.ADD("and Fecha2 < '"~IdxDate(val(x3))~"' ")
   Recorrer SQL
     if Not[Eqstr(FBN['Radio6'],'1')]
        ACN(x4,1)
     endif
   Proximo
endif

CrearDialogo
  NrOperacion1 : "Operacion"         ; 1;1;;NO;;;;;val(x1)
  Cliente1     : "Cliente"           ; 2;1;;NO;;;;;val(aa1)
  Especie1     : "Moneda"            ; 3;1;;NO;;;;;val(ag1)
  Cantidad1    : "Cantidad"          ; 4;1;;NO;;;;;val(af1)
  NrOperacion2 : "Pr.INGCURA"        ; 5;1;;NO;Eqstr(val(bl1),'1');;;;val(am1)
  Fecha3       : "a Fecha"           ; 6;1;;NO;;;;;val(x3)
  Fecha1       : "F.Concer."         ; 1;2;;NO;;;;;val(pf1)
  Entero3      : "Pl.Original"       ; 2;2;;NO;;;;;val(ac1)
  Fecha2       : "F.Vto."            ; 4;2;;NO;;;;;val(ad1)
  Cantidad2    : "Tasa Punit."       ; 5;2;;Eqstr(val(x2),'PMU') o [Eqstr(val(x2),'PME') y val(x4)=0];;;;;val(ak1)
FinDialogo

if not ok
  Cancelar
endif

if Eqstr(val(x2),'PMU')
   SQL.ADD("Update "~DBO~".OPERACIONES set TasaInteresesCupon = "~Dialogo.Cantidad2~"  ")
   SQL.ADD("where NrOperacion = '"~val(x1)~"' ")
   SQL.NEW
   SQL.EXEC
endif

if Eqstr(val(x2),'PME')
   ACN(z1,0)
   *** Cuotas No Canceladas y que no hayan devengado ***
   SQL.ADD("Select C.NrCuota,C.Fecha1,C.Plazo1,C.Fecha2,C.Cantidad1,C.Cantidad3,C.Tasa1 ")
   SQL.ADD("from "~DBO~".CUOTAS C ")
   SQL.ADD("where C.NrOperacion='"~val(x1)~"' ")
   SQL.ADD("and   (C.Radio6 is Null or C.Radio6 = ' ') ")
   SQL.ADD("and   (C.Fecha1 > '"~IdxDate(val(x3))~"' ")
   SQL.ADD("or    (C.Fecha1 <= '"~IdxDate(val(x3))~"' and (Tasa1=0 or Tasa1 is Null))) ")
   SQL.ADD("order by NrCuota ")
   Recorrer SQL
     SCN(z1,1)
     ACT(za:val(z1),Fstr(FBN['NrCuota'],0,0))
     ACD(zb:val(z1),FBN['Fecha1'])
     ACT(zc:val(z1),Fstr(FBN['Plazo1'],0,0))
     ACD(zd:val(z1),FBN['Fecha2'])
     ACN(ze:val(z1),FBN['Cantidad3'])
     ACN(zf:val(z1),FBN['Cantidad1'])
     ACN(zg:val(z1),FBN['Tasa1'])

     ACD(fo:val(z1),val(zb:val(z1)))
     ACD(fv:val(z1),val(zd:val(z1)))
   Proximo

   if val(z1)>0 y Not[Eqstr(val(aj1),VAR('VEHICULODE')) y Eqstr(val(bl1),'1')]  
     CrearListBox ; 'Arial,8,';'Modificacion Prestamo: '~val(x1)
      'NrCuota '       ;za1..za:val(z1);NO;;;50;STRING;
      'F.Origen'       ;zb1..zb:val(z1);  ;[flb=1 y val(zb:flb)=val(fo:flb)] o [flb>1 y val(zb:flb)=val(zd:flb-1)];'Fechas incorrectas';80;FECHA;
      'F.Vto.'         ;zd1..zd:val(z1);  ;EsHabil(val(zd:flb),val(cn1)) y [EsHabil(val(zd:flb),'USA') o Not Eqstr(val(ag1),'USD')];'No es un dia habil: '~val(zd:flb);80;FECHA;
     FinListBox

 
     if Messagebox('Confirma Modificacion Esquema de Cuotas Préstamo '~val(x1)~' ?',3,1) = 1
       Recorrer&i 1,val(z1)
        BorrarCeldas(pp1..pp10)

        ACN(pp1,val(zd:&i)-val(zb:&i))
        ACN(pp2,Round(val(ze:&i)*val(zg:&i)*val(pp1)/iif(val(ai1)=0,36000,36500),2))
        ACN(pp3,Round(val(ze:&i)+val(pp2),2))
        if val(aq1)>0
          ACN(pc1,Round(val(ze:&i)*val(aq1)*val(pp1)/iif(val(ai1)=0,36000,36500),2))
        endif

        if Not[Eqstr(val(aj1),'INGCURA')]
          ACT(pt1,'INT')
          ACN(pm1,val(pp2))
          (.'CANPREIVA'.)
          ACN(pp4,val(pr1))
          ACN(pp5,val(pr2))
          ACN(pp6,val(pr3))

          if val(aq1)>0
            ACT(pt1,'COM')
            ACN(pm1,val(pc1))
            (.'CANPREIVA'.)
            ACN(pp7,val(pr1))
            ACN(pp8,val(pr2))
            ACN(pp9,val(pr3))
          endif
        endif    

        ACN(pp10,Round(val(zf:&i)+val(pp2)+val(pc1)+val(pp4)+val(pp5)+val(pp6)+val(pp7)+val(pp8)+val(pp9),2))          

        SQL.ADD("Update "~DBO~".CUOTAS set Fecha1 = '"~IdxDate(val(zb:&i))~"',Fecha2 = '"~IdxDate(val(zd:&i))~"', ")
        SQL.ADD("Fecha3 = '"~IdxDate(val(zd:&i))~"', Plazo1 = "~val(pp1)~", ")
        SQL.ADD("Plazo2 = "~val(pp1)~",Cantidad2 = "~val(pp2)~",Cantidad6 = "~val(pp2)~",Cantidad4 = "~val(pp10)~" ")
        if Not[Eqstr(val(aj1),'INGCURA')]
           SQL.ADD(", Cantidad9="~val(pp4)~", Cantidad10="~val(pp5)~", Cantidad11="~val(pp6)~" ")
        endif
        if val(aq1)>0
          SQL.ADD(", Total7= "~val(pc1)~", Cantidad12= "~val(pc1)~" ")
          if Not[Eqstr(val(aj1),'INGCURA')]
            SQL.ADD(",Cantidad13="~val(pp7)~", Cantidad14="~val(pp8)~", Cantidad15="~val(pp9)~" ")
          endif
        endif
        SQL.ADD("where NrOperacion = '"~val(x1)~"' ")
        SQL.ADD("and NrCuota = "~val(za:&i)~" ")
        SQL.NEW
        SQL.EXEC

        ********************************** Control de Devengados *******************************
        if val(zg:&i)>0
         if SQL("Select count(*) from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(x1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='INTLEN' and NrSaldo=140 ")>0
           SQL.ADD("Delete from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(x1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='INTLEN' and NrSaldo=140 ")
           SQL.NEW
         endif
         if SQL("Select count(*) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(x1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='INTLEN' and NrSaldo=140  ")>0
           SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(x1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='INTLEN' and NrSaldo= 140  ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~val(x1)~"' and Fecha='"~IdxDate(val(x3))~"'  ")
           SQL.NEW
         endif
         SQL.EXEC
         ACT(zz1,val(x1))
         ACD(zz2,val(zb:&i))
         ACD(zz3,val(zd:&i)-1)
         ACT(zz4,'INTLEN')
         ACN(zz5,val(pp2))
         ACT(zz6,val(aj1))
         ACT(zz7,val(aj1))
         ACN(zz8,140)
         ACT(zz9,val(ag1))
         ACT(zz10,val(cm1))
         ACN(zz11,num(val(za:&i)))
         ACT(zz12,val(ag1))
         ACT(zz13,val(cn1))
         ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
         ACN(zz15,val(ze:&i))
         ACN(zz16,val(zg:&i))
         ACN(zz17,IIF(val(ai1)=0,360,365))
         ACN(zz18,1)
         ACD(zz19,val(zz2)-1)
         (.'CANPRE12'.)
         SQL.EXEC
        endif    

        if val(aq1)>0
         if SQL("Select count(*) from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(x1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='COMIS' and NrSaldo=180 ")>0
           SQL.ADD("Delete from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(x1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='COMIS' and NrSaldo=180 ")
           SQL.NEW
         endif
         if SQL("Select count(*) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(x1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='COMIS' and NrSaldo=180  ")>0
           SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(x1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='COMIS' and NrSaldo= 180  ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~val(x1)~"' and Fecha='"~IdxDate(val(x3))~"'  ")
           SQL.NEW
         endif
         SQL.EXEC
         ACT(zz1,val(x1))
         ACD(zz2,val(zb:&i))
         ACD(zz3,val(zd:&i)-1)
         ACT(zz4,'COMIS')
         ACN(zz5,val(pc1))
         ACT(zz6,val(aj1))
         ACT(zz7,val(aj1))
         ACN(zz8,180)
         ACT(zz9,val(ag1))
         ACT(zz10,val(cm1))
         ACN(zz11,num(val(za:&i)))
         ACT(zz12,val(ag1))
         ACT(zz13,val(cn1))
         ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
         ACN(zz15,val(ze:&i))
         ACN(zz16,val(aq1))
         ACN(zz17,IIF(val(ai1)=0,360,365))
         ACN(zz18,2)
         ACD(zz19,val(zz2)-1)
         (.'CANPRE12'.)
         SQL.EXEC
        endif    

        ********************************************* 2412 **************************************
        if Eqstr(val(al1),'1')   
          ACN(zr1,SQL("Select Cantidad3 from "~DBO~".CUOTAS where NrOperacion='"~val(am1)~"' and NrCuota = "~val(za:&i)~" "))
          ACN(pm1,Round(val(zr1)*val(rr1)*val(pp1)/iif(val(rr2)=0,36000,36500),2))
          ACT(pt1,'COM')
          (.'CANPREIVA'.)

          SQL.ADD("Update "~DBO~".CUOTAS set Fecha1 = '"~IdxDate(val(zb:&i))~"',Fecha2 = '"~IdxDate(val(zd:&i))~"', ")
          SQL.ADD("Fecha3 = '"~IdxDate(val(zd:&i))~"', Plazo1 = "~val(pp1)~", ")
          SQL.ADD("Plazo2 = "~val(pp1)~",")
          SQL.ADD("Total7= "~val(pm1)~", Cantidad12= "~val(pm1)~", ")
          SQL.ADD("Cantidad13="~val(pr1)~", Cantidad14="~val(pr2)~", Cantidad15="~val(pr3)~" ")
          SQL.ADD("where NrOperacion = '"~val(am1)~"' ")
          SQL.ADD("and NrCuota = "~val(za:&i)~" ")
          SQL.NEW
          SQL.EXEC

          if SQL("Select count(*) from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(am1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='COMIS' and NrSaldo=180 ")>0
            SQL.ADD("Delete from "~DBO~".GENDEVENGADOS where NrOperacion='"~val(am1)~"' and FechaDes='"~IdxDate(val(fo:&i))~"' and FechaHas='"~IdxDate(val(fv:&i)-1)~"' and TipoDevengado='COMIS' and NrSaldo=180 ")
            SQL.NEW
          endif
          if SQL("Select count(*) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(am1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='COMIS' and NrSaldo=180  ")>0
            SQL.ADD("Delete from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(am1)~"' and Cupon= '"~val(za:&i)~"' and TipoDevengado='COMIS' and NrSaldo= 180  ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".DELDEVENGADOS where NrOperacion='"~val(am1)~"' and Fecha='"~IdxDate(val(x3))~"'  ")
            SQL.NEW
          endif
          SQL.EXEC
          ACT(zz1,val(am1))
          ACD(zz2,val(zb:&i))
          ACD(zz3,val(zd:&i)-1)
          ACT(zz4,'COMIS')
          ACN(zz5,val(pm1))
          ACT(zz6,val(rr3))
          ACT(zz7,val(rr3))
          ACN(zz8,180)
          ACT(zz9,val(ag1))
          ACT(zz10,val(rr4))
          ACN(zz11,num(val(za:&i)))
          ACT(zz12,val(ag1))
          ACT(zz13,val(cn1))
          ACN(zz14,IIF(Eqstr(val(zz7),VAR('VEHICULODE')),1,0))
          ACN(zz15,val(zr1))
          ACN(zz16,val(rr1))
          ACN(zz17,IIF(val(rr2)=0,360,365))
          ACN(zz18,2)
          ACD(zz19,val(zz2)-1)
          (.'CANPRE12'.)
          SQL.EXEC
        endif
        *****************************************************************************************
       Proximo

       ************************* Actualizacion de FechaVto y Plazo en Operaciones ***************
       ACD(pa1,SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion = '"~val(x1)~"' and NrCuota="~val(cl1)~" "))
       ACN(pa2,val(pa1)-val(pf1))
       SQL.ADD("Update "~DBO~".OPERACIONES set Plazo= "~val(pa2)~" , FechaVto ='"~IdxDate(val(pa1))~"' ")
       SQL.ADD("where  NrOperacion= '"~val(x1)~"' ")
       if Eqstr(val(al1),'1')   
          SQL.ADD("Update "~DBO~".OPERACIONES set Plazo= "~val(pa2)~" , FechaVto ='"~IdxDate(val(pa1))~"' ")
          SQL.ADD("where  NrOperacion= '"~val(am1)~"' ")
       endif
       SQL.NEW
       SQL.EXEC
     endif
   else
    MESSAGEBOX('No existen cuotas futuras a modificar')
   endif
   SQL.ADD("Update "~DBO~".OPERACIONES set TasaInteresesCupon = "~Dialogo.Cantidad2~" ")
   SQL.ADD("where NrOperacion = '"~val(x1)~"' ")
   SQL.NEW
   SQL.EXEC
endif
