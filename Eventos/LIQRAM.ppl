* ---> Impresion De Las Cartas De Liquidacion De Renta Y Amortizacion Por Especie

ModoReproceso(ConDialogo)
GrillaVisible(NO)

CrearDialogo
   Vehiculo1: "Vehiculo"     ; 01;  1;  1; SI; SI;NoVacio(Dialogo.Vehiculo1)                                                                                        ; 'Debe Ingresar El Vehiculo'       ;NO;Var('VEHICULODE')
   Especie3 : 'Especie'      ; 02;  1;  1; SI; SI;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3, 'TITULO') y EsTerminal(Dialogo.Especie3, Especie); 'Debe Ingresar Una Especie Valida';NO;;;;;; "Status = 'HAB' "
   Especie1 : 'Cupon'        ; 03;  1;  1; NO; SI;                    ;                                               ;SI; ;BuscarCampo('Especies', 'Alias9', 'Codigo', Dialogo.Especie3);;; "Status = 'HAB' "
   Entero1  : 'Nro.Cupon'    ; 04;  1;  1; SI; SI;Dialogo.Entero1 >= 0;'Debe Ingresar El Numero De Cupon'             ;NO;0;0
   Fecha1   : 'F.Pago/Cob.'  ; 02;  2;  1; Dialogo.Entero1=0; Dialogo.Entero1=0;
   Fecha3   : 'Hasta'        ; 03;  2;  1; Dialogo.Entero1=0; Dialogo.Entero1=0;
   Precio1  : '% Amort.'     ; 05;  1;  1; NO; Dialogo.Entero1<>0;Dialogo.Precio1 >= 0;'El % De Amortizacion Debe Ser Positivo'       ;NO; ;SQL("SELECT PorAmCapital FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FStr(Dialogo.Entero1,1,0)~"' ");;;'###.########'
   Precio2  : '% Renta'      ; 06;  1;  1; NO; Dialogo.Entero1<>0;Dialogo.Precio2 >= 0;'El % De Renta Debe Ser Positivo'              ;NO; ;SQL("SELECT PorRenta     FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FStr(Dialogo.Entero1,1,0)~"' ");;;'###.########'
   Precio3  : '% Cap.Int.'    ;   ;   ;   ; NO; ;Dialogo.Precio3>=0;'El % de Cap.Int. debe ser Positivo';NO;;SQL("SELECT PorAmIntCap FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"'");;;'###.#########'
   Precio5  : 'V.R.Actual'   ; 08;  1;  1; NO; Dialogo.Entero1<>0;Dialogo.Precio5 > 0 ;'El % De V. Teorico Al Corte Deberia Ser Positivo';SI; ;ValorTeorico(Dialogo.Especie3)
   ListaTabla1: 'Clientes'   ; 10;1;;;;;;;;;;;;;'Codigo';'Codigo;RazonSocial'; 'VCLIENTES01'
   ListaTabla2: 'Sucursales' ;  4;2;;;;;;;;;;;;;'Codigo';'Codigo;Nombre';'SUCURSALES' 
FinDialogo

If [Not OK]
   Cancelar
EndIf

If [[NoVacio(Dialogo.Vehiculo1)] y [Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

* ---> Seleccion De La Informacion A Listar
ACN(ZA:01, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU'))+100)

If Vacio(Dialogo.ListaTabla2)
   SQL.Add("SELECT DISTINCT M.Cliente, T2.NrTrans, T2.Cupon1, T2.Fecha1, ")
   SQL.Add("       CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ")
   SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, ")
   SQL.Add("     "~DBO~".CLIENTES C,        ")
   SQL.Add("     "~DBO~".MOVEJECUTADOS M    ")
   SQL.Add("WHERE T2.Especie   = '"~Dialogo.Especie1~"' ")
   If Dialogo.Entero1 <> 0
      SQL.Add("  AND T2.Cupon1    =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
   Endif
   SQL.Add("  AND T2.TipoTr2   = '"~VAR('LCUPON')~"' ") 
   SQL.Add("  AND T2.Vehiculo1 =  '"~Dialogo.Vehiculo1~"' ")
   If [Dialogo.Fecha1>0 y Dialogo.Fecha3>0]
      SQL.Add("  AND T2.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha3)~"' ")
   Endif
   SQL.Add("  AND M.Concepto  <> "~FStr(Val(ZA:01), 1, 0)~" ") 
   SQL.Add("  AND M.Cliente = C.Codigo ")
   SQL.Add("  AND M.NrSaldo = 1      ")

   IF NoVacio(Dialogo.ListaTabla1)
      SQL.Add("  AND C.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~")")
   ENDIF
   SQL.Add("  AND T2.NrTrans = M.NrOperacion ")
   * ---> Impresion De Cartas De Liquidacion De Rentas Y Amortizaciones

   Recorrer SQL
      LinkearHoja('EMILRA', 1, Vehiculo1=Dialogo.Vehiculo1, Cliente1=FBN['Cliente'], Especie3=Dialogo.Especie3, NrTrans1 = FBN['NrTrans'], Especie1=Dialogo.Especie1, Entero1=FBN['Cupon1'], Fecha1=FBN['Fecha1'], Precio1=Dialogo.Precio1, Precio2=Dialogo.Precio2, Precio5=Dialogo.Precio5, Cantidad1=FBN['NrMov2'])
   Proximo
Else
   SQL.Add("SELECT DISTINCT M.Cliente, T2.NrTrans, T2.Cupon1, T2.Fecha1, ")
   SQL.Add("       CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ")
   SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, ")
   SQL.Add("     "~DBO~".CLIENTES C,        ")
   SQL.Add("     "~DBO~".MOVEJECUTADOS M    ")
   SQL.Add("WHERE T2.Especie   = '"~Dialogo.Especie1~"' ")
   If Dialogo.Entero1 <> 0
      SQL.Add("  AND T2.Cupon1    =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
   Endif
   SQL.Add("  AND T2.TipoTr2   = '"~VAR('LCUPON')~"' ") 
   SQL.Add("  AND T2.Vehiculo1 =  '"~Dialogo.Vehiculo1~"' ")
   If [Dialogo.Fecha1>0 y Dialogo.Fecha3>0]
      SQL.Add("  AND T2.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha3)~"' ")
   Endif
   SQL.Add("  AND M .Concepto  <> "~FStr(Val(ZA:01), 1, 0)~" ") 
   SQL.Add("  AND M.Cliente = C.Codigo ")
   IF NoVacio(Dialogo.ListaTabla1)
      SQL.Add("  AND C.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~")")
   ENDIF
   SQL.Add("  AND M.NrSaldo = 1      ")
   SQL.Add("  AND T2.NrTrans = M.NrOperacion ")
   SQL.ADD("       AND C.Sucursal in ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")

   * ---> Impresion De Cartas De Liquidacion De Rentas Y Amortizaciones

   Recorrer SQL
      LinkearHoja('EMILRA', 1, Vehiculo1=Dialogo.Vehiculo1, Cliente1=FBN['Cliente'], Especie3=Dialogo.Especie3, NrTrans1 = FBN['NrTrans'], Especie1=Dialogo.Especie1, Entero1=FBN['Cupon1'], Fecha1=FBN['Fecha1'], Precio1=Dialogo.Precio1, Precio2=Dialogo.Precio2, Precio5=Dialogo.Precio5, Cantidad1=FBN['NrMov2'])
   Proximo
Endif
