*** Lee de la tabla OPSIOPEL lo que esta sin procesar de Tipo de Negociacion 
*** de Garantizadas Var('TIPONEGCPC') y Ruedas de Garantizadas Var('RUECPC1')
CrearDialogo
  Check1: 'Procesa';1;1; ;SI;SI;;;;0;
  ** NrOrden1: 'NrOrden' ;;1;;SI;SI;;;;
FinDialogo

if Not OK
  Cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif
ACT(v:5, VAR('AGESIOP'))

ACT(r:1, '1')
