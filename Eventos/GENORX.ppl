if Dialogo.Check1=0
  recorrer&i 1,58
    ACT(bz:&i, Val(s:&i))
  proximo
endif

SQL.ADD(" Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGCPC'))~") ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUECPC1'))~")    ")
SQL.ADD("    and CodigoRegistro in ('0105','0205','7020')              ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                     ")
**SQL.ADD("    and Fecha       = '20220421'                     ")
SQL.ADD("    and Carga       is null                                   ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                           ")
*If Novacio(Dialogo.NrOrden1)
*   SQL.ADD("    and NrOrden = '"~Dialogo.NrOrden1~"'                   ")
*   SQL.ADD("    and NrOrden = 'OR004134'                   ")
*Endif
watch(SQL.Batch)
Recorrer SQL
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..u:90)
  ***** Secuencia2
  ACT(t:1, fbn('Secuencia2'))
  ACT(u:1, fbn('Secuencia'))
  ***** TipoOp
  if EqStr(fbn('CodigoRegistro'),'7020')
     ACT(x:1, 'S')
     ACT(xy:1,'NN')
     
     SQL.ADD(" Select Cliente, TipoOrden, ContraEspecie, ")
     SQL.ADD("        Mercado, Mercado2, Mercado3, ")
     SQL.ADD("        Vehiculo, Operador, RB9, RB10, Book1, Lotes Plazo, RB5, ")
     SQL.ADD("        Cuotas1, CB10, Cupon1, AfectaLS, ")
     SQL.ADD("        Cuenta1, Cuenta4, Cuenta5, MB2  ")
     SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~fbn('NrOrden')~"' ")
     Recorrer SQL
        DFA
        ACT(u:2,  fbn('TipoOrden'))
        ACT(t:12, fbn('ContraEspecie'))
        ACT(t:22, fbn('Mercado'))        
        ACT(t:31, fbn('Mercado3'))
        ACT(t:52, fbn('Mercado2'))
        ACT(t:8,  fbn('Cliente'))         
        ACT(t:54, fbn('Cliente')) 
        ACT(t:75, fbn('Book1'))
        ACT(t:28, fbn('Cuenta1'))
        ACT(t:80, fbn('Cuenta4'))
        ACT(t:81, fbn('Cuenta5'))
        ACT(t:82, fbn('MB2'))
        ACT(t:85, fbn('AfectaLS'))
     Proximo
     
     if EqStr(Val(u:2),'OTIC')
        ACT(t:2,'TIC')
     else
        if EqStr(Val(u:2),'OTIV')
           ACT(t:2,'TIV')
        else
           ACT(t:2,'NOENCONTRADA')
        endif   
     endif
     **messagebox('es 7020 '~Val(T:54))
     If EqStr(Val(t:54),Var('VEHICULO')) y Incluido(fbn('CodRegContestado'),'0105|0205')
        ** Es Cartera Propia
        ACN(t:55, 1)
        ACT(xy:1,'OK') 
     Else
        ** Es Terceros
        If EqStr(Val(u:2),'OTIC') y EqStr(fbn('CodRegContestado'),'0105')
           ACT(xy:1,'OK')
        Else
           If EqStr(Val(u:2),'OTIV') y EqStr(fbn('CodRegContestado'),'0205')
              ACT(xy:1,'OK')
           Else
              ** Si hubiese otro tipo de msg desarrollar aqui 
              ACT(xy:1,'NOK')
           Endif
        Endif
     Endif
     ** AA 10-01-22 Verificacion duplicidad de mensages
     ** AUXGENORD

     ACT(xy:2,SQL("Select 'NOK' From "~DBO~".EJECUCIONES Where cast(Fecha As Date) = '"~IdxDate(fbn('Fecha'))~"' and NrSecuencia = '"~fbn('Secuencia')~"' "))
  
     ACT(xy:3, iif(EqStr('NOK',Val(xy:2)),'NOK','OK'))
     *messagebox(fbn('Fecha')~' - '~fbn('Secuencia')~' - '~Val(xy:2)~' - '~Val(xy:3))
  

     **messagebox(' 248 '~val(xy:3))
   IF EqStr(val(xy:3),'OK')
     If  EqStr(Val(xy:1),'OK')
         ** Armado datos Operacion/Orden
         ACT(t:53, fbn('NrOrden'))
         ** AUXGENORD0
         ***** Cantidad
         ACN(t:11, fbn('Cantidad'))
         if Val(t:11)=0
            SCN(z:1,1)
            **messagebox('Cantidad')
            ACN((26+FAC):11, 1)
         endif
         ***** PrecioMAE
         ACN(t:13, fbn('Precio'))
         ** Generar Operacion TIC/TIV
         ***** Precio3 / Precio4 / Precio1
         if Eqstr(Val(t:10),'CLE')
            ACN(t:14, Val(t:13))
         else
            ACN(t:15, Val(t:13))
         endif
         ** genera/actualiza Operacion y Ejecuciones
         ACT(t:5, fbn('AgenteContra'))
         if EqStr(fbn('Agente'),Val(v:5))
            ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
            ACT(t:5, fbn('AgenteContra'))
         else
            if EqStr(fbn('AgenteContra'),Val(v:5))
               ACT(t:5, fbn('Agente'))
            endif
         endif
         ***** Especie
         ACT(t:27, fbn('CodigoTitulo'))
         ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         if Vacio(Val(t:3))
            * Marca Incompleto
            ACN(t:44, 1)
            ACN(es:1, 1)
            ACN((26+FAC):3, 1)
            EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
            ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         else
            ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
            if Eqstr(Val(es:2),'DES')
               ACN(es:1,1)
            Endif
         endif
         ***** Cupon MAE
         ACT(t:4, fbn('NroCupon'))
         if EqStr(fbn('CodigoRueda'),'MAE1')
            ACN(t:34, 1)
         endif
         
         ***** Cliente
         ACN(t:6, Num(Val(t:5)))
         ***** Cliente Tabla
         if EqStr(fbn('CodigoRegistro'),'7020')
            ACT(t:7, fbn('Cliente'))
         Else
         If [Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y Vacio(fbn('ComitenteComprador')) y Vacio(fbn('ComitenteVendedor'))] y  (EqStr(fbn('TipoOpOrigen'),'5') o EqStr(fbn('TipoOpDestino'),'5'))
            ** Cartera Propia
            ***** Codigo Cliente
            ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(v:5)~"' "))
            ACT(t:54,Val(t:8))
            **messagebox('Cartera propia '~Val(T:54))
            ***** Operador Contra
            ACT(t:9, fbn('OperadorContra'))
            *messagebox('Ok cartera propia '~Val(t:8)~' '~Val(T:53)~' '~Val(t:9))
         Else   
            If Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y [No Vacio(fbn('ComitenteComprador')) o No Vacio(fbn('ComitenteVendedor'))]
               * Agente=0  o Agente=Vehiculo
               if NoVacio(fbn('ComitenteComprador'))
                  ACT(t:61, fbn('ComitenteComprador'))
               else
                  ACT(t:61, fbn('ComitenteVendedor'))
               endif
               ACN(t:62, Longitud(Val(t:61)))
               if Val(t:62)>1
                  ACT(t:63, Copy(Val(t:61),1,2))
                  if EqStr(Val(t:63),'*C')
                     * es CUIT
                     if Val(t:62)>2
                        if Val(t:62)>13
                           ACT(t:64, Copy(Val(t:61),3,11))
                        else
                           ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                        endif
                        ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CUIT = '"~Val(t:64)~"' "))
                     endif
                  endif
                  if Incluido(Val(t:63),'*F|*S')
                    * es Fondo o Seguros
                    * FJL 23/08/21 - Issue 5092 - Cambio criterio FCI
*                    ACT(t:64, Copy(Val(t:61),2,Val(t:62)-1))
*                    if EqStr(Val(t:63),'*F')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='FON' "))
*                    endif
*                    if EqStr(Val(t:63),'*S')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='CSE' "))
*                    endif
                    ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                    if EqStr(Val(t:63),'*F')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='FON' "))
                    endif
                    if EqStr(Val(t:63),'*S')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='CSE' "))
                    endif
                  endif
                  if NoVacio(Val(t:65))
                     ACT(t:8, Val(t:65))
                     ACT(t:54,Val(t:8))
                     **messagebox('No cartera Propia '~Val(T:54))
                  endif
               endif  
               if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                  * Agente=0  y FCI/AFJP
                  ACN((26+FAC):8, 2)
               else
                  if Val(t:34)=1
                     * MAE1
                     ACN((26+FAC):8, 3)
                  else
                     ACN((26+FAC):8, 1)
                  endif
               endif
            else
               ***** Codigo MAE Cliente
               **ACT(t:53, Val(t:5))
               ***** Codigo Cliente
               ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
               ACT(t:54,Val(t:8))
               **messagebox('Codigo MAE Cliente '~Val(T:54))
               ***** Operador Contra
               ACT(t:9, fbn('OperadorContra'))
               ** ver si es OTIC/OTIV
               ** if Vacio(Val(t:8)) y Not EqStr(Val(t:2),'TCOPRI')
               if Vacio(Val(t:8))
                  ACN(cl:1,1)
                  ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
               endif
            endif
         Endif         
         Endif
        ** messagebox(Val(t:54)~' '~fbn('CodigoRueda')~' '~Var('RUECPC1'))
         if  Eqstr(Val(t:54),Var('VEHICULO'))    
             ACN(t:55,1)
         Else
             ACN(t:55,0)   
         Endif

         ** Cta y Ord 3ros    
         if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) y Not Eqstr(Val(t:54),Var('VEHICULO'))    
            ACT(t:73,'1')
         Else   
            ACT(t:73,'0')
         Endif
        
         **Mercado Especie y Mercado Contraespecie Orden desde SIOPEL
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            ***** Mercado4
            ACT(t:31, Var('AMBMAE'))
            ***** Especie T:3/ Mercado T:22
            *ACT(t:22, MercadoDef(Val(t:3)))
            ACT(t:22, Var('MERLIQCPC1'))
            ***** ContraEspecie T:12 / Mercado2 T:52
            #ifdef MLASA
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
            #else
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
                   
            #endif
         Endif

         ***** InteresesMAE
         ACN(t:16, fbn('Interes'))
         ***** Es ZeroCupon
         ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
         ***** Nro Cupon
         if EqStr(Val(t:58),'SI')    
            ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
         else
            ACT(t:17, Val(t:4))
         endif
         ***** Fecha Op
         if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05') o (EqStr(fbn('CodigoRegistro'),'7020') y EqStr(Copy(fbn('CodRegContestado'),3,2),'05'))
            ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
            ACD(t:19, Fecha(Val(t:18)))
         else
            SCN(z:1,1)
            **messagebox('fecha Op')
            ACN((26+FAC):19, 1)
         endif
    
         ***** Mercado
         ** AA se omite. solo se realiza por Merdadodef
         if NO
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) 
               ACT(t:22, 'CV')
               ACT(t:52, 'BCRA')
            Else
               if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
                  ACT(t:22, 'AC')
                  ACT(t:52, 'AC')
               else
                  if EqStr(fbn('EnteLiquidador'),'2')
                     ACT(t:22, 'CRYL')
                     ACT(t:52, 'BCRA')
                  else
                     if EqStr(fbn('EnteLiquidador'),'3')
                        ACT(t:22, 'CE')
                        ACT(t:52, 'CE')
                     else
                        if EqStr(fbn('EnteLiquidador'),'4')
                           ACT(t:22, 'EU')
                           ACT(t:52, 'EU')
                        else
                           if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
                              ACT(t:22, 'CV')
                           else
                              if Incluido(fbn('EnteLiquidador'),'G|F|W|U')
                                 ACT(t:22, 'MC')
                                 ACT(t:52, 'MC')
                              else
                                 *SCN(z:1,1)
                                 * Marca Incompleto
                                 **box('Ente liquidador')
                                 **ACN(t:44, 1)
                                 ACN((26+FAC):22, 1)
                              endif
                           endif
                        endif
                     endif
                  endif
               endif
            Endif
         Endif
**  Endif de IF NO
         ENDIF
         
         ***** FormaLiquidacion
         if EqStr(fbn('TipoLiquidacion'),'2')
            ACN(t:23, 0)
         else
            if EqStr(fbn('TipoLiquidacion'),'1')
               ACN(t:23, 1)
            else
               if EqStr(fbn('TipoLiquidacion'),'6')
                  ACN(t:23, 2)
               else
*                 SCN(z:1,1)
                  * Marca Incompleto
                  **messagebox('Forma liquidacion')
                  **ACN(t:44, 1)
                  ACN((26+FAC):23, 1)
               endif
            endif
         endif
         ** AA 05-05-2022 Se incorpora mercado variable FormaLiquidacion1 y FormaLiquidacion2
         **IF Incluido(Val(T:22), VAR('MERCAACMC'))         
         IF Incluido(Val(T:22), VAR('MERCAVARI'))
         ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)
         Else
            ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)         
         ENDIF
         ***** Operador / OperadorContra
         if Incluido(Val(t:2),'TIV')
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
            ACT(t:26, fbn('OperadorContra'))
         else
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
            ACT(t:26, fbn('Operador'))
         endif
         if Vacio(Val(t:25))
            ACT(t:25, UsuarioActivo)
         endif
         ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

         ***** Vehiculo1
         ACT(t:29, Var('VEHICULODE'))

         *** ContraEspecie2 Moneda de Liquidacion ****
         If Eqstr(Val(t:12),VAR('MONELOCA'))
            ACT(T:46,Val(t:12))
         Else
            ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
         Endif
         if EqStr(Val(t:12),'USD')
            if Incluido(Val(t:22),VAR('MERCAACMC'))
               ACT(t:46, 'USD')
               if EqStr(fbn('EnteLiquidador'),'B')
                  ACT(t:46, 'USB')
               endif
            endif
            if EqStr(Val(t:22),'CRYL')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'CV')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'EU')
               if EqStr(fbn('TipoOpDestino'),'5') 
                  ACT(t:46, 'USD')
               else
                  ACT(t:46, 'USD')
               endif
            endif
         endif
         ***** Tabla Feriados
         if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9')
            ACT(t:24, 'USA')
         endif
         if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
            ACT(t:24, 'ARG')
         endif
         if Incluido(Val(t:22),VAR('MERCAACMC'))
            if Incluido(Val(t:46),'ARP|USB')
               ACT(t:24, 'ARG')
            endif
            if EqStr(Val(t:46),'USD')
               ACT(t:24, 'USA')
            endif
         endif
        if Vacio(Val(t:24))
           * SCN(z:1,1)
           * Marca Incompleto
           *messagebox('feriados')
           **ACN(t:44, 1)
           ACN((26+FAC):24, 1)
        endif

        ***** RB5
        ACT(t:20, Fstr(Num(fbn('Plazo')),1,0))

        ***** Plazo / Lote
        ACN(t:21, Num(fbn('Plazo'))*24)

        ***** FechaVto
        ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))

        ***** UDN1
        ACT(t:30, 'MD')
        ***** Rueda 
        ACT(t:32, fbn('CodigoRueda'))
        ***** PaseCB
        ACT(t:33, '0')
        ***** MAE1
        if Val(t:34)=1
           ***** Datos MAE1
           ACT(t:36, fbn('Referencia'))
           ACN(t:37, Num(Val(t:36)))
           if Val(t:37)=0
              ACN(t:35, 0)
              ACN(t:38, 1)
           else
              if EqStr(fbn('TipoOpOrigen'),'1')
                 ** Terceros
                 ACN(t:35, 0)
              else
                 ACN(t:35, 1)
              endif
           endif
           if EqStr(fbn('TipoOpDestino'),'5')
              * Agente
              ACN(t:39, 0)
           else
              if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                 if EqStr(fbn('TipoOpDestino'),'2')
                    * FCI
                    ACN(t:39, 1)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'4')
                    * AFJP Fondo
                    ACN(t:39, 2)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'6')
                    * AFJP Encaje
                    ACN(t:39, 3)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'7')
                    * AFJP Adminis (Cartera Propia)
                    ACN(t:39, 4)
                 endif
              endif
           endif
        endif

        if DesciendeDeEspecie(Val(t:3),'LETES')
           *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
           ACN(x:2, 1)
        else
           ACN(x:2, 0)
        endif 

        * Cliente definitivo a la Operacion
        ACT(t:56, Val(t:54))
        if Vacio(Val(t:56)) y Val(t:34)=1
           * Vacio Cliente y MAE1
           ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
        else
           ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
        endif
        if Val(t:41) = 1
           ACN(t:42, 1)
           if Vacio(Val(t:56)) y Val(t:34)=1
              * Vacio Cliente y MAE1
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
           else
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
           endif
           if Dialogo.Check1=1
              SQL.ADD("Update "~DBO~".OPSIOPEL ")
              SQL.ADD("   Set Procesado   = '1',")
              SQL.ADD("       Carga       = '1', ")
              SQL.ADD("       NrOperacion = 'DUPLIC' ")
              SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
              SQL.NEW
              SQL.EXEC
           endif
        endif
        if Vacio(Val(t:56))
           * Vacio Cliente
           if Val(t:34)=0
              * NO MAE1
              * Marca Incompleto
           endif
           ACT(t:56, 'SIOPEL')
           ACN(t:44, 1)
           ACN((26+FAC):8, 1)
        endif
        ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        *ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
        ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
        ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))
        
        ACT(t:51, fbn('SecEnvioOrden'))
        **ACT(t:70,VAR('CANALDEF'))
        ACT(t:70,'MERCADO')
        ACT(t:71,BuscarCampo('CANALES','AfectaPorDefecto','Codigo',Val(t:70)))
        ACT(t:72,fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        ACT(t:74,iif(EqStr(Val(t:2),'TIC'),fbn('NroOfertaCpra'),fbn('NroOfertaVen')))
         **messagebox('Desp ord 0 '~Val(T:54)~' '~Val(T:73))
         ** Actualiza AfectaLS de la Orden
         ACT(t:71, Val(t:85))
        if Val(z:1)=0
           ACT(b:FAC, 'OK')
           if Dialogo.Check1=1
              ** verificar si ya se dio de alta la Operacion
              ACT(t:59, BuscarCampo('OPERACIONES','NrOperacion','NrOrden1',fbn('NrOrden')))
              If NoVacio(Val(t:59))
                 ** Generar Ejecucion y Actualizar Orden y Operacion
                 ** AUXGENORD2
                 if Dialogo.Check1=1 
                    ** Genera / Actualiza Ejecuciones 
                    ** AUXGENOR22
                    ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' "))
                    ACT(w:1, Copy(Val(t:84),1,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
                     **Convert(datetime,'"~Val(w:1)~"',120)
                    SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio, Cantidad2) ")
                    SQL.ADD(" Values ('"~Val(t:53)~"', '"~Val(t:59)~"', '"~FStr(Val(NE:1),0,0)~"', '"~Val(u:1)~"', Convert(datetime,'"~Val(w:1)~"',120), '"~FStr(Val(t:11),0,2)~"', '"~FStr(Val(t:13),0,8)~"', '"~FStr(Val(t:11)*Val(t:13),0,2)~"') ")
                    SQL.NEW
                    SQL.EXEC
                    SQL.ADD(" Select SUM(Cantidad) as Cant ,SUM(Cantidad*Precio) CantPr From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' ")
                    Recorrer SQL
                       ACN(ca:1,fbn('Cant'))
                       ACN(pr:1,Round((fbn('CantPr')/fbn('Cant')),8))
                    Proximo
                    ACT(SO:1,SQL(" Select MB1 From "~DBO~".ORDENES Where NrOrden='"~Val(t:53)~"' "))
                    if EqStr(Val(SO:1),'SI')
                       SQL.ADD(" Update "~DBO~".ORDENES Set ")
                       SQL.ADD("  CantidadTotalOrden   = "~FStr(Val(ca:1),0,0)~", ")
                       SQL.ADD("  Cuotas1              = "~FStr(Val(NE:1),0,0)~", ")
                       SQL.ADD("  Cantidad1            = "~FStr(Val(ca:1),0,2)~", ")
                       SQL.ADD("  Cantidad4            = "~FStr(Val(pr:1),0,8)~", ") 
                       SQL.ADD("  RuedaMAE             = '"~Val(t:32)~"' ")
                       SQL.ADD(" Where NrOrden         = '"~Val(t:53)~"' ")
                       SQL.NEW
                    else
                       SQL.ADD(" Update "~DBO~".ORDENES Set ")
                       SQL.ADD("  Cuotas1      = "~FStr(Val(NE:1),0,0)~", ")
                       SQL.ADD("  Cantidad1    = "~FStr(Val(ca:1),0,2)~", ")
                       SQL.ADD("  Cantidad4    = "~FStr(Val(pr:1),0,8)~", ") 
                       SQL.ADD("  RuedaMAE     = '"~Val(t:32)~"' ")
                       SQL.ADD(" Where NrOrden = '"~Val(t:53)~"' ")
                       SQL.NEW
                    endif
                    ** FIN AUXGENOR22 
                    ACT(OP:1,SQL(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOrden1='"~Val(t:53)~"' "))
                    SQL.ADD(" Update "~DBO~".OPERACIONES Set ")
                    SQL.ADD("  Cantidad    = "~FStr(Val(ca:1),0,2)~", ")
                    SQL.ADD("  Precio1     = "~FStr(Val(pr:1),0,8)~" ")
                    SQL.ADD(" Where NrOperacion = '"~Val(OP:1)~"' ")
                    SQL.NEW           
                    SQL.EXEC 
                 
                    Message('Modificar Operacion '~Val(t:59))
                    ModificarOperacion(Val(t:59),0,NO,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
                    
                    *Recalcula campos y Movimientos instancia 0 por recalculo comisiones
                    ModificarOrden(Val(t:53),0,NO,SI,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO)
                 
                    SQL.ADD("Update "~DBO~".OPSIOPEL ")
                    SQL.ADD("   Set Procesado   = '1',")
                    SQL.ADD("       Carga       = '1', ")
                    SQL.ADD("       NrOperacion = '"~Val(t:59)~"' ")
                    SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
                    SQL.NEW
                    SQL.EXEC

                  Endif
                  ** FIN AUXGENORD2
              Else
                 ** Alta Operacion y Ejecuciones
               ** AUXGENORD1
               if Dialogo.Check1=1                 
                  ** Insert Operacion
                 ** AUXGENORDA
                 ACT(w6, GetNumerador(1))
                 ACT(c:FAC, Val(w6))
                 Message('--- #Op : '~Val(w6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:56))
                 SQL.ADD("Insert into "~DBO~".OPERACIONES (")
               
                 SQL.ADD("NrOperacion, ")
                 SQL.ADD("TipoOp, ")
                 SQL.ADD("Especie, ")
                 SQL.ADD("Cliente1, ")
                
                 SQL.ADD("Cantidad, ")
                 SQL.ADD("ContraEspecie, ")
                 SQL.ADD("Precio1, ")
                 
                 SQL.ADD("Cupon1,")
                 SQL.ADD("FechaOp, ")
                
                 if EqStr(Val(x:1),'S')
                    * Spot        
                    SQL.ADD("Plazo, ")
                    SQL.ADD("RB5, ")
                 else
                    * Futuro
                    SQL.ADD("PlazoGracia, ")
                 endif
                 SQL.ADD("RB6, ")
                 SQL.ADD("FechaVto, ")
                 SQL.ADD("Mercado, ")
                 SQL.ADD("Mercado2, ")
                 SQL.ADD("FormaLiquidacion1, ")
                
                 SQL.ADD("FormaLiquidacion2, ")
                 SQL.ADD("TablaFeriados1, ")
                 SQL.ADD("Operador, ")
                 SQL.ADD("OpSIOPEL, ")
                
                 SQL.ADD("EnteCus1, ")
                 SQL.ADD("EnteCus2, ")
                 SQL.ADD("Vehiculo1, ")
                 SQL.ADD("Mercado4, ")
                 
                 SQL.ADD("CB5, ")
                 SQL.ADD("NroAltaMAE, ")
                 SQL.ADD("UDN2, ")
                 SQL.ADD("PaseCB, ")
                 
                 SQL.ADD("AceptaMAE, ")
                 SQL.ADD("FechaAltaMAE, ")
                 SQL.ADD("FechaEnvioMAE, ")
                 SQL.ADD("Cuenta1, ")
                 
                 SQL.ADD("Cuenta4, ")
                 SQL.ADD("Cuenta5, ")
                 SQL.ADD("Observaciones, ")
                 SQL.ADD("Numerador, ")
                
                 SQL.ADD("FechaCarga, ")
                 SQL.ADD("FechaCargaSys, ")
                 SQL.ADD("UsrInput, ")
                 SQL.ADD("CB4, ")
                 
                 SQL.ADD("Direccion, ")
                 SQL.ADD("NrOrden, ")
                 SQL.ADD("Corporate, ")
                 SQL.ADD("NrOrden1, ")
                 SQL.ADD("Book1, ")
                 SQL.ADD("MB2, ")
                 SQL.ADD("AfectaLS ")
                 
                 SQL.ADD(") values (")
               
                 * NrOperacion
                 SQL.ADD(" '"~Val(w6)~"', ")
                 * TipoOp
                 SQL.ADD(" '"~Val(t:2)~"', ")
                 * Especie
                 SQL.ADD(" '"~Val(t:3)~"', ")
                 * Cliente1
                 SQL.ADD(" '"~Val(t:56)~"', ")
                                 
                 * Cantidad
                 SQL.ADD(" "~FStr(Val(t:11),0,2)~", ")
                 * ContraEspecie
                 SQL.ADD(" '"~Val(t:12)~"', ")
                 * Precio1
                 SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
                 * Cupon1
                 SQL.ADD(" '"~Val(t:17)~"', ")
                 * FechaOp
                 SQL.ADD(" '"~IdxDate(Val(t:19))~"', ")
               
                 if EqStr(Val(x:1),'S')
                    * Spot        
                    * Plazo (N)
                    SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
                    * RB5 (N)
                    SQL.ADD(" '"~Val(t:20)~"', ")
                 else
                    * Futuro        
                    * PlazoGracia (N)
                   SQL.ADD(" "~FStr(Val(t:21),1,0)~" , ")
                 endif
                 * RB6 (N) Fuente=0=Siopel
                 SQL.ADD(" '1', ")
                 * FechaVto
                 SQL.ADD(" '"~IdxDate(Val(t:45))~"', ")
                 * Mercado
                 SQL.ADD(" '"~Val(t:22)~"', ")
                 * Mercado2
                 SQL.ADD(" '"~Val(t:52)~"', ")
                 * FormaLiquidacion1
                 SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
               
                 * FormaLiquidacion2
                 SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
                 * TablaFeriados1
                 SQL.ADD(" '"~Val(t:24)~"', ")
                 * Operador
                 SQL.ADD(" '"~Val(t:25)~"', ")
                 * OpSIOPEL
                 SQL.ADD(" '"~Val(t:26)~"', ")
              
                 * EnteCus1 (N)
                 SQL.ADD(" '"~Val(t:27)~"', ")
                 * EnteCus2 (N)
                 SQL.ADD(" '"~Val(t:57)~"', ")
                 * Vehiculo1
                 SQL.ADD(" '"~Val(t:29)~"', ")
                 * Mercado4
                 SQL.ADD(" '"~Val(t:31)~"', ")
               
                 * CB5 (Es de Mercado Externo )
                 SQL.ADD(" '1', ")
                 * NroAltaMAE
                 SQL.ADD(" '"~fbn('Secuencia')~"', ")
                 * UDN2 (Rueda)
                 SQL.ADD(" '"~Val(t:32)~"', ")
                 * PaseCB
                 SQL.ADD(" '"~Val(t:33)~"', ")
                
                 * AceptaMAE
                 SQL.ADD(" 'SI', ")
                 * FechaAltaMAE
                 SQL.ADD("Convert(datetime,'"~Val(t:84)~"',120), ")
                * FechaEnvioMAE
                 SQL.ADD(" "~Val(t:49)~", ")
                 * Cuenta1
                 SQL.ADD(" '"~Val(t:28)~"', ")

                 * Cuenta4
                 SQL.ADD(" '"~Val(t:80)~"', ")
                 * Cuenta5
                 SQL.ADD(" '"~Val(t:81)~"', ")
                 * Observaciones
                 SQL.ADD(" '"~Val(t:40)~"', ")
                 * Numerador
                 SQL.ADD(" 1, ")
               
                 * FechaCarga
                 SQL.ADD(" "~SQLAhora~", ")
                 * FechaCargaSys
                 SQL.ADD(" "~IdxDate2(FSys)~", ")
                 * UsrInput
                 SQL.ADD(" '"~UsuarioActivo~"', ")
                 * Marca CPC1 x Terceros
                 SQL.ADD(" '"~Val(t:73)~"', ")

                 * Direccion
                 SQL.ADD(" 2, ")
                 * NrOrden
                 SQL.ADD(" '"~Val(t:50)~"', ")
                 * Corporate (Cartera Propia)
                 SQL.ADD(" '"~FStr(Val(t:55),1,0)~"', ")
                 * NrOrden1 (OTIC/OTIV)
                 SQL.ADD(" '"~Val(t:53)~"', ")
                 * Book1
                 SQL.ADD(" '"~Val(t:75)~"', ")
                 * MB2 Bloqueo Moneda
                 SQL.ADD(" '"~Val(t:82)~"', ")                 
                 * AfectaLS
                 SQL.ADD(" '"~Val(t:71)~"' ")
                 
                 SQL.ADD(")")
                 SQL.NEW
                
                 ** Generar Ejecuciones        
                 ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' "))
                 ACT(w:1, Copy(Val(t:84),1,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
                 **Convert(datetime,'"~Val(w:1)~"',120)
                 SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio, Cantidad2) ")
                 SQL.ADD(" Values ('"~Val(t:53)~"', '"~Val(w6)~"', '"~FStr(Val(NE:1),0,0)~"', '"~Val(u:1)~"', Convert(datetime,'"~Val(w:1)~"',120), '"~FStr(Val(t:11),0,2)~"', '"~FStr(Val(t:13),0,8)~"', '"~FStr(Val(t:11)*Val(t:13),0,2)~"') ")
                 SQL.NEW
                  
                 SQL.ADD(" Update "~DBO~".ORDENES Set ")
                 SQL.ADD("  NrOperacion2 = '"~Val(w6)~"', ")
                 SQL.ADD("  Cuotas1      = "~FStr(Val(NE:1),0,0)~", ")
                 SQL.ADD("  Cantidad1    = "~FStr(Val(t:11),0,2)~", ")
                 SQL.ADD("  Cantidad4    = "~FStr(Val(t:13),0,8)~" ")
                 SQL.ADD(" Where NrOrden = '"~Val(t:53)~"' ")
                 SQL.NEW
                 SQL.EXEC
                 
                 Message('Modificar Operacion '~Val(w6))
                 ModificarOperacion(Val(w6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
                 
                 *Recalcula campos y Movimientos instancia 0 por recalculo comisiones
                 ModificarOrden(Val(t:53),0,NO,SI,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO)
                 
                 IF Ok
                    ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
                    SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w6)~"' ")
                    SQL.NEW
                    SQL.EXEC                   
                 Endif
                 ** Instancia Orden 9 Ejecutada  
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='0'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Valor = '1' ")
                 SQL.NEW
                 SQL.EXEC           
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='1'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Nrbit = 9 ")
                 SQL.NEW
                 ** Instancia Operacion 13 Ejecutada Se elimina (va a 13 despues de poner boleto)
                 ** Instancia Operacion 65 envia Boleto MAE                   
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='0'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Valor = '1' ")
                 SQL.NEW
                 SQL.EXEC  
                 * asignar nro. de boleto automaticamente
                 EjecutarEvento('ASIBOL',Radio1=1,NrOperacion1=Val(w6))
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='1'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Nrbit = 65 ")
                 SQL.NEW
                 SQL.EXEC
               Endif
                 SQL.ADD("Update "~DBO~".OPSIOPEL ")
                 SQL.ADD("   Set Procesado   = '1',")
                 SQL.ADD("       Carga       = '1', ")
                 SQL.ADD("       NrOperacion = '"~Val(w6)~"' ")
                 SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
                 SQL.NEW 
                 SQL.EXEC
              Endif
 
           endif
           * Fin Check1=1
           
           if Dialogo.Check1=0
              ACT((78+FAC):1,  Val(t:1))
              ACT((78+FAC):2,  Val(t:2))
              ACT((78+FAC):3,  Val(t:3))
              ACT((78+FAC):4,  Val(t:4))
              ACT((78+FAC):5,  Val(t:5))
              ACN((78+FAC):6,  Val(t:6))
              ACT((78+FAC):7,  Val(t:7))
              ACT((78+FAC):8,  Val(t:8))
              ACT((78+FAC):9,  Val(t:9))
              ACT((78+FAC):10, Val(t:10))
              ACN((78+FAC):11, Val(t:11))
              ACT((78+FAC):12, Val(t:12))
              ACN((78+FAC):13, Val(t:13))
              ACN((78+FAC):14, Val(t:14))
              ACN((78+FAC):15, Val(t:15))
              ACN((78+FAC):16, Val(t:16))
              ACT((78+FAC):17, Val(t:17))
              ACT((78+FAC):18, Val(t:18))
              ACD((78+FAC):19, Val(t:19))
              ACT((78+FAC):20, Val(t:20))
              ACN((78+FAC):21, Val(t:21))
              ACT((78+FAC):22, Val(t:22))
              ACN((78+FAC):23, Val(t:23))
              ACT((78+FAC):24, Val(t:24))
              ACT((78+FAC):25, Val(t:25))
              ACT((78+FAC):26, Val(t:26))
              ACT((78+FAC):27, Val(t:27))
              ACT((78+FAC):28, Val(t:28))
              ACT((78+FAC):29, Val(t:29))
              ACT((78+FAC):30, Val(t:30))
              ACT((78+FAC):31, Val(t:31))
              ACT((78+FAC):32, Val(t:32))
              ACT(( 78+FAC):33, Val(t:33))
              ACN((78+FAC):34, Val(t:34))
              ACN((78+FAC):35, Val(t:35))
              ACT(( 78+FAC):36, Val(t:36))
              ACN(( 78+FAC):37, Val(t:37))
              ACN(( 78+FAC):38, Val(t:38))
              ACN(( 78+FAC):39, Val(t:39))
              ACT(( 78+FAC):40, Val(t:40))
              ACN(( 78+FAC):41, Val(t:41))
              ACN(( 78+FAC):42, Val(t:42))
              ACT(( 78+FAC):43, Val(t:43))
              ACN(( 78+FAC):44, Val(t:44))
              ACD(( 78+FAC):45, Val(t:45))
              ACT((78+FAC):46, Val(t:46))
              ACT((78+FAC):47, Val(t:47))
              ACT((78+FAC):48, Val(t:48))
              ACT(( 78+FAC):49, Val(t:49))
              ACT((78+FAC):50, Val(t:50))
              ACT((78+FAC):51, Val(z:1))
              ACT((78+FAC):52, Val(t:52))
              ACT((78+FAC):53, Val(t:53))
              ACT((78+FAC):54, Val(t:54))
              ACN((78+FAC):55, Val(t:55))
              ACT(( 78+FAC):56, Val(t:56))
              ACT((78+FAC):57, Val(t:57))
              ACT((78+FAC):58, Val(t:58))
              ACO((78+FAC),12)
           endif
        endif
       * Fin Z<>0 - Errores
     else
     ** xy1 NOK
        if Dialogo.Check1=1
           ** Actualiza OPSIOPEL -- mensaje no se utiliza
           SQL.ADD("Update "~DBO~".OPSIOPEL ")
           SQL.ADD("   Set Procesado   = '1',")
           SQL.ADD("       Carga       = '1', ")
           SQL.ADD("       NrOperacion = '"~IIF(EqStr(Val(t:2),'NOENCONTRADA'),'NOTFOUND','DUPL-ORD')~"' ")
           SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
           SQL.NEW
           SQL.EXEC
        endif
     endif
     else 
         ** AA 10-01-22 fin control msg duplicados
         if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".OPSIOPEL ")
            SQL.ADD("   Set Procesado  = '1',")
            SQL .ADD("       Carga      = '2' ")
            SQL.ADD(" where Secuencia2 = '"~Val(a:FAC)~"' ")
            SQL.NEW
            SQL.EXEC
         endif
     endif          
  else
     ** AA 10-01-22 Verificacion duplicidad de mensages
     ** AUXGENORD

     ACT(xy:2,SQL("Select 'NOK' From "~DBO~".EJECUCIONES Where cast(Fecha As Date) = '"~IdxDate(fbn('Fecha'))~"' and NrSecuencia = '"~fbn('Secuencia')~"' "))
  
     ACT(xy:3, iif(EqStr('NOK',Val(xy:2)),'NOK','OK'))
     *messagebox(fbn('Fecha')~' - '~fbn('Secuencia')~' - '~Val(xy:2)~' - '~Val(xy:3))
  

     **messagebox(' 368 '~val(xy:3))
     IF EqStr(val(xy:3),'OK') y Incluido(fbn('CodigoRegistro'),'0105|0205')
        ** Generar Orden , Operacion y Ejecucion
     ** AUXGENORD3
     ACT(x:1, 'S')
     ACT(xy:1,'NN')
  If Incluido(fbn('CodigoRegistro'),'0205|0105') y Not EqStr(fbn('EnteLiquidador'),'G') y [No Vacio(fbn('ComitenteComprador')) o No Vacio(fbn('ComitenteVendedor'))]   
     ACT(xy:1,'NOK')
       if Dialogo.Check1=1
          ** Actualiza OPSIOPEL -- mensaje no se utiliza
          SQL.ADD("Update "~DBO~".OPSIOPEL ")
          SQL.ADD("   Set Procesado   = '1',")
          SQL.ADD("       Carga       = '1', ")
          SQL.ADD("       NrOperacion = 'DUPL-ORD' ")
          SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
          SQL.NEW
          SQL.EXEC
       endif
  Else     
  ** si no se descarta   
     **Definir Tipo de orden y Cliente por el mensaje
     If EqStr(fbn('CodigoRegistro'),'0205')
        ACT(u:3,'OTIC')
        ACT(v:1,fbn('SecOfertaCpra'))
        ACT(u:60, Copy(fbn('FechaOfertaCpra'),5,2)~'/'~Copy(fbn('FechaOfertaCpra'),3,2)~'/20'~Copy(fbn('FechaOfertaCpra'),1,2)~' '~Copy(fbn('HoraOfertaCpra'),1,2)~':'~Copy(fbn('HoraOfertaCpra'),3,2)~':'~Copy(fbn('HoraOfertaCpra'),5,2))
        ACT(t:60, SQLFechaStr(Val(u:60),Exe('FORFECHOR')))
        ACT(u:2,  SQL("Select TipoOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaCpra')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"' "))
        ACT(t:53, SQL("Select NrOrden   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaCpra')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
        ACT(t:54, SQL("Select Cliente   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaCpra')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
     Else
        ACT(u:3,'OTIV')
        ACT(v:1,fbn('SecOfertaVta'))     
        ACT(u:60, Copy(fbn('FechaOfertaVta'),5,2)~'/'~Copy(fbn('FechaOfertaVta'),3,2)~'/20'~Copy(fbn('FechaOfertaVta'),1,2)~' '~Copy(fbn('HoraOfertaVta'),1,2)~':'~Copy(fbn('HoraOfertaVta'),3,2)~':'~Copy(fbn('HoraOfertaVta'),5,2))
        ACT(t:60, SQLFechaStr(Val(u:60),Exe('FORFECHOR')))
        ACT(u:2,  SQL("Select TipoOrden From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaVta')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
        ACT(t:53, SQL("Select NrOrden   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaVta')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
        ACT(t:54, SQL("Select Cliente   From "~DBO~".ORDENES Where NroAltaMAE='"~fbn('SecOfertaVta')~"'  and FechaOrden = '"~IdxDate(fbn('Fecha'))~"'"))
     Endif
     if EqStr(Val(u:3),'OTIC')
        ACT(t:2,'TIC')
     else
        ACT(t:2,'TIV')
     endif
     

     If EqStr(Val(t:54),Var('VEHICULO'))
        ** Es Cartera Propia
        ACN(t:55, 1)
        ACT(xy:1,'OK') 
     Else
        ** Es Terceros
        If EqStr(Val(u:2),'OTIC')
           ACT(xy:1,'OK')
        Else
           If EqStr(Val(u:2),'OTIV')
              ACT(xy:1,'OK')
           Else
              ** Si hubiese otro tipo de msg desarrollar aqui 
              ACT(xy:1,'NOK')
           Endif
        Endif
     Endif
     
     **Messagebox('Orden '~Val(t:53)~' TipoOrden '~Val(u:2)~' '~Val(t:54)~' '~Val(t:55))
     ** Arma datos Orden y Operacion  
         ** AUXGENORD0
         ***** Cantidad
         ACN(t:11, fbn('Cantidad'))
         if Val(t:11)=0
            SCN(z:1,1)
            **messagebox('Cantidad')
            ACN((26+FAC):11, 1)
         endif
         ***** PrecioMAE
         ACN(t:13, fbn('Precio'))
         ** Generar Operacion TIC/TIV
         ***** Precio3 / Precio4 / Precio1
         if Eqstr(Val(t:10),'CLE')
            ACN(t:14, Val(t:13))
         else
            ACN(t:15, Val(t:13))
         endif
         ** genera/actualiza Operacion y Ejecuciones
         ACT(t:5, fbn('AgenteContra'))
         if EqStr(fbn('Agente'),Val(v:5))
            ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
            ACT(t:5, fbn('AgenteContra'))
         else
            if EqStr(fbn('AgenteContra'),Val(v:5))
               ACT(t:5, fbn('Agente'))
            endif
         endif
         ***** Especie
         ACT(t:27, fbn('CodigoTitulo'))
         ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         if Vacio(Val(t:3))
            * Marca Incompleto
            ACN(t:44, 1)
            ACN(es:1, 1)
            ACN((26+FAC):3, 1)
            EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
            ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         else
            ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
            if Eqstr(Val(es:2),'DES')
               ACN(es:1,1)
            Endif
         endif
         ***** Cupon MAE
         ACT(t:4, fbn('NroCupon'))
         if EqStr(fbn('CodigoRueda'),'MAE1')
            ACN(t:34, 1)
         endif
         
         ***** Cliente
         ACN(t:6, Num(Val(t:5)))
         ***** Cliente Tabla
         if EqStr(fbn('CodigoRegistro'),'7020')
            ACT(t:7, fbn('Cliente'))
         Else
         If [Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y Vacio(fbn('ComitenteComprador')) y Vacio(fbn('ComitenteVendedor'))] y  (EqStr(fbn('TipoOpOrigen'),'5') o EqStr(fbn('TipoOpDestino'),'5'))
            ** Cartera Propia
            ***** Codigo Cliente
            ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(v:5)~"' "))
            ACT(t:54,Val(t:8))
            **messagebox('Cartera propia '~Val(T:54))
            ***** Operador Contra
            ACT(t:9, fbn('OperadorContra'))
            *messagebox('Ok cartera propia '~Val(t:8)~' '~Val(T:53)~' '~Val(t:9))
         Else   
            If Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y [No Vacio(fbn('ComitenteComprador')) o No Vacio(fbn('ComitenteVendedor'))]
               * Agente=0  o Agente=Vehiculo
               if NoVacio(fbn('ComitenteComprador'))
                  ACT(t:61, fbn('ComitenteComprador'))
               else
                  ACT(t:61, fbn('ComitenteVendedor'))
               endif
               ACN(t:62, Longitud(Val(t:61)))
               if Val(t:62)>1
                  ACT(t:63, Copy(Val(t:61),1,2))
                  if EqStr(Val(t:63),'*C')
                     * es CUIT
                     if Val(t:62)>2
                        if Val(t:62)>13
                           ACT(t:64, Copy(Val(t:61),3,11))
                        else
                           ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                        endif
                        ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CUIT = '"~Val(t:64)~"' "))
                     endif
                  endif
                  if Incluido(Val(t:63),'*F|*S')
                    * es Fondo o Seguros
                    * FJL 23/08/21 - Issue 5092 - Cambio criterio FCI
*                    ACT(t:64, Copy(Val(t:61),2,Val(t:62)-1))
*                    if EqStr(Val(t:63),'*F')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='FON' "))
*                    endif
*                    if EqStr(Val(t:63),'*S')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='CSE' "))
*                    endif
                    ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                    if EqStr(Val(t:63),'*F')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='FON' "))
                    endif
                    if EqStr(Val(t:63),'*S')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='CSE' "))
                    endif
                  endif
                  if NoVacio(Val(t:65))
                     ACT(t:8, Val(t:65))
                     ACT(t:54,Val(t:8))
                     **messagebox('No cartera Propia '~Val(T:54))
                  endif
               endif  
               if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                  * Agente=0  y FCI/AFJP
                  ACN((26+FAC):8, 2)
               else
                  if Val(t:34)=1
                     * MAE1
                     ACN((26+FAC):8, 3)
                  else
                     ACN((26+FAC):8, 1)
                  endif
               endif
            else
               ***** Codigo MAE Cliente
               **ACT(t:53, Val(t:5))
               ***** Codigo Cliente
               ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
               ACT(t:54,Val(t:8))
               **messagebox('Codigo MAE Cliente '~Val(T:54))
               ***** Operador Contra
               ACT(t:9, fbn('OperadorContra'))
               ** ver si es OTIC/OTIV
               ** if Vacio(Val(t:8)) y Not EqStr(Val(t:2),'TCOPRI')
               if Vacio(Val(t:8))
                  ACN(cl:1,1)
                  ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
               endif
            endif
         Endif         
         Endif
        ** messagebox(Val(t:54)~' '~fbn('CodigoRueda')~' '~Var('RUECPC1'))
         if  Eqstr(Val(t:54),Var('VEHICULO'))    
             ACN(t:55,1)
         Else
             ACN(t:55,0)   
         Endif

         ** Cta y Ord 3ros    
         if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) y Not Eqstr(Val(t:54),Var('VEHICULO'))    
            ACT(t:73,'1')
         Else   
            ACT(t:73,'0')
         Endif
        
         **Mercado Especie y Mercado Contraespecie Orden desde SIOPEL
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            ***** Mercado4
            ACT(t:31, Var('AMBMAE'))
            ***** Especie T:3/ Mercado T:22
            *ACT(t:22, MercadoDef(Val(t:3)))
            ACT(t:22, Var('MERLIQCPC1'))
            ***** ContraEspecie T:12 / Mercado2 T:52
            #ifdef MLASA
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
            #else
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
                   
            #endif
         Endif

         ***** InteresesMAE
         ACN(t:16, fbn('Interes'))
         ***** Es ZeroCupon
         ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
         ***** Nro Cupon
         if EqStr(Val(t:58),'SI')    
            ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
         else
            ACT(t:17, Val(t:4))
         endif
         ***** Fecha Op
         if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05') o (EqStr(fbn('CodigoRegistro'),'7020') y EqStr(Copy(fbn('CodRegContestado'),3,2),'05'))
            ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
            ACD(t:19, Fecha(Val(t:18)))
         else
            SCN(z:1,1)
            **messagebox('fecha Op')
            ACN((26+FAC):19, 1)
         endif
    
         ***** Mercado
         ** AA se omite. solo se realiza por Merdadodef
         if NO
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) 
               ACT(t:22, 'CV')
               ACT(t:52, 'BCRA')
            Else
               if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
                  ACT(t:22, 'AC')
                  ACT(t:52, 'AC')
               else
                  if EqStr(fbn('EnteLiquidador'),'2')
                     ACT(t:22, 'CRYL')
                     ACT(t:52, 'BCRA')
                  else
                     if EqStr(fbn('EnteLiquidador'),'3')
                        ACT(t:22, 'CE')
                        ACT(t:52, 'CE')
                     else
                        if EqStr(fbn('EnteLiquidador'),'4')
                           ACT(t:22, 'EU')
                           ACT(t:52, 'EU')
                        else
                           if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
                              ACT(t:22, 'CV')
                           else
                              if Incluido(fbn('EnteLiquidador'),'G|F|W|U')
                                 ACT(t:22, 'MC')
                                 ACT(t:52, 'MC')
                              else
                                 *SCN(z:1,1)
                                 * Marca Incompleto
                                 **box('Ente liquidador')
                                 **ACN(t:44, 1)
                                 ACN((26+FAC):22, 1)
                              endif
                           endif
                        endif
                     endif
                  endif
               endif
            Endif
         Endif
**  Endif de IF NO
         ENDIF
         
         ***** FormaLiquidacion
         if EqStr(fbn('TipoLiquidacion'),'2')
            ACN(t:23, 0)
         else
            if EqStr(fbn('TipoLiquidacion'),'1')
               ACN(t:23, 1)
            else
               if EqStr(fbn('TipoLiquidacion'),'6')
                  ACN(t:23, 2)
               else
*                 SCN(z:1,1)
                  * Marca Incompleto
                  **messagebox('Forma liquidacion')
                  **ACN(t:44, 1)
                  ACN((26+FAC):23, 1)
               endif
            endif
         endif
         ** AA 05-05-2022 Se incorpora mercado variable FormaLiquidacion1 y FormaLiquidacion2
         **IF Incluido(Val(T:22), VAR('MERCAACMC'))         
         IF Incluido(Val(T:22), VAR('MERCAVARI'))
         ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)
         Else
            ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)         
         ENDIF
         ***** Operador / OperadorContra
         if Incluido(Val(t:2),'TIV')
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
            ACT(t:26, fbn('OperadorContra'))
         else
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
            ACT(t:26, fbn('Operador'))
         endif
         if Vacio(Val(t:25))
            ACT(t:25, UsuarioActivo)
         endif
         ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

         ***** Vehiculo1
         ACT(t:29, Var('VEHICULODE'))

         *** ContraEspecie2 Moneda de Liquidacion ****
         If Eqstr(Val(t:12),VAR('MONELOCA'))
            ACT(T:46,Val(t:12))
         Else
            ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
         Endif
         if EqStr(Val(t:12),'USD')
            if Incluido(Val(t:22),VAR('MERCAACMC'))
               ACT(t:46, 'USD')
               if EqStr(fbn('EnteLiquidador'),'B')
                  ACT(t:46, 'USB')
               endif
            endif
            if EqStr(Val(t:22),'CRYL')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'CV')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'EU')
               if EqStr(fbn('TipoOpDestino'),'5') 
                  ACT(t:46, 'USD')
               else
                  ACT(t:46, 'USD')
               endif
            endif
         endif
         ***** Tabla Feriados
         if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9')
            ACT(t:24, 'USA')
         endif
         if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
            ACT(t:24, 'ARG')
         endif
         if Incluido(Val(t:22),VAR('MERCAACMC'))
            if Incluido(Val(t:46),'ARP|USB')
               ACT(t:24, 'ARG')
            endif
            if EqStr(Val(t:46),'USD')
               ACT(t:24, 'USA')
            endif
         endif
        if Vacio(Val(t:24))
           * SCN(z:1,1)
           * Marca Incompleto
           *messagebox('feriados')
           **ACN(t:44, 1)
           ACN((26+FAC):24, 1)
        endif

        ***** RB5
        ACT(t:20, Fstr(Num(fbn('Plazo')),1,0))

        ***** Plazo / Lote
        ACN(t:21, Num(fbn('Plazo'))*24)

        ***** FechaVto
        ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))

        ***** UDN1
        ACT(t:30, 'MD')
        ***** Rueda 
        ACT(t:32, fbn('CodigoRueda'))
        ***** PaseCB
        ACT(t:33, '0')
        ***** MAE1
        if Val(t:34)=1
           ***** Datos MAE1
           ACT(t:36, fbn('Referencia'))
           ACN(t:37, Num(Val(t:36)))
           if Val(t:37)=0
              ACN(t:35, 0)
              ACN(t:38, 1)
           else
              if EqStr(fbn('TipoOpOrigen'),'1')
                 ** Terceros
                 ACN(t:35, 0)
              else
                 ACN(t:35, 1)
              endif
           endif
           if EqStr(fbn('TipoOpDestino'),'5')
              * Agente
              ACN(t:39, 0)
           else
              if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                 if EqStr(fbn('TipoOpDestino'),'2')
                    * FCI
                    ACN(t:39, 1)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'4')
                    * AFJP Fondo
                    ACN(t:39, 2)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'6')
                    * AFJP Encaje
                    ACN(t:39, 3)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'7')
                    * AFJP Adminis (Cartera Propia)
                    ACN(t:39, 4)
                 endif
              endif
           endif
        endif

        if DesciendeDeEspecie(Val(t:3),'LETES')
           *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
           ACN(x:2, 1)
        else
           ACN(x:2, 0)
        endif 

        * Cliente definitivo a la Operacion
        ACT(t:56, Val(t:54))
        if Vacio(Val(t:56)) y Val(t:34)=1
           * Vacio Cliente y MAE1
           ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
        else
           ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
        endif
        if Val(t:41) = 1
           ACN(t:42, 1)
           if Vacio(Val(t:56)) y Val(t:34)=1
              * Vacio Cliente y MAE1
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
           else
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
           endif
           if Dialogo.Check1=1
              SQL.ADD("Update "~DBO~".OPSIOPEL ")
              SQL.ADD("   Set Procesado   = '1',")
              SQL.ADD("       Carga       = '1', ")
              SQL.ADD("       NrOperacion = 'DUPLIC' ")
              SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
              SQL.NEW
              SQL.EXEC
           endif
        endif
        if Vacio(Val(t:56))
           * Vacio Cliente
           if Val(t:34)=0
              * NO MAE1
              * Marca Incompleto
           endif
           ACT(t:56, 'SIOPEL')
           ACN(t:44, 1)
           ACN((26+FAC):8, 1)
        endif
        ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        *ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
        ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
        ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))
        
        ACT(t:51, fbn('SecEnvioOrden'))
