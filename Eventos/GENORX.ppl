ACT(s:1, 'Secuencia2')
ACT(s:2, 'TipoOp')
ACT(s:3, 'Especie')
ACT(s:4, 'Cupon MAE')
ACT(s:5, 'Ag.Contra')
ACT(s:6, 'Num Ag.Contra')
ACT(s:7, 'Clie.Tabla')
ACT(s:8, 'Cliente')
ACT(s:9, 'Op.Contra (A)')
ACT(s:10, 'VTXT3 (A)')
