MostrarCuadroDeMensajes
*HOJAVISIBLE(SI)
CrearDialogo
  Fecha1 :"Fecha: " ;1;1;;NO;;;;;;FSYS
  String :'Path:  ' ;2;1;;;;NOVACIO(Dialogo.String);'Path Invalido';NO;VAR('DIRRIO');
  String2   :"Nuevo Directorio" ;;;;;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('RIOPROCES')
  Radio1:  '|W98|NT'   ;;;;;;;;;0
  Entero1: 'Registros' ;;;;;;;;;VAR('RIOREGISTR')
FinDialogo

If Not Ok
   Cancelar
Endif

SQL.ADD(" UPDATE "~DBO~".NUMERADORES SET Numero=0 WHERE Codigo='10106' ")
SQL.NEW
SQL.EXEC
ACT(ww:1, PrimerArchivo(MIRT(TRIM(Dialogo.String))~'\*.csv') )
If NOT Vacio(VAL(ww:1))
   AbrirAscii(TRIM(MIRT(Dialogo.String))~Val(ww:1),0)
   ACT(x:1,LeerAscii)
   If Incluido(Copy(Val(x:1),45,8),'Extracto')
      CerrarAscii
      message('Es un archivo de Movimientos RIO.'~Copy(Val(x:1),45,8))
      * ----------- Este es el divisor de archivos ---------------- *
      EjecutarEvento('RIO002',Fecha1=Dialogo.Fecha1,String=Dialogo.String,String3=Val(ww:1),String2=Dialogo.String2,Radio1=Dialogo.Radio1,Entero1=Dialogo.Entero1)
   Else
      message('No es un archivo de saldos y movimientos.')
      CerrarAscii
   Endif
EndIf


Recorrer&j 2,1000000
  ACT(ww:&j, ProximoArchivo)
  If Not Ok 
     Break
  Endif
  AbrirAscii(TRIM(MIRT(Dialogo.String))~Val(ww:&j),0)
  ACT(x:1,LeerAscii )

  If Incluido(Copy(Val(x:1),45,8),'Extracto')
     CerrarAscii
     message('Es un archivo de Movimientos RIO.'~Copy(Val(x:1),45,8))
     * --------------- Este es el divisor de Archivos -------------------- *
     EjecutarEvento('RIO002',Fecha1=Dialogo.Fecha1,String=Dialogo.String,String3=Val(ww:&j),String2=Dialogo.String2,Radio1=Dialogo.Radio1,Entero1=Dialogo.Entero1)
  Else
     CerrarAscii
  Endif
Proximo



* -------------------------------------------------------------------------------------------- *
* CAPTURA ARCHIVOS GENERADOS CON EL DIVISOR DE ARRIBA
* -------------------------------------------------------------------------------------------- *
message(' Capturando Archivos ... ')

ACT(ww:1, PrimerArchivo(MIRT(TRIM(Dialogo.String))~'\Extracto*.csv') )
If NOT Vacio(VAL(ww:1))
   AbrirAscii(TRIM(MIRT(Dialogo.String))~Val(ww:1),0)
   ACT(x:1,LeerAscii)
   If Incluido(Copy(Val(x:1),45,8),'Extracto')
      CerrarAscii
      message('Es un archivo de Movimientos RIO.'~Copy(Val(x:1),45,8))
      EjecutarEvento('RIO003',Fecha1=Dialogo.Fecha1,Fecha2=HABILES(Dialogo.Fecha1,-VAR('RIOCAPTURA'),'ARG'),String=Dialogo.String~Val(ww:1),String2=VAR('RIOPROCES'),Radio1=Dialogo.Radio1,Check10=1)
   Else
      message('No es un archivo de saldos y movimientos.')
      CerrarAscii
   Endif
EndIf


Recorrer&j 2,1000000
  ACT(ww:&j, ProximoArchivo)
  If Not Ok 
     Break
  Endif
  AbrirAscii(TRIM(MIRT(Dialogo.String))~Val(ww:&j),0)
  ACT(x:1,LeerAscii )

  If Incluido(Copy(Val(x:1),45,8),'Extracto')
     CerrarAscii
     message('Es un archivo de Movimientos RIO.'~Copy(Val(x:1),45,8))
     EjecutarEvento('RIO003',Fecha1=Dialogo.Fecha1,Fecha2=HABILES(Dialogo.Fecha1,-VAR('RIOCAPTURA'),'ARG'),String=Dialogo.String~Val(ww:&j),String2=VAR('RIOPROCES'),Radio1=Dialogo.Radio1,Check10=1)
  Else
     CerrarAscii
  Endif
Proximo
