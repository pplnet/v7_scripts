SQL.ADD(" Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGCPC'))~") ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUECPC1'))~")    ")
SQL.ADD("    and CodigoRegistro in ('0105','0205','7020')              ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                     ")
**SQL.ADD("    and Fecha       = '20220421'                     ")
SQL.ADD("    and Carga       is null                                   ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                           ")
*If Novacio(Dialogo.NrOrden1)
*   SQL.ADD("    and NrOrden = '"~Dialogo.NrOrden1~"'                   ")
*   SQL.ADD("    and NrOrden = 'OR004134'                   ")
*Endif
watch(SQL.Batch)
Recorrer SQL
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..u:90)
  ***** Secuencia2
  ACT(t:1, fbn('Secuencia2'))
  ACT(u:1, fbn('Secuencia'))
  ***** TipoOp
  if EqStr(fbn('CodigoRegistro'),'7020')
     ACT(x:1, 'S')
     ACT(xy:1,'NN')
     
     SQL.ADD(" Select Cliente, TipoOrden, ContraEspecie, ")
     SQL.ADD("        Mercado, Mercado2, Mercado3, ")
     SQL.ADD("        Vehiculo, Operador, RB9, RB10, Book1, Lotes Plazo, RB5, ")
     SQL.ADD("        Cuotas1, CB10, Cupon1, AfectaLS, ")
     SQL.ADD("        Cuenta1, Cuenta4, Cuenta5, MB2  ")
     SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~fbn('NrOrden')~"' ")
     Recorrer SQL
        DFA
        ACT(u:2,  fbn('TipoOrden'))
        ACT(t:12, fbn('ContraEspecie'))
        ACT(t:22, fbn('Mercado'))        
        ACT(t:31, fbn('Mercado3'))
        ACT(t:52, fbn('Mercado2'))
        ACT(t:8,  fbn('Cliente'))         
        ACT(t:54, fbn('Cliente')) 
        ACT(t:75, fbn('Book1'))
        ACT(t:28, fbn('Cuenta1'))
        ACT(t:80, fbn('Cuenta4'))
        ACT(t:81, fbn('Cuenta5'))
        ACT(t:82, fbn('MB2'))
        ACT(t:85, fbn('AfectaLS'))
     Proximo
     
     if EqStr(Val(u:2),'OTIC')
        ACT(t:2,'TIC')
     else
        if EqStr(Val(u:2),'OTIV')
           ACT(t:2,'TIV')
        else
           ACT(t:2,'NOENCONTRADA')
        endif   
     endif
     **messagebox('es 7020 '~Val(T:54))
     If EqStr(Val(t:54),Var('VEHICULO')) y Incluido(fbn('CodRegContestado'),'0105|0205')
        ** Es Cartera Propia
        ACN(t:55, 1)
        ACT(xy:1,'OK') 
     Else
        ** Es Terceros
        If EqStr(Val(u:2),'OTIC') y EqStr(fbn('CodRegContestado'),'0105')
           ACT(xy:1,'OK')
        Else
           If EqStr(Val(u:2),'OTIV') y EqStr(fbn('CodRegContestado'),'0205')
              ACT(xy:1,'OK')
           Else
              ** Si hubiese otro tipo de msg desarrollar aqui 
              ACT(xy:1,'NOK')
           Endif
        Endif
     Endif
     ** AA 10-01-22 Verificacion duplicidad de mensages
     (.'AUXGENORD'.)
     **messagebox(' 248 '~val(xy:3))
   IF EqStr(val(xy:3),'OK')
     If  EqStr(Val(xy:1),'OK')
         ** Armado datos Operacion/Orden
         ACT(t:53, fbn('NrOrden'))
         (.'AUXGENORD0'.)
         **messagebox('Desp ord 0 '~Val(T:54)~' '~Val(T:73))
         ** Actualiza AfectaLS de la Orden
         ACT(t:71, Val(t:85))
        if Val(z:1)=0
           ACT(b:FAC, 'OK')
           if Dialogo.Check1=1
              ** verificar si ya se dio de alta la Operacion
              ACT(t:59, BuscarCampo('OPERACIONES','NrOperacion','NrOrden1',fbn('NrOrden')))
              If NoVacio(Val(t:59))
                 ** Generar Ejecucion y Actualizar Orden y Operacion
                 (.'AUXGENORD2'.)
              Else
                 ** Alta Operacion y Ejecuciones
                 (.'AUXGENORD1'.)
                 SQL.ADD("Update "~DBO~".OPSIOPEL ")
                 SQL.ADD("   Set Procesado   = '1',")
                 SQL.ADD("       Carga       = '1', ")
                 SQL.ADD("       NrOperacion = '"~Val(w6)~"' ")
                 SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
                 SQL.NEW 
                 SQL.EXEC
              Endif
 
           endif
           * Fin Check1=1
           
           if Dialogo.Check1=0
              ACT((78+FAC):1,  Val(t:1))
              ACT((78+FAC):2,  Val(t:2))
              ACT((78+FAC):3,  Val(t:3))
              ACT((78+FAC):4,  Val(t:4))
              ACT((78+FAC):5,  Val(t:5))
              ACN((78+FAC):6,  Val(t:6))
              ACT((78+FAC):7,  Val(t:7))
              ACT((78+FAC):8,  Val(t:8))
              ACT((78+FAC):9,  Val(t:9))
              ACT((78+FAC):10, Val(t:10))
              ACN((78+FAC):11, Val(t:11))
              ACT((78+FAC):12, Val(t:12))
              ACN((78+FAC):13, Val(t:13))
              ACN((78+FAC):14, Val(t:14))
              ACN((78+FAC):15, Val(t:15))
              ACN((78+FAC):16, Val(t:16))
              ACT((78+FAC):17, Val(t:17))
              ACT((78+FAC):18, Val(t:18))
              ACD((78+FAC):19, Val(t:19))
              ACT((78+FAC):20, Val(t:20))
              ACN((78+FAC):21, Val(t:21))
              ACT((78+FAC):22, Val(t:22))
              ACN((78+FAC):23, Val(t:23))
              ACT((78+FAC):24, Val(t:24))
              ACT((78+FAC):25, Val(t:25))
              ACT((78+FAC):26, Val(t:26))
              ACT((78+FAC):27, Val(t:27))
              ACT((78+FAC):28, Val(t:28))
              ACT((78+FAC):29, Val(t:29))
              ACT((78+FAC):30, Val(t:30))
              ACT((78+FAC):31, Val(t:31))
              ACT((78+FAC):32, Val(t:32))
              ACT(( 78+FAC):33, Val(t:33))
              ACN((78+FAC):34, Val(t:34))
              ACN((78+FAC):35, Val(t:35))
              ACT(( 78+FAC):36, Val(t:36))
              ACN(( 78+FAC):37, Val(t:37))
              ACN(( 78+FAC):38, Val(t:38))
              ACN(( 78+FAC):39, Val(t:39))
              ACT(( 78+FAC):40, Val(t:40))
              ACN(( 78+FAC):41, Val(t:41))
              ACN(( 78+FAC):42, Val(t:42))
              ACT(( 78+FAC):43, Val(t:43))
              ACN(( 78+FAC):44, Val(t:44))
              ACD(( 78+FAC):45, Val(t:45))
              ACT((78+FAC):46, Val(t:46))
              ACT((78+FAC):47, Val(t:47))
              ACT((78+FAC):48, Val(t:48))
              ACT(( 78+FAC):49, Val(t:49))
              ACT((78+FAC):50, Val(t:50))
              ACT((78+FAC):51, Val(z:1))
              ACT((78+FAC):52, Val(t:52))
              ACT((78+FAC):53, Val(t:53))
              ACT((78+FAC):54, Val(t:54))
              ACN((78+FAC):55, Val(t:55))
              ACT(( 78+FAC):56, Val(t:56))
              ACT((78+FAC):57, Val(t:57))
              ACT((78+FAC):58, Val(t:58))
              ACO((78+FAC),12)
           endif
        endif
       * Fin Z<>0 - Errores
     else
     ** xy1 NOK
        if Dialogo.Check1=1
           ** Actualiza OPSIOPEL -- mensaje no se utiliza
           SQL.ADD("Update "~DBO~".OPSIOPEL ")
           SQL.ADD("   Set Procesado   = '1',")
           SQL.ADD("       Carga       = '1', ")
           SQL.ADD("       NrOperacion = '"~IIF(EqStr(Val(t:2),'NOENCONTRADA'),'NOTFOUND','DUPL-ORD')~"' ")
           SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
           SQL.NEW
           SQL.EXEC
        endif
     endif
     else 
         ** AA 10-01-22 fin control msg duplicados
         if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".OPSIOPEL ")
            SQL.ADD("   Set Procesado  = '1',")
            SQL .ADD("       Carga      = '2' ")
            SQL.ADD(" where Secuencia2 = '"~Val(a:FAC)~"' ")
            SQL.NEW
            SQL.EXEC
         endif
     endif          
  else
     ** AA 10-01-22 Verificacion duplicidad de mensages
     (.'AUXGENORD'.)
     **messagebox(' 368 '~val(xy:3))
     IF EqStr(val(xy:3),'OK') y Incluido(fbn('CodigoRegistro'),'0105|0205')
        ** Generar Orden , Operacion y Ejecucion
        (.'AUXGENORD3'.)
     Else
        if Dialogo.Check1=1
           SQL.ADD("Update "~DBO~".OPSIOPEL ")
           SQL.ADD("   Set Procesado  = '1',")
           SQL .ADD("       Carga      = '2' ")
           SQL.ADD(" where Secuencia2 = '"~Val(a:FAC)~"' ")
           SQL.NEW
           SQL.EXEC
        endif
     Endif
  endif    


proximo

if Dialogo.Check1=0 y FAC>0
  FormatoCeldas(t:6..t:6,Exe('F0'))
  FormatoCeldas(t:11..t:11,Exe('F2'))
  FormatoCeldas(t:13..t:15,Exe('F8'))
  FormatoCeldas(t:16..t:16,Exe('F2'))
  FormatoCeldas(t:21..t:55,Exe('F0'))

  FormatoCeldas(ca:6..(78+FAC):6,Exe('F0'))
  FormatoCeldas(ca:11..(78+FAC):11,Exe('F2'))
  FormatoCeldas(ca:13..(78+FAC):15,Exe('F8'))
  FormatoCeldas(ca:16..(78+FAC):16,Exe('F2'))
  FormatoCeldas(ca:21..(78+FAC):55,Exe('F0'))
  ACO(1, 10)
  ACO(19,15)
  ACO(20,12)
  ACO(78,15)
endif
