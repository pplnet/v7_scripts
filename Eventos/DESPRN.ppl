*HojaVisible(SI)
CrearDialogo
  NrTrans1: 'NrVoucher';
  Fecha1  : 'Fecha'    ;;;;;;;;;FSys
FinDialogo
if Not OK
  Cancelar
endif

SQL.ADD("Select * from "~DBO~".MOVEJECUTADOS M            ")
SQL.ADD("Where NrTrans2 = '"~Dialogo.NrTrans1~"'          ")
SQL.ADD("  and NrOperacion <> '"~Dialogo.NrTrans1~"'      ")
SQL.ADD("  and exists(select * from "~DBO~".OPERACIONES O ")
SQL.ADD("             where M.NrOperacion=O.NrOperacion   ")
SQL.ADD("             and O.TipoOp in ('FXCT','FXVT')     ")
SQL.ADD("             and O.MB3='1'                       ")
SQL.ADD("             and O.FormaLiquidacion1='1'         ")
SQL.ADD("            )                                    ")
recorrer SQL
  ACT(a:FAC, FBN('NrOperacion'))
  ACT(b:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Val(a:FAC)))
  ACN(c:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PRESETTLEM' "))
  ACN(d:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PSVN' "))
  if Val(c:FAC)>0
    ACT(e:FAC, 'PRESET')
    SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PRESETTLEM' ")
    recorrer SQL
      DFA
      SCN(f:FAC, 1)
      SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
      SQL.ADD("FechaMov, Cliente, Limite, ")
      SQL.ADD("Especie, Monto, NrOperacion, ")
      SQL.ADD("Descripcion, Usuario, Bits, ")
      SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
      SQL.ADD("Sublimite, Commited ")
      SQL.ADD(") values (")
      SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"',")
      SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(c:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
      SQL.ADD(" 'Conf. DVP', '', ")
      if Dialogo.Fecha1<=FSys
        SQL.ADD(" 'P', ")
      else
        SQL.ADD(" 'N', ")
      endif
      SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
      SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
      SQL.ADD(" )")
      SQL.NEW
      Break
    proximo
  endif
  if Val(d:FAC)>0
    ACT(h:FAC, 'PSVN')
    SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PSVN' ")
    recorrer SQL
      DFA
      SCN(i:FAC, 1)
      SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
      SQL.ADD("FechaMov, Cliente, Limite, ")
      SQL.ADD("Especie, Monto, NrOperacion, ")
      SQL.ADD("Descripcion, Usuario, Bits, ")
      SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
      SQL.ADD("Sublimite, Commited ")
      SQL.ADD(") values (")
      SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"',")
      SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(d:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
      SQL.ADD(" 'Conf. DVP', '', ")
      if Dialogo.Fecha1<=FSys
        SQL.ADD(" 'P', ")
      else
        SQL.ADD(" 'N', ")
      endif
      SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
      SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
      SQL.ADD(" )")
      SQL.NEW
      Break
    proximo
  endif
  SQL.EXEC
Proximo
