MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Dif. Cambio Fondos ---')

ACT(ML:1, Var('MONELOCA'))

ACD(v:1, Dialogo.Fecha1)
ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:3, Habiles(PriDeMes(Val(v:2)),-1,'ARG'))

ACT(y:1, Dialogo.Lista1)
ACT(y:2, '101')

SetFilaActual(1)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Cupon')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'TipoNegocio')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'CantidadFin')
ACT(j:FAC, 'PrecioFin')
ACT(k:FAC, 'Cotiza')
ACT(l:FAC, 'Cot.Mes Ant')
ACT(m:FAC, 'Cot.Actual')
ACT(n:FAC, 'Dif.Cotiz.')
ACT(o:FAC, 'Res.Saldo Ant.')
ACT(p:FAC, 'Res.Operac.')
ACT(q:FAC, 'Res.TOTAL')
ACT(r:FAC, 'Tipos Asi')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Nombre')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'NrSaldo')
ACT(ae:FAC, 'TipoNegocio')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'FechaMov')
ACT(ai:FAC, 'Cantidad')
ACT(aj:FAC, 'Precio')
ACT(ak:FAC, 'Cotiza')
ACT(al:FAC, 'Cotizacion')
ACT(am:FAC, 'Dif.Cotiz.')
ACT(an:FAC, 'Resultado')
ACT(ao:FAC, 'Linea')
ACT(ap:FAC, 'NrOperacion')
ACT(aq:FAC, 'TipoOp')
ACT(ar:FAC, 'FechaOp')


********************************
**********   FONDOS   **********
********************************
SQL.ADD(" Select P.Especie,  P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD(" Sum(P.CantidadFin) as Cantidad, Sum(P.CantidadFin*P.PrecioFin) as Monto, V.Valor1, V.Valor2, E.Cotiza Moneda, ")
SQL.ADD(" P.Cliente, '' Observaciones, E.Alias8 ")
SQL.ADD(" From "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where P.Especie = E.Codigo ")
SQL.ADD(" AND P.Vehiculo = V.Codigo ")
SQL.ADD(" and P.NrSaldo in ("~Val(y:2)~") ")
SQL.ADD(" and P.TipoNegocio = 'FC' ")
SQL.ADD(" AND E.Cotiza <> '"~Val(ML:1)~"' ")
if NoVacio(Val(y:1))
  SQL.ADD(" and P.Vehiculo    In ("~Pipe2Comillas(val(y:1))~") ")
endif
SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
SQL.ADD("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(v:3))~" ) ")
SQL.ADD(" AND   P.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, V.Valor1, V.Valor2, P.Cliente, E.Alias8 ")
Recorrer SQL
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
    ACN(d:FAC, FBN('NrSaldo'))
    ACT(e:FAC, FBN('TipoNegocio'))
    ACT(f:FAC, FBN('Vehiculo'))
    ACN(i:FAC, FBN('Cantidad'))
    ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
    ACT(k:FAC, FBN('Cotiza'))
    ***---Cotizacion Especie mes anterior
    ACN(CT:fac, Cotizacion(fbn('Especie'),,,,Val(V:3),1,SI))
    ACN(L:fac, CotizacionBNA(fbn('Cotiza'), Val(V:3),1,NO,NO))
    ACN(M:fac, CotizacionBNA(fbn('Cotiza'), Val(V:2),1,NO,NO))
    ACN(O:fac, fbn('Cantidad') * Val(CT:fac) * (Val(M:fac) - Val(L:fac)))
    ACT(S:fac, fbn('Cliente'))
    ACN(CT:3, CotizacionBNA(fbn('Cotiza'), Val(V:2),1,NO,NO))
proximo

if FAC>1
  recorrer&i 2,FAC
    ACN(q:&i, Val(o:&i))
    ACT(r:&i, Var('TIASDICAFO'))
    ACD(FV:1, Val(V:2))
    SQL.ADD(" Select MA.Codigo ")
    SQL.ADD(" From "~DBO~".MODELOSASIENTO MA ")
    SQL.ADD(" Where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
    Recorrer SQL    
      DFA
      Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
      ACT(MD:1, fbn('Codigo'))
      ACN(RS:1, Val(Q:&i))
      SQL.ADD(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, V.Valor1, V.Valor2, E.Cotiza Moneda, ")
      SQL.ADD(" C.Codigo Cliente1, '' Observaciones , 'DCFCI' NrOperacion")
      SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C ")
      SQL.ADD(" Where E.Codigo = '"~Val(A:&i)~"' ")
      SQL.ADD(" AND V.Codigo = '"~Val(F:&i)~"' ")
      SQL.ADD(" AND C.Codigo = '"~Val(S:&i)~"' ")
      Recorrer SQL
          DFA
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
             ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~Val(MD:1)~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~Val(F:&i)~"' "))
                  ACN(CK:1, 0)
             ENDIF
          ENDIF
          IF Val(CK:1) = 0
              let &modeloContable Val(MD:1)
              SQL.GenerarAsientoOp(Val(MD:1), '','','',810,Val(FV:1),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
      Proximo
    proximo
  proximo
endif
