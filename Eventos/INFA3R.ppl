* Nuevo evento para informar operaciones a A3 utilizando la API Rest

CrearDialogo
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(x:1, Var('PLATAA3'))

ACT(s:1, 'NrOperacion')
ACT(s:2, 'Especie')
ACT(s:3, 'Precio1')
ACT(s:4, 'Cantidad')
ACT(s:5, 'TipoLiq')
ACT(s:6, 'CuentaVenta')
ACT(s:7, 'CuentaCompra')
ACT(s:8, 'RequestId')
ACT(s:9, 'RegistrationId')
ACT(s:10, '10-Usuario')
ACT(s:11, 'Estado')
ACT(s:12, 'Descripcion')
ACT(s:11, 'Fecha')
ACT(s:14, 'Accion')
ACT(s:15, 'Mensaje')
ACT(s:16, 'z:1')
ACT(s:17, 'TipoOp')

ACT(s:18, 'Merc.Neg')
ACT(s:19, 'Especie')
ACT(s:20, '20-Moneda')
ACT(s:21, 'Merc.Esp.')
ACT(s:22, 'Merc.Mon.')
ACT(s:23, '# EspMer')
ACT(s:24, 'Cod EspMer')

ACT(s:25, 'FechaOp')
ACT(s:26, 'Plazo')

ACT(s:27, 'NrRofex Cli')
ACT(s:28, '28-TipoCli')

if Dialogo.Check1=0
  recorrer&i 1,30
    ACT(bz:&i, Val(s:&i))
  proximo
endif

*- Seleccion de las operaciones que se encuentran en la instancia Informar al MAE (60)
SQL.ADD("SELECT O.NrOperacion, O.TipoOp,     O.Especie,  O.ContraEspecie, ")
SQL.ADD("       O.Precio1,     O.Cantidad,   ")
SQL.ADD("       O.FechaOp,     O.Plazo,      O.Cliente1, ")
SQL.ADD("       O.Mercado4,    O.Plataforma, O.EstadoA3, ")
SQL.ADD("       O.Mercado,     O.Mercado2,   ")
SQL.ADD("       O.Cuenta1,     O.Cuenta2,    O.Cuenta3,  O.Cuenta4, ")
SQL.ADD("       O.Operador  ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 60 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD("   and IsNull(O.Plataforma,'SIOPEL') = '"~Val(x:1)~"' ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL
  ACN(z:1, 0)
  BorrarCeldas(t:1..t:30)
  ACT(a:FAC, fbn('NrOperacion'))
  if Incluido(FBN['TipoOp'], 'TIC|TIV|TIFV|TIFC')
    
    ACT(t:1, fbn('NrOperacion'))
    ACT(t:17, fbn('TipoOp'))
    ACT(t:18, fbn('Mercado4'))
    ACT(t:19, fbn('Especie'))
    ACT(t:20, fbn('ContraEspecie'))
    ACT(t:21, fbn('Mercado'))
    ACT(t:22, fbn('Mercado2'))
    SQL.ADD("Select * From "~DBO~".ESPECIESMERCADOS ")
    SQL.ADD("Where Mercado = '"~fbn('Mercado4')~"' ")
    SQL.ADD("and Especie = '"~fbn('Especie')~"' ")
    SQL.ADD("and Moneda = '"~fbn('ContraEspecie')~"' ")
    SQL.ADD("and MercadoE = '"~fbn('Mercado')~"' ")
    SQL.ADD("and MercadoM = '"~fbn('Mercado2')~"' ")
    Recorrer Sql
      DFA
      SCN(t:23, 1)
      ACT(t:24, FBN['Codigo'])
    Proximo
    if Val(t:23)=0
      * No existe en EspeciesMeracdo
      ACN(z:1, 1)
    endif
    
    ACD(t:25, fbn('FechaOp'))
    ACN(t:26, fbn('Plazo'))

    * Instrumento
    ACT(t:2, Val(t:24)~'/'~FStr(Val(t:26),1,0)~'hs')
    * Precio
    ACN(t:3, fbn('Precio1'))
    * Cantidad
    ACN(t:4, fbn('Cantidad'))
    * TipoLiq
    ACT(t:5, '2')
    * CuentaVenta
    ACT(t:6, fbn('Cuenta1'))
    * CuentaCompra
    ACT(t:7, fbn('Cuenta4'))
    * Usuario
    ACT(t:10, fbn('Operador'))
    ACT(t:27, SQL("SELECT NrRofex FROM "~DBO~".Clientes WHERE Codigo  = '"~FBN['Cliente1']~"' "))
    if Vacio(Val(t:27))
      ACT(t:28, 'TER')
    else
      ACN(z:1, 1)
      ACT(t:28, 'AG')
    endif

    ACN(t:16, Val(z:1))
    if Val(z:1)=0
      ACT(b:FAC, 'OK')
**      MessageBox('Operacion '~fbn['NrOperacion']~' OK')  
      if Dialogo.Check1=1
        ** Generar A3REGISTRACIONES
        SQL.ADD("Insert into "~DBO~".A3REGISTRACIONES (")
          
        SQL.ADD("NrOperacion, ")
        SQL.ADD("Instrumento, ")
        SQL.ADD("Precio, ")
        SQL.ADD("Cantidad, ")

        SQL.ADD("TipoLiq, ")
        SQL.ADD("CuentaVenta, ")
        SQL.ADD("CuentaCompra, ")
        SQL.ADD("FechaModificacion ")
      
        SQL.ADD(") values (")
          
        * NrOperacion
        SQL.ADD(" '"~Val(t:1)~"', ")
        * Instrumento
        SQL.ADD(" '"~Val(t:2)~"', ")
        * Precio
        SQL.ADD(" '"~FStr(Val(t:3),1,8)~"', ")
        * Cantidad
        SQL.ADD(" '"~FStr(Val(t:4),1,0)~"', ")

        * TipoLiq
        SQL.ADD(" '"~Val(t:5)~"', ")
        * CuentaVenta
        SQL.ADD(" '"~Val(t:6)~"', ")
        * CuentaCompra
        SQL.ADD(" '"~Val(t:7)~"', ")
        * FechaModificacion
        SQL.ADD(" "~SQLAhora~" ")

        SQL.ADD(")")
        SQL.NEW

        SQL.EXEC
        ** Mover Operacion
        if EqStr(Val(t:28),'AG')
          * Agente MAE (Cliente1 con NrRofex)
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=0, Entero1=60, Entero2=62)
        else
          * Tercero
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=0, Entero1=60, Entero2=71)
          * asignar nro. de boleto automaticamente
          EJECUTAREVENTO('ASIBOL',Radio1=1,NrOperacion1=FBN['NrOperacion'])
        endif
      endif
    else
**      MessageBox('Operacion '~fbn['NrOperacion']~' Error')  
      ACT(b:FAC, 'Error')
    endif
    if Dialogo.Check1=0
      ACT((78+FAC):1,  Val(t:1))
      ACT((78+FAC):2,  Val(t:2))
      ACN((78+FAC):3,  Val(t:3))
      ACN((78+FAC):4,  Val(t:4))
      ACT((78+FAC):5,  Val(t:5))
      ACT((78+FAC):6,  Val(t:6))
      ACT((78+FAC):7,  Val(t:7))
      ACT((78+FAC):8,  Val(t:8))
      ACT((78+FAC):9,  Val(t:9))
      ACT((78+FAC):10, Val(t:10))
      ACT((78+FAC):11, Val(t:11))
      ACT((78+FAC):12, Val(t:12))
      ACT((78+FAC):13, Val(t:13))
      ACT((78+FAC):14, Val(t:14))
      ACT((78+FAC):15, Val(t:15))
      ACN((78+FAC):16, Val(t:16))
      ACT((78+FAC):17, Val(t:17))
      ACT((78+FAC):18, Val(t:18))
      ACT((78+FAC):19, Val(t:19))
      ACT((78+FAC):20, Val(t:20))
      ACT((78+FAC):21, Val(t:21))
      ACT((78+FAC):22, Val(t:22))
      ACN((78+FAC):23, Val(t:23))
      ACT((78+FAC):24, Val(t:24))
      ACD((78+FAC):25, Val(t:25))
      ACN((78+FAC):26, Val(t:26))
      ACT((78+FAC):27, Val(t:27))
      ACT((78+FAC):28, Val(t:28))
      ACO((78+FAC),12)
    endif
  else
    * Error en Tipo de Operacion
    if Dialogo.Check1=0
      MessageBox('Operacion '~fbn['NrOperacion']~' Not OK (TipoOp)')  
    endif
  endif
Proximo

if Dialogo.Check1=0 y FAC>0
  FormatoCeldas(t:3..t:3,Exe('F8'))
  FormatoCeldas(t:4..t:4,Exe('F2'))
  FormatoCeldas(t:16..t:16,Exe('F0'))
  FormatoCeldas(t:23..t:23,Exe('F0'))
  FormatoCeldas(t:26..t:26,Exe('F0'))

  FormatoCeldas(ca:3..(78+FAC):3,Exe('F8'))
  FormatoCeldas(ca:4..(78+FAC):4,Exe('F2'))
  FormatoCeldas(ca:16..(78+FAC):16,Exe('F0'))
  FormatoCeldas(ca:23..(78+FAC):23,Exe('F0'))
  FormatoCeldas(ca:26..(78+FAC):26,Exe('F0'))
  ACO(1, 12)
  ACO(19,15)
  ACO(20,12)
  ACO(78,15)
endif
  