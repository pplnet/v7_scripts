CrearDialogo
  NrOrden1    : 'Orden'         ;;;;;;NoVacio(Dialogo.NrOrden1);'Debe Ingresar una Orden';NO;;;;;;" FechaOrden >= "~IdxDate2(Habiles(Fsys,-Var('FVALORORD')))~" and TipoOrden Like 'OTI%' and NrOrden in (Select NrOperacion from OPERACIONESBITS where NrOperacion = NrOrden and Valor = '1'  and NrBit in (9,11)) "
  Entero1     : 'Monto desde'   ;2;1;;;;;;;;;;;'#############.##'
  Entero2     : 'Monto hasta'   ;;1;;;;[Dialogo.Entero1 = 0 y Dialogo.Entero2=0] o Dialogo.Entero2 > 0;'hasta Invalido';NO;;;;;'#############.##'
  Entero3     : 'Nr Secuencia'  ; ;1;;;;;;;;;;;'#####'
  Check1      : 'Procesa'       ; ; ;;NO;NO;;;;1;    
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

 SQL.ADD("Select OB.Nrbit, O.* from "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
 SQL.ADD(" where NrOrden     = '"~Dialogo.NrOrden1~"' ")
 SQL.ADD("   and NrOrden     = OB.NrOperacion ")
 SQL.ADD("   and Valor       = '1' ")
 SQL.ADD("   and FechaOrden >= "~IdxDate2(Habiles(Fsys,-Var('FVALORORD')))~" ")
 SQL.ADD("   and TipoOrden Like 'OTI%' ")
 SQL.ADD("   and NrOrden in (Select NrOperacion from OPERACIONESBITS where NrOperacion = NrOrden and Valor = '1'  and NrBit in (9,11)) ")
 watch(sql.batch())
 ACN(xy1,0)
 recorrer SQL

    ACT(t:1, fbn('NrOperacion2'))
    ** Verifica si Operacion Val(C1) esta liquidada
    ACN(xy2,SQL("select top 1 1 from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Val(c:1)~"' "))
    If Val(xy2) = 1
       Cancelar('La orden no puede anularse porque la operación '~Val(c:1)~' asociada a la orden seleccionada se encuentra liquidada')
    Endif
    dfa
    SQL.ADD("Select * from "~DBO~".EJECUCIONES E")
    SQL.ADD(" where NrOrden     = '"~fbn('NrOrden')~"' ")
    SQL.ADD("   and fecha2 is null")
    if Dialogo.Entero3 <> 0
       SQL.ADD("   and NrSecuencia = "~Dialogo.Entero3~" ")
    Else
       If Dialogo.Entero2 > 0
          SQL.ADD("   and Cantidad Between "~Dialogo.Entero1~" and "~Dialogo.Entero2~" ")
       Endif
    Endif
    SQL.ADD(" Order By NrEjecucion ")
    watch(sql.batch())
    recorrer SQL
       ACN(x:fac,0)
       ACT(a:fac, fbn('NrOrden'))
       ACT(b:fac, fbn('NrEjecucion'))
       ACT(c:fac, fecha(fbn('Fecha')))
       ACT(d:fac, Hora(fbn('Fecha')))
       ACT(e:fac, fbn('NrSecuencia'))
       ACN(f:fac, fbn('Cantidad'))
       ACN(g:fac, fbn('Precio'))
       ACN(h:fac, fbn('Cantidad2'))
       ACN(a:0,fac)
    proximo
    ACT(t:2, fbn('NrOrden'))
    ACT(t:3, fbn('TipoOrden'))
    ACD(t:4, fbn('FechaOrden'))
    ACD(t:5, fbn('FechaVto'))
    ACT(t:6, fbn('CantidadToTalOrden'))
    ACT(t:7, fbn('Cantidad1'))
    ACT(t:8, fbn('Especie'))
    ACT(t:9, fbn('Mercado2'))
    ACT(t:10, fbn('Leyenda3'))
    ACN(t:11, fbn('MB2'))
    ACT(t:12, fbn('AfectaLs'))        
    ACT(t:13, fbn('Cuenta4'))
    ACN(t:14, fbn('TotalAux1'))
    ACN(t:15, fbn('NrBit'))
    ACN(t:16, SQL("select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Val(t:1)~"' and Valor = '1' "))
    ACT(t:20, 'OK')
    SCN(xy1,1)
  proximo

IF Val(xy1)=0
   Cancelar('La Orden no se encuentra con los filtros utilizados o no esta en instancia válida para anulación: Ejecutada o Anulada con Ejecuciones. o Fecha valor máxima superada.')
Endif

if EqStr(Val(t:20),'OK')
     Message('Anulacion de Ejecuciones')
     CrearListBox;'Arial,8,';'Anulacion de Ejecuiones Orden '~Val(t:2)
          'Anula'         ;x:1..x:Val(a:0);SI;;; 50;CHECK ;;
          *'NrOrden'       ;a:1..a:Val(a:0);NO;;; 60;STRING;
          'Nr Ejec'       ;b:1..b:Val(a:0);NO;;; 60;STRING;
          'Fecha'         ;c:1..c:Val(a:0);NO;;;100;STRING;
          'Hora'          ;d:1..d:Val(a:0);NO;;;100;STRING;
          'NrSecuencia'   ;e:1..e:Val(a:0);NO;;;100;STRING;
          'Cantidad'      ;f:1..f:Val(a:0);NO;;; 80;NUMERO;'###,###,###,###.##';
          'Precio'        ;g:1..g:Val(a:0);NO;;; 80;NUMERO;'###,###,###,###.##';
          'Monto'         ;h:1..h:Val(a:0);NO;;; 80;NUMERO;'###,###,###,###.##';
     FinListBox
  
     If Not Ok
       Cancelar
     Endif
   
  if Dialogo.Check1=1
  
    Recorrer&i 1,Val(a:0)
      If Val(x:&i)=1
         SQL.ADD(" Update "~DBO~".EJECUCIONES Set ")
         SQL.ADD("  Fecha2    = "~IdxDate2(Fsys)~" ")
         SQL.ADD(" Where NrOrden = '"~Val(t:2)~"' ")
         SQL.ADD("   and NrEjecucion = '"~Val(b:&i)~"' ")
         SQL.NEW 
         ** Actualizar Instancias actuales en Ordenes y Operaciones
         SQL.ADD("Update "~DBO~".ORDENES Set LInstancia = "~FStr(Val(t:15),0,0)~" where NrOrden = '"~Val(t2)~"' ")
         SQL.NEW
         SQL.ADD("Update "~DBO~".OPERACIONES Set LInstancia = "~FStr(Val(t:16),0,0)~" where NrOperacion = '"~Val(t1)~"' ")
         SQL.NEW
         SQL.EXEC 
         
         EjecutarEvento('CBOINS', String1=Val(t:2), Radio1=1, Radio2=0, Entero1=Val(t:15), Entero2=33)
         EjecutarEvento('CBOINS', String1=Val(t:1), Radio1=1, Radio2=0, Entero1=Val(t:16), Entero2=33)
         
      Endif
    Proximo
  endif  
endif
