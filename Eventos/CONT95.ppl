MostrarCuadroDeMensajes
CrearDialogo
   NrUnicoAsiento1: 'Asiento'   ; ;;;  ;;NOVACIO(Dialogo.NrUnicoAsiento1) ;'Asiento Invalido' ;  ;
   Fecha1         : 'F.Valor' ;2;;;no;;;;NO;;iif(Vacio(Dialogo.NrUnicoAsiento1),FSYS,BuscarCampo('ASIENTOSCON','FechaValor','NrUnicoAsiento',Dialogo.NrUnicoAsiento1) )
   Radio1         : 'Envia Asientos|Puntual|Todos';;;;;;;;;;0 
FinDialogo

If Not Ok
  Cancelar
Endif
ACN (B:1,0)

if Dialogo.Radio1=0
  ACN(BD:1, 1)
  SQL.ADD(" Select  FechaGeneracion, FechaValor,NrUnicoAsiento,NrOperacion, Fecha2, Estado  ")
  SQL.ADD(" From  "~DBO~".ASIENTOSCON ")
  SQL.ADD(" Where NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
  SQL.ADD(" AND (Estado = NULL OR Estado = '' OR Estado = ' ' OR Estado = 'COT' OR Estado = 'NC' OR Estado = 'REV') ")
  SQL.ADD(" order by NrUnicoAsiento ")
  Recorrer SQL
    ACN(BD:1, 0)
    If Eqstr(fbn('Estado'), 'COT')
      ACT(A:FAC, 'COE')
    Else
      If Eqstr(fbn('Estado'), 'NC')
        ACT(A:FAC, 'NCE')
      Else
        If Eqstr(fbn('Estado'), 'REV')
          ACT(A:FAC, 'REE')
        ELSE
          ACT(A:FAC, 'E')
        ENDIF
      ENDIF
    ENDIF
***---Marco el asiento
    MessageBox ('Operacion '~fbn('NrOperacion')~' ESTADO '~Val(A:fAC))
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")  
    SQL.ADD(" Set Estado = '"~Val(A:fAC)~"' ") 
    SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    SQL.NEW
    SQL.EXEC
  Proximo
  IF Val(BD:1) = 0
    MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' esta disponible para Re-envio ')
  ELSE
    MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' no corresponde A ESTE PROCESO')
  ENDIF
ENDIF

if Dialogo.Radio1=1
  ACN(BD:1, 1)
  SQL.ADD(" Select  FechaGeneracion, FechaValor,NrUnicoAsiento,NrOperacion, Fecha2, Estado  ")
  SQL.ADD(" From  "~DBO~".ASIENTOSCON ")
  SQL.ADD(" Where  ")
  SQL.ADD("  (Estado = NULL OR Estado = '' OR Estado = ' ' OR Estado = 'COT' OR Estado = 'NC' OR Estado = 'REV') ")
  SQL.ADD(" order by NrUnicoAsiento ")
  Recorrer SQL
    ACN(BD:1, 0)
    If Eqstr(fbn('Estado'), 'COT')
      ACT(A:FAC, 'COE')
    Else
      If Eqstr(fbn('Estado'), 'NC')
        ACT(A:FAC, 'NCE')
      Else
        If Eqstr(fbn('Estado'), 'REV')
          ACT(A:FAC, 'REE')
        ELSE
          ACT(A:FAC, 'E')
        ENDIF
      ENDIF
    ENDIF
***---Marco el asiento
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")  
    SQL.ADD(" Set Estado = '"~Val(A:fAC)~"' ")    
 
    SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    SQL.NEW
    SQL.EXEC
    SCN (B:1,1)
  Proximo
  IF Val(BD:1) = 0
    MessageBox('SE MODIFICARON  '~Val(B:1)~' ASIENTOS')
  ELSE
    MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' no corresponde A ESTE PROCESO')
  ENDIF
Endif