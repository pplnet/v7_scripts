*Modoreproceso(ConDialogo)
*MostrarCuadroDeMensajes
** FJL 28/06/18 - Por tasa Variable
CrearDialogo
   Especie1   :'Especie'        ; 1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y NOT DesciendeDeEspecie(Dialogo.Especie1,'CUPON');'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' "
   Fecha4     :'F.Actualiz'     ; 1;2;;;;Dialogo.Fecha4>0;'La fecha de actualizacion ingresada no es valida';NO;FSys;
   Fecha1     :'F.Corte'        ; 2;1;;;;Dialogo.Fecha1>0;'La fecha ingresada no es valida';NO;Fsys;SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ");
   Fecha6     :'F.Pago'         ; 2;2;;NO;SI;Dialogo.Fecha6>0;'La fecha ingresada no es valida';NO;Fsys;SQL(" Select FechaPago From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ");
   Entero1    :'Nr.Cupon'       ; 3;1;;  ;  ;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1);BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
   Check1     :'Procesa'        ; 5;1;;SI;SI;;;;0;
FinDialogo
If Not OK
   Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

Message('Calculo TNA '~Dialogo.Especie1)

ACT(a:1, 'Especie')
ACT(a:2, 'Cupon')
ACT(a:3, 'TipoTasa')
ACT(a:4, 'Tasa')
ACT(a:5, 'Spread')
ACT(a:6, 'Dias Prom')
ACT(a:7, 'Dias atras')
ACT(a:8, 'Tasa al Vto')
ACT(a:9, 'Mon.Emision')
ACT(a:10, 'DevengaTasa')
ACT(a:11, 'Tasa Maxima')
ACT(a:12, 'Tasa Minima')
ACT(a:13, 'Fecha Base')
ACT(a:14, 'Corte a Corte')
ACT(a:15, 'Fecha Desde')
ACT(a:16, 'Fecha Hasta')
ACT(a:17, 'Dias')

ACT(d:1, 'Error')
ACT(f:1, 'Fecha')
ACT(g:1, 'Tasa')

ACT(h:1, 'Fecha Inicial')
ACT(h:2, 'Suma tasas')
ACT(h:3, 'Tasa Promedio')
ACT(h:4, 'Tasa Ajustada')
ACT(h:5, 'Tasa final')

ACT(j:1, 'FPago Orig')
ACT(j:2, 'FPago Orig Ant')
ACT(j:3, 'Plazo')
ACT(j:4, 'Base')
ACT(j:5, 'Indice')
ACT(j:6, '% Renta')

ACT(l:1, 'Espcie')
ACT(l:2, 'F4 - Actua.')
ACT(l:3, 'F1 - Corte')
ACT(l:4, 'F6 - Pago')
ACT(l:5, 'Cupon')
ACT(l:6, 'Procesa')
SetFont(a:1..l:17, 2)

ACT(m:1, Dialogo.Especie1)
ACD(m:2, Dialogo.Fecha4)
ACD(m:3, Dialogo.Fecha1)
ACD(m:4, Dialogo.Fecha6)
ACN(m:5, Dialogo.Entero1)
ACN(m:6, Dialogo.Check1)

SQL.ADD("SELECT * FROM "~DBO~".ESPECIES WHERE Codigo = '"~Dialogo.Especie1~"'")
Recorrer SQL
  ACT(b:1, fbn('Codigo'))  
  ACN(b:2, fbn('Cupon'))  
  ACT(b:3, fbn('TasaCER'))  
  ACT(b:4, fbn('TiposTasas'))
  ACN(b:5, fbn('Spread'))  
  ACN(b:6, fbn('DiasProm'))
  ACN(b:7, fbn('Diasatras'))
  ACT(b:8, fbn('TasaAlVto'))
  ACT(b:9, fbn('MonedaEmision'))
  ACT(b:10, fbn('DevengaTasa'))
  ACN(b:11, fbn('TasaMax'))  
  ACN(b:12, fbn('TasaMin'))  
  ACT(b:14, fbn('Alias7'))  
proximo
**COR-PAG-PAO
if EqStr(Val(b:10),'COR')
  ACT(b:13, 'F.Corte')
else
  if EqStr(Val(b:10),'PAG')
    ACT(b:13, 'F.Pago')
  else
    * FechaPagoOriginal es el default
    ACT(b:13, 'F.Pago Orig')
  endif
endif

ACN(e:1, 0)
if Not EqStr(Val(b:3),'FLO')
  ACN(e:1, 1)
  if Dialogo.Check1=1
    Cancelar('la especie '~Val(b:1)~' no es de tasa variable')
  else
    MessageBox('la especie '~Val(b:1)~' no es de tasa variable')
  endif
endif
if Vacio(Val(b:4))
  ACN(e:1, 1)
  if Dialogo.Check1=1
    Cancelar('La especie '~Val(b:1)~' no tiene cargado el tipo tasa.')
  else
    MessageBox('La especie '~Val(b:1)~' no tiene cargado el tipo tasa.')
  endif
endif
if Val(b:6)<1
  ACN(b:6, 1)
  ACT(c:6, 'Forzado')
endif
if Val(b:7)<1
  ACN(b:7, 0)
  ACT(c:7, 'Forzado')
endif

if Val(e:1)=0
  ** Fecha
  if EqStr(Val(b:10),'COR')
    ACD(k:1, SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' "))
  else
    if EqStr(Val(b:10),'PAG')
      ACD(k:1, SQL(" Select FechaPago From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' "))
    else
      ACD(k:1, SQL(" Select FechaPagoOriginal From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' "))
    endif
  endif
  ** Fecha Anterior
  if Dialogo.Entero1=1
    ACD(k:2, Buscarcampo('ESPECIES','FEmision','Codigo',Dialogo.Especie1))
  else
    if EqStr(Val(b:10),'COR')
      ACD(k:2, SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1-1, 0, 0)~"' "))
    else
      if EqStr(Val(b:10),'PAG')
        ACD(k:2, SQL(" Select FechaPago From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1-1, 0, 0)~"' "))
      else
        ACD(k:2, SQL(" Select FechaPagoOriginal From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1-1, 0, 0)~"' "))
      endif
    endif
  endif
  ** Plazo
  ACN(k:3, Val(k:1)-Val(k:2))
  ** Base
  if EqStr(BuscarCampo('ESPECIES','DiasAnio','Codigo',Dialogo.Especie1),'REA')
    ACN(k:4 , DiasA(2,Dialogo.Fecha1))
  else
    if EqStr(BuscarCampo('ESPECIES','DiasAnio','Codigo',Dialogo.Especie1),'360')
      ACN(k:4, 360)
    else
      ACN(k:4, 365)
    endif
  endif
  ** Indice de conversion TNA a % Renta
  ACN(k:5, Val(k:3)/(Val(k:4))) 

** FJL 06/03/20 - Nueva opcion calculo tasa. De Corte a Corte
  if EqStr(Val(b:14),'SI')
    if Dialogo.Entero1=1
      ACD(b:15, Buscarcampo('ESPECIES','FEmision','Codigo',Dialogo.Especie1))
    else
      ACD(b:15, SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1-1, 0, 0)~"' "))
    endif 
    ACD(b:16, SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' "))
    if Val(b:7)>0
      ACD(c:15, Val(b:15))
      ACD(b:15, Habiles(Val(c:15),-Val(b:7),'ARG',SI))
      ACD(c:16, Val(b:16))
      ACD(b:16, Habiles(Val(c:16),-Val(b:7),'ARG',SI))
    endif
    ACN(b:17, DifDias(Val(b:15),Val(b:16),'ARG',SI))
    ACD(i:1, Val(b:15))
    ACN(b:6, Val(b:17))
  else
    if EqStr(Val(b:8),'SI')
      * Desde fecha Cupon actual
      ACD(i:1, Habiles(Val(k:1),-(Val(b:7)+Val(b:6)-1),'ARG',SI))
    else
      * Desde fecha Cupon anterior / Inicio periodo de intereses
      ACD(i:1, Habiles(Val(k:2),-(Val(b:7)+Val(b:6)-1),'ARG',SI))
    endif
  endif
  
  recorrer&i 0,Val(b:6)-1 
    ACD(f:&i+2, Habiles(Val(i:1),&i,'ARG',SI))
    ACN(g:&i+2, TasaDia(Val(b:4),Val(b:9),Val(f:&i+2),1,1))
    SCN(i:2, Val(g:&i+2))
  proximo
  ACN(i:3, Val(i:2)/Val(b:6))
  ACN(i:4, Val(i:3)+Val(b:5))
  ACN(i:5, Val(i:4))
  if Val(b:11)>0
    * Existe Tasa Maxima
    if Val(i:5)>Val(b:11)
      ACN(i:5, Val(b:11))
      ACT(i:6, 'Forzada x Maxima')
    endif
  endif
  if Val(i:5)<Val(b:12)
    ACN(i:5, Val(b:12))
    ACT(i:6, 'Forzada x Minima')
  endif

  ACN(k:6, Val(i:4)*Val(k:5)) 
endif

if Dialogo.Check1=1
  Message('Actualizando TNA en Agenda de Cupones ')
  SQL.ADD("UPDATE "~DBO~".AGENDACUPONES ")
  SQL.ADD("   Set TNA = "~FSTR(Val(i:5),1,9)~", ")
  SQL.ADD("       PorRenta = "~FSTR(Val(k:6),1,9)~" ")
  SQL.ADD(" WHERE Especie = '"~Dialogo.Especie1~"' ")
  SQL.ADD("  AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
  SQL.NEW
  SQL.EXEC
else
  MessageBox('Actualizando TNA en Agenda de Cupones')
endif

FormatoCeldas(k:3..k:4,Exe('F0'))
FormatoCeldas(k:5..k:6,Exe('F8'))
ACO(1, 10)
ACO(8, 10)
ACO(10, 10)
ACO(12, 10)

