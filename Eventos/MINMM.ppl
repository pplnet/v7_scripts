CrearDialogo
  Fecha1:       'Fecha OP.'  ;;;;;;;;;Fsys
  NrOperacion1: 'Nro_de_Operacion';;;;;;Vacio(Dialogo.NrOperacion1) o Incluido(SQL("Select TipoOp from  "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"'"), "MMCO|MMCT|TICO|TICT");'La operacion debe ser un Call';NO;;;;;;"TipoOp in ('TICO', 'TICT', 'MMCO', 'MMCT')"
  Especie1:     'Moneda';;;;;;;;;;;;;iif(Eqstr(Copy(Dialogo.NrOperacion1,1,1),'M'),LeerObjeto('Monedas'),'TITULO')
  Cliente1:     'Cliente'
  Vehiculo1:    'Vehiculo'
  Mercado1:     'Mercado'
  Radio2         :'|Impresora|Pantalla|PDF|Mail';;;;;;Dialogo.Radio2>=0;;;1
FinDialogo
IF NOT Ok
  Cancelar
ENDIF

IF NOVACIO(Dialogo.NrOperacion1)
   If SQL("Select 1 from  "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit IN (10,70) AND Valor = '1' ") = 1
   LinkearHoja('IMPMMM',1, NrOperacion1=Dialogo.Nroperacion1,Radio2=Dialogo.Radio2)
   Else
      MessageBox('La Operacion '~Dialogo.NrOperacion1~' aun no esta confirmada.')
   Endif
ELSE
   SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.Cantidad, O.Precio1, O.TotalBrutoCli1 ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS IOP ")
   SQL.ADD(" Where O.NrOperacion = IOP.NrOperacion ")
   SQL.ADD(" and   IOP.NrBit IN (10,70)            ")
   SQL.ADD(" AND   IOP.Valor     = '1'             ")
   SQL.ADD(" and  O.FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND O.TipoOp in ('MMCO', 'MMCT','TICO', 'TICT') ")
   IF NOVACIO(Dialogo.Especie1)
      SQL.ADD(" AND O.Especie='"~Dialogo.Especie1~"' ")
   ENDIF
   IF NOVACIO(Dialogo.Cliente1)
      SQL.ADD(" AND O.Cliente1='"~Dialogo.Cliente1~"' ")
   ENDIF
   IF NOVACIO(Dialogo.Vehiculo1)
      SQL.ADD(" AND O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   ENDIF
   IF NOVACIO(Dialogo.Mercado1)
      SQL.ADD(" AND O.Mercado1='"~Dialogo.Mercado1~"' ")
   ENDIF
   SQL.ADD(" order by O.NrOperacion ")

   acn(z1,0)
   Recorrer SQL
      SCN(z1,1)
      ACT(a:Val(z1), fbn['NrOperacion'])
      ACT(b:Val(z1), fbn['Cliente1'])
      ACT(c:Val(z1), fbn['Especie'])
      ACN(e:Val(z1), fbn['Cantidad'])
      ACN(f:Val(z1), fbn['Precio1'])
      ACN(g:Val(z1), fbn['TotalBrutoCli1'])
   proximo
   if Val(z1)=0
      Cancelar('No existen Minutas para imprimir')
   else
      ACO(1,9)
      ACO(2,9)
      ACO(3,6)
      ACO(4,6)
      ACO(5,12)
      ACO(6,12)
      ACO(7,15)
      FormatoCeldas(f1..f:Val(z1),Exe('F7'))
      AlinearCeldas(e:1..g:FAC, 'D')
      ListBox(a:1..h:Val(z1),'NrOperacion Cliente     Especie       Cantidad         Tasa             Total')
      if Ok
         ACN(XX1,0)
         recorrerSel
            LinkearHoja('IMPMMM',1, NrOperacion1=Val(a:FilaCiclo),Radio2=Dialogo.Radio2)
         proximo
      endif
   endif  
ENDIF