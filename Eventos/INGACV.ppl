ACT(a1,GetNumerador(50))

SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")

SQL.ADD("TipoTr2, ")
SQL.ADD("Cliente2, ")
SQL.ADD("Cliente1, ")
SQL.ADD("Especie, ")
SQL.ADD("Cantidad1, ")
SQL.ADD("Fecha1, ")
SQL.ADD("Fecha2, ")
SQL.ADD("RB1, ")
SQL.ADD("RB2, ")
SQL.ADD("NrTrans ")

SQL.ADD(") Values (")

SQL.ADD("'ACV', ")
SQL.ADD("'"~Dialogo.Cliente2~"', ")
SQL.ADD("'"~Dialogo.Cliente1~"', ")
SQL.ADD("'"~Dialogo.Especie1~"', ")
SQL.ADD(""~FStr(Dialogo.Cantidad1,1,2)~", ")
SQL.ADD("'"~IdxDate(Dialogo.Fecha1)~"', ")
SQL.ADD("'"~IdxDate(Dialogo.Fecha2)~"', ")
SQL.ADD("'"~Dialogo.Radio1~"', ")
SQL.ADD("'"~Dialogo.Radio2~"', ")
SQL.ADD("'"~Val(a1)~"' ")
SQL.ADD(") ")

SQL.NEW

SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
SQL.ADD("(NrBit, NrOperacion, Valor) ")
SQL.ADD("Select NrInstancia, '"~Val(a1)~"', '0'")
SQL.ADD("from "~DBO~".INSTANCIAS ")
SQL.ADD("where Tabla = 'TRANSACCIONES2'")
SQL.NEW

SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
SQL.ADD(" SET Valor = '1' ")
SQL.ADD(" Where NrBit = 50 and NrOperacion = '"~Val(a1)~"' ")
SQL.NEW

