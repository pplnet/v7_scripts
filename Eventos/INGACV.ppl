CrearDialogo
  Cliente2       : 'Empresa'        ;1;1; ;  ;  ;NoVacio(Dialogo.Cliente2) y DesciendeDeCliente(Dialogo.Cliente2,'VINCULADOS') y EsTerminal(Dialogo.Cliente2,CLIENTE) y [SQL(" Select Count(*) from "~DBO~".VEHICULOS where Codigo = '"~Dialogo.Cliente2~"' ")=0 o EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',Dialogo.Cliente2),'NOC')];'Debe ingresar una Empresa Vinculada no Controlada';NO;
  Cliente1       : 'Banco'          ; ; ; ;  ;  ;NoVacio(Dialogo.Cliente1) y DesciendeDeCliente(Dialogo.Cliente1,'BANCOS') y EsTerminal(Dialogo.Cliente1,CLIENTE);'Debe ingresar un Banco';NO;
  Especie1       : 'Especie'        ; ; ; ;  ;  ;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA') y EsTerminal(Dialogo.Especie1,ESPECIE);'Debe Ingresar una Especie Valida';NO;
  Cantidad1      : 'Cantidad'       ; ; ; ;  ;  ;Dialogo.Cantidad1>0;'La Cantidad debe ser Positiva';NO;;;;;'###,###,###.##';
  Fecha1         : 'Fecha Desde'    ; ; ; ;VerificaAcceso('OPFVALOR');  ;Dialogo.Fecha1 <= FSYS y EsHabil(Dialogo.Fecha1,'ARG');'Fecha Incorrecta';NO;FSYS;
  Fecha2         : 'Fecha Hasta'    ; ; ; ;  ;  ;Dialogo.Fecha2>Dialogo.Fecha1;'Fecha incorecta';NO;FSys+1;
  Radio1         : 'Tipo|Local|Off-Shore';;;;;  ;;;;0;
  Radio2         : 'Grupo|Gar.|C.Cred.|Prest.|F.Imp.|P.Exp.';;;;;;;;;2;
FinDialogo
if Not Ok
  Cancelar
endif

