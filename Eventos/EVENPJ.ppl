CrearDialogo
   NrOperacion1: 'NrOperacion'             ;;;;;;;;
   Entero1:      'NrInstNueva'             ;;;;;;
   Entero2:      'NrInstVieja'             ;;;;;
   Radio1:       'Accion|Avanza|Retrocede' ;;;;;;;;;;;;
FinDialogo

If not Ok
   Cancelar
EndIf

ACT(NI:1, SQL(" Select Nombre From "~DBO~".INSTANCIAS Where Tabla = 'OPERACIONES' AND NrInstancia = "~Fstr(Dialogo.Entero1, 0, 0)~" "))
ACT(NJ:1, SQL(" Select Nombre From "~DBO~".INSTANCIAS Where Tabla = 'OPERACIONES' AND NrInstancia = "~Fstr(Dialogo.Entero2, 0, 0)~" "))


IF Dialogo.Radio1 = 0
    MessageBox('La Operacion '~Dialogo.NrOperacion1~' avanzo a la instancia '~Val(NI:1))
ELSE
    MessageBox('La Operacion '~Dialogo.NrOperacion1~' retrocedio a la instancia '~Val(NI:1))
ENDIF



