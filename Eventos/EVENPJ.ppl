If MessageBox('¿Esta de acuerdo con este cambio?',1,2)=7
   SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" Set Valor = '0' ")
   SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD(" And NrBit = "~Fstr(Dialogo.Entero1,0,0)~" ")
   SQL.NEW

   SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
   SQL.ADD("Set Valor = '1' ") 
   SQL.ADD("Where NrOperacion = '"~Dialogo.NrOperacion1~"'")
   SQL.ADD(" And NrBit = "~Fstr(Dialogo.Entero2,0,0)~" ")
   SQL.NEW

   SQL.EXEC
   MessageBox('La Operacion: '~Dialogo.NrOperacion1~' permanece en la Instancia '~Val(NJ:1))
EndIf