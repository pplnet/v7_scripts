** Actualizacion Especies por PME 
CrearDialogo
  Lista1    : 'Especies'   ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")  
FinDialogo
if not Ok 
  Cancelar
endif

If Eqstr(SQL("SELECT Valor FROM "~DBO~".VARIABLES WHERE Codigo='CONTROLAPM' "),'NO')
   Cancelar('Control de PME inhabilitado')
endif   

SQL.ADD("SELECT Codigo, ISIN, Codigo2, EstadoOperativo FROM "~DBO~".ESPECIES")
SQL.ADD("  Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  Codigo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
watch(SQL.Batch)
Recorrer SQL
   ACT(xy1,'')
   If NoVacio(FBN['ISIN'])
   ACT(xy1,SQL("Select Case When SANCTION_STATUS = 'Sanctioned' then 'SI' When SANCTION_STATUS = 'Not Sanctioned' then 'NO' Else 'NE' End from "~Var("PMEPATH")~" where ISIN = '"~FBN['ISIN']~"'  "))
   Else
      ACT(xy1,SQL("Select Case When SANCTION_STATUS = 'Sanctioned' then 'SI' When SANCTION_STATUS = 'Not Sanctioned' then 'NO' Else 'NE' End from "~Var("PMEPATH")~" where BBTICKER = '"~FBN['Codigo2']~"'  "))
   Endif

   
   if NoVacio(Val(xy1))
      If Not EqStr(FBN['EstadoOperativo'],Val(xy1))
         *----------- Modifico la especie ----------------*
         SQL.ADD("UPDATE "~DBO~".ESPECIES ")
         SQL.ADD("SET EstadoOperativo    = '"~Val(xy1)~"' ")
         SQL.ADD("WHERE Codigo          = '"~FBN['Codigo']~"' ")
         SQL.NEW
         SQL.EXEC
      Endif
   Else
     If Not EqStr(FBN['EstadoOperativo'],'NE')
        *----------- Especie No esta en PME ----------------*
        SQL.ADD("UPDATE "~DBO~".ESPECIES ")
        SQL.ADD("SET EstadoOperativo    = 'NE' ")
        SQL.ADD("WHERE Codigo          = '"~FBN['Codigo']~"' ")
        SQL.NEW
        SQL.EXEC
     Endif
   Endif

Proximo

