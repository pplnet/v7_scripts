CrearDialogo
   NrOperacion1:'Op       ';;;;;;;;;;
   NrOperacion2:'Op Divide';;;;;;;;;;
   Fecha1      :'FechaOp'  ;;;;;;;;;;
   Entero1     :'Plazo'    ;;;;;;;
   Cantidad1 : 'Cantidad'  ;;;;;;;;;
FinDialogo

If Not OK
   Cancelar
EndIf

***Campos a Calcular
**FechaVto
ACD(FE:1,Habiles(Dialogo.Fecha1,Dialogo.Entero1,'ARG',SI))

**Precio y TotalMoneda
SQL.ADD(" Select Especie, ContraEspecie,Vehiculo1,Vehiculo2 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"'  ")
Recorrer SQL
   ACT(ES:1,FBN('Especie'))
   ACT(CS:1,FBN('ContraEspecie'))
   ACT(VE:1,FBN('Vehiculo1'))
   ACT(VE:2,FBN('Vehiculo2'))
Proximo

**Precio1
ACN(PE:1, CotizacionC(VAl(ES:1), 'CON',,,Dialogo.Fecha1,1,SI,VAL(CS:1)))
***TotalBrutoCli1
ACN(TB:1,Val(PE:1)*Dialogo.Cantidad1)
**
ACD(DI:1,FSYS)

* A2: Numerador
ACN(A2,BuscarCampo('VEHICULOS','Alias1','Codigo',Val(VE:1)) )
ACT(A1,GetNumerador(VAL(A2)) )


**GENERO OPERACION
SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
SQL.ADD(" (Book1,Book2,Especie,TipoOp,NrOperacion,Cantidad,Precio6, ")
SQL.ADD(" Precio1,Spread,Precio2,InteresesCorr,PrecioEj,TipoCambio,PrecioMer,TasaPrecan, ")
SQL.ADD(" Precio3,Precio4,TipoCambio2,TipoCambio3,Mercado,Cliente1,")
SQL.ADD(" Cliente2,Cliente3,Operador, ")
SQL.ADD(" ContraEspecie,ContraEspecie2,TipoDoc,Cliente4,Cliente5,ConceptoEmp,FechaOp,FechaVto, ")
SQL.ADD(" FechaEj,FechaPrecan,FechaPago,Plazo,Lotes,OperacionRef,NrOperacion2,")
SQL.ADD(" TotalBrutoCli1,TotalBrutoCli2,TotalBrutoCli3,TotalComisiones,TotalGastos,TotalDerechos,")
SQL.ADD(" TotalRetenciones,TotalImpuestos,TotalNetoCli1,TotalNetoCli2,TotalNetoCli3,TotalIntereses,")
SQL.ADD(" TipoOpcion,Custodia,DiasMes,DiasAnio,EsMultioperacion,RB1,RB2,RB3,RB4,MB1,MB2,MB3,MB4, ")
SQL.ADD(" MB5,MB6,Observaciones,MensajeChequeo,ObservacDoc,UsrInput,FechaCarga,Observac2,Observac3,")
SQL.ADD(" Numerador,biReales,biStrings,biFechas,biIntegers,biTotales,GrupoOp,Direccion,LInstancia,")
SQL.ADD(" Impresa,FechaCargaSys,NrOrden,CodComitente,Cuotas1,Cuotas2,FormaLiquidacion1,FormaLiquidacion2,")
SQL.ADD(" FormaLiquidacion3,FormaLiquidacion4,Mercado2,NrBoleto,FechaUltCupon,TasaInteresesCupon,")
SQL.ADD(" Corredor,Comision,PaseCB,SistAmortizacion,TablaFeriados1,TablaFeriados2,FechaOp2,FechaVto2,")
SQL.ADD(" PlazoEnHoras,Plazo2,Plazo3,Plazo4,TotalAux1,TotalAux2,TotalAux3,TotalAux4,TasaBase,Cotizacion1,")
SQL.ADD(" PlazoGracia,TipoGracia,TotalIVA,TotalGanancias,RB5,RB6,RB7,RB8,RB9,RB10,CB5,CB6,CB7,CB8,")
SQL.ADD(" CB9,CB10,PorAforo,EsAforado,Vehiculo1,Vehiculo2,")
SQL.ADD(" Sector1,Sector2,Centro1,Centro2,CB1, CB3, NrOperacion4, ")
SQL.ADD(" RuedaContinua,CantImpresiones1,CantImpresiones2,CantImpresiones3,Cartera,ConceptoBCRA,Plaza1,")
SQL.ADD(" Plaza2,Mercado3,Mercado4,IntDevengados1,IntDevengados2,TasaVar,TipoTasa,TasaEspecie,DeltaTasa,")
SQL.ADD(" OpPrecancelar,OpRenovar,PeriodoInts,PlazoRenovPredeter,Cuenta1,Cuenta2,Cuenta3,ModoCotiza,")
SQL.ADD(" SectorRB,ValorRB1,ValorRB2,MercadoRB,Cotizacion2,Puesto,Arbitraje,Rojo,Color,Cupon1,Cupon2,")
SQL.ADD(" ContraEspecie3,ContraEspecie4,ContraEspecie5,Corredor2,PorComMer1,PorComMer2,PorComCor1,")
SQL.ADD(" PorComCor2,ImpComMer1,ImpComMer2,ImpComCor1,ImpComCor2,ImpComMerEq1,ImpComMerEq2,ImpComCorEq1,")
SQL.ADD(" ImpComCorEq2,TCComCor1,TCComCor2,TCComMer1,TCComMer2,ImpGastos1,ImpGastos2,PrecioRef,UMedida,")
SQL.ADD(" TipoTasa2,PrecioRef2,PrecioRef3,PrecioRef4,TipoTasa3,FechaEx1,FechaEx2,FechaEx3,FechaEx4,TipoOp2,Observac4,Contrato,Pais,TasaImp1,ImporteImp,CuentaContable1,")
SQL.ADD(" CuentaContable2,Cuenta4,Cuenta5,RB11,")
SQL.ADD(" Indice,Coeficiente,CantidadOri,ResultadoIndice,CB13,NrOperacion5,CB14,RB14,RB12 ) ")

SQL.ADD(" SELECT Book1,Book2,Especie, TipoOp,'"~VAL(A:1)~"' As NrOperacion,"~Dialogo.Cantidad1~" as Cantidad,Precio6, ")
SQL.ADD(" "~VAL(PE:1)~" as Precio1,Spread,Precio2,InteresesCorr,"~Dialogo.Cantidad1~" as PrecioEj,TipoCambio,PrecioMer,TasaPrecan, ")
SQL.ADD(" Precio3,Precio4,TipoCambio2,TipoCambio3,Mercado, Cliente1,")
SQL.ADD(" Cliente2,Cliente3, '"~USUARIOACTIVO~"' as  Operador, ")
SQL.ADD(" ContraEspecie,ContraEspecie2,TipoDoc,Cliente4,Cliente5,ConceptoEmp,'"~IdxDate(Dialogo.Fecha1)~"'as FechaOp,'"~IdxDate(VAL(FE:1))~"' as FechaVto, ")
SQL.ADD(" FechaEj,FechaPrecan,FechaPago,'"~Dialogo.Entero1~"' as Plazo,Lotes,OperacionRef,NrOperacion2, ")
SQL.ADD("  "~VAL(TB:1)~" as TotalBrutoCli1,TotalBrutoCli2,TotalBrutoCli3,TotalComisiones,TotalGastos,TotalDerechos,")
SQL.ADD(" TotalRetenciones,TotalImpuestos,TotalNetoCli1,TotalNetoCli2,TotalNetoCli3,TotalIntereses,")
SQL.ADD(" TipoOpcion,Custodia,DiasMes,DiasAnio,EsMultioperacion,RB1,RB2,RB3,RB4,MB1,MB2,MB3,MB4, ")
SQL.ADD(" MB5,MB6,Observaciones,MensajeChequeo,ObservacDoc,'"~USUARIOACTIVO~"' as UsrInput,"~SQLAhora~" as FechaCarga,Observac2,Observac3,")
SQL.ADD(" Numerador,biReales,biStrings,biFechas,biIntegers,biTotales,GrupoOp,Direccion,LInstancia,")
SQL.ADD(" Impresa,'"~IdxDate(VAL(DI:1))~"' as FechaCargaSys,NrOrden,CodComitente,1 as Cuotas1,Cuotas2,FormaLiquidacion1,FormaLiquidacion2,")
SQL.ADD(" FormaLiquidacion3,FormaLiquidacion4,Mercado2,NrBoleto,FechaUltCupon,TasaInteresesCupon,")
SQL.ADD(" Corredor,Comision,PaseCB,SistAmortizacion,TablaFeriados1,TablaFeriados2, '"~IdxDate(Dialogo.Fecha1)~"'as FechaOp2,FechaVto2,")
SQL.ADD(" PlazoEnHoras,Plazo2,Plazo3,Plazo4,TotalAux1,TotalAux2,TotalAux3,TotalAux4,TasaBase,Cotizacion1,")
SQL.ADD(" PlazoGracia,TipoGracia,TotalIVA,TotalGanancias,RB5,RB6,RB7,RB8,RB9,RB10,CB5,CB6,CB7,CB8,")
SQL.ADD(" CB9,CB10,PorAforo,EsAforado,Vehiculo1,Vehiculo2,")
SQL.ADD(" Sector1,Sector2,Centro1,Centro2, '1', CB3, NrOperacion4, ")
SQL.ADD(" RuedaContinua,CantImpresiones1,CantImpresiones2,CantImpresiones3,Cartera,ConceptoBCRA,Plaza1,")
SQL.ADD(" Plaza2,Mercado3,Mercado4,IntDevengados1,IntDevengados2,TasaVar,TipoTasa,TasaEspecie,DeltaTasa,")
SQL.ADD(" OpPrecancelar,OpRenovar,PeriodoInts,PlazoRenovPredeter,Cuenta1,Cuenta2,Cuenta3,ModoCotiza,")
SQL.ADD(" SectorRB,ValorRB1,ValorRB2,MercadoRB,Cotizacion2,Puesto,Arbitraje,Rojo,Color,Cupon1,Cupon2,")
SQL.ADD(" ContraEspecie3,ContraEspecie4,ContraEspecie5,Corredor2,PorComMer1,PorComMer2,PorComCor1,")
SQL.ADD(" PorComCor2,ImpComMer1,ImpComMer2,ImpComCor1,ImpComCor2,ImpComMerEq1,ImpComMerEq2,ImpComCorEq1,")
SQL.ADD(" ImpComCorEq2,TCComCor1,TCComCor2,TCComMer1,TCComMer2,ImpGastos1,ImpGastos2,PrecioRef,UMedida,")
SQL.ADD(" TipoTasa2,PrecioRef2,PrecioRef3,PrecioRef4,TipoTasa3,FechaEx1,FechaEx2,FechaEx3,FechaEx4,TipoOp2,")
SQL.ADD(" Observac4,Contrato,Pais,0 as TasaImp1,ImporteImp,CuentaContable1,CuentaContable2,Cuenta4,Cuenta5,RB11,")
SQL.ADD(" Indice,Coeficiente,CantidadOri,ResultadoIndice,CB13,'"~Dialogo.NrOperacion2~"' as NrOperacion5,CB14,RB14,1 as RB12 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

**CUOTAS
SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
SQL.ADD(" (NrOperacion,NrCuota,Cliente1,Cliente2,")
SQL.ADD("  Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
SQL.ADD("  Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
SQL.ADD("  Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,Fecha1,Fecha2,Fecha3,Fecha4,Fecha5,")
SQL.ADD("  Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,Plazo1,Plazo2,Plazo3,Plazo4,")
SQL.ADD("  Cantidad1,Cantidad2,Cantidad3,Cantidad4,Precio1,Precio2,Precio3,Precio4,Total1,Total2,")
SQL.ADD("  Total3,Total4,Total5,Total6,Total7,Total8,Tasa1,Tasa2,PrecioRef1,PrecioRef2,Cantidad5,")
SQL.ADD("  Cantidad6,Precio5,Precio6,Precio7,Precio8,Tasa3,Total9,Cotizacion1,Cotizacion2,Tasa4,Tasa5,")
SQL.ADD("  Cantidad7,Cantidad8,Coeficiente,Cantidad1Ori,Cantidad2Ori,Cantidad3Ori,ResultadoIndice, Cantidad12")
SQL.ADD(" ) ")

SQL.ADD("SELECT '"~VAL(A:1)~"' As NrOperacion,NrCuota,Cliente1,Cliente2,")
SQL.ADD("  Vehiculo1,Vehiculo2,Especie1,Especie2,Especie3,Especie4,Check1,Check2,Check3,")
SQL.ADD("  Check4,Check5,Check6,Check7,Check8,Check9,Check10,Radio1,Radio2,Radio3,Radio4,")
SQL.ADD("  Radio5,Radio6,Radio7,Radio8,Radio9,Radio10,'"~IdxDate(Dialogo.Fecha1)~"'as  Fecha1,'"~IdxDate(VAL(FE:1))~"' as Fecha2,'"~IdxDate(VAL(FE:1))~"' ")
SQL.ADD("  as Fecha3,'"~IdxDate(VAL(FE:1))~"' as Fecha4,Fecha5, Fecha6,Fecha7,Fecha8,Fecha9,Fecha10,Mercado1,Mercado2,'"~Dialogo.Entero1~"' as Plazo1,Plazo2,Plazo3,Plazo4,")
SQL.ADD("  "~Dialogo.Cantidad1~" as Cantidad1,"~Dialogo.Cantidad1~" as Cantidad2,0 as Cantidad3,Cantidad4,Precio1,0 as Precio2,Precio3,Precio4,"~VAL(TB:1)~" as Total1,"~VAL(TB:1)~" as Total2,")
SQL.ADD("  0 as Total3,0 as Total4,Total5,Total6,"~VAL(TB:1)~" as Total7,"~VAL(TB:1)~" as Total8,Tasa1,Tasa2,0 as PrecioRef1,PrecioRef2,Cantidad5,")
SQL.ADD("  Cantidad6,0 as Precio5,0 as Precio6,0 as Precio7,"~VAL(PE:1)~" as Precio8,Tasa3,0 as Total9,Cotizacion1,0 as Cotizacion2,Tasa4,Tasa5,")
SQL.ADD("  Cantidad7,Cantidad8,Coeficiente,"~Dialogo.Cantidad1~" as Cantidad1Ori,"~Dialogo.Cantidad1~" as Cantidad2Ori,Cantidad3Ori,ResultadoIndice,"~Dialogo.Cantidad1~" as Cantidad12")
SQL.ADD("FROM "~DBO~".CUOTAS ")
SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC
**Genero la Operacion Vinculada
EjecutarEvento('INSEVI',NrOperacion1=VAL(A:1),TipoOp1='SEPVMV',Vehiculo2=VAL(VE:1),Vehiculo1=VAL(VE:2),String1='',String='')

****Instancias 

ACT(J:1,val(A:1))
ACT(J:2,BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',Val(J:1)))
Recorrer&I 1,2
   SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" (NrOperacion,NrBit,Valor) ")
   SQL.ADD("  SELECT '"~VAL(J:&I)~"' As NrOperacion,NrBit,Valor ")
   SQL.ADD("    FROM "~DBO~".OPERACIONESBITS ")
   SQL.ADD("   WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.EXEC
   ************ Las Pongo en terminal ************

   SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD("   Set Valor       = '0' ")
   SQL.ADD(" Where NrOperacion = '"~Val(J:&I)~"' ")   
   SQL.NEW
   SQL.EXEC

   SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD("   Set Valor       = '1' ")
   SQL.ADD(" Where NrOperacion = '"~Val(J:&I)~"' ")
   SQL.ADD(" and NrBit         =  '50'  ") 
   SQL.NEW
   SQL.EXEC
   IFA
Proximo



