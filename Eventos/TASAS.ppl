*** Carga de Tasas Variable Sindicados y FRN
CrearDialogo
  NrOperacion1  : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1) Y Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMFCMV|MMSCMV');'Debe Ingresar un Tipo de Operacion Valida MMFCMV|MMSCMV';NO;;;SQLSET("SELECT NrOperacion FROM "~DBO~".OPERACIONES Where TipoOp IN ('MMSCMV','MMFCMV') Order By NrOperacion")
  Fecha1        : "Fecha "                   ;1;2;;NO;;;;;Fsys
  Radio2        : "Entidad|Local|Extranjero" ;2;1;;NO;NO;;;;;BuscarCampo('Operaciones','CB10','NrOperacion',Dialogo.NrOperacion1);
  Radio1        : 'Operacion|Fija|Flotante'  ;2;1;;NO;NO;NOT EQSTR(BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1),'FIJA');'ERROR !!!, La Operacion es a Tasa Fija';NO;; ;
  Entero2       : "Asigna RB6"               ;2;1;;NO;NO;;;;BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','RB6','NrOperacion',Dialogo.NrOperacion1)
  Entero1       : "Nro. Periodo"             ;2;1;;;;Dialogo.Entero1>0 Y Dialogo.Entero1<=BuscarCampo('Operaciones','Cuotas1','NrOperacion',Dialogo.NrOperacion1);'DEBE INDICAR UN NUMERO DE PERIODO EXISTENTE';NO;0;
  Fecha2        : "Fecha Inicio"             ;2;2;;NO;;;;;;SQL("Select Fecha1 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Precio2       : "Tasa"                     ;4;1;;;;Dialogo.Precio2=0 O [Dialogo.Precio2<=VAR('RTASA2') Y Dialogo.Precio2>=VAR('RTASA1')];'TASA INCORRECTA O FUERA DE RANGO:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;0;SQL("Select Precio2 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Precio4       : "Spread"                   ;5;;;;;Dialogo.Precio4=0 O [Dialogo.Precio4<=VAR('RSPREAD2') Y Dialogo.Precio4>=VAR('RSPREAD1')];'Spread Incorrecto o Fuera de Rango:'~VAR('RSPREAD1')~" Y "~VAR('RSPREAD2');SI;0;SQL("Select Precio4 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Precio6       : "TTN"                      ;6;;;;;Dialogo.Precio6=0 O [Dialogo.Precio6<=VAR('TTN2') Y Dialogo.Precio6>=VAR('TTN1')];'Tasa Total Neta Incorrecta o Fuera de Rango:'~VAR('TTN1')~" Y "~VAR('TTN2');SI;0;SQL("Select Total3 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Precio8       : "%Int WH"                  ;4;2;;;[Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMSCMV|MMFCMV')];Dialogo.Precio8>=0;'La Tasa de Interes para Calculo de WH debe ser Positiva';SI;0;SQL("Select Total6 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Precio10      : "%Int IVA"                 ;5;2;;;[Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMSCMV|MMFCMV')];Dialogo.Precio10>=0;'La Tasa de Interes para Calculo de IVA debe ser Positiva ';SI;0;SQL("Select Tasa2 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Fecha7       : 'FechaCargaSys'         ;1;1;;NO;NO;;;;;BuscarCampo('Operaciones','FechaCargaSys','NrOperacion',Dialogo.NrOperacion1);
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)


* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50 y Not [Dialogo.Fecha7=Fsys y VAL(X1)=1]
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

ACN(xx1,0)
If Dialogo.Fecha7=Fsys y VAL(X1)=1
   ACN(xx1,1)
EndIf


*-- Guardo los valores del anterior dialogo.
*-- Y20: Fecha1 Y21: Radio2  Y22: Radio1 y23: Fecha2
*-- Y24: Precio2
ACT(y1,Dialogo.NrOperacion1)
ACN(y7,Dialogo.Entero1)
ACD(y20,Dialogo.Fecha1)
ACN(y21,Dialogo.Radio2)
ACN(y22,Dialogo.Radio2)
ACD(y23,Dialogo.Fecha2)
ACN(y24,Dialogo.Precio2)
ACN(y25,Dialogo.Precio4)
ACN(y26,Dialogo.Precio6)
ACN(y27,Dialogo.Precio8)
ACN(y28,Dialogo.Precio10)

Message('Calculando los monto de las Cuotas .... ')

SQL.ADD("SELECT * FROM  "~DBO~".CUOTAS ")
SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")

Recorrer SQL

   * Calculo el Interes Total de La Operacion y el Monto
   acn(a4,FBN['Cantidad2']*((Dialogo.Precio2+Dialogo.Precio4)/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))

   ACN (A5,FBN['Cantidad1']+VAL(A4))

   SQL.ADD("Update "~DBO~".CUOTAS ")
   SQL.ADD("Set")
   SQL.ADD("Precio2 = "~Fstr(Dialogo.Precio2,0,7)~", ")
   SQL.ADD("Precio4 = "~Fstr(Dialogo.Precio4,0,7)~", ")
   SQL.ADD("Total3 = "~Fstr(Dialogo.Precio6,0,7)~", ")
   SQL.ADD("Total6 = "~Fstr(Dialogo.Precio8,0,7)~", ")
   SQL.ADD("Tasa2 = "~Fstr(Dialogo.Precio10,0,7)~", ")
   SQL.ADD("Cantidad3 = "~Fstr(VAL(A4),0,7)~", ")
   SQL.ADD("Precio5 = "~Fstr(VAL(A4),0,7)~", ")
   SQL.ADD("Total2    = "~Fstr(VAL(A5),0,7)~" ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
   SQL.NEW
   SQL.EXEC

   * Verifico si debo actualizar la comision CPI para la cuota que se modifica
   SQL.ADD("Select * From "~DBO~".COMISIONES2 WHERE ")
   SQL.ADD("NrOperacion='"~VAL(y1)~"' and Tipo='3' ")
   SQL.ADD("and NrCuota = "~Fstr(VAL(Y7),2,0)~" ")

   ACN(Z1,0)

   Recorrer SQL
        ACN(Z1,1)                
        ACT(y2,FBN['Especie1'])
        ACT(y3,FBN['Cliente1'])
        ACN(y4,FBN['Tasa1'])
        ACN(y5,FBN['Importe1'])
        ACN(y6,FBN['RB2'])
   Proximo

   *-- y10 Calculo del Imp. de Amortizacion por Cuota  y11: Valor Nominal de la Cuota
   ACN(y10, FBN['Cantidad1'])
   ACN(y11,FBN['Cantidad2'])

   If VAL(z1)=1

      CrearDialogo
         NrOperacion1 : "Operacion"                ;1;1;;NO;  ;NoVacio(Dialogo.NrOperacion1);'DEBE INGRESAR UNA OPERACION';NO;VAL(y1)
         Especie1     : "Especie"                  ;;;;;;NOVACIO(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie';NO;VAL(y2)
         Cliente1     : "Destinatario"             ;;;;;;NOVACIO(Dialogo.Cliente1);'DEBE INGRESAR EL DESTINATARIO';NO;VAL(y3)
         Radio1       : "Estranjero?|Loc|Ext"      ;;;;NO;NO;;;;;IIF(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
         Entero1      : "Nro. Settlement"          ;1;2;;NO;Novacio(Dialogo.NrOperacion1);;;;VAL(y7)
         Precio2      : "Tasa IVA"                 ;2;2;;NO;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o INCLUIDO(FSTR(Dialogo.Precio2,2,2),VAR('IVA'));"EL VALOR DE LA TASA IVA ES ERRONEO: "~VAR('IVA');NO;VAR('TASAIVA');IIF(Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio2)
         Precio3      : "Tasa WH"                  ;3;2;;NO;Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o Incluido(Fstr(Dialogo.Precio3,2,4),VAR('TASAWH'));'EL VALOR DE LA TASA WH ES ERRONEO: '~VAR('TASAWH')~' ...';NO;VAR('DEFWH1');IIF(EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio3)
         Precio4      : "% Imp.Int"                ;;;;EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1));Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)) o INCLUIDO(FSTR(Dialogo.Precio4,2,4),VAR('TASAINT'));"El Valor de TASA INTERES es Erroneo: "~VAR('TASAINT');NO;VAR('DEFAINT');IIF(Not EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,Dialogo.Precio4)
         Precio1      : "Tasa Comision"            ;;;;;;Dialogo.Precio1>0;'Debe Ingresar una Tasa Comision';NO;VAL(y4);(Dialogo.Cantidad1*IIF(Dialogo.Radio2=0,36000,36500)) /(VAL(y11)*FBN['Plazo1'])
         Cantidad1    : "Importe"                  ;;;;;;;;;;(VAL(y11)*Dialogo.Precio1*FBN['Plazo1'])/IIF(Dialogo.Radio2=0,36000,36500);;;"###,###,###,###.##"
         Radio2       : "UT|360|365"               ;;;;;;;;;VAL(Y6);     
     FinDialogo

     If Not Ok
        Cancelar
     EndIf

     * y13: TasaWH y14: TasaIVA
     ACN(y13,IIF(Dialogo.Radio1=0,0,Dialogo.Precio3))
     ACN(y14,IIF(Dialogo.Radio1=1,0,Dialogo.Precio2))
     ACN(y30,IIF(Dialogo.Radio1=1,Dialogo.Precio4,0))

     SQL.ADD(" UPDATE "~DBO~".COMISIONES2 ")
     SQL.ADD(" Set ")
     SQL.ADD(" Tasa1="~Fstr(Dialogo.Precio1,0,5)~", ")
     SQL.ADD(" Importe1="~Fstr(Dialogo.Cantidad1,0,2)~",")
     SQL.ADD(" Importe2="~Fstr(VAL(y14)*Dialogo.Cantidad1/100,0,2)~",")
     SQL.ADD(" Importe3="~Fstr(VAL(y13)*Dialogo.Cantidad1/100,0,2)~", ")
     SQL.ADD(" Importe4="~Fstr(Dialogo.Cantidad1+( (VAL(Y13)+VAL(Y30)) *Dialogo.Cantidad1/100),0,2)~", ")
     SQL.ADD(" Precio2 ="~Fstr(VAL(y30)*Dialogo.Cantidad1/100,0,2)~" ")
     SQL.ADD(" Where NrOperacion='"~val(y1)~"' and Tipo='3' ")
     SQL.ADD(" and NrCuota = "~Fstr(val(y7),0,0)~" ")
     SQL.NEW
     SQL.EXEC

   EndIf 
Proximo

* Actualizo la Instancia de la Operacion a Supervision
If val(xx1)=0
   (.'MODIINSTAN'.)      
EndIf

*-- Actualiza los datos de la Cuota en las Participantes
SQL.ADD(" Select O.RB8,O.ImpGastos2,O.TotalAux1,O.RB7,O.RB9,O.CB10,C.* From ")
SQL.ADD(" "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD(" where O.OperacionRef = '"~VAL(Y1)~"' ")
SQL.ADD(" and O.NrOperacion=C.NrOperacion ")
SQL.ADD(" and NrCuota = "~Fstr(VAL(y7),2,0)~"  ")

Recorrer SQL

   * A10: Unidad de Tiempo Calculo de Intereses
   ACN(A10,IIF(EqStr(FBN['RB8'],'0')  ,36000,36500))

   * A4 es el interes
   * A11 es el interes total
   * A5 es el monto
   * A6 es el monto total
   * A7 es el importe iva
   * A8 es el importe wh

   ACN(A7,0)
   ACN(A8,0)

   * PARA LOCAL O EXTRANJERO
   IF EQSTR (FBN['CB10'], '0')
      * PARA UT
      IF EQSTR(FBN['RB7'],'0')
        ACN(A30,360)
      ELSE
        ACN(A30,365)
      ENDIF
      ACN (A7, ((FBN['Cantidad2']*FBN['Plazo1']*VAL(y28))/ (VAL(A30)*100)) * (FBN['ImpGastos2']/100))
   ELSE
      IF EQSTR(FBN['RB9'],'0')
         ACN(A31,360)
      ELSE
         ACN(A31,365)
      ENDIF
      ACN (A8, ((FBN['Cantidad2']*FBN['Plazo1']*VAL(y27))/ (VAL(A31)*100)) * (FBN['TotalAux1']/100))
   ENDIF

   *-- Interes
   acn(a4,FBN['Cantidad2']*((VAL(y24)+VAL(y25))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',VAL(y1))+1))

   *-- Interes Total
   acn (a11, val(a4) + val(a8))

   * El Monto incluye el IMPORTE DE AMORTIZACION.
   * Monto
   ACN (A5,FBN['Cantidad4']+VAL(A4))

   * Monto Total
   ACN (A6,FBN['Cantidad4']+VAL(A11))


   Message('Actulizando Cuota .... ')

   SQL.ADD("Update "~DBO~".CUOTAS ")
   SQL.ADD("Set")
   SQL.ADD("Precio2  = "~Fstr(VAL(y24),0,7)~", ")
   SQL.ADD("Precio4  = "~Fstr(VAL(y25),0,7)~", ")
   SQL.ADD("Total3  = "~Fstr(VAL(y26),0,7)~", ")
   SQL.ADD("Total6   = "~Fstr(VAL(y27),0,7)~", ")
   SQL.ADD("Tasa2    = "~Fstr(VAL(y28),0,7)~", ")
   SQL.ADD("Cantidad3= "~Fstr(VAL(A4),0,2)~", ")
   SQL.ADD("Precio5  = "~Fstr(VAL(A4),0,2)~", ")
   SQL.ADD("Precio1   = "~Fstr(VAL(A7),0,2)~", ")
   SQL.ADD("Precio3  = "~Fstr(VAL(A8),0,2)~", ")
   SQL.ADD("Cantidad5   = "~Fstr(VAL(A11),0,2)~", ")
   SQL.ADD("Total2   = "~Fstr(VAL(A5),0,2)~", ")
   SQL.ADD("Total1   = "~Fstr(VAL(A6),0,2)~" ")
   SQL.ADD("where NrOperacion = '"~FBN['NrOperacion']~"' ")
   SQL.ADD("and NrCuota = "~Fstr(VAL(y7),2,0)~" ")
   SQL.NEW
   SQL.EXEC

   * Actualizo la Instancia de la Operacion a Supervision
   ACT(i3,FBN['NrOperacion'])

   If val(xx1)=0
      (.'MODIINSTAN'.)      
   EndIf

   *-- y10 Calculo del Imp. de Amortizacion por Cuota  y11: Valor Nominal de la Cuota
   ACN(y10,FBN['Cantidad4'])

   ACN(y11,FBN['Cantidad2'])

   *-- Inserto la Nueva Comision CPI si corresponde
   If VAL(z1)=1

      ACN(y12,(VAL(y11)*Dialogo.Precio1*FBN['Plazo1'])/IIF(Dialogo.Radio2=0,36000,36500))

      SQL.ADD(" UPDATE "~DBO~".COMISIONES2 ")
      SQL.ADD(" Set ")
      SQL.ADD(" Tasa1="~Fstr(Dialogo.Precio1,0,5)~", ")
      SQL.ADD(" Importe1="~Fstr(VAL(Y12),0,2)~",")
      SQL.ADD(" Importe2="~Fstr(VAL(y14)*VAL(y12)/100,0,2)~",")
      SQL.ADD(" Importe3="~Fstr(VAL(y13)*VAL(y12)/100,0,2)~", ")
      SQL.ADD(" Importe4="~Fstr(VAL(y12)+((VAL(Y13)+VAL(Y30)) *VAL(Y12)/100),0,2)~", ")
      SQL.ADD(" Precio2 ="~Fstr(VAL(y30)*VAL(y12)/100,0,2)~" ")
      SQL.ADD(" Where NrOperacion='"~FBN['NrOperacion']~"' and Tipo='3' ")
      SQL.ADD(" and NrCuota = "~Fstr(VAL(y7),0,0)~" ")
      SQL.NEW
      SQL.EXEC
   EndIf 

   *** Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
   SQL.EXEC
Proximo

