CrearDialogo
  NrTrans1: 'Nro.Voucher';;;;;;Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'FXDEP|FXRET|FXCOMP');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('FXDEP','FXRET','FXCOMP') AND Fecha1 = '"~IdxDate(Fsys)~"' ";
FinDialogo
if Not OK
  Cancelar
endif

if BuscarCampo('TRANSACCIONES2','CB10','NrTrans',Dialogo.NrTrans1)<>1
  Cancelar('El Voucher '~Dialogo.NrTrans1~' NO es de OCT ')
endif
if BuscarCampo('TRANSACCIONES2','CB9','NrTrans',Dialogo.NrTrans1)=1
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta confirmado')
endif
if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'FXDEP|FXRET')
  ACT(x1, SQL("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrTrans1~"' and NrBit = 2 "))
  if EqStr(Val(x1),'1')
    Cancelar('El Voucher '~Dialogo.NrTrans1~' esta fallado')
  endif
endif

SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
SQL.ADD("NrMov, NrLiq, Status, NrInstan, Cupon, ")
SQL.ADD("Cuenta, Transaccion, Cantidad) ")
SQL.ADD("Select ")
SQL.ADD("NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
SQL.ADD("NrMov, NrLiq, Status, NrInstan, Cupon, ")
SQL.ADD("Cuenta, Transaccion, Cantidad ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
SQL.ADD("where NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.ADD("and NrOperacion <> '"~Dialogo.NrTrans1~"'")
SQL.ADD("Union ")
SQL.ADD("Select ")
SQL.ADD("NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
SQL.ADD("NrMov, NrLiq, Status, NrInstan, Cupon, ")
SQL.ADD("Cuenta, Transaccion, Cantidad ")
SQL.ADD("from "~DBO~".MOVPENDIENTES ")
SQL.ADD("where NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.ADD("and NrOperacion <> '"~Dialogo.NrTrans1~"'")
SQL.NEW

SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS ")
SQL.ADD("where NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.NEW

SQL.ADD("DELETE from "~DBO~".MOVPENDIENTES ")
SQL.ADD("where NrTrans2 = '"~Dialogo.NrTrans1~"'")
SQL.NEW

