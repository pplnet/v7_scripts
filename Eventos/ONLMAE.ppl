*  acn(yy2, Messagebox('El Online NO esta levantado',1,0))
*  **Message3('El Online NO esta levantado')
*endif

*if Eqstr(Var('ONLINEOPEX'),'NO')
*  acn(yy2, Messagebox('El Online de OPEX NO esta levantado',1,0))
*  **Message3('El Online de OPEX NO esta levantado')
*endif

*if Eqstr(Var('ONLINETI'),'NO')
*  acn(yy2, Messagebox('El Online de Titulos NO esta levantado',1,0))
*  **Message3('El Online de Titulos NO esta levantado')
*endif

SQL.ADD("Update "~DBO~".VARIABLES    ")
SQL.ADD("   Set Valor  = 'SI'        ") 
SQL.ADD(" where Codigo = 'ONLINEMAE' ")
SQL.NEW

*** MessageBox('Despues de SI')

SQL.ADD("Update "~DBO~".VARIABLES   ") 
SQL.ADD("  Set Valor  = 'NO'         ") 
SQL.ADD("where Codigo = 'DESCONMAE' ")
SQL.NEW

*** Actualizo fecha y hora alta online MAE
ACT(h1, SQLAhora)
SQL.ADD("Update "~DBO~".VARIABLES    ")
SQL.ADD("   Set Valor  = "~Val(h1)~" ")
SQL.ADD(" where Codigo = 'ONLIMAAL'  ")
SQL.NEW
SQL.EXEC

if SQL("Select Count(*) from "~DBO~".VARIABLES where Codigo = 'MAE-PROXY' ")=0
    MessageBox('No existe la variable MAE-PROXY')
else
    ACT(pr:1, Var('MAE-PROXY'))
endif

if Not EqStr(Val(pr:1),'SI')
    ACT(pr:1, 'NO')
endif

if EqStr(Val(pr:1),'SI')
    if SQL("Select Count(*) from "~DBO~".VARIABLES where Codigo = 'PROXYOK' ")=0
      MessageBox('No existe la variable PROXYOK')
      Cancelar('Evento Cacelado')
    endif
    if SQL("Select Count(*) from "~DBO~".VARIABLES where Codigo = 'LOGINOK' ")=0
      MessageBox('No existe la variable LOGINOK')
      Cancelar('Evento Cacelado')
    endif
endif

ACN(m:1, 0)
ACN(m:2, 0)
ACN(m:3, 0)

*** MessageBox('Antes de repetir')
Repetir
  SCN(x:1, 1)
  Message('Inicio vuelta '~Fstr(Val(x:1),1,0))
  ACN(m3, 0)
  
  *SI A3ACTIVO ES 'SI' 1° Condicional
  if Eqstr(VAR('A3ACTIVO'), 'SI')
    if EqStr(Val(pr:1),'NO')
      ************************************************
      ** No usa el Proxy (Variable MAE-PROXY)
      ************************************************
      if Val(x:1)=1
        Message('El Online de MAE NO usa SIAF_ProxyMAE')
      endif
      if Val(m1)=0
        *********************************  LOGIN : Mensaje 7000 ***************************
        Message('Iniciando Proceso de Conexión al MAE (Ciclo: '~Fstr(Val(x:1),1,0)~')')
        *** MessageBox('Antes de Iniciar')
        *   Socket.Iniciar(VAR('DIRIPMAE'), VAR('SOCKET'))
        if Not Ok
          Message('Error en la Conexión (Ciclo: '~Fstr(Val(x:1),1,0)~')')
          ACN(m3,1)
        endif

        if Val(m3)=0
          *************************** Prepara info para Bloque de Control *************************
          * Longitud             PIC(4)                                                           *
          * Mercado              PIC(1)                                                           *
          * Agente               PIC(3)                                                           * 
          * Operador             PIC(2)                                                           *
          * Fecha                PIC(6)                                                           *
          * Hora                 PIC(6)                                                           *
          * Secuencia            PIC(5)                                                           *
          * Cód. de Registro     PIC(4)                                                           *
          *****************************************************************************************
          ACN(Y1, Ahora)
          ACT(Y2, Hora(Val(Y1)))
          ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
          ***** Mercado
          ACT(A2, Var('MERSIOP'))
          ***** Agente                                        
          ACT(A2, Val(A2)~Var('AGESIOP'))
          ***** Operador  
        * FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
        * ACT(A2, Val(A2)~'99')
          ACT(A2, Val(A2)~Var('OPESIOPEL'))
          ***** Fecha
          ACT(A2, Val(A2)~Val(Y3))
          ***** Hora
          ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
          ACT(A2, Val(A2)~Copy(Val(Y2),4,2))
          ACT(A2, Val(A2)~Copy(Val(Y2),7,2))
          ***** Secuencia 
          ACT(A2, Val(A2)~'00001')
          ***** Codigo de Registro
          ACT(A2, Val(A2)~'7000')
          *************************** Prepara info para Bloque de Datos ***************************
          * Password             PIC(8)                                                           *
          * Ult.Secuencia        PIC(17)                                                          *
          *****************************************************************************************
          ***** Password
          ACT(A2, Val(A2)~Pad(VAR('PWDSIOPEL'),8))
          ***** Ultima Secuencia Recibida
          ACT(A2,Val(A2)~Var('ULTSECMAE'))
          ***** Longitud Total del Paquete en Caracteres
          ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4) )
          ACT(A2, Val(P1)~Val(A2))
          Message('----- Enviando Pedido de Login (7000) (Ciclo: '~Fstr(Val(x:1),1,0)~')')
          Socket.Enviar(Val(A2))
          if Not OK
            Socket.Desconectar
            Socket.Terminar
            Message('Error Enviando Mensaje de Conexión 7000 (Ciclo: '~Fstr(Val(x:1),1,0)~')')
            ACN(m3,1)
          endif
        endif

        if Val(m3)=0
          if Eqstr(Var('LOGEAMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.txt',0)
            EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
            CerrarASCII
          endif

          Esperar2(1000)

          *****************************************************************************************
          * Recibir respuesta al Login 7020                                                       *
          *****************************************************************************************  
          ACN(X8, (AHORA-FSYS)/0.00001157)
          ACN(X6, Val(X8))
          Recorrer&I 1,10000
            ACT(A1, Socket.Recibir)
            if Not CeldaVacia(A1)
              if Eqstr(Var('LOGEAMAE'),'SI')
                AbrirASCII(VAR('PATHSIOPEL')~'\RECIBMAE.txt',0)
                EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:1))
                CerrarASCII
              endif
              if EqStr(Copy(Val(A1),28,4),'7020') y EqStr(Copy(Val(A1),32,4),'7000')
                Message('----- Respuesta al Login (7000) Recibida (Ciclo: '~Fstr(Val(x:1),1,0)~')')
                if EqStr(Copy(Val(A1),47,1),'S')
                  Message('---------- Conexion al MAE Exitosa')
                  ACN(m:1,1)
                  ACN(m:2,1)
                  ******************* Prepara Pedido de Operaciones Atrasadas *********************
                  * Longitud             PIC(4)                                                   *
                  * Mercado              PIC(1)                                                   *
                  * Agente               PIC(3)                                                   * 
                  * Operador             PIC(2)                                                   *
                  * Fecha                PIC(6)                                                   *
                  * Hora                 PIC(6)                                                   *
                  * Secuencia            PIC(5)                                                   *
                  * Cód. de Registro     PIC(4)                                                   *
                  *********************************************************************************
                  Message('---------- Solicitando Envio de Op. Atrasadas')
                  ACN(Y1, Ahora)
                  ACT(Y2, Hora(Val(Y1)))
                  ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
                  ***** Longitud del Mensaje
                  ACT(A2, '0031')
                  ***** Mercado
                  ACT(A2, Val(A2)~Var('MERSIOP'))
                  ***** Agente                                        
                  ACT(A2, Val(A2)~Var('AGESIOP'))
                  ***** Operador  
            * FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
            *     ACT(A2, Val(A2)~'99')
                  ACT(A2, Val(A2)~Var('OPESIOPEL'))
                  ***** Ultima Secuencia 
                  ACT(A2,Val(A2)~Var('ULTSECMAE'))
                  ***** Código de Registro 
                  ACT(A2, Val(A2)~'9996')
                  ************************ Enviar Pedido de Operaciones Atrasadas *****************
                  Socket.Enviar(Val(A2))
                  if Not OK
                    Socket.Desconectar
                    Socket.Terminar
                    Message('Error pidiendo mensajes atrasados (Ciclo: '~Fstr(Val(x:1),1,0)~')')
                    ACN(m:1, 0)
                    ACN(m:2, 0)
                    ACN(m:3, 1)
                  endif
                  if Val(m:3)=0
                    if Eqstr(Var('LOGEAMAE'),'SI')
                      AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.txt',0)
                      EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
                      CerrarASCII
                    endif
                  endif
                  SQL.ADD("Update "~DBO~".VARIABLES ")
                  SQL.ADD("   Set Valor  = '"~Copy(Val(a1),11,17)~"' ")
                  SQL.ADD(" Where Codigo = 'ULTSECMAE' ")
                  SQL.NEW
                  SQL.EXEC
                  BorrarCeldas(A1..A1)
                  Break
                else
                  ************************* Conexion al MAE Rechazada *****************************
                  Message('Solicitud de Conexion al MAE Rechazada (Ciclo: '~Fstr(Val(x:1),1,0)~')')
    *                Message2('Solicitud de Conexion al MAE Rechazada (Ciclo: '~Fstr(Val(x:1),1,0)~')')
                  Break
                endif
              endif
            endif
            ACN(Y8,(AHORA-FSYS)/0.00001157)
            if (Val(X8)+5)<Val(Y8)
              SCN(X8,5)
              if (Val(Y8)-Val(X6)-1)<60
                Message('Esperando Respuesta del MAE - '~FStr(Val(Y8)-Val(X6),1,0)~' Segundos') 
              else
                ACN(W8,trunc2((Val(Y8)-Val(X6))/60))
                ACN(W9, (Val(Y8)-Val(X6))-(60*Val(W8)))
                Message('-- Esperando Respuesta del MAE - '~FStr(Val(W8),1,0)~' Min., '~ FStr(Val(W9),1,0)~' Seg.')
              endif
            endif
            if (Val(Y8)-Val(X6))>300
              Message('Error en Conexión - Solicitud No Contestada (Ciclo: '~Fstr(Val(x:1),1,0)~')') 
    *            Message2('Error en Conexión - Solicitud No Contestada (Ciclo: '~Fstr(Val(x:1),1,0)~')') 
              Break
            endif
          Proximo
        endif

        if Val(m1)=1
          if Eqstr(Var('EJEEVEMAE'),'SI')
            ******************** Dispara evento para recibir mensajes despues de conectarse *******
            Message('- Iniciando Evento Recibir Mensajes del MAE (Ciclo: '~Fstr(Val(x:1),1,0)~')')
            ****** Consulto la variable ambiente******
            if Eqstr(Var('AMBIENTE'),'DES')
              EjecutarEvento('RECMAE')
            else
              EjecutarEvento2('RECMAE')
            endif
    ***/ 
            ************************* Dispara Informar Operaciones de Ayer ************************
    *          Message('- Iniciando Evento Informar Operaciones de Ayer (Ciclo: '~Fstr(Val(x:1),1,0)~')')
    *          EjecutarEvento2('INAYER')
          endif
        endif
      endif
      ************************************************
      ** Aca Termina cuando NO Usa el Proxy
      ************************************************
    else
      ************************************************
      ** Usa el Proxy (Variable MAE-PROXY)
      ************************************************
      if Val(x:1)=1
        Message('El Online de MAE usa SIAF_ProxyMAE')
      endif

      if EqStr(Var('PROXYOK'),'SI')
        Message('ProxyMAE OK (Ciclo: '~Fstr(Val(x:1),1,0)~')')
        if EqStr(Var('LOGINOK'),'SI')
          Message('Proxy-Login OK (Ciclo: '~Fstr(Val(x:1),1,0)~')')
          ACN(m:1, 1)
          ACN(m:2, 1)
        else
          Message('Proxy-Login Not OK (Ciclo: '~Fstr(Val(x:1),1,0)~')')
          ACN(m:1,1)
          ACN(m:2,0)
        endif
      else
        Message('Proxy-MAE Not OK (Ciclo: '~Fstr(Val(x:1),1,0)~')')
        ACN(m:1,0)
        ACN(m:2,0)
      endif
    endif

    *********************************************************************************************
    ******************************** Ciclo de Ejecución de Eventos ******************************
    *********************************************************************************************
    if Eqstr(Var('EJEEVEMAE'),'SI')
      Message('Mensaje: '~Hora(Ahora))
      Message('*********  Recorrida número '~Fstr(Val(x:1),1,0)~'  ************')
      
      if Val(M:2)=1 o EqStr(Val(pr:1),'SI')
        ************************* Dispara evento para recibir mensajes **************************
        Message('- Iniciando Evento Recibir Mensajes del MAE')
        ****** Consulto la variable ambiente******
        if Eqstr(Var('AMBIENTE'),'DES')
          EjecutarEvento('RECMAE')
        else
          EjecutarEvento2('RECMAE')
        endif
      endif
                
      if Val(M:2)=1
        * Esta logeado al MAE   
        ************************* Dispara evento auxiliar EVMAEL **********************
        Message('- Iniciando Evento MAE Loegeado')
        ****** Consulto la variable ambiente******
        if Eqstr(Var('AMBIENTE'),'DES')
          EjecutarEvento('EVMAEL',Check1=Val(x2))      
        else
          EjecutarEvento2('EVMAEL',Check1=Val(x2))      
        endif
                
      endif
      

      *******************************************************************************************
      ** Eventos que se Ejecutan aunque no este conectado el MAE
      *******************************************************************************************

      ************************* Dispara evento auxiliar EVMAES **********************
      Message('- Iniciando Evento MAE que se ejecutan siempre')
      ****** Consulto la variable ambiente******
      if Eqstr(Var('AMBIENTE'),'DES')
        EjecutarEvento('EVMAES',Check1=Val(x2))
      else
        EjecutarEvento2('EVMAES',Check1=Val(x2))
      endif
                
    endif
  else
    *******************************************************************************************
    ** Eventos que se Ejecutan aunque no este conectado el MAE
    *******************************************************************************************

    ************************* Dispara evento auxiliar EVMAES **********************
    Message('- Iniciando Evento MAE que se ejecutan siempre')
    ****** Consulto la variable ambiente******
    if Eqstr(Var('AMBIENTE'),'DES')
      EjecutarEvento('EVMAES',Check1=Val(x2))
    else
      EjecutarEvento2('EVMAES',Check1=Val(x2))
    endif
  endif
  
  *ACA VA UN ELSE CON EL EVMAES *ACA CIERRO CONDICIONAL DOS  
  *********************************************************************************************
  ******************************** Cntrol de Conexion *****************************************
  *********************************************************************************************
  
  *ACA VA UN 3°CONDICIONAL
  if Eqstr(VAR('A3ACTIVO'), 'SI')
    if Val(M:1)=1 y EqStr(Val(pr:1),'NO')
        if Val(x:1) Mod 20=0
            ******************* Prepara Pedido de Operaciones Atrasadas *****************************
            * Longitud             PIC(4)                                                           *
            * Mercado              PIC(1)                                                           *
            * Agente               PIC(3)                                                           * 
            * Operador             PIC(2)                                                           *
            * Fecha                PIC(6)                                                           *
            * Hora                 PIC(6)                                                           *
            * Secuencia            PIC(5)                                                           *
            * Cód. de Registro     PIC(4)                                                           *
            *****************************************************************************************
            Message('---------- Solicitando Envio de Op. Atrasadas')
            ACN(Y1, Ahora)
            ACT(Y2, Hora(Val(Y1)))
            ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
            ***** Longitud del Mensaje
            ACT(A2, '0031')
            ***** Mercado
            ACT(A2, Val(A2)~Var('MERSIOP'))
            ***** Agente                                        
            ACT(A2, Val(A2)~Var('AGESIOP'))
            ***** Operador  
            * FJL 10/02/21 - En BIND se usa otro operador por eso uso la variable
            *      ACT(A2, Val(A2)~'99')
            ACT(A2, Val(A2)~Var('OPESIOPEL'))
            ***** Ultima Secuencia 
            ACT(A2,Val(A2)~Var('ULTSECMAE'))
            ***** Código de Registro 
            ACT(A2, Val(A2)~'9996')
            ************************ Enviar Pedido de Operaciones Atrasadas *************************
            Socket.Enviar(Val(A2))
            if Not OK
              Socket.Desconectar
              Socket.Terminar
              **  Message3('Error controlando conexion (Ciclo: '~Fstr(Val(x:1),1,0)~')')
              Message('Error controlando conexion (Ciclo: '~Fstr(Val(x:1),1,0)~')')
              ACN(m1, 0)
              ACN(m3, 1)
            endif
            if Val(m3)=0
              if Eqstr(Var('LOGEAMAE'),'SI')
                AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.txt',0)
                EscribirASCII(Fecha(Ahora-1,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
                CerrarASCII
              endif
            endif
        endif
      endif
    endif
    *CIERRO EL 2° CONDICIONAL 
    *  Message('ONLINEMAE = '~Var('ONLINEMAE'))
    *  Message('m:2 = '~FStr(Val(m:2),0,0))
    *  Message('x:1 = '~FStr(Val(x:1),0,0))
    *  Message('VUELMAE = '~FStr(Var('VUELMAE'),0,0))
    *** MessageBox('Hasta aca 3')
    *iria fuera del condicional-----
    if EqStr(Var('ONLINEMAE'),'NO') o [Val(m:2)=0 y Val(x:1)>=Var('VUELMAE') y Var('VUELMAE')<>0]
    *    Message('Hasta aca 4')
      if EqStr(Val(pr:1),'NO')
        Socket.Desconectar
        Socket.Terminar
        Message('Termina Conexión con el MAE')
      endif

      Message('Control de Flujo Cancelado. Corrió '~FStr(Val(x:1),0,0)~' veces.')

      *** Actualizo fecha y hora baja online MAE
      ACT(h1, SQLAhora)
      SQL.ADD("Update "~DBO~".VARIABLES    ")
      SQL.ADD("   Set Valor  = "~Val(h1)~" ")
      SQL.ADD(" where Codigo = 'ONLIMABA'  ")
      SQL.NEW

      if EqStr(Var('ONLINEMAE'),'SI')
        SQL.ADD("Update "~DBO~".VARIABLES    ")
        SQL.ADD("   Set Valor  = 'NO'        ") 
        SQL.ADD(" where Codigo = 'ONLINEMAE' ")
        SQL.NEW
      endif

      SQL.EXEC

      Message('Sale en vuelta '~Fstr(Val(x:1),1,0))
      Break
    endif

    *** Actualizo fecha y hora ultimo ciclo online MAE
    ACT(h1, SQLAhora)
    SQL.ADD("Update "~DBO~".VARIABLES    ")
    SQL.ADD("   Set Valor  = "~Val(h1)~" ")
    SQL.ADD(" where Codigo = 'ONLIMAUL'  ")
    SQL.NEW
    SQL.EXEC

    *  Message('Casi Fin vuelta '~Fstr(Val(x:1),1,0))
    Esperar2(Val(z1))  

  Message('Fin vuelta '~Fstr(Val(x:1),1,0))
  
proximo

MessageBox('Evento ONLMAE finalizo correctamente')
