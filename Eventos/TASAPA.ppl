**-- TASAPA: Carga de Tasas no Existentes -Vinculadas
* HOJAVISIBLE(SI)
CrearDialogo
  Fecha1     : "Fecha Desde"        ;;;;;;Dialogo.Fecha1<>0 and Dialogo.Fecha1<Fsys;'Debe Ingresar la Fecha Desde';NO;HABILES(Fsys,-1,'ARG',SI)
  Fecha2     : "Fecha Hasta"        ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta';NO;Fsys
  Vehiculo1  : 'Vehiculo1'          ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo Colocador es Invalido';NO;
  Vehiculo2  : 'Vehiculo2'          ;;;;;;NOVACIO(Dialogo.Vehiculo2) y [Incluido(Dialogo.Vehiculo2, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo Tomador es Invalido';NO;;;;
  Especie1   : 'Moneda'             ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;
  Precio1    : 'Tasa'               ;;;;;;Dialogo.Precio1<>0;'Tasa Incorrecta';NO;;
  String     : 'ListaEspecies'      ;;;;NO;NO;NoVacio(Dialogo.String);'No Existe el Par de Vehiculos';NO;;SQL("SELECT ListaEspecies FROM "~DBO~".PARESVEHICULO  Where Estado='HAB' and ((Vehiculo1='"~Dialogo.Vehiculo1~"' and Vehiculo2='"~Dialogo.Vehiculo2~"') or (Vehiculo1='"~Dialogo.Vehiculo2~"' and Vehiculo2='"~Dialogo.Vehiculo1~"')) ")
FinDialogo

if Not Ok
  Cancelar
endif

*- Verifico que la Especie este Habilitada
If Not Incluido(Dialogo.Especie1,Dialogo.String)
   Cancelar('La Especie no esta habilitada para el par de Vehiculos')
EndIf

SetFilaActual(1)

ACD(af1,Dialogo.Fecha1)

* H2 Contador de Sin Saldo
ACN(H2,1)

ACN(aa2,DifDias(Dialogo.Fecha1,Dialogo.Fecha2,'ARG',SI))  

Recorrer&i 1,Val(aa2)+1

   *-- Verifico que la Tasa para Ese Dia no haya sido Creada 
   ACN(a1,0)
   ACN(a1,SQL("SELECT Tasa from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~Dialogo.Vehiculo1~"' and Vehiculo2='"~Dialogo.Vehiculo2~"') or (Vehiculo1='"~Dialogo.Vehiculo2~"' and Vehiculo2='"~Dialogo.Vehiculo1~"')) and Especie ='"~Dialogo.Especie1~"' and Fecha='"~IdxDate(val(af1))~"' "))

   If val(a1)=0 
      Message('Creando Tasa : '~Val(af1)~' ...')     
      SQL.ADD("INSERT INTO "~DBO~".TASASVEHICULO ")
      SQL.ADD(" (Fecha,Vehiculo1,Vehiculo2,")
      SQL.ADD(" Especie,Tasa) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~IdxDate(val(af1))~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Vehiculo2~"', ")
      SQL.ADD(" '"~Dialogo.Especie1~"',"~Fstr(Dialogo.Precio1,0,5)~") ")
      SQL.NEW
      SQL.EXEC
   Else 
      Break
   EndIf

   ACD(af1,HABILES(val(af1),1,'ARG',SI))   
Proximo

If val(a1)<>0
   Cancelar(' El par de Vehiculos Ya tenia tasa para el Dia '~val(af1)~' ....!')
EndIf
