*ACT(z:2, TRIM(MIRT(Val(z:1)))~' Mesa: '~TRIM(MIRT(Dialogo.String1))~' //')
ACT(z:3, FECHA(FSYS)~' '~Hora(SQL("SELECT GETDATE()")))
ACT(z:2, TRIM(MIRT(Val(z:1)))~' Mesa '~val(z3)~' : '~TRIM(MIRT(Dialogo.String1))~' //')

SQL.ADD(" UPDATE "~DBO~".ORDENES  ")
SQL.ADD(" SET Observaciones =  '"~Val(z:2)~"' ")
