   String2:  ''              ;3;1;;NO;;;;;COPY(BuscarCampo('ORDENES','Observaciones','NrOrden',Val(a:1)), 51,100);;;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
   String3:  ''              ;4;1;;NO;;;;;COPY(BuscarCampo('ORDENES','Observaciones','NrOrden',Val(a:1)),101,150);;;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
   String4:  ''              ;5;1;;NO;;;;;COPY(BuscarCampo('ORDENES','Observaciones','NrOrden',Val(a:1)),151,250);;;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
   String1:  'Observaciones' ;6;1;;  ;;;;;                                                                 ;;;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
