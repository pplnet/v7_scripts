*HojaVisible(si)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'       ;1;1; ;  ;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1<=FSys;'Fecha Invalida';NO;FSys;
  Cliente1 : 'Cliente'     ; ; ; ;  ;;;;;;;;;;"SUBSTRING(Jerarquia,4,6) <> '000000' and (Jerarquia like ('"~VAR('JERVINCULA')~"%') or Jerarquia like ('"~VAR('JERCLIENTE')~"%') or Vinculado='SI') "
  Radio2   : "|Impresora|Pantalla|PDF" ;;;;;;;;;2;;;;;  
FinDialogo

if not ok
  Cancelar
endif

SQL.ADD(" Select O.NrOperacion, O.Cliente1 ")
SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("Where O.FechaOp ="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("  and O.Cliente1=C.Codigo ")
SQL.ADD("  and O.TipoOp in ('TIC','TIV') ")
SQL.ADD("  and (C.Jerarquia like ('"~VAR('JERVINCULA')~"%') or C.Jerarquia like ('"~VAR('JERCLIENTE')~"%') or Vinculado='SI')")
SQL.ADD("  and OB.NrOperacion=o.NrOperacion and OB.Valor=1 ")
SQL.ADD("  and OB.NrBit in(10,70) ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1='"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("  ORDER BY O.Cliente1, O.TipoOp ")
watch(SQL.BATCH())
ACN(op:1,0)

Recorrer SQL
    LinkearHoja('GENCON', 1, NrOperacion1=fbn['NrOperacion'], Radio1=0, Radio2=Dialogo.Radio2)
    LinkearHoja('GENCON', 1, NrOperacion1=fbn['NrOperacion'], Radio1=1, Radio2=Dialogo.Radio2)
    SCN(op:1,1)
Proximo

Messagebox('Operaciones Concertadas : '~PYC(Val(op:1),0,0))
