CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;;;;
  String1     : 'BOperacion';;;;;;;;;
  Fecha1      : 'Fecha'     ;;;;;;Dialogo.Fecha1>=0 o Dialogo.Fecha1>=FSys;'Debe ingresar una Fecha valida';NO;FSys
  Radio1      : 'Tipo|Alta|Baja';;;;;;;;;0
  Check1      : 'Procesa'   ;;;;NO;SI;;;;1
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a1, 'NrOperacion')
ACT(a2, 'TipoOp')
ACT(a3, 'Cliente')
ACT(a4, 'Especie')
ACT(a5, 'FechaOp')
ACT(a6, 'FechaVto')
ACT(a7, 'Vehiculo')
ACT(a8, 'Accion')

ACT(a10, 'D.NrOp')
ACT(a11, 'D.Fecha1')
ACT(a12, 'D.Radio1')
ACT(a13, 'D.Check1')

SetFilaActual(1)
ACT(aa:1, 'NrOperacion')
ACT(ab:1, 'TipoOp')
ACT(ac:1, 'FechaOp')
ACT(ad:1, 'FechaVto')
ACT(ae:1, 'Especie')
ACT(af:1, 'Cantidad')
ACT(ag:1, 'Precio1')
ACT(ah:1, 'FUltCupon')
ACT(ai:1, 'FechaDesde')
ACT(aj:1, 'Plazo')
ACT(ak:1, 'Base')
ACT(al:1, 'Ints.Lineal')

ACT(am:1, 'Afectado')
ACT(an:1, 'Pendiente')
ACT(ao:1, 'F.Ult.Mov')
ACT(ap:1, 'F.Anterior')
ACT(aq:1, 'TC UltAct')
ACT(ar:1, 'Afect.UltAct')
ACT(as:1, 'TC')
ACT(at:1, 'Afect.Rev')
ACT(au:1, 'Dif.Afect')
ACT(av:1, 'Accion')
ACT(aw:1, 'F.Desaf.Reval')

ACT(ba:1, 'Dev.Norm')
ACT(bb:1, 'Dev.Comp')
ACT(bc:1, 'Dev.Puni')
ACT(bd:1, 'Total Dev')
ACT(be:1, 'TC')
ACT(bf:1, 'Total ARP')
ACT(bg:1, 'Accion')
ACT(bh:1, 'F.Desaf.')

ACT(bj:1, 'Com.Norm.')
ACT(bk:1, 'Com.Comp.')
ACT(bl:1, 'Total Com.')
ACT(bm:1, 'Total ARP')
ACT(bn:1, 'Accion')

ACT(ca:1, 'Sum A Anular')
ACT(cb:1, 'Afec.Calc')
ACT(cc:1, 'Afectacion')

ACT(cz:1, 'Intereses')
ACT(da:1, 'Afectado')
ACT(db:1, 'Pendiente')
ACT(dc:1, 'F.Ult.Mov')
ACT(dd:1, 'F.Anterior')
ACT(de:1, 'TC UltAct')
ACT(df:1, 'Afect.UltAct')
ACT(dg:1, 'TC')
ACT(dh:1, 'Afect.Rev')
ACT(di:1, 'Dif.Afect')
ACT(dj:1, 'Accion')
ACT(dk:1, 'F.Desaf.Reval')

ACT(dz:1, 'Comisiones')
ACT(ea:1, 'Afectado')
ACT(eb:1, 'Pendiente')
ACT(ec:1, 'F.Ult.Mov')
ACT(ed:1, 'F.Anterior')
ACT(ee:1, 'TC UltAct')
ACT(ef:1, 'Afect.UltAct')
ACT(eg:1, 'TC')
ACT(eh:1, 'Afect.Rev')
ACT(ei:1, 'Dif.Afect')
ACT(ej:1, 'Accion')
ACT(ek:1, 'F.Desaf.Reval')

ACT(b:10, Dialogo.NrOperacion1)
ACD(b:11, Dialogo.Fecha1)
ACN(b:12, Dialogo.Radio1)
ACN(b:13, Dialogo.Check1)

if Dialogo.Radio1=0
  SQL.ADD("SELECT * from "~DBO~".OPERACIONES")
  SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
else
  if NoVacio(Dialogo.NrOperacion1)
    SQL.ADD("SELECT * from "~DBO~".BOPERACIONES")
    SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  else
    SQL.ADD("SELECT * from "~DBO~".BOPERACIONES")
    SQL.ADD("where NrOperacion = '"~Copy(Dialogo.String1,1,8)~"' ")
  endif
endif
recorrer SQL
  DFA
  ACT(b1, fbn('NrOperacion'))
  ACT(b2, fbn('TipoOp'))
  ACT(b3, fbn('Cliente1'))
  ACT(b4, fbn('Especie'))
  ACD(b5, fbn('FechaOp'))
  ACD(b6, fbn('FechaVto'))
  ACT(b7, fbn('Vehiculo1'))
  if Not EqStr(fbn('Vehiculo1'),Var('VEHICULODE'))
    MessageBox('La operacion no es de '~Var('VEHICULODE'))
    ACN(v1, 1)
    Break
  endif
proximo
if NoVacio(Val(b1))
  SQL.ADD("SELECT * from "~DBO~".OPERACIONES")
  if NoVacio(Dialogo.NrOperacion1)
    SQL.ADD("where NrOperacion <> '"~Dialogo.NrOperacion1~"' ")
  else
    SQL.ADD("where NrOperacion <> '"~Copy(Dialogo.String1,1,8)~"' ")
  endif
  SQL.ADD("  and Cliente1    =  '"~Val(b3)~"' ")
  SQL.ADD("  and FechaOp     <= '"~IdxDate(Val(b5))~"' ")
  SQL.ADD("  and (FechaPrecan is Null or FechaPrecan > '"~IdxDate(Dialogo.Fecha1)~"') ")
  SQL.ADD("  and Vehiculo1   =  '"~Val(b7)~"' ")
  SQL.ADD("  and ((TipoOp in ('PMU','PME') and CB6 <>  '1')    ")
  SQL.ADD("    or (TipoOp in ('MMCO','TICO') and FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' )) ")
  SQL.ADD("  order by NrOperacion ")

  recorrer SQL
    ACT(aa:FAC, fbn('NrOperacion'))
    ACT(ab:FAC, fbn('TipoOp'))
    ACD(ac:FAC, fbn('FechaOp'))
    ACD(ad:FAC, fbn('FechaVto'))
    ACT(ae:FAC, fbn('Especie'))
    ACN(af:FAC, fbn('Cantidad'))
    ACN(ag:FAC, fbn('Precio1'))
    ACD(ah:FAC, fbn('FechaUltCupon'))
    if fbn('FechaUltCupon')>0
      ACD(ai:FAC, fbn('FechaUltCupon'))
    else
      ACD(ai:FAC, fbn('FechaOp'))
    endif
    ACN(aj:FAC, Dialogo.Fecha1-Val(ai:FAC))
    ACN(ak:FAC, fbn('DiasAnio'))
    ACN(al:FAC, Val(af:FAC)*Val(ag:FAC)*Val(aj:FAC)/(iif(Val(ak:FAC)=0,360,365)*100))
    SQL.ADD("SELECT Bits,Monto,FechaMov from "~DBO~".MOVLIMITES")
    SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
    SQL.ADD("  and Limite        = 'BCRAN' ")
    SQL.ADD("order by FechaMov")
    recorrer SQL



      DFA
      if EqStr(fbn('Bits'),'P')
        SCN(am:FAC, fbn('Monto'))
        ACD(ao:FAC, fbn('FechaMov'))
      else
        SCN(an:FAC, fbn('Monto'))
      endif
      if fbn('FechaMov')<Dialogo.Fecha1
        ACD(ap:FAC, fbn('FechaMov'))
      endif
    proximo
    ACN(aq:FAC, CotizacionC(Val(ae:FAC),,,,Val(ai:FAC)-1,1,SI,'ARP'))
    ACN(ar:FAC, Val(am:FAC)/Val(aq:FAC))
    ACN(as:FAC, CotizacionC(Val(ae:FAC),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
    ACN(at:FAC, Val(ar:FAC)*Val(as:FAC))
    ACN(au:FAC, Val(at:FAC)-Val(am:FAC))
    * Intereses
    ACT(cz:FAC, fbn('NrOperacion'))
    SQL.ADD("SELECT Bits,Monto,FechaMov from "~DBO~".MOVLIMITES")
    SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
    SQL.ADD("  and Limite        = 'ACIDN' ")
    SQL.ADD("order by FechaMov")
    recorrer SQL

      DFA
      if EqStr(fbn('Bits'),'P')
        SCN(da:FAC, fbn('Monto'))
        ACD(dc:FAC, fbn('FechaMov'))
      else
        SCN(db:FAC, fbn('Monto'))
      endif
      if fbn('FechaMov')<Dialogo.Fecha1
        ACD(dd:FAC, fbn('FechaMov'))
      endif
    proximo
    ACN(de:FAC, CotizacionC(Val(ae:FAC),,,,Val(ai:FAC)-1,1,SI,'ARP'))
    ACN(df:FAC, Val(da:FAC)/Val(de:FAC))
    ACN(dg:FAC, CotizacionC(Val(ae:FAC),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
    ACN(dh:FAC, Val(df:FAC)*Val(dg:FAC))
    ACN(di:FAC, Val(dh:FAC)-Val(da:FAC))
    * Comisiones
    ACT(dz:FAC, fbn('NrOperacion'))
    SQL.ADD("SELECT Bits,Monto,FechaMov from "~DBO~".MOVLIMITES")
    SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
    SQL.ADD("  and Limite        = 'ACCON' ")
    SQL.ADD("order by FechaMov")
    recorrer SQL

      DFA
      if EqStr(fbn('Bits'),'P')
        SCN(ea:FAC, fbn('Monto'))
        ACD(ec:FAC, fbn('FechaMov'))
      else
        SCN(eb:FAC, fbn('Monto'))
      endif
      if fbn('FechaMov')<Dialogo.Fecha1
        ACD(ed:FAC, fbn('FechaMov'))
      endif
    proximo
    ACN(ee:FAC, CotizacionC(Val(ae:FAC),,,,Val(ai:FAC)-1,1,SI,'ARP'))
    ACN(ef:FAC, Val(ea:FAC)/Val(ee:FAC))
    ACN(eg:FAC, CotizacionC(Val(ae:FAC),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
    ACN(eh:FAC, Val(ef:FAC)*Val(eg:FAC))
    ACN(ei:FAC, Val(eh:FAC)-Val(ea:FAC))
    **************************
    * Es por Alta de Operacion
    **************************
    if Dialogo.Radio1=0

      if Val(au:FAC)<-0.01 o Val(au:FAC)>0.01

        **************************
        ACT(av:FAC, 'Gen.Afect Reval Cap.')
        **************************
        if Dialogo.Check1=1
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~fbn('Cliente1')~"', ")
          SQL.ADD(" 'BCRAN', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(au:FAC),0,2)~", ")
          SQL.ADD(" '"~Val(aa:FAC)~"', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Cap.', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          if Incluido(Val(ab:FAC),'MMCO|TICO|FXC|FXCT')
            * Movimiento de Desafectacion
            SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
            SQL.ADD("  FechaMov,    Cliente,   Limite, ")
            SQL.ADD("  Especie,     Monto,     NrOperacion, ")
            SQL.ADD("  Descripcion, Bits,      Vehiculo ")
            SQL.ADD(") values (")
            SQL.ADD(" '"~IdxDate(Habiles(Val(ad:FAC),1,'ARG'))~"', ")
            SQL.ADD(" '"~fbn('Cliente1')~"', ")
            SQL.ADD(" 'BCRAN', ")
            SQL.ADD(" 'ARP', ")
            SQL.ADD(" "~FStr(-Val(au:FAC),0,2)~", ")
            SQL.ADD(" '"~Val(aa:FAC)~"', ")
            SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Cap.', ")
            if Habiles(Val(ad:FAC),1,'ARG')<=FSys
              SQL.ADD(" 'P', ")
            else
              SQL.ADD(" 'N', ")
            endif
            SQL.ADD(" '"~Val(b7)~"' ")
            SQL.ADD(" )")
            SQL.NEW
          endif
          SQL.EXEC
        endif
      endif
      * Suma de Interses Normales devengados
      SQL.ADD("SELECT Sum(Monto) as Dev from "~DBO~".MOVDEVENGADOS")
      SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and TipoDevengado =  'INTLEN' ")
      SQL.ADD("  and NrSaldo       =  140 ")
      SQL.ADD("  and Fecha         >= '"~IdxDate(Val(ai:FAC))~"' ")
      SQL.ADD("  and Fecha         <  '"~IdxDate(Dialogo.Fecha1)~"' ")
      recorrer SQL
        DFA
        ACN(ba:FAC, fbn('Dev'))
      proximo
      * Suma de Interses Compensatorios devengados
      SQL.ADD("SELECT Sum(Monto) as Dev from "~DBO~".MOVDEVENGADOS")
      SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and TipoDevengado =  'INTLEN' ")
      SQL.ADD("  and NrSaldo       =  150 ")
      SQL.ADD("  and Fecha         >= '"~IdxDate(Val(ai:FAC))~"' ")
      SQL.ADD("  and Fecha         <  '"~IdxDate(Dialogo.Fecha1)~"' ")
      recorrer SQL
        DFA
        ACN(bb:FAC, fbn('Dev'))
      proximo
      * Suma de Interses Punitorios devengados
      SQL.ADD("SELECT Sum(Monto) as Dev from "~DBO~".MOVDEVENGADOS")
      SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and TipoDevengado =  'INTLEN' ")
      SQL.ADD("  and NrSaldo       =  160 ")
      SQL.ADD("  and Fecha         >= '"~IdxDate(Val(ai:FAC))~"' ")
      SQL.ADD("  and Fecha         <  '"~IdxDate(Dialogo.Fecha1)~"' ")
      recorrer SQL
        DFA
        ACN(bc:FAC, fbn('Dev'))
      proximo
      ACN(bd:FAC, Val(ba:FAC)+Val(bb:FAC)+Val(bc:FAC))
      ACN(be:FAC, CotizacionC(Val(ae:FAC),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
      ACN(bf:FAC, Val(bd:FAC)*Val(be:FAC))
      if Val(bf:FAC)>0
        **************************
        ACT(bg:FAC, 'Gen.Afect Ints. Dev.')
        **************************
        if Dialogo.Check1=1
          SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
          SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
          SQL.ADD("and    Limite      = 'ACIDN' ")
          SQL.ADD("and    Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
          SQL.NEW
          SQL.EXEC
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~fbn('Cliente1')~"', ")
          SQL.ADD(" 'ACIDN', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(bf:FAC),0,2)~", ")
          SQL.ADD(" '"~Val(aa:FAC)~"', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          if Incluido(Val(ab:FAC),'MMCO|TICO|FXC|FXCT')
            * Movimiento de Desafectacion
            SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
            SQL.ADD("  FechaMov,    Cliente,   Limite, ")
            SQL.ADD("  Especie,     Monto,     NrOperacion, ")
            SQL.ADD("  Descripcion, Bits,      Vehiculo ")
            SQL.ADD(") values (")
            SQL.ADD(" '"~IdxDate(Habiles(Val(ad:FAC),1,'ARG'))~"', ")
            SQL.ADD(" '"~fbn('Cliente1')~"', ")
            SQL.ADD(" 'ACIDN', ")
            SQL.ADD(" 'ARP', ")
            SQL.ADD(" "~FStr(-Val(bf:FAC),0,2)~", ")
            SQL.ADD(" '"~Val(aa:FAC)~"', ")
            SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
            if Habiles(Val(ad:FAC),1,'ARG')<=FSys
              SQL.ADD(" 'P', ")
            else
              SQL.ADD(" 'N', ")
            endif
            SQL.ADD(" '"~Val(b7)~"' ")
            SQL.ADD(" )")
            SQL.NEW
          endif
          SQL.EXEC
        endif
      endif
      if Val(di:FAC)<-0.01 o Val(di:FAC)>0.01
        **************************
        ACT(dj:FAC, 'Gen.Afect Reval Ints.')
        **************************
        if Dialogo.Check1=1
          if Val(bf:FAC)<=0
            SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
            SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
            SQL.ADD("and    Limite      = 'ACIDN' ")
            SQL.ADD("and    Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
            SQL.NEW
            SQL.EXEC
          endif
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~fbn('Cliente1')~"', ")
          SQL.ADD(" 'ACIDN', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(di:FAC),0,2)~", ")
          SQL.ADD(" '"~Val(aa:FAC)~"', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Ints.', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          if Incluido(Val(ab:FAC),'MMCO|TICO|FXC|FXCT')
            * Movimiento de Desafectacion
            SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
            SQL.ADD("  FechaMov,    Cliente,   Limite, ")
            SQL.ADD("  Especie,     Monto,     NrOperacion, ")
            SQL.ADD("  Descripcion, Bits,      Vehiculo ")
            SQL.ADD(") values (")
            SQL.ADD(" '"~IdxDate(Habiles(Val(ad:FAC),1,'ARG'))~"', ")
            SQL.ADD(" '"~fbn('Cliente1')~"', ")
            SQL.ADD(" 'ACIDN', ")
            SQL.ADD(" 'ARP', ")
            SQL.ADD(" "~FStr(-Val(di:FAC),0,2)~", ")
            SQL.ADD(" '"~Val(aa:FAC)~"', ")
            SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Ints.', ")
            if Habiles(Val(ad:FAC),1,'ARG')<=FSys
              SQL.ADD(" 'P', ")
            else
              SQL.ADD(" 'N', ")
            endif
            SQL.ADD(" '"~Val(b7)~"' ")
            SQL.ADD(" )")
            SQL.NEW
          endif
          SQL.EXEC
        endif
      endif
      * Suma de Comisiones devengadas
      SQL.ADD("SELECT Sum(Monto) as Dev from "~DBO~".MOVDEVENGADOS")
      SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and TipoDevengado =  'COMIS' ")
      SQL.ADD("  and NrSaldo       =  180 ")
      SQL.ADD("  and Fecha         >= '"~IdxDate(Val(ai:FAC))~"' ")
      SQL.ADD("  and Fecha         <  '"~IdxDate(Dialogo.Fecha1)~"' ")
      recorrer SQL
        DFA
        ACN(bj:FAC, fbn('Dev'))
      proximo
      * Suma de Comisiones devengadas
      SQL.ADD("SELECT Sum(Monto) as Dev from "~DBO~".MOVDEVENGADOS")
      SQL.ADD("where NrOperacion   =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and TipoDevengado =  'COMIS' ")
      SQL.ADD("  and NrSaldo       =  190 ")
      SQL.ADD("  and Fecha         >= '"~IdxDate(Val(ai:FAC))~"' ")
      SQL.ADD("  and Fecha         <  '"~IdxDate(Dialogo.Fecha1)~"' ")
      recorrer SQL
        DFA
        ACN(bk:FAC, fbn('Dev'))
      proximo
      ACN(bl:FAC, Val(bj:FAC)+Val(bk:FAC))
      ACN(bm:FAC, Val(bl:FAC)*Val(be:FAC))
      if Val(bm:FAC)>0
        **************************
        ACT(bn:FAC, 'Gen.Afect Com.')
        **************************
        if Dialogo.Check1=1
          SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
          SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
          SQL.ADD("and    Limite      = 'ACCON' ")
          SQL.ADD("and    Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
          SQL.NEW
          SQL.EXEC
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~fbn('Cliente1')~"', ")
          SQL.ADD(" 'ACCON', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(bm:FAC),0,2)~", ")
          SQL.ADD(" '"~Val(aa:FAC)~"', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          if Incluido(Val(ab:FAC),'MMCO|TICO|FXC|FXCT')
            * Movimiento de Desafectacion
            SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
            SQL.ADD("  FechaMov,    Cliente,   Limite, ")
            SQL.ADD("  Especie,     Monto,     NrOperacion, ")
            SQL.ADD("  Descripcion, Bits,      Vehiculo ")
            SQL.ADD(") values (")
            SQL.ADD(" '"~IdxDate(Habiles(Val(ad:FAC),1,'ARG'))~"', ")
            SQL.ADD(" '"~fbn('Cliente1')~"', ")
            SQL.ADD(" 'ACCON', ")
            SQL.ADD(" 'ARP', ")
            SQL.ADD(" "~FStr(-Val(bm:FAC),0,2)~", ")
            SQL.ADD(" '"~Val(aa:FAC)~"', ")
            SQL.ADD(" '"~Dialogo.NrOperacion1~"', ")
            if Habiles(Val(ad:FAC),1,'ARG')<=FSys
              SQL.ADD(" 'P', ")
            else
              SQL.ADD(" 'N', ")
            endif
            SQL.ADD(" '"~Val(b7)~"' ")
            SQL.ADD(" )")
            SQL.NEW
          endif
          SQL.EXEC
        endif
      endif
      if Val(ei:FAC)<-0.01 o Val(ei:FAC)>0.01
        ACT(ej:FAC, 'Gen.Afect Reval Com.')
        if Dialogo.Check1=1
          if Val(bm:FAC)<=0
            SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
            SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
            SQL.ADD("and    Limite      = 'ACCON' ")
            SQL.ADD("and    Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
            SQL.NEW
            SQL.EXEC
          endif
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~fbn('Cliente1')~"', ")
          SQL.ADD(" 'ACCON', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(ei:FAC),0,2)~", ")
          SQL.ADD(" '"~Val(aa:FAC)~"', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Com.', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          if Incluido(Val(ab:FAC),'MMCO|TICO|FXC|FXCT')
            * Movimiento de Desafectacion
            SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
            SQL.ADD("  FechaMov,    Cliente,   Limite, ")
            SQL.ADD("  Especie,     Monto,     NrOperacion, ")
            SQL.ADD("  Descripcion, Bits,      Vehiculo ")
            SQL.ADD(") values (")
            SQL.ADD(" '"~IdxDate(Habiles(Val(ad:FAC),1,'ARG'))~"', ")
            SQL.ADD(" '"~fbn('Cliente1')~"', ")
            SQL.ADD(" 'ACCON', ")
            SQL.ADD(" 'ARP', ")
            SQL.ADD(" "~FStr(-Val(ei:FAC),0,2)~", ")
            SQL.ADD(" '"~Val(aa:FAC)~"', ")
            SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. Com.', ")
            if Habiles(Val(ad:FAC),1,'ARG')<=FSys
              SQL.ADD(" 'P', ")
            else
              SQL.ADD(" 'N', ")
            endif
            SQL.ADD(" '"~Val(b7)~"' ")
            SQL.ADD(" )")
            SQL.NEW
          endif
          SQL.EXEC
        endif
      endif
      if Dialogo.Fecha1>Val(ai:FAC)
        ACT(ax:FAC, 'Act.Op.')
        ACD(ay:FAC, Dialogo.Fecha1)
        if Dialogo.Check1=1
          SQL.ADD("UpDate "~DBO~".OPERACIONES ")
          SQL.ADD("Set FechaUltCupon  = '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    endif
    **************************
    * Es por Baja de Operacion
    **************************
    if Dialogo.Radio1=1
      SQL.ADD("Select Monto from "~DBO~".MOVLIMITES ")
      SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and  Limite      in ('BCRAN','ACIDN','ACCON') ")
      if NoVacio(Dialogo.NrOperacion1)
        SQL.ADD("  and  Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
      else
        SQL.ADD("  and  Descripcion Like '"~Copy(Dialogo.String1,1,8)~"%' ")
      endif
      recorrer SQL
        DFA
        SCN(bz:FAC, 1)
        SCN(ca:FAC, -fbn('Monto'))
      proximo
      SCN(g:1, Val(bz:FAC))
      ACN(cb:FAC, Val(am:FAC)+Val(ca:FAC))
      if Dialogo.Check1=1
        SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
        SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
        SQL.ADD("  and  Limite      in ('BCRAN','ACIDN','ACCON') ")
        if NoVacio(Dialogo.NrOperacion1)
          SQL.ADD("  and  Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
        else  
          SQL.ADD("  and  Descripcion Like '"~Copy(Dialogo.String1,1,8)~"%' ")
        endif
        SQL.NEW
        SQL.EXEC
      endif
      SQL.ADD("SELECT Monto from "~DBO~".MOVLIMITES")
      SQL.ADD("where NrOperacion =  '"~Val(aa:FAC)~"' ")
      SQL.ADD("  and Limite      in ('BCRAN','ACIDN','ACCON') ")
      SQL.ADD("order by FechaMov")
      recorrer SQL
        DFA
        SCN(cc:FAC, fbn('Monto'))
      proximo
      if Val(bz:FAC)>0
        ACD(cd:FAC, Val(ap:FAC))
        if Val(dd:FAC)>Val(cd:FAC)
          ACD(cd:FAC, Val(dd:FAC))
        endif
        if Val(ed:FAC)>Val(cd:FAC)
          ACD(cd:FAC, Val(ed:FAC))
        endif
        ACT(ce:FAC, 'Act.Op.')
        if Val(cd:FAC)>Val(ac:FAC)
          ACD(cf:FAC, Val(cd:FAC))
          if Dialogo.Check1=1
            SQL.ADD("UpDate "~DBO~".OPERACIONES ")
            SQL.ADD("Set FechaUltCupon  = '"~IdxDate(Val(cd:FAC))~"' ")
            SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
            SQL.NEW
            SQL.EXEC
          endif
        else
          ACT(cf:FAC, 'Null')
          if Dialogo.Check1=1
            SQL.ADD("UpDate "~DBO~".OPERACIONES ")
            SQL.ADD("Set FechaUltCupon  = Null ")
            SQL.ADD("where  NrOperacion = '"~Val(aa:FAC)~"' ")
            SQL.NEW
            SQL.EXEC
          endif
        endif
      endif
    endif
  proximo
  ****************************************
  * Revaluo de Asistencia por Contabilidad
  ****************************************
  * Es por Alta de Operacion
  **************************
  if Dialogo.Radio1=0
    ACN(fa:1, LimConsumido(Val(b3),'ACMAN','ARP',0,Val(b7),,,,Dialogo.Fecha1))
    if Val(fa:1)>0.01
      SQL.ADD("SELECT * from "~DBO~".LIMCONSUMIDOS")
      SQL.ADD("where Limite   = 'ACVN' ")
      SQL.ADD("  and Cliente  = '"~Val(b3)~"' ")
      SQL.ADD("order by Especie")
      recorrer SQL
        DFA
        SCN(fz:1, 1)
        ACT(fe:Val(fz:1), fbn('Especie'))
        ACN(ff:Val(fz:1), LimConsumido(Val(b3),'ACVN',Val(fe:Val(fz:1)),0,Val(b7),,,,Dialogo.Fecha1))
        ACN(fg:Val(fz:1), CotizacionC(Val(fe:Val(fz:1)),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
        ACN(fh:Val(fz:1), Val(ff:Val(fz:1))*Val(fg:Val(fz:1)))
        SCN(fb:1, Val(fh:Val(fz:1)))
      proximo
      ACN(fc:1, Val(fb:1)-Val(fa:1))
      if Val(fc:1)>0.01 o Val(fc:1)<-0.01
        ACT(fd:1, 'Revaluo Contable')
        if Dialogo.Check1=1
          * Movimiento de Afectacion
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("  FechaMov,    Cliente,   Limite, ")
          SQL.ADD("  Especie,     Monto,     NrOperacion, ")
          SQL.ADD("  Descripcion, Bits,      Vehiculo ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD(" '"~Val(b3)~"', ")
          SQL.ADD(" 'ACMAN', ")
          SQL.ADD(" 'ARP', ")
          SQL.ADD(" "~FStr(Val(fc:1),0,2)~", ")
          SQL.ADD(" 'CONTABLE', ")
          SQL.ADD(" '"~Dialogo.NrOperacion1~" Reval. As.Cont.', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~Val(b7)~"' ")
          SQL.ADD(" )")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    endif
  endif
  **************************
  * Es por Baja de Operacion
  **************************
  if Dialogo.Radio1=1
    if Dialogo.Check1=1
      SQL.ADD("Delete from "~DBO~".MOVLIMITES ")
      SQL.ADD("where  NrOperacion = 'CONTABLE' ")
      SQL.ADD("  and  Limite      = 'ACMAN' ")
      if NoVacio(Dialogo.NrOperacion1)
        SQL.ADD("  and  Descripcion Like '"~Dialogo.NrOperacion1~"%' ")
      else  
        SQL.ADD("  and  Descripcion Like '"~Copy(Dialogo.String1,1,8)~"%' ")
      endif
      SQL.NEW
      SQL.EXEC
    endif
    ACT(ch:1, 'Movs.cap.')
    SQL.ADD("Select NrOperacion,Monto,Descripcion from "~DBO~".MOVLIMITES ")
    SQL.ADD("where  Limite      =  'BCRAN' ")
    SQL.ADD("and    Cliente     =  '"~Val(b3)~"' ")
    SQL.ADD("and    FechaMov    =  '"~IdxDate(Dialogo.Fecha1)~"' ")
    if NoVacio(Dialogo.NrOperacion1)
      SQL.ADD("and    NrOperacion <> '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("and    Descripcion Not Like '"~Dialogo.NrOperacion1~"%' ")
    else
      SQL.ADD("and    NrOperacion <> '"~Copy(Dialogo.String1,1,8)~"' ")
      SQL.ADD("and    Descripcion Not Like '"~Copy(Dialogo.String1,1,8)~"%' ")
    endif
    SQL.ADD("and    Descripcion Not Like 'Canc.%' ")
    SQL.ADD("order by NrOperacion ")
    recorrer SQL
      DFA
      SCN(h:1, 1)
      ACT(i:1, fbn('NrOperacion'))
      ACT(ci:Val(h:1), fbn('NrOperacion'))
      ACN(cj:Val(h:1), fbn('Monto'))
      ACT(ck:Val(h:1), fbn('Descripcion'))
    proximo
    if Val(h:1)>0
      ACT(j:1, 'Invoca Evento para operacion '~Val(i:1))
      if Dialogo.Check1=1
        EjecutarEvento('CALASI',NrOperacion1=Val(i:1),Fecha1=Dialogo.Fecha1,Radio1=0,Check1=Dialogo.Check1)
      endif
    endif
  endif
endif

SetFont(a1..a10,2)
SetFont(b1..b10,1)
SetFont(aa:1..ez:1,2)
SetFont(aa:2..ez:FAC,1)
SetFont(fa:1..fz:FAC,1)
if Val(fz:1)>FAC
  SetFont(fa:1..fz:Val(fz:1),1)
endif
if Val(h:1)>0
  ACN(db:Val(h:1)+2, Sum(db:1..db:Val(h:1)))
  SetFont(da:1..dz:Val(h:1),1)
  FormatoCeldas(db:1..db:Val(h:1)+2, Exe('F2'))
endif
FormatoCeldas(af:2..af:FAC, Exe('F2'))
FormatoCeldas(al:2..an:FAC, Exe('F2'))
FormatoCeldas(aq:2..aq:FAC, Exe('F7'))
FormatoCeldas(ar:2..av:FAC, Exe('F2'))
FormatoCeldas(as:2..as:FAC, Exe('F7'))
FormatoCeldas(ba:2..bf:FAC, Exe('F2'))
FormatoCeldas(be:2..be:FAC, Exe('F7'))
FormatoCeldas(ca:2..cc:FAC, Exe('F2'))
