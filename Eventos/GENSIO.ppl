*/Evento que Simula la llegada de Ofertas de OCT del MAE

if ExisteArchivo(VAR('PATHSIOPEL')~'GENOCT.txt')
   AbrirASCII(VAR('PATHSIOPEL')~'GENOCT.txt',0)
   MessageBox('Leyendo el archivo '~ VAR('PATHSIOPEL')~'GENOCT.txt')
else
 Cancelar('Error al Abrir el archivo '~ VAR('PATHSIOPEL')~'GENOCT.txt')
endif

Repetir

 SetFilaActual(2)
  ACT(a:fac, LeerAscii)
  if Vacio(Val(a:fac))
      break
  endif

 Message(val(a:fac))
 (.'GENOPSIOP'.)

Proximo
CerrarASCII
