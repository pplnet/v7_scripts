CrearDialogo
  NrOrden:   'NrOrden'         ;1;1;;;;
  TipoOrd1:  'TipoOrden'       ;2;1;;;;
  Fecha1:    'FechaOrden'      ;3;1;;;;
  Especie1:  'Especie'         ;4;1;;;;
  Cliente1:  'Cliente'         ;5;1;;;;
  Cantidad1: 'Cant.Ejecutada'  ;6;1;;;;
  Precio1:   'Precio Promedio' ;7;1;;;;
  String1:   'NrSecuencia'     ;8;1;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

If EqStr(Dialogo.TipoOrd1,'OEQC')
   ACT(TO:1,'EQC')
Else
   If EqStr(Dialogo.TipoOrd1,'OEQV')
      ACT(TO:1,'EQV')
   Else
      If EqStr(Dialogo.TipoOrd1,'CSEC')
         ACT(TO:1,'TIV')
      Else
         ACT(TO:1,'TIC')
      EndIf
   EndIf
EndIf

SQL.ADD(" Update "~DBO~".OPERACIONESBITS Set ")
SQL.ADD("  Valor = '0' ")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOrden~"' and NrBit=1 ")
SQL.NEW
SQL.EXEC

SQL.ADD(" Update "~DBO~".OPERACIONESBITS Set ")
SQL.ADD("  Valor = '1' ")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOrden~"' and NrBit=9 ")
SQL.NEW
SQL.EXEC

**** Genero la Operacion
SQL.ADD(" Select ContraEspecie, Mercado, Mercado2, Mercado3, Mercado4, Vehiculo, Operador, RB10, Book1, Plazo1, RB5, Cantidad3, TotalAux1, CB10 ")
SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~Dialogo.NrOrden~"' ")
Recorrer SQL
   If FBN['Cantidad3']=0
      SQL.ADD(" Update "~DBO~".ORDENES Set ")
      SQL.ADD("  Cantidad1   = "~FStr(Dialogo.Cantidad1,0,2)~", ")
      SQL.ADD("  Cantidad4   = "~FStr(Dialogo.Precio1,0,8)~" ")
      SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
      SQL.NEW
      SQL.EXEC
   EndIf
  
  ACD(FV:1,HABILES(Dialogo.Fecha1,FBN['Plazo1'],'ARG',SI))
  
  ACN(Z:4,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')) )
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'INV')
     ACN(Z:6,1/Val(Z:4))
  Else
     ACN(Z:6,Val(Z:4))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONELOCA')),'INV')
     ACN(Z:7,1/Val(Z:5))
  Else
     ACN(Z:7,Val(Z:5))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)),'INV')
     ACN(Z:8,1/CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)))
  Else
     ACN(Z:8,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)))
  EndIf
  
  ACN(Z:9,CotizacionC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
  
  If Incluido(Val(TO:1),'EQC|EQV')
     ACN(Z:3,(Dialogo.Cantidad1 * Dialogo.Precio1) * CotizacionC(FBN['ContraEspecie'],,,,FSYS,1,SI,VAR('MONEEXTR')) )
     ACN(Z:5,FBN['TotalAux1'])
     ACN(Z:24,Dialogo.Cantidad1*Dialogo.Precio1)
     
     If EqStr(FBN['Mercado3'],'BYMA')
        ACN(Z:16,MontoGastos(Val(TO:1),Dialogo.Especie1,FBN['Vehiculo'],'DMERC',0,4))
     Else
        ACN(Z:16,MontoGastos(Val(TO:1),Dialogo.Especie1,FBN['Vehiculo'],'DMTITU',0,4))
     EndIf
     
     If EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
        ACN(Z:17,0)
     Else
        If FBN['CB10'] <> 0
           ACN(Z:17,0)
        Else   
           ACN(Z:17,MontoArancelC(Val(TO:1),Dialogo.Cliente1,Dialogo.Especie1,FBN['Vehiculo'],'AOPER',0,4,'','','','',FBN['Mercado4'],'','','','','',SI))
        EndIf
     EndIf
     
     If Not EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
        ACN(Z:25,VAR('IVACOMACC'))
     Else
        ACN(Z:25,0)
     EndIf
     
     ACN(Z:22,(Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:16))/100)
     ACN(Z:26,(Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:17))/100)
     
     If EqStr(Val(TO:1),'EQC')
        ACN(Z:18,(Dialogo.Cantidad1*Dialogo.Precio1 + Val(Z:22) + Val(Z:26) + ((Val(Z:22)*Val(Z:25))/100) + ((Val(Z:26)*Val(Z:25))/100)))
     Else
        ACN(Z:18,(Dialogo.Cantidad1*Dialogo.Precio1 - Val(Z:22) - Val(Z:26) - ((Val(Z:22)*Val(Z:25))/100) - ((Val(Z:26)*Val(Z:25))/100)))
     EndIf
     
     SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
     SQL.ADD ("  Where Cliente='"~IIF(EqStr(FBN['Mercado2'],VAR('MERCARGC')) Y NoVacio(FBN['Mercado2']),VAR('CLIARGC'),Dialogo.Cliente1)~"' ")
     SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"%') ")
     SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
     SQL.ADD ("    And "~IIF(Not Incluido(FBN['Mercado2'],VAR('MERCARGC')),IIF(NoVacio(FBN['Mercado2'])," Mercado='"~FBN['Mercado2']~"' "," (Mercado is Null or Mercado ='') ")," Mercado in ('BCRA','AC','SWIFT') ")~" ")
     Recorrer SQL
       ACT(Z:11,FBN['Codigo'])
     Proximo
     
     SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
     SQL.ADD ("  Where Cliente='"~IIF(EqStr(FBN['Mercado'],VAR('MERCARGC')),FBN['Vehiculo'],Dialogo.Cliente1)~"' ")
     SQL.ADD ("    And (Especies='"~Dialogo.Especie1~"' OR Especies LIKE '%ACCION%') AND Estado='HAB' ")
     SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And Mercado='"~FBN['Mercado']~"' ")
     SQL.ADD (" Order by Codigo ASC ")
     Recorrer SQL
       ACT(Z:13,FBN['Codigo'])
     Proximo
     
     If EqStr(FBN['Mercado'],VAR('MERCARGC'))
        ACT(z10,Val(z13))
     Else
        ACT(z10,CuentaCliente(FBN['Vehiculo'],Dialogo.Especie1,,FBN['Mercado'],Val(TO:1),'HAB'))
     EndIf
     
     If EqStr(FBN['Mercado2'],VAR('MERCARGC'))
        ACT(z14,Val(z11))
     Else
        If NoVacio(FBN['Mercado2'])
           ACT(Z:14,CuentaCliente(FBN['Vehiculo'],FBN['ContraEspecie'],,FBN['Mercado2'],Val(TO:1),'HAB'))
        Else
           ACT(Z:14,SQL(" Select TOP 1 Codigo from "~DBO~".CUENTAS where Estado = 'HAB' and Cliente='"~FBN['Vehiculo']~"' and (Mercado is Null or Mercado ='') "))
        EndIf
     EndIf
     
     ACN(Z:15,COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,FBN['ContraEspecie']))
     
     If EqStr(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1))
        ACN(Z:19,Dialogo.Precio1)
     Else
        If EqStr(MODO(FBN['ContraEspecie'],BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)),'INV')
           ACN(Z:19,Dialogo.Precio1/FBN['TCbioPosUnidad'])
        Else
           ACN(Z:19,Dialogo.Precio1*FBN['TCbioPosUnidad'])
        EndIf
     EndIf
     If EqStr(FBN['ContraEspecie'], Var('MONELOCA'))
        ACN(Z:20,Dialogo.Precio1)
     Else
        If EqStr(MODO(FBN['ContraEspecie'],Var('MONELOCA')),'INV')
           ACN(Z:20 ,Dialogo.Precio1/FBN['TCbioPosUnidad'])
        Else
           ACN(Z:20,Dialogo.Precio1*FBN['TCbioPosUnidad'])
        EndIf
     EndIf
     
  Else   
     ACN(Z:5,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')) )
     IF Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Dialogo.Especie1),'CLE')
        ACN(Z:24,Dialogo.Cantidad1*Dialogo.Precio1*ValorTeorico2(Dialogo.Especie1,Val(FV:1)))
     Else
        ACN(Z:24,Dialogo.Cantidad1*Dialogo.Precio1)
     EndIf
     ACN(Z:18,Val(Z:24))
     
     ACT(Z:12,SQL(" Select CodOperador from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~Dialogo.Cliente1~"' and Estado='DEF' "))
  
     SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
     SQL.ADD ("  Where Cliente='"~IIF(EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado']~"' "),'SI'),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado']~"' "),Dialogo.Cliente1)~"' ")
     SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"%') ")
     SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
     SQL.ADD ("    And  "~IIF(Not EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado']~"' "),'SI')," Mercado='"~FBN['Mercado2']~"' "," Mercado in ('BCRA','AC','SWIFT') ")~" ")
     Recorrer SQL
       ACT(Z:11,FBN['Codigo'])
     Proximo
     
     SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
     SQL.ADD ("  Where Cliente='"~IIF(EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado']~"' "),'SI'),FBN['Vehiculo'],Dialogo.Cliente1)~"' ")
     SQL.ADD ("    And (Especies='"~Dialogo.Especie1~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' ")
     SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And Mercado='"~FBN['Mercado']~"' ")
     SQL.ADD (" Order by Codigo ASC ")
     Recorrer SQL
       ACT(Z:13,FBN['Codigo'])
     Proximo
     
     If EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado']~"' "),'SI')
        ACT(z10,Val(z13))
     Else
        ACT(z10,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Vehiculo']~"' and (Especies Like '%"~Dialogo.Especie1~"|%' OR Especies LIKE '%TITULO%|') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') AND Mercado='"~FBN['Mercado']~"' "~IIF(EqSTR(FBN['Mercado'],'CRYL'), "AND UPPER(Alias1) ='CP' ")~" ORDER BY Codigo ASC"))
     EndIf
     
     If EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~FBN['Mercado2']~"' "),'SI')
        ACT(z14,Val(z11))
     Else
        ACT(Z:14,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Vehiculo']~"' and (Especies Like '%MONEDA|%' or Especies Like '%"~FBN['ContraEspecie']~"|%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and  Mercado ='"~FBN['Mercado2']~"' "~IIF(EqSTR(FBN['Mercado2'],'CRYL'), "AND UPPER(Alias1) ='CP' ")~" "))
     EndIf
     
     ACT(Z:23,NrCupon2(Dialogo.Especie1,Val(FV:1)))
     
  EndIf
  
  If Incluido(Val(TO:1),'EQC|EQV')
     ACT(Z:2, GetNumerador(302))
     ACT(Z:21, GetNumerador(38))
  Else
     ACT(Z:2, GetNumerador(1))
  EndIf
  
  If FBN['Cantidad3']=0
     ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Dialogo.NrOrden~"' "))
     SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio) ")
     SQL.ADD(" Values ('"~Dialogo.NrOrden~"', '"~Val(Z:2)~"', "~FStr(Val(NE:1),0,0)~", '"~Dialogo.String1~"', "~SQLAhora~", '"~FStr(Dialogo.Cantidad1,0,2)~"', '"~FStr(Dialogo.Precio1,0,8)~"') ")
     SQL.NEW
     SQL.EXEC
  Else
     SQL.ADD(" Update "~DBO~".EJECUCIONES Set ")
     SQL.ADD("  Fecha = "~SQLAhora~", ")
     SQL.ADD("  NrOperacion= '"~Val(Z:2)~"' ")
     SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
     SQL.NEW
     SQL.EXEC
  EndIf
  
  SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
  SQL.ADD(" Values ('"~Val(Z:2)~"', '7', '1') ")
  SQL.NEW
  SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
  SQL.ADD(" Values ('"~Val(Z:2)~"', '13', '0') ")
  SQL.NEW
  SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
  SQL.ADD(" Values ('"~Val(Z:2)~"', '10', '0') ")
  SQL.NEW
  SQL.ADD(" Insert Into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
  SQL.ADD(" Values ('"~Val(Z:2)~"', '70', '0') ")
  SQL.NEW
  SQL.EXEC
  
  SQL.ADD(" Insert Into "~DBO~".OPERACIONES ")
  SQL.ADD(" (TipoOp, NrOperacion, Especie, Cliente1, FechaOp, ")
  SQL.ADD("  Plazo, FechaVto, FechaPago, Cantidad, Precio1, ")
  SQL.ADD("  ContraEspecie, TotalBrutoCli1, Mercado, Mercado2, Vehiculo1, ")
  SQL.ADD("  Operador, TablaFeriados1, FormaLiquidacion1, FormaLiquidacion2, Cartera, RB10, Book1, ")
  SQL.ADD("  TotalNetoCli1, TotalNetoCli3, Cotizacion1, Cotizacion2, ")
  SQL.ADD("  PorImpuestoBolsa, PorDerechoBolsa, RB3, RB5, ")
  SQL.ADD("  UsrInput, FechaCarga, FechaCargaSys, Numerador, PaseCB, ")
  SQL.ADD("  Plazo2, TotalAux1, CB5, CB6, OpSIOPEL, ")
  SQL.ADD("  CB8, CB9, VTeorico, CanPosTrad, InteresesCorr, ")
  SQL.ADD("  PorDerechoMercado, TotalAux5, TotalAux6, Cuenta1, Cuenta2,")
  SQL.ADD("  Cuenta3, Cuenta4, NrOrden1, CanPosInv1, CanPosInv2, Mercado4, ")
  SQL.ADD("  CanPosOSoc, TotalBrutoCli2, Mercado3, Cupon1, ")
  SQL.ADD("  ContraEspecie2, TotalAux2, TotalGastos, TotalAux3, ")
  SQL.ADD("  Especie1, PorArancel, TotalImpuestos, TotalAux4, ")
  SQL.ADD("  TipoCambio2, TipoCambio3, PrecioMer, CB10, NrBoleto, TotalAux7) ")
  SQL.ADD(" Values ")
  SQL.ADD(" ('"~Val(TO:1)~"', '"~Val(Z:2)~"', '"~Dialogo.Especie1~"', '"~Dialogo.Cliente1~"', '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD("  '"~FBN['Plazo1']~"', '"~IdxDate(Val(FV:1))~"', '"~IdxDate(Val(FV:1))~"', '"~FStr(Dialogo.Cantidad1,0,2)~"', '"~FStr(Dialogo.Precio1,0,8)~"', ")
  SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:24),0,2)~"', '"~FBN['Mercado4']~"', '"~FBN['Mercado2']~"', '"~FBN['Vehiculo']~"', ")
  SQL.ADD("  '"~FBN['Operador']~"', 'ARG', '"~FBN['RB10']~"', '"~FBN['RB10']~"', '0', '0', '"~FBN['Book1']~"', ")
  SQL.ADD("  '"~FStr(Val(Z:18),0,2)~"', '"~FStr(Val(Z:3),0,2)~"', '"~FStr(Val(Z:4),0,9)~"', "~FStr(Val(Z:5),0,9)~", ")
  SQL.ADD("  '"~FStr(((Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:4))/Dialogo.Cantidad1),0,7)~"', '"~FStr(((Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:5))/Dialogo.Cantidad1),0,7)~"', '0', '"~FBN['RB5']~"', ")
  SQL.ADD("  '"~USUARIOACTIVO~"', "~SQLAhora~", '"~IdxDate(FSys)~"', 1, '0', ")
  SQL.ADD("  '"~FBN['Plazo1']~"', 1, '0', '0', '"~Val(Z:12)~"', ")
  SQL.ADD("  '0', '0', '7', '"~FStr(Dialogo.Cantidad1,0,2)~"', '"~Val(Z:6)~"', ")
  SQL.ADD("  '"~Val(Z:7)~"', '"~Val(Z:8)~"', '"~Val(Z:9)~"', '"~Val(Z:13)~"', '"~Val(Z:10)~"', ")
  SQL.ADD("  '"~Val(Z:14)~"', '"~Val(Z:11)~"', '"~Dialogo.NrOrden~"', '0', '0', '"~FBN['Mercado3']~"', ")
  SQL.ADD("  '0', '"~FStr((Val(Z:15)),0,6)~"', '"~FBN['Mercado']~"', '"~FStr(Val(Z:23),0,0)~"', ")
  SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:16),0,7)~"', '"~FStr(Val(Z:22),0,2)~"', '"~FStr(((Val(Z:26)*Val(Z:25))/100),0,2)~"', ")
  SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:17),0,7)~"', '"~FStr(Val(Z:26),0,2)~"', '"~FStr(((Val(Z:22)*Val(Z:25))/100),0,2)~"', ")
  SQL.ADD("  '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:20),0,8)~"', '"~FBN['CB10']~"', '"~Val(Z:21)~"', '"~FStr(Val(Z:25),0,2)~"') ")
  SQL.NEW
  SQL.EXEC
  
  SQL.ADD(" Update "~DBO~".ORDENES Set ")
  SQL.ADD("  NrOperacion2 = '"~Val(Z:2)~"' ")
  SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
  
  ** Actualizo Movimientos de la Accion
  SQL.ActualizarMovimientos3(Val(Z:2),SI,SI,NO,SI,SI)
  SQL.EXEC
Proximo
