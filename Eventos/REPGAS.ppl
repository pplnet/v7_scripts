*- REPGAR: REPOSICION de Garantias
HojaVisible(SI)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;;;;;;NoVacio(Dialogo.Vehiculo1) y IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "));NO
  Fecha1     : "Fecha   "   ;;;;;;;;;Fsys;
  Especie1   : "Especie"    ;;;;;;;;;;;;;
  Cliente1   : "Cliente"    ;;;;;;;;;;
  NrOperacion1  : "Operacion"    ;;;;;;;;;;
FinDialogo


If Not Ok
  Cancelar
EndIf


* Veo solamente los tipos seleccionados
SetListaClaves(2)

 

CrearFont(1,"Arial,8,")

CrearFont(2,"Arial,8,B")

 

ACT(es:0, 'ES')

ACT(ga:0, 'GA')

 

ACT(ta1,'SALDOS')

 

If Dialogo.Fecha1<Fsys

   ACT(ta1,'SALDOSDIA')

EndIf

 

*- Select desde Saldos o saldosdia

SQL.ADD("SELECT 1 Marca, S.Cliente, S.Cuenta, S.Saldo, S.Especie, S.Cupon, S.NrSaldo, S.Mercado, S.EnteCustodia,S.Cuenta as Referencia,")

SQL.ADD("       ESP.FechaCambioTasa, ESP.TasaIntAnterior, ESP.TasaIntVigente,ESP.Cotiza, ESP.InteresesC ")

SQL.ADD("FROM "~DBO~"."~val(ta1)~" S,"~DBO~".ESPECIES ESP ")

SQL.ADD("WHERE S.Especie = ESP.Codigo ")

IF NoVacio(Dialogo.Especie1)

   SQL.ADD(" AND S.Especie = '"~Dialogo.Especie1~"'  ")

ENDIF

IF NoVacio(Dialogo.Cliente1)

   SQL.ADD(" AND S.Cliente = '"~Dialogo.Cliente1~"'  ")

ENDIF

SQL.ADD("    AND  S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")

SQL.ADD("    AND  S.Saldo <> 0  ")

If Not Vacio(Dialogo.NrOperacion1)

   SQL.ADD("    AND  S.Cuenta ='"~Dialogo.NrOperacion1~"'  ")

EndIf

SQL.ADD(" AND S.NrSaldo = 201 ")

If Dialogo.Fecha1<Fsys

   *- Condicion Adicional para Saldos dia

   SQL.ADD("      and S.Fecha = (SELECT MAX(S2.Fecha) ")

   SQL.ADD("      FROM "~DBO~"."~val(ta1)~" S2 ")

   SQL.ADD("      WHERE S2.Cliente = S.Cliente AND ")

   SQL.ADD("      S2.Especie = S.Especie AND ")

   SQL.ADD("      S2.Cliente = S.Cliente AND ")

   SQL.ADD("      S2.EnteCustodia = S.EnteCustodia AND ")

   SQL.ADD("      S2.Mercado = S.Mercado AND ")

   SQL.ADD("      S2.NrSaldo = S.NrSaldo AND ")

   SQL.ADD("      S2.Cuenta = S.Cuenta AND ")

   SQL.ADD("      S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")

EndIf

SQL.ADD("ORDER BY S.EnteCustodia,S.Cliente,S.Referencia,S.Especie ")

 

ACN(w1,fac)

acn(mr1,0)

act(az2,'')

act(az3,'')

act(az4,'')

 

*- Fila del grupo de control

acn(fb1,0)

 

SCN(ba:1, 1)

 

*- Por cada saldo verifico si tiene transacciones de CAMBIO DE ESTADO en Efectivo  que 

*- no sean por Reposicion

Recorrer SQL

 

   *- Por fin de control grabo la ultima linea de esa garantia en z:

   If Not EqStr(val(az2)~val(az3)~val(az4),FBN['EnteCustodia']~FBN['Cliente']~FBN['Referencia'])  y NoVacio(val(az2))  

      *- Comparo las valuaciones de las reposiciones con el saldo al que hay que llegar

      *- Saldo de Garantia Entregada

      ACN(bb:Val(ba:1), Val(sa1))

      ACN(bc:Val(ba:1), Val(va1))

      acn(mr1,val(sa1)-val(va1))

      ACN(bd:Val(ba:1), Val(mr1))

 

      *- Chequeo contro el % de Desvio para saber cuanto vario cada cotizacion

      *- de1: desvio sobre  la cotizacion de la primer entrega re1: a reponer 1er. entrega

      ACN(de1, (val(va1)/val(sa1)) -1)

      ACN(be:Val(ba:1), Val(de1))

      ACN(re2,0)

 

      *- e: Variacion h: Entregado/recibido f: Especie de reposicion

      acn(e:val(fb1),val(y:val(fb1))-Val(VA1))

      ACN(bf:Val(ba:1), val(y:val(fb1)))

      ACN(bg:Val(ba:1), Val(VA1))

      ACN(bh:Val(ba:1), val(e:val(fb1)))

 

      ACN(z:val(fb1),fac-1)

 

      If abs(val(de1))>=val(z8) 

         IF [Abs(val(e:val(fb1)))>=VAL(mi1) y Abs(val(e:val(fb1)))<= VAL(ma1)] o val(mo1)=1

            If val(mu1)=0

               acn(mu1,1)

            EndIf

 

            ACN(ga2,val(e:val(fb1)) Mod val(mu1) )

            *- Garantia Entregada => Entrego mas que el multiplo

            ACN(ga1,((val(e:val(fb1)) Div val(mu1))+IIf(val(e:val(fb1))>0 y val(ga2)>0,1,0))*val(mu1) ) 

            If val(ga1)<>0

               ACN(re2,1)      

            EndIf

 

            *- Convierto el saldo a la especie de la garantia 

            IF Not EqSTr(val(es1),val(es2))

               ACN(ga1,val(ga1)*COTIZACIONC(val(es1),,,,Dialogo.Fecha1-1,1,,val(es2))/val(z9)*100)

            ENDIF

            IF DesciendeDeEspecie(val(es2),'TITULO')

               *- Redondeo a enteros

               ACN(ga1,Round2(val(ga1),0))

            EndIf

         EndIf

      EndIf

 

 

      act(f:val(fb1),Val(es2))

      acn(p:val(fb1),Val(re2))

      acn(q:val(fb1),Val(ga1))

      acn(v:val(fb1),Val(mi1))

      acn(w:val(fb1),Val(ma1))

      acn(x:val(fb1),Val(mu1)) 

 

      SCN(ba:1, 1)

 

   EndIf

 

   Message(FBN['EnteCustodia']~' '~FBN['Cliente']~' '~FBN['Referencia']~' '~Fstr(FBN['Especie'],0,0) )

 

   ACN(a:fac,0)

 

   *- Cuando cambia Vehiculo/Cliente/NrSaldo registro el monto a reponer

   If Not EqStr(val(az2)~val(az3)~val(az4),FBN['EnteCustodia']~FBN['Cliente']~FBN['Referencia']) 

      act(az2,FBN['EnteCustodia'] )

      act(az3,FBN['Cliente'] )

      act(az4,FBN['Referencia'] )

 

      ACN(ga1,0)

      ACN(ga2,0)

      ACN(mo1,0)

      acn(mr1,0)

      acn(mr2,1)

      scn(fb1,1)

 

      *- Busco los datos de la Garantia Original

      SQL.ADD("SELECT OperacionRef, Cotizacion2, Cotizacion1, FechaOp, Precio1, PorAforo, MB3, Especie, PrecioEj as Cantidad ")

      SQL.ADD("  FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~FBN['Referencia']~"' ")

      Recorrer SQL

          dfa

          act(z5,FBN['Especie'] )

          acn(z6,FBN['Cantidad']*IIF(val(z7)=0,1,-1) )

          acn(z8,FBN['Precio1'] )

          acn(z9,FBN['PorAforo'] )

          If val(z9)=0

             acn(z9,100 )

          EndIf

          acd(z10,FBN['FechaOp'] )

          acn(z11,FBN['Cotizacion1'] )

          acn(z12,FBN['Cotizacion2'] )

          act(z13,FBN['OperacionRef'] )

      Proximo

 

      *- Cotizacion Por Especie original garantiza 

      ACN(ce2, COTIZACION(val(z5),,,,Dialogo.Fecha1-1,1) - val(z11))

 

      *- de2: desvio sobre la cotizacion de la gtia original re2: a reponer gtia original

      ACN(de2, (COTIZACION(val(z5),,,,Dialogo.Fecha1-1,1)/val(z11)) -1)

 

      *----- ENTREGA ORIGINAL Y SUCESIVAS REPOSICIONES 

      *- Recupero las reglas de reposicion para llegar a que el saldo entregado sea

      *- el total de la regla

      SQL.ADD("SELECT  NrOperacion as Referencia,Especie2,Tipo,Especie1,Importe1,RB2,Importe2, Importe3,Importe4   ")

      SQL.ADD(" FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~FBN['Referencia']~"' ORDER BY Tipo")

      Recorrer SQL       

          dfa

          *- sa1: Saldo al que hay que llegar para reposicion

          *- es1: Especie del saldo hay que hay que llegar 

          *- es2: Especie a Reponer => Una vez que llego al saldo, transformo a esta especie

          ACN(sa1,FBN['Importe1'])

          messageBox('sa1 '~PyC(val(sa1),1,2)~' 1')

 

          *- Verifico el valor nominal actual de esa operacion 

          IF EqStr(Copy(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',val(z13)),1,2),'MM')

             *- Es una operacion de MM y multiple vto. busco el monto 

             *- Si es unico vencimiento -> No amortiza

             If Not SQL("SELECT Count(*) FROM "~DBO~".CUOTAS WHERE NrOperacion='"~val(z13)~"' ")=1

                ACN(sa1,SQL("SELECT Cantidad2 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~val(z13)~"' AND Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' "))

                messageBox('sa1 '~PyC(val(sa1),1,2)~' 2')

             EndIf

          EndIf

          ACT(es1,FBN['Especie1'])

          ACT(es2,FBN['Especie2'])

          ACN(li1,FBN['RB2'])

          ACN(mu1,FBN['Importe2'])

          IF val(mu1)=0

             *- No valida Multiplo => asigno 1

             ACN(mu1,1)

          EndIf

 

          *- CU1: Nro. de Settlement a reponer 

          ACN(cu1,SQL("SELECT Cuotas2 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~FBN['Referencia']~"' ")+1)

 

          * Obtengo el minimo y maximo de OPSCALLSPUTS segun el numero de reposicion que haga

          SQL.ADD("SELECT  NrOperacion as Referencia,  IntCorridosEj as SettDesde,  ImporteTotEj as SettHasta,")

          SQL.ADD("VNCancelado as   Minimo,  ImpVNCancela as Maximo")

          SQL.ADD(" FROM "~DBO~".OPSCALLSPUTS WHERE NrOperacion='"~FBN['Referencia']~"' and ")

          SQL.ADD(" IntCorridosEj<="~Fstr(val(cu1),0,0)~" and   ImporteTotEj>="~Fstr(val(cu1),0,0)~"  ")        

          Recorrer SQL   

             dfa 

             ACN(mi1,FBN['Minimo'])

             ACN(ma1,FBN['Maximo'])

          Proximo

      Proximo

 

      *- Datos de la grantia original     

      act(c:val(fb1), val(az3) )

      act(d:val(fb1), val(az4) )

      *- act(i:val(fb1), val(z5) )

 

      act(m:val(fb1), PYC(Val(z8),0,2))

      act(n:val(fb1), PYC(Val(z9),0,2))

 

      acn(mr3,val(z6)*val(ce2)*val(z9)/100)

      act(k:val(fb1), PYC(Val(mr3),0,2))

      act(o:val(fb1), PYC(Val(re1),0,2))

 

      act(i:val(fb1), val(es1) )

 

      *- j: Saldo en texto para mostrar y: Saldo en numerico para calcular 

      act(j:val(fb1), PYC(Val(sa1),0,2))

      acn(y:val(fb1), Val(sa1) )

 

      *- va1 Valuacion a Hoy expresado en moneda es1

      ACN(va1,0)

   EndIf 

 

   *- ce1: Delta entre cotizacion de ayer y hoy 

   ACN(ce1, COTIZACION(FBN['Especie'],,,,Dialogo.Fecha1-1,1) - val(z12) )

   ACN(bi:Val(ba:1), COTIZACION(FBN['Especie'],,,,Dialogo.Fecha1-1,1))

   ACN(bj:Val(ba:1), val(z12))

   ACN(bk:Val(ba:1), val(ce1))

   ACN(bl:Val(ba:1), val(va1))

   ACT(bm:Val(ba:1), FBN['Especie'])

   ACT(bn:Val(ba:1), val(es1))

   ACN(bo:Val(ba:1), FBN['Saldo'])

 

   *- CALCULO EL SALDO A HOY => va1 Valuacion a Hoy expresado en moneda de la especie del saldo

   If Not EqSTr(FBN['Especie'],val(es1))

      *- El primer dia valuo a la cotizacion de la operacion, el resto al tipo de cambio de la tabla

      SCN(va1, FBN['Saldo']*IIF(val(z10)=Dialogo.Fecha1,val(z12),COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,,val(es1)))*val(z9)/100)

      messageBox(PYC(val(va1),1,2)~' '~PyC(FBN['Saldo'],1,2)~' a ')

   Else 

*      ACN(va1,val(va1)+FBN['Saldo'])

      SCN(va1, FBN['Saldo']*IIF(val(z10)=Dialogo.Fecha1,val(z12),COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,,val(es2)))*val(z9)/100)

      messageBox(PYC(val(va1),1,2)~' '~PyC(FBN['Saldo'],1,2)~' b ')

      *- Marco que tuvo saldo en moneda porque si no tuvo saldo en moneda vale el maximo y el minimo

      ACN(mo1,1)

      ACN(bp:Val(ba:1), val(z12))

      ACN(bq:Val(ba:1), COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,,val(es1)))

      ACN(br:Val(ba:1), val(z9))

   EndIf

   ACN(bt:Val(ba:1), val(va1))

 

Proximo 

 

*- Comparo las valuaciones de las reposiciones con el saldo al que hay que llegar

*- Saldo de Garantia Entregada

      ACN(bb:Val(ba:1), Val(sa1))

      ACN(bc:Val(ba:1), Val(va1))

acn(mr1,val(sa1)-val(va1))

      ACN(bd:Val(ba:1), Val(mr1))

 

*- Chequeo contro el % de Desvio para saber cuanto vario cada cotizacion

*- de1: desvio sobre  la cotizacion de la primer entrega re1: a reponer 1er. entrega

ACN(de1, (Abs(val(va1))/val(sa1)) -1)

      ACN(be:Val(ba:1), Val(de1))

ACN(re2,0)

 

*- e: Variacion h: Entregado/recibido f: Especie de reposicion

acn(e:val(fb1), val(y:val(fb1))-Val(VA1))

      ACN(bf:Val(ba:1), val(y:val(fb1)))

      ACN(bg:Val(ba:1), Val(VA1))

      ACN(bh:Val(ba:1), val(e:val(fb1)))

ACN(z:val(fb1), fac-1)

 

If abs(val(de1))>=val(z8) 

   message('1 '~ val(e:val(fb1))~' '~VAL(mi1)~' '~VAL(ma1)~' '~val(mo1))

   IF [Abs(Round2(val(e:val(fb1)),0))>=VAL(mi1) y Abs(Round2(val(e:val(fb1)),0))<= VAL(ma1)] o val(mo1)=1

      If val(mu1)=0

         acn(mu1,1)

      EndIf

 

      ACN(ga2, val(e:val(fb1)) Mod val(mu1) )

      *- Garantia Entregada => Entrego mas que el multiplo

      ACN(ga1, ((val(e:val(fb1)) Div val(mu1))+IIf(val(e:val(fb1))>0 y val(ga2)>0,1,0))*val(mu1) ) 

      If val(ga1)<>0

         ACN(re2,1)      

      EndIf

      *- Convierto el saldo a la especie de la garantia 

      IF Not EqSTr(val(es1),val(es2))

         message(val(ga1))

         ACN(ga1, val(ga1)*COTIZACIONC(val(es1),,,,Dialogo.Fecha1-1,1,,val(es2))/val(z9)*100)

         message(val(ga1))

      ENDIF

      IF DesciendeDeEspecie(val(es2),'TITULO')

         *- Redondeo a enteros

         ACN(ga1, Round2(val(ga1),0))

      EndIf

 

   EndIf

EndIf

 

act(f:val(fb1), Val(es2))

acn(p:val(fb1), Val(re2))

acn(q:val(fb1), Val(ga1))

 

*- e: Variacion h: Entregado/recibido f: Especie de reposicion

acn(e:val(fb1), val(y:val(fb1))-Val(VA1))

acn(p:val(fb1), Val(re2))

acn(v:val(fb1), Val(mi1))

acn(w:val(fb1), Val(ma1))

acn(x:val(fb1), Val(mu1))

 

ACN(z:val(fb1), fac)

 

 

SetFilaActual(val(fb1))

 

If val(fb1)<=0

   message(' No se encontraron Saldos a REPONER !!! ')

Else 

   *- Muestro todos los datos 

   CrearListBox ; 'Arial ,8,'; '________________ G  A  R  A  N  T  I  A     O  R  I  G  I  N  A  L _______________________  E   N   T   R   E   G   A   S ' 

      'Marca'           ;a:1..a:fac;Not Eqstr(Val(c:flb),'////////////////////////');;;80;CHECK;RGB(232,255,215);

      'Cliente'         ; c1..c:fac;NO;SI;'Error'; 50;STRING;;RGB(180,180,193)

      'Operacion'       ; d1..d:fac;NO;SI;'Error'; 60;STRING;;RGB(180,180,193)

      'Especie'         ; i1..i:fac;NO;SI;'Error'; 50;STRING;;RGB(180,180,193)

      '%Desvio'         ; m1..m:fac;NO;SI;'Error'; 50;STRING;;RGB(180,180,193)

      '%Aforo'          ; n1..n:fac;NO;SI;'Error'; 50;STRING;;RGB(180,180,193)

      'Monto'           ; j1..j:fac;NO;SI;'Error'; 80;STRING;;RGB(180,180,193)

      'Variacion'       ; e1..e:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)      

 

      'Minimo'          ; v1..v:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)      

      'Maximo'          ; w1..w:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)      

      'Multiplo'        ; x1..x:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)      

 

      'Repone'          ; p1..p:fac;NO;SI;'Error'; 40;COMBO;'No|Si|';RGB(220,220,193)

      'A Reponer'       ; q1..q:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)      

 

      *- 'Ent/Rec'         ; h1..h:fac;NO;SI;'Error'; 100;NUMERO;'###,###,###,###.##';RGB(180,180,193)

      'EspRepo'         ; f1..f:fac;NO;SI;'Error'; 50;STRING;;RGB(180,180,193)

   FinListBox

 

   IF Not Ok

      Cancelar

   ENDIF

 

   Recorrer&i 1,fac

*acn(va1,&i)

*messagebox(val(va1))

       if val(a:&i)=1 

          *- Puede reponer de esa linea => Ubico las reglas de reposicion

          *- Por cada variacion propongo las reglas

          

          *- aa: Repone ab: Fecha Movimiento  ac: Liquida Movimiento ad: Especie ae: Monto Entregado 

          *- fi1: Fila hasta donde escribo  las posibilidades

          ACN(fi1,0)

 

          *- Recorro la seleccion desde &i hasta que tenga datos para esa garantia y propongo los valores a reponer

          *- en la especie de la regla

          SQL.ADD("SELECT Especie1 FROM "~DBO~".COMISIONES2 WHERE NrOperacion='"~val(d:&i)~"' ORDER BY Tipo")

          Recorrer SQL

                dfa

          Proximo

          

*          ACN(aa:val(fi1),0)

*          ACD(ab:val(fi1),Fsys)

*          ACN(ac:val(fi1),1)

*          ACT(ad:val(fi1),val(i:&i))

*          ACN(ae:val(fi1),Num(ReemplazarSTR(val(k:&i),',','',SI)))

 

          Recorrer&j &i,val(z:&i)

*acn(va2,&j)

*messagebox(val(va2))

 

             If val(q:&j)<>0

                SCN(fi1,1)

                ACN(aa:val(fi1),1)

                ACD(ab:val(fi1),Fsys)

                ACN(ac:val(fi1),1)

                ACT(ad:val(fi1),val(f:&j))

                ACN(ae:val(fi1),val(q:&j))          

             EndIf

          Proximo

 

          CrearDialogo

             Cliente1     : "Cliente"      ;1;1;;NO;;;;;val(c:&i)

             NrOperacion1 : "Operacion"    ;2;1;;NO;;;;;val(d:&i)

             Especie1     : "Especie"      ;3;1;;NO;;;;;val(i:&i)

             Precio1      : "%Desvio"      ;1;2;;NO;;;;;Num(val(m:&i))

             Precio2      : "%Aforo"       ;2;2;;NO;;;;;Num(val(n:&i))

             String1      : "MontGaran"    ;4;1;;NO;;;;;val(j:&i)

             ListBox; 'Arial,8,N'; 460; 180

                 'Repone'        ;aa:1..aa:val(fi1);;;;;70;CHECK

                 'Liquida'       ;ac:1..ac:val(fi1);;;;;40;COMBO;'No|Si|'

                 'Fecha'         ;ab:1..ab:val(fi1);;;;;60;FECHA

                 'Monto'         ;ae:1..ae:val(fi1);;;;;100;NUMERO;'##,###,###,###.##'

                 'Especie'       ;ad:1..ad:val(fi1);;;;;80;TABLA ; 'Especies';'Codigo';'Codigo;Nombre'

            FinListBox  

          FinDialogo

 

          IF Not OK

             Cancelar

          EndIf            

 

          *- CU1: Cantidad de cuotas

          ACN(cu1,SQL("SELECT Cuotas2 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' "))

 

          Recorrer&k 1,val(fi1)

                If val(aa:&k)=1

                   *- CU1: Cantidad de cuotas

                   SCN(cu1,1)

 

                   SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")

                   SQL.ADD("(NrOperacion,NrCuota,Fecha1,Especie1,Cantidad1,Radio2) Values ")

                   SQL.ADD("('"~Dialogo.NrOperacion1~"',"~Fstr(val(cu1),0,0)~","~IdxDate2(val(ab:&k))~",'"~val(ad:&k)~"',"~Fstr(val(ae:&k),0,2)~","~Fstr(val(ac:&k),0,0)~")")

                   SQL.NEW

                   SQL.EXEC

                EndIf

          Proximo

 

          SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Cuotas2="~Fstr(val(cu1),0,0)~" WHERE ")

          SQL.ADD("NrOperacion='"~Dialogo.NrOperacion1~"' ")

          SQL.NEW

          SQL.EXEC

 

          SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)

          SQL.EXEC

       EndIf

   Proximo

EndIf

