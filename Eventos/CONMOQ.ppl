********************************************************************
*
* PBBI0058 - Convertir IVA/WH/Impto Int. a Pesos con Grilla
* Fecha..............: 02/SEPT/2002 
* Ultima modificacisn: 
* Autor..............: Claudia y Silvia
*
********************************************************************
*
* Convertir Movimientos Pendientes que sean de saldo 1
* que no sean de ARP y que correspondan a IVA o WHT
* de una fecha dada y de saldo 1
* tambien convierte los ejecutados automaticos
*
*********************************************************************
*HojaVisible(SI)
HojaVisible(NO)

CrearDialogo
   Vehiculo1   : "Vehiculo"     ;;;;;;NoVacio(Dialogo.Vehiculo1) y IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' "));NO
   Fecha2      : "F.Desde"      ;;;;;;Vacio(Dialogo.Fecha2) o Dialogo.Fecha2<=Dialogo.Fecha1;'Fecha Desde Debe ser Blanco o Inferior a Fecha Hasta';NO;;
   Fecha1      : "F.Hasta"      ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha Hasta';NO;FSys;
   Especie1    : "Especie"      ;;;;;;
   Cliente1    : "Entidad"      ;;;;;;
   Vehiculo2   : "Vehiculo"     ;;;;;No;NoVacio(Dialogo.Vehiculo2);'Debe ingresar un Vehiculo';NO;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "));

   NrOperacion1: "NrOperacion"  ;;;;;;;;

FinDialogo

If Not OK
   Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif
*
*******************************************************************************************************
*
*
MostrarCuadroDeMensajes

If NoVacio(Dialogo.NrOperacion1)
   *- Control de vehiculo habilitado para el usuario
   *- vh1: vehiculo de la operacion o transaccion
   *- Cancela si el vehiculo no esta habilitado para el usuario activo
    
   ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))
   
   (.'CONTROLVH'.)
Endif

* Vehiculos permitidos por el usuario
ACT(z1,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

SetFilaActual(0)

*- ta1: Tabla a actualizar
ACT(ta1,'MOVPENDIENTES')

if NoVacio(Dialogo.Vehiculo1) y Incluido(Dialogo.Vehiculo1,VAR('VLIQUIDAA'))
   ACT(ta1,'MOVEJECUTADOS')
EndIf


***---Select

  SQL.ADD("Select * from  "~DBO~"."~val(ta1)~"  ")
  SQL.ADD("where FechaMov <='"~IdxDate(Dialogo.Fecha1)~"' and NrSaldo =1 ")
  SQL.ADD("and Especie<>'"~VAR('MONELOCA')~"' and ")
  SQL.ADD(" (Leyenda like '%IVA %' or Leyenda like '%WH %' or Leyenda like  '%Impto.Int %' or Leyenda like '%Imp_Cs_Fin%' or Leyenda like '%Imp.DB%') ")
  If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
  Else
     If NoVacio(UsrVehiculos(UsuarioActivo))
        SQL.ADD(" and EnteCustodia IN ("~Pipe2Comillas(val(z1))~") ")
     EndIf
  endif

  If Dialogo.Fecha2>0
     SQL.ADD("    and FechaMov >= '"~IdxDate(Dialogo.Fecha2)~"' ")
  EndIf

  If Novacio(Dialogo.Especie1)
     SQL.ADD("    and Especie = '"~Dialogo.Especie1~"' ")
  EndIf

  If Novacio(Dialogo.Cliente1)
     SQL.ADD("    and Cliente = '"~Dialogo.Cliente1~"' ")
  EndIf

  If NoVacio(Dialogo.NrOperacion1)
     SQL.ADD("and NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  endif
  SQL.ADD("Order By NrOperacion, FechaMov")

***---Fin Select

**  (.'CONMOQ1'.)
**    SQL.ADD(" ORDER BY 1, 2, 3, 4 ")
*
*

Recorrer SQL

  Message(' Operacion '~FBN['NrOperacion']~' '~FBN['Leyenda']~' ...')

  *-- Listo los atributos del Listbox
      ACN(k:fac,1)
      ACT(a:fac, FBN['NrOperacion'])
      ACD(b:fac, FBN['FechaMov'])
      ACT(c:fac, FBN['Cliente'])
      ACT(d:fac, FBN['Especie'])
      ACN(e:fac, -FBN['Cantidad'])
      ACT(f:fac, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',val(a:fac)) )
      ACT(g:fac, FBN['Leyenda'])
      ACN(j:fac, BuscarCampo('OPERACIONES','Precio1','NrOperacion',val(a:fac)))
      ACN(i:fac, FBN['NrMov'])

      ACN(p:fac, FBN['NrMov'])
      ACN(o:fac,fbn('NrGrupo2'))
      ACT(q:fac, FBN['Concepto'])

  *-- Cotizacion dia de ayer
      ACN(h:fac,CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,,VAR('MONELOCA')))
      ACN(i:fac, val(h:fac))   

Proximo
*
*
If FAC>0
   ACN(z3,FAC)
            
      CrearListBox;'Arial,8,B'
         'Convierte'                ; k1..k:fac; SI; SI;;60; COMBO; 'Si|No|'
         '# Operacion'              ; a1..a:fac; NO; SI;;80; STRING
         'TipoOp'                   ; f1..f:fac; NO; SI;;80; STRING
         'Fecha Mov.'               ; b1..b:fac; NO; SI;;70; FECHA
         'Entidad'                  ; c1..c:fac; NO; SI;;70; STRING
         'Especie'                  ; d1..d:fac; NO; SI;;70; STRING
         'Cantidad'                 ; e1..e:fac; NO; SI;;100; NUMERO;'###,###,###.##p'
         'Leyenda'                  ; g1..g:fac; NO; SI;;150; STRING
         'Cotizacion'               ; h1..h:fac; SI; Val(k:FLB)=1 o [Val(h:FLB)<=Val(i:FLB)*(1+VAR('RPRECIO2')/100) Y Val(h:FLB)>=Val(i:FLB)*(1-VAR('RPRECIO2')/100)];'Rango de Precio Excedido '~PYC(Val(i:FLB)*(1-VAR('RPRECIO2')/100),0,2)~' '~PYC(Val(i:FLB)*(1+VAR('RPRECIO2')/100),0,2);100; NUMERO;'###,###.#####p'
         '# Mov'                    ; i1..i:fac; NO; SI;;50; NUMERO;'###,###p'
      FinListBox   
             
      If OK
         Recorrer&i 1,FAC
                     
         If Val(k:&i)=0
            Message('Actualizando Operacion Nro. '~val(a:&i))
            * Grabo en la Operacion del Movimiento el Tipo de Cambio de Conversion de IVA/WH
                         
            If Not Incluido(val(q:&i),'CUOTAS|COMISI') 
               SQL.ADD("Update "~DBO~".OPERACIONES Set ")
               SQL.ADD("IntDevengados2 ="~FStr(val(h:&i),0,2)~" ")
               SQL.ADD("where NrOperacion='"~val(a:&i)~"' and (IntDevengados2<=0 or IntDevengados2 Is Null) ")
               SQL.NEW     
            Else 
                         
               If Incluido(val(q:&i),'CUOTAS') 
                  SQL.ADD("Update "~DBO~".CUOTAS Set ")            
                  SQL.ADD("Cotizacion1 ="~FStr(val(h:&i),0,2)~" ")
                  SQL.ADD("where NrOperacion='"~val(a:&i)~"' and Cotizacion1<0 ")
                  SQL.ADD("and NrCuota="~Fstr(val(o:&i),0,0)~" ")
                  SQL.NEW     
               Else 
                  SQL.ADD("Update "~DBO~".COMISIONES2 Set ")            
                  If EqStr(val(d:&i),BuscarCampo('OPERACIONES','Especie','NrOperacion',val(a:&i))) 
                     *- Movimiento del IVA se controla contra cotizacion1
                     SQL.ADD("Cotizacion1 ="~FStr(val(h:&i),0,2)~" ")
                     SQL.ADD("where NrOperacion='"~val(a:&i)~"' and (Cotizacion1<=0 or Cotizacion1 Is NUll) ")
                  Else
                     *- Movimiento del WH se controla contra cotizacion2
                     SQL.ADD("Cotizacion2 ="~FStr(val(h:&i),0,2)~" ")
                     SQL.ADD("where NrOperacion='"~val(a:&i)~"' and (Cotizacion2<=0 or Cotizacion2 Is NUll) ")
                  EndIf
                  SQL.ADD("and NrComision="~Fstr(val(o:&i),0,0)~" ")
                  SQL.NEW        
               EndIf
                     
            EndIf
                                 
            SQL.ADD("Update "~DBO~"."~val(ta1)~" Set ")
            SQL.ADD("Especie = '"~VAR('MONELOCA')~"', Cantidad="~FStr(-val(e:&i)*val(h:&i),0,2)~" ")
            SQL.ADD("where NrOperacion='"~val(a:&i)~"' and NrMov="~val(p:&i)~" ")
            SQL.ADD("and NrGrupo2="~val(o:&i)~" ")
            If NoVacio(val(q:&i))
               SQL.ADD("and Concepto='"~val(q:&i)~"'  ")
            EndIf
            SQL.ADD("and Leyenda='"~val(g:&i)~"' and FechaMov='"~IdxDate(val(b:&i))~"' ")    
            if NoVacio(Dialogo.Vehiculo1)
               SQL.ADD("and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
            endif
            SQL.NEW
            SQL.EXEC
         endif
         Proximo
      Endif
                    
Else                  
   Cancelar("No Hay Movimientos a Convertir")
Endif


