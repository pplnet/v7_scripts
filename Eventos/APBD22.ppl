MostrarCuadroDeMensajes
*DialogoVisible(SI)
CrearDialogo
  Fecha1    :"Fecha"            ;1;1;;NO;;;;;;FSYS
  Fecha2    :"D.FechaProceso"   ;2;1;;  ;;;;;HABILES(FSYS,-1,'ARG')
  Fecha3    :"H.FechaProceso"   ;3;1;;  ;;;;;HABILES(FSYS,-1,'ARG')
  String    :"Archivo"          ;4;1;;  ;;NOVACIO(Dialogo.String) ;'Archivo Invalido'   ;NO;VAR('DNCOBRA');;;;;;;;;SI
  String2   :"Nuevo Directorio" ;5;1;;  ;;NOVACIO(Dialogo.String2);'Directorio Invalido';NO;VAR('DNPROCES')
  Radio1:  '|W98|NT';;;;;;;;;0
  Check10: 'HojaVisible' ;;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

If Dialogo.Check10=1
   HojaVisible(SI)
EndIf

ACN(x:3,0)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(a:1, 'Errores existentes en la Captura de Cobranzas. Archivo: '~Dialogo.String)
ACT(a:3, 'Cuenta')
ACT(b:3, 'Banco')
ACT(C:3, 'Vehiculo')
ACT(D:3, 'Sucursal')
ACT(E:3, 'Moneda')
ACT(F:3, 'Importe')
ACT(G:3, 'DC')
ACT(H:3, 'F.Ingreso')
ACT(I:3, 'F.Acred.')
ACT(J:3, 'Comprob.')
ACT(K:3, 'Observ.')
SetFont(A:3..K:3, 2)
AgregarMarco(A:3..K:3, 0, 0, Exe('COLOR6'))

SetFont(a:1, 2)
* Puntero para imprimir errores en pantalla.
ACN(x:4,4)

*  Marca de errores para grabar el xls
ACN(x:6,0)

If ExisteArchivo(MAYUSCULAS2(Dialogo.String))
  * --- Si existe el archivo que se paso como parametro crea los nombres de los archivos de error
  ACT(PT:1, Var('DNERROR'))
  ACT(xx:1, Val(PT:1)~"DNCOBR-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".TXT")
  ACT(xx:2, Dialogo.String2~"DNCOBR-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".dat")
  ACT(xx:3, Val(PT:1)~"DNCOBR-"~Pad0(fstr(Dia(Dialogo.Fecha1),0,0),2)~Pad0(fstr(Mes(Dialogo.Fecha1),0,0),2)~fstr(Anio(Dialogo.Fecha1),0,0)~"-"~Reemplazar(Hora(AHORA),":","-")~".XLS")

  * --- Busca un archivo de cobranzas de HOY

  SQL.ADD(" SELECT /*+ RULE */ M.Vehiculo, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, M.DC, ")
  SQL.ADD(" M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, M.EstadoConciliacion, M.NrDatanet ")
  SQL.ADD(" FROM " ~DBO~ ".MOVDATANET M, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE M.NrDatanet   = D.NrDatanet ")
  SQL.ADD(" AND   D.FechaBajada = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND   D.Archivo     = 'DNCOBR' ")
  SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet ")

  
  Recorrer SQL
    message('Recuperando MovDatanet del dia.')
    ACN(x:3,1)
    ACT(x:2,fbn('NrDatanet'))
    ACT(ba:fac,fbn("vehiculo"))
    ACT(bb:fac,fbn("sucursal"))
    ACT(bc:fac,fbn("cuenta"))
    ACT(bd:fac,fbn("moneda"))
    ACN(be:fac,fbn("importe"))
    ACT(bf:fac,fbn("dc"))
    ACD(bg:fac,fbn("fechaingreso"))
    ACD(bh:fac,fbn("fechaacreditacion"))
    ACT(bi:fac,fbn("tipomov"))
    ACT(bj:fac,MIRT(TRIM(fbn("comprobante"))))
  Proximo
  ACN(fi:1, fac)


  If val(x:3) = 1
    * --- Si encontro MovDatanet del Dia, busca el ultimo nromov para seguir el orden.
    ACN(nm:1, SQL("SELECT /*+ RULE */ MAX(NrMovDatanet) FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(x:2)~"' "))
  Endif

  * --- Abre el arcivo pasado como parametro.

  AbrirAscii(MAYUSCULAS2(Dialogo.String),0)


  Recorrer&i 1,1000000
    ACT(x:1,LEERASCII)
    ACN(nm:2, &i)

    message(' Registrando movimientos del archivo. '~fstr(Val(nm:2),0,0))

    If Vacio(val(x:1))
      * --- Termino el archivo y sale del recorrer
      ACT(aq:&i, Val(x:1))
      ACN(x:5, &i)
      Break  
    Endif

    If Eqstrl(Val(x:1),"C",1)
      * --- Si es un mov de cobranzas (no es I ni F), lo procesa. (Lo va guardando en la hoja de FPA)

      ACT(aa:&i,Copy(Val(x:1),1,1))

      *Banco
      ACT(ab:&i,Copy(Val(x:1),2,3))

      *Cuenta Corta
      ACT(ac:&i,Copy(Val(x:1),5,2))

      *Cuenta Larga
*      ACT(z:&i,Trim(Mirt(Copy(Val(x:1),7,17))))

      * --- Guardo Banco y cuenta corta para buscar el nro de cuenta largo.
      ACT(cc:&i,Copy(Val(x:1),2,5))
      ACT(z:&i, SQL(" SELECT /*+ RULE */ Numero FROM "~DBO~".CUENTAS WHERE Alias3 = '"~TRIM(MIRT(Val(cc:&i)))~"' ") )

      *Vehiculo
      ACT(ad:&i, SQL(" SELECT /*+ RULE */ Cliente FROM "~DBO~".CUENTAS WHERE Numero = '"~TRIM(MIRT(Val(z:&i)))~"' ") )

      *Moneda
      ACT(ae:&i, MIRT(TRIM(Copy(Val(x:1),24,3))))

      *Fecha Acreditacion
      ACT(af:&i,Copy(Val(x:1),33,2)~'/'~Copy(Val(x:1),31,2)~'/'~Copy(Val(x:1),27,4))
      ACD(af:&i,Fecha(Val(af:&i)))

      *Sucursal
      ACT(ag:&i,Copy(Val(x:1),35,3))

      *Fecha ingreso
      ACT(ah:&i,Copy(Val(x:1),44,2)~'/'~Copy(Val(x:1),42,2)~'/'~Copy(Val(x:1),38,4))
      ACD(ah:&i,Fecha(Val(ah:&i)))

      *Factura
      ACT(ai:&i,Copy(Val(x:1),46,16))

      *Cliente
      ACT(aj:&i,Copy(Val(x:1),62,10))

      *Nombre
      ACT(ak:&i,Copy(Val(x:1),72,24))

      *Cheque
      ACT(al:&i,MIRT(TRIM(Copy(Val(x:1),62,10))))

      *Clearing
      ACT(am:&i,Copy(Val(x:1),100,1))

      *Importe
      ACT(cn:&i,COPY(Val(x:1),101,16)~'.'~COPY(Val(x:1),117,2))
      ACN(an:&i,NUM(val(cn:&i)))

      *DC
      ACT(ao:&i,Copy(Val(x:1),119,1))

      *Libre
      ACT(ap:&i,Copy(Val(x:1),120,21))      
    EndIf
    * --- en aq guarda el registro completo.
    ACT(aq:&i, Val(x:1))

    * --- en x:5 guarda la linea por donde va.
    ACN(x:5, &i)
  Proximo

  * --- Cuando termina de recorrerlo cierra el archivo.
  CerrarAscii


  * --- Abre archivo .txt para Grabar errores para las lineas sin cuentas.
  AbrirAscii(val(xx:1),0)
  If val(x:3) = 1
    * --- Hay movimientos Datanet del Dia, recorre los registros bajados en la hoja de FPA
    Recorrer&i 1,val(x:5)
  
*      If DifDia(val(af:&i),Dialogo.Fecha2)=0
      If val(ah:&i)>=Dialogo.Fecha2 y val(ah:&i)<=Dialogo.Fecha3
         * --- Si la fecha de Ingreso es igual a la indicada en el dialogo para procesar 

        If NoVacio(val(ad:&i))
          * --- Si tiene vehiculo 

          Recorrer&j 1,Val(fi:1)
           * --- Recorre los movimientos de la tabla para cada linea del ascii para ver si ya existe.

            If Eqstr(val(ad:&i),val(ba:&j)) 
               * --- Vehiculo

              If Eqstr(val(ag:&i),val(bb:&j)) 
                 * --- Sucursal

                If Eqstr(val(ag:&i),val(bb:&j)) 
                   * --- Sucursal

                  If Eqstr(val(z:&i),val(bc:&j))
                     * --- Cuenta

                    If Eqstr(val(ae:&i),val(bd:&j)) 
                       * --- Moneda

                      If Eqstr(fstr(val(an:&i),15,2),fstr(val(be:&j),15,2)) 
                         *  --- Importe

                        If Eqstr(val(ao:&i),val(bf:&j)) 
                           * --- DC

                          If val(ah:&i)=val(bg:&j) 
                             * --- Fecha de Ingreso

                            If Val(af:&i) = val(bh:&j) 
                               * --- Fecha de Acreditacion

                              If Eqstr('CB',val(bi:&j)) 
                                 * --- Si es un movimiento de cobranzas

                                If Eqstr(val(al:&i),val(bj:&j)) 
                                   * --- Comrobante

                                  If Eqstr(fstr(val(an:&i),15,2),fstr(val(be:&j),15,2))
                                     * --- Importe

                                    message('El movimiento ya existe.')
                                    ACT(nn:1,'0')
                                    Break
                                  Else
                                    ACT(nn:1,'1')
                                  EndIf
                                Else
                                  ACT(nn:1,'1')
                                EndIf
                              Else
                                ACT(nn:1,'1')
                              EndIf
                            Else
                              ACT(nn:1,'1')
                            EndIf
                          Else
                            ACT(nn:1,'1')
                          EndIf                  
                        Else
                          ACT(nn:1,'1')
                        EndIf
                      Else
                        ACT(nn:1,'1')
                      EndIf
                    Else
                      ACT(nn:1,'1')
                    EndIf
                  Else
                    ACT(nn:1,'1')
                  EndIf
                Else
                  ACT(nn:1,'1')
                EndIf
              Else
                ACT(nn:1,'1')
              EndIf
            Else
              ACT(nn:1,'1')
            EndIf
          Proximo
          If Eqstrl(Val(nn:1),'1',1)
            * --- Como algun dato es distinto, inserta el movimiento.
            IF Fecha(Val(AH:&i)) = Dialogo.Fecha3
                ACT(TM:1, 'CB')
                ACT(EC:1, 'P')
            ELSE
                ACT(TM:1, 'INI')
                ACT(EC:1, 'FC')
            ENDIF
            SCN(nm:1,1)
            * --- va generando el nrmov dentro de MovDatanet

            SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
            SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
            SQL.ADD(" Banco, Sucursal, Cuenta, ")
            SQL.ADD(" Moneda, Importe, DC, ")
            SQL.ADD(" FechaIngreso, FechaAcreditacion, TipoMov, ")
            SQL.ADD(" Comprobante, EstadoConciliacion ")
            SQL.ADD(" ) VALUES ( ")
            SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ad:&i)~"', ")
            SQL.ADD(" '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(z:&i)~"', ")
            SQL.ADD(" '"~trim(mirt(val(ae:&i)))~"', "~fstr(val(an:&i),1,2)~", '"~val(ao:&i)~"', ")
            SQL.ADD(" "~Idxdate2(val(ah:&i))~", "~IdxDate2(val(af:&i))~", '"~Val(TM:1)~"', ")
            SQL.ADD(" '"~val(al:&i)~"', '"~Val(EC:1)~"' )  ")
            SQL.NEW
            SQL.EXEC
            message(' Movimiento nuevo OK.')
          ELSE
            ***---Movimiento Duplicado
            * --- Cuenta Corta
            ACT(a:Val(x:4), Val(cc:&i))

            * --- Banco
            ACT(b:Val(x:4), Val(ab:&i))
            ACT(C:Val(X:4), Val(AC:&I))
            ACT(D:Val(X:4), Val(AG:&I))
            ACT(E:Val(X:4), Val(AE:&I))
            ACN(F:Val(X:4), Val(AN:&I))
            ACT(G:Val(X:4), Val(AO:&I))
            ACD(H:Val(X:4), Val(AH:&I))
            ACT(I:Val(X:4), Val(AF:&I))
            ACT(J:Val(X:4), Val(AL:&I))
            ACT(K:Val(X:4), 'Registro Duplicado')
            SCN(x:4,1)
            EscribirAscii(Val(aq:&i))
            SCN(x:6,1)
          EndIf
        Else
          If NoVacio(Val(cc:&i))
            message(' La cuenta '~Val(cc:&i)~' no existe.')

            * --- Cuenta Corta
            ACT(a:Val(x:4), Val(cc:&i))

            * --- Banco
            ACT(b:Val(x:4), Val(ab:&i))
            SCN(x:4,1)

            * --- Si no tiene vehiculo graba el error en el TXT que esta abierto (XX:1).
            EscribirAscii(Val(aq:&i))

            * --- Va incrementando para despues verificar si hay errores y grabar el xls
            SCN(x:6,1)
            * --- Endif de Cuenta Corta Vacia
          EndIf
          * --- Endif MOV Repetido
        EndIf
        * --- Endif de Fecha de Acreditacion igual a la de proceso
      EndIf
      * --- Termina la comparacion de los mov de la tabla con los del archivo
    Proximo

    * --- Cierra el TXT de errores    
    CerrarAscii

    If val(x:6) > 0
      * --- Si hubo errores graba XLS
      ExportarXLS(a:1..e:val(x:4), a1..e:val(x:4), val(xx:3))
    Else
      * --- Si no hubo errores borra el txt
      BorrarArchivo(val(xx:1))  
    EndIf
  Else

    * --- No hay MovDatanet del Dia
    ACT(x:2,getnumerador(7))
    ACN(nm:1,0)

    Recorrer&i 1, Val(x:5)
      * --- Recorre los movimientos del Ascii que bajo en la hoja de FPA    

      If Fecha(val(ah:&i))>=Dialogo.Fecha2 y Fecha(val(ah:&i))<=Dialogo.Fecha3
         * --- Si la fecha de Ingreso es correcta
         IF Fecha(Val(AH:&i)) = Dialogo.Fecha3
             ACT(TM:1, 'CB')
             ACT(EC:1, 'P')
         ELSE
             ACT(TM:1, 'INI')
             ACT(EC:1, 'FC')
         ENDIF
        SCN(nm:1,1)
        * --- Incrementa el numerador de MovDatanet

        If NoVacio(val(ad:&i))
          * --- Si no esta vacio el vehiculo,  inserta el movimiento
          SQL.ADD(" INSERT INTO "~DBO~".MOVDATANET ( ")
          SQL.ADD(" NrDatanet, NrMovDatanet, Vehiculo, ")
          SQL.ADD(" Banco, Sucursal, Cuenta, ")
          SQL.ADD(" Moneda, Importe, DC, ")
          SQL.ADD(" FechaIngreso, FechaAcreditacion, TipoMov,  ")
          SQL.ADD(" Comprobante, EstadoConciliacion ")
          SQL.ADD(" ) VALUES ( ")
          SQL.ADD(" '"~val(x:2)~"', "~fstr(Val(nm:1),0,0)~", '"~val(ad:&i)~"', ")
          SQL.ADD("  '"~val(ab:&i)~"', '"~val(ag:&i)~"', '"~val(z:&i)~"', ")
          SQL.ADD(" '"~trim(mirt(val(ae:&i)))~"', "~fstr(val(an:&i),1,2)~", '"~val(ao:&i)~"', ")
          SQL.ADD(" "~IdxDate2(val(ah:&i))~", "~IdxDate2(val(af:&i))~", '"~Val(TM:1)~"', ")
          SQL.ADD(" '"~val(al:&i)~"', '"~Val(EC:1)~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          message(' Movimiento nuevo OK.')
          SQL.EXEC          
        Else
          * --- Si no hay Vehiculo

          If NoVacio(val(cc:&i))
            * --- y hay cuenta corta
            message(' La cuenta '~Val(cc:&i)~' no existe en FPA.')
            ACT(a:Val(x:4), Val(cc:&i))
            ACT(b:Val(x:4), Val(ab:&i))
            SCN(x:4,1)

            * --- Si no tiene vehiculo graba el error en el TXT que esta abierto.
            EscribirAscii(Val(aq:&i))
            SCN(x:6,1)
            * --- Endif no hay cuenta corta
          EndIf
          * ---Endif no hay vehiculo
        Endif
        * --- Fecha de Acreditacion correcta
      EndIf
    Proximo

    * --- Cierra el TXT de errores
    CerrarAscii

    If val(x:6) > 0
      * --- Si hubo errores graba XLS
      ExportarXLS(a:1..e:val(x:4), a1..e:val(x:4), val(xx:3))
    Else
      * --- Si no hubo errores borra el TXT de errores
      BorrarArchivo(val(xx:1))  
    EndIf

    * Graba la cabecera de los Movimientos si no habia una en la tabla DATANET
    * Siempre, haya movimientos o no. ???????

    SQL.ADD(" INSERT INTO "~DBO~".DATANET ( ")
    SQL.ADD(" NrDatanet, FechaBajada, Archivo, ")
    SQL.ADD(" FechaDesde, FechaHasta, Usuario, Estado ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~val(x:2)~"', '"~idxdate(Dialogo.Fecha1)~"', 'DNCOBR',  ")
    SQL.ADD(" '"~idxdate(Dialogo.Fecha2)~"', '"~idxdate(Dialogo.Fecha3)~"', ")
    SQL.ADD(" '"~UsuarioActivo~"', 'A' ) ")
    SQL.NEW
    SQL.EXEC
  Endif

  * --- Graba el archivo en Procesados
  AbrirAscii(val(xx:2),0)
  Recorrer&i 1,val(x:5)
    EscribirAscii(val(aq:&i))
  Proximo
  CerrarAscii
  Esperar(5)
  * ----------------------------------- *

  If Dialogo.Radio1=0
  * -- W98
*    message('Pasando archivo '~Dialogo.String~' a Procesados.')
*    WinExec("COMMAND.COM /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(xx:2),0)
*    Esperar(5)

    message('Borrando archivo '~Dialogo.String)
    WinExec("COMMAND.COM /C del "~Dialogo.String,0)
    Esperar(5)
  Else
   * -- NT
*    message('Pasando archivo '~Dialogo.String~' a Procesados.')
*    WinExec("CMD.EXE /C Copy  "~MIRT(TRIM(Dialogo.String))~"  "~Val(xx:2),0)
*    Esperar(5)

    message('Borrando archivo '~Dialogo.String)
    WinExec("CMD.EXE /C del "~Dialogo.String,0)
    Esperar(5)
  Endif
Else
  Message('El archivo '~Dialogo.String~' aun no se ha generado.')
  Cancelar
EndIf

ACT(a:Val(x:4)+1, 'Fin')
SetFont(a:Val(x:4)+1, 1)

ACO(1, 10)
ACO(2, 10)
ACO(6, 10)
ACO(7, 5)
ACO(11, 10)

ACT(fe:1,Fecha(Dialogo.Fecha1))
GrabarPMG(Val(fe:1), 'APBD2|Cobranzas|'~Hora(AHORA) )
LimitesVision(K:Val(x:4)+2)