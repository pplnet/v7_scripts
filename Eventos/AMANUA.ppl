CrearDialogo
  NrUnicoAsiento1: 'NrAsiento'
FinDialogo

if not ok
  Cancelar
endif

SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 ")
SQL.ADD(" WHERE NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"'")

ACT(x5, Dialogo.NrUnicoAsiento1)

ACN(z1, 0)
Recorrer SQL
  ACT(a:fac, fbn('NrUnicoAsiento'))
  ACT(b:fac, fbn('Alias3'))
  ACT(c:fac, fbn('Alias1'))
  ACT(d:fac, fbn('Cuenta'))
  ACT(e:fac, fbn('Especie1'))
  ACT(f:fac, fbn('DebitoCredito'))
  ACN(g:fac, fbn('Cantidad1'))
  ACT(h:fac, fbn('Detalle'))
  ACT(i:fac, fbn('NrOperacion'))
  ACN(j:fac, 0)
  SCN(z1, 1)
Proximo

FormatoCeldas(h1..h:fac, Exe('F2'))

if Val(z1) > 0
  CrearListBox ; 'Arial,8,'
   'Accion ?'      ;j1..j:FAC;SI;;;70;COMBO;'Ignorar|Borrar|Modificar'
   'Asiento'       ;a1..a:FAC;NO;;;60;STRING
   'Item'          ;b1..b:FAC;NO;;;30;STRING
   'Cod._Operacion';c1..c:FAC;NO;;;30;STRING
   'Cuenta'        ;d1..d:FAC;NO;;;70;STRING
   'Especie'       ;e1..e:FAC;NO;;;60;TABLA;'Especies';'Codigo';'Codigo;Nombre';
   'D/C'           ;f1..f:FAC;NO;;;30;STRING
   'Cantidad'      ;g1..g:FAC;NO;;;90;NUMERO;'##,###,###.##'
   'Detalle'       ;h1..h:FAC;NO;;;250;STRING
   'NrOperacion'   ;i1..i:FAC;NO;;;70;STRING
  FinListBox

  if Ok 
    Recorrer&i 1,fac
      if Val(j:&i)=1
        *********** BORRAR ***********
        message('Borrando Item '~Val(b:&i)~' del Asiento N? '~Val(a:&i))
        SQL.ADD(" DELETE FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~Val(a:&i)~"' AND Alias3 = '"~Val(b:&i)~"'")
        SQL.NEW
      endif
      if Val(j:&i)=2
        *********** MODIFICAR *********
        ACN(x:1, IIF(Eqstr(Val(f:&i),'DEB'),0,1) )
        ACN(x:2, Num(Val(b:&i)) )

        CrearDialogo:13
          NrUnicoAsiento1: 'Asiento'          ;1;1;;NO;;;;;Val(a:&i)
          Entero1        : 'Item'             ;1;2;;NO;;;;;Val(x:2)
          String2        : 'Cod.Operacion'    ;2;1;;;;;;;Val(c:&i)
          String1        : 'Cuenta'           ;3;1;;;;;;;Val(d:&i)
          Especie1       : 'Especie'          ;5;1;;;;;;;Val(e:&i)
          Radio1         : ' |Debito|Credito' ;6;1;;;;;;;Val(x1)
          Cantidad1      : 'Cantidad'         ;6;2;;;;;;;Val(g:&i)
          String3        : 'Detalle'          ;7;1;;;;;;;Val(h:&i)
          NrOperacion1   : 'NrOperacion'      ;9;1;;;;;;;Val(i:&i)
        FinDialogo

        if Ok
          ACN(x:4,Dialogo.Cantidad1 )
          SQL.ADD(" UPDATE "~DBO~".ASIENTOSCON1  ")
          SQL.ADD(" SET Cuenta        = '"~Dialogo.String1~"', ")
          IF Dialogo.Radio1=0 
             SQL.ADD("     DebitoCredito = 'DEB', ")
          ENDIF
          IF Dialogo.Radio1=1
             SQL.ADD("     DebitoCredito = 'CRE', ")
          ENDIF
          SQL.ADD("     Cantidad1     = '"~Val(x:4)~"', ")
          SQL.ADD("     Detalle       = '"~Dialogo.String3~"', ")
          SQL.ADD("     Alias1        = '"~Dialogo.String2~"', ")
          SQL.ADD("     Especie1      = '"~Dialogo.Especie1~"' ")
          SQL.ADD(" WHERE NrUnicoAsiento = '"~Val(a:&i)~"' AND Alias3 = '"~Val(b:&i)~"'") 
          SQL.NEW
        endif
      endif
      ACT(x:5, Val(a:&i))
      ACT(x:6, Val(i:&i))
      SQL.EXEC
    proximo
IF NO
    Recorrer&i 1,100
    IF MessageBox('Agrega un Nuevo Item al Asiento?', 3,2) = 6
      CrearDialogo
         NrUnicoAsiento1: 'Asiento'          ;1;1;;NO;;;;;Val(x:5)
         Entero1        : 'Item'             ;1;2;;  ;;;;;
         String1        : 'Cuenta'           ;4;1;;  ;;NOVACIO(Dialogo.String1);'Debe ingresar una Cuenta V lida';NO  
         Especie1       : 'Especie'          ;5;1;;  ;;NOVACIO(Dialogo.Especie1);'Debe ingresar una Especie valida';NO  
         Radio1         : ' |Debito|Credito' ;6;1;;  ;;;;;0  
         Cantidad1      : 'Cantidad 1'       ;7;1;;  ;;Dialogo.Cantidad1>0;'Debe ingresar una Cantidad valida';NO
         Cantidad2      : 'Cantidad 2'       ;8;1;;  ;;
         Cantidad3      : 'Cantidad 3'       ;9;1;;  ;;
         String2        : 'Cod._Operacion'   ;10;1;;  ;;NOVACIO(Dialogo.String2);'Falta ingresar Codigo de Operacion';SI
         String3        : 'Detalle'          ;11;1;;  ;;NOVACIO(Dialogo.String3);'Falta ingresar Detalle';SI
         NrOperacion1   : 'NrOperacion'      ;12;1;;;;;;;Val(x:6)
      FinDialogo

       IF OK
          ACN(x:6, Dialogo.NrOperacion1)
          ACN(x:4,Dialogo.Cantidad1 )
          ACN(x:9, Dialogo.Cantidad2 )
          ACN(x:10, Dialogo.Cantidad3 )
          ACT(x:7, FSTR(Dialogo.Entero1,1,0))

          SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1  ")
          SQL.ADD(" (Cuenta, Alias1, Alias3, ")
          SQL.ADD("  DebitoCredito, ")
          SQL.ADD("  Cantidad1, Cantidad2, Cantidad3, Detalle,  ")
          SQL.ADD("  Especie1, NrUnicoAsiento, NrOperacion) ")
          SQL.ADD("  VALUES ")
          SQL.ADD(" ('"~Dialogo.String1~"', '"~Dialogo.String2~"', '"~Val(x:7)~"', ")
          IF Dialogo.Radio1=0 
             SQL.ADD(" 'DEB', ")
          ENDIF
          IF Dialogo.Radio1=1
             SQL.ADD(" 'CRE', ")
          ENDIF
          SQL.ADD(" '"~Val(x:4)~"', '"~Val(x:9)~"','"~Val(x:10)~"','"~Dialogo.String3~"', ")
          SQL.ADD(" '"~Dialogo.Especie1~"', '"~Val(x:5)~"', '"~Dialogo.NrOperacion1~"') ")
          SQL.NEW
          SQL.EXEC    
       ENDIF
    ELSE
       Cancelar
    ENDIF
    Proximo   
  endif
ENDIF
else
*   Cancelar('No hay Items para el Asiento solicitado')
messagebox('No hay Items para el Asiento solicitado')
endif

    Recorrer&i 1,100
    IF MessageBox('Agrega un Nuevo Item al Asiento?', 3,2) = 6
      CrearDialogo
         NrUnicoAsiento1: 'Asiento'          ;1;1;;NO;;;;;Val(x:5)
         Entero1        : 'Item'             ;1;2;;  ;;;;;
         String1        : 'Cuenta'           ;4;1;;  ;;NOVACIO(Dialogo.String1);'Debe ingresar una Cuenta V lida';NO  
         Especie1       : 'Especie'          ;5;1;;  ;;NOVACIO(Dialogo.Especie1);'Debe ingresar una Especie valida';NO  
         Radio1         : ' |Debito|Credito' ;6;1;;  ;;;;;0  
         Cantidad1      : 'Cantidad 1'       ;7;1;;  ;;Dialogo.Cantidad1>0;'Debe ingresar una Cantidad valida';NO
         Cantidad2      : 'Cantidad 2'       ;8;1;;  ;;
         Cantidad3      : 'Cantidad 3'       ;9;1;;  ;;
         String2        : 'Cod._Operacion'   ;10;1;;  ;;NOVACIO(Dialogo.String2);'Falta ingresar Codigo de Operacion';SI
         String3        : 'Detalle'          ;11;1;;  ;;NOVACIO(Dialogo.String3);'Falta ingresar Detalle';SI
         NrOperacion1   : 'NrOperacion'      ;12;1;;;;;;;Val(x:6)
      FinDialogo

       IF OK
          ACT(x:6, Dialogo.NrOperacion1)
          ACN(x:4,Dialogo.Cantidad1 )
          ACN(x:9, Dialogo.Cantidad2 )
          ACN(x:10, Dialogo.Cantidad3 )
          ACT(x:7, FSTR(Dialogo.Entero1,1,0))

          SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1  ")
          SQL.ADD(" (Cuenta, Alias1, Alias3, ")
          SQL.ADD("  DebitoCredito, ")
          SQL.ADD("  Cantidad1, Cantidad2, Cantidad3, Detalle,  ")
          SQL.ADD("  Especie1, NrUnicoAsiento, NrOperacion) ")
          SQL.ADD("  VALUES ")
          SQL.ADD(" ('"~Dialogo.String1~"', '"~Dialogo.String2~"', '"~Val(x:7)~"', ")
          IF Dialogo.Radio1=0 
             SQL.ADD(" 'DEB', ")
          ENDIF
          IF Dialogo.Radio1=1
             SQL.ADD(" 'CRE', ")
          ENDIF
          SQL.ADD(" '"~Val(x:4)~"', '"~Val(x:9)~"','"~Val(x:10)~"','"~Dialogo.String3~"', ")
          SQL.ADD(" '"~Dialogo.Especie1~"', '"~Val(x:5)~"', '"~Dialogo.NrOperacion1~"') ")
          SQL.NEW
          SQL.EXEC    
       ENDIF
    ELSE
       Cancelar
    ENDIF
Proximo
