CrearDialogo
  NrOperacion1: 'Nr.Operacion' ;1;1; ;NO;NO;Vacio(Dialogo.NrOperacion1) o [Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'FXCF|FXVF') y EqStr(BuscarCampo('OPERACIONES','Mercado','NrOperacion',Dialogo.NrOperacion1),'ROFEX') y BuscarCampo('OPERACIONES','CB7','NrOperacion',Dialogo.NrOperacion1)=1];'Operacion Invalida';NO;;;;;;" TipoOp in ('FXCF','FXVF') and Mercado='ROFEX' and CB7=1 "
  Check1:       'Procesa'      ;1;2; ;SI;SI;;;;1;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(1)
ACT(a:FAC, 'NrOp')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'Boleto')
ACT(d:FAC, 'Mercado')
ACT(e:FAC, 'CB7')
ACT(f:FAC, '# MTM')
ACT(g:FAC, '# OpROFEX')
ACT(h:FAC, 'Boleta OpR')
ACT(k:FAC, 'Control')
SetFont(a:FAC..z:FAC, 2)

SQL.ADD("Select O.* ")
SQL.ADD("From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("Where O.Mercado = 'ROFEX' ")
SQL.ADD("  AND O.TipoOp  IN ('FXCF','FXVF') ")
SQL.ADD("  AND O.CB7     = 1 ")
IF NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ENDIF
SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
SQL.ADD("   and B.NrBit       in (10) ")
SQL.ADD("   and B.Valor       = '1' ")
SQL.ADD(" Order By O.NrOperacion ")
Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACT(c:FAC, fbn('NrBoleto'))
  ACT(d:FAC, fbn('Mercado'))
  ACT(e:FAC, fbn('CB7'))
  ACN(f:FAC, SQL("Select Count(*) from "~DBO~".MTMDIARIO where NrOperacion = '"~Val(a:FAC)~"' "))
  if Val(f:FAC)>0
    ACT(k:FAC, 'Error')
  endif
  ACN(g:FAC, SQL("Select Count(*) from "~DBO~".OPROFEX where NrOperacion = '"~Val(a:FAC)~"' "))
  if Val(g:FAC)<=0
    ACT(k:FAC, 'Error')
  endif
  if Val(g:FAC)>1
    ACT(k:FAC, 'Error')
  endif
  if Val(g:FAC)=1
    ACT(h:FAC, SQL("Select Boleta from "~DBO~".OPROFEX where NrOperacion = '"~Val(a:FAC)~"' "))
  endif
  if Not EqStr(Pad0(Val(h:FAC),8),Val(c:FAC))  
    ACT(i:FAC, 'Difr')
    ACT(k:FAC, 'Error')
  else
    ACT(i:FAC, 'OK')
  endif
  If NoVacio(Val(k:fac))
    SCN(x:1, 1)
    ACT(k:FAC, 'Anula')
    IF Dialogo.Check1=1
      SCN(x:2, 1)
      SQL.ADD(" Delete "~DBO~".OPERACIONES ")
      SQL.ADD("  Where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.NEW

      SQL.ADD(" Update "~DBO~".OPROFEX ")
      SQL.ADD("    Set Procesado = '0', NrOperacion = Null, Warning = Null ")
      SQL.ADD("  Where Boleta = '"~Val(h:FAC)~"' ")
      SQL.NEW
      SQL.EXEC
    endif
  endif

proximo
SetFont(a:2..k:FAC, 1)

if Val(x:2)=0
  MessageBox('El evento finalizo correctamente. No se anulo ninguna operacion')
endif
if Val(x:2)=1
  MessageBox('El evento finalizo correctamente. Se anulo 1 operacion')
endif
if Val(x:2)>1
  MessageBox('El evento finalizo correctamente. Se anularon '~PYC(Val(x:2),1,0)~' operaciones')
endif
