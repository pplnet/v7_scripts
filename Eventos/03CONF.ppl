* Este evento es invocado desde CONFCO y CONFPA
* Si Radio1=0, instancia 3 (conf. de Cobros)
* Si Radio1=1, instancia 6 (conf. de Pagos)
* Si Radio1=2, instancia 3 y 6 (conf. de Cobros y Pagos)
* Se utiliza en CMOVD1 / CONFOP / REENVT - Revisar parámetros
HojaVisible(NO)
MostrarcuadrodeMensajes
CrearDialogo
  Radio1   : 'Tipo de Accion|Cobros|Pagos|Ambos';;;;;;;;;2
  Mercado1 : 'Mercado'   ;
  Especie1 : 'Especie'   ;
  Vehiculo1: 'Vehiculo'  ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;Var('VEHICULODE');
  Radio2   : 'Confirmar:|Solo Fecha Liq.|Hasta Fecha Liq.';;;;;;;;;0
  Fecha1   : 'Fecha Liq.';;;;;;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys;'Fecha incorrecta';NO;Habiles(FSys,0,'ARG');
  Cliente1 : 'Cliente'   ;
  NrTrans1 : 'Voucher'   ;;;;;;;;;;;
  Check1   : 'Batch'     ;1;;;NO;NO;;;;0;
  Check2   : 'Fallas?'   ;9;;;;;;;;0;
FinDialogo

if Not Ok
  Cancelar
endif

ACT(y1, Fecha(FSys, 'YYYY.MM.DD'))

if NoVacio(Dialogo.Especie1)
  ACT(zz1," '")
  SQL.ADD("Select * from "~DBO~".ESPECIES" )
  recorrer SQL
    if DesciendeDeEspecie(FBN['Codigo'],Dialogo.Especie1)
      ACT(zz1,val(zz1)~FBN['Codigo']~"','" )
    Endif
  proximo
  ACT(zz1,val(zz1)~"' ")
  SetFilaActual(0)
endif

*********************
* Confirmacion de C/P
*********************
Message('Generando datos de confirmacion')
SQL.ADD("Select T.Mercado1, T.TipoTr2, T.Cliente1, T.CB5, T.NrOperacionRef1, T.NrTrans, T.Especie, T.Cantidad1, B.NrBit, ")
SQL.ADD("       T.Fecha2, T.Cuenta1, T.Cuenta2, T.Especie1, T.Cantidad2, T.Cupon1, T.CB6, T.CB7, T.CB8, T.NrOperacionRef2, T.CB3 ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where T.NrTrans = B.NrOperacion")
SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and (T.CB9 = '0' or T.CB9 is NULL) ")
SQL.ADD("AND T.Mercado1 <> '"~Var('MERCOCT')~"' ")
SQL.ADD("AND T.Mercado1 not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("AND IsNull(T.Ley4,'') Not In ("~Pipe2Comillas(VAR('RUECPC1'))~")  ")

SQL.ADD("and ")
SQL.ADD("( ")
SQL.ADD("  ( ")
If Dialogo.Radio2=0
   SQL.ADD("    T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
Else
   SQL.ADD("    T.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
SQL.ADD("    and (T.CB3 = '0' or T.CB3 is NULL) ")
SQL.ADD("  )  ")
SQL.ADD("  or ")
SQL.ADD("  (  ")
SQL.ADD("    T.Fecha2 < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and T.CB3 = '1' ")
SQL.ADD("    and Not T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and Convert(Char,I.Fecha,102) = '"~Val(y1)~"') ")
SQL.ADD("  )  ")
SQL.ADD(")    ")
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and T.Mercado1 = '"~Dialogo.Mercado1~"' ")
endif
if NoVacio(Dialogo.Especie1)
 SQL.ADD("and (T.Especie =  '"~Dialogo.Especie1~"' or T.Especie In ("~val(zz1)~") )")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
If Dialogo.Radio1=0
   SQL.ADD("and B.NrBit = 3 ")
Endif
If Dialogo.Radio1=1
   SQL.ADD("and B.NrBit = 6 ")
Endif
If Dialogo.Radio1=2
   SQL.ADD("and (B.NrBit = 6 or B.NrBit = 3)")
Endif
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD("AND T.NrTrans = '"~Dialogo.NrTrans1~"'          ")
Endif

SQL.ADD("and B.Valor = '1' ")
SQL.ADD("Order By 1, 7, 3   ")
watch(SQL.BATCH())
Message('Procesando datos')
Recorrer SQL;;SI
  Message('Generando detalle '~FBN['NrTrans'])
  ACT(aa:FAC, FBN['NrTrans'])
  ACT(ab:FAC, FBN['TipoTr2'])
  ACT(ac:FAC, FBN['Mercado1'])
  ACT(ad:FAC, FBN['Cliente1'])
  ACT(ae:FAC, FBN['Especie'])
  ACN(af:FAC, FBN['Cantidad1'])
  ACT(ag:FAC, FBN['Cuenta1'])
  ACT(ah:FAC, FBN['Cuenta2'])
  ACT(ai:FAC, FBN['Especie1'])
  ACN(aj:FAC, FBN['Cantidad2'])
  ACT(ak:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(aa:FAC)~"'      and Especie = '"~Val(ae:FAC)~"'"))
  ACT(al:FAC, FBN['Cupon1'])
  ACT(ap:FAC, FBN['NrOperacionRef2'])
  ACT(aq:FAC, FBN['CB3'])

  ACT(a:FAC, FBN['Cliente1'])
  ACT(b:FAC, FBN['Mercado1'])
  ACT(c:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(aa:FAC)~"'      and Especie = '"~Val(ae:FAC)~"'"))
  ACT(h:FAC, ' ')

  if Dialogo.Check1=1
     ACN(l:FAC, 1 )
  else   
     ACN(l:FAC, 0 )
  endif
  
  If EqStr(FBN['TipoTr2'],'MATCH')
    ACT(d:FAC, 'Matcheo')
    ACT(e:FAC, FBN['Especie']~'/'~FBN['Especie1'])
    ACN(f:FAC, -FBN['Cantidad1'])
    ACN(g:FAC, -FBN['Cantidad2'])
    ACT(h:FAC, ' ')
  else
    if Incluido(FBN['TipoTr2'],'DEP|RET')
      ACT(e:FAC, FBN['Especie'])
      if EqStr(FBN['TipoTr2'],'DEP')
        ACT(d:FAC, 'Cobro')
        if DesciendeDeEspecie(FBN['Especie'],'TITULO')
           ACN(f:FAC, FBN['Cantidad1'])
           ACN(g:FAC, 0)
        else
           ACN(f:FAC, 0)
           ACN(g:FAC, FBN['Cantidad1'])
        endif
      else
        ACT(d:FAC, 'Pago')
        if DesciendeDeEspecie(FBN['Especie'],'TITULO')
           ACN(f:FAC, -FBN['Cantidad1'])
           ACN(g:FAC, 0)
        else
           ACN(f:FAC, 0)
           ACN(g:FAC, -FBN['Cantidad1'])
        endif
      endif
      if FBN['CB6']+FBN['CB7']+FBN['CB8']>1
         ACT(h:FAC, 'Error')
      else
         if FBN['CB6']=1
            ACT(h:FAC, 'DVP')
         endif
         if FBN['CB6']=1
            ACT(h:FAC, 'RVP')
         endif
         if FBN['CB6']=1
            ACT(h:FAC, 'Conf')
         endif
      endif
    else
      ACT(d:FAC, 'Error')
    endif
  endif
  ACT(i:FAC, FBN['NrTrans'])
  ACT(j:FAC, FBN['Fecha2'])
  If FBN['NrBit']=3
    ACT(k:FAC, 'Cobro')
  Endif
  If FBN['NrBit']=6
    ACT(k:FAC, 'Pago')
  Endif  
  
proximo

ACO(1,9)
ACO(2,4)
ACO(3,3)
ACO(4,7)
ACO(5,9)
ACO(6,12)
ACO(7,12)
ACO(8,4)
ACO(9,7)
ACO(10,9)
FormatoCeldas(f:1..g:FAC,Exe('F2'))

if FAC>0
   
* Asigno colores a cada tipo de acción   
   acn(cp:1,RGB(132,197,202) )
   acn(cp:2,RGB(250,142,131) )
  
   If Dialogo.Check1=0
       CrearListBox ; 'Arial,8,';'Confirmacion de '~IIF(Dialogo.Radio1=0,'COBROS',IIF(Dialogo.Radio1=1,'PAGOS ',IIF(Dialogo.Radio1=2,'COBROS Y PAGOS')))
          'OK'         ;l:1..l:Fac;SI;;;40 ;CHECK;;
          'Cliente '   ;a:1..a:Fac;NO;;;70 ;STRING;;
          'Mercado '   ;b:1..b:Fac;NO;;;70 ;STRING;;
          'Concepto'   ;c:1..c:Fac;NO;;;60 ;STRING;;
          'Accion  '   ;d:1..d:Fac;NO;;;60 ;STRING;;
          'Especie '   ;e:1..e:Fac;NO;;;60 ;STRING;;
          'Titulos '   ;f:1..f:Fac;NO;;;100;NUMERO;'###,###,###,###.##';
          'Moneda  '   ;g:1..g:Fac;NO;;;100;NUMERO;'###,###,###,###.##';
          '      '     ;h:1..h:Fac;NO;;;60 ;STRING;;
          'Voucher '   ;i:1..i:Fac;NO;;;60 ;STRING;;
          'Fecha  '    ;j:1..j:Fac;NO;;;60 ;STRING;;
          'Accion '    ;k:1..k:Fac;NO;;;60 ;STRING;;
       FinListBox

       IF NOT OK 
          Cancelar
       Endif 
   Endif 
   Message('Procesando datos...')
   Recorrer&j 1,Fac
   Message('Eliminando instancias anteriores')
     if Val(l:&j) = 1
        SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
        SQL.ADD("Where NrOperacion = '"~Val(i:&j)~"' ")
        If Dialogo.Radio1 = 0
           SQL.ADD("and NrInstancia = 3 ")
        Endif
        If Dialogo.Radio1 = 1
           SQL.ADD("and NrInstancia = 6 ")
        Endif
        If Dialogo.Radio1 = 2
            SQL.ADD("and NrInstancia = 6 or NrInstancia = 3")
        Endif
        
        SQL.NEW
        Message('Actualizacion instancias '~Val(i:&j))
        SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
        SQL.ADD("NrOperacion, ")
        SQL.ADD("NrInstancia, ")
        SQL.ADD("Usuario, ")
        SQL.ADD("Mensaje, ")
        SQL.ADD("Fecha ")
        SQL.ADD(") Values (")
        SQL.ADD("'"~Val(i:&j)~"', ")
        If EqStr(Val(k:&j),'Cobro')
           SQL.ADD("3, ")
        Else
           SQL.ADD("6, ")
        Endif
        SQL.ADD("'"~UsuarioActivo~"', ")
        SQL.ADD("'Confirmacion de Voucher', ")
        SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
        SQL.ADD(")")
        SQL.NEW

        SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
        SQL.ADD("SET CB9 = '1', Fecha3 = '"~IdxDate(FSys)~"'")
        SQL.ADD("Where NrTrans = '"~Val(i:&j)~"' ")
        SQL.NEW

        SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD("SET Valor = '0' ")
        SQL.ADD("where NrOperacion = '"~Val(i:&j)~"' ")
        If Dialogo.Radio1 = 0
           SQL.ADD("and NrBit = 3 ")
        Endif
        If Dialogo.Radio1 = 1
           SQL.ADD("and NrBit = 6 ")
        Endif
        If Dialogo.Radio1 = 2
            SQL.ADD("and (NrBit = 6 or NrBit = 3)")
        Endif
                
        SQL.NEW

        SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
        SQL.ADD("SET Valor = '1' ")
        SQL.ADD("where NrOperacion = '"~Val(i:&j)~"' ")
        SQL.ADD("and NrBit = 70 ")
        SQL.NEW
        SQL.EXEC

        if Incluido(Val(ab:&j),'MATCH|DEP|RET')
           Message('Desafectando limites')
           EjecutarEvento('DESPRF',NrTrans1=Val(i:&j),Fecha1=fsys,Fecha2=Dialogo.Fecha1)
        endif

        * --- FO 27/04/2006  --------------------------- *
        * Si es match y estaba fallado, se borran los movimientos de anulacion de liquidacion
*fo 31/08        if Eqstr(Val(ab:&j),'MATCH') y Eqstr(Val(aq:&j),'1')

        if Incluido(Val(b:&j), VAR('MERCTITULO')) y Eqstr(Val(aq:&j),'1')
           Message('Actualizacion falla')
           SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS ")
           SQL.ADD(" WHERE NrOperacion = '"~Val(i:&j)~"' AND Transaccion = 'Falla' ")
        Endif
        * ---------------------------------------------- *

        if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(ap:&j)),'DTP|RTP')
           **- Marco la Transaccion que se esta matcheando -**
           Message('Actualizando transaccion '~Val(ap:&j))
           SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2                                ")
           SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Dialogo.Fecha1)~"',         ")
           SQL.ADD("       Cupon2='"~Fstr(NrCupon2(val(ae:&j),Dialogo.Fecha1),0,0)~"', ")
           SQL.ADD("       CB9 = '1',CB10='0'                                    ")
           SQL.ADD("WHERE  NrTrans= '"~Val(ap:&j)~"'                             ")
           SQL.NEW
           SQL.EXEC
           Message('Actualizando movimientos')
           SQL.ActualizarMovimientosT2(Val(ap:&j),SI,NO,NO,SI,0,4)           
           SQL.EXEC
           Message('Fin actualizacion de movimientos')
 
           *- Pasa de Instancia
           ACT(az3,Val(ap:&j))
           ACT(az4,'TRANSACCIONES2')
           ACN(az5,70)
           ACN(az6,1 )
           (.'MODIINSTAN'.)            
        endif
     Endif 
   proximo
Else
  if Dialogo.Check1=0
     If Dialogo.Radio1 = 0
          MessageBox('No hay Cobros para Confirmar.')
       Endif
       If Dialogo.Radio1 = 1
          MessageBox('No hay Pagos para Confirmar.')
       Endif
       If Dialogo.Radio1 = 2
          MessageBox('No hay Pagos ni Cobros para Confirmar.')
       Endif
   Endif
   Cancelar
Endif

**********************
* Generacion de Fallas
**********************
if Dialogo.Check2=1
    Message('Generando datos de fallas')
    SetFilaActual(0)
    SQL.ADD("Select T.Mercado1, T.TipoTr2, T.Cliente1, T.CB5, T.NrOperacionRef1, ")
    SQL.ADD("       B.NrBit, T.NrTrans, T.Especie, T.Cantidad1, T.Fecha2, ")
    SQL.ADD("       T.Cuenta1, T.Cuenta2, T.Especie1, T.Cantidad2, T.Cupon1, ")
    SQL.ADD("       T.CB6, T.CB7, T.CB8, T.NrOperacionRef2 , T.RB7, ")
    SQL.ADD("       T.RB2, ")
    ** FJL 10/06/19 - Para Informe Fails
    SQL.ADD("       T.ConceptoFail ")
    SQL.ADD("  from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
    SQL.ADD(" where T.NrTrans = B.NrOperacion")
    SQL.ADD("   and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD("   and (T.CB9 = '0' or T.CB9 is NULL) ")
    SQL.ADD("   AND T.Mercado1 <> '"~Var('MERCOCT')~"' ")
    SQL.ADD("   AND T.Mercado1 not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
    SQL.ADD("   AND isNull(T.Ley4,'') Not In ("~Pipe2Comillas(VAR('RUECPC1'))~")  ")
    SQL.ADD("   and ( ")
    SQL.ADD("         ( ")
    If Dialogo.Radio2=0
       SQL.ADD("       T.Fecha2  = '"~IdxDate(Dialogo.Fecha1)~"' ")
    Else
       SQL.ADD("       T.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    Endif
    SQL.ADD("          and (T.CB3 = '0' or T.CB3 is NULL) ")
    SQL.ADD("         ) ")
    SQL.ADD("         or ")
    SQL.ADD("         ( ")
    SQL.ADD("          T.Fecha2 < '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("          and T.CB3 = '1' ")
    SQL.ADD("          and Not T.NrTrans in (Select NrOperacion from "~DBO~".INSTANCIASOP where NrInstancia = 30 and Convert(Char,Fecha,102) = '"~Val(y1)~"') ")
    SQL.ADD("         ) ")
    SQL.ADD("       ) ")
    if NoVacio(Dialogo.Mercado1)
      SQL.ADD(" and T.Mercado1 = '"~Dialogo.Mercado1~"' ")
    endif
    if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and (T.Especie = '"~Dialogo.Especie1~"' or T.Especie In ("~val(zz1)~") ) ")
    endif
    if NoVacio(Dialogo.Cliente1)
       SQL.ADD(" and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
    endif
    If Dialogo.Radio1 = 0
       SQL.ADD(" and B.NrBit = 3 ")
    Endif
    If Dialogo.Radio1 = 1
       SQL.ADD(" and B.NrBit = 6 ")
    Endif
    If Dialogo.Radio1 = 2
        SQL.ADD(" and (B.NrBit = 6 or B.NrBit = 3)")
    Endif
    If NoVacio(Dialogo.NrTrans1)
       SQL.ADD("AND T.NrTrans = '"~Dialogo.NrTrans1~"'          ")
    Endif
    SQL.ADD("     and B.Valor = '1'")
    SQL.ADD("   Order By 1, 7, 3")

    Recorrer SQL;;SI
      Message('Generando detalle de fallas '~FBN['NrTrans'])
      ACT(ca:FAC, FBN['NrTrans'])
      ACT(cb:FAC, FBN['TipoTr2'])
      ACT(cc:FAC, FBN['Mercado1'])
      ACT(cd:FAC, FBN['Cliente1'])
      ACT(ce:FAC, FBN['Especie'])
      ACN(cf:FAC, FBN['Cantidad1'])
      ACT(cg:FAC, FBN['Cuenta1'])
      ACT(ch:FAC, FBN['Cuenta2'])
      ACT(ci:FAC, FBN['Especie1'])
      ACN(cj:FAC, FBN['Cantidad2'])
      ACT(ck:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(ca:FAC)~"'      and Especie = '"~Val(ce:FAC)~"'"))
      ACT(cl:FAC, FBN['Cupon1'])

      ACT(cm:FAC, FBN['NrOperacionRef1'])
      ACT(cn:FAC, FBN['NrOperacionRef2'])
    ** FJL 10/06/19 - Para Informe Fails
      ACT(co:fac, fbn('ConceptoFail'))

      ACT(ba:FAC, FBN['Cliente1'])
      ACT(bb:FAC, FBN['Mercado1'])
      ACT(bc:FAC, SQL("Select Concepto from "~DBO~".MOVEJECUTADOS   where NrOperacion = '"~Val(ca:FAC)~"'      and Especie = '"~Val(ce:FAC)~"'"))
      ACT(bh:FAC, ' ')
      if EqStr(FBN['TipoTr2'],'MATCH')
        ACT(bd:FAC, 'Matcheo')
        ACT(be:FAC, FBN['Especie']~'/'~FBN['Especie1'])
        ACN(bf:FAC, -FBN['Cantidad1'])
        ACN(bg:FAC, -FBN['Cantidad2'])
        ACT(bh:FAC, ' ')
      else
        if Incluido(FBN['TipoTr2'],'DEP|RET')
          ACT(be:FAC, FBN['Especie'])
          if EqStr(FBN['TipoTr2'],'DEP')
            ACT(bd:FAC, 'Cobro')
            ACN(bp:FAC, FBN['Cantidad1'])
            if DesciendeDeEspecie(FBN['Especie'],'TITULO')
              ACN(bf:FAC, FBN['Cantidad1'])
              ACN(bg:FAC, 0)
            else
              ACN(bf:FAC, 0)
              ACN(bg:FAC, FBN['Cantidad1'])
            endif
            ACN(bp:FAC, FBN['Cantidad1'])
          else
            ACT(bd:FAC, 'Pago')
            if DesciendeDeEspecie(FBN['Especie'],'TITULO')
              ACN(bf:FAC, -FBN['Cantidad1'])
              ACN(bg:FAC, 0)
            else
              ACN(bf:FAC, 0)
              ACN(bg:FAC, -FBN['Cantidad1'])
            endif
            ACN(bp:FAC, -FBN['Cantidad1'])
          endif
          if FBN['CB6']+FBN['CB7']+FBN['CB8']>1
            ACT(bh:FAC, 'Error')
          else
            if FBN['CB6']=1
              ACT(bh:FAC, 'DVP')
            endif
            if FBN['CB6']=1
              ACT(bh:FAC, 'RVP')
            endif
            if FBN['CB6']=1
              ACT(bh:FAC, 'Conf')
            endif
          endif
          ACN(bm:FAC, FBN['CB6'])
          ACN(bn:FAC, FBN['CB7'])
          ACN(bo:FAC, FBN['CB8'])
        else
          ACT(bd:FAC, 'Error')
        endif
      endif
      ACT(bi:FAC, FBN['NrTrans'])
      ACT(bj:FAC, FBN['Fecha2'])
      ACT(bk:FAC, FBN['Especie'])
      ACT(bl:FAC, FBN['Cupon1'])
      ACT(bq:FAC, FBN['Cuenta1'])
      ACT(br:FAC, FBN['Cuenta2'])
      ACT(bs:FAC, FBN['NrOperacionRef2'] )
      If FBN['NrBit']=3
        ACT(bt:FAC, 'Cobro')
      Endif
      If FBN['NrBit']=6
        ACT(bt:FAC, 'Pago')
      Endif 
      if Dialogo.Check1=1
         ACN(bv:FAC,1)
      else
         ACN(bv:FAC,0)
      endif  
    * MB agregue que si RB7 es 1 es una liq de Comisiones MAE1 por lo tanto grabo Grupo en 15
     
      IF Eqstr(FBN['RB7'],'1')
         ACN(bw:FAC,15)
      Else
         ACN(bw:FAC,1)
      Endif

      ACT(bz:FAC,FBN['RB2'] )
    Proximo

    ACO(53,9)
    ACO(54,4)
    ACO(55,3)
    ACO(56,7)
    ACO(57,9)
    ACO(58,12)
    ACO(59,12)
    ACO(60,4)
    ACO(61,7)
    ACO(62,9)
    FormatoCeldas(bf:1..bg:FAC,Exe('F2'))

    if FAC>0
      if Dialogo.Check1=0
          CrearListBox ; 'Arial,8,';'Generacion de Fallas '
            'OK'              ;bv:1..bv:Fac   ;SI;;;40 ;CHECK  ;Val(cp:1)
            'Cliente '        ;ba:1..ba:Fac   ;NO;;;70 ;STRING;;
            'Mercado '        ;bb:1..bb:Fac   ;NO;;;70 ;STRING;;
            'Concepto'        ;bc:1..bc:Fac   ;NO;;;30 ;STRING;;
            '        '        ;bd:1..bd:Fac   ;NO;;;60 ;STRING;;
            'Especie '        ;be:1..be:Fac   ;NO;;;60 ;STRING;;
            'Titulos '        ;bf:1..bf:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
            'Moneda  '        ;bg:1..bg:Fac   ;NO;;;100;NUMERO;'###,###,###,###.##'
            '      '          ;bh:1..bh:Fac   ;NO;;;60 ;STRING;;
            'Voucher '        ;bi:1..bi:Fac   ;NO;;;60 ;STRING;;
            'Fecha  '         ;bj:1..bj:Fac   ;NO;;;60 ;STRING;;
            'Accion '         ;bt:1..bt:Fac   ;NO;;;60 ;STRING;;
        ** FJL 10/06/19 - Para Informe Fails
            'Concepto Fail'   ;co:1..co:fac;SI;NoVacio(Val(co:flb)) o Val(bv:flb)=0;'Debe ingresar un concepto de Fail (linea '~FStr(flb,1,0)~')';60 ;TABLA;'CONCEPTOSFAILS';'Codigo';'Codigo;Descripcion';;Val(cp:1);
          FinListBox
          IF NOT OK 
             Cancelar
          ENDIF
      Endif
      
      Recorrer&j 1,Fac
        if Val(bv:&j) = 1
          ACT(cv:&j, 'OK')
          if EqStr(Val(cv:&j),'OK')
            if Not Incluido(Val(bb:&j), VAR('MERCTITULO'))
              *****************************
              ** Caja de Valores/Financiero
              *****************************

              Message('Generacion de Transporte Voucher '~Val(i:&j)~'.')
              ACT(bu:&j,GetNumerador(13))
              Message('Actualiza Voucher '~Val(bi:&j))

              * --- Si es una DEP/RET de titulos, borro su correspondiente RTP/DTP
              if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(bs:&j)),'DTP|RTP')  
                 Message('Actualizando movimientos')
                 SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS ")
                 SQL.ADD("where NrOperacion = '"~Val(bs:&j)~"'")
                 SQL.NEW
        
                 SQL.ADD("DELETE from "~DBO~".MOVPENDIENTES ")
                 SQL.ADD("where NrOperacion =  '"~Val(bs:&j)~"' ")
                 SQL.NEW

                 SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2       ")
                 SQL.ADD("SET CB10 = '1'                      ")
                 SQL.ADD("where NrTrans =  '"~Val(bs:&j)~"'   ")
                 SQL.NEW
              Endif
              Message('Actualizando instancias')
              SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
              SQL.ADD("Where NrOperacion = '"~Val(bi:&j)~"' ")
              If Dialogo.Radio1 =0
                 SQL.ADD("and NrInstancia = 3 ")
              Endif
              If Dialogo.Radio1 =1
                 SQL.ADD("and NrInstancia = 6 ")
              Endif
              If Dialogo.Radio1 =2
             SQL.ADD("and (NrInstancia = 6 or NrInstancia = 3)")
              Endif
              SQL.NEW
            
              SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
              SQL.ADD("NrOperacion, ")
              SQL.ADD("NrInstancia, ")
              SQL.ADD("Usuario, ")
              SQL.ADD("Mensaje, ")
              SQL.ADD("Fecha ")
              SQL.ADD(") Values (")
              SQL.ADD("'"~Val(bi:&j)~"', ")
              If EqStr(Val(bt:&j),'Cobro')
                 SQL.ADD("3, ")
              Else
                 SQL.ADD("6, ")
              Endif
              SQL.ADD("'"~UsuarioActivo~"', ")
              SQL.ADD("'Generacion de Falla', ")
              SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
              SQL.ADD(")")
              SQL.NEW

              SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
              SQL.ADD("   SET Fecha3 = '"~IdxDate(FSys)~"', ")
              SQL.ADD("       FechaTransp = '"~IdxDate(FSys)~"', ")
              SQL.ADD("       NrTransRef1 = '"~Val(bu:&j)~"', ")
              SQL.ADD("       CB3 = '1'")
              SQL.ADD(" Where NrTrans = '"~Val(bi:&j)~"' ")
              SQL.NEW

              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
              SQL.ADD("   SET Valor = '0' ")
              SQL.ADD(" where NrOperacion = '"~Val(bi:&j)~"' ")
              If Eqstr(Val(bt:&j),'Cobro')
                 SQL.ADD("and NrBit = 3 ")
              Else
                 SQL.ADD("and NrBit = 6 ")
              Endif
              SQL.NEW

              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
              SQL.ADD("   SET Valor       = '1' ")
              SQL.ADD(" where NrOperacion = '"~Val(bi:&j)~"' ")
              SQL.ADD("   and NrBit       = 8 ")
              SQL.NEW

              Message('Genera Transporte '~Val(bu:&j))
              SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")

              SQL.ADD(" TipoTr2, ")
              SQL.ADD(" Especie, ")
              SQL.ADD(" Fecha1, ")
              SQL.ADD(" Fecha2, ")
              SQL.ADD(" Cliente1, ")

              SQL.ADD(" Cantidad1, ")
              SQL.ADD(" Vehiculo1, ")
              SQL.ADD(" Mercado1, ")
              SQL.ADD(" Observaciones, ")
              SQL.ADD(" NrTransRef1, ")

              SQL.ADD(" CB6, ")
              SQL.ADD(" CB7, ")
              SQL.ADD(" CB8, ")
              SQL.ADD(" Cupon1, ")
              SQL.ADD(" Cuenta1, ")

              SQL.ADD(" Cuenta2, ")
              SQL.ADD(" NrTrans, ")
              SQL.ADD(" RB2,     ")

              SQL.ADD(" NrOperacionRef1, ")
              SQL.ADD(" NrOperacionRef2,  ")
    ** FJL 11/06/19 - Para Informe Fails
              SQL.ADD(" ConceptoFail, ")

              SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput ")

              SQL.ADD(") Values (")

              * TipoTr2
              SQL.ADD(" 'TRANSP', ")
              SQL.ADD(" '"~Val(bk:&j)~"', ")
              SQL.ADD(" '"~IdxDate(FSys)~"', ")
              SQL.ADD(" '"~IdxDate(FSys)~"', ")
              SQL.ADD(" '"~Val(ba:&j)~"', ")
              * Cantidad1
              SQL.ADD(" "~FStr(Val(bp:&j),1,2)~", ")
              SQL.ADD(" '"~Dialogo.Vehiculo1~"', ")
              SQL.ADD(" '"~Val(bb:&j)~"', ")
              SQL.ADD(" '"~'Transporte '~Val(bi:&j)~"', ")
              SQL.ADD(" '"~Val(bi:&j)~"', ")
              * CB6
              SQL.ADD(" '"~FStr(Val(bm:&j),1,0)~"', ")
              SQL.ADD(" '"~FStr(Val(bn:&j),1,0)~"', ")
              SQL.ADD(" '"~FStr(Val(bo:&j),1,0)~"', ")
              SQL.ADD(" '"~Val(bl:&j)~"', ")
              SQL.ADD(" '"~Val(bq:&j)~"', ")
              * Cuenta2
              SQL.ADD(" '"~Val(br:&j)~"', ")
              SQL.ADD(" '"~Val(bu:&j)~"', ")
              SQL.ADD(" '"~Val(bz:&j)~"', ")
              * NrOperacionRef1
              SQL.ADD(" '"~Val(cm:&j)~"', ")
              SQL.ADD(" '"~Val(cn:&j)~"', ")
    ** FJL 11/06/19 - Para Informe Fails
              SQL.ADD("  '"~Val(co:&j)~"', ")
              * FechaCarga
              SQL.ADD(" "~SQLAhora~", "~IdxDate2(FSys)~", '"~UsuarioActivo~"' ")
              SQL.ADD(")")
              SQL.NEW
              Message('Actualizando instancias...')
              SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
              SQL.ADD("(NrBit, NrOperacion, Valor) ")
              SQL.ADD("Select NrInstancia, '"~Val(bu:&j)~"', '0'")
              SQL.ADD("  from "~DBO~".INSTANCIAS ")
              SQL.ADD(" where Tabla = 'TRANSACCIONES2'")
              SQL.NEW

              SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
              SQL.ADD("   SET Valor       = '1' ")
              SQL.ADD(" Where NrBit       = 5 ")
              SQL.ADD("   and NrOperacion = '"~Val(bu:&j)~"' ")
              SQL.NEW

              Message('Genera Movimientos Transporte '~Val(au:&j))
              SQL.ADD("Insert into "~DBO~".MOVPENDIENTES ( ")
              SQL.ADD(" FechaMov, ")
              SQL.ADD(" Cliente, ")
              SQL.ADD(" Especie, ")
              SQL.ADD(" EnteCustodia, ")
              SQL.ADD(" Cantidad, ")

              SQL.ADD(" Leyenda, ")
              SQL.ADD(" NrSaldo, ")
              SQL.ADD(" NrMov, ")
              SQL.ADD(" NrGrupo, ")
              SQL.ADD(" Bits, ")

              SQL.ADD(" Status, ")
              SQL.ADD(" Cupon, ")
              SQL.ADD(" Mercado, ")
              SQL.ADD(" Concepto, ")
              SQL.ADD(" Cuenta, ")

              SQL.ADD("NrOperacion ")

              SQL.ADD(" ) Values ( ")
              SQL.ADD(" '"~IdxDate(FSys)~"', ")
              SQL.ADD(" '"~Val(ba:&j)~"', ")
              SQL.ADD(" '"~Val(bk:&j)~"', ")
              SQL.ADD(" '"~Dialogo.Vehiculo1~"', ")
              SQL.ADD(" "~FStr(-Val(bp:&j),1,2)~", ")

              SQL.ADD(" '"~'Transporte '~Val(bi:&j)~"', ")
              SQL.ADD(" "~FStr(1,1,0)~", ")
              SQL.ADD(" "~FStr(1,1,0)~", ")
              SQL.ADD(" "~FStr(Val(bw:&j),1,0)~", ")
              SQL.ADD(" 'MV', ")

              if Val(bo:&j)=1
                 SQL.ADD("'CONF', ")
              else
                 if Val(bm:&j)=1
                    SQL.ADD("'DVP', ")
                 else
                    if Val(bn:&j)=1
                       SQL.ADD("'RVP', ")
                    else
                       SQL.ADD("'', ")
                    endif
                 endif
              endif
              SQL.ADD(" '"~Val(bl:&j)~"', ")
              SQL.ADD(" '"~Val(bb:&j)~"', ")
              SQL.ADD(" '"~Val(bc:&j)~"', ")
              SQL.ADD(" '"~Val(bq:&j)~"', ")
              
              SQL.ADD(" '"~Val(bu:&j)~"' ")
              SQL.ADD(")")
              SQL.NEW

              Message('Anula Movimientos Voucher '~Val(bi:&j))
              SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
              SQL.ADD("NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
              SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
              SQL.ADD(") ")
              SQL.ADD("select ")
              SQL.ADD(" '"~Val(bu:&j)~"', FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD(" FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD(" '"~'Transporte '~Val(bi:&j)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD(" NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
              SQL.ADD(" '"~UsuarioActivo~"', Cuenta, Transaccion, -Cantidad, Cupon")
              SQL.ADD("  from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" where NrOperacion = '"~Val(bi:&j)~"' ")
              SQL.NEW

              SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
              SQL.ADD(" NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD(" FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD(" Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD(" NrMov, NrLiq, Status, NrInstan, FechaEje, ")
              SQL.ADD(" UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
              SQL.ADD(") ")
              SQL.ADD("select ")
              SQL.ADD("'"~Val(bu:&j)~"', FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD("'"~'Transporte '~Val(bi:&j)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
              SQL.ADD("'"~UsuarioActivo~"', Cuenta, Transaccion, -Cantidad, Cupon")
              SQL.ADD("  from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" where NrOperacion <> '"~Val(bi:&j)~"' ")
              SQL.ADD("   and NrTrans2 = '"~Val(bi:&j)~"' ")
              SQL.NEW  
            Else
              ***************************
              ** Cedel / CRYL / EuroClear
              ***************************
              Message('Falla Voucher '~Val(i:&j)~'.')
              SQL.ADD("Insert into "~DBO~".INSTANCIASOP ( ")
              SQL.ADD("       NrOperacion, NrInstancia, Usuario, Mensaje, Fecha ")
              SQL.ADD(" ) Values ( ")
              SQL.ADD(" '"~Val(bi:&j)~"', ")
              SQL.ADD(" 30, ")
              SQL.ADD(" '"~UsuarioActivo~"', ")
              SQL.ADD(" 'Generacion de Falla', ")
              SQL.ADD(" "~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
              SQL.ADD(" ) ")
              SQL.NEW

              SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
              SQL.ADD("   SET CB3     = '1', ")
              SQL.ADD("       Fecha3  = '"~IdxDate(FSys)~"', ")
    ** FJL 10/06/19 - Para Informe Fails
              SQL.ADD("       ConceptoFail = '"~Val(co:&j)~"' ")
              SQL.ADD(" Where NrTrans = '"~Val(bi:&j)~"' ")
              SQL.NEW

              * --- FO 27/04/2006 - Agrego Mov al voucher para que desafecten el Saldo --- *
              Message('Desafectando saldo')
              SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
              SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
              SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
              SQL.ADD(") ")
              SQL.ADD("select ")
              SQL.ADD(" '"~Val(bi:&j)~"', FechaMov, Cliente, Especie, CallPut, ")
              SQL.ADD(" FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
              SQL.ADD(" '"~'Falla Match'~Val(bi:&j)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
              SQL.ADD(" NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
              SQL.ADD(" '"~UsuarioActivo~"', Cuenta, 'Falla', -Cantidad, Cupon")
              SQL.ADD("  from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" where NrOperacion = '"~Val(bi:&j)~"' ")
              SQL.NEW  
              * -------------------------------------------------------------------------- *
            Endif

            * Funcion para afectar limites por fallas
            (.'GENFALLAS2'.)
            SQL.EXEC
          Else
            if Dialogo.Check1=0
               MessageBox('No se puede fallar el Voucher '~Val(i:&j)~'.')
            Endif   
          Endif
        Endif
      Proximo
    Else
      if Dialogo.Check1=0
         MessageBox('No hay Fallas para generar.')
      Endif   
    Endif
endif
