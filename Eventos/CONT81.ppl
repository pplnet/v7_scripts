MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:   'Fecha'       ;;;;;;;;;fsys
  Lista1:   'Vehiculos'   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-4;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Transferencias FCI ---')

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad, O.ContraEspecie Moneda, MA.Codigo CodAsi, ")
SQL.ADD(" O.Vehiculo1, O.Especie, O.FechaVto, O.FechaOp, O.Cuenta4 Cuenta2, O.TipoOp, ")
SQL.ADD(" O.Cuenta1, V.Valor1, V.Valor2, O.Cliente1, O.Precio1, O.Plazo, O.Observaciones, M.Cuenta, ")
SQL.ADD(" '' Alias8, M.NrTrans2, O.ContraEspecie Cotiza, O.MB3, V.Alias4, O.FechaPago FechaCobro, O.CB7 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND T.NrOperacionRef1 = O.NrOperacion ")
SQL.ADD(" AND T.NrTrans     =  M.NrTrans2 ")
SQL.ADD(" AND T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND O.Vehiculo1 =  V.Codigo  ")
SQL.ADD(" AND O.TipoOp in ('TRANFC') ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITRAN'))~") ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVAcio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ( ")
          Recorrer&i 1,Elementos(Dialogo.Lista1)
            SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
            If NOT Elementos(Dialogo.Lista1)=&i
                SQL.ADD(" OR ")
            EndIf
          proximo
        SQL.ADD(") ")
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" ORDER By MA.Codigo, O.NrOperacion ")

Recorrer SQL
   ACD(FV:1, fbn('FechaVto'))
   ACT(VH:1, fbn('Vehiculo1'))
   ACT(CT:9, CotizaEn(FBN('Especie')))
  
   ACN(CN:1, FBN('Cantidad'))
   **// Cotizacion a la Fecha real en que se devuelven los dividendos
   ACN(CT:1, CotizacionC(fbn('Especie'),,,,fbn('FechaVto'),1,SI,Val(CT:9)))
   **// Cotizacion a la Fecha de cobro de dividendos
   ACN(CT:2, CotizacionC(fbn('Especie'),,,,fbn('FechaCobro'),1,SI,Val(CT:9))) 
   ***---Cotizacion a fin de mes anterior
   ACN(CT:3, CotizacionC(fbn('Especie'),,,,FinDeMes(PriDeMes(Dialogo.Fecha1, SI)-1, NO),1,SI,Val(CT:9)))
   **//Revaluo
   ACN(RV:1, Val(CN:1)*(Val(CT:1)-Val(CT:2)))
   **//Total
   ***---ACN(MA:1, Val(CN:1)*Val(CT:1))
   ACN(MA:1, Val(CN:1)*Val(CT:3))

   **//(.'FECHAVALOR'.)
   ACN(CK:1, 0)
   IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
      ACN(CK:1, 1)
      IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND NrTrans2 = '"~fbn('NrTrans2')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
         ACN(CK:1, 0)
      ENDIF
   ENDIF
   IF Val(CK:1) = 0
      **//MessageBoX('Revaluo: '~Fstr(Val(RV:1),0,2))
      **//MessageBoX('Total: '~Fstr(Val(MA:1),0,2))

      message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
      SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans2'),,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
   ENDIF
Proximo