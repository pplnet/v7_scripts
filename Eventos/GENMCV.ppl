CrearDialogo
  Fecha1:    'Fecha'    ;;;;;;Dialogo.Fecha1<=FSys y Dialogo.Fecha1>0;'Fecha incorecta';NO;FSys
  Entero1:   'Prueba'   ;;;;;;Dialogo.Entero1>0;'Prueba incorecta';NO;0
  Especie1:  'Especie'  ;;;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Especie incorecta';NO;'EUR'
  Cantidad1: 'Cantidad' ;;;;;;Dialogo.Cantidad1<>0;'Cantidad incorecta';NO;
  Vehiculo1: 'Vehiculo' ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo incorecto';NO;Var('VEHICULODE')
  String:    'Cta.Cont.';;;;;;NoVacio(Dialogo.String);'Cta.Contable incorecta';NO;
  Radio1:    'Origen|FPA|Otro';;;;;;;;;1
  Check1:    'Procesa'  ;;;;;;;;;1
FinDialogo
if Not OK
  Cancelar
endif

ACT(a:1, 'Mov.Prueba '~FStr(Dialogo.Entero1,1,0))
if Dialogo.Radio1=0
  ACT(a:2, 'FPA')
else
  ACT(a:2, 'OTRO')
endif
if Dialogo.Check1=1
  SQL.ADD("INSERT INTO "~DBO~".MOVCTAVISTA ")
  SQL.ADD("( CodigoSAP, Vehiculo, FechaCarga, FechaDoc, FechaValor, CuentaContable, Moneda, ImporteMonedaLocal, ImporteMonedaDoc, SistemaOrigen) ")
  SQL.ADD(" Values ") 
  SQL.ADD("( '"~Val(a:1)~"'    , '"~Dialogo.Vehiculo1~"', '"~IdxDate(FSys)~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Dialogo.String~"', '"~Dialogo.Especie1~"', "~FStr(Dialogo.Cantidad1,1,2)~", "~FStr(Dialogo.Cantidad1,1,2)~", '"~Val(a:2)~"') ")
  SQL.NEW
  SQL.EXEC
endif
