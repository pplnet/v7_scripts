**- COTATE: Copia de Tasas Diarias para Terceros
CrearDialogo
  Fecha1     : "F.Desde"           ;;;;;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Copia Desde';NO;FSYS
  Fecha2     : "F.Hasta"           ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Copia Hasta';NO;FSYS+1
FinDialogo

If not Ok
   Cancelar
endif

SQL.ADD("Select * FROM "~DBO~".TASASDIA Where  ")
SQL.ADD(" Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")
  
Recorrer SQL

   Message('Copiando Fecha '~FBN['Fecha']~' ...')

   * Inserto el nuevo valor
   SQL.ADD("INSERT INTO "~DBO~".TASASDIA ")
   SQL.ADD(" (Fecha,PlazoDesde,PlazoHasta,Especie,TipoTasa,Valor1) Values ")
   SQL.ADD(" ('"~IdxDate(Dialogo.Fecha2)~"',"~Fstr(FBN['PlazoDesde'],0,0)~","~Fstr(FBN['PlazoHasta'],0,0)~",'"~FBN['Especie']~"','"~FBN['TipoTasa']~"', "~Fstr(FBN['Valor1'],0,5)~") ")
   SQL.NEW
   SQL.EXEC      
Proximo

