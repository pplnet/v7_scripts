SQL.ADD(" Select * from "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Where ( NrBit = 45 ) and ( Valor = '1' ) ")
SQL.ADD(" Order by NrOperacion ")
Recorrer SQL
*  EscribirAscII(FBN['NrOperacion'])
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
  SQL.ADD(" Where NrBit=10 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '0' ")
  SQL.ADD(" Where NrBit=45 and NrOperacion='"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC
