CrearDialogo
  NrOperacion1:'NrOperacion';1;1;;;;Vacio(Dialogo.NrOperacion1) o SQL("SELECT 1 FROM "~DBO~".OPERACIONES O INNER JOIN "~dbo~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion and OB.Valor = 1 WHERE TipoOp = 'MMCREM' and O.NrOperacion = '"~Dialogo.NrOperacion1~"' and OB.NrBit IN ("~VAR('INSTCREM')~") and O.Sector1 = '"~Dialogo.String2~"'") = 1;'Operación o Sector Inválido!';NO;;;;;;"select OP.NrOperacion, OP.TipoOp, OP.Especie, OP.FechaOp, OP.Cliente1 from OPERACIONES OP LEFT JOIN CLIENTES C ON OP.Cliente1 = C.Codigo JOIN CUENTAS Cu on OP.Cuenta1 = Cu.Codigo  INNER JOIN OPERACIONESBITS OB ON OP.NrOperacion = OB.NrOperacion and OB.NrBit IN ("~VAR('INSTCREM')~") AND OB.Valor = 1 where OP.TipoOp = 'MMCREM' AND OP.NrOperacion2 IS NOT NULL AND Trim(OP.NrOperacion2) <> '' AND (OP.NrOperacion4 IS NULL OR Trim(OP.NrOperacion4) = '')" 
    *NrOperacion1:'NrOperacion';1;1;;;;Vacio(Dialogo.NrOperacion1) o SQL("SELECT 1 FROM "~DBO~".OPERACIONES O INNER JOIN "~dbo~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion and OB.Valor = 1 WHERE TipoOp = 'MMCREM' and O.NrOperacion = '"~Dialogo.NrOperacion1~"' and OB.NrBit IN ("~VAR('INSTCREM')~") and O.Sector1 = '"~Dialogo.String2~"'") = 1;'Operacion Invalida!';NO;;;;;;"TipoOp IN ('MMCREM') AND NrOperacion2 IS NOT NULL AND Trim(NrOperacion2) <> '' AND (NrOperacion4 IS NULL OR Trim(NrOperacion4) = '') AND Sector1 = '"~Dialogo.String2~"' "
  String2:'Sector';1;2;;NO;;NoVacio(Dialogo.String2);"El usuario debe tener un sector";NO;SQL("select sector from "~dbo~".USRVEHICULO where Codigo = '"~USUARIOACTIVO~"'");;;;;
  Fecha1:'Fecha de Renovación';2;1;;;IIF(NoVacio(Dialogo.NrOperacion1),NO,SI);Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Válida!';NO;FSys;
  Especie1 :'Moneda';2;2;;;IIF(NoVacio(Dialogo.NrOperacion1),NO,SI);;;;;;;;;" Codigo in('USD','ARP') ";
  ListaTabla1: 'Cliente'  ;3;1;;;IIF(NoVacio(Dialogo.NrOperacion1),NO,SI);;;;;;;;;;'Codigo';'Codigo;RazonSocial';'CLIENTES'
  ListaTabla2:'Oficial'   ;3;2;;;IIF(NoVacio(Dialogo.NrOperacion1),NO,SI);;;;;;;;;;'Codigo' ; 'Codigo;Descripcion' ; 'OFICIALESCUENTA'
  String1:'Tipo de Calculo';11;1;;;IIF(NoVacio(Dialogo.NrOperacion1),NO,SI);;;;"TNA";IIF(Eqstr(Dialogo.String1, "TNA"),"TNA","TEM");"TNA|TEM|";;;;;;
FinDialogo

if not ok
    Cancelar("Evento Cancelado.")
Endif

SQL.ADD("select OP.NrOperacion, OP.Plazo, OP.FechaOp, OP.Precio1, OP.Precio4, OP.FechaVto, C.Codigo, C.RazonSocial, OP.Especie, Cu.Nombre, OP.NrOperacion4, OP.Cantidad, CU.TEM, OP.NrOperacion2, OP.Observac3, OP.Sector1 ") 
SQL.ADD("from "~dbo~".OPERACIONES OP LEFT JOIN "~dbo~".CLIENTES C ON OP.Cliente1 = C.Codigo JOIN "~dbo~".CUENTAS Cu on OP.Cuenta1 = Cu.Codigo ") 
SQL.ADD("INNER JOIN "~dbo~".OPERACIONESBITS OB ON OP.NrOperacion = OB.NrOperacion and OB.NrBit IN ("~VAR('INSTCREM')~") AND OB.Valor = 1 ")
SQL.ADD("where OP.TipoOp = 'MMCREM' ")
SQL.ADD("AND OP.NrOperacion2 IS NOT NULL  ")
SQL.ADD("AND Trim(OP.NrOperacion2) <> '' ")
SQL.ADD("AND (OP.NrOperacion4 IS NULL OR Trim(OP.NrOperacion4) = '') ")
SQL.ADD("AND Sector1 = '"~Dialogo.String2~"' ")

IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and OP.NrOperacion= '"~Dialogo.NrOperacion1~"' ")
ELSE
   SQL.ADD("and OP.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
   *Tipo de calculo
    IF Eqstr(Dialogo.String1,"TNA")
       SQL.ADD("and ISNULL(CU.TEM, 'NO') = 'NO' ")
    ELSE
       SQL.ADD("and ISNULL(CU.TEM, 'NO') = 'SI' ")
    ENDIF
    
    *-Moneda
    IF NoVacio(Dialogo.Especie1)
       SQL.ADD(" and OP.Especie = '"~Dialogo.Especie1~"' ")
    ENDIF
    
    *-Oficial
    IF NoVacio(Dialogo.ListaTabla2)
       SQL.ADD(" and OP.OficialCuenta IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
    ENDIF
    *-Clientes
    IF NoVacio(Dialogo.ListaTabla1)
       SQL.ADD(" and  C.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
    ENDIF
    
ENDIF
 
&CantOperaciones:=0

Recorrer SQL
    ACT(a:fac, fbn['Codigo'])
    ACT(b:fac, fbn['Nombre'])
    ACT(c:fac, fbn['NrOperacion'])
    ACT(d:fac, fbn['Cantidad'])
    ACN(e:fac, fbn['Plazo']) 
    ACN(f:fac, Round(fbn['Precio1'],6))
    ACN(g:fac, Round(fbn['Precio4'],6))
    ACT(h:fac, fbn['NrOperacion2'])
    &CantOperaciones:=  &CantOperaciones+1  
    ACN(i:fac, 1)
    if Eqstr(fbn['Observac3'], 'RENOV')
        ACT(j:fac, 'Renovación')
    else
        ACT(j:fac, 'Repacto')
    endif  
Proximo

CrearListBox ; 'Arial,8,'
     
    'Check'                     ; i1..i:fac   ;SI;SI;'Error';50;CHECK
    'Cliente'                   ; a1..a:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
    'Cuenta'                    ; b1..b:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
    'NrOperacion'               ; c1..c:fac   ;NO;SI;;100;STRING;;RGB(232,232,255); 
    'Saldo Mínimo'              ; d1..d:fac   ;NO;SI;;150;NUMERO;'##.##';RGB(232,232,255); 
    'Plazo'                     ; e1..e:fac   ;NO;SI;;150;NUMERO;'##';RGB(232,232,255); 
    'Tasa de la Operación'      ; f1..f:fac   ;NO;SI;;150;NUMERO;'#####.######';RGB(232,232,255); 
    'Tasa de Transferencia'     ; g1..g:fac   ;NO;SI;;150;NUMERO;'#####.######';RGB(232,232,255);
    'Renovación/Repacto de'     ; h1..h:fac   ;NO;SI;;150;STRING;;RGB(232,232,255);
    'Tipo'                      ; j1..j:fac   ;NO;SI;;100;STRING;;RGB(232,232,255);
                       
FinListBox
    
if not ok
   Cancelar('Evento Cancelado.')
Endif

Recorrer&i  1 ,&CantOperaciones
    
    if Val(i:&i) = 1
        if Eqstr(Val(j:&i),'Renovación') 
            *c-> NrOperacion y h-> NrOperacion2
            SQL.ADD("UPDATE "~dbo~".OPERACIONES SET NrOperacion4 = NULL WHERE NrOperacion = '"~Val(h:&i)~"'")
            SQL.NEW
            SQL.ADD("UPDATE "~dbo~".OPERACIONES SET NrOperacion2 = NULL WHERE NrOperacion = '"~Val(c:&i)~"'")
            SQL.NEW
            SQL.EXEC
                                   
        else
            *Con fechaprecan piso la fechavto
            ACD(p:&i, BuscarCampo('Operaciones','FechaPrecan','NrOperacion',Val(h:&i)))
            *Calcular el plazo
            ACD(q:&i, BuscarCampo('Operaciones','FechaOp','NrOperacion',Val(h:&i)))
            SQL.ADD("UPDATE "~dbo~".OPERACIONES SET FechaVto = '"~IdxDate(Val(p:&i))~"', FechaPrecan = NULL, Plazo = "~Fstr(Val(p:&i)-Val(q:&i))~" WHERE NrOperacion = '"~Val(h:&i)~"'")
            SQL.NEW
                       
            *Pongo NULL NrOperacion4 en la original
            SQL.ADD("UPDATE "~dbo~".OPERACIONES SET NrOperacion4 = NULL WHERE NrOperacion = '"~Val(h:&i)~"'")
            SQL.NEW
            SQL.EXEC
            
            *Actualizar a la instancia 93 --> Remuneradas vigentes
            EjecutarEvento('CBOINS', String1= Val(h:&i), Radio1=0, Radio2=2, Entero1=0, Entero2=93)
            
        endif
        
        *Para el mensaje de fin
        if Eqstr(Val(o:1), '')
            ACT(o:1, Val(c:&i))
        else
            ACT(o:1, Val(o:1)~", "~Val(c:&i))
        endif
        
        *Actualizar a la instancia 30 --> Anulación Manual
        EjecutarEvento('CBOINS', String1= Val(c:&i), Radio1=0, Radio2=2, Entero1=0, Entero2=30)
    
    endif

Proximo

MessageBox("Se anularon correctamente las operaciones: "~Val(o:1))
    