CrearDialogo
   Label1    : ''                ;1;1;;;;;;;;'Ingrese Periodo a Generar';;;
   Entero1   : 'Año'             ;;1;;;;Dialogo.Entero1>=2004 y Dialogo.Entero1<=2050;'Debe Ingresar un anio valido';NO;Anio(Fsys);;;;'####'
   Entero2   : 'Mes'             ;;1;;;;Dialogo.Entero2>=1 y Dialogo.Entero2<=12;'Debe Ingresar un mes valido';NO;Mes(Fsys);;;;'##'
   String1   : 'Periodo'         ;;1;;NO;NO;;;;'01/'~PAD0(Dialogo.Entero2,2)~'/'~PAD0(Dialogo.Entero1,4);'01/'~PAD0(Dialogo.Entero2,2)~'/'~PAD0(Dialogo.Entero1,4)
   Fecha1    : 'Fecha desde'     ;;1;;NO;;;;;Fecha(Dialogo.String1);Fecha(Dialogo.String1)
   Fecha2    : 'Fecha hasta'     ;;1;;NO;;;;;FinDeMes(Dialogo.Fecha1,SI);FinDeMes(Dialogo.Fecha1,SI)
FinDialogo 


If Not Ok
   Cancelar
endif   

** verificar si esta generado y preguntar para borrar

Message(' - Borrando Archivos RTI - UIFRTI - UIFRTIOTR')
SQL.NEW
SQL.ADD("Delete from "~DBO~".UIFRTI Where Periodo='"~PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2)~"' ")
SQL.NEW
SQL.ADD("Delete from "~DBO~".UIFRTIOTR Where Periodo='"~PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2)~"' ")
SQL.NEW
SQL.EXEC

ACT(pe:1,PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2))

SQL.ADD("Select O.NrOperacion, TipoOp,")
SQL.ADD("Case O.TipoOp when 'TIC' Then 'RECEPTORA' Else 'EMISORA' End Transferencia, C.Persona, ")
SQL.ADD(" O.FechaVto FechaLiq, Case when O.Mercado in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.DescUIF else 'OTRA' end EntExterior,  ")
SQL.ADD(" Case when O.Mercado not in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.Descripcion else '' end DenomExterior, ")
SQL.ADD("  TE.Descripcion EspecieTransf , ")
#ifdef MLASA
SQL.ADD(" Deposdelcomitente CodComitente , ")
SQL.ADD(" CodDepCajaValores ComitArgentina, ")
SQL.ADD(" '"~VAR('VEHICULODE')~"' Cliente, E.MonedaEmision MonedaVN,")
#else
SQL.ADD(" C.CodComitente , (select Top(1) NrDepositante from "~DBO~".CUENTAS Where Cliente = O.Cliente1 and Comitente = '"~VAR('VEHICULODE')~"' and TipoCuenta = 'CUS' and NrDepositante is not Null) as ComitArgentina, ")
SQL.ADD(" O.Cliente1 Cliente, O.ContraEspecie MonedaVN,")
#endif
SQL.ADD(" E.Nombre DenomEspecieOtra, O.Especie TickerVN,  O.Cantidad CantidadVN, ")
SQL.ADD(" C.CUIT NroCUIT, Case when E.ISIN <> '' Then 'ISIN' when E.CUSIP <> '' Then 'CUSIP' else 'OTRO' End TipoEspecieVN, ")
SQL.ADD(" Case when E.ISIN <> '' Then E.ISIN when E.CUSIP <> '' Then E.CUSIP else 'SinCodigo' End CodEspecieVN, ")
SQL.ADD(" Case When C.Jerarquia like '"~VAR('JERFONDOS')~"%' Then 'FCI' When C.Sector = 'PUB' Then 'Organismo Publico' When C.TipoInscripcion = 'FDI' Then 'Fideicomiso' Else 'OTRO' End TipoCliente, ")
SQL.ADD(" Case When C.Persona = 'NO' Then 'PERSONA JURIDICA' When C.Persona = 'SI' Then 'PERSONA HUMANA' Else 'SinTipoPersona' End TipoPersona, ")
SQL.ADD(" Deposdelcomitente NroCuentaDepos, C.Pais, ")
SQL.ADD(" (Select Top(1) Precio1 From COTIZACIONES CO Where Codigo = O.Especie AND Moneda = 'ARP' AND Fecha <= O.FechaVto Order By Fecha Desc) CotizMonedaVN, ")
#ifdef MLASA
SQL.ADD(" (select count(*)+1 from "~DBO~".INTEGRANTESCLI IT where IT.Codigo = C.Codigo) as CantidadCli, C.RazonSocial DenomPersona, ")
SQL.ADD(" CU.Numero NroCtaTransferencia, Case when O.Mercado in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.PaisUIF /*'06'*/ else '80' end PaisCtaTransferencia, 'NO' ComparteComit , ")
SQL.ADD(" (Select RazonSocial from "~DBO~".CLIENTES CL where CL.Codigo=O.Cliente1) as DenNoComparteComit ")
#else
SQL.ADD(" (select count(*) from "~DBO~".INTEGRANTESCLI IT where IT.Codigo = C.Codigo) as CantidadCli, C.RazonSocial DenomPersona, ")
SQL.ADD(" CU.Numero NroCtaTransferencia, CO.Pais PaisCtaTransferencia, 'NO' ComparteComit , '"~VAR('RTICONTEXT')~"' DenNoComparteComit ")
#endif
SQL.ADD("  From "~DBO~".OPERACIONES O  ")
#ifdef MLASA
SQL.ADD("  LEFT OUTER JOIN "~DBO~".CLIENTES C on '"~VAR('VEHICULODE')~"'=C.Codigo ")
#else
SQL.ADD("  LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo ")
#endif
SQL.ADD("  LEFT JOIN "~DBO~".CUENTAS CU on O.Cuenta2=CU.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ON O.Mercado=M.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  O.NrOperacion=B.NrOperacion ")
SQL.ADD("       Left JOIN "~DBO~".TIPOESPECIE TE WITH (NOLOCK) ON  E.Tipo=TE.Codigo ")
SQL.ADD("Where  B.Valor='1' and B.Nrbit not in (30)")
SQL.ADD("  and O.FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("  and O.Mercado in  ("~Pipe2Comillas(VAR('UIFRTIMERC'))~") ")
SQL.ADD(" and O.TipoOp In  ('TIC','TIV') ")
#ifdef MLASA
#else
SQL.ADD("UNION ")
SQL.ADD(" Select NrTrans Nroperacion, TipoTr2 TipoOp, ")
SQL.ADD("'RECEPTORA' Transferencia, C.Persona, ")
SQL.ADD("T.Fecha1 FechaLiq, Case when T.Mercado1 in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.DescUIF else 'OTRA' end EntExterior, ")
SQL.ADD(" Case when T.Mercado1 not in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.Descripcion else '' end DenomExterior, ")
SQL.ADD(" TE.Descripcion EspecieTransf , ")
SQL.ADD(" C.CodComitente, (select Top(1) NrDepositante from "~DBO~".CUENTAS Where Cliente = T.Cliente1 and Comitente = '"~VAR('VEHICULODE')~"' and TipoCuenta = 'CUS' and NrDepositante is not Null) as ComitArgentina, ")
SQL.ADD(" T.Cliente1 Cliente, 'ARP' MonedaVN, E.Nombre DenomEspecieOtra, T.Especie TickerVN,  T.Cantidad1 CantidadVN, ")
SQL.ADD(" C.CUIT NroCUIT, Case when E.ISIN <> '' Then 'ISIN' when E.CUSIP <> '' Then 'CUSIP' else 'OTRO' End TipoEspecieVN, ")
SQL.ADD(" Case when E.ISIN <> '' Then E.ISIN when E.CUSIP <> '' Then E.CUSIP else 'SinCodigo' End CodEspecieVN, ")
SQL.ADD(" Case When C.Jerarquia like '008001%' Then 'FCI' When C.Sector = 'PUB' Then 'Organismo Publico' When C.TipoInscripcion = 'FDI' Then 'Fideicomiso' Else 'OTRO' End TipoCliente, ")
SQL.ADD(" Case When C.Persona = 'NO' Then 'PERSONA JURIDICA' When C.Persona = 'SI' Then 'PERSONA HUMANA' Else 'SinTipoPersona' End TipoPersona, ")
SQL.ADD("  CU.Numero NroCuentaDepos, C.Pais, ")
SQL.ADD(" (Select Top(1) Precio1 From COTIZACIONES CO Where Codigo = T.Especie AND Moneda = 'ARP' AND Fecha <= T.Fecha1 Order By Fecha Desc) CotizMonedaVN, ")
SQL.ADD(" (select count(*) from INTEGRANTESCLI IT where IT.Codigo = C.Codigo) as CantidadCli, C.RazonSocial DenomPersona, ")
SQL.ADD(" CU.Numero NroCtaTransferencia, CO.Pais PaisCtaTransferencia, 'NO' ComparteComit , '"~VAR('RTICONTEXT')~"' DenNoComparteComit  ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("  LEFT OUTER JOIN "~DBO~".CLIENTES C on T.Cliente1=C.Codigo ")
SQL.ADD("  LEFT JOIN "~DBO~".CUENTAS CU on Cuenta1=CU.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".CORRESPONSALES CO WITH (NOLOCK) ON CU.Corresponsal=CO.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON Especie=E.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ON T.Mercado1=M.Codigo ")
SQL.ADD("       Left JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  NrTrans=B.NrOperacion ")
SQL.ADD("       Left JOIN "~DBO~".TIPOESPECIE TE WITH (NOLOCK) ON  E.Tipo=TE.Codigo ")
SQL.ADD(" where B.Valor='1' and B.NrBit not in (30)  and TipoTr2 in ('TRNOP','DRT') ")
SQL.ADD("   and T.Fecha1 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("   and T.Mercado1 in ("~Pipe2Comillas(VAR('UIFRTIMERC'))~") ")
SQL.ADD(" UNION ")
