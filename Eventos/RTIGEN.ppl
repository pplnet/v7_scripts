SQL.ADD(" 'EMISORA' Transferencia, C.Persona, ")
SQL.ADD("T.Fecha1 FechaLiq, Case when T.Mercado1 in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.DescUIF else 'OTRA' end EntExterior, ")
SQL.ADD(" Case when T.Mercado1 not in ("~Pipe2Comillas(VAR('UIFRTIMER'))~") then M.Descripcion else '' end DenomExterior, ")
SQL.ADD(" TE.Descripcion EspecieTransf , ")
SQL.ADD(" C.CodComitente, (select Top(1) NrDepositante from "~DBO~".CUENTAS Where Cliente = T.Cliente1 and Comitente = '"~VAR('VEHICULODE')~"' and TipoCuenta = 'CUS' and NrDepositante is not Null) as ComitArgentina, ")
SQL.ADD(" T.Cliente1 Cliente, 'ARP' MonedaVN, E.Nombre DenomEspecieOtra, T.Especie TickerVN,  T.Cantidad1 CantidadVN, ")
SQL.ADD(" C.CUIT NroCUIT, Case when E.ISIN <> '' Then 'ISIN' when E.CUSIP <> '' Then 'CUSIP' else 'OTRO' End TipoEspecieVN, ")
SQL.ADD(" Case when E.ISIN <> '' Then E.ISIN when E.CUSIP <> '' Then E.CUSIP else 'SinCodigo' End CodEspecieVN, ")
SQL.ADD(" Case When C.Jerarquia like '008001%' Then 'FCI' When C.Sector = 'PUB' Then 'Organismo Publico' When C.TipoInscripcion = 'FDI' Then 'Fideicomiso' Else 'OTRO' End TipoCliente, ")
SQL.ADD(" Case When C.Persona = 'NO' Then 'PERSONA JURIDICA' When C.Persona = 'SI' Then 'PERSONA HUMANA' Else 'SinTipoPersona' End TipoPersona, ")
