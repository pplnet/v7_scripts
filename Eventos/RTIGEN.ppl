SQL.ADD(" CU.Numero NroCtaTransferencia, CO.Pais PaisCtaTransferencia, 'NO' ComparteComit , '"~VAR('RTICONTEXT')~"' DenNoComparteComit  ")SQL.ADD(" from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("  LEFT OUTER JOIN "~DBO~".CLIENTES C on T.Cliente2=C.Codigo ")
