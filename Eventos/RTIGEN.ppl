** Generar 1 regstro por operacion en UIFRTI (incluye el dato del Cliente/Persona)

** Buscar si es persona fisica datos de tabla Persona. definir que primer integrante debe ser titular
   ACT(ap:1,'')
   ACT(ap:2,'')
   ACT(ap:3,'')
   ACT(ap:4,'')

   If EqStr(FBN['Persona'],'SI')
       SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento, Apellido, Nombre, Sexo, Nacionalidad,Pais, CodigoPEP, FechaNacimiento,  ")
       SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, ")
       SQL.ADD("P.EmpleadoGobierno,P.Telefono")
       SQL.ADD("from INTEGRANTESCLI ICL ")
       SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento= (select substring(CUIT,3,8) from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       
       watch(sql.batch)
       Recorrer SQL
         ACT(ap:1,Trim(FBN['Apellido']))
         ACT(ap:2,Trim(FBN['Nombre']))
         ACT(ap:3,Trim(FBN['TipoDocumento']))
         ACT(ap:4,Trim(FBN['NrDocumento']))
       Proximo

   endif
   ACT(no:1,FBN['NrOperacion'])
   Message('--- #Op : '~Val(no:1)~' Tipo : '~FBN['TipoOp']~' Especie : '~FBN['TickerVN']~' Cliente : '~FBN['Cliente'])
   SQL.ADD("Insert into "~DBO~".UIFRTI (")
               
   SQL.ADD("Periodo, ")
   SQL.ADD("NrOperacion, ")
   SQL.ADD("Cliente, ")
   SQL.ADD("Transferencia, ")
   SQL.ADD("FechaLiq, ")
   SQL.ADD("EntidadDep, ")
   SQL.ADD("DenomEntidadOtra, ")
   SQL.ADD("NroCtaTransferencia, ")
   SQL.ADD("PaisCtaTransferencia, ")
   SQL.ADD("NroCuentaDepos, ")
   SQL.ADD("NroCuentaComit, ")
   SQL.ADD("EspecieTransf, ")
   SQL.ADD("DenomEspecieOtra, ")
   SQL.ADD("TickerVN, ")
   SQL.ADD("TipoEspecieVN, ")
   SQL.ADD("CodEspecieVN, ")
   SQL.ADD("CotizMonedaVN, ")
   SQL.ADD("MonedaVN, ")
   SQL.ADD("CantidadVN, ")
   SQL.ADD("ComparteComit, ")
   SQL.ADD("DenNoComparteComit, ")
   SQL.ADD("CantidadCli, ")
   SQL.ADD("TipoCliente, ")
   SQL.ADD("NroCUIT, ")
   SQL.ADD("TipoPersona, ")
   SQL.ADD("DenomPersona, ")
   SQL.ADD("Apellido, ")
   SQL.ADD("Nombre, ")
   SQL.ADD("TipoDoc, ")
   SQL.ADD("NroDoc ")
                 
   SQL.ADD(") values (")
   
   *Periodo
   SQL.ADD(" '"~Val(pe:1)~"', ")                 
   *NrOperacion
   SQL.ADD(" '"~Val(no:1)~"', ")
   *Cliente
   SQL.ADD(" '"~FBN['Cliente']~"', ")   
   *Transferencia
   SQL.ADD(" '"~FBN['Transferencia']~"', ")
   *FechaLiq
   SQL.ADD(" '"~IdxDate(FBN['FechaLiq'])~"', ")
   *EntidadDep
   *SQL.ADD(" '"~FBN['EntidadDep']~"', ")
   SQL.ADD(" '"~FBN['EntExterior']~"', ")
   *DenomEntidadOtra
   SQL.ADD(" '"~FBN['DenomExterior']~"', ")
   *NroCtaTransferencia
   SQL.ADD(" '"~FBN['NroCtaTransferencia']~"', ")
   *PaisCtaTransferencia
   SQL.ADD(" '"~FBN['PaisCtaTransferencia']~"', ")
   *NroCuentaDepos
   SQL.ADD(" "~FStr(FBN['NroCuentaDepos'],0,0)~", ")
   *NroCuentaComit
   SQL.ADD(" "~FStr(FBN['ComitArgentina'],0,0)~", ")
   *EspecieTransf
   SQL.ADD(" '"~FBN['EspecieTransf']~"', ")
   *DenomEspecieOtra
   SQL.ADD(" '"~FBN['DenomEspecieOtra']~"', ")
   *TickerVN
   SQL.ADD(" '"~FBN['TickerVN']~"', ")
   *TipoEspecieVN
   SQL.ADD(" '"~FBN['TipoEspecieVN']~"', ")
   *CodEspecieVN
   SQL.ADD(" '"~FBN['CodEspecieVN']~"', ")
   *CotizMonedaVN
   ACN(zx1,FBN['CotizMonedaVN']*100)
   ACN(zx2,TRUNC(Val(zx1),0))
   SQL.ADD(" "~FStr(Val(zx2)/100,0,2)~", ")
   *MonedaVN
   SQL.ADD(" '"~FBN['MonedaVN']~"', ")
   *CantidadVN
   SQL.ADD(" "~FStr(FBN['CantidadVN'],0,2)~", ")
   *ComparteComit
   SQL.ADD(" '"~FBN['ComparteComit']~"', ")
   *DenNoComparteComit
   SQL.ADD(" '"~FBN['DenNoComparteComit']~"', ")
   *CantidadCli
   SQL.ADD(" "~FStr(FBN['CantidadCli'],0,0)~", ")
   *TipoCliente
   SQL.ADD(" '"~FBN['TipoCliente']~"', ")
   *NroCUIT
   SQL.ADD(" "~FStr(FBN['NroCUIT'],0,0)~", ")
   *TipoPersona
   SQL.ADD(" '"~iif(EqStr(FBN['Pais'],VAR('PAISARG')),FBN['TipoPersona'],FBN['TipoPersona']~' EXTRANJERA')~"', ")
   *DenomPersona
   SQL.ADD(" '"~FBN['DenomPersona']~"', ")
   *Apellido
   SQL.ADD(" '"~Val(ap:1)~"', ")
   *Nombre
   SQL.ADD(" '"~Val(ap:2)~"', ")
   *TipoDoc 
   SQL.ADD(" '"~Val(ap:3)~"', ")              
   *NroDoc 
   SQL.ADD(" '"~Val(ap:4)~"' ")
                 
   SQL.ADD(")")
   SQL.NEW
   SQL.EXEC
                 

** Generar 1 registro por cada integrante del cliente de cada operacion en UIFRTIOTR
  * If EqStr(FBN['Persona'],'SI')
       ACN(NI:1,0)
       *SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento OtroDoc, Case When isnumeric("~(PAD0(ICL.NrDocumento,0)~")=1 then ICL.NrDocumento else 0 end NrDocumento, ")
       SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento,  ")       
       SQL.ADD("'PERSONA HUMANA' TipoPersona, Apellido,Nombre, Sexo, Nacionalidad,P.Pais, CodigoPEP, FechaNacimiento,  ")
       SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, NrIntegrante, ICL.Codigo Cliente, ")
       SQL.ADD("P.EmpleadoGobierno,P.Telefono, P.Cuit")
       SQL.ADD("from INTEGRANTESCLI ICL ")
       SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento <> (select substring(CUIT,3,8) from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       
       watch(sql.batch)
       Recorrer SQL

       Message('--- #Op : '~Val(no:1)~' Cliente : '~FBN['Cliente']~' Integrante : '~FBN['TipoPoder'])
         
       
         IF EqStr(FBN['TipoPoder'],'TIT')
            ACT(po:1,'TITULAR')
         else
            IF EqStr(FBN['TipoPoder'],'CTI')   
               ACT(po:1,'CO-TITULAR')
            else   
               IF EqStr(FBN['TipoPoder'],'AUT')   
                  ACT(po:1,'AUTORIZADO')
               else
                  IF EqStr(FBN['TipoPoder'],'APO')   
                     ACT(po:1,'APODERADO')
                  else
                     IF EqStr(FBN['TipoPoder'],'RLE')   
                        ACT(po:1,'REPRESENTANTE LEGAL')
                     else
                        IF EqStr(FBN['TipoPoder'],'TUT')   
                           ACT(po:1,'TUTOR')
                        else               
                           IF EqStr(FBN['TipoPoder'],'EMP')   
                              ACT(po:1,'EMPLEADO')
                           else                        
                              IF EqStr(FBN['TipoPoder'],'SFI')   
                                 ACT(po:1,'SOCIO FUNCIONARIO')
                              else                        
                                 IF EqStr(FBN['TipoPoder'],'ACC')   
                                    ACT(po:1,'SOCIO/ACCIONISTA')
                                 else                        
                                    IF EqStr(FBN['TipoPoder'],'FEM')   
                                       ACT(po:1,'FUNCIONARIO DE LA EMPRESA')
                                    else                        
                                       IF EqStr(FBN['TipoPoder'],'GER')   
                                          ACT(po:1,'GERENTE')
                                       else                        
                                          IF EqStr(FBN['TipoPoder'],'PRE')   
                                             ACT(po:1,'PRESIDENTE')
                                          else                        
                                             IF EqStr(FBN['TipoPoder'],'VPR')   
                                                ACT(po:1,'VICEPRESIDENTE')
                                             else                        
                                                IF EqStr(FBN['TipoPoder'],'EMP')   
                                                   ACT(po:1,'EMPLEADO')
                                                else
                                                   IF EqStr(FBN['TipoPoder'],'SGE')   
                                                      ACT(po:1,'Sociedad Gerente')
                                                   else
                                                      ACT(po:1,'SIN DEFINIR')
                                                   endif
                                                endif   
                                             endif
                                          endif
                                       endif
                                    endif
                                 endif
                              endif
                           endif
                        endif
                     endif
                  endif
               endif
            endif
         Endif
                        SCN(NI:1,1)
         SQL.ADD("Insert into "~DBO~".UIFRTIOTR (")         
         SQL.ADD("Periodo, ")
         SQL.ADD("NrOperacion, ")
         SQL.ADD("NroIntegrante, ")
         SQL.ADD("Vinculo, ")
         SQL.ADD("NroCUIT, ")
         SQL.ADD("TipoPersona, ")
         SQL.ADD("Apellido, ")
         SQL.ADD("Nombre, ")
         SQL.ADD("TipoDoc, ")
         SQL.ADD("NroDoc ")
                 
         SQL.ADD(") values (")
            
         *Periodo
         SQL.ADD(" '"~Val(pe:1)~"', ")
         *NrOperacion
         SQL.ADD(" '"~Val(no:1)~"', ")
         *NroIntegrante
         SQL.ADD(" '"~FStr(Val(NI:1),0,0)~"', ")
         *Vinculo
         SQL.ADD(" '"~Val(po:1)~"', ")
         *NroCUIT
         SQL.ADD(" "~FStr(FBN['CUIT'],0,0)~", ")
         *TipoPersona
         SQL.ADD(" '"~iif(EqStr(FBN['Pais'],VAR('PAISARG')),FBN['TipoPersona'],FBN['TipoPersona']~' EXTRANJERA')~"', ")
         *Apellido
         SQL.ADD(" '"~FBN['Apellido']~"', ")
         *Nombre
         SQL.ADD(" '"~FBN['Nombre']~"', ")
         *TipoDoc 
         SQL.ADD(" '"~FBN['TipoDocumento']~"', ")              
         *NroDoc 
         SQL.ADD(" '"~FBN['NrDocumento']~"' ")        
         
         SQL.ADD(")")
         SQL.NEW
         SQL.EXEC
         
       Proximo

  * endif

Proximo
