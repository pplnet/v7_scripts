CrearDialogo
  String1: 'Nro. Op./Orden'            ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar una Operacion';NO;
  Radio1 : 'Tabla|OPERAC|ORDEN'        ;;;;;;;;;0;;
  Radio2 : 'Direcc|0NULL|1RETRO|2AVANZ';;;;;;;;;0;;
  Entero1: "NrInstDesde"               ;;;;;;NoVacio(Dialogo.Entero1) y Dialogo.Entero1 >= 0 ;'Debe ingresar una Instancia ';NO;
  Entero2: "NrInstHacia"               ;;;;;;NoVacio(Dialogo.Entero2) y Dialogo.Entero2 <> 0 ;'Debe ingresar una Instancia ';NO;
FinDialogo

if Not Ok
  Cancelar
endif

*** Cambio de Instancia en OPERACIONESBITS
SQL.ADD("Update "~DBO~".OPERACIONESBITS Set ")
SQL.ADD("  Valor = '0' ")
SQL.ADD("where NrOperacion = '"~Dialogo.String1~"' ")
if Dialogo.Entero1<>0
   SQL.ADD("  and NrBit       = "~Dialogo.Entero1 )
endif   
SQL.NEW
if SQL("SELECT 1 FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~Dialogo.String1~"' and NrBit="~FSTR(Dialogo.Entero2,1,0))=1
    SQL.ADD("Update "~DBO~".OPERACIONESBITS Set ")
    SQL.ADD("  Valor = '1' ")
    SQL.ADD("where NrOperacion = '"~Dialogo.String1~"' ")
    SQL.ADD("  and NrBit       = "~Dialogo.Entero2 )
    SQL.NEW
else
    * Si no existe el Operacionesbits lo crea
    SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
    SQL.ADD(" (NrOperacion, NrBit, Valor ")
    SQL.ADD("  ) VALUES( ")
    SQL.ADD("  '"~Dialogo.String1~"', "~Dialogo.Entero2~", 1) ")
    SQL.NEW
endif

if Dialogo.Radio1=0
  *** Actualizo la direccion en la tabla de OPERACIONES segun corresponsa
  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   Set Direccion   = "~Dialogo.Radio2 )
  SQL.ADD(" where NrOperacion = '"~Dialogo.String1~"' ")
  SQL.NEW
endif

*** Registro cambio en INSTANCIASOP
ACT(x1, 'Evento CBOINS mueve a '~FStr(Dialogo.Entero2,1,0))
SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
SQL.ADD(" Values ")
SQL.ADD(" ('"~Dialogo.String1~"', "~Dialogo.Entero1~", '"~USUARIOACTIVO~"', '"~Val(x1)~"', "~SQLAhora~" )")
SQL.NEW


SQL.EXEC
