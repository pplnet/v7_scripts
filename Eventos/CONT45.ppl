MostrarCuadroDeMensajes
CrearDialogo
   NrUnicoAsiento1: 'Asiento'  ;;;;;Dialogo.Check1 = 0;Dialogo.Check1 = 1 O NoVacio(Dialogo.NrUnicoAsiento1);'Asiento Invalido';NO;
   Radio1: 'Genera|Anulacion|N.Credito'  ;;;;;;Dialogo.Radio1 >= 0;'Indique si Genera Anulacion o Nota de Credito';NO;
   Check1: 'Filtra Fechas' ;;;;;;;;;;;;;;;;;;;
   Fecha1: 'Fecha Ejec'    ;5;;;;Dialogo.Check1 = 1;;;;Fsys;
   Fecha2: 'Fecha Gen'     ;6;;;;Dialogo.Check1 = 1;;;;Fsys;
   Lista1: 'Asientos'      ;8;;;;Dialogo.Check1 = 1;Dialogo.Check1=0 O Elementos(Dialogo.Lista1) >= 1;'Debe Elegir al Menos un Asiento';NO;;;IIF(Dialogo.Check1 = 1, SQLSET(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where FechaGeneracion = '"~IdxDate(Dialogo.Fecha2)~"' AND Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' "))
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(BD:1, 0)
SQL.ADD(" Select DISTINCT MA.Codigo as CodAsi, AC.FechaGeneracion, AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, ")
SQL.ADD(" AC.NrLote, AC.NrUnicoAsiento, AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento, AC.Fecha1 ")
SQL.ADD(" From "~DBO~".MODELOSASIENTO MA, "~DBO~".ASIENTOSCON AC ")
IF Dialogo.Check1 = 0
    SQL.ADD(" Where AC.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ELSE
    SQL.ADD(" Where AC.NrUnicoAsiento IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" AND MA.Codigo = AC.Modelo ")
SQL.ADD(" AND AC.Estado = 'E' ")
SQL.ADD(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
SQL.ADD(" order by AC.NrUnicoAsiento ")
Recorrer SQL
    MESSAGE('Operacion '~fbn('NrOperacion'))
    IF Dialogo.Radio1 = 0
        ACT(TP:1, 'COT')
    ELSE
        ACT(TP:1, 'NC')
    ENDIF
    ACN(BD:1, 1)
    ACT(NN:1, GetNumerador(810))
    SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
    SQL.ADD(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
    SQL.ADD(" Modelo, Book, UDN, Centro, ")
    SQL.ADD(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
    SQL.ADD(" NrOperacion, NrTrans2, Estado, Fecha1) ")
    SQL.ADD(" VALUES ")
    SQL.ADD(" ("~Idxdate2(fsys)~", "~Idxdate2(fbn('FechaValor'))~", '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
    SQL.ADD(" '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
    SQL.ADD(" '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
    SQL.ADD(" '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~Val(TP:1)~"', "~Idxdate2(fbn('Fecha1'))~")  ")
    SQL.NEW
    SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"'  ")
    Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
       SQL.ADD(" Detalle, CentroCosto, Book, ")
       SQL.ADD(" Alias6, Alias7, Alias8, ")
       SQL.ADD(" Alias9, Alias10, Valor1, ")
       SQL.ADD(" Valor2, Valor3 ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(NN:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
          SQL.ADD(" 'CRE', ")
       Else
          SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,8)~", "~fstr(fbn('Cantidad2'),0,8)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', ")
       SQL.ADD(" '"~fbn('Detalle')~"', '"~fbn('CentroCosto')~"', '"~fbn('Book')~"', ")
       SQL.ADD(" '"~fbn('Alias6')~"', '"~fbn('Alias7')~"', '"~fbn('Alias8')~"', ")
       SQL.ADD(" '"~fbn('Alias9')~"', '"~fbn('Alias10')~"', "~Fstr(fbn('Valor1'), 0, 2)~", ")
       SQL.ADD(" "~Fstr(fbn('Valor2'), 0, 8)~", "~Fstr(fbn('Valor3'), 0, 2)~") ")
       SQL.NEW
    Proximo
    SQL.EXEC
    ***---Marco el asiento
    SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
    SQL.ADD(" Set NrAsiento = '"~Val(NN:1)~"' ")
    SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
    SQL.NEW
    SQL.EXEC
Proximo
IF Val(BD:1) = 0
    MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' NO Fue Anulado')
ELSE
    MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' Fue Anulado con el Asiento '~Val(NN:1))
ENDIF