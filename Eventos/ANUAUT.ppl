* 30/07
* ANUAUT - Anulaci¢n Autom tica de Operaciones

* TOMA TODAS LAS OPERACIONES QUE ESTAN EN LA INSTANCIA DE ELIMINACION AUTOMATICA
* Y LAS BORRA DE LA TABLA OPERACIONES ( TAMBIEN SE BORRA EN CASCADA 
* LOS REGISTROS DE OPERACIONESBITS, EXCEPCIONES,ETC CORRESPONDIENTES )

CrearDialogo
    NrOperacion1: '# Operaci¢n :'
FinDialogo

If Not OK
    Cancelar
EndIf

SQL.ADD(" Select * from "~DBO~".OPERACIONESBITS ")
SQL.ADD(" Where ( NrBit = 31 ) and ( Valor = '1' ) and (NrOperacion = '"~Dialogo.NrOperacion1~"') ")
SQL.ADD(" Order by NrOperacion ")

Recorrer SQL
    ACT(A1, BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', FBN['NrOperacion']))
    If Incluido(Val(A1), 'FXC|FXCT|FXV|FXVT|FXA|FXAT|FXP')
        Message('----- Eliminado Operaci¢n Nr: '~FBN['NrOperacion'])
        
        * Si la Operaci¢n es un Pase o Arbitraje Elimina la/s Op. Generada/s por Ellos
        If Incluido(Val(A1), 'FXA|FXAT|FXP') 
            SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
            SQL.ADD(" Where OperacionRef = '"~FBN['NrOperacion']~"' ")
            SQL.ADD(" Order by TipoOp, NrOperacion ")
            Recorrer SQL
                Message('----- Eliminado Operaci¢n Nr: '~FBN['NrOperacion'])
                ACT(A2, BuscarCampo('Operaciones', 'TipoOp', 'NrOperacion', FBN['NrOperacion']))
                If Incluido(Val(A2), 'FXA|FXAT') 
                    ***** Es un Arb que viene de un Pase, ver si el 1ero gener¢ operaciones
                    SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
                    SQL.ADD(" Where OperacionRef = '"~FBN['NrOperacion']~"' ")
                    SQL.ADD(" Order by NrOperacion")
                    Recorrer SQL

                        SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET LInstancia = 31 ")
                        SQL.ADD(" Where  NrOperacion= '"~FBN['NrOperacion']~"' ")
                        SQL.NEW
                        SQL.EXEC

                        EjecutarEvento('ANUMOV',NrOperacion1=FBN['NrOperacion'])

                        Message('----- Eliminado Operaci¢n Nr: '~FBN['NrOperacion'])
                        SQL.ADD(" Delete "~DBO~".OPERACIONES ")
                        SQL.ADD(" Where  NrOperacion = '"~FBN['NrOperacion']~"' ")
                        SQL.NEW
                        SQL.EXEC
                    Proximo
                EndIf

                SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET LInstancia = 31 ")
                SQL.ADD(" Where  NrOperacion= '"~FBN['NrOperacion']~"' ")
                SQL.NEW
                SQL.EXEC

                EjecutarEvento('ANUMOV',NrOperacion1=FBN['NrOperacion'])

                SQL.ADD(" Delete "~DBO~".OPERACIONES ")
                SQL.ADD(" Where  NrOperacion = '"~FBN['NrOperacion']~"' ")
                SQL.NEW
                SQL.EXEC
            Proximo
        EndIf

        SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET LInstancia = 31 ")
        SQL.ADD(" Where  NrOperacion= '"~FBN['NrOperacion']~"' ")
        SQL.NEW
        SQL.EXEC

        EjecutarEvento('ANUMOV',NrOperacion1=FBN['NrOperacion'])

        SQL.ADD(" Delete "~DBO~".OPERACIONES ")
        SQL.ADD(" Where  NrOperacion = '"~FBN['NrOperacion']~"' ")
        SQL.NEW
        SQL.EXEC
    EndIf
Proximo