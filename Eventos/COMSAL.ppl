* FJL 27/12/21 - Salos no pagan comisiones
ACT(x:1, VAR('SALNOCOM'))

*- Recupero los Saldos por Estado para un Cliente para las Cuentas que estan Habilitadas 
SQL.ADD("SELECT Distinct S.Cliente FROM "~DBO~".SALDOSDIA S WITH (NOLOCK),")
SQL.ADD("                 "~DBO~".CLIENTES CL WITH (NOLOCK), "~DBO~".ESPECIES E  WITH (NOLOCK)       ")    
SQL.ADD("WHERE S.Cliente = CL.Codigo AND                                  ")
* FJL 17/01/22 - Si estaba vacio CobroCutodia no tomaba el cliente
*SQL.ADD("      CL.CobroCustodia <> 'NO' AND                               ")
SQL.ADD("      (S.NrSaldo > 201 OR S.NrSaldo = 101) AND                   ")
* FJL 27/12/21 - Salos no pagan comisiones
SQL.ADD("      S.NrSaldo not in ("~Pipe2Comillas(Val(x:1))~") AND                   ")
SQL.ADD("      S.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND               ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("      S.Cliente = '"~Dialogo.Cliente1~"' AND                  ")
ENDIF
If Dialogo.Radio3=0
   *- Clientes Sudameris
   SQL.ADD("      (CL.Valor10<>1 OR CL.Valor10 Is Null)  AND ")
EndIf
If Dialogo.Radio3=1
   *- Clientes Patagonia
   SQL.ADD("      CL.Valor10=1 AND ")
EndIf
SQL.ADD("      S.Especie =  E.Codigo  AND                                 ")
SQL.ADD("      (E.Valor8 =0 or E.Valor8 is null)   AND                    ")
SQL.ADD("      S.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' AND               ")
SQL.ADD("      S.Fecha=(SELECT MAX(Fecha)                                 ")
SQL.ADD("               FROM "~DBO~".SALDOSDIA S1    WITH (NOLOCK) ")
SQL.ADD("               WHERE S1.Cliente = S.Cliente AND                  ")
SQL.ADD("                     S1.Especie = S.Especie AND                  ")
SQL.ADD("                     S1.EnteCustodia = S.EnteCustodia AND        ")
SQL.ADD("                     S1.Mercado = S.Mercado AND                  ")
SQL.ADD("                     S1.NrSaldo = S.NrSaldo AND                  ")
SQL.ADD("                     S1.Cuenta = S.Cuenta AND                    ")
SQL.ADD("                     S1.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"')  ")
SQL.ADD("ORDER BY S.Cliente                                               ")

ACN(w1,fac)
ACT(z3,'')
ACT(z4,'')
ACN(z5,0)

*- 
ACN(cc1, 0)
ACT(cc2, '')
ACT(cc3, '')
ACN(cc4, 0)

watch(SQL.batch())

Recorrer SQL
   SCN(cc1, 1 )

   If val(cc1)=1
      ACT(cc2, FBN['Cliente'] ) 
   EndIf

#ifdef PRUEBA
  MessageBox('Cliente='~FBN['Cliente']~'- cc2='~Val(cc2))
#endif 
   If val(cc1)>=Dialogo.Entero3
      ACT(cc3, FBN['Cliente'] )
*      MessageBox('Ejecuta evento COMSA1. Cl1='~Dialogo.Cliente1~' - Cl2='~Val(cc:2)~' - Cl3='~Val(cc:3))
#ifdef PRUEBA
      MessageBox('No Ejecuta evento COMSA1.')
#else
      EjecutarEvento('COMSA1',Vehiculo1=Dialogo.Vehiculo1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Cliente1=Dialogo.Cliente1,Check1=0,Check2=1,Check3=Dialogo.Check3,Cliente2=val(cc2),Cliente3=val(cc3),Entero4=Dialogo.Entero4,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3)
#endif 

      ACN(cc1, 0)
      ACT(cc2, '')
      ACT(cc3, '')
   ELSE
      ACT(cc3, FBN['Cliente'] ) 
   EndIf
Proximo

IF NoVacio(Val(cc3))
   Message('Ejecuta evento COMSA1 (2). Cl1='~Dialogo.Cliente1~' - Cl2='~Val(cc:2)~' - Cl3='~Val(cc:3))
#ifdef PRUEBA
   MessageBox('No Ejecuta evento COMSA1 (2).')
#else
   EjecutarEvento('COMSA1',Vehiculo1=Dialogo.Vehiculo1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Cliente1=Dialogo.Cliente1,Check1=0,Check2=1,Check3=Dialogo.Check3,Cliente2=val(cc2),Cliente3=val(cc3),Entero4=Dialogo.Entero4,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3)
#endif 
ENDIF

