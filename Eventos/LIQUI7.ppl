***---Select
(.'LIQUID1'.)

SQL.ADD(" ORDER BY 1, 2, 3, 4 ")

Recorrer SQL

   ACT(TP:99, fbn('TipoOp'))
   IF Eqstr(fbn('TipoOp'), 'MMP')

       ***---Armo lista de operaciones de la partida
       ACT(LS:1, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where OperacionRef = '"~fbn('NrOperacion')~"' "))
       ACT(Z:1, SQLSet(" Select TipoOp From "~DBO~".OPERACIONES Where NrOperacion IN ("~Pipe2Comillas(Val(LS:1))~") "))
   ELSE
        IF Eqstr(fbn('TipoOp'), 'INTGAR')
            ACT(Z:1, fbn('TipoOp'))
        ELSE
           ACT(z1, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn('NrOperacion')))
        ENDIF
        ACT(LS:1, fbn('NrOperacion'))
   ENDIF
   If Incluido(Val(z1),Exe('CARTA1C')) o Incluido(Val(z1),Exe('CARTA1V')) o Incluido(Val(z1),Exe('CARTA2')) O Eqstr(Val(Z:1),'INTGAR')
      ACN(BD:5, 0)

      (.'LIQUID2'.)
      IF Val(BD:5) = 0
         Message(" Operacion Nro. "~FBN['NrOperacion'])
         ACT(bo:fac,FBN['Book1'])
         ACT(a:fac, FBN['NrOperacion'])
         ACD(b:fac, FBN['FechaMov'])
         ACT(c:fac, FBN['Cliente'])
         ACT(d:fac, FBN['Especie']~' '~FBN['Cupon'])
         ACN(e:fac, -FBN['Cantidad'])
         ACT(g:fac, FBN['Transaccion'])
         ACT(f:fac, FBN['Cuenta'])
         ACT(i:fac, FBN['Leyenda'])
         ACN(k:fac, 0)
         ACN(p:fac, FBN['NrMov'])
         ACT(r:fac, FBN['Especie'])
         ACT(s:fac, FBN['Cupon'])
         ACT(u:fac, FBN['Cuenta'])
         ACT(VL:fac, FBN['Vehiculo'])
         ACT(TP:fac, fbn('TipoOp'))
         ACT(TC:1, BuscarCampo('CUENTAS','TipoCuenta','Codigo', fbn('Cuenta')))
         **// Este campo indica si tengo que marcar como liquidada la op.
         ACN(aa:fac, FBN('NrLiq'))
         ACT(YY:fac, Var('VIAPAGODEF'))    
      ELSE
         DFA
      ENDIF
   Else
      DFA
   Endif
Proximo
*MessageBox('F:Fac1 '~val(f:fac))  
If FAC>0
   ACN(z3,FAC)
   Recorrer&i 1, Val(z3)
      IF Eqstr(Val(TP:&i), 'MMP')
          ACT(LS:&i, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where OperacionRef = '"~Val(A:&i)~"' "))
      ELSE
          ACT(LS:&i, Val(A:&i))
      ENDIF
      ACT(q:&i, Ascendientes('ESPECIES',val(r:&i)) )

      ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )

      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta Permanente del Cliente de la operacion y el vehiculo de la operacion
         SQL.ADD("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(VL:&i)~"' and Comitente = '"~Val(c:&i)~"'  and Permanente = 'SI' and Estado = 'HAB' and Numero is Not NULL")
         Recorrer SQL
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               ACT(l:&i, 'Perm.')
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else
                  ACT(g:&i, 'DEBITO')
               Endif
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               Break
            Endif
         Proximo
        
      Else 
         *- En la operacion marcaron una cuenta valida
         Recorrer ("Select Permanente,Comitente,Cliente,Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Codigo = '"~val(f:&i)~"' ")
            DFA 
            ACT(l:&i, IIF(EqStr(FBN['Permanente'],'SI'),'Perm.','') )
            ***---If EqStr(FBN['Comitente'],Val(c:&i)) O Eqstr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo', Val(TP:&i)), Var('CLASEOPVIN'))   
               *- Es una cuenta del mismo banco que la operacion
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else 
                  ACT(g:&i, 'DEBITO')
               Endif
            ***---Else 
            ***---   ACT(g:&i, 'TRANSF')
            ***---Endif
            ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
         Proximo
      EndIf

    
      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta No Permanente del Cliente de la operacion y el vehiculo de la operacion
         Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(VL:&i)~"' and Comitente = '"~Val(c:&i)~"' and Estado = 'HAB' and Numero is Not NULL")
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else
                  ACT(g:&i, 'DEBITO')
               Endif
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               break
            Endif
         Proximo
      Endif

* MessageBox('F:Fac??? '~val(f:&i))  

      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta Permanente de cualquier cliente y el vehiculo de la operacion
         Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(VL:&i)~"' and Permanente = 'SI' and Estado = 'HAB' and Numero is Not NULL")
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               ACT(l:&i, 'Perm.')
               ACT(g:&i, 'TRANSF')
               break
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
            Endif
         Proximo
         If Vacio(Val(f:&i)) o Vacio(val(zz1))
            *- CUENTA VEHICULO: Cuenta No Permanente de cualquier cliente y el vehiculo de la operacion
            Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(VL:&i)~"' and Estado = 'HAB' and Numero is Not NULL")
               dfa
               If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                  ACT(f:&i, FBN['Codigo'])
                  ACT(g:&i, 'TRANSF')
                  break
                  ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               Endif
            Proximo
         Endif
         If NoVacio(Val(f:&i))
            *- CUENTA CLIENTE: 
            Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Permanente = 'SI' and Estado = 'HAB'  and Numero is Not NULL")
               dfa
               If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                  ACT(h:&i, FBN['Codigo'])
                  break
               Endif
            Proximo
            If Vacio(Val(h:&i))
               Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Estado = 'HAB'  and Numero is Not NULL")
                  dfa
                  If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                     ACT(h:&i, FBN['Codigo'])
                     break
                  Endif
               Proximo
            Endif
         Endif
      Endif
   Proximo 
*MessageBox('F:Fac3 '~val(f:fac))  
   Recorrer&j 1,100
      CrearListBox;'Arial,8,B'
         'Liquida'                  ; k1..k:fac; SI; SI;;60; COMBO;'Si|No|'
         '# Operacion'              ; a1..a:fac; NO; SI;;100; STRING
         'Fecha'                    ; b1..b:fac; NO; SI;;100; FECHA
         'Vehiculo'                 ; vl1..vl:fac; NO; SI;;80; STRING
         'Entidad'                  ; c1..c:fac; NO; SI;;90; STRING
         'Especie'                  ; d1..d:fac; NO; SI;;70; STRING
         'Cantidad'                 ; e1..e:fac; NO; SI;;100; NUMERO;'###,###,###,###.##p'
***---         'Cuenta '                  ; f1..f:fac; SI; [NoVacio(Val(CLB:FLB)) y [EqStr(Val(VL:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB))) O Incluido(Val(TP:FLB), 'FCS|FCR')]] o Val(k:FLB)=1; "Error Cuenta "~Val(VL:FLB); 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
         'Cuenta '~Val(VL:FLB);     f1..f:fac; SI; [NoVacio(Val(CLB:FLB)) y [EqStr(Val(VL:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))]] o Val(k:FLB)=1; "Error Cuenta "~Val(VL:FLB); 150; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre;Cliente';
         'Transaccion'              ; g1..g:fac; SI; NoVacio(Val(CLB:FLB)) o Val(k:FLB)=1; "Error Transaccion" ; 90; TABLA; 'TiposTransaccion';'Codigo';'Codigo;Descripcion';
         'ViasPago'                 ; YY:1..YY:fac; Val(k:FLB)=0; [NOVACIO(Val(YY:flb)) y Eqstr(BUSCARCAMPO('VIASPAGO','Codigo','Codigo',Val(YY:flb) ),Val(YY:FLB))] O Val(k:FLB)=1 ;"Vias de Pago Invalido" ;70; STRING;RGB(255,255,193)            
         'Cuenta Entidad'           ; h1..h:fac; SI; Eqstr(Val(TC:FLB), 'PUE') O [Incluido(Val(g:FLB),'CREDIT|DEBITO|EMI_CH|COMP') y Vacio(Val(CLB:FLB))] o [Incluido(Val(g:FLB),'TRANSF|C_4090') y [[Val(e:FLB)<0 y NoVacio(Val(CLB:FLB)) y EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))] o [Val(e:FLB)>0 y [Vacio(Val(CLB:FLB)) o EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))]]]] o Val(k:FLB)=1; "Error Cuenta Entidad "~Val(c:FLB); 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
***---         'Cuenta Entidad'           ; h1..h:fac; SI; Eqstr(Val(TC:FLB), 'PUE') O [Incluido(Val(g:FLB),'CREDIT|DEBITO|EMI_CH|COMP') y Vacio(Val(CLB:FLB))] o [Incluido(Val(g:FLB),'TRANSF|C_4090') y [[Val(e:FLB)<0 y NoVacio(Val(CLB:FLB)) y EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))] o [Val(e:FLB)>0 y [Vacio(Val(CLB:FLB)) o EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))]]]] o Val(k:FLB)=1 o SI; "Error Cuenta Entidad "~Val(c:FLB); 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
         'Leyenda'                  ; i1..i:fac; NO; SI;;300; STRING
         'Cta Movimiento'           ; u1..u:fac; NO; SI;;100; STRING
         'Observaciones'            ; w1..w:fac; SI; SI;;350; STRING;57
      FinListBox
      ** CONDICIONES PARA PODER LIQUIDAR **
      * FILA F: La cuenta no vacia y vehiculo= Cliente de la cuenta y ( transaccion <> CREDIT|DEBIT  o entidad=Comitente de la cuenta)
      * FILA G: Transaccion no vacia
      * FILA H: (Transaccion=DEBITO|CREDIT|EMI_CH|COMP y cuenta vacia ) o ( Transaccion=TRANSF|C_4090 y ( (cantidad<0 y no vacia la cuenta y entidad=Cliente de la cuenta) o (cantidad>0 y (cuenta vacia o entidad=cliente de la cuenta)) ) )
      If Ok
         * Verifico que liquide en conjunto de NrOp, Fecha, Entidad y Especie
         * ab1: NrOperacion~Fecha~Entidad~Especie

         ACN(ab3,0)
         ACN(ab5,0)

         Recorrer&i 1,FAC
            *If Not EqStr(val(ab1),Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i)) 
            *   ACT(ab1,Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i))
            *   ACN(ab2,Val(k:&i))
            *Else 
            *   If Val(k:&i)<>Val(ab2)
            *      MessageBox('Liquidacion Inconsistente para '~val(ab1))
            *      ACN(ab5,1)
            *   EndIf
            *EndIf                
            If Val(k:&i)=0
               * Selecciono los mov. correctamente, Verifico el resto de las condiciones 
               If Incluido(Val(g:&i),'CREDIT|DEBITO')
                  ACT(h:&i, '')
               Endif
               If Not EqStr(Val(g:&i),'EMI_CH')
                  ACT(j:&i, '')
               Endif
               ACT(x1, Val(q:&i))
***---               ACT(x2, Pad(Val(g:&i),6)~'    ')
               ACT(x2, Pad(Val(g:&i),6))
               ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I E')
               If Val(e:&i)>0
                  ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
                  ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
               Endif
               If Val(e:&i)<0
                  ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
                  ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
               Endif
               *Valida Cuenta Propia
               If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(f:&i)),1)
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(f:&i)~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               ACT(TR:1, BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)))
               ***---El ABM agrega 4 blancos a cada elemento de Transacciones. Pero el WS no.
               ***---Entonces quito los blancos
               Recorrer&k 1, Elementos(Val(TR:1))
                   ACT(TR:2, Val(TR:2)~Trim(ItemLista(Val(TR:1), &k))~'|')
               Proximo
***---               If Not Incluido(Val(x2),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)),1)
               If Not Incluido(Val(x2), Val(TR:2),1)
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(f:&i)~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(f:&i)))
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La cuenta '~Val(f:&i)~' no esta habilitada, Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               If Vacio(BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)))
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La cuenta '~Val(f:&i)~' no es una cuenta real correspondiente a '~Val(VL:&i)~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               *Valida Cuenta Entidad
               If NoVacio(Val(h:&i))
                  If Not EqStr(Val(c:&i),BuscarCampo('CUENTAS','Cliente','Codigo',Val(h:&i)))
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La cuenta '~Val(h:&i)~' no corresponde a '~Val(c:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(h:&i)),1)
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(h:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not Incluido(Val(x3),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(h:&i)),1)
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(h:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(h:&i)))
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La cuenta '~Val(h:&i)~' no esta habilitada, Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
               Endif
            Endif
         Proximo
         If Val(ab3)=0
            Break
         EndIf
      Else 
         Cancelar 
      EndIf
   Proximo
   If val(ab3)=0 y val(ab5)=0
      Recorrer&i 1,FAC
         If Val(k:&i)=0
            If NO 
             *- Claudia 23.04.2002
             If Incluido(Val(g:&i),'CREDIT|DEBITO')
             ACT(h:&i, '')
             Endif
             If Not EqStr(Val(g:&i),'EMI_CH')
             ACT(j:&i, '')
             Endif
             ACT(x1, Val(q:&i))
             ACT(x2, Pad(Val(g:&i),6)~'    ')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I E')
             If Val(e:&i)>0
             ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
             Endif
             If Val(e:&i)<0
             ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
             Endif
             *Valida Cuenta Propia
             If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(f:&i)),1)
             MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(f:&i))
             ACN(m:&i,1)
             Endif
             If Not Incluido(Val(x2),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)),1)
             MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(f:&i))
             ACN(m:&i,1)
             Endif
             If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(f:&i)))
             MessageBox('La cuenta '~Val(f:&i)~' no esta habilitada')
             ACN(m:&i,1)
             Endif
             If Vacio(BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)))
             MessageBox('La cuenta '~Val(f:&i)~' no es una cuenta real correspondiente a '~Val(VL:&i))
             ACN(m:&i,1)
             Endif
             *Valida Cuenta Entidad
             If NoVacio(Val(h:&i))
             If Not EqStr(Val(c:&i),BuscarCampo('CUENTAS','Cliente','Codigo',Val(h:&i)))
             MessageBox('La cuenta '~Val(h:&i)~' no corresponde a '~Val(c:&i))
             ACN(n:&i,1)
             Endif
             If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(h:&i)),1)
             MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(h:&i))
             ACN(n:&i,1)
             Endif
             If Not Incluido(Val(x3),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(h:&i)),1)
             MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(h:&i))
             ACN(n:&i,1)
             Endif
             If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(h:&i)))
             MessageBox('La cuenta '~Val(h:&i)~' no esta habilitada')
             ACN(n:&i,1)
             Endif
             Endif
            *- Claudia 23.04.2002
           EndIf
            * Verifico que los mov. que esta tomando esten Ptes.
            ACN(o:&i,1) 
            SQL.ADD("Select 1 from "~DBO~".MOVPENDIENTES M where")
            SQL.ADD("NrSaldo=1 ")
            SQL.ADD("and M.FechaMov <='"~IdxDate(val(b:&i))~"' ")
            SQL.ADD("and M.EnteCustodia= '"~Val(VL:&i)~"' ")
            SQL.ADD("and M.Bits = 'MV' ")
            SQL.ADD("and M.Especie = '"~VAL(r:&i)~"' ")
            SQL.ADD("and M.Cliente = '"~VAL(c:&i)~"' ")
            SQL.ADD("and M.NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
            IF Dialogo.Check1 = 1 Y Eqstr(Val(TP:99), 'MMP')
                SQL.ADD("and M.NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
            ELSE
                SQL.ADD("and M.NrOperacion='"~VAL(a:&i)~"' ")
            ENDIF
            Recorrer SQL
               Message('Verifico que el Mov. no se haya liquidado Previamente '~val(a:&i)~' '~Fstr(VAL(p:&i),0,0)~' ...' )
               ACN(o:&i,0) 
            Proximo
             
            If val(o:&i)=1
               MessageBox('El Mov. de la Operacion '~val(a:&i)~' Nro. '~Fstr(VAL(p:&i),0,0)~' fue liquidado Previamente por Otro Usuario ....')
            EndIf
            If Val(m:&i)=0 y Val(n:&i)=0 y Val(o:&i)=0
               *----   Genera Vou. de Liq
               ACT(t:&i,GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo',Val(VL:&i))))
               ***---El campo Observaciones puede excederse.
               IF Eqstr(Val(TP:&i), 'MMP')
                   ACT(XX:&i, Copy(Val(W:&i)~' ('~Val(LS:&i)~')', 1, 200))
               ELSE
                   ACT(XX:&i, Copy(Val(W:&i), 1, 200))
               ENDIF
               ***---Insert DEP-RET
               (.'LIQUID3'.)
          *   MESSAGEBOX ('Procesando campo VIASPAGO'~ Val(YY:&i)~ 'NroTrans'~ Val(t:&i)     )

               SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
               SQL.ADD("(NrBit, NrOperacion, Valor) ")
               SQL.ADD("Select NrInstancia, '"~Val(t:&i)~"', '0'")
               SQL.ADD("from "~DBO~".INSTANCIAS ")
               SQL.ADD("where Tabla = 'TRANSACCIONES2'")
               SQL.NEW

               *** Prendo instancias segun si es por DATANET o no
               If Val(v:&i)=0
                  SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS ")
                  SQL.ADD(" SET Valor = '1' ")
                  SQL.ADD(" Where NrBit = 1 and NrOperacion = '"~Val(t:&i)~"' ")
               Else
                  SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS ")
                  SQL.ADD(" SET Valor = "~Fstr(Val(v:&i),0,0))
                  SQL.ADD(" Where NrBit = 17 and NrOperacion = '"~Val(t:&i)~"' ")
               Endif
               SQL.NEW
               Message('Genera Voucher '~Val(t:&i))
               Message('Genera Movimientos de la Transaccion')
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 * Si NO Concilia con datanet los movimientos siguen como antes
                 If Dialogo.Fecha1>FSys
                    SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")
                 Else
                    SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
                    SQL.ADD("FechaEje, ")
                    SQL.ADD("UsuarioEje, ")
                 Endif
               Else
                 * Si Concilia con datanet los movimientos siempre quedan pendientes
                 SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")
               Endif
               SQL.ADD("NrTrans2, ")
               SQL.ADD("NrOperacion, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Cantidad, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("Bits, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Cuenta, ")
               SQL.ADD("Transaccion ")
*               SQL.ADD("Book, ")
*               SQL.ADD("Vehiculo, ")
*               ***---Se agregan campos Mercado, Concepto y Status con '' para que no se inserten en null, ya que no quedan bien los saldos
*               SQL.ADD("Mercado, ")
*               SQL.ADD("Concepto, ")
*               SQL.ADD("Status ")
               SQL.ADD(") Values (")
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 If Dialogo.Fecha1<=FSys
                    SQL.ADD("'"~IdxDate(Hoy)~"', ")
                    SQL.ADD("'"~UsuarioActivo~"', ")
                 Endif
               Endif
               SQL.ADD("'"~Val(t:&i)~"', ")
               SQL.ADD("'"~Val(t:&i)~"', ")
               * Agrego la leyenda del movimiento para en informe de Posicion Bancaria
               If Val(e:&i) > 0
                  ACT(ly:1, 'Cobro - '~Val(i:&i))
               Else
                  ACT(ly:1, 'Pago - '~Val(i:&i))
               Endif
               SQL.ADD(" '"~Val(ly:1)~"' , ")
               SQL.ADD(""~FStr(Val(e:&i),1,2)~", ")
               SQL.ADD("'"~Val(VL:&i)~"',")
               SQL.ADD("'"~Val(r:&i)~"', ")
               SQL.ADD("'', ")
               * Pongo Saldo 99 si liquida con cheque para que no se duplique el mov en el saldo
               If Val(vu:&i)=1
                 SQL.ADD(""~FStr(99,1,0)~", ")
               Else
                 SQL.ADD(""~FStr(1,1,0)~", ")
               Endif
               SQL.ADD(""~FStr(0,1,0)~", ")
               SQL.ADD(""~FStr(0,1,0)~", ")
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 SQL.ADD("'AV', ")
               Else
                 SQL.ADD("'MV', ")
               Endif
               SQL.ADD("'"~Val(s:&i)~"', ")
               SQL.ADD(""~FStr(0,0,0)~", ")
               SQL.ADD(""~FStr(0,1,0)~", ")
               SQL.ADD("'"~IdxDate(Val(b:&i))~"', ")
               SQL.ADD("'"~Val(VL:&i)~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("'"~Val(g:&i)~"' ")
*               SQL.ADD(" '', ")
*               SQL.ADD(" '', ")
*               SQL.ADD(" '', ")
*               SQL.ADD(" '', ")
*               SQL.ADD(" '' ")


               SQL.ADD(")")
               SQL.NEW

               *Genera Movimientos Ejecutados de la Operacion
               SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
               SQL.ADD("NrOperacion, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("FechaEj, ")
               SQL.ADD("PrecioEj, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Mercado, ")
               SQL.ADD("Formula, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Bits, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("Concepto, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrLiq, ")
               SQL.ADD("Status, ")
               SQL.ADD("NrComprob, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("FechaEje, ")
               SQL.ADD("UsuarioEje, ")
               SQL.ADD("Cuenta, ")
               SQL.ADD("Transaccion, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("NrTrans2, ")
               SQL.ADD("Cantidad, ")
               SQL.ADD("Book, ")
               SQL.ADD("Vehiculo ")

               SQL.ADD(") select ")

               SQL.ADD("NrOperacion, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("FechaEj, ")
               SQL.ADD("PrecioEj, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Mercado, ")
               SQL.ADD("Formula, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Bits, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("Concepto, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrLiq, ")
               SQL.ADD("Status, ")
               SQL.ADD("NrComprob, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("'"~IdxDate(Hoy)~"', ")
               SQL.ADD("'"~UsuarioActivo~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("Transaccion, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("'"~Val(t:&i)~"', ")
               SQL.ADD("Cantidad, ")
               SQL.ADD("Book, ")
               SQL.ADD("Vehiculo ")
               SQL.ADD(" from "~DBO~".MOVPENDIENTES ")
               IF Dialogo.Check1 = 1 Y Eqstr(Val(TP:99), 'MMP')
                   SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
               ELSE
                   SQL.ADD(" Where NrOperacion='"~VAL(a:&i)~"' ")
               ENDIF
               SQL.ADD(" and NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
               SQL.ADD("and NrSaldo = 1 ")
               SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
               SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
               SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
               If NoVacio(Val(s:&i))
                  SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
               Else
                  SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
               Endif
               SQL.NEW
               Message(' Se Borran los Movs Pendientes de la operacion')
               SQL.ADD("DELETE /*+ RULE */ FROM "~DBO~".MOVPENDIENTES ")
               IF Dialogo.Check1 = 1 Y Eqstr(Val(TP:99), 'MMP')
                   SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
               ELSE
                   SQL.ADD(" Where NrOperacion='"~VAL(a:&i)~"' ")
               ENDIF
               SQL.ADD(" and NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
               SQL.ADD("and NrSaldo = 1 ")
               SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
               SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
               SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
               If NoVacio(Val(s:&i))
                  SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
               Else
                  SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
               Endif
               SQL.NEW
               SQL.EXEC
               ***---Guardo NrTrans2 en IMPUESTOS
               (.'LIQUID4'.)

               **// Marco la Op como liquidada
               (.'LIQUID5'.)

               ***---Se realiza la confirmacion de cobros y pagos en forma automatica
***---               EjecutarEvento('CONFCP', Vehiculo1 = Dialogo.Vehiculo1, Fecha1 = Val(B:&i), Especie1 = '', Cliente1 = '', NrTrans1 = Val(T:&i), Check1 = 0)
                #ifdef BFSA
                *#ifdef STD_CORP
                    IF Incluido(Val(TP:&i), Var('TIPOOPCOMP'))
                        ***---IF Not Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo', Val(C:&i)), 'ALY') Y DesciendeDeEspecie(Val(D:&i),'MONEDA')
                        IF Not Incluido(BuscarCampo('CUENTAS','TipoCuenta','Codigo',Val(F:&i)), 'CUS|INV') Y DesciendeDeEspecie(Val(D:&i),'MONEDA')
                            ***---No se generan comprobantes para Ctas Custodia o Inversor, solo para bancos
                            If EqStr(Val(G:&i),'CREDIT')
                                ***Generacion de comprobantes de ingreso
                                EjecutarEvento('GENCIN',NrTrans1=Val(T:&i),Book1=Val(bo:&i),String1=Val(i:&i))                        
                            ELSE
                                If EqStr(Val(G:&i),'DEBITO')
                                    ***---Comprobante de Egreso
                                    EjecutarEvento('INTCEG',NrTrans1=Val(T:&i),Book1=Val(bo:&i))
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                #endif
            Endif
         Endif
      Proximo
   Else
      Cancelar
   Endif
Else
   Cancelar("No Hay Movimientos a Liquidar")
Endif

