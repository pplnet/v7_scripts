ACT(VH:2, SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') AND V.Codigo Not in ("~Pipe2Comillas(Var('VLIQUIDAA'))~") "))
CrearDialogo
   *Vehiculo1: "Vehiculo" ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1) y IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "));NO
   Fecha2   : "F.Desde"  ;1;;;;;Vacio(Dialogo.Fecha2) o Dialogo.Fecha2<=Dialogo.Fecha1;'Fecha Desde Vacia o Inferior a Fecha Hasta';NO;;
   Fecha1   : "F.Hasta"  ;;;;;;Dialogo.Fecha1>0 Y Dialogo.Fecha1 <= Fsys;'Fecha Hasta Invalida';NO;FSys;
