MostrarCuadroDeMensajes
 
CrearDialogo
   Archivo1: "Ruta del Archivo";;;;;;;;;;VAR('VUECTA')
FinDialogo
If Not Ok 
      Cancelar
Endif 

AbrirAscii(Dialogo.Archivo1, 0, SI, 2)

ACT(A:1, 'CODIGO')
ACT(B:1, 'NOMBRE')
ACT(C:1, 'NUMERO')
ACT(D:1, 'CLIENTE')
ACT(E:1, 'DEPOSITANTE')
ACT(F:1, 'COMITENTE')
ACT(G:1, 'MERCADO')
ACT(H:1, 'ESPECIES')
ACT(I:1, 'TIPOCUENTA')
ACT(J:1, 'ESTADO')
ACT(K:1, 'BANCO')

let &err 0

Recorrer&i 1,10000
  act(CC:&i , LeerAscii)
  message(Copy(Val(CC:&i), 1,   10))  
  If Not Ok 
      Break
  Endif 
  
  act(a:&i, Trim(Copy(Val(CC:&i), 1,   10)))
  act(b:&i, Trim(Copy(Val(CC:&i), 11,  50)))
  act(c:&i, Trim(Copy(Val(CC:&i), 61,  40)))
  act(d:&i, Trim(Copy(Val(CC:&i), 101, 10)))
  act(e:&i, Trim(Copy(Val(CC:&i), 111, 10)))
  act(f:&i, Trim(Copy(Val(CC:&i), 121, 10)))
  act(g:&i, Trim(Copy(Val(CC:&i), 131, 6)))
  act(h:&i, Trim(Copy(Val(CC:&i), 137, 10)))
  act(i:&i, Trim(Copy(Val(CC:&i), 147, 3)))
  act(j:&i, Trim(Copy(Val(CC:&i), 150, 3)))
  act(k:&i, Trim(Copy(Val(CC:&i), 153, 10)))
  
  If NOVACIO(a:&i) y (SQL("SELECT count(*) from "~DBO~".Cuentas WHERE Codigo ='"~val(a:&i)~"'")=0)
  SQL.ADD("INSERT INTO "~DBO~".Cuentas(Codigo, Nombre, Numero, Cliente, NrDepositante,fechaalta, Mercado, Especies,TipoCuenta, Estado ")
    If NOVACIO(val(k:&i))  
    SQL.ADD(", Banco")
    Endif
    If NOVACIO(val(f:&i))
      SQL.ADD(", Comitente")
    Endif
    SQL.ADD(")")
                       *codigo,         nombre,         numero,           cliente        Nrdepositante          fechalta
    SQL.ADD("VALUES ('"~VAL(a:&i)~"', '"~VAL(b:&i)~"', '"~VAL(c:&i)~"', '"~VAL(d:&i)~"', '"~VAL(f:&i)~"','"~idxdate(Fsys)~"',")
    if eqstr(VAL(g:&i),'BCRA')
       *Mercado
       sql.add("'"~VAR('MERCADOBT')~"',")
    else
        if eqstr(VAL(g:&i),'SWIFT')
           sql.add("'"~VAR('MERINCAB')~"',")
        else
           sql.add("'"~VAL(g:&i)~"',")
        endif
    endif
    *          Especies          Tipocuenta       Estado
    sql.add("'"~VAL(h:&i)~"|', '"~VAL(i:&i)~"', '"~VAL(j:&i)~"'")
    *Banco
    If NOVACIO(val(k:&i))  
     SQL.ADD(", '"~VAL(k:&i)~"' ")
    Endif
    *Comitente
    If NOVACIO(val(f:&i))
       *SQL.ADD(", '"~VAL(e:&i)~"'")
       SQL.ADD(", '"~VAR('VEHICULODE')~"'")
    Endif
    SQL.ADD(")")
    
    SQL.NEW
    SQL.EXEC  
  Else
   let &err &err+1
  Endif

  
Proximo

CerrarAscii

messagebox("Evento finalizado. 
Codigos repetidos o Vacios: "~fstr(&err))
