HojaVisible(SI)
*MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1 : "Vehiculo"                                ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
*  Fecha1    : "Fecha"                                   ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FinDeMes(Fsys-Dia(Fsys),SI,'ARG')
  Fecha1    : "Fecha"                                   ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FinDeMes(Fsys,NO,'ARG')
  Radio3    : 'Cartera|BCRA|RML|Otros valores|Terceros' ; ; ;;;;;;;
  Radio2    : "Salida|Informe|Inf+TXT"                  ; ; ;;;;;;;
  String1   : 'Path'                                    ; ; ;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;;
  String2   : 'Archivo'                                 ; ; ;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;;
  Radio1    : 'Sist.Oper.|W98|NT'                       ; ; ;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;; 
FinDialogo

IF Not Ok
  Cancelar
ENDIF

If Dialogo.Radio2=1 y Not ExisteDirectorio(Dialogo.String1)
   Messagebox('No existe el path '~Dialogo.String1~'. Debera crearlo.')
   Cancelar
Endif

IF Dialogo.Radio2=1 y ExisteArchivo(Dialogo.String1~Dialogo.String2) 
   IF Dialogo.Radio1 = 0
    *  WinExec('COMMAND.COM /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ELSE
     * WinExec('CMD.EXE /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ENDIF

   ***---A veces ejecuta lo que sigue y el S.O. todavia no borro el archivo
   Message('Borrando el archivo '~Dialogo.String2)
   Esperar(3)
EndIf

IF Dialogo.Radio2=1 
   ACT(aa1, Dialogo.String1~Dialogo.String2)

   Message('Creando Archivo '~Dialogo.String2)

   AbrirASCII(val(aa1),0)
EndIf

CrearFont(2,"Arial,8,")
CrearFont(1,"Arial,8,I")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT E.Codigo as Especie, E.Extendido, E.ISIN as CodigoISIN, E.Tipo, ")
SQL.ADD("       E.CodMAEContado as CodigoMAE, E.CodNumCajaValores as CodigoCValores, ")
SQL.ADD("       E.LocalRating1 as TipoValor, E.PaisOrigen, SUM(S1.Saldo) Cantidad, ")
SQL.ADD("       E.MonedaEmision as Cotiza, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.InteresesC, C.PaisDir, C.CategDepositante as CatDep, CASE C.AFJP WHEN 'NO' THEN 'NO' WHEN 'SI' THEN 'SI' ELSE 'NO' END AS AFJP ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON S1.Cliente = C.Codigo ")
SQL.ADD("     INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON E.Codigo = S1.Especie ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK) ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("        ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
SQL.ADD("WHERE S1.Cliente <> '"~Dialogo.Vehiculo1~"' AND  S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha)                        ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK)     ")
SQL.ADD("                  WHERE S2.Cliente      = S1.Cliente      AND ")
SQL.ADD("                        S2.Especie      = S1.Especie      AND ")
*SQL.ADD("                        S2.Cupon        = S1.Cupon        AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado      = S1.Mercado      AND ")
SQL.ADD("                        S2.NrSaldo      = S1.NrSaldo      AND ")
SQL.ADD("                        S2.Cuenta       = S1.Cuenta       AND ")
SQL.ADD("                        S2.Fecha       <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY E.Codigo, E.Extendido, E.ISIN, E.CodMAEContado, E.CodNumCajaValores, ")
SQL.ADD("         E.LocalRating1, E.Tipo, E.PaisOrigen, E.MonedaEmision, E.FechaCambioTasa, ")
SQL.ADD("         E.TasaIntAnterior, E.TasaIntVigente, E.InteresesC, C.PaisDir, ")
SQL.ADD("         C.CategDepositante, CASE AFJP WHEN 'NO' THEN 'NO' WHEN 'SI' THEN 'SI' ELSE 'NO' END ")
SQL.ADD("ORDER BY 3,1,10")

*- AZ2: Codigo de BCRA de MERRILL
ACN(az22,BuscarCampo('CLIENTES','CodigoBCRA','Codigo',Dialogo.Vehiculo1))

ACT(a1, 'Circular "A" 3310 a la fecha '~Dialogo.Fecha1~' Entidad Informante : '~Fstr(val(az22),0,0))
ACT(h1, 'Fecha: '~Var('FECHASYS'))
SetFont(a1..h1,3)

ACT(a3, 'Cartera Propia: '~IIF(Dialogo.Radio3=0,'BCRA',IIF(Dialogo.Radio3=1,'RML',IIF(Dialogo.Radio3=2,'Otros Valores','Terceros'))))
SetFont(a3..e3,3)

ACT(a:8, 'Fecha ')
ACT(b:8, 'Codigo ')
ACT(b:9, ' ISIN ')
ACT(c:8, 'Codigo ')
ACT(c:9, ' MAE ')
ACT(d:8, 'Caja de ')
ACT(d:9, 'Valores ')
ACT(e:8, 'Denominacion')
ACT(f:8, ' Tipo ')
ACT(f:9, ' Valor ')
ACT(g:8, ' Pais ')
ACT(g:9, ' emisor ')
ACT(h:8, 'Moneda')
ACT(i:8, ' Pais')
ACT(i:9, 'tenedor')
ACT(j:8, ' Categoria ')
ACT(j:9, ' del Tenedor ')
ACT(k:8, 'Valor Nominal ')
ACT(k:9, ' (en miles) ')
ACT(l:8, 'Precio')
ACT(m:8, '  Valor Mercado ')
ACT(m:9, '(en miles de pesos)')

SetFont(a:8..m:9,3)
AlinearCeldas(a:8..m:9,'C')


ACT(ml1,VAR('MONELOCA'))
ACT(me1,VAR('MONEEXTR'))

ACN(fi1, 10)
SetFilaActual(Val(fi1)-1)

Message('Recuperando Datos ')

Recorrer SQL

    *- a: Fecha
    ACT(a:fac, Dialogo.Fecha1)

    *- b: Codigo ISIN
    *- c: Codigo Mae
    *- d: Codigo Caja Valores
    *-Si no Tiene Codigo ISIN se pone el Codigo Mae y el Codigo de Caja de Valores
    If Vacio(FBN['CodigoISIN'])  
       ACT(c:fac,Copy(FBN['CodigoMAE'],1,5))
       ACT(d:fac,Copy(FBN['CodigoCValores'],2,4))
    Else
       ACT(b:fac,FBN['CodigoISIN'])
    Endif
    
    *- e: Denominacion   
    ACT(e:fac, Copy(FBN['Extendido'],1,60))

    *- f: Codigo del Tipo Valor
    ACT(f:fac, Copy(FBN['TipoValor'],1,2))
    
    *- g: Codigo del Pais Emisor
    ACT(g:fac, Copy(FBN['PaisOrigen'],1,3))
    
    *- h: Moneda en que se cotiza
     ACT(h:fac,FBN['Cotiza'])
*    If EqStr(FBN['Cotiza'],val(ml1))
*       ACT(h:fac,val(ml1))
*    Else
*       ACT(h:fac,val(me1))
*    Endif  
    
    *- l: Precio
    ACN(l:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,val(ml1))) 

    *- i: Pais del cliente Tenedor
    ACT(i:fac, Copy(FBN['PaisDir'],1,3))   

    *- j: Categoria del cliente Tenedor
    if EqStr(FBN['AFJP'],'SI')
       act(ax1,'1')
    else
       if EqStr(FBN['CatDep'],'CSE')
          act(ax1,'2')
       else
          if EqStr(FBN['CatDep'],'ABO')
             act(ax1,'3')
          else
             if EqStr(FBN['CatDep'],'BAN')
                act(ax1,'4')
            else
               if EqStr(FBN['CatDep'],'FON')
                  act(ax1,'5')
               else
                  act(ax1,'6')
               endif   
            endif   
         endif   
      endif   
    endif     
    act(j:fac, val(ax1))
*    ACT(j:fac,IIF(EqStr(FBN['AFJP'],'SI'),'1',IIF(EqStr(FBN['CatDep'],'CSE'),'2',IIF(EqStr(FBN['CatDep'],'ABO'),'3',IIF(EqStr(FBN['CatDep'],'BAN'),'4',IIF(EqStr(FBN['CatDep'],'FON'),'5','6')))))))    

    *- k: Valor Nominal  
    ACN(k:fac, FBN['Cantidad'])


    * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
    ACN(yt1, fac)
    ACD(yu:fac, Dialogo.Fecha1)
    ACT(yv:fac, FBN['Especie'])
    ACN(yw:fac, FBN['Cantidad'])
    ACD(yx:fac, FBN['FechaCambioTasa'])
    ACN(yy:fac, FBN['TasaIntAnterior'])
    ACN(yz:fac, FBN['TasaIntVigente'])
    (.'INTERESCLE'.)
    ACN(ca:fac, Val(zz:fac))
    ACN(cc:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))

    *- Alias4
    ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))

    *- m: Valuacion--> Valor Mercado
    IF EqStr(FBN['InteresesC'],'CLE')
       IF Incluido(Val(al4), '1585')
          ACN(m:fac, Val(k:fac)*Val(cc:fac)*Val(l:fac)+(Val(ca:fac)*Val(cc:fac)))
       ELSE
          ACN(m:fac, Val(k:fac)*Val(cc:fac)*Val(l:fac)+Val(ca:fac))
       ENDIF
    ELSE
       ACN(m:fac, Val(k:fac)*Val(l:fac)+Val(ca:fac))
    ENDIF

*    ACN(k:fac, Round2(Val(k:fac)/1000,2))
*    ACN(m:fac, Round2(Val(m:fac)/1000,2))

    ACT(k:fac, Fstr(Round2(Val(k:fac)/1000,2),0,0))
    ACT(m:fac, Fstr(Round2(Val(m:fac)/1000,2),0,0))

    SetFont(a:fac..m:fac,1)   
    AlinearCeldas(k:fac,'D')
    AlinearCeldas(m:fac,'D')

Proximo

    If Dialogo.Radio2=1
         *- Genero el TXT en columna aa
         Recorrer&j val(fi1),fac
             If NoVacio(val(b:&j)) o NoVacio(val(c:&j)) o NoVacio(val(d:&j))
                ACT(aa:&j,val(a:&j))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(b:&j),12))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(c:&j),5))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(d:&j),4))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(e:&j),60))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(f:&j),2))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(g:&j),2))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(h:&j),3))
                ACT(aa:&j,val(aa:&j)~','~Pad(val(i:&j),2))
                ACT(aa:&j,val(aa:&j)~','~val(j:&j))

                If LtStr(Val(k:&j),'0')
                   ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(k:&j),2,longitud(val(k:&j))),6))
                Else
                   ACT(aa:&j,val(aa:&j)~','~Pad0(val(k:&j),7))
                Endif

                ACT(aa:&j,val(aa:&j)~','~Pad0(FStr(val(l:&j),0,8),12))

                If LtStr(Val(m:&j),'0')
                   ACT(aa:&j,val(aa:&j)~',-'~Pad0(Copy(val(m:&j),2,longitud(val(m:&j))),9))
                Else
                   ACT(aa:&j,val(aa:&j)~','~Pad0(val(m:&j),10))
                Endif

                EscribirASCII(val(aa:&j))
             EndIf
         Proximo
*         Messagebox('Finalizo el Proceso')
    EndIf

SetfilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac,3)

FormatoCeldas(l:1..l:fac,Exe('F9'))  

ACO(1,7)
ACO(2,9)
ACO(3,5)
ACO(4,5)
ACO(5,35)
ACO(6,4)
ACO(7,5)
ACO(8,6)
ACO(9,7)
ACO(10,10)
ACO(11,10)
ACO(12,9)
ACO(13,15)
ACO(14,18)

FijarFila(Val(fi1))
CerrarASCII

LimitesVision(m:fac+1)
SetPrintFit(3,93)
RangoTitulo(a:1..m:fac, 8)
