CrearDialogo
  NrOrden1: 'Nr.Orden';1;1;1;;;Novacio(Dialogo.NrOrden1);'Orden Invalida.';NO;;;;;;"TipoOrden IN ('OTIC','OTIV')"
FinDialogo

if not Ok
  Cancelar
endif

**  ACTOME: Actualiza Orden Mercado
**  Este evento se usa desde el servicio que ingresa las ordenes OTIC/OTIV del mercado (FPA.IME.SERVICE)

ModificarOrden(Dialogo.NrOrden1,0,NO,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,NO,NO,0,NO,NO)    

**  Los recalculos de la orden estan dejando Cantidad1 en cero, por eso hay que hacer un update de ese campo.
**  Los recalculos de la orden estan dejando Cuotas1 en cero, por eso hay que hacer un update de ese campo.
SQL.ADD(" UPDATE "~DBO~".ORDENES ")
SQL.ADD(" SET Cantidad1 = (SELECT SUM(Cantidad) FROM "~DBO~".EJECUCIONES WHERE NrOrden = '"~Dialogo.NrOrden1~"') ")
SQL.ADD(" , Cuotas1 = (SELECT COUNT(Cantidad) FROM "~DBO~".EJECUCIONES WHERE NrOrden = '"~Dialogo.NrOrden1~"') ")
SQL.ADD(" WHERE NrOrden = '"~Dialogo.NrOrden1~"' ")
SQL.NEW
SQL.EXEC

**  Los recalculos de la orden tambien estan dejando Cantidad4 en cero.
SQL.ADD(" UPDATE "~DBO~".ORDENES ")
SQL.ADD(" SET Cantidad4 = (SELECT CASE WHEN T.Cant = 0 THEN 0 ELSE (T.PrecioxCant / T.Cant) END AS PrecioProm ")
SQL.ADD("                  FROM ( SELECT SUM(Cantidad * Precio) AS PrecioxCant, SUM(Cantidad) AS Cant FROM "~DBO~".EJECUCIONES  WHERE NrOrden IN ('"~Dialogo.NrOrden1~"') ) T ) ")
SQL.ADD(" WHERE NrOrden = '"~Dialogo.NrOrden1~"' ")
SQL.NEW
SQL.EXEC
