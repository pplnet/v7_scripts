MostrarCuadroDeMensajes
CrearDialogo
 Fecha1   :'Fecha'   ;;;;;;[Dialogo.Fecha1>0];'Fecha invalida';NO;Habiles(FSys,-1,'ARG')
 Vehiculo1:'Vehiculo';;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo invalido';NO;Var('VEHICULODE')
FinDialogo

if Not OK
 Cancelar
endif

Message('Modifica Valor de Cuotaparte en Operaciones')

SQL.ADD("select TipoOp, NrOperacion, Especie, ContraEspecie2, Cantidad, Precio1, TotalBrutoCli1, Autocotizada ")
SQL.ADD(" from  "~DBO~".OPERACIONES ")
SQL.ADD(" where TipoOp   IN ('FCS','FCR') ")
SQL.ADD("  and  FechaOp   = "~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("  and  Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("order by NrOperacion ")
Recorrer SQL
 *** cotizacion cuotaparte ***
 ACT(a:fac,fbn('TipoOp'))
 ACT(b:fac,fbn('NrOperacion'))
 ACT(c:fac,fbn('Especie'))
 ACT(d:fac,fbn('ContraEspecie2'))
 ACN(e:fac,fbn('Cantidad'))
 ACN(f:fac,fbn('Precio1'))
 ACN(g:fac,fbn('TotalBrutoCli1'))
 ACT(j:fac,fbn('Autocotizada'))

 if SQL("select Precio1 from "~DBO~".COTIZACIONES where Codigo='"~Val(c:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)) <> 0
    ACN(h:fac,CotizacionC(Val(c:fac),,,,Dialogo.Fecha1,1,SI,Val(d:fac)))
    ACN(i:fac,Round(Val(g:fac)/Val(h:fac),4))
    if Val(h:fac) <> Val(f:fac)
       Message(Val(a:fac)~' '~Val(b:fac)~'... Ok')
       SQL.ADD("Update "~DBO~".OPERACIONES ")
       SQL.ADD(" set   Precio1     = "~Fstr(Val(h:fac),0,7)~", ")
       SQL.ADD("       Cantidad    = "~Fstr(Val(i:fac),0,4)~"  ")
       SQL.ADD(" where NrOperacion = '"~Val(b:fac)~"'  ")  
       SQL.NEW
       SQL.EXEC
       SQL.ActualizarMovimientos4(fbn('NrOperacion'),SI,NO,NO,SI,NO,NO)
       SQL.EXEC  
       if EqStr(Val(j:fac),'1')
          *--- Si la operacion se genero por compensacion de saldos, actualizo directamente la cantidad de cuotas en el movejecutado
          SQL.ADD("update "~DBO~".MOVEJECUTADOS ")
          SQL.ADD(" set   Cantidad    = "~iif(EqStr(Val(a:fac),'FCR'),'(-1)*','')~Fstr(Val(i:fac),0,4)~"  ")
          SQL.ADD(" where NrOperacion = '"~Val(b:fac)~"' ")
          SQL.ADD("  and  NrMov       = 1 ")
          SQL.ADD("  and  Especie     = '"~fbn('Especie')~"' ")
          SQL.NEW
          *--- Borro los movpendientes que se pudieron haber generado por ActulizarMov de Arriba.
          SQL.ADD("delete from "~DBO~".MOVPENDIENTES ")
          SQL.ADD(" where NrOperacion = '"~Val(b:fac)~"' ")
          SQL.NEW
          SQL.EXEC
       endif
    else
       Message(Val(a:fac)~' '~Val(b:fac)~'... '~Val(c:fac)~' cotizacion sin cambios')
    endif
 else
    Message(Val(a:fac)~' '~Val(b:fac)~'... '~Val(c:fac)~' cotizacion no localizada')
 endif
Proximo

