*-- CIEFXF: Cierre Posicion FX Forwards
CrearDialogo
  Fecha1 : 'Fecha'  ;;;;  ;;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSYS;'La Fecha es Invalida';NO;Fsys
  Check1 : 'Procesa';;;;NO;;;;;1
FinDialogo
if Not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

SQL.ADD("Select NrOperacion,TipoOp,FechaOp,FechaVto,Especie,ContraEspecie,Cantidad,Precio1 ")
SQL.ADD("  from "~DBO~".OPERACIONES ")
SQL.ADD(" where TipoOp           In ('FXCT','FXVT') ")
SQL.ADD("   and IsNull(CB9,'0')  =  '0' ")
SQL.ADD("   and IsNull(CB10,'0') =  '0' ")  
SQL.ADD("   and FechaVto         <= '"~IdxDate(Dialogo.Fecha1)~"' ")
Recorrer SQL    
  acn(x1,1)

  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACD(d:FAC, fbn('FechaVto'))
  ACT(e:FAC, fbn('Especie'))
  ACT(f:FAC, fbn('ContraEspecie'))
  ACN(g:FAC, fbn('Cantidad'))
  ACN(h:FAC, fbn('Precio1'))
  ACN(i:FAC, CotizacionC(fbn('Especie'),,,,fbn('FechaVto')-1,1,SI,fbn('ContraEspecie')))
  ACN(j:FAC, Val(i:FAC)*CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaVto')-1,1,SI,'USD'))
  ACN(k:FAC, Val(h:FAC)*CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaVto')-1,1,SI,'USD'))

  if Dialogo.Check1=1
    *** Marca la operacion como ejercida ***
    SQL.ADD("Update "~DBO~".OPERACIONES ")
    SQL.ADD("   Set CB10     = '1', ")
    SQL.ADD("       PrecioEj = "~Fstr(Val(i:FAC),0,7)~"  ")
    SQL.ADD("where NrOperacion = '"~fbn('NrOperacion')~"' ")
    SQL.NEW
    SQL.EXEC

    ***************************************
    * Cierre Posicion Futuro
    ***************************************
    if fbn('FechaVto')<=FSYS
      SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
    else
      SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN ")
    endif
    SQL.ADD("(FechaMov,    Cliente,    Vehiculo, ")
    SQL.ADD(" Unidad,      Centro,     Sector, ")
    SQL.ADD(" Sucursal,    NrSaldo,    Especie, ")
    SQL.ADD(" FechaEj,     CallPut,    Cantidad, ")
    SQL.ADD(" Precio,      Estrategia, Cartera, ")
    SQL.ADD(" Book,        Trader,     TipoNegocio, ")
    SQL.ADD(" NrOperacion, Tipo ")
    SQL.ADD(") ")
    SQL.ADD("SELECT '"~IdxDate(fbn('FechaVto'))~"', Cliente,    Vehiculo, ")
    SQL.ADD("       Unidad,                         Centro,     Sector, ")
    SQL.ADD("       Sucursal,                       NrSaldo,    Especie, ")
    SQL.ADD("       FechaEj,                        CallPut,    -Cantidad, ")
    SQL.ADD("       "~Fstr(Val(i:FAC),0,7)~",       Estrategia, Cartera, ")
    SQL.ADD("       Book,                           Trader,     TipoNegocio, ")
    SQL.ADD("       NrOperacion,                    Tipo ")
    SQL.ADD(" FROM "~DBO~".MOVPOSEJE ")
    SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
    SQL.ADD("   And NrSaldo     = 123 ")
    SQL.NEW

    if fbn('FechaVto')<=FSYS
      SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
    else
      SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN ")
    endif
    SQL.ADD("(FechaMov,    Cliente,    Vehiculo, ")
    SQL.ADD(" Unidad,      Centro,     Sector, ")
    SQL.ADD(" Sucursal,    NrSaldo,    Especie, ")
    SQL.ADD(" FechaEj,     CallPut,    Cantidad, ")
    SQL.ADD(" Precio,      Estrategia, Cartera, ")
    SQL.ADD(" Book,        Trader,     TipoNegocio, ")
    SQL.ADD(" NrOperacion, Tipo ")
    SQL.ADD(") ")
    SQL.ADD("SELECT '"~IdxDate(fbn('FechaVto'))~"', Cliente,    Vehiculo, ")
    SQL.ADD("       Unidad,                         Centro,     Sector, ")
    SQL.ADD("       Sucursal,                       NrSaldo,    Especie, ")
    SQL.ADD("       FechaEj,                        CallPut,    -Cantidad, ")
    SQL.ADD("       "~Fstr(Val(j:FAC),0,7)~",       Estrategia, Cartera, ")
    SQL.ADD("       Book,                           Trader,     TipoNegocio, ")
    SQL.ADD("       NrOperacion,                    Tipo ")
    SQL.ADD("  FROM "~DBO~".MOVPOSEJE ")
    SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
    SQL.ADD("   And NrSaldo     = 133 ")
    SQL.NEW

*FechaVto;Vehiculo1;Especie;;        ;;Vehiculo1;;;;;122;-Cantidad;Precio1                                                    ;;;BOOK1;;'FXS';[CB9=0 y CB10=1] y Not EqStr(ESPECIE,'USD');
*FechaVto;Vehiculo1;Especie;;        ;;Vehiculo1;;;;;132;-Cantidad;Precio1*COTIZACIONC(CONTRAESPECIE,,,,FECHAVTO-1,1,SI,'USD');;;BOOK1;;'FXS';[CB9=0 y CB10=1] y Not EqStr(ESPECIE,'USD');

    ***************************************
    * Alta Posicion Spot
    ***************************************
    if Not EqStr(fbn('Especie'),'USD')
      if fbn('FechaVto')<=FSYS
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
      else
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN ")
      endif
      SQL.ADD("(FechaMov,    Cliente,    Vehiculo, ")
      SQL.ADD(" Unidad,      Centro,     Sector, ")
      SQL.ADD(" Sucursal,    NrSaldo,    Especie, ")
      SQL.ADD(" FechaEj,     CallPut,    Cantidad, ")
      SQL.ADD(" Precio,      Estrategia, Cartera, ")
      SQL.ADD(" Book,        Trader,     TipoNegocio, ")
      SQL.ADD(" NrOperacion, Tipo ")
      SQL.ADD(") ")
      SQL.ADD("SELECT '"~IdxDate(fbn('FechaVto'))~"', Cliente,    Vehiculo, ")
      SQL.ADD("       Unidad,                         Centro,     Sector, ")
      SQL.ADD("       Sucursal,                       122,        Especie, ")
      SQL.ADD("       Null,                           CallPut,    -Cantidad, ")
      SQL.ADD("       Precio,                         Estrategia, Cartera, ")
      SQL.ADD("       Book,                           Trader,     TipoNegocio, ")
      SQL.ADD("       NrOperacion,                    Tipo ")
      SQL.ADD(" FROM "~DBO~".MOVPOSEJE ")
      SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.ADD("   And FechaMov    = '"~IdxDate(fbn('FechaOp'))~"' ")
      SQL.ADD("   And NrSaldo     = 123 ")
      SQL.NEW

      if fbn('FechaVto')<=FSYS
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ")
      else
        SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN ")
      endif
      SQL.ADD("(FechaMov,    Cliente,    Vehiculo, ")
      SQL.ADD(" Unidad,      Centro,     Sector, ")
      SQL.ADD(" Sucursal,    NrSaldo,    Especie, ")
      SQL.ADD(" FechaEj,     CallPut,    Cantidad, ")
      SQL.ADD(" Precio,      Estrategia, Cartera, ")
      SQL.ADD(" Book,        Trader,     TipoNegocio, ")
      SQL.ADD(" NrOperacion, Tipo ")
      SQL.ADD(") ")
      SQL.ADD("SELECT '"~IdxDate(fbn('FechaVto'))~"', Cliente,    Vehiculo, ")
      SQL.ADD("       Unidad,                         Centro,     Sector, ")
      SQL.ADD("       Sucursal,                       132,        Especie, ")
      SQL.ADD("       Null,                           CallPut,    -Cantidad, ")
      SQL.ADD("       "~Fstr(Val(k:FAC),0,7)~",       Estrategia, Cartera, ")
      SQL.ADD("       Book,                           Trader,     TipoNegocio, ")
      SQL.ADD("       NrOperacion,                    Tipo ")
      SQL.ADD("  FROM "~DBO~".MOVPOSEJE ")
      SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.ADD("   And FechaMov    = '"~IdxDate(fbn('FechaOp'))~"' ")
      SQL.ADD("   And NrSaldo     = 133 ")
      SQL.NEW
    endif
    SQL.EXEC

*    SQL.ActualizarMovimientos2(fbn('NrOperacion'),NO,NO,NO,SI)
*    SQL.EXEC
  endif
Proximo
