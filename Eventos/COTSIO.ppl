Repetir
  CrearDialogo
    Fecha1    : 'Fecha'  ;1;1;;NO;;;;;FSys;
    Radio1    : 'Tipo|Spot|OCT';1;2;;;NO;;;;1
    Lista1    : 'TiposOp';2;1;;;;;;;;;iif(Dialogo.Radio1=0,'FXCS|FXVS','FXOCTC|FXOCTV')
    String1   : 'NroSec. Dde';3;1;;;;;;;SQLSet("Select isnull(Min(Secuencia),'00000') from "~DBO~".OPSIOPEL where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and CodigoNego"~iif(Dialogo.Radio1=0," <>'"~VAR('TIPONEGOCT')~"'"," ='"~VAR('TIPONEGOCT')~"'"));SQLSet("Select isnull(Min(Secuencia),'00000') from "~DBO~".OPSIOPEL where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and CodigoNego"~iif(Dialogo.Radio1=0," <>'"~VAR('TIPONEGOCT')~"'"," ='"~VAR('TIPONEGOCT')~"'"));;;'#####'
    String2   : 'NroSec. Hta';3;2;;;;;;;SQLSet("Select isnull(Max(Secuencia),'99999') from "~DBO~".OPSIOPEL where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and CodigoNego"~iif(Dialogo.Radio1=0," <>'"~VAR('TIPONEGOCT')~"'"," ='"~VAR('TIPONEGOCT')~"'"));SQLSet("Select isnull(Max(Secuencia),'99999') from "~DBO~".OPSIOPEL where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and CodigoNego"~iif(Dialogo.Radio1=0," <>'"~VAR('TIPONEGOCT')~"'"," ='"~VAR('TIPONEGOCT')~"'"));;;'#####'
    Especie1  : 'Moneda' ;4;1
    Cliente1  : 'Cliente'      ;4;2
    Cantidad1 : 'Cantidad Dde.';5;1
    Cantidad2 : 'Cantidad Hta.';5;2;;;;;;;999999999;;
  FinDialogo
  
  if not ok
    Cancelar
  endif

  if Dialogo.Radio1 = 0
     *** verificacion spot ***  
     EjecutarEvento('VERFX', Fecha1 = Dialogo.Fecha1, Lista1=Dialogo.Lista1, String1=Dialogo.String1, String2=Dialogo.String2, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Cantidad1=Dialogo.Cantidad1, Cantidad2=Dialogo.Cantidad2)
    else
     *** verificacion OCT ***  
     EjecutarEvento('VEROCT', Fecha1 = Dialogo.Fecha1, Lista1=Dialogo.Lista1, String1=Dialogo.String1, String2=Dialogo.String2, Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Cantidad1=Dialogo.Cantidad1, Cantidad2=Dialogo.Cantidad2)
  endif
Proximo

