CrearDialogo
  NrOperacion1: 'Nr.Operacion'  ; 1;1;;;;;;;;;;;;" TipoOp in ('PMU','PME') and NrOperacion Not in (Select M.NrOperacion from "~DBO~".MOVEJECUTADOS M where M.NrOperacion= NrOperacion   and M.FechaMov="~Idxdate2(Dialogo.Fecha1)~" and M.NrSaldo = 1 and M.NrGrupo<>1 ) "
  Fecha1      : 'Fecha'         ; 2;1;;;;NoVacio(Dialogo.NrOperacion1) Y Dialogo.Fecha1<>0;'Fecha incorrecta';NO;;FSys     
FinDialogo

if not OK
  Cancelar
endif

if EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'PMU') 
  *** PMU ***

  ACN(t1, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov="~Idxdate2(Dialogo.Fecha1)~" and NrSaldo = 1 and NrGrupo<>1 "))
  if val(t1)>0
    Cancelar("No puede Anular el Pago. Existen Mov. Liquidados")
  endif

  ******* Si es 2412 con Vehiculo INGCURA, el Prestamo asociado no debe tener Mov.de Pago ********************
  SQL.ADD("Select Vehiculo1,RB1,NrOperacion3 from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  Recorrer SQL
    ACT(z1,FBN['Vehiculo1'])
    ACT(z2,FBN['RB1'])
    ACT(z3,FBN['NrOperacion3'])
  Proximo
  if NoVacio(val(z3)) y Eqstr(val(z1),'INGCURA') y Eqstr(val(z2),'1')
    if SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~val(z3)~"' ")>0
      Cancelar('No puede Anular el Pago. Existen Mov.en '~val(z3)~' de INGBA')
    endif
  endif
  ************************************************************************************************************

  * Mov. de Pago
  ACT(s1,'30,40,41,42,43,50,51,52,53,60,61,62,63,80,81,82,83,85,86,87,88,90,91,92,93')
  * Mov. Saldos anteriores
  ACT(s2,'130,140,150,160,141,142,143,180,181,182,183,190')
  * Mov. WHT/PISE
  ACT(s3,'73,74,75,76,77,78')

  ACN(t1, SQL("Select sum(Cantidad) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov="~Idxdate2(Dialogo.Fecha1)~" and NrSaldo in ("~val(s1)~") "))
  if val(t1)>0
    ACT(p1,Dialogo.NrOperacion1)
    ACD(p2,Dialogo.Fecha1)
    CrearDialogo
      NrOperacion1: 'Nr.Operacion' ; 1;1;;NO;SI;;;;;val(p1)
      Fecha1      : 'Fecha'        ; 2;1;;NO;SI;;;;;val(p2)
      Fecha3      : 'FechaOp'      ; 3;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion1)
      Fecha2      : 'FechaVto'     ; 4;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)
      Vehiculo1   : 'Vehiculo'     ; 5;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
      String1     : 'Cliente'      ; 6;1;;NO;SI;;;;;BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1))
      Especie1    : 'Especie'      ; 7;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1)
      Cantidad9   : 'Total'        ; 8;1;;NO;SI;;;;;val(t1)
    FinDialogo
    if not OK
      Cancelar
    endif
  else
    Cancelar('No existen pagos para la fecha ingresada')  
  endif
  if not Messagebox('Confirma la anulacion del pago '~Dialogo.NrOperacion1~' ?',3,1) = 1
    Cancelar('Evento Cancelado')
  endif
  EjecutarEvento('ANUPAG',NrOperacion1=Dialogo.NrOperacion1, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, String1=Dialogo.String1, Especie1=Dialogo.Especie1, Vehiculo1=Dialogo.Vehiculo1, Cantidad9=Dialogo.Cantidad9, Radio1=1)


else
  *** PME ***

  ACN(t1, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov="~Idxdate2(Dialogo.Fecha1)~" and NrSaldo = 1 and NrGrupo<>1 "))
  if val(t1)>0
    Cancelar("No puede Anular el Pago. Existen Mov. Liquidados")
  endif
  if SQL("Select count(*) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov= "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ") = 0
    Cancelar('No Existe una Cancelacion de '~Dialogo.NrOperacion1~' a fecha '~Dialogo.Fecha1)
  else
    if SQL("Select count(*) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov > "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ") > 0
      ACD(f1, SQL("Select Max(FechaMov) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov > "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo= 1 ")) 
      Cancelar('Existe una Cancelacion de '~Dialogo.NrOperacion1~' a fecha '~val(f1))
    endif
  endif

  ************************************************************************************************
  ******* Si es 2412 con Vehiculo INGCURA, el Prestamo asociado no debe tener Mov.de Pago ********
  SQL.ADD("Select Vehiculo1,RB1,NrOperacion3,Especie from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  Recorrer SQL
    ACT(p1,FBN['Vehiculo1'])
    ACT(p2,FBN['RB1'])
    ACT(p3,FBN['NrOperacion3'])
    ACT(a1,FBN['Especie'])
  Proximo
  if NoVacio(val(p3)) y Eqstr(val(p1),'INGCURA') y Eqstr(val(p2),'1')
    if SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~val(p3)~"' and FechaMov >= "~Idxdate2(Dialogo.Fecha1)~" and NrSaldo = 1 ")>0
      Cancelar('No puede Anular el Pago. Existen Mov.en '~val(p3)~' de INGBA')
    endif
  endif

  * Mov. de Pago
  ACT(s1,'30,40,41,42,43,50,51,52,53,60,61,62,63,80,81,82,83,85,86,87,88,90,91,92,93')
  * Mov. Saldos anteriores

  ACN(t1, SQL("Select sum(Cantidad) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and FechaMov="~Idxdate2(Dialogo.Fecha1)~" and NrSaldo in ("~val(s1)~") "))
  if val(t1)>0
    ACT(q1,Dialogo.NrOperacion1)
    ACD(q2,Dialogo.Fecha1)
    CrearDialogo
      NrOperacion1: 'Nr.Operacion' ; 1;1;;NO;SI;;;;;val(q1)
      Fecha1      : 'Fecha'        ; 2;1;;NO;SI;;;;;val(q2)
      Fecha3      : 'FechaOp'      ; 3;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion1)
      Fecha2      : 'FechaVto'     ; 4;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1)
      Vehiculo1   : 'Vehiculo'     ; 5;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
      String1     : 'Cliente'      ; 6;1;;NO;SI;;;;;BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1))
      Especie1    : 'Especie'      ; 7;1;;NO;SI;;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1)
      Cantidad9   : 'Total'        ; 8;1;;NO;SI;;;;;val(t1)
    FinDialogo
    if not OK
      Cancelar
    endif
  else
    Cancelar('No existen pagos para la fecha ingresada')  
  endif

  EjecutarEvento('ANUPME',NrOperacion1=Dialogo.NrOperacion1, Fecha1=Dialogo.Fecha1,Radio1=1)
endif
