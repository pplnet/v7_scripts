CrearDialogo
  Especie1       :'Especie'      ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Especie Invalida';NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "  
  Fecha1         :'Record_Date'  ;1;2;;;;Dialogo.Fecha1<>0;'Record Date Invalida';NO;FSys
  Cliente1       :'Cliente'      ;2;1;;;;[Vacio(Dialogo.Cliente1)] O [[[Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI')] O [Eqstr(Dialogo.Cliente1, Dialogo.Vehiculo1)]] Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB') Y Not Eqstr(BuscarCampo('CLIENTES','BloqueoFondos','Codigo',Dialogo.Cliente1), 'SI')];'Cliente invalido';NO;;;;;;" Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) AND (CategDepositante='CLI' OR Codigo='"~Dialogo.Vehiculo1~"') ";
  Fecha2         :'Fecha_Pago'   ;2;2;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha de pago invalida ';NO;FSys
  Mercado1       :'Mercado'      ;4;1;
  Especie2       :'Moneda'       ;6;1;;;;NoVacio(Dialogo.Especie2) y DesciendeDeEspecie(Dialogo.Especie2,'MONEDA');'Moneda Invalida';NO;;CotizaEn(Dialogo.Especie1);'ARP|USD|';;;" Codigo IN ( "~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
  Precio1        :'Porcentaje'   ;7;1;;;;Dialogo.Precio1 > 0;'Porcentaje Invalido';
  Vehiculo1      :'Vehiculo'     ;9;1;;;;NOVACIO(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE');
  Operador1      :'Operador'    ;10;1;;NO;;NOVACIO(Dialogo.Operador1);'Operador Invalido';NO;USUARIOACTIVO

  Especie3       :'Moneda Gastos';4;2;;  ;;NoVacio(Dialogo.Especie3);;;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|'
  Cantidad3      :'W.H.T.'       ;6;2;;  ;;Dialogo.Cantidad3>=0;'With Holding debe ser positivo';NO
  Cantidad4      :'GASTOS'       ;7;2;;  ;;Dialogo.Cantidad4>=0;'Los Gastos debe ser positivo';NO
  Cantidad5      :'IVA Gastos'   ;8;2;;  ;;Dialogo.Cantidad5>=0;'El IVA debe ser positivo'    ;NO;;Dialogo.Cantidad4 * Dialogo.Precio2/100
  Cantidad6      :'Tot.Gastos'   ;9;2;;NO;;Dialogo.Cantidad6>=0;'El Tot. de Gastos debe ser positivo';NO;;Dialogo.Cantidad4 + Dialogo.Cantidad5
  Precio2        :'%IVA BOSEC'  ;10;2;;NO;NO;;;;21
  Radio1:'Tipo|Exterior|Local|'  ;3;2;2;NO;NO;;;;;1  
FinDialogo

if Not Ok
  Cancelar
endif

EjecutarEvento('RESGLN', Especie1=Dialogo.Especie1, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Cliente1=Dialogo.Cliente1, Especie2=Dialogo.Especie2, Mercado1=Dialogo.Mercado1 ,Precio1=Dialogo.Precio1, Operador1=Dialogo.Operador1 ,Vehiculo1=Dialogo.Vehiculo1, Radio1=Dialogo.Radio1, Cantidad3=Dialogo.Cantidad3, Cantidad4=Dialogo.Cantidad4, Cantidad5=Dialogo.Cantidad5, Cantidad6=Dialogo.Cantidad6, Especie3=Dialogo.Especie3)