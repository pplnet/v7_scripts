CrearDialogo
 Especie1 :'Especie'          ;1;1;;  ;;NoVacio(Dialogo.Especie1) y Not DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una Especie valida'   ;NO;;;;;;" Jerarquia LIKE '"~Jerarquia('ESPECIES','TITULO')~"%' ";
 Fecha1   :'Record Date'      ;1;2;;  ;;Dialogo.Fecha1<>0;'Debe ingresar un Record Date valido';NO;FSys
 Cliente1 :'Cliente'          ;3;1;;  ;;[Vacio(Dialogo.Cliente1)] O [Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI') Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB')];'Cliente Invalido';NO;;;;;;" CategDepositante='CLI' AND Status = 'HAB' ";
 Mercado1 :'Mercado'          ;4;1;;  ;;
 Vehiculo1:'Vehiculo'         ;3;2;;  ;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el vehiculo';NO;VAR('VEHICULODE')
 Operador1:'Operador'         ;4;2;;NO;;NoVacio(Dialogo.Operador1);'Debe Ingresar el Operador';NO;USUARIOACTIVO
 Lista1   :' Nuevas Especies ';5;1;;  ;;NoVacio(Dialogo.Lista1);'Debe Seleccionar Nuevas Especies';NO;;;SQLSet("select Codigo from "~DBO~".ESPECIES where Jerarquia LIKE '"~Jerarquia('ESPECIES','TITULO')~"%' order by Codigo ")
 Especie2 :'Moneda Fraccion'  ;6;1;;  ;;NoVacio(Dialogo.Especie2);;;'USD';;'ARP|USD|'
 Cantidad1:'Valor Fraccion'   ;7;1;;  ;;Dialogo.Cantidad1>0;'Debe especificar un Valor de Fraccion positivo';NO
 Fecha3   :'F.Limite'         ;6;2;;  ;;Dialogo.Fecha3<>0 y Dialogo.Fecha3>=FSys;'Debe ingresar una Fecha Limite valida';NO;FSys
 String1  :'H.Limite'         ;7;2;;  ;;NoVacio(Dialogo.String1) y HoraValida(Dialogo.String1);'Debe especificar una Hora Limite valida';NO;'18:00'
 String2  : 'Observaciones'   ;8;1;;
FinDialogo

if Not Ok
 Cancelar
endif

* ----------------------------------------------------------------------------------------- *

CrearFont(1, 'Arial,10,BI')
CrearFont(2, 'Arial,10,B')
CrearFont(3, 'Arial,10,')
CrearFont(8, 'Arial,8,')

ACT(z:1,'')

ACO(1, 1)
ACO(2,23)
ACO(3,15)
ACO(4,15)
ACO(5,10)
ACO(6,10)

SQL.ADD("select S.Cliente, S.Mercado, S.Cuenta, S.Saldo ")
SQL.ADD(" from "~DBO~".SALDOSDIA S")
SQL.ADD(" where S.Especie      = '"~Dialogo.Especie1~"' ")
SQL.ADD("  and  S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and  S.NrSaldo      = 1 ")
SQL.ADD("  and  S.Fecha IN (select MAX(Fecha) ")
SQL.ADD("                    from  "~DBO~".SALDOSDIA ")
SQL.ADD("                    where (Mercado = S.Mercado or (Mercado IS NULL and S.Mercado IS NULL)) ")
SQL.ADD("                     and  (Cuenta  = S.Cuenta  or (Cuenta  IS NULL and S.Cuenta  IS NULL)) ")
SQL.ADD("                     and  (Cupon   = S.Cupon   or (Cupon   IS NULL and S.Cupon   IS NULL)) ")
SQL.ADD("                     and  Cliente      = S.Cliente ")
SQL.ADD("                     and  Especie      = S.Especie ")
SQL.ADD("                     and  EnteCustodia = S.EnteCustodia ")
SQL.ADD("                     and  NrSaldo      = S.NrSaldo ")
SQL.ADD("                     and  Fecha       <= "~IdxDate2(Dialogo.Fecha1)~") ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND S.Cliente = '"~Dialogo.Cliente1~"' ")
ELSE
    SQL.ADD(" AND S.Cliente IN (select Codigo from "~DBO~".CLIENTES WHERE OficialCuenta ")
    SQL.ADD("                   IN( Select Codigo from "~DBO~".OFICIALESCUENTA WHERE Usuario = ")
    SQL.ADD("                      '"~Dialogo.Operador1~"'))")
ENDIF
if NoVacio(Dialogo.Mercado1)
 SQL.ADD(" and  S.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD(" order by S.Cliente, S.Mercado, S.Cuenta ")
recorrer SQL
 if fbn('Saldo') > 0

  if Not EqStr(fbn('Cliente'),Val(z:1))

   if Not CeldaVacia(z:1)
    ACT(z:2,BuscarCampo('OFICIALESCUENTA','Usuario','Codigo',BuscarCampo('CLIENTES','OficialCuenta','Codigo',Val(z:1))))

    SetFilaActual(fac+2)
    ACT(a:fac  ,'Ante cualquier consulta que crea conveniente realizar, contactese con '~BuscarCampo('USUARIOS','Nombre','Codigo',Val(z:2)))
    ACT(a:fac+1,'a los telefonos '~BuscarCampo('USUARIOS','Alias1','Codigo',Val(z:2))~'.')
    SetFont(a:fac..a:fac+1,3)

    SetFilaActual(fac+3)
    ACT(a:fac,'Sin otro particular, saludamos a Ud. atentamente.')
    SetFont(a:fac,3)

    SetFilaActual(fac+2)
    SaltarHoja(fac)
    SetFilaActual(fac+1)
   else
    SetFilaActual(1)
   endif

   ACT(z:1,fbn('Cliente'))

   ACT(f:fac  ,'Buenos Aires, '~FStr(Dia(FSys),1,0)~' de '~Meses(FSys)~' de '~FStr(Anio(FSys),1,0))
   AlinearCeldas(f:fac,'R')
   SetFont(f:fac,3)

   SetFilaActual(fac+3)
   ACT(a:fac  , 'Se±or(a)')
   SetFont(a:fac,3)
   ACT(b:fac+1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')))
   SetFont(b:fac+1,1)
   ACT(b:fac+2, BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Cliente'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Cliente'))~' ('~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Cliente'))~')')
   SetFont(b:fac+2,4)

   SetFilaActual(fac+5)
   ACT(a:fac, 'Ref: Canje de ESPECIE')
   SetFont(a:fac,2)

   SetFilaActual(fac+2)
   ACT(a:fac  , 'Titulo a Canjear: ')
   ACT(c:fac  , BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
   ACT(a:fac+1, 'Titulos a Recibir: ')
   SetFont(a:fac..a:fac+1,3)
   SetFont(c:fac..c:fac+1,2)

   ifa
   recorrer&i 1,Elementos(Dialogo.Lista1)
    if &i > 1
     ifa
    endif
    ACT(c:fac,BuscarCampo('ESPECIES','Nombre','Codigo',ItemLista(Dialogo.Lista1,&i)))
    SetFont(c:fac,2)
   proximo
   ifa

   ACT(a:fac  , 'Moneda de la Fraccion: ')
   ACT(c:fac  , Dialogo.Especie2)
   ACT(a:fac+1, 'Cotizacion de la Fraccion: ')
   ACT(c:fac+1, Dialogo.Cantidad1)
   FormatoCeldas(c:fac+3,Exe('F2'))
   ACT(a:fac+2, 'Fecha Limite para recibir instrucciones: ')
   ACT(c:fac+2, FStr(Dia(Dialogo.Fecha3),1,0)~' de '~Meses(Dialogo.Fecha3)~' de '~FStr(Anio(Dialogo.Fecha3),4,0)~' a las '~Dialogo.String1~'.')
   SetFont(a:fac..a:fac+2,3)
   SetFont(c:fac..c:fac+2,2)

   ACT(a:fac+4, Dialogo.String2)
   SetFont(a:fac+4,3)

   SetFilaActual(fac+6)
   ACT(a:fac  , 'Vuestra tenencia a la fecha '~Fecha(Dialogo.Fecha1)~':')
   SetFont(a:fac,3)

   ACT(c:fac+1, 'Mercado')
   ACT(d:fac+1, 'Cuenta')
   ACT(e:fac+1, 'Saldo')
   AlinearCeldas(c:fac+1..e:fac+1,'C')
   SetFont(c:fac+1..e:fac+1,2)
 
   SetFilaActual(fac+2)
  endif

  ACT(c:fac,BuscarCampo('MERCADOS','Descripcion','Codigo',fbn('Mercado')))
  ACT(d:fac,BuscarCampo('CUENTAS','Numero','Codigo',fbn('Cuenta')))
  ACN(e:fac,fbn('Saldo'))
  FormatoCeldas(e:fac,Exe('F2'))
  SetFont(c:fac..e:fac,3)
 endif
proximo

if Not CeldaVacia(z:1)
 ACT(z:2,BuscarCampo('OFICIALESCUENTA','Usuario','Codigo',BuscarCampo('CLIENTES','OficialCuenta','Codigo',Val(z:1))))

 SetFilaActual(fac+2)
 ACT(a:fac  ,'Ante cualquier consulta que crea conveniente realizar, contactese con '~BuscarCampo('USUARIOS','Nombre','Codigo',Val(z:2)))
 ACT(a:fac+1,'a los telefonos '~BuscarCampo('USUARIOS','Alias1','Codigo',Val(z:2))~'.')
 SetFont(a:fac..a:fac+1,3)

 SetFilaActual(fac+3)
 ACT(a:fac,'Sin otro particular, saludamos a Ud. atentamente.')
 SetFont(a:fac,3)
endif

LimitesVision(f:fac)

*EstadoVentana(1)

SetPrintFit(3,92)
Impresion(1,1)
Impresion(2,0)
Impresion(3,0)
SetMargins(1,2,1,1)
