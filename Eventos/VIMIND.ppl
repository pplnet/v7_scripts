**-- VIMD: Minuta Diaria de Cuenta Corriente Vinculadas
*HojaVisible(SI)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;HABILES(FSYS-1,1,'ARG',SI)
  Vehiculo1  : 'Vehiculo1'    ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo Colocador es Invalido';NO;
  Vehiculo2  : 'Vehiculo2'    ;;;;;;NOVACIO(Dialogo.Vehiculo2) y [Incluido(Dialogo.Vehiculo2, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))];'El Vehiculo Tomador es Invalido';NO;;;;
  Especie1   : 'Moneda'       ;;;;;;NOVACIO(Dialogo.Especie1) y DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe Ingresar una Especie Valida';NO;
  Precio1    : 'Tasa'         ;;;;NO;;Dialogo.Precio1<>0;'Debe Existir la Tasa para esta Seleccion';NO;;SQL("SELECT Tasa from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~Dialogo.Vehiculo1~"' and Vehiculo2='"~Dialogo.Vehiculo2~"') or (Vehiculo1='"~Dialogo.Vehiculo2~"' and Vehiculo2='"~Dialogo.Vehiculo1~"')) and Especie ='"~Dialogo.Especie1~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' ")
FinDialogo

if not Ok
  Cancelar
endif

* Divisor del par de Vehiculos
SQL.ADD("SELECT Divisor from "~DBO~".PARESVEHICULO where Vehiculo1='"~Dialogo.Vehiculo1~"' and Vehiculo2='"~Dialogo.Vehiculo2~"' ")

ACN(Z11,0)

Recorrer SQL
  ACN(Z11,IIF(EqStr('360',FBN['Divisor']),360,365))
Proximo

IF VAL(Z11)=0
   Cancelar('Falta Ingresar los Impuestos para el Par de Vehiculos '~Dialogo.Vehiculo1~'/'~Dialogo.Vehiculo2)
ENDIF

ACT(AV1,Dialogo.Vehiculo1)
ACT(AV2,Dialogo.Vehiculo2)
ACT(AE1,Dialogo.Especie1)
ACD(AF1,Dialogo.Fecha1)

* Verifico que todas las operaciones esten en BackOffice O Terminal
(.'VERIINSVIN'.)
 
* Recupero el Saldo para el Par de Vehiculos => Deja el resultado en Z1 
(.'SALDIAVINC'.)

IF VAL(Z1)<>0 
   Message('Obteniendo los Nros. de Operaciones a Generar .... ')          
 
   *-- Z3 Nro. Minuta Diaria z4: Fecha de Vto. z5: Plazo en Dias Corridos
   *-- z6: Interes  Z7: MB3 Z8: Nro. Operacion Referencia Z9: MB3 de la Vinculada

   *-- Z7: MB3
   ACT(Z7,IIF(VAL(Z1)>0,'1','0') )
   ACT(Z9,IIF(VAL(Z1)>0,'0','1') )

   IF VAL(Z1)<0
      ACN(Z1,-VAL(Z1))
   ELSE
      ACT(AV1,Dialogo.Vehiculo2)
      ACT(AV2,Dialogo.Vehiculo1)
   ENDIF

   ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo1)))

   ACD(Z4,HABILES(Dialogo.Fecha1,1,'ARG',SI))
   ACN(Z5,VAL(Z4)-Dialogo.Fecha1)

   ACN(Z6,Dialogo.Precio1*VAL(Z1)*VAL(z5)/(100*VAL(Z11)) )
   ACT(z8,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Dialogo.Vehiculo2)))

   * Obtengo el Nro de Caso para la Minuta Vinculada AB6: Caso
   (.'CASOVINCU'.)    

   Message('Calculando los Impuestos para Operacion Directa ')

   ACT(AV1,Dialogo.Vehiculo1)
   ACT(AV2,Dialogo.Vehiculo2)

   * Determina los Impuestos de Vinculadas
   * Y5 : Imp.Ret.IVA  Y6 : Alicuota de IVA  Y12: Alicuota Percepcion  Y13: Importe  de Percepcion
   * Y16: IvaNeto  Y17: MontoCapitalizable Y19:TTN
   * I1: Tasa Impuesto Extr I2: Importe de Impuesto Ext
   * W1: Tasa WH  W2: Importe de WH Directa  

   (.'IMPVIN'.)

   Message('Generando Minuta de Diaria .... ')          
   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, NrOperacion,FechaOp,Vehiculo1,Vehiculo2,Especie, ")
   SQL.ADD(" MB3,Cantidad,TotalIntereses,Plazo,")
   SQL.ADD(" FechaVto,Precio1,RB8,")
   SQL.ADD(" Cliente1,")
   SQL.ADD(" FechaCarga,UsrInput,Operador,Precio4,Precio2,TotalAux1,CB6,")
   SQL.ADD(" RB6,TasaPrecan,NrOperacion3,RB3 ) ") 
   SQL.ADD("Values")
   SQL.ADD("('VIMIND','"~Val(z3)~"','"~IdxDate(Dialogo.Fecha1)~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Vehiculo2~"','"~Dialogo.Especie1~"',")
   SQL.ADD(" '"~Val(z7)~"', "~Fstr(VAL(Z1),0,2)~","~Fstr(VAL(Z6),10,5)~","~Fstr(VAL(Z5),0,0)~",")
   SQL.ADD(" '"~IdxDate(VAL(Z4))~"',"~Fstr(Dialogo.Precio1,0,5)~",'"~IIF(VAL(Z11)=360,"0","1")~"',")
   SQL.ADD(" '"~Dialogo.Vehiculo2~"',")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"','"~USUARIOACTIVO~"','"~USUARIOACTIVO~"',"~Fstr(VAL(Y19),0,5)~","~Fstr(VAL(Y15),0,5)~","~Fstr(VAL(W1),0,5)~",'1', ")
   SQL.ADD(" '"~Fstr(Val(AB6),0,0)~"', "~Fstr(Val(I1),0,2)~",'"~Val(z8)~"','1' ) ")
   SQL.NEW 
   SQL.EXEC

   *** Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(Val(z3),SI)
   SQL.EXEC

   * Insert de Instancias: Recibe z3: Nro.Op.
   (.'ALTAINSSU'.)

   Message('Calculando los Impuestos para la Inversa ')

   ACT(AV1,Dialogo.Vehiculo2)
   ACT(AV2,Dialogo.Vehiculo1)
   ACT(Z7,VAL(Z9))

   (.'IMPVIN'.)

   Message('Generando Minuta de Diaria .... ')          
   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, NrOperacion,FechaOp,Vehiculo1,Vehiculo2,Especie, ")
   SQL.ADD(" MB3,Cantidad,TotalIntereses,Plazo,")
   SQL.ADD(" FechaVto,Precio1,RB8,")
   SQL.ADD(" Cliente1,MB4,")
   SQL.ADD(" FechaCarga,UsrInput,Operador,Precio4,Precio2,TotalAux1,CB6,")
   SQL.ADD(" RB6,TasaPrecan,NrOperacion3,RB3 ) ") 
   SQL.ADD("Values")
   SQL.ADD("('VIMIND','"~Val(z8)~"','"~IdxDate(Dialogo.Fecha1)~"','"~Dialogo.Vehiculo2~"','"~Dialogo.Vehiculo1~"','"~Dialogo.Especie1~"',")
   SQL.ADD(" '"~Val(z9)~"', "~Fstr(VAL(Z1),0,2)~","~Fstr(VAL(Z6),10,5)~","~Fstr(VAL(Z5),0,0)~",")
   SQL.ADD(" '"~IdxDate(VAL(Z4))~"',"~Fstr(Dialogo.Precio1,0,5)~",'"~IIF(VAL(Z11)=360,"0","1")~"',")
   SQL.ADD(" '"~Dialogo.Vehiculo1~"','"~Val(z7)~"',")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"','"~USUARIOACTIVO~"','"~USUARIOACTIVO~"',"~Fstr(VAL(Y19),0,5)~","~Fstr(VAL(Y15),0,5)~","~Fstr(VAL(W1),0,5)~",'0', ")
   SQL.ADD(" '"~Fstr(Val(AB6),0,0)~"', "~Fstr(Val(I1),0,2)~",'"~Val(z3)~"','1' ) ")
   SQL.NEW 
   SQL.EXEC

   * Insert de Instancias: Recibe z3: Nro.Op.
   ACT(Z3,VAL(Z8))

   (.'ALTAINSSU'.)

   *** Actualiza movimientos y limites ****
   SQL.ActualizarMovimientos(Val(z8),SI)
   SQL.EXEC
ELSE
   * No se generaron intereses
   Message('El par de Vehiculos '~Dialogo.Vehiculo1~' - '~Dialogo.Vehiculo2~' no posee saldos para esta fecha y moneda ...')
ENDIF