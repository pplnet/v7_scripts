CrearDialogo
   Label1    : ''                ;1;1;;;;;;;;'Ingrese Periodo a Actualizar';;;
   Entero1   : 'Año'             ;;1;;;;Dialogo.Entero1>=2004 y Dialogo.Entero1<=2050;'Debe Ingresar un anio valido';NO;Anio(Fsys);;;;'####'
   Entero2   : 'Mes'             ;;1;;;;Dialogo.Entero2>=1 y Dialogo.Entero2<=12;'Debe Ingresar un mes valido';NO;Mes(Fsys);;;;'##'
   String1   : 'Periodo'         ;;1;;NO;NO;;;;'01/'~PAD0(Dialogo.Entero2,2)~'/'~PAD0(Dialogo.Entero1,4);'01/'~PAD0(Dialogo.Entero2,2)~'/'~PAD0(Dialogo.Entero1,4)
   Fecha1    : 'Fecha desde'     ;;1;;NO;;;;;Fecha(Dialogo.String1);Fecha(Dialogo.String1)
   Fecha2    : 'Fecha hasta'     ;;1;;NO;;;;;FinDeMes(Dialogo.Fecha1,SI);FinDeMes(Dialogo.Fecha1,SI)

FinDialogo 

** verificar si poner periodo AAAAMM o incluirlo como periodo presentacion para tabla UIFRTI

If Not Ok
   Cancelar
endif   


SQL.ADD("Select Cliente,NrOperacion,Transferencia,fechaLiq,CantidadVN,NroCuentaDepos,NroCuentaComit From "~DBO~".UIFRTI  ")
SQL.ADD("Where Periodo= '"~PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2)~"' ")
watch(sql.batch)
Recorrer SQL

  ACT(a:FAC, FBN['Cliente'])
  ACT(b:FAC, FBN['NrOperacion'])
  ACT(c:FAC, FBN['Transferencia'])
  ACD(d:FAC, FBN['FechaLiq'])
  ACN(e:FAC, FBN['CantidadVN'])
  ACT(f:FAC, FBN['NroCuentaDepos'])
  ACT(g:FAC, FBN['NroCuentaComit'])
  ACN(x:FAC, 0)
  
Proximo

   CrearListBox ; 'Arial,8,';'Actualizacion RTI de '~PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2)
       'OK'               ;x:1..x:Fac;SI;;;40 ;CHECK;;
       'Cliente '         ;a:1..a:Fac;NO;;;70 ;STRING;;
       'Operacion '       ;b:1..b:Fac;NO;;;70 ;STRING;;
       'Transferencia'    ;c:1..c:Fac;NO;;;100;STRING;;
       'Fecha Liq  '      ;d:1..d:Fac;NO;;;100;FECHA;;
       'CantidadVN '      ;e:1..e:Fac;NO;;;100;NUMERO;'###,###,###,###.##';
       'NroCuenta Depo'   ;f:1..f:Fac;SI;;;100;STRING;;RGB(232,232,255);
       'NroCuenta Comit ' ;g:1..g:Fac;SI;;;100;STRING;;RGB(232,232,255);
   FinListBox

   IF NOT OK 
          Cancelar
   Endif 

   Recorrer&j 1,Fac
     if Val(x:&j) = 1
        SQL.ADD("UPDATE "~DBO~".UIFRTI ")
        SQL.ADD("SET NroCuentaDepos = '"~Val(f:&j)~"', NroCuentaComit = '"~Val(g:&j)~"' ")
        SQL.ADD("Where Periodo = '"~PAD0(Dialogo.Entero1,4)~PAD0(Dialogo.Entero2,2)~"' and Cliente = '"~Val(a:&j)~"' and NrOperacion = '"~Val(b:&j)~"' ")
        SQL.NEW
        SQL.EXEC
     Endif
  Proximo 

