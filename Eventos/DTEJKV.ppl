CrearDialogo
  Fecha1       : "F Real Ej."               ;1;1;;;;Dialogo.Fecha1=Dialogo.Fecha2;'FECHA EJERCICIO REAL TIENE QUE ESTAR EN EL PLAZO DEL PERIODO A EJERCER';NO;Fsys
  NrOperacion1 : "Operacion"                ;;;;;;EqStr(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTKVI');'DEBE INGRESAR UNA OPERACION DE TIPO DTC';NO;;;SQLSET("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'DTKVI' ")
  Entero1      : "Nro. Settlement"          ;;;;;;Dialogo.Entero1>0;'DEBE INDICAR EL NUMERO DE SETTLEMENT';NO;0;
  Precio2      : "Tasa Variable"            ;;;;;;Dialogo.Precio2<=VAR('RTASA2') Y Dialogo.Precio2>=VAR('RTASA1');'Tasa del Vehiculo Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');SI;0
  Fecha2       : "F Reset"                  ;;;;NO;;;;;;SQL("Select Fecha4 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Fecha3       : "F Settlement"             ;;;;;;Dialogo.Fecha3>=Dialogo.Fecha4;'LA FECHA DE SETTLEMENT DEBE SER MAYOR O IGUAL A LA FECHA DE FIN DEL SETTLEMENT';NO;;SQL("Select Fecha3 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Fecha4       : "Fecha Fin Settlement"     ;;;;NO;;;;;;SQL("Select Fecha2 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Radio1       : "Clase|Down&&Out|Down&&In|Up&&Out|Up&&In"    ;;;;NO;;;;;;BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Strike"                   ;;;;NO;;;;;;SQL("Select Tasa1 from "~DBO~".CUOTAS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(Dialogo.Entero1,2,0)~" ")
  Vehiculo1    : "Vehiculo"                 ;2;2;;NO;;;;NO;;BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Condicion|Fijo|Variable" ;3;2;;NO;;;;NO;;BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1)
  Vehiculo2    : "Veh. Cpte."               ;5;2;;NO;;;;NO;;BuscarCampo('Operaciones','Vehiculo2','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DTKVI|')
   Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No es un Knock Out / In Swap para Vinculadas')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok 
  if eqstr (BuscarCampo('Operaciones','CB6','NrOperacion',Dialogo.NrOperacion1),'1')

   * X1: Recupero la Operacion
   acn(x1,0)

   *** caso down - up - in - out
   ACT (L1, BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1))

   SQL.ADD("Select * from "~DBO~".CUOTAS ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
   SQL.ADD("and Check1='0' ")

   Recorrer SQL

   acn(x1,1)
      * Se ejerce cuando: 
      *    L1=0 Down&Out y L2>=X2
      *    L1=2 Up&Out   y L2<=X2 
      *    L1=1 Down&In  y L2<X2  
      *    L1=3 Up&In    y L2>X2

      IF [EQSTR(VAL(L1),'0') Y Dialogo.Precio2>=FBN['Tasa1']] O [EQSTR(VAL(L1),'2') Y Dialogo.Precio2<=FBN['Tasa1']] O [EQSTR(VAL(L1),'1') Y Dialogo.Precio2<FBN['Tasa1']] O [EQSTR(VAL(L1),'3') Y Dialogo.Precio2>FBN['Tasa1']]

          *-- settlement sea habil en la tabla de feriados de la operacion
          IF [NOT ESHABIL(Dialogo.Fecha3,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1))]
             MESSAGEBOX('FECHA DE SETTLEMENT NO HABIL EN TABLA DE FERIADOS '~BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1) )
             acn(x1,0)
             Break
          ENDIF

          *** CALCULA EL INT PAY Y RES SEGUN SEA FIX O FLOAT EL VEHICULO
          *** Z11 / Z18 DAY COUNT +1 YA QUE LA FUNCION LO REQUIERE ASI
          *** Z9 ES FIJO - NO FIJO
          *** Z24 ES EL INTEREST PAYMENT
          *** Z20 ES EL RESULTADO


          ACN (Z11, BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1)
          ACN (Z12, BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1))
          ACN (Z18, BuscarCampo('Operaciones','RB5','NrOperacion',Dialogo.NrOperacion1)+1)
          ACN (Z24, 0)
          ACN (z20, 0)    

          Message ('Calculando interes .... ')                  
          *** interes
          IF VAL(Z12)=1
             ACN (Z24, ((FBN['Cantidad1']*(Dialogo.Precio2+FBN['Total3']))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(Z11)))
          ELSE
             ACN (Z24, ((FBN['Cantidad2']*(Dialogo.Precio2+FBN['Total4']))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],VAL(Z18)))
          ENDIF

          Message ('Calculando resultado .... ')                       
          IF EqStr(BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1), BuscarCampo('Operaciones','ContraEspecie','NrOperacion',Dialogo.NrOperacion1))
             IF VAL(Z12) = 1
                ACN (Z20, FBN['Cantidad4']-VAL(Z24))
             ELSE
                ACN (Z20, VAL(Z24)-FBN['Cantidad3'])
             ENDIF
          ENDIF

          Message ('Calculando Importe iva ...')
          acn (z30, VAL(z20) * (BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1)/100))

          Message('Actualizando Knock Out - In Swap .... ')                  
          *** Marca la operacion como ejercida ***
          SQL.ADD("Update "~DBO~".CUOTAS ")
          SQL.ADD("Set")
 
          IF EQSTR(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1), '0')
             SQL.ADD("Precio2 = "~Fstr(Dialogo.Precio2,0,7)~",  ")
             SQL.ADD("Cantidad4 = "~Fstr(val(z24),0,7)~",  ")
             SQL.ADD("Precio6 = "~Fstr(val(z24),0,7)~",  ")
          ELSE
             SQL.ADD("Precio1 = "~Fstr(Dialogo.Precio2,0,7)~",  ")
             SQL.ADD("Cantidad3 = "~Fstr(val(z24),0,7)~",  ")
             SQL.ADD("Precio5 = "~Fstr(val(z24),0,7)~",  ")
          ENDIF
 
          SQL.ADD("Check1 = '1', ")
          SQL.ADD("Fecha5 = '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD("Total2 = "~Fstr(VAL(z20),0,2)~", ")
          SQL.ADD("Precio3 = "~Fstr(VAL(z30),0,7)~" ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
          SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
          SQL.NEW
          SQL.EXEC

          *-- Insert de Mov.Pendientes. El Resultado invierte el signo porque se ve desde el cliente
          *-- Mov. por el Interes
          * EjecutarEvento('IMOVPE',NrOperacion1=Dialogo.NrOperacion1,Fecha1=Dialogo.Fecha3,Cliente1=VAL(Z25),Especie1=VAL(Z26),Vehiculo1=BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),Entero1=1,Precio1=val(z27),String='Interes Settlement',Entero2=9,Entero3=Dialogo.Entero1,String1='CUOTAS')

          *-- Mov. por el Resultado
          IF VAL(Z20)<>0
          *    EjecutarEvento('IMOVPE',NrOperacion1=Dialogo.NrOperacion1,Fecha1=Dialogo.Fecha3,Cliente1=VAL(Z25),Especie1=VAL(Z26),Vehiculo1=BuscarCampo('Operaciones','Vehiculo1','NrOperacion',Dialogo.NrOperacion1),Entero1=1,Precio1=-val(z20),String='Resultado Settlement',Entero2=9,Entero3=Dialogo.Entero1,String1='CUOTAS')
          ENDIF

          *** Actualiza movimientos y limites ****
          SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
          SQL.EXEC
       else 
          * Marca la Opcion como ejercida pero sin resultado
          SQL.ADD("Update "~DBO~".CUOTAS ")
          SQL.ADD("Set")
 
          IF EQSTR(BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1), '0')
             SQL.ADD("Precio2 = "~Fstr(Dialogo.Precio2,0,7)~",  ")
          ELSE
             SQL.ADD("Precio1 = "~Fstr(Dialogo.Precio2,0,7)~",  ")
          ENDIF

          SQL.ADD("Check1 = '1', ")
          SQL.ADD("Fecha5 = '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
          SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
          SQL.NEW
          SQL.EXEC     
      endif

      * Actualizo la Instancia de la Operacion a Supervision especial mof
      (.'MODIINSTAN'.)      
   proximo
   
   If val(x1)=0
      Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   else
      *** actualiza la operacion del vehiculo contraparte  
      *** z40 es el resultado * -1
      *** z50 es el numero de operacion
      ACT (z50, BuscarCampo('Operaciones','OperacionRef','NrOperacion',Dialogo.NrOperacion1))

      SQL.ADD("Select * from "~DBO~".CUOTAS ")
      SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")

      Recorrer SQL
          SQL.ADD("Update "~DBO~".CUOTAS ")
          SQL.ADD("Set")
          SQL.ADD("Fecha1 = '"~IdxDate(FBN['Fecha1'])~"', ")
          SQL.ADD("Plazo1 = "~Fstr(FBN['Plazo1'],2,0)~", ")
          SQL.ADD("Fecha2 = '"~IdxDate(FBN['Fecha2'])~"', ")
          SQL.ADD("Cantidad1 = "~Fstr(FBN['Cantidad2'],0,7)~",  ")
          SQL.ADD("Cantidad2 = "~Fstr(FBN['Cantidad1'],0,7)~",  ")
          SQL.ADD("Precio1 = "~Fstr(FBN['Precio2'],0,7)~",  ")
          SQL.ADD("Precio2 = "~Fstr(FBN['Precio1'],0,7)~",  ")
          SQL.ADD("Total3 = "~Fstr(FBN['Total4'],0,7)~",  ")
          SQL.ADD("Total4 = "~Fstr(FBN['Total3'],0,7)~",  ")
          SQL.ADD("Cantidad3 = "~Fstr(FBN['Cantidad4'],0,7)~",  ")
          SQL.ADD("Precio5 = "~Fstr(FBN['Precio6'],0,7)~",  ")
          SQL.ADD("Cantidad4 = "~Fstr(FBN['Cantidad3'],0,7)~",  ")
          SQL.ADD("Precio6 = "~Fstr(FBN['Precio5'],0,7)~",  ")
          SQL.ADD("Tasa1 = "~Fstr(FBN['Tasa1'],0,7)~",  ")
          SQL.ADD("Check1 = '"~FBN['Check1']~"', ")
          SQL.ADD("Fecha3 = '"~IdxDate(FBN['Fecha3'])~"', ")
          SQL.ADD("Fecha4 = '"~IdxDate(FBN['Fecha4'])~"', ")
          SQL.ADD("Fecha5 = '"~IdxDate(FBN['Fecha5'])~"', ")
          acn(q1, (FBN['Total2'] * -1))
          SQL.ADD("Total2 = "~Fstr(val(q1),0,7)~", ")
          acn(q2, (VAL(Z30) * -1))
          SQL.ADD("Precio3 = "~Fstr(val(q2),0,7)~" ")

          SQL.ADD("where NrOperacion = '"~val(z50)~"' ")
          SQL.ADD("and NrCuota = "~Fstr(Dialogo.Entero1,2,0)~" ")
          SQL.NEW
          SQL.EXEC


     *** Actualiza movimientos y limites ****
     SQL.ActualizarMovimientos(val(z50),SI)
     SQL.EXEC

 
         act(i3, val(z50))
         * Actualizo la Instancia de la Operacion espejo a Supervision especial mof
         (.'MODIINSTAN'.)



      Proximo



   endif
 else
   messagebox ('DEBE EJERCER LA OPERACION ORIGINAL')
 endif
endif



