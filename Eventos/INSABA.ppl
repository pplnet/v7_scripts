CrearDialogo
Vehiculo1  : 'Vehiculo'  ;;;;;; NoVacio(VEHICULO1);'Vehiculo invalido';NO;
Cliente1   : 'Entidad'   ;;;;;; ;;;
Cuenta1    : 'Cuenta'    ;;;;;; ;;;
Fecha1     : 'FechaSaldo';;;;;; ;;;
Especie1   : 'Moneda'    ;;;;;; ;;;
Cantidad1  : 'Saldo'     ;;;;;; ;;;
NrTrans1   : 'Número de Transacción'     ;;;;;; ;;;

FinDialogo

If not ok
    Cancelar
Endif

***------------------- VARIABLES ---------------------------*
SQL.ADD(" Select Numero, Nombre, TipoCuenta, CBU ")
SQL.ADD(" From "~dbo~".CUENTAS ")
SQL.ADD(" Where Codigo = '"~Dialogo.Cuenta1~"'")
Recorrer SQL
    let &NrCuenta fbn('Numero')
    let &NombreCuenta fbn('Nombre')
    let &TipoCuenta fbn('TipoCuenta')
    let &CBU fbn('CBU')
Proximo
    let &Banco BuscarCampo('CLIENTES','Alias3','Codigo', CLIENTE1)
    let &CUIT BuscarCampo('CLIENTES','CUIT','Codigo', CLIENTE1)

*SignoContable, SignoInicial, SignoOperativo, = C si es positivo, sino D
IF Cantidad1>=0
let &SignoContable   'C'
let &SignoInicial    'C'
let &SignoOperativo  'C'
ELSE  
let &SignoContable   'D'
let &SignoInicial    'D'
let &SignoOperativo  'D'
ENDIF

***------------------- PROCESAMIENTO DE DATOS A LA BASE ---------------------------*

  SQL.ADD(" INSERT INTO "~dbo~".SALDOSBANCARIOS ")
  SQL.ADD(" (FechaSaldo, FechaBajada, FechaCarga, ")
  SQL.ADD(" NrCuenta, Nombre, TipoCuenta, ")
  SQL.ADD(" SaldoContable, SaldoInicio, SaldoOperativo, ")
  SQL.ADD(" Estado, Banco, CBU, CUIT, ")
  SQL.ADD(" SignoContable, SignoInicial, SignoOperativo, ")
  SQL.ADD(" Usuario, NrTransAjuste ) ")
  *FechaSaldo, FechaBajada = Fsys, FechaCarga = SQLAhora
  SQL.ADD(" VALUES('"~IdxDate(Dialogo.Fecha1)~"' , '"~IdxDate(FSYS)~"' , "~SQLAhora~" , ")
  *NrCuenta, Nombre, TipoCuenta se obtiene de la cuenta,
  SQL.ADD(" '"~&NrCuenta~"','"~&NombreCuenta~"','"~&TipoCuenta~"',")
  *SaldoContable = saldo Transaccion, idem SaldoInicio y SaldoOperativo
  SQL.ADD(" "~Fstr(Dialogo.Cantidad1,0, 2)~", "~Fstr(Dialogo.Cantidad1,0, 2)~", "~Fstr(Dialogo.Cantidad1,0, 2)~", ")
  *Estado = REC, Banco, CBU y CUIT se obtienen de la cuenta
  SQL.ADD(" 'REC','"~&Banco~"', '"~&CBU~"', '"~&CUIT~"', ")
  *SignoContable, SignoInicial, SignoOperativo, 
  SQL.ADD(" '"~&SignoContable~"','"~&SignoInicial~"','"~&SignoOperativo~"', ")
  *Usuario = UsuarioActivo, NrTransacción
  SQL.ADD(" '"~UsuarioActivo~"', '"~Dialogo.NrTrans1~"') ")
  SQL.NEW
  SQL.EXEC
