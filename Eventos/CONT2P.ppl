MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ; 1;;;;;;;;fsys
  Lista1:       'Vehiculos'   ; 3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-3;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Dif. cambio Titulos y Acciones ---')

ACT(ML:1, Var('MONELOCA'))

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
ACN(x3, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
  ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
  ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
if Dialogo.Fecha1<>Val(x2)
  Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
endif

ACD(v:1, Dialogo.Fecha1)
ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:3, Habiles(PriDeMes(Val(v:2)),-1,'ARG'))
***---Saldos que se contabilizan
ACT(SL:1, '101,102')

SetFilaActual(1)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Cupon')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'TipoNegocio')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'CantidadFin')
ACT(j:FAC, 'PrecioFin')
ACT(k:FAC, 'Cotiza')
ACT(l:FAC, 'Cot.Mes Ant')
ACT(m:FAC, 'Cot.Actual')
ACT(n:FAC, 'Dif.Cotiz.')
ACT(o:FAC, 'Res.Saldo Ant.')
ACT(p:FAC, 'Res.Operac.')
ACT(q:FAC, 'Res.TOTAL')
ACT(r:FAC, 'Tipos Asi')
ACT(S:fac, 'ContraEsp')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Nombre')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'NrSaldo')
ACT(ae:FAC, 'TipoNegocio')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'FechaMov')
ACT(ai:FAC, 'Cantidad')
ACT(aj:FAC, 'Precio')
ACT(ak:FAC, 'Cotiza')
ACT(al:FAC, 'Cotizacion BNA Mes actual')
ACT(am:FAC, 'Dif.Cotiz.')
ACT(an:FAC, 'Resultado')
ACT(ao:FAC, 'Linea')
ACT(ap:FAC, 'NrOperacion')
ACT(aq:FAC, 'TipoOp')
ACT(ar:FAC, 'FechaOp')
ACT(AS:fac, 'ContraEsp')


SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       Sum(P.CantidadFin) as Cantidad, ")
SQL.ADD("       Sum(P.CantidadFin*P.PrecioFin) as Monto, '' Observaciones, E.Alias8, '' Cliente1, P.Vehiculo Vehiculo1 ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD(" AND P.NrSaldo IN ("~Val(SL:1)~") ")
SQL.ADD(" and P.TipoNegocio = 'SEC' ")
SQL.ADD(" AND E.Cotiza <> '"~Val(ML:1)~"' ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
SQL.ADD("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(v:3))~" ) ")
SQL.ADD(" AND   P.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC, E.Alias8 ")
Recorrer SQL
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
    ACN(d:FAC, FBN('NrSaldo'))
    ACT(e:FAC, FBN('TipoNegocio'))
    ACT(f:FAC, FBN('Vehiculo'))
    ACN(i:FAC, FBN('Cantidad'))
    ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
    ACT(k:FAC, FBN('Cotiza'))
    ***---Cotizacion Especie al mes anterior
    ACN(CT:fac, Cotizacion(fbn('Especie'),,,,Val(V:3),1,SI))
    ACN(L:fac, CotizacionBNA(fbn('Cotiza'), Val(V:3),1,NO,NO))
    ACN(M:fac, CotizacionBNA(fbn('Cotiza'), Val(V:2),1,NO,NO))
    ACN(O:fac, fbn('Cantidad') * Val(CT:fac) * (Val(M:fac) - Val(L:fac)))
proximo

ACN(w:1, 1)
SQL.ADD("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp, E.Tipo, V.Valor1, V.Valor2, E.Cotiza Moneda, O.ContraEspecie, ")
SQL.ADD("       O.PlazoRenovPredeter CotOp, O.Observaciones, E.Alias8, O.Cliente1, M.Vehiculo Vehiculo1 ")
SQL.ADD("  from "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
SQL.ADD(" where M.NrSaldo IN ("~Val(SL:1)~") ")
SQL.ADD(" AND V.Codigo = M.Vehiculo ")
SQL.ADD("   and M.TipoNegocio = 'SEC' ")
SQL.ADD(" AND E.Cotiza <> '"~Val(ML:1)~"' ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
SQL.ADD("   AND M.Vehiculo  Not  IN ("~Pipe2Comillas(Var('VLIQUIDAA'))~") ")
SQL.ADD(" order by M.Especie, M.Cupon ")
Recorrer SQL
    DFA
    SCN(w:1,1)
    ACN(w:2,0)
    if FAC>1
      recorrer&i 2,FAC
        if EqStr(FBN('Especie'),Val(a:&i))
          ACN(w:2, &i)
          Break
        endif
      proximo
    endif
    if Val(w:2)=0
      IFA
      ACT(a:FAC, FBN('Especie'))
      ACT(b:FAC, FBN('Nombre'))
      ACN(d:FAC, FBN('NrSaldo'))
      ACT(e:FAC, FBN('TipoNegocio'))
      ACT(f:FAC, FBN('Vehiculo'))
      ACT(g:FAC, FBN('Book'))
      ACN(w:2, FAC)
    endif
    ACT(aa:Val(w:1), FBN('Especie'))
    ACT(ab:Val(w:1), FBN('Nombre'))
    ACT(ac:Val(w:1), FBN('Cupon'))
    ACN(ad:Val(w:1), FBN('NrSaldo'))
    ACT(ae:Val(w:1), FBN('TipoNegocio'))
    ACT(af:Val(w:1), FBN('Vehiculo'))
    ACT(ag:Val(w:1), FBN('Book'))
    ACD(ah:Val(w:1), FBN('FechaMov'))
    ACN(ai:Val(w:1), FBN('Cantidad'))
    IF Eqstr(fbn('Cotiza'), fbn('ContraEspecie'))
        ACN(aj:Val(w:1), FBN('Precio'))
    ELSE
        ***---Tomo la cotizacion contable de la operacion para obtener el precio de la operacion en moneda que cotiza
        ACT(MD:2, SQL(" Select Modo From "~DBO~".MODOESPECIES Where Especie2 = '"~fbn('Cotiza')~"' AND Especie1 = '"~fbn('ContraEspecie')~"' "))
        ACN(AJ:Val(W:1), IIF(Eqstr(Val(MD:2), 'INV'), fbn('Precio') / fbn('CotOp'), fbn('Precio') * fbn('CotOp')))
    ENDIF
    ACT(ak:Val(w:1), FBN('Cotiza'))
    ACN(AL:Val(W:1), CotizacionBNA(fbn('Cotiza'), Val(V:2),1,NO,NO))
    ***---Cotizacion BNA a FechaOp
    ACN(CT:Val(W:1), CotizacionBNA(fbn('Cotiza'), fbn('FechaOp'),1,NO,NO))
    ***---Resultado = Cantidad * PrecioOp en Moneda que Cotiza * (Precio Hoy en ARP - Precio a FechaOp en ARP)
    ACN(AN:Val(w:1), fbn('Cantidad') * Val(AJ:Val(W:1)) * (Val(AL:Val(W:1)) - Val(CT:Val(W:1))))
    ACN(ao:Val(w:1), Val(w:2))
    ACT(ap:Val(w:1), FBN('NrOperacion'))
    ACT(aq:Val(w:1), FBN('TipoOp'))
    ACD(ar:Val(w:1), FBN('FechaOp'))
    ACT(AS:Val(w:1), fbn('ContraEspecie'))
    ACN(AT:Val(w:1), fbn('CotOp'))
    SCN(p:Val(w:2), Val(an:Val(w:1)))
proximo

if FAC>1
    recorrer&i 2,FAC
      ACN(q:&i, Val(o:&i)+Val(p:&i))
      ACN(RS:1, Val(Q:&i))
      ACN(CT:3, Val(AL:&i))
      ACT(r:&i, Var('TIASDICASE'))
      SQL.ADD("select MA.Codigo ")
      SQL.ADD("  from "~DBO~".MODELOSASIENTO MA ")
      SQL.ADD(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
      Recorrer SQL    
        DFA
        Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
        ACD(FV:1, Val(V:2))
        ACT(MD:1, fbn('Codigo'))
        SQL.ADD(" select E.Codigo Especie, V.Codigo Vehiculo, E.Nombre, E.Cotiza, E.Tipo, V.Valor1, V.Valor2, ")
        SQL.ADD(" E.Cotiza Moneda, E.Cotiza ContraEspecie, '' Observaciones, '' Cliente1, V.Codigo Vehiculo1, 0 Cantidad, 'DCTIT' NrOperacion ")
        SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
        SQL.ADD(" Where E.Codigo = '"~Val(A:&i)~"' ")
        SQL.ADD(" AND V.Codigo = '"~Val(F:&i)~"' ")
        Recorrer SQL
            DFA
            ACN(CK:1, 0)
            IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
               ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where Modelo = '"~Val(MD:1)~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(V:2))~"' AND Vehiculo = '"~Val(F:&i)~"' "))
                  ACN(CK:1, 0)
               ENDIF
            ENDIF
            IF Val(CK:1) = 0
                SQL.GenerarAsientoOp(Val(MD:1), '','','',810,Val(v:2),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
                SQL.EXEC
            ENDIF
        Proximo
      proximo
    proximo
endif
