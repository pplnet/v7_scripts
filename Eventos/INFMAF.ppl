* ESTE EVENTO PREPARA TODA LA INFORMACION DE LA OPERACION Y SE LA MANDA A LA ESTACION 
* MONITORA PARA INFORMAR AL MAE (PARA TODA LAS OPERACIONES MINORISTAS CON ESPECIES VALIDAS)

CrearDialogo
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

*- Seleccion de las operaciones que se encuentran en la instancia Informar al MAE (60)
SQL.ADD("SELECT O.NrOperacion,    O.TipoOp,       O.Especie,       O.Rojo,               O.FechaOp,           ")
SQL.ADD("       O.PaseCB,         O.EsAforado,    O.TipoCambio2,   O.PorAforo,           O.Precio1,           ")
SQL.ADD("       O.CB6,            O.Plazo,        O.Cupon1,        O.PlazoGracia,        O.Mercado,           ")
SQL.ADD("       O.TablaFeriados1, O.FechaVto,     O.ContraEspecie, O.Cliente1,           O.OpSIOPEL,          ")
*SQL.ADD("       O.Cantidad,       O.Mercado2,     O.TotalNetoCli1, O.TotalInteresesOrig, O.FormaLiquidacion1, ")
*SQL.ADD("       O.NroAltaMAE,     O.NrOperacion3, O.EnteCus1,      O.TotalBrutoCli1Orig, O.Cuenta1,           ")
*SQL.ADD("       O.Precio3,        O.Precio4,      O.InteresMAE     ")
SQL.ADD("       O.Cantidad,       O.Mercado2,     O.TotalNetoCli1, O.FormaLiquidacion1, ")
SQL.ADD("       O.NroAltaMAE,     O.NrOperacion3, O.EnteCus1,      O.Cuenta1,           ")
SQL.ADD("       O.Precio3,        O.Precio4     ")
SQL.ADD("  from "~DBO~".OPMINORISTAS O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 60 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL
  if Incluido(FBN['TipoOp'], 'TIC|TIV')
    ACN(z1,0)
    BorrarCeldas(a:1..t:9)
    ACT(l:1, 'Plazo de liq. la Especie1')
    ACT(l:2, 'EsCupon de Especie1')
    ACT(l:3, 'CotizaMAE de Especie1')
    ACT(l:4, 'NrMAE de Cliente1')
    ACT(l:5, 'NrAgenteBolsa de Cliente1')
    ACT(l:6, 'Num(NrAgenteBolsa)')
    ACT(l:7, 'CampoMercado')
    ACT(l:8, 'Cuenta1')
    ACT(l:9, 'TipoMAE')

    ACN(m:1, BuscarCampo('ESPECIES','PlazoLiq','Codigo',FBN['Especie'])*24)
    ACT(m:2, BuscarCampo('ESPECIES','EsCupon','Codigo',FBN['Especie']))
    ACT(m:3, BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']))
    ACT(m:4, Pad0('000',3))
    ACT(m:5, Pad0('000',3))
    ACN(m:6, Num(Val(m:5)))
* Funcion inexistente
*    ACT(m:7, CampoMercado(FBN['Mercado2'],FBN['Especie'],FBN['Cliente1'],2))
    ACT(m:8, fbn('Cuenta1'))
    ACT(m:9, BuscarCampo('CUENTAS','TipoMAE','Codigo',fbn('Cuenta1')))

    ************ Prepara info para Bloque de Control ******************************************
    * Longitud             PIC(4)                                                             *
    * Mercado              PIC(1)                                                             *
    * Agente               PIC(3)                                                             *
    * Operador             PIC(2)                                                             *
    * Fecha                PIC(6)                                                             *
    * Hora                 PIC(6)                                                             *
    * Secuencia            PIC(5)                                                             *
    * Cod. de Registro     PIC(4)                                                             *
    *******************************************************************************************
    ACN(Y1, Ahora)
    ACT(Y2, Hora(Val(Y1)))
    if Eqstr(FBN['Rojo'],'1') 
      ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
    else
      ACT(Y3, Fecha(fbn('FechaOp'), Exe('FORFECMAE')))
    endif
    *** Mercado
    ACT(A2, Var('MERSIOP'))
    *** Agente                                        
    ACT(A2, Val(A2)~Var('AGESIOP'))
* FJL 10/02/21 - En BIND se usa otro operador por eso uso lavariable
*    ACT(A2, Val(A2)~'99')
    ACT(A2, Val(A2)~Var('OPESIOPEL'))
    *** Fecha
    ACT(A2, Val(A2)~Val(Y3))
    *** Hora
    ACT(A2, Val(A2)~Copy(Val(Y2),1,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),4,2))
    ACT(A2, Val(A2)~Copy(Val(Y2),7,2))
    *** Secuencia (Comienza con 3 (alta) o 7 (baja) )
    if Not Eqstr(FBN['Rojo'],'1')
      * Alta
      ACT(A2, Val(A2)~'3')
      ACT(s:1, 'AL')
    else
      * Baja
      ACT(A2, Val(A2)~'7')
      ACT(s:1, 'BA')
    endif
    ACT(A2, Val(A2)~Copy(FBN['NrOperacion'],5,4))
    *** Cod. de Registro
    if Incluido(FBN['TipoOp'],'TIV|TIFV')
      ACT(A2, Val(A2)~'03')
      ACT(s:2, 'VT')
    else
      if Incluido(FBN['TipoOp'],'TIC|TIFC')
        ACT(A2, Val(A2)~'04')
        ACT(s:2, 'CO')
      else
        * Error en TipoOp
        ACN(z1,1)
        ACT(A2, Val(A2)~'00')
      endif
    endif
    if Not Eqstr(FBN['Rojo'],'1')
      * Alta Operacion (Forma parte del Cod. de Reg.)
      if [FBN['FechaOp'] = FSYS]
        ACT(A2, Val(A2)~'01')
      else
        if [FBN['FechaOp'] < FSYS]
          ACT(A2, Val(A2)~'03')
        else
          * Error en FechaOp
          ACN(z1,1)
          ACT(A2, Val(A2)~'00')
        endif
      endif
    else
      * Baja Operacion (Forma parte del Cod. de Reg.)
      if [FBN['FechaOp'] = FSYS]
        ACT(A2, Val(A2)~'02')
      else
        if [FBN['FechaOp'] < FSYS]
          ACT(A2, Val(A2)~'04')
        else
          * Error en FechaOp
          ACN(z1,1)
          ACT(A2, Val(A2)~'00')
        endif
      endif
    endif
    ACT(s:3, 'TR')
    ****************************************
    *** Aca termina el Bloque de Control ***
    ****************************************

    if Not Eqstr(FBN['Rojo'],'1')
      ACN(r1, 2)
      ************************ Alta Operacion MAE *********************************************
      ************************ Prepara info para Codigo de Titulo *****************************
      * Negociacion PIC(1) reservado                                                          *
      * Cod especie PIC(5)                                                                    *
      * Cupon       PIC(1) " " (negocia lamina) o "C" (negocia cupon)                         * 
      * Nro Cupon   PIC(3) nro. cupon adherido                                                *
      * Plazo dias  PIC(3) habiles para CV o corridos para pases                              *
      * Moneda      PIC(1) "A" (pesos) o "D" (dolares)                                        *
      * Indica tipo PIC(1) 1(Tit.Pub.) 2(ON) 3(Acc.Ord.) 4(Acc.Pref.) 5(Pases) 6(Caucion) 7(Pase Af)*
      *****************************************************************************************
      *** Negociacion  
      if Incluido(FBN['TipoOp'],'TIV|TIC')
        * Spot
        if fbn['Plazo']<=3
          ACT(A3,'1')
        else
          ACT(A3,'9')
        endif
      else
        * Error en Tipo de Operacion
        ACN(z1,1)
        ACT(A3,'0')
      endif
      *** Guardar Precio Operacion
      ACN(z3, fbn('Precio1'))
      *** No lleva %  de aforo
      ACN(z4, 1)
            
      *** Especie
      ACT(A3, Val(A3)~Pad(FBN['EnteCus1'],5))
      *** Cupon     
      if EqStr(Val(m:2),'SI')
        ACT(A3, Val(A3)~'C')
      else
        ACT(A3, Val(A3)~' ')
      endif
      *** Nro Cupon 
* FJL 26/04/18 - Cambio en SIOPEL
*      ACT(A3, Val(A3)~PAD0(FStr(Num(FBN['Cupon1']),1,0),3))
      if Num(FBN['Cupon1'])=0
        ACT(A3, Val(A3)~'   ')
      else
        ACT(A3, Val(A3)~PAD0(FStr(Num(FBN['Cupon1']),1,0),3))
      endif
      *** Plazo
      if Incluido(FBN['TipoOp'], 'TIV|TIC')
        if FBN['PaseCB'] = 1
          * No pueden ser Pases
        else
          if fbn['Plazo']<=3
            ACT(A3, Val(A3)~Pad0(FStr(fbn['Plazo'],1,0),3))
          else
            if Not Incluido(fbn['Mercado'],'AC|CRYL|CE|EU') y EqStr(fbn['TablaFeriados1'],'USA') y Not EsHabil(Habiles(fbn['FechaVto'],-1,'ARG'),'USA')
              ACT(A3, Val(A3)~Pad0(FStr(Habiles(fbn['FechaVto'],-1,'ARG')-fbn['FechaOp'],1,0),3))
            else
              ACT(A3, Val(A3)~Pad0(FStr(fbn['FechaVto']-fbn['FechaOp'],1,0),3))
            endif
          endif
        endif
      else
        if Incluido(FBN['TipoOp'], 'TIFV|TIFC')
          ACT(A3, Val(A3)~Pad0(FStr(FBN['PlazoGracia'],1,0),3))
        else
          * Error en Tipo de Operacion
          ACN(z1,1)
          ACT(A3, Val(A3)~Pad0(FStr(0,1,0),3))
        endif
      endif
      *** Moneda 
      if Incluido(FBN['ContraEspecie'], 'USD')
        ACT(A3, Val(A3)~'D')
      else
        if Incluido(FBN['ContraEspecie'], 'ARP')
          ACT(A3, Val(A3)~'$')
        else
          ACT(A3, Val(A3)~'E')
        endif
      endif
      *** Indicador de Tipo
      if DesciendeDeEspecie(FBN['Especie'], 'TITULO') 
        ACT(A3, Val(A3)~'1')
      else
        if DesciendeDeEspecie(FBN['Especie'], 'ON')
          ACT(A3, Val(A3)~'2')
        else
          ACT(A3, Val(A3)~'0')
        endif
      endif
      ACT(A2, Val(A2)~Val(A3))
      *************************** Codigo de Agente Contraparte ********************************
      * Mercado Contra   PIC(1)                                                               *
      * Agente Contra    PIC(3)                                                               *
      * Operador Contra  PIC(2)                                                               *
      *****************************************************************************************
      *** Mercado / Agente / Operador
      ACT(A4, '0')
      ACT(A4, Val(A4)~'000')
      ACT(A4, Val(A4)~'00')
      ACT(A2, Val(A2)~Val(A4))
      ************************************ Otros datos ****************************************
      * Cantidad          PIC(14)V(4)                                                         *
      * Precio            PIC(10)V(8)                                                         *
      * Tipo Op.Origen    PIC(1)      1 (AMA)          2 (BCRA)           5 (Cartera Propia)  *
      * Tipo Op.Destino   PIC(1)      0 (No Agente)    1 (AMA)            2 (BCRA)            *
      *                               3 (Ag.Bolsa)     4 (AFJP Fondo)     5 (Cartera Propia)  *
      *                               6 (AFJP Encaje)                                         *
      * Ente Liquidador   PIC(1) (Op.Compra) 1/D (ARGENCLEAR) 3/6 (CEDEL)  2 (CRYL)           *
      *                                      4/6 (EUROCLEAR)  5/6 (MERVAL) 6 (E/PARTES USA)   *
      * Tipo Liquidacion  PIC(1) (Op.Compra) 1 (DVP)          2 (FP)       3 (DVP&F)          *
      *                                      4 (FT)                                           *
      * Codigo de Rueda   PIC(4)                                                              *
      * Interes           PIC(16)V(2)                                                         *
      *****************************************************************************************
      *- Cantidad
      ACT(A5, Pad0(FStr(FBN['Cantidad']*10000,1,0),18))
      *- Precio
      if Eqstr(Val(m:3),'CLE')
        *- Si la especie se informa al MAE clean
        ACT(A5, Val(A5)~Pad0(FStr(FBN['Precio3']*100000000,1,0),18))
      else
        *- Si la especie se informa al MAE dirty
        ACT(A5, Val(A5)~Pad0(FStr(FBN['Precio4']*100000000,1,0),18))
      endif

        ***** Tipo Op.Origen
         ***********************************************************************************************
         * Por Siopel 8
         * ACT(A5, Val(A5)~'5')
         *----------------------------------------------------------------------------------------------
         *    5 Cartera Propia 
         *    7 Comitente Cartera Propia
         *    8 Por cuenta de un Cliente 
         * Aparentemente se informa Cartera propia en origen
         if NO y Incluido(fbn['TipoOp'],'TIV|TIFV|')
            * Por ahora no hay diferencia entre compra y venta
            If DesciendeDeCliente(FBN['Cliente1'],'DIRECTORIO')
               ACT(A5, Val(A5)~'7')
               ACT(TO1,'7')
            else
               BorrarCeldas(xx:1..xx:1)
               ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
               If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
                  ACT(A5, Val(A5)~'8')
                  ACT(TO1,'8')
               Else
                  ACT(A5, Val(A5)~'5')
                  ACT(TO1,'5')
               Endif
            endif
         else
            ACT(A5, Val(A5)~'5')
            ACT(TO1,'5')
         endif

        ***** Tipo Op.Destino 
         BorrarCeldas(xx:1..xx:1)
         if SI o Incluido(fbn['TipoOp'],'TIC|TIFC|')
            *- Tercero Vinculado
            If DesciendeDeCliente(FBN['Cliente1'], 'DIRECTORIO')
               ACT(A5, Val(A5)~'4')
               ACT(TD1,'4')
            else
               *- Agente Bolsa
               If Num(BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',FBN['Cliente1'])) > 0
                  ACT(A5, Val(A5)~'3')
                  ACT(TD1,'3')
               Else
                  *- Agente mae
                  If novacio(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1'])) y Not Eqstr(BuscarCampo('CLIENTES','NrMAE','Codigo',FBN['Cliente1']),'000')
                     ACT(A5, Val(A5)~'5')
                     ACT(TD1,'5')
                  Else
                     *- Tercero
                     ACT(xx:1,SQL("Select NrMAE from "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"' "))
                     If Incluido(Val(xx:1),'0|00|000') o Vacio(Val(xx:1))
                        ACT(A5, Val(A5)~'6')
                        ACT(TD1,'6')
                     else
                        ACT(A5, Val(A5)~'5')
                        ACT(TD1,'5')
                     endif
                  endif
               endif
            Endif
         else
            * Por ahora no hay diferencia entre compra y venta
            ACT(A5, Val(A5)~'5')
            ACT(TD1,'5')
         endif


      *** Ente Liquidador
      if EqStr(FBN['Mercado'],'AC')
        if EqStr(FBN['TablaFeriados1'],'USA')
          ACT(A5,Val(A5)~'D')
        else
          if EqStr(FBN['ContraEspecie'],'USD') y EqStr(FBN['ContraEspecie2'],'USB')
            ACT(A5,Val(A5)~'B')
          else
            ACT(A5,Val(A5)~'1')
          endif
        endif
      else
        if EqStr(FBN['Mercado'],'CRYL')
          ACT(A5,Val(A5)~'2')
        else
          if EqStr(FBN['Mercado'],'CE')
            if EqStr(FBN['TablaFeriados1'],'USA')
              ACT(A5,Val(A5)~'6')
            else
              ACT(A5,Val(A5)~'3')
            endif
          else
            if EqStr(FBN['Mercado'],'EU')
              if EqStr(FBN['TablaFeriados1'],'USA')
                ACT(A5,Val(A5)~'6')
              else
                ACT(A5,Val(A5)~'4')
              endif
            else
              if EqStr(FBN['Mercado'],'CV')
                if EqStr(FBN['TablaFeriados1'],'USA')
                  ACT(A5,Val(A5)~'6')
                else
                  ACT(A5,Val(A5)~'5')
                endif
              else
                if EqStr(FBN['TablaFeriados1'],'USA')
                  ACT(A5,Val(A5)~'6')
                else
                  ACT(A5,Val(A5)~'5')
                endif
              endif
            endif
          endif
        endif
      endif
      *** Tipo de Liquidacion
      if FBN['FormaLiquidacion1'] = 0
        ACT(A5,Val(A5)~'2')
      endif
      if FBN['FormaLiquidacion1'] = 1
        ACT(A5,Val(A5)~'1')
      endif
      if FBN['FormaLiquidacion1'] = 2
        ACT(A5,Val(A5)~'4')
      endif
      *** Codigo de Rueda
      ACT(A5, Val(A5)~'    ')
      *** Interes
      if Eqstr(Val(m:3),'CLE')
        * Si la especie se informa al MAE clean
        ACT(A5, Val(A5)~Pad0(FStr(fbn('InteresMAE')*100,1,0),18))
      else
        * Si la especie se informa al MAE dirty
        ACT(A5, Val(A5)~'000000000000000000')
      endif
      ACT(A2, Val(A2)~Val(A5))
    else
      if Eqstr(FBN['Rojo'],'1')
        ACN(r1, 1)
        ************************************ Baja Operacion MAE *******************************
        *** Fecha Alta al MAE (ojo ver si esta con separadores, sacarlos)
        BorrarCeldas(k1..k3)
        ACN(K1, Trunc2(SQL("Select FechaAltaMAE from "~DBO~".OPMINORISTAS where NrOperacion = '"~FBN['NrOperacion']~"' ")))
        ACT(K2, Fecha(Val(K1)))
        ACT(K3, Copy(Val(K2),9,2)~Copy(Val(K2),4,2)~Copy(Val(K2),1,2))
        * Operacion con Tercero o Ag.Bolsa
        ACT(A2, Val(A2)~Val(K3))  
        *** Nro. MAE de la Operacion (Secuencia)
        ACT(A2, Val(A2)~Pad0(Copy(FBN['NroAltaMAE'],1,5),5))
        *** Mercado / Agente / Operador
        ACT(A4, '0') 
        ACT(A4, Val(A4)~'000')
        ACT(A4, Val(A4)~'00')
        ACT(A2, Val(A2)~Val(A4))
      endif
    endif
    *********************** Datos en caso de envio con demora (ayer) **************************
    * Codigo de Motivo   PIC(2) (Ver Codigos de demoras)                                      *
    * Motivo de Demora   PIC(78)                                                              *
    *******************************************************************************************
    if FBN['FechaOp'] < FSYS
      *** Codigo
      ACT(A6, '12')
      *** Descripcion
      ACT(A6, Val(A6)~Pad('Problemas de soft/hard',78))
      ACT(A2, Val(A2)~Val(A6))
      ***********************************************************************************************
      * Por Siopel 8
      *----------------------------------------------------------------------------------------------
      (.'MSG303403'.)
      *----------------------------------------------------------------------------------------------
    endif
    *************************************** Envio de Datos ************************************
    * Envia los Datos a la Estacion Monitora, pasa la operacion a la Instancia Siguiente y    *
    * actualiza la operacion con los datos de envio                                           *
    *******************************************************************************************
    *- Longitud Total del Paquete en Caracteres
    ACT(P1, Pad0(FStr(Longitud(Val(A2))+4,1,0),4) )
    ACT(A2, Val(P1)~Val(A2))
    if Val(z1)=0
      if Dialogo.Check1=1
        Socket.Enviar(Val(A2))
        if Not OK
          Message('Error Enviando Op. Nro : '~FBN['NrOperacion'])
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Error Enviando Op.'~FBN['NrOperacion'],30))
            CerrarASCII
          endif
        else
          if Eqstr(Var('LOGEAMAE'),'SI')
            AbrirASCII(VAR('PATHSIOPEL')~'\ENVIOMAE.TXT',0)
            EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(a:2))
            CerrarASCII
          endif
          ACT(t:1, Val(s:1)~Val(s:2)~Val(s:3))
          ACT(t:2, Copy(Val(A2),11,6))
          ACT(t:3, Copy(Val(A2),17,6))
          ACT(t:4, Copy(Val(A2),23,5))
          ACT(t:5, Copy(Val(A2),28,4))
          ACT(t:6, 'INF')
          ACT(t:7, Copy(Val(A2),1,250))
          if Longitud(Val(A2))>250
            ACT(t:8, Copy(Val(A2),251,250))
          endif
          if Longitud(Val(A2))>500
            ACT(t:9, Copy(Val(A2),501,250))
          endif
          (.'GRAMENMAE'.)
          
          ACT(a1, SQLAhora)
          SQL.ADD("Update "~DBO~".OPMINORISTAS ")
          SQL.ADD("   Set FechaEnvioMAE = "~Val(a1)~" ")
          SQL.ADD(" Where NrOperacion   = '"~FBN['NrOperacion']~"' ")
          if FBN['FechaOp'] < FSYS
            SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
            SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
            SQL.ADD(" ) Values ( ")
            SQL.ADD(" '"~FBN['NrOperacion']~"', ")
            SQL.ADD(" "~SQLAhora~", ")
            SQL.ADD(" 'MAEFVALOR', ")
            SQL.ADD(" '"~Copy(Val(A6),1,2)~'-'~Copy(Val(A6),3,55)~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
          endif
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=Val(r1), Entero1=60, Entero2=61)
        endif
      endif
    else
      * Error z1<>0
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Error z1<>0 INFMAF ('~FBN['NrOperacion']~')',30))
        CerrarASCII
      endif
    endif
  else
    * Error en Tipo de Operacion
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(VAR('PATHSIOPEL')~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Error TipoOp INFMAF ('~FBN['NrOperacion']~')',30))
      CerrarASCII
    endif
  endif
Proximo
ACO(12,15)
