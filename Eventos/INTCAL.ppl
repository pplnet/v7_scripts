CrearDialogo
    Directorio1 :"Ruta"     ;;;;;;;;;;Var('PATHINTCAL')
    Fecha1      :"Fecha"    ;;;;;;;;;;FSYS
   
FinDialogo


If Not OK
 Cancelar
Endif

let &fecha  Copy(Dialogo.Fecha1,1,2) ~Copy(Dialogo.Fecha1,4,2)

ACT(az1,'CallOperAct|CallOperPas|CallCuoAct|CallCuoPas|')
ACN(az3,1)
Recorrer&k 1,Elementos(val(az1))
    ACT(az2,ItemLista(val(az1),&k))
    if Val(az4) = 0
        if ExisteArchivo(Dialogo.Directorio1~Val(Az2)~&fecha~".txt")
            if MessageBox('Ya existen archivos generados para este dia ¿Desea reprocesar?',1,2) = 6
                *Flag para confirmar que desea reprocesar
                ACN(az4,1)
            else
                ACN(az3,0)
                BREAK
            endif
         endif        
    else
        BREAK
    endif
    
Proximo
*Confirma que el evento empieza
if Val(az3) = 1
    Recorrer&l 1,Elementos(val(az1))
        ACT(az2,ItemLista(val(az1),&l))
        if ExisteArchivo(Dialogo.Directorio1~Val(Az2)~&fecha~".txt")
            BorrarArchivo(Dialogo.Directorio1~Val(Az2)~&fecha~".txt")
        endif
    Proximo
    D
    AbrirAscii(Dialogo.Directorio1~"CallOperAct"~&fecha~".txt")

    *QUERY MMCO  Activo Activa Cabecera
    SQL.ADD("SELECT * FROM "~dbo~".OPERACIONES Where TipoOp = 'MMCO' AND FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha1)~"' <= FechaVto ")
    Recorrer SQL 
        ACT(A:FAC,'54')
        ACT(B:FAC,'319')
        ACT(C:FAC,'1')
        ACT(D:FAC,'60')
        if Eqstr(FBN['Especie'], 'USD')
            ACT(E:FAC,'2')
        else
            ACT(E:FAC,'0')
        endif
        ACT(F:FAC,Pad0(SQL("SELECT ValorSistemaExterno FROM "~dbo~".CONFIGVALEXTERNOS WHERE Valor = (SELECT TipoDocum FROM "~dbo~".CLIENTES WHERE Codigo = '"~FBN['Cliente1']~"') AND CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO'"),5))
        ACT(G:FAC,Pad0(SQL("SELECT CUIT FROM "~dbo~".Clientes Where Codigo = '"~FBN['Cliente1']~"'"),17))
        ACT(H:FAC,Pad0(FBN['NrOperacion'],10))
        ACT(I:FAC,'1')
        ACT(J:FAC,'1')
        ACT(K:FAC,'1')
        ACT(L:FAC,Fecha(FBN['FechaOp']))
        ACT(M:FAC,FStr(FBN['Precio4'],,4))
        ACT(N:FAC,'0')
        ACT(O:FAC,'1')
        ACT(P:FAC,'1')
        ACT(Q:FAC,'1')
        ACT(R:FAC,'1')
        ACT(S:FAC,'1')
        ACT(T:FAC,'1')

        EscribirAscii(Val(A:FAC)~'*~*'~Val(B:FAC)~'*~*'~Val(C:FAC)~'*~*'~Val(D:FAC)~'*~*'~Val(E:FAC)~'*~*'~Val(F:FAC)~'*~*'~Val(G:FAC)~'*~*'~Val(H:FAC)~'*~*'~Val(I:FAC)~'*~*'~Val(J:FAC)~'*~*'~Val(K:FAC)~'*~*'~Val(L:FAC)~'*~*'~Val(M:FAC)~'*~*'~Val(N:FAC)~'*~*'~Val(O:FAC)~'*~*'~Val(P:FAC)~'*~*'~Val(Q:FAC)~'*~*'~Val(R:FAC)~'*~*'~Val(S:FAC)~'*~*'~Val(T:FAC))
        IFA
    proximo
    CerrarAscii()
    **QUERY MMCO  Baja Cabecera

    AbrirAscii(Dialogo.Directorio1~"CallOperAct"~&fecha~".txt")
    SQL.ADD("SELECT * FROM "~dbo~".BOPERACIONES Where TipoOp = 'MMCO' AND Cast(FechaDel  as date) = '"~IdxDate(Dialogo.Fecha1)~"'")
