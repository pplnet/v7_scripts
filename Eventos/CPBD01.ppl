MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

(.'DNLISTA'.)
ACT(LL:1, VAl(l:1))
ACT(L:1, '')

CrearDialogo
 Fecha1   : 'D.FechaAcr.'  ;1;1;;;;Dialogo.Fecha1<=FSYS ;'Fecha Incorrecta';NO;HABILES(FSys,-2,'ARG')
 Fecha2   : 'H.FechaAcr.'  ;1;2;;;;Dialogo.Fecha2<=FSYS ;'Fecha Incorrecta';NO;FSys
 Check1   : 'Fecha'     ;2;1;;;;;;;0
 Check3   : 'Importe'   ;3;1;;;;;;;1
 Cantidad1: 'Tolerancia';3;2;;;Dialogo.Check3=0;;;;1 
 Check2   : 'NrComprob' ;4;1;;;;;;;0
 Lista1:   'Vehiculos'  ;5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista2:   'CtasMadres' ; ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Codigo IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS)  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" ");
 Lista3:   'CtasPag/Rec/Int';0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE (Pagadora='SI' OR TipoCuenta IN ('REC','INT') ) "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" "~IIF(NOVACIO(Dialogo.Lista2), " AND CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")", " AND (CtaPrincipal IS NOT NULL OR CtaPrincipal<>'')" )~" ");
 Check4   : 'Confirma'  ;1;2;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif  

SQL.ADD(" SELECT /*+ RULE */ DISTINCT M.NrDatanet, M.NrMovDatanet, M.Banco, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, ")
SQL.ADD(" M.DC, M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, E.Codigo MonedaFPA, C.Codigo CuentaFPA, B.Codigo BancoFPA, CD.Tipo TipoDatanet ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".VEHICULOS V, "~DBO~".ESPECIES E,")
SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD ")
SQL.ADD(" WHERE  M.NrDatanet   = D.NrDatanet   ")
SQL.ADD(" AND    M.Vehiculo    = V.Codigo  (+) ")
SQL.ADD(" AND    M.Cuenta      = C.Numero  (+) ")
*SQL.ADD(" AND    C.Estado      = 'HAB' ")
SQL.ADD(" AND    M.Moneda      = E.Alias3  (+) ")
SQL.ADD(" AND    M.Banco       = B.Alias2  (+) ")
SQL.ADD(" AND    M.TipoMov     = CD.Codigo (+) ")
SQL.ADD(" AND    CD.Tipo       = TD.Codigo  ")
SQL.ADD(" AND    M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")
* 06/07/2004 interfaz rio SQL.ADD(" AND    D.Archivo     IN ('DNCTAS','DNAHMS','DNCCDO','DNCADO','DNOTRO')  ")
SQL.ADD(" AND    D.Archivo      IN ("~Pipe2Comillas(Val(ll:1))~")  ")
SQL.ADD(" AND    TD.Codigo     IN ("~Pipe2Comillas(VAR('CPBD020'))~")  ")
SQL.ADD(" AND    M.NrMovDatanet NOT IN (SELECT MNrMovDatanet FROM "~DBO~".EXTRACTOS WHERE MNrDatanet=M.NrDatanet ) ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND V.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
   Endif
Endif
If NoVAcio(Dialogo.Lista2)
   SQL.ADD(" AND C.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Else
   SQL.ADD(" AND C.Codigo  IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS) ")
Endif
SQL.ADD(" ORDER By M.Banco, M.Cuenta, M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion ")

ACN(bz:1,0)

Recorrer SQL
  ACT(a:fac, fbn('NrDatanet'))
  ACN(b:fac, fbn('NrMovDatanet'))
  ACT(c:fac, fbn('Banco'))
  ACT(d:fac, fbn('Sucursal'))
  ACT(e:fac, fbn('Cuenta'))
  ACT(f:fac, fbn('Moneda'))
  ACN(g:fac, fbn('Importe'))
  ACT(h:fac, fbn('DC'))
  ACD(i:fac, fbn('FechaIngreso'))
  ACD(j:fac, fbn('FechaAcreditacion'))
  ACT(k:fac, fbn('TipoMov'))
  ACT(l:fac, fbn('Comprobante'))
  SCN(bz:1,1)
Proximo

If Val(bz:1)=0
  message('No hay movimientos en las Cuentas Principales para conciliar.')
  Cancelar
Endif

SQL.ADD(" SELECT /*+ RULE */ DISTINCT M.NrDatanet, M.NrMovDatanet, M.Banco, M.Sucursal, M.Cuenta, M.Moneda, M.Importe, ")
SQL.ADD(" M.DC, M.FechaIngreso, M.FechaAcreditacion, M.TipoMov, M.Comprobante, E.Codigo MonedaFPA, ")
SQL.ADD(" C.Codigo CuentaFPA, B.Codigo BancoFPA, CD.Tipo TipoDatanet, C2.Numero CtaPpal ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".VEHICULOS V, "~DBO~".ESPECIES E,")
SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".CUENTAS C2 ")
SQL.ADD(" WHERE  M.NrDatanet    = D.NrDatanet   ")
SQL.ADD(" AND    C.CtaPrincipal = C2.Codigo     ")
SQL.ADD(" AND    M.Vehiculo     = V.Codigo  (+) ")
SQL.ADD(" AND    M.Cuenta       = C.Numero   (+) ")
*SQL.ADD(" AND    C.Estado       = 'HAB' ")
SQL.ADD(" AND    M.Moneda       = E.Alias3  (+) ")
SQL.ADD(" AND    M.Banco        = B.Alias2  (+) ")
SQL.ADD(" AND    M.TipoMov      = CD.Codigo (+) ")
SQL.ADD(" AND    CD.Tipo        = TD.Codigo  ")
SQL.ADD(" AND    M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")
* 06/07/04 interfaz rio SQL.ADD(" AND    D.Archivo     IN ('DNCTAS','DNAHMS','DNCCDO','DNCADO','DNOTRO')  ")
SQL.ADD(" AND    D.Archivo      IN ("~Pipe2Comillas(Val(ll:1))~")  ")
SQL.ADD(" AND    TD.Codigo     IN ("~Pipe2Comillas(VAR('CPBD021'))~")  ")
SQL.ADD(" AND    M.NrMovDatanet NOT IN (SELECT HNrMovDatanet FROM "~DBO~".EXTRACTOS WHERE HNrDatanet=M.NrDatanet ) ")
If NoVAcio(Dialogo.Lista1)
   SQL.ADD(" AND V.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
   Endif
Endif
If NoVAcio(Dialogo.Lista2)
   SQL.ADD(" AND C.CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVAcio(Dialogo.Lista3)
   SQL.ADD(" AND C.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Else
   SQL.ADD(" AND (C.TipoCuenta IN ('INT','REC') OR C.Pagadora='SI') ")
   SQL.ADD(" AND (C.CtaPrincipal IS NOT NULL OR C.CtaPrincipal <> '') ")
Endif
SQL.ADD(" ORDER By M.Banco, M.Cuenta, M.NrDatanet, M.NrMovDatanet, M.FechaAcreditacion ")

Recorrer SQL
  message('Extracto '~fbn('NrDatanet')~' - Mov: '~fbn('NrMovDatanet'))

  Recorrer&i 1,Val(bz:1)
    ACN(kk:1, 1)
    ACN(mt:1, 0)

    If Eqstr(Val(e:&i), fbn('CtaPpal')) y Not Eqstr(Val(h:&i), fbn('DC')) y Val(aa:&i)<>1
      If Dialogo.Check1=1 y fbn('FechaAcreditacion')<>Val(j:&i)
         message('No es la misma fecha.')
         ACN(kk:1, 0)
      Endif
      If Dialogo.Check2=1 y Eqstr(Val(l:&i),fbn('Comprobante'))
         message('No es el mismo comprobante.')
         ACN(kk:1, 0)
      Endif
      If Dialogo.Check3=1 
        If abs(fbn('Importe'))<>Abs(Val(g:&i))
           message('No es la misma cantidad.')
           ACN(kk:1, 0)
        Endif
      Else
        If ABS(abs(fbn('Importe'))-abs(Val(g:&i))) >Dialogo.Cantidad1
           message('Supera el rango de tolerancia.')
           ACN(kk:1, 0)
        Else
           ACN(mt:1, ( abs(fbn('Importe'))-abs(Val(g:&i)) ) )
        Endif
      Endif 
    Else
      * No es por el match basico
      If Val(aa:&i)=1
         message('Matcheo con el Extracto '~Val(ab:&i)~' - Movimiento: '~fstr(Val(ac:&i),0,0))
      Endif
      ACN(kk:1, 0)
    Endif

    If Val(kk:1)=1
      ACN(aa:&i, 1 ) 
      ACT(ab:&i, fbn('NrDatanet') ) 
      ACN(ac:&i, fbn('NrMovDatanet') ) 
      ACT(ad:&i, fbn('Banco') ) 
      ACT(ae:&i, fbn('Cuenta') ) 
      ACT(af:&i, fbn('Moneda') ) 
      ACN(ag:&i, Val(mt:1)) 
      ACN(ah:&i, fbn('Importe')) 
      ACT(ai:&i, fbn('DC'))
      ACT(aj:&i, fbn('Comprobante')) 
      ACT(ak:&i, fbn('TipoMov'))
      ACD(al:&i, fbn('FechaIngreso')) 
      ACD(am:&i, fbn('FechaAcreditacion')) 
      message('Movimiento encontrado.')
      Break
    Endif
  Proximo

  If Val(kk:1)=0
     message('Movimiento no informado por Datanet.')
  Endif
Proximo


If Dialogo.Check4=1
  CrearListBox; 'Arial,8,'
   'Extracto'      ;a:1..a:Val(bz:1);NO;;;60;STRING;;RGB(232,232,232);
   'NrMov'         ;b:1..b:Val(bz:1);NO;;;40;NUMERO;'###,###,###';RGB(232,232,232);
   'Banco'         ;c:1..c:Val(bz:1);NO;;;50;STRING;;RGB(232,232,232);
   'Cuenta'        ;e:1..e:Val(bz:1);NO;;;80;STRING;;RGB(232,232,232);
   'Moneda'        ;f:1..f:Val(bz:1);NO;;;50;STRING;;RGB(232,232,232);
   'Importe'       ;g:1..g:Val(bz:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
   'D/C'           ;h:1..h:Val(bz:1);NO;;;25;STRING;;RGB(232,232,232);
   'TipoMov'       ;k:1..k:Val(bz:1);NO;;;45;STRING;;RGB(232,232,232);
   'Comprobante'   ;l:1..l:Val(bz:1);NO;;;70;STRING;;RGB(232,232,232);
   'F.Ingreso'     ;i:1..i:Val(bz:1);NO;;;70;FECHA ; RGB(232,232,232);
   'F.Acredit'     ;j:1..j:Val(bz:1);NO;;;70;FECHA ; RGB(232,232,232);
   'OK'          ;aa:1..aa:Val(bz:1);SI;Val(aa:FLB)=0 o NoVacio(Val(ab:flb));'Movimiento Invalido';100;CHECK; RGB(232,255,215);
   'Extracto'    ;ab:1..ab:Val(bz:1);NO;;;60;STRING;;RGB(221,242,255);
   'NrMov'       ;ac:1..ac:Val(bz:1);NO;;;40;NUMERO;'###,###,###';RGB(221,242,255);
   'Banco'       ;ad:1..ad:Val(bz:1);NO;;;50;STRING;;RGB(221,242,255);
   'Cuenta'      ;ae:1..ae:Val(bz:1);NO;;;80;STRING;;RGB(221,242,255);
   'Moneda'      ;af:1..af:Val(bz:1);NO;;;50;STRING;;RGB(221,242,255);
   'Importe'     ;ah:1..ah:Val(bz:1);NO;;;80;NUMERO;'###,###,###,###.##';RGB(221,242,255);
   'D/C'         ;ai:1..ai:Val(bz:1);NO;;;25;STRING;;RGB(221,242,255);
   'TipoMov'     ;ak:1..ak:Val(bz:1);NO;;;45;STRING;;RGB(221,242,255);
   'Comprobante' ;aj:1..aj:Val(bz:1);NO;;;70;STRING;;RGB(221,242,255);
   'F.Ingreso'   ;al:1..al:Val(bz:1);NO;;;70;FECHA ; RGB(221,242,255);
   'F.Acredit'   ;am:1..am:Val(bz:1);NO;;;70;FECHA ; RGB(221,242,255);
  FinListBox

  If Not Ok
    Cancelar
  Endif
Endif

Recorrer&i 1,Val(bz:1)
  If Val(aa:&i)=1
    * aa Accion -> 1 Confirma
    message('Confirma Matcheo.')
    SQL.ADD(" INSERT INTO "~DBO~".EXTRACTOS ( ")
    SQL.ADD(" CtaPrincipal, MNrDatanet, MNrMovDatanet, ")
    SQL.ADD(" CtaHija, HNrDatanet, HNrMovDatanet, ")
    SQL.ADD(" Fecha, Operador ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~Val(e:&i)~"', '"~Val(a:&i)~"', "~fstr(Val(b:&i),0,0)~", ")
    SQL.ADD(" '"~Val(ae:&i)~"', '"~Val(ab:&i)~"', "~fstr(Val(ac:&i),0,0)~", ")
    SQL.ADD(" "~Idxdate2(fsys)~", '"~USUARIOACTIVO~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
    SQL.EXEC
  Endif
Proximo