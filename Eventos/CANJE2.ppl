***--- SALDOS Y MOVIMIENTOS
SQL.ADD(" Select DISTINCT  T.Mercado1, T.Cliente1, CU.Especie1, T.Especie2, T.NrTrans, ")
SQL.ADD(" T.NrOperacionRef1, T.Cuenta1, T.Cuenta2, T.Cuenta5, T.Cuenta6, ")
SQL.ADD(" CU.Cantidad4 CUCantidad4, CU.Cantidad1 CUCantidad1, T.Cantidad3, CU.Cantidad2 CUCantidad2, CU.Cantidad3 CUCantidad3, T.Cambio4, ")
SQL.ADD(" T.Cliente2, T.RB1, ")
* FJL 18/12/21 - Se Traen datos Comisiones
SQL.ADD(" T.Cantidad9, T.Cantidad10, T.Cantidad11, ")
* FJL 03/05/22 - Se Trae NrSaldo
SQL.ADD(" T.Cambio5, ")
** FJL 25/8/22 - Se agrgan Comisiones CV
SQL.ADD(" T.Cantidad12, T.Cantidad13, T.Cantidad14, T.Cantidad15, ")
SQL.ADD(" C.RazonSocial ")
SQL.ADD(" From  "~DBO~".TRANSACCIONES2 T, "~DBO~".CUOTAS CU, "~DBO~".CLIENTES C ")
SQL.ADD(" where T.TipoTr2   = 'CANJE' ")
SQL.ADD("  and  T.NrTrans   = CU.NrOperacion ")
SQL.ADD("  and  T.Cliente1  = C.Codigo ")
SQL.ADD("  and  T.Especie   = '"~Val(z:1)~"' ")
SQL.ADD("  and  T.Fecha1    = "~IdxDate2(Val(z:2)))
SQL.ADD("  and  T.Fecha2    = "~IdxDate2(Val(z:3)))
SQL.ADD("  and  T.Vehiculo1 = '"~Val(z:6)~"' ")
SQL.ADD("  and  T.RB2 = 0 ")
SQL.ADD("  and  T.RB1 > 0 ")
If Not CeldaVacia(z:5)
  SQL.ADD("  and  T.Mercado1  = '"~Val(z:5)~"' ")
Endif
SQL.ADD(" order by T.Cliente1, T.NrTrans, T.Mercado1, CU.Especie1 ")

Recorrer SQL
  if Incluido(fbn('Cambio5'),Val(sl:4))
    DFA
    SCN(z:10, 1)
    ACT(bb:Val(z:10), fbn('Mercado1'))
    ACT(bc:Val(z:10), fbn('Cliente1'))
    ACT(bd:Val(z:10), fbn('Especie1'))
    ACT(be:Val(z:10), fbn('Especie2'))
    ACT(bf:Val(z:10), fbn('NrTrans'))
    if Vacio(fbn('Cuenta2'))
      ACT(bi:Val(z:10), SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente1')~"' AND Mercado='"~fbn('Mercado1')~"' AND Estado='HAB' AND (Especies LIKE '"~fbn('Especie2')~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') "))
    else
      ACT(bi:Val(z:10), fbn('Cuenta2'))
    endif
    ACT(bj:Val(z:10), fbn('Cuenta5'))
    ACT(bv:Val(z:10), fbn('Mercado1'))
    ACN(bl:Val(z:10), fbn('Cantidad9')) 
    ACN(bm:Val(z:10), fbn('Cantidad10'))
    ACN(bn:Val(z:10), fbn('Cantidad11'))
    ACN(bo:Val(z:10), fbn('Cambio5'))
  else
    SCN(z:8, 1)
    ACN(a:fac, 1)
    ACT(b:fac, fbn('Mercado1'))
    ACT(c:fac, fbn('Cliente1'))
    ACT(d:fac, fbn('Especie1'))
    ACT(e:fac, fbn('Especie2'))
    ACT(f:fac, fbn('NrTrans'))
    ACT(g:fac, fbn('NrOperacionRef1'))
    ACT(h:fac, fbn('Cuenta1'))
    ACT(i:fac, SQL(" Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~Val(c:fac)~"' AND Mercado='"~Val(b:fac)~"' AND Estado='HAB' AND (Especies LIKE '"~Val(e:fac)~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') "))
    ACT(j:fac, fbn('Cuenta5'))
    ACT(CR:fac, fbn('Cliente2'))
    ACN(n:fac, fbn('CUCantidad4'))
    ACN(o:fac, fbn('CUCantidad1'))
    ACN(p:fac, fbn('Cantidad3'))
    ACN(q:fac, fbn('CUCantidad2'))
    ACN(r:fac, fbn('CUCantidad3'))
    ACN(s:fac, fbn('Cambio4'))
    ACT(u:fac, fbn('RazonSocial'))
    ACT(v:fac, fbn('Mercado1'))
* FJL 18/12/21 - Se Traen datos Comisiones
    ACN(ad:fac, fbn('Cantidad9')) 
    ACN(ae:fac, fbn('Cantidad10'))
    ACN(af:fac, fbn('Cantidad11'))
    ACN(ag:fac, fbn('Cambio5'))
** FJL 25/8/22 - Se agrgan Comisiones CV
    ACN(ah:fac, fbn('Cantidad12')+fbn('Cantidad14'))
    ACN(ai:fac, fbn('Cantidad13')+fbn('Cantidad15'))
** FJL 26/8/22 - Se agrga Estado
    if fbn('Cambio5')>201
      ACN(aj:fac, fbn('Cambio5')-100)
    else
      ACN(aj:fac, fbn('Cambio5'))
    endif
    ACT(ak:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(aj:fac)))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
    ACN(y:fac, 0)
    if Incluido(Val(ag:fac),Val(sl:3))
      ACN(y:fac, 1)
    endif
  endif
Proximo

If Val(z:8) <= 0
  MessageBox('No se registran Canjes de Saldos y Movimientos pendientes de Confirmacion.')
Else
  CrearListBox ; 'Arial,8,';'Confirmacion Canje '~Val(NM:1)~' (ISIN: '~Val(IS:1)~') - SALDOS Y MOVPENDIENTES'
    'Transaccion'   ;f:1..f:fac;NO;;;70;STRING;;RGB(220,220,193)
    'Cliente'       ;u:1..u:fac;NO;;;90;STRING;;RGB(220,220,193)
    'Mercado'       ;b:1..b:fac;NO;;;60;STRING;;RGB(220,220,193)
    'Ok?'           ;a:1..a:fac;NO;;;40;CHECK ;RGB(255,255,193);;;;;;;;SI
    'Cant.a Canjear';n:1..n:fac;NO;;;90;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Rel.Org.'      ;q:1..q:fac;NO;;;60;NUMERO;'###,###.####' ;RGB(220,220,193)
    'Especie Dest.' ;d:1..d:fac;NO;;;65;STRING;               ;RGB(220,220,193)
    'Rel.Dest.'     ;r:1..r:fac;NO;;;60;NUMERO;'###,###.####' ;RGB(220,220,193)
    'Cant.Dest.'    ;o:1..o:fac;NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Fraccion'      ;e:1..e:fac;NO;;;65;STRING;               ;RGB(220,220,193)
    'Valor'         ;s:1..s:fac;NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Importe'       ;p:1..p:fac;NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Cta.Origen'    ;h:1..h:fac;NO;;;80;STRING;;RGB(220,220,193)
    'Cta.Destino'   ;i:1..i:fac;SI;;;80;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';" Cliente='"~Val(c:FLB)~"' AND Mercado='"~Val(b:FLB)~"' AND Estado='HAB' AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') ";RGB(255,255,193)
    'Cta.Fraccion'  ;j:1..j:fac;SI;Val(a:flb)=0 o Val(p:flb)=0 o ClienteCuenta(Val(c:FLB),Val(j:FLB),Val(e:FLB));'Cta.Fraccion Invalida';80;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';"'"~Val(c:FLB)~"'=Cliente AND 'HAB'=Estado AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%MONEDA%') ";RGB(255,255,193);IIF(Eqstr(Val(c:FLB),Val(vh:1)), SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE '"~Val(c:FLB)~"'=Cliente AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%MONEDA%') AND 'HAB'=Estado AND '"~Val(cr:FLB)~"'=Comitente "),Val(j:FLB) ) ;NO;NO;'14';;;;SI
* FJL 18/12/21 - Se Traen datos Comisiones
    'Val.Can.a Canjear';ad:1..ad:fac;NO;;;90;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'Comision'      ;ae:1..ae:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'IVA'           ;af:1..af:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 25/8/22 - Se agrgan Comisiones CV
    'Comision CV'   ;ah:1..ah:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'IVA Com CV'    ;ai:1..ai:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 26/8/22 - Se agrga Estado
    'Estado'        ;ak:1..ak:fac;NO;;;100;STRING;;RGB(220,220,193)
  FinListBox
  If Not Ok
    Cancelar
  Endif
   
  ACT(xx:1, '')
  Recorrer&i 1,fac
     If Val(a:&i) = 1
        If Not Eqstr(Val(xx:1), Val(f:&i))
           SQL.ADD("update "~DBO~".TRANSACCIONES2 ")
           SQL.ADD("   set Cuenta2 = '"~Val(i:&i)~"', ")
           SQL.ADD("       Cuenta5 = '"~Val(j:&i)~"', ")
           SQL.ADD("       Fecha3  = '"~IdxDate(FSys)~"', ")
           SQL.ADD("       RB2     = '1' ")
           SQL.ADD(" where NrTrans = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.EXEC
           
           SQL.ActualizarMovimientosT2(Val(f:&i),SI,NO,NO,SI)
           SQL.EXEC
*-------------------
           #ifdef BIND
               SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, SUM(Cantidad) Cantidad, SUM(Comision) Comision, SUM(Iva) Iva ")
               SQL.ADD(" FROM ( ")        
               SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, ")
                    SQL.ADD("CASE WHEN M.NrGrupo=2 Then Sum(Cantidad) ELSE 0 End Cantidad, ")
                    SQL.ADD("CASE WHEN M.NrGrupo in(41,51) Then Sum(Abs(Cantidad)) ELSE 0 End Comision, ")
                    SQL.ADD("CASE WHEN M.NrGrupo in(42,52) Then Sum(Abs(Cantidad)) ELSE 0 End Iva ")
                    SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M ")
                    SQL.ADD(" WHERE NrOperacion='"~Val(f:&i)~"' ")
                    SQL.ADD("   AND "~DBO~".DesciendeDeEspecie(M.Especie,'MONEDA') = 1 ")
                    SQL.ADD("   AND Mercado='"~VAR('MERCADOBT')~"' ")
                    SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado, NrGrupo ")
               SQL.ADD(" ) ACCIONES ")        
               SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado ")        
               watch(SQL.BATCH())   

               Recorrer SQL
                  (.'PAGOACCION'.)
               Proximo
           #endif        
        Endif
        Message('Transaccion: '~Val(f:&i)~' Especie: '~Val(d:&i)~' confirmada.')
        ACT(xx:1, Val(f:&i))
     Endif
  Proximo

  if Val(z:10)>0
    recorrer&i 1,Val(z:10)
      SQL.ADD("update "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("   set Cuenta2 = '"~Val(bi:&i)~"', ")
      SQL.ADD("       Fecha3  = '"~IdxDate(FSys)~"', ")
      SQL.ADD("       RB2     = '1' ")
      SQL.ADD(" where NrTrans = '"~Val(bf:&i)~"' ")
      SQL.NEW
      SQL.EXEC
           
      SQL.ActualizarMovimientosT2(Val(bf:&i),SI,NO,NO,SI)
      SQL.EXEC
*      messageBox('Transaccion: '~Val(bf:&i)~' Especie: '~Val(bd:&i)~' confirmada.')
    Proximo
  EndIf
EndIf

ACN(FI:1,fac+1)

* FJL 03/11/2021 Saco los pagos de Posiciones
IF NO
    ***--- POSICIONES
    SQL.ADD(" Select DISTINCT  T.Mercado1, T.Cliente1, CU.Especie1, T.Especie2, T.NrTrans, ")
    SQL.ADD(" T.NrOperacionRef1, T.Cuenta1, T.Cuenta2, T.Cuenta5, T.Cuenta6, ")
    SQL.ADD(" CU.Cantidad4 CUCantidad4, CU.Cantidad1 CUCantidad1, T.Cantidad3, CU.Cantidad2 CUCantidad2, CU.Cantidad3 CUCantidad3, T.Cambio4, ")
    SQL.ADD(" T.Cliente2, T.Book1, C.RazonSocial ")
    SQL.ADD(" From  "~DBO~".TRANSACCIONES2 T, "~DBO~".CUOTAS CU, "~DBO~".CLIENTES C ")
    SQL.ADD(" where T.TipoTr2   = 'CANJE' ")
    SQL.ADD("  and  T.NrTrans   = CU.NrOperacion ")
    SQL.ADD("  and  T.Cliente1  = C.Codigo ")
    SQL.ADD("  and  T.Especie   = '"~Val(z:1)~"' ")
    SQL.ADD("  and  T.Fecha1    = "~IdxDate2(Val(z:2)))
    SQL.ADD("  and  T.Fecha2    = "~IdxDate2(Val(z:3)))
    SQL.ADD("  and  T.Vehiculo1 = '"~Val(z:6)~"' ")
    SQL.ADD("  and  T.RB2 = 0 ")
    SQL.ADD("  and  T.RB1 = 0 ")
    If Not CeldaVacia(z:5)
      SQL.ADD("  and  T.Mercado1  = '"~Val(z:5)~"' ")
    Endif
    SQL.ADD(" order by T.Cliente1, T.NrTrans, T.Mercado1, CU.Especie1 ")

    ACN(z:8,fac)

    Recorrer SQL
      SCN(z:8,1)
      ACN(z:9,1)
      ACN(a:fac,1)
      ACT(b:fac,fbn('Mercado1'))
      ACT(c:fac,fbn('Cliente1'))
      ACT(d:fac,fbn('Especie1'))
      ACT(e:fac,fbn('Especie2'))
      ACT(f:fac,fbn('NrTrans'))
      ACT(g:fac,fbn('NrOperacionRef1'))
      ACT(h:fac,fbn('Cuenta1'))
      ACT(i:fac,SQL(" Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~Val(c:fac)~"' AND Mercado='"~Val(b:fac)~"' AND Estado='HAB' AND (Especies LIKE '"~Val(e:fac)~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') "))
      ACT(j:fac,fbn('Cuenta5'))
      ACT(k:fac,fbn('Book1'))
      ACT(CR:fac,fbn('Cliente2'))
      ACN(n:fac,fbn('CUCantidad4'))
      ACN(o:fac,fbn('CUCantidad1'))
      ACN(p:fac,fbn('Cantidad3'))
      ACN(q:fac,fbn('CUCantidad2'))
      ACN(r:fac,fbn('CUCantidad3'))
      ACN(s:fac,fbn('Cambio4'))
      ACT(u:fac,fbn('RazonSocial'))
      ACT(v:fac,fbn('Mercado1'))
    Proximo

    If Val(z:9) = 0
       Cancelar('No se registran Canjes de Posiciones pendientes de Confirmacion.')
    Endif

    CrearListBox ; 'Arial,8,';'Confirmacion Canje '~Val(NM:1)~' (ISIN: '~Val(IS:1)~') - POSICIONES'
     'Transaccion'  ;f:Val(FI:1)..f:Val(z:8);NO;;;70;STRING;;RGB(220,220,193)
     'Cliente'      ;u:Val(FI:1)..u:Val(z:8);NO;;;90;STRING;;RGB(220,220,193)
     'Mercado'      ;b:Val(FI:1)..b:Val(z:8);NO;;;60;STRING;;RGB(220,220,193)
     'Book'         ;k:Val(FI:1)..k:Val(z:8);NO;;;60;STRING;;RGB(220,220,193)
     'Ok?'          ;a:Val(FI:1)..a:Val(z:8);SI;;;40;CHECK ;RGB(255,255,193);;;;;;;;SI
     'Cant.Org.'    ;n:Val(FI:1)..n:Val(z:8);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
     'Rel.Org.'     ;q:Val(FI:1)..q:Val(z:8);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
     'Especie'      ;d:Val(FI:1)..d:Val(z:8);NO;;;65;STRING;               ;RGB(220,220,193)
     'Rel.Dest.'    ;r:Val(FI:1)..r:Val(z:8);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
     'Cant.Dest.'   ;o:Val(FI:1)..o:Val(z:8);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
     'Fraccion'     ;e:Val(FI:1)..e:Val(z:8);NO;;;65;STRING;               ;RGB(220,220,193)
     'Valor'        ;s:Val(FI:1)..s:Val(z:8);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
     'Importe'      ;p:Val(FI:1)..p:Val(z:8);NO;;;80;NUMERO;'##,###,###.##';RGB(220,220,193)
     'Cta.Origen'   ;h:Val(FI:1)..h:Val(z:8);NO;;;80;STRING;;RGB(220,220,193)
     'Cta.Destino'  ;i:Val(FI:1)..i:Val(z:8);SI;;;80;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';" Cliente='"~Val(c:FLB)~"' AND Mercado='"~Val(b:FLB)~"' AND Estado='HAB' AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') ";RGB(255,255,193)
     'Cta.Fraccion' ;j:Val(FI:1)..j:Val(z:8);SI;Val(a:flb)=0 o Val(p:flb)=0 o ClienteCuenta(Val(c:FLB),Val(j:FLB),Val(e:FLB));'Cta.Fraccion Invalida';80;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';"'"~Val(c:FLB)~"'=Cliente AND 'HAB'=Estado AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%MONEDA%') ";RGB(255,255,193);IIF(Eqstr(Val(c:FLB),Val(vh:1)), SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE '"~Val(c:FLB)~"'=Cliente AND (Especies LIKE '"~Val(e:FLB)~"%' OR Especies LIKE '%MONEDA%') AND 'HAB'=Estado AND '"~Val(cr:FLB)~"'=Comitente "),Val(j:FLB) ) ;NO;NO;'14';;;;SI
    FinListBox

    If Not Ok
      Cancelar
    Endif

    ACT(xx:1, '')

    Recorrer&i Val(FI:1),Val(z:8)
      If Val(a:&i) = 1
         If Not Eqstr(Val(xx:1), Val(f:&i))
            SQL.ADD("update "~DBO~".TRANSACCIONES2 ")
            SQL.ADD(" set Cuenta2 = '"~Val(i:&i)~"', ")
            SQL.ADD("     Cuenta5 = '"~Val(j:&i)~"', ")
            SQL.ADD("     RB2 = '1' ")
            SQL.ADD(" where NrTrans = '"~Val(f:&i)~"' ")
            SQL.NEW
            SQL.EXEC
            
            SQL.ActualizarMovimientosT2(Val(f:&i),NO,NO,NO,SI)
            SQL.EXEC
         Endif
         
         message('Transaccion: '~Val(f:&i)~' Especie: '~Val(d:&i)~' confirmada.')
         ACT(xx:1, Val(f:&i))
      Endif
    Proximo
ENDIF
