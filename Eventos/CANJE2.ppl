CrearDialogo
  Especie1 :'Especie'    ;1;1;;;;NoVacio(Dialogo.Especie1) y Not DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una Especie valida'   ;NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
  Fecha1   :'Record Date';1;2;;;;Dialogo.Fecha1<>0;'Debe ingresar un Record Date valido';NO;FSys
  Fecha2   :'Fecha Pago' ;2;2;;;;Dialogo.Fecha2<>0;'Debe ingresar una Fecha valida'     ;NO;FSys
  Mercado1 :'Mercado'    ;2;1;;;;
  Vehiculo1:'Vehiculo'   ;3;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el vehiculo';NO;VAR('VEHICULODE')
  Operador1:'Operador'   ;4;1;;NO;;NoVacio(Dialogo.Operador1);'Debe Ingresar el Operador';NO;USUARIOACTIVO
  Check1   :'Impacta SE' ; ; ; ;  ;  ;;;;0;
  Check2   :'Interfase'  ; ; ; ;NO;NO;;;;1;
FinDialogo

If Not Ok
  Cancelar
Endif

