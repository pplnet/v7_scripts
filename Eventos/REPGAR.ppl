*- REPGAR: REPOSICION de Garantias
HojaVisible(NO)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Fecha1     : "Fecha   "   ;;;;NO;;;;;Fsys;
  Especie1   : "Especie"    ;;;;;;;;;;;;;
  Cliente1   : "Cliente"    ;;;;;;;;;;
  Mercado1   : "Mercado"    ;;;;;;;;;;
  Lista1     : 'Estados'    ;;;;;;;;;;;SQLSet("Select Descripcion from "~DBO~".ESTADOSCUSTODIA where Habilitado='SI' and Codigo<>'"~VAR('SALLIBRECU')~"' Order By Jerarquia" );NO
FinDialogo

If Not Ok
  Cancelar
EndIf

* Veo solamente los tipos seleccionados
SetListaClaves(2)

act(az1,Dialogo.Lista1)
    
***If Vacio(Dialogo.Lista1)
***   act(az1,SQLSet("Select Descripcion from "~DBO~".ESTADOSCUSTODIA where Habilitado='SI' and Codigo<>'"~VAR('SALLIBRECU')~"' Order By Jerarquia" ))
***EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

*--- Recupero los Saldos por Estado para un Cliente
SQL.ADD("Select DISTINCT S.*, E.Descripcion,Es.InteresesC,T.Especie1 as Cotiza  ")
SQL.ADD("From "~DBO~".SALDOS S,"~DBO~".ESPECIES Es, "~DBO~".ESTADOSCUSTODIA E,"~DBO~".TRANSACCIONES2 T ")
SQL.ADD("Where S.NrSaldo=E.NrSaldo+100   ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and S.Cliente='"~Dialogo.Cliente1~"'  ")
EndIf 
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and S.Especie='"~Dialogo.Especie1~"'  ")
EndIf 
SQL.ADD("and Es.Codigo=S.Especie ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and S.Mercado='"~Dialogo.Mercado1~"'  ")
EndIf 
SQL.ADD(" and S.EnteCustodia='"~Dialogo.Vehiculo1~"'  ")
SQL.ADD(" and S.Saldo <> 0  ")
SQL.ADD(" and T.TipoTr2='"~Var('CAMEST')~"'   ")
SQL.ADD(" and T.RB2='1' ")
SQL.ADD(" and T.Vehiculo1=S.EnteCustodia ")
SQL.ADD(" and T.Especie=S.Especie        ")
SQL.ADD(" and T.Cliente1 =S.Cliente      ")
SQL.ADD(" and T.Cuenta1  =S.Cuenta       ")
SQL.ADD(" and T.Fecha1  <='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(" and T.CB1='0' and T.Cantidad2=S.NrSaldo ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and E.Descripcion In ("~Pipe2Comillas(VAL(az1))~")  ")
ENDIF
SQL.ADD(" Order by S.EnteCustodia,S.Cliente,S.NrSaldo")

ACN(w1,fac)
acn(mr1,0)
acn(fb1,0)

*- Por cada saldo verifico si tiene transacciones de CAMBIO DE ESTADO en Efectivo  que 
*- no sean por Reposicion
Recorrer SQL

   Message(FBN['Cliente']~' '~FBN['Especie']~' '~FBN['Mercado']~' '~Fstr(FBN['NrSaldo'],0,0) )

   If Not EqStr(val(z2)~Fstr(val(z3),0,0)~val(z1),FBN['Cliente']~Fstr(FBN['NrSaldo'],0,0)~FBN['Cotiza']) y val(mr2)<>0
      If Round(val(mr1),2)=0
         scn(fb1,-1)
      Else
         *- Listo a Partir de A los datos a reponer 
         act(b:val(fb1),val(z2) )
         acn(c:val(fb1),val(z3) )
         act(d:val(fb1),val(z4) )
         acn(e:val(fb1),val(mr1))
         act(f:val(fb1),val(z1) )
         act(g:val(fb1),BuscarCampo('CLIENTES','RazonSocial','Codigo',val(z2)))
         acn(h:val(fb1),Val(gr:1))
      EndIf
   EndIf

   Message('Suma de Bloqueos y desbloqueos '~Fstr(Val(mr1),1,0))

   *- Cuando cambia Vehiculo/Cliente/NrSaldo registro el monto a reponer
   If Not EqStr(val(z2)~Fstr(val(z3),0,0)~val(z1),FBN['Cliente']~Fstr(FBN['NrSaldo'],0,0)~FBN['Cotiza']) 
      act(z2,FBN['Cliente'] )
      acn(z3,FBN['NrSaldo'] )
      act(z4,FBN['Descripcion'] )
      act(z1,FBN['Cotiza'] )

      *- Cotizacion Por Moneda de Bloqueo
      ACN(ce1, COTIZACIONC(FBN['Especie'],,,,Dialogo.Fecha1-1,25,NO,FBN['Cotiza']))

      acn(mr1,0)
      acn(mr2,1)
      scn(fb1,1)
   EndIf 

   * --- recupera CAMEST Anteriores de efectivo --- *
   SQL.ADD("Select T.Especie1 as MonedaBloqueo,Sum(T.Precio3) Efectivo, Sum(T.Precio2) Cantidad,  ")
   SQL.ADD("M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta, SUM(T.Cantidad3) GReal ")
   SQL.ADD("From "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("Where M.NrOperacion=T.NrTrans and T.TipoTr2='"~Var('CAMEST')~"'   ")
   SQL.ADD(" and T.RB2='1' ")
   SQL.ADD(" and T.Vehiculo1='"~FBN['EnteCustodia']~"'    ")
   SQL.ADD(" and T.Especie  ='"~FBN['Especie']~"'         ")
   SQL.ADD(" and T.Cliente1 ='"~FBN['Cliente']~"'         ")
   SQL.ADD(" and T.Cuenta1  ='"~FBN['Cuenta']~"'          ")
   SQL.ADD(" and T.Fecha1  <='"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and T.Especie1  ='"~FBN['Cotiza']~"'         ")
   SQL.ADD(" and T.CB1='0' ")
   SQL.ADD(" and M.NrSaldo=T.Cantidad2  ")
   SQL.ADD(" and M.NrSaldo="~Fstr(FBN['NrSaldo'],0,0)~" ")
   SQL.ADD(" Group By T.Especie1,M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta ")
   SQL.ADD(" Order By M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta,T.Especie1 ")

   Recorrer SQL     
      Message('Camest Efectivo  ')
      Message('Efectivo  '~fbn('Efectivo')~' En '~fbn('MonedaBloqueo') )
      Message('Cantidad  '~fbn('Cantidad'))
      Message('GREAL  '~fbn('GReal'))

      *- ef1: Monto en Efectivo Revaluado 
      *- mr1: Monto a Revaluar (-: debo devolver +: debo agregar)

      * ef1 = ef4
      * ef2 = ef3
      * mr1 = mr2
      * ck1 = ck2

      *- gr1: garantia real que debe haber en CV
      acn(gr1,FBN['GReal'])

      * nominales x cot dirty
      acn(ef1,FBN['Cantidad']*val(ce1))
      acn(ef4,FBN['Cantidad']*val(ce1))

      * dif entre nominales valuados hoy y efectivo acumulado
      acn(ck1,(-val(ef1)+FBN['Efectivo']))
      acn(ck2,(-val(ef4)+FBN['GReal']))

      * Contra Garantia Entregada
      If val(ck1)<>0
         acn(ef2,val(ck1)/val(ce1))
         If val(ef2)<1 y val(ck1)<>0
            acn(ef1,Round(FBN['Cantidad']*val(ce1),2) )
         EndIf
      EndIf
      scn(mr1,-val(ef1)+FBN['Efectivo'])

      * Contra Garantia Exigida
      If val(ck2)<>0
         acn(ef3,val(ck2)/val(ce1))
         If val(ef3)<1 y val(ck2)<>0
            acn(ef4,Round(FBN['Cantidad']*val(ce1),2) )
         EndIf
      EndIf
      scn(mr2,-val(ef4)+FBN['GReal'])
   Proximo 

   *- Descuento las Reposiciones Efectuadas 
   SQL.ADD("Select T.Especie1 as MonedaBloqueo,Sum(T.Precio3) Efectivo ,Sum(T.Precio2) Cantidad,  ")
   SQL.ADD("M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta ")
   SQL.ADD("From "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("Where M.NrOperacion=T.NrTrans and T.TipoTr2='"~Var('CAMEST')~"'   ")
   SQL.ADD(" and T.RB2='1' ")
   SQL.ADD(" and T.Vehiculo1='"~FBN['EnteCustodia']~"'  ")
   SQL.ADD(" and T.Especie='"~FBN['Especie']~"'         ")
   SQL.ADD(" and T.Cliente1='"~FBN['Cliente']~"'        ")
   SQL.ADD(" and T.Cuenta1='"~FBN['Cuenta']~"'          ")
   SQL.ADD(" and T.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and T.CB1='1' ")
   SQL.ADD(" and T.Especie1  ='"~FBN['Cotiza']~"'        ")
   SQL.ADD(" and M.NrSaldo=T.Cantidad2  ")
   SQL.ADD(" and M.NrSaldo="~Fstr(FBN['NrSaldo'],0,0)~" ")
   SQL.ADD(" Group By T.Especie1,M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta ")
   SQL.ADD(" Order By M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta,T.Especie1 ")

   Recorrer SQL     

     Message('Reposiciones')
     Message('Efectivo  '~fbn('Efectivo'))
     Message('Cantidad  '~fbn('Cantidad'))

      scn(mr1,-FBN['Cantidad']*val(ce1)) 
      scn(mr2,-FBN['Cantidad']*val(ce1)) 
   Proximo 

   Message('Descuento las Reposiciones Efectuadas '~Fstr(Val(mr1),1,2))

   *- Descuento los Desbloqueos (Viene con Saldo Negativo)
   SQL.ADD("Select Sum(T.Precio3) Efectivo ,Sum(T.Precio2) Cantidad,  ")
   SQL.ADD("M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta ")
   SQL.ADD("From "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("Where M.NrOperacion=T.NrTrans and T.TipoTr2='"~Var('CAMEST')~"'   ")
   SQL.ADD(" and T.RB2='1' ")
   SQL.ADD(" and T.RB3='1' ")
   SQL.ADD(" and T.Vehiculo1='"~FBN['EnteCustodia']~"'  ")
   SQL.ADD(" and T.Especie='"~FBN['Especie']~"'         ")
   SQL.ADD(" and T.Cliente1='"~FBN['Cliente']~"'        ")
   SQL.ADD(" and T.Cuenta1='"~FBN['Cuenta']~"'          ")
   SQL.ADD(" and T.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and T.Especie1  ='"~FBN['Cotiza']~"'       ")
   SQL.ADD(" and T.CB1='1' ")
   SQL.ADD(" and M.NrSaldo=T.Cantidad1  ")
   SQL.ADD(" and M.NrSaldo="~Fstr(FBN['NrSaldo'],0,0)~" ")
   SQL.ADD(" Group By T.Especie1,M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta ")
   SQL.ADD(" Order By M.Cliente,M.Especie,M.Mercado, M.EnteCustodia,M.NrSaldo,M.Cuenta,T.Especie1 ")

   Recorrer SQL     

      Message('Desbloqueos')
      Message('Efectivo  '~fbn('Efectivo'))
      Message('Cantidad  '~fbn('Cantidad'))

      scn(mr1,FBN['Cantidad']*val(ce1)) 
      scn(mr2,FBN['Cantidad']*val(ce1)) 
   Proximo 

   * Message('Descuento los Desbloqueos (Viene con Saldo Negativo) '~Fstr(Val(mr1),1,2))
Proximo 

*- Completo el Ultimo Registro
* mr1 contra garantia entregada 1500000
* mr2 contra garantia exigida   1000000

If Round(val(mr1),2)=0
   * no hubo cambios de cotizacion
   scn(fb1,-1)
Else
   *- Listo a Partir de A los datos a reponer 
   act(b:val(fb1),val(z2) )
   acn(c:val(fb1),val(z3) )
   act(d:val(fb1),val(z4) )
   **   acn(e:val(fb1),val(mr1))
   act(f:val(fb1),val(z1) )
   act(g:val(fb1),BuscarCampo('CLIENTES','RazonSocial','Codigo',val(z2)))
   acn(h:val(fb1),Val(gr:1))
   If Val(mr2)>0 o Val(mr1)<0
      If Val(mr2)>0 
         * mr2>0-> Falta en la garantia exigida
         acn(e:val(fb1),val(mr2))
      Endif
      If Val(mr1)<0
         * mr1<0-> Supera garantia entregada
         acn(e:val(fb1),val(mr1))
      Endif
   Else
      * Hubo Cambios pero no es necesario hacer los movimientos
      * No hay menos de la garantia exigida, ni mas de la entregada.
*      messagebox('No se hacen movimientos')
      scn(fb1,-1)
   Endif
*   messagebox('Garantia Entregada  '~Val(mr1))
*   messagebox('Garantia Exigida    '~Val(mr2))
EndIf

If val(fb1)<=0
   MessageBox(' No se encontraron Saldos a REPONER !!! ')
Else 
   *- Muestro todos los datos 
   CrearListBox ; 'Arial,8,';'Montos de Reposicion' 
      'Marca'           ; a1..a:Val(fb1);SI;SI;'Error'; 30;CHECK;RGB(220,220,193)
      'Cliente'         ; b1..b:Val(fb1);NO;SI;'Error'; 80;STRING;;RGB(180,180,193)
      'Nombre'          ; g1..g:Val(fb1);NO;SI;'Error';140;STRING;;RGB(180,180,193)
      'Estado '         ; d1..d:Val(fb1);NO;SI;'Error';140;STRING;;RGB(180,180,193)
      'A Reponer'       ; e1..e:Val(fb1);NO;SI;'Error'; 80;NUMERO;'###,###,###,###.##';RGB(180,180,193)
      'Moneda'          ; f1..f:Val(fb1);NO;SI;'Error'; 80;STRING;;RGB(180,180,193)
      'Garantia'        ; h1..h:Val(fb1);NO;SI;'Error'; 80;NUMERO;'###,###,###,###.##';RGB(180,180,193)
   FinListBox

   IF Not Ok
      Cancelar
   ENDIF

   Recorrer&j 1,val(fb1)
      IF Val(a:&j)=1 
         If val(e:&j)>0 
            *- Bloqueo
            acn(ab3,0)
         Else 
            *- Desbloqueo
            acn(ab3,1)
         EndIf
         ***---EjecutarEvento('BLSALD',Fecha1=FSys,Radio4=2,Cliente1=val(b:&j),Especie1='',Vehiculo1=Dialogo.Vehiculo1,Radio2=1,Radio1=-1, Radio3=val(ab3) ,ListaTabla3='',Cantidad1=val(e:&j),Entero1=val(c:&j),Especie2=val(f:&j),Cantidad2=val(h:&j))
         EjecutarEvento('BLSAFV',Fecha1=FSys,Radio4=2,Cliente1=val(b:&j),Especie1='',Vehiculo1=Dialogo.Vehiculo1,Radio2=1,Radio1=-1, Radio3=val(ab3) ,ListaTabla3='',Cantidad1=val(e:&j),Entero1=val(c:&j),Especie2=val(f:&j),Cantidad2=val(h:&j))
      EndIf
   Proximo
EndIf
