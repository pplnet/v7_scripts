*HOJAVISIBLE(SI)
CrearDialogo
  NrOperacion1 : "Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Precio1      : "Cotizacion";;;;;;
  Fecha1       : "Fecha"     ;2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Dialogo.Fecha1
FinDialogo
if Not Ok
  Cancelar
endif

If Not Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TICO|TICT|TIDE|TIPO|')
   Cancelar('La operacion  '~Dialogo.NrOperacion1~' No tiene Intereses en Titulos')
endif

If Ok
   SQL.ADD("Select TotalIntereses,TipoOp,Cuenta1,Cliente3,FechaVto,Vehiculo1,'1' as Tipo,0 as NrCuota from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and ((FechaVto  = '"~IdxDate(habiles(Dialogo.Fecha1,1,'ARG'))~"'  and FechaVto2 is null) or (FechaVto  = '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto2 > FechaVto and  CB2=1)) ")   
   SQL.ADD(" AND (CB8 Is Null or CB8='' or CB8='0') ")
IF NO
   * FO 07/02/2006
   * El interes se paga tomando el campo TotalInteres de la op * Cotizacion dirty 
   * El interes de al op esta en nominales
   SQL.ADD("Union ")
   SQL.ADD("Select CU.Cantidad2 as TotalIntereses,O.TipoOp,O.Cuenta1,O.Cliente3,CU.Fecha1 as FechaVto,O.Vehiculo1,'2' as Tipo,CU.NrCuota  ")
   SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS CU ")
   SQL.ADD("Where O.NrOperacion = '"~Dialogo.NrOperacion1~"' and O.NrOperacion=CU.NrOperacion and (CU.Precio1=0 or CU.Precio1 Is Null)  ")
   SQL.ADD("and CU.Fecha1='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND (O.CB8 Is Null or O.CB8='' or O.CB8='0')")
   SQL.ADD("and O.TipoOp In ('TICO','TIPO') ")
ENDIF

   Recorrer SQL
     *** Toma la cotizacion de la especie z1 ***
     ACN(z1,Dialogo.Precio1)

     *** Calcula el interes en pesos z5 ***
     ACN(z5,Round(FBN['TotalIntereses']*Val(z1),2))

*     If EqStr(FBN['Tipo'],'1')
        *** Modifico la Operacion ****
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set Precio2    = "~FStr(Val(z1),0,7)~",  ")
        SQL.ADD("TotalBrutoCli3 =  "~FStr(Val(z5),0,4)~",  ")
        SQL.ADD("PorCaucion     =  "~FStr(Val(z2),0,4)~",  ")
        SQL.ADD("TotalGanancias =  "~FStr(Val(z3),0,4)~",  ")
        SQL.ADD("TotalNetoCli3  =  "~FStr(Val(z8),0,4)~",  ")
        SQL.ADD("CB8 = 1 ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC
*     Else 
*        *** Modifico la Cuota
*        SQL.ADD("Update "~DBO~".CUOTAS ")
*        SQL.ADD("Set Precio2    = "~FStr(Val(z1),0,7)~",  ")
*        SQL.ADD("    Precio1   =  "~FStr(Val(z5),0,4)~"   ")
*        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and NrCuota="~Fstr(FBN['NrCuota'],0,0)~"")
*        SQL.NEW
*        SQL.EXEC
*     EndIf

     SQL.ActualizarMovimientos4(Dialogo.NrOperacion1,SI,NO,NO,NO,NO,NO)
     SQL.EXEC
   Proximo
endif
