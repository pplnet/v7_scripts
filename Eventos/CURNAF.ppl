* CURNAF - Actualizacion de Pr.Nafta Curva
HojaVisible(No)
CrearDialogo
   Especie1 : 'Especie'       ;;;;;;;;;'NAFTA';;;;;;
   String1  : 'Path'        ;;;;;;;;;VAR('DIRDEFAULT')
FinDialogo

If Not Ok
   Cancelar
EndIf

Message('*-- Importacion de Datos de '~Dialogo.Especie1)
ImportarWKS(a1..d:100,a1..d:100,Dialogo.String1~Dialogo.Especie1~'.WKS')

ACT(z6,BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',Dialogo.Especie1)) )

Recorrer&i 1,100

     If Vacio(val(a:&i))
        Break
     EndIf

     *- Recupero los dias de la curva de futuros desde fecha de contrato 
     *-  hasta la del siguiente contrato
     ACN(z1,DifDias(val(b:&i),val(a:&i),VAL(Z6),SI)+1 )
     ACD(z4,val(a:&i))

     Recorrer&j 1,VAL(z1)
        Message("  Actualizando Precio "~Fstr(val(c:&i),0,2)~"/"~Fstr(val(d:&i),0,2)~" al "~VAL(z4)~" ...")
  
        * Verifico si Existe el dia en la curva, sino lo creo
        *- a: FDesde b:FHasta c:PrecioFut d:PrecioCont
        IF SQL("SELECT Count(*) FROM "~DBO~".CURVAFUTUROSCOMM Where Especie='"~Dialogo.Especie1~"' and Fecha='"~IdxDate(VAL(z4))~"' ")=1
           SQL.ADD("UPDATE "~DBO~".CURVAFUTUROSCOMM Set PrecioFut="~Fstr(VAL(c:&i),0,7)~",PrecioCon="~Fstr(VAL(d:&i),0,7)~" Where ")
           SQL.ADD("Especie='"~Dialogo.Especie1~"' and ")
           SQL.ADD("Fecha='"~IdxDate(VAL(z4))~"' ")           
        Else 
           SQL.ADD(" INSERT "~DBO~".CURVAFUTUROSCOMM ")
           SQL.ADD(" (Especie,Fecha,PrecioFut,PrecioCon) ")
           SQL.ADD(" Values ")
           SQL.ADD(" ('"~Dialogo.Especie1~"','"~IdxDate(VAL(z4))~"',"~Fstr(VAL(c:&i),0,7)~","~Fstr(VAL(d:&i),0,7)~") ")
        EndIf

        SQL.NEW
        SQL.EXEC 

        ACD(z4,HABILES(VAL(z4),1,VAL(Z6),SI))
     Proximo
Proximo

MessageBox('Actualizacion Finalizada !!!')
