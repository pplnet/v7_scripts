   'Operador'      ;k1..k:FAC;NO;;;70;STRING

  FinListBox

  if Ok 
    Recorrer&i 1,fac
      if Val(l:&i)=0

        *********** Renueva ***********

         if Not Eqstr(Val(c:&i),'MMPFCE')

            CrearDialogo:6
               TipoOp1       : 'Tipo Op'           ;1;1;;NO;;;;;Val(c:&i)
               NrOperacion1  : 'NrOperacion'       ;1;2;;NO;;;;;Val(h:&i)
               Especie1      : 'Especie'           ;2;1;;NO;;;;;Val(b:&i)
               Cliente1      : 'Cliente'           ;3;1;;NO;;;;;Val(a:&i)
               Fecha1        : 'Fecha Op'          ;2;2;;NO;;;;;IIF(Val(l:&i)= 0,Val(n:&i),Fsys)
               Entero1       : 'Plazo'             ;3;2; ;  ;;Dialogo.Entero1>0;'El plazo debe ser mayor que cero';NO;1;Dialogo.Fecha2-Dialogo.Fecha1
               Fecha2        : 'Fecha Vto'         ;4;2; ;  ;;ESHABIL(Dialogo.Fecha2,'ARG') Y [ESHABIL(Dialogo.Fecha2,'USA') O NOT EQSTR(Dialogo.Especie1,'USD') O NOT EQSTR(Dialogo.TipoOp1,'MMCA')];'No es un dia habil';NO;Dialogo.Fecha1+Dialogo.Entero1;Dialogo.Fecha1+Dialogo.Entero1;
               Cantidad1     : 'Cantidad'          ;4;1; ; ;;Dialogo.Cantidad1>0;'La Cantidad debe ser positiva';NO;IIF(EqStr(Val(c:&i),'MMPF'),Val(d:&i)+Val(f:&i)-Val(i:&i),Val(d:&i))
               Precio1       : 'Tasa (%)'          ; ; ; ; ;;Dialogo.Precio1>0 Y Dialogo.Precio1<=Dialogo.Precio2*(1+VAR('RTASA2')/100) Y Dialogo.Precio1>=Dialogo.Precio2*(1-VAR('RTASA2')/100);'La Tasa debe ser positiva y estar dentro del Rango: '~FSTR(Dialogo.Precio2*(1-VAR('RTASA2')/100),1,7)~' y '~FSTR(Dialogo.Precio2*(1+VAR('RTASA2')/100),1,7);NO;Val(e:&i)
               Precio3       : 'Plazo mas prox'    ;5;2; ;NO;NO;;;;;SQL("Select Min(ABS("~Dialogo.Entero1~"-PlazoHasta)) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"'");
               Precio4       : 'Fecha Tasa'        ;5;2; ;NO;NO;;;;;SQL("Select Max(Fecha) from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" ");
               *Precio2       : 'T.Base (%)'        ;6;1; ;Dialogo.Radio2=1;;Dialogo.Precio2>0;'La Tasa Base debe ser mayor que cero';NO;Val(m:&i);IIF(Dialogo.Radio2=0,SQL("Select Valor1 from "~DBO~".TASASDIA Where ((Especie='"~Dialogo.Especie1~"' and '"~Dialogo.Especie1~"'='ARP') or (Especie='USD' and '"~Dialogo.Especie1~"' in ('USD','USB'))) and TipoTasa='TRANSF' and  Fecha='"~IdxDate(Dialogo.Precio4)~"' and ABS("~Dialogo.Entero1~"-PlazoHasta)="~Dialogo.Precio3~" "),Dialogo.Precio2)
               Precio2       : 'Tasa de Transf.'   ;6;1; ;IIF(EqStr(VAR('CONTROLATT'),'SI'),SI,NO);;Dialogo.Precio2>0 Y [Dialogo.Precio2<=Dialogo.Precio7*(1+VAR('RTASA2')/100) Y Dialogo.Precio2>=Dialogo.Precio7*(1-VAR('RTASA2')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia Fuera de Rango: '~FSTR((Dialogo.Precio7*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((Dialogo.Precio7*(1+VAR('RTASA2')/100)),1,7);NO;IIF(MODI, Dialogo.Precio2, IIF(Eqstr(var('BASEXPILAR'), 'SI'), SQL("SELECT dbo.ObtenerTasaTransferencia("~IdxDate2(Dialogo.Fecha1)~",'"~SQL("Select Codigo from "~DBO~".TIPOSTASA WHERE TiposOperacion LIKE ('%"~Dialogo.TipoOp1~"|%')")~"','"~Dialogo.Especie1~"','"~Dialogo.Entero1~"')") + IIF(EqStr(VAR('CONTROLATT'),'SI'),Dialogo.Precio8,0), TASADIA('TRANSF',Dialogo.Especie1,Dialogo.Fecha1,Dialogo.Entero1,1)));IIF(MODI, Dialogo.Precio2, IIF(Eqstr(var('BASEXPILAR'), 'SI'), SQL("SELECT dbo.ObtenerTasaTransferencia("~IdxDate2(Dialogo.Fecha1)~",'"~SQL("Select Codigo from "~DBO~".TIPOSTASA WHERE TiposOperacion LIKE ('%"~Dialogo.TipoOp1~"|%')")~"','"~Dialogo.Especie1~"','"~Dialogo.Entero1~"')") + IIF(EqStr(VAR('CONTROLATT'),'SI'),Dialogo.Precio8,0), TASADIA('TRANSF',Dialogo.Especie1,Dialogo.Fecha1,Dialogo.Entero1,1)))
               Radio2        : 'Tipo T.base|Transferencia|Call';6;2;;Incluido(Val(c:&i),'MMAD|MMDES|MMPO');NO;;;;Val(j:&i);
               Cantidad2     : 'Interes'           ;7;1; ;NO;;;;NO;Val(f:&i);Dialogo.Cantidad1*Dialogo.Precio1*Dialogo.Entero1/36500;
***---         Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');;;;0
               Radio1        : 'Liq.|Compensa|Liquida';;;;Incluido(Val(c:&i),'MMCO|MMCT|MMPO|MMPF|MMPFCE');NO;;;;1


               * Control de Excepciones 
               Entero3       :  'RANGOTRANS'       ;2 ;3; ;NO;NO;[Dialogo.Precio2<=Dialogo.Precio7*(1+VAR('RTASA1')/100) Y Dialogo.Precio2>=Dialogo.Precio7*(1-VAR('RTASA1')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa de Transferencia Fuera de Rango: '~FSTR((Dialogo.Precio7*(1-VAR('RTASA1')/100)),1,7)~' y '~FSTR((Dialogo.Precio7*(1+VAR('RTASA1')/100)),1,7);SI;;IIF([Dialogo.Precio2<=Dialogo.Precio7*(1+VAR('RTASA1')/100) Y Dialogo.Precio2>=Dialogo.Precio7*(1-VAR('RTASA1')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'),0,1)
               Entero4       :  'RANGOTASA'        ;3 ;3; ;NO;NO;Dialogo.Precio1<=Dialogo.Precio2*(1+VAR('RTASA1')/100) Y Dialogo.Precio1>=Dialogo.Precio2*(1-VAR('RTASA1')/100);'Tasa Fuera de Rango: '~FSTR(Dialogo.Precio2*(1-VAR('RTASA1')/100),1,7)~' y '~FSTR(Dialogo.Precio2*(1+VAR('RTASA1')/100),1,7);SI;;IIF(Dialogo.Precio1<=Dialogo.Precio2*(1+VAR('RTASA1')/100) Y Dialogo.Precio1>=Dialogo.Precio2*(1-VAR('RTASA1')/100),0,1)
               Entero5       :  'FECHAVALOR'       ;4 ;3; ;NO;NO;Not (Dialogo.Fecha1<FSYS);'Es una Operacion Fecha Valor';SI;;IIF(Not Dialogo.Fecha1<FSYS,0,1)
               Entero6       :  'DFROMEXCE'        ;5 ;3; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Cliente1) o LimAsignado(Dialogo.Cliente1,'DFROM','USD',Dialogo.Vehiculo1) >= Dialogo.Cantidad5+LimConsumido(Dialogo.Cliente1,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1));'Due From Cliente excedido en U$D '~PYC(Dialogo.Cantidad5+LimConsumido(Dialogo.Book2,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1)-LimAsignado(Dialogo.Book2,'DFROM','USD',Dialogo.Vehiculo1),1,0)~'.-';SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Cliente1) o LimAsignado(Dialogo.Cliente1,'DFROM','USD',Dialogo.Vehiculo1) >= Dialogo.Cantidad5+LimConsumido(Dialogo.Cliente1,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1),0,1))
               Entero7       :  'DFROMNOAS'        ;6 ;3; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Cliente1) O ExisteLimite('DFROM',Dialogo.Cliente1,'USD',Dialogo.Vehiculo1));'Due From Cliente no asignado';SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Cliente1) o ExisteLimite('DFROM',Dialogo.Cliente1,'USD',Dialogo.Vehiculo1),0,1))
               Entero8       :  'RDATEVENC'        ;7 ;3; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Cliente1) o (SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Cliente1~"' AND Limite = 'DFROM'") >= Dialogo.Fecha1));'Due From Cliente vencido el '~Fecha(SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Cliente1~"' AND Limite = 'DFROM'"));SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Cliente1) o (SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Cliente1~"' AND Limite = 'DFROM'") >= Dialogo.Fecha1),0,1))
               Entero9       :  'DFROMEXCE'        ;8 ;3; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Book2) o LimAsignado(Dialogo.Book2,'DFROM','USD',Dialogo.Vehiculo1) >= Dialogo.Cantidad5+LimConsumido(Dialogo.Book2,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1));'Due From Controlante '~Dialogo.Book2~' excedido en U$D '~PYC(Dialogo.Cantidad5+LimConsumido(Dialogo.Book2,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1)-LimAsignado(Dialogo.Book2,'DFROM','USD',Dialogo.Vehiculo1),1,0)~'.-';SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Book2) o LimAsignado(Dialogo.Book2,'DFROM','USD',Dialogo.Vehiculo1) >= Dialogo.Cantidad5+LimConsumido(Dialogo.Book2,'DFROM','USD',-1,Dialogo.Vehiculo1,,,Dialogo.NrOperacion1),0,1))
               Entero10      :  'DFROMNOAS'        ;1 ;4; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Book2) O ExisteLimite('DFROM',Dialogo.Book2,'USD',Dialogo.Vehiculo1));'Due From Controlante '~Dialogo.Book2~' no asignado';SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Book2) o ExisteLimite('DFROM',Dialogo.Book2,'USD',Dialogo.Vehiculo1),0,1))
               Entero11      :  'RDATEVENC'        ;2 ;4; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),VACIO(Dialogo.Book2) o (SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Book2~"' AND Limite = 'DFROM'") >= Dialogo.Fecha1));'Due From Controlante vencido el '~Fecha(SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Book2~"' AND Limite = 'DFROM'"));SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF(VACIO(Dialogo.Book2) o (SQL("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Dialogo.Book2~"' AND Limite = 'DFROM'") >= Dialogo.Fecha1),0,1))
               Entero12      :  'TASATMOD'         ;3 ;4; ;NO;NO;[Dialogo.Precio2 = Dialogo.Precio7 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia: '~FSTR(Dialogo.Precio7,0,7)~'. Tasa Transferencia Modificada: '~FSTR(Dialogo.Precio2,0,7)~"'.";SI;;IIF([Dialogo.Precio2 = Dialogo.Precio7 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'),0,1)
               Entero13      :  'SPREADNEG'        ;4 ;4; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),[Dialogo.Precio1>=Dialogo.Precio2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'));'Spread Negativo: '~FSTR(Dialogo.Precio2-Dialogo.Precio1,0,7);SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCO'),IIF([Dialogo.Precio1>=Dialogo.Precio2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'),0,1))
               Entero14      :  'SPREADNEG'        ;5 ;4; ;NO;NO;IIF(EqStr(Dialogo.TipoOp1,'MMCT'),[Dialogo.Precio1<=Dialogo.Precio2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'));'Spread Negativo: '~FSTR(Dialogo.Precio1-Dialogo.Precio2,0,7);SI;;IIF(EqStr(Dialogo.TipoOp1,'MMCT'),IIF([Dialogo.Precio1<=Dialogo.Precio2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO'),0,1))
               
               * Variables para Excepciones
               Vehiculo1     :  'Vehiculo'         ;6 ;4; ;NO;NO;;;;;SQL("SELECT Vehiculo1 FROM "~DBO~".OPERACIONES WHERE NrOperacion= '"~Dialogo.NrOperacion1~"' ")
               Book1         :  'Book'             ;7 ;4; ;NO;NO;;;;;Val(o:&i)
               Nroperacion2  :  'OpRef'            ;8 ;4; ;NO;NO;;;;;SQL("SELECT OperacionRef FROM "~DBO~".OPERACIONES WHERE NrOperacion= '"~Dialogo.NrOperacion1~"' ")
               Cantidad5     :  'VCAN1'            ;1 ;5; ;NO;NO;;;;;IIF(NOVACIO(Dialogo.NrOperacion2) Y Dialogo.Radio1=0 , IIF(Dialogo.Cantidad1>Dialogo.Cantidad6, IIF(EQSTR(Dialogo.Especie1,'USD'),(Dialogo.Cantidad1-Dialogo.Cantidad6),(Dialogo.Cantidad1-Dialogo.Cantidad6) *COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,'USD') ),0) , IIF(EQSTR(Dialogo.Especie1,'USD'),Dialogo.Cantidad1,Dialogo.Cantidad1 *COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,'USD')) ) ;
               Cantidad6     :  'OpRefCant'        ;2 ;5; ;NO;NO;;;;;IIF(NOVACIO(Dialogo.NrOperacion2),SQL("Select Cantidad from "~DBO~".OPERACIONES Where NrOperacion ='"~Dialogo.NrOperacion2~"'"))
               Book2         :  'VTXT11'           ;3 ;5; ;NO;NO;;;;;IIF(NOVACIO(Dialogo.Book1),SQL("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~Dialogo.Cliente1~"' "))     
               String1       :  'Sector'           ;7 ;2; ;NO;IF(EqStr(VAR('CTRLSECTOR'),'SI'),SI,NO);IIF(EqStr(VAR('CTRLSECTOR'),'SI'),NOVACIO(Dialogo.String1)) O EqStr(VAR('CTRLSECTOR'),'NO');'El usuario no tiene sector asignado';NO;SQL("SELECT Sector FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~UsuarioActivo~"' ");SQL("SELECT Sector FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~UsuarioActivo~"' ")
