 CrearDialogo
  Fecha1   : 'Fecha'                ;;;;;;;;;;FSYS
  Cliente1 : 'Cliente'              ;;;;;;;;;;
  Especie1 : 'Especie'              ;;;;;;;;;;
  TipoOp1  : 'Tipo Op.'             ;;;;;;;;;;;;;;"Codigo IN ('MMCT', 'MMCO')";
  Operador : 'Operador'             ;;;;;;;;;UsuarioActivo
  String1  :  'Sector'              ;;;;NO;IF(EqStr(VAR('CTRLSECTOR'),'SI'),SI,NO);IIF(EqStr(VAR('CTRLSECTOR'),'SI'),NOVACIO(Dialogo.String1)) O EqStr(VAR('CTRLSECTOR'),'NO');'El usuario no tiene sector asignado';NO;SQL("SELECT Sector FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~UsuarioActivo~"' ");SQL("SELECT Sector FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~UsuarioActivo~"' ")
FinDialogo


if not ok
  Cancelar
endif

*SQL.ADD(" Select NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Precio1, Plazo, FechaOp, Book1, PorBonificacion, ")
*SQL.ADD(" TotalIntereses, TotalRetenciones, RB5, Operador, Precio4, FechaVto, TotalGanancias, ")
