********** OPERACIONES DEL OPERADOR
SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, O.Precio1, O.Plazo, O.FechaOp, O.Book1, ")
SQL.ADD(" O.TotalIntereses, O.TotalRetenciones, O.RB5, O.Operador, O.Precio4, O.FechaVto, O.TotalGanancias, ")
SQL.ADD(" O.TablaFeriados1, O.DiasAnio, O.Opsiopel, O.Direccion, O.Linstancia, O.Observacdoc, O.Precio3, ")
SQL.ADD(" O.Cliente3, O.PorComision, O.TotalBrutoCli2, O.Cartera, O.TotalComisiones, O.MB2, ")
SQL.ADD(" O.MB6, O.RB7, O.CB5, ")
SQL.ADD(" O.PorBonificacion")

SQL.ADD(" from "~DBO~".OPERACIONES O ")

SQL.ADD(" where O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and O.TipoOp = '"~Dialogo.TipoOp1~"'")
else
  SQL.ADD("and O.TipoOp in ('MMCO','MMCT')")
  *  SQL.ADD("and O.TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPO','MMCA')")
endif
SQL.ADD("and (O.RB6 = '0' or O.RB6 is NULL)")
if NoVacio(Dialogo.Operador)
  SQL.ADD("and O.Operador = '"~Dialogo.Operador~"'")
endif
if EqStr(VAR('CTRLSECTOR'), 'SI')
  SQL.ADD(" and O.Sector1 = '"~Dialogo.String1~"'")
endif
SQL.ADD("order by O.Cliente1, O.Especie, O.TipoOp ")



********** OPERACIONES DEL SECTOR

SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, O.Precio1, O.Plazo, O.FechaOp, O.Book1, ")
SQL.ADD(" O.TotalIntereses, O.TotalRetenciones, O.RB5, O.Operador, O.Precio4, O.FechaVto, O.TotalGanancias, ")
SQL.ADD(" O.TablaFeriados1, O.DiasAnio, O.Opsiopel, O.Direccion, O.Linstancia, O.Observacdoc, O.Precio3, ")
SQL.ADD(" O.Cliente3, O.PorComision, O.TotalBrutoCli2, O.Cartera, O.TotalComisiones, O.MB2, ")
SQL.ADD(" O.MB6, O.RB7, O.CB5, ")
SQL.ADD(" O.PorBonificacion")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and O.TipoOp = '"~Dialogo.TipoOp1~"'")
else
  SQL.ADD("and O.TipoOp in ('MMCO','MMCT')")
  *  SQL.ADD("and O.TipoOp in ('MMCO','MMCT','MMPF','MMPFCE','MMPO','MMCA')")
endif
SQL.ADD("and (O.RB6 = '0' or O.RB6 is NULL)")

if EqStr(VAR('CTRLSECTOR'), 'SI')
  SQL.ADD(" and O.Sector1 = '"~Dialogo.String1~"'")
endif
SQL.ADD("order by O.Cliente1, O.Especie, O.TipoOp ")

ACN(z1, 0)
recorrer SQL

  ACT(a:fac, fbn('Cliente1'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('TipoOp'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('TotalIntereses'))
  ACN(g:fac, fbn('Plazo'))
  ACT(h:fac, fbn('NrOperacion'))
  IF Incluido(fbn('TipoOp'), 'MMPF|MMPFCE')
      ACN(I:fac, fbn('TotalGanancias'))
  ELSE
      ACN(i:fac, fbn('TotalRetenciones'))
  ENDIF
  
  ACN(j:fac, fbn('RB5'))  
  ACT(k:fac, fbn('Operador'))
  ACN(l:fac, 0)
  ACN(m:fac, fbn('Precio4'))
  IF Incluido(fbn('TipoOp'), 'MMCO|MMCT')
    ACD(n:fac, Dialogo.Fecha1)
    ACT(o:fac, fbn('Book1'))
    ACN(p:fac, fbn('PorBonificacion'))
  ENDIF
  SCN(z1, 1)

proximo

