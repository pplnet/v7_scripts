                    SQL.ADD("(NrOperacion,   Tipo,    Fecha,   Descripcion)")
                    SQL.ADD(" Values  ")
                    SQL.ADD("('"~Val(Z1)~"','SPREADNEG',"~IdxDate2(FSYS)~",'Spread Negativo: "~FSTR(Dialogo.Precio1-Dialogo.Precio2,0,7)~"')")
                    SQL.NEW
                    SQL.EXEC 
                endif
            endif
            
                *************************************************************************************************
                
            recorrer&J 1, 81
              ACT(A1, FStr(&J,1,0))
              if EqStr(fbn('TipoOp'),'MMCO')  
                if Incluido(Val(A1),'1|2|3|7|8|10|19|30|70|')
                    SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
                    SQL.ADD(" Values ('"~Val(z1)~"',"~FStr(&J,1,0)~",'0') ")
                    SQL.NEW
                endif
              endif
              if EqStr(fbn('TipoOp'),'MMCT')
                if Incluido(Val(A1),'1|2|3|7|10|19|30|70|')
                    SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
                    SQL.ADD(" Values ('"~Val(z1)~"',"~FStr(&J,1,0)~",'0') ")
                    SQL.NEW
                endif
              endif
              if not EqStr(fbn('TipoOp'),'MMCT') Y not EqStr(fbn('TipoOp'),'MMCO')
                 if Incluido(Val(A1),'1|3|7|10|30|70|')
                     SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
                     SQL.ADD(" Values ('"~Val(z1)~"',"~FStr(&J,1,0)~",'0') ")
                     SQL.NEW
                 endif
              endif
            proximo
            SQL.ADD(" Update "~DBO~".OPERACIONESBITS set Valor='1' ")
            SQL.ADD(" where  NrBit=1 and NrOperacion= '"~Val(z1)~"' ")
            SQL.NEW
             
            
            SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '1' where NrOperacion = '"~Val(h:&i)~"'")
            SQL.NEW
            SQL.EXEC
            
            
            SQL.ActualizarMovimientos3(Val(Z:1),SI,SI,NO,SI,SI)
            SQL.EXEC
          proximo
        endif
      endif

      if Val(l:&i)=1
        *********** Cancela *********
        CrearDialogo:13
          TipoOp1       : 'Tipo Op'     ;1;1;;NO;;;;;Val(c:&i)
          NrOperacion1  : 'NrOperacion' ;1;2;;NO;;;;;Val(h:&i)
          Especie1      : 'Especie'     ;2;1;;NO;;;;;Val(b:&i)
          Cliente1      : 'Cliente'     ;3;1;;NO;;;;;Val(a:&i)
          Fecha1        : 'Fecha Op'    ;2;2;;NO;;;;;FSys
          Entero1       : 'Plazo'       ;3;2;;NO;;;;;Val(g:&i)
          Fecha2        : 'Fecha Vto'   ;4;2;;NO;;;;;Dialogo.Fecha1+Dialogo.Entero1
          Cantidad1     : 'Cantidad'    ;4;1;;NO;;;;;Val(d:&i)
          Precio1       : 'Tasa (%)'    ; ; ;;NO;;;;;Val(e:&i)
          Precio2       : 'Tasa de Transf.'  ;6;1;IF(EqStr(VAR('CONTROLATT'),'SI'),SI,NO);NO;;;;;Val(j:&i)
          Radio2        : 'Tipo T.base|Transferencia|Call';6;2;;NO;NO;;;;Val(j:&i);
          Cantidad2     : 'Interes'     ;7;1;;NO;;;;;Val(f:&i)
          String        : 'Observ.'     ; ; ;;;;;;;  
        FinDialogo
        if Ok
          SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '2' , Observaciones = '"~Dialogo.String~"' ")
          SQL.ADD("where NrOperacion = '"~Val(h:&i)~"'")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    proximo
  endif


else
  if EqStr(VAR('CTRLSECTOR'), 'SI')
    if VACIO(SQL("SELECT 1 FROM "~DBO~".USRVEHICULO WHERE Codigo = '"~Dialogo.Operador~"' AND NOT EXISTS (SELECT 1 FROM "~DBO~".USRVEHICULO  WHERE ISNULL(Sector, 'NO') = 'NO' and Codigo = '"~Dialogo.Operador~"')"))
        Cancelar('El usuario '~Dialogo.Operador~' no tiene sector asignado')
    else
        Cancelar('No existen operaciones')
    endif
  else
    Cancelar('No existen operaciones')
  endif
endif
