CrearDialogo
   NrOperacion1: 'NrOper' ;;;;;;;;;;;;;
FinDialogo

If Not OK
   Cancelar
EndIf

SQL.ADD("SELECT Direccion FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACN(a:1, FBN['Direccion'])
Proximo

If Val(a:1)=1
   ACN(a:1, 0)
Else
   ACN(a:1, 1)
EndIf
SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Direccion = "~FStr(Val(a:1),0,0)~" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
