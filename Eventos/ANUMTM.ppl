MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'    ;1;1; ;  ;  ;;;;FSys;
  Vehiculo1: 'Vehiculo:';2;1; ;NO;SI;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Check1   : 'Procesa'  ;1;2; ;NO;;;;;1
FinDialogo
if not ok
  Cancelar
endif
if Dialogo.Check1=0
  Message('**** NO PROCESA ****')
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

ACD(bz:1, SQL("Select Max(Fecha) From "~DBO~".FLAGSOCT Where Registro = 'MTMD' "))
if Val(bz:1)=0
  MessageBox('No existe ningun registros en FLAGSOCT para MTMD')
  if Dialogo.Check1=1 o SI
    Cancelar('Evento cancelado')
  endif
endif
ACN(bz:2, SQL("Select Cantidad From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'MTMD' "))
if Val(bz:2)=0
  MessageBox('No existe el Flag del MTM para el '~Dialogo.Fecha1)
  if Dialogo.Check1=1 o SI
    Cancelar('Evento cancelado')
  endif
endif
if Val(bz:1)>Dialogo.Fecha1
  MessageBox('Existe MTM posterior al '~Dialogo.Fecha1)
  if Dialogo.Check1=1 o SI
    Cancelar('Evento cancelado')
  endif
endif
ACN(bx:1, SQL("Select Count(*) from "~DBO~".TRANSACCIONES2 Where TipoTr2 in ('OCTDEP','OCTRET') and Fecha1='"~IdxDate(Dialogo.Fecha1)~"' and Precio5=0 "))
if Val(bx:1)>1
  MessageBox('Existe mas de una trasaccion de Cobro/Pago')
  if Dialogo.Check1=1
    Cancelar('Evento cancelado')
  endif
else
  ACT(bx:2, SQL("Select NrTrans from "~DBO~".TRANSACCIONES2 Where TipoTr2 in ('OCTDEP','OCTRET') and Fecha1='"~IdxDate(Dialogo.Fecha1)~"' and Precio5=0 "))
endif

ACT(a:0, 'A')
ACT(k:0, 'K')
ACT(aa:0, 'AA')
ACT(ah:0, 'AH')
ACT(ba:0, 'BA')
ACT(be:0, 'BE')
ACT(bh:0, 'BH')
ACT(bk:0, 'BK')
ACT(ca:0, 'CA')
ACT(cf:0, 'CF')
ACT(cj:0, 'CJ')

ACT(bk:1, 'Cant.Tr2')
ACT(bl:1, 'NrTr2')
ACT(bm:1, 'Cliente')
ACT(bn:1, 'Cantidad')
ACT(bo:1, 'Cant.MovEje')
ACT(bp:1, 'Monto')
ACT(bq:1, 'Cant.Ops')
ACT(br:1, 'Monto')
ACT(71:1, 'Anula')

SetFilaActual(1)
SQL.ADD("Select NrTrans,Cantidad1,Cliente1 from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" Where Fecha1    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and TipoTr2   = 'LIQOCT' ")
SQL.ADD("   and Cambio1   = 0 ")
recorrer SQL
  SCN(bk:2, 1)
  ACT(bl:FAC, fbn('NrTrans'))
  ACT(bm:FAC, fbn('Cliente1'))
  ACN(bn:FAC, fbn('Cantidad1'))
  SCN(bu:1, fbn('Cantidad1'))
proximo
if Val(bk:2)>0
  recorrer&i 2,Val(bk:2)+1
    SQL.ADD("Select Cantidad from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion    = '"~Val(bl:&i)~"' ")
    SQL.ADD("   and NrSaldo        = 1 ")
    recorrer SQL
      SCN(bo:&i, 1)
      SCN(bp:&i, fbn('Cantidad'))
      SCN(bu:2, fbn('Cantidad'))
    proximo
    if Val(bo:&i)>0
      MessageBox('La transacccion '~Val(bl:&i)~' esta liquidada.')
      ACN(bk:3,1)
    endif
  proximo
  if Val(bk:3)>0
    if Dialogo.Check1=1
      Cancelar('Evento Cancelado')
    else
      MessageBox('Evento Cancelado (bk:3>0)')
    endif
  endif
endif

SetFilaActual(1)
ACT(a:FAC, 'NrOper.(Ops)')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'Cliente1')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Precio1')
ACT(g:FAC, 'ConEsp')
ACT(h:FAC, 'TBC1')
ACT(i:FAC, 'Vehiculo1')
ACT(j:FAC, 'Book1')
ACT(k:FAC, 'FechaOp')
ACT(l:FAC, 'FechaVto')
ACT(m:FAC, 'FechaPago')
ACT(n:FAC, 'FechaPrec')
ACT(o:FAC, 'Alta')
ACT(p:FAC, 'Fixing')
ACT(q:FAC, 'Pre.Ant  (Op)')
ACT(r:FAC, 'F.MTM.Ant(Op)')
ACT(s:FAC, 'Pre.Hoy  (Op)')
ACT(t:FAC, 'F.MTM.Hoy(Op)')
ACT(u:FAC, 'Espec.MTM')
ACT(v:FAC, 'MB1 (Fix)')
ACT(w:FAC, 'Espec.Fix')
ACT(x:FAC, 'Clave MAE')
ACT(y:FAC, 'Tipo Neg.')
ACT(z:FAC, 'Especie')
ACT(aa:FAC, 'Variable')
ACT(ab:FAC, 'Linea Mov')

ACT(ai:FAC, 'Movs.Eje')
ACT(aj:FAC, 'Movs.Pen')
ACT(ak:FAC, 'MTM Movs')
ACT(al:FAC, 'Tot.Movs')

ACT(am:FAC, 'Acum.Hoy.(Op)')
ACT(an:FAC, 'Acum.Hoy.(Op)')
ACT(ao:FAC, 'Res.Dia (Op)')
ACT(ap:FAC, 'Acum.Ant(Resta)')
ACT(aq:FAC, 'Acum.Ant(Calc)')

ACT(ar:FAC, 'PrecioEj')
ACT(as:FAC, 'FechaEj')
ACT(at:FAC, 'PrecioMer')
ACT(au:FAC, 'FUltCup')
ACT(av:FAC, 'TotAux1/3')
ACT(aw:FAC, 'TotAux4')

ACT(ay:FAC, 'Accion')

ACT(ca:FAC, 'NrOper.(Mov)')
ACT(cb:FAC, 'Control')
ACT(cc:FAC, 'Movs D.F1')
ACT(cd:FAC, 'Cantidad D.F1')
ACT(ce:FAC, 'Precio D.F1')
ACT(cf:FAC, 'Max(F) < D.F1')
ACT(cg:FAC, 'Movs CF')
ACT(ch:FAC, 'Cantidad CF')
ACT(ci:FAC, 'Precio CF')
ACT(cj:FAC, 'Max(F) < CF')
ACT(ck:FAC, 'Movs CJ')
ACT(cl:FAC, 'Cantidad CJ')
ACT(cm:FAC, 'Precio CJ')
ACT(cn:FAC, 'Linea Op')

SetFilaActual(1)
SQL.ADD("Select O.NrOperacion ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C , "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where C.Codigo      = O.Cliente1 ")
SQL.ADD("   and O.TipoOp      In ('FXOCTC','FXOCTV') ")
SQL.ADD("   and O.FechaOp     <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and O.FechaVto    >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
SQL.ADD("   and B.NrBit       = 30 ")
SQL.ADD("   and B.Valor       = '0' ")
SQL.ADD("   and (O.FechaPrecan is Null or O.FechaPrecan >= "~IdxDate2(Dialogo.Fecha1)~") ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL
  SCN(az:1,1)
  ACT(a:FAC, fbn('NrOperacion'))
proximo

if Val(az:1)=0
  MessageBox('No hay operaciones a reversar.')
  if Dialogo.Check1=1
    Cancelar('Evento Cancelado')
  else
    MessageBox('Evento Cancelado (Sin.Ops)')
  endif
endif

SetFilaActual(1)
SQL.ADD("Select M.NrOperacion, 'EJE' Est ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("   and O.TipoOp      In ('FXOCTC','FXOCTV') ")
SQL.ADD("   and M.NrSaldo     = 100 ")
SQL.ADD("   and M.FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("Union ")
SQL.ADD("Select M.NrOperacion, 'PEN' Est ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("   and O.TipoOp      In ('FXOCTC','FXOCTV') ")
SQL.ADD("   and M.NrSaldo     = 100 ")
SQL.ADD("   and M.FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" order by M.NrOperacion ")
Recorrer SQL
  SCN(az:2,1)
  ACT(ca:FAC, fbn('NrOperacion'))
proximo

if Val(az:2)=0
  MessageBox('No hay movimientos a reversar.')
  if Dialogo.Check1=1
    Cancelar('Evento Cancelado')
  else
    MessageBox('Evento Cancelado (Sin.Movs)')
  endif
endif

if Val(az:1)<>Val(az:2)
  MessageBox('Error en Cantidad de Operaciones (Oper.='~FStr(Val(az:1),1,0)~' | Movs.='~FStr(Val(az:2),1,0)~').')
  if Val(az:1)<Val(az:2)
    if Dialogo.Check1=1
      Cancelar('Evento Cancelado')
    else
      MessageBox('Evento Cancelado (Cant.Ops)')
    endif
  endif
endif

if Val(az:1)>0
  recorrer&i 2,Val(az:1)+1
*    if EqStr(Val(a:&i),Val(ca:&i))
*      ACT(cb:&i, 'OK')
*    else
*      ACT(cb:&i, 'Error')
*      ACN(az:3, 1)
*    endif
    if Val(az:2)>0
      recorrer&j 2,Val(az:2)+1
        if EqStr(Val(a:&i),Val(ca:&j))
          if Vacio(Val(cb:&j))
            ACN(ab:&i, &j)
            ACN(cn:&j, &i)
            ACT(cb:&j, 'OK')
          else
            ACT(cb:&j, 'Error 1')
          endif
          Break
        endif
      proximo
    endif
  proximo
endif
if Val(az:2)>0
  recorrer&j 2,Val(az:2)+1
    if Vacio(Val(cb:&j))
      ACT(cb:&j, 'Error 2')
      ACN(az:3, 1)
    endif
  proximo
endif
if Val(az:3)=1
  MessageBox('Error en conciliacion Operaciones/Movimientos. (Movs. sin Operacion)')
  if Dialogo.Check1=1
    Cancelar('Evento Cancelado')
  else
    MessageBox('Evento Cancelado (Concilaicion Ops/Movs)')
  endif
endif

if Val(az:1)>0
  SetFilaActual(1)
  recorrer&i 2,Val(az:1)+1
    IFA
    ***********
    * Operacion
    ***********
    SQL.ADD("Select O.* ")
    SQL.ADD("  from "~DBO~".OPERACIONES O ")
    SQL.ADD(" where O.NrOperacion = '"~Val(a:&i)~"' ")
    recorrer SQL
      DFA
      Message('Operacion '~fbn['TipoOp']~' '~fbn('NrOperacion'))
      ACT(b:fac, fbn['TipoOp'])
      ACT(c:fac, fbn['Cliente1'])
      ACT(d:fac, fbn['Especie'])
      ACN(e:fac, fbn['Cantidad'])
      ACN(f:fac, fbn['Precio1'])
      ACT(g:fac, fbn['ContraEspecie'])
      ACN(h:fac, fbn['TotalBrutoCli1'])
      ACT(i:fac, fbn['Vehiculo1'])
      ACT(j:fac, fbn['Book1'])
      ACD(k:fac, fbn['FechaOp'])
      ACD(l:fac, fbn['FechaVto'])
      ACD(m:fac, fbn['FechaPago'])
      ACD(n:fac, fbn['FechaPrecan'])

      if fbn['FechaOp']=DIalogo.Fecha1
        ACN(o:FAC, 1)
      endif
      if fbn['FechaVto']=DIalogo.Fecha1 o fbn['FechaPrecan']=DIalogo.Fecha1
        ACN(p:FAC, 1)
      endif
      if Val(o:FAC)+Val(p:FAC)>1
        ACT(at:FAC, 'Error 1')
        ACN(au:fac, 1)
      endif
      ACN(q:FAC, fbn['PrecioMer'])
      ACD(r:FAC, fbn['FechaUltCupon'])
      ACN(s:FAC, fbn['PrecioEj'])
      ACD(t:FAC, fbn['FechaEj'])
      ACT(u:FAC, fbn['EnteCus1'])
      if Vacio(Val(u:FAC))
        ACT(at:FAC, 'Error 2')
        ACN(au:fac, 1)
      endif
      ACN(v:FAC, fbn['MB1'])
      ACT(w:FAC, fbn['ContraEspecie2'])
      if Vacio(Val(w:FAC))
        ACT(at:FAC, 'Error 3')
        ACN(au:fac, 1)
      endif
      ACT(x:fac, fbn['ObsErrorMAE'])
      ACT(y:fac, Copy(fbn['ObsErrorMAE'],1,1))
      ACT(z:fac, Copy(fbn['ObsErrorMAE'],2,5))
      ACT(aa:fac, Copy(fbn['ObsErrorMAE'],7,7))

      SQL.ADD("Select Cantidad from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:fac)~"' ")
      SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD("   and NrSaldo     = 100 ")
      recorrer SQL
        DFA
        SCN(ai:FAC, 1)
        SCN(ak:FAC, fbn('Cantidad'))
        SCN(al:FAC, 1)
      proximo
      SQL.ADD("Select Cantidad from "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:fac)~"' ")
      SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD("   and NrSaldo     = 100 ")
      recorrer SQL
        DFA
        SCN(aj:FAC, 1)
        SCN(ak:FAC, fbn('Cantidad'))
        SCN(al:FAC, 1)
      proximo
      ACN(am:fac, fbn['TotalAux1'])
      ACN(an:fac, fbn['TotalAux3'])
      ACN(ao:fac, fbn['TotalAux4'])
      ACN(ap:fac, Val(am:fac)-Val(ao:fac))

    proximo
    *************
    * Movimientos
    *************
    SQL.ADD("Select Cantidad,PrecioEj from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("where NrOperacion = '"~Val(a:FAC)~"' ")
    SQL.ADD("  and FechaMov = "~IdxDate2(Dialogo.Fecha1)~" ")
    recorrer SQL
      DFA
      SCN(cc:FAC, 1)
      ACN(cd:FAC, fbn('Cantidad'))
      ACN(ce:FAC, fbn('PrecioEj'))
    proximo

    SQL.ADD("Select Max(FechaMov) as MaxFecha from "~DBO~".MOVEJECUTADOS ")
    SQL.ADD("where NrOperacion = '"~Val(a:FAC)~"' ")
    SQL.ADD("  and FechaMov < "~IdxDate2(Dialogo.Fecha1)~" ")
    recorrer SQL
      DFA
      ACD(cf:FAC, fbn('MaxFecha'))
    proximo

    if Val(cf:FAC)>0
      SQL.ADD("Select Cantidad,PrecioEj from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.ADD("  and FechaMov = "~IdxDate2(Val(cf:FAC))~" ")
      recorrer SQL
        DFA
        SCN(cg:FAC, 1)
        ACN(ch:FAC, fbn('Cantidad'))
        ACN(ci:FAC, fbn('PrecioEj'))
      proximo
      SQL.ADD("Select Max(FechaMov) as MaxFecha from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where NrOperacion = '"~Val(a:FAC)~"' ")
      SQL.ADD("  and FechaMov < "~IdxDate2(Val(cf:FAC))~" ")
      recorrer SQL
        DFA
        ACD(cj:FAC, fbn('MaxFecha'))
      proximo
      if Val(cj:FAC)>0
        SQL.ADD("Select Cantidad,PrecioEj from "~DBO~".MOVEJECUTADOS ")
        SQL.ADD("where NrOperacion = '"~Val(a:FAC)~"' ")
        SQL.ADD("  and FechaMov = "~IdxDate2(Val(cj:FAC))~" ")
        recorrer SQL
          DFA
          SCN(ck:FAC, 1)
          ACN(cl:FAC, fbn('Cantidad'))
          ACN(cm:FAC, fbn('PrecioEj'))
        proximo
      endif
    endif
    if Val(ab:FAC)>0
      if Val(cc:FAC)<>Val(al:FAC)
        ACN(ar:FAC, 1)
        ACN(ax:FAC, 1)
      endif
      if Val(al:FAC)<>1
        ACN(as:FAC, 1)
        ACN(ax:FAC, 1)
      endif
    endif

    if Val(o:&i)=1
      ACT(ar:&i, 'Null')
      ACT(as:&i, 'Null')
      ACT(at:&i, 'Null')
      ACT(au:&i, 'Null')
      ACN(av:&i, 0)
      ACN(aw:&i, 0)
    else
      if Val(cf:&i)>0
        ACN(ar:&i, Val(ci:&i))
        ACD(as:&i, Val(cf:&i))
      else
        ACT(ar:&i, 'Null')
        ACT(as:&i, 'Null')
      endif
      if Val(cj:&i)>0
        ACN(at:&i, Val(cm:&i))
        ACD(au:&i, Val(cj:&i))
      else
        ACN(at:&i, Val(f:&i))
        ACT(au:&i, 'Null')
      endif
      ACN(av:&i, Val(ap:&i))
      ACN(aw:&i, Val(ch:&i))
    endif
            
    if Val(ax:FAC)=1
      ACN(az:4, 1)
    endif
  proximo
            
  if Val(az:4)=0
    if Val(bk:2)>0
      recorrer&i 2,Val(bk:2)+1
        if NoVacio(Val(bl:&i))
          if Val(bo:&i)=0
            ACT(71:&i, 'SI Anula')
            if Dialogo.Check1=1
              Message('Llama evento ANLOCT para Trans. '~Val(bl:&i))
              EjecutarEvento('ANLOCT',NrTrans1=Val(bl:&i))
            endif
          endif
        endif
      proximo
    endif
    recorrer&i 2,Val(az:1)+1
      if Val(ax:&i)=0
        ACT(ay:&i, 'Actualiza OP')
        if Dialogo.Check1=1
          Message('Update Operacion '~Val(a:&i))
          SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
          if Val(o:&i)=1
            * Es Alta
            SQL.ADD("   Set Precio2       = Null, ")
            SQL.ADD("       FechaVto2     = Null, ")
            SQL.ADD("       PrecioMer     = Null, ")
            SQL.ADD("       FechaUltCupon = Null, ")
            SQL.ADD("       PrecioEj      = Null, ")
            SQL.ADD("       FechaEj       = Null, ")
            SQL.ADD("       TotalAux1     = 0, ")
            SQL.ADD("       TotalAux3     = 0, ")
            SQL.ADD("       TotalAux4     = 0 ")
          else
            SQL.ADD("   Set Precio2       = Null, ")
            SQL.ADD("       FechaVto2     = Null, ")
            if Val(cf:&i)>0
              SQL.ADD("       PrecioEj      = "~Fstr(Val(ci:&i),0,8)~", ")
              SQL.ADD("       FechaEj       = "~IdxDate2(Val(cf:&i))~", ")
            else
              SQL.ADD("       PrecioEj      = Null, ")
              SQL.ADD("       FechaEj       = Null, ")
            endif
            if Val(cj:&i)>0
              SQL.ADD("       PrecioMer     = "~Fstr(Val(cm:&i),0,8)~", ")
              SQL.ADD("       FechaUltCupon = "~IdxDate2(Val(cj:&i))~", ")
            else
              SQL.ADD("       PrecioMer     = "~Fstr(Val(f:&i),0,8)~", ")
              SQL.ADD("       FechaUltCupon = Null, ")
            endif
            SQL.ADD("       TotalAux1     = "~Fstr(Val(ap:&i),0,2)~", ")
            SQL.ADD("       TotalAux3     = "~Fstr(Val(ap:&i),0,2)~", ")
            SQL.ADD("       TotalAux4     = "~Fstr(Val(ch:&i),0,2)~" ")
          endif
          SQL.ADD(" Where NrOperacion   = '"~Val(a:&i)~"' ")
          SQL.NEW


          * FO 30/11/2005 - Anula Mov de posicion por MTM --------------- *
          * Tienen tipo 1 los que se ingresn manualmente, los de las op estan en null.
          * Le puse 1 para poder identificarlos, al trigger de posiciones le da lo mismo 1 o null

          SQL.ADD("DELETE "~DBO~".MOVPOSEJE ")
          SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
          SQL.ADD("   and NrSaldo IN (43,51,31) ")
          SQL.ADD("   and Tipo = '1' ")
          SQL.NEW
          SQL.ADD("DELETE "~DBO~".MOVPOSPEN ")
          SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
          SQL.ADD("   and NrSaldo IN (43,51,31) ")
          SQL.ADD("   and Tipo = '1' ")
          SQL.NEW
          * ------------------------------------------------------------- *

        
          SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS ")
          SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
          SQL.ADD("   and NrSaldo     = 100 ")
          SQL.NEW
          SQL.ADD("DELETE "~DBO~".MOVPENDIENTES ")
          SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD("   and FechaMov    = "~IdxDate2(Dialogo.Fecha1)~" ")
          SQL.ADD("   and NrSaldo     = 100 ")
          SQL.NEW
            
          SQL.ADD(" Delete "~DBO~".MOVDEVENGADOS ")
          SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD(" AND NrOperacion = '"~Val(a:&i)~"' ")
          SQL.ADD(" AND TipoDevengado = 'MTMOCT' ")
          SQL.ADD(" AND NrSaldo = 140 ")
          SQL.NEW
*          SQL.EXEC
        endif
      endif
    proximo
    if Dialogo.Check1=1
      Message('Delete Flag MTM')
      SQL.ADD(" Delete "~DBO~".FLAGSOCT ")
      SQL.ADD(" where Fecha    = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   and Registro = 'MTMD' ")
      SQL.NEW
*      SQL.EXEC
    else
      MessageBox('Borra Marca de MTM')
    endif
    if Dialogo.Check1=1
      Message('Delete Flag MTM')
      SQL.ADD(" Delete "~DBO~".FLAGSOCT ")
      SQL.ADD(" where Fecha    = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   and Registro = 'CONC' ")
      SQL.NEW
*      SQL.EXEC
    else
      MessageBox('Borra Marca de Conciliacion')
    endif
    if Dialogo.Check1=1
      Message('Delete Transaccion Pago/Cobro: '~Val(bx:2))
      SQL.ADD(" Delete "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" where Fecha1  =  '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   and TipoTr2 in ('OCTDEP','OCTRET') ")
      SQL.ADD("   and Precio5 =  0 ")
      SQL.NEW
*      SQL.EXEC
      Message('Delete Transaccion Pago/Cobro manuales')
      SQL.ADD(" Delete "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" where Fecha1  =  '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   and TipoTr2 in ('OCTDEP','OCTRET') ")
      SQL.ADD("   and Precio5 >  0 ")
*      SQL.ADD("   and RB1     =  '1' ")
      SQL.NEW
*      SQL.EXEC
    else
      MessageBox('Borra Transaccion Pago/Cobro: '~Val(bx:2))
    endif
    if Dialogo.Check1=1
      SQL.EXEC
    endif
  endif
endif

