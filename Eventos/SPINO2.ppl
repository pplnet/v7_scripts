SQL.ADD(" SELECT O.*, C.RazonSocial FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE  O.Cliente1 = C.Codigo ")
SQL.ADD(" AND    O.TipoOp IN ('CCE','CPE','VCE','VPE','CCP','CPP','VPP','VCP') ")
SQL.ADD(" AND    O.Especie  = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND    O.FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND    (O.CB9 = '0' OR O.CB9 IS NULL) ")
SQL.ADD(" AND    O.CB7 = '1' ")
SQL.ADD(" ORDER BY O.TipoOp, O.Cliente1 ")
Recorrer SQL
  SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET CB7 = '0' WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
  SQL.NEW
  message('Operacion '~fbn('NrOperacion')~' actualizada.')
Proximo
SQL.EXEC


SQL.ADD(" SELECT Codigo, Precio1, Fecha, CallPut, CodigoSpin FROM "~DBO~".OPCIONES WHERE Codigo = '"~Dialogo.Especie1~"' ")
Recorrer SQL
  SQL.ADD(" UPDATE "~DBO~".OPCIONES ")
  SQL.ADD(" SET CodNumCajaValores = '"~fbn('CodigoSpin')~"',  ")
  SQL.ADD("     CodigoSpin        = ''  ")
  SQL.ADD(" WHERE Codigo     = '"~Dialogo.Especie1~"' ")
  SQL.ADD(" AND   CodigoSpin = '"~fbn('CodigoSpin')~"' ")
  SQL.ADD(" AND   Fecha      = '"~IdxDate(fbn('Fecha'))~"' ")
  SQL.ADD(" AND   CallPut    = '"~fbn('CallPut')~"' ")
  SQL.ADD(" AND   Precio1    = "~fstr(fbn('Precio1'),1,8)~" ")
  SQL.NEW
  Message('Codigo de Opcion actualizada.')
Proximo
SQL.EXEC