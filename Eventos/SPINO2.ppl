MostrarCuadroDeMensajes
CrearDialogo
   Especie1: 'Especie'      ;;;;;;NOVACIO(Dialogo.Especie1) y NOT DESCIENDEDEESPECIE(Dialogo.Especie1, 'MONEDA');'Debe ingresar una Especie valida';NO  
   Fecha1:   'Record_Date'  ;;;;;;NOVACIO(Dialogo.Fecha1);'Debe ingresar una Fecha valida';NO;fsys
   Fecha2:   'Fecha de Pago';;;;;;NOVACIO(Dialogo.Fecha2);'Debe ingresar una Fecha valida';NO;fsys
   Mercado1: 'Casa_Custodia'
   Vehiculo1:'Vehiculo'      ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
   Operador1:'Operador'      ;1;2;;NO;;NoVacio(Dialogo.Operador1);'Operador Invalido';NO;USUARIOACTIVO
FinDialogo

IF NOT OK
  Cancelar
ENDIF

SQL.ADD(" SELECT T.*, C.RazonSocial")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C")
SQL.ADD(" WHERE T.Cliente1 = C.Codigo ")
SQL.ADD(" AND   T.Especie  = '"~Dialogo.Especie1~"'")
SQL.ADD(" AND   T.TipoTr2  = 'SPINOF' ")
SQL.ADD(" AND   T.Fecha1   = '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(" AND   T.Fecha2   = '"~IdxDate(Dialogo.Fecha1)~"'")
IF NOVACIO(Dialogo.Mercado1) 
   SQL.ADD(" AND   T.Mercado1 = '"~Dialogo.Mercado1~"'")
ENDIF
SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" ORDER BY T.Cliente1, T.NrTrans")

ACN(z:1,0)
Recorrer SQL
     ACT(a:fac, fbn('Especie'))
     ACT(b:fac, fbn('Cupon1'))
     ACT(d:fac, fbn('Vehiculo1'))
     ACT(e:fac, fbn('Mercado1'))
     ACT(f:fac, fbn('RazonSocial'))
     ACT(g:fac, fbn('Cliente1'))
     ACT(h:fac, fbn('Cuenta1'))
     ACN(j:fac, fbn('Cantidad1'))
     ACN(l:fac, fbn('Cantidad2'))
     ACT(n:fac, fbn('NrTrans'))
     ACT(m:fac, fbn('Especie'))
     ACN(T:fac, fbn('Cambio5'))
     ACN(V:fac, fbn('Cantidad5'))
     ACN(W:fac, fbn('Cantidad7'))
     ACT(ma:fac, fbn('Especie4'))
     ACT(mm:fac, fbn('Cliente2'))
     ACN(PI:fac, fbn('TotalImpuesto1'))
     ACT(cn:fac, fbn('Cuenta2'))
     ACT(cu:fac, fbn('Cliente2'))
     ACT(ll:fac, fbn('Cuenta3'))
     ACT(nn:fac, fbn('Cuenta4'))
     ACT(cp:fac, fbn('Cliente3'))
     ACN(x:fac, 1) 
     ACN(z:1, 1) 
Proximo

