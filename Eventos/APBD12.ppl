MostrarCuadroDeMensajes

CrearDialogo
  Fecha1:   'FechaBajada'    ;1;;;;;;;;;FSYS
  String:   'Archivo'        ;2;;;;;;;;'DNCTAS';BuscarCampo('DATANET','Archivo','NrDatanet',Dialogo.String2)
  String2:  'NrDatanet'      ;3;;;;;;;;SQL("SELECT NrDatanet FROM "~DBO~".DATANET WHERE FechaBajada="~IdxDate2(Dialogo.Fecha1)~" AND TRIM(Archivo)='"~TRIM(MIRT(MAYUSCULAS2(Dialogo.String)))~"' ORDER BY NrDatanet DESC ")
  Fecha2:   'F.Desde'        ;4;;;NO;;;;;;BuscarCampo('DATANET','FechaDesde','NrDatanet',Trim(Dialogo.String2))
  Fecha3:   'F.Hasta'        ;5;;;NO;;;;;;BuscarCampo('DATANET','FechaHasta','NrDatanet',Trim(Dialogo.String2))
  Radio1:   'Estado|A|C|NC'  ;6;;;NO;;;;;;BuscarCampo('DATANET','Estado','NrDatanet',Trim(Dialogo.String2))
  Radio2: 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;7;1;;;;;;;4
  Check1:  'Incluye Pagadoras';8;1;;;;;;;1
  Vehiculo1: 'Vehiculo'      ; 9;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Lista1:    'Bancos'        ;10;1;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista2:    'Cuentas'       ; 4;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~")"~IIF(Dialogo.Check1=0," AND (Pagadora <>'SI' OR Pagadora IS NULL)"));
FinDialogo

If Not Ok
  Cancelar
Endif

message('Recuperando datos del Extracto ... ')
SQL.ADD(" SELECT /*+ RULE */ ")
SQL.ADD(" M.*, E.Codigo MonedaFPA, C.Codigo CuentaFPA, B.Codigo BancoFPA, D.Supervisor ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".DATANET D ")
SQL.ADD(" WHERE  M.Moneda   = E.Alias3 ")  
SQL.ADD(" AND    M.Cuenta   = C.Numero ")  
SQL.ADD(" AND    M.Banco    = B.Alias2 ")  
SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND    (D.EstadoAprobacion = 'P' OR D.Supervisor = 'Captura') ")
***SQL.ADD(" AND    M.NrDatanet = '"~Dialogo.String2~"' ")  
***SQL.ADD(" AND    M.Vehiculo  = '"~Dialogo.Vehiculo1~"' ")  
SQL.ADD(" AND    M.TipoMov <> 'SAL' ")  
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
  SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
SQL.ADD(" ORDER BY M.NrDatanet, M.NrMovDatanet ")
ACN(z:1,0)
Recorrer SQL
  ACN(z:1,1)
  ACT(a:fac, fbn('Vehiculo'))
  ACT(b:fac, fbn('Banco'))
  ACT(c:fac, fbn('Sucursal'))
  ACT(d:fac, fbn('Cuenta'))
  ACT(e:fac, fbn('Moneda'))
  ACN(f:fac, fbn('Importe'))
  If Eqstr(fbn('DC'), 'D')
    ACN(g:fac, 0)
  Else
    ACN(g:fac, 1)
  Endif
  ACD(h:fac, fbn('FechaIngreso'))
  ACD(i:fac, fbn('FechaAcreditacion'))
  ACT(j:fac, fbn('TipoMov'))
  ACT(k:fac, fbn('Comprobante'))
  If Eqstr(fbn('EstadoConciliacion'),'P')
    ACN(l:fac, 0)
  Endif
  If Eqstr(fbn('EstadoConciliacion'),'OK')
    ACN(l:fac, 1)
  Endif
  If Eqstr(fbn('EstadoConciliacion'),'FC')
    ACN(l:fac, 2)
  Endif

  ACN(aa:fac, fbn('Importe2'))
  If Eqstr(fbn('DC2'), 'D')
    ACN(ab:fac, 0)
  Else
    ACN(ab:fac, 1)
  Endif
  ACN(ac:fac, fbn('Importe3'))
  If Eqstr(fbn('DC3'), 'D')
    ACN(ad:fac, 0)
  Else
    ACN(ad:fac, 1)
  Endif
  ACN(ae:fac, fbn('Importe4'))
  ACN(af:fac, fbn('Importe5'))
  ACN(ag:fac, fbn('Importe6'))
  ACN(ah:fac, fbn('Importe7'))
  ACN(ai:fac, fbn('Importe8'))
  ACN(aj:fac, fbn('Importe9'))
  ACN(ak:fac, fbn('Importe10'))
  ACN(al:fac, fbn('Importe11'))
  ACN(am:fac, fbn('Importe12'))
  ACN(m:fac, 0)
  ACN(n:fac, 0)
  ACT(o:fac, fbn('NrDatanet'))
  ACN(p:fac, fbn('NrMovDatanet'))
  ACT(q:fac, fbn('BancoFPA'))
  ACT(r:fac, fbn('Supervisor'))
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron movimientos.')
Endif

CrearListBox; 'Arial,8,'
  'Borrar'        ;m:1..m:fac;Not Eqstr(Val(r:flb),'Captura');Val(m:flb)<>1 o Val(n:flb)=0;'Solo puede ejecutar una accion';80;CHECK;RGB(232,255,215);
  'Modificar'     ;n:1..n:fac;SI;Val(n:flb)<>1 o Val(m:flb)=0;'Solo puede ejecutar una accion';80;CHECK;RGB(232,255,215);
  'Vehiculo'      ;a:1..a:fac  ;NO;;;70;TABLA ; 'Vehiculos';'Codigo';'Codigo;Descripcion';" Status ='HAB' "                        ;RGB(232,232,232);;
  'BancoDatanet'  ;b:1..b:fac  ;NO;;;70;TABLA ; 'Clientes' ;'Alias2';'Alias2;Codigo;RazonSocial';" Sector = 'BAN'  and Alias2 is not null ";RGB(232,232,232);;
  'BancoFPA'      ;q:1..q:fac  ;NO;;;70;STRING;;RGB(232,232,232);BuscarCampo('CLIENTES','Codigo','Alias2',Val(b:flb));NO;NO;
  'Suc'           ;c:1..c  :fac;Not Eqstr(Val(r:flb),'Captura');;;70;STRING;;RGB(232,232,232);
  'Cuenta'        ;d:1..d  :fac;NO;;;70;TABLA ; 'Cuentas' ;'Numero';'Numero;Codigo;Nombre';" Comitente='"~Val(q:flb)~"' AND Cliente='"~Val(a:FLB)~"' ";RGB(232,232,232);
  'Moneda'        ;e:1..e  :fac;NO;;;70;TABLA ; 'Especies';'Alias3';'Alias3;Codigo;Nombre';" Tipo = 'MON'  AND Alias3 IS NOT NULL";RGB(232,232,232)
  'Cantidad'      ;f:1..f  :fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Deb/Cre'       ;g:1..g  :fac;Not Eqstr(Val(r:flb),'Captura');;;40;COMBO;'D|C'    ;RGB(232,232,232)
  'Cantidad'      ;aa:1..aa:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Deb/Cre'       ;ab:1..ab:fac;Not Eqstr(Val(r:flb),'Captura');;;40;COMBO;'D|C'   ;RGB(232,232,232)
  'Cantidad'      ;ac:1..ac:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Deb/Cre'       ;ad:1..ad:fac;Not Eqstr(Val(r:flb),'Captura');;;40;COMBO;'D|C'   ;RGB(232,232,232)
  'Cantidad'      ;ae:1..ae:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;af:1..af:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ag:1..ag:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ah:1..ah:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ai:1..ai:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;aj:1..aj:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;ak:1..ak:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;al:1..al:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'Cantidad'      ;am:1..am:fac;Not Eqstr(Val(r:flb),'Captura');;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
  'F.Ingreso'     ;h:1..h:fac;Not Eqstr(Val(r:flb),'Captura');;;80;FECHA;RGB(232,232,232);
  'F.Acredit'     ;i:1..i:fac;Not Eqstr(Val(r:flb),'Captura');;;80;FECHA;RGB(232,232,232);
  'TipoMov'       ;j:1..j:fac;SI;NOVACIO(Val(j:flb));'Tipo de Movimiento Invalido.';70;TABLA ; 'CodigosDatanet';'Codigo';'Codigo;Descripcion;Tipo';;RGB(232,232,232);
  'Comprobante'   ;k:1..k:fac;Not Eqstr(Val(r:flb),'Captura');;;70;STRING;;RGB(232,232,232);
  'Estado'        ;l:1..l:fac;NO;;;40;COMBO;'P|OK|FC'    ;RGB(232,232,232)
FinListBox

If Not Ok
  Cancelar
Endif

Recorrer&i 1,fac
  If Val(m:&i)=1
    *Borrar Movimiento
    SQL.ADD(" DELETE /*+ RULE */ FROM "~DBO~".MOVDATANET WHERE NrDatanet = '"~Val(o:&i)~"' AND NrMovDatanet= "~FSTR(Val(p:&i),0,0)~" ")
    SQL.NEW
    message('Movimiento '~Val(o:&i)~' - '~FSTR(Val(p:&i),0,0)~' eliminado.' )
  Endif
  If Val(n:&i)=1
    *Modificar Movimiento
    SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".MOVDATANET SET ")
    If Not Eqstr(Val(r:&i),'Captura')
      SQL.ADD(" Vehiculo = '"~Val(a:&i)~"', ")
      SQL.ADD(" Banco    = '"~Val(b:&i)~"', ")
      SQL.ADD(" Sucursal = '"~Val(c:&i)~"', ")
      SQL.ADD(" Cuenta   = '"~Val(d:&i)~"', ")
      SQL.ADD(" Moneda   = '"~Val(e:&i)~"', ")
      SQL.ADD(" Importe  = "~fstr(Val(f:&i),1,2)~", ")
      If Val(g:&i)=0
        SQL.ADD(" DC = 'D', ")
      Else
        SQL.ADD(" DC = 'C', ")
      Endif
      SQL.ADD(" FechaIngreso      = "~IdxDate2(Val(h:&i))~", ")
      SQL.ADD(" FechaAcreditacion = "~IdxDate2(Val(i:&i))~", ")
      SQL.ADD(" Comprobante       = '"~Val(k:&i)~"', ")
      If Val(l:&i)=0
         SQL.ADD(" EstadoConciliacion = 'P', ")
      Endif
      If Val(l:&i)=1
         SQL.ADD(" EstadoConciliacion = 'OK', ")
      Endif
      If Val(l:&i)=2
         SQL.ADD(" EstadoConciliacion = 'FC', ")
      Endif
      SQL.ADD(" Importe2  = "~fstr(Val(aa:&i),1,2)~", ")
      If Val(ab:&i)=0
        SQL.ADD(" DC2 = 'D', ")
      Else
        SQL.ADD(" DC2 = 'C', ")
      Endif
      SQL.ADD(" Importe3  = "~fstr(Val(ac:&i),1,2)~", ")
      If Val(ad:&i)=0
        SQL.ADD(" DC3 = 'D', ")
      Else
        SQL.ADD(" DC3 = 'C', ")
      Endif
      SQL.ADD(" Importe4  = "~fstr(Val(ae:&i),1,2)~", ")
      SQL.ADD(" Importe5  = "~fstr(Val(af:&i),1,2)~", ")
      SQL.ADD(" Importe6  = "~fstr(Val(ag:&i),1,2)~", ")
      SQL.ADD(" Importe7  = "~fstr(Val(ah:&i),1,2)~", ")
      SQL.ADD(" Importe8  = "~fstr(Val(ai:&i),1,2)~", ")
      SQL.ADD(" Importe9  = "~fstr(Val(aj:&i),1,2)~", ")
      SQL.ADD(" Importe10 = "~fstr(Val(ak:&i),1,2)~", ")
      SQL.ADD(" Importe11 = "~fstr(Val(al:&i),1,2)~", ")
      SQL.ADD(" Importe12 = "~fstr(Val(am:&i),1,2)~", ")
    Endif
    SQL.ADD(" TipoMov           = '"~Val(j:&i)~"' ")
    SQL.ADD(" WHERE NrDatanet = '"~Val(o:&i)~"' AND NrMovDatanet= "~FSTR(Val(p:&i),0,0)~" ")
    SQL.NEW
    message('Movimiento '~Val(o:&i)~' - '~FSTR(Val(p:&i),0,0)~' actualizado.' )
  Endif
  SQL.EXEC
Proximo

