*--> AJUSTE POR CER EN OPERACIONES MM PASIVAS <--*

*--> LOS PRESTAMOS SINDICADOS Y FRN SERAN REESTRUCTURADOS
*--> QUEDARON: PRESTAMOS SINDICADOS = SOLO ITEMS
*-->           FRN = SOLO CABECERAS

***/// Este evento de modifico para ajuste DIARIO

CrearDialogo
   Fecha1      : 'Fecha'       ;1;1;;;;;;;FSys;
   NrOperacion1: 'NrOperacion' ;;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

ACT(ic:1, Var('INDICEDEFA'))

*--> Ultimo dia habil del mes anterior al ingresado en el dialogo
ACD(fm:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'), -1, 'ARG', SI))

*--> Si (FECHA1) NO es el primer dia habil del mes <--*

*--> Operaciones U. V. que venzan en la (FECHA1) <--*
SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, O.Cantidad CapOr, O.Cantidad CAmort, O.CantidadOri COri, 0 AmortOri, O.Coeficiente Coef, ")
SQL.ADD(" O.Especie Esp, Null FOp, O.FechaOp FIni, O.FechaVto FFin, O.ImpComCor1 ImpCC1, O.ImpComCor2 ImpCC2, O.ImpComCorEq2 ImpCCE2, ")
SQL.ADD(" O.ImpGastos1 ImpG1, O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, O.IntDevengados1 IntDev1, O.MB1 MB1, O.MB3 MB3, ")
SQL.ADD(" O.NrOperacion NrOp, 0 Pr2, 0 Pr8, O.OperacionRef OpRef, O.Plazo Pl, 0 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, O.PrecioEj PrEj, ")
SQL.ADD(" O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, O.RB9 RB9, O.ResultadoIndice RIndice, O.Spread Sp, O.TasaBase TBa, 0 Ta3, ")
SQL.ADD(" O.TasaImp1 TImp1, O.TasaPrecan TPC, 0 Ta1, O.TipoOp Tipo, O.TipoCambio2 TC2, O.TotalAux4 Alias1, O.TotalComisiones TComi, ")
SQL.ADD(" O.TotalIntereses TInt, O.TotalIVA TIva, O.TotalNetoCli2 IntTot, O.TotalRetenciones TRet, O.TotalBrutoCli1 TBC1, ")
SQL.ADD(" O.TotalBrutoCli2 TBC2, O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, 0 C4, 1 Uni_Mul, 0 C5, 0 C6, 0 C7, 0 Cuota, 0 To5, ")
SQL.ADD(" 0 To6, 0 To8, 0 To9, O.DeltaTasa DT, O.PlazoGracia PG, O.PeriodoInts PerInt, O.TotalAux1 Alias2, O.TotalAux2 Alias3, ")
SQL.ADD(" O.TotalAux3 Alias4 , O.TotalGastos TG, '' Cl1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O   ")
SQL.ADD(" Where O.TipoOp In ('MMPCL', 'MMPI', 'MMPE', 'MMPSI', 'MMFRN','MMON','MMPCCV','MMCP') ")
SQL.ADD("   and O.Indice = '"~Val(ic:1)~"' ")   
SQL.ADD("   and O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif

SQL.ADD(" Union All ")

*--> Operaciones M. V. que venzan en la (FECHA1) <--*
SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, C.Cantidad2 CapOr, ")
SQL.ADD(" CASE WHEN  TipoOp = 'MMSIM' THEN  C.Cantidad4 ELSE  CASE WHEN  O.TipoOp = 'SEPTMV' THEN  C.Cantidad4 ELSE C.Cantidad1 END END CAmort, ")
SQL.ADD(" C.Cantidad2Ori COri, C.Cantidad1Ori AmortOri, C.Coeficiente Coef, O.Especie Esp, O.FechaOp FOp, C.Fecha1 FIni, C.Fecha2 FFin, O.ImpComCor1 ImpCC1, O.ImpComCor2 ImpCC2, ")
SQL.ADD(" O.ImpComCorEq2 ImpCCE2, O.ImpGastos1 ImpG1, O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, O.IntDevengados1 IntDev1, ")
SQL.ADD(" O.MB1 MB1, O.MB3 MB3, O.NrOperacion NrOp, C.Precio2 Pr2, C.Precio8 Pr8, '' OpRef, C.Plazo1 Pl, C.Plazo3 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, ")
SQL.ADD(" O.PrecioEj  PrEj, O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, O.RB9 RB9, O.ResultadoIndice RIndice, C.Precio4 Sp, O.TasaBase TBa, ")
SQL.ADD(" C.Tasa3 Ta3, O.TasaImp1 TImp1, O.TasaPrecan TPC, C.Tasa1 Ta1, O.TipoOp Tipo, O.TipoCambio2 TC2, C.Tasa2 Alias1, ")
SQL.ADD(" O.TotalComisiones TComi, C.Cantidad3 TInt, C.Total4 TIva, C.Total3 IntTot, O.TotalRetenciones TRet, O.TotalBrutoCli1 TBC1, ")
SQL.ADD(" O.TotalBrutoCli2 TBC2, O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, C.Cantidad4 C4, 2 Uni_Mul, C.Cantidad5 C5, C.Cantidad6 C6, ")
SQL.ADD(" C.Cantidad7 C7, C.NrCuota Cuota, C.Total5 To5, C.Total6 To6, C.Total8 To8, C.Total9 To9, O.DeltaTasa DT, O.PlazoGracia PG, ")
SQL.ADD(" O.PeriodoInts PerInt, O.TotalAux1 Alias2, O.TotalAux2 Alias3, O.TotalAux3 Alias4 ,  O.TotalGastos TG, O.Cliente1 Cl1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.TipoOp In ('MMPCLM', 'MMPIM', 'MMPEM', 'MMSIMV', 'MMFCMV', 'MMONM', 'MMPCCM','MMCPM') ")
SQL.ADD("   and O.Indice = '"~Val(ic:1)~"' ")
SQL.ADD("   and O.NrOperacion = C.NrOperacion ")
SQL.ADD("   and C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif


*--> Si (FECHA1) SI es el primer dia habil del mes <--*
***---IF Dialogo.Fecha1 = PriDeMes(Dialogo.Fecha1, NO, 'ARG')
   MESSAGE (' Es primer dia habil '~Dialogo.Fecha1 )
   SQL.ADD(" Union All ")   

   *--> Operaciones U.V. vigentes al último dia del mes anterior y que no venzan en la (FECHA1) 
   SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, O.Cantidad CapOr, O.Cantidad CAmort, O.CantidadOri COri, 0 AmortOri, O.Coeficiente Coef, O.Especie Esp, ")
   SQL.ADD(" Null FOp, O.FechaOp FIni, O.FechaVto FFin, O.ImpComCor1 ImpCC1, O.ImpComCor2 ImpCC2, O.ImpComCorEq2 ImpCCE2, O.ImpGastos1 ImpG1, ")
   SQL.ADD(" O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, O.IntDevengados1 IntDev1, O.MB1 MB1, O.MB3 MB3, O.NrOperacion NrOp, 0 Pr2, 0 Pr8, ")
   SQL.ADD(" O.OperacionRef OpRef, O.Plazo Pl, 0 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, O.PrecioEj PrEj, O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, ")
   SQL.ADD(" O.RB9 RB9, O.ResultadoIndice RIndice, O.Spread Sp, O.TasaBase TBa, 0 Ta3, O.TasaImp1 TImp1, O.TasaPrecan TPC, 0 Ta1, O.TipoOp Tipo, ")
   SQL.ADD(" O.TipoCambio2 TC2, O.TotalAux4 Alias1, O.TotalComisiones TComi, O.TotalIntereses TInt, O.TotalIVA TIva, O.TotalNetoCli2 IntTot, ")
   SQL.ADD(" O.TotalRetenciones TRet, O.TotalBrutoCli1 TBC1, O.TotalBrutoCli2 TBC2, O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, 0 C4, 1 Uni_Mul, ")
   SQL.ADD(" 0 C5, 0 C6, 0 C7, 0 Cuota, 0 To5, 0 To6, 0 To8, 0 To9, O.DeltaTasa DT, O.PlazoGracia PG, O.PeriodoInts PerInt, O.TotalAux1 Alias2, ")
   SQL.ADD(" O.TotalAux2 Alias3, O.TotalAux3 Alias4 , O.TotalGastos TG, '' Cl1 ")
   SQL.ADD(" From "~DBO~".OPERACIONES O")
   SQL.ADD(" Where O.TipoOp In ('MMPCL', 'MMPI', 'MMPE', 'MMPSI', 'MMFRN', 'MMON', 'MMPCCV','MMCP') ")
   SQL.ADD("   and O.Indice = '"~Val(ic:1)~"' ")   
   ***---SQL.ADD("   and O.FechaVto > '"~IdxDate(Val(fm:1))~"' ")
   SQL.ADD("   and O.FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   Endif

   SQL.ADD(" Union All ")

   *--> Operaciones M.V. vigentes al último dia del mes anterior y que no venzan en la (FECHA1) <--*
   SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, C.Cantidad2 CapOr, ")

   SQL.ADD("       CASE WHEN  TipoOp = 'MMSIM'   THEN   C.Cantidad4                                                             ")                     
   SQL.ADD("                                     ELSE   CASE     WHEN  O.TipoOp = 'MMONM'                                       ")    
   SQL.ADD("                                                     THEN  C.Cantidad4                                              ")                     
   SQL.ADD("                                                     ELSE  C.Cantidad1       END                                    ")
   SQL.ADD("       End CAmort,   C.Cantidad2Ori COri, C.Cantidad1Ori AmortOri,                                                    ")

   SQL.ADD(" C.Coeficiente Coef, O.Especie Esp, O.FechaOp FOp, C.Fecha1 FIni, C.Fecha2 FFin, O.ImpComCor1 ImpCC1, O.ImpComCor2 ImpCC2, ")
   SQL.ADD(" O.ImpComCorEq2 ImpCCE2, O.ImpGastos1 ImpG1, O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, O.IntDevengados1 IntDev1, ")
   SQL.ADD(" O.MB1 MB1, O.MB3 MB3, O.NrOperacion NrOp, C.Precio2 Pr2, C.Precio8 Pr8, '' OpRef, C.Plazo1 Pl, C.Plazo3 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, ")
   SQL.ADD(" O.PrecioEj  PrEj, O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, O.RB9 RB9, O.ResultadoIndice RIndice, C.Precio4 Sp, O.TasaBase TBa, ")
   SQL.ADD(" C.Tasa3 Ta3, O.TasaImp1 TImp1, O.TasaPrecan TPC, C.Tasa1 Ta1, O.TipoOp Tipo, O.TipoCambio2 TC2, C.Tasa2 Alias1, O.TotalComisiones ")
   SQL.ADD(" TComi, C.Cantidad3 TInt, C.Total4 TIva, C.Total3 IntTot, O.TotalRetenciones TRet, O.TotalBrutoCli1 TBC1, O.TotalBrutoCli2 TBC2, ")
   SQL.ADD(" O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, C.Cantidad4 C4, 2 Uni_Mul, C.Cantidad5 C5, C.Cantidad6 C6, C.Cantidad7 C7, C.NrCuota Cuota, ")
   SQL.ADD(" C.Total5 To5, C.Total6 To6, C.Total8 To8, C.Total9 To9, O.DeltaTasa DT, O.PlazoGracia PG, O.PeriodoInts PerInt, O.TotalAux1 Alias2, ")
   SQL.ADD(" O.TotalAux2 Alias3, O.TotalAux3 Alias4 ,  O.TotalGastos TG, O.Cliente1 Cl1 ")
   SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" Where O.TipoOp In ('MMPCLM', 'MMPIM', 'MMPEM', 'MMSIMV', 'MMFCMV', 'MMONM', 'MMPCCM', 'MMCPM') ") 
   SQL.ADD("   and O.Indice = '"~Val(ic:1)~"' ")
   SQL.ADD("   and O.NrOperacion = C.NrOperacion ")
   ***---SQL.ADD("   and C.Fecha2 > '"~IdxDate(Val(fm:1))~"' ")
   SQL.ADD("   and C.Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("   and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   Endif
***---ENDIF

SQL.ADD(" Order by FFin, Tipo, NrOp ")

*--> (ic:1) = Variable INDICEDEFA
*--> (fm:1) = Primer día Hábil del mes
*--> (fc:1) = Fecha Vto de la cuota anterior
*--> (fa:1) = Dia habil anterior a la fecha vto. de la cuota
*--> (cx:1) = CER (anterior a la fecha vto. de la primera cuota)
*--> (cp:1) = CER (actual)
*--> (cp:2) = COEF
*--> (cp:3) = Cap. Ajust.
*--> (cp:4) = Ajust. Amort.
*--> (cp:5) = Amort. Ajust.
*--> (cp:6) = Cap. Luego Amort. (Proxima cuota)
*--> (pc:1) = Cuota anterior

Recorrer SQL
   *--> Si la operación es U.V. <--*
   IF FBN['Uni_Mul'] = 1
      ***/// Fecha de indice CER aplicable para hoy -1 
      ACD(FC:1, Habiles(Dialogo.Fecha1, -1, 'ARG', SI))  

      ***/// Fecha de indice CER aplicable para ayer -1 
      ACD(FC:2, Habiles(Dialogo.Fecha1, -2, 'ARG', SI))  

      ***/// Fecha de indice CER aplicable para el inicio -1 
      ACD(FC:3, Habiles(FBN('FIni'), -1, 'ARG', SI))  

      ***/// Coeficiente aplicable
      ACN(cp:1,  COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,Val(FC:2),1))

      ***/// Coeficiente acumulado a mostrar
      ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,Val(FC:3),1))

      *--> Calcula Cap. Orig. y Cap. Amort.  
      ACN(cp:3, FBN['CapOr'] * Val(cp:1) )
  
     *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig y Cap.Amort <--*
      (.'AJUCERUV'.)

   Else
   *--> Si la operación es M.V. <--*

      ***/// Fecha de indice CER aplicable para hoy -1 
      ACD(FC:1, Habiles(Dialogo.Fecha1, -1, 'ARG', SI))  

      ***/// Fecha de indice CER aplicable para ayer -1 
      ACD(FC:2, Habiles(Dialogo.Fecha1, -2, 'ARG', SI))  

      ***/// Fecha de indice CER aplicable para el inicio de la cuota -1 
      ACD(FC:3, Habiles(FBN('FIni'), -1, 'ARG', SI))

      ***/// Fecha de indice CER aplicable para el inicio de la Op -1 
      ACD(FC:4, Habiles(FBN('FOp'), -1, 'ARG', SI))  

      ***/// Coeficiente aplicable
      ACN(cp:1,  COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,Val(FC:2),1))

      ***/// Coeficiente acumulado a mostrar
      ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,Val(FC:3),1))

      ***/// Ajusta el Valor Nominal
      ACN(cp:3, FBN['CapOr'] *  Val(cp:1))

      ***/// Ajusta Imp Amort
      IF FBN['Cuota'] > 1
         ***/// Indice CER a la Fecha de inicio de la Op
         ACN(cx:1, COTIZACION(Val(ic:1),,,,Val(FC:4),1) )
         ***/// El Imp Amort como no fue ajustado en la cuota anterior, se ajusta de punta a punta contra el Imp Amort Original.
         ACN(cp:5, FBN['AmortOri'] * (COTIZACION(Val(ic:1),,,,Val(FC:1),1) / Val(cx:1)) )    
      Else
         ACN(cp:5, FBN['CAmort'] * Val(cp:1) )
      Endif

      ***/// Ajusta VN de la cuota siguiente
      ACN(cp:6, Val(cp:3) - Val(cp:5) )

      *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig, Cap.Amort y prox. cuota <--*
      (.'AJUCERMV'.)
   ENDIF

   ACN(um:1, FBN['Uni_Mul'] -1)
  
   *--> Busca las comisiones vigentes para la cuota que esta siendo ajustada
   (.'COMICER'.)

   *--> Actualizo la operacion con los Campos (y a los q influyen estos) q sean alterados x el Cap.Orig y Cap.Amort  
   (.'AJUCERUPD'.)

   EjecutarEvento('TTNOP', NrOperacion1 = FBN['NrOp'], Entero1 = Val(um:1), NrOperacion2 = '', Lista1 = '')

   SQL.ActualizarMovimientos3(FBN['NrOp'], SI, NO, NO, NO, SI, 0)
   Sql.Exec
Proximo