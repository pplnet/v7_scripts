*HOJAVISIBLE(SI)
CrearDialogo
    Check1 : 'Procesa'                ;;;;;;;;;0
*    Fecha1  :     'Fecha Actualizacion'      ;1;1;;;;;;;Fsys-30;
    Fecha2  :     'Fecha Proceso'            ;2;1;;NO;NO;;;;Fsys;
FinDialogo

if Not Ok
   Cancelar
endif

IF Dialogo.Check1=1

SQL.ADD(" delete "~DBO~".MOVPOSEJEFUT where NrSaldo= 47 ")
SQL.NEW
SQL.EXEC
SQL.ADD(" delete "~DBO~".MOVPOSPENFUT where NrSaldo= 47 ")
SQL.NEW
SQL.EXEC
SQL.ADD(" delete "~DBO~".POSICIONESFUT where NrSaldo= 47 ")
SQL.NEW
SQL.EXEC

SQL.ADD("Select NrOperacion,FechaOp,FechaVto,FechaVto2,Especie,Vehiculo1, ")
SQL.ADD(" Case TipoOp When 'FXCF' Then Cantidad Else Cantidad*-1 End Cantidad, ")
SQL.ADD("Precio1,Book1,Mercado,ContraEspecie, 'FM' as TipoNegocio  ")
SQL.ADD("  from "~DBO~".OPERACIONES where TipoOp in ('FXCF','FXVF') ")
*SQL.ADD("   AND FechaVto >= "~IdxDate2(Dialogo.Fecha1)~"   ")
*SQL.ADD("       and NrOperacion not in (Select Distinct(Nroperacion) from "~DBO~".MOVPOSEJEFUT where NrSaldo= 47) ")
*SQL.ADD("       and NrOperacion not in (Select Distinct(Nroperacion) from "~DBO~".MOVPOSPENFUT where NrSaldo= 47) ")
SQL.ADD(" Order By NrOperacion ")
watch(SQL.BATCH())
* Cantidad de ops
acn(ca:1,0)

Recorrer SQL
   Message('Operacion '~fbn['NrOperacion'])
   ** Actualizo Movimientos de la operacion

 SQL.ADD("Insert into "~DBO~".MOVPOSEJEFUT ")   
   SQL.ADD(" (FechaMov,      Cliente,       Vehiculo,     NrSaldo, Especie, ")
   SQL.ADD("  FechaFut,      FechaEj,       Cantidad,      Precio, Mercado, ")
   SQL.ADD("      Book,  TipoNegocio,    NrOperacion,      Moneda,")
   SQL.ADD("    Unidad,       Centro,         Sector,    Sucursal, Producto,")
   SQL.ADD("   CallPut,   Estrategia,        Cartera,      Trader,")
   SQL.ADD("Responsable, TipoPosicion,  GrupoEspecie, CarteraBCRA) ")
   SQL.ADD("  Values ")
   SQL.ADD(" ('"~IdxDate(fbn('FechaOp'))~"', '"~fbn('Vehiculo1')~"', '"~fbn('Vehiculo1')~"', 47, '"~fbn('Especie')~"', ")
   SQL.ADD("  '"~IdxDate(fbn('FechaVto'))~"', '"~IdxDate(fbn('FechaVto2'))~"', "~Fstr(fbn('Cantidad'),0,2)~", "~Fstr(fbn('Precio1'),0,8)~", '"~fbn('Mercado')~"',  ")
   SQL.ADD("  '"~fbn('Book1')~"', '"~fbn('TipoNegocio')~"', '"~fbn('NrOperacion')~"', '"~fbn('ContraEspecie')~"', ")
   SQL.ADD("  '','','','','','','','','','','','','') ")
   SQL.NEW
   If fbn('FechaVto') <= Dialogo.Fecha2
      SQL.ADD("Insert into "~DBO~".MOVPOSEJEFUT ")   
   Else   
      SQL.ADD("Insert into "~DBO~".MOVPOSPENFUT ")   
   Endif
   SQL.ADD(" (FechaMov,      Cliente,       Vehiculo,     NrSaldo, Especie, ")
   SQL.ADD("  FechaFut,      FechaEj,       Cantidad,      Precio, Mercado, ")
   SQL.ADD("      Book,  TipoNegocio,    NrOperacion,      Moneda,")
   SQL.ADD("    Unidad,       Centro,         Sector,    Sucursal, Producto,")
   SQL.ADD("   CallPut,   Estrategia,        Cartera,      Trader,")
   SQL.ADD("Responsable, TipoPosicion,  GrupoEspecie, CarteraBCRA) ")
   SQL.ADD("  Values ")
   SQL.ADD(" ('"~IdxDate(fbn('FechaVto')+1)~"', '"~fbn('Vehiculo1')~"', '"~fbn('Vehiculo1')~"', 47, '"~fbn('Especie')~"', ")
   SQL.ADD("  '"~IdxDate(fbn('FechaVto'))~"', '"~IdxDate(fbn('FechaVto2'))~"', "~Fstr(fbn('Cantidad')*-1,0,2)~", "~Fstr(fbn('Precio1'),0,8)~", '"~fbn('Mercado')~"',  ")
   SQL.ADD("  '"~fbn('Book1')~"', '"~fbn('TipoNegocio')~"', '"~fbn('NrOperacion')~"', '"~fbn('ContraEspecie')~"', ")
   SQL.ADD("  '','','','','','','','','','','','','') ")
   SQL.NEW
   SQL.EXEC  
   SCN(ca:1,1)
Proximo
Messagebox('Se procesaron '~pyc(Val(ca:1),1,0)~' Operaciones')
Else
Messagebox('No se procesa!!!!!!!!')
Endif



If NO
CrearDialogo
    Fecha1  :     'Fecha Actualizacion'      ;1;1;;;;;;;Fsys-30;
    Fecha2  :     'Fecha Proceso'            ;2;1;;NO;;;;;Fsys;
FinDialogo

if Not Ok
   Cancelar
endif

SQL.ADD("Select NrOperacion,FechaOp,FechaVto2,Especie,Vehiculo1,Cantidad, ")
SQL.ADD("Precio1,Book1,Mercado,ContraEspecie, 'FM' as TipoNegocio  ")
SQL.ADD("  from "~DBO~".OPERACIONES where TipoOp in ('FXCF','FXVF') ")
SQL.ADD("   AND FechaVto2 >= "~IdxDate2(Dialogo.Fecha1)~"   ")

Recorrer SQL
   Message('Operacion '~fbn['NrOperacion'])
   ** Actualizo Movimientos de la operacion
   SQL.ActualizarMovimientos3(fbn['NrOperacion'],NO,NO,NO,SI,NO)
   SQL.EXEC
   SCN(ca:1,1)
Proximo

Messagebox('Se procesaron '~pyc(Val(ca:1),1,0)~' Operaciones')
SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONESFUT P ")
SQL.ADD("  where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha2)~" ")
SQL.ADD("    AND P.NrSaldo    = 47 ")
SQL.ADD("    AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONESFUT ")
SQL.ADD("                   WHERE  Especie  = P.Especie  ")
SQL.ADD("                   AND    Vehiculo = P.Vehiculo ")
SQL.ADD("                   AND    NrSaldo  = P.NrSaldo  ")
SQL.ADD("                   AND    Cliente  = P.Cliente  ")
SQL.ADD("                   AND    Mercado  = P.Mercado  ")
SQL.ADD("                   AND    FechaFut = P.FechaFut ")
SQL.ADD("                   AND    Moneda   = P.Moneda  ")
SQL.ADD("                   AND    Book     = P.Book     ")
SQL.ADD("                   AND   (Sector   = P.Sector   OR (Sector   IS NULL AND P.Sector   IS NULL) ) ")
SQL.ADD("                   AND   (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
SQL.ADD("                   AND   (Cupon    = P.Cupon    OR (Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
SQL.ADD("                   AND   (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
SQL.ADD("                   AND   (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
SQL.ADD("                   AND   Fecha     <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD("                  ) ")
watch(SQL.BATCH())

Recorrer SQL

  ACD(a:FAC, fbn('Fecha'))
  ACT(b:FAC, fbn('Cliente'))
  ACT(c:FAC, fbn('Vehiculo'))
  ACT(d:FAC, fbn('Especie'))
  ACN(e:FAC, fbn('NrSaldo'))
  ACN(f:FAC, fbn('CantidadFin'))
  ACN(g:FAC, fbn('PrecioFin'))
  ACN(h:FAC, fbn('PrecioReset'))
  ACN(i:FAC, COTIZACIONC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'ARP'))
  ACN(n:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1))
  ACT(o:FAC, BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
  ACN(p:FAC, COTIZACIONC(Val(o:FAC),,,,Dialogo.Fecha1,25,SI,'ARP'))
  ACN(q:FAC, Val(n:FAC)*Val(p:FAC))
  
  SQL.ADD("EXEC "~DBO~".RecalculaPosicionesFut ")
         SQL.ADD(IdxDate2(Dialogo.Fecha1)~", ")
         SQL.ADD(" '"~FBN['Cliente']~"', ")
         SQL.ADD(" '"~FBN['Vehiculo']~"', ")
         SQL.ADD(" '"~FBN['Unidad']~"', ")
         SQL.ADD(" '"~FBN['Centro']~"', ")
         SQL.ADD(" '"~FBN['Sector']~"', ")
         SQL.ADD(" '"~FBN['Sucursal']~"', ")
         SQL.ADD(" "~Fstr(FBN['NrSaldo'],3,0)~", ")
         SQL.ADD(" '"~FBN['Especie']~"', ")
         SQL.ADD(" NULL,")
         SQL.ADD(" NULL,")
         SQL.ADD(" '"~FBN['CallPut']~"', ")
         SQL.ADD(" '"~FBN['Cupon']~"', ")
         SQL.ADD(" '"~FBN['Estrategia']~"', ")
         SQL.ADD(" '"~FBN['Cartera']~"', ")
         SQL.ADD(" '"~FBN['Book']~"', ")
         SQL.ADD(" '"~FBN['Trader']~"', ")
         SQL.ADD(" '"~FBN['TipoNegocio']~"', ")
         SQL.ADD(" '"~FBN['Responsable']~"', ")
         SQL.ADD(" '"~FBN['TipoPosicion']~"', ")
         SQL.ADD(" '"~FBN['Producto']~"', ")
         SQL.ADD(" '"~FBN['GrupoEspecie']~"', ")
         SQL.ADD(" '"~FBN['CarteraBCRA']~"', ")
         SQL.ADD(" '"~FBN['Mercado']~"', ")
         SQL.ADD(" '"~IdxDate(FBN['FechaFut'])~"', ")
         SQL.ADD(" '"~FBN['Moneda']~"' ")
         SQL.NEW
         SQL.EXEC
Proximo
Endif

