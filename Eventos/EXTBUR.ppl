HojaVisible(NO)
CrearDialogo
     NrOrden1 : 'Nro. Orden:' ;;;;;;NoVacio(Dialogo.NrOrden1);'Debe Ingresar un Numero de Orden';NO;;;;;;'###.###'
     Fecha1   : 'FechaAlta :' ;;;;NO;NO
     Radio3   : 'MAE|No|Si'   ;;;;;;;;;0;
     Cantidad1: 'Cantidad VN' ;;;;;;;;;0;
     Cantidad2: 'Monto Neto'  ;;;;;;;;;0;
     Cantidad3: 'Interes'     ;;;;;;;;;0;
     Cantidad4: 'Monto'       ;;;;;;;;;0;
FinDialogo

If Not Ok
   Cancelar
EndIf

*- Fecha de la Operacion
ACD(fe:1, Fsys)
If NoVacio(Dialogo.Fecha1)
   ACD(fe:1, Dialogo.Fecha1)
EndIf

*-Busco la orden ingresada
SQL.ADD("SELECT 1 Cant FROM "~DBO~".ORDENES ")
SQL.ADD("WHERE NrOrden='"~Dialogo.NrOrden1~"' " )

Recorrer Sql

If FBN['Cant'] = 0 
   MessageBox('No existe la orden nro. '~Dialogo.NrOrden1) 
Else
   SQL.ADD("SELECT O.Lotes,O.Leyenda6,O.PrecioReal,O.CB6,")
   SQL.ADD("O.TipoOrden,O.Especie,O.FechaVto,O.CantidadTotalOrden,")
   SQL.ADD("O.Cliente,O.ContraEspecie,O.MinArancel,O.RB9,O.RB10,")
   SQL.ADD("O.PrecioEjercicio,O.Impuestos,O.TotalAux1,O.CantidadEnProceso,O.Mercado,")
   SQL.ADD("O.Vehiculo,O.FechaConcrecion,O.TotalAux2,O.RB2,")
   SQL.ADD("O.TotalAux3,O.RB1,O.TotalIVA,O.CB9,O.Cuenta1,O.Cuenta4,O.NrOrden,")
   SQL.ADD("O.Cantidad1,O.Cuenta2,O.Cantidad2,O.Cuenta3,O.Cantidad3,O.Operador,")
   SQL.ADD("E.CodMAEContado,E.Cupon,E.InteresesC,E.FechaCambioTasa,")
   SQL.ADD("E.TasaIntAnterior,E.TasaIntVigente, E.CodMAEContado,O.TamanioBloque, O.AmbitoNeg ")
   SQL.ADD("FROM "~DBO~".ORDENES O,"~DBO~".ESPECIES E")
   SQL.ADD("WHERE O.NrOrden='"~Dialogo.NrOrden1~"' and O.Especie = E.Codigo " )
   SQL.ADD("       and ")
   SQL.ADD("       ( (O.RB2 =0 and (O.CantidadTotalOrden <> isnull(O.CantidadCompletada,0))) ")
   SQL.ADD("      or (O.RB2 =1 and (O.TotalAux1 <> isnull(O.Cantidad8,0)))  ) ")
   Recorrer Sql
       ACD(fe:2, HABILES(Val(fe:1),(FBN['Lotes'] DIV 24), FBN['Leyenda6']))
       ACT(z2, FECHA(SQLAHORA))
       ACT(z3, HORA(SQLAHORA))
       Message('*- Recorro todas las ordenes que me selecciono.')

       IF NoVacio(FBN['CodMAEContado'])
          ACT(z6, '0')
       ELSE
          ACT(z6, '1')
       ENDIF

       *- Recorro todas las ordenes que me selecciono.
       If FBN['PrecioReal']<>0
          IF EqStr(FBN['TipoOrden'], 'TIC')             
             *- Una Orden TIC (Compra el Cliente) genera una TIV (Vende Banco a Cliente)
             ACT(z1,GetNumerador(1))  
           
             ACT(z10, FStr(NrCupon2(FBN['Especie'],FBN['FechaVto']),0,0))  
    
             *- Busco la cotizacion de la operacion respecto del COTIZAEN
             ACN(z11,IIF(Eqstr(CotizaEn(FBN['Especie']),FBN['ContraEspecie']),1,CotizacionC(FBN['ContraEspecie'],,,,Val(fe:1),1,SI,CotizaEn(FBN['Especie']))))
                    
             *-El precio se obtuvo de la tabla de autocotizacion, 
             *-por lo tanto cargo Precio1 desde PrecioReal y el CB1 en 0
             SQL.ADD("INSERT INTO "~DBO~".OPERACIONES     ")
             SQL.ADD("(NrOperacion, TipoOp, Especie, Cantidad,                       ")
             SQL.ADD("Precio1, Cliente1,ContraEspecie, FechaOp,                     ")
             SQL.ADD("Plazo, FechaVto, PorComision, FormaLiquidacion1,              ")
             SQL.ADD("FormaLiquidacion2, TipoCambio, TotalIntereses, TotalNetoCli1, ")
             SQL.ADD("TotalBrutoCli1, Mercado, Vehiculo1, Operador,                 ")
             SQL.ADD("TablaFeriados1, TasaInteresesCupon, FechaUltCupon, TasaBase,  ") 
             SQL.ADD("RB1, Cartera, TotalComisiones, CB9,                           ")
             SQL.ADD("Cuenta1, Cuenta4, EnteCus1, AmbitoNeg, Cupon1,                ")
             SQL.ADD("NrOrden1, NrOrden, FechaCargaSys,FechaCarga, Plazo2,                   ") 
             SQL.ADD("CB7,CanPosTrad,CanPosInv1,CanPosInv2,                         ")
             SQL.ADD("CanPosOSoc,PaseCB,InteresesCorr,TotalAux1,CB6)           ")
             SQL.ADD("VALUES                                                        ")
             SQL.ADD(" ('"~Val(z1)~"', 'TIV', '"~FBN['Especie']~"', "~Fstr(Dialogo.Cantidad1,0,2)~",                                 ")
             SQL.ADD(" "~Fstr(FBN['PrecioReal'],0,8)~", '"~FBN['Cliente']~"', '"~FBN['ContraEspecie']~"', '"~IdxDate(Val(fe:1))~"',  ")
             SQL.ADD(" "~FStr(FBN['Lotes'],0,0)~", '"~IdxDate(Val(fe:2))~"', "~Fstr(FBN['MinArancel'],0,7)~", '"~FBN['RB9']~"',      ")
*/           SQL.ADD(" '"~FBN['RB10']~"', "~Fstr(FBN['PrecioEjercicio'],0,7)~", "~Fstr(FBN['Impuestos'],0,8)~", "~Fstr(FBN['TotalAux1'],0,8)~", ")
             * FormaLiquidacion2
             SQL.ADD(" '"~FBN['RB10']~"', "~Fstr(FBN['PrecioEjercicio'],0,7)~", "~Fstr(Dialogo.Cantidad3,0,8)~", "~Fstr(Dialogo.Cantidad2,0,2)~", ")
             * TotalBrutoCli1
             SQL.ADD(" "~Fstr(Dialogo.Cantidad4,0,2)~", '"~FBN['Mercado']~"', '"~FBN['Vehiculo']~"', '"~USUARIOACTIVO~"', ")
             * TablaFeriados
             SQL.ADD(" '"~FBN['Leyenda6']~"', "~Fstr(FBN['TotalAux2'],0,8)~", '"~IdxDate(FBN['FechaConcrecion'])~"', "~Fstr(FBN['TotalAux3'],0,8)~", ")
             *RB1
             SQL.ADD(" '0', '"~FBN['RB1']~"', "~Fstr(FBN['TotalIVA'],0,7)~", '"~FBN['CB9']~"', ")
             *CUENTA1
             SQL.ADD(" '"~FBN['Cuenta1']~"', '"~FBN['Cuenta4']~"', '"~FBN['CodMAEContado']~"', '"~FBN['AmbitoNeg']~"',  '"~Val(z10)~"',     ")
             SQL.ADD(" '"~FBN['NrOrden']~"', '"~FBN['NrOrden']~"', '"~IdxDate(Fsys)~"' , GetDate(), "~FStr((FBN['Lotes'] DIV 24),0,0)~", ")
*09/03/05             SQL.ADD(" "~Val(z6)~","~Fstr(FBN['CantidadTotalOrden'],0,2)~",0,0,   ")
             SQL.ADD(" "~Val(z6)~","~Fstr(Dialogo.Cantidad1,0,2)~",0,0,            ")
             SQL.ADD(" 0,'0',"~Fstr(FBN['TamanioBloque'],0,2)~","~Fstr(val(z11),0,7)~",'"~FBN['CB6']~"' ) ")
             SQL.NEW
           
             SQL.ADD("UPDATE "~DBO~".ORDENES ")
             SQL.ADD("SET NrOperacion2 = '"~Val(z1)~"' ,  ")
             if fbn('RB2')=1
                 SQL.ADD("    Cantidad8 = Cantidad8 + "~Fstr(Dialogo.Cantidad2,0,2)~" ")
             else
                 SQL.ADD("    CantidadCompletada =CantidadCompletada + "~Fstr(Dialogo.Cantidad1,0,2)~" ")
             endif

             SQL.ADD("WHERE NrOrden = '"~FBN['NrOrden']~"' ") 
             SQL.NEW
             SQL.EXEC
              
             Message('Actualizo Movimientos y Saldo ' )
              
             SQL.ActualizarMovimientos4(Val(z1),SI,SI,SI,SI,SI,SI)
             SQL.EXEC            
             
             *- Alta en la Instancia nro.1 
             ACT(az3,Val(z1))
             ACT(az4,'OPERACIONES')
             If Dialogo.Radio3=0
                *- No mae 
                ACT(az5,'10|')
             Else
                ACT(az5,'50|')
             EndIf
             (.'ALTAINSTAN'.)           
          Else
             *- Una Orden TIV (Vende el Cliente) genera una TIC (Compra Banco a Cliente)
             *- Calculos e insercion para la Cuenta1

             *09/03/05
             ACT(cb:6,FBN['CB6'])
             ACN(rs:1, Dialogo.Cantidad1-FBN['Cantidad1'])
             If NoVacio(FBN['Cuenta1'])
                *- Parametros para la funcion 
                ACT(cu:1, FBN['Cuenta1'])
*09/03/05       ACN(ca:1, FBN['Cantidad1'])
                If Dialogo.Cantidad1<=FBN['Cantidad1']
                   ACN(ca:1, Dialogo.Cantidad1)
                Else
                   ACN(ca:1, FBN['Cantidad1'])
                Endif
                ACN(pr:1, FBN['PrecioReal'])
                ACT(e:1,  FBN['Especie'])
                ACD(fo:1, Val(fe:2))
                ACD(fc:1, FBN['FechaCambioTasa'])
                ACN(ta:1, FBN['TasaIntAnterior'])
                ACN(tv:1, FBN['TasaIntVigente'])

                (.'DISCUENTAS'.)
                *- Fin de los calculos para la Cuenta1                         
             Endif 
                     
             *- Calculos e insercion para la Cuenta2
* 09/03/05   If NoVacio(FBN['Cuenta2']) y FBN['Cantidad2']<>0
             If NoVacio(FBN['Cuenta2']) y FBN['Cantidad2']<>0 y Val(rs:1)<>0
                *- Parametros para la funcion 
                ACT(cu:1, FBN['Cuenta2'])
* 09/03/05      ACN(ca:1, FBN['Cantidad2'])
                If Val(rs:1)<=FBN['Cantidad2']
                   ACN(ca:1, Val(rs:1))
                Else
                   ACN(ca:1, FBN['Cantidad2'])
                Endif
                * 09/03/05
                ACN(rs:1, Val(rs:1)-FBN['Cantidad2'])
                ACN(pr:1, FBN['PrecioReal'])
                ACT(e:1,  FBN['Especie'])
                ACD(fo:1, VAl(fe:2))
                ACD(fc:1, FBN['FechaCambioTasa'])
                ACN(ta:1, FBN['TasaIntAnterior'])
                ACN(tv:1, FBN['TasaIntVigente'])
                (.'DISCUENTAS'.)
                *- Fin de los calculos para la Cuenta2                         
             Endif
                     
             *- Calculos e insercion para la Cuenta3
*09/03/05    If NoVacio(FBN['Cuenta3']) y FBN['Cantidad3']<>0
             If NoVacio(FBN['Cuenta3']) y FBN['Cantidad3']<>0 y Val(rs:1)<>0
                *- Parametros para la funcion 
                ACT(cu:1, FBN['Cuenta3'])
*09/03/05       ACN(ca:1, FBN['Cantidad3'])
                If Val(rs:1)<=FBN['Cantidad3']
                   ACN(ca:1, Val(rs:1))
                Else
                   ACN(ca:1, FBN['Cantidad3'])
                Endif
                ACN(pr:1, FBN['PrecioReal'])
                ACT(e:1,  FBN['Especie'])
                ACD(fo:1, Val(fe2))
                ACD(fc:1, FBN['FechaCambioTasa'])
                ACN(ta:1, FBN['TasaIntAnterior'])
                ACN(tv:1, FBN['TasaIntVigente'])
                (.'DISCUENTAS'.)
                *- Fin de los calculos para la Cuenta3                         
             Endif                       
         Endif
         Message('Finalizada Actualizacion de OPERACIONES')                                                                                     
       Endif         
   Proximo
Endif
Proximo
