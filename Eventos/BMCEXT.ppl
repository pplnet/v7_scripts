CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif
    
if NOt ExisteDirectorio(VAR("BMOVCTAS"))
     MessageBox("No existe el directorio"~VAR("BMOVCTAS"))
     Cancelar
endif


SQL.ADD("select Cuenta1,TipoTr2,Precio1,NrTrans,Cliente1 from dbo.TRANSACCIONES2 TR")
SQL.ADD("where TR.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TR.Mercado1='MERINT' and TR.TipoTr2 in ('LCUPON','DEB','RET')")
SQL.ADD("and not exists (select 1 from dbo.MOVCTASEXT MOV where MOV.IdReferencia=TR.NrTrans and MOV.TipoReferencia='V' and Accion  in ('EN'))")
ACN(aa:3,0)
ACT(bb:1,"N")
Recorrer SQL
    if EqStr(Val(bb:1),"N")
        AbrirASCII(VAR("BMOVCTAS")~"\MOCTAEX"~"["~copy(IdxDate(SQLAHORA),1,4)~copy(IdxDate(SQLAHORA),6,2)~copy(IdxDate(SQLAHORA),9,2)~"-"~copy(Hora(SQLAhora),1,2)~copy(Hora(SQLAhora),4,2)~copy(Hora(SQLAhora),7,2)~"]",0)
        EscribirASCII("00"~Pad("MOVIMIENTOS",15)~Pad("TITULOS",15)~copy(IdxDate(Dialogo.Fecha1),1,4)~copy(IdxDate(Dialogo.Fecha1),6,2)~copy(IdxDate(Dialogo.Fecha1),9,2)~copy(IdxDate(Dialogo.Fecha1),1,4)~copy(IdxDate(Dialogo.Fecha1),6,2)~copy(IdxDate(Dialogo.Fecha1),9,2)~copy(Hora(SQLAhora),1,2)~copy(Hora(SQLAhora),4,2)~copy(Hora(SQLAhora),7,2)~Pad(USUARIOACTIVO,16)~Pad('',130))7
    endif    
        

    ACT(bb:1,"S")
    ACT(aa:1,SQL("select replace(CUIT,'-','') from dbo.clientes where codigo='"~fbn('Cliente1')~"'" ))
    ACT(aa:2,SQL("select RazonSocial from dbo.clientes where codigo='"~fbn('Cliente1')~"'" ))
    ACN(aa:3,Val(aa:3)+1)
    ACN(aa:4,Val(aa:4)+Fbn('Precio1'))
    if EqStr(fbn('TipoTr2'),'RET') and EqStr(fbn('TipoTr2'),'LCUPON')
        EscribirASCII("10"~Pad(fbn('Cuenta1'),16)~"C"~Pad('CODMOV',6)~Pad(fbn('Precio1'),15)~Pad(fbn('NrTrans'),8)~Pad('IDENTIFICADOR',20)~"S"~Pad(Val(aa:1),11)~Pad(Val(aa:2),50)~Pad('',68))
    else
        EscribirASCII("10"~Pad(fbn('Cuenta1'),16)~"D"~Pad('CODMOV',6)~Pad(fbn('Precio1'),15)~Pad(fbn('NrTrans'),8)~Pad('IDENTIFICADOR',20)~"S"~Pad(Val(aa:1),11)~Pad(Val(aa:2),50)~Pad('',68))
    endif      
    SQL("Insert into MOVCTASEXT values('B','"~fbn('NrTrans')~"','V','"~fbn('Cliente1')~"','EN',NULL,NULL,convert(varchar(8),Getdate(),112),substring(convert(varchar(12),Getdate(),108),1,2)+
    substring(convert(varchar(12),Getdate(),108),4,2)+substring(convert(varchar(12),Getdate(),108),7,2),convert(varchar(8),Getdate(),112),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL)")
Proximo
if EqStr(Val(bb:1),"S")
    EscribirASCII("99"~Pad(Val(aa:3),10)~Pad(Val(aa:4),17)~Pad('',169))
    CerrarASCII
endif