CrearDialogo
  NrOrden:   'NrOrden'         ;1;1;;;;
  TipoOrd1:  'TipoOrden'       ;2;1;;;;
  Fecha1:    'FechaOrden'      ;3;1;;;;
  Especie1:  'Especie'         ;4;1;;;;
  Cliente1:  'Cliente'         ;5;1;;;;
  Cantidad1: 'Cant.Ejecutada'  ;6;1;;;;
  Precio1:   'Precio Promedio' ;7;1;;;;
  String1:   'NrSecuencia'     ;8;1;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

If EqStr(Dialogo.TipoOrd1,'OTIC')
   ACT(TO:1,'TIC')
Else
   ACT(TO:1,'TIV')
EndIf

SQL.ADD(" Update "~DBO~".OPERACIONESBITS Set ")
SQL.ADD("  Valor = '0' ")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOrden~"' and NrBit=1 ")
SQL.NEW
SQL.EXEC

SQL.ADD(" Update "~DBO~".OPERACIONESBITS Set ")
SQL.ADD("  Valor = '1' ")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOrden~"' and NrBit=9 ")
SQL.NEW
SQL.EXEC

**** Genero la Operacion OTIC/OTIV
SQL.ADD(" Select Cliente, CantidadTotalOrden, Especie, ContraEspecie, ")
SQL.ADD("        Mercado, Mercado2, Mercado3, Mercado4, ")
SQL.ADD("        Vehiculo, Operador, RB9, RB10, Book1, Lotes Plazo, RB5, ")
SQL.ADD("        Cuotas1, CB10, Cupon1, AfectaLS,  ")
** FJL 22/03/21 - Se agregan estos campos para pasar a la operacion
SQL.ADD("        Cuenta1, Cuenta4, Cuenta5, MB2, RuedaMAE, FechaAltaMAE ")
SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~Dialogo.NrOrden~"' ")
Recorrer SQL
  If FBN['Cuotas1']=0
     ACT(CA:1,FBN['CantidadTotalOrden']-Dialogo.Cantidad1)
     SQL.ADD(" Update "~DBO~".ORDENES Set ")
     SQL.ADD("  Cantidad1   = "~FStr(Dialogo.Cantidad1,0,2)~", ")
     SQL.ADD("  Cantidad4   = "~FStr(Dialogo.Precio1,0,8)~", ")
     SQL.ADD("  Cantidad5   = "~FStr(val(CA:1),0,2)~" ")
     SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
     SQL.NEW
     SQL.EXEC
  EndIf
  
*  messagebox(FBN['Plazo'])
*  messagebox(Dialogo.Fecha1)
  
  ACD(FV:1,HABILES(Dialogo.Fecha1,(FBN['Plazo']),'ARG',SI))
  
  ACN(Z:3,(Dialogo.Cantidad1 * Dialogo.Precio1) * CotizacionC(FBN['ContraEspecie'],,,,FSYS,1,SI,VAR('MONEEXTR')) )
  ACN(Z:4,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')) )
  ACN(Z:5,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')) )
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'INV')
     ACN(Z:6,1/Val(Z:4))
  Else
     ACN(Z:6,Val(Z:4))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONELOCA')),'INV')
     ACN(Z:7,1/Val(Z:5))
  Else
     ACN(Z:7,Val(Z:5))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)),'INV')
     ACN(Z:8,1/CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)))
  Else
     ACN(Z:8,CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Dialogo.Especie1)))
  EndIf
  
  ACN(Z:9,CotizacionC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
  
  * z:12 ==> OpSIOPEL
  ACT(Z:12,SQL(" Select CodOperador from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~Dialogo.Cliente1~"' and Estado='DEF' "))
  
** FJL 22/03/21 - toma las cuentas de la orden
IF NO
  * z:11 ==> Cuenta4 - No se usa mas - toma la de la orden
  SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
  SQL.ADD ("  Where Cliente='"~IIF(EqStr(FBN['Mercado2'],VAR('MERCARGC')) Y NoVacio(FBN['Mercado2']),VAR('CLIARGC'),Dialogo.Cliente1)~"' ")
  SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"%') ")
  SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
  SQL.ADD ("    And "~IIF(Not Incluido(FBN['Mercado2'],VAR('MERCARGC')),IIF(NoVacio(FBN['Mercado2'])," Mercado='"~FBN['Mercado2']~"' "," (Mercado is Null or Mercado ='') ")," Mercado in ('BCRA','AC','SWIFT') ")~" ")
  Recorrer SQL
    ACT(Z:11,FBN['Codigo'])
  Proximo
  
  * z:13 ==> Cuenta1 - No se usa mas - toma la de la orden
  SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
  SQL.ADD ("  Where Cliente='"~IIF(EqStr(FBN['Mercado'],VAR('MERCARGC')),FBN['Vehiculo'],Dialogo.Cliente1)~"' ")
  SQL.ADD ("    And (Especies='"~Dialogo.Especie1~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' ")
  SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And "~IIF(NoVacio(FBN['Mercado'])," Mercado='"~FBN['Mercado']~"' "," (Mercado is Null or Mercado ='') ")~" ")
  SQL.ADD (" Order by Codigo ASC ")
  Recorrer SQL
    ACT(Z:13,FBN['Codigo'])
  Proximo
  
  * z:10 ==> Cuenta2 - No se usa mas - Lo recalcula el ModificarOpeacion
  If EqStr(FBN['Mercado'],VAR('MERCARGC')) o EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
     ACT(Z:10,Val(Z:13))
  Else
     ACT(Z:10,CuentaCliente(FBN['Vehiculo'],Dialogo.Especie1,,FBN['Mercado'],Val(TO:1),'HAB'))
  EndIf
  
  * z:14 ==> Cuenta3 - No se usa mas - Lo recalcula el ModificarOpeacion
  If EqStr(FBN['Mercado2'],VAR('MERCARGC')) o EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
     ACT(Z:14,Val(Z:11))
  Else
     If NoVacio(FBN['Mercado2'])
        ACT(Z:14,CuentaCliente(FBN['Vehiculo'],FBN['ContraEspecie'],,FBN['Mercado2'],Val(TO:1),'HAB'))
     Else
        ACT(Z:14,SQL(" Select TOP 1 Codigo from "~DBO~".CUENTAS where Estado = 'HAB' and Cliente='"~FBN['Vehiculo']~"' and (Mercado is Null or Mercado ='') "))
     EndIf
  EndIf
ENDIF  

  ACN(Z:15,COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,FBN['ContraEspecie']))
  ACN(Z:16,MontoGastos(Val(TO:1),Dialogo.Especie1,FBN['Vehiculo'],'DMERC',0,4))

if NO  
  If EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
     ACN(Z:17,0)
  Else
     If FBN['CB10'] <> 0
        ACN(Z:17,0)
     Else
     ACN(Z:17,MontoArancelC(Val(TO:1),Dialogo.Cliente1,Dialogo.Especie1,FBN['Vehiculo'],'AOPER',0,4,'','','','',FBN['Mercado3'],'','','','','',SI))
     EndIf
  EndIf
Endif  

*  ACN(Z:22,(Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:16))/100)
*  ACN(Z:23,(Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:17))/100)
IF NO    
  If Not EqStr(Dialogo.Cliente1,FBN['Vehiculo'])
     ACN(Z:24,VAR('IVACOMACC'))
  Else
     ACN(Z:24,0)
  EndIf


  If EqStr(Val(TO:1),'EQC')
     ACN(Z:18,(Dialogo.Cantidad1*Dialogo.Precio1 + Val(Z:22) + Val(Z:23) + ((Val(Z:22)*Val(Z:24))/100) + ((Val(Z:23)*Val(Z:24))/100)))
  Else
     ACN(Z:18,(Dialogo.Cantidad1*Dialogo.Precio1 - Val(Z:22) - Val(Z:23) - ((Val(Z:22)*Val(Z:24))/100) - ((Val(Z:23)*Val(Z:24))/100)))
  EndIf
ENDIF  
IF NO  
  If EqStr(FBN['ContraEspecie'], Var('MONELOCA'))
     ACN(Z:20,Dialogo.Precio1)
  Else
     If EqStr(MODO(FBN['ContraEspecie'],Var('MONELOCA')),'INV')
        ACN(Z:20 ,Dialogo.Precio1/FBN['TCbioPosUnidad'])
     Else
        ACN(Z:20,Dialogo.Precio1*FBN['TCbioPosUnidad'])
     EndIf
  EndIf
ENDIF  
  * Cupon
  ***** Es ZeroCupon
  ACT(z:26, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1))
  if EqStr(Val(z:26),'SI')    
     ACT(z:25, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1),1,0))
  else
     ACT(z:25, Val(t:4))
  endif
  * Para el CB4=1 es Cuenta y Orden
  ACT(z:27,iif(Eqstr(FBN['Cliente'],FBN['Vehiculo']),'0','1'))
  
  **Datos por SENEBI
  ACT(SS:1,SQL(" Select SenebiSistaco from "~DBO~".UDNS where Codigo = '"~FBN['RuedaMAE']~"' "))
  ACT(SS:2,SQL(" Select NrSecuencia from "~DBO~".EJECUCIONES where NrEjecucion= 1 and NrOrden = '"~Dialogo.NrOrden~"' "))
  *ACT(SS:3, Copy(fbn('FechaAltaMAE'),1,4)~'-'~Copy(fbn('FechaAltaMAE'),6,2)~'-'~Copy(fbn('FechaAltaMAE'),9,2)~' '~Copy(fbn('FechaAltaMAE'),12,2)~':'~Copy(fbn('FechaAltaMAE'),15,2)~':'~Copy(fbn('FechaAltaMAE'),18,2))
  ACT(SS:3,Fecha(FBN['FechaAltaMAE'],'yyyy-mm-dd hh:mm:ss'))

  ACT(Z:2, GetNumerador(1))
  *  ACT(Z:21, GetNumerador(101))
  
  If EqStr(FBN['Mercado3'], Var('AMBBYMA'))
     ACT(yx:1, GetNumerador(96))
  else
     ACT(yx:1, GetNumerador(98))
  endif

  SQL.ADD("Insert Into "~DBO~".OPERACIONES ( ")
  SQL.ADD("  TipoOp, NrOperacion, Especie, Cliente1, FechaOp, ")
  SQL.ADD("  Plazo, FechaVto, FechaPago, Cantidad, Precio1, ")
  SQL.ADD("  ContraEspecie, Mercado, Mercado2, Vehiculo1, ")
  SQL.ADD("  Operador, TablaFeriados1, FormaLiquidacion1, FormaLiquidacion2,  ")
  SQL.ADD("  RB5, ")
  SQL.ADD("  UsrInput, FechaCarga, FechaCargaSys, Numerador, PaseCB, ")
  SQL.ADD("  CB5, OpSIOPEL, ")
** FJL 22/03/21 - Se agregan campos cuenta4 y cuenta5
  SQL.ADD("  Cuenta1, Cuenta4, Cuenta5, ")
  SQL.ADD("  NrOrden1, Mercado4, UDN2, NroAltaMAE, FechaAltaMAE,NumOpeSENEBI,NrOrdenAux, ")
  SQL.ADD("  Cupon1, AfectaLS, ")
  ** FJL 22/03/21 - Se agrega campo -- AA 12/05/2021 Se propaga MB2 (Bloqueo Moneda)
  SQL.ADD("  Book1, MB2, ")
  

  *  SQL.ADD("  Cartera, RB10, Book1, ")
  *  SQL.ADD("  TotalNetoCli1, TotalNetoCli3, Cotizacion1, Cotizacion2, ")
  *  SQL.ADD("  PorImpuestoBolsa, PorDerechoBolsa, RB3, ")
  *  SQL.ADD("  Plazo2, TotalAux1,CB6, OpSIOPEL, ")
  *  SQL.ADD("  CB8, CB9, VTeorico, CanPosTrad, InteresesCorr, ")
  *  SQL.ADD("  CanPosOSoc, TotalBrutoCli2, Mercado3, RB8, ")
  *  SQL.ADD("  ContraEspecie2, TotalAux2, TotalGastos, TotalAux3, ")
  *  SQL.ADD("  Especie1, PorArancel, TotalImpuestos, TotalAux4, ")
  *  SQL.ADD("  TipoCambio2, TipoCambio3, PrecioMer, CB10, NrBoleto, TotalAux7) ")
  SQL.ADD("  Direccion, RB6, CB10, CB4, NrBoleto ")

  SQL.ADD(" ) Values ( ")
  * TipoOp
  SQL.ADD("  '"~Val(TO:1)~"', ")
  * NrOperacion
  SQL.ADD("  '"~Val(Z:2)~"', ")
  * Especie
  SQL.ADD("  '"~Dialogo.Especie1~"', ")
  * Cliente1
  SQL.ADD("  '"~Dialogo.Cliente1~"', ")
  * FechaOp
  SQL.ADD("  '"~IdxDate(Dialogo.Fecha1)~"', ")
  * Plazo
  SQL.ADD("  '"~FBN['Plazo']~"', ")
  * FechaVto
  SQL.ADD("  '"~IdxDate(Val(FV:1))~"', ")
  * FechaPago
  SQL.ADD("  '"~IdxDate(Val(FV:1))~"', ")
  * Cantidad
  SQL.ADD("  '"~FStr(Dialogo.Cantidad1,0,2)~"', ")
  * Precio1
  SQL.ADD("  '"~FStr(Dialogo.Precio1,0,8)~"', ")
  * ContraEspecie
  SQL.ADD("  '"~FBN['ContraEspecie']~"', ")
  * Mercado
  SQL.ADD("  '"~FBN['Mercado']~"', ")
  * Mercado2
  SQL.ADD("  '"~FBN['Mercado2']~"', ")
  * Vehiculo1
  SQL.ADD("  '"~FBN['Vehiculo']~"', ")
  * Operador
  SQL.ADD("  '"~FBN['Operador']~"', ")
  * TablaFeriados1
  SQL.ADD("  '"~Var('FERIDEF')~"', ")
  * FormaLiquidacion1
  SQL.ADD("  '"~FBN['RB9']~"', ")
  * FormaLiquidacion2
  SQL.ADD("  '"~FBN['RB10']~"', ")
  * RB5
  SQL.ADD("  '"~FBN['RB5']~"', ")
  * UsrInput
  SQL.ADD("  '"~USUARIOACTIVO~"', ")
  * FechaCarga
  SQL.ADD("  "~SQLAhora~", ")
  * FechaCargaSys
  SQL.ADD("  '"~IdxDate(FSys)~"', ")
  * Numerador
  SQL.ADD("  1, ")
  * PaseCB
  SQL.ADD("  '0', ")
  * CB5
  SQL.ADD("  '0', ")
  * OpSiopel
  SQL.ADD("  '"~Val(Z:12)~"', ")
  * Cuenta1
** FJL 22/03/21 - Se cambia por la cuenta de la orden
*  SQL.ADD("  '"~Val(Z:13)~"',  ")
  SQL.ADD("  '"~FBN['Cuenta1']~"',  ")
** FJL 22/03/21 - Se agregan campos
  * Cuenta4
  SQL.ADD("  '"~FBN['Cuenta4']~"',  ")
  * Cuenta5
  SQL.ADD("  '"~FBN['Cuenta5']~"',  ")
  * NrOrden1
  SQL.ADD("  '"~Dialogo.NrOrden~"', ")
  * Mercado4
  SQL.ADD("  '"~FBN['Mercado3']~"', ")
  * UDN2 - Rueda
  SQL.ADD("  '"~FBN['RuedaMAE']~"', ")
  * NroAltaMAE
  SQL.ADD("  '"~Val(SS:2)~"', ")
  * FechaAltaMAE
  SQL.ADD("  Convert(datetime,'"~Val(SS:3)~"',120), ")
  * NumOpeSENEBI
  SQL.ADD("  '"~IIF(EqStr(val(SS:1),'SI'),Val(SS:2),'')~"', ")
  * NrOrdenAux
  SQL.ADD("  '"~IIF(EqStr(val(SS:1),'NO'),Val(SS:2),'')~"', ")
  * Cupon1
  SQL.ADD("  '"~FBN['Cupon1']~"', ")
  * AfectaLS
  SQL.ADD("  '"~FBN['AfectaLS']~"', ")
** FJL 22/03/21 - Se agrega campo
  * Book1
  SQL.ADD("  '"~FBN['Book1']~"', ")
** AA 12/05/2021 Se propaga MB2 (Bloqueo Moneda)  
  SQL.ADD("  '"~FBN['MB2']~"', ")
  *  SQL.ADD("  '0', '0', '"~FBN['Book1']~"', ")
  *  SQL.ADD("  '"~FStr(Val(Z:18),0,2)~"', '"~FStr(Val(Z:3),0,2)~"', '"~FStr(Val(Z:4),0,9)~"', "~FBN['TCbioPosUnidad']~", ")
  *  SQL.ADD("  '"~FStr(((Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:4))/Dialogo.Cantidad1),0,7)~"', '"~FStr(((Dialogo.Cantidad1*Dialogo.Precio1*Val(Z:5))/Dialogo.Cantidad1),0,7)~"', '0', ")
  *  SQL.ADD("  '"~FBN['Plazo']~"', 1, '0', ")
  *  SQL.ADD("  '0', '0', '7', '"~FStr(Dialogo.Cantidad1,0,2)~"', '"~Val(Z:6)~"', ")
  *  SQL.ADD("  '"~Val(Z:7)~"', '"~Val(Z:8)~"', '"~Val(Z:9)~"','"~Val(Z:10)~"', ")
  *  SQL.ADD("  '"~Val(Z:14)~"', '"~Val(Z:11)~"','0', '0', ")
  *  SQL.ADD(" '0', '"~FStr((Val(Z:15)),0,6)~"', '"~FBN['Mercado']~"', '-1', ")
  *  SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:16),0,7)~"', '"~FStr(Val(Z:22),0,2)~"', '"~FStr(((Val(Z:23)*Val(Z:24))/100),0,2)~"', ")
  *  SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:17),0,7)~"', '"~FStr(Val(Z:23),0,2)~"', '"~FStr(((Val(Z:22)*Val(Z:24))/100),0,2)~"', ")
  *  SQL.ADD("  '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:20),0,8)~"', '"~FBN['CB10']~"', '"~Val(Z:21)~"', '"~FStr(Val(Z:24),0,2)~"') ")
  * Direccion
  SQL.ADD("  2, ")
  * RB6 - fuente alta - Conti
  SQL.ADD("  4, ")
  * CB10 - Contingencia
  SQL.ADD("  1, ")
  * CB4 - Cta y Orden
  SQL.ADD("  '"~val(z:27)~"', ")
  * NrBoleto
  SQL.ADD("  '"~Val(yx:1)~"' ")
  SQL.ADD(" )")
  SQL.NEW
  
  
  If FBN['Cuotas1']=0
     ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Dialogo.NrOrden~"' "))
     SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio) ")
     SQL.ADD(" Values ('"~Dialogo.NrOrden~"', '"~Val(Z:2)~"', '"~FStr(Val(NE:1),0,0)~"', '"~Dialogo.String1~"', "~SQLAhora~", '"~FStr(Dialogo.Cantidad1,0,2)~"', '"~FStr(Dialogo.Precio1,0,8)~"') ")
     SQL.NEW
     SQL.ADD(" Update "~DBO~".ORDENES Set ")
     SQL.ADD("  Cuotas1 = 1 ")
     SQL.ADD(" Where NrOrden='"~Dialogo.NrOrden~"'")
     SQL.NEW
  Else
     SQL.ADD(" Update "~DBO~".EJECUCIONES Set ")
     SQL.ADD("  Fecha = "~SQLAhora~", ")
     SQL.ADD("  NrOperacion= '"~Val(Z:2)~"' ")
     SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
     SQL.NEW
  EndIf

  SQL.ADD(" Update "~DBO~".ORDENES Set ")
  SQL.ADD("  NrOperacion2 = '"~Val(Z:2)~"' ")
  SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
  SQL.NEW
  SQL.EXEC
  
  ** AA 05/10/2023 - SENEBI-SISTACO
  
  
  ModificarOperacion(Val(z:2),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
 
  *Actualiza Movimientos Orden
  SQL.ActualizarMovimientosO4(Dialogo.NrOrden,SI,SI,NO,NO,NO,NO)
  SQL.EXEC

* FJL 27/01/21 - Control cuentas
  ACN(x:1, 10)
  ACN(x:2, QUERY("SELECT 1 FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Val(z:2)~"' and (ISNULL(Cuenta1,'')='' or ISNULL(Cuenta2,'')='' or ISNULL(Cuenta3,'')='' or ISNULL(Cuenta4,'')='' or (TipoOp in ('TIC','TIV') and CB4=1 and (ISNULL(Cuenta5,'')='' or ISNULL(Cuenta6,'')='')))"))
  if Val(x:2)=1
    ACN(x:1, 7)
  endif
  if Eqstr(VAR('INSTALACIO'),'MLASA') 
     *y incluido(fbn['Rueda'],Var('RUECPC1'))
     ACN(x:1, 68)
  endif

  SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
  SQL.ADD("   Set Valor       = '0'  ")
  SQL.ADD(" where NrOperacion = '"~Val(z:2)~"' ")
  SQL.ADD("   and Valor       = '1' ")
  SQL.NEW

  SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
  SQL.ADD("   Set Valor       = '1'  ")
  SQL.ADD(" where NrOperacion = '"~Val(z:2)~"' ")

* FJL 27/01/21 - Control cuentas
*  SQL.ADD("   and Nrbit       = 10 ")
  SQL.ADD("   and Nrbit       = "~FStr(Val(x:1),1,0)~" ")
  SQL.NEW
  SQL.EXEC           
 
  
Proximo
