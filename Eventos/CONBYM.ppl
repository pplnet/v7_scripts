SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~Dialogo.NrOrden~"' ")


Recorrer SQL

  If EqStr(FBN['TipoOrden'],'OTIC')
     ACT(TO:1,'TIC')
  Else
     ACT(TO:1,'TIV')
  EndIf
  
  If FBN['Cuotas1']=0
     ACT(CA:1,FBN['CantidadTotalOrden']-FBN['Cantidad1'])
     SQL.ADD(" Update "~DBO~".ORDENES Set ")
     SQL.ADD("  Cantidad1   = "~FStr(FBN['Cantidad1'],0,2)~", ")
     SQL.ADD("  Cantidad4   = "~FStr(FBN['Cantidad4'],0,8)~", ")
     SQL.ADD("  Cantidad5   = "~FStr(val(CA:1),0,2)~" ")
     SQL.ADD(" Where NrOrden = '"~Dialogo.NrOrden~"' ")
     SQL.NEW
     SQL.EXEC
  EndIf
  
*  messagebox(FBN['Plazo'])
*  messagebox(FBN['FechaOrden'])
  
  ACD(FV:1,HABILES(FBN['FechaOrden'],(FBN['Plazo']),'ARG',SI))
  
  ACN(Z:3,(FBN['Cantidad1'] * FBN['Cantidad4']) * CotizacionC(FBN['ContraEspecie'],,,,FSYS,1,SI,VAR('MONEEXTR')) )
  ACN(Z:4,CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOrden'],1,SI,VAR('MONEEXTR')) )
  ACN(Z:5,CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOrden'],1,SI,VAR('MONELOCA')) )
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'INV')
     ACN(Z:6,1/Val(Z:4))
  Else
     ACN(Z:6,Val(Z:4))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'],VAR('MONELOCA')),'INV')
     ACN(Z:7,1/Val(Z:5))
  Else
     ACN(Z:7,Val(Z:5))
  EndIf
  
  If EqStr(Modo(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',FBN['Especie'])),'INV')
     ACN(Z:8,1/CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOrden'],1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',FBN['Especie'])))
  Else
     ACN(Z:8,CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaOrden'],1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',FBN['Especie'])))
  EndIf
  
  ACN(Z:9,CotizacionC(VAR('MONEEXTR'),,,,FBN['FechaOrden'],1,SI,VAR('MONELOCA')))
  
  * z:12 ==> OpSIOPEL
  ACT(Z:12,SQL(" Select CodOperador from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~FBN['Cliente']~"' and Estado='DEF' "))
  
** FJL 22/03/21 - toma las cuentas de la orden


  ACN(Z:15,COTIZACIONC(FBN['Especie'],,,,FBN['FechaOrden'],1,SI,FBN['ContraEspecie']))
  ACN(Z:16,MontoGastos(Val(TO:1),FBN['Especie'],FBN['Vehiculo'],'DMERC',0,4))


*  ACN(Z:22,(FBN['Cantidad1']*FBN['Cantidad4']*Val(Z:16))/100)
*  ACN(Z:23,(FBN['Cantidad1']*FBN['Cantidad4']*Val(Z:17))/100)
  

  * Cupon
  ***** Es ZeroCupon
  ACT(z:26, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',FBN['Especie']))
  if EqStr(Val(z:26),'SI')    
     ACT(z:25, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',FBN['Especie']),1,0))
  else
     ACT(z:25, Val(t:4))
  endif
  * Para el CB4=1 es Cuenta y Orden
  ** 11-08-2024 BOFA verificar para cartera propia con Variable CLIEGARCP
  #ifdef MLASA
      if not Incluido(FBN['Cliente'],Var('CLIEGARCP')) y  Not Eqstr(FBN['Cliente'],Var('VEHICULODE')) 
         ACT(z:27,'1')
      else
         ACT(z:27,'0')      
      endif
  #else      
      ACT(z:27,iif(Eqstr(FBN['Cliente'],FBN['Vehiculo']),'0','1'))
  #endif
  
  **Datos por SENEBI
  ACT(SS:1,SQL(" Select SenebiSistaco from "~DBO~".UDNS where Codigo = '"~FBN['RuedaMAE']~"' "))
  ACT(SS:2,SQL(" Select NrSecuencia from "~DBO~".EJECUCIONES where NrEjecucion= 1 and NrOrden = '"~Dialogo.NrOrden~"' "))
