        let &CB2 1
      EndIf
      
      
      ** a la orden
      If EqStr(Trim(Val(cb:&i)),'No') o EqStr(Trim(Val(cb:&i)),'NO')
        let &CB3 0
      Else
        let &CB3 1
      EndIf
      
      ** Plazo
      * lo tomo entre fecha de liquidacion y fecha de acreditacion, opinable.
      let &Plazo Fecha(Val(bn:&i)) - Fecha(Val(bi:&i))
      
      ** CB4
