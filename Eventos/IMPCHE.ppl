      Let &Cuenta4  SQL("Select Top(1) Codigo from "~DBO~".CUENTAS where Cliente='"~&Cliente1~"'  and (Especies Like '%"~&Especie~"%' OR Especies LIKE '%MONEDA%') AND Estado='HAB' AND TipoCuenta In ('CC','CA','CUS','VIS','OTR') AND Mercado='"~&Mercado2~"' and (TiposOperacion is NULL or TiposOperacion like '%"~&TipoOp~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")   
