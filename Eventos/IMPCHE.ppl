    let &TotalBrutoCli1 Val(bo:&i)
    if Not Eqstr(&Cliente1,&Vehiculo)
     *let &TotalArancel &Cantidad*MontoArancelC(&TipoOp,&Cliente1,&Especie,&Vehiculo,'DTODOC',0,4,,,,,&Mercado4)*&Plazo/365/100
      let &TotalArancel &TotalBrutoCli1*MontoArancelC(&TipoOp,&Cliente1,&Especie,&Vehiculo,'DTODOC',0,4,,,,,&Mercado4)*&Plazo/365/100
    else
