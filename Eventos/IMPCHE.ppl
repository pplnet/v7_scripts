          SQL.ADD("   '"~Var('BOOKDD')~"',    '"~Fstr(Val(bk:&i),0,0)~"',  "~FStr(&MB2,0,0)~", "~FStr(&CB2,0,0)~", '"~Val(cn:&i)~"', '"~Val(bt:&i)~"',")
          SQL.ADD("   '"~Val(ch:&i)~"', '"~Hora(Val(bg:&i))~"', '"~Hora(Val(bu:&i))~"', 0, 0, '"~IdxDate(Val(bi:&i))~"', '"~IdxDate(Val(bn:&i))~"', ")
