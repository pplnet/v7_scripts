          SQL.ADD("   MAVAdmGtiaVdr,   MAVAdmGtiaVdrIVA ")
          *,         TotalIVA,       TotalNetoCli2 ")
          SQL.ADD("   ) VALUES (")
          SQL.ADD("   '"~&TipoOp~"','"~&Numerador~"', '"~FStr(Val(ba:&i),0,0)~"', "~FStr(&CB1,0,0)~", '"~&Especie~"', ")
          SQL.ADD("   "~Fstr(&RB1,0,0)~",   "~FStr(Val(be:&i),1,8)~", '"~&Cliente1~"', '"~IdxDate(Val(bh:&i))~"', '"~IdxDate(Val(cc:&i))~"', ")
          SQL.ADD("   "~Fstr(&Plazo2,0,0)~",   '"~FStr(Val(bj:&i),0,0)~"', '"~FStr(Val(bk:&i),0,0)~"', '"~&Cliente2~"','"~&Cliente3~"',           "~FStr(Val(bn:&i),0,0)~", ")
          SQL.ADD("   '"~IdxDate(Val(bn:&i))~"', "~FStr(Val(bo:&i),0,2)~", "~FStr(Val(bp:&i),0,2)~", "~FStr(Val(bq:&i),0,2)~", "~FStr(Val(br:&i),0,2)~", "~FStr(Val(cm:&i),0,2)~", '"~&Vehiculo~"', ")
          SQL.ADD("   '"~Val(bx:&i)~"',          '"~VAR('MONELOCA')~"',    "~FStr(Val(bz:&i),0,2)~", "~FStr(&CB3,0,0)~",   '"~IdxDate(Val(bi:&i))~"', ")
          SQL.ADD("   "~Fstr(&Plazo,0,0)~",   '"~FStr(Val(ce:&i),0,0)~"', "~FStr(&CB4,0,0)~",  "~FStr(&CB5,0,0)~",   '"~USUARIOACTIVO~"', ")
          SQL.ADD("   "~IdxDate2(SQLAhora)~",  "~IdxDate2(FSys)~",       "~FStr(32,0,0)~",  "~FStr(&Cantidad,0,2)~",   '"~USUARIOACTIVO~"', "~FStr(&CB8,1,0)~", ")
          SQL.ADD("   '"~&Cliente4~"', '"~&Mercado4~"',  '"~&Mercado~"',  '"~&Mercado2~"', ")
