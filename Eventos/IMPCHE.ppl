      If Vacio(&Cuenta3) 
        Messagebox('Debe agregar la Cuenta moneda del vehiculo para el mercado '~IIF(Incluido(&Mercado2,Var('MERNOVEHI')),IIF(Eqstr(&Especie,Var('MONELOCA')),Var('MERCBCRA'),Var('MERSWIFT')),&Mercado2) )
      endif
      
           
      ** Plazo2
      let &Plazo2 Fecha(Val(bi:&i)) - Fecha(Val(bh:&i))

      * Sin Recurso'
      If Incluido(Trim(Val(ca:&i)),'No|NO')
        let &CB2 0
