*/*****************************************
*/Evento que asigna el Numero de Plazo en 
*/la tabla PLAZOSOCT (llamado por OCTPLZ)
*/*****************************************
CrearDialogo
   Especie1: 'Especie';1;1;;;;
   String1 : 'TipoNeg';2;1;;;;;;;;;;;'X'
FinDialogo
if Not OK
  Cancelar
endif

ACN(pl1,1)
SQL.ADD("Select * from "~DBO~".PLAZOSOCT ")
SQL.ADD("Where Habilitado    = 'SI' ")
SQL.ADD("and Especie         = '"~Dialogo.Especie1~"' ")
SQL.ADD("and TipoNegociacion = rtrim(ltrim('"~Dialogo.String1~"')) ")
SQL.ADD("Order By Fecha")
Recorrer SQL
  SQL.ADD("Update "~DBO~".PLAZOSOCT ")
  SQL.ADD("   Set NroPlazo = "~Val(pl1)~" ")
  SQL.ADD(" Where Habilitado      = 'SI' ")
  SQL.ADD("   and Especie         = '"~Dialogo.Especie1~"' ")
  SQL.ADD("   and TipoNegociacion = '"~Dialogo.String1~"' ")
  SQL.ADD("   and Variable        = '"~fbn('Variable')~"' ")
  SQL.NEW
  SQL.EXEC
  SCN(pl1,1)
Proximo
