CrearDialogo
  Vehiculo1: 'Vehiculo' ;       1;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Cuenta1  : 'Cuenta'           ;;;;;;[NoVacio(Dialogo.Cuenta1) Y Incluido(Dialogo.Cuenta1, SQLSet(" Select Cuenta From "~DBO~".CNCHEQUERASBANCO "))] O [Dialogo.Radio1<>0];'Cuenta Invalida';NO;;;;;;" Codigo IN (Select Distinct Cuenta From "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo= '"~Dialogo.Vehiculo1~"' ) "
  Chequera1: 'Nr.Chequera'      ;;;;;;[NoVacio(Dialogo.Chequera1)] O [Dialogo.Radio1<>0];'Numero de Chequera Invalida';NO;SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ");SQL(" Select Chequera From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Estado='HAB' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ");;;;" Cuenta = '"~Dialogo.Cuenta1~"' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ";
  Entero1  : 'Nr.Cheque'        ;;;;;;[Dialogo.Entero1 > 0 Y Dialogo.Entero1 >=SQL(" Select Min(NrChequeDesde) From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ") Y Dialogo.Entero1 <=SQL(" Select Max(NrChequeHasta) From "~DBO~".CNCHEQUERASBANCO Where Cuenta='"~Dialogo.Cuenta1~"' AND Vehiculo = '"~Dialogo.Vehiculo1~"' ")] o Dialogo.Radio1<>0;'Numero de Cheque Invalido';NO;SQL(" Select Min(NrCheque) From "~DBO~".CHEQUES Where Chequera='"~Dialogo.Chequera1~"' AND Estado Not IN('ANU','PAG','ENT') ");SQL(" Select Min(NrCheque) From "~DBO~".CHEQUES Where Chequera='"~Dialogo.Chequera1~"' AND Estado Not IN('ANU','PAG','ENT') ");;;'###############';;
  Radio1   : 'Llamada|Menu|InstFacChe|Terminal|InstFacNche|Inf.Datanet|Conciliacion';;;;NO;NO;NoVacio(Dialogo.Radio1);;NO;0;
  NrTrans1 : 'Transaccion DEVM' ;;;;Dialogo.Radio1=4;Dialogo.Radio1=4;NoVacio(Dialogo.NrTrans1) o Dialogo.Radio1<>4;'Numero de Transaccion Invalida';NO;
FinDialogo

If Not Ok
  Cancelar
EndIf

ACN(BD:1, 0)

***---Llamado desde la Instancia Terminal de la Transaccion DEVM
IF Dialogo.Radio1=2
    ACT(es:2, SQL("Select Estado From "~DBO~".CHEQUES Where Chequera='"~Dialogo.Chequera1~"' AND NrCheque="~Fstr(Dialogo.Entero1,0,0)~" ") )

    IF Not Eqstr(TRIM(Val(es:2)), 'PAG')
        *El cheque no esta pagado.
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES SET Estado = 'ANU' ")
        SQL.ADD(" Where  NrComprobante = '"~Dialogo.NrTrans1~"' ")
        SQL.NEW
        SQL.EXEC
    ELSE
        *El cheque esta pagado.
        ***---Dejo la Transaccion en la instancia Trans c/cheques Entregados
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '0' ")
        SQL.ADD(" Where  NrOperacion = '"~Dialogo.NrTrans1~"' ")
        SQL.ADD(" AND NrBit= 11 ")
        SQL.NEW
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '1' ")
        SQL.ADD(" Where  NrOperacion = '"~Dialogo.NrTrans1~"' ")
        SQL.ADD(" AND NrBit= 20 ")
        SQL.NEW
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET Direccion = 2 ")
        SQL.ADD(" Where  NrTrans = '"~Dialogo.NrTrans1~"' ")
        SQL.NEW
        SQL.EXEC
        Cancelar('La Transaccion no puede retroceder el Cheque esta Pagado.')
    ENDIF
ENDIF

***---Llamado desde conciliacion o informar datanet
IF Dialogo.Radio1=4 o Dialogo.Radio1=5
    SetFilaActual(1)
    SQL.ADD(" Select /*+ RULE */ C.Chequera, C.FechaEmision, C.NrCheque, C.NrComprobante, C.Monto, C.Estado, ")
    SQL.ADD(" T.Cliente1, C.Observaciones, C.FechaPago, T.Proveedor ")
    SQL.ADD(" From "~DBO~".CHEQUES C, "~DBO~".TRANSACCIONES2 T ")
    SQL.ADD(" Where NrComprobante = '"~Dialogo.NrTrans1~"' ")
    SQL.ADD(" AND Estado <> 'ANU' ")
    SQL.ADD(" AND C.NrComprobante = T.NrTrans ")
    Recorrer SQL
        IF Eqstr(fbn('Estado'), 'ASI')
            ACT(ES:1, 'Asignado')
        ENDIF
        IF Eqstr(fbn('Estado'), 'ENT')
            ACT(ES:1, 'Entregado')
        ENDIF
        IF Eqstr(fbn('Estado'), 'PEN')
            ACT(ES:1, 'Pendiente')
        ENDIF
        ACT(A:fac, fbn('Chequera'))
        ACT(B:fac, fbn('Proveedor'))
        ACD(C:fac, fbn('FechaEmision'))
        ACN(D:fac, fbn('NrCheque'))
        ACT(E:fac, fbn('NrComprobante'))
        ACN(F:fac, fbn('Monto'))
        ACT(G:fac, fbn('Observaciones'))
        ACT(H:fac, Val(ES:1))
        ACD(I:fac, fbn('FechaPago'))
        ACT(J:fac, Dialogo.Vehiculo1)
        ACO(7, 50)
    Proximo

    CrearListBox       ;'Arial,8,'
      'Proveedor'      ;J:FAC..J:FAC;NO;;;70;STRING;;RGB(220,220,193);
      'NrChequera'     ;A:FAC..A:FAC;NO;;;70;STRING;;RGB(220,220,193);
      'Proveedor'      ;B:FAC..B:FAC;NO;;;70;STRING;;RGB(220,220,193);
      'Fecha Emision'  ;C:FAC..C:FAC;NO;;;100;FECHA;RGB(220,220,193);
      'Fecha Pago'     ;I:FAC..I:FAC;NO;;;100;FECHA;RGB(220,220,193);
      'NrCheque'       ;D:FAC..D:FAC;NO;;;80;NUMERO;'###,###,###,###,###';RGB(220,220,193);
      'Transaccion'    ;E:FAC..E:FAC;NO;;;80;STRING;;RGB(220,220,193);
      'Monto'          ;F:FAC..F:FAC;NO;;;85;NUMERO;'###,###,###,###,###.##';RGB(220,220,193);
      'Observaciones'  ;G:FAC..G:FAC;NO;;;220;STRING;40;RGB(220,220,193);
      'Estado'         ;H:FAC..H:FAC;NO;;;70;STRING;;RGB(220,220,193);
    FinListBox

    IF Not Ok
        ***---Dejo la Transaccion en la instancia que estaba
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '0' ")
        SQL.ADD(" Where  NrOperacion = '"~Val(E:fac)~"' ")
        SQL.ADD(" AND NrBit= 11 ")
        SQL.NEW
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".OPERACIONESBITS SET Valor = '1' ")
        SQL.ADD(" Where  NrOperacion = '"~Val(E:fac)~"' ")
        If Dialogo.Radio1=4
          SQL.ADD(" AND NrBit= 17 ")
        Else
          SQL.ADD(" AND NrBit= 18 ")
        Endif
        SQL.NEW
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".TRANSACCIONES2 SET Direccion = 2 ")
        SQL.ADD(" Where  NrTrans = '"~Val(E:fac)~"' ")
        SQL.NEW
        SQL.EXEC
    ELSE
        SQL.ADD(" UPDATE /*+ RULE */ "~DBO~".CHEQUES SET Estado = 'ANU' ")
        SQL.ADD(" Where  NrComprobante = '"~Val(E:fac)~"' ")
        SQL.NEW
        SQL.EXEC
    ENDIF
ENDIF

IF Dialogo.Radio1=0
   ***---Cheque en blanco
   SQL.ADD(" SELECT Max(NrCheque) NrCheque ")
   SQL.ADD(" From "~DBO~".CHEQUES ")
   SQL.ADD(" Where Chequera = '"~Dialogo.Chequera1~"' ")

   Recorrer SQL
     IF fbn('NrCheque') + 1 = Dialogo.Entero1
        ACN(VI:1, 0)
        (.'VISCHE'.)
        IF Val(VI:1) = 0
           ***---Confirmada la Insercion desde la Funcion
           SQL.ADD(" INSERT INTO "~DBO~".CHEQUES ")
           SQL.ADD(" (Chequera, FechaEmision, NrCheque, Observaciones ,Estado) ")
           SQL.ADD(" VALUES ")
           SQL.ADD(" ('"~Dialogo.Chequera1~"', '"~IdxDate(Fsys)~"', "~Dialogo.Entero1~", 'Cheque Anulado en Blanco por Evento', 'ANU') ")
           SQL.NEW
           SQL.EXEC
        ELSE
           Cancelar
        ENDIF
     ELSE
        MessageBox('El Numero de Cheque Ingresado no es el Siguiente en la Chequera.')
     ENDIF
   Proximo
ENDIF