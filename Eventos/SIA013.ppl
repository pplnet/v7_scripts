        SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.ADD(" AND NrBit < 11 ")
        SQL.ADD(" AND Valor = '1' ")
        SQL.NEW

        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '1' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.ADD(" AND NrBit = 20 ")
        SQL.NEW

        SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
        SQL.ADD("( NrOperacion, NrInstancia, Usuario, Mensaje, Fecha ) ")
        SQL.ADD(" Values ")
        SQL.ADD("( '"~Copy(fbn('NrTrans'), 1, 8)~"', 20, '"~UsuarioActivo~"',  ")
        SQL.ADD("  'SIA013', ")
        SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
