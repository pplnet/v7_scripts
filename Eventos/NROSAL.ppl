*endif

SQL.ADD("SELECT * ")
SQL.ADD("  FROM MOVPENDIENTES")   
SQL.ADD(" WHERE NrSaldo=-1 ")   

Recorrer SQL
   acn(x:fac,0)
   act(a:fac,FBN['NrOperacion'])
   act(b:fac,FBN['FechaMov'])
   act(c:fac,FBN['Cliente'])
   act(d:fac,FBN['Especie'])
   act(e:fac,FBN['Mercado'])
   act(f:fac,FBN['Cantidad'])
   acn(g:fac,FBN['NrSaldo'])
   acn(g:fac,FBN['NrSaldo'])
   scn(z1, 1)
Proximo

if Val(z1) > 0
  CrearListBox ; 'Arial,8,'
*   'Accion ?'      ;x1..x:FAC;SI;;;70;CHECK;RGB(160,160,193)
   'Operacion'     ;a1..a:FAC;NO;;;70;STRING;;RGB(250,250,193)
   'FechaMov'      ;b1..b:FAC;NO;;;70;STRING;;RGB(250,250,193)   
   'Cliente'       ;c1..c:FAC;NO;;;80;STRING;;RGB(250,250,193)
   'Especie'       ;d1..d:FAC;NO;;;50;STRING;;RGB(250,250,193)
   'Mercado'       ;e1..e:FAC;NO;;;70;STRING;;RGB(250,250,193)
   'Cantidad'      ;f1..f:FAC;NO;;;100;NUMERO;;RGB(250,250,193)
   'NrSaldo'       ;g1..g:FAC;NO;;;50;NUMERO;'###';RGB(250,250,193)
  FinListBox

  if Ok 
     SQL.ADD("UPDATE "~DBO~".MOVPENDIENTES ")
     SQL.ADD("   SET NrSaldo=1 ")
     SQL.ADD("WHERE NrSaldo=-1 ")
     SQL.NEW
     SQL.EXEC
     Messagebox("Numeros de saldo actualizados")
  else
     Cancelar("Proceso cancelado")
  Endif
Else
  Messagebox("No hay saldos para actualizar")
Endif  

