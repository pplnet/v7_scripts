*HojaVisible(SI)
CrearDialogo
  Fecha1     : 'FechaValor'                         ;1;1;;;;Dialogo.Fecha1>=Habiles(Fsys,-VAR('FVALORCONT'),'ARG',SI) y Dialogo.Fecha1<=Fsys  y EsHabil(Dialogo.Fecha1,'ARG');'Debe ingresar una Fecha Habil no inferior al dia habil anterior';NO;fsys
  Radio4     : "Tipo Cliente|"~Var('LABEL')~"|Caja|Todos"  ;1;2;;NO;NO;;;;2;
  Cliente1   : "Cliente"                            ;2;1;;;;[[Vacio(Dialogo.Especie1) y NoVacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Especie1) y Vacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Cliente1) y NoVacio(Dialogo.Especie1)]];'Debe ingresar un Cliente o Especie';NO;
  Especie1   : "Especie"                            ;2;2;;;;[Vacio(Dialogo.Especie1) y NoVacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Especie1) y Vacio(Dialogo.Cliente1)] o [NoVacio(Dialogo.Cliente1) y NoVacio(Dialogo.Especie1)];'Debe ingresar un Cliente o Especie';NO;
  Vehiculo1  : "Vehiculo"                           ;4;1;;;;;;;VAR('VEHICULODE');Dialogo.Vehiculo1;
  Radio2     : "Bloqueo Tipo|Especie|Efectivo"      ;5;1;;;;;;;0;Dialogo.Radio2;
  Radio1     : "Cantidad|Nominal|Residual"          ;6;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0;IIF(Dialogo.Radio2=0,Dialogo.Radio1,-1);
  Radio3     : "Operacion|Bloqueo|Desbloqueo"       ;7;1;;;;;;;0;Dialogo.Radio3;
  ListaTabla3: 'Cuentas'                            ; ; ;;;;;;;;;;;;;'Codigo' ; 'Codigo;Nombre' ; 'CUENTAS'
  Cantidad1  : 'a Reponer'                          ;1;1;;NO;NO;;;;0;
  Entero1    : 'Saldo a Reponer'                    ;1;1;;NO;NO
  Especie2   : 'Moneda a Reponer'                   ;1;1;;NO;NO;;;;VAR('MONELOCA')
  Cantidad2  : 'Cantidad Exigida'                   ;1;1;1;NO;NO;;;;0
FinDialogo

if Not Ok
   Cancelar
endif


****EjecutarEvento('BLSALD',Fecha1=Dialogo.Fecha1,Radio4=Dialogo.Radio4,Cliente1=Dialogo.Cliente1,Especie1=Dialogo.Especie1,Vehiculo1=Dialogo.Vehiculo1,Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Radio3=Dialogo.Radio3,ListaTabla3=Dialogo.ListaTabla3,Cantidad1=Dialogo.Cantidad1,Entero1=Dialogo.Entero1,Especie2=Dialogo.Especie2,Cantidad2=0)

(.'BLSALD'.)



