CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'FXOCTC|FXOCTV');'Operacion Invalida';NO;;;;;;" TipoOp IN ('FXOCTC','FXOCTV') ";
FinDialogo

IF Not OK
    Cancelar
ENDIF

ACT(BL:1, GetNumerador(89))

SQL.ADD(" Update "~DBO~".OPERACIONES ")
SQL.ADD(" Set NrBoleto = '"~Val(BL:1)~"' ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC
