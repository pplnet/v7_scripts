*BID Compra, ASK venta. ASK > BID
* Actualizar Cotizaciones a partir del informe
* que toma los precios de Bloombergs (Spot y Futuros)

ACT(yy:2, HORA(AHORA))
ACT(zz:2, Copy(Val(yy:2),1,2)~Copy(Val(yy:2),4,2)~Copy(Val(yy:2),7,2))
ACD(yy:3, Fsys)
ACT(zz:3, Copy(Val(yy:3),1,2)~Copy(Val(yy:3),4,2)~Copy(Val(yy:3),9,2))

*Limite de precios tomados
ACN(x1, VAR('ACTCOTFILA')+1)

*Valida si existe el directorio para crear el txt
If ExisteDirectorio(VAR('PATHLOG'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATHLOG'),Longitud(VAR('PATHLOG')),1),'\')
      ACT(pl:1, VAR('PATHLOG')~'PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   Else
       ACT(pl:1, VAR('PATHLOG')~'\PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   EndIf
   **
Else
    Cancelar('El directorio '~VAR('PATHLOG')~' no existe')
EndIf

ACN(tx:2, 0)
ACT(fh:1, FECHA(HOY)~' '~HORA(AHORA)~' ACTCOT')

HojaVisible(SI)

***---A: 'Especie
***---B: 'Precio1
***---C: 'Precio Contable
***---D: 'Moneda
***---E: 'PlazoLiq
***---F: 'Mercado
***---G: 'Fecha


LinkearHoja('BLOOM1',1)


*- Variables
* z2 : Primera fila con contenido
* z3 : Ultima fila con contenido
* z4 : Primera Celda asignada
* z5 : Ultima Celda asignada
* z6 : Celda corriente

ACN(z2,2)
ACN(z3,Val(x1))
ACN(bd:7, 0)

SetFilaActual(4)
ACN(z4,fac)
ACN(z5,fac)

*- Recorrer valores
Recorrer&i Val(z2),Val(z3)
   try
   ACT(a:Val(z5), Trim(Mirt(LinkH(1,a:Val(z5)))))
   catch
   Cancelar("Hubo un problema con el archivo NO se puede procesar ")
   end
   ACN(b:Val(z5), LinkH(1,b:Val(z5)))
   ACN(c:Val(z5), LinkH(1,c:Val(z5)))
   ACT(d:Val(z5), LinkH(1,d:Val(z5)))
   if Novacio(LinkH(1,e:Val(z5)))
      ACN(e:Val(z5), LinkH(1,e:Val(z5)))
   else
      ACT(e:Val(z5), LinkH(1,e:Val(z5)))
   endif
   ACT(f:Val(z5), LinkH(1,f:Val(z5)))
   ACD(g:Val(z5), LinkH(1,g:Val(z5)))
   ACN(zp:Val(z5), LinkH(1,zp:Val(z5)))
   ACT(j:Val(z5), Mayusculas2(VAL(j:Val(z5))))
   If eqstr(val(a:Val(z5)),'') Y NoVacio(VAL(W3))
      Break
   EndIf
   *If Not eqstr(val(a:Val(z5)),'') 
   *    *** Contador de Leidos
   *    SCN(W:3,1)
   *endif
   **Plazo liq
   If (Val(e:Val(Z:5)) >= 0 O Vacio(Val(e:Val(Z:5)))) Y (NoVacio(Val(a:Val(z5))) y Not EqStr(Val(a:Val(z5)), 'Especie'))
   **mercado
   If not Eqstr(Val(f:Val(Z:5)),'NO VALIDO')
          **// Fecha de la cotizacion
          If NoVacio(Val(g:Val(z5))) Y Val(g:Val(z5))>0
             ACD(FC:1, Val(g:Val(z5)))
          Else
             ACD(FC:1, FSYS)
          Endif
          ACT(es:1, Val(a:Val(z5))) 
          If Novacio(Val(a:Val(z5))) 
              *** Contador de Leidos
              SCN(W:3,1)
          endif
          If Novacio(Val(a:Val(z5))) 
             SCN(W:5,1)      
          EndIf
          If SQL("SELECT 1 FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(a:Val(z5))~"' ")=1 Y Novacio(Val(a:Val(z5)))
             If Val(b:Val(z5)) <> 0 
                Message('Actualizando Cotizacion: '~Val(b:Val(z5)))
                *- Buscar Cotizacion Contado de hoy para ver si UPDATE o INSERT
                sql.add("SELECT Count(*) cuenta FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(a:Val(z5))~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(Val(FC:1))~"'")
                *mercado
                if Novacio(Val(f:Val(Z:5)))
                    sql.add("and mercado = '"~Val(f:Val(Z:5))~"'")
                endif
                *Moneda
                if novacio(Val(d:Val(Z:5)))
                        sql.add("and moneda = '"~Val(d:Val(Z:5))~"'")
                endif
                *Plazoliq
                if novacio(Val(e:Val(Z:5)))
                *Error de overflow cuando PlazoLiq es 0
                *sql.add("and plazoliq = "~(Val(e:Val(Z:5)))~" ")
                    sql.add("and plazoliq = "~FStr(Val(e:Val(Z:5)),1,0)~" ")
                endif
                Recorrer SQL
                      acn(x3,fbn('cuenta'))
                Proximo
                *ACN(x:3,SQL("SELECT Count(*) FROM "~DBO~".COTIZACIONES WHERE Codigo='"~Val(a:Val(z5))~"' and (CallPut='CON' or CallPut is Null) and Fecha='"~IdxDate(Val(FC:1))~"' "))
                *- Actualizar Precio         Precio1: Close Precio2: Ask Precio3: Bid Precio4: Last
                If Val(x:3)=1 
                   SQL.ADD("UPDATE "~DBO~".COTIZACIONES SET ")           
                   SQL.ADD("Precio1="~FStr(Val(b:Val(z5)),1,8)~", ")
                   SQL.ADD("preciocontable="~FStr(Val(C:Val(z5)),1,8)~", ") 
                   SQL.ADD("moneda='"~Val(d:Val(Z:5))~"', ")
                   *Error de overflow cuando PlazoLiq es 0    
                   *SQL.ADD("PlazoLiq='"~Str(Val(e:Val(Z:5)))~"', ")
                   SQL.ADD("PlazoLiq='"~FStr(Val(e:Val(Z:5)),1,0)~"', ")                  
                   SQL.ADD("Mercado=upper('"~Val(f:Val(Z:5))~"'),  ")         
                   SQL.ADD("fuente='AUTOMATICA',  ")         
                   SQL.ADD("fechaactualizacion=getdate()  ")         
                   SQL.ADD("WHERE Codigo='"~Copy(Val(a:Val(z5)),1,6)~"' ")         
                   SQL.ADD("  and (CallPut='CON' or CallPut is Null) ")         
                   SQL.ADD("  and Fecha='"~IdxDate(Val(FC:1))~"' ")         
                   ** FJL 15/11/2023 - Se saca esta condicion por Issue EXTBIND-6894
*                   SQL.ADD("  AND fuente = 'AUTOMATICA' ")
                   *mercado
                   if Novacio(Val(f:Val(Z:5)))
                      sql.add("and mercado = '"~Val(f:Val(Z:5))~"'")
                   endif
                   *Moneda
                   if novacio(Val(d:Val(Z:5)))
                        sql.add("and moneda = '"~Val(d:Val(Z:5))~"'")
                   endif
                   *Plazoliq
                   if novacio(Val(e:Val(Z:5)))
                     *Error de overflow cuando PlazoLiq es 0    
                     *sql.add("and plazoliq = "~Val(e:Val(Z:5))~" ")
                     sql.add("and plazoliq = "~FStr(Val(e:Val(Z:5)),1,0)~" ")
                   endif
                   SQL.NEW
                   SQL.EXEC       
                Else
                   *- Insertar registro : PAPELES Y MONEDAS (MAYO 2012) 
                   SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES ")
                   SQL.ADD("(Fecha, Codigo, CallPut, Precio1,Preciocontable, PlazoLiq, Mercado,moneda,fuente,fechaactualizacion) ")
                   SQL.ADD(" VALUES ('"~IdxDate(Val(FC:1))~"', '"~Copy(Val(a:Val(Z:5)),1,6)~"', 'CON',"~Fstr(Val(b:Val(Z:5)),0,8)~","~Fstr(Val(c:Val(Z:5)),0,8)~", ")
                   if vacio(Val(E:Val(Z:5)))
                      SQL.ADD(" ''")
                   else
                      SQL.ADD(" '"~Fstr(Val(E:Val(Z:5)),0,0)~"'")
                   endif
                   sql.add(",upper('"~Val(f:Val(Z:5))~"'),upper('"~Val(d:Val(Z:5))~"'),'AUTOMATICA',getdate() )")
                   SQL.NEW
                   SQL.EXEC
                   ***---NO OPERATIVO ACTUALIZAR DIA ANTERIOR       
                Endif
             Else
                * --- No se considera el spot si llega cotizacion de Bloomberg en 0 (para los 4 campos)
                * --- W:9 = Contador de Ignorados 
                If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie') O Not EqStr(Val(a:Val(z5)), '')
                   if val(e:Val(z5)) = 0 y vacio(val(zp:Val(z5)))
                     SCN(W:9,1)       
                     If Val(bd:7)=0
                        AbrirAscii(Val(pl:1),0)    
                        EscribirAscii(Val(fh:1))
                        AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
                        ACN(tx:2,9)
                        (.'MENSAJETXT'.)
                        ACN(bd:7, 1)
                     Else 
                       AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
                       ACN(tx:2,9)
                       (.'MENSAJETXT'.)
                     EndIf
                   else
                       if val(e:Val(z5))=0 y val(zp:Val(z5))=1
                          AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
                          ACN(tx:2,12)
                          (.'MENSAJETXT'.)
                       endif
                   endif
                Endif
             EndIf
          Else
             If Novacio(Val(a:Val(z5))) Y Not EqStr(Val(a:Val(z5)), 'Especie')
                If Val(bd:7)=0
                   AbrirAscii(Val(pl:1),0)    
                   EscribirAscii(Val(fh:1))
                   AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
                   ACN(tx:2,1)
                   (.'MENSAJETXT'.)
                   ACN(bd:7, 1)
                Else
                   AgregarMarco(a:Val(Z:5)..a:Val(Z:5),2,0,Exe('COLOR'))
                   ACN(tx:2,1)
                   (.'MENSAJETXT'.)
                EndIf
             EndIf     
          EndIf
      Else
      *Error Mercado
      If Eqstr(Val(f:Val(Z:5)),'NO VALIDO') Y Not EqStr(Val(a:Val(z5)), 'Especie')
              If Val(bd:7)=0
                  AbrirAscii(Val(pl:1),0)    
                  EscribirAscii(Val(fh:1))
                  AgregarMarco(f:Val(Z:5)..f:Val(Z:5),2,0,Exe('COLOR'))
                  *ACN(tx:2,11)
                  *(.'MENSAJETXT'.)
                  ACN(bd:7, 1)
              Else
                   AgregarMarco(f:Val(Z:5)..f:Val(Z:5),2,0,Exe('COLOR'))
                   ACN(tx:2,11)
                   (.'MENSAJETXT'.)
              endif
           endif
      Endif
   else
      *Error de plazo
      If Val(e:Val(z5)) < 0 Y Not EqStr(Val(a:Val(z5)), 'Especie')
         If Val(bd:7)=0
            AbrirAscii(Val(pl:1),0)    
            EscribirAscii(Val(fh:1))
            AgregarMarco(e:Val(Z:5)..e:Val(Z:5),2,0,Exe('COLOR'))
            ACN(tx:2,10)
            (.'MENSAJETXT'.)
            ACN(bd:7, 1)
         Else
            ACN(tx:2,10)
            (.'MENSAJETXT'.)
         endif
      endif      
   Endif
   **// Regenero Posiciones si es TITULO o FONDO y la cotizaciones es anterior a la fecha del sistema
   *   If Val(FC:1) < FSYS
   *      ACT(H:Val(z5), 'Cotizacion Fecha Valor')
   *      If DesciendeDeEspecie(Val(a:Val(Z:5)),'TITULO') O DesciendeDeEspecie(Val(a:Val(Z:5)),'FONDOS')
   *         EjecutarEvento('REGEPO', Fecha1=Val(FC:1), Vehiculo1='', Especie1=Val(a:Val(Z:5)), String1='')
   *      Endif
   *   Endif
   SCN(z5,1)
Proximo

CerrarASCII
CerrarHoja('BLOOM1',1)
ACT(a1, 'Cotizaciones Automaticas')
ACT(a3, 'Especie')
ACT(b3, 'Precio1')
ACT(c3, 'Precio Contable')
ACT(d3, 'Moneda')
ACT(e3, 'PlazoLiq')
ACT(F3, 'Mercado')
ACT(G3, 'Fecha')

borrarCeldas(a2..i2)

AlinearCeldas(a3..i3, 'D')
AgregarMarco(a3..g3,2,0,Exe('COLOR'))

LinkearHoja('ERRCOT',1,String1=Val(pl:1),Radio1=0)

**// La conversion de cotizaciones se hace unicamente para la fecha del sistema
**// Las cotizaciones que se ingresen de dias anteriores, no realiza esta conversion.

ACD(FC:1, FSYS)



ACT(ME:1, Var('MONEEXTR'))
*ACT(MU:1, Var('MONEURU'))

LimitesVision(h:Val(z5)-1)
