       SQL.ADD("UNION ")
       SQL.ADD("SELECT 0 CPA, O.TotalNetoCli1 VTA, C.Persona,Cliente1 FROM   "~DBO~".OPERACIONES O ")
       SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
       SQL.ADD("    , "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
       SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
       SQL.ADD("  and O.Especie    =  E.Codigo  ")
       SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
       SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ") 
       SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
       SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
       SQL.ADD("  and O.TipoOp In ('TIV')  ")
       SQL.ADD("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
       SQL.ADD("  and not (PaseCB= 1 and  E.Issuer = '"~Var('CLIBCRA')~"')  ")
       If Not Vacio(Dialogo.Cliente1)
          SQL.ADD("  and Cliente1 = '"~Dialogo.Cliente1~"' ")
       endif
       ** AA 26-04-2024 Bind Solicita no tomar Cliente=Bind
       #ifdef BIND
         If Vacio(Dialogo.Cliente1)
            SQL.ADD("  and Cliente1 <> '"~Dialogo.Vehiculo1~"' ") 
