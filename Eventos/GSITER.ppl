       watch(sql.batch())
    
       ** Genera lista de Clientes a tomar
       Recorrer SQL
         dfa
         if EqStr(fbn['Persona'],'NO')
            if fbn['UmbralCPA'] >= Var('LIMSITERPJ')
               ACT(eb:2,val(eb:2)~fbn['Cliente1']~'|')
            else
               if fbn['UmbralVTA'] >= Var('LIMSITERPJ')
                  ACT(eb:2,val(eb:2)~fbn['Cliente1']~'|')
               endif   
            endif
         else
            if fbn['UmbralCPA'] >= Var('LIMSITERPF')
               ACT(eb:2,val(eb:2)~fbn['Cliente1']~'|')
            else
               if fbn['UmbralVTA'] >= Var('LIMSITERPF')
                  ACT(eb:2,val(eb:2)~fbn['Cliente1']~'|')
               endif   
            endif
         endif   
       Proximo     
    Endif

    ACT(cl1,'INICIO')
    ACT(cl2,'')
    ACT(cl3,'')
    ACT(cl4,'')
    ACT(cl5,'')
    ACT(cl6,'')
    
    #ifdef BIND
        SQL.ADD(" Select *, case when ComitenteAux Is null then Nrcuenta else ComitenteAux end Codcomitente from ")
    #else
        SQL.ADD(" Select *, ComitenteAux CodComitente from ")
    #endif    
    SQL.ADD(" (SELECT O.NrOperacion,Case When (PaseCB= 1 and (E.Jerarquia LIKE '"~Var('JERLEBACS')~"%' or E.Issuer = '"~Var('CLIBCRA')~"')) Then '99' When PaseCB= 1 Then '09' Else '01' End  Pase, ")
    SQL.ADD(" O.TotalNetoCli1 Monto, ")
    SQL.ADD(" CASE WHEN (TipoOp in ('TIC','TIFV') and PaseCB=1) THEN '1' WHEN (TipoOp in ('TIV','TIFC') and PaseCB=1) THEN '0'  ELSE '9' END Posicion, ")
    SQL.ADD(" CASE WHEN TipoOp in ('TIC','TIV') THEN '0'  ELSE '1' END Plazo, ")
    SQL.ADD(" CASE WHEN TipoOp in ('TIC','TIFC') THEN 2  ELSE 1 END TipoCV, O.FechaVto, O.Especie, O.ContraEspecie, ")
    SQL.ADD(" Case When E.Jerarquia LIKE '"~Var('JERACCION')~"%' Then '02' When E.Jerarquia not LIKE '"~Var('JERTITULOS')~"%' Then '11' When O.TipoOp in ('TIC','TIFV','TIV','TIFC') then '12' else '11' End TipoOPX, PaseCB, E.Issuer, E.MonedaEmision,")    
    SQL.ADD(" CASE WHEN O.ContraEspecie in ('ARP') THEN '001'  When O.ContraEspecie in ('USD') then '004' When O.ContraEspecie in ('EUR') then '006' else '000' END Moneda,TipoOp, ")
    SQL.ADD(" CASE WHEN (E.Indexado = 'NO' and E.MonedaEmision in ('"~Var('MONELOCA')~"')) THEN 1  ELSE 2 END Emision, C.Alias10 NIF, ")
    SQL.ADD("  1  Exencion, C.Calle, C.Altura, C.Piso, C.Depto,  C.RazonSocial, ")
    SQL.ADD(" C.Direccion, C.Localidad, P.AliasAFIP Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
    SQL.ADD(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")    
    SQL.ADD(" C.Persona, C.TipoInscripcion, C.Pais Pais, C.TipoDocum, C.NrDocum,C.CodComitente as ComitenteCli, C.Alias9 Puerta, C.Nrcuenta, PA.Alias PaisAFIP, ")

    **AA 11-12-2023 Custom BOFA Codcomitente y CUIT NO SE PUEDE UTILIZAR EL STD - GSITEN Custom en MLCUSTOM2
    #ifdef MLASA
    SQL.ADD(" C.CUIT, C.ComitenteAux ")
    #else
    SQL.ADD("  Case When C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE C.CUIT END END CUIT, ")
    #ifdef BACS
    SQL.ADD(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' then (select CodComitente from CLIENTES where Codigo ='"~Dialogo.Vehiculo1~"') else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end ComitenteAux ")
    #else
     SQL.ADD(" Case when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"' ) Then (select NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1)  ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' ) then Nrcuenta ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"') then (select Top(1) CT.NrDepositante from dbo.CUENTAS CT Where CT.Cliente = O.Cliente1 and TipoCuenta = 'CUS' and NrDepositante is not Null) else Nrcuenta  end ComitenteAux ")
    #endif
    #endif    
    SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
    SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PROVINCIAS P WITH (NOLOCK) ON C.Provincia=P.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PA WITH (NOLOCK) ON C.Pais=PA.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PI WITH (NOLOCK) ON C.PaisInsc=PI.Codigo ")
    SQL.ADD("    , "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
    SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
    SQL.ADD("  and O.Especie    =  E.Codigo  ")
    SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
    SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ") 
    SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
    SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD("  and O.TipoOp In ('TIC','TIFC','TIV','TIFV')  ")
    SQL.ADD("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
    ** 09-10-21 AA. Saco datos del BOFA
    **SQL.ADD("  and  (PaseCB= 1 and (E.Jerarquia LIKE '"~Var('JERLEBACS')~"%' or E.Issuer = '"~Var('CLIBCRA')~"')) ) as Aux ")
    SQL.ADD("  and  (PaseCB= 1 and E.Issuer = '"~Var('CLIBCRA')~"') ")
    SQL.ADD(" UNION ALL ")
    SQL.ADD(" SELECT O.NrOperacion,'99'  Pase, ")
    SQL.ADD(" O.TotalBrutoCli1 Monto, ")
    SQL.ADD(" '1' Posicion, ")
    SQL.ADD(" '1' Plazo, ")
    SQL.ADD("  1  TipoCV, O.FechaVto, O.Especie, O.ContraEspecie, ")
    SQL.ADD(" '13' TipoOPX, PaseCB, E.Issuer, E.MonedaEmision,")    
    SQL.ADD(" CASE WHEN O.ContraEspecie in ('ARP') THEN '001'  When O.ContraEspecie in ('USD') then '004' When O.ContraEspecie in ('EUR') then '006' else '000' END Moneda,TipoOp, ")
    SQL.ADD(" CASE WHEN (E.Indexado = 'NO' and E.MonedaEmision in ('"~Var('MONELOCA')~"')) THEN 1  ELSE 2 END Emision, C.Alias10 NIF, ")
    SQL.ADD("  1  Exencion, C.Calle, C.Altura, C.Piso, C.Depto, C.RazonSocial, ")
    SQL.ADD(" C.Direccion, C.Localidad, P.AliasAFIP Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
    SQL.ADD(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")    
    SQL.ADD(" C.Persona, C.TipoInscripcion, C.Pais Pais, C.TipoDocum, C.NrDocum,C.CodComitente as ComitenteCli, C.Alias9 Puerta, C.Nrcuenta, PA.Alias PaisAFIP, ")
    **AA 11-12-2023 Custom BOFA Codcomitente y CUIT NO SE PUEDE UTILIZAR EL STD - GSITEN Custom en MLCUSTOM2
    #ifdef MLASA
    SQL.ADD(" C.CUIT, C.ComitenteAux ")
    #else
    SQL.ADD("  Case When C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE C.CUIT END END CUIT, ")
    #ifdef BACS
    SQL.ADD(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' then (select CodComitente from CLIENTES where Codigo ='"~Dialogo.Vehiculo1~"') else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end ComitenteAux ")
    #else
    **SQL.ADD(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' then (select CodComitente from clientes where Codigo=O.Cliente1) else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end CodComitente ")
     SQL.ADD(" Case when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"' ) Then (select NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1)  ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' ) then Nrcuenta ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"') then (select Top(1) CT.NrDepositante from dbo.CUENTAS CT Where CT.Cliente = O.Cliente1 and TipoCuenta = 'CUS' and NrDepositante is not Null) else Nrcuenta  end ComitenteAux ")
    #endif
    #endif    
    SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
    SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PROVINCIAS P WITH (NOLOCK) ON C.Provincia=P.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PA WITH (NOLOCK) ON C.Pais=PA.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PI WITH (NOLOCK) ON C.PaisInsc=PI.Codigo ")
    SQL.ADD("    , "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
    SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
    SQL.ADD("  and O.Especie    =  E.Codigo  ")
    SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
    SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ") 
    SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
    SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD("  and O.TipoOp In ('CAUC')  ) as Aux ") 
    ** AA 08-08-2025 - Pases y Cauciones - Resolución General 2025-5699-E-AFIP-ARCA topes P.Fisica y Juridica
    ** Periodo anterior no verifica Umbral.    
    If Fecha(Dialogo.fecha1,'YYYYMMDD') > VAR('SITERANT')
       if Not Vacio(Dialogo.Cliente1)
          SQL.ADD("  where Cliente = '"~Dialogo.Cliente1~"' ")
       else
          #ifdef BIND
              SQL.ADD("  where Cliente in ("~Pipe2Comillas(Val(eb:2))~") and Cliente <> '"~Dialogo.Vehiculo1~"' ")
          #else   
              SQL.ADD("  where Cliente in ("~Pipe2Comillas(Val(eb:2))~")  ")
          #endif
       endif   
    Else
       If Not Vacio(Dialogo.Cliente1)
          SQL.ADD("  where Cliente = '"~Dialogo.Cliente1~"' ")
       else
          #ifdef BIND
             If Vacio(Dialogo.Cliente1)
                SQL.ADD("  where Cliente <> '"~Dialogo.Vehiculo1~"' ") 
             Endif
          #endif
       endif   
     Endif
     
    SQL.ADD("  ORDER BY  Pase, TipoOPX, CodComitente, Posicion, Plazo, Moneda ")
    **watch( sql.batch())

    ACN(po:1,0)
    ACN(po:2,0)

    Recorrer SQL
       SCN(da1,1)
    
       IF Not EqStr(fbn['TipoOPX']~fbn['CodComitente']~fbn['Posicion']~fbn['Plazo']~fbn['Moneda'],Val(cl1))
          If EqStr(Val(cl1),'INICIO')
             ACT(cl2,fbn['TipoOPX'])
             ACT(cl3,fbn['CodComitente'])
             ACT(cl4,fbn['Posicion']) 
             ACT(cl5,fbn['Plazo'])              
             ACT(cl6,fbn['Moneda'])                           
             ACT(cl1,Val(cl2)~Val(cl3)~Val(cl4)~Val(cl5)~Val(cl6))
          Else
             ** Generar Total Registro 03
             ACT(bt:fac-1,Val(cl2))
             ACT(bu:fac-1,Val(cl3))
             ACT(bv:fac-1,Val(cl4))
             ACT(bw:fac-1,Val(cl5))
             ACT(bx:fac-1,Val(cl6))             
             ACN(by:fac-1,Val(po:1))
             ACN(bz:fac-1,Val(po:2))
             ACT(cl2,fbn['TipoOPX'])
             ACT(cl3,fbn['CodComitente'])
             ACT(cl4,fbn['Posicion']) 
             ACT(cl5,fbn['Plazo'])              
             ACT(cl6,fbn['Moneda'])                           
             ACT(cl1,Val(cl2)~Val(cl3)~Val(cl4)~Val(cl5)~Val(cl6))
             ACN(po:1,0)
             ACN(po:2,0)             
          Endif
      Endif

      ** Funcion  - genera datos operaciones y comitentes
      ACT(xy80,'03')
      (.'GSITENR'.) 

      ** Fin Funcion
      
    Proximo

    ACN(xy99,Fac)
    ** Generar Total Registro 03
    ACT(bt:fac,Val(cl2))
    ACT(bu:fac,Val(cl3))
    ACT(bv:fac,Val(cl4))
    ACT(bw:fac,Val(cl5))
    ACT(bx:fac,Val(cl6))             
    ACN(by:fac,Val(po:1))
    ACN(bz:fac,Val(po:2))
    
** Registro 01 Cabecera 
    
    *Tipo Registro
    ACT(rr1,'01')
    *CUIT   
    ACT(rr1,Val(rr1)~ReemplazarStr(VAR('CUIT'),'-','',SI))
    *Tipo Agente
    ACT(rr1,Val(rr1)~'1')
    *Secuencia
    ACT(rr1,Val(rr1)~Pad0(Fstr(Dialogo.Entero3,0,0),2))
    *Tipo Impuesto
    ACT(rr1,Val(rr1)~'0103')
    *Tipo Concepto
    ACT(rr1,Val(rr1)~'913')
    *Nro. Formulario
    ACT(rr1,Val(rr1)~'0195')
    *Filler
    ** AA 27-07-2023 a solicitud BACS se rellena con ceros
    **ACT(rr1,Val(rr1)~Pad('',215))
    ACT(rr1,Val(rr1)~Pad0('0',215))
    *Version
    ACT(rr1,Val(rr1)~'00400')
    *Presentacion Sin Movimiento
    If Val(da1)>0
       ACT(rr1,Val(rr1)~'0')
    Else
       ACT(rr1,Val(rr1)~'1')
    Endif
    *Periodo
    ACT(rr1,Val(rr1)~Copy(Dialogo.Fecha1,7,4)~Copy(Dialogo.Fecha1,4,2))

    ACT(rr6,Val(rr1))
    EscribirASCII(Val(rr6))

** Fin Registro Cabecera

IF Val(da1)>0
** Registro 02 Tipo Operacion

   Recorrer&i Val(xy2),Val(xy99)
   If NoVacio(Val(bm:&i)) y Not EqStr(Val(bl:&i),'99')
        *Tipo Registro
        ACT(rr2,'02')
        *Tipo Operacion
        ACT(rr2,Val(rr2)~Pad0(Val(bq:&i),2))
        *Cuenta Comitente
        ACT(rr2,Val(rr2)~Pad0(Val(bn:&i),11))
        *Tipo Monedas
        ACT(rr2,Val(rr2)~Pad0(Val(bm:&i),3))
        *Importe
        ACT(rr2,Val(rr2)~Pad0(Fstr(Abs(Val(bp:&i)),0,0),20))
        *Operacion
        ACT(rr2,Val(rr2)~Pad0(Val(bo:&i),1))
        *Condicion Emision
        ACT(rr2,Val(rr2)~Pad0(Val(br:&i),1))
        *Exencion
        ACT(rr2,Val(rr2)~Pad0(Val(bs:&i),1))
        
        ACT(rr6,Val(rr2))
        EscribirASCII(Val(rr6))
        
     Endif
   Proximo

** Fin Registro 02 Tipo Operacion
    
** Registro 03 Operaciones Pases/Caucion

   Recorrer&i Val(xy3),Val(xy99)
   If EqStr(Val(bl:&i),'99') y NoVacio(Val(bt:&i))
        *Tipo Registro
        ACT(rr3,'03')
        *Tipo Operacion
        ACT(rr3,Val(rr3)~Pad0(Val(bt:&i),2))
        *Cuenta Comitente
        ACT(rr3,Val(rr3)~Pad0(Val(bu:&i),11))
        *Posicion
        ACT(rr3,Val(rr3)~Pad0(Val(bv:&i),1))
        *Plazo
        ACT(rr3,Val(rr3)~Pad0(Val(bw:&i),1))
        *Moneda
        ACT(rr3,Val(rr3)~Pad0(Val(bx:&i),3))
        *Monto Especie
        ACT(rr3,Val(rr3)~Pad0(Fstr(Abs(Val(by:&i)),0,0),20))
        *Monto ARP
        ACT(rr3,Val(rr3)~Pad0(Fstr(Abs(Val(bz:&i)),0,0),20))

        ACT(rr6,Val(rr3))
        EscribirASCII(Val(rr6))        
     Endif
   Proximo
   
** Fin Registro 03  Operaciones Pases/Caucion
#ifdef MLASA
#else

** AA 08-08-2025 - Ingresos/Egresos/Rentas - Resolución General 2025-5699-E-AFIP-ARCA topes P.Fisica y Juridica
** Periodo anterior no verifica Umbral.

   If Fecha(Dialogo.fecha1,'YYYYMMDD') > VAR('SITERANT')
      SQL.ADD(" Select TipoMov, Cliente, SUM(MontoARP) Umbral,Persona  from  ")
      SQL.ADD(" (SELECT CASE WHEN TipoOp in ('TIC','TIFC') THEN '0'  ELSE '1' END TipoMov, ")
      SQL.ADD("  CASE WHEN O.ContraEspecie in ('ARP') THEN O.TotalNetoCli1 else (Select Top(1) PrecioContable*O.TotalNetoCli1 From "~DBO~".COTIZACIONES C Where Codigo = O.ContraEspecie and Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) END MontoARP, ")
      SQL.ADD(" O.Cliente1 Cliente, C.Persona ")
      SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
      SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
      SQL.ADD("       , "   ~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
      SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
      SQL.ADD("  and O.Especie    =  E.Codigo  ")
      SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
      SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
      SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and O.TipoOp In ('TIC','TIFC','TIV','TIFV','TCOPRI')  ")   
      SQL.ADD("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
      SQL.ADD("  and PaseCB <> 1  ")
      SQL.ADD("UNION")
      SQL .ADD(" SELECT  '2' TipoMov, ")
      SQL.ADD("  CASE WHEN O.ContraEspecie in ('ARP') THEN (Select Top(1) PrecioContable*O.TotalIntereses From "~DBO~".COTIZACIONES C Where Codigo = O.Especie and Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) ") 
      SQL.ADD("       else (Select Top(1) PrecioContable*O.TotalIntereses From "~DBO~".COTIZACIONES C Where Codigo = O.Especie and Moneda = O.ContraEspecie AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) END MontoARP, ")
      SQL.ADD(" O.Cliente1 Cliente, C.Persona ")
      SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
      SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
      SQL.ADD("       , "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
      SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
      SQL.ADD("  and O.Especie    =  E.Codigo  ")
      SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
      SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
      SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and O.TipoOp In ('TIDE')  ")   
      SQL.ADD("  and (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' or E.Jerarquia LIKE '"~Var('JERACCION')~"%') ")
      ** AA 24-07-2025 se incorporan las transacciones por pago de Renta/Dividendos
      SQL.ADD("UNION")   
      SQL .ADD(" Select TipoMov, Case when Moneda = '001' then Monto Else Monto*Precio End  MontoARP, ")
      SQL.ADD("    Cliente, Persona  from   ")   
      SQL.ADD("(SELECT  '2' TipoMov, ")
      SQL.ADD("CASE WHEN T.Especie1 in ('ARP') THEN '001'  When T.Especie1 in ('USD') then '004' When T.Especie1 in ('EUR') then '006' else '000' END  Moneda, ")
      SQL.ADD("CAse when T.especie1 in ('ARP') THEN 1 else (Select Top(1) Precio1 From dbo.COTIZACIONES C Where Codigo = T.Especie1 AND Moneda ='"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) END as Precio, ")
      SQL.ADD("O.Cantidad  as Monto,   ")
      SQL.ADD("O.Cliente Cliente, Persona ")   
      SQL.ADD("FROM  "~DBO~".MOVEJECUTADOS O ")
      SQL.ADD("       Left JOIN dbo.TRANSACCIONES2 T  on O.NrOperacion=T.NrTrans ")
      SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente=C.Codigo ")
      SQL.ADD("       ,"~DBO~".ESPECIES E, "~DBO~".ESPECIES ET ")
      SQL.ADD("where O.Especie    =  E.Codigo  ")
      SQL.ADD("  and T.Especie    =  ET.Codigo ")
      SQL.ADD("  and E.Tipo    <> 'TBL'  ")
      SQL.ADD("    and O.FechaMov between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and NrSaldo = 1   ")
      SQL.ADD("  and E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
      SQL.ADD("  and Leyenda like 'Pago de%'    ")
      SQL.ADD("UNION")   
      SQL.ADD("SELECT  '2' TipoMov, ")
      SQL.ADD("CASE WHEN T.Especie1 in ('ARP') THEN '001'  When T.Especie1 in ('USD') then '004' When T.Especie1 in ('EUR') then '006' else '000' END  Moneda, ")
      SQL.ADD("CAse when T.especie1 in ('ARP') THEN 1 else (Select Top(1) Precio1 From dbo.COTIZACIONES C Where Codigo = T.Especie1 AND Moneda ='"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) END as Precio, ")
      SQL.ADD("O.Cantidad  as Monto,   ")
      SQL.ADD("O.Cliente Cliente, Persona ")   
      SQL.ADD("FROM  "~DBO~".MOVEJECUTADOS O ")
      SQL.ADD("       Left JOIN dbo.TRANSACCIONES2 T  on O.NrOperacion=T.NrTrans ")
      SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente=C.Codigo ")
      SQL.ADD("       ,"~DBO~".ESPECIES E, "~DBO~".ESPECIES ET ")
      SQL.ADD("where O.Especie    =  E.Codigo  ")
      SQL.ADD("  and T.Especie    =  ET.Codigo ")
      SQL.ADD("  and E.Tipo    <> 'TBL'  ")
      SQL.ADD("    and O.FechaMov between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and NrSaldo = 1   ")
      SQL.ADD("  and E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
      SQL.ADD("  and Leyenda like 'liq. Renta%'    ")
      SQL.ADD("UNION")
      SQL.ADD("SELECT  '0' TipoMov, ")
      SQL.ADD("CASE WHEN T.Especie1 in ('ARP') THEN '001'  When T.Especie1 in ('USD') then '004' When T.Especie1 in ('EUR') then '006' else '000' END  Moneda, ")
      SQL.ADD("CAse when T.especie1 in ('ARP') THEN 1 else (Select Top(1) Precio1 From dbo.COTIZACIONES C Where Codigo = T.Especie1 AND Moneda ='"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) END as Precio, ")
      SQL.ADD("O.Cantidad  as Monto,   ")
      SQL.ADD("O.Cliente Cliente, Persona ")   
      SQL.ADD("FROM  "~DBO~".MOVEJECUTADOS O ")
      SQL.ADD("       Left JOIN dbo.TRANSACCIONES2 T  on O.NrOperacion=T.NrTrans ")
      SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente=C.Codigo ")
      SQL.ADD("       ,"~DBO~".ESPECIES E, "~DBO~".ESPECIES ET ")
      SQL.ADD("where O.Especie    =  E.Codigo  ")
      SQL.ADD("  and T.Especie    =  ET.Codigo ")
      SQL.ADD("  and E.Tipo    <> 'TBL'  ")
      SQL.ADD("    and O.FechaMov between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and NrSaldo = 1   ")
      SQL.ADD("  and E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
      SQL.ADD("  and Leyenda like 'liq. Amort%'    ")   
      SQL.ADD("  ) as Aux ")
      SQL.ADD("   ) as Aux1 ")
      SQL.ADD("  group by TipoMov,Cliente,Persona ")
      **watch(sql.batch())
   
       ** Genera lista de Clientes a tomar
      Recorrer SQL
         dfa
         if EqStr(fbn['Persona'],'NO')
            if fbn['Umbral'] >= Var('LIMSITERPJ')
               ACT(eb:3,val(eb:3)~fbn['Cliente']~'|')
            endif
         else
            if fbn['Umbral'] >= Var('LIMSITERPF')
               ACT(eb:3,val(eb:3)~fbn['Cliente']~'|')
            endif       
         endif   
       Proximo     
   Endif

