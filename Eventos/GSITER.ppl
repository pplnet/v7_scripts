message('Operaciones en cabeza de Bancor de Clientes depositandes en Bancor...')
SQL.ADD("Select 'BANCOR' as Cliente1, O.NrOperacion, 'NO' as Persona, ")
SQL.ADD("       O.TipoOp as TipoOp, '20' as CodComitente, ")
SQL.ADD("       O.Especie, O.ContraEspecie, O.FechaOp, O.FechaVto, ")
SQL.ADD("       Cant    = CASE WHEN O.PaseCB='0' THEN CASE WHEN O.TipoOp = 'CTC' THEN O.TotalNetoCli1 ELSE O.TotalBrutoCli1 END ELSE CASE WHEN O.PaseCB is Null THEN CASE WHEN O.TipoOp = 'CTC' THEN O.TotalNetoCli1 ELSE O.TotalBrutoCli1 END ELSE 0 END END,  ")
SQL.ADD("       CantD   = CASE WHEN O.PaseCB='1' THEN O.TotalCaucion ELSE 0 END,  ")
SQL.ADD("       CantT   = 0,  ")
SQL.ADD("       Comis   = 0,  ")
SQL.ADD("       ComiT   = 0,  ")
SQL.ADD("       TipoEsp = CASE WHEN E.Tipo='PUB' THEN 1 ELSE 2 END  ")
SQL.ADD("  From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS B, ")
SQL.ADD("       "~DBO~".ESPECIES E,"~DBO~".CLIENTES C ")
SQL.ADD(" Where O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' ") 
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif

SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
SQL.ADD("   and B.NrBit = 30 ")
SQL.ADD("   and B.Valor = '0' ")
SQL.ADD("   and O.FechaVto >= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   and O.FechaVto <= "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("   and O.Cliente1 = C.Codigo ")
SQL.ADD("   and O.Especie  = E.Codigo ")
SQL.ADD("   and C.DeposDelComitente in ('489','0489','1125') ")
SQL.ADD("   and O.TipoOp In ('TIV','TIC','TIFV','TIFC','TCOPRI') ")
SQL.ADD(" Union All ")
