   *SQL.ADD(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' then (select CodComitente from clientes where Codigo=O.Cliente1) else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end CodComitente, ")    
