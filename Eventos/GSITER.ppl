   SQL.ADD("  and T.Especie    =  ET.Codigo ")
   SQL.ADD("  and E.Tipo    <> 'TBL'  ")
   SQL.ADD("    and O.FechaMov between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
   SQL.ADD("  and NrSaldo = 1   ")
   SQL.ADD("  and E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
   SQL.ADD("  and Leyenda like 'liq. Amort%'    ")   
   SQL.ADD("  ) as Aux ")
   SQL.ADD("   ) as Aux1 ")
   SQL.ADD("   ) as Aux2 ")
   ** AA 08-08-2025 - Pases y Cauciones - Resolución General 2025-5699-E-AFIP-ARCA topes P.Fisica y Juridica
   ** Periodo anterior no verifica Umbral.    
    If Fecha(Dialogo.fecha1,'YYYYMMDD') > VAR('SITERANT')
       if Not Vacio(Dialogo.Cliente1)
          SQL.ADD("  where Cliente = '"~Dialogo.Cliente1~"' ")
       else
          #ifdef BIND
              SQL.ADD("  where Cliente in ("~Pipe2Comillas(Val(eb:3))~") and Cliente <> '"~Dialogo.Vehiculo1~"' ")
          #else   
              SQL.ADD("  where Cliente in ("~Pipe2Comillas(Val(eb:3))~")  ")
          #endif
       endif   
    Else
       If Not Vacio(Dialogo.Cliente1)
          SQL.ADD("  where Cliente = '"~Dialogo.Cliente1~"' ")
       else
          ** AA 26-04-2024 Bind Solicita no tomar Cliente=Bind       
          #ifdef BIND
             If Vacio(Dialogo.Cliente1)
                SQL.ADD("  where Cliente <> '"~Dialogo.Vehiculo1~"' ") 
             Endif
          #endif
       endif   
     Endif
   
   SQL.ADD("  group by TipoMov,CodComitente,Cliente,DeposDelComitente,Moneda,Especie,CodNumCajaValores,Nombre ")
   ** AA 31-07-2023 BACS agrupacion por TipoMov,CodComitente,Moneda,CodEspecie BACS 31-07-2023 no fue solicitado por Bind ?????
   **   SQL.ADD("  ORDER BY  CodComitente, DeposDelComitente,Especie, Nombre, CodNumCajaValores,Moneda, TipoMov ")
   **SQL.ADD("  ORDER BY  TipoMov,CodComitente, Moneda,Especie,Nombre ")   
   SQL.ADD("  ORDER BY  CodComitente,TipoMov, Moneda,Especie,Nombre ")   
   **watch(sql.batch())

   ACN(da1,0)
   ACN(po:1,0)
   ACN(po:2,0)
   
   Recorrer SQL
     SCN(da1,1) 
    
    IF Not EqStr(fbn['TipoMov']~fbn['CodComitente']~fbn['Moneda']~fbn['Especie']~fbn['Nombre'],Val(cl1))
         If EqStr(Val(cl1),'INICIO')
             ACT(cl2,fbn['TipoMov'])
             ACT(cl3,fbn['CodComitente'])
             ACT(cl4,fbn['Moneda']) 
             ACT(cl5,fbn['Especie'])              
             ACT(cl6,fbn['Nombre'])
             ACT(cl1,Val(cl2)~Val(cl3)~Val(cl4)~Val(cl5)~Val(cl6))
          Else
          ** Generar Total Registro 04
             ACT(ca:fac-1,Val(cl2))
             ACT(cb:fac-1,Val(cl3))
             ACT(cc:fac-1,Val(cl4))
             ACT(cd:fac-1,Val(cl5))
             ACT(ce:fac-1,Val(cl6))
             ACN(cf:fac-1,Val(po:1))
             ACN(cg:fac-1,Val(po:2))
             ACT(cl2,fbn['TipoMov'])
             ACT(cl3,fbn['CodComitente'])
             ACT(cl4,fbn['Moneda']) 
             ACT(cl5,fbn['Especie'])              
             ACT(cl6,fbn['Nombre'])                           
             ACT(cl1,Val(cl2)~Val(cl3)~Val(cl4)~Val(cl5)~Val(cl6))
             ACN(po:1,0)
             ACN(po:2,0)             
          Endif
      Endif

    
    ACT(a:fac,'04')
    ACT(b:FAC, fbn['TipoMov'])
    ACT(c:FAC, fbn['CodComitente'])
    ACT(d:FAC, '')
    ACT(e:FAC, '')
    ACT(f:FAC, fbn['Moneda'])
    ACN(g:FAC, fbn['Monto'])
    ACN(h:FAC, fbn['MontoARP'])
    ACT(i:FAC, "")
    **ACT(k:FAC, fbn['Especie']~' '~fbn['Nombre'])
    ACT(k:FAC, fbn['Especie'])
    ACT(m:FAC, fbn['Cliente'])

    *ACT(ca:fac,fbn['TipoMov'])
    *ACT(cb:fac,fbn['CodComitente'])
    *ACT(cc:fac,fbn['Moneda'])
    *ACT(cd:fac,fbn['Especie'])
    *ACT(ce:fac,fbn['Nombre'])
    *ACN(cf:fac,FBN['Monto'])
    *ACN(cg:fac,fbn['MontoARP'])    

    SCN(po:1,FBN['Monto'])
    SCN(po:2,fbn['MontoARP'])
    
    SQL.ADD("  Select C.Calle, C.Altura, C.Piso, C.Depto, ")
    SQL.ADD(" C.RazonSocial, Case When C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = '"~fbn['Cliente']~"' and IC.TipoPoder = 'SDE') ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = '"~fbn['Cliente']~"' and IC.TipoPoder = 'SDE') ELSE C.CUIT END END CUIT, ")
    SQL.ADD("  C.Direccion, C.Localidad, P.AliasAFIP Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
    SQL.ADD(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")    
    SQL.ADD(" C.Persona, C.TipoInscripcion, C.Pais Pais, C.TipoDocum, C.NrDocum, C.Alias9 Puerta, PA.Alias PaisAFIP,C.Alias10 NIF ")
    SQL.ADD("FROM   "~DBO~".CLIENTES C ") 
    SQL.ADD("       Left JOIN "~DBO~".PROVINCIAS P WITH (NOLOCK) ON C.Provincia=P.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PA WITH (NOLOCK) ON C.Pais=PA.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PAISES PI WITH (NOLOCK) ON C.PaisInsc=PI.Codigo ")
    SQL.ADD("where C.Codigo    =  '"~fbn['Cliente']~"'  ")
    **watch(sql.batch())
    Recorrer SQL
      DFA
      ACT(aa:fac,FBN['RazonSocial'])
      ACT(ab:fac,IIF(EqStr(FBN['TipoCli'],'FONDO'),'91','80'))
      ACT(ac:fac,ReemplazarStr(FBN('CUIT'),'-','',SI))
      ACT(ad:fac,FBN['Calle'])
      ACT(ae:fac,FBN['Altura'])
      ACT(af:fac,'')
      ACT(ag:fac,'')
      ACT(ah:fac,'')
      ACT(ai:fac,'')
      ACT(aj:fac,FBN['Piso'])
      ACT(ak:fac,FBN['Localidad'])
      ACT(al:fac,FBN['Provincia'])
      ACT(am:fac,FBN['CodigoPostal'])
      ACT(an:fac,Val(c:fac))
      ACT(ao:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')) o EqStr(FBN['Pais'],Var('PAISARG')),'1','0'))
      ACT(ap:fac,IIF(EqStr(FBN['Persona'],'NO'),'2','1'))
      ACT(aq:fac,IIF(EqStr(FBN['TipoCli'],'FONDO'),'91','80'))
      ACT(ar:fac,ReemplazarStr(FBN('CUIT'),'-','',SI))
      ACT(as:fac,IIF(EqStr(FBN['Persona'],'NO'),'000',FBN['PaisInsc']))
      ACT(at:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')),'',''))
      ACT(au:fac,IIF(EqStr(FBN['Pais'],Var('MCPAIS')) o EqStr(FBN['Pais'],Var('PAISARG')) o EqStr(FBN['Persona'],'NO'),'00000000',''))
      ACT(av:fac,'03')
      ACT(aw:fac,'')
      ACT(ax:fac,FBN['PaisInsc'])
      ACT(ay:fac,Copy(FBN['FechaInsc'],7,4)~Copy(FBN['FechaInsc'],4,2)~Copy(FBN['FechaInsc'],1,2))
      ACT(az:fac,Copy(FBN['Direccion'],1,50))
      ACT(ba:fac,FBN['Localidad'])
      ACT(bb:fac,FBN['Provincia'])
      ACT(bc:fac,FBN['PaisAFIP'])
      ACT(bd:fac,FBN['NIF'])
      ACT(be:fac,FBN['PaisAFIP'])

    Proximo
 

   Proximo

 ACN(xy99,Fac)   
   
IF Val(da1)>0
   ACT(ca:fac,Val(cl2))
   ACT(cb:fac,Val(cl3))
   ACT(cc:fac,Val(cl4))
   ACT(cd:fac,Val(cl5))
   ACT(ce:fac,Val(cl6))
   ACN(cf:fac,Val(po:1))
   ACN(cg:fac,Val(po:2))

   Recorrer&i Val(xy4),Val(xy99)
     If NoVacio(Val(cc:&i))
        *Tipo Registro
        ACT(rr3,'04')
        *Tipo Operacion
        ACT(rr3,Val(rr3)~Copy(Val(ca:&i),1,1))
        *Cuenta Comitente
        ACT(rr3,Val(rr3)~Pad0(Val(cb:&i),11))
        *Moneda
        ACT(rr3,Val(rr3)~Pad(Val(cc:&i),3))
        *Monto Especie
        ACT(rr3,Val(rr3)~Pad0(Fstr(Abs(Val(cf:&i)),0,0),20))
        *Monto ARP
        ACT(rr3,Val(rr3)~Pad0(Fstr(Abs(Val(cg:&i)),0,0),20))
        *Codigo Especie
        **AA 27-07-2023 a solicitud BACS se rellena con ceros a la derecha
        **ACT(rr3,Val(rr3)~Pad(fbn['Especie'],8))
        ACT(rr3,Val(rr3)~Pad(Val(cd:&i),8,'0'))
        *Descripcion de la Especie
        *ACT(rr3,Val(rr3)~Pad(Val(k:fac),20))
        ACT(rr3,Val(rr3)~Pad(Val(ce:&i),20))
        
        ACT(rr6,Val(rr3))
        EscribirASCII(Val(rr6))
     Endif
   Proximo   
Endif
  
   
** Fin Registro 04  Ingresos/Egresos en Cta. Comitente
#endif


** Registro 05 Clientes
   SaltarHoja
   ifa
   ACT(a:FAC, "Tipo Reg.")
   ACT(b:FAC, "Comitente")
   ACT(c:FAC, "Nombre")
   ACT(e:FAC, "Tipo y Nro Documento")
   ACT(h:FAC, "Domicilio")

   
   SetFont(a:fac..m:FAC,2)
   AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))   

   ACT(co:1,'COMITENTE')
   ACN(xy6,11)
   ACN(xy8,11)
   ACN(ho:1,FAC+1)
   
   Recorrer&i Val(xy5),Val(xy99)
   If NoVacio(Val(c:&i)) y Not EqStr(Val(c:&i),Val(co:1))
      if EqStr(Val(co:1),'COMITENTE')
         ACT(co:1,Val(an:&i))
      Endif
        
        ACN(xy7,0)
        
        *Recorrer&k Val(xy5),Val(xy6)
        Recorrer&k Val(xy6),Val(xy8)
        
          If EqStr(Val(z:&k),Val(c:&i) )
             ACN(xy7,99)
          Endif
        Proximo
        If Val(xy7)=0
           *Tipo Registro
           ACT(rr5,'05')
           *Apellido y Nombre
           ACT(rr5,Val(rr5)~Pad(Val(aa:&i),100))
           *Tipo Documento
           ACT(rr5,Val(rr5)~Pad0(Val(ab:&i),2))
           *Nro Documento
           ACT(rr5,Val(rr5)~Pad0(Val(ac:&i),11))
           *Calle
           If EqStr(Val(ao:&i),'0')
              ACT(rr5,Val(rr5)~Pad(' ',30))
           Else
              ACT(rr5,Val(rr5)~Pad(Copy(Val(ad:&i),1,30),30))
           Endif
           ** AA 27-07-2023 a solicitud BACS se rellena con ceros a la izquierda
           *Numero Puerta
           If EqStr(Val(ao:&i),'0')
             ACT(rr5,Val(rr5)~Pad0('0',6))
           Else           
             ACT(rr5,Val(rr5)~Pad0(Copy(Val(ae:&i),1,6),6))
           Endif
            ** AA 27-07-2023 a solicitud BACS se rellena con ceros a la derecha Oficina, Sector,Torre, Manzana, Piso
            *Oficina
            ACT(rr5,Val(rr5)~Pad(Copy(Val(af:&i),1,5),5,'0'))
            *Sector
            ACT(rr5,Val(rr5)~Pad(Copy(Val(ag:&i),1,5),5,'0'))
            *Torre
            ACT(rr5,Val(rr5)~Pad(Copy(Val(ah:&i),1,5),5,'0'))
            *Manzana
            ACT(rr5,Val(rr5)~Pad(Copy(Val(ai:&i),1,5),5,'0'))
            *Piso
            ACT(rr5,Val(rr5)~Pad(Copy(Val(aj:&i),1,5),5,'0'))
            **
           *Localidad
           If EqStr(Val(ao:&i),'0')
              ACT(rr5,Val(rr5)~Pad(' ',60))
           Else
              ACT(rr5,Val(rr5)~Pad(Copy(Val(ak:&i),1,60),60))
           Endif
           *Cod Provincia
           If EqStr(Val(ao:&i),'0')
              ACT(rr5,Val(rr5)~Pad(' ',2))
           Else
              ACT(rr5,Val(rr5)~Pad0(Val(al:&i),2))
           Endif           
           *Codigo Postal
           If EqStr(Val(ao:&i),'0')
              ACT(rr5,Val(rr5)~Pad(' ',10))
           Else
              ACT(rr5,Val(rr5)~Pad(Copy(Val(am:&i),1,10),10))
           Endif           
           *Cuenta Comitente
           ACT(rr5,Val(rr5)~Pad0(Val(an:&i),11))
           *Residente
           ACT(rr5,Val(rr5)~Pad0(Val(ao:&i),1))
           *Tipo Persona
           ACT(rr5,Val(rr5)~Pad0(Val(ap:&i),1))
           If EqStr(Val(ao:&i),'0')
              *Tipo Documento
              *ACT(rr5,Val(rr5)~Pad0(Val(aq:&i),2))
              *Nro Documento
              *ACT(rr5,Val(rr5)~Pad0(Val(ar:&i),20))
              *Pais Documento
              ACT(rr5,Val(rr5)~Pad0(Val(as:&i),3))
              *Lugar Nacimiento
              ACT(rr5,Val(rr5)~Pad0(Val(at:&i),3))
              *Fecha Nacimiento
              ACT(rr5,Val(rr5)~Pad0(Val(au:&i),8))
              *Tipo Entidad
              ACT(rr5,Val(rr5)~Pad0(Val(av:&i),2))
              *Denominacion Entidad
              *ACT(rr5,Val(rr5)~Pad(Copy(Val(aw:&i),1,20),20))
              *Lugar Constitucion
              ACT(rr5,Val(rr5)~Pad0(Val(ax:&i),3))
              *Fecha Constitucion
              ACT(rr5,Val(rr5)~Pad0(Val(ay:&i),8))
              *Domicilio Actual Exterior
              ACT(rr5,Val(rr5)~Pad(Copy(Val(az:&i),1,50),50))
              *Ciudad / Localidad
              ACT(rr5,Val(rr5)~Pad(Copy(Val(ba:&i),1,30),30))
              *Prov. Depto Estado
              ACT(rr5,Val(rr5)~Pad(Copy(Val(bb:&i),1,30),30))
              *Pais
              ACT(rr5,Val(rr5)~Pad0(Val(bc:&i),3)) 
              *Numero NIF - solo No residentes
              ACT(rr5,Val(rr5)~Pad(Copy(Val(bd:&i),1,20),20))
              *Residencia Tributaria 200-Argentina
              ACT(rr5,Val(rr5)~Pad0(Val(be:&i),3))
           Else   
              *Pais Documento*Lugar Nacimiento*Fecha Nacimiento*Tipo Entidad
              ACT(rr5,Val(rr5)~Pad0('0',3)~Pad0('0',3)~Pad0('0',8)~Pad0('0',2))
           
              *Lugar Constitucion*Fecha Constitucion*Domicilio Actual Exterior*Ciudad / Localidad
              ACT(rr5,Val(rr5)~Pad0('0',3)~Pad0('0',8)~Pad(' ',50)~Pad(' ',30))
           
              *Prov. Depto Estado*Pais*Numero NIF*Residencia Tributaria
              ACT(rr5,Val(rr5)~Pad(' ',30)~Pad0('0',3)~Pad(' ',20)~Pad0('0',3))
           Endif
        
           ACT(co:1,Val(an:&i))
           ACT(z:Val(xy8),Val(an:&i))
           SCN(xy8,1)
        
           ACT(rr6,Val(rr5))
           EscribirASCII(Val(rr6))
   
           ACT(a:val(ho:1),'05')
           ACT(b:val(ho:1), Val(an:&i))
           ACT(c:val(ho:1), Val(aa:&i))
           ACT(e:val(ho:1), Val(ab:&i))
           ACT(f:val(ho:1), Val(ac:&i))
           *Calle
           If EqStr(Val(ao:&i),'0')
              ACT(rr0,Pad(' ',30))
           Else
              ACT(rr0,Pad(Copy(Val(ad:&i),1,30),30))
           Endif
           *Numero Puerta
           If EqStr(Val(ao:&i),'0')
              ACT(rr0,Val(rr0)~' '~Pad0('0',6))
           Else           
              ACT(rr0,Val(rr0)~' '~Pad0(Copy(Val(ae:&i),1,6),6))
           Endif
           If EqStr(Val(ao:&i),'0')
              ACT(rr0,Val(rr0)~' '~Pad(' ',60))
           Else
              ACT(rr0,Val(rr0)~' '~Pad(Copy(Val(ak:&i),1,60),60))
           Endif
           *Cod Provincia
           If EqStr(Val(ao:&i),'0')
              ACT(rr0,Val(rr0)~' '~Pad(' ',2))
           Else
              ACT(rr0,Val(rr0)~' '~Pad0(Val(al:&i),2))
           Endif           
           *Codigo Postal
           If EqStr(Val(ao:&i),'0')
              ACT(rr0,Val(rr0)~' '~Pad(' ',10))
           Else
              ACT(rr0,Val(rr0)~' '~Pad(Copy(Val(am:&i),1,10),10))
           Endif                      
           ACT(h:val(ho:1), Val(rr0))
           SCN(ho:1,1)
        
        Endif
        
     Endif
   Proximo
   
  
   If NoVacio(Val(an:Val(xy99))) y Not EqStr(Val(an:Val(xy99)),Val(co:1)) 
      ACN(xy7,0)
        Recorrer&k Val(xy6),Val(xy8)
        
          If EqStr(Val(z:&k),Val(c:Val(xy99)) )
             ACN(xy7,99)
          Endif
        Proximo       
        If Val(xy7)=0
           *Tipo Registro
           ACT(rr5,'05')
           *Apellido y Nombre
           ACT(rr5,Val(rr5)~Pad(Val(aa:Val(xy99)),100))
           *Tipo Documento
           ACT(rr5,Val(rr5)~Pad0(Val(ab:Val(xy99)),2))
           *Nro Documento
           ACT(rr5,Val(rr5)~Pad0(Val(ac:Val(xy99)),11))
           *Calle
           If EqStr(Val(ao:Val(xy99)),'0')
              ACT(rr5,Val(rr5)~Pad(' ',30))
           Else
           ACT(rr5,Val(rr5)~Pad(Copy(Val(ad:Val(xy99)),1,30),30))
           Endif
           *Numero Puerta
           If EqStr(Val(ao:Val(xy99)),'0')
              ACT(rr5,Val(rr5)~Pad(' ',6))
           Else           
           ACT(rr5,Val(rr5)~Pad(Copy(Val(ae:Val(xy99)),1,6),6))
           Endif
           *Oficina
           ACT(rr5,Val(rr5)~Pad(Copy(Val(af:Val(xy99)),1,5),5))
           *Sector
           ACT(rr5,Val(rr5)~Pad(Copy(Val(ag:Val(xy99)),1,5),5))
           *Torre
           ACT(rr5,Val(rr5)~Pad(Copy(Val(ah:Val(xy99)),1,5),5))
           *Manzana
           ACT(rr5,Val(rr5)~Pad(Copy(Val(ai:Val(xy99)),1,5),5))
           *Piso
           ACT(rr5,Val(rr5)~Pad(Copy(Val(aj:Val(xy99)),1,5),5))
           *Localidad
           If EqStr(Val(ao:Val(xy99)),'0')
              ACT(rr5,Val(rr5)~Pad(' ',60))
           Else
              ACT(rr5,Val(rr5)~Pad(Copy(Val(ak:Val(xy99)),1,60),60))
           Endif
           *Cod Provincia
           If EqStr(Val(ao:Val(xy99)),'0')
              ACT(rr5,Val(rr5)~Pad(' ',2))
           Else
              ACT(rr5,Val(rr5)~Pad0(Val(al:Val(xy99)),2))
           Endif           
           *Codigo Postal
           If EqStr(Val(ao:Val(xy99)),'0')
              ACT(rr5,Val(rr5)~Pad(' ',10))
           Else
              ACT(rr5,Val(rr5)~Pad(Copy(Val(am:Val(xy99)),1,10),10))
           Endif                      
           *Cuenta Comitente
           ACT(rr5,Val(rr5)~Pad0(Val(an:Val(xy99)),11))
           *Residente
           ACT(rr5,Val(rr5)~Pad0(Val(ao:Val(xy99)),1))
           *Tipo Persona
           ACT(rr5,Val(rr5)~Pad0(Val(ap:Val(xy99)),1))
           If EqStr(Val(ao:Val(xy99)),'0')
              *Tipo Documento
              *ACT(rr5,Val(rr5)~Pad0(Val(aq:Val(xy99)),2))
              *Nro Documento
              *ACT(rr5,Val(rr5)~Pad0(Val(ar:Val(xy99)),20))
              *Pais Documento
              ACT(rr5,Val(rr5)~Pad0(Val(as:Val(xy99)),3))
              *Lugar Nacimiento
              ACT(rr5,Val(rr5)~Pad0(Val(at:Val(xy99)),3))
              *Fecha Nacimiento
              ACT(rr5,Val(rr5)~Pad0(Val(au:Val(xy99)),8))
              *Tipo Entidad
              ACT(rr5,Val(rr5)~Pad0(Val(av:Val(xy99)),2))
              *Denominacion Entidad
              *ACT(rr5,Val(rr5)~Pad(Copy(Val(aw:Val(xy99)),1,20),20))
              *Lugar Constitucion
              ACT(rr5,Val(rr5)~Pad0(Val(ax:Val(xy99)),3))
              *Fecha Constitucion
              ACT(rr5,Val(rr5)~Pad0(Val(ay:Val(xy99)),8))
              *Domicilio Actual Exterior
              ACT(rr5,Val(rr5)~Pad(Copy(Val(az:Val(xy99)),1,50),50))
              *Ciudad / Localidad
              ACT(rr5,Val(rr5)~Pad(Copy(Val(ba:Val(xy99)),1,30),30))
              *Prov. Depto Estado
              ACT(rr5,Val(rr5)~Pad(Copy(Val(bb:Val(xy99)),1,30),30))
              *Pais
              ACT(rr5,Val(rr5)~Pad0(Val(bc:Val(xy99)),3)) 
              *Numero NIF - solo No residentes
              ACT(rr5,Val(rr5)~Pad(Copy(Val(bd:Val(xy99)),1,20),20))
              *Residencia Tributaria 200-Argentina
              ACT(rr5,Val(rr5)~Pad0(Val(be:Val(xy99)),3))
           Else
              *Pais Documento*Lugar Nacimiento*Fecha Nacimiento*Tipo Entidad
              ACT(rr5,Val(rr5)~Pad0('0',3)~Pad0('0',3)~Pad0('0',8)~Pad0('0',2))
              
              *Lugar Constitucion*Fecha Constitucion*Domicilio Actual Exterior*Ciudad / Localidad
              ACT(rr5,Val(rr5)~Pad0('0',3)~Pad0('0',8)~Pad(' ',50)~Pad(' ',30))
           
              *Prov. Depto Estado*Pais*Numero NIF*Residencia Tributaria
              ACT(rr5,Val(rr5)~Pad(' ',30)~Pad0('0',3)~Pad(' ',20)~Pad0('0',3))
           Endif
        
           ACT(rr6,Val(rr5))
           EscribirASCII(Val(rr6)) 
        Endif
   Endif 
   
   ** Fin Registro 05 Clientes
Endif

