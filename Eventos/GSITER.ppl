    If Fecha(Dialogo.fecha1,'YYYYMMDD') > VAR('SITERANT')
       SQL.ADD(" Select sum(ABS(CPA)) UmbralCPA, sum(ABS(VTA)) UmbralVTA,Persona, Cliente1 from ")
       SQL.ADD(" (SELECT O.TotalNetoCli1 CPA, 0 VTA, C.Persona,Cliente1 FROM   "~DBO~".OPERACIONES O ")
       SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
       SQL.ADD("    , "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
       SQL.ADD("where O.NrOperacion=B.NrOperacion  ")
       SQL.ADD("  and O.Especie    =  E.Codigo  ")
       SQL.ADD("  and IsNull(O.EsTBills,'')    <> 'SI'  ")
       SQL.ADD("  and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ") 
       SQL.ADD("  and B.NrBit=30 and B.Valor='0'  ")
       SQL.ADD("  and O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
