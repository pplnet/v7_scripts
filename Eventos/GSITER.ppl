watch(SQL.Batch)

Recorrer SQL

  if Not Eqstr(TRIM(Val(v:1)),TRIM(fbn['Cliente1']))
     if fac > 1
      ACN(bo:fac-1, Round(Val(y1),2))
      if Not EqStr(TRIM(Val(by:fac-1)),'NO')
         *Messagebox('Persona con integrantes')
         ACN(bp:fac-1, SQL("Select Count(*) from "~DBO~".INTEGRANTESCLI where Codigo='"~Val(v:1)~"' "))
      else
         ACN(bp:fac-1, 0)
      endif
      if Val(bp:fac-1)=0
        ACN(bq:fac-1, 1)
      else
        ACN(bq:fac-1, Val(bp:fac-1))
      endif
      ACN(br:fac-1, Val(bo:fac-1))
      if Val(br:fac-1)>=Dialogo.Cantidad1
        ACT(bt:fac-1, 'OK')
      endif
      ACN(bu:fac-1, Val(x1))
      ACN(bv:fac-1, fac-1)
    endif

    ACT(v:1, fbn['Cliente1'])
    ACN(x1, fac)
    ACN(y1, 0)
  endif

  ACT(ba:fac, fbn('Cliente1'))
  ACT(bb:fac, fbn('NrOperacion'))
  ACT(bc:fac, fbn('TipoOp'))
  ACT(bd:fac, fbn('Especie'))
  ACT(be:fac, fbn('ContraEspecie'))
  ACD(bf:fac, fbn('FechaOp'))
  ACD(bg:fac, fbn('FechaVto'))
  ACN(bh:fac, fbn('TipoEsp'))
  ACT(bx:fac, TRIM(fbn('CodComitente')))
  ACT(by:fac, fbn('Persona'))

*  ACN(bk:fac, iif(Eqstr(fbn['ContraEspecie'],'ARP'),1,Cotizacion(fbn['ContraEspecie']~'BNA','CON',,,fbn['FechaVto'],1)))
  ACN(bk:fac, iif(Eqstr(fbn['ContraEspecie'],'ARP'),1,Cotizacion(fbn['ContraEspecie'],'CON',,,fbn['FechaVto'],1)))

* AA 01-08-2012 no se informan los decimales Round2(Importe,0)  
  * para C/V Dif.Precios

  ACN(bi:fac, Round2((fbn('Cant')+fbn('CantD'))*Val(bk:fac),0))

  * para C/V Dif.Precios Trading
  ACN(bs:fac, Round2(fbn('CantT')*Val(bk:fac),0))

  * para C/V Deriv.Financieros
  ACN(bm:fac, Round2(fbn('CantD')*Val(bk:fac),0))
  
  * para C/V Comision
  ACN(bj:fac, Round2(fbn('Comis')*Val(bk:fac),0))

  * para C/V Comision Trading
  ACN(bn:fac, Round2(fbn('ComiT')*Val(bk:fac),0))

  * para C/V totales
*  ACN(bl:fac, (fbn('Cant')+fbn('CantD')+fbn('Comis'))*Val(bk:fac))
   ACN(bl:fac, Val(bi:fac)+Val(bj:fac))

  SCN(y1, Val(bl:fac))

Proximo

If fac > 0
  ACN(bo:fac, Round(Val(y1),2))
  if Not EqStr(TRIM(Val(by:fac-1)),'NO')
     ACN(bp:fac, SQL("Select Count(*) from "~DBO~".INTEGRANTESCLI where Codigo='"~Val(v:1)~"' "))
     *messagebox('con integrantes')
  else
    ACN(bq:fac, 1)
  endif
  if Val(bp:fac)=0
    ACN(bq:fac, 1)
  else
    ACN(bq:fac, Val(bp:fac))
  endif
  ACN(br:fac, Val(bo:fac)/Val(bq:fac))
  if Val(br:fac)>=Dialogo.Cantidad1
    ACT(bt:fac, 'OK')
  endif
  ACN(bu:fac, Val(x1))
  ACN(bv:fac, fac)
Endif

ACN(x2,fac)

SetFilaActual(0)
Recorrer&i 1,Val(x2)
  If EqStr(Val(bt:&i),'OK')
     If Val(bp:&i)>0 y Not EqStr(TRIM(Val(by:&i)),'NO')    
     *MessageBox('Con Integrantes')
      SQL.ADD("Select E.TipoDocumento+E.NrDocumento as Docum, P.CUIT, P.CUIL, P.Provincia, P.Pais, E.TipoDocumento, E.NrDocumento ")
      SQL.ADD("  from "~DBO~".ESTADOOPERATIVOINTEGRANTESCLI E, "~DBO~".PERSONAS P where E.NrOperacion= '"~Val(bb:&i)~"' ")
      SQL.ADD("   and E.TipoDocumento+E.NrDocumento=P.TipoDocumento+P.NrDocumento ")
      Recorrer SQL
        ACT(ca:fac, Val(ba:&i))
        ACT(cb:fac, fbn('Docum'))
        ACN(cc:fac, &i)
        ACN(cd:fac, Val(bu:&i))
        ACN(ce:fac, Val(bv:&i))
        ACN(cf:fac, 2)
        ACT(cg:fac, Val(bx:&i))
        ACT(ch:fac, Val(bh:&i))

        SQL.ADD("Select TipoDocumento+NrDocumento as Codigo,* ")
        SQL.ADD("  from "~DBO~".PERSONAS ")
        SQL.ADD(" where TipoDocumento+NrDocumento='"~Val(cb:fac)~"' ")
        Recorrer SQL
          dfa
          ACT(cs:fac, fbn['Codigo'])
          if NoVacio(fbn('CUIT'))
            ACT(ct:FAC, 'CIT')
          else
            if NoVacio(fbn('CUIL'))
              ACT(ct:FAC, 'CIL')
            endif
          endif
          if NoVacio(Val(ct:fac)) 
            ACT(cu:fac, IIF(Eqstr(Val(ct:FAC),'CIT'),'CUIT','CUIL') )
          else
            ACT(cu:fac, fbn['TipoDocumento'])
            if EqStr(fbn['TipoDocumento'],'CUIT'))
              ACT(ct:FAC, 'CIT')
            endif
            if EqStr(fbn['TipoDocumento'],'CUIL'))
              ACT(ct:FAC, 'CIL')
            endif
          endif
          ACT(cv:fac, BuscarCampo('PROVINCIAS','Alias1','Codigo',fbn['Provincia']))
          ACT(cw:fac, fbn['Pais'])
          if NoVacio(Val(ct:fac)) 
            if Eqstr(Val(ct:fac),'CIT') 
              ACT(cy:fac, '80')
              ACT(cz:fac, Pad0(Copy(fbn['CUIT'],1,11),11))
            else      
              ACT(cy:fac, '86')
              ACT(cz:fac, Pad0(Copy(fbn['CUIL'],1,11),11))
            endif
          else
            *-- Pregunto por Tipo de Documento ---- 
            if Eqstr(Val(cu:fac),'DNI') 
              ACT(cy:fac, '96')
              ACT(cz:fac, Pad0(fbn['NrDocumento'],11))
            else
              if Eqstr(Val(cu:fac),'LE') 
                ACT(cy:fac, '90')
                ACT(cz:fac, Pad0(fbn['NrDocumento'],11))
              else
                if Eqstr(Val(cu:fac),'LC')         
                  ACT(cy:fac, '89')
                  ACT(cz:fac, Pad0(fbn['NrDocumento'],11))
                else
                  if Eqstr(Val(cu:fac),'CI')
                    If NoVacio(Val(cv:fac)) y NoVacio(fbn['NrDocumento'])
                      ACT(cy:fac, Pad0(fstr(Num(Val(cv:fac)),0),2))
                      ACT(cz:fac, Pad0(Pad0(fbn['NrDocumento'],11))
                    Else
                      ACT(cy:fac, '99')
                      ACT(cz:fac, '99999999999')
                    Endif  
                  else
                    if Eqstr(Val(cu:fac),'PAS')
                      ACT(cy:fac, '94')
                      ACT(cz:fac, Pad0(fbn['NrDocumento'],11))
                    else
                      If NoVacio(Val(cw:fac)) y Not Eqstr(Val(cw:fac),'ARG')
                        ACT(cx:fac, Trim(Copy(BuscarCampo('PAISES','CodPersonaFisica','Codigo',Val(cw:fac)) ,1,11)) )
                        ACT(cy:fac, '80')
                        ACT(cz:fac, Pad0(val(pi1),11))
                      Else  
                        ACT(cy:fac, '99')
                        ACT(cz:fac, '99999999999')
                      Endif  
                    Endif
                  endif 
                endif    
              endif
            endif    
          endif
        Proximo
            
      Proximo
    Else
    *MessageBox('SIN Integrantes')
      ifa
      ACT(ca:fac, Val(ba:&i))
      ACT(cb:fac, Val(ba:&i))
      ACN(cc:fac, &i)
      ACN(cd:fac, Val(bu:&i))
      ACN(ce:fac, Val(bv:&i))
      ACN(cf:fac, 1)
      ACT(cg:fac, Val(bx:&i))
      ACT(ch:fac, Val(bh:&i))

      SQL.ADD("Select * ")
      SQL.ADD("  from "~DBO~".CLIENTES ")
      SQL.ADD(" where Codigo='"~Val(cb:fac)~"' ")
      Recorrer SQL
        dfa
        ACT(cs:fac, fbn['Codigo'])
        ACT(ct:fac, fbn['TipoInscripcion'])
        if NoVacio(Val(ct:fac)) 
          ACT(cu:fac, IIF(Eqstr(fbn['TipoInscripcion'],'CIT'),'CUIT','CUIL') )
        endif
        ACT(cv:fac, BuscarCampo('PROVINCIAS','Alias1','Codigo',fbn['Provincia']))
        ACT(cw:fac, fbn['PaisDir'])
        if NoVacio(Val(ct:fac)) 
          if Eqstr(Val(ct:fac),'CIT') 
            ACT(cy:fac, '80')
          else      
            ACT(cy:fac, '86')
          endif
          ACT(cz:fac, Pad0(Copy(fbn['CUIT'],1,11),11))
        else
          *-- Pregunto por Tipo de Documento ---- 
          if Eqstr(Val(cu:fac),'DNI') 
            ACT(cy:fac, '96')
            ACT(cz:fac, Pad0(fbn['NrDocum'],11))
          else
            if Eqstr(Val(cu:fac),'LE') 
              ACT(cy:fac, '90')
              ACT(cz:fac, Pad0(fbn['NrDocum'],11))
            else
              if Eqstr(Val(cu:fac),'LC')         
                ACT(cy:fac, '89')
                ACT(cz:fac, Pad0(fbn['NrDocum'],11))
              else
                if Eqstr(Val(cu:fac),'CI')
                  If NoVacio(Val(cv:fac)) y NoVacio(fbn['NrDocum'])
                    ACT(cy:fac, Pad0(fstr(Num(Val(cv:fac)),0),2))
                    ACT(cz:fac, Pad0(Pad0(fbn['NrDocum'],11))
                  Else
                    ACT(cy:fac, '99')
                    ACT(cz:fac, '99999999999')
                  Endif  
                else
                  if Eqstr(Val(cu:fac),'PAS')
                    ACT(cy:fac, '94')
                    ACT(cz:fac, Pad0(fbn['NrDocum'],11))
                  else
                    If NoVacio(Val(cw:fac)) y [Not Eqstr(Val(cw:fac),'ARG')]
                      ACT(cx:fac, Trim(Copy(BuscarCampo('PAISES',iif(Eqstr(TRIM(fbn['Persona']),'SI'),'CodPersonaFisica','CodPersonaJuridica'),'CODIGO',Val(cw:fac)) ,1,11)) )
                      ACT(cy:fac, '80')
                      ACT(cz:fac, Pad0(val(pi1),11))
                    Else  
                      ACT(cy:fac, '99')
                      ACT(cz:fac, '99999999999')
                    Endif  
                  Endif
                endif 
              endif    
            endif
          endif    
        endif
      Proximo
    endif
  endif
Proximo
ACN(x3, fac)

SetFilaActual(0)
Recorrer&i 1,Val(x3)
  ACT(v:2, 'a')
  ACN(v:3, 0)
  ACN(v:4, 0)
  Recorrer&j Val(cd:&i),Val(ce:&i)
    * desde CH hasta CR

    ACN(u:Mes(Val(bg:&j)), 1)

*   cb:Nro.Documento, bh:TipoEspecie, bg: Mes fecha Vto
*   ca:Cliente, bh:TipoEspecie, bg: Mes fecha Vto

    If Not EqStr(Val(cb:&i),Val(v:2)) o Val(bh:&j)<>Val(v:3) o Mes(Val(bg:&j))<>Val(v:4)
*    If Not EqStr(Val(ca:&i),Val(v:2)) o Val(bh:&j)<>Val(v:3) o Mes(Val(bg:&j))<>Val(v:4)
      ifa
      ACT(da:fac, Val(cb:&i))
*      ACT(da:fac, Val(ca:&i))
      ACN(db:fac, Val(bh:&j))
      ACN(dc:fac, Mes(Val(bg:&j)))
      ACT(v:2, Val(cb:&i))
*      ACT(v:2, Val(ca:&i))
      ACN(v:3, Val(bh:&j))
      ACN(v:4, Mes(Val(bg:&j)))
    Endif
*    ACN(xy55,Val(bp:Val(ce:&i)))
    ACN(xy55,1)

    If Incluido(Val(bc:&j),'TIC|TIFC|CTP|TCOPRI|CTC')
      * Compras
      SCN(dd:fac, Val(bl:&j)/Val(xy55))

      * Compras Dif.Precios
      SCN(de:fac, Val(bi:&j)/Val(xy55))

      * Compras Dif.Precios Trading
      SCN(ga:fac, Val(bs:&j)/Val(xy55))

      * Compras Deriv.Financieros
      SCN(dp:fac, Val(bm:&j)/Val(xy55))

      * Compras Comision
      SCN(df:fac, Val(bj:&j)/Val(xy55))

      * Compras Comision Trading
      SCN(dn:fac, Val(bn:&j)/Val(xy55))
    Else
      * Ventas
      SCN(dg:fac, Val(bl:&j)/Val(xy55))

      * Ventas Dif.Precios
      SCN(dh:fac, Val(bi:&j)/Val(xy55))

      * Ventas Dif.Precios Trading
      SCN(gb:fac, Val(bs:&j)/Val(xy55))

      * Ventas Deriv.Financieros
      SCN(dq:fac, Val(bm:&j)/Val(xy55))

      * Ventas Comision
      SCN(di:fac, Val(bj:&j)/Val(xy55))

      * Ventas Comision Trading
      SCN(do:fac, Val(bn:&j)/Val(xy55))
    Endif
    ACT(dk:fac, Val(cy:&i))
    ACT(dl:fac, Val(cz:&i))
    ACT(dm:fac, Val(cg:&i))
  Proximo
Proximo
ACN(x4, fac)

* Informe de Clientes - todos los integrantes de la cuenta

SetFilaActual(Val(w2))
SetFilaActual(fac+2)

ACT(a:fac,'Registros de Clientes')
SetFont(a:fac..p:fac,2)

SetFilaActual(fac+2)

ACT(a:fac, 'Cliente')
ACT(b:fac, 'Integrante')
ACT(c:fac, 'Razon Social')
ACT(e:fac, 'Domicilio')
ACT(g:fac, 'Localidad')
ACT(h:fac, 'Provincia')
ACT(i:fac, 'C.P.')
ACT(j:fac, 'TDoc')
ACT(k:fac, 'NrDoc')
ACT(l:fac, 'Periodo')
ACT(m:fac, 'Comitente')
ACT(n:fac, 'Residente')

AlinearCeldas(a:fac..n:fac,'I')
SetFont(a:fac..n:fac,2)
AgregarMarco(a:fac..n:fac,2,0,Exe('COLOR6'))

Recorrer&i 1,Val(x3)
  if Val(cf:&i)=1
    SQL.ADD("Select E.RazonSocial as Apellido,'' as Nombre,E.Direccion as Calle, '' as numero,E.Localidad,E.CodigoPostal, C.CondicionGan as NoResi from "~DBO~".CLIENTES C, "~DBO~".ESTADOOPERATIVOCLIENTE E  where C.Codigo = E.Cliente  ")
    SQL.ADD(" and  E.NrOperacion = '"~Val(bb:&i)~"' ")
  else
    SQL.ADD("Select Apellido, Nombre, Direccion as Calle,Numero, Localidad, CodigoPostal, Ganancias as NoResi from "~DBO~".ESTADOOPERATIVOINTEGRANTESCLI where NrOperacion = '"~Val(bb:&i)~"' ")

  endif
  Recorrer SQL
        ACT(a:fac, Val(ca:&i))
        If Not EqStr(Val(ca:&i),Val(cb:&i))
          ACT(b:fac, Val(cb:&i))
        Endif
        ACT(c:fac, Pad(Trim(Mirt(fbn['Apellido']))~' '~Trim(Mirt(fbn['Nombre'])),30))
        ACT(e:fac, Pad(Trim(Mirt(fbn['Calle']))~' '~Trim(Mirt(fbn['Numero'])),30))
        ACT(g:fac, Pad(fbn['Localidad'],15))
        ACT(h:fac, IIf(Vacio(Val(cv:&i)),'99',Pad0(fstr(Num(Val(cv:&i)),0),2)) )
        ACT(i:fac, fbn['CodigoPostal'])
        ACT(j:fac, Val(cy:&i))
        ACT(k:fac, Val(cz:&i))
        ACT(l:fac, Pad0(FStr(Val(v4),0,0),2))
        ACT(m:fac, Val(cg:&i))
        ACT(cj:&i, fbn['NoResi'])
        ACT(n:fac, iif(EqStr(Val(cj:&i),'NOR'),'NO','SI'))
        SetFont(a:fac..n:fac,1)
  Proximo
Proximo

* Informe de Operaciones - todos los integrantes de la cuenta
