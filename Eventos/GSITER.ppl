    Endif
  
    #ifdef BIND
        SQL.ADD(" Select *, case when ComitenteAux Is null then Nrcuenta else ComitenteAux end Codcomitente from ")
    #else
        SQL.ADD(" Select *, ComitenteAux CodComitente from ")
    #endif
    SQL.ADD(" (SELECT O.NrOperacion,Case When (PaseCB= 1 and (E.Jerarquia LIKE '"~Var('JERLEBACS')~"%' or E.Issuer = '"~Var('CLIBCRA')~"')) Then '99' When PaseCB= 1 Then '09' Else '01' End  Pase, ")
    SQL.ADD(" CASE WHEN (Cliente1 <> '"~Dialogo.Vehiculo1~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then O.TotalNetoCli1*-1  else O.TotalNetoCli1 end ")
    SQL.ADD("      WHEN (Cliente1 <> '"~Dialogo.Vehiculo1~"' and UDN2 in ('CPC1','SDIB','SNBSTCGAR'))  THEN  Case when TipoOp in ('TIC','TIFC') then O.TotalNetoCli1  else O.TotalNetoCli1*-1 end  ELSE ")
    SQL.ADD(" Case when Cliente1 = '"~Dialogo.Vehiculo1~"' then (case when TipoOp in ('TIC','TCOPRI','TIFC') Then O.TotalNetoCli1 else O.TotalNetoCli1*-1 end) else (case when TipoOp in ('TIC','TCOPRI','TIFC') then O.TotalNetoCli1 else O.TotalNetoCli1*-1 end) end  END Monto, ")
    SQL.ADD(" CASE WHEN (TipoOp in ('TIC','TCOPRI','TIFV') and PaseCB=1) THEN '1' WHEN (TipoOp in ('TIV','TIFC') and PaseCB=1) THEN '0'  ELSE '9' END Posicion, ")
    SQL.ADD(" CASE WHEN TipoOp in ('TIC','TIV') THEN '0'  ELSE '1' END Plazo, ") 
    SQL.ADD(" CASE WHEN (Cliente1 <> '"~Dialogo.Vehiculo1~"' and UDN2 not in ('CPC1','SDIB','SNBSTCGAR')) THEN Case when TipoOp in ('TIC','TIFC') then 2  else 1 end ELSE Case when TipoOp in ('TIC','TIFC','TCOPRI') then 1 else 2 end END TipoCV, ")
    SQL.ADD("     O.FechaVto, O.Especie, O.ContraEspecie, ")
    SQL.ADD(" Case When E.Jerarquia LIKE '"~Var('JERONESP')~"%' Then '06' When E.Jerarquia LIKE '"~Var('JERFIDESP')~"%' Then '05' When E.Jerarquia LIKE '"~Var('JERFONESP')~"%' Then '04' When E.Jerarquia LIKE '"~Var('JERACCION')~"%' Then '02' When E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' Then '01' Else '11' End TipoOPX, PaseCB, E.Issuer, E.MonedaEmision,")    
    SQL.ADD(" CASE WHEN O.ContraEspecie in ('ARP') THEN '001'  When O.ContraEspecie in ('USD') then '004' When O.ContraEspecie in ('EUR') then '006' else '000' END Moneda,TipoOp, ")
    SQL.ADD(" CASE WHEN (E.Indexado = 'NO' and E.MonedaEmision in ('"~Var('MONELOCA')~"')) THEN 1  ELSE 2 END Emision, C.Alias10 NIF, ")
    SQL.ADD("  1  Exencion, C.Calle, C.Altura, C.Piso, C.Depto, C.RazonSocial,C.NrCuenta,O.Cuenta1,")
    
    SQL.ADD("  C.Direccion, C.Localidad, P.AliasAFIP Provincia, C.CodigoPostal, PI.Alias PaisInsc,C.FechaInsc, C.Codigo Cliente, ")
    SQL.ADD(" CASE WHEN C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN 'FONDO' ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN 'FONDO' ELSE 'OTROS' END END TipoCli, ")    
    SQL.ADD(" C.Persona, C.TipoInscripcion, C.Pais Pais, C.TipoDocum, C.NrDocum,C.CodComitente as ComitenteCli, C.Alias9 Puerta, PA.Alias PaisAFIP, ")
    #ifdef MLASA
    SQL.ADD(" C.CUIT, C.CodComitente ComitenteAux")
    #else
     SQL.ADD("  Case When C.Jerarquia LIKE '"~Var('JERFONDOS')~"%' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE CASE WHEN C.TipoDocum LIKE 'FCI' THEN (Select IC.NrDocumento from INTEGRANTESCLI IC where IC.Codigo = O.Cliente1 and IC.TipoPoder = 'SDE') ELSE C.CUIT END END CUIT, ")
    #ifdef BACS
    SQL.ADD(" Case when (select IsNull(CT.Comitente,'') from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' then (select CodComitente from CLIENTES where Codigo ='"~Dialogo.Vehiculo1~"') else (select CT.NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) end ComitenteAux ")
    #else
   
     SQL.ADD(" Case when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"' ) Then (select NrDepositante from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1)  ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = Cliente1 and (select Comitente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) <> '"~Dialogo.Vehiculo1~"' ) then Nrcuenta ")
     SQL.ADD(" when ((select Cliente from dbo.CUENTAS CT Where CT.Codigo = O.Cuenta1) = '"~Dialogo.Vehiculo1~"') then (select Top(1) CT.NrDepositante from dbo.CUENTAS CT Where CT.Cliente = O.Cliente1 and TipoCuenta = 'CUS' and NrDepositante is not Null) else Nrcuenta  end ComitenteAux ")
    #endif
    #endif
    SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
    SQL.ADD("       Left JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ON  O.Cliente1=C.Codigo ")
    SQL.ADD("       Left JOIN "~DBO~".PROVINCIAS P WITH (NOLOCK) ON C.Provincia=P.Codigo ")
