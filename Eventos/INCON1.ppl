CrearDialogo
  Fecha1       : 'Fecha'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;FSys
  Check1       : 'Reprocesar'  ;1;2;;;;;;;0;
  Entero1      : 'Nr. Envio'   ;2;2;;Dialogo.Check1 = 1;Dialogo.Check1 = 1;Dialogo.Entero1 > 0 O Dialogo.Check1 = 0;'Nr. de Envio Invalido';NO;;;;;'###';
  Radio1       : 'Sist.Oper.|W98|NT'     ;3;2;;;;;;;1;
  Especie1     : 'Especie'     ;2;1;;Dialogo.Check1 = 0;
  Vehiculo1    : 'Vehiculo'    ;;;;;;[Vacio(Dialogo.Vehiculo1) Y Dialogo.Check1 = 0] O [NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Vehiculo Invalido';NO;;;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");
  Lista2       : 'TipoOp'      ;;;;Dialogo.Check1 = 0;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION") 
  NrOperacion1 : 'NrOperacion' ;;;;Dialogo.Check1 = 0;
  String1      : 'Path Txt'    ;;;;NO;;;;;Var("PATHINTCON");;;;;;;;;;;;;;;;;  
FinDialogo


If Not Ok
   Cancelar
Endif

EjecutarEvento('INCONT',Fecha1=Fsys,Check1=Dialogo.Check1,Entero1=Dialogo.Entero1,Radio1=Dialogo.Radio1,Especie1=Dialogo.Especie1,Vehiculo1=Dialogo.Vehiculo1,Lista2=Dialogo.Lista2,NrOperacion1=Dialogo.NrOperacion1,String1=Dialogo.String1)
EjecutarEvento('FTPCON',Radio1=Dialogo.Radio1)

