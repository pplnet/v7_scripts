CrearDialogo
  String1 : 'Archivo'     ; ; ;;  ;  ;;;;'G:\Corporate\STD_BANCO\Contabilidad\PlanCuentas.xlsx'
FinDialogo

If Not OK
   Cancelar
EndIf

ImportarXLS(a:1..c:300,a:1..c:300,Dialogo.String1)

If Vacio(val(a:1))
   Cancelar('No se ha podido recuperar el archivo:'~Dialogo.String1)
EndIf

If Vacio(SQL("SELECT 1 FROM "~DBO~".CONTABILIDAD WHERE Jerarquia = '001000000000000'"))
    SQL.ADD("INSERT INTO "~DBO~".CONTABILIDAD (Jerarquia,Codigo,Nombre) VALUES ('001000000000000','STD','Cuentas STD')")
    SQL.NEW
    SQL.EXEC    
EndIf
If Vacio(SQL("SELECT 1 FROM "~DBO~".CONTABILIDAD WHERE Jerarquia = '001001000000000'"))
    SQL.ADD("INSERT INTO "~DBO~".CONTABILIDAD (Jerarquia,Codigo,Nombre) VALUES ('001001000000000','Titulos','Titulos')")
    SQL.NEW
    SQL.EXEC    
EndIf

ACN(JE:1,198)
Recorrer&i 2,300
    If Vacio(SQL("SELECT 1 FROM "~DBO~".CONTABILIDAD WHERE Codigo = '"~Fstr(val(a:&i),0,0)~"'"))
        ACN(JE:1,val(JE:1)+1)
        ACT(JE:2,'001001'~PAD0(val(JE:1),3)~'000000')
        SQL.ADD("INSERT INTO "~DBO~".CONTABILIDAD (Jerarquia,Codigo,Nombre,Moneda) VALUES ('"~VAL(JE:2)~"','"~Fstr(val(a:&i),0,0)~"','"~copy(val(b:&i),1,60)~"','"~Copy(Val(c:&I),1,6)~"')")
        SQL.NEW
        SQL.EXEC
    EndIf
