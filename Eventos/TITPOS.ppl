HOJAVISIBLE(SI)
ModoReproceso(SINDIALOGO)
CrearDialogo
  Especie1 :'Especie'     ;2;1;;;;;;;'AA46D'
  Fecha1   :'F.Proceso'   ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha' ;NO;Fecha('08/04/2022')
  Cantidad1:'cant.Pos'    ;;;;;;                 ;                          ;  ;3220000
  String1  : 'Cuenta'     ; ; ;;;;;;;'125018001';;SQLSet("Select Distinct Codigo from "~DBO~".CONTABILIDAD ")
FinDialogo

If Not Ok
   Cancelar
EndIf
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

 
ACT(a:2, 'Movimientos Posicion' )
ACT(a:3, 'Fecha Hasta: '~Dialogo.Fecha1 )
ACT(a:4, 'Especie   : '~Dialogo.Especie1)
ACT(c:4, 'Posicion  : '~Dialogo.Cantidad1)

ACN(ca:1,Dialogo.Cantidad1)

SetFont(a:2, 3)
SetFont(a:3..f:5, 2)
ACT(a:6,'Fecha Pos.')
ACT(b:6, 'Especie')
ACT(c:6, 'Cantidad')
ACT(d:6, 'Cuenta')

SetFilaActual(6)

SQL.ADD(" Select fechamov, especie, sum(cantidad) Cantidad, E.MonedaEmision, E.Tipo TipoEspecie,Tipoposicion Concepto, vehiculo Vehiculo1, Estrategia CuentaCustodia, Book ")
SQL.ADD(" from MOVPOSEJE M, ESPECIES E ")
SQL.ADD(" where E.Codigo=M.Especie")
SQL.ADD(" and Nrsaldo = 121 and Cantidad > 0 and especie='"~Dialogo.Especie1~"' and M.FechaMov  <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" group by FechaMov,especie,MonedaEmision,E.Tipo,TipoPosicion,Vehiculo,Estrategia,BOOK ")
SQL.ADD(" order by fechamov desc ")
watch(SQL.Batch)

ACN(de:1,7)
Recorrer SQL
   ACT(MS:1,fbn('MonedaEmision'))
   ACT(TS:1,fbn('TipoEspecie'))
   ACT(BK:1,fbn('Book'))
   ACT(d:fac,RelacionCuenta('','','','','TIC','','','','TITULO','',val(MS:1),'','','',val(TS:1),'',val(BK:1),#VEHICULO,,,,,,#CTACUSTODIA,#CONCEPTO))

   
   if vacio(val(d:fac)) o Not EqStr(val(d:fac),Dialogo.String1)
      dfa
   else
      if Val(a:fac-1)=FBN['Fechamov']
         dfa 
         ACN(c:fac,val(c:fac)+FBN['Cantidad'])
      else   
         ACD(a:fac,FBN['Fechamov'])
         ACT(b:fac,FBN['Especie'])
         ACN(c:fac,FBN['Cantidad'])
         ACT(e:fac,SQL(" Select RubroContable from CONTABILIDAD CO   where CO.Codigo  = '"~Val(d:fac)~"' "))
      endif
   endif   
   
Proximo
ACN(ha:1,fac)
ACN(d:4,val(de:1))
ACN(e:4,val(ha:1))

Recorrer&i val(de:1),Val(ha:1)
  if Val(c:&i) <= Val(ca:1)
     ACD(aa:&i,Val(a:&i))
     ACT(ab:&i,Val(b:&i))
     ACN(ac:&i,Val(c:&i))
     ACN(ad:&i,Val(d:&i))
     ACT(ae:&i,Val(e:&i))
     ACN(ca:1,Val(ca:1)-Val(c:&i))
  else
     ACD(aa:&i,Val(a:&i))
     ACT(ab:&i,Val(b:&i))
     ACN(ac:&i,Val(ca:1))
     ACN(ad:&i,Val(d:&i))
     ACT(ae:&i,Val(e:&i))
     ACN(ca:1,0)
  endif  
  if Val(ca:1)=0
     break
  endif   
Proximo


ACO(1,8)
ACO(2,15)
ACO(3,15)
