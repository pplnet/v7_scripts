MostrarCuadroDeMensajes
CrearDialogo
 Especie1 : 'Especie'          ;1;1;;;;NoVacio(Dialogo.Especie1) y Not DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una Especie valida'   ;NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
 Fecha1   : 'Record Date'      ;1;2;;;;Dialogo.Fecha1<>0;'Debe ingresar un Record Date valido';NO;FSys
 Fecha2   : 'Fecha Pago'       ;2;2;;;;Dialogo.Fecha2<>0;'Debe ingresar una Fecha valida'     ;NO;FSys
 Mercado1 : 'Mercado'          ;2;1;;;;
 Vehiculo1: 'Vehiculo'         ;3;2;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el vehiculo';NO;VAR('VEHICULODE')
 Operador1: 'Operador'         ;4;2;;NO;;;;;USUARIOACTIVO
 Radio1   : 'Anular|Novedad|Confirmacion|Todos|';3;1;;;;;;;;2
 Radio2   : 'Anula|Saldos|Posiciones|Ambos|';4;1;;NO;NO;;;;;0
FinDialogo

If Not Ok
  Cancelar
Endif

***---Obtengo datos de la especie
SQL.ADD(" Select Nombre, ISIN, LaminaMinima ")
SQL.ADD(" From "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")

Recorrer SQL
  DFA
  ACT(NM:1, fbn('Nombre'))
  ACT(AI:1, fbn('ISIN'))
  ACN(LM:1, IIF(fbn('LaminaMinima')=0,1,fbn('LaminaMinima')))
Proximo

* Preparacion del ListBox ----------------------------------------------------------------- *

* Saldos Libre
ACT(sl:2, VAR('LIBREDISP'))
* Saldos Bloquedos
ACT(sl:3, VAR('BLOQUEOS'))
* Saldos Parking
ACT(sl:4, VAR('SALPARK'))

ACN(z:1,0)
ACN(z:10,0)

SetFilaActual(0)

If Dialogo.Radio2=0 o Dialogo.Radio2=2
   ***--- SALDOS Y MOVPTES
   SQL.ADD(" Select DISTINCT  T.Mercado1, T.Cliente1, T.Especie, T.Especie2, T.NrTrans, T.Cuenta1, ")
   SQL.ADD(" T.Cuenta2, T.Cuenta5, T.Cantidad1, T.Cantidad2, ")
   SQL.ADD(" T.Cantidad3, T.Cambio2, T.Cambio3, T.Cambio4, T.Book1, T.RB1, ")
   SQL.ADD(" T.Cantidad9, T.Cantidad10, T.Cantidad11, T.Cambio5, T.Cliente2, T.Especie1  ")
   SQL.ADD(" From "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD(" Where T.TipoTr2 = 'CANJE' ")
   If Dialogo.Radio2=0 o Dialogo.Radio2=2
      SQL.ADD("  and  T.RB1 > 0 ")
   EndIf
   if Dialogo.Radio1 = 0
      SQL.ADD(" AND T.RB2 = 0 ")
   endif
   if Dialogo.Radio1 = 1
      SQL.ADD(" AND T.RB2 = 1 ")
   endif
   SQL.ADD("  and  T.Especie   = '"~Dialogo.Especie1~"' ")
   SQL.ADD("  and  T.Fecha1    = "~IdxDate2(Dialogo.Fecha1))
   SQL.ADD("  and  T.Fecha2    = "~IdxDate2(Dialogo.Fecha2))
   SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   if NoVacio(Dialogo.Mercado1)
    SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
   endif
   SQL.ADD(" order by Mercado1, Cliente1, NrTrans ")
   
   Recorrer SQL
     if Incluido(fbn('Cambio5'),Val(sl:4))
       DFA
       SCN(z:10, 1)
       ACT(bb:Val(z:10), fbn('Mercado1'))
       ACT(bc:Val(z:10), fbn('Cliente1'))
       ACT(bd:Val(z:10), fbn('Especie1'))
       ACT(be:Val(z:10), fbn('Especie2'))
       ACT(bf:Val(z:10), fbn('NrTrans'))
       ACT(bi:Val(z:10), fbn('Cuenta2'))
       ACT(bj:Val(z:10), fbn('Cuenta5'))
       ACT(bv:Val(z:10), fbn('Mercado1'))

       ACN(bl:Val(z:10), fbn('Cantidad9')) 
       ACN(bm:Val(z:10), fbn('Cantidad10'))
       ACN(bn:Val(z:10), fbn('Cantidad11'))
       ACN(bo:Val(z:10), fbn('Cambio5'))
       ACT(bs:Val(z:10), fbn('Cliente2'))
     else
       SCN(z:1,1)
       ACN(a:fac,1)
       ACT(b:fac,fbn('Mercado1'))
       ACT(c:fac,fbn('Cliente1'))
       ACT(d:fac,fbn('Especie'))
       ACT(e:fac,fbn('Especie2'))
       ACT(f:fac,fbn('NrTrans'))
       ACT(g:fac,fbn('Book1'))
       ACT(h:fac,fbn('Cuenta1'))
       ACT(i:fac,fbn('Cuenta2'))
       ACT(j:fac,fbn('Cuenta5'))
       ACN(n:fac,fbn('Cantidad1'))
       ACN(o:fac,fbn('Cantidad2'))
       ACN(p:fac,fbn('Cantidad3'))
       ACN(q:fac,fbn('Cambio2'))
       ACN(r:fac,fbn('Cambio3'))
       ACN(s:fac,fbn('Cambio4'))
       ACT(u:fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',Val(c:fac)))
     endif
   Proximo
   
   If Val(z:1) = 0
     MessageBox('No se registran Transacciones de Saldos y Movimientos con estas especificaciones.')
   Else
     CrearListBox;'Arial,8,';BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1)~' (ISIN: '~BuscarCampo('ESPECIES','ISIN','Codigo',Dialogo.Especie1)~') Anulacion '~IIF(Dialogo.Radio1=0,' Novedad',' Novedad y Confirmacion')~' - SALDOS y MOVPENDIENTES'
       'Ok?'            ;a:1..a:Val(z:1);SI;;;40;CHECK ;;
       'Mercado'        ;b:1..b:Val(z:1);NO;;;60;STRING;;RGB(220,220,193)
       'Cliente'        ;u:1..u:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
       'Transaccion'    ;f:1..f:Val(z:1);NO;;;70;STRING;;RGB(220,220,193)
       'Cant.Org.'      ;n:1..n:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
       'Rel.Org.'       ;q:1..q:Val(z:1);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
       'Especie'        ;d:1..d:Val(z:1);NO;;;65;STRING;               ;RGB(220,220,193)
       'Rel.Dst.'       ;r:1..r:Val(z:1);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
* FJL 06/05/22 - Se saca porque en o: esta Cantidad2 y es el NrSaldo, no una cantidad
*       'Cant.Dst.'      ;o:1..o:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
       'Fraccion'       ;e:1..e:Val(z:1);NO;;;65;STRING;               ;RGB(220,220,193)
       'Valor'          ;s:1..s:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
       'Importe'        ;p:1..p:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
       'Cuenta Origen'  ;h:1..h:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
       'Cuenta Destino' ;i:1..i:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
       'Cta.Fraccion'   ;j:1..j:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
     FinListBox
     If Not Ok
       Cancelar
     EndIf
      
      * Anulo las Transacciones marcadas -------------------------------------------------------- *
      
      Recorrer&i 1,fac
        If Val(a:&i) = 1
           * ANULO CONFIRMACION
           If Dialogo.Radio1 = 1
              ***---Anulo la Confirmacion
              SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
              SQL.ADD("   Set Fecha3  = Null, ")
              SQL.ADD("       RB2     = '0' ")
              SQL.ADD(" Where NrTrans = '"~Val(f:&i)~"'")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVPOSPEN ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVPOSEJE ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.EXEC
              SQL.ActualizarMovimientosT2(Val(f:&i),SI,NO,NO,SI)
              SQL.EXEC
           Else
              ***---Anulo TODO
              SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
** FJL 19/05/21
*              SQL.ADD(" delete from "~DBO~".MOVPOSPENACCION ")
*              SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
*              SQL.NEW
*              SQL.ADD(" delete from "~DBO~".MOVPOSEJEACCION ")
*              SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
*              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVPOSPEN ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".MOVPOSEJE ")
              SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".OPERACIONESBITS ")
              SQL.ADD(" where NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".CUOTAS ")
              SQL.ADD(" where NrOperacion = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.ADD("Delete from "~DBO~".TRANSACCIONES2 ")
              SQL.ADD(" where NrTrans = '"~Val(f:&i)~"' ")
              SQL.NEW
              SQL.EXEC
           EndIf
        EndIf
      Proximo
      
      if Val(z:10)>0
        recorrer&i 1,Val(z:10)
          if Dialogo.Radio1 = 1
            ***---Anulo la Confirmacion
            SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
            SQL.ADD("   Set Fecha3  = Null, ")
            SQL.ADD("       RB2     = '0' ")
            SQL.ADD(" Where NrTrans = '"~Val(bf:&i)~"'")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVPOSPEN ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.EXEC
            SQL.ActualizarMovimientosT2(Val(bf:&i),SI,NO,NO,SI)
            SQL.EXEC
          else
            ***---Anulo TODO
            SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVPOSPEN ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".MOVPOSEJE ")
            SQL.ADD(" WHERE NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".CUOTAS ")
            SQL.ADD(" where NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".OPERACIONESBITS ")
            SQL.ADD(" where NrOperacion = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.ADD("Delete from "~DBO~".TRANSACCIONES2 ")
            SQL.ADD(" where NrTrans = '"~Val(bf:&i)~"' ")
            SQL.NEW
            SQL.EXEC
          endif
        Proximo
      EndIf

   EndIf
EndIf

ACN(FI:1,fac+1)

If Dialogo.Radio2=1 o Dialogo.Radio2=2
   ***--- POSICIONES
   SQL.ADD(" Select DISTINCT  T.Mercado1, T.Cliente1, T.Especie1, T.Especie2, T.NrTrans, T.Cuenta1, ")
   SQL.ADD(" T.Cuenta2, T.Cuenta5, T.Cantidad1, T.Cantidad2, ")
   SQL.ADD(" T.Cantidad3, T.Cambio2, T.Cambio3, T.Cambio4, T.Book1 ")
   SQL.ADD(" From "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD(" Where T.TipoTr2 = 'CANJE' ")
   SQL.ADD("  and  T.RB1 = 0 ")
   if Dialogo.Radio1 = 0
      SQL.ADD(" AND T.RB2 = 0 ")
   endif
   if Dialogo.Radio1 = 1
      SQL.ADD(" AND T.RB2 = 1 ")
   endif
   SQL.ADD("  and  T.Especie   = '"~Dialogo.Especie1~"' ")
   SQL.ADD("  and  T.Fecha1    = "~IdxDate2(Dialogo.Fecha1))
   SQL.ADD("  and  T.Fecha2    = "~IdxDate2(Dialogo.Fecha2))
   SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   if NoVacio(Dialogo.Mercado1)
    SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
   endif
   SQL.ADD(" order by Mercado1, Cliente1, NrTrans ")
   
   ACN(z:1,fac)
   
   Recorrer SQL
     SCN(z:1,1)
     ACN(z:2,1)
     ACN(a:fac,0)
     ACT(b:fac,fbn('Mercado1'))
     ACT(c:fac,fbn('Cliente1'))
     ACT(d:fac,fbn('Especie1'))
     ACT(e:fac,fbn('Especie2'))
     ACT(f:fac,fbn('NrTrans'))
     ACT(g:fac,fbn('Book1'))
     ACT(h:fac,fbn('Cuenta1'))
     ACT(i:fac,fbn('Cuenta2'))
     ACT(j:fac,fbn('Cuenta5'))
     ACN(n:fac,fbn('Cantidad1'))
     ACN(o:fac,fbn('Cantidad2'))
     ACN(p:fac,fbn('Cantidad3'))
     ACN(q:fac,fbn('Cambio2'))
     ACN(r:fac,fbn('Cambio3'))
     ACN(s:fac,fbn('Cambio4'))
     ACT(u:fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',Val(c:fac)))
   Proximo
   
   If Val(z:2) = 0
      Cancelar('No se registran Transacciones de Posiciones con estas especificaciones.')
   EndIf
   
   CrearListBox ; 'Arial,8,';BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1)~' (ISIN: '~BuscarCampo('ESPECIES','ISIN','Codigo',Dialogo.Especie1)~') Anulacion '~IIF(Dialogo.Radio1=0,' Novedad',' Novedad y Confirmacion')~' - POSICIONES'
    'Ok?'            ;a:Val(FI:1)..a:Val(z:1);SI;;;40;CHECK ;;
    'Mercado'        ;b:Val(FI:1)..b:Val(z:1);NO;;;60;STRING;;RGB(220,220,193)
    'Cliente'        ;u:Val(FI:1)..u:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
    'Book'           ;g:Val(FI:1)..g:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
    'Transaccion'    ;f:Val(FI:1)..f:Val(z:1);NO;;;70;STRING;;RGB(220,220,193)
    'Cant.Org.'      ;n:Val(FI:1)..n:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Rel.Org.'       ;q:Val(FI:1)..q:Val(z:1);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
    'Especie'        ;d:Val(FI:1)..d:Val(z:1);NO;;;65;STRING;               ;RGB(220,220,193)
    'Rel.Dst.'       ;r:Val(FI:1)..r:Val(z:1);NO;;;60;NUMERO;'###,###'      ;RGB(220,220,193)
    'Cant.Dst.'      ;o:Val(FI:1)..o:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Fraccion'       ;e:Val(FI:1)..e:Val(z:1);NO;;;65;STRING;               ;RGB(220,220,193)
    'Valor'          ;s:Val(FI:1)..s:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Importe'        ;p:Val(FI:1)..p:Val(z:1);NO;;;70;NUMERO;'##,###,###.##';RGB(220,220,193)
    'Cuenta Origen'  ;h:Val(FI:1)..h:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
    'Cuenta Destino' ;i:Val(FI:1)..i:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
    'Cta.Fraccion'   ;j:Val(FI:1)..j:Val(z:1);NO;;;80;STRING;;RGB(220,220,193)
   FinListBox

   If Not Ok
      Cancelar
   EndIf
   
   * Anulo las Transacciones marcadas -------------------------------------------------------- *
   
   Recorrer&i Val(FI:1),Val(z:1)
     If Val(a:&i) = 1
        * ANULO CONFIRMACION - Vuelvo las Transacciones de Ejecutadas a Pendientes -------------- *
        If Dialogo.Radio1 = 1
           ***---Anulo la Confirmacion
           SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 ")
           SQL.ADD(" Set RB2 = '0' ")
           SQL.ADD(" Where NrTrans = '"~Val(f:&i)~"'")
           SQL.NEW
           SQL.EXEC
           SQL.ActualizarMovimientosT2(Val(f:&i),NO,NO,NO,SI)
           SQL.EXEC
        Else
           ***---Anulo TODO
           SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
           SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
           SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".MOVPOSPEN ")
           SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".MOVPOSEJE ")
           SQL.ADD(" WHERE NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
** FJL 19/05/21
*           SQL.ADD(" delete from "~DBO~".MOVPOSPENACCION ")
*           SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
*           SQL.NEW
*           SQL.ADD(" delete from "~DBO~".MOVPOSEJEACCION ")
*           SQL.ADD(" WHERE  NrOperacion = '"~Val(f:&i)~"' ")
*           SQL.NEW
           SQL.ADD("Delete from "~DBO~".OPERACIONESBITS ")
           SQL.ADD(" where  NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".CUOTAS ")
           SQL.ADD(" where  NrOperacion = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.ADD("Delete from "~DBO~".TRANSACCIONES2 ")
           SQL.ADD(" where  NrTrans = '"~Val(f:&i)~"' ")
           SQL.NEW
           SQL.EXEC
        EndIf
     EndIf
   Proximo
EndIf

