MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'Fecha'               ;1;;;;;Dialogo.Fecha1<=FSys;'Fecha inválida';NO;Fsys
  Vehiculo1: 'Vehiculo'           ;3;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE')
FinDialogo

If Not Ok
   Cancelar
Endif

SQL.ADD(" Select O.NrOperacion, M.Monto, O.Vehiculo1, O.Cliente1 ClienteOp, M.Cliente ClienteDev, M.Especie Moneda ")
SQL.ADD("  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".MOVDEVENGADOS M ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND TipoOp = 'MMST' ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
***---Tiene MTM
SQL.ADD(" AND O.MB1 > 0 ")
SQL.ADD(" Order By O.NrOperacion ")
Watch(sql.batch)
Recorrer SQL
    IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
        IF Not CeldaVacia(NR:1)
            ***---Borro el MTM para que no moleste en le demo, falta hacer evento de anulacion
            SQL.ADD(" Delete "~DBO~".MTMDIARIO ")
            SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
            SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.NEW
            SQL.EXEC
            ACN(AC:1, 0)
            SQL.ADD(" Select MTMAcuMensual From "~DBO~".MTMDIARIO ")
            SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
            SQL.ADD(" AND Month(Fecha) = "~Fstr(Mes(Dialogo.Fecha1), 0, 0)~" ")
            SQL.ADD(" AND Year(Fecha) = "~Fstr(Anio(Dialogo.Fecha1), 0, 0)~" ")
            SQL.ADD(" AND Fecha = (Select Max(Fecha) ")
            SQL.ADD("               From "~DBO~".MTMDIARIO ")
            SQL.ADD("               Where NrOperacion = '"~Val(NR:1)~"' ")
            SQL.ADD("               AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
            Recorrer SQL
                ACN(AC:1, fbn('MTMAcuMensual'))
            Proximo
            IF Val(AC:1) <> 0
                ***---Habia Acumulado Anterior
                SQL.ADD(" Update "~DBO~".MTMDIARIO ")
                SQL.ADD(" Set Ultimo = 'NO' ")
                SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
                SQL.ADD(" AND Month(Fecha) = "~Fstr(Mes(Dialogo.Fecha1), 0, 0)~" ")
                SQL.ADD(" AND Year(Fecha) = "~Fstr(Anio(Dialogo.Fecha1), 0, 0)~" ")
                SQL.NEW
                SQL.EXEC
            ENDIF
            SQL.ADD(" Insert Into "~DBO~".MTMDIARIO ")
            SQL.ADD(" (NrOperacion, Fecha, PrecioHoy, PrecioAyer, ")
            SQL.ADD(" MTM, TipoMTM, Especie1, FechaCargaSys, ")
            SQL.ADD(" MTMAcuMensual, Ultimo) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~Val(NR:1)~"', '"~IdxDate(Dialogo.Fecha1)~"', "~Fstr(Val(IT:1), 0, 2)~", "~Fstr(Val(IT:2), 0, 2)~", ")
            SQL.ADD(" "~Fstr(Val(MT:1), 0, 2)~", 'MTM', '"~Val(MN:1)~"', '"~IdxDate(Fsys)~"',")
            SQL.ADD(" "~Fstr(Val(AC:1) + Val(MT:1), 0, 2)~", 'SI') ")
            SQL.NEW
            SQL.EXEC
            
            SQL.ActualizarMovimientos3(Val(NR:1),SI,NO,NO,NO,NO)
            SQL.EXEC
        ENDIF
        ACN(MT:1, 0)
        ACN(IT:1, 0)
        ACN(IT:2, 0)
    ENDIF
    IF Eqstr(fbn('ClienteOp'), fbn('ClienteDev'))
        ***---Devengado del Cliente
        ACN(IT:1, fbn('Monto'))
    ELSE
        ***---Devengado del Vehiculo
        ACN(IT:2, fbn('Monto'))
    ENDIF
    SCN(MT:1, fbn('Monto'))
    ACT(NR:1, fbn('NrOperacion'))
    ACT(MN:1, fbn('Moneda'))
Proximo
IF Not CeldaVacia(NR:1)
    ***---Borro el MTM para que no moleste en le demo, falta hacer evento de anulacion
    SQL.ADD(" Delete "~DBO~".MTMDIARIO ")
    SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.NEW
    SQL.EXEC
    ACN(AC:1, 0)
    SQL.ADD(" Select MTMAcuMensual From "~DBO~".MTMDIARIO ")
    SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD(" AND Month(Fecha) = "~Fstr(Mes(Dialogo.Fecha1), 0, 0)~" ")
    SQL.ADD(" AND Year(Fecha) = "~Fstr(Anio(Dialogo.Fecha1), 0, 0)~" ")
    SQL.ADD(" AND Fecha = (Select Max(Fecha) ")
    SQL.ADD("               From "~DBO~".MTMDIARIO ")
    SQL.ADD("               Where NrOperacion = '"~Val(NR:1)~"' ")
    SQL.ADD("               AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
    Recorrer SQL
        ACN(AC:1, fbn('MTMAcuMensual'))
    Proximo
    IF Val(AC:1) <> 0
        ***---Habia Acumulado Anterior
        SQL.ADD(" Update "~DBO~".MTMDIARIO ")
        SQL.ADD(" Set Ultimo = 'NO' ")
        SQL.ADD(" Where NrOperacion = '"~Val(NR:1)~"' ")
        SQL.ADD(" AND Month(Fecha) = "~Fstr(Mes(Dialogo.Fecha1), 0, 0)~" ")
        SQL.ADD(" AND Year(Fecha) = "~Fstr(Anio(Dialogo.Fecha1), 0, 0)~" ")
        SQL.NEW
        SQL.EXEC
    ENDIF
    SQL.ADD(" Insert Into "~DBO~".MTMDIARIO ")
    SQL.ADD(" (NrOperacion, Fecha, PrecioHoy, PrecioAyer, ")
    SQL.ADD(" MTM, TipoMTM, Especie1, FechaCargaSys, ")
    SQL.ADD(" MTMAcuMensual, Ultimo) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(NR:1)~"', '"~IdxDate(Dialogo.Fecha1)~"', "~Fstr(Val(IT:1), 0, 2)~", "~Fstr(Val(IT:2), 0, 2)~", ")
    SQL.ADD(" "~Fstr(Val(MT:1), 0, 2)~", 'MTM', '"~Val(MN:1)~"', '"~IdxDate(Fsys)~"', ")
    SQL.ADD(" "~Fstr(Val(AC:1) + Val(MT:1), 0, 2)~", 'SI') ")
    SQL.NEW
    SQL.EXEC
    
    SQL.ActualizarMovimientos3(Val(NR:1),SI,NO,NO,NO,NO)
    SQL.EXEC    
ENDIF