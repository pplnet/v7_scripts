MostrarCuadroDeMensajes
CrearDialogo

  Especie1   :'Especie Origen' ;;;;;;NoVacio(Dialogo.Especie1) y     EqStr(Dialogo.Especie1, BuscarCampo('AGENDACUPONES','Especie','Especie',Dialogo.Especie1) );'Especie Origen Invalida';NO;;;;;; 
  Especie2   :'Especie Destino';;;;;;NoVacio(Dialogo.Especie2) y NOT EqStr(Dialogo.Especie2, BuscarCampo('AGENDACUPONES','Especie','Especie',Dialogo.Especie2) );'Especie Destino Invalida';NO;;;;;; 

FinDialogo

If Not Ok
   Cancelar
endif

*
* El evento levanta todos los registros de AGENDACUPONES de la especie origen, y los inserta en AGENDACUPONES para la especie destino.
* O sea construye dos agendas idénticas, con especies distintas. La especie origen debe existir en AGENDACUPONES, la de destino no.
*


SQL.ADD(" Select TipoCupon,FechaCorte,FechaPago,PorRenta,PorAmCapital,NrCupon,PorAmIntCap,Estado,TasaCapInt,PorRentaAnterior,FechaCambioTasa,  ")
SQL.ADD("        Especie,IntsCapitalizados,VTeoricoAnt,FechaProceso,PrecioCupon,Esquema,PorPIK,PIKsAcumulados,PorPenalty,Pickeado ")
SQL.ADD("   from "~DBO~".AGENDACUPONES  ")
SQL.ADD("   where Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Order by NrCupon ")

recorrer SQL
   SCN(x:1, 1)   
   ACT(b:FAC, fbn('NrCupon'))  
   SQL.ADD(" INSERT INTO AGENDACUPONES    ")  
   SQL.ADD(" SELECT '"~Dialogo.Especie2~"' As Especie,   ")

   SQL.ADD(" TipoCupon,FechaCorte,FechaPago,PorRenta,PorAmCapital,NrCupon,PorAmIntCap,Estado,TasaCapInt,PorRentaAnterior,FechaCambioTasa,  ")
   SQL.ADD(" IntsCapitalizados,VTeoricoAnt,FechaProceso,PrecioCupon,Esquema,PorPIK,PIKsAcumulados,PorPenalty,Pickeado ")

   SQL.ADD("  FROM AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND  NrCupon = '"~Val(b:FAC)~"'  ")

   SCN(x:2, 1)   
   SQL.NEW
proximo
SQL.EXEC


