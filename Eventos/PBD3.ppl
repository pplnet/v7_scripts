MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'Fecha'     ;;;;;;;;;fsys
  Especie1:  'Moneda'    ;;;;;;Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo',Dialogo.Especie1),'MON');'Moneda Invalida.';NO;'ARP';;;;;" Tipo = 'MON' "
  Vehiculo1: 'Vehiculo'  ;;;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido.';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Cliente1:  'Banco'     ;;;;;;Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN');'Banco Invalido.';NO;;;;;;" Sector = 'BAN' "
  Cuenta1:   'Cuenta'	 ;;;;;;Eqstr(BuscarCampo('CUENTAS','Comitente','Codigo',Dialogo.Cuenta1),Dialogo.Cliente1);'La cuenta no corresponde al banco seleccionado.';NO;;;;;;" Comitente = '"~Dialogo.Cliente1~"' AND Cliente = '"~Dialogo.Vehiculo1~"' AND (Especies LIKE '%"~Dialogo.Especie1~"%'  OR Especies LIKE '%MONEDA%' ) "
  Check1: 'CONFIRMA';;;;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar 
Endif

 SQL.ADD(" Select M.*, C.Comitente Banco FROM "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C ")
 SQL.ADD(" WHERE  M.Cuenta = C.Codigo (+)")
 SQL.ADD(" AND    M.FechaMov = "~IdxDate2(Dialogo.Fecha1)~" ")
 SQL.ADD(" AND    M.Cantidad >0  ")
 SQL.ADD(" AND    M.NrSaldo = 1 ")
 SQL.ADD(" AND    (M.Status IS NULL OR M.Status<>'FC' )")

 If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND M.Especie = '"~Dialogo. Especie1~"' ")
 Endif
 If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND M.Cliente = '"~Dialogo.Vehiculo1~"' ")
 Endif
 If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND C.Comitente = '"~Dialogo.Cliente1~"' ")
 Endif
 If NoVacio(Dialogo.Cuenta1)
   SQL.ADD(" AND M.Cuenta = '"~Dialogo.Cuenta1~"' ")
 Endif
 SQL.ADD(" ORDER BY M.Cliente, M.Especie, C.Comitente, M.Cuenta ")

 ACN(z:1,0)
 Recorrer SQL
   ACN(a:fac, 0)
   ACD(b:fac, fbn('FechaMov'))
   ACT(c:fac, fbn('Cliente'))
   ACT(d:fac, fbn('NrOperacion'))
   ACT(e:fac, fbn('Especie'))
   ACN(f:fac, fbn('Cantidad'))
   ACT(g:fac, fbn('Cuenta'))
   ACT(h:fac, fbn('Banco'))
   ACN(p:fac, fbn('NrMov'))
   ACT(op:1, fbn('NrOperacion'))
   ACN(kk:1,0)

   SQL.ADD(" Select M1.* FROM "~DBO~".MOVPENDIENTES M1 ") 
   SQL.ADD(" WHERE  M1.FechaMov = "~IdxDate2(fbn('FechaMov'))~" ")
   SQL.ADD(" AND    M1.Cliente  = '"~fbn('Cliente')~"' ")
   SQL.ADD(" AND    M1.Cuenta   = '"~fbn('Cuenta')~"' ")
   SQL.ADD(" AND    M1.Especie  = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND    M1.Cantidad <0 ")
   SQL.ADD(" AND    ABS(M1.Cantidad) = "~fstr(fbn('Cantidad'),0,4)~" ")
   Recorrer SQL
     ACN(z:1,1)
     If Val(kk:1)=0
       dfa
       ACN(a:fac, 1)
       ACN(i:fac, 1)
     Else
       ACN(i:fac, 0)
     Endif
     ACN(kk:1,1)
     ACD(j:fac, fbn('FechaMov'))
     ACT(k:fac, fbn('Cliente'))
     ACT(l:fac, fbn('NrOperacion'))
     ACT(m:fac, fbn('Especie'))
     ACN(n:fac, fbn('Cantidad'))
     ACT(o:fac, fbn('Cuenta'))
     ACN(q:fac, fbn('NrMov'))
     ACT(r:fac, Val(op:1))
   Proximo

   If Val(kk:1)=0
     dfa
   Endif
 Proximo

 If Val(z:1)=0
   Cancelar('No se encontraron movimientos para depurar.')
 Endif
 If Dialogo.Check1=1
  CrearListBox; 'Arial,8,'
    'OK'            ;a:1..a:FAC;SI;;;30;CHECK;RGB(232,255,215);
    'FechaMov'      ;b:1..b:FAC;NO;;;80;FECHA;RGB(232,232,232);
    'Vehiculo'      ;c:1..c:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Operacion'     ;d:1..d:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Moneda'        ;e:1..e:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Cantidad'      ;f:1..f:FAC;NO;;;80;NUMERO;'###,###,###,###.##';RGB(232,232,232);
    'Banco'         ;h:1..h:FAC;NO;;;70;STRING;;RGB(232,232,232);
    'Cuenta'        ;g:1..g:FAC;NO;;;80;STRING;;RGB(232,232,232);
 
    'OK'            ;i:1..i:FAC;SI;;;30;CHECK;RGB(232,255,215);
    'FechaMov'      ;j:1..j:FAC;NO;;;80;FECHA;RGB(221,242,255);
    'Vehiculo'      ;k:1..k:FAC;NO;;;70;STRING;;RGB(221,242,255);
    'Operacion'     ;l:1..l:FAC;NO;;;70;STRING;;RGB(221,242,255);
    'Moneda'        ;m:1..m:FAC;NO;;;70;STRING;;RGB(221,242,255);
    'Cantidad'      ;n:1..n:FAC;NO;;;80;NUMERO;'###,###,###,###.##';RGB(221,242,255);
    'Cuenta'        ;o:1..o:FAC;NO;;;80;STRING;;RGB(221,242,255);
  FinListBox
 Endif
 If Not Ok
   Cancelar
 Endif

 ACN(fi:2,1)

 Recorrer&i 1,fac
   If Val(a:&i)=1
     * Busco los movimientos amarillos chequeados
     ACN(fi:1,0)
     ACN(kk:2,0)

**     Recorrer&j Val(fi:2),fac
     Recorrer&j &i,fac
     * Busco los movimientos violetas chequeados para el mov anterior
 
       If Not eqstr(Val(r:&j),Val(d:&i))
         ACN(fi:2,fac)
         * Guardo la fila a partir de la cual voy a seguir
         * Cuando cambio de mov me voy
         Break
       Endif

       If Val(i:&j)=1 
         * Si el violeta esta chequeado guardo la fila en fi:1, en kk:2 la cant de violetas para cada amarillo (solo puede haber uno)
         ACN(fi:1,&j)
         SCN(kk:2,1)
       Endif
     Proximo

     If Val(kk:2)=1
       message('Actualizando Operacion '~Val(d:&i))
       * Actualizo los amarillos
       SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET Status = 'FC' ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(d:&i)~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(p:&i),0,0)~" ")
       SQL.NEW
       SQL.EXEC
   
       SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
       SQL.ADD(" SELECT * FROM "~DBO~".MOVPENDIENTES ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(d:&i)~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(p:&i),0,0)~" ")
       SQL.NEW

       SQL.ADD(" DELETE "~DBO~".MOVPENDIENTES ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(d:&i)~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(p:&i),0,0)~" ")
       SQL.NEW
       SQL.EXEC 

       * ----------------------- * -------------------------- *
       * Actualizo los violetas
       message('Actualizando Operacion '~Val(l:Val(fi:1)))
       SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET Status = 'FC' ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(l:Val(fi:1))~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(q:Val(fi:1)),0,0)~" ")
       SQL.NEW
       SQL.EXEC
   
       SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS ")
       SQL.ADD(" SELECT * FROM "~DBO~".MOVPENDIENTES ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(l:Val(fi:1))~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(q:Val(fi:1)),0,0)~" ")
       SQL.NEW

       SQL.ADD(" DELETE "~DBO~".MOVPENDIENTES ")
       SQL.ADD(" WHERE NrOperacion = '"~Val(l:Val(fi:1))~"' ")
       SQL.ADD(" AND   NrMov       = "~fstr(Val(q:Val(fi:1)),0,0)~" ")
       SQL.NEW
       SQL.EXEC 
     Endif
     If Val(kk:2)>1
       Messagebox('Solo puede seleccionar uno para matchear.')
     Endif
   Endif
 Proximo
