ACT(nt:2,SQLSet("Select Codigo FROM "~DBO~".MERCADOS WHERE Netea='SI'"))
CrearDialogo
   **Especie1 :    'Especie'         ;;1;;;;;;;;;;;;"Jerarquia like '"~VAR('JERMONEDA')~"%'"
   **Cliente1 :    'Cliente'         ;;1;;;;;;
   **Especie2 :    'CEspecie'        ;;1;;;;;;
   Vehiculo1:    'Vehiculo'        ;;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE')
   NrOperacion1: 'Nr.Operacion'    ;;1;;;;NoVacio(NrOperacion1);'Debe ingresar una operacion';NO;;;;;;
   Mercado1 :    'Mer.Esp. Actual' ;;1;;Vacio(Dialogo.NrOperacion1)  ;;(NoVacio(Dialogo.Mercado1) y Incluido('M',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado1)) o NoVacio(Dialogo.NrOperacion1));'Debe ingresar Mercado Actual habilitado para Monedas';NO;;IIF(NoVacio(Dialogo.NrOperacion1),BuscarCampo('OPERACIONES','Mercado','NrOperacion',Dialogo.NrOperacion1),Dialogo.Mercado1);;;;" Observaciones like  '%M%' "
   Mercado2 :    'Mer.Esp. Nuevo'  ;;1;;;;NoVacio(Dialogo.Mercado2) y (Incluido('M',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado2)) o Incluido('FM',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado2)));'Debe ingresar Mercado Nuevo habilitado para Especie' ;NO;;;;;;" Observaciones like '%M%' "
   Mercado3 :    'Mer.Esp. Pago'   ;;1;;  ;;Vacio(Dialogo.Mercado3) o (Incluido('M',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado3)) o Incluido('FM',BuscarCampo('MERCADOS','Observaciones','Codigo',Dialogo.Mercado2)));'Debe ingresar Mercado de moneda habilitado'          ;NO;;;;;;" Observaciones like  '%M%' "
FinDialogo 

If Not Ok
   Cancelar
Endif

ACN(a:0,0)

If SQL("SELECT IsNull(Netea,'NO') FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado2~"' ")='SI'
  ACT(nt:1,'SI')
else
  ACT(nt:1,'NO')
endif
 
** Operaciones de CV con Movimientos pendientes **
MostrarCuadroDeMensajes

SQL.ADD("Select DISTINCT O.TipoOp, O.NrOperacion, O.Mercado2, O.Mercado, O.FormaLiquidacion2, O.FormaLiquidacion1, O.FechaOp, O.FechaVto,    ")
SQL.ADD("       O.Cliente1, O.Especie, O.ContraEspecie, O.Cantidad, O.TotalNetoCli1, C.RazonSocial, O.CB7, O.NrBoleto, O.Cuenta1, O.Cuenta4, ")
SQL.ADD("       O.Cuenta2, O.Cuenta3, O.Vehiculo1, O.Plaza1, O.Cuenta5, O.Cuenta6 , O.CB4  , ConceptoBCRA, MB1, O.Cliente4                   ")
SQL.ADD(" from   "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E           ")
SQL.ADD("where  O.Cliente1 = C.Codigo                                                            ")
SQL.ADD("      and  E.Jerarquia like '"~VAR('JERMONEDA')~"%'                                     ")
SQL.ADD("      and  E.Codigo = O.Especie                                                         ")
SQL.ADD("      and  M.NrOperacion = O.NrOperacion                                                ")
SQL.ADD("      and  M.NrOperacion = B.NrOperacion                                                ")
**SQL.ADD("      and  O.TipoOp  In ('FXC','FXV','FXJ')                                             ")
SQL.ADD("      and  B.Valor  = '1'                                                               ")
SQL.ADD("      and  B.NrBit  in (10,7)                                                           ")
SQL.ADD("      and O.NrOperacion not in (select NrOperacion from "~DBO~".MOVEJECUTADOS ME        ")
SQL.ADD("                    where ME.NrOperacion = O.NrOperacion AND ME.NrSaldo IN (1,31) )     ")
**SQL.ADD("      and Exists (select 1 FROM "~DBO~".MOVPENDIENTES MP2                               ")
**SQL.ADD("                   where MP2.NrOperacion=M.NrOperacion                                  ")
**SQL.ADD("                    and MP2.Especie=M.Especie                                           ")
**SQL.ADD("                    group by MP2.NrOperacion, MP2.Especie                               ")
**SQL.ADD("                    having count(1)=cASE When TipoOp in ('DDC','DDV') Then 2 else 1 end)                                                 ") 
If NoVacio(Dialogo.NrOperacion1)   
   SQL.ADD("   and  O.NrOperacion = '"~Dialogo.NrOperacion1~"'                                   ")
Else
   SQL.ADD("      and  O.Mercado = '"~Dialogo.Mercado1~"'   ") 
   
   **If NoVacio(Dialogo.Cliente1)   
   **   SQL.ADD("   and  O.Cliente1 = '"~Dialogo.Cliente1~"'                                          ")
   **Endif
   **If NoVacio(Dialogo.Especie1)
   **   SQL.ADD("   and  O.Especie  = '"~Dialogo.Especie1~"'                                          ")
   **Endif
   **If NoVacio(Dialogo.Especie2)
   **   SQL.ADD("   and  O.ContraEspecie  = '"~Dialogo.Especie2~"'                                    ")
   **Endif
Endif

SQL.ADD("order by O.Cliente1, O.TipoOp, O.NrOperacion                                            ")
watch(SQL.BATCH())

Recorrer SQL
   SCN(a:0,1)
   Message('Operacion '~fbn('NrOperacion'))
   
   ACT(a:fac, fbn('Cliente1'))
   ACT(b:fac, fbn('RazonSocial'))
   ACT(c:fac, fbn('TipoOp'))
   ACT(d:fac, fbn('NrOperacion'))
   If Eqstr(val(nt:1),'SI')
   ** Netea DVP
     ACN(e:fac,1)
   else
       IF Eqstr(Dialogo.Mercado2,'EU')
          ** DVP
          ACN(e:fac, 1)
       else
          ACN(e:fac, fbn('FormaLiquidacion1'))
       endif   
   Endif
   ** AA 11-02-2022 Mercado Especie
   ACT(f:fac, Dialogo.Mercado2)
   ** AA 11-02-2022 Mercado Moneda
   if Vacio(Dialogo.Mercado3)
      If Eqstr(val(nt:1),'SI')
          ACT(g:fac, Dialogo.Mercado2)
       else
         IF Not Incluido(Dialogo.Mercado2,VAR('MERCADOCV')) Y fbn('FormaLiquidacion2')<2
            ACT(g:fac, Dialogo.Mercado2)
         else
            ACT(g:fac, MercadoDef(fbn('ContraEspecie')) )
         endif
       endif
   else
       ACT(g:fac, Dialogo.Mercado3)
   endif   
   
   ** AA 21-07-2023 Mercado Vehiculo BCRA-VISTA
   if Eqstr(Val(g:fac),'VISTA')
      ACT(xy:fac,IIF(Incluido(Val(g:fac),VAR('MERNOVEHI')),Var('MERCBCRA'),'VISTA'))
   Else
      ACT(xy:fac,Var('MERCBCRA'))  
   endif
   
   ACD(h:fac, fbn('FechaOp'))
   ACD(i:fac, fbn('FechaVto'))
   ACT(j:fac, fbn('Especie'))
   ACT(k:fac, fbn('ContraEspecie'))
   ACN(l:fac, fbn('Cantidad'))
   ACN(m:fac, fbn('TotalNetoCli1'))
   ACT(o:fac, fbn('Mercado2'))
   ACT(p:fac, fbn('Mercado'))
   ACN(q:fac, 0)
   ACT(v:fac, fbn('Plaza1'))
   ACT(w:fac, fbn('Vehiculo1'))
   ACT(x:fac, fbn('ConceptoBCRA'))
   ACN(y:fac, fbn('MB1'))
   ACT(z:fac, fbn('Cliente4'))
   
   IF Not Incluido(fbn('TipoOp'),'DDC|DDV')
   
   If EqStr(Dialogo.Mercado2,fbn('Mercado'))
      ACT(r:fac, fbn('Cuenta3'))
      ACT(t:fac, fbn('Cuenta1'))
   Else
      ACT(r:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~IIF(EqStr(Val(nt:1),'SI'),Val(w:fac),Val(a:fac))~"'  and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      ACT(t:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
   Endif

   **AA 11-02-2022 Mercado Moneda
   If EqStr(Dialogo.Mercado3,fbn('Mercado2'))
      ACT(s:fac,  fbn('Cuenta4'))
      ACT(u:fac,  fbn('Cuenta2'))
   Else
     if Eqstr(val(nt:1),'SI')
         ACT(s:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Var('MERCBCRA')~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
         ACT(u:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Val(xy:fac)~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      else
         ACT(s:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~Val(a:fac)~"' and Mercado='"~Val(g:fac)~"' and MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
         ACT(u:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(g:fac)~"' and MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      endif
   Endif  
  ELSE
  **MAV
     If EqStr(Dialogo.Mercado2,fbn('Mercado'))
      ACT(r:fac, fbn('Cuenta3'))
      ACT(t:fac, fbn('Cuenta1'))
   Else
      ACT(r:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~IIF(EqStr(Val(nt:1),'SI'),Val(w:fac),Val(a:fac))~"'  and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      ACT(t:fac, SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(f:fac)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
   Endif

   **AA 11-02-2022 Mercado Moneda
   If EqStr(Dialogo.Mercado3,fbn('Mercado2'))
      ACT(s:fac,  fbn('Cuenta4'))
      ACT(u:fac,  fbn('Cuenta5'))
   Else
     if Eqstr(val(nt:1),'SI')
         ACT(s:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Var('MERCBCRA')~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
         ACT(u:fac,  SQL("select Codigo from "~DBO~".CUENTAS where  Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(f:fac)~"' ")~"' and (Mercado='"~Val(xy:fac)~"' or Mercado='"~Var('MERSWIFT')~"') and MercadoLiq='"~val(g:fac)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      else
         ACT(s:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~Val(a:fac)~"' and Mercado='"~Val(g:fac)~"' and MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
         ACT(u:fac, SQL("Select Codigo from "~DBO~".CUENTAS where (Estado='HAB' and TipoCuenta IN ('CC','CA','VIS','OTR') and Cliente='"~Val(w:fac)~"' and Mercado='"~Val(g:fac)~"' and MercadoLiq='"~Val(g:fac)~"' or IsNull(MercadoLiq,'')='') and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:fac)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))
      endif
   Endif
  ENDIF 

   
Proximo

OcultarCuadroDeMensajes

If Val(a:0) > 0
 IF Incluido(Val(c:fac),'DDC|DDV')
              CrearListBox;'Arial,8,';'Cambio Mercado y Forma Liquidacion MAV'
                'Mod.'           ;q:1..q:Val(a:0);SI;;; 50;CHECK ;RGB(160,160,193)
                'Cliente'        ;a:1..a:Val(a:0);NO;;; 50;STRING;;RGB(250,250,193)
                'Nombre'         ;b:1..b:Val(a:0);NO;;;140;STRING;;RGB(250,250,193)
                'TipoOp'         ;c:1..c:Val(a:0);NO;;; 50;STRING;;RGB(250,250,193)
                'NrOperacion'    ;d:1..d:Val(a:0);NO;;; 70;STRING;;RGB(250,250,193)
                'F.Liquid.'      ;e:1..e:Val(a:0);SI;;; 60;COMBO ;'STD|DVP|RVP';RGB(160,160,193)
                'Merc.Espec.'    ;f:1..f:Val(a:0);NO;Val(q:flb)=0 o [Val(q:flb)=1 y NoVacio(Val(f:flb))];'Ingrese Mercado Especie'; 70;TABLA ;'MERCADOS';'Codigo';'Codigo;Descripcion';;RGB(250,250,193);
                'Merc.Moned.'    ;g:1..g:Val(a:0);SI;Val(q:flb)=0 o [Val(q:flb)=1 y NoVacio(Val(g:flb))];'Ingrese Mercado Moneda' ; 70;TABLA ;'MERCADOS';'Codigo';'Codigo;Descripcion';" Observaciones like '%M%' ";RGB(160,160,193);
                'FechaOp'        ;h:1..h:Val(a:0);NO;;; 75;STRING;;RGB(250,250,193)
                'FechaVto'       ;i:1..i:Val(a:0);NO;;; 75;STRING;;RGB(250,250,193)
                'Especie'        ;j:1..j:Val(a:0);NO;;; 60;STRING;;RGB(250,250,193)
                'Cantidad'       ;l:1..l:Val(a:0);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)  
                'C.Esp.'         ;k:1..k:Val(a:0);NO;;; 60;STRING;;RGB(250,250,193)
                'Monto'          ;m:1..m:Val(a:0);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)
                'Cta.Veh.Moneda' ;r:1..r:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(r:flb));'Ingrese una Cuenta de Especie'; 80;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(w:flb)~"' and Mercado='"~Val(g:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(j:flb)~"%') ";RGB(160,160,193);SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(w:flb)~"' and Mercado='"~Val(g:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(j:flb)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;
                'Cta.Moneda'     ;s:1..s:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(s:flb));'Ingrese una Cuenta de Moneda' ; 80;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(a:flb)~"' and Mercado='"~Val(g:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%') ";RGB(160,160,193);SQL("Select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(a:flb)~"' and Mercado='"~Val(g:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(k:flb)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;
                'Cta.CCentral'   ;t:1..t:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(t:flb));'Ingrese una Cuenta de Vehiculo de Especie'; 80;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(z:flb)~"' and Mercado='"~Val(f:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(j:flb)~"%')";RGB(160,160,193);SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CC','CA','CUS','VIS','OTR') and Cliente='"~Val(z:flb)~"' and Mercado='"~Val(f:flb)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~Val(j:flb)~"%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;
                FinListBox    
 else
   If EqStr(Val(a:fac),Dialogo.Vehiculo1)
      CrearListBox;'Arial,8,';'Cambio Mercado y Forma Liquidacion 4'
         'Mod.'           ;q:1..q:Val(a:0);SI;;; 50;CHECK ;RGB(160,160,193)
         'Cliente'        ;a:1..a:Val(a:0);NO;;; 50;STRING;;RGB(250,250,193)
         'Nombre'         ;b:1..b:Val(a:0);NO;;;140;STRING;;RGB(250,250,193)
         'TipoOp'         ;c:1..c:Val(a:0);NO;;; 50;STRING;;RGB(250,250,193)
         'NrOperacion'    ;d:1..d:Val(a:0);NO;;; 70;STRING;;RGB(250,250,193)
         'F.Liquid.'      ;e:1..e:Val(a:0);SI;;; 60;COMBO ;'STD|DVP|RVP';RGB(160,160,193)
         'Merc.Espec.'    ;f:1..f:Val(a:0);NO;Val(q:flb)=0 o [Val(q:flb)=1 y [NoVacio(Val(f:flb))] y [[Val(e:flb)=1] o [Val(e:flb)<>1]]];'El Mercado No Corresponde con la Liquidacion'; 70;TABLA ;'MERCADOS';'Codigo';'Codigo;Descripcion';;RGB(250,250,193);
         'Merc.Moned.'    ;g:1..g:Val(a:0);SI;Val(q:flb)=0 o [Val(q:flb)=1 y [[Val(e:flb)=1 y Not EqStr(Val(f:flb),Val(g:flb)) ]] o [Val(e:flb)<>1 y Not EqStr(Val(f:flb),Val(g:flb))]];'La Forma de Liquidacion No Corresponde con los Mercados'; 70;TABLA ;'MERCADOS';'Codigo';'Codigo;Descripcion';" Observaciones like '%M%' ";RGB(160,160,193);
         'FechaOp'        ;h:1..h:Val(a:0);NO;;; 75;STRING;;RGB(250,250,193)
         'FechaVto'       ;i:1..i:Val(a:0);NO;;; 75;STRING;;RGB(250,250,193)
         'Especie'        ;j:1..j:Val(a:0);NO;;; 60;STRING;;RGB(250,250,193)
         'Cantidad'       ;l:1..l:Val(a:0);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)  
         'C.Esp.'         ;k:1..k:Val(a:0);NO;;; 60;STRING;;RGB(250,250,193)
         'Monto'          ;m:1..m:Val(a:0);NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)
         'Cta.Especie'    ;r:1..r:Val(a:0);  ;Val(q:flb)=0 o NoVacio(Val(r:flb));'Ingrese una Cuenta de Titulo'; 80;TABLA;'Cuentas';'Codigo';'Codigo;Nombre';"Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~Val(a:flb)~"' and Mercado='"~Val(f:flb)~"' ";RGB(160,160,193);SQL("select Codigo from "~DBO~".CUENTAS where Estado='HAB' and TipoCuenta IN ('CUS','CCO') and Cliente='"~Val(a:flb)~"' and Mercado='"~Val(f:flb)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC ");NO;NO;
