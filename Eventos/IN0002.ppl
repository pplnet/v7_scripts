**************************************************************************
* IN0002 
*
* Interfase J.D. Edwards -> FPA Emision de pagos
* Fecha..............: 10/MAY/2002 
* Ultima modificacisn: 03/JUN/2002 21:30
* Autor..............: A.L. GRAZIADIO 
*
*  VARIABLES:
*  ----------
*  CAPORG     = Nombre de archivo ORIGEN a procesar
*  CAPDST     = Carpeta destino una vez procesado
*  ESTADOCHEQ = Variable de validacion del estado del cheque
*
*  Referencias:
*  ------------
*  RR      = Registro del archivo TXT
*
*  Celdas de desglose:
*  -------------------
*  XA..XN  = Celdas de desglose campo a campo del registro del archivo TXT
*
*  XO:nn   = N: de chequera para el registro
*  XP:nn   = Estado del cheque para el registro tratado
*  XQ:nn   = N: de transaccion del cheque a anular 
*  XR:nn   = Vector de errores para el registro tratado
*  XS:nn   = Plazo del cheque
*  XT:nn   = Tipo instrumento de pago
*  XU:nn   = Cuenta FPA (Codigo de tabla CUENTAS)
*  XV:nn   = Banco  FPA (Comitente de tabla CUENTAS)
*
*  JJ:1    = Numero de Bit
*  NU:1    = Numero de transaccion para el caso de una transaccion nueva
*  TT:1    = Tipo   de transaccion para el caso de una transaccion nueva
*  OB:1    = Observaciones para el cheque
*  PE:1    = Nombre del archivo XLS
*
*  Validacion de fecha:
*  --------------------  
* 
*  Se utiliza la funcion FECHAVALID
*
*  FE:1    = Argumento de entrada para validacion de fecha (dd/mm/yyyy)
*  FE:2    = Argumento de entrada para validacion de fecha (0=No valida aqo/1=Valida ano)
*
*     Variables internas utilizadas por la funcion FECHAVALID
*     YA:1 = DIA caracter
*     YA:2 = MES caracter
*     YA:3 = AQO caracter
*     YA:4 = Mensaje de error
*     YB:1 = DIA numerico
*     YB:2 = MES numerico
*     YB:3 = AQO numerico
*
*  Variables de control de ciclo de lectura y carga:
*  -------------------------------------------------
*  ZA:1    = Ultima fila cargada 
*  ZB:1    = Seqal de ciclo de validacisn OK 
*  ZC:1    = Contador inicial de lmneas del reporte
*  ZD:1    = Contador final   de lmneas del reporte 
*  ZE:1    = Posicion del punto en el nombre del archivo para armado nombre XLS
*  ZF:1    = Longitud total del path del archivo origen
*  ZG:1    = Nombre del archivo origen
*  ZH:1    = Posicion de la ultima barra en el path del archivo de origen
*  ZI:1    = Celda conde guardo la formula de posicionamiento
*  ZJ:1    = Seqal de ciclo de actualizacisn OK
*  ZK:1    = Leyenda de estado de cheque 
*
*  Variables genericas de validacion:
*  ----------------------------------
*  ZX:nn   = Numerica
*  ZZ:nn   = Texto
*
**************************************************************************

MostrarCuadroDemensajes
Hojavisible(SI)
CrearDialogo
  String :'Archivo'           ;1;1;;;;NOVACIO(Dialogo.String);'Nombre de archivo INVALIDO';NO;VAR('CAPORG');;;;;;;;;SI
  String1:'Nuevo Path'        ;;;;;;NOVACIO(Dialogo.String1);'Nombre de camino/path INVALIDO';NO;VAR('CAPDST');;;;;;;;;
  Radio1 :'Valida aqo|Si|No'  ;;;;;;;;;0
  Radio2 :'Crea excel|Si|No'  ;;;;;;;;;0
  Radio3 :'Sist.Oper.|W98|NT' ;;;;;;;;;0
  Radio4 :'Mueve TXT |No|Si'  ;;;;;;;;;1
FinDialogo

If Not Ok 
   Cancelar
EndIf

If  Not ExisteArchivo(Dialogo.String) 
    Cancelar("ERROR GRAVE: No existe un archivo con el nombre ingresado "~Dialogo.String)
EndIf

** -- Inicializo variables
ACN(za:1, 0)
ACN(zb:1, 0)
ACN(zj:1, 0)

ACT(ob:1, "Interfaz CAP-SIAF")
ACN(ze:1, Posicion('.', Dialogo.String) )

ACT(ck1,HORA(AHORA))
ACT(ck2,Copy(val(ck1),1,2)~'_'~Copy(val(ck1),4,2)~'_'~Copy(val(ck1),7,2))

ACT(pe:1, Copy(Dialogo.String, 1,VAL(ze:1)-1)~'_'~val(ck2)~".XLS" )
** -- Aislo el nombre del archivo de entrada
ACN(zf:1, Longitud(Dialogo.String) )

** -- Recorre de atras para adelante
RECORRER&i 1, VAL(zf:1)
    ACN(zi:1, VAL(zf:1)+1-&i )
    ACT(zh:1, Copy(Dialogo.String, VAL(zi:1),1) )
    If  Eqstrl(VAL(zh:1),"\",1)
        ACT(zg:1, Copy(Dialogo.String, VAL(zi:1), VAL(zf:1) ) )
        Break
    Endif
PROXIMO
ACT(zg:1, Dialogo.String1~VAL(zg:1))

************************************************
** -- CICLO DE LECTURA, VALIDACION Y CARGA -- **
************************************************

AbrirASCII(Dialogo.String,0)

RECORRER&i 1,1000000
    
    ACT(rr:1,LeerASCII)

    ** -- Fin de archivo
    If Vacio(VAL(rr:1)) 
       Break  
    Endif

    ** -- Solo procesa registros con codigo de interfase CAP
    If Eqstrl(VAL(rr:1),"CAP",3)

       ** -- Incremento el contador de filas cargadas
       SCN(za:1, 1)

       ** -- Vehiculo 
       ACT(xa:VAL(za:1),Copy(VAL(rr:1), 4,10) )

       ACT(zz:VAL(za:1), SQL(" SELECT Codigo FROM "~DBO~".VEHICULOS WHERE Codigo = '"~TRIM(MIRT(VAL(xa:VAL(za:1))))~"' ") )
       If  Vacio(VAL(zz:VAL(za:1)))
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"A ")
       EndIf

       ** -- Banco 
       ACT(xb:VAL(za:1),Copy(VAL(rr:1), 14,8) )
*       ACN(zx:VAL(za:1),SQL("SELECT COUNT(*) FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ") )
*       If  VAL(zx:VAL(za:1)) = 0
*           ACN(zb:1, 1)
*           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"B ") 
*       Else
*           ACT(xu:VAL(za:1), SQL("SELECT /*+ RULE */ Codigo    FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ") )
*           ACT(xv:VAL(za:1), SQL("SELECT /*+ RULE */ Comitente FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ") ) 
*       EndIf

       ACN(BD:1, 0)
       SQL.ADD(" SELECT /*+ RULE */ Codigo, Comitente ")
       SQL.ADD(" FROM "~DBO~".CUENTAS ")
       SQL.ADD(" WHERE Cliente='"~VAL(xa:VAL(za:1))~"' ")
       SQL.ADD(" AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ")
       Recorrer SQL
           ACN(BD:1, 1)
           ACT(xu:VAL(za:1), fbn('Codigo'))
           ACT(xv:VAL(za:1), fbn('Comitente'))
       Proximo
       IF Val(BD:1) = 0
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"B ") 
       ENDIF

       ** -- Fecha ejecucion dd/mm/yyyy 
       ACT(xc:VAL(za:1),Copy(VAL(rr:1), 22,10) )
       ACT(fe:1, VAL(xc:VAL(za:1)) )
       ACN(fe:2, Dialogo.Radio1 ) 
       (.'FECHAVALID'.)
       If  Eqstr(VAL(fe:1), '          ') 
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"C ")
       EndIf

       ** -- N: cheque 
       ACT(xd:VAL(za:1), Copy(VAL(rr:1), 32,15) )
       If  Vacio(VAL(xd:VAL(za:1)))
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"D ")
       ELSE
           ACN(xd:VAL(za:1), NUM(Copy(VAL(rr:1), 32,15)) )  
       EndIf  

       ** -- N: proveedor y nombre
       ACT(xe:VAL(za:1),Copy(VAL(rr:1), 47, 8) )        
       If  Vacio(VAL(xe:VAL(za:1)))
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"E ")
       EndIf
       ACT(xf:VAL(za:1),Copy(VAL(rr:1), 55,40) )        

       ** -- Fecha emision dd/mm/yyyy
       ACT(xg:VAL(za:1),Copy(VAL(rr:1), 95,10) )        
       ACT(fe:1, VAL(xg:VAL(za:1)) )
       ACN(fe:2, Dialogo.Radio1)
       (.'FECHAVALID'.)
       If  Eqstr(VAL(fe:1), '          ') 
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"G ")
       EndIf

       ** -- Fecha vencimiento dd/mm/yyyy
       ACT(xh:VAL(za:1),Copy(VAL(rr:1),105,10) )        
       ACT(fe:1, VAL(xh:VAL(za:1)) )
       ACN(fe:2, Dialogo.Radio1 )
       (.'FECHAVALID'.)
       If  Eqstr(VAL(fe:1), '          ') 
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"H ")
       EndIf

       ** -- Fecha anulacion dd/mm/yyyy
**
** --> NO SE VALIDA  a partir del 20/05/2002
**
**     ACT(xi:VAL(za:1),Copy(VAL(rr:1),115,10) )        
**     ACT(fe:1, VAL(xi:VAL(za:1)) )
**     ACN(fe:2, Dialogo.Radio1 )
**     (.'FECHAVALID'.)
**     If  Eqstr(VAL(fe:1), '          ') 
**         ACN(zb:1, 1)
**         ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"I ")
**     EndIf
       ACT(xi:VAL(za:1), "          " )        

       ** -- Estado cheque 
       ACT(xj:VAL(za:1),Copy(VAL(rr:1),125, 1) )        
       If  NOT Incluido( VAL(xj:VAL(za:1)), EXE('ESTADOCHEQ') )
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"J ")
       Else
           ** -- N: de chequera
           ACT(xo:VAL(za:1),SQL("SELECT Chequera FROM "~DBO~".CNCHEQUERASBANCO WHERE Vehiculo='"~VAL(xa:VAL(za:1))~"' AND Banco='"~VAL(xv:VAL(za:1))~"' AND Cuenta='"~VAL(xu:VAL(za:1))~"' AND "~VAL(xd:VAL(za:1))~" BETWEEN NrChequeDesde AND NrChequeHasta ") )
           If  Vacio(VAL(xo:VAL(za:1)))           
               ACN(zb:1, 1)
               ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"O ")
           EndIf
       EndIf

       ** -- Calculo el plazo del cheque
       ACN(zx:VAL(za:1), DifDias(Fecha(VAL(xg:VAL(za:1))),Fecha(VAL(xh:VAL(za:1))),'ARG') )
       If  VAL(zx:VAL(za:1)) >= 4
           ACN(xs:VAL(za:1), 4)
       Else
           ACN(xs:VAL(za:1), VAL(zx:VAL(ZA:1) ) )
       EndIf   

       ** -- Importe
       ACN(xk:VAL(za:1),NUM(COPY(VAL(rr:1),126,15)) )
       If  NOT Eqstr(VAL(xj:&i), "X")
           ** -- Para otro estado de Cheque que no sea "X" no puede ser cero el impoprte
           If  VAL(xk:VAL(za:1)) = 0
               ACN(zb:1, 1)
               ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"K ")
           EndIf
       EndIf

       ** -- Moneda
       ACT(xl:VAL(za:1),Copy(VAL(rr:1),141, 3) )  
       ACT(xy:VAL(za:1), TRIM(MIRT(VAL(xl:VAL(za:1)))) )  

       ACT(xz:VAL(za:1), SQL(" SELECT Codigo FROM "~DBO~".ESPECIES WHERE Alias3 ='"~VAL(xy:VAL(za:1))~"' ")) 

       ACT(zy:VAL(za:1), SQL(" SELECT Especies FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' "))
       ACN(zz:VAL(za:1), Buscarlista(TRIM(MIRT(VAL(xl:VAL(za:1)))), SQL(" SELECT Especies FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ")))
  
*       If  VAL(zz:VAL(za:1)) <= 0
*           ACN(zb:1, 1)
*           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"L ")
*       EndIf

       If  VAL(zz:VAL(za:1)) > 0
       else

********************
           SQL.ADD(" Select X.Codigo  from "~DBO~".Especies X ")
           SQL.ADD("   where X.Alias3 = '"~VAL(xy:VAL(za:1))~"' ")
*-- 

Recorrer SQL
           ACT(xx:fac,FBN['Codigo'])
Proximo

********************
           if fac < 1
               ACN(zb:1, 1)
               ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"L ")
           else 
               ACN(zz:VAL(za:1), Buscarlista(TRIM(MIRT(VAL(xx:fac))), SQL(" SELECT Especies FROM "~DBO~".CUENTAS WHERE Cliente='"~VAL(xa:VAL(za:1))~"' AND Alias7 ='"~VAL(xb:VAL(za:1))~"' ")))
               If  VAL(zz:VAL(za:1)) <= 0
                   ACN(zb:1, 1)
                   ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"L ")
               else
                   ACT(xl:VAL(za:1), VAL(xx:fac) )  
               endif
           endif
       EndIf 
 
        ** -- Instrumento de pago 
       ACT(xm:VAL(za:1),Copy(VAL(rr:1),144, 1) )
       ACT(zz:VAL(za:1), SQL(" SELECT /*+ RULE */ Codigo FROM "~DBO~".CNFORMASPAGOCOBRO WHERE Codigo = '"~TRIM(MIRT(VAL(xm:VAL(za:1))))~"' ") )
       If  Vacio(VAL(zz:VAL(za:1)))
           ACN(zb:1, 1)
           ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"M ")
       Else 
           ** -- Tipo de instrumento de pago
           ACT(xt:VAL(za:1), SQL(" SELECT /*+ RULE */ Tipo FROM "~DBO~".CNFORMASPAGOCOBRO WHERE Codigo = '"~TRIM(MIRT(VAL(xm:VAL(za:1))))~"' ") )
           If  Vacio(VAL(xt:VAL(za:1)))
               ACN(zb:1, 1)
               ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"T ")           
           EndIf
       EndIf

       ** -- Concepto de pago        
       ACT(xn:VAL(za:1),Copy(VAL(rr:1),145,6) )        
       If  Vacio(VAL(xn:VAL(za:1)))
           ACT(xn:VAL(za:1), 'RETIRO' ) 
       Else
           ACT(zz:VAL(za:1), SQL(" SELECT /*+ RULE */ Codigo FROM "~DBO~".CNCONCEPTOSPAGOCOBRO WHERE Codigo = '"~TRIM(MIRT(VAL(xn:VAL(za:1))))~"' ") )
           If  Vacio(VAL(zz:VAL(za:1)))
               ACN(zb:1, 1)
               ACT(xr:VAL(za:1), VAL(xr:VAL(za:1))~"N ")           
           EndIf
       EndIf

    EndIf

PROXIMO

CerrarASCII

********************************
** -- CICLO DE TRATAMIENTO -- **
********************************
*
CrearFont(1,"Arial,10,B")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,I")
*
ACN(zc:1,1)
ACN(zd:1, VAL(zc:1))
*
ACT(a:val(zd:1), "S.I.A.F.")
ACT(g:val(zd:1), "G R U P O   T E L E C O M")
ACD(p:val(zd:1), FSYS ) 
SCN(zd:1,2)    
ACT(g:val(zd:1), "Errores Interfase de Transferencias SIAG => SIAF (CAP)" )
SetFont(a:val(zc:1)..p:val(zd:1), 1)
SCN(zd:1,1)
*
AgregarMarco(a:val(zd:1)..p:val(zd:1)+1,2,0,Exe('COLOR'))
ACT(a:val(zd:1), "Vehiculo" )
ACT(b:val(zd:1), "ID Cta.Bco." )
ACT(c:val(zd:1), "F.Ejec." ) 
ACT(d:val(zd:1), "N: Chq/O.Pgo." ) 
ACT(e:val(zd:1), "N: Proveedor" ) 
ACT(f:val(zd:1), "Nombre Proveedor" ) 
ACT(g:val(zd:1), "F.Emision" ) 
ACT(h:val(zd:1), "F.Vto." ) 
ACT(i:val(zd:1), "F.Anul." )
ACT(j:val(zd:1), "Estado" )
ACT(k:val(zd:1), "Importe" )  
ACT(l:val(zd:1), "Moneda" ) 
ACT(m:val(zd:1), "Ins./Pago" )
ACT(n:val(zd:1), "Cpt./Pago" )   
ACT(o:val(zd:1), "N: Chequera" ) 
ACT(p:val(zd:1), "ERRORES")
SetFont(a:val(zd:1)..p:val(zd:1), 2)
SCN(zd:1, 1)
*
ACT(a:val(zd:1), "(A)" )
ACT(b:val(zd:1), "(B)" )
ACT(c:val(zd:1), "(C)" )
ACT(d:val(zd:1), "(D)" ) 
ACT(e:val(zd:1), "(E)" ) 
ACT(f:val(zd:1), "(F)" ) 
ACT(g:val(zd:1), "(G)" ) 
ACT(h:val(zd:1), "(H)" ) 
ACT(i:val(zd:1), "(I)" ) 
ACT(j:val(zd:1), "(J)" )
ACT(k:val(zd:1), "(K)" )  
ACT(l:val(zd:1), "(L)" ) 
ACT(m:val(zd:1), "(M) (T)" )
ACT(n:val(zd:1), "(N)" )
ACT(o:val(zd:1), "(O)" )
SCN(zd:1, 1)
*
* -- Ciclo de impresion y actualizacisn
*
RECORRER&i 1, VAL(za:1)

   ** -- IMPRESION
   ACT(a:val(zd:1), VAL(xa:&i) )
   ACT(b:val(zd:1), VAL(xb:&i) )
   ACT(c:val(zd:1), VAL(xc:&i) )
   ACT(d:val(zd:1), Fstr(VAL(xd:&i),15,0) ) 
   ACT(e:val(zd:1), VAL(xe:&i) ) 
   ACT(f:val(zd:1), VAL(xf:&i) ) 
   ACT(g:val(zd:1), VAL(xg:&i) ) 
   ACT(h:val(zd:1), VAL(xh:&i) ) 
   ACT(i:val(zd:1), VAL(xi:&i) ) 
   ACT(j:val(zd:1), VAL(xj:&i) )
   ACT(k:val(zd:1), Fstr(VAL(xk:&i),15,2) )  
   ACT(l:val(zd:1), VAL(xl:&i) ) 
   ACT(m:val(zd:1), VAL(xm:&i)~" / "~VAL(xt:&i) )
   ACT(n:val(zd:1), VAL(xn:&i) )
   ACT(o:val(zd:1), VAL(xo:&i) )   
   ACT(p:val(zd:1), VAL(xr:&i) )
   
   ** -- ACTUALIZACION
   If VAL(zb:1) = 0
      If  Eqstr(VAL(xj:&i), "X")
          If  Eqstr(VAL(xt:&i), "CHE")
              ** -- Cancelacion de cheque
              (.'IN0002B'.)
          Else
              ** -- Camcelacion de Orden de Pago 
              (.'IN0002E'.)
          EndIf
      Else
          If Eqstr(VAL(xj:&i), "A")
             ** -- Alta de movimiento cheque
             If  Eqstr(VAL(xt:&i), "CHE")
                 (.'IN0002A'.)          
             Else
             ** -- Alta de movimiento Orden de Pago
                 (.'IN0002D'.)
             EndIf
          Else
          ** -- Cambio de Estado
             If  Eqstr(VAL(xj:&i), "E")
                 (.'IN0002C'.)
             EndIf
          EndIf             
      EndIf
   EndIf

   ** -- Incremento contador de l¡neas
   SCN(zd:1, 1)

PROXIMO

** -- Aviso de advertencia
If NOT VAL(zb:1) = 0
   ACT(a:val(zd:1), "*** Error en al menos 1 registro del lote, no se efect£a Fase de Actualizacion de Tablas ***" )
   SCN(zd:1, 1)
EndIf


** -- Genero excel a imagen del reporte
ExportarWKS(a:val(zc:1)..p:val(zd:1), a:val(zc:1)..p:val(zd:1), VAL(pe:1) ) 

ACT(a:val(zd:1)+2, 'Fin')

ACT(fe:1,Fecha(fsys))
GrabarPMG(Val(fe:1), 'IN0002|Interfaz CAP-SIAF|'~Hora(AHORA) )



** -- Si no hubo error en ciclo de validacisn ni en ciclo de actualizacion
If VAL(zb:1) = 0 Y VAL(zj:1) = 0   
   Message('** -- y pedi moverlo ...')
   If Dialogo.Radio4 = 1
      If ExisteArchivo(Dialogo.String) 
         ** -- W98 
         If Dialogo.Radio3 = 0 
            WinExec('COMMAND.COM /C copy '~Dialogo.String~' '~VAL(zg:1), 0 )
            Esperar(5)
            WinExec('COMMAND.COM /C del  '~Dialogo.String, 0 )
         Else
         ** -- NT
            WinExec('CMD.EXE /C     copy '~Dialogo.String~' '~VAL(zg:1), 0 )
            Esperar(5)            
            WinExec('CMD.EXE /C     del  '~Dialogo.String, 0)      
         EndIf
         Esperar(5)
      EndIf
   EndIf
EndIf

** -- Formato de columnas
ACO(1, 6)
ACO(2, 8)
ACO(3, 8)
ACO(4, 8) 
ACO(5, 8)
ACO(6, 25)
ACO(7, 8)
ACO(8, 8)
ACO(9, 8) 
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)
ACO(14,8)
ACO(15,8)
ACO(16,30)

Impresion(1,2)
SetPrintFit(3,70)
LimitesVision(p:VAL(zd:1))
