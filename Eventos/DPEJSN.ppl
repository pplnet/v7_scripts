* DPEJSN: Ejercicio de Swaption -PC-
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
  Fecha1       : "F Real Ej."               ;;;;NO;;;;;Fsys
  Radio1       : "Opcion|Europea|Americana" ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Radio4       : "Ejerce?|Si|No"            ;;;;;;;;;0;
  Especie1     : "Commodity"                ;1;2;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha4       : "Fecha Ej"                 ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaPrecan','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Fijo"              ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Consumer|Producer"   ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Radio3       : "    |Compra|Venta"        ;;;;NO;;;;;;BuscarCampo('Operaciones','MB3','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DPSN')
   Cancelar('La operacion No '~Dialogo.NrOperacion1~' No es un Swaption de Commodities')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

* Verifico que no se haya pasado la fecha de liquidacion
(.'DCFMODI'.)

If Dialogo.Fecha1>VAL(D1)
   Cancelar('La Operacion ya fue Liquidada, No se puede Modificar !!!')
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and ((TipoOpcion='0' and FechaPrecan= '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" or (TipoOpcion='1' and FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and FechaPrecan>= '"~IdxDate(Dialogo.Fecha1)~"')) ")

*    SQL.ADD("and (CB8 is Null or CB8='0') ")

   Recorrer SQL

     acn(x1,1)

     if Dialogo.Radio4=0
        Message('Obteniendo los Nros. de Operaciones a Generar .... ')          

        *** Z3 Nro. Operacion Contado
        ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

        * Si decide Ejercer
        **-- Genero la Operacion Asociada
        acn(x1,1)
        ACT(z1,'DPS')        

        **-- Si es venta invierto el tipo
        *** Z2: Consumer o Producer
        ACN(z2,FBN['MB1'])        

        IF FBN['MB3']=1 
           *- Venta 
           IF FBN['MB1']=0
              ACN(z2,1)        
           ELSE 
              ACN(z2,0)        
           ENDIF
        ENDIF
 
        Message('Generando Operacion .... ')     
 
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
        SQL.ADD("(TipoOp, NrOperacion, ")
        SQL.ADD(" FechaOp,Vehiculo1,")
        SQL.ADD(" MB1,")
        SQL.ADD(" PrecioRef,Cliente1,")
        SQL.ADD(" Especie, PrecioEj,")
        SQL.ADD(" Cantidad,")
        SQL.ADD(" ContraEspecie,")
        SQL.ADD(" CB9, UMedida,TotalAux2,")
        SQL.ADD(" TotalAux1, TablaFeriados1,")
        SQL.ADD(" Operador, Observac2,")
        SQL.ADD(" CB8,")
        SQL.ADD(" FechaOp2,Plazo,")
        SQL.ADD(" Cuotas1,FechaEj,OperacionRef,RB3) ")
        SQL.ADD(" Values ")
        SQL.ADD("('"~Val(z1)~"', '"~Val(z3)~"', ")
        SQL.ADD(" '"~IdxDate(Fsys)~"','"~FBN['Vehiculo1']~"', ")
        SQL.ADD(" '"~FStr(VAL(z2),0,0)~"',")
        SQL.ADD(" '"~FBN['PrecioRef']~"', '"~FBN['Cliente1']~"',")
        SQL.ADD(" '"~FBN['Especie']~"', "~Fstr(FBN['PrecioEj'],0,7)~", ")
        SQL.ADD(" "~Fstr(FBN['Cantidad'],0,4)~", ")
        SQL.ADD(" '"~FBN['ContraEspecie']~"', ")
        SQL.ADD(" '"~FBN['CB9']~"','"~FBN['UMedida']~"', "~FBN['TotalAux2']~", ")
        SQL.ADD(" "~Fstr(FBN['TotalAux1'],0,2)~",'"~FBN['TablaFeriados1']~"', ")
        SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Observac2']~"', ")
        SQL.ADD(" '1',")
        SQL.ADD(" '"~IdxDate(FBN['FechaOp2'])~"',"~Fstr(FBN['Plazo'],0,0)~",")
        SQL.ADD(" "~Fstr(FBN['Cuotas1'],0,0)~", '"~IdxDate(FBN['FechaEj'])~"','"~Dialogo.NrOperacion1~"','"~FBN['RB3']~"' ) ")
        SQL.NEW

        *** Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Val(z3),SI)
        SQL.EXEC

        * Alta de Instancias Z3: Nro.Operacion
        (.'ALTAINSTAN'.)

        SQL.ADD("Select * from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ORDER BY NrCuota ")

        Recorrer SQL
           SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
           SQL.ADD("(NrOperacion,NrCuota, ")
           SQL.ADD(" Fecha1,Plazo1   ,")
           SQL.ADD(" Fecha2,Cantidad1 )")
           SQL.ADD(" Values ")
           SQL.ADD("('"~Val(z3)~"', "~Fstr(FBN['NrCuota'],2,0)~" ,")
           SQL.ADD(" '"~IdxDate(FBN['Fecha1'])~"',"~Fstr(FBN['Plazo1'],2,0)~", ")
           SQL.ADD(" '"~IdxDate(FBN['Fecha2'])~"', ")
           SQL.ADD(" "~Fstr(FBN['Cantidad1'],0,2)~" ) ")
           SQL.NEW
           SQL.EXEC
        Proximo
     *- De Ejerce 
     EndIf

     Message('Actualizando la Operacion  .... ')                  

     *** Marca la operacion como ejercida ***
     SQL.ADD("Update "~DBO~".OPERACIONES ")

     if Dialogo.Radio4=0
        SQL.ADD("Set CB8 = '1', ")
     else
        SQL.ADD("Set CB8 = '-1', ")
     endif

     SQL.ADD("NrOperacion2 = '"~VAL(z3)~"', ")
     SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
     SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     SQL.EXEC

     * Actualizo la Instancia de la Operacion a Supervision
     (.'MODIINSTAN'.)      

   proximo

   If Val(x1)=0
      Cancelar('La operacion No '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif