MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;3;1;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif


Message('--- Asientos de Vencimiento ---')

ACT(ME:1, Var('MONEEXTR'))
ACT(ML:1, Var('MONELOCA'))
ACN(NA:1, Var('ASINUM'))
ACT(VC:1, Dialogo.Vehiculo1)
ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))
*ACT(NG:1, Var('MNNIIFDES'))
*ACT(BK:1, BuscarCampo('MODELOSNEGOCIO','Books','Codigo', Var('MNNIIFDES')))
*ACT(EG:1, Var('EMIGRUPOP'))
***---Cliente MAE
ACT(CM:1, Var('CLIENTEMAE'))
***---Ruedas Garantizadas Futuros Moneda (CPC2)
*ACT(RG:1, Var('RUEGRTMON'))

SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.Vehiculo1, O.Cantidad, MA.Codigo CodAsi, ")
SQL.ADD(" O.Mercado4, C.PaisDir, O.Cuenta1, O.TotalNetoCli1, O.ContraEspecie, O.Especie, O.FechaOp, ")
SQL.ADD(" '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
SQL.ADD(" O.Cliente1 as Cliente, O.TotalGastos, O.TotalCaucion, O.TotalGastos - O.TotalCaucion as Prima, ")
SQL.ADD(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, O.Plazo, C.Pais, O.Cupon1,")
SQL.ADD(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2, O.PorAforo, O.ContraEspecie Moneda, ")
SQL.ADD(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1,O.Cuenta3 CtaBcoOp, ")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
SQL.ADD(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut,O.RB10 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIVTO'))~") ")
SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(val(FE:1))~"' ")
***---1) TODO LO QUE VENCE HOY Y SE CARGO ANTES O IGUAL A HOY
***---2) TODO LO QUE CARGO HOY Y YA ESTÁ VENCIDO
SQL.ADD(" AND ((O.FechaVto >= O.FechaCargaSys AND O.FechaVto = '"~IdxDate(Dialogo.fecha1)~"') ")
SQL.ADD("       OR (O.FechaVto < O.FechaCargaSys AND O.FechaCargaSys = '"~IdxDate(Dialogo.fecha1)~"' )) ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
If Dialogo.Radio1 = 4
    ***---Todo
    SQL.ADD(" AND O.TipoOp IN ('TIPA','TIPP','FXCF','FXVF') ")
ELSE
    IF Dialogo.Radio1 = 0
        ***---Securities => Acciones, Titulos y Futuros de Titulos
        SQL.ADD(" AND O.TipoOp IN ('TIPA','TIPP') ")
    ELSE
        IF Dialogo.Radio1 = 1
            ***---Fx Spot => Canje
        ELSE
            IF Dialogo.Radio1 = 2
                ***---Fx Futuros => Futuros OCT rueda CPC2 contra terceros
                SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
            ELSE
                IF Dialogo.Radio1 = 3
                    ***---MM
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF
SQL.ADD(" ORDER BY O.NrOperacion ")
watch(SQL.batch)
Recorrer SQL
    **Cintia 190924 - issue 7512
    IF Eqstr(Var('INSTALACIO'),'BACS')
        let &mercNeg ''
    Else    
        let &mercneg #MERCNEGO  
    Endif
    **
    
    **Cintia 300125 - 7871
    let &esNDF Iif(fbn('RB10')=1, SI, NO)
    **
    
    ACD(FV:1, fbn('FechaVto'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, fbn('FechaOp'))
    ACT(BK:1, fbn('Book1'))
    ACT(EM:1, fbn('MonedaEmision'))
    ACT(MN:99, fbn('ContraEspecie'))
    **Cintia Feb2025 - se setea el total MTM de la Op para sumar al asiento de VTO
    let &signoMTM 1
    IF NOT #ESCP y #ESNDFMER
        let &signoMTM (-1)
    Endif
    let &MTMTotOp QUERY(" Select Sum(MTM) from "~DBO~".MTMDIARIO Where NrOperacion = '"~fbn('NrOperacion')~"'  ")*&signoMTM
    **
    **Datos para Interfaz
    ACT(FV:2,fbn('FechaVto'))
    **
    IF Eqstr(fbn('TipoOp'), 'TIPP')
        ***---DEJO ESTO PARA USAR para Obtener POsicion, nada mas
        ***---Calculo el Resultado Realizado de la venta Spot
        ***---Busco el PPP de la posicion en ARP
*        ACT(ES:1, fbn('Especie'))
*        ACD(FE:88, Dialogo.Fecha1)
*        ACT(BK:1, fbn('Book1'))
*        ACT(CU:1, fbn('Cupon1'))
*        ACN(SL:1, 171)
*        (.'PPP'.)
*        ACN(PR:1, fbn('Precio1'))
*        IF Not Eqstr(fbn('ContraEspecie'), Val(ML:1))
*            ACT(MN:99, fbn('ContraEspecie'))
*            ACN(PR:1, Val(PR:1) * #TCCONTABLE)
*        ENDIF
*        ACN(RR:1, fbn('Cantidad') * (Val(PR:1) - Val(PP:99)))
    ENDIF
    **Eliana 22-10-24 - Futuros no usa CotizacionNiif
    If Not Eqstr(fbn('TipoOp'), 'FXCF') AND Not Eqstr(fbn('TipoOp'), 'FXVF')
        ***---Precio NIIF Ayer
        Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1-1, fbn('Book1'))
        IF Vacio(&PrecioNIIF)
            ACN(PR:1, 0)
        ELSE
            *ACT(b:fac, &PrecioNIIF.Nombre)
            *ACT(c:fac, &PrecioNIIF.Moneda)
            *ACT(d:fac, &PrecioNIIF.TipoValuacionActual)
            *ACD(e:fac, &PrecioNIIF.FechaUltimaCotizacion)
            *ACT(f:fac, &PrecioNIIF.PrecioContadoCierreDirty)
            ACN(PR:1, &PrecioNIIF.PrecioCotizacionDeterminada)
            *ACT(h:fac, &PrecioNIIF.PlazoLiquidacion)
            *ACT(i:fac, &PrecioNIIF.CodigoBook)
            *ACT(j:fac, &PrecioNIIF.ModeloNegocio)
        ENDIF
    EndIf
    ***---Calculo Revaluo Total de la Operacion
    ***---Paso Precio de la Operacion a Moneda de Emision
    IF Not Eqstr(fbn('ContraEspecie'), fbn('Cotiza'))
        ACN(PR:2, fbn('Precio1') * CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,fbn('Cotiza')))
    ELSE
        ACN(PR:2, fbn('Precio1'))
    ENDIF
    ACN(DF:1, Val(PR:1) - Val(PR:2))
    ***---Revaluo en Cotiza
    ACN(RV:10, fbn('Cantidad') * Val(DF:1))
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    let &codAsi fbn('CodAsi')
    IF Val(CK:1) = 0
        Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(&codAsi, fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
