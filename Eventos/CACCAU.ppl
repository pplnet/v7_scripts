ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMCAUA');'El TipoOp debe ser MMCAUA';NO;;;;;;" TipoOp in ('MMCAUA') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACCAU')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo, O.FechaVto, O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   
   let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Vehiculo1'])
   let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
   let &simbolo_especie IIF(EqStr(fbn['Especie'],'ARP'),'$',IIF(EqStr(fbn['Especie'],'USD'),'u$s',fbn['Especie'] ) )
   let &numero_cuenta BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])
   let &fecha_vto fbn['FechaVto']
   let &tna PYC(fbn['Precio1'],1,2)
   let &fecha_larga FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)
   let &nombre_especie BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie'])
   let &cod_comitente BuscarCampo('CLIENTES','CodComitente','Codigo',fbn['Cliente1'])
   
   EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, numero_cuenta = &numero_cuenta, especie = &simbolo_especie, nombre_especie = &nombre_especie, monto = PYC(fbn['Cantidad'],1,2), plazo = fbn['Plazo'], fecha_vto = &fecha_vto, t_n_a = &tna, cod_comitente = &cod_comitente)
   
Proximo