** FJL 31/01/23 - Ajsute posiciones por error en RESPCO
CrearDialogo
  Radio1 : 'Ajuste|PTSTO';;;;  ;  ;;;;0
  Fecha1 : 'Fecha'       ;;;;NO;  ;;;;Fecha('19/10/2022')
  Check1 : 'Procesa'     ;;;;;;;;;0
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

IF Dialogo.Radio1=0
  ACT(a:1, 'Especie')  
  ACT(b:1, 'PTSTO')
  ACT(a:2, 'Fecha')  
  ACT(b:2, Dialogo.Fecha1)
  ACN(x:1, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and Fecha>'"~IdxDate(Dialogo.Fecha1)~"' "))
  if Val(x:1)=0
    IF Dialogo.Check1=1
      Cancelar('Evento Cancelado. Es posible que el ajuste ya se haya ejecutado.')
    else
      MessageBox('Evento Cancelado. Es posible que el ajuste ya se haya ejecutado.')
    endif
  endif

  ACT(a:3, '# Pos 170')  
  ACN(b:3, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo>=170 and NrSaldo<180 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACT(a:4, '# Pos 190')  
  ACN(b:4, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo>=190 and NrSaldo<200 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACT(a:5, '# Pos Otros')  
  ACN(b:5, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo<170 and NrSaldo>=200 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACT(a:6, '# Pos 191 a Modi')  
  ACN(b:6, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo=191 and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
  
  IF Dialogo.Check1=1

    SQL.ADD("Delete "~DBO~".POSICIONES ")
    SQL.ADD(" WHERE Especie  = '"~Val(b:1)~"' ")
    SQL.ADD("   AND Nrsaldo  >= 170 ")
    SQL.ADD("   AND Nrsaldo  < 200 ")
    SQL.ADD("   AND Fecha    >'"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.NEW
    
    SQL.ADD("Update "~DBO~".POSICIONES ")
    SQL.ADD("   Set CantidadFin  = 0 ")
    SQL.ADD(" WHERE Especie  = '"~Val(b:1)~"' ")
    SQL.ADD("   AND Nrsaldo  = 191 ")
    SQL.ADD("   AND Fecha    ='"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.NEW

    SQL.EXEC
    MessageBox('Ajuste PTSTO realizado.')
  else
    ACT(b:7, 'NO PROCESA')
    SetFont(b:7,2)
  endif

  ACN(c:3, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo>=170 and NrSaldo<180 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACN(c:4, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo>=190 and NrSaldo<200 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACN(c:5, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo<170 and NrSaldo>=200 and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' "))
  ACN(c:6, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(b:1)~"' and NrSaldo=191 and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
  
  ACO(1, 10)
endif

IF Dialogo.Check1=0
  MessageBox('Evento finalizo sin procesar.')
endif
