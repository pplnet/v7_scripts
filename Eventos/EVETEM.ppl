** FJL 29/08/25 - Issue 8409 - Ajuste movimientos Posicion
CrearDialogo
  Radio1 : 'Ajuste|TB725|GD38|T2X5P|BPJ25';;;;  ;  ;;;;0
  Check1 : 'Procesa'        ;;;;SI;SI;;;;1
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

** TB725 **
IF Dialogo.Radio1=0
  SetFilaActual(1)
  ACT(a:FAC, 'Especie')  
  ACT(b:FAC, 'Operacion')  
  ACT(c:FAC, 'MovsPosEje')  
  ACT(d:FAC, 'MPEje Pr 0')  
  SetFont(a:FAC..d:fac, 2)

  IFA
  ACT(a:FAC, 'TB725')
  ACT(b:FAC, 'T0453700')
  ACN(c:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' "))
  ACN(d:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' and Estrategia = 'APROPIAEC' "))
  if Val(d:FAC)=0
    IF Dialogo.Check1=1
      Cancelar('Error en movimientos operacion '~Val(b:FAC)~'. Puede ser que el ajuste ya se haya ejecutado.')
    else
      MessageBox('Error en movimientos operacion '~Val(b:FAC)~'. Puede ser que el ajuste ya se haya ejecutado.')
    endif
  endif
  SetFont(a:2..d:fac, 1)

  IF Dialogo.Check1=1
    SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
    SQL.ADD("FechaMov,    Cliente, ")
    SQL.ADD("Vehiculo,    Sector, ")
    SQL.ADD("NrSaldo,     Especie, ")
    SQL.ADD("PrecioEj,    FechaEj, ")
    SQL.ADD("Cantidad,    Precio, ")
    SQL.ADD("Estrategia,  Book, ")
    SQL.ADD("TipoNegocio, NrOperacion, ")
    SQL.ADD("Cupon,       Tipo ) ")
    SQL.ADD("SELECT FechaMov, Cliente, ")
    SQL.ADD("       Vehiculo, Sector, ")
    SQL.ADD("       NrSaldo, Especie, ")
    SQL.ADD("       PrecioEj, FechaEj, ")
    SQL.ADD("       Cantidad, Precio, ")
    SQL.ADD("       'APROEUTB', Book, ")
    SQL.ADD("       TipoNegocio, NrOperacion, ")
    SQL.ADD("       Cupon, Tipo ") 
    SQL.ADD("  from "~DBO~".MOVPOSEJE ")
    SQL.ADD(" WHERE Especie     = '"~Val(a:FAC)~"' ")
    SQL.ADD("   AND NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.ADD("   AND Estrategia = 'APROPIAEC' ")
    SQL.NEW

    SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
    SQL.ADD(" WHERE Especie     = '"~Val(a:FAC)~"' ")
    SQL.ADD("   AND NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.ADD("   AND Estrategia = 'APROPIAEC' ")
    SQL.NEW
   
    SQL.EXEC
    MessageBox('Ajuste '~Val(a:FAC)~' - '~Val(b:FAC)~' realizado.')
  endif
endif

