** BPJ25 **
IF Dialogo.Radio1=3
  SetFilaActual(1)
  ACT(a:FAC, 'Especie')  
  ACT(b:FAC, 'Operacion')  
  ACT(c:FAC, 'MovsPosEje')  
  ACT(d:FAC, 'MPEje Pr 0')  
  SetFont(a:FAC..d:fac, 2)

  IFA
  ACT(a:FAC, 'BPJ25')
  ACT(b:FAC, '')
  ACN(c:FAC, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE Especie = '"~Val(a:FAC)~"' and (CantidadFin>-0.01 and CantidadFin<0.01 and CantidadFin<>0 )"))
  ACN(d:FAC, SQL("Select Count(*) from "~DBO~".POSICIONES WHERE CantidadFin>-0.01 and CantidadFin<0.01 and CantidadFin<>0 "))
  if Val(d:FAC)=0
    IF Dialogo.Check1=1
      Cancelar('Error en Posiciones. Puede ser que el ajuste ya se haya ejecutado.')
    else
      MessageBox('Error en Posiciones. Puede ser que el ajuste ya se haya ejecutado.')
    endif
  endif
  SetFont(a:2..d:fac, 1)

  IF Dialogo.Check1=1
    SQL.ADD("Update "~DBO~".POSICIONES ")
    SQL.ADD("Set CantidadFin = 0 ")
    SQL.ADD("  from "~DBO~".POSICIONES ")
    SQL.ADD(" WHERE CantidadFin>-0.01 and CantidadFin<0.01 and CantidadFin<>0 ")
    SQL.NEW

    SQL.ADD("Update "~DBO~".POSICIONES ")
    SQL.ADD("Set CantidadIni = 0 ")
    SQL.ADD("  from "~DBO~".POSICIONES ")
    SQL.ADD(" WHERE CantidadIni>-0.01 and CantidadIni<0.01 and CantidadIni<>0 ")
    SQL.NEW

    SQL.EXEC
    MessageBox('Ajuste posiciones realizado.')
  endif
endif
