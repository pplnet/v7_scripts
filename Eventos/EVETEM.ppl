    SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.ADD("   AND Especie     = '"~Val(a:FAC)~"' ")
    SQL.ADD("   AND Cupon       = 3 ")
    SQL.NEW
   
    SQL.EXEC
    MessageBox('Ajuste MRCJO realizado.')
