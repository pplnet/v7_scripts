** FJL 16/04/24 - Issue 7206 - Ajuste Posiciones X18E4 y MRCJO
CrearDialogo
  Radio1 : 'Ajuste|X18E4|MRCJO|TV24D';;;;  ;  ;;;;0
  Check1 : 'Procesa'     ;;;;SI;SI;;;;1
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

IF Dialogo.Radio1=0
  SetFilaActual(1)
  ACT(a:FAC, 'Especie')  
  ACT(b:FAC, 'Operacion')  
  ACT(c:FAC, 'MovsPosPen')  
  ACT(d:FAC, 'MovsPosEje')  
  ACT(e:FAC, 'MovsPosEje 0')  
  ACT(f:FAC, 'MovsPosEje 1')  
  SetFont(a:FAC..F:fac, 2)

  IFA
  ACT(a:FAC, 'X18E4')
  ACN(c:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(a:FAC)~"' "))
  ACN(d:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' "))
  ACN(e:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and Cupon=0 "))
  ACN(f:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and Cupon=1 "))
 
  IFA
  ACT(a:FAC, 'X18E4')
  ACT(b:FAC, 'T0444420')
  ACN(c:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSPEN WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' "))
  ACN(d:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' "))
  ACN(e:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' and Cupon=0 "))
  ACN(f:FAC, SQL("Select Count(*) from "~DBO~".MOVPOSEJE WHERE Especie = '"~Val(a:FAC)~"' and NrOperacion = '"~Val(b:FAC)~"' and Cupon=1 "))
  if Val(f:FAC)=0
    IF Dialogo.Check1=1
      Cancelar('Error en movimientos especie '~Val(a:FAC)~'. Puede ser que el ajuste ya se haya ejecutado.')
    else
      MessageBox('Error en movimientos especie '~Val(a:FAC)~'. Puede ser que el ajuste ya se haya ejecutado.')
    endif
  endif
  SetFont(a:2..F:fac, 1)

  IF Dialogo.Check1=1
    SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
    SQL.ADD("FechaMov,    Cliente, ")
    SQL.ADD("Vehiculo,    Sector, ")
    SQL.ADD("NrSaldo,     Especie, ")
    SQL.ADD("PrecioEj,    FechaEj, ")
    SQL.ADD("Cantidad,    Precio, ")
    SQL.ADD("Estrategia,  Book, ")
    SQL.ADD("TipoNegocio, NrOperacion, ")
    SQL.ADD("Cupon,       Tipo ) ")
    SQL.ADD("SELECT FechaMov, Cliente, ")
    SQL.ADD("       Vehiculo, Sector, ")
    SQL.ADD("       NrSaldo, Especie, ")
    SQL.ADD("       PrecioEj, FechaEj, ")
    SQL.ADD("       Cantidad, Precio, ")
    SQL.ADD("       Estrategia, Book, ")
    SQL.ADD("       TipoNegocio, NrOperacion, ")
    SQL.ADD("       0, Tipo ") 
    SQL.ADD("  from "~DBO~".MOVPOSEJE ")
    SQL.ADD(" WHERE Especie     = '"~Val(a:FAC)~"' ")
    SQL.ADD("   AND NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.ADD("   AND Cupon       = 1 ")
    SQL.NEW

    SQL.ADD("Delete "~DBO~".MOVPOSEJE ")
    SQL.ADD(" WHERE Especie     = '"~Val(1:FAC)~"' ")
    SQL.ADD("   AND NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.ADD("   AND Cupon       = 1 ")
    SQL.NEW
   
    SQL.EXEC
    MessageBox('Ajuste X18E4 realizado.')
  endif

endif

