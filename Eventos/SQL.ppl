
CrearDialogo
  String : 'Sentencia SQL'
FinDialogo

if Not OK
  Cancelar("")
endif

ACT(a1, Dialogo.String)

SetFilaActual(3)
Recorrer (Val(a1))
  if fac=4
    ACN(z1, FieldCount)
    recorrer&i 1, Val(z1)
      ACT(&i:3, FieldNames[&i-1])
    proximo
  endif
  recorrer&i 1, FieldCount
    ACT(&i:fac, Fields[&i-1])  
  proximo
proximo

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')
SetFont(a1..Val(z1):3,1)
SetFont(a3..Val(z1):fac,2)
AgregarMarco(a3..Val(z1):3,2,0,13697023)
AgregarMarco(a4..Val(z1):fac,1)
LimitesVision(Val(z1):fac)
