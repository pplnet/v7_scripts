* HojaVisible(SI)
CrearDialogo
  Radio1 :'Dummy|Marcar|Anular|Desmarcar'  ;;;;;;;;;0
  NrOperacion1: '# Operación :'             ;;;;;;NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIC|TIV');'Debe ingresar una operacion TIC/TIV';NO;;;;;;iif(Dialogo.Radio1=0,"TipoOp in ('TIC','TIV') and IsNull(OpEsp,'0')='0' and NrOperacion in (Select NrOperacion from "~DBO~".OPERACIONESBITS where NrBit=11 and Valor=1)","TipoOp in ('TIC','TIV') and IsNull(OpEsp,'0')='1' and NrOperacion in (Select NrOperacion from "~DBO~".OPERACIONESBITS where NrBit=31 and Valor=1)")
  Check1 :'Porcesa'                         ;;;;NO;NO;;;;1
FinDialogo
If Not OK
  Cancelar('Evento Cancelado')
EndIf

if Dialogo.Radio1=0
  * Marcar Op
  if SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit=11 and Valor=1 ") = 0
    MessageBox('La operacion no esta en la instancia Carga Contingencia')
    ACN(x:1, 1)
  endif
  if Val(x:1)=0
    * No hay error
    MessageBox('La operacion '~Dialogo.NrOperacion1~' pasa a Anulacion Automatica')
    if Dialogo.Check1=1
      EjecutarEvento('ANUMOV',NrOperacion1=Dialogo.NrOperacion1)
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD("   SET OpEsp = '1' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 11 ")
      SQL.NEW
      ***** Pone la instancia 31 en 1
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '1' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 31 ")
      SQL.NEW
      ACT(y:1, 'Evento OPDUMY mueve a 31')
      SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
      SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Dialogo.NrOperacion1~"', 11, '"~USUARIOACTIVO~"', '"~Val(y:1)~"', "~SQLAhora~" )")
      SQL.NEW

      SQL.EXEC
    else
      MessageBox('Sin Procesar')
    endif
  endif
ENDIF

if Dialogo.Radio1=1
  * Anular Op Dummy
  if SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit=31 and Valor=1 ") = 0
    MessageBox('La operacion no esta en la instancia Anulacion Automatica')
    ACN(x:1, 1)
  endif
  if Val(x:1)=0
    * No hay error
    MessageBox('La operacion '~Dialogo.NrOperacion1~' pasa a Anulacion Manual')
    if Dialogo.Check1=1
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 31 ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '1' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 30 ")
      SQL.NEW
      ACT(y:1, 'Evento OPDUMY mueve a 30')
      SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
      SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Dialogo.NrOperacion1~"', 31, '"~USUARIOACTIVO~"', '"~Val(y:1)~"', "~SQLAhora~" )")
      SQL.NEW
      SQL.EXEC
    else
      MessageBox('Sin Procesar')
    endif
  endif
ENDIF

if Dialogo.Radio1=2
  * Desmarcar Op Dummy
  if SQL(" Select 1 From "~DBO~".OPERACIONESBITS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrBit=31 and Valor=1 ") = 0
    MessageBox('La operacion no esta en la instancia Anulacion Automatica')
    ACN(x:1, 1)
  endif
  if Val(x:1)=0
    * No hay error
    MessageBox('La operacion '~Dialogo.NrOperacion1~' pasa a Carga Contingencia')
    if Dialogo.Check1=1
      SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD("   SET OpEsp = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 31 ")
      SQL.NEW
      SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   SET Valor = '1' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
      SQL.ADD("   and NrBit = 11 ")
      SQL.NEW
      ACT(y:1, 'Evento OPDUMY mueve a 11')
      SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
      SQL.ADD(" (NrOperacion, NrInstancia, Usuario, Mensaje, Fecha) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Dialogo.NrOperacion1~"', 31, '"~USUARIOACTIVO~"', '"~Val(y:1)~"', "~SQLAhora~" )")
      SQL.NEW
      SQL.EXEC
      SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,SI,SI,NO,SI,NO)
      SQL.EXEC  

    else
      MessageBox('Sin Procesar')
    endif
  endif
ENDIF
