MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:      'Fecha'              ;1;;;;;;;;fsys
  Lista1:      'Vehiculos'          ;3;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Check1:      'Contab.Procesada'   ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('- Asientos Diferencia de Cambio - Saldos en Ctas Comitentes -')

let &fHasta (PriDeMes(Dialogo.Fecha1,SI)-1)
let &fDesde PriDeMes(&fHasta,SI)
let &monedaLocal Var('MONELOCA')
let &monedaExtranjera Var('MONEEXTR')
let &dolarBillete Var('DOLBILLETE')
let &dcAcumulada 0
let &priDeMes PriDeMes(Dialogo.Fecha1)
let &ultDiaMesAnt &priDeMes - 1

SQL.ADD(" SELECT Codigo FROM "~DBO~".MODELOSASIENTO MA WHERE TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDCFM'))~") AND Habilitado = 'SI' ")
SQL.ADD(" AND Entorno = '"~SIGLA~"' ")
If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND (( ")
    Recorrer&i 1,Elementos(Dialogo.Lista1)
        SQL.ADD(" '|'+rtrim(MA.Vehiculo)+'|' like '%|"~ItemLista(Dialogo.Lista1,&i)~"|%' ")
        If NOT Elementos(Dialogo.Lista1)=&i
            SQL.ADD(" OR ")
        EndIf
    Proximo
    SQL.ADD(") OR MA.Vehiculo is null OR MA.Vehiculo = '' OR MA.Vehiculo = ' ' )")    
Endif
Watch(sql.batch)
Recorrer SQL
*MessageBox('xx')
    dfa
    let &modelos &modelos~fbn('Codigo')~'|'
Proximo

SQL.ADD("Select Distinct S.EnteCustodia as 'Vehiculo', S.Cuenta, S.Especie as 'Moneda', V.Alias4 MonLocalVeh,S.Book ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where V.Codigo = S.EnteCustodia ")
SQL.ADD(" AND Round(S.Saldo, 2) <> 0")
If NoVAcio(Dialogo.Lista1)
     SQL.ADD(" and S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
ENDIF
SQL.ADD("and S.NrSaldo = 50 ")
SQL.ADD("and S.Especie <> '"~&monedalocal~"'")
SQL.ADD(" and S.Fecha IN (SELECT MAX(SD.Fecha) FROM "~DBO~".SALDOSDIA SD") 
SQL.ADD("                   WHERE SD.NrSaldo = S.NrSaldo  ")
SQL.ADD("                   AND SD.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   AND SD.Especie = S.Especie ")
SQL.ADD("                   AND SD.Cuenta = S.Cuenta ")
SQL.ADD("                   AND SD.Fecha  <= '"~IdxDate(&fHasta)~"') ")
SQL.ADD("Order By 1") 
Watch(sql.batch)
Recorrer SQL
    let &vehiculo fbn('Vehiculo')
    let &cuenta fbn('Cuenta')
    let &moneda fbn('Moneda')
    let &monLocVeh fbn('MonLocalVeh')
    let &dcAcumulada 0
    let &Book fbn['Book']
    let &tipo BuscarCampo('ESPECIES','Tipo','Codigo',&moneda)
    Recorrer&i &fDesde, &fHasta
        let &diaDC &i
        If DiaSem(&diaDC) > 1 Y DiaSem(&diaDC) < 7
            (.'DCSALC'.)
            let &dcAcumulada &dcAcumulada + &DC
*            IF &DC <> 0
*            MessageBox('3')
*            ENDIF
        Endif
    Proximo
    *MessageBox(Fstr(&dcAcumulada, 0, 2))
    IF &dcAcumulada <> 0
        Recorrer&k 1, Elementos(&modelos)
        SQL.ADD(" Select '"~&moneda~"' Especie, '"~&monedaLocal~"' Moneda, '"~&vehiculo~"' Vehiculo1, Comitente Cliente1, ")
            SQL.ADD(" '"~&monLocVeh~"' MonLocalVeh,'"~&Book~"' Book, ' ' NrOperacion,' ' TipoOp ,'"~&tipo~"' Tipo ")
            SQL.ADD(" From "~DBO~".CUENTAS ")
            SQL.ADD(" Where Codigo = '"~&cuenta~"' ")
            Recorrer SQL
                ACD(FV:1, &ultDiaMesAnt)
                ACT(VH:1, fbn('Vehiculo1'))
                (.'FECHAVALOR'.)
                ACN(CK:1, 0)
                IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
                    ACN(CK:1, 1)
                IF Vacio(SQL(" Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A,ASIENTOSCON1 A1 Where A.NrUnicoAsiento=A1.NrUnicoAsiento and A.Modelo = '"~ItemLista(&modelos,&k)~"' AND A1.Alias1 = '"~&moneda~"' AND A.Estado = 'E' AND (A.NrAsiento Is Null OR A.NrAsiento = '' OR A.NrAsiento = ' ') AND A.FechaValor = '"~IdxDate(Val(FV:1))~"' AND A.Vehiculo = '"~&vehiculo~"' "))
                        ACN(CK:1, 0)
                    ENDIF
                ENDIF
                IF Val(CK:1) = 0
                    Message(&vehiculo~' - Modelo: '~ItemLista(&modelos,&k))
                    let &modeloContable ItemLista(&modelos,&k)
                    SQL.GenerarAsientoOp(&modeloContable, '','','',810,Val(FV:1),&vehiculo,,,,,,'',,,,,,,fsys,Dialogo.Fecha1)
                    SQL.EXEC
                ENDIF
            Proximo
        Proximo
    ENDIF
Proximo
