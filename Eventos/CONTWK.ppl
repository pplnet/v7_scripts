***---Se chequea siempre si existe asiento anterior enviado
***---IF Eqstr(Var('CONTAPROCE'), 'SI')
    ACN(CK:1, 1)
***---ELSE
***---    ACN(CK:1, 0)
***---ENDIF

****              Barrera de habilitacion de proceso Contable Vrs Proceso SAP
IF Eqstr(Var('INTASIENTO'), 'SI')
      MESSAGEbOX ('Se esta ejecutando el proceso contable con SAP...Por favor intente en unos minutos',2,0)   
      Cancelar
ELSE
     ** Se coloca la variable GENASIENTO en SI para avisar/bloquear el proceso SAP  
     SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='SI' Where Codigo='GENASIENTO' ")
     SQL.NEW
     SQL.EXEC
ENDIF
***--- Borra movimientos puntuales en la tabla de MovPendientes (27-05-09) 
      SQL.ADD("DELETE "~DBO~".MOVPENDIENTES Where NrOperacion= '50001871' and NrMov ='8004' and NrGrupo2 ='5004'  ")             
      SQL.NEW
      SQL.EXEC
        
      SQL.ADD("DELETE "~DBO~".MOVPENDIENTES Where (NrOperacion= '50001651' and NrMov ='8002') or  ") 
      SQL.ADD("                                   (NrOperacion= '50001651' and NrMov ='8003') or  ") 
      SQL.ADD("                                   (NrOperacion= '50001651' and NrMov ='8102')     ")              
      SQL.NEW
      SQL.EXEC        


MessageBox ('Close Delete ')

