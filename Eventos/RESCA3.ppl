IF NO
CrearDialogo
  Especie1       :'Especie'    ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe Ingresar una Especie Válida';NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "  
  Fecha1         :'Record_Date';1;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha válida ';NO;FSys
  Fecha2         :'Fecha_Pago' ;3;2;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1;'Debe Ingresar una Fecha válida ';NO;FSys
  Cliente1       :'Cliente'    ;3;1;;;;[Vacio(Dialogo.Cliente1)] O [[[Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI')] O [Eqstr(Dialogo.Cliente1, Dialogo.Vehiculo1)]] Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB') Y Not Eqstr(BuscarCampo('CLIENTES','BloqueoFondos','Codigo',Dialogo.Cliente1), 'SI')];'Cliente Invalido';NO;;;;;;" Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) AND (CategDepositante='CLI' OR Codigo='"~Dialogo.Vehiculo1~"') ";
  Mercado1       :'Mercado'    ;5;2;;;;
  Operador1      :'Operador'   ;5;1;;NO;;NOVACIO(Dialogo.Operador1);'Debe Ingresar el Operador';NO;USUARIOACTIVO
  Vehiculo1      :'Vehiculo'   ;7;1;;;;NOVACIO(Dialogo.Vehiculo1);'Debe Ingresar el vehículo';NO;VAR('VEHICULODE');
  Radio1         : 'Anular|Novedad|Confirmacion|Todos|';7;2;;;;;;;;2  
FinDialogo
ENDIF

CrearDialogo
  Especie1       :'Especie'    ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe Ingresar una Especie Válida';NO;;;;;;" Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "  
  Fecha1         :'Record_Date';1;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha válida ';NO;FSys
  Fecha2         :'Fecha_Pago' ;2;2;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1;'Debe Ingresar una Fecha válida ';NO;FSys
  Cliente1       :'Cliente'    ;2;1;;;;[Vacio(Dialogo.Cliente1)] O [[[Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI')] O [Eqstr(Dialogo.Cliente1, Dialogo.Vehiculo1)]] Y Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB') Y Not Eqstr(BuscarCampo('CLIENTES','BloqueoFondos','Codigo',Dialogo.Cliente1), 'SI')];'Cliente Invalido';NO;;;;;;" Status='HAB' AND (BloqueoFondos = 'NO' OR BloqueoFondos Is Null) AND (CategDepositante='CLI' OR Codigo='"~Dialogo.Vehiculo1~"') ";
  Mercado1       :'Mercado'    ;3;1;;;;
  Radio1         : 'Anular|Novedad|Confirmacion|Todos|';4;1;;;;;;;;2  
