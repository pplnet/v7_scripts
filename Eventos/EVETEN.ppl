    recorrer SQL
      SCN(c:5, 1)
      ACT(aa:FAC, fbn('NrOperacion'))
      ACD(ab:FAC, fbn('FechaMov'))
      ACT(ac:FAC, fbn('Especie'))
      ACN(ad:FAC, fbn('NrSaldo'))
      ACT(ae:FAC, fbn('Sector'))
      ACT(af:FAC, fbn('Estrategia'))
      ACN(ag:FAC, fbn('Cantidad'))
      ACN(i:FAC, fbn('Cupon'))
    proximo
  endif
 
  SetFont(b:1..c:5,1)
  FormatoCeldas(b:3..c:5,Exe('F0'))
