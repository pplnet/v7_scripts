** FJL 13/12/2022 - Quitar marca CP a MLASA para cargar DTP solo Custodia
CrearDialogo
  Radio1 : 'CP|Sacar|Poner';;;;SI;SI;;;;0
  Check1 : 'Procesa'       ;;;;SI;SI;;;;0
FinDialogo
if not OK
  Cancelar
endif   

HojaVisible(SI) 

ACT(a:1, 'Cliente:')
ACT(a:2, 'Alias1 Act')
ACT(a:3, 'Alias1 Nue')

ACT(b:1, 'MLASA')
ACN(x:1, SQL("Select 1 from "~DBO~".CLIENTES where Codigo = '"~Val(b:1)~"'"))
if Val(x:1)=0
  Cancelar('No existe el cliente '~Val(b:1))
endif

ACT(b:2, BuscarCampo('CLIENTES','Alias1','Codigo',Val(b:1)))

SQL.ADD("Update "~DBO~".CLIENTES ")
if Dialogo.Radio1=0
  SQL.ADD(" Set Alias1= Null ")
else
  SQL.ADD(" Set Alias1= 'CP' ")
endif
SQL.ADD(" WHERE Codigo = '"~Val(b:1)~"' ")
SQL.NEW
SQL.EXEC

ACT(b:3, BuscarCampo('CLIENTES','Alias1','Codigo',Val(b:1)))

LimitesVision(d:5)
