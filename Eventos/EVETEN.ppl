  SetFont(a:1..a:5, 2)

  SetFilaActual(8)
  ACT(a:FAC, '# Oper')
  ACT(b:FAC, 'FechaMov')
  ACT(c:FAC, 'Especie')
  ACT(d:FAC, 'NrSaldo')
  ACT(e:FAC, 'Sector')
  ACT(f:FAC, 'Estrategia')
  ACT(g:FAC, 'Cantidad')
  ACT(h:FAC, 'Cup.Actual')
  ACT(i:FAC, 'Cup.Nuevo')
  SetFont(a:FAC..i:FAC, 2)
  ACN(w:1, FAC)
 
  SQL.ADD("Select * from "~DBO~".OPERACIONES WHERE NrOperacion='"~Val(b:1)~"' ")
  recorrer SQL
    DFA
    ACN(x:1, 1)
    ACT(b:2, fbn('Especie'))
    ACN(b:3, fbn('Cupon1'))
  proximo
  if Val(x:1)=0
    ACN(y:1, 1)
    ACT(c:1, 'Operacion No Encontrada')
    MessageBox('Operacion '~Val(b:1)~' No Encontrada.')
  endif
 
  if Val(y:1)=0
    if Val(b:3)<>33
      ACN(y:1, 1)
      ACT(c:3, 'Cupon invalido')
      MessageBox('Por los datos encontrados el ajuste de '~Val(b:2)~' ya fue ejecutado.')
    endif
  endif

  if Val(y:1)=0
    * No hubo errores
    SetFilaActual(Val(w:1))
    SQL.ADD("Select * from "~DBO~".MOVPOSEJE ")
    SQL.ADD("WHERE NrOperacion= '"~Val(b:1)~"' ")
    SQL.ADD("  and Especie    = '"~Val(b:2)~"' ")
    SQL.ADD(" order by Especie,NrSaldo,Sector,Estrategia,Cupon ")
    recorrer SQL
      SCN(b:5, 1)
      ACT(a:FAC, fbn('NrOperacion'))
      ACD(b:FAC, fbn('FechaMov'))
      ACT(c:FAC, fbn('Especie'))
      ACN(d:FAC, fbn('NrSaldo'))
