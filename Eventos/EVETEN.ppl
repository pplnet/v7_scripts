    SetFont(a:Val(w:1)+1..ag:FAC,1)
    FormatoCeldas(d:Val(w:1)+1..d:FAC,Exe('F0'))
    FormatoCeldas(g:Val(w:1)+1..g:FAC,Exe('F2'))
