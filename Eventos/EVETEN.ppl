      ACT(f:FAC, fbn('Estrategia'))
      ACN(g:FAC, fbn('Cantidad'))
      ACN(h:FAC, fbn('Cupon'))
    proximo
    if Val(b:5)=0
      ACN(y:1, 1)
      ACT(c:5, 'No existen MovPosEje')
    endif
  endif

  if Val(y:1)=0
    * No hubo errores
    if Dialogo.Check1=1
      SQL.ADD("UPDATE "~DBO~".OPERACIONES  ")
      SQL.ADD("   SET Cupon1 = 34 ")
      SQL.ADD("WHERE NrOperacion = '"~Val(b:1)~"' ")
      SQL.NEW

      SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
      SQL.ADD("FechaMov,    Cliente, ")
      SQL.ADD("Vehiculo,    Sector, ")
      SQL.ADD("NrSaldo,     Especie, ")
      SQL.ADD("PrecioEj,    FechaEj, ")
      SQL.ADD("Cantidad,    Precio, ")
      SQL.ADD("Estrategia,  Book, ")
      SQL.ADD("TipoNegocio, NrOperacion, ")
