MostrarCuadrodeMensajes
** AA 17/06/21 - Corregir saldo LIMCONSUMIDOS 
CrearDialogo
  Check1 : 'Procesa'                ;;;;;;;;;0
FinDialogo
if not OK
  Cancelar
endif   

  IF Dialogo.Check1=0
    HOJAVISIBLE(SI) 
  Endif   

  SetFilaActual(1)
  ACT(a:FAC, 'Limites consumidos')
  IFA
  ACT(a:FAC, 'Cliente')
  ACT(b:FAC, 'Limite')
  ACT(c:FAC, 'Monto')
  SQL.ADD("Select LC.Cliente , LC.limite , LC.Monto from "~DBO~".LIMCONSUMIDOS LC  where Cliente = 'BAT' and LC.Limite = 'VOLOPE' ")
  Recorrer SQL
     ACT(a:FAC, fbn('Cliente'))
     ACT(b:FAC, fbn('Limite'))
     messagebox (fbn('Monto'))
     IF Dialogo.Check1=1
        SQL.ADD("UPDATE "~DBO~".LIMCONSUMIDOS  ")
        SQL.ADD("   SET Monto = 0 ")
        SQL.ADD("WHERE Cliente = 'BAT' and Limite = 'VOLOPE'  ")
        SQL.NEW
        SQL.EXEC
     Endif
  proximo


IF NO


