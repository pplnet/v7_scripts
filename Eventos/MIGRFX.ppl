MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:  'Fecha Migracion';1;1; ;  ;  ;;;;fsys
  Check1:  'Procesa'        ;1;2; ;NO;NO;;;;1;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

message('Recuperando OpRofex...')
SQL.ADD("Select * from "~DBO~".OPROFEX")
SQL.ADD(" where isnull(Procesado,'0') = '0' ")
* FJL 16/11/18 - Criterio de Fecha para migracion - CONFIRMAR
*SQL.ADD("   and Convert(Date,FechaReal) = "~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and Convert(Date,Vto)     >= "~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and Convert(Date,Fecha)   <= "~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and TipoContrato          =  '1' ")
* FJL 16/11/18 - Agrego esta condicion - CONFIRMAR
SQL.ADD("   and isnull(Anulada,'NO')  = 'NO' ")
SQL.ADD("   and isnull(ExecId,'')  <> '' ")
SQL.ADD(" Order by Fecha,Boleta ")  
watch(sql.batch)
Recorrer SQL
   SCN(x:1, 1)
   Message('...'~fbn('Boleta'))
   ACT(aa:FAC, fbn('Boleta'))
   ACT(ab:FAC, fbn('Posicion'))
   
   **// Warning por default
   ACT(WA:1, 'Falta la posicion '~FBN('Posicion'))
   ACN(BD:1, 2)
** Ver si es necesaria esta fecha
   ACD(VT:1, FBN('Vto'))
   **// 
   SQL.ADD(" Select Especie, FechaVto, NombreExtendido ")
   SQL.ADD(" From "~DBO~".PLAZOSMERCADO ")
   SQL.ADD(" Where NombreExtendido = '"~FBN('Posicion')~"' ")
   Recorrer SQL
     DFA
     **// Marco que existe la posicion
     ACN(BD:1, 1)
     ACT(E:2, FBN('Especie'))
     ACT(E:1, SQL("SELECT ContraespecieCupon From "~DBO~".ESPECIES where Codigo='"~FBN('Especie')~"' "))
     ACT(E:3, FBN('Especie'))
     ACN(VT:2, FBN('FechaVto'))
     **// Si falta Especie FIX o MTM, no se genera la operacion
     If Vacio(Val(E:1)) O Vacio(Val(E:3))
       ACT(WA:1, 'Faltan datos en la posicion '~FBN('NombreExtendido'))
       ACN(BD:1, 2)
     Endif
   Proximo

   **// Si ya hay una operacion con ese numero de boleta, no se genera.
   If SQL("Select 1 from "~DBO~".OPERACIONES where FechaOp="~IdxDate2(fbn['Fecha'])~" and TipoOp In ('FXCF','FXVF','TICF','TIVF') and NrBoleto in ('"~PAD0(FBN['Boleta'],8)~"','"~FBN['Boleta']~"') ")=1
      ACN(BD:1, 3)
      ACT(WA:1, 'Ya existe operacion con NrBoleta '~PAD0(FBN('Boleta'),8)~'. ')
   else
     if DesciendeDeEspecie(Val(e:2),'TITULO') o DesciendeDeEspecie(Val(e:FAC),'CUPON')    
        ACN(BD:1, 4)
        ACT(WA:1, 'Operacion de Titulos '~val(e:2)~'. ')
     endif
   Endif
   ACN(ac:FAC, Val(bd:1))
   If Val(BD:1)=1 
      **// TipoOP
      ACT(TO:1, iif(FBN('IdCpraVta')=1,'FXVF','FXCF') )
      **// MB1 - Frec. Liq
      ACN(FR:1,0)
      **// Cliente1 - Cliente
      ACT(CL:1,Var('VEHICULODE'))
      **// Mercado3 - Mdo. Liq. Especie
      ACT(ME:3,MercadoDef(Val(E:2)))
      **// FormaLiquidacion1
      ACN(FL:1,0)
      **// FormaLiquidacion2
      ACN(FL:2,IIF(Incluido(VAL(ME:3),VAR('MERCAVARI')),1,0))
      **// CB9 - Cliente No Lim
      ACN(CL:2,SQL("Select 1 from "~DBO~".CLIENTES where Codigo='"~Val(CL:1)~"' and (Alias1='CP') "))
      **// Book1 - Cartera
** FJL 11/12/18 - Se cambia la logica de book default para mercado ROFEX
*      ACT(BK:1,BookDefault2(VAR('VEHICULODE'),Val(TO:1),'',Val(e:2),'','','','','HAB'))
      ACT(BK:1, VAR('BOOKMRFM'))
      **// Cliente3 - Controlante
      ACT(CL:3,IIF(NoVacio(Val(BK:1)),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~Val(CL:1)~"' "),''))
      **// Razon Social
      ACT(RZ:1, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',Var('CLIROFEX')),1,25))
** FJL 12/12/18 - Se cambia la logica por cambio API ROFEX
*      **// Cantidad - Importe
*      ACN(IM:1, FBN('Cantidad') * BuscarCampo('ESPECIES','TamanioLote','Codigo',Val(E:3)))
      **// TotalBrutoCli3 - Cant.Contratos
      ACN(IM:1, FBN('Cantidad') / BuscarCampo('MERCADOS','TamanioLote','Codigo',VAR('MERROFEX')))
      **// FechaVto - Fecha de vencimiento
      ACD(FV:1, IIF(Val(VT:2)=0,Habiles(FBN('Fecha'),1000,VAR('FERIDEF')),Val(VT:1)))
      **// TotalBrutoCli1 - Monto 
      ACN(A:1, FBN('Precio') * Val(IM:1))
      **// Plazo
      ACN(PL:1, Val(FV:1)-FBN('Fecha'))
      **// FechaPago - Fecha Liq. Mon. Pago 
      ACD(FP:1, Habiles(Val(FV:1),0,VAR('FERIDEF')))
      **// FechaVto2 - Fecha Valuacion 
      ACD(FV:2,Habiles(Val(FP:1),-2,VAR('FERIDEF'),SI))
      **/ Plazo2 - PlazoLiq de la moneda
      **// queda fijo plazo en horas --> cambiar 0 Cero por PlazoLiq de la moneda --> Plazo2
      ACN(PL:2,0)
      **// FechaPrecan - Fecha Liquidacion
      ACD(FQ:1,Habiles(Val(FV:1),(Val(PL:1) DIV 24),VAR('FERIDEF'),SI))
      **// PrecioMer - C.CEsp ARP 
      ACN(A:6,1)
      **// TipoCambio2 - Precio Mercado
      ACN(A:7, COTIZACIONC(Val(E:3),'FUT',Val(FV:1),,FBN('Fecha'),1,SI,VAR('MONELOCA')))
      **// ModoCotiza - Modo Directa|Inversa
      ACT(A:13, IIF(EqStr(Modo(Val(E:2),CotizaEn(Val(E:2))),'DIR'),'0','1'))
      **// PorDerechoBolsa - C.Esp ARP
      ACN(A:14,IIF(Eqstr(VAR('MONELOCA'),CotizaEn(Val(E:2))),1,CotizacionC(VAR('MONELOCA'),,,,FBN('Fecha'),1,SI,CotizaEn(Val(E:2))) ))
      **// PorCaucion - RsikWeighting
      ACN(A:15,IIF(NoVacio(Val(BK:1)),("Select Factor from "~DBO~".RISKWEIGHT where Especie = 'USD' and TipoOp = '"~Val(TO:1)~"' and Fecha <= '"~IdxDate(FBN('Fecha'))~"' order by Fecha desc"),0))
      **// TotalAux5 - PreSettlement
      ACN(TO:5,IIF(NoVacio(Val(BK:1)),Val(IM:1)*iif(Val(A:15)=0,1,Val(a:15)/100),0))
      **// MinDerechoBolsa - Ex. Pres  *** Ver tema cliente y si se genera negativo cuando no hay asignado
      ACN(LM:1, LimAsignado(Val(CL:1),'PRESETTLEM',Val(E:2),VAR('VEHICULODE')))
      ACN(LM:2, LimConsumido(Val(CL:1),'PRESETTLEM',Val(E:2),0,VAR('VEHICULODE'),,,''))
      IF NoVacio(Val(BK:1))
         ACN(A:17, Val(LM:1)-(Val(LM:2)+Val(TO:5)))
      Endif
**      IF NoVacio(Val(BK:1)) Y NOT[Val(A:17)<0]      
**         ACN(A:17, 0)
**      Endif      
      **// Mercado2 - Mercado de la ContraEspecie
*      ACT(A:20,MercadoDef(VAR('MONELOCA')))
      ACT(A:20,VAR('MERROFEX'))
      **// MB4 - Liquida MTM
      ACN(MT:1,BuscarCampo('MERCADOS','MTM','Codigo',VAR('MERROFEX')))
      **// RB10 - Tipo Fut
      ACN(TF:1,1)
      **// MB6 - Origen FPA|OPEX|Altamira|Siopel|OCT 
      ACN(OR:1,4)
      **// TotalAux5 - PreSettlement
      ACN(TO:5,IIF(NoVacio(Val(BK:1)),Val(IM:1)*iif(Val(A:15)=0,1,Val(a:15)/100),0))
      **// Cuenta1 Cta.Esp.CLI
      ACT(CT:1,'')
      **// Cuenta2 Cta.Esp.VEH
      ACT(CT:2,'')      
      **// Cuenta3 Cta.Mon.VEH
      ACN(CO:3,SQL("Select Count(*) from "~DBO~".CUENTAS Where Cliente = '"~VAR('VEHICULODE')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      If VAl(CO:3)=1
      ACT(CT:3,SQL("Select Codigo from "~DBO~".CUENTAS Where Cliente = '"~VAR('VEHICULODE')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      Endif
      **// Cuenta4 Cta.Mon.CLI
      ACN(CO:4,SQL("Select Count(*) from "~DBO~".CUENTAS Where Cliente = '"~Val(CL:1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      If VAl(CO:4)=1
         ACT(CT:4,SQL("Select Codigo from "~DBO~".CUENTAS Where Cliente = '"~Val(CL:1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      Endif

      **// Instancia 7-Confirmacion 10- Liquidacion
      **// verificar si tienen cuentas definidas: Ok va a 10 else a 7
      If Vacio(CT:3) o Vacio(CT:4)
         ACN(IN:1, 7)
      Else
         ACN(IN:1, 10)
      Endif

     ACT(ad:FAC, 'OK')
     SCN(x:2, 1)
     IF Dialogo.Check1=1
       SCN(x:3, 1)
       **// NrOperacion
       ACT(NR:1, GetNumerador(51))
       ACT(ae:FAC, Val(nr:1))
       SQL.ADD(" Insert INTO "~DBO~".OPERACIONES                                          ")
       SQL.ADD(" ( TipoOp,            NrOperacion,       FechaOp,         Especie,        ")
       SQL.ADD("   MB1,               MB2,               Cliente1,        Mercado3,       ")
       SQL.ADD("   FormaLiquidacion1, FormaLiquidacion2, TotalBrutoCli3,  Cantidad,       ")
       SQL.ADD("   Precio1,           Book1,             Cliente3,        TipoCambio,     ")
       SQL.ADD("   TotalBrutoCli1,    ContraEspecie,     Plazo,           Plazo2,         ")
       SQL.ADD("   FechaVto,          FechaPago,         NrBoleto,        Mercado2,       ")
       SQL.ADD("   Mercado,           TablaFeriados1,    Observac2,       PrecioMer,      ")
       SQL.ADD("   TipoCambio2,       CB9,               RB5,             MB4,            ")
       SQL.ADD("   MB6,               Operador,          Vehiculo1,       ModoCotiza,     ")
       SQL.ADD("   TotalAux2,         TotalAux3,         PorDerechoBolsa, FechaEj,        ")
       SQL.ADD("   Precio2,           FechaVto2,         CB6,             FechaOp2,       ")
       SQL.ADD("   ContraEspecie2,    FechaPrecan,       Observac3,       FechaAltaMAE,   ")
       SQL.ADD("   MinDerechoBolsa,   Cliente2,          RB3,             MB3,            ")
       SQL.ADD("   PorCaucion,        TotalAux5,         RB10,            Observaciones,  ")
       SQL.ADD("   Cuenta1,           Cuenta2,           Cuenta3,         Cuenta4,        ")
       SQL.ADD("   UsrInput,          FechaCarga,        FechaCargaSys,   Direccion,      ")
       SQL.ADD("   LInstancia,        Numerador,         Mercado4,        ObservacDoc     ")
* FJL 16/11/18 - Agrego marca de Migracion para poder anularla.
       SQL.ADD(" , CB7 ")
       
       SQL.ADD(" ) Values ( ")

       * TipoOp
       SQL.ADD("   '"~Val(TO:1)~"',             '"~Val(NR:1)~"',          "~IdxDate2(FBN('Fecha'))~",     '"~Val(E:2)~"',                   ")
       * MB1
       SQL.ADD("   "~Fstr(Val(FR:1),0,0)~",     0,                        '"~Val(CL:1)~"',                '"~Val(ME:3)~"',                  ")
       * FormaLiquidacion1
** FJL 12/12/18 - Se cambia la logica por cambio API ROFEX
*       SQL.ADD("   "~Fstr(Val(FL:1),0,0)~",     "~Fstr(Val(FL:2),0,0)~",  "~Fstr(FBN('Cantidad'),0,2)~",  "~Fstr(Val(IM:1),0,2)~",          ")
       SQL.ADD("   "~Fstr(Val(FL:1),0,0)~",     "~Fstr(Val(FL:2),0,0)~",  "~Fstr(Val(IM:1),0,2)~",        "~Fstr(FBN('Cantidad'),0,2)~",         ")
       * Precio1
       SQL.ADD("   "~Fstr(FBN('Precio'),0,8)~", '"~Val(BK:1)~"',          '"~Val(CL:3)~"',                "~Fstr(FBN('Precio'),0,8)~",      ")
       * TotalBrutoCli1
       SQL.ADD("   "~Fstr(Val(A:1),0,2)~",      '"~VAR('MONELOCA')~"',    "~Fstr(Val(PL:1),0,0)~",         "~Fstr(Val(PL:2),0,0)~",         ")
       * FechaVto
       SQL.ADD("   "~IdxDate2(Val(FV:1))~",     "~IdxDate2(Val(FP:1))~",  '"~PAD0(FBN('Boleta'),8)~"',    '"~Val(A:20)~"',                  ")    
       * Mercado
       SQL.ADD("   '"~VAR('MERROFEX')~"',       '"~VAR('FERIDEF')~"',     '',                             "~Fstr(Val(A:6),0,8)~",           ")
       * TipoCambio2
       SQL.ADD("   "~Fstr(FBN('Precio'),0,8)~", "~Fstr(Val(CL:2),0,0)~",  0,                              "~Fstr(Val(MT:1),0,0)~",          ")
       * MB6
       SQL.ADD("   "~Fstr(Val(OR:1),0,0)~",     '"~USUARIOACTIVO~"',      '"~VAR('VEHICULODE')~"',        '"~Val(A:13)~"',                  ")
       * TotalAux2
       SQL.ADD("   0,                            0,                       "~Fstr(Val(A:14),0,8)~",         null,                            ")
       * Precio2
       SQL.ADD("   0,                            "~IdxDate2(Val(FV:2))~", 0,                               "~IdxDate2(FSYS)~",              ")
       * ContraEspecie2
       SQL.ADD("   '"~Val(E:1)~"',               "~IdxDate2(Val(FQ:1))~", null,                            "~IdxDate2(FBN('Fecha'))~",      ")
       * MinDerechoBolsa
       SQL.ADD("   "~Fstr(Val(A:17),0,2)~",      '"~Val(CL:1)~"',         0,                               0,                               ")
       * PorCaucion
       SQL.ADD("   "~Fstr(Val(A:15),0,8)~",      "~Fstr(Val(TO:5),0,2)~", "~Fstr(Val(TF:1),0,0)~",         'GENRFX - Generado Automatico',  ")
       * Cuenta1
       SQL.ADD("   '"~Val(CT:1)~"',              '"~Val(CT:2)~"',         '"~Val(CT:3)~"',                 '"~Val(CT:4)~"',                 ")      
       * UseInput
       SQL.ADD("   '"~USUARIOACTIVO~"',          "~SQLAhora~",            "~IdxDate2(FSYS)~",              2,                               ")
       * LInstancia
       SQL.ADD("   1,                            51,                      '"~VAR('MERROFEX')~"',           '"~FBN('Posicion')~"'            ")
* FJL 16/11/18 - Agrego marca de Migracion para poder anularla.
       SQL.ADD(" , 1 ")
       SQL.ADD(" ) ")
       SQL.NEW
       SQL.EXEC
   
       Message('     Se genero '~Val(NR:1))
       SQL.ADD(" Update "~DBO~".OPROFEX ")
       SQL.ADD("    Set Procesado = '1', NrOperacion = '"~Val(NR:1)~"', Warning = 'Migracion' ")
       SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
       SQL.NEW
       SQL.EXEC
      
       ModificarOperacion(Val(NR:1),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,0,NO,NO)      
       **// Instancia Inicial
      
       ACT(az3,Val(NR:1))
       ACT(az4,'OPERACIONES')
       ACN(az5,10)
       ACN(az6,0)
       (.'MODIINSTAN'.) 
     endif      
   Else
     Message('     No se genero la OP')
     IF Dialogo.Check1=1
       SQL.ADD(" Update "~DBO~".OPROFEX ")
       SQL.ADD("    Set Procesado='0', Warning= '"~Trim(Copy(Val(WA:1),1,255))~"' ")
       SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
       SQL.NEW
       SQL.EXEC
     endif      
   Endif
Proximo
ACN(y:1, FAC)

if Val(x:3)=0
  MessageBox('El evento finalizo correctamente. No se inserto ninguna operacion')
endif
if Val(x:3)=1
  MessageBox('El evento finalizo correctamente. Se inserto 1 operacion')
endif
if Val(x:3)>1
  MessageBox('El evento finalizo correctamente. Se insertaron '~PYC(Val(x:3),1,0)~' operaciones')
endif
