

SQL.ADD("Select NrTrans from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" where TipoTr2 In ('LIQOCT','OCTDEP','OCTRET') ")
SQL.ADD("    or (TipoTr2 In ('FXDEP','FXRET','FXCOMP') and CB10='1') ")
SQL.ADD("    or TipoTr2 In ('TRANSP') ")
SQL.ADD("  Order by NrTrans ")
Recorrer SQL
  Message(fbn('NrTrans'))
  SCN(c:1,1)  
  *Transaccion  

    *** desafecto movimientos ***
    SQL.ADD(" DELETE from  "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW

    SQL.ADD(" DELETE from  "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Where NrTrans2 = '"~fbn['NrTrans']~"' ")
    SQL.NEW
  
    SQL.ADD(" DELETE from  "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW

    SQL.ADD(" DELETE from  "~DBO~".MOVEJECUTADOS ")
    SQL.ADD(" Where NrTrans2 = '"~fbn['NrTrans']~"' ")
    SQL.NEW
    
    SQL.ADD(" DELETE from  "~DBO~".MOVPOSEJE ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW
  
    SQL.ADD(" DELETE from  "~DBO~".MOVPOSPEN ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW
  
    *** desafecto posicion
    SQL.ADD(" DELETE from  "~DBO~".MOVCASHFLOW ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW
  
    *** desafecto limites ***
    SQL.ADD(" DELETE from  "~DBO~".MOVLIMITES ")
    SQL.ADD(" Where NrOperacion = '"~fbn['NrTrans']~"' ")
    SQL.NEW
    SQL.EXEC
  
    SQL.ADD("Delete from "~DBO~".TRANSACCIONES2 ")
    SQL.ADD("where NrTrans ='"~fbn['NrTrans']~"'")
    SQL.NEW
  
    SQL.EXEC
Proximo

