HojaVisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1 : 'Fecha'        ;1;1;;  ;;Dialogo.Fecha1<=Fsys;'La Fecha DEBE ser menor o igual a la fecha del sistema';NO;FSys-Dia(FSys)
  Fecha2 : 'UltHabil'     ;1;2;;NO;NO;;;;;FindeMes(Dialogo.Fecha1,NO,Var('FERIDEF'))
  Fecha3 : 'FechaAccion'  ;2;2;;NO;NO;;;;;FindeMes(Dialogo.Fecha2+4,NO,Var('FERIDEF'))
  Check1 : 'Ajustes'      ;2;1;;;;;;;1

  Radio1 : 'Genera_txt?|SI|NO' ;3;1;;;;;;;0;IIF(MODI,Dialogo.Radio1,0)
  String : 'Arch.Output'; ; ;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 o NoVacio(Dialogo.String) ;'Debe especificar un Archivo Output Ef.Min Plazo Fijo' ;NO;;VAR('PATHCAPMIN')~'ICAPMIN-'   ~Fecha(Dialogo.Fecha1,'yyyymm')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
  **String : 'Arch.Output'; ; ;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 o NoVacio(Dialogo.String) ;'Debe especificar un Archivo Output Ef.Min Plazo Fijo' ;NO;;'C:\FPA\CNV731\ICAPMIN-'   ~Fecha(Dialogo.Fecha1,'yyyymm')~'.TXT';;;'!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
FinDialogo


If Not OK
   Cancelar
Endif


*-Fecha ------- 
ACT(fe:1,Fecha(Dialogo.Fecha1,'yyyymmdd'))

*Se informa
ACT(tb:2,iif(Dialogo.Radio1=0,'SI','NO'))

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")
CrearFont(4,"Arial,9,B")
CrearFont(5,"Arial,11,B")

* Borro Archivos Anteriores
IF Dialogo.Radio1=0 y ExisteArchivo(Dialogo.String) 
   BorrarArchivo(Dialogo.String)
EndIf

* Creo el archivo 
IF Dialogo.Radio1=0 
   ACT(aa1, Dialogo.String)
   Message('Creando Archivo '~Dialogo.String)
   AbrirASCII(val(aa1),0)
EndIf

AgregarBMP(a1,EXE('LOGO'),80)

SetFilaActual(3)
ACT(k:fac,'Interfaz Capitales Minimos al '~Dialogo.Fecha1)
SetFont(k:fac, 3)

If Dialogo.Check1=1
   ACT(e:fac,'Incorpora Mov. de Ajuste')
else
   ACT(e:fac,'Sin Mov. de Ajuste')   
Endif
SetFont(e:fac, 2)

If NoVacio(Dialogo.String)
   ACT(r:fac,Dialogo.String)
   SetFont(r:fac, 2)
Endif

*---Encabezado ---------------------------------------
SetFilaActual(fac+2)
ACT(a:fac  , 'Fecha')
ACT(b:fac  , 'Rub.Contable')
ACT(c:fac  , 'Issuer')
ACT(d:fac  , 'Tipo')
ACT(e:fac  , 'Cod.Siscen')
ACT(f:fac  , 'Especie')
ACT(g:fac  , 'Cod.Alfa CNV')
ACT(h:fac  , 'Cod.MAE Contado')
ACT(i:fac  , 'Cod.Num CNV')
ACT(j:fac  , 'Nombre')
ACT(k:fac  , 'Extendido')
ACT(l:fac  , 'Mon.Emision')
ACT(m:fac  , 'Indexado')
ACT(n:fac  , 'Indice')
ACT(o:fac  , 'Tasa')
ACT(p:fac  , 'Fecha Vto.')
ACT(q:fac  , 'Fecha Prox.Corte')
ACT(r:fac  , 'TNA Cupon')
ACT(s:fac  , 'Valor Contable')
ACT(t:fac  , 'Contable Valuado')
ACT(u:fac  , 'Cotizacion')
ACT(v:fac  , 'Accion')
ACT(w:fac  , 'Cotiza en')
ACT(x:fac  , 'ISIN')
ACT(y:fac  , 'Cupon')
ACT(z:fac  , 'Fec.Posicion')
ACT(aa:fac  , 'Especie')
ACT(ab:fac  , 'Nom. Cuenta')
ACT(ac:fac  , 'Nombre')
ACT(ad:fac  , 'Mercado')
ACT(ae:fac  , 'Cliente')
ACT(af:fac  , 'Cuenta')
ACT(ag:fac  , 'Saldo')


AlinearCeldas(a:fac..z:fac, 'C')
SetFont(a:fac..ag:fac, 2)
AgregarMarco(a:fac..b:fac,1,2,EXE('COLOR8'))
AgregarMarco(c:fac..t:fac,1,2,EXE('COLOR6'))
AgregarMarco(u:fac..u:fac,1,2,EXE('COLOR8'))
AgregarMarco(v:fac..v:fac,1,2,EXE('COLOR6'))
AgregarMarco(w:fac..y:fac,1,2,EXE('COLOR11'))
AgregarMarco(z:fac..aa:fac,1,2,EXE('COLOR8'))
AgregarMarco(ab:fac..ag:fac,1,2,EXE('COLOR9'))

SetFilaActual(fac+1)
ACN(RE:1, FAC+1)

if Dialogo.Check1=1
SQL.ADD("select * from ( ")
endif
SQL.ADD("select '1' TipoReg,DT.Fecha, DT.Especie, Case when DT.TipCupon='' then '0' else DT.TipCupon end TipCupon, DT.Valorresidual Residual, DT.CuentaContable CuentaContable, DT.ValorContable Contable, ")
SQL.ADD("DT.ValorContValuado ContValuado, DT.FecIncorporacion FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, FechaInicioTenencia FTenencia,")
SQL.ADD("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, extendido, MonedaEmision, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo TipoE, ")
SQL.ADD("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%'Then 'SI' else 'NO' end Accion, ISIN, ISSUER, TasaCER, Indice, Cupon,  ")
SQL.ADD("ESP.Indexado, DT.Cotizacion, DT.CuentaCustodia, CT.Nombre NombreCta, CT.Mercado, CT.Cliente ClienteCTA ")
SQL.ADD(" From "~DBO~".CAPITALESMINIMOS DT  ")
SQL.ADD("      inner  join "~DBO~".CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable ")
SQL.ADD("      inner join "~DBO~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
**SQL.ADD("      inner join "~DBO~".TIPOESPECIE T   on T.Codigo  = ESP.Tipo ")
SQL.ADD("      Left  join "~DBO~".CUENTAS CT   on CT.Codigo = DT.CuentaCustodia ")
** Se toman todos los registros 
**SQL.ADD("  and CO.Titofin='SI' ")
SQL.ADD("  and ValorContable <> 0  ")
SQL.ADD("  Where DT.Fecha = "~IdxDate2(Dialogo.Fecha1)~"  ")
if Dialogo.Check1=1
SQL.ADD("UNION ALL ")
SQL.ADD("select '2' TipoReg,DT.Fecha1, DT.Especie, DT.RB1 TipCupon, DT.Cantidad1 Valorresidual, DT.CuentaContable1 CuentaContable, DT.Cantidad2 ValorContable, ")
SQL.ADD("DT.Cantidad3 ValorContValuado, DT.Fecha2 FecIncorporacion, CO.Titofin, CO.Rubrocontable Rubrocontable, ESP.CodAlfCajaValores CodAlfCajaValores, FechaInicioTenencia FTenencia, ")
SQL.ADD("ESP.CodMAEContado, ESP.CodNumCajaValores, ESP.Fecha FVto, ESP.DenominCajaValores, ESP.ClaseCajaValores, ESP.Nombre, extendido, MonedaEmision, ESP.Cotiza, ESP.CodSISCEN, ESP.Tipo TipoE, ")
SQL.ADD("Case When ESP.Jerarquia LIKE '"~Var('JERACCION')~"%' or ESP.Jerarquia LIKE '"~Var('JERFONDOS')~"%' Then 'SI' else 'NO' end Accion, ISIN, ISSUER, TasaCER, Indice, Cupon,")
SQL.ADD("ESP.Indexado, DT.Precio1 Cotizacion, DT.Cuenta1 CuentaCustodia, '' NombreCta, '' Mercado, '' ClienteCTA ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 DT  ")
SQL.ADD("      inner join dbo.CONTABILIDAD CO   on CO.Codigo  = DT.CuentaContable1 ")
SQL.ADD("      inner join "~DBO~".ESPECIES ESP  on ESP.Codigo = DT.Especie ")
**SQL.ADD("      Left  join "~DBO~".CUENTAS CT   on CT.Codigo = DT.Cuenta1 ")
SQL.ADD("  and  DT.TipoTr2='AJUTFI'")
SQL.ADD("  and CO.Titofin='SI' ")
SQL.ADD("  and cantidad2 <> 0  ")
SQL.ADD("  and DT.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
endif
if Dialogo.Check1=1
SQL.ADD("   ) as AUX ")
endif
SQL.ADD(" Order By Especie")

watch(SQL.Batch)

Recorrer SQL
    
    
    ACT(a:fac, Fecha(FBN['Fecha'],'YYYYMMDD')) 
    
    ACT(b:fac, Pad0(FBN['RubroContable'],6)) 
    
    ACT(c:fac, FBN['Issuer']) 
    
    ACT(d:fac,FBN['TipoE'])
    ACT(e:fac,FBN['CodSISCEN'] )
    ACT(f:fac,FBN['Especie'] )
    ACT(aa:fac,FBN['Especie'] )
    ACT(g:fac,FBN['CodAlfCajaValores'])
    ACT(h:fac,FBN['CodMAEContado'])
    ACT(i:fac,FBN['CodNumCajaValores'])
    ACT(j:fac,FBN['Nombre'] ) 
    ACT(k:fac,FBN['Extendido'] ) 
    ACT(l:fac,FBN['MonedaEmision'])
    ACT(m:fac,FBN['Indexado'])
    ACT(n:fac,FBN['Indice']) 
    ACT(o:fac,FBN['TasaCER'])
    if Eqstr(FBN['Accion'],'SI')  
       ACT(p:fac, Fecha(Dialogo.Fecha3,'YYYYMMDD') )
    else
       if Vacio(FBN['FVto'])
          ACT(p:fac, Fecha(Dialogo.Fecha3,'YYYYMMDD') )
       else
          ACT(p:fac, Fecha(FBN['FVto'],'YYYYMMDD') )
       endif
    endif    
    **Buscar fecha prox corte agendacupones
    ACT(qq:fac,SQL("select min(fechacorte) from "~DBO~".AGENDACUPONES A where Especie='"~FBN['Especie']~"' and A.FechaCorte > "~IdxDate2(Dialogo.Fecha1)~" "))
    if Vacio(val(qq:fac))
       ACT(q:fac,'00000000')
    else
       ACT(q:fac,Fecha(val(qq:fac),'YYYYMMDD'))
    endif

    **Buscar TNA cupon actual Agendacupones
    ACN(r:fac, SQL("select TNA from "~DBO~".AGENDACUPONES A where Especie='"~FBN['Especie']~"' and NrCupon = '"~FBN['CUPON']~"' "))
    FormatoCeldas(r:fac,Exe('F8'))
    **ACN(s:fac,FBN['Contable']/1000)
    ACN(s:fac,FBN['Contable'])
    FormatoCeldas(s:fac,Exe('F2'))
    ACT(ss:fac, iif(EqStr(Copy(Fstr(Val(s:fac),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(s:fac),0),2,Longitud(Val(s:fac))-1),10),Pad0(Fstr(Val(s:fac),0),11)))
    ACN(t:fac,FBN['ContValuado'])
    FormatoCeldas(t:fac,Exe('F2'))
    ACT(tt:fac, iif(EqStr(Copy(Fstr(Val(t:fac),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(t:fac),0),2,Longitud(Val(t:fac))-1),10),Pad0(Fstr(Val(t:fac),0),11)))    
    ACN(u:fac,FBN['Cotizacion'])
    FormatoCeldas(u:fac,Exe('F8'))
    ACT(v:fac,FBN['Accion'])
    ACT(w:fac,FBN['Cotiza'])
    ACT(x:fac,FBN['ISIN'])
    ACT(y:fac,FBN['CUPON'])
    ** Buscar fecha inicio posicion, verificar si fecha en especie esta vacia (cual es el campo???)
    if NoVacio(FBN['Ftenencia'])
       ACT(z:fac, Fecha(FBN['Ftenencia'],'YYYYMMDD'))
    else
       ACD(za:fac,SQL("select max(P.fecha) from "~DBO~".POSICIONES P where P.fecha <= "~IdxDate2(Dialogo.Fecha1)~"  AND P.Especie= '"~FBN['Especie']~"' and P.NrSaldo=122  "))
       ACD(zb:fac, SQL("select min(P.fecha) from "~DBO~".POSICIONES P where P.fecha <= "~IdxDate2(Val(za:fac))~"  AND P.Especie= '"~FBN['Especie']~"' and P.NrSaldo=122 and CantidadIni=0 "))
       ACT(z:fac, Fecha(Val(zb:fac),'YYYYMMDD'))
       if EqStr(val(z:fac),'19000101')
          ACT(z:fac, Fecha(Val(za:fac),'YYYYMMDD'))
       endif
    endif
    
    ACT(ab:fac,FBN['NombreCta'])
    ACT(ac:fac,FBN['Nombre'])
    ACT(ad:fac,FBN['Mercado'])
    ACT(ae:fac,FBN['ClienteCTA'])
    ACT(af:fac,FBN['CuentaCustodia'])
    ACN(ag:fac,FBN['ContValuado'])
    FormatoCeldas(t:fac,Exe('F2'))
    ACT(ga:fac, iif(EqStr(Copy(Fstr(Val(ag:fac),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(ag:fac),0),2,Longitud(Val(ag:fac))-1),10),Pad0(Fstr(Val(ag:fac),0),11)))       

  *AlinearCeldas(j:fac..l:fac,'C') 
   SetFont(a:fac..ag:fac, 2)
    FormatoCeldas(r:fac,Exe('F8'))

Proximo
ACN(RE:2, FAC)

If Val(RE:1)=Val(RE:2)
   *- NO encontro ningun registro
else
    ACT(es:1,'ESPECIE')
    
    **if no
       
    Recorrer&i Val(RE:1),Val(RE:2)
       if EqStr(Val(es:1),'ESPECIE')
          ACT(es:1,Val(f:&i))
          ACN(ca:1,0)
       endif
       if  EqStr(Val(es:1),Val(f:&i))
           SCN(ca:1,Val(s:&i))
           SCN(ca:2,Val(t:&i))
       else    
          *---- grabar linea TXT por corte de especie ----
          ACT(re:3, '')
          Recorrer&j 1,33
             if Vacio(val(re:3))
                ACT(re:3, Val(&j:&i-1)) 
             else
                if &j=19
                   ACT(ca:3, FSTR(Val(ca:1),0,2))
                   ACT(re:3, Val(re:3)~';'~Val(ca:3)) 
                else
                   if &j=20 o &j=33
                      ACT(ca:3, FSTR(Val(ca:2),0,2))
                      ACT(re:3, Val(re:3)~';'~Val(ca:3)) 
                   else
                      ACT(re:3, Val(re:3)~';'~Val(&j:&i-1)) 
                   endif
                endif
             endif
         Proximo
          ACN(ca:1,Val(s:&i))
          ACN(ca:2,Val(t:&i))
          ACT(es:1,Val(f:&i))
          If Not Eqstr(Val(tb:2),'NO')
             ACT(re:3, Val(re:3)~';')
             EscribirASCII(Val(re:3))
          Endif
       Endif
    Proximo   

    **endif   
   If Not Eqstr(Val(tb:2),'NO')
             ACT(re:3, '')
             Recorrer&j 1,33
             if Vacio(val(re:3))
                ACT(re:3, Val(&j:&i-1)) 
             else
                if &j=19
                   ACT(ca:3, FSTR(Val(ca:1),0,2))
                   ACT(re:3, Val(re:3)~';'~Val(ca:3)) 
                else
                  if &j=20 o &j=33
                     ACT(ca:3, FSTR(Val(ca:2),0,2))
                     ACT(re:3, Val(re:3)~';'~Val(ca:3)) 
                  else 
                     ACT(re:3, Val(re:3)~';'~Val(&j:&i-1))
                  endif
                endif
             endif
          Proximo
      ACT(re:3, Val(re:3)~';')
      EscribirASCII(Val(re:3))
   
   Endif
Endif   

CerrarASCII

