*-- Calcula Resultados por pago de Cupones de Titulos por rango de Fechas
CrearDialogo
  Fecha1:   'Fecha Desde' ;1;1;;;;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys;'Debe ingresar una Fecha Desde Valida';NO;FSys;
  Fecha2:   'Fecha Hasta' ;2;1;;;;Dialogo.Fecha1>=Dialogo.Fecha1 y Dialogo.Fecha2<=FSys];'Debe ingresar una Fecha Hasta Valida';NO;FSys;
  Check1:   'Procesa'     ;3;1;;NO;;;;;1
FinDialogo
If Not OK
  Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SQL.ADD(" Select NrTrans,TipoTr2,Especie,Especie1,Especie2,Fecha1 from "~DBO~".TRANSACCIONES2 ")
SQL.ADD("  where Fecha1 Between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("    and TipoTr2  in ('CCUPON','PCUPON') ")
SQL.ADD(" Order By Fecha1,NrTrans")
Recorrer SQL
  ACT(a:FAC, fbn('NrTrans'))
  ACT(b:FAC, fbn('TipoTr2'))
  ACT(c:FAC, fbn('Especie'))
  ACT(d:FAC, fbn('Especie1'))
  ACT(e:FAC, fbn('Especie2'))
  ACD(f:FAC, fbn('Fecha1'))
  EjecutarEvento('RESCUP',Radio2=0,NrTrans1=fbn('NrTrans'),Radio1=0,Fecha1=Dialogo.Fecha1,Check1=Dialogo.Check1)
proximo

if FAC>0
  SetFont(a:1..f:FAC,1)
endif
