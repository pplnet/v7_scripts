CrearDialogo
  NrOperacion1 : "Operacion"             ;1;1;;;;Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMPV|');'La Operacion seleccionada no es una Partida Vinculadas';NO;;
  Fecha3       : "A Partir de"           ;1;2;;;;NOVACIO(Dialogo.Fecha3) y Dialogo.Fecha3>=Fsys;'Fecha Incorrecta';NO;Fsys;
  Check1       : "Capital   ?"           ;3;1;;;;;;;;;
  Check2       : "Fecha Vto ?"           ;;;;;;;;;;;
  Check3       : "DayCount  ?"           ;;;;;;;;
  Check4       : "Tipo Tasa ?"           ;;;;;;;;;;;
  Check5       : "Spread    ?"           ;;;;;;;;;;;
  Check6       : "Tasa_IVA  ?"           ;3;2;;;;;;;;;
  Check7       : "UT IVA    ?"           ;;;;;;;;;;;
  Check8       : "Tasa_WH   ?"           ;;;;;;;;;;;
  Check9       : "UT WH     ?"           ;;;;;;;;;;;
  Check10      : "% Imp_Extr ?"           ;;;;;;;;;;;
  Cantidad2    : 'Capital Actual'        ;2;2;;NO;NO;;;;;BuscarCampo('Operaciones','TotalAux3','NrOperacion',Dialogo.NrOperacion1);
FinDialogo

If not Ok
 Cancelar
EndIf

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar("La Operacion "~Dialogo.NrOperacion1~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

SQL.ADD("Select * from "~DBO~".OPERACIONES where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL

   * Verifico que se encuentre en Back Office o Terminal
   ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~FBN['NrOperacion']~"' AND Valor='1'") )

   If VAL(X1)<>20 y VAL(X1)<>50
      *-- Busco la instancia actual
      Cancelar("La Operacion "~FBN['NrOperacion']~" Debe estar en BackOffice o Terminal. Instancia Actual="~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
   EndIf
Proximo


ACT(A1,Dialogo.NrOperacion1)
ACD(A2,Dialogo.Fecha3)
ACN(A3,Dialogo.Check1)
ACN(A4,Dialogo.Check2)
ACN(A5,Dialogo.Check3)
ACN(A6,Dialogo.Check4)
ACN(A7,Dialogo.Check5)
ACN(A8,Dialogo.Check6)
ACN(A9,Dialogo.Check7)
ACN(A10,Dialogo.Check8)
ACN(A11,Dialogo.Check9)
ACN(A12,Dialogo.Check10)
ACN(A21,Dialogo.Cantidad2)

If val(a3)+val(a4)+val(a5)+val(a6)+val(a7)+val(a8)+val(a9)+val(a10)+val(a11)+val(a12)=0
   Cancelar('No selecciono ningun cambio, El proceso sera Cancelado !!!')
EndIf
CrearDialogo
  NrOperacion1: "Operacion"          ;1;1;;NO;;;;;VAL(A1);
  Cantidad2   : 'Capital Actual'     ;2;2;;NO;VAL(a3)=1;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion1);
  Cantidad1   : 'Capital Nuevo'      ;2;1;;  ;VAL(a3)=1;Val(a3)=0 o [Dialogo.Cantidad1>=VAL(a21)] ;'El Nuevo Capital no debe ser Inferior al Capital Utilizado '~Fstr(val(a21),0,2);NO;;;
  Fecha2      : 'Vto Actual'         ;3;2;;NO;VAL(a4)=1;;;;;BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1);
  Fecha1      : 'Vto Nuevo'          ;3;1;;  ;VAL(a4)=1;VAL(a4)=0 o Dialogo.Fecha2<Dialogo.Fecha1;'El Nuevo Vencimiento debe ser Superior al Vencimiento Actual';NO;;;
  Radio2      : 'DC_Actual|ActAct|Act365F|Act360|360360|30E360'        ;4;1;;NO;VAL(a5)=1;;;;BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1);
  Radio1      : 'DC_Nuevo|ActAct|Act365F|Act360|360360|30E360'         ;5;1;;  ;VAL(a5)=1;VAL(a5)=0 o [Dialogo.Radio1>=0 y Dialogo.Radio1<>Dialogo.Radio2];'Day Count Incorrecto';NO;;
  TipoTasa2   : 'TTasa Actual'       ;6;2;;NO;VAL(a6)=1;;;;;BuscarCampo('Operaciones','TipoTasa','NrOperacion',Dialogo.NrOperacion1);
  TipoTasa1   : 'TTasa Nueva'        ;6;1;;  ;VAL(a6)=1;VAL(a6)=0 o [Not EqStr(Dialogo.TipoTasa1,Dialogo.TipoTasa2) y NoVacio(Dialogo.TipoTasa1)];'El Tipo de Tasa es Incorrecto';NO;;
  Precio2     : 'Spread Actual'      ;7;2;;NO;VAL(a7)=1 y [[NoVacio(Dialogo.TipoTasa1) y Not EqStr('FIJA',Dialogo.TipoTasa1)] o Not EqStr('FIJA',Dialogo.TipoTasa2)];;;;;BuscarCampo('Operaciones','Spread','NrOperacion',Dialogo.NrOperacion1);
  Precio1     : 'Spread Nuevo'       ;7;1;;  ;VAL(a7)=1 y [[NoVacio(Dialogo.TipoTasa1) y Not EqStr('FIJA',Dialogo.TipoTasa1)] o Not EqStr('FIJA',Dialogo.TipoTasa2)];;;NO;;Iif(EqStr('FIJA',Dialogo.TipoTasa1),0,Dialogo.Precio1);

  Precio4     : 'Tasa_IVA_Act'       ;9;2;;NO;Val(a8)=1 y [Dialogo.Radio6=0 o Dialogo.Radio6=2];;;;BuscarCampo('Operaciones','ImpGastos2','NrOperacion',Dialogo.NrOperacion1);
  Precio3     : 'Tasa_IVA_Nuevo'     ;9;1;;  ;Val(a8)=1 y [Dialogo.Radio6=0 o Dialogo.Radio6=2];Not [Val(a8)=1 y [Dialogo.Radio6=0 O Dialogo.Radio6=2]] o [Dialogo.Precio3<>Dialogo.Precio4 y Incluido(Fstr(Dialogo.Precio3,2,2),VAR('IVA'))];'El Valor de TASA IVA es Erroneo: '~VAR('IVA');NO;;;

  Radio8      : 'Ut IVA Act|360|365' ;10;2;;NO;Val(a9)=1 y [Dialogo.Radio6=0 O Dialogo.Radio6=2];;;;BuscarCampo('Operaciones','RB7','NrOperacion',Dialogo.NrOperacion1);
  Radio7      : 'Ut IVA Nue|360|365' ;10;1;;  ;Val(a9)=1 y [Dialogo.Radio6=0 O Dialogo.Radio6=2];Not [Val(a9)=1 y [Dialogo.Radio6=0 O Dialogo.Radio6=2]] o [Dialogo.Radio7<>Dialogo.Radio8 y Dialogo.Radio7>=0];'Unidad de Tiempo IVA Erroneo';NO;;;

  Precio6     : 'Tasa_WH_Act'        ;11;2;;NO;Val(a10)=1 y [Dialogo.Radio6=2];;;;BuscarCampo('Operaciones','TotalAux1','NrOperacion',Dialogo.NrOperacion1);
  Precio5     : 'Tasa_WH_Nuevo'      ;11;1;;  ;Val(a10)=1 y [Dialogo.Radio6=2];Not [Val(a10)=1 y [Dialogo.Radio6=2]] o [Dialogo.Precio5<>Dialogo.Precio6 y Incluido(Fstr(Dialogo.Precio5,2,4),VAR('TASAWH'))];'El Valor de TASA WH es Erroneo: '~VAR('TASAWH');NO;;;

  Radio10     : 'Ut WH Act|360|365'  ;12;2;;NO;Val(a11)=1 y [Dialogo.Radio6=2];;;;BuscarCampo('Operaciones','RB9','NrOperacion',Dialogo.NrOperacion1);
  Radio9      : 'Ut WH Nue|360|365'  ;12;1;;  ;Val(a11)=1 y [Dialogo.Radio6=2];Not [Val(a11)=1 y [Dialogo.Radio6=2]] o [Dialogo.Radio10<>Dialogo.Radio9 y Dialogo.Radio9>=0];'Unidad de Tiempo WH Erroneo: ';NO;;;

  Precio8     : '% Imp_Extr_Act'     ;13;2;;NO;Val(a12)=1 y [Dialogo.Radio6=3 O Dialogo.Radio6=4];;;;BuscarCampo('Operaciones','TasaPrecan','NrOperacion',Dialogo.NrOperacion1);
  Precio7     : '% Imp_Extr'         ;13;1;;  ;Val(a12)=1 y [Dialogo.Radio6=3 O Dialogo.Radio6=4];[Dialogo.Radio6<>3 y Dialogo.Radio6<>4] O [Dialogo.Radio6=3 Y Dialogo.Precio8<=30 y Dialogo.Precio8<>Dialogo.Precio7] O [Dialogo.Radio6=4 Y Dialogo.Precio8<=30 y Dialogo.Precio8<>Dialogo.Precio7];'El Impuesto Extranjero debe ser <=30';NO;
  TipoOp1     :                              ;1;2;;NO;NO;;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Radio6      : 'Caso|Local|ClTe|CeTl|ExtIJ|ExtDJ'       ;13;1;;NO;NO;;;;BuscarCampo('Operaciones','MB5','NrOperacion',Dialogo.NrOperacion1);BuscarCampo('Operaciones','MB5','NrOperacion',Dialogo.NrOperacion1)
  Fecha3      : 'Plazo'                      ;1;1;;NO;NO;;;;;BuscarCampo('Operaciones','FechaOp','NrOperacion',Dialogo.NrOperacion1);
FinDialogo

If Not Ok
 Cancelar
EndIf

*- x1: Set del Update
ACT(x1,'')
If val(a3)=1
   *-- Calculo el Nuevo Importe de Exposure Fee
   ACT(x1,"Cantidad="~Fstr(Dialogo.Cantidad1,0,2)~"")     
EndIf
If val(a4)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACN(b1,Dialogo.Fecha1-Dialogo.Fecha3)  
   ACT(x1,val(x1)~"FechaVto='"~IdxDate(Dialogo.Fecha1)~"',Plazo="~FStr(val(b1),0,0)~" ")   
EndIf
If val(a5)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~"RB8='"~Fstr(Dialogo.Radio1,0,0)~"' ")   
EndIf
If val(a6)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" TipoTasa='"~Dialogo.TipoTasa1~"' ")   
EndIf
If val(a7)=1
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" Spread="~Fstr(Dialogo.Precio1,0,7)~" ")   
EndIf
If val(a8)=1 y [Dialogo.Radio6=2 o Dialogo.Radio6=0]
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" ImpGastos2="~Fstr(Dialogo.Precio3,0,7)~" ")   
EndIf
If val(a9)=1 y [Dialogo.Radio6=2 o Dialogo.Radio6=0]
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" RB7='"~Fstr(Dialogo.Radio7,0,0)~"' ")   
EndIf
If val(a10)=1 y Dialogo.Radio6=2 
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" TotalAux1="~Fstr(Dialogo.Precio5,0,7)~" ")   
EndIf
If val(a11)=1 y Dialogo.Radio6=2 
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" RB9='"~Fstr(Dialogo.Radio9,0,0)~"' ")   
EndIf
If val(a12)=1 y [Dialogo.Radio6=3 o Dialogo.Radio6=4]
   If NoVacio(val(x1))
      ACT(x1,val(x1)~',')       
   EndIf
   ACT(x1,val(x1)~" TasaPrecan="~Fstr(Dialogo.Precio7,0,7)~" ")   
EndIf

Message('Modificando los datos de la Partida .... ')

If Vacio(val(x1))
   Cancelar('La Seleccion fue Nula, El Proceso se cancelara ')
EndIf

SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
SQL.ADD(" "~val(x1)~" ")
SQL.ADD(" where NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

*-- Actualizo la Instancia de la Operacion a Supervision
(.'MODIINSTAN'.)      

*** Actualiza movimientos y limites ****
SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
SQL.EXEC

If val(a5)+val(a6)+val(a7)+val(a8)+val(a9)+val(a10)+val(a11)+val(a12)+val(a13)<>0 
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
      act(x1,'')

      Message('Modificando las Operaciones Relacionadas '~FBN['NrOperacion']~' .... ')  

      * Operaciones No Liquidadas 
      If FBN['FechaVto']>VAL(a2)
         If val(a6)=1
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TipoTasa='"~Dialogo.TipoTasa1~"' ")   
         EndIf
            *--- Tasas de Interes y Spread solamente para unico vto 
         If val(a7)=1 y Incluido(FBN['TipoOp'],'MMPCCV')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Spread="~Fstr(Dialogo.Precio1,0,7)~" ")   
            *- Tasa de Interes WH 
            If FBN['RB6']=2 
               ACT(x1,val(x1)~", TotalAux2="~Fstr(FBN['Precio1']+Dialogo.Precio1,0,7)~" ")
            EndIf
            *- Tasa de Interes IVA 
            If [FBN['RB6']=2 o FBN['RB6']=0] 
               ACT(x1,val(x1)~", TotalAux4="~Fstr(FBN['Precio1']+Dialogo.Precio1,0,7)~" ")
            EndIf
         EndIf
         *-- Tasa de Iva           
         If val(a8)=1 y [FBN['RB6']=2 o FBN['RB6']=0]
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" ImpGastos2="~Fstr(Dialogo.Precio3,0,7)~" ")   
         EndIf
         *-- UT IVA
         If val(a9)=1 y [FBN['RB6']=2 o FBN['RB6']=0]
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" RB7='"~Fstr(Dialogo.Radio7,0,0)~"' ")   
         EndIf
         *-- Tasa WH
         If val(a10)=1 y FBN['RB6']=2 
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TotalAux1="~Fstr(Dialogo.Precio5,0,7)~" ")   
         EndIf
         *-- UT WH
         If val(a11)=1 y FBN['RB6']=2 
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" RB9='"~Fstr(Dialogo.Radio9,0,0)~"' ")   
         EndIf
         *-- Impuesto Extranjero
         If val(a12)=1 y [FBN['RB6']=3 o FBN['RB6']=4]
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" TasaPrecan="~Fstr(Dialogo.Precio7,0,7)~" ")   
         EndIf
      EndIf
      If val(a5)=1
         If NoVacio(val(x1))
            ACT(x1,val(x1)~',')       
         EndIf
         ACT(x1,val(x1)~"RB8='"~Fstr(Dialogo.Radio1,0,0)~"' ")   
      EndIf

      If NoVacio(VAL(x1))   
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
         SQL.ADD(" "~val(x1)~" ")
         SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")      
         SQL.NEW
      EndIf
 
      If Incluido(FBN['TipoOp'],'MMPCCM')
         ACT(x1,'')
         Message('*- Modificacion de Atributos de Cuotas ')

         *--- Tasas de Interes y Spread solamente para Multiple vto 
         If val(a7)=1 y Incluido(FBN['TipoOp'],'MMPCCM')
            If NoVacio(val(x1))
               ACT(x1,val(x1)~',')       
            EndIf
            ACT(x1,val(x1)~" Precio4="~Fstr(Dialogo.Precio1,0,7)~" ")   
            *- Tasa de Interes WH 
            If FBN['RB6']=2 
               ACT(x1,val(x1)~",Total6=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")
            EndIf
            *- Tasa de Interes IVA 
            If [FBN['RB6']=2 o FBN['RB6']=0] 
               ACT(x1,val(x1)~",Tasa2=Precio2+"~Fstr(Dialogo.Precio1,0,7)~" ")
            EndIf
         EndIf
         If NoVacio(VAL(x1))   
            SQL.ADD("UPDATE "~DBO~".CUOTAS Set ")
            SQL.ADD(" "~val(x1)~" ")
            SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' and Fecha2>'"~IdxDate(Val(a2))~"'")
            SQL.NEW  
         EndIf
      EndIf
      SQL.EXEC      
   Proximo 

   SQL.ADD("Select * from "~DBO~".OPERACIONES where OperacionRef = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
      Message('Calculando Datos Operaciones  Relacionadas '~FBN['NrOperacion']~' .... ')  
      If Incluido(FBN['TipoOp'],'MMPCCV')
         (.'UPPAPCCV'.)
      EndIf
      If Incluido(FBN['TipoOp'],'MMPCCM')
         (.'UPPAPCCM'.)
      EndIf
      SQL.EXEC      

      ACT(i3,fbn['NrOperacion'])
      (.'MODIINSTAN'.)      
      SQL.ActualizarMovimientos(FBN['NrOperacion'],SI)
      SQL.EXEC
   Proximo
EndIf
