        Proximo
        
       **//Elimino datos de DETITOFIN para la fecha de corrida y la especie
*       If Not EqStr(&especieAnterior, val(ES:1))
*          let &especieAnterior val(ES:1)
*          SQL.ADD("Delete "~DBO~".DETITOFIN WHERE Fecha = '"~Idxdate(val(FE:99))~"' and Especie ='"~val(ES:1)~"' ")
