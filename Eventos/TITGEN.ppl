**-ENVIAMOS DATOS DE TIPA QUE NO TIENE POSICIONES-**

**-inicializo variables de corte de control-**
let &vehiculoDeCorte ''
let &especieDeCorte  ''
let &bookDeCorte     ''
let &estrategiaDeCorte ''
let &ctaContDeCorte ''
let &valorContadoValuado 0
let &valorContable 0
ACT(MD:1,'')
SQL.ADD("Select Codigo from MODELOSASIENTO where (TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") OR TipoAsiento IN ("~Pipe2Comillas(Var('TIPASRETID'))~")) AND TipoOp = 'TIPA' AND Vehiculo like '%|"~VAR('VEHICON')~"|%' ")
recorrer SQL
    If NoVacio(val(MD:1))
        ACT(MD:1,val(MD:1)~'|')
    EndIf
    ACT(MD:1,val(MD:1)~fbn('Codigo'))
proximo
ACT(MD:1,val(MD:1)~'|')

SQL.ADD("Select O.NrOperacion,O.Cantidad CantidadOperacion,O.Vehiculo1,O.Especie,O.Book1,O.Plaza1 as Estrategia, A1.Cuenta, A1.Cantidad1 ImporteAsiento")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 where ")
SQL.ADD("O.NrOperacion = A.NrOperacion and A.NrUnicoAsiento = A1.NrUnicoAsiento and ")
SQL.ADD("O.TipoOp = 'TIPA' and ")
SQL.ADD("A1.TablaRC = 'TITCONREC' and ")
SQL.ADD("A.Modelo IN ("~Pipe2Comillas(val(MD:1))~") and ")
**-operaciones vigentes-**
SQL.ADD("O.FechaVto > '"~IdxDate(Val(FE:99))~"' AND ")
SQL.ADD("O.FechaOp <= '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD("Order by Vehiculo,Especie,Book1,Plaza1,Cuenta, NrOperacion ")
watch(sql.batch)
Recorrer SQL
    let &vehiculoAProcesar   fbn('Vehiculo1')
    let &especieAProcesar    fbn('Especie')
    let &bookAProcesar       fbn('Book1')
    let &estrategiaAProcesar fbn('Estrategia')
    let &ctaContAProcesar    fbn('Cuenta')
    let &cantidadDeOperacion fbn('CantidadOperacion')
    let &operacion           fbn('NrOperacion')
    let &importeDeAsiento   fbn('ImporteAsiento')
    
    **-Corte de control por Vehiculo,Especie,Book, Estrategia (Plaza1) y Cuenta-**
    If Vacio(&vehiculoDeCorte) AND Vacio(&especieDeCorte) AND Vacio(&bookDeCorte) AND Vacio(&estrategiaDeCorte) AND Vacio(&ctaContDeCorte)
        let &vehiculoDeCorte   fbn('Vehiculo1')
        let &especieDeCorte    fbn('Especie')  
        let &bookDeCorte       fbn('Book1')
        let &estrategiaDeCorte fbn('Estrategia') 
        let &ctaContDeCorte    fbn('Cuenta')
    EndIf

    If EqStr(&vehiculoAProcesar,&vehiculoDeCorte) AND EqStr(&especieAProcesar,&especieDeCorte) AND EqStr(&bookAProcesar,&bookDeCorte) AND EqStr(&estrategiaAProcesar,&estrategiaDeCorte) AND EqStr(&ctaContAProcesar,&ctaContDeCorte)
        **-sumo cantidad de operaciones por corte de control-**
        **-valor contable-**
        **-Controlo si ya no sume el importe de la operacion, para no sumarlo 2 veces si existe mas de 1 asiento por operacion-**
        if Not EqStr(&nrOperacionProc, fbn('NrOperacion')) OR Vacio(&nrOperacionProc)
            let &valorContable &valorContable + &cantidadDeOperacion
            let &nrOperacionProc    fbn('NrOperacion')
        EndIf
        let &valorContadoValuado &valorContadoValuado + &importeDeAsiento
    Else
        **-cambiaron los valores del corte de control-**
        
        **-antes de reiniciar los valores inserto en DETITOFIN-**
        SQL.ADD(" Select  Codigo,MonedaEmision, Tipo TipoEspecie, Issuer, Alias1 as EspBanTotal, VTeorico as VTeorico, Cotiza ")
        SQL.ADD(" From "~DBO~".ESPECIES ")
        SQL.ADD(" Where Codigo = '"~&especieDeCorte~"' ")
        Recorrer SQL
            **-valor residual-**
            ACN(VT:1,fbn('VTeorico'))
        proximo
        let &valorResidual iif(Val(VT:1) <> 0, Val(VT:1),1) * &valorContable
        **-cuenta contable-**   
        let &cuentaContable &ctaContDeCorte
        **-tipo cupon-**
        let &nrCupon NrCupon2(&especieDeCorte,val(FV:1))
        let &tipoCupon SQL("Select TipoCupon from "~DBO~".AGENDACUPONES where NrCupon = '"~Fstr(&nrCupon, 0, 0)~"' AND Especie = '"~&especieDeCorte~"' ") 
        **1=Amort, 2 = Renta, 3 = Amort e renta, 0= Otros
        If EqStr(&tipoCupon,'AMO')
           let &tipoCupon 1
        Else
           If EqStr(&tipoCupon,'REN')
              let &tipoCupon 2
           Else
               If EqStr(&tipoCupon,'RYA')
                  let &tipoCupon 3
               Else
                  let &tipoCupon 0
               EndIf                
           EndIf
        EndIf
        
        **-inserto datos en DETITOFIN-**
        (.'INSTITOFIN'.) 
        
        **-reinicio los valores de corte-**
        let &vehiculoDeCorte   fbn('Vehiculo1')
        let &especieDeCorte    fbn('Especie')  
        let &bookDeCorte       fbn('Book1')
        let &estrategiaDeCorte fbn('Estrategia') 
        let &ctaContDeCorte    fbn('Cuenta')
        **-reinicio totales-**
        let &valorContadoValuado 0
        let &valorContable 0
        **-sumo cantidad de operaciones por corte de control-**
        **-valor contable-**
        let &nrOperacionProc    fbn('NrOperacion')
        let &valorContable &valorContable + &cantidadDeOperacion
        let &valorContadoValuado &valorContadoValuado + &importeDeAsiento
        
    EndIf

Proximo

IF NoVacio(&especieDeCorte)
    **-Proceso ultimo registro de corte-**
    SQL.ADD(" Select  Codigo,MonedaEmision, Tipo TipoEspecie, Issuer, Alias1 as EspBanTotal, VTeorico as VTeorico, Cotiza ")
    SQL.ADD(" From "~DBO~".ESPECIES ")
    SQL.ADD(" Where Codigo = '"~&especieDeCorte~"' ")
    Recorrer SQL
        **-valor residual-**
        ACN(VT:1,fbn('VTeorico'))
    proximo
    let &valorResidual iif(Val(VT:1) <> 0, Val(VT:1),1) * &valorContable
    **-cuenta contable-**   
    let &cuentaContable &ctaContDeCorte
    **-tipo cupon-**
    let &nrCupon NrCupon2(&especieDeCorte,val(FV:1))
    let &tipoCupon SQL("Select TipoCupon from "~DBO~".AGENDACUPONES where NrCupon = '"~Fstr(&nrCupon, 0, 0)~"' AND Especie = '"~&especieDeCorte~"' ") 
    **1=Amort, 2 = Renta, 3 = Amort e renta, 0= Otros
    If EqStr(&tipoCupon,'AMO')
       let &tipoCupon 1
    Else
       If EqStr(&tipoCupon,'REN')
          let &tipoCupon 2
       Else
           If EqStr(&tipoCupon,'RYA')
              let &tipoCupon 3
           Else
              let &tipoCupon 0
           EndIf                
       EndIf
    EndIf

    **-inserto datos en DETITOFIN-**
    (.'INSTITOFIN'.)
ENDIF