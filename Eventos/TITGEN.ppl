SQL.ADD(" Select Vehiculo Vehiculo1,Especie, Book, Estrategia CuentaCustodia,Tipoposicion Concepto, Sum(Cantidad) Cantidad from ( ")
*SQL.ADD(" Select Vehiculo Vehiculo1,Especie, Sum(Cantidad) Cantidad from ( ")
SQL.ADD(" Select NrSaldo,Vehiculo,Especie, Book, Estrategia, Tipoposicion, P.CantidadFin Cantidad ")
SQL.ADD(" From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Vehiculo = P.Cliente ")
* SQL.ADD("   AND P.Especie = 'AA19D' ")
* SQL.ADD("   AND P.BOOK = 'BOOKPPL'  ")
* SQL.ADD("   AND P.Estrategia = 'PROCRYL' ")
SQL.ADD("   AND P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   AND P.Fecha <= '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD("   AND P.NrSaldo = "~Fstr(Val(SL:2), 0, 0)~" ")
SQL.ADD(" AND P.Fecha IN (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD("      Where P1.Especie = P.Especie ")
SQL.ADD("      AND P1.Vehiculo = P.Vehiculo ")
SQL.ADD("      AND P1.Cliente = P.Cliente ")
SQL.ADD("      AND P1.NrSaldo = P.NrSaldo ")
SQL.ADD("      AND P1.Book = P.Book ")
SQL.ADD("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
SQL.ADD("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
SQL.ADD("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
SQL.ADD("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
SQL.ADD("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
SQL.ADD("      AND (P1.Estrategia = P.Estrategia OR ((P1.Estrategia Is Null OR P1.Estrategia = '' OR P1.Estrategia = ' ') AND (P.Estrategia Is Null OR P.Estrategia = '' OR P.Estrategia = ' ' ))) ")
SQL.ADD("      AND P1.Fecha <= '"~IdxDate(Val(FE:99))~"') ")
SQL.ADD("  ) as Aux ")
SQL.ADD(" where Cantidad <> 0 ")
SQL.ADD(" Group by Vehiculo,Especie,Book,Estrategia,Tipoposicion")
**SQL.ADD(" Group by Vehiculo,Especie")

