SQL.ADD("Select * ")
SQL.ADD("  from "~DBO~".OPERACIONESBITS OB, "~DBO~".OPERACIONES O")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 1 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD("   and O.TipoOp in ('TIC','TIV') ")
SQL.ADD("   and O.Precio1 = 1 ")
SQL.ADD("   and O.RB6 = 3 ")
SQL.ADD("   and isNull(O.NrOrden1,'')<>'' ")
SQL.ADD(" Order by O.NrOperacion ")
Recorrer SQL
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACT(c:FAC, fbn('Mercado4'))
  ACN(d:FAC, fbn('RB6'))
  ACN(e:FAC, fbn('Cantidad'))
  ACN(f:FAC, fbn('Precio1'))
  ACT(g:FAC, fbn('NrOrden1'))
  ACN(h:FAC, 1)
proximo

if FAC>0
  Recorrer&i 1,FAC
    if Val(h:&i)=1
      EjecutarEvento('ACTPRE', NrOperacion1=Val(a:&i), Check1=1, Check2=1)
    endif
  Proximo
else
  Cancelar('No hay operaciones para modificar')
endif

*HojaVisible(SI)
