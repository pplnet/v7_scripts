CrearDialogo
  NrOperacion1: 'OperacionRef';1;1;
  Fecha1:       'Fecha de ReEmision';2;1
  Cantidad1:    'Valor Nominal';3;1
FinDialogo

If Not OK
  Cancelar
Endif

***Para guardar el Interes Pik en caso de que haya***
ACN(c:1,0)

***Busco la cuota en la que este incluida la fecha de reemision de la operacion de referencia MMONM***
SQL.ADD(" Select Fecha2 ")
SQL.ADD(" From "~DBO~".CUOTAS ")
SQL.ADD(" where Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and NrOperacion = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL
  SQL.ADD(" Select O.NrOperacion, O.PlazoGracia, O.RB8, C.NrCuota, C.Fecha1, C.Fecha2, C.Cantidad2,  C.Tasa1, C.Tasa2, C.Tasa3, C.Tasa5, C.Tasa7, ")
  SQL.ADD(" C.Precio2, C.Precio4, C.Total6, C.Cantidad4, O.Cliente1, O.ImpGastos2, O.TotalAux1, C.Check5, C.Precio10, C.Cantidad12 ")
  SQL.ADD(" From "~DBO~".CUOTAS C ")
  SQL.ADD(" Join "~DBO~".OPERACIONES O ")
  SQL.ADD(" on C.NrOperacion=O.NrOperacion")
  SQL.ADD(" where C.Fecha2 >= '"~IdxDate(fbn('Fecha2'))~"' ")
  SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  Recorrer SQL
    ***En la cuota que corresponde resto al valor nominal la cantidad de la reemision anulada***
    If fbn('Fecha2',1) = fbn('Fecha2',0)     
      ACN(a:2, fbn('Cantidad2') - Dialogo.Cantidad1)
    Else
      ACN(a:2, Val(a:3)+VAL(c:1))
    Endif
    ***Tasa Int IVA y WH***
    ACN(b:1,fbn('Precio2')+fbn('Precio4'))
    ***Calcula el interes de la cuota que vence a partir del nuevo valor nominal***
    ACN(a:1,IIF(fbn('NrCuota')<fbn('PlazoGracia'),0,VAL(a:2)*(Val(b:1)/100)*FactorDias(fbn('Fecha1'),fbn('Fecha2'),fbn('RB8')+1)))
    ***Importe IVA***
    ACN(b:2, IIF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN('Cliente1'))),0,((IIF(fbn('NrCuota')<fbn('PlazoGracia'),0,VAL(a:2)*(fbn('Tasa2')/100)*FactorDias(fbn('Fecha1'),fbn('Fecha2'),fbn('RB8')+1)))*fbn('ImpGastos2')/100)))
    ***Importe WH***
    ACN(b:3, IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN('Cliente1'))),0,((IIF(fbn('NrCuota')<fbn('PlazoGracia'),0,VAL(a:2)*(fbn('Total6')/100)*FactorDias(fbn('Fecha1'),fbn('Fecha2'),fbn('RB8')+1)))*fbn('TotalAux1')/100)))
    ***Impuesto Intereses***
    ACN(b:5, VAL(a:1)*(fbn('Tasa3')/100))
    ***Interes Total***
    ACN(b:6, Val(a:1)+Val(b:3)+Val(b:5))
    ***Recalculo de la tasa de amortizacion***
    ACN(a:5,fbn('Tasa7')/fbn('Tasa5')*100)
    ***Calculo el nuevo importe de amortizacion con la nueva tasa***
    ACN(b:7,VAL(a:2)*Val(a:5)/100)
    ***En las cuotas siguientes el valor nominal es V.Nominal - Imp Amort de la anterior***
    ACN(a:3,VAL(a:2)-VAL(b:7))
    ACN(c:1,0)
    ***Guarda el interes Pik de la cuota anterior en caso de haberlo***
    If fbn('Check5') = 1
      ACN(c:1,IIF(fbn('NrCuota')<fbn('PlazoGracia'),0,VAL(a:2)*(fbn('Precio10')/100)*FactorDias(fbn('Fecha1'),fbn('Fecha2'),fbn('RB8')+1)))
    Endif
    ***Actualizo los valores de cada una de las cuotas***
    SQL.ADD(" Update "~DBO~".CUOTAS ")
    SQL.ADD(" set Cantidad2 = "~FStr(VAL(a:2),0,2)~", Cantidad3 = "~Fstr(VAL(a:1), 0, 2)~", Cantidad4 = "~FStr(Val(b:7),0,2)~", Tasa1 = "~FStr(Val(a:5),0,8)~", ")
    If fbn('Fecha2',1) = fbn('Fecha2',0)
      SQL.ADD(" Cantidad11 = 0, ")
    Endif
    ***Si el pikeo es obligatorio lo actualizo***
    If fbn('Check5') = 1
      SQL.ADD(" Cantidad12 = "~FStr(VAL(c:1),0,2)~", ")
    Endif  
    SQL.ADD(" Precio1 = "~FStr(Val(b:2),0,8)~",  Precio3 = "~FStr(Val(b:3),0,8)~", ")
    SQL.ADD(" Cantidad5 = "~FStr(Val(b:6),0,2)~",Total2 = "~FStr(Val(b:7)+Val(a:1),0,2)~", Total1 = "~FStr(Val(b:7)+Val(b:6),0,2)~", ")
    SQL.ADD(" PrecioRef1 = "~FStr(VAL(b:5),0,2)~", Total9 = "~FStr(VAL(b:5),0,2)~", ")
    SQL.ADD(" Precio5 = "~FStr(Val(a:1),0,8)~", Precio6 = "~FStr(Val(b:2),0,8)~", Precio7 = "~FStr(Val(b:3),0,8)~" ")
    SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion')~"' and NrCuota = "~fbn('NrCuota')~" ")
    SQL.NEW
    SQL.EXEC 
  Proximo
Proximo
SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,SI,NO,NO,SI,SI)
SQL.EXEC