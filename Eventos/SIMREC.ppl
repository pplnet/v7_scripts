MostrarCuadroDeMensajes
HojaVisible(SI)
ACN(y6,0)
ACN(y7,0)
*ACT(z2, 'C:\FPA')
ACT(z:2, Var('PATHSIOPEL'))

ACT(s:1, 'Codigo')
ACT(s:2, 'FechaMAE')
ACT(s:3, 'HoraMAE')
ACT(s:4, 'Secuencia')
ACT(s:5, 'CodigoMAE')
ACT(s:6, 'Estado')
ACT(s:7, 'Mensaje1')
ACT(s:8, 'Mensaje2')
ACT(s:9, 'Mensaje3')

AbrirASCII(Val(z2)~'\SIMULADOR.TXT',0)
Repetir
  IFA
  ACT(a:FAC, LeerAscii)
  if Vacio(Val(a:FAC))
    CerrarASCII
    break
  endif
Proximo
SetFilaActual(0)
repetir
  IFA
  SCN(f1, 1)
  ACN(M1, 0)
  * Hay Mensaje
  ACN(M:3, 0)
  * Hay Mensaje valido
  ACN(M:4, 0)
  * Toda esta seccion es para verificar los mensajes que mando
  if CeldaVacia(a:FAC)
    ACN(M1, 1)
  else
    ACN(M:3, 1)
    ACN(y6,0)
    * Ignorar Mensajes 9110 de Refesh por cada Operacion
    if Not EqStr(Copy(Val(a:FAC),28,4),'9110')
      if EqStr(Var('LOGEAMAE'),'SI')
        AbrirASCII(Val(z2)~'\RECIBMAE.txt',0)
        EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-SIM-'~Val(a:FAC))
        CerrarASCII
      endif
      if Not [EqStr(Copy(Val(a:FAC),28,4),'9996') y Longitud(Val(a:FAC))=31]
        ACN(M1, 1)
        ACN(M:4, 1)
      endif
    endif
  endif
  if Val(M1)=1
    * Salir del evento cuando no hay mas mensajes recibidos y esta desconectado
    SCN(y6,1)
    * Salir del evento si no recibe mensajes por un rato
    if Val(y6)>10 y CeldaVacia(a:FAC)
*      Cancelar
      Break
    endif
    ACN(M2, 0)

    *********************************************
    * Este IF es Igual en RECMAE
    *********************************************
    if Val(M:3)=1
      * Guarda Valor de la ultima Secuencia (Fecha(6),Hora(6),Sec(5))
      SQL.ADD("Update "~DBO~".VARIABLES ")
      SQL.ADD("   Set Valor  = '"~Copy(Val(a:FAC),11,17)~"' ")
      SQL.ADD(" Where Codigo = 'ULTSECMAE' ")
      SQL.NEW
      SQL.EXEC
      if Val(m:4)=1
        Message('Vuelta '~FStr(Val(y:8),1,0)~' Analiza registro: = '~Copy(Val(a:FAC),28,4))
*MessageBox('Vuelta '~FStr(Val(y:8),1,0)~' Analiza registro: = '~Copy(Val(a:FAC),28,4))
        BorrarCeldas(t:1..t:9)
        if EqStr(Copy(Val(a:FAC),28,4),'7020')
          Message('----- Mensaje Recibido 7020')
          if Incluido(Copy(Val(a:FAC),32,4),'0301|0303|0401|0403|0302|0304|0402|0404|0305|0306|0405|0406|0510|0151|0152|0153|0251|0252|0253')
            if Incluido(Copy(Val(a:FAC),32,4),'0301|0303|0401|0403')
              ************************* Si el mensaje fue un alta de operacion  **************
              * Mensaje que dio origen a la respuesta fue :                                  *
              *      0301 : Alta para la venta hoy          0401 : Alta para la compra hoy   *
              *      0303 : Alta para la venta ayer         0403 : Alta para la compra ayer  *
              * con el primer digito de la secuencia = 0                                     *
              ********************************************************************************
              (.'RECMAE01'.)
            else
              if Incluido(Copy(Val(a:FAC),32,4),'0302|0304|0402|0404')
                *************** Si el mensaje fue un Baja de operacion (Baja = 9) ************
                * Mensaje que dio origen a la respuesta fue :                                *
                *    0302 : Baja para la venta hoy          0402 : Baja para la compra hoy   *
                *    0304 : Baja para la venta ayer         0404 : Baja para la compra ayer  *
                * con el primer digito de la secuencia = 9                                   *
                ******************************************************************************
                (.'RECMAE02'.)
              else
                if Incluido(Copy(Val(a:FAC),32,4),'0305|0306|0405|0406')
                  *************** Si el mensaje fue un Boleto ********************************
                  * Mensaje que dio origen a la respuesta fue :                              *
                  *   0305 : Alta para la venta hoy         0405 : Alta para la compra hoy   *
                  *   0306 : Alta para la venta ayer        0406 : Alta para la compra ayer  *
                  * con el primer digito de la secuencia = 1                                 *
                  ****************************************************************************
                  (.'RECMAE03'.)
                else
                  if Incluido(Copy(Val(a:FAC),32,4),'0510')
                    ******************* Si el mensaje fue una Confirmacion *******************
                    * Mensaje que dio origen a la respuesta fue :                            *
                    *   0510 : Informacion de confirmacion a un pedido del MAE               *
                    * con el primer digito de la secuencia = 2 (Alta)                        *
                    * con el primer digito de la secuencia = 8 (Baja)                        *
                    **************************************************************************
                    (.'RECMAE04'.)
                  else
                    if Incluido(Copy(Val(a:FAC),32,4),'0151|0152|0153|0251|0252|0253')
                      ************************* Si el mensaje fue un alta de operacion  **********
                      * Mensaje que dio origen a la respuesta fue :               1er digito Sec *
                      *      0151 : Alta oferta venta  0251 : Alta oferta compra   0             *
                      *      0152 : Baja oferta venta  0252 : Baja oferta compra   9             *
                      *      0153 : Modi oferta venta  0253 : Modi oferta compra   1             *
                      ********************************************************************************
                      (.'RECMAE22'.)
                    endif
                  endif
                endif
              endif
            endif
          else
            if Incluido(Copy(Val(a:FAC),32,4),'0500')
              ********************************************************************************
              * Vencimiento de Solicitud de confirmacion                                     *
              ********************************************************************************
              (.'RECMAE05'.)
            else
               if Incluido(Copy(Val(a:FAC),32,4),'0105|0205')
                ********************************************************************************
                *  Operaciones generadas por ofertas (Licitaciones)  y Ordenes CPC1            *
                ********************************************************************************
                * Operacion generada por Ofertas de Titulos SIOPEL (Licitaciones)
                * Los levanta el evento GENADJ
                (.'GENOPSIOPL'.)
              else
                Message('----- Mensaje Recibido Desconocido: 7020')
                if EqStr(Var('LOGEAMAE'),'SI')
                  AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                  EscribirASCII(Val(a:FAC))
                  CerrarASCII
                endif
              endif
            endif
          endif
        else
          ************
          * NO es 7020
          ************
          if EqStr(Copy(Val(a:FAC),28,4),'2201')
            **********************************************************************************
            * Recibi un Registro de Actualizacion de Agentes                                 *
            **********************************************************************************
            (.'RECMAE06'.)
          else
            if Incluido(Copy(Val(a:FAC),28,4),'2101|2102|2103')
              ********************************************************************************
              * Recibi un Registro de Actual. de Titulos, Parte Variable o Valor Residual    *
              ********************************************************************************
              if Eqstr(Copy(Val(a:FAC),28,4),'2102') y Incluido(Copy(Val(a:FAC),33,1),Var('TIPONEGOCT'))
                (.'RECMAE13'.)
              else
                (.'RECMAE07'.)
              endif
            else
              if Incluido(Copy(Val(a:FAC),28,4),'8101') y Num(Copy(Val(A:FAC),114,18)) <> 0
                ******************************************************************************
                * Resumen de Operaciones (Cotizaciones)                                      *
                ******************************************************************************
                (.'RECMAE08'.)
              else
                if EqStr(Copy(Val(a:FAC),28,4),'0500')
                  ****************************************************************************
                  * Recibi un Registro de Pedido de Confirmacion 0500                        *
                  ****************************************************************************
                  if Incluido(Copy(Val(a:FAC),97,4),'0301|0303|0401|0403|0302|0304|0402|0404')
                    Message('----- Mensaje de Pedido de Confirmacion')
                    if Incluido(Copy(Val(a:FAC),97,4),'0301|0303|0401|0403')
                      ACT(t:1, 'CONALT')
                    else
                      ACT(t:1, 'CONBAJ')
                    endif
                    ACT(t:2, Copy(Val(a:FAC),11,6))
                    ACT(t:3, Copy(Val(a:FAC),17,6))
                    ACT(t:4, Copy(Val(a:FAC),23,5))
                    ACT(t:5, Copy(Val(a:FAC),28,4))
                    ACT(t:6, 'PEN')
                    ACT(t:7, Copy(Val(a:FAC),1,250))
                    if Longitud(Val(a:FAC))>250
                      ACT(t:8, Copy(Val(a:FAC),251,250))
                    endif
                    if Longitud(Val(a:FAC))>500
                      ACT(t:9, Copy(Val(a:FAC),501,250))
                    endif
                    (.'GRAMENMAE'.)
*                    if Incluido(Copy(Val(a:FAC),97,4),'0301|0303|0401|0403')
*                      EjecutarEvento('CONAL2',Check1=1)
*                    else
*                      EjecutarEvento('CONBAJ',Check1=1)
*                    endif
                  else
                    Message('----- Mensaje Recibido Desconocido: 0500')
                    if EqStr(Var('LOGEAMAE'),'SI')
                      AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                      EscribirASCII(Val(a:FAC))
                      CerrarASCII
                    endif
                  endif
                else
                  if Incluido(Copy(Val(a:FAC),28,4),'0301|0303|0401|0403')
                    **************************************************************************
                    * Operacion generada por Cotizaciones SIOPEL                             *
                    **************************************************************************
                    if EqStr(Copy(Val(a:FAC),93,4),'COTZ')
                      ACT(t:1, 'GENCOT')
                      ACT(t:2, Copy(Val(a:FAC),11,6))
                      ACT(t:3, Copy(Val(a:FAC),17,6))
                      ACT(t:4, Copy(Val(a:FAC),23,5))
                      ACT(t:5, Copy(Val(a:FAC),28,4))
                      ACT(t:6, 'PEN')
                      ACT(t:7, Copy(Val(a:FAC),1,250))
                      if Longitud(Val(a:FAC))>255
                        ACT(t:8, Copy(Val(a:FAC),251,250))
                      endif
                      if Longitud(Val(a:FAC))>500
                        ACT(t:9, Copy(Val(a:FAC),501,250))
                      endif
                      (.'GRAMENMAE'.)
                    else
                      If Incluido(Copy(Val(A:FAC),28,4),'0301|0303|0401|0403')
                        ***************** Si el mensaje fue un Alta por Corretaje ****************
                        *      0301 : Venta Corretaje    0303 F.Valor                            *
                        *      0401 : Compra Corretaje   0403 F.Valor                            *
                        **************************************************************************
*** /// *** Asi estaba en ML
*                        ACT(M4,Var('GENCOR')~Copy(Val(A:2),23,5)~'.GEN')
*                        AbrirASCII(Val(M4),0)
*                        EscribirASCII(Val(a:2))
*                        CerrarASCII
*                        ACT(M4,Var('GENCOR')~Copy(Val(A:2),23,5)~'.BAK')
*                        AbrirASCII(Val(M4),0)
*                        EscribirASCII(Val(a:2))
*                        CerrarASCII
* FJL 04/09/2018 - Se reemplaza por OPSIOPEL
*                        ACT(t:1, 'GENCOR')
*                        ACT(t:2, Copy(Val(a:FAC),11,6))
*                        ACT(t:3, Copy(Val(a:FAC),17,6))
*                        ACT(t:4, Copy(Val(a:FAC),23,5))
*                        ACT(t:5, Copy(Val(a:FAC),28,4))
*                        ACT(t:6, 'PEN')
*                        ACT(t:7, Copy(Val(a:FAC),1,250))
*                        if Longitud(Val(a:FAC))>255
*                          ACT(t:8, Copy(Val(a:FAC),251,250))
*                        endif
*                        if Longitud(Val(a:FAC))>500
*                          ACT(t:9, Copy(Val(a:FAC),501,250))
*                        endif
*                        (*.*'*GRAMENMAE'.)
                        ACN(z4, 0)
                        * Operacion generada por rueda Corretaje
                        * Los levanta el evento GENCOR
                        (.'GENOPSIOP'.)
                      Else
                        Message('----- Mensaje Recibido Desconocido: 0301|0303|0401|0403')
                        if EqStr(Var('LOGEAMAE'),'SI')
                          AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                          EscribirASCII(Val(a:FAC))
                          CerrarASCII
                        endif
                      endif
                    endif
                  else
                    if Incluido(Copy(Val(a:FAC),28,4),'0105|0205')
                      ************************************************************************
                      * Operacion generada por Ofertas SIOPEL                                *
                      ************************************************************************
                      ACN(z4, 0)
                      * Operacion generada por Ofertas de Titulos SIOPEL
                      * Los levanta el evento GENTIT
                      (.'GENOPSIOP'.)
                    else
* FJL 09/01/25 - Los precios llegan ahora (Version SIopel 8.40) en registros 4447 en lugar de 4427
*                      if Incluido(Copy(Val(a:FAC),28,4),'4416|4426|4427|4428|4430')
                      if Incluido(Copy(Val(a:FAC),28,4),'4416|4426|4427|4428|4430|4447')
                        **********************************************************************
                        * Registros OCT                                                      *
                        **********************************************************************
                        if Incluido(Copy(Val(a:FAC),28,4),'4416')
                          ********************************************************************
                          * Mark to market OCT                                               *
                          ********************************************************************
                          (.'RECMAE09'.)
                        else
                          if Incluido(Copy(Val(a:FAC),28,4),'4426')
                            ******************************************************************
                            * Detalle MTM OCT                                                *
                            ******************************************************************
                            (.'RECMAE10'.)
                          else
                            if Incluido(Copy(Val(a:FAC),28,4),'4427')
                              ****************************************************************
                              * Cotizaciones OCT                                             *
                              ****************************************************************
                              ***/// FJL 23-01-18 Secuelga con estosmensaje
*                              (*.*'RECMAE11'.)
                            else
                              if Incluido(Copy(Val(a:FAC),28,4),'4428')
                                **************************************************************
                                * Garantias OCT                                              *
                                **************************************************************
                                (.'RECMAE12'.)
                              else
                                if Incluido(Copy(Val(a:FAC),28,4),'4430')
                                  ************************************************************
                                  * Cortes OCT                                               *
                                  ************************************************************
                                  (.'RECMAE14'.)
                                else
                                  if Incluido(Copy(Val(a:FAC),28,4),'4447')
                                    ****************************************************************
                                    * Cotizaciones OCT                                             *
                                    ****************************************************************
                                    (.'RECMAE111'.)
                                  else
                                    Message('----- Mensaje Recibido Desconocido: OCT')
                                    if EqStr(Var('LOGEAMAE'),'SI')
                                      AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                                      EscribirASCII(Val(a:FAC))
                                      CerrarASCII
                                    endif
                                  endif
                                endif
                              endif
                            endif
                          endif
                        endif
                      else
                        if Incluido(Copy(Val(a:FAC),28,4),'9903')
                          ********************************************************************
                          * Tasas e Indices                                                  *
                          ********************************************************************
* FJL 18/03/25 - Issue EXTBIND-8014 - La cotizacion de COM A 3500 llega por aca cuando no se opera OCT
                          if Not EqStr(Copy(Val(a:FAC),33,3),'PES')
*** Graba en TASASSIOPEL que no existe en STD
*                          (*.*'*RECMAE15'.)
                          else
                            * El campo 'Codigo de tasa' es PES que corresponde a la cotizacion de COM A 3500
                            (.'RECMAE115'.)
                          endif
                        else
                          if Incluido(Copy(Val(a:FAC),28,4),'0302|0304|0402|0404')
                            ******************************************************************
                            * Baja de Operaciones relacionadas MAE1                          *
                            *    0302 : Baja venta hoy       0402 : Baja compra hoy          *
                            *    0304 : Baja venta ayer      0404 : Baja compra ayer         *
                            ******************************************************************
                            (.'RECMAE16'.)
                          else
                            if Incluido(Copy(Val(a:FAC),28,4),'5100')
                              ****************************************************************
                              * Otros mensajes del MAE                                       *
                              ****************************************************************
                              if Incluido(Copy(Val(a:FAC),32,1),'K')
                                if EqStr(Copy(Val(a:FAC),33,10),'Ya dispone')
                                  Message('Recepcion de Cotizaciones CONCLUIDA')
                                  (.'FLAGPREC'.)
** // **
*                                  EjecutarEvento('PREC26',Fecha1=FSys, Check1=1, Check2=1, Check3=1)
*                                  EjecutarEvento('POSTI3',Fecha1=FSys, Fecha2=FSys, Check1=1, Check2=1, Check3=1, Check4=1)
                                else
                                  Message('----- Mensaje Recibido Desconocido: 5100 K')
                                  if EqStr(Var('LOGEAMAE'),'SI')
                                    AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                                    EscribirASCII(Val(a:FAC))
                                    CerrarASCII
                                  endif
                                endif
                              else
                                Message('----- Mensaje Recibido Desconocido: 5100')
                                if EqStr(Var('LOGEAMAE'),'SI')
                                  AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                                  EscribirASCII(Val(a:FAC))
                                  CerrarASCII
                                endif
                              endif
                            else
                              ****************************************************************
                              * Libro de Ordenes                                             *
                              ****************************************************************
                              if Incluido(Copy(Val(a:FAC),28,4),'0620')
                                Message('----- Mensaje Recibido Ordenes')
                                (.'RECMAE17'.)
                              else
                                ****************************************************************
                                * Otros mensajes                                               *
                                ****************************************************************
                                Message('----- Mensaje Recibido Desconocido : '~Copy(Val(a:FAC),28,4))
                                if EqStr(Var('LOGEAMAE'),'SI')
                                  AbrirASCII(Val(z2)~'\MAEDESCO.TXT',0)
                                  EscribirASCII(Val(a:FAC))
                                  CerrarASCII
                                endif
                              endif
                            endif
                          endif
                        endif
                      endif
                    endif
                  endif
                endif
              endif
            endif
          endif
        endif
      endif
      * Fin M:4 = 1
    endif
    * Fin M:3 = 1
    **********************************************
    * Hasta aca se copia tal cual al evento RECMAE
    **********************************************
  endif
Proximo
