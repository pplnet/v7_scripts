CrearDialogo
        Fecha1      : 'Fecha desde'           ;1;1;;;;;;;FSYS
        Fecha2      : 'Fecha hasta'           ;2;1;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;"Fecha Hasta tiene tiene que ser mayor a Fecha Desde";;;FSYS
FinDialogo

if not ok
    Cancelar("Evento Cancelado.")
Endif

*m: Check para cargar horas 1 si 0 no
*aa:1 Saber si la operacion cuenta con un registro en LIBORDENES. Si tiene hago un UPDATE, si no tiene hago un INSERT
*&CantOperaciones variable que cuenta cuantos ciclos tiene que recorrer 
*&TotalOp a cuantas operaciones se le cargaron horas
SetFilaActual(0)
&CantOperaciones := 0
&TotalOp := 0
&SecuenciaHrs := 0

*Las operaciones comprendidas por este evento son operaciones de títulos contra clientes y que desciendan de clientes, no financieros en la jerarquía vinculados (BOFASEC), 

SQL.ADD("SELECT O.NrOperacion,O.Cliente1,O.FechaOp,O.FechaVto,O.TipoOp,O.Especie,O.Cantidad,O.Precio1, ")
SQL.ADD("O.TotalBrutoCli1, LIB.HoraOr,LIB.Mercado,LIB.Estado,LIB.UsuarioSup")
SQL.ADD(" FROM "~DBO~".OPERACIONES O")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
SQL.ADD("INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo")
SQL.ADD("OUTER APPLY (SELECT TOP 1 L.HoraOr, L.UsuarioCarga, L.Estado, L.UsuarioSup, L.Mercado FROM "~DBO~".LIBORDENES L WHERE L.NrOperacionRef = O.NrOperacion ORDER BY L.FechaCarga DESC ) LIB")

*Filtro Fechas OK
SQL.ADD("WHERE O.FechaOp BETWEEN "~IdxDate2(Dialogo.Fecha1)~" AND "~IdxDate2(Dialogo.Fecha2))
*Filtro TipoOp OK
SQL.ADD("AND TipoOp IN ('TIC','TIV')")
*Instancia Liquidacion 10 o Terminal 70 OK
SQL.ADD("AND OB.NrBit IN ('10','70') ")
*FILTRO PARA CLIENTES FALTA
SQL.ADD("AND CL.Status = 'HAB' AND CL.NrMae IS NULL")
*FILTRO PARA PENDIENTES, RECHAZADOS Y NULOS OK
SQL.ADD("AND LIB.Estado IN ('PEN','REC')")


Recorrer SQL
    *Recuperar la operacion de titulos
    ACT(a:fac,FBN['NrOperacion'])
    ACT(b:fac,FBN['Cliente1'])
    ACD(c:fac,FBN['FechaOp'])
    ACD(d:fac,FBN['FechaVto'])
    ACT(e:fac,FBN['TipoOp'])
    ACT(f:fac,FBN['Especie'])
    ACT(g:fac,FBN['Cantidad'])
    ACT(h:fac,FBN['Precio1'])
    ACT(i:fac,FBN['TotalBrutoCli1'])
    ACN(m:fac,0)
    ACN(n:fac,FBN['Mercado'])
    ACT(o:fac,FBN['HoraOr'])
    If No Vacio(Val(o:fac))
        ACN(j:fac,Num(Copy(Val(o:fac),1,2)))
        ACN(k:fac,Num(Copy(Val(o:fac),4,2)))
        ACN(l:fac,Num(Copy(Val(o:fac),7,2)))
    endif
    ACT(P:fac,FBN['Estado'])
    if Eqstr(Val(p:fac),'PEN')
        ACT(q:fac,"Pendiente")
    else
        ACT(q:fac,"Rechazado")
    endif
    ACT(P:fac,FBN['UsuarioSup'])
    
    
    &CantOperaciones := &CantOperaciones + 1
Proximo

IF &CantOperaciones > 0
    CrearListBox ; 'Arial,8,'

        'Check'             ; m1..m:fac   ;SI;IIF(Val(m:FLB) = 1, (Val(j:FLB) + Val(K:FLB) + Val(L:FLB)) <> 0);'La hora de carga no puede ser 00:00:00. Fila: '~FStr(FLB,1,0);50;CHECK;RGB(232,232,255); 
        'Estado'            ; q1..q:fac   ;NO;SI;;80;STRING;;RGB(232,232,255);
        'Supervisor'        ; p1..p:fac   ;NO;SI;;80;STRING;;RGB(232,232,255);  
        'NrOperacion'       ; a1..a:fac   ;SI;;;80;STRING;;RGB(232,232,255); 
        'Cliente'           ; b1..b:fac   ;NO;SI;;80;STRING;;RGB(232,232,255); 
        'FechaOp'           ; c1..c:fac   ;NO;SI;;80;FECHA;RGB(232,232,255); 
        'FechaVto'          ; d1..d:fac   ;NO;SI;;80;FECHA;RGB(232,232,255); 
        'TipoOp'            ; e1..e:fac   ;NO;SI;;60;STRING;;RGB(232,232,255); 
        'Especie'           ; f1..f:fac   ;NO;SI;;60;STRING;;RGB(232,232,255); 
        'Cantidad'          ; g1..g:fac   ;NO;SI;;100;NUMERO;;RGB(232,232,255); 
        'Precio'            ; h1..h:fac   ;NO;SI;;100;NUMERO;'.########';RGB(232,232,255);
        'Total'             ; i1..i:fac   ;NO;;;110;NUMERO;;RGB(232,232,255);
        'Horas Orden'       ; j1..j:fac   ;SI;IIF(Val(m:FLB) = 1, Val(j:FLB) >= 0 Y  Val(j:FLB)< 24);'El rango de horas es entre 0 y 23. Fila: '~FStr(FLB,1,0);95;NUMERO;'##';RGB(180,180,193);
        'Minutos Orden'     ; k1..k:fac   ;SI;IIF(Val(m:FLB) = 1, Val(k:FLB) >= 0 Y  Val(k:FLB)< 60);'El rango de minutos es entre 0 y 59. Fila: '~FStr(FLB,1,0);95;NUMERO;'##';RGB(180,180,193);
        'Segundos Orden'    ; l1..l:fac   ;SI;IIF(Val(m:FLB) = 1, Val(l:FLB) >= 0 Y  Val(l:FLB)< 60);'El rango de segundos es entre 0 y 59. Fila: '~FStr(FLB,1,0);95;NUMERO;'##';RGB(180,180,193);

    FinListBox

else
    Cancelar('No hay operaciones que cumplan las condiciones')
endif
    


if not ok
    Cancelar('Evento Cancelado.')
Endif

Recorrer&i  1 ,&CantOperaciones 

    if Val(m:&i) = 1
    *La operacion esta aprobada
        &SecuenciaHrs := Pad0(Val(j:&i),2)~':'~Pad0(Val(k:&i),2)~':'~Pad0(Val(l:&i),2)        
        If Val(n:&i) = 0
                *La operacion no existe en LibOrdenes INSERT
                SQL.ADD(" Insert into "~DBO~".LIBORDENES ( ")
                SQL.ADD(" Mercado, Fecha,  FechaOP, NrOperacionRef, FechaHo,")  
                SQL.ADD(" HoraOr, SecuenciaHO, Agente,FechaHoraCarga,UsuarioCarga,  ")
                SQL.ADD("Estado")
                SQL.ADD(" ) Values ( ")
                *Mercado
                SQL.ADD(" '1'                       ,"~IdxDate2(FSYS)~"         ,"~IdxDate2(Val(c:&i))~"    ,'"~Val(a:&i)~"'            ,"~IdxDate2(Val(c:&i))~","  )
                *HoraOp
                SQL.ADD("'"~&SecuenciaHrs~"'    , '"~Pad0(Val(j:&i),8)~"'   ,'"~VAR('AGESIOP')~"'           ,"~SQLAhora~" ,'"~USUARIOACTIVO~"', "             )
                *Estado
                SQL.ADD("'ING'"                                                                                                                                     )
                SQL.ADD(" ) ")
                SQL.NEW
            else
                *La operacion  existe en LibOrdenes INSERT
                SQL.ADD("UPDATE "~DBO~".LIBORDENES SET ")
                SQL.ADD("FechaHoraCarga = "~SQLAhora~", ")
                SQL.ADD("UsuarioCarga = '"~USUARIOACTIVO~"', ")
                SQL.ADD("Estado = 'ING',")
                SQL.ADD("HoraOr ='"~&SecuenciaHrs~"',")
                SQL.ADD("SecuenciaHO ='"~Pad0(Val(j:&i),8)~"',")   
                SQL.ADD("FechaHoraSup = NULL ,")
                SQL.ADD("UsuarioSup = NULL")
                SQL.ADD("WHERE NrOperacionRef='"~Val(a:&i)~"'")
                SQL.NEW
            endif
        
        &TotalOp := &TotalOp + 1  
    endif
PROXIMO
SQL.EXEC
If &TotalOp = 1 
    MessageBox("Se cargo "~FStr(&TotalOp,1,0)~" operacion")
Else
    MessageBox("Se cargaron "~FStr(&TotalOp,1,0)~" operaciones")
Endif



