CrearDialogo
  NrOperacion1 : "Nr.Operacion" ;1;1;1;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar el numero de Operacion';NO;
  TipoOp1      : 'TipoOp'       ; ; ; ;NO;;Incluido(Dialogo.TipoOp1,'TIC|TIV');'Tipo Operacion invalido. Debe ser TIC o TIV';NO;;BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : 'Especie'      ; ; ; ;NO;;;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1)
  Entero1      : 'Cupon Actual' ; ; ; ;NO;;;;;;Num(BuscarCampo('OPERACIONES','Cupon1','NrOperacion',Dialogo.NrOperacion1))
  Entero2      : 'Cupon Nuevo'  ; ; ; ;;;Dialogo.Entero2>0 y Dialogo.Entero2<>Dialogo.Entero1;'Nuevo Cupon Invalido';NO;;Dialogo.Entero1
  Check1       : 'Procesa'      ;1;2; ;NO;NO;;;;1;
FinDialogo
IF NOT OK
   Cancelar
ENDIF

IF Incluido(BuscarCampo('OPERACIONES','PaseCB','NrOperacion',Dialogo.NrOperacion1),'1')
  Cancelar('La Operacion NO debe ser pata de un pase.')
Endif

ACN(o:1, SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' and NrSaldo in (1,31) ") )
If Val(o:1)=1
  Cancelar('La operacion NO debe tener movimientos liquidados.')
Endif

if Dialogo.Check1=1
  SQL.ADD("UPDATE "~DBO~".OPERACIONES SET Cupon1 = "~fstr(Dialogo.Entero2,0,0)~" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC

  SQL.ActualizarMovimientos3(Dialogo.NrOperacion1,SI,NO,NO,SI,NO)
  SQL.EXEC
  
  MessageBox('Operacion Actualizada.')
endif
