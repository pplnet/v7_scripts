CrearDialogo
    Fecha1    : 'Fecha'             ;;;;;;;;;;;;;
    String1   : 'Cuenta'            ;2;1;;;;;;;;;;;;"Select DISTINCT(NrCuenta),Nombre  from "~DBO~".SALDOSBANCARIOS"
    Cantidad1 : 'Ajuste'            ;;;;;;;;;;;;;
FinDialogo

        SQL.ADD(" UPDATE "~dbo~".SALDOSBANCARIOS ")
        SQL.ADD(" SET Ajuste='"~Fstr(Dialogo.Cantidad1,0,2)~"' ")
        SQL.ADD(" WHERE FechaSaldo = '"~Idxdate(Dialogo.Fecha1)~"' and NrCuenta = '"~Dialogo.String1~"' ")
        SQL.NEW
        SQL.EXEC


let &contable 0
let &operativo 0
let &inicial 0
let &dias 0

SQL.ADD(" Select SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, FechaSaldo from "~dbo~".SALDOSBANCARIOS")
SQL.ADD(" Where FechaSaldo >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaSaldo <= '"~IdxDate(FinDeMes(Dialogo.Fecha1,SI))~"' and NrCuenta = '"~Dialogo.String1~"' and Estado <> 'ANU' ")
Recorrer SQL
    let &contable FBN['SaldoAcuCon']+Dialogo.Cantidad1
    let &operativo FBN['SaldoAcuOpe']+Dialogo.Cantidad1
    let &inicial FBN['SaldoAcuIni']+Dialogo.Cantidad1
    let &dias FBN['DiasAcu']
    
    SQL.ADD(" UPDATE "~dbo~".SALDOSBANCARIOS ")
    SQL.ADD(" SET SaldoAcuCon="~Fstr(&contable,0,2)~",SaldoAcuOpe="~Fstr(&operativo,0,2)~",SaldoAcuIni="~Fstr(&inicial,0,2)~" ")
    SQL.ADD(" ,SaldoOpePromedio="~Fstr(&contable/&dias,0,2)~" ,SaldoConPromedio="~Fstr(&contable/&dias,0,2)~",SaldoIniPromedio="~Fstr(&contable/&dias,0,2)~" ")
    SQL.ADD(" WHERE FechaSaldo = '"~Idxdate(FBN['FechaSaldo'])~"' and NrCuenta = '"~Dialogo.String1~"' and Estado <> 'ANU' ")
    SQL.NEW
    SQL.EXEC
Proximo