MostrarCuadroDeMensajes

BorrarArchivo(VAR('CTRLDATA01'))
AbrirAscII(VAR('CTRLDATA01'), 0)
ACT(a:1, 'Comienza DATA01 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
ACT(a:1, '*****************************************************')
EscribirASCII(Val(A:1))


***---Armo Lista de Vehiculos del UsuarioActivo
IF NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Distinct Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
ELSE
    ACT(LS:1, SQLSet(" Select Codigo From "~DBO~".VEHICULOS "))
ENDIF


message('Ejecutando Depuracion de Movimientos Datanet ... ')
ACT(a:1, 'Comienza PBD31 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
EjecutarEvento('PBD31',Fecha1=Fsys,Radio2=3,Lista1='DNCTAS|DNAHMS|DNCCDO|DNCADO|DNCOBR|DNOTRO',Lista2=Val(LS:1),Lista3='',Lista4='',Check1=0,Check2=1)
ACT(a:1, 'Finaliza PBD31 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))


message('Ejecutando Conciliacion Automatica de Movimientos ... ')
ACT(a:1, 'Comienza PBD41 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
EjecutarEvento('PBD41',Fecha1=FSYS,Check1=1,Check2=1,Check3=1,Cantidad1=1,Radio2=0,Lista1='',Lista2=Val(LS:1),Check4=0,Check5=1,Lista3='',Lista4='')
ACT(a:1, 'Finaliza PBD41 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))


message('Ejecutando Actualizacion de Cobranzas ... ')
ACT(a:1, 'Comienza PBD8 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
EjecutarEvento('PBD8',Fecha1=FSYS,Lista1=Val(LS:1),Lista3='',Lista4='',Check1=0)
ACT(a:1, 'Finaliza PBD8 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))


*- De Datanet a Posicion Bancaria
message('Ejecutando Transferencias Automaticas ... ')
ACT(a:1, 'Comienza BPBD12 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
EjecutarEvento('BPBD12',Fecha1=FSYS,Radio1=2,Lista1=Val(LS:1),Lista2='',Lista3='',Check2=0,Check1=0)
ACT(a:1, 'Finaliza BPBD12 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))


IF NO
*- De Posicion Bancaria/SIAF a Datanet
SQL.ADD("Select Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(UsrVehiculos(UsuarioActivo)) 
   SQL.ADD(" Where Codigo In (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
EndIf
SQL.ADD(" Order By 1 ")

Recorrer SQL
   dfa
   Message('Ejecutando Transferencias Bancarias a Datanet Vehiculo '~FBN['Codigo'])
   ACT(a:1, 'Comienza ZPBD1 '~Fecha(fsys)~' '~HORA(SQLAHORA))
   EscribirASCII(Val(A:1))
   EjecutarEvento('ZPBD1',Fecha1=FSYS,Vehiculo1=FBN['Codigo'],String=VAR('DNTRANSF'),Radio1=0,Check10=0)
   ACT(a:1, 'Finaliza ZPBD1 '~Fecha(fsys)~' '~HORA(SQLAHORA))
   EscribirASCII(Val(A:1))

   Message('Ejecutando Liquidacion de Operaciones por Datanet Vehiculo '~FBN['Codigo'])
   ACT(a:1, 'Comienza ZPBD2 '~Fecha(fsys)~' '~HORA(SQLAHORA))
   EscribirASCII(Val(A:1))
   EjecutarEvento('ZPBD2',Fecha1=FSYS,Vehiculo1=FBN['Codigo'],String=VAR('DNLIQUID'),Check10=0)
   ACT(a:1, 'Comienza ZPBD2 '~Fecha(fsys)~' '~HORA(SQLAHORA))
   EscribirASCII(Val(A:1))
Proximo
ENDIF

ACT(a:1, '*****************************************************')
EscribirASCII(Val(A:1))
ACT(a:1, 'Finaliza DATA01 '~Fecha(fsys)~' '~HORA(SQLAHORA))
EscribirASCII(Val(A:1))
CerrarASCII