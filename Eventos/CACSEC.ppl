ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'SECS|SEVS|SECSV|SEVSV|SECT|SEVT|SECTV|SEVTV|');'El TipoOp debe ser SECS|SEVS|SECSV|SEVSV|SECT|SEVT|SECTV|SEVTV|';NO;;;;;;" TipoOp in ('SECS','SEVS','SECSV','SEVSV','SECT','SEVT','SECTV','SEVTV') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un documento';NO;Var('FILECACSEC')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)

let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.ContraEspecie,O.Cuenta1, O.Vehiculo1, O.TotalBrutoCli1, O.Precio1, ")
SQL.ADD("O.Cantidad, O.FechaOp, Cuenta1, O.ImpComMer1 , O.TotalComisiones, O.ImpComCor1, O.TotalGastos, O.TotalIVA, O.Plazo, O.RB5 ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   
   let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Vehiculo1'])
   let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
   let &fecha_larga FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)

   if Incluido(Fbn['TipoOp'], 'SECT|SEVT|SECTV|SEVTV|') 
    let &plazo Fbn['Plazo']
   else
    let &plazo Fbn['RB5']
   endif

   ACN(zx:99, Fbn['ImpComMer1'] + Fbn['TotalComisiones'] + Fbn['ImpComCor1'] + Fbn['TotalGastos'] + Fbn['TotalIVA'] )
   ACT(zp:99, PYC(val(zx:99),1,2))
   
   If Incluido(Fbn['TipoOp'], 'SECS|SECSV|SECT|SECTV|')
    If &plazo > 0
        let &oracion11 'Por medio de la presente, confirmamos a Uds. estar comprando a '~PYC(&plazo,1,0)~IIF(num(&plazo) >1,' d'~Chr(237)~'as', ' d'~Chr(237)~'a')
        let &oracion12 ' la suma de VN '~PYC(fbn['Cantidad'],1,2)~' '~fbn['Especie']~' a un precio de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['Precio1'],1,2)~'.-'
        let &oracion13 ' lo que hace un monto de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['TotalBrutoCli1'],1,2)~'.'
    Else 
        let &oracion11 'Por medio de la presente, confirmamos a Uds. la liquidaci'~Chr(243)~'n de VN  '~PYC(fbn['Cantidad'],1,2)~' '~fbn['Especie']~' a un precio de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['Precio1'],1,2)~'.-'
        let &oracion12 ' lo que hace un monto de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['TotalBrutoCli1'],1,2)~'.-'
        let &oracion13 ', cuya compra fue pactada el d'~Chr(237)~'a'~FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)~', que autorizamos debitar de nuestra cuenta # '~BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])~' en vuestra Entidad.'
    EndIf 
   Else
    If &plazo > 0
        let &oracion11 'Por medio de la presente, confirmamos a Uds. estar vendiendo '~PYC(&plazo,1,0)~IIF(num(&plazo) >1,' d'~Chr(237)~'as', ' d'~Chr(237)~'a')
        let &oracion12 ' la suma de VN '~PYC(fbn['Cantidad'],1,2)~' '~fbn['Especie']~' a un precio de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['Precio1'],1,2)~'.-'
        let &oracion13 ' lo que hace un monto de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['TotalBrutoCli1'],1,2)~'.'
    Else 
        let &oracion11 'Por medio de la presente, y de acuerdo a las acciones a nuestra disposici'~Chr(243)~'n confirmamos la liquidaci'~Chr(243)~'n de VN  '~PYC(fbn['Cantidad'],1,2)~' '~fbn['Especie']
        let &oracion12 ' a un precio de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~PYC(fbn['Precio1'],1,2)~'.- lo que hace un monto total de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie']))~' '~PYC(fbn['TotalBrutoCli1'],1,2)~'.-'
        let &oracion13 ' cuya venta fue pactada el d'~Chr(237)~'a '~FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)~' que solicitamos a Uds. acreditar en nuestra cuenta # '~BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])~' en vuestra Entidad.'
    EndIf
   EndIf

   let &oracion21 ''
   let &oracion22 ''
   
   If &plazo <= 0
        let &oracion21 'Asimismo, y de acuerdo a los gastos de arancel, imp. / der. e IVA S/ Arancel por un monto total de '~IIF(EqStr(fbn['ContraEspecie'],'ARP'),'$',IIF(EqStr(fbn['ContraEspecie'],'USD'),'u$s',fbn['ContraEspecie'] ) )~' '~val(zp:99)~'.-'
        let &oracion22 'autorizamos a debitar los mismos de nuestra cuenta comitente # '~BuscarCampo('CLIENTES','CodComitente','Codigo',fbn['Cliente1'])
   EndIf 

   EmitirCartaVisible(&pf, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion11 = &oracion11, oracion12 = &oracion12, oracion13 = &oracion13, oracion21 = &oracion21, oracion22 = &oracion22)

Proximo





