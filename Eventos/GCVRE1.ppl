*** GCV. Generacion de Compras Ventas para REPO con Especie o ContraEspecie en PESOS
CrearDialogo
  NrOperacion1 : "Operacion" ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operacion';NO;
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'FXREPO|FXREPV')
   Cancelar('La operacion N? '~Dialogo.NrOperacion1~' No es un Repo')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   Message(' --- Generando Compra/Venta ...')

   * Toma la operacion verificando que no se hayan generado las compras/ventas
   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' and (RB1='0' or RB1 IS NULL) ")

   ACN(A1,0)
   Recorrer SQL
     IF Not (EqStr(FBN['Especie'],'ARP') or EqStr(FBN['ContraEspecie'],'ARP'))
        MessageBox('Debe Generar Arbitrajes a Partir de Este REPO !!!')
        Break
     ENDIF
     
     ACN(A1,1)

     *** Determina los tipos de operacion a utilizar ***
     *** Z1 operacion contado, z2 operacion futuro ****    

     ** ---- ESPECIE PESOS
     ** FXREPO :FXVS y FXCT
     If EqStr(FBN['TipoOp'],'FXREPO') Y EQSTR (FBN['Especie'], 'ARP')
        ACT(z1,'FXVS')        
        ACT(z2,'FXCT')        
     endif

     ** FXREPV Y ESPECIE PESOS: FXVSV y FXCTV
     If EqStr(FBN['TipoOp'],'FXREPV') Y EQSTR (FBN['Especie'], 'ARP')
        ACT(z1,'FXVSV')        
        ACT(z2,'FXCTV')        
     endif

     ** ---- CONTRAESPECIE PESOS
     ** FXREPO 
     If EqStr(FBN['TipoOp'],'FXREPO') Y EQSTR (FBN['ContraEspecie'], 'ARP')
        ACT(z1,'FXCS')        
        ACT(z2,'FXVT')        
     endif

     ** FXREPV Y CONT. PESOS: FXVSV y FXCTV
     If EqStr(FBN['TipoOp'],'FXREPV') Y EQSTR (FBN['ContraEspecie'], 'ARP')
        ACT(z1,'FXCSV')        
        ACT(z2,'FXVTV')        
     endif

     *** Z4: Calcula el Plazo de la Especie
     ACN(Z4,FBN['FechaVto']-FBN['FechaOp'])

     *** Z5: Calcula el Plazo2 de la ContraEspecie
     ACN(Z5,FBN['FechaPago']-FBN['FechaOp'])

          
     * X1: Operacion Contado
     * X2: Operacion Futuro 
     IF EQSTR(FBN['ContraEspecie'],'ARP')
        ACT(x1," '"~FBN['Especie']~"', 'ARP', ")
        ACT(x1,VAL(x1)~Fstr(FBN['Cantidad'],0,4)~", ")
        ACT(x1,VAL(x1)~Fstr(FBN['TotalBrutoCli1'],0,4)~", "~Fstr(FBN['TotalBrutoCli1'],0,4)~", ")
        ACT(x1,VAL(x1)~" '"~FBN['TablaFeriados1']~"', ")
        ACT(x1,VAL(x1)~" "~Fstr(FBN['Precio1'],0,7)~" ") 

        ACT(x2," '"~FBN['Especie']~"', 'ARP', ")
        ACT(x2,VAL(x2)~Fstr(FBN['Cantidad'],0,4)~", ")
        ACT(x2,VAL(x2)~Fstr(FBN['TotalBrutoCli2'],0,4)~", "~Fstr(FBN['TotalBrutoCli2'],0,4)~", ")
        ACT(x2,VAL(x2)~" '"~FBN['TablaFeriados1']~"', ")
        ACT(x2,VAL(x2)~" "~Fstr(FBN['Precio2'],0,7)~" ") 

        *** Z6: Recupero CB6 Operacion Contado
        ACN(Z6,1)
        IF EqStr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='ARP' "),'INV')
           ACN(Z6,0)
        ENDIF

        *** Z16: Recupero CB6 Operacion Futuro      
        ACN(Z16,VAL(Z6))

        *** Z7: Precio4
        ACN(Z7,FBN['Precio4'])
     ELSE 
        *** Z6: Recupero CB6 Operacion Contado
        ACN(Z6,1)
        IF EqStr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='ARP' "),'INV')
           ACN(Z6,0)
        ENDIF

        *** Z7: Precio4
        ACN(Z7,COTIZACIONC(FBN['ContraEspecie'],,,,FBN['FechaOp'],1,SI,'ARP'))

        IF VAL(Z6)=0 
           * Inversa
           ACN(Z7,1/VAL(Z7))
        ENDIF

        *** Z16: Recupero CB6 Operacion Futuro      
        ACN(Z16,VAL(Z6))

        ** Z8: Precio Contado   
        ACN(z8,FBN['Cantidad']/FBN['TotalBrutoCli1'])
        IF VAL(Z6)=0 
           * Inversa
           ACN(z8,FBN['TotalBrutoCli1']/FBN['Cantidad'])
        ENDIF

        ** Z9: Precio Futuro
        ACN(z9,FBN['Cantidad']/FBN['TotalBrutoCli2'])

        IF VAL(Z16)=0 
           * Inversa
           ACN(z9,FBN['TotalBrutoCli2']/FBN['Cantidad'])
        ENDIF
 
        ACT(x1," '"~FBN['ContraEspecie']~"', 'ARP', ")
        ACT(x1,VAL(x1)~" "~Fstr(FBN['TotalBrutoCli1'],0,4)~", ")
        ACT(x1,VAL(x1)~Fstr(FBN['Cantidad'],0,4)~", "~Fstr(FBN['Cantidad'],0,4)~", ")
        ACT(x1,VAL(x1)~" '"~FBN['TablaFeriados2']~"', ")
        ACT(x1,VAL(x1)~" "~Fstr(VAL(Z8),0,7)~" ") 

        ACT(x2," '"~FBN['ContraEspecie']~"', 'ARP', ")
        ACT(x2,VAL(x2)~" "~Fstr(FBN['TotalBrutoCli2'],0,4)~", ")
        ACT(x2,VAL(x2)~Fstr(FBN['Cantidad'],0,4)~", "~Fstr(FBN['Cantidad'],0,4)~", ")
        ACT(x2,VAL(x2)~" '"~FBN['TablaFeriados2']~"', ")
        ACT(x2,VAL(x2)~" "~Fstr(VAL(Z9),0,7)~" ") 
    ENDIF

     *** Z3 Nro. Operacion Contado
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     Message(' ---- Generando Operacion Contado  ...')     

     *---- Operacion Contado
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, ")
     SQL.ADD(" Cliente1, ")
     SQL.ADD(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" ValorRB1, Puesto, Observac2, OperacionRef, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6, ")
     SQL.ADD(" Especie, ContraEspecie, Cantidad, ") 
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, TablaFeriados1, Precio1,PaseCB,RB3 ) ")
     SQL.ADD(" Values" )
     SQL.ADD("( '"~Val(z1)~"', '"~Val(z3)~"',")
     SQL.ADD(" '"~FBN['Cliente1']~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaVto'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaPago'])~"', "~Fstr(VAL(Z4),2,0)~", "~Fstr(VAL(Z5),2,0)~", ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~FBN['ValorRB1']~"', '"~FBN['Puesto']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', ")
     SQL.ADD(" "~Fstr(Val(z7),0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', ")
     SQL.ADD(" '"~FBN['MB4']~"', '"~FBN['RB10']~"', '"~VAL(Z6)~"',")
     SQL.ADD(" "~VAL(x1)~",'1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (."ALTAINSTER".)

     *** Z3 Nro. Operacion Futuro
     ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

     Message(' ---- Generando Operacion Futuro  ...')       
     *---- Operacion Futuro
     SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
     SQL.ADD("(TipoOp, NrOperacion, ")
     SQL.ADD(" Cliente1, ")
     SQL.ADD(" FechaOp, FechaVto, FechaPago, Plazo, Plazo2, ")
     SQL.ADD(" Operador, Vehiculo1, ")
     SQL.ADD(" ValorRB1, Puesto, Observac2, OperacionRef, ")
     SQL.ADD(" Precio4, ")
     SQL.ADD(" UsrInput, FechaCarga,Vehiculo2,MB4,RB10,CB6, ") 
     SQL.ADD(" Especie, ContraEspecie, Cantidad, ") 
     SQL.ADD(" TotalBrutoCli1, TotalNetoCli1, TablaFeriados1, Precio1,PaseCB,RB3 ) ")
     SQL.ADD("Values")
     SQL.ADD("('"~Val(z2)~"', '"~Val(z3)~"', ")
     SQL.ADD(" '"~FBN['Cliente1']~"' , ")
     SQL.ADD(" '"~IdxDate(FBN['FechaOp'])~"', '"~IdxDate(FBN['FechaVto'])~"', ")
     SQL.ADD(" '"~IdxDate(FBN['FechaPago'])~"', "~Fstr(FBN['Plazo3'],2,0)~", "~Fstr(FBN['Plazo4'],2,0)~", ")
     SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Vehiculo1']~"', ")
     SQL.ADD(" '"~FBN['ValorRB1']~"', '"~FBN['Puesto']~"', ")
     SQL.ADD(" '"~FBN['Observac2']~"', '"~FBN['NrOperacion']~"', ")
     SQL.ADD(" "~Fstr(Val(z7),0,7)~", ")     
     SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', '"~FBN['Vehiculo2']~"', ")
     SQL.ADD(" '"~FBN['MB4']~"', '"~FBN['RB10']~"','"~VAL(Z16)~"',")
     SQL.ADD(" "~VAL(x2)~",'1','"~FBN['RB3']~"' ) ")
     SQL.NEW

     * Insert de Instancias: Deja la Operacion en Terminal
     (."ALTAINSTER".)

     *** Marco la Operacion de Arbitraje como Generada Indicador RB1
     SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET RB1 = '1' ")
     SQL.ADD(" Where (NrOperacion = '"~FBN['NrOperacion']~"')  ")
     SQL.NEW    
     SQL.EXEC
   proximo

   IF VAL(A1)=0
      MessageBox('Operacion Generada con Anterioridad !!!')
   ENDIF
endif