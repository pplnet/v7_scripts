repetir
  ACN(x1,0)
  CrearDialogo
    String1  : 'Tipo Neg ' ;1;1;;  ;  ;NoVacio(Dialogo.String1) y Incluido(Dialogo.String1,Var('TIPONEGOCT'));'Debe ingresar Tipo Negociacion OCT';NO;'O';;;;'X'
    Especie1 : 'Especie'   ;2;1;;  ;  ;NoVacio(Dialogo.Especie1);'Debe ingresar una especie';NO;
    Fecha1   : 'Fecha Liq.';3;1;;  ;  ;Dialogo.Fecha1>0;'Debe ingresar una fecha valida';NO;
    Check1   : 'Procesa'   ;3;2;;NO;NO;;;;1;
  FinDialogo
  if Not OK
    Cancelar
  endif

  ACT(a:1, 'Tipo Neg')
  ACT(a:2, 'Especie')
  ACT(a:3, 'Fecha Liq.')
  ACT(a:4, 'Especie MAE')
  ACT(a:5, 'Especie MTM')
  ACT(a:6, 'Cant.Plazo')
  ACT(a:7, 'Variable')
  ACT(a:8, 'NroPlazo')
  ACT(a:9, 'Habilitado')
  ACT(a:10, 'Hab.Nuevo')
  ACT(a:11, 'Procesa')

  ACN(b:11, Dialogo.Check1)
  ACT(b:1, Dialogo.String1)
  ACT(b:2, Dialogo.Especie1)
  ACD(b:3, Dialogo.Fecha1)
  ACT(b:4, SQL("Select EspecieOrigen From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieDestino1 = '"~Val(b:2)~"' and TipoNegociacion = '"~Val(b:1)~"' and TipoCotizacion = 'O' "))
  if Vacio(Val(b:4))
    MessageBox('No existe EspecieOrigen para especie '~Val(b:2))
    ACN(x1,1)
  endif
  ACT(b:5, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieDestino1 = '"~Val(b:2)~"' and TipoNegociacion = '"~Val(b:1)~"' and TipoCotizacion = 'O' and EspecieOrigen = '"~Val(b:4)~"' "))
  if Vacio(Val(b:5)) y Val(x1)=0
    MessageBox('No existe EspecieDestino2 para especie '~Val(b:2))
    ACN(x1,1)
  endif
  ACN(b:6, SQL("Select Count(*) From "~DBO~".PLAZOSOCT Where TipoNegociacion = '"~Val(b:1)~"' and Especie = '"~Val(b:2)~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' "))
  if Val(b:6)>1 y Val(x1)=0
    MessageBox('Existe mas de un registro en PLAZOSOCT')
    ACN(x1,1)
  endif
  if Val(x1)=0
    Break
  endif
proximo
if Dialogo.Check1=0
  HojaVisible(SI)
endif
if Val(b:6)=0
  ** No existe registro
  CrearDialogo
    String2  : 'Variable'  ;4;1;;  ;  ;NoVacio(Dialogo.String2);'Debe ingresar el campo Variable';NO;;;;;'XXXXXXX'
    String1  : 'Tipo Neg ' ;1;1;;NO;  ;NoVacio(Dialogo.String1) y Incluido(Dialogo.String1,Var('TIPONEGOCT'));'Debe ingresar Tipo Negociacion OCT';NO;Val(b:1);;;;'X'
    Especie1 : 'Especie'   ;2;1;;NO;  ;NoVacio(Dialogo.Especie1);'Debe ingresar una especie';NO;Val(b:2);
    Fecha1   : 'Fecha Liq.';3;1;;NO;  ;Dialogo.Fecha1>0;'Debe ingresar una fecha valida';NO;Fecha(Val(b:3));
    Check1   : 'Procesa'   ;3;2;;NO;NO;;;;Val(b:11);
  FinDialogo
  if Not OK
    Cancelar
  endif
  ACT(b:7, Dialogo.String2)
  if Dialogo.Check1=1
    Message('Insert PLAZOSOCT')
    SQL.ADD("Insert into "~DBO~".PLAZOSOCT ")
    SQL.ADD("(Especie,TipoNegociacion,Fecha,Variable,NroPlazo,Habilitado)")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(b:2)~"', '"~Val(b:1)~"', '"~IdxDate(Val(b:3))~"', '"~Val(b:7)~"', 0, 'SI' )")
    SQL.NEW
  else
    MessageBox('Insert PLAZOSOCT')
  endif
  ACN(x2,1)
endif
if Val(b:6)=1
  ** Modificacion registro
  ACT(b:7, SQL("Select Variable From "~DBO~".PLAZOSOCT Where TipoNegociacion = '"~Val(b:1)~"' and Especie = '"~Val(b:2)~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' "))
  ACN(b:8, SQL("Select NroPlazo From "~DBO~".PLAZOSOCT Where TipoNegociacion = '"~Val(b:1)~"' and Especie = '"~Val(b:2)~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' "))
  ACT(b:9, SQL("Select Habilitado From "~DBO~".PLAZOSOCT Where TipoNegociacion = '"~Val(b:1)~"' and Especie = '"~Val(b:2)~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' "))
  if EqStr(Val(b:9),'SI')
    ACN(c:9, 1)
  else
    ACN(c:9, 0)
  endif
  CrearDialogo
    Radio1   : 'Habilitado|NO|SI';6;1;;  ;  ;;;;Val(c:9);
    String1  : 'Tipo Neg ' ;1;1;;NO;  ;NoVacio(Dialogo.String1) y Incluido(Dialogo.String1,Var('TIPONEGOCT'));'Debe ingresar Tipo Negociacion OCT';NO;Val(b:1);;;;'X'
    Especie1 : 'Especie'   ;2;1;;NO;  ;NoVacio(Dialogo.Especie1);'Debe ingresar una especie';NO;Val(b:2);
    Fecha1   : 'Fecha Liq.';3;1;;NO;  ;Dialogo.Fecha1>0;'Debe ingresar una fecha valida';NO;Fecha(Val(b:3));
    Check1   : 'Procesa'   ;3;2;;NO;NO;;;;Val(b:11);
    String2  : 'Variable'  ;4;1;;NO;  ;NoVacio(Dialogo.String2);'Debe ingresar el campo Variable';NO;Val(b:7);;;;'XXXXXXX'
    Entero1  : 'Nro.Plazo' ;5;1;;NO;  ;;;;Val(b:8);;;;'999'
  FinDialogo
  if Not OK
    Cancelar
  endif
  ACN(c:10, Dialogo.Radio1)
  if Val(c:10)<>Val(c:9)
    if Val(c:10)=0
      ACT(b:10, 'NO')
    else
      ACT(b:10, 'SI')
    endif
    if Dialogo.Check1=1
      Message('Update PLAZOSOCT (Estado)')
      SQL.ADD("Update "~DBO~".PLAZOSOCT ")
      SQL.ADD("   Set Habilitado      = '"~Val(b:10)~"' ")
      SQL.ADD(" Where TipoNegociacion = '"~Val(b:1)~"' ")
      SQL.ADD("   and Especie         = '"~Val(b:2)~"' ")
      SQL.ADD("   and Fecha           = '"~IdxDate(Val(b:3))~"' ")
      SQL.ADD("   and Variable        = '"~Val(b:7)~"' ")
      SQL.NEW
    else
      MessageBox('Update PLAZOSOCT (Estado)')
    endif
    ACN(x2,1)
  endif
endif
if Val(x2)=1
  if Dialogo.Check1=1
    Message('Ejecuta Evento OCTNPZ')
    SQL.EXEC
    */Llamado al Evento que asigna los plazos.
    EjecutarEvento('OCTNPZ', Especie1=Val(b:2), String1=Val(b:1))
  else
    MessageBox('Ejecuta Evento OCTNPZ')
  endif
endif

ACO(1,10)
ACO(2,10)

IF NO
*/*******************************************************************
*/Interpreto los Registros 2102 y Completo la tabla PLAZOSOCT       *
*/*******************************************************************

AbrirASCII(Val(z2)~'\REC-2102.TXT',0)
EscribirASCII(Val(A:fac))
CerrarASCII

**********************************************************
*/00560000000408201337543450421021ODOLAR$24 AGO 0000000009
*/Bloque de Control
*/0056000000040820133754345042102
*/Codigo de Movimiento ==>  1 (1- baja 2- alta)
*/Codigo de Negociacion ==> O
*/Codigo de Titulo ==> DOLAR
*/Moneda ==> $
*/Variable ==> 24 AGO 
*/Fecha de Liquidacion  ==> 00000000 (0 en baja - fecha en alta)
*/Dueño de la info ==> 09
**********************************************************
BorrarCeldas(s:1..t:25)
ACN(x1,0)
ACT(s:1, 'Movimiento')
ACT(s:2, 'Tipo Neg')
ACT(s:3, 'Especie')
ACT(s:4, 'Variable')
ACT(s:5, 'FechaLiq')
ACT(s:22, 'Especie MAE')
ACT(s:25, 'Cuantos')

ACN(t:1, Num(Copy(Val(A:fac),32,1)))
if NOT [Val(t:1)>=0 y Val(t:1)<=3] 
  if Val(x1)=0
    ACT(y5, Pad('Movimiento Invalido',40))
  endif
  ACN(x1,1)      
endif
         
ACT(t:2, Trim(Copy(Val(A:fac),33,1)))
if Not Incluido(Val(t:2),Var('TIPONEGOCT'))
  if Val(x1)=0
    ACT(y5, Pad('Tipo de Negociacion PLAZOS invalido '~Val(t:2),40))
  endif
  ACN(x1,1)      
endif
         
ACT(t:22, Trim(Copy(Val(A:fac),34,5)))
ACT(t:3, SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:22)~"' and TipoNegociacion = '"~Val(t:2)~"' "))  
if Vacio(Val(t:3))
  if Val(x1)=0
    ACT(y5, Pad('Especie Destino PLAZOS Inexistente',40))
  endif
  ACN(x1,1)      
endif
         
ACT(t:4, Trim(Copy(Val(A:fac),40,7)))
if Vacio(Val(t:4))
  if Val(x1)=0
    ACT(y5, Pad('Campo Variable PLAZOS Null',40))
  endif
  ACN(x1,1)      
endif
         
ACN(t5, Fecha(Copy(Val(A:fac),53,2)~'/'~Copy(Val(A:fac),51,2)~'/'~Copy(Val(A:fac),47,4)))
if Val(t:5)=0 
  if Val(x1)=0
    ACT(y5, Pad('Fecha Liquidacion PLAZOS Invalida',40))
  endif
  ACN(x1,1)      
endif
         
if Val(x1)=0
  If Val(t:1)=2
    */Alta de Plazo
    ACN(t:25, SQL("Select Count('*') from  "~DBO~".PLAZOSOCT Where TipoNegociacion='"~Val(t:2)~"' and Especie='"~Val(t:3)~"' and Variable= '"~Val(t:4)~"' "))
    if Val(t:25)=0
      */Alta de Plazo
      Message('Insert PLAZOSOCT (Alta)')
      SQL.ADD("Insert into "~DBO~".PLAZOSOCT ")
      SQL.ADD("(Especie,TipoNegociacion,Fecha,Variable,NroPlazo,Habilitado)")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Val(t:3)~"', '"~Val(t:2)~"', '"~IdxDate(Val(t:5))~"', '"~Val(t:4)~"', 0, 'SI' )")
      SQL.NEW
    Else
      */Alta de Plazo Existente
      Message('Update PLAZOSOCT (Alta existente)')
      SQL.ADD("Update "~DBO~".PLAZOSOCT ")
      SQL.ADD("   Set Habilitado      = 'SI', ")
      SQL.ADD("       Fecha           = '"~IdxDate(Val(t:5))~"' ")
      SQL.ADD(" Where TipoNegociacion = '"~Val(t:2)~"' ")
      SQL.ADD("   and Especie         = '"~Val(t:3)~"' ")
      SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
      SQL.NEW
    Endif
  Endif
  If Val(t:1)=1
    */Baja de Plazo
    Message('Update PLAZOSOCT (Baja)')
    SQL.ADD("Update "~DBO~".PLAZOSOCT ")
    SQL.ADD("   Set Habilitado      = 'NO' ")
    SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
    SQL.NEW
  Endif
  If Val(t:1)=3
    */Modificacion de Plazo (Solo Existen Modificaciones de Fecha de Liquidacion)
    Message('Update PLAZOSOCT (Modif.)')
    SQL.ADD("Update "~DBO~".PLAZOSOCT ")
    SQL.ADD("   Set Fecha           = '"~IdxDate(Val(t:5))~"' ")
    SQL.ADD(" Where TipoNegociacion = '"~Val(t:2)~"' ")
    SQL.ADD("   and Especie         = '"~Val(t:3)~"' ")
    SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
    SQL.NEW
  Endif
  SQL.EXEC
  */Llamado al Evento que asigna los plazos.
  Message('Ejecuta Evento OCTNPZ')
  EjecutarEvento('OCTNPZ', Especie1=Val(t:3), String1=Val(t:2))
else
  Message('*/Grabo en el Log de Errores')
  */Fecha 
  ACN(Y1, Ahora)
  ACT(Y2, Hora(Val(Y1)))
  ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
  ***** Fecha
  ACT(y4, Val(Y3))
  ***** Hora
  ACT(y4, Val(y4)~Copy(Val(Y2),1,2))
  ACT(y4, Val(y4)~Copy(Val(Y2),4,2))
  ACT(y4, Val(y4)~Copy(Val(Y2),7,2))
  */Codigo de Registro
  ACT(y4, Val(y4)~Copy(Val(A:fac),28,4))
  */Motivo
  ACT(y4, Val(y4)~Val(y5))
  */Contenido
  ACT(y4, Val(y4)~Val(A:fac))
  AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
  EscribirASCII(Val(y4))
  CerrarASCII
endif 
ENDIF
