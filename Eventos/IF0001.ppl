CrearDialogo
  Fecha1   : 'Fecha'                    ;1;1;;;;;;;;FSYS
  Vehiculo1: 'Vehiculo'                 ;;1;;;;VACIO(Dialogo.Vehiculo1) o Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo));'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  String   : 'Camino/Path'              ;;1;;;;NOVACIO(Dialogo.String);'Nombre de path INVALIDO';NO;VAR('CAPTRF');;;;;;;;;NO
  Radio1   : 'Extrae|Todas|Solo nuevas' ;;;;;;;;;1
  Radio2   : '?Crea excel?|Si|No'       ;;;;;;;;;0
  Radio3   : 'Sist.Oper.|W98|NT'        ;;;;;;;;;1;
FinDialogo

If Not Ok
   Cancelar
EndIf

EjecutarEvento('IN0001',Fecha1=Dialogo.Fecha1,Vehiculo1=Dialogo.Vehiculo1,String=Dialogo.String,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2)
EjecutarEvento('IN0009',Fecha1=Dialogo.Fecha1,Vehiculo1=Dialogo.Vehiculo1,String=Dialogo.String,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2)
EjecutarEvento('IN0011',Fecha1=Dialogo.Fecha1,Vehiculo1=Dialogo.Vehiculo1,String=Dialogo.String,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2)
EjecutarEvento('FTPIN1',Radio1=Dialogo.Radio3)
