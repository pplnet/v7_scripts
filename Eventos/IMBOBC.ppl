CrearDialogo
  Fecha1 : 'Fecha Desde'                        ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;Fsys;
  Fecha2 : 'Fecha Hasta'                        ;1;2;;;;Dialogo.Fecha2 <> 0;'Fecha Hasta Invalida';NO;Fsys;
  Radio5 : 'Salida|Impresion|Pantalla'            ;2;1;;;;;;;1
  Radio6 : 'Estado|Todas|Vig|Anul'                ; ;1;;;;;;;0 
FinDialogo

If Not Ok
  Cancelar
Endif

If Dialogo.Radio6 <= 1
   *- Boletos Vigentes
   SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie1,")
   SQL.ADD("T.Cliente1,T.Ley5 as NrCUIT,T.Ley2 as Direccion,T.Ley3 as Localidad,")
   SQL.ADD("T.CEmpresa1 as Provincia,T.CEmpresa2 as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
   SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
   SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
   SQL.ADD("T.Ley4 as Pagador,T.Cuenta1,T.Ley1 as Domicilio,T.CEmpresa4 as PaisPagador,T.Cambio4 as CodSwifPag,")
   SQL.ADD("CB.Descripcion,'Vigente' as Estado,C.RazonSocial ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".CLIENTES C, "~DBO~".CONCEPTOSBCRA CB ")
   SQL.ADD("WHERE ")
   SQL.ADD(" T.Cliente1 = C.Codigo AND ")
   SQL.ADD(" T.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD(" T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
   SQL.ADD(" T.TipoTr2 = 'BOBCRA' AND ")
   SQL.ADD(" T.Cambio1 = CB.Codigo  ")
EndIf
If Dialogo.Radio6 = 0 
   SQL.ADD(" Union All ")
EndIf
If Dialogo.Radio6 = 2 o Dialogo.Radio6 = 0 
   *- Boletos Anulados
   SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie1,")
   SQL.ADD("T.Cliente1,T.Ley5 as NrCUIT,T.Ley2 as Direccion,T.Ley3 as Localidad,")
   SQL.ADD("T.CEmpresa1 as Provincia,T.CEmpresa2 as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
   SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
   SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
   SQL.ADD("T.Ley4 as Pagador,T.Cuenta1,T.Ley1 as Domicilio,T.CEmpresa4 as PaisPagador,T.Cambio4 as CodSwifPag,")
   SQL.ADD("CB.Descripcion,'Anulado' as Estado,C.RazonSocial ")
   SQL.ADD("FROM "~DBO~".BTRANSACCIONES2 T,"~DBO~".CLIENTES C, "~DBO~".CONCEPTOSBCRA CB ")
   SQL.ADD("WHERE ")
   SQL.ADD(" T.Cliente1 = C.Codigo AND ")
   SQL.ADD(" T.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD(" T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
   SQL.ADD(" T.TipoTr2 = 'BOBCRA' AND ")
   SQL.ADD(" T.Cambio1 = CB.Codigo ")
EndIf
SQL.ADD("   ORDER BY 1")

ACN(az1, 4)
SetFilaActual(Val(az1))

Recorrer SQL

   SCN(az1, 1)
   ACN(z:fac , 1)
   ACT(aa:fac, FBN['Estado'])
   ACT(ab:fac, FBN['NrTrans'])
   ACD(ac:fac, FBN['Fecha1'])
   ACT(ad:fac, FBN['Especie1'])
   ACT(ae:fac, FBN['Cliente1']~' '~FBN['RazonSocial'])
   ACN(af:fac, FBN['Importe'])
   ACN(ag:fac, FBN['Tipo'])
   ACT(ah:fac, FBN['Operacion'])
   ACT(ai:fac, FBN['Cliente1'])

Proximo

IF Val(az1) >4 

   CrearListBox ; 'MS Arial,8,';val(a1)
      'Marca'           ; z5..z:Val(az1);SI;SI;; 30;CHECK;RGB(220,220,193)
      'Tipo Trans.'     ; ag5..ag:Val(az1);NO;SI;;45;COMBO;'Compra|Venta|';RGB(180,180,193)
      'Boleto   '       ; ab5..ab:Val(az1);NO;SI;;60;STRING;;RGB(180,180,193)
      'OpRef'           ; ah5..ah:Val(az1);NO;SI;;60;STRING;;RGB(180,180,193)
      'Fecha'           ; ac5..ac:Val(az1);NO;SI;;60;FECHA;RGB(180,180,193)
      'Especie'         ; ad5..ad:Val(az1);NO;SI;;45;STRING;;RGB(180,180,193)
      'Cliente'         ; ae5..ae:Val(az1);NO;SI;;180;STRING;;RGB(180,180,193)
      'Cantidad'        ; af5..af:Val(az1);NO;SI;;90;NUMERO;'##,###,###.##';RGB(180,180,193)
      'Estado  '        ; aa5..aa:Val(az1);NO;SI;;90;STRING;;RGB(180,180,193)
   FinListBox
             
   IF Ok           
      Recorrer&j 5, Val(az1)         
          IF val(z:&j)=1 
             IF val(ag:&j)=1
                *- Boleto de Venta
                LinkearHoja('IMBCRV',1,NrTrans1=val(ab:&j),Radio5=Dialogo.Radio5)
             Else
                *- Boleto de Compra
                LinkearHoja('IMBCRC',1,NrTrans1=val(ab:&j),Radio5=Dialogo.Radio5)
             EndIf
          EndIf
      Proximo
   ENDIF
ELSE
   MessageBox('No se encontraron Transacciones BOBCRA con esas especificaciones!!! ')
ENDIF
