****** Toma las operaciones que no esten en Anulacion ******
SQL.ADD("SELECT Cliente1, TipoOp, ContraEspecie, Sum(TotalNetoCli1) as Cant,Count(*) as Cuantos ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O WITH (NOLOCK) INNER JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON O.NrOperacion=B.NrOperacion ")
SQL.ADD("                             INNER JOIN "~DBO~".CLIENTES CL WITH (NOLOCK) ON CL.Codigo=O.Cliente1 ")
SQL.ADD("                             INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("WHERE  Vehiculo1 = '"~Dialogo.Vehiculo1~"' ") 
SQL.ADD("       and  B.NrBit=30 and B.Valor='0' ")
SQL.ADD("       and  FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and  TipoOp In ('TIC','TIFC','TIV','TIFV') ")
SQL.ADD("       and  E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
SQL.ADD("       and  Cliente1<>'"~Dialogo.Vehiculo1~"'  ")
**SQL.ADD("       and  CL.CategDepositante <>'BAN' ")
SQL.ADD("GROUP BY Cliente1, TipoOp, ContraEspecie ")
SQL.ADD("UNION ALL")
SQL.ADD("SELECT Cliente1, TipoOp, ContraEspecie, Sum(TotalNetoCli1) as Cant,Count(*) as Cuantos ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O WITH (NOLOCK) INNER JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON O.NrOperacion=B.NrOperacion ")
SQL.ADD("                             INNER JOIN "~DBO~".CLIENTES CL WITH (NOLOCK) ON CL.Codigo=O.Cliente1 ")
SQL.ADD("                             INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ON O.Especie=E.Codigo ")
SQL.ADD("WHERE  Vehiculo1 = '"~Dialogo.Vehiculo1~"' ") 
SQL.ADD("       and  B.NrBit=30 and B.Valor='0' ")
SQL.ADD("       and  FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and  TipoOp In ('CTP','VTP','CFTP','VFTP','CTC','VTC','CFTC','VFTC') ")
SQL.ADD("       and  E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
SQL.ADD("       and  Cliente1<>'"~Dialogo.Vehiculo1~"'  ")
**SQL.ADD("       and  CL.CategDepositante <>'BAN'        ")
SQL.ADD("GROUP BY Cliente1, TipoOp, ContraEspecie ")
SQL.ADD("ORDER BY Cliente1,ContraEspecie  ")
watch(sql.batch())
ACT(u1,' ')
ACN(kk1,0)

Recorrer SQL
**MessageBox(fbn('Cliente1'))
   If Val(kk1) = 0    
      ACT(u1,FBN['Cliente1'])
      ACN(kk1,1)
   Endif
      
   If Not Eqstr(Val(u2),FBN['ContraEspecie'])
      If Not EqStr(FBN['ContraEspecie'], val(ml3))
         *-- Cotizacion de la contraespecie en Pesos
         ACN(cf:1, CotizacionC(FBN['ContraEspecie'],,,,FSys,1,SI,val(ml3)))
         ACT(u2,FBN['ContraEspecie'])
      Else
         ACN(cf:1, 1)
         ACT(u2,FBN['ContraEspecie'])
      EndIf
   EndIf

   *-- Corte por Cliente   
   If Not Eqstr(Val(u1),FBN['Cliente1'])           
      *-- Controla si supera el monto minimo     
      If Val(tt1) >= Dialogo.Cantidad1
         Message('Cliente '~Val(u1))
         SQL.ADD("SELECT C.Codigo,C.RazonSocial,C.CUIT,C.Direccion,")
         SQL.ADD("C.Localidad,C.Provincia,C.CodigoPostal,C.Persona,C.TipoInscripcion,C.PaisDir,")
         SQL.ADD(" I.TipoDocumento, I.NrDocumento,I.TipoPoder,I.Status FROM "~DBO~".CLIENTES C WITH (NOLOCK) LEFT OUTER JOIN "~DBO~".INTEGRANTESCLI I WITH (NOLOCK)")
         SQL.ADD(" ON C.Codigo=I.Codigo WHERE C.Codigo = '"~Val(u1)~"'  ")
             
         Recorrer SQL
           ACT(aa:Val(li2),fbn['Codigo'])
           ACT(ab:Val(li2),fbn['RazonSocial'])
           IF EqStr(fbn['TipoPoder'],'TIT') y EqStr(fbn['Status'],'VIG')
              ACT(ac:Val(li2),fbn['TipoDocumento'])
              ACT(ad:Val(li2),fbn['NrDocumento'])
           EndIf
           ACT(ae:Val(li2),ReemplazarStr(fbn['CUIT'],'-','',SI))
           ACT(af:Val(li2),fbn['Direccion'])
           ACT(ag:Val(li2),fbn['Localidad'])
           ACT(ah:Val(li2),fbn['Provincia'])
           ACT(ai:Val(li2),fbn['CodigoPostal'])
           ACT(aj:Val(li2),fbn['Persona'])
           ACT(ao:Val(li2),fbn['TipoInscripcion'])
           ACT(ar:Val(li2),fbn['PaisDir'])
           SCN(ak:Val(li2),1)
         Proximo

         SCN(ak:Val(li2),1)            
         ACN(al:Val(li2),Val(tc1))
         ACN(am:Val(li2),Val(tv1))
         ACN(an:Val(li2),Val(cc1))
         ACN(ap:Val(li2),Val(cv1))
         SCN(li2,1)   

         ACN(tc1,0)
         ACN(tv1,0)
         ACN(tt1,0)
         ACN(cv1,0)
         ACN(cc1,0)
      Endif
   EndIf         
  
   ACT(u1, FBN['Cliente1'])        
   Message(val(u1)~' li2 '~Fstr(val(li2),0,0))      

   If Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CFTC|TIC|TIFC')
      If EqStr(FBN['ContraEspecie'], val(ml2))
         SCN(tc1,FBN['Cant']*Val(cf:1)) 
         SCN(cc1,FBN['Cuantos']) 
      Else
         SCN(tc1,FBN['Cant']) 
         SCN(cc1,FBN['Cuantos'])
      Endif                
   Else
      If EqStr(FBN['ContraEspecie'], val(ml2))
         SCN(tv1,FBN['Cant']*Val(cf:1)) 
         SCN(cv1,FBN['Cuantos']) 
      Else
         SCN(tv1,FBN['Cant']) 
         SCN(cv1,FBN['Cuantos']) 
      Endif
  Endif
          
  If EqStr(FBN['ContraEspecie'], val(ml2))
     SCN(tt1,FBN['Cant']*Val(cf:1))            
  Else
     SCN(tt1, FBN['Cant'])
  Endif
Proximo

If Val(tt1) >= Dialogo.Cantidad1
   * MessageBox('El Cliente '~Val(u1)~' supero en '~Val(tt1))
   SQL.ADD("SELECT C.Codigo,C.RazonSocial,C.CUIT,C.Direccion,C.Localidad,")
   SQL.ADD("C.Provincia,C.CodigoPostal,C.Persona,C.TipoInscripcion,C.PaisDir,I.TipoDocumento, ")
   SQL.ADD("I.NrDocumento,I.TipoPoder,I.Status FROM "~DBO~".CLIENTES C LEFT OUTER JOIN "~DBO~".INTEGRANTESCLI I ")
   SQL.ADD("ON C.Codigo=I.Codigo WHERE C.Codigo = '"~Val(u1)~"'  ")
   
   Recorrer SQL
      ACT(aa:Val(li2),fbn['Codigo'])
      ACT(ab:Val(li2),fbn['RazonSocial'])
      IF EqStr(fbn['TipoPoder'],'TIT') y EqStr(fbn['Status'],'VIG')
         ACT(ac:Val(li2),fbn['TipoDocumento'])
         ACT(ad:Val(li2),fbn['NrDocumento'])
      EndIf
      ACT(ae:Val(li2),Reemplazar(fbn['CUIT'],'-',''))
      ACT(af:Val(li2),fbn['Direccion'])
      ACT(ag:Val(li2),fbn['Localidad'])
      ACT(ah:Val(li2),fbn['Provincia'])
      ACT(ai:Val(li2),fbn['CodigoPostal'])
      ACT(aj:Val(li2),fbn['Persona'])
      ACT(ao:Val(li2),fbn['TipoInscripcion'])
      ACT(ar:Val(li2),fbn['PaisDir'])   
      SCN(ak:Val(li2),1)
   Proximo

   SCN(ak:Val(li2),1)
   
   ACN(al:Val(li2),Val(tc1))
   ACN(am:Val(li2),Val(tv1))
   ACN(an:Val(li2),Val(cc1))
   ACN(ap:Val(li2),Val(cv1))

   ACN(tc1,0)
   ACN(tv1,0)
   ACN(tt1,0)
   ACN(cv1,0)
   ACN(cc1,0)
Else 
   *- Si el ultimo Cliente no supera el monto a controlar decremento la linea li2
   SCN(li2,-1)
Endif

**********************************
* Fin funcion
**********************************


SetFilaActual(Val(zz1))

Recorrer&j Val(li1),Val(li2) 
   Ifa
   ACT(a:fac,Val(aa:&j))
   ACT(b:fac,Val(ab:&j))
   ACT(c:fac,Val(ac:&j))
   ACT(d:fac,Val(ad:&j))
   ACT(e:fac,Val(ae:&j))
   ACT(f:fac,Val(af:&j))
   ACT(g:fac,Val(ag:&j))
   ACT(h:fac,Val(ah:&j))
   ACT(i:fac,Val(ai:&j))
   ACT(j:fac,Val(aj:&j))
   ACN(k:fac,Val(ak:&j))
   ACN(l:fac,Val(al:&j))
   ACN(m:fac,Val(am:&j))
   ACN(n:fac,Val(an:&j))
   ACN(o:fac,Val(ap:&j))

   SetFont(a:FAC..s:FAC,1)
   FormatoCeldas(k:fac..o:fac,Exe('F0'))
Proximo

ACT(nc1, BuscarCampo('CLIENTES','CUIT','Codigo',BuscarCampo('VEHICULOS','Cliente','Codigo',Var('VEHICULODE')) ) )
ACT(nc1, ReemplazarStr(val(nc1),'-','',SI))

Message(' - Borrando Archivo Siter Anual ')

* Borro Archivo Anterior
IF Dialogo.Radio2=1 y ExisteArchivo(Dialogo.String1~Dialogo.String2) 
   IF Dialogo.Radio3 = 0
      WinExec('COMMAND.COM /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ELSE
      WinExec('CMD.EXE /C DEL '~Dialogo.String1~Dialogo.String2, 0)
   ENDIF

   ***---A veces ejecuta lo que sigue y el S.O. todavia no borro el archivo
   Esperar(3)
EndIf

* Creo el archivo 
IF Dialogo.Radio2=1 
   ACT(aa1, Dialogo.String1~Dialogo.String2)

   Message('Creando Archivo '~Dialogo.String2)

   AbrirASCII(val(aa1),0)
EndIf

****************************************************************************************
*ACT(x1,Copy(Dialogo.Fecha1,9,4)~'.txt')
*ACT(to1, VAR('SITERANUAL'))

*Borro Archivo Anterior 
*BorrarArchivo(Val(to1)~Val(x1))  

*Creando Archivo Siter
*AbrirASCII(Val(to1)~Val(x1),0)
****************************************************************************************

ACN(cr1,0)
ACN(tc1,0)
ACT(rc1,'')

Message(' - Generando Archivo Siter Anual ')
Message(' - Generando Registro Tipo 1  ')

*************************************************
*       Registro 1   DATOS  DEL INFORMANTE      *
*************************************************
* Cabecera 
ACT(rc1,'10160')
If Dialogo.Radio1 = 0
   ACT(rc1,Val(rc1)~'O00000000')
Else
   ACT(rc1,Val(rc1)~'R'~Copy(Fecha(Dialogo.Fecha3),1,2)~Copy(Fecha(Dialogo.Fecha3),4,2)~Copy(Fecha(Dialogo.Fecha3),7,4) )
Endif  

* Denominacion del informante
ACT(rc1,Val(rc1)~VAL(nc1)~Pad(Mayusculas2(Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',Var('VEHICULODE')),1,25)),25))

* Banco 
ACT(rc1,Val(rc1)~'02')  
     
* Tipo de Persona 
ACT(rc1,Val(rc1)~'1')

* Ao informado 
ACT(rc1,Val(rc1)~Copy(Dialogo.Fecha1,7,4))  
      
* Filler 
ACT(rc1,Val(rc1)~Pad(' ',143))

SCN(cr1,1)

EscribirASCII(Val(rc1))

*******************************************
*     Registro 2  * Titular Informado     *
*******************************************
Message(' - Generando Registro Tipo 2  ')

Recorrer&j Val(li1),Val(li2)
   * Cabecera 
   ACT(rr1,'20160')
   
   * Nro. Cuit
   ACT(rr1,Val(rr1)~Val(nc1))
   
   * Apellido del Informado
   ACT(rr1,Val(rr1)~PAD(Copy(Val(ab:&j),1,25),25) )
   
   * Tipo de Persona 
   If Eqstr(Val(aj:&j),'SI')
      ACT(rr1,Val(rr1)~'2')             
   Else  
      ACT(rr1,Val(rr1)~'1')
   Endif
    
   * Tipo y Nro  de Documento
   ACT(td1,' ')
   
   If NoVacio(Val(ao:&j)) 
      If Eqstr(Val(ao:&j),'CIT') 
         ACT(td1,'80'~Pad0(Copy(val(ae:&j),1,11),11) )                      
      Else      
         ACT(td1,'86'~Pad0(Copy(val(ae:&j),1,11),11) )                      
      Endif
   Else
      If not Eqstr(Val(ar:&j),'80')        
         ACT(td1,'94'~Pad0(val(ad:&j),11) ) 
         If Eqstr(Val(aj:&j),'SI')  
            ACT(pi1,BuscarCampo('PAISES','CodPersonaFisica','Codigo',Val(ar:&j)))
         Else
            ACT(pi1,BuscarCampo('PAISES','CodPersonaJuridica','Codigo',Val(ar:&j)))
         Endif  
         ACT(td1,'80'~Pad0(val(pi1),11) ) 
      Else
         If Eqstr(Val(ac:&j),'DNI') 
            ACT(td1,'96'~Pad0(val(ad:&j),11) )                              
         Else
            If Eqstr(Val(ac:&j),'LE') 
               ACT(td1,'90'~Pad0(val(ad:&j),11) )       
            Else
               If Eqstr(Val(ac:&j),'LC')         
                  ACT(td1,'89'~Pad0(val(ad:&j),11) )       
               Else
                  If Eqstr(Val(ac:&j),'CI')
                     ACT(td1,Pad0(FSTR(NUM(Val(ah:&j)),1,0),2)~Pad0(val(ad:&j),11) )                        
                  Else
                     ACT(td1,'9999999999999' )                                         
                  Endif 
               Endif    
            Endif
         Endif    
      Endif
   Endif
   
   ACT(rr1,Val(rr1)~Val(td1) )                      
   
   * Domicilio
   ACT(rr1,Val(rr1)~Pad(Copy(Val(af:&j)~' '~Val(ag:&j),1,51),51)~'1')
   
   * Provincia
   If Vacio(Val(ah:&j))
      ACT(rr1,Val(rr1)~'99')
   Else
      ACT(rr1,Val(rr1)~Pad0(FSTR(NUM(Val(ah:&j)),1,0),2) )
   Endif
    
   * Codigo Postal
   ACT(wk5,Pad0(Fstr(Num(Copy(Val(ai:&j),1,4)),1,0),4))

   If Eqstr(Val(wk5),'0000')
      ACT(rr1,Val(rr1)~'9999')  
   Else        
      If Eqstr(Val(ar:&j),'80')        
         ACT(rr1,Val(rr1)~Val(wk5))  
      Else
         ACT(rr1,Val(rr1)~'9999')  
      Endif
   Endif
   
   * Monto Bruto total de Comprass del periodo 
   ACT(rr1,Val(rr1)~Pad0(FSTR(NUM(Val(al:&j)),1,0),12) )      
   
   * Monto Bruto total de Ventas del periodo 
   ACT(rr1,Val(rr1)~Pad0(FSTR(NUM(Val(am:&j)),1,0),12) ) 
   
   * filler 
   act(rr1,Val(rr1)~Pad(' ',63) ) 
   
   If NoVacio(val(rr1))
      SCN(cr1,1)

      * Total Compras        
      SCN(tc1,Val(an:&j))  

      * Total Ventas        
      SCN(tv1,Val(ap:&j))  

      * Total Montos Compras    
      SCN(mc1,Val(al:&j))  

      * Total Montos Ventas       
      SCN(mv1,Val(am:&j))  

      EscribirASCII(Val(rr1))
   Endif
Proximo

Message(' - Generando Registro Tipo 3  ')
************************************************************
*    Registro 3   Totales de Operaciones del Periodo       *
************************************************************

* Cabecera 
ACT(rc2,'30160')

ACT(rc2,Val(rc2)~Val(nc1))

* Total del Compras del Periodo 
ACT(rc2,Val(rc2)~Pad0(Fstr(Val(tc1),1,0),12)   )  

* Monto Total de Compras correspondiente 
ACT(rc2,Val(rc2)~Pad0(Fstr(Val(mc1),1,0),12) ) 

* Total del Ventas del Periodo 
ACT(rc2,Val(rc2)~Pad0(Fstr(Val(tv1),1,0),12)   )  

* Monto Total de Ventas correspondiente 
ACT(rc2,Val(rc2)~Pad0(Fstr(Val(mv1),1,0),12) ) 

* filler 
ACT(rc2,Val(rc2)~Pad(' ',24) ) 

* Ao informado 
ACT(rc2,Val(rc2)~Copy(Dialogo.Fecha1,7,4))  

* filler 
ACT(rc2,Val(rc2)~Pad(' ',108) ) 
    
SCN(cr1,1)
EscribirASCII(Val(rc2))


Message(' - Generando Registro Tipo 4  ')
************************************************************
*        Registro 4  * de Control del Archivo              *
************************************************************

* Cabecera 
ACT(rc4,'4')

ACT(rc4,Val(rc4)~Val(nc1))

* Ao informado 
ACT(rc4,Val(rc4)~Copy(Dialogo.Fecha1,7,4))  

* Total de Registro  1+2+3 
ACT(rc4,Val(rc4)~Pad0(Fstr(Val(cr1),1,0),12) ) 

* filler 
ACT(rc4,Val(rc4)~Pad(' ',172) ) 

EscribirASCII(Val(rc4))

CerrarASCII 

**************************************************************************************

