AgregarMarco(a:FAC..o:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)
ACT(a:fac,'Compras y Ventas en Titulos ')
SetFont(a:fac..p:FAC,2)

SetFilaActual(FAC+1)
ACN(zz1,Fac)

