
ModoReproceso(ConDialogo)
HojaVisible(SI)
CrearDialogo
   Vehiculo1 : 'Vehiculo'                            ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;VAR('VEHICULODE')
   Fecha1    : 'Fecha Desde'                         ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;Fecha('01/01/'~Fstr(Anio(Fsys)-1,0,0))
   Fecha2    : 'Fecha Hasta'                         ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;Fecha('31/12/'~Fstr(Anio(Fsys)-1+1,0,0))
   Cantidad1 : 'Monto Min. Dolares '                 ;;;;;;;;NO;0
   Radio1    : 'Presentacion|Original|Rectificativa' ;;;;;;;;;0
   Fecha3    : 'Fecha Recti'                         ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;;;;
   Radio2    : "Salida|Informe|Inf+TXT"              ;;;;NO;NO;;;;1
   String1   : 'Path'                                ;;;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;VAR('SITERANUAL');
   String2   : 'Archivo'                             ;;;;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;'RG160'~Copy(Dialogo.Fecha1,9,4)~'.txt';'RG160'~Copy(Dialogo.Fecha1,9,4)~'.txt';
   Radio3    : 'Sist.Oper.|W98|NT'                   ;;;;NO;NO;;;;1; 
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Else
   If [Not Incluido(VAR('VEHICULODE'), UsrVehiculos(UsuarioActivo))] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Endif

If Dialogo.Radio2=1 y Not ExisteDirectorio(Dialogo.String1)
   Messagebox('No existe el path '~Dialogo.String1~'. Debera crearlo.')
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Informe SITER N 160/98  ")
