ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Vehiculo1 )

ACT(a:FAC+3, 'Tipo Op.: TODAS')

ACT(a:FAC+4, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)

If Dialogo.Radio1 = 0
   ACT(e:FAC+2, 'Presentacion: Original')
Else
   ACT(e:FAC+2, 'Presentacion: Retificada')
   ACT(e:FAC+3, 'Fecha Rectif: '~Dialogo.Fecha3)
Endif

ACT(e:FAC+4, 'Monto Min.: '~Dialogo.Cantidad1)

SetFont(a:fac+2..p:FAC+6,2)

SetFilaActual(FAC+7)

Message(' - Generando Reporte ')

ACT(a:FAC, "Cliente")
ACT(b:FAC, "Razon Social")
ACT(c:FAC, "Tip.Doc.")
ACT(d:FAC, "Nro.Doc.")
ACT(e:FAC, "CUIT")
ACT(f:FAC, "Domicilio")
ACT(g:FAC, "Localidad")
ACT(h:FAC, "Provincia")
ACT(i:FAC, "C.Postal")
ACT(j:FAC, "Persona")
ACT(k:FAC, "Cant.Tit.")
ACT(l:FAC, "Compras en Pesos")
ACT(m:FAC, "Ventas en Pesos")
ACT(n:FAC, "Cant.Compras")
ACT(o:FAC, "Cant.Ventas ")

AlinearCeldas(a:FAC..k:FAC,'I')
AlinearCeldas(l:FAC..o:FAC,'D')
