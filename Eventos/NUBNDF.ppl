CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'FXCF|FXVF') y Incluido(BuscarCampo('OPERACIONES','Mercado4','NrOperacion', Dialogo.NrOperacion1),VAR('MENEFFX'));'Operacion Invalida';NO;;;;;;" TipoOp IN ('FXCF','FXVF') and Mercado4  in ("~Pipe2Comillas(VAR('MENEFFX')~"|")~")";
FinDialogo

IF Not OK
    Cancelar
ENDIF

ACT(BL:1, GetNumerador(87))

SQL.ADD(" Update "~DBO~".OPERACIONES ")
SQL.ADD(" Set NrBoleto = '"~Val(BL:1)~"' ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC
