  'Cant.Pendiente'  ; p:1..p:fac ;NO;;;120;NUMERO;'##,###,###,###.##';RGB(250,250,193)
  'Cant. a diferir' ; q:1..q:fac ;SI;(Val(q:flb) > 0 y Val(q:flb) <= Val(p:flb) and Val(a:flb)=1 ) o Val(a:flb)=0;'Cantidad a diferir invalida';120;NUMERO;'##,###,###,###.##';RGB(160,160,193)
