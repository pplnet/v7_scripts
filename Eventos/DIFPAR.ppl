         SQL.ADD("SELECT "~idxdate2(Val(o:&i))~", Cliente, Vehiculo, Sector, ")
         SQL.ADD("       NrSaldo, Especie, FechaEj, PrecioEj, ")
         SQL.ADD("       CallPut, "~Fstr(Val(q:&i)*val(ae:&i),0,2)~", Precio, Estrategia, ")
         SQL.ADD("       Book, TipoNegocio, NrOperacion, Cupon ")
         SQL.ADD("  from "~DBO~".MOVPOSEJE ")
