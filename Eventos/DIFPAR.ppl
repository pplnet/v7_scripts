         if NoVacio(Val(u:&i))
           SQL.ADD(" Status, ")
         endif
         SQL.ADD(" Cupon, NrComprob,    NrGrupo2, Nrinstan ")
         SQL.ADD(" ) values  ( ")
         * NrOperacion
         SQL.ADD(" '"~Val(b:&i)~"', ")
         SQL.ADD(" '"~Val(c:&i)~"', ")
         SQL.ADD(" '"~Val(d:&i)~"', ")
         SQL.ADD(" '"~Val(e:&i)~"', ")
         * EnteCustodia
         SQL.ADD(" '"~Val(f:&i)~"', ")
         SQL.ADD(" '"~Val(g:&i)~"', ")
         SQL.ADD(" "~fstr(Val(h:&i),0,0)~", ")
         SQL.ADD(" '"~Val(i:&i)~"', ")
         * NrMov
         SQL.ADD(" "~Fstr(Val(j:&i),0,0)~", ")
         SQL.ADD(" '"~Val(l:&i)~"', ")
         SQL.ADD(" "~idxdate2(Val(o:&i))~", ")
         SQL.ADD(" "~Fstr(Val(q:&i)*val(aa:&i),0,2)~", ")
         * Leyenda
         SQL.ADD(" '"~Val(r:&i)~"', ")
         SQL.ADD(" '"~Val(s:&i)~"', ")
         SQL.ADD(" '"~Val(t:&i)~"', ")
         * FJL 04/06/21 - No pasaba MATCH
         if NoVacio(Val(u:&i))
           SQL.ADD(" '"~Val(u:&i)~"', ")
         endif
         * Cupon
         SQL.ADD(" '"~Val(v:&i)~"', ")
         SQL.ADD(" '"~Fstr(1000+Val(j:&i),1,0)~"', ")
         SQL.ADD(" '"~Val(ax:&i)~"', ")
         SQL.ADD(" '"~Val(ay:&i)~"' ) ")
         SQL.NEW
          
*** FJL 08/10/18 - Por Nuevas Posiciones para POSPOR
         *  Esto es por si estuvieran Pendientes. Sy ya estamos en la fecha de vto de la operacion deberiane estar todos ejecutados
         SQL.ADD("UPDATE "~DBO~".MOVPOSPEN ")
         SQL.ADD("   Set Cantidad    = "~Fstr(Val(al:&i)*val(ae:&i),0,2)~"  ")
         SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"'          ")
*** FJL 11/02/19 - Depende si estoy difiriendo titulos o moneda
         if DesciendeDeEspecie(Val(c:&i),'TITULO')
           SQL.ADD("   and NrSaldo     in (102,172,192,122) ")
         else
           SQL.ADD("   and NrSaldo     in (51) ")
         endif
         SQL.ADD("   and FechaMov    = "~idxdate2(Val(n:&i))~"        ")
