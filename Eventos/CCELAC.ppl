
CrearDialogo
    Directorio1:    'Path '        ;;;;SI;SI;;;;VAR('PATHPLCTA')
    String1:    'Archivo '         ;;;;SI;SI;;;;
FinDialogo

If not ok
    Cancelar
Endif

*Reviso si existe el directorio y si el archivo existe en el mismo.
If ExisteDirectorio(Dialogo.Directorio1)
    If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
        If Not ExisteArchivo(Dialogo.Directorio1~Dialogo.String1)
            Cancelar('El Archivo '~Dialogo.String1~' no existe en el directorio: '~Dialogo.Directorio1)
        EndIf
    Else
        If Not ExisteArchivo(Dialogo.Directorio1~'\'~Dialogo.String1)
            Cancelar('El Archivo '~Dialogo.String1~' no existe en el directorio: '~Dialogo.Directorio1)
        EndIf
    Endif
Else
    Cancelar('El directorio '~Dialogo.Directorio1~' no existe')
EndIf

*Agrego \ al final si el directorio no lo tiene
let &PathFile ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &PathFile Dialogo.Directorio1~Dialogo.String1
Else
    let &PathFile Dialogo.Directorio1~'\'~Dialogo.String1
Endif

*Importo el excel 
ImportarXLS(A:2..E:1000,AA:2..AE:1000, &PathFile)


SetFilaActual(2)

*Deshabilitar Trigger
SQL.ADD("ALTER TABLE  "~DBO~".CONTABILIDAD DISABLE TRIGGER dl_contabilidad")
SQL.NEW
SQL.EXEC

Recorrer&I 2,1000
    *Me fijo si hay Cuenta Contable 
    IF NoVacio(Val(AA:&I))
        *Me traigo el Codigo y el Cliente a Variables
         let &Codigo  Copy(Val(AA:&I),1,9)
         let &Cliente Val(AE:&I)
          
         *Pregunto por el Cliente para saber si tengo que Eliminar o Actualizar la Cuenta
          If Eqstr (&Cliente, 'N')
            *Si es N se elimina
            
            SQL.ADD(" DELETE FROM "~DBO~".CONTABILIDAD ")
            SQL.ADD(" Where Codigo = '"~&Codigo~"' ")
            SQL.NEW
            SQL.EXEC
            
          Else
            If Eqstr(&Cliente, 'S')
            
            *Si es S se actualiza el Cliente y me traigo la nueva Jerarquia  
                let &Jerarquia GenerarJerarquiaByRef ('CONTABILIDAD', Query ("Select Jerarquia from "~DBO~".CONTABILIDAD where Codigo = 'BIND' "), true)
                SQL.ADD(" UPDATE "~DBO~".CONTABILIDAD")
                SQL.ADD(" SET Cliente = 'BIND', Jerarquia = '"~&Jerarquia~"' ")
                SQL.ADD(" Where Codigo = '"~&Codigo~"' ")
                SQL.NEW
                SQL.EXEC
            Endif
         Endif
    Else
        *Habilito Trigger
        SQL.ADD("ALTER TABLE  "~DBO~".CONTABILIDAD ENABLE TRIGGER dl_contabilidad")
        SQL.NEW
        SQL.EXEC
        *No hay Cuenta Contable, salgo
        Message("Finalizando Evento")
        break
    Endif
Proximo

