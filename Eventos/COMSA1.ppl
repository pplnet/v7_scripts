*#define PRUEBA
*- Calculo de Comisiones sobre Saldos - ORIGINAL
ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
  Entero1    : "Trimestre"  ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Entero1>=1 y Dialogo.Entero1<=4;'Nro. de Trimestre Incorrecto';NO;Trunc2(Mes(Fsys)/3.1)+1
  Entero4    : "Mes"        ;2;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Entero4>=1 y Dialogo.Entero4<=12;'Nro. de Mes Incorrecto';NO;Mes(Fsys);;;;'##'
  Entero2    : "Año"        ;2;2;; ;;Dialogo.Entero2>0;'Anio Incorrecto';NO;Anio(Fsys);;;;'####'
  Fecha1     : "F.Desde"    ;3;1;;NO;;Dialogo.Fecha1<=FSys Y Dialogo.Fecha1<>0 ;"Fecha Desde Incorrecta";NO;IIf(Dialogo.Radio2=0,PriDeMes(Fecha('01/'~Pad0(Fstr(IIf(Dialogo.Entero1=1,1,IIf(Dialogo.Entero1=2,4,IIf(Dialogo.Entero1=3,7,10))),0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),PriDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI));IIf(Dialogo.Radio2=0,PriDeMes(Fecha('01/'~Pad0(Fstr(IIf(Dialogo.Entero1=1,1,IIf(Dialogo.Entero1=2,4,IIf(Dialogo.Entero1=3,7,10))),0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),PriDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI))
  Fecha2     : "F.Hasta"    ;;;;NO;;Dialogo.Fecha2<=Habiles(FSys,1) Y Dialogo.Fecha2>=Dialogo.Fecha1 ;"Fecha Hasta Incorrecta";NO;;IIf(Dialogo.Radio2=0,IIf(Dialogo.Entero1<>Trunc2(Dialogo.Entero4/3.1)+1,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),IIF(Fsys=FinDeMes(Fsys),FinDeMes(Fsys,SI),Fsys)),IIF(Mes(Fsys)<>Dialogo.Entero4 o Anio(Fsys)<>Dialogo.Entero2,FinDeMes(Dialogo.Fecha1,SI),Fsys))
  Cliente1   : "Cliente"    ;;;;;;;;;;;;
  Radio1     : "Tipo|Ultimo_DIA|Per_COMPLETO|" ;;;;;;;;;1
  Check3     : "PrimerCorrida" ;;;;NO;NO;;;;Dialogo.Radio1;Dialogo.Radio1;
  Cliente2   : "DesdeCliente"  ;;;;NO;NO;;;;;;;
  Cliente3   : "HastaCliente"  ;;;;NO;NO;;;;;;;
  Radio2     : "Tipo|Trimestral|Mensual|"  ;;;;;;;;;1
  Radio3     : "Clientes|Sud|Pata|Todos|"  ;;;;NO;NO;;;;2
  Check1     : "Hoja Visible"  ;;;;NO;NO;;;;0;
  Check2     : "Graba PMG"     ;;;;NO;NO;;;;1;
FinDialogo
** Llamada de COMSAL 
**   EjecutarEvento('COMSA1',Vehiculo1=Dialogo.Vehiculo1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Cliente1=Dialogo.Cliente1,Check1=0,Check2=1,Check3=Dialogo.Check3,Cliente2=val(cc2),Cliente3=val(cc3),Entero4=Dialogo.Entero4,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3)
If Not Ok
  Cancelar
EndIf

If Dialogo.Check1=1
   HojaVisible(SI)
EndIf
#ifdef PRUEBA
  HojaVisible(SI)
#endif 

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(2)
ACT(a:FAC, 'Calculo de COMISIONES sobre SALDOS del '~Dialogo.Fecha1~'  al '~Dialogo.Fecha2)
SetFilaActual(fac+2)

ACT(a:fac,'Especie: TODAS')
If NoVacio(Dialogo.Cliente1)
   ACT(z1, Val(z1)~" S.Cliente = '"~Dialogo.Cliente1~"' and ")
   ACT(c:fac,'Cliente: '~Dialogo.Cliente1)
Else
   ACT(c:fac,'Clientes: '~IIF(Dialogo.Radio3=0,' Sudameris ',IIF(Dialogo.Radio3=1,' Patagonia ','Todos')))
EndIf
ACT(e:fac,'Ubicacion: TODOS')

SetFilaActual(fac+2)

ACT(a:FAC, "Cliente")
ACT(b:FAC, "Especie")
ACT(c:FAC, "Vehiculo")
ACT(d:FAC, "Ubicacion")
ACT(e:FAC, "Estado")
ACT(f:FAC, "Cuenta")
ACT(g:FAC, "Saldo")
ACT(h:FAC, "Cta.Com.")
ACT(i:FAC, "Cotizacion")
ACT(j:FAC, "Valuacion "~VAR('MONELOCA'))
ACT(k:FAC, "Comision")
ACT(l:FAC, "% Comision Real")
ACT(m:FAC, "Minimo")
ACT(n:FAC, "Fijo")
ACT(o:FAC, "Maximo")
ACT(p:FAC, "%IVA")
ACT(q:FAC, "Monto IVA")

act(v111, Hora(Ahora) )
act(ml1, VAR('MONELOCA') )

AgregarMarco(a:FAC..q:FAC,2,0,Exe('COLOR'))
SetFont(a:1..q:FAC,2)

*- Calculo la fecha mas vieja para eliminar NUMSAL que no sean de fin de trimestre
ACD(fv2,Habiles(Dialogo.Fecha2,-Var('FVALORMAX'),'ARG'))

* FJL 27/12/21 - Salos no pagan comisiones
ACT(x:1, VAR('SALNOCOM'))

*- Recupero los Saldos por Estado para un Cliente para las Cuentas que estan Habilitadas 

SQL.ADD(" Select Max(S.Fecha) as Fecha,Max(S.Cupon) as Cupon,S.EnteCustodia,S.Cliente, ES.Cotiza,S.Especie,S.Mercado,S.Cuenta, ")
SQL.ADD("        S.NrSaldo,ES.InteresesC,E.Codigo as Estado,C.Estado as CtaEstado  ")
SQL.ADD(" From "~DBO~".SALDOSDIA S (NOLOCK) INNER JOIN  "~DBO~".CLIENTES AS CL (NOLOCK) ")
SQL.ADD("           ON S.Cliente = CL.Codigo ")
SQL.ADD("       INNER JOIN  "~DBO~".ESPECIES ES (NOLOCK) ")
SQL.ADD("           ON S.Especie=ES.Codigo ")
SQL.ADD("       INNER JOIN  "~DBO~".CUENTAS C (NOLOCK) ")
SQL.ADD("             ON C.Codigo=S.Cuenta ")
SQL.ADD("       INNER JOIN "~DBO~".ESTADOSCUSTODIA E (NOLOCK) ")
SQL.ADD("             ON ( (S.NrSaldo=E.NrSaldo and S.NrSaldo=101) or (S.NrSaldo=E.NrSaldo+100 and S.NrSaldo>201)) ")
SQL.ADD("Where (S.NrSaldo>201 or S.NrSaldo=101) and                                    ")
* FJL 27/12/21 - Salos no pagan comisiones
SQL.ADD("      S.NrSaldo not in ("~Pipe2Comillas(Val(x:1))~") AND                   ")
SQL.ADD("      S.EnteCustodia='"~Dialogo.Vehiculo1~"' and                              ")
SQL.ADD("     (C.Estado = 'HAB' or                                                       ")
SQL.ADD("     (C.Estado = 'CER' and C.Alias1 = '"~IdxDate(Dialogo.Fecha2)~"')) and         ")
* FJL 11/01/22 - Tomo cuentas con Comitente vehiculo
SQL.ADD("     C.Comitente = '"~Dialogo.Vehiculo1~"' and ")
* FJL 19/01/22 - Descarto cuentas con Cliente vehiculo
SQL.ADD("     C.Cliente <> '"~Dialogo.Vehiculo1~"' and ")

*
* Todas las especies que en Valor8 tengan 1, no seran tomadas en cuenta para el calculo de comisiones
*
SQL.ADD("  (ES.Valor8 =0 or ES.Valor8 is null)   and                                   ")
* FJL 17/01/22 - Si estaba vacio CobroCutodia no tomaba el cliente
*SQL.ADD("      CL.CobroCustodia <> 'NO' AND                               ")
SQL.ADD("     S.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' and                             ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" S.Cliente='"~Dialogo.Cliente1~"' and                                      ")
EndIf
If Dialogo.Radio3=0
   *- Clientes Sudameris
   SQL.ADD("      (CL.Valor10<>1 OR CL.Valor10 Is Null) And ")
EndIf
If Dialogo.Radio3=1
   *- Clientes Patagonia
   SQL.ADD("      CL.Valor10=1 and ")
EndIf
If NoVacio(Dialogo.Cliente2) y NoVacio(Dialogo.Cliente3)  
   SQL.ADD(" S.Cliente Between '"~Dialogo.Cliente2~"' and '"~Dialogo.Cliente3~"' ")
EndIf
SQL.ADD(" GROUP BY S.EnteCustodia, S.Cliente, ES.Cotiza,     S.Especie, S.Mercado, S.Cuenta,     S.NrSaldo, ES.InteresesC, E.Codigo, C.Estado ")
SQL.ADD(" ORDER BY S.EnteCustodia, S.Cliente, C.Estado DESC, S.Especie, S.Mercado, E.Codigo DESC ")

ACN(w1,fac)
ACT(z3,'')
ACT(z4,'')
ACN(z5,0)

*- ch2: Cuenta Anterior para un cliente
ACT(ch2,'')
ACT(z20,'')
ACT(z7 ,'')

watch(SQL.batch())

Recorrer SQL

   *- z8: Mercado
   act(z8,FBN['Mercado'])

   If Not EqStr(val(z20),FBN['Cliente']~' '~IIF(Incluido(FBN['CtaEstado'],'CER'),'CER'))  y NoVacio(Val(Z20))    
      *- Modificado para que si entra por Mensual (Patagonia ahora y Despues todo )
      *- Vuelva a aplicar el porcentaje por Rangos a la valuacion total
      If Round2(val(z5),2)<>0.00   
         ACT(a:fac,"Total Cliente : "~Val(z20))

         *- Por Cada Cambio de cliente calculo minimo, fijo, maximo e iva y grabo la transaccion CUSSAL
         *- Sumatoria de Valuacion
         ACN(j:fac,VAL(z5) )
      
         *- Sumatoria de Arancel 
         ACN(k:fac,VAL(z23) )

         *If Dialogo.Radio2=1
         *   *- Mensual -> Recupera nuevamente el %                
         *   *- l: Porcentaje de Arancel k: Monto de Arancel 
         *   ACN(L:fac, MontoArancelC(, Val(Z:7),,val(z6),VAR('COMCUSSAL'), val(z5), 4,,Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
         *   ACN(k:fac,val(j:fac)*val(l:fac)/100)
         *   ACT(E:fac,'% Comision Aplicada para Valuacion Total:'~Fstr(val(l:fac),0,5))
         *EndIf

         ACN(M:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 1,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
         ACN(N:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 2,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
         ACN(O:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 5,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))

         *- Verifico si debo aplicar minimo, fijo, maximo 
         If (val(k:fac)+val(n:fac))<val(m:fac)
            *- Si el Saldo es menor al minimo -> aplico el minimo
            ACN(l:fac, val(m:fac)) 
         Else
            If val(o:fac)<>0 y (val(k:fac)+val(n:fac))>val(o:fac)
               *- Si el Saldo es mayor al maximo -> aplico el maximo 
               ACN(l:fac, val(o:fac)) 
            Else 
               *- Monto Arancel + Fijo
               ACN(l:fac, val(k:fac)+val(n:fac)) 
            EndIf
         EndIf
         SetFont(a:fac..q:fac,1)

         *- p: Calculo del % del Iva sobre comisiones
         acn(p:fac,IIF(Not EQSTR(BUSCARCAMPO('CLIENTES','CondicionGan','Codigo',val(z7)),'NOR'),Var('IVA')+IIF(EQSTR(BUSCARCAMPO('CLIENTES','CondicionIVA','Codigo',val(z7)),'NOI'),VAR('RNI'),IIF(EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',val(z7)),'SI'),Var('RG3337'),0)),Var('IVA'))  )

         *- q: Monto de Iva
         acn(q:fac,ROUND(Abs(val(l:fac))*Val(p:fac) /100,2)  )
#ifdef PRUEBA
         MessageBox('COMSA1 - No llama funcion INSCUSSAL')
#else
         (.'INSCUSSAL'.)
#endif 

         ACT(d:fac,Val(z2))
         ACLT(d:fac,Val(z2))

         SetFont(a:fac..q:fac,2)
         AgregarMarco(a:fac..q:fac,2,0,Exe('COLOR6'))
         AgregarMarco(l:fac..l:fac,2,0,Exe('COLOR7'))
      EndIf  
      ACN(z23,0)
      ACN(z5,0)
      IFA
      IFA
   Endif

   If Not EqStr(val(z7),FBN['Cliente']) 
      act(z7 ,FBN['Cliente'])
      ACT(TC:1, BuscarCampo('Clientes','TipoCliente','Codigo',val(Z:7)))

      *- Oficial de cuenta 
      act(z9,BuscarCampo('CLIENTES','OficialCuenta','Codigo',val(z7)) )
      ACT(z10,BuscarCampo('OFICIALESCUENTA','Descripcion','Codigo',Fstr(Num(val(z9)),0,0)) )  

      *- Por cada saldo recuperado -> Calculo Recupero la cuenta default para el calculo de comisiones
      *- cp1: Cuenta de Pesos cd1: Cuenta de dolares 
      act(cp:1,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Cliente']~"' and Especies Like '%"~VAR('MONELOCA')~"%' and Estado='HAB'  and TipoCuenta In('CC','CA') "))
      act(cd:1,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Cliente']~"' and Especies Like '%"~VAR('MONEEXTR')~"%' and Estado='HAB'  and TipoCuenta In('CC','CA') "))

      *- ch:1: Cuenta para Calculo de Comision
      act(ch:1,IIF(NoVacio(val(cp:1)),val(cp:1),IIf(NoVacio(val(cd:1)),val(cd:1),VAR('CTAMOD23'))))

      act(z3,val(ch1))

      Message('*- Elimino la transacciones NUMSAL Anterior ... ')
#ifdef PRUEBA
      MessageBox('COMSA1 - No elimina transacciones cliente '~Val(z7))
#else
      SQL.ADD("DELETE "~DBO~".TRANSACCIONES2 Where TipoTr2='NUMSAL' ")
      If Not Dialogo.Check3=1 
         SQL.ADD("and (Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or (Fecha1<'"~IdxDate(val(fv2))~"' and CB1='0')) ")
      Else
         SQL.ADD("and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' ")
      EndIf
      SQL.ADD("and Cliente1='"~val(z7)~"' ")
      SQL.NEW       
      SQL.EXEC       
#endif 
   Endif

   ACT(z20,FBN['Cliente']~' '~IIF(Incluido(FBN['CtaEstado'],'CER'),'CER') )

   *- Cuenta Cerrada 
   IF Incluido(FBN['CtaEstado'],'CER')
      act(ft1,'1') 
   Else 
      *- Fin de Trimestre y Es Trimestral, o Fin de Mes y es Mensual
      act(ft1,'0') 
      If Dialogo.Radio2=0 y Dialogo.Fecha2=FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Anio(Fsys),4,0)),SI)
         act(ft1,'1') 
      EndIf  
      If Dialogo.Radio2=1 y Dialogo.Fecha2=FinDeMes(Dialogo.Fecha1,SI)
         act(ft1,'1') 
      EndIf  
   EndIf

   ACT(z21,val(ft1)) 

   Message('Principal '~FBN['Cliente']~' '~FBN['Especie']~' '~FBN['Mercado']~' '~Fstr(FBN['NrSaldo'],0,2) )
  
   act(a:fac,FBN['Cliente'])
   act(b:fac,FBN['Especie'])
   act(c:fac,FBN['EnteCustodia'])
   act(d:fac,FBN['Mercado'])
   act(e:fac,FBN['Estado'])
   act(f:fac,FBN['Cuenta'])

   act(z6 ,FBN['EnteCustodia'])

   act(z11,FBN['Estado'])
*ACT(Z:11, 'LIBRE')
   *- Chequeo si se cargaron movimientos  ejecutados fechavalor => SI NO ES UNA PRIMER CORRIDA
   If Dialogo.Check3=0 
      SQL.ADD("SELECT Min(FechaMov) as FechaValor FROM "~DBO~".MOVEJECUTADOS M Where M.FechaMov<>M.FechaEje and M.FechaEje= ")
      If Dialogo.Fecha2<>Fsys
         SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"' and ")
      Else
         SQL.ADD(" '"~IdxDate(Fsys)~"' and ")
      EndIf
      SQL.ADD("  M.Cliente='"~FBN['Cliente']~"' and ")
      SQL.ADD("  M.Especie='"~FBN['Especie']~"' and ")
      SQL.ADD("  M.NrSaldo>=200  and ")
      SQL.ADD("  M.EnteCustodia='"~FBN['EnteCustodia']~"'  and ")
      SQL.ADD("  M.Mercado='"~FBN['Mercado']~"' and ")
      SQL.ADD("  M.Cuenta ='"~FBN['Cuenta']~"' and ")
      SQL.ADD("  M.NrSaldo ="~Fstr(FBN['NrSaldo'],0,0)~" and ")
      If NoVacio(FBN['Cupon'])
         SQL.ADD("  M.Cupon   ="~Fstr(FBN['Cupon'],0,0)~" ")
      Else
         SQL.ADD("  (M.Cupon   Is Null or M.Cupon='') ")
      EndIf
      Recorrer SQL
         *- fv1: Existen FechaValor 
         dfa
         ACD(fv1,FBN['FechaValor'])
      Proximo
   
      If Vacio(IdxDate(val(fv1)))
         ACD(fv1,Fsys)     
      EndIf

      *- Debo recalcular desde el dia Anterior a la Fecha Valor Hasta Hoy, recupero el saldo a esta fecha
      SQL.ADD("SELECT Sum(Cantidad1) as Cantidad1 FROM "~DBO~".TRANSACCIONES2 Where TipoTr2='NUMSAL' ")
      SQL.ADD("and Fecha1='"~IdxDate(Habiles(val(fv1),-1))~"' ")
      SQL.ADD("and Cliente1='"~FBN['Cliente']~"' ")
      SQL.ADD("and Especie='"~FBN['Especie']~"'  ")
      SQL.ADD("and Vehiculo1='"~FBN['EnteCustodia']~"' ")
      SQL.ADD("and Cuenta1 ='"~FBN['Cuenta']~"' ")
      SQL.ADD("and Mercado1 ='"~FBN['Mercado']~"' ")
      SQL.ADD("and Cambio4  ="~Fstr(FBN['NrSaldo'],0,0)~" and ")
      If NoVacio(FBN['Cupon'])
         SQL.ADD("  Cupon1 ="~Fstr(FBN['Cupon'],0,0)~" ")
      Else
         SQL.ADD("  (Cupon1 Is Null or Cupon1='') ")
      EndIf
  
      Recorrer SQL
         DFA
         acn(sf1,FBN['Cantidad1'])
      Proximo

      If NoVacio(IdxDate(val(fv1)))
         acd(df1,val(fv1))
      EndIf
   EndIf

   acd(df2,Dialogo.Fecha2)

   If Dialogo.Check3=1
      *- Primer Corrida
      acd(df1,Dialogo.Fecha1)
   EndIF

   **   acn(pp2,0)
   *- Por cada registro recupero el promedio ponderado de los saldos 
   *- entre fecha 1 y fecha2 pp1: PPP de saldos
   *-'CUSSALPP3'.)

   *--- Esto es un store procedure de la base de datos que devuelve un resultado
   SQL.ADD(" "~DBO~".CUSSAL ")
   SQL.ADD(" '"~fbn('Cliente')~"', '"~fbn('Especie')~"', '"~fbn('EnteCustodia')~"', '"~fbn('Mercado')~"', ")
   SQL.ADD(" '"~fbn('Cuenta')~"', "~fstr(fbn('NrSaldo'),0,0)~", "~idxdate2(Dialogo.Fecha1)~", "~idxdate2(Dialogo.Fecha2)~", 0 ")
   RecorreR SQL
     ACN(pp1, Fields[0] )
   Proximo

   *-pp2: Sumatoria Saldo desde Fecha 1 a Fecha 2 para Guardar
   acn(pp2,val(sf1)+val(pp1))

*   MessageBox('sf:1 - '~PyC(Val(sf:1),1,2))
*   MessageBox('pp:1 - '~PyC(Val(pp:1),1,2))
*   MessageBox('pp:2 - '~PyC(Val(pp:2),1,2))
* FJL 11/01/22 - No calculaba el promedio
*   acn(g:fac,val(pp1))
   acn(g:fac, val(pp2)/(Dialogo.Fecha2-Dialogo.Fecha1+1))

   If Round2(val(g:fac),2)<>0.00
      *- No tomo numerales si el saldo es 0, redondeandolo a 2 decimales

      *- i: Cotizacion
      acn(i:fac,Cotizacion(fbn['Especie'],,,,Dialogo.Fecha2,1))

      *- Resolucion 1585
      act(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))

      If Not EqStr(fbn['InteresesC'],'DIR')
         *** calcula precio sucio ***
         act(ca:fac,fbn['Especie'])
         acd(ck:fac,Dialogo.Fecha2)

         (."SUCIO".)
     
         IF Incluido(Val(al4), '1585')
            acn(i:fac,(val(i:fac)+(val(cj:fac)*Val(i:fac)))*val(ci:fac) ) 
         Else
            acn(i:fac,(val(i:fac)+val(cj:fac))*val(ci:fac) ) 
         Endif
      EndIf

      *- j: Valuacion
      acn(j:fac,val(g:fac)*val(i:fac)*CotizacionC(FBN['Cotiza'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')) )
  
      *- Total de Valuacion en Pesos
      SCN(z5,val(j:fac))

      *- h:fac: Cuenta para Calculo de Comision
      act(h:fac,val(ch1))

      *--Por cada registro de saldos sin tener en cuenta minimos ni maximos ni fijo
      *- l: Porcentaje de Arancel 
      *- k: Monto de Arancel 

*#ifdef PRUEBA
*      MessageBox('z7 - '~Val(z7))
*      MessageBox('Especie - '~fbn('Especie'))
*      MessageBox('z6 - '~Val(z6))
*      MessageBox('COMCUSSAL - '~VAR('COMCUSSAL'))
*      MessageBox('j:fac - '~PyC(Val(j:fac),1,2))
*      MessageBox('TC:1 - '~Val(TC:1))
*      MessageBox('z8 - '~Val(z8))
*      MessageBox('z11 - '~Val(z11))
*#endif
      ACN(L:fac, MontoArancelC(, Val(Z:7),fbn('Especie'),val(z6),VAR('COMCUSSAL'), val(j:fac), 4,,Val(TC:1),SI, '', val(z8), val(z11),'MAN',NO,NO,'',SI))

      ACN(k:fac,val(j:fac)*val(l:fac)/100)

      *- Monto de Arancel Total del cliente
      SCN(z23,Val(k:fac))

#ifdef PRUEBA
      MessageBox('COMSA1 - No llama funcion INSNUMSAL')
#else
      (.'INSNUMSAL'.)
#endif
      Else
      BorrarCeldas(a:fac..l:fac)
      dfa
   EndIf

Proximo

Ifa 

If NoVacio(Val(Z20))

   If Round2(val(z5),2)<>0.00    
      ACT(a:fac,"Total Cliente: "~Val(z20))

      *- Por Cada Cambio de cliente calculo minimo, fijo, maximo e iva y grabo la transaccion CUSSAL
      *- Sumatoria de Valuacion
      ACN(j:fac,VAL(z5) )
      
      *- Sumatoria de Arancel 
      ACN(k:fac,VAL(z23) )

      *If Dialogo.Radio2=1
      *   *- Mensual -> Recupera nuevamente el %                
      *   *- l: Porcentaje de Arancel k: Monto de Arancel 
      *   ACN(L:fac, MontoArancelC(, Val(Z:7),,val(z6),VAR('COMCUSSAL'), val(z5), 4,,Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
      *   ACN(k:fac,val(j:fac)*val(l:fac)/100)
      *   ACT(E:fac,'% Comision Aplicada para Valuacion Total:'~Fstr(val(l:fac),0,5))
      *   SetFont(a:fac..q:fac,2)
      *EndIf
          
      *- Sumatoria de Valuacion Total del Cliente
*#ifdef PRUEBA
*      MessageBox('z:7 - '~Val(z:7))
*      MessageBox('z:6 - '~Val(z:6))
*      MessageBox('COMCUSSAL - '~VAR('COMCUSSAL'))
*      MessageBox('z:5 - '~PyC(Val(z:5),1,2))
*      MessageBox('MMFCUSSAL - '~VAR('MMFCUSSAL'))
*      MessageBox('TC:1 - '~Val(TC:1))
*      MessageBox('z:8 - '~Val(z:8))
*      MessageBox('z:11 - '~Val(z:11))
*#endif
      ACN(M:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 1,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
      ACN(N:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 2,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))
      ACN(O:fac, MontoArancelC(,Val(Z:7),,val(z6),VAR('COMCUSSAL'), VAL(z5), 5,Var('MMFCUSSAL'),Val(TC:1),SI, '', val(z8), val(z11),'MAN',SI,SI))

      *- Verifico si debo aplicar minimo, fijo, maximo 
      If (val(k:fac)+val(n:fac))<val(m:fac)
         *- Si el Saldo es menor al minimo -> aplico el minimo
         ACN(l:fac, val(m:fac)) 
      Else
         If val(o:fac)<>0 y (val(k:fac)+val(n:fac))>val(o:fac)
            *- Si el Saldo es mayor al maximo -> aplico el maximo 
            ACN(l:fac, val(o:fac)) 
         Else 
            *- Monto Arancel + Fijo
            ACN(l:fac, val(k:fac)+val(n:fac)) 
         EndIf
      EndIf
      SetFont(a:fac..q:fac,1)

      *- p: Calculo del % del Iva sobre comisiones
      acn(p:fac,IIF(Not EQSTR(BUSCARCAMPO('CLIENTES','CondicionGan','Codigo',val(z7)),'NOR'),Var('IVA')+IIF(EQSTR(BUSCARCAMPO('CLIENTES','CondicionIVA','Codigo',val(z7)),'NOI'),VAR('RNI'),IIF(EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',val(z7)),'SI'),Var('RG3337'),0)),Var('IVA'))  )

      *- q: Monto de Iva
      acn(q:fac,ROUND(Abs(val(l:fac))*Val(p:fac) /100,2)  )
  
#ifdef PRUEBA
       MessageBox('COMSA1 - No llama funcion INSCUSSAL (2)')
#else
      (.'INSCUSSAL'.)
#endif
      
      ACT(d:fac,Val(z2))
      ACLT(d:fac,Val(z2))
 
      SetFont(a:fac..q:fac,2)
      AgregarMarco(a:fac..q:fac,2,0,Exe('COLOR6'))
      AgregarMarco(l:fac..l:fac,2,0,Exe('COLOR7'))
   endif

   ACN(z23,0)
   ACN(z5,0)
   IFA
   IFA

   FormatoCeldas(k:Val(w1)+1..q:fac,Exe('F2')) 
   FormatoCeldas(l:Val(w1)+1..l:fac,Exe('F5')) 
   FormatoCeldas(j:Val(w1)+1..i:fac,Exe('F5')) 
   FormatoCeldas(e:Val(w1)+1..e:FAC,Exe('F0')) 

   ACO(1,6)
   ACO(2,10)
   ACO(3,7)
   ACO(4,6)
   ACO(5,5)
   ACO(6,8)
   ACO(7,10)
   ACO(8,7)
   ACO(9,6)
   ACO(10,10)
   ACO(11,8)
   ACO(12,10)
   ACO(13,10)
   ACO(14,10)
   ACO(15,10)

   Impresion(1,2)
   SetFilaActual(FAC+2)
   ACT(a:FAC, 'FIN DEL LISTADO')
   SetFont(a:FAC,2)
   IFA
   ACT(a:FAC,'Fecha Real: '~IdxDate(Fsys)~' Hora de comienzo -> '~Val(v111)~'     Hora Fin -> '~Hora(Ahora) )
   SetFont(a:FAC,2)
   If Dialogo.Check1=0
     LimitesVision(q:fac+2)
   endif

   *If Dialogo.Check2=1
   *   *- Grabo los calculos diarios de cobro de comisiones por custodia
   *    GrabarPMG('COMSAL', Dialogo.Vehiculo1~'/'~IIF(Dialogo.Radio2=0,Dialogo.Entero1,Dialogo.Entero4)~'_'~Dialogo.Entero2~'-'~Dialogo.Fecha2~'/'~Dialogo.Cliente1~'/'~Dialogo.Cliente2~'/'~Dialogo.Cliente3)
   *EndIf

   ExportarWKS(a:1..q:fac+2,a:1..q:fac+2,VAR('PATHCOMI')~Dialogo.Vehiculo1~Fstr(IIF(Dialogo.Radio2=0,Dialogo.Entero1,Dialogo.Entero4),0,0)~Fstr(Dialogo.Entero2,0,0)~Fstr(Anio(Dialogo.Fecha2),0,0)~Fstr(Mes(Dialogo.Fecha2),0,0)~Fstr(Dia(Dialogo.Fecha2),0,0)~Dialogo.Cliente1~Dialogo.Cliente2~Dialogo.Cliente3~'.WKS')
   SetPrintFit(2)

   *- Contador de Planillas
   SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor=Valor+1 WHERE Codigo='CONTWKSCOM' ")
   SQL.NEW
   SQL.EXEC
EndIf
