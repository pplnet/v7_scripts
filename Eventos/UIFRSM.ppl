IF Dialogo.Check1 = 0
   if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" where NrDepositante is not null and Comitente = '"~VAR('VEHICULODE')~"' and Estado = 'CER' ")
      #ifdef BIND
          SQL.ADD(" and (TipoCuenta = 'CUS' OR TipoCuenta = '"~VAR('UIFTIPOMAV')~"') ")
