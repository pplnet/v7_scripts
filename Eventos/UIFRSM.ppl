** Armar Header XML
    EscribirASCII('<?xml version="1.0" encoding="utf-8"?>')
    EscribirASCII('<Operacion>')
    EscribirASCII('  <Cuentas_Comitentes Version="1.0">')
    ACD(f1,Dialogo.Fecha1)
    ACD(fe1,iif(FBN['FechaAlta']>val(fe2),FBN['FechaAlta'],Val(f1)))
    ACT(fe9,Fecha(val(fe1),'YYYY-MM-DD')~'T00:00:00-03:00')
    EscribirASCII('    '~xmlElemento('Fecha_de_la_acci93n',Val(fe9),'SI'))
    **Cuenta Activa - verificar si como es por alta va 'No Aplica'
    If EqStr(FBN['Estado'],'HAB')
       ACT(x1,'Activa')
    else
       ACT(x1,'Inactiva')
    endif
    EscribirASCII('    '~xmlElemento('Estado_de_la_cuenta_al_momento_de_realizar_la_acci93n',Val(x1),'SI'))
    ACT(x1,TRIM(FBN['DeposDelComitente']))
    #ifdef BIND
    If EqStr(FBN['TipoCuenta'],VAR('UIFTIPOMAV'))
       ACT(x1, VAR('DEPOSMAV'))
       Endif   
    #endif
    EscribirASCII('    '~xmlElemento('Cuenta_depositante_Nro',Val(x1),'SI'))
    ACT(x1,TRIM(FBN['CodComitente']))
    **#ifdef BIND
    **   If EqStr(FBN['TipoCuenta'],VAR('UIFTIPOMAV'))
    **   ACT(x1, TRIM(FBN['Codigo']))
    **   Endif   
    **#endif
    EscribirASCII('    '~xmlElemento('Cuenta_comitente_Nro',Val(x1),'SI'))
 ** Si en los integrantes no esta incluido el cliente sumar 1 a cuantos
    *ACT(x1,iif(FBN['Cuantos']=0,'1',Fstr(FBN['Cuantos']+1,0,0)))
    ACT(x1,iif(FBN['Cuantos']=0,'1',iif(EqStr(FBN['Persona'],'SI'),Fstr(FBN['Cuantos'],0,0),Fstr(FBN['Cuantos']+1,0,0))))
    ** ACT(x1,Fstr(FBN['Cuantos'],0,0))
    EscribirASCII('    '~xmlElemento('Cantidad_de_clientes_y_otros_sujetos_vinculados_a_la_acci93n',Val(x1),'SI'))
    
    If EqStr(FBN['Tipo'],'A')
       ACT(tp:1,'Alta')
       EscribirASCII('    '~xmlElemento('Tipo_de_acci93n','Apertura de cuenta','SI'))
    Else
       ACT(tp:1,'Baja')
       EscribirASCII('    '~xmlElemento('Tipo_de_acci93n','Cierre de cuenta','SI'))
    Endif
    
** Identificacion del cliente-cuenta    Verificar datos Fisica / Juridica
    EscribirASCII('    <IDENTIFICACI98N_DE_CLIENTES88'~Val(tp:1)~'>')
    ACT(pe:1,FBN['Persona'])
    If EqStr(FBN['Persona'],'SI')
       SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento, Apellido, Nombre, Sexo, Nacionalidad,Pais, CodigoPEP, FechaNacimiento,  ")
       SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura,Depto,Piso,(select CatPrestamosBCRA from CLIENTES where Codigo='"~FBN['Cliente']~"') CatPrestamosBCRA, ")
       SQL.ADD("P.EmpleadoGobierno,P.Telefono,(select DireccionEMail from CLIENTES where Codigo='"~FBN['Cliente']~"') email")
       #ifdef MLASA
           SQL.ADD("from INTEGRANTESUIF ICL ")
           SQL.ADD("left join PERSONASUIF P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #else
           SQL.ADD("from INTEGRANTESCLI ICL ")
           SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
       #endif
       #ifdef BIND
           SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento = (select CUIT from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       #else
           SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' and ICL.NrDocumento= (select substring(CUIT,3,8) from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       #endif
       **watch(sql.batch)
       BorrarCeldas(x:2..x:10)
       Recorrer SQL
         ACT(x2,Trim(FBN['Apellido']))
         ACT(x3,Trim(FBN['Nombre']))
         ACT(x4,Trim(iif(EqStr(FBN['TipoDocumento'],'CUI'),'CUIT',FBN['TipoDocumento'])))
         if EqStr(FBN['TipoDocumento'],'CUI')
            ACT(x5,FBN['NrDocumento'])
         else
            ACT(x5,iif(Eqstr(Copy(FBN['NrDocumento'],1,1),'0'),Copy(FBN['NrDocumento'],2,longitud(FBN['NrDocumento'])-1),FBN['NrDocumento']))
            **ACT(x5,Trim(Mirt(ReemplazarSTR(FBN['NrDocumento'],'0'))))
         endif
         #ifdef BIND
            if EqStr(FBN['TipoDocumento'],'CUI')
               ACT(x4,'Documento Nacional de Identidad')
               ACT(x5,iif(Eqstr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))
            Endif 
         #endif    
         ACT(x6,Trim(iif(EqStr(FBN['Sexo'],'FEM'),'Femenino',iif(EqStr(FBN['Sexo'],'MAS'),'Masculino','No Binario'))))
         *ACT(x7,Trim(FBN['Nacionalidad']))
         ACT(x7,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='NACIONALIDAD' and ValorSistemaExterno ='"~FBN['Nacionalidad']~"' ")))
         ACT(x8,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
         ACD(fe1,iif(FBN['FechaNacimiento']>val(fe2),FBN['FechaNacimiento'],Val(f1)))
         ACT(x9,Fecha(Val(fe1),'YYYY-MM-DD')~'T00:00:00-03:00')
         ACT(x10,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='PEP' and ValorSistemaExterno ='"~FBN['CodigoPEP']~"' ")))
       Proximo
       
       ACT(x1,'Otro')
       EscribirASCII('      '~xmlElemento('Tipo_Cliente88'~Val(tp:1),Val(x1),'SI'))
       * if Not EqStr(FBN['Pais'],VAR('PAISARG'))
          ACT(x1,Trim(FBN['CUIT']))
          EscribirASCII('      '~xmlElemento('CUIT_CUIL_CDI_CIE88'~Val(tp:1),Val(x1),'SI'))
       * Endif   
       ACT(x1,iif(EqStr(FBN['Pais'],VAR('PAISARG')),'Persona humana','Persona humana extranjera'))
       EscribirASCII('      '~xmlElemento('Tipo_de_Persona88'~Val(tp:1)~'Cliente',Val(x1),'SI'))

       EscribirASCII('      '~xmlElemento('Apellidos88'~Val(tp:1)~'ClientePF',Val(x2),'SI'))
       EscribirASCII('      '~xmlElemento('Nombres88'~Val(tp:1)~'ClientePF',Val(x3),'SI'))
       EscribirASCII('      '~xmlElemento('Tipo_Documento88'~Val(tp:1)~'ClientePF',Val(x4),'SI'))
       EscribirASCII('      '~xmlElemento('N94mero_Documento88'~Val(tp:1)~'ClientePF',Val(x5),'SI'))
       
       IF Not EqStr(Val(tp:1),'Baja')
          EscribirASCII('      '~xmlElemento('G91nero88'~Val(tp:1)~'ClientePF',Val(x6),'SI'))
          EscribirASCII('      '~xmlElemento('Nacionalidad88'~Val(tp:1)~'ClientePF',Val(x7),'SI'))
          EscribirASCII('      '~xmlElemento('Pa92s_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x8),'SI'))
          EscribirASCII('      '~xmlElemento('Lugar_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x8),'SI'))
          EscribirASCII('      '~xmlElemento('Fecha_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x9),'SI'))
          EscribirASCII('      '~xmlElemento('Declar93_ser_PEP88'~Val(tp:1)~'Cliente',Val(x10),'SI'))
          **ACT(x1,Trim(FBN['CatPrestamosBCRA'])) 
          ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='RIESGO' and ValorSistemaExterno ='"~FBN['CatPrestamosBCRA']~"' ")))
          if NoVacio(val(x1))
             EscribirASCII('      '~xmlElemento('Riesgo_asignado_al_cliente88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
          endif   
          ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
          EscribirASCII('      '~xmlElemento('Pa92s88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
          ACT(x1,Trim(BuscarCampo('PROVINCIAS','NomExterno','Codigo',FbN['Provincia'])))
          EscribirASCII('      '~xmlElemento('Provincia88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          ** Localidad no es posible generar relacion (es texto ingresado a mano) 
          *ACT(x1,Trim(FBN['Localidad']))
          ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='LOCALIDAD' and ValorSistemaExterno ='"~FBN['Localidad']~"' ")))
          if Vacio(val(x1))
             ACT(x1,FBN['Localidad'])
          endif
          EscribirASCII('      '~xmlElemento('Localidad88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          ACT(x1,Trim(FBN['Calle']))
