** Tabla relacion campos ej --> TipoDocum
**       SQL.ADD("(select Valor from dbo.CONFIGVALEXTERNOS where CodigoProceso='ALTCBT' and Atributo='TIPODOCUMENTO' and ValorSistemaExterno='" ~COPY(VAL(aa:1),2,1)~ "') ")


SQL.ADD("Select 'A' as Tipo,FechaAlta, ")
SQL.ADD("CU.Codigo,NrDepositante Comitente,Estado,TipoCuenta,Cliente, C.CUIT, C.CatPrestamosBCRA, C.Persona,")
#ifdef BIND
SQL.ADD("(select CodDepCajaValores from "~DBO~".CLIENTES Where Codigo = '"~VAR('VEHICULODE')~"') as DeposDelComitente, ")
SQL.ADD("(select Top(1) NrDepositante from "~DBO~".CUENTAS Where Cliente = CU.Cliente and Mercado='CV' and (TipoCuenta = 'CUS' OR TipoCuenta = '"~VAR('UIFTIPOMAV')~"') and NrDepositante is not Null) as CodComitente, ")
#else
SQL.ADD("(select DeposDelComitente from "~DBO~".CLIENTES Where Codigo = CU.Comitente) as DeposDelComitente, ")
SQL.ADD("(select Top(1) NrDepositante from "~DBO~".CUENTAS Where Cliente = CU.Cliente and TipoCuenta = 'CUS' and NrDepositante is not Null) as CodComitente, ")
#endif

SQL.ADD("C.Sector, C.CategDepositante, C.Pais, C.RazonSocial,C.CodigoPostal,C.Provincia,C.Localidad,C.Calle,C.Altura,C.FechaInsc,C.Piso,C.Depto,C.DireccionEmail email,")
