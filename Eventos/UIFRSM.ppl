#else
SQL.ADD("(select count(*) from "~DBO~".INTEGRANTESCLI IT where IT.Codigo = CU.Cliente) as Cuantos ")
#endif
SQL.ADD("  from "~DBO~".CUENTAS CU ")
SQL.ADD("  inner join "~DBO~".CLIENTES C on CU.Cliente =C.Codigo ")
IF Dialogo.Check1 = 0
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" where NrDepositante is not null and Comitente = '"~VAR('VEHICULODE')~"' and Estado = 'HAB' ")
      #ifdef BIND
          SQL.ADD(" and (TipoCuenta = 'CUS' OR TipoCuenta = '"~VAR('UIFTIPOMAV')~"') ")
      #else
          SQL.ADD(" and TipoCuenta = 'CUS'")
      #endif
      SQL.ADD("   and CU.Cliente = '"~Dialogo.Cliente1~"'  ")
   else
      SQL.ADD(" where NrDepositante is not null and Comitente = '"~VAR('VEHICULODE')~"' and Estado = 'HAB' ")
      #ifdef BIND
          SQL.ADD(" and (TipoCuenta = 'CUS' OR TipoCuenta = '"~VAR('UIFTIPOMAV')~"') ")
      #else
          SQL.ADD(" and TipoCuenta = 'CUS'")
      #endif
      SQL.ADD("   and FechaAlta >= "~IdxDate2(Dialogo.Fecha1)~" and FechaAlta <= "~IdxDate2(Dialogo.Fecha2)~" ")   
   endif
Else
   SQL.ADD(" where NrDepositante is not null and Comitente = '"~VAR('VEHICULODE')~"' and Estado = 'HAB' ")
