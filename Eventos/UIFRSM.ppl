          EscribirASCII('      '~xmlElemento('Localidad88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          ACT (x1,Trim(FBN['Calle']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Calle88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['Altura']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('N94mero88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['Piso']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Piso88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          endif 
          ACT(x1,Trim(FBN['Depto']))  
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Departamento88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
          endif  
          ACT(x1,Trim(FBN['CodigoPostal']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('C93digo_Postal88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
          endif
          **Estos ultimos 3 no son obligatorios
          ACT(x1,'')
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('C93digo_de_90rea_telef93nico88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
             EscribirASCII('      '~xmlElemento('Tel91fono88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['email']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Direcci93n_de_correo_electr93nico88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
          endif
       ENDIF
       
       EscribirASCII('    </IDENTIFICACI98N_DE_CLIENTES88'~Val(tp:1)~'>')
    Endif 
    
 ** Detalle de Integrantes
    If (EqStr(FBN['Persona'],'SI') y FBN['Cuantos']>1) o (EqStr(FBN['Persona'],'NO') y FBN['Cuantos']>0)
    ** Datos de los Integrantes 
      SQL.ADD("Select ICL.TipoPoder,ICL.FAlta FechaAlta,ICL.TipoDocumento,ICL.NrDocumento, Apellido, Nombre, Sexo, Nacionalidad,Pais, CodigoPEP, FechaNacimiento,  ")
      SQL.ADD("CodigoPostal,Provincia,Localidad,Direccion Calle,Numero Altura, ICL.TipoPoder, P.CUIT,Depto,Piso,(select CatPrestamosBCRA from CLIENTES where Codigo='"~FBN['Cliente']~"') CatPrestamosBCRA, ")
      SQL.ADD("P.EmpleadoGobierno,P.FechaNacimiento,P.Telefono, P.Empresa,(select DireccionEMail from CLIENTES where Codigo='"~FBN['Cliente']~"') email ")
      #ifdef MLASA
          SQL.ADD("from INTEGRANTESUIF ICL ")
          SQL.ADD("left join PERSONASUIF P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
      #else
          SQL.ADD("from INTEGRANTESCLI ICL ")
          SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
      #endif
      SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente']~"' ")
      If EqStr(FBN['Persona'],'SI')
       #ifdef BIND
          SQL.ADD(" and ICL.NrDocumento <> (select CUIT from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       #else
          SQL.ADD(" and ICL.NrDocumento= (select substring(CUIT,3,8) from CLIENTES where Codigo='"~FBN['Cliente']~"') ")
       #endif      
      
      Endif
      **watch(sql.batch)
    Recorrer SQL  
       ** Si es Persona Fisica los titulares van como clientes si no como vinculados
       If EqStr(val(pe:1),'SI') y EqStr(FBN['TipoPoder'],'TIT')
         ** Cliente
         EscribirASCII('    <IDENTIFICACI98N_DE_CLIENTES88'~Val(tp:1)~'>')
         ACT(x2,Trim(FBN['Apellido']))
         ACT(x3,Trim(FBN['Nombre']))
         ACT(x4,Trim(iif(EqStr(FBN['TipoDocumento'],'CUI'),'CUIT',FBN['TipoDocumento'])))
         if EqStr(FBN['TipoDocumento'],'CUI')
            ACT(x5,FBN['NrDocumento'])
         else
            ACT(x5,iif(Eqstr(Copy(FBN['NrDocumento'],1,1),'0'),Copy(FBN['NrDocumento'],2,longitud(FBN['NrDocumento'])-1),FBN['NrDocumento']))
         endif
         #ifdef BIND
            if EqStr(FBN['TipoDocumento'],'CUI')
               ACT(x4,'Documento Nacional de Identidad')
               ACT(x5,iif(Eqstr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))
               ACT(x11,FBN['NrDocumento'])
            Endif 
         #endif
         ACT(x6,Trim(iif(EqStr(FBN['Sexo'],'FEM'),'Femenino',iif(EqStr(FBN['Sexo'],'MAS'),'Masculino','No Binario'))))
         *ACT(x7,Trim(FBN['Nacionalidad']))
         ACT(x7,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='NACIONALIDAD' and ValorSistemaExterno ='"~FBN['Nacionalidad']~"' ")))
         ACT(x8,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
         ACD(fe1,iif(FBN['FechaNacimiento']>val(fe2),FBN['FechaNacimiento'],Val(f1)))
         ACT(x9,Fecha(Val(fe1),'YYYY-MM-DD')~'T00:00:00-03:00')
         ACT(x10,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='PEP' and ValorSistemaExterno ='"~FBN['CodigoPEP']~"' ")))
         ACT(x1,'Otro')
         EscribirASCII('      '~xmlElemento('Tipo_Cliente88'~Val(tp:1),Val(x1),'SI'))
         * if Not EqStr(FBN['Pais'],VAR('PAISARG'))
         #ifdef BIND
            ACT(x1,Trim(val(x11)))
         #else
            ACT(x1,Trim(FBN['CUIT']))
         #endif 
          EscribirASCII('      '~xmlElemento('CUIT_CUIL_CDI_CIE88'~Val(tp:1),Val(x1),'SI'))
          * Endif   
         ACT(x1,iif(EqStr(FBN['Pais'],VAR('PAISARG')),'Persona humana','Persona humana extranjera'))
         EscribirASCII('      '~xmlElemento('Tipo_de_Persona88'~Val(tp:1)~'Cliente',Val(x1),'SI'))

         EscribirASCII('      '~xmlElemento('Apellidos88'~Val(tp:1)~'ClientePF',Val(x2),'SI'))
         EscribirASCII('      '~xmlElemento('Nombres88'~Val(tp:1)~'ClientePF',Val(x3),'SI'))
         EscribirASCII('      '~xmlElemento('Tipo_Documento88'~Val(tp:1)~'ClientePF',Val(x4),'SI'))
         EscribirASCII('      '~xmlElemento('N94mero_Documento88'~Val(tp:1)~'ClientePF',Val(x5),'SI'))
         
         IF Not EqStr(Val(tp:1),'Baja')
            EscribirASCII('      '~xmlElemento('G91nero88'~Val(tp:1)~'ClientePF',Val(x6),'SI'))
            EscribirASCII('      '~xmlElemento('Nacionalidad88'~Val(tp:1)~'ClientePF',Val(x7),'SI'))
            EscribirASCII('      '~xmlElemento('Pa92s_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x8),'SI'))
            EscribirASCII('      '~xmlElemento('Lugar_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x8),'SI'))
            EscribirASCII('      '~xmlElemento('Fecha_de_nacimiento88'~Val(tp:1)~'ClientePF',Val(x9),'SI'))
            EscribirASCII('      '~xmlElemento('Declar93_ser_PEP88'~Val(tp:1)~'Cliente',Val(x10),'SI'))
            **ACT(x1,Trim(FBN['CatPrestamosBCRA'])) 
            ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='RIESGO' and ValorSistemaExterno ='"~FBN['CatPrestamosBCRA']~"' ")))
            if NoVacio(val(x1))
               EscribirASCII('      '~xmlElemento('Riesgo_asignado_al_cliente88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
            endif   
            ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
            EscribirASCII('      '~xmlElemento('Pa92s88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
            ACT(x1,Trim(BuscarCampo('PROVINCIAS','NomExterno','Codigo',FbN['Provincia'])))
            EscribirASCII('      '~xmlElemento('Provincia88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
            ** Localidad no es posible generar relacion (es texto ingresado a mano) 
            *ACT(x1,Trim(FBN['Localidad']))
            ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='LOCALIDAD' and ValorSistemaExterno ='"~FBN['Localidad']~"' ")))
            if Vacio(val(x1))
               ACT(x1,FBN['Localidad'])
            endif
            EscribirASCII('      '~xmlElemento('Localidad88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
            ACT(x1,Trim(FBN['Calle']))
            EscribirASCII('      '~xmlElemento('Calle88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
            ACT(x1,Trim(FBN['Altura']))
            EscribirASCII('      '~xmlElemento('N94mero88'~Val(tp:1)~'ClienteArg',Val(x1),'SI'))
            ACT(x1,Trim(FBN['CodigoPostal']))
            EscribirASCII('      '~xmlElemento('C93digo_Postal88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
            **Estos ultimos 3 no son obligatorios
            ACT(x1,'')
            if NoVacio(Val(x1))
               EscribirASCII('      '~xmlElemento('C93digo_de_90rea_telef93nico88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
               EscribirASCII('      '~xmlElemento('Tel91fono88'~Val(tp:1)~'Cliente',Val(x1),'SI')) 
            endif
            ACT(x1,Trim(FBN['email']))
            if NoVacio(Val(x1))
               EscribirASCII('      '~xmlElemento('Direcci93n_de_correo_electr93nico88'~Val(tp:1)~'Cliente',Val(x1),'SI'))
            endif
         ENDIF
         
         EscribirASCII('    </IDENTIFICACI98N_DE_CLIENTES88'~Val(tp:1)~'>')
      Else
       ** Informar Condominos u otros Vinculados
       EscribirASCII('    <IDENTIFICACI98N_DE_OTROS_SUJETOS_VINCULADOS_A_LA_ACCI98N88'~Val(tp:1)~'>')
       **TIT:Titular|CTI:Co Titular|AUT:Autorizado|APO:Apoderado|RLE:Representante|TUT:Tutor|SDE:Sociedad gerente|
       **FID:Fiduciario|EMP:Empleado|DIR:Director|FPU:Funcionario Publico|FIR:Firmante|FTE:Fiduciante|BFI:Beneficiario Fideicomiso|
       **FRI:Fideicomiso|SFI:Socio Funcionario|ACC:Socio/Accionista|FEM:Funcionario de la empresa|Ger:Gerente|PRE:Presidente|VPR:Vicepresidente|
       **FBA:Firmante Dado de Baja|NC:No Corresponde|FBC:Funcionario del Banco|VIN:Vinculacion Indirecta Bco.|EMB:Empleado de Banco:|ACB:Accionista del Banco"
       * ACT(x1,Trim(FBN['TipoPoder']))
       ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='TIPOINTEGRANTE' and ValorSistemaExterno ='"~FBN['TipoPoder']~"' ")))
       IF EqStr(Val(x20),'FON') y not Eqstr(FBN['TipoPoder'],'SDE')
          EscribirASCII('      '~xmlElemento('Naturaleza_del_v92nculo_con_elX85Xlos_clientes88'~Val(tp:1),VAR('UIFFCIGEN'),'SI'))
       Else
          EscribirASCII('      '~xmlElemento('Naturaleza_del_v92nculo_con_elX85Xlos_clientes88'~Val(tp:1),Val(x1),'SI'))
       Endif
       IF Incluido(FBN['TipoDocumento'],'CUI|CIL')
          ACT(x1,FBN['NrDocumento'])
          ** ACT(x1,Trim(ReemplazarSTR(FBN['NrDocumento'],'0')))
          EscribirASCII('      '~xmlElemento('CUIT_CUIL_CDI_CIE88Vinculado'~Val(tp:1),Val(x1),'SI'))
       Else
          if Novacio(FBN['CUIT'])
             ACT(x1,Trim(FBN['CUIT']))
             EscribirASCII('      '~xmlElemento('CUIT_CUIL_CDI_CIE88Vinculado'~Val(tp:1),Val(x1),'SI'))
          endif
       Endif
       ** Si es empresa omitir datos
       if EqStr(FBN['Nombre'],'') o Vacio(FBN['Nombre'])
          ACT(x1,iif(EqStr(FBN['Pais'],VAR('PAISARG')),'Persona jurídica','Persona jurídica extranjera'))
          EscribirASCII('      '~xmlElemento('Tipo_de_Persona88Vinculado'~Val(tp:1),Val(x1),'SI'))
          ACT(x1,Trim(FBN['Apellido']))
          EscribirASCII('      '~xmlElemento('Denominaci93n88Vinculado'~Val(tp:1)~'PJ',Val(x1),'SI'))
          ACD(fe1,FBN['FechaNacimiento'])
          ACT(fe9,Fecha(val(fe1),'YYYY-MM-DD')~'T00:00:00-03:00')
          EscribirASCII('      '~xmlElemento('Fecha_de_Constituci93n88Vinculado'~Val(tp:1)~'PJ',Val(fe9),'SI'))
          **Datos de Domicilio
          ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Pa92s88Vinculado'~Val(tp:1),Val(x1),'SI'))
          endif
          ACT(x1,Trim(BuscarCampo('PROVINCIAS','NomExterno','Codigo',FbN['Provincia'])))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Provincia88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          endif
          ** Localidad no es posible generar relacion (es texto ingresado a mano) 
          *ACT(x1,Trim(FBN['Localidad']))
          ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='LOCALIDAD' and ValorSistemaExterno ='"~FBN['Localidad']~"' ")))
          if Vacio(val(x1))
             ACT(x1,FBN['Localidad'])
          endif
          EscribirASCII('      '~xmlElemento('Localidad88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          ACT(x1,Trim(FBN['Calle']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Calle88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['Altura']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('N94mero88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['Piso']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Piso88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          endif 
          ACT(x1,Trim(FBN['Depto']))  
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('Departamento88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
          endif
          ACT(x1,Trim(FBN['CodigoPostal']))
          if NoVacio(Val(x1))
             EscribirASCII('      '~xmlElemento('C93digo_Postal88Vinculado'~Val(tp:1),Val(x1),'SI'))
          endif
       else
          ** Persona Humana /  Persona Humana Extranjera
          ACT(x1,iif(EqStr(FBN['Pais'],VAR('PAISARG')),'Persona humana','Persona humana extranjera'))
          EscribirASCII('      '~xmlElemento('Tipo_de_Persona88Vinculado'~Val(tp:1),Val(x1),'SI'))
          ACT(x1,Trim(FBN['Apellido']))
          EscribirASCII('      '~xmlElemento('Apellidos88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
          ACT(x1,Trim(FBN['Nombre']))
          EscribirASCII('      '~xmlElemento('Nombres88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
          **CI:C.D.I|CIL:CUIL|CUI:CUIT|DNI:DNI|LE:LE|LC:LC|IFI:Instit. Fcieras|PAS:Pasaporte|CED:Cedula Mercosur|PJE:Pers Jur Extr|FCI:Fondo Comun De inv.|
          **DEX:Documento Extranjero|FID:Fideicomiso|EIR:Nro. Registro IERIC|CIE:C.I.E|CIP:C.I.Provincial|GCE:Grupo Crediticio/Economico|OTR:Otro|"
          *ACT(x1,Trim(FBN['TipoDocumento']))
          IF EqStr(Trim(FBN['TipoDocumento']),'CUI')
             ACT(x1,'CUIT')
          else
             IF EqStr(Trim(FBN['TipoDocumento']),'CIL')
                ACT(x1,'CUIL')
             else
                IF EqStr(Trim(FBN['TipoDocumento']),'CED')
                   ACT(x1,'Cédula Mercosur')
                else
                   IF EqStr(Trim(FBN['TipoDocumento']),'CI')
                      ACT(x1,'CDI')
                   else
                      IF EqStr(Trim(FBN['TipoDocumento']),'DNI')
                         ACT(x1,'Documento Nacional de Identidad')
                         *ACT(x1,'DNI')
                      else
                         IF EqStr(Trim(FBN['TipoDocumento']),'LE')
                            ACT(x1,'Libreta de Enrolamiento')
                            *ACT(x1,'LE')
                         else
                            IF EqStr(Trim(FBN['TipoDocumento']),'LC')
                               ACT(x1,'Libreta Cívica')
                               *ACT(x1,'LC')
                            else
                               IF EqStr(Trim(FBN['TipoDocumento']),'PAS')
                                  ACT(x1,'Pasaporte')
                               else
                                  IF EqStr(Trim(FBN['TipoDocumento']),'DEX')
                                     ACT(x1,'Documento EXT')
                                     *ACT(x1,'Documento extranjero')
                                  else
                                     ACT(x1,'Tipo Doc. No esperado')
                                  endif                   
                               endif 
                            endif
                         endif
                      endif
                   endif
                endif
             endif
          ENDIF   
          #ifdef BIND
              IF Incluido(FBN['TipoDocumento'],'CUI|CIL|DNI')
                 ACT(x1,'Documento Nacional de Identidad')
                 *ACT(x1,'DNI')
              endif
              EscribirASCII('      '~xmlElemento('Tipo_Documento8888Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
              ACT(x1,iif(Eqstr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))
          #else
             #ifdef BACS
                 IF Incluido(FBN['TipoDocumento'],'CUI|CIL|DNI')
                    ACT(x1,'Documento Nacional de Identidad')
                    *ACT(x1,'DNI')
                 endif
                 EscribirASCII('      '~xmlElemento('Tipo_Documento8888Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
                 ACT(x1,iif(Eqstr(Copy(FBN['NrDocumento'],1,1),'0'),Copy(FBN['NrDocumento'],2,longitud(FBN['NrDocumento'])-1),FBN['NrDocumento']))
              #else 
                  EscribirASCII('      '~xmlElemento('Tipo_Documento8888Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
                  ACT(x1,iif(Eqstr(Copy(FBN['NrDocumento'],3,1),'0'),Copy(FBN['NrDocumento'],4,7),Copy(FBN['NrDocumento'],3,8)))
              #endif
          #endif
          EscribirASCII('      '~xmlElemento('N94mero_Documento8888Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
       
          IF Not EqStr(Val(tp:1),'Baja')
             ACT(x1,Trim(iif(EqStr(FBN['Sexo'],'FEM'),'Femenino',iif(EqStr(FBN['Sexo'],'MAS'),'Masculino','No Binario'))))
             EscribirASCII('      '~xmlElemento('G91nero88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
             *ACT(x1,Trim(FBN['Nacionalidad']))
             ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='NACIONALIDAD' and ValorSistemaExterno ='"~FBN['Nacionalidad']~"' ")))
             EscribirASCII('      '~xmlElemento('Nacionalidad88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
             ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
             EscribirASCII('      '~xmlElemento('Pa92s_de_nacimiento88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
             ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
             EscribirASCII('      '~xmlElemento('Lugar_de_nacimiento88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))
             ACD(fe1,iif(FBN['FechaNacimiento']>val(fe2),FBN['FechaNacimiento'],Val(f1)))
             ACT(x1,Fecha(val(fe1),'YYYY-MM-DD')~'T00:00:00-03:00')
             EscribirASCII('      '~xmlElemento('Fecha_de_nacimiento88Vinculado'~Val(tp:1)~'PF',Val(x1),'SI'))

             ACT(x1,Trim(BuscarCampo('PAISES','NomExterno','Codigo',FBN['Pais'])))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Pa92s88Vinculado'~Val(tp:1),Val(x1),'SI'))
             endif
             ACT(x1,Trim(BuscarCampo('PROVINCIAS','NomExterno','Codigo',FbN['Provincia'])))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Provincia88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             endif
             ** Localidad no es posible generar relacion (es texto ingresado a mano) 
             *ACT(x1,Trim(FBN['Localidad']))
             ACT(x1,Trim(SQL(" SELECT Valor FROM "~DBO~".CONFIGVALEXTERNOS WHERE CodigoProceso='UIF' and Atributo='LOCALIDAD' and ValorSistemaExterno ='"~FBN['Localidad']~"' ")))
             if Vacio(val(x1))
                ACT(x1,FBN['Localidad'])
             endif
             EscribirASCII('      '~xmlElemento('Localidad88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             ACT(x1,Trim(FBN['Calle']))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Calle88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             endif
             ACT(x1,Trim(FBN['Altura']))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('N94mero88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             endif
             ACT(x1,Trim(FBN['Piso']))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Piso88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             endif 
             ACT(x1,Trim(FBN['Depto']))  
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Departamento88Vinculado'~Val(tp:1)~'Arg',Val(x1),'SI'))
             endif
             ACT(x1,Trim(FBN['CodigoPostal']))
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('C93digo_Postal88Vinculado'~Val(tp:1),Val(x1),'SI'))
             endif
             **Estos ultimos 3 no son obligatorios
             ACT(x1,'')
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('C93digo_de_90rea_telef93nico88Vinculado'~Val(tp:1),Val(x1),'SI'))
                EscribirASCII('      '~xmlElemento('Tel91fono88Vinculado'~Val(tp:1),Val(x1),'SI'))
             endif
             **ACT(x1,Trim(FBN['email']))
             ACT(x1,'')       
             if NoVacio(Val(x1))
                EscribirASCII('      '~xmlElemento('Direcci93n_de_correo_electr93nico88Vinculado'~Val(tp:1),Val(x1),'SI'))
             endif
          ENDIF
       ENDIF
       EscribirASCII('    </IDENTIFICACI98N_DE_OTROS_SUJETOS_VINCULADOS_A_LA_ACCI98N88'~Val(tp:1)~'>')
      Endif 
    Proximo
    Endif
    

   ** Armar Cierre XML
    EscribirASCII('  </Cuentas_Comitentes>')
    EscribirASCII('</Operacion>')

    CerrarASCII 
    
Proximo   

Messagebox('Generados '~Fstr(val(co1),0,0)~' Archivos '~Dialogo.String2~' XML en '~Dialogo.String1)


