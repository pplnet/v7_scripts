CrearDialogo
   String1     : 'Operacion'  ;;;;;;;;;;;;;;
   Fecha1      : 'FechaMov'   ;;;;;;Dialogo.Fecha1 <= Fsys Y Dialogo.Fecha1 >= Fecha(Var('FEINIPART')) o si;'FechaMov Invalida';NO;fsys
   Cliente1    : 'Cliente'    ;;
   Vehiculo1   : 'Vehiculo'   ;;;;;;;;;Var('VEHICULODE')
   Mercado1    : 'Mercado'    ;;;;;;NoVacio(Dialogo.Mercado1);'Si desea Seleccionar debe ingresar Mercado';NO;;;;;;" NETEA='SI' "
FinDialogo

MostrarCuadroDeMensajes

IF NOT OK
   Cancelar
Endif

***** Armo Query *****

SQL.ADD(" Select distinct  MP.NrOperacion, MP.FechaMov, MP.Cliente, MP.Especie, MP.Mercado, MP.EnteCustodia, MP.Cantidad, ")
SQL.ADD("                  MP.Leyenda, MP.Bits, MP.NrSaldo, MP.Cuenta, MP.NrMov, MP.Transaccion,  MP.Book, MP.Vehiculo,   ")
SQL.ADD("                  MP.NrGrupo, MP.Concepto, MP.Status, MP.Cupon                                                   ")
SQL.ADD(" from  "~DBO~".MOVPENDIENTES MP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B, "~DBO~".MERCADOS M2              ")
SQL.ADD(" where  MP.Cliente    = C.Codigo                                                                                 ")
If Novacio(Dialogo.String1)
   SQL.ADD(" AND    MP.NrOperacion = '"~Dialogo.String1~"'      ")
Endif
SQL.ADD(" AND    MP.NrOperacion = B.NrOperacion                 ")
*SQL.ADD(" AND    B.NrBit       = 10                            ")
SQL.ADD(" AND    B.Valor       = '1'                            ")
SQL.ADD(" AND    MP.FechaMov   = "~idxdate2(Dialogo.Fecha1)~"   ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND    MP.Vehiculo = '"~Dialogo.Vehiculo1~"'       ")
Endif
If Novacio(Dialogo.Cliente1)
   SQL.ADD(" AND    MP.Cliente = '"~Dialogo.Cliente1~"'         ")
Endif
SQL.ADD(" AND    MP.Mercado = M2.Codigo                         ")
SQL.ADD(" ORDER  BY MP.NrOperacion                              ")

***** Recorro *****

ACN(z:1, 0)

Recorrer SQL
   message(fbn('NrOperacion'))
   
   ACN(a:fac, 0)
   ACT(b:fac, fbn('NrOperacion') )
   ACT(c:fac, fbn('Especie')     )
   ACT(d:fac, fbn('Cliente')     )
   ACT(e:fac, fbn('Mercado')     )
   ACT(f:fac, fbn('EnteCustodia'))
   ACT(g:fac, fbn('Bits')        )
   ACN(h:fac, fbn('NrSaldo')     )
   ACT(i:fac, fbn('Cuenta')      )
   ACN(j:fac, fbn('NrMov')       )
   ACT(k:fac, fbn('Transaccion') )
   ACT(l:fac, fbn('Book')        )
   ACT(m:fac, fbn('Vehiculo')   )
   ACD(n:fac, fbn('FechaMov')    )
   ACD(o:fac, habiles(fbn('FechaMov'),1,'ARG',SI))
   ACN(p:fac, fbn('Cantidad')    )
   ACT(r:fac, fbn('Leyenda')     )
   ACN(s:fac, fbn('NrGrupo')     )
   ACT(t:fac, fbn('Concepto')    )
   ACT(u:fac, fbn('Status')      )
   ACT(v:fac, fbn('Cupon')       )
   ACN(z:1, 1)
Proximo

If Val(z:1)=0
   Cancelar('No se encontraron operaciones con vencimiento el '~Dialogo.Fecha1)
Endif

***** Armo el listbox *****

CrearListBox;'Arial,8,';'Anulación de operaciones con fecha de movimiento al '~Dialogo.Fecha1
  'Mod.'            ;a:1..a:fac;SI;;; 50;CHECK ;RGB(160,160,193)
  'NrOperacion'     ;b:1..b:fac;NO;;; 70;STRING;;RGB(250,250,193)
  'Especie'         ;c:1..c:fac;NO;;; 50;STRING;;RGB(250,250,193)
  'Cliente'         ;d:1..d:fac;NO;;; 50;STRING;;RGB(250,250,193)
  'Mercado'         ;e:1..e:fac;NO;;; 50;STRING;;RGB(250,250,193)
  'EnteCustodia'    ;f:1..f:fac;NO;;; 60;STRING;;RGB(250,250,193)
  'Bits'            ;g:1..g:fac;NO;;; 60;STRING;;RGB(250,250,193)
  'NrSaldo'         ;h:1..h:fac;NO;;; 60;NUMERO;'##,###,###';RGB(250,250,193)
  'Cuenta'          ;i:1..i:fac;NO;;; 60;STRING;;RGB(250,250,193)
  'Leyenda'         ;r:1..r:fac;NO;;; 70;STRING;;RGB(250,250,193)
  'NrMov'           ;j:1..j:fac;NO;;; 60;NUMERO;'##,###,###.##';RGB(250,250,193)
  'Book'            ;l:1..l:fac;NO;;; 60;STRING;;RGB(250,250,193)
  'Vehiculo'        ;m:1..m:fac;NO;;; 60;STRING;;RGB(250,250,193)
  'Fecha Mov'       ;n:1..n:fac;NO;;; 90;FECHA;RGB(250,250,193)
  'Cantidad'        ;p:1..p:fac;NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)
  'Nro. Grupo'      ;s:1..s:fac;NO;;; 90;NUMERO;'##,###,###.##';RGB(250,250,193)
  'Concepto'        ;t:1..t:fac;NO;;; 90;STRING;;RGB(250,250,193)
  'Status'          ;u:1..u:fac;NO;;; 90;STRING;;RGB(250,250,193)
  'Cupon'           ;v:1..v:fac;NO;;; 90;STRING;;RGB(250,250,193)
  'Transaccion'     ;k:1..k:fac;NO;;; 90;STRING;;RGB(250,250,193)
FinListBox

If Not OK
   Cancelar
Endif

***** Recorro y actualizo *****

Recorrer&i 1, fac
   If Val(a:&i)=1
      message('Actualizando Operacion '~Val(b:&i)                      )

          SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET                  ")
          SQL.ADD(" Cantidad  = Cantidad + (SELECT Cantidad from      ")
          SQL.ADD(" "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(b:&i)~"' and NrComprob is not null)   ")
          SQL.ADD(" WHERE NrOperacion   = '"~Val(b:&i)~"'             ")
          SQL.ADD(" AND   Especie       = '"~Val(c:&i)~"'             ")
          SQL.ADD(" AND   NrComprob is null                           ")
          SQL.NEW
          
          SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES                 ")
          SQL.ADD(" WHERE NrOperacion  = '"~Val(b:&i)~"'              ")
          SQL.ADD(" AND   Especie ='"~Val(c:&i)~"'                    ")
          SQL.ADD(" AND   NrComprob is not null                       ")
          SQL.NEW

      SQL.EXEC
   Endif
Proximo

Messagebox('Los datos se actualizaron con éxito')
