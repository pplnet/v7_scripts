CrearDialogo
  NrOperacion1: 'Nr. Operacion' ;1;1;1;  ;  ;Novacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIC|TIV') y BuscarCampo('OPERACIONES','PaseCB','NrOperacion',Dialogo.NrOperacion1)=0;'Operacion Invalida.';NO;;;;;;"TipoOp in ('TIC','TIV') and PaseCB=0 "
  Check1:       'Procesa'       ;1;2;1;NO;NO;;;;1;
FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, Dialogo.NrOperacion1)
ACN(a:2, Dialogo.Check1)
ACN(a:3, BuscarCampo('OPERACIONES','Cupon1','NrOperacion',Dialogo.NrOperacion1))
CrearDialogo
  NrOperacion1: 'Nr. Operacion' ;1;1;1;NO;  ;;;;Val(a:1);
  Check1:       'Procesa'       ;1;2;1;NO;SI;;;;Val(a:2);
  TipoOp1:      'TipoOp'        ;2;1;1;NO;SI;;;;BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1);
  Fecha1:       'FechaOp'       ;3;1;1;NO;SI;;;;BuscarCampo('OPERACIONES','FechaOp','NrOperacion',Dialogo.NrOperacion1);
  Fecha2:       'FechaVto'      ;4;1;1;NO;SI;;;;BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1);
  Cliente1:     'Cliente'       ;5;1;1;NO;SI;;;;BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1);
  Especie1:     'Especie'       ;6;1;1;NO;SI;;;;BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1);
  Entero1:      'Cupon Actual'  ;7;1;1;NO;SI;;;;Val(a:3);
  Entero2:      'Cupon Nuevo'   ;7;2;1;SI;SI;NoVacio(Dialogo.Entero2) y Dialogo.Entero2<>Dialogo.Entero1;'Debe ingresar un book distinto al actual.';NO;;
FinDialogo
if not Ok
  Cancelar('Evento Cancelado')
endif

ACN(a:4, Dialogo.Entero2)
ACN(a:5, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and Especie='"~Dialogo.Especie1~"' "))
ACN(a:6, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES where NrOperacion='"~Dialogo.NrOperacion1~"' and Especie='"~Dialogo.Especie1~"' "))
if Val(a:5)>0
  MessageBox('La operacion '~Dialogo.NrOperacion1~' tiene la especie liquidada.')
endif

if Val(x:1)=0
  if Dialogo.Check1=1
    SQL.ADD("Update "~DBO~".MOVPENDIENTES Set Cupon = "~FStr(Dialogo.Entero2,1,0)~" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' and Especie='"~Dialogo.Especie1~"' and Cupon="~FStr(Dialogo.Entero1,1,0)~" ")
    SQL.NEW

    SQL.ADD("Update "~DBO~".OPERACIONES Set Cupon1 = "~FStr(Dialogo.Entero2,1,0)~" WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC

    SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,NO,NO,NO,SI)
    SQL.EXEC

    MessageBox('La operacion '~Dialogo.NrOperacion1~' fue actualizada correctamente')
  endif
endif
