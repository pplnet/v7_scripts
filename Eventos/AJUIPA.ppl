CrearDialogo
  Check1 : 'Procesa'     ;;;;SI;SI;;;;0
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(l:1, 'T2X4|X20F4')

ACT(a:1, 'MovPend')
ACT(a:2, 'MovEjec')
ACT(a:3, 'Saldos')
ACT(a:4, 'SaldosDia')

ACN(b:1, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(b:2, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(b:3, SQL("Select Count(*) from "~DBO~".SALDOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(b:4, SQL("Select Count(*) from "~DBO~".SALDOSDIA WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))

IF Dialogo.Check1=1
  SQL.ADD("Update "~DBO~".MOVPENDIENTES  ")
  SQL.ADD("   Set NrSaldo    = 321 ")
  SQL.ADD("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
  SQL.ADD("  and NrSaldo     = 121 ")
  SQL.NEW

  SQL.ADD("Update "~DBO~".MOVEJECUTADOS  ")
  SQL.ADD("   Set NrSaldo    = 321 ")
  SQL.ADD("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
  SQL.ADD("  and NrSaldo     = 121 ")
  SQL.NEW

  SQL.ADD("Update "~DBO~".SALDOS  ")
  SQL.ADD("   Set NrSaldo    = 321 ")
  SQL.ADD("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
  SQL.ADD("  and NrSaldo     = 121 ")
  SQL.NEW

  SQL.ADD("Update "~DBO~".SALDOSDIA  ")
  SQL.ADD("   Set NrSaldo    = 321 ")
  SQL.ADD("WHERE Especie     Not in ("~Pipe2Comillas(Val(l:1))~") ")
  SQL.ADD("  and NrSaldo     = 121 ")
  SQL.NEW

  SQL.EXEC
  MessageBox('Ajuste Finalizado')
else
  MessageBox('Finalizado sin Procesar')
endif

ACN(c:1, SQL("Select Count(*) from "~DBO~".MOVPENDIENTES WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(c:2, SQL("Select Count(*) from "~DBO~".MOVEJECUTADOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(c:3, SQL("Select Count(*) from "~DBO~".SALDOS WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
ACN(c:4, SQL("Select Count(*) from "~DBO~".SALDOSDIA WHERE Especie Not in ("~Pipe2Comillas(Val(l:1))~") and NrSaldo = 121 "))
