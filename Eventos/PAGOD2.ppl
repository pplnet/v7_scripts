CrearDialogo
 Especie1 :'Especie' ;1;1;;;;NoVacio(Dialogo.Especie1) Y DesciendeDeEspecie(Dialogo.Especie1,'ACCION');'Especie Invalida';NO;;;;;;"Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
 Fecha2   : 'R.Date'                            ;1;2;;;;Dialogo.Fecha2<>0;'Debe ingresar un Record Date valido';NO;FSys
 Fecha1   : 'F.Pago'                            ;2;2;;;;Dialogo.Fecha1<>0;'Debe ingresar una Fecha valida'     ;NO;FSys
 Cliente1 : 'Cliente'                           ;3;1;;;;[Vacio(Dialogo.Cliente1)] O [[[Eqstr(BuscarCampo('CLIENTES','CategDepositante','Codigo',Dialogo.Cliente1), 'CLI')] Y [Eqstr(BuscarCampo('CLIENTES','Status','Codigo',Dialogo.Cliente1), 'HAB')]] O [Eqstr(Dialogo.Vehiculo1, Dialogo.Cliente1)]];'Debe Ingresar un Cliente';NO;;;;;;" (CategDepositante='CLI' OR Codigo='"~Dialogo.Vehiculo1~"') AND Status = 'HAB' ";
 Mercado1 : 'Mercado'                           ;4;1;;;;
 Vehiculo1: 'Vehiculo'                          ;6;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el vehiculo';NO;VAR('VEHICULODE')
 Radio1   : 'Anular|Novedad|Confirmacion|Todos|';8;1;;;;;;;;2  
FinDialogo

if Not Ok
 Cancelar
endif

* Saldos Libre
ACT(sl:2, VAR('LIBREDISP'))
* Saldos Bloquedos
ACT(sl:3, VAR('BLOQUEOS'))
* Saldos Parking
ACT(sl:4, VAR('SALPARK'))

ACN(z:1,0)
ACN(z:10,0)

SQL.ADD(" Select DISTINCT  T.Mercado1, T.Cliente1, T.NrTrans, T.RB10, T.Especie, T.Especie2, ")
SQL.ADD(" T.Cantidad1, T.Precio1, T.Cantidad2, T.Precio2, T.Cantidad3, T.Cantidad4, T.Cantidad5, ")
SQL.ADD(" T.Cantidad6, T.Cantidad7, T.Cantidad8, T.Cuenta1, T.Cuenta2, T.Cliente2, T.Cuenta3, ")
SQL.ADD(" T.Cuenta4, T.Cambio5, T.Especie4, T.Cliente3, ")
SQL.ADD(" T.Especie1, T.Cuenta5, T.Cantidad9, T.Cantidad10, T.Cantidad11 ")
SQL.ADD("from  "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.TipoTr2   = 'PDIVID' ")
SQL.ADD("  and T.RB1 > 0 ")
SQL.ADD("  and  T.Especie   = '"~Dialogo.Especie1~"' ")
SQL.ADD("  and  T.Fecha2    = '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and  T.Fecha1    = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
if NoVacio(Dialogo.Cliente1)
 SQL.ADD("  and  T.Cliente1  = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
endif
if Dialogo.Radio1 = 0
 SQL.ADD(" AND T.RB2 = 0 ")
ENDIF
if Dialogo.Radio1 = 1
 SQL.ADD(" AND T.RB2 = 1 ")
ENDIF
SQL.ADD(" order by Mercado1, Cliente1, NrTrans ")

Recorrer SQL
  if Incluido(fbn('Cambio5'),Val(sl:4))
    DFA
    SCN(z:10, 1)
    ACT(bb:Val(z:10), fbn('Mercado1'))
    ACT(bc:Val(z:10), fbn('Cliente1'))
    ACT(bd:Val(z:10), fbn('Especie1'))
    ACT(be:Val(z:10), fbn('Especie2'))
    ACT(bf:Val(z:10), fbn('NrTrans'))
    ACT(bi:Val(z:10), fbn('Cuenta2'))
    ACT(bj:Val(z:10), fbn('Cuenta5'))
    ACT(bv:Val(z:10), fbn('Mercado1'))

    ACN(bl:Val(z:10), fbn('Cantidad9')) 
    ACN(bm:Val(z:10), fbn('Cantidad10'))
    ACN(bn:Val(z:10), fbn('Cantidad11'))
    ACN(bo:Val(z:10), fbn('Cambio5'))
    ACT(bs:Val(z:10), fbn('Cliente2'))
  else
    ACN(z:1, 1) 
    ACN(a:fac, 1)
    ACT(b:fac, fbn('Mercado1'))
    ACT(c:fac, fbn('Cliente1'))
    ACT(s:fac, fbn('Cliente2'))
    ACT(d:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente1')))
    ACT(e:fac, fbn('NrTrans'))
    ACT(f:fac, iif(EqStr(fbn('RB10'),'0'),'Efectivo','Acciones'))
    ACT(g:fac, fbn('Especie'))
    ACT(n:fac, fbn('Especie2'))
    ACN(k:fac, fbn('Cantidad1'))
    ACN(m:fac, fbn('Cantidad2'))
    ACN(p:fac, fbn('Cantidad3'))
    ACN(l:fac, fbn('Precio1'))
    ACN(o:fac, fbn('Precio2'))
    ACT(q:fac, fbn('Cuenta1'))
    ACT(r:fac, fbn('Cuenta2'))
    ACT(S:fac, fbn('Cliente3'))
  endif
proximo

if Val(z:1) = 0
 Cancelar('No se registran Transacciones con estas especificaciones.'~Chr(13)~Chr(10)~'Operacion CANCELADA.')
endif

CrearListBox ; 'Arial,8,';BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1)~' (ISIN: '~BuscarCampo('ESPECIES','ISIN','Codigo',Dialogo.Especie1)~') Anulacion '~IIF Dialogo.Radio1=0, ' Novedad', ' Novedad y Confirmacion'
 'Ok?'             ;a:1..a:fac;SI;;; 30;CHECK ;
 'Mercado'         ;b:1..b:fac;NO;;; 70;STRING;;RGB(220,220,193)
 'Cliente'         ;d:1..d:fac;NO;;;120;STRING;;RGB(220,220,193)
 'NrTrans'         ;e:1..e:fac;NO;;; 80;STRING;;RGB(220,220,193)
 'F.Pago'          ;f:1..f:fac;NO;;; 70;STRING;;RGB(220,220,193)
 'Titulo'          ;g:1..g:fac;NO;;; 60;STRING;;RGB(220,220,193)
 'Saldo'           ;k:1..k:fac;NO;;;110;NUMERO;'#,###,###,###.##';RGB(220,220,193)
 '%'               ;l:1..l:fac;NO;;; 80;NUMERO;'###,###.#####'   ;RGB(220,220,193)
 'Total'           ;m:1..m:fac;NO;;;110;NUMERO;'#,###,###,###.##';RGB(220,220,193)
 'Moneda'          ;n:1..n:fac;NO;;; 65;STRING;;RGB(220,220,193)
 'Pre.Fracc.'      ;o:1..o:fac;NO;;; 80;NUMERO;'###,###.#####';RGB(220,220,193)
 'Tot.Fracc.'      ;p:1..p:fac;NO;;; 90;NUMERO;'#,###,###,###.##';RGB(220,220,193)
 'Cta.Especie'     ;q:1..q:fac;NO;;;100;STRING;;RGB(220,220,193)
 'Cta.Moneda'      ;r:1..r:fac;NO;;;100;STRING;;RGB(220,220,193)
 'Custodio'        ;s:1..s:fac;NO;;; 90;STRING;;RGB(220,220,193)
FinListBox

if NOT OK
 Cancelar
endif

Recorrer&i 1,fac 
  if Val(a:&i)=1
    * ANULO CONFIRMACION - Vuelvo las Transacciones de Ejecutadas a Pendientes -------------- *
    if Dialogo.Radio1 = 1
      ***---Anulo la Confirmacion
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("   Set Fecha3  = Null, ")
      SQL.ADD("       RB2     = '0' ")
      SQL.ADD(" Where NrTrans = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" where NrOperacion = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.ADD("Delete "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" where NrOperacion = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      SQL.ActualizarMovimientosT2(Val(e:&i),SI,NO,NO,NO)
      SQL.EXEC
    ELSE
      ***---Anulo TODO
      SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
      SQL.ADD(" WHERE NrOperacion = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
      SQL.ADD(" WHERE NrOperacion = '"~Val(e:&i)~"' ")
      SQL.NEW
** FJL 19/05/21
*        SQL.ADD(" delete from "~DBO~".MOVPOSPENACCION ")
*        SQL.ADD(" WHERE  NrOperacion = '"~Val(e:&i)~"' ")
*        SQL.NEW
*        SQL.ADD(" delete from "~DBO~".MOVPOSEJEACCION ")
*        SQL.ADD(" WHERE  NrOperacion = '"~Val(e:&i)~"' ")
*        SQL.NEW
      SQL.ADD("Delete from "~DBO~".TRANSACCIONES2 ")
      SQL.ADD(" where NrTrans = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.ADD("Delete from "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" where NrOperacion = '"~Val(e:&i)~"' ")
      SQL.NEW
      SQL.EXEC
    endif
    ***---Anulo las PDIVID de Posiciones
    SQL.ADD(" Select DISTINCT T.NrTrans ")
    SQL.ADD(" From  "~DBO~".TRANSACCIONES2 T ")
    SQL.ADD(" Where 'PDIVID'  = T.TipoTr2 ")
    SQL.ADD("  and  T.Especie = '"~Dialogo.Especie1~"' ")
    SQL.ADD("  and  T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  and  T.Fecha2 = '"~IdxDate(Dialogo.Fecha2)~"' ")
    if Dialogo.Radio1 = 0
        SQL.ADD("  and T.RB2 = 0 ")
    ENDIF
    SQL.ADD("  and T.RB1 = 0 ")
    SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    If NoVacio(Dialogo.Mercado1) 
      SQL.ADD(" AND T.Mercado1 = '"~Dialogo.Mercado1~"' ")
    Endif
    if NoVacio(Dialogo.Cliente1)
        SQL.ADD("  and  T.Cliente1  = '"~Dialogo.Cliente1~"' ")
    endif
    Recorrer SQL
      if Dialogo.Radio1 = 1
        ***---Anulo la Confirmacion
        SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
        SQL.ADD("   Set Fecha3  = Null, ")
        SQL.ADD("       RB2     = '0' ")
        SQL.ADD(" Where NrTrans = '"~fbn('NrTrans')~"'")
        SQL.NEW
        SQL.ADD("Delete from "~DBO~".MOVPENDIENTES ")
        SQL.ADD(" WHERE NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.NEW
        SQL.ADD("Delete from "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.NEW
        SQL.EXEC
        SQL.ActualizarMovimientosT2(fbn('NrTrans'),NO,NO,NO,SI)
        SQL.EXEC
      ELSE
        ***---Anulo TODO
        SQL.ADD(" delete from "~DBO~".MOVPENDIENTES ")
        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.NEW
        SQL.ADD(" delete from "~DBO~".MOVEJECUTADOS ")
        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.NEW
** FJL 19/05/21
*        SQL.ADD(" delete from "~DBO~".MOVPOSPENACCION ")
*        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrTrans')~"' ")
*        SQL.NEW
*        SQL.ADD(" delete from "~DBO~".MOVPOSEJEACCION ")
*        SQL.ADD(" WHERE  NrOperacion = '"~fbn('NrTrans')~"' ")
*        SQL.NEW
        SQL.ADD(" delete from "~DBO~".TRANSACCIONES2 ")
        SQL.ADD(" where  NrTrans = '"~fbn('NrTrans')~"' ")
        SQL.NEW
        SQL.ADD(" delete from "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" where  NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    Proximo
  endif
proximo

if Val(z:10)>0
  recorrer&i 1,Val(z:10)
    if Dialogo.Radio1 = 1
      ***---Anulo la Confirmacion
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("   Set Fecha3  = Null, ")
      SQL.ADD("       RB2     = '0' ")
