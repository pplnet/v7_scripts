CrearDialogo
  Check1   : 'Procesa'  ;1;1;1;SI;SI;;;;0
FinDialogo
if not OK
  Cancelar
endif   

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF Dialogo.Check1=0
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'Operacion')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'Moneda')
ACT(f:FAC, 'TipoDol')
ACT(g:FAC, 'Mercado')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'Cantidad')
ACT(j:FAC, 'Anula')

SQL.ADD("Select * ") 
SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
SQL.ADD("where NrOperacion = 'INICIALP' ")
SQL.ADD("  and NrSaldo >130 ")
SQL.ADD("  and NrSaldo <140 ")
SQL.ADD("order by Especie,NrSaldo,Mercado,FechaMov ")
recorrer SQL
   ACT(a:FAC, fbn('NrOperacion'))
   ACT(b:FAC, fbn('Especie'))
   ACT(c:FAC, fbn('Cliente'))
   ACT(d:FAC, fbn('NrSaldo'))
   if fbn('NrSaldo')=131
     ACT(e:FAC, 'ARP')
   endif
   if fbn('NrSaldo')=132
     ACT(e:FAC, 'USD')
     ACT(f:FAC, 'MEP')
   endif
   if fbn('NrSaldo')=133
     ACT(e:FAC, 'USD')
     ACT(f:FAC, 'Cable')
   endif
   ACT(g:FAC, fbn('Mercado'))
   ACD(h:FAC, fbn('FechaMov'))
   ACN(i:FAC, fbn('Cantidad'))
proximo

