HojaVisible(SI)
CrearDialogo
  Vehiculo1  :'Vehiculo'   ;;;;;;;;;VAR('VEHICULODE')
  Fecha1     :'Fecha Desde';;;;;;Dialogo.Fecha1<=FSys;'Debe ingresar una fecha';NO;FSys
  Fecha2     :'Fecha Hasta';;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe ingresar una fecha';NO;FSys
  Check1     : 'Lista ANULADAS' ;;;;;;;;;1
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(d:2, 'REGISTRO DE ORDENES')
SetFont(d2,3)

IF NOVACIO(Dialogo.Vehiculo1)
   ACT(a:4, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Vehiculo1))
ENDIF
ACT(a:5,'Fecha Desde: '~Dialogo.Fecha1)
ACT(d:5,'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a3..d5,2)

SetFilaActual(7)

ACT(a:fac, 'Fecha')
ACT(b:fac, 'Hora')
ACT(c:fac, 'Tipo Evento')
ACT(d:fac, 'Tipo Movimiento')
ACT(e:fac, 'ID Origen')
ACT(f:fac, 'ID del Proceso')
ACT(g:fac, 'Nro Oferta')
ACT(h:fac, 'Operacion')
ACT(i:fac, 'Especie')
ACT(j:fac, 'Cantidad')
ACT(k:fac, 'Plazo')
ACT(l:fac, 'Precio/Tasa')
ACT(m:fac, 'Modalidad Origen')
ACT(n:fac, 'Comitente')
ACT(o:fac, 'Operacion')

SetFont(a:fac..v:fac, 2)
AlinearCeldas(a:fac..o:fac,'C')
AgregarMarco(a:fac..o:fac,1,0,Exe('COLOR'))

acn(z1,fac)
acn(z2,fac)
acn(z4,0)
ACN(y8,1 )

ACD(y9, Dialogo.Fecha1 )
act(x9, idxdate(Val(y9)) )

 SQL.ADD(" SELECT Mercado,Agente,OpSIOPEL,L.Fecha,L.Hora,Secuencia as NrOrden, ")
 SQL.ADD("        FechaCarga,FechaOp,HoraOp,SecuenciaOp,TipoOpEv,TipoMov, ")
 SQL.ADD("        FechaOr,HoraOr,SecuenciaOr,FechaHo,HoraHo,SecuenciaHo, ")
 SQL.ADD("        Case When TipoMov = 'A' THEN 'Alta' When TipoMov = 'B' THEN 'Baja' Else 'Modif.' End as 'TipMov', ")
 SQL.ADD("        Case When TipoOpOr = 'C' THEN 'Compra' When TipoOpOr = 'V' THEN 'Venta' When TipoOpOr = 'O' THEN 'Otras' Else '' End as 'TipoOp', ")
 SQL.ADD("        Especie,Plazo,Cantidad,Precio, DatosEspecie,")
 SQL.ADD("        TipoMod,Comitente,TipoModDe,ComitenteDe,NroOrdenMe, ")
 SQL.ADD("        TipoOrd,NrOrdHo,NrOferta,MercadoMeOr,MercadoMeDe, ")
 SQL.ADD("        UsrInput,L.Cupon,NrOperacionRef ")
 SQL.ADD(" FROM "~DBO~".LIBORDENES L ")
 IF NoVacio(Dialogo.Fecha1)
    SQL.ADD(" Where L.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
 ENDIF
 IF NoVacio(Dialogo.Fecha2)
    SQL.ADD(" AND  L.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
 ENDIF
 SQL.ADD(" ORDER BY 1")

Recorrer SQL
  acn(z3,1)
  ACT(a:fac, Fecha(trunc(FBN['FechaOp'])))
  ACT(b:fac, FBN['HoraOp'])
  ACT(c:fac, 'Ofertas')
  ACT(d:fac, FBN['TipMov'])
  ACT(e:fac, Copy(FBN['FechaOr'],9,2)~Copy(FBN['FechaOr'],4,2)~Copy(FBN['FechaOr'],1,2)~Copy(FBN['HoraOr'],1,2)~Copy(FBN['HoraOr'],4,2)~Copy(FBN['HoraOr'],7,2)~FBN['SecuenciaOr'])
  ACT(f:fac, Copy(FBN['FechaHo'],9,2)~Copy(FBN['FechaHo'],4,2)~Copy(FBN['FechaHo'],1,2)~Copy(FBN['HoraHo'],1,2)~Copy(FBN['HoraHo'],4,2)~Copy(FBN['HoraHo'],7,2)~FBN['SecuenciaHo'])
  ACT(g:fac, Copy(FBN['FechaHo'],9,2)~Copy(FBN['FechaHo'],4,2)~Copy(FBN['FechaHo'],1,2)~Copy(FBN['HoraHo'],1,2)~Copy(FBN['HoraHo'],4,2)~Copy(FBN['HoraHo'],7,2)~FBN['SecuenciaHo'])
  ACT(h:fac, FBN['TipoOp'])
  ACT(xy:50,BuscarCampo('ESPECIES','Nombre','Codigo',FBN['Especie']))
  If NoVacio(val(xy50))
     ACT(gg:fac,Val(xy50))
  else
     ACT(gg:fac,'Especie no esta en FPA')
  Endif
  ACT(i:fac, FBN['ESPECIE']~'-'~Val(gg:fac)~'-'~Copy(FBN['DatosEspecie'],1,8))
  ACN(j:fac, FBN['Cantidad'])
  ACN(k:fac, FBN['Plazo'])
  ACN(l:fac, FBN['Precio'])
  ACT(m:fac, 'Cartera Propia')
  ACT(n:fac, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CLIENTES','Codigo','CUIT',FBN['Comitente'])),1,20))
  ACT(o:fac, FBN['NrOperacionRef'])

  SetFont(a:fac..v:fac, 1)
  AlinearCeldas(a:fac..g:fac,'C')
  AlinearCeldas(h:fac..i:fac,'C')
  AlinearCeldas(m:fac..m:fac,'C')
  AlinearCeldas(n:fac..n:fac,'D')
Proximo

if Val(z3)=0 
  Cancelar('No existen Ordenes a Imprimir')
endif

SetFilaActual(fac+3)

Formatoceldas(k:7..k:fac, EXE('F0'))
Formatoceldas(j:7..j:fac, EXE('F2'))
Formatoceldas(l:7..l:fac, EXE('F9'))

ACO(1,10)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,15)
ACO(6,15)
ACO(7,15)
ACO(8,10)
ACO(9,20)
ACO(10,12)
ACO(11,6)
ACO(12,10)
ACO(13,12)
ACO(14,9)

Impresion(1,2)
Impresion(2,0)
Impresion(3,1)
Impresion(4,1)

SetPrintFit(3,65)
SetMargins(0,0,0,2)
LimitesVision(o:fac)
