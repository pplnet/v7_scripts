IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

MostrarCuadroDeMensajes
CrearDialogo
  Fecha1: 'Fecha'                ;1;;;;;;;;FSys
  Radio1: 'Filtra Book|SI|NO'    ;2;;;;;;;;1;
  Lista1: 'Vehiculos'            ;3;;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Vehiculo1: 'Vehiculo'          ;3;;;;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2: 'Books'                ;4;;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
FinDialogo

If Not OK
    Cancelar
Endif

**Vehiculo/s
If Dialogo.Radio1=1
    **Si no filtra Book, se toman vh de Dialogo.Lista1 o todos en caso de no seleccionar ninguno
    If Vacio(Dialogo.Lista1)
        let &lista1 Val(LS:1)
    Else
        let &lista1 Dialogo.Lista1    
    Endif
Else
    *Si filtra book, sólo se seleccionará un vh el cual se toma de Dialogo.Vehiculo1
    let &lista1 Dialogo.Vehiculo1~'|'
    If NoVacio(Dialogo.Lista2)
        *Se toman los seleccionados en la lista de books
        let &books Dialogo.Lista2
    Else
        **Si no selecciona book, se toman todos
        let &books SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ")
    Endif
Endif

*message(' Calculando rentabilidad del '~Dialogo.Fecha1)
*Expresado en ARP
LinkearHoja('POSICI',1,Fecha1=Dialogo.Fecha1,Lista1=&lista1,Radio1=1,Radio2=0,Radio3=1,Check1=1,Radio4=0)

let &radio2 0
Recorrer&i LinkH(1, ZZ:1),LinkH(1, ZZ:2)
    IF NoVacio(LinkH(1,D:&i))
        If Dialogo.Radio1=1 o (Dialogo.Radio1=0 y Incluido(LinkH(1,D:&i),&books))
            **Ingresa si no filtra por book o si filtra por book y un book seleccionado
            let &book LinkH(1,D:&i)
            let &tCartera LinkH(1,X:&i)
            (.'CALCVCART'.)
            **Calculo los campos Day de Rentabilidad (dentro ya aplica el TC para MONEEXTR y lo inserta, por eso se llama sólo una vez
            (.'CALCDAYREN'.)
        Endif
    ELSE
        If Dialogo.Radio1=1 o (Dialogo.Radio1=0 y EqStr(LinkH(1,A:&i),Dialogo.Vehiculo1))
            **Ingresa si no filtra por book o si filtra por book y el vh es el seleccionado
            let &vehiculo LinkH(1,A:&i)
            *message(' Vehiculo '~&vehiculo)
        Endif
    ENDIF    
Proximo

*Expresado en USD
LinkearHoja('POSICI',2,Fecha1=Dialogo.Fecha1,Lista1=&lista1,Radio1=1,Radio2=1,Radio3=1,Check1=1,Radio4=0)

let &radio2 1
Recorrer&i LinkH(2, ZZ:1),LinkH(2, ZZ:2)
    IF NoVacio(LinkH(2,D:&i))
        If Dialogo.Radio1=1 o (Dialogo.Radio1=0 y Incluido(LinkH(2,D:&i),&books)) 
            **Ingresa si no filtra por book o si filtra por book y un book seleccionado        
            let &book LinkH(2,D:&i)
            let &tCartera LinkH(2,X:&i)
            (.'CALCVCART'.)
        Endif
    ELSE
        If Dialogo.Radio1=1 o (Dialogo.Radio1=0 y EqStr(LinkH(2,A:&i),Dialogo.Vehiculo1))
            **Ingresa si no filtra por book o si filtra por book y el vh es el seleccionado        
            let &vehiculo LinkH(2,A:&i)
        Endif
    ENDIF    
Proximo


