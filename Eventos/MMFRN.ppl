**-- MMFRN: Cesi¦n de Capital de FRN 
**-- HOJAVISIBLE(SI)
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe Ingresar una Operaci¦n';NO;
  Cliente4     : "Coloca"                   ;;;;NO;;NOT EQSTR(Dialogo.Cliente1, Dialogo.Cliente4);'LOS PARTICIPANTES NO PUEDEN SER IGUALES';NO;;BuscarCampo('Operaciones','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Cliente3     : 'Arranger'                 ;;;;NO;;;;;;BuscarCampo('Operaciones','Cliente3','NrOperacion',Dialogo.NrOperacion1)
  Cliente2     : 'Agente'                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Cliente2','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Moneda"                   ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
  Fecha1       : "Vto V_Nominal"            ;;;;NO;;;;;;BuscarCampo('Operaciones','FechaVto','NrOperacion',Dialogo.NrOperacion1)
  Cantidad1    : "VNA"                      ;;;;NO;;;;;;BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion1)
  TipoOp1      : 'TipoOp'                   ;;;;NO;NO;;;;;BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cliente1     : "Toma"                     ;2;2;;;;DESCIENDEDECLIENTE(Dialogo.Cliente1,'BANCOS') Y Not EqStr(Dialogo.Cliente1,Dialogo.Cliente4);'El Cliente Debe Ser una Entidad Bancaria ';NO;;
  Cantidad2    : "Valor Nominal"            ;;;;;;Dialogo.Cantidad2<=Dialogo.Cantidad1;'El Valor Nominal de la Nueva Operacion debe ser Inferior al Valor Nominal del Original';NO;;
  Radio1       : "Ya Participa?|No|Si"      ;;;;NO;;;;;;IIF(NOVACIO(Dialogo.NrOperacion3),1,0)
  Precio3      : "TTN"                      ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o Dialogo.Precio3>0];'La Tasa Total Neta es INVALIDA';NO;;
  Fecha3       : "Concertacion"             ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o Dialogo.Fecha3<=Dialogo.Fecha4];'Fecha de Concertaci¦n Incorrecta';NO;Fsys
  Fecha4       : "Origen"                   ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o ESHABIL(Dialogo.Fecha4,BuscarCampo('Operaciones','TablaFeriados1','NrOperacion',Dialogo.NrOperacion1))];'Fecha de Origen Incorrecta';NO;FSYS;IIF(Dialogo.Radio1=1, SQL("Select FechaVto2 from "~DBO~".OPERACIONES where NrOperacion='"~Dialogo.NrOperacion3~"' "),FSYS)
  Precio4      : 'Tasa WH'                  ;8;;;Dialogo.Radio1=0 y Dialogo.Radio4=1;Dialogo.Radio1=0 y Dialogo.Radio4=1;[Not [Dialogo.Radio1=0 y Dialogo.Radio4=1]] o Incluido(Fstr(Dialogo.Precio4,2,4),VAR('TASAWH'));'El Valor de Tasa WH es Invalido: '~Fstr(Dialogo.Precio4,2,4)~' '~VAR('TASAWH')~' ...';NO;;;;
  Precio5      : 'Tasa IVA'                 ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;[Not Dialogo.Radio1=0] o Incluido(Fstr(Dialogo.Precio5,2,2),VAR('IVA'));'El Valor de Tasa IVA es Invalido: '~Fstr(Dialogo.Precio5,2,2)~' '~VAR('IVA')~' ...';NO;;;;
  Precio6      : 'Tasa ImpInt'              ;;;;Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMPSI')] o [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFRNP')]];Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMPSI')] O [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFRNP')]];Not [Dialogo.Radio1=0 y [[Dialogo.Radio4=0 y EqStr(Dialogo.TipoOp1,'MMPSI')] o [Dialogo.Radio4=1 y EqStr(Dialogo.TipoOp1,'MMFRNP')]] ] o Incluido(Fstr(Dialogo.Precio6,2,4),VAR('TASAINT'));'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';NO;;;;;"###.####"
  Precio7      : 'Tasa Int WH'              ;;;;Dialogo.Radio1=0 y Dialogo.Radio4=1;Dialogo.Radio1=0 y Dialogo.Radio4=1;Dialogo.Precio7>0;'El Valor de Tasa Int WH es Invalido';si;;BuscarCampo('Operaciones','Precio1+Spread','NrOperacion',Dialogo.NrOperacion1);;
  Precio8      : 'Tasa Int IVA'             ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Precio8>0;'El Valor de Tasa IVA es Invalido';NO;;BuscarCampo('Operaciones','Precio1+Spread','NrOperacion',Dialogo.NrOperacion1);;
  NrOperacion3 : "Op.Participa"             ;;;;NO;NOVACIO(Dialogo.NrOperacion3);;;;;SQL("Select NrOperacion from "~DBO~".OPERACIONES where (OperacionRef='"~Dialogo.NrOperacion1~"' or OperacionRef='"~Dialogo.NrOperacion2~"') and Cliente1='"~Dialogo.Cliente1~"' and TipoOp='"~Dialogo.TipoOp1~"' ")
  Radio4       : 'Pmo.|Local|Extranjero'    ;2;2;;NO;NO;;;;;IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1)
  NrOperacion2 : 'Referencia'               ;2;2;;NO;NO;;;;;BuscarCampo('Operaciones','OperacionRef','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

If Not Ok
  Cancelar
Endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(Dialogo.TipoOp1,'MMFRNP|MMPSI')
   Cancelar('La operacion N¦ '~Dialogo.NrOperacion1~' No es Participante de FRN o Sidicado')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
Else
   If Dialogo.Radio1=1 
      * Verifico que se encuentre en Back Office o Terminal
      ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion3~"' AND Valor='1'") )

      If VAL(X1)<>20 y VAL(X1)<>50
         *-- Busco la instancia actual
         *Cancelar('La Operaci¦n Participante '~Dialogo.NrOperacion3~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
      EndIf
   EndIf
EndIf

* Si el Cliente ya participa Verifico las instancias de la Operaci¦n  Participante
If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")

   Recorrer SQL
        acn(x1,1)

        *-- A5: TotalComisiones   A6: ValorNominal Total  
        ACN(A6,Dialogo.Cantidad2)

        *-- C3: TasaWH C4: TasaIVA  c1: Tasa Int Calculo WH c2: Tasa Int Calculo IVA
        *-- SI NO EXISTE LA TOMADORA GENERA NUEVA OPERACION
        *-- C5: Impto.Intereses
        SQL.ADD("Select * from "~DBO~".OPERACIONES ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")

        acn (j1,0)

        ACN(C3,Dialogo.Precio4)
        ACN(C4,Dialogo.Precio5)
        ACN(C5,Dialogo.Precio6)

        ACN(C1,Dialogo.Precio7)
        ACN(C2,Dialogo.Precio8)
        
        Recorrer SQL
          acn (j1,1)
          ACN(A6,VAL(A6)+FBN['Cantidad'])        

          ACN(C1,FBN['TotalAux2'])
          ACN(C2,FBN['TotalAux4'])
         
          ACN(C3,FBN['TotalAux1'])
          ACN(C4,FBN['ImpGastos2'])
          ACN(C5,FBN['TasaImp1'])
        Proximo

        *-- A1: Interes
        ACN(A1,VAL(A6)*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))

        *-- A2: Entidad Local o Extranera -> CB10
        ACN(A2,IIF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',Dialogo.Cliente1)),0,1))

        *-- A3: Importe WH A4: Importe IVA 
        *-- TotalAux3       : 'Importe WH'     
        *-- A8: Importe Imp.Interes
        *-- A7: Plazo
        ACD(A7,FBN['FechaVto']-FBN['FechaOp'])
        ACN(A4,0)
        ACN(A3,0)

        *-- C3: TasaWH C4: TasaIVA
        IF val(C4)<>0
           ACN(A4,((VAL(A6)*(val(c2)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(VAL(C4)/100))
        EndIf

        IF VAL(A2)=0 
           IF EqStr(FBN['TipoOp'],'MMPSC')
              *-- Calculo del Imp.Interes
              ACN(A9,VAL(A1)*VAL(c5)/100)
           EndIf
        Else 
           IF Not EqStr(FBN['TipoOp'],'MMPSC')
              *-- Calculo del Imp.Interes
              ACN(A9,VAL(A1)*VAL(c5)/100)
           EndIf
           ACN(A3,((VAL(A6)*(val(c1)/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(VAL(C3)/100))
        ENDIF       

        Message('Actualizando la Operacion Original .... ')

        *-- Resta el valor nominal al vna de la colocadora
        *-- B1: TotalInteres =>Interes  B2: TotalNetoCli2 => InteresTotal 
        *-- B3: TotalBrutoCli1 => Monto B4: TotalNetoCli1 => Monto Total
        *-- B5: TotalAux3=> Importe WH  B6: TotalIVA => Importe de Iva
        ACN(B1,(Dialogo.Cantidad1-Dialogo.Cantidad2)*((FBN['Precio1']+FBN['Spread'])/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)) 
        ACN(B5,(((Dialogo.Cantidad1-Dialogo.Cantidad2)*(FBN['TotalAux2']/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(FBN['TotalAux1' ]/100))
        ACN(B6,(((Dialogo.Cantidad1-Dialogo.Cantidad2)*(FBN['TotalAux4']/100))*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1))*(FBN['ImpGastos2']/100))

        ACN(B2,VAL(B1)+VAL(B5))
        ACN(B3,VAL(B1)+(Dialogo.Cantidad1-Dialogo.Cantidad2))
        ACN(B4,VAL(B2)+(Dialogo.Cantidad1-Dialogo.Cantidad2))

        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set Cantidad=Cantidad-"~FStr(Dialogo.Cantidad2,0,2)~", ")
        SQL.ADD("    TotalIntereses="~FStr(VAL(B1),0,2)~", ")
        SQL.ADD("    TotalNetoCli2="~FStr(VAL(B2),0,2)~", ")
        SQL.ADD("    TotalBrutoCli1="~FStr(VAL(B3),0,2)~", ")
        SQL.ADD("    TotalNetoCli1="~FStr(VAL(B4),0,2)~", ")
        SQL.ADD("    TotalAux3="~FStr(VAL(B5),0,2)~", ")
        SQL.ADD("    TotalIVA="~FStr(VAL(B6),0,2)~", ")
        SQL.ADD("    FechaVto2='"~IdxDate(Dialogo.Fecha4)~"', ")
        SQL.ADD("    CantidadOri=CantidadOri-"~FStr(Dialogo.Cantidad2,0,2)~" ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        EjecutarEvento('INSCOM',NrOperacion1=FBN['OperacionRef'],NrOperacion2=Dialogo.NrOperacion1,String=" Tipo  IN ('5','3')")

        * Actualizo la Instancia de la Operacion a Supervision
        (.'MODIINSTAN'.)      

        * Actualiza movimientos y limites ****
        SQL.ActualizarMovimientos(Dialogo.NrOperacion1,SI)
        SQL.EXEC

        IF val(j1)=0
           Message('Generando la Nueva Operaci¦n   .... ')          

           *** Z3 Nro. Operacion Contado
           ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

           * Genero el Nuevo FRN 
           SQL.ADD("Insert INTO "~DBO~".OPERACIONES ")
           SQL.ADD("(TipoOp,NrOperacion,")
           SQL.ADD("FechaOp2,FechaOp, ")
           SQL.ADD("RB10,OperacionRef,")
           SQL.ADD("Vehiculo1, ")
           SQL.ADD("Cliente1,Cliente2,Cliente3,")
           SQL.ADD("Especie,Plazo,")
           SQL.ADD("FechaVto2,TipoTasa,Precio1,")
           SQL.ADD("RB8,Spread,TotalBrutoCli2, ")
           SQL.ADD("FechaPago,Cantidad,FechaVto,")
           SQL.ADD("TotalIntereses,Precio4,")
           SQL.ADD("TotalNetoCli2,TablaFeriados1,TotalBrutoCli1,")
           SQL.ADD("TotalNetoCli1,Observac2,Operador,")
           SQL.ADD("CB10,TotalAux1,TotalAux2,TotalAux3,")
           SQL.ADD("ImpGastos2,TotalAux4,TotalIVA,RB3,")
           SQL.ADD("PrecioEj,Impresa,FechaEx1,")
           SQL.ADD("Cotizacion1,NrOperacion3,Cuotas1,RB5,TasaImp1,ImporteImp,IntDevengados2,")
           SQL.ADD("Indice,ResultadoIndice,CantidadOri,Coeficiente, Book1) ")
           SQL.ADD(" Values ")
           SQL.ADD(" ('"~Dialogo.TipoOp1~"','"~VAL(Z3)~"',")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha3)~"','"~IdxDate(Dialogo.Fecha4)~"', ") 
           SQL.ADD(" '"~FBN['RB10']~"','"~FBN['OperacionRef']~"', ")
           SQL.ADD(" '"~FBN['Vehiculo1']~"', ")
           SQL.ADD(" '"~Dialogo.Cliente1~"','"~Dialogo.Cliente2~"','"~Dialogo.Cliente3~"',")
           SQL.ADD(" '"~FBN['Especie']~"',"~FStr(VAL(A7),0,0)~", ")
           SQL.ADD(" '"~IdxDate(FBN['FechaVto2'])~"','"~FBN['TipoTasa']~"',"~FStr(FBN['Precio1'],0,7)~", ")
           SQL.ADD(" '"~FStr(FBN['RB8'],0,0)~"', "~FStr(FBN['Spread'],0,7)~","~FStr(Dialogo.Cantidad2,0,2)~", ")
           SQL.ADD(" '"~IdxDate(Dialogo.Fecha4)~"',"~FStr(Dialogo.Cantidad2,0,2)~", '"~IdxDate(FBN['FechaVto'])~"',")
           SQL.ADD(" "~Fstr(VAL(A1),0,7)~", "~Fstr(Dialogo.Precio3,0,7)~",")
           SQL.ADD(" "~Fstr(VAL(A1)+VAL(A3),0,7)~",'"~FBN['TablaFeriados1']~"',"~Fstr(VAL(A6)+VAL(A1),0,2)~",")
           SQL.ADD(" "~Fstr(VAL(A6)+VAL(A1)+VAL(A3),0,2)~",'"~FBN['Observac2']~"','"~USUARIOACTIVO~"', ")
           SQL.ADD(" '"~Fstr(VAL(A2),1,0)~"',"~Fstr(val(c3),0,7)~","~Fstr(val(c1),0,7)~","~Fstr(VAL(A3),0,2)~", ")
           SQL.ADD(" "~Fstr(val(c4),0,7)~","~Fstr(val(c2),0,7)~","~Fstr(VAL(A4),0,2)~",'"~FBN['RB3']~"',")
           SQL.ADD(" "~Fstr(VAL(A6),0,2)~",'"~FBN['Impresa']~"','"~IdxDate(FBN['FechaEx1'])~"',")
           SQL.ADD(" "~Fstr(FBN['Cotizacion1'],0,5)~",'"~Dialogo.NrOperacion1~"',"~Fstr(FBN['Cuotas1'],0,0)~",'"~FBN['RB5']~"', ")
           SQL.ADD(" "~Fstr(Dialogo.Precio6,0,7)~","~Fstr(VAL(A9),0,2)~",-1,")
           SQL.ADD(" '"~FBN['Indice']~"',0,"~FStr(Dialogo.Cantidad2,0,2)~",1 , '"~FBN['Book1']~"') ")
           SQL.NEW

           **-- Traslado los calls y puts no posterioress a la Fecha de Creacion
           SQL.ADD("INSERT INTO "~DBO~".OPSCALLSPUTS (NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida) ")
           SQL.ADD("SELECT '"~VAL(Z3)~"' As NrOperacion,TipoOpcion,FechaEj,PrecioEj,Ejercida ")
           SQL.ADD("FROM "~DBO~".OPSCALLSPUTS WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
           SQL.ADD("and FechaEj>='"~IdxDate(Dialogo.Fecha4)~"' ")
           SQL.NEW
           SQL.EXEC

           * Alta de Instancias Z3: Nro.Operacion
           (.'ALTAINSTAN'.)

           EjecutarEvento('INSCOM',NrOperacion1=FBN['OperacionRef'],NrOperacion2=VAL(z3),String=" Tipo  IN ('5','3')")

           * Despues de calcular las comisiones con el plazo de la cabecera, lo modifico 
           * para que quede el plazo restante
           SQL.ADD("Update "~DBO~".OPERACIONES ")
           SQL.ADD("Set Plazo= "~FStr(FBN['FechaVto']-Dialogo.Fecha4,0,0)~" ")
           SQL.ADD("where NrOperacion = '"~VAL(z3)~"' ")
           SQL.NEW
           SQL.EXEC

           * Actualiza movimientos y limites ****
           SQL.ActualizarMovimientos(VAL(z3),SI)
           SQL.EXEC
        Else 
          SQL.ADD("Update "~DBO~".OPERACIONES ")
          SQL.ADD("Set Cantidad=Cantidad+"~FStr(Dialogo.Cantidad2,0,2)~", ")
          SQL.ADD("    TotalIntereses="~FStr(VAL(A1),0,2)~", ")
          SQL.ADD("    TotalNetoCli2="~FStr(VAL(A1)+VAL(A3),0,2)~", ")
          SQL.ADD("    TotalBrutoCli1="~FStr(VAL(A6)+VAL(A1),0,2)~", ")
          SQL.ADD("    TotalNetoCli1="~FStr(VAL(A6)+VAL(A1)+VAL(A3),0,2)~", ")
          SQL.ADD("    TotalAux3="~FStr(VAL(A3),0,2)~", ")
          SQL.ADD("    TotalIVA="~FStr(VAL(A4),0,2)~", ")
          SQL.ADD("    ImporteImp="~FStr(VAL(A9),0,2)~", ")
          SQL.ADD("    FechaVto2='"~IdxDate(Dialogo.Fecha4)~"', ")
          SQL.ADD("    CantidadOri=CantidadOri+"~FStr(Dialogo.Cantidad2,0,2)~" ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
          SQL.NEW

          * Borro las comisiones de la Operacion Original y los Settlement
          SQL.ADD("DELETE "~DBO~".CUOTAS ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
          SQL.NEW

          SQL.ADD("DELETE "~DBO~".COMISIONES2 ")
          SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion3~"' ")
          SQL.NEW
          SQL.EXEC

          * Actualizo la Instancia de la Operacion a Supervision
          ACT(i3,Dialogo.NrOperacion3)
          (.'MODIINSTAN'.)      

          EjecutarEvento('INSCOM',NrOperacion1=FBN['OperacionRef'],NrOperacion2=Dialogo.NrOperacion3,String=" Tipo  IN ('5','3')")

          * Actualiza movimientos y limites ****
          SQL.ActualizarMovimientos(VAL(i3),SI)
          SQL.EXEC
        Endif
   proximo

   If Val(x1)=0
      Cancelar('La Operaci¦n N¦ '~Dialogo.NrOperacion1~' No pudo Desdoblarse')
   endif
endif