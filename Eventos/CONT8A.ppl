MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:   'Fecha'       ;;;;;;;;;fsys
  Lista1:   'Vehiculos'   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  ListaTabla1: 'Operaciones'  ;-4;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

message('--- Asientos de Transferencias entre Cuentas ---')

***---ACT(US:1, Descendientes('ESPECIES', 'U$S'))
ACT(US:1, Var('MONEEXTR'))

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad Cantidad1, O.Especie Moneda, MA.Codigo CodAsi, ")
SQL.ADD(" O.Vehiculo1, O.Especie, O.FechaVto Fecha2, O.FechaOp Fecha1, O.Cuenta4 Cuenta2, O.TipoOp, ")
SQL.ADD(" O.Cuenta1, V.Valor1, V.Valor2, O.Cliente1, O.Precio1, O.Plazo, O.Observaciones, O.Cantidad, M.Cuenta, ")
SQL.ADD(" '' Alias8, M.NrTrans2 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND O.NrOperacion =  B.NrOperacion  ")
SQL.ADD(" AND O.Vehiculo1 =  V.Codigo  ")
SQL.ADD(" AND (B.NrBit =  20 OR B.NrBit = 50) ")
SQL.ADD(" AND B.Valor  =  '1'      ")
SQL.ADD(" AND O.TipoOp in ('TRANSF') ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND O.MB3 = 0 ")
SQL.ADD(" AND M.NrSaldo = 1 ")
***---Solo tomo el movimiento positivo ya que se contabiliza un solo asiento
SQL.ADD(" AND M.Cantidad > 0 ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASITRAN'))~") ")
If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Else
   SQL.ADD(" AND M.FechaEje = '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVAcio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
   Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
         SQL.ADD(" AND O.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
      Endif
   Endif
Endif
SQL.ADD(" ORDER By MA.Codigo, O.NrOperacion ")
Recorrer SQL
  ACD(FV:1, fbn('Fecha2'))
  ACT(VH:1, fbn('Vehiculo1'))
  (.'FECHAVALOR'.)
  ACN(CK:1, 0)
  ***---Cuenta Origen
  ACT(CO:1, fbn('Cuenta'))
  ***---Cuenta Destino
  ACT(CD:1, SQL(" Select Cuenta From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Cantidad < 0 AND NrSaldo = 1 "))
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
           IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado = 'E' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    IF Val(CK:1) = 0
      message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
      SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans2'),,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
    ENDIF
Proximo

