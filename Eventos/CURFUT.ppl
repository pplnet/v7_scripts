HOJAVISIBLE(SI)
*-- Curva de Futuros de Commodities 
CrearDialogo
   Fecha1   : 'Fecha'    ;;;;NO;;;;;Fsys;;;;;;
   Especie1 : 'Especie'  ;;;;;;;;;'WTI';;;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf
ACT(a1, 'Curva de Futuros de Commodities al '~Dialogo.Fecha1)

ACT(a3, 'Contrato')
ACT(b3, 'Precio')
ACT(c3, 'LastTrade')

AlinearCeldas(a3..c3, 'D')

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')
AgregarMarco(a3..c3,2,0,Exe('COLOR'))

*-- Incorporo a la Curva de Futuros los Valores de Bloomberg desde Hoy hacia Adelante
*-- Sintaxis para linkear => Los Contratos comienzan en la fila val(z2), columna val(z3)
LinkearDDEServer('Excel','[ContFut.xls]Hoja1')

SQL.ADD("Select * from "~DBO~".CONTRATOS Where Especies Like '%"~Dialogo.Especie1~"%' and ")
SQL.ADD(" LastTradingDate>='"~IdxDate(Dialogo.Fecha1)~"' Order By LastTradingDate ")


ACN(x1,0)

SetFilaActual(4)

ACN(z3,3)

ACD(c:fac,HABILES(Dialogo.Fecha1,-1,'ARG',SI) )
ACD(z4,Dialogo.Fecha1)
SetFont(a:fac..c:fac, 1)

*-- Recorrer valores
Recorrer SQL

  *- Busco el la planilla exel en que fila esta el primer contrato   
  If val(x1)=0
     Recorrer&j 1,100
         *-- armar celda excel para encontrar el codigo del 1er. contrato
         ACT(z6,'f'~FStr(&j,0,0)~'c1')  
         ACF(a:fac, LinkDDE(Val(z6)) )   

         If EqStr(VAL(a:fac),FBN['Codigo'])
            ACN(z2,&j)  
            Break
         EndIf
     Proximo    
     ACN(x1,1)
  EndIf

  If val(z2)>0 
     Message('Contrato Futuro '~FBN['Codigo'])

     *-- armar celda excel  
     ACT(z6,'f'~FStr(val(z2),0,0)~'c'~FStr(val(z3),0,0))  

     ACT(a:fac,FBN['Codigo'])
     ACF(b:fac, LinkDDE(Val(z6)) )
     ACD(c:fac,FBN['LastTradingDate'])

     SetFont(a:fac..c:fac, 1)
     FormatoCeldas(b:fac..b:fac, Exe('F7'))

     *- Recupero los dias de la curva de futuros desde fecha de contrato 
     *  hasta la del siguiente contrato

     ACN(z1,DifDias(HABILES(val(c:fac-1),1,'ARG',SI),val(c:fac),'ARG',SI)+1)
  
     Recorrer&i 1,VAL(z1)
        Message("  Actualizando Precios al "~VAL(z4)~" ...")
  
        * Verifico si Existe el dia en la curva, sino lo creo
        IF SQL("SELECT Count(*) FROM "~DBO~".CURVAFUTUROSCOMM Where Especie='"~Dialogo.Especie1~"' and Fecha='"~IdxDate(VAL(z4))~"' ")=1
           SQL.ADD("UPDATE "~DBO~".CURVAFUTUROSCOMM Set PrecioFut="~Fstr(VAL(b:fac),0,7)~" Where ")
           SQL.ADD("Especie='"~Dialogo.Especie1~"' and ")
           SQL.ADD("Fecha='"~IdxDate(VAL(z4))~"' ")
        Else 
           SQL.ADD(" INSERT "~DBO~".CURVAFUTUROSCOMM ")
           SQL.ADD(" (Especie,Fecha,PrecioFut,PrecioCon) ")
           SQL.ADD(" Values ")
           SQL.ADD(" ('"~Dialogo.Especie1~"','"~IdxDate(VAL(z4))~"',"~Fstr(VAL(b:fac),0,7)~",0) ")
        EndIf

        SQL.NEW
        SQL.EXEC 

        ACD(z4,HABILES(VAL(z4),1,'ARG',SI))
     Proximo
  
     SCN(z2,1)
   Else 
      Cancelar('No se encontro el Primer contrato en la planilla excel !!!')
   EndIf

Proximo

ACO(1,10)
ACO(2,10)
ACO(3,10)
LimitesVision(f:fac)


