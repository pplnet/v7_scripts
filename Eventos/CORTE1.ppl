   ACN(s:8, Dialogo.Precio10) 
   
   if Val(y:1)=1
*MessageBox('Procesa')     
     * Procesa - Viene de Dialogo.Check1
     *----------- Modifico la especie ----------------*
     SQL.ADD("UPDATE "~DBO~".ESPECIES ")
     SQL.ADD("SET Cupon             = "~Fstr(Val(c:3),0,0)~", ")
     SQL.ADD("    VTeorico          = "~Fstr(Val(e:3),0,9)~", ")
     SQL.ADD("    FechaCorteCupon   = '"~IdxDate(Val(g:2))~"',  ")
     SQL.ADD("    FechaProximoCorte = '"~IdxDate(val(ck:1))~"', ")
     SQL.ADD("    FechaPagoCupon    = '"~IdxDate(Dialogo.Fecha2)~"', ")
     SQL.ADD("    IntsCapitalizados = "~Fstr(Val(r:4),0,9)~" ")
     SQL.ADD("WHERE Codigo          = '"~Dialogo.Especie1~"' ")
     SQL.NEW

     message(' Actualizando Especie ')

     *----------- Modifico LA ESPECIE CUPON -------------*
     SQL.ADD("UPDATE "~DBO~".ESPECIES ")
     SQL.ADD("SET Cupon             = "~Fstr(Val(c:2),0,0)~", ")
     SQL.ADD("    Fecha             = '"~IdxDate(Val(h:4))~"', ")
     SQL.ADD("    FechaCorteCupon   = '"~IdxDate(Val(g:2))~"', ")
     SQL.ADD("    FechaPagoCupon    = '"~IdxDate(Dialogo.Fecha2)~"', ")
     SQL.ADD("    FechaProximoCorte = '"~IdxDate(val(ck:1))~"', ")
     SQL.ADD("    VTeorico          = "~FSTR(Val(e:2),1,9)~" ")
     SQL.ADD("WHERE Codigo          = '"~Val(b:4)~"' ")
     SQL.NEW
     Message(' Actualizando Especie Cupon ')

     *----------- Inserto Cotizacion ESPECIE CUPON -------------*
     IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Fecha = '"~IdxDate(Dialogo.Fecha4)~"' AND Codigo = '"~Val(b:4)~"' AND CallPut = 'CON' AND Moneda = '"~Dialogo.Especie2~"'  ") <> 1
       Message('Alta Cotizacion  '~Val(b:4))
       SQL.ADD(" Insert Into "~DBO~".COTIZACIONES ")
       SQL.ADD(" (Fecha, Codigo, CallPut, ")
       SQL.ADD(" Precio1, Precio2, Precio3,Moneda) ")
       SQL.ADD(" Values ")
       SQL.ADD(" ('"~IdxDate(Dialogo.Fecha4)~"', '"~Val(b:4)~"', 'CON', ")
       SQL.ADD(" "~Fstr(Dialogo.Precio6, 0, 8)~",  "~Fstr(Dialogo.Precio6, 0, 8)~", ")
       SQL.ADD(" "~Fstr(Dialogo.Precio6, 0, 8)~", '"~Dialogo.Especie2~"') ")
       SQL.NEW
     ELSE
       Message('Modificacion Cotizacion '~Val(b:4))
       SQL.ADD(" Update "~DBO~".COTIZACIONES ")
       SQL.ADD(" Set Precio1 = "~Fstr(Dialogo.Precio6, 0, 8)~", ")
       SQL.ADD(" Precio2 = "~Fstr(Dialogo.Precio6, 0, 8)~", ")
       SQL.ADD(" Precio3 = "~Fstr(Dialogo.Precio6, 0, 8)~" ")
       SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha4)~"' ")
       SQL.ADD(" AND Codigo = '"~Val(b:4)~"' ")
       SQL.ADD(" AND CallPut = 'CON' ")
       SQL.ADD(" AND Moneda = '"~Dialogo.Especie2~"' ")
       SQL.NEW
     ENDIF

     *---------- Actualiza Tabla AgendaCupon ------------*
     SQL.ADD(" UPDATE "~DBO~".AGENDACUPONES SET ")
     SQL.ADD(" FechaCorte  = '"~IdxDate(Val(g2))~"', ")
     SQL.ADD(" FechaPago   = '"~IdxDate(Dialogo.Fecha2)~"', ")
     SQL.ADD(" VTeoricoAnt = "~FSTR(Val(e:2),1,9)~", ")
     SQL.ADD(" IntsCapitalizados  = "~Fstr(Val(q:2),0,9)~", ")
