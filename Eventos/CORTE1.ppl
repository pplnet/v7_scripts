     SQL.ADD(" PorRenta        = "~FSTR(Val(l:8),1,9)~", ")
     SQL.ADD(" PorAmIntCap     = "~FSTR(Val(m:2),1,9)~", ")
     IF Val(k:2)=0
       * es renta
       SQL.ADD(" TipoCupon = 'REN' ")
     ELSE
       IF Val(l:2)=0
         *es amort  
         SQL.ADD(" TipoCupon = 'AMO' ")
       ELSE
         *es renta y amo
         SQL.ADD(" TipoCupon = 'RYA' ")
       ENDIF
     ENDIF 
     SQL.ADD(" WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Val(c2),1,0)~"' ")
