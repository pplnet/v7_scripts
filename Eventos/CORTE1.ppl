     SQL.ADD(" PrecioCupon     = "~FSTR(Val(f:8),1,9)~", ")
     SQL.ADD(" FechaProceso    = '"~IdxDate(Fsys)~"', ")
     SQL.ADD(" Estado          = 'PRO', ")
     SQL.ADD(" PorAmCapital    = "~FSTR(Val(k:2),1,9)~", ")
