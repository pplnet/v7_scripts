* SEEJEO: Ejercico de Opciones de Securities
CrearDialogo
  NrOperacion1 : "Operacion"                ;1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DSEO');'El TipoOp ingresado debe ser DSEO ';NO;;;;;;" TipoOp IN ('DSEO') and (CB8 is Null or CB8='0')  ";
  Fecha1       : "F Real Ej."               ;;;;NO;;;;;Fsys
  Precio2      : "Precio_Ref"               ;;;;;;[Dialogo.Radio2=0 y Dialogo.Precio2>Dialogo.Precio3] o [Dialogo.Radio2=1 y Dialogo.Precio2<Dialogo.Precio3];'Con este Precio de Referencia la Operacion no se va a Ejercer';;
  Fecha3       : "F Settlement"             ;;;;Dialogo.Radio1=1;;ESHABIL(Dialogo.Fecha3,'ARG') y Dialogo.Fecha3>=Fsys;'La Fecha de Settlement es Incorrecta';NO;;IIF(Dialogo.Radio1=0, BuscarCampo('Operaciones','FechaPago','NrOperacion',Dialogo.NrOperacion1), HABILES(Fsys,(BuscarCampo('Especies','PlazoLiq','Codigo',Dialogo.Especie1) DIV 24),'ARG',SI))
  Fecha4       : "Fecha Fin Opcion"         ;2;2;;NO;;;;;;BuscarCampo('Operaciones','FechaEj','NrOperacion',Dialogo.NrOperacion1)
  Precio3      : "Precio Ej"                ;;;;NO;;;;;;BuscarCampo('Operaciones','PrecioEj','NrOperacion',Dialogo.NrOperacion1)
  Radio1       : "Opcion|Europea|Americana" ;;;;NO;;;;;;BuscarCampo('Operaciones','TipoOpcion','NrOperacion',Dialogo.NrOperacion1)
  Radio2       : "Tipo|Call|Put"            ;;;;NO;;;;;;BuscarCampo('Operaciones','MB1','NrOperacion',Dialogo.NrOperacion1)
  Especie1     : "Especie"                  ;;;;NO;;;;;;BuscarCampo('Operaciones','Especie','NrOperacion',Dialogo.NrOperacion1)
FinDialogo

if Not Ok
  Cancelar
endif

*- Control de vehiculo habilitado para el usuario
*- vh1: vehiculo de la operacion o transaccion
*- Cancela si el vehiculo no esta habilitado para el usuario activo

ACT(vh1, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', Dialogo.NrOperacion1))

(.'CONTROLVH'.)

If Not Incluido(BuscarCampo('Operaciones','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DSEO|')
   Cancelar('La operacion '~Dialogo.NrOperacion1~' No es un Call o Put de Securities')
endif

* Verifico que se encuentre en Back Office o Terminal
ACN(X1,SQL("Select NrBit FROM "~DBO~".OPERACIONESBITS  Where NrOperacion='"~Dialogo.NrOperacion1~"' AND Valor='1'") )

If VAL(X1)<>20 y VAL(X1)<>50
   *-- Busco la instancia actual
   Cancelar('La Operacion Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(X1),0,0)~" AND Tabla='OPERACIONES'") )
EndIf

If Ok
   * X1: Recupero la Operacion
   acn(x1,0)

   SQL.ADD("Select * from "~DBO~".OPERACIONES ")
   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and (CB8 is Null or CB8='0') ")  
   SQL.ADD("and ((TipoOpcion='0' and FechaEj='"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" or (TipoOpcion='1' and FechaEj>='"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD(" and FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"')) ")

   Recorrer SQL
     *-- Verifico que la Fecha de Settlement 
     *-- sea habil en la tabla de feriados de la operacion
     IF [NOT ESHABIL(Dialogo.Fecha3,FBN['TablaFeriados1'])]          
        MESSAGEBOX('La Fecha de Settlement NO ES Dia Habil en la Tabla de Feriados '~FBN['TablaFeriados1'] )        
        Break
     ENDIF

     acn(x1,1)

     **-- Con esta condicion no se ejerce 
     IF [Dialogo.Radio2=0 y Dialogo.Precio2>Dialogo.Precio3] o [Dialogo.Radio2=1 y Dialogo.Precio2<Dialogo.Precio3]

        *** Determina los tipos de operacion a utilizar ***
        *-- Compra de Call y Venta de Put -> Compra
        If [EqStr(FBN['MB3'],'0') Y EqStr(FBN['MB1'],'0')] O [EqStr(FBN['MB3'],'1') Y EqStr(FBN['MB1'],'1')]
           ACT(z1,'SECS')        
        else
           ACT(z1,'SEVS')        
        endif

        * Si la condicion de settlement es Transf se genera la operacion asociada   
        Message('Calculando Resultados .... ')          


        *** Z7: Calculo el Valor Residual 
        ACN(Z7,IIF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE'),ValorTeorico(FBN['Especie']),1))

        *** Calculo el Resultado      
        IF FBN['MB1']=0 
           *---- Call: (Precio Referencia-PrecioEjercicio)*Cantidad
           ACN(Z2,(Dialogo.Precio2-FBN['PrecioEj'])*FBN['Cantidad']*VAL(Z7))
        ELSE 
           *---- Put: (Precio Referencia-PrecioEjercicio)*Cantidad
           ACN(Z2,(FBN['PrecioEj']-Dialogo.Precio2)*FBN['Cantidad']*VAL(Z7))
        ENDIF

        * Si es Ventas es NEGATIVO EL RESULTADO
        If EqStr(FBN['MB3'],'1')
           ACN(Z2,-VAL(Z2))
        ENDIF
 
       IF FBN['RB10']=1
          *** Z3 Nro. Operacion Contado
          ACT(z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',FBN['Vehiculo1'])))

          Message('Calculando los Plazos .... ')  
    
           *** Z4: Calcula el Plazo de la Especie
           *** Z5: Calcula el Plazo2 de la ContraEspecie     
           ACN(Z4,(Dialogo.Fecha3 - Fsys))
           ACN(Z5,(Dialogo.Fecha3 - Fsys))

           *** A1: RB5 => 0, 24, 48, 72 de la Especie
           *** A2: RB6 => 0, 24, 48, 72 de la ContraEspecie
           ACN(A1,VAL(Z4))
           ACN(A2,VAL(Z5))
   
           ACN(Z4,(Dialogo.Fecha3 - Fsys)*24)
           ACN(Z5,(Dialogo.Fecha3 - Fsys)*24)
 
           *** Z14: Calcula la Fecha de Vencimiento del Titulo
           *** Z15: Calcula la Fecha de Vencimiento de Moneda 
           ACD(Z14,Dialogo.Fecha3)
           ACD(Z15,Dialogo.Fecha3)
    
           ** Z9: Precio4 
  
           ACN(Z9,COTIZACIONC(FBN['Especie'],,,,Fsys,1,SI,'ARP')/COTIZACIONC(FBN['ContraEspecie'],,,,Fsys,1,SI,'ARP'))
   
           ACN(Z6,1)
           IF FBN['CB6']=0 
              ACN(Z9,COTIZACIONC(FBN['ContraEspecie'],,,,Fsys,1,SI,'ARP')/COTIZACIONC(FBN['Especie'],,,,Fsys,1,SI,'ARP'))   
           ENDIF
  
           ** Z8: Tasa 
           ACN(Z8,IIF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE'),(1-FBN['PrecioEj'])*36000/(FechaMaduracion(FBN['Especie'])-VAL(Z14)),0))
  
  
           ** Z10: Mercado de Liquidacion, Z11: Forma de Liquidacion (DVP), Z12: Cartera (TR)
           ACT(Z10,'OTC')
           ACN(Z11,1)
           ACN(Z12,3)
   
           ** Z13: Tabla de Feriados de la ContraEspecie
           ACT(Z13,BuscarCampo('Especies','PaisOrigen','Codigo',FBN['ContraEspecie']))
 
           ** Z16: Tasa Interes Cupon 
           ACN(Z16,IIF(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])>FBN['FechaUltCupon'] y BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])<=VAL(Z14),((BuscarCampo('ESPECIES','TasaIntVigente','Codigo',FBN['Especie'])*IIF(EspecieDiasAnio(FBN['Especie'])=0 y EspecieDiasMes(FBN['Especie'])=0,Dif360(FBN['FechaUltCupon'],BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])-1,4),DifDias(FBN['FechaUltCupon'],BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])-1,'USA',NO)))+(BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',FBN['Especie'])*(IIF(EspecieDiasAnio(FBN['Especie'])=0 y EspecieDiasMes(FBN['Especie'])=0,Dif360(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])-1,VAL(Z14),4),DifDias(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',FBN['Especie'])-1,VAL(Z14),'USA',NO)))))/(IIF(EspecieDiasAnio(FBN['Especie'])=0 y EspecieDiasMes(FBN['Especie'])=0,Dif360(FBN['FechaUltCupon'],VAL(Z14),4),DifDias(FBN['FechaUltCupon'],VAL(Z14),'USA',NO))),BuscarCampo('ESPECIES','TasaIntVigente','Codigo',FBN['Especie']))*100)


           ** Z18: Total Intereses
           ACN(Z18,IIF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE'),ValorTeorico(FBN['Especie'])*FBN['Cantidad']*VAL(Z16)/DIASA(EspecieDiasAnio(FBN['Especie']),FSYS)/100*IIF(EspecieDiasAnio(FBN['Especie'])=0 y EspecieDiasMes(FBN['Especie'])=0,Dif360(FBN['FechaUltCupon'],VAL(Z14),4),DifDias(FBN['FechaUltCupon'],VAL(Z14),'USA',NO)),0))
  
           ** Z19: Importe Neto
           ACN(Z19,FBN['TotalAux1']+VAL(Z18))

           * Calculo el Precio Dirty

           ACN(Z20,0)

           IF Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE')
              ACN(Z20,(FBN['TotalAux1']+VAL(Z18))/FBN['Cantidad'])
           ENDIF

           Message('Generando Operacion .... ')     
           SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
           SQL.ADD("(TipoOp, Book1,NrOperacion, ")
           SQL.ADD(" FechaOp2,FechaOp,Vehiculo1,")
           SQL.ADD(" Especie,Plazo,RB5,")
           SQL.ADD(" FechaVto,ContraEspecie,Plazo2,")
           SQL.ADD(" RB6,FechaPago,Cliente1,")
           SQL.ADD(" Cantidad,Precio1,TotalBrutoCli1,")
           SQL.ADD(" TotalIntereses,TotalNetoCli1,FormaLiquidacion1,Cartera,")
           SQL.ADD(" Operador,Observac2,TablaFeriados1,")
           SQL.ADD(" TablaFeriados2,Precio4,TipoCambio,")
           SQL.ADD(" Mercado,Cupon1,TasaInteresesCupon,FechaUltCupon, ")
           SQL.ADD(" UsrInput, FechaCarga,Spread,RB3,OperacionRef,FechaCargaSys,Cuenta1,Cuenta2) ")
           SQL.ADD(" Values ")
           SQL.ADD("('"~Val(z1)~"', '"~FBN['Book1']~"','"~Val(z3)~"', ")
           SQL.ADD(" '"~IdxDate(Fsys)~"', '"~IdxDate(Fsys)~"','"~FBN['Vehiculo1']~"', ")
           SQL.ADD(" '"~FBN['Especie']~"', "~Fstr(VAL(Z4),2,0)~", '"~Fstr(VAL(A1),2,0)~"', ")
           SQL.ADD(" '"~IdxDate(VAL(Z14))~"', '"~FBN['ContraEspecie']~"', "~Fstr(VAL(Z5),2,0)~",")
           SQL.ADD(" '"~Fstr(VAL(A2),2,0)~"', '"~IdxDate(VAL(Z15))~"','"~FBN['Cliente1']~"',")
           SQL.ADD(" "~Fstr(FBN['Cantidad'],0,4)~","~Fstr(FBN['PrecioEj'],0,7)~","~Fstr(FBN['TotalAux1'],0,2)~", ")
           SQL.ADD(" "~Fstr(VAL(Z18),0,2)~","~Fstr(VAL(Z19),0,2)~", '"~Fstr(VAL(Z11),1,0)~"', '"~Fstr(VAL(Z12),1,0)~"',")
           SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['Observac2']~"', '"~FBN['TablaFeriados1']~"', ")
           SQL.ADD(" '"~VAL(Z13)~"', "~Fstr(VAL(Z9),0,7)~", "~Fstr(VAL(Z8),0,7)~", ")
           SQL.ADD(" '"~VAL(Z10)~"','"~Fstr(FBN['Cupon1'],0,0)~"', "~Fstr(VAL(Z16),0,7)~", '"~IdxDate(FBN['FechaUltCupon'])~"', ")
           SQL.ADD(" '"~FBN['UsrInput']~"', '"~IdxDate(FSYS)~"', "~Fstr(VAL(Z20),0,7)~",'"~FBN['RB3']~"','"~Dialogo.NrOperacion1~"','"~IdxDate(FSYS)~"','"~FBN['Cuenta1']~"','"~FBN['Cuenta2']~"' )")
           SQL.NEW
           SQL.EXEC

           * Insert de Instancias: Recibe z3: Nro.Op.
           (.'ALTAINSTAN'.)

           *** Actualiza movimientos,Posiciones y limites ****
           SQL.ActualizarMovimientos2(Val(z3),SI,NO,NO,SI)
           SQL.EXEC
        ELSE 
           *-- Insert de Mov.Pendientes. El Resultado invierte el signo porque se ve desde el cliente
           EjecutarEvento('IMOVPE',NrOperacion1=Dialogo.NrOperacion1,Fecha1=Dialogo.Fecha3,Cliente1=FBN['Cliente1'],Especie1=FBN['ContraEspecie'],Vehiculo1=FBN['Vehiculo1'],Entero1=1,Precio1=-VAL(Z2),String='Resultado Ejercicio Net',Entero2=9,Entero3=0,String1='') 
        ENDIF


        Message('Actualizando la Opcion .... ')                  

        *** Marca la operacion como ejercida ***
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set CB8 = '1', OperacionRef = '"~Val(z3)~"', ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("FechaPago = '"~IdxDate(Dialogo.Fecha3)~"', ")
        SQL.ADD("Precio4   = "~Fstr(VAL(Z2),0,2)~", ")
        SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~"  ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        (.'MODIINSTAN'.)
     ELSE
        Message('Actualizando la Opcion .... ')                  

        *** Marca la operacion como ejercida ***
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set CB8 = '1',  ")
        SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"', ")
        SQL.ADD("Precio4   = "~Fstr(0,0,2)~", ")
        SQL.ADD("Precio2   = "~Fstr(Dialogo.Precio2,0,7)~"  ")
        SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
        SQL.NEW
        SQL.EXEC

        (.'MODIINSTAN'.)
     ENDIF 

   proximo

   If Val(x1)=0
      Cancelar('La operacion N# '~Dialogo.NrOperacion1~' No puede ser Ejercida')
   endif
endif