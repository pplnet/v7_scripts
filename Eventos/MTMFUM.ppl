MostrarCuadroDeMensajes

**trae todos los vehiculos
ACT(KK:1,SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "))
*** trae todos los Vehiculos para el usuario Activo
ACT(KK:2,SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))

CrearDialogo
  Fecha1     : 'Fecha Desde' ;1;1; ;  ;  ;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1<=FSys ;'Fecha Invalida';NO;Habiles(FSys,0,'ARG');Habiles(FSys,0,'ARG')
  Fecha2     : 'Fecha Hasta' ;2;1; ;  ;  ;EsHabil(Dialogo.Fecha2,'ARG') ;'Fecha Invalida';NO;Habiles(FSys,0,'ARG');Habiles(FSys,0,'ARG')
  Check4     : 'Futuro'      ;3;1; ;SI;SI;;;;0;
  Fecha3     : 'Fecha Futuro';3;2; ;SI;Dialogo.Check4=1;Dialogo.Check4=0 O Dialogo.Fecha3 > 0;'Fecha Futuro Invalida';NO;Habiles(FSys,1,'ARG');Habiles(FSys,1,'ARG');
  Lista1     : 'Vehiculo'    ;4;1; ;  ;  ;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(KK:1),Val(KK:2) );
  Radio1     : 'Futuro|Moneda|Tit|Ambos' ;;;;;NO;;;;0;;;;;;;;;;;;
FinDialogo

MostrarCuadroDeMensajes

if not ok
  Cancelar
endif

ACD(FE:1,Dialogo.Fecha1)
ACD(FE:2,Dialogo.Fecha2)

SQL.ADD("SELECT Distinct FechaVto FROM "~DBO~".OPERACIONES WHERE TipoOp IN ('FXCF','FXVF','SECF','SEVF') ")
SQL.ADD(" and FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")   
EndIf
IF Dialogo.Check4=1
   SQL.ADD(" and FechaVto = '"~IdxDate(Dialogo.Fecha3)~"' ")
ENDIF
IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 2
    SQL.ADD(" AND TipoOp IN ('FXCF','FXVF') ")
ENDIF
IF Dialogo.Radio1 = 1 O Dialogo.Radio1 = 2
    SQL.ADD(" AND TipoOp IN ('SECF','SEVF') ")
ENDIF
Recorrer Sql
   ACD(FJ:1, fbn('FechaVto'))
   Message('Fecha Futura: '~val(FJ:1))

   Recorrer&i val(FE:1),val(FE:2)
      If EsHabil(&i)
         Message('Fecha: '~Fecha(&i))
         If NoVacio(Dialogo.Lista1)
            Recorrer&j 1,elementos(Dialogo.Lista1)
                EjecutarEvento('MTMFUT',Fecha1=&i,Fecha2=val(FJ:1),Vehiculo1=ItemLista(Dialogo.Lista1,&j), Radio1 = Dialogo.Radio1)
            Proximo
         Else
            EjecutarEvento('MTMFUT',Fecha1=&i,Fecha2=val(FJ:1),Vehiculo1='', Radio1 = Dialogo.Radio1)
         Endif
      EndIf
   Proximo

Proximo
