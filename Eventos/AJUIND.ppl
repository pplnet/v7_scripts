*ModoReproceso(ConDialogo)
*--> AJUSTE POR INDICE EN OPERACIONES MM PASIVAS <--*

*--> LOS PRESTAMOS SINDICADOS Y FRN SERAN REESTRUCTURADOS
*--> QUEDARON: PRESTAMOS SINDICADOS = SOLO ITEMS
*-->           FRN = SOLO CABECERAS

CrearDialogo
   Fecha1 :'Fecha'   ;1;1; ;  ;  ;Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys;'Fecha incorrecta';NO;FSys;
   Check1 :'Procesa' ;1;2; ;SI;SI;;;;1;
FinDialogo
If Not Ok
   Cancelar
EndIf

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

If Dialogo.Check1=0
  HojaVisible(SI)
endif

** Ya no se usa mas esta variable. El evento es para todos los incides
*ACT(ic:1, Var('INDICEDEFA'))

*--> Ultimo dia habil del mes anterior al ingresado en el dialogo
ACD(fm:1, Habiles(PriDeMes(Dialogo.Fecha1, SI, 'ARG'), -1, 'ARG', SI))

ACT(vc:0, 'VC')
ACT(vm:0, 'VM')
ACT(vu:0, 'VU')
ACT(vv:0, 'VV')


SetFilaActual(1)
ACT(a:FAC, 'NrOp')
ACT(b:FAC, 'Tipo')
ACT(c:FAC, 'Esp')
ACT(d:FAC, 'Indice')
ACT(e:FAC, 'FOp')
ACT(f:FAC, 'FIni')
ACT(g:FAC, 'FFin')
ACT(h:FAC, 'Uni_Mul')
ACT(i:FAC, 'Cuota')

ACT(j:FAC, 'Caso 1')
ACT(k:FAC, 'Caso 2')

ACT(m:FAC, 'fc:1')
ACT(n:FAC, 'cp:1')
ACT(o:FAC, 'cp:10')
ACT(p:FAC, 'cp:3')

ACT(q:FAC, 'cx:1')
ACT(r:FAC, 'Cuota')

ACT(s:FAC, 'cp:1')
ACT(t:FAC, 'fc:1')
ACT(u:FAC, 'cp:1')
ACT(v:FAC, 'cp:10')
ACT(w:FAC, 'cp:2')
ACT(x:FAC, 'cp:3')
ACT(y:FAC, 'cp:4')
ACT(z:FAC, 'cp:5')
ACT(aa:FAC, 'cp:6')

ACT(aj:FAC, 'Caso 1')
ACT(ak:FAC, 'Caso 2')
ACT(al:FAC, 'Caso 3')

ACT(az:FAC, 'um:1')
SetFont(a:FAC..az:FAC,2)
*--> Si (FECHA1) NO es el primer dia habil del mes <--*

*--> Operaciones M. V. que la cuata venza en la (FECHA1) <--*
SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, C.Cantidad2 CapOr, ")
SQL.ADD(" CASE WHEN TipoOp = 'MMSIM' THEN C.Cantidad4 ELSE CASE WHEN O.TipoOp = 'SEPTMV' THEN  C.Cantidad4 ELSE C.Cantidad1 END END CAmort, ")
SQL.ADD(" C.Cantidad2Ori COri, C.Coeficiente Coef, O.Especie Esp, O.FechaOp FOp, C.Fecha1 FIni, C.Fecha2 FFin, O.ImpComCor1 ImpCC1, ")
SQL.ADD(" O.ImpComCor2 ImpCC2, O.ImpComCorEq2 ImpCCE2, O.ImpGastos1 ImpG1, O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, ")
SQL.ADD(" O.IntDevengados1 IntDev1, O.MB1 MB1, O.MB3 MB3, O.NrOperacion NrOp, C.Precio2 Pr2, C.Precio8 Pr8, '' OpRef, C.Plazo1 Pl, ")
SQL.ADD(" C.Plazo3 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, O.PrecioEj  PrEj, O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, O.RB9 RB9, ")
SQL.ADD(" O.ResultadoIndice RIndice, C.Precio4 Sp, O.TasaBase TBa, C.Tasa3 Ta3, O.TasaImp1 TImp1, O.TasaPrecan TPC, C.Tasa1 Ta1, ")
SQL.ADD(" O.TipoOp Tipo, O.TipoCambio2 TC2, C.Tasa2 Alias1, O.TotalComisiones TComi, C.Cantidad3 TInt, C.Total4 TIva, C.Total3 IntTot, ")
SQL.ADD(" O.TotalRetenciones TRet, O.TotalBrutoCli1 TBC1, O.TotalBrutoCli2 TBC2, O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, C.Cantidad4 C4, ")
SQL.ADD(" 2 Uni_Mul, C.Cantidad5 C5, C.Cantidad6 C6, C.Cantidad7 C7, C.NrCuota Cuota, C.Total5 To5, C.Total6 To6, C.Total8 To8, C.Total9 To9, ")
SQL.ADD(" O.DeltaTasa DT, O.PlazoGracia PG, O.PeriodoInts PerInt, O.TotalAux1 Alias2, O.TotalAux2 Alias3, O.TotalAux3 Alias4, O.TotalGastos TG, ")
SQL.ADD(" O.Cliente1 Cl1 ")
SQL.ADD("   From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".ESPECIES E, "~DBO~".INDICES I ")
SQL.ADD("  Where O.TipoOp      In ('MMPCLM','MMPIM','MMPEM','MMSIMV','MMFCMV','MMONM','MMPCCM','MMCPM') ")
*SQL.ADD("    and O.Indice      =  '"~Val(ic:1)~"' ")
SQL.ADD("    and IsNull(O.Indice,'') <> '' ")
SQL.ADD("    and O.NrOperacion =  C.NrOperacion ")
SQL.ADD("    and C.Fecha2      =  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND E.Codigo = O.Indice ")
SQL.ADD(" AND O.Indice = I.Codigo ")
SQL.ADD(" AND I.Tipo = 'CAP' ")
***---Indice por Coeficiente
SQL.ADD(" AND E.Valor5 < 1 ")

SQL.ADD(" Union All ")

   *--> Operaciones M.V. vigentes al último dia del mes anterior y que no venzan en la (FECHA1) <--*
SQL.ADD(" Select O.Vehiculo1 Vh1, O.Vehiculo2 Vh2, C.Cantidad2 CapOr, ")
SQL.ADD(" CASE WHEN TipoOp = 'MMSIM'   THEN C.Cantidad4 ELSE CASE WHEN  O.TipoOp = 'MMONM' THEN  C.Cantidad4 ELSE  C.Cantidad1 END END CAmort, ")
SQL.ADD(" C.Cantidad2Ori COri, C.Coeficiente Coef, O.Especie Esp, O.FechaOp FOp, C.Fecha1 FIni, C.Fecha2 FFin, O.ImpComCor1 ImpCC1, ")
SQL.ADD(" O.ImpComCor2 ImpCC2, O.ImpComCorEq2 ImpCCE2, O.ImpGastos1 ImpG1, O.ImpGastos2 ImpG2, O.ImporteImp ImpI, O.Indice Indice, ")
SQL.ADD(" O.IntDevengados1 IntDev1, O.MB1 MB1, O.MB3 MB3, O.NrOperacion NrOp, C.Precio2 Pr2, C.Precio8 Pr8, '' OpRef, C.Plazo1 Pl, ")
SQL.ADD(" C.Plazo3 Pl3, O.Precio1 Pr1, O.Precio3 Pr3, O.PrecioEj PrEj, O.PrecioMer PrMer, O.RB6 RB6, O.RB8 RB8, O.RB9 RB9, ")
SQL.ADD(" O.ResultadoIndice RIndice, C.Precio4 Sp, O.TasaBase TBa, C.Tasa3 Ta3, O.TasaImp1 TImp1, O.TasaPrecan TPC, C.Tasa1 Ta1, ")
SQL.ADD(" O.TipoOp Tipo, O.TipoCambio2 TC2, C.Tasa2 Alias1, O.TotalComisiones TComi, C.Cantidad3 TInt, C.Total4 TIva, C.Total3 IntTot, ")
SQL.ADD(" O.TotalRetenciones TRet,  O.TotalBrutoCli1 TBC1, O.TotalBrutoCli2 TBC2, O.TotalBrutoCli3 TBC3, O.TotalNetoCli1 TNC1, ")
SQL.ADD(" C.Cantidad4 C4, 2 Uni_Mul, C.Cantidad5 C5, C.Cantidad6 C6, C.Cantidad7 C7, C.NrCuota Cuota, C.Total5 To5, C.Total6 To6,") 
SQL.ADD(" C.Total8 To8, C.Total9 To9, O.DeltaTasa DT, O.PlazoGracia PG, O.PeriodoInts PerInt, O.TotalAux1 Alias2, O.TotalAux2 Alias3, ")
SQL.ADD(" O.TotalAux3 Alias4 , O.TotalGastos TG, O.Cliente1 Cl1 ")
SQL.ADD("   From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".ESPECIES E, "~DBO~".INDICES I ")
SQL.ADD("  Where O.TipoOp In ('MMPCLM','MMPIM','MMPEM','MMSIMV','MMFCMV','MMONM','MMPCCM','MMCPM') ") 
*   SQL.ADD("    and O.Indice = '"~Val(ic:1)~"' ")
SQL.ADD("    and IsNull(O.Indice,'') <> '' ")
SQL.ADD("    and O.NrOperacion = C.NrOperacion ")
*   SQL.ADD("    and C.Fecha2 > '"~IdxDate(Val(fm:1))~"' ")
*   SQL.ADD("    and C.Fecha2 <> '"~IdxDate(Dialogo.Fecha1)~"' ")
*   SQL.ADD("    and C.Fecha1 <= '"~IdxDate(Val(fm:1))~"' ")
SQL.ADD("    and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("    and C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND E.Codigo = O.Indice ")
SQL.ADD(" AND O.Indice = I.Codigo ")
***---Indice por Coeficiente
SQL.ADD(" AND E.Valor5 < 1 ")
SQL.ADD(" AND I.Tipo = 'CAP' ")
SQL.ADD(" Order by FFin, Tipo, NrOp ")

*--> (ic:1) = Variable INDICEDEFA
*--> (fm:1) = Primer día Hábil del mes
*--> (fc:1) = Fecha Vto de la cuota anterior
*--> (fa:1) = Dia habil anterior a la fecha vto. de la cuota
*--> (cx:1) = CER (anterior a la fecha vto. de la primera cuota)
*--> (cp:1) = CER (actual)
*--> (cp:2) = COEF
*--> (cp:3) = Cap. Ajust.
*--> (cp:4) = Ajust. Amort.
*--> (cp:5) = Amort. Ajust.
*--> (cp:6) = Cap. Luego Amort. (Proxima cuota)
*--> (pc:1) = Cuota anterior
watch(sql.batch)
Recorrer SQL
  ACT(a:FAC, fbn('NrOp'))
  ACT(b:FAC, fbn('Tipo'))
  ACT(c:FAC, fbn('Esp'))
  ACT(d:FAC, fbn('Indice'))
  ACD(e:FAC, fbn('FOp'))
  ACD(f:FAC, fbn('FIni'))
  ACD(g:FAC, fbn('FFin'))
  ACN(h:FAC, fbn('Uni_Mul'))
  ACN(i:FAC, fbn('Cuota'))
  ** Para que las formulas sigan usando la misma celda
  ACT(ic:1, fbn('Indice'))
  ACN(cx:1, COTIZACION(Val(ic:1),,,,FBN['FOp']-1,1) )
  ACN(q:FAC, Val(cx:1))
  IF FBN['Cuota'] > 1
     ACT(r:FAC, 'Otra')
     *--> Si la Cuota no es la primera <--*      
     ACN(ct:1, FBN['Cuota'] - 1 ) 
     ACN(pc:1, FBN['Cuota'] - 1 )
     *--> Busca la FechaVto de la Cuota anterior <--* CALCULO COEFICIENTES PARA SER UTILIZADOS EN EL PROCESO
     ACD(FC:1, SQL(" Select Fecha2 From "~DBO~".CUOTAS where NrOperacion = '"~FBN['NrOp']~"' and NrCuota = "~Val(ct:1)~" ") )
     ACD(zz:1, Habiles(Dialogo.Fecha1, -1 , 'ARG', SI) )
     ACN(XX:1, COTIZACION(Val(ic:1),,,,Val(zz:1),1) )
     ACN(cp:1, Val(XX:1) )  
     ACN(yy:1, COTIZACION(Val(ic:1),,,,Val(fc:1)-1,1) )
     ACN(FO:1, COTIZACION(Val(ic:1),,,,FBN['FOp']-1,1))   
     * WW:1 = Fecha Devengado anterior
     ACD(WW:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))
     ACN(yy:2, COTIZACION(Val(ic:1),,,,Val(WW:1),1) ) 
     *-->  Calculo de Indices segun posicion de la ultima cuota.
     *     Si el mes del la ultima cuota es igual al mes de devengamiento ==> Denominador = Indice Ult Cta (YY1)  
     *     Si son distintos ==> el denominador el indice del devengamiento anterior (YY2)            
     IF Mes(Val(fc:1)) = Mes(Val(zz:1))
       ACN(cp:2,  Val(xx:1) / Val(yy:1)  )            
     Else
       ACN(cp:2,  Val(xx:1) / Val(yy:2)  )          
     EndIf    
     ACN(cp:3, FBN['CapOr'] *  Val(cp:2)   )
     ACN(cp:4, FBN['CAmort'] * ((Val(cp:1) / Val(cx:1)) -1) )    
     ACN(cp:5, FBN['CAmort'] + Val(cp:4) )       
     ACN(cp:6, Val(cp:3) - Val(cp:5) ) 
     *--> Indice CER para grabar en la operacion
     ACN(cp:10, Val(xx:1) / Val(FO:1) )         
     ACD(t:FAC, Val(fc:1))
     ACN(u:FAC, Val(cp:1))
     ACN(w:FAC, Val(cp:2))
     ACN(x:FAC, Val(cp:3))
     ACN(y:FAC, Val(cp:4))
     ACN(z:FAC, Val(cp:5))
     ACN(aa:FAC, Val(cp:6))
     ACN(v:FAC, Val(cp:10))
     *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig, Cap.Amort y prox. cuota <--*
     (.'AJUINDMV'.)
  ELSE
     ACT(r:FAC, 'Primera')
     *--> Si es la primera cuota <--*
     ACN(cp:1, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / Val(cx:1) )
     ACN(s:FAC, Val(cp:1))
     *--> Calculo de Coeficiente para el proceso de Ajuste Devengado (fin de mes)
     IF Dialogo.Fecha1 <> FBN['FFin']
       * La cuota no vence hoy
         ACD(FC:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))   
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,Val(FC:1),1)     / Val(cx:1) ) 
         *--> Indice CER para grabar en la operacion   
         ACN(cp:10, COTIZACION(Val(ic:1),,,,Val(FC:1),1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))             
     EndIf
     *--> Calculo de Coeficiente para el proceso Diario
     IF Dialogo.Fecha1 = FBN['FFin']
         * La cuota vence hoy
         ACD(FC:1, Habiles(Dialogo.Fecha1,-1  , 'ARG', SI))        
         ACN(cp:1,  COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,Val(FC:1),1))
         *--> Indice CER para grabar en la operacion  
         ACN(cp:10, COTIZACION(Val(ic:1),,,,FBN['FFin']-1,1) / COTIZACION(Val(ic:1),,,,FBN['FIni']-1,1))   
     EndIF 
     ACN(cp:2, Val(cp:1) - 1 )
     ACN(cp:3, FBN['CapOr'] * (Val(cp:2) + 1) )
     ACN(cp:4, FBN['CAmort'] * Val(cp:2) )
     ACN(cp:5, FBN['CAmort'] + Val(cp:4) )
     ACN(cp:6, Val(cp:3) - Val(cp:5) )
     ACD(t:FAC, Val(fc:1))
     ACN(u:FAC, Val(cp:1))
     ACN(v:FAC, Val(cp:10))
     ACN(w:FAC, Val(cp:2))
     ACN(x:FAC, Val(cp:3))
     ACN(y:FAC, Val(cp:4))
     ACN(z:FAC, Val(cp:5))
     ACN(aa:FAC, Val(cp:6))
     *--> Calcula: Campos (y a los q influyen estos) q sean alterados x el Cap.Orig, Cap.Amort y prox. cuota <--*
     (.'AJUINDMV'.)
  ENDIF
  ACN(um:1, FBN['Uni_Mul'] -1)
  ACN(az:FAC, Val(um:1))
  
  *--> Busca las comisiones vigentes para la cuota que esta siendo ajustada
  (.'COMIIND'.)

  if Dialogo.Check1=1
     *--> Actualizo la operacion con los Campos (y a los q influyen estos) q sean alterados x el Cap.Orig y Cap.Amort  
     (.'AJUINDUPD'.)
     EjecutarEvento('TTNOP', NrOperacion1 = FBN['NrOp'], Entero1 = Val(um:1), NrOperacion2 = '', Lista1 = '')
     SQL.ActualizarMovimientos3(FBN['NrOp'], SI, NO, NO, NO, SI, 0)
     Sql.Exec
  endif
Proximo

if FAC>1
  SetFont(a:2..az:FAC,1)
  FormatoCeldas(n:2..o:FAC, Exe('F8'))
  FormatoCeldas(p:2..p:FAC, Exe('F2'))
  FormatoCeldas(q:2..q:FAC, Exe('F8'))
  FormatoCeldas(u:2..w:FAC, Exe('F8'))
  FormatoCeldas(x:2..aa:FAC, Exe('F2'))
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del recorrer')
SetFont(a:FAC,2)
