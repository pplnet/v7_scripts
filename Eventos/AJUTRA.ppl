CrearDialogo
  NrTrans1: 'Nro.Voucher';;;;;;Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'DEP|RET|COMP');'Tipo de Comprobante incorrecto';NO;
  Cliente1: 'ClienteVou' ;;;;NO;;;;;;BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans',Dialogo.NrTrans1)
  Especie1: 'EspecieVou' ;;;;NO;;;;;;BuscarCampo('TRANSACCIONES2','Especie','NrTrans',Dialogo.NrTrans1)
FinDialogo
if Not OK
  Cancelar
endif

SQL.ADD("update "~DBO~".OPERACIONESBITS ")
SQL.ADD("   set Valor       = 0 ")
SQL.ADD(" where nrbit       = 12 ")
SQL.ADD("   and NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.NEW

SQL.ADD("update "~DBO~".OPERACIONESBITS ")
SQL.ADD("   set Valor       = 1 ")
SQL.ADD(" where nrbit       = 11 ")
SQL.ADD("   and NrOperacion = '"~Dialogo.NrTrans1~"' ")
SQL.NEW

SQL.ADD("update "~DBO~".TRANSACCIONES2 ")
SQL.ADD("   set Observaciones = null ")
SQL.ADD(" where NrTrans       = '"~Dialogo.NrTrans1~"' ")
SQL.NEW

SQL.EXEC
