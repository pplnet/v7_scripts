***********************************************************************
*HojaVisible(SI)
CrearDialogo
  Fecha1    : 'Fecha'       ;;;;;;;;;Fsys
  Entero1   : 'Copias'      ;;;;;;;;;1
  Lista1    : 'Vehiculos'   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Directorio1: 'Path cartas'   ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
FinDialogo

if not Ok
   Cancelar
endif

if not ExisteDirectorio(Dialogo.Directorio1)
    Cancelar('Directorio no encontrado:'~Dialogo.Directorio1)
endif

CrearFont(1,"Arial,8,B")

*SQL.ADD("Select T.* from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O ")
*SQL.ADD("where  T.NrTrans = O.NrOperacion ")
*SQL.ADD(" and   O.NrBit = 2 and O.Valor ='1' ")
*SQL.ADD(" and   T.TipoTr2 In ('RET','DEP') ")
*SQL.ADD(" and  not (T.NrOperacionRef2 = '' or NrOperacionRef2 is Null ) ")
*recorrer SQL
*  SQL.ADD("Update "~DBO~".OPERACIONESBITS")
*  SQL.ADD("set Valor='0' where NrOperacion='"~fbn('NrTrans')~"' and NrBit=2")
*  SQL.NEW
*  SQL.ADD("Update "~DBO~".OPERACIONESBITS")
*  SQL.ADD("set Valor='1' where NrOperacion='"~fbn('NrTrans')~"' and NrBit=3")
*  SQL.NEW
*  SQL.EXEC
*proximo

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

SetFilaActual(0)
ACN(z1,0)
************ No hay registros con NrBit = 2, si hay = 1.
SQL.ADD("Select T.* from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O ")
SQL.ADD("where  T.NrTrans = O.NrOperacion ")
*SQL.ADD(" and   O.NrBit = 2 and O.Valor ='1' ")
SQL.ADD(" and O.Valor ='1' ")
SQL.ADD(" and   T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   T.TipoTr2 In ('RET','DEP') ")
*SQL.ADD(" and  (T.NrOperacionRef2 = '' or NrOperacionRef2 is Null ) ")
SQL.ADD(" and  T.Cuenta2 Is Not Null ")
If NoVacio(Val(zz6))
   SQL.ADD("   and Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
EndIf
SQL.ADD(" order by T.NrOperacionRef1, T.NrTrans ")

Recorrer SQL
  ACT(aa:FAC, fbn['NrTrans'])
  ACD(ab:FAC, fbn['Fecha2'])
  ACT(ac:FAC, fbn['Cliente1'])
  ACT(ad:FAC, fbn['TipoTr2'])
  ACT(ae:FAC, fbn['Especie'])

  if EqStr(fbn['TipoTr2'],'RET')
     ACN(af:FAC, -fbn['Cantidad1'])
  else
     ACN(af:FAC, fbn['Cantidad1'])
  endif

  ACT(ag:FAC, fbn['NrOperacionRef1'])

  If Not EqStr(Val(ag:FAC),Val(v1))
     SCN(z1,1)
     ACT(a:Val(z1), Val(ag:FAC))
     ACD(b:Val(z1), Val(ab:FAC))
     ACT(c:Val(z1), Val(ac:FAC))
     ACT(d:Val(z1), BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn['NrOperacionRef1']))
     ACT(e:Val(z1), BuscarCampo('OPERACIONES','Especie','NrOperacion',fbn['NrOperacionRef1']))
     ACN(f:Val(z1), BuscarCampo('OPERACIONES','Cantidad','NrOperacion',fbn['NrOperacionRef1']))
     ACT(g:Val(z1), BuscarCampo('OPERACIONES','ContraEspecie','NrOperacion',fbn['NrOperacionRef1']))
     ACT(h:Val(z1), fbn('NrOperacionRef2'))

     *- Modelo de Carta => 0=Comun 1=Intermediario
     ACN(l:Val(z1), 0)
     ACT(v1, Val(ag:FAC))
  Endif
Proximo

If Val(z1)=0
   Cancelar('No existen Cartas para imprimir')
Else
   CrearListBox;'Arial,8,B'
      'Imprime'                  ; k1..k:val(z1); SI; SI;;60; COMBO; 'Si|No|'
      'Modelo'                   ; l1..l:val(z1); SI; SI;;80; COMBO; 'Clasico|Intermed|'
      'Operacion'                ; a1..a:val(z1); NO; SI;;80; STRING
      'FechaLiq'                 ; b1..b:val(z1); NO; SI;;70; FECHA
      'Cliente'                  ; c1..c:val(z1); NO; SI;;70; STRING
      'Tipo'                     ; d1..d:val(z1); NO; SI;;70; STRING
      'Especie'                  ; e1..e:val(z1); NO; SI;;70; STRING
      'Cantidad'                 ; f1..f:val(z1); NO; SI;;100; NUMERO;'###,###,###.##p'
      'Moneda'                   ; g1..g:val(z1); NO; SI;;70; STRING
   FinListBox

   If Ok 

      Recorrer&j 1,val(z1)
  
         If val(k:&j)=0
            *- Imprime 
            If Incluido(val(d:&j),Exe('CARTA1C')) o Incluido(val(d:&j),Exe('CARTA1V'))
               If Vacio(Val(h:FilaCiclo))
                  ACT(i:&j, GetNumerador(20))
 
                  Recorrer&i 1,FAC
                    If EqStr(Val(ag:&i),Val(a:&j))
                       SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
                       SQL.ADD("Set    NrOperacionRef2 = '"~Val(i:&j)~"' ")
                       SQL.ADD("where  NrTrans = '"~Val(aa:&i)~"' ")
                       SQL.NEW
                    Endif
                  Proximo
                  SQL.EXEC

                  Recorrer&i 1, Dialogo.Entero1
                        EjecutarEvento('CARTA1',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(i:&j),Fecha1=Dialogo.Fecha1,Check1=1,Radio1=val(l:&j), Directorio1=Dialogo.Directorio1, String1 = var('FILECARTA1'))
                  Proximo
               Else
                  Recorrer&i 1, Dialogo.Entero1
                        EjecutarEvento('CARTA1',1,NrOperacion1=Val(a:&j),NrOperacion2=val(h:&j),Fecha1=Dialogo.Fecha1,Check1=0,Radio1=val(l:&j), Directorio1=Dialogo.Directorio1, String1 = var('FILECARTA1'))
                  Proximo
               Endif
            Else
               If Incluido(val(d:&j),Exe('CARTA2')) o EqStr(val(d:&j),'MMP')
                  ACT(i:&j, GetNumerador(20))         
                   
                  Recorrer&i 1,FAC
                     *** Claudia 26.02.99
                     *   If EqStr(Val(ag:&i),Val(a:&j)) y Vacio(val(h:&j))
                     ***---------------------------------- 
                     If EqStr(Val(ag:&i),Val(a:&j)) 
                        SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
                        SQL.ADD("Set    NrOperacionRef2 = '"~Val(i:&j)~"' ")
                        SQL.ADD("where  NrTrans = '"~Val(aa:&i)~"' ")
                        SQL.NEW
                     Endif
                  Proximo
                  SQL.EXEC
                  Recorrer&i 1, Dialogo.Entero1
                        EjecutarEvento('CARTA2',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(i:&j),Fecha1=Dialogo.Fecha1,Check1=1,Radio1=val(l:&j), Directorio1=Dialogo.Directorio1, String1 = var('FILECARTA2'))
                  Proximo
               Else
                  MessageBox('Carta no definida para Operacion '~val(d:&j))
               Endif
            Endif
 
            If Vacio(Val(j:&j))
               Recorrer&i 1,FAC
                  If EqStr(Val(ag:&i),Val(a:&j))
                     SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
                     SQL.ADD("( NrOperacion, NrInstancia, Usuario, Fecha ) ")
                     SQL.ADD(" Values ")
                     SQL.ADD("( '"~Val(aa:&i)~"', 2, '"~UsuarioActivo~"', ")
                     SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
                     SQL.NEW
 
                     SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
                     SQL.ADD("SET Valor = '0' ")
                     SQL.ADD("where NrOperacion = '"~Val(aa:&i)~"' ")
                     SQL.ADD("and NrBit = 2 ")
                     SQL.NEW
   
                     SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
                     SQL.ADD("SET Valor = '1' ")
                     SQL.ADD("where NrOperacion = '"~Val(aa:&i)~"' ")
                     SQL.ADD("and NrBit = 3 ")
                     SQL.NEW
                  EndIf
               Proximo
               SQL.EXEC
            EndIf
            *- Si imprime
        EndIf
      Proximo
   Endif
Endif
FormatoCeldas(af:1..af:Val(z1),Exe('F2'))
SetFont(a:1..az:FAC,1)
