CrearDialogo
  Fecha1   : 'Fecha'    ;;;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;FSys
  Vehiculo1: 'Vehiculo' ;;;;NO;  ;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Entero1  : 'Pag.Desde';;;;  ;  ;Dialogo.Entero1>0;'Pagina Desde invalida';NO;
  Entero2  : 'Pag.Hasta';;;;  ;  ;Dialogo.Entero2>=Dialogo.Entero1;'Pagina Hasta invalida';NO;
  String1  : 'Numerador';;;;  ;  ;NoVacio(Dialogo.String1);'Codigo Numerador Requerido';NO;
FinDialogo
if Not OK
  Cancelar
endif

ACN(b:1, SQL("Select Count(*) From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = '"~Dialogo.String1~"' "))
if Val(b:1)>1
  Cancelar('Existe mas de un registro de Numero de Copiativo '~Dialogo.String1~' para el '~Dialogo.Fecha1)
endif

ACT(c:1, Fecha(Hoy))
ACT(c:2, Copy(Val(c:1),9,2)~Copy(Val(c:1),4,2)~Copy(Val(c:1),1,2))
ACT(d:1, Hora(Ahora))
ACT(d:2, Copy(Val(d:1),1,2)~Copy(Val(d:1),4,2)~Copy(Val(d:1),7,2))

***---Marca de concilacion
if Val(b:1)=0
  ACT(e:1, 'Insert')
  Message('Insert Flag Copiativo')
  SQL.ADD("Insert Into "~DBO~".FLAGSMERCADO ( ")
  SQL.ADD(" Fecha,    Registro, Paso,  Cantidad, ")
  SQL.ADD(" FechaMercado, HoraMercado,  Estado ")
  SQL.ADD(" ) Values ( ")
  SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD(" '"~Dialogo.String1~"', ")
  SQL.ADD(" "~FStr(Dialogo.Entero1,1,0)~", ")
  SQL.ADD(" "~FStr(Dialogo.Entero2,1,0)~", ")
  SQL.ADD(" '"~Val(c:2)~"', ")
  SQL.ADD(" '"~Val(d:2)~"', ")
  SQL.ADD(" 'IMP' ")
  SQL.ADD(" ) ")
  SQL.NEW
else
  ACT(e:1, 'Update')
  Message('Update Flag Copiativo')
  SQL.ADD("Update "~DBO~".FLAGSMERCADO ")
  SQL.ADD("   Set Estado     = 'REI' ")
  SQL.ADD(" where Fecha      = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and Registro   = '"~Dialogo.String1~"' ")
  SQL.NEW
endif
SQL.EXEC
