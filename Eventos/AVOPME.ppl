SQL.ADD(" Select O.NrOrden, O.TipoOrden, O.FechaOrden, O.Especie, O.Cliente, O.Mercado3, O.CantidadTotalOrden, O.Cantidad1, ")
SQL.ADD(" O.PrecioLimite, O.NroAltaMAE,O.Cantidad3 ")
SQL.ADD("   From "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("  Where O.TipoOrden in ('OEQC','OEQV','CSEC','VSEC','OCSEC','OVSEC','OTIC','OTIV') And IsNull(O.Cantidad1, 0) < O.CantidadTotalOrden ")
SQL.ADD("    And O.NrOrden=OB.NrOperacion ")
SQL.ADD("    And O.Leyenda1='Sucursales' ")
SQL.ADD("    And OB.NrBit in (62,9) And OB.Valor=1 ")
SQL.ADD(" Order by O.FechaOrden ")

Recorrer SQL
  ACT(B:FAC,FBN['NrOrden'])
  ACT(C:FAC,FBN['TipoOrden'])
  ACD(D:FAC,FBN['FechaOrden'])
  ACT(E:FAC,FBN['Especie'])
  ACT(F:FAC,FBN['Cliente'])
  ACN(G:FAC,FBN['CantidadTotalOrden'])
  ACN(H:FAC,FBN['PrecioLimite'])
  ACN(I:FAC,FBN['Cantidad1'])
  ACN(J:FAC,FBN['CantidadTotalOrden']-FBN['Cantidad1'])
  ACT(M:FAC,FBN['NroAltaMAE'])
  ACT(N:FAC,FBN['Mercado3'])
  ACN(O:FAC,FBN['Cantidad3'])
  ACT(P:FAC,FBN['Mercado3'])
  ACN(Z:1,1)
Proximo

If Val(Z:1)=0
   Cancelar('No hay Ordenes para avanzar')
EndIf

CrearListBox;'Arial,10,B';'Seleccione las Ordenes a avanzar'
  'OK'             ;A:1..A:FAC;SI;;;40;CHECK;Exe('COLOR12');
  'NrOrden'        ;B:1..B:FAC;NO;;;100;STRING;
  'TipoOrden'      ;C:1..C:FAC;NO;;;100;STRING;
  'FechaOrden'     ;D:1..D:FAC;NO;;;100;FECHA;
  'Especie'        ;E:1..E:FAC;NO;;;100;STRING;
  'Cliente'        ;F:1..F:FAC;NO;;;100;STRING;  
  'TotalOrden'     ;G:1..G:FAC;NO;;;100;NUMERO;'###,###,###.##'
  'PrecioLimite'   ;H:1..H:FAC;NO;;;100;NUMERO;'###,###.########'
  'TotalEjecutado' ;I:1..I:FAC;NO;;;100;NUMERO;'###,###,###.##'
  'Pendiente'      ;J:1..J:FAC;NO;;;100;NUMERO;'###,###,###.##'
  'Cantidad'       ;K:1..K:FAC;SI;[Val(A:FLB)=1 Y Val(K:FLB)<=Val(J:FLB)] O Val(A:FLB)=0;'La Cantidad no debe exceder lo pendiente';100;NUMERO;'###,###,###.##';Exe('COLOR12');
  'Precio'         ;L:1..L:FAC;SI;[Val(A:FLB)=1 Y Val(L:FLB)>0 Y [IIF(Incluido(Val(C:FLB),'OEQC|CSEC|OTIC'),Val(L:FLB)<=Val(H:FLB),Val(L:FLB)>=Val(H:FLB))]] O Val(A:FLB)=0;'El precio debe ser positivo y '~IIF(Incluido(Val(C:FLB),'OEQC|CSEC'),'menor o igual a: '~Val(H:FLB),'mayor o igual a: '~Val(H:FLB));100;NUMERO;'###,###.########';Exe('COLOR12');
  'Nro. Secuencia' ;M:1..M:FAC;SI;;;100;NUMERO;'##,###,###,###,###,###,###,###,###';Exe('COLOR12');
  'Merc. Neg.'     ;N:1..N:FAC;[Vacio(Val(N:FLB)) Y Vacio(Val(P:FLB))] O [NoVacio(Val(N:FLB)) Y Not EqStr(Val(N:FLB),Val(P:FLB))];[Val(A:FLB)=1 Y NoVacio(Val(N:FLB))] O Val(A:FLB)=0;'Debe ingresar Merc. Negociacion';100;TABLA;'MERCADOS';'Codigo';'Codigo;Descripcion';;IIF(Vacio(Val(N:FLB)) O [NoVacio(Val(N:FLB)) Y Not EqStr(Val(N:FLB),Val(P:FLB))],Exe('COLOR12'));
FinListBox

If Not OK
   Cancelar
EndIf

Recorrer&I 1,FAC
  If Val(A:&I)=1
    IF Incluido(Val(C:&I),'OCSEC|OEQC|CSEC|OTIC')
        ACT(TO:1,'TIC')
    ELSE
        ACT(TO:1,'TIV')
    ENDIF
*    If Incluido(Val(C:&I),'OCSEC|OVSEC')
*        If EqStr(Val(C:&I),'OCSEC')
*           If DesciendeDeEspecie(Val(E:&I),'ACCION')
*              ACT(TO:1,'EQC')
*           Else
*              ACT(TO:1,'TIC')
*           EndIf
*        Else
*           If DesciendeDeEspecie(Val(E:&I),'ACCION')
*              ACT(TO:1,'EQV')
*           Else
*              ACT(TO:1,'TIV')
*           EndIf
*        EndIf
*     Else
*        If EqStr(Val(C:&I),'OEQC') O [EqStr(Val(C:&I),'CSEC') Y EqStr(Val(N:&I),'BYMA')]
*           ACT(TO:1,'EQC')
*        Else
*           If EqStr(Val(C:&I),'OEQV') O [EqStr(Val(C:&I),'VSEC') Y EqStr(Val(N:&I),'BYMA')]
*              ACT(TO:1,'EQV')
*           Else
*              If EqStr(Val(C:&I),'CSEC') Y EqStr(Val(N:&I),'MAE')
*                 ACT(TO:1,'TIV')
*              Else
*                 If EqStr(Val(C:&I),'VSEC') Y EqStr(Val(N:&I),'MAE')
*                    ACT(TO:1,'TIC')
*                 EndIf
*              EndIf
*           EndIf
*        EndIf
*     EndIf
     
     ** Genera bits de la orden y se avanza a instancia 9
     EjecutarEvento('INBIT2', String1='ORDENES', Entero1=9, NrOperacion1=Val(B:&I))
     
     ACN(CA:1,SQL(" Select Sum(Cantidad) From "~DBO~".EJECUCIONES Where NrOrden='"~Val(B:&I)~"' "))
     If Val(CA:1)=0
        ACN(CA:2,Val(K:&I))
        ACN(PR:3,Val(L:&I))
     Else
        ACN(CA:2,Val(CA:1)+Val(K:&I))
        ACN(PR:1,SQL(" Select Sum(Cantidad*Precio) From "~DBO~".EJECUCIONES Where NrOrden='"~Val(B:&I)~"' "))
        ACN(PR:2,Val(PR:1)+(Val(K:&I)*Val(L:&I)))
        ACN(PR:3,Val(PR:2)/Val(CA:2))
     EndIf
     
     SQL.ADD(" Update "~DBO~".ORDENES Set ")
     SQL.ADD("  Cantidad1   = "~FStr(Val(CA:2),0,2)~", ")
     SQL.ADD("  Cantidad4   = "~FStr(Val(PR:3),0,8)~",  ")
     SQL.ADD("  Mercado3    = '"~Val(N:&I)~"'  ")
     SQL.ADD(" Where NrOrden = '"~Val(B:&I)~"' ")
     SQL.NEW
     SQL.EXEC
     
     **** Genero la Operacion
     SQL.ADD(" Select ContraEspecie, Mercado, Mercado2, Mercado4, Vehiculo, Operador, RB10, Book1, Plazo1, RB5, Cantidad3, TotalAux1, CB10 ")
     SQL.ADD("   From "~DBO~".ORDENES Where NrOrden='"~Val(B:&I)~"' ")
     
     Recorrer SQL
*       If Incluido(Val(C:&I),'OCSEC|OVSEC')
*          If Vacio(BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(E:&I))) O EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(E:&I)),'0')
*             ACN(PL:1,0)
*          Else
*             IF EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(E:&I)),'24')
*                ACN(PL:1,1)
*             Else
*                IF EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(E:&I)),'48')
*                   ACN(PL:1,2)
*                EndIf
*             EndIf
*          EndIf
*       Else
          If Vacio(BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(E:&I)))
             ACN(PL:1,0)
          Else
             ACN(PL:1,FBN['RB5'])
          EndIf
*       EndIf
       
       ACD(FV:1,HABILES(Val(D:&I),Val(PL:1),'ARG',SI))
       
       ACN(Z:4,CotizacionC(FBN['ContraEspecie'],,,,Val(D:&I),1,SI,VAR('MONEEXTR')) )
       If EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'INV')
          ACN(Z:6,1/Val(Z:4))
       Else
          ACN(Z:6,Val(Z:4))
       EndIf
       
       If EqStr(Modo(FBN['ContraEspecie'],VAR('MONELOCA')),'INV')
          ACN(Z:7,1/Val(Z:5))
       Else
          ACN(Z:7,Val(Z:5))
       EndIf
       
       If EqStr(Modo(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',Val(E:&I))),'INV')
          ACN(Z:8,1/CotizacionC(FBN['ContraEspecie'],,,,Val(D:&I),1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Val(E:&I))))
       Else
          ACN(Z:8,CotizacionC(FBN['ContraEspecie'],,,,Val(D:&I),1,SI, BuscarCampo('ESPECIES','MonedaEmision','Codigo',Val(E:&I))))
       EndIf
       
       ACN(Z:9,CotizacionC(VAR('MONEEXTR'),,,,Val(D:&I),1,SI,VAR('MONELOCA')))
       
       If Vacio(FBN['Mercado2'])
          ACT(Z:26,MercadoDef(FBN['ContraEspecie']))
       Else
          ACT(Z:26,FBN['Mercado2'])
       EndIf
       
       If Vacio(FBN['Mercado'])
          If Incluido(Val(TO:1),'EQC|EQV')
             ACT(Z:27,'')
          Else
             If EqStr(Val(N:&I),VAR('AMBBYMA'))
                ACT(Z:27,COPY(VAR('MERCADOCV'),1,2))             
             Else
                ACT(Z:27,MercadoDef(Val(E:&I)))
             EndIf
          EndIf
       Else
          ACT(Z:27,FBN['Mercado'])
       EndIf
       
       ACT(Z:28,BookDefault2(FBN['Vehiculo'],Val(TO:1),'',Val(E:&I),'','','','','HAB'))
       
       If Incluido(Val(TO:1),'EQC|EQV')
          ACN(Z:3,Val(Z:18) * CotizacionC(FBN['ContraEspecie'],,,,FSYS,1,SI,VAR('MONEEXTR')) )
          ACN(Z:5,FBN['TotalAux1'])
          ACN(Z:24,Val(K:&I)*Val(L:&I))
          If EqStr(Val(N:&I),'BYMA')
             ACN(Z:16,MontoGastos(Val(TO:1),Val(E:&I),FBN['Vehiculo'],'DMERC',0,4))
          Else
             ACN(Z:16,MontoGastos(Val(TO:1),Val(E:&I),FBN['Vehiculo'],'DMTITU',0,4))
          EndIf
          
          If EqStr(Val(F:&I),FBN['Vehiculo'])
             ACN(Z:17,0)
          Else
             If FBN['CB10'] <> 0
                ACN(Z:17,0)
             Else   
             ACN(Z:17,MontoArancelC(Val(TO:1),Val(F:&I),Val(E:&I),FBN['Vehiculo'],'AOPER',0,4,'','','','',Val(N:&i),'','','','','',SI))
             EndIf
          EndIf
          If EqStr(Val(TO:1),'EQC')
             ACN(Z:18,Val(Z:24) + ((Val(Z:24)*Val(Z:16))/100) + ((Val(Z:24)*Val(Z:17))/100))
          Else
             ACN(Z:18,Val(Z:24) - ((Val(Z:24)*Val(Z:16))/100) - ((Val(Z:24)*Val(Z:17))/100))
          EndIf
          
          SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
          SQL.ADD ("  Where Cliente='"~IIF(EqStr(Val(Z:27),VAR('MERCARGC')),VAR('CLIARGC'),Val(F:&I))~"' ")
          SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"%') ")
          SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
          SQL.ADD ("    And  "~IIF(Not Incluido(Val(Z:27),VAR('MERCARGC'))," Mercado='"~Val(Z:26)~"' "," Mercado in ('BCRA','AC','SWIFT') ")~" ")
          Recorrer SQL
            ACT(Z:11,FBN['Codigo'])
          Proximo
          
          SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
          SQL.ADD ("  Where Cliente='"~IIF(EqStr(Val(Z:27),VAR('MERCARGC')),FBN['Vehiculo'],Val(F:&I))~"' ")
          SQL.ADD ("    And (Especies='"~Val(E:&I)~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' ")
          SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And Mercado='"~Val(Z:27)~"' ")
          SQL.ADD (" Order by Codigo ASC ")
          Recorrer SQL
            ACT(Z:13,FBN['Codigo'])
          Proximo
          
          If EqStr(Val(Z:27),VAR('MERCARGC'))
             ACT(z10,Val(z13))
          Else
             ACT(z10,CuentaCliente(Val(F:&I),Val(E:&I),,Val(Z:27),Val(TO:1),'HAB'))
          EndIf
          
          If EqStr(Val(Z:26),VAR('MERCARGC'))
             ACT(z14,Val(z11))
          Else
             If NoVacio(Val(Z:26))
                ACT(Z:14,CuentaCliente(FBN['Vehiculo'],FBN['ContraEspecie'],,Val(Z:26),Val(TO:1),'HAB'))
             Else
                ACT(Z:14,SQL(" Select TOP 1 Codigo from "~DBO~".CUENTAS where Estado = 'HAB' and Cliente='"~FBN['Vehiculo']~"' and (Mercado is Null or Mercado ='') "))
             EndIf
          EndIf
          
          ACN(Z:15,COTIZACIONC(Val(E:&I),,,,Val(D:&I),1,SI,FBN['ContraEspecie']))
          
          If EqStr(FBN['ContraEspecie'], BuscarCampo('ESPECIES','MonedaEmision','Codigo',Val(E:&I)))
             ACN(Z:19,Val(L:&I))
          Else
             If EqStr(MODO(FBN['ContraEspecie'],BuscarCampo('ESPECIES','MonedaEmision','Codigo',Val(E:&I))),'INV')
             ACN(Z:19,Val(L:&I)/FBN['TotalAux1'])
             Else
                ACN(Z:19,Val(L:&I)*FBN['TotalAux1'])
             EndIf
          EndIf
          If EqStr(FBN['ContraEspecie'], Var('MONELOCA'))
             ACN(Z:20,Val(L:&I))
          Else
             If EqStr(MODO(FBN['ContraEspecie'],Var('MONELOCA')),'INV')
                ACN(Z:20,Val(L:&I)/FBN['TotalAux1'])
             Else
                ACN(Z:20,Val(L:&I)*FBN['TotalAux1'])
             EndIf
          EndIf
          
          ACT(Z:25,COPY(VAR('MERCADOCV'),1,2))
       Else
          ACN(Z:5,CotizacionC(FBN['ContraEspecie'],,,,Val(D:&I),1,SI,VAR('MONELOCA')) )
          IF Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(E:&I)),'CLE')
             ACN(Z:24,Val(K:&I)*Val(L:&I)*ValorTeorico2(Val(E:&I),Val(FV:1)))
          Else
             ACN(Z:24,Val(K:&I)*Val(L:&I))
          EndIf
          ACN(Z:18,Val(Z:24))
          
          ACT(Z:12,SQL(" Select CodOperador from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~Val(F:&I)~"' and Estado='DEF' "))
          
          SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
          SQL.ADD ("  Where Cliente='"~IIF(EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:27)~"' "),'SI'),SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:27)~"' "),Val(F:&I))~"' ")
          SQL.ADD ("    And (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"%') ")
          SQL.ADD ("    And Estado='HAB' And TipoCuenta in ('CC','CA','CUS') ")
          SQL.ADD ("    And  "~IIF(Not EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:27)~"' "),'SI')," Mercado='"~Val(Z:26)~"' "," Mercado in ('BCRA','AC','SWIFT') ")~" ")
          Recorrer SQL
            ACT(Z:11,FBN['Codigo'])
          Proximo
          
          SQL.ADD (" Select TOP 1 Codigo From "~DBO~".CUENTAS ")
          SQL.ADD ("  Where Cliente='"~IIF(EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:27)~"' "),'SI'),FBN['Vehiculo'],Val(F:&I))~"' ")
          SQL.ADD ("    And (Especies='"~Val(E:&I)~"' OR Especies LIKE '%TITULO%') AND Estado='HAB' ")
          SQL.ADD ("    And TipoCuenta in ('CUS', 'CCO') And Mercado='"~Val(Z:27)~"' ")
          SQL.ADD (" Order by Codigo ASC ")
          Recorrer SQL
            ACT(Z:13,FBN['Codigo'])
          Proximo
          
          If EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:27)~"' "),'SI')
             ACT(z10,Val(z13))
          Else
             ACT(z10,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Vehiculo']~"' and (Especies Like '%"~Val(E:&I)~"|%' OR Especies LIKE '%TITULO%|') AND Estado='HAB' AND TipoCuenta In ('CUS', 'CCO') AND Mercado='"~Val(Z:27)~"' and (TiposOperacion is NULL or TiposOperacion like '%"~Val(TO:1)~"|%') "~IIF(EqStr(Val(Z:27),'CRYL'), "AND UPPER(Alias1) ='CP' ")~" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
          EndIf
                    
          If EqStr(SQL("SELECT Netea FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(Z:26)~"' "),'SI')
             ACT(z14,Val(z11))
          Else
             ACT(Z:14,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Vehiculo']~"' and (Especies Like '%MONEDA%' or Especies Like '%"~FBN['ContraEspecie']~"|%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and  Mercado ='"~Val(Z:26)~"' and (TiposOperacion is NULL or TiposOperacion like '%"~Val(TO:1)~"|%') "~IIF(EqStr(Val(Z:26),'CRYL'), "AND UPPER(Alias1) ='CP' ")~" ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
          EndIf
                    
          ACT(Z:23,NrCupon2(Val(E:&I),Val(FV:1)))
          
          ACT(Z:29,BuscarCampo('ESPECIES','CodMAEContado','Codigo',Val(E:&I)))
          
       EndIf
       
       If SQL(" Select 1 from "~DBO~".OPERACIONES Where NrOrden1='"~Val(B:&I)~"' ")=0
          If Incluido(Val(TO:1),'EQC|EQV')
             ACT(Z:2, GetNumerador(302))
          Else
             ACT(Z:2, GetNumerador(1))
          EndIf
          ACT(Z:22,Val(Z:2))
          
          SQL.ADD(" Update "~DBO~".ORDENES Set ")
          SQL.ADD("  NrOperacion2 = '"~Val(Z:2)~"', ")
          SQL.ADD("  Cantidad3=1, ")
          SQL.ADD("  CB7='1' ")
          SQL.ADD(" Where NrOrden = '"~Val(B:&I)~"' ")
          SQL.NEW
          SQL.EXEC
          
          ** Genera bits de la operacion y se avanza a instancia 7
          EjecutarEvento('INBIT2', String1='OPERACIONES', Entero1=7, NrOperacion1=Val(Z:2))
          
          SQL.ADD(" Insert Into "~DBO~".OPERACIONES ")
          SQL.ADD(" (TipoOp, NrOperacion, Especie, Cliente1, FechaOp, ")
          SQL.ADD("  Plazo, FechaVto, FechaPago, Cantidad, Precio1, ")
          SQL.ADD("  ContraEspecie, TotalBrutoCli1, Mercado, Mercado2, Vehiculo1, ")
          SQL.ADD("  Operador, TablaFeriados1, FormaLiquidacion1, FormaLiquidacion2, Cartera, RB10, Book1, ")
          SQL.ADD("  TotalNetoCli1, TotalNetoCli3, Cotizacion1, Cotizacion2, ")
          SQL.ADD("  PorImpuestoBolsa, PorDerechoBolsa, RB3, RB5, ")
          SQL.ADD("  UsrInput, FechaCarga, FechaCargaSys, Numerador, PaseCB, ")
          SQL.ADD("  Plazo2, TotalAux1, TotalAux4, CB5, CB6, OpSIOPEL, ")
          SQL.ADD("  CB8, CB9, VTeorico, CanPosTrad, InteresesCorr, ")
          SQL.ADD("  PorDerechoMercado, TotalAux5, TotalAux6, Cuenta1, Cuenta2,")
          SQL.ADD("  Cuenta3, Cuenta4, NrOrden1, CanPosInv1, CanPosInv2, Mercado4, ")
          SQL.ADD("  CanPosOSoc, TotalBrutoCli2, Mercado3, Cupon1, ")
          SQL.ADD("  ContraEspecie2, TotalAux2, TotalGastos, ")
          SQL.ADD("  Especie1, PorArancel, TotalImpuestos, ")
          SQL.ADD("  TipoCambio2, TipoCambio3, PrecioMer, CB10, EnteCus1) ")
          SQL.ADD(" Values ")
          SQL.ADD(" ('"~Val(TO:1)~"', '"~Val(Z:2)~"', '"~Val(E:&I)~"', '"~Val(F:&I)~"', '"~IdxDate(Val(D:&I))~"', ")
          SQL.ADD("  "~FStr(Val(PL:1),0,0)~", '"~IdxDate(Val(FV:1))~"', '"~IdxDate(Val(FV:1))~"', '"~FStr(Val(K:&I),0,2)~"', '"~FStr(Val(L:&I),0,8)~"', ")
          SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:24),0,2)~"', '"~Val(Z:27)~"', '"~Val(Z:26)~"', '"~FBN['Vehiculo']~"', ")
          SQL.ADD("  '"~FBN['Operador']~"', 'ARG', '"~FBN['RB10']~"', '"~FBN['RB10']~"', '0', '0', '"~Val(Z:28)~"', ")
          SQL.ADD("  '"~FStr(Val(Z:18),0,2)~"', '"~FStr(Val(Z:3),0,2)~"', '"~FStr(Val(Z:4),0,9)~"', '"~FStr(Val(Z:5),0,9)~"', ")
          SQL.ADD("  '"~FStr(((Val(K:&I)*Val(L:&I)*Val(Z:4))/Val(K:&I)),0,7)~"', '"~FStr(((Val(K:&I)*Val(L:&I)*Val(Z:5))/Val(K:&I)),0,7)~"', '0', '"~FBN['RB5']~"', ")
          SQL.ADD("  '"~USUARIOACTIVO~"', "~SQLAhora~", '"~IdxDate(FSys)~"', 1, '0', ")
          SQL.ADD("  "~FStr(Val(PL:1),0,0)~", 1, 0, '0', '0', '"~Val(Z:12)~"', ")
          SQL.ADD("  '0', '0', '7', '"~FStr(Val(K:&I),0,2)~"', '"~Val(Z:6)~"', ")
          SQL.ADD("  '"~Val(Z:7)~"', '"~Val(Z:8)~"', '"~Val(Z:9)~"', '"~Val(Z:13)~"', '"~Val(Z:10)~"', ")
          SQL.ADD("  '"~Val(Z:14)~"', '"~Val(Z:11)~"', '"~Val(B:&I)~"', '0', '0', '"~Val(N:&I)~"', ")
          SQL.ADD("  '0', '"~FStr((Val(Z:15)),0,6)~"', '"~Val(Z:25)~"', '"~FStr(Val(Z:23),0,0)~"', ")
          SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:16),0,7)~"', '"~FStr(((Val(K:&I)*Val(L:&I)*Val(Z:16))/100),0,2)~"', ")
          SQL.ADD("  '"~FBN['ContraEspecie']~"', '"~FStr(Val(Z:17),0,7)~"', '"~FStr(((Val(K:&I)*Val(L:&I)*Val(Z:17))/100),0,2)~"', ")
          SQL.ADD("  '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:19),0,8)~"', '"~FStr(Val(Z:20),0,8)~"', '"~FBN['CB10']~"', '"~Val(Z:29)~"') ")
          SQL.NEW
       Else
          ACN(Z:21,Val(CA:2)*Val(PR:3))
          SQL.ADD(" Update "~DBO~".OPERACIONES Set ")
          SQL.ADD("  Cantidad         = "~FStr(Val(CA:2),0,2)~", ")
          SQL.ADD("  Precio1          = "~FStr(Val(PR:3),0,8)~", ")
          SQL.ADD("  TotalBrutoCli1   = "~FStr((Val(CA:2)*Val(PR:3)),0,2)~", ")
          If EqStr(Val(TO:1),'EQC')
             SQL.ADD("  TotalNetoCli1 = "~FStr((Val(Z:21) + ((Val(Z:21)*Val(Z:16))/100) + ((Val(Z:21)*Val(Z:17))/100)),0,2)~", ")
          Else
             If EqStr(Val(TO:1),'EQV')
                SQL.ADD("  TotalNetoCli1 = "~FStr((Val(Z:21) - ((Val(Z:21)*Val(Z:16))/100) - ((Val(Z:21)*Val(Z:17))/100)),0,2)~", ")
             Else
                SQL.ADD("  TotalNetoCli1 = "~FStr((Val(CA:2)*Val(PR:3)),0,2)~", ")
             EndIf
          EndIf
          
          If Incluido(Val(TO:1),'EQC|EQV')
             SQL.ADD("  TotalGastos      = "~FStr(((Val(Z:21)*Val(Z:16))/100),0,2)~", ")
             SQL.ADD("  TotalImpuestos   = "~FStr(((Val(Z:21)*Val(Z:17))/100),0,2)~", ")
          EndIf
          SQL.ADD("  TotalNetoCli3    = "~FStr((Val(CA:2)*Val(PR:3)*(CotizacionC(FBN['ContraEspecie'],,,,FSYS,1,SI,VAR('MONEEXTR')))),0,2)~", ")
          SQL.ADD("  PorImpuestoBolsa = "~FStr(((Val(CA:2)*Val(PR:3)*Val(Z:4))/Val(CA:2)),0,7)~", ")
          SQL.ADD("  PorDerechoBolsa  = "~FStr(((Val(CA:2)*Val(PR:3)*Val(Z:5))/Val(CA:2)),0,7)~" ")
          SQL.ADD(" Where NrOrden1 = '"~Val(B:&I)~"' ")
          SQL.NEW
          
          ACT(Z:22,SQL(" Select NrOperacion2 from "~DBO~".ORDENES where NrOrden = '"~Val(B:&I)~"' "))
       EndIf
       SQL.EXEC
       
       *** Inserto la ejecucion en la Orden
       ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Val(B:&I)~"' "))
       SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio) ")
       SQL.ADD(" Values ('"~Val(B:&I)~"', '"~Val(Z:22)~"', "~FStr(Val(NE:1),0,0)~", '"~FStr(Val(M:&I),0,0)~"', "~SQLAhora~", '"~FStr(Val(K:&I),0,2)~"', '"~FStr(Val(L:&I),0,8)~"') ")
       SQL.NEW
       
       *** Actualizo campo Cantidad Ejecuciones en la Orden
       SQL.ADD(" Update "~DBO~".ORDENES Set ")
       SQL.ADD("  Cantidad3="~FStr(Val(NE:1),0,0)~" ")
       SQL.ADD(" Where NrOrden = '"~Val(B:&I)~"' ")
       SQL.NEW
       SQL.EXEC
       
       ** Actualizo Movimientos de la Operacion
       SQL.ActualizarMovimientos3(Val(Z:22),SI,SI,NO,SI,SI)
       SQL.EXEC
       
       ACN(CA:1,0)
       ACN(PR:1,0)
       ACN(PR:2,0)
       ACN(Z:3,0)
       ACN(Z:4,0)
       ACN(Z:5,0)
       ACN(Z:6,0)
       ACN(Z:7,0)
       ACN(Z:8,0)
       ACN(Z:9,0)
       ACN(Z:10,0)
     Proximo
  EndIf
Proximo