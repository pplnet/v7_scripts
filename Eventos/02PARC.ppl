* Genera afectacion de limites por fallas
  (.'GENFALLAS3'.)

*MessageBox('Anula Movimientos Voucher '~Val(b:1))
  SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
  SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
  SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
  SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
  SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
  SQL.ADD(") ")
  SQL.ADD("select ")
  SQL.ADD("'"~Val(b:12)~"', FechaMov, Cliente, Especie, CallPut, ")
*  IF Val(rd1) = 1
      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
*  ELSE
*      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, '"~Val(B:13)~"', ")
*  ENDIF
  SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
  SQL.ADD("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
  SQL.ADD("'"~UsuarioActivo~"', Cuenta, Transaccion, "~FStr(-Val(b:8),1,2)~", Cupon")
  SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("where NrOperacion = '"~Val(b:1)~"' ")
  SQL.NEW

  SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
  SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
  SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
  SQL.ADD("NrMov, NrLiq, Status, NrInstan, FechaEje, ")
  SQL.ADD("UsuarioEje, Cuenta, Transaccion, Cantidad, Cupon")
  SQL.ADD(") ")
  SQL.ADD("select ")
  SQL.ADD("'"~Val(b:12)~"', FechaMov, Cliente, Especie, CallPut, ")
*  IF Val(rd1) = 1
      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
*  ELSE
*      SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, '"~Val(B:13)~"', ")
*  ENDIF
  SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', Bits, NrGrupo, Concepto, NrGrupo2, ")
  SQL.ADD("NrMov, NrLiq, Status, -1, '"~IdxDate(FSys)~"', ")
  SQL.ADD("'"~UsuarioActivo~"', Cuenta, Transaccion, "~FStr(Val(b:8),1,2)~", Cupon")
  SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("where NrOperacion <> '"~Val(b:1)~"' ")
  SQL.ADD("and NrTrans2 = '"~Val(b:1)~"' ")
  SQL.NEW


  if Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(b:40)),'DTP|RTP')
     **- Marco la Transaccion que se esta matcheando -**
     SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2                                ")
     SQL.ADD("SET    RB2='1',Fecha5='"~IdxDate(Dialogo.Fecha1)~"',         ")
     SQL.ADD("       Cupon2='"~Fstr(NrCupon2(val(b:3),Fsys),0,0)~"',      ")

*    Le modifico la cantidad con solo el total confirmado, y actualizo los movimientos
*    de esta manera solo queda el importe cobrado/pagado efectivamente

     SQL.ADD("       Cantidad1='"~Fstr(val(b:6),0,2)~"',      ")
     SQL.ADD("       CB9 = '1',CB10='0'                                    ")
     SQL.ADD("WHERE  NrTrans= '"~Val(b:40)~"'                             ")
     SQL.NEW

     SQL.EXEC
     SQL.ActualizarMovimientosT2(Val(b:40),SI,NO,NO,SI,0,4)

     SQL.EXEC
     *- Pasa de Instancia
     ACT(az3,Val(b:40))
     ACT(az4,'TRANSACCIONES2')
     ACN(az5,70)
     ACN(az6,1 )
     (.'MODIINSTAN'.)            

  endif

  SQL.EXEC

  break
proximo

