CrearDialogo
  NrTrans1   : 'Nro.Voucher'            ;;;;  ;  ;;;NO;;;;;;" TipoTr2 in ('DEP','RET') and (CB9 <> 1 OR CB9 IS Null) and NrTrans Not in (Select OB.NrOperacion from "~DBO~".OPERACIONESBITS OB where OB.NrOperacion=NrTrans and OB.NrBit in (8) and OB.Valor='1' )  "
  Radio1     : 'Reliq OCT|SI|NO'        ;;;;NO;NO;;;  ;1;
  Cantidad2  : 'Cantidad Confirma OCT'  ;;;;NO;NO;;;  ;0;
FinDialogo

if Not OK
  Cancelar
endif

IF Dialogo.Radio1=1 Y Eqstr(BuscarCampo('TRANSACCIONES2','Mercado1','NrTrans',Dialogo.NrTrans1), Var('MERCOCT'))
    Cancelar('Los Vouchers OCT no Pueden Confirmarse con este Proceso')
ENDIF

if BuscarCampo('TRANSACCIONES2','CB9','NrTrans',Dialogo.NrTrans1)=1
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta confirmado')
endif
ACT(x1, SQL("Select Valor from "~DBO~".OPERACIONESBITS where NrOperacion = '"~Dialogo.NrTrans1~"' and NrBit = 8 "))
if EqStr(Val(x1),'1')
  Cancelar('El Voucher '~Dialogo.NrTrans1~' esta fallado')
endif

ACT(x2, BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans',Dialogo.NrTrans1) )
ACT(x1, SQL("Select CategDepositante from "~DBO~".CLIENTES  where Codigo = '"~Val(x2)~"'  "))

if EqStr(Val(x1),'CLI')
  Cancelar('No puede Confirmar Parcialmente Vouchers de CLientes ')
endif



ACN(RD1,Dialogo.Radio1)

ACT(a:1, 'Nr.Voucher:')
ACT(a:2, 'Cliente:')
ACT(a:3, 'Especie:')
ACT(a:4, 'Tipo:')
ACT(a:5, 'Monto:')
ACT(a:6, 'Importe:')
ACT(a:7, 'Falla:')
ACT(a:8, 'Imp.Falla:')
ACT(a:9, 'DVP:')
ACT(a:10, 'RVP:')
ACT(a:11, 'CONF:')
ACT(a:12, 'Transporte:')
ACT(a:13, 'Mercado:')
ACT(a:14, 'Concepto:')
ACT(a:15, 'Vehiculo:')
ACT(a:16, 'Cupon:')
ACT(a:17, 'Cuenta1:')
ACT(a:18, 'Cuenta2:')

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 where NrTrans = '"~Dialogo.NrTrans1~"' ")
recorrer SQL
  ACT(b:1, FBN['NrTrans'])
  ACT(b:2, FBN['Cliente1'])
  ACT(b:3, FBN['Especie'])
  ACT(b:4, FBN['TipoTr2'])
  ACN(b:5, FBN['Cantidad1'])
  ACN(b:9, FBN['CB6'])
  ACN(b:10, FBN['CB7'])
  ACN(b:11, FBN['CB8'])
  ACT(b:13, FBN['Mercado1'])
  ACT(b:15, FBN['Vehiculo1'])
  ACT(b:16, FBN['Cupon1'])
  ACT(b:17, FBN['Cuenta1'])
  ACT(b:18, FBN['Cuenta2'])
  ACT(b:19, FBN['RB2'])
  ACT(b:40, FBN['NrOperacionRef2'])

  IF Eqstr(FBN['RB7'],'1')
     ACN(b:20,15)
  Else
     ACN(b:20,1)
  Endif


  SQL.ADD("Select Concepto from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Dialogo.NrTrans1~"'")
  recorrer SQL
    DFA
    ACT(b:14, FBN['Concepto'])
  proximo

  IF Val(rd1) = 1
      if EqStr(FBN['TipoTr2'],'DEP')
        ACN(x1, 1)
        CrearDialogo
          Cantidad2: 'Cant.Cobrada' ;8;1;;  ;;Dialogo.Cantidad2>0 y Dialogo.Cantidad2<Val(b:5);'La cantidad esta fuera del rango.';NO;
          NrTrans1 : 'Nr.Voucher'   ;1;1;;NO;;;;;FBN['NrTrans'];
          Cliente1 : 'Cliente'      ;;;;NO;;;;;FBN['Cliente1'];
          Especie1 : 'Especie'      ;;;;NO;;;;;FBN['Especie'];
          Fecha1   : 'Fecha Liq'    ;;;;NO;;;;;FBN['Fecha2'];
          Cuenta1  : 'Cta. Cliente' ;;;;NO;;;;;FBN['Cuenta1'];
          Cuenta2  : 'Cta. Propia'  ;;;;NO;;;;;FBN['Cuenta2'];
          Cantidad1: 'Cant.a Cobrar';;;;NO;;;;;FBN['Cantidad1'];
        FinDialogo
      else
        ACN(x1, -1)
        CrearDialogo
          Cantidad2: 'Cant.Pagada'  ;8;1;;  ;;Dialogo.Cantidad2>0 y Dialogo.Cantidad2<Val(b:5);'La cantidad esta fuera del rango.';NO;
          NrTrans1 : 'Nr.Voucher'   ;1;1;;NO;;;;;FBN['NrTrans'];
          Cliente1 : 'Cliente'      ;;;;NO;;;;;FBN['Cliente1'];
          Especie1 : 'Especie'      ;;;;NO;;;;;FBN['Especie'];
          Fecha1   : 'Fecha Liq'    ;;;;NO;;;;;FBN['Fecha2'];
          Cuenta1  : 'Cta. Cliente' ;;;;NO;;;;;FBN['Cuenta1'];
          Cuenta2  : 'Cta. Propia'  ;;;;NO;;;;;FBN['Cuenta2'];
          Cantidad1: 'Cant.a Pagar' ;;;;NO;;;;;FBN['Cantidad1'];
        FinDialogo
      endif
      ACN(b:6, Dialogo.Cantidad2)
      ACN(b:7, FBN['Cantidad1']-Dialogo.Cantidad2)
      ACN(b:8, (FBN['Cantidad1']-Dialogo.Cantidad2)*Val(x1))
  ELSE
      IF Eqstr(fbn('TipoTr2'),'DEP')
          ACN(X:1, 1)
      ELSE
          ACN(X:1, -1)
      ENDIF
      ***---Reliquidacion OCT
      ACN(b:6, Dialogo.Cantidad2)
      ACN(b:7, FBN['Cantidad1']-Dialogo.Cantidad2)
      ACN(b:8, (FBN['Cantidad1']-Dialogo.Cantidad2)*Val(x1))
      ACT(B:13, 'BCRA')
      ***---Obtengo Fecha Cobro/Pago del voucher
      ACD(FE:2, fbn('Fecha2'))
      ACD(FE:1, Habiles(Val(FE:2), 1, 'ARG', SI))
  ENDIF

  if Not OK
    Cancelar
  endif

*****************************
** Caja de Valores/Financiero
*****************************
  Message('Generacion de Transporte Voucher '~Val(b:1)~'.')
  ACT(b:12,GetNumerador(13))

  Message('Actualiza Voucher '~Val(b:1))

  SQL.ADD("Delete from "~DBO~".INSTANCIASOP ")
  SQL.ADD("Where NrOperacion = '"~Val(b:1)~"' ")
  if EqStr(Val(b:4),'DEP')
    SQL.ADD("and NrInstancia = 3 ")
  else
    SQL.ADD("and NrInstancia = 6 ")
  endif
  SQL.NEW

  SQL.ADD("Insert into "~DBO~".INSTANCIASOP (")
  SQL.ADD("NrOperacion, ")
  SQL.ADD("NrInstancia, ")
  SQL.ADD("Usuario, ")
  SQL.ADD("Mensaje, ")
  SQL.ADD("Fecha ")
  SQL.ADD(") Values (")
  SQL.ADD("'"~Val(b:1)~"', ")
  if EqStr(Val(b:4),'DEP')
    SQL.ADD("3, ")
  else
    SQL.ADD("6, ")
  endif
  SQL.ADD("'"~UsuarioActivo~"', ")
  SQL.ADD("'Generacion de Falla Parcial', ")
  SQL.ADD(""~SQLFechaStr(Fecha(FSys)~' '~Hora(Ahora))~"")
  SQL.ADD(")")
  SQL.NEW

  SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
  SQL.ADD("SET Fecha3 = '"~IdxDate(FSys)~"', ")
  SQL.ADD("NrTransRef1 = '"~Val(b:12)~"', ")
  SQL.ADD("Cantidad3 = "~FStr(Val(b:8),1,2)~", ")
  SQL.ADD("Cantidad4 = "~FStr(Val(b:6),1,2)~", ")
  SQL.ADD("CB3 = '1'")
  SQL.ADD("Where NrTrans = '"~Val(b:1)~"' ")
  SQL.NEW

  SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
  SQL.ADD("SET Valor = '0' ")
  SQL.ADD("where NrOperacion = '"~Val(b:1)~"' ")
  if EqStr(Val(b:4),'DEP')
    SQL.ADD("and NrBit = 3 ")
  else
    SQL.ADD("and NrBit = 6 ")
  endif
  SQL.NEW

  SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
  SQL.ADD("SET Valor = '1' ")
  SQL.ADD("where NrOperacion = '"~Val(b:1)~"' ")
  SQL.ADD("and NrBit = 8 ")
  SQL.NEW

Message('Genera Transporte '~Val(b:12))

  SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")

  SQL.ADD("TipoTr2, ")
  SQL.ADD("Especie, ")
  SQL.ADD("Fecha1, ")
  SQL.ADD("Fecha2, ")
  SQL.ADD("Cliente1, ")

  SQL.ADD("Cantidad1, ")
  SQL.ADD("Vehiculo1, ")
  SQL.ADD("Mercado1, ")
  SQL.ADD("Observaciones, ")
  SQL.ADD("NrTransRef1, ")

  SQL.ADD("CB6, ")
  SQL.ADD("CB7, ")
  SQL.ADD("CB8, ")
  SQL.ADD("Cupon1, ")
  SQL.ADD("Cuenta1, ")
  SQL.ADD("RB2, ")

  SQL.ADD("Cuenta2, ")
  SQL.ADD("NrTrans ")

  SQL.ADD(" ,FechaCarga, FechaCargaSys, UsrInput ")
  SQL.ADD(") Values (")

  SQL.ADD("'TRANSP', ")
  SQL.ADD("'"~Val(b:3)~"', ")
  SQL.ADD("'"~IdxDate(FSys)~"', ")

  IF Val(rd1) = 0
      SQL.ADD("'"~IdxDate(Val(FE:1))~"', ")
  ELSE
      SQL.ADD(" '"~IdxDate(FSys)~"', ")
  ENDIF

  SQL.ADD("'"~Val(b:2)~"', ")

  SQL.ADD(""~FStr(Val(b:8),1,2)~", ")
  SQL.ADD("'"~Val(b:15)~"', ")
  SQL.ADD("'"~Val(b:13)~"', ")
  SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', ")
  SQL.ADD("'"~Val(b:1)~"', ")

  SQL.ADD("'"~FStr(Val(b:9),1,0)~"', ")
  SQL.ADD("'"~FStr(Val(b:10),1,0)~"', ")
  SQL.ADD("'"~FStr(Val(b:11),1,0)~"', ")
  SQL.ADD("'"~Val(b:16)~"', ")
  SQL.ADD("'"~Val(b:17)~"', ")
  SQL.ADD("'"~Val(b:19)~"', ")

  SQL.ADD("'"~Val(b:18)~"', ")
  SQL.ADD("'"~Val(b:12)~"' ")
  SQL.ADD(" ,"~SQLAhora~", "~IdxDate2(FSys)~", '"~UsuarioActivo~"'    ")

  SQL.ADD(")")
  SQL.NEW

  SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
  SQL.ADD("(NrBit, NrOperacion, Valor) ")
  SQL.ADD("Select NrInstancia, '"~Val(b:12)~"', '0'")
  SQL.ADD("from "~DBO~".INSTANCIAS ")
  SQL.ADD("where Tabla = 'TRANSACCIONES2'")
  SQL.NEW

  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
  SQL.ADD(" SET Valor = '1' ")
  SQL.ADD(" Where NrBit = 5 and NrOperacion = '"~Val(b:12)~"' ")
  SQL.NEW

*MessageBox('Genera Movimientos Transporte '~Val(b:12))
  SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")

  SQL.ADD("FechaMov, ")
  SQL.ADD("Cliente, ")
  SQL.ADD("Especie, ")
