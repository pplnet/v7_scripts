  SQL.ADD("Mercado, ")
  SQL.ADD("Concepto, ")
  SQL.ADD("Cuenta, ")

  SQL.ADD("NrOperacion ")

  SQL.ADD(") Values (")
  IF Val(rd1) = 0
      SQL.ADD("'"~IdxDate(Val(FE:1))~"', ")
  ELSE
      SQL.ADD("'"~IdxDate(FSys)~"', ")
  ENDIF
  SQL.ADD("'"~Val(b:2)~"', ")
  SQL.ADD("'"~Val(b:3)~"', ")
  SQL.ADD("'"~Val(b:15)~"', ")
  SQL.ADD(""~FStr(-Val(b:8),1,2)~", ")

  SQL.ADD("'"~'Transporte Parcial '~Val(b:1)~"', ")
  SQL.ADD(""~FStr(1,1,0)~", ")
  SQL.ADD(""~FStr(1,1,0)~", ")
  SQL.ADD(""~FStr(Val(b:20),1,0)~", ")
  SQL.ADD("'MV', ")

  if Val(b:9)=1
    SQL.ADD("'CONF', ")
  else
    if Val(b:10)=1
      SQL.ADD("'DVP', ")
    else
      if Val(b:11)=1
        SQL.ADD("'RVP', ")
      else
        SQL.ADD("'', ")
      endif
    endif
  endif
  SQL.ADD("'"~Val(b:16)~"', ")
  SQL.ADD("'"~Val(b:13)~"', ")
  SQL.ADD("'"~Val(b:14)~"', ")
  SQL.ADD("'"~Val(b:17)~"', ")

  SQL.ADD("'"~Val(b:12)~"' ")
