CrearDialogo
  Radio1:  'Copiar Relacion|Solo Una|Bloque' ;;;;;;;;;0;
  String1: 'Codigo Relacion'     ;2;1;;Radio1=0;;;;;;;SQLSet("Select Distinct Codigo from "~DBO~".RELACIONCUENTA ")
  String2: 'Codigo nuevo'        ;3;1;;Radio1=0;;;;;;SQL("select Max(cast(Codigo as int))+1 from RELACIONCUENTA where isNumeric(Codigo)<>0")
  String7: 'Cant Relaciones'     ;2;2;;Radio1=1;;;;;;;
  String3: 'Codido Desde'        ;3;2;;Radio1=1;;;;;;;SQLSet("Select Distinct Codigo from "~DBO~".RELACIONCUENTA ")
  String4: 'Codigo Hasta'        ;4;2;;Radio1=1;;;;;;;SQLSet("Select Distinct Codigo from "~DBO~".RELACIONCUENTA ")
  String5: 'Cod nuevo Desde'     ;5;2;;Radio1=1;;;;;;SQL("select Max(cast(Codigo as int))+1 from RELACIONCUENTA where isNumeric(Codigo)<>0")
  *String6: 'Cod nuevo Hasta'     ;6;2;;Radio1=1;;String5<>String6 AND NoVacio(String6);'El codigo Hasta de la nueva relacion coincide con el codigo Desde o está vacio, ingresar el codigo correcto.';NO;;SQL("select Max(cast(Codigo as int))+1 from RELACIONCUENTA where isNumeric(Codigo)<>0")
FinDialogo

if not Ok
  Cancelar
endif

**Unica Relacion
ACT(CV:1,Dialogo.String1)
ACT(CN:1,Dialogo.String2)

**Bloque Relaciones
ACT(CV:2,Dialogo.String3)
ACT(CV:3,Dialogo.String4)
ACT(CN:2,Dialogo.String5)
*ACT(CN:3,Dialogo.String6)

If No Vacio(BuscarCampo('RELACIONCUENTA','Codigo','Codigo',val(CN:1)))
    Cancelar('Ya existe una relacion para el codigo')
EndIf

If Dialogo.Radio1=0
    SQL.ADD("Select * from "~DBO~".RELACIONCUENTA where Codigo = '"~val(CV:1)~"'")
    Recorrer SQL
        SQL.ADD("INSERT INTO "~DBO~".RELACIONCUENTA (Codigo,TiposOperacion,Residente,Vinculado,Sector,Especies,TipoImporte,CentroCosto,Cuenta,Libro, ")
        SQL.ADD(" Tabla,EstadoCustodia,Vehiculos,TiposGrupoEsp,TiposLiquidacion,UDN, Book, CodigoRelacion,Moneda,Clientes,Mercado, ")
        SQL.ADD(" PlazoDesde,PlazoHasta,Custodia,Concepto) ")
        SQL.ADD("VALUES ("~val(CN:1)~", '"~fbn('TiposOperacion')~"','"~fbn('Residente')~"','"~fbn('Vinculado')~"','"~fbn('Sector')~"','"~fbn('Especies')~"', ")
        SQL.ADD("'"~fbn('TipoImporte')~"','"~fbn('CentroCosto')~"','"~fbn('Cuenta')~"','"~fbn('Libro')~"', ")
        SQL.ADD("'"~fbn('Tabla')~"','"~fbn('EstadoCustodia')~"','"~fbn('Vehiculos')~"','"~fbn('TiposGrupoEsp')~"','"~fbn('TiposLiquidacion')~"','"~fbn('UDN')~"', ") 
        SQL.ADD("'"~fbn('Book')~"', '"~fbn('CodigoRelacion')~"','"~fbn('Moneda')~"','"~fbn('Clientes')~"','"~fbn('Mercado')~"', ")
        SQL.ADD("'"~fbn('PlazoDesde')~"','"~fbn('PlazoHasta')~"','"~fbn('Custodia')~"','"~fbn('Concepto')~"')")
        SQL.NEW
        SQL.EXEC     
        Proximo 
    Messagebox("Relacion "~val(CN:1)~" creada con exito")    
    Else    
    SQL.ADD("Select * from "~DBO~".RELACIONCUENTA where Codigo Between '"~val(CV:2)~"' AND  '"~val(CV:3)~"'")
    ACN(ZZ:1,0) 
    Recorrer SQL
        If Val(ZZ:1)=0
            ACT(CN:1,val(CN:2))
            ACN(ZZ:1,1)
        Else
            **A partir del 2do voy a buscar el codigo max+1 porque necesito que sea texto para insertarlo y no manejarlo como numero
            ACT(CN:1,SQL("select Max(cast(Codigo as int))+1 from RELACIONCUENTA where isNumeric(Codigo)<>0"))
        EndIf
        SQL.ADD("INSERT INTO "~DBO~".RELACIONCUENTA (Codigo,TiposOperacion,Residente,Vinculado,Sector,Especies,TipoImporte,CentroCosto,Cuenta,Libro, ")
        SQL.ADD(" Tabla,EstadoCustodia,Vehiculos,TiposGrupoEsp,TiposLiquidacion,UDN, Book, CodigoRelacion,Moneda,Clientes,Mercado, ")
        SQL.ADD(" PlazoDesde,PlazoHasta,Custodia,Concepto) ")
        SQL.ADD("VALUES ("~val(CN:1)~", '"~fbn('TiposOperacion')~"','"~fbn('Residente')~"','"~fbn('Vinculado')~"','"~fbn('Sector')~"','"~fbn('Especies')~"', ")
        SQL.ADD("'"~fbn('TipoImporte')~"','"~fbn('CentroCosto')~"','"~fbn('Cuenta')~"','"~fbn('Libro')~"', ")
        SQL.ADD("'"~fbn('Tabla')~"','"~fbn('EstadoCustodia')~"','"~fbn('Vehiculos')~"','"~fbn('TiposGrupoEsp')~"','"~fbn('TiposLiquidacion')~"','"~fbn('UDN')~"', ") 
        SQL.ADD("'"~fbn('Book')~"', '"~fbn('CodigoRelacion')~"','"~fbn('Moneda')~"','"~fbn('Clientes')~"','"~fbn('Mercado')~"', ")
        SQL.ADD("'"~fbn('PlazoDesde')~"','"~fbn('PlazoHasta')~"','"~fbn('Custodia')~"','"~fbn('Concepto')~"')")
        SQL.NEW
        SQL.EXEC
        Messagebox("Relacion "~val(CN:1)~" creada con exito")       
    Proximo
EndIf