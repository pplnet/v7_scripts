CrearDialogo
  Fecha1 : 'Fecha'            ;1;1;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;Hoy
  Radio1 : 'Automatico|NO|SI' ;2;1;;NO;NO;;;;0;
FinDialogo


If NOT OK
  Cancelar
Else
    If  Dialogo.Fecha1=Hoy
        SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor = 'SI' WHERE Codigo = 'ABIERTO'")
        SQL.NEW
        SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor = '"~Dialogo.Fecha1~"' WHERE Codigo = 'FECHASYS'")
        SQL.NEW
        SQL.EXEC
    Else
        Cancelar('La fecha de apertura ingresada no es válida')
    Endif
Endif

