***Reseteo la variable NRLOTE para la interface contable con SAP***
SQL.ADD(" Update "~DBO~".VARIABLES ")
SQL.ADD(" Set Valor = '0' ")
SQL.ADD(" where Codigo = 'NRLOTE' ")
SQL.NEW
SQL.EXEC

***---Vencimiento de Cupones
LinkearHoja('VTOCUP', 1, Fecha1=Val(FC:1), Radio1=2)

