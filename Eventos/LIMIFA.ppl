SQL.ADD(" SELECT T.* FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE T.NrTrans = B.NrOperacion AND")
SQL.ADD(" B.Valor    = '1' AND")
SQL.ADD(" B.NrBit   In (3, 6, 8) AND")
SQL.ADD(" T.TipoTr2 in ('DEP','RET') ")
*** pasan todos los vouchers sin confirmar ***
***SQL.ADD(" AND T.RB6      = 2 ")
SQL.ADD(" ORDER BY T.NrTrans ")

Recorrer SQL

   acn(a1, 0)

   SQL.ADD("Select Count(*) as Cuantos from "~DBO~".MOVLIMITES ")
   SQL.ADD("Where NrOperacion = '"~fbn['NrTrans']~"' ")
   SQL.ADD("  and FechaLim    = '"~IdxDate(Dialogo.Fecha2)~"' ")

