CrearDialogo
   String1:      'Mensaje' ;;
   Radio1:       'Tipo|Información|Advertencia|Alerta|Operación' ;;;;;;;;;0
   NrOperacion1: 'NrOperacion' ;;;;;Radio1=3
FinDialogo

if(Dialogo.Radio1 < 3)
    EnviarMensaje(Dialogo.String1, Dialogo.Radio1)
endif

if(Dialogo.Radio1 = 3)
    EnviarMensajeOp(Dialogo.String1, Dialogo.NrOperacion1)
endif

MessageBox('Mensaje enviado!')