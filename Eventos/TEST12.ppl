CrearDialogo
  Fecha1     : "F.Op.Desde" ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una FechaOp Desde';NO;FSys;
  Fecha2     : "F.Op.Hasta" ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

if Not Ok
  Cancelar
endif

aCN(W:1,0)


SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, O.Especie ")
SQL.ADD(" From    "~DBO~".OPERACIONES O   ")
SQL.ADD(" where  O.TipoOp IN ('FCS','FCR')  ")
SQL.ADD(" AND O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")  
SQL.ADD(" order by O.NrOperacion ")

Recorrer SQL 
   SCN(W:1,1)
   ACT(B:1,fbn('Especie'))
   ACT(B:2,fbn('NrOperacion'))
   ACD(B:3,fbn('FechaOp'))   
 
   ActualizarMovimientos3(Val(B:2), NO, SI, NO, NO, NO, 0)
   
   SQL.NEW 
   SQL.EXEC 
     
   ***---Ajuste Limites FCI
   EjecutarEvento('AJULIM', Fecha1=val(B:3))
        * MessageBox('OPERACION ModificadA  '~ val(B:2)~'Fecha  '~ val(B:3) )
Proximo


  MessageBox('Total Leido/Modificado  '~ val(W:1))
     