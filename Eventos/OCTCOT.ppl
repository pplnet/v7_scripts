MostrarCuadroDeMEnsajes
CrearDialogo
  Fecha1:'Fecha';;;;;;Dialogo.Fecha1 <> 0;'Fecha Invalida';NO;Fsys
FinDialogo

if Not OK
  Cancelar
endif

ACN(BD:1, 0)
SQL.ADD(" Select * From "~DBO~".COTIZACIONES_TEMPORAL ")
SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
Recorrer SQL
    ACN(BD:1, 1)
    IF Eqstr(fbn('CallPut'), 'CON')
        IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND Codigo = '"~fbn('Codigo')~"' AND CallPut = 'CON'  ") <> 1
            Message('Alta Cotizacion Contado '~fbn('Codigo'))
            SQL.ADD(" Insert Into "~DBO~".COTIZACIONES ")
            SQL.ADD(" (Fecha, Codigo, CallPut, ")
            SQL.ADD(" Precio1, Precio2, Precio3) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('Codigo')~"', '"~fbn('CallPut')~"', ")
            SQL.ADD(" "~Fstr(fbn('Precio1'), 0, 8)~", "~Fstr(fbn('Precio1'), 0, 8)~", "~Fstr(fbn('Precio1'), 0, 8)~") ")
            SQL.NEW
        ELSE
            Message('Modificacion Cotizacion Contado '~fbn('Codigo'))
            SQL.ADD(" Update "~DBO~".COTIZACIONES ")
            SQL.ADD(" Set Precio1 = "~Fstr(fbn('Precio1'), 0, 8)~", ")
            SQL.ADD(" Precio2 = "~Fstr(fbn('Precio1'), 0, 8)~", ")
            SQL.ADD(" Precio3 = "~Fstr(fbn('Precio1'), 0, 8)~" ")
            SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND Codigo = '"~fbn('Codigo')~"' ")
            SQL.ADD(" AND CallPut = 'CON' ")
            SQL.NEW
        ENDIF
    ELSE
        IF SQL(" Select 1 From "~DBO~".COTIZACIONES Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND Codigo = '"~fbn('Codigo')~"' AND CallPut = '"~fbn('CallPut')~"' AND FechaEj = '"~IdxDate(fbn('FechaEj'))~"'  ") <> 1
            Message('Alta Cotizacion Futura '~fbn('Codigo'))
            SQL.ADD(" Insert Into "~DBO~".COTIZACIONES ")
            SQL.ADD(" (Fecha, Codigo, CallPut, ")
            SQL.ADD(" Precio1, FechaEj, Precio2, ")
            SQL.ADD(" Precio3) ")
            SQL.ADD(" Values ")
            SQL.ADD(" ('"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('Codigo')~"', '"~fbn('CallPut')~"', ")
            SQL.ADD(" "~Fstr(fbn('Precio1'), 0, 8)~", '"~IdxDate(fbn('FechaEj'))~"', "~Fstr(fbn('Precio1'), 0, 8)~", ")
            SQL.ADD(" "~Fstr(fbn('Precio1'), 0, 8)~") ")
            SQL.NEW
        ELSE
            Message('Modificacion Cotizacion Futura '~fbn('Codigo'))
            SQL.ADD(" Update "~DBO~".COTIZACIONES ")
            SQL.ADD(" Set Precio1 = "~Fstr(fbn('Precio1'), 0, 8)~", ")
            SQL.ADD(" Precio2 = "~Fstr(fbn('Precio1'), 0, 8)~", ")
            SQL.ADD(" Precio3 = "~Fstr(fbn('Precio1'), 0, 8)~" ")
            SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND Codigo = '"~fbn('Codigo')~"' ")
            SQL.ADD(" AND CallPut = '"~fbn('CallPut')~"' ")
            SQL.ADD(" AND FechaEj = '"~IdxDate(fbn('FechaEj'))~"' ")
            SQL.NEW
        ENDIF
    ENDIF
Proximo
SQL.EXEC

IF Val(BD:1) = 0
    MessageBox('No Hay Cotizaciones Recibidas para la Fecha Solicitada')
ENDIF