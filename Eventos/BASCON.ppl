        EscribirASCII("001"~Pad0(fbn('NrUnicoAsiento'),9)~Pad0(Val(aa:1),4)~Pad0(val(FP:1),8)~Pad0(val(FV:2),8)~Pad0(val(FL:1),8)~Pad0(fbn['Cuenta'],9)~"        "~val(MO:1)~"      000"~fbn['DC']~Pad0(Copy(fbn['Cantidad1'],1,Posicion('.',fbn['Cantidad1'],1)-1)~Copy(fbn['Cantidad1'],Posicion('.',fbn['Cantidad1'],1)+1,2),14)~Pad0('0',14)~Pad(fbn['Descripcion'],40)~Pad0(val(ES:1),6)~Pad0(val(FV:1),8)~Pad0(val(CC:1),6)~Pad0('0',3)~Pad0(Copy(fbn['valor3'],1,Val(aa:10)-1),4)~Pad(Copy(fbn['valor3'],Val(aa:10)+1,6),6,'0')~Pad0('0',3)~Val(aa:11)~Pad0('0',56)~Pad('',35)~Pad0(val(NO:1),8)~Pad0('0',3))
*    ENDIF
   
   
