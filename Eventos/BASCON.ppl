       ACT(aa:11,'-'~Pad0(Copy(fbn['valor2'],2,200),11) )
    ELSE
        ACT(aa:11,Pad0(fbn['valor2'],12) )
    ENDIF
    
    *--*Ubicacion de guion de Alias5
    ACN(PO:1,Posicion('-',fbn('Alias5'),1))
    *--*Especie 6
    ACT(ES:1,Copy(fbn('Alias5'),val(PO:1)+1,longitud(fbn('Alias5'))))
    If Longitud(val(ES:1)) > 6
        ACT(ES:1,Copy(val(ES:1),Longitud(val(ES:1))-6+1,Longitud(val(ES:1))))
    EndIf
    
    If val(PO:1) > 7
        *--*Posicion desde donde copio cliente porque viene con 10 caracteres padeados con 0's a izquierda y necesitamos los ultimos 6
        ACN(DE:1,val(PO:1)-6)
        *--*Cuenta Comitente-Cliente BanTotal 6
        ACT(CC:1,Copy(fbn('Alias5'),val(DE:1),6))
    Else
        *--*Posicion desde donde copio cliente
        ACN(DE:1,1)
        *--*Cuenta Comitente-Cliente BanTotal 6
        ACT(CC:1,Copy(fbn('Alias5'),val(DE:1),val(PO:1)-1))
    EndIf
    
    *--*FechaVto ddmmaaaa completado con 8 ceros si viene vacio
    ACT(FV:1,Copy(fbn('FechaVto'),1,2)~Copy(fbn('FechaVto'),4,2)~Copy(fbn('FechaVto'),7,4) )
    
    *--*FechaValor ddmmaaaa completado con 8 ceros si viene vacio
