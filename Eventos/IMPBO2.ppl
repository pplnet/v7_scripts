  ACN(li:1,35)
  if Incluido(fbn('TipoOp'), 'DDC')
    ACT(a:Val(li:1), 'Los Titulos Valores cuya compra se detalla quedan en custodia y/o garantia hasta su posterior retiro o venta. La no manifiestacion expresa en contrario del comitente')
