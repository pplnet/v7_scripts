            ACT(a:Val(li:1)+3, 'Si Ud.desconoce esta/s operacion/es por favor envie un email a '~Val(EM:1)~' dentro de las 48 hs. de notificado, para efectuar el reclamo ')
            ACT(a:Val(li:1)+4, 'correspondiente. Se deja asentado que la recepcion del presente boleto sin que se hubiera recibido observaciones dentro del plazo reseñado implicara la aceptacion')
