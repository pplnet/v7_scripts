  AgregarMarco(d14..f14,1,0,Exe('COLOR2'))
  AgregarMarco(d14..f17,2,0)
  AgregarMarco(a20..h22,1,0)
  AgregarMarco(a24..h34,1,0)
  AgregarMarco(a24..h27,1,0)
  AgregarMarco(a24..h24,1,0,Exe('COLOR2'))
  AlinearCeldas(a24..h24,'D')
  AlinearCeldas(f24..f24,'D')
  AlinearCeldas(a24..h25,'D')
  
  LimitesVision(i:50)  
#endif  
 
  

If Dialogo.Radio2 = 0
   ImprimirHoja(SI)
Else
   If Dialogo.Radio2 = 2
      HojaVisible(NO)
      SetPrintFit(4)
      ExportarPdfLite(val(ar:1))
   else
    HojaVisible(SI)
        If Dialogo.Radio2 = 3  
         HojaVisible(NO)
         SetPrintFit(4)
         ExportarPdfLite(val(ar:1))
         SendMail(Val(em:2),val(AA:10),val(ZK:1),SI,,,val(ar:1),,SI)
        Endif 
   endif
Endif 

Autofit(si)