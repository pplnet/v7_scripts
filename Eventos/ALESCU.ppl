
CrearDialogo
  Especie1       : 'Especie'       ;;;;;;;;NO;
  Especie2       : 'Especie Cupon' ;;;;;;;;NO;
  ContraEspecie1 : 'Moneda Cotiza' ;;;;;;;;NO;
  ContraEspecie2 : 'Moneda Emision';;;;;;;;NO;
FinDialogo

IF NOT OK
  Cancelar
ENDIF

let &Jerarq GenerarJerarquiaByRef('ESPECIES',Query("Select Jerarquia from "~DBO~".ESPECIES where Codigo = 'CUPON' "), true)

If NoVacio(SQL("Select Nombre, Extendido, Status, EsCupon, Alias3, Cotiza, MonedaEmision, Tipo from "~DBO~".ESPECIES WHERE Codigo = '"~Dialogo.Especie2~"' "))
         SQL.ADD(" Update "~DBO~".ESPECIES ")
         SQL.ADD(" Set Nombre = 'CUPON "~Dialogo.Especie1~"',")
         SQL.ADD(" Extendido = 'Especie Cupon "~Dialogo.Especie1~"',")
         SQL.ADD(" Status = 'HAB',")
         SQL.ADD(" EsCupon = 'SI', ")
         SQL.ADD(" Alias3 = '"~Dialogo.Especie1~"', ")
         SQL.ADD(" Cotiza = '"~Dialogo.ContraEspecie1~"', ")
         SQL.ADD(" MonedaEmision = '"~Dialogo.ContraEspecie2~"', ")
         SQL.ADD(" Tipo = 'PUB' ")
         SQL.NEW
         SQL.EXEC
Else
        SQL.ADD("Insert Into "~DBO~".ESPECIES ")
        SQL.ADD("(Codigo,Jerarquia, Nombre, Extendido, Status, EsCupon, Alias3, Cotiza, MonedaEmision, Tipo) ")
        SQL.ADD(" VALUES ('"~Dialogo.Especie2~"','"~&Jerarq~"','CUPON "~Dialogo.Especie1~"','Especie Cupon "~Dialogo.Especie1~"', 'HAB','SI', '"~Dialogo.Especie1~"', '"~Dialogo.ContraEspecie1~"', '"~Dialogo.ContraEspecie2~"', 'PUB')  ")
        SQL.NEW
        SQL.EXEC
Endif


 