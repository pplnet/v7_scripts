MostrarCuadroDeMensajes
CrearDialogo
  Especie1 :'Especie'   ;1;1;;;;NoVacio(Dialogo.Especie1) Y DesciendeDeEspecie(Dialogo.Especie1,'ACCION');'Especie Invalida';NO;;;;;;"Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
  Fecha2   :'R.Date'    ;1;2;;  ;;NoVacio(Dialogo.Fecha2);'Record Date Invalida'  ;NO;fsys
  Fecha1   :'F.Pago'    ;2;2;;  ;;NoVacio(Dialogo.Fecha1) Y Dialogo.Fecha1<=FSYS;'Fecha de Pago Invalida';NO;fsys
  Mercado1 :'Mercado'   ;2;1;;  ;;
  Vehiculo1:'Vehiculo'  ;4;1;;  ;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
  Check1   :'Impacta SE';5; ; ;  ;  ;;;;0;
  Check2   :'Interfase' ;6;1;1;NO;NO;;;;1;
FinDialogo
If Not Ok
  Cancelar
Endif

ACN(aa:1, 0)
ACN(z:10, 0)
ACT(VH:1, Dialogo.Vehiculo1)

***---Obtengo datos de la especie
SQL.ADD(" Select Nombre, ISIN, LaminaMinima ")
SQL.ADD(" From "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")
watch(SQL.BATCH())   

Recorrer SQL
  DFA
  ACT(NM:1, fbn('Nombre'))
  ACT(IS:1, fbn('ISIN'))
  ACN(LM:1, IIF(fbn('LaminaMinima')=0,1,fbn('LaminaMinima')))
Proximo

* Saldos Libre
ACT(sl:2, VAR('LIBREDISP'))
* Saldos Bloquedos
ACT(sl:3, VAR('BLOQUEOS'))
* Saldos Parking
ACT(sl:4, VAR('SALPARK'))

** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
* Mercado Liquidacion Saldo Bloquedos
ACT(ml:1, VAR('MERAUXLIQ'))

SQL.ADD("select DISTINCT T.*, C.RazonSocial ")
***---SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M  ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C  ")
SQL.ADD(" where C.Codigo = T.Cliente1 ")
SQL.ADD("  AND  'HAB' = C.Status ")
SQL.ADD("  and  'PDIVID'  = T.TipoTr2 ")
SQL.ADD("  and  T.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("  and  T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  T.Fecha2 = '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and T.RB2 = 0 ")
SQL.ADD("  and T.RB1 > 0 ")
If NoVacio(Dialogo.Mercado1) 
  SQL.ADD(" AND T.Mercado1 = '"~Dialogo.Mercado1~"' ")
Endif
SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" order by T.Mercado1, T.Cliente1, T.NrTrans ")
watch(SQL.BATCH())   

Recorrer SQL
  if Incluido(fbn('Cambio5'),Val(sl:4))
    DFA
    SCN(z:10, 1)
    ACT(bb:Val(z:10), fbn('Mercado1'))
    ACT(bc:Val(z:10), fbn('Cliente1'))
    ACT(bd:Val(z:10), fbn('Especie1'))
    ACT(be:Val(z:10), fbn('Especie2'))
    ACT(bf:Val(z:10), fbn('NrTrans'))
    ACT(bi:Val(z:10), SQL("Select TOP 1 Codigo from "~DBO~".CUENTAS where Cliente='"~fbn('Cliente1')~"' AND Mercado='"~fbn('Mercado1')~"' AND Estado='HAB' AND (Especies LIKE '"~fbn('Especie2')~"%' OR Especies LIKE '%TITULO%') AND TipoCuenta In ('CUS', 'CCO') "))
    ACT(bj:Val(z:10), fbn('Cuenta5'))
    ACT(bv:Val(z:10), fbn('Mercado1'))

    ACN(bl:Val(z:10), fbn('Cantidad9')) 
    ACN(bm:Val(z:10), fbn('Cantidad10'))
    ACN(bn:Val(z:10), fbn('Cantidad11'))
    ACN(bo:Val(z:10), fbn('Cambio5'))
    ACT(br:Val(z:10), fbn('Cuenta2'))
    ACT(bs:Val(z:10), fbn('Cliente2'))
  else
    ACN(aa:1, 1) 
    ACN(a:fac, 1)
    ACT(b:fac, fbn('Mercado1'))
    ACT(c:fac, fbn('Cliente1'))
    ACT(s:fac, fbn('Cliente2'))
    ACT(d:fac, fbn('RazonSocial'))
    ACT(e:fac, fbn('NrTrans'))
    ACT(f:fac, iif(EqStr(fbn('RB10'),'0'),'Efectivo','Acciones'))
    ACT(g:fac, fbn('Especie'))
    ACT(n:fac, fbn('Especie2'))
    ACN(k:fac, fbn('Cantidad1'))
    ACN(m:fac, fbn('Cantidad2'))
    ACN(p:fac, fbn('Cantidad3'))
    ACN(l:fac, fbn('Precio1'))
    ACN(o:fac, fbn('Precio2'))
    ACT(q:fac, fbn('Cuenta1'))
    ACT(r:fac, fbn('Cuenta2'))
* FJL 18/12/21 - Se Traen datos Comisiones
    ACN(ad:fac, fbn('Cantidad9'))
    ACN(ae:fac, fbn('Cantidad10'))
    ACN(af:fac, fbn('Cantidad11'))
    ACN(ag:fac, fbn('Cambio5'))
** FJL 25/8/22 - Se agrgan Comisiones CV
    ACN(ah:fac, fbn('Cantidad12')+fbn('Cantidad14'))
    ACN(ai:fac, fbn('Cantidad13')+fbn('Cantidad15'))
** FJL 26/8/22 - Se agrga Estado
    if fbn('Cambio5')>201
      ACN(aj:fac, fbn('Cambio5')-100)
    else
      ACN(aj:fac, fbn('Cambio5'))
    endif
    ACT(ak:fac, BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',Val(aj:fac)))
** FJL 01/07/22 - Cuanta Vista para saldos bloquedas
    ACN(y:fac, 0)
    if Incluido(Val(ag:fac),Val(sl:3))
      ACN(y:fac, 1)
    endif

  endif
Proximo

If Val(aa:1)<=0
  Cancelar('No existen Transacciones a Confirmar.')
else

  CrearListBox       ; 'Arial,8,';'Confirmacion Pago de Dividendos '~Val(NM:1)~' (ISIN: '~Val(IS:1)~')'
    'Ok?'             ;a:1..a:fac;SI;;; 30;CHECK ;
    'Mercado'         ;b:1..b:fac;NO;;; 60;STRING;;RGB(220,220,193)
    'Cliente'         ;d:1..d:fac;NO;;;130;STRING;;RGB(220,220,193)
    'Nr Trans'        ;e:1..e:fac;NO;;; 70;STRING;;RGB(220,220,193)
    'F.Pago'          ;f:1..f:fac;NO;;; 70;STRING;;RGB(220,220,193)
    'Titulo'          ;g:1..g:fac;NO;;; 60;STRING;;RGB(220,220,193)
    'Saldo'           ;k:1..k:fac;NO;;;100;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    '%'               ;l:1..l:fac;NO;;; 80;NUMERO;'###,###.#####';RGB(220,220,193)
    'Total'           ;m:1..m:fac;NO;;;100;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'Moneda'          ;n:1..n:fac;NO;;; 60;STRING;;RGB(220,220,193)
    'Pre.Fracc.'      ;o:1..o:fac;NO;;; 60;NUMERO;'###,###.#####';RGB(220,220,193)
    'Tot.Fracc.'      ;p:1..p:fac;NO;;;100 ;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'Cta.Especie'     ;q:1..q:fac;NO;;;100;STRING;;RGB(220,220,193)
    'Cta.Moneda'      ;r:1..r:fac;NO;Val(A:FLB)=0 o Incluido(Val(R:FLB), SQLSet(" Select Codigo From "~DBO~".CUENTAS Where Cliente='"~Val(C:FLB)~"' AND Estado='HAB' AND (Especies LIKE '%"~Val(N:FLB)~"%' OR Especies LIKE '%MONEDA%')"));'Cuenta Moneda Invalida';100;TABLA;'CUENTAS';'Codigo';'Codigo; Nombre';" Cliente = '"~Val(C:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','VIS') AND (Especies Like '%MONEDA%' or Especies Like '%"~Val(N:FLB)~"%')";RGB(255,255,193);
    'Custodio'        ;s:1..s:fac;NO;Not Eqstr(Val(d:FLB),Val(vh:1)) o Val(a:FLB)=0 o Eqstr(SQL(" SELECT Codigo from "~DBO~".CLIENTES WHERE EsDepositante='SI' AND Status = 'HAB' AND Codigo <> 'CAJA' AND Codigo='"~Val(S:FLB)~"' "), Val(S:FLB));'Custodio Invalido';80;TABLA ;'CLIENTES';'Codigo';'Codigo;RazonSocial';" EsDepositante='SI' AND Status = 'HAB' and Codigo<>'CAJA' ";RGB(255,255,193);;
* FJL 18/12/21 - Se Traen datos Comisiones
    'Total Moneda'    ;ad:1..ad:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'Comision'        ;ae:1..ae:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'IVA'             ;af:1..af:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 25/8/22 - Se agrgan Comisiones CV
    'Comision CV'     ;ah:1..ah:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
    'IVA Com CV'      ;ai:1..ai:fac;NO;;;80;NUMERO;'#,###,###,###.##';RGB(220,220,193)
** FJL 26/8/22 - Se agrga Estado
    'Estado'          ;ak:1..ak:fac;NO;;;100;STRING;;RGB(220,220,193)
  FinListBox

  If NOT OK
    Cancelar('Confirmacion de Pago de Dividendos Cancelada')
  Endif

  Recorrer&i 1,fac 
    If Val(a:&i)=1
      Message('Confirmando Transaccion '~Val(e:&i)~'...')
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("   Set Cuenta2  = '"~Val(r:&i)~"',  ")
      SQL.ADD("       Cliente2 = '"~Val(s:&i)~"', ")
      SQL.ADD("       Fecha3= '"~IdxDate(FSys)~"', ")
      SQL.ADD("       RB2 = '1' ")
      SQL.ADD(" Where NrTrans = '"~Val(e:&i)~"'")
      SQL.NEW
      SQL.EXEC
      SQL.ActualizarMovimientosT2(Val(e:&i),SI,NO,NO,NO)
      SQL.EXEC
*-------------------
      #ifdef BIND
*        SQL.ADD("SELECT NrOperacion, SUM(Cantidad) Cantidad, Cliente, Especie, Cuenta, Mercado ")
        SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, SUM(Cantidad) Cantidad, SUM(Comision) Comision, SUM(Iva) Iva ")
        SQL.ADD(" FROM ( ")        
            SQL.ADD("SELECT NrOperacion, Cliente, Especie, Cuenta, Mercado, ")
            SQL.ADD("CASE WHEN M.NrGrupo=2 Then Sum(Cantidad) ELSE 0 End Cantidad, ")
            SQL.ADD("CASE WHEN M.NrGrupo in(41,51) Then Sum(Abs(Cantidad)) ELSE 0 End Comision, ")
            SQL.ADD("CASE WHEN M.NrGrupo in(42,52) Then Sum(Abs(Cantidad)) ELSE 0 End Iva ")
            SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M ")
            SQL.ADD(" WHERE NrOperacion='"~Val(e:&i)~"' ")
            SQL.ADD("   AND "~DBO~".DesciendeDeEspecie(M.Especie,'MONEDA') = 1 ")
            SQL.ADD("   AND Mercado='"~VAR('MERCADOBT')~"' ")
            SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado, NrGrupo ")
        SQL.ADD(" ) ACCIONES ")        
        SQL.ADD(" GROUP BY NrOperacion, Cliente, Especie, Cuenta, Mercado ")        
        watch(SQL.BATCH())   
     
        Recorrer SQL
          (.'PAGOACCION'.)
        Proximo
      #endif        
      * FJL 03/11/2021 Saco los pagos de Posiciones
      IF NO   
      *---------------------------
      ***---Confirmo las PDIVID de Posiciones
      SQL.ADD(" Select DISTINCT T.NrTrans ")
      SQL.ADD(" From  "~DBO~".TRANSACCIONES2 T ")
      SQL.ADD(" Where 'PDIVID'  = T.TipoTr2 ")
      SQL.ADD("  and  T.Especie = '"~Dialogo.Especie1~"' ")
      SQL.ADD("  and  T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and  T.Fecha2 = '"~IdxDate(Dialogo.Fecha2)~"' ")
      SQL.ADD("  and T.RB2 = 0 ")
      SQL.ADD("  and T.RB1 = 0 ")
      SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
      If NoVacio(Dialogo.Mercado1) 
        SQL.ADD(" AND T.Mercado1 = '"~Dialogo.Mercado1~"' ")
      Endif
      watch(SQL.BATCH())   
        
      Recorrer SQL
        SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 ")
        SQL.ADD(" Set RB2 = '1', ")
        SQL.ADD("  Fecha3 = '"~IdxDate(FSys)~"' ")
        SQL.ADD(" Where NrTrans = '"~fbn('NrTrans')~"'")
        SQL.NEW
        SQL.EXEC
            
* FJL 08/04/22 - No actualizaba Movimientos 
*                La transaccion PDIVID No tiene Movimientos de Posicion
*            SQL.ActualizarMovimientosT2(fbn('NrTrans'),NO,NO,NO,SI)
        SQL.ActualizarMovimientosT2(fbn('NrTrans'),SI,NO,NO,NO)
        SQL.EXEC

      Proximo
      ENDIF    
    Endif
  Proximo

  if Val(z:10)>0
    recorrer&i 1,Val(z:10)
      SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
      SQL.ADD("   Set Cuenta2  = '"~Val(br:&i)~"',  ")
      SQL.ADD("       Cliente2 = '"~Val(bs:&i)~"', ")
      SQL.ADD("       Fecha3= '"~IdxDate(FSys)~"', ")
      SQL.ADD("       RB2 = '1' ")
      SQL.ADD(" where NrTrans = '"~Val(bf:&i)~"' ")
      SQL.NEW
      SQL.EXEC
           
      SQL.ActualizarMovimientosT2(Val(bf:&i),SI,NO,NO,NO)
      SQL.EXEC
*      messageBox('Transaccion: '~Val(bf:&i)~' Especie: '~Val(bd:&i)~' confirmada.')
    Proximo
  EndIf
endif
