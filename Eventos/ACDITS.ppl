** FJL 15/11/20 - Por Issue 4523 para mantener actualziado el Utilizado de Termsheert
** Este Utilizado varia por alta de CONU + Vto de CONU + Precancelacion de CONU
** Solo el alta lo actualiza automaticamente.
CrearDialogo
  Fecha1: 'Fecha'  ; ; ; ;  ;  ;;;;;Habiles(FSys,1,'ARG',SI)
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(1)
ACT(a:FAC, 'Codigo')
ACT(b:FAC, 'Descripcion')
ACT(c:FAC, 'FechaINgreso')
ACT(d:FAC, 'Monto')
ACT(e:FAC, 'Utilizado')
ACT(f:FAC, 'Cant.CONU')
ACT(g:FAC, 'Suma CONU')
SetFont(a:FAC..g:FAC, 2)

ACT(aa:FAC, 'NrOperacion')
ACT(ab:FAC, 'Termsheet')
ACT(ac:FAC, 'FechaOp')
ACT(ad:FAC, 'Evergreen')
ACT(ae:FAC, 'FechaVto')
ACT(af:FAC, 'FechaPrecan')
ACT(ag:FAC, 'Cantidad')
ACT(ah:FAC, 'Suma')
SetFont(aa:FAC..ah:FAC, 2)
ACN(x:1, 1)

SQL.ADD(" Select * ")
SQL.ADD(" from "~DBO~".ICLTERMSHEET ")
SQL.ADD(" Order by Codigo ")
watch(SQL.Batch)
recorrer SQL
  ACT(a:FAC, fbn('Codigo'))
  ACT(b:FAC, fbn('Descripcion'))
  ACD(c:FAC, fbn('FIngreso'))
  ACN(d:FAC, fbn('Monto'))
  ACN(e:FAC, fbn('Utilizado'))
  SQL.ADD("Select NrOperacion,Termsheet,FechaOp,CB1,FechaVto,FechaPrecan,Cantidad ")
  SQL.ADD("  from "~DBO~".OPERACIONES ")
  SQL.ADD(" where TipoOp = 'CONU' ")
  SQL.ADD("   and Termsheet = '"~Val(a:FAC)~"' ")
  SQL.ADD("   and FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" Order by NrOperacion ")
  recorrer SQL
    DFA
    SCN(f:FAC, 1)
    SCN(x:1, 1)
    ACT(aa:Val(x:1), fbn('NrOperacion'))
    ACT(ab:Val(x:1), fbn('TermSheet'))
    ACD(ac:Val(x:1), fbn('FechaOp'))
    ACN(ad:Val(x:1), fbn('CB1'))
    ACD(ae:Val(x:1), fbn('FechaVto'))
    ACD(af:Val(x:1), fbn('FechaPrecan'))
    ACN(ag:Val(x:1), fbn('Cantidad'))
    if fbn('FechaPrecan')>0
      if fbn('FechaPrecan')>=Dialogo.Fecha1
        SCN(ah:Val(x:1), fbn('Cantidad'))
      endif
    else
      if fbn('CB1')=1 or fbn('FechaVto')>Dialogo.Fecha1
        SCN(ah:Val(x:1), fbn('Cantidad'))
      endif
    endif
    SCN(g:FAC, Val(ah:Val(x:1)))
    SetFont(aa:Val(x:1)..ah:Val(x:1), 1)
  Proximo
  if Dialogo.Check1=1
    SQL.ADD("Update "~DBO~".ICLTERMSHEET  ")
    SQL.ADD("   Set Utilizado = "~FStr(Val(g:FAC),0,2)~"  ")
    SQL.ADD(" where Codigo    = '"~Val(a:FAC)~"' ")
    SQL.NEW      
    SQL.EXEC
  endif
  SetFont(a:FAC..g:FAC, 1)
Proximo

ACO(2, 15)
  


