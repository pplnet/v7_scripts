CrearDialogo
  String1 : 'Ruta'         ;1;1;;;;;;;'C:\Users\AGUSTIN\Documents'
  String2 : 'Archivo'      ;2;1;;;;;;;'Fondep FINAL CPD_FPA.xlsx'
FinDialogo

if Not Ok
  Cancelar
endif

If EqStr(Copy(Dialogo.String1,Longitud(Dialogo.String1),1),'\')
   ACT(x:1, Dialogo.String1~Dialogo.String2)
Else
   ACT(x:1, Dialogo.String1~'\'~Dialogo.String2)
EndIf

*Ruta: "C:\Users\AGUSTIN\Documents\Fondep FINAL CPD_FPA.xlsx"

ImportarXLS(a:6..at:80, a:1..at:75, Val(x:1))

If Not Ok
  Cancelar('Error al cargar el archivo '~Dialogo.String1)
EndIf

SQL.ADD("DELETE FROM "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp = 'DTODO2'")
SQL.NEW
SQL.EXEC

Recorrer&i 1,75
   ****CARGAR LOS DATOS DEL EXCEL A LAS CELDAS DEL EVENTO****
   *Tasa Aux 1
   ACN(TA:1, Val(A:&i))
   *Observac Doc 
   ACT(OD:1, Val(B:&i))
   *Especie
   IF Eqstr('$', Mirt(Val(C:&i)))
        *MONELOCA y MONEEXTR
       ACT(ES:1, Var('MONELOCA'))
   ELSE
       ACT(ES:1, Var('MONEEXTR'))
   ENDIF 
   *RB1
   IF Eqstr('C', Val(D:&i))
       ACN(RB:1, 0)
   ELSE
       ACN(RB:1, 1)
   ENDIF
   *Precio1
   ACN(PR:1, Val(E:&i))
   *Cliente1
   ACT(CL:1, BuscarCampo('CLIENTES','Codigo','Valor10',Val(F:&i)))
   *FechaOp
   ACD(FO:1, Val(H:&i))
   *FechaVto
   ACD(FV:1, Val(I:&i))
   *Tasa Aux 2
   ACN(TA:2, Val(J:&i))
   *Tasa Aux 3
   ACN(TA:3, Val(K:&i))
   *Cliente2
   IF Val(L:&i) > 0
       ACT(CL:2, BuscarCampo('CLIENTES','Codigo','Valor10',Val(L:&i)))
   ELSE
       BorrarCeldas(CL:2..CL:2)
   ENDIF
   *Tasa Aux 4
   ACN(TA:4, Val(N:&i))
   *FechaPago
   ACD(FP:1, Val(O:&i))
   *Total Neto Cli 1
   ACN(TN:1, Val(P:&i))
   *Total Intereses
   ACN(TI:1, Val(Q:&i))
   *Total Derechos
   ACN(TD:1, Val(R:&i))
   *Alias5
   ACT(VH:1, BuscarCampo('VEHICULOS','Codigo','Alias5',Val(T:&i)))
   *MensajeChequeo
   ACT(MC:1, Val(Y:&i))
   *ContraEspecie
   IF Eqstr('$', Val(Z:&i))
       ACT(CE:1, Var('MONELOCA'))
   ELSE
       ACT(CE:1, Var('MONEEXTR'))
   ENDIF 
   *TipoCambio
   ACN(TC:1, Val(AA:&i))
   *RB2
   IF Eqstr('NO', Val(AC:&i))
      ACN(RB:2, 0)
   ELSE
      ACN(RB:2, 1)
   ENDIF
   *FechaVto2
   ACD(FV:2, Val(AD:&i))
   *Plazo
   ACD(PZ:1, Val(FV:2)-Val(FO:1))
   *Sucursal
   *Ingresar AE
   ACT(SC:1, Val(AE:&i))
   *RB3
   IF Eqstr('NO', Val(AF:&i))
       ACN(RB:3, 0)
   ELSE
       ACN(RB:3, 1)
   ENDIF
   *RB4
   IF Eqstr('NO', Val(AG:&i))
       ACN(RB:4, 0)
   ELSE
       ACN(RB:4, 1)
   ENDIF
   *Numerador
   *ACT(NR:1, BuscarCampo('NUMERADORES','Codigo','Codigo',7))
   ACT(NR:1, "7")
   *NumeroOP
   ACT(NO:1,GetNumerador(7))
   *TotalIntereses
   ACN(TI:1, Val(Q:&i))
   *Total Neto Cli 2
   ACN(TN:2, Val(AT:&i))
   *Plazo2
   ACD(PZ:2, Val(FV:1)-Val(FO:1))
   *Capital/Cantidad
   ACN(CA:1, Val(AP:&i))
   
   
   *TipoOp = 'DTODO2'
   ****YA TENGO LISTOS TODOS LOS DATOS QUE NECESITO CARGAR EN LA BASE DE DATOS. AHORA VOY A IMPORTARLOS A LA MISMA****
   *SQL.ADD("Insert Into"~DBO~".OPERACIONES (NrOperacion, TotalAux1, ObservacDoc, Especie, RB1, Precio1, Cliente1, FechaOp, FechaVto, TotalAux2, TotalAux3, Cliente2, TotalAux4, FechaPago, TotalNetoCli1, TotalIntereses, TotalDerechos, Vehiculo1, MensajeChequeo, ContraEspecie, TipoCambio, RB2, FechaVto2, Plazo, NrSucursal, RB3, RB4)")
   *SQL.ADD("VALUES ('"~GetNumerador(7)~"', '"~Val(TA:1)~"','"~Val(OD:1)~"','"~Val(ES:1)~"','"~Val(RB:1)~"','"~Val(PR:1)~"','"~Val(CL:1)~"','"~Val(FO:1)~"','"~Val(FV:1)~"','"~Val(TA:2)~"','"~Val(TA:3)~"','"~Val(CL:1)~"','"~Val(TA:4)~"','"~Val(FP:1)~"','"~Val(TN:1)~"','"~Val(TI:1)~"','"~Val(TD:1)~"','"~Val(AL:1)~"','"~Val(MC:1)~"','"~Val(CE:1)~"','"~Val(TC:1)~"','"~Val(RB:2)~"','"~Val(FV:2)~"','"~Val(PZ:1)~"','"~Val(SC:1)~"','"~Val(RB:3)~"','"~Val(RB:4)~"')")
   
   ***---Numerador
   *FechaCargaSys = Fsys
   *FechaCarga = Formato fecha y Hora. funcion SQLAhora. "~SQLAhora~"
   *'"~IdxDate(FSys)~"', "~SQLAhora~",
   *Operador = USUARIOACTIVO
   
   ***---OPERACIONESBITS. registros para todas las instancias que intervienen en el workflow, con Valor = 0. Y valor = 1 para la instancia donde debe aparecer. Instancia1
*    1;1
*    5;0
*    10;0
*    11;0
*    15;0
*    19;0
*    20;0
*    50;0
*   
   
   SQL.ADD("Insert Into "~DBO~".OPERACIONES ")
   SQL.ADD("(NrOperacion, TotalAux1, ObservacDoc, Especie, ")
   SQL.ADD(" RB1, Precio1, Cliente1, FechaOp, ")
   SQL.ADD(" FechaVto, TotalAux2, TotalAux3, Cliente2, ")
   SQL.ADD("TotalAux4, FechaPago, TotalNetoCli1, TotalIntereses, ")
   SQL.ADD("TotalDerechos, Vehiculo1, MensajeChequeo, ContraEspecie, ")
   SQL.ADD("TipoCambio, RB2, FechaVto2, Plazo, ")
   SQL.ADD("NrSucursal, RB3, RB4, TipoOp,")
   SQL.ADD("Numerador, FechaCargaSys, FechaCarga, Operador,")
   SQL.ADD("TotalIVA, TotalNetoCli2, Plazo2, Cantidad)")
   SQL.ADD("VALUES (")
   SQL.ADD("'"~Val(NO:1)~"',"~Fstr(Val(TA:1), 0, 2)~",'"~Val(OD:1)~"','"~Val(ES:1)~"',")
   SQL.ADD(""~Fstr(Val(RB:1), 0, 0)~","~Fstr(Val(PR:1), 0, 8)~",'"~Val(CL:1)~"','"~IdxDate(Val(FO:1))~"' ,")
   SQL.ADD("'"~IdxDate(Val(FV:1))~"',"~Fstr(Val(TA:2), 0, 2)~","~Fstr(Val(TA:3), 0, 2)~",'"~Val(CL:2)~"',")
   SQL.ADD(""~Fstr(Val(TA:4),0, 2)~",'"~IdxDate(Val(FP:1))~"',"~Fstr(Val(TN:1), 0, 2)~","~Val(TI:1)~",")
   SQL.ADD(""~Fstr(Val(TD:1), 0, 2)~",'"~Val(VH:1)~"','"~Val(MC:1)~"','"~Val(CE:1)~"',")
   SQL.ADD(""~Fstr(Val(TC:1), 0, 2)~","~Fstr(Val(RB:2), 0, 0)~",'"~IdxDate(Val(FV:2))~"',"~Fstr(Val(PZ:1), 0, 0)~",")
   SQL.ADD(""~Fstr(Val(SC:1), 0, 0)~","~Fstr(Val(RB:3), 0, 0)~","~Fstr(Val(RB:4), 0, 0)~", 'DTODO2',")
   SQL.ADD(""~Val(NR:1)~",'"~IdxDate(FSys)~"', "~SQLAhora~", '"~UsuarioActivo~"',")
   SQL.ADD(""~Fstr(Val(TI:2), 0, 2)~", "~Fstr(Val(TN:2), 0, 2)~", "~Fstr(Val(PZ:2),0,0)~", "~Fstr(Val(CA:1), 0, 2)~")")
   SQL.NEW
   SQL.EXEC
   
   EjecutarEvento('INSBIT', String1 = 'OPERACIONES', Entero1 = 1, NrOperacion1 = Val(NO:1))
   
