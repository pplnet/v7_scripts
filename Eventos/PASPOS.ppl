*** FJL 16/12/19 - evita la ejecucion  para no confundir con evento TRAPOS de BBYMA
Cancelar('No usar - Evento viejo')
HojaVisible(NO)
CrearDialogo
  Fecha1   : 'Op Desde'    ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha Operacion Desde no debe ser superior a la Fecha del Sistema';NO;FSys
  Fecha2   : 'Op Hasta'    ;;;;;;Dialogo.Fecha2<=Fsys and Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha Operacion Hasta no debe ser inferior a la Fecha Desde';NO;FSys
  Vehiculo1: 'Vehiculo'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Indicar un Vehiculo';NO;VAR('VEHICULODE')
  Radio1   : 'Posicion|Todas|Trading|In<=6m|Inv>6m|OtrasSoc' ;;;;;;;;;0
  Radio2   : 'TipoOp  |Todas|ExtraBurs|Burs|Cust|CoPri';;;;;;;;;0
  Especie1 : 'Especie'  ;;;;;;;;;
FinDialogo

If not Ok
   Cancelar
Endif

act(av1, Dialogo.Vehiculo1)

If Dialogo.Radio2<>3
   *- Selecciono todas las operaciones con fecha del dia que no tengan asociadas partidas
   *- CBC y PABC No Afectan Posiciones ya que no se liquida la especie
    
   *- Condiciones Globales 
   act(cg1,' ')
   If Dialogo.Radio2 = 1
      *- ExtraBursatil
      act(cg1," and TipoOp  In ('TIPP','TIPA','TIC','TIV','TIFV','TIFC','TCC','TCP','TVC','TVP','TIBCRA') ")
   EndIf
   If Dialogo.Radio2 = 2
      *- Bursatil
      act(cg1,val(cg1)~" and TipoOp  In ('CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP') ")
   EndIf
   If Dialogo.Radio2 = 4
      *- Colocacion Primaria
      act(cg1," and TipoOp  In ('TCOPRI') and C.Alias1='CP' ")
   EndIf
   If NoVacio(Dialogo.Especie1)
      act(cg1,val(cg1)~" and Especie='"~Dialogo.Especie1~"' ")
   EndIf
   
   *- OPERACIONES DE TRADING (Cartera=0 o (Cartera=-1 y CanPosTrad>0))
   If Dialogo.Radio1=0 o Dialogo.Radio1=1  
      SQL.ADD(" Select NrOperacion,FechaOp,FechaVto,Especie,CanPosTrad as Cantidad,TipoOp,Cliente1,0 as Cartera, ContraEspecie, Precio1, TotalBrutoCli1, TotalNetoCli1 ")
      SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C  Where  Vehiculo1='"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" and O.Cliente1=C.Codigo ")
      SQL.ADD(" and FechaOp  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'   ")
      SQL.ADD(" and TipoOp  In ('TCOPRI','TIPP','TIPA','TIC','TIV','TIFV','TIFC','TCC','TCP','TVC','TVP','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP','TIBCRA') ")
      SQL.ADD(" and ((TipoOp In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP') and PaseCB='0') or TipoOp Not In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and ((TipoOp In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP') and C.Alias1='CP') or TipoOp Not In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and (Cartera=0 or ")
      SQL.ADD("      (Cartera = -1 and CanPosTrad>0) ")
      SQL.ADD("     )")
      If Not EqStr(val(cg1),' ')
         SQL.ADD(" "~val(cg1)~" ")
      EndIf
      SQL.ADD(" and NrOperacion Not In  ")
      SQL.ADD(" (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   EndIf

   *- OPERACIONES DE INVESTMENT <= 6  (Cartera=1 o (Cartera=-1 y CanPosInv1>0))
   If Dialogo.Radio1=0 o Dialogo.Radio1=2  
      If Dialogo.Radio1=0 
         SQL.ADD(" Union All ")
      EndIf
      SQL.ADD(" Select NrOperacion,FechaOp,FechaVto,Especie,CanPosInv1 as Cantidad,TipoOp,Cliente1,1 as Cartera, ContraEspecie, Precio1, TotalBrutoCli1, TotalNetoCli1 ")
      SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C  Where  Vehiculo1='"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" and O.Cliente1=C.Codigo ")
      SQL.ADD(" and FechaOp  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'   ")
      SQL.ADD(" and TipoOp  In ('TCOPRI','TIPP','TIPA','TIC','TIV','TIFV','TIFC','TCC','TCP','TVC','TVP','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP','TIBCRA') ")
      SQL.ADD(" and ((TipoOp In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP') and PaseCB='0') or TipoOp Not In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and ((TipoOp In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP') and C.Alias1='CP') or TipoOp Not In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and (Cartera=1 or ")
      SQL.ADD("      (Cartera = -1 and CanPosInv1>0) ")
      SQL.ADD("     )")
      If Not EqStr(val(cg1),' ')
         SQL.ADD(" "~val(cg1)~" ")
      EndIf
      SQL.ADD(" and NrOperacion Not In  ")
      SQL.ADD(" (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   EndIf

   *- OPERACIONES DE INVESTMENT > 6  (Cartera=1 o (Cartera=-1 y CanPosInv2>0))
   If Dialogo.Radio1=0 o Dialogo.Radio1=3
      If Dialogo.Radio1=0 
         SQL.ADD(" Union All ")
      EndIf
      SQL.ADD(" Select NrOperacion,FechaOp,FechaVto,Especie,CanPosInv2 as Cantidad,TipoOp,Cliente1,2 as Cartera, ContraEspecie, Precio1, TotalBrutoCli1, TotalNetoCli1 ")
      SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C  Where  Vehiculo1='"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" and O.Cliente1=C.Codigo ")
      SQL.ADD(" and FechaOp  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'   ")
      SQL.ADD(" and TipoOp  In ('TCOPRI','TIPP','TIPA','TIC','TIV','TIFV','TIFC','TCC','TCP','TVC','TVP','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP','TIBCRA') ")
      SQL.ADD(" and ((TipoOp In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP') and PaseCB='0') or TipoOp Not In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and ((TipoOp In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP') and C.Alias1='CP') or TipoOp Not In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and (Cartera=2 or ")
      SQL.ADD("      (Cartera = -1 and CanPosInv2>0) ")
      SQL.ADD("     )")
      If Not EqStr(val(cg1),' ')
         SQL.ADD(" "~val(cg1)~" ")
      EndIf
      SQL.ADD(" and NrOperacion Not In  ")
      SQL.ADD(" (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   EndIf

   *- OPERACIONES DE OTRAS SOCIEDADES  (Cartera=1 o (Cartera=-1 y CanPosOSoc>0))
   If Dialogo.Radio1=0 o Dialogo.Radio1=4
      If Dialogo.Radio1=0 
         SQL.ADD(" Union All ")
      EndIf
      SQL.ADD(" Select NrOperacion,FechaOp,FechaVto,Especie,CanPosOSoc as Cantidad,TipoOp,Cliente1,3 as Cartera, ContraEspecie, Precio1, TotalBrutoCli1, TotalNetoCli1 ")
      SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C  Where  Vehiculo1='"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" and O.Cliente1=C.Codigo ")
      SQL.ADD(" and FechaOp  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'   ")
      SQL.ADD(" and TipoOp  In ('TCOPRI','TIPP','TIPA','TIC','TIV','TIFV','TIFC','TCC','TCP','TVC','TVP','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP','TIBCRA') ")
      SQL.ADD(" and ((TipoOp In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP') and PaseCB='0') or TipoOp Not In ('TIC','TIV','TIFV','TIFC','CTP','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and ((TipoOp In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP') and C.Alias1='CP') or TipoOp Not In ('TCOPRI','CBT','PABT','CTP','CTC','VTC','VTP','CFTP','VFTP')) ") 
      SQL.ADD(" and (Cartera=3 or ")
      SQL.ADD("      (Cartera = -1 and CanPosOSoc>0) ")
      SQL.ADD("     )")
      If Not EqStr(val(cg1),' ')
         SQL.ADD(" "~val(cg1)~" ")
      EndIf
      SQL.ADD(" and NrOperacion Not In  ")
      SQL.ADD(" (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   EndIf
EndIf
If Dialogo.Radio2=0
   SQL.ADD(" Union All ")
EndIf
If Dialogo.Radio2=0 o Dialogo.Radio2=3
   SQL.ADD(" Select NrTrans as NrOperacion,T.Fecha1 as FechaOp,CASE T.Fecha3 When Null Then T.Fecha1 Else T.Fecha3 End FechaVto,Especie,Cantidad1 as Cantidad,TipoTr2 as TipoOp,Cliente1,RB4 as Cartera, '' as ContraEspecie, Precio1, Cambio4 as TotalBrutoCli1, 0  ")
   SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C  Where  Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" and T.Cliente1=C.Codigo ")
   SQL.ADD(" and T.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  ")
   SQL.ADD(" and TipoTr2 In ('DTP','RTP') and C.Alias1='CP' ")
   If Dialogo.Radio1<>0
      *- Tipo de Cartera
      SQL.ADD(" and RB4="~Fstr(Dialogo.Radio1-1,0,0)~" ")
   EndIf
   SQL.ADD(" and NrTrans Not In  ")
   SQL.ADD(" (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
EndIf
SQL.ADD(" Order By 1")

Recorrer SQL
   *--- Solo puedo pasar posiciones para las operaciones con 
   *--- los movimientos ejecutados de especie.
   acn(zz1,0)

   act(a:fac, fbn('NrOperacion'))
   acd(b:fac, fbn('FechaVto'))
   acd(m:fac, fbn('FechaOp'))
   act(c:fac, fbn('Especie'))
   acn(d:fac, fbn('Cantidad'))
   act(e:fac, fbn('ContraEspecie'))
   IF fbn('TotalBrutoCli1') <> 0
      acn(f:fac, fbn('TotalBrutoCli1'))    
   ELSE
      acn(f:fac, fbn('TotalNetoCli1'))    
   ENDIF
   act(g:fac, fbn('Cliente1'))
   act(h:fac, fbn('TipoOp'))
   acn(i:fac, Num(fbn('Cartera')))
   
   acn(k:fac, fbn('Precio1'))
   
   IF Val(i:fac) = 0
      ACT(t:fac, 'Trading')
   ENDIF
   IF Val(i:fac) = 1
      ACT(t:fac, 'In<=6m')
   ENDIF
   IF Val(i:fac) = 2
      ACT(t:fac, 'Inv>6m')
   ENDIF
   IF Val(i:fac) = 3
      ACT(t:fac, 'OtrasSoc')
   ENDIF
   
   FormatoCeldas(k:fac..k:fac, EXE('F7'))
   acn(j:fac, 0)
   acn(l:fac, 0)
   scn(x1,1)
Proximo

If Val(x1) > 0
     
   CrearListBox ; 'Arial,8,'
     'Pasar'         ;l1..l:FAC;SI;;;5;CHECK
     'Nro.Op.'       ;a1..a:FAC;NO;;;60;STRING
     'FechaVto'      ;b1..b:FAC;NO;;;60;FECHA
     'FechaOp'       ;m1..m:FAC;NO;;;60;FECHA
     'Especie'       ;c1..c:FAC;NO;;;48;TABLA;'Especies';'Codigo';'Codigo;Nombre';
     'Precio'        ;k1..k:FAC;NO;;;64;NUMERO;'##,###,###.########'
     'Cantidad'      ;d1..d:FAC;NO;;;80;NUMERO;'##,###,###.##'
     'ContraEsp'     ;e1..e:FAC;NO;;;48;TABLA;'Especies';'Codigo';'Codigo;Nombre';
     'Monto'         ;f1..f:FAC;NO;;;80;NUMERO;'##,###,###.##'
     'Cliente'       ;g1..g:FAC;NO;;;70;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';
     'TipoOp.'       ;h1..h:FAC;NO;;;45;STRING
     'Cartera'       ;t1..t:FAC;NO;;;60;STRING
     ***'Pasar A'    ;j1..j:FAC;Val(l:FLB)=1;val(l:FLB)=0 o val(j:FLB)<>val(i:FLB);'Cartera Destino INCORRECTA';70;COMBO;'Trading|In<=6m|Inv>6m|OtrasSoc|';RGB(57,198,194)
     ***'Cartera'    ;i1..i:FAC;NO;;;70;COMBO;'Trading|In<=6m|Inv>6m|OtrasSoc|'
   FinListBox
   
   If Not Ok 
      Cancelar
   Endif
   
   If Ok 
      
      Recorrer&i 1,fac
         
         If Val(l:&i)=1
             
            BorrarCeldas(aa1..ab3)
            acn(aa1,val(d:&i))
            acn(aa2,0)
            acn(aa3,0)
            acn(aa4,0)      
         
            acn(ab1,val(i:&i))
            acn(ab2,0)
            acn(ab3,0)
            acn(ab4,0)

            
            if Incluido(Val(h:&i),'DTP|RTP')
                 ACN(ab5,1)
            else 
                 ACN(ab5,4)
            endif
                 
            *- Para cada linea seleccionada despliego otra pantalla para hacer la distribucion
            *-- Hay datos para mostrar
            CrearDialogo
                 NrOperacion1 : "Nr.Oper"      ;1;1;;NO;;;;;Val(a:&i)
                 Fecha1       : "FechaVto"     ;1;2;;NO;;;;;Val(b:&i)
                 Fecha2       : "FechaOp"      ; ;2;;NO;;;;;Val(m:&i)
                 Especie1     : "Especie"      ;2;1;;NO;;;;;Val(c:&i)
                 Cantidad1    : "Cantidad"     ;3;1;;NO;;;;;Val(d:&i)
                 Precio1      : "Precio"       ; ;1;;NO;;;;;Val(k:&i)
                 Cantidad2    : "Monto"        ; ;1;;NO;;;;;Val(f:&i)
                 Especie2     : "ContraEsp"    ;3;2;;NO;;;;;Val(e:&i)
                 Cliente1     : "Cliente"      ; ;2;;NO;;;;;Val(g:&i)
                 TipoOp2      : "Tipo Oper"    ; ;2;;NO;;;;;Val(h:&i)
                 String1      : "Cartera"      ;6;1;;NO;;;;;Val(t:&i)
                 ListBox; 'Arial,8,N'; 200; 140
                     'Cantidad'      ;aa1..aa:Val(ab5);;val(aa:FLB)>=0 y val(aa:FLB)<=Val(d:&i);'Cantidad a Pasar INCORRECTA';;80;NUMERO;'##,###,###.##'                 
                     'Pasar A'       ;ab1..ab:Val(ab5);SI;;;;70;COMBO;'Trading|In<=6m|Inv>6m|OtrasSoc|'
                 FinListBox  
            FinDialogo
              
            IF Not OK
               Cancelar
            EndIf
              
            If Ok 
                  
               acn(sm1,0)
               acn(sm2,0)
                
               *- Chequeo sumatoria de montos a pasar               
               Recorrer&j 1,Val(ab5)
                  scn(sm1,val(aa:&j))
                      
                  If val(aa:&j)<>0
                     scn(sm2,1)
                  EndIf
               Proximo
                  
               *- Chequeo consistencia de pasaje
               acn(cc1,0)
                  
               If val(sm1)<>val(d:&i)
                  MessageBox('Los Montos a Distribuir no coinciden con la Cantidad de la Operacion '~Val(a:&i)~' !!!')
                  acn(cc1,1)
               EndIf
               If val(cc1)=0 y val(sm2)>1 y Incluido(val(h:&i),'DTP|RTP|')                
                  MessageBox('Las Transacciones DTP y RTP aceptan solamente un Tipo de Cartera !!!')
                  acn(cc1,1)                                 
               EndIf
                  
               If val(cc1)=0 
                  *- Chequeo correcto
                  ACN(ia6, 1 )
                      
                  Recorrer&j 1,Val(ab5)
                     *- Monto Final inicializado en Positivo
                          
                     *- Verifico para las Carteras de Investment que no quede abajo la posicion
                     If Val(i:&i)=1 o Val(i:&i)=2  
                        If Incluido(val(h:&i),'DTP|TIC|TIFC|CTP|CFTP|CTP|CTC|TCOPRI')                
                           *- Sale de Investment y es Compra
                           ACN(ia6,Val(i:&i)+2+101 )
                           If Incluido(val(h:&i),'TIFC|CFTP|')                
                              SCN(ia6,10)
                           EndIf
                           ACN(ia1,-Val(aa:&j))
                           ACT(ia2, Val(c:&i))
                           ACD(ia3, Val(m:&i))
                           ACT(ia4, Val(av1))
                           ACT(ia5, Val(a:&i))
                           ACN(ia7, 0 )
                           (.'CTRLINVEST'.)                                   
                        EndIf
                     EndIf
                           
                     If Val(ab:&j)=1 o Val(ab:&j)=2  
                        If Not Incluido(val(h:&i),'DTP|TIC|TIFC|CTP|CFTP|CTP|CTC|TCOPRI')                
                           *- Entra a Investment  y es Venta
                           ACN(ia6,Val(ab:&j)+2+101 )
                           If Incluido(val(h:&i),'TIFV|VFTP|')                
                              SCN(ia6,10)
                           EndIf
                           ACN(ia1,-Val(aa:&j))
                           ACT(ia2, Val(c:&i))
                           ACD(ia3, Val(m:&i))
                           ACT(ia4, Val(av1))
                           ACT(ia5, Val(a:&i))
                           ACN(ia7, 0 )
                              
                           (.'CTRLINVEST'.)                                   
                        EndIf
                     EndIf
                  Proximo
                        
                  If val(ia6)>=0
                     *- No se queda abajo en Investment
                              
                     IF Not Incluido(val(h:&i),'DTP|RTP|')             



                              *- Blanqueo la distribucion Anterior de Carteras
                              SQL.ADD("Update "~DBO~".OPERACIONES")
                              SQL.ADD("Set Cartera=-1,")
                              If Val(i:&i)=0 
                                 SQL.ADD("CanPosTrad = 0 ")
                              EndIf
                              If Val(i:&i)=1 
                                 SQL.ADD("CanPosInv1 = 0 ")
                              EndIf
                              If Val(i:&i)=2 
                                 SQL.ADD("CanPosInv2 = 0 ")
                              EndIf
                              If Val(i:&i)=3 
                                 SQL.ADD("CanPosOSoc = 0 ")
                              EndIf
                              SQL.ADD("Where NrOperacion =  '"~Val(a:&i)~"'    ")
                              SQL.NEW
                              SQL.EXEC  

                              IF Incluido(val(h:&i),'CBT|PABT|TIPA|TIPP') 
                                 SQL.ADD("Update "~DBO~".OPERACIONES")
                                 SQL.ADD("Set Cartera=-1,")
                                 If Val(i:&i)=0 
                                    SQL.ADD("CanPosTrad = 0 ")
                                 EndIf
                                 If Val(i:&i)=1 
                                    SQL.ADD("CanPosInv1 = 0 ")
                                 EndIf
                                 If Val(i:&i)=2 
                                    SQL.ADD("CanPosInv2 = 0 ")
                                 EndIf
                                 If Val(i:&i)=3 
                                    SQL.ADD("CanPosOSoc = 0 ")
                                 EndIf
                                 SQL.ADD("Where OperacionRef='"~val(a:&i)~"'  ")
                                 SQL.NEW
                                 SQL.EXEC  
                              EndIf

                     EndIf
             
                     Recorrer&j 1,Val(ab5)

                        If val(aa:&j)<>0      
                           Message('Cambiando Cartera '~val(a:&i)~' Monto '~val(aa:&j) )                 

                           IF Not Incluido(val(h:&i),'DTP|RTP|')             
                              SQL.ADD("Update "~DBO~".OPERACIONES")
                              SQL.ADD("Set ")
                              If val(ab:&j)=0 
                                 SQL.ADD("CanPosTrad = CanPosTrad+"~Fstr(val(aa:&j),0,2)~" ")
                              Else 
                                 If val(ab:&j)=1         
                                    SQL.ADD("CanPosInv1 = CanPosInv1+"~Fstr(val(aa:&j),0,2)~"  ")
                                 Else 
                                    If val(ab:&j)=2         
                                       SQL.ADD("CanPosInv2 =  CanPosInv2+"~Fstr(val(aa:&j),0,2)~"  ")
                                    Else 
                                       SQL.ADD("CanPosOSoc =  CanPosOSoc+"~Fstr(val(aa:&j),0,2)~"  ")
                                    EndIf
                                 EndIf
                              EndIf
                              SQL.ADD("Where NrOperacion =  '"~Val(a:&i)~"'    ")
                              SQL.NEW
                              SQL.EXEC               
                   
                              SQL.ActualizarMovimientos2(Val(a:&i),NO,NO,NO,SI)
                              SQL.EXEC               
                   
                              *- Selecciono las operaciones hijas 
                              IF Incluido(val(h:&i),'CBT|PABT|TIPA|TIPP') 

                                 SQL.ADD(" Select NrOperacion From "~DBO~".OPERACIONES WHERE  ")
                                 SQL.ADD(" OperacionRef='"~val(a:&i)~"' Order By 1")

                                 * CanPosTrad=>ab:&j=0 , CanPosInv1=>ab:&j=1 , CanPosInv2=>ab:&j=2 , CanPosOSoc =>ab:&j=3                        
                                 Recorrer SQL
                                    SQL.ADD("Update "~DBO~".OPERACIONES")
                                    SQL.ADD("Set ")
                                    If val(ab:&j)=0 
                                       SQL.ADD("CanPosTrad =  CanPosTrad+"~Fstr(val(aa:&j),0,2)~"  ")
                                    Else 
                                       If val(ab:&j)=1         
                                          SQL.ADD("CanPosInv1 =  CanPosInv1+"~Fstr(val(aa:&j),0,2)~"  ")
                                       Else 
                                          If val(ab:&j)=2         
                                             SQL.ADD("CanPosInv2 =  CanPosInv2+"~Fstr(val(aa:&j),0,2)~" ")
                                          Else 
                                             SQL.ADD("CanPosOSoc =  CanPosOSoc+"~Fstr(val(aa:&j),0,2)~" ")
                                          EndIf
                                       EndIf
                                    EndIf
                                    SQL.ADD("Where NrOperacion =  '"~FBN['NrOperacion']~"'    ")
                                    SQL.NEW
                                    SQL.EXEC
                         
                                    SQL.ActualizarMovimientos2(FBN['NrOperacion'],NO,NO,NO,SI)
                                    SQL.EXEC
                                 Proximo                   
                              EndIf
                           Else 
                              SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
                              SQL.ADD("Set RB4 = "~Fstr(val(ab:&j),0,0)~" ")
                              SQL.ADD("Where NrTrans = '"~Val(a:&i)~"'     ")
                              SQL.NEW
                              SQL.EXEC
                  
                              SQL.ActualizarMovimientosT2(Val(a:&i),NO,NO,NO,SI)
                              SQL.EXEC
                           EndIf
                        EndIf
                     Proximo
                     *- Validacion de Carteras Ok
                  EndIf               


               EndIf
            EndIf               
         EndIf
      Proximo
   Endif 
Else
   MessageBox('No hay operaciones para el dia '~Dialogo.Fecha1)
Endif

