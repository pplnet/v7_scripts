MostrarCuadrodeMensajes
CrearDialogo
  NrOrden1  : 'Orden'        ;;;;;;NoVacio(Dialogo.NrOrden1);'Ingrese Orden';NO;
  Cantidad1 : 'Ejecuciones'  ;;;;;;Dialogo.Cantidad1>0;'Ingrese Cantidad de Ejecuciones';NO;
  Cantidad2 : 'Nominales'    ;;;;;;Dialogo.Cantidad2>0;'Ingrese Cantidad de Nominales';NO;
FinDialogo

If Not Ok 
   Cancelar
Endif

SQL.ADD("SELECT NrOrden, NrOperacion, Fecha, Cantidad, Precio, Cantidad2 ")   
SQL.ADD("  FROM "~DBO~".EJECUCIONES ")   
SQL.ADD("WHERE NrOrden='"~Dialogo.NrOrden1~"'")   
acn(aa:1,0)
Recorrer SQL
    SQL.ADD("DELETE "~DBO~".EJECUCIONES WHERE NrOrden='"~Dialogo.NrOrden1~"'")
    SQL.New
    SQL.EXEC
    
    Recorrer&i 1, Dialogo.Cantidad1
        SCN(aa:1,1)
        Message('Insertando ejecucion '~FSTR(val(aa:1),1,0))
        SQL.ADD("INSERT INTO "~DBO~".EJECUCIONES ( " )
        SQL.ADD("NrOrden, NrEjecucion, NrOperacion, Fecha, ")
        SQL.ADD("Cantidad, Precio, Cantidad2 ")
        SQL.ADD(") VALUES ( ")
        SQL.ADD("'"~FBN['NrOrden']~"',"~FSTR(val(aa:1),1,0)~", '"~FBN['NrOperacion']~"', "~IdxDate2(FBN['Fecha'])~", ")
        SQL.ADD(FSTR(Dialogo.Cantidad2,0,2)~","~FSTR(FBN['Precio'],0,2)~", "~FSTR(Dialogo.Cantidad2*FBN['Precio'],0,2)~")")
        SQL.New
        SQL.EXEC
    Proximo
    SQL.ADD("UPDATE "~DBO~".ORDENES SET Cuotas1="~FSTR(Dialogo.Cantidad1,1,0)~" WHERE NrOrden='"~Dialogo.NrOrden1~"' ")
    SQL.New
    SQL.EXEC

    BREAK
Proximo 

Messagebox("Ejecuciones agregadas")
