CrearDialogo
  Vehiculo1  : "Vehiculo"                 ;;;;;;;;;VAR('VEHICULODE')
  Fecha1     : "Fecha"                    ;;;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Radio1     : "Tipo|Movimientos|Saldos"  ;;;;NO;NO;;;;0
FinDialogo

if Not Ok
  Cancelar
endif


SetFilaActual(3)

* Selecciono los Mov. de Transacciones de Saldos 4 Segun la Periodicidad
* de cobro de Comisiones

SQL.ADD("SELECT DISTINCT M.NrOperacion from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C ")
SQL.ADD("Where M.NrOperacion = T.NrTrans ")
SQL.ADD("and   M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and   T.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("and   T.Cliente1 = C.Codigo ")
SQL.ADD("and   M.NrSaldo = 4 ")
If Dialogo.Radio1=0
   *- Cobro de Comisiones de Movimientos 
   SQL.ADD("and TipoTr2 IN ('DTP','RTP')")
   SQL.ADD("and   (C.FrecuenciaCobro='DIA' ")
   If Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1)
      acn(z1, Mes(Dialogo.Fecha1) Mod(3) )
      If val(z1)=0
         *- Verifico si es FIN de Trimestre
         SQL.ADD(" or C.FrecuenciaCobro='TRI' or C.FrecuenciaCobro ='' or C.FrecuenciaCobro IS Null ")
      EndIf
      *- Selecciono las Diarias y las Mensuales  
      SQL.ADD(" or C.FrecuenciaCobro='MEN' ")
   EndIf
   SQL.ADD(" ) ")
Else
   *- Cobro de Comisiones de Saldos que sean de Fin de Trimestre
   SQL.ADD("and TipoTr2 IN ('CUSSAL')")
   SQL.ADD("and T.CB1='1' ")
EndIf
SQL.ADD("Order By 1")

Recorrer SQL

  Message(FBN['NrOperacion']~' ...')

  SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
  SQL.ADD(" Set RB3='1' Where NrTrans= '"~FBN['NrOperacion']~"' ")
  SQL.NEW
  SQL.EXEC

  SQL.ActualizarMovimientosT2(FBN['NrOperacion'],SI,NO,NO,SI,0,4)
  SQL.EXEC

