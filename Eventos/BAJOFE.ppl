*    | |   | 1|      |   2  |     |    |3     |     | 4    |        5          6
*1234|5|678|90|123456|789012|34567|8901|234567|89012|345678|9012345678901234567890
*0054|1|636|15|180912|153803|00062|0302|180912|49014|197501|153803

SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
SQL.ADD(" where Codigo  = 'OFEBAJ' ")
SQL.ADD("   and Estado = 'ING' ")

*SQL.ADD("   and Secuencia = '20172' ")
*SQL.ADD("   and CodigoMAE = '0402' ")

SQL.ADD(" Order by FechaMAE,HoraMAE,Secuencia ")

Recorrer SQL
  ACT((3+FAC):1, fbn('Codigo'))
  ACT((3+FAC):2, fbn('FechaMAE'))
  ACT((3+FAC):3, fbn('HoraMAE'))
  ACT((3+FAC):4, fbn('Secuencia'))
  ACT((3+FAC):5, fbn('CodigoMAE'))
  ACT((3+FAC):6, fbn('Estado'))

  Message('Preparando Informacion de Busqueda de Ops. (Sec. '~fbn('Secuencia')~')')
          
  ACT(a:2, fbn('Mensaje1'))
  if NoVacio(fbn('Mensaje2'))
    ACT(a:2, Val(a:2)~fbn('Mensaje2'))
  endif
  if NoVacio(fbn('Mensaje3'))
    ACT(a:2, Val(a:2)~fbn('Mensaje3'))
  endif

  * Como muestra de mensaje
  *  ACT(a:2, '005416361518091215380300062030218091249014197501153803')

  ACT((3+FAC):11, Copy(Val(a:2),5,1))
  ACT((3+FAC):12, Copy(Val(a:2),6,3))
  ACT((3+FAC):13, Copy(Val(a:2),9,2))
  ACT((3+FAC):14, Copy(Val(a:2),11,6))
  ACT((3+FAC):15, Copy(Val(a:2),17,6))
  ACT((3+FAC):16, Copy(Val(a:2),23,5))
  ACT((3+FAC):17, Copy(Val(a:2),28,4))
  ACT((3+FAC):18, Copy(Val(a:2),32,6))
  ACT((3+FAC):19, Copy(Val(a:2),38,5))
  ACT((3+FAC):20, Copy(Val(a:2),43,1))
  ACT((3+FAC):21, Copy(Val(a:2),44,3))
  ACT((3+FAC):22, Copy(Val(a:2),47,2))
  ACT((3+FAC):23, Copy(Val(a:2),49,6))

** FJL 02/04/20 - No encontraba la operacion
*  ACT((3+FAC):24, '20'~Copy(Val((3+FAC):18),1,2)~'-'~Copy(Val((3+FAC):18),3,2)~'-'~Copy(Val((3+FAC):18),5,2)~' '~Copy(Val((3+FAC):23),1,2)~':'~Copy(Val((3+FAC):23),3,2)~':'~Copy(Val((3+FAC):23),5,2))
  ACT((3+FAC):24, Copy(Val((3+FAC):18),5,2)~'/'~Copy(Val((3+FAC):18),3,2)~'/'~'20'~Copy(Val((3+FAC):18),1,2)~' '~Copy(Val((3+FAC):23),1,2)~':'~Copy(Val((3+FAC):23),3,2)~':'~Copy(Val((3+FAC):23),5,2))
  ACT((3+FAC):25, SQLFechaStr(Val((3+FAC):24),Exe('FORFECHOR')))

  SQL.ADD("Select NrOperacion, NroAltaMAE, FechaAltaMAE, NroBajaMAE, ")
  SQL.ADD("       CB5,         UDN2,         PaseCB ")
  SQL.ADD("  from "~DBO~".OPERACIONES ")
  SQL.ADD(" where NroAltaMAE = '"~Val((3+FAC):19)~"' ")
** FJL 02/04/20 - No encontraba la operacion
*  SQL.ADD("   and FechaAltaMAE = Convert(datetime,'"~Val((3+FAC):24)~"',120) ")
  SQL.ADD("   and FechaAltaMAE = "~Val((3+FAC):25)~" ")
  SQL.ADD("   and CB5        = '1' ")
  recorrer SQL
    DFA
    SCN((3+FAC):31, 1)
    ACT((3+FAC):32, fbn('NrOperacion'))
    ACT((3+FAC):33, fbn('NroAltaMAE'))
    ACD((3+FAC):34, fbn('FechaAltaMAE'))
    ACT((3+FAC):35, fbn('NroBajaMAE'))
    ACT((3+FAC):36, fbn('CB5'))
    ACT((3+FAC):37, fbn('UDN2'))
    ACT((3+FAC):38, fbn('PaseCB'))
    ACT((3+FAC):39, Fecha(Trunc2(Val((3+FAC):34))))
** FJL 02/04/20 - Me da la impresion que estaba mal, hacia Copy() sobre si misma
*    ACT((3+FAC):40, Copy(Val((3+FAC):40),9,2)~Copy(Val((3+FAC):40),4,2)~Copy(Val((3+FAC):40),1,2))
    ACT((3+FAC):40, Copy(Val((3+FAC):39),9,2)~Copy(Val((3+FAC):39),4,2)~Copy(Val((3+FAC):39),1,2))

    ACT((3+FAC):41, Hora(Val((3+FAC):34)))
    ACT((3+FAC):42, Copy(Val((3+FAC):41),1,2)~Copy(Val((3+FAC):41),4,2)~Copy(Val((3+FAC):41),7,2))
  proximo
  ACN(a:1, 0)
  ACN(a:3, Val((3+FAC):31))

  if Val(a:3)<>1
    if Val(a:3)=0
      ACN(a:1,1)
      ACT((3+FAC):7, 'No Existe Op')
    else
      ACT((3+FAC):7, 'Multip.Operac.')
    endif
  endif
  if Val(a:1)=0
    if NoVacio(Val((3+FAC):35))
      ACN(a:1,1)
      ACT((3+FAC):7, 'Op con NroBaja')
    endif
  endif
  if Val(a:1)=0
    SQL.ADD("Select NrBit ")
    SQL.ADD("  from "~DBO~".OPERACIONESBITS ")
    SQL.ADD(" where NrOperacion = '"~Val((3+FAC):32)~"' ")
    SQL.ADD("   and Valor       = '1' ")
    recorrer SQL
      DFA
      ACT((3+FAC):43, Val((3+FAC):43)~FStr(fbn('NrBit'),1,0)~'|')
    proximo
    if Vacio(Val((3+FAC):43))
      ACN(a:1,1)
      ACT((3+FAC):7, 'Oper sin Instan.')
    endif
  endif

** FJL 02/04/20 - Agrego estos controles 
  *****************************************
  * Controles parapatas de pases por oferta
  *****************************************
  ACT(b:5, Val((3+FAC):32))
  if EqStr(Val((3+FAC):38),'1')
    * Es Pata de Pase
    ACT(b:6, 'SI')
    SQL.ADD("Select NrOperacion, TipoOp, OperacionRef ")
    SQL.ADD("  from "~DBO~".OPERACIONES ")
    SQL.ADD(" where NrOperacion = '"~Val(b:5)~"' ")
    recorrer SQL
      DFA
      ACT((3+FAC):51, fbn('NrOperacion'))
      ACT((3+FAC):52, fbn('TipoOp'))
      ACT((3+FAC):53, fbn('OperacionRef'))
      ACT(b:7, fbn('TipoOp'))
      ACT(b:8, fbn('OperacionRef'))
      if Incluido(fbn('TipoOp'),'TIC|TIV')
        ACT((3+FAC):54, 'Spot')
        ACT((3+FAC):55, BuscarCampo('OPERACIONES','NrOperacion4','NrOperacion',fbn('OperacionRef')))
      else
        ACT((3+FAC):54, 'Furuto')
        ACT((3+FAC):55, BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',fbn('OperacionRef')))
      endif
      ACT(b:9, Val((3+FAC):55))
    proximo
  endif
  
  if Val(a:1)=0
    ACT((3+FAC):8, 'OK')

    if Dialogo.Check1=1
      Message('Actualiza datos BajaMAE operacion '~Val((3+FAC):32))
      ACT(a:11, Copy(Val((3+FAC):14),5,2)~'/'~Copy(Val((3+FAC):14),3,2)~'/'~Copy(Val((3+FAC):14),1,2)~' '~Copy(Val((3+FAC):15),1,2)~':'~Copy(Val((3+FAC):15),3,2)~':'~Copy(Val((3+FAC):15),5,2))  
      ACT(a:12, SQLFechaStr(Val(a:11),Exe('FORFECHOR')))
      SQL.ADD("Update "~DBO~".OPERACIONES ")
* FJL 07/11/19 - Por raiden III le agrego Fuente baja (RB7) y Rojo
      SQL.ADD("  Set  Rojo         = '1', ")
      SQL.ADD("       RB7          = 0, ")
      SQL.ADD("       FechaBajaMAE = "~Val(a:12)~", ")
      SQL.ADD("       NroBajaMAE   = '"~Val((3+FAC):16)~"' ")
      SQL.ADD(" Where NrOperacion  = '"~Val((3+FAC):32)~"' ")
      SQL.NEW
      SQL.EXEC
    else
      MessageBox('Actualiza datos BajaMAE operacion '~Val((3+FAC):32))
    endif
    if Dialogo.Check1=1
      Message('BAJOFE llama DESAFE operacion '~Val((3+FAC):32))
      EjecutarEvento('DESAFE',NrOperacion1=Val((3+FAC):32))
    else
      MessageBox('BAJOFE llama DESAFE operacion '~Val((3+FAC):32))
    endif

    SQL.ADD("Select NrBit from "~DBO~".OPERACIONESBITS ")
    SQL.ADD(" where NrOperacion = '"~Val((3+FAC):32)~"' ")
    SQL.ADD("   and Valor       = '1' ")
    recorrer SQL
      DFA
      if Dialogo.Check1=1
        Message('BAJOFE pasa operacion '~Val((3+FAC):32)~' de '~FStr(fbn('NrBit'),1,0)~' a 30')
        EjecutarEvento('CBOINS', String1=Val((3+FAC):32), Radio1=1, Radio2=1, Entero1=fbn('NrBit'), Entero2=30)
      else
        MessageBox('BAJOFE pasa operacion '~Val((3+FAC):32)~' de '~FStr(fbn('NrBit'),1,0)~' a 30')
      endif
    Proximo

** FJL 02/04/20 - Se agrega esto para baja de pases por oferta
    if EqStr(Val(b:6),'SI')
      * Es pata de Pase
      SQL.ADD("Select NrBit from "~DBO~".OPERACIONESBITS ")
      SQL.ADD(" where NrOperacion = '"~Val(b:8)~"' ")
      SQL.ADD("   and Valor       = '1' ") 
      recorrer SQL
        DFA
        if Dialogo.Check1=1
          Message('BAJOFE pasa el pase '~Val(b:8)~' de '~FStr(fbn('NrBit'),1,0)~' a 74')
          EjecutarEvento('CBOINS', String1=Val(b:8), Radio1=1, Radio2=1, Entero1=fbn('NrBit'), Entero2=74)
        else
          MessageBox('BAJOFE pasa el pase '~Val(b:8)~' de '~FStr(fbn('NrBit'),1,0)~' a 74')
        endif
      Proximo
    endif
*************************************
    
    if Dialogo.Check1=1
      Message('Pone PRO en MENSAJESMAE')
      SQL.ADD("Update "~DBO~".MENSAJESMAE ")
      SQL.ADD("   Set Estado    = 'PRO' ")
      SQL.ADD(" Where Codigo    = '"~Val((3+FAC):1)~"' ")
      SQL.ADD("   and FechaMAE  = '"~Val((3+FAC):2)~"' ")
      SQL.ADD("   and HoraMAE   = '"~Val((3+FAC):3)~"' ")
      SQL.ADD("   and Secuencia = '"~Val((3+FAC):4)~"' ")
      SQL.ADD("   and CodigoMAE = '"~Val((3+FAC):5)~"' ")
      SQL.ADD("   and Estado    = '"~Val((3+FAC):6)~"' ")
      SQL.NEW
      SQL.EXEC
    else
      MessageBox('Pone PRO en MENSAJESMAE')
    endif
  endif
proximo

ACO(1,40)
ACO(3,10)
if FAC>0
  SetFont(d:1..(3+FAC):60,1)
  recorrer&i 1,FAC
    ACO(3+&i,10)
  proximo
endif
