CrearDialogo
  Check1      : 'Procesa'   ; ; ;;SI;  ;;;;0
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')


ACT(a:5, 'Operacion')
