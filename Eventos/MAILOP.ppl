Message('Enviar Mail por Superv. Operaciones ')
ACT(a1, BuscarCampo('VEHICULOS','Alias4','Codigo', Dialogo.Vehiculo1))
if NoVacio(Val(a1))
   SendMail(Val(a1),'Modificacion de Op. Financiera', 'Se modifico la operacion: '~Dialogo.NrOperacion1~', Tipo: '~Dialogo.TipoOp~', Especie: '~Dialogo.Especie1~', Cliente: '~Dialogo.Cliente1)
endif
Message('Fin Enviar Mail por Superv. Operaciones ')