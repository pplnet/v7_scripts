SQL.ADD("  from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B,"~DBO~".ESPECIES E, "~DBO~".INSTANCIAS I ") 
SQL.ADD(" where T.Especie = E.Codigo      ")
SQL.ADD("   and T.NrTrans = B.NrOperacion ")
SQL.ADD("   and I.NrInstancia = B.NrBit ")
SQL.ADD("   and I.Tabla       = 'TRANSACCIONES2' ")
SQL.ADD("   and T.TipoTr2 in ('DENOP','RENOP','TRNOP') ")
SQL.ADD("   and T.Fecha1 <= "~IdxDate2(Dialogo.Fecha1)~"  ")
* FJL 19/06/19 - Nuevo Control Isssue EXTBOFA-3637 / BOFAV6-3717 - Ahora puden estar en Anulacion
*SQL.ADD("   and B.NrBit <> 70          ")
SQL.ADD("   and B.NrBit Not in (70,30) ")
SQL.ADD("   and B.Valor = '1'          ")
SQL.ADD(" Order By T.NrTrans,B.NrBit ")
