SQL.ADD(" E.CodNumCajaValores, E.Nombre ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B,"~DBO~".ESPECIES E  Where ") 
SQL.ADD("T.Especie = E.Codigo      and                 ")
SQL.ADD("T.NrTrans = B.NrOperacion and                 ")
SQL.ADD("B.NrBit = 12              and                 ")
SQL.ADD("B.Valor = '1'             and                 ")
