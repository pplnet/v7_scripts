SQL.ADD("  FROM "~DBO~".OPERACIONES  ")   
SQL.ADD(" WHERE TipoOp In ('CONU') and Especie1 <> '' ")
SQL.ADD("  and   FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' and (FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'  or CB1=1) ")
SQL.ADD("  and (Select "~DBO~".SaldoCONU(NrOperacion,'"~IdxDate(Dialogo.Fecha1)~"',2))>0 ")
SQL.ADD(" group by Especie,Especie1 ")


act(a:fac,'Cod. Spread')
act(b:fac,'Moneda')

