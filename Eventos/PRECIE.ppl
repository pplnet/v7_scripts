   act(a:fac,'Limites Perfilamiento Clientes')
   SetFont(a:fac,2)
   ifa
   ACT(a:FAC, 'Cliente')
   ACT(b:FAC, 'Limite')
   ACT(c:FAC, 'Descripcion')
   ACT(d:FAC, 'Moneda')
   ACT(e:FAC, 'Estado')
   ACT(f:FAC, 'Consumido')
   ACT(g:FAC, 'Asignado')
   ACT(h:FAC, 'Exceso')

   SetFont(a:fac..h:fac,3)
   AgregarMarco(a:fac..h:fac,2,0,EXE('COLOR6'))
   acn(w:1,fac+1)

   SQL.ADD(" Select * from ( ")
   SQL.ADD("Select ClienteLC, limiteLC, MConsumido, ISNULL(LA.FVencimiento,'1900-03-03') FVto,ISNULL(LA.Cliente,'NOASIGNADO') ClienteLA, ISNULL(LA.Monto,0) MAsignado, TL.Descripcion ")
   SQL.ADD("From (select LC.Cliente ClienteLC, LC.limite LimiteLC, SUM(LC.Monto) as MConsumido from "~DBO~".LIMCONSUMIDOS LC ")
   SQL.ADD("       where LC.Limite in ('VOLOPE','CANOPE') ")
   SQL.ADD("       Group by Cliente,Limite) as Aux ")
   SQL.ADD(" Left JOIN "~DBO~".LIMASIGNADOS LA WITH (NOLOCK) ON  LA.Cliente=ClienteLC and LA.Limite = LimiteLC ")
   SQL.ADD(" Left JOIN "~DBO~".TIPOSLIMITE TL WITH (NOLOCK) ON TL.Codigo= LimiteLC ")
   SQL.ADD("  ) as Aux1  ")
   SQL.ADD("  where (MConsumido > MAsignado) or Fvto < '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" Order by ClienteLC, limiteLC ")
   Recorrer SQL
    
      ACT(a:fac, FBN['ClienteLC'])
      ACT(b:fac, FBN['LimiteLC'])
      ACT(c:fac, FBN['Descripcion'])    
      ACT(d:fac, 'USD')
      if Not EqStr(FBN['ClienteLA'],'NOASIGNADO')
      *  Asignado Cliente
         if FBN('FVto')<FSys
            ACT(e:fac, 'Vencido el '~Fecha(FBN('FVto')))
         else
            ACT(e:fac, 'Vigente')
         endif
     else
     *   Sin Limite Asignado
         ACT(e:fac, 'No Asignado')
     endif
  
     * Consumido
     ACN(f:fac, FBN('MConsumido'))
     * Asignado
     ACN(g:fac, FBN('MAsignado'))
  
     if Val(f:FAC)>Val(g:FAC)
        ACN(h:FAC, Val(f:FAC)-Val(g:FAC))
     endif
  Proximo

  SetFont(a:val(w:1)..h:fac,4)
  FormatoCeldas(f:val(w:1)..h:fac,Exe('F2'))
  ifa
  ifa
#endif

