SQL.ADD("SELECT I.NrInstancia, I.Nombre, O.TipoOrden, O.NrOrden, O.FechaOrden, O.Cliente, O.Especie, O.CB2, O.CB5  ")
SQL.ADD("  FROM "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB , "~DBO~".INSTANCIAS I ")   
SQL.ADD(" WHERE O.NrOrden=OB.NrOperacion ")
SQL.ADD("   and O.TipoOrden in('OTIC','OTIV') ")
SQL.ADD("   and O.FechaOrden<="~Dialogo.Fecha1)
SQL.ADD("   and OB.NrBit Not in(170,30) ")
SQL.ADD("   and OB.Valor=1 ")
SQL.ADD("   and I.Tabla='ORDENES' and I.NrInstancia=NrBit ")
SQL.ADD(" ORDER BY I.Nombre, O.NrOrden ")
watch(SQL.BATCH())
acn(z:5,0)
Recorrer SQL
  act(a:fac,FBN['TipoOrden']~' - '~FBN['NrOrden'])
  act(b:fac,FBN['FechaOrden'])
  act(c:fac,FBN['Cliente'])
  act(d:fac,FBN['Especie'])
  act(e:fac,FBN['NrInstancia']~' - '~FBN['Nombre'])
  * No puede correr la contabilidad
  acn(z:2,1)
  if Val(z:5)=0
    act(z:4,val(z:4) ~'OICO ')
    acn(z:5,1)
  endif   
Proximo
SetFont(a:val(w:1)..j:fac,4)
ifa
ifa

** Control de Ordenes TMANIF en instancias incorrectas
SQL.ADD("SELECT I.NrInstancia, I.Nombre, O.TipoOrden, O.NrOrden, O.Cliente, O.Especie, O.CB2, O.CB5  ")
SQL.ADD("  FROM "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB , "~DBO~".INSTANCIAS I ")   
SQL.ADD(" WHERE O.NrOrden=OB.NrOperacion ")
SQL.ADD("   and O.TipoOrden in('TMANIF') ")
SQL.ADD("   and O.FechaOrden<="~Dialogo.Fecha1)
SQL.ADD("   and ((O.FechaOrden <="~IdxDate2(Dialogo.Fecha1)~" and O.FechaVto> "~IdxDate2(Dialogo.Fecha1)~" and OB.NrBit not in(104,170,30)  and OB.Valor=1 ) ")
SQL.ADD("       or(O.FechaVto>= "~IdxDate2(Dialogo.Fecha1)~" and OB.NrBit not in(170,30) and OB.Valor=1)) ")
SQL.ADD("   and I.Tabla='ORDENES' and I.NrInstancia=NrBit ")
SQL.ADD(" ORDER BY I.Nombre, O.NrOrden ")
watch(SQL.BATCH())
acn(z:5,0)
Recorrer SQL
    act(a:fac,FBN['TipoOrden']~' - '~FBN['NrOrden'])
    act(b:fac,FBN['Cliente'])
    act(c:fac,FBN['Especie'])
    act(d:fac,FBN['NrInstancia']~' - '~FBN['Nombre'])
    * No puede correr la contabilidad
    acn(z:2,1)
    if Val(z:5)=0
       act(z:4,val(z:4) ~'TMIC ')
       acn(z:5,1)
    endif   
Proximo
SetFont(a:val(w:1)..j:fac,4)
ifa

