if Dialogo.check2 = 0
    SQL.ADD("SELECT ORD.NrOrden, B.NrBit  ")
    SQL.ADD("  FROM "~DBO~".ORDENES ORD, "~DBO~".OPERACIONESBITS B ")
    SQL.ADD(" WHERE ORD.NrOrden=B.NrOperacion ")
    SQL.ADD("   AND ORD.FechaOrden="~IdxDate2(Dialogo.Fecha1))
    SQL.ADD("   AND ORD.TipoOrden in('OTIC','OTIV') ")
    SQL.ADD("   AND B.NrBit in( 9,10,11 ) ")
    SQL.ADD("   AND B.Valor=1 ")
    watch(SQL.BATCH())
    Recorrer SQL
        dfa
       EjecutarEvento('CBOINS', String1=FBN['NrOrden'], Radio1=1, Radio2=0, Entero1=FBN['NrBit'], Entero2=170)   
    Proximo
else
    act(a:fac,'No cambio ordenes de Instancia por Simulacion cierre')
    SetFont(a:fac,2)
    ifa
    ifa
endif

