    act(g:fac,'Cupon')
    SetFont(a:fac..g:fac,3)
    AgregarMarco(a:fac..g:fac,2,0,EXE('COLOR6'))
    acn(w:1,fac+1)
    SQL.ADD("SELECT Especie, Cupon1 ")
    SQL.ADD("  FROM "~DBO~".OPERACIONES  ")   
    SQL.ADD(" WHERE TipoOp  In ('TIC','TIV') ")
    * FJL 22/03/23 - A pedido de Gustavo solo Ops del dia
    *  SQL.ADD("   and FechaOp >= '"~IdxDate(Dialogo.Fecha1-7)~"' ")
    *  SQL.ADD("   and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" group BY Especie, Cupon1 ")
    SQL.ADD(" ORDER BY Especie, Cupon1 ")
    watch(SQL.BATCH())
    Recorrer SQL
        DFA
        if EqStr(fbn('Especie'),Val(v:1)) y Not EqStr(fbn('Especie'),Val(v:2))
            ACT(v:2, fbn('Especie'))
            SQL.ADD("SELECT * ")
            SQL.ADD("  FROM "~DBO~".OPERACIONES  ")
            SQL.ADD(" WHERE TipoOp  In ('TIC','TIV') ")
            SQL.ADD("   and Especie = '"~fbn('Especie')~"' ")
            * FJL 22/03/23 - A pedido de Gustavo solo Ops del dia
            *      SQL.ADD("   and FechaOp >= '"~IdxDate(Dialogo.Fecha1-7)~"' ")
            *      SQL.ADD("   and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD("   and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" ORDER BY Especie, Cupon1, NrOperacion ")
            Recorrer SQL
                SCN(v:3, 1)
                act(a:fac, FBN['NrOperacion'])
                act(b:fac, FBN['TipoOp'])
                acd(c:fac, FBN['FechaOp'])
                acd(d:fac, FBN['FechaVto'])
                act(e:fac, FBN['Cliente1'])
                act(f:fac, FBN['Especie'])
                act(g:fac, FBN['Cupon1'])
            Proximo
        endif
        ACT(v:1, fbn('Especie'))
    Proximo
    if Val(v:3)=0
        ifa
        act(a:fac, 'No hay Operaciones con posible conflicto.')
    endif
    SetFont(a:val(w:1)..e:fac,4)
    ifa
    ifa
