*EndIf

* Cotizacion
If EqStr(var('USACOTNIIF'),'SI') 
    acn(w:1,fac)
    ACT(a:fac,VAR('MONEEXTR'))
    ACT(b:fac,SQL("SELECT Nombre FROM "~DBO~".ESPECIES WHERE Codigo='"~VAL(a:fac)~"'"))
    ACN(f:fac, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo='USD' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' "))
    if Val(f:fac)=0
        ACT(i:fac,'No hay cotizacion de USD para la fecha')
        * No puede correr la contabilidad
        acn(z:2,1)
        act(z:4,val(z:4) ~'USD ')
    else
        ACD(d:fac, Dialogo.Fecha1)
        ACT(c:fac,VAR('MONELOCA'))
    endif
    
    ifa
    let &especieCoti 'COMA35'
    ACT(a:fac,&especieCoti)
    ACT(b:fac,SQL("SELECT Nombre FROM "~DBO~".ESPECIES WHERE Codigo='"~&especieCoti~"'"))
    ACN(f:fac, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo='"~&especieCoti~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' "))
    if Val(f:fac)=0
        ACT(i:fac,'No hay cotizacion de '~&especieCoti~' para la fecha')
        * No puede correr la contabilidad
        acn(z:2,1)
        act(z:4,val(z:4) ~&especieCoti~' ')
    else
        ACD(d:fac, Dialogo.Fecha1)
        ACT(c:fac,VAR('MONELOCA'))
    endif
    ifa
Else
    acn(w:1,fac)
    ACT(a:fac,VAR('MONEEXTR'))
    ACT(b:fac,SQL("SELECT Nombre FROM "~DBO~".ESPECIES WHERE Codigo='"~VAL(a:fac)~"'"))
    ACN(c:fac, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo='USD' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' And Moneda='"~VAR('MONELOCA')~"' "))
    if Val(c:fac)=0
      ACT(f:fac,'No hay cotizacion de USD para la fecha')
      * No puede correr la contabilidad
      acn(z:2,1)
      act(z:4,val(z:4) ~'USD ')
    else
      ACD(d:fac, Dialogo.Fecha1)
      ACT(e:fac,VAR('MONELOCA'))
    endif
    *SetFont(a:fac,2)
    ifa   
EndIf

* Chequeando cotizaciones
If EqStr(var('USACOTNIIF'),'SI')
    (.'CONCOTNIIF'.)
    let &especie  ''
    let &book     ''
    let &fechaOp  ''
    let &fechaVto '' 
    let &tipoAsi  ''
    let &cantidadCotiControl 0  
    let &cantidadPorCorteControl 0
    let &yaSeControlo 0 
    Recorrer SQL       
        let &cantidadCotiControl &cantidadCotiControl+1
        If (Not EqStr(&especie, fbn('Especie')) OR Not EqStr(&book,fbn('book1')) OR Not EqStr(&fechaOp,fbn('FechaOp')) OR Not EqStr(&fechaVto,fbn('FechaVto')) OR Not EqStr(&tipoAsi,fbn('TipoAsi'))) OR (Vacio(&especie) OR Vacio(&book) OR Vacio(&fechaOp) OR Vacio(&fechaVto) OR Vacio(&tipoAsi)) 
            If Not (EqStr(&especie, fbn('Especie')) Y EqStr(&book,fbn('book1')))
                ****Por duplicidad de datos guardo en ZZ las fechas ya procesadas, cuando cambia especie/book blanqueo las fechas
                If &cantidadPorCorteControl<>0
                    Recorrer&i 1, &cantidadPorCorteControl
                        ACD(ZZ:&i,0)
                    Proximo
                EndIf
                let &cantidadPorCorteControl 0
            EndIf
            let &especie fbn('Especie')
            let &especieNombre fbn('Nombre')
            let &especieCotiza fbn('Cotiza')
            let &book fbn('book1')
            let &fechaOp fbn('FechaOp')
            let &fechaVto fbn('FechaVto')  
            let &tipoAsi  fbn('TipoAsi')  
            let &valuacion ''
            If EqStr(fbn('TipoAsi'),'LIQ') and Incluido(fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|TIC|TIV|')
                IF Incluido(fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|')
                    let &fechaControlar fbn('FechaOp')-1
                    (.'FECONTROL'.)
                    If &yaSeControlo=0
                        Let &PrecioNIIF CotizacionNIIF(&especie, fbn('FechaOp')-1, &book)
                        let &fechaCotizacion fbn('FechaOp')-1
                        **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                        IF Vacio(&PrecioNIIF) 
                            acn(z:2,1)
                            act(z:4,val(z:4) ~'CN1 ')
                            let &cotizacion 0
                        Else
                            If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                acn(z:2,1)
                                act(z:4,val(z:4) ~'CN2 ')
                                let &cotizacion 0
                            ELSE
                                let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                let &valuacion ValuacionNIIF(&especie, Dat(fbn('FechaOp')-1), &book, 0)
                            ENDIF
                        ENDIF
                        (.'DATOCOTESP'.)
                    Else
                        dfa
                    EndIf
                ENDIF
                
                IF Incluido(fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|TIC|TIV|') Y #ESLIQVTO 
                    **Liquidacion al Vto para operacion 'TICT','TIDE','TICO','TIPO','TIC','TIV'
                    If fbn('FechaOp') = fbn('FechaVto')
                        dfa
                    Else
                        Recorrer&i fbn('FechaOp'),fbn('FechaVto')-1
                            let &fechaRevaluo Fecha(&i)
                            If Fecha(&i) <> fbn('FechaOp')
                                ***Tengo que hacer esta distincion porque en el 2do recorrer necesito aumentar el ifa
                                ***para no perder datos ya que en el recorrer hay 2 lineas (2 ifa)
                                ifa
                            EndIf
                            **Estos son los controles por cotizacionesNiif que se usan en REVALOP
                            let &fechaControlar &fechaRevaluo
                            (.'FECONTROL'.)
                            If &yaSeControlo=0
                                Let &PrecioNIIF CotizacionNIIF(&especie, &fechaRevaluo, &book)
                                let &fechaCotizacion &fechaRevaluo
                                **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                                IF Vacio(&PrecioNIIF) 
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN3 ')
                                    let &cotizacion 0
                                Else
                                    If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                        acn(z:2,1)
                                        act(z:4,val(z:4) ~'CN4 ')
                                        let &cotizacion 0
                                    ELSE
                                        let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                        let &valuacion ValuacionNIIF(&especie, Dat(&fechaRevaluo), &book, 0)
                                    ENDIF
                                ENDIF
                                (.'DATOCOTESP'.)
                            Else
                                dfa
                            EndIf
                            ifa
                            let &valuacion ''
                            let &fechaCotizacion &fechaRevaluo-1
                            let &fechaControlar &fechaRevaluo-1
                            (.'FECONTROL'.)
                            If &yaSeControlo=0 
                                Let &PrecioNIIF CotizacionNIIF(&especie, &fechaRevaluo-1, &book)
                                **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                                IF Vacio(&PrecioNIIF) 
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN5 ')
                                    let &cotizacion 0
                                Else
                                    If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                        acn(z:2,1)
                                        act(z:4,val(z:4) ~'CN6 ')
                                        let &cotizacion 0
                                    ELSE
                                        let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                        let &valuacion ValuacionNIIF(&especie, Dat(&fechaRevaluo-1), &book, 0)
                                    ENDIF
                                ENDIF
                                (.'DATOCOTESP'.)
                            Else
                                dfa
                            EndIf
                        Proximo 
                    EndIf
                Else
                    dfa
                ENDIF
            ELSE
                IF EqStr(fbn('TipoAsi'),'DEV')
                    **Busco cotizacionniif igual que en el CONT15
                    IF Eqstr(fbn('Tipo'), 'Hoy')
                        let &fechaControlar Dialogo.Fecha1
                        (.'FECONTROL'.)
                        If &yaSeControlo=0 
                            Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book1'))
                            let &fechaCotizacion Dialogo.Fecha1
                            **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                            IF Vacio(&PrecioNIIF) 
                                acn(z:2,1)
                                act(z:4,val(z:4) ~'CN7 ')
                                let &cotizacion 0
                            Else
                                If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN8 ')
                                    let &cotizacion 0
                                ELSE
                                    let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                    IF Eqstr(fbn('Tipo'), 'Hoy')
                                        let &valuacion ValuacionNIIF(&especie, Dat(Dialogo.Fecha1), &book, 0)
                                    ELSE
                                        let &valuacion ValuacionNIIF(&especie, Dat(Dialogo.Fecha1-1), &book, 0)
                                    ENDIF
                                ENDIF
                            ENDIF
                            (.'DATOCOTESP'.)
                        Else
                            dfa
                        EndIf
                    ELSE
                        let &fechaControlar Dialogo.Fecha1-1
                        (.'FECONTROL'.)
                        If &yaSeControlo=0 
                            Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1-1, fbn('Book1'))
                            let &fechaCotizacion Dialogo.Fecha1-1
                            **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                            IF Vacio(&PrecioNIIF) 
                                acn(z:2,1)
                                act(z:4,val(z:4) ~'CN7 ')
                                let &cotizacion 0
                            Else
                                If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN8 ')
                                    let &cotizacion 0
                                ELSE
                                    let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                    IF Eqstr(fbn('Tipo'), 'Hoy')
                                        let &valuacion ValuacionNIIF(&especie, Dat(Dialogo.Fecha1), &book, 0)
                                    ELSE
                                        let &valuacion ValuacionNIIF(&especie, Dat(Dialogo.Fecha1-1), &book, 0)
                                    ENDIF
                                ENDIF
                            ENDIF
                            (.'DATOCOTESP'.)
                        Else
                            dfa
                        EndIf
                    ENDIF

                ELSE     
                    IF EqStr(fbn('TipoAsi'),'VTO')
                        If EqStr(&especie,'USD')
                            Let &PrecioNIIF &cotiUSD   
                            let &fechaCotizacion Dialogo.Fecha1-1
                            IF Vacio(&PrecioNIIF) 
                                acn(z:2,1)
                            EndIf
                            (.'DATOCOTESP'.)
                        Else
                            let &fechaControlar Dialogo.Fecha1-1
                            (.'FECONTROL'.)
                            If &yaSeControlo=0 
                                Let &PrecioNIIF CotizacionNIIF(&especie, Dialogo.Fecha1-1, &book)

                                let &fechaCotizacion Dialogo.Fecha1-1
                                **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                                IF Vacio(&PrecioNIIF) 
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN9 ')
                                    let &cotizacion 0
                                Else
                                    If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                        acn(z:2,1)
                                        act(z:4,val(z:4) ~'CN10 ')
                                        let &cotizacion 0
                                    ELSE
                                        let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                        let &valuacion ValuacionNIIF(&especie, Dat(Dialogo.Fecha1-1), &book, 0)
                                    ENDIF
                                ENDIF
                                (.'DATOCOTESP'.)
                            Else
                                dfa
                            EndIf
                        EndIf
                    ELSE
                        **Estos son los controles por cotizacionesNiif que se usan en REVALOP
                        let &fechaRevaluo Dialogo.Fecha1
                        let &fechaControlar &fechaRevaluo
                        (.'FECONTROL'.)
                        If &yaSeControlo=0                        
                            Let &PrecioNIIF CotizacionNIIF(&especie, &fechaRevaluo, &book)
                            let &fechaCotizacion &fechaRevaluo
                            **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                            IF Vacio(&PrecioNIIF) 
                                acn(z:2,1)
                                act(z:4,val(z:4) ~'CN11 ')
                                let &cotizacion 0
                            Else
                                If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN12 ')
                                    let &cotizacion 0
                                ELSE
                                    let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                    let &valuacion ValuacionNIIF(&especie, Dat(&fechaRevaluo), &book, 0)
                                ENDIF
                            ENDIF
                            (.'DATOCOTESP'.)
                        Else
                            dfa
                        EndIf
                        ifa
                        
                        let &valuacion ''
                        let &fechaControlar &fechaRevaluo-1
                        (.'FECONTROL'.)
                        If &yaSeControlo=0 
                            Let &PrecioNIIF CotizacionNIIF(&especie, &fechaRevaluo-1, &book)
                            let &fechaCotizacion &fechaRevaluo-1
                            **Controlo que no esté en 0 o NULL la cotizacion, si no levanto flag
                            IF Vacio(&PrecioNIIF) 
                                acn(z:2,1)
                                act(z:4,val(z:4) ~'CN13 ')
                                let &cotizacion 0
                            Else
                                If &PrecioNIIF.PrecioCotizacionDeterminada = 0
                                    acn(z:2,1)
                                    act(z:4,val(z:4) ~'CN14 ')
                                    let &cotizacion 0
                                ELSE
                                    let &cotizacion &PrecioNIIF.PrecioCotizacionDeterminada
                                    let &valuacion ValuacionNIIF(&especie, Dat(&fechaRevaluo-1), &book, 0)
                                ENDIF
                            ENDIF
                            (.'DATOCOTESP'.)
                        Else
                            dfa
                        EndIf
                    ENDIF   
                ENDIF
            ENDIF
        Else
            dfa
        EndIf
    Proximo
    ifa
    ifa
    if val(z:2)=0
       ACT(a:fac,'Cotizaciones NIIF Ok ' ~FsTr(&cantidadCotiControl,0,0))
       SetFont(a:fac,2)
    else   
        *ACT(a:fac,'Cotizaciones NIIF con error '~Copy(val(z:4),1,60)~iif(Longitud(val(z:4))>60,'...',''))
        ACT(a:fac,'Cotizaciones NIIF con error '~FsTr(&cantidadCotiControl,0,0))
        SetFont(a:fac,2)
    endif
ELSE
    (.'QESPECIES'.)
    acn(z:5,0)
    Recorrer SQL
        Message('Buscando cotizacion especie '~FBN['Especie'])
        ACT(a:fac,FBN['Especie'])
        ACT(b:fac,FBN['Nombre'])
        ACD(d:fac, SQL("SELECT Max(Fecha) FROM "~DBO~".COTIZACIONES WHERE Codigo='"~FBN['Especie']~"' and Fecha>="~IdxDate2(Habiles(Dialogo.Fecha1,-3,'ARG'))~" and Fecha<="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' "))
        if Val(d:fac)=0
           BorrarCeldas(d:fac..d:fac)
           ACN(c:fac, 0)
        else
           SQL.ADD("SELECT Precio1, Moneda FROM "~DBO~".COTIZACIONES WHERE Codigo='"~FBN['Especie']~"' and Fecha>="~IdxDate2(val(d:fac))~" and Fecha<="~IdxDate2(Dialogo.Fecha1)~" and CallPut='CON' ")
           Recorrer SQL
              DFA
              ACN(c:fac, FBN['Precio1'])
              ACT(e:fac, FBN['Moneda'])
           Proximo  
        endif   
        if val(c:fac)=0
          *Debe actuar como 'Warning' para BIND
          #ifdef BIND
            acn(z:2, Val(z:2))
            ACT(f:fac,'Warning: No hay cotizacion para la fecha')
          #else
            ACT(f:fac,'No hay cotizacion para la fecha')
            * No puede correr la contabilidad
            acn(z:2,1)
            if Val(z:5)=0
              act(z:4,val(z:4) ~'COT2 ')
              acn(z:5,1)
            endif   
          #endif
        endif
        #ifdef MLASA
          ACD(u:fac, BuscarCampo('ESPECIES','Fecha','Codigo',FBN['Especie']))
          if Val(u:fac)<Dialogo.Fecha1
            if NoVacio(Val(f:fac))
              ACT(f:fac, Val(f:FAC)~' - ')
            endif
            ACT(f:fac, Val(f:FAC)~'Especie ya madurada el '~Fecha(Val(u:fac)))
          endif
        #endif
        
    Proximo
    SetFont(a:val(w:1)..f:fac,4)
    FormatoCeldas(c:val(w:1)..c:fac,Exe('F7'))
    if val(z:2)=0
      ifa
      ifa
      ACT(a:fac,'Cotizaciones Ok')
      SetFont(a:fac,2)
    endif
EndIf
ifa
ifa
ifa
* Informe de ops pendiente de liquidacion
act(a:fac,'Pendientes de Liquidacion')
SetFont(a:fac,2)
ifa
ACT(a:fac,'FechaMov')
ACT(b:fac,'Tipo')
ACT(c:fac,'NroOp')
ACT(d:fac,'Cliente')
ACT(e:fac,'Especie')
ACT(f:fac,'Cantidad')
ACT(g:fac,'Cuenta')
ACT(h:fac,'Leyenda')
ACT(i:fac,'Instancia')
SetFont(a:fac..i:fac,3)
AgregarMarco(a:fac..i:fac,2,0,EXE('COLOR6'))
acn(w:1,fac+1)

SQL.ADD("SELECT M.*, O.TipoOp, OB.NrBit ")
SQL.ADD("  from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB  ")
SQL.ADD(" WHERE O.NrOperacion=M.NrOperacion ")
SQL.ADD("   AND M.FechaMov<="~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   AND M.NrSaldo=1 ")
SQL.ADD("   AND O.NrOperacion=OB.NrOperacion ")
SQL.ADD("   AND OB.Valor=1 ")
SQL.ADD("   AND OB.NrBit not in(70) ")
SQL.ADD("   AND O.TipoOp in('TIC','TIV','TCOPRI','FXC','FXV','FXJ','FXCF','FXVF','CAUC','MMCO','MMCT','TICO','TIPO','TICT','TIDE') ")
SQL.ADD(" ORDER BY FechaMov ")
acn(z:5,0)
Recorrer SQL
  * No puede correr la contabilidad
  *Debe actuar como 'Warning' para BIND
  #ifdef BIND
    acn(z:2,val(z:2))
  #else
    acn(z:2,1)
    if Val(z:5)=0
      act(z:4,val(z:4) ~'PENL ')
      acn(z:5,1)
    endif   
  #endif
  ACD(a:fac,FBN['FechaMov'])
  ACT(b:fac,FBN['TipoOp'])
  ACT(c:fac,FBN['NrOperacion'])
  ACLO(c:fac,FBN['NrOperacion'])
  ACT(d:fac,FBN['Cliente'])
  ACT(e:fac,FBN['Especie'])
  ACN(f:fac,FBN['Cantidad'])
  ACT(g:fac,FBN['Cuenta'])
  ACT(h:fac,FBN['Leyenda'])
