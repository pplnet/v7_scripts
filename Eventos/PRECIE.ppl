        Messagebox('El precierre ha sido cancelado por falta de datos')

        ifa
    else
        *    Se pasó a la generacion contable
        *    * Revaluar operaciones y transacciones en dolares
        *    Message('Regenera posiciones de Ops/Tr en dolares')
        *    EjecutarEvento('REGPOS', Fecha1=Dialogo.Fecha1,Check1=1)
        *   * Reset Precio
        *   Message('Resetea precio posicion')
        *   EjecutarEvento('RESPCO', Fecha1=Dialogo.Fecha1,Especie1='',Check3=1,Check4=1,Check1=1,Check2=1 )
        * Pasa Operaciones a Compliance
        Message('Moviendo Operaciones a Compliance')
        EjecutarEvento('MOOPAU', Fecha1=Dialogo.Fecha1, Check1=1 )
        Message('Actualizando operaciones de cuentas remuneradas')
        EjecutarEvento('FINREM', Fecha1=Dialogo.Fecha1,Fecha2=Habiles(Dialogo.Fecha1,1,Var('FERIDEF'))-1)
       
        
        * Corte
        Message('Genera corte automatico')
        EjecutarEvento('CORTE7', Fecha1=Dialogo.Fecha1 )

        Message('Calculo diario Interes ICL')
        EjecutarEvento('ICLDEV', Fecha1=Dialogo.Fecha1,Fecha2=Habiles(Dialogo.Fecha1,1,'ARG',SI)-1,Fecha3=Habiles(Dialogo.Fecha1,1,'USA',SI)-1,Vehiculo1=Var('VEHICULODE') )
        EjecutarEvento('CONT0',Fecha1=Dialogo.Fecha1,Vehiculo1=Var('VEHICON'),Radio1=4,Radio2=Var('RETIDIARIO'),Check1=1)
        ACT(a:fac,'Contabilidad generada')
        ***---Inicializo Variable de Control de corridas contables
        SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='NO' Where Codigo='CONTAPROCE' ")
        SQL.NEW
        SQL.EXEC

        LinkearHoja('ASIDES',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha1,NrUnicoAsiento1='',Lista1='',Lista2='')
        SetFont(a:fac,2)
        ifa
        ifa
        *    i*f Eqstr(VAR('INSTALACIO'),'MLASA')
        #ifdef MLASA
          Message('Actualizando Especies por PME')
          EjecutarEvento('PMEUPD', Lista1='' )
        #endif
        
        *  i*f Eqstr(VAR('INSTALACIO'),'MLASA') y NO
        #ifdef MLASA
           if NO
              * Copiativos Hojas Moviles
              Message('Libro de Cartera')
              LinkearHoja('LIBCAR',1,Fecha1=Fsys,Radio1=1,Radio2=1,Vehiculo1=VAR('VEHICULODE'))
              CerrarHoja('LIBCAR',1)
           
              Message('Libro de Caja')    
              LinkearHoja('LICAJC',1,Fecha1=Fsys,Fecha2=Fsys,Radio1=1,Radio2=1,Vehiculo1=VAR('VEHICULODE'),Check1=1,ListaTabla1='',ListaTabla2='')
              CerrarHoja('LICAJC',1)    
           
              Message('Copiativo Boletos MAE -ROFEX')    
              LinkearHoja('COPIAT',1,Fecha1=Fsys,Fecha2=Fsys,Radio1=1,Radio2=1,Vehiculo1=VAR('VEHICULODE'),Especie1='ARP')
              CerrarHoja('COPIAT',1)
           ENDIF
        #endif
        *Cierre de Reportes opcional dependiendo el valor de la variable CIEREPO *      
        
        *Llamada a interfaces CMF  
        #ifdef CMF
            *Llamada a Interfaz contable
            EjecutarEvento('INTCON',Fecha1=Dialogo.Fecha1,Directorio1=VAR('PATHINTCON'),Check1=1,Check2=1)
            ACT(a:fac,'Interface contable ejecutada')
            SetFont(a:fac,2)
          
            *Llamada a Interfaz Envio Operaciones de Call
            EjecutarEvento('INTCAL',Fecha1=Dialogo.Fecha1,Directorio1=VAR('PATHINTCAL'),Check1=1)
            ACT(a:fac,'Interfaz de call ejecutada')
            SetFont(a:fac,2)
            
            *Llamada a Interfaz Lavado de Dinero
            EjecutarEvento('INTLAV',Fecha1=Dialogo.Fecha1,Directorio1=VAR('PATHINTLAV'),Check1=1)
            ACT(a:fac,'Interfaz de lavado ejecutada')
            SetFont(a:fac,2)
            
            *Llamada a Interfaz Envio Operaciones de CREM
            EjecutarEvento('INTREM',Directorio1=Var('PATHINTREM'),Fecha1=Dialogo.Fecha1,Check1=0,Lista1='', Dialogo.Check2=1)
            ACT(a:fac,'Interfaz de Cuentas Remuneradas ejecutada')
            SetFont(a:fac,2)
            EjecutarEvento('ANUOPE')

            
        #endif
        
        if EQSTR(VAR('RECALTASA'),'SI') 
            EjecutarEvento('MODTAS',Fecha1=Dialogo.Fecha1)
            ACT(a:fac,'Se revisaron las tasas de transferencia')
            SetFont(a:fac,2)
        endif
        
        if EQSTR(VAR('CIEREPO'),'SI') 
        Message('Generando auditoria de cierre')
            LinkearHoja('LOGCIE',1,Fecha1=Dialogo.Fecha1)
            ACT(a:fac,'Listados de auditoria emitidos')
            SetFont(a:fac,2)
            ifa
        else
            Message('Auditoria de cierre no generada')
            ACT(a:fac,'Listados de auditoria no fueron emitidos')
            SetFont(a:fac,2)
            ifa
        endif
            
        If Dialogo.Check1=0 y val(z:2)>=1
           * Cierra forzado con error
           ifa
           ACT(a:fac,'Se ejecutaron los procesos de cierre manualmente con errores ')
           SetFont(a:fac,2)
        endif
        * No se puede hacer por UPD
        * Cambio de fecha
        if EqStr(var('CAMBIOFECH'),'SI') 
           ACD(x:1,HABILES(Dialogo.Fecha1,1,'ARG'))
*           sql.add(" Update  "~DBO~".Variables Set valor = '"~val(x:1)~"' where codigo = 'FECHASYS' ")
*           sql.new
*           sql.exec
           AbrirDia(val(x:1),SI,NO)
           ifa
           ifa
           ACT(a:fac,'Se cambio el dia al '~val(x:1))
           SetFont(a:fac,2)
        endif        
    endif
    **Procesos Post Cierre
    Message('Capitalizacion Interes ICL')
    EjecutarEvento('ICLDIA', Fecha1=Habiles(Dialogo.Fecha1,1,'ARG',SI),Fecha2=PriDeMes(Habiles(Dialogo.Fecha1,-1,'ARG',SI),SI),Fecha3=FinDeMes(Habiles(Dialogo.Fecha1,-1,'ARG',SI),SI),Fecha4=PriDeMes(Dialogo.Fecha1,NO,'ARG'),Vehiculo1=Var('VEHICULODE') )

    
     **Cambio de Fecha
    

    
    
else
