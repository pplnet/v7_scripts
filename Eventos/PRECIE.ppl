IF Not Incluido('MTM', VAR('NOPRECIE'))
    * Chequeo de MTM
    acn(z:3, 0)
    SQL.ADD("Select 1 FaltaMTM, O.Mercado4 ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".MERCADOS M ")
    SQL.ADD(" Where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   AND O.Mercado4=M.Codigo ")
    * Se verifica que las ops cuyos MTM se liquidan o no (manuales) esten cargados
    *    SQL.ADD("   AND O.MB4 = 1 ")
    SQL.ADD("   AND O.MB4 in(1,2) ")
    SQL.ADD("   AND O.TipoOp IN ('FXCF','FXVF','TICF','TIVF') ")
    SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
    SQL.ADD("   and Not B.NrBit = 30 ")
    SQL.ADD("   and B.Valor       = '1' ")
    * Verifica todos los MTM manual y autom.
    *SQL.ADD("   and M.MTM in(1,2)")
    SQL.ADD("   and not Exists( ")
    SQL.ADD("                  SELECT 1 FROM "~DBO~".MTM MT ")
    SQL.ADD("                   WHERE Fecha="~IdxDate2(Dialogo.Fecha1))
    SQL.ADD("                     and TipoMTM='MTM' ")
    SQL.ADD("                     and Estado='PRO' ")
    SQL.ADD("                     and MT.Mercado=O.Mercado4)")
    SQL.ADD(" GROUP BY O.Mercado4 ")
    watch(SQL.BATCH())
    acn(z:5,0)
    Recorrer SQL
      *dfa
      if FBN['FaltaMTM']=1
        ACT(a:fac,'No se ejecuto correctamente el MTM del dia para '~FBN['Mercado4'])
        SetFont(a:fac,2)
        * No puede correr la contabilidad
        acn(z:2,1)
        if Val(z:5)=0
          act(z:4,val(z:4) ~'MTM  ')
          acn(z:5,1)
        endif   
        * MTM Erroneo
        acn(z:3,1)
      Endif
    Proximo    
    if val(z:3)=0
       ACT(a:fac,'Se ejecuto correctamente el MTM del dia')
    endif
    SetFont(a:fac,2)
    ifa
    ifa
Else
    ACT(a:fac,'Se invalidó el MTM del dia')
    SetFont(a:fac,2)
    ifa
    ifa
Endif
    
