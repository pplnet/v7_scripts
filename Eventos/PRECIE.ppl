HojaVisible(SI)
MostrarcuadrodeMensajes
CrearDialogo
  Fecha1: 'Fecha'        ;;;;SI;;Dialogo.Fecha1<=FSYS;'Fecha Inválida';;Fsys;
  Check1: 'Controles'    ;;;;SI;SI;;;;1;
  Check2: 'Reporte'      ;;;;NO;NO;;;;0;
  Check3: 'Regenera Pos' ;;;;NO;NO;;;;1
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,"Arial,14,B")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,8,B")
CrearFont(4,"Arial,8,")
AgregarBMP(a1,Exe('LOGO'),90)

SetFilaActual(3)
*MAC modo reporte
if Dialogo.check2 = 0
   ACT(d:fac,'Cierre del dia al '~Dialogo.Fecha1)
else
   ACT(d:fac,'Simulacion de Cierre al '~Dialogo.Fecha1)
endif
SetFont(d:fac..d:fac,1)
SetFilaActual(fac+3)

* Puede correr la contabilidad
acn(z:2,0)
act(z:4,'')

*MAC modo reporte
if Dialogo.check2 = 0
    #ifdef MLASA
    #else
        EjecutarEvento('CIEINT', Vehiculo1=Var('VEHICULODE'), Fecha1=Fsys, Check1=1, NrOperacion1='')
    #endif
else
    act(a:fac,'No se ejecuto Calculo de intereses TIDE/TIPO/TICO/TICT por Simulacion cierre')
    SetFont(a:fac,2)
    ifa
    ifa
endif

act(z:8,VAR('JERTITULOS'))

act(a:fac,'Cotizaciones')
SetFont(a:fac,2)
ifa
* Temporario. Sacar cuando el servicio de precios se ocupe de Precio1
#ifdef BACS
    if Dialogo.check2 = 1
       Message('Actualizando precios IntraDay')
       SQL.ADD("UPDATE "~DBO~".COTIZACIONES   ")
       SQL.ADD("   SET Precio1=PrecioContable ")
       SQL.ADD(" WHERE Mercado='"~VAR('AMBBYMA')~"'")
       SQL.ADD("   AND Fecha="~IdxDate2(Dialogo.Fecha1))
       SQL.ADD("   AND Round(Isnull(PrecioContable,0),8)<>Round(0,8) ")
       SQL.New
       SQL.Exec
    endif   
#endif
If EqStr(var('USACOTNIIF'),'SI')
    ACT(A:fac,'Especie')
    ACT(B:fac,'Nombre')
    ACT(C:fac,'Mon. Cotiza')
    ACT(D:fac,'Fecha Cotizacion')
    ACT(E:fac,'Fecha Ult Cotiz.')
    ACT(F:fac,'Precio')
    ACT(G:fac,'Tipo Val. Act.')
    ACT(H:fac,'Cartera')
    *ACT(I:fac,'Mercado')
    *ACT(J:fac,'Plazo')
    ACT(I:fac,'Observacion')
    SetFont(a:fac..I:fac,3)
    AgregarMarco(a:fac..i:fac,2,0,EXE('COLOR6'))
ELSE
    ACT(a:fac,'Especie')
    ACT(b:fac,'Nombre')
    ACT(c:fac,'Cotizacion')
    ACT(d:fac,'Fecha')
    ACT(e:fac,'Moneda')
    ACT(f:fac,'Observacion')
    SetFont(a:fac..f:fac,3)
    AgregarMarco(a:fac..f:fac,2,0,EXE('COLOR6'))
ENDIF
ifa 
*
******Agregamos la regeneracion para el control de cotizacione que se hace despues
*If EqStr(Var('ACTPOS'),'SI') Y Dialogo.Check3 = 1
*    * Revaluar operaciones y transacciones en dolares
*    Message('Regenera posiciones de Ops/Tr en dolares')
*    EjecutarEvento('REGPOS', Fecha1=Dialogo.Fecha1,Check1=1)
*
*    * Reset Precio
*    Message('Resetea precio posicion')
