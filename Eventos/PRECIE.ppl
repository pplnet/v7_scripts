SQL.ADD("Select T.Cliente1, M.Especie, M.NrTrans2, M.Mercado, T.TipoTr2, IsNull(T.Cantidad1,0) Cantidad1, T.UsrInput, ")
SQL.ADD("       T.Vehiculo1, T.Cuenta1, T.Cuenta2, T.Fecha1, T.Fecha2, T.NrOperacionRef4, T.NrOperacionRef1           ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M  with (NOLOCK Index = INDME5),"~DBO~".TRANSACCIONES2 T,                         ")
SQL.ADD("     "~DBO~".ESPECIES E, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB                                      ")
SQL.ADD("where ((T.TipoTr2 ='COMP' AND M.NrTrans2 = T.NrTrans) OR (T.TipoTr2 <>'COMP' AND M.NrOperacion = T.NrTrans)) ")
SQL.ADD("  AND M.Especie=E.Codigo                                                                                     ")
SQL.ADD("  AND M.Cliente=C.Codigo                                                                                     ")

SQL.ADD("  AND T.NrTrans=OB.NrOperacion AND M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'             ")
SQL.ADD("  AND T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND OB.NrBit in(14) AND OB.Valor='1'           ")

*- Extrabursatil                                                                                   
SQL.ADD(" and M.NrGrupo <> '15'                                                                    ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET','COMP','MATCH')                                            ")

* Para que no los informe como dobles
SQL.ADD(" and ((M.Cliente<>T.Vehiculo1 and T.TipoTr2='MATCH') or (T.TipoTr2<>'MATCH'))  ")

SQL.ADD(" order by M.NrTrans2 ")
watch(SQL.BATCH())
acn(z:5,0)
Recorrer SQL
  * No puede correr la contabilidad
  acn(z:2,1)
  if Val(z:5)=0
    act(z:4,val(z:4) ~'LIQ2 ')
    acn(z:5,1)
  endif   
  ACT(a:Fac,FBN['NrTrans2'])
  ACT(b:Fac,FBN['TipoTr2'])
  ACD(c:Fac,FBN['Fecha1'])
  ACD(d:Fac,FBN['Fecha2'])
  ACT(e:Fac,fbn['Cliente1'])
  ACT(f:Fac,FBN['Mercado'])
  ACT(g:Fac,fbn['Especie'])
  ACN(h:Fac,FBN['Cantidad1'])
  ACT(i:Fac,FBN['Cuenta1'])
  ACT(j:Fac,FBN['Cuenta2'])   
  ACT(k:Fac,FBN['NrOperacionRef1'])
  ACT(l:Fac,FBN['UsrInput'])
Proximo
SetFont(a:val(w:1)..l:fac,4)
FormatoCeldas(h:val(w:1)..h:fac,Exe('F2'))
