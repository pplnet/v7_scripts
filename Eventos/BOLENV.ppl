CrearDialogo
   NrOperacion1: 'Operacion' ;;;;;;NoVacio(Dialogo.Nroperacion1);'Debe completar la Operacion';NO;;;;;;"EXISTS(SELECT 1 From "~DBO~".OPERACIONESBITS WHERE NrBit=66 and Valor=1 and NrOperacion=OPERACIONES.NrOperacion )";
FinDialogo

if not Ok
   Cancelar
endif

   
IF SQL("SELECT 1 FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB WHERE O.NrOperacion=OB.NrOperacion and OB.NrBit=66 and OB.Valor=1 and OB.NrOperacion='"~Dialogo.NrOperacion1~"'")=1
   EjecutarEvento('CBOINS', String1=Dialogo.NrOperacion1, Radio1=1, Radio2=2, Entero1=66, Entero2=68)
   Messagebox('El cambio ha sido realizado')
else
   Messagebox('La operacion ya no está en esa instancia')
endif
