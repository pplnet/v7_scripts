   EscribirASCII(Val(A:&i)~';'~Val(B:&i)~';'~Val(C:&i)~';'~Val(D:&i)~';'~Val(E:&i)~';'~Val(F:&i)~';'~Val(G:&i)~';'~Val(H:&i)~';'~Val(I:&i)~';'~Val(J:&i)~';'~Val(K:&i)~';'~IIF(Val(L:&i)=0,'',FStr(Round(Val(L:&i)),0,0))~';'~IIF(Val(L:&i)=0,'',FStr(Round(Val(M:&i)),0,0))~';'~Val(N:&i)~';'~IIF(Val(L:&i)=0,'',Val(O:&i))~';'~TRIM(MIRT(Val(Q:&i)))~';'~Val(R:&i))
