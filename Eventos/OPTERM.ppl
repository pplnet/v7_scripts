    Fecha1: 'Fecha'      ;1;1;;  ;;Dia(Dialogo.Fecha1)=7 o Dia(Dialogo.Fecha1)=15 o Dia(Dialogo.Fecha1)=23 o Dia(Dialogo.Fecha1)=Dia(FinDeMes(Dialogo.Fecha1,SI));'Debe indicar ultimo dia de semana estadistica';NO;IIF(Dia(FSYS)<8, PriDeMes(FSYS,SI)+6, IIF(Dia(FSYS)<16,PriDeMes(FSYS,SI)+14,IIF(Dia(FSYS)<24, PriDeMes(FSYS,SI)+22,FinDeMes(FSYS,SI))));
    Fecha2: 'F.Desde'    ;2;1;;NO;;;;;IIF(Dia(Dialogo.Fecha1)<8, PriDeMes(Dialogo.Fecha1,SI), IIF(Dia(Dialogo.Fecha1)<16,PriDeMes(Dialogo.Fecha1,SI)+7,IIF(Dia(Dialogo.Fecha1)<24,PriDeMes(Dialogo.Fecha1,SI)+15,PriDeMes(Dialogo.Fecha1,SI)+23)));IIF(Dia(Dialogo.Fecha1)<8, PriDeMes(Dialogo.Fecha1,SI), IIF(Dia(Dialogo.Fecha1)<16,PriDeMes(Dialogo.Fecha1,SI)+7,IIF(Dia(Dialogo.Fecha1)<24,PriDeMes(Dialogo.Fecha1,SI)+15,PriDeMes(Dialogo.Fecha1,SI)+23)));
