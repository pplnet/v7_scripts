*- MUESTRO LOS DATOS EN PANTALLA
Recorrer&i 1, Val(RE:1)
   If &i=1
      *-Campo1
      ACT(A:Val(FI:2), Val(AA:&i))
      ACT(B:Val(FI:2), Val(AB:&i))
      ACT(C:Val(FI:2), Val(AC:&i))
      ACT(D:Val(FI:2), Val(AD:&i))
      *-Campo5
      ACT(E:Val(FI:2), Val(AE:&i))
      ACT(F:Val(FI:2), Val(AF:&i))
      ACT(G:Val(FI:2), Val(AG:&i))
      ACT(H:Val(FI:2), Val(AH:&i))
      ACT(I:Val(FI:2), Val(AI:&i))
      *-Campo10
      ACT(J:Val(FI:2), Val(AJ:&i))
      ACT(K:Val(FI:2), Val(AK:&i))
      ACN(L:Val(FI:2), Val(AL:&i))
      ACN(M:Val(FI:2), Val(AM:&i))
      ACT(R:Val(FI:2), Val(AN:&i))
      FormatoCeldas(L:Val(FI:2)..M:Val(FI:2), EXE('F0'))
      *- fila de datos a imprimir
      ACN(FI:1, Val(FI:2))
      ACT(N:Val(FI:1), Val(AR:&i))
      ACT(O:Val(FI:1), Val(AS:&i))
      ACT(P:Val(FI:1), Val(AP:&i))
      ACT(Q:Val(FI:1), Val(AT:&i))
   Else
      ACN(AZ:1, 0)
      Recorrer&j Val(FI:2),Val(FI:1)
      *- si campo4 a 11 son iguales y 14, sumo cantidad e importe, sino genero un nuevo registro a informar
         *- no pregunto por tipo de op porque son todas a termino, es decir siempre son 1.
         If EqStr(Val(AD:&i),Val(D:&j)) y EqStr(Val(AE:&i),Val(E:&j)) y EqStr(Val(AF:&i),Val(F:&j)) y EqStr(Val(AG:&i),Val(G:&j)) y EqStr(Val(AH:&i),Val(H:&j)) Y EqStr(Val(AI:&i),Val(I:&j)) Y EqStr(Val(AJ:&i),Val(J:&j)) Y EqStr(Val(AK:&i),Val(K:&j))  Y EqStr(Val(AR:&i),Val(N:&j))  Y EqStr(Val(AP:&i),Val(P:&j))
            SCN(L:&j, Val(AL:&i))
            SCN(M:&j, Val(AM:&i))
            ACN(AZ:1, 1)
            Break             
         EndIf
      Proximo
      If Val(AZ:1)=0
         *- no encontre registro iguales => creo uno nuevo
         SCN(FI:1, 1)
         *-Campo1
         ACT(A:Val(FI:1), Val(AA:&i))
         ACT(B:Val(FI:1), Val(AB:&i))
         ACT(C:Val(FI:1), Val(AC:&i))
         ACT(D:Val(FI:1), Val(AD:&i))
         *-Campo5
         ACT(E:Val(FI:1), Val(AE:&i))
         ACT(F:Val(FI:1), Val(AF:&i))
         ACT(G:Val(FI:1), Val(AG:&i))
         ACT(H:Val(FI:1), Val(AH:&i))
         ACT(I:Val(FI:1), Val(AI:&i))
         *-Campo10
         ACT(J:Val(FI:1), Val(AJ:&i))
         ACT(K:Val(FI:1), Val(AK:&i))
         ACN(L:Val(FI:1), Round(Val(AL:&i),11))
         ACN(M:Val(FI:1), Round(Val(AM:&i),11))
         FormatoCeldas(L:Val(FI:1)..M:Val(FI:1), EXE('F0'))
         ACT(R:Val(FI:1), Val(AN:&i))
         ACT(N:Val(FI:1), Val(AR:&i))
         ACT(O:Val(FI:1), Val(AS:&i))
         ACT(P:Val(FI:1), Val(AP:&i))
         ACT(Q:Val(FI:1), Val(AT:&i))
      EndIf
   EndIf
Proximo

