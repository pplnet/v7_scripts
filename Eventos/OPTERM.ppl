ACT(XZ1, SQL("SELECT CodigoBCRA FROM "~DBO~".CLIENTES WHERE Codigo='"~VAR('VEHICULODE')~"' "))

*Tucu 9/01/2025 
*SQL.ADD("SELECT '4601' as Campo1, CL.CodigoBCRA as Campo2,  CASE WHEN O.TipoOp = 'FXCF' THEN '2' ELSE '3' END as Campo4,  ")
SQL.ADD("SELECT '4601' as Campo1, CL.CodigoBCRA as Campo2,  CASE WHEN O.TipoOp = 'FXCF' THEN '1' ELSE '1' END as Campo4,  ")
** AA 23-06-2025 circ BCRA 8258 OPTERMA3=SI por fusion MAE-ROFEX --> A3
If EqStr(VAR('OPTERMA3'),'SI')
   SQL.ADD(" CASE WHEN O.Mercado = 'ROFEX' THEN '11' WHEN O.Mercado = 'MAE' THEN '11' WHEN O.Mercado = 'A3' THEN '11' WHEN O.Mercado = 'BYMA' THEN '10' ELSE '00' END as Campo5,")
Else
   SQL.ADD(" CASE WHEN O.Mercado = 'ROFEX' THEN '02' WHEN O.Mercado = 'MAE' THEN '03' ELSE '00' END as Campo5,")
Endif
SQL.ADD(" O.Especie as Campo7, O.ContraEspecie as Campo8, O.FechaVto as Campo9, ")
** AA 23-06-2025 circ BCRA 8258 OPTERMA3=SI por fusion MAE-ROFEX --> A3
If EqStr(VAR('OPTERMA3'),'SI')
   SQL.ADD(" CASE WHEN O.Mercado = 'ROFEX' THEN '1' WHEN O.Mercado = 'MAE' THEN '1' WHEN O.Mercado = 'A3' THEN '1'ELSE '2' END as Campo10,")
else
   SQL.ADD(" CASE WHEN O.Mercado = 'ROFEX' THEN '1' WHEN O.Mercado = 'MAE' THEN '1' ELSE '2' END as Campo10,")
endif
SQL.ADD(" CASE WHEN O.TipoOp = 'FXCF' THEN '1' WHEN O.TipoOp = 'FXVF' THEN '3' ELSE '0' END as Campo11,")
SQL.ADD(" O.Cantidad as Campo12, O.TotalBrutoCli1 as Campo13, ")
SQL.ADD(" O.NrOperacion3, O.Cliente1, O.CB10, O.TipoOp, O.NrOperacion, ")
SQL.ADD(" CL.Nacionalidad, CL.Sector, E1.ISO as ISO1, E2.ISO as ISO2, ")
SQL.ADD(" O.FechaOp as Campo14, CASE when O.Cliente1 = '"~VAR('VEHICULODE')~"' then '00000000000' else CL.CUIT end as Campo15,")
SQL.ADD(" CASE when O.Cliente1 = '"~VAR('VEHICULODE')~"' then '' else CL.RazonSocial end as Campo16, CL.Pais ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES CL,"~DBO~".ESPECIES E1,"~DBO~".ESPECIES E2 ")
SQL.ADD("WHERE O.TipoOp IN ('FXCF','FXVF') ")
SQL.ADD("AND 0=(Select count(*) from OPERACIONESBITS B where B.NrOperacion=O.NrOperacion  AND ((B.NrBit = 1 and B.Valor = '1') or (B.NrBit = 31 and B.Valor = '1') or (B.NrBit = 30 and B.Valor = '1'))) ")
SQL.ADD("AND O.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha2)~" AND O.FechaCargaSys <= "~IdxDate2(Dialogo.Fecha1))
*SQL.ADD("AND O.FechaOp >= "~IdxDate2(Dialogo.Fecha2)~" AND O.FechaOp <= "~IdxDate2(Dialogo.Fecha1))
*SQL.ADD("AND O.FechavTO = '20241230' ")
SQL.ADD("AND CL.Codigo = O.Cliente1 AND  E1.Codigo = O.Especie AND  E2.Codigo = O.ContraEspecie ")
SQL.ADD("order by Campo5,Cliente1,Campo9,Campo14 ")
WATCH(sql.batch())

Recorrer SQL
  SCN(RE:1, 1)
  ACT(AA:FAC, FBN['Campo1'])
  ACT(AB:FAC, PAD0(val(XZ1),5))
  ACT(AC:FAC, Fecha(Dialogo.Fecha1,'YYYY-MM-DD'))
  
  ACT(AD:FAC, FBN['Campo4'])
  ACT(AE:FAC, FBN['Campo5'])
  
  *- Analizo campo5
  If EqStr(Val(AE:FAC),'0') O  EqStr(Val(AE:FAC),'00')
     *- Si Campo5 es cero => analizo que codigo tiene que tener
     *- obtengo lugar de residencia
     ACT(ZZ:1, FBN['Nacionalidad'])
     *- veo que sector le corresponde
     
     
     If Not EqStr(Val(ZZ:1),'80')
        *- si es extranjero informo 8-Otros
        ACT(AE:FAC, '08')
     Else
**      IND:Industria|COM:Comercio|BAN:Banca|PUB:Publico|STA:Staff|OTR:Otro|"     
        If EqStr(FBN['Sector'],'BAN')
           *- sector financiero
           ACT(AE:FAC, '05')
        Else
           *- sector NO financiero
           ACT(AE:FAC, '06')
        EndIf
     EndIf
  EndIf

* Campo6 siempre va 1
  ACT(AF:FAC, '1')
        
  ACT(AG:FAC, Copy(FBN['ISO1'],1,3))

  ACT(AH:FAC, Copy(FBN['ISO2'],1,3))

  ACT(AI:FAC, Fecha(FBN['Campo9'],'YYYY-MM-DD'))

  ACT(AJ:FAC, FBN['Campo10'])

  *- ANALIZO CAMPO11
  ACT(AK:FAC, FBN['Campo11'])

  ACN(AL:FAC, FBN['Campo12'])

  ACN(AM:FAC, FBN['Campo13'])

  ACT(AN:FAC, IIF(Dialogo.Check1=0, 'N','R'))

  ACT(AO:FAC, FBN['NrOperacion'])
  ACT(AP:FAC, FBN['Cliente1'])
  ACT(AQ:FAC, FBN['TipoOp'])

  ACT(AR:FAC, Fecha(FBN['Campo14'],'YYYY-MM-DD'))

  ** AA 23-06-2025 circ BCRA 8258 OPTERMA3=SI por fusion MAE-ROFEX --> A3 
  ** AA 22-09-2025 Si es cartera propia va siempre ceros
  IF EqStr(FBN['Cliente1'],VAR('VEHICULODE'))
     ACT(AS:FAC, FBN['Campo15'])
  ELSE
     If EqStr(VAR('OPTERMA3'),'SI')
        If Incluido(Val(AE:FAC),'05|06|11')
           ACT(AS:FAC, FBN['Campo15'])
        else
           If Incluido(Val(AE:FAC),'07|08')
              SCN(CT:1,1)
              ACT(AS:FAC, PAD0(Val(XZ:1),5)~PAD0(FBN['Pais'],2)~PAD0(val(CT:1),4))
           else
              ACT(AS:FAC, '00000000000')
           endif
        endif   
     Else
        If Incluido(Val(AE:FAC),'03|05|06')
           ACT(AS:FAC, FBN['Campo15'])
        else
           If Incluido(Val(AE:FAC),'07|08')
              SCN(CT:1,1)
              ACT(AS:FAC, PAD0(Val(XZ:1),5)~PAD0(FBN['Pais'],2)~PAD0(val(CT:1),4))
           else
              ACT(AS:FAC, '00000000000')
           endif
        endif        
     Endif   
  ENDIF   
  ** AA 23-06-2025 circ BCRA 8258 OPTERMA3=SI por fusion MAE-ROFEX --> A3 
  If EqStr(VAR('OPTERMA3'),'SI') 
     If Incluido(Val(AE:FAC),'05|06|07|08|11')
        ACT(AT:FAC, iif(longitud(FBN['Campo16'])>50,Copy(FBN['Campo16'],1,50),FBN['Campo16']))
     Endif
  Else
     If Incluido(Val(AE:FAC),'05|06|07|08')
        ACT(AT:FAC, iif(longitud(FBN['Campo16'])>50,Copy(FBN['Campo16'],1,50),FBN['Campo16']))
     Endif

  Endif

Proximo

