If SQL("Select 1 From "~DBO~".OPERACIONES where TipoOp in ('DDC' ,'DDV')")>0
   SQL.ADD("Delete From "~DBO~".OPERACIONES ")
   SQL.ADD(" Where TipoOp in ('DDC' ,'DDV') and FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.NEW
   SQL.EXEC
EndIf
