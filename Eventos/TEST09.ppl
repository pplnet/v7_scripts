CrearDialogo
   Fecha1: "Fecha"        ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha  Invalida';NO;Fsys;
   Lista2: 'Vehiculos'   ;4;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))

FinDialogo

if Not Ok
  Cancelar
endif


If NoVAcio(Dialogo.Lista2)
   * SQL.ADD(" AND A.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
   MessageBox('No Vacio Lista2; CONTROLA QUE EL VEHICULO FIGURE EN LA LISTA') 
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      * SQL.ADD(" AND A.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
       MessageBox('CONTROLA QUE EL VEHICULO ESTE ASIGNADO AL USUARIO')
   else
       MessageBox('ESTA VACIA LA TABLA UsrVehiculos PARA EL OPERADOR, ENTRA TODO')         
   Endif
Endif

Cancelar ('Fin Test09')

if Vacio(UsrVehiculos(UsuarioActivo)) 
   MessageBox('Vacio') 
Else
   MessageBox('No Vacio') 
endif



SQL.ADD(" Select Distinct TipoTasa ")
SQL.ADD(" from "~DBO~".ESPECIES ")
SQL.ADD(" where TipoTasa is not null OR TipoTasa <> ''  ")
SQL.ADD(" order by TipoTasa ")
Recorrer SQL

ACT(b:1, fbn('TipoTasa'))

ACT(b:2,BuscarCampo('ESPECIES','Codigo','TipoTasa',val(b:1)) )
ACT(b:3,BuscarCampo('ESPECIES','Cupon','TipoTasa',val(b:1)) )
    MessageBox(val(b:2))
    MessageBox(val(b:3))
    cANCELAR(val(b:1))  

Recorrer SQL
    ACT(b:2, fbn('Codigo'))
    ACT(b:3, fbn('Cupon'))

    MessageBox(val(b:2))
    MessageBox(val(b:3))
    Cancelar (val(b:1))  
  
    SQL.ADD(" Select T.Valor1 From "~DBO~".TASASDIA T ")
    SQL.ADD(" Where TipoTasa = '"~fbn('TipoTasa')~"'  ")
    SQL.ADD(" AND Fecha = (Select Max(Fecha) From "~DBO~".TASASDIA T1 ")
    SQL.ADD("              Where T.TipoTasa = T1.TipoTasa ")
    SQL.ADD("              AND T1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
    Recorrer SQL
       ACN(b:1, fbn('Valor1'))            
    Proximo     
    SQL.ADD(" UPDATE "~DBO~".ESPECIES SET ")
    SQL.ADD(" TasaIntVigente = "~Fstr(Val(b:1), 0, 8)~" ")
    SQL.ADD(" where TipoTasa = '"~fbn('TipoTasa')~"' ")
    MessageBox(val(b:2))
    MessageBox(val(b:3))
    MessageBox (val(b:1))  
** 2 Parte 
       If NoVacio(val(b:3)) AND NOT  EqStr(val(b:3),'')
          SQL.ADD(" UPDATE "~DBO~".AGENDACUPONES SET ")
          SQL.ADD(" PorRenta = "~Fstr(Val(b:1), 0, 8)~" ")
          SQL.ADD(" where Especie = '"~val(b:2)~"' AND NrCupon = '"~val(b:3)~"' ")
          MessageBox('entro')
       endif   
   SQL.NEW
   SQL.EXEC    
 
Proximo

HojaVisible(si)

 
