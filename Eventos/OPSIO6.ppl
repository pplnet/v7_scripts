*HOJAVISIBLE(SI)
CrearDialogo
  NrOperacion1: 'Operacion';;;;;;;;;
FinDialogo
if Not OK
  Cancelar
endif
ACT(x1, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))
ACT(x2, BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1))

act(l12,Dialogo.NrOperacion1)
SQL.ADD(" Delete from "~DBO~".EXCEPCIONES where NrOperacion='"~Val(l12)~"' ")
SQL.NEW
SQL.EXEC

***Lee de la tabla OPSIOPEL 
SQL.ADD(" Select O.* from "~DBO~".OPSIOPEL O where ")
SQL.ADD(" O.NrOperacion= '"~Val(l12)~"'            ")
Recorrer SQL
  act(l8,fbn['NrOperacion'])
  act(l7,fbn['CodigoTitulo'])
  act(c13, val(l7))
 
  ***Busco el Cliente
  act(c21,fbn['CodigoRegistro'])
  if Eqstr(Val(c21),'0105')
    act(l13, fbn['AgenteContra'])
    SQL.ADD("Select Codigo,Status from "~DBO~".CLIENTES where NrMAE='"~Val(l13)~"' ")
    Recorrer SQL
      act(l1,fbn['Codigo'])
      act(l28,fbn['Status'])
      if Eqstr(Val(l28),'DES')
        SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
        SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
        SQL.ADD(" Values ")
        SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Cliente no HABILITADO en FPA') ")
        SQL.NEW
        SQL.EXEC
      endif
      Break
    Proximo
  else
    act(l13, fbn['Agente'])
    SQL.ADD("Select Codigo,Status from "~DBO~".CLIENTES where NrMAE='"~Val(l13)~"' ")
    Recorrer SQL
      act(l1,fbn['Codigo'])
      act(l28,fbn['Status'])
      if Eqstr(Val(l28),'DES')
        SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
        SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
        SQL.ADD(" Values ")
        SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Cliente no HABILITADO en FPA') ")
        SQL.NEW
        SQL.EXEC
      endif
      Break
    Proximo
  endif
   
  *** Se toma la especie de la tabla de equivalencias ***
  ACT(c2, SQL(" Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoCotizacion='O' AND TipoNegociacion='"~fbn('CodigoNego')~"' AND EspecieOrigen='"~Val(c13)~"' "))
  if Vacio(Val(c2))
    act(c2,'xxx')
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Especie No Existe en Tabla Equivalencias') ")
    SQL.NEW
    SQL.EXEC
  endif

  ***Busco ContraEspecie  
  if EqStr(fbn('Moneda'),'$')
    ACT(c3, 'ARP')
  endif
  if Vacio(Val(c3))
    act(c3,'yyy')
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Problema con Codigo de ContraEspecie') ")
    SQL.NEW
    SQL.EXEC
  endif

  ***Busco Mercado 
  act(c5,fbn['CodigoRueda']) 
  if Incluido(Val(c5),Var('RUEOCT'))
    ACT(c6, Var('MERCOCT'))
  else
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Rueda No habilitada en variable-"~Val(c5)~"') ")
    SQL.NEW
    SQL.EXEC
  endif
  if Vacio(Val(c6)) o Eqstr(Val(c6),'')
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Mercado No Existe en FPA') ")
    SQL.NEW
    SQL.EXEC
  endif
     
  ***Busco Usuario-Operador
  if Eqstr(Val(c21),'0105') 
    act(c7, fbn['Operador'])
    act(c8, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',Val(c7)))
  else
    act(c7, fbn['OperadorContra'])
    act(c8, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',Val(c7)))
  endif
  if Eqstr(Val(c8),'') o Vacio(Val(c8))
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Operador no existe en FPA') ")
    SQL.NEW
    SQL.EXEC  
  endif

  if Vacio(Val(l1)) o Eqstr(Val(l1),'')
    act(l1,'SIOPEL')
    SQL.ADD(" Insert Into "~DBO~".EXCEPCIONES ")
    SQL.ADD(" (NrOperacion, Tipo, Fecha, Descripcion) ")
    SQL.ADD(" Values ")
    SQL.ADD(" ('"~Val(l8)~"', 'SIOPEL', GetDate(), 'Cliente No Existente en FPA-"~Val(l13)~"' ) ")
    SQL.NEW
    SQL.EXEC
  endif
  if [Eqstr(Val(l1),'SIOPEL') o [Not Eqstr(Val(l1),'SIOPEL') y Eqstr(Val(l28),'DES')]] o Eqstr(Val(c2),'xxx') o Eqstr(Val(c3),'yyy') o [Eqstr(Val(c6),'') o Vacio(Val(c6))] o [Eqstr(Val(c8),'') o Vacio(Val(c8))]
     act(l9,'1')
  else
     act(l9,'0')
  endif
  act(l11,FBN['Secuencia2'])

  SQL.ADD(" Update "~DBO~".OPERACIONES ")
  SQL.ADD("    Set Especie       = '"~Val(c2)~"', ")
  SQL.ADD("        ContraEspecie = '"~Val(c3)~"', ")
  SQL.ADD("        Cliente1      = '"~Val(l1)~"', ")
  SQL.ADD("        Mercado2      = '"~Val(c6)~"', ")
  SQL.ADD("        Operador      = '"~Val(c8)~"', ")
  SQL.ADD("        EsCaucionado  = '"~Val(l9)~"' ")
  SQL.ADD(" where NrOperacion= '"~Val(l8)~"'  ")
  SQL.NEW
  SQL.EXEC

  ModificarOperacion(Val(l8),0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,SI,NO,SI,NO,0,NO)

  if Eqstr(val(l9),'0') 
    AvanzarOperacion(Val(l8),4,1,NO,NO,NO,0)
 
    SQL.ADD(" Update "~DBO~".OPSIOPEL ")
    SQL.ADD(" Set Procesado = '1',")
    SQL.ADD(" Cliente = '"~val(l1)~"',")
    SQL.ADD(" Carga= '1' ")
    SQL.ADD(" where Secuencia2 = '"~val(l11)~"' ")
    SQL.NEW
    SQL.EXEC
  endif
Proximo
