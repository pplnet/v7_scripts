CrearDialogo
  NrOrden1: 'Nro.Orden' ;1;1; ;  ;  ;;;;; 
  Check1  : 'Procesa'   ; ;1; ;SI;SI;;;;0;
FinDialogo
If Not Ok
  Cancelar
EndIf

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(a:1, 'NrOrden')
ACT(a:2, 'TipoOrden')
ACT(a:3, 'Cliente')
ACT(a:4, 'Cuenta1')
ACT(a:5, 'Cuenta4')
ACT(a:6, 'Cuenta5')
ACT(a:7, 'Especie')
ACT(a:8, 'CantidadTotalOrden')
ACT(a:9, 'ContraEspecie')
ACT(a:10, 'CantidadEnProceso')
ACT(a:11, 'TotalAux1')
ACT(a:13, 'Mercado')
ACT(a:14, 'AfectaLS')
ACT(a:15, 'MB2')
ACT(a:16, 'Leyenda3')
ACT(a:20, 'Bloquea')
ACT(a:21, 'Pone Ley3')
ACT(a:22, 'Num 900')
SetFont(a:1..a:25,2)

SQL.ADD("Select * From "~DBO~".ORDENES Where NrOrden='"~Dialogo.NrOrden1~"' ")
Recorrer SQL
  SCN(x:1, 1)
  ACT(b:1, fbn('NrOrden'))
  ACT(b:2, fbn('TipoOrden'))
  ACT(b:3, fbn('Cliente'))
  ACT(b:4, fbn('Cuenta1'))
  ACT(b:5, fbn('Cuenta4'))
  ACT(b:6, fbn('Cuenta5'))
  ACT(b:7, fbn('Especie'))
  ACN(b:8, fbn('CantidadTotalOrden'))
  ACT(b:9, fbn('ContraEspecie'))
  ACN(b:10, fbn('CantidadEnProceso'))
  ACN(b:11, fbn('TotalAux1'))
  ACT(b:13, fbn('Mercado2'))
  ACT(b:14, fbn('AfectaLS'))
  ACN(b:15, fbn('MB2'))
  ACT(b:16, fbn('Leyenda3'))
proximo

if Val(x:1)=0
  if Dialogo.Check1=0
    MessageBox('INGRBO '~Dialogo.NrOrden1~' no encontrada.')
  else
    Cancelar
  endif
else
  if EqStr(Val(b:2),'OTIC') y EqStr(Val(b:13),VAR('MERCADOBT')) y EqStr(Val(b:14),'Saldos') y Val(b:15)=1
    ACT(b:20, 'SI')
  else
    ACT(b:20, 'NO')
  endif
  if EqStr(Val(b:20),'SI')
    #ifdef BIND
      ACT(b:21, 'OK')
    #else
      ACT(b:21, 'ERROR')
    #endif   
  
    If Eqstr(Val(b:21),'OK')
      * Pone Leyenda3 a la orden
      if  Dialogo.Check1=1
        ACT(b:22, GetNumerador(900))
        SQL.ADD("UPDATE "~DBO~".ORDENES ")
        SQL.ADD("  SET Leyenda3 = '"~Val(b:22)~"' ")
        SQL.ADD("Where NrOrden  = '"~Val(b:1)~"' ")
        SQL.NEW
        SQL.EXEC
      else
        Messagebox('Pone Leyenda3 de orden '~Val(b:1)~'.')
      endif
    endif
  endif
  
  SetFont(b:1..b:25,1)
  FormatoCeldas(b:8..b:11,Exe('F2'))
  FormatoCeldas(b:15..b:15,Exe('F0'))
endif

ACO(1, 15)
ACO(2, 15)

