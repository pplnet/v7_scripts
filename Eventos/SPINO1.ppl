CrearDialogo
   Especie1: 'Especie'      ;;;;;;NOVACIO(Dialogo.Especie1) y NOT DESCIENDEDEESPECIE(Dialogo.Especie1, 'MONEDA');'Especie invalida';NO
   Fecha1:   'Record_Date'  ;;;;;;NOVACIO(Dialogo.Fecha1);'Fecha invalida';NO;fsys
   Fecha2:   'Fecha de Pago';;;;;;NOVACIO(Dialogo.Fecha2);'Fecha invalida';NO;fsys
   Mercado1: 'Casa_Custodia'
   Vehiculo1: 'Vehiculo'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo invalido';NO;VAR('VEHICULODE')
   Operador1:'Operador'     ;1;2;;NO;;NoVacio(Dialogo.Operador1);'Operador Invalido';NO;USUARIOACTIVO
FinDialogo

If NOT OK
  Cancelar
Endif

SQL.ADD(" SELECT DISTINCT T.*, C.RazonSocial, E.TamanioLote, CU.Especie1 CUEspecie1, ")
SQL.ADD(" CU.Cantidad1 CUCantidad1, CU.Cliente1 CUCliente1, CU.Mercado1 CUMercado1, CU.Cuenta1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M,  ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".CUOTAS CU")
SQL.ADD(" WHERE T.Cliente1 = C.Codigo  ")
SQL.ADD(" AND   T.Cliente1 = M.Cliente ")
SQL.ADD(" AND   T.NrTrans  = CU.NrOperacion ")
SQL.ADD(" AND   M.Especie  = CU.Especie1    ")
SQL.ADD(" AND   T.Especie  = E.Codigo  ")
SQL.ADD(" AND   T.NrTrans  = M.NrOperacion ")
SQL.ADD(" AND  C.Status = 'HAB' ")
SQL.ADD(" AND ((C.CategDepositante='CLI' ) OR (C.Codigo='"~Dialogo.Vehiculo1~"')) ")
SQL.ADD(" AND   T.TipoTr2  = 'SPINOF' ")
SQL.ADD(" AND   T.Especie  = '"~Dialogo.Especie1~"'")
SQL.ADD(" AND   T.Fecha1   = '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(" AND   T.Fecha2   = '"~IdxDate(Dialogo.Fecha1)~"'")
IF NOVACIO(Dialogo.Mercado1) 
  SQL.ADD(" AND   T.Mercado1 = '"~Dialogo.Mercado1~"'")
ENDIF
SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" ORDER BY T.Cliente1, T.NrTrans")

ACN(z:1,0)
ACT(vh:1, Dialogo.Vehiculo1)
Recorrer SQL
  ACT(a:fac, fbn('Cliente1'))
  ACD(b:fac, fbn('Fecha1'))
