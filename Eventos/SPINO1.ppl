  ACT(g:fac, fbn('Mercado1'))
  ACT(h:fac, fbn('Cuenta4'))
  ACT(i:fac, fbn('Cliente3'))
  ACT(j:fac, fbn('Especie4'))
  ACN(k:fac, fbn('Cantidad5'))
  ACN(l:fac, fbn('Cantidad7'))
  ACT(m:fac, fbn('Cuenta3'))
  ACT(n:fac, fbn('CUEspecie1'))
  ACN(o:fac, fbn('CUCantidad1'))
  ACT(p:fac, fbn('CUCliente1'))
  ACT(q:fac, fbn('CUMercado1'))
  ACT(r:fac, fbn('CUCuenta1'))
  ACT(s:fac, fbn('NrTrans'))
  ACN(u:fac, fbn('Cambio5'))

  ACN(x:fac, 1) 
  ACN(z:1, 1) 
Proximo

IF Val(z:1)=0
