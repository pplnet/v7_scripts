Recorrer&i 1,fac 
 IF Val(x:&i)=1
    *------------------Pasa MovPendientes a Ejecutados --------------------*
    
    SQL.ADD(" UPDATE "~DBO~".CUOTAS SET ")
    SQL.ADD(" Cuenta1  = '"~Val(r:&i)~"', ")
    SQL.ADD(" Cliente1 = '"~Val(p:&i)~"'  ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(s:&i)~"' AND Especie1 = '"~Val(n:&i)~"' ")
    SQL.NEW

    SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 SET ")
    SQL.ADD(" Cuenta4  = '"~Val(h:&i)~"', ")
    SQL.ADD(" Cliente3 = '"~Val(i:&i)~"', ")
    SQL.ADD(" Cuenta3  = '"~Val(m:&i)~"' ")
    SQL.ADD(" WHERE NrTrans = '"~Val(s:&i)~"' ")
    SQL.NEW
    SQL.EXEC

    SQL.ActualizarMovimientosT4(Val(n:&i),SI,SI,SI,SI,SI,SI)
    SQL.EXEC

    SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS   ")
    SQL.ADD(" SELECT * FROM "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(s:&i)~"' ")
    SQL.ADD(" AND   NrMov IN (2,3,4) ")
    SQL.NEW
    SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES   ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(s:&i)~"' ")
    SQL.ADD(" AND   NrMov IN (2,3,4) ")
    SQL.NEW


    SQL.ADD(" INSERT INTO "~DBO~".MOVEJECUTADOS   ")
    SQL.ADD(" SELECT * FROM "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(s:&i)~"' ")
    SQL.ADD(" AND   Especie     = '"~Val(n:&i)~"' ")
    SQL.NEW
    SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES   ")
    SQL.ADD(" WHERE NrOperacion = '"~Val(s:&i)~"' ")
    SQL.ADD(" AND   Especie     = '"~Val(n:&i)~"' ")
    SQL.NEW

    SQL.EXEC

    message('Transaccion '~Val(s:&i)~' Confirmada.')
    *----------------------------------------------------------------------*
 ENDIF
Proximo