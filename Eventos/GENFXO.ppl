*** Lee de la tabla OPSIOPEL todo lo que esta sin procesar 
CrearDialogo
  Check1: 'Procesa';1;1; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif
ACT(v:5, VAR('AGESIOP'))
* xFXO
*ACT(w:2, VAR('CONTROLAPM'))
** FJL 18/07/19 - El mensaje pro especie sancionada lo saca de la variable
*ACT(w:4, VAR('MSGSISEXT'))

ACT(s:1, 'x Secuencia2')
ACT(s:2, 'x TipoOp')
ACT(s:3, 'x Especie')
ACT(s:4, 'x ContraEsp')
ACT(s:5, 'x FechaOp')
ACT(s:6, 'x Puesto')
ACT(s:7, 'x ValorRB1')
ACT(s:8, 'x Feriados')
ACT(s:9, 'Plazo')
ACT(s:10, 'FechaVto - 10')
ACT(s:11, 'FechaPago')

ACT(s:13, 'x Precio')
ACT(s:14, 'x Cantidad MAE')
ACT(s:15, 'x Cantidad')
ACT(s:16, 'x TBC1 MAE')
ACT(s:17, 'x TBC1')

ACT(s:18, 'x Cuenta1')

ACT(s:19, 'Book1')
ACT(s:20, 'Book - 20')
ACT(s:21, 'FormaLiq1')
ACT(s:22, 'x Mercado')
ACT(s:23, 'x Mercado2')
          
ACT(s:27, 'x Habiles Spot')
ACT(s:28, 'x Plazo MAE')
ACT(s:29, 'x FVto MAE')
ACT(s:30, 'x Spot/Fut MAE - 30')
ACT(s:31, 'x Cpra/Vta')
ACT(s:32, 'x Spot/Fut')
ACT(s:33, 'x Camb/Arb')
          
ACT(s:34, 'x ClieMAE')
ACT(s:35, 'x ClieMAE(Num)')
ACT(s:36, 'x Cliente')
ACT(s:37, 'x Op.Contra')
ACT(s:38, 'x Nr.Oper')
ACT(s:39, 'x Operador')
ACT(s:40, 'Numerador - 40')
ACT(s:41, 'NrOperacion')
ACT(s:42, 'NrAltaMAE')
ACT(s:43, 'Rueda')
ACT(s:44, 'Mercado')
ACT(s:45, 'Vehiculo')
ACT(s:46, 'CodigoTitulo')
ACT(s:47, 'FechaAltaMAE')

ACT(s:51, 'z:!')
ACT(s:52, 'Controles')

if Dialogo.Check1=0
  recorrer&i 1,52
    ACT(bz:&i, Val(s:&i))
  proximo
endif

SQL.ADD("Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoRegistro in ('0105','0205')  ")
SQL.ADD("    and CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGFX'))~")  ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUEFX'))~") ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                      ")
SQL.ADD("    and Carga       is null                                    ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                            ")
*SQL.ADD("    and Secuencia2      = '22110812293900003' ")

watch(SQL.BATCH())
Recorrer SQL
  ACN(z:1,0)
  ACT(a:FAC, fbn('Secuencia2'))
  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..t:95)
  BorrarCeldas(e:1..f:10)
  BorrarCeldas(es:1..es:2)
  BorrarCeldas(cl:1)

  if SI
    ***** Secuencia2
    ACT(t:1, fbn('Secuencia2'))
    * Secuencia (NrAltaMAE)
    act(t:42, fbn('Secuencia'))
    * Rueda
    act(t:43, fbn('CodigoRueda'))
    * MeracdoNegociacion
    *ACT(t:44, VAR('MERCADOFX'))
    ACT(t:44, VAR('AMBMAE'))
    * Vehiculo
    ACT(t:45, VAR('VEHICULODE'))
    * CodigoTitulo
    act(t:46, fbn('CodigoTitulo'))
    * FechaAltaMAE
    ACT(t:47, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))

    ** Compra / Venta
    if EqStr(fbn('CodigoRegistro'),'0105')
      ACN(t:31,2)
    else
      if EqStr(fbn('CodigoRegistro'),'0205')
        ACN(t:31,1)
      else
        SCN(z:1,1)
        message('Error en tipo de operacion')
        ACN((26+fac):2, 1)
      endif
    endif

    if EqStr(fbn('Agente'),Val(v:5))
      ***** ClienteMAE
      ACT(t:34, fbn('AgenteContra'))
      ***** Operador Contra
      ACT(t:37, fbn('OperadorContra'))
      ***** Nr Oper Propio
      ACT(t:38, fbn('Operador'))
    else
      if EqStr(fbn('AgenteContra'),Val(v:5))
        ***** ClienteMAE
        ACT(t:34, fbn('Agente'))
        ***** Operador Contra
        ACT(t:37, fbn('Operador'))
        ***** Nr Oper Propio
        ACT(t:38, fbn('OperadorContra'))
      else
        SCN(z:1,1)
        ACN((26+FAC):31, 1)
        Message('Cliente inexistente o error en Agente MAE')
      endif
    endif

    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05')
      ACD(t:5, Fecha(fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')))
      ACT(xx1, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACT(xx2, Val(xx1)~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
      ACT(xx3, SQLFechaStr(Val(xx2),Exe('FORFECHOR')))
    else
      SCN(z:1,1)
      ACN((26+FAC):5, 1)
      Message('Error en FechaOp')
    endif

    ***** Plazo MAE
    ACN(t:28, Num(fbn('Plazo')))
    ***** FechaVto MAE
    ACD(t:29, Val(t:5)+Val(t:28))

    ***** Tabla Feriados
*      ACT(t:8, Sql("Select Trim(Substr(Valor,90,10)) from "~DBO~".CONSTANTES Where Tipo='TABLASMAE' and Substr(Valor,1,3)='ELI' and Substr(Valor,30,1) = '"~Copy(Val(a:fac),91,1)~"' ")  )
    If Vacio(Val(t:8))
      ACT(t:8,'ARG') 
    Endif
      
    ** Spot / Futuro MAE
    if Incluido(fbn('CodigoNego'), Var('TIPONEGFX') )
      * Spot
      ACN(t:30,1)
    else
      if Incluido(fbn('CodigoNego'), Var('TIPONEGFX') )
        * Futuro
        ACN(t:30,2)
      else
        SCN(z:1,1)
        ACN((26+FAC):30, 1)
        Message('No es spot ni futuro')
      endif
    endif

    ** Spot / Futuro
    if Val(t:30)=1
      * Spot MAE
      ACN(t:27, DifDias(Val(t:29),Val(t:5),Val(t:8),SI))
      if Val(t:27)>3
        ACN(t:32,2)
      else
        ACN(t:32,1)
      endif
    else
      if Val(t:30)=2
        * Futuro MAE
        ACN(t:32,2)
      else
        SCN(z:1,1)
        ACN((26+FAC):32, 1)
        Message('Error en spot/futuro')
      endif
    endif
      
    ** Clase
    if EqStr(fbn('Clase'),'C') o EqStr(fbn('Clase'),'E')
      * Cambio
      ACN(t:33,1)
    else
      if EqStr(fbn('Clase'),'A')
        * Arbitraje
        ACN(t:33,2)
      else
        if EqStr(fbn('Clase'),'J')
          * Canje
          ACN(t:33,2)
          If Val(t:31)=1
            acn(u:31,2)
          Else
            acn(u:31,1)
          Endif
        else
          SCN(z:1,1)
          ACN((26+FAC):33, 1)
          Message('Nos es cambio, arbitraje ni Canje')
        endif
      endif
    endif
      
    If Incluido(fbn('CodigoRueda'),'MOME|MOMX|')
      * Ruedas Canje - No deberia entrar
      If EqStr(Copy(Val(a:fac),28,4),'0205')
        ACT(t:2,'MOMEC')
      Else
        If EqStr(Copy(Val(a:fac),28,4),'0105')
          ACT(t:2,'MOMEV')
        Endif
      Endif
      * Numerador 26 - 
      acn(t:40,26)
    Else
      * Numerador 35
      acn(t:40,35)
      ***** Tipo Op
      if Val(t:32)=1
        * Spot
        if Val(t:33)=1
          * Cambio
          if Val(t:31)=1
            * Compra
            ACT(t:2,'FXC')
          endif
          if Val(t:31)=2
            * Venta
            ACT(t:2,'FXV')
          endif
        endif
        if Val(t:33)=2
          * Arbitraje/Canje
          if Val(t:31)=1
            * Compra
            ACT(t:2,'FXC')
          endif
          if Val(t:31)=2
            * Venta
            ACT(t:2,'FXV')
          endif
        endif
      endif

      if Val(t:32)=2
        * Futuro
        if Val(t:33)=1
          * Cambio
          if Val(t:31)=1
            * Compra
            ACT(t:2,'FXCT')
          endif
          if Val(t:31)=2
            * Venta
            ACT(t:2,'FXVT')
          endif
        endif
        if Val(t:33)=2
          * Arbitraje/Canje
          ACT(t:2,'FXAT')
        endif
      endif
    Endif
    if Vacio(Val(t:2))
      SCN(z:1,1)
      ACN((26+FAC):2, 1)
      Message('Tipo de operacion desconocido')
    endif

    ***** Cliente
    ACN(t:35, Val(t:34))
    if Eqstr(Val(t:34),'000') o Vacio(Val(t:34)) o Eqstr(Val(t:34),Val(v:5))
      SCN(z:1,1)
      ACN((26+FAC):4, 1)
      Message('Error en Cliente '~Val(t:34))
    else
      ***** Codigo Cliente
      ACT(t:36, SQL("Select Codigo from "~DBO~".CLIENTES Where NrMAE = '"~Val(t:34)~"'  and Status='HAB' "))
    endif
    If Vacio(Val(t:36))
      ACN(cl:1,1)
      ACT(t:60, 'Cliente no existente en FPA. Nr MAE : '~Val(t:34))
    Endif

    ** Especie
    ** ContraEspecie
    ** Mnemotecnico 176-30-205
    if Val(t:33)=1
      * Cambio
      if EqStr(Copy(fbn('Mnemotecnico'),1,2),'US')
        if EqStr(Copy(fbn('Mnemotecnico'),3,1),'T|E|M|')
          ACT(t:3, 'USD')
        endif
        if EqStr(Copy(fbn('Mnemotecnico'),3,1),'B')
          ACT(t:3, 'USB')
        Else
          ACT(t:3, 'USD')
        endif
      endif
      if EqStr(Copy(fbn('Mnemotecnico'),1,2),'YE')
        ACT(t:3, 'JPY')
      endif
      if Incluido(Copy(fbn('Mnemotecnico'),1,2),'EB')
        ACT(t:3, 'EURB')
      endif
      if Incluido(Copy(fbn('Mnemotecnico'),1,2),'ET')
        ACT(t:3, 'EURO')
      endif
*      if [EqStr(Copy(fbn('Mnemotecnico'),7,2),'AR') y EqStr(Copy(fbn('CodigoRueda'),1,3),'CAM')] o [EqStr(Copy(fbn('Mnemotecnico'),5,2),'AR') y Not EqStr(Copy(fbn('CodigoRueda'),1,3),'CAM')]
*        ACT(t:4, 'ARP')
*      endif
      ACT(t:4, 'ARP')
    endif

    if Vacio(Val(t:3))
      SCN(z:1,1)
      ACN((26+FAC):3, 1)
      Message('Error en especie')
    endif

    if Vacio(Val(t:4))
      SCN(z:1,1)
      ACN((26+FAC):4, 1)
      message('Error en contraespecie')
    endif
      
    *********************
    if Val(z:1)>0
      ACT(t:52, 'No paso el primer control')
    endif
    *********************
    
    if Val(z:1)=0
      **** Puesto
      if Val(t:32)=1
        * Spot
        if Incluido(fbn('CodigoRueda'), Var('RUEFX') ) 
          if Incluido(fbn('TipoLiquidacion'),'1') o SI
            ACN(t:6, 1)
          else
            ACN(t:6, 0)
          endif
        else
          if EqStr(Copy(fbn('Mnemotecnico'),9,1),'P')
            ACN(t:6, 1)
          else
            ACN(t:6, 0)
          endif
        endif 
      endif
      
      **** ValorRB1
      if Val(t:32)=1
        * Spot
        ACN(t:7, Val(t:27))
      endif

      if Vacio(Val(t:36))
        * Vacio Cliente
        ACT(t:36, 'SIOPEL')
        ACN((26+FAC):36, 1)
      endif
      
      *********************
      if Val(z:1)>0
        ACT(t:52, 'No paso el segundo control')
      endif
      *********************
    endif

    if Val(z:1)=0
      ***** Precio1
      if Incluido(fbn('CodigoRueda'),'MOME|MOMX|')
        ACN(t:13, 1)
      Else
        ACN(t:13, fbn('Precio'))
        If Val(t:33)=2 y Val(t:13)=1
          * Canje y Precio 1
          acn(t:13,0)
        Else
          If Val(t:13)=0
            If Val(t:33)<>2
              SCN(z1,1)
              ACN((26+FAC):13, 1)
            Endif
          Endif
        Endif
      Endif
      ***** Cantidad
      ***** TotalBrutoCli1
      if Val(t:33)=1
        * Cambio
        ACN(t:14, fbn('Cantidad'))
        ACN(t:15, Val(t:14))
        ACN(t:16, fbn('Valorizacion'))
        ACN(t:17, Val(t:15)*Val(t:13))
      else
        ACN(t:14, fbn('Cantidad'))
        ACN(t:15, Val(t:14))
        ACN(t:17, Val(t:15)*Val(t:13))
        ACN(t:16, fbn('Valorizacion'))
      endif
      if Val(t:15)<=0
        SCN(z1,1)
        ACN((26+FAC):15, 1)
      endif
      if Val(t:17)<=0
        If Val(t:33)<>2
          SCN(z1,1)
          ACN((26+FAC):17, 1)
        Endif
      endif

      ***** Forma Liquidacion
      ACN(t:21, 0)
      if Incluido(fbn('TipoLiquidacion'),'1' ) 
        * DVP
        ACN(t:21, 1)
      endif
      if Incluido(fbn('TipoLiquidacion'),'6' ) 
        * RVP
        ACN(t:21, 2)
      endif
      
      ***** Mercados Liquidacion
      ACT(t:22, MercadoDef(Val(t:3)))
      ACT(t:23, MercadoDef(Val(t:4)))
      if Incluido(fbn('EnteLiquidador'),'5') 
        * Entre Partes (Arg)
        ACT(t:22, MercadoDef(Val(t:3)))
        ACT(t:23, MercadoDef(Val(t:3)))
      endif
* FJL 06/02/24 - Por Issue EXTBACS-7067 - Operaciones VENTA DE MONEDA
*      if Incluido(fbn('TipoLiquidacion'),'j') 
*        * MEP C
*        ACT(t:22, 'MEP')
*        ACT(t:23, 'MEP')
*      endif
      if Incluido(fbn('EnteLiquidador'),'j') 
        * MEP C
        if EqStr(Val(t:46),'USMEP')
          ACT(t:22, 'BCRA')
        endif
      endif
      
      ***** Operador
      ACT(t:39, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', Val(t:38)))
      if Vacio(Val(t:39))
        ACT(t:39, UsuarioActivo)
        ACN((26+FAC):39, 1)
      endif
      *********************
      if Val(z:1)>0
        ACT(t:52, 'No paso el tercer control')
      endif
      *********************
    endif


    ACN(t:51, Val(z:1))    
    if Val(z:1)=0
        * No tuvo errores
        ACT(b:FAC, 'OK')
        if Dialogo.Check1=0
*          ACT(w:6, GetNumerador(Val(t:40)))
          ACT(c:FAC, 'Sin Numerador')
          ACT(t:41, 'Sin Procesar')
          MessageBox('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:36))
        endif      
        if Dialogo.Check1=1
          ACT(w:6, GetNumerador(Val(t:40)))
          ACT(c:FAC, Val(w:6))
          ACT(t:41, Val(w:6))
          Message('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:36))

          SQL.ADD("Insert into "~DBO~".OPERACIONES (")
          
          SQL.ADD("NrOperacion, ")
          SQL.ADD("TipoOp, ")
          SQL.ADD("Cliente1, ")
          SQL.ADD("Especie, ")

          SQL.ADD("ContraEspecie, ")
          SQL.ADD("Cantidad, ")
          SQL.ADD("Precio1, ")
          SQL.ADD("FechaOp, ")

          SQL.ADD("ValorRB1, ")
          SQL.ADD("Puesto, ")
          SQL.ADD("Mercado, ")
          SQL.ADD("Mercado2, ")

          SQL.ADD("Mercado4, ")
          SQL.ADD("FormaLiquidacion1, ")
          SQL.ADD("TablaFeriados1, ")
          SQL.ADD("Operador, ")

          SQL.ADD("OpSIOPEL, ")
          SQL.ADD("EnteCus1, ")
          SQL.ADD("EnteCus2, ")
          SQL.ADD("Vehiculo1, ")
          
          SQL.ADD("CB5, ")
          SQL.ADD("UDN2, ")
          SQL.ADD("AceptaMAE, ")
          SQL.ADD("NroAltaMAE, ")

          SQL.ADD("FechaAltaMAE, ")
          SQL.ADD("Cuenta1, ")
          SQL.ADD("Numerador, ")
          SQL.ADD("FechaCarga, ")

          SQL.ADD("FechaCargaSys, ")
          SQL.ADD("UsrInput, ")
          SQL.ADD("Direccion ")

          SQL.ADD(") values (")
          
          * NrOperacion
          SQL.ADD(" '"~Val(w:6)~"', ")
          * TipoOp
          SQL.ADD(" '"~Val(t:2)~"', ")
          * Cliente1
          SQL.ADD(" '"~Val(t:36)~"', ")
          * Especie
          SQL.ADD(" '"~Val(t:3)~"', ")

          * ContraEspecie
          SQL.ADD(" '"~Val(t:4)~"', ")
          * Cantidad
          SQL.ADD(" "~FStr(Val(t:14),0,2)~", ")
          * Precio1
          SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
          * FechaOp
          SQL.ADD(" '"~IdxDate(Val(t:5))~"', ")

          * ValorRB1
          SQL.ADD(" "~FStr(Val(t:7),0,0)~", ")
          * Puesto
          SQL.ADD(" "~FStr(Val(t:6),0,0)~", ")
          * Mercado
          SQL.ADD(" '"~Val(t:22)~"', ")
          * Mercado2
          SQL.ADD(" '"~Val(t:23)~"', ")

          * Mercado4
          SQL.ADD(" '"~Val(t:44)~"', ")
          * FormaLiquidacion1
          SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
          * TablaFeriados1
          SQL.ADD(" '"~Val(t:8)~"', ")
          * Operador
          SQL.ADD(" '"~Val(t:25)~"', ")

          * OpSIOPEL
          SQL.ADD(" '"~Val(t:26)~"', ")
          * EnteCus1 - CodigoTitulo
          SQL.ADD(" '"~Val(t:46)~"', ")
          * EnteCus2 - AgenteContra
          SQL.ADD(" '"~Val(t:34)~"', ")
          * Vehiculo1
          SQL.ADD(" '"~Val(t:45)~"', ")

          * CB5 (Oferta)
          SQL.ADD(" '1', ")
          * UDN2 (Rueda)
          SQL.ADD(" '"~Val(t:43)~"', ")
          * AceptaMAE
          SQL.ADD(" 'SI', ")
          * NroAltaMAE
          SQL.ADD(" '"~Val(t:42)~"', ")

          * FechaAltaMAE
          SQL.ADD("Convert(datetime,'"~Val(t:47)~"',120), ")
          * Cuenta1
          SQL.ADD(" '"~Val(t:18)~"', ")
          * Numerador
          SQL.ADD(" 1, ")
          * FechaCarga
          SQL.ADD(" "~SQLAhora~", ")

          * FechaCargaSys
          SQL.ADD(" "~IdxDate2(FSys)~", ")
          * UsrInput
          SQL.ADD(" '"~UsuarioActivo~"', ")
          * Direccion
          SQL.ADD(" 2 ")

          SQL.ADD(")")
          SQL.NEW

          SQL.ADD("Update "~DBO~".OPSIOPEL ")
          SQL.ADD("   Set Procesado   = '1',")
          SQL.ADD("       Carga       = '1', ")
          SQL.ADD("       NrOperacion = '"~Val(w:6)~"' ")
          SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
          SQL.NEW
          SQL.EXEC

          Message('Modificar Operacion '~Val(w:6))
          ModificarOperacion(Val(w:6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
          
          IF Ok
            ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
            SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w:6)~"' ")
            SQL.NEW
            SQL.EXEC                   
          Endif
          Message('Fin Modificar Operacion')
          
          ** FJL 05/07/23 - Se agrega la asignacion de NrBoleto porque con el Workflow reducdio la Operacion ya no va a CargaTrader donde se asignaba
          EjecutarEvento('ASBOFX', NrOperacion1 = Val(w:6), Check1 = 1, Check2 = 0)
        endif
        
        If Val(cl:1) = 1
          Message('Operacion '~Val(w:6)~' Ok. Pasa a Instancia 4')        
          ACT(d:FAC, 'A inst 4')
          ACN(i:FAC, Val(cl:1))
          if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
            SQL.ADD("   Set Valor       = '0'  ")
            SQL.ADD(" where NrOperacion = '"~Val(w:6)~"' ")
            SQL.ADD("   and Valor       = '1' ")
            SQL.NEW
            SQL.EXEC           
            SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
            SQL.ADD("   Set Valor       = '1'  ")
            SQL.ADD(" where NrOperacion = '"~Val(w:6)~"' ")
            SQL.ADD("   and Nrbit       = 4 ")
            SQL.NEW
            SQL.ADD("Update "~DBO~".OPERACIONES  ")
            SQL.ADD("   Set Direccion    = 2,  ")
            SQL.ADD("       EsCaucionado = '1'  ")
            SQL.ADD(" where NrOperacion  = '"~Val(w:6)~"' ")
            SQL.NEW      
            SQL.EXEC
          endif
        endif
    else
      ACT(b:FAC, 'Error')
    endif      
      
    if Dialogo.Check1=0
      ACT((78+FAC):1,  Val(t:1))
      ACT((78+FAC):2,  Val(t:2))
      ACT((78+FAC):3,  Val(t:3))
      ACT((78+FAC):4,  Val(t:4))
      ACD((78+FAC):5,  Val(t:5)) 
      ACN((78+FAC):6,  Val(t:6))
      ACN((78+FAC):7,  Val(t:7))
      ACT((78+FAC):8,  Val(t:8))
