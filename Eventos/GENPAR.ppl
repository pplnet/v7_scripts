**HojaVisible(SI)
***---Obtengo carteras que valuan por Partida
(.'BOOKPARTID'.)
Recorrer SQL
    DFA
    ACT(BK:1, Val(BK:1)~'|'~fbn('Books'))
Proximo

CrearDialogo
  Vehiculo1:'Vehiculo'  ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
  Fecha1   :'Fecha'     ;;;;;;Dialogo.Fecha1 >= FSys-VAR('DIASPAR') Y Dialogo.Fecha1 >= Fecha(Var('FEINIPART'));'FechaOp Desde Invalida';NO;FSys
  Book1    :'Cartera'   ;;;;;;;;;;;;;;" Codigo IN ("~Pipe2Comillas(Val(BK:1))~") ";
FinDialogo

If not Ok
   Cancelar
Endif

let &monedaLocal Var('MONELOCA')

acn(mar1,0)

SQL.ADD("SELECT M.FechaMov ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND M.FechaMov    <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
SQL.ADD("   and M.Cantidad   >= 0 ")
SQL.ADD("   and M.NrSaldo     = '101' ")
SQL.ADD("   and M.Vehiculo    = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.Cliente     = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.TipoNegocio = 'T' ")
SQL.ADD("   and O.TipoOp = 'TIC'  ")
If NoVacio(Dialogo.Book1)
   SQL.ADD("   and M.Book     = '"~Dialogo.Book1~"' ")
ELSE
   SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")
EndIf
SQL.ADD("   and O.NrOperacion Not In  ")
SQL.ADD("       (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
SQL.ADD("GROUP BY M.FechaMov ") 

SQL.ADD(" UNION ALL ")

SQL.ADD("SELECT M.FechaMov ")
SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPOSEJE M ")
SQL.ADD(" Where T.NrTrans     = M.NrOperacion ")
SQL.ADD(" AND M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Fecha(Var('FEINIPART')))~"' ")
SQL.ADD("   and M.Cantidad   >= 0 ")
SQL.ADD("   and M.NrSaldo     = '101' ")
SQL.ADD("   and M.Vehiculo    = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.Cliente     = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and M.TipoNegocio = 'T' ")
***---SQL.ADD(" AND T.TipoTr2 IN ('DTP','TRPOS','DRT') ")
SQL.ADD(" AND T.TipoTr2 IN ('DTP','TRPOS') ")
If NoVacio(Dialogo.Book1)
   SQL.ADD(" and M.Book  = '"~Dialogo.Book1~"' ")
   SQL.ADD(" AND (T.Book2 = '"~Dialogo.Book1~"' OR T.TipoTr2 <> 'TRPOS') ")
ELSE
   SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")
   SQL.ADD(" AND (T.Book2 IN ("~Pipe2Comillas(Val(BK:1))~") OR T.TipoTr2 <> 'TRPOS') ")
EndIf
SQL.ADD("   and T.NrTrans     Not In  ")
SQL.ADD("       (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
SQL.ADD("GROUP BY M.FechaMov ")
act(k1,'')
watch(sql.batch)
Recorrer SQL
   *- Selecciono todas las operaciones con fecha del dia que no tengan asociadas partidas
   *- CBC y PABC No Afectan Posiciones ya que no se liquida la especie
   ***---Para las operaciones tomaremos el PrecioOp en ContraEspecie, para las transacciones el precio de las posiciones en Cotiza
   SQL.ADD(" Select M.NrSaldo, O.FechaOp, O.Vehiculo1, O.Especie, M.Cantidad, O.Precio1 Precio, ")
   SQL.ADD("        O.FechaVto, O.TipoOp, O.NrOperacion, M.Book, M.Cupon, M.FechaMov, E.Cotiza, E.MonedaEmision, O.Plaza1 CtaCustodia, 0 as Tipo, O.ContraEspecie ")
   SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E ")
   SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
   SQL.ADD(" AND E.Codigo = O.Especie ")
   SQL.ADD(" AND M.Especie = O.Especie ")
   SQL.ADD("   and M.FechaMov    = '"~IdxDate(fbn['FechaMov'])~"' ")
   SQL.ADD("   and M.Cantidad   >= 0 ")
   SQL.ADD("   and M.NrSaldo     = '101' ")
   SQL.ADD("   and M.Vehiculo    = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD("   and M.Cliente     = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD("   and M.TipoNegocio = 'T' ")
   If NoVacio(Dialogo.Book1)
      SQL.ADD("   and M.Book     = '"~Dialogo.Book1~"' ")
   ELSE
      SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")
   EndIf
   SQL.ADD("   and O.NrOperacion Not In  ")
   SQL.ADD("       (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   SQL.ADD(" Union All ")
   SQL.ADD(" Select M.NrSaldo, T.Fecha1 as FechaOp, T.Vehiculo1, T.Especie, M.Cantidad, ")
   SQL.ADD("        M.Precio, T.Fecha1 FechaVto, T.TipoTr2 TipoOp,T.NrTrans NrOperacion, ")
   SQL.ADD("        M.Book, M.Cupon, M.FechaMov, E.Cotiza, E.MonedaEmision, T.Cuenta1 CtaCustodia, 1 as Tipo, E.Cotiza ContraEspecie ")
   SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E ")
   SQL.ADD(" Where T.NrTrans     = M.NrOperacion ")
   SQL.ADD(" AND E.Codigo = T.Especie ")
   SQL.ADD(" AND M.Especie = T.Especie ")
   SQL.ADD("   and M.FechaMov    = '"~IdxDate(fbn['FechaMov'])~"' ")
   SQL.ADD("   and M.Cantidad   >= 0 ")
   SQL.ADD("   and M.NrSaldo     = '101' ")
   SQL.ADD("   and M.Vehiculo    = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD("   and M.Cliente     = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" AND T.TipoTr2 IN ('DTP','TRPOS') ")
   SQL.ADD("   and M.TipoNegocio = 'T' ")
   If NoVacio(Dialogo.Book1)
      SQL.ADD("   and M.Book     = '"~Dialogo.Book1~"' ")
   ELSE
      SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")
   EndIf
   SQL.ADD("   and T.NrTrans Not In  ")
   SQL.ADD("       (Select NrOperacion FROM "~DBO~".PARTIDAS) ")
   SQL.ADD(" Order By 7, 3, 4, 10, 12, 1, 11")
   
   ACN(aa5,0 )
   watch(sql.batch)
   Recorrer SQL
      scn(mar1,1)
      ACT(ME:88, fbn('MonedaEmision'))

      *- Calculo la Sumatoria de Operaciones y Transacciones Especie-Vehiculo-FechaOp-Cartera
      If [[fbn['FechaVto']<>val(aa3)] o [fbn['FechaOp'] <> Val(FE:99)] o [Not Eqstr(&ctaCustodia, fbn('CtaCustodia'))] o [Not EqStr(FBN['Vehiculo1'],val(aa2))] o [Not EqStr(FBN['Especie'],val(aa1))] o [fbn['Cupon']<>val(aa7)] o [fbn['NrSaldo']<>val(aa4)]  o [Not EqStr(FBN['Book'],val(aa6))]] y [val(aa5)<>0]
        (.'GENPARTIDA'.)
        *- Inicializo variables de suma
         ACN(ee1,0)
         ACN(ff1,0)
         act(k1,'')
      Endif

      If [[fbn['FechaVto']<>val(aa3)] o [fbn['FechaOp'] <> Val(FE:99)] o [Not Eqstr(&ctaCustodia, fbn('CtaCustodia'))] o [Not EqStr(FBN['Vehiculo1'],val(aa2))] o [Not EqStr(FBN['Especie'],val(aa1))] o [fbn['Cupon']<>val(aa7)] o [fbn['NrSaldo']<>val(aa4)]  o [Not EqStr(FBN['Book'],val(aa6))]]
         ACD(aa3, FBN['FechaVto'])
         ACD(FE:99, fbn('FechaOp'))
         ACT(aa2,FBN['Vehiculo1'])
         ACT(aa1,FBN['Especie'])
         ACN(aa7,FBN['Cupon'])
         ACN(aa4,FBN['NrSaldo'])
         ACT(aa6,FBN['Book'])
         let &ctaCustodia fbn('CtaCustodia')
         ACN(aa5,fac )

         acn(ee1,0)
         acn(ff1,0)
         act(k1,'')
      EndIf
      
      ACD(b:fac,fbn['FechaOp'])
      ACT(c:fac,FBN['Vehiculo1'])
      ACT(d:fac,FBN['Especie'])
      SCN(ee1,FBN['Cantidad'])
      ***---IF Eqstr(fbn('Cotiza'), fbn('MonedaEmision'))
      IF Eqstr(fbn('ContraEspecie'), fbn('MonedaEmision'))
        SCN(ff1,FBN['Cantidad']*FBN['Precio'])
        let &precioPartida fbn('Precio')
      ELSE
        ***---El precio que se levanta está en Cotiza y debemos llevarlo en MonedaEmision
        let &precioPartida fbn('Precio') * CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,fbn('MonedaEmision'))
        SCN(FF:1, fbn('Cantidad') * &precioPartida)
      ENDIF
      IF fbn('Tipo') = 0
        SQL.ADD(" Update "~DBO~".OPERACIONES ")
        SQL.ADD(" Set PrecioPartida = "~Fstr(&precioPartida, 0, 8)~" ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
      ELSE
        SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
        SQL.ADD(" Set PrecioPartida = "~Fstr(&precioPartida, 0, 8)~" ")
        SQL.ADD(" Where NrTrans = '"~fbn('NrOperacion')~"' ")
      ENDIF
      SQL.NEW
      SQL.EXEC
      ACD(g:fac,FBN['FechaVto'])
      ACT(h:fac,FBN['TipoOp'])
      ACT(i:fac,FBN['NrOperacion'])
      ACN(l:fac,FBN['Cupon'])
      ACT(m:fac,FBN['Book'])
      
      *- k: Lista de Operaciones que Forman la Partida
      ACT(k1,val(k1)~FBN['NrOperacion']~'|')
   Proximo

   If val(aa5)<>0
      (.'GENPARTIDA'.)
   EndIf
Proximo

If Val(mar1) =0
   Cancelar('No existen partidas para generar para el dia '~Dialogo.Fecha1)
endif
