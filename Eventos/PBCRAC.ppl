CrearDialogo
    Cliente1       : 'Cliente'             ;;;;;;NoVacio(Dialogo.Cliente1);'Ingrese un Cliente';No;;
    Cantidad1      : 'RPC'                 ;1;2;;;;;;;;num(query("select rpc from "~DBO~".CLientes  where codigo ='"~(Dialogo.Cliente1)~" '"));
    Cantidad2      : 'RPC anterior'        ;2;2;;;;;;;;num(query("select Valor3 from "~DBO~".CLientes  where codigo ='"~(Dialogo.Cliente1)~" '"));
    Cantidad3      : 'Patrimonio en pesos' ;3;2;;;;;;;;num(query("select PatrimonioPesos from "~DBO~".CLientes  where codigo ='"~(Dialogo.Cliente1)~" '"));
FinDialogo

if not ok
    cancelar
Endif
SQL.ADD(" UPDATE "~DBO~".CLientes set rpc = '"~Dialogo.Cantidad1~"'  WHERE Codigo = '"~Dialogo.Cliente1~"' ")
SQL.new
SQL.ADD(" UPDATE "~DBO~".CLientes set Valor3 = '"~Dialogo.Cantidad2~"'  WHERE Codigo = '"~Dialogo.Cliente1~"' ")
SQL.new
SQL.ADD(" UPDATE "~DBO~".CLientes set PatrimonioPesos  = '"~Dialogo.Cantidad3~"'  WHERE Codigo = '"~Dialogo.Cliente1~"' ")
SQL.new

try
    SQL.EXEC
    Messagebox('Se ejecuto con Exito')
catch
    Messagebox('No se actualizo el cliente: '~GetError())
End


