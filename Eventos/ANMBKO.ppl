CrearDialogo
  NrOperacion1: 'Nr. Operacion' ;1;1;1;  ;  ;Novacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIC|TIV|TCOPRI') y BuscarCampo('OPERACIONES','PaseCB','NrOperacion',Dialogo.NrOperacion1)=0;'Operacion Invalida.';NO;;;;;;"TipoOp in ('TIC','TIV','TCOPRI') and PaseCB=0 "
  Check1:       'Procesa'       ;1;2;1;NO;NO;;;;1;
FinDialogo

if not Ok
  Cancelar
endif

ACN(a:5, SQL("Select 1 from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrSaldo <> 1 "))
if Val(a:5)>0
  Cancelar("La operacion esta liquidada. No se puede anular la modificación de Book.")
endif

let &opSinCambioBook SQL("Select 1 from "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' and (FechaCambioBook is null or FechaCambioBook='' or FechaCambioBook=' ') ")
If &opSinCambioBook=1
    Cancelar("Evento cancelado. No se realizó un cambio de book para la operación ingresada. ")
Endif

if Dialogo.Check1=1
  let &bookAnterior BuscarCampo('OPERACIONES','BookAnterior','NrOperacion',Dialogo.NrOperacion1)
  
  SQL.ADD("Update "~DBO~".OPERACIONES Set Book1 = '"~&bookAnterior~"',FechaAnulacionCambioBook = '"~IdxDate(Fsys)~"', ")
  SQL.ADD("BookAnterior= null WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
  SQL.NEW
  SQL.EXEC
 
  
  SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,SI)
  SQL.EXEC

  MessageBox('La operacion fue actualizada correctamente')
  
endif