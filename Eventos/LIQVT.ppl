*hojavisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
   NrTrans1: 'NrTrans'
FinDialogo

If Not OK
   Cancelar
Endif

* --- Verifica si la liquidacion corresponde a algun VT
IF SQL(" SELECT 1 FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T WHERE M.NrTrans2 = '"~Dialogo.NrTrans1~"' AND M.NrOperacion = T.NrTrans AND T.TipoTr2 = 'TRANSP' ") = 1 
   * --- Busca todos los VT VT y OP relaciondados con este voucher (parametro). El que se liquido recien.
   SQL.ADD(" SELECT M.NrOperacion, 'TR' Tipo, M.NrTrans2 FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD(" WHERE  M.NrTrans2    = '"~Dialogo.NrTrans1~"' ")
   SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
   SQL.ADD(" AND    M.NrOperacion <> M.NrTrans2 ")
   SQL.ADD(" UNION ")
   SQL.ADD(" SELECT M.NrOperacion, 'OP' Tipo, M.NrTrans2 FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES T ")
   SQL.ADD(" WHERE  M.NrTrans2    = '"~Dialogo.NrTrans1~"' ")
   SQL.ADD(" AND    M.NrOperacion = T.NrOperacion ")
   SQL.ADD(" AND    M.NrOperacion <> M.NrTrans2 ")
   Recorrer SQL
      * ----------------------------------------------------------------------------------- *
      ACT(a:fac, Dialogo.NrTrans1 )
      ACT(b:fac, fbn('NrOperacion') )
      ACT(c:fac, fbn('NrTrans2') )
      message(Val(a:fac)~' - '~Val(b:fac)~' - '~Val(c:fac))
      SQL.ADD("INSERT INTO "~DBO~".LIQUIDACIONESVT (NrTrans, NrOperacion, NrTrans2, Fecha1) VALUES ('"~Val(a:fac)~"', '"~Val(b:fac)~"', '"~Val(c:fac)~"', "~idxdate2(FSYS)~") ")
      SQL.NEW
      * ----------------------------------------------------------------------------------- *
      IF Eqstr(fbn('Tipo'), 'TR')
         * --- Ciclo que llena la tabla hasta llegar a la operacion
         ACT(op:1, fbn('NrOperacion'))
         Recorrer&i 1,10000
           ACN(x:1, 0)
           * Son todos los mov ejecutados que habia liquidado el voucher que se fallo con este VT
           SQL.ADD(" SELECT T.NrTrans, M.NrOperacion, 'OP' Tipo, M.NrTrans2 FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O  ")
           SQL.ADD(" WHERE  T.NrTransRef1 = '"~Val(op:1)~"' AND T.NrTrans =M.NrTrans2 AND M.NrOperacion = O.NrOperacion AND M.NrOperacion <> M.NrTrans2  ")
           SQL.ADD(" UNION ")
           SQL.ADD(" SELECT T.NrTrans, M.NrOperacion, 'TR' Tipo, M.NrTrans2 FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T2  ")
           SQL.ADD(" WHERE  T.NrTransRef1 = '"~Val(op:1)~"' AND T.NrTrans =M.NrTrans2 AND M.NrOperacion = T2.NrTrans AND M.NrOperacion <> M.NrTrans2  ")
           Recorrer SQL
             IF Eqstr(fbn('Tipo'), 'TR')
                ACT(op:1, fbn('NrOperacion'))
                ACN(x:1, 1)
             ENDIF
             * ----------------------------------------------------------------------------------- *
             ACT(a:fac, Dialogo.NrTrans1 )
             ACT(b:fac, fbn('NrOperacion') )
             ACT(c:fac, fbn('NrTrans2') )
             message(Val(a:fac)~' - '~Val(b:fac)~' - '~Val(c:fac))
             SQL.ADD("INSERT INTO "~DBO~".LIQUIDACIONESVT (NrTrans, NrOperacion, NrTrans2, Fecha1) VALUES ('"~Val(a:fac)~"', '"~Val(b:fac)~"', '"~Val(c:fac)~"', "~idxdate2(FSYS)~") ")
             SQL.NEW
             * ----------------------------------------------------------------------------------- *
           Proximo
           If Val(x:1)=0
              message('* Ya no encontro mas VT.')
              Break
           Endif
         Proximo
      ENDIF
   Proximo
   SQL.EXEC
ENDIF
