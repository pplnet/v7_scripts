CrearDialogo
   NrOperacion1 : 'NrOperacion Nueva'
   NrOperacion2 : 'NrOperacion Vieja'
FinDialogo

if Vacio(Dialogo.NrOperacion1)
   MessageBox(" ­Atenci¢n!. La minuta no puede renovar. ")
else
   SQL.ADD(" Update "~DBO~".OPERACIONES ")
   SQL.ADD(" set RB6 = '1' ")
   SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.EXEC

   if Not EqStr(Dialogo.NrOperacion1, Dialogo.NrOperacion2)
      SQL.ADD(" Update "~DBO~".OPERACIONES ")
      SQL.ADD(" set RB6 = '0' ")
      SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion2~"' ")
      SQL.NEW
      SQL.EXEC
   endif
endif

