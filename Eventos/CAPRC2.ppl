SQL.ADD(" SELECT 1 FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" WHERE FechaMov = '"~IdxDate(BuscarCampo('OPERACIONES','FechaVto','NrOperacion',Dialogo.NrOperacion1))~"' AND NrSaldo = 1 ")
Recorrer SQL
    Cancelar('La operacion que seleccionó tiene una liquidación ya hecha. Anule la liquidación e intente de nuevo')
Proximo

SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
SQL.ADD(" Set FechaVto = FechaVto2, ")
SQL.ADD(" Plazo = Plazo3, ")
SQL.ADD(" CB7 = '0', ")
SQL.ADD(" TotalAux1 = 0, ")
SQL.ADD(" Precio3 = 0, ")
SQL.ADD(" FechaPrecan = null ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD(" UPDATE "~DBO~".CUOTAS ")
SQL.ADD(" Set Cantidad3 = Cantidad10, ")
SQL.ADD(" Cantidad4 = Cantidad11, ")
SQL.ADD(" Fecha2 = '"~IdxDate(BuscarCampo('OPERACIONES','FechaVto2','NrOperacion',Dialogo.NrOperacion1))~"' ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrCuota = 1 ")
SQL.NEW
SQL.EXEC

