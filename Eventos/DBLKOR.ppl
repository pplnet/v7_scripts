** Toma Ordenes BYMA anuladas (31 Anulacion Oferta) para el envio a  11-Anulada Remanente o 30-Anulacion  y si corresponde desbloquea saldos

CrearDialogo
  NrOrden1: 'Nr.Orden';1;1;1;;;;;;;;;;;"TipoOrden IN ('OTIC', 'OTIV') AND NrOrden IN (SELECT NrOperacion FROM OPERACIONESBITS WHERE Valor = '1' AND NrBit IN (31))"
FinDialogo

IF NOT Ok
  Cancelar
ENDIF

   SQL.ADD("SELECT ORD.TipoOrden, ORD.NrOrden, ORD.TotalAux1, IsNull(O.TotalNetoCli1,0) TotalNetoCli1, ORD.Cuenta4  as Cuenta, ORD.ContraEspecie, ")
   SQL.ADD("    C.Sucursal, ORD.Leyenda3, ORD.AfectaLS, ORD.MB2, ORD.Mercado2, B.NrBit ")
   SQL.ADD("  FROM "~DBO~".ORDENES ORD ")
   SQL.ADD("       Left JOIN "~DBO~".OPERACIONES O WITH (NOLOCK) ON ORD.NrOrden=O.NrOrden1 ")
   SQL.ADD("       Left JOIN "~DBO~".CUENTAS C WITH (NOLOCK) ON  ORD.Cuenta4=C.Codigo ")
   SQL.ADD("       Left JOIN "~DBO~".OPERACIONESBITS B WITH (NOLOCK) ON  ORD.NrOrden=B.NrOperacion ")   
**   SQL.ADD(" WHERE ORD.FechaOrden="~IdxDate2(Fsys))
**   SQL.ADD("   WHERE ORD.CantidadTotalOrden>Cantidad1 ")
   SQL.ADD("   WHERE ORD.TipoOrden in ('OTIC','OTIV') ")
   SQL.ADD("   AND B.NrBit in ( 31 )  and B.Valor=1 ")
   IF NoVacio(Dialogo.NrOrden1)
      SQL.ADD(" AND ORD.NrOrden = '"~Dialogo.NrOrden1~"' ")
   ENDIF   
   watch(sql.batch)
   Recorrer SQL

      **  Desbloqueo por no utilizado Moneda, ARP De la Operacion
      #ifdef BIND
   
         If EqStr(FBN['TipoOrden'],'OTIC') y EqStr(FBN('Mercado2'],VAR('MERCADOBT')) y FBN['MB2']='1' y EqStr(FBN['AfectaLS'],'Saldos')
            * Parámetros Salida
            * RR:1  'OK/NOK  
            * RR:2  'Mensaje'  

            * Parámetros entrada
            * RR:10  'Cuenta'  
            * RR:11  'Sucursal'  
            * RR:12  'Cuenta(1a7)'    
            * RR:13  'SubOperacion-Cuenta (9a10)'
            * RR:14  'Moneda'
            * RR:15  'Importe'
            * RR:16  'Observaciones'
 
            ** Desbloqueo en sistema interno 
            BorrarCeldas(rr:1..rr:50)
            ACT(rr:10, FBN['Leyenda3'])
            ACT(rr:12, Copy(FBN['Cuenta'],1,7))
            ACT(rr:13, Copy(FBN['Cuenta'],9,2))
            * Desbloqueo de Saldo
            ACN(rr:15,FBN['TotalAux1']-FBN['TotalNetoCli1'])
      
            (.'DESBSALCTA'.)
            ACT(b:22, val(rr:1))
            If Eqstr(Val(b:22),'NOK')
               ACN(b:17, Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~FBN['NrOrden']~"' And Tipo = 'ERRDESBLOQ' "))
               if Val(b:17)=0
                  SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
                  SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ") 
                  SQL.ADD(" ) Values ( ")
                  SQL.ADD(" '"~FBN['NrOrden']~"', ")
                  SQL.ADD(" "~SQLAhora~", ")
                  SQL.ADD(" 'ERRDESBLOQ', ")
                  SQL.ADD(" '"~'Error al desbloquear cuenta '~FBN['Cuenta']~"' ")
                  SQL.ADD(" ) ")
                  SQL.NEW
                  SQL.EXEC
               endif
            Endif
         Endif   
      #endif         
   
      **  Mover a instancias de anulacion 30 u 11
      if FBN['TotalNetoCli1'] = 0 
         EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=0, Entero1=FBN['NrBit'], Entero2=30)
      Else
      EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=0, Entero1=FBN['NrBit'], Entero2=11)
      Endif
   
   Proximo
