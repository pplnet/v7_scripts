*- De Posicion Bancaria/SIAF a Datanet
SQL.ADD("Select Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(UsrVehiculos(UsuarioActivo)) 
   SQL.ADD(" Where Codigo In (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
EndIf
SQL.ADD(" Order By 1 ")

Recorrer SQL
   dfa
   Message('Ejecutando Transferencias Bancarias a Datanet Vehiculo '~FBN['Codigo'])
   EjecutarEvento('ZPBD1',Fecha1=FSYS,Vehiculo1=FBN['Codigo'],String=VAR('DNTRANSF'),Radio1=0,Check10=0)

   Message('Ejecutando Liquidacion de Operaciones por Datanet Vehiculo '~FBN['Codigo'])
   EjecutarEvento('ZPBD2',Fecha1=FSYS,Vehiculo1=FBN['Codigo'],String=VAR('DNLIQUID'),Check10=0)
Proximo
