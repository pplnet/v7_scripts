MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

(.'DNLISTA'.)

CrearDialogo
 Fecha1   : 'F.Desde'   ;1; ;;;;Dialogo.Fecha1<=FSYS ;'Fecha Desde Invalida';NO;FSys
 Fecha2   : 'F.Hasta'   ;1;2;;;;Dialogo.Fecha2<=FSYS ;'Fecha Hasta Invalida';NO;FSys
 Radio1   : 'FechaMov|FPA|Datanet|Ambos' ;;;;;;;;;2;
 Label1   : ''          ;3;1;;NO;;;;;'Concilia por ______________________________________________________________________'
 Check1   : 'Fecha'     ; ; ;;;;;;;0
 Check2   : 'NrComprob' ; ; ;;;;;;;1
 Check3   : 'Importe'   ; ; ;;;;;;;1
 Cantidad1: 'Tolerancia'; ;2;;;Dialogo.Check3=0;;;;1 
 Label1   : ''          ; ;1;;NO;;;;;'_______________________________________________________________________________________'
 Radio2:  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ; ;1;;;;;;;4
 Check5:  'Incluye Pagadoras'; ;1;;;;;;;1
* Lista1   : 'Archivo'   ;  ;1;;;;;;;;;VAR('DNARCHIVOS')
 Lista1   : 'Archivo'   ;  ;1;;;;;;;;;Val(l:1)
 Lista2   : 'Vehiculos' ; 5;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista3   : 'Bancos'    ; 5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
 Lista4   : 'Cuentas'   ;-1;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista3)~") "~IIF(Dialogo.Radio2=0," AND TipoCuenta='CC' ", IIF(Dialogo.Radio2=1," AND TipoCuenta='INT' ",IIF(Dialogo.Radio2=2," AND TipoCuenta='REC' ",IIF(Dialogo.Radio2=3," AND TipoCuenta='CA' ")) ))~" "~IIF(NOVACIO(Dialogo.Lista2)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
 Check4   : 'Confirma'  ;1;1;1;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif  

*If Vacio(Dialogo.Lista1)
*  ACT(l:1, 'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNOTRO')
*Else
*  ACT(l:1, Dialogo.Lista1)
*Endif
If NoVacio(Dialogo.Lista1)
   ACT(l:1, Dialogo.Lista1)
Endif

If Vacio(Dialogo.Lista2)
  ACT(l:2, iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1)))
Else
  ACT(l:2, Dialogo.Lista2)
Endif

Recorrer&i 1,Elementos(Val(l:2))
  message('Vehiculo: '~ItemLista(Val(l:2),&i))
  Recorrer&j 1,Elementos(Val(l:1))
    message('Archivo: '~ItemLista(Val(l:1),&j))
    EjecutarEvento('CONCM2',Vehiculo1=ItemLista(Val(l:2),&i),String=ItemLista(Val(l:1),&j),Fecha1=Dialogo.Fecha1,Check1=Dialogo.check1,Check2=Dialogo.check2,Check3=Dialogo.check3,Cantidad1=Dialogo.Cantidad1, Check4=1,Radio2=Dialogo.Radio2,Check5=Dialogo.Check5,Lista3=Dialogo.Lista3,Lista4=Dialogo.Lista4, Fecha2=Dialogo.Fecha2, Radio1=Dialogo.Radio1)
  Proximo
Proximo
