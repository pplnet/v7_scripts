MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:       'Fecha'       ;1;1;;;;;;;fsys
  Vehiculo1:   'Vehiculo'     ;2;;;NO;;;;;Var('VEHICON')
  ListaTabla1: 'Operaciones'  ;1;2;;;;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES' 
  Check1:      'Contab.Procesada' ;3;1;;NO;NO;
  Radio1:       'Tipo|Sec|Fx Spot|Fx Fut|MM|Todos'   ; 4;1;;NO;NO;;;;4;
FinDialogo

If Not Ok
   Raise('Evento Cancelado')
Endif


Message('--- Asientos de Concertacion ---')

ACT(ME:1, Var('MONEEXTR'))
ACT(ML:1, Var('MONELOCA'))
ACN(NA:1, Var('ASINUM'))
ACN(SL:1, Var('SALDOPOCON'))
ACT(VC:1, Dialogo.Vehiculo1)
ACD(FE:1, Habiles(Dialogo.Fecha1,-Var('FVALORCONT'),'ARG'))
*ACT(NG:1, Var('MNNIIFDES'))
*ACT(BK:1, BuscarCampo('MODELOSNEGOCIO','Books','Codigo', Var('MNNIIFDES')))
*ACT(EG:1, Var('EMIGRUPOP'))
***---Cliente MAE
ACT(CM:1, Var('CLIENTEMAE'))
***---Ruedas Garantizadas Futuros Moneda (CPC2)
*ACT(RG:1, Var('RUEGRTMON'))

SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, ")
SQL.ADD(" O.Mercado4, C.PaisDir, O.Cuenta1, ")
SQL.ADD(" Case When O.TipoOp = 'FXCF' Then O.TotalBrutoCli1 When O.TipoOp = 'FXVF' Then O.TotalBrutoCli1 Else O.TotalNetoCli1 End TotalNetoCli1, ")
SQL.ADD(" O.ContraEspecie, O.Especie, O.FechaOp, ")
SQL.ADD(" Case When O.TipoOp = 'TCOPRI' Then Case when O.ContraEspecie = 'ARP' then O.Precio1 else O.PorDerechoMercado*O.Precio1 end WHEN O.TipoOp = 'FXCF' THEN O.Precio1 WHEN O.TipoOp = 'FXVF' THEN O.Precio1 ELSE O.PorDerechoMercado END PorDerechoMercado, ")
SQL.ADD("'#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
SQL.ADD("(CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as Cliente, ")
SQL.ADD(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
SQL.ADD(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, Case when O.TipoOp = 'FXC' OR O.TipoOp='FXV' then O.Especie else O.ContraEspecie End Moneda, ")
SQL.ADD(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
SQL.ADD(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4, O.Cuenta3 CtaBcoOp, ")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
SQL.ADD(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(val(FE:1))~"' ")
SQL.ADD(" AND O.FechaCargaSys = '"~IdxDate(Dialogo.fecha1)~"' ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
If Dialogo.Radio1 = 4
    ***---Todo
    SQL.ADD(" AND ((O.TipoOp IN ('TICF','TIVF','FXK', 'TIPP','TIPA','FXCF','FXVF','TCOPRI','FXC','FXV','FXJ','FXA')) ")
    SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV')  ")
    SQL.ADD("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
ELSE
    IF Dialogo.Radio1 = 0
        ***---Securities => Acciones, Titulos y Futuros de Titulos
        SQL.ADD(" AND ((O.TipoOp IN ('TICF','TIVF','TIPP','TIPA','TCOPRI')) ")
        SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV')  ")
        SQL.ADD("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
    ELSE
        IF Dialogo.Radio1 = 1
            ***---Fx Spot => Canje
            SQL.ADD(" AND O.TipoOp IN ('FXK','FXC','FXV','FXJ','FXA')")
        ELSE
            IF Dialogo.Radio1 = 2
                ***---Fx Futuros
                SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
            ELSE
                IF Dialogo.Radio1 = 3
                    ***---MM
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF
IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 4
    SQL.ADD(" UNION ")
    SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
    SQL.ADD("C.PaisDir, O.Cuenta1, ABS(MO.Cantidad) as TotalNetoCli1,  MO.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
    SQL.ADD("O.PorDerechoMercado, ")
    SQL.ADD("'#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, ")
    SQL.ADD(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
    SQL.ADD(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, O.ContraEspecie Moneda, ")
    SQL.ADD(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
    SQL.ADD(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4,O.Cuenta3 CtaBcoOp, ")
    SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal,O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
    SQL.ADD(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
    SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
    SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
    SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
    SQL.ADD("       INNER JOIN "~DBO~".MOVPENDIENTES MO ON MO.NrOperacion = O.NrOperacion ") 
    SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
    SQL.ADD(" and MO.NrGrupo=2 ")
    SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASIC')~"' ")
    SQL.ADD(" AND O.TipoOp in ('TCPCEM') ")
    SQL.ADD(" AND O.CB10 = 1 ")
    SQL.ADD(" AND O.FechaVto2 >= '"~IdxDate(val(FE:1))~"' ")
    SQL.ADD(" AND O.FechaVto2 = '"~IdxDate(Dialogo.fecha1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    IF NoVacio(Dialogo.ListaTabla1)
       SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
    ENDIF
    SQL.ADD(" UNION ")
    SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
    SQL.ADD("C.PaisDir, O.Cuenta1, ABS(MO.Cantidad) as TotalNetoCli1,  MO.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
    SQL.ADD("O.PorDerechoMercado, ")
    SQL.ADD("'#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, ")
    SQL.ADD(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
    SQL.ADD(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo, O.ContraEspecie Moneda, ")
    SQL.ADD(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
    SQL.ADD(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4,O.Cuenta3 CtaBcoOp, ")
    SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
    SQL.ADD(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
    SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
    SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
    SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
    SQL.ADD("       INNER JOIN "~DBO~".MOVEJECUTADOS MO ON MO.NrOperacion = O.NrOperacion ") 
    SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
    SQL.ADD(" and MO.NrGrupo=2 ")
    SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASIC')~"' ")
    SQL.ADD(" AND O.TipoOp in ('TCPCEM') ")
    SQL.ADD(" AND O.CB10 = 1 ")
    SQL.ADD(" AND O.FechaVto2 >= '"~IdxDate(val(FE:1))~"' ")
    SQL.ADD(" AND O.FechaVto2 = '"~IdxDate(Dialogo.fecha1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    IF NoVacio(Dialogo.ListaTabla1)
       SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
    ENDIF
ENDIF

**Cintia Dec2024 - Issue 7419 por nuevos modelos conc DDC/DDV
SQL.ADD("UNION")
SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4,  ")
SQL.ADD(" C.PaisDir, O.Cuenta1, O.TotalNetoCli1 TotalNetoCli1, O.ContraEspecie, O.Especie, O.FechaOp, O.PorDerechoMercado PorDerechoMercado, ")
SQL.ADD("'#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, O.Cliente1 as Cliente, ")
SQL.ADD(" O.FechaEnvBajaSisExterno FechaAprobacion, E.Jerarquia, O.Book1, C.CategDepositante, C.PaisDir, O.Plazo, C.Pais, O.Cupon1,")
SQL.ADD(" O.TotalCaucion, E.EntidadEmisora, O.Book1 Cartera, O.UDN2 Rueda, O.NrOperacion2,O.PorAforo,  O.Especie Moneda, ")
SQL.ADD(" O.TotalBrutoCli1, O.FechaVto, O.PrecioMer, E.Cotiza, E.MonedaEmision, O.Precio1, O.EsAforado, E.Tipo TipoEspecie, O.Cliente1, ")
SQL.ADD(" O.TotalAux2 Comision, O.TotalIva IvaComision, O.TotalGastos DerechoMercado, O.TotalIvaAdi IvaDerechos, O.CB4, O.Cuenta3 CtaBcoOp, ")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, O.Cuenta2 as CuentaCustodia, '' as Concepto, ")
SQL.ADD(" CASE WHEN O.RB10 = 0 Then O.Especie ELSE O.ContraEspecie END MonLiqFut, O.PorDerechoMercado as PrecioOpEnARP, O.Mercado, O.Mercado2,O.RB10 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(val(FE:1))~"' ")
SQL.ADD(" AND O.FechaCargaSys = '"~IdxDate(Dialogo.fecha1)~"' ")
SQL.ADD(" AND O.TipoOp IN ('DDC','DDV') ")
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND O.NrOperacion IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
SQL.ADD(" ORDER BY O.NrOperacion ")
watch(SQL.batch)
Recorrer SQL
    ACD(FV:1, fbn('FechaOp'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, fbn('FechaOp'))
    ACT(BK:1, fbn('Book1'))
    ACT(EM:1, fbn('MonedaEmision'))
    ACT(MN:99, fbn('Moneda'))
    **Datos para Interfaz
    ACT(FV:2,fbn('FechaVto'))
    **
    
    **Cintia 300125 - 7871
    let &esNDF Iif(fbn('RB10')=1, SI, NO)
    **
    
    **Variables para Canje
    let &MercEsp fbn('Mercado')
    let &MercCEsp fbn('Mercado2')
    If EqStr(fbn('Especie'),val(ME:1))
        **Compra
        let &importeDivisaFxCanje fbn('Cantidad')
    Else
        **Venta
        let &importeDivisaFxCanje fbn('TotalBrutoCli1')
    EndIf
    let &monedaExpresion var('MONELOCA')
    let &monedaAConvertir val(ME:1)
    **
    
    **Cintia 020924 - Issue 7572
    let &tipoOp fbn['TipoOp']
    let &vehiculo fbn['Vehiculo1']
    IF Eqstr(Var('INSTALACIO'),'BACS') y Not EqStr(fbn['TipoOp'],'FXJ')
        let &moneda ''
        let &mercEsp ''
        let &mercNeg ''
    Else
        let &moneda fbn('Especie')
        let &mercEsp fbn('Mercado')    
        let &mercneg #MERCNEGO  
    Endif
    **
    
    let &precioOpEnARP fbn('PrecioOpEnARP')
    ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))
    IF Incluido(fbn('TipoOp'), 'TIC|TIV|TIPP|EQC|EQV|TIPA|TCOPRI')
        ***---GrupoEspecie solo aplica para Titulos y Acciones
        *ACT(JQ:1, ItemLista(Ascendientes('ESPECIES', fbn('Especie')), Elementos(Ascendientes('ESPECIES', fbn('Especie')))))
        *(.'GRUPOESP'.)
        ACT(GC:1,'77')
        ACT(GC:2,'78')
    ENDIF
*    If Incluido(fbn('Rueda'), 'MOME|MOMX|')
*        ACT(UD:1,fbn('Rueda'))
*    ELse
*        ACT(UD:1,'N/A')
*    EndIf
    IF Eqstr(fbn('TipoOp'), 'TIPP')
        ACN(BD:1, 0)
        SQL.ADD(" Select Sum(Cantidad1) RRVTA, Sum(Cantidad*Precio1)/Sum(Cantidad) PPP From "~DBO~".PARTIDAS ")
        SQL.ADD(" Where NrOperacion= '"~fbn('NrOperacion')~"' ")
        Recorrer SQL
            DFA 
            ***---siempre entra al recorrer porque Sum siempre trae un registro, el tema es si es NULL o 0
            If NoVacio(fbn('RRVTA')) O fbn('RRVTA') <> 0 O NoVacio(fbn('PPP')) O fbn('PPP') > 0
                ACN(BD:1, 1)
                ACN(RR:1, fbn('RRVTA'))
                ACN(PP:99, fbn('PPP'))
            EndIf
        Proximo
        IF Val(BD:1) = 0
            ***---Busco el PPP de la posicion en ARP
            ACT(ES:1, fbn('Especie'))
            ACD(FE:88, Dialogo.Fecha1)
            ACT(BK:1, fbn('Book1'))
            ACT(CU:1, fbn('Cupon1'))
            ACT(CP:99, fbn('Cupon1'))
            *ACN(SL:1, 171)
            **(.'PPP'.)
            ACN(PP:99, fbn('Precio1'))
            *Revisar la Moneda
            IF Not Eqstr(fbn('ContraEspecie'), Val(ML:1))
                ACT(MN:99, fbn('ContraEspecie'))
                ACN(PR:1, fbn('Precio1') * #TCCONTABLE)
            ELSE
                ACN(PR:1, fbn('Precio1'))
            ENDIF
            ACN(RR:1, fbn('Cantidad') * (Val(PR:1) - Val(PP:99)))
        ELSE
            IF Not Eqstr(fbn('MonedaEmision'), Val(ML:1))
                ***---El resultado de la partida está en MonedaEmision
                ACT(MN:99, fbn('MonedaEmision'))
                ACN(RR:1, Val(RR:1) * #TCCONTABLE)
                ACN(PP:99, Val(PP:99) * #TCCONTABLE)
            ENDIF
        ENDIF
    ENDIF
*    IF Eqstr(fbn('TipoOp'), 'TIPP')
*        ***---Calculo el Resultado Realizado de la venta Spot
*        ***---Busco el PPP de la posicion en ARP
*        ACT(ES:1, fbn('Especie'))
*        ACD(FE:88, Dialogo.Fecha1)
*        ACT(BK:1, fbn('Book1'))
*        ACT(CU:1, fbn('Cupon1'))
*        ACN(SL:1, 171)
*        (.'PPP'.)
*        ACN(PR:1, fbn('Precio1'))
*        IF Not Eqstr(fbn('ContraEspecie'), Val(ML:1))
*            ACT(MN:99, fbn('ContraEspecie'))
*            ACN(PR:1, Val(PR:1) * #TCCONTABLE)
*        ENDIF
*        ACN(RR:1, fbn('Cantidad') * (Val(PR:1) - Val(PP:99)))
*    ENDIF
    ACN(CK:1, 0)
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    let &codAsi fbn('CodAsi')
    IF Val(CK:1) = 0
        Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(&codAsi, fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 4
    ** Concetacion ICL - PICO
    ACT(TA:1, Var('TIPASICICL'))
    SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, O.Mercado4, ")
    SQL.ADD("C.PaisDir, O.Cuenta1, O.Cantidad as TotalNetoCli1,  O.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
** FJL 17/11/20 - Se agrega TipoConu
    SQL.ADD("O.PorDerechoMercado, O.TipoCONU, ")
    SQL.ADD("'#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, C.CategDepositante  ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
    SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
    SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
    SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
    ***---Cuando en BOFA se cambie el TipoAsiento por Var(TIPASIC), quitamos Var(TIPASICICL)
    SQL.ADD(" AND (MA.TipoAsiento = '"~Var('TIPASICICL')~"' OR MA.TipoAsiento = '"~Var('TIPASIC')~"') ")
    SQL.ADD(" AND O.TipoOp in ('PICO') ")
    SQL.ADD(" AND O.FechaCargaSys = '"~IdxDate(Dialogo.fecha1)~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(val(FE:1))~"' ")
    watch(sql.batch)
    Recorrer SQL
        ACD(FV:1, fbn('FechaOp'))
        ACD(FD:1, Dialogo.Fecha1)
        ACT(VH:1, fbn('Vehiculo1'))
        ACT(TO:1, fbn('CodAsi'))
        ACT(TI:1, fbn('TipoOp'))
        ACT(NR:1, fbn('NrOperacion'))
        ACT(NR:2, '')
        ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,VAR('MONELOCA')))
        ACN(CK:1, 0)
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        IF Val(CK:1) = 0
            Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
            SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
    Proximo
    ** Cancelacion ICL - PICD
    ACT(TA:1, Var('TIPASICCIC'))
    SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.FechaCargaSys Fecha, O.Vehiculo1, O.Cantidad as Cantidad, MA.Codigo CodAsi, C.Jerarquia, ")
    SQL.ADD(" O.Mercado4, C.PaisDir, O.Cuenta1, O.Cantidad as TotalNetoCli1,  O.Especie as ContraEspecie, O.Especie, O.FechaOp, ")
** FJL 17/11/20 - Se agrega TipoConu
    SQL.ADD(" O.PorDerechoMercado, O.TipoCONU, ")
    SQL.ADD(" '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, O.Cliente1 Cliente, C.CategDepositante  ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("       INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ") 
    SQL.ADD("       INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ") 
    SQL.ADD("       INNER JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo ") 
    SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
    ***---Cuando en BOFA se cambie el TipoAsiento por Var(TIPASIC), quitamos Var(TIPASICCIC)
    SQL.ADD(" AND (MA.TipoAsiento = '"~Var('TIPASICCIC')~"' OR MA.TipoAsiento = '"~Var('TIPASIC')~"') ")
    SQL.ADD(" AND O.TipoOp in ('PICD') ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD(" AND O.FechaCargaSys = '"~IdxDate(Dialogo.fecha1)~"' ")
    SQL.ADD(" AND O.FechaCargaSys >= '"~IdxDate(val(FE:1))~"' ")
    ACN(XX:1,0)
    watch(sql.batch)
    Recorrer SQL
        ACD(FV:1, fbn('FechaOp'))
        ACD(FD:1, Dialogo.Fecha1)
        ACT(VH:1, fbn('Vehiculo1'))
        ACT(TO:1, fbn('CodAsi'))
        ACT(TI:1, fbn('TipoOp'))
        ACT(NR:1, fbn('NrOperacion'))
        ACT(NR:2, '')
        ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,VAR('MONELOCA')))
        ACN(CK:1, 0)
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        IF Val(CK:1) = 0
            Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
            SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
    Proximo
ENDIF
