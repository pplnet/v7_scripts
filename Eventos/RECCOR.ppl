CrearDialogo
  Fecha1: 'Fec.Desde' ;1;1;;;;;;;FSys
  Fecha2: 'Fec.Hasta' ; ; ;;;;;;;FSys
  Check2: 'Corte'     ; ; ;;SI;;;;;1
  Check3: 'Cobro'     ; ; ;;SI;;;;;1
  Check1: 'Procesa'   ; ; ;;SI;;;;;1
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)
ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'TipoTr')
ACT(c:FAC, 'Accion')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'Vehiculo')
ACT(f:FAC, 'Book')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cupon')
ACT(i:FAC, 'Fecha')
ACT(j:FAC, 'Cantidad')
ACT(k:FAC, 'Precio')

ACT(aa:FAC, 'NrTrans')
ACT(ab:FAC, 'TipoTr2')
ACT(ac:FAC, 'Especie')
ACT(ad:FAC, 'Especie1')
ACT(ae:FAC, 'Especie2')
ACT(af:FAC, 'Fecha1')
ACT(ag:FAC, 'Saldo 2')
ACT(ah:FAC, 'Vehiculo')
ACT(ai:FAC, 'Book')
ACT(aj:FAC, 'Cant4 (Saldo)')
ACT(ak:FAC, 'Cliente1')

ACT(al:FAC, 'Esp.Vieja')
ACT(am:FAC, 'Esp.Nueva')
ACT(an:FAC, 'Esp Cupon')

ACT(ao:FAC, 'Cupon')
ACT(ap:FAC, '# Pos')
ACT(aq:FAC, 'Cant Fin')
ACT(ar:FAC, 'Precio Fin')
ACT(as:FAC, 'Accion')

SetFont(a:FAC..az:FAC,2)

ACT(ca:FAC, 'Especie')
ACT(cb:FAC, 'Vehiculo')
ACT(cc:FAC, 'Book')
ACT(cd:FAC, 'Saldo')
ACT(ce:FAC, 'Cupon')
ACT(cf:FAC, 'Fecha')
ACT(cg:FAC, 'Cant Fin')
ACT(ch:FAC, 'Precio Fin')
ACT(ci:FAC, 'Max. Fecha')

ACT(da:FAC, 'Especie')
ACT(db:FAC, 'Vehiculo')
ACT(dc:FAC, 'Book')
ACT(dd:FAC, 'Saldo')
ACT(de:FAC, 'Cupon')
ACT(df:FAC, 'Fecha')
ACT(dg:FAC, 'Cant Fin')
ACT(dh:FAC, 'Precio Fin')
ACT(di:FAC, 'Max. Fecha')
SetFont(ca:FAC..dz:FAC,2)

ACN(z:1, 1)
ACN(z:2, 1)
ACN(z:3, 1)

if Dialogo.Check2=1
  ** Cortes
  SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 ")
  SQL.ADD("  where Fecha1 >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("    and Fecha1 < "~IdxDate2(Dialogo.Fecha2+1)~" ")
  SQL.ADD("    and TipoTr2  in ('CUPON') ")
  SQL.ADD(" Order By Fecha1,Especie,NrTrans")
  Recorrer SQL
    ACT(aa:FAC, fbn('NrTrans'))
    ACT(ab:FAC, fbn('TipoTr2'))
    ACT(ac:FAC, fbn('Especie'))
    ACT(ad:FAC, fbn('Especie1'))
    ACT(ae:FAC, fbn('Especie2'))
    ACD(af:FAC, fbn('Fecha1'))

    if fbn('Cantidad4')=2
      ACT(ag:FAC, 'Saldo = 2')
      ACT(by:1, fbn('NrTrans'))
      ACT(ah:FAC, fbn('Vehiculo1'))
      ACT(ai:FAC, fbn('Ley1'))
      ACN(aj:FAC, fbn('Cantidad4'))
      ACT(ak:FAC, fbn('Cliente1'))
      ACT(bb:2, fbn('Especie'))
      ACN(bc:2, fbn('Cupon1'))
      ACD(bg:2, fbn('Fecha1'))
      ACN(bl:2, fbn('Precio2'))
      ACN(bk:2, fbn('Precio1'))
      ACN(bm:2, fbn('Precio3'))
      ACN(bc:3, fbn('Cupon2'))
      ACN(be:3, fbn('Cambio2'))
      ACT(bb:4, fbn('Especie2'))

      Message('----- Corte de Posiciones Nuevas')

      SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONES P ")
      SQL.ADD("  WHERE P.Cliente         =  '"~Val(ak:FAC)~"' ")
      SQL.ADD("    AND P.Especie         =  '"~Val(bb:2)~"' ")
      SQL.ADD("    AND P.Cupon           =  '"~FStr(Val(bc:2),1,0)~"' ")
      SQL.ADD("    AND P.Vehiculo        =  '"~Val(ah:FAC)~"' ")
      SQL.ADD("    AND P.NrSaldo         >= 120 ")
      SQL.ADD("    and P.NrSaldo         <  140 ")
      SQL.ADD("    AND P.Fecha = (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
      SQL.ADD("                    WHERE P1.Especie                = P.Especie ")
      SQL.ADD("                      AND P1.Cupon                  = P.Cupon ") 
      SQL.ADD("                      AND P1.NrSaldo                = P.NrSaldo ") 
      SQL.ADD("                      AND P1.Cliente                = P.Cliente ")
      SQL.ADD("                      AND P1.Vehiculo               = P.Vehiculo ") 
      SQL.ADD("                      AND IsNull(P1.Book,'')        = IsNull(P.Book,'') ")
      SQL.ADD("                      AND IsNull(P1.TipoNegocio,'') = IsNull(P.TipoNegocio,'') ")
      SQL.ADD("                      AND IsNull(P1.Trader,'')      = IsNull(P.Trader,'') ") 
      SQL.ADD("                      AND P1.Fecha <= '"~IdxDate(Val(bg:2))~"' ")
      SQL.ADD("                  ) ")
      SQL.ADD(" ORDER By Especie,Vehiculo,Book,NrSaldo")
      Recorrer SQL
        DFA
        Message('Posiciones ')

        IF fbn('CantidadFin')<>0
          ACN(bz:1, fbn('CantidadFin'))
          ACN(bz:2, fbn('PrecioFin'))

          * Precio Final actualizado
          if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(bb:2)),'CLE')
            ACN(bz:4, (Val(bl:2)+Val(bk:2)*Val(bz:2)+Val(bm:2))/100)
            ACN(bz:3, Val(bz:2))
          else
            ACN(bz:4, (Val(bl:2) + (Val(bk:2) * (Val(bz:2)-Val(bl:2)/100-Val(bm:2)/100)) + Val(bm:2))/100 )
            ACN(bz:3, Val(bz:2) * (1 - Val(bk:2)/100) )
          endif 

          ACT(al:FAC, 'Genera Mov Esp Vieja')
          SCN(z:1, 1)
          ACT(a:Val(z:1), Val(by:1))
          ACT(b:Val(z:1), Val(ab:FAC))
          ACT(c:Val(z:1), Val(al:FAC))
          ACN(d:Val(z:1), FBN['NrSaldo'])
          ACT(e:Val(z:1), FBN['Vehiculo'])
          ACT(f:Val(z:1), FBN['Book'])
          ACT(g:Val(z:1), Val(bb:2))
          ACN(h:Val(z:1), Val(bc:2))
          ACD(i:Val(z:1), Val(bg:2))
          ACN(j:Val(z:1), Val(bz:1)*(-1))
          ACN(k:Val(z:1), Val(bz:2))
          if Dialogo.Check1=1
            * Actualizar movimientos de posicion para la especie vieja
            SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
            SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
            SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
            SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
            SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
            SQL.ADD("   Book,       Unidad,      Centro, ")
            SQL.ADD("   Sector,     Sucursal,    CallPut, ")
            SQL.ADD("   Estrategia, Cartera ")
            SQL.ADD(" ) Values ( ")
            * Especie
            SQL.ADD("   '"~Val(bb:2)~"', ")
            * Cantidad
            SQL.ADD("   "~Fstr(val(bz:1)*(-1),1,2)~", ")
            * NrOperacion
            SQL.ADD("   '"~Val(by:1)~"', ")

            * FechaMov
            SQL.ADD("   '"~IdxDate(Val(bg:2))~"', ")
            SQL.ADD("   '"~FBN['Cliente']~"', ")
            SQL.ADD("   '"~FBN['Vehiculo']~"', ")

            * NrSaldo
            SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
            * Precio
            SQL.ADD("   "~FStr(Val(bz:2),1,8)~", ")
            * Cupon
            SQL.ADD("   '"~FStr(Val(bc:2),1,0)~"', ")

            * Tipo
            SQL.ADD("   '1', ")
            SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
            SQL.ADD("   '"~FBN['Trader']~"', ")

            * Book
            SQL.ADD("   '"~FBN['Book']~"', ")
            SQL.ADD("   '"~FBN['Unidad']~"', ")
            SQL.ADD("   '"~FBN['Centro']~"', ")

            * Sector
            SQL.ADD("   '"~FBN['Sector']~"', ")
            SQL.ADD("   '"~FBN['Sucursal']~"', ")
            SQL.ADD("   '"~FBN['CallPut']~"', ")

            * Estrategia
            SQL.ADD("   '"~FBN['Estrategia']~"', ")
            SQL.ADD("   '"~FBN['Cartera']~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
          endif

          If Round2(Val(be:3),3)<>0
            ACT(am:FAC, 'Genera Mov Esp Nueva')
            SCN(z:1, 1)
            ACT(a:Val(z:1), Val(by:1))
            ACT(b:Val(z:1), Val(ab:FAC))
            ACT(c:Val(z:1), Val(am:FAC))
            ACN(d:Val(z:1), FBN['NrSaldo'])
            ACT(e:Val(z:1), FBN['Vehiculo'])
            ACT(f:Val(z:1), FBN['Book'])
            ACT(g:Val(z:1), Val(bb:2))
            ACN(h:Val(z:1), Val(bc:3))
            ACD(i:Val(z:1), Val(bg:2))
            ACN(j:Val(z:1), Val(bz:1))
            ACN(k:Val(z:1), Val(bz:3))
            if Dialogo.Check1=1
              * Actualizar movimientos de posicion para la especie nueva
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
              SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
              SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
              SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
              SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
              SQL.ADD("   Book,       Unidad,      Centro, ")
              SQL.ADD("   Sector,     Sucursal,    CallPut, ")
              SQL.ADD("   Estrategia, Cartera ")
              SQL.ADD(" ) Values ( ")
              * Especie
              SQL.ADD("   '"~Val(bb:2)~"', ")
              * Cantidad
              SQL.ADD("   "~Fstr(val(bz:1),1,2)~", ")
              * NrOperacion
              SQL.ADD("   '"~Val(by:1)~"', ")

              * FechaMov
              SQL.ADD("   '"~IdxDate(Val(bg:2))~"', ")
              SQL.ADD("   '"~FBN['Cliente']~"', ")
              SQL.ADD("   '"~FBN['Vehiculo']~"', ")

              * NrSaldo
              SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
              * Precio
              SQL.ADD("   "~FStr(Val(bz:3),1,8)~", ")
              * Cupon
              SQL.ADD("   '"~FStr(Val(bc:3),1,0)~"', ")

              * Tipo
              SQL.ADD("   '1', ")
              SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
              SQL.ADD("   '"~FBN['Trader']~"', ")

              * Book
              SQL.ADD("   '"~FBN['Book']~"', ")
              SQL.ADD("   '"~FBN['Unidad']~"', ")
              SQL.ADD("   '"~FBN['Centro']~"', ")

              * Sector
              SQL.ADD("   '"~FBN['Sector']~"', ")
              SQL.ADD("   '"~FBN['Sucursal']~"', ")
              SQL.ADD("   '"~FBN['CallPut']~"', ")

              * Estrategia
              SQL.ADD("   '"~FBN['Estrategia']~"', ")
              SQL.ADD("   '"~FBN['Cartera']~"' ")
              SQL.ADD(" ) ")
              SQL.NEW
            Endif
          Endif

          If val(bl:2)+val(bk:2)<>0
            ACT(an:FAC, 'Genera Mov Cupon')
            SCN(z:1, 1)
            ACT(a:Val(z:1), Val(by:1))
            ACT(b:Val(z:1), Val(ab:FAC))
            ACT(c:Val(z:1), Val(an:FAC))
            ACN(d:Val(z:1), FBN['NrSaldo'])
            ACT(e:Val(z:1), FBN['Vehiculo'])
            ACT(f:Val(z:1), FBN['Book'])
            ACT(g:Val(z:1), Val(bb:4))
            ACN(h:Val(z:1), Val(bc:2))
            ACD(i:Val(z:1), Val(bg:2))
            ACN(j:Val(z:1), Val(bz:1))
            ACN(k:Val(z:1), Val(bz:4))
            if Dialogo.Check1=1
              * Actualizar movimientos de posicion para el cupon
              SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE ( ")
              SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
              SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
              SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
              SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
              SQL.ADD("   Book,       Unidad,      Centro, ")
              SQL.ADD("   Sector,     Sucursal,    CallPut, ")
              SQL.ADD("   Estrategia, Cartera ")
              SQL.ADD(" ) Values ( ")
              * Especie
              SQL.ADD("   '"~Val(bb:4)~"', ")
              * Cantidad
              SQL.ADD("   "~Fstr(val(bz:1),1,2)~", ")
              * NrOperacion
              SQL.ADD("   '"~Val(by:1)~"', ")

              * FechaMov
              SQL.ADD("   '"~IdxDate(Val(bg:2))~"', ")
              SQL.ADD("   '"~FBN['Cliente']~"', ")
              SQL.ADD("   '"~FBN['Vehiculo']~"', ")

              * NrSaldo
              SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
              * Precio
              SQL.ADD("   "~FStr(Val(bz:4),1,8)~",  ")
              * Cupon
              SQL.ADD("   '"~FStr(Val(bc:2),1,0)~"', ")

              * Tipo
              SQL.ADD("   '1', ")
              SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
              SQL.ADD("   '"~FBN['Trader']~"', ")

              * Book
              SQL.ADD("   '"~FBN['Book']~"', ")
              SQL.ADD("   '"~FBN['Unidad']~"', ")
              SQL.ADD("   '"~FBN['Centro']~"', ")

              * Sector
              SQL.ADD("   '"~FBN['Sector']~"', ")
              SQL.ADD("   '"~FBN['Sucursal']~"', ")
              SQL.ADD("   '"~FBN['CallPut']~"', ")

              * Estrategia
              SQL.ADD("   '"~FBN['Estrategia']~"', ")
              SQL.ADD("   '"~FBN['Cartera']~"' ")
              SQL.ADD(" ) ")
              SQL.NEW
            ENDIF
          endif 
          if Dialogo.Check1=1
            SQL.EXEC
          endif 
        endif
        * Fin cantidadFin <> 0
      Proximo
    else
      Message('NO corta Posiciones Nuevas')
    endif
  proximo
endif

if Dialogo.Check3=1
  ** Cobros/Pagos
  SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 ")
  SQL.ADD("  where Fecha1  >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("    and Fecha1  < "~IdxDate2(Dialogo.Fecha2+1)~" ")
  SQL.ADD("    and TipoTr2 in ('CCUPON','PCUPON') ")
  SQL.ADD("  Order By Fecha1,Especie,NrTrans")
  Recorrer SQL
    ACT(aa:FAC, fbn('NrTrans'))
    ACT(ab:FAC, fbn('TipoTr2'))
    ACT(ac:FAC, fbn('Especie'))
    ACT(ad:FAC, fbn('Especie1'))
    ACT(ae:FAC, fbn('Especie2'))
    ACD(af:FAC, fbn('Fecha1'))
    ACT(ah:FAC, fbn('Vehiculo1'))
    ACT(ai:FAC, fbn('Ley1'))
    ACN(aj:FAC, fbn('Cantidad4'))
    ACT(ak:FAC, fbn('Cliente1'))
    ACN(ao:FAC, fbn('Cupon1'))

    SQL.ADD("SELECT * FROM "~DBO~".POSICIONES  ")
    SQL.ADD(" WHERE Especie   = '"~Val(ac:FAC)~"' ")
    SQL.ADD("   AND Vehiculo  = '"~Val(ah:FAC)~"' ")
    SQL.ADD("   AND NrSaldo  >= 120 and NrSaldo < 140 ")
    SQL.ADD("   and Cupon     = '"~FStr(Val(ao:FAC),1,0)~"'")
    SQL.ADD(" ORDER By Especie,Vehiculo,Book,NrSaldo")
    Recorrer SQL
      DFA
      SCN(z:3,1)
      ACT(da:Val(z:3), fbn('Especie'))
      ACT(db:Val(z:3), fbn('Vehiculo'))
      ACT(dc:Val(z:3), fbn('Book'))
      ACN(dd:Val(z:3), fbn('NrSaldo'))
      ACN(de:Val(z:3), fbn('Cupon'))
      ACD(df:Val(z:3), fbn('Fecha'))
      ACN(dg:Val(z:3), fbn('CantidadFin'))
      ACN(dh:Val(z:3), fbn('PrecioFin'))
      ACD(di:Val(z:3), SQL("SELECT MAX(Fecha) FROM "~DBO~".POSICIONES WHERE Especie = '"~fbn('Especie')~"' AND Vehiculo = '"~fbn('Vehiculo')~"' AND IsNull(Book,'') =  IsNull('"~fbn('Book')~"','') AND NrSaldo = "~FSTR(fbn('NrSaldo'),1,0)~" AND Cupon = "~FSTR(fbn('Cupon'),1,0)~" AND Fecha <= '"~IdxDate(Val(af:FAC))~"' "))
    proximo
        
    SQL.ADD("SELECT P.* FROM "~DBO~".POSICIONES P ")
    SQL.ADD(" WHERE P.Especie   = '"~Val(ac:FAC)~"' ")
    SQL.ADD("   AND P.Vehiculo  = '"~Val(ah:FAC)~"' ")
    SQL.ADD("   AND P.NrSaldo  >= 120 and P.NrSaldo < 140 ")
    SQL.ADD("   and P.Cupon     = '"~FStr(Val(ao:FAC),1,0)~"'")
    SQL.ADD("   AND P.Fecha = (SELECT MAX(P1.Fecha) FROM "~DBO~".POSICIONES P1 ")
    SQL.ADD("                   WHERE P1.Especie         =  P.Especie ")
    SQL.ADD("                     AND P1.Vehiculo        =  P.Vehiculo ")
    SQL.ADD("                     AND IsNull(P1.Book,'') =  IsNull(P.Book,'') ")
    SQL.ADD("                     AND P1.NrSaldo         =  P.NrSaldo ")
    SQL.ADD("                     AND P1.Cupon           =  P.Cupon ")
    SQL.ADD("                     AND P1.Fecha          <= '"~IdxDate(Val(af:FAC))~"' ")
    SQL.ADD("                 ) ")
    SQL.ADD(" ORDER By P.Especie,P.Vehiculo,P.Book,P.NrSaldo")
    Recorrer SQL
      DFA
      SCN(z:2,1)
      ACT(ca:Val(z:2), fbn('Especie'))
      ACT(cb:Val(z:2), fbn('Vehiculo'))
      ACT(cc:Val(z:2), fbn('Book'))
      ACN(cd:Val(z:2), fbn('NrSaldo'))
      ACN(ce:Val(z:2), fbn('Cupon'))
      ACD(cf:Val(z:2), fbn('Fecha'))
      ACN(cg:Val(z:2), fbn('CantidadFin'))
      ACN(ch:Val(z:2), fbn('PrecioFin'))
      ACD(ci:Val(z:2), SQL("SELECT MAX(Fecha) FROM "~DBO~".POSICIONES WHERE Especie = '"~fbn('Especie')~"' AND Vehiculo = '"~fbn('Vehiculo')~"' AND IsNull(Book,'') =  IsNull('"~fbn('Book')~"','') AND NrSaldo = "~FSTR(fbn('NrSaldo'),1,0)~" AND Cupon = "~FSTR(fbn('Cupon'),1,0)~" AND Fecha <= '"~IdxDate(Val(af:FAC))~"' "))

      SCN(ap:FAC, 1)
      ACN(aq:FAC, fbn('CantidadFin'))
      ACN(ar:FAC, fbn('PrecioFin'))
      IF fbn('CantidadFin')<>0

        ACT(as:FAC, 'Genera Mov Cupon')
        SCN(z:1, 1)
        ACT(a:Val(z:1), Val(aa:FAC))
        ACT(b:Val(z:1), Val(ab:FAC))
        ACT(c:Val(z:1), Val(as:FAC))
        ACN(d:Val(z:1), FBN['NrSaldo'])
        ACT(e:Val(z:1), FBN['Vehiculo'])
        ACT(f:Val(z:1), FBN['Book'])
        ACT(g:Val(z:1), Val(ac:FAC))
        ACN(h:Val(z:1), Val(ao:FAC))
        ACD(i:Val(z:1), Val(af:FAC))
        ACN(j:Val(z:1), Val(aq:FAC)*(-1))
        ACN(k:Val(z:1), Val(ar:FAC))
        if Dialogo.Check1=1
          *---- Actualizar movimientos de posicion para el cupon
          SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ( ")
          SQL.ADD("   Especie,    Cantidad,    NrOperacion, ")
          SQL.ADD("   FechaMov,   Cliente,     Vehiculo, ")
          SQL.ADD("   NrSaldo,    Precio,      Cupon, ")
          SQL.ADD("   Tipo,       TipoNegocio, Trader, ")
          SQL.ADD("   Book,       Unidad,      Centro, ")
          SQL.ADD("   Sector,     Sucursal,    CallPut, ")
          SQL.ADD("   Estrategia, Cartera ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD("   '"~Val(ac:FAC)~"', ")
          SQL.ADD("   "~Fstr(Val(aq:FAC)*(-1),1,2)~", ")
          SQL.ADD("   '"~Val(aa:FAC)~"', ")

          SQL.ADD("   '"~IdxDate(Val(af:FAC))~"', ")
          SQL.ADD("   '"~Val(ah:FAC)~"', ")
          SQL.ADD("   '"~Val(ah:FAC)~"', ")

          SQL.ADD("   "~FSTR(fbn('NrSaldo'),1,0)~", ")
          SQL.ADD("   "~FStr(Val(ar:FAC),1,8)~",  ")
          SQL.ADD("   '"~FStr(Val(ao:FAC),1,0)~"', ")

          SQL.ADD("   '1', ")
          SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
          SQL.ADD("   '"~FBN['Trader']~"', ")

          SQL.ADD("   '"~FBN['Book']~"', ")
          SQL.ADD("   '"~FBN['Unidad']~"', ")
          SQL.ADD("   '"~FBN['Centro']~"', ")

          SQL.ADD("   '"~FBN['Sector']~"', ")
          SQL.ADD("   '"~FBN['Sucursal']~"', ")
          SQL.ADD("   '"~FBN['CallPut']~"', ")

          SQL.ADD("   '"~FBN['Estrategia']~"', ")
          SQL.ADD("   '"~FBN['Cartera']~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    Proximo
  proximo
endif

SetFont(z:1..z:2,1)
if FAC>1
  SetFont(aa:2..az:FAC,1)
  SetFont(by:1..bz:4,1)
  SetFont(bb:2..bm:4,1)
endif
if Val(z:1)>1
  SetFont(a:2..y:Val(z:1),1)
  FormatoCeldas(d:2..d:Val(z:1),Exe('F0'))
  FormatoCeldas(j:2..j:Val(z:1),Exe('F2'))
  FormatoCeldas(k:2..k:Val(z:1),Exe('F8'))
  ACO(3,12)
endif
if Val(z:2)>1
  SetFont(ca:2..cj:Val(z:2),1)
  FormatoCeldas(cd:2..ce:Val(z:2),Exe('F0'))
  FormatoCeldas(cg:2..cg:Val(z:2),Exe('F2'))
  FormatoCeldas(ch:2..ch:Val(z:2),Exe('F8'))
endif
