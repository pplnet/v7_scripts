CrearDialogo
  Fecha1  : 'Fecha'      ; ; ;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;FSys
  NrTrans1: 'Nro.Voucher'; ; ;;  ;  ;Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'OCTDEP|OCTRET');'Tipo de Comprobante incorrecto';NO;;;;;;" TipoTr2 IN ('OCTDEP','OCTRET') and Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' and RB1 = '1' ";
  Check1  : 'Procesa'    ;2;2;;SI;SI;;;;0;
FinDialogo
if Not OK
  cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(a:1, 'Cantidad')
ACT(a:2, 'Numero')
ACT(a:3, 'Tipo')
ACT(a:4, 'Fecha1')
ACT(a:5, 'Fecha2')
ACT(a:6, 'Paso')
ACT(a:7, 'Cantidad')
ACT(a:8, 'RB1')
ACT(a:9, 'RB2')
ACT(a:10, 'Max.Paso')

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2")
SQL.ADD("where NrTrans='"~Dialogo.NrTrans1~"' ")
recorrer SQL
  DFA
  SCN(b:1, 1)
  ACT(b:2, fbn('NrTrans'))
  ACT(b:3, fbn('TipoTr2'))
  ACD(b:4, fbn('Fecha1'))
  ACD(b:5, fbn('Fecha2'))
  ACN(b:6, fbn('Precio5'))
  ACN(b:7, fbn('Cantidad1'))
  ACN(b:8, fbn('RB1'))
  ACN(b:9, fbn('RB2'))
proximo
if Val(b:1)>1
  ACN(x1,1)
  if Dialogo.Check1=1
    Cancelar('Mas de una transaccion '~Dialogo.NrTrans1)
  else
    MessageBox('Mas de una transaccion '~Dialogo.NrTrans1)
  endif
endif
ACN(b:10, SQL("Select Max(Precio5) from "~DBO~".TRANSACCIONES2 where TipoTr2 in ('OCTDEP','OCTRET') and Fecha1 = '"~IdxDate(Val(b:4))~"' "))

if Val(b:6)<>Val(b:10)
  ACN(x1,1)
  if Dialogo.Check1=1
    Cancelar('La transaccion '~Dialogo.NrTrans1~' no corresponde al ultimo paso')
  else
    MessageBox('La transaccion '~Dialogo.NrTrans1~' no corresponde al ultimo paso')
  endif
endif
if Val(b:8)<>1
  ACN(x1,1)
  if Dialogo.Check1=1
    Cancelar('La transaccion '~Dialogo.NrTrans1~' no es manual')
  else
    MessageBox('La transaccion '~Dialogo.NrTrans1~' no es manual')
  endif
endif

if Val(x1)=0
  if Dialogo.Check1=1
    Message('Anula Transaccion '~Dialogo.NrTrans1)
    SQL.ADD("Delete "~DBO~".TRANSACCIONES2")
    SQL.ADD("where NrTrans='"~Dialogo.NrTrans1~"' ")
    SQL.NEW
    SQL.EXEC
  else
    MessageBox('Anula Transaccion '~Dialogo.NrTrans1)
  endif
endif
