* Busca la operacion hermana del arbitraje.
* Si la encuentra genera la operacion padre (FXA) 
* y envia las patas a esperar la cotizacion.
* Si no la encuentra la envia a la instancia de esperar a su hermano.

SQL.ADD("Select * from "~DBO~".OPERACIONES T where NrSisExterno is not NULL")
SQL.ADD("and exists (Select 'X' from "~DBO~".OPERACIONESBITS B where ")
SQL.ADD("T.NrOperacion = B.NrOperacion and (NrBit=35 and Valor='1')) ")
SQL.ADD("order by NrOperacion ")
recorrer SQL
  BorrarCeldas(b2..b2)
  if Incluido(fbn('TipoOp'), 'FXC')
    ACT(a1, Copy(fbn('NrSisExterno'),1,1)~Pad0(FStr(Num(Copy(fbn('NrSisExterno'),2,7))+1,7,0),7))
    ACT(a2, 'FXV')
  else
    ACT(a1, Copy(fbn('NrSisExterno'),1,1)~Pad0(FStr(Num(Copy(fbn('NrSisExterno'),2,7))-1,7,0),7))
    ACT(a2, 'FXC')
  endif
  Message('Buscando '~Val(a2)~' '~Val(a1))
  SQL.ADD("Select Especie, NrOperacion from "~DBO~".OPERACIONES T where NrSisExterno = '"~Val(a1)~"'")
  SQL.ADD("and TipoOp = '"~Val(a2)~"' and Arbitraje = '1'")
  SQL.ADD("and exists (Select 'X' from "~DBO~".OPERACIONESBITS B where ")
  SQL.ADD("T.NrOperacion = B.NrOperacion and (NrBit=36 and Valor='1')) ")
  SQL.ADD("order by NrOperacion ")
  recorrer SQL
    ACT(b1, fbn('Especie'))
    ACT(b2, fbn('NrOperacion'))
    ACT(b3, fbn('Cuenta1'))
  proximo
  if NoVacio(Val(b2))
    * Agregar Arbitraje
    ACT(c1,GetNumerador(2))
    SQL.ADD("Insert into "~DBO~".OPERACIONES (")
    SQL.ADD("NrOperacion, TipoOp, Especie, ContraEspecie,")
    SQL.ADD("Cliente1, Cantidad, Precio1, FechaOp,")
    SQL.ADD("FechaVto, PaseCB, ValorRB1, Puesto,")
    SQL.ADD("Cuenta1, Cuenta2, Vehiculo1, FormaLiquidacion1")
    SQL.ADD(") values (")
    SQL.ADD("'"~Val(c1)~"', '"~Val(a2)~"', '"~fbn('Especie')~"', '"~Val(b1)~"',")
    SQL.ADD("'"~fbn('Cliente1')~"', "~fbn('Cantidad')~", '0', '"~IdxDate(fbn('FechaOp'))~"',")
    SQL.ADD("'"~IdxDate(fbn('FechaOp'))~"', '0', '"~fbn('ValorRB1')~"', '"~fbn('Puesto')~"',")
    SQL.ADD("'"~fbn('Cuenta1')~"', '"~Val(b3)~"', '"~fbn('Vehiculo1')~"', '"~fbn('FormaLiquidacion1')~"'")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='0' ")
    SQL.ADD(" where NrOperacion= '"~Val(b2)~"' and NrBit=36 ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='1' ")
    SQL.ADD(" where NrOperacion= '"~Val(b2)~"' and NrBit=37 ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='0' ")
    SQL.ADD(" where NrOperacion= '"~fbn('NrOperacion')~"' and NrBit=35 ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='1' ")
    SQL.ADD(" where NrOperacion= '"~fbn('NrOperacion')~"' and NrBit=37 ")
    SQL.NEW
    SQL.EXEC     
  else
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='0' ")
    SQL.ADD(" where NrOperacion= '"~fbn('NrOperacion')~"' and NrBit=35 ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS  SET Valor='1' ")
    SQL.ADD(" where NrOperacion= '"~fbn('NrOperacion')~"' and NrBit=36 ")
    SQL.NEW
    SQL.EXEC     
  endif
proximo
