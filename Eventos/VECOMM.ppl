* VECOMM.
* Verifica la Ejecucion de Commitment Fee.
* encuentren liquidadas
CrearDialogo
  Fecha1       : "Fecha"                    ;;;;;;;;;Fsys
FinDialogo

if Not Ok
  Cancelar
endif

SQL.ADD(" Select O.Operador, O.TipoOp,O.FechaOp, O.Cantidad, C.* from "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" WHERE O.NrOperacion=C.NrOperacion AND C.Fecha1='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Importe1=0 AND O.TipoOp IN ('MMP','MMPV','MMFRN','MMFCMV','MMPSC','MMSCMV') AND Tipo IN ('4') ")
SQL.ADD(" ORDER BY C.NrOperacion,C.Tipo ")

ACN(x1,0)

Recorrer SQL   
   ACN(x1,1)   
   If NoVacio(val(x2))
      ACT(x2,val(x2)~',')

   EndIf
   ACT(x2,val(x2)~' '~FBN['NrOperacion'])

   ACT(x4,FBN['NrOperacion'])

      act(d1, fbn['Operador'])
      SendMail(Val(d1),'Aviso de Ejecucion de Commitment Fee', 'Vencimiento Commitment Fee al '~Dialogo.Fecha1~'. Operacion que usted ingreso: '~val(x4))

Proximo

IF VAL(X1)=1
   If no
      ACN(X1,MessageBox('Existen Comisiones Commitment Fee a Liquidar Hoy, Confirma el Calculo?',1,1))

      IF VAL(X1)=1
         EjecutarEvento('NROCOM',Fecha1=Dialogo.Fecha1)
      ENDIF
   EndIf

   MessageBox('Existen Comisiones Commitment Fee a Liquidar Hoy !!!!')
   Message('Enviar Mail Aviso de Vencimiento de Commitment Fee')

   ACT(a1, VAR('USRCOMMIT') )

   if NoVacio(Val(a1))
      SendMail(Val(a1),'Aviso de Ejecucion de Commitment Fee', 'Vencimiento Commitment Fee al '~Dialogo.Fecha1~'. Operaciones: '~val(x2))
   endif
EndIf
