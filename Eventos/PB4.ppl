MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1: 'Vehiculo' ;1;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Fecha1:    'Fecha'    ;1;2;;;;;;;FSYS
  Especie1:  'Moneda'   ;2;1;;;;Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo',Dialogo.Especie1),'MON');'Moneda Invalida';NO;'ARP';;;;;" Tipo = 'MON' "
  Entero1:   'Cant.Movimientos';3;;;;;;;;10
  Radio2:  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;4;1;;;;;;;4
  Check1:  'Incluye Pagadoras';5;1;;;;;;;1
  Lista1:    'Bancos'   ;6;1;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
*  Lista2:    'Cuentas'  ;0;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ");
  Lista2:    'Cuentas'  ;0;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~")"~IIF(Dialogo.Check1=0," AND (Pagadora <>'SI' OR Pagadora IS NULL)"));
FinDialogo

If Not Ok
  Cancelar
Endif


SQL.ADD(" SELECT /*+ RULE */ C.Codigo, C.Numero, C.Comitente, B.RazonSocial ")
SQL.ADD(" FROM "~DBO~".CUENTAS C, "~DBO~".CLIENTES B ")
SQL.ADD(" WHERE C.Comitente = B.Codigo ")
SQL.ADD(" AND   C.Cliente   = '"~Dialogo.Vehiculo1~"' ")
If Novacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If Novacio(Dialogo.Lista1)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
  SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
SQL.ADD(" AND (C.Especies LIKE '%"~Dialogo.Especie1~"%' OR C.Especies LIKE '%MONEDA%' ) ")
SQL.ADD(" ORDER BY C.Comitente, C.Codigo ")

ACN(z:1,0)
Recorrer SQL
  message('Cuenta: '~fbn('Codigo')~' - '~fbn('Numero'))
  ACN(z:1,1)
  Recorrer&i 1, Dialogo.Entero1 
    ACN(a:fac, 0)
    ACT(b:fac, fbn('Comitente'))
    ACT(c:fac, fbn('RazonSocial'))
    ACT(d:fac, fbn('Codigo'))
    ACT(e:fac, fbn('Numero'))
    ACD(f:fac, Dialogo.Fecha1)
    ACN(g:fac, 0)
    ACT(h:fac, Dialogo.Vehiculo1)
    ifa
  Proximo
  dfa
Proximo

If Val(z:1)=0
  Cancelar('No se encontraron cuentas.')
Endif

CrearListBox  ; 'Arial,8,';'Vehiculo: '~Dialogo.Vehiculo1~'  Moneda: '~Dialogo.Especie1
 'OK'         ;a:1..a:fac;SI;;; 30;CHECK ; RGB(232,255,215);Iif(Val(g:flb)<>0,1,0)
 'Cod.Banco'  ;b:1..b:fac;NO;;; 80;STRING;;RGB(232,232,232);
 'Nombre'     ;c:1..c:fac;NO;;;150;STRING;;RGB(232,232,232);
 'Cod.Cuenta' ;d:1..d:fac;NO;;; 80;STRING;;RGB(232,232,232);
 'Numero'     ;e:1..e:fac;NO;;;120;STRING;;RGB(232,232,232);
 'Monto'      ;g:1..g:fac;SI;;; 90;NUMERO;'###,###,###,###,###.##';RGB(232,255,215);
 'Fecha'      ;f:1..f:fac;NO;;; 70;FECHA ; RGB(232,232,232);
 'Vehiculo'   ;h:1..h:fac;NO;;; 80;STRING;;RGB(232,232,232);
 'Observaciones';i:1..i:fac;SI;;;300;STRING;;RGB(232,255,215);
FinListBox

If Not Ok
  Cancelar
Endif

Recorrer&i 1,fac 
 If Val(a:&i)=1
   ACT(nu:1, GETNUMERADOR(10103) )
   SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
   SQL.ADD(" ConceptoPago, Fecha1, Fecha2, ")
   SQL.ADD(" Especie, Cantidad1, Cliente2, ")
   SQL.ADD(" Cuenta2, Vehiculo1, UsrInput, ")
   SQL.ADD(" NrTrans, TipoTr2, FechaCarga, FechaCargaSys, Observaciones ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" 'ESTIMA', "~IdxDate2(Val(f:&i))~", "~IdxDate2(Val(f:&i))~", ")
   SQL.ADD(" '"~Dialogo.Especie1~"', "~FSTR(Val(g:&i),1,4)~", '"~Val(b:&i)~"', ")
   SQL.ADD(" '"~Val(d:&i)~"', '"~Dialogo.Vehiculo1~"', '"~USUARIOACTIVO~"', ")
   SQL.ADD(" '"~Val(nu:1)~"', 'ESTIMA', "~IdxDate2(Dialogo.Fecha1)~", "~IdxDate2(Dialogo.Fecha1)~", '"~Val(i:&i)~"' ")
   SQL.ADD(" ) ")
   SQL.NEW
 
   SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ( ")
   SQL.ADD(" NrOperacion, Valor, NrBit ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" '"~Val(nu:1)~"', '1', 40 ) ")
   SQL.NEW
   message('Transaccion '~Val(i:&i)~' generada.')
   SQL.EXEC
 Endif
Proximo
