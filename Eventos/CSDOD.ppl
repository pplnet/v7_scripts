Recorrer&i 1,30000
   ACT(aa:1, LeerAscii)

*   acn(zz:1, 1)
   if Not Ok
      break
   else 
      ACT(z4,'OK')
   endif

   *-Tipo Registro---------
   ACT(ab:1, COPY(VAL(aa:1),2,1) )
   ACN(z1,4) 

   Message(FSTR(&i,6,0)~' '~Copy(val(aa:1),1,40))

*"0"20160316"042814"Z20SDO" 
*Tiporeg CodAgente Tipo Comitente  Especie TipoCuenta Bloqueo Fecha     SaldoNominal         Decimales
*"1      "0040     "0   "000000003 "06000  "0         "00     "20160315 " 000000000000347882 "2        "00"
*"1"0040"0"000000003"07000"0"00"20160315" 000000000004656308"2"00"
*"1"0040"0"000000003"10000"0"00"20160315" 000000000310541778"2"00"
*"1"0040"0"000001523"00251"0"00"20160315" 000000000000304470"0"00"
*"1"0040"0"000001549"05436"0"00"20160315" 000000000000017100"0"00"
*"1"0040"0"000001669"46699"0"00"20160315" 000000000026104802"0"00"
*"1"0040"0"000001669"46712"0"00"20160315" 000000000040000000"0"00"
*"1"0040"0"000001680"10000"0"00"20160315" 000000000000021716"0"00"
*"1"0040"0"000001718"05313"0"00"20160315" 000000000000047799"0"00"


   *--Si es Registro de SALDO -------------------------------------
   If Eqstr(Val(ab:1),'1')

      *---Cod.Agente
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(at:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Tipo
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
*      ACT(ar:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Comitente
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(af:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACT(af:1, Pad0(Fstr(  Num(Val(af:1)) ,1,0),10)  )  
      ACN(z1,Val(z2)+1)

      *---Especie
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(ag:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Tipo_Cuenta
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(ai:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Bloqueo
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACT(al:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---Fecha ????
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
*      ACT(xx:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACN(z1,Val(z2)+1)

      *---SaldoNominal
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACN(ak:1,Abs( Num(COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ) ) ) )
      ACN(z1,Val(z2)+1)
       
      *---Decimales
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100 )  )
      ACN(aj:1,Abs( Num(COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ) ) ) )
      ACN(z1,Val(z2)+1)

      if val(aj:1)<>0
         ACN(ak:1,val(ak:1)/(10 ^ val(aj:1)))
      endif

      *--Codigo de Cuenta FPA----
      IF NoVacio(Val(bd:1)) y NoVacio(Val(af:1)) y Eqstr(Val(bd:1),Val(af:1))
        ACT(ap:1, Val(bb:1))
        ACT(am:1, Val(bb:1))
        ACT(an:1, Val(bc:1))
      ELSE
        SQL.ADD("Select Codigo, RazonSocial FROM "~DBO~".CLIENTES where CodComitente='"~Val(af:1)~"' ")
        Recorrer Sql
            ACT(ap:1, FBN['Codigo'])
            ACT(am:1, FBN['Codigo'])
            ACT(an:1,Copy(fbn['RazonSocial'],1,20))
            
            ACT(bb:1, FBN['Codigo'])
            ACT(bc:1, Copy(fbn['RazonSocial'],1,20))
            ACT(bd:1, Val(af:1))
        Proximo
      ENDIF
    
    
    *--Codigo de Especies FPA----
    ACT(ao:1,BuscarCampo('ESPECIES','Codigo','CodNumCajaValores', Val(ag:1)))
    
     *--Traigo Saldo_FPA--- 
    If NoVacio(Val(am:1)) y NoVacio(Val(ao:1)) y NoVacio(Val(ap:1))
        act(z:10,'CONC')
        (.'SALDOCLIE'.)
        ACN(aq:1, 0)
        Recorrer SQL
           dfa
           acn(aq:1, fbn['Saldo'])
        Proximo
    Else
       ACN(aq:1, 0)
    Endif       

        *-- Incremento Linea de Impresion---
        SCN(z3,1)
        if val(z3)>3800
*           Messagebox('Hay mas de 4000 diferencias')
*           break
        endif
        
        if incluido(Val(af:1),val(ba:5))
           * No conciliar
           acn(h:val(z3),1)
        endif
        If NoVacio(Val(am:1))  
          ACT(a:val(z3),Val(am:1)~'-'~Val(an:1))
        Else 
          ACT(a:val(z3),'NO EXISTE '~Val(af:1))
        Endif 
       
        If NoVacio(Val(ap:1))  
          ACT(b:Val(z3), Val(ap:1) )
        Else
          ACT(b:Val(z3),'NO EXISTE '~Val(af:1))
        Endif 
       
        If NoVacio(Val(ao:1))  
          ACT(c:Val(z3), Val(ao:1) )
        Else
          ACT(c:Val(z3),'NO EXISTE '~Val(ag:1))
        Endif 
* por bloqueo
        If Eqstr(Val(al:1),'02')
          ACT(g:Val(z3), 'Bloqueado' )
        Else
          ACT(g:Val(z3),'Libre Disponibilidad')
        Endif 

          
        ACN(d:Val(z3),Val(aq:1)) 
        ACN(e:Val(z3),Val(ak:1)) 
        *--Campo Observaciones ----------------------
        If Eqstr(Val(ai:1),'0')
          If Vacio(Val(ap:1)) 
             ACT(f:Val(z3),'CUENTA INEXISTENTE')
          Else
            If Val(d:Val(z3)) <> 0
               If (NUM(Fstr(Val(d:Val(z3)),0,2)) - NUM(Fstr(Val(e:Val(z3)),0,2)))> val(ba:7) o (NUM(Fstr(Val(d:Val(z3)),0,2)) - NUM(Fstr(Val(e:Val(z3)),0,2))) < -val(ba:7)
                  ACT(f:Val(z3),'NO COINCIDE SALDO')
               ELSE
                  ACT(f:Val(z3),'OK')
               Endif
            Else
               ACT(f:Val(z3),'NO Hay SALDO en FPA')
            Endif
          Endif
        Endif  
        If Eqstr(Val(ai:1),'1')
           ACT(f:Val(z3),'CTA NORMAL CON SALDO BLOQ.POR VTAS EN DESC.')
        Else
          If Eqstr(Val(ai:1),'2')
             ACT(f:Val(z3),'CTA.NORMAL SALDO BLOQ. Prenda,Embargo,Certif.de Saldo')
          Else
            If Eqstr(Val(ai:1),'3')
               ACT(f:Val(z3),'CTA NORMAL CON SALDO BLOQ.POR DEPOSITO 48 HS.')
            Else
              If Eqstr(Val(ai:1),'4')
                 ACT(f:Val(z3),'CTA NORMAL CON SALDO BLOQ.POR DEPOSITO 48 HS.')
              Else
                If Eqstr(Val(ai:1),'5')
                   ACT(f:Val(z3),'CTA CONJUNTA CON SALDO DISPONIBLE')
                Else
                  If Eqstr(Val(ai:1),'6')
                     ACT(f:Val(z3),'CTA.CONJTA. SALDO BLOQ. Prenda,Embargo,Certif.de Saldo')
                  Endif 
                Endif 
              Endif 
            Endif 
          Endif 
        Endif 
        *--- Fin de Observaciones ----------
      scn(ba:3,1)
*      act(ba:4,Copy(val(a:val(z3))~' '~val(b:val(z3))~' '~val(c:val(z3))~' '~FSTR(val(d:val(z3)),0,2)~' '~FSTR(val(e:val(z3)),0,2)~' '~val(f:val(z3)),1,200))
* por bloqueo
      act(ba:4,Copy(val(a:val(z3))~' '~val(b:val(z3))~' '~val(c:val(z3))~' '~FSTR(val(d:val(z3)),0,2)~' '~FSTR(val(e:val(z3)),0,2)~' '~val(g:val(z3))~' '~val(f:val(z3)),1,200))

     SQL.ADD("Insert into "~DBO~".AUDITINTERFASES ")
     SQL.ADD("(Fecha,Codigo,Tipo, Linea,Detalle, Cliente, Especie, EstadosCustodia, FechaSaldo) ")
     SQL.ADD("Values ")
     SQL.ADD("('"~Fecha(Trunc(val(ba:1)),'YYYYMMDD')~" "~val(ba:6)~"','"~val(ba:2)~"','LIN', "~FSTR(val(ba:3),1,0)~", '"~val(ba:4)~"','"~iif(Vacio(Val(am:1)),'',Val(am:1))~"','"~iif(Vacio(Val(ao:1)),'',Val(ao:1))~"',"~Fstr(Num(Val(al:1)),1,0)~","~IdxDate2(Dialogo.Fecha1)~")")
     SQL.New
     SQL.EXEC

      if Eqstr(val(f:Val(z3)),'OK') o val(h:Val(z3))=1

         scn(z6,1)
         if Dialogo.Check1=0
            Borrarceldas(a:Val(z3)..h:Val(z3))
            scn(z3,-1)
         endif
      else
         scn(z7,1)
      endif
   else
      *---Fecha
      ACN(z2, Posicion('"',VAL(aa:1),Val(z1),100))
      ACT(at:1,COPY(VAL(aa:1),Val(z1),Val(z2)-Val(z1)  ))
      ACD(at:1,Fecha(Copy(val(at:1),7,2)~'/'~Copy(val(at:1),5,2)~'/'~Copy(val(at:1),1,4)))
      ACD(at:2,Habiles(Dialogo.Fecha1,1,Var('FERIDEF')))
      ACN(z1,Val(z2)+1)
      messagebox(val(at:1)~' '~val(at:2))
      if val(at:1)<>val(at:2)
         CerrarASCII
         Cancelar('El archivo '~Dialogo.String~' no pertenece al dia '~Dialogo.Fecha1)
      endif

   Endif
   BorrarCeldas(aa:1..az:1)
Proximo

CerrarASCII

dfa
If Eqstr(Val(z4),'OK')
  SetFilaActual(Val(z3)+1)
  ACN(z3,Fac)

  *-- Busco las Cuentas de Custodia de FPA que no hayan sido procesadas por la interfase 
  SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, S1.Cupon, C.RazonSocial, ")
  SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente,  ")
  SQL.ADD("       SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")
  SQL.ADD("FROM   "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
  SQL.ADD("WHERE  S1.Cliente = C.Codigo AND ")
  SQL.ADD("       E.Codigo = S1.Especie AND ")
  SQL.ADD("       S1.Saldo <> 0 AND ")
  SQL.ADD("       S1.Mercado    = 'CV' AND ")
  SQL.ADD("       S1.NrSaldo in ("~Val(bz:3)~") AND ")
  SQL.ADD("       S1.Fecha = (SELECT MAX(S2.Fecha) ")
  SQL.ADD("                   FROM   "~DBO~".SALDOSDIA S2 ")
  SQL.ADD("                   WHERE  S2.Cliente = S1.Cliente AND ")
  SQL.ADD("                          S2.NrSaldo = S1.NrSaldo AND ")
  SQL.ADD("                          S2.Cuenta = S1.Cuenta AND ")
  SQL.ADD("                          S2.Especie = S1.Especie AND ")
  SQL.ADD("                          S2.Cupon = S1.Cupon AND ")
  SQL.ADD("                          S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
  SQL.ADD("   AND Not exists (   ")
  SQL.ADD("                   SELECT 1 ")
  SQL.ADD("                     FROM "~DBO~".AUDITINTERFASES T ")
  SQL.ADD("                    WHERE Fecha ='"~Fecha(TRUNC(val(ba:1)),'YYYYMMDD')~" "~val(ba:6)~"'  ")
  SQL.ADD("                      and Tipo='LIN' ")
  SQL.ADD("                      and S1.Cliente =t.cliente ")
  SQL.ADD("                      and S1.Especie =t.especie ")
  SQL.ADD("                      and ((t.EstadosCustodia=0 AND S1.NrSaldo in ("~Val(bz:1)~")) OR (t.EstadosCustodia=2 AND S1.NrSaldo in ("~Val(bz:2)~"))) ")
  SQL.ADD("                  ) ")
  SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
  SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")
  SQL.ADD("ORDER BY S1.Especie, S1.Cupon, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.Sucursal ")

  Message('Recuperando saldos no existentes en la interfase...')
  Recorrer SQL
   
    ACN(zz:1,VAL(zz:1)+1)
    MESSAGE(VAL(zz:1))
   
   SCN(z3,1)  

   If fbn['Saldo'] <> 0.00
     ACT(a:Val(z3), Fbn['Cliente']~'-'~Copy(Fbn['RazonSocial'],1,20))
     ACT(b:Val(z3), Fbn['Cuenta'])
     ACT(c:Val(z3), Fbn['Especie']~' '~Fbn['Cupon'])
     ACN(d:Val(z3), FBN['Saldo'] )
     ACN(e:Val(z3), 0 )
     ACT(f:Val(z3), 'EXISTE EN FPA Y NO EN CV' )

     ACT(g:Val(z3), iif(Incluido(FBN['NrSaldo'],Val(bz:1)),'Libre Disponibilidad','Bloqueado' ))
     ACT(ba:10, iif(Incluido(FBN['NrSaldo'],Val(bz:1)),'0','2' ))
     
     scn(ba:3,1)
     act(ba:4,Copy(val(a:val(z3))~' '~val(b:val(z3))~' '~val(c:val(z3))~' '~FSTR(val(d:val(z3)),0,2)~' '~FSTR(val(e:val(z3)),0,2)~' '~val(g:val(z3))~' '~val(f:val(z3)),1,200))

    SQL.ADD("Insert into "~DBO~".AUDITINTERFASES ")
    SQL.ADD("(Fecha,Codigo,Tipo, Linea,Detalle, Cliente, Especie, EstadosCustodia, FechaSaldo) ")
    SQL.ADD("Values ")
    SQL.ADD("('"~Fecha(Trunc(val(ba:1)),'YYYYMMDD')~" "~val(ba:6)~"','"~val(ba:2)~"','LIN', "~FSTR(val(ba:3),1,0)~", '"~val(ba:4)~"','"~fbn['Cliente']~"','"~fbn['Especie']~"','"~val(ba:10)~"',"~IdxDate2(Dialogo.Fecha1)~")")
    SQL.New
    SQL.EXEC
     scn(z7,1)

   Else
     SCN(z3,-1)  
   Endif
     
  Proximo
Endif

SetFilaActual(Val(z3))

SetFont(a:Val(w1)+1..f:fac,1)
FormatoCeldas(d:fac..e:fac,Exe('F2'))

ACO(1,20)
ACO(2,15)
ACO(3,15)
ACO(4,12)
ACO(5,12)
ACO(6,30)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

LimitesVision(g:FAC)
RangoTitulo(a:1..g:FAC, Val(w1))



*--Actualizo Variables Fin de Corrida Interfase ----
If Eqstr(Val(z4),'MAL')
   Messagebox('La Interfase NO FINALIZO Correctamente')
   SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor='No Finalizo "~FECHA(Dialogo.Fecha1)~"' WHERE Codigo='FINCSDOM' ")
Else
  If Eqstr(Val(z4),'ERROR1')
    SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor='No Finalizo-Error Z20SDO "~FECHA(Dialogo.Fecha1)~"' WHERE Codigo='FINCSDOM' ")
    Messagebox('La Interfase no finalizo, Identificacion Z20SDO Erronea!!')
  Else
    If Eqstr(Val(z4),'ERROR2')
      SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor='No Finalizo-Error DEPOSITANTE "~FECHA(Dialogo.Fecha1)~"' WHERE Codigo='FINCSDOM' ")
      Messagebox('La Interfase no finalizo porque el archivo no corresponde al DEPOSITANTE '~Val(dp:1)~'!!')
    Else
      If Eqstr(Val(z4),'ERROR3')
        SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor='No Finalizo-Error FECHAS "~FECHA(Dialogo.Fecha1)~"' WHERE Codigo='FINCSDOM' ")
        Messagebox('La Interfase no finalizo porque las Fechas no coinciden '~Fecha(Val(as:1))~'!!')
      Else
        SQL.ADD("UPDATE "~DBO~".VARIABLES SET Valor='FIN "~FECHA(Dialogo.Fecha1)~"' WHERE Codigo='FINCSDOM' ")
        Messagebox('La Interfase finalizo con Exito. '~FSTR(val(z6),1,0)~' conciliadas '~FSTR(val(z7),1,0)~' incorrectas ')
      Endif
    Endif
  Endif
Endif
*SQL.NEW
*SQL.EXEC
