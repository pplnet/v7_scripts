HojaVisible(SI)
Mostrarcuadrodemensajes
GrillaVisible(SI)
CrearDialogo
   Fecha1   : 'Fecha_Saldos';;;;;;Dialogo.Fecha1<=FSYS;"Fecha Incorrecta ";NO;Habiles(FSys,-1,Var('FERIDEF'))
   String   : 'Archivo';;;;;;;;;;VAR('PATHSALDIA')
   Vehiculo1: 'Vehiculo';;;;;;NOVACIO(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
   Radio2   : "Estado|LD|Bloqueados|Todos|"       ;  ; ;;;;;;;2;
   Check1   : 'Muestra OK' ;;;;SI;SI;;;;1;
FinDialogo

if Not Ok
  Cancelar
endif  

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))

acd(ba:1,SQLAhora)
act(ba:2,Codigoinforme)
acn(ba:3,1)
acn(ba:7,Num(VAR('TOLERANCIA')))
act(ba:4,Copy('Usr: '~USUARIOACTIVO~' Fecha_Saldos: '~Dialogo.Fecha1~' Archivo: '~Trim(Dialogo.String)~' Vehiculo: '~Dialogo.Vehiculo1~' Muestra OK: '~IIF(Dialogo.Check1=0,'NO','SI')~' '~' Tolerancia: '~FSTR(val(ba:7),0,2),1,200))
act(ba:5,VAR('CLINOSAL'))
act(ba:6,Hora(ahora))

ACT(dp:1, BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',Dialogo.Vehiculo1))

ACT(bz:1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))
SQL.ADD("Select NrSaldo FROM "~DBO~".ESTADOSCUSTODIA where Jerarquia like '"~VAR('JERBLOQUE')~"%' ")
Recorrer Sql
  ACT(bz:2, FBN['NrSaldo']~',')
  dfa
Proximo
ACT(bz:2,Copy(val(bz:2),1,longitud(val(bz:2))-1))
If Dialogo.Radio2=0
   ACT(bz:3,Val(az1))
Else
   If Dialogo.Radio2=1
      ACT(bz:3,Val(bz:2))    
   Else
      ACT(bz:3,Val(bz:1)~','~Val(bz:2))
   Endif 
Endif

If  ExisteArchivo(Val(x1))
  WinExec('COMMAND.COM /C copy '~Dialogo.String~'.DAT  '~Dialogo.String~COPY(FECHA(Dialogo.Fecha1),9,2)~COPY(FECHA(Dialogo.Fecha1),4,2)~COPY(FECHA(Dialogo.Fecha1),1,2)~'.DAT',0)
  ESPERAR(10)
Endif

*-- Verif. existencia archivo--
If Not ExisteArchivo(Dialogo.String)
   CerrarASCII
   MESSAGEBOX("No fue creado el archivo "~Dialogo.String~" correspondiente a la fecha.")
   Cancelar
endif

**--    Borro registros del dia preexistente
SQL.ADD(" DELETE "~DBO~".AUDITINTERFASES ")
SQL.ADD(" WHERE Fecha >= '"~Fecha(TRUNC(val(ba:1)),'YYYYMMDD')~"' ")
SQL.ADD("   AND Fecha < DATEADD(day,1,'"~Fecha(TRUNC(val(ba:1)),'YYYYMMDD')~"') ")
SQL.ADD("   AND Codigo = '"~val(ba:2)~"' ")
SQL.NEW
SQL.EXEC

**--
SQL.ADD("Insert into "~DBO~".AUDITINTERFASES ")
SQL.ADD("(Fecha,Codigo,Tipo, Linea,Detalle, FechaSaldo) ")
SQL.ADD("Values ")
SQL.ADD("('"~Fecha(TRUNC(val(ba:1)),'YYYYMMDD')~" "~val(ba:6)~"','"~val(ba:2)~"','TIT', "~FSTR(val(ba:3),1,0)~", '"~val(ba:4)~"',"~IdxDate2(Dialogo.Fecha1)~")")
SQL.New
SQL.EXEC

