MostrarCuadroDeMensajes
CrearDialogo
   Fecha1     :'Fecha'         ;1;1;;;;Dialogo.Fecha1<>0;'Fecha No Valida';NO;Fsys
   Especie1   :'Especie'       ;2;1;;;;;;;
   Check3     :'PrecioReset'   ;3;1;;;;;;;1
   Check4     :'PrecioResetCon';3;2;;;;;;;1
   Check1     :'Graba Reset'   ;4;1;;;;;;;1
   Check2     :'Recalcula'     ;4;2;;;;;;;1
FinDialogo
if Not Ok
   Cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Cliente')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'NrSaldo')
ACT(f:FAC, 'CantFin')
ACT(g:FAC, 'Prec.Fin')
ACT(h:FAC, 'Prec.Res.')
ACT(i:FAC, 'Nu.P.Res.')
ACT(j:FAC, 'Fin <> 0')
ACT(k:FAC, 'Tipo')
ACT(l:FAC, 'Reset')
ACT(m:FAC, 'Recalc')

ACT(n:FAC, 'Cotiza')
ACT(o:FAC, 'Espcotiza')
ACT(p:FAC, 'TC')
ACT(q:FAC, 'Prec.Res')
ACT(r:FAC, 'Book')
ACT(s:FAC, 'Prec.Res')

if Dialogo.Check3=1  
************************
* Reset Precio
************************
  Message('Reseteo Precios - 190')
  SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONES P ")
  SQL.ADD("  where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
  IF NoVacio(Dialogo.Especie1)
    SQL.ADD("  AND P.Especie = '"~Dialogo.Especie1~"' ")
  endif
  SQL.ADD("    AND P.NrSaldo    > 190 and P.NrSaldo < 200 ")
  SQL.ADD("    AND P.CantidadFin <> 0 ")
  SQL.ADD("    AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES ")
  SQL.ADD("                   WHERE  Especie  = P.Especie  ")
  SQL.ADD("                   AND    Vehiculo = P.Vehiculo ")
  SQL.ADD("                   AND    NrSaldo  = P.NrSaldo  ")
  SQL.ADD("                   AND    Cliente  = P.Cliente  ")
  SQL.ADD("                   AND    Book     = P.Book     ")
*  SQL.ADD("                   AND   (Sector   = P.Sector   OR (Sector   IS NULL AND P.Sector   IS NULL) ) ")
*  SQL.ADD("                   AND   (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
*  SQL.ADD("                   AND   (Cupon    = P.Cupon    OR (Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
*  SQL.ADD("                   AND   (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
*  SQL.ADD("                   AND   (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
  SQL.ADD("                   and   IsNull(Unidad,'')       = IsNull(P.Unidad,'') ")
  SQL.ADD("                   and   IsNull(Centro,'')       = IsNull(P.Centro,'') ")
  SQL.ADD("                   and   IsNull(Sector,'')       = IsNull(P.Sector,'') ")
  SQL.ADD("                   and   IsNull(Sucursal,'')     = IsNull(P.Sucursal,'') ")
  SQL.ADD("                   and   IsNull(PrecioEj,0)      = IsNull(P.PrecioEj,0) ")
  SQL.ADD("                   and   IsNull(FechaEj,0)       = IsNull(P.FechaEj,0) ")
  SQL.ADD("                   and   IsNull(CallPut,'')      = IsNull(P.CallPut,'') ")
  SQL.ADD("                   and   IsNull(Estrategia,'')   = IsNull(P.Estrategia,'') ")
  SQL.ADD("                   and   IsNull(Cartera,'')      = IsNull(P.Cartera,'') ")
  SQL.ADD("                   and   IsNull(Trader,'')       = IsNull(P.Trader,'') ")
  SQL.ADD("                   and   IsNull(TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
  SQL.ADD("                   and   IsNull(Cupon,'')        = IsNull(P.Cupon,'') ")
  SQL.ADD("                   and   IsNull(Responsable,'')  = IsNull(P.Responsable,'') ")
  SQL.ADD("                   and   IsNull(TipoPosicion,'') = IsNull(P.TipoPosicion,'') ")
  SQL.ADD("                   and   IsNull(Producto,'')     = IsNull(P.Producto,'') ")
  SQL.ADD("                   and   IsNull(GrupoEspecie,'') = IsNull(P.GrupoEspecie,'') ")
  SQL.ADD("                   and   IsNull(CarteraBCRA,'')  = IsNull(P.CarteraBCRA,'') ")
  SQL.ADD("                   AND   Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD("                  ) ")
  SQL.ADD("Order by P.NrSaldo,P.Cliente,P.Book,P.Especie,P.Cupon,P.Estrategia,P.Fecha ")

  watch(SQL.batch())

  Recorrer SQL

    Message('NrSaldo: '~FStr(fbn('NrSaldo'),1,0)~' / Book: '~fbn('Book')~' / Especie: '~fbn('Especie')~' / Cupon: '~fbn('Cupon'))
    ACD(a:FAC, fbn('Fecha')) 
**   ACN(i:FAC, COTIZACIONC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'ARP'))
    ACN(i:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')),,,,Dialogo.Fecha1,25,SI,'ARP'))
    IF Dialogo.Check1=0
      ACT(b:FAC, fbn('Cliente'))
      ACT(c:FAC, fbn('Vehiculo'))
      ACT(d:FAC, fbn('Especie'))
      ACN(e:FAC, fbn('NrSaldo'))
      ACN(f:FAC, fbn('CantidadFin'))
      ACN(g:FAC, fbn('PrecioFin'))
      ACN(h:FAC, fbn('PrecioReset'))
      ACT(r:FAC, fbn('Book'))


      ACN(n:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1))
      ACT(o:FAC, BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
      ACN(p:FAC, COTIZACIONC(Val(o:FAC),,,,Dialogo.Fecha1,25,SI,'ARP'))
      ACN(q:FAC, Val(n:FAC)*Val(p:FAC))
    endif
    
    if fbn('CantidadFin') <> 0
      ACT(j:FAC, 'SI')
      if Val(a:FAC)=Dialogo.Fecha1
        ACT(k:FAC, 'Update')
        IF Dialogo.Check1=1
          ACT(l:FAC, 'SI')
      
          SQL.ADD("UPDATE "~DBO~".POSICIONES ")
          SQL.ADD("SET   PrecioReset   = "~FStr(Val(i:FAC),0,8)~" ")

          SQL.ADD("WHERE Vehiculo    = '"~FBN['Vehiculo']~"'        ")
          SQL.ADD("  and Cliente     = '"~FBN['Cliente']~"'         ")
          SQL.ADD("  and Especie     = '"~FBN['Especie']~"'         ")
          SQL.ADD("  and NrSaldo     = "~FStr(FBN['NrSaldo'],0,0)~" ")
          SQL.ADD("  and Book        = '"~FBN['Book']~"'            ")
          SQL.ADD("  and Fecha       = '"~IdxDate(Val(a:FAC))~"'    ")
          SQL.ADD("  and IsNull(Unidad,'')       = IsNull('"~FBN['Unidad']~"','')       ")
          SQL.ADD("  and IsNull(Centro,'')       = IsNull('"~FBN['Centro']~"','')       ")
          SQL.ADD("  and IsNull(Sector,'')       = IsNull('"~FBN['Sector']~"','')       ")
          SQL.ADD("  and IsNull(Sucursal,'')     = IsNull('"~FBN['Sucursal']~"','')     ")
          SQL.ADD("  and IsNull(PrecioEj,0)      = IsNull('"~FBN['PrecioEj']~"',0)      ")
          SQL.ADD("  and IsNull(FechaEj,0)       = IsNull('"~FBN['FechaEj']~"',0)       ")
          SQL.ADD("  and IsNull(CallPut,'')      = IsNull('"~FBN['CallPut']~"','')      ")
          SQL.ADD("  and IsNull(Estrategia,'')   = IsNull('"~FBN['Estrategia']~"','')   ")
          SQL.ADD("  and IsNull(Cartera,'')      = IsNull('"~FBN['Cartera']~"','')      ")
          SQL.ADD("  and IsNull(Trader,'')       = IsNull('"~FBN['Trader']~"','')       ")
          SQL.ADD("  and IsNull(TipoNegocio,'')  = IsNull('"~FBN['TipoNegocio']~"','')  ")
          SQL.ADD("  and IsNull(Cupon,'')        = IsNull('"~FBN['Cupon']~"','')        ")
          SQL.ADD("  and IsNull(Responsable,'')  = IsNull('"~FBN['Responsable']~"','')  ")
          SQL.ADD("  and IsNull(TipoPosicion,'') = IsNull('"~FBN['TipoPosicion']~"','') ")
          SQL.ADD("  and IsNull(Producto,'')     = IsNull('"~FBN['Producto']~"','')     ")
          SQL.ADD("  and IsNull(GrupoEspecie,'') = IsNull('"~FBN['GrupoEspecie']~"','') ")
          SQL.ADD("  and IsNull(CarteraBCRA,'')  = IsNull('"~FBN['CarteraBCRA']~"','')  ")
          SQL.NEW
          SQL.EXEC

        endif
      else
        ACT(k:FAC, 'Insert')
        IF Dialogo.Check1=1
          ACT(l:FAC, 'SI')
          SQL.ADD("insert into "~DBO~".POSICIONES ( ")
          SQL.ADD("     Fecha,         Cliente,      Vehiculo,     Unidad,       Centro, ")
          SQL.ADD("     Sector,        Sucursal,     NrSaldo,      Especie,      PrecioEj, ")
          SQL.ADD("     FechaEj,       CallPut,      Precio1,      Precio2,      ValorUSD, ")
          SQL.ADD("     ValorARP,      Estrategia,   Cartera,      Book,         Trader, ")
          SQL.ADD("     TipoNegocio,   ")
          SQL.ADD("     Cantidad1,     Cantidad2,    Cantidad3,    Cantidad4,     Cantidad5,     ")
          SQL.ADD("     Precio3,       Precio4,      Precio5,      ")
          SQL.ADD("     CantidadIni,   PrecioIni,    CantidadFin,  PrecioFin,    ")
          SQL.ADD("     Cupon,         Responsable,  TipoPosicion, Producto,     GrupoEspecie, ")
          SQL.ADD("     CarteraBCRA,   PrecioIniBE,  PrecioFinBE,  PrecioHist,   PrecioReset,  ")
          SQL.ADD("     PrecioIniCon,  PrecioFinCon, ")
          SQL.ADD("     CantidadReset, PrecioFinHist, ")
**FJL 03/05/21 - Por nuevos precios Con 
          SQL.ADD("     PrecioResetCon, PrecioHistCon, PrecioFinHistCon ")
          SQL.ADD("    ) ")
          SQL.ADD("select '"~IdxDate(Dialogo.Fecha1)~"', Cliente, Vehiculo, Unidad, Centro, ")
          SQL.ADD("     Sector,        Sucursal,   NrSaldo, Especie, PrecioEj, ")
          SQL.ADD("     FechaEj,       CallPut,    0, 0, ValorUSD, ")
          SQL.ADD("     ValorARP,      Estrategia, Cartera, Book, Trader, ")
          SQL.ADD("     TipoNegocio,   ")
          SQL.ADD("     0, 0, 0, 0, 0, ")
          SQL.ADD("     0, 0, 0,       ")
          *             CantidadIni    PrecioIni                  PrecioFin
          SQL.ADD("     CantidadFin,   PrecioReset, CantidadFin,  PrecioReset, ")
          SQL.ADD("     Cupon,         Responsable, TipoPosicion, Producto,   GrupoEspecie, ")
          SQL.ADD("     CarteraBCRA,   PrecioIniBE, PrecioFinBE,  PrecioHist, "~FStr(Val(i:FAC),0,8)~", ")
**FJL 03/05/21 - Por nuevos precios Con 
*          SQL.ADD("     PrecioIniCon,  PrecioFinCon, ")
          SQL.ADD("     PrecioFinCon,  PrecioFinCon, ")
          SQL.ADD("     CantidadReset, PrecioFinHist, ")
**FJL 03/05/21 - Por nuevos precios Con 
          SQL.ADD("     PrecioResetCon, PrecioHistCon, PrecioFinHistCon ")
          SQL.ADD(" from  "~DBO~".POSICIONES ")
          SQL.ADD("WHERE Vehiculo    = '"~FBN['Vehiculo']~"'                 ")
          SQL.ADD("  and Cliente     = '"~FBN['Cliente']~"'                  ")
          SQL.ADD("  and Especie     = '"~FBN['Especie']~"'                  ")
          SQL.ADD("  and NrSaldo     = "~FStr(FBN['NrSaldo'],0,0)~"          ")
          SQL.ADD("  and Book        = '"~FBN['Book']~"'                     ")
          SQL.ADD("  and Fecha       = '"~IdxDate(Val(a:FAC))~"'             ")
          SQL.ADD("  and IsNull(Unidad,'')       = IsNull('"~FBN['Unidad']~"','')       ")
          SQL.ADD("  and IsNull(Centro,'')       = IsNull('"~FBN['Centro']~"','')       ")
          SQL.ADD("  and IsNull(Sector,'')       = IsNull('"~FBN['Sector']~"','')       ")
          SQL.ADD("  and IsNull(Sucursal,'')     = IsNull('"~FBN['Sucursal']~"','')     ")
          SQL.ADD("  and IsNull(PrecioEj,0)      = IsNull('"~FBN['PrecioEj']~"',0)      ")
          SQL.ADD("  and IsNull(FechaEj,0)       = IsNull('"~FBN['FechaEj']~"',0)       ")
          SQL.ADD("  and IsNull(CallPut,'')      = IsNull('"~FBN['CallPut']~"','')      ")
          SQL.ADD("  and IsNull(Estrategia,'')   = IsNull('"~FBN['Estrategia']~"','')   ")
          SQL.ADD("  and IsNull(Cartera,'')      = IsNull('"~FBN['Cartera']~"','')      ")
          SQL.ADD("  and IsNull(Trader,'')       = IsNull('"~FBN['Trader']~"','')       ")
          SQL.ADD("  and IsNull(TipoNegocio,'')  = IsNull('"~FBN['TipoNegocio']~"','')  ")
          SQL.ADD("  and IsNull(Cupon,'')        = IsNull('"~FBN['Cupon']~"','')        ")
          SQL.ADD("  and IsNull(Responsable,'')  = IsNull('"~FBN['Responsable']~"','')  ")
          SQL.ADD("  and IsNull(TipoPosicion,'') = IsNull('"~FBN['TipoPosicion']~"','') ")
          SQL.ADD("  and IsNull(Producto,'')     = IsNull('"~FBN['Producto']~"','')     ")
          SQL.ADD("  and IsNull(GrupoEspecie,'') = IsNull('"~FBN['GrupoEspecie']~"','') ")
          SQL.ADD("  and IsNull(CarteraBCRA,'')  = IsNull('"~FBN['CarteraBCRA']~"','')  ")
          SQL.NEW
          SQL.EXEC      
        endif
      endif
    endif

    IF Dialogo.Check2=1
      ACT(m:FAC, 'SI')
      SQL.ADD("EXEC "~DBO~".RecalculaPosiciones ")
      SQL.ADD(IdxDate2(Dialogo.Fecha1)~", ")
      SQL.ADD(" '"~FBN['Cliente']~"', ")
      SQL.ADD(" '"~FBN['Vehiculo']~"', ")
      SQL.ADD(" '"~FBN['Unidad']~"', ")
      SQL.ADD(" '"~FBN['Centro']~"', ")
      SQL.ADD(" '"~FBN['Sector']~"', ")
      SQL.ADD(" '"~FBN['Sucursal']~"', ") 
      SQL.ADD(" "~Fstr(FBN['NrSaldo'],3,0)~", ")
      SQL.ADD(" '"~FBN['Especie']~"', ")
      SQL.ADD(" NULL,")
      SQL.ADD(" NULL,")
      SQL.ADD(" '"~FBN['CallPut']~"', ")
      SQL.ADD(" '"~FBN['Cupon']~"', ")
      SQL.ADD(" '"~FBN['Estrategia']~"', ")
      SQL.ADD(" '"~FBN['Cartera']~"', ")
      SQL.ADD(" '"~FBN['Book']~"', ") 
      SQL.ADD(" '"~FBN['Trader']~"', ")
      SQL.ADD(" '"~FBN['TipoNegocio']~"', ")
      SQL.ADD(" '"~FBN['Responsable']~"', ")
      SQL.ADD(" '"~FBN['TipoPosicion']~"', ")
      SQL.ADD(" '"~FBN['Producto']~"', ")
      SQL.ADD(" '"~FBN['GrupoEspecie']~"', ")
      SQL.ADD(" '"~FBN['CarteraBCRA']~"' ")
      SQL.NEW
      SQL.EXEC
    endif
  Proximo
endif

if Dialogo.Check4=1
************************
* Reset PrecioCon
************************  
  Message('Reseteo PreciosCont - 170')
  SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONES P ")
  SQL.ADD("  where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
  IF NoVacio(Dialogo.Especie1)
    SQL.ADD("  AND P.Especie = '"~Dialogo.Especie1~"' ")
  endif
  SQL.ADD("    AND P.NrSaldo    > 170 and P.NrSaldo < 180 ")
  SQL.ADD("    AND P.CantidadFin <> 0 ")
  SQL.ADD("    AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES ")
  SQL.ADD("                   WHERE  Especie  = P.Especie  ")
  SQL.ADD("                   AND    Vehiculo = P.Vehiculo ")
  SQL.ADD("                   AND    NrSaldo  = P.NrSaldo  ")
  SQL.ADD("                   AND    Cliente  = P.Cliente  ")
  SQL.ADD("                   AND    Book     = P.Book     ")
*  SQL.ADD("                   AND   (Sector   = P.Sector   OR (Sector   IS NULL AND P.Sector   IS NULL) ) ")
*  SQL.ADD("                   AND   (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
*  SQL.ADD("                   AND   (Cupon    = P.Cupon    OR (Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
*  SQL.ADD("                   AND   (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
*  SQL.ADD("                   AND   (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
  SQL.ADD("                   and   IsNull(Unidad,'')       = IsNull(P.Unidad,'') ")
  SQL.ADD("                   and   IsNull(Centro,'')       = IsNull(P.Centro,'') ")
  SQL.ADD("                   and   IsNull(Sector,'')       = IsNull(P.Sector,'') ")
  SQL.ADD("                   and   IsNull(Sucursal,'')     = IsNull(P.Sucursal,'') ")
  SQL.ADD("                   and   IsNull(PrecioEj,0)      = IsNull(P.PrecioEj,0) ")
  SQL.ADD("                   and   IsNull(FechaEj,0)       = IsNull(P.FechaEj,0) ")
  SQL.ADD("                   and   IsNull(CallPut,'')      = IsNull(P.CallPut,'') ")
  SQL.ADD("                   and   IsNull(Estrategia,'')   = IsNull(P.Estrategia,'') ")
  SQL.ADD("                   and   IsNull(Cartera,'')      = IsNull(P.Cartera,'') ")
  SQL.ADD("                   and   IsNull(Trader,'')       = IsNull(P.Trader,'') ")
  SQL.ADD("                   and   IsNull(TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
  SQL.ADD("                   and   IsNull(Cupon,'')        = IsNull(P.Cupon,'') ")
  SQL.ADD("                   and   IsNull(Responsable,'')  = IsNull(P.Responsable,'') ")
  SQL.ADD("                   and   IsNull(TipoPosicion,'') = IsNull(P.TipoPosicion,'') ")
  SQL.ADD("                   and   IsNull(Producto,'')     = IsNull(P.Producto,'') ")
  SQL.ADD("                   and   IsNull(GrupoEspecie,'') = IsNull(P.GrupoEspecie,'') ")
  SQL.ADD("                   and   IsNull(CarteraBCRA,'')  = IsNull(P.CarteraBCRA,'') ")
  SQL.ADD("                   AND   Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD("                  ) ")
  SQL.ADD("Order by P.NrSaldo,P.Cliente,P.Book,P.Especie,P.Cupon,P.Estrategia,P.Fecha ")

  watch(SQL.batch())

  Recorrer SQL

    Message('NrSaldo: '~FStr(fbn('NrSaldo'),1,0)~' / Book: '~fbn('Book')~' / Especie: '~fbn('Especie')~' / Cupon: '~fbn('Cupon'))
    ACD(a:FAC, fbn('Fecha')) 
    IF Dialogo.Check1=0
      ACT(b:FAC, fbn('Cliente'))
      ACT(c:FAC, fbn('Vehiculo'))
      ACT(d:FAC, fbn('Especie'))
      ACN(e:FAC, fbn('NrSaldo'))
      ACN(f:FAC, fbn('CantidadFin'))
      ACN(g:FAC, fbn('PrecioFinCon'))
      ACN(h:FAC, fbn('PrecioResetCon'))
      ACT(r:FAC, fbn('Book'))
    endif

    ***---Precio Cierre NIIF
    Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'))
    IF Vacio(&PrecioNIIF)
      ACN(i:FAC, 0)
      ACT(u:FAC, 'NIIF cero')
    ELSE
      ACN(i:FAC, &PrecioNIIF.PrecioCotizacionDeterminada)
    ENDIF
  
    if Val(i:FAC)=0
      IF Dialogo.Check1=0
        ACN(n:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1))
        ACT(o:FAC, BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
        ACN(p:FAC, COTIZACIONC(Val(o:FAC),,,,Dialogo.Fecha1,25,SI,'ARP'))
        ACN(q:FAC, Val(n:FAC)*Val(p:FAC))
      endif
      ACN(s:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')),,,,Dialogo.Fecha1,25,SI,'ARP'))
      ACN(i:FAC, Val(s:FAC))
    endif

    if fbn('CantidadFin') <> 0
      ACT(j:FAC, 'SI')
      if Val(a:FAC)=Dialogo.Fecha1
        ACT(k:FAC, 'Update')
        IF Dialogo.Check1=1
          ACT(l:FAC, 'SI')
      
          SQL.ADD("UPDATE "~DBO~".POSICIONES ")
          SQL.ADD("SET   PrecioResetCon   = "~FStr(Val(i:FAC),0,8)~" ")

          SQL.ADD("WHERE Vehiculo    = '"~FBN['Vehiculo']~"'        ")
          SQL.ADD("  and Cliente     = '"~FBN['Cliente']~"'         ")
          SQL.ADD("  and Especie     = '"~FBN['Especie']~"'         ")
          SQL.ADD("  and NrSaldo     = "~FStr(FBN['NrSaldo'],0,0)~" ")
          SQL.ADD("  and Book        = '"~FBN['Book']~"'            ")
          SQL.ADD("  and Fecha       = '"~IdxDate(Val(a:FAC))~"'    ")
          SQL.ADD("  and IsNull(Unidad,'')       = IsNull('"~FBN['Unidad']~"','')       ")
          SQL.ADD("  and IsNull(Centro,'')       = IsNull('"~FBN['Centro']~"','')       ")
          SQL.ADD("  and IsNull(Sector,'')       = IsNull('"~FBN['Sector']~"','')       ")
          SQL.ADD("  and IsNull(Sucursal,'')     = IsNull('"~FBN['Sucursal']~"','')     ")
          SQL.ADD("  and IsNull(PrecioEj,0)      = IsNull('"~FBN['PrecioEj']~"',0)      ")
          SQL.ADD("  and IsNull(FechaEj,0)       = IsNull('"~FBN['FechaEj']~"',0)       ")
          SQL.ADD("  and IsNull(CallPut,'')      = IsNull('"~FBN['CallPut']~"','')      ")
          SQL.ADD("  and IsNull(Estrategia,'')   = IsNull('"~FBN['Estrategia']~"','')   ")
          SQL.ADD("  and IsNull(Cartera,'')      = IsNull('"~FBN['Cartera']~"','')      ")
          SQL.ADD("  and IsNull(Trader,'')       = IsNull('"~FBN['Trader']~"','')       ")
          SQL.ADD("  and IsNull(TipoNegocio,'')  = IsNull('"~FBN['TipoNegocio']~"','')  ")
          SQL.ADD("  and IsNull(Cupon,'')        = IsNull('"~FBN['Cupon']~"','')        ")
          SQL.ADD("  and IsNull(Responsable,'')  = IsNull('"~FBN['Responsable']~"','')  ")
          SQL.ADD("  and IsNull(TipoPosicion,'') = IsNull('"~FBN['TipoPosicion']~"','') ")
          SQL.ADD("  and IsNull(Producto,'')     = IsNull('"~FBN['Producto']~"','')     ")
          SQL.ADD("  and IsNull(GrupoEspecie,'') = IsNull('"~FBN['GrupoEspecie']~"','') ")
          SQL.ADD("  and IsNull(CarteraBCRA,'')  = IsNull('"~FBN['CarteraBCRA']~"','')  ")
          SQL.NEW
          SQL.EXEC

        endif
      else
        ACT(k:FAC, 'Insert')
        IF Dialogo.Check1=1
