CrearDialogo
  NrOperacion1 : "NrOperacion"     ;;;;
FinDialogo

If not OK
   Cancelar
Endif


SQL.ADD(" Delete from "~DBO~".CUOTAS ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.NEW
SQL.EXEC

SQL.ADD(" Select Cantidad, Precio1, RB8, Spread, FechaOp, FechaVto, TablaFeriados1  ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("   AND RB10 = 1 ")
SQL.ADD("   AND RB14 = 0 ")

Recorrer SQL
   **// Valor Nominal
   ACN(CN:1, FBN('Cantidad'))
   **// Tasa Interes
   ACN(TS:1, FBN('Precio1')+FBN('Spread'))
   **// Unidad Tiempo
   IF FBN('RB8')=1
      ACN(UT:1, 36500)
   Else
      ACN(UT:1, 36000)
   Endif
   ACD(FO:1, FBN('FechaOp'))
   ACD(FV:1, FBN('FechaVto'))
   ACT(TF:1, FBN('TablaFeriados1'))
Proximo

**// FD:1 = Fecha Inicial de la cuota
ACD(FD:1, Val(FO:1))
**// CT:1 = NrCuota
ACN(CT:1, 0)

Recorrer&k Val(FO:1), Val(FV:1) 
   **// Ultimo dia, FechaVto, cierro cuota
   If &k=Val(FV:1)
      ACD(FH:1, Val(FV:1))
      ACD(FL:1, Val(FV:1))
      
      **// CALCULO INTERESES Y GENERO CUOTA
      ACN(PL:1, Val(FH:1)-Val(FD:1))
      ACN(IN:1, Val(CN:1)*Val(TS:1)*Val(PL:1)/Val(UT:1))
      SCN(CT:1, 1)
      SQL.ADD(" Insert Into "~DBO~".CUOTAS ")
      SQL.ADD(" (NrOperacion,  NrCuota,    Cantidad1,   Cantidad2, ")
      SQL.ADD("  Fecha1,       Fecha2,     Fecha3 ) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Dialogo.NrOperacion1~"', "~Fstr(Val(CT:1), 0, 0)~", 0, "~Fstr(Val(IN:1),0,2)~",  ")
      SQL.ADD("  '"~IdxDate(Val(FL:1))~"', '"~IdxDate(Val(FD:1))~"', '"~IdxDate(Val(FH:1))~"' ) ")
      SQL.NEW
      Break
   Endif

   If &k=FinDeMes(Val(FD:1), SI)
      ACD(FH:1, &k+1)
      ACD(FL:1, Habiles(Val(FH:1)-1,1,Val(TF:1)))
      
      **// CALCULO INTERESES Y GENERO CUOTA
      ACN(PL:1, Val(FH:1)-Val(FD:1))
      ACN(IN:1, Val(CN:1)*Val(TS:1)*Val(PL:1)/Val(UT:1))
      SCN(CT:1, 1)
      SQL.ADD(" Insert Into "~DBO~".CUOTAS ")
      SQL.ADD(" (NrOperacion,  NrCuota,    Cantidad1,   Cantidad2, ")
      SQL.ADD("  Fecha1,       Fecha2,     Fecha3 ) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Dialogo.NrOperacion1~"', "~Fstr(Val(CT:1), 0, 0)~", 0, "~Fstr(Val(IN:1),0,2)~",  ")
      SQL.ADD("  '"~IdxDate(Val(FL:1))~"', '"~IdxDate(Val(FD:1))~"', '"~IdxDate(Val(FH:1))~"' ) ")
      SQL.NEW

      ACD(FD:1, Val(FH:1))
    Endif
Proximo
SQL.EXEC

SQL.ActualizarMovimientos4(Dialogo.NrOperacion1,SI,NO,NO,NO,NO,NO)
SQL.EXEC