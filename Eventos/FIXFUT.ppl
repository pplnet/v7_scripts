*HojaVisible(si)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'       ;1;1; ;  ;  ;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1<=FSys;'Fecha Invalida';NO;FSys;
  Vehiculo1: 'Vehiculo:'   ;2;1; ;NO;SI;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Cliente1 : 'Cliente'     ;3;1; ;NO;NO;
  Check1   : 'Procesa'     ;1;2; ;NO;NO;;;;1;
  Check2   : 'Ejec.Liq.'   ;2;2; ;NO;NO;;;;1;
  Check3   : 'Contingencia';3;2; ;NO;NO;;;;0;
  Lista1   : 'Mercado'     ; ;1; ;SI;  ;;;;;;SQLSet("Select Codigo from "~DBO~".MERCADOS Where TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%'  ")
  Lista2   : 'Producto'    ; ;1; ;SI;  ;;;;;;'Titulo|Moneda'
FinDialogo

if not ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif


If Eqstr(VAR('MTMRFXSIG') , 'SI')
     ACD(fe:3, Habiles(Dialogo.Fecha1, +1, 'ARG'))
Else
     ACD(fe:3, Dialogo.Fecha1)
Endif
    
If Eqstr(VAR('MTMMAESIG') , 'SI')
     ACD(fe:2, Habiles(Dialogo.Fecha1, +1, 'ARG'))
Else
     ACD(fe:2, Dialogo.Fecha1)
Endif

* Log Corrida
ACT(aa1,VAR('PATHLOGAUD')~'LOGMTM.TXT')
AbrirASCII(val(aa1),0)

EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Comienzo Corrida FIXFUT ')

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

IF NoVacio(Dialogo.Lista1)
    ACT(LS:1, Dialogo.Lista1)
ELSE
    ACT(LS:1, SQLSet("Select Codigo from "~DBO~".MERCADOS Where TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%'"))
ENDIF
IF NoVacio(Dialogo.Lista2)
    ACT(LS:2, Dialogo.Lista2)
ELSE
    ***---ACT(LS:2, 'Titulo|Moneda|Tasa')
    ***---Se deja provisoriamente hasta que se defina tema PRODUCTOS
    ACT(LS:2, 'Titulo|Moneda')
ENDIF

SetFilaActual(1)
ACT(a:FAC, 'Mercado')
ACT(b:FAC, 'Producto')
ACT(c:FAC, 'Cant Ops')
ACT(d:FAC, 'Cont.Precio')
ACT(e:FAC, 'Ult fecha')
ACT(f:FAC, 'Cont.Fecha')
ACT(g:FAC, 'Tipo Error')
ACT(h:FAC, 'Hay Operaciones')
SetFont(a:fac..l:fac,2)

ACT(aa:FAC, 'Mercado')
ACT(ab:FAC, 'Producto')
ACT(ac:FAC, 'Nr Op')
ACT(ad:FAC, 'Tipo Op')
ACT(ae:FAC, 'Cot Hoy')
ACT(af:FAC, 'Cot Ayer')
ACT(ag:FAC, 'Cot Ant')
ACT(ah:FAC, 'Difer.')
ACT(ai:FAC, 'FIX')
ACT(aj:FAC, 'FIX USD')

SetFont(aa:fac..al:fac,2)

** Armo lista de Mercado - Producto
ACN(x:1, FAC)
Recorrer&k 1, Elementos(Val(LS:1))
  * Recorre Mercados
  Recorrer&j 1, Elementos(Val(LS:2))
    * Recorre Productos
    IFA
    ACT(a:FAC, ItemLista(Val(LS:1), &k))
    ACT(b:FAC, ItemLista(Val(LS:2), &j))
  proximo
proximo
ACN(y:1, FAC)

if Val(y:1)=Val(x:1)
  if Dialogo.Check1=1
    Cancelar('No existe Mercado+Producto para analizar')
  else
    MessageBox('No existe Mercado+Producto para analizar')
  endif
endif

if Val(y:1)>Val(x:1)
  ***---Controlo si estan los precios para todas las operaciones
  Recorrer&k 2, Val(y:1)
    * Recorre Mercados+Producto
    ACT(d:&k, 'OK')
    SQL.ADD("Select O.Especie, O.ContraEspecie, O.FechaVto, O.Mercado, O.TablaFeriados1, O.Contraespecie2, ")
    SQL.ADD("       IsNull(O.Lotes,0) as DiasAnt,      ")
    SQL.ADD("       O.EsCaucionado as HabCorr, O.TasaEspecie MonLiquida        ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
    SQL.ADD(" WHERE O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   AND O.Mercado  = '"~Val(a:&k)~"' ")
    IF EqStr(Val(b:&k),'Moneda')
      SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
    ENDIF
    IF EqStr(Val(b:&k),'Titulo')
      SQL.ADD(" AND O.TipoOp IN ('TICF','TIVF') ")
    ENDIF
    IF NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1    = '"~Dialogo.Cliente1~"' ")
    ENDIF
    SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
    SQL.ADD("   and B.NrBit       in (10,70) ")
    SQL.ADD("   and B.Valor       = '1' ")
    SQL.ADD(" Order By O.FechaVto, O.NrOperacion ")
    watch(SQL.BATCH())
    Recorrer SQL
      DFA
      SCN(c:&k, 1)
      if EqStr(Val(d:&k), 'OK')
         ACD(FE:1,Dialogo.Fecha1)
         ACN(NR:1, SQL("Select 1 From "~DBO~".MERCADOS Where Codigo = '"~fbn('Mercado')~"' AND Regulado = 'NO' "))      
         IF Val(NR:1)=1
            If EqStr(fbn('HabCorr'),'1')
               ACD(FE:1,Habiles(Dialogo.Fecha1,-1*fbn('DiasAnt'),fbn['TablaFeriados1']))
            Else
               ACD(FE:1,Habiles(Dialogo.Fecha1,-1*fbn('DiasAnt'),fbn['TablaFeriados1'],NO))
            Endif
         Endif
         if Not EsHabil(val(FE:1),VAR('FERIDEF'))
            ACD(FE:1,Habiles(val(FE:1),-1,VAR('FERIDEF'),SI))
         endif
         if SQL("Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~fbn('ContraEspecie2')~"' AND Moneda = '"~fbn('ContraEspecie')~"' and CallPut = 'CON' AND Fecha = "~IdxDate2(val(FE:1))~" ") <> 1
            MessageBox('Faltan Cotizaciones para el Fixing de '~fbn('ContraEspecie2')~' del '~val(fe:1)~' Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~'. Fixing cancelado para este Mercado+Producto')
            ACT(d:&k, 'Error')
        endif
      endif
    Proximo
  Proximo
endif

 EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - Control Precios')

if Val(y:1)>Val(x:1)
  ***---Controlo si ya fue procesado para cada mercado y producto seleccionado
  Recorrer&k 2, Val(y:1)
    if EqStr(Val(d:&k),'OK')
      ACD(e:&k, SQL(" Select Max(Fecha) From "~DBO~".MTM Where Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'FIX' AND Estado = 'PRO' "))
      ACT(f:&k, 'OK')
      IF Val(e:&k) = Dialogo.Fecha1
      IF SQL(" Select 1 From "~DBO~".MTM Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'FIX' AND Estado = 'PRO' ") = 1
          ACT(f:&k, 'Error')
          ACT(g:&k, 'FIX ya procesado')
          MessageBox('FIX ya procesado para Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~' - Fecha '~Dialogo.Fecha1)
        ENDIF
      ELSE
        IF Val(e:&k) > 0
            * IF Val(e:&k) < Habiles(Dialogo.Fecha1, -1, 'ARG')
            *    ACT(f:FAC, 'Error')
            *    ACT(g:FAC, 'Faltan MTM')
            *    MessageBox('El ultimo MTM procesado para el Mercado '~Val(a:&k)~' - Producto '~Val(b:&k)~' es del '~Val(e:&k)~' - DEBE PROCESAR LOS MTM FALTANTES PRIMERO')
            * endif
        ENDIF
      ENDIF
    endif
  Proximo
endif
    
if Val(y:1)>Val(x:1)
  SetFilaActual(1)
  Recorrer&k 2, Val(y:1)
    * Recorre Mercado+Productos
    acn(h:&k,0)
    IF EqStr(Val(d:&k),'OK') y EqStr(Val(f:&k),'OK')
      ***---FALTA FILTRAR POR PRODUCTO CUANDO SE DEFINA TEMA TABLA PARA PRODUCTOS
      SQL.ADD("Select O.NrOperacion,    O.TipoOp,        O.Cliente1,       O.Especie,     O.Cantidad,     ")
      SQL.ADD("       O.Precio1,        O.ContraEspecie, O.TotalBrutoCli1, O.Vehiculo1,   O.Book1,        O.Cuenta4,     ")
      SQL.ADD("       O.FechaOp,        O.FechaVto,      O.FechaPago,      O.FechaPrecan, O.PrecioMer,    O.Mercado2,    ")
      SQL.ADD("       O.FechaUltCupon,  O.PrecioEj,      O.FechaEj,        O.MB1,         O.ObsErrorMAE,  O.TasaEspecie, ")
      SQL.ADD("       O.TotalAux1,      O.TotalAux3,     O.ContraEspecie2, O.EnteCus1,    O.Mercado,      O.MB4,         ")
      SQL.ADD("       O.TablaFeriados1, O.Mercado ,      IsNull(O.Lotes,0) as DiasAnt,    O.Mercado4,    ")
      SQL.ADD("       O.EsCaucionado as HabCorr,         O.TasaEspecie MonLiquida,        M.Regulado,     O.Plazo        ")
      SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C , "~DBO~".OPERACIONESBITS B, "~DBO~".MERCADOS M  ")
      SQL.ADD(" Where C.Codigo    = O.Cliente1 ")
      SQL.ADD(" AND O.Mercado = '"~Val(a:&k)~"' ")
      SQL.ADD("   AND O.Mercado4=M.Codigo ")
      SQL.ADD(" AND O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   AND IsNull(O.CB6,0)='0' ")
      SQL.ADD(" AND O.NrOperacion = B.NrOperacion ")
      SQL.ADD("   and B.NrBit   in (10,70) ")
      SQL.ADD("   and B.Valor   = '1' ")
      IF EqStr(Val(b:&k),'Moneda')
        SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
      ENDIF
      IF EqStr(Val(b:&k),'Titulo')
        SQL.ADD(" AND O.TipoOp IN ('TICF','TIVF') ")
      ENDIF
      if NoVacio(Dialogo.Cliente1)
        SQL.ADD("   and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
      endif
      SQL.ADD(" Order By O.FechaVto, O.NrOperacion ")

      EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - Lectura x Mercado '~Val(a:&k)~' Producto '~Val(b:&k))
      
      Recorrer SQL
        Message(fbn('NrOperacion'))
        ACT(aa:FAC, Val(a:&k))
        ACT(ab:FAC, Val(b:&k))
        ACT(ac:FAC, fbn('NrOperacion'))
        ACT(ad:FAC, fbn('TipoOp'))
        ACT(me:1, fbn('Mercado4'))
        ACD(FE:1,Dialogo.Fecha1)
        ACN(NR:1, SQL("Select 1 From "~DBO~".MERCADOS Where Codigo = '"~fbn('Mercado')~"' AND Regulado = 'NO' "))      
        IF Val(NR:1)=1
           If EqStr(fbn('HabCorr'),'1')
              ACD(FE:1,Habiles(Dialogo.Fecha1,-1*fbn('DiasAnt'),fbn['TablaFeriados1']))
           Else
              ACD(FE:1,Habiles(Dialogo.Fecha1,-1*fbn('DiasAnt'),fbn['TablaFeriados1'],NO))
           Endif
        Endif
        if Not EsHabil(val(FE:1),VAR('FERIDEF'))
           ACD(FE:1,Habiles(val(FE:1),-1,VAR('FERIDEF'),SI))
        endif
        IF EqStr(Val(ab:FAC),'Moneda')
           *ACN(CT:1, CotizacionC(fbn('ContraEspecie2'),'CON',,,Val(FE:1),1,,fbn('ContraEspecie')))
           ACN(CT:1, SQL("Select Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~fbn('ContraEspecie2')~"' AND Moneda = '"~fbn('ContraEspecie')~"' and CallPut = 'CON' AND Fecha = "~IdxDate2(val(FE:1))~" "))
           if Eqstr(FBN['Regulado'],'SI')
              if FBN['Plazo']=0
                ACN(CT:2, FBN['Precio1'])         
              else
                ACN(CT:2, SQL("Select Top(1) Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' AND Moneda = '"~fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(fbn('FechaVto'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha < '"~IdxDate(Val(FE:1))~"' Order By Fecha Desc "))
              endif
           else
              ACN(CT:2, FBN['Precio1'])         
           endif   
        endif
        IF EqStr(Val(ab:fac),'Titulos')
           *   ACN(CT:1, CotizacionC(fbn('Especie'),'CON',,,Val(FE:1),1,,fbn('ContraEspecie')))
           ACN(CT:1, SQL("Select 1 From "~DBO~".COTIZACIONES Where Codigo = '"~fbn('Especie')~"' AND Moneda = '"~fbn('ContraEspecie')~"' and CallPut = 'CON' AND Fecha = "~IdxDate2(val(FE:1))~" "))
           ACN(CT:2, SQL("Select Top(1) Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' AND Moneda = '"~fbn('ContraEspecie')~"' AND FechaFut = '"~IdxDate(fbn('FechaVto'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' AND Fecha < '"~IdxDate(Val(FE:1))~"' Order By Fecha Desc "))
        endif
        * Cotizacion Hoy
        ACN(ae:FAC, Val(ct:1))
        * Cotizacion Ayer
        ACN(af:FAC, Val(ct:2))
        IF Vacio(FBN['MonLiquida'])      
           acn(pr:1,1)
        else
        *           ACN(pr:1, SQL("Select Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~fbn('MonLiquida')~"' AND Moneda = '"~fbn('ContraEspecie')~"' and CallPut = 'CON' AND Fecha = "~IdxDate2(val(FE:1))~" "))
           ACN(pr:1, SQL("Select Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~fbn('Contraespecie2')~"' AND Moneda = '"~fbn('ContraEspecie')~"' and CallPut = 'CON' AND Fecha = "~IdxDate2(val(FE:1))~" "))
        endif
        * Cotizacion Anterior
        ACN(ag:FAC, Val(ct:2))
        * Diferencia Cotizacion (Hoy - anterior)
        ACN(ah:FAC, Val(ae:FAC)-Val(ag:FAC))
        * Resultado
        IF Incluido(fbn('TipoOp'), 'TICF|FXCF')
          ACN(ai:FAC, fbn('Cantidad') * Val(ah:FAC))
          ACN(aj:FAC, fbn('Cantidad') * Val(ah:FAC) / Val(pr:1))
        ELSE
          ACN(ai:FAC, -fbn('Cantidad') * Val(ah:FAC))
          ACN(aj:FAC, -fbn('Cantidad') * Val(ah:FAC) / Val(pr:1))
        ENDIF
        if Eqstr(FBN['Regulado'],'SI')
           ACN(aj:FAC, 0)
        endif
        if Dialogo.Check1=1
          SQL.ADD(" Insert Into "~DBO~".MTMDIARIO ")
          SQL.ADD(" (NrOperacion, Fecha, PrecioHoy, ")
          IF Val(NR:1)=1
             SQL.ADD(" Especie2, ")
          endif
          SQL.ADD(" PrecioAyer, MTM, TipoMTM, Especie1, MTMEspecie, FechaCargaSys) ")
          SQL.ADD(" Values ")
          SQL.ADD(" ('"~fbn('NrOperacion')~"', '"~IdxDate(Dialogo.Fecha1)~"', "~Fstr(Val(ae:FAC), 0, 8)~", ")
          IF Val(NR:1)=1
             SQL.ADD(" '"~FBN['Especie']~"', ")
          endif
          SQL.ADD(" "~Fstr(Val(ag:FAC), 0, 8)~", "~Fstr(Val(ai:FAC), 0, 2)~", 'FIX', '"~FBN['ContraEspecie']~"',"~Fstr(Val(aj:fac), 0, 2)~","~IdxDate2(FSys)~") ")
          SQL.ADD("  ")
          SQL.NEW
          SQL.ADD(" Update "~DBO~".OPERACIONES ")
          SQL.ADD(" Set TotalAux2 = TotalAux2 + "~Fstr(Val(ai:FAC), 0, 2)~", ")
          SQL.ADD("     TipoCambio3 = "~Fstr(Val(ae:FAC), 0, 8)~", ")
          SQL.ADD("     FechaVto2 = "~IdxDate2(Val(FE:1))~", ")
          SQL.ADD("     CB6 = 1 ")
          SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
          SQL.NEW
          *SQL.EXEC
          
          EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - Insert MTMDIARIO '~fbn('NrOperacion'))
          
          ACN(cu:1,1+SQL(" Select count(*) From "~DBO~".MTMDIARIO Where NrOperacion = '"~FBN('NrOperacion')~"' "))
          ACT(le:1,'Liquidacion FIX '~FBN['Especie'])
 
          IF NoVacio(FBN['TasaEspecie']) y Not Eqstr(FBN['ContraEspecie'],FBN['TasaEspecie'])
             ACT(es:1,FBN['TasaEspecie'])
             *             ACN(ca:1,Val(aj:fac)*-1)
             ACN(ca:1,Val(aj:fac))
             ACN(nr:1,2000)
          Else
             ACT(es:1,FBN['ContraEspecie'])
             *             ACN(ca:1,Val(ai:fac)*-1)
             ACN(ca:1,Val(ai:fac))
             ACN(nr:1,1000)      
          Endif
          If SQL(" Select 1 From "~DBO~".MOVPENDIENTES  Where "~IIF(Eqstr(Val(me:1), VAR('AMBROFEX'))," FechaMov = "~IdxDate2(Val(fe:3)),IIF(Eqstr(Val(me:1), VAR('AMBMAE'))," FechaMov = "~IdxDate2(Val(fe:2)), "FechaMov = "~IdxDate2(Dialogo.Fecha1)))~" AND NrOperacion = '"~FBN('NrOperacion')~"'  AND NrGrupo > 1000 ") = 1          
             SQL.ADD(" Update "~DBO~".MOVPENDIENTES            ")
** FJL 14/12/18 - Se cambia signo
*             SQL.ADD(" Set Cantidad = "~Fstr(Val(ca:1),0,2)~", Leyenda = '"~Val(le:1)~"' ")
             * PZ 7/6/2023 invierte signo para Rofex terceros
             if Eqstr(FBN('Cliente1'),FBN('Vehiculo1'))
                SQL.ADD(" Set Cantidad = "~Fstr(-Val(ca:1),0,2)~", ")
             else
                SQL.ADD(" Set Cantidad = "~Fstr(Val(ca:1),0,2)~", ")
             endif   
             SQL.ADD("     Leyenda = '"~Val(le:1)~"' ")
             SQL.ADD(" Where  NrOperacion = '"~FBN('NrOperacion')~"' ")
             if Eqstr(Val(me:1), VAR('AMBROFEX'))
                SQL.ADD("   And  FechaMov = "~IdxDate2(Val(fe:3))~" ")
             else             
                if Eqstr(Val(me:1), VAR('AMBMAE'))
                    SQL.ADD("   And  FechaMov = "~IdxDate2(Val(fe:2))~" ")
                else
                    SQL.ADD("   And  FechaMov = "~IdxDate2(Dialogo.Fecha1)~" ")
                endif
             endif
             SQL.NEW
             *SQL.EXEC
          Else                 
             SQL.ADD(" Insert into "~DBO~".MOVPENDIENTES ( ")
             SQL.ADD("  NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
             SQL.ADD("  Bits, NrSaldo, Cuenta, NrMov, ")
             SQL.ADD("  Book,  FechaMov, Cantidad, Leyenda, ")
             SQL.ADD("  NrGrupo, Concepto, ")     
             SQL.ADD("  NrGrupo2, Nrinstan ")   
             SQL.ADD(" ) values  ( ")
             SQL.ADD("  '"~FBN('NrOperacion')~"', ")
             SQL.ADD("  '"~Val(es:1)~"', ")
             SQL.ADD("  '"~FBN('Cliente1')~"', ")
             SQL.ADD("  '"~FBN('Mercado2')~"', ")
             SQL.ADD("  '"~FBN('Vehiculo1')~"', ")
             SQL.ADD("  'MV', ")
             SQL.ADD("  1, ")
             SQL.ADD("  '"~FBN('Cuenta4')~"', ")
             SQL.ADD("  "~Fstr(Val(nr:1)+Val(cu:1),1,0)~", ")
             SQL.ADD("  '"~FBN('Book1')~"',  ")             
             if Eqstr(Val(me:1), VAR('AMBROFEX'))
                SQL.ADD("  "~IdxDate2(Val(fe:3))~", ")
             else             
                if Eqstr(Val(me:1), VAR('AMBMAE'))
                    SQL.ADD("  "~IdxDate2(Val(fe:2))~", ")
                else
                    SQL.ADD("  "~IdxDate2(Dialogo.Fecha1)~", ")
                endif
             endif
             * Cantidad
** FJL 14/12/18 - Se cambia signo
*             SQL.ADD("  "~Fstr(Val(ca:1),0,2)~", ")
             * PZ 7/6/2023 invierte signo para Rofex terceros
             if Eqstr(FBN('Cliente1'),FBN('Vehiculo1'))
                SQL.ADD("  "~Fstr(-Val(ca:1),0,2)~", ")
             else
                SQL.ADD("  "~Fstr(Val(ca:1),0,2)~", ")
             endif   
             SQL.ADD("  '"~Val(le:1)~"', ")
             SQL.ADD("  0, ")
             SQL.ADD("  'FM', ")
             SQL.ADD("  "~Fstr(Val(nr:1)+Val(cu:1),1,0)~", ")
             SQL.ADD("  "~Fstr(0,0,0)~" ")
             SQL.ADD(" ) ")
             SQL.NEW
             *SQL.EXEC
          Endif
          
          EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - ActualizarMovimientos3 '~fbn('NrOperacion'))
          
          acn(h:&k,1)
        endif
      Proximo
      if Dialogo.Check1=1  y val(h:&k)=1
      IF SQL(" Select 1 From "~DBO~".MTM Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND Mercado = '"~Val(a:&k)~"' AND Producto = '"~Val(b:&k)~"' AND TipoMTM = 'FIX' AND Estado = 'ANU' ") = 1
          SQL.ADD(" Update "~DBO~".MTM ")
          SQL.ADD(" Set Estado = 'PRO', ")
          SQL.ADD(" FechaEstado = "~IdxDate2(FSys)~" ")
          SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD(" AND Mercado = '"~Val(a:&k)~"' ")
          SQL.ADD(" AND Producto = '"~Val(b:&k)~"' ")
          SQL.ADD(" AND TipoMTM = 'FIX' ")
          SQL.ADD(" AND Estado = 'ANU' ")
        ELSE
          SQL.ADD(" Insert Into "~DBO~".MTM ")
          SQL.ADD(" (Fecha, Mercado, Producto, Estado, TipoMTM, FechaEstado) ")
          SQL.ADD(" Values ")
          SQL.ADD(" ('"~IdxDate(Dialogo.Fecha1)~"', '"~Val(a:&k)~"', '"~Val(b:&k)~"', 'PRO', 'FIX', "~IdxDate2(FSys)~") ")
        ENDIF
        SQL.NEW
        SQL.EXEC

        EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - Actualiza MTM ')
        
      endif
    * Fin de OK Precios y fechas
    endif
  Proximo
endif

EscribirASCII(Fecha(Fsys,'DDMMYYYY')~' '~HORA(AHORA)~' '~'Corrida FIXFUT - Fin Fixing ')
CerrarASCII 

