MostrarCuadroDeMensajes
CrearDialogo
   NrUnicoAsiento1: 'Asiento'   ;;;;;;NoVacio(Dialogo.NrUnicoAsiento1) ;'Asiento Invalido';;
   Fecha1:  'F.Valor Original'  ;2;;;NO;;;;NO;;IIF(Vacio(Dialogo.NrUnicoAsiento1), Fsys, BuscarCampo('ASIENTOSCON','FechaValor','NrUnicoAsiento',Dialogo.NrUnicoAsiento1))
   Fecha2:  'F.Valor Nueva'     ;4;;;;;Dialogo.Fecha2 > 0 Y Dialogo.Fecha2 < Fsys ;'Fecha Invalida';NO; 
FinDialogo

If Not Ok
  Cancelar
Endif

ACN(BD:1, 1)
SQL.ADD(" Select  FechaGeneracion, FechaValor,NrUnicoAsiento,NrOperacion, Fecha2, Estado ")
SQL.ADD(" From  "~DBO~".ASIENTOSCON ")
SQL.ADD(" Where NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
SQL.ADD(" AND (Estado = 'E' OR Estado = 'COE' OR Estado = 'NCE' OR Estado = 'REE') ")
SQL.ADD(" order by NrUnicoAsiento ")
Recorrer SQL
  ACN(BD:1, 0)
  If Eqstr(fbn('Estado'), 'COE')
    ACT(A:FAC, 'COT')
  Else
    If Eqstr(fbn('Estado'), 'NCE')
      ACT(A:FAC, 'NC')
    Else
      ACT(A:FAC, 'REV')
    ENDIF
  ENDIF
  ***---Marco el asiento
  Message ('Operacion '~fbn('NrOperacion'))
  SQL.ADD(" Update "~DBO~".ASIENTOSCON ")
  If Eqstr(fbn('Estado'), 'E')
    SQL.ADD(" Set Estado = Null, ")
  Else
    SQL.ADD(" Set Estado = '"~Val(A:fAC)~"', ")       
  Endif
  SQL.ADD(" Fecha2 = Null, ")   
  SQL.ADD(" FechaValor = '"~IdxDate(Dialogo.Fecha2)~"' ") 
  SQL.ADD(" Where NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
  SQL.NEW
  SQL.EXEC
Proximo

IF Val(BD:1) = 0
  MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' esta disponible para Re-envio ')
ELSE
  MessageBox('El Asiento '~Dialogo.NrUnicoAsiento1~' no fue enviado previamente, No corresponde Proceso')
ENDIF