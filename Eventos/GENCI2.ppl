CrearDialogo
    NrTrans1: 'Transaccion'      ;;;;;;NoVacio(Dialogo.NrTrans1);;;;;;;;
    Book1:    'Book'             ;;;;;;NoVacio(Dialogo.Book1);;;;;;;;
    String1:  'Leyenda'          ;;;;;;NoVacio(Dialogo.String1);;;;;;;;
FinDialogo

If No ok
 Cancelar
Endif


**Valida si existe el directorio para crear el csv
If ExisteDirectorio(VAR('PATHCOMPIN'))
**Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATHCOMPIN'),Longitud(VAR('PATHCOMPIN')),1),'\')
   ACT(pl:1, VAR('PATHCOMPIN')~VAR('FILECOMING')~Pad0(FStr(Dia(FSYS),0,0),2)~Pad0(FStr(Mes(FSYS),0,0),2)~FStr(Anio(FSYS),0,0))
   Else
   ACT(pl:1, VAR('PATHCOMPIN')~'\'~VAR('FILECOMING')~Pad0(FStr(Dia(FSYS),0,0),2)~Pad0(FStr(Mes(FSYS),0,0),2)~FStr(Anio(FSYS),0,0))
   EndIf
Else
    Cancelar('El directorio '~VAR('PATHCOMPIN')~' no existe')
EndIf

**Si el nombre del archivo del comprobante es el mismo, le agrega una enumeración al final del nombre del archivo.
ACT(ig:1,Val(pl:1)~'.csv')

IF ExisteArchivo(Val(ig:1))
    Recorrer&I 1,9000
    ACT(ig:1,Val(pl:1)~'_'~Fstr(&I,10,0)~'.csv')
    IF Not ExisteArchivo(Val(ig:1))
            Break
        ENDIF
    Proximo 
ENDIF

AbrirAscii(Val(ig:1),0)

********BUSQUEDA DE CAMPOS***********
SQL.ADD("Select Cuenta2,Fecha2,Cantidad1,Especie,NrOperacionRef1 FROM "~DBO~".TRANSACCIONES2 Where NrTrans='"~Dialogo.NrTrans1~"'")
Recorrer SQL
    ACT(AA:1,fbn('Cuenta2'))
    ACD(A:4,fbn('Fecha2'))
    *IMPORTE
    ACN(A:5,fbn('Cantidad1'))
    ACT(AD:1,fbn('Especie'))
    *OPERACION
    ACT(A:9,fbn('NrOperacionRef1'))
Proximo



*ID BANCO
ACT(A:1,Query("Select CL.Alias3 FROM "~DBO~".CLIENTES CL JOIN "~DBO~".CUENTAS CU ON CL.Codigo=CU.Comitente Where CU.Codigo = '"~Val(AA:1)~"' "))
*N° CUENTA
ACT(A:2,BuscarCampo('CUENTAS','Numero','Codigo',Val(AA:1)))
ACT(A:2,Trim(Val(A:2)))
*ID REFERENCIA
ACT(A:3,Dialogo.NrTrans1)
*FECHA TRANSACCION
ACT(A:4,Fecha(Val(A:4),'dd-mm-yyyy'))

*DESCRIPCION (Leyenda de MOVEJECUTADOS)
ACT(A:6,'FPA '~Dialogo.String1)
*PLANTILLA CONTABLE (Especie_Book)
ACT(A:8,Copy(BuscarCampo('BOOKS','Alias1','Codigo',Dialogo.Book1),1,8))
ACT(A:7,Val(AD:1)~'_'~Val(A:8))
**OPERADOR DE LA OPERACION
ACT(A:10,BuscarCampo('OPERACIONES','Operador','NrOperacion',Val(A:9)))

******Genera el csv con los datos*********
EscribirASCII(Val(A:1)~';'~Val(A:2)~';'~Val(A:3)~';'~Val(A:4)~';'~Val(A:5)~';'~Val(A:6)~';'~Val(A:7)~';'~Val(A:10))
CerrarASCII