CrearDialogo
  Especie3 : 'Especie'      ;1;;;  ;;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3,'TITULO') y EsTerminal(Dialogo.Especie3,Especie);'Debe Ingresar un Especie Valida';NO;;;;;;"Status = 'HAB' "
** FJL 01/03/23 - Por Issue EXTBACS 8129 - No se permite cancelacion parcial
*  Mercado1 : 'Casa_Custodia';1;2;;;; 
  Mercado1 : 'Casa_Custodia';1;2;;NO;NO; 
  Especie1 : 'Cupon'        ;2;1;;NO;;NoVacio(Dialogo.Especie1) y EsTerminal(Dialogo.Especie1,Especie);'Debe Ingresar un Especie que sea Cupon';NO;BuscarCampo('ESPECIES','Alias9', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES','Alias9', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB' "
  Entero1  : 'Nr.Cupon'     ;3;;;NO;;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;0;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
  Fecha1   : 'F.Corte'      ;4;;;NO;;;;;SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ");SQL(" SELECT FechaCorte FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie3~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
  Label1   : ''             ;1;;;NO;NO;;;;;'Cancela Actualizacion de Especies'
  Check1   : ''             ;1;2;;NO;NO;;;;0
  Radio1     : "Tipo Cliente|"~Var('LABEL')~"|Caja|Todos" ;1;1;;NO;NO;;;;2;
  ListaTabla1: 'Clientes'   ;6;1;;;;;;;;;;;;IIF(Dialogo.Radio1<>2," "~IIF(Dialogo.Radio1=0," TipoCliente='"~VAR('CLISUD')~"' or TipoCliente Is Null"," TipoCliente='"~VAR('CLICAJA')~"' "),"1=1" );'Codigo' ; 'Codigo;RazonSocial' ; 'VCLIENTES01'
FinDialogo

If Not OK 
   Cancelar
EndIf

SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie2,T2.Cupon1,T2.Fecha1,  ")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,T2.Cambio1,T2.Cambio2,M.*,  ")
SQL.Add("       C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal,     ")
SQL.Add("       C.CUIT, C.CondicionIVA, C.TipoInscripcion, C.Sucursal, T2.Especie5 ")
SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M ")
SQL.ADD(" WHERE T2.Especie    = '"~Dialogo.Especie3~"'           ")
SQL.ADD(" AND   T2.Cupon1     = '"~FSTR(Dialogo.Entero1,1,0)~"'  ")
SQL.Add(" AND   T2.TipoTr2    = 'CUPON'                          ")
SQL.Add(" AND   M.NrOperacion = T2.NrTrans                       ")
SQL.Add(" AND   M.Cliente     = C.Codigo                         ")
SQL.Add(" AND   M.Especie     = T2.Especie2                      ")
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD(" AND M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD(" AND M.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
SQL.Add("UNION ALL ")
SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie2,T2.Cupon1,T2.Fecha1,  ")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,T2.Cambio1,T2.Cambio2,M.*, ")
SQL.Add("       C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal,    ")
SQL.Add("       C.CUIT, C.CondicionIVA, C.TipoInscripcion, C.Sucursal, T2.Especie5 ")
SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T2.Especie    = '"~Dialogo.Especie3~"'          ")
SQL.ADD(" AND   T2.Cupon1     = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
SQL.Add(" AND   T2.TipoTr2    = 'CUPON'                         ")
SQL.Add(" AND   M.NrOperacion = T2.NrTrans                      ")
SQL.Add(" AND   M.Cliente     = C.Codigo                        ")
SQL.Add(" AND   M.Especie     = T2.Especie2                     ")
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD(" AND M.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif
If NoVacio(Dialogo.Mercado1) 
   SQL.ADD(" AND M.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
SQL.Add(" ORDER BY T2.NrTrans,M.Cliente, M.Concepto, M.NrSaldo ")

ACN(z:1,0)

Recorrer SQL
  SCN(z:1,1)
  ACT(at1,'')
  If val(z1)=1 
     ACT(at1,SQL("SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 WHERE TipoTr2 IN ('LCUPON') AND Especie='"~fbn('Especie2')~"' AND Cupon1='"~FSTR(Dialogo.Entero1,1,0)~"' " ) )
     If NoVacio(val(at1))
        If NoVacio(Dialogo.ListaTabla1)        
           ACN(at2,SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~Val(at1)~"' AND Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") " ) )
           If val(at2)=1
              Cancelar('Ejecute Previamente la CANCELACION COBRO/PAGO de Cupones de la Especie '~fbn('Especie')~' y Cupon '~FSTR(Dialogo.Entero1,1,0))
           EndIf
        Else
           Cancelar('Ejecute Previamente la CANCELACION COBRO/PAGO de Cupones de la Especie '~fbn('Especie')~' y Cupon '~FSTR(Dialogo.Entero1,1,0))
        EndIf
     EndIf
  EndIf

  If Not EqStr(fbn('NrTrans'),val(z10))
     ACT(z10,fbn('NrTrans'))
     ACT(z2,fbn('NrTrans')~'|'~val(z2))
  EndIf

  ACD(b:fac, fbn('Fecha1'))
  ACT(c:fac, fbn('Cliente'))
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('Cupon1'))
  ACN(g:fac, fbn('Cantidad'))
  ACN(h:fac, fbn('Precio1'))
  ACN(i:fac, fbn('Precio2'))
  ACN(j:fac, fbn('Precio3'))
  ACN(k:fac, fbn('Cambio1'))
  ACN(l:fac, fbn('Cambio2'))
  ACT(m:fac, fbn('NrTrans'))
  ACT(VH:fac, fbn('Vehiculo1'))
  ACT(MP:fac, fbn('Especie5'))
  ACT(mc:fac, fbn('Mercado'))
  ACN(a:fac, 1)
  FormatoCeldas(a:fac..l:fac,EXE('F9'))
Proximo

IF Val(z:1)=0
   Cancelar('No hay transacciones de Corte de Cupon para la Especie y Cupon solicitados')
ENDIF

CrearListBox ; 'Arial,8,'
** FJL 01/03/23 - Por Issue EXTBACS 8129 - No se permite cancelacion parcial
*   'Cancela'          ;a1..a:fac;SI;;;40;CHECK
   'Cancela'          ;a1..a:fac;NO;;;40;CHECK
   'F.Corte'          ;b1..b:FAC;NO;;;70;STRING
   'Cliente'          ;c1..c:FAC;NO;;;70;STRING
   'Especie'          ;d1..d:FAC;NO;;;60;STRING
   'Cupon Ant.'       ;e1..e:FAC;NO;;;50;STRING
   'Cantidad'         ;g1..g:FAC;NO;;;80;NUMERO;'##,###,###.##'
   '%Renta'           ;h1..h:FAC;NO;;;80;NUMERO;'###.########'
   '%Amortizacion'    ;i1..i:FAC;NO;;;80;NUMERO;'###.########'
   '%Int.Capit.'      ;j1..j:FAC;NO;;;80;NUMERO;'###.########'
   '%V.Teorico Ant.'  ;k1..k:FAC;NO;;;80;NUMERO;'###.########'
   '%V.Teorico Act.'  ;l1..l:FAC;NO;;;80;NUMERO;'###.########'
FinListBox

IF NOT OK 
   Cancelar
ENDIF

ACT(MN:1, Descendientes('ESPECIES','MONEDA'))

Recorrer&i 1,fac

   IF Val(a:&i)=1
      ***---Verifico que no se hayan liquidado movimientos moneda de operaciones futuras que 
      ***---se hayan generado por la tr. CUPON
      ACN(MN:2, 0)
      ACN(MN:2, SQL(" Select 1 From "~DBO~".MOVEJECUTADOS Where Vehiculo = '"~Val(M:&i)~"' AND Especie IN ("~Pipe2Comillas(Val(MN:1))~") "))

      IF Val(MN:2) = 1
          MessageBox('La Tr. CUPON '~Val(M:&i)~' tiene movimientos moneda liquidados asociados a operaciones futuras')
          Break
      ENDIF

      ***---Borro los movimientos moneda del cliente asociados a las operaciones futuras 
      ***---que se liquidan junto con la operacion
      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE Vehiculo = '"~Val(m:&i)~"' and Especie IN ("~Pipe2Comillas(Val(MN:1))~") ")
      SQL.NEW

      SQL.ADD(" DELETE FROM "~DBO~".MOVEJECUTADOS  WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Sector='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Sector='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".SALDOSDIA WHERE Especie='"~Dialogo.Especie3~"'  and Cupon='"~FSTR(Dialogo.Entero1+1,1,0)~"' and Saldo=0 and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".SALDOS WHERE Especie='"~Dialogo.Especie3~"'  and Cupon='"~FSTR(Dialogo.Entero1+1,1,0)~"' and Saldo=0 and Cliente='"~Val(c:&i)~"' ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".SALDOSDIA WHERE Especie='"~Dialogo.Especie1~"'  and Cupon='"~FSTR(Dialogo.Entero1,1,0)~"' and Saldo=0 and Cliente='"~Val(c:&i)~"'  ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".SALDOS WHERE Especie='"~Dialogo.Especie1~"'  and Cupon='"~FSTR(Dialogo.Entero1,1,0)~"' and Saldo=0 and Cliente='"~Val(c:&i)~"'  ")
      If NOVACIO(Dialogo.Mercado1)
         SQL.ADD(" and Mercado='"~Val(mc:&i)~"' ")
      Endif
      SQL.NEW

      ***---Movimientos Posicion Moneda por el Pago/Cobro
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(VH:&i)~"' AND NrSaldo IN (31,51) ")
      SQL.NEW
      SQL.ADD(" DELETE FROM "~DBO~".MOVPOSPEN WHERE NrOperacion = '"~Val(m:&i)~"' and Cliente='"~Val(VH:&i)~"' AND NrSaldo IN (31,51) ")
      SQL.NEW

      SQL.ADD(" Select NrTrans From "~DBO~".TRANSACCIONES2 Where NrOperacionRef3 = '"~Val(M:&i)~"' ")
      Recorrer SQL
*          MESSAGEBOX(fbn('NrTrans'))

          SQL.ADD(" Update "~DBO~".TRANSACCIONES2 ")
          SQL.ADD(" Set NrOperacionRef3 = Null ")
          SQL.ADD(" Where NrTrans = '"~fbn('NrTrans')~"' ")
          SQL.NEW
          SQL.EXEC
          SQL.ActualizarMovimientosT2(fbn('NrTrans'),SI,NO,NO,SI)
          SQL.EXEC
      Proximo

* FJL 25/5/18 - Revisado por diferimientos
      ***---Obtengo NrOperacion de operaciones futuras para volver para atras el cupon y la Tr CUPON
      SQL.ADD(" Select Distinct M.NrOperacion  From "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
      SQL.ADD(" Where M.NrOperacion = O.NrOperacion ")
      SQL.ADD(" AND   M.Book    = '"~Val(m:&i)~"'   ")
      SQL.ADD(" AND   M.Especie = '"~Dialogo.Especie3~"' ")
      If NoVacio(Dialogo.Mercado1)
         If Eqstr(Val(mc:&i), VAR('CLHODEFA'))
         SQL.ADD(" AND   (O.Mercado = '"~Val(mc:&i)~"' OR  O.Mercado in( "~Pipe2Comillas(VAR('MERCAACMC'))~")) ")
         Else
            SQL.ADD(" AND   O.Mercado = '"~Val(mc:&i)~"' ")
         Endif
      Endif
      SQL.ADD("  and M.Cliente = '"~Val(c:&i)~"' ")
*MESSAGEBOX('Cliente '~Val(c:&i)~' cupon '~Val(m:&i))
*If Eqstr(val(c:&i),'RIO')
*      SQL.ADD("DDD ") 
*Endif
      * --------------------------- *


      Recorrer SQL

** FJL 28/07/23 - Pierde la referencia de fbn('NrOperacion') y no como no existen COMISIONES2 se saca este parte
IF NO
            ACN(nc1,SQL(" SELECT Max(NrComision) AS NrComision FROM "~DBO~".COMISIONES2 where NrOperacion = '"~fbn('NrOperacion')~"'     "))
            ACN(nc10,0)

            SQL.ADD("SELECT CO.*, O.DiasAnio, O.Cantidad, O.Precio1, O.FechaVto  FROM "~DBO~".COMISIONES2 CO, "~DBO~".OPERACIONES O   ")
            SQL.ADD(" WHERE CO.NrOperacion = '"~fbn('NrOperacion')~"'        ")
            SQL.ADD("   and O.NrOperacion = '"~fbn('NrOperacion')~"'         ")
            SQL.ADD("   and CO.NrComision <> '"~Fstr(Val(nc1),0,0)~"'        ")
            SQL.ADD(" Order by CO.NrComision                                 ")
            Recorrer SQL                            
                IF Eqstr(fbn['NrComision'],Fstr(Val(nc1)-1,0,0) )           
                   scn(nc10,fbn['Cantidad']*(FBN['FechaVto']-FBN['Fecha1'])*FBN['Precio1']*FBN['Importe1']  / IIF(FBN['DiasAnio']=0,36000,36500) )
                   acd(nc2,FBN['FechaVto'] )
                else
                   scn(nc10,fbn['Cantidad']*(FBN['Fecha2']-FBN['Fecha1'])*FBN['Precio1']*FBN['Importe1']  / IIF(FBN['DiasAnio']=0,36000,36500) )
                Endif  
            Proximo

            SQL.ADD(" DELETE "~DBO~".COMISIONES2                    ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"'  ")
            SQL.ADD(" and   NrComision  = '"~Fstr(Val(nc1),0,0)~"'  ")
            SQL.NEW

            SQL.ADD(" Update "~DBO~".COMISIONES2                     ")
            SQL.ADD(" Set Fecha2 = '"~IdxDate(Val(nc2))~"'           ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"'   ")
            SQL.ADD(" and   NrComision  = '"~Fstr(Val(nc1)-1,0,0)~"' ")
            SQL.NEW
ENDIF
            
            SQL.ADD(" Update "~DBO~".OPERACIONES ")
            SQL.ADD(" Set Cupon1 = '"~Fstr(Dialogo.Entero1,1,0)~"', ")
*            SQL.ADD(" TotalIntereses = "~Fstr(Val(nc10),0,2)~",     ")
*            SQL.ADD(" Cuotas2 = "~Fstr(Val(nc1)-1, 0, 0)~",         ")
            SQL.ADD(" NrOperacion2 = Null ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.NEW
*messagebox('aca va a borrar cuotas')
            * FO 19/10/2005 AGREGO ESTO PARA QUE ANULE LOS MOV DEL CORTE EN LOS PASES VIGENTES *
            SQL.ADD(" DELETE FROM "~DBO~".MOVPENDIENTES  WHERE Book = '"~Val(m:&i)~"' and NrOperacion='"~fbn('NrOperacion')~"' AND Especie <> '"~Dialogo.Especie3~"' ")
            SQL.NEW
            SQL.ADD(" DELETE FROM "~DBO~".CUOTAS  WHERE Vehiculo2 = '"~Val(m:&i)~"' and NrOperacion='"~fbn('NrOperacion')~"'  ")
            SQL.NEW
            * -------------------------------------------------------------------------------- *
      Proximo
      SQL.EXEC

      *- Pases, Prestamos y Depositos de titulos 
      SQL.ADD(" Update "~DBO~".MOVPENDIENTES SET ")
      SQL.ADD(" Cupon = '"~FSTR(Dialogo.Entero1,1,0)~"', ")
      SQL.ADD(" Book  = Null   ")
      SQL.ADD(" WHERE Book  = '"~Val(m:&i)~"' ")
      SQL.ADD(" AND Especie = '"~Dialogo.Especie3~"' ")
      If NoVacio(Dialogo.Mercado1)
         If Eqstr(Val(mc:&i), VAR('CLHODEFA'))
         SQL.ADD(" AND   (Mercado = '"~Val(mc:&i)~"' OR  Mercado in ("~Pipe2Comillas(VAR('MERCAACMC'))~")) ")
         Else
            SQL.ADD(" AND   Mercado = '"~Val(mc:&i)~"' ")
         Endif
      Endif
      SQL.ADD("  and Cliente = '"~Val(c:&i)~"' ")
      SQL.NEW
      SQL.EXEC
   ENDIF
Proximo

IF Dialogo.Check1=1
   SQL.ADD("UPDATE "~DBO~".ESPECIES ")
   SQL.ADD("SET Cupon = "~Val(e:1)~", VTeorico = "~Val(k:1)~", ")
   SQL.ADD("    Valor4 = 0, Valor5 = 0, Valor6 = 0 ")
   SQL.ADD("WHERE Codigo = '"~Val(d:1)~"' ")
   SQL.NEW
   message(' Actualizando Especie ')

   *----------- Modifico LA ESPECIE CUPON -------------*
   SQL.ADD("UPDATE "~DBO~".ESPECIES ")
   SQL.ADD("SET Cupon = "~FSTR(Num(Val(e:1))-1,1,0)~", ")
   SQL.ADD("    Valor1 = 0, Valor2 = 0, Valor3 = 0, ")
   SQL.ADD("    FechaCorteCupon = NULL, ")
   SQL.ADD("    FechaPagoCupon = NULL, ")
   SQL.ADD("    VTeorico = 1 ")
   SQL.ADD("WHERE  Codigo = '"~Dialogo.Especie1~"' ")
   SQL.NEW
   message(' Actualizando Especie Cupon ')

   *---------- Actualiza Tabla AgendaCupon ------------*
   SQL.ADD(" UPDATE "~DBO~".AGENDACUPONES SET ")
   SQL.ADD(" FechaProceso    =  NULL, ")
   SQL.ADD(" Estado          = 'PEN' ")
   SQL.ADD(" WHERE Especie = '"~Val(d:1)~"' AND NrCupon = '"~Val(e:1)~"' ")
   SQL.NEW
   message(' Actualizando Agenda de Cupones ')
   SQL.EXEC
ENDIF

ACN(z3,Elementos(val(z2)) )

Recorrer&j 1,val(z3)
   ACT(z4,ItemLista(val(z2),&j))

   ACN(cu1,0)
   *- Verifico si la transaccion se quedo con movimientos antes de borrar
   SQL.ADD(" Select Count(*) as Cuantos FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion = '"~Val(z4)~"'")
   Recorrer SQL
     dfa
     ACN(cu1,FBN('Cuantos'))
   Proximo

   If val(cu1)=0
      SQL.ADD(" DELETE FROM "~DBO~".TRANSACCIONES2 WHERE NrTrans = '"~Val(z4)~"'")
      SQL.NEW
      Message('Transaccion '~Val(Z:4)~' eliminada.')
   EndIf
   SQL.EXEC
Proximo
