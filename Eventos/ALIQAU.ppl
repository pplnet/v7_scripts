MostrarCuadroDeMensajes
*HOJAVISIBLE(SI)
CrearDialogo
  Fecha1    : 'Fecha:'         ;;;;  ;  ;NoVacio(Dialogo.Fecha1);'Fecha Invalida';NO;Fsys
FinDialogo
if Not OK
  Cancelar
endif

SetFilaActual(0)
ACT(ME:1, Var('MERCOCT'))

***---Se anulan los vouchers del dia con Mercado=OCT, que no esten fallados o confirmados ****
SQL.ADD(" Select NrTrans ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T1 ")
SQL.ADD(" Where T1.Fecha1   = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   AND T1.TipoTr2 In ('FXDEP','FXRET') ")
SQL.ADD("   AND T1.CB10     = '1' ")
SQL.ADD("   AND T1.Mercado1 = '"~val(me:1)~"' ")
SQL.ADD("   AND (T1.CB3 = '0' or T1.CB3 is Null) ")
SQL.ADD("   AND (T1.CB9 = '0' or T1.CB9 is Null) ")
SQL.ADD(" Order By NrTrans ")

Recorrer SQL
  MESSAGE(fbn('NrTrans'))
  *** anula el voucher ***
  EjecutarEvento('ANUVO5', NrTrans1=fbn('NrTrans'))
Proximo
