CrearDialogo
  Especie1 : 'Cupon'        ;2;1;;NO;;NoVacio(Dialogo.Especie1) y EsTerminal(Dialogo.Especie1,Especie);'Debe Ingresar un Especie';NO;;;;;;"Status = 'HAB' "
  Entero1  : 'Nr.Cupon'     ;3; ;;NO;;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;0;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
  Fecha1   : 'F.Corte'      ;4; ;;NO;;;;;SQL(" SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ");SQL(" SELECT FechaCorte FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FSTR(Dialogo.Entero1,1,0)~"' ")
  NrTrans1 : 'Tr.Cupon'     ; ; ;;
  Check1   : 'Procesa'      ;1;2;;NO;SI;;;;0
FinDialogo
If Not OK 
   Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

SQL.ADD("Select * from "~DBO~".MOVPENDIENTES ")
SQL.ADD(" Where Book = '"~Dialogo.NrTrans1~"' ")
SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"' ")
recorrer SQL
  ACT(c:FAC, BuscarCampo('Especie','MonedaEmision','Codigo',Dialogo.Especie1))
  ACT(d:FAC, BuscarCampo('Especie','Cotiza','Codigo',Dialogo.Especie1))
  ACN(e:FAC, fbn('Cantidad')*COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,Val(d:FAC)))
  IF Dialogo.Check1=1 y NO  
    SQL.ADD(" Update "~DBO~".MOVPENDIENTES ")
    SQL.ADD(" Set Especie  = '"~Val(c:FAC)~"', ")
    SQL.ADD("     Cantidad = '"~FStr(Val(e:FAC),1,2)~"' ")
    SQL.ADD(" Where Book = '"~Dialogo.NrTrans1~"' ")
    SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"' ")
    SQL.NEW
    SQL.EXEC
    endif
proximo

