CrearDialogo
   NrOperacion1 : 'Operacion' ;;;;;;NoVacio(Dialogo.NrOperacion1);'Operacion Incorrecta';NO;;;;;;
   Cantidad1     : 'Instancia';;;;;;NoVacio(Dialogo.Cantidad1);'Instancia no informada';NO;;
FinDialogo

If Not Ok
   Cancelar 
EndIf

SQL.ADD("SELECT Tipo, Autorizado FROM "~DBO~".EXCEPCIONES")
SQL.ADD(" Where NrOperacion='"~Dialogo.NrOperacion1~"' ")

if Dialogo.Cantidad1= 19
    SQL.ADD(" AND Tipo in ('TASATMOD','RANGOTRANS')")
else
    if Dialogo.Cantidad1= 8
        SQL.ADD(" AND Tipo in ('FVALOR')")
    else
        if Dialogo.Cantidad1= 2
        SQL.ADD(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
        else
            if Dialogo.Cantidad1= 3
                SQL.ADD(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
            endif
        endif
    endif
endif

Recorrer SQL
    SQL.ADD("Update "~DBO~".EXCEPCIONES ")
    SQL.ADD("   Set Autorizado = '"~USUARIOACTIVO~"' ")
    SQL.ADD(" Where NrOperacion='"~Dialogo.NrOperacion1~"' ")
    if Dialogo.Cantidad1= 19
        SQL.ADD(" AND Tipo in ('TASATMOD','RANGOTRANS')")
    else
        if Dialogo.Cantidad1= 8
            SQL.ADD(" AND Tipo in ('FVALOR')")
        else
            if Dialogo.Cantidad1= 2
            SQL.ADD(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
            else
                if Dialogo.Cantidad1= 3
                    SQL.ADD(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
                endif
            endif
        endif
    endif
         
    SQL.ADD("   and Autorizado is Null ")
    SQL.NEW
Proximo

SQL.EXEC



* ---------------------- SOLO PARA CUENTAS REMUNERADAS

ACN(A:1,SQL("Select 1 from "~DBO~".OPERACIONES Where NrOperacion ='"~Dialogo.NrOperacion1~"' and TipoOp = 'MMCREM'"))

if VAL(A:1) = 1
    SQL.ADD("SELECT  E.Tipo, E.Autorizado, E.NrOperacion, O.NrOperacion3 FROM EXCEPCIONES E, OPERACIONES O ")
    SQL.ADD(" Where  E.NrOperacion = O.NrOperacion ")
    SQL.ADD("   AND O.NrOperacion3 ='"~Dialogo.NrOperacion1~"'")
    SQL.ADD("   AND E.NrOperacion <> O.NrOperacion3")
    if Dialogo.Cantidad1= 19
        SQL.ADD(" AND Tipo in ('TASATMOD','RANGOTRANS')")
    else
        if Dialogo.Cantidad1= 8
            SQL.ADD(" AND Tipo in ('FVALOR')")
        else
            if Dialogo.Cantidad1= 2
            SQL.ADD(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
            else
                if Dialogo.Cantidad1= 3
                    SQL.ADD(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
                endif
            endif
        endif
     endif
    Recorrer SQL
        SQL.ADD("Update "~DBO~".EXCEPCIONES ")
        SQL.ADD("   Set Autorizado = '"~USUARIOACTIVO~"' ")
        SQL.ADD(" Where NrOperacion='"~FBN['NrOperacion']~"' ")
        if Dialogo.Cantidad1= 19
            SQL.ADD(" AND Tipo in ('TASATMOD','RANGOTRANS')")
        else    
            if Dialogo.Cantidad1= 8
                SQL.ADD(" AND Tipo in ('FVALOR')")
            else
                if Dialogo.Cantidad1= 2
                SQL.ADD(" AND Tipo in ('RANGOTASA','RANGOPRECIO','SPREADNEG')")
                else
                    if Dialogo.Cantidad1= 3
                        SQL.ADD(" AND Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ")
                    endif
                endif
            endif
        endif
         
        SQL.ADD("   and Autorizado is Null ")
        SQL.NEW
        
    Proximo
endif
SQL.EXEC

