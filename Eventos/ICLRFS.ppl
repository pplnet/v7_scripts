CrearDialogo
  Fecha1      : 'Fecha'       ;;;;NO;;;;;;FSYS
  NrOperacion1: 'CONU'        ;;;;;;;;;;;;;;"TipoOp In ('CONU') and  MB2 = '0' and  FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' and (FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'  or CB1=1) "  
FinDialogo

if not ok
  Cancelar
endif

SQL.ADD(" Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, CB1, Spread,FechaVto, ")
SQL.ADD("  (Select "~DBO~".SaldoCONU(O.NrOperacion,'"~IdxDate(Dialogo.Fecha1)~"',1)) as Monto,(Select "~DBO~".SaldoCONU(O.NrOperacion,'"~IdxDate(Dialogo.Fecha1)~"',2)) as Utilizado ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB")
SQL.ADD(" Where MB2=0 and TipoOp In ('CONU') and FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' and (FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'  or CB1=1) ")
SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif
watch(SQL.Batch)

 recorrer SQL
 
    acn(a:fac,1)
    act(b:fac,FBN['NrOperacion'])
    act(c:fac,FBN['Cliente1'])
    act(d:fac,FBN['Especie'])
    acn(e:fac,FBN['Cantidad'])
    act(f:fac,FBN['FechaOp'])
    If FBN['CB1'] = 1
       act(g:fac,'')    
    Else
        act(g:fac,FBN['FechaVto'])
    Endif
    act(h:fac,FBN['Book1'])
    acn(i:fac,FBN['Monto'])
    acn(j:fac,FBN['Utilizado'])
    acn(k:fac,FBN['Spread'])
    acn(l:fac,FBN['Spread'])
    scn(ca:1,1)
Proximo

If Val(ca:1)>0 
   **- Armo la lista de las transacciones que puede seleccionar
   CrearListBox ; 'Arial,8,';'Actualizacion Spread ICL - CONU'
       'Accion ?'              ;a:1..a:Fac   ;SI;;;60;COMBO;'Ok|Rechaza'       
       'Operacion'             ;b:1..b:Fac   ;NO;;;70 ;STRING;;
       'Cliente'               ;c:1..c:Fac   ;NO;;;70 ;STRING;;
       'Especie'               ;d:1..d:Fac   ;NO;;;70 ;STRING;;
       'Monto Original'        ;e:1..e:Fac   ;NO;;;100 ;NUMERO;'##,###,###,###.##';
       'Fecha Op'              ;f:1..f:Fac   ;NO;;;80 ;STRING;;
       'Fecha Vto'             ;g:1..g:Fac   ;NO;;;80 ;STRING;
       'Book'                  ;h:1..h:Fac   ;NO;;;60 ;STRING;
       'Saldo Capital'         ;i:1..i:Fac   ;NO;;;100 ;NUMERO;'##,###,###,###.##';       
       'Imp. utilizado'        ;j:1..j:Fac   ;NO;;;100 ;NUMERO;'##,###,###,###.##';              
       'Spread Actual'         ;k:1..k:Fac   ;NO;;;100 ;NUMERO;'#,###.########';              
       'Nuevo Spread'          ;l:1..l:Fac   ;Val(a:FLB)=0;;;100 ;NUMERO;'#,###.########';RGB(175,200,228)
    FinListBox

    IF NOT OK 
       Cancelar
    ENDIF

   If Ok
   **- Recorro las filas para ver cual esta seleccionada, actualizo CONU
      Recorrer&i 1, FAC
            If Val(a:&i) = 0
               Message('Actualizando Spread'~val(b:&i))
               SQL.ADD(" Update "~DBO~".OPERACIONES ")
               SQL.ADD(" Set Spread = "~Fstr(val(l:&i), 0, 8)~" ")
               SQL.ADD(" Where NrOperacion = '"~val(b:&i)~"' ")
               SQL.NEW
               SQL.EXEC
            Endif
      Proximo
   Endif
Else
  if NoVacio(Dialogo.NrOperacion1)
     Messagebox('La Operacion '~Dialogo.NrOperacion1~' no puede ser actualizada , Spread variable por tabla - CONU Vencida')
  Else
     Messagebox('No se encontraron operaciones para Actualizar Spread')
  Endif
Endif
