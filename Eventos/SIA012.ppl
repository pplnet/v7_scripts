MostrarCuadroDeMensajes

SQL.ADD(" Select  /*+ RULE */ T.NrTrans ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where T.NrTrans = B.NrOperacion ")
SQL.ADD(" and (t.cb3 is null or t.cb3 = '0') ")
SQL.ADD(" and (t.cb2 is null or t.cb2 = '0') ")
SQL.ADD(" and (t.cb4 is null or t.cb4 = '0') ")
SQL.ADD(" AND B.NrBit < 11 ")
SQL.ADD(" AND B.Valor = '1' ")
*SQL.ADD(" AND T.FechaCargaSys < '"~IdxDate(FSys)~"' ")
SQL.ADD(" and t.nroperacionref1 is not null ")


Recorrer SQL
        ***--- La paso a Conciliar
        Message(fbn('NrTrans'))

        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '0' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.ADD(" AND NrBit < 11 ")
        SQL.ADD(" AND Valor = '1' ")
        SQL.NEW

        SQL.ADD(" Update "~DBO~".OPERACIONESBITS ")
        SQL.ADD(" Set Valor = '1' ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrTrans')~"' ")
        SQL.ADD(" AND NrBit = 20 ")
        SQL.NEW

        SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
        SQL.ADD("( NrOperacion, NrInstancia, Usuario, Mensaje, Fecha ) ")
        SQL.ADD(" Values ")
        SQL.ADD("( '"~Copy(fbn('NrTrans'), 1, 8)~"', 20, '"~UsuarioActivo~"',  ")
        SQL.ADD("  'SIA012', ")
        SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
        SQL.NEW
        SQL.EXEC
Proximo

        SQL.ADD(" Update "~DBO~".TRANSACCIONES2 T ")
        SQL.ADD(" Set t.cb3='1'  ")
        SQL.ADD(" Where t.Nrtrans in (select b.nroperacion from   ")
        SQL.ADD("    "~DBO~".OPERACIONESBITS B where b.NrBit = 18 AND b.Valor = '1') ")
        SQL.ADD(" AND t.fecha1 < '"~IdxDate(FSys)~"'   ")
        SQL.ADD(" AND t.cb3 = '0' ")
        SQL.NEW
        SQL.EXEC
