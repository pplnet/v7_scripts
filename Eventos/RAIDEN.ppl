** LA dll debe estar en el mismo directorio que el exe
require 'FPA.BOFA.COMMON.dll'
** Declaro la clase a utilizar en ppl
import ServiceFPA, 'FPA.BOFA.COMMON.Services.Default.ServiceFPA'
** Instancio la clase ServiceFPA
let &serv new ServiceFPA()
** Funciones Convert: STR() INT() DAT() DBL() BLN()
** let &resp &serv.SisExt_DealCancelResponse(STR(FBN('TipoOp')), INT(Dialogo.Entero1), DAT(Dialogo.Fecha1))
** Llamo al metodo y guardo el resultado en la variable &resp
let &resp &serv.SisExt_DealCancelResponse()
Watch(&resp)
if(Eqstr(&resp, 'OK'))
  MessageBox('Respuesta OK')
endif
***---------------------------------------------------
*** Ejemplo de un metodo que recibe como param. un objeto
import ParamsCreate, 'FPA.BOFA.COMMON.Services.Default.ParamsCreate'
let &params new ParamsCreate()
&params.NrOperacion = 'ASDASDASD'
&params.NrRaiden = 'ADSDSAD'
&params.Cantidad = 1000
let &resp &serv.SisExt_DealCreateResponse(&params)
Watch(&resp)




