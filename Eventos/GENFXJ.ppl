*** Lee de la tabla OPSIOPEL todo lo que esta sin procesar 
CrearDialogo
  Check1: 'Procesa';1;1; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif
ACT(v:5, VAR('AGESIOP'))
* xFXO
*ACT(w:2, VAR('CONTROLAPM'))
** FJL 18/07/19 - El mensaje por especie sancionada lo saca de la variable
*ACT(w:4, VAR('MSGSISEXT'))

ACT(s:1, 'x Secuencia2')
ACT(s:2, 'x TipoOp')
ACT(s:3, 'x Especie')
ACT(s:4, 'x ContraEsp')
ACT(s:5, 'x FechaOp')
ACT(s:6, 'x Puesto')
ACT(s:7, 'x ValorRB1')
ACT(s:8, 'x Feriados')
ACT(s:10, 'CodReg - 10')
ACT(s:12, 'MercadoRB')

ACT(s:13, 'x Precio')
ACT(s:14, 'x Cantidad MAE')
ACT(s:15, 'x Valorizacion')
ACT(s:16, 'x Cantidad')
ACT(s:17, 'x TBC1')

ACT(s:18, 'x Cuenta1')

ACT(s:20, ' - 20')
ACT(s:21, 'FormaLiq1')
ACT(s:22, 'x Mercado')
ACT(s:23, 'x Mercado2')
          
ACT(s:27, 'x Habiles Spot')
ACT(s:28, 'x Plazo MAE')
ACT(s:29, 'x FVto MAE')
ACT(s:30, 'x Spot/Fut MAE - 30')
ACT(s:31, 'x Cpra/Vta')
ACT(s:32, 'x Spot/Fut')
ACT(s:33, 'x Camb/Arb/Can')
          
ACT(s:34, 'x ClieMAE')
ACT(s:35, 'x ClieMAE(Num)')
ACT(s:36, 'x Cliente')
ACT(s:37, 'x Op.Contra')
ACT(s:38, 'x Nr.Oper')
ACT(s:39, 'x Operador')
ACT(s:40, 'Numerador - 40')
ACT(s:41, 'NrOperacion')
ACT(s:42, 'NrAltaMAE')
ACT(s:43, 'Rueda')
ACT(s:44, 'Mercado')
ACT(s:45, 'Vehiculo')
ACT(s:46, 'CodigoTitulo')
ACT(s:47, 'FechaAltaMAE')

ACT(s:51, 'z:1')
ACT(s:52, 'Controles')

ACT(s:53, 'Esp MAE')
ACT(s:54, 'Especie')
ACT(s:55, 'Mon MAE')
ACT(s:56, 'Moneda')

if Dialogo.Check1=0
  recorrer&i 1,56
    ACT(bz:&i, Val(s:&i))
  proximo
endif

SQL.ADD("Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoRegistro in ('0105','0205')  ")
SQL.ADD("    and CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGFXJ'))~") ")
SQL.ADD("    and Clase       in ("~Pipe2Comillas(Var('CLASEFXJ'))~") ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUEFXJ'))~") ")
SQL.ADD("    and Fecha       = '"~IdxDate(Fsys)~"'                      ")
SQL.ADD("    and Carga       is null                                    ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                            ")
*SQL.ADD("    and Secuencia2      = '22110812300800009' ")
*SQL.ADD("    and Secuencia2      = '22121611025500026' ")
watch(SQL.BATCH())
Recorrer SQL
  ACN(z:1, 0)
  ACT(a:FAC, fbn('Secuencia2'))
  ACT((26+FAC):1, fbn('Secuencia'))
  BorrarCeldas(t:1..t:95)
  BorrarCeldas(e:1..f:10)
  BorrarCeldas(es:1..es:2)
  BorrarCeldas(cl:1)

  if SI
    ***** Secuencia2
    ACT(t:1, fbn('Secuencia2'))
    * Secuencia (NrAltaMAE)
    act(t:42, fbn('Secuencia'))
    * CorRegistro
    act(t:10, fbn('CodigoRegistro'))
    * Rueda
    act(t:43, fbn('CodigoRueda'))
    * MeracdoNegociacion
    ACT(t:44, Var('AMBMAE'))
    * Vehiculo
    ACT(t:45, VAR('VEHICULODE'))
    * CodigoTitulo
    act(t:46, fbn('CodigoTitulo'))
    * FechaAltaMAE
    ACT(t:47, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))

    ** Compra / Venta
    if EqStr(fbn('CodigoRegistro'),'0105')
      * Venta
      ACN(t:31, 2)
    else
      if EqStr(fbn('CodigoRegistro'),'0205')
        * Compra
        ACN(t:31, 1)
      else
        SCN(z:1,1)
        message('Error en tipo de operacion')
        ACN((26+fac):31, 1)
      endif
    endif

    if EqStr(fbn('Agente'),Val(v:5))
      ***** ClienteMAE
      ACT(t:34, fbn('AgenteContra'))
      ***** Operador Contra
      ACT(t:37, fbn('OperadorContra'))
      ***** Nr Oper Propio
      ACT(t:38, fbn('Operador'))
    else
      if EqStr(fbn('AgenteContra'),Val(v:5))
        ***** ClienteMAE
        ACT(t:34, fbn('Agente'))
        ***** Operador Contra
        ACT(t:37, fbn('Operador'))
        ***** Nr Oper Propio
        ACT(t:38, fbn('OperadorContra'))
      else
        SCN(z:1,1)
        ACN((26+FAC):34, 1)
        Message('Cliente inexistente o error en Agente MAE')
      endif
    endif

    ***** Fecha Op
    if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05')
      ACD(t:5, Fecha(fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')))
      ACT(xx1, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
      ACT(xx2, Val(xx1)~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
      ACT(xx3, SQLFechaStr(Val(xx2),Exe('FORFECHOR')))
    else
      SCN(z:1,1)
      ACN((26+FAC):5, 1)
      Message('Error en FechaOp')
    endif

    ***** Plazo MAE
    ACN(t:28, Num(fbn('Plazo')))
    ***** FechaVto MAE
    ACD(t:29, Val(t:5)+Val(t:28))

    ***** MercadoRB
    ACN(t:12, 0)
** FJL 04/07/23 - En BACS tomo mal la tabla de Feriados 
** FJL 09/08/23 - En BACS tomo mal la fecha de Vto
    if Incluido(fbn('EnteLiquidador'),'a')
      ACN(t:12, 1)
    Endif
    ***** Tabla Feriados
    If Val(t:12)=0
      * Meracdo Local
      ACT(t:8,'ARG') 
    Endif
    If Val(t:12)=1
      * Meracdo Internacional
      ACT(t:8,'USA') 
    Endif
    If Vacio(Val(t:8))
      ACT(t:8,'ARG') 
    Endif
      
    ** Spot / Futuro MAE
    if Incluido(fbn('CodigoNego'), Var('TIPONEGFXJ') )
      * Spot
      ACN(t:30, 1)
    else
      SCN(z:1,1)
      ACN((26+FAC):30, 1)
      Message('No es spot ni futuro')
    endif

    ** Spot / Futuro
    if Val(t:30)=1
      * Spot MAE
      ACN(t:27, DifDias(Val(t:29),Val(t:5),Val(t:8),SI))
      if Val(t:27)>3
        ACN(t:32,2)
      else
        ACN(t:32,1)
      endif
    else
      if Val(t:30)=2
        * Futuro MAE
        ACN(t:32,2)
      else
        SCN(z:1,1)
        ACN((26+FAC):32, 1)
        Message('Error en spot/futuro')
      endif
    endif
      
    ** Clase
    if EqStr(fbn('Clase'),'J')
      * Canje
      ACN(t:33,2)
      If Val(t:31)=1
        * Compra (0205)
        acn(u:31, 2)
      Else
        * Venta (0105)
        acn(u:31, 1)
      Endif
    else
      SCN(z:1,1)
      ACN((26+FAC):33, 1)
      Message('Clase no es Canje')
    endif
      
    If Incluido(fbn('CodigoRueda'),Var('RUEFXJ'))
      ACT(t:2,'FXJ')
      * Numerador 35
      acn(t:40,35)
    Else
      SCN(z:1,1)
      ACN((26+FAC):40, 1)
      Message('Error en Numerador - No es rueda de FXJ')
    endif

    if Vacio(Val(t:2))
      SCN(z:1,1)
      ACN((26+FAC):2, 1)
      Message('Tipo de operacion desconocido')
    endif

    ***** Cliente
    ACN(t:35, Val(t:34))
    if Eqstr(Val(t:34),'000') o Vacio(Val(t:34)) o Eqstr(Val(t:34),Val(v:5))
      SCN(z:1,1)
      ACN((26+FAC):35, 1)
      Message('Error en Cliente '~Val(t:34))
    else
      ***** Codigo Cliente
      ACT(t:36, SQL("Select Codigo from "~DBO~".CLIENTES Where NrMAE = '"~Val(t:34)~"'  and Status='HAB' "))
    endif
    If Vacio(Val(t:36))
      ACN(cl:1,1)
      ACT(t:60, 'Cliente no existente en FPA. Nr MAE : '~Val(t:34))
    Endif

    ** Especie
    ** ContraEspecie
    ** Mnemotecnico 176-30-205
    if Val(t:33)=2
      * Canje
      act(t:53, fbn('CodigoTitulo'))
      if EqStr(fbn('CodigoTitulo'),'MEXT')
        ACT(t:54, 'USD')
      endif
      if EqStr(fbn('CodigoTitulo'),'EUROS')
        ACT(t:54, 'EURO')
      endif

      act(t:55, fbn('Moneda'))
      if EqStr(fbn('Moneda'),'D')
        ACT(t:56, 'USD')
      endif
      if EqStr(fbn('Moneda'),'E')
        ACT(t:56, 'EURB')
      endif
      
      if Val(t:31)=1
        * Compra (0205)
        ACT(t:3, Val(t:54))
        ACT(t:4, Val(t:56))
      endif
      if Val(t:31)=2
        * Venta (0105)
        ACT(t:3, Val(t:56))
        ACT(t:4, Val(t:54))
      endif
    endif

    if Vacio(Val(t:3))
      SCN(z:1,1)
      ACN((26+FAC):3, 1)
      Message('Error en especie')
    endif

    if Vacio(Val(t:4))
      SCN(z:1,1)
      ACN((26+FAC):4, 1)
      message('Error en contraespecie')
    endif
      
    *********************
    if Val(z:1)>0
      ACT(t:52, 'No paso el primer control')
    endif
    *********************
    
    if Val(z:1)=0
      **** Puesto
      if Val(t:32)=1
        * Spot
        if Incluido(fbn('CodigoRueda'), Var('RUEFXJ') ) 
          if Incluido(fbn('TipoLiquidacion'),'1') o SI
            ACN(t:6, 1)
          else
            ACN(t:6, 0)
          endif
        else
          if EqStr(Copy(fbn('Mnemotecnico'),9,1),'P')
            ACN(t:6, 1)
          else
            ACN(t:6, 0)
          endif
        endif 
      endif
      
      **** ValorRB1
      if Val(t:32)=1
        * Spot
        ACN(t:7, Val(t:28))
      endif

      if Vacio(Val(t:36))
        * Vacio Cliente
        ACT(t:36, 'SIOPEL')
        ACN((26+FAC):36, 1)
      endif
      
      *********************
      if Val(z:1)>0
        ACT(t:52, 'No paso el segundo control')
      endif
      *********************
    endif

    if Val(z:1)=0
      ***** Precio1
      ACN(t:13, fbn('Precio'))
      If Val(t:13)=0
        SCN(z:1, 1)
        ACN((26+FAC):13, 1)
      Endif
      ***** Cantidad
      ***** TotalBrutoCli1
      ACN(t:14, fbn('Cantidad'))
      ACN(t:15, fbn('Valorizacion'))
      if Val(t:31)=1
        * Compra      
        ACN(t:16, Val(t:14))
        ACN(t:17, Val(t:15))
      endif
      if Val(t:31)=2
        * Venta
        ACN(t:16, Val(t:15))
        ACN(t:17, Val(t:14))
      endif
      if Val(t:16)<=0
        SCN(z:1, 1)
        ACN((26+FAC):16, 1)
      endif
      if Val(t:17)<=0
        SCN(z:1, 1)
        ACN((26+FAC):17, 1)
      endif

      ***** Forma Liquidacion
      ACN(t:21, 0)
      if Incluido(fbn('TipoLiquidacion'),'1' ) 
        * DVP
        ACN(t:21, 1)
      endif
      if Incluido(fbn('TipoLiquidacion'),'6' ) 
        * RVP
        ACN(t:21, 2)
      endif
      
      ***** Mercados Liquidacion
      ***** Mercado Liq Especie
      ACT(t:22, MercadoDef(Val(t:3)))
      ***** Mercado2 Liq ContraEspecie
      ACT(t:23, MercadoDef(Val(t:4)))
** FJL 22/03/24 - Por Issue 
** FJL 27/06/24 - Por Issue 
      if EqStr(Val(t:3),'USD') y EqStr(Val(t:4),'USD')
        if Val(t:31)=1
          * Compra (0205)
          ***** Mercado2
          ACT(u:23, 'Cambio')
          ACT(v:23, Val(t:23))
          ACT(t:23, 'BCRA')
        endif
        if Val(t:31)=2
          * Venta (0105)
          ***** Mercado
          ACT(u:22, 'Cambio')
          ACT(v:22, Val(t:22))
          ACT(t:22, 'BCRA')
        endif
      endif

      if Incluido(fbn('EnteLiquidador'),'5') 
        * Entre Partes (Arg)
        ACT(t:22, MercadoDef(Val(t:3)))
        ACT(t:23, MercadoDef(Val(t:3)))
      endif
      if Incluido(fbn('EnteLiquidador'),'j') 
        * MEP C
        ACT(t:22, 'MEP')
        ACT(t:23, 'MEP')
      endif
      
      ***** Operador
      ACT(t:39, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', Val(t:38)))
      if Vacio(Val(t:39))
        ACT(t:39, UsuarioActivo)
        ACN((26+FAC):39, 1)
      endif
      *********************
      if Val(z:1)>0
        ACT(t:52, 'No paso el tercer control')
      endif
      *********************
    endif


    ACN(t:51, Val(z:1))    
    if Val(z:1)=0
        * No tuvo errores
        ACT(b:FAC, 'OK')
        if Dialogo.Check1=0
          ACT(c:FAC, 'Sin Numerador')
          ACT(t:41, 'Sin Procesar')
          Message('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:36))
        endif      
        if Dialogo.Check1=1
          ACT(w:6, GetNumerador(Val(t:40)))
          ACT(c:FAC, Val(w:6))
          ACT(t:41, Val(w:6))
          Message('--- #Op : '~Val(w:6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:36))

          SQL.ADD("Insert into "~DBO~".OPERACIONES (")
          
          SQL.ADD("NrOperacion, ")
          SQL.ADD("TipoOp, ")
          SQL.ADD("Cliente1, ")
          SQL.ADD("Especie, ")
          SQL.ADD("MB1, ")

          SQL.ADD("ContraEspecie, ")
          SQL.ADD("Precio1, ")
          SQL.ADD("Cantidad, ")
          SQL.ADD("TotalBrutoCLi1, ")
          SQL.ADD("FechaOp, ")

          SQL.ADD("ValorRB1, ")
          SQL.ADD("Puesto, ")
          SQL.ADD("MercadoRB, ")
          SQL.ADD("Mercado, ")
          SQL.ADD("Mercado2, ")

          SQL.ADD("Mercado4, ")
          SQL.ADD("FormaLiquidacion1, ")
          SQL.ADD("TablaFeriados1, ")
          SQL.ADD("Operador, ")

          SQL.ADD("OpSIOPEL, ")
          SQL.ADD("EnteCus1, ")
          SQL.ADD("EnteCus2, ")
          SQL.ADD("Vehiculo1, ")
          
          SQL.ADD("CB5, ")
          SQL.ADD("UDN2, ")
          SQL.ADD("AceptaMAE, ")
          SQL.ADD("NroAltaMAE, ")

          SQL.ADD("FechaAltaMAE, ")
          SQL.ADD("Cuenta1, ")
          SQL.ADD("Numerador, ")
          SQL.ADD("FechaCarga, ")

          SQL.ADD("FechaCargaSys, ")
          SQL.ADD("UsrInput, ")
          SQL.ADD("Direccion ")

          SQL.ADD(") values (")
          
          * NrOperacion
          SQL.ADD(" '"~Val(w:6)~"', ")
          * TipoOp
          SQL.ADD(" '"~Val(t:2)~"', ")
          * Cliente1
          SQL.ADD(" '"~Val(t:36)~"', ")
          * Especie
          SQL.ADD(" '"~Val(t:3)~"', ")
          * MB1 - |Compra|Venta
          SQL.ADD(" "~FStr(Val(t:31)-1,0,0)~", ")

          * ContraEspecie
          SQL.ADD(" '"~Val(t:4)~"', ")
          * Precio1
          SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
          * Cantidad - Imp.Cpra
          SQL.ADD(" "~FStr(Val(t:16),0,2)~", ")
          * TotalBrutoCli1 - Imp.Vta
          SQL.ADD(" "~FStr(Val(t:17),0,2)~", ")
          * FechaOp
          SQL.ADD(" '"~IdxDate(Val(t:5))~"', ")

          * ValorRB1
          SQL.ADD(" "~FStr(Val(t:7),0,0)~", ")
          * Puesto
          SQL.ADD(" "~FStr(Val(t:6),0,0)~", ")
          * MercadoRb
          SQL.ADD(" "~FStr(Val(t:12),0,0)~", ")
          * Mercado
          SQL.ADD(" '"~Val(t:22)~"', ")
          * Mercado2
          SQL.ADD(" '"~Val(t:23)~"', ")

          * Mercado4
          SQL.ADD(" '"~Val(t:44)~"', ")
          * FormaLiquidacion1
          SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
          * TablaFeriados1
          SQL.ADD(" '"~Val(t:8)~"', ")
          * Operador
          SQL.ADD(" '"~Val(t:25)~"', ")

          * OpSIOPEL
          SQL.ADD(" '"~Val(t:26)~"', ")
          * EnteCus1 - CodigoTitulo
          SQL.ADD(" '"~Val(t:46)~"', ")
          * EnteCus2 - AgenteContra
          SQL.ADD(" '"~Val(t:34)~"', ")
          * Vehiculo1
          SQL.ADD(" '"~Val(t:45)~"', ")

          * CB5 (Oferta)
          SQL.ADD(" '1', ")
          * UDN2 (Rueda)
          SQL.ADD(" '"~Val(t:43)~"', ")
          * AceptaMAE
          SQL.ADD(" 'SI', ")
          * NroAltaMAE
          SQL.ADD(" '"~Val(t:42)~"', ")

          * FechaAltaMAE
          SQL.ADD("Convert(datetime,'"~Val(t:47)~"',120), ")
          * Cuenta1
          SQL.ADD(" '"~Val(t:18)~"', ")
          * Numerador
          SQL.ADD(" "~FStr(Val(t:40),1,0)~", ")
          * FechaCarga
          SQL.ADD(" "~SQLAhora~", ")

          * FechaCargaSys
          SQL.ADD(" "~IdxDate2(FSys)~", ")
          * UsrInput
          SQL.ADD(" '"~UsuarioActivo~"', ")
          * Direccion
          SQL.ADD(" 2 ")

          SQL.ADD(")")
          SQL.NEW

          SQL.ADD("Update "~DBO~".OPSIOPEL ")
          SQL.ADD("   Set Procesado   = '1',")
          SQL.ADD("       Carga       = '1', ")
          SQL.ADD("       NrOperacion = '"~Val(w:6)~"' ")
          SQL.ADD(" where Secuencia2  = '"~Val(a:FAC)~"' ")
          SQL.NEW
          SQL.EXEC

          Message('Modificar Operacion '~Val(w:6))
          ModificarOperacion(Val(w:6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)

          IF Ok
            ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
            SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w:6)~"' ")
            SQL.NEW
            SQL.EXEC                   
          Endif
          Message('Fin Modificar Operacion')
        
          ** FJL 05/07/23 - Se agrega la asignacion de NrBoleto porque con el Workflow reducdio la Operacion ya no va a CargaTrader donde se asignaba
          EjecutarEvento('ASBOFX', NrOperacion1 = Val(w:6), Check1 = 1, Check2 = 0)
        endif

        If Val(cl:1) = 1
          Message('Operacion '~Val(w:6)~' Ok. Pasa a Instancia 4')        
          ACT(d:FAC, 'A inst 4')
          ACN(i:FAC, Val(cl:1))
          if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
            SQL.ADD("   Set Valor       = '0'  ")
            SQL.ADD(" where NrOperacion = '"~Val(w:6)~"' ")
            SQL.ADD("   and Valor       = '1' ")
            SQL.NEW
            SQL.EXEC           
            SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
            SQL.ADD("   Set Valor       = '1'  ")
            SQL.ADD(" where NrOperacion = '"~Val(w:6)~"' ")
            SQL.ADD("   and Nrbit       = 4 ")
            SQL.NEW
            SQL.ADD("Update "~DBO~".OPERACIONES  ")
            SQL.ADD("   Set Direccion    = 2,  ")
            SQL.ADD("       EsCaucionado = '1'  ")
            SQL.ADD(" where NrOperacion  = '"~Val(w:6)~"' ")
            SQL.NEW      
            SQL.EXEC
          endif
        endif
    else
      ACT(b:FAC, 'Error')
    endif      
      
    if Dialogo.Check1=0
      ACT((78+FAC):1,  Val(t:1))
      ACT((78+FAC):2,  Val(t:2))
      ACT((78+FAC):3,  Val(t:3))
      ACT((78+FAC):4,  Val(t:4))
      ACD((78+FAC):5,  Val(t:5)) 
      ACN((78+FAC):6,  Val(t:6))
      ACN((78+FAC):7,  Val(t:7))
      ACT((78+FAC):8,  Val(t:8))
*      ACT((78+FAC):9,  Val(t:9))
*      ACT((78+FAC):10, Val(t:10))
*      ACN((78+FAC):11, Val(t:11))
      ACN((78+FAC):12, Val(t:12))
      ACN((78+FAC):13, Val(t:13))
      ACN((78+FAC):14, Val(t:14))
      ACN((78+FAC):15, Val(t:15))
      ACN((78+FAC):16, Val(t:16))
      ACN((78+FAC):17, Val(t:17))
      ACT((78+FAC):18, Val(t:18))
*      ACD((78+FAC):19, Val(t:19))
*      ACT((78+FAC):20, Val(t:20))
      ACN((78+FAC):21, Val(t:21))
      ACT((78+FAC):22, Val(t:22))
      ACT((78+FAC):23, Val(t:23))
*      ACT((78+FAC):24, Val(t:24))
*      ACT((78+FAC):25, Val(t:25))
*      ACT((78+FAC):26, Val(t:26))
      ACN((78+FAC):27, Val(t:27))
