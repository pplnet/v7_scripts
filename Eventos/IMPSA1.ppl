HojaVisible(SI)
MostrarCuadroDeMensajes

CrearDialogo
    Fecha1:  'Fecha Saldos'               ;1;1;1;SI;SI;EsHabil(Dialogo.Fecha1,'ARG');'Dia no habil';SI;FSYS
    Directorio1:    'Path DATANET'        ;2;1;1;SI;SI;;;;Var('PATHDN')
    String1:    'Archivo DATANET'         ;3;1;1;SI;SI;;;;Var('FILEDN')
FinDialogo

If not ok
    Cancelar
Endif

(.'VALIDPATH'.)

*** Corregir path
let &pf ''
If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
    let &pf Dialogo.Directorio1~Dialogo.String1
Else
    let &pf Dialogo.Directorio1~'\'~Dialogo.String1
Endif

CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

ACT(C:1,'Importacion de Saldos Bancarios')
SetFont(C:1,1)

AbrirAscii(&pf, 0)
If not ok
    CerrarAscii
    Cancelar
Endif

let &clave ''
let &cantReg 0

SetFilaActual(9)
ACN(DE:1,fac)

Message('Procesando datos')
***------------------- BAJADA DE DATOS DE ARCHIVO A HOJA ---------------------------*
Recorrer&i 1,100000
    ACT(ZZ:1, LeerAscii)
    If Not Ok 
        Break
    Endif
   
    let &clave Copy(Val(ZZ:1),1,1)
    If &i=1
        If not Eqstr(&clave,'I')
            HojaVisible(NO)
            MessageBox('Registro inicial debe comenzar con I')
            CerrarAscii
            Cancelar
        Else
            ACT(A:3, 'Registro Inicial')
            SetFont(A:3..L:3,2)
            AgregarMarco(A:3..L:3,1,1,Exe('COLOR'))
            ACT(A:4, 'Tipo de registro')
            ACT(B:4, 'NrCliente')
            ACT(C:4, 'Fecha de proceso')
            SetFont(A:4..C:4,3)
            AgregarMarco(A:4..C:4,1,3,Exe('COLOR6'))
            ACT(A:5, &clave)
            ACT(B:5, Copy(Val(ZZ:1),2,7))
            let &fecha Copy(Val(ZZ:1),9,8)
            ACD(C:5, Fecha(Copy(&fecha,7,2)~'/'~Copy(&fecha,5,2)~'/'~Copy(&fecha,1,4)))
            
            If Val(C:5) <> Dialogo.Fecha1
                HojaVisible(NO)
                MessageBox('Fecha Saldos('~Dialogo.Fecha1~') y fecha del CSV('~Val(C:5)~') son distintas')
                CerrarAscii
                Cancelar
            Endif
            
            ACT(A:6, 'Registro de Datos')
            SetFont(A:6..L:6,2)
            AgregarMarco(A:6..L:6,1,1,Exe('COLOR'))
            
            ACT(A:7, 'Tipo de registro')
            ACT(B:7, 'Tipo de cuenta')
            ACT(C:7, 'Codigo de Banco')
            ACT(D:7, 'Codigo moneda')
            ACT(E:7, 'Nro. de cuenta')
            ACT(F:7, 'Nro. de CBU')
            ACT(G:7, 'Nro. de CUIT')
            ACT(H:7, 'Denominacion de la cuenta')
            ACT(I:7, 'Signo saldo contable')
            ACT(J:7, 'Saldo contable')
            ACT(K:7, 'Signo Saldo inicial')
            ACT(L:7, 'Saldo inicial')
            
            ACT(A:7+1, 'Debitos')
            ACT(B:7+1, 'Creditos')
            ACT(C:7+1, 'Signo Saldo operativo')
            ACT(D:7+1, 'Saldo operativo')
            ACT(E:7+1, 'Debito proyeccion 24hs')
            ACT(F:7+1, 'Crédito Proyección 24 hs')
            ACT(G:7+1, 'Signo Proyección 24 hs')
            ACT(H:7+1, 'Proyección 24 hs')
            ACT(I:7+1, 'Débito Proyección 48 hs')
            ACT(J:7+1, 'Crédito Proyección 48 hs')
            ACT(K:7+1, 'Signo Proyección 48 hs')
            ACT(L:7+1, 'Proyección 48 hs')
            
            SetFont(A:7..L:7+1,3)
            AgregarMarco(A:7..L:7+1,1,3,Exe('COLOR6'))
            
        Endif
    Else
        If Eqstr(&clave,'S')
            let &cantReg &cantReg+1
            ACT(A:fac, &clave)
            ACT(B:fac, Copy(Val(ZZ:1),2,2))
            ACT(C:fac, Copy(Val(ZZ:1),4,3))
            ACT(D:fac, Trim(Copy(Val(ZZ:1),7,3)))
            ACT(E:fac, Trim(Copy(Val(ZZ:1),10,17)))
            ACT(F:fac, Copy(Val(ZZ:1),27,22))
            ACT(G:fac, Copy(Val(ZZ:1),49,11))
            ACT(H:fac, Trim(Copy(Val(ZZ:1),60,40)))
            ACT(I:fac, Copy(Val(ZZ:1),100,1))
            ACN(J:fac, Num(Copy(Val(ZZ:1),101,15)~'.'~Copy(Val(ZZ:1),116,2)))
            ACT(K:fac, Copy(Val(ZZ:1),118,1))
            ACN(L:fac, Num(Copy(Val(ZZ:1),119,15)~'.'~Copy(Val(ZZ:1),134,2)))
            
            ACN(A:fac+1, Num(Copy(Val(ZZ:1),136,15)~'.'~Copy(Val(ZZ:1),151,2)))
            ACN(B:fac+1, Num(Copy(Val(ZZ:1),153,15)~'.'~Copy(Val(ZZ:1),168,2)))
            ACT(C:fac+1, Copy(Val(ZZ:1),170,1))
            ACN(D:fac+1, Num(Copy(Val(ZZ:1),171,15)~'.'~Copy(Val(ZZ:1),186,2)))
            ACN(E:fac+1, Num(Copy(Val(ZZ:1),188,15)~'.'~Copy(Val(ZZ:1),203,2)))
            ACN(F:fac+1, Num(Copy(Val(ZZ:1),205,15)~'.'~Copy(Val(ZZ:1),220,2)))
            ACT(G:fac+1, Copy(Val(ZZ:1),222,1))
            ACN(H:fac+1, Num(Copy(Val(ZZ:1),223,15)~'.'~Copy(Val(ZZ:1),238,2)))
            ACN(I:fac+1, Num(Copy(Val(ZZ:1),240,15)~'.'~Copy(Val(ZZ:1),255,2)))
            ACN(J:fac+1, Num(Copy(Val(ZZ:1),257,15)~'.'~Copy(Val(ZZ:1),272,2)))
            ACT(K:fac+1, Copy(Val(ZZ:1),274,1))
            ACN(L:fac+1, Num(Copy(Val(ZZ:1),275,15)~'.'~Copy(Val(ZZ:1),290,2)))
            
            ACN(HA:1,fac)
            ifa
            ifa
        Else
            If Eqstr(&clave,'F')
                ACT(A:fac, 'Registro de Datos')
                SetFont(A:fac..L:fac,2)
                AgregarMarco(A:fac..L:fac,1,1,Exe('COLOR'))
                ifa
                ACT(A:fac, 'Tipo de registro')
                ACT(B:fac, 'Cantidad de registros')
                SetFont(A:fac..B:fac,3)
                AgregarMarco(A:fac..B:fac,1,3,Exe('COLOR6'))
                ifa
                ACT(A:fac, &clave)
                ACN(B:fac, Num(Copy(Val(ZZ:1),2,6)))
                Break
            Else
                HojaVisible(NO)
                MessageBox('Registro final/de Datos debe ser tipo F/S')
                CerrarAscii
                Cancelar
            Endif
        Endif
    Endif
Proximo

CerrarAscii

** Validar que el último registro no haya sido una S
If not Eqstr(&clave,'F')
    HojaVisible(NO)
    MessageBox('No se encontro Registro Final tipo F, se cancela Evento.')
    Cancelar
Endif

If &cantReg <> Val(B:fac)
    HojaVisible(NO)
    MessageBox('La cantidad de registros('~Fstr(&cantReg,0,0)~') no coincide con la indicada en el registro final('~Fstr(Val(B:fac),0,0)~'). Por lo tanto no se van a procesar los datos.')
    Cancelar
Endif

ACO(1,9)
ACO(2,9)
ACO(3,10)
ACO(4,10)
ACO(5,12)
ACO(6,15)
ACO(7,12)
ACO(8,30)
ACO(9,13)
ACO(10,13)
ACO(11,13)
ACO(12,12)
ACO(13,30)

ifa
ifa

ACT(A:fac,'FIN DEL INFORME' )
SetFont(A:fac,2)

LimitesVision(N:fac+1)



Message('Insertando registros en la Base de Datos')

let &flag 0

***------------------- PROCESAMIENTO DE DATOS A LA BASE ---------------------------*
Recorrer&j Val(DE:1), Val(HA:1)

    If &flag=0
        If SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo >= '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(E:&j)~"' and Estado <> 'ANU'  ")=1
            IF SQL(" Select 1 from "~dbo~".SALDOSBANCARIOS where FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' and NrCuenta = '"~Val(E:&j)~"' and Estado <> 'ANU'  ")=1
                ACT(M:&j, 'Ya existe saldo para '~Val(E:&j)~' al '~Dialogo.Fecha1~' ')
            Else
                ACT(M:&j, 'Existen saldos posteriores para '~Val(E:&j)~' al '~Dialogo.Fecha1~' ')
            Endif
            ColorCeldas(M:&j, clRED)
        Else
        
        ACD(DD:1,Fecha(PriDeMes(Val(C:5),SI)))
        let &contable 0
        let &operativo 0
        let &inicial 0
        let &dias 0
        ****-------------- Buscar saldos anteriores (del mismo mes) para calcular promedios --------******
        If Val(DD:1) < Val(C:5)
            SQL.ADD(" Select TOP 1 SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu from "~dbo~".SALDOSBANCARIOS ")
            SQL.ADD(" where NrCuenta = '"~Val(E:&j)~"' and FechaSaldo < '"~IdxDate(Val(C:5))~"' and  FechaSaldo >= '"~IdxDate(Val(DD:1))~"' and Estado <> 'ANU' ")
            SQL.ADD(" Order by FechaSaldo DESC ")
            Recorrer SQL
                let &contable FBN['SaldoAcuCon']
                let &operativo FBN['SaldoAcuOpe']
                let &inicial FBN['SaldoAcuIni']
                let &dias FBN['DiasAcu']
                break
            Proximo
        Endif
        
        If Eqstr(Val(I:&j),'C')
            let &contable &contable+Val(J:&j)
        Else
            let &contable &contable-Val(J:&j)
        Endif
        
        If Eqstr(Val(K:&j),'C')
            let &inicial &inicial+Val(L:&j)
        Else
            let &inicial &inicial-Val(L:&j)
        Endif
        
        If Eqstr(Val(C:&j+1),'C')
            let &operativo &operativo+Val(D:&j+1)
        Else
            let &operativo &operativo-Val(D:&j+1)
        Endif
        
        let &flag2 0

       ***--------------- Insertar saldo de siguiente/s fecha/s no habil/es  --------***
        Recorrer&k Val(C:5), Habiles(Val(C:5),+1,'ARG')-1
            let &dias &dias+1
            If &flag2=0 y Fecha(&k) > FinDeMes(Val(C:5),SI)
                ***---Cambio de Mes
                let &dias 1
                let &flag2 1 
                let &operativo Val(D:&j+1)
                let &contable Val(J:&j)
                let &inicial Val(L:&j)
            ELSE
                IF &k > Val(C:5)
                    ***---Los dias no hábiles sumo al acumulado el saldo del dia hábil anterior
                    let &operativo &operativo + Val(D:&j+1)
                    let &contable &contable + Val(J:&j)
                    let &inicial &inicial + Val(L:&j)
                ENDIF
            Endif
            SQL.ADD(" INSERT INTO "~dbo~".SALDOSBANCARIOS ")
            SQL.ADD(" (FechaSaldo, FechaBajada, FechaCarga, NrCuenta, Nombre, SaldoContable, ")
            SQL.ADD(" SaldoInicio, SaldoOperativo, Proyectado24h, Proyectado48h, ")
            SQL.ADD(" Estado, TipoCuenta, Banco, CBU, CUIT, ")
            SQL.ADD(" SignoContable, SignoInicial, SignoOperativo, Debitos, Creditos, ")
            SQL.ADD(" SaldoOpePromedio, SaldoConPromedio, Usuario, SaldoIniPromedio, ")
            SQL.ADD(" SaldoAcuCon, SaldoAcuOpe, SaldoAcuIni, DiasAcu, Ajuste ) ")
            SQL.ADD(" Values('"~IdxDate(Fecha(&k))~"' , '"~IdxDate(FSYS)~"' , "~SQLAhora~" , '"~Val(E:&j)~"' , '"~Val(H:&j)~"' , "~Fstr(Val(J:&j),1,2)~" , ")
            SQL.ADD(" "~Fstr(Val(L:&j),1,2)~" , "~Fstr(Val(D:&j+1),1,2)~" , "~Fstr(Val(H:&j+1),1,2)~" , "~Fstr(Val(L:&j+1),1,2)~" , ")
            SQL.ADD(" 'REC' , '"~Val(B:&j)~"' , '"~Val(C:&j)~"' , '"~Val(F:&j)~"' , '"~Val(G:&j)~"' , ")
            SQL.ADD(" '"~Val(I:&j)~"' , '"~Val(K:&j)~"' , '"~Val(C:&j+1)~"' , "~Fstr(Val(A:&j+1),1,2)~" , "~Fstr(Val(B:&j+1),1,2)~" , ")
            SQL.ADD(" "~Fstr(&operativo/&dias,1,2)~" , "~Fstr(&contable/&dias,1,2)~" , '"~UsuarioActivo~"' , "~Fstr(&inicial/&dias,1,2)~" , ")
            SQL.ADD(" "~Fstr(&contable,1,2)~", "~Fstr(&operativo,1,2)~", "~Fstr(&inicial,1,2)~", "~Fstr(&dias,1,0)~", 0)  ")
            SQL.NEW
            SQL.EXEC
        Proximo
        
        Endif

        let &flag 1
    Else
        let &flag 0
    Endif
    
Proximo





