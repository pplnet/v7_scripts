*- Calculo Comisiones sobre Saldos - MENSUAL
*- Si es Mensual    => Es para Clientes de Patagonia
*- Si es Trimestral => Es para Clientes de Sudameris
ModoReproceso(SinDialogo)
MostrarCuadroDeMensajes
HojaVisible(NO)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
  Entero4    : "Mes"        ;2;1;;;;Dialogo.Entero4>=1 y Dialogo.Entero4<=12;'Nro. de Mes Incorrecto';NO;Mes(Fsys)
  Entero2    : "Anio"       ;2;2;; ;;Dialogo.Entero2>0;'Anio Incorrecto';NO;Anio(Fsys)
  Fecha1     : "F.Desde"    ;3;1;;NO;;Dialogo.Fecha1<=FSys Y Dialogo.Fecha1<>0 ;"Fecha Desde Incorrecta";NO;IIf(Dialogo.Radio2=0,PriDeMes(Fecha('01/'~Pad0(Fstr(IIf(Dialogo.Entero1=1,1,IIf(Dialogo.Entero1=2,4,IIf(Dialogo.Entero1=3,7,10))),0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),PriDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI));IIf(Dialogo.Radio2=0,PriDeMes(Fecha('01/'~Pad0(Fstr(IIf(Dialogo.Entero1=1,1,IIf(Dialogo.Entero1=2,4,IIf(Dialogo.Entero1=3,7,10))),0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),PriDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI))
  Fecha2     : "F.Hasta"    ;;;;NO;;Dialogo.Fecha2<=Habiles(FSys,1) Y Dialogo.Fecha2>=Dialogo.Fecha1 ;"Fecha Hasta Incorrecta";NO;;IIf(Dialogo.Radio2=0,IIf(Dialogo.Entero1<>Trunc2(Dialogo.Entero4/3.1)+1,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),IIF(Fsys=FinDeMes(Fsys),FinDeMes(Fsys,SI),Fsys)),IIF(Mes(Fsys)<>Dialogo.Entero4 o Anio(Fsys)<>Dialogo.Entero2,FinDeMes(Dialogo.Fecha1,SI),Fsys))
  Radio2     : "Tipo|Trimestral|Mensual|"  ;;;;NO;NO;;;;1
  Entero1    : "Trimestre"  ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Entero1>=1 y Dialogo.Entero1<=4;'Nro. de Trimestre Incorrecto';NO;Trunc2(Mes(Fsys)/3.1)+1
FinDialogo

If Not Ok
   Cancelar
EndIf

*--- Esto es un store procedure de la base de datos que devuelve un resultado
*SQL.ADD(" EXECUTE "~DBO~".sp_comisiones_sobre_saldos '"~Dialogo.Vehiculo1~"','"~IdxDate(Dialogo.Fecha1)~"','"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" EXECUTE "~DBO~".sp_comisiones_sobre_saldos '"~Dialogo.Vehiculo1~"',"~IdxDate2(Dialogo.Fecha1)~", "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.NEW
SQL.EXEC
