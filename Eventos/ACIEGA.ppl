*- dar vuelta el ajuste en el bloqueo ---- 
SQL.ADD("SELECT ORD.NrOrden  ")
SQL.ADD("  FROM "~DBO~".ORDENES ORD, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE ORD.FechaOrden="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   AND ORD.NrOrden=B.NrOperacion ")
SQL.ADD("   AND CantidadTotalOrden>Cantidad1 ")
SQL.ADD("   AND (B.NrBit Not in( 30 )   AND B.Valor=1) ")
 watch(sql.batch)
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("AND ORD.Mercado3='"~Dialogo.Mercado1~"' ")
endif

IF Dialogo.Radio1=0
   SQL.ADD("AND ORD.Lotes=0 ")
else
   SQL.ADD("AND ORD.Lotes<>0 ")
endif

