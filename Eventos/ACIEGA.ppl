else
   Cancelar('No se ha corrido el cierre de la Rueda Garantizada para el Plazo '~iif(Dialogo.Radio1=0,'-Contado-','-Otros-')~'')
endif

*--- Mover de Vancida(10) a Aceptada(8) ---
SQL.ADD("SELECT ORD.NrOrden, B.NrBit  ")
SQL.ADD("  FROM "~DBO~".ORDENES ORD, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" WHERE ORD.NrOrden=B.NrOperacion ")
SQL.ADD("   AND ORD.FechaOrden="~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   AND B.NrBit in( 10 ) ")
SQL.ADD("   AND B.Valor=1 ")

IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("AND ORD.Mercado3='"~Dialogo.Mercado1~"' ")
endif

*IF Dialogo.Radio1=1
*   SQL.ADD("AND ORD.Lotes=0 ")
*else
*    IF Dialogo.Radio1=2
*       SQL.ADD("AND ORD.Lotes=24 ")
*    else
*       IF Dialogo.Radio1=3
*       SQL.ADD("AND ORD.Lotes=48 ")
*       else
*       endif
*    endif
*endif

IF Dialogo.Radio1=0
   SQL.ADD("AND ORD.Lotes=0 ")
else
   SQL.ADD("AND ORD.Lotes<>0 ")
endif

