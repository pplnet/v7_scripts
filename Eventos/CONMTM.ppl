CrearDialogo
  Fecha1   : 'Fecha'               ;;;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;FSys
  Vehiculo1: 'Vehiculo'            ;;;;NO;  ;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Radio1   : 'Estado|OK|Dif|Manual';;;;NO;NO;;;;2;
FinDialogo
if Not OK
  Cancelar
endif

if Dialogo.Radio1=0
  ACT(a1, 'OK')
else
  if Dialogo.Radio1=1
    ACT(a1, 'DIF')
  else
    if Dialogo.Radio1=2
      ACT(a1, 'MAN')
    else
      ACT(a1, 'ERR')
    endif
  endif
endif
ACN(b:1, SQL("Select Count(*) From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'CONC' "))
if Val(b:1)>1
  Cancelar('Existe mas de un registro de conciliacio para el '~Dialogo.Fecha1)
endif
if Val(b:1)=1
  ACT(a:2, SQL("Select Estado From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'CONC' "))
  if Dialogo.Radio1=2
    Cancelar('Ya existe flag de Conciliacion para el '~Dialogo.Fecha1~' Estado: '~Val(a:2))
  endif
endif
ACN(b:2, SQL("Select Cantidad From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'CONC' "))
ACN(b:3, Val(b:2)+1)

ACT(c:1, Fecha(Hoy))
ACT(c:2, Copy(Val(c:1),9,2)~Copy(Val(c:1),4,2)~Copy(Val(c:1),1,2))
ACT(d:1, Hora(Ahora))
ACT(d:2, Copy(Val(d:1),1,2)~Copy(Val(d:1),4,2)~Copy(Val(d:1),7,2))

***---Marca de concilacion
if Val(b:1)=0
  ACT(e:1, 'Insert')
  Message('Insert Flag CONC')
  SQL.ADD("Insert Into "~DBO~".FLAGSOCT ( ")
  SQL.ADD("Fecha,    Registro, Paso,      Cantidad, ")
  SQL.ADD("FechaMAE, HoraMAE,  Secuencia, Estado    ")
  SQL.ADD(" ) Values ( ")
  SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
  SQL.ADD(" 'CONC', ")
  SQL.ADD(" 0, ")
  SQL.ADD(" "~FStr(Val(b:3),1,0)~", ")
  SQL.ADD(" '"~Val(c:2)~"', ")
  SQL.ADD(" '"~Val(d:2)~"', ")
  SQL.ADD(" Null, ")
  SQL.ADD(" '"~Val(a:1)~"' ")
  SQL.ADD(" ) ")
  SQL.NEW
else
  ACT(e:1, 'Update')
  Message('Update Flag CONC')
  SQL.ADD("Update "~DBO~".FLAGSOCT ")
  SQL.ADD("   Set Cantidad   = "~FStr(Val(b:3),1,0)~", ")
  SQL.ADD("       FechaMAE   = '"~Val(c:2)~"', ")
  SQL.ADD("       HoraMAE    = '"~Val(d:2)~"', ")
  SQL.ADD("       Estado     = '"~Val(a:1)~"' ")
  SQL.ADD(" where Fecha      = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and Registro   = 'CONC' ")
  SQL.NEW
endif
SQL.EXEC
