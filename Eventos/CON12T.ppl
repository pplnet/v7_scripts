  *Fecha5   : 'Hasta USA'         ;;;;NO;;;;;;Habiles(Dialogo.Fecha1,1,'USA',SI)-1  
  Fecha2   : 'Fecha 1Mes'        ; ;;;NO;;;;;;PriDeMes(Dialogo.Fecha1,SI)  
