CrearDialogo
  Fecha1    : 'Fecha'       ;;;;;;;;;Fsys
  Entero1   : 'Copias'      ;;;;;;;;;1
  Lista1    : 'Vehiculos'   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Directorio1: 'Path cartas'   ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
FinDialogo

if not    ok
   Cancelar
endif

if not ExisteDirectorio(Dialogo.Directorio1)
    Cancelar('Directorio no encontrado'~Dialogo.Directorio1)
endif

CrearFont(1,"Arial,8,B")

If NoVacio(Dialogo.Lista1)
   ACT(zz:6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz:6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

SetFilaActual(0)
ACN(z:1,0)

ACT(VE:1, Var('VEHIEXTRAN'))

SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.Cliente1, O.TipoOp, O.Especie, O.Cantidad, O.ContraEspecie, O.CB3, O.Vehiculo1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where  O.NrOperacion = B.NrOperacion ")
SQL.ADD(" and B.NrBit > 19 and B.Valor ='1' ")
SQL.ADD(" and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.NrOrden Is Null OR O.NrOrden = '') ")
If NoVacio(Val(zz:6))
   SQL.ADD("   and O.Vehiculo1 In ("~Pipe2Comillas(Val(zz:6))~") ")
EndIf
SQL.ADD(" order by O.NrOperacion ")
Watch(sql.batch)
Recorrer SQL
  ACT(aa:FAC, fbn['NrOperacion'])
  ACD(ab:FAC, fbn['FechaOp'])
  ACT(ac:FAC, fbn['Cliente1'])
  ACT(ad:FAC, fbn['TipoOp'])
  ACT(ae:FAC, fbn['Especie'])
  ACN(af:FAC, fbn['Cantidad'])
  ACT(ag:FAC, fbn['ContraEspecie'])
  ACT(ah:FAC, fbn['Vehiculo1'])
  SCN(z1,1)
  ACT(a:Val(z1), Val(aa:FAC))
  ACD(b:Val(z1), Val(ab:FAC))
  ACT(c:Val(z1), Val(ac:FAC))
  ACT(d:Val(z1), Val(ad:FAC))
  ACT(e:Val(z1), Val(ae:FAC))
  ACN(f:Val(z1), Val(af:FAC))
  ACT(g:Val(z1), Val(ag:FAC))
  ACN(h:1, fbn['CB3'])
  *- Modelo de Carta => 0=Comun 1=Intermediario
  ACN(l:Val(z1), 0)
Proximo

If Val(z1)=0
   Cancelar('No existen Cartas para imprimir')
Else
   CrearListBox;'Arial,8,B'
      'Imprime'                  ; k1..k:val(z1); SI; SI;;60; COMBO; 'Si|No|'
      'Modelo'                   ; l1..l:val(z1); SI; SI;;80; COMBO; 'Clasico|Intermed|'
      'Operacion'                ; a1..a:val(z1); NO; SI;;80; STRING
      'FechaLiq'                 ; b1..b:val(z1); NO; SI;;70; FECHA
      'Cliente'                  ; c1..c:val(z1); NO; SI;;70; STRING
      'Tipo'                     ; d1..d:val(z1); NO; SI;;70; STRING
      'Especie'                  ; e1..e:val(z1); NO; SI;;70; STRING
      'Cantidad'                 ; f1..f:val(z1); NO; SI;;100; NUMERO;'###,###,###.##p'
      'Moneda'                   ; g1..g:val(z1); NO; SI;;70; STRING
   FinListBox

   If Not Ok 
      Cancelar
   EndIf
   Recorrer&j 1,val(z1)
     If val(k:&j)=0
        *- Imprime 
        ACT(i:&j, GetNumerador(20))
        ***---Inserto el valor de la carta en Operaciones
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("Set    NrOrden = '"~Val(i:&j)~"' ")
        SQL.ADD("where  NrOperacion = '"~Val(aa:&j)~"' ")
        SQL.NEW
        SQL.EXEC
        Recorrer&k 1, Dialogo.Entero1
           If Incluido(val(d:&j), 'TRANTI|')
               EjecutarEvento('CACTRA',NrOperacion1=Val(a:&j),Fecha1=FSys, Directorio1=Dialogo.Directorio1,String1=Var('FILECACTRA'))
           Else
              If Incluido(val(d:&j), 'MMCP|MMCPM|')
                  EjecutarEvento('CACPLF',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACPLF'))
              Else
                  If Incluido(val(d:&j), 'MMO|')
                        EjecutarEvento('CACMMO',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACMMO'))
                  Else
                      If Incluido(val(d:&j), 'MMCCR|')
                            EjecutarEvento('CACREM',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACREM'))
                      Else
                          If Incluido(val(d:&j), 'MMDC|')
                            EjecutarEvento('CACDES',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACDES'))
                          Else
                              If Incluido(val(d:&j), 'MMCAUA|')
                                EjecutarEvento('CACCAU',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACCAU'))
                              Else
                                  If Incluido(val(d:&j), 'SECSV|SEVSV|SECT|SEVT|SECTV|SEVTV|')
                                        EjecutarEvento('CACSEC',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACSEC'))
                                  Else
                                      If Incluido(VAL(D:&J),'SECS|SEVS')
                                        IF Incluido(Val(AH:&j), Val(VE:1))
                                            ***---Extranjero
                                            EjecutarEvento('CACSEE',NrOperacion1=Val(A:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACSEE'))
                                        ELSE
                                            ***---Local
                                            EjecutarEvento('CACSEL',NrOperacion1=Val(A:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACSEL'))
                                        ENDIF
                                      Else
                                          If Incluido(val(d:&j), 'MMPCL|MMPCLM|MMPCOS|MMPOSM|MMFCMV|MMFRN|MMPE|MMPEM|MMPI|MMPIM|MMPSC|MMSCMV|MMON|MMONM|') 
                                              EjecutarEvento('CACPRE',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACPRE'))
                                          Else
                                              If Incluido(val(d:&j), 'TRANMM|')
                                                  EjecutarEvento('CACTRN',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACTRN'))
                                              Else                                                                                       
                                                  If Incluido(val(d:&j), 'MMPCCM|SEPVMV|MMPCCV')                                                      
                                                      If Val(h:1)=1
                                                            EjecutarEvento('CACPRV',NrOperacion1=Val(a:&j),Radio1=1, Directorio1=Dialogo.Directorio1,String1=Var('FILECACPRV'))
                                                      Else
                                                            EjecutarEvento('CACPRV',NrOperacion1=Val(a:&j),Radio1=0, Directorio1=Dialogo.Directorio1,String1=Var('FILECACPRV'))
                                                      Endif
                                                  Else
                                                      If Incluido(val(d:&j), 'FCR')
                                                            EjecutarEvento('CACFCR',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACFCR'))
                                                      Else
                                                         If Incluido(val(d:&j), 'FCS')
                                                                EjecutarEvento('CACFCS',NrOperacion1=Val(a:&j), Directorio1=Dialogo.Directorio1,String1=Var('FILECACFCS'))
                                                         Else
                                                            MessageBox('Carta no definida para Operacion '~val(d:&j))
                                                            *----  If Incluido(val(d:&j),Exe('CARTA1C')) o Incluido(val(d:&j),Exe('CARTA1V'))
                                                            *----      LinkearHoja('CARTA1',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(i:&j),Fecha1=Dialogo.Fecha1,Check1=1,Radio1=val(l:&j))
                                                            *----  Else
                                                            *----      If Incluido(val(d:&j),Exe('CARTA2')) o EqStr(val(d:&j),'MMP')
                                                            *----          LinkearHoja('CARTA2',1,NrOperacion1=Val(a:&j),NrOperacion2=Val(i:&j),Fecha1=Dialogo.Fecha1,Check1=1,Radio1=val(l:&j))
                                                            *----      ENDIF                                                             
                                                            *----  ENDIF
                                                         ENDIF                
                                                      ENDIF   
                                                  ENDIF
                                              ENDIF
                                          ENDIF
                                      ENDIF
                                  ENDIF
                              ENDIF
                          ENDIF
                      ENDIF
                  ENDIF
              Endif
           ENDIF        
        Proximo        
        *SQL.ADD("Insert Into "~DBO~".INSTANCIASOP ")
        *SQL.ADD("( NrOperacion, NrInstancia, Usuario, Fecha ) ")
        *SQL.ADD(" Values ")
        *SQL.ADD("( '"~Val(aa:&j)~"', 14 , '"~UsuarioActivo~"', ")
        *SQL.ADD(SQLFechaStr(Hoy~' '~Hora(Ahora))~")")
        *SQL.NEW
        *SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
        *SQL.ADD("SET Valor = '0' ")
        *SQL.ADD("where NrOperacion = '"~Val(aa:&j)~"' ")
        *SQL.ADD("and NrBit = 14 ")
        *SQL.NEW
        *SQL.ADD("UPDATE "~DBO~".OPERACIONESBITS ")
        *SQL.ADD("SET Valor = '1' ")
        *SQL.ADD("where NrOperacion = '"~Val(aa:&j)~"' ")
        *SQL.ADD("and (NrBit = 16 or NrBit = 17) ")
        *SQL.NEW
        *SQL.EXEC
     EndIf
   Proximo
Endif

FormatoCeldas(af:1..af:Val(z1),Exe('F2'))
SetFont(a:1..az:FAC,1)

