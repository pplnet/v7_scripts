HojaVisible(NO)
MostrarCuadroDeMensajes
CrearDialogo
   Vehiculo1: "Vehiculo" ;;;;;;NoVacio(Dialogo.Vehiculo1) y IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Count(*) from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "))>0;'Debe ingresar un Vehiculo';NO;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~VAR('VEHICULODE')~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~VAR('VEHICULODE')~"' "));;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS "),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' "));NO
   Fecha2   : "F.Desde"  ;;;;;;Vacio(Dialogo.Fecha2) o Dialogo.Fecha2<=Dialogo.Fecha1;'Fecha Desde Vacia o Inferior a Fecha Hasta';NO;;
   Fecha1   : "F.Hasta"  ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha Hasta';NO;FSys;
   Especie1 : "Especie"  ;;;;;;
   Cliente1 : "Entidad"  ;;;;;;
   Vehiculo2: "Vehiculo" ;;;;;No;NoVacio(Dialogo.Vehiculo2);'Debe ingresar un Vehiculo';NO;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQL("Select Codigo from "~DBO~".VEHICULOS Where Codigo='"~Dialogo.Vehiculo1~"' "),SQL("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo='"~UsuarioActivo~"' and Vehiculo='"~Dialogo.Vehiculo1~"' "));
   Check1   : 'Netea Partidas' ;;;;NO;NO;;;;1;
FinDialogo

If Not OK
   Cancelar
Endif

CrearFont(1,"Arial,8,B")
If Not Incluido(Dialogo.Vehiculo1, Var('VLIQUIDA'))
   Cancelar('El Vehiculo '~Dialogo.Vehiculo1~' no liquida operaciones')
Endif

MostrarCuadroDeMensajes

***---Select
(.'LIQUID1'.)

SQL.ADD(" ORDER BY 1, 2, 3, 4 ")

Recorrer SQL
   IF Eqstr(Copy(fbn('TipoOp'), 1, 3), 'MMP')
       ***---Armo lista de operaciones de la partida
       ACT(LS:1, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where OperacionRef = '"~fbn('NrOperacion')~"' "))
       ACT(Z:1, SQLSet(" Select TipoOp From "~DBO~".OPERACIONES Where NrOperacion IN ("~Pipe2Comillas(Val(LS:1))~") "))
   ELSE
       ACT(z1, BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn('NrOperacion')))
       ACT(LS:1, fbn('NrOperacion'))
   ENDIF
   If Incluido(Val(z1),Exe('CARTA1C')) o Incluido(Val(z1),Exe('CARTA1V')) o Incluido(Val(z1),Exe('CARTA2'))
      Message(" Operacion Nro. "~FBN['NrOperacion'])
      ACT(a:fac, FBN['NrOperacion'])
      ACD(b:fac, FBN['FechaMov'])
      ACT(c:fac, FBN['Cliente'])
      ACT(d:fac, FBN['Especie']~' '~FBN['Cupon'])
      ACN(e:fac, -FBN['Cantidad'])
      ACT(g:fac, FBN['Transaccion'])
      ACT(f:fac, FBN['Cuenta'])
      ACT(i:fac, FBN['Leyenda'])
      ACN(k:fac, 1)
      ACN(p:fac, FBN['NrMov'])
      ACT(r:fac, FBN['Especie'])
      ACT(s:fac, FBN['Cupon'])
      ACT(u:fac, FBN['Cuenta'])
      ACT(TP:fac, fbn('TipoOp'))
   Else
      DFA
   Endif
Proximo

If FAC>0
   ACN(z3,FAC)
   Recorrer&i 1, Val(z3)
      IF Eqstr(Copy(Val(TP:&i), 1, 3), 'MMP')
          ACT(LS:&i, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where OperacionRef = '"~Val(A:&i)~"' "))
      ELSE
          ACT(LS:&i, Val(A:&i))
      ENDIF
      ACT(q:&i, Ascendientes('ESPECIES',val(r:&i)) )

      ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )

      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta Permanente del Cliente de la operacion y el vehiculo de la operacion
         SQL.ADD("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Comitente = '"~Val(c:&i)~"'  and Permanente = 'SI' and Estado = 'HAB' and Numero is Not NULL")
         Recorrer SQL
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               ACT(l:&i, 'Perm.')
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else
                  ACT(g:&i, 'DEBITO')
               Endif
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               Break
            Endif
         Proximo
      Else 
         *- En la operacion marcaron una cuenta valida
         Recorrer ("Select Permanente,Comitente,Cliente,Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Codigo = '"~val(f:&i)~"' ")
            DFA 
            ACT(l:&i, IIF(EqStr(FBN['Permanente'],'SI'),'Perm.','') )
            If EqStr(FBN['Comitente'],Val(c:&i))   
               *- Es una cuenta del mismo banco que la operacion
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else 
                  ACT(g:&i, 'DEBITO')
               Endif
            Else 
               ACT(g:&i, 'TRANSF')
            Endif
            ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
         Proximo
      EndIf
      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta No Permanente del Cliente de la operacion y el vehiculo de la operacion
         Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Comitente = '"~Val(c:&i)~"' and Estado = 'HAB' and Numero is Not NULL")
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               If Val(e:&i)>0
                  ACT(g:&i, 'CREDIT')
               Else
                  ACT(g:&i, 'DEBITO')
               Endif
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               break
            Endif
         Proximo
      Endif
      If Vacio(Val(f:&i)) o Vacio(val(zz1))
         *- CUENTA VEHICULO: Cuenta Permanente de cualquier cliente y el vehiculo de la operacion
         Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Permanente = 'SI' and Estado = 'HAB' and Numero is Not NULL")
            dfa
            If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
               ACT(f:&i, FBN['Codigo'])
               ACT(l:&i, 'Perm.')
               ACT(g:&i, 'TRANSF')
               break
               ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
            Endif
         Proximo
         If Vacio(Val(f:&i)) o Vacio(val(zz1))
            *- CUENTA VEHICULO: Cuenta No Permanente de cualquier cliente y el vehiculo de la operacion
            Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Dialogo.Vehiculo1~"' and Estado = 'HAB' and Numero is Not NULL")
               dfa
               If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                  ACT(f:&i, FBN['Codigo'])
                  ACT(g:&i, 'TRANSF')
                  break
                  ACT(zz1, BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)) )
               Endif
            Proximo
         Endif
         If NoVacio(Val(f:&i))
            *- CUENTA CLIENTE: 
            Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Permanente = 'SI' and Estado = 'HAB'  and Numero is Not NULL")
               dfa
               If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                  ACT(h:&i, FBN['Codigo'])
                  break
               Endif
            Proximo
            If Vacio(Val(h:&i))
               Recorrer ("Select Codigo, Especies, Transacciones from "~DBO~".CUENTAS where Cliente = '"~Val(c:&i)~"' and Estado = 'HAB'  and Numero is Not NULL")
                  dfa
                  If ESPECIECUENTA(Val(r:&i),FBN['Codigo'])
                     ACT(h:&i, FBN['Codigo'])
                     break
                  Endif
               Proximo
            Endif
         Endif
      Endif
   Proximo
   Recorrer&j 1,100
      CrearListBox;'Arial,8,B'
         'Liquida'                  ; k1..k:fac; SI; SI;;60; COMBO; 'Si|No|'
         '# Operacion'              ; a1..a:fac; NO; SI;;80; STRING
         'Fecha'                    ; b1..b:fac; NO; SI;;70; FECHA
         'Entidad'                  ; c1..c:fac; NO; SI;;70; STRING
         'Especie'                  ; d1..d:fac; NO; SI;;70; STRING
         'Cantidad'                 ; e1..e:fac; NO; SI;;100; NUMERO;'###,###,###.##p'
         'Cuenta '~Dialogo.Vehiculo1; f1..f:fac; SI; [NoVacio(Val(CLB:FLB)) y EqStr(Dialogo.Vehiculo1,BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))] o Val(k:FLB)=1; "Error Cuenta "~Dialogo.Vehiculo1; 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
         'Transaccion'              ; g1..g:fac; SI; NoVacio(Val(CLB:FLB)) o Val(k:FLB)=1; "Error Transaccion"              ; 90; TABLA; 'TiposTransaccion';'Codigo';'Codigo;Descripcion';
         'Cuenta Entidad'           ; h1..h:fac; SI; [Incluido(Val(g:FLB),'CREDIT|DEBITO|EMI_CH|COMP') y Vacio(Val(CLB:FLB))] o [Incluido(Val(g:FLB),'TRANSF|C_4090') y [[Val(e:FLB)<0 y NoVacio(Val(CLB:FLB)) y EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))] o [Val(e:FLB)>0 y [Vacio(Val(CLB:FLB)) o EqStr(Val(c:FLB),BuscarCampo('CUENTAS','Cliente','Codigo',Val(CLB:FLB)))]]]] o Val(k:FLB)=1; "Error Cuenta Entidad "~Val(c:FLB); 90; TABLA; 'Cuentas';'Codigo';'Codigo;Nombre';
         'Leyenda'                  ; i1..i:fac; NO; SI;;150; STRING
         'Cta Movimiento'           ; u1..u:fac; NO; SI;;92; STRING
         'I.DN'                     ; v1..v:fac; SI; SI;;20; CHECK
         'C.DN'                     ;vv1..vv:fac;SI; Val(vu:flb)=0 o Val(vv:flb)=0;'Si el pago es con Cheque, se concilia la Orden de Pago';20; CHECK
         'Cheque'                   ;vu1..vu:fac;SI; Val(vu:flb)=0 o Val(vv:flb)=0;'Si el pago es con Cheque, se concilia la Orden de Pago';20; CHECK
         '"PS"'                     ;vw1..vw:fac;SI; SI;;20; CHECK
         'Observaciones'            ; w1..w:fac; SI; SI;;350; STRING;57
      FinListBox
      ** CONDICIONES PARA PODER LIQUIDAR **
      * FILA F: La cuenta no vacia y vehiculo= Cliente de la cuenta y ( transaccion <> CREDIT|DEBIT  o entidad=Comitente de la cuenta)
      * FILA G: Transaccion no vacia
      * FILA H: ( Transaccion=DEBITO|CREDIT|EMI_CH|COMP y cuenta vacia ) o ( Transaccion=TRANSF|C_4090 y ( (cantidad<0 y no vacia la cuenta y entidad=Cliente de la cuenta) o (cantidad>0 y (cuenta vacia o entidad=cliente de la cuenta)) ) )
      If Ok
         * Verifico que liquide en conjunto de NrOp, Fecha, Entidad y Especie
         * ab1: NrOperacion~Fecha~Entidad~Especie

         ACN(ab3,0)
         ACN(ab5,0)

         Recorrer&i 1,FAC
            *If Not EqStr(val(ab1),Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i)) 
            *   ACT(ab1,Val(a:&i)~' '~Val(b:&i)~' '~Val(c:&i)~' '~val(d:&i))
            *   ACN(ab2,Val(k:&i))
            *Else 
            *   If Val(k:&i)<>Val(ab2)
            *      MessageBox('Liquidacion Inconsistente para '~val(ab1))
            *      ACN(ab5,1)
            *   EndIf
            *EndIf                
            If Val(k:&i)=0
               * Selecciono los mov. correctamente, Verifico el resto de las condiciones 
               If Incluido(Val(g:&i),'CREDIT|DEBITO')
                  ACT(h:&i, '')
               Endif
               If Not EqStr(Val(g:&i),'EMI_CH')
                  ACT(j:&i, '')
               Endif
               ACT(x1, Val(q:&i))
               ACT(x2, Pad(Val(g:&i),6)~'    ')
               ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I E')
               If Val(e:&i)>0
                  ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
                  ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
               Endif
               If Val(e:&i)<0
                  ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
                  ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
               Endif
               *Valida Cuenta Propia
               If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(f:&i)),1)
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(f:&i)~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               If Not Incluido(Val(x2),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)),1)
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(f:&i)~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(f:&i)))
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La cuenta '~Val(f:&i)~' no esta habilitada, Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               If Vacio(BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)))
                  ACN(ab3,1)
                  ACN(ab4,0)
                  ACN(ab4,MessageBox('La cuenta '~Val(f:&i)~' no es una cuenta real correspondiente a '~Dialogo.Vehiculo1~', Corrige la Seleccion ? ',2,1))
                  If VAL(ab4)=2
                     Cancelar
                  EndIf 
               Endif
               *Valida Cuenta Entidad
               If NoVacio(Val(h:&i))
                  If Not EqStr(Val(c:&i),BuscarCampo('CUENTAS','Cliente','Codigo',Val(h:&i)))
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La cuenta '~Val(h:&i)~' no corresponde a '~Val(c:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(h:&i)),1)
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(h:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not Incluido(Val(x3),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(h:&i)),1)
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(h:&i)~', Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
                  If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(h:&i)))
                     ACN(ab3,1)
                     ACN(ab4,0)
                     ACN(ab4,MessageBox('La cuenta '~Val(h:&i)~' no esta habilitada, Corrige la Seleccion ? ',2,1))
                     If VAL(ab4)=2
                        Cancelar
                     EndIf 
                  Endif
               Endif
            Endif
         Proximo
         *If Val(ab5)=1
         *ACN(ab4,0)
         *ACN(ab4,MessageBox('Existen Liquidaciones Inconsistentes. Corrige la Seleccion ? ',2,1))
         *If VAL(ab4)=2
         *Cancelar
         *EndIf 
         *Else 
            If Val(ab3)=0
               Break
            EndIf
         *EndIf 
      Else 
         Cancelar 
      EndIf
   Proximo
   If val(ab3)=0 y val(ab5)=0
      Recorrer&i 1,FAC
         If Val(k:&i)=0
            If NO 
             *- Claudia 23.04.2002
             If Incluido(Val(g:&i),'CREDIT|DEBITO')
             ACT(h:&i, '')
             Endif
             If Not EqStr(Val(g:&i),'EMI_CH')
             ACT(j:&i, '')
             Endif
             ACT(x1, Val(q:&i))
             ACT(x2, Pad(Val(g:&i),6)~'    ')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I E')
             If Val(e:&i)>0
             ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
             Endif
             If Val(e:&i)<0
             ACT(x3, Val(x2)~'|'~Pad(Val(g:&i),6)~' I  ')
             ACT(x2, Val(x2)~'|'~Pad(Val(g:&i),6)~'   E')
             Endif
             *Valida Cuenta Propia
             If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(f:&i)),1)
             MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(f:&i))
             ACN(m:&i,1)
             Endif
             If Not Incluido(Val(x2),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(f:&i)),1)
             MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(f:&i))
             ACN(m:&i,1)
             Endif
             If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(f:&i)))
             MessageBox('La cuenta '~Val(f:&i)~' no esta habilitada')
             ACN(m:&i,1)
             Endif
             If Vacio(BuscarCampo('CUENTAS','Numero','Codigo',Val(f:&i)))
             MessageBox('La cuenta '~Val(f:&i)~' no es una cuenta real correspondiente a '~Dialogo.Vehiculo1)
             ACN(m:&i,1)
             Endif
             *Valida Cuenta Entidad
             If NoVacio(Val(h:&i))
             If Not EqStr(Val(c:&i),BuscarCampo('CUENTAS','Cliente','Codigo',Val(h:&i)))
             MessageBox('La cuenta '~Val(h:&i)~' no corresponde a '~Val(c:&i))
             ACN(n:&i,1)
             Endif
             If Not Incluido(Val(x1),BuscarCampo('CUENTAS','Especies','Codigo',Val(h:&i)),1)
             MessageBox('La especie '~Val(x1)~' no esta habilitada para la cuenta '~Val(h:&i))
             ACN(n:&i,1)
             Endif
             If Not Incluido(Val(x3),BuscarCampo('CUENTAS','Transacciones','Codigo',Val(h:&i)),1)
             MessageBox('La Transaccion '~Val(g:&i)~' no esta habilitada para la cuenta '~Val(h:&i))
             ACN(n:&i,1)
             Endif
             If Not EqStr('HAB',BuscarCampo('CUENTAS','Estado','Codigo',Val(h:&i)))
             MessageBox('La cuenta '~Val(h:&i)~' no esta habilitada')
             ACN(n:&i,1)
             Endif
             Endif
            *- Claudia 23.04.2002
           EndIf
            * Verifico que los mov. que esta tomando esten Pendientes
            ACN(o:&i,1) 
            SQL.ADD("Select * from "~DBO~".MOVPENDIENTES M where")
            SQL.ADD("NrSaldo=1 ")
            SQL.ADD("and M.FechaMov <='"~IdxDate(val(b:&i))~"' ")
            SQL.ADD("and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and M.Bits = 'MV' ")
            SQL.ADD("and M.Especie = '"~VAL(r:&i)~"' ")
            SQL.ADD("and M.Cliente = '"~VAL(c:&i)~"' ")
            SQL.ADD("and M.NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
            IF Dialogo.Check1 = 1
                SQL.ADD("and M.NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
            ELSE
                SQL.ADD("and M.NrOperacion='"~VAL(a:&i)~"' ")
            ENDIF
            Recorrer SQL
               Message('Verifico que el Mov. no se haya liquidado Previamente '~val(a:&i)~' '~Fstr(VAL(p:&i),0,0)~' ...' )
               ACN(o:&i,0) 
            Proximo
             
            If val(o:&i)=1
               MessageBox('El Mov. de la Operacion '~val(a:&i)~' Nro. '~Fstr(VAL(p:&i),0,0)~' fue liquidado Previamente por Otro Usuario ....')
            EndIf
            If Val(m:&i)=0 y Val(n:&i)=0 y Val(o:&i)=0
               *----   Genera Voucher de Liquidacion
               ACT(t:&i,GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo',Dialogo.Vehiculo1)))
               ***---El campo Observaciones puede excederse.
               IF Eqstr(Copy(Val(TP:&i), 1, 3), 'MMP')
                   ACT(XX:&i, Copy(Val(W:&i)~' ('~Val(LS:&i)~')', 1, 200))
               ELSE
                   ACT(XX:&i, Copy(Val(W:&i), 1, 200))
               ENDIF
***---Insert
               (.'LIQUIDX1'.)

            Endif
         Endif
      Proximo
   Else
      Cancelar
   Endif
Else
   Cancelar("No Hay Movimientos a Liquidar")
Endif

SetFont(w1..z6,1)
