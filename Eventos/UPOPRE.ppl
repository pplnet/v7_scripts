CrearDialogo
   NrOperacion1 : 'Op' ;;;;;;;;;;;;;;;;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf



Message("Modificando '"~Dialogo.NrOperacion1~"' .....")

ACN(a1,0)

ACN(a1,SQL("SELECT Count(*) FROM "~DBO~".OPERACIONES Where OperacionRef='"~Dialogo.NrOperacion1~"' ") )

If val(a1)<1
   SQL.ADD("UPDATE "~DBO~".OPERACIONES Set Contrato='0' Where NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.NEW
   SQL.EXEC
EndIf

