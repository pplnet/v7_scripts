SQL.ADD(" Select T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, Abs(M.Cantidad) as Cantidad, MA.Codigo CodAsi, ")
SQL.ADD(" CL.Jerarquia, CL.PaisDir, Case when T.Tipotr2 = 'MATCH' Then T.Cuenta3 else T.Cuenta1 end Cuenta1, ")
SQL.ADD(" O.TotalNetoCli1, O.PorDerechoMercado, O.ContraEspecie, O.Mercado4, ")
SQL.ADD(" Case when T.Tipotr2 = 'MATCH' Then T.Cuenta4 else T.Cuenta2 end Cuenta2, ")
SQL.ADD(" O.Cuenta3, Case when T.TipoTr2 = 'MATCH' then T.Especie1 else T.Especie end Especie, ")
SQL.ADD(" O.TipoOp, O.NrOperacion, ")
SQL.ADD(" '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, ")
SQL.ADD(" O.Cliente1 Cliente, Abs(M.Cantidad) ImporteVoucher, M.Especie MonedaLiq, C.Mercado, O.TotalBrutoCli1, O.FechaVto, ")
SQL.ADD(" M.Cuenta, T.Fecha2, T.Fecha1, O.FechaPago, O.FechaOp, O.Cliente1, O.Precio1, O.Plazo, O.Book1, C.CuentaContable2, ")
SQL.ADD(" C.CuentaContable1, CL.CategDepositante, T.Cliente1 ClienteVoucher, O.TotalComisiones Comision, T.TipoTr2, ")
*SQL.ADD(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, Case when O.TipoOp = 'FXC' OR O.TipoOp='FXV' then O.Especie else O.ContraEspecie End Moneda, O.Cupon1, T.Fecha1, T.Fecha2, ME.Netea, ")
SQL.ADD(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, O.ContraEspecie Moneda, O.Cupon1, T.Fecha1, T.Fecha2, ME.Netea, ")
SQL.ADD(" O.CB4, T.Cantidad26 ConceptoLiq, M.Cantidad ImporteMtm, ")
SQL.ADD(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos1 WHEN O.TipoOp ='FXCF' OR O.TipoOp='FXVF' THEN O.TotalAux1 ELSE O.TotalAux2 END as ComisionOp, ")
SQL.ADD(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.ImpGastos2 ELSE O.TotalIva END as IvaComision, ")
SQL.ADD(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalDerechos ELSE O.TotalGastos END DerechoMercado, ")
SQL.ADD(" CASE WHEN O.TipoOp ='DDV' OR O.TipoOp='DDC' THEN O.TotalIva ELSE O.TotalIvaAdi END IvaDerechos, ")
SQL.ADD(" E.Tipo TipoEspecie,TotalBrutoCli3, E.Issuer, E.Alias1 as EspBanTotal, O.Mercado2 MerLiqMon,O.Especie EspecieOp, T.Especie MonedaVou, O.TotalIntereses Interes, ")
SQL.ADD(" MA.TipoAsiento, O.Mercado4 MerNegociacion, M.Cliente CliMov, O.Cliente4 CliCentral, CASE WHEN O.TipoOp in ('DDC','DDV') AND (M.Leyenda like '%IVA Derecho%' OR M.Leyenda like '%Bolsa%' ) THEN 0 ELSE 1 END AS GeneraDerecho, O.FechaVto2, ")
SQL.ADD(" O.Mercado, O.Mercado2, O.Cantidad CantidadOp, M.NrMov, O.CB5,O.RB10")
**++ Gian 22-08-24 issue 7532
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("    INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")       
SQL.ADD("    INNER JOIN "~DBO~".MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
SQL.ADD("    INNER JOIN "~DBO~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV','FXJ'))) ")   
SQL.ADD("    INNER JOIN "~DBO~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
SQL.ADD("    INNER JOIN "~DBO~".CUENTAS C ON M.Cuenta = C.Codigo ")  
SQL.ADD("    INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")  
SQL.ADD("    INNER JOIN dbo.MERCADOS ME ON O.Mercado2 = ME.Codigo ")
SQL.ADD("  Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("   AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
SQL.ADD("   AND T.NrTrans = M.NrTrans2 ")
SQL.ADD("   AND(( M.Especie = O.ContraEspecie) OR (M.Especie=O.Especie AND O.TipoOp IN ('FXC','FXV','FXJ')))")
SQL.ADD("   AND M.NrSaldo = 1 ")
**NrMov= 12 IVA Comisiones en Titulos y MAV
**NrMov= 14 IVA Derechos en Titulos y IVA Gastos en MAV
**NrMov= 16 IVA Derechos en MAV
*SQL.ADD("   AND M.NrMov not in (12,14,16) ")
SQL.ADD("   AND M.NrMov not in (12,14) ")
SQL.ADD("   AND C.Codigo  = M.Cuenta ")
SQL.ADD("   AND O.TipoOp = MA.TipoOp ")
SQL.ADD("   AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILF'))~") ")
SQL.ADD("   AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD("   AND MA.Habilitado = 'SI' ")
**--Comisiones lo contabilizamos en nuevo evento.
*SQL.ADD("   AND (T.Cantidad26<>1 OR T.Cantidad26 is null)")
SQL.ADD("   AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
SQL.ADD("   AND ((T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
SQL.ADD("   AND ((T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(FE:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
If Dialogo.Radio1 = 4
    ***---Todo
    SQL.ADD(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO','TICF','TIVF','FXCF','FXVF','FXK','FXC','FXV','FXJ')) ")
    IF Eqstr(Var('INSTALACIO'),'MLASA')
    ***---MLASA tiene su propia conta de TCOPRI 
        SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV')  ")
    ELSE
        SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
    ENDIF
    SQL.ADD("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ')) ")
     **-**MM
    SQL.ADD(" OR O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
    SQL.ADD(") ")
ELSE
    IF Dialogo.Radio1 = 0
        ***---Securities => Acciones, Titulos y Futuros de Titulos
        SQL.ADD(" AND ((O.TipoOp IN ('TICF','TIVF')) ")
        IF Eqstr(Var('INSTALACIO'),'MLASA')
            ***---MLASA tiene su propia conta de TCOPRI
            SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV')  ")
        ELSE
            SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV','TCOPRI')  ")
        ENDIF
        SQL.ADD("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' '))) ")
    ELSE
        IF Dialogo.Radio1 = 1
            ***---Fx Spot => Canje
            SQL.ADD(" AND O.TipoOp IN ('FXK','FXC','FXV','FXJ')")
        ELSE
            IF Dialogo.Radio1 = 2
                ***---Fx Futuros => Futuros OCT rueda CPC2 contra terceros
                SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
            ELSE
                IF Dialogo.Radio1 = 3
                    ***---MM
                    SQL.ADD(" AND O.TipoOp IN ('MMCO','MMCT','DDV','DDC') ")
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF
