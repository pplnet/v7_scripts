    **Cintia 050225 - Issue 7897
    let &importeMTMTotPos 0
    let &importeMTMTotNeg 0
    let &MTMPosRev 0
    let &MTMNegRev 0
    *let &esNDF Iif(fbn('RB10')=1, SI, NO)
    **Cintia Feb2025 -  7871
    let &signoMTM 1
    IF NOT #ESCP y #ESNDFMER
        let &signoMTM (-1)
    Endif
    
    IF Incluido(fbn('TipoOp'),'FXCF|FXVF')
         let &importeMTMTotPos QUERY(" Select Sum(MTM) from "~DBO~".MTMDIARIO Where NrOperacion = '"~fbn('NrOperacion')~"' and MTM>0  ")
         let &importeMTMTotNeg QUERY(" Select Sum(MTM) from "~DBO~".MTMDIARIO Where NrOperacion = '"~fbn('NrOperacion')~"' and MTM<0 ")
         IF #ESNDFMER
            let &MTMPosRev QUERY(" Select Sum(MTM) from "~DBO~".MTMDIARIO Where NrOperacion = '"~fbn('NrOperacion')~"' and MTM>0 and Fecha<'"~IdxDate(FBN('FechaVto'))~"' ")*&signoMTM
            let &MTMNegRev QUERY(" Select Sum(MTM) from "~DBO~".MTMDIARIO Where NrOperacion = '"~fbn('NrOperacion')~"' and MTM<0 and Fecha<'"~IdxDate(FBN('FechaVto'))~"' ")*&signoMTM
         ENDIF
    ENDIF
     
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    let &codAsi fbn('CodAsi')
    IF Val(CK:1) = 0  
    Message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),'','',Val(NA:1),Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

***---Liquidacion de Titulos
***---Tomamos la cantidad del movimiento y no del voucher, por el caso de liquidaciones parciales
SQL.ADD(" Select T.NrTrans, Abs(M.Cantidad) as ImporteVoucher, M.Especie, O.NrOperacion, O.ContraEspecie, O.TotalGastos, ")
SQL.ADD(" O.Mercado, O.TipoOp, O.TotalNetoCli1, O.TotalBrutoCli1, MA.Codigo CodAsi, O.FechaVto, O.Vehiculo1, O.Cantidad, ")
SQL.ADD(" M.Cuenta, T.Fecha2, T.Fecha1, O.FechaPago, O.FechaOp, O.Cliente1, T.TipoTr2, O.Cupon1, O.TotalCaucion, ")
SQL.ADD(" O.Precio1, O.Plazo, O.Book1, C.CuentaContable2, C.CuentaContable1, CL.CategDepositante, O.PorAforo, ")
SQL.ADD(" T.Cliente1 ClienteVoucher, O.TotalComisiones Comision, T.TipoTr2, ")
SQL.ADD(" O.TotalAux3, O.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, T.Fecha1, T.Fecha2, ME.Netea, E.Tipo TipoEspecie,O.ContraEspecie Moneda, ")
SQL.ADD(" O.CB4, C.Comitente, O.Cliente1 Cliente,O.TotalGastos DerechoMercado,O.TotalIva IvaComision,O.TotalIvaAdi IvaDerechos, O.Precio4, ")
SQL.ADD(" T.Cuenta2, O.TotalBrutoCli3, CASE WHEN O.TipoOp IN ('TICT','TIDE','TICO','TIPO') THEN O.Precio4 ELSE O.Precio1 END PrecioOp, ")
SQL.ADD(" CASE WHEN O.TipoOp = 'TCOPRI' THEN O.Cuenta1 ELSE O.Cuenta2 END CuentaCustodia, '' as Concepto, E.Issuer, E.Alias1 as EspBanTotal,O.Mercado4, O.PorDerechoMercado as PrecioOpEnARP ")
**Cintia 200723 issue 5075
SQL.ADD(" ,T.Cuenta1 as CtaTitCli, O.CB5 ")
 **++ Gian 22-08-24 issue 7532
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("    INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")       
SQL.ADD("    INNER JOIN "~DBO~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion ")   
SQL.ADD("    INNER JOIN "~DBO~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
SQL.ADD("    INNER JOIN "~DBO~".CUENTAS C ON M.Cuenta = C.Codigo ")  
SQL.ADD("    INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")  
SQL.ADD("    INNER JOIN dbo.MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
SQL.ADD("    INNER JOIN dbo.MERCADOS ME ON O.Mercado = ME.Codigo ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
SQL.ADD(" AND T.NrTrans = M.NrTrans2 ")
SQL.ADD(" AND M.Especie = O.Especie ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND C.Codigo  = M.Cuenta ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
**Por tema de demoras hicimos nuevos tipo de asientos de alta y vto para levantar menos registros
**SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASILT')~"' ")
SQL.ADD(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO') AND MA.TipoAsiento = '"~Var('TIPASILTVT')~"' ")
SQL.ADD("            AND ((O.FechaVto = T.Fecha1 AND ((O.CB5=1) OR ME.Netea = 'SI' OR O.Cliente1 = O.Vehiculo1)) OR (O.FechaVto = T.Fecha2 AND(O.CB5 <> 1 OR O.CB5 Is Null) AND(ME.Netea <> 'SI' OR ME.Netea Is Null) AND (O.Cliente1 <> O.Vehiculo1)))) ")
SQL.ADD("       OR (O.TipoOp IN ('TICT','TIDE','TICO','TIPO') AND MA.TipoAsiento = '"~Var('TIPASILTAL')~"' ")
SQL.ADD("            AND ((O.FechaOp = T.Fecha1 AND ((O.CB5=1) OR ME.Netea = 'SI' OR O.Cliente1 = O.Vehiculo1)) OR (O.FechaOp = T.Fecha2 AND(O.CB5 <> 1 OR O.CB5 Is Null) AND(ME.Netea <> 'SI' OR ME.Netea Is Null) AND (O.Cliente1 <> O.Vehiculo1)))) ")
SQL.ADD(" OR (O.TipoOp NOT IN ('TICT','TIDE','TICO','TIPO') AND  MA.TipoAsiento = '"~Var('TIPASILT')~"')) ")
*****
SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
SQL.ADD("   AND ((T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
SQL.ADD("   AND ((T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(FE:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
If Dialogo.Radio1 = 4
    ***---Todo
    SQL.ADD(" AND ((O.TipoOp IN ('FXCF','FXVF','FXK')) ")
    IF Eqstr(Var('INSTALACIO'),'MLASA')
        ***---MLASA tiene su propia conta de TCOPRI
        SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO')  ")
    ELSE
        SQL.ADD("   OR (O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO','TCOPRI')  ")
    ENDIF
    SQL.ADD("       AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ')) ")
    ***---FX FUT: solo terceros y CPC2
    SQL.ADD("   OR (O.TipoOp IN ('FXOCTC','FXOCTV') AND O.Cliente1 Not IN ("~Pipe2Comillas(Val(CM:1))~") AND O.UDN2 IN ("~Pipe2Comillas(Val(RG:1))~"))) ")
ELSE
    IF Dialogo.Radio1 = 0
        ***---Securities => Acciones, Titulos y Futuros de Titulos
        IF Eqstr(Var('INSTALACIO'),'MLASA')
            ***---MLASA tiene su propia conta de TCOPRI
            SQL.ADD(" AND O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO') ")
        ELSE
            SQL.ADD(" AND O.TipoOp IN ('TIC','TIV','TICT','TIDE','TICO','TIPO','TCOPRI') ")
        ENDIF
        SQL.ADD(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
    ELSE
        IF Dialogo.Radio1 = 1
            ***---Fx Spot => Canje
            SQL.ADD(" AND O.TipoOp IN ('FXK')")
        ELSE
            IF Dialogo.Radio1 = 2
            ***---Fx Futuros => Futuros OCT rueda CPC2 contra terceros
            SQL.ADD(" AND O.TipoOp IN ('FXOCTC','FXOCTV','FXCF','FXVF') ")
                SQL.ADD(" AND O.Cliente1 Not IN ("~Pipe2Comillas(Val(CM:1))~") ")
                SQL.ADD(" AND O.UDN2 IN ("~Pipe2Comillas(Val(RG:1))~") ")
            ELSE
                IF Dialogo.Radio1 = 3
                    ***---MM
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF
IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 4
    ***---Futuro de Titulos
    SQL.ADD(" UNION ")
    SQL.ADD(" Select T.NrTrans, Abs(M.Cantidad) as ImporteVoucher, M.Especie, O2.NrOperacion, O2.ContraEspecie, O2.TotalGastos, ")
    SQL.ADD(" O2.Mercado, O2.TipoOp, O2.TotalNetoCli1, O2.TotalBrutoCli1, MA.Codigo CodAsi, O2.FechaVto, O2.Vehiculo1, O2.Cantidad, ")
    SQL.ADD(" M.Cuenta, T.Fecha2, T.Fecha1, O2.FechaPago, O2.FechaOp, O2.Cliente1, T.TipoTr2, O2.Cupon1, O2.TotalCaucion, ")
    SQL.ADD(" O2.Precio1, O2.Plazo, O2.Book1, C.CuentaContable2, C.CuentaContable1, CL.CategDepositante, O2.PorAforo, ")
    SQL.ADD(" T.Cliente1 ClienteVoucher, O2.TotalComisiones Comision, T.TipoTr2, ")
    SQL.ADD(" O2.TotalAux3, O2.TotalAux4, E.Tipo, E.MonedaEmision, E.Cotiza, T.Fecha1, T.Fecha2, ME.Netea, E.Tipo TipoEspecie,O.ContraEspecie Moneda, ")
    SQL.ADD(" O.CB4, C.Comitente, O.Cliente1 Cliente,O.TotalGastos DerechoMercado,O.TotalIva IvaComision,O.TotalIvaAdi IvaDerechos, O.Precio4, ")
    SQL.ADD(" T.Cuenta2, O.TotalBrutoCli3, CASE WHEN O.TipoOp IN ('TICT','TIDE','TICO','TIPO') THEN O.Precio4 ELSE O.Precio1 END PrecioOp, ")
    SQL.ADD(" O.Cuenta2 as CuentaCustodia, '' as Concepto, E.Issuer, E.Alias1 as EspBanTotal, O.Mercado4, O.PorDerechoMercado as PrecioOpEnARP ")
    **Cintia 200723 issue 5075
    SQL.ADD(" ,T.Cuenta1 as CtaTitCli, O.CB5 ")
    **++ Gian 22-08-24 issue 7532
    SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
    SQL.ADD("    INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")       
    SQL.ADD("    INNER JOIN "~DBO~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion ")   
    SQL.ADD("    INNER JOIN "~DBO~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
    SQL.ADD("    INNER JOIN "~DBO~".CUENTAS C ON M.Cuenta = C.Codigo ")  
    SQL.ADD("    INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")  
    SQL.ADD("    INNER JOIN dbo.OPERACIONES O2 ON O.OperacionRef = O2.NrOperacion ")
    SQL.ADD("    INNER JOIN dbo.MODELOSASIENTO MA ON MA.TipoOp = O2.TipoOp ")
    SQL.ADD("    INNER JOIN dbo.MERCADOS ME ON O.Mercado2 = ME.Codigo ")
    SQL.ADD(" WHERE O.TipoOp IN ('TIFC','TIFV') AND O.PaseCB = 1 ")
    SQL.ADD("   AND O.NrOperacion = M.NrOperacion ")
    SQL.ADD("   AND T.NrTrans = M.NrTrans2 ")
    SQL.ADD("   AND M.Especie = O.Especie ")
    SQL.ADD("   AND M.NrSaldo = 1 ")
    SQL.ADD("   AND C.Codigo  = M.Cuenta ")
    SQL.ADD("   AND O2.TipoOp = MA.TipoOp ")
    SQL.ADD("   AND MA.TipoAsiento = '"~Var('TIPASILT')~"' ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD("   AND MA.Habilitado = 'SI' ")
    SQL.ADD("   AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
    SQL.ADD("   AND ((T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
    SQL.ADD("   AND ((T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(FE:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
ENDIF
Watch(sql.batch)

Recorrer SQL
**++ Gian 22-08-24 issue 7532
    IF Eqstr(fbn('Netea'), 'SI') O fbn('CB5') = 1 O Eqstr(fbn('Cliente'),fbn('Vehiculo1'))
        ACD(FV:1, fbn('Fecha1'))
    ELSE
        ACD(FV:1, fbn('Fecha2'))
    ENDIF
    ACN(RV:1, 0)
    ACN(PR:1,0)
    ACN(PP:99,0)
    ACT(VH:1, fbn('Vehiculo1'))
    If Incluido(fbn('TipoOp'), 'TIPO|TIPP|')
        ACT(MN:99, fbn('Cotiza'))    
    Else
        ACT(MN:99, fbn('ContraEspecie'))    
    EndIf
    ACN(CK:1, 0)
    ACN(RV:1,0)
    ACN(RV:10,0)
    ACT(BK:1, fbn('Book1'))
    **Datos para Interfase
    ACT(FV:2,fbn('FechaVto'))
    **
    let &precioOpEnARP fbn('PrecioOpEnARP')
    IF #HAYREVVTO
        ***---Revaluo por tenencia al vto
        ***---El Cotizador NIIF trae la cotizacion en MonedaEmision, por lo tanto vamos a tomar TipoCambio2
        ***---que es el precio de la operacion en MonedaEmision
        ***---ACN(DF:1, fbn('PrecioME') - PrecioNIIF(fbn('Especie'), PriDeMes(Dialogo.Fecha1,SI)-1, fbn('Book1')))
        ***---No se revalua porque revaluamos por dia 13/12/19
*        ACN(DF:1, fbn('Precio1') - 1.5)
*        IF Not Eqstr(fbn('MonedaEmision'), Val(ML:1))
*            ACT(MN:99, fbn('MonedaEmision'))
*            ACN(DF:1, Val(DF:1) * #TCCONTABLE)
*        ENDIF
*        IF EqStr(fbn('TipoOp'), 'TIC')
*            ACN(RV:1, fbn('Cantidad') * Val(DF:1))
*        ELSE
*            ACN(RV:1, -fbn('Cantidad') * Val(DF:1))
*        ENDIF
    ENDIF
    IF EqStr(fbn('TipoOp'), 'TIV')
        ***---Calculo el Resultado Realizado de la venta. Si la venta está en una partida, tomamos el resultado de la partida,
        ***---sino del PPP 
        ACN(BD:1, 0)
        SQL.ADD(" Select Sum(Cantidad1) RRVTA, Sum(Cantidad*Precio1)/Sum(Cantidad) PPP From "~DBO~".PARTIDAS ")
        SQL.ADD(" Where NrOperacion= '"~fbn('NrOperacion')~"' ")
        Recorrer SQL
            DFA 
            ***---siempre entra al recorrer porque Sum siempre trae un registro, el tema es si es NULL o 0
            If NoVacio(fbn('RRVTA')) O fbn('RRVTA') <> 0 O NoVacio(fbn('PPP')) O fbn('PPP') > 0
                ACN(BD:1, 1)
                ACN(RR:1, fbn('RRVTA'))
                ACN(PP:99, fbn('PPP'))
            EndIf
        Proximo
        IF Val(BD:1) = 0
            ***---Busco el PPP de la posicion en ARP
            ACT(ES:1, fbn('Especie'))
            ACD(FE:88, Dialogo.Fecha1)
            ACT(BK:1, fbn('Book1'))
            ACT(CU:1, fbn('Cupon1'))
            ACT(CP:99, fbn('Cupon1'))
            *ACN(SL:1, 171)
            (.'PPPCONT'.)
            *Revisar la Moneda
            IF Not Eqstr(fbn('ContraEspecie'), Val(ML:1))
                ACT(MN:99, fbn('ContraEspecie'))
                ACN(PR:1, fbn('Precio1') * #TCCONTABLE)
            ELSE
                ACN(PR:1, fbn('Precio1'))
            ENDIF
            ACN(RR:1, fbn('Cantidad') * (Val(PR:1) - Val(PP:99)))
        ELSE
            IF Not Eqstr(fbn('MonedaEmision'), Val(ML:1))
                ***---El resultado de la partida está en MonedaEmision
                ACT(MN:99, fbn('MonedaEmision'))
                ACN(RR:1, Val(RR:1) * #TCCONTABLE)
                ACN(PP:99, Val(PP:99) * #TCCONTABLE)
            ENDIF
        ENDIF
    ENDIF
    
    IF Incluido(fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|')
        **Precio al inicio
        Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), fbn('FechaOp')-1, fbn('Book1'))
        IF Vacio(&PrecioNIIF)
            ACN(PR:4, 0)
        ELSE
            ACN(PR:4, &PrecioNIIF.PrecioCotizacionDeterminada)
        ENDIF    
    ENDIF 
    
    IF Incluido(fbn('TipoOp'), 'TICT|TIDE|TICO|TIPO|TIC|TIV|') Y #ESLIQVTO
    **Sumo los revaluos desde fechaop hasta dia anterior del vencimiento
        let &fechaOp fbn('FechaOp')
        let &fechaVto fbn('FechaVto')
        let &precioOp fbn('PrecioOp')
        let &especie fbn('Especie')
        let &book fbn('Book1')
        let &cantidad fbn('Cantidad')
        let &monedaDelCotizador fbn('Cotiza')
        let &monedaPrecioOp fbn('ContraEspecie')
        let &monedaDelRevaluo val(ML:1)
        let &plazo fbn('Plazo')
        Recorrer&i fbn('FechaOp'),fbn('FechaVto')-1
                let &fechaRevaluo Fecha(&i)
                (.'REVALOP'.)
                **RV:1 es el importe que debemos contabilizar para la suma de revaluos al vencimiento
                ACN(RV:1,val(RV:1)+&revaluoEnMonReval)
                ACN(RV:10,val(RV:10)+&revaluoEnMonCotizador) 
         Proximo    
  
        **suma de revaluos al vto
        *0*Precio al inicio
*        Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), fbn('FechaOp')-1, fbn('Book1'))
*        IF Vacio(&PrecioNIIF)
*            ACN(PR:1, 0)
*        ELSE
*            ACN(PR:1, &PrecioNIIF.PrecioCotizacionDeterminada)
*        ENDIF
*        If fbn('Plazo') > 0
*            ACN(PR:1, fbn('PrecioOp'))
*            
*            IF Not Eqstr(fbn('ContraEspecie'), fbn('Cotiza'))
*                ACN(PR:1, Val(PR:1) * #TCCONTABCOT)
*            ENDIF
*            ***---Precio Cierre NIIF
*            Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1-1, fbn('Book1'))
*            IF Vacio(&PrecioNIIF)
*                ACN(PR:2, 0)
*            ELSE
*                ACN(PR:2, &PrecioNIIF.PrecioCotizacionDeterminada)
*            ENDIF
*            ACN(DF:1, Val(PR:2) - Val(PR:1))
*            ACN(RV:10, fbn('Cantidad') * Val(DF:1))
*            IF Not Eqstr(fbn('Cotiza'), Val(ML:1))
*                ACT(MN:99, fbn('Cotiza'))
*                ACN(DF:1, Val(DF:1) * #TCCONTABLE)
*            ENDIF
*            ***---Revaluo Capital menos Aforo
*            ***---ACN(RV:1, (fbn('Cantidad') - (fbn('Cantidad')*fbn('PorAforo')/100)) * Val(DF:1))
*            ***---Por ahora para STD/BIND no se tiene en cuenta en aforo
*            ACN(RV:1, fbn('Cantidad') * Val(DF:1))  
*        Else
*            ACN(RV:10,0)
*            ACN(RV:1,0)
*        EndIf
        *-Suma de Devengados Contabilizados para la operacion
        SQL.ADD("select SUM(Cantidad1) DevCont from ASIENTOSCON1 A1, ASIENTOSCON A ")
        SQL.ADD("where A1.NrUnicoAsiento=A.NrUnicoAsiento ")
        SQL.ADD("and A.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD("and A1.NrItem=1 ")
        SQL.ADD("and (A.NrAsiento = ''  or A.NrAsiento is NULL) ")
        SQL.ADD("and A.Modelo in (Select Codigo from MODELOSASIENTO where TipoAsiento IN ("~Pipe2Comillas(Var('TIPASDEV'))~")) ")
        watch(sql.batch)
        Recorrer SQL
            ACN(DC:1, fbn('DevCont'))
        Proximo
    EndIf
    IF Incluido(fbn('TipoOp'), 'TIPP|TIPA')
        ACD(FV:2, PriDeMes(Dialogo.Fecha1, SI)-1)
        ***---PrecioNIIF a Fecha Valor
        ***---ACN(PF:1, PrecioNIIF(fbn('Especie'), Val(FV:1), fbn('Book1')))
        ACN(PF:1, CotizacionC(fbn('Especie'),,,,Val(FV:1),1,SI,fbn('MonedaEmision')))
        IF Not Eqstr(fbn('MonedaEmision'), Val(ML:1))
            ACT(MN:99, fbn('MonedaEmision'))
            ACN(PF:1, Val(PF:1) * #TCCONTABLE)
        ENDIF
        IF fbn('FechaOp') > Val(FV:2)
            ***---Pase del primer mes
            ACN(PR:1, fbn('Precio1'))
            IF Not Eqstr(fbn('ContraEspecie'), Val(ML:1))
                ACT(MN:99, fbn('ContraEspecie'))
                ACN(PR:1, fbn('Precio1') * #TCCONTABLE)
            ENDIF
            ***---Precio de la operacion contra Precio a FechaLiq
            ACN(DF:1, Val(PR:1) - Val(PF:1))
        ELSE
            ***---Pase de meses anteriores
            ***---ACN(PR:1, PrecioNIIF(fbn('Especie'), Val(FV:2), fbn('Book1')))
            ***---Llamo a CotizacionC hasta que este listo el ValuadorNIIF
            ACN(PR:1, CotizacionC(fbn('Especie'),,,,Val(FV:2),1,SI,fbn('MonedaEmision')))
            IF Not Eqstr(fbn('MonedaEmision'), Val(ML:1))
                ACT(MN:99, fbn('MonedaEmision'))
                ACN(PR:1, Val(PR:1) * #TCCONTABLE)
            ENDIF
            ***---Precio a Fin Mes anterior contra Precio a FechaLiq
            ACN(DF:1, Val(PR:1) - Val(PF:1))
        ENDIF
        ***---VN sin Aforo
        ACN(NF:1, fbn('Cantidad') - (fbn('Cantidad')*fbn('PorAforo')/100))
        ***---VN del aforo
        ACN(NF:2, fbn('Cantidad')*fbn('PorAforo')/100)
        ***---Valuacion del Capital sin aforo
        ACN(VL:1, Val(NF:1) * Val(PR:1))
        ***---Revaluo del Capital sin Aforo
        ACN(RV:1, Val(NF:1) * Val(DF:1))
        ***---Valuacion del Aforo
        ACN(VL:2, Val(NF:2) * Val(PR:1))
        ***---Revaluo del Aforo
        ACN(RV:2, Val(NF:2) * Val(DF:1))
        ***---Devengados desde ppio de mes
        SQL.ADD(" Select Sum(Monto) Monto, Especie ")
        SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" And NrSaldo = 140 ")
        SQL.ADD(" And TipoDevengado = 'INTLEN' ")
        SQL.ADD(" AND Fecha > '"~IdxDate(Val(FV:2))~"' ")
        SQL.ADD(" Group By Especie ")
        Recorrer SQL
            DFA
            ACN(DV:1, fbn('Monto'))
            IF Not Eqstr(fbn('Especie'), Val(ML:1))
                ACT(MN:99, fbn('Especie'))
                ACN(DV:1, Val(DV:1) * #TCCONTABLE)
            ENDIF
        Proximo
        ***---Devengados anteriores
        SQL.ADD(" Select Sum(Monto) Monto, Especie ")
        SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
        SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" And NrSaldo = 140 ")
        SQL.ADD(" And TipoDevengado = 'INTLEN' ")
        SQL.ADD(" AND Fecha <= '"~IdxDate(Val(FV:2))~"' ")
        SQL.ADD(" Group By Especie ")
        Recorrer SQL
            DFA
            ACN(DV:2, fbn('Monto'))
            IF Not Eqstr(fbn('Especie'), Val(ML:1))
                ACT(MN:99, fbn('Especie'))
                ACN(DV:2, Val(DV:1) * #TCCONTABLE)
            ENDIF
        Proximo
    ENDIF
    IF Incluido(fbn('TipoOp'), 'TIC|TIV|')
        *Me fijo si hay Books que usan partidas
        let &bookPartidas ''
        (.'BOOKPARTID'.)
        Recorrer SQL
            let &bookPartidas &bookPartidas~fbn('Books')
        Proximo
        
        ACD(FV:3,Val(fv:1))
        **Reversa de Revaluo de Op Vigentes O Vencidas pero no Liquidadas (se liquidaron ahora)
        ACT(TA:1, Var('TIPASIRETO'))
        SQL.ADD(" Select FechaValor,A1.NrUnicoAsiento ")
        SQL.ADD(" From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M,"~DBO~".ASIENTOSCON1 A1 ")
        SQL.ADD(" Where A.Modelo = M.Codigo ")
        SQL.ADD(" AND A.NrUnicoAsiento = A1.NrUnicoAsiento ")
        SQL.ADD(" AND A.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" And M.TipoAsiento = '"~Val(TA:1)~"'")
        SQL.ADD(" AND A1.Alias2 Not IN ("~Pipe2Comillas(&bookPartidas)~") ")
        SQL.ADD(" AND (A.Estado is NULL OR A.Estado = '' OR A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
        SQL.ADD(" Group By FechaValor,A1.NrUnicoAsiento ")
        Recorrer SQL
            *ACD(FV:3, fbn('FechaValor'))
            ACT(AS:1, fbn('NrUnicoAsiento'))
            ***---Llamo a evento que realiza ContraAsiento
            EjecutarEvento('CONT46', Fecha1=Dialogo.Fecha1, NrUnicoAsiento1=Val(AS:1), Fecha2=Val(FV:3), Radio1=0)
        Proximo
    EndIf
    IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
        ACN(CK:1, 1)
        IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND NrTrans2 = '"~fbn('NrTrans')~"' AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
            ACN(CK:1, 0)
        ENDIF
    ENDIF
    let &codAsi fbn('CodAsi')
    IF Val(CK:1) = 0
        Message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
        SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),'','',Val(NA:1),Val(fv:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
    ENDIF
Proximo

IF Dialogo.Radio1 = 0 O Dialogo.Radio1 = 4
    Message('--- Asientos de Liquidacion Licitaciones---')
    IF Eqstr(Var('INSTALACIO'),'MLASA')
        ACT(TA:1, Var('TIPASILC'))
        ACN(XX:1,0)
        SQL.ADD("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, ")
        SQL.ADD("       Case when T.TipoTr2= 'MATCH' then T.Cantidad2 else T.Cantidad1 end as Cantidad, ")
        SQL.ADD("       MA.Codigo as CodAsi, ")
        SQL.ADD("       C.Jerarquia, C.PaisDir, ")
        SQL.ADD("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado as Precio1, O.ContraEspecie, ")
        SQL.ADD("       T.Cuenta2, T.Especie, C.CategDepositante, ")
        SQL.ADD("       O.TipoOp as TipoOp, ")
        SQL.ADD("       O.NrOperacion, O.FechaOp, O.Corporate as Cartera,")
        SQL.ADD("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
        SQL.ADD("       (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente ")
        SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS MO ")
        SQL.ADD("WHERE O.TipoOp IN ('TCOPRI', 'TCPCEM') ")
        SQL.ADD(" AND O.NrOperacion = MO.NrOperacion ")
        SQL.ADD(" AND T.NrTrans = MO.NrTrans2 ")
        SQL.ADD(" AND  MO.Especie = O.Especie ")
        SQL.ADD(" AND MO.NrSaldo = 1 ")
        SQL.ADD(" AND C.Codigo  = O.Cliente1 ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
        SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASILC')~"' ")
        SQL.ADD(" AND T.TipoTr2 in ('RET','DEP','MATCH') ")
        SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(val(FE:1))~"' ")
        watch(sql.batch)
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACT(NR:1, fbn('NrOperacion'))
          ACT(NR:2, fbn('NrTrans'))
          ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))
          ACN(CO:2, COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,VAR('MONELOCA')))
          ***---(.'GENASIENTO'.)
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrTrans2 = '"~fbn('NrTrans')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo
    ELSE
        ***---Standard. Por ahora TCPCEM de MLASA idem para STD
        ACT(TA:1, Var('TIPASILC'))
        ACN(XX:1,0)
        SQL.ADD("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, ")
        SQL.ADD("       Case when T.TipoTr2= 'MATCH' then T.Cantidad2 else T.Cantidad1 end as Cantidad, ")
        SQL.ADD("       MA.Codigo as CodAsi, ")
        SQL.ADD("       C.Jerarquia, C.PaisDir, ")
        SQL.ADD("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado as Precio1, O.ContraEspecie, ")
        SQL.ADD("       T.Cuenta2, T.Especie, C.CategDepositante, ")
        SQL.ADD("       O.TipoOp as TipoOp, ")
        SQL.ADD("       O.NrOperacion, O.FechaOp, O.Corporate as Cartera,")
        SQL.ADD("       '#Op:' + O.NrOperacion + ',' + rtrim(O.TipoOp) + ',' + rtrim(O.Especie) Leyenda, ")
        SQL.ADD("       (CASE WHEN O.TipoOp = 'TCOPRI' THEN Case When O.Corporate=1 THEN O.Vehiculo1 Else O.Cliente1 End ELSE O.Cliente1 END) as  Cliente ")
        SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS MO ")
        SQL.ADD("WHERE O.TipoOp IN ('TCPCEM') ")
        SQL.ADD(" AND O.NrOperacion = MO.NrOperacion ")
        SQL.ADD(" AND T.NrTrans = MO.NrTrans2 ")
        SQL.ADD(" AND  MO.Especie = O.Especie ")
        SQL.ADD(" AND MO.NrSaldo = 1 ")
        SQL.ADD(" AND C.Codigo  = O.Cliente1 ")
        SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
        SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASILC')~"' ")
        SQL.ADD(" AND T.TipoTr2 in ('RET','DEP','MATCH') ")
        SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
        SQL.ADD(" AND MA.Habilitado = 'SI' ")
        SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(val(FE:1))~"' ")
        watch(sql.batch)
        Recorrer SQL
          ACD(FV:1, fbn('Fecha'))
          ACD(FD:1, Dialogo.Fecha1)
          ACT(VH:1, fbn('Vehiculo1'))
          ACT(TO:1, fbn('CodAsi'))
          ACT(TI:1, fbn('TipoOp'))
          ACT(NR:1, fbn('NrOperacion'))
          ACT(NR:2, fbn('NrTrans'))
          ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))
          ACN(CO:2, COTIZACIONC(fbn('ContraEspecie'),,,,fbn('FechaOp'),25,SI,VAR('MONELOCA')))
          ***---(.'GENASIENTO'.)
          ACN(CK:1, 0)
          IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
              ACN(CK:1, 1)
              IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrTrans2 = '"~fbn('NrTrans')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                  ACN(CK:1, 0)
              ENDIF
          ENDIF
          IF Val(CK:1) = 0
              Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
              SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
              SQL.EXEC
          ENDIF
        Proximo
    ENDIF
    message('--- Asientos de Liquidacion Impuestos ICL ---')
    ACT(TA:1, Var('TIPASICLLI'))
    ACN(XX:1,0)
    SQL.ADD("SELECT *, CASE WHEN LeyendaMov like  'IVA%' THEN Cantidad ELSE 0 END as  IVA, ")
    SQL.ADD("          CASE WHEN LeyendaMov like  'WTH%' THEN cantidad ELSE 0 END as  WTH ")
    SQL.ADD("    from ( ")
    SQL.ADD("SELECT T.NrTrans, T.TipoTr2, T.Fecha2 Fecha, T.Vehiculo1, ")
    SQL.ADD("       Case when T.TipoTr2= 'MATCH' then T.Cantidad2 else T.Cantidad1 end as Cantidad, ")
    SQL.ADD("       MA.Codigo as CodAsi, ")
    SQL.ADD("       C.Jerarquia, C.PaisDir, ")
    SQL.ADD("       T.Cuenta1, O.TotalNetoCli1, O.PorDerechoMercado as Precio1, O.ContraEspecie, ")
    SQL.ADD("       T.Cuenta2, T.Especie, ")
    SQL.ADD("       O.TipoOp as TipoOp, C.CategDepositante, ")
    SQL.ADD("       O.NrOperacion, O.FechaOp, O.Corporate as Cartera,")
    SQL.ADD("       '#Op:' + O.NrOperacion + ',' + RTrim(O.TipoOp) + ',' + RTrim(O.Especie) Leyenda, ")
    SQL.ADD("       O.Cliente2 as  Cliente, MO.Leyenda LeyendaMov ")
    SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS MO ")
    SQL.ADD("WHERE O.TipoOp IN ('CONU') ")
    SQL.ADD(" AND O.NrOperacion = MO.NrOperacion ")
    SQL.ADD(" AND T.NrTrans = MO.NrTrans2 ")
    SQL.ADD(" AND MO.Especie = '"~Var('MONELOCA')~"' ")
    SQL.ADD(" AND MO.NrSaldo = 1 ")
    SQL.ADD(" AND C.Codigo  = O.Cliente2 ")
    SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
    SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASICLLI')~"' ")
    SQL.ADD(" AND T.TipoTr2 in ('RET','DEP','MATCH') ")
    SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND MA.Habilitado = 'SI' ")
    SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND T.Fecha2 >= '"~IdxDate(val(FE:1))~"' ")
    SQL.ADD("  ) as Aux ")
    watch(sql.batch)
    Recorrer SQL
      ACD(FV:1, fbn('Fecha'))
      ACD(FD:1, Dialogo.Fecha1)
      ACT(VH:1, fbn('Vehiculo1'))
      ACT(TO:1, fbn('CodAsi'))
      ACT(TI:1, fbn('TipoOp'))
      ACT(NR:1, fbn('NrOperacion'))
      ACT(NR:2, fbn('NrTrans'))
      *ACN(CO:1, COTIZACIONC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))  
      *ACN(IV:1, fbn('IVA')*Val(CO:1))
      ACN(IV:1, fbn('IVA'))
      *ACN(WT:1, fbn('WTH')*Val(CO:1))
      ACN(WT:1, fbn('WTH'))
      ACN(NT:1,Val(IV:1)+Val(WT:1))
      ***---(.'GENASIENTO'.)
      ACN(CK:1, 0)
      IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
          ACN(CK:1, 1)
          IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrTrans2 = '"~fbn('NrTrans')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
              ACN(CK:1, 0)
          ENDIF
      ENDIF
      IF Val(CK:1) = 0
          Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi'))
          SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,fbn('NrTrans'),,,,,fsys,Dialogo.Fecha1)
          SQL.EXEC
      ENDIF
    Proximo
ENDIF
