MostrarCuadrodeMensajes
CrearDialogo
  Fecha1  : 'Fecha'      ; ; ;;NO;;;;;;FSYS
  String1 : 'Path'       ; ; ;;  ;  ;;;;Var('PATHIMPO')
  String2 : 'Archivo'    ; ; ;;  ;  ;;;;'TASAS.XLS'  
  Check1  : 'Procesa'    ;1;2;;NO;NO;;;;1;
FinDialogo
If Not OK
   Cancelar
EndIf
HojaVisible(SI)

If Not ExisteDirectorio(Var('PATHIMPO'))
   Cancelar('Debe Crear el Directorio '~Var('PATHIMPO'))
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

ACN(x:1, 1000)
*-Excel Indices
ImportarXLS(a:1..f:Val(x:1),aa:1..af:Val(x:1),Dialogo.String1~Dialogo.String2)

If Vacio(val(aa:1))
   Cancelar('No se ha podido recuperar el archivo de Tasas:'~Dialogo.String1~Dialogo.String2)
EndIf

SetFilaActual(1)
Recorrer&i 2,Val(x:1)
  if Vacio(Val(aa:&i))
    ACN(x:2, &i-1)
    Break
  endif

  ** Pongo esto default - No se si se usa
  * PlazoDesde
  ACN(ae:&i, 1)
  * PlazoHasta
  ACN(af:&i, 9999)
  
  ACT(ap:&i,SQL("Select Codigo From "~DBO~".TIPOSTASA Where Codigo = '"~val(aa:&i)~"' "))   
  if Vacio(Val(ap:&i))
    SCN(am:&i, 1)
    ACT(an:&i, 'No existe en TiposTasa')
  endif  

  IF Val(am:&i)=0
    ACT(aq:&i, BuscarCampo('TIPOSTASA','CodigoExterno','Codigo',Val(aa:&i)))
    IF NoVacio(val(aq:&i))
      SCN(am:&i, 1)
      ACT(an:&i, 'Es tasa para ICL')
    endif  
  endif  

  IF Val(am:&i)=0
    ACT(ar:&i, BuscarCampo('TIPOSTASA','EspecieValida','Codigo',Val(aa:&i)))
    IF NoVacio(Val(ar:&i))
      if EqStr(Val(ar:&i),Val(ab:&i))
        ACT(as:&i, 'OK')
      else
        SCN(am:&i, 1)
        ACT(an:&i, 'Especie no es valida')
      endif  
    else
      ACT(as:&i, 'OK')
    endif  
  endif  

proximo
  
SetFilaActual(3)
ACT(a:FAC, 'Importacion de Tasas')
SetFont(a:Fac, 3)
  
SetFilaActual(fac+2)
ACT(a:FAC, 'Fecha: '~Dialogo.Fecha1)
ACT(a:FAC+1, 'Archivo importado: '~Dialogo.String1~Dialogo.String2)
SetFont(a:FAC..a:FAC+1, 2)

SetFilaActual(fac+3)
ACT(a:FAC, 'Tasa')
ACT(b:FAC, 'Moneda')
ACT(c:FAC, 'Fecha')
ACT(d:FAC, 'Valor')
ACT(e:FAC, 'Accion')
ACT(f:FAC, 'Observacion')
SetFont(a:FAC..f:FAC, 2)
AgregarMarco(a:FAC..f:FAC,1,0,Exe('COLOR6'))

if Val(x:2)>1
  Recorrer&i 2,Val(x:2)
    IFA
    
    ACT(a:FAC, Val(aa:&i))
    ACT(b:FAC, Val(ab:&i))
    ACD(c:FAC, Val(ac:&i))
    ACN(d:FAC, Val(ad:&i))
    IF Val(am:&i)=0
      If SQL("SELECT 1 FROM "~DBO~".TASASDIA WHERE TipoTasa='"~Val(aa:&i)~"' and Especie='"~Val(ab:&i)~"' and Fecha='"~IdxDate(Val(ac:&i))~"' and PlazoDesde="~Val(ae:&i)~" and PlazoHasta="~Val(af:&i)~" ")=1
        ACT(e:FAC, 'Update')
        if Dialogo.Check1=1
          SQL.ADD("UPDATE "~DBO~".TASASDIA SET ")
** FJL 03/06/20- Estaba mal. Grababa la fecha en Valor1
*          SQL.ADD("       Valor1 = "~FStr(Val(ac:&i),1,8)~" ")
          SQL.ADD("       Valor1 = "~FStr(Val(ad:&i),1,8)~" ")
          SQL.ADD(" WHERE TipoTasa='"~Val(aa:&i)~"' and Especie='"~Val(ab:&i)~"' and Fecha='"~IdxDate(Val(ac:&i))~"' and PlazoDesde="~Val(ae:&i)~" and PlazoHasta="~Val(af:&i)~" ")
          SQL.NEW
          SQL.EXEC
        Endif
      Else
        ACT(e:FAC, 'Insert')
        if Dialogo.Check1=1
          *- Insertar registro
          SQL.ADD("INSERT INTO "~DBO~".TASASDIA ")
          SQL.ADD("(Fecha, Especie, TipoTasa, PlazoDesde, PlazoHasta, Valor1) ")
          SQL.ADD(" VALUES ('"~IdxDate(val(ac:&i))~"', '"~Val(ab:&i)~"', '"~Val(aa:&i)~"', ")
          SQL.ADD(" "~Fstr(Val(ae:&i),0,0)~", "~Fstr(Val(af:&i),0,0)~", "~Fstr(Val(ad:&i),0,8)~")")
          SQL.NEW
          SQL.EXEC
        Endif
      Endif
    ELSE
      ACT(e:FAC, 'ERROR')
      ACT(f:FAC, Val(an:&i))
    ENDIF
  Proximo
  SetFont(a:FAC-Val(x:2)+2..f:FAC, 1)
  FormatoCeldas(d:FAC-Val(x:2)+2..d:FAC, exe('F8'))

else
  SetFilaActual(fac+2)
  ACT(a:FAC, 'No registros para importar')
  SetFont(a:FAC, 2)
endif

SetFilaActual(fac+2)
ACT(a:FAC, 'Fin Listado')
SetFont(a:FAC, 2)

ACO(1,10)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,20)

LimitesVision(f:fac)
