CrearDialogo
    Fecha1  :     'Fecha Op D'         ;1;1;;;;;;;Fsys-365;
    Fecha2  :     'Fecha Op H'         ;1;2;;;;;;;Fsys;    
    Fecha3  :     'Fecha Vto D'        ;2;1;;;;;;;FSys;
    Fecha4  :     'Fecha Vto H'        ;2;2;;;;;;;FSys+365;
    Especie1:     'Moneda Liquidacion' ;;1;;;;;;;;;;;;
    NrOperacion1: 'Operacion'          ;;;;;;;;;;;;;;" Tipoop in('FXCF','FXVF') and MercadoRB='1' "
FinDialogo

if Not Ok
   Cancelar
endif

ACT(LS:1, VAR('MONNDF'))

SQL.ADD("SELECT O.NrOperacion, O.Cliente1, Especie, O.ContraEspecie, O.ContraEspecie2, O.FechaOp, O.FechaVto, O.FechaVto2, O.TasaEspecie, O.FechaUltCupon, O.Book1, ")   
SQL.ADD("       O.Arancel4, O.Arancel3, O.FechaAltaSisExterno, O.MercadoRB, O.Mercado4, O.EsCaucionado EsHabil, TipoTasa, O.Sector1, O.Sector2, M.Regulado, O.Book2, ")
** FJL 27/03/20 - Se agregan campos para calcular FechaPrecan
SQL.ADD("       O.Plazo2, O.TablaFeriados1 ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".MERCADOS M ")   
SQL.ADD(" WHERE Tipoop in('FXCF','FXVF')")
SQL.ADD("   AND O.Mercado4=M.Codigo ")   
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("   AND NrOperacion='"~Dialogo.NrOperacion1~"'")
Else
   SQL.ADD("   AND (O.FechaOp>="~IdxDate2(Dialogo.Fecha1)~" and O.FechaOp<="~IdxDate2(Dialogo.Fecha2)~")  ")
   SQL.ADD("   AND (O.FechaVto>="~IdxDate2(Dialogo.Fecha3)~" and O.FechaVto<="~IdxDate2(Dialogo.Fecha4)~")  ")
   if NoVacio(Dialogo.Especie1)
      SQL.ADD("   AND TasaEspecie='"~Dialogo.Especie1~"'")
   endif
endif
SQL.ADD(" and MercadoRB='1' ")
SQL.ADD(" ORDER BY Mercado4, FechaVto, NrOperacion ")

* Cantidad de ops
acn(ca:1,0)

Recorrer SQL
    acn(a:fac,0)
    act(b:fac,FBN['NrOperacion'])
    act(c:fac,FBN['Cliente1'])
    act(d:fac,FBN['Especie'])
    act(e:fac,FBN['ContraEspecie'])
    act(z:fac,FBN['ContraEspecie2'])
    act(f:fac,FBN['FechaOp'])
    acd(g:fac,FBN['FechaVto'])
    act(h:fac,FBN['TasaEspecie'])
    act(i:fac,FBN['Mercado4'])
    act(o:fac,FBN['Book1'])
    act(m:fac,FBN['Regulado'])
    acn(p:fac,FBN['FechaAltaSisExterno']-FBN['FechaOp'])
    acd(w:fac,FBN['FechaVto2'])
    acn(x:fac,DifDias(FBN['FechaAltaSisExterno'], FBN['FechaUltCupon'], 'USA', IIF(FBN['Eshabil']=1,SI,NO)))
    acd(ag:fac,FBN['FechaVto'])
    acn(ah:fac,BuscarLista(FBN['TasaEspecie'],Val(ls1))-1)
    acd(bg:fac,FBN['FechaAltaSisExterno'])
    act(bh:fac,FBN['Arancel4'])
    act(bz:fac,FBN['Arancel3'])
    act(bi:fac,FBN['TipoTasa'])
    act(bj:fac,FBN['Sector1'])
    act(bk:fac,FBN['Sector2'])
    act(bo:fac,FBN['Book2'])    
    acd(bl:fac,FBN['FechaUltCupon'])
    
** FJL 27/03/20 - Se agrega FechaPrecan calculada
    ACD(ap:fac, Habiles(fbn['FechaAltaSisExterno'],(fbn['Plazo2'] DIV 24),fbn['TablaFeriados1'],SI))
    scn(ca:1,1)
Proximo

If Val(ca:1)>0 
   **- Armo la lista de las transacciones que puede seleccionar
   CrearListBox ; 'Arial,8,';'Autorizacion Modificacion Futuros'
     'Accion ?'              ;a:1..a:Fac   ;SI;;;40;COMBO;'Autoriza|Rechaza'       
     'Operacion'             ;b:1..b:Fac   ;NO;;;70 ;STRING;;
     'Cliente'               ;c:1..c:Fac   ;NO;;;70 ;STRING;;
     'Especie'               ;d:1..d:Fac   ;NO;;;70 ;STRING;;
     'ContraEspecie'         ;e:1..e:Fac   ;NO;;;70 ;STRING;;
     'Especie Fix'           ;e:1..e:Fac   ;NO;;;70 ;STRING;;       
     'Mercado'               ;i:1..i:Fac   ;NO;;;70 ;STRING;; 
     'Book'                  ;o:1..o:Fac   ;NO;;;60 ;STRING;;       
     'Fecha Op'              ;f:1..f:Fac   ;NO;;;80 ;STRING;;
     'Fecha Vto Original'    ;g:1..g:Fac   ;NO;;;80 ;FECHA;
     'Fecha FIX Original'    ;w:1..w:Fac   ;NO;;;80 ;FECHA;
     'Mon. Liq. Original'    ;h:1..h:Fac   ;NO;;;100 ;STRING;;
     'Pend. F.V.'            ;bg:1..bg:Fac ;NO;;;100 ;FECHA;RGB(180,170,193)
     'Pend. Esp. Fix.'       ;bz:1..bz:Fac ;NO;;;100 ;STRING;;RGB(180,170,193)       
     'Pend. Mon. Liq.'       ;bh:1..bh:Fac ;NO;;;100 ;STRING;;RGB(180,170,193)
     'Pend. Mercado '        ;bi:1..bi:Fac ;NO;;;90 ;STRING;;RGB(180,170,193)
     'Pend. Book '           ;bo:1..bo:Fac ;NO;;;90 ;STRING;;RGB(180,170,193)       
     'Pend. Cta CLI'         ;bj:1..bj:Fac ;NO;;;90 ;STRING;;RGB(180,170,193)
     'Pend. Cta VEH'         ;bk:1..bk:Fac ;NO;;;90 ;STRING;;RGB(180,170,193)       
     'Pend. F.Fix'           ;bl:1..bl:Fac ;NO;;;80 ;FECHA;RGB(180,170,193)
   FinListBox
   IF NOT OK 
     Cancelar
   ENDIF

   If Ok
      **- Recorro las filas para ver cual esta seleccionada
      Recorrer&i 1, FAC
            If Val(a:&i) = 0
               SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
               SQL.ADD("  Set  FechaVto            = FechaAltaSisExterno, ")
               SQL.ADD("       FechaPago           = FechaAltaSisExterno, ")
               SQL.ADD("       FechaVto2           = FechaUltCupon, ")
               SQL.ADD("       Plazo               = "~Val(p:&i)~", ")
               SQL.ADD("       Lotes               = "~Val(x:&i)~", ")
** FJL 27/03/20 - Se agrega FechaPrecan calculada
               SQL.ADD("       FechaPrecan         = "~IdxDate2(Val(ap:&i))~", ")
               SQL.ADD("       FechaAltaSisExterno = null, ")
               SQL.ADD("       FechaUltCupon       = null, ")
               If Not EqStr(Val(m:&i),'SI')               
** FJL 26/03/20 - TasaEspecie y ContraEspecie2 solo se actualizan para NO Regulados
                 SQL.ADD("     TasaEspecie    = Arancel4, ")
                 SQL.ADD("     ContraEspecie2 = Arancel3, ")               
                 SQL.ADD("     Mercado2       = '"~Val(bi:&i)~"', ")
                 SQL.ADD("     Book1          = '"~Val(bo:&i)~"', ")
                 SQL.ADD("     Cuenta4        = '"~Val(bj:&i)~"', ")
                 SQL.ADD("     Cuenta3        = '"~Val(bk:&i)~"', ")
                 SQL.ADD("     Arancel4       = null, ")
                 SQL.ADD("     Arancel3       = null, ")               
                 SQL.ADD("     TipoTasa       = null, ")
                 SQL.ADD("     Book2          = null, ")
                 SQL.ADD("     Sector1        = null, ")
                 SQL.ADD("     Sector2        = null, ")
               Endif               
               SQL.ADD("       MercadoRB    = '0' ")
               SQL.ADD(" WHERE NrOperacion  = '"~val(b:&i)~"'  ")
               SQL.NEW
               SQL.EXEC
               ** Actualizo Movimientos de la operacion
** FJL 26/03/20 - Saco actualiza Movimientos. Generaba movs pendientes por MTM anteriores
**                Falta ver que pasa con los movimientos de Operaciones DF.
*               SQL.ActualizarMovimientos3(val(b:&i),SI,SI,NO,SI,SI)
               SQL.ActualizarMovimientos3(val(b:&i),NO,SI,NO,SI,SI)
               SQL.EXEC
            else
               SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
               SQL.ADD("   SET FechaAltaSisExterno = null, ")
               SQL.ADD("       FechaUltCupon       = null, ")
               SQL.ADD("       Arancel4            = null, ")
               SQL.ADD("       Arancel3            = null, ")
               SQL.ADD("       TipoTasa            = null, ")
               SQL.ADD("       Book2               = null, ")               
               SQL.ADD("       Sector1             = null, ")
               SQL.ADD("       Sector2             = null, ")               
               SQL.ADD("       MercadoRB           = '0' ")
               SQL.ADD(" WHERE NrOperacion         = '"~val(b:&i)~"'  ")
               SQL.NEW
               SQL.EXEC
            Endif
      Proximo
      Messagebox('Fin autorizacion modificacion futuros')
   Endif
Else
  Messagebox('No se encontraron operaciones para autorizar modificaciones')
Endif
