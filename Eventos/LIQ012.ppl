* excodigo -> CONLIA
*- Confirmacion de PreLiquidacion Neteo 
MostrarCuadroDeMensajes
Repetir
  * FJL 5/9/19 - Control de Memoria disponible
  (.'CONTMEM'.)

  HojaVisible(NO)
   CrearDialogo
     Vehiculo1: 'Vehiculo'      ;1;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');
     Fecha1   : 'Fecha  Liq.'   ;1;2;;;;Dialogo.Fecha1<>0 ;'Debe Ingresar una Fecha';NO;FSys;
     Especie1 : 'Especie'       ;2;1;;;;;;;
     Mercado1 : 'Mercado'       ;3;1;;;;NoVacio(Dialogo.Mercado1);'Debe ingresar un Mercado';NO;VAR('MERNETEODE');;;;;" ((NETEA='SI' and EsLiquidacion='SI') or (Codigo in("~Pipe2Comillas(VAR('MERNONET'))~"))) "
     NrTrans1 : 'Transaccion'   ;1; ; ;NO;NO;
     Check1   : 'Desafecta Lim' ;3;2; ;NO;NO;;;;1;
     Check2   : 'Interfase'     ;5;1;1;NO;NO;;;;1;
     Check3   : 'Manual'        ; ; ; ;NO;NO;;;;1;
   FinDialogo
        
   If Not Ok
      Cancelar
   EndIf  
    
   *- Selecciona las Transacciones de la fecha que este en la instancia de 
   *- Preliquidacion (12)

   SQL.ADD(" Select T.Especie, T.Cantidad1, T.Cuenta1, T.NrTrans, T.TipoTr2, T.Vehiculo1, T.Cuenta1, T.Cuenta2, T.Book1,T.Ley4, ")
   SQL.ADD("        T.Especie3 Contraespecie, T.Cliente1, T.Cantidad11, T.Cantidad12, T.Cantidad25, T.Ley3, ")
   SQL.ADD("        E.CodNumCajaValores, E.Nombre ")
   
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T INNER JOIN "~DBO~".OPERACIONESBITS B ON T.NrTrans = B.NrOperacion")
   SQL.ADD("INNER JOIN "~DBO~".ESPECIES E ON T.Especie = E.Codigo")
   
   SQL.ADD(" WHERE T.Mercado1 = '"~Dialogo.Mercado1~"'       and ")
   SQL.ADD("T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' and ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" T.Especie='"~Dialogo.Especie1~"'      and ")
   Endif
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD("  T.Vehiculo1='"~Dialogo.Vehiculo1~"'  and ")
   Endif
   If NoVacio(Dialogo.NrTrans1)
      SQL.ADD(" T.NrTrans='"~Dialogo.NrTrans1~"'      and ")
   Endif
   SQL.ADD("B.NrBit = 12              and                 ")
   SQL.ADD("B.Valor = '1'                                 ")
   
   *   SQL.ADD(" Order By T.NrTrans                           ")
   SQL.ADD(" Order By T.Cliente1, T.Especie, T.Cuenta1, T.NrTrans                           ")
   watch(SQL.BATCH())
   acn(x1,0)
   SetFilaActual(3)
   
   Recorrer SQL
      acn(x1,1)
      ACN(ag:fac, 1)
      ACT(aa:fac, FBN['CodNumCajaValores'])
      ACT(ab:fac, FBN['Especie'])
      ACT(ac:fac, FBN['Nombre'])
      ACN(af:fac, FBN['Cantidad1'])
      ACT(ah:fac, FBN['Cuenta1'])
      ACT(aq:fac, FBN['NrTrans'])
      ACT(ai:fac, FBN['TipoTr2'])
      ACT(aj:fac, FBN['Vehiculo1'])
      ACT(al:fac, FBN['Cuenta2'])
      ACT(ax:fac, FBN['Ley4'])
      ACT(ay:fac, FBN['Cliente1'])
      ACN(aw:fac, FBN['Cantidad11'])
      ACT(bk:fac, FBN['Book1'])
      ACT(am:fac, FBN['ContraEspecie'])
      ACT(an:fac, FBN['Cantidad12'])
      ACT(as:fac, FBN['Cantidad25'])
      ACT(at:fac, FBN['Ley3'])
   Proximo

   If val(x1)=1
      act(y1,Dialogo.Vehiculo1)
      acd(y2,Dialogo.Fecha1)
      act(y3,Dialogo.Especie1)
      ACT(y9,Dialogo.Mercado1)
      ACN(y10,Dialogo.Check1)
      ACN(y11,Dialogo.Check2)
      
      if Dialogo.Check3=1
          CrearDialogo
              Vehiculo1: 'Vehiculo'      ;1;1;;NO;;;;;val(y1);
              Fecha1   : 'Fecha PreLiq.' ;1;2;;NO;;;;;val(y2);
              Especie1 : 'Especie'       ;2;1;;NO;;;;;val(y3);
              Mercado1 : 'Mercado'       ; ;1;;NO;;;;;Val(y9);
              Check1   : 'Desafecta Lim' ; ; ;;NO;;;;;Val(y10);
              Check2   : 'BT'            ;5;1;1;NO;NO;;;;Val(y11);
              ListBox; 'Arial,8,N'; 550; 300
                 'Marca'         ;ag4..ag:fac;  ;;;;45 ;CHECK
                 'Tipo'          ;ai4..ai:fac;NO;;;;45 ;STRING 
                 'Numero'        ;aq4..aq:fac;NO;;;;60 ;STRING
                 'Esp.Nr'        ;aa4..aa:fac;NO;;;;45 ;STRING 
                 'Esp.Alfa'      ;ab4..ab:fac;NO;;;;60 ;STRING
                 'Nombre'        ;ac4..ac:fac;NO;;;;80 ;STRING
                 'Neto'          ;af4..af:fac;NO;;;;90 ;NUMERO;'###,###,###.##'
                 'Cuenta'        ;ah4..ah:fac;NO;;;;60 ;STRING
                 'CtaPropia'     ;al4..al:fac;  ;;;;60 ;STRING
                 'Contraespecie' ;am4..am:fac;  ;;;;60 ;STRING
              FinListBox  
          FinDialogo

          If Not Ok
             Break
          EndIf
      EndIf
      * Fila consolidacion trnsferencia
      acn(bz:2,1)
      * Fila Vouchers
      acn(bz:3,1)
      *- Confirmo los movimientos 
      acn(xx:100,fac)     
      Recorrer&i 4,val(xx:100)
         If val(ag:&i)=1
            *- Chequeo que no se hayan liquidado previamente 
            ACN(vs1,0)

            SQL.ADD(" SELECT 1 as Hay FROM "~DBO~".MOVEJECUTADOS ME ")
            SQL.ADD(" Where ME.NrTrans2='"~Val(aq:&i)~"' and ")
            SQL.ADD(" ME.NrSaldo=1 and ")
            SQL.ADD(" ME.Especie='"~Val(ab:&i)~"' ")

            Recorrer SQL
               ACN(vs1,FBN['Hay'])
            Proximo 

            If val(vs1)=0
               ACT(az:&i, '')

               *- Genera TRANSACCIONES DE ARGENCLEAR  
               ACD(ta39, Dialogo.Fecha1)
               If Not DesciendeDeEspecie(Val(ab:&i),'MONEDA') y Val(af:&i)<>0
                  (.'LIQTRAARGE'.)
               EndIf
               
*               (.'L12PRODEXT'.)

               *- Modifico los movimientos de la operacion
               SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
               SQL.ADD("( Especie, FechaEj, PrecioEj, CallPut, Cliente, Cantidad, ")
               SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, EnteCustodia, ")
               SQL.ADD(" Bits, NrGrupo, FechaEje, Concepto, ")
               SQL.ADD(" NrMov, NrLiq, NrTrans2,Mercado, Book, Cupon) ")
               SQL.ADD("SELECT M.Especie, M.FechaEj, M.PrecioEj, M.CallPut, M.Cliente, M.Cantidad, ")
               SQL.ADD(" M.FechaMov, M.NrOperacion, Cuenta, M.Leyenda, M.NrSaldo-30 , M.EnteCustodia, ")
               SQL.ADD(" M.Bits, M.NrGrupo, FechaEje, M.Concepto, ")
               SQL.ADD(" M.NrMov, M.NrLiq, NrTrans2, Mercado, Book, Cupon ")
               SQL.ADD(" from "~DBO~".MOVEJECUTADOS M ")
               SQL.ADD(" Where M.NrTrans2='"~Val(aq:&i) ~"' ")
               SQL.NEW
               SQL.EXEC

               SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS   ")
               SQL.ADD(" Where Especie= '"~Val(ab:&i)~"' ")
               SQL.ADD(" and NrSaldo = 31 ")
               SQL.ADD(" and NrTrans2='"~Val(aq:&i)~"'  ")
               SQL.NEW
               SQL.EXEC

               If Val(af:&i)=0 o [Incluido(Val(ai:&i),'DEP|RET|') y val(ta39)<Fsys]
                  SQL.ADD(" SELECT distinct M.NrOperacion, M.Especie, O.TipoOp, O.ContraEspecie ")
                  SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
                  SQL.ADD(" Where M.NrOperacion = O.NrOperacion ")
                  SQL.ADD(" and   M.Especie  = '"~Val(ab:&i)~"' ")
                  SQL.ADD(" and   M.NrSaldo  = 1 ")
                  SQL.ADD(" and   M.NrTrans2 = '"~Val(aq:&i)~"' ")

                  Recorrer SQL
                    SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
                    SQL.ADD("  SET RB10        = '1',  ")
                    SQL.ADD("      FechaPrecan = '"~IdxDate(Dialogo.Fecha1)~"' ")  
                    SQL.ADD("Where NrOperacion = '"~fbn['NrOperacion']~"' ")
                    SQL.ADD("  and TipoOp     In ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TCOPRI') ")
                    SQL.NEW
                    SQL.EXEC
                    if Dialogo.Check1=1
                       Message('Actualizando liquidacion de '~fbn['NrOperacion'])
                       ModificarOperacion(fbn['NrOperacion'],0,NO,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,0)
                    endif    
                 Proximo
               Endif
* ------------------------------------------------------------------------------------- *

               * Guardo la ope para chequear si hay pendientes 
               * y cambiar de instancia
               ACT(dc:&i,SQLSET(" SELECT NrOperacion as GuardoOpe FROM "~DBO~".MOVEJECUTADOS ME Where ME.NrTrans2='"~Val(aq:&i)~"'"))
               ACN(XX:99, Elementos(val(dc:&i)))
               
               *- Modifico los movimientos de la TRANSACCION
               SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
               SQL.ADD("( Especie, FechaEj, PrecioEj, CallPut, Cliente, Cantidad, ")
               SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, EnteCustodia, ")
               SQL.ADD(" Bits, NrGrupo, FechaEje, Concepto, ")
               SQL.ADD(" NrMov, NrLiq, NrTrans2,Mercado, Book, Cupon) ")
               SQL.ADD("SELECT M.Especie, M.FechaEj, M.PrecioEj, M.CallPut, M.Cliente, M.Cantidad, ")
               SQL.ADD(" M.FechaMov, M.NrOperacion, Cuenta, M.Leyenda, M.NrSaldo-30 , M.EnteCustodia, ")
               SQL.ADD(" M.Bits, M.NrGrupo, FechaEje, M.Concepto, ")
               SQL.ADD(" M.NrMov, M.NrLiq, NrTrans2, Mercado, Book, Cupon ")
               SQL.ADD(" from "~DBO~".MOVEJECUTADOS M ")
               SQL.ADD(" Where M.NrOperacion='"~Val(aq:&i) ~"' ")
               SQL.NEW
               SQL.EXEC
               SQL.ADD("DELETE from "~DBO~".MOVEJECUTADOS   ")
               SQL.ADD(" Where Especie= '"~Val(ab:&i)~"' ")
               SQL.ADD(" and NrSaldo = 31 ")
               SQL.ADD(" and NrOperacion='"~Val(aq:&i)~"'  ")
               SQL.NEW
               SQL.EXEC

               If Val(ta39)<Fsys y Incluido(Val(ai:&i),'RET|DEP')
                  SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 SET ")
                  SQL.ADD(" FechaConfir = "~idxdate2(FSYS)~", Ley3 = 'Conf.FechaValor' ")
                  IF NoVacio(Val(az:&i))
                     *- En la Transaccion DEP-RET asigno el Nro. de Operacion de Referencia 
                     SQL.ADD(", NrOperacionRef2 = '"~Val(az:&i)~"' ")  
                  Endif
                  SQL.ADD("Where NrTrans = '"~Val(aq:&i)~"' ")
                  SQL.NEW
               Else
                  IF NoVacio(Val(az:&i)) y Incluido(Val(ai:&i),'RET|DEP')
                     SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
                     SQL.ADD("SET NrOperacionRef2 = '"~Val(az:&i)~"' ")  
                     SQL.ADD("Where NrTrans = '"~Val(aq:&i)~"' ")
                     SQL.NEW
                  ELSE   
                     IF Incluido(Val(ai:&i),'COMP')
                        SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 ")
                        SQL.ADD("SET RB2 = '1' ")  
                        SQL.ADD("Where NrTrans = '"~Val(aq:&i)~"' ")
                        SQL.NEW
                        SQL.EXEC
                        SQL.ActualizarMovimientosT2(Val(aq:&i),SI,NO,NO,NO)
                        SQL.EXEC
                    Endif
                  Endif
               Endif
               * Cambio de instancia el Voucher
               ACT(az3,Val(aq:&i))
               ACT(az4,'TRANSACCIONES2')
               * PZ 5/7/2022 para MC invertimos la instancia a la que se manda
               * Podria ser Vacio(Ley4(CPC1))
               if Incluido(val(y9),var('MERCAACMC'))
                  If EqStr(Val(ai:&i),'DEP') y val(ta39)=Fsys
                     ACN(az5,6)
                  ELSE
                     If EqStr(Val(ai:&i),'RET') y val(ta39)=Fsys
                        ACN(az5,3)
                     ELSE
                        ACN(az5,70)
                     ENDIF
                  ENDIF
               else
                  If EqStr(Val(ai:&i),'DEP') y val(ta39)=Fsys
                     ACN(az5,3)
                  ELSE
                     If EqStr(Val(ai:&i),'RET') y val(ta39)=Fsys
                        ACN(az5,6)
                     ELSE
                        ACN(az5,70)
                     ENDIF
                  ENDIF
               endif   
               ACN(az6,12 )
               (.'MODIINSTAN'.)                 
               
*----------------------------               
               Recorrer&j 1,val(XX:99)
                 ACT(bc:&i,ItemLista(val(dc:&i),&j))
                 * Cambio de instancia la Operacion a Terminal si todos los Voucher estan confirmados
                 acn(bd:&i,SQL("SELECT COUNT(1) FROM ( SELECT NrOperacion FROM "~DBO~".MOVEJECUTADOS ME Where NrOperacion='"~val(bc:&i)~"' and ME.NrSaldo=31 UNION ALL SELECT NrOperacion FROM "~DBO~".MOVPENDIENTES ME Where NrOperacion='"~val(bc:&i)~"' and ME.NrSaldo=1) VouPendConf "))
                 If Round(val(bd:&i),0)=Round(0,0)
                    Message('Enviando a terminal')   
                    ACT(az3,Val(bc:&i))
                    ACT(az4,'OPERACIONES')
                    ACN(az5,70)
                    ACN(az6,10)
                    (.'MODIINSTAN'.)
                 endif    
               Proximo
*------------------------------------
               * Transferencia de moneda
               If DesciendeDeEspecie(Val(ab:&i),'MONEDA') y Eqstr(Val(y9),VAR('MERCADOBT'))
                  #ifdef BIND
                    * Parámetros Salida
                    * RR:1  'OK/NOK'  
                    * RR:2  'Mensaje'  

                    * Parámetros entrada
                    * RR:10  'Referencia'  
                    * RR:11  'Sucursal'  
                    * RR:12  'Cuenta(1a7)'    
                    * RR:13  'SubOperacion-Cuenta (9a10)'
                    * RR:14  'Moneda'
                    * RR:15  'Importe'
                    * RR:16  'Observaciones'
                    * RR:17  'Importe a Bloquear'
                    * RR:18  'Importe a Debitar / Acreditar'
                    * RR:19  'Cliente'
                    * RR:20  'Cuenta'
                    * RR:21  'Especie'
                    * RR:22  'Importe Bloqueado'
                    * RR:23  'Importe Debitado / Acreditado'
                    * RR:24  'Tipo operacion'
                    * RR:25  'Mercado'
                    * RR:26  'Tipo Transferencia'
                    * RR:27  'Capital'
                    * RR:28  'Comisiones'
                    * RR:29  'Derechos'
                    * RR:30  'Iva'
                    * RR:31  'Intereses'
                    * RR:32  'Cod Evento (producto)'
                    * RR:33  'Fecha Valor'
                    * RR:34  'Referencia Corte'
                    * RR:35  'Referencia Acciones'
                    * RR:36  'Transaccion'
                    * RR:37  'Fecha Cont'
                    * RR:38  'Modulo' 
                    * RR:39  'Relacion'
                    * RR:40  'Tipo: 1 Resta_Liquidacion/'
                    * RR:41  'Referencia CAMEST'
                    * RR:47  'Capital Accion'
                    * RR:48  'Comisiones Accion'
                    * RR:49  'Derechos Accion'
                    * RR:50  'Iva Accion'
                    * RR:51  'Intereses Accion'
                    * RR:57  'Capital Cupon'
                    * RR:58  'Comisiones Cupon'
                    * RR:59  'Derechos Cupon'
                    * RR:60  'Iva Cupon'
                    * RR:61  'Intereses Cupon'
                    * RR:67  'Capital Camest'
                    * RR:68  'Comisiones Camest'
                    * RR:69  'Derechos Camest'
                    * RR:70  'Iva Camest'
                    * RR:71  'Intereses Camest'

                    * Cliente / Especie / Cuenta / 
                    IF Not Eqstr(val(ay:&i)~val(ab:&i)~val(ah:&i),val(bz:1)) y NoVacio(val(bz:1))
                       *  Interfase Bantotal
                       BorrarCeldas(rr:1..rr:80)
                       ACT(rr:10, Val(bq:val(bz:2)))
                       ACT(rr:12, Copy(Val(bh:val(bz:2)),1,7))
                       ACT(rr:13, Copy(Val(bh:val(bz:2)),9,2))
                       ACN(rr:17, Val(bw:val(bz:2)))
                       ACN(rr:18, Val(bf:val(bz:2)))
                       ACT(rr:19, Val(by:val(bz:2)))
                       ACT(rr:20, Val(bh:val(bz:2)))
                       ACT(rr:21, Val(bb:val(bz:2)))
                       ACT(rr:25, val(y9))
                       ACT(rr:26, 'LIQNET')
*                       ACT(rr:27, '0')
*                       ACT(rr:28, '0')
*                       ACT(rr:29, '0')
*                       ACT(rr:30, '0')
*                       ACT(rr:31, '0')
*                       ACT(rr:32, '0')
                       ACT(rr:27, ABS(val(da:1)))
                       ACT(rr:28, ABS(val(da:2)))
                       ACT(rr:29, ABS(val(da:3)))
                       ACT(rr:30, ABS(val(da:4)))
                       ACT(rr:31, ABS(val(da:5)))
                       ACT(rr:32, val(dz:2))
                       ACT(rr:33, val(y2))
                       
                       if Val(bw:val(bz:2))<>0
                          * Desbloqueo de Saldo
                          ACN(rr:15, ABS(Val(bw:val(bz:2))))
                          if Dialogo.Check2=1
                             (.'DESBSALCTA'.)
                             if Eqstr(Val(rr:1),'OK')
                                acn(rr:22, val(rr:17))
                             endif
                          else
                             act(rr:1,'OK')
                             acn(rr:22, val(rr:17))
                             Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                          endif   
                       else
                          act(rr:1,'OK')
                       endif   
                       (.'GRAVOUCONS'.)
                       If Eqstr(val(rr:1),'OK')
                          if Val(rr:18)<0
                             * Debito de Saldo
                             ACN(rr:15, ABS(Val(rr:18)))
                             ACT(rr:24, 'DB')
                             BorrarCeldas(rr:1..rr:2)
                             if Dialogo.Check2=1
                                (.'DEBISALCTA'.)
                                if Eqstr(Val(rr:1),'OK')
                                   acn(rr:23, val(rr:18))
                                endif
                             else
                                act(rr:1,'OK')
                                acn(rr:23, val(rr:18))
                                Messagebox('Debito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                             endif   
                          else
                          if Val(rr:18)>0
                             * Credito de Saldo
                             ACN(rr:15, ABS(Val(rr:18)))
                                ACT(rr:24, 'CR')
                                BorrarCeldas(rr:1..rr:2)
                                if Dialogo.Check2=1
                                   (.'ACRESALCTA'.)
                                   if Eqstr(Val(rr:1),'OK')
                                      acn(rr:23, val(rr:18))
                                   endif
                                else
                                   act(rr:1,'OK')
                                   acn(rr:23, val(rr:18))
                                   Messagebox('Credito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                                endif   
                             endif                                
                          endif
                       else
                          if Val(rr:18)<0
                             * Debito de Saldo
                             ACT(rr:24, 'DB')
                          else   
                             if Val(rr:18)>0
                                * Credito de Saldo
                                ACT(rr:24, 'CR')
                             endif
                          endif
                       endif
                       If Eqstr(val(rr:1),'OK')
                          Recorrer&j 1,(val(bz:3)-1)
                             if Vacio(Val(bu:&j))
                                Break
                             endif   
                             EjecutarEvento2('ZCONFI', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha1, Cliente1='', Cuenta1='', Especie1='',Vehiculo1=Dialogo.Vehiculo1,Mercado1=Dialogo.Mercado1, NrTrans1=Val(bu:&j), Check1=1)
                             Borrarceldas(bu:&j..bu:&j)
                          Proximo   
                       Endif
                       (.'VOUCONSSTA'.)                      
                       SCN(bz:2,1)   
                       ACN(bz:3,1)   
                       Borrarceldas(da:1..da:5) 
                       Borrarceldas(db:1..db:10)   
                       Borrarceldas(db:999..db:999)   
                       Borrarceldas(dz:1..dz:2)   
                    endif    
                    ACT(bh:val(bz:2), Val(ah:&i))
                    ACT(bq:val(bz:2), val(bq:val(bz:2))~Val(aq:&i)~'|')
                    ACT(by:val(bz:2), Val(ay:&i))
                    ACT(bb:val(bz:2), Val(ab:&i))                       
                    if Eqstr(Val(ai:&i),'RET')
                       SCN(bf:val(bz:2), -Val(af:&i))
                    else
                       SCN(bf:val(bz:2), Val(af:&i))
                    endif   
                    SCN(bw:val(bz:2), Val(aw:&i))
                    * Lista de Vouchers
                    ACT(bu:val(bz:3), Val(aq:&i))
                    (.'L12PRODEXT'.)
                    SCN(bz:3,1)
                    act(bz:1,val(ay:&i)~val(ab:&i)~val(ah:&i))
                 #endif
               Endif    
*------------------------------------               
            EndIf
         EndIf
      Proximo
*-----------------------
      If DesciendeDeEspecie(Val(ab:&i),'MONEDA') y Eqstr(Val(y9),VAR('MERCADOBT'))
         #ifdef BIND
            *  Interfase Bantotal
            BorrarCeldas(rr:1..rr:80)
            ACT(rr:10, Val(bq:val(bz:2)))
            ACT(rr:12, Copy(Val(bh:val(bz:2)),1,7))
            ACT(rr:13, Copy(Val(bh:val(bz:2)),9,2))
            ACN(rr:17, Val(bw:val(bz:2)))
            ACN(rr:18, Val(bf:val(bz:2)))
            ACT(rr:19, Val(by:val(bz:2)))
            ACT(rr:20, Val(bh:val(bz:2)))
            ACT(rr:21, Val(bb:val(bz:2)))
            ACT(rr:25, val(y9))
            ACT(rr:26, 'LIQNET')
*            ACT(rr:27, '0')
*            ACT(rr:28, '0')
*            ACT(rr:29, '0')
*            ACT(rr:30, '0')
*            ACT(rr:31, '0')
*            ACT(rr:32, '0')
            ACT(rr:27, ABS(val(da:1)))
            ACT(rr:28, ABS(val(da:2)))
            ACT(rr:29, ABS(val(da:3)))
            ACT(rr:30, ABS(val(da:4)))
            ACT(rr:31, ABS(val(da:5)))
            ACT(rr:32, val(dz:2))
            ACT(rr:33, val(y2))
            
            if Val(bw:val(bz:2))<>0
               * Desbloqueo de Saldo
               ACN(rr:15, ABS(Val(bw:val(bz:2))))
               if Dialogo.Check2=1
                  (.'DESBSALCTA'.)
                  if Eqstr(Val(rr:1),'OK')
                     acn(rr:22, val(rr:17))
                  endif
               else
                  act(rr:1,'OK')
                  acn(rr:22, val(rr:17))
                  Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
               endif   
            else
               act(rr:1,'OK')
            endif   
            (.'GRAVOUCONS'.)
            If Eqstr(val(rr:1),'OK')
               if Val(rr:18)<0
                  * Debito de Saldo
                  ACN(rr:15, ABS(Val(rr:18)))
                  ACT(rr:24, 'DB')
                  BorrarCeldas(rr:1..rr:2)
                  if Dialogo.Check2=1
                     (.'DEBISALCTA'.)
                     if Eqstr(Val(rr:1),'OK')
                        acn(rr:23, val(rr:18))
                     endif
                  else
                     act(rr:1,'OK')
                     acn(rr:23, val(rr:18))
                     Messagebox('Debito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                  endif   
               else
               if Val(rr:18)>0
                  * Credito de Saldo
                  ACN(rr:15, ABS(Val(rr:18)))
                     ACT(rr:24, 'CR')
                     BorrarCeldas(rr:1..rr:2)
                     if Dialogo.Check2=1
                        (.'ACRESALCTA'.)
                        if Eqstr(Val(rr:1),'OK')
                           acn(rr:23, val(rr:18))
                        endif
                     else
                        act(rr:1,'OK')
                        acn(rr:23, val(rr:18))
                        Messagebox('Credito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                     endif   
                  endif
               endif
            else
            if Val(rr:18)<0
                  * Debito de Saldo
                  ACT(rr:24, 'DB')
               else   
               if Val(rr:18)>0
                     * Credito de Saldo
                     ACT(rr:24, 'CR')
                  endif
               endif
            endif
            If Eqstr(val(rr:1),'OK')
               Recorrer&j 1,(val(bz:3)-1)
                 if Vacio(Val(bu:&j))
                    Break                 
                 endif   
                 EjecutarEvento2('ZCONFI', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha1, Cliente1='', Cuenta1='', Especie1='',Vehiculo1=Dialogo.Vehiculo1,Mercado1=Dialogo.Mercado1, NrTrans1=Val(bu:&j), Check1=1)
                 Borrarceldas(bu:&j..bu:&j)
               Proximo   
            Endif
            (.'VOUCONSSTA'.)                      
            SCN(bz:2,1)   
            ACN(bz:3,1)  
            Borrarceldas(da:1..da:5)   
            Borrarceldas(db:1..db:10)   
            Borrarceldas(db:999..db:999)   
            Borrarceldas(dz:1..dz:2)   
         #endif
      Endif    
*-----------------------      
   Else
      if Dialogo.Check3=1 
         MessageBox('No Hay operaciones a Liquidar para el rango seleccionado')
      endif   
   EndIf
Break
Proximo
