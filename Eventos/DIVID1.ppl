acn(yy:1,0)
SQL.ADD(" Select 1 from "~DBO~".OPERACIONES ")
SQL.ADD(" where TipoOp = 'DIVIDE' ")
SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")   
SQL.ADD(" and Vehiculo1= '"~Dialogo.Vehiculo1~"' ")
IF Dialogo.Radio3 = 1
    SQL.ADD(" AND MB4 = 4 ")
ELSE
    SQL.ADD(" AND MB4 < 4 ")
ENDIF
Recorrer SQL
   acn(yy:1,1)
Proximo

