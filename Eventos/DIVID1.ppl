   Message('La Operacion '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(Z1),0,0)~" AND Tabla='OPERACIONES'") )
