* HojaVisible(SI)
* Compras/Ventas futuras. Modifica Operacion y Actualiza Mov. Posiciones y Saldos.
* Compras/Ventas Spot no Vencidas. Genera una Transaccion de Dividendos
* Repos: Idem Compras/Ventas futuras 
* Posiciones: Genera una Transaccion de Dividendos
* Efectivo Total: Genera una Transaccion de Dividendos
CrearDialogo
  Fecha1     :'F.Posicion' ;1;1;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 <= Fsys ;'Debe Ingresar una Fecha';NO;FSys
  Fecha2     :'F.Pago'     ;1;2;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 <= Fsys y Dialogo.Fecha1 <= Dialogo.Fecha2 ;'Debe Ingresar una Fecha';NO;FSys
  Especie1   :'Especie'    ;2;1;;;  ;[DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y DesciendeDeEspecie(Dialogo.Especie1,'PRIVA') Y Dialogo.Check6=0] O [DesciendeDeEspecie(Dialogo.Especie1,'FONDOS') Y Dialogo.Check6=1] O DesciendeDeEspecie(Dialogo.Especie1,'PREGAR') ;IIF(Dialogo.Check6=0, 'Debe Ingresar una Especie (Titulo Privado)','Debe Ingresar una Especie de Fondos');NO;;;;;; IIF( Dialogo.Check6 = 1 , "Codigo IN ("~pipe2comillas(descendientes('ESPECIES','FONDOS'))~") " )
  Check1     :'Div.Efec.'  ;3;1;;;Dialogo.Check6=0 ;
  Precio1    :'Porc.'      ;3;2;;Dialogo.Check1=1; Dialogo.Check1=1 y Dialogo.Check6=0; Dialogo.Precio1>0 O Dialogo.Check1=0 O Dialogo.Check6=1 ;'El Porcentaje en Efectivo debe ser Positivo';NO;;iif(Dialogo.Check1=0,0,Dialogo.Precio1);;;'###.########'
  Especie2   :'Moneda'     ;4;2;;Dialogo.Check1=1 o [Dialogo.Check6=1 Y Dialogo.Radio1=0 Y Dialogo.Radio3=0];Dialogo.Check1=1 o [Dialogo.Check6=1 Y Dialogo.Radio3=0];[NoVacio(Dialogo.Especie2) y DesciendeDeEspecie(Dialogo.Especie2,'MONEDA')] O [Dialogo.Check1=0 Y Dialogo.Check6=0 Y Vacio(Dialogo.Especie2)];'Debe Ingresar una Moneda';NO;;CotizaEn(Dialogo.Especie1);;;;"Codigo IN ("~pipe2comillas(descendientes('ESPECIES','MONEDA'))~") "
  Precio7    :'Cotizacion' ;5;1;;NO;Dialogo.Check1=1 y Dialogo.Check6=0;;;;;IIF(eqstr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Dialogo.Especie2~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP')/COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP'),COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP')/COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP'));;;'###.########'
  Precio5    :'Tipo Cambio';5;2;;Dialogo.Check1=1 y Dialogo.Check6=0;[Dialogo.Check1=1 y Not Eqstr(Dialogo.Especie2,VAR('MONEEXTR')) ] y Dialogo.Check6=0 ;Dialogo.Check6=1 O Eqstr(Dialogo.Especie2,VAR('MONEEXTR')) o [Dialogo.Precio5<=Dialogo.Precio7*(1+VAR('RPRECIO2')/100) Y Dialogo.Precio5>=Dialogo.Precio7*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Fuera de Rango: '~FSTR(Dialogo.Precio7*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(Dialogo.Precio7*(1+VAR('RPRECIO2')/100),1,7);NO;;;;;'###.########'
  Check2     :'Div.Acc.'   ;6;1;;;Dialogo.Check6=0;[Dialogo.Check1+Dialogo.Check2>0 y Dialogo.Check6=0] O Dialogo.Check6=1;'Debe seleccionar al menos un tipo de Diviendos (Efectivo o Acciones)';NO;
  Precio2    :'Porc.'      ;6;2;;Dialogo.Check2=1;Dialogo.Check6=0;[Dialogo.Precio2>0 O Dialogo.Check2=0] O Dialogo.Check6 =1;'El Porcentaje en Acciones debe ser Positivo';NO;;iif(Dialogo.Check2=0,0,Dialogo.Precio2);;;'###.########'
  Precio6    :'Prec.Accion';7;2;;Dialogo.Check2=1;Dialogo.Check6=0;[Dialogo.Precio6>0 O Dialogo.Check2=0] O Dialogo.Check6 =1;'El Precio de la Accion debe ser positivo'   ;NO;;iif(Dialogo.Check2=0,0,iif(MODI,Dialogo.Precio6,Cotizacion(Dialogo.Especie1,,,,Dialogo.Fecha1-1,1,SI)/(1+Dialogo.Precio2/100)));;;'###.########'
  Check3     :'Revaluo'    ;8;1;;NO;NO
  Precio9    :'Porc.'      ;8;2;;NO;NO;[Dialogo.Precio9>=0 y Dialogo.Check6=0] o Dialogo.Check6=1 ;'El Porcentaje debe ser Positivo';NO;
  Check4     :'Canje'      ;9;1;;NO;NO
  Precio10   :'Porc.'      ;9;2;;NO;NO;[Dialogo.Precio10>=0  y Dialogo.Check6=0] o Dialogo.Check6=1 ;'El Porcentaje debe ser Positivo';NO;
  Precio3    :'Fraccion'   ;10;1;;NO;NO;[Dialogo.Precio3>=0   y Dialogo.Check6=0] o Dialogo.Check6=1 ;'La Fraccion debe ser Positiva';NO;
  Precio4    :'Precio Fr.' ;10;2;;NO;NO;[Dialogo.Precio4>=0 y Dialogo.Check6=0] o Dialogo.Check6=1 ;'El Precio de Fraccion debe ser Positivo';NO;
  Vehiculo1  :'Vehiculo'   ;2 ;2;;  ;  ;NoVacio(Dialogo.Vehiculo1) y Eqstr(BuscarCampo('Vehiculos','TipoVehiculo','Codigo', Dialogo.Vehiculo1) , 'DIV');'Vehiculo Invalido';NO;;;;;; " TipoVehiculo = 'DIV' "
  Cuenta1    :'C.Efectivo' ;11;1;;NO;NO;
  Cuenta2    :'C.Especie'  ;11;1;;NO;NO;
  Cuenta3    :'Cuenta Moneda'     ;6;2;;;Dialogo.Check6=1 Y Dialogo.Radio1=0;Dialogo.Check6=0 O Dialogo.Radio1=1 O Dialogo.Radio3=1 O [CLIENTECUENTA(Dialogo.Vehiculo1,Dialogo.Cuenta3) y ESPECIECUENTA(Dialogo.Especie2,Dialogo.Cuenta3) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo', Dialogo.Cuenta3),'HAB') y NoVacio(Dialogo.Cuenta3)]; 'Cuenta Invalida';NO;;;;;;"Cliente='"~Dialogo.Vehiculo1~"' and Estado = 'HAB' and (Especies Like '%"~Dialogo.Especie2~"%' OR Especies Like '%MONEDA%')"
  Cuenta4    :'Cuenta Fondos'     ;6;2;;;Dialogo.Check6=1 Y [Dialogo.Radio1=1 O Dialogo.Radio3=1];Dialogo.Check6=0 O Dialogo.Radio1=0 O [CLIENTECUENTA(Dialogo.Vehiculo1,Dialogo.Cuenta4) y ESPECIECUENTA(Dialogo.Especie1,Dialogo.Cuenta4) y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo', Dialogo.Cuenta4),'HAB') y NoVacio(Dialogo.Cuenta4)]; 'Cuenta Invalida';NO;;;;;;"Cliente='"~Dialogo.Vehiculo1~"' and Estado = 'HAB' and (Especies Like '%"~Dialogo.Especie1~"%' OR Especies Like '%FONDOS%')"
  Check6     :'DIV FCI'    ;9 ;1;;  ;;;;;
  Radio3     :'Tipo|Posicion|Prestamos' ;9;2;;;Dialogo.Check6=1;Dialogo.Check6 = 0 O Dialogo.Radio3 >=0;'Tipo FCI Invalido';NO;1;;;;
  Radio1     :'Forma Cobro|Efectivo|Ctas.Partes'  ;10;1;;;Dialogo.Check6=1 Y Dialogo.Radio3=0;[Dialogo.Check6=1 y Dialogo.Radio1>=0 Y Dialogo.Radio3=0] o Dialogo.Check6 = 0 O Dialogo.Radio3=1 ;'Debe seleccionar una Formula de Calculo';NO;-1;IIF(Dialogo.Check6 = 0,-1,-1);
  Radio2     :'Ingreso|VN|%' ;;;;;Dialogo.Radio1=1 Y Dialogo.Check6=1 Y Dialogo.Radio3=0;Dialogo.Radio2 >=0 O Dialogo.Radio1 = 0 O Dialogo.Check6 = 0 O Dialogo.Radio3=1;'Seleccione VN o %';NO;;
  Cantidad1  :'Monto';12;1;;;Dialogo.Radio1 = 0  y Dialogo.Check6=1 Y Dialogo.Radio3=0;Dialogo.Cantidad1 > 0 O Dialogo.Radio1 <> 0;'Monto Invalido';NO;;;;;'#,###,###,###.##' ;     
  Cantidad2  :'V.N. / Porc';12;1;;;Dialogo.Radio1 = 1  y Dialogo.Check6=1 Y Dialogo.Radio3=0;Dialogo.Cantidad2 > 0 O Dialogo.Radio1 <> 1;'Porcentaje O VN Invalido';NO;;;;;'#,###,###,###.########' ;          
  Precio11   :'Precio Inicial'   ;10;2;;Dialogo.Radio3=1;Dialogo.Radio3=1 Y Dialogo.Check6=1;Dialogo.Precio11 > 0 O Dialogo.Radio3=0;'Precio Inicial Invalido';NO;;;
  Precio12   :'Precio Final'     ;11;2;;Dialogo.Radio3=1;Dialogo.Radio3=1 Y Dialogo.Check6=1;Dialogo.Precio12 > 0 O Dialogo.Radio3=0;'Precio Final Invalido';NO;;Cotizacion(Dialogo.Especie1,,,,Dialogo.Fecha1,1);
  Book1:     'Book'              ;;;;NO;;;;;Var('BOOKDEF');
FinDialogo

