  Recorrer&k 1,FAC

    ACN(w1,&k)

    IF Incluido(Copy(Val(b:Val(w1)),1,4),'SPOT')
       *** genera transaccion de dividendo
          MessageBox('1....')
       (."GENDIVIDEN".)
    EndIf

    IF Incluido(Copy(Val(b:Val(w1)),1,3),'SAL')
       * Actualiza la Posicion
       ACT(w2,VAL(w2)~",'"~Val(c:Val(w1))~"' " )
       *** genera transaccion de dividendo
        MessageBox('2....')
       (."GENDIVIDEN".)
    EndIf

    IF Incluido(Val(b:Val(w1)),'DSEO')
       Message('Actualiza Opciones ....')

       SQL.ADD("Update "~DBO~".OPERACIONES ")
       SQL.ADD("Set Cantidad      = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
       SQL.ADD("    PrecioEj      = "~Fstr(Val(g:Val(w1)),0,7)~", ")
       SQL.ADD("    TotalAux1     = "~Fstr(Val(h:Val(w1)),0,2)~" ")
       SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
       SQL.NEW

       * Recupero los Valores para guardar la historia     
       ACN(ab1,BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Val(k:Val(w1)) ))
       ACN(ab2,BuscarCampo('OPERACIONES','PrecioEj','NrOperacion',Val(k:Val(w1)) ))
       ACN(ab3,BuscarCampo('OPERACIONES','TotalAux1','NrOperacion',Val(k:Val(w1)) ))
       ACN(ab4,1+SQL("SELECT Max(NrCuota) FROM "~DBO~".CUOTAS Where NrOperacion='"~Val(k:Val(w1))~"' ") )

       SQL.ADD(" INSERT "~DBO~".CUOTAS (NrOperacion,NrCuota,Fecha1,Plazo1,Cantidad1,Precio1,Cantidad2) ")
       SQL.ADD(" Values ")
       SQL.ADD(" ('"~Val(k:Val(w1))~"',"~Fstr(Val(ab4),0,0)~",'"~IdxDate(Dialogo.Fecha1)~"',0,"~Fstr(Val(ab1),0,2)~","~Fstr(Val(ab2),0,7)~","~Fstr(Val(ab3),0,2)~") ")
       SQL.NEW
       SQL.EXEC

       ACT(i3,Val(k:Val(w1)))
       BorrarCeldas(i:1..i:1)
       * Actualizo la Instancia de la Operacion a Supervision
       (.'MODIINSTAN'.)    
    ENDIF

    IF Incluido(Val(b:Val(w1)),'SERA|SERP|SERAV|SERPV')
       Message('Actualiza Opciones ....')
       SQL.ADD("Update "~DBO~".OPERACIONES ")
       SQL.ADD("Set TotalRetenciones="~Fstr(Val(j:Val(w1)),0,2)~",")
       SQL.ADD("    Cantidad      = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
       SQL.ADD("    Precio2       = "~Fstr(Val(g:Val(w1)),0,7)~", ")
       SQL.ADD("    TotalBrutoCli2= "~Fstr(Val(h:Val(w1)),0,2)~", ")
       SQL.ADD("    TotalNetoCli2 = "~Fstr(Val(i:Val(w1)),0,2)~" ")
       SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
       SQL.NEW
       SQL.EXEC

       IF EqStr(VAL(x:Val(w1)),'0')
          *** genera transaccion de dividendo
          (."GENDIVIDEN".)
       ENDIF

       ACT(i3,Val(k:Val(w1)))
       BorrarCeldas(i:1..i:1)
       * Actualizo la Instancia de la Operacion a Supervision
       (.'MODIINSTAN'.)    

       SQL.ActualizarMovimientos2(Val(k:Val(w1)),SI,NO,NO,SI)
       SQL.EXEC
    EndIf

    IF Incluido(Val(b:Val(w1)),'SECT|SECTV|SEVT|SEVTV')
       Message('Actualiza Operaciones a Termino')

       SQL.ADD("Update "~DBO~".OPERACIONES ")
       SQL.ADD("Set Cantidad       = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
       SQL.ADD("    NrOrden = null, ")
       SQL.ADD("    Precio1        = "~Fstr(Val(g:Val(w1)),0,7)~", ")
       SQL.ADD("    TotalBrutoCli1 = "~Fstr(Val(h:Val(w1)),0,2)~", ")
       SQL.ADD("    FechaEx1       ='"~IdxDate(Val(zz2))~"', ")
       SQL.ADD("    TotalNetoCli1  = "~Fstr(Val(i:Val(w1)),0,2)~" ")
       SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
       SQL.NEW
       SQL.EXEC  

       ACT(i3,Val(k:Val(w1)))
       BorrarCeldas(i:1..i:1)
       * Actualizo la Instancia de la Operacion a Supervision
       (.'MODIINSTAN'.)    

       SQL.ActualizarMovimientos2(Val(k:Val(w1)),SI,NO,NO,SI)
       SQL.EXEC

       *** NO GENERA TRANSACCION DE DIVIDENDOS por los TERMINOS
    ENDIF
  Proximo
      MessageBox('3....')
  SetFilaActual(Val(x2)+1)
  MessageBox('Generando los Movimientos de Posiciones  ... ')

  *-- x3: Nro. de Saldo
  ACN(x3,101)

  Recorrer&j 0,1
     MessageBox('4....')
     (."DIVIPOSIC".)

     *-- 110 o 210
     ACN(x3,VAL(X3)+9)
     Recorrer&i 0,3
        ACN(w1,FAC) 
        Message("Procesando Posiciones por Cartera Nro. "~Fstr(val(x3),0,0) )
        MessageBox('5....')
        (."DIVIPOSIC".)
        SCN(x3,1)
     Proximo

     ACN(x3,201)
  Proximo
  ACN(x3,120)
  (."DIVIPOSIC".)
  ACN(x3,130)
  (."DIVIPOSIC".)
