CrearDialogo
  Fecha1      : 'Fecha Desde' ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      : 'Fecha Hasta' ; 2;1;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar una Fecha Hasta';NO;FSys
  Cliente1    : 'Cliente'     ; 3;1;;;;;;
  NrOperacion1: '# Operación' ; 4;1;;;;Vacio(Dialogo.NrOperacion1) o EqStr(BuscarCampo('OPERACIONES','DDJJRequiere','NrOperacion',Dialogo.NrOperacion1),'SI');'Debe ingresar una operacion que requiera DJ';NO;;;;;;"TipoOp in ('TIC','TIV') and IsNull(DDJJRequiere,'')='SI' "
  Check2      : 'Emite'       ; 5;1;;SI;SI;;;;1
  Radio1      : 'Destino|Archivo|Pantalla'; 5;2;;Dialogo.Check2=1;Dialogo.Check2=1;;;;0
  Radio2      : 'Tipo|PDF|Word|Ambos'; 6;2;;Dialogo.Check2=1 y Dialogo.Radio1=0;Dialogo.Check2=1 y Dialogo.Radio1=0;;;;0
  Check1      : 'Porcesa'     ; 6;1;;NO;NO;;;;1
FinDialogo
If Not OK
  Cancelar('Evento Cancelado')
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(y:1, Var('PATHDDJJ'))
ACT(y:2, Var('PATHDJGEN'))

ACT(ba:1, 'CDI')
ACT(ba:2, 'CIL')
ACT(ba:3, 'CIT')
ACT(ba:4, 'DNI')
ACT(ba:5, 'LE')
ACT(ba:6, 'LC')
ACT(ba:7, 'IFI')
ACT(ba:8, 'PAS')
ACT(ba:9, 'CED')
ACT(ba:10, 'PJE')
ACT(ba:11, 'FCI')
ACT(ba:12, 'DEX')
ACT(ba:13, 'FID')
ACT(ba:14, 'EIR')
ACT(ba:15, 'CIE')

ACT(bb:1, 'C.D.I.')
ACT(bb:2, 'CUIL')
ACT(bb:3, 'CUIT')
ACT(bb:4, 'DNI')
ACT(bb:5, 'LE')
ACT(bb:6, 'LC')
ACT(bb:7, 'IFI')
ACT(bb:8, 'Pasaporte')
ACT(bb:9, 'Cedula Mercosur')
ACT(bb:10, 'Pers Jur Extr')
ACT(bb:11, 'Fondo Comun De inv.')
ACT(bb:12, 'Documento Extranjero')
ACT(bb:13, 'Fideicomiso')
ACT(bb:14, 'Nro. Registro IERIC')
ACT(bb:15, 'C.I.E.')

SetFilaActual(1)
ACT(aa:FAC, 'Nombre Templaste DJ')
ACT(ab:FAC, 'Archivo a leer')
ACT(ac:FAC, 'Extension')
ACT(ad:FAC, 'Nombre Archivo Salida')
ACT(ae:FAC, 'Archivo a Generar')
ACT(af:FAC, 'Segundo Archivo')

ACT(ag:FAC, 'Fecha')
ACT(ah:FAC, 'Cliente')
ACT(al:FAC, 'CUIT')

SQL.ADD(" Select * ")
SQL.ADD("From "~DBO~".OPERACIONES ")
if NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("where  NrOperacion = '"~Dialogo.NrOperacion1~"'  ")
else
  SQL.ADD("where FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")  
  EndIf
endif
SQL.ADD(" and DDJJRequiere = 'SI' ")  
SQL.ADD(" order by NrOperacion ")  
Recorrer SQL
  SCN(x:1, 1)
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACT(d:FAC, fbn('Cliente1'))
  ACT(e:FAC, fbn('Especie'))
  ACN(f:FAC, fbn('Cantidad'))
  ACT(g:FAC, fbn('ContraEspecie'))
  ACT(h:FAC, fbn('Mercado'))
  ACT(i:FAC, fbn('DDJJRequiere'))
  ACT(j:FAC, fbn('DDJJCodigo'))
  ACT(k:FAC, fbn('DDJJMercado'))
  ACT(l:FAC, fbn('DDJJTipoCli'))
  ACT(m:FAC, fbn('DDJJTipoEsp'))
  ACT(n:FAC, fbn('DDJJEmitida'))
  ACT(o:FAC, fbn('DDJJPresentada'))
  ACD(p:FAC, fbn('DDJJFechaPres'))
  ACT(q:FAC, fbn('DDJJObservac'))
  ACT(s:FAC, SQLSet("Select Distinct Codigo from "~DBO~".PARAMETROSDDJJ where Mercado='"~Val(k:fac)~"' and TipoCli='"~Val(l:fac)~"' and IsNull(TipoEsp,'')='"~Val(m:fac)~"' "))
proximo
if Val(x:1)=0
  MessageBox('No hay operaciones para emitir')
else
  CrearListBox ; 'Arial,8,';'Seleccione las DDJJ a Emitir'
    'Conf'            ; r:2..r:fac;SI;;;30;CHECK;Exe('COLOR12');;;;;;NO;; 
    'NrOperacion'     ; a:2..a:fac;NO;;;70;STRING;;Exe('COLOR6');
    'TipoOp'          ; b:2..b:fac;NO;;;50;STRING;;Exe('COLOR6');
    'FechaOp'         ; c:2..c:fac;NO;;;80;FECHA;Exe('COLOR6');
    'Cliente'         ; d:2..d:fac;NO;;;80;STRING;;Exe('COLOR6');
    'Especie'         ; e:2..e:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Cantidad'        ; f:2..f:fac;NO;;;100;NUMERO;'####,###,###.##';Exe('COLOR6');
    'Moneda'          ; g:2..g:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Mercado'         ; h:2..h:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Requiere DJ'     ; i:2..i:fac;NO;;;50;STRING;;Exe('COLOR6');
*    'Codigo DJ'       ; j:2..j:fac;NO;;;100;STRING;;Exe('COLOR6');
    'Codigo DJ'       ; j:2..j:fac;SI;Val(r:flb)=0 o Incluido(Val(j:flb),Val(s:flb));'Codigo DDJJ invalido. Linea ('~FStr(flb-1,1,0)~')';100;TABLA ;'PARAMETROSDDJJ';'Codigo';'Codigo;Descripcion';" Mercado='"~Val(k:flb)~"' and TipoCli='"~Val(l:flb)~"' and IsNull(TipoEsp,'')='"~Val(m:flb)~"' ";Exe('COLOR12');
    'Emitida DJ'      ; n:2..n:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Presentada DJ'   ; o:2..o:fac;NO;;;50;STRING;;Exe('COLOR6');
    'F.Pres DJ'       ; p:2..p:fac;NO;;;80;FECHA;Exe('COLOR6');
    'Observac'        ; q:2..q:fac;SI;;;150;STRING;;Exe('COLOR12');
  FinListBox
  If Not Ok
    Cancelar('Evento Cancelado')
  Endif
  Recorrer&i 2,fac
    If Val(r:&i) = 1
      SCN(x:2, 1)
      ACT(t:&i, 'A emitir')
        
      * DDJJ Original
      ACT(aa:&i, SQL("Select Archivo from "~DBO~".PARAMETROSDDJJ where Codigo='"~Val(j:&i)~"' "))
      ACT(ab:&i, Val(y:1)~Val(aa:&i))

      * DDJJ Destino
      * Extension
      ACT(ac:&i, '.docx')
      if Dialogo.Radio1=0 y Dialogo.Radio2=0
        ACT(ac:&i, '.pdf')
      endif
      ACT(ad:&i, 'DDJJ Op '~Val(a:&i)~' Cli '~Val(d:&i)~Val(ac:&i))
      ACT(ae:&i, Val(y:2)~Val(ad:&i))

      * Fecha
*      ACT(ag:&i, Fecha(Val(c:&i)))
      ACT(ag:&i, FStr(Dia(Val(c:&i)),2,0)~' de '~Meses(Mes(Val(c:&i)))~' de '~AnioStr(Val(c:&i)))
      * RazonSocial
      ACT(ah:&i, BuscarCampo('CLIENTES','RazonSocial','Codigo',Val(d:&i)))
      * Inscipcion
      ACT(ai:&i, BuscarCampo('CLIENTES','TipoInscripcion','Codigo',Val(d:&i)))
      recorrer&j 1,15
        if EqStr(Val(ai:&i),Val(ba:&j))
          ACT(aj:&i, Val(bb:&j))
          break
        endif
      proximo
      ACT(ak:&i, BuscarCampo('CLIENTES','CUIT','Codigo',Val(d:&i)))
      ACT(al:&i, Val(aj:&i)~': '~Val(ak:&i))
       
      if Dialogo.Check2=1
        ACT(u:&i, 'Emitida')
        if Dialogo.Radio1=0
          EmitirCarta(val(ab:&i),val(ae:&i),Fecha=Val(ag:&i),Cliente=Val(ah:&i),CUIT=Val(al:&i))
          ACT(u:&i, 'Archivo '~Val(ac:&i))
          if Dialogo.Radio2=2
            * Genracion de archivo con ambos formatos
            ACT(af:&i, Val(y:2)~'DDJJ Op '~Val(a:&i)~' Cli '~Val(d:&i)~'.pdf')
            EmitirCarta(val(ab:&i),val(af:&i),Fecha=Val(ag:&i),Cliente=Val(ah:&i),CUIT=Val(al:&i))
            ACT(u:&i, Val(u:&i)~' / .pdf')
          endif   
        endif   

        if Dialogo.Radio1=1
          EmitirCartaVisible(val(ab:&i),val(ae:&i),Fecha=Val(ag:&i),Cliente=Val(ah:&i),CUIT=Val(al:&i))
          ACT(u:&i, 'Emitida Pantalla')
        endif   
      endif   

      if Dialogo.Check1=1
        ACT(v:&i, 'Update')
        SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
        SQL.ADD("   SET DDJJEmitida = 'SI', ")
        SQL.ADD("       DDJJObservac   = '"~Val(q:&i)~"' ")
        SQL.ADD(" Where NrOperacion    = '"~Val(a:&i)~"' ")
        SQL.NEW
        SQL.EXEC
      endif   
    endif
  proximo
  if Val(x:2)=0
    MessageBox('No se seleccionaron operaciones para marcar como ingresadas')
  endif
endif

