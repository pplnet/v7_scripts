* ESTE EVENTO TOMA LAS OPERACIONES QUE ESTAN EN LA INSTANCIA
* INFORMA a SISTEMA EXTERNO, LAS ENVIA Y LAS PASA A LIQUIDACION (10)
(.'CONECTASIS'.)

SQL.ADD("Select O.NrOperacion, O.TipoOp, O.PaseCB, O.CB10, IsNull(RB6,0) FuenteAlta, ")
SQL.ADD("       O.CB5, O.Rojo, NrExterno, IsNull(NroAltaMAE,'NA') NroAltaMAE, FechaVto, IsNull(FechaEnvAltaSisExterno,0) FechaEnvAltaSE, ")
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
SQL.ADD("       O.Cuenta1, O.Cuenta2, O.Cuenta3, O.Cuenta4, ")
* FJL 26/01/21 - Control de Cuentas Comisiones
SQL.ADD("       O.CB4, O.Cuenta5, O.Cuenta6, O.NrOrden1 ")
SQL.ADD("  from "~DBO~".OPERACIONESBITS OB, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit = 68 ")
SQL.ADD("   and OB.Valor = '1' ")
SQL.ADD(" Order by O.NrOperacion ")
Recorrer SQL
*MessageBox('0 - '~fbn['NrOperacion'])    
  if Eqstr(VAR('INSTALACIO'),'MLASA') y Incluido(FBN['TipoOp'],'TIC|TIV|')
    if FBN['FuenteAlta']=2
      ACT(A1, DealCreateResp(SI, FBN['NrExterno'], FBN['NrOperacion'], FBN['NroAltaMAE'], FBN['FechaVto'], ''))
* FJL 19/12/19 - Se cambia por modificacion respuesta NOK
*      if Eqstr(val(A1),'OK')
      if EqStr(Copy(Val(a:1),1,2),'OK')
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
*        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
        ACT(a:1, 'SI')
        if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV')
          if Vacio(fbn('Cuenta1')) o Vacio(fbn('Cuenta2')) o Vacio(fbn('Cuenta3')) o Vacio(fbn('Cuenta4')) 
            ACT(a:1, 'NO')
          endif
        endif
* FJL 26/01/21 - Control de Cuentas Comisiones
        if Incluido(fbn('TipoOp'),'TIC|TIV') y fbn('CB4')=1 
          if Vacio(fbn('Cuenta5')) o Vacio(fbn('Cuenta6'))
            ACT(a:1, 'NO')
          endif
        endif
        if EqStr(Val(a:1),'SI')
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
        else
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=7)
        endif
      endif   
    else
* FJL - 15/10/19 - Por Raiden III
      if [fbn('FuenteAlta')=0 y fbn('CB5')=1] o fbn('FuenteAlta')=1 o [fbn('FuenteAlta')=4 y NoVacio(FBN['NrOrden1'])]
*MessageBox('2 - '~fbn['NrOperacion']~' - '~FStr(fbn('FechaEnvAltaSE'),1,0))
        if fbn('FechaEnvAltaSE')<=2
*MessageBox('3 - '~fbn['NrOperacion']) 
          EjecutarEvento('INFOSR', NrOperacion1=fbn['NrOperacion'], Check1=1)
        endif   
      else  
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
*        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
        ACT(a:1, 'SI')
        if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV')
          if Vacio(fbn('Cuenta1')) o Vacio(fbn('Cuenta2')) o Vacio(fbn('Cuenta3')) o Vacio(fbn('Cuenta4')) 
            ACT(a:1, 'NO')
          endif
        endif
* FJL 26/01/21 - Control de Cuentas Comisiones
        if Incluido(fbn('TipoOp'),'TIC|TIV') y fbn('CB4')=1 
          if Vacio(fbn('Cuenta5')) o Vacio(fbn('Cuenta6'))
            ACT(a:1, 'NO')
          endif
        endif
        if EqStr(Val(a:1),'SI')
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
        else
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=7)
        endif
      endif   
    endif   
  else
    * No se supone que haya operaciones en esta instancia
* FJL 01/12/20 - Control de Cuentas antes de ir a liquidacion
*    EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
    ACT(a:1, 'SI')
    if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV')
      if Vacio(fbn('Cuenta1')) o Vacio(fbn('Cuenta2')) o Vacio(fbn('Cuenta3')) o Vacio(fbn('Cuenta4')) 
        ACT(a:1, 'NO')
      endif
    endif
* FJL 26/01/21 - Control de Cuentas Comisiones
    if Incluido(fbn('TipoOp'),'TIC|TIV') y fbn('CB4')=1 
      if Vacio(fbn('Cuenta5')) o Vacio(fbn('Cuenta6'))
        ACT(a:1, 'NO')
      endif
    endif
    if EqStr(Val(a:1),'SI')
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=10)
    else
      EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=68, Entero2=7)
    endif
  endif   
Proximo
