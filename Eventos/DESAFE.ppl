*HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'    ;
FinDialogo
if Not OK
  Cancelar
endif
  
*** Busca la Operacion ***
SQL.ADD("Select O.NrOperacion, O.TipoOp, O.NrOperacion2, O.NrOperacion3, O.FechaOp2,          ")
SQL.ADD("       O.CB10, O.NrOperacion4, O.CB5, O.Centro1, O.TotalGanancias, O.RB6,            ")
SQL.ADD("       O.TotalAux1, O.TotalAux2, O.MB6,O.FechaPago  ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where  O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL

  *** desafecto movimientos ***
  SQL.ADD(" DELETE from  "~DBO~".MOVPENDIENTES ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  SQL.ADD(" DELETE from  "~DBO~".MOVEJECUTADOS ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"'  ")
  SQL.NEW

  *** desafecto posicion
  SQL.ADD(" DELETE from  "~DBO~".MOVPOSEJE ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  SQL.ADD(" DELETE from  "~DBO~".MOVPOSPEN ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  *** desafecto posicion
  SQL.ADD(" DELETE from  "~DBO~".MOVCASHFLOW ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  *** desafecto limites ***
  SQL.ADD(" DELETE from  "~DBO~".MOVLIMITES ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  SQL.ADD(" DELETE from  "~DBO~".CUOTAS ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.NEW

  if [Incluido(fbn['TipoOp'],'TICO|TICT|TIDE|TIPO')]
     SQL.ADD(" DELETE from  "~DBO~".COMISIONES2 ")
     SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
  endif
  
  *** desmarca las renovaciones ***
  if [Not Incluido(fbn['TipoOp'],'MMDES|MMFCS|MMFCR|MMFCRI|MMDIVA|MMDCOB')] y NoVacio(fbn['NrOperacion3']) y [Not Incluido(Copy(fbn['TipoOp'],1,2),'FX|TI|')]
     SQL.ADD("Update "~DBO~".OPERACIONES set RB6 = '0' ") 
     SQL.ADD("where NrOperacion = '"~fbn['NrOperacion3']~"'")
     SQL.NEW

     if Vacio(fbn['NrOperacion2'])
        SQL.ADD("Delete "~DBO~".MOVLIMITES ")
        SQL.ADD("where  NrOperacion = '"~fbn['NrOperacion3']~"' ")
        SQL.ADD("  and  Usuario = 'AUTO' ")
        SQL.NEW
     endif
*     RetrocederOperacion(fbn['NrOperacion3'],70,20,NO,NO)
  endif
  
  if [Incluido(fbn['TipoOp'],'FXCF|FXVF')]
     SQL.ADD(" DELETE from  "~DBO~".MTMDIARIO ")
     SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     
     SQL.ADD(" DELETE from  "~DBO~".MOVPOSPENFUT ")
     SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     
     SQL.ADD(" DELETE from  "~DBO~".MOVPOSEJEFUT ")
     SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
     SQL.NEW
     
  endif

  *** desmarca las reinversiones ***
  if [Incluido(fbn['TipoOp'],'MMFCRI')]
     *EjecutarEvento('ANUREI',NrOperacion1=fbn['NrOperacion'])
  endif

  *** desmarca los rescates ***
  if [Incluido(fbn['TipoOp'],'MMFCR')]
     *EjecutarEvento('ANURES',NrOperacion1=fbn['NrOperacion'])
  endif

  *** baja la precancelacion ***
  if Incluido(fbn['TipoOp'],'MMDES') y NoVacio(fbn['NrOperacion3'])
     EjecutarEvento('ANUPRE',NrOperacion1=fbn['NrOperacion3'])
  endif

  *** desmarca las reversas ***
  if [Incluido(fbn['TipoOp'],'FXCS|FXVS|FXCT|FXVT|FXACS|FXAVS|FXACT|FXAVT|FXIMPO|FXEXPO')] y EqStr(fbn['CB10'],'1')

     ACN(yy1, Abs(fbn['TotalGanancias']))

     SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion3 = null ") 
     if Eqstr(fbn['Centro1'],'FXL')
       SQL.ADD(" ,  TotalImpuestos = "~Fstr(val(yy1),0,2)~"      ")
     endif
     if Eqstr(fbn['Centro1'],'DDL')
       SQL.ADD(" , TotalIntereses  = "~Fstr(val(yy1),0,2)~"      ")
     endif
     SQL.ADD("where NrOperacion = '"~fbn['NrOperacion3']~"'      ")
     SQL.NEW

     SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion3 = null ")
     SQL.ADD("  where NrOperacion = '"~fbn['NrOperacion']~"'     ")
     SQL.NEW

  endif
  SQL.EXEC

  *** desafecto limites ***
  if Not Eqstr(Copy(fbn['TipoOp'],1,2),'FX')
    SQL.ADD(" UPDATE  "~DBO~".OPERACIONES ")
    SQL.ADD(" Set     MB6 = '0' ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
  endif
  
  ***Anula Operacion resumen de Altamira
  
  if [Incluido(fbn['TipoOp'],'FXCS|FXVS')] y Eqstr(fbn['MB6'],'2') 
*     RetrocederOperacion(fbn['NrOperacion'],29,30,NO,NO)
  endif

  *** desmarca las compensaciones NDF ***
  if [Incluido(fbn['TipoOp'],'FXCS|FXVS')] y EqStr(fbn['CB5'],'1') y Incluido(fbn['RB6'],'0|1')

     if Eqstr(fbn['RB6'],'0')
       ** cuando se anula la operacion de fixing

       if fbn['FechaPago'] >= Fsys
         ** Pasa operacion ndf a inst. compensacion
         acn(yy1, SQL("Select B.NrBit from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B where O.NrOperacion = '"~fbn['NrOperacion4']~"' and B.NrOperacion = O.NrOperacion and B.Valor = '1' "))

         AvanzarOperacion(fbn['NrOperacion4'],val(yy1),50,NO,NO)
       endif

       SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion4 = null, CB5 = null, NrBajaCV = null,         ") 
       ** le devuelvo los limites de liquidacion antes del fixing
       SQL.ADD(" TotalImpuestos = "~Fstr(Abs(fbn['TotalAux2']),0,2)~", TotalIntereses = IntDevengados2   ")
       SQL.ADD("where NrOperacion = '"~fbn['NrOperacion4']~"'")
       SQL.NEW
       SQL.EXEC

       ModificarOperacion(fbn['NrOperacion4'],0,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,NO,NO,0)

     endif

     SQL.ADD("Update "~DBO~".OPERACIONES set NrOperacion4 = null, NrBajaCV = null ")
     SQL.ADD("  where NrOperacion = '"~fbn['NrOperacion']~"'                      ")
     SQL.NEW
     SQL.EXEC
  endif
  
proximo
