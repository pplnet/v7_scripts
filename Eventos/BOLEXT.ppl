CrearDialogo
  String1     :  "NrBoleto"     ;1;2;;;Vacio(Dialogo.NrOperacion1);;;;;;;;'######'  
  NrOperacion1:  "NrOperacion"  ;2;2;;Vacio(Dialogo.String1);Vacio(Dialogo.String1) Y Dialogo.Check1=0;;;;;;;;;"TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI')"
  NrBOperacion : "Anulada"      ;2;2;;Vacio(Dialogo.String1);Dialogo.Check1=1;;;;;;;;;"TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI')"
  Radio2:        "Salida|Impresora|Pantalla|PDF|Mail";5;2;1;;;Dialogo.Radio2>=0;'Tipo de Salida Invalida.';NO;-1;
  Check1:        "Anulados "    ;4;2;1;;;;;NO;0;
  Cliente1    :  "Cliente  "    ;1;1;;Vacio(Dialogo.String1) y Vacio(Dialogo.NrOperacion1)
  Fecha1      :  "F.Dde.   "    ;2;1;;Vacio(Dialogo.String1) y Vacio(Dialogo.NrOperacion1);;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha2      :  "F.Hta.   "    ;3;1;;Vacio(Dialogo.String1) y Vacio(Dialogo.NrOperacion1);;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
** FJL 11/10/18 - Achico la lista para BofA
*  Lista1      :  "Tipos Op."    ;;;;Vacio(Dialogo.String1) y Vacio(Dialogo.NrOperacion1);;;;;;;'TIC|TIV|TIFC|TIFV|TICO|TIPO|TICT|TIDE|TCOPRI';
  Lista1      :  "Tipos Op."    ;;;;Vacio(Dialogo.String1) y Vacio(Dialogo.NrOperacion1);;;;;;;'TIC|TIV|TCOPRI|TIFC|TIFV|';
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,12,B")

SQL.ADD("SELECT  O.NrOperacion,")
SQL.Add("      O.TipoOp, ")
SQL.Add("      O.UDN2, ")
SQL.Add("      O.CB4, ")
SQL.Add("      O.Cliente1, ")
SQL.Add("       C.RazonSocial, ")
SQL.Add("       C.Direccion, ")
SQL.Add("       C.Localidad, ")
SQL.Add("       C.CodigoPostal, ")
SQL.Add("       C.CUIT, ")
SQL.Add("       C.CondicionIVA, ")
SQL.Add("       C.TipoInscripcion, ")
SQL.Add("       C.Sucursal, ")
SQL.Add("       C.Telefono ")

SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("WHERE  O.Cliente1 = C.Codigo and O.NrOperacion = OB.NrOperacion ")
** FJL 19/04/18 - Issue 2987: Analizado con Alcira Etcheverri - Solo operaciones en Liquidacion o Terminal
*SQL.ADD("       and OB.NrBit = 1 and Valor = '0' ") 
SQL.ADD("       and OB.NrBit in (10,70) and Valor = '1' ") 
If NoVacio(Dialogo.String1) 
** FJL 11/10/18 - No se porque usaba NrOperacion3 TIC-TIV-TCOPRI es NrBoleto. Ver despues el resto
** Y le hago Pad0() por si en el dialogo le ingresan menos caracteres
*   SQL.ADD("    and O.NrOperacion3= '"~Dialogo.String1~"' ")
   SQL.ADD("    and O.NrBoleto= '"~Pad0(Dialogo.String1,8)~"' ")
Else            
  If NoVacio(Dialogo.NrOperacion1)
     SQL.ADD("  and O.NrOperacion= '"~Dialogo.NrOperacion1~"' ")
  Else
     SQL.ADD("  and O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
     If NoVacio(Dialogo.Cliente1)
        SQL.ADD("   and O.Cliente1='"~Dialogo.Cliente1~"'")
     Endif
     If NoVacio(Dialogo.Lista1)
        SQL.ADD("   and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
     Else
** FJL 06/06/18 - Se agrega TCOPRI
        SQL.ADD("   and O.TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI') ")
     Endif
  Endif
Endif
If Dialogo.Check1=1
    SQL.ADD(" UNION ")
    SQL.ADD("SELECT  O.NrOperacion,")
    SQL.Add("      O.TipoOp, ")
    SQL.Add("      O.UDN2, ")  
    SQL.Add("      O.CB4, ") 
    SQL.Add("      O.Cliente1, ")    
    SQL.Add("       C.RazonSocial, ")
    SQL.Add("       C.Direccion, ")
    SQL.Add("       C.Localidad, ")
    SQL.Add("       C.CodigoPostal, ")
    SQL.Add("       C.CUIT, ")
    SQL.Add("       C.CondicionIVA, ")
    SQL.Add("       C.TipoInscripcion, ")
    SQL.Add("       C.Sucursal, ")
    SQL.Add("       C.Telefono ")
    SQL.ADD("FROM   "~DBO~".BOPERACIONES O, "~DBO~".CLIENTES C  ")
    SQL.ADD("WHERE  O.Cliente1 = C.Codigo  ")
    If NoVacio(Dialogo.String1) 
** FJL 11/10/18 - No se porque usaba NrOperacion3 TIC-TIV-TCOPRI es NrBoleto. Ver despues el resto
** Y le hago Pad0() por si en el dialogo le ingresan menos caracteres
*      SQL.ADD("    and O.NrOperacion3= '"~Dialogo.String1~"' ")
      SQL.ADD("    and O.NrBoleto= '"~Pad0(Dialogo.String1,8)~"' ")
    Else            
      If NoVacio(Dialogo.NrBOperacion)
         SQL.ADD("  and O.NrOperacion= '"~Dialogo.NrBOperacion~"' ")
      Else
         SQL.ADD("  and O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
         If NoVacio(Dialogo.Cliente1)
            SQL.ADD("   and O.Cliente1='"~Dialogo.Cliente1~"'")
         Endif
         If NoVacio(Dialogo.Lista1)
            SQL.ADD("   and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
         Else
** FJL 06/06/18 - Se agrega TCOPRI
            SQL.ADD("   and O.TipoOp in ('TIC', 'TIV','TIFV','TIFC','TICO','TIPO','TIDE','TICT','TCOPRI') ")
         Endif
      Endif
    Endif

Endif
SQL.ADD("ORDER BY 1, 2 ")
watch(SQL.BATCH())
Recorrer SQL
 
   scn(a1,1)
** FJL 06/06/18 - Se agrega TCOPRI
** AA  25-02-21 - Incorporar Separacion teniendo en cuenta la Rueda para CPC1

   If (FBN['CB4']=1 o (EQSTR(FBN['Cliente1'],Var('VEHICULO')) y FBN['CB4']=0))  and Incluido(FBN['TipoOp'],'TIC|TIV')
       ACT(az1,'BOLCPC')
       LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='ORIGINAL', Radio2=Dialogo.Radio2)
       LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='DUPLICADO', Radio2=Dialogo.Radio2)
   Else
   if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|TCOPRI')
       ACT(az1,'BOLEXT')
       LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='ORIGINAL', Radio2=Dialogo.Radio2)
       LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='DUPLICADO', Radio2=Dialogo.Radio2)
   else
       if Incluido(FBN['TipoOp'],'TICO|TIPO|TIDE|TICT')
          LinkearHoja('BOCALL', 1, NrOperacion1=fbn['NrOperacion'], String='ORIGINAL', Radio2=Dialogo.Radio2)
          LinkearHoja('BOCALL', 1, NrOperacion1=fbn['NrOperacion'], String='DUPLICADO', Radio2=Dialogo.Radio2)
       else
          ACT(az1,'BOEXTR')
          LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='ORIGINAL', Radio2=Dialogo.Radio2)
          LinkearHoja(Val(az1), 1, NrOperacion1=fbn['NrOperacion'], String='DUPLICADO', Radio2=Dialogo.Radio2)
       endif
   endif
   Endif
