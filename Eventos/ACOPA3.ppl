*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     :'Fecha'      ; 1;1;;NO;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha2     :'H.Concert.' ; 2;1;;NO;NO;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;Dialogo.Fecha1;Dialogo.Fecha1
  
FinDialogo

If Not OK
  Cancelar
EndIf


SQL.ADD("Select O.*,C.Codigo ClienteFPA from "~DBO~".OPA3 O ")
SQL.ADD("             left  join "~DBO~".CLIENTES C ")
SQL.ADD("            on O.IdComitente  = C.NrRofex ")
SQL.ADD("Where  O.Fecha     between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("  and O.Warning <> ''  ")
SQL.ADD("  and O.Procesado=1 ")
SQL.ADD(" Order by  Boleta ")
watch(sql.batch)

Recorrer SQL
   
   ACT(a:fac, FBN['Boleta'])
   ACT(b:fac, FBN['Posicion'])
   ACT(c:fac, SQL("Select Especie From "~DBO~".ESPECIESMERCADOS Where Mercado = '"~VAR('AMBMAE')~"' and Codigo = '"~fbn('Posicion')~"' "))
   ACT(d:fac, FBN['Currency'])
   ACT(e:fac, FBN['SettlCurrency'])
   ACT(f:fac, FBN['OrderId'])
   ACT(g:fac, iif(FBN['IdCpraVta']=1,'Compra','Venta'))
   ACN(h:fac, FBN['Cantidad'] )
   ACN(i:fac, FBN['Precio'] )
   ACT(j:fac, FBN['IdComitente'] )
   ACT(k:fac, FBN['ClienteFPA'] )
   ACD(l:FAC, FBN['Fecha'])
   ACD(m:FAC, FBN['Vto'])
   ACT(n:FAC, FBN['Hora'])
   ACT(o:fac, iif(FBN['Procesado']=1,'Si','No'))
   ACT(p:fac, FBN['NrOperacion'])
   ACT(q:fac, FBN['FechaModificacion'])
   ACT(r:fac, FBN['Warning'])
   
    
    scn(ca:1,1)
Proximo

If Val(ca:1)>0 
   CrearListBox ; 'Arial,8,';'Actualizacion reproceso mensaje'
       'Accion ?'              ;z:1..z:Fac   ;SI;;;60;COMBO;'Ok|Rechaza'
       'Procesado'             ;o:1..o:Fac   ;NO;;;70 ;STRING;;
       'Boleta'                ;a:1..a:Fac   ;NO;;;70 ;STRING;;
       'Especie'               ;b:1..b:Fac   ;NO;;;70 ;STRING;;
       'Especie FPA'           ;c:1..c:Fac   ;NO;;;90;STRING;;
       'IDComitene'            ;j:1..j:Fac   ;NO;;;70 ;STRING;;
       'Cliente FPA'           ;k:1..k:Fac   ;NO;;;70 ;STRING;;       
       'NrOrden'               ;f:1..f:Fac   ;NO;;;70 ;STRING;;
       'TipoOp'                ;g:1..g:Fac   ;NO;;;70 ;STRING;;
       'FechaOp'               ;l:1..l:fac   ;NO;;;70;FECHA;; 
       'FechaVto'              ;m:1..m:fac   ;NO;;;70;FECHA;; 
       'Cantidad'              ;h:1..h:Fac   ;NO;;;100 ;NUMERO;'##,###,###,###.##';
       'Precio'                ;i:1..i:Fac   ;NO;;;100 ;NUMERO;'###,###.########';              
       'Observaciones'         ;r:1..r:Fac   ;NO;;;400;STRING;;
    FinListBox

    IF NOT OK 
       Cancelar
    ENDIF

    If Ok
         Recorrer&i 1, Val(ca:1)
            If Val(z:&i) = 0
               SQL.ADD("UPDATE "~DBO~".OPA3 ")
               SQL.ADD("SET Procesado = '0', Warning='',NrOperacion='' ")
               SQL.ADD("Where Boleta = '"~Val(a:&i)~"' ")
               SQL.NEW  
               SQL.EXEC
            Endif
         Proximo
         Messagebox('Actualizacion terminada') 
   else
     Messagebox('Actualizacion Cancelada')  
   endif  
Else
  Messagebox('No se encontraron mensajes para Actualizar')
Endif
