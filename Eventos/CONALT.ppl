* Lee los mensajes para confirmar al MAE, se invoca desde Recibir Mensajes del MAE 
* debe ejecutarse tambien periodicamente para procesar los mensajes que no 
* encontro con anterioridad (tener en cuenta que plazo para contestar esta en 6 min.)

CrearDialogo
  Check1: 'Procesa';1;2; ;SI;SI;;;;0;
FinDialogo
if Not OK
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif

ACT(A5, 'Cliente')
ACT(B5, 'TipoOp')
ACT(C5, 'FechaOp')
ACT(D5, 'FechaVto')
ACT(E5, 'Plazo')
ACT(F5, 'Especie')
ACT(G5, 'AgenteContra')
ACT(H5, 'Oper.Contra')
ACT(I5, 'Cantidad')
ACT(J5, 'Precio')
ACT(K5, 'Interes')
ACT(L5, 'Pase')
ACT(M5, 'Operacion')
ACT(N5, 'Spot')
ACT(O5, 'Futuro')
ACT(P5, 'Casa Cust.')
ACT(Q5, 'For.Liq.')
ACT(R5, 'PaseAforado')
ACT(S5, 'Feriados')
ACT(T5, 'ContraEspecie')
* FJL 06/11/19 - Se agrega validacion de Cupon
ACT(U5, 'Cupon')

ACT(aa:1, 'Codigo')
ACT(aa:2, 'FechaMAE')
ACT(aa:3, 'HoraMAE')
ACT(aa:4, 'Secuencia')
ACT(aa:5, 'CodigoMAE')
ACT(aa:6, 'Estado')

ACT(ac:1, 'Mercado')
ACT(ac:2, 'Agente')
ACT(ac:3, 'Operador')
ACT(ac:4, 'Fecha')
ACT(ac:5, 'Hora')
ACT(ac:6, 'Secuencia')
ACT(ac:7, 'CodigoRegistro')
ACT(ac:8, 'CodigoNego')
ACT(ac:9, 'CodigoTitulo')
ACT(ac:10, 'Cupon')
ACT(ac:11, 'NroCupon')
ACT(ac:12, 'Plazo')
ACT(ac:13, 'Moneda')
ACT(ac:14, 'Clase')
ACT(ac:15, 'MercadoContra')
ACT(ac:16, 'AgenteContra')
ACT(ac:17, 'OperadorContra')
ACT(ac:18, 'Cantidad')
ACT(ac:19, 'Precio')
ACT(ac:20, 'TipoOpDest')
ACT(ac:21, 'TipoOpOrig')
ACT(ac:22, 'EnteLiq.')
ACT(ac:23, 'TipoLiq.')
ACT(ac:24, 'CodigoRueda')
ACT(ac:25, 'Cod.Op a Contes.')
ACT(ac:26, 'VtoSolicitud')
ACT(ac:27, 'Fecha a Conf.')
ACT(ac:28, 'Sec. a Conf.')
ACT(ac:29, 'TipoOpDest Val')
ACT(ac:30, 'Interes')
ACT(ac:31, 'Valorizacion')
ACT(ac:32, 'Valoriz.USD')

SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
SQL.ADD(" where Codigo  = 'CONALT' ")
SQL.ADD("   and Estado = 'PEN' ")
Recorrer SQL
  BorrarCeldas(A1..T4)
  BorrarCeldas(A6..U8)

  BorrarCeldas(ab:1..ab:6)
  BorrarCeldas(ad:1..ae:32)

  ACT(ab:1, fbn('Codigo'))
  ACT(ab:2, fbn('FechaMAE'))
  ACT(ab:3, fbn('HoraMAE'))
  ACT(ab:4, fbn('Secuencia'))
  ACT(ab:5, fbn('CodigoMAE'))
  ACT(ab:6, fbn('Estado'))

  if Dialogo.Check1=1
    Message('Preparando Informacion de Busqueda de Ops. (Sec. '~fbn('Secuencia')~')')
  else
    MessageBox('Preparando Informacion de Busqueda de Ops. (Sec. '~fbn('Secuencia')~')')
  endif
          
  ACT(a:2, fbn('Mensaje1'))
  if NoVacio(fbn('Mensaje2'))
    ACT(a:2, Val(a:2)~fbn('Mensaje2'))
  endif
  if NoVacio(fbn('Mensaje3'))
    ACT(a:2, Val(a:2)~fbn('Mensaje3'))
  endif

  ACT(ad:1, Copy(Val(a:2),5,1))
  ACT(ad:2, Copy(Val(a:2),6,3))
  ACT(ad:3, Copy(Val(a:2),9,2))
  ACT(ad:4, Copy(Val(a:2),11,6))
  ACT(ad:5, Copy(Val(a:2),17,6))
  ACT(ad:6, Copy(Val(a:2),23,5))
  ACT(ad:7, Copy(Val(a:2),28,4))
  ACT(ad:8, Copy(Val(a:2),32,1))
  ACT(ad:9, Copy(Val(a:2),33,5))
  ACT(ad:10, Copy(Val(a:2),38,1))
  ACT(ad:11, Copy(Val(a:2),39,3))
  ACT(ad:12, Copy(Val(a:2),42,3))
  ACT(ad:13, Copy(Val(a:2),45,1))
  ACT(ad:14, Copy(Val(a:2),46,1))
  ACT(ad:15, Copy(Val(a:2),47,1))
  ACT(ad:16, Copy(Val(a:2),48,3))
  ACT(ad:17, Copy(Val(a:2),51,2))
  ACT(ad:18, Copy(Val(a:2),53,18))
  ACT(ad:19, Copy(Val(a:2),71,18))
  ACT(ad:20, Copy(Val(a:2),89,1))
  ACT(ad:21, Copy(Val(a:2),90,1))
  ACT(ad:22, Copy(Val(a:2),91,1))
  ACT(ad:23, Copy(Val(a:2),92,1))
  ACT(ad:24, Copy(Val(a:2),93,4))
  ACT(ad:25, Copy(Val(a:2),97,4))
  ACT(ad:26, Copy(Val(a:2),101,6))
  ACT(ad:27, Copy(Val(a:2),107,6))
  ACT(ad:28, Copy(Val(a:2),113,5))
  ACT(ad:29, Copy(Val(a:2),118,10))
  ACT(ad:30, Copy(Val(a:2),128,18))
  ACT(ad:31, Copy(Val(a:2),146,18))
  ACT(ad:32, Copy(Val(a:2),164,18))

  ACN(ae:11, Num(Val(ad:11)))
  ACN(ae:12, Num(Val(ad:12)))
  ACN(ae:18, Num(Val(ad:18))/10000)
  ACN(ae:19, Num(Val(ad:19))/100000000)
  ACN(ae:26, Num(Val(ad:26)))
  ACN(ae:30, Num(Val(ad:30))/100)
  ACN(ae:31, Num(Val(ad:31))/10000)
  ACN(ae:32, Num(Val(ad:32))/10000)

  *- Calcula la hora en que vence el plazo para contestar y la hora actual
  ACN(w:3, Val(ae:26))
  ACN(y:3, Num(Copy(Hora(Ahora),1,2)~Copy(Hora(Ahora),4,2)~Copy(Hora(Ahora),7,2)))
  *- Calcula el dia en que se recibi el mensaje
*** /// ***
*  ACT(k:1, Copy(Val(ad:4),5,2)~'/'~Copy(Val(ad:4),3,2)~'/'~Copy(Ahora,7,2)~Copy(Val(ad:4),1,2)~' '~Copy(Val(ad:5),1,2)~':'~Copy(Val(ad:5),3,2)~':'~Copy(Val(ad:5),5,2))
  ACT(k:1, Copy(Val(ad:4),5,2)~'/'~Copy(Val(ad:4),3,2)~'/20'~Copy(Val(ad:4),1,2)~' '~Copy(Val(ad:5),1,2)~':'~Copy(Val(ad:5),3,2)~':'~Copy(Val(ad:5),5,2))
          
  *- Prepara informacion para buscar operacion
  *- Pase
  * USA EN SELECT (L6 PaseCB)
  ACT(R6, '0')
  if Incluido(Val(ad:8),'5|7')
    ACT(L6, '1')
    if EqStr(Val(ad:8),'7')
      *- Es un Pase Aforado
      ACT(R6, '1')
    endif
  else
    ACT(L6, '0')
    if Incluido(Val(ad:8),'1|C|8')
      *- Es Spot
      ACN(N6,1)
    endif
    if Incluido(Val(ad:8),'9')
      *- Es Futuro
      ACN(O6,1)
    endif
  endif
  *- Fecha de Operacion
  * USA EN SELECT (C6 FechaOp)
  if Incluido(Copy(Val(ad:25),3,2),'01')
    ACD(C6, FSYS)
  else
    ACD(C6, Fecha(Copy(Val(ad:27),5,2)~'/'~Copy(Val(ad:27),3,2)~'/20'~Copy(Val(ad:27),1,2)))
  endif
  if Dialogo.Check1=1
    Message(Fecha(Val(c6)))
  else
    MessageBox(Fecha(Val(c6)))
  endif
  *- TablaFeriados
  ACT(S6, 'ARG')
  if Incluido(Val(ad:22),'1|2|5|8|B|C')
    ACT(S6, 'ARG')
  endif
  if Incluido(Val(ad:22),'3|4|6|7|9|D')
    ACT(S6, 'USA')
  endif
  Message('Feriados : '~Val(s6))
  *- Fecha de Vencimiento y plazo
  if EqStr(Val(L6),'0')
    *- La operacion NO es pase
    *- Fecha de Vencimiento
    if Val(N6)=1
      *- Spot
      ACN(D6, Habiles(Val(C6),Val(ae:12),Val(S6)))
    endif
    if Val(O6)=1
      *- Futuro
      if Incluido(Val(ad:22),'D|6') y Not EsHabil(Val(c6)+Val(ae:12),'USA')
        ACN(D6, Habiles(Val(c6)+Val(ae:12),1,'USA'))
      else
        ACN(D6, Val(c6)+Val(ae:12))
      endif
    endif
    *- Plazo
    * USA EN SELECT (E6 Plazo)
    if Val(N6)=1
      *- Spot
      ACN(E6, Val(ae:12))
    endif
    if Val(O6)=1
      *- Futuro
      if Incluido(Val(ad:22),'D|6')
        ACN(E6, DifDias(Val(d6),Val(c6),'USA'))
      else
        ACN(E6, DifDias(Val(d6),Val(c6),'ARG'))
      endif
    endif
  else
    *- Plazos si la operacion es pase expresados en horas y en dias
    *- Si es la operacion Spot, el mae informa los dias corridos y Sam los tiene habiles
    * => pasar a dias habiles
    ACN(D6, Val(C6)+Val(ae:12))
    ACN(x2, DifDias(Val(C6), Val(D6),'ARG',SI))
    ACN(E7, Val(x2))
    ACN(E8, Val(ae:12))
  endif                           
  if Dialogo.Check1=1
    Message('Fechaop : '~Fecha(Val(c6))~'  Fechavto : '~Fecha(Val(d6))~'  Plazo : '~fstr(Val(e6),20,5))
  else
    MessageBox('Fechaop : '~Fecha(Val(c6))~'  Fechavto : '~Fecha(Val(d6))~'  Plazo : '~fstr(Val(e6),20,5))
  endif
  *- Especie MAE
  ACT(F8, Val(ad:9))
   
  *- Especie
  * USA EN SELECT (F6 Especie)
  if EqStr(Val(ad:10),'C')
    * Es Cupon
    ACT(F6, SQL("Select Codigo   From "~DBO~".ESPECIES Where CodMAEContado='"~Val(F8)~"' and IsNull(EsCupon,'NO') = 'SI' "))
    ACT(F9, Val(F6))
  else
    * NO Es Cupon
    ACT(F6, SQL("Select Codigo   From "~DBO~".ESPECIES Where CodMAEContado='"~Val(F8)~"' and IsNull(EsCupon,'NO') = 'NO' "))
    ACT(F9, Val(F6))
    ACN(F7, SQL("Select Count(*) From "~DBO~".ESPECIES Where CodMAEContado='"~Val(F8)~"' and IsNull(EsCupon,'NO') = 'NO' "))
    if Val(f7) > 1
      SQL.ADD("Select Codigo     From "~DBO~".ESPECIES Where CodMAEContado='"~Val(F8)~"' and IsNull(EsCupon,'NO') = 'NO' ")
      Recorrer Sql
        ACT(F6, Val(F6)~" ' , '"~fbn('Codigo') )
      Proximo
    endif
  endif
  Message('Especie : '~Val(F6))

* FJL 06/11/19 - Se agrega validacion de Cupon
  *- Cupon
  * USA EN SELECT (U6 Cupon1)
  ACN(U6, Val(ae:11))
  Message('Cupon : '~FStr(Val(U6),0,0))

  *- Agente Contra                    
  ACT(G6, Val(ad:16))
  if EqStr(Val(G6),'000') o EqStr(Val(G6),Var('AGESIOP'))
    * Operacion con Tercero
    ACN(x1,0)
    ACN(z1, Num(Val(ad:15)))
  else
    * Operacion con Agente
    ACN(x1,1)
    *- Operador Contra
    ACT(H6, Val(ad:17))
    *- Codigo Mercado
    ACN(z1, Num(Val(ad:15)))
    *- Codigo Cliente
    * USA EN SELECT (A6 Cliente1)
    if Val(z1)=VAR('MERSIOP')
      *- Es un agente de mae
      ACT(A6, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(G6)~"' "))
    endif
    if Val(z1)=5
      *- Es un agente de bolsa
      ACN(x1,0)
      ACT(A6, SQL("Select Codigo From "~DBO~".CLIENTES Where NrAgenteBolsa = '"~FStr(Val(G6),1,0)~"' "))
    endif
  endif
  Message('Cliente : '~Val(A6))

  *- Cantidad (4 decimales)
  * USA EN SELECT (I6 Cantidad)
  ACN(I6, Val(ae:18))
  Message('Cantidad : '~PyC(Val(I6),1,2))

  *- Precio (8 decimales)
  * USA EN SELECT (J6 Precio1/TipoCambio2)
  ACN(J6, Val(ae:19))
  ACN(ah:1,0)
  Message('Precio : '~Fstr(Val(J6),1,8))

  *- Interes (2 decimales)
  * USA DENTRO DEL RECORRER (P6 Mercado y otra logica)
  ACN(K6, Val(ae:30))
  Message('intereses : '~PyC(Val(k6),1,2))

  *- Ente Liquidador
  * USA DENTRO DEL RECORRER (P6 Mercado y otra logica)
  ACT(P6, 'XXX')
  if Incluido(Val(ad:22),'1|D|T|B')
    ACT(P6, 'AC')
  endif
  if EqStr(Val(ad:22),'2')
    ACT(P6, 'CRYL')
  endif
  if EqStr(Val(ad:22),'3')
    ACT(P6, 'CE')
  endif
  if EqStr(Val(ad:22),'4')
    ACT(P6, 'EU')
  endif
*  if EqStr(Val(ad:22),'6')
*    ACT(P6, 'EPU')
*  endif
  if Incluido(Val(ad:22),'5|6|8|9')
    ACT(P6, 'CV')
  endif
  if Incluido(Val(ad:22),'G|F|U|C|W')
** FJL 17/07/25 - Issue EXTBOFA-8175 Por nuevo Mercado liquidacion A3C
*    ACT(P6, 'MC')
    ACT(P6, VAR('ENTELIQA3'))
  endif
  Message('Mercado : '~Val(p6))

  *- TipoOp
  * USA EN SELECT (B6 TipoOp)
  if EqStr(Val(L6),'0')
    *- Tipo de Operacion para las operaciones que NO son pase
    if Val(N6)=1
      * Spot
      if Val(x1)=1
        * Operacion con Agente
        if Incluido(Copy(Val(ad:25),1,2),'03')
          ACT(B6, 'TIC')
        else
          ACT(B6, 'TIV')
        endif
      else
        * Operacion con terceros
        if Incluido(Copy(Val(ad:25),1,2),'03')
          ACT(B6, 'TIV')
        else
          ACT(B6, 'TIC')
        endif
      endif
    endif
    if Val(O6)=1
      * Futuro
      if Val(x1)=1
        * Operacion con Agente
        if Incluido(Copy(Val(ad:25),1,2),'03')
          ACT(B6, 'TIFC')
        else
          ACT(B6, 'TIFV')
        endif
      else
        * Operacion con terceros
        if Incluido(Copy(Val(ad:25),1,2),'03')
          ACT(B6, 'TIFV')
        else
          ACT(B6, 'TIFC')
        endif
      endif
    endif
  else
    *- Tipo de Operacion para las operaciones que son pase
    if Val(x1)=1
      * Operacion con Agente
      if Incluido(Copy(Val(ad:25),1,2),'03')
        ACT(B7, 'TIC')
        ACT(B8, 'TIFC')
      else
        ACT(B7, 'TIV')
        ACT(B8, 'TIFV')
      endif
    else
      * Operacion con terceros
      if Incluido(Copy(Val(ad:25),1,2),'03')
        ACT(B7, 'TIV')
        ACT(B8, 'TIFV')
      else
        ACT(B7, 'TIC')
        ACT(B8, 'TIFC')
      endif
    endif
  endif

  *- ContraEspecie
  * USA EN SELECT (T6 ContraEspecie)
  ACT(T6, 'XXX')
  if Incluido(Val(ad:13),'$')
    ACT(T6, 'ARP')
  endif
  if Incluido(Val(ad:13),'D')
    ACT(T6, 'USD')
  endif  
   
  *- Informacion Adicional para Ejecutar Evento 
  *- Fecha a confirmar
  ACT(P1, Val(ad:4))
  *- Secuencia a confirmar
  ACT(P2, Val(ad:6))
    
  *- Buscar operacion
  BorrarCeldas(N1..N2)
  ACN(N1,0)
  ACN(N2,0)
  *******************************************************
  * Guardo el query para analizar porque no matchea
  *******************************************************
  ACT(xx:10,"Select O.Especie, O.ContraEspecie, O.FechaOp, O.Precio1, ")
  ACT(xx:10,Val(xx:10)~"O.TotalIntereses, O.FechaVto, O.Cantidad, O.TipoOp, ")
  ACT(xx:10,Val(xx:10)~"O.FormaLiquidacion1, O.Mercado, O.TablaFeriados1, O.TotalBrutoCli1, ")
  ACT(xx:10,Val(xx:10)~"O.NrOperacion, OB.NrBit, O.Precio3, O.Precio4, ")
***///
*  ACT(xx:10,Val(xx:10)~"O.TotalInteresesOrig, O.InteresMAE, O.ContraEspecie2 ")
  ACT(xx:10,Val(xx:10)~"O.ContraEspecie2 ")
  ACT(xx:10,Val(xx:10)~"from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
  ACT(xx:10,Val(xx:10)~" where O.FechaOp  = '"~IdxDate(Val(C6))~"' ")
  *** Especie
  if Val(f7) > 1
     ACT(xx:10,Val(xx:10)~" and O.Especie in ('"~Val(F6)~"') ")
  else
     ACT(xx:10,Val(xx:10)~" and O.Especie = '"~Val(F6)~"' ")
  endif
* FJL 06/11/19 - Se agrega validacion de Cupon
  *** NrCupon
  ACT(xx:10,Val(xx:10)~"   and O.Cupon1 = "~FStr(Val(U6),0,0)~" ")
  *** Cantidad
  ACT(xx:10,Val(xx:10)~"   and Round(O.Cantidad,4) = "~FStr(Val(I6),1,4)~" ")
  *** Precio
***///***
*  if Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',Val(F9)),'CLE')
*    **SQL.ADD(" and Round(O.Precio3,8) =  ROUND(convert(float,"~FStr(Val(J6),1,8)~"),8)    ")
*    ACT(xx:10,Val(xx:10)~" and Round(O.Precio3*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
*  else
*    **SQL.ADD(" and Round(O.Precio4,8) =  ROUND(convert(float,"~FStr(Val(J6),1,8)~"),8)    ")
*    ACT(xx:10,Val(xx:10)~" and Round(O.Precio4*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
*  endif
  ACT(xx:10,Val(xx:10)~" and Round(O.Precio1*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
  *** Cliente1
  if Val(x1)=1
    * Operacion con Agente
    ACT(xx:10,Val(xx:10)~" and O.Cliente1 = '"~Val(A6)~"' ")
  endif
  *** PaseCB
  ACT(xx:10,Val(xx:10)~" and IsNull(O.PaseCB,'0') = '"~Val(L6)~"' ")
  if EqStr(Val(L6),'0')
    *- Si no es pase
    ACT(xx:10,Val(xx:10)~" and O.TipoOp = '"~Val(B6)~"' ")
    if Val(N6)=1
      * Spot
***///***
*      ACT(xx:10,Val(xx:10)~" and O.Plazo = "~FStr(Val(E6), 1, 0)~" ")
      ACT(xx:10,Val(xx:10)~" and O.Plazo/24 = "~FStr(Val(E6), 1, 0)~" ")
    endif
    if Val(O6)=1
      * Futuro
      ACT(xx:10,Val(xx:10)~" and O.PlazoGracia = "~FStr(Val(E6), 1, 0)~" ")
    endif
  else
    *- si es pase
    ACT(xx:10,Val(xx:10)~" and ((O.TipoOp = '"~Val(B7)~"' and O.Plazo = "~FStr(Val(E7), 1, 0)~") ")
* FJL 3/12/19 - Por BBYMA - En STD no se usa PlazoGracia
*    ACT(xx:10,Val(xx:10)~"   or (O.TipoOp = '"~Val(B8)~"' and O.PlazoGracia = "~FStr(Val(E8), 1, 0)~") ")
    ACT(xx:10,Val(xx:10)~"   or (O.TipoOp = '"~Val(B8)~"' and O.Plazo = "~FStr(Val(E8), 1, 0)~") ")
    ACT(xx:10,Val(xx:10)~"     ) ")
  endif
  *** ContraEspecie
  ACT(xx:10,Val(xx:10)~" and O.ContraEspecie =  '"~Val(T6)~"' ")
  ACT(xx:10,Val(xx:10)~" and IsNull(O.NroAltaMAE,'') = '' ")
  ACT(xx:10,Val(xx:10)~" and O.NrOperacion   =  OB.NrOperacion ")
  ACT(xx:10,Val(xx:10)~" and OB.NrBit        in (61,69) ")
  ACT(xx:10,Val(xx:10)~" and OB.Valor        =  '1' ")
  *******************************************************
  * Busca operacion que coincida con los datos calculados
  *******************************************************
  SQL.ADD("Select O.Especie,            O.ContraEspecie, O.FechaOp,        O.Precio1,        ")
  SQL.ADD("       O.TotalIntereses,     O.FechaVto,      O.Cantidad,       O.TipoOp,         ")
  SQL.ADD("       O.FormaLiquidacion1,  O.Mercado,       O.TablaFeriados1, O.TotalBrutoCli1, ")
  SQL.ADD("       O.NrOperacion,        OB.NrBit,        O.Precio3,        O.Precio4,        ")
*  SQL.ADD("       O.TotalInteresesOrig, O.InteresMAE,    O.ContraEspecie2  ")
  SQL.ADD("       O.ContraEspecie2  ")
  SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
  SQL.ADD(" where O.FechaOp  = '"~IdxDate(Val(C6))~"' ")
  *** Especie
  if Val(f7) > 1
    SQL.ADD(" and O.Especie in ('"~Val(F6)~"') ")
  else
    SQL.ADD(" and O.Especie = '"~Val(F6)~"' ")
  endif
* FJL 06/11/19 - Se agrega validacion de Cupon
  *** NrCupon
  SQL.ADD("   and O.Cupon1 = "~FStr(Val(U6),0,0)~" ")
  *** Cantidad
  SQL.ADD("   and Round(O.Cantidad,4) = "~FStr(Val(I6),1,4)~" ")
  *** Precio
***///***
*  if Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',Val(F9)),'CLE')
*    **SQL.ADD(" and Round(O.Precio3,8) =  ROUND(convert(float,"~FStr(Val(J6),1,8)~"),8)    ")
*      SQL.ADD(" and Round(O.Precio3*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
*  else
*    **SQL.ADD(" and Round(O.Precio4,8) =  ROUND(convert(float,"~FStr(Val(J6),1,8)~"),8)    ")
*      SQL.ADD(" and Round(O.Precio4*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
*  endif
  SQL.ADD(" and Round(O.Precio1*100000000,-1) = ROUND("~FStr(Val(J6),1,8)~"*100000000,-1) ")
  *** Cliente1
  if Val(x1)=1
    * Operacion con Agente
    SQL.ADD(" and O.Cliente1 = '"~Val(A6)~"' ")
  endif
  *** PaseCB
  SQL.ADD(" and IsNull(O.PaseCB,'0') = '"~Val(L6)~"' ")
  if EqStr(Val(L6),'0')
    *- Si no es pase
    SQL.ADD(" and O.TipoOp = '"~Val(B6)~"' ")
    if Val(N6)=1
      * Spot
***///***
*      SQL.ADD(" and O.Plazo = "~FStr(Val(E6), 1, 0)~" ")
      SQL.ADD(" and O.Plazo/24 = "~FStr(Val(E6), 1, 0)~" ")
    endif
    if Val(O6)=1
      * Futuro
      SQL.ADD(" and O.PlazoGracia = "~FStr(Val(E6), 1, 0)~" ")
    endif
  else
    *- si es pase
* FJL 3/12/19 - Por BBYMA - En STD el Plazo esta en horas
*    SQL.ADD(" and ((O.TipoOp = '"~Val(B7)~"' and O.Plazo = "~FStr(Val(E7), 1, 0)~") ")
    SQL.ADD(" and ((O.TipoOp = '"~Val(B7)~"' and O.Plazo/24 = "~FStr(Val(E7), 1, 0)~") ")
* FJL 3/12/19 - Por BBYMA - En STD no se usa PlazoGracia
*    SQL.ADD("   or (O.TipoOp = '"~Val(B8)~"' and O.PlazoGracia = "~FStr(Val(E8), 1, 0)~") ")
    SQL.ADD("   or (O.TipoOp = '"~Val(B8)~"' and O.Plazo = "~FStr(Val(E8), 1, 0)~") ")
    SQL.ADD("     ) ")
  endif
  *** ContraEspecie
  SQL.ADD(" and O.ContraEspecie =  '"~Val(T6)~"' ")
  SQL.ADD(" and IsNull(O.NroAltaMAE,'') = '' ")
  SQL.ADD(" and O.NrOperacion   =  OB.NrOperacion ")
  SQL.ADD(" and OB.NrBit        in (61,69) ")
  SQL.ADD(" and OB.Valor        =  '1' ")
  Recorrer SQL
    if Dialogo.Check1=0
      MessageBox('Op: '~fbn('NrOperacion'))
    endif
    SCN(ak:1, 1)
    ACT(al:Val(ak:1), fbn('NrOperacion'))
    ACT(am:Val(ak:1), fbn('TipoOp'))
    ACN(an:Val(ak:1), fbn('NrBit'))
    *- Interes
    *- Si la especie se informa al MAE clean
    if Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'CLE')
***///***
*      ACN(x6, fbn('InteresMAE'))
      ACN(x6, fbn('TotalIntereses'))
    else
      ACN(x6, 0)
    endif
    ********************
    ** Control Intereses
    ********************
    if Not Val(x6)-Val(K6)>1 y Not Val(x6)-Val(K6)<-1
      *- Tipo de Liquidacion
      if FBN['FormaLiquidacion1'] = 0
        ACT(Q6, '2')
      endif
      if FBN['FormaLiquidacion1'] = 1
        ACT(Q6, '1')
      endif
      if FBN['FormaLiquidacion1'] = 2
        ACT(Q6, '4')
      endif
      if Not EqStr(Val(Q6),Val(ad:23))
        if Dialogo.Check1=1
          Message('Error FormaLiquidacion '~Val(Q6)~' '~Val(ad:23))
        else
          MessageBox('Error FormaLiquidacion '~Val(Q6)~' '~Val(ad:23))
        endif
      endif
      ******************
      ** Control Mercado
      ******************
*      MessageBox('Mercado = '~fbn('Mercado')~' P6 = '~Val(p:6))
      if EqStr(fbn('Mercado'),Val(P6)) o [Incluido(fbn('Mercado'),'CE|EU') y Incluido(Val(P6),'CE|EU')] o [EqStr(Val(P6),'EPU') y Incluido(fbn('Mercado'),'CV|EU|CE') y Not EqStr(fbn('TablaFeriados1'),'ARG')]
        *****************
        ** Argenclear MEP
        *****************
        if [EqStr(Val(ad:22),'B') y EqStr(fbn('Mercado'),Val(P6)) y EqStr(fbn('ContraEspecie'),'USD') y EqStr(fbn('ContraEspecie2'),'USB')] o Not EqStr(Val(ad:22),'B')
          ********************
          ** Forma Liquidacion
          ********************
          if EqStr(Val(Q6),Val(ad:23)) o SI
            if Val(ah:1)=1
              * Nunca entra por aca / ah:1 simpre es 0
              if FBN['TotalBrutoCli1']/FBN['Cantidad']=Val(j6)
                ACT(M6, FBN['NrOperacion'])
                ACN(M7, fbn('NrBit'))
                ACN(N1,1)  
                Message('----- Op encontrada : '~Val(M6))
                Break
              else
                if Dialogo.Check1=1
                  Message('Error PrecioDirty = '~FStr(Val(j6),1,8))
                else
                  MessageBox('Error PrecioDirty = '~FStr(Val(j6),1,8))
                endif               
              endif
            else
              ACT(M6, FBN['NrOperacion'])
              ACN(M7, fbn('NrBit'))
              ACN(N1,1)  
              Message('----- Op encontrada : '~Val(M6))
              Break
            endif
          else
            * Nunca entra por aca
            if Dialogo.Check1=1
              Message('Error FormaLiquidacion '~Val(Q6)~' '~Val(ad:23))
            else
              MessageBox('Error FormaLiquidacion '~Val(Q6)~' '~Val(ad:23))
            endif
          endif
        else
          if Dialogo.Check1=1
            Message('Error Ente Liquidador '~Val(P6)~' MEP')
          else
            MessageBox('Error Ente Liquidador '~Val(P6)~' MEP')
          endif               
        endif
      else
        if Dialogo.Check1=1
          Message('Error Ente Liquidador '~Val(P6))
        else
          MessageBox('Error Ente Liquidador '~Val(P6))
        endif               
      endif               
    else
      if Dialogo.Check1=1
        Message('Error Intereses '~FStr(Val(x6),1,2)~' '~FStr(Val(K6),1,2))
      else
        MessageBox('Error Intereses '~FStr(Val(x6),1,2)~' '~FStr(Val(K6),1,2))
      endif
    endif
  Proximo   
  If EqStr(Var('DEBUGMAE'),'SI')
     ACT(xx:11,Var('PATHSIOPEL')~'CONALT.TXT')
     AbrirASCII(Val(xx:11),0)
     EscribirASCII(Fecha(Fsys,'DDMMYYYY')~'-'~Hora(Ahora)~'-'~Val(xx:10))
     CerrarASCII
  Endif
  if Val(N1)=1
    if Dialogo.Check1=1
      *- Confirma al MAE
      Message('- Confirma Operacion '~Val(M6)~' al MAE')          
      SQL.ADD("Update "~DBO~".OPERACIONESBITS ")
      SQL.ADD("   Set Valor = '0' ")
      SQL.ADD(" Where NrBit       in (61,62,69) ")
      SQL.ADD("   and NrOperacion = '"~Val(M6)~"' ")
      SQL.NEW
      SQL.EXEC

      EjecutarEvento('CBOINS', String1=Val(M6), Radio1=1, Radio2=2, Entero1=Val(M7), Entero2=63)
      EjecutarEvento('CONMAE',NrOperacion1=Val(M6), String=Val(P1)~Val(P2), Check1=1, Check2=0)

      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("   Set AceptaMAE    = 'SI', ")
      SQL.ADD("       FechaAltaMAE = Convert(smalldatetime,'"~Val(K:1)~"',103), ")
      SQL.ADD("       NroAltaMAE   = '"~Val(ad:6)~"' ")
      SQL.ADD(" Where NrOperacion  = '"~Val(M6)~"' ")
      SQL.NEW

      SQL.ADD("Update "~DBO~".MENSAJESMAE ")
      SQL.ADD("   Set Estado    = 'CON' ")
      SQL.ADD(" Where Codigo    = 'CONALT' ")
      SQL.ADD("   and FechaMAE  = '"~Val(ab:2)~"' ")
      SQL.ADD("   and HoraMAE   = '"~Val(ab:3)~"' ")
      SQL.ADD("   and Secuencia = '"~Val(ab:4)~"' ")
      SQL.ADD("   and CodigoMAE = '"~Val(ab:5)~"' ")
      SQL.ADD("   and Estado    = 'PEN' ")
      SQL.NEW
      SQL.EXEC
    else
      MessageBox('- Confirma Operacion '~Val(M6)~' al MAE')          
    endif
  endif
Proximo

FormatoCeldas(ae:11..ae:16,Exe('F0'))
FormatoCeldas(ae:18..ae:18,Exe('F2'))
FormatoCeldas(ae:19..ae:19,Exe('F8'))
FormatoCeldas(ae:30..ae:32,Exe('F2'))

ACO(29,9)
ACO(30,12)
ACO(31,9)
