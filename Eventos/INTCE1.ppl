SQL.ADD(" SELECT Vehiculo1,NrOperacionRef1,Fecha2,Especie,Cantidad1,Cuenta2, NrTrans ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" WHERE NrTrans = '"~Dialogo.NrTrans1~"' ")
Recorrer SQL
    *Business unit
    ACT(A:1,BuscarCampo('VEHICULOS',Alias2,Codigo,fbn('Vehiculo1')))
    *VOUCHER_STYLE
    ACT(A:2,'REG')
    *ORIGIN A CONFIRMAR
    ACT(A:3,'FPA')
    *DST_CNTRL_ID A CONFIRMAR
    ACT(A:4,'')
    *AP_VCHR_CAT
    ACT(A:5,'CI')
    *INVOICE_ID
    ACT(A:6,fbn('NrOperacionRef1')~'_'~fbn('NrTrans'))
    *DATE
    ACD(A:7,Fecha(FBN['Fecha2'],'dd-mm-yyyy'))
    *VENDOR_ID A CONFIRMAR
    ACT(A:8,'')
    *VAT_RGSTRN_ID  A CONFIRMAR
    ACT(A:9,'')
    *NFI_CAE_AP
    ACT(A:10,'')
    *VOUCHER_CAI_NUM
    ACT(A:11,'')
    *EFFDT_BD
    ACT(A:12,'')
    *NFI_CAEA
    ACT(A:13,'N')
    *Voucher_line_num
    ACN(A:14,1)
    *INV_ITEM_ID A CONFIRMAR
    ACT(A:15,'')
    *DESCR A CONFIRMAR
    ACT(A:16,'')
    *OPERATING_UNIT A CONFIRMAR
    ACT(A:17,'')
    *DEPTID
    ACT(A:18,fbn('Especie'))
    *CURRENCY_CD
    ACT(A:19,BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie')))
    *MERCHANDISE_AMT
    ACN(A:20,fbn('Cantidad'))
    *RATE_MULT A CONFIRMAR
    ACT(A:21,'')
    *RT_TYPE
    ACT(A:22,'CRRNT')
    *TAX_CD_VAT
    ACT(A:23,'')
    *VAT_AMT
    ACN(A:24,0)
    *CTAX_REG
    ACT(A:25,'')
    *CTAX_ENTRD_AMT
    ACN(A:26,0)
    *PYMNT_TERMS_CD
    ACT(A:27,'CTO')
    *SCHEDULED_PAY_DT
    ACD(A:28,Fecha(FBN['Fecha2'],'dd-mm-yyyy'))
    *BANK_CD
    ACT(A:29,BuscarCampo('CLIENTES','Alias3','Codigo',BuscarCampo('CUENTAS','Comitente','Codigo',fbn('Cuenta2'))))
    *BANK_ACCT_KEY
    ACT(A:30,BuscarCampo('CUENTAS','Alias6','Codigo',fbn('Cuenta2')))
    *PYMNT_METHOD A CONFIRMAR
    ACT(A:31,'')
    *Descripción del banco Proveedor A CONFIRMAR
    ACT(A:32,'')
    
    ACT(LN:1,Val(A:1)~';'~Val(A:2)~';'~Val(A:3)~';'~Val(A:4)~';'~Val(A:5)~';'~Val(A:6)~';'~Val(A:7)~';'~Val(A:8)~';'~Val(A:9)~';'~Val(A:10)~';'~Val(A:11)~';'~Val(A:12)~';'~Val(A:13)~';'~Val(A:14)~';'~Val(A:15)~';'~Val(A:16)~';'~Val(A:17)~';'~Val(A:18)~';'~Val(A:19)~';'~Val(A:20)~';'~Val(A:21)~';'~Val(A:22)~';'~Val(A:23)~';'~Val(A:24)~';'~Val(A:25)~';'~Val(A:26)~';'~Val(A:27)~';'~Val(A:28)~';'~Val(A:29)~';'~Val(A:30)~';'~Val(A:31)~';'~Val(A:32))
