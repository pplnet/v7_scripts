
HojaVisible(SI)
*MostrarCuadroDeMensajes
CrearDialogo
  Fecha1    : "Fecha"                                   ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Fsys-1
  Radio1    : "Salida|Informe|Inf+TXT"                  ; ; ;;;;;;;1
  String1   : 'Path'                                    ; ; ;;;;;;;'C:\FPA\'
  String2   : 'Archivo'                                 ; ; ;;;;;;;'1469 - 26-09-2018 - Registro de Ordenes.TXT'
FinDialogo

IF Not Ok
  Cancelar
ENDIF
*(.'ABCDARIO'.)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(d:2, 'ORDENES Generadas por Contingencia  -  SIOPEL')
SetFont(d2,3)

ACT(a:4,'Fecha  '~Dialogo.Fecha1)
SetFont(a4..a4,2)

SetFilaActual(6)

ACT(a:fac, 'Fecha')
ACT(b:fac, 'Hora')
ACT(c:fac, 'Tipo Evento')
ACT(d:fac, 'Tipo Movimiento')
ACT(e:fac, 'ID Origen')
ACT(f:fac, 'ID del Proceso')
ACT(g:fac, 'Nro Oferta')
ACT(h:fac, 'Operacion')
ACT(i:fac, 'Especie')
ACT(j:fac, 'Cantidad')
ACT(k:fac, 'Plazo')
ACT(l:fac, 'Precio/Tasa')
ACT(m:fac, 'Modalidad Origen')
ACT(n:fac, 'Comitente')
ACT(o:fac, 'Operacion')
ACT(p:fac, 'Observaciones')

SetFont(a:fac..v:fac, 2)
AlinearCeldas(a:fac..o:fac,'C')
AgregarMarco(a:fac..p:fac,1,0,Exe('COLOR'))

   ACT(aa1, Dialogo.String1~Dialogo.String2)
   AbrirASCII(val(aa1),0)

Repetir
   ACT(aa2, LeerASCII)
   if Vacio(Val(aa2))
      CerrarASCII
      break
  endif

  
    ********** Prepara información para Alta de Orden ************
IF not EqStr(Copy(Val(aa:2),1,15),'Agente;ID;Hora;')

    ACN(lo:1,Longitud(Val(aa:2)))

    ACN(ag3,1)
    ACT(ab1, 'Mercado')
    ACT(ac1, Copy(Val(aa:2),Val(ag3),1))
    SCN(ag3,1)
    ACT(ab2, 'Agente')
    ACT(ac2, Copy(Val(aa:2),Val(ag3),3))
    SCN(ag3,3)
    ACT(ab3, 'OpSIOPEL')
    ACT(ac3, Copy(Val(aa:2),Val(ag3),2))
    SCN(ag3,3)
    ACT(ab4, 'Fecha')
    ACT(ac4, Copy(Val(aa:2),Val(ag3)+4,2)~'/'~Copy(Val(aa:2),Val(ag3)+2,2)~'/'~Copy(Val(aa:2),Val(ag3),2))
    SCN(ag3,6)
    ACT(ab5, 'Hora') 
    ACT(ac5, Copy(Val(aa:2),Val(ag3),2)~':'~Copy(Val(aa:2),Val(ag3)+2,2)~':'~Copy(Val(aa:2),Val(ag3)+4,2))
    SCN(ag3,6)
    ACT(ab6, 'FechaCarga')
    ACT(ac6, '' )
    ACT(ab7, 'Secuencia')
    ACT(ac7, Copy(Val(aa:2),Val(ag3),5))
    SCN(ag3,9)
    ACN(po:1,Posicion(';',Val(aa:2),Val(ag3),Val(lo:1)))
    ACN(po:2,Posicion(';',Val(aa:2),Val(po:1)+1,Val(lo:1)))
    ACT(ab22, 'Cantidad')
    If Val(po:1)+2 < Val(po:2)
       ACT(ac22, Copy(Val(aa:2),Val(po:1)+1,(Val(po:2)-Val(po:1))-1))
    Else
       ACT(ac22, '0')
    Endif
    ACN(ag3,Val(po:2)+1)
    ACT(ab23, 'Precio')
    ACN(po:2,Posicion(';',Val(aa:2),Val(ag3),Val(lo:1)))
    ACT(ac23, Copy(Val(aa:2),Val(ag3),Val(po:2)-Val(ag3)))
    ACT(ab25, 'Comitente')
    ACN(ag3,Val(po:2))
    ACN(po:3,Posicion(';',Val(aa:2),Val(ag3),Val(lo:1)))
    If Val(po:2)+2 < Val(po:3)
       ACT(ac25, Copy(Val(aa:2),Val(ag3)+1,Val(po:3)-1))
    Else
       ACT(ac25, '')
    Endif
    SCN(ag3,Val(po:2)-Val(ag3)+1)
    ACT(ab20, 'Especie')
    ACN(po:2,Posicion(';',Val(aa:2),Val(ag3),Val(lo:1)))
    SCN(ag3,Val(po:2)-Val(ag3)+1)
    ACT(ad20, Copy(Val(aa:2),Val(ag3)+1,5))
    ACT(ac20, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado = '"~Val(ad20)~"' "))
    if Vacio(Val(ac20))
       **   Error
       ACT(ac20,Val(ad20))
    endif
    if EqStr(Copy(Val(aa:2),Val(ag3),1),'1')
       *  Titulos
       ***** Nro Cupon
       ACT(ac35, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(ac20)),1,0))
    Endif
    ACT(ae20, 'DatosEspecie')
    ACT(af20, Copy(Val(aa:2),Val(ag3)+6,8))
    SCN(ag3,16)
    ACT(ab19, 'TipoOpOr')
    ACT(ac19, Copy(Val(aa:2),Val(ag3),1))
    if EqStr(val(ac19),'V')
       ACT(ad19,'TIV') 
       ACT(ae19,'TIFV') 
    Else
       ACT(ad19,'TIC') 
       ACT(ae19,'TIFC') 
    Endif
    SCN(ag3,2)
    ACT(ab11, 'TipoOpEv')
    ACT(ac11, Copy(Val(aa:2),Val(ag3),1))

    ACT(ab8, 'FechaOp')
    ACT(ac8, Copy(Val(aa:2),Val(lo:1)-8,2)~'/'~Copy(Val(aa:2),Val(lo:1)-10,2)~'/'~Copy(Val(aa:2),Val(lo:1)-12,2))
    SCN(ag3,8)
    ACT(ab9, 'HoraOp')

    ACT(ac9, Val(ac5))

    ACT(ab10, 'SecuenciaOp')
    ACT(ac10, Copy(Val(aa:2),Val(lo:1)-5,5))

    ACT(ab12, 'TipoMov')
    ACT(ac12, Copy(Val(aa:2),Val(lo:1)-14,1))
    ACT(ab13, 'FechaOr')
    ACT(ac13, Val(ac8))
    
    ACT(ab14, 'HoraOr')
    ACT(ac14, Val(ac9))
    
    ACT(ab15, 'SecuenciaOr')
    ACT(ac15, Val(ac10))
    
    ACT(ab16, 'FechaHo')
    ACT(ac16, Val(ac4))
    
    ACT(ab17, 'HoraHo')
    ACT(ac17, Val(ac5))
    
    ACT(ab18, 'SecuenciaHo')
    ACT(ac18, Val(ac7))

    if Vacio(val(ac18))
       ACT(ac16, val(ac4))
       ACT(ac17, val(ac5))
       ACT(ac18, val(ac7))
    endif

    ACT(ab21, 'Plazo')
    ACT(ac21, '0')

    ACT(ab24, 'TipoMod')
    ACT(ac24, '')

    ACT(ab26, 'TipoModDe')
    ACT(ac26, '')

    ACT(ab27, 'ComitenteDe')
    ACT(ac27, '')

    ACT(ab28, 'NroOrdenMe')
    ACT(ac28, '')

    ACT(ab29, 'TipoOrd')
    ACT(ac29, '')

    ACT(ab30, 'NrOrdHo')
    ACT(c30, '')

    ACT(ab31, 'MercadoMeOr')
    ACT(ac31, '')

    ACT(ab32, 'MercadoMeDe')
    ACT(ac32, '')

    ACT(ab33, 'NrOferta')
    ACT(ac33, Copy(Val(aa:2),8,17))

    ACT(ab34, 'UsrInput')
    ACT(ac34, UsuarioActivo )
    ACT(ab35, 'Cupon')
    ACT(ab36, 'NrOperacion')
    if NoVacio(val(ac33))
       ACT(ac36, SQL(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOrden = '"~Copy(Val(ac33),13,5)~"' AND (TipoOp = '"~val(ad19)~"' OR  TipoOp = '"~val(ae19)~"') "))
    Endif
  
  *Arma Linea Informe
  IFA
  ACT(a:fac, Val(ac4))
  ACT(b:fac, Val(ac5))
  ACT(c:fac, 'Ofertas')
  ACT(d:fac, Val(ac12))
  ACT(e:fac, Val(ac33))
  ACT(f:fac, Copy(Val(ac33),1,12)~Val(ac10))
  ACT(g:fac, Val(ac33))
  ACT(h:fac, IIF(EqStr(Val(ac19),'C'),'Compra',IIF(EqStr(Val(ac19),'V'),'Venta',IIF(EqStr(Val(ac19),'O'),'Otras',''))))
  ACT(xy:50,BuscarCampo('ESPECIES','Nombre','Codigo',Val(ac20)))
  If NoVacio(val(xy50))
     ACT(gg:fac,Val(xy50))
  else
     ACT(gg:fac,'Especie no esta en FPA')
  Endif
  ACT(i:fac, Val(ac20)~'-'~Val(gg:fac)~'-'~Copy(val(af20),1,8))
  ACN(j:fac, Num(Val(ac22)))
  ACN(k:fac, 0)
  ACN(l:fac, Num(Val(ac23)))
  ACT(m:fac, 'Cartera Propia')
  ACT(n:fac, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CLIENTES','Codigo','CUIT',Val(ac35))),1,20))
  ACT(o:fac, Val(ac36))
  ACN(x1, SQL("Select Count(*) from "~DBO~".LIBORDENES where Fecha='"~IdxDate(fecha(Val(ac4)))~"' and Secuencia = '"~Val(ac7)~"' and TipoMov = '"~Val(ac12)~"'"))
  if Val(x1)>0
     ACT(p:fac,'Error Orden Ya ingresada')
  Else
     ACT(p:fac,'Ok')
  Endif

  SetFont(a:fac..o:fac, 1)
  AlinearCeldas(a:fac..g:fac,'C')
  AlinearCeldas(h:fac..i:fac,'C')
  AlinearCeldas(m:fac..m:fac,'C')
  AlinearCeldas(n:fac..n:fac,'D')

  If Dialogo.Radio1=1 
     if Val(x1)=0
        *************************** Dar de Alta La Orden ********************************
        SQL.ADD(" Insert into "~DBO~".LIBORDENES ( ")
        SQL.ADD(" Mercado,Agente,OpSIOPEL,Fecha,Hora, ")
        SQL.ADD(" FechaCarga,Secuencia, ")
        SQL.ADD(" FechaOp,HoraOp,SecuenciaOp, ")
        SQL.ADD(" TipoOpEv,TipoMov,")
        SQL.ADD(" FechaOr,HoraOr,SecuenciaOr, ")
        SQL.ADD(" FechaHo,HoraHo,SecuenciaHo, ")
        SQL.ADD(" TipoOpOr,Especie,Plazo, ") 
        SQL.ADD(" Cantidad,Precio,TipoMod,Comitente, ")
        SQL.ADD(" TipoModDe,ComitenteDe,NroOrdenMe, ")
        SQL.ADD(" TipoOrd,NrOrdHo,MercadoMeOr,MercadoMeDe, ")
        SQL.ADD(" NrOferta,NrOperacionRef,UsrInput,Cupon,DatosEspecie ")
        SQL.ADD(" ) Values ( ")
        **      Mercado
        SQL.ADD(" '"~Val(ac1)~"', "~Fstr(num(Val(ac2)),0,0)~", '"~Val(ac3)~"', '"~IdxDate(fecha(Val(ac4)))~"', '"~Val(ac5)~"', ")
        **      FechaCarga
        SQL.ADD(" "~SQLAhora~", '"~Val(ac7)~"', ")
        **      FechaOp
        SQL.ADD("  '"~IdxDate(Fecha(Val(ac8)))~"', '"~Val(ac9)~"', '"~Val(ac10)~"', ")
        **      TipoOpEv
        SQL.ADD(" '"~Val(ac11)~"', '"~Val(ac12)~"', ")
        **      FechaOr
        SQL.ADD(" '"~IdxDate(Fecha(Val(ac13)))~"', '"~Val(ac14)~"', '"~Val(ac15)~"', ")
        **      FechaHo
        SQL.ADD(" '"~IdxDate(fecha(Val(ac16)))~"', '"~Val(ac17)~"', '"~Val(ac18)~"', ")
        **      TipoOpOr
        SQL.ADD(" '"~Val(ac19)~"', '"~Val(ac20)~"', "~Fstr(Val(ac21),0,0)~", ")
        **      Cantidad
*        SQL.ADD(" "~FsTr(num(Val(ac22))/10000,0,4)~", "~Fstr(Num(Val(ac23))/100000000,0,8)~", '"~Val(ac24)~"', '"~Val(ac25)~"',")
        SQL.ADD(" "~FsTr(num(Val(ac22)),0,4)~", "~Fstr(Num(Val(ac23)),0,8)~", '"~Val(ac24)~"', '"~Val(ac25)~"',")
        **      TipoModDe
        SQL.ADD(" '"~Val(ac26)~"', '"~Val(ac27)~"', '"~Val(ac28)~"', ")
        **      TipoOrd 
        SQL.ADD("  '"~Val(ac29)~"', "~Fstr(Val(ac30),0,0)~",'"~Val(ac31)~"','"~Val(ac32)~"', ")
        **      NrOferta
        SQL.ADD(" '"~Val(ac33)~"', '"~Val(ac36)~"', '"~Val(ac34)~"','"~Val(ac35)~"','"~Val(af20)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC
      Endif
  Endif
Endif
Proximo

** Graba Flag de Ordenes Recibidas
ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSMERCADO where Mercado = 'MAE' and Registro = '0620' and Fecha='"~IdxDate(fecha(Val(c4)))~"' "))
if Val(x1)=0
   Message('Insert Flag 0620')
   SQL.ADD("Insert into "~DBO~".FLAGSMERCADO ( ")
   SQL.ADD(" Mercado, Registro, Fecha, Cantidad ")
   SQL.ADD(" ) Values ( ")
   SQL.ADD(" 'MAE', ")
   SQL.ADD(" '0620', ")
   SQL.ADD(" '"~IdxDate(fecha(Val(c4)))~"', ")
   SQL.ADD(" 0 ")
   SQL.ADD(" ) ")
   SQL.NEW
   SQL.EXEC
Endif
  
Formatoceldas(k:7..k:fac, EXE('F0'))
Formatoceldas(j:7..j:fac, EXE('F2'))
Formatoceldas(l:7..l:fac, EXE('F9'))

ACO(1,10)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,15)
ACO(6,15)
ACO(7,15)
ACO(8,10)
ACO(9,20)
ACO(10,12)
ACO(11,6)
ACO(12,10)
ACO(13,12)
ACO(14,9)
ACO(16,15)
Impresion(1,2)
Impresion(2,0)
Impresion(3,1)
Impresion(4,1)

SetPrintFit(3,65)
SetMargins(0,0,0,2)
LimitesVision(p:fac)
