MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'       ;1;1; ;  ;  ;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1<=FSys;'Fecha Invalida';NO;FSys;
  Vehiculo1: 'Vehiculo:'   ;2;1; ;NO;SI;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Lista1   : 'Mercado'     ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".MERCADOS Where TipoNegocio Like '%FT%' or (TipoNegocio Like '%FM%' and MTM<>0) ")
  Lista2   : 'Producto'    ;;;;;;;;;;;'Titulo|Moneda'
  Cliente1 : 'Cliente'     ;3;1; ;NO;NO;
  Check1   : 'Procesa'     ;1;2; ;NO;NO;;;;1;
  Check2   : 'Ejec.Liq.'   ;2;2; ;NO;NO;;;;1;
  Check3   : 'Contingencia';3;2; ;NO;NO;;;;0;
FinDialogo

if not ok
  Cancelar
endif

If Eqstr(VAR('MTMRFXSIG') , 'SI')
     ACD(fe:3, Habiles(Dialogo.Fecha1, +1, 'ARG'))
Else
     ACD(fe:3, Dialogo.Fecha1)
Endif
    
If Eqstr(VAR('MTMMAESIG') , 'SI')
     ACD(fe:2, Habiles(Dialogo.Fecha1, +1, 'ARG'))
Else
     ACD(fe:2, Dialogo.Fecha1)
Endif

IF NoVacio(Dialogo.Lista1)
    ACT(LS:1, Dialogo.Lista1)
ELSE
    ACT(LS:1, SQLSet("Select Codigo from "~DBO~".MERCADOS Where TipoNegocio Like '%FT%' or (TipoNegocio Like '%FM%' and MTM<>0) "))
ENDIF
IF NoVacio(Dialogo.Lista2)
    ACT(LS:2, Dialogo.Lista2)
ELSE
    ACT(LS:2, 'Titulo|Moneda')
ENDIF

***---Controlo si ya fue procesado para cada mercado y producto seleccionado
Recorrer&k 1, Elementos(Val(LS:1))
    Recorrer&j 1, Elementos(Val(LS:2))
    IF SQL(" Select 1 From "~DBO~".MTM Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND Mercado = '"~ItemLista(Val(LS:1), &k)~"' AND Producto = '"~ItemLista(Val(LS:2), &j)~"' AND TipoMTM='MTM' AND Estado = 'PRO' ") <> 1
        *MessageBox('MTM NO Fue Procesado para Mercado '~ItemLista(Val(LS:1), &k)~', - Producto '~ItemLista(Val(LS:2), &j)~', - Fecha '~Dialogo.Fecha1)
        ELSE
            ***---Armo lista de productos a anular
            ACT(LS:4, Val(LS:4)~ItemLista(Val(LS:2), &j)~'|')
        ENDIF
    Proximo
    ***---Armo lista de mercados a anular
    ACT(LS:3, Val(LS:3)~ItemLista(Val(LS:1), &k)~'|')
Proximo
SetFilaActual(1)
Recorrer&k 1, Elementos(Val(LS:3))
  * Recorre Mercados
  Recorrer&j 1, Elementos(Val(LS:4))
    * Recorre Productos
    IFA
    ACT(aa:FAC, ItemLista(Val(LS:3), &k))
    ACT(ab:FAC, ItemLista(Val(LS:4), &j))
        ***---Chequeo si hay alguna liquidacion para la fecha
        ACN(BD:1, 0)
        SQL.ADD(" Select 1 From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
        SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
        SQL.ADD(" AND O.Mercado = '"~ItemLista(Val(LS:3), &k)~"' ")
        IF EqStr(Val(ab:FAC),'Moneda')
            SQL.ADD(" AND O.TipoOp IN ('FXCF','FXVF') ")
        ENDIF
        IF EqStr(Val(ab:fac),'Titulo')
            SQL.ADD(" AND O.TipoOp IN ('TICF','TIVF') ")
        ENDIF
        *SQL.ADD(" AND M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")           
        SQL.ADD(" AND M.FechaMov =  ")
        SQL.ADD(" CASE WHEN O.Mercado4 = '"~VAR('AMBROFEX')~"' THEN '"~IdxDate(VAL(fe:3))~"' ") 
        SQL.ADD("      WHEN O.Mercado4 = '"~VAR('AMBMAE')~"' THEN  '"~IdxDate(VAL(fe:2))~"' ")        
        SQL.ADD("      ELSE '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" END ")       
               
        SQL.ADD(" AND M.NrMov >= 1000 ")
        if NoVacio(Dialogo.Cliente1)
          SQL.ADD("   and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
        endif
        Recorrer SQL
            DFA
            MessageBox('Existen liquidaciones Relizadas para la fecha. Mercado: '~ItemLista(Val(LS:3), &k)~' , Producto: '~ItemLista(Val(LS:4), &j))
            ACN(BD:1, 1)
** FJL 02/01/19 - Mostraba un mensaje por cada operacion liquidada
            Break
        Proximo
        IF Val(BD:1) = 0
            SQL.ADD(" Select O.NrOperacion, O.Mercado4, M.MTM ")
            SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MTMDIARIO M ")
            SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
            SQL.ADD(" AND O.Mercado = '"~ItemLista(Val(LS:3), &k)~"' ")
            SQL.ADD(" AND M.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND M.TipoMTM = 'MTM' ")
            if NoVacio(Dialogo.Cliente1)
              SQL.ADD("   and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
            endif
            Recorrer SQL
              if Dialogo.Check1=1
                SQL.ADD(" Update "~DBO~".OPERACIONES ")
                SQL.ADD(" Set TotalAux3 = TotalAux3 - "~Fstr(fbn('MTM'), 0, 2)~" ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.NEW
                *SQL.EXEC
                SQL.ADD(" Delete "~DBO~".MTMDIARIO ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
                SQL.ADD(" AND TipoMTM = 'MTM' ")
                SQL.NEW
                *SQL.EXEC
                SQL.ADD("Delete "~DBO~".MOVPENDIENTES ")
                SQL.ADD("Where NrOperacion = '"~fbn('NrOperacion')~"' ")                
                *SQL.ADD(" AND FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
                if Eqstr(fbn('Mercado4'), VAR('AMBROFEX'))
                    SQL.ADD("   And  FechaMov = "~IdxDate2(Val(fe:3))~" ")
                else             
                if Eqstr(fbn('Mercado4'), VAR('AMBMAE'))
                        SQL.ADD("   And  FechaMov = "~IdxDate2(Val(fe:2))~" ")
                    else
                        SQL.ADD("   And  FechaMov = "~IdxDate2(Dialogo.Fecha1)~" ")
                    endif
                endif 
                
                SQL.ADD(" AND NrMov >="~FSTR(1000,1,0))
                
                SQL.NEW
                *SQL.EXEC
              endif
            Proximo
            if Dialogo.Check1=1
              SQL.ADD(" Update "~DBO~".MTM ")
              SQL.ADD(" Set Estado = 'ANU', ")
              SQL.ADD(" FechaEstado = "~SQLAhora~" ")
              SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
              SQL.ADD(" AND Producto = '"~ItemLista(Val(LS:4), &j)~"' ")
              SQL.ADD(" AND Mercado = '"~ItemLista(Val(LS:3), &k)~"' ")
              SQL.ADD(" AND TipoMTM = 'MTM' ")
              SQL.ADD(" AND Estado = 'PRO' ")
              SQL.NEW
              SQL.EXEC
            endif
        ENDIF
    Proximo
Proximo
Messagebox('Se procesó la anulacion de '~VAL(LS:3)~' '~val(LS:4))
