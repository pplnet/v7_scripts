CrearDialogo
    Directorio1: 'Path TXT' ;1;1;1;SI;SI;;;;Var('PATHLOG')
    String1: 'Archivo TXT'  ;2;1;1;SI;SI;;;;'tabla cbu - ctas contables.txt'
    Entorno1: 'Entorno'    ;;;;NO;;NoVacio(Dialogo.Entorno1);'Debe indicar el entorno';NO;'BFSA'
FinDialogo

If Not ok
     Cancelar
Endif

**Validar Path 
let &pf ''
If ExisteDirectorio(Dialogo.Directorio1)
    If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
        let &pf Dialogo.Directorio1~Dialogo.String1
    Else
        let &pf Dialogo.Directorio1~'\'~Dialogo.String1
        If Not ExisteArchivo(Dialogo.Directorio1~'\'~Dialogo.String1)
            Cancelar('El Archivo '~Dialogo.String1~' no existe en el directorio: '~Dialogo.Directorio1)
        EndIf
    Endif
Else
    Cancelar('El directorio '~Dialogo.Directorio1~' no existe')
EndIf

AbrirAscii(&pf, 0)
If not ok
     Cancelar
Endif
LeerAscii
MessageBox('Importando datos')
*****************************************************************************************************************
Recorrer&i 1,100000
    let &leer LeerAscii
    If NoVacio(&leer)
       let &cbu Copy(&leer,1,22)
       let &ctacble Copy(&leer,23,32)
    
       **Actualizamos campo CuentaContable en la tabla CUENTAS 
       If NoVacio(SQL("Select 1 from "~DBO~".CUENTAS Where CBU = '"~&cbu~"' "))
       SQL.ADD("UPDATE "~DBO~".CUENTAS Set CuentaContable1 = '"~&ctacble~"' ")
       SQL.ADD("Where CBU = '"~&cbu~"' ")
       SQL.NEW
       SQL.EXEC
       Endif
    
       **Asignamos la moneda a una variable
       SQL.ADD("Select Especies from "~DBO~".CUENTAS Where CuentaContable1 = '"~&ctacble~"' ")
       Recorrer SQL
       let &moneda ItemLista(fbn('Especies'),1)
       Proximo
   **Insertamos CuentaContable en la tabla CONTABILIDAD
        If SQL("Select 1 from "~DBO~".CONTABILIDAD Where Codigo = '"~&ctacble~"' ") = 1
           SQL.ADD("UPDATE "~DBO~".CONTABILIDAD Set Nombre = 'Cuenta Bancaria', ")
           SQL.ADD("Moneda ='"~&moneda~"' , Entorno = '"~Dialogo.Entorno1~"' ")
           SQL.NEW
           SQL.EXEC
        Else
           SQL.ADD("INSERT INTO "~DBO~".CONTABILIDAD (Codigo,Nombre,Moneda,Entorno) VALUES")
           SQL.ADD("('"~&ctacble~"','Cuenta Bancaria','"~&moneda~"','"~Dialogo.Entorno1~"')") 
           SQL.NEW
           SQL.EXEC
        Endif
    Break
    Endif
Proximo

CerrarAscii