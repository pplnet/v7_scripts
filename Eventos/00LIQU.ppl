   'Comit.CE'      ;bf:1..af:fac;NO;;;80 ;STRING;100;RGB(232,232,255);IIF(Eqstr(Val(ff:FLB),Val(T:FLB)),'',BuscarCampo('CUENTAS','NrDepositante','Codigo',Val(o:FLB)) )
   'Nro.Cta. CE'   ;bg:1..ag:fac;NO;;;80 ;STRING;100;RGB(232,232,255);IIF(Eqstr(Val(ff:FLB),Val(T:FLB)),'',BuscarCampo('CUENTAS','Numero','Codigo',Val(o:FLB)) )

