   'Cta.Com.Vh'    ; w:1..w:fac ;EqStr(VAR('LIQCOMMO'),'NO');[Incluido(Val(s:flb),var('MERCAACMC')) y ClienteCuenta(SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' "),Val(w:flb))] o ClienteCuenta(Val(q:flb),Val(w:flb),Val(ap:flb)) o Val(x:flb)=0  o Eqstr(Copy(Val(C:FLB), 1, 2), 'MM') o Val(ab:flb)=1 o Incluido(Val(c:FLB),'PICO|PICD|');'La Cta Moneda '~Val(w:FLB)~' del Vehiculo '~Val(q:FLB)~' es incorrecta Op.'~Val(b:flb);70 ;TABLA ;'Cuentas';'Codigo';'Codigo;Nombre';IIF(Incluido(Val(r:flb),var('MERCAACMC'))," Cliente   = '"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Val(r:flb)~"' ")~"' and Estado='HAB' AND (Especies like '%"~Val(ap:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%')", " (Cliente='"~Val(q:flb)~"'  and Estado='HAB' AND (Especies like '%"~Val(ap:flb)~"%'  OR Especies LIKE '%"~Val(mm:flb)~"%') and "~IIF(NoVacio(Val(s:FLB)),"Mercado = '"~Val(s:FLB)~"' "," Codigo=Codigo ")~")");IIF(Incluido(Val(c:flb),'PICO|PICD|'),RGB(232,232,255),RGB(255,255,213));IIF(Incluido(Val(c:flb),'MMPF|MMPFCE'), SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(q:flb)~"' AND Estado='HAB' AND Mercado= '"~Val(s:flb)~"' AND (Especies LIKE '%MONEDA%' OR Especies LIKE '%"~Val(ap:flb)~"%') "),Val(w:flb));NO;NO;
   'Depos.'        ;ae:1..ae:fac;NO;;;80 ;STRING;100;RGB(232,232,255);BuscarCampo('CUENTAS','Comitente','Codigo',Val(l:FLB))
