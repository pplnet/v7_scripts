   'SWIFT CE'      ;bi:1..ai:fac;NO;;;80 ;STRING;100;RGB(232,232,255);IIF(Eqstr(Val(ff:FLB),Val(T:FLB)),'',BuscarCampo('CUENTAS','Alias3','Codigo',Val(o:FLB)) )
   'Cta.Bco.Cli.CE';bj:1..aj:fac;NO;;;80 ;STRING;100;RGB(232,232,255);IIF(Eqstr(Val(ff:FLB),Val(T:FLB)),'',BuscarCampo('CUENTAS','Alias1','Codigo',Val(o:FLB)) )
   'Sub Cta CE'    ;bk:1..ak:fac;NO;;;80 ;STRING;100;RGB(232,232,255);IIF(Eqstr(Val(ff:FLB),Val(T:FLB)),'',BuscarCampo('CUENTAS','Alias2','Codigo',Val(o:FLB)) )
FinListBox

if not ok
  if Val(z:2)=1
    * Procesa
    Cancelar('Evento Cancelado.')
  else
    MessageBox('Evento Cancelado. No Procesa')
  Endif
Endif

Recorrer&i 1, fac
  If Val(x:&i)=1      
    If Val(z:2)=1  
      * Procesa
      * --- Actualiza las cuentas de la operacion
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
      IF NOT INCLUIDO(Val(c:&i), 'TIC|TIV|TIFC|TIFV|TIDE|TIPO|TICO|TICT|TCOPRI|TCPCEM|TICF|TIVF|EQC|EQV')
          If Incluido(Val(c:&i), 'MMPF|MMPFCE')
           SQL.ADD(" Mercado  = '"~Val(r:&i)~"', ")
           SQL.ADD(" Mercado2 = '"~Val(s:&i)~"', ")
          Endif
          if Incluido(Val(c:&i), 'FXCF|FXVF|')
            * ctas cliente
            SQL.ADD(" Cuenta1 = '"~Val(l:&i)~"', ")
            SQL.ADD(" Cuenta4 = '"~Val(o:&i)~"', ")
            * ctas vehiculo
            SQL.ADD(" Cuenta2 = '"~Val(m:&i)~"', ")
            SQL.ADD(" Cuenta3 = '"~Val(n:&i)~"'  ")
          else
          ** FJL 02/01/19 - Se agrega opcion para ICL
            if Incluido(Val(c:&i), 'PICO|PICD|')
              * cta cliente
              SQL.ADD(" Cuenta1 = '"~Val(l:&i)~"', ")
              * cta vehiculo
              SQL.ADD(" Cuenta2 = '"~Val(m:&i)~"' ")
            else
              if Incluido(Val(c:&i), 'MMCREM|')
                SQL.ADD(" Cuenta1 = '"~Val(l:&i)~"' ")
                * SQL.ADD(" ,Cuenta2 = '"~Val(m:&i)~"' ")
              else
                  * ctas cliente
                  SQL.ADD(" Cuenta3 = '"~Val(l:&i)~"', ")
                  SQL.ADD(" Cuenta4 = '"~Val(o:&i)~"', ")
                  * ctas vehiculo
                  SQL.ADD(" Cuenta1 = '"~Val(m:&i)~"', ")
                  SQL.ADD(" Cuenta2 = '"~Val(n:&i)~"'  ")
              endif
            endif    
          endif    
      Else
        * ctas cliente
        SQL.ADD(" Cuenta1 = '"~Val(l:&i)~"', ")
        SQL.ADD(" Cuenta4 = '"~Val(o:&i)~"', ")
        * ctas vehiculo
        SQL.ADD(" Cuenta2 = '"~Val(m:&i)~"', ")
        SQL.ADD(" Cuenta3 = '"~Val(n:&i)~"'  ")
        If EqStr(VAR('LIQCOMMO'),'NO')
           * ctas comisiones Cliente y Vehiculo
           SQL.ADD(" , ")
           SQL.ADD(" Cuenta5 = '"~Val(v:&i)~"', ")
           SQL.ADD(" Cuenta6 = '"~Val(w:&i)~"'  ")
        Endif
      Endif
      SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"' ")
      SQL.NEW
      SQL.EXEC
** FJL 05/07/18 - Por posciones 121/122 
*      SQL.ActualizarMovimientos3(Val(B:&i),SI,NO,NO,NO,NO)
      SQL.ActualizarMovimientos3(Val(B:&i),SI,NO,NO,SI,NO)
      SQL.EXEC

      if Incluido(Val(c:&i), 'FXCF|FXVF|') y Incluido(Val(an:&i),VAR('MENEFFX')) y EqStr(Val(nr:&i),'')
         EjecutarEvento('NUBNDF',NrOperacion1=Val(b:&i))
      Endif
      
      * --- Inserta Confirmacion
      ACN(cf:1,0)
      ACN(cf:1, SQL("SELECT MAX(NrConfirmacion) FROM "~DBO~".CONFIRMACIONESOP WHERE NrOperacion = '"~Val(b:&i)~"' ") )
      SCN(cf:1,1)
      SQL.ADD(" INSERT INTO "~DBO~".CONFIRMACIONESOP ( ")
      SQL.ADD(" NrOperacion, NrConfirmacion, Tabla, ")
      SQL.ADD(" Contacto, Fecha, Observaciones, Usuario ")
      SQL.ADD(" ) VALUES ( ")
      SQL.ADD(" '"~Val(b:&i)~"', "~FSTR(Val(cf:1),0,0)~", 'OPERACIONES', ")
      SQL.ADD(" '"~Copy(Val(p:&i),1,50)~"', "~SQLAhora~", '"~Val(u:&i)~"', '"~USUARIOACTIVO~"' ) ")
      SQL.NEW
      SQL.EXEC

      * --- Modifica Instancia

      
      if(EqStr(VAL(C:&i), 'MMCREM'))
        IF Vacio(BuscarCampo('OPERACIONES','NrOperacion3','NrOperacion',Val(b:&i)))
           SQL.ADD("UPDATE "~DBO~".OPERACIONES SET NrOperacion3=NrOperacion WHERE NrOperacion='"~Val(b:&i)~"'")
           SQL.New
           SQL.Exec
        Endif   
        SQL.ADD("SELECT NrOperacion, NrOperacion3 from "~DBO~".OPERACIONES where NrOperacion3 ='"~Val(b:&i)~"'")
        Recorrer SQL
          EjecutarEvento('CBOINS', String1= FBN['NrOperacion'], Radio1=0, Radio2=2, Entero1=0, Entero2=92)
        proximo
      else
        ACT(AZ:4, 'OPERACIONES')
        ACT(AZ:3, Val(b:&i) )
        ACN(AZ:5, 10)
        ACN(AZ:6,  7)
        (.'MODIINSTAN'.)
      endif
    Endif
  Endif
Proximo
