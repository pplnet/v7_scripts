*Hojavisible(SI)
mOSTRARCuadroDeMensajes
************************************************************************************************
*** Actualizacion de CER
************************************************************************************************
CrearDialogo
 Fecha1       : 'Fecha'     ;;;;;;;;;Fsys;
***--- NrOperacion1 : "Operacion" ;;;;;;;;;;;;;;"TipoOp In ('MMPFCE') and   FechaOp  < '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' and (CB9 is Null  or CB9 = '0') "
FinDialogo

if Not Ok
  Cancelar
endif
ACD(FE:99, Dialogo.Fecha1)

SQL.ADD("Select Cliente1, DiasAnio, PorImpuesto, TipoOp, Cuotas1, Cantidad, PeriodoInts, ")
SQL.ADD(" MB1, RB4, DiasMes, RB10, CB7, MB2, TipoTasa, Especie, Precio1, FechaOp, FechaVto, ")
SQL.ADD(" NrOperacion, Especie, Cantidad, Plazo, Cuenta3, Precio3, TotalGanancias, TotalAux1, ")
SQL.ADD(" Vehiculo1, Book1 ")
SQL.ADD(" from "~DBO~".OPERACIONES ")
SQL.ADD(" Where TipoOp='MMPFCE' ")
SQL.ADD(" AND FechaOp <= '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD(" AND FechaVto >= '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD(" Order By Book1 ")
Recorrer SQL
   message(fbn('NrOperacion'))
   ACN(BD:1, 0)
   ***---Borro Devengados de corridas anteriores
   SQL.ADD(" Delete "~DBO~".MOVDEVENGADOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND TipoDevengado IN ('INTLEN', 'AJCER') AND NrSaldo = 140 AND Fecha = '"~IdxDate(Val(FE:99))~"' ")
   SQL.NEW
   SQL.EXEC
   ***---Obtengo Acumulado anterior
   ACN(TA:1, SQL(" Select Sum(Monto) Monto From "~DBO~".MOVDEVENGADOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND TipoDevengado = 'INTLEN' AND Fecha < '"~IdxDate(Val(FE:99))~"' "))
   acn(PR:2,COTIZACION('CER',,,,fbn['FechaOp']-1,1))
   IF Not Eqstr(fbn('Book1'), Val(BK:1))
* FO 23/12/05 - Ya       SQL.ADD(" Select TipoNegocio, GrupoEspecie, Producto, Responsable, TipoPosicion, Vehiculo ")
       SQL.ADD(" Select  Vehiculo ")
       SQL.ADD(" From "~DBO~".BOOKS ")
       SQL.ADD(" Where Codigo = '"~fbn('Book1')~"' ")
       Recorrer SQL
           DFA
*           ACT(TN:1, fbn('TipoNegocio'))
*           ACT(GE:1, fbn('GrupoEspecie'))
*           ACT(PD:1, fbn('Producto'))
*           ACT(RS:1, fbn('Responsable'))
*           ACT(TP:1, fbn('TipoPosicion'))
           ACT(VH:1, fbn('Vehiculo'))
       Proximo
   ENDIF
   IF fbn('FechaVto') = Val(FE:99)
       IF DiaSem(Val(FE:99)) = 2
           ***---PF que vence un lunes, => hay que devengar sabado y domingo si son del mismo mes
           ***---que proceso
           ACN(XX:1, 0)
           Recorrer&k Habiles(Val(FE:99), -1, 'ARG')+1, Val(FE:99)-1
               IF Mes(&k) = Mes(Val(FE:99))
                   SCN(XX:1, 1)
                   IF Val(XX:1) = 1
                       ***---Fecha desde
                       ACD(FE:77, &k-1)
                   ENDIF
                   acn(PR:3,COTIZACION('CER',,,,&k,1))
                   ***---Capital Indexado a Fecha Proceso
                   ACN(CP:1, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
                   ***---Interes Indexado
                   ACN(II:1, Val(CP:1) * fbn('Precio1') * (fbn('FechaVto')-fbn('FechaOp')) / (100*DiasA(fbn['DiasAnio'], fbn('FechaVto'))))
                   ***---Interes Indexado Acumulado a &k
                   ACN(II:2, Val(CP:1) * fbn('Precio1') * (&k-fbn('FechaOp')+1) / (100*DiasA(fbn['DiasAnio'], &k)))
                   ***---Interes Indexado Diario del dia &k
                   ACN(II:3, Val(II:2) - Abs(Val(TA:1)))
                   ***---Inserto MovDevengado
                   ACD(FE:88, &k)
                   (.'INSMOVDEV'.)
                   ACN(TA:1, Val(II:2))
                   ACN(BD:1, 1)
               ENDIF
           Proximo
           ***---Capital Indexado a Fecha Proceso-1
           acn(PR:3,COTIZACION('CER',,,,Val(FE:77),1))
           ACN(CP:2, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
           ***---Capital Ajustado
           ACN(CP:3, Val(CP:1) - Val(CP:2))
           (.'INSMOVDEV2'.)
       ENDIF
   ELSE
       ACD(FE:88, Val(FE:99))
       IF [[DiaSem(Val(FE:99)) = 6] O [Not EsHabil(Val(FE:99)+1, 'ARG') Y DiaSem(Val(FE:99)) <> 6]] Y Val(FE:99) = FinDeMes(Val(FE:99),NO)
           ***---Viernes fin de mes  o dia previo a un feriado y fin de mes=> calculo devengados hasta
           ***---el fin de mes real (sabado o domingo).
           ACN(XX:1, 0)
           Recorrer&k Val(FE:99), Habiles(Val(FE:99), 1, 'ARG')-1
               IF Mes(&k) = Mes(Val(FE:99))
                   SCN(XX:1, 1)
                   IF Val(XX:1) = 1
                       ***---Fecha desde
                       ACD(FE:77, &k-1)
                   ENDIF
                   acn(PR:3,COTIZACION('CER',,,,&k,1))
                   ***---Capital Indexado a Fecha Proceso
                   ACN(CP:1, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
                   ***---Interes Indexado
                   ACN(II:1, Val(CP:1) * fbn('Precio1') * (fbn('FechaVto')-fbn('FechaOp')) / (100*DiasA(fbn['DiasAnio'], fbn('FechaVto'))))
                   ***---Interes Indexado Acumulado a &k
                   ACN(II:2, Val(CP:1) * fbn('Precio1') * (&k-fbn('FechaOp')+1) / (100*DiasA(fbn['DiasAnio'], &k)))
                   ***---Interes Indexado Diario del dia &k
                   ACN(II:3, Val(II:2) - Abs(Val(TA:1)))
                   ***---Inserto MovDevengado
                   ACD(FE:88, &k)
                   (.'INSMOVDEV'.)
                   ACN(TA:1, Val(II:2))
                   ACN(BD:1, 1)
               ENDIF
           Proximo
           ***---Capital Indexado a Fecha Proceso-1
           acn(PR:3,COTIZACION('CER',,,,Val(FE:77),1))
           ACN(CP:2, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
           ***---Capital Ajustado
           ACN(CP:3, Val(CP:1) - Val(CP:2))
           (.'INSMOVDEV2'.)
       ELSE
           IF [DiaSem(Val(FE:99)) = 2 O Not EsHabil(Val(FE:99) - 1, 'ARG')] Y fbn('FechaOp') < Val(FE:99)
               ***---Lunes o el dia anterior fue feriado => calculo devengados desde el sabado o el
               ***---feriado anterior si es del mismo mes.
               ACN(XX:1, 0)
               Recorrer&k Habiles(Val(FE:99),-1, 'ARG')+1, Val(FE:99)
                   IF Mes(&k) = Mes(Val(FE:99))
                       SCN(XX:1, 1)
                       IF Val(XX:1) = 1
                           ***---Fecha desde
                           ACD(FE:77, &k-1)
                       ENDIF
                       acn(PR:3,COTIZACION('CER',,,,&k,1))
                       ***---Capital Indexado a Fecha Proceso
                       ACN(CP:1, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
                       ***---Interes Indexado
                       ACN(II:1, Val(CP:1) * fbn('Precio1') * (fbn('FechaVto')-fbn('FechaOp')) / (100*DiasA(fbn['DiasAnio'], fbn('FechaVto'))))
                       ***---Interes Indexado Acumulado a &k
                       ACN(II:2, Val(CP:1) * fbn('Precio1') * (&k-fbn('FechaOp')+1) / (100*DiasA(fbn['DiasAnio'], &k)))
                       ***---Interes Indexado Diario del dia &k
                       ACN(II:3, Val(II:2) - Abs(Val(TA:1)))
                       ***---Inserto MovDevengado
                       ACD(FE:88, &k)
                       (.'INSMOVDEV'.)
                       ACN(TA:1, Val(II:2))
                       ACN(BD:1, 1)
                   ENDIF
               Proximo
               ***---Capital Indexado a Fecha Proceso-1
               acn(PR:3,COTIZACION('CER',,,,Val(FE:77),1))
               ACN(CP:2, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
               ***---Capital Ajustado
               ACN(CP:3, Val(CP:1) - Val(CP:2))
               (.'INSMOVDEV2'.)
           ELSE
               acn(PR:3,COTIZACION('CER',,,,Val(FE:99),1))
               ***---Capital Indexado a Fecha Proceso
               ACN(CP:1, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
               ***---Interes Indexado
               ACN(II:1, Val(CP:1) * fbn('Precio1') * (fbn('FechaVto')-fbn('FechaOp')) / (100*DiasA(fbn['DiasAnio'], fbn('FechaVto'))))
               ***---Interes Indexado Acumulado a FE:99
               ACN(II:2, Val(CP:1) * fbn('Precio1') * (Val(FE:99)-fbn('FechaOp')+1) / (100*DiasA(fbn['DiasAnio'], Val(FE:99))))
               ***---Interes Indexado Diario del dia FE:99
               ACN(II:3, Val(II:2) - Abs(Val(TA:1)))
               (.'INSMOVDEV'.)
               ACN(TA:1, Val(II:2))
               ACN(BD:1, 1)
               ***---Capital Indexado a Fecha Proceso-1
               acn(PR:3,COTIZACION('CER',,,,Habiles(Val(FE:99), -1, 'ARG'),1))
               ACN(CP:2, fbn('Cantidad') * Val(PR:3) / Val(PR:2))
               ***---Capital Ajustado
               ACN(CP:3, Val(CP:1) - Val(CP:2))
               (.'INSMOVDEV2'.)
           ENDIF
       ENDIF
   ENDIF
   IF Val(BD:1) = 1
       ***---Retencion de Ganancias
       ACN(RT:1, Val(II:1) * fbn('Precio3') / 100)
       ***---Total Bruto
       ACN(TB:1, Val(CP:1) + Val(II:1) - Val(RT:1))
       SQL.ADD(" Update "~DBO~".OPERACIONES ")
       SQL.ADD(" Set TotalIntereses = "~Fstr(Val(II:1),0,2)~", ")
       SQL.ADD(" TotalBrutoCli1 = "~Fstr(Val(TB:1),0,2)~", ")
       SQL.ADD(" TotalGanancias = "~Fstr(Val(RT:1),0,2)~", ")
       SQL.ADD(" FechaVto2 = '"~IdxDate(Val(FE:88))~"', ")
       SQL.ADD(" Cotizacion1 = "~Fstr(Val(PR:2),0,7)~", ")
       SQL.ADD(" TotalAux3 = "~Fstr(Val(CP:1),0,2)~", ")
***---       SQL.ADD(" TotalAux1 = "~Fstr(Val(TA:1),0,2)~", ")
       SQL.ADD(" Cotizacion2 = "~Fstr(Val(PR:3),0,7)~" ")
       SQL.ADD(" where NrOperacion = '"~fbn('NrOperacion')~"' ")
       SQL.NEW
       SQL.EXEC
       SQL.ActualizarMovimientos3(fbn('NrOperacion'),SI,NO,NO,NO,NO,0)
       SQL.EXEC
   ENDIF
   ACT(BK:1, fbn('Book1'))
Proximo

