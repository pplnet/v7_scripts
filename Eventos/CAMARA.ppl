SQL.ADD(" Select O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPENDIENTES M ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND O.TipoOp IN ('EQC','EQV') ")
SQL.ADD(" AND B.NrBit In ('7','10') ")
SQL.ADD(" AND B.Valor = '1' ")
Recorrer SQL
    DFA
    ACT(LS:1, fbn('NrOperacion')~'|'~Val(LS:1))
Proximo


CrearDialogo
  NrOperacion1: "Nr. Operacion" ;;;;;;Incluido(Dialogo.NrOperacion1, Val(LS:1));'Operacion Invalida.';NO;;;;;;" NrOperacion IN ("~Pipe2Comillas(Val(LS:1))~") "
FinDialogo
 
if not Ok
  Cancelar
endif

ACN(y:1, 0)
ACN(z:1, 0)


SQL.ADD(" SELECT TipoOp, FechaOp, Plazo, FechaVto, Especie, ContraEspecie, Cantidad, Precio1, TotalBrutoCli1, ContraEspecie, PorArancel, ")
SQL.ADD(" TotalImpuestos, NrOperacion FROM "~DBO~".OPERACIONES ")
SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(M:1, fbn('NrOperacion'))
   ACT(a:1, fbn('TipoOp'))
   ACD(b:1, fbn('FechaOp'))
   ACN(c:1, fbn('Plazo'))
   ACD(d:1, fbn('FechaVto'))
   ACT(e:1, fbn('Especie'))
   ACT(f:1, fbn('ContraEspecie'))
   ACN(g:1, fbn('Cantidad'))
   ACN(h:1, fbn('Precio1'))
   ACN(i:1, fbn('TotalBrutoCli1'))
   ACN(l:1, fbn('TotalImpuestos'))
   ACN(k:1, fbn('PorArancel'))
   ACN(n:1, 0)
   ACN(o:1, 0)   
Proximo

ACN(y:1, Val(n:1))

CrearListBox ; 'Arial,8,'
 'Operacion'        ;M:1..M:1;NO;;;80;STRING
 'TipoOp.'          ;a1..A:1;NO;;;60;STRING 
 'FechaOp.'         ;b1..B:1;NO;;;100;FECHA
 'Plazo'            ;c1..C:1;NO;;;50;NUMERO;'###'
 'FechaVto.'        ;d1..D:1;NO;;;100;FECHA
 'Especie'          ;e1..E:1;NO;;;70;STRING
 'Moneda'           ;f1..F:1;NO;;;70;STRING
 'Cantidad'         ;g1..G:1;NO;;;90;NUMERO;'##,###,###.##'
 'Precio'           ;h1..H:1;NO;;;110;NUMERO;'###.########'
 'Monto'            ;i1..I:1;NO;;;120;NUMERO;'##,###,###.##'
 'Arancel Actual'   ;l1..L:1;NO;Val(l:1)>0;'El monto debe ser positivo.';120;NUMERO;'##,###,###.##'
 '% Arancel Actual' ;k1..K:1;NO;;;140;NUMERO;'###.######'
 'Arancel Nuevo'    ;n1..N:1;SI;Val(l:1)>0;'El monto debe ser positivo.';120;NUMERO;'##,###,###.##';Var('COLOR');
 '% Arancel Nuevo'  ;o1..O:1;NO;;;140;NUMERO;'###.######';;Val(N:FLB)*100/Val(I:FLB);
FinListBox

IF Not OK
    Cancelar
ELSE
    if Val(n:1)<>Val(y:1)
       SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
       SQL.ADD("SET    PorArancel = "~Fstr(Val(o:1), 0, 8)~", TotalImpuestos = "~Fstr(Val(n:1), 0, 2)~" ")
       SQL.ADD("WHERE  NrOperacion= '"~Dialogo.NrOperacion1~"' ")
       SQL.NEW
       SQL.EXEC
       SQL.ActualizarMovimientos2(Dialogo.NrOperacion1,SI,NO,NO,NO)
       SQL.EXEC
    endif
ENDIF