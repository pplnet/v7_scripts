CrearDialogo
   Vehiculo1  : 'Vehiculo';;;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;Var('VEHICULODE');
   Fecha1     : 'F. Desde'   ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Fecha2     : 'F. Hasta'   ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
   NrTrans1   : 'Nr.Trans'
FinDialogo

If Not ok
   Cancelar
Endif

SQL.ADD(" SELECT T1.Vehiculo1,T1.Cliente1,T1.Cuenta1,T1.Cuenta2,T1.Fecha1,T1.Fecha2,T1.Especie,T1.Mercado1,T1.Cantidad1, ")
SQL.ADD("        T1.TipoTr2,T1.NrTrans,T1.NrTransRef1,T1.Cupon1,T1.Cantidad2, T1.RB5 ")
SQL.ADD("   FROM "~DBO~".TRANSACCIONES2 T1, "~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("  WHERE T1.TipoTr2 IN ('DENOP','RENOP','TRNOP') ")
SQL.ADD("    and T1.Fecha1 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2) )
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD(" and T1.NrTrans='"~Dialogo.NrTrans1~"' ")
EndIf
SQL.ADD(" and T1.NrTrans=OB.NrOperacion ")
* Ver las instancias
SQL.ADD("    and OB.NrBit in(110,111) ") 
SQL.ADD("    and OB.Valor='1' ")
SQL.ADD("    and NOT EXISTS (SELECT T2.NrTrans FROM "~DBO~".TRANSACCIONES2 T2 WHERE T2.NrTransRef1=T1.NrTrans) ")
SQL.ADD("  Order By Fecha1 ")

Recorrer SQL

   SCN(ha1, 1)
   ACT(ab:Val(ha1), FBN['NrTrans'])
   ACT(ac:Val(ha1), FBN['TipoTr2'])
   ACD(ad:Val(ha1), FBN['Fecha1'])
   ACD(ae:Val(ha1), FBN['Fecha2'])
   ACT(af:Val(ha1), FBN['Especie'])
   ACT(ag:Val(ha1), FBN['Cliente1'])
*   ACT(ah:Val(ha1), FBN['Cliente3'])
*   ACT(ai:Val(ha1), FBN['Cliente4'])
*   ACT(aj:Val(ha1), FBN['ComitenteExt'])
   ACN(ak:Val(ha1), FBN['Cantidad1'])
   ACN(al:Val(ha1), FBN['Cantidad2'])
*   ACN(am:Val(ha1), FBN['Cambio1'])

   ACT(an:FAC,'')

Proximo

IF Val(ha1) < Val(de1)
   Cancelar("No se encontraron Transferencias Inmediatas sin confirmar")
ENDIF

CrearListBox ; 'MS Sans Serif,8,';'Confirmacion de Movimientos no operativos'
   'Marca'         ; aa:Val(de1)..aa:Val(ha1);SI;SI;; 30;CHECK ; RGB(251,253,181)
   'Nr Trans'      ; ab:Val(de1)..ab:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Tipo'          ; ac:Val(de1)..ac:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'F. Trans'      ; ad:Val(de1)..ad:Val(ha1);NO;SI;; 80;FECHA ;RGB(175,200,228)
   'F. Matcheo'    ; ae:Val(de1)..ae:Val(ha1);NO;SI;; 80;FECHA ;RGB(175,200,228)
   'Especie'       ; af:Val(de1)..af:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Cliente'       ; ag:Val(de1)..ag:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Depos. Origen' ; ah:Val(de1)..ah:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Codigo Depos.' ; ai:Val(de1)..ai:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'Comitente Ext.'; aj:Val(de1)..aj:Val(ha1);NO;SI;; 80;STRING;;RGB(175,200,228)
   'C.N.'          ; ak:Val(de1)..ak:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.####';RGB(175,200,228)
   'C.R.'          ; al:Val(de1)..al:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.####';RGB(175,200,228)
   'Monto'         ; am:Val(de1)..am:Val(ha1);NO;SI;; 80;NUMERO;'##,###,###.##';RGB(175,200,228)
FinListBox

IF Not Ok
   Cancelar
ENDIF

* Aca confirmo los movimientos 101 de las Transferencias Inmediatas
Recorrer&j Val(de1), Val(ha1)

   IF Val(aa:&j) = 1

    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor=0 WHERE NrOperacion='"~FBN['NrTrans']~"' ")
    SQL.NEW
    SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor=1 WHERE NrOperacion='"~FBN['NrTrans']~"' and NrBit=111  ")
    SQL.NEW
    SQL.EXEC

    SQL.ActualizarMovimientosT2(fbn['NrTrans'],SI,NO,NO,NO)           
