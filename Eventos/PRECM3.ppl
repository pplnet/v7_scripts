**--PRECM3 - Auxiliar 3 Prec.Mutos (Anulacion)
*ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1:'Op Precan'       ;;;;  ;;SQL("Select 1 From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' and TipoOp = 'MMPREC' and MB3 = 1 and CB6 = 1 ") = 1;'Operacion Invalida';NO;;;;;;" TipoOp = 'MMPREC' and MB3 = 1 and CB6 = 1 "
  Check1      :'Procesa'         ;;;;SI;;;;;0
  Check2      :'Automatico'      ;;;;NO;;;;;0
FinDialogo
If not Ok
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(a:1, 'Op.Precan')
ACT(a:2, 'Op.Original')
ACT(a:3, 'Op.Afectada')
ACT(a:4, 'Tipo Op')
ACT(a:5, 'Tipo Canc.')
ACT(a:6, 'Mon Orig.')
ACT(a:7, 'Mon Canc.')
ACT(a:8, 'T.C.')
ACT(a:9, 'Cuotas')
ACT(a:10, 'Cuota Vig.')
ACT(a:11, 'Fecha Precan')
ACT(a:12, 'Plazo a Dev')
ACT(a:13, 'F.Fin Cuota Vig')
ACT(a:14, 'Ord.Can.Capital')
ACT(a:15, 'Ord.Can.')
ACT(a:16, 'Capital Vigente')
ACT(a:17, 'RB8')
ACT(a:18, 'RB6')

ACT(b:20, 'Mon.Can.')
ACT(c:20, 'Mon.Orig.')

ACT(a:21, 'Int.')
ACT(a:22, 'Imp.s/Int')
ACT(a:23, 'Gastos')
ACT(a:24, 'Imp.s/Gtos')
ACT(a:25, 'Capital')
ACT(a:26, 'Total')

ACT(a:29, 'Cap.Restante')
ACT(a:30, 'Cap.a Asignar')

ACT(a:32, 'TasaPrecan')
ACT(a:33, 'Tasa WH')
ACT(a:35, 'Op Vinculada')

SetFont(a:1..a:35, 2)

SQL.ADD("Select * from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
recorrer SQL
  ACT(b:1, fbn('NrOperacion'))
  ACT(c:1, fbn('TipoOp'))
  ACT(b:2, fbn('NrOperacion6'))
  ACT(c:2, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion6')))
  ACT(b:3, fbn('NrOperacion5'))
  ACT(c:3, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion5')))
  ACN(b:4, fbn('MB3'))
  if fbn('MB3')=0
    ACT(c:4, 'Prestamo')
  else
    if fbn('MB3')=1
      ACT(c:4, 'Colocacion')
    else
      ACT(c:4, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACN(b:5, fbn('RB7'))
  if fbn('RB7')=0
    ACT(c:5, 'Parcial')
  else
    if fbn('RB7')=1
      ACT(c:5, 'Total')
    else
      ACT(c:5, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACT(b:6, fbn('ContraEspecie2'))
  ACT(b:7, fbn('Especie'))
  ACN(b:8, fbn('TipoCambio'))
  ACN(c:8, fbn('TipoCambio')^iif(EqStr(Modo(fbn('Especie'),fbn('ContraEspecie2')),'DIR'),1,-1))
  ACN(b:9, fbn('Cuotas1'))
  ACN(b:10, fbn('Cuotas2'))
  ACD(b:11, fbn('FechaPrecan'))
  ACN(b:12, fbn('Plazo2'))
  ACN(b:14, fbn('RB12'))
  if fbn('RB12')=0
    ACT(c:14, 'PEPS')
  else
    if fbn('RB12')=1
      ACT(c:14, 'UEPS')
    else
      if fbn('RB12')=2
        ACT(c:14, 'Prorrateo')
      else
        ACT(c:14, 'Indefinido')
        ACN(y:1, 1)
      endif
    endif
  endif
  ACN(b:15, fbn('RB7'))
  if fbn('RB7')=0
    ACT(c:15, 'Ints + Gtos')
  else
    if fbn('RB7')=1
      ACT(c:15, 'Gtos + Ints')
    else
      ACT(c:15, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACN(b:16, fbn('TotalNetoCli1'))
  ACN(b:17, fbn('RB8'))
  ACN(b:18, fbn('RB6'))
  ACN(b:32, fbn('TasaPrecan'))
  ACN(b:33, fbn('TotalAux1'))
  ACT(b:35, fbn('NrOperacion3'))

  * Intereses
  ACN(b:21, Round(fbn('IntDevengados1')/Val(c:8),2))
  ACN(c:21, Round(fbn('IntDevengados1'),2))

  * impuestos Sobre Intereses
  ACN(b:22, 0)
  ACN(c:22, 0)

  if fbn('RB9')=0
    ACN(b:23, 0)
    ACN(c:23, 0)
    ACT(d:23, 'Sin Gastos')
  else
    ACN(b:23, Round(fbn('TotalGastos'),2))
    ACN(c:23, Round(fbn('TotalGastos')*Val(c:8),2))
  endif

  * impuestos Sobre Gastos
  ACN(b:24, 0)
  ACN(c:24, 0)

  if fbn('RB7')=0
    * Cancelacion Parcial
    * Monto Total
    ACN(b:26, Round(fbn('Cantidad'),2))
    ACN(c:26, Round(fbn('TotalNEtoCli2'),2))
    ACT(d:26, 'Dato')
    * Capital
    ACN(b:25, Round(Val(b:26)-Sum(b:21..b:24),2))
    ACN(c:25, Round(Val(c:26)-Sum(c:21..c:24),2))
    ACT(d:25, 'Calculo')
  else
    * Cancelacion Total
    * Capital
    ACN(b:25, Round(fbn('TotalNetoCli1')*Val(c:8),2))
    ACN(c:25, Round(fbn('TotalNetoCli1'),2))
    ACT(d:25, 'Dato')
    * Monto Total
    ACN(b:26, Round(Sum(b:21..b:25),2))
    ACN(c:26, Round(Sum(c:21..c:25),2))
    ACT(d:26, 'Suma')
  endif

proximo

ACN(c:29, Val(b:16)-Val(c:25))
ACN(b:30, Val(b:25))
ACN(c:30, Val(c:25))

SetFont(b:1..c:35, 1)
SetFont(b:20..c:20, 2)

FormatoCeldas(b:8..c:8,Exe('F8'))
FormatoCeldas(b:9..c:10,Exe('F0'))
FormatoCeldas(b:12..c:12,Exe('F2'))
FormatoCeldas(b:21..c:26,Exe('F2'))

if Dialogo.Check1=1
  SQL.ADD("Delete "~DBO~".CUOTAS where NrOperacion = '"~Val(b:3)~"' ")
  SQL.NEW
  SQL.EXEC

  SQL.ADD("INSERT INTO "~DBO~".CUOTAS ( ")
  SQL.ADD("  NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
  SQL.ADD("  Vehiculo2,   Especie1,     Especie2,     Especie3,     Especie4, ")
  SQL.ADD("  Check1,      Check2,       Check3,       Check4,       Check5, ")
  SQL.ADD("  Check6,      Check7,       Check8,       Check9,       Check10, ")
  SQL.ADD("  Radio1,      Radio2,       Radio3,       Radio4,       Radio5, ")
  SQL.ADD("  Radio6,      Radio7,       Radio8,       Radio9,       Radio10, ")
  SQL.ADD("  Fecha1,      Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
  SQL.ADD("  Fecha6,      Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
  SQL.ADD("  Mercado1,    Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
  SQL.ADD("  Plazo4,      Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
  SQL.ADD("  Precio1,     Precio2,      Precio3,      Precio4,      Total1, ")
  SQL.ADD("  Total2,      Total3,       Total4,       Total5,       Total6, ")
  SQL.ADD("  Total7,      Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
  SQL.ADD("  PrecioRef2,  Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
  SQL.ADD("  Precio7,     Precio8,      Tasa3,        Total9,       Cotizacion1, ")
  SQL.ADD("  Cotizacion2, Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
  SQL.ADD("  Coeficiente, Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
  SQL.ADD("  Cantidad9,   Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
  SQL.ADD("  Total11,     Total12 ")
  SQL.ADD(" )")
          
  SQL.ADD("SELECT '"~Val(b:3)~"' as NrOperacion, ")
  SQL.ADD("       NrCuota, ")
  SQL.ADD("       Cliente1, ")
  SQL.ADD("       Cliente2, ")
  SQL.ADD("       Vehiculo1, ")

  SQL.ADD("       Vehiculo2, ")
  SQL.ADD("       Especie1, ")
  SQL.ADD("       Especie2, ")
  SQL.ADD("       Especie3, ")
  SQL.ADD("       Especie4, ")

  SQL.ADD("       Check1, ")
  SQL.ADD("       Check2, ")
  SQL.ADD("       Check3, ")
  SQL.ADD("       Check4, ")
  SQL.ADD("       Check5, ")

  SQL.ADD("       Check6, ")
  SQL.ADD("       Check7, ")
  SQL.ADD("       Check8, ")
  SQL.ADD("       Check9, ")
  SQL.ADD("       Check10, ")

  SQL.ADD("       Radio1, ")
  SQL.ADD("       Radio2, ")
  SQL.ADD("       Radio3, ")
  SQL.ADD("       Radio4, ")
  SQL.ADD("       Radio5, ")

  SQL.ADD("       Radio6, ")
  SQL.ADD("       Radio7, ")
  SQL.ADD("       Radio8, ")
  SQL.ADD("       Radio9, ")
  SQL.ADD("       Radio10, ")

  SQL.ADD("       Fecha1, ")
  SQL.ADD("       Fecha2, ")
  SQL.ADD("       Fecha3, ")
  SQL.ADD("       Fecha4, ")
  SQL.ADD("       Fecha5, ")

  SQL.ADD("       Fecha6, ")
  SQL.ADD("       Fecha7, ")
  SQL.ADD("       Fecha8, ")
  SQL.ADD("       Fecha9, ")
  SQL.ADD("       Fecha10, ")

  SQL.ADD("       Mercado1, ")
  SQL.ADD("       Mercado2, ")
  SQL.ADD("       Plazo1, ")
  SQL.ADD("       Plazo2, ")
  SQL.ADD("       Plazo3, ")

  SQL.ADD("       Plazo4, ")
  SQL.ADD("       Cantidad1, ")
  SQL.ADD("       Cantidad2, ")
  SQL.ADD("       Cantidad3, ")
  SQL.ADD("       Cantidad4, ")

  SQL.ADD("       Precio1, ")
  SQL.ADD("       Precio2, ")
  SQL.ADD("       Precio3, ")
  SQL.ADD("       Precio4, ")
  SQL.ADD("       Total1, ")

  SQL.ADD("       Total2, ")
  SQL.ADD("       Total3, ")
  SQL.ADD("       Total4, ")
  SQL.ADD("       Total5, ")
  SQL.ADD("       Total6, ")

  SQL.ADD("       Total7, ")
  SQL.ADD("       Total8, ")
  SQL.ADD("       Tasa1, ")
  SQL.ADD("       Tasa2, ")
  SQL.ADD("       PrecioRef1, ")

  SQL.ADD("       PrecioRef2, ")
  SQL.ADD("       Cantidad5, ")
  SQL.ADD("       Cantidad6, ")
  SQL.ADD("       Precio5, ")
  SQL.ADD("       Precio6, ")

  SQL.ADD("       Precio7, ")
  SQL.ADD("       Precio8,  ")
  SQL.ADD("       Tasa3, ")
  SQL.ADD("       Total9, ")
  SQL.ADD("       Cotizacion1, ")

  SQL.ADD("       Cotizacion2, ")
  SQL.ADD("       Tasa4, ")
  SQL.ADD("       Tasa5, ")
  SQL.ADD("       Cantidad7, ")
  SQL.ADD("       Cantidad8, ")

  SQL.ADD("       Coeficiente, ")
  SQL.ADD("       Cantidad1Ori, ")
  SQL.ADD("       Cantidad2Ori, ")
  SQL.ADD("       Cantidad3Ori, ")
  SQL.ADD("       ResultadoIndice, ")

  SQL.ADD("       Cantidad9, ")
  SQL.ADD("       Cantidad10, ")
  SQL.ADD("       Cantidad11, ")
  SQL.ADD("       Cantidad12, ")
  SQL.ADD("       Total10, ")

  SQL.ADD("       Total11, ")
  SQL.ADD("       Total12 ")
  SQL.ADD("  FROM "~DBO~".CUOTAS ")
  SQL.ADD(" WHERE NrOperacion = '"~Val(b:1)~"' ")
  SQL.NEW
  SQL.EXEC

  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   Set CB6 = '0' ")
  SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
  SQL.NEW
  SQL.EXEC

  SQL.ADD("Update "~DBO~".OPERACIONES ")
  SQL.ADD("   Set Cuotas1 = "~FStr(Val(b:9),1,0)~" ")
  SQL.ADD(" where NrOperacion = '"~Val(b:3)~"' ")
  SQL.NEW
  SQL.EXEC

  *** Actualiza movimientos, posiciones y limites Y Devengados ****
  *** De la Precancelacion (MMPREC)
  SQL.ActualizarMovimientos3(Val(b:1),SI,NO,NO,SI,SI)
  SQL.EXEC
  *** De la Precancelada (MMPCCM o MMPRCO)
  SQL.ActualizarMovimientos3(Val(b:3),SI,NO,NO,SI,SI)
  SQL.EXEC
endif

if Dialogo.Check2=0 y Dialogo.Check1=1
  if NoVacio(Val(b:35))
    EjecutarEvento('PRECM3',NrOperacion1=Val(b:35),Check1=Dialogo.Check1,Check2=1)
    ACT(c:35, 'Llama a PRECM3')
  endif
endif

ACO(1,10)
ACO(2,10)
ACO(3,10)
