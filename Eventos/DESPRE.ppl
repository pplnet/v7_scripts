*HojaVisible(SI)
CrearDialogo
  NrTrans1: 'NrVoucher';
  Fecha1  : 'Fecha'    ;;;;;;;;;FSys
FinDialogo
if Not OK
  Cancelar
endif

ACT(x1, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1))
if Not Incluido(Val(x1),'DEP|RET|MATCH')
*  Cancelar('Tipo Transaccion incorrecto')
   Cancelar
endif

SQL.ADD("Select * from "~DBO~".MOVEJECUTADOS	")
SQL.ADD("Where NrTrans2 = '"~Dialogo.NrTrans1~"' ")
SQL.ADD("  and NrOperacion <> '"~Dialogo.NrTrans1~"' ")
SQL.ADD("  and Cantidad < 0 ")
recorrer SQL
  ACT(a:FAC, FBN('NrOperacion'))
  if Incluido(Copy(Val(a:FAC),1,1),'T|F')  
    ACT(b:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Val(a:FAC)))
    if Incluido(Val(b:FAC),'TIFC|TIFV') y BuscarCampo('OPERACIONES','PaseCB','NrOperacion',Val(a:FAC))=1
      ACT(k:FAC, BuscarCampo('OPERACIONES','OperacionRef','NrOperacion',Val(a:FAC)))
      ACN(l:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(k:FAC)~"' and Limite = 'PRESETREPO' "))
      ACN(m:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(k:FAC)~"' and Limite = 'PSRVN' "))
      if Val(l:FAC)>0
        ACT(n:FAC, 'PRESETREPO')
        SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(k:FAC)~"' and Limite = 'PRESETREPO' ")
        recorrer SQL
          DFA
          SCN(o:FAC, 1)
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("FechaMov, Cliente, Limite, ")
          SQL.ADD("Especie, Monto, NrOperacion, ")
          SQL.ADD("Descripcion, Usuario, Bits, ")
          SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
          SQL.ADD("Sublimite, Commited ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"', ")
          SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(l:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
          SQL.ADD(" 'Conf. DVP', '', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
          SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
          SQL.ADD(" )")
          SQL.NEW
          Break
        proximo
      endif  
      if Val(m:FAC)>0
        ACT(q:FAC, 'PSVN')
        SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(k:FAC)~"' and Limite = 'PSRVN' ")
        recorrer SQL
          DFA
          SCN(r:FAC, 1)
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("FechaMov, Cliente, Limite, ")
          SQL.ADD("Especie, Monto, NrOperacion, ")
          SQL.ADD("Descripcion, Usuario, Bits, ")
          SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
          SQL.ADD("Sublimite, Commited ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"', ")
          SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(m:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
          SQL.ADD(" 'Conf. DVP', '', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
          SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
          SQL.ADD(" )")
          SQL.NEW
          Break
        proximo
      endif  
      SQL.EXEC
    else
      ACN(c:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PRESETTLEM' "))
      ACN(d:FAC, SQL("Select SUM(Monto) from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PSVN' "))
      if Val(c:FAC)>0
        ACT(e:FAC, 'PRESET')
        SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PRESETTLEM' ")
        recorrer SQL
          DFA
          SCN(f:FAC, 1)
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("FechaMov, Cliente, Limite, ")
          SQL.ADD("Especie, Monto, NrOperacion, ")
          SQL.ADD("Descripcion, Usuario, Bits, ")
          SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
          SQL.ADD("Sublimite, Commited ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"',")
          SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(c:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
          SQL.ADD(" 'Conf. DVP', '', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
          SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
          SQL.ADD(" )")
          SQL.NEW
          Break
        proximo
      endif  
      if Val(d:FAC)>0
        ACT(h:FAC, 'PSVN')
        SQL.ADD("Select * from "~DBO~".MOVLIMITES Where NrOperacion = '"~Val(a:FAC)~"' and Limite = 'PSVN' ")
        recorrer SQL
          DFA
          SCN(i:FAC, 1)
          SQL.ADD("Insert into "~DBO~".MOVLIMITES (")
          SQL.ADD("FechaMov, Cliente, Limite, ")
          SQL.ADD("Especie, Monto, NrOperacion, ")
          SQL.ADD("Descripcion, Usuario, Bits, ")
          SQL.ADD("Vehiculo, PlazoDesde, PlazoHasta, ")
          SQL.ADD("Sublimite, Commited ")
          SQL.ADD(") values (")
          SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~FBN('Cliente')~"', '"~FBN('Limite')~"',")
          SQL.ADD(" '"~FBN('Especie')~"', "~FStr(-Val(d:FAC),0,2)~", '"~FBN('NrOperacion')~"', ")
          SQL.ADD(" 'Conf. DVP', '', ")
          if Dialogo.Fecha1<=FSys
            SQL.ADD(" 'P', ")
          else
            SQL.ADD(" 'N', ")
          endif
          SQL.ADD(" '"~FBN('Vehiculo')~"', "~FStr(fbn('PlazoDesde'),0,0)~", "~FStr(fbn('PlazoHasta'),0,0)~", ")
          SQL.ADD(" '"~FBN('Sublimite')~"', '"~fbn('Commited')~"' ")
          SQL.ADD(" )")
          SQL.NEW
          Break
        proximo
      endif  
      SQL.EXEC
    endif  
  endif  
  if Incluido(Copy(Val(a:FAC),1,2),'VT')
    ACT(b:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(a:FAC)))
    ACT(c:FAC, BuscarCampo('TRANSACCIONES2','NrTransRef1','NrTrans',Val(a:FAC)))
    ACT(d:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(c:FAC)))
    if Incluido(Val(d:FAC),'MATCH|DEP')
      ACT(e:FAC, 'Ejecuta')
      EjecutarEvento('DESPRE',NrTrans1=Val(c:FAC),Fecha1=Dialogo.Fecha1)
    endif
  endif  
Proximo
*******************************************************
* Evento que desafecta Presettlement de FX Forwards NDF
*******************************************************
if Incluido(Val(x1),'DEP|RET')
  EjecutarEvento('DESPRN',NrTrans1=Dialogo.NrTrans1,Fecha1=Dialogo.Fecha1)
endif
