*    else
*       IF Dialogo.Radio1=3
*       SQL.ADD("AND ORD.Lotes=48 ")
*       else
*       endif
*    endif
*endif

IF Dialogo.Radio1=0
   SQL.ADD("AND ORD.Lotes=0 ")
else
   SQL.ADD("AND ORD.Lotes<>0 ")
endif

