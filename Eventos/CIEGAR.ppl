**  Desbloqueo por no utilizado Moneda, ARP De la Operacion
#ifdef BIND
   *SQL.ADD("SELECT ORD.TotalAux1, O.TotalNetoCli1, substring(O.Cuenta4,1,len(O.Cuenta4)-3) as Cuenta, substring(O.Cuenta4,len(O.Cuenta4)-1,2) as SubOpe, ")
   ** AA 22-09-2021 se incorpora nuevamente OPERACIONES y Saldo Moneda Bloqueado O.TotalNetoCli1
   SQL.ADD("SELECT ORD.Nrorden, ORD.TotalAux1, O.TotalNetoCli1, ORD.Cuenta4  as Cuenta, ORD.ContraEspecie, C.Sucursal, ORD.Leyenda3 ")
   SQL.ADD("  FROM "~DBO~".ORDENES ORD ")
   SQL.ADD("       Left JOIN OPERACIONES O WITH (NOLOCK) ON ORD.NrOrden=O.NrOrden1 ")
   SQL.ADD("       Left JOIN CUENTAS C WITH (NOLOCK) ON  ORD.Cuenta4=C.Codigo ")
   SQL.ADD("       Left JOIN OPERACIONESBITS B WITH (NOLOCK) ON  ORD.NrOrden=B.NrOperacion ")   
   SQL.ADD(" WHERE ORD.FechaOrden="~IdxDate2(Dialogo.Fecha1))
   SQL.ADD("   AND ORD.CantidadTotalOrden>Cantidad1 ")
   SQL.ADD("   AND ORD.TipoOrden in ('OTIC') ")
   SQL.ADD("   AND ORD.Mercado2='"~VAR('MERCADOBT')~"' ")
   SQL.ADD("   AND ORD.MB2='1' ")
   SQL.ADD("   AND ORD.AfectaLS='Saldos' ")   
   SQL.ADD("   AND B.NrBit not in ( 30 )  and B.Valor=1 ")   

   if NoVacio(Dialogo.Mercado1)
      SQL.ADD("AND ORD.Mercado3='"~Dialogo.Mercado1~"' ")
   endif

   if Dialogo.Radio1=0
      SQL.ADD("AND ORD.Lotes=0 ")
   else
      SQL.ADD("AND ORD.Lotes<>0 ")
   endif
   watch(sql.batch)
   Recorrer SQL
   
      * Parámetros Salida
      * RR:1  'OK/NOK  
      * RR:2  'Mensaje'  

      * Parámetros entrada
      * RR:10  'Cuenta'  
      * RR:11  'Sucursal'  
      * RR:12  'Cuenta(1a7)'    
      * RR:13  'SubOperacion-Cuenta (9a10)'
      * RR:14  'Moneda'
      * RR:15  'Importe'
      * RR:16  'Observaciones'
 
      ** Desbloqueo en sistema interno 
      BorrarCeldas(rr:1..rr:50)
      ACT(rr:10, FBN['Leyenda3'])
      ACT(rr:12, Copy(FBN['Cuenta'],1,7))
      ACT(rr:13, Copy(FBN['Cuenta'],9,2))
      * Desbloqueo de Saldo
      ACN(rr:15,FBN['TotalAux1']-FBN['TotalNetoCli1'])
      
     (.'DESBSALCTA'.)
      ACT(b:22, val(rr:1))
      If Eqstr(Val(b:22),'NOK')
         ACN(b:17, Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~FBN['NrOrden']~"' And Tipo = 'ERRDESBLOQ' "))
         if Val(b:17)=0
            SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
            SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
            SQL.ADD(" ) Values ( ")
            SQL.ADD(" '"~FBN['NrOrden']~"', ")
            SQL.ADD(" "~SQLAhora~", ")
            SQL.ADD(" 'ERRDESBLOQ', ")
            SQL.ADD(" '"~'Error al desbloquear cuenta '~FBN['Cuenta']~"' ")
            SQL.ADD(" ) ")
            SQL.NEW
            SQL.EXEC
         endif
      Endif
      
   Proximo
#endif   


ACN(b:1, SQL("Select Count(*) From "~DBO~".FLAGSMERCADO Where Fecha = "~IdxDate2(Dialogo.Fecha1)~" and Paso = "~FStr(Dialogo.Radio1,1,0)~" and Registro = 'CGAR' and Estado='ANU' "))

IF val(b:1)=0
    SQL.ADD("Insert Into "~DBO~".FLAGSMERCADO ( ")
    SQL.ADD(" Fecha, Registro, Cantidad, Estado, Paso ")
    SQL.ADD(" ) Values ( ")
    SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', 'CGAR', 0, 'PRO', "~FStr(Dialogo.Radio1,1,0)~" ")
    SQL.ADD(" ) ")
    SQL.NEW
else
    SQL.ADD("Update "~DBO~".FLAGSMERCADO ")
    SQL.ADD("   Set Estado     = 'PRO' ")
    SQL.ADD(" where Fecha      = "~IdxDate2(Dialogo.Fecha1)~" ")
    SQL.ADD("   and Paso       = "~FStr(Dialogo.Radio1,1,0)~" ")
    SQL.ADD("   and Registro   = 'CGAR' ")
    SQL.NEW
endif
SQL.Exec
