SetFilaActual(1)

Message('--- Asientos por Cambio de Book ---')

SQL.ADD(" SELECT O.NrOperacion, O.BookAnterior, O.Book1, O.FechaCambioBook, O.FechaCarga , O.FechaOp,O.TotalBrutoCli1, O.ContraEspecie, ")
SQL.ADD(" O.Vehiculo1,O.Especie,O.Cuenta2 as CuentaCustodia,O.TipoOp, O.FechaVto, O.Precio1 PrecioOp,E.MonedaEmision, ")
SQL.ADD(" O.Cantidad,O.Plazo,M.Codigo CodAsi,O.Cliente1,O.Cliente1 Cliente,E.Tipo TipoEspecie,O.Cupon1,E.Cotiza,E.Issuer ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,MODELOSASIENTO M,ESPECIES E ") 
SQL.ADD(" Where O.Especie=E.Codigo and O.FechaCambioBook= '"~IdxDate(Dialogo.Fecha1)~"'  ")
**Cintia 240624 - se modifica la siguiente validacion para que, cuando la op se haya cargado a FechaValor, la levante sólo si el cambio de book se hizo posterior a la fecha de carga
*SQL.ADD(" AND O.FechaCambioBook>O.FechaOp ")
SQL.ADD(" AND ((O.FechaCambioBook>O.FechaOp and O.FechaOp>=O.FechaCargaSys) or(O.FechaOp<O.FechaCargaSys and O.FechaCambioBook>O.FechaCargaSys)) ")
**---La validacion siguiente es para que si en el mismo dia se hizo el cambio y la anulación, no haga nada. 
SQL.ADD(" and ( O.FechaAnulacionCambioBook is null OR O.FechaCambioBook<>O.FechaAnulacionCambioBook OR ( ")
SQL.ADD("  O.FechaCambioBook=O.FechaAnulacionCambioBook AND BookAnterior is not null))AND O.TipoOp = M.TipoOp AND ")
**
SQL.ADD(" TipoAsiento = '"~Var('TIPASCAMBK')~"' AND '|'+rtrim(Vehiculo)+'|' like '%|"~Dialogo.Vehiculo1~"|%' AND Habilitado = 'SI' ")
*SQL.ADD(" AND (O.BookAnterior Not IN ("~Pipe2Comillas(&BValuaPartida)~") AND O.Book1 IN ("~Pipe2Comillas(&BValuaPartida)~"))")

Recorrer SQL
        ACD(FV:1, Dialogo.Fecha1)
        ACT(BK:1, fbn('BookAnterior'))
        ACT(BK:2, fbn('Book1'))
        ACT(MN:99,fbn('ContraEspecie'))
        
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select A.NrUnicoAsiento from "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND  A.Modelo = '"~fbn('CodAsi')~"' AND A.Estado IN ('E','A') AND A1.Alias1 = '"~fbn('Especie')~"' AND A.Vehiculo = '"~fbn('Vehiculo1')~"' AND A.Fecha1 = '"~Idxdate(val(FV:1))~"' AND A1.Alias2 = '"~val(BK:1)~"' AND (A.NrOperacion = '' OR A.NrOperacion = ' ' OR A.NrOperacion Is Null) "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        let &codAsi fbn('CodAsi')
        IF Val(CK:1) = 0 
            Message(Val(OP:1)~'  - Modelo: '~fbn('CodAsi'))
            SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),,,Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
        ***CINTIA 08JUL2024 Se agrega bloque por reversa de asiento de revalúo (ya no se hará en CONT2)
        ACD(FV:3,Val(fv:1))
        **Reversa de Revaluo de Op Vigentes O Vencidas pero no Liquidadas (se liquidaron ahora)
        ACT(TA:1, Var('TIPASIRETO'))
        SQL.ADD(" Select FechaValor,NrUnicoAsiento ")
        SQL.ADD(" From "~DBO~".ASIENTOSCON A, MODELOSASIENTO M ")
        SQL.ADD(" Where A.Modelo = M.Codigo ")
        SQL.ADD(" AND A.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" And M.TipoAsiento = '"~Val(TA:1)~"'")
        SQL.ADD(" AND '"~fbn('Book1')~"' IN ("~Pipe2Comillas(&BValuaPartida)~")")
        SQL.ADD(" AND (A.Estado is NULL OR A.Estado = '' OR A.Estado ='E') AND (A.NrAsiento is NULL OR A.NrAsiento = '') ")
        SQL.ADD(" Group By FechaValor,NrUnicoAsiento ")
        Recorrer SQL
            ACT(AS:1, fbn('NrUnicoAsiento'))
            ***---Llamo a evento que realiza ContraAsiento
            EjecutarEvento('CONT46', Fecha1=Dialogo.Fecha1, NrUnicoAsiento1=Val(AS:1), Fecha2=Val(FV:3), Radio1=0)
        Proximo

Proximo


**CINTIA 08JUL2024 SE DEJA DE GENERAR ESTE ASIENTO YA QUE GENERAMOS LA REVERSA DEL ASIENTO DE REVALUO CUANDO HAY UN CAMBIO DE BOOK.
IF NO
Message('--- Asientos por Reclasificación de Revalúo ---')

SQL.ADD(" SELECT O.NrOperacion, O.BookAnterior, O.Book1, O.FechaCambioBook, O.FechaCarga , O.FechaOp,O.TotalBrutoCli1, O.ContraEspecie, ")
SQL.ADD(" O.Vehiculo1,O.Especie,O.Cuenta2 as CuentaCustodia,O.TipoOp, O.FechaVto, O.Precio1 PrecioOp,E.MonedaEmision, ")
SQL.ADD(" O.Cantidad,O.Plazo,M.Codigo CodAsi,O.Cliente1,O.Cliente1 Cliente,E.Tipo TipoEspecie,O.Cupon1,E.Cotiza,E.Issuer ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,MODELOSASIENTO M,ESPECIES E ") 
SQL.ADD(" Where O.Especie=E.Codigo and O.FechaCambioBook= '"~IdxDate(Dialogo.Fecha1)~"' ")
**Cintia 240624 - se modifica la siguiente validacion para que, cuando la op se haya cargado a FechaValor, la levante sólo si el cambio de book se hizo posterior a la fecha de carga
*SQL.ADD(" AND O.FechaCambioBook>O.FechaOp ")
SQL.ADD(" AND ((O.FechaCambioBook>O.FechaOp and O.FechaOp>=O.FechaCargaSys) or(O.FechaOp<O.FechaCargaSys and O.FechaCambioBook>O.FechaCargaSys)) ")
**---La validacion siguiente es para que si en el mismo dia se hizo el cambio y la anulación, no haga nada. 
SQL.ADD(" and (O.FechaAnulacionCambioBook is null OR O.FechaCambioBook<>O.FechaAnulacionCambioBook OR ( ")
SQL.ADD(" O.FechaCambioBook=O.FechaAnulacionCambioBook AND BookAnterior is not null)) AND O.TipoOp = M.TipoOp AND")
**
SQL.ADD(" TipoAsiento = '"~Var('TIPASRECLA')~"' AND '|'+rtrim(Vehiculo)+'|' like '%|"~Dialogo.Vehiculo1~"|%' AND Habilitado = 'SI' AND")
SQL.ADD(" (O.BookAnterior Not IN ("~Pipe2Comillas(&BValuaPartida)~") AND O.Book1 IN ("~Pipe2Comillas(&BValuaPartida)~"))")

Recorrer SQL
    ACN(NF:1, 0)
    ACN(DF:1, 0)
    ACN(NF:2, 0)
    ACN(RV:1, 0)
    ACN(RV:2, 0)
    ACN(DP:1, 0)
    ACN(DA:1, 0)
    ACT(FV:2,fbn('FechaVto'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACD(FO:1, fbn('FechaOp'))
    ACT(BK:1, fbn('BookAnterior'))
    ACT(BK:2, fbn('Book1'))
    ACD(FV:1, Dialogo.Fecha1)
    ACT(CP:99,fbn('Cupon1'))
    ACT(ME:1, fbn('MonedaEmision'))
    ACT(MN:99, fbn('ContraEspecie'))
    
    let &fechaOp fbn('FechaOp')
    let &fechaVto fbn('FechaVto')
    let &precioOp fbn('PrecioOp')
    let &especie fbn('Especie')
    let &book fbn('Book1')
    let &cantidad fbn('Cantidad')
    let &monedaDelCotizador fbn('Cotiza')
    let &monedaPrecioOp fbn('ContraEspecie')
    let &monedaDelRevaluo val(ML:1)
    let &plazo fbn('Plazo')                
    Recorrer&i fbn('FechaOp'),fbn('FechaCambioBook')-1
        If EsHabil(Fecha(&i))
            let &fechaRevaluo Fecha(&i)
            ACD(FV:1, &fechaRevaluo)
            (.'REVALOP'.)
            ACN(RV:1, &revaluoEnMonReval)

            ACN(CK:1, 0)
            IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
                ACN(CK:1, 1)
                IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrOperacion = '"~fbn('NrOperacion')~"' AND Modelo = '"~fbn('CodAsi')~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~fbn('Vehiculo1')~"' "))
                    ACN(CK:1, 0)
                ENDIF
            ENDIF
            let &codAsi fbn('CodAsi')
            IF Val(CK:1) = 0
                Message(fbn('NrOperacion')~'  - Modelo: '~fbn('CodAsi'))
                SQL.GenerarAsientoOp(&codAsi,fbn('NrOperacion'),'','',Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
                SQL.EXEC
            ENDIF
        EndIf
    Proximo
Proximo    

ENDIF

Message('--- Asientos por Anulación de cambio de Book ---')

SQL.ADD("select DISTINCT O.FechaOp, O.NrOperacion, AC.Modelo as CodAsi, AC.FechaGeneracion,  ")
SQL.ADD(" AC.FechaValor, AC.Vehiculo, AC.Libro, AC.Sector, AC.NrLote, AC.NrUnicoAsiento, ")
SQL.ADD(" AC.Modelo, AC.Book, AC.UDN, AC.Centro, AC.NrOperacion, AC.NrTrans2, AC.NrAsiento ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".ASIENTOSCON AC ")
SQL.ADD("where ")
SQL.ADD("  O.NrOperacion = AC.NrOperacion ")
SQL.ADD(" AND O.FechaAnulacionCambioBook= '"~IdxDate(Dialogo.Fecha1)~"' and ")
**---La validacion siguiente es para que si en el mismo dia se hizo el cambio y la anulación, no haga nada. 
SQL.ADD("  (O.FechaCambioBook<>O.FechaAnulacionCambioBook) and  ")
**
SQL.ADD("  O.Book1 NOT IN ("~Pipe2Comillas(&BValuaPartida)~")")
#ifdef MLASA
    ***---SQL.ADD(" AND AC.NrLote<>0 ")
#else
    SQL.ADD(" AND (AC.Estado IS NULL OR AC.Estado='' OR AC.Estado = ' ' OR AC.Estado IN ('E','A')) ")
#endif
SQL.ADD(" AND (AC.NrAsiento Is Null OR AC.NrAsiento = '' OR AC.NrAsiento = ' ') ")
SQL.ADD(" order by O.NrOperacion ")
Recorrer SQL
    ACD(FV:1, Fbn('FechaValor'))
    ACT(VH:1, Fbn('Vehiculo'))
    Message(fbn('NrOperacion')~' - Modelo: '~fbn('CodAsi')~' - NrAsiento: '~fbn('NrUnicoAsiento'))
    ACT(NN:1, GetNumerador(Var('ASINUM')))
    SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON                ")
    SQL.ADD(" (FechaGeneracion, FechaValor, Vehiculo, Libro, ")
    SQL.ADD(" Modelo, Book, UDN, Centro, ")
    SQL.ADD(" Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
    SQL.ADD(" NrOperacion, NrTrans2, Estado, Fecha1) ")
    SQL.ADD(" VALUES ")
    SQL.ADD(" ("~Idxdate2(fsys)~", "~Idxdate2(Val(FV:1))~", '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
    SQL.ADD(" '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
    SQL.ADD(" '"~fbn('Sector')~"', '', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
    SQL.ADD(" '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', 'COT', "~Idxdate2(Dialogo.Fecha1)~")  ")
    SQL.NEW
    SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"'  ")
    Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
       SQL.ADD(" Detalle, CentroCosto, Book, NrItem ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(NN:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
          SQL.ADD(" 'CRE', ")
       Else
          SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,8)~", "~fstr(fbn('Cantidad2'),0,8)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', 'ContraAsiento "~Copy(fbn('Alias4'),1,26)~"', '"~fbn('Alias5')~"', ")
       SQL.ADD(" '"~fbn('Detalle')~"', '"~fbn('CentroCosto')~"', '"~fbn('Book')~"', '"~fbn('NrItem')~"' ) ")
       SQL.NEW
       
       SQL.EXEC
    Proximo

Proximo