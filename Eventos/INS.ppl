* INS - Insert de Sindicadas
CrearDialogo
   NrOperacion1:'Op  Cabecera'
   NrOperacion2:'Op. Participante'
   String1     :'Condicion de Select Cuotas'
FinDialogo

If not Ok
 Cancelar
EndIf


Message('Insertando Settlements')

SQL.ADD("INSERT INTO "~DBO~".CUOTAS ")
SQL.ADD(" (NrOperacion,C.NrCuota,C.Cliente1,C.Cliente2,")
SQL.ADD(" C.Vehiculo1,C.Vehiculo2,C.Especie1,C.Especie2,C.Especie3,C.Especie4,C.Check1,C.Check2,C.Check3,")
SQL.ADD(" C.Check4,C.Check5,C.Check6,C.Check7,C.Check8,C.Check9,C.Check10,C.Radio1,C.Radio2,C.Radio3,C.Radio4,")
SQL.ADD(" C.Radio5,C.Radio6,C.Radio7,C.Radio8,C.Radio9,C.Radio10,C.Fecha1,C.Fecha2,C.Fecha3,C.Fecha4,C.Fecha5,")
SQL.ADD(" C.Fecha6,C.Fecha7,C.Fecha8,C.Fecha9,C.Fecha10,C.Mercado1,C.Mercado2,C.Plazo1,C.Plazo2,C.Plazo3,C.Plazo4,")
SQL.ADD(" C.Cantidad1,C.Cantidad2,C.Cantidad3,C.Cantidad4,C.Precio1,C.Precio2,C.Precio3,C.Precio4,C.Total1,C.Total2,")
SQL.ADD(" C.Total3,C.Total4,C.Total5,C1.Total6,C.Total7,C.Total8,C.Tasa1,C1.Tasa2,C.PrecioRef1,C.PrecioRef2,")
SQL.ADD(" C.Cantidad5,C. Cantidad6,C.Precio5,C.Precio6,C.Precio7,C.Precio8,C.Tasa3,C.Total9,C.Cotizacion1,C.Cotizacion2,")
SQL.ADD(" C.Tasa4,C.Tasa5,")
SQL.ADD(" C.Cantidad7,C.Cantidad8,C.Coeficiente,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.ResultadoIndice) ")

SQL.ADD(" SELECT '"~Dialogo.NrOperacion2~"' As NrOperacion,C.NrCuota,C.Cliente1,C.Cliente2,")
SQL.ADD(" C.Vehiculo1,C.Vehiculo2,C.Especie1,C.Especie2,C.Especie3,C.Especie4,C.Check1,C.Check2,C.Check3,")
SQL.ADD(" C.Check4,C.Check5,C.Check6,C.Check7,C.Check8,C.Check9,C.Check10,C.Radio1,C.Radio2,C.Radio3,C.Radio4,")
SQL.ADD(" C.Radio5,C.Radio6,C.Radio7,C.Radio8,C.Radio9,C.Radio10,C.Fecha1,C.Fecha2,C.Fecha3,C.Fecha4,C.Fecha5,")
SQL.ADD(" C.Fecha6,C.Fecha7,C.Fecha8,C.Fecha9,C.Fecha10,C.Mercado1,C.Mercado2,C.Plazo1,C.Plazo2,C.Plazo3,C.Plazo4,")
SQL.ADD(" C.Cantidad1,C.Cantidad2,C.Cantidad3,C.Cantidad4,C.Precio1,C.Precio2,C.Precio3,C.Precio4,C.Total1,C.Total2,")
SQL.ADD(" C.Total3,C.Total4,C.Total5,C1.Total6,C.Total7,C.Total8,C.Tasa1,C1.Tasa2,C.PrecioRef1,C.PrecioRef2,")
SQL.ADD(" C.Cantidad5,C. Cantidad6,C.Precio5,C.Precio6,C.Precio7,C.Precio8,C.Tasa3,C.Total9,C.Cotizacion1,C.Cotizacion2,")
SQL.ADD(" C.Tasa4,C.Tasa5,")
SQL.ADD(" C.Cantidad7,C.Cantidad8,C.Coeficiente,C.Cantidad1Ori,C.Cantidad2Ori,C.Cantidad3Ori,C.ResultadoIndice ")
SQL.ADD(" FROM "~DBO~".CUOTAS C,  "~DBO~".CUOTAS C1 WHERE C.NrOperacion='"~Dialogo.NrOperacion1~"' AND C1.NrOperacion='"~Dialogo.NrOperacion2~"' AND C1.NrCuota=C.NrCuota ")
If NOVACIO(Dialogo.String1)   
   SQL.ADD(" and "~Dialogo.String1~" ")
EndIf
SQL.NEW

SQL.ADD("DELETE "~DBO~".CUOTAS WHERE NrOperacion= '"~Dialogo.NrOperacion2~"' and Cantidad3=0 ")
SQL.NEW
SQL.EXEC


*-- Datos de operacion participante
SQL.ADD("SELECT TotalAux4,TotalAux2,CB10,TipoOp,RB8,Cantidad,")
SQL.ADD("ImpGastos2,TotalAux1,TasaImp1,RB7,RB9,CB10 FROM "~DBO~".OPERACIONES WHERE ")
SQL.ADD("NrOperacion='"~Dialogo.NrOperacion2~"' ")

Recorrer SQL
   dfa
   *- A50: Local o extranjero de Operacion Item
   ACN(A50,FBN['CB10'])

   *- A60: Tipo de operacion Item
   ACT(A60,FBN['TipoOp'])

   *-- A10: Unidad de Tiempo Calculo de Intereses
   ACN(A10,IIF(EqStr(FBN['RB8'],'0'),36000,36500))

   *-- vn del periodo
   ACN(A3,FBN['Cantidad'])

   *-- TASA IVA A20 WH A21  Imp.Interes A40
   ACN(A20,FBN['ImpGastos2'])
   ACN(A21,FBN['TotalAux1'])
   ACN(A40,FBN['TasaImp1'])

   *-- UT IVA A24 WH A25  
   ACT(A24,FBN['RB7'])
   ACT(A25,FBN['RB9'])

   *-- LOCAL O EXTRANJERO
   ACT(A26,FBN['CB10'])
Proximo

*-- Calculo CUOTAS
SQL.ADD("SELECT * FROM "~DBO~".CUOTAS WHERE ")
SQL.ADD("NrOperacion='"~Dialogo.NrOperacion2~"' ORDER BY NrCuota ")

Recorrer SQL
  Message('Insertando Settlements '~Dialogo.NrOperacion2~' '~FStr(FBN['NrCuota'],2,0))

  * A4 es el interes
  * A11 es el interes total
  * A5 es el monto
  * A6 es el monto total
  * A7 es el importe iva
  * A8 es el importe wh
  * A9 es el importe de amortizacion del periodo
  * a41 : Importe de Impuesto Interes 

  ACN(A7,0)
  ACN(A8,0)

  ACN(A30,FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],BuscarCampo('Operaciones','RB8','NrOperacion',Dialogo.NrOperacion1)+1))

  * PARA LOCAL O EXTRANJERO
  IF VAL(A20)<>0
     * Si la Tasa de IVA ES Positiva 
     ACN (A7, (val(a3)*FBN['Tasa2']/100*VAL(A30)*VAL(A20))/100)
  EndIf
  * Extranjero
  IF EQSTR (val(A26), '1')
     ACN (A8, (val(a3)*FBN['Total6']/100*VAL(A30)*VAL(A21))/100)
  ENDIF

  *** calcula el importe de amortizacion del periodo
  acn(A9, BuscarCampo('Operaciones','Cantidad','NrOperacion',Dialogo.NrOperacion2) * FBN['Tasa1'] / 100)

  *-- INTERES
  acn (a4, val(a3) * ((FBN['Precio2']+FBN['Precio4'])/100) * VAL(A30))

  ACN (A41, 0)

  IF VAL(A40)<>0 y [[VAL(A50)=0 y EqStr(Val(A60), 'MMSIMV')] o [VAL(A50)=1 y EqStr(Val(A60), 'MMFIMV')]]
     * Si la Tasa de Impuesto Extranjero es >0
     ACN (A41, val(a4)*(VAL(A40)/100) )
  EndIf

  *-- INTERES TOTAL
  acn (a11, val(a4) + val(a8) + val(a41) )

  *-- MONTO
  ACN (A5, val(a9) +VAL(A4))

  *-- MONTO TOTAL
  ACN (A6, val(a9) +VAL(A11))

  SQL.ADD("Update "~DBO~".CUOTAS SET ")
  SQL.ADD(" Cantidad2= "~Fstr(VAL(A3),0,2)~", ")
  SQL.ADD(" Cantidad4= "~Fstr(VAL(A9),0,2)~", ")
  SQL.ADD(" Cantidad5= "~Fstr(VAL(A11),0,2)~", ")
  SQL.ADD(" Cantidad3= "~Fstr(VAL(A4),0,2)~", ")
  SQL.ADD(" Precio1= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Precio6= "~Fstr(VAL(A7),0,2)~", ")
  SQL.ADD(" Precio3= "~Fstr(VAL(A8),0,2)~", ")
  SQL.ADD(" Precio7= "~Fstr(VAL(A8),0,2)~", ")
  SQL.ADD(" Total2= "~Fstr(VAL(A5),0,2)~", ")
  SQL.ADD(" Total9= "~Fstr(VAL(A41),0,2)~", ")
  SQL.ADD(" Total1= "~Fstr(VAL(A6),0,2)~", ")
  SQL.ADD(" PrecioRef1= '"~Fstr(VAL(A41),0,2)~"', ")
  SQL.ADD(" Cantidad1Ori= "~Fstr(VAL(A9),0,2)~", ")
  SQL.ADD(" Cantidad2Ori= "~Fstr(VAL(A3),0,2)~" ")
  SQL.ADD(" WHERE NrOperacion='"~Dialogo.NrOperacion2~"' ")
  SQL.ADD(" AND NrCuota="~FStr(FBN['NrCuota'],2,0)~" ")
  SQL.NEW
  SQL.EXEC

  *-- amortiza
  ACN (A3, val(A3)-VAL(A9))

  *** Actualiza movimientos y limites ****
  SQL.ActualizarMovimientos(Dialogo.NrOperacion2,SI)
  SQL.EXEC
Proximo

SQL.ADD(" SELECT C.NrCuota,Sum(C.Precio1) as Precio1,Sum(C.Precio3) as Precio3 ")
SQL.ADD(" FROM "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O WHERE ")
SQL.ADD(" C.NrOperacion=O.NrOperacion and O.OperacionRef='"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Group By C.NrCuota")

Recorrer SQL
   dfa 
   *- Actualizo la suma de IVA y wh de la operacion cabecera
   SQL.ADD("UPDATE "~DBO~".CUOTAS SET ")
   SQL.ADD("Precio1="~Fstr(FBN['Precio1'],0,2)~", ")
   SQL.ADD("Precio3="~Fstr(FBN['Precio3'],0,2)~"  ")
   SQL.ADD("WHERE NrOperacion='"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
   SQL.NEW
   SQL.EXEC
Proximo

***---Actualiza Movimientos Devengados
SQL.ActualizarMovimientos3(Dialogo.NrOperacion2,NO,NO,NO,NO,SI)
SQL.EXEC











