***---Armo Lista de Vehiculos del UsuarioActivo
IF NoVacio(UsrVehiculos(UsuarioActivo))
   ACT(LS:1, SQLSet(" Select Distinct Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
ELSE
   ACT(LS:1, SQLSet(" Select Codigo From "~DBO~".VEHICULOS "))
ENDIF

