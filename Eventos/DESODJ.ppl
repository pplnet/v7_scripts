CrearDialogo
  Fecha1      : 'Fecha Desde' ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      : 'Fecha Hasta' ; 2;1;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar una Fecha Hasta';NO;FSys
  Cliente1    : 'Cliente'     ; 3;1;;;;;;
  NrOperacion1: '# Operación' ; 4;1;;;;Vacio(Dialogo.NrOperacion1) o EqStr(BuscarCampo('OPERACIONES','DDJJRequiere','NrOperacion',Dialogo.NrOperacion1),'SI');'Debe ingresar una operacion que requiera DJ';NO;;;;;;"TipoOp in ('TIC','TIV') and IsNull(DDJJRequiere,'')='SI' "
  Check1      : 'Porcesa'     ; 5;1;;NO;NO;;;;1
FinDialogo
If Not OK
  Cancelar('Evento Cancelado')
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

SetFilaActual(1)
ACT(a:FAC, 'Nr Oper')
ACT(b:FAC, 'Tipo Op')
ACT(i:FAC, 'Req')
ACT(j:FAC, 'Codigo')
ACT(n:FAC, 'Emitida')
ACT(o:FAC, 'Pres')
ACT(p:FAC, 'Fecha Pres')
ACT(r:FAC, 'Confirma')
ACT(s:FAC, 'Emit')
ACT(t:FAC, 'Pres')
ACT(u:FAC, 'F.Pres Ori')
ACT(v:FAC, 'Emit Ori')
ACT(w:FAC, 'Pres Ori')

ACT(aa:FAC, 'Emi Edit')
ACT(ab:FAC, 'Emi Pres')

SQL.ADD(" Select * ")
SQL.ADD("From "~DBO~".OPERACIONES ")
if NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("where  NrOperacion = '"~Dialogo.NrOperacion1~"'  ")
else
  SQL.ADD("where FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")  
  EndIf
endif
SQL.ADD(" and DDJJRequiere = 'SI' ")  
SQL.ADD(" order by NrOperacion ")  
Recorrer SQL
  SCN(x:1, 1)
  ACT(a:FAC, fbn('NrOperacion'))
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACT(d:FAC, fbn('Cliente1'))
  ACT(e:FAC, fbn('Especie'))
  ACN(f:FAC, fbn('Cantidad'))
  ACT(g:FAC, fbn('ContraEspecie'))
  ACT(h:FAC, fbn('Mercado'))
  ACT(i:FAC, fbn('DDJJRequiere'))
  ACT(j:FAC, fbn('DDJJCodigo'))
  ACT(k:FAC, fbn('DDJJMercado'))
  ACT(l:FAC, fbn('DDJJTipoCli'))
  ACT(m:FAC, fbn('DDJJTipoEsp'))
  ACT(n:FAC, fbn('DDJJEmitida'))
  ACT(o:FAC, fbn('DDJJPresentada'))
  ACD(p:FAC, fbn('DDJJFechaPres'))
  ACT(q:FAC, fbn('DDJJObservac'))
  ACN(s:FAC, 0)
  if EqStr(fbn('DDJJEmitida'),'SI')
    ACN(s:FAC, 1)
    ACN(aa:FAC, 1)
  endif
  ACN(t:FAC, 0)
  if EqStr(fbn('DDJJPresentada'),'SI')
    ACN(t:FAC, 1)
    ACN(ab:FAC, 1)
  endif
  ACD(u:FAC, fbn('DDJJFechaPres'))
  ** Emitida Orignal
  ACN(v:FAC, Val(s:FAC))
  ** Presntada Orignal
  ACN(w:FAC, Val(t:FAC))
proximo
if Val(x:1)=0
  MessageBox('No hay operaciones a desmarcar')
else
  CrearListBox ; 'Arial,8,';'Seleccione las operaciones a desmarcar'
    'Conf'            ; r:2..r:fac;SI;;;30;CHECK;Exe('COLOR12');;;;;;NO;; 
    'NrOperacion'     ; a:2..a:fac;NO;;;70;STRING;;Exe('COLOR6');
    'TipoOp'          ; b:2..b:fac;NO;;;50;STRING;;Exe('COLOR6');
    'FechaOp'         ; c:2..c:fac;NO;;;80;FECHA;Exe('COLOR6');
    'Cliente'         ; d:2..d:fac;NO;;;80;STRING;;Exe('COLOR6');
    'Especie'         ; e:2..e:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Cantidad'        ; f:2..f:fac;NO;;;100;NUMERO;'####,###,###.##';Exe('COLOR6');
    'Moneda'          ; g:2..g:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Mercado'         ; h:2..h:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Requiere DJ'     ; i:2..i:fac;NO;;;50;STRING;;Exe('COLOR6');
    'Codigo DJ'       ; j:2..j:fac;NO;;;100;STRING;;Exe('COLOR6');
    'Emitida DJ'      ; s:2..s:fac;Val(aa:flb)=1;;;50;COMBO;'NO|SI';iif(Val(aa:flb)=1,Exe('COLOR12'),Exe('COLOR6'));
    'Presentada DJ'   ; t:2..t:fac;Val(ab:flb)=1;;;50;COMBO;'NO|SI';iif(Val(ab:flb)=1,Exe('COLOR12'),Exe('COLOR6'));
    'F.Pres DJ'       ; p:2..p:fac;NO;;;80;FECHA;Exe('COLOR6');
    'Observac'        ; q:2..q:fac;NO;;;150;STRING;;Exe('COLOR6');
  FinListBox
  If Not Ok
    Cancelar('Evento Cancelado')
  Endif
  Recorrer&i 2,fac
    If Val(r:&i) = 1
      SCN(x:2, 1)
      if Val(v:&i)=1 y Val(s:&i)=0
        * Estaba emitida y ahora no
        SCN(ac:&i, 1)
        if Dialogo.Check1=1
          SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
          SQL.ADD("   SET DDJJEmitida = 'NO' ")
          SQL.ADD(" Where NrOperacion    = '"~Val(a:&i)~"' ")
          SQL.NEW
        endif   
      endif   
      if Val(w:&i)=1 y Val(t:&i)=0
      * Estaba presentada y ahora no
        SCN(ad:&i, 1)
        if Dialogo.Check1=1
          SQL.ADD("UPDATE "~DBO~".OPERACIONES ")
          SQL.ADD("   SET DDJJPresentada = 'NO', ")
          SQL.ADD("       DDJJFechaPres = Null ")
          SQL.ADD(" Where NrOperacion    = '"~Val(a:&i)~"' ")
          SQL.NEW
        endif   
      endif   
      ACN(ae:&i, Val(ac:&i)+Val(ad:&i))
      if Val(ae:&i)>0
        if Dialogo.Check1=1
          MessageBox('Se actualizo la opeacion '~Val(a:&i))
          SQL.EXEC
        else
          MessageBox('Sin Procesar operacion '~Val(a:&i))
        endif   
      endif   
    endif
  proximo
  if Val(x:2)=0
    MessageBox('No se seleccionaron operaciones para desmarcar')
  else
    MessageBox('El proceso finalizo correctamente')
  endif
endif
