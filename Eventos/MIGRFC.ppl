MostrarCuadrodeMensajes
CrearDialogo 
  Fecha1 :'Fecha'    ;2;1; ;SI;SI;Dialogo.Fecha1<>0 y EsHabil(Dialogo.Fecha1,Var('FERIDEF'));'En fecha a tomar como base, debe Ingresar un dia habil';NO;Fsys;
  Label1 :''         ;1;1; ;NO;;;;;;'Cotizaciones a procesar';;;
  Check1:  'Procesa' ;1;2; ;NO;NO;;;;1;
FinDialogo
If Not OK
  Cancelar
Endif
if Dialogo.Check1=0 o SI
  HojaVisible(SI)
endif

If SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Registro='MCR' and Estado='PRO' ") = 1
  If MessageBox('Ya se habia migrado las cotizaciones. Continua????',3,2)<>6
    Cancelar('La migracion de las cotizaciones ha sido cancelado!!!') 
  Endif
Endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Arial,10,B')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

act(a3,'Migracion Cotizaciones ROFEX del '~Fecha(Dialogo.Fecha1))
SetFont(a3,3)

act(a:5,'Fecha')
act(b:5,'Posicion')
act(c:5,'Precio')
act(d:5,'Fecha Vto.')
act(e:5,'Esp.FPA')
act(f:5,'Fecha Vto.')
act(g:5,'Accion Plazo')
act(h:5,'Accion Cotiz')
act(i:5,'Accion Flag')

act(k:5,'E:')
act(l:5,'Cont. Vto')
act(m:5,'Esp Alias 10')
act(n:5,'TB:')
act(o:5, 'TB = 1')

SetFont(a:5..p:5,1)
AgregarMarco(a:5..i:5,2,0,Exe('COLOR6'))
AlinearCeldas(a:5..i:5,'C')

SetFilaActual(6)
acn(z:1,0)

message('Recuperando Cotiz. Rofex...')
SQL.ADD("Select * From "~DBO~".COTIZACIONESROFEX ")
SQL.ADD(" where isnull(Procesado,'0')='0' ")
SQL.ADD("   and SUBSTRING(Posicion,1,3) = 'DLR' ")
* FJL 16/11/18 - Criterio de Fecha para migracion - CONFIRMAR
*SQL.ADD(" where Convert(Date,FechaReal) = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and Convert(Date,FechaReal)   <= "~IdxDate2(Dialogo.Fecha1)~" ")
*SQL.ADD("   and SUBSTRING(Posicion,6,4) = '2019' ")
SQL.ADD("Order by SUBSTRING(Posicion,1,3),FechaVto ")
watch(SQL.Batch)
Recorrer SQL
  message('...'~fbn['Posicion'])
  act(a:fac,fbn['Fecha'])
  act(b:fac,fbn['Posicion'])
  acn(c:fac,fbn['Ajuste'])
  act(d:fac,fbn['FechaVto'])
  act(e:fac, BuscarCampo('PLAZOSMERCADO', 'Especie', 'NombreExtendido', fbn['Posicion']) )
   act(fp:fac, BuscarCampo('PLAZOSMERCADO', 'FechaVto', 'NombreExtendido', fbn['Posicion']) )
  ACN(fs:fac,Sql("Select 1 From "~DBO~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))

  If Val(fs:fac)=1
     ACD(fv:fac,Sql("Select MaturityDate From "~DBO~".SECURITYLISTROFEX Where Symbol = '"~Val(b:fac)~"' "))
  Else
     act(ft:fac, Copy(val(b:fac),longitud(val(b:fac))-3,4)~'-'~Copy(val(b:fac),longitud(val(b:fac))-5,2)~'-01')
     acd(fv:fac,FinDeMes(Fecha(Val(ft:fac)),NO,'ARG'))
  Endif  

  acd(f:fac, Val(fv:fac))
    
  ACN(tb:fac,0) 
  If NoVacio(Val(e:fac))
     ACT(k:FAC, 'Existe Especie Plazo')
     *  Existe Posicion en PLAZOSMERCADO
     *  Actualizar FechaVto si Cambió
     If Val(fp:fac)<>Val(fv:fac)
        SQL.ADD("Update "~DBO~".PLAZOSMERCADO ")
        SQL.ADD(" Set FechaVto =  "~IdxDate2(val(fv:fac))~" ")
        SQL.ADD(" Where MercadoNegociacion = '"~Var('MERROFEX')~"' ")
        SQL.ADD("   And NombreExtendido    = '"~Val(b:fac)~"' ")
        SQL.ADD("   And Especie            = '"~Val(e:fac)~"' ")        
        SQL.NEW
        SQL.EXEC 
     Endif
    
    ACN(tb:fac,1)
  Else
    ACT(k:FAC, 'NO Existe Especie Plazo')
    * NO Existe Posicion en PLAZOSMERCADO
    If val(fv:fac) >= Dialogo.Fecha1 
      ACT(l:FAC, 'Vto mayor hoy')
      *-Verifico si puedo agregar la nueva EspecieRofex---
      *act(e:fac, BuscarCampo('ESPECIES','Codigo','Alias10',Copy(Val(b:fac),1,3)) )
      ACT(e:fac, Sql("Select Codigo From "~DBO~".ESPECIES Where Alias10 = '"~Copy(val(b:fac),1,longitud(val(b:fac))-6)~"' "))
      If NoVacio(Val(e:fac))
        act(m:fac, 'Esta Esp.c/Alias10')
        ACT(g:FAC, 'Insert Plazo')
        IF Dialogo.Check1=1
          SQL.ADD("Insert INTO "~DBO~".PLAZOSMERCADO ( ")
          SQL.ADD("       NombreExtendido, Especie, FechaVto, MercadoNegociacion ")
          SQL.ADD("     ) VALUES ( ")
          SQL.ADD("       '"~Val(b:fac)~"',")
          SQL.ADD("       '"~Val(e:fac)~"', ")
          SQL.ADD("       "~IdxDate2(val(fv:fac))~", ")
          SQL.ADD("       '"~Var('MERROFEX')~"' ")
          SQL.ADD("     ) ")
          SQL.NEW
          SQL.EXEC 
          ACN(tb:fac,1)
        Endif 
      Else
        act(m:fac, 'No esta Alias10')
      Endif 
    Else
      act(l:fac, 'Fecha Vto. Menor')  
    Endif  
  Endif
 
  ACN(n:FAC, Val(tb:fac))
  If Val(tb:fac)=1
    ACT(o:FAC, 'TB = 1')
    If SQL("select 1 from "~DBO~".COTIZACIONESFUT where Codigo='"~Val(e:fac)~"' and Fecha="~IdxDate2(Dialogo.Fecha1)~" and FechaFut="~IdxDate2(val(fv:fac))~" and CallPut='FUT' ")=0
      Message('Generando cotizaciones...')
      ACT(h:FAC, 'Insert Cotizacion')
      IF Dialogo.Check1=1
        SQL.ADD("Insert into "~DBO~".COTIZACIONESFUT ( ")
        SQL.ADD("       Fecha,       CallPut,      Codigo,  Precio1,  ")
        SQL.ADD("       FechaFut,    Moneda,       Mercado, PrecioEj, ")
        SQL.ADD("       FechaUltAct, UsuarioUltAct ")
        SQL.ADD("     ) Values ( ")
        SQL.ADD("       "~IdxDate2(Dialogo.Fecha1)~",")
        SQL.ADD("       'FUT', ")
        SQL.ADD("       '"~Val(e:fac)~"', ")
        SQL.ADD("       "~Fstr(fbn['Ajuste'],0,9)~", ")

        SQL.ADD("       "~IdxDate2(val(fv:fac))~", ")
        SQL.ADD("       '"~VAR('MONELOCA')~"', ")
        SQL.ADD("       '"~Var('MERROFEX')~"', ")
        SQL.ADD("       "~Fstr(0,0,0)~", ")

        SQL.ADD("       "~SQLAhora~", ")
        SQL.ADD("       '"~UsuarioActivo~"' ")
        SQL.ADD("     ) ")
        SQL.NEW
      Endif
    Else
      Message('Actualizando cotizaciones...')
      ACT(h:FAC, 'update Cotizacion')
      IF Dialogo.Check1=1
        SQL.ADD("Update "~DBO~".COTIZACIONESFUT ")
        SQL.ADD("   Set Precio1       = "~Fstr(fbn['Ajuste'],0,9)~", ")
        SQL.ADD("       FechaUltAct   = "~SQLAhora~", ")
        SQL.ADD("       UsuarioUltAct = '"~UsuarioActivo~"' ")
        SQL.ADD(" where Codigo   = '"~Val(e:fac)~"'  ")
        SQL.ADD("   and Fecha    = "~IdxDate2(Dialogo.Fecha1)~"  ")
        SQL.ADD("   and FechaFut = "~IdxDate2(val(fv:fac))~"  ")
        SQL.ADD("   and CallPut  = 'FUT' ")
        SQL.NEW
      Endif
    Endif
     
    scn(z:1,1)
    IF Dialogo.Check1=1
      Message('Procesado COTIZACIONESROFEX...')     
      SQL.ADD("Update "~DBO~".COTIZACIONESROFEX ")
      SQL.ADD("   Set Procesado = '1' ")
      SQL.ADD(" where Fecha     = "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD("   and Posicion  = '"~Val(b:fac)~"' ")
      SQL.NEW     
      SQL.EXEC
    Endif
  Endif
  FormatoCeldas(c:fac,Exe('F8'))
  AlinearCeldas(a:fac..b:fac,'C')
  AlinearCeldas(d:fac..e:fac,'C')
  SetFont(a:fac..e:fac,2)

Proximo

If Val(z:1)>0
  ** Grabo el registro en FLAGSMERCADO
  If Sql("Select 1 From "~DBO~".FLAGSMERCADO  Where Fecha="~IdxDate2(Dialogo.Fecha1)~" and Registro='MCR' ")=0
    ACT(i:FAC, 'Insert Flag')
    IF Dialogo.Check1=1
      SQL.ADD(" Insert into "~DBO~".FLAGSMERCADO ( ")
      SQL.ADD(" Fecha,  Registro,     Cantidad, HoraMercado, ")
      SQL.ADD(" Estado, FechaMercado, Mercado,  Descripcion ")
      SQL.ADD(" ) Values (")
      SQL.ADD(" "~IdxDate2(Dialogo.Fecha1)~",")
      SQL.ADD(" 'MCR', ")
      SQL.ADD(" "~Fstr(Val(z:1),0,0)~", ")
      SQL.ADD(" '"~Copy(Hora(Ahora),1,2)~Copy(Hora(Ahora),4,2)~Copy(Hora(Ahora),7,2)~"', ")
     
      SQL.ADD("  'PRO', ")
      SQL.ADD(" "~Copy(IdxDate2(Fsys),3,2)~Copy(IdxDate2(Fsys),6,2)~Copy(IdxDate2(Fsys),9,2)~", ")
      SQL.ADD(" '"~Var('MERROFEX')~"', ")
      SQL.ADD(" 'Migracion Cot ROFEX' ")
      SQL.ADD(" ) ")
    Endif
  Else
    ACT(i:FAC, 'Update Flag')
    IF Dialogo.Check1=1
      SQL.ADD("Update "~DBO~".FLAGSMERCADO ")
      SQL.ADD(" Set HoraMercado = '"~Copy(Hora(Ahora),1,2)~Copy(Hora(Ahora),4,2)~Copy(Hora(Ahora),7,2)~"', ")
      SQL.ADD("     Estado      = 'PRO', ")
      SQL.ADD("     Cantidad    = "~Fstr(Val(z:1),0,0)~" ")
      SQL.ADD(" Where Fecha     = "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD(" and Registro    = 'MCR' ")
    Endif
  Endif
  IF Dialogo.Check1=1
    SQL.NEW
    SQL.EXEC
  Endif
  MessageBox('El proceso de migracion cotizaciones finalizo correctamente!!!') 
Else
  MessageBox('No existen cotizaciones para procesar!!!') 
Endif

SetFilaActual(fac+2)
act(a:fac,'Fin listado')
SetFont(a:fac,1)

ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,6)
ACO(6,8)
ACO(7,10)
ACO(8,10)
ACO(9,10)

ACO(11,15)
ACO(12,15)
ACO(13,15)
ACO(14,8)
ACO(15,8)

LimitesVision(j:fac+2)
