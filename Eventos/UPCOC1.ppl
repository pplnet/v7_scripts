*HojaVisible(SI)
CrearDialogo
  Vehiculo1  : "Vehiculo"      ;;;;NO;;;;;VAR('VEHICULODE')
  Entero1    : "Trimestre"     ;3;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Entero1>=1 y Dialogo.Entero1<=4;'Nro. de Trimestre Incorrecto';NO;IIf(Trunc2(Mes(Fsys)/3.1)=0,4,Trunc2(Mes(Fsys)/3.1))
  Entero4    : "Mes"           ;3;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Entero4>=1 y Dialogo.Entero4<=12;'Nro. de Mes Incorrecto';NO;Mes(Fsys)-1
  Entero2    : "Anio"          ;;;;;;Dialogo.Entero2>=0;'Anio Incorrecto !!!';NO;IIf(Trunc2(Mes(Fsys)/3.1)=0,Anio(Fsys)-1,Anio(Fsys));IIf(Trunc2(Mes(Fsys)/3.1)=0,Anio(Fsys)-1,Anio(Fsys))
  Fecha2     : "F.Hasta"       ;;;; ;;Dialogo.Fecha2<=Habiles(FSys,1);"Fecha Hasta Incorrecta";NO;;FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI)
  Cliente1   : "Cliente"       ;;;;;;;;;;;;
  Radio2     : "Tipo|Trimestral|Mensual|"  ;;;;NO;NO;;;;1
  Lista1     : "Oficial Cta"   ;;;;;;;;;;;SQLSet("SELECT Descripcion FROM "~DBO~".OFICIALESCUENTA ORDER BY Descripcion ");
FinDialogo
* IIf(Dialogo.Entero1<>Trunc2(Mes(Fsys)/3.1)+1,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),IIF(Fsys=FinDeMes(Fsys),FinDeMes(Fsys,SI),Fsys));IIf(Dialogo.Entero1<>Trunc2(Mes(Fsys)/3.1)+1,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),IIF(Fsys=FinDeMes(Fsys),FinDeMes(Fsys,SI),Fsys));
If Not Ok
   Cancelar
endif

*-- Transacciones de Cierre de Trimestre
SQL.ADD("SELECT '0' as Marca,T.* FROM "~DBO~".TRANSACCIONES2 T Where TipoTr2='CUSSAL' ")
If Dialogo.Radio2=0
   SQL.ADD("and Precio1="~Fstr(Dialogo.Entero1,0,0)~" ")
Else
   SQL.ADD("and Precio1="~Fstr(Dialogo.Entero4,0,0)~" ")
EndIf
SQL.ADD("and Precio2="~Fstr(Dialogo.Entero2,0,0)~" and (CB1='1' or Fecha1='"~IdxDate(Dialogo.Fecha2)~"')")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and Vehiculo1='"~Dialogo.Vehiculo1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and Cliente1='"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and Ley2 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD("Order By Ley1,Especie,Cliente1")

ACN(z1, 4)
SetFilaActual(Val(z1))

Recorrer SQL
   acn(a:fac, FBN['Marca'])
   act(b:fac,Trim(FBN['Ley1'])~' '~Trim(FBN['Ley2']))
   act(c:fac,FBN['Cliente1'])
   act(d:fac,FBN['Cuenta1'])
   act(e:fac,FBN['Especie'])
   act(f:fac,FBN['NrTrans'])
   acn(g:fac,FBN['Cantidad2'])
   acn(h:fac,FBN['Cantidad6'])
   acn(K:fac,FBN['Cambio5'])

   scn(z1,1)
Proximo

IF Val(z1) <=4 
   Cancelar('No se Encontraron Comisiones para la Seleccion Indicada !!! ')
ENDIF

act(z2,Dialogo.Vehiculo1~IIF(Dialogo.Radio2=0,' Trimestre: '~Fstr(Dialogo.Entero1,0,0),' Mes: '~Fstr(Dialogo.Entero4,0,0))~' '~' Hasta : '~Dialogo.Fecha2)

Recorrer&i 1, 1000
   CrearListBox ; 'Arial,8,';Val(z2)
      'Marca'           ; a5..a:Val(z1);SI;SI;; 30;CHECK;RGB(220,220,193)
      'Oficial'         ; b5..b:Val(z1);NO;SI;; 100;STRING;;RGB(180,180,193)
      'Cliente'         ; c5..c:Val(z1);NO;SI;; 80;STRING;;RGB(180,180,193)
      'Cuenta'          ; d5..d:Val(z1);NO;SI;; 80;STRING;;RGB(180,180,193)
      'Especie'         ; e5..e:Val(z1);NO;SI;; 80;STRING;;RGB(180,180,193)
      'NrTrans'         ; f5..f:Val(z1);NO;SI;; 80;STRING;;RGB(180,180,193)
      'Comision'        ; g5..g:Val(z1);NO;SI;; 80;NUMERO;'###,###,###,###.##';RGB(180,180,193)
      'CORRIGE'         ; h5..h:Val(z1);SI;[Val(a:FLB)=1 y Val(g:FLB)<>Val(h:FLB)] o Val(a:FLB)=0;'Comision CORREGIDA INCORRECTA Cliente:'~Val(c:FLB)~' Cuenta:'~Val(d:FLB); 80;NUMERO;'###,###,###,###.##';RGB(220,220,193)
   FinListBox

   IF Not Ok
      Cancelar
   ENDIF

   Recorrer&j 5, Val(z1)
      * Si marca, Corrijo la Cantidad1 de la Transaccion 
      IF Val(a:&j)=1 

         *- q: Monto de Iva
         acn(j:&j,ROUND(Abs(val(h:&j))*val(k:&j) /100,2)  )

         Message('Actualizando Comision Cliente '~Val(c:&j)~' Cuenta:'~Val(d:&j))
         SQL.ADD("UPDATE "~DBO~".TRANSACCIONES2 Set Cantidad6="~FStr(Val(h:&j),0,2)~",Cantidad3="~Fstr(Abs(val(j:&j)),0,2)~" ")
         SQL.ADD("Where NrTrans='"~Val(f:&j)~"' ")
         SQL.NEW
         SQL.EXEC    

         SQL.ActualizarMovimientosT2(Val(f:&j),SI,NO,NO,NO)
         SQL.EXEC    
      ENDIF
   Proximo

   If Val(z3) = 0
      BREAK
   EndIf

Proximo