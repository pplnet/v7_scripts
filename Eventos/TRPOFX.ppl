CrearDialogo
  Especie1: 'Especie'     ;1;1;1;  ;  ;Novacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una Moneda.';NO;;;;;;
  Check1:   'Procesa'     ;1;2;1;SI;SI;;;;0;
  Cantidad1:'Cantidad VN' ;2;1;1;  ;  ;Dialogo.Cantidad1>0;'La catidad debe ser mayor que cero.';NO;
  Book1:    'Book Origen' ;3;1;1;SI;SI;NoVacio(Dialogo.Book1);'Debe ingresar un book Origen';NO;;
  Book2:    'Book Destino';4;1;1;SI;SI;NoVacio(Dialogo.Book2) y Not EqStr(Dialogo.Book2,Dialogo.Book1);'Debe ingresar un book Destino distinto al Origen.';NO;;
  Fecha1:   'Fecha'       ;5;1;1;NO;NO;;;;FSys
  FinDialogo
if not Ok
  Cancelar
endif
if Dialogo.Check1=0
  HojaVisible(SI)
endif


