* Informe de Devengamientos del Mes 
*- Debo recuperar las operaciones vigentes al primer dia del mes
ModoReproceso(SinDialogo)
HojaVisible(NO)
CrearDialogo
   Fecha1      : "Fecha Vigencia"    ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Vigencia Invalida';NO;FinDeMes(Fsys,SI);
   Cliente1    : "Entidad"           ;;;;;;;;;;;;;
   Especie1    : "Especie"           ;;;;;;;;;;;LeerObjeto('Monedas')
   NrOperacion1: "NrOperacion"       ;;;;;;;;;;;;;;" TipoOp In ('MMON','MMONM','MMPSC','MMPSI','MMSCMV','MMSIMV','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPLME','MMPCCV','DTSFF','DTSFV','DTSVV','DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','MMCAUP','SERP','SERPV','MMDC')"
   Check1      : "Interes"           ;;;;;;;;;1
   Check2      : "Imp.Interes"       ;;;;;;;;;1
   Check5      : "Imp.WH"            ;;;;;;;;;1
*  Check3      : "ComisionEF"        ;;;;;;;;;1
   Check4      : "Prima/Dto ON"      ;;;;;;;;;1
   Radio1      : "Expresado|"~Var('MONELOCA')~"|"~Var('MONEEXTR')~"|Moneda Original" ;;;;;;;;;2
   Lista2      : "TipoOp"            ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMON','MMONM','MMPSC','MMPSI','MMSCMV','MMSIMV','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPLME','MMPCCV','DTSFF','DTSFV','DTSVV','DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','MMCAUP','SERP','SERPV','MMDC') ")   
   Lista1      : "Vehiculo"          ;-5;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
   Lista3      : "Comisiones"        ;-2;2;;;;;;;;;VAR('TCOMISION')
   Check6      : 'Visible'           ;;;;NO;NO;;;;0;
   Radio3      : "Consolidado|SI|NO" ;;;;SI;SI;;
   Vehiculo1   : "Grupo"             ;;;;NO;NO;;;;
FinDialogo

If Not Ok
   Cancelar
Endif


ACT(P:1,'MMON|MMONM|MMPSC|MMPSI|MMSCMV|MMSIMV|MMFIMV|MMPCLM|MMPEM|MMPIM|MMPOSM|MMFRNP|MMPLME|MMPCCV|DTSFF|DTSFV|DTSVV|DTSFFM|DTSFVM|DTSVVM|DTCAP|DTFLO|MMCAUP|SERP|SERPV|MMDC')
If Vacio(Dialogo.Lista2)
    LinkearHoja('DEVMES', 1, Fecha1=Dialogo.Fecha1, Cliente1=Dialogo.Cliente1,Especie1=Dialogo.Especie1,NrOperacion1=Dialogo.NrOperacion1,Check1=Dialogo.Check1,Check2=Dialogo.Check2,Check5=Dialogo.Check5,Check4=Dialogo.Check4,Radio1=Dialogo.Radio1,Lista2=val(P:1),Lista1=Dialogo.Lista1,Lista3=Dialogo.Lista3,Check6=Dialogo.Check6,Radio3=Dialogo.Radio3,Vehiculo1=Dialogo.Vehiculo1)
Else
    LinkearHoja('DEVMES', 1, Fecha1=Dialogo.Fecha1, Cliente1=Dialogo.Cliente1,Especie1=Dialogo.Especie1,NrOperacion1=Dialogo.NrOperacion1,Check1=Dialogo.Check1,Check2=Dialogo.Check2,Check5=Dialogo.Check5,Check4=Dialogo.Check4,Radio1=Dialogo.Radio1,Lista2=Dialogo.Lista2,Lista1=Dialogo.Lista1,Lista3=Dialogo.Lista3,Check6=Dialogo.Check6,Radio3=Dialogo.Radio3,Vehiculo1=Dialogo.Vehiculo1)
EndIf

CerrarHoja('DEVMEA', 1)