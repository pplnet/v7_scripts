HojaVisible(NO)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Lista1   : 'Vehiculo'          ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Especie1 : 'Especie'           ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie valida.';NO;Var('MONEEXTR');;;;;"Tipo='MON' "
  Radio3   : 'Tipo|Fondos|DepoPlazo|Overnights|ColocExt|Todo'  ;;;;;;;;;4;
  Radio1   : 'Consolidado|Si|No' ;;;;;;;;;0;
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0;
  Precio1  : 'Cotizacion'        ;;;;;Not EqStr(Dialogo.Especie1,Dialogo.Especie2);Dialogo.Precio1<>0 o EqStr(Dialogo.Especie1,Dialogo.Especie2);'Debe ingresar la cotizacion.';NO;;
  Especie2 : 'Especie '          ;;;;;NO;;;;IIF(Dialogo.Radio2=0,'ARP','USD');IIF(Dialogo.Radio2=0,'ARP','USD');
FinDialogo

if not OK
  Cancelar
endif

*- Control de Vehiculos
If NoVacio(Dialogo.Lista1)
   ACT(zz6, Dialogo.Lista1)
Else
   ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")) )
Endif

ACD(fe2,Habiles(Dialogo.Fecha1,-1,'ARG',NO) )
ACT(ZZ7,'')

if Dialogo.Radio1=1
   ACT(en1,Dialogo.Especie1)
   If Dialogo.Radio3<>0
      If Dialogo.Radio3=4
         ** SELECCIONO OPERACIONES VINCULADAS
         SQL.ADD(" Select O.Vehiculo1 ")
         SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL  ")
         SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  ( (O.TipoOp In ('MMPCCV') and O.MB3=1) or (O.TipoOp In ('VIMIND','VIMINM','TEMIND') and O.MB3=0) )  ")
         If NoVacio(Dialogo.Lista1)
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
         Else
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
         endif
         SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
         SQL.ADD(" UNION ")
      endif

      SQL.ADD(" Select O.Vehiculo1 ")
      SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ")
      SQL.ADD(" where O.Cliente1 = CL.Codigo and O.NrOperacion = C.NrOperacion ")
      SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  ( (O.TipoOp In ('MMCPM')) or (O.TipoOp In ('MMPCCM') and O.MB3=1) ) ")
      If NoVacio(Dialogo.Lista1)
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
      Else
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
      endif
      SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
      If Dialogo.Radio3=1
         ACT(zz7, VAR('OPDEPPLAZO'))
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPDEPPLAZO'))~") ")
         SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
      Endif
      If Dialogo.Radio3=2
         ACT(zz7, VAR('OPOVERNIGH'))
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPOVERNIGH'))~") ") 
         SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
      Endif
      If Dialogo.Radio3=3
         ACT(zz7, VAR('OPCOLOCEXT'))
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPCOLOCEXT'))~") ")
         SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
      Endif
      SQL.ADD(" UNION ")
      SQL.ADD("Select O.Vehiculo1 ")
      SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
      SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMCP','MMDCA','MMO','MMD','MMCDIA','MMCCR') ")
      If NoVacio(Dialogo.Lista1)
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
      Else
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
      endif
      SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
      If Dialogo.Radio3=1
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPDEPPLAZO'))~") ")
         SQL.ADD("       and  CL.PaisDir In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
      Endif
      If Dialogo.Radio3=2
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPOVERNIGH'))~") ") 
         SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONEEXTR'))~") ")
      Endif
      If Dialogo.Radio3=3
         SQL.ADD("       and O.TipoOp in ("~Pipe2Comillas(VAR('OPCOLOCEXT'))~") ")
         SQL.ADD("       and  CL.PaisDir Not In ("~Pipe2Comillas(VAR('ENTLOC'))~") ")
         SQL.ADD("       and  O.Especie Not In ("~Pipe2Comillas(VAR('MONELOCA')~"|"~VAR('MONEEXTR'))~") ")
      Endif

      If Dialogo.Radio3=4
         SQL.ADD(" UNION ")
         SQL.ADD(" Select O.Vehiculo1 ")
         SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
         SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  ((O.FechaVto2 Is Not Null and O.FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"') or (O.FechaVto2 Is Null and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"') )")
         SQL.ADD(" and  O.TipoOp In ('MMCDP') ")
         If NoVacio(Dialogo.Lista1)
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
         Else
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
         endif
         SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
         SQL.ADD(" UNION ")
         *** depositos por compra/venta de moneda no puesto ****
         SQL.ADD(" Select O.Vehiculo1 ")
         SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
         SQL.ADD(" where O.Cliente1 = CL.Codigo and O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.FechaVto   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
         SQL.ADD(" and  O.FechaVto <> O.FechaPago ")
         SQL.ADD(" and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
         If NoVacio(Dialogo.Lista1)
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
         Else
            SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
         endif
         SQL.ADD(" and  O.Especie In ('"~val(en1)~"') ")
      Endif
   Endif

   If Dialogo.Radio3=0 o Dialogo.Radio3=4
      if Dialogo.Radio3=4
         SQL.ADD(" UNION ")
      else
         ACT(zz7, 'FON|FCR|FCS|')
      endif
      ** SALDOS DE FONDOS
      SQL.ADD(" Select '' Vehiculo1 ")
      SQL.ADD(" from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
      SQL.ADD(" where  S.Especie = E.Codigo ")
      SQL.ADD(" and  S.NrSaldo = 2 ")
      SQL.ADD(" and  Round(S.Saldo,2) <> 0 ")
      SQL.ADD(" and  E.Tipo = 'FON' ")
      SQL.ADD(" and  E.Cotiza = '"~val(en1)~"' ")
      SQL.ADD(" and  S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
      SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
      SQL.ADD("                   and    D.Especie = S.Especie  ")
      SQL.ADD("                   and    D.Cliente = S.Cliente  ")
      SQL.ADD("                   and    D.NrSaldo = 2 ")
      SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Val(fe2))~"') ")
      SQL.ADD(" UNION ")

      ** SELECCIONO LAS OPERACIONES DE FONDOS DE HOY
      SQL.ADD(" Select O.Vehiculo1 ")
      SQL.ADD(" FROM "~DBO~".OPERACIONES O  ")
      SQL.ADD(" WHERE TipoOp in ('FCS','FCR') ")
      SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and O.ContraEspecie = '"~val(en1)~"' ")
      If NoVacio(Dialogo.Lista1)
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
      Else
         SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Val(zz6))~") ")
      endif
   endif
   ACN(ba1,0)
   Recorrer SQL
      if Not EqStr(FBN['Vehiculo1'],'')
         SCN(ba1,1)
         LinkearHoja('INVFO1', Val(ba1), Fecha1=Dialogo.Fecha1, Lista1=FBN['Vehiculo1'], Especie1=Dialogo.Especie1, Radio2=Dialogo.Radio2, Precio1=Dialogo.Precio1, Especie2=Dialogo.Especie2, Radio3=Dialogo.Radio3, Lista2=Val(zz7) )
      endif
   Proximo
Else
   LinkearHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,Val(zz6)), Especie1=Dialogo.Especie1, Radio2=Dialogo.Radio2, Precio1=Dialogo.Precio1, Especie2=Dialogo.Especie2, Radio3=Dialogo.Radio3, Lista2='' )
Endif