* DELIA1 Detalle de Limites Posicion Activos (Saldos)
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1    : 'Fecha'          ;;;;;;;;;FSys
  String    : 'Tipo de Saldo'  ;;;;;;;;;'FON';;
  Vehiculo1 : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  String1   : 'Condicion'      ;;;;;;;;;" Alias2='0'";;
  String2   : 'Titulo'         ;;;;;;;;;" Fondos ";;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,"Detalle de Limites Posicion Activos")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Fecha : '~Dialogo.Fecha1)

ACT(a:FAC+2, 'Tipo de Saldo : '~Dialogo.String2)

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1)
   ACT(z10, Descendientes('Vehiculos', Dialogo.Vehiculo1))
   if NoVacio(Val(z10))
      ACT(z11, "'"~Dialogo.Vehiculo1~"',"~Pipe2Comillas(Val(z10)))
   else
      ACT(z11, "'"~Dialogo.Vehiculo1~"'")
   endif
Else
   ACT(a:FAC+3, 'Vehiculo : Todos')
EndIf


SetFont(a:fac..N:FAC+3,2)

SetFilaActual(fac+7)

ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Vehiculo')
ACT(c:FAC, 'Valor Nominal')
ACT(d:FAC, 'Cotizacion')
ACT(e:FAC, 'Monto '~VAR('MONEEXTR'))

SetFont(a:fac..e:FAC,2)
AgregarMarco(a:FAC..e:FAC,2,0,Exe('COLOR'))

If Incluido(Dialogo.String,'FON')
   SQL.ADD("Select E.Cotiza, E.Issuer, E.Codigo, S.EnteCustodia, E.InteresesC,E.VTeorico,S.Saldo ")
   SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
   SQL.ADD("where  S.Especie = E.Codigo  ")
   SQL.ADD("  and  S.NrSaldo = 2 ")
   SQL.ADD("  and  S.Saldo <> 0 ")
   If NoVacio(Dialogo.String)
      SQL.ADD(" and E.Tipo='"~Dialogo.String~"' ")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD("and S.Cliente='"~Dialogo.Vehiculo1~"' and S.Cliente=S.EnteCustodia ")
   endif
   If NoVacio(Dialogo.String1)
      SQL.ADD(" and "~Dialogo.String1~" ")
   endif
   SQL.ADD("and   S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
   SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
   SQL.ADD("                   and    D.Especie = S.Especie  ")
   SQL.ADD("                   and    D.Cliente = S.Cliente  ")
   SQL.ADD("                   and    D.NrSaldo = 2 ")
   SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("order by E.Cotiza, E.Issuer,E.Codigo, S.EnteCustodia ")
EndIf
If Incluido(Dialogo.String,'REPOS')
   *- Ajuste por Repos
    SQL.ADD("Select O.Vehiculo1 EnteCustodia,E.Codigo, O.TotalNetoCli2 Saldo,E.VTeorico,E.InteresesC,E.Cotiza  ")  
   SQL.ADD("from "~DBO~".OPERACIONES O,"~DBO~".ESPECIES E ")
   SQL.ADD("where O.Especie=E.Codigo ")
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   endif
   If NoVacio(Dialogo.String1)
      SQL.ADD(" and "~Dialogo.String1~" ")     
   endif
   SQL.ADD(" and  FechaOp2<= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  (FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' or FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD(" and  TipoOp In ('SERA','SERAV','SERP','SERPV') ") 
   SQL.ADD(" Order By E.Codigo ")
EndIf
If Not Incluido(Dialogo.String,'REPOS|FON')

   *- Publico Nacionales      : Security='0' and Tipo='PUB'
   *- Publico Provinciales    : Security='1' and Tipo='PUB'
   *- Publico Municipales     : Security='2' and Tipo='PUB'
   *- Publico Otros           : Security='3' and Tipo='PUB'
   *- Privados B.Corp.Local   : (PaisOrigen='ARG' or PaisOrigen is NULL) and Tipo='ONE'
   *- Privados B.Corp.Exterior: (PaisOrigen <> 'ARG' and PaisOrigen is not NULL) and Tipo='ONE'
   *- Acciones                : Tipo='PRI'
   *- Posiciones Spot
   SQL.ADD("Select E.Codigo, P.Vehiculo EnteCustodia,E.InteresesC,E.VTeorico,Sum(P.CantidadFin) as Saldo ")
   SQL.ADD("from "~DBO~".POSICIONES P,"~DBO~".ESPECIES E ")
   SQL.ADD("where P.Especie = E.Codigo and P.NrSaldo = 101 ")
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and P.Vehiculo ='"~Dialogo.Vehiculo1~"' ")
   Endif
   If NoVacio(Dialogo.String)
      SQL.ADD(" and E.Tipo='"~Dialogo.String~"' ")
   endif
   If NoVacio(Dialogo.String1)
      SQL.ADD(" and "~Dialogo.String1~" ")
   Endif
   SQL.ADD("and P.Fecha = (Select Max(O.Fecha) from "~DBO~".POSICIONES O")
   SQL.ADD("    where O.Especie = P.Especie ")
   SQL.ADD("    and O.NrSaldo = 101")
   SQL.ADD("    and O.Vehiculo = P.Vehiculo")
   SQL.ADD("    and O.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("group by E.Codigo,P.Vehiculo,E.InteresesC,E.VTeorico")
EndIf

acn(x1,fac)

Recorrer SQL
  *- Recupero la Posicion de Repos
  ACN(z8,0)

  (.'LPOSSREPO'.) 

  ACT(a:FAC, FBN['Codigo'])
  ACT(b:FAC, FBN['EnteCustodia'])
  ACN(c:FAC, FBN['Saldo']+VAL(Z8))

  acn(d:fac,CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD'))

  ACT(ab:fac,FBN['InteresesC'])
  ACN(ac:fac,FBN['VTeorico'])

  if EqStr(Val(ab:fac),'CLE')
     * ensuciar el precio 
     ** calcular la tasa (%) x95:Dif. de dias x96:Especie x97:Fecha de Liquidacion   x98:Tasa Base x99:Tasa 
     ACT(x96,fbn('Codigo'))
     ACD(x97,Dialogo.Fecha1)
     ACN(x98,0)
     ACN(x99,0)

     (.'CALCINT'.)

     *TotalIntereses
     ACN(y98,Val(ac:fac)*Val(c:fac)*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Codigo')),Fsys)/100*Val(x95))

     * Total Neto
     ACN(y99,(Val(ac:fac)*Val(c:fac)*Val(d:fac))+Val(y98))

     * Precio Sucio
     ACN(d:fac, Val(y99)/Val(c:fac))
  endif

  ACN(e:FAC, val(c:fac)*val(d:fac))
Proximo
ifa

ACT(a:fac,'Total ')
ACN(e:fac, Sum(e:val(x1)..e:fac))

FormatoCeldas(c:val(x1)..d:fac,Exe('F2'))
FormatoCeldas(d:val(x1)..d:fac,Exe('F7'))
SetFont(a:val(x1)+1..e:FAC,1)
SetFont(a:FAC..e:FAC,2)

ACO(1,8)
ACO(2,8)
ACO(3,10)
ACO(4,6)
ACO(5,10)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(e:FAC)

