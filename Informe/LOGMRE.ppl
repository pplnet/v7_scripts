*Informe: LOGMRE
*Tipo: LOGFIL
*Movimientos Operativos Retroactivos
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:'Fecha'       ;;;;  ;  ;Dialogo.Fecha1>0 y Dialogo.Fecha1<=Fsys;'Debe ingresar una fecha valida';NO;Fsys
  Fecha2:'F.Hasta'     ;;;;NO;NO;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta debe ser mayor o igual a Fecha Desde';NO;Fsys
  Check2:'Exporta PDF' ;;;;NO;NO;;;;0;
FinDialogo

if Not OK
  cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:fac, 'FPA V6')
ACT(e:FAC, 'Movimientos Operativos Retroactivos')
AlinearCeldas(e:fac,'C')
ACT(a:FAC+1, 'Fecha : '~Dialogo.Fecha1)
*ACT(a:FAC+2, 'Hasta Fecha : '~Dialogo.Fecha2)

ACT(a:FAC+4, 'Cliente')
ACT(b:FAC+4, 'Fecha')
ACT(c:FAC+4, 'Importe')
ACT(d:FAC+4, 'Especie/')
ACT(d:FAC+5, 'Moneda')
ACT(e:FAC+4, 'Tipo de')
ACT(e:FAC+5, 'Operacion')
ACT(f:FAC+4, '# Operacion')
ACT(g:FAC+4, 'Precio/')
ACT(g:FAC+5, 'Tasa')
ACT(h:FAC+4, 'Fecha de la Imputación')
ACT(i:FAC+4, 'Usuario')
SetFont(a:FAC..i:FAC+5,2)
AgregarMarco(a:FAC+4..i:FAC+5, 2, 0, Exe('COLOR'))

SetFilaActual(FAC+5)
SQL.ADD("Select * from "~DBO~".OPERACIONES ")
SQL.ADD(" where FechaCarga >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and FechaCarga < '"~IdxDate(Dialogo.Fecha1+1)~"' ")
SQL.ADD("   and FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" order by FechaCarga ")
Recorrer SQL
  scn(x1,1)
  ACT(a:FAC, fbn('Cliente1'))
  ACD(b:FAC, fbn('FechaOp'))
  ACN(c:FAC, fbn('Cantidad'))
  ACT(d:FAC, fbn('Especie'))
  ACT(e:FAC, fbn('TipoOp'))
  ACT(f:FAC, fbn('NrOperacion'))    
  ACN(g:FAC, fbn('Precio1'))
  ACT(h:FAC, fbn('FechaCarga'))
  ACT(i:FAC, fbn('UsrInput'))
  FormatoCeldas(c:FAC..c:FAC,Exe('F2'))
  FormatoCeldas(g:FAC..g:FAC,Exe('F8'))
  SetFont(a:FAC..i:FAC,1)
Proximo

if Val(x1)=0
  SetFilaActual(FAC+2)
  ACT(e:FAC, 'N I L')
  AlinearCeldas(e:FAC,'C')
  SetFont(e:FAC,2)
endif

ACO(1,9)
ACO(2,7)
ACO(3,10)
ACO(4,6)
* 32
ACO(5,6)
* 32
ACO(6,8) 
ACO(7,10)
ACO(8,18)
ACO(9,10)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
act(ar:1,VAR('PATHLOGAUD')~'Log_de_movimientos_operativos_retroactivos_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')

SetFont(a:FAC, 2)

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))
ACT(h:2, 'CONFIDENCIAL')
AlinearCeldas(h:2,'D') 
SetFont(h:2,2)

LimitesVision(i:FAC)
RangoTitulo(a:1..i:FAC, Val(w1)+5)

SetMargins(0.5,0.5,0.5,1.5)
Impresion(1,1)
Impresion(2,1)
Impresion(3,1)
Impresion(4,2)

if Dialogo.Check2=1
   HojaVisible(NO)
   *act(ho:1,Hora(AHORA))
   *act(ho:2,Copy(val(ho:1),1,2)~Copy(val(ho:1),4,2)~Copy(val(ho:1),7,2))
   *   act(ar:1,VAR('PATHLOGAUD')~'Log_de_movimientos_operativos_retroactivos_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')
   BorrarArchivo(val(ar:1))
   ExportarPdf(val(ar:1))
endif
