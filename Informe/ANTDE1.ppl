CrearDialogo
  Fecha1     : "Fecha Vigencia"    ;;;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Fecha2     : "Fecha Desde"       ;;;;;;[Dialogo.Fecha2 = Dialogo.Fecha1] O [Dialogo.Fecha2 = PriDeMes(Dialogo.Fecha2, NO, 'ARG') Y Dialogo.Fecha2 >= Dialogo.Fecha1];'Fecha Desde Invalida';NO;Fsys;
  Fecha3     : "Fecha Hasta"       ;;;;;;[Dialogo.Fecha3 >= Dialogo.Fecha2 Y Dialogo.Fecha3 = FinDeMes(Dialogo.Fecha3, NO, 'ARG')];'Fecha Hasta Invalida';NO;FinDeMes(Fsys, NO, 'ARG');
  Especie1   : "Especie"           ;1;2;;;;;;;;;;;
  Cliente1   : "Entidad"           ;2;2;;;;;;;;;;;
  Radio1     : "Expresado|ARP|USD" ;3;2;;;;;;;1
  Radio2     : "Consolidado|NO|SI" ;4;2;;;;;;;0
  Lista2     : 'Tipo Op.'          ;5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' Order By Codigo ");
  Lista1     : "Vehiculo"          ;-1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACT(LS:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))

***---Expresado en Miles
ACN(IM:2, 1000)

SetFilaActual(2)

ACT(A:fac, 'Deuda Vigente')
ACT(D:fac, '                         FINANCIACION DE IMPORTACIONES')
ACT(I:fac, Dialogo.Fecha1)
SetFont(A:fac..I:fac, 3)
AgregarMarco(A:fac..I:fac, 1, 0, Exe('COLOR'))

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha Desde: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista2)
  ACT(D:FAC, 'Tipo Op.: '~Dialogo.Lista2)
else
  ACT(D:FAC, 'Tipo Op.: Todas')
endif
ifa
ACT(A:fac, 'Fecha Hasta: '~Dialogo.Fecha3)
if NoVacio(Dialogo.Cliente1)
  ACT(D:FAC, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(D:FAC, 'Entidad : Todos')
endif
ifa
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC, 'Especie : '~Dialogo.Especie1~'  '~Copy(BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1), 1, 12))
else
  ACT(a:FAC, 'Especie : Todas')
endif
IF Longitud(Dialogo.Lista1) = Longitud(Val(LS:1000))
    ACT(D:fac, 'Vehiculos: Todos')
ELSE
  ACT(D:FAC, 'Vehiculos : '~Dialogo.Lista1)
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'NO Consolidado')
ELSE
    ACT(A:fac, 'Consolidado')
ENDIF
IF Dialogo.Radio1 = 0
    ACT(D:fac, 'Expresado en Miles de '~Var('MONELOCA'))
ELSE
    ACT(D:fac, 'Expresado en Miles de '~Var('MONEEXTR'))
ENDIF
SetFont(A:fac-3..D:fac, 2)

SetFilaActual(fac+2)

ACT(A:fac, 'Minuta')
ACT(B:fac, 'A#o')
ACT(C:fac, 'Periodo')
ACT(C:fac+1, 'Contable')
ACT(D:fac, 'Banco Op.')
ACT(D:fac+1, 'Financiera')
ACT(E:fac, 'Fecha')
ACT(E:fac+1, 'Inicio')
ACT(F:fac, 'Fecha')
ACT(F:fac+1, 'Vencimiento')
ACT(G:fac, 'Plazo')
ACT(G:fac+1, 'Dias')
ACT(H:fac, 'Cuota')
ACT(H:fac+1, 'Amortizacion')
ACT(I:fac, 'Apertura')
ACT(I:fac+1, 'Cte. y No Cte.')
ifa
AgregarMarco(A:fac-1..I:fac, 1, 0, Exe('COLOR6'))
AlinearCeldas(A:fac-1..I:fac, 'C')
SetFont(A:fac-1..I:fac, 2)

ACN(FI:1, fac+1)
ACN(TI:1, 0)
ACN(TI:2, 0)
ACN(TI:3, 0)
ACN(BD:1, 0)

***---MV:1 se usa para compartir las funciones con informe Caida de Deudas
ACN(MV:1, 0)

(.'CAIDA8A'.)
SQL.ADD(" UNION ")
(.'CAIDA8AS'.)

IF Dialogo.Radio2 = 0
    SQL.ADD(" Order By 1, 18, 11, 5 ")
ELSE
    SQL.ADD(" Order By 18, 11, 5 ")
ENDIF

ACN(CT:1, CotizacionC(Var('MONELOCA'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
ACN(CT:2, CotizacionC(Var('MONEEXTR'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))

Recorrer SQL
    IF Not Eqstr(Val(VH:1), fbn('Clave')) Y Dialogo.Radio2 = 0
        IF Val(BD:1) = 0 Y Not CeldaVacia(VH:1)
            ***---No hubo registros largo plazo
            ACN(I:fac-1, Val(TI:1))
            SetFont(I:fac-1, 1)
        ENDIF
        IF Not CeldaVacia(VH:1)
            ifa
        ENDIF
        ACN(BD:1, 0)
        ACT(A:fac, fbn('Clave'))
        SetFont(A:fac, 2)
        ifa
        ACN(TI:1, 0)
        ACN(TI:2, 0)
    ENDIF
    IF Not Eqstr(Val(CL:1), fbn('Clave'))
        ACT(CL:2, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo', fbn('Cliente1')), 1, 37))
    ENDIF
    IF Dialogo.Radio1 = 0
        ***---Expresado en $
        IF Eqstr(fbn('Especie'), Var('MONELOCA'))
            ACN(IM:1, fbn('Importe')/Val(IM:2))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CT:2))
            ELSE
                ACN(CT:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CT:3))
            ENDIF
        ENDIF
    ELSE
        ***---Expresado en U$S
        IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
            ACN(IM:1, fbn('Importe') / Val(IM:2))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONELOCA'))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CT:1))
            ELSE
                ACN(CT:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CT:3))
            ENDIF
        ENDIF
    ENDIF
    IF fbn('Vto') = Val(VT:fac-1) Y Eqstr(fbn('NrOperacion'), Val(A:fac-1))
        ***---Tiene un Swap o es un Swap con la misma FechaVto, incluye las que tienen FechaFin <>
        ACL(H:fac-1, 'ANTDE2', Fecha1 = Dialogo.Fecha1, Fecha2 = fbn('Inicio'), Fecha3 = Val(F:fac-1), Especie1 = fbn('Especie'), Cliente1 = fbn('Cliente1'), Radio1 = Dialogo.Radio1, Radio2 = Dialogo.Radio2, Lista1 = fbn('Clave'), Lista2 = Val(TP:1))
    ENDIF
    IF fbn('Fin') = Val(F:fac-1) Y Eqstr(fbn('NrOperacion'), Val(A:fac-1))
        ***---Tiene un Swap o es un Swap con la misma FechaVto => lo sumo en la misma celda
        DFA
        ACT(TP:1, BuscarCampo('OPERACIONES','TipoOp','NrOperacion', fbn('NrOperacion')))
        SCN(H:fac, Val(IM:1))
        ACL(H:fac, 'ANTDE2', Fecha1 = Dialogo.Fecha1, Fecha2 = fbn('Inicio'), Fecha3 = fbn('Fin'), Especie1 = fbn('Especie'), Cliente1 = fbn('Cliente1'), Radio1 = Dialogo.Radio1, Radio2 = Dialogo.Radio2, Lista1 = fbn('Clave'), Lista2 = Val(TP:1))
        IF Val(F:fac) - Dialogo.Fecha1 <= 365
            SCN(TI:1, Val(IM:1))
            SCN(TI:2, Val(IM:1))
            SCN(TI:3, Val(IM:1))
        ELSE
            SCN(BD:1, 1)
            SCN(TI:2, Val(IM:1))
            SCN(TI:3, Val(IM:1))
        ENDIF
    ELSE
        ACT(VH:1, fbn('Clave'))
        ACT(CL:1, fbn('Cliente1'))
        ACT(A:fac, fbn('NrOperacion'))
        ACLO(A:fac, fbn('NrOperacion'))
        ACN(B:fac, Anio(fbn('FechaOp2')))
        ACT(C:fac, Pad0(Fstr(Dia(fbn('FechaOp2')), 0, 0), 2)~'-'~Copy(Meses(Mes(fbn('FechaOp2'))), 1, 3))
        ACT(D:fac, Val(CL:2))
        IF Incluido(fbn('Tipo'), 'CUO|SWAP')
            ACD(E:fac, fbn('Inicio'))
        ELSE
            ACD(E:fac, fbn('FechaOp2'))
        ENDIF
        ACD(F:fac, fbn('Fin'))
        ACN(G:fac, Val(F:fac)-Val(E:fac))
        ACN(H:fac, Val(IM:1))    
        IF Val(F:fac) - Dialogo.Fecha1 <= 365
            SCN(TI:1, Val(IM:1))
            SCN(TI:2, Val(IM:1))
            SCN(TI:3, Val(IM:1))
        ELSE
            SCN(BD:1, 1)
            SCN(TI:2, Val(IM:1))
            SCN(TI:3, Val(IM:1))
        ENDIF
        IF Val(BD:1) = 1
            ***---Primer registro largo plazo
            ACN(I:fac-1, Val(TI:1))
            SetFont(I:fac-1, 1)
        ENDIF
    ENDIF
    SetFont(A:fac..I:fac, 1)
    ACD(VT:fac, fbn('Vto'))
Proximo
IF Val(BD:1) = 0
    ***---No hubo registros largo plazo
    ACN(I:fac, Val(TI:1))
ENDIF
IF Val(BD:1) > 0
    ***---Hubo registros largo plazo
    ACN(I:fac, Val(TI:2))
ENDIF
SetFont(I:fac, 1)
FormatoCeldas(B:Val(FI:1)..B:fac, Exe('F0'))
FormatoCeldas(G:Val(FI:1)..G:fac, Exe('F0'))
AgregarMarco(A:Val(FI:1)..I:fac, 0, 0)
ifa
ACT(A:fac, 'Total General')
ACN(I:fac, Val(TI:3))
AgregarMarco(A:fac..I:fac, 0, 0, Exe('COLOR6'))
SetFont(A:fac..I:fac, 2)

SetPrintFit(3, 95)
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
LimitesVision(J:fac+1)

*
*    Esto es lo que agrega Silvia
*
RangoTitulo(a:1..J:fac+1, 8)

ACO(2, 5)
ACO(4, 20)
ACO(6, 8)
ACO(7, 5)
ACO(8, 9)
ACO(9, 9)