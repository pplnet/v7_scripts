CrearDialogo
   Fecha1    : 'Fecha Vigencia'                         ;1;1;;;;Dialogo.Fecha1>0;'Debe ingresaruna fecha valida';NO;FSYS
   Lista1    : 'Vehiculo'                               ; ; ;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Radio1    : 'Consolidado|NO|SI'                      ; ; ;;;;;;;0;
   Precio1   : 'Cot.USD/ARP'                            ; ; ;;;;Dialogo.Precio1>0;'La cotizacion del USD contra el peso debe ser mayor a cero';NO;0;
   Radio2    : 'Plazo|Corto|Largo|Corto+Largo|Variacion'; ; ;;NO;NO;;;;2;
   Check1    : 'Graba'                                  ; ; ;;  ;  ;;;;0;
   Check2    : 'Hoja Visible|NO|SI'                     ; ; ;;  ;  ;;;;0; 
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-- Encabezado Gral
SetFilaActual(2)
ACT(a:FAC, 'Resumen Op.Financieras: '~IIF(Dialogo.Radio2=0, 'Corto Plazo',IIF(Dialogo.Radio2=1,'Largo Plazo',IIF(Dialogo.Radio2=2,'Corto+Largo Plazo','Variacion'))) )
SetFont(a:FAC..a:FAC, 3)
IFA
IFA
ACT(a:FAC, 'Fecha: '~Dialogo.Fecha1)
IFA
ACT(a:FAC, 'Vehiculos: '~IIF(Vacio(Dialogo.Lista1), 'Todos', Dialogo.Lista1))
IFA
ACT(a:FAC, 'Consolidado: '~IIF(Dialogo.Radio1=0, 'NO', 'SI'))
IFA
ACT(a:FAC, 'Cotizacion: '~Dialogo.Precio1)
SetFont(a4..a:FAC, 2)
IFA
IFA

ACN(fi1, FAC)

*-- Para calcular el corto/ Largo Plazo
ACN(ea1, Dialogo.Fecha1+365)

*(.'FILASINF1'.)
*(.'DEPOSPLAZO'.)
*(.'OVERTIME'.)
*(.'COLOCEXTRA'.)
*(.'COLTOMVIN'.)
*(.'FONDOSCOMU'.)
*(.'CTASCTESR'.)
*(.'CAJAAHORRO'.)
*(.'OPSTERMINO'.)
*(.'TITULOS1'.)
*(.'PRESTAMOST'.)
(.'OBLIGANEG'.)
*(.'CARTERATIT'.)
*(.'DINEROTRAN'.)

*- fin de las filas de Activos y Pasivos respect.
ACN(fa1, Val(fi4)-1)
ACN(fa2, Val(fi8)-1)

**-- Calculo de los tolales generales de Tasa Premedio y Plazo Promedio
**-- Activa
Recorrer&i Val(fi2), Val(fa1)
   SCN(aa1, Val(b:&i)*Val(e:&i))
   SCN(aa2, Val(b:&i)*Val(f:&i))
   SCN(aa3, Val(g:&i)*Val(j:&i))
   SCN(aa4, Val(g:&i)*Val(k:&i))
Proximo
ACN(e:Val(fi4), Val(aa1)/Val(b:Val(fi4)) )
ACN(f:Val(fi4), Val(aa2)/Val(b:Val(fi4)) )
ACN(j:Val(fi4), Val(aa3)/Val(g:Val(fi4)) )
ACN(k:Val(fi4), Val(aa4)/Val(g:Val(fi4)) )

**-- Pasivo
ACN(aa1, 0)
ACN(aa2, 0)
ACN(aa3, 0)
ACN(aa4, 0)

Recorrer&i Val(fi6), Val(fa2)
   SCN(aa1, Val(b:&i)*Val(e:&i))
   SCN(aa2, Val(b:&i)*Val(f:&i))
   SCN(aa3, Val(g:&i)*Val(j:&i))
   SCN(aa4, Val(g:&i)*Val(k:&i))
Proximo
ACN(e:Val(fi8), Val(aa1)/Val(b:Val(fi8)) )
ACN(f:Val(fi8), Val(aa2)/Val(b:Val(fi8)) )
ACN(j:Val(fi8), Val(aa3)/Val(g:Val(fi8)) )
ACN(k:Val(fi8), Val(aa4)/Val(g:Val(fi8)) )

**-- Calculo de la Posicion Neta
**-- En Pesos
ACN(b:Val(fi9), Val(b:Val(fi4))-Val(b:Val(fi8)))
ACN(c:Val(fi9), Val(c:Val(fi4))-Val(c:Val(fi8)))
ACN(d:Val(fi9), Val(d:Val(fi4))-Val(d:Val(fi8)))
ACN(g:Val(fi9), Val(g:Val(fi4))-Val(g:Val(fi8))) 
ACN(h:Val(fi9), Val(h:Val(fi4))-Val(h:Val(fi8)))
ACN(i:Val(fi9), Val(i:Val(fi4))-Val(i:Val(fi8)))

ACN(l:Val(fi9), Val(l:Val(fi4))-Val(l:Val(fi8)))
ACN(m:Val(fi9), Val(m:Val(fi4))-Val(m:Val(fi8)))
ACN(o:Val(fi9), Val(o:Val(fi4))-Val(o:Val(fi8)))
ACN(p:Val(fi9), Val(p:Val(fi4))-Val(p:Val(fi8)))
ACN(q:Val(fi9), Val(q:Val(fi4))-Val(q:Val(fi8)))
**-----------------------------------------------**

If [Dialogo.Check1=1 y Dialogo.Radio2=2]
   ACT(ga1,Dialogo.Lista1)
   ACT(ga2, IIF(Dialogo.Radio2=0, 'Corto Plazo',IIF(Dialogo.Radio2=1,'Largo Plazo','Corto+Largo Plazo')) )
   ACT(ga3, IIF(Dialogo.Radio1=0, 'NO Consolidado', 'Consolidado'))
   ACT(ga1, val(ga1)~'/'~Dialogo.Fecha1~'/'~Val(ga2)~'/'~Val(ga3))
   GrabarPMG('OPFIAU', val(ga1))
Endif

SetFont(b:Val(fi4)..q:Val(fi4), 2)
SetFont(b:Val(fi8)..q:Val(fi8), 2)
SetFont(b:Val(fi12)..q:Val(fi12), 2)
SetFont(b:Val(fi16)..q:Val(fi16), 2)
SetFont(b:Val(fi9)..q:Val(fi9), 2)
SetFont(b:Val(fi17)..q:Val(fi17), 2)

RangoTitulo(a1..q:fac, 8)
FijarFila(11)
FijarCol(2)
LimitesVision(r:FAC+3)
Impresion(1,2)
SetPrintFit(3,52)







