CrearDialogo
    Radio1    : 'Filtra por|Fecha|Cuenta' ;;;;;;NoVacio(Dialogo.Radio1);'Debe seleccionar un filtro';NO;0;
    Fecha1    : 'Fecha Desde'             ;3;;;;Dialogo.Radio1=1;NoVacio(Dialogo.Fecha1) o Dialogo.Radio1=0;'Debe agregar una fecha desde';NO;FSYS-365;
    Fecha2    : 'Fecha Hasta'             ;4;;;;Dialogo.Radio1=1;[NoVacio(Dialogo.Fecha2) o Dialogo.Radio1=0] y Dialogo.Fecha2>Dialogo.Fecha1;'Debe agregar una fecha hasta, mayor a fecha desde';NO;FSYS;
    Fecha3    : 'Fecha'                   ;3;;;;Dialogo.Radio1=0;NoVacio(Dialogo.Fecha3) o Dialogo.Radio1=1;'Debe indicar una fecha';NO;FSYS;
    Vehiculo1 : 'Vehiculo'                ;5;;;;;;;;;;;;;
    Cuenta1   : 'Cuenta'                  ;6;;;;Dialogo.Radio1=1;NoVacio(Dialogo.Cuenta1) o Dialogo.Radio1=0;'Debe seleccionar una cuenta';NO;;;;;;IIF(NoVacio(Dialogo.Vehiculo1),"Cliente='"~Dialogo.Vehiculo1~"' and Estado='HAB'","Estado='HAB'")
    Cliente1  : 'Banco'                   ;6;;;;Dialogo.Radio1=0;;;;;;
    Especie1  : 'Moneda'                  ;;;;;Dialogo.Radio1=0;;;;;;;;;"Tipo='MON'"
FinDialogo

IF Not OK
  Cancelar
ENDIF

let &filaLogo 1
@LOGO

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(C:1,'Consulta de Saldos Comitente')
SetFont(C:1..C:1,3)
SetFilaActual(6)
**
let &Header fac


**************************************************************HEADER*****************************************
IF Dialogo.Radio1=1
    ACO(1,10)
    ACO(2,10)
    ACT(A:fac,'Fecha Desde:  ' ~ Dialogo.Fecha1)
    ifa
    ACT(A:fac,'Fecha Hasta:  ' ~ Dialogo.Fecha2)
    ifa
    ACT(A:fac,'Cuenta:  ' ~ Dialogo.Cuenta1)
ELSE
    ACO(1,15)
    ACO(2,15)
    ACO(4,10)
    ACT(A:fac,'Fecha:  ' ~ Dialogo.Fecha3)
    ifa
    IF NoVacio(Dialogo.Vehiculo1)
        let &Vh Dialogo.Vehiculo1
    ELSE
        let &Vh 'Todos'
    ENDIF
    ACT(A:fac,'Vehiculo:  ' ~ &Vh)
    ifa
    IF NoVacio(Dialogo.Cliente1)
        let &Cli Dialogo.Cliente1
    ELSE
        let &Cli 'Todos'
    ENDIF
    ACT(A:fac,'Banco:  ' ~ &Cli)
    ifa
    IF NoVacio(Dialogo.Especie1)
        let &Mon Dialogo.Especie1
    ELSE
        let &Mon 'Todas'
    ENDIF
    ACT(A:fac,'Moneda:  ' ~ &Mon)
ENDIF
SetFont(A:&Header..A:fac,2)
ifa
ifa
IF Dialogo.Radio1=1
    ACT(A:fac,'Fecha')
    ACT(B:fac,'Saldo')
    let &ColTit 2
ELSE
    ACT(A:fac,'Banco')
    ACT(B:fac,'Cuenta')
    ACT(C:fac,'Moneda')
    ACT(D:fac,'Saldo')
    let &ColTit 4
ENDIF
SetFont(A:fac..&ColTit:fac,2)
AgregarMarco(A:fac..&ColTit:fac,1,0,EXE('COLOR'))
*****************************************************************SQL************************************
SQL.ADD("Select Fecha,Saldo,Cliente,EnteCustodia")
IF Dialogo.Radio1=0
    SQL.ADD(",Especie,Cuenta")
ENDIF
SQL.ADD("FROM "~DBO~".SALDOSDIA Where")
IF Dialogo.Radio1=1
    SQL.ADD(" Cuenta = '"~Dialogo.Cuenta1~"'")
    SQL.ADD("and Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and Fecha<='"~IdxDate(Dialogo.Fecha2)~"'")
ELSE
    SQL.ADD(" Fecha = '"~IdxDate(Dialogo.Fecha3)~"'")
    IF NoVacio(Dialogo.Especie1)
        SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
    ENDIF
    IF NoVacio(Dialogo.Cliente1)
        SQL.ADD(" and Cliente = '"~Dialogo.Cliente1~"'")
    ENDIF
    IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" and EnteCustodia = '"~Dialogo.Vehiculo1~"'")
    ENDIF
ENDIF
SQL.ADD("and NrSaldo = '50'")
IF Dialogo.Radio1=1
    SQL.ADD("Order By Fecha")
ELSE
    SQL.ADD("Order By EnteCustodia,Cliente")
ENDIF

let &comienzoDatos fac
Recorrer SQL
    IF Dialogo.Radio1=1
        ACD(A:fac,FBN['Fecha'])
        ACN(B:fac,FBN['Saldo'])
        **Link a Detalle
        ACL(B:fac,'DETSAC',Fecha1=Dialogo.Fecha2,Cuenta1=Dialogo.Cuenta1,Vehiculo1=FBN['EnteCustodia'],Cliente1=FBN['Cliente'])
        let &Total &Total + FBN['Saldo']
    ELSE
        IF Not EqStr(FBN['Cliente'],&Banco) y NoVacio(&Banco)
               ACT(A:fac,'Total banco '~&Banco)
               ACN(D:fac,&TotalBanco)
               SetFont(A:fac..D:fac,2)
               AgregarMarco(A:fac..D:fac,1,0,EXE('COLOR6'))
               ifa
               ifa
               let &TotalBanco 0
        ENDIF
        IF Vacio(Dialogo.Vehiculo1) y Not EqStr(FBN['EnteCustodia'],&Vehiculo)
                IF NoVacio(&Vehiculo)
                    ACT(A:fac,'Total vehiculo '~&Vehiculo)
                    ACN(D:fac,&TotalVh)
                    SetFont(A:fac..D:fac,2)
                    AgregarMarco(A:fac..D:fac,1,0,EXE('COLOR6'))
                    ifa
                    ifa
                    let &TotalVh 0
                ENDIF
                ACT(A:fac,'Vehiculo '~FBN['EnteCustodia'])
                SetFont(A:fac..A:fac,2)
                ifa
        ENDIF
        If  Not Eqstr(fbn('Cliente'), &Banco) o Not Eqstr(fbn('EnteCustodia'), &Vehiculo)
            ACT(A:fac,'Banco '~FBN['Cliente'])
            SetFont(A:fac..A:fac,2)
        ENDIF
        ACT(B:fac,FBN['Cuenta'])
        ACT(C:fac,FBN['Especie'])
        ACN(D:fac,FBN['Saldo'])
        **Link a Detalle incompleto
        let &Vehiculo FBN['EnteCustodia']
        let &Banco FBN['Cliente']
        ACL(D:fac,'DETSAC',Fecha1=Dialogo.Fecha3,Cuenta1=Val(B:fac),Vehiculo1=&Vehiculo,Cliente1=&Banco)
        let &TotalVh &TotalVh + FBN['Saldo']
        let &TotalBanco &TotalBanco + FBN['Saldo']
    ENDIF
Proximo
IF Dialogo.Radio1=1
    ifa
    ACT(A:fac,'Total')
    ACN(B:fac,&Total)
    SetFont(A:fac..B:fac,2)
    AgregarMarco(A:fac..B:fac,1,0,EXE('COLOR6'))
    ifa
    ifa
ENDIF
IF NoVacio(&Banco)
    ifa
    ACT(A:fac,'Total banco '~&Banco)
    ACN(D:fac,&TotalBanco)
    SetFont(A:fac..D:fac,2)
    AgregarMarco(A:fac..D:fac,1,0,EXE('COLOR6'))
    ifa
    ifa
ENDIF
IF Vacio(Dialogo.Vehiculo1)
    IF NoVacio(&Vehiculo)
        ifa
        ACT(A:fac,'Total vehiculo '~&Vehiculo)
        ACN(D:fac,&TotalVh)
        SetFont(A:fac..D:fac,2)
        AgregarMarco(A:fac..D:fac,1,0,EXE('COLOR6'))
        let &finDatos fac
        ifa
        ifa
    ENDIF
ENDIF
********************************************************************************************************************
let &finDatos fac

IF &comienzoDatos = &finDatos
    Cancelar('No hay saldos para los datos seleccionados')
ENDIF
ACT(A:fac,'Fin del Reporte')
SetFont(A:fac..A:fac,2)
ifa
LimitesVision(F:fac)

