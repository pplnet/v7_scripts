ModoReproceso(SinDialogo)
HojaVisible(NO)
CrearDialogo
   Fecha1  : 'Desde'          ;1;1;;;;Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI);'La Fecha Desde debe ser un Principio de Mes';NO;;PriDeMes(Fecha('01/01/'~FStr(Anio(Fsys),4,0)),SI)
   Fecha2  : 'Hasta'          ;2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;PriDeMes(FSYS-1, SI)
   Especie1: 'Moneda'         ;;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Radio3  : 'Origen|Todos|Activo|Pasivo' ;;;;;;;;;0;
   Radio6  : 'Clientes|Todos|Vinculados|Terceros';;;;;;;;;0;
   Lista1  : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

If Dialogo.Radio3<>2 y Dialogo.Radio6<>2
   * Llamada Para Vinculados y Activos
   LinkearHoja('COREE5',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=Dialogo.Especie1,Radio3=1,Radio6=1,Lista1=Dialogo.Lista1)
EndIf

If Dialogo.Radio3<>1 y Dialogo.Radio6<>2
   * Llamada Para Vinculados y Pasivos
   LinkearHoja('COREE5',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=Dialogo.Especie1,Radio3=2,Radio6=1,Lista1=Dialogo.Lista1)
EndIf

If Dialogo.Radio3<>2 y Dialogo.Radio6<>1
   * Llamada Para Terceros y Activos
   LinkearHoja('COREE5',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=Dialogo.Especie1,Radio3=1,Radio6=2,Lista1=Dialogo.Lista1)
EndIf

If Dialogo.Radio3<>1 y Dialogo.Radio6<>1
   * Llamada Para Terceros y Pasivos
   LinkearHoja('COREE5',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=Dialogo.Especie1,Radio3=2,Radio6=2,Lista1=Dialogo.Lista1)
EndIf
