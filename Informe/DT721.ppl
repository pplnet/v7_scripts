ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
 Fecha1:  'F.Bajada'    ; 1;1;;;;Dialogo.Fecha1<=FSYS ;'Fecha Incorrecta';NO;FSys
 Lista1:  'Vehiculos'   ; 2;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista2:  'CtasMadres'  ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Codigo IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS)  "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" ");
 Lista3  : 'CtasPag/Rec/Int';-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE (Pagadora='SI' OR TipoCuenta IN ('REC','INT') ) "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~")") )~" "~IIF(NOVACIO(Dialogo.Lista2), " AND CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")")~" ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")


ACT(a:1, 'F.Bajada: '~Dialogo.Fecha1)
ACT(a:2, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:3, 'Cuentas Principales: '~iif(vacio(Dialogo.Lista2),'Todas',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:4, 'Cuentas Recaudadoras/Pagadoras: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))

ACT(c:6, 'Conciliaciones entre Extractos')
SetFont(a:1..a:5,2)
SetFont(c:6,3)

SetFilaACtual(7)

SQL.ADD(" SELECT M.NrDatanet, M.NrMovDatanet, D.FechaBajada, D.Archivo, M.FechaAcreditacion, ")
SQL.ADD(" M.FechaIngreso, M.TipoMov, M.Importe, M.Vehiculo, M.Cuenta, M.DC, C.Codigo, C.Numero, ")
SQL.ADD(" MH.NrDatanet NrDatanetH, MH.NrMovDatanet NrMovDatanetH, MH.FechaAcreditacion FechaAcreditacionH, ")
SQL.ADD(" MH.FechaIngreso FechaIngresoH, MH.TipoMov TipoMovH, MH.Importe ImporteH, MH.Cuenta CuentaH, ")
SQL.ADD(" MH.DC DCH, EX.Fecha, EX.Operador, DH.FechaBajada FechaBajadaH, DH.Archivo ArchivoH,  ")
SQL.ADD(" CD.Tipo, CD.Descripcion, CD.Tipo TipoH, CD.Descripcion DescripcionH, TD.Descripcion DescripcionTD, TDH.Descripcion DescripcionTDH ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".CUENTAS C, "~DBO~".EXTRACTOS EX, ")
SQL.ADD(" "~DBO~".MOVDATANET MH, "~DBO~".DATANET DH, "~DBO~".CUENTAS CH, "~DBO~".CODIGOSDATANET CD, ")
SQL.ADD(" "~DBO~".CODIGOSDATANET CDH, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".TIPOSCODIGODATANET TDH ")
SQL.ADD(" WHERE M.NrDatanet     =  D.NrDatanet ")
SQL.ADD(" AND   M.Cuenta        =  C.Numero    ")
SQL.ADD(" AND   M.NrDatanet     =  EX.MNrDatanet     ")
SQL.ADD(" AND   M.NrMovDatanet  =  EX.MNrMovDatanet  ")
SQL.ADD(" AND   M.TipoMov       *=  CD.Codigo      ")
SQL.ADD(" AND   CD.Tipo         *=  TD.Codigo      ")
SQL.ADD(" AND   EX.HNrDatanet   =  MH.NrDatanet      ")
SQL.ADD(" AND   EX.HNrMovDatanet=  MH.NrMovDatanet   ")
SQL.ADD(" AND   EX.HNrDatanet   =  DH.NrDatanet      ")
SQL.ADD(" AND   MH.Cuenta       =  CH.Numero         ")
SQL.ADD(" AND   MH.TipoMov      *=  CDH.Codigo    ")
SQL.ADD(" AND   CDH.Tipo        *=  TDH.Codigo    ")
SQL.ADD(" AND   D.FechaBajada   =  "~Idxdate2(Dialogo.Fecha1)~" ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVAcio(Dialogo.Lista2)
  SQL.ADD(" AND C.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
  SQL.ADD(" AND CH.CtaPrincipal IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Else
  SQL.ADD(" AND C.Codigo  IN (SELECT CtaPrincipal FROM "~DBO~".CUENTAS) ")
Endif
If NoVAcio(Dialogo.Lista3)
  SQL.ADD(" AND CH.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista3)~")    ")
Else
  SQL.ADD(" AND (CH.TipoCuenta IN ('INT','REC') OR CH.Pagadora='SI') ")
Endif
SQL.ADD(" ORDER By M.Vehiculo, C.Codigo, M.NrDatanet, M.NrMovDatanet ")


ACT(va:1,'')
ACT(ca:1,'')

Recorrer SQL
  If Not Eqstr(fbn('Vehiculo'),Val(va:1))
    MESSAGE('Vehiculo: '~fbn('Vehiculo'))
    ACT(a:fac, 'Vehiculo: '~fbn('Vehiculo'))
    SetFont(a:fac,3)
    ACT(ca:1,'')
  Endif

  If Not Eqstr(fbn('Codigo'),Val(ca:1))
    ifa
    MESSAGE('Cuenta: '~fbn('Codigo')~' - Nro: '~fbn('Numero')~' // Cta.Datanet: '~fbn('Cuenta'))
    ACT(a:fac, 'Cuenta: '~fbn('Codigo')~' - Nro: '~fbn('Numero')~' // Cta.Datanet: '~fbn('Cuenta'))
    SetFont(a:fac,5)
    AgregarMarco(a:fac..u:fac,1,0,RGB(162,222,251))
    ifa
    ACT(a:fac,   'Extracto')
    ACT(b:fac,   'NrMov')
    ACT(c:fac,   'Fecha')
    ACT(c:fac+1, 'Bajada')
    ACT(d:fac,   'Archivo')
    ACT(e:fac,   'Codigo')
    ACT(e:fac+1, 'Datanet')
    ACT(f:fac,   'Tipo')
    ACT(g:fac,   'Importe')
    ACT(h:fac,   'Fecha')
    ACT(h:fac+1, 'Valor')
    ACT(i:fac,   'Fecha')
    ACT(i:fac+1, 'Proceso')

    ACT(j:fac,   'Cuenta')
    ACT(k:fac,   'Extracto')
    ACT(l:fac,   'NrMov')
    ACT(m:fac,   'Fecha')
    ACT(m:fac+1, 'Bajada')
    ACT(n:fac,   'Archivo')
    ACT(o:fac,   'Codigo')
    ACT(o:fac+1, 'Datanet')
    ACT(p:fac,   'Tipo')
    ACT(q:fac,   'Importe')
    ACT(r:fac,   'Fecha')
    ACT(r:fac+1, 'Valor')
    ACT(s:fac,   'Fecha')
    ACT(s:fac+1, 'Proceso')
    ACT(t:fac,   'Fecha')
    ACT(t:fac+1, 'Conciliacion')
    ACT(u:fac,   'Operador')

    AgregarMarco(a:fac..i:fac+1,1,0,RGB(199,207,207))
    AgregarMarco(j:fac..u:fac+1,1,0,RGB(199,207,207))
    AlinearCeldas(a:fac..u:fac+1,'C')
    SetFont(a:fac..z:fac+1, 2)
    ifa
    ifa
  Endif

  ACT(a:fac,  fbn('NrDatanet'))
  ACN(b:fac,  fbn('NrMovDatanet'))
  ACD(c:fac,  fbn('FechaBajada'))
  ACT(d:fac,  fbn('Archivo'))
  If NoVacio(fbn('TipoMov'))
    ACT(e:fac,  fbn('TipoMov')~'-'~fbn('Descripcion'))
    ACT(f:fac,  fbn('Tipo')~'-'~fbn('DescripcionTD'))
  Endif
  ACN(g:fac,  fbn('Importe')*IIF(Eqstr(fbn('DC'),'D'),-1,1))
  ACD(h:fac,  fbn('FechaAcreditacion'))
  ACD(i:fac,  fbn('FechaIngreso'))

  If NoVacio(fbn('NrDatanetH'))
    ACT(j:fac,   fbn('CuentaH'))
    ACT(k:fac,   fbn('NrDatanetH'))
    ACN(l:fac,   fbn('NrMovDatanetH'))
    ACD(m:fac,   fbn('FechaBajadaH'))
    ACT(n:fac,   fbn('ArchivoH'))
    ACT(o:fac,   fbn('TipoMovH')~'-'~fbn('DescripcionH'))
    ACT(p:fac,   fbn('TipoH')~'-'~fbn('DescripcionTDH'))
    ACN(q:fac,   fbn('Importe')*IIF(Eqstr(fbn('DCH'),'D'),-1,1))
    ACD(r:fac,   fbn('FechaAcreditacion'))
    ACD(s:fac,   fbn('FechaIngreso'))
    ACD(t:fac,   fbn('Fecha'))
    ACT(u:fac,   fbn('Operador'))
  Endif

  FormatoCeldas(b:fac, EXE('F0'))
  FormatoCeldas(l:fac, EXE('F0'))
  FormatoCeldas(g:fac, EXE('F2'))
  FormatoCeldas(q:fac, EXE('F2'))
  SetFont(a:fac..z:fac, 1)
  ACT(va:1,fbn('Vehiculo'))
  ACT(ca:1,fbn('Codigo'))
Proximo

