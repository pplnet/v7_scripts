ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1:'Vehiculo' ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1   :'F.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30
  Fecha2   :'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Radio3   :"Minutas|Todas|Reales|Simuladas";;NO;;;;;;;0
  Radio2   :"Grafico|Barra|Torta|Linea|Dona|Sin Grafico";;SI;;;;;;;4
  NrOperacion1 : 'Operacion'
FinDialogo
if Not OK
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   ELSE
      ACT(z:1,Dialogo.Vehiculo1)
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(z:1, SQLSET(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   ELSE
      ACT(Z:1, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)


SetFilaActual(3)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:fac,      'Estado de Operaciones')

if NoVacio(Dialogo.NrOperacion1)
   ACT(g:fac+1, 'Nr.Operacion: '~Dialogo.NrOperacion1)
   SetFont(a:fac..g:fac+1,3)
   SetFilaActual(fac+3)
else
   If Dialogo.Radio3=0
      ACT(a:fac, val(a:fac)~' Reales y Simuladas')
   EndIf
   If Dialogo.Radio3=1
      ACT(a:fac, val(a:fac)~' Reales ')
   EndIf
   If Dialogo.Radio3=2
      ACT(a:fac, val(a:fac)~' Simuladas ')
   EndIf

   SetFont(a:fac..a:fac+1,3)
   SetFilaActual(fac+2)
   ACN(w1,fac)
   if NoVacio(Dialogo.Vehiculo1)
      ACT(a:fac+1, 'Vehiculo: '~Dialogo.Vehiculo1)
   else
      ACT(a:fac+1, 'Vehiculo: Todos')
   endif
   ACT(g:fac+1, 'Nr.Operacion: Todas')

   ACT(a:fac+2, 'F.Desde: '~Dialogo.Fecha1)
   ACT(a:fac+3, 'F.Hasta: '~Dialogo.Fecha2)
   SetFilaActual(fac+5)
endif

ACT(a:fac, 'Instancia')
ACT(b:fac, 'Numero')
ACT(c:fac, 'Fecha Op.')
ACT(d:fac, 'Fecha Vto.')
ACT(e:fac, 'Especie')
ACT(f:fac, 'Tipo Op.')
ACT(g:fac, 'Cliente')
ACT(h:fac, 'Cantidad')
ACT(i:fac, 'Precio/Tasa')
ACT(j:fac, 'Total')
ACT(k:fac, 'Vehiculo')
ACT(l:fac, 'Operador')
AlinearCeldas(a:fac..g:fac,'I')
AlinearCeldas(h:fac..i:fac,'D')
AlinearCeldas(k:fac..n:fac,'I')
SetFont(a:5..n:fac,2)
AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR'))

If Dialogo.Radio3<>2 o NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("Select OB.NrBit, TipoOp, O.NrOperacion, FechaOp, FechaVto, Especie, FechaEj, PrecioEj, PaseCB, Cliente1, Cantidad, Precio1, Vehiculo1, Operador, Arbitraje, CB5, 'REAL' as Tipo, TotalAux3, Cantidad, TotalNetoCli1, TotalBrutoCli1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB where O.NrOperacion=OB.NrOperacion AND OB.Valor='1' and ")
   If NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" O.NrOperacion='"~Dialogo.NrOperacion1~"'")
   Else 
      SQL.ADD("FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
   Endif
   if NoVacio(Dialogo.Vehiculo1)
     SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   ELSE
     SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(Z:1))~") ")
   endif
EndIf
If Dialogo.Radio3=0 o NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" Union All ")
EndIf
If Dialogo.Radio3<>1 o NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("Select 1 as NrBit,TipoOp, NrOperacion, FechaOp, FechaVto, Especie, FechaEj, PrecioEj, PaseCB, Cliente1, Cantidad, Precio1, Vehiculo1, Operador, Arbitraje, CB5,'EVEN' as Tipo, TotalAux3 , Cantidad, TotalNetoCli1, TotalBrutoCli1  ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES O where ")
   If NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"'")
   Else 
      SQL.ADD("FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
   Endif
   if NoVacio(Dialogo.Vehiculo1)
     SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   ELSE
     SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(Z:1))~") ")
   endif
EndIf
SQL.ADD("order by O.NrOperacion")

ACT(ss1,'Titulos')
ACT(ss2,'ON ' )
ACT(ss3,'Acciones ' )
ACT(ss4,'MM')
ACT(ss5,'FX')
ACN(qq1,0)
ACN(qq2,0)
ACN(qq3,0)
ACN(qq4,0)
ACN(qq5,0)
recorrer SQL

  SCN(z:2,1)
  ACT(z:3, ' ')
  ACT(z:3, FBN['NrBit'])
  act(a:fac, ' ')

  If EqStr(FBN['Tipo'],'REAL')
     ColorCeldas(a:fac,clBLUE)
     ACT(a:fac, SQL("Select Nombre From "~DBO~".INSTANCIAS where NrInstancia="~val(z3)~" and Tabla='OPERACIONES' "))
  Else 
     ACT(a:fac, 'Operacion EVENTUAL')
     ColorCeldas(a:fac, RGB(128,128,0))    
  EndIf

  ACT(b:fac, fbn('NrOperacion'))
  ACT(c:fac, fbn('FechaOp'))
  ACT(d:fac, fbn('FechaVto'))
  if Incluido(Copy(fbn('TipoOp'),1,2), 'DT|DP')
    ACT(d:fac, fbn('FechaEj'))
  endif
  if Incluido(fbn('TipoOp'), 'DSEO|DFXO')
    ACT(d:fac, fbn('FechaEj'))
  endif
  ACT(e:fac, fbn('Especie'))
  ACT(f:fac, fbn('TipoOp'))
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('PaseCB')=1
    ACT(f:fac, Val(f:fac)~' x Pase')
    
  endif
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('CB5')=1
    ACT(f:fac, Val(f:fac)~' (Of.)')
     
  endif
 
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(f:fac, Val(f:fac)~' x Pase')
  
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(f:fac, Val(f:fac)~' x Arb.')
  
  endif
  
  *** Que tipo de Op es para el grafico
    if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') 
      SCN(qq1,1)
   endif   
   If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'FX') 
       SCN(qq5,1)
   endif
   If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'MM')
       SCN(qq4,1)
   endif
  
  ACT(g:fac, fbn('Cliente1'))
  ACN(h:fac, fbn('Cantidad'))
  if Incluido(fbn('TipoOp'), 'DTSFVM|DTSVVM|DTSFFM|DTCAP|DTFLO|')
     ACN(h:fac, fbn('TotalAux3'))
       SCN(qq2,1)
  EndIf

  ******Totales

  IF Incluido(FBN['TipoOp'], 'TRANSF')
     ACN(j:FAC, FBN['Cantidad'])
  Else
     IF Incluido(FBN['TipoOp'], 'FCS|FCR')
        ACN(j:FAC, FBN['TotalNetoCli1'])
          SCN(qq2,1)
     Else
        If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'MM')
           ACN(j:FAC, FBN['Cantidad'])
             
        Else
           ACN(j:FAC, FBN['TotalBrutoCli1'])
         
        EndIf
     EndIf
  EndIf

*****

  ACN(i:fac, fbn('Precio1'))
  ACT(k:fac, fbn('Vehiculo1'))
  ACT(l:fac, fbn('Operador'))
  AlinearCeldas(c:fac..d:fac,'D')
  FormatoCeldas(i:fac..i:fac,Exe('F7'))

  If EqStr(FBN['Tipo'],'REAL')
     * link con consulta de operaciones
     ACLO(b:fac,Val(b:fac))
  Else 
     ACLV(b:fac,Val(b:fac))
  EndIf
proximo

SetFont(a:Val(w1)+6..n:fac,1)

ACO(1,14)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,8)
ACO(6,10)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,6)
ACO(11,6)
ACO(12,8)
ACO(13,20)
ACO(14,8)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:fac, 2)

RangoTitulo(a:1..l:fac, 10)

ACT(a5, 'Cantidad de Operaciones : '~FStr(Val(z2), 4, 0))
SetFont(a4..a5,2)
