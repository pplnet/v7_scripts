* INTCOR - Calculo Interese Corridos
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'  ; ; ; ;  ;  ;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;FSys
  Especie1 : 'Especie'; ; ; ;  ;  ;;;;
  Check1   : 'Procesa'; ; ; ;NO;  ;;;;0;
FinDialogo
If Not Ok
   Cancelar
Endif

if Dialogo.Check1=0 o SI
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:FAC, 'Fecha:')
ACT(b:FAC, Dialogo.Fecha1)
SetFont(a:FAC..b:FAC,3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'PrecioEj')
ACT(c:FAC, 'FechaEj')
ACT(d:FAC, 'Cupon')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Trader')
ACT(i:FAC, 'TipoNego')
ACT(j:FAC, 'NrSaldo')
ACT(k:FAC, 'Fecha')
ACT(l:FAC, 'Cant.Ini.')
ACT(m:FAC, 'Cant.Fin.')
ACT(n:FAC, 'Cotiza')
ACT(o:FAC, 'IntCorr')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Intereses')
ACT(ac:FAC, 'Cant.Reg.')
ACT(ad:FAC, 'Resultado')

ACT(ai:FAC, 'VTeorico2()')
ACT(aj:FAC, 'Esp.DiasAnio')
ACT(ak:FAC, 'Esp.DiasMes')
ACT(al:FAC, 'CuponFer')
ACT(am:FAC, 'UltCupon2()')
ACT(an:FAC, 'F.Ult.Cupon')
ACT(ao:FAC, 'F.Cbio.Tasa')
ACT(ap:FAC, 'Tipo FUC')
ACT(aq:FAC, 'T.Int.Cupon')
ACT(ar:FAC, 'Divisor')

SetFont(a:FAC..az:FAC,2)
ACN(w:1, FAC)

SQL.ADD(" Select P.Especie,     P.PrecioEj,    P.FechaEj, P.Cupon,  ")
SQL.ADD("        P.Cliente,     P.Vehiculo,    P.Book,    P.Trader, ")
SQL.ADD("        P.TipoNegocio, P.NrSaldo,     P.Fecha, ")
SQL.ADD("        P.CantidadIni, P.CantidadFin, ")
SQL.ADD("        E.Cotiza,      E.InteresesC   ")

SQL.ADD("   from "~DBO~".POSICIONES P, "~DBO~".ESPECIES E")
SQL.ADD("  where P.Especie = E.Codigo ")
SQL.ADD("    and E.Codigo in ("~Pipe2Comillas(Descendientes('ESPECIES','TITULO'))~") ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and P.Especie = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("and P.Fecha = (Select Max(P1.Fecha) from "~DBO~".POSICIONES P1 ")
SQL.ADD("                where P1.Especie                 = P.Especie  ")
SQL.ADD("                  and IsNull(P1.FechaEj,'')      = IsNull(P.FechaEj,'')  ")
SQL.ADD("                  and IsNull(P1.PrecioEj,'')        = IsNull(P.PrecioEj,'')  ")
SQL.ADD("                  and IsNull(P1.Cupon,'')        = IsNull(P.Cupon,'')  ")
SQL.ADD("                  and P1.Cliente                 = P.Cliente ")
SQL.ADD("                  and P1.Vehiculo                = P.Vehiculo ")
SQL.ADD("                  and IsNull(P1.Book,'')         = IsNull(P.Book,'')  ")
SQL.ADD("                  and IsNull(P1.Trader,'')       = IsNull(P.Trader,'')  ")
SQL.ADD("                  and IsNull(P1.TipoNegocio,'')  = IsNull(P.TipoNegocio,'') ")
SQL.ADD("                  and P1.NrSaldo                 = P.NrSaldo ")
SQL.ADD("                  and P1.Fecha                  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("              ) ")
SQL.ADD("Order by P.Especie, P.PrecioEj, P.FechaEj, P.Cupon, P.Cliente, P.Vehiculo, P.Book, P.Trader, P.TipoNegocio, P.NrSaldo ")

recorrer SQL
   SCN(x:1, 1)
   ACT(a:FAC, fbn('Especie'))
   ACN(b:FAC, fbn('PrecioEj'))
   ACD(c:FAC, fbn('FechaEj'))
   ACT(d:FAC, fbn('Cupon'))
   ACT(e:FAC, fbn('Cliente'))
   ACT(f:FAC, fbn('Vehiculo'))
   ACT(g:FAC, fbn('Book'))
   ACT(h:FAC, fbn('Trader'))
   ACT(i:FAC, fbn('TipoNegocio'))
   ACN(j:FAC, fbn('NrSaldo'))
   ACD(k:FAC, fbn('Fecha'))
   ACN(l:FAC, fbn('CantidadIni'))
   ACN(m:FAC, fbn('CantidadFin'))
   ACT(n:FAC, fbn('Cotiza'))
   ACT(o:FAC, fbn('InteresesC'))
   if Not EqStr(fbn('Especie'),Val(v:1))   
     SCN(x:2, 1)
     ACT(aa:Val(x:2)+3, fbn('Especie'))
     ACT(v:1, fbn('Especie'))
   endif

proximo

if Val(x:1)>0
  FormatoCeldas(b:Val(w:1)+1..b:FAC, Exe('F6'))
  FormatoCeldas(j:Val(w:1)+1..j:FAC, Exe('F0'))
  FormatoCeldas(l:Val(w:1)+1..m:FAC, Exe('F2'))
  SetFont(a:Val(w:1)+1..o:FAC, 1)
endif
if Val(x:2)>0
  ** Calculo de Intereses correidos por Especie
  recorrer&i 4,Val(x:2)+3

* TotalImpuesto1
** ValorTeorico2(ESPECIE,FECHAVTO)
** *CANTIDAD
** *TASAINTERESESCUPON
** /DIASA(EspecieDiasAnio(ESPECIE),FSYS)
** /100
** *IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO));

* TasaInteresCupon
** IF(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE) > FECHAULTCUPON y BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE) <= FECHAVTO,
**    ((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)*IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,4),DifDias(FECHAULTCUPON,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,'USA',NO)))+(BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE)*(IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE)-1,FECHAVTO,4),DifDias(BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',Especie)-1,FECHAVTO,'USA',NO)))))/(IF(EspecieDiasAnio(ESPECIE)=0 y EspecieDiasMes(ESPECIE)=0,Dif360(FECHAULTCUPON,FECHAVTO,4),DifDias(FECHAULTCUPON,FECHAVTO,'USA',NO))),
**    BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE)
**   )*100;


* FechaUltCupon
** IF(EsHabil(UltCupon2(ESPECIE,FECHAVTO),'USA'),
**    UltCupon2(ESPECIE,FECHAVTO),
**    Habiles(UltCupon2(ESPECIE,FECHAVTO),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',ESPECIE),'ANT'),-1,0)),'USA')
**   )


    ACN(ai:&i, ValorTeorico2(Val(aa:&i),Dialogo.Fecha1))
    ACN(aj:&i, EspecieDiasAnio(Val(aa:&i)))
    ACN(ak:&i, EspecieDiasMes(Val(aa:&i)))
    * CuponFeriado
    ACT(al:&i, BuscarCampo('ESPECIES','CuponFeriado','Codigo',Val(aa:&i)))
    * UltCupon2
    ACD(am:&i, UltCupon2(Val(aa:&i),Dialogo.Fecha1))
    * FechaUltCupon
    if EsHabil(Val(am:&i),'USA')
      ACD(an:&i, Val(am:&i))
    else
      ACD(an:&i, Habiles(Val(am:&i),iif(EqStr(Val(al:&i),'SIG'),1,iif(EqStr(Val(al:&i),'ANT'),-1,0)),'USA'))
    endif
    * FechaCambioTasa
    ACD(ao:&i, BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',Val(aa:&i)))
    * tasaInteresCupon
    if Val(ao:&i)>Val(an:&i) y Val(ao:&i)<Dialogo.Fecha1
      ACT(ap:&i, 'Mix')
      ACN(aq:&i, BuscarCampo('ESPECIES','TasaIntVigente','Codigo',Val(aa:&i)))
    else
      ACT(ap:&i, 'Vigente')
      ACN(aq:&i, BuscarCampo('ESPECIES','TasaIntVigente','Codigo',Val(aa:&i)))
    endif
    ACN(aq:&i, Val(aq:&i)*100)
    * Divisor
    ACN(ar:&i, DIASA(Val(aj:&i),Dialogo.Fecha1))

    ACN(ab:&i, Val(aq:&i)/Val(ar:&i)/100)

*    ACN(ab:&i, 10+&i)
    if Val(ab:&i)>0
      ACN(ac:&i, SQL("Select Count(*) from "~DBO~".INTERESESCORRIDOS where Especie = '"~Val(aa:&i)~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' "))
      if Val(ac:&i)=0
        ACT(ad:&i, 'Insert')
        if Dialogo.Check1=1
          SQL.ADD("Insert into "~DBO~".INTERESESCORRIDOS ( ")
          SQL.ADD("   Fecha, Fecha1, Especie, Intereses ")
          SQL.ADD("   ) values ( ")
          SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
          SQL.ADD("   '"~Val(aa:&i)~"', ")
          SQL.ADD("   "~FStr(Val(ab:&i),1,8)~" ")
          SQL.ADD("   ) ")
          SQL.NEW
          SQL.EXEC
        endif
      else
        if Val(ac:&i)=1
          ACT(ad:&i, 'Update')
          if Dialogo.Check1=1
            SQL.ADD("Update "~DBO~".INTERESESCORRIDOS ")
            SQL.ADD("   Set Intereses = "~FStr(Val(ab:&i),1,8)~" ")
            SQL.ADD(" where Especie = '"~Val(aa:&i)~"' ")
            SQL.ADD("   and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.NEW
            SQL.EXEC
          endif
        else
          ACT(ad:&i, 'Error - Mas de un registro')
        endif
      endif
    else
      ACT(ad:&i, 'Error - Intereses cero')
    endif

  proximo
  FormatoCeldas(ab:Val(w:1)+1..ab:FAC, Exe('F8'))
  FormatoCeldas(ac:Val(w:1)+1..ac:FAC, Exe('F0'))
  FormatoCeldas(ai:Val(w:1)+1..ai:FAC, Exe('F8'))
  FormatoCeldas(aj:Val(w:1)+1..ak:FAC, Exe('F0'))
  FormatoCeldas(aq:Val(w:1)+1..aq:FAC, Exe('F8'))
  FormatoCeldas(ar:Val(w:1)+1..ar:FAC, Exe('F0'))
  SetFont(aa:4..az:Val(x:2)+3, 1)
endif

SetFont(v:1..z:3, 1)

