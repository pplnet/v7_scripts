CrearDialogo
  Fecha1: 'F.Desde'    ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;PriDeMes(FSys)
  Fecha2: 'F.Hasta'    ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FinDeMes(FSys)
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,BU")

SetFilaActual(1)
ACT(A:2,'Operaciones Descuento Documentos')
SetFont(A:2,3)

SetFilaActual(4)

ACT(A:FAC,'Fecha Desde: '~Dialogo.Fecha1)
ACT(A:FAC+1,'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(A:FAC..A:FAC+1,2)

SetFilaActual(FAC+3)

ACT(A:FAC,'Nro. Operacion')
ACT(B:FAC,'Fecha Conc.')
ACT(C:FAC,'Plazo Liq')
ACT(D:FAC,'Fecha Liq.')
ACT(E:FAC,'Plazo')
ACT(F:FAC,'Fecha Vto.')
ACT(G:FAC,'Contraparte')
ACT(H:FAC,'Banco')
ACT(I:FAC,'Compra/Venta')
ACT(J:FAC,'Moneda')
ACT(K:FAC,'Moneda Liq.')
ACT(L:FAC,'Capital')
ACT(M:FAC,'Tasa')
ACT(N:FAC,'Descuento')
ACT(O:FAC,'Monto')
ACT(P:FAC,'Total Debitado')

AgregarMarco(A:FAC..P:FAC,2,0,Exe('COLOR6'))
AlinearCeldas(A:FAC..P:FAC,'C')
SetFont(A:FAC..P:FAC,2)

ACN(FI:1,FAC+1)

SQL.ADD("Select NrOperacion, Especie, ContraEspecie, Cliente1, Cliente2, FechaOp, FechaVto, FechaVto2, Cantidad, TotalNetoCli1, ")
SQL.ADD("   TotalIntereses, Precio1, Plazo2, Plazo, RB1, TotalNetoCli2 ")
SQL.ADD("  From "~DBO~".OPERACIONES ")
SQL.ADD(" Where FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   And TipoOp = 'DTODOC' ")
SQL.ADD(" Order by FechaOp ")

Recorrer SQL
  ACT(A:FAC,FBN['NrOperacion'])
  ACLO(A:FAC,FBN['NrOperacion'])
  ACD(B:FAC,FBN['FechaOp'])
  ACN(C:FAC,FBN['Plazo2'])
  ACD(D:FAC,FBN['FechaVto'])
  ACN(E:FAC,FBN['Plazo'])
  ACD(F:FAC,FBN['FechaVto2'])
  ACT(G:FAC,FBN['Cliente1'])
  ACT(H:FAC,FBN['Cliente2'])
  ACT(I:FAC,IIF(FBN['RB1']=0,'Compra','Venta'))
  ACT(J:FAC,FBN['Especie'])
  ACT(K:FAC,FBN['ContraEspecie'])
  ACN(L:FAC,FBN['Cantidad'])
  ACN(M:FAC,FBN['Precio1'])
  ACN(N:FAC,FBN['TotalIntereses'])
  ACN(O:FAC,FBN['TotalNetoCli1'])
  ACN(P:FAC,FBN['TotalNetoCli2'])
  
  FormatoCeldas(C:FAC..C:FAC,EXE('F0'))
  FormatoCeldas(E:FAC..E:FAC,EXE('F0'))
  FormatoCeldas(L:FAC..L:FAC,EXE('F2'))
  FormatoCeldas(M:FAC..M:FAC,EXE('F8'))
  FormatoCeldas(N:FAC..P:FAC,EXE('F2'))
Proximo

SetFont(A:Val(FI:1)..P:FAC,1)

SetFilaActual(FAC+2)
ACT(A:FAC,'FIN DEL LISTADO')
SetFont(A:FAC,2)

ACO(1,9)
ACO(2,8)
ACO(3,6)
ACO(4,8)
ACO(5,5)
ACO(6,8)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,6)
ACO(11,7)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)

LimitesVision(Q:FAC)
