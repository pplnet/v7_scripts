HojaVisible(SI)
ModoReproceso(SinDialogo)
CrearDialogo
   String1     : 'Nr.Operacion'         ;;;;;;;;;;;;;;;;
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


  SetFilaActual(1)
  ACT(a:1,'SIAF Auditoria Operaciones - CONFIDENCIAL')
  SetFont(a:1,1)


SetFilaActual(fac+2)
ACT(b:fac, 'Listado de # Auditor¡a de Operaciones')
SetFont(b:fac, 3)

SetFilaActual(fac+1)

  ACT(a:fac+1, 'Nro.Operacion: '~Dialogo.String1)


**************   INSTANCIASOP  ***********************

SetFilaActual(fac+1)

  ACT(A:fac,'Nro.Operacion')
  ACT(B:fac,'Instancia')
  ACT(C:fac,'Descripcion')
  ACT(D:fac,'Operador')
  ACT(E:fac,'Nombre')
  ACT(F:fac,'Mensaje')
  ACT(G:fac,'Fecha')
  ACT(h:fac,'Estado')
  ACT(i:fac,'Actual')

AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))
Setfont(a2..i:fac, 1)
AlinearCeldas(A:fac..i:fac, 'C')

*--  Vehiculos permitidos por el Usuario
   ACT(z1,SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))



**************   OPERACIONES  ***********************

*--  Select
SQL.ADD(" Select  a.NrOperacion,  a.NrInstancia, a.Usuario, a.Mensaje, a.Fecha, b.Nombre Descr, c.Nombre, substring(a.NrOperacion, 1, 1) TAAA  " )
SQL.ADD("   from   "~DBO~".INSTANCIASOP a, "~DBO~".INSTANCIAS b, "~DBO~".USUARIOS c  " )
SQL.ADD("        ,  "~DBO~".OPERACIONES d  " )
SQL.ADD("   where a.NrInstancia = b.NrInstancia ")
SQL.ADD("     and b.Tabla = 'OPERACIONES'       ")
SQL.ADD("     and a.NrOperacion = d.NrOperacion      ")
SQL.ADD("     and a.Usuario = c.Codigo      ")
   if NoVacio(Dialogo.String1)
   SQL.ADD("and a.NrOperacion ='"~Dialogo.String1~"' ")
   ENDIF
SQL.ADD("order by a.NrOperacion, a.Fecha desc, a.Usuario")

acn(z3,0)
acn(z2,0)
ACT(Z4, 'O')

ACN(FI:1, fac+1)

Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACLO(a:fac,Val(a:fac))
    ACT(b:fac,FBN['NrInstancia'])
    ACT(c:fac,FBN['Descr'])
    ACT(d:fac,FBN['Usuario'])
    ACT(e:fac,FBN['Nombre'])
    ACT(f:fac,FBN['Mensaje'])
    ACT(g:fac,FBN['Fecha'])
    IF eqstr(val(Z4),FBN['NrOperacion'])
    else
         ACN(z2,SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion ='"~FBN['NrOperacion']~"' and Valor = '1' "))
         ACT(z3,SQL("Select Nombre from "~DBO~".INSTANCIAS     where NrInstancia ="~Fstr(val(z2),0,0)~" and Tabla = 'OPERACIONES' "))
         ACN(h:fac,val(z2))
         ACT(i:fac,val(z3))
         ACT(z4,FBN['NrOperacion'])
    endif
    SetFont(a:fac..i:fac, 2)
Proximo
Ifa
Ifa

**************   TRANSACCIONES2  ***********************

  SQL.ADD(" Select  a.NrOperacion,  a.NrInstancia, a.Usuario, a.Mensaje, a.Fecha, b.Nombre Descr, c.Nombre, substring(a.NrOperacion, 1, 1) TAAA  " )
  SQL.ADD("   from   "~DBO~".INSTANCIASOP a, "~DBO~".INSTANCIAS b, "~DBO~".USUARIOS c  " )
  SQL.ADD("        ,  "~DBO~".TRANSACCIONES2 d  " )
  SQL.ADD("   where                              ")
  if NoVacio(Dialogo.String1) 
  SQL.ADD("         d.NrOperacionRef1 like '"~Dialogo.String1~"'and ")
  endif
  SQL.ADD("      d.NrOperacionRef1 = a.NrOperacion     ")
  SQL.ADD("     and b.Tabla = 'TRANSACCIONES2'        ")
  SQL.ADD("     and a.NrInstancia = b.NrInstancia    ")
  SQL.ADD("     and a.Usuario = c.Codigo      ")


SQL.ADD("order by a.NrOperacion, a.Fecha desc, a.Usuario")

acn(z3,0)
acn(z2,0)
ACT(Z4, 'O')

ACN(FI:1, fac+1)
Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACLT(a:fac,Val(a:fac))
    ACT(b:fac,FBN['NrInstancia'])
    ACT(c:fac,FBN['Descr'])
    ACT(d:fac,FBN['Usuario'])
    ACT(e:fac,FBN['Nombre'])
    ACT(f:fac,FBN['Mensaje'])
    ACT(g:fac,FBN['Fecha'])
    IF eqstr(val(Z4),FBN['NrOperacion'])
    else
         ACN(z2,SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion ='"~FBN['NrOperacion']~"' and Valor = '1' "))
         ACT(z3,SQL("Select Nombre from "~DBO~".INSTANCIAS     where NrInstancia = "~Fstr(val(z2),0,0)~" and Tabla = 'TRANSACCIONES2' "))
         ACN(h:fac,val(z2))
         ACT(i:fac,val(z3))
         ACT(z4,FBN['NrOperacion'])
    endif
    SetFont(a:fac..i:fac, 2)
Proximo
Ifa
Ifa


**************   PMAUDIT  ***********************

SetFilaActual(fac+1)

  ACT(A:fac,'Nro.Operacion')
  ACT(B:fac,'Operador')
  ACT(C:fac,'Nombre')
  ACT(D:fac,'Fecha Act.')
  ACT(E:fac,'Accion')
  ACT(F:fac,'Tabla')
  ACT(G:fac,'Campo')
  ACT(H:fac,'Valor Anterior')
  ACT(I:fac,'Valor Nuevo')

AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))
Setfont(a:fac..i:fac, 1)
AlinearCeldas(A:fac..i:fac, 'C')

*--  Vehiculos permitidos por el Usuario
   ACT(z1,SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))

*--  Select

SQL.ADD(" Select  a.* , c.Nombre  " )
SQL.ADD("   from   "~DBO~".PMAUDIT a , "~DBO~".USUARIOS c   " )
SQL.ADD("        ,  "~DBO~".OPERACIONES d  " )
SQL.ADD("   where a.Codigo   = d.NrOperacion     ")
SQL.ADD("     and a.Operador = c.Codigo      ")
  if NoVacio(Dialogo.String1)
  SQL.ADD("and a.Codigo ='"~Dialogo.String1~"' ")
  endif
SQL.ADD("order by a.Codigo, a.Fecha , a.Operador")

acn(z3,0)
acn(z2,0)
ACT(Z4, 'O')

ACN(FI:1, fac+1)
Recorrer SQL
    ACT(a:fac,FBN['Codigo'])
    ACLT(a:fac,Val(a:fac))
    ACT(b:fac,FBN['Operador'])
    ACT(c:fac,FBN['Nombre'])
    ACT(d:fac,FBN['Fecha'])
    ACT(e:fac,FBN['Accion'])
    ACT(f:fac,FBN['Tabla'])
    ACT(g:fac,FBN['Campo'])
    ACT(h:fac,FBN['ValorAnterior'])
    ACT(i:fac,FBN['ValorActual'])

    SetFont(a:fac..i:fac, 2)
Proximo
Ifa
Ifa

