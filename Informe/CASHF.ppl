HojaVisible(NO)
ModoReproceso(SinDialogo)

CrearDialogo
   Fecha1  : 'Fecha'                            ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Invalida';NO;Fsys;
   Radio2  : 'Cuad. Consol|ARP|USD'             ;1;2;;;;;;;0;
   Radio1  : 'Vehc. Consol |SI|NO'              ;3;1;;;;;;;0;
   Lista1  : 'Vehiculo'                         ;5;1;;;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Lista1);'Debe Ingresar un Vehiculo';NO;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Radio10 : 'Tasa Simulad |Si |No'             ;;;;;NO;;;;0;
   Radio3  : 'Minutas |Reales|Reales-Simuladas' ;;;;;NO;;;;1;
FinDialogo

If Not Ok
   Cancelar
Endif

*--> Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz:6, Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz:6, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

If Dialogo.Radio1=0
   *--> Consolidado
   LinkearHoja('RCASHF', 1, Fecha1=Dialogo.Fecha1, Radio2=Dialogo.Radio2, Radio1=Dialogo.Radio1, Vehiculo1='', Radio3=Dialogo.Radio3, Radio10=Dialogo.Radio10)
Else 
   *--> Selecciono los vehiculos de la Lista
   SQL.ADD("Select Codigo FROM "~DBO~".VEHICULOS ")
   SQL.ADD(" Where Codigo in ("~Pipe2Comillas(Val(zz:6))~") ")
   Recorrer SQL
       Message('Procesando Cash Flow Vehiculo '~FBN['Codigo'])
       LinkearHoja('RCASHF', 1, Fecha1=Dialogo.Fecha1, Radio2=Dialogo.Radio2, Radio1=Dialogo.Radio1, Vehiculo1=FBN['Codigo'], Radio3=Dialogo.Radio3, Radio10 = Dialogo.Radio10)
   Proximo 
EndIf
