      act(w:fac, Val(z3))
      ACT(z10, fbn('Especie'))
      SQL.ADD("Select * from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and Fecha2>='"~IdxDate(Dialogo.Fecha1)~"'")
      recorrer SQL
        dfa
        if fbn('Fecha1')<=Dialogo.Fecha1
          ACN(b:fac, fbn('Cantidad2'))
          ACN(z4, Dialogo.Fecha1)
         * estos son los intereses previos al inicio del periodo, que son los que sufren DC, solo hay que multiplicarlos por el TC al fin (realizado)/vto(no realizado) menos TC al inicio
          ACN(z6, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha1-fbn('Fecha1')))
          if fbn('Fecha2')>Dialogo.Fecha2
            ACN(z9, Val(z8))   
            SCN(p:fac, Val(z6)*(Val(z9)-Val(z7)))
          else
            if Dialogo.Radio1=3
              ACN(z9, SQL("select "~DBO~".ConversionMonedaMesa('"~Val(z10)~"', '"~IdxDate(fbn('Fecha2'))~"', '"~Val(z3)~"', 1)"))
            else
              ACN(z9, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Val(z10)~"', '"~IdxDate(fbn('Fecha2'))~"', '"~Val(z3)~"', 1)"))
            endif
            SCN(o:fac, Val(z6)*(Val(z9)-Val(z7)))
          endif
          acn(x:fac, val(z9))
        endif
        if fbn('Fecha2')>=Dialogo.Fecha2
          SCN(c:fac, fbn('Cantidad2'))
          SCN(d:fac, fbn('Precio2'))
          ACN(z5, Dialogo.Fecha2)
          SCN(h:fac, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha2-fbn('Fecha1')))
          * convertido por TC
          SCN(n:fac, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha2-Val(z4))*Val(z8))
        else
          * convertido por TC
          SCN(m:fac, fbn('Cantidad3')/fbn('Plazo1')*(fbn('Fecha2')-Val(z4))*Val(z8))
        endif
      proximo
      ***---ACN(f:fac, Val(c:fac)*Val(z8))
      ACN(e:fac, fbn('Cantidad'))
      ACN(f:fac, Val(E:fac)*Val(z8))
      ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
      ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
      ACN(s:fac, Val(q:fac)+Val(r:fac))
      * totalizadores
      SCN(af:1, Val(f:fac))
      SCN(af:2, Val(f:fac))
      SCN(af:3, Val(f:fac))
      SCN(aj:1, Val(j:fac))
      SCN(aj:2, Val(j:fac))
      SCN(aj:3, Val(j:fac))
      SCN(ak:1, Val(k:fac))
      SCN(ak:2, Val(k:fac))
      SCN(ak:3, Val(k:fac))
      SCN(al:1, Val(l:fac))
      SCN(al:2, Val(l:fac))
      SCN(al:3, Val(l:fac))
      SCN(am:1, Val(m:fac))
      SCN(am:2, Val(m:fac))
      SCN(am:3, Val(m:fac))
      SCN(an:1, Val(n:fac))
      SCN(an:2, Val(n:fac))
      SCN(an:3, Val(n:fac))
      SCN(ao:1, Val(o:fac))
      SCN(ao:2, Val(o:fac))
      SCN(ao:3, Val(o:fac))
      SCN(ap:1, Val(p:fac))
      SCN(ap:2, Val(p:fac))
      SCN(ap:3, Val(p:fac))
      SCN(aq:1, Val(q:fac))
      SCN(aq:2, Val(q:fac))
      SCN(aq:3, Val(q:fac))
      SCN(ar:1, Val(r:fac))
      SCN(ar:2, Val(r:fac))
      SCN(ar:3, Val(r:fac))
      SCN(as:1, Val(s:fac))
      SCN(as:2, Val(s:fac))
      SCN(as:3, Val(s:fac))
      ifa
    proximo
  endif
  IF Eqstr(fbn('t'), 'ASaldo')
*    SQL.ADD(" Select Saldo, Especie, Book, EnteCustodia From "~DBO~".SALDOSDIA S ")
*    SQL.ADD(" Where S.EnteCustodia = '"~fbn('v')~"' ")
*    SQL.ADD(" AND S.Especie = '"~fbn('e')~"' ")
*    SQL.ADD(" AND S.NrSaldo = 50 ")
*    SQL.ADD(" AND S.Book = '"~fbn('b')~"' ")
*    SQL.ADD(" AND S.Fecha = (Select Max(Fecha) From "~DBO~".SALDOSDIA S2 ")
*    SQL.ADD("                 Where S.Especie = S2.Especie  ")
*    SQL.ADD("                 AND S.NrSaldo = S2.NrSaldo ")
*    SQL.ADD("                 AND S.EnteCustodia = S2.EnteCustodia ")
*    SQL.ADD("                 AND S.Book = S2.Book  ")
*    SQL.ADD("                 AND S.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"') ")
*    SQL.ADD("  ")
*    SQL.ADD("  ")
    
    
    SQL.ADD(" Select Case TipoOp When 'INGFON' Then Cantidad Else -Cantidad End Saldo, Especie, Book1 Book, Vehiculo1 EnteCustodia From "~DBO~".OPERACIONES S ")
    SQL.ADD(" Where S.Vehiculo1 = '"~fbn('v')~"' ")
    SQL.ADD(" AND S.Especie = '"~fbn('e')~"' ")
    SQL.ADD(" AND S.TipoOp IN ('INGFON','EGRFON') ")
    SQL.ADD(" AND S.Book1 = '"~fbn('b')~"' ")
    SQL.ADD(" AND S.FechaOp = '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD("  ")
    SQL.ADD("  ")
    Recorrer SQL
        DFA
        ACT(A:fac, fbn('Especie')~' - '~Fstr(fbn('Saldo'), 0, 0))
        ACL(A:fac, 'DETORI', Fecha1 = Dialogo.Fecha2, Book1 = fbn('Book'), Especie1 = fbn('Especie'), Vehiculo1 = fbn('EnteCustodia'), Especie2 = Val(Z:3))
    Proximo
     ifa
     ACN(FI:2, fac)
  ENDIF
  if EqStr(fbn('e'), 'XX')
    ACN(FI:2, fac)
    SQL.ADD("Select * from "~DBO~".OPERACIONES where TipoOp='MMO' and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and Vehiculo1='"~fbn('v')~"' and Book1='"~fbn('b')~"'")
    if NoVacio(Dialogo.Especie1)
      SQL.ADD("and Especie='"~Dialogo.Especie1~"'")
    endif
    SQL.ADD(" order by FechaVto")
    recorrer SQL
      dfa
      if Dialogo.Radio1=3
        ACN(z7, SQL("select "~DBO~".ConversionMonedaMesa('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Val(z3)~"', 1)"))
        ACN(z8, SQL("select "~DBO~".ConversionMonedaMesa('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(z3)~"', 1)"))
      else
        ACN(z7, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Val(z3)~"', 1)"))
        ACN(z8, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(z3)~"', 1)"))
      endif
      ACT(a:fac, fbn('Cliente1')~' - '~fbn('FechaVto'))
      ACLO(a:fac, fbn('NrOperacion'))
      ACN(e:fac, fbn('Cantidad'))
      ACN(f:fac, Val(E:fac)*Val(z8))
      ACN(H:fac, SQL(" Select Sum(Monto) from "~DBO~".MOVDEVENGADOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND TipoDevengado = 'INTLEN' AND Fecha <= '"~Idxdate(Dialogo.Fecha2)~"' "))
      ACN(M:fac, Val(H:fac) * Val(Z:8))
      ACN(N:fac, SQL(" Select Sum(Monto) from "~DBO~".MOVDEVENGADOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND TipoDevengado = 'INTLEN' AND Fecha > '"~Idxdate(Dialogo.Fecha2)~"' ") * Val(Z:8))
      ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
      ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
      ACN(s:fac, Val(q:fac)+Val(r:fac))
      * totalizadores
      SCN(af:1, Val(f:fac))
      SCN(af:2, Val(f:fac))
      SCN(af:3, Val(f:fac))
      SCN(aj:1, Val(j:fac))
      SCN(aj:2, Val(j:fac))
      SCN(aj:3, Val(j:fac))
      SCN(ak:1, Val(k:fac))
      SCN(ak:2, Val(k:fac))
      SCN(ak:3, Val(k:fac))
      SCN(al:1, Val(l:fac))
      SCN(al:2, Val(l:fac))
      SCN(al:3, Val(l:fac))
      SCN(am:1, Val(m:fac))
      SCN(am:2, Val(m:fac))
      SCN(am:3, Val(m:fac))
      SCN(an:1, Val(n:fac))
      SCN(an:2, Val(n:fac))
      SCN(an:3, Val(n:fac))
      SCN(ao:1, Val(o:fac))
      SCN(ao:2, Val(o:fac))
      SCN(ao:3, Val(o:fac))
      SCN(ap:1, Val(p:fac))
      SCN(ap:2, Val(p:fac))
      SCN(ap:3, Val(p:fac))
      SCN(aq:1, Val(q:fac))
      SCN(aq:2, Val(q:fac))
      SCN(aq:3, Val(q:fac))
      SCN(ar:1, Val(r:fac))
      SCN(ar:2, Val(r:fac))
      SCN(ar:3, Val(r:fac))
      SCN(as:1, Val(s:fac))
      SCN(as:2, Val(s:fac))
      SCN(as:3, Val(s:fac))
      ifa
    proximo
  endif
  if not Incluido(fbn('e'), 'ZZ|XX') Y Not Eqstr(fbn('t'), 'ASaldo')
    ACN(FI:2, fac)
    ACT(a:fac, fbn('e'))
    ACN(b:fac, SQL("Select CantidadIni from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' and NrSaldo=2"))
    ACN(c:fac, SQL("Select CantidadFin from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"' and NrSaldo=2"))
    IF Val(B:fac) > Val(RD:90) O Val(B:fac) < Val(RD:91) O Val(C:fac) > Val(RD:90) O Val(C:fac) < Val(RD:91)
        ***---No mostramos posiciones que tienden a cero.
        if Dialogo.Radio1=3
          ACN(z8, SQL("select "~DBO~".ConversionMonedaMesa('"~Cotizaen(Val(a:fac))~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(z3)~"', 1)"))
        else
          ACN(z8, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Cotizaen(Val(a:fac))~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(z3)~"', 1)"))
        endif
        ACN(d:fac, SQL("Select PFHME from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"' and NrSaldo=2"))
        ACN(e:fac, Val(c:fac)*Val(d:fac))
        ACN(f:fac, Val(e:fac)*Val(z8))
        ACN(z9, SQL("Select Intereses from "~DBO~".INTERESESCORRIDOS where Especie='"~Val(a:fac)~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"'"))
        if Not EqStr(BuscarCampo('ESPECIES', 'InteresesC', 'Codigo', Val(a:fac) ), 'CLE')
          ACN(g:fac, Cotizacion(Val(a:fac),,,, Dialogo.Fecha2, 1)-Val(z9))
        else
          ACN(g:fac, Cotizacion(Val(a:fac),,,, Dialogo.Fecha2, 1))
        endif
        ACN(h:fac, Val(c:fac)*Val(z9))
        **// Busca si la especie tiene incluido el valor residual
        ACN(VL:8, BuscarCampo('ESPECIES','Valor8','Codigo', val(a:fac)))
        IF [DesciendeDeEspecie(val(a:fac), 'PUBLIC') O DesciendeDeEspecie(val(a:fac), 'CORP B') O DesciendeDeEspecie(val(a:fac), 'EXTRAN')] Y Val(VL:8)=0
           **La especie es un titulo publico             
           ACN(i:fac, (Val(c:fac)*Val(g:fac)*ValorTeorico2(val(a:fac),Dialogo.Fecha2))+Val(h:fac))
        Else
           ACN(i:fac, (Val(c:fac)*Val(g:fac))+Val(h:fac))     
        EndIf
        * por tipo de cambio
        ACN(j:fac, Val(i:fac)*Val(z8))
        acn(u:fac, val(z8))
        act(v:fac, Cotizaen(Val(a:fac)))
        act(w:fac, Val(z3))
        SQL.ADD("Select")
        if Dialogo.Radio1=0
          SQL.ADD("sum(RZMFDAY) r1, sum(RVMFDAY) r2, sum(YRMFDAY + YCMFDAY + DEMFDAY + DFMFDAY) r3, sum(YNMFDAY) r4, sum(IDMFDAY + KRMFDAY) r5, sum(DKMFDAY) r6")
        else
          if Dialogo.Radio1=1
            SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(YRMCDAY + YCMCDAY + DEMCDAY + DFMCDAY) r3, sum(YNMCDAY) r4, sum(IDMCDAY + KRMCDAY) r5, sum(DKMCDAY) r6")
          else
            if Dialogo.Radio1=2
              SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(YRMLDAY + YCMLDAY + DEMLDAY + DFMLDAY) r3, sum(YNMLDAY) r4, sum(IDMLDAY + KRMLDAY) r5, sum(DKMLDAY) r6")
            else
              SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(YRMMDAY + YCMMDAY + DEMMDAY + DFMMDAY) r3, sum(YNMMDAY) r4, sum(IDMMDAY + KRMMDAY) r5, sum(DKMMDAY) r6")
            endif 
          endif
        endif
        * para verlo en ME
        SQL.ADD(", sum(RZMEDAY) r11, sum(RVMEDAY) r12, sum(YRMEDAY + YCMEDAY + DEMEDAY + DFMEDAY) r13, sum(YNMEDAY) r14, 0 r15, 0 r16")
        SQL.ADD("from "~DBO~".RESULTADOS2 where ")
        SQL.ADD("Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and")
        SQL.ADD("Fecha<='"~IdxDate(Dialogo.Fecha2)~"' and")
        SQL.ADD("Vehiculo='"~Val(z1)~"' and")
        SQL.ADD("Book='"~Val(z2)~"' and")
        SQL.ADD("Especie='"~Val(a:fac)~"'")
        recorrer SQL
          dfa
          ACN(k:fac, fbn('r1'))
          ACN(l:fac, fbn('r2'))
          ACN(m:fac, fbn('r3'))
          ACN(n:fac, fbn('r4'))
          ACN(o:fac, fbn('r5'))
          ACN(p:fac, fbn('r6'))
          ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
          ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
          ACN(s:fac, Val(q:fac)+Val(r:fac))
          * para verlo en ME
          ACN(aa:fac, fbn('r11'))
          ACN(ab:fac, fbn('r12'))
          ACN(ac:fac, fbn('r13'))
          ACN(ad:fac, fbn('r14'))
          ACN(ae:fac, fbn('r15'))
          ACN(af:fac, fbn('r16'))
        proximo
        * totalizadores
        SCN(af:1, Val(f:fac))
        SCN(af:2, Val(f:fac))
        SCN(af:3, Val(f:fac))
        SCN(aj:1, Val(j:fac))
        SCN(aj:2, Val(j:fac))
        SCN(aj:3, Val(j:fac))
        SCN(ak:1, Val(k:fac))
        SCN(ak:2, Val(k:fac))
        SCN(ak:3, Val(k:fac))
        SCN(al:1, Val(l:fac))
        SCN(al:2, Val(l:fac))
        SCN(al:3, Val(l:fac))
        SCN(am:1, Val(m:fac))
        SCN(am:2, Val(m:fac))
        SCN(am:3, Val(m:fac))
        SCN(an:1, Val(n:fac))
        SCN(an:2, Val(n:fac))
        SCN(an:3, Val(n:fac))
        SCN(ao:1, Val(o:fac))
        SCN(ao:2, Val(o:fac))
        SCN(ao:3, Val(o:fac))
        SCN(ap:1, Val(p:fac))
        SCN(ap:2, Val(p:fac))
        SCN(ap:3, Val(p:fac))
        SCN(aq:1, Val(q:fac))
        SCN(aq:2, Val(q:fac))
        SCN(aq:3, Val(q:fac))
        SCN(ar:1, Val(r:fac))
        SCN(ar:2, Val(r:fac))
        SCN(ar:3, Val(r:fac))
        SCN(as:1, Val(s:fac))
        SCN(as:2, Val(s:fac))
        SCN(as:3, Val(s:fac))
    ELSE
        DFA
    ENDIF
  else
    dfa
  endif
proximo

if NoVacio(Val(z1))
  ifa
  IF Not Eqstr(Val(TP:1), 'ASaldo')
    ACT(a:fac, 'Total Tipo '~Val(TP:1))
  ENDIF
  ACN(f:fac, Val(af:3))
  ACN(j:fac, Val(aj:3))
  ACN(k:fac, Val(ak:3))
  ACN(l:fac, Val(al:3))
  ACN(m:fac, Val(am:3))
  ACN(n:fac, Val(an:3))
  ACN(o:fac, Val(ao:3))
  ACN(p:fac, Val(ap:3))
  ACN(q:fac, Val(aq:3))
  ACN(r:fac, Val(ar:3))
  ACN(s:fac, Val(as:3))
  AgregarMarco(a:fac..s:fac,1)
  ifa
  ACT(a:fac, 'Total Book '~Val(Z:2))
  ACN(f:fac, Val(af:1))
  ACN(j:fac, Val(aj:1))
  ACN(k:fac, Val(ak:1))
  ACN(l:fac, Val(al:1))
  ACN(m:fac, Val(am:1))
  ACN(n:fac, Val(an:1))
  ACN(o:fac, Val(ao:1))
  ACN(p:fac, Val(ap:1))
  ACN(q:fac, Val(aq:1))
  ACN(r:fac, Val(ar:1))
  ACN(s:fac, Val(as:1))
  AgregarMarco(a:fac..s:fac,1, 0, Exe('COLOR6'))
  ifa
  ACT(a:fac, 'Total Vehiculo')
  ACT(a:fac, 'Total Vehiculo')
  ACN(f:fac, Val(af:2))
  ACN(j:fac, Val(aj:2))
  ACN(k:fac, Val(ak:2))
  ACN(l:fac, Val(al:2))
  ACN(m:fac, Val(am:2))
  ACN(n:fac, Val(an:2))
  ACN(o:fac, Val(ao:2))
  ACN(p:fac, Val(ap:2))
  ACN(q:fac, Val(aq:2))
  ACN(r:fac, Val(ar:2))
  ACN(s:fac, Val(as:2))
  SetFont(A:fac-2..S:fac, 1)
  AgregarMarco(a:fac..s:fac,1,0,Exe('COLOR8'))
endif

FormatoCeldas(d:9..d:fac, Exe('F7'))
FormatoCeldas(g:9..g:fac, Exe('F7'))
FormatoCeldas(t:9..u:fac, Exe('F7'))
FormatoCeldas(x:9..x:fac, Exe('F7'))
LimitesVision(S:fac+1)

*LimitesVision(t:fac+1)
