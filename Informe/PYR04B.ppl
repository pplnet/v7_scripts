IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1: 'Fecha Desde';;;;;;;;;PriDeMes(FSys)
  Fecha2: 'Fecha Hasta';;;;;;;;;FSys
  Book1: 'Book'
  Especie1: 'Especie'
  Radio1: 'Moneda|ARP|USD|Local|Mesa';6;;;;;;;;0
  ***---  Radio2     : "Vehiculos |Habilitados |Deshabilitados |Ambos"    ;7;;;;;;;;0;
  ***---Lista1     : "Vehiculo"             ;1;2;;;;;;;;;IIF(Dialogo.Radio2 = 2, Val(LS:1), IIF(Dialogo.Radio2 = 0, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where Status = 'HAB' "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' ")), IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where Status <> 'HAB' OR Status Is Null "),SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND (V.Status = 'DES' OR V.Status Is Null)"))));;
  Lista1     : "Vehiculo"             ;1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
 * Lista2     : "Titulos a Excluir"    ;3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'TITULO'))~") ");
 ***---Lista2     : "Titulos a Excluir"    ;3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Tipo IN ('PUB','PRI','ONE') ");
