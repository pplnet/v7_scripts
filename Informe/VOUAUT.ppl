ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1:'Vehiculo' ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Fecha1   :'F.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha2   :'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
FinDialogo
if Not OK
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

If NoVacio(UsrVehiculos(UsuarioActivo))
   ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
Else
   ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")

SetFilaActual(3)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)
ACT(a:fac, 'Vouchers generados automaticamente')
SetFont(a:fac..a:fac,3)
SetFilaActual(fac+2)
ACN(w1,fac)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:fac+1, 'Vehiculo: '~Dialogo.Vehiculo1)
  else
   ACT(a:fac+1, 'Vehiculo: Todos')
endif
ACT(a:fac+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:fac+3, 'F.Hasta: '~Dialogo.Fecha2)

SetFilaActual(fac+5)
ACT(a:fac, 'Instancia')
ACT(b:fac, 'Número')
ACT(c:fac, 'Fecha Carga')
ACT(d:fac, 'Fecha Liq.')
ACT(e:fac, 'Especie')
ACT(f:fac, 'Tipo Tr.')
ACT(g:fac, 'Cliente')
ACT(h:fac, 'Cantidad')
ACT(i:fac, 'Vehiculo')
ACT(j:fac, 'Nr.Operacion')
ACT(k:fac, 'Nr.Carta')

AlinearCeldas(a:fac..g:fac,'I')
AlinearCeldas(h:fac..h:fac,'D')
AlinearCeldas(i:fac..n:fac,'I')
SetFont(a:5..n:fac,2)
AgregarMarco(a:fac..k:fac,2,0,Exe('COLOR'))

if NoVacio(Dialogo.Vehiculo1)
  ACT(z1, "Vehiculo1 = '"~Dialogo.Vehiculo1~"' and ")
endif

SQL.ADD("Select TipoTr2, NrTrans, Fecha1, Fecha2, Especie, Cliente1, Cantidad1, Vehiculo1, NrOperacionRef1, NrOperacionRef2")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 where "~Val(z1) ~" ")
SQL.ADD("Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and TipoTr2 in ('DEP','RET')")
SQL.ADD("and Cuenta1 is NULL and Cuenta2 is NULL and Cuenta5 is NULL and Cuenta6 is NULL ")
SQL.ADD("and Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
SQL.ADD("Order by NrTrans")

recorrer SQL
  SCN(z2,1)
  ACT(z3, ' ')
  ACT(z3, SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~fbn('NrTrans')~"' and Valor = '1'"))
  act(a:fac, ' ')
  If Incluido('1',Val(z3))
    ACT(a:fac, 'Control Liq.')
    ColorCeldas(a:fac,clRED)
  EndIf
  If Incluido('2',Val(z3))
    ACT(a:fac, 'Emision Cartas')
    ColorCeldas(a:fac, RGB(128,128,0))
  EndIf
  If Incluido('3',Val(z3))
    ACT(a:fac, 'Supervision')
   ColorCeldas(a:fac,clBLUE)
  EndIf
  If Incluido('5',Val(z3))
    ACT(a:fac, 'Liquidacion')
   ColorCeldas(a:fac,clBLUE)
  EndIf
  If Incluido('10',Val(z3))
    ACT(a:fac, 'Confirmacion')
    ColorCeldas(a:fac,RGB(13,1,3))
  EndIf
  If Incluido('20',Val(z3))
    ACT(a:fac, 'Terminal')
    ColorCeldas(a:fac,clGREEN)
  EndIf
  If not Incluido(Val(z3),'1|2|3|5|10|20')
   ACT(a:fac, 'Inst.Automatica '~Val(Z3))
   ColorCeldas(a:fac,clBLUE)
  EndIf

  ACT(b:fac, fbn('NrTrans'))
  ACT(c:fac, fbn('Fecha1'))
  ACT(d:fac, fbn('Fecha2'))
  ACT(e:fac, fbn('Especie'))
  ACT(f:fac, fbn('TipoTr2'))
  ACT(g:fac, fbn('Cliente1'))
  ACN(h:fac, fbn('Cantidad1'))
  ACT(i:fac, fbn('Vehiculo1'))
*  ACT(j:fac, fbn('Cuenta2'))
  ACT(j:fac, fbn('NrOperacionRef1'))
  ACT(k:fac, fbn('NrOperacionRef2'))

  FormatoCeldas(i:fac..i:fac,Exe('F7'))
  * link con consulta de operaciones
  ACLT(b:fac,Val(b:fac))
  ACLO(j:fac,Val(k:fac))
proximo

SetFont(a:Val(w1)+6..n:fac,1)

ACO(1,10)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,6)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,9)
ACO(11,8)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:fac, 2)
LimitesVision(l:fac+1)
RangoTitulo(a:1..k:fac, Val(w1)+5)
