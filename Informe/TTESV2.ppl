ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1 : "Vehiculo"                          ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1    : "Fecha"                             ;  ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Radio2    : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
   Lista1    : "Especies"                          ;  ; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");
FinDialogo

IF Not Ok
   Cancelar
ENDIF


If Vacio(Dialogo.Lista1) 
   If MessageBox('Selecciono todas las Especies, Continua?',0,2) = 7
      Cancelar
   Endif
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT CASE  WHEN EC.Jerarquia < '00300000000000' THEN '00' ELSE '99' END AS Jerarquia, ")
SQL.ADD("       S1.Especie, E.Cotiza, E.Nombre, S1.NrSaldo, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       EC.Descripcion DescEst, SUM(S1.Saldo) Saldo, E.InteresesC, S1.Cupon ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S1 WITH (NOLOCK INDEX=INDSALDIA2), "~DBO~".ESPECIES E WITH (NOLOCK) , "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)")
SQL.ADD("WHERE  E.Codigo = S1.Especie AND ")
SQL.ADD("       S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("      ((S1.NrSaldo-100=EC.NrSaldo and S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo and S1.NrSaldo=101)) and ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Cliente <> '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK INDEX=INDSALDIA2) ")
SQL.ADD("                  WHERE S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("                        S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND  ")
SQL.ADD("                        E.Jerarquia LIKE '002%')  ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.NrSaldo, E.FechaCambioTasa, E.TasaIntAnterior, ")
SQL.ADD("         E.TasaIntVigente, EC.Descripcion, E.Cotiza, E.InteresesC, EC.Jerarquia, S1.Cupon ")
SQL.ADD("ORDER BY  EC.Jerarquia, E.Cotiza, S1.Especie, S1.Cupon ")

ACT(c1, 'Saldos de terceros con y sin garantia')
ACD(c2, Dialogo.Fecha1)
SetFont(c1..c2,3)
AlinearCeldas(c1..c2,'C')

ACT(f4, 'Fecha: '~Var('FECHASYS'))
ACT(a5, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))
IF NoVacio(Dialogo.Vehiculo1)
   ACT(c5, 'Vehiculo: '~Dialogo.Vehiculo1)
ENDIF
IF NoVacio(Dialogo.Lista1)
   ACT(a6, 'Especies: '~Dialogo.Lista1)
ENDIF

SetFont(a4..f6,2)

ACT(a:7, 'Especie')
ACT(b:7, 'Cupon')
ACT(c:7, 'Estado')
ACT(d:7, 'V.N.')
ACT(e:7, 'V.R.')
ACT(f:7, 'Valuacion')
ACT(g:7, 'Cotiz.')
ACT(h:7, 'Interes')

SetFont(a:7..h:7,2)
AlinearCeldas(a:7..h:7,'C')
AgregarMarco(a:7..h:7,2,2,Exe('COLOR'))


* Variable Especie
ACT(az2, '')

* Acumulador Especie VN
ACN(ay2, 0)

* Acumulador de GARANTIA-MONEDA ESPECIE
ACN(ay3,0)

* Acumulador de TOTAL GENERAL
ACN(ay4,0)

* Acumulador Especie VR
ACN(ax2, 0)

* Acumulador General Valuacion
ACN(aw1, 0)
* Acumulador Especie Valuacion
ACN(aw2, 0)

*- Flags
ACN(at1,0)
ACN(at2,0)
ACN(at5,0)

*- Variable que dice si es CON/SIN GARANTIA
ACN(at3,0)

*- Variable que guarda el estado anterior de at3
ACN(at4,0)

*- Moneda de la especie
ACT(az3,'')

ACN(fi1, 8)
SetFilaActual(Val(fi1)-1)
Recorrer SQL
   If Num(FBN['Jerarquia']) = 0 y Val(at1) = 0
      ACT(at4,Val(at3))
      ACT(at3, 'SIN GARANTIA')
      ACN(at1,1)
   Endif
          
   If Num(FBN['Jerarquia']) <> 0 y Val(at2) = 0
      ACT(at4,Val(at3))
      ACT(at3, 'CON GARANTIA')
      ACN(at2,1)
   Endif

   If Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2)) o Not EqStr(FBN['Cotiza'], Val(az3))
      If Val(ay2) <> 0
         ACT(c:fac, 'Total Especie --->')
         ACN(d:fac, Val(ay2))
         SCN(ay3, Val(aw2))
         ACN(e:fac, Val(ax2))
         ACN(f:fac, Val(aw2))
         SetFont(c:fac..f:fac,2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         SetFilaActual(fac+2)
      Endif
   Endif

   *- Imprimo Moneda de la especie si cambia moneda de la especie o si No es GARANTIA
   If Not EqStr(FBN['Cotiza'], Val(az3)) o Not EqStr(Val(at3), Val(at4))
      If Val(at5) <> 0 
         ACT(c:fac, 'Total '~Val(az5)~' --->')
         ACN(f:fac, Val(ay3) )
         SCN(ay4, Val(ay3) )
         SetFont(c:fac..f:fac,2)
         ACN(ay3,0)
         ifa
         ifa
      Endif
      ACT(a:fac, Val(at3)~' - '~FBN['Cotiza'])
      *- Guardo si es garantia y moneda de especie
      ACT(az5,Val(a:fac))
      ACT(az3,FBN['Cotiza'])
      SetFont(a:fac,2)
      ACT(at4,Val(at3))
      ifa
      ACN(at5,1)
      ACT(az2, '')
   Endif
   
   If Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2))
      ACT(a:fac, FBN['Especie']~' - '~FBN['Nombre'])
      ACT(b:fac, FBN['Cupon'])
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACt(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
   Endif

   ACT(c:fac, FBN['DescEst'])
   ACN(d:fac, FBN['Saldo'])
   * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, FBN['Saldo'])
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)
   ACN(ca:fac, Val(zz:fac))
   ACN(cc:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
   IF Dialogo.Radio2 = 0
      ACN(cd:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   ELSE
      ACN(cd:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ENDIF

   ACN(e:fac, Val(d:fac)*Val(cc:fac))
   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(f:fac, Val(e:fac)*Val(cd:fac)+(Val(ca:fac)*Val(cd:fac)))
      ELSE
         ACN(f:fac, Val(e:fac)*Val(cd:fac)+Val(ca:fac))
      ENDIF
   ELSE
      ACN(f:fac, Val(d:fac)*Val(cd:fac)+Val(ca:fac))
   ENDIF

   ACT(az4, FBN['Cupon'])
   ACN(g:fac, Val(cd:fac))
   ACN(h:fac, Val(ca:fac))
   SCN(ay2, Val(d:fac))
   SCN(ax2, Val(e:fac))
   SCN(aw2, Val(f:fac))
   SCN(aw1, Val(f:fac))
Proximo

IF Val(ay2) <> 0
   ifa
   ACT(c:fac, 'Total Especie --->')
   ACN(d:fac, Val(ay2))
   ACN(e:fac, Val(ax2))
   ACN(f:fac, Val(aw2))
   SCN(ay3, Val(aw2))
   SetFont(c:fac..f:fac,2)
   SetFilaActual(fac+2)
   ACT(c:fac, 'Total '~Val(az5)~' --->')
   ACN(f:fac, Val(ay3) )
   SCN(ay4, Val(ay3) )
   SetFont(c:fac..f:fac,2)
   SetFilaActual(fac+2)

   ACT(c:fac, '  TOTAL GENERAL  --->')
   ACN(f:fac, Val(ay4) )
   SetFont(c:fac..f:fac,2)
   SetFilaActual(fac+2)
ENDIF

FormatoCeldas(e:Val(fi1)..e:fac,Exe('F8'))
FormatoCeldas(g:Val(fi1)..g:fac,Exe('F10'))

SetFilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')

ACO(1,20)
ACO(2,5)
ACO(3,17)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7, 5)
ACO(8, 9)
FijarFila(Val(fi1))

LimitesVision(h:fac)
SetPrintFit(3,82)
RangoTitulo(a:1..h:fac, 7)