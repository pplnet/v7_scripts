*--  Select
If Dialogo.Radio1=0
   *- Asociado ->
   SQL.ADD(" Select A.Codigo, A.Descripcion, A.Tipo, B.Descripcion Grupo from "~DBO~".CODIGOSDATANET A,  "~DBO~".TIPOSCODIGODATANET B")
   SQL.ADD("   where A.Tipo = B.Codigo ")
Else 
   *- No Asociado ->
   SQL.ADD(" Select A.Codigo, A.Descripcion, A.Tipo, 'Falta Tipificar' Grupo  from "~DBO~".CODIGOSDATANET  A ")
   SQL.ADD("   where (A.Tipo is Null or A.Tipo = '        ') ")
EndIf
SQL.ADD("order by A.Codigo")
acn(z3,0)
acn(z2,0)
