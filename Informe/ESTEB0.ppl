CrearDialogo
   Fecha1:       'Fecha Op'      ; ; ;;;;Dialogo.Fecha1<>0;'Debe ingresar una fecha.';NO;FSys
   Fecha2:       'Fecha Fin'     ;1;2;;;;Dialogo.Fecha2<>0;'Debe ingresar una fecha.';NO;FSys
   NrOperacion1: 'Nr. Operacion' ;2;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar un Nº de OP.';NO;
   Especie1:     'Especie'       ; ; ;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una especie válida.';
   TipoOp1:      'Tipo'          ; ; ;;;;
FinDialogo
If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)

ACT(A:fac, 'Informe de Prueba 0')
SetFont(A:fac, 3)

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha de inicio: '~Dialogo.Fecha1)
SetFont(A:fac..A:fac, 1)
IncFilaActual

ACT(A:fac, 'Fecha de fin: '~Dialogo.Fecha2)
SetFont(A:fac..A:fac, 1)
IncFilaActual

ACT(A:fac, 'Nr. Operacion: '~Dialogo.NrOperacion1)
SetFont(A:fac..A:fac, 1)
IncFilaActual

if Not Eqstr(Dialogo.Especie1, '')
   ACT(A:fac, 'Especie: '~Dialogo.Especie1)
   SetFont(A:fac..A:fac, 1)
else
   ACT(A:fac, 'Especie: Todas')
endif
IncFilaActual

if Not Eqstr(Dialogo.TipoOp1, '')
   ACT(A:fac, 'Tipo Op.: '~Dialogo.TipoOp1)
   SetFont(A:fac..A:fac, 1)
else
   ACT(A:fac, 'Tipo Op.: Todos')
endif

SetFilaActual(fac+2)

ACT(A:fac, 'NrOperacion')
ACT(B:fac, 'Especie')
ACT(C:fac, 'Tipo')
ACT(D:fac, 'Fecha')

SetFont(A:fac..D:fac, 2)
AlinearCeldas(A:fac..D:fac, 'C')

AgregarMarco(A:fac..D:fac,2,2,Exe('COLOR'))


SQL.ADD(" Select O.NrOperacion, O.Especie, O.TipoOp, E.Codigo, E.Nombre, E.Fecha ")
SQL.ADD(" From "~DBO~".ESPECIES E and "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and 0.Especie = 'E.Codigo' ")
if Not Eqstr(Dialogo.TipoOp1, '')
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif
if Not Eqstr(Dialogo.Especie1, '')
   SQL.ADD(" and E.Codigo = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD(" order by E.Fecha desc ")

IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")
ELSE
   SQL.ADD(" Where Tipo = 'PUB' ")
ENDIF

SQL.ADD(" order by Fecha ")

Recorrer SQL
   AgregarMarco(A:fac..C:fac,2,2)

   ACT(A:fac, fbn('Codigo'))
   ACT(B:fac, fbn('Nombre'))
   ACD(C:fac, fbn('Fecha'))

   SetFont(A:fac..C:fac, 1)
   AlinearCeldas(A:fac..C:fac, 'C')

   ACN(P:1, Val(P:1) + 1)
Proximo

SetFilaActual(fac+2)

AgregarMarco(A:fac..B:fac,2,2,Exe('COLOR'))
ACT(A:fac, 'Total de analizado:')
ACN(B:fac, Val(P:1))
FormatoCeldas(B:fac, Exe('F0'))
SetFont(A:fac..B:fac, 3)
AlinearCeldas(B:fac, 'C')

SetFilaActual(fac+2)

ACT(A:fac, 'FIN DEL INFORME')
SetFont(A:fac, 2)
AlinearCeldas(A:fac, 'C')