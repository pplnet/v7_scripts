*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Desde'    ;1;1;;;;Dialogo.Fecha1 <> 0;'FechaVto Desde Invalida';NO;Fsys
  Fecha2    : 'Hasta'    ;1;2;;;;Dialogo.Fecha2 <> 0;'FechaVto Hasta Invalida';NO;Fsys
  Radio1    : 'Oper.|Precan|Vencidas|Ambas'  ;2;1;;;;;;;2;
  Cliente1  : 'Agente'   ;3;1;;;;Vacio(Dialogo.Cliente1) O Incluido(Dialogo.Cliente1, SQLSet(" Select Codigo From "~DBO~".CLIENTES Where NrMAE Is Not Null AND NrMAE <> '0' "));'Agente Invalido';NO;;;;;;" NrMAE Is Not Null AND NrMAE <> '0' ";
  Vehiculo1 : 'Vehiculo' ;4;1;;NO;;NoVacio(DIalogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Lista1   : 'Fixing'    ;6;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,10,3)<>'000' AND SUBSTRING(Jerarquia,1,9)= (Select SUBSTRING(Jerarquia,1,9) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

**AgregarBMP(A:1, Exe('LOGO'), 60)
ACT(A:2, CodigoInforme)
SetFilaActual(4)
IF Dialogo.Radio1 = 0
  ACT(D:fac, 'Operaciones OCT Precanceladas')
endif
IF Dialogo.Radio1 = 1
  ACT(D:fac, 'Operaciones OCT Vencidas')
endif
IF Dialogo.Radio1 = 2
  ACT(D:fac, 'Operaciones OCT Precanceladas y Vencidas')
endif
SetFont(D:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
IFA
ACT(A:fac, 'Desde: '~Dialogo.Fecha1)
IFA
ACT(A:fac, 'Hasta: '~Dialogo.Fecha2)
ifa
IF NoVacio(Dialogo.Cliente1)
  ACT(A:fac, 'Agente: '~Dialogo.Cliente1)
ELSE
  ACT(A:fac, 'Agentes: Todos')
endif
ifa
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC, 'Fixing: '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(A:FAC, 'Fixing: Todos')
endif
SetFont(A:fac-4..A:fac, 2)

SetFilaActual(fac+2)
ACT(a:fac, 'Operacion')
ACT(b:fac, 'TipoOp')
ACT(c:fac, 'Cliente')
ACT(d:fac, 'FechaOp')
ACT(e:fac, 'FechaPrecan')
ACT(f:fac, 'FechaVto')
ACT(g:fac, 'Cantidad')
ACT(h:fac, 'PrecioOp')
ACT(i:fac, 'Resultado')
ACT(j:fac, 'Instancia')
AlinearCeldas(a:fac..j:fac, 'C')
SetFont(a:fac..j:fac, 2)
AgregarMarco(a:fac..j:fac, 0, 0, Exe('COLOR'))

ACN(FI:1, fac+2)
ACN(FI:2, fac+1)

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.Cantidad, O.CB6, O.Precio1, ")
SQL.ADD("        O.PrecioEj, O.ContraEspecie, O.TotalAux1, O.FechaEj, O.FechaVto, ")
SQL.ADD("        Case When O.CB6 = '1' Then O.FechaPrecan Else O.FechaVto End FechaPrecan ")
SQL.ADD("   from "~DBO~".OPERACIONES O ")
SQL.ADD("  Where O.TipoOp IN ('FXOCTC','FXOCTV') ")
IF Dialogo.Radio1 = 0
  SQL.ADD(" and O.CB6 = '1' ")
  SQL.ADD(" and O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" and O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
IF Dialogo.Radio1 = 1
  SQL.ADD(" and O.CB6 <> '1' ")
  SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
IF Dialogo.Radio1 = 2
  SQL.ADD(" and ((O.CB6 = '1' and O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"' and O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"') ")
  SQL.ADD("     or (O.CB6 <> '1' and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"')) ")
endif
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.ContraEspecie2 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" Order By 6, 13 ")

Recorrer SQL
  IF fbn('CB6') <> Val(CB:6) Y Not CeldaVacia(CB:6)
    ACD(FV:1, 0)
    ACN(CB:6, fbn('CB6'))
  endif
  IF fbn('FechaPrecan') <> Val(FV:1)
    IF Val(FV:1) <> 0 O Not CeldaVacia(CB:6)
      SetFont(A:Val(FI:1)..I:fac, 1)
    ELSE
      IFA
    ENDIF
    IF fbn('CB6') = 1
      ACT(a:fac, 'Precanceladas:')
    ELSE
      ACT(a:fac, 'Vencidas:')
    ENDIF
    ACD(b:fac, fbn('FechaPrecan'))
    ACD(FV:1, fbn('FechaPrecan'))
    SetFont(a:fac..b:fac, 2)
    AgregarMarco(a:fac..j:fac, 0, 0, Exe('COLOR10'))
    IFA
    ACN(FI:1, fac)
  endif
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1'))
  ACD(d:fac, fbn('FechaOp'))
  IF fbn('CB6') = 1
    ACD(e:fac, fbn('FechaPrecan'))
  endif
  ACD(f:fac, fbn('FechaVto'))
  ACN(g:fac, fbn('Cantidad'))
  ACN(h:fac, fbn('Precio1'))
  ACN(i:fac, fbn('TotalAux1'))

  SQL.ADD("Select I.Nombre, O.NrBit from "~DBO~".OPERACIONESBITS O, "~DBO~".INSTANCIAS I ")
  SQL.ADD(" where O.NrOperacion = '"~fbn('NrOperacion')~"' ")
  SQL.ADD("   and O.Valor = '1' ")
  SQL.ADD("   and I.NrInstancia = O.NrBit ")
  SQL.ADD("   and I.Tabla = 'OPERACIONES' ")
  SQL.ADD(" order by NrBit ")

  Recorrer SQL
    dfa
    act(j:fac, fbn('Nombre')~' ('~Fstr(fbn('NrBit'),0,0)~')')
    ColorCeldas(j:fac,clBlue)
    Break
  Proximo

  ACN(CB:6, fbn('CB6'))
Proximo
SetFont(a:Val(FI:1)..j:fac, 1)
FormatoCeldas(h:Val(FI:2)..h:fac, Exe('F9'))
FormatoCeldas(i:Val(FI:2)..i:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(a:fac, 'Fin del Informe')
SetFont(a:fac, 2)

ACO(1, 10)
ACO(5, 8)
ACO(7, 10)
ACO(8, 9)
ACO(9, 10)
ACO(10, 10)

LimitesVision(k:fac+1)
