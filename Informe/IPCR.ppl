CrearDialogo
    Fecha1: "Fecha";;;;;;Dialogo.Fecha1 <= fsys; "Fecha no valida";NO;fsys
FinDialogo

if not OK 
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

ACT(a:fac+5, 'Detalle de Cuentas Remuneradas')
SetFont(a:fac+5, 3)

ACT(a:fac+7, 'Fecha del Día: '~Dialogo.Fecha1)
SetFont(a:fac+7, 1)

SetFilaActual(9)
ACN(w1,FAC)

ACT(a:fac, 'Fecha del día')
ACT(b:fac, 'Razón Social')
ACT(c:fac, 'Nro de Cuenta')
ACT(d:fac, 'Moneda')
ACT(e:fac, 'Tasa de la operación')
ACT(f:fac, 'Saldo del día')
ACT(g:fac, 'Saldo acordado')
ACT(h:fac, 'Oficial')
ACT(i:fac, 'Tasa del día')
ACT(j:fac, 'Devengado acumulado')
ACT(k:fac, 'Tasa de Transferencia')
ACT(l:fac, 'Diferencia de Tasas')
ACT(m:fac, 'Código de Tasa')
ACT(n:fac, 'Número de Operación')

*AlinearCeldas(l:FAC..m:FAC,'D')
SetFont(a:9..aa:FAC,1)
AgregarMarco(a:FAC..n:FAC,1,0,Exe('COLOR6'))

SQL.ADD("select C.RazonSocial, Cu.Codigo as CodCue, OP.Cantidad, OP.OficialCuenta, Cu.CodigoTasa, OP.Precio1, OP.Especie, OP.NrOperacion, OP.Precio4, OP.FechaOp, OP.Plazo, OP.TipoTasa ") 
SQL.ADD("from "~dbo~".OPERACIONES OP LEFT JOIN "~dbo~".CLIENTES C ON OP.Cliente1 = C.Codigo JOIN "~dbo~".CUENTAS Cu on OP.Cuenta1 = Cu.Codigo ") 
SQL.ADD("INNER JOIN "~dbo~".OPERACIONESBITS OB ON OP.NrOperacion = OB.NrOperacion AND OB.NrBit in (70,93) AND OB.Valor = 1 ")
SQL.ADD("where OP.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and OP.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' and OP.TipoOp = 'MMCREM'")
*MMCREM, SALDOSREM 

recorrer  SQL
    ACT(a:fac, Dialogo.Fecha1)
    ACT(b:fac, fbn['RazonSocial'])
    ACT(c:fac, fbn['CodCue'])   
    ACT(d:fac, fbn['Especie'])
    
    * Tasa de la operacion
    ACN(e:fac, Round(fbn['Precio1'],6))
    
    *Saldo del día
    &var := SQL("select Count(1) from "~dbo~".SALDOSREM where NrOperacion = '"~FBN['NrOperacion']~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"'")    
    
    if &var > 0
        ACN(f:fac, SQL("select Saldo from "~dbo~".SALDOSREM where NrOperacion = '"~FBN['NrOperacion']~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"'"))
    endif
    
    *Saldo acordado
    ACN(g:fac, fbn['Cantidad'])
    
    ACT(h:fac, fbn['OficialCuenta']~' - '~SQL("Select Descripcion from "~dbo~".OFICIALESCUENTA where Codigo = '"~FBN['OficialCuenta']~"'"))
    
    *tasa base para hoy
    if Eqstr(var('BASEXPILAR'), 'SI')
        ACN(i:fac, Round(SQL("SELECT "~dbo~".ObtenerTasaTransferencia('"~IdxDate(Dialogo.Fecha1)~"', '"~FBN['TipoTasa']~"', '"~FBN['Especie']~"', 1)"),6))
    else
        ACN(i:fac, Round(TASADIA(VAR('TASATRANSF'),FBN['Especie'],Dialogo.Fecha1,FBN['Plazo'],1),6))
    endif
    
    * Devengado acumulado
*    ACN(j:fac, SQL("select SUM(Interes) from "~dbo~".SALDOSREM where NrOperacion = '"~FBN['NrOperacion']~"' and Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'"))
    ACN(j:fac, Round(SQL("select Interes from "~dbo~".SALDOSREM where NrOperacion = '"~FBN['NrOperacion']~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"'"),6))
    
    *Tasa de Transferencia
    ACN(k:fac, Round(fbn['Precio4'],6)) 
     
    * Diferencia de Tasas
    ACN(l:fac,Round(Val(k:fac) - Val(e:fac),6))
    
    ACT(m:fac, fbn['CodigoTasa'])
    
    ACT(n:fac, fbn['NrOperacion']) 
    
proximo

*********************************************
Impresion(2,1)

Impresion(3,1)

ACT(a:fac+2,'Fin del Reporte')
SetFont(a:fac+2, 1)

FormatoCeldas(F:Val(w1)+1..F:fac,Exe('F2'))
FormatoCeldas(L:Val(w1)+1..L:fac,Exe('F2'))

AlinearCeldas(c:Val(w1)+1..c:FAC,'D')
AlinearCeldas(F:Val(w1)+1..F:FAC,'D')

ACO(1, 10)
ACO(2, 30)
ACO(3, 10)
ACO(5, 12)
ACO(6, 18)
ACO(7, 10)
ACO(8, 20)
ACO(9, 10)
ACO(10, 14)
ACO(11, 14)
ACO(12, 12)
ACO(13, 10)
ACO(14, 12)

LimitesVision(o:FAC+2)
