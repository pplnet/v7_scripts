HojaVisible(NO)
IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1: 'Fecha'                ;;;;;;;;;FSys
  Radio1: 'Filtra Book|SI|NO'    ;3;;;;;;;;1;
  ***---Vehiculo1: 'Vehiculo'          ;5;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;BuscarCampo('BOOKS','Vehiculo','Codigo', Dialogo.Book1);;;;IF(NoVacio(Dialogo.Book1)," Codigo IN (Select Vehiculo From .BOOKS Where Codigo = '"~Dialogo.Book1~"') ");
  ***---Book1:  'Book'                 ;6;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O [NoVacio(Dialogo.Book1) Y Eqstr(BuscarCampo('BOOKS','Vehiculo','Codigo', Dialogo.Book1), Dialogo.Vehiculo1)];'Book Invalido';NO;;;;;;IF(NoVacio(Dialogo.Vehiculo1),"Vehiculo = '"~Dialogo.Vehiculo1~"' ");
  Vehiculo1: 'Vehiculo'          ;5;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2: 'Books'                ;6;1;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Lista1: 'Vehiculos'            ;-1;1;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Radio2: 'Expresado en|ARP|USD' ;1;;;;;;;;0
  Radio3: 'Expresado en|Millones|ImporteOri';;;;SI;SI;;;;0;;;;;
FinDialogo

IF Not OK
  Cancelar
ENDIF

IF Dialogo.Radio1 = 0
    LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = Dialogo.Vehiculo1, Lista1 = Dialogo.Lista2, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3)
ELSE
    IF NoVacio(Dialogo.Lista1)
        Recorrer&k 1, Elementos(Dialogo.Lista1)
        LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = ItemLista(Dialogo.Lista1, &k), Lista1 = '', Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3)
        Proximo
    ELSE
        Recorrer&k 1, Elementos(Val(LS:1))
        LinkearHoja('DETINA', 1, Fecha1 = Dialogo.Fecha1, Vehiculo1 = ItemLista(Val(LS:1), &k), Lista1 = '', Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3)
        Proximo
    ENDIF
ENDIF

