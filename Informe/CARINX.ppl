            SCN(TD:1, Val(D:fac))
            SCN(TG:1, Val(G:fac))
            SCN(TH:1, Val(H:fac))
            SCN(TI:1, Val(I:fac))
            SCN(TJ:1, Val(J:fac))
            SCN(TK:1, Val(K:fac))
            SCN(TL:1, Val(L:fac))
            SCN(TM:1, Val(M:fac))
            SetFont(C:fac..M:fac, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            ifa
        ENDIF
    ENDIF
*    ifa
*    ACT(A:fac, 'Otras Inversiones')
*    SetFont(A:fac, 2)
*    AgregarMarco(A:fac..M:fac, 0, 0)
    ***---Plazos Fijos
    (.'CARINV3'.)
    ACN(FI:1, fac+1)
    ACN(BD:4, 0)
    Recorrer SQL
        ACN(BD:4, 1)
        IF Not Eqstr(fbn('Especie'), Val(ES:5))
            IF Not CeldaVacia(ES:5)
                DFA
                ***---Busco los Devengados del Periodo
                SQL.ADD(" Select Sum(Monto) Monto ")
                SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
                SQL.ADD(" Where TipoDevengado = 'INTLEN' ")
                SQL.ADD(" AND NrSaldo = 140 ")
                SQL.ADD(" AND Producto IN ('MMCP','MMCPM') ")
                SQL.ADD(" AND Especie = '"~Val(ES:5)~"' ")
                SQL.ADD(" AND Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
                SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
                SQL.ADD(" AND Vehiculo IN ("~Pipe2Comillas(Val(LV:4))~") ")
                Recorrer SQL
                    DFA
                    ACN(G:fac, fbn('Monto') * Val(CT:1))
                Proximo
                ACN(I:fac, Val(G:fac))
                ***---Capital Expuesto (Cantidad * Dias de Vigencia)
                (.'CARINV7'.)
                ACN(M:fac, Val(M:fac) / Val(DS:1))
                ACN(J:fac, Val(G:fac) / Val(M:fac) * 100)
                ACN(L:fac, Val(J:fac))
                ***---Total Cartera
                SCN(TD:1, Val(D:fac))
                SCN(TG:1, Val(G:fac))
                SCN(TI:1, Val(I:fac))
                SCN(TJ:1, Val(J:fac))
                SCN(TL:1, Val(L:fac))
                SCN(TM:1, Val(M:fac))
                ifa
            ENDIF
            ACT(A:fac, 'Plazo Fijo en '~fbn('Especie'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            AgregarMarco(G:Val(FI:1)..I:fac, 0, 0)
            AgregarMarco(J:Val(FI:1)..L:fac, 0, 0)
            ACN(CT:1, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,Val(MI:1)))
        ELSE
            DFA
        ENDIF
        SCN(D:fac, fbn('Cantidad') * Val(CT:1))
        ***---Sumo los devengados de los PF vigentes
        SQL.ADD(" Select Sum(M.Monto) Monto ")
        SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS M ")
        SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
        SQL.ADD(" AND O.TipoOp = 'MMCP' ")
        SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD(" AND ((O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') OR (O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' AND O.RB4 Is Null)) ")
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~") ")
        SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        ***---SQL.ADD(" AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" Group By O.NrOperacion ")
        SQL.ADD(" UNION ")
        SQL.ADD(" Select Sum(M.Monto) Monto ")
        SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".MOVDEVENGADOS M ")
        SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
        SQL.ADD(" AND O.NrOperacion = M.NrOperacion ")
        SQL.ADD(" AND O.TipoOp = 'MMCPM' ")
        SQL.ADD(" AND ((C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"') OR (C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND O.RB4 Is Null)) ")
        SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")
        SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        ****---SQL.ADD(" AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND O.NrOperacion = '"~fbn('NrOperacion')~"' ")
        SQL.ADD(" Group By O.NrOperacion ")
        Recorrer SQL
            DFA
            SCN(D:fac, fbn('Monto') * Val(CT:1))
        Proximo
        ACT(ES:5, fbn('Especie'))
    Proximo
    IF Val(BD:4) = 1
        ***---Busco los Devengados del Periodo
        SQL.ADD(" Select Sum(Monto) Monto ")
        SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
        SQL.ADD(" Where TipoDevengado = 'INTLEN' ")
        SQL.ADD(" AND NrSaldo = 140 ")
        SQL.ADD(" AND Producto IN ('MMCP','MMCPM') ")
        SQL.ADD(" AND Especie = '"~Val(ES:5)~"' ")
        SQL.ADD(" AND Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD(" AND Vehiculo IN ("~Pipe2Comillas(Val(LV:4))~") ")
        Recorrer SQL
            DFA
            ACN(G:fac, fbn('Monto') * Val(CT:1))
        Proximo
        ACN(I:fac, Val(G:fac))
        ***---Capital Expuesto (Cantidad * Dias de Vigencia)
        (.'CARINV7'.)
        ACN(M:fac, Val(M:fac) / Val(DS:1))
        ACN(J:fac, Val(G:fac) / Val(M:fac) * 100)
        ACN(L:fac, Val(J:fac))
        ***---Total Cartera
        SCN(TD:1, Val(D:fac))
        SCN(TG:1, Val(G:fac))
        SCN(TI:1, Val(I:fac))
        SCN(TJ:1, Val(J:fac))
        SCN(TL:1, Val(L:fac))
        SCN(TM:1, Val(M:fac))
    ENDIF
    SetFont(A:Val(FI:1)..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    IF Val(BD:4) = 1
        ifa
    ENDIF
    ***---FCI Moneda
    ACN(TP:1, 6)
    ACT(AL:2, '0')
    (.'CARINV1'.)
    ACN(BD:1, 0)
    ACN(BD:2, 0)
    ACT(CZ:1, '')
    Recorrer SQL
        (.'CARINV2'.)
        ACN(BD:1, 1)
        IF Val(BD:2) = 1
            DFA
        ENDIF
    Proximo
    IF Val(BD:1) = 1
        SetFont(A:Val(FI:1)..M:fac, 1)
        FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
        FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
        FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
        FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
        FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
        ifa
        IF Not CeldaVacia(CZ:1)
            SetFont(A:Val(FI:1)..M:fac, 1)
            ifa
            ACT(C:fac, 'Total')
            AgregarMarco(G:Val(FI:1)..I:fac, 0, 0)
            AgregarMarco(J:Val(FI:1)..L:fac, 0, 0)
            ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
            ACN(G:fac, Sum(G:Val(FI:1)..G:fac-1))
            ACN(H:fac, Sum(H:Val(FI:1)..H:fac-1))
            ACN(I:fac, Sum(I:Val(FI:1)..I:fac-1))
            ACN(J:fac, Sum(J:Val(FI:1)..J:fac-1))
            ACN(K:fac, Sum(K:Val(FI:1)..K:fac-1))
            ACN(L:fac, Sum(L:Val(FI:1)..L:fac-1))
            ACN(M:fac, Sum(M:Val(FI:1)..M:fac-1))
            ***---Total Cartera
            SCN(TD:1, Val(D:fac))
            SCN(TG:1, Val(G:fac))
            SCN(TH:1, Val(H:fac))
            SCN(TI:1, Val(I:fac))
            SCN(TJ:1, Val(J:fac))
            SCN(TK:1, Val(K:fac))
            SCN(TL:1, Val(L:fac))
            SCN(TM:1, Val(M:fac))
            SetFont(C:fac..M:fac, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            ifa
        ENDIF
    ENDIF
    IF Dialogo.Radio2 = 0
        ACT(A:fac, 'Total Cartera')
    ELSE
        ACT(A:fac, 'Total Cartera '~Val(LV:4))
    ENDIF
    ACN(D:fac, Val(TD:1))
    ACN(G:fac, Val(TG:1))
    ACN(H:fac, Val(TH:1))
    ACN(I:fac, Val(TI:1))
    ACN(J:fac, Val(TJ:1))
    ACN(K:fac, Val(TK:1))
    ACN(L:fac, Val(TL:1))
    ACN(M:fac, Val(TM:1))
    SCN(TD:2, Val(TD:1))
    SCN(TG:2, Val(TG:1))
    SCN(TH:2, Val(TH:1))
    SCN(TI:2, Val(TI:1))
    SCN(TJ:2, Val(TJ:1))
    SCN(TK:2, Val(TK:1))
    SCN(TL:2, Val(TL:1))
    SCN(TM:2, Val(TM:1))
    SetFont(A:fac..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR'))
    AgregarMarco(G:fac..I:fac, 0, 0)
    AgregarMarco(J:fac..L:fac, 0, 0)
Proximo
IF Dialogo.Radio2 = 1
    SetFilaActual(fac+2)
    ACT(A:fac, 'Total Cartera General')
    ACN(D:fac, Val(TD:2))
    ACN(G:fac, Val(TG:2))
    ACN(H:fac, Val(TH:2))
    ACN(I:fac, Val(TI:2))
    ACN(J:fac, Val(TJ:2))
    ACN(K:fac, Val(TK:2))
    ACN(L:fac, Val(TL:2))
    ACN(M:fac, Val(TM:2))
    SetFont(A:fac..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR'))
    AgregarMarco(G:fac..I:fac, 0, 0)
    AgregarMarco(J:fac..L:fac, 0, 0)
ENDIF
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

