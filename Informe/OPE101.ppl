If Incluido(Dialogo.TipoOp1,'MMCDP') 
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.Especie, O.FechaOp, O.FechaOp2, O.Vehiculo1, O.Cantidad, O.Plazo, ")
