ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo2  : "Grupo"     ;;;;Vacio(Dialogo.Vehiculo1);NO;;'Debe ingresar un Grupo';NO;;;;;;"TipoVehiculo <> 'DIV'";
   Vehiculo1  : "Vehiculo"  ;;;;Vacio(Dialogo.Vehiculo2);;[EsTerminal(Dialogo.Vehiculo1, Vehiculos) y EqStr(BuscarCampo('VEHICULOS', 'TipoVehiculo', 'Codigo',Dialogo.Vehiculo1),'DIV')] o Vacio(Dialogo.Vehiculo1); 'Vehiculo invalido';NO;;;;;;"TipoVehiculo = 'DIV'";;
   Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
   TipoOp1    : "Tipo Op."     ;;;;;;NoVacio(Dialogo.TipoOp1);'Debe Ingresar un Tipo de Operacion';NO;
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Endif

ACN(co:50,ASCII('s')-96)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)


SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Cartera de Operaciones Financieras Vigentes")
SetFont(a:fac..a:fac,3)

SetFilaActual(4)


*if NoVacio (Dialogo.Vehiculo2)
   *ACT(a:FAC+1, 'Grupo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
*else
   *ACT(a:FAC+1, 'Grupo : Todos')
*endIf


if NoVacio (Dialogo.Vehiculo1)
   ACT(a:FAC+2, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+2, 'Vehiculo : Todos')
endIf


ACT(a:FAC+3, 'Fecha : '~Dialogo.Fecha1)

If EqStr(Copy(Dialogo.TipoOp1,1,2),'MM')
   *** operaciones money markets ****
   ACT(a:FAC+4, 'Money Markets') 
Endif
If Incluido(Dialogo.TipoOp1,'FCR|FCS')
   *** operaciones fondos ****
   ACT(a:FAC+4, 'Fondos')
Endif
If Incluido(Dialogo.TipoOp1,'GA|GAMV')
   *** operaciones garantias ****
   ACT(a:FAC+4, 'Garantias')
Endif
If Incluido(Dialogo.TipoOp1,'CC|CCMV')
   *** operaciones cartas de credito ****
   ACT(a:FAC+4, 'Cartas de Credito')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'SE')
   *** securities ****
   ACT(a:FAC+4, 'Securities')
Endif
If Incluido(Dialogo.TipoOp1,'DFXO|DSEO')
   *** operaciones derivados fx y sec ****
   ACT(a:FAC+4, 'Derivados FX & SEC')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'DT')
   ACT(a:FAC+4, 'Derivados de Tasas')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'DC')
   ACT(a:FAC+4, 'Derivados Comm.')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'FX')
   ACT(a:FAC+4, 'Foreing Exchange')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'TE')
   ACT(a:FAC+4, 'TERCEROS')
Endif
ACT(a:FAC+5, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
SetFont(a:fac..N:FAC+5,2)

ACN(ZZ:99,0)

SetFilaActual(FAC+7)

If Incluido(Dialogo.TipoOp1,'MMDC|MMDCA|MMCCR|MMCP|MMCPR|MMCPRV|MMCPV|')
   SCN(zz:99,1)
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.TipoOp2, O.FechaOp2, O.FechaOp, O.Vehiculo1, O.Vehiculo2, O.Especie, ")
   SQL.ADD(" O.Cantidad, O.Plazo, O.Plazo2, O.FechaVto, O.FechaVto2, O.FechaPago, O.TipoTasa, O.Precio1, O.Spread, O.MB3, ")
   SQL.ADD(" O.TotalIntereses, O.TotalRetenciones, O.TotalAux1, O.ImpGastos1, O.Precio4, O.TotalNetoCli1, O.TotalBrutoCli1,")
   SQL.ADD(" O.RB8, O.Cliente1, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, C.Cantidad4, C.Cantidad5, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio3 Pr3, C.Cantidad2, C.Total1, C.Total2, C.Precio4 Pr4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion *= C.NrOperacion  ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MMCPM|MMCPVM|MMCPMG')
   SCN(zz:99,1)
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.FechaOp2, O.Vehiculo1, O.Vehiculo2, O.Especie, O.Cantidad, O.TipoTasa, ")
   SQL.ADD(" O.Spread, O.Cliente1, O.ImpGastos1, O.RB8, ") 
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, C.Cantidad4, C.Cantidad5, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio3 Pr3, C.Cantidad2, C.Total1, C.Total2, C.Precio4 Pr4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'FCR|FCS')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp2, O.FechaOp, O.Cliente1, O.Especie, O. ContraEspecie, O.FechaVto, ")
   SQL.ADD(" O.Cantidad, O.TotalNetoCli1 ")
