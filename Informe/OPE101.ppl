(.'SECURVIG'.)

If Incluido(Dialogo.TipoOp1,'DFXO|DSEO')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.Cliente1, O.TipoOp, O.MB3, O.MB1, O.RB10, O.CB9, O.TipoOpcion, O.Especie, ")
   SQL.ADD(" O.PrecioEj, O.PrecioRef, O.FechaOp2, O.Plazo, O.FechaEj, O.FechaPago, O.Cupon1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
