If Incluido(Dialogo.TipoOp1,'DTO|DTOV|DTSFV|DTSFF|DTSVV||DTSFVV') 
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp2, O.Vehiculo1, O.MB3, O.MB1, O.TipoOpcion, O.RB8, O.Cliente1,  ")
   SQL.ADD(" O.Especie, O.RB9, O.TipoTasa, O.PrecioEj, O.Precio3, O.Spread, O.Cantidad, O.FechaOp2, O.Plazo, O.FechaEj, ")
   SQL.ADD(" O.FechaEx1, O.FechaEx2, O.Precio4, O.FechaPago, O.PrecioRef2, O.TipoTasa, O.TotalIntereses, O.TotalAux3, ")
   SQL.ADD(" O.TotalAux4, O.ContraEspecie, O.TotalBrutoCli1, O.RB5, O.PrecioRef3, O.TipoTasa2, O.TotalGanancias, ")
   SQL.ADD(" O.TotalNetoCli2, O.InteresesCorr, O.TotalBrutoCli2, O.TotalBrutoCli3, O.Plazo2, ")
   SQL.ADD("       C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1 Pl1, C.Fecha3, C.Fecha5, C.Fecha6, C.Fecha7, C.Plazo2 Pl2,  ")
   SQL.ADD("       C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad4, C.Cantidad5, C.Cantidad6, ")
   SQL.ADD("       C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Total1, C.Total3, C.Total4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DTC|DTF|DTK|DTKVI|DTOM|DTOMV|DTSFFM|DTSFVM|DTSFVX|DTSNFF|DTSNFV|DTSNVV|DTSVVM|DTCAP|DTFLO')
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.FechaOp, O.Vehiculo1, O.MB3, O.MB1, O.TipoOpcion, O.RB8, O.Cliente1, ")
   SQL.ADD(" O.Especie, O.TipoTasa, O.Spread, O.FechaOp2, O.Plazo, O.FechaEj, O.Cantidad, O.Vehiculo2, O.RB7, O.PrecioRef2, ")
   SQL.ADD(" O.FechaEx1, O.ContraEspecie, O.RB5, O.PrecioRef3, O.TipoTasa2, O.FechaEx2, O.TotalAux3, O.TotalAux4, O.RB9, ")
   SQL.ADD(" O.TotalBrutoCli2, O.TotalBrutoCli3, ")
   SQL.ADD("       C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1 Pl1, C.Fecha3, C.Fecha5, C.Fecha6, C.Fecha7, C.Plazo2 Pl2,  ")
   SQL.ADD("       C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad4, C.Cantidad5, C.Cantidad6, ")
   SQL.ADD("       C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Total1, C.Total3, C.Total4, ")
   SQL.ADD("       C.Tasa1 Ts1, C.Total2, C.Fecha4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MRO|MRF') 
   SCN(zz:99,1)
   SQL.ADD("Select O.NrOperacion, O.TipoOp, O.MB3, O.FechaCargaSys, O.FechaOp, O.FechaEx4, O.Vehiculo1, O.Cliente1, ")
   SQL.ADD(" O.Contrato, O.Especie, O.Cantidad, O.TotalAux1, O.Precio1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaEx4 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   If NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.MB3, O.Especie, O.NrOperacion ")
EndIf

