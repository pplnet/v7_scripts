CrearDialogo
  Fecha1     : "Fecha Vigencia"    ;;;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Fecha2     : "Fecha Desde"       ;;;;;;[Dialogo.Fecha2 = Dialogo.Fecha1] O [Dialogo.Fecha2 = PriDeMes(Dialogo.Fecha2, NO, 'ARG') Y Dialogo.Fecha2 >= Dialogo.Fecha1];'Fecha Desde Invalida';NO;Fsys;
  Fecha3     : "Fecha Hasta"       ;;;;;;[Dialogo.Fecha3 >= Dialogo.Fecha2 Y Dialogo.Fecha3 = FinDeMes(Dialogo.Fecha3, NO, 'ARG')];'Fecha Hasta Invalida';NO;FinDeMes(Fsys, NO, 'ARG');
  Especie1   : "Especie"           ;1;2;;;;;;;;;;;
  Cliente1   : "Entidad"           ;2;2;;;;;;;;;;;
  Radio1     : "Expresado|ARP|USD" ;3;2;;;;;;;1
  Radio2     : "Consolidado|NO|SI" ;4;2;;;;;;;0
  Lista2     : 'Tipo Op.'          ;5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' Order By Codigo ");
  Lista1     : "Vehiculo"          ;-1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

ACT(LS:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))

SetFilaActual(2)

ACT(a:FAC, 'Anticuacion de Deudas Vigentes al '~Dialogo.Fecha1~' - Detalle Operaciones con Swaps')
SetFont(a:fac..a:fac,3)

***---Expresado en Miles
ACN(IM:2, 1000)

SetFilaActual(3)

ACT(A:fac+1, 'Fecha Desde: '~Dialogo.Fecha2)
ACT(D:FAC+1, 'Tipo Op.: '~Dialogo.Lista2)
ACT(A:fac+2, 'Fecha Hasta: '~Dialogo.Fecha3)
ACT(a:FAC+3, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
ACT(D:FAC+4, 'Vehiculos : '~Dialogo.Lista1)
ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
act(D:fac+2,'Expresado en Miles de '~IIF(Dialogo.Radio1=0, Var('MONELOCA'), Var('MONEEXTR')))
SetFont(a:fac..N:FAC+4, 2)
SetFilaActual(FAC+6)

ACT(a:FAC, 'Fecha Op.')
ACT(b:FAC, 'Plazo')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Importe')
ACT(F:FAC, 'Fecha Vto.')
ACT(G:FAC, 'Tipo Op.')
ACT(H:FAC, 'Numero Op.')
ACT(I:FAC, 'Cliente')

AgregarMarco(a:FAC..I:FAC,2,0,Exe('COLOR6'))

SetFont(a:FAC..J:FAC,2)

***---MV:1 se usa para compratir las funciones con informe Caida de Deudas
ACN(MV:1, 1)

(.'CAIDA8A'.)
SQL.ADD(" UNION ")
(.'CAIDA8AS'.)

IF Dialogo.Radio2 = 0
    SQL.ADD(" Order By 1, 18, 11, 5 ")
ELSE
    SQL.ADD(" Order By 18, 11, 5 ")
ENDIF

ACN(CX:1, CotizacionC(Var('MONELOCA'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
ACN(CX:2, CotizacionC(Var('MONEEXTR'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
ACN(TO:1, 0)
ACN(FI:1, fac+1)
Recorrer SQL
    IF Dialogo.Radio1 = 0
        ***---Expresado en $
        IF Eqstr(fbn('Especie'), Var('MONELOCA'))
            ACN(IM:1, fbn('Importe') / Val(IM:2))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CX:2))
            ELSE
                ACN(CX:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CX:3))
            ENDIF
        ENDIF
    ELSE
        ***---Expresado en U$S
        IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
            ACN(IM:1, fbn('Importe') / Val(IM:2))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONELOCA'))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CX:1))
            ELSE
                ACN(CX:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
                ACN(IM:1, fbn('Importe') / Val(IM:2) * Val(CX:3))
            ENDIF
        ENDIF
    ENDIF
    ACD(A:fac, fbn('FechaOp'))
    ACN(B:fac, fbn('FechaVto') - Dialogo.Fecha1)
    ACT(C:fac, fbn('Clave'))
    ACT(D:fac, fbn('Especie'))
    ACN(E:fac, Val(IM:1)/Val(EX:1))
    SCN(TO:1, Val(E:fac))
    ACD(F:fac, fbn('Fin'))
    ACT(G:fac, fbn('TipoOp'))
    IF Incluido(fbn('Tipo'), 'SWAP')
        ACT(H:fac, fbn('OperacionRef'))
        ACLO(H:fac, fbn('OperacionRef'))
    ELSE
        ACT(H:fac, fbn('NrOperacion'))
        ACLO(H:fac, fbn('NrOperacion'))
    ENDIF
    ACT(I:fac, fbn('Cliente1'))
Proximo

SetFont(A:Val(FI:1)..J:fac, 1)
AgregarMarco(A:Val(FI:1)..I:fac, 2, 0)

FormatoCeldas(B:Val(FI:1)..B:fac, Exe('F0'))
ifa
ACT(A:fac, 'TOTAL')
ACN(E:fac, Val(TO:1))
SetFont(A:fac..E:fac, 2)
FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F2'))
AgregarMarco(A:fac..I:fac, 2, 0,Exe('COLOR6'))

SetFilaActual(fac+2)
ACT(A:fac, 'FIN DEL LISTADO')
SetFont(A:fac, 2)
LimitesVision(K:fac+1)