HojaVisible(SI)

ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo


if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


ACT(a1, 'Registro de Capturas Datanet')
SetFont(A:1, 3)
SetFilaActual(fac+3)


ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)


SetFilaActual(fac+4)

ACT(a:fac,'Nro.Datanet')
ACT(B:fac,'Fec.Bajada')
ACT(C:fac,'Archivo')
ACT(D:fac,'Fec.Desde')
ACT(E:fac,'Fec.Hasta')
ACT(F:fac,'Usuario')
ACT(G:fac,'Estado')
ACT(H:fac,'Aprobacion')
ACT(I:fac,'Fec.Aprob')
ACT(J:fac,'Supervisor')


AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
Setfont(a2..j:fac, 1)
AlinearCeldas(A:fac..j:fac, 'C')

SQL.ADD(" Select  * from "~DBO~".DATANET ")
SQL.ADD(" Where FechaBajada >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and FechaBajada <= '"~IdxDate(Dialogo.Fecha2)~"' ")


SQL.ADD("order by FechaBajada, Archivo")

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
Recorrer SQL

    ACT(a:fac,FBN['NrDatanet'])
    ACt(B:fac, fbn('FechaBajada'))
    ACT(C:fac,FBN['Archivo'])
    ACT(D:fac,FBN['FechaDesde'])
    ACT(E:fac,FBN['FechaHasta'])
    ACT(F:fac,FBN['Usuario'])
    ACT(G:fac, fbn('Estado'))
    ACT(H:fac, fbn('EstadoAprobacion'))
    ACT(I:fac, fbn('FechaAprobacion'))
    ACt(J:fac,FBN['Supervisor'])

    SetFont(a:fac..j:fac, 2)
Proximo
FormatoCeldas(K:Val(FI:1)..K:fac, Exe('F8'))

Ifa
Ifa
AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
SetFont(a:fac..j:fac, 1)

********************************************
*  Cant. Mov. Capturados por Fecha Ingreso
********************************************

SetFilaActual(fac+4)

ACT(a:fac,'Nro.Datanet')
ACT(B:fac,'Fec.Ingreso')
ACT(C:fac,'Fec.Acredit.')
ACT(D:fac,'Cant.Mov.')
ACT(E:fac,'Fec.Bajada')
ACT(F:fac,'Archivo')


AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
Setfont(a2..j:fac, 1)
AlinearCeldas(A:fac..j:fac, 'C')

SQL.ADD(" Select  m.nrdatanet, m.fechaingreso, count(*) cantidad,  ")
SQL.ADD("        m.fechaacreditacion, d.fechabajada, d.archivo  ")
SQL.ADD("             from "~DBO~".movdatanet M, "~DBO~".datanet D  ")
SQL.ADD(" Where m.nrdatanet = d.nrdatanet ")
SQL.ADD("   and d.FechaBajada >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and d.FechaBajada <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" group by m.nrdatanet, d.FechaBajada, m.fechaingreso, m.fechaacreditacion, d.archivo")
SQL.ADD("order by m.nrdatanet, d.FechaBajada, m.fechaingreso, m.fechaacreditacion")

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
Recorrer SQL

    ACT(a:fac,FBN['NrDatanet'])
    ACt(B:fac, fbn('FechaIngreso'))
    ACt(C:fac, fbn('FechaAcreditacion'))
    ACT(D:fac,FBN['Cantidad'])
    ACt(E:fac, fbn('FechaBajada'))
    ACT(F:fac,FBN['Archivo'])

    SetFont(a:fac..j:fac, 2)
Proximo
FormatoCeldas(K:Val(FI:1)..K:fac, Exe('F8'))

Ifa
Ifa
AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
SetFont(a:fac..j:fac, 1)

***************************************************


act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)

FormatoCeldas(J:1..J:fac, Exe('F2'))
FormatoCeldas(L:1..L:fac, Exe('F2'))
FormatoCeldas(B:1..B:fac, Exe('F0'))
LimitesVision(j:fac+1)
ACO(2, 6)
ACO(4, 6)
ACO(5, 6)
ACO(6, 10)
ACO(7, 5)
ACO(8, 5)
ACO(9, 6)
ACO(10, 8)
ACO(11, 5)
ACO(12, 8)
SetPrintFit(3, 75)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(u:FAC)
RangoTitulo(a:1..j:FAC, 7)
