ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1 : 'Empresa'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
  Fecha1    : 'Fecha'      ;;;;;;Dialogo.Fecha1>0;;;FSys
  Check1    : 'C/Intereses';
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,7,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites - Lineas de Credito Off-Shore Empresa')
ACT(a:FAC+2, 'Empresa:')
ACT(b:FAC+2, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
ACT(a:FAC+3, 'Fecha: '~Dialogo.Fecha1)
if Dialogo.Check1=1
  ACT(a:FAC+4, 'Con Intereses Devengados')
endif
SetFont(a:FAC..a:FAC+4,2)

ACT(z1, Descendientes('Vehiculos', Dialogo.Vehiculo1))
if Vacio(Val(z1))
  ACT(z2, "'"~Dialogo.Vehiculo1~"'")
else
  ACT(z2, "'"~Dialogo.Vehiculo1~"',"~Pipe2Comillas(Val(z1)))
endif
ACT(z3, Descendientes('Clientes', 'BANCOS'))
ACT(z4, Pipe2Comillas(Val(z3)))

SetFilaActual(FAC+6)

ACT(d:FAC, 'Lineas de Credito Otorgadas')
ACT(h:FAC, 'Utilizacion')
ACT(n:FAC, 'Lineas de Credito Disponibles')
ACT(q:FAC, 'L. Grupo Off-Shore')

ACT(a:FAC+1, 'Bancos')

ACT(b:FAC+1, 'Linea de')
ACT(b:FAC+2, 'Cred.Total')
ACT(c:FAC+1, 'Linea')
ACT(c:FAC+2, 'Clean')
ACT(d:FAC+1, 'Linea')
ACT(d:FAC+2, 'Garantias')
ACT(e:FAC+1, 'Linea')
ACT(e:FAC+2, 'Trade')
ACT(f:FAC+1, 'Linea')
ACT(f:FAC+2, 'Prestamos')

ACT(g:FAC+1, 'Garantias')
ACT(h:FAC+1, 'Trade')
ACT(i:FAC+1, 'Prestamos')
ACT(j:FAC+1, 'TOTAL')
ACT(j:FAC+2, 'UTILIZADO')

ACT(k:FAC+1, 'Vinculadas')

ACT(l:FAC+1, 'Disponible')
ACT(l:FAC+2, 'Total')
ACT(m:FAC+1, 'Disponible')
ACT(m:FAC+2, 'Clean')
ACT(n:FAC+1, 'Disponible')
ACT(n:FAC+2, 'Garantias')
ACT(o:FAC+1, 'Disponible')
ACT(o:FAC+2, 'Trade')
ACT(p:FAC+1, 'Disponible')
ACT(p:FAC+2, 'Prestamos')

ACT(q:FAC+1, 'Capacidad')
ACT(q:FAC+2, 'Prestable')
ACT(r:FAC+1, 'Capacidad')
ACT(r:FAC+2, 'Disponible')

*ACT(s:FAC+1, 'Observaciones')

ACT(aa:FAC+1, 'AA')
ACT(ab:FAC+1, 'AB')
ACT(ac:FAC+1, 'AC')
ACT(ad:FAC+1, 'AD')
ACT(ae:FAC+1, 'AE')
ACT(af:FAC+1, 'AF')
ACT(ag:FAC+1, 'AG')
ACT(ah:FAC+1, 'AH')
ACT(ai:FAC+1, 'AI')
ACT(aj:FAC+1, 'AJ')
ACT(ak:FAC+1, 'AK')
ACT(al:FAC+1, 'AL')
ACT(am:FAC+1, 'AM')
ACT(an:FAC+1, 'AN')
ACT(ao:FAC+1, 'AO')
ACT(ap:FAC+1, 'AP')
ACT(aq:FAC+1, 'AQ')
ACT(ar:FAC+1, 'AR')
ACT(as:FAC+1, 'AS')
ACT(at:FAC+1, 'AT')

ACT(ba:FAC+1, 'BA')
ACT(bb:FAC+1, 'BB')
ACT(bc:FAC+1, 'BC')
ACT(bd:FAC+1, 'BD')
ACT(be:FAC+1, 'BE')
ACT(bf:FAC+1, 'BF')
ACT(bg:FAC+1, 'BG')
ACT(bh:FAC+1, 'BH')
ACT(bi:FAC+1, 'BI')
ACT(bj:FAC+1, 'BJ')
ACT(bk:FAC+1, 'BK')
ACT(bl:FAC+1, 'BL')
ACT(bm:FAC+1, 'BM')
ACT(bn:FAC+1, 'BN')
ACT(bo:FAC+1, 'BO')
ACT(bp:FAC+1, 'BP')
ACT(bq:FAC+1, 'BQ')
ACT(br:FAC+1, 'BR')

SetFont(a:FAC..s:FAC+2,3)
AlinearCeldas(a:FAC..s:FAC+2,'C')
AlinearCeldas(q:FAC,'I')
AgregarMarco(b:FAC..f:FAC,1,0,Exe('COLOR'))
AgregarMarco(g:FAC..j:FAC,1,0,Exe('COLOR'))
AgregarMarco(l:FAC..p:FAC,1,0,Exe('COLOR'))
AgregarMarco(q:FAC..r:FAC,1,0,Exe('COLOR'))
AgregarMarco(a:FAC+1..j:FAC+2,1,2,Exe('COLOR'))
AgregarMarco(k:FAC..k:FAC+2,1,0,Exe('COLOR'))
AgregarMarco(l:FAC+1..r:FAC+2,1,2,Exe('COLOR'))
*AgregarMarco(s:FAC..s:FAC+2,1,0,Exe('COLOR'))

SetFilaActual(FAC+2)
ACN(y1,FAC)
SQL.ADD("Select * from "~DBO~".LIMASIGNADOS where Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and Limite in ('ACLTOT','ACLGAR','ACLTRA','ACLPRE','ACOTOT','ACOGAR','ACOTRA','ACOPRE')")
SQL.ADD("order by Cliente")
recorrer SQL
  if EqStr(FBN['Cliente'],Val(w:FAC-1))
    DFA
  else
    if NoVacio(Val(w:FAC-1))
      DFA
      if Val(x3)=1
        ACT(t:FAC, 'Local')
        if Val(x4)=1
          ACT(u:FAC, 'C/Suc.')
          if Val(b:FAC)=0
            if Val(ab:FAC)>0
              ACN(b:FAC, Val(ab:FAC))
            endif
          endif
          if Val(d:FAC)=0
            if Val(ad:FAC)>0
              ACN(d:FAC, Val(ad:FAC))
            endif
          endif
          if Val(e:FAC)=0
            if Val(ae:FAC)>0
              ACN(e:FAC, Val(ae:FAC))
            endif
          endif
          if Val(f:FAC)=0
            if Val(af:FAC)>0
              ACN(f:FAC, Val(af:FAC))
            endif
          endif
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      else
        ACT(t:FAC, 'Exterior')
        if Val(x1)=1
          ACT(u:FAC, 'C/Suc.')
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      endif
      ACN(q:FAC, 0)
      ACN(q:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACOTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      ACN(aq:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACLTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      if Val(q:FAC)=0
        if Val(aq:FAC)>0
          ACN(q:FAC, Val(aq:FAC))
        endif
      endif
      if Val(b:FAC)>Val(d:FAC)+Val(e:FAC)+Val(f:FAC)
        ACN(c:FAC, Val(b:FAC)-(Val(d:FAC)+Val(e:FAC)+Val(f:FAC)))
      endif
      (.'DISPEMPRE'.)
      if Val(b:FAC)=0 y Val(j:FAC)=0
        BorrarCeldas(a:FAC..bz:FAC)
      else
        IFA
      endif
    endif
    ACN(x1,0)
    ACN(x2,0)
    ACN(x3,0)
    ACN(x4,0)
    if DesciendeDeCliente(FBN['Cliente'],'BLOCAL')
      ACN(x3,1)
      if EqStr(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Cliente']),'ARG') o Vacio(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Cliente']))
        ACN(x1, 1)
        if BuscarCampo('CLIENTES','RPC','Codigo',FBN['Cliente'])>0
          ACN(x2, BuscarCampo('CLIENTES','RPC','Codigo',FBN['Cliente'])/1000)
        else
          ACN(x2, BuscarCampo('CLIENTES','Patrimonio','Codigo',FBN['Cliente'])/1000*0.15)
        endif
      endif
      SQL.ADD("Select Codigo from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~FBN['Cliente']~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and PaisDir <> 'ARG' ")
      SQL.ADD("and PaisDir is Not Null ")
      recorrer SQL
        DFA
        ACN(x4, 1)
      proximo
    else
      SQL.ADD("Select Codigo, Patrimonio, FechaBal, RPC from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~FBN['Cliente']~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null) ")
      recorrer SQL
        DFA
        ACN(x1, 1)
        if FBN['RPC']>0
          ACN(x2, FBN['RPC']/1000)
        else
          ACN(x2, FBN['Patrimonio']/1000*0.15)
        endif
      proximo
    endif
    ACT(w:FAC, FBN['Cliente'])
    ACT(x:FAC, SQL("Select Controlante from "~DBO~".GRUPOSECONOMICOS where Cliente = '"~Val(w:FAC)~"' and TipoGrupo = 'BANCA' "))
    if Vacio(Val(x:FAC))
      ACT(a:FAC, FBN['Cliente'])
    else
      ACT(a:FAC, Copy(BuscarCampo('CONTROLANTES','RazonSocial','Codigo',Val(x:FAC)),1,25))
    endif
    SQL.ADD("Select TipoOp, Especie, Cantidad, PaisDir, Vehiculo1, TotalIntereses, Plazo, FechaOp, NrOperacion, PrecioEj from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
    if Vacio(Val(x:FAC))
      SQL.ADD("where Cliente1 = '"~Val(w:FAC)~"' ")
    else
      SQL.ADD("where Cliente1 in (Select Cliente from "~DBO~".GRUPOSECONOMICOS where Controlante = '"~Val(x:FAC)~"' and TipoGrupo = 'BANCA' ) ")
    endif
    SQL.ADD("and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
*    SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
*    SQL.ADD("and TipoOp in ('MMPCL','MMPCLM','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','CC','CCMV','GA','GAMV') ")
    SQL.ADD("and (")
    SQL.ADD("(TipoOp in ('MMPCL','MMPCLM','MMPLME','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','MMFRNP','MMFIMV','MMPSI','MMSIMV') ")
    SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') ")
    SQL.ADD("or (TipoOp in ('GA','GAMV','CC','CCMV') ")
    SQL.ADD("and FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"') ")
    SQL.ADD(") ")
    SQL.ADD("and Codigo = Cliente1 ")
    SQL.ADD("and Codigo in ("~Val(z4)~") ")
    recorrer SQL
      ACN(y3,0)
      DFA
      if Incluido(FBN['TipoOp'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
        if Incluido(FBN['TipoOp'],'MMPCLM|MMPOSM|MMPIM|MMPEM|MMFIMV|MMSIMV')
          SQL.ADD("Select Cantidad2 from "~DBO~".CUOTAS ")
          SQL.ADD("where NrOperacion =  '"~FBN['NrOperacion']~"' ")
          SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
          recorrer SQL
            DFA
            ACN(y3, FBN['Cantidad2']/1000)
          proximo
        else
          SQL.ADD("Select Cantidad1 from "~DBO~".CUOTAS ")
          SQL.ADD("where NrOperacion =  '"~FBN['NrOperacion']~"' ")
          SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
          SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
          recorrer SQL
            DFA
            ACN(y3, FBN['Cantidad1']/1000)
          proximo
        endif
      else
        if Incluido(FBN['TipoOp'],'MMPLME|GA|CC|MMFRNP|MMPSI')
          ACN(y3, FBN['Cantidad']/1000)
        else
          ACN(y3, FBN['PrecioEj']/1000)
        endif
      endif
      if Dialogo.Check1=1
        if Incluido(FBN['TipoOp'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
          SQL.ADD("Select Cantidad3,Fecha1,Fecha2,Plazo1 from "~DBO~".CUOTAS ")
          SQL.ADD("where NrOperacion =  '"~FBN['NrOperacion']~"' ")
          SQL.ADD("and Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' ")
          recorrer SQL
            DFA
            if FBN['Fecha2']<Dialogo.Fecha1
              SCN(y3, FBN['Cantidad3']/1000)
            else
              SCN(y3, (FBN['Cantidad3']/FBN['Plazo1']*(Dialogo.Fecha1-FBN['Fecha1']))/1000)
            endif
          proximo
        else
          SCN(y3, (FBN['TotalIntereses']/FBN['Plazo']*(Dialogo.Fecha1-FBN['FechaOp']))/1000)
        endif
      endif
      ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['FechaOp'],1,SI,'USD'))
      if Incluido(FBN['Vehiculo1'],Val(z1)) o EqStr(FBN['Vehiculo1'],Dialogo.Vehiculo1)
        if Incluido(FBN['TipoOp'],'MMPCOS|MMPOSM')
          SCN(i:FAC, Val(y3))
        endif
        if Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPLME')
          SCN(ai:FAC, Val(y3))
        endif
        if Incluido(FBN['TipoOp'],'GA|GAMV|CC|CCMV|MMPI|MMPIM|MMPE|MMPEM|MMFRNP|MMFIMV|MMPSI|MMSIMV')
          if EqStr(FBN['PaisDir'],'ARG') o Vacio(FBN['PaisDir'])
            if Incluido(FBN['TipoOp'],'GA|GAMV')
              SCN(ag:FAC, Val(y3))
            endif
            if Incluido(FBN['TipoOp'],'CC|CCMV|MMPI|MMPIM|MMPE|MMPEM')
              SCN(ah:FAC, Val(y3))
            endif
            if Incluido(FBN['TipoOp'],'MMFRNP|MMFIMV|MMPSI|MMSIMV')
              SCN(ai:FAC, Val(y3))
            endif
          else
            if Incluido(FBN['TipoOp'],'GA|GAMV')
              SCN(g:FAC, Val(y3))
            endif
            if Incluido(FBN['TipoOp'],'CC|CCMV|MMPI|MMPIM|MMPE|MMPEM')
              SCN(h:FAC, Val(y3))
            endif
            if Incluido(FBN['TipoOp'],'MMFRNP|MMFIMV|MMPSI|MMSIMV')
              SCN(i:FAC, Val(y3))
            endif
          endif
        endif
      else
        if Incluido(FBN['TipoOp'],'MMPCOS|MMPOSM')
          SCN(as:FAC, Val(y3))
        endif
        if Incluido(FBN['TipoOp'],'MMPCL|MMPCLM|MMPLME')
          SCN(at:FAC, Val(y3))
        endif
        if Incluido(FBN['TipoOp'],'GA|GAMV|CC|CCMV|MMPI|MMPIM|MMPE|MMPEM|MMFRNP|MMFIMV|MMPSI|MMSIMV')
          if EqStr(FBN['PaisDir'],'ARG') o Vacio(FBN['PaisDir'])
            SCN(at:FAC, Val(y3))
          else
            SCN(as:FAC, Val(y3))
          endif
        endif
      endif
    proximo

    SQL.ADD("Select Cantidad1,RB1,Especie,T.Fecha1 from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C ")
    if Vacio(Val(x:FAC))
      SQL.ADD("where Cliente1 = '"~Val(w:FAC)~"' ")
    else
      SQL.ADD("where Cliente1 in (Select Cliente from "~DBO~".GRUPOSECONOMICOS where Controlante = '"~Val(x:FAC)~"' and TipoGrupo = 'BANCA' ) ")
    endif
    SQL.ADD("and T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("and T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("and TipoTr2 = 'ACV' ")
    SQL.ADD("and Codigo = Cliente1 ")
    SQL.ADD("and Codigo in ("~Val(z4)~") ")
    recorrer SQL
      DFA
      ACN(y3, FBN['Cantidad1']/1000)
      ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['Fecha1'],1,SI,'USD'))
      if FBN['RB1']=1
        SCN(k:FAC, Val(y3))
      else
        SCN(ak:FAC, Val(y3))
      endif
    proximo
  endif
** Lineas Off-Shore
  if Incluido(FBN['Limite'],'ACOTOT')
    ACN(b:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACOGAR')
    ACN(d:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACOTRA')
    ACN(e:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACOPRE')
    ACN(f:FAC, FBN['Monto']/1000)
  endif
** Lineas Locales
  if Incluido(FBN['Limite'],'ACLTOT')
    ACN(ab:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACLGAR')
    ACN(ad:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACLTRA')
    ACN(ae:FAC, FBN['Monto']/1000)
  endif
  if Incluido(FBN['Limite'],'ACLPRE')
    ACN(af:FAC, FBN['Monto']/1000)
  endif
proximo

SQL.ADD("Select Controlante Clie, TipoOp Tipo, Especie, Cantidad Cant, '0' Mar1, Vehiculo1, PaisDir, '0' Mar2, TotalIntereses TotInt, Plazo Pla, FechaOp FOp, NrOperacion NrOp, PrecioEj PreEj from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G ")
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and TipoOp in ('MMPCL','MMPCLM','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','CC','CCMV','GA','GAMV') ")
SQL.ADD("and (")
SQL.ADD("(TipoOp in ('MMPCL','MMPCLM','MMPLME','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','MMFRNP','MMFIMV','MMPSI','MMSIMV') ")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("or (TipoOp in ('GA','GAMV','CC','CCMV') ")
SQL.ADD("and FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(") ")
SQL.ADD("and Cliente1 = Cliente ")
SQL.ADD("and TipoGrupo = 'BANCA' ")
SQL.ADD("and (Select Count(*) from "~DBO~".LIMASIGNADOS L where L.Cliente = Controlante and L.Limite in ('ACLTOT','ACLGAR','ACLTRA','ACLPRE','ACOTOT','ACOGAR','ACOTRA','ACOPRE') and L.Vehiculo = '"~Dialogo.Vehiculo1~"')=0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")
SQL.ADD("union ")
SQL.ADD("Select Cliente1 Clie, TipoOp Tipo, Especie, Cantidad Cant, '0' Mar1, Vehiculo1, PaisDir, '0' Mar2, TotalIntereses TotInt, Plazo Pla, FechaOp FOp, NrOperacion NrOp, PrecioEj PreEj from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and TipoOp in ('MMPCL','MMPCLM','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','CC','CCMV','GA','GAMV') ")
SQL.ADD("and (")
SQL.ADD("(TipoOp in ('MMPCL','MMPCLM','MMPLME','MMPCOS','MMPOSM','MMPE','MMPEM','MMPI','MMPIM','MMFRNP','MMFIMV','MMPSI','MMSIMV') ")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("or (TipoOp in ('GA','GAMV','CC','CCMV') ")
SQL.ADD("and FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(") ")
SQL.ADD("and (Select Count(*) from "~DBO~".LIMASIGNADOS L where L.Cliente = Cliente1 and L.Limite in ('ACLTOT','ACLGAR','ACLTRA','ACLPRE','ACOTOT','ACOGAR','ACOTRA','ACOPRE') and L.Vehiculo = '"~Dialogo.Vehiculo1~"')=0 ")
SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")

SQL.ADD("union ")
SQL.ADD("Select Controlante Clie, TipoTr2 Tipo, Especie, Cantidad1 Cant, RB2 Mar1, Vehiculo1, PaisDir, RB1 Mar2, 0 TotInt, 0 Pla, T.Fecha1 FOp, NrTrans NrOp, 0 PreEj from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G ")
SQL.ADD("where T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TipoTr2 = 'ACV' ")
SQL.ADD("and Cliente1 = Cliente ")
SQL.ADD("and TipoGrupo = 'BANCA' ")
SQL.ADD("and (Select Count(*) from "~DBO~".LIMASIGNADOS L where L.Cliente = Controlante and L.Limite in ('ACLTOT','ACLGAR','ACLTRA','ACLPRE','ACOTOT','ACOGAR','ACOTRA','ACOPRE') and L.Vehiculo = '"~Dialogo.Vehiculo1~"')=0 ")
*SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")
SQL.ADD("union ")
SQL.ADD("Select Cliente1 Clie, TipoTr2 Tipo, Especie, Cantidad1 Cant, RB2 Mar1, Vehiculo1, PaisDir, RB1 Mar2, 0 TotInt, 0 Pla, T.Fecha1 FOp, NrTrans NrOp, 0 PreEj from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C ")
SQL.ADD("where T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TipoTr2 = 'ACV' ")
SQL.ADD("and (Select Count(*) from "~DBO~".LIMASIGNADOS L where L.Cliente = Cliente1 and L.Limite in ('ACLTOT','ACLGAR','ACLTRA','ACLPRE','ACOTOT','ACOGAR','ACOTRA','ACOPRE') and L.Vehiculo = '"~Dialogo.Vehiculo1~"')=0 ")
SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")

SQL.ADD("order by 1 ")

recorrer SQL
  if EqStr(FBN['Clie'],Val(w:FAC-1))
    DFA
  else
    if NoVacio(Val(w:FAC-1))
      DFA
      if Val(x3)=1
        ACT(t:FAC, 'Local')
        if Val(x4)=1
          ACT(u:FAC, 'C/Suc.')
          if Val(b:FAC)=0
            if Val(ab:FAC)>0
              ACN(b:FAC, Val(ab:FAC))
            endif
          endif
          if Val(d:FAC)=0
            if Val(ad:FAC)>0
              ACN(d:FAC, Val(ad:FAC))
            endif
          endif
          if Val(e:FAC)=0
            if Val(ae:FAC)>0
              ACN(e:FAC, Val(ae:FAC))
            endif
          endif
          if Val(f:FAC)=0
            if Val(af:FAC)>0
              ACN(f:FAC, Val(af:FAC))
            endif
          endif
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      else
        ACT(t:FAC, 'Exterior')
        if Val(x1)=1
          ACT(u:FAC, 'C/Suc.')
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      endif
      ACN(q:FAC, 0)
      ACN(q:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACOTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      ACN(aq:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACLTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      if Val(q:FAC)=0
        if Val(aq:FAC)>0
          ACN(q:FAC, Val(aq:FAC))
        endif
      endif
      if Val(b:FAC)>Val(d:FAC)+Val(e:FAC)+Val(f:FAC)
        ACN(c:FAC, Val(b:FAC)-(Val(d:FAC)+Val(e:FAC)+Val(f:FAC)))
      endif
      (.'DISPEMPRE'.)
      if Val(b:FAC)=0 y Val(j:FAC)=0
        BorrarCeldas(a:FAC..bz:FAC)
      else
        IFA
      endif
    endif
    ACN(x1,0)
    ACN(x2,0)
    ACN(x3,0)
    ACN(x4,0)
    if DesciendeDeCliente(FBN['Clie'],'BLOCAL')
      ACN(x3,1)
      if EqStr(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Clie']),'ARG') o Vacio(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Clie']))
        ACN(x1, 1)
        if BuscarCampo('CLIENTES','RPC','Codigo',FBN['Clie'])>0
          ACN(x2, BuscarCampo('CLIENTES','RPC','Codigo',FBN['Clie'])/1000)
        else
          ACN(x2, BuscarCampo('CLIENTES','Patrimonio','Codigo',FBN['Clie'])/1000*0.15)
        endif
      endif
      SQL.ADD("Select Codigo from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~FBN['Clie']~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and PaisDir <> 'ARG' ")
      SQL.ADD("and PaisDir is Not Null ")
      recorrer SQL
        DFA
        ACN(x4, 1)
      proximo
    else
      SQL.ADD("Select Codigo, Patrimonio, FechaBal, RPC from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~FBN['Clie']~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null) ")
      recorrer SQL
        DFA
        ACN(x1, 1)
        if FBN['RPC']>0
          ACN(x2, FBN['RPC']/1000)
        else
          ACN(x2, FBN['Patrimonio']/1000*0.15)
        endif
      proximo
    endif
    ACT(w:FAC, FBN['Clie'])
    ACT(x:FAC, SQL("Select Controlante from "~DBO~".GRUPOSECONOMICOS where Cliente = '"~Val(w:FAC)~"' and TipoGrupo = 'BANCA' "))
    if Vacio(Val(x:FAC))
      ACT(a:FAC, FBN['Clie'])
    else
      ACT(a:FAC, Copy(BuscarCampo('CONTROLANTES','RazonSocial','Codigo',Val(x:FAC)),1,25))
    endif
  endif
  ACN(y3,0)
  if Incluido(FBN['Tipo'],'ACV')
    ACN(y3, FBN['Cant']/1000)
    ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['FOp'],1,SI,'USD'))
    if FBN['Mar2']=1
      SCN(k:FAC, Val(y3))
    else
      SCN(ak:FAC, Val(y3))
    endif
  else
    if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
      if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|MMPIM|MMPEM|MMFIMV|MMSIMV')
        SQL.ADD("Select Cantidad2 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          ACN(y3, FBN['Cantidad2']/1000)
        proximo
      else
        SQL.ADD("Select Cantidad1 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          ACN(y3, FBN['Cantidad1']/1000)
        proximo
      endif
    else
      if Incluido(FBN['Tipo'],'MMPLME|GA|CC|MMFRNP|MMPSI')
        ACN(y3, FBN['Cant']/1000)
      else
        ACN(y3, FBN['PreEj']/1000)
      endif
    endif
    if Dialogo.Check1=1
      if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
        SQL.ADD("Select Cantidad3,Fecha1,Fecha2,Plazo1 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          if FBN['Fecha2']<Dialogo.Fecha1
            SCN(y3, FBN['Cantidad3']/1000)
          else
            SCN(y3, (FBN['Cantidad3']/FBN['Plazo1']*(Dialogo.Fecha1-FBN['Fecha1']))/1000)
          endif
        proximo
      else
        SCN(y3, (FBN['TotInt']/FBN['Pla']*(Dialogo.Fecha1-FBN['FOp']))/1000)
      endif
    endif
    ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['FOp'],1,SI,'USD'))
    if Incluido(FBN['Vehiculo1'],Val(z1)) o EqStr(FBN['Vehiculo1'],Dialogo.Vehiculo1)
      if Incluido(FBN['Tipo'],'MMPCOS|MMPOSM')
        SCN(i:FAC, Val(y3))
      endif
      if Incluido(FBN['Tipo'],'MMPCL|MMPCLM|MMPLME')
        SCN(ai:FAC, Val(y3))
      endif
      if Incluido(FBN['Tipo'],'GA|GAMV|CC|CCMV|MMPI|MMPIM|MMPE|MMPEM|MMFRNP|MMFIMV|MMPSI|MMSIMV')
        if EqStr(FBN['PaisDir'],'ARG') o Vacio(FBN['PaisDir'])
          if Incluido(FBN['Tipo'],'GA|GAMV')
            SCN(ag:FAC, Val(y3))
          endif
          if Incluido(FBN['Tipo'],'CC|CCMV|MMPI|MMPIM|MMPE|MMPEM')
            SCN(ah:FAC, Val(y3))
          endif
          if Incluido(FBN['Tipo'],'MMFRNP|MMFIMV|MMPSI|MMSIMV')
            SCN(ai:FAC, Val(y3))
          endif
        else
          if Incluido(FBN['Tipo'],'GA|GAMV')
            SCN(g:FAC, Val(y3))
          endif
          if Incluido(FBN['Tipo'],'CC|CCMV|MMPI|MMPIM|MMPE|MMPEM')
            SCN(h:FAC, Val(y3))
          endif
          if Incluido(FBN['Tipo'],'MMFRNP|MMFIMV|MMPSI|MMSIMV')
            SCN(i:FAC, Val(y3))
          endif
        endif
      endif
    else
      if Incluido(FBN['Tipo'],'MMPCOS|MMPOSM')
        SCN(as:FAC, Val(y3))
      endif
      if Incluido(FBN['Tipo'],'MMPCL|MMPCLM|MMPLME')
        SCN(at:FAC, Val(y3))
      endif
      if Incluido(FBN['Tipo'],'GA|GAMV|CC|CCMV|MMPI|MMPIM|MMPE|MMPEM|MMFRNP|MMFIMV|MMPSI|MMSIMV')
        if EqStr(FBN['PaisDir'],'ARG') o Vacio(FBN['PaisDir'])
          SCN(at:FAC, Val(y3))
        else
          SCN(as:FAC, Val(y3))
        endif
      endif
    endif
  endif
proximo

if NoVacio(Val(w:FAC))
      if Val(x3)=1
        ACT(t:FAC, 'Local')
        if Val(x4)=1
          ACT(u:FAC, 'C/Suc.')
          if Val(b:FAC)=0
            if Val(ab:FAC)>0
              ACN(b:FAC, Val(ab:FAC))
            endif
          endif
          if Val(d:FAC)=0
            if Val(ad:FAC)>0
              ACN(d:FAC, Val(ad:FAC))
            endif
          endif
          if Val(e:FAC)=0
            if Val(ae:FAC)>0
              ACN(e:FAC, Val(ae:FAC))
            endif
          endif
          if Val(f:FAC)=0
            if Val(af:FAC)>0
              ACN(f:FAC, Val(af:FAC))
            endif
          endif
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      else
        ACT(t:FAC, 'Exterior')
        if Val(x1)=1
          ACT(u:FAC, 'C/Suc.')
        else
          ACT(u:FAC, 'S/Suc.')
        endif
      endif
      ACN(q:FAC, 0)
      ACN(q:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACOTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      ACN(aq:FAC, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACLTOT' and Cliente = '"~Val(w:FAC)~"' and Vehiculo is NULL")/1000)
      if Val(q:FAC)=0
        if Val(aq:FAC)>0
          ACN(q:FAC, Val(aq:FAC))
        endif
      endif
      if Val(b:FAC)>Val(d:FAC)+Val(e:FAC)+Val(f:FAC)
        ACN(c:FAC, Val(b:FAC)-(Val(d:FAC)+Val(e:FAC)+Val(f:FAC)))
      endif
      (.'DISPEMPRE'.)
      if Val(b:FAC)=0 y Val(j:FAC)=0
        BorrarCeldas(a:FAC..bz:FAC)
        DFA
      endif
endif
if FAC>Val(y1)+1
  OrdenarFilas(Val(y1)+1,FAC,1,'A')
endif
IFA
ACT(a:FAC, 'TOTAL')
ACN(b:FAC, SUM(b:Val(y1)..b:FAC-1))
ACN(c:FAC, SUM(c:Val(y1)..c:FAC-1))
ACN(d:FAC, SUM(d:Val(y1)..d:FAC-1))
ACN(e:FAC, SUM(e:Val(y1)..e:FAC-1))
ACN(f:FAC, SUM(f:Val(y1)..f:FAC-1))
ACN(g:FAC, SUM(g:Val(y1)..g:FAC-1))
ACN(h:FAC, SUM(h:Val(y1)..h:FAC-1))
ACN(i:FAC, SUM(i:Val(y1)..i:FAC-1))
ACN(j:FAC, SUM(j:Val(y1)..j:FAC-1))
ACN(l:FAC, SUM(l:Val(y1)..l:FAC-1))
ACN(m:FAC, SUM(m:Val(y1)..m:FAC-1))
ACN(n:FAC, SUM(n:Val(y1)..n:FAC-1))
ACN(o:FAC, SUM(o:Val(y1)..o:FAC-1))
ACN(p:FAC, SUM(p:Val(y1)..p:FAC-1))
ACN(q:FAC, SUM(q:Val(y1)..q:FAC-1))
ACN(r:FAC, SUM(r:Val(y1)..r:FAC-1))
FormatoCeldas(b:FAC..s:FAC,EXE('F0R'))
SetFont(a:FAC..s:FAC,2)
AgregarMarco(a:Val(y1)+1..r:FAC,1,3)

SetFont(x1..z5,1)

ACO(1,15)
ACO(2,5)
ACO(3,5)
ACO(4,5)
ACO(5,5)
ACO(6,5)
ACO(7,5)
ACO(8,5)
ACO(9,5)
ACO(10,5)
ACO(11,5)
ACO(12,5)
ACO(13,5)
ACO(14,5)
ACO(15,5)
ACO(16,5)
ACO(17,5)
ACO(18,5)
*ACO(19,13)

LimitesVision(r:FAC)
Impresion(1,2)
*RangoTitulo(a:1..r:FAC,12)
RangoTitulo(a:10..r:FAC,3)
