ifa
If NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Moneda: '~Dialogo.Especie1)
Else
    ACT(A:fac, 'Moneda:Todas')
Endif
ifa
SetFont(A:1..A:2,3)
