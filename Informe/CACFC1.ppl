ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

SQL.ADD(" Select TipoOp, Cliente1, ContraEspecie, TotalNetoCli1, Especie, Cuenta1, Vehiculo1, FechaOp, Precio1, RB7,Vehiculo1 ")
SQL.ADD(" From "~DBO~".OPERACIONES  where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['ContraEspecie'])
   ACT(zd:99, PYC(fbn['TotalNetoCli1'],1,2))
   ACT(ze:99, fbn['Especie'])
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zh:99, PYC(fbn['Precio1'],1,4))
   ACN(zi:99, fbn['RB7'])
   ACD(zm:99, fbn['FechaOp'])
   ACT(vv:99, fbn['Vehiculo1'])  
Proximo

If Not EqStr(val(za:99), 'FCS') y Not EqStr(val(za:99), 'FCR')
    Cancelar
Endif

SetFilaActual(11)
ACT(a:FAC, 'Buenos Aires, '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')

SetFilaActual(fac+3)
ACT(a:fac,'Señores')
SetFont(a:11..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra consideracion:')
SetFilaActual(fac+2)

If Eqstr(val(za:99), 'FCS')
   ACT(a:fac,'Por medio de la presente solicitamos a Uds. la suscripcion de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~' '~'en el fondo')
Else
   ACT(a:fac,'Por medio de la presente solicitamos a Uds. el rescate de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~' '~'del fondo')
EndIf

SetFilaActual(fac+1)
*--ACT(a:fac,BuscarCampo('ESPECIES','Nombre','Codigo',val(ze:99)))
ACT(a:fac,BuscarCampo('ESPECIES','Extendido','Codigo',val(ze:99)))

SetFilaActual(fac+2)
If Val(zi:99)=0
   ACT(a:Fac,'Valor Cuota Parte del dia de la fecha: '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zh:99))   
   SetFilaActual(fac+1)
   ACT(a:Fac,'Valor Resultante: '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-') 
   SetFilaActual(fac+2)
EndIf  

*--ACT(a:Fac,'Asimismo, '~IIF(Eqstr(val(za:99), 'FCS'),'autorizamos a Uds. a debitar dicho importe en nuestra Cuenta Corriente en','solicitamos acreditar dicha suma en nuestra Cuenta Corriente en '~BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99))~' abierta'))
ACT(a:Fac,'Asimismo, '~IIF(Eqstr(val(za:99), 'FCS'),'autorizamos a Uds. a debitar dicho importe en nuestra Cuenta Corriente en','solicitamos acreditar dicha suma en nuestra Cuenta Corriente en '~BuscarCampo('ESPECIES','Extendido','Codigo',val(zc:99))~' abierta'))
SetFilaActual(fac+1)
*--ACT(a:Fac, IIF( Eqstr(val(za:99),'FCS'),BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99))~' en vuestro Banco, Cuenta Nro.','en vuestro Banco, Cuenta Nro.: ')~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))  )
ACT(a:Fac, IIF( Eqstr(val(za:99),'FCS'),BuscarCampo('ESPECIES','Extendido','Codigo',val(zc:99))~' en vuestro Banco, Cuenta Nro.','en vuestro Banco, Cuenta Nro.: ')~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))  )

SetFilaActual(fac+2)
ACT(a:Fac,'Sin otro particular, lo saludamos a Uds. muy '~IIF(Eqstr(val(za:99), 'FCS'),'atte.', 'atentamente.'))
SetFont(a:val(zz:99)..a:fac,1)

