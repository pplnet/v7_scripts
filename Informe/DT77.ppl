CrearDialogo
  Fecha1:   "F.Acred.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2:   "F.Acred.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  Lista1:   "Nro. Datanet"       ;  ; ;;;;;;;;;SQLSet(" Select NrDatanet From "~DBO~".DATANET ");
  Lista2:   'Bancos Datanet'     ;-3;2;;;;;;;;;SQLSet(" Select Distinct Alias2 From "~DBO~".CLIENTES Where Alias2 Is Not Null ");
  Lista3:   'Cuentas'            ;  ;1;;;;;;;;;SQLSet(" Select Distinct Numero From "~DBO~".CUENTAS Where Numero Is Not Null ");
  Lista4:   'Conceptos'          ;-8;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET ");

FinDialogo

IF not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


ACT(A:1, 'Movimientos Datanet Fuera de Extractos')
SetFont(A:1, 3)
SetFilaActual(fac+2)

ACT(A:fac+1, 'Nro.Datanet: '~IIF(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(A:fac+2, 'Cod.Bco.Datanet:  '~IIF(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(A:fac+3, 'Cuenta: '~IIF(vacio(Dialogo.Lista3),'Todos',Pipe2Comillas(Dialogo.Lista3)))
ACT(A:fac+4, 'Conceptos: '~IIF(vacio(Dialogo.Lista4),'Todos',Pipe2Comillas(Dialogo.Lista4)))

SetFilaActual(fac+4)

ACT(A:fac+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(A:fac+3, 'Fecha Hasta: '~Dialogo.Fecha2)


SetFilaActual(fac+4)

ACT(A:fac,'Nro.Datanet')
ACT(B:fac,'Fec.Bajada')
ACT(C:fac,'Archivo')
ACT(D:fac,'Banco')
ACT(E:fac,'Sucursal')
ACT(F:fac,'Cuenta')
ACT(G:fac,'DC')
ACT(H:fac,'Importe')
ACT(I:fac,'Fec.Acred.')
ACT(J:fac,'Tipo Mov.')
ACT(K:fac,'Comprobante')
ACT(L:fac,'Fec. Ingr.')
ACT(M:fac,'Vehiculo')
ACT(N:fac,'Moneda')
ACT(O:fac,'Nr.Oper.')
ACT(P:fac,'Nr. Mov.')
ACT(Q:fac,'Concil.')


AgregarMarco(A:fac..Q:fac, 1, 0,Exe('COLOR'))
SetFont(A:2..Q:fac, 1)
AlinearCeldas(A:fac..Q:fac, 'C')

ACT(MM:1, SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET Where Tipo IN ("~Pipe2Comillas(Var('CODTNOI'))~") "))

SQL.ADD(" Select M.NrDatanet, M.Banco, M.Sucursal, M.Cuenta, M.DC, M.Importe, M.FechaAcreditacion, ")
SQL.ADD(" M.TipoMov, M.Comprobante, M.FechaIngreso, M.Vehiculo, M.Moneda, M.NrOperacion,  ")
SQL.ADD(" M.NrMovimiento, M.EstadoConciliacion, D.FechaBajada, D.Archivo ")
SQL.ADD(" From "~DBO~".MOVDATANET M, "~DBO~".DATANET D ")
SQL.ADD(" Where M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND M.EstadoConciliacion IN ("~Pipe2Comillas(Val(MM:1))~") ")
SQL.ADD(" AND M.FechaAcreditacion >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaAcreditacion <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND M.NrDatanet IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND M.Banco IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF NoVacio(Dialogo.Lista3)
    SQL.ADD(" AND M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
ENDIF
IF NoVacio(Dialogo.Lista4)
    SQL.ADD(" AND M.TipoMov IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
ENDIF
SQL.ADD(" Order By M.Banco, M.Sucursal, M.Cuenta, M.DC, M.FechaAcreditacion, M.Comprobante, ")
SQL.ADD(" M.Importe ")

ACN(FI:1, fac+1)
Recorrer SQL
    ACT(A:fac, fbn('NrDatanet'))
    ACt(B:fac, fbn('FechaBajada'))
    ACT(C:fac, fbn('Archivo'))
    ACT(D:fac, fbn('Banco'))
    ACT(E:fac, fbn('Sucursal'))
    ACT(F:fac, fbn('Cuenta'))
    ACT(G:fac, fbn('DC'))
    ACT(H:fac, fbn('Importe'))
    ACT(I:fac, fbn('FechaAcreditacion'))
    ACT(J:fac, fbn('TipoMov'))
    ACT(K:fac, fbn('Comprobante'))
    ACT(L:fac, fbn('FechaIngreso'))
    ACT(M:fac, fbn('Vehiculo'))
    ACT(N:fac, fbn('Moneda'))
    ACT(O:fac, fbn('NrOperacion'))
    ACT(P:fac, fbn('NrMovimiento'))
    ACT(Q:fac, fbn('EstadoConciliacion'))
    SetFont(A:fac..Q:fac, 2)
Proximo
FormatoCeldas(K:Val(FI:1)..K:fac, Exe('F8'))

SetFilaActual(fac+2)
AgregarMarco(A:fac..Q:fac, 1, 0, Exe('COLOR'))
SetFont(A:fac..Q:fac, 1)

ACT(A:fac+2,'FIN DE LISTADO')
SetFont(A:fac..A:fac, 1)

FormatoCeldas(J:1..J:fac, Exe('F2'))
FormatoCeldas(L:1..L:fac, Exe('F2'))
FormatoCeldas(B:1..B:fac, Exe('F0'))
LimitesVision(Q:fac+1)

ACO(2, 6)
ACO(4, 6)
ACO(5, 6)
ACO(6, 10)
ACO(7, 5)
ACO(8, 5)
ACO(9, 6)
ACO(10, 6)
ACO(11, 8)
ACO(12, 8)
SetPrintFit(3, 85)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(A:FAC, 'Fin del Informe')
SetFont(A:fac, 1)
LimitesVision(R:fac+1)
RangoTitulo(A:1..Q:FAC, 10)
