* Revisar tope de fechas
CrearDialogo 
  Fecha1     :'F.Ord.Desde';1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
** Se comenta Fecha Vto por la Demo de Ciudad
*  Fecha3     :'F.Vto.Desde'; ;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Cliente1   :'Cliente'    ; ;1;;;;;
  Especie1:  'Especie'     ; ;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'Debe ingresar un Titulo';No;
  Vehiculo1  :'Vehiculo'   ; ;1;;;;;;;
  Lista1     : "Tipos Ordenes" ; ;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSORDEN where Codigo in ('OEQC','OEQV','OTIC','OTIV','OCSEC','OVSEC','CSEC','VSEC') ");  

  Fecha2     :'F.Ord.Hasta';-5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
** Se comenta Fecha Vto por la Demo de Ciudad
*  Fecha4     :'F.Vto.Hasta';-4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys+365  
  Book1      :'Cartera'    ;-3;2;;;;;
  Operador   :'Operador'   ;-2;2;;;;
  Lista2     : "Instancias";-1;2;;;;;;;;;SqlSet("Select Nombre from "~DBO~".INSTANCIAS where Tabla='ORDENES' ")
FinDialogo


AgregarBMP(a1, Exe('LOGO'), Exe('ESCALOGO'))

If Not OK
  Cancelar
EndIf

Recorrer&I 1, Elementos(Dialogo.Lista2)
   ACT(LI:1,BuscarCampo('INSTANCIAS','NrInstancia','Nombre',ItemLista(Dialogo.Lista2,&i)) )
   ACT(LI:2,Val(LI:1)~"|"~Val(LI:2))
   ACT(LI:3,Val(LI:3)~"|"~ItemLista(Dialogo.Lista2,&i))
Proximo

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")
SetFilaActual(8)
ACT(A:Fac,'Detalle de Ordenes por Estado')
SetFont(A:Fac,4)

SetFilaActual(9)

ACT(A:Fac+1,'F. Ord. Desde: '~Dialogo.Fecha1)
*ACT(A:Fac+2,'F. Vto. Desde: '~Dialogo.Fecha3)
If Vacio(Dialogo.Cliente1)
   ACT(A:Fac+2,'Cliente: Todos ')
Else
   ACT(A:Fac+2,'Cliente: '~Dialogo.Cliente1)
EndIf
If Vacio(Dialogo.Vehiculo1)
   ACT(A:Fac+3,'Vehiculo: Todos')
Else
   ACT(A:Fac+3,'Vehiculo: '~Dialogo.Vehiculo1)
EndIf

If Vacio(Dialogo.Lista2)
   ACT(A:Fac+4,'Lista de Instancias: Todos ')
Else
   ACT(A:Fac+5,'Lista de Instancias: '~Dialogo.Lista2)
EndIf
ACT(B:Fac+1,'F. Ord. Hasta: '~Dialogo.Fecha2)
*ACT(B:Fac+2,'F. Vto. Hasta: '~Dialogo.Fecha4)

If Vacio(Dialogo.Especie1)
   ACT(B:Fac+2,'Especie: Todos')
Else
   ACT(B:Fac+2,'Especie: '~Dialogo.Especie1)
EndIf

If Vacio(Dialogo.Lista1)
   ACT(B:Fac+3,'Tipos de Orden: Todos ')
Else
   ACT(B:Fac+3,'Tipos de Orden: '~Dialogo.Lista1)
EndIf

If Vacio(Dialogo.Book1)
   ACT(C:Fac+4,'Cartera: Todos ')
Else
   ACT(C:Fac+4,'Cartera: '~Dialogo.Book1)
EndIf   

If Vacio(Dialogo.Operador)
   ACT(D:Fac+4,'Operador: Todos')
Else
   ACT(D:Fac+4,'Operador: '~Dialogo.Operador)
EndIf

SetFont(A:Fac+1..D:Fac+4,2)

SetFilaActual(Fac+6)

ACT(A:Fac,'Tipo Orden')
ACT(B:Fac,'Nro. Orden')
ACT(C:Fac,'Fecha Orden')
*ACT(D:Fac,'Fecha Vto')
ACT(D:Fac,'Cliente')
ACT(E:Fac,'Nombre')
ACT(F:Fac,'Especie')
*ACT(H:Fac,'Plazo')
ACT(G:Fac,'Moneda')
ACT(H:Fac,'Cantidad VN')
ACT(I:Fac,'Precio Limite')
ACT(J:Fac,'Cantidad Ejec.')
ACT(K:Fac,'Precio Prom.')
ACT(L:Fac,'Instancia')
ACT(M:Fac,'NrOperacion')
ACT(N:Fac,'Cartera')
ACT(O:Fac,'M. Negociacion')
ACT(P:Fac,'M. Liq Especie')
ACT(Q:Fac,'M. Liq Moneda')
ACT(R:Fac,'Rueda')
ACT(S:Fac,'Operador')
ACT(T:Fac,'Usuario Carga')
ACT(U:Fac,'Fecha Cargar')
ACT(V:Fac,'Contingencia')
ACT(W:Fac,'Nro. Secuencia')

SetFont(A:Fac..W:Fac,2)
AgregarMarco(A:fac..W:fac,2,0,EXE('COLOR'))

ACN(NU:1,Fac+1)

SQL.ADD(" Select O.TipoOrden, O.NrOrden, O.Especie, O.Cliente, O.CantidadTotalOrden, O.Cantidad2, O.PrecioLimite, O.Mercado3, O.Mercado, O.Mercado2, O.Mercado4, O.RB10, O.Cantidad3, NrOperacion2, O.FechaCarga, O.Operador1,  ")
SQL.ADD(" O.Vehiculo, O.ContraEspecie, O.FechaOrden, O.Plazo1, O.RB5, O.FechaVto, O.TipoCambio2, O.Book1, O.Operador, O.CB6, O.CB7, O.NroAltaMAE, OB.NrBit,   ")
SQL.ADD(" O.UDN1, O.Cantidad1, O.Cantidad4      ")
SQL.ADD(" From   "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB          ")
*SQL.ADD(" Where FechaOrden between'"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2+1)~"'    ")
SQL.ADD(" Where FechaOrden between'"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'    ")
*SQL.ADD(" And FechaVto between'"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"'    ")
SQL.ADD(" And OB.Valor='1'  And O.NrOrden= OB.NrOperacion  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and Cliente='"~Dialogo.Cliente1~"' ")  
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and Especie='"~Dialogo.Especie1~"' ")  
EndIf
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and Vehiculo='"~Dialogo.Vehiculo1~"' ")  
EndIf

If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOrden in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and TipoOrden in ('OEQC','OEQV','OTIC','OTIV','OCSEC','OVSEC','CSEC','VSEC') ")
EndIf

If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and NrBit in ("~Pipe2Comillas(Val(LI:2))~") ")  
EndIf

If NoVacio(Dialogo.Book1)
   SQL.ADD(" and Book1='"~Dialogo.Book1~"' ")  
EndIf

If NoVacio(Dialogo.Operador)
   SQL.ADD(" and Operador='"~Dialogo.Operador~"' ")  
EndIf
watch(sql.batch)
Recorrer SQL
   ACT(A:Fac,FbN['TipoOrden'])
   ACT(B:Fac,FbN['NrOrden'])
   ACLR(B:Fac,FbN['NrOrden'])
   ACD(C:Fac,FbN['FechaOrden'])
*   ACD(D:Fac,FbN['FechaVto'])
   ACT(D:Fac,FbN['Cliente'])
   ACT(E:Fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',FbN['Cliente']))
   ACT(F:Fac,FbN['Especie'])
*   ACN(H:Fac,FbN['Plazo1'])
*   If Val(H:Fac)=0
*      ColorCeldas(H:fac,clRED)
*   EndIF
   ACT(G:Fac,FbN['ContraEspecie'])
   ACN(H:Fac,FbN['CantidadTotalOrden'])
   ACN(I:Fac,FbN['PrecioLimite'])
   ACN(J:Fac,FbN['Cantidad1'])
   If Val(J:Fac)=0
      ColorCeldas(J:fac..J:fac,clRED)
   EndIF
   ACN(K:Fac,FbN['Cantidad4'])
   If Val(K:Fac)=0
      ColorCeldas(K:fac..K:Fac,clRED)
   EndIF
   ACT(L:Fac,SQL(" Select Nombre From "~DBO~".INSTANCIAS where Tabla='ORDENES' and NrInstancia= "~FbN['NrBit']~" "))
   ACT(M:Fac,FbN['NrOperacion2'])
   ACLO(M:Fac,FbN['NrOperacion2'])
   ACT(N:Fac,FbN['Book1'])
   ACT(O:Fac,FbN['Mercado3'])
   ACT(P:Fac,FbN['Mercado'])
   ACT(Q:Fac,FbN['Mercado2'])
   ACT(R:Fac,FbN['UDN1'])
   ACT(S:Fac,FbN['Operador'])
   ACT(T:Fac,FbN['Operador1'])
   ACT(U:Fac,FbN['FechaCarga'])
   IF FbN['CB7']=1
      ACT(V:Fac,'SI')
   Else
      ACT(V:Fac,'NO')
   EndIf
   ACT(W:Fac,FbN['NroAltaMAE'])
Proximo

SetFont(A:Val(NU:1)..W:Fac,1)
ColorCeldas(M:Val(NU:1)..M:Fac,clBLUE)
FormatoCeldas(G:Val(NU:1)..G:Fac,Exe('F0'))
FormatoCeldas(I:Val(NU:1)..I:Fac,Exe('F9'))
FormatoCeldas(J:Val(NU:1)..J:Fac,Exe('F2'))
FormatoCeldas(K:Val(NU:1)..K:Fac,Exe('F9'))
FormatoCeldas(L:Val(NU:1)..L:Fac,Exe('F8GB'))
AlinearCeldas(A:Val(NU:1)-1..W:Val(NU:1)-1,'C')
AlinearCeldas(A:Val(NU:1)..A:Fac,'I')
AlinearCeldas(B:Val(NU:1)..C:Fac,'C')
AlinearCeldas(D:Val(NU:1)..F:Fac,'I')
AlinearCeldas(G:Val(NU:1)..G:Fac,'I')
AlinearCeldas(H:Val(NU:1)..H:Fac,'D')
AlinearCeldas(I:Val(NU:1)..L:Fac,'D')
AlinearCeldas(M:Val(NU:1)..M:Fac,'C')
AlinearCeldas(N:Val(NU:1)..U:Fac,'I')
AlinearCeldas(Q:Val(NU:1)..Q:Fac,'I')
AlinearCeldas(V:Val(NU:1)..V:Fac,'C')
AlinearCeldas(W:Val(NU:1)..W:Fac,'I')
ACO(1,15)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,15)
ACO(6,12)

ACO(7,10)
ACO(8,8)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)
ACO(17,10)
ACO(18,10)
ACO(19,10)
ACO(20,10)
ACO(21,10)
ACO(22,10)
ACO(23,15)
ACO(24,10)
ACO(25,10)

ACT(A:Fac+2,'Fin de Informe')
SetFont(A:Fac+2,2)
LimitesVision(X:FAC+3)
GrillaVisible(NO)
