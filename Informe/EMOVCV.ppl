*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'F.Valor D'         ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Valor Desde Invalida';NO;PriDeMes(Fsys, SI);
  Fecha2     : 'F.Valor H'         ;1;2;;;;Dialogo.Fecha2<>0;'Fecha Valor Hasta Invalida';NO;FinDeMes(Fsys, SI);
  Especie1   : 'Moneda'            ;2;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where Jerarquia Like '"~Var('JERMONEDA')~"%' ")
  Vehiculo1  : 'Grupo'             ;3;1;;Vacio(Dialogo.Lista2);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista2     : 'Vehiculo'          ;4;1;;Vacio(Dialogo.Vehiculo1);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Radio1     : '|C/Pos|S/Pos|Todos';5;1;;;;;;;2
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")
CrearFont(4,"Arial,10,B")

SetFilaActual(3)
ACT(b:FAC, 'Estado de Movimientos Cuentas Vista')
SetFont(b:FAC, 3)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Vehiculo1~' - '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  If NoVacio(Dialogo.Lista2)
    ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Lista2)
  Else 
    ACT(a:FAC+2, 'Vehiculo : Todos')
  EndIf
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+3, 'Especies : Todas')
endif

ACT(a:FAC+4, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta : '~Dialogo.Fecha2)
if Dialogo.Radio1=1
  ACT(a:FAC+6, 'Estado : Sin Posicion')
else
  if Dialogo.Radio1=0
    ACT(a:FAC+6, 'Estado : Con Posicion')
  else
    ACT(a:FAC+6, 'Estado : Todas')
  endif
endif

SetFont(a:FAC+2..a:FAC+6,2)

SetFilaActual(FAC+8)

ACT(a:FAC, 'Codigo SAP')
ACT(b:FAC, 'Vehiculo')
ACT(c:FAC, 'Fec.Carga')
ACT(d:FAC, 'Fec.Docum')
ACT(e:FAC, 'Fec.Valor')
ACT(f:FAC, 'Cta.Contable')
ACT(g:FAC, 'Moneda')
ACT(h:FAC, 'Importe')
ACT(i:FAC, 'Sist.Origen')
ACT(j:FAC, 'Ref.Posicion') 
ACT(k:FAC, 'Prec.Pos.ARP') 
ACT(l:FAC, 'Prec.Pos.USD') 
ACT(m:FAC, 'Estado') 

SetFont(a:FAC..m:FAC, 2)
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
ACN(w:1,FAC)

SQL.ADD(" SELECT M.CodigoSAP,     M.Vehiculo,       M.FechaCarga, M.FechaDoc, ") 
SQL.ADD("        M.FechaValor,    M.CuentaContable, M.Moneda,     M.ImporteMonedaDoc, ") 
SQL.ADD("        M.SistemaOrigen, M.Alias1,         M.Alias2 ")
SQL.ADD(" From "~DBO~".MOVCTAVISTA M ") 
SQL.ADD(" Where M.FechaValor >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaValor <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND M.Moneda = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
  IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~") ")
  ENDIF
ENDIF
if Dialogo.Radio1=0
  SQL.ADD(" AND M.Alias1 is Not NULL ")
endif
if Dialogo.Radio1=1
  SQL.ADD(" AND M.Alias1 is NULL ")
endif

SQL.ADD(" Order by M.Vehiculo,M.CodigoSAP ")

Recorrer SQL
  if Not EqStr(FBN['Vehiculo'], Val(v:1))
    if Not CeldaVacia(v:1)  
      SetFilaActual(FAC+1)
      ACT(a:FAC, 'Codigo SAP')
      ACT(b:FAC, 'Vehiculo')
      ACT(c:FAC, 'Fec.Carga')
      ACT(d:FAC, 'Fec.Docum')
      ACT(e:FAC, 'Fec.Valor')
      ACT(f:FAC, 'Cta.Contable')
      ACT(g:FAC, 'Moneda')
      ACT(h:FAC, 'Importe')
      ACT(i:FAC, 'Sist.Origen')
      ACT(j:FAC, 'Ref.Posicion') 
      ACT(k:FAC, 'Prec.Pos.ARP') 
      ACT(l:FAC, 'Prec.Pos.USD') 
      ACT(m:FAC, 'Estado') 

      SetFont(a:FAC..m:FAC, 2)
      AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
      SetFilaActual(FAC+1)  
    endif
    ACT(v:1, fbn('Vehiculo'))
  endif

  ACT(a:fac, fbn('CodigoSAP'))
  ACT(b:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',fbn('Vehiculo']),1,10))
  ACD(c:fac, fbn('FechaCarga'))
  ACD(d:fac, fbn('FechaDoc'))
  ACD(e:fac, fbn('FechaValor'))
  ACT(f:fac, fbn('CuentaContable'))
  ACT(g:fac, fbn('Moneda'))
  ACN(h:fac, fbn('ImporteMonedaDoc'))
  ACT(i:FAC, fbn('SistemaOrigen'))
  ACT(j:FAC, fbn('Alias1'))
  if NoVacio(fbn('Alias1'))
    SQL.ADD(" Select MP.NrSaldo, MP.Precio, MP.Especie ")
    SQL.ADD("   from "~DBO~".MOVPOSPEN MP ") 
    SQL.ADD("  where NrOperacion = '"~fbn('Alias1')~"' ") 
    Recorrer SQL
      DFA
      SCN(n:FAC, 1)
      if fbn('NrSaldo')=122
        ACN(k:FAC, fbn('Precio'))
        SCN(o:FAC, 1)
        SCN(n:FAC, -1)
      endif
      if fbn('NrSaldo')=132
        ACN(l:FAC, fbn('Precio'))
        SCN(p:FAC, 1)
        SCN(n:FAC, -1)
      endif
      if fbn('NrSaldo')=150
        if EqStr(fbn('Especie'),'ARP')
          ACN(k:FAC, fbn('Precio'))
        else
          ACN(l:FAC, fbn('Precio'))
        endif
        SCN(q:FAC, 1)
        SCN(n:FAC, -1)
      endif
      ACT(m:FAC, 'Pend.')
    proximo
    SQL.ADD(" Select MP.NrSaldo, MP.Precio, MP.Especie ")
    SQL.ADD("   from "~DBO~".MOVPOSEJE MP ") 
    SQL.ADD("  where NrOperacion = '"~fbn('Alias1')~"' ") 
    Recorrer SQL
      DFA
      SCN(r:FAC, 1)
      if fbn('NrSaldo')=122
        ACN(k:FAC, fbn('Precio'))
        SCN(s:FAC, 1)
        SCN(r:FAC, -1)
      endif
      if fbn('NrSaldo')=132
        ACN(l:FAC, fbn('Precio'))
        SCN(t:FAC, 1)
        SCN(r:FAC, -1)
      endif
      if fbn('NrSaldo')=150
        if EqStr(fbn('Especie'),'ARP')
          ACN(k:FAC, fbn('Precio'))
        else
          ACN(l:FAC, fbn('Precio'))
        endif
        SCN(u:FAC, 1)
        SCN(r:FAC, -1)
      endif
      ACT(m:FAC, 'Ejec.')
    proximo
  else
    ACT(j:FAC, fbn('Alias2'))
  endif
    
  SetFont(a:FAC..u:FAC,1)
 
  FormatoCeldas(g:fac..g:fac,Exe('F2'))
  FormatoCeldas(k:fac..l:fac,Exe('F8'))
proximo

SetFont(v:1..w:1,1)

ACO(1,15)
ACO(2,8)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,9)
ACO(7,6)
ACO(8,9)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,6)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

LimitesVision(m:FAC)
Impresion(1,2)
