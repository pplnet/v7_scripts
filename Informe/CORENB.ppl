CrearDialogo
   Fecha1  : 'Desde';1;1;;;;;;;;FSYS-1
   Fecha2  : 'Hasta';2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;FSYS-1
   Radio3  : 'Origen:|Activo|Pasivo';3;1;;;;;;;0;
   Radio6  : 'Clientes:|Vinculados|Terceros';4;1;;;;;;;0;

   Radio1  : 'Terc y Act|Todos|Dep.Pla|Cta.Cte';5;1;;NO;;;;;0;IIF(Not [Dialogo.Radio3=0 y Dialogo.Radio6=1],-1,0)
   Radio4  : 'Terc y Pas|Todos|Ob.Neg|Com.Ext|Fin.Lo|Fin.Ex|C.C.';;;;NO;;;;;0;IIF(Not [Dialogo.Radio3=1 y Dialogo.Radio6=1],-1,0)
   Radio2  : 'Vinc y Act|Todos|C.C.Vinc|C.C.Div|Co.Vinc|Co.Div';;;;NO;;;;;0;IIF(Not [Dialogo.Radio3=0 y Dialogo.Radio6=0],-1,0)
   Radio5  : 'Vinc y Pas|Todos|C.C.Vinc|C.C.Div|Pr.Vinc|Pr.Div';;;;NO;;;;;0;IIF(Not [Dialogo.Radio3=1 y Dialogo.Radio6=0],-1,0)

   Radio14 : 'Tipo Operac:|Todas|V.Simple|V.Mult.|C.Ahorro';9;1;;NO;;;;;0;
   Especie1: 'Moneda:';12;1;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4  : 'Imp.Detallado' ;13;1;;;;;;;;0;
   Check1  : "Graba"         ;;;;Dialogo.Radio10+Dialogo.Radio7=0 y Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,NO,'ARG');Dialogo.Radio10+Dialogo.Radio7=0 y Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI);;;;0

   Radio8  : 'Informacion:|Periodo|AHEAD';1;2;;;;;;;0;
   Radio10 : 'Operaciones:|Todas|A Tasa|Securities';2;2;;NO;;;;;0;
   Radio12 : 'Vehiculos:|Todos|Algunos';3;2;;;;;;;0;
   Radio7  : 'Especies:|Todas|Algunas';4;2;;;;;;;0;

   Lista1  : 'Vehiculo'     ;10;2;;Dialogo.Radio12=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Lista2  : 'Especies'     ;11;1;;Dialogo.Radio7=1 ;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Lista3  : 'Clientes'     ;05;2;;;;;;;;;IIF(Dialogo.Radio6=0,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

SetListaClaves(2)
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
(.'CORECABB'.)
SetFilaActual(9)

* Activas
if Dialogo.Radio3=0
  * Terceros
  if Dialogo.Radio6=1
    ACT(a:fac,'VEHICULO')
    ACT(b:fac,'DEP A PLAZO')
    ACT(e:fac,'CTA.CTE.')
    ACT(h:fac,'T.PUBLICOS') 
    ACT(j:fac,'T.PRIVADOS')
    ACT(l:fac,'SUBTOTAL')
    ACT(o:fac,'ACCIONES')  
    ACT(q:fac,'TOTAL')

    ACT(b:fac+1,'Cap.Prom')
    ACT(c:fac+1,'Tasa')
    ACT(d:fac+1,'Plazo')
    ACT(e:fac+1,'Cap.Prom')
    ACT(f:fac+1,'Tasa')
    ACT(g:fac+1,'Plazo')
    ACT(h:fac+1,'Cap.Prom')
    ACT(i:fac+1,'Tasa')
    ACT(j:fac+1,'Cap.Prom')
    ACT(k:fac+1,'Tasa')
    ACT(l:fac+1,'Cap.Prom')
    ACT(m:fac+1,'Tasa')
    ACT(n:fac+1,'Plazo')
    ACT(o:fac+1,'Cap.Prom')
    ACT(p:fac+1,'Tasa')
    ACT(q:fac+1,'Cap.Prom')
    ACT(r:fac+1,'Tasa')
    ACT(s:fac+1,'Plazo')
    AgregarMarco(a:fac..s:fac+1,1,0,EXE('COLOR'))
    AgregarMarco(a:fac..a:fac+1,1)
    AgregarMarco(b:fac..d:fac+1,1)
    AgregarMarco(e:fac..g:fac+1,1)
    AgregarMarco(h:fac..i:fac+1,1)
    AgregarMarco(j:fac..k:fac+1,1)
    AgregarMarco(l:fac..n:fac+1,1)
    AgregarMarco(o:fac..p:fac+1,1)
    SetFont(a:fac..s:fac+1, 2)
  endif
  * Vinculados
  if Dialogo.Radio6=0
    ACT(a:fac,'VEHICULO')
    ACT(b:fac,'CTA.CTE.VIN')
    ACT(e:fac,'CTA.CTE.DIV')
    ACT(h:fac,'COLOC.VIN') 
    ACT(k:fac,'COLOC.DIV')
    ACT(n:fac,'TOTAL')

    ACT(b:fac+1,'Cap.Prom')
    ACT(c:fac+1,'Tasa')
    ACT(d:fac+1,'Plazo')
    ACT(e:fac+1,'Cap.Prom')
    ACT(f:fac+1,'Tasa')
    ACT(g:fac+1,'Plazo')
    ACT(h:fac+1,'Cap.Prom')
    ACT(i:fac+1,'Tasa')
    ACT(j:fac+1,'Plazo')
    ACT(k:fac+1,'Cap.Prom')
    ACT(l:fac+1,'Tasa')
    ACT(m:fac+1,'Plazo')
    ACT(n:fac+1,'Cap.Prom')
    ACT(o:fac+1,'Tasa')
    ACT(p:fac+1,'Plazo')
    AgregarMarco(a:fac..p:fac+1,1,0,EXE('COLOR'))
    AgregarMarco(a:fac..a:fac+1,1)
    AgregarMarco(b:fac..d:fac+1,1)
    AgregarMarco(e:fac..g:fac+1,1)
    AgregarMarco(h:fac..j:fac+1,1)
    AgregarMarco(k:fac..m:fac+1,1)
    SetFont(a:fac..p:fac+1, 2)
  endif
endif

* Pasivas
if Dialogo.Radio3=1
  * Terceros
  if Dialogo.Radio6=1
    ACT(a:fac,'VEHICULO')
    ACT(b:fac,'OBLIG.NEG')
    ACT(e:fac,'COM.EXT.')
    ACT(h:fac,'FIN.LOC.') 
    ACT(k:fac,'FIN.EXT.')
    ACT(n:fac,'CTA.CTE')
    ACT(q:fac,'TOTAL')

    ACT(b:fac+1,'Cap.Prom')
    ACT(c:fac+1,'Tasa')
    ACT(d:fac+1,'Plazo')
    ACT(e:fac+1,'Cap.Prom')
    ACT(f:fac+1,'Tasa')
    ACT(g:fac+1,'Plazo')
    ACT(h:fac+1,'Cap.Prom')
    ACT(i:fac+1,'Tasa')
    ACT(j:fac+1,'Plazo')
    ACT(k:fac+1,'Cap.Prom')
    ACT(l:fac+1,'Tasa')
    ACT(m:fac+1,'Plazo')
    ACT(n:fac+1,'Cap.Prom')
    ACT(o:fac+1,'Tasa')
    ACT(p:fac+1,'Plazo')
    ACT(q:fac+1,'Cap.Prom')
    ACT(r:fac+1,'Tasa')
    ACT(s:fac+1,'Plazo')
    AgregarMarco(a:fac..s:fac+1,1,0,EXE('COLOR'))
    AgregarMarco(a:fac..a:fac+1,1)
    AgregarMarco(b:fac..d:fac+1,1)
    AgregarMarco(e:fac..g:fac+1,1)
    AgregarMarco(h:fac..j:fac+1,1)
    AgregarMarco(k:fac..m:fac+1,1)
    AgregarMarco(n:fac..p:fac+1,1)
    SetFont(a:fac..s:fac+1, 2)
  endif
  * Vinculados
  if Dialogo.Radio6=0
    ACT(a:fac,'VEHICULO')
    ACT(b:fac,'CTA.CTE.VIN')
    ACT(e:fac,'CTA.CTE.DIV')
    ACT(h:fac,'PREST.VIN') 
    ACT(k:fac,'PREST.DIV')
    ACT(n:fac,'TOTAL')

    ACT(b:fac+1,'Cap.Prom')
    ACT(c:fac+1,'Tasa')
    ACT(d:fac+1,'Plazo')
    ACT(e:fac+1,'Cap.Prom')
    ACT(f:fac+1,'Tasa')
    ACT(g:fac+1,'Plazo')
    ACT(h:fac+1,'Cap.Prom')
    ACT(i:fac+1,'Tasa')
    ACT(j:fac+1,'Plazo')
    ACT(k:fac+1,'Cap.Prom')
    ACT(l:fac+1,'Tasa')
    ACT(m:fac+1,'Plazo')
    ACT(n:fac+1,'Cap.Prom')
    ACT(o:fac+1,'Tasa')
    ACT(p:fac+1,'Plazo')
    AgregarMarco(a:fac..a:fac+1,1)
    AgregarMarco(b:fac..d:fac+1,1)
    AgregarMarco(e:fac..g:fac+1,1)
    AgregarMarco(h:fac..j:fac+1,1)
    AgregarMarco(k:fac..m:fac+1,1)
    AgregarMarco(a:fac..p:fac+1,1,0,EXE('COLOR'))
    SetFont(a:fac..p:fac+1, 2)
  endif
endif

SQL.ADD(" SELECT Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(val(zz6))
   SQL.ADD(" Where Codigo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD(" ORDER BY Codigo ")

SetFilaActual(11)
Recorrer SQL  
  ACT(a:fac, fbn('Codigo'))
  * Operaciones Activas
  If Dialogo.Radio3=0
    * Terceros
    If Dialogo.Radio6=1
      * Dep. a plazo
      BorrarCeldas(w1..w42)
      (.'DEPOPLAZO'.)
      ** armar totales 
      * capital promedio
      ACN(b:fac, Val(w1)+Val(w2)+Val(w3)+Val(w4))
      SCN(xb1, Val(b:fac))
 
     * tasa
      if Dialogo.Radio8 = 0
        ACN(c:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)+Val(w3)*Val(w31)+Val(w4)*Val(w41)) / Val(b:fac)  )
        SCN(xc1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)+Val(w3)*Val(w31)+Val(w4)*Val(w41))) 
      else
        ACN(c:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)+Val(w3)*Val(w32)*Val(w31)+Val(w4)*Val(w42)*Val(w41)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)+Val(w3)*Val(w32)+Val(w4)*Val(w42)) )
        SCN(xc1,(Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)+Val(w3)*Val(w32)*Val(w31)+Val(w4)*Val(w42)*Val(w41)))
      endif

      * plazo
      ACN(ac:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)+Val(w3)*Val(w32)+Val(w4)*Val(w42)) / Val(b:fac) )
      ACN(d:fac, Val(ac:fac))
      SCN(ac1,(Val(w1)*Val(w12)+Val(w2)*Val(w22)+Val(w3)*Val(w32)+Val(w4)*Val(w42)))

      * cta.cte.terc.
      BorrarCeldas(w1..w42)
      (.'CTACTE3AC'.)
      ** armar totales 
      * capital promedio
      ACN(e:fac, Val(w1)+Val(w2))
      SCN(xe1, Val(e:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(f:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(e:fac)  )
        SCN(xf1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(f:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xf1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) )
      endif
      * plazo
      ACN(af:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(e:fac) )
      ACN(g:fac, Val(af:fac) )
      SCN(af1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )

      * Securities (va solo si es por periodo)
      If Dialogo.Radio8=0  

        * Titulos Publicos
        BorrarCeldas(w1..w42)
        (.'TITPUB'.)
        ** armar totales 
        * capital promedio
        ACN(h:fac, Val(w1)+Val(w2))
        SCN(xh1, Val(h:fac))
        * tasa
        ACN(i:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(h:fac)  )
        SCN(xi1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
        * plazo
        ACN(ai:fac, 0 )
        SCN(ai1, 0 )

        * Titulos Privados
        BorrarCeldas(w1..w42)
        (.'TITPRI'.)
        ** armar totales 
        * capital promedio
        ACN(j:fac, Val(w1))
        SCN(xj1, Val(j:fac))
        * tasa
        ACN(k:fac, Val(w11)  )
        SCN(xk1, Val(w1)*Val(w11))
        * plazo
        ACN(ak:fac, 0 )
        SCN(ak1, 0 )

        * Acciones
        BorrarCeldas(w1..w42)
        (.'ACCIONES'.)
        ** armar totales 
        * capital promedio
        ACN(o:fac, Val(w1))
        SCN(xo1, Val(o:fac))
        * tasa
        ACN(p:fac, Val(w11)  )
        SCN(xp1, Val(w1)*Val(w11))
        * plazo
        ACN(ap:fac, 0 )
        SCN(ap1, 0 )
      Endif

      * Subtotal Terceros Activos
      BorrarCeldas(w1..w42)
      *Buscar si hay algun ajuste
      ACN(v1,0)
      (.'AJUSUBTOT3'.)
      if Val(v1)=1
        * hay ajuste
        * Capital
        ACN(l:fac, Val(w1)) 
        SCN(xl1, Val(l:fac) )
        * tasa
        ACN(m:fac, Val(w11))
        SCN(xm1, Val(w13))
        * Plazo
        ACN(am:fac, Val(w12))
        ACN(n:fac, Val(am:fac))
        SCN(am1, Val(w14))
      else
        * capital promedio
        ACN(l:fac, Val(b:fac)+Val(e:fac)+Val(h:fac)+Val(j:fac) )
        SCN(xl1, Val(l:fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(m:fac, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(j:fac)*Val(k:fac)) / Val(l:fac)  )
          SCN(xm1, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(j:fac)*Val(k:fac)))
        else
          ACN(m:fac, (Val(b:fac)*Val(c:fac)*Val(ac:fac)+Val(e:fac)*Val(f:fac)*Val(af:fac)) / (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)) )
          SCN(xm1, (Val(b:fac)*Val(c:fac)*Val(ac:fac)+Val(d:fac)*Val(e:fac)*Val(ae:fac)))
        endif
        * Plazo
        *ACN(am:fac, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac))/ Val(l:fac))
        *ACN(n:fac, Val(am:fac))
        SCN(am1, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)))
      endif

      * Total Terceros Activos
      * capital promedio
      ACN(q:fac, Val(l:fac)+Val(o:fac)  )
      SCN(xq1, Val(q:fac))
      * Tasa
      if Dialogo.Radio8 = 0
        ACN(r:fac, (Val(l:fac)*Val(m:fac)+Val(o:fac)*Val(p:fac)) / Val(q:fac)  )
        SCN(xr1, (Val(l:fac)*Val(m:fac)+Val(o:fac)*Val(p:fac)) )
      else
        ACN(r:fac, (Val(l:fac)*Val(m:fac)*Val(am:fac) / (Val(l:fac)*Val(am:fac) )
        SCN(xr1, (Val(l:fac)*Val(m:fac)*Val(am:fac)))
      endif
      * Plazo
      *ACN(ar:fac, (Val(l:fac)*Val(am:fac)) / Val(l:fac))
      *ACN(s:fac, Val(ar:fac))
      SCN(ar1, (Val(l:fac)*Val(am:fac)))

      * Para linkear
      * capital
      ACN(yv:1, Val(q:fac))
      * tasa
      ACN(yu:1, Val(r:fac))
      * plazo
      ACN(yw:1, Val(ar:fac))
    Endif

    * Vinculados
    If Dialogo.Radio6=0
      * cta.cte.vinculados
      BorrarCeldas(w1..w42)   
      (.'CTACTEVIAC'.)
      ** armar totales 
      * capital promedio
      ACN(b:fac, Val(w1)+Val(w2))
      SCN(xb1, Val(b:fac))
      * plazo
      ACN(ac:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(b:fac) )
      ACN(d:fac, Val(ac:fac) )
      * tasa
      if Dialogo.Radio8 = 0
        ACN(c:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(b:fac)  )
        SCN(xc1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(c:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xc1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ac1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))
 
      * cta.cte.divisiones
      BorrarCeldas(w1..w42)   
      (.'CTACTEDIAC'.)
      ** armar totales 
      * capital promedio
      ACN(e:fac, Val(w1)+Val(w2))
      SCN(xe1, Val(e:fac))
      * plazo
      ACN(af:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(e:fac) )
      ACN(g:fac, Val(af:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(f:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(e:fac)  )
        SCN(xf1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(f:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xf1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(af1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))

      * Colocaciones Vinculadas
      BorrarCeldas(w1..w42)   
      (.'COLOCVIN'.)
      ** armar totales 
      * capital promedio
      ACN(h:fac, Val(w1)+Val(w2))
      SCN(xh1, Val(h:fac))
      *plazo
      ACN(ai:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(h:fac) )
      ACN(j:fac, Val(ai:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(i:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(h:fac)  )
        SCN(xi1,(Val(w1)*Val(w11)+Val(w2)*Val(w21)) )
      else
        ACN(i:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xi1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ai1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )  

      * Colocaciones Divisiones
      BorrarCeldas(w1..w42)   
      (.'COLOCDIV'.)
      ** armar totales 
      * capital promedio
      ACN(k:fac, Val(w1)+Val(w2))
      SCN(xk1, Val(k:fac))
      * plazo
      ACN(al:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(k:fac) )
      ACN(m:fac, Val(al:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(l:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(k:fac)  )
        SCN(xl1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(l:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xl1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(al1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )

      * Total Vinculadas Activos
      * capital promedio
      ACN(n:fac, Val(b:fac)+Val(e:fac)+Val(h:fac)+Val(k:fac) )
      SCN(xn1, Val(n:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(o:fac, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)) / Val(n:fac)  )
        SCN(xo1, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)))
      else
        ACN(o:fac, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)) / (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)) )
        SCN(xo1, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)) )
      endif
      * Plazo
      ACN(ao:fac, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)) / Val(n:fac) )
      ACN(p:fac, Val(ao:fac))
      SCN(ao1, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)) )

      * Para linkear
      * capital
      ACN(yv:1, Val(n:fac))
      * tasa
      ACN(yu:1, Val(o:fac))
      * plazo
      ACN(yw:1, Val(ao:fac))
    Endif
  Endif

  * Operaciones Pasivas
  If Dialogo.Radio3=1
    * Terceros
    If Dialogo.Radio6=1
      *-- Obligaciones Negociables 
      BorrarCeldas(w1..w42)
      (.'OBLIGNEG'.)
      ** armar totales 
      * capital promedio
      ACN(b:fac, Val(w1)+Val(w2))
      SCN(xb1, Val(b:fac))
      * plazo
      ACN(ac:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(b:fac) )
      ACN(d:fac, Val(ac:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(c:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(b:fac)  )
        SCN(xc1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) )
      else
        ACN(c:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xc1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ac1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )

      * Comercio Exterior
      BorrarCeldas(w1..w42)
      (.'COMEXT'.)
      ** armar totales 
      * capital promedio
      ACN(e:fac, Val(w1)+Val(w2))
      SCN(xe1, Val(e:fac))
      * plazo
      ACN(af:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(e:fac) )
      ACN(g:fac, Val(af:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(f:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(e:fac)  )
        SCN(xf1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(f:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xf1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(af1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))

      * Financiaciones Locales
      BorrarCeldas(w1..w42)
      (.'FINLOC'.)
      ** armar totales 
      * capital promedio
      ACN(h:fac, Val(w1)+Val(w2))
      SCN(xh1, Val(h:fac))
      * plazo
      ACN(ai:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(h:fac) )
      ACN(j:fac, Val(ai:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(i:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(h:fac)  )
        SCN(xi1,(Val(w1)*Val(w11)+Val(w2)*Val(w21)) )
      else
        ACN(i:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xi1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ai1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))

      * Financiaciones del Exterior
      BorrarCeldas(w1..w42)
      (.'FINEXT'.)
      ** armar totales capital promedio
      ACN(k:fac, Val(w1)+Val(w2))
      SCN(xk1, Val(k:fac) )
      * plazo
      ACN(al:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(k:fac) )
      ACN(m:fac, Val(al:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(l:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(k:fac)  )
        SCN(xl1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(l:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xl1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) )
      endif
      SCN(al1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
 
      * cta.cte. terceros pasivos
      BorrarCeldas(w1..w42)
      (.'CTACTE3PA'.)
      ** armar totales 
      * capital promedio
      ACN(n:fac, Val(w1)+Val(w2))
      SCN(xn1, Val(n:fac))
      * plazo
      ACN(ao:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(n:fac) )
      ACN(p:fac, Val(ao:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(o:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(n:fac)  )
        SCN(xo1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(o:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xo1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ao1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )

      * Total Terceros Pasivos
      * capital promedio
      ACN(q:fac, Val(b:fac)+Val(e:fac)+Val(h:fac)+Val(k:fac)+Val(n:fac) )
      SCN(xq1, Val(q:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(r:fac, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)+Val(n:fac)*Val(o:fac)) / Val(q:fac)  )
        SCN(xr1, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)+Val(n:fac)*Val(o:fac)))
      else
        ACN(r:fac, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)+Val(n:fac)*Val(ao:fac)*Val(o:fac)) / (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)+Val(n:fac)*Val(ao:fac)) )
        SCN(xr1, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)+Val(n:fac)*Val(ao:fac)*Val(o:fac)))
      endif
      * Plazo
      ACN(ar:fac, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)+Val(n:fac)*Val(ao:fac)) / Val(q:fac))
      ACN(s:fac, Val(ar:fac))
      SCN(ar1, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)+Val(n:fac)*Val(ao:fac)))
  
      * Para linkear
      * capital
      ACN(yv:1, Val(q:fac))
      * tasa
      ACN(yu:1, Val(r:fac))
      * plazo
      ACN(yw:1, Val(ar:fac))
    Endif

    * Vinculados 
    If Dialogo.Radio6=0
      * cta.cte. vinculados pasivas
      BorrarCeldas(w1..w42)
      (.'CTACTEVIPA'.)
      ** armar totales 
      * capital promedio
      ACN(b:fac, Val(w1)+Val(w2))
      SCN(xb1, Val(b:fac))
      * plazo
      ACN(ac:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(b:fac) )
      ACN(d:fac, Val(ac:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(c:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(b:fac)  )
        SCN(xc1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) )
      else
        ACN(c:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xc1,(Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) )
      endif
      SCN(ac1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))

      * cta.cte. divisiones pasivas
      BorrarCeldas(w1..w42)
      (.'CTACTEDIPA'.)
      ** armar totales 
      * capital promedio
      ACN(e:fac, Val(w1)+Val(w2))
      SCN(xe1, Val(e:fac))
      * plazo
      ACN(af:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(e:fac) )
      ACN(g:fac, Val(af:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(f:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(e:fac)  )
        SCN(xf1,(Val(w1)*Val(w11)+Val(w2)*Val(w21)) )
      else
        ACN(f:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xf1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) )
      endif
      SCN(af1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)))

      * Prestamos Vinculados
      BorrarCeldas(w1..w42)
      (.'PRESTVIN'.)
      ** armar totales 
      * capital promedio
      ACN(h:fac, Val(w1)+Val(w2))
      SCN(xh1, Val(h:fac))
      *plazo
      ACN(ai:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(h:fac) )
      ACN(j:fac, Val(ai:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(i:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(h:fac)  )
        SCN(xi1, (Val(w1)*Val(w11)+Val(w2)*Val(w21))) 
      else
        ACN(i:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xi1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(ai1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
      * Prestamos Divisiones
      BorrarCeldas(w1..w42)
      (.'PRESTDIV'.)
      ** armar totales 
      * capital promedio
      ACN(k:fac, Val(w1)+Val(w2))
      SCN(xk1, Val(k:fac))
      * plazo
      ACN(al:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(k:fac) )
      ACN(m:fac, Val(al:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(l:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(k:fac)  )
        SCN(xl1, (Val(w1)*Val(w11)+Val(w2)*Val(w21)))
      else
        ACN(l:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        SCN(xl1, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)))
      endif
      SCN(al1, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
      * Total Vinculadas Pasivos
      * capital promedio
      ACN(n:fac, Val(b:fac)+Val(e:fac)+Val(h:fac)+Val(k:fac) )
      SCN(xn1, Val(n:fac))
      * tasa
      if Dialogo.Radio8 = 0
        ACN(o:fac, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)) / Val(n:fac)  )
        SCN(xo1, (Val(b:fac)*Val(c:fac)+Val(e:fac)*Val(f:fac)+Val(h:fac)*Val(i:fac)+Val(k:fac)*Val(l:fac)))
      else
        ACN(o:fac, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)) / (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)) )
        SCN(xo1, (Val(b:fac)*Val(ac:fac)*Val(c:fac)+Val(e:fac)*Val(af:fac)*Val(f:fac)+Val(h:fac)*Val(ai:fac)*Val(i:fac)+Val(k:fac)*Val(al:fac)*Val(l:fac)))
      endif
      * Plazo
      ACN(ao:fac, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)) / Val(n:fac))
      ACN(p:fac, Val(ao:fac))
      SCN(ao1, (Val(b:fac)*Val(ac:fac)+Val(e:fac)*Val(af:fac)+Val(h:fac)*Val(ai:fac)+Val(k:fac)*Val(al:fac)))
      * Para linkear
      * capital
      ACN(yv:1, Val(n:fac))
      * tasa
      ACN(yu:1, Val(o:fac))
      * plazo
      ACN(yw:1, Val(ao:fac))
    Endif
  Endif
Proximo

ifa
