    else
      ACN(f:fac,Val(xf1)/Val(af1))
    endif
    ACN(g:fac,Val(af1)/Val(xe1))
    ACN(h:fac,Val(xh1))
    if Dialogo.Radio8 = 0
      ACN(i:fac,Val(xi1)/Val(xh1))
