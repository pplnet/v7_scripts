* MARKTM - Mark to Market - Derivados Commodities -
CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;HABILES(Fsys,-1,'ARG',SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1 : 'Especie '    ;;;;;;NOVACIO(Dialogo.Especie1);'Especie Inexistente';NO;'WTI';;
  Cliente1 : 'Cliente1 '   ;;;;;;;;;;;
  Check1   : "Graba"                 ;;;;;;;;;0
  Radio1   : 'Tipo|Reales|Simuladas' ;;;;;;;;;0;;
  String1  : 'Path'        ;;;;;;;;;VAR('DIRDEFAULT')
  String2  : 'Arch. Texto' ;;;;NO;;;;;;'CURVASIM.WKS';
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

If Dialogo.Radio1=0
   ACT(a1, 'Mark to Market - Derivados Commodities -')
Else
   ACT(a1, 'Riesgo Crediticio - Derivados Commodities - ')
EndIf

ACT(a2, 'Fecha : '~Dialogo.Fecha1)

if NoVacio(Dialogo.Lista1)
  ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:4, 'Vehiculo : Todos')
endif

ACT(a6, 'ContraParte')
ACT(b6, 'Exposicion ')
ACT(c6, 'Credit Line')
ACT(d6, 'Collateral')
ACT(e6, 'Var.Exposure')
ACT(f6, 'Monto ')
AgregarMarco(a6..f6, 2,0,Exe('COLOR'))

*----A Partir de la Columna aa comienzo a listar los datos del Flujo de Fondos
*- aa2:Nro. Columna (aa) de comienzo de listados   aa3: Ultima Columna de Meses
ACN(ab1,27)
ACN(ab2,val(ab1)+1)

If Dialogo.Radio1=0
   ACT(val(ab1):1, 'Mark to Market - Flujo de Fondos  -')
Else
   ACT(val(ab1):1, 'Riesgo Crediticio - Flujo de Fondos - ')
EndIf

ACT(val(ab1):2, 'Fecha : '~Dialogo.Fecha1)

ACT(val(ab1):6, 'Cobranza o Pago')
ACT(val(ab1):7, 'Efecto Collateral')
ACT(val(ab1):8, 'N E T O ')

*- Apertura en Corto y Largo Plazo
ACT(val(ab1)+1:10, 'Corto Plazo')
ACT(val(ab1)+2:10, 'Largo Plazo')
ACT(val(ab1):11, 'Cobranza o Pago')
ACT(val(ab1):12, 'Efecto Collateral')
ACT(val(ab1):13, 'N E T O ')

*- Listo los Meses de 10 años Nro.Mes=Fila 4 Nro.Anio=Fila 3 Mes+Año=Fila 5
acn(val(ab2):3,Anio(Dialogo.Fecha1))
acn(val(ab2):4,Mes(Dialogo.Fecha1))
act(val(ab2):5,Meses(val(val(ab2):4))~"' "~Fstr(val(val(ab2):3),4,0))
aco(val(ab1),15)
aco(val(ab2),10)
scn(ab2,1)

Recorrer&j 1,120
   acn(val(ab2):4,val(val(ab2)-1:4)+1)
   acn(val(ab2):3,val(val(ab2)-1:3) )

   If val(val(ab2):4)=13
      acn(val(ab2):4,1)
      acn(val(ab2):3,val(val(ab2)-1:3)+1)
   EndIf

   act(val(ab2):5,Meses(val(val(ab2):4))~"' "~Fstr(val(val(ab2):3),4,0))
   aco(val(ab2),10)

   scn(ab2,1)      
Proximo
scn(ab2,-1)      

AgregarMarco(val(ab1)+1:5..val(ab2):5,2,0,Exe('COLOR'))
AgregarMarco(val(ab1):6..val(ab1):8,2,0,Exe('COLOR'))
AgregarMarco(val(ab1)+1:5..val(ab2):8,1,3)

*---
SetFilaActual(7)

SQL.ADD("Select DISTINCT O.Vehiculo1, O.Cliente1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.CB9='1' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1  = '"~Dialogo.Cliente1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and (O.TipoOp in ('DPDSO','DPDSS','DPBOD','DPOA','DPOD','DPRC','DPRRS','DPRS','DPS','DPBOA','DPC','DPF','DPFW','DPOGA','DPOGD','DPSV') ")
SQL.ADD(" or (O.TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL) ) )")
SQL.ADD("Union ")
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Cliente1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.CB9='1' ")
SQL.ADD("and TipoOp In ('DPOS','DPBOS','DPOGS') and O.FechaEj>'"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1  = '"~Dialogo.Cliente1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("order by 1,2")

BorrarCeldas(z2..z2)

Recorrer SQL

  if Not Eqstr(fbn('Vehiculo1'),Val(z2))
     *-- cambia empresa
     if NoVacio(Val(z2))
        act(a:fac,'Total Empresa '~Val(z2) )

        acn(b:fac, Val(w1))
        acn(d:fac, Val(w2))
        acn(e:fac, Val(w3))
        acn(f:fac, Val(w4))

        BorrarCeldas(w1..w1)
        AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..f:fac,1)
        ifa

        acn(ab2, val(ab1)+1)
        acn(ac1, val(d:fac))

        *- Recorro las Columnas del Flujo de Fondos para calcular La distribucion en corto y largo plazo
        Recorrer&j 1,val(x5)
           If Dialogo.Fecha1+365>=Fecha('01/'~Fstr(val(val(ab2):4),2,0)~'/'~Fstr(val(val(ab2):3),4,0)) 
              scn(ab:11,val(val(ab2):6))
              scn(ab:12,val(val(ab2):7))
              scn(ab:13,val(val(ab2):8))
           Else 
              scn(ac:11,val(val(ab2):6))
              scn(ac:12,val(val(ab2):7))
              scn(ac:13,val(val(ab2):8))
           EndIf

           SetFont(val(ab2):6..val(ab2):13,1)
           SetFont(ac:6..ac:13,1)
           scn(ab2,1)      
        Proximo         

        Message('*-- Creacion de Flujo de Fondos')
        ExportarWKS(val(ab1):1..val(x5):13,a1..val(x5):13,Dialogo.String1~'FF'~val(z2)~'.WKS')      
        LinkearHoja('FFMARK',1,Vehiculo1=val(z2),Entero1=val(x5),String1=Dialogo.String1,String2=Dialogo.String2)

        *- Borro los datos del Flujo
        BorrarCeldas(val(ab1)+1:6..val(ab2):8)
        BorrarCeldas(val(ab1)+1:11..val(ab2):13)

        acn(ab2, val(ab1)+1)
        acn(x3, 0)
        acn(x4, 0)
        acn(x5, 0)
     endif

     *-- Asignar Empresa
     act(z2, fbn('Vehiculo1'))
     act(a:fac,'Empresa '~Val(z2) )
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,1)
     ifa

     *- Vehiculo del Flujo de Fondos
     ACT(val(ab1):4, 'Vehiculo : '~Val(z2))
  endif

  act(a:fac,fbn('Cliente1') )

  * Calculo la Exposicion 
  LinkearHoja('OPMARK',1,Fecha1=Dialogo.Fecha1,Lista1=val(z2)~'|',Cliente1=fbn('Cliente1'),Especie1=Dialogo.Especie1,Radio1=Dialogo.Radio1,String1=Dialogo.String1,String2=Dialogo.String2)
   
  SetFont(a:fac..b:fac+2, 2)

  *- Link de valores para Mark to Market 
  ACN(b:fac  , LinkH(1, bv1))


  * CerrarHoja('OPMARK',1,Fecha1=Dialogo.Fecha1,Lista1=val(z2)~'|',Cliente1=fbn('Cliente1'),Especie1=Dialogo.Especie1,Radio1=Dialogo.Radio1,String1=Dialogo.String1,String2=Dialogo.String2)
  * CerrarLink(1)

  *-- Recupero los datos de las Lineas de Credito 
  SQL.ADD("Select * from "~DBO~".LINCREDITOCOMM  Where ")
  SQL.ADD("Cliente='"~FBN['Cliente1']~"' and ")
  SQL.ADD("Vehiculo='"~FBN['Vehiculo1']~"' ")

  Recorrer SQL
    dfa
    * Credit Line => Si Exposicion>0 (Ganancia) => Linea de Credito Otorgada
    *                Si Exposicion<0 (Perdida ) => Linea de Credito Recibida
    IF val(b:fac)>=0 
       acn(c:fac,FBN['LineaOtorgada'])
    Else 
       acn(c:fac,-FBN['LineaRecibida'])
    EndIf
    ACN(g:fac,FBN['MinAmount'])
    ACN(h:fac,FBN['Redondeo'])
    ACN(i:fac,FBN['DesdeMonto'])
    ACT(j:fac,FBN['CollateralAnex'])
  Proximo 

  *-- Recupero los saldos de las TEMIND para el Dia anterior a la emision del informe 
  *-- AV1: Vehiculo1 AV2: Cliente1 AF1: Fecha AE1: Especie
  * Devuelve Resultado en AR1

  ACT(AV1,val(z2))
  ACT(AV2,FBN['Cliente1'])
  ACD(AF1,Dialogo.Fecha1)
  ACT(AE1,BuscarCampo('ESPECIES','Cotiza','Codigo',Dialogo.Especie1))

  (."DCTEMIND".)

  * Saldo de TEMIND con signo cambiado
  ACN(d:fac,VAL(ar1))

  *-- Calculo Variacion Exposure 
  * Segun el signo de la exposicion
  ACN(e:fac,VAL(b:fac)-VAL(c:fac))

  IF val(b:fac)>=0
     * Vehiculo gana
     SCN(e:fac,-val(d:fac))
  Else
     SCN(e:fac,+val(d:fac))
  EndIf

  If EqStr(val(j:fac),'SI')
     *- Calculo el Monto a cobrar o pagar
        *- m: Exposicion Redondeada 
        *- k: Parte entera a Pagar l: Resto 
        acn(k:fac,Trunc(Abs(val(b:fac))/val(h:fac)))
        acn(l:fac,(Abs(val(b:fac))/val(h:fac))-val(k:fac))
        acn(m:fac,(val(k:fac)+1)*val(h:fac))

        IF val(b:fac)>=0         
           *- Si es Ganancia
           *--- Si el Abs(Exposicion)>Abs(CreditLine) -> Monto=Abs(Exposicion)-Abs(CreditLine)-Collateral
           *--- Si el Abs(Exposicion)<Abs(CreditLine) -> Monto=-Collateral
           If val(m:fac)>Abs(val(c:fac))
              acn(f:fac,val(m:fac)-Abs(val(c:fac))-val(d:fac))                 
           Else
              acn(f:fac,-val(d:fac))                 
           EndIf
       Else 
           *- Si es Perdida
           *--- Si el Abs(Exposicion)>Abs(CreditLine) -> Monto=-(Abs(Exposicion)-Abs(CreditLine)+Collateral )
           *--- Si el Abs(Exposicion)<Abs(CreditLine) -> Monto=-Collateral
           If val(m:fac)>Abs(val(c:fac))
              acn(f:fac,-(val(m:fac)-Abs(val(c:fac))+val(d:fac)) )                 
           Else
              acn(f:fac,-val(d:fac) )                 
           EndIf
       EndIf          
       If Abs(val(f:fac))<val(i:fac)
          *- Comparo el Monto con el DesdeMonto. Si no lo supera el monto es 0
          acn(f:fac,0 )                 
       EndIf
  EndIf

  *- Link de valores para Flujo de Fondos x1: Desde Fila x2: Hasta Fila 
  *- x3: Fecha Liq.  x4: Max.Fecha Recuperada x5: Max.Columna de Flujo de Fondos

  ACN(x1, LinkH(1, bv2))
  ACN(x2, LinkH(1, bv3))

  * Recorro las Fechas de Liquidacion del Detalle de Operaciones  
  acn(ac1, val(d:fac))

  BorrarCeldas(z26..z27)

  Recorrer&i val(x1),val(x2)
      
      acd(x3 , LinkH(1, n:&i))
      acd(x4 , Max(val(x3),val(x4)))

      acn(ab2, val(ab1)+1)

      *- Corte de control por mes y año de liquidacion
      *- Acumulo en z:26 el total por contraparte y por dia
      *- z:27 Dia anterior
      If [Not [Mes(val(z27))=Mes(val(x3)) y Anio(val(z27))=Anio(val(x3))]] y NoVacio(val(z26))
         *- Cambio de Fecha => Distribuyo el collateral
         *- Actualizo el flujo de fondos recorriendo las Columnas
         Recorrer&j 1,120
           If Mes(val(z27))=val(val(ab2):4) y Anio(val(z27))=val(val(ab2):3)
              scn(val(ab2):6, val(z26) )
              acn(x5, Max(val(x5),val(ab2)))

              *---- CALCULO DE EFECTO COLLATERAL: Collateral + = Cobrado            Flujo Positivo: A Cobrar
              Message('Monto '~val(z26) )
              Message('Collateral '~val(ac1) )
 
              *- Distribucion del Collateral
              If val(z26)<>0 y val(ac1)<>0
                 message('Cobro '~Fstr(val(z26),0,2))
                 message('Resto Collateral  '~Fstr(val(ac1),0,2))
 
                 *- Si el signo de Flujo y Collateral es el Mismo -> Uso solo la porcion correspondiente al flujo 
                 *- Caso A y C
                 If val(z26)*val(ac1)>0 
                    message('Afecta ')
                    If Abs(val(ac1))>Abs(val(z26))
                       scn(val(ab2):7,-val(z26))
                       scn(ac1, -val(z26))
                    Else 
                       scn(val(ab2):7,-val(ac1))
                       scn(ac1, -val(ac1))
                    EndIf
                    message('Efecto Collateral  '~Fstr(val(val(ab2):7),0,2))
                 EndIf          
              EndIf     
       
              *- Calculo del Neto
              acn(val(ab2):8,val(val(ab2):7)+val(val(ab2):6))       
 
              SetFont(val(ab2):6..val(ab2):13,1)
              SetFont(ac:6..ac:13,1) 
           EndIf
           scn(ab2,1)      
         Proximo
      EndIf

      If Not [Mes(val(z27))=Mes(val(x3)) y Anio(val(z27))=Anio(val(x3))]
         acd(z27,val(x3))
         acn(z26, 0)
      EndIf

      acn(z16, LinkH(1, m:&i))
      scn(z26, val(z16))        
  Proximo 

  If NoVacio(val(z26))
     acn(ab2, val(ab1)+1)

     *- Cambio de Fecha => Distribuyo el collateral
     *- Actualizo el flujo de fondos recorriendo las Columnas
     Recorrer&j 1,120
        If Mes(val(z27))=val(val(ab2):4) y Anio(val(z27))=val(val(ab2):3)
           scn(val(ab2):6, val(z26) )
           acn(x5, Max(val(x5),val(ab2)))

           *---- CALCULO DE EFECTO COLLATERAL: Collateral + = Cobrado            Flujo Positivo: A Cobrar
           Message('Monto '~val(z26) )
           Message('Collateral '~val(ac1) )
 
           *- Distribucion del Collateral
           If val(z26)<>0 y val(ac1)<>0
              message('Cobro '~Fstr(val(z26),0,2))
              message('Resto Collateral  '~Fstr(val(ac1),0,2))

              *- Si el signo de Flujo y Collateral es el Mismo -> Uso solo la porcion correspondiente al flujo 
              *- Caso A y C
              If val(z26)*val(ac1)>0 
                 message('Afecta ')
                 If Abs(val(ac1))>Abs(val(z26))
                    scn(val(ab2):7,-val(z26))
                    scn(ac1, -val(z26))
                 Else 
                    scn(val(ab2):7,-val(ac1))
                    scn(ac1, -val(ac1))
                 EndIf
                 message('Efecto Collateral  '~Fstr(val(val(ab2):7),0,2))
              EndIf          
           EndIf     
           *- Calculo del Neto
           acn(val(ab2):8,val(val(ab2):7)+val(val(ab2):6))       
 
           SetFont(val(ab2):6..val(ab2):13,1)
           SetFont(ac:6..ac:13,1) 
        EndIf
        scn(ab2,1)      
     Proximo
  EndIf

  AgregarMarco(a:fac..f:fac,1)
  SetFont(a:fac..f:fac,1)

  scn(w1,Val(b:fac))
  scn(w2,Val(d:fac))
  scn(w3,Val(e:fac))
  scn(w4,Val(f:fac))

  SetFont(a:fac..m:fac,2)
proximo


* ultimo total Empresa
ifa
if NoVacio(Val(z2))
   act(a:fac,'Total Empresa '~Val(z2) )

   acn(b:fac, Val(w1))
   acn(d:fac, Val(w2))
   acn(e:fac, Val(w3))
   acn(f:fac, Val(w4))

   BorrarCeldas(w1..w1)
   AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..f:fac,1)

        acn(ab2, val(ab1)+1)
        acn(ac1, val(d:fac))

        *- Recorro las Columnas del Flujo de Fondos para calcular La distribucion en corto y largo plazo
        Recorrer&j 1,val(x5)
           If Dialogo.Fecha1+365>=Fecha('01/'~Fstr(val(val(ab2):4),2,0)~'/'~Fstr(val(val(ab2):3),4,0)) 
              scn(ab:11,val(val(ab2):6))
              scn(ab:12,val(val(ab2):7))
              scn(ab:13,val(val(ab2):8))
           Else 
              scn(ac:11,val(val(ab2):6))
              scn(ac:12,val(val(ab2):7))
              scn(ac:13,val(val(ab2):8))
           EndIf

           SetFont(val(ab2):6..val(ab2):13,1)
           SetFont(ac:6..ac:13,1)
           scn(ab2,1)      
        Proximo         

   Message('*-- Creacion de Flujo de Fondos')

   ExportarWKS(val(ab1):1..val(x5):13,a1..val(x5):13,Dialogo.String1~'FF'~val(z2)~'.WKS')
   LinkearHoja('FFMARK',1,Vehiculo1=val(z2),Entero1=val(x5),String1=Dialogo.String1,String2=Dialogo.String2)
endif

BorrarCeldas(w1..w12)
AgregarMarco(a:fac..f:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..f:fac,2)

ACO(1,15)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)

SetFont(a1..val(ab2):13, 1)
SetFont(a8..z:fac, 2)
FormatoCeldas(b7..f:fac, Exe('F2N'))
*AlinearCeldas(e:6..f:fac+1,'D')
*AlinearCeldas(j:6..m:fac+1,'D')

LimitesVision(F:fac+1)

if Dialogo.Check1=1 
   If Vacio(Dialogo.Lista1)
      ACT(lo1,'TODOS')
   Else 
      ACT(lo1,Dialogo.Lista1)
   EndIf

   ACT(lo1,val(lo1)~"/"~Dialogo.Fecha1)

   If NoVacio(Dialogo.Especie1)
      ACT(lo1,val(lo1)~"/"~Dialogo.Especie1)
   EndIf

   ACT(lo1,val(lo1)~"/"~Fstr(Dialogo.Radio1,0,0))

   If Vacio(Dialogo.Lista1)
      GrabarPMG('MARKTM', val(lo1))
   Else 
      GrabarPMG('MARKTM', val(lo1))
   EndIf
endif

LimitesVision(F:fac+1)
Impresion(1,2)
