ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  : 'Fecha'         ;;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;FSys
  Cliente1: 'Cliente'       ; ;;;;;Vacio(Dialogo.Cliente1) o [EsTerminal(Dialogo.Cliente1,Clientes) y Not EqStr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN') y Not EqStr(BuscarCampo('CLIENTES','Persona','Codigo',Dialogo.Cliente1),'SI')];'Cliente incorrecto';NO;;;;;;;;;" isnull(Sector,' ')<>'BAN' and  isnull(Persona,' ')<>'SI'  "
  Check1:   'Solo c/Asist.' ;;;;;NO;;;;;1
FinDialogo
if Not OK
  Cancelar
endif

if NoVacio(Dialogo.Cliente1)
  if NOT EsTerminal(Dialogo.Cliente1,Clientes)
     ACT(v1, Dialogo.Cliente1)
  else
    Cancelar('Cliente no vßlido')
  endif 
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')


SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC, 'Control de Limites de Graduacion (BCRA) - Diario')
ACT(a:FAC+2, 'Fecha de Proceso: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif

ACT(l:FAC+2, 'RPC')
ACT(m:FAC+2, 'Porcentaje')
ACT(n:FAC+2, 'Limite')

ACN(l:FAC+3, BuscarCampo('CLIENTES','Valor3','Codigo',Var('VEHICULODE')))

ACN(m:FAC+3, VAR('BCGRARPC'))

ACN(n:FAC+3, Val(l:FAC+3)*Val(m:FAC+3)/100)
AlinearCeldas(i:FAC+2..n:FAC+2,'D')
*FormatoCeldas(i:FAC+3..n:FAC+5,Exe('F0'))
*FormatoCeldas(j:FAC+3..j:FAC+5,Exe('F2'))
*FormatoCeldas(m:FAC+3..m:FAC+5,Exe('F2'))

AgregarMarco(l:FAC+3..n:FAC+3,2,3)

ACT(a:FAC+7, 'Clientes')
ACT(b:FAC+7, 'Patrimonio')
ACT(b:FAC+8, '100 %')
ACT(c:FAC+7, 'Fecha')
ACT(c:FAC+8, 'Cert.Pat.')
ACT(e:FAC+6, Pad('',13)~'Exposicion')
ACT(d:FAC+7, 'Prestamos No Garantiz.')
ACT(d:FAC+8, 'Capital')
ACT(e:FAC+8, 'Intereses')
ACT(f:FAC+8, 'Comisiones')

ACT(g:FAC+7, 'Prestamos Garantizados')
ACT(g:FAC+8, 'Capital')
ACT(h:FAC+8, 'Intereses')
ACT(i:FAC+8, 'Comisiones')

ACT(j:FAC+7, 'Otras')
ACT(j:FAC+8, 'Deudas')
ACT(k:FAC+8, 'Total')
ACT(m:FAC+5, 'Com. "A" 2373')
ACT(l:FAC+6, Pad('',6)~'Control sobre patrimonio Deudor')
ACT(l:FAC+7, 'Exceso')
ACT(l:FAC+8, 's/ '~VAR('BCGRATMAX')~'%')
ACT(m:FAC+7, 'Exceso')
ACT(m:FAC+8, 's/ '~VAR('BCGRATMIN')~'%')
ACT(n:FAC+7, 'Exceso '~VAR('BCGRATMIN')~'%')
ACT(n:FAC+8, 'vs '~VAR('BCGRARPC')~'% RPC')

SetFont(a:FAC..n:FAC+8,2)

AgregarMarco(a:FAC+7..c:FAC+8,2,2,EXE('COLOR10'))

AgregarMarco(d:FAC+6..k:FAC+6,2,0,EXE('COLOR10'))
AgregarMarco(d:FAC+7..f:FAC+7,2,0,EXE('COLOR10'))
AgregarMarco(g:FAC+7..i:FAC+7,2,0,EXE('COLOR10'))
AgregarMarco(d:FAC+8..f:FAC+8,2,2,EXE('COLOR10'))
AgregarMarco(g:FAC+8..i:FAC+8,2,2,EXE('COLOR10'))
AgregarMarco(j:FAC+7..k:FAC+8,2,2,EXE('COLOR10'))

AgregarMarco(l:FAC+5..n:FAC+5,2,0,EXE('COLOR2'))
AgregarMarco(l:FAC+6..n:FAC+6,2,0,EXE('COLOR10'))
AgregarMarco(l:FAC+7..n:FAC+8,2,2,EXE('COLOR10'))

SetFilaActual(FAC+8)
acn(w3,fac)
ACD(z2, Dialogo.Fecha1)

SQL.ADD("SELECT C.Codigo, Jerarquia, PatrimonioPesos, FechaBal FROM "~DBO~".CLIENTES C  ")
SQL.ADD("join "~DBO~".CATEGORIACLIENTES CT on C.CategDepositante = CT.Codigo WHERE")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" C.Codigo='"~val(v1)~"' and ")
endif
*SQL.ADD("isnull(Sector,' ')<>'BAN' ")
SQL.ADD("CT.Sector <> 'FIN' ")
SQL.ADD("and isnull(Persona,' ')<>'SI' ")
SQL.ADD("and exists(select 1 from "~DBO~".LIMCONSUMIDOS where Limite in ('BCRAN','ACIDN','ACCON','BCRAG','ACIDG','ACCOG','ACMAN') and Cliente=C.Codigo) ")
SQL.ADD("ORDER BY substring(Jerarquia,1,3),C.Codigo   ")

Recorrer SQL 
  if EsTerminal(fbn['Codigo'],Clientes)
    ACT(jj1,Copy(fbn['Jerarquia'],1,3))
    ACT(z1, fbn['Codigo'])

    if Not EqStr(val(pp1),val(jj1))
      if val(q:fac-1)=1
        dfa
      endif
      ACT(a:fac,SQL("Select RazonSocial from "~DBO~".CLIENTES where Jerarquia like '"~val(jj1)~"000000000000' "))
      ACT(pp1,val(jj1))      
      ACT(p:fac,val(jj1))
      ACN(q:fac,1)
      ifa
    endif

    ACT(a:FAC, fbn['Codigo'])
    ACN(b:FAC, fbn['PatrimonioPesos'])  
    if fbn['FechaBal']>0
      ACD(c:FAC, fbn['FechaBal'])  
    endif

    ACT(p:fac,val(jj1))
    
    ACN(d:FAC, LimConsumido(val(z1),'BCRAN','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(e:FAC, LimConsumido(val(z1),'ACIDN','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(f:FAC, LimConsumido(val(z1),'ACCON','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(g:FAC, LimConsumido(val(z1),'BCRAG','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(h:FAC, LimConsumido(val(z1),'ACIDG','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(i:FAC, LimConsumido(val(z1),'ACCOG','ARP',0,Var('VEHICULODE'),,,,val(z2)))
    ACN(j:FAC, LimConsumido(val(z1),'ACMAN','ARP',0,Var('VEHICULODE'),,,,val(z2)))

    ACN(k:FAC, Sum(d:FAC..j:FAC))

    if Val(k:FAC)>Val(b:FAC)*VAR('BCGRATMAX')/100
      ACN(l:FAC, Val(k:FAC)-Val(b:FAC)*VAR('BCGRATMAX')/100)
    endif
    if Val(k:FAC)>Val(b:FAC)*VAR('BCGRATMIN')/100
      ACN(m:FAC, Val(k:FAC)-Val(b:FAC)*VAR('BCGRATMIN')/100)
      if Val(k:FAC)-Val(b:FAC)*VAR('BCGRATMIN')/100>Val(n:Val(w1)+3)
        ACN(n:FAC, Val(k:FAC)-Val(b:FAC)*VAR('BCGRATMIN')/100-Val(n:Val(w1)+3))
      endif
    endif
    if Val(l:FAC)>0 o Val(n:FAC)>0
      ColorCeldas(a:fac..z:fac,ClRed) 
    endif
    if Dialogo.Check1=1 y not val(k:fac)>0
        BorrarCeldas(a:fac..z:fac)  
        dfa     
    endif
  else
    dfa
  endif
proximo
*ExportarWKS(bi:1..bk:Val(bh:1),a:1..c:Val(bh:1), 'ASIEXC.WKS')

*OrdenarFilas(Val(w1)+11,FAC,16,'A')
*SetFont(a:Val(w1)+11..p:FAC,1)
*FormatoCeldas(b:Val(w1)+11..b:FAC,Exe('F0R'))
*FormatoCeldas(d:Val(w1)+11..n:FAC,Exe('F0R'))
*FormatoCeldas(c:Val(w1)+11..c:FAC,Exe('F0'))

if val(q:fac)=1
  BorrarCeldas(a:fac..z:fac)
  dfa  
endif

recorrer&i Val(w1)+9,FAC+1
  if Not EqStr(Copy(Val(p:&i),1,3),Copy(Val(p:&i-1),1,3))
    if Val(y1)>1
      AgregarMarco(a:&i-Val(y1)+1..n:&i-1,1,3)
    endif
    if &i<FAC+1
      SetFont(a:&i,2)
      AgregarMarco(a:&i..n:&i,1,0)
      ACN(y1,0)
    endif
  endif
  SCN(y1,1)
proximo

if FAC>Val(w3)
  SetFilaActual(FAC+1)
  ACN(w4,FAC)
  ACT(c:fac, 'Totales')
  ACN(d:fac, Sum(d:Val(w3)+1..d:fac-1))
  ACN(e:fac, Sum(e:Val(w3)+1..e:fac-1))
  ACN(f:fac, Sum(f:Val(w3)+1..f:fac-1))
  ACN(g:fac, Sum(g:Val(w3)+1..g:fac-1))
  ACN(h:fac, Sum(h:Val(w3)+1..h:fac-1))
  ACN(i:fac, Sum(i:Val(w3)+1..i:fac-1))
  ACN(j:fac, Sum(j:Val(w3)+1..j:fac-1))
  ACN(k:fac, Sum(k:Val(w3)+1..k:fac-1))
  ACN(l:fac, Sum(l:Val(w3)+1..l:fac-1))
  ACN(m:fac, Sum(m:Val(w3)+1..m:fac-1))
  ACN(n:fac, Sum(n:Val(w3)+1..n:fac-1))
  SetFont(a:fac..n:fac,2)
  *FormatoCeldas(d:fac..n:fac,Exe('F0R'))
  AgregarMarco(c:fac..n:fac,1,2)
endif 

ACO(1,8)
ACO(2,10)
ACO(3,7)
ACO(4,8)
ACO(5,7)
ACO(6,8)
ACO(7,7)
ACO(8,7)
ACO(9,7)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)
ACO(14,8)
ACO(15,5)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC,2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(n:FAC)
RangoTitulo(a:1..n:FAC, Val(w1)+8)

SetPrintFit(3,85)