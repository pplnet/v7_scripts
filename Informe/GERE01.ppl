ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Veh¡culo"                ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio1     : "Tipo|Todos|Rta.Fija|Rta.Vble." ;;;;;;;;;0
  Especie1   : "Especie"                 ;;;
  Cliente1   : "Contraparte"             ;;;
  Radio2     : "Opcion|Todos|Call|Put"         ;;;;;;;;;0
  Radio3     : "Oper.|Todos|Compra|Venta"      ;;;;;;;;;0
  Fecha1     : "F.Desde" ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Fecha2     : "F.Hasta" ;;;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys
  Radio4     : "Fecha|Concert.|Ejercicio"      ;;;;;;;;;0
  Radio5     : "Consolidado|No|Si"             ;;;;;;;;;0
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Valuacion de Opciones de Titulos Publicos o Privados")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Veh¡culo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Veh¡culo : Todos')
endif
ACT(a:FAC+2, 'Tipo Especie : '~iif(Dialogo.Radio1=0,'Todos',iif(Dialogo.Radio1=1,'Renta Fija','Renta Variable')))
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+3, 'Especie : Todos')
endif
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+4, 'Contraparte : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
 else
  ACT(a:FAC+4, 'Contraparte : Todos')
endif
ACT(a:FAC+5, 'Opcion : '~iif(Dialogo.Radio2=0,'Todos',iif(Dialogo.Radio2=1,'Call','Put')))
ACT(a:FAC+6, 'Operacion : '~iif(Dialogo.Radio3=0,'Todos',iif(Dialogo.Radio3=1,'Compra','Venta')))
ACT(a:FAC+7, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+8, 'Fecha Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+9, 'Fecha Ordenamiento : '~iif(Dialogo.Radio4=0,'Concertacion','Ejercicio'))
If Dialogo.Radio5=1
   ACT(a:FAC+10,'Consolidado por Vehiculo')
EndIf
SetFont(a:fac..N:FAC+10,2)
SetFilaActual(FAC+11)

SQL.ADD("Select CASE E.Tipo WHEN 'PUB' THEN 'F' WHEN  'ONE' THEN 'F' WHEN 'PRI' THEN 'V' ELSE 'V' END Tip, E.Cotiza , O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".ESPECIES E  ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.TipoOp In ('DPBOA','DPBOD','DPBOS','DPOA','DPOD','DPOGA','DPOGD','DPOGS','DPOS','DSEO','DTO','DTOM','DTOV') ")
if Dialogo.Radio4 = 0
   SQL.ADD(" and  O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
else
   SQL.ADD(" and  O.FechaEj between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
SQL.ADD(" and E.Tipo In ('PUB','ONE','PRI') ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if Dialogo.Radio1 = 1
   SQL.ADD(" and E.Tipo In ('PUB','ONE') ")
endif
if Dialogo.Radio1 = 2
   SQL.ADD(" and E.Tipo In ('PRI') ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if Dialogo.Radio2 = 1
   SQL.ADD(" and O.MB1 = '0' ")
endif
if Dialogo.Radio2 = 2
   SQL.ADD(" and O.MB1 = '1' ")
endif
if Dialogo.Radio3 = 1
   SQL.ADD(" and O.MB3 = '0' ")
endif
if Dialogo.Radio3 = 2
   SQL.ADD(" and O.MB3 = '1' ")
endif
If Dialogo.Radio5=0
   SQL.ADD("order by E.Cotiza, O.Vehiculo1,1, ")
   SQL.ADD("         O.Especie, O.MB1, O.PrecioEj, O.MB3, "~iif(Dialogo.Radio4=0,'O.FechaOp','O.FechaEj')~", O.Cliente1 ")
Else
   SQL.ADD("order by E.Cotiza,1, ")
   SQL.ADD("         O.Especie, O.MB1, O.PrecioEj, O.MB3, "~iif(Dialogo.Radio4=0,'O.FechaOp','O.FechaEj')~", O.Vehiculo1,O.Cliente1 ")
EndIf

acn(x1,9)
act(v1,' ')
act(v2,' ')
act(v3,' ')
act(v5,' ')
act(v6,' ')

* Subtotales de Resultado
acn(w5,0)
acn(w6,0)

* Subtotales de Valor Contrato
acn(w15,0)
acn(w16,0)

Recorrer SQL

  *-- Especie y Tipo de Opcion
  if Not EqStr(val(v5),fbn['Especie']~' '~IIf(EqStr(fbn['MB1'],'0'),'Call','Put')) o Not EqStr(val(v1),fbn['Cotiza']) o [Dialogo.Radio5=0 y Not EqStr(val(v2),fbn['Vehiculo1'])] o Not EqStr(val(v3),fbn['Tip'])
     If Not EqStr(val(v5),' ')
        act(a:fac,'   SubTotal '~val(v5))         
        acn(l:fac,VAL(w15))
        acn(m:fac,VAL(w5))
        FormatoCeldas(l:fac..m:fac,Exe('F2'))
        SetFont(a:fac..m:FAC,2)
        ifa
     EndIf
     act(v5,fbn['Especie']~' '~IIf(EqStr(fbn['MB1'],'0'),'Call','Put'))
     acn(w5,0)
     acn(w15,0)
  endif

  if Not EqStr(val(v6),fbn['Especie']) o Not EqStr(val(v1),fbn['Cotiza']) o Not EqStr(val(v1),fbn['Cotiza']) o [Dialogo.Radio5=0 y Not EqStr(val(v2),fbn['Vehiculo1'])] o Not EqStr(val(v3),fbn['Tip'])
     If Not EqStr(val(v6),' ')
        act(a:fac,'Total de '~val(v6))         
        FormatoCeldas(l:fac..m:fac,Exe('F2'))
        acn(l:fac,VAL(w16))
        acn(m:fac,VAL(w6))
        FormatoCeldas(l:fac..m:fac,Exe('F2'))
        SetFont(a:fac..m:FAC,2)
        ifa
     EndIf
     act(v6,fbn['Especie'])
     acn(w6,0)
     acn(w16,0)
  endif

  If Not EqStr(val(v1),fbn['Cotiza'])
     ifa
     act(a:fac,'Moneda de la Especie: '~BuscarCampo('Especies','Nombre','Codigo',fbn['Cotiza']))
     act(v1,fbn['Cotiza'])
     SetFont(a:fac..r:FAC,3)
     ifa
     ifa
     If Dialogo.Radio5=0
        act(a:fac,'Vehiculo: '~fbn['Vehiculo1']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['Vehiculo1']))
        act(v2,fbn['Vehiculo1'])
        SetFont(a:fac..r:FAC,2)
        ifa
        ifa
     EndIf
     act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
     act(v3,fbn['Tip'])
     SetFont(a:fac..r:FAC,2)
     ifa
     ifa
     ACT(j:FAC, 'Valor Prima')
     ACT(l:FAC, 'Valor')
     AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))
     AgregarMarco(j:FAC..k:FAC,2,0,Exe('COLOR'))
     AgregarMarco(l:FAC..l:FAC,2,0,Exe('COLOR'))
     AgregarMarco(m:FAC..m:FAC,2,0,Exe('COLOR'))
     SetFont(a:fac..m:FAC,2)
     ifa
     ACT(a:FAC, 'Nro.Oper.')
     ACT(b:FAC, 'F.Concert.')
     ACT(c:FAC, 'F.Final')
     ACT(d:FAC, 'Especie')
     ACT(e:FAC, 'Opcion')
     ACT(f:FAC, 'Operacion')
     ACT(g:FAC, 'Strike')
     ACT(h:FAC, 'Contraparte')
     ACT(i:FAC, 'Notional')
     ACT(j:FAC, 'Origen')
     ACT(k:FAC, 'Mercado')
     ACT(l:FAC, 'Contrato')
     ACT(m:FAC, 'Resultado')
     SetFont(a:fac..m:FAC,2)
     AgregarMarco(a:FAC..m:FAC,2,2,Exe('COLOR'))
     ifa
  endif

  if Dialogo.Radio5=0 y Not EqStr(val(v2),fbn['Vehiculo1'])
     ifa
     act(a:fac,'Vehiculo: '~fbn['Vehiculo1']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['Vehiculo1']))
     act(v2,fbn['Vehiculo1'])
     SetFont(a:fac..r:FAC,2)
     ifa
     ifa
     act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
     act(v3,fbn['Tip'])
     SetFont(a:fac..r:FAC,2)
     ifa
     ifa
     ACT(j:FAC, 'Valor Prima')
     ACT(l:FAC, 'Valor')
     AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))
     AgregarMarco(j:FAC..k:FAC,2,0,Exe('COLOR'))
     AgregarMarco(l:FAC..l:FAC,2,0,Exe('COLOR'))
     AgregarMarco(m:FAC..m:FAC,2,0,Exe('COLOR'))
     SetFont(a:fac..m:FAC,2)
     ifa
     ACT(a:FAC, 'Nro.Oper.')
     ACT(b:FAC, 'F.Concert.')
     ACT(c:FAC, 'F.Final')
     ACT(d:FAC, 'Especie')
     ACT(e:FAC, 'Opcion')
     ACT(f:FAC, 'Operacion')
     ACT(g:FAC, 'Strike')
     ACT(h:FAC, 'Contraparte')
     ACT(i:FAC, 'Notional')
     ACT(j:FAC, 'Origen')
     ACT(k:FAC, 'Mercado')
     ACT(l:FAC, 'Contrato')
     ACT(m:FAC, 'Resultado')
     SetFont(a:fac..m:FAC,2)
     AgregarMarco(a:FAC..m:FAC,2,2,Exe('COLOR'))
     ifa
  endif

  if Not EqStr(val(v3),fbn['Tip'])
     ifa
     act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
     act(v3,fbn['Tip'])
     SetFont(a:fac..r:FAC,2)
     ifa
     ifa
     ACT(j:FAC, 'Valor Prima')
     ACT(l:FAC, 'Valor')
     AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))
     AgregarMarco(j:FAC..k:FAC,2,0,Exe('COLOR'))
     AgregarMarco(l:FAC..l:FAC,2,0,Exe('COLOR'))
     AgregarMarco(m:FAC..m:FAC,2,0,Exe('COLOR'))
     SetFont(a:fac..m:FAC,2)
     ifa
     ACT(a:FAC, 'Nro.Oper.')
     ACT(b:FAC, 'F.Concert.')
     ACT(c:FAC, 'F.Final')
     ACT(d:FAC, 'Especie')
     ACT(e:FAC, 'Opcion')
     ACT(f:FAC, 'Operacion')
     ACT(g:FAC, 'Strike')
     ACT(h:FAC, 'Contraparte')
     ACT(i:FAC, 'Notional')
     ACT(j:FAC, 'Origen')
     ACT(k:FAC, 'Mercado')
     ACT(l:FAC, 'Contrato')
     ACT(m:FAC, 'Resultado')
     SetFont(a:fac..m:FAC,2)
     AgregarMarco(a:FAC..m:FAC,2,2,Exe('COLOR'))
     ifa
  endif
  act(a:fac,fbn['NrOperacion'])
  aclo(a:fac,fbn['NrOperacion'])
  acd(b:fac,fbn['FechaOp'])
  ACD(c:FAC, fbn['FechaEj'])
  act(d:fac, fbn['Especie'])
  if fbn['MB1'] = 0
     act(e:fac,'Call')
  else    
     act(e:fac,'Put')
  endif
  if fbn['MB3'] = 0
     act(f:fac,'Compra')
  else    
     act(f:fac,'Venta')
  endif

  acn(g:fac,fbn['PrecioEj'])
  act(h:fac, fbn['Cliente1'])
  acn(i:fac,fbn['TotalAux1'])

*  if Vacio(fbn['Precio1']) o fbn['Precio1'] = 0
*     acn(j:fac,fbn['TotalAux1']/fbn['Cantidad'])
*    else
     acn(j:fac,fbn['Precio1'])
*  endif


  if fbn['CB8'] = 0

     acn(k:fac,Cotizacion(fbn['Especie'],iif(fbn['MB1']=0,'CAL','PUT'),IdxDate(fbn['FechaEj']),fbn['PrecioEj'],Fsys,1))
     acn(l:fac,fbn['Cantidad']*val(k:fac)*fbn['TotalBrutoCli1'])

     *-- Si Es Venta el Valor del Contrato es Negativo
     If fbn['MB3']=1 
        acn(l:fac,-val(l:fac))        
     EndIf

  endif

     if fbn['MB3'] = 0
        *** compra call ***
        *acn(m:fac,fbn['Cantidad']*(val(k:fac)-val(j:fac))*Cotizacion(fbn['Cotiza'],,,,Fsys,1))
        * acn(m:fac, ((val(k:fac)-val(j:fac))*val(i:fac) )/100 )

       if fbn['CB8'] = 1
         act(k:fac,'Ejercida')
         act(l:fac,'Ejercida')
         acn(m:fac,fbn['Precio4']-fbn['TotalNetoCli1'])
       else
         acn(m:fac, val(l:fac)-fbn['TotalNetoCli1'])
       endif

     else
        *acn(m:fac,fbn['Cantidad']*(val(j:fac)-val(k:fac))*Cotizacion(fbn['Cotiza'],,,,Fsys,1))
        * acn(m:fac, ((val(j:fac)-val(k:fac))*val(i:fac) )/100 )

       if fbn['CB8'] = 1
         act(k:fac,'Ejercida')
         act(l:fac,'Ejercida')
         acn(m:fac,fbn['Precio4']+fbn['TotalNetoCli1'])
       else
         acn(m:fac, fbn['TotalNetoCli1']+val(l:fac))
       endif

     endif
     FormatoCeldas(k:fac..k:fac,Exe('F8'))

  scn(w5,val(m:fac))
  scn(w6,val(m:fac))
  scn(w15,val(l:fac))
  scn(w16,val(l:fac))

  SetFont(a:FAC..m:FAC,1)

  FormatoCeldas(i:fac..i:fac,Exe('F2'))
  FormatoCeldas(g:fac..g:fac,Exe('F7'))
  FormatoCeldas(j:fac..j:fac,Exe('F8'))
  FormatoCeldas(l:fac..m:fac,Exe('F2'))
proximo
Ifa

If Not EqStr(val(v5),' ')
   act(a:fac,'   SubTotal '~val(v5))         
   acn(l:fac,VAL(w15))
   acn(m:fac,VAL(w5))
   SetFont(a:fac..m:FAC,2)
   FormatoCeldas(l:fac..m:fac,Exe('F2'))
   ifa
EndIf

If Not EqStr(val(v6),' ')
   act(a:fac,'Total de '~val(v6))         
   acn(l:fac,VAL(w16))
   acn(m:fac,VAL(w6))
   SetFont(a:fac..m:FAC,2)
   FormatoCeldas(l:fac..m:fac,Exe('F2'))
   ifa
EndIf

ACO(1,7)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,8)
ACO(6,8)
ACO(7,10)
ACO(8,8)
ACO(9,11)
ACO(10,10)
ACO(11,10)
ACO(12,11)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(m:FAC)

*RangoTitulo(a1..k:8,36)

