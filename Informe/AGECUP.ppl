ModoReproceso(SINDIALOGO)
CrearDialogo
   Lista1 : 'Especie' ;;;;;;;;;;;SQLSET("SELECT DISTINCT Especie FROM "~DBO~".AGENDACUPONES ORDER BY Especie ") 
FinDialogo

IF Not Ok
   Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(d1, "INFORME DE AGENDA CUPONES")
SetFont(d1,3)

ACT(m2, "Fecha: ")
ACD(o2, FSys)
SetFont(m2..o2,2)

ACT(a4, "NrCupon")
ACT(b4, "Tipo Cupon")
ACT(c4, "Estado")
ACT(d4, "Fecha Corte")
ACT(e4, "Fecha Pago")
ACT(f4, "F.Pago Original")
ACT(g4, "TNA")
ACT(h4, "% Renta")
ACT(i4, "% Amort.")
ACT(j4, "% Am.Int.Capital")
ACT(k4, "Tasa Cap.Int.")
ACT(l4, "% Renta Ant.")
ACT(m4, "F.Cambio Tasa")
ACT(n4, "Int.Capitaliz.")
ACT(o4, "Fecha Proceso")
ACT(p4, "V.Teor.Ant.")
ACT(q4, "Pcio. Cupon")

ACN(ha1, 4)
SetFilaActual(Val(ha1))

AlinearCeldas(a4..q4,'C')
SetFont(a4..q4,2)
AgregarMarco(a4..q4,2,0,Exe('COLOR'))

SQL.ADD("SELECT A.Especie, CONVERT(integer, A.NrCupon) NrCupon, A.FechaCorte, A.FechaPago,       ")
SQL.ADD("       A.PorRenta, A.PorAmCapital, A.TipoCupon, A.Estado, A.VTeoricoAnt, A.PorAmIntCap, ")
SQL.ADD("       A.TasaCapInt, A.PorRentaAnterior, A.FechaCambioTasa, A.IntsCapitalizados,        ")
SQL.ADD("       A.FechaProceso, A.PrecioCupon, E.Nombre, A.TNA, A.FechaPagoOriginal              ")
SQL.ADD("FROM "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE A.Especie = E.Codigo ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD("ORDER BY 1, 2 ")

ACT(z1, '')
Recorrer SQL
   Message('Especie: '~FBN['Especie'])
   IF Not EqStr(FBN['Especie'], Val(z1))
      ACT(z1, FBN['Especie'])
      ACT(a:fac, FBN['Especie'])
      ACT(b:fac, FBN['Nombre'])
      SetFont(a:fac..b:fac,2)
      AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))
      ifa
   ENDIF

   ACN(a:fac, FBN['NrCupon'])
   IF EqStr(FBN['TipoCupon'],'REN')
      ACT(b:fac, 'Renta')
   ELSE
      IF EqStr(FBN['TipoCupon'],'AMO')
         ACT(b:fac, 'Amortiz.')
      ELSE
         IF EqStr(FBN['TipoCupon'],'RYA')
            ACT(b:fac, 'Renta y Amort.')
         ELSE
            ACT(b:fac, '')
         ENDIF
      ENDIF
   ENDIF
   IF EqStr(FBN['Estado'],'PEN')
      ACT(c:fac, 'Pendiente')
      ColorCeldas(c:fac, clRED)
   ELSE
      ACT(c:fac, 'Procesado')
      ColorCeldas(c:fac, clGREEN)
   ENDIF
   ACD(d:fac, FBN['FechaCorte'])
   ACD(e:fac, FBN['FechaPago'])
   ACD(f:fac, FBN['FechaPagoOriginal'])
   
   IF FBN['TNA'] <> 0
      ACN(g:fac, FBN['TNA'])
   ENDIF
   IF FBN['PorRenta'] <> 0
      ACN(h:fac, FBN['PorRenta'])
   ENDIF
   IF FBN['PorAmCapital'] <> 0
      ACN(i:fac, FBN['PorAmCapital'])
   ENDIF
   IF FBN['PorAmIntCap'] <> 0
      ACN(j:fac, FBN['PorAmIntCap'])
   ENDIF
   IF FBN['TasaCapInt'] <> 0
      ACN(k:fac, FBN['TasaCapInt'])
   ENDIF
   IF FBN['PorRentaAnterior'] <> 0
      ACN(l:fac, FBN['PorRentaAnterior'])
   ENDIF
   IF FBN['FechaCambioTasa'] <> 0
      ACD(m:fac, FBN['FechaCambioTasa'])
   ENDIF
   IF FBN['IntsCapitalizados'] <> 0
      ACN(n:fac, FBN['IntsCapitalizados'])
   ENDIF
   IF FBN['FechaProceso'] <> 0
      ACD(o:fac, FBN['FechaProceso'])
   ENDIF
   IF FBN['VTeoricoAnt'] <> 0
      ACN(p:fac, FBN['VTeoricoAnt'])
   ENDIF
   IF FBN['PrecioCupon'] <> 0
      ACN(q:fac, FBN['PrecioCupon'])
   ENDIF

   SetFont(a:fac..q:fac,1)
   FormatoCeldas(a:fac,Exe('F0'))
   FormatoCeldas(g:fac..l:fac,Exe('F7'))
   FormatoCeldas(n:fac,Exe('F7'))
   FormatoCeldas(o:fac..q:fac,Exe('F7'))
Proximo

ACO(1, 5)
ACO(2, 10)
ACO(3, 10)
ACO(4, 8)
ACO(5, 8)
ACO(6, 9)
ACO(8, 8)
ACO(9, 8)
ACO(10, 8)
ACO(11, 8)
ACO(12, 8)
ACO(13, 8)
ACO(14, 8)
ACO(15, 8)
ACO(16, 8)

SetFilaActual(fac+2)
ACT(a:fac, "FIN DEL LISTADO")
SetFont(a:fac,2)

LimitesVision(q:fac)
Impresion(1,2)
SetPrintFit(3,80)
RangoTitulo(a:1..q:fac, Val(ha1))
