CrearDialogo
  NrOperacion1: 'NrOperacion' ;1;1;;;;;;;;;;;;"TipoOp in ('TICF','TIVF','FXCF','FXVF')"
  Fecha1:       'Fecha'       ;2;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha invalida';NO;FSys;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))

ACT(a:4,'Detalle MTM Operacion')
SetFont(a:4,1)

SetFilaActual(6)

If NoVacio(Dialogo.NrOperacion1)
   ACT(A:FAC,'NrOperacion: '~Dialogo.NrOperacion1)
Else
   ACT(A:FAC,'NrOperacion: Todos')
EndIf
ACT(A:FAC+1,'Fecha: '~Dialogo.Fecha1)

SetFont(A:FAC..A:FAC+2,2)

SetFilaActual(FAC+3)

ACT(A:FAC,'NrOperacion')
ACT(B:FAC,'Fecha MTM')
ACT(C:FAC,'PrecioIni')
ACT(D:FAC,'PrecioFin')
ACT(E:FAC,'Tipo Precio')
ACT(F:FAC,'Liquida')
ACT(G:FAC,'Valor MTM')
ACT(H:FAC,'Valor MTM Especie')
AlinearCeldas(A:FAC..H:FAC,'C')
AgregarMarco(A:FAC..H:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..H:FAC,2)

SQL.ADD(" Select M.NrOperacion, M.Fecha, M.PrecioAyer, M.PrecioHoy, M.MTM ValorMTM, M.MTMEspecie ValorMTMEspecie, M.TipoMTM, ")
SQL.ADD("   Case ME.MTM when 0 Then 'No Aplica' when 1 Then 'SI' else 'NO' End Liquida, ME.Regulado ")
SQL.ADD("   From "~DBO~".MTMDIARIO M")
SQL.ADD("         LEFT JOIN "~DBO~".OPERACIONES O ON M.NrOperacion = O.NrOperacion  ")
SQL.ADD("         LEFT JOIN "~DBO~".MERCADOS ME ON O.Mercado4 = ME.Codigo  ")
SQL.ADD("  Where M.NrOperacion= '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Order by Fecha ")
watch(SQL.BATCH())
ACN(Z:1,FAC+1)
ACN(Z:2,0)

Recorrer SQL
  If Val(Z:2)=0
     ACT(A:FAC,FBN['NrOperacion'])
     ACLO(A:FAC,FBN['NrOperacion'])
  EndIf
  ACD(B:FAC,FBN['Fecha'])
  ACN(C:FAC,FBN['PrecioAyer'])
  ACN(D:FAC,FBN['PrecioHoy'])
  ACT(E:FAC,'Normal')
  ACT(F:FAC,FBN['Liquida'])
  AlinearCeldas(F:FAC,'C')
  if Eqstr(FBN['TipoMTM'],'FIX') y Eqstr(FBN['Regulado'],'NO') y Eqstr(FBN['Liquida'],'No Aplica')
    ACN(G:FAC,FBN['ValorMTM']-val(TO:1))
    ACN(H:FAC,FBN['ValorMTMEspecie']-val(TO:2))
  else
    ACN(G:FAC,FBN['ValorMTM'])
    ACN(H:FAC,FBN['ValorMTMEspecie'])
  endif  
  SCN(TO:1,Val(G:FAC))
  SCN(TO:2,Val(H:FAC))  
  ACN(Z:2,1)
  
  SetFont(A:FAC..M:FAC,3)
Proximo

FormatoCeldas(C:Val(Z:1)..D:FAC, Exe('F8'))
FormatoCeldas(G:Val(Z:1)..H:FAC, Exe('F2'))
SetFont(A:Val(Z:1)..F:FAC,3)

IFA
ACT(A:FAC,'Total:')
ACN(G:FAC,Val(TO:1))
ACN(H:FAC,Val(TO:2))
AgregarMarco(A:FAC..H:FAC,2,0)
SetFont(A:FAC..G:FAC,2)

IFA
IFA

ACT(A:FAC,'FIN DEL INFORME')
SetFont(A:FAC,2)

LimitesVision(I:FAC+1)

ACO(1,9)
ACO(2,8)
ACO(3,8)
ACO(4,9)
ACO(5,9)
ACO(6,9)
ACO(7,10)
ACO(8,10)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,12)
ACO(13,12)

