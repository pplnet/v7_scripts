CrearDialogo
  Especie1 :'Especie'                         ;1;1;;  ;;NoVacio(Dialogo.Especie1);'Especie Invalida';NO;
  Especie2 :'Cupon'                           ;1;2;;NO;;;;;;BuscarCampo('ESPECIES','Alias3','Codigo', Dialogo.Especie1);
  Entero1  :'Nr Cupon'                        ;3;1;;  ;;NoVacio(Dialogo.Entero1);'Nr. de Cupon Invalido';NO;;BuscarCampo('ESPECIES','Cupon','Codigo', Dialogo.Especie2);
  Fecha1   :'F. Corte'                        ;3;2;;NO;;Dialogo.Fecha1<>0;'Fecha de Corte Invalida';NO;;IIF(NoVacio(Dialogo.Especie1), SQL(" Select FechaCorte From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~Fstr(Dialogo.Entero1, 1, 0)~"' "), FSYS);
  Radio1   :'Operaciones|Compra/Vta|Opciones' ;5;1;;NO;NO;;;;0;
  Vehiculo1  : 'Vehiculo'                     ;7;1;;;;[NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Debe Ingresar un Vehiculo Valido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")
CrearFont(5,"Arial,14,B")

ACO( 1, 4)
ACO( 2, 6)
ACO( 3, 5)
ACO( 4, 7)
ACO( 5, 7)
ACO( 6, 5)
ACO( 7, 8)
ACO( 8, 6)
ACO( 9, 8)
ACO( 10, 8)
ACO( 11, 6)
ACO( 12, 8)
ACO( 13, 8)

SetFilaActual(2)
ACT(C:fac, 'CORTE DE OPERACIONES A LIQUIDAR')
SetFont(C:fac, 2)
SetFilaActual(fac+2)
IF Dialogo.Radio1 = 0
    ACT(A:fac, 'Tipos de Operacion: Cpra/Vta')
    ifa
ELSE
    ACT(A:fac, 'Tipos de Operacion: Opciones')
    ifa
ENDIF
ACT(A:fac, 'Especie: '~Dialogo.Especie1)
ifa
ACT(A:fac, 'Cupon: '~Dialogo.Especie2)
ifa
ACT(A:fac, 'Nro. Cupon: '~Fstr(Dialogo.Entero1, 2, 0))
ifa
ACT(A:fac, 'Fecha de Corte: '~Dialogo.Fecha1)
SetFont(A:fac-4..A:fac, 2)
ifa

***---Titulos de Columnas
ACT(A:fac, 'TipoOp')
ACT(B:fac, 'Operacion')
ACT(C:fac, 'Cliente')
ACT(D:fac, 'Fecha Op.')
ACT(E:fac, 'Fecha Vto.')
ACT(F:fac, 'Especie')
ACT(G:fac, 'Cantidad')
ACT(H:fac, 'Precio')
ACT(I:fac, 'Total Bruto')
ACT(J:fac, 'Total Neto')

If Dialogo.Radio1=1
    ACT(G:fac, 'FechaEj')
    ACT(H:fac, 'PrecioEj')
    ACT(H:fac+1, 'Post Corte')
    ACT(I:fac, 'Cantidad')
    ACT(J:fac, 'Prima')
    ACT(K:fac, 'Monto')
    ACT(K:fac+1, 'Total')
    ACT(L:fac, 'PrecioEj')
    ACT(L:fac+1, 'Pre Corte')
    ACO( 10, 6)
    ACO( 11, 8)
    ACO( 12, 6)
ENDIF


IF Dialogo.Radio1 = 0
    SetFont(A:fac..M:fac+1, 2)
    AlinearCeldas(A:fac..M:fac+1,'C')
    AgregarMarco(A:fac..M:fac+1,0,0,Exe('COLOR'))
ELSE
    SetFont(A:fac..L:fac+1, 2)
    AlinearCeldas(A:fac..L:fac+1,'C')
    AgregarMarco(A:fac..L:fac+1,0,0,Exe('COLOR'))
ENDIF

SetFilaActual(fac+2)

ACN(FI:1, fac)

If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6, Dialogo.Vehiculo1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else
      ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
Endif


SQL.ADD("SELECT Distinct O.NrOperacion, O.Cliente1, O.FechaOp, O.FechaVto, O.Especie, ")
SQL.ADD(" O.Cantidad, O.Precio1, O.TotalBrutoCli1, O.TotalNetoCli1, O.Precio2, ")
SQL.ADD(" O.TotalBrutoCli2, O.TotalNetoCli2, O.Cotizacion1, O.TotalBrutoCli3, ")
SQL.ADD(" O.TotalNetoCli3, O.TipoOp ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE M.NrOperacion=O.NrOperacion  ")
SQL.ADD(" AND E.Codigo = '"~Dialogo.Especie1~"' and O.Especie=E.Codigo ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND O.Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Order By O.NrOperacion ")

Recorrer SQL

    ACT(A:fac, fbn('TipoOp'))
    ACT(B:fac, fbn('NrOperacion'))
    ACLO(B:fac, fbn('NrOperacion'))
    ACT(C:fac, fbn('Cliente1'))
    ACT(D:fac, fbn('FechaOp'))
    ACT(E:fac, fbn('FechaVto'))
    ACT(F:fac, fbn('Especie'))
    ACN(G:fac, fbn('Cantidad'))
    ACN(H:fac, fbn('Precio1'))
    ACN(I:fac, fbn('TotalBrutoCli1'))
    ACN(J:fac, fbn('TotalNetoCli1'))
    ACN(K:fac, fbn('Precio2'))
    ACN(L:fac, fbn('TotalBrutoCli2'))
    ACN(M:fac, fbn('TotalNetoCli2'))

    FormatoCeldas(K:fac, Exe('F6'))
    FormatoCeldas(I:fac..J:fac, Exe('F2'))
    FormatoCeldas(L:fac..M:fac, Exe('F2'))

    If Dialogo.Radio1=1
       ACT(G:fac, fbn('FechaEj'))
       ACN(H:fac, fbn('PrecioEj'))
       ACN(I:fac, fbn('Cantidad'))
       ACN(J:fac, fbn('Precio1'))
       ACN(K:fac, fbn('TotalNetoCli1'))
       ACN(L:fac, fbn('Cotizacion2'))
       FormatoCeldas(L:fac, Exe('F6'))
       FormatoCeldas(K:fac, Exe('F2'))
    ENDIF

    FormatoCeldas(H:fac, Exe('F6'))
    SetFont(A:fac..l:fac, 1)
Proximo

IF Dialogo.Radio1 = 0
   AgregarMarco(A:Val(FI:1)..M:fac,0,0)
ELSE
   AgregarMarco(A:Val(FI:1)..L:fac,0,0)
ENDIF

ifa
ACT(A:fac, 'Fin Del Informe')
SetFont(A:fac, 2)
LimitesVision(j:fac+2)

Impresion(1, 2)