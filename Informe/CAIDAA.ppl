ModoReproceso(SinDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "Fecha Vigencia"    ;;;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Fecha2     : "Fecha Desde"       ;;;;;;[Dialogo.Fecha2 = Dialogo.Fecha1] O [Dialogo.Fecha2 = PriDeMes(Dialogo.Fecha2, SI) Y Dialogo.Fecha2 >= Dialogo.Fecha1];'Fecha Desde Invalida';NO;Fsys;
  Fecha3     : "Fecha Hasta"       ;;;;;;[Dialogo.Fecha3 >= Dialogo.Fecha2 Y Dialogo.Fecha3 = FinDeMes(Dialogo.Fecha3, SI)] O [Dialogo.Fecha3 = 0 Y Dialogo.Radio3 = 2];'Fecha Hasta Invalida';NO;FinDeMes(Fsys, SI);
  Especie1   : "Especie"           ;;;;;;;;;;;;;
  Cliente1   : "Entidad"           ;;;;;;;;;;;;;
  Check1     : "Capital"           ;1;2;;;;;;;1
  Check2     : "Interes"           ;;;;;;;;;1
  Check3     : "Impuestos"         ;;;;;;;;;1
  Radio1     : "Expresado|ARP|USD" ;;;;;;;;;1
  Radio3     : "Tipo|Diario|Mensual|Anual" ;5;2;;;;;;;0
  Radio5     : "TasaSimulada|NO|SI";6;1;;NO;NO;;;;1
  Radio4     : "Consolidado|NO|SI" ;6;2;;;;;;;0
  Lista2     : 'Tipo Op.'          ;8;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo IN ('MMPCCV','VIMIND','VIMINM','TEMIND','MMCPM','MMPCCM','MMCP','MMO','MMDCA','MMD','MMCDIA','MMCCR','MMCDP','FXCS','FXCSV','FXVS','FXVSV','FXCT','FXVT','FXAS','FXAT','FCS','FCR','SECS','SEVS','SECT','SEVT','SERA','SERP') ");
  Lista1     : "Vehiculo"          ;2;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACT(LS:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(LS:1100, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo IN ('MMPCCV','VIMIND','VIMINM','TEMIND','MMCPM','MMPCCM','MMCP','MMO','MMDCA','MMD','MMCDIA','MMCCR','MMCDP','FXCS','FXCSV','FXVS','FXVSV','FXCT','FXVT','FXAS','FXAT','FCS','FCR','SECS','SEVS','SECT','SEVT','SERA','SERP') "))

SetFilaActual(2)

ACT(a:FAC," Caida de Prestamos al "~Dialogo.Fecha1~" "~IIF(Dialogo.Radio3=0,' (Diario) ',  IIF(Dialogo.Radio3 = 1, ' (Mensual) ', ' (Anual) ')))
SetFont(a:fac..a:fac,3)

SetFilaActual(3)

ACT(A:fac+1, 'Fecha Desde: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista2)
  ACT(D:FAC+1, 'Tipo Op.: '~Dialogo.Lista2)
else
  ACT(D:FAC+1, 'Tipo Op.: Todas')
endif
ACT(A:fac+2, 'Fecha Hasta: '~IIF(Dialogo.Fecha3 <> 0, Dialogo.Fecha3, 'Vto. de las operaciones'))
if NoVacio(Dialogo.Cliente1)
  ACT(D:FAC+3, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(D:FAC+3, 'Entidad : Todos')
endif
if NoVacio(Dialogo.Lista1)
  ACT(D:FAC+4, 'Vehiculos : '~Dialogo.Lista1)
else
  ACT(D:FAC+4, 'Vehiculos : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+4, 'Especie : Todas')
endif
act(D:fac+2,'Expresado en Miles de '~IIF(Dialogo.Radio1=0, Var('MONELOCA'), Var('MONEEXTR')))
IF Dialogo.Radio4 = 0
    ACT(A:fac+3, 'NO Consolidado')
ELSE
    ACT(A:fac+3, 'Consolidado')
ENDIF

If Dialogo.Check1=1
   act(a:fac+5,val(a:fac+5)~'CAPITAL - ')
EndIf
If Dialogo.Check2=1
   act(a:fac+5,val(a:fac+5)~'Interes - ')
EndIf
If Dialogo.Check3=1
   act(a:fac+5,val(a:fac+5)~'Impuestos -')
EndIf

SetFont(a:fac..N:FAC+5,2)
SetFilaActual(FAC+6)
SetFont(a:FAC..c:FAC,2)
acn(c:400,fac)
SetFilaActual(FAC+1)
IF Dialogo.Fecha3 = 0
    ***---Si no se ingresa Fecha Hasta, asumo hasta la col. 50 que son unos 40 anios. Si se
    ***---necesita modificarlo hacerlo en esta celda
    ACN(UC:1000, 50)
ENDIF

acn(d:400,fac)

*lista años desde col 2

acd(B:fac  ,Dialogo.Fecha2 )
acd(B:fac+1,FinDeMes(Dialogo.Fecha2,SI))
acn(B:fac+2,Anio(val(B:fac)) )
IF Dialogo.Radio3 = 0
    ***---Diario
    Recorrer&k 3, 10000
        IF Val(&k-1:fac) = FinDeMes(Val(&k-1:fac), NO, 'ARG') Y Not Eqstr(Val(&k-1:fac), 'Subtotal')
            ACT(&k:fac, 'Subtotal')
        ELSE
            IF Eqstr(Val(&k-1:fac), 'Subtotal')
                IF Habiles(Val(&k-2:fac), 1, 'ARG', SI) <= Dialogo.Fecha3
                    ACD(&k:fac, Habiles(Val(&k-2:fac), 1, 'ARG', SI))
                ELSE
                    ACT(&k:fac, 'TOTAL')
                    ACN(CL:900, &k)
                    Break
                ENDIF
            ELSE
                IF Habiles(Val(&k-1:fac), 1, 'ARG', SI) <= Dialogo.Fecha3
                    ACD(&k:fac, Habiles(Val(&k-1:fac), 1, 'ARG', SI))
                ELSE
                    ACT(&k:fac, 'TOTAL')
                    ACN(CL:900, &k)
                    Break
                ENDIF
            ENDIF
        ENDIF
    Proximo
ELSE
    IF Dialogo.Radio3 = 1
        ***---Mensual
        Recorrer&k 3, 1000
            IF FinDeMes(SumarMeses(Val(&k-1:fac), 1), SI) <= Dialogo.Fecha3
                ACD(&k:fac, PriDeMes(SumarMeses(Val(&k-1:fac), 1), SI))
                ACD(&k:fac+1, FinDeMes(SumarMeses(Val(&k-1:fac), 1), SI))
                ACN(&k:fac+2, Anio(Val(&k:fac+1)))
            ELSE
                ACT(&k:fac, 'TOTAL')
                ACN(CL:900, &k)
                Break
            ENDIF
        Proximo
        FormatoCeldas(3:fac+2..250:fac+2, Exe('F0'))
    ELSE
        ***---Anual
        ACN(BD:1000, 0)
        Recorrer&k 1, 4
            ***---Determino en que trimestre esta Fecha Desde
            IF Mes(Dialogo.Fecha2) >= (&k*3)-2 Y Mes(Dialogo.Fecha2) <= &k*3
                ***---Esta en el trimestre &k
                ACN(TR:1000, &k)
                ACD(B:fac+1, Fecha('01/'~Fstr((3*&k)-2, 2, 0)~'/'~Fstr(Anio(Dialogo.Fecha2), 4, 0)))
                ACD(B:fac+2, FinDeMes(Fecha('01/'~Fstr((3*&k), 2, 0)~'/'~Fstr(Anio(Dialogo.Fecha2), 4, 0)), SI))
                ***---Determino cuantos trimestres adiciono, hasta completar el anio siguiente o hasta Dialogo.Fecha3
                ACN(TT:1000, 8-&k+4)
                ***---El 4 sumado es: 2 por col. TOTAL y 2 por arrancar de col. Nro. 3
                Recorrer&j 3, Val(TT:1000)
                    ***---Trimestres Siguientes al primero
                    IF Val(&j-1:fac+2) = FinDeMes(Fecha(Fstr(Dia(Val(&j-1:fac+2)), 2, 0)~'/12/'~Fstr(Anio(Val(&j-1:fac+2)), 4, 0)), SI) Y Not Eqstr(Val(&j-1:fac+1), 'TOTAL')
                        ***---Es fin de anio, => Total
                        ACT(&j:fac+1, 'TOTAL')
                        SCN(BD:1000, 1)
                        ACN(CJ:1000, &j)
                    ELSE
                        IF Val(BD:1000) = 2
                            ***---Ultimo trimestre
                            Break
                        ELSE
                            IF Not Eqstr(Val(&j-1:fac+1), 'TOTAL')
                                IF SumarMeses(Val(&j-1:fac+1), 3) <= Dialogo.Fecha3 O Dialogo.Fecha3 = 0
                                    ACD(&j:fac+1, SumarMeses(Val(&j-1:fac+1), 3))
                                    ACD(&j:fac+2, FinDeMes(SumarMeses(Val(&j-1:fac+2), 3), SI))
                                ELSE
                                    IF Dialogo.Fecha3 <> 0
                                        ACT(&j:fac+1, 'TOTAL')
                                        ACN(CJ:1000, &j)
                                        Break
                                    ENDIF
                                ENDIF
                            ELSE
                                IF SumarMeses(Val(&j-2:fac+1), 3) <= Dialogo.Fecha3 O Dialogo.Fecha3 = 0
                                    ACD(&j:fac+1, SumarMeses(Val(&j-2:fac+1), 3))
                                    ACD(&j:fac+2, FinDeMes(SumarMeses(Val(&j-2:fac+2), 3), SI))
                                ELSE
                                    IF Dialogo.Fecha3 <> 0
                                        ACT(&j:fac+1, 'TOTAL')
                                        ACN(CJ:1000, &j)
                                        Break
                                    ENDIF
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                Proximo
                Break
            ENDIF
        Proximo
        ***---Escribo los anios posteriores
        ACN(Val(CJ:1000):fac, Anio(Val(Val(CJ:1000)-1:fac+1)))
        IF Dialogo.Fecha3 = 0
            Recorrer&k Val(CJ:1000)+1, Val(UC:1000)
                ACN(&k:fac, Val(&k-1:fac)+1)
            Proximo
            ACN(CL:900, Val(UC:1000)+1)
            ACT(Val(CL:900):fac, 'TOTAL')
        ELSE
            Recorrer&k Val(CJ:1000)+1, 1000
                IF Val(&k-1:fac)+1 <= Anio(Dialogo.Fecha3)
                    ACN(&k:fac, Val(&k-1:fac)+1)
                ELSE
                    ACN(CL:900, &k-1)
                    IF Val(&k-1:fac) > Anio(Dialogo.Fecha1)
                        ***---Hay mas de un anio
                        ACT(&k:fac, 'TOTAL')
                        SCN(CL:900, 1)
                    ENDIF
                    Break
                ENDIF
            Proximo
        ENDIF
    ENDIF
ENDIF

***---CX:1, Cotizacion $ en U$S
***---CX:2, Cotizacion U$S en $
***---EX:1, Expresado
***---Las fechas segun Diario, Mensual o Anual quedaron asi en FI:1, FI:2 y FI:3
***---          Diario          Mensual         Anual(Trimestral)         Anual
***---FI:1 =   05/02/2002      01/03/2002            2002                 2002
***---FI:2 =                   31/03/2002         01/01/2002 
***---FI:3 =                     2002             31/03/2002
ACN(CX:1, CotizacionC(Var('MONELOCA'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
ACN(CX:2, CotizacionC(Var('MONEEXTR'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
ACN(EX:1, 1000)

ACN(FI:1, fac)
ACN(FI:2, fac+1)
ACN(FI:3, fac+2)
ACN(TO:1, 0)
ACN(TO:2, 0)
ACN(TO:3, 0)
ACN(CL:999, 9)
ACN(XJ:1, 0)

ifa
*CAPITAL no definitivos = VN Actual
*CAPITAL definitivos = Imp. Amortizacion
*Monto no definitivos = VN Actual + INTERES Total + Comisiones - EF
*Monto definitivos = Imp. Amortizacion + INTERES Total + Comisiones - EF

***---MV:1 se usa para compratir las funciones con informe Anticuacion de Deuda
ACN(MV:1, 0)

IF Dialogo.Check1 = 1
    (.'CAIDA1A'.)
ENDIF
IF Dialogo.Check2 = 1
    IF Dialogo.Check1 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'CAIDA1B'.)
ENDIF
IF Dialogo.Check3 = 1
    IF Dialogo.Check1 = 1 O Dialogo.Check2 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'CAIDA1C'.)
ENDIF

IF Dialogo.Radio4 = 0
    SQL.ADD(" Order By 1, 8, 7, 11, 6, 5 ")
ELSE
    SQL.ADD(" Order By 8, 7, 11, 6, 5 ")
ENDIF

*b:400 valor de la columna
acn(z:400,2)
ACT(x:400,' ')
ACN(FI:4, fac)
ACN(FI:1000, 0)
ACN(MV:1, 0)

***---Inicializo Totales
Recorrer&k 2, Val(CL:900)
    ACN(16000:&k, 0)
    ACN(16001:&k, 0)
Proximo

Recorrer SQL
    Message(fbn['Clave']~' '~fbn['Vto']~' '~fbn['NrOperacion'])
    ACN(XJ:1, 1)
    ACT(ES:1, fbn('Especie'))
    ACN(IM:2, fbn('Importe'))
if no
    IF [Dialogo.Radio5 = 1] Y [fbn('BD1') = 1 O [fbn('BD1') = 2 Y Not Eqstr(fbn('DescImp'), 'COMISIONES')]] Y [Not Eqstr(fbn('TipoTasa'), 'FIJA')] Y fbn('NrCuota') > 0 y FBN['Tasa']=0
       Message(' ***---Tasa = 0, pidio ficticia y no es fija. (Interes o impuesto)')

       IF Incluido(fbn('Tipo'),'SWAP|SCAP/FLOOR')
           ACT(NT:1, fbn('OperacionRef'))
       ELSE
           ACT(NT:1, fbn('NrOperacion'))
       ENDIF
       (.'MONTOTOMV'.)
       DFA
       IF fbn('BD1') = 1
           ACN(IM:2, Val(MT:2))
       ELSE
           IF Eqstr(fbn('DescImp'), 'WHT')
               ACN(IM:2, Val(MT:4))
           ELSE
               ***---Impuesto al interes
               ACN(IM:2, Val(MT:5))
           ENDIF
       ENDIF
    ENDIF
endif
    IF Dialogo.Radio1 = 0
        ***---Expresado en $
        IF Eqstr(Val(ES:1), Var('MONELOCA'))
            ACN(IM:1, Val(IM:2))
        ELSE
            IF Eqstr(Val(ES:1), Var('MONEEXTR'))
                ACN(IM:1, Val(IM:2) * Val(CX:2))
            ELSE
                ACN(CX:3, CotizacionC(Val(ES:1),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
                ACN(IM:1, Val(IM:2) * Val(CX:3))
            ENDIF
        ENDIF
    ELSE
        ***---Expresado en U$S
        IF Eqstr(Val(ES:1), Var('MONEEXTR'))
            ACN(IM:1, Val(IM:2))
        ELSE
            IF Eqstr(Val(ES:1), Var('MONELOCA'))
                ACN(IM:1, Val(IM:2) * Val(CX:1))
            ELSE
                ACN(CX:3, CotizacionC(Val(ES:1),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
                ACN(IM:1, Val(IM:2) * Val(CX:3))
            ENDIF
        ENDIF
    ENDIF
     * Corte x Cliente o Vehiculo
     if Not EqStr(val(x:400),fbn['Clave']) Y Dialogo.Radio4 = 0
        IF Val(FI:1000) > 0
            ***---No es Primer registro No Consolidado
            AgregarMarco(A:Val(FM:1)..Val(CL:900):fac-1, 0, 0)
            ACT(A:fac, 'TOTAL '~Val(BD:5))
            AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
            ACN(FU:1, 1)
            (.'TOTCAIDA8'.)
            SetFilaActual(fac+2)
            ACT(A:fac, 'TOTAL '~Val(BD:6))
            AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, RGB(197,196,255))
            SetFont(A:fac-2..Val(CL:900):fac, 2)
            SetFilaActual(fac+2)
        ENDIF
        ACN(TF:1000, 0)
        acn(y:400,2)
        act(x:400,fbn['Clave'])
        act(a:fac,fbn['Clave'])
        SetFont(A:fac, 5)
        ACT(BD:6, fbn('Clave'))
        ifa
        ACN(CL:999, fbn('BD1'))
        ACT(CL:1000, fbn('DescImp'))
        IF NoVacio(fbn('Grupo'))
            ACT(CL:800, fbn('Grupo'))
        ELSE
            ACT(CL:800, Copy(Mayusculas2(BuscarCampo('TIPOSOPERACION','Nombre','Codigo', fbn('TipoOp'))), 6, 32))
        ENDIF
        ACT(CL:500, fbn('Especie'))
        IF fbn('BD1') = 0
            ACT(A:fac, 'CAPITAL')
            ACT(BD:5, 'CAPITAL')
        ENDIF
        IF fbn('BD1') = 1
            ACT(A:fac, 'INTERES')
            ACT(BD:5, 'INTERES')
        ENDIF
        IF fbn('BD1') = 2
            ACT(A:fac, fbn('DescImp'))
            ACT(BD:5, fbn('DescImp'))
        ENDIF
        AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
        SetFont(A:fac..Val(CL:900):fac, 2)
        ifa
        ACT(A:fac, Val(CL:800))
        BorrarCeldas(ES:2..ES:2)
        SetFont(A:fac, 4)
        ACN(FI:1000, fac)
        ACN(FM:1, fac)
     Else 
        IF fbn('BD1') <> Val(CL:999)
            ***---Corte de Control: Cap - Int - Imp
            IF Val(FI:1000) > 0
                ***---No es Primer registro Consolidado
                AgregarMarco(A:Val(FM:1)..Val(CL:900):fac-1, 0, 0)
                ACT(A:fac, 'TOTAL '~Val(BD:5))
                AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
                ***---Sumarizo
                ACN(FU:1, 2)
                (.'TOTCAIDA8'.)
                SetFont(A:fac..Val(CL:900):fac, 2)
                SetFilaActual(fac+2)
            ENDIF
            ACN(FM:1, fac+1)
            ACN(CL:999, fbn('BD1'))
            ACT(CL:1000, fbn('DescImp'))
            IF NoVacio(fbn('Grupo'))
                ACT(CL:800, fbn('Grupo'))
            ELSE
                ACT(CL:800, Copy(Mayusculas2(BuscarCampo('TIPOSOPERACION','Nombre','Codigo', fbn('TipoOp'))), 6, 32))
            ENDIF
            ACT(CL:500, fbn('Especie'))
            IF fbn('BD1') = 0
                ACT(A:fac, 'CAPITAL')
                ACT(BD:5, 'CAPITAL')
            ENDIF
            IF fbn('BD1') = 1
                ACT(A:fac, 'INTERES')
                ACT(BD:5, 'INTERES')
            ENDIF
            IF fbn('BD1') = 2
                ACT(A:fac, fbn('DescImp'))
                ACT(BD:5, fbn('DescImp'))
            ENDIF
            AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
            SetFont(A:fac..Val(CL:900):fac, 2)
            ifa
            ACT(A:fac, Val(CL:800))
            BorrarCeldas(ES:2..ES:2)
            SetFont(A:fac, 4)
            ACN(FI:1000, fac)
        ELSE
            IF Not Eqstr(fbn('DescImp'), Val(CL:1000)) Y fbn('BD1') = 2
                ***---Cambio de Impuesto
                AgregarMarco(A:Val(FM:1)..Val(CL:900):fac-1, 0, 0)
                ACT(A:fac, 'TOTAL '~Val(BD:5))
                AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
                ***---Sumarizo
                ACN(FU:1, 2)
                (.'TOTCAIDA8'.)
                SetFilaActual(fac+2)
                ACT(CL:1000, fbn('DescImp'))
                IF NoVacio(fbn('Grupo'))
                    ACT(CL:800, fbn('Grupo'))
                ELSE
                    ACT(CL:800, Copy(Mayusculas2(BuscarCampo('TIPOSOPERACION','Nombre','Codigo', fbn('TipoOp'))), 6, 32))
                ENDIF
                ACT(CL:500, fbn('Especie'))
                ACT(A:fac, fbn('DescImp'))
                AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
                SetFont(A:fac-2..Val(CL:900):fac, 2)
                ACT(BD:5, fbn('DescImp'))
                ifa
                ACT(A:fac, Val(CL:800))
                ACN(FM:1, fac)
                BorrarCeldas(ES:2..ES:2)
                SetFont(A:fac, 4)
                ACN(FI:1000, fac)
            ELSE
                IF [Not Eqstr(fbn('Grupo'), Val(CL:800)) Y NoVacio(fbn('Grupo'))] O [Vacio(fbn('Grupo')) Y Not Eqstr(Copy(Mayusculas2(BuscarCampo('TIPOSOPERACION','Nombre','Codigo', fbn('TipoOp'))), 6, 32), Val(CL:800))]
                    ***---Cambio de Grupo
                    IF NoVacio(fbn('Grupo'))
                        ACT(CL:800, fbn('Grupo'))
                    ELSE
                        ACT(CL:800, Copy(Mayusculas2(BuscarCampo('TIPOSOPERACION','Nombre','Codigo', fbn('TipoOp'))), 6, 32))
                    ENDIF
                    ACT(CL:500, fbn('Especie'))
                    ACT(A:fac, Val(CL:800))
                    BorrarCeldas(ES:2..ES:2)
                    SetFont(A:fac, 4)
                    ACN(TF:1000, 0)
                    ***---Sumarizo Filas segun Tipo
                    ACN(FU:1, 0)
                    (.'TOTCAIDA8'.)
                ELSE
                    DFA
                ENDIF
            ENDIF
        ENDIF
     endif
     * Recorro las Columnas fecha = fechavto
     Recorrer&k 2, Val(CL:900)
        IF Dialogo.Radio3 = 0
            ***---Diario
            IF Val(&k:Val(FI:1)) = fbn('Vto')
                acn(y:400,&i)
                SCN(&k:fac, Val(IM:1)/Val(EX:1))
                IF Val(&k:fac) <> 0
                ACL(&k:fac, 'CAIDA2', Cliente1 = Dialogo.CLiente1, Lista1 = IIF(Dialogo.Radio4 = 0, fbn('Clave'), IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1000))), Especie1 = Dialogo.Especie1, Lista2 = IIF(NoVacio(fbn('Grupo')), IIF(NoVacio(Dialogo.Lista2), Dialogo.Lista2, Val(LS:1100)), fbn('TipoOp')), Radio1 = Dialogo.Radio1, Fecha1=Dialogo.Fecha1, Fecha2 = Val(&k:Val(FI:1)), Fecha3 = Val(&k:Val(FI:1)), Check1 = fbn('BD1'), String1 = Val(CL:800), String2 = fbn('DescImp'), Entero1 = Val(EX:1), String4 = fbn('DescImp'), Radio5 = Dialogo.Radio5, Radio3 = Dialogo.Radio3)
                ELSE
                    ACT(&k:fac, '')
                ENDIF
                Break
            ENDIF
        ENDIF
        IF Dialogo.Radio3 = 1
            ***---Mensual
            IF fbn('Vto') >= Val(&k:Val(FI:1)) Y fbn('Vto') <= Val(&k:Val(FI:2))
                SCN(&k:fac, Val(IM:1)/Val(EX:1))
                IF Val(&k:fac) <> 0
                ACL(&k:fac, 'CAIDA2', Cliente1 = Dialogo.CLiente1, Lista1 = IIF(Dialogo.Radio4 = 0, fbn('Clave'), IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1000))), Especie1 = Dialogo.Especie1, Lista2 = IIF(NoVacio(fbn('Grupo')), IIF(NoVacio(Dialogo.Lista2), Dialogo.Lista2, Val(LS:1100)), fbn('TipoOp')), Radio1 = Dialogo.Radio1, Fecha1=Dialogo.Fecha1, Fecha2 = Val(&k:Val(FI:1)), Fecha3 = Val(&k:Val(FI:2)), Check1 = fbn('BD1'), String1 = Val(CL:800), String2 = fbn('DescImp'), Entero1 = Val(EX:1), String4 = fbn('DescImp'), Radio5 = Dialogo.Radio5, Radio3 = Dialogo.Radio3)
                ELSE
                    ACT(&k:fac, '')
                ENDIF
                Break
            ENDIF
        ENDIF
        IF Dialogo.Radio3 = 2
            ***---Anual
            IF fbn('Vto') >= Val(&k:Val(FI:2)) Y fbn('Vto') <= Val(&k:Val(FI:3))
                ***---Entra por Cuatrimestre
                SCN(&k:fac, Val(IM:1)/Val(EX:1))
                IF Dialogo.Fecha3 = 0
                    IF fbn('Vto') > Val(MV:1)
                        ***---Guardo maxima fecha para saber el numero de columna
                        ACD(MV:1, fbn('Vto'))
                        ACN(CL:6, &k)
                    ENDIF
                    ACD(&k+5000:fac, Val(&k:Val(FI:3)))
                ELSE
                    IF Val(&k:Val(FI:3)) <= Dialogo.Fecha3
                        ***---No es ultimo trimestre => tomo fecha Hasta del trimestre
                        ACD(&k+5000:fac, Val(&k:Val(FI:3)))
                    ELSE
                        ***---Ultimo Trimestre => Tomo Fecha Hasta
                        ACD(&k+5000:fac, Dialogo.Fecha3)
                    ENDIF
                ENDIF
                IF Val(&k:fac) <> 0
                ACL(&k:fac, 'CAIDA2', Cliente1 = Dialogo.CLiente1, Lista1 = IIF(Dialogo.Radio4 = 0, fbn('Clave'), IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1000))), Especie1 = Dialogo.Especie1, Lista2 = IIF(NoVacio(fbn('Grupo')), IIF(NoVacio(Dialogo.Lista2), Dialogo.Lista2, Val(LS:1100)), fbn('TipoOp')), Radio1 = Dialogo.Radio1, Fecha1=Dialogo.Fecha1, Fecha2 = IIF(&k=2, Dialogo.Fecha2,Val(&k:Val(FI:2))), Fecha3 = Val(&k+5000:fac), Check1 = fbn('BD1'), String1 = Val(CL:800), String2 = fbn('DescImp'), Entero1 = Val(EX:1), String4 = fbn('DescImp'), Radio5 = Dialogo.Radio5, Radio3 = Dialogo.Radio3)
                ELSE
                    ACT(&k:fac, '')
                ENDIF
                Break
            ENDIF
            IF Anio(fbn('Vto')) = Val(&k:Val(FI:1)) Y Not Eqstr(Val(&k:Val(FI:2)), 'TOTAL')
                ***---Entra por Anio
                SCN(&k:fac, Val(IM:1)/Val(EX:1))
                IF Dialogo.Fecha3 = 0
                    IF fbn('Vto') > Val(MV:1)
                        ***---Guardo maxima fecha para saber el numero de columna
                        ACD(MV:1, fbn('Vto'))
                        ACN(CL:6, &k)
                    ENDIF
                    ACD(&k+5000:fac, Fecha('31/12/'~Fstr(Val(&k:Val(FI:1)), 4, 0)))
                ELSE
                    IF Fecha('31/12/'~Fstr(Val(&k:Val(FI:1)), 4, 0)) <= Dialogo.Fecha3
                        ACD(&k+5000:fac, Fecha('31/12/'~Fstr(Val(&k:Val(FI:1)), 4, 0)))
                    ELSE
                        ACD(&k+5000:fac, Dialogo.Fecha3)
                    ENDIF
                ENDIF
                IF Val(&k:fac) <> 0
                ACL(&k:fac, 'CAIDA2', Cliente1 = Dialogo.CLiente1, Lista1 = IIF(Dialogo.Radio4 = 0, fbn('Clave'), IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1000))), Especie1 = Dialogo.Especie1, Lista2 = IIF(NoVacio(fbn('Grupo')), IIF(NoVacio(Dialogo.Lista2), Dialogo.Lista2, Val(LS:1100)), fbn('TipoOp')), Radio1 = Dialogo.Radio1, Fecha1=Dialogo.Fecha1, Fecha2 = Fecha('01/01/'~Fstr(Anio(fbn('Vto')), 4, 0)), Fecha3 = Val(&k+5000:fac), Check1 = fbn('BD1'), String1 = Val(CL:800), String2 = fbn('DescImp'), Entero1 = Val(EX:1), String4 = fbn('DescImp'), Radio5 = Dialogo.Radio5, Radio3 = Dialogo.Radio3)
                ELSE
                    ACT(&k:fac, '')
                ENDIF
                Break
            ENDIF
        ENDIF
     Proximo
proximo
IF Val(XJ:1) = 1
    AgregarMarco(A:Val(FM:1)..Val(CL:900):fac, 0, 0)
    ifa
    ACT(A:fac, 'TOTAL '~Val(BD:5))
    AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR6'))
    ***---Sumarizo ultimo Subtotal (Por Columna)
    ACN(FU:1, 3)
    (.'TOTCAIDA8'.)
    SetFilaActual(fac+2)
    ACT(A:fac, 'TOTAL '~Val(BD:6))
    AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, RGB(197,196,255))
    SetFont(A:fac-2..Val(CL:900):fac, 2)
ENDIF
ACN(FF:1, 0)
ACN(MM:1, 0)
IF Dialogo.Radio3 = 2
    BorrarCeldas(B:Val(FI:1)..B:Val(FI:1))
ENDIF
***---Renombro las columnas
Recorrer&k 2, Val(CL:900)
    IF Dialogo.Radio3 = 0
        IF Incluido(Val(&k:Val(FI:1)), 'Subtotal|TOTAL')
            SetFont(&k:Val(FI:3)..&k:fac+2, 2)
        ELSE
            Recorrer&j Val(FI:3), fac
                IF Not Eqstr(Copy(Val(A:&j), 1, 5), 'TOTAL')
                    SetFont(&k:&j, 1)
                ENDIF
            Proximo
        ENDIF
    ENDIF
    IF Dialogo.Radio3 = 1
        BorrarCeldas(&k:Val(FI:2)..&k:Val(FI:3))
        ACO(&k, 8)
        IF Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
            ACT(&k:Val(FI:1), Copy(Meses(Mes(Val(&k:Val(FI:1)))), 1, 7)~'-'~Fstr(Anio(Val(&k:Val(FI:1))), 4, 0))
            Recorrer&j Val(FI:3), fac
                IF Not Eqstr(Copy(Val(A:&j), 1, 5), 'TOTAL')
                    SetFont(&k:&j, 1)
                ENDIF
            Proximo
        ELSE
            SetFont(&k:Val(FI:3)..&k:fac+2, 2)
        ENDIF
    ENDIF
    IF Dialogo.Radio3 = 2
        IF &k <= Val(TT:1000)
            ***---Columnas trimestrales
            IF Not Eqstr(Val(&k:Val(FI:2)), 'TOTAL') Y Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
                ACT(&k:Val(FI:2), Fstr(Val(TR:1000), 1, 0)~'# Trimest.')
                IF Val(TR:1000) = 1
                    ***---Guardo columna para Marco
                    ACN(CM:1, &k)
                ENDIF
                SCN(TR:1000, 1)
                IF Val(TR:1000) = 5
                    ACN(TR:1000, 1)
                ENDIF
                Recorrer&j Val(FI:3), fac
                    IF Not Eqstr(Copy(Val(A:&j), 1, 5), 'TOTAL')
                        SetFont(&k:&j, 1)
                    ENDIF
                Proximo
            ELSE
                IF Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
                    BorrarCeldas(&k:Val(FI:1)..&k:Val(FI:1))
                    AgregarMarco(Val(CM:1):Val(FI:1)..&k:Val(FI:1), 0, 0, Exe('COLOR8'))
                    AgregarMarco(Val(CM:1):Val(FI:2)..&k:Val(FI:2), 0, 2, Exe('COLOR8'))
                    IF Val(FF:1) = 0
                        ACN(CC:1, (&k/2)+1)
                        ACT(Val(CC:1):Val(FI:1), 'A#o '~Fstr(Anio(Val(Val(CC:1):Val(FI:3))), 4, 0))
                    ELSE
                        ACN(CC:1, ((&k-Val(FF:1))/2)+Val(FF:1)+1)
                        ACT(Val(CC:1):Val(FI:1), 'A#o '~Fstr(Anio(Val(Val(CC:1):Val(FI:3))), 4, 0))
                    ENDIF
                    SetFont(&k:Val(FI:3)..&k:fac+2, 2)
                    ACN(FF:1, &k)
                ELSE
                    SetFont(&k:Val(FI:3)..&k:fac+2, 2)
                ENDIF
            ENDIF
        ELSE
            ***---Columnas anuales
            IF Not Eqstr(Val(&k:Val(FI:1)), 'TOTAL')
                ACT(&k:Val(FI:1), 'A#o '~Fstr(Val(&k:Val(FI:1)), 4, 0))
                IF Val(MM:1) = 0
                    ACN(MM:1, &k)
                ENDIF
                Recorrer&j Val(FI:3), fac
                    IF Not Eqstr(Copy(Val(A:&j), 1, 5), 'TOTAL')
                        SetFont(&k:&j, 1)
                    ENDIF
                Proximo
            ELSE
                AgregarMarco(Val(MM:1):Val(FI:1)..&k:Val(FI:2), 0, 2, Exe('COLOR8'))
                SetFont(&k:Val(FI:3)..&k:fac+2, 2)
            ENDIF
        ENDIF
    ENDIF
Proximo

AlinearCeldas(B:Val(FI:1)..Val(CL:900):Val(FI:2), 'C')

IF Dialogo.Radio4 = 0
    SetFilaActual(fac+2)
    act(a:fac,'TOTAL GENERAL')
    AFI(fac, 30)
ENDIF

FormatoCeldas(B:Val(FI:1)+2..Val(CL:900):fac, Exe('F2'))

IF Dialogo.Fecha3 = 0
    ***---Corro ultima col. estimada a la ultima columa real
    Recorrer&k Val(FI:3)+1, fac
        IF Val(Val(CL:900):&k) > 0
            ACN(Val(CL:6)+1:&k, Val(Val(CL:900):&k))
        ENDIF
    Proximo
    ACN(CL:900, Val(CL:6) + 1)
    ACT(Val(CL:900):Val(FI:1), 'TOTAL')
    SetFont(Val(CL:900):Val(FI:1)..Val(CL:900):fac, 2)
    BorrarCeldas(Val(CL:900)+1:Val(FI:1)..Val(CL:900)+1:fac)
ENDIF

IF Dialogo.Radio3 = 0
    BorrarCeldas(B:Val(FI:2)..B:Val(FI:3))
    AgregarMarco(A:Val(FI:1)..Val(CL:900):Val(FI:1), 0, 2, Exe('COLOR8'))
    AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR8'))
ENDIF
IF Dialogo.Radio3 = 1
    AgregarMarco(A:Val(FI:1)..Val(CL:900):Val(FI:1), 0, 2, Exe('COLOR8'))
    AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR8'))
ENDIF
IF Dialogo.Radio3 = 2
    BorrarCeldas(B:Val(FI:3)..Val(CL:900):Val(FI:3))
    AgregarMarco(A:Val(FI:1)..A:Val(FI:2), 0, 0, Exe('COLOR8'))
    AgregarMarco(A:fac..Val(CL:900):fac, 0, 0, Exe('COLOR8'))
    AgregarMarco(Val(CL:900):Val(FI:1)..Val(CL:900):Val(FI:2), 0, 0, Exe('COLOR8'))
ENDIF
SetFont(A:Val(FI:1)..Val(CL:900):Val(FI:2), 2)
SetFont(A:fac..Val(CL:900):fac, 2)

FijarFila(Val(FI:3))
FijarCol(2)

ACO(1, 17)

Impresion(1,2)

SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC, 2)
SetMargins(0, 0, 0, 0)
SetPrintFit(3, 80)

AlinearCeldas(2:val(d:400)..val(ab2):val(d:400)+2,'C')

IF Dialogo.Radio3 <> 2
    AFI(Val(FI:1), 30)
    AFI(Val(FI:2), 1)
ENDIF

BorrarCeldas(Val(CL:900)+1:Val(FI:2)..16000:Val(FI:2))
BorrarCeldas(F:1..ZZ:9)

IF Val(CL:900) < 5
    ACN(CL:900, 5)
ENDIF

IF Dialogo.Fecha3 <> 0
   LimitesVision(Val(CL:900)+1:fac+1)
ELSE
   LimitesVision(Val(CL:900):fac+1)
ENDIF
RangoTitulo(A:1..Val(CL:900):FAC, 11)
