CrearDialogo
  String: 'Modelo'
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,8,BI')

ACT(a:2, 'Modelo de asiento '~Dialogo.String )

SetFont(a:2, 3)

SetFilaActual(4)

ACT(a:fac,   'Nombre')
ACT(b:fac,   'Vehiculo')
ACT(c:fac,   'Tipo')
ACT(d:fac,   'Item')
ACT(e:fac,   'Cuenta')
ACT(e:fac+1, 'Contable')
ACT(f:fac,   'Calculo1')
ACT(g:fac,   'Calculo2')
ACT(h:fac,  'Calculo3')
ACT(i:fac,   'Validez')
ACT(j:fac,   'Deb/Cre')
ACT(k:fac,   'Moneda1')
ACT(l:fac,   'Moneda2')
ACT(m:fac,   'Moneda3')
ACT(n:fac,   'Alias1')
ACT(o:fac,   'Alias2')
ACT(p:fac,   'Alias3')
ACT(q:fac,   'Alias4')
ACT(r:fac,   'Alias5')
ACT(s:fac,   'Detalle')
ACT(t:fac,   'Centro')
ACT(t:fac+1, 'Costo')
SetFont(a:fac..z:fac+1,2)
AgregarMarco(a:fac..t:fac+1,1,0,EXE('COLOR6'))
AlinearCeldas(a:fac..t:fac+1,'C')
ifa

SQL.ADD(" SELECT M1.*, M.Descripcion, M.Vehiculo, M.TipoAsiento FROM "~DBO~".MODELOSASIENTO1 M1, "~DBO~".MODELOSASIENTO M")
SQL.ADD(" WHERE M.Codigo = M1.Modelo ")
SQL.ADD(" AND   M.Codigo = '"~Dialogo.String~"' ")
SQL.ADD(" ORDER BY M1.NrItem ")
Recorrer SQL
  ACT(a:fac, fbn('Descripcion'))  
  ACT(b:fac, fbn('Vehiculo'))  
  ACT(c:fac, fbn('TipoAsiento'))  
  ACN(d:fac, fbn('NrItem'))
  If Eqstr(fbn('CT1'),'SI')
    ACT(e:fac, fbn('CuentaContable1'))
  Else
    ACT(e:fac, fbn('CuentaContable'))
  Endif
  ACT(f:fac, fbn('FormaCalculo1'))
  ACT(g:fac, fbn('FormaCalculo2'))
  ACT(h:fac, fbn('FormaCalculo3'))
  ACT(i:fac, fbn('CondicionValidez'))
  ACT(j:fac, fbn('DebitoCredito'))
  If Eqstr(fbn('MN1'),'SI')
    ACT(k:fac, fbn('Moneda11'))
  Else
    ACT(k:fac, fbn('Moneda1'))
  Endif
  If Eqstr(fbn('MN2'),'SI')
    ACT(l:fac, fbn('Moneda12'))
  Else
    ACT(l:fac, fbn('Moneda2'))
  Endif
  If Eqstr(fbn('MN3'),'SI')
    ACT(m:fac, fbn('Moneda13'))
  Else
    ACT(m:fac, fbn('Moneda3'))
  Endif
  ACT(n:fac, fbn('Alias1'))
  ACT(o:fac, fbn('Alias2'))
  ACT(p:fac, fbn('Alias3'))
  ACT(q:fac, fbn('Alias4'))
  ACT(r:fac, fbn('Alias5'))
  ACT(s:fac, fbn('Detalle'))
  If Eqstr(fbn('CC1'),'SI')
    ACT(t:fac, fbn('CentroCosto1'))
  Else
    ACT(t:fac, fbn('CentroCosto'))
  Endif
  SetFont(a:fac..z:fac,1)
  FormatoCeldas(d:fac, EXE('F0'))
Proximo
ifa


