MostrarCuadroDeMensajes
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1      : 'D.Fec.Gener' ;1;1;;;;;;;FSYS
  Fecha2      : 'H.Fec.Gener' ;1;2;;;;;;;FSYS
  Fecha3      : 'D.Fec.Valor' ;2;1;;;;;;;Habiles(FSYS,-Var('CONTVALOR'),'ARG')
  Fecha4      : 'H.Fec.Valor' ;2;2;;;;;;;FSYS
  NrOperacion1: 'NrOperacion' ;4;1;;
  Vehiculo1   : 'Vehiculo'    ;4;2;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
FinDialogo

If Not Ok 
  Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

SetFilaActual(2)
ACT(A:fac, 'Asientos Manuales' )
SetFont(A:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Desde Fecha Generacion: '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
ifa
ACT(A:fac, 'Desde Fecha Valor: '~Dialogo.Fecha3~' al '~Dialogo.Fecha4)
ifa
IF NoVacio(Dialogo.NrOperacion1)
    ACT(A:fac, 'Operacion: '~Dialogo.NrOperacion1)
ELSE
    ACT(A:fac, 'Operaciones: Todas')
ENDIF
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:fac-3..A:fac, 2)
SetFilaActual(fac+2)
ACT(A:fac,   'Fecha')
ACT(A:fac+1, 'Generac')
ACT(B:fac,   'Fecha')
ACT(B:fac+1, 'Valor')
ACT(C:fac,   'Cuenta')
ACT(D:fac,   'Moneda')
ACT(E:fac,   'Debito')
ACT(F:fac,   'Credito')
ACT(G:fac,   'Especie')
ACT(H:fac,   'Centro')
ACT(H:fac+1, 'Responsable')
ACT(I:fac,   'Modelo')
ACT(J:fac,   'Asiento')
ACT(K:fac,   'Item')
ACT(L:fac,   'Operacion')

SetFont(a:fac..M:fac+1, 2)
AgregarMarco(a:fac..M:fac+1,1,0,EXE('COLOR6'))
AlinearCeldas(a:fac..M:fac+1, 'C')
SetFilaActual(fac+1)
ACN(z:1,fac)
ACN(FI:1, fac+1)
message('Recuperando Asientos...')
SQL.ADD(" SELECT A1.*, A.FechaGeneracion, A.FechaValor, A.Modelo, A.NrOperacion, A.NrAsiento,")
SQL.ADD(" M.TipoAsiento,M.TipoOp, A.Fecha1, A.Estado, A.Fecha2, M2.CuentaContable ")
SQL.ADD(" FROM  "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO1 M2 ")
SQL.ADD(" WHERE A1.NrUnicoAsiento = A.NrUnicoAsiento ")
SQL.ADD(" and A.Modelo     = M.Codigo ")
SQL.ADD(" AND M.Codigo = M2.Modelo ")
SQL.ADD(" AND M2.NrItem = A1.Alias3 ")
SQL.ADD(" and A.FechaGeneracion>= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD(" and A.FechaGeneracion<= "~IdxDate2(Dialogo.Fecha2))
SQL.ADD(" and A.FechaValor>= "~IdxDate2(Dialogo.Fecha3))
SQL.ADD(" and A.FechaValor<= "~IdxDate2(Dialogo.Fecha4))
SQL.ADD(" AND A.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND M.TipoAsiento = 'MANUAL' ")
IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ENDIF
SQL.ADD(" ORDER By M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento ")
Recorrer SQL
    IF Not Eqstr(fbn('NrUnicoAsiento'), Val(NS:1)) Y Not CeldaVacia(NS:1)
        SetFont(A:Val(FI:1)..M:fac, 1)
        ACN(E:fac, Sum(E:Val(FI:1)..E:fac-1))
        ACN(F:fac, Sum(F:Val(FI:1)..F:fac-1))
        SetFont(E:fac..F:fac, 2)
        AgregarMarco(A:fac..L:fac, 0, 0)
        SetFilaActual(fac+2)
        ACN(FI:1, fac)
    ENDIF
    ACD(A:fac, fbn('FechaGeneracion'))
    ACD(B:fac, fbn('FechaValor'))
    SQL.ADD(" Select Descripcion From "~DBO~".FORMULAS ")
    SQL.ADD(" Where Codigo = '"~Copy(fbn('CuentaContable'), 2, Longitud(fbn('CuentaContable'))-1)~"' ")
    Recorrer SQL
        DFA
        ACT(FR:1, fbn('Descripcion'))
    Proximo
    ACT(C:fac, fbn('Cuenta')~' - '~Val(FR:1))
    ACT(D:fac, fbn('Especie1'))
    IF Eqstr(fbn('DebitoCredito'), 'DEB')
        ACN(E:fac, fbn('Cantidad1'))
    ELSE
        ACN(F:fac, fbn('Cantidad1'))
    ENDIF
    ACT(G:fac, fbn('Alias5'))
    ACT(H:fac, fbn('CentroCosto'))
    ACT(I:fac, fbn('Modelo'))
    ACT(J:fac, fbn('NrUnicoAsiento'))
    ACT(K:fac, fbn('Alias3'))
    ACT(L:fac, fbn('NrOperacion'))
    ACLO(L:fac, fbn('NrOperacion'))
    ACT(NS:1, fbn('NrUnicoAsiento'))
Proximo
SetFont(A:Val(FI:1)..M:fac, 1)
ifa
ACN(E:fac, Sum(E:Val(FI:1)..E:fac-1))
ACN(F:fac, Sum(F:Val(FI:1)..F:fac-1))
SetFont(E:fac..F:fac, 2)
AgregarMarco(A:fac..L:fac, 0, 0)
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(1,7)
ACO(2,7)
ACO(3,30)
ACO(4,5)
ACO(5,8)
ACO(6,8)
ACO(7,6)
ACO(8,10)
ACO(9,8)
ACO(10,8)
ACO(11,5)

Impresion(1, 2)
SetPrintFit(3, 90)
LimitesVision(L:fac+2)
