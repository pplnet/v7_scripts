* GRALOP - OPERAT - General de Operaciones
ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo2  : "Grupo"      ;1;1;;Vacio(Dialogo.Vehiculo1);;Not EsTerminal(Dialogo.Vehiculo2, Vehiculos);'Debe ingresar un Grupo';NO;;;;;;"TipoVehiculo <> 'DIV'";
  Vehiculo1  : "Vehiculo"   ;1;2;;Vacio(Dialogo.Vehiculo2);;EsTerminal(Dialogo.Vehiculo1, Vehiculos) o Vacio (Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;;;;;;"TipoVehiculo = 'DIV'";;
  Cliente1   : "Cliente"    ;2;1;;;;;;;;;;;;;;;;
  Especie1   : "Especie"    ;3;1;;;;;;;;;;;;"Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~")";
  Operador   : 'Operador'   ;3;2;;;;;;;UsuarioActivo
  Fecha1     : "F.Op.Desde" ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una FechaOp Desde';NO;FSys-30;
  Fecha2     : "F.Op.Hasta" ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3     : "F.Vto.Desde";5;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4     : "F.Vto.Hasta";5;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  TipoOp1    : "Tipo Op"    ;6;1;;;;;;;;IIF(Eqstr(Dialogo.Operador, 'PJAIME'), 'FXCS', 'SECS');
  TipoOp2    : "Tipo Op2"   ;7;1;;;;;;;
  TipoOp3    : "Tipo Op"    ;6;2;;;;;;;
  TipoOp4    : "Tipo Op4 "  ;7;2;;;;;;;
  ListaClaves: "Orden"      ;9;1;;;;;;;;;Operaciones
  Radio1     : 'Consolidado|Si|No';;;;;;;;;0
  Check1     : 'Check'
  String1    : 'Texto'  ;;;;;;Eqstr(Dialogo.String1, 'FXCS');'Mensaje Error';;;;;;;;;;;;
  Entero1    : 'Entero' ;;;;;;;;;;;;;;;;;;;;;
  Cantidad1  : 'Cantidad' ;;;;;;;;;;;;;'######.###';;;;
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACT(a:3, "General de Operaciones")
ACT(g:3,'Fecha : '~Var('FECHASYS'))
SetFont(a:3..g:3,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio (Dialogo.Vehiculo2)
   ACT(a:FAC+1, 'Grupo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
else
   ACT(a:FAC+1, 'Grupo : Todos')
endIf

if NoVacio (Dialogo.Vehiculo1)
   ACT(a:FAC+2, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+2, 'Vehiculo : Todos')
endIf

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+4, 'Especies : Todas')
endif

if NoVacio(Dialogo.Operador)
  ACT(a:FAC+8, 'Operador : '~Dialogo.Operador)
else
  ACT(a:FAC+8, 'Operador : Todos')
endif

ACT(a:FAC+5, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(c:FAC+5, 'Ope.Hasta : '~Dialogo.Fecha2)
ACT(a:fac+6, 'Vto.Desde : '~Dialogo.Fecha3)
ACT(c:FAC+6, 'Vto.Hasta : '~Dialogo.Fecha4)

if NoVacio(Dialogo.TipoOp1~Dialogo.TipoOp2~Dialogo.TipoOp3~Dialogo.TipoOp4~Dialogo.TipoOp5)
  ACT(A:FAC+7, 'Tipo Op. : '~Dialogo.TipoOp1~' '~Dialogo.TipoOp2~' '~Dialogo.TipoOp3~' '~Dialogo.TipoOp4~' '~Dialogo.TipoOp5)
else
  ACT(A:FAC+7, 'Tipo Op. : Todas')
endif

SetListaClaves(1)
ACT(a:FAC+9, "Orden : "~Dialogo.ListaClaves)
ACT(a:FAC+10, 'Consolidado '~iif(Dialogo.Radio1 = 1,'No','Si'))

SetFont(a:FAC..a:FAC+10, 2)

SetListaClaves(2)
SetFilaActual(FAC+12)

ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "FechaOp")
ACT(C:FAC, "F.Vto")
ACT(D:FAC, "Cliente")
ACT(E:FAC, "Especie")
ACT(F:FAC, "CtraEspecie")
ACT(G:FAC, "Tipo Op.")
ACT(H:FAC, "Cantidad")
ACT(I:FAC, "Precio/Tasa")
ACT(J:FAC, "Plazo")
ACT(K:FAC, "Total")
ACT(L:FAC, "Nro.Ope.")
ACT(M:FAC, "Autorizantes")
AlinearCeldas(a:FAC..G:FAC,'I')
AlinearCeldas(H:FAC..K:FAC,'D')
AlinearCeldas(L:FAC..M:FAC,'I')
SetFont(a:FAC..M:FAC, 2)
AgregarMarco(a:FAC..M:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

*************---------- VAL(Z1) ----------***************
if NoVacio(Dialogo.Especie1)
  ACT(z1, "O.Especie = '"~Dialogo.Especie1~"' and ")
endif
if NoVacio(Dialogo.Cliente1)
  ACT(z1, Val(z1)~"O.Cliente1 = '"~Dialogo.Cliente1~"' and ")
endif
if NoVacio(Dialogo.TipoOp1~Dialogo.TipoOp2~Dialogo.TipoOp3~Dialogo.TipoOp4~Dialogo.TipoOp5)
  ACT(z1, Val(z1)~"O.TipoOp in ('"~Dialogo.TipoOp1~"','"~Dialogo.TipoOp2~"','"~Dialogo.TipoOp3~"','"~Dialogo.TipoOp4~"','"~Dialogo.TipoOp5~"') and ")
endif

if NoVacio(Dialogo.Vehiculo1)
  ACT(z1, Val(z1)~"O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") and ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    ACT(z1, Val(z1)~"O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")  and ")
EndIf


endif

ACT(z1, Val(z1)~"O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and ")
ACT(z1, Val(z1)~"((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")
if NoVacio(Dialogo.Operador)
  ACT(z1, Val(z1)~" and O.Operador = '"~Dialogo.Operador~"'")
endif

******************************-------------- CONSULTAS -------------------*********************************
***---Unico Vto
If Dialogo.Radio1 = 1
  SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
Else
  SQL.ADD("SELECT 'Consolidado' Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
EndIf 

SQL.ADD("O.ContraEspecie,O.TipoOp,O.Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" C.Codigo, C. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, 0 Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION T ") 
SQL.ADD(" WHERE "~Val(z1)~" and O.TipoOp Not In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','TRANSF','MMCPM','MMFCMV','MMFIMV','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMONM') ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND C.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")

*--------------------------------------------------------******

***---Multiplo Vto Vto : Money Market
SQL.ADD("Union All ")

If Dialogo.Radio1 = 1
  SQL.ADD("SELECT O.Vehiculo1, C.Fecha1 FechaOp, C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
Else
  SQL.ADD("SELECT 'Consolidado' Vehiculo1, C.Fecha1 FechaOp, C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
EndIf

SQL.ADD("O.ContraEspecie,O.TipoOp,O.Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" L.Codigo, L. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C, "~DBO~".VEHICULOS V,"~DBO~".CLIENTES L, "~DBO~".TIPOSOPERACION T") 
SQL.ADD(" where O.NrOperacion=C.NrOperacion and "~Val(z1)~" and O.TipoOp In ('MMCPM','MMFCMV','MMFIMV','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMONM') ")
SQL.ADD(" and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND L.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")

*--------------------------------------------------------******

***---Multiplo Vto Vto: Futuros
SQL.ADD("Union All ")

If Dialogo.Radio1 = 1
  SQL.ADD("SELECT O.Vehiculo1, C.Fecha1 FechaOp, C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
Else
  SQL.ADD("SELECT 'Consolidado' Vehiculo1, C.Fecha1 FechaOp, C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
EndIf

SQL.ADD("O.ContraEspecie,O.TipoOp,O.TotalAux3 as Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" L.Codigo, L. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C, "~DBO~".VEHICULOS V,"~DBO~".CLIENTES L, "~DBO~".TIPOSOPERACION T") 
SQL.ADD(" where O.NrOperacion=C.NrOperacion and "~Val(z1)~" and O.TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') and O.TipoOp Not IN ('TRANSF')")
SQL.ADD(" and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND L.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")

*----------------------------------------------------------****

if NoVacio(Dialogo.ListaClaves)
   SQL.ADD(" order by "~Dialogo.ListaClaves)
endif

SQL.ADD(" Order by 1")
ACT(xx:1, '')

Recorrer SQL
  If Not EqStr(FBN['Vehiculo1'], Val(xx:1)) Y Not CeldaVacia(xx:1)  
    SetFilaActual(FAC+1)
    ACT(A:FAC, "Vehiculo")
    ACT(B:FAC, "FechaOp")
    ACT(C:FAC, "F.Vto")
    ACT(D:FAC, "Cliente")
    ACT(E:FAC, "Especie")
    ACT(F:FAC, "CtraEspecie")
    ACT(G:FAC, "Tipo Op.")
    ACT(H:FAC, "Cantidad") 
    ACT(I:FAC, "Precio/Tasa")
    ACT(J:FAC, "Plazo")
    ACT(K:FAC, "Total")
    ACT(L:FAC, "Nro.Ope.")
    ACT(M:FAC, "Autorizantes")
    AlinearCeldas(a:FAC..G:FAC,'I')
    AlinearCeldas(H:FAC..K:FAC,'D')
    AlinearCeldas(L:FAC..M:FAC,'I')
    SetFont(a:FAC..M:FAC,2)
    AgregarMarco(a:FAC..M:FAC,2,0,Exe('COLOR'))      
    SetFilaActual(FAC+1)  
  EndIf

  ACT(a:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',FBN['Vehiculo1']),1,25))
  ACT(b:fac, FBN['FechaOp'])
  ACT(c:fac, FBN['FechaVto'])
  ACT(d:fac, Copy(FBN['RazonSocial'],1,25))
  ACT(e:fac, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  ACT(F:FAC, FBN['ContraEspecie'])

  ACT(G:fac, Copy(FBN['TipoOp']~' '~FBN['Nombre'],1,25))
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Rojo')=1
    ACT(G:FAC, Val(G:FAC)~' (Rojo)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(G:FAC, Val(G:FAC)~' (x Pase)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(G:FAC, Val(G:FAC)~' (x Arb.)')
  endif
  
  IF Incluido(FBN['TipoOp'],'MMCPM|MMFCMV|MMFIMV|MMPCCM|MMPCLM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMONM')  ************* Multiple Vtos
     ACN(i:fac, FBN['Precio2'])
  Else 
     IF Not Incluido(FBN['TipoOp'],'COM|COT|CTM|CTT|POM|POT|PTM|PTT|PFM|PFT')
          ACN(i:fac, FBN['Precio1'])
     ENDIF 
  ENDIF                                                                 

  ACN(j:fac, FBN['Plazo'])
  ACN(h:fac, FBN['Cantidad'])

  IF EqStrL(FBN['TipoOp'],'DT',2)
     IF Incluido(FBN['TipoOp'],'DTCAP|DTFLO|DTSFFM|DTSFVM|DTSVVM')
        ACN(h:FAC, FBN['TotalAux3'])
     else
        IF Incluido(FBN['TipoOp'],'DTK|DTKVI|DTSFVX|DTSNFF|DTSNVV')
           ACN(h:FAC, BuscarCampo('CUOTAS', 'Cantidad1', 'NrOperacion',FBN['NrOperacion']))
        ENDIF
     ENDIF
     ACN(k:FAC,0)
  ELSE
    IF Incluido(FBN['TipoOp'], 'FCS|FCR')
      ACN(k:FAC, FBN['TotalNetoCli1'])
    Else
      If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'MM')
        ACN(k:FAC, FBN['Cantidad'])
      Else
        ACN(k:FAC, FBN['TotalBrutoCli1'])
      EndIf
    EndIf
  ENDIF

  ACT(l:fac, FBN['NrOperacion'])
  ACLO(l:fac, FBN['NrOperacion'])
  ACT(M:fac, fbn('Observac5'))
 
  SetFont(a:FAC..q:FAC,1)
  AlinearCeldas(b:FAC..c:FAC,'D')
  FormatoCeldas(j:fac..j:fac,"0")
  FormatoCeldas(i:fac..i:fac,Exe('F6'))
  ACT(xx:1, FBN['Vehiculo1'])
proximo

SetFilaActual(FAC+2)
ACT(a:FAC,'TRANSFERENCIAS')
SetFont(a:FAC..q:FAC,3)

SetFilaActual(FAC+2)
***********------ TRANSFERENCIAS DE CUENTAS ------**************
ACT(a:FAC, 'Vehiculo')
ACT(b:FAC, 'FechaOp')
ACT(c:FAC, 'Entidad Origen')
ACT(d:FAC, 'CBU - Entidad Origen')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'CtraEspecie')
ACT(g:FAC, 'Tipo Op.')
ACT(h:FAC, 'Entidad Destino')
ACT(i:FAC, 'CBU - Entidad Destino')
ACT(j:FAC, '')
ACT(k:FAC, 'Total')
ACT(l:FAC, 'Nro. Ope.')
ACT(M:FAC, 'Autorizantes')
SetFont(a:FAC..M:FAC, 2)
AgregarMarco(a:FAC..M:FAC,2,0,Exe('COLOR'))

SQL.ADD(" SELECT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Especie,O.FechaEj,O.Cliente1,O.Cliente2,O.Cuenta4,O.Cuenta1,")
SQL.ADD(" O.TipoOp,O.NrOperacion,O.Operador, O.Cantidad, O.NrOperacion, ") 
SQL.ADD(" V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,"~DBO~".VEHICULOS V,"~DBO~".TIPOSOPERACION T ") 
SQL.ADD(" WHERE O.TipoOp In ('TRANSF') ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")


if NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif

if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif 



SQL.ADD(" AND O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND ((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")

if NoVacio(Dialogo.Operador)
  SQL.ADD(" AND O.Operador = '"~Dialogo.Operador~"'")
endif

ACT(xx:2,'')

ACN(FI:1, fac+1)
Recorrer SQL
  If Not EqStr(FBN['Vehiculo1'], Val(xx:2)) Y Not CeldaVacia(xx:2)  
    SetFont(a:Val(FI:1)..Q:FAC,1)
    FormatoCeldas(j:Val(FI:1)..j:fac,Exe('F2'))
    SetFilaActual(FAC+1)
    ACT(a:FAC, 'Vehiculo')
    ACT(b:FAC, 'FechaOp')
    ACT(c:FAC, 'Entidad Origen')
    ACT(d:FAC, 'CBU - Entidad Origen')
    ACT(e:FAC, 'Especie')
    ACT(f:FAC, 'CtraEspecie')
    ACT(g:FAC, 'Tipo Op.') 
    ACT(h:FAC, 'Entidad Destino')
    ACT(i:FAC, 'CBU - Entidad Destino')
    ACT(j:FAC, '')
    ACT(k:FAC, 'Total')
    ACT(l:FAC, 'Nro. Ope.')

    ACT(M:FAC, 'Autorizantes')
    SetFont(a:FAC..M:FAC, 2)
    AgregarMarco(a:FAC..M:FAC,2,0,Exe('COLOR'))
    SetFilaActual(FAC+1) 
    ACN(FI:1, fac)
  EndIf
  
  ACT(a:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',FBN['Vehiculo1']),1,25))
  ACT(b:FAC, FBN['FechaOp'])
  ACT(c:FAC, Copy(BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo',FBN['Cliente1']),1,19))
  ACT(d:FAC, BuscarCampo('CUENTAS', 'CBU', 'Codigo',FBN['Cuenta4']))
  ACT(e:FAC, FBN['Especie'])
  ACT(f:FAC, FBN['Especie'])
  ACT(g:FAC, Copy(FBN['TipoOp']~'-'~FBN['Nombre'],1,16))
  ACT(h:FAC, Copy(BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo',FBN['Cliente2']),1,19))
  ACT(i:FAC, BuscarCampo('CUENTAS', 'CBU', 'Codigo',FBN['Cuenta1']))
  ACT(j:FAC, '')
  ACN(k:FAC, FBN['Cantidad'])
  ACT(l:FAC, FBN['NrOperacion'])
  ACLO(l:FAC, FBN['NrOperacion'])
  ACT(M:fac, fbn('Observac5'))
 
 
  ACT(xx:2, FBN['Vehiculo1'])
Proximo
SetFont(a:Val(FI:1)..Q:FAC,1)
FormatoCeldas(j:Val(FI:1)..j:fac,Exe('F2'))

ACO(1,15)
ACO(2, 6)
ACO(3,12)
ACO(4,14)
ACO(5, 11)
ACO(6, 7)
ACO(7,16)
ACO(8,11)
ACO(9,11)
ACO(10, 4)
ACO(11,9)
ACO(12,7)
ACO(13, 12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
SetFont(g:3,2)
LimitesVision(M:FAC+1)
RangoTitulo(a:1..p:FAC, Val(w1)+10)

SetPrintFit(3, 70)

