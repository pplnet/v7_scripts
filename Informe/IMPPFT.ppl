CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'TIDE|');'Operacion Invalida - Debe ser Plazo Fijo';NO;;;;;;" TipoOp In ('TIDE') " 
  Radio1         :"|Pantalla|Impresora|PDF|Mail"  ;;;;;;;;;1;;;;;
  String1        :'Path Destino'        ;1;2;;NO;;;;;VAR('PATHRESCT2')  
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Courier New,6,B')
CrearFont(4,'Arial,10,B')
CrearFont(5,'Arial,12,')

ACT(AG:100, '00000')
  **AA 03/08/2022 BIND Sucursal siempre Casa Central 27/01/2023 se cambia por sucursal de la cuenta moneda de la TIDE
  *SQL.ADD(" Select Nombre, Localidad From "~DBO~".SUCURSALES Where Codigo = '"~VAR('SUCURSAL')~"' ")
  * Recorrer SQL
  *    dfa    
  *    ACT(SU:1, fbn('Nombre'))    
  *    ACT(SU:2, fbn('Localidad'))            
  *Proximo

SQL.ADD(" Select O.Especie,O.Cliente1, O.Vehiculo1, O.FechaOp, O.FechaVto, O.Plazo, O.TipoOp, O.TipoTasa2, O.Precio1, O.Precio2, O.CB5, O.NrOperacion, ")
SQL.ADD("        O.DiasAnio, O.Plazo, O.PeriodoInts, O.FormaLiquidacion3,  O.Cantidad, O.TotalGanancias, O.PrecioEj Spread, O.TotalRetenciones, ")
SQL.ADD("        C.RazonSocial, C.CUIT, C.Direccion, C.Calle, C.Altura, C.Piso, C.Depto, C.CodigoCNV, C.CategDepositante, C.NroInsc, ")
SQL.ADD("        C.Localidad, C.CodigoPostal, C.Sucursal SucursalCli, CU.Sucursal SucursalCU, E.Alias6, E.Nombre, E.Extendido, O.TotalIntereses, E.CodNumCajaValores, ")
SQL.ADD("        (select count(*) from "~DBO~".INTEGRANTESCLI IT where IT.Codigo = O.Cliente1) as Cuantos ")
SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".CUENTAS CU ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("   AND C.Codigo = O.Cliente1 ")
SQL.ADD("   AND E.Codigo = O.Especie ")
SQL.ADD("   AND CU.Codigo = O.Cuenta4 ")
SetFilaActual(0)
Recorrer SQL
    AFI(fac, 20)
    ACN(DA:100, iif(fbn('DiasAnio') = 0,360,365) )
    SQL.ADD(" Select RazonSocial,Direccion, Calle, Altura, Piso, Depto,Localidad From "~DBO~".CLIENTES Where Codigo = '"~fbn('Vehiculo1')~"' ")
    Recorrer SQL
        dfa
        ACT(RZ:100, fbn('RazonSocial'))        
        ** AA 16-08-2022 Se cambia Direccion por los campos nuevos  Calle Altura Piso Depto
        **ACT(DR:100, fbn('Direccion'))
        ACT(DR:100, fbn['Calle']~' '~fbn['Altura']~' '~fbn['Piso']~' '~fbn['Depto'] )
        ACT(LC:100, fbn('Localidad'))
    Proximo
    **AA 03/08/2022 BIND Sucursal siempre Casa Central 27/01/2023 se habilita sucursal de la cuenta moneda de la TIDE
    SQL.ADD(" Select Nombre, Localidad From "~DBO~".SUCURSALES Where Codigo = '"~fbn('SucursalCU')~"' ")
    Recorrer SQL
        dfa    
        ACT(SU:1, fbn('Nombre'))    
        ACT(SU:2, fbn('Localidad'))            
    Proximo
    act(ar:1,Dialogo.String1~'Certificado_'~fbn('Cliente1')~'-'~Copy(FBN['NrOperacion'],2,7)~'.pdf')
    
    *&k representa las 3 copias de Certificados. CAL 22-OCT-22
    Recorrer&k 1, 3
    
    ACT(b:fac, '  NO COMPENSABLE POR CAMARA')
        ifa
        ACT(im:101, PYC(fbn('Cantidad'), 1, 2))
        ACN(im:102, 25)
        ACT(im:103, PAD('',val(im:102)-Longitud(val(im:101)),' ')~val(im:101))
        ACT(k:fac, val(im:103))
        
        AlinearCeldas(i:fac..i:fac, 'I')
        AlinearCeldas(k:fac..k:fac, 'D')
        AgregarMarco(i:fac..k:fac, 2, 0)
        SetFont(i:fac..k:fac, 5)
        acn(FD:1,FAC)
        ACN(FI:300, fac)
        ACN(FI:200, fac)
        AFI(fac, 30)
        
        IFA
        IFA
        
        ACT(e:fac, 'INSTRANSFERIBLE TITULOS')
        AFI(fac, 14)
        ifa
        AFI(fac, 7)
        ACT(b:fac, 'SIN Garantia - Cancelacion Normal')
        ACT(f:fac,'N.Cliente: '~fbn('Cliente1')~' Op.: '~Copy(FBN['NrOperacion'],2,7))
        ifa
        act(nu:1, '322-003-0000')
        (.'DIGVER9713'.)
        
        **************************************
        *Inicio de edición del segundo cuadro - CAL 22/OCT/2022
        **************************************
        *La edición consiste en subir una fila el cuadro que está abajo del cuadro del importe en pesos.
        *Ojo que tiene varias líneas que setean las fuentes y también hay que restarle una fila
        *Las columnas afectadas por este desplazamiento son la K y la J
        
        *Primera fila del cuadro - CAL 22/OCT/2022
        ACT(k:fac-1, val(nu:1)~' '~Val(dv:1))
        SetFont(k:fac-1, 5)
        
        ACT(b:fac, Val(DR:100)~'    '~Copy(Val(LC:100), 1, 8))
        ** AA Ver si lugar es fijo o variable
        ACT(b:fac, 'Lugar y Fecha de emision Ciudad Autonoma de Buenos Aires, '~Pad0(Fstr(Dia(fbn('FechaOp')),0,0),2)~'  de '~Meses(Mes(fbn('FechaOp')))~'  de '~Pad0(Fstr(Anio(fbn('FechaOp')),0,0),4))
        ACN(me:1,Mes(fbn('FechaOp')))
        ACN(me:2,Anio(fbn('FechaOp')))
        ifa
        act(nu:1, '0'~Copy(FBN['NrOperacion'],2,7))
        (.'DIGVER9713'.)
        
        *Segunda fila del cuadro - CAL 22/OCT/2022
        ACT(k:fac-1, val(nu:1)~' '~Val(dv:1))
        SetFont(k:fac-1, 5)
        
        ACT(d:fac, '     '~Pad0(Fstr(Dia(fbn('FechaVto')),0,0),2))
        ACT(e:fac, Pad0(Fstr(Mes(fbn('FechaVto')),0,0),2))
        ACT(f:fac, Fstr(Anio(fbn('FechaVto')),0,0))
        SetFont(d:fac..f:fac, 4)
        AlinearCeldas(d:fac..f:fac,"I")
        ifa
        act(nu:1, '77777777777')
        (.'DIGVER9713'.)
        
        *Tercera fila del cuadro - CAL 22/OCT/2022
        ACT(k:fac-1, val(nu:1)~' '~Val(dv:1))
        SetFont(k:fac-1, 5)
        
        *Bordes del cuadro: - CAL 22/OCT/2022
        AgregarMarco(j:fac-4..k:fac, 2, 0)
        AlinearCeldas(k:fac-4..k:fac, 'D')
        
        **************************************
        *Fin de edición del segundo cuadro - CAL 22/OCT/2022
        **************************************
        
        **********************
        *REVISAR LO SIGUIENTE:
        **********************
        *Hay algo raro con la colocación de guiones medios en el importe en letras (en la primera fila los coloca pero en la segunda, no) - CAL 22/OCT/22
        
        *--Importe en Letras---------------------- 
        **ACT(b:fac,'Especie Depositada: '~fbn('Nombre'))
        ** Se cambia nombre por nro caja de valores
        ACT(b:fac,'Especie Depositada: '~fbn('CodNumCajaValores')~' - '~fbn('Extendido'))
        ACT(LE:100, 'VALOR NOMINAL: '~Letras( fbn('Cantidad') ,0,1000))
        If Longitud(Val(le:100))<=70 
          ACT(le:101, Val(le:100))
          ACT(le:102, '')
        Else  
          ACN(HT:1, Posicion(" ",Val(LE:100),55,1000))
          ACN(HT:2, Posicion(" ",Val(LE:100),Val(ht:1)+1,1000))
          If Val(ht:2)<70
             ACN(ht:1, Val(ht:2))
          Endif   
          ACT(le:101, Copy(Val(le:100),1,Val(ht:1)))
          ACT(le:102, Copy(Val(le:100),Val(ht:1)+1,1000))
        Endif
        
        IFA
        AFI(fac, 20)
        
        If Not EqStr(Val(le:102),'')
        
           *Cantidad de letras de 'VALOR NOMINAL: ' 15
           *Le asigno 'VALOR NOMINAL: ' a C y al resto se lo agrego a D para que quede mejor alineado - CAL 22/OCT/22
        
           ACT(C:fac, Copy(val(LE:101),1,15))
           ACT(D:fac, Copy(val(LE:101),15, Longitud(Val(LE:101))-15))
        else      
           ACT(LE:103,Pad(Val(LE:101),(150-Longitud(Val(LE:101))),'-'))      
           ACT(c:fac, Copy(Val(le:103),1,15))
           ACT(d:fac, Copy(Val(le:103),15,Longitud(Val(LE:103))-15))
        endif
        
        AlinearCeldas(C:FAC,"D")
        AlinearCeldas(D:FAC,"I")
        
        IFA
        ACT(C:FAC,val(LE:102))
        AlinearCeldas(C:FAC,"I")

        
        *Revisar todo lo de arriba desde el comentario "Importe en letras" - CAL 22/OCT/22

        ifa
        ACT(b:fac,'Imp. Depositado')
        ACT(d:fac,'Plazo')
        ACT(e:fac,'TNA%')
        ACT(f:fac,'TEA%')
        ACT(g:fac,'Periodo liq. Int.')
        ACT(h:fac,'Total Interes (VN)')
        ACT(k:fac,'Retencion')
        ifa
        AFI(fac, 14)
        ACT(im:101, 'V/N '~PYC(fbn('Cantidad'), 1, 2))
        ACN(im:102, 25)
        ACT(im:103, PAD('',val(im:102)-Longitud(val(im:101)),' ')~val(im:101))
        ACT(b:fac, val(im:103))
        ACT(b:fac, val(im:101))
        ACT(d:fac, Fstr(fbn('Plazo'), 0, 0))
        AlinearCeldas(d:fac, 'C')
        ACN(e:fac, fbn('Precio1'))
        ACN(PL:100, fbn('Plazo'))
        ***---TEA
        ACN(TE:100, (((1 + (fbn('Precio1') * Val(PL:100) / (Val(DA:100) * 100))) ^ (Val(DA:100) / Val(PL:100))) - 1) * 100)
        ACN(f:fac, Val(TE:100))
        ACT(g:fac,'Al Vencimiento')
        ACT(im:101, PYC(fbn('TotalIntereses'), 1, 2))
** FJL 03/09/2025 - Issue EXTBIND-8566
*        ACN(im:102, 12)
        ACN(im:102, 20)
        ACT(im:103, PAD('',val(im:102)-Longitud(val(im:101)),' ')~val(im:101))
        ACT(h:fac, '         '~val(im:103))        
        ACT(j:fac,'Ganancias')        
        ACT(im:101, PYC(fbn('TotalGanancias'), 1, 2))
** FJL 03/09/2025 - Issue EXTBIND-8566
*        ACN(im:102, 14)
        ACN(im:102, 15)
        ACT(im:103, PAD('',val(im:102)-Longitud(val(im:101)),' ')~val(im:101))
        ACT(k:fac, '     '~val(im:103))
        ifa
        ACT(j:fac,'Impuesto')
        ACT(im:101, PYC(fbn('TotalRetenciones'), 1, 2))
** FJL 03/09/2025 - Issue EXTBIND-8566
*        ACN(im:102, 12)
        ACN(im:102, 15)
        ACT(im:103, PAD('',val(im:102)-Longitud(val(im:101)),' ')~val(im:101))
        ACT(k:fac, '     '~val(im:103))

        AlinearCeldas(e:fac..i:fac, 'C')
        AlinearCeldas(h:fac-1..h:fac-1, 'D')
        AlinearCeldas(j:fac..j:fac, 'I')
        AlinearCeldas(k:fac-1..k:fac, 'D')
        FormatoCeldas(e:FAC..f:FAC,Exe('F2'))
        AgregarMarco(b:fac-2..c:fac-2, 2, 0)
        AgregarMarco(d:fac-2, 2, 0)
        AgregarMarco(e:fac-2, 2, 0)
        AgregarMarco(f:fac-2, 2, 0)
        AgregarMarco(g:fac-2, 2, 0)
        AgregarMarco(h:fac-2..i:fac-2, 2, 0)
        AgregarMarco(j:fac-2..k:fac-2, 2, 0)

        AgregarMarco(b:fac-1..c:fac, 2, 0)
        AgregarMarco(d:fac-1..d:fac, 2, 0)
        AgregarMarco(e:fac-1..e:fac, 2, 0)
        AgregarMarco(f:fac-1..f:fac, 2, 0)
        AgregarMarco(g:fac-1..g:fac, 2, 0)
        AgregarMarco(h:fac-1..i:fac, 2, 0)
        AgregarMarco(j:fac-1..k:fac, 2, 0)
        
        *Se elimina el espacio entre el cuadro de "Imp. depositado" y el renglón de "Cuenta". CAL 11/7/2022
        *ifa
        *AFI(fac, 7)
        ifa
        AFI(fac, 7)
        ACT(b:fac, 'Cuenta:')
        ACT(c:fac, 'ORDEN UNIPERSONAL')
        AFI(fac, 7)
        ACN(FI:100, fac)
        ifa
        ACT(b:fac, 'Domicilio: '~fbn['Calle']~' '~fbn['Altura']~' '~fbn['Piso']~' '~fbn['Depto']~'- ('~fbn['CodigoPostal']~') - '~fbn['Localidad'])        
        AFI(fac, 7)
        IFA
        SQL.ADD("Select 1 TpReg, 'CUI' TipoDocumento,CUIT NrDocumento, RazonSocial Apellido,'' Nombre")
        SQL.ADD("from CLIENTES CL ")
        SQL.ADD(" Where CL.Codigo='"~FBN['Cliente1']~"'  ")        
        SQL.ADD("UNION ")
        SQL.ADD("Select 2 TpReg, ICL.TipoDocumento,ICL.NrDocumento, Apellido, Nombre")
        SQL.ADD("from INTEGRANTESCLI ICL ")
        SQL.ADD("left join PERSONAS P with (nolock) on ICL.TipoDocumento=P.TipoDocumento and ICL.NrDocumento=P.NrDocumento ")
        SQL.ADD(" Where ICL.Codigo='"~FBN['Cliente1']~"' and ICL.TipoPoder='RLE' ")
        SQL.ADD(" Order by TpReg ")
        watch(SQL.Batch)
        ACN(xx1,1)
        Recorrer SQL
           DFA
           ACT(xa:val(xx1),Trim(FBN['Apellido']))
           ACT(xb:val(xx1),Trim(FBN['Nombre']))
           ACT(xc:val(xx1),Trim(iif(EqStr(FBN['TipoDocumento'],'CUI'),'CUIT',iif(EqStr(FBN['TipoDocumento'],'CIL'),'CUIL',FBN['TipoDocumento']))))
           ACT(xd:val(xx1),Trim(FBN['NrDocumento']))
           ACN(xe:val(xx1),FBN['TpReg'])
           SCN(xx1,1)
        Proximo
        ** AA 13-10-2022 con 4 se pasa del alto del certificado??
        Recorrer&j 1,4

           If Incluido(Val(xc:&j),'CUIL|CUIT')        
              ACT(zz1, Val(xd:&j))
              If [NoVacio(Val(zz1)) y Not EqStr(Val(zz1), '000000000000000')]
                 If [EqStr(Copy(Val(zz1), 01, 04), '0000')]
                    ACT(ZB:10, Copy(Val(zz1), 05, 11))
                 Else  
                    If [[EqStr(Copy(Val(zz1), 03, 01), '-')] y [EqStr(Copy(Val(zz1), 12, 01), '-')]]
                       ACT(ZB:10, Copy(Val(zz1), 01, 13))
                    Else           
                       ACT(ZB:10, Copy(Val(zz1), 01, 11))
                    EndIf      
                 EndIf
              Else
                 ACT(ZB:10, '')
              EndIf
        
              ACT(ZB:11, Val(zz2))
              (.'ARMACUIT'.)
           Else
              if NoVacio(Val(xc:&j))
                 ACT(ZB:12,' '~Val(xc:&j)~' '~Val(xd:&j))
              Else
                 ACT(ZB:12,'')
              Endif
           Endif
           IF EqStr(Val(zb:12),'')
              ACT(b:fac,'')
           Else 
           ** AA 17-02-23 Si es Fondo CodigoCNV distinto de cero y es el titular --> IRPC
              If EqStr(fbn('CategDepositante'),'FON')
                 if  Num(FSTR(fbn('CodigoCNV'),0))<>0  y  Val(xe:&j)=1
                     ACT(b:fac, 'I.R.P.C. '~FSTR(fbn('CodigoCNV'),0)~' '~Val(ZB:12)~' '~Val(xa:&j)~', '~Val(xb:&j))
                 else
                     ** CodigoCNV = 0 o son cotitulares
                     ACT(b:fac, Val(ZB:12)~' '~Val(xa:&j)~', '~Val(xb:&j))
                 Endif
              Else
                 ** Titular tiene NroIncripcion --> IRPC
                 if Val(xe:&j)=1 y Num(FSTR(fbn('NroInsc'),0))<>0
                    ACT(b:fac, 'I.R.P.C. '~FSTR(fbn('NroInsc'),0)~' '~Val(ZB:12)~' '~Val(xa:&j)~', '~Val(xb:&j))
                 else
                    ACT(b:fac, Val(ZB:12)~' '~Val(xa:&j)~', '~Val(xb:&j))
                 endif   
              Endif   
           Endif   
           AFI(fac, 14)
            
           IFA
        ** Fin cotitulares
        Proximo
       
        SetFilaActual(FAC-2)
        ** AA 27/01/2023 se modificad por sucursal de la cuenta moneda
        *ACT(b:fac, 'Sucursal: '~Val(SU:1)~' ('~VAR('SUCURSAL')~') '~Val(SU:2))
        ACT(b:fac, 'Sucursal: '~Val(SU:1)~' ('~fbn('SucursalCU')~') '~Val(SU:2))
        AFI(fac, 7)
        ifa
        ACT(b:fac, Val(RZ:100)~' '~VAR('LEYCERTPF'))
        AFI(fac, 7)
        
        IF &k > 0
            SetFilaActual(fac+1)
            **AA 22-09-2025 se incorpora al interlineado 2 lineas
            ifa
            IFA
       ENDIF
** Fin impresion certificado x 3      
    Proximo
** Fin Lectura Certificado    
Proximo

ACO(1,30)
ACO(2, 10)
ACO(3, 7)
ACO(4, 7)
ACO(5, 7)
ACO(6, 7)
ACO(7, 9)
ACO(8, 10)
ACO(9, 4)
ACO(10, 4)
ACO(11, 16)

SetPrintFit(3,82)
SetMargins(0.3, 0, 0, 1)
LimitesVision(K:fac+1)

If Dialogo.Radio1 = 1
   ImprimirHoja
Else
   If Dialogo.Radio1 = 2
      ExportarPdf(Val(ar:1))
   Else
      IF Dialogo.Radio1 = 3
         ** MAIL
      Endif
   Endif
Endif   