*- CAIDA7 - Auxiliar de Caida de Prestamos por Año
ModoReproceso(SinDialogo)
CrearDialogo
  Cliente1   : "Entidad"           ;;;
  Vehiculo1  : "Vehiculo"          ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"           ;;;
  TipoOp1    : "Tipo Op."          ;;;  
  Entero1    : "Año"               ;;;;;;NOVACIO(Dialogo.Entero1);'Año Incorrecto';NO;Anio(Fsys);;
  Especie2   : "Expresado en "     ;;;;;;;;;'ARP';;
  Radio1     : 'Op.|ON|Resto'      ;;;;;;;;;1;;
  Fecha1     : "Fecha"             ;;;;;;NOVACIO(Dialogo.Fecha1);'Fecha Incorrecto';NO;Fsys;;
  Fecha2     : "FechaDesde"        ;;;;;;NOVACIO(Dialogo.Fecha1);'Fecha Incorrecto';NO;Fsys;;
  Fecha3     : "FechaHasta"        ;;;;;;NOVACIO(Dialogo.Fecha1);'Fecha Incorrecto';NO;Fsys;;
FinDialogo
If Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
 *     Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,"Detalle de Caida de Prestamos por Año ")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+1, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+1, 'Entidad : Todos')
endif
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+2, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+3, 'Especie : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+4, 'Tipo Op.: '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+4, 'Tipo Op.: Todos')
endif
act(a:fac+5,'Año : '~Fstr(Dialogo.Entero1,0,0)~' Desde: '~Dialogo.Fecha2~' Hasta: '~Dialogo.Fecha3)
act(a:fac+6,'Expresado en Miles de '~Dialogo.Especie2)

SetFont(a:fac..a:fac+6,2)

* z2, z3: Comienzo y Fin de Año
*ACD(z2,Fecha('01/01/'~Fstr(Dialogo.Entero1,0,0)))
*If val(z2)<Dialogo.Fecha1
*   ACD(z2,Dialogo.Fecha1)   
*EndIf
*ACD(z3,Fecha('01/01/'~Fstr(Dialogo.Entero1+1,0,0))-1)

ACD(z2,Dialogo.Fecha2)
ACD(z3,Dialogo.Fecha3)

SetFilaActual(FAC+7)

ACT(a:FAC, 'Fecha Op.')
ACT(b:FAC, 'Plazo')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Monto')
ACT(f:FAC, 'Capital')
ACT(g:FAC, 'Int+Imp')
ACT(h:FAC, 'Fecha Vto.')
ACT(i:FAC, 'Tipo Op.')
ACT(j:FAC, 'Numero Op.')
ACT(k:FAC, 'Cliente')
SetFont(a:FAC..k:FAC,2)
AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))


*----- Todas las Operaciones excepto ON 
If Dialogo.Radio1=1 
   *- MMFIMV y MMSIMV Definitivos -> RB5=0
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
   SQL.ADD(" C.Fecha3 Vto, C.Cantidad5 Monto, ")
   SQL.ADD(" C.Cantidad4 Capital,'CUO' as Tipo ")
   SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   Endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   EndIf
   SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha3>'"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.RB5='0' and C.Fecha3 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   *- MMFIMV y MMSIMV Capital de No Definitivos -> RB5=0
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
   SQL.ADD(" O.FechaVto Vto, 0 Monto, ")
   SQL.ADD(" O.Cantidad Capital, 'CUO' as Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('MMFIMV','MMSIMV') ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   Endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   EndIf
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.RB5='1' and O.FechaVto Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   *- MMFIMV y MMSIMV Intereses de No Definitivos -> RB5=0
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
   SQL.ADD(" C.Fecha3 Vto, C.Cantidad5 Monto, ")
   SQL.ADD(" 0 Capital,'CUO' as Tipo ")
   SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   Endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   EndIf
   SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha3>'"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.RB5='1' and C.Fecha3 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   *-----------
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
   SQL.ADD(" C.Fecha2 Vto,  ")
   SQL.ADD(" C.Total3 Monto, C.Cantidad1 Capital,'CUO' as Tipo ")
   SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.TipoOp In ('MMPCLM','MMPEM','MMPIM','MMPOSM') ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and C.Fecha2 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD(" O.FechaVto2 Vto,  ")
   SQL.ADD(" O.TotalNetoCli2 Monto, O.Cantidad Capital,'OPE' as Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('MMFRNP','MMPSI') ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and O.FechaVto2 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD(" O.FechaVto Vto,  ")
   SQL.ADD(" O.TotalNetoCli2 Monto, O.PrecioEj Capital,'OPE' as Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('MMPCL','MMPCOS','MMPE','MMPI') ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and O.FechaVto Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD("O.FechaVto Vto,  ")
   SQL.ADD("O.TotalIntereses+ImporteImp Monto, O.Cantidad Capital, 'OPE' as Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('MMPLME') ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and O.FechaVto Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"'")
   SQL.ADD(" Union ")
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD("C.Fecha1 Vto,  ")
   SQL.ADD("C.Importe1 Monto, 0 Capital,Tipo  ")
   SQL.ADD(" from "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and ( O.TipoOp In ('MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPLME','MMPSI','MMSIMV','MMFRNP','MMFIMV') ")
   SQL.ADD(" or (O.TipoOp In ('MMP') and Tipo='4') or (O.TipoOp In ('MMFCMV','MMSCMV','MMFRN','MMPSC') and Tipo Not In ('5','3')) ) ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha1>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD(" and C.Fecha1 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" and C.Tipo <> '5' ")
   SQL.ADD("order by 1, 3")
EndIf

*- ON y ONM
If Dialogo.Radio1=0
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD(" C.Fecha3 Vto,  ")
   SQL.ADD(" C.Cantidad5 Monto, C.Cantidad4 Capital,'CUO' as Tipo ")
   SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   Endif
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   EndIf
   SQL.ADD(" and O.TipoOp In ('MMONM') ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha3 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD(" O.FechaVto2 Vto,  ")
   SQL.ADD(" O.TotalNetoCli2 Monto,O.PrecioEj Capital,'OPE' as Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('MMON') ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   Endif
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   Endif
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   Endif
   If NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.FechaVto2 Between '"~IdxDate(Val(z2))~"' and '"~IdxDate(Val(z3))~"' ")
   SQL.ADD(" Union ")
   SQL.ADD(" Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1,")
   SQL.ADD(" C.Fecha1 Vto,  ")
   SQL.ADD(" C.Importe1 Monto, 0 Capital,Tipo  ")
   SQL.ADD(" from "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
   endif
   SQL.ADD(" and O.TipoOp In ('MMON','MMONM') ")
   SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Tipo <> '5' ")
   SQL.ADD("order by 1, 3 ")
EndIf

* Z1: Acumulador
acn(z1,0)

Recorrer SQL

  acd(a:fac,fbn['FechaOp'])   
  acn(b:fac,fbn['FechaVto']-Fsys)   
  act(c:fac,fbn['Vehiculo1'])   
  act(d:fac,fbn['Especie'])   
  acn(z10,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,Dialogo.Especie2))
  acn(e:fac,(fbn['Capital']+fbn['Monto'])*val(z10))   
  acn(f:fac,fbn['Capital']*val(z10))   
  acn(g:fac,val(e:fac)-val(f:fac))   
  acd(h:fac,fbn['Vto'])
  act(i:fac,fbn['TipoOp'])   
  act(j:fac,fbn['NrOperacion'])   
  aclo(j:fac,fbn['NrOperacion'])  
  act(k:fac,fbn['Cliente1'])    

  scn(z1,val(e:fac))
  scn(z4,val(f:fac))
  scn(z5,val(g:fac))

  SetFont(a:fac..k:fac,1)
  FormatoCeldas(b:fac..b:fac, Exe('F0'))

proximo

ACT(a:fac+1,'Total en '~Dialogo.Especie2~' ...')
ACN(e:fac+1,VAL(z1))
ACN(f:fac+1,VAL(z4))
ACN(g:fac+1,VAL(z5))

SetFont(a:fac+1..k:fac+1,1)
AgregarMarco(a:FAC+1..k:FAC+1,2,0)

Recorrer&i 1,8
  ACO(&i,10)
proximo

Impresion(1,2)

SetFilaActual(fac+3)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
*RangoTitulo(a1..k:8,36)
