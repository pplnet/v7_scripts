ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:  'D.FechaAcr'   ;1;1;;;;;;;PRIDEMES(fsys)
  Fecha2:  'H.FechaAcr'   ;1;2;;;;;;;fsys
  Radio1:  'Tipo|Debitos|Creditos|Ambos' ;2;1;;;;;;;2
  Radio2:  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;3;1;;;;;;;4
  Radio3 : 'Estado Aprobacion|Pendientes|OK|Todos'         ;4;1;;;;;;;2
  Check2:  'Incluye Pagadoras';5;1;;;;;;;1
  Check1:  'Incluye INI' ;6;1;;;;;;;0;
  Lista1:   'Vehiculos' ; 7;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
*  Lista4:   'Conceptos' ; 1;2;;;;;;;;;SQLSet(" Select Distinct TipoMov From "~DBO~".MOVDATANET ");
*  Lista4:   'Conceptos' ; 1;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET Order by Codigo ");
  Lista4:   'Conceptos' ; 1;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET Where Tipo Not IN ("~Pipe2Comillas(Var('CODTNOI'))~") OR Tipo Is Null Order by Codigo ");
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ;-4;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~" ) " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(MM:1, SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET Where Tipo IN ("~Pipe2Comillas(Var('CODTNOI'))~") "))

ACT(a:1, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:2, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:3, 'Cuentas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Conceptos: '~iif(vacio(Dialogo.Lista4),'Todos',Pipe2Comillas(Dialogo.Lista4)))
IF Dialogo.Check1 = 0
    ACT(A:5, '(NO incluye los movimientos de la bajada inicial)')
ELSE
    ACT(A:5, '(Incluye los movimientos de la bajada inicial)')
ENDIF
If Dialogo.Radio1=0
  ACT(a:6, 'Solo Debitos')
Endif
If Dialogo.Radio1=1
  ACT(a:6, 'Solo Creditos')
Endif
If Dialogo.Radio1=2
  ACT(a:6, 'Creditos y Debitos')
Endif
If Dialogo.Radio2=0
  ACT(a:7, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:7, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:7, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:7, 'Tipo de Cta: Caja de Ahorro')
Endif
If Dialogo.Radio2=4
  ACT(a:7, 'Tipo de Cta: Todas')
Endif
If Dialogo.Check2=0
  ACT(a:7, Val(a:7)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:7, Val(a:7)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:1..a:7,2)

ACT(c:8, 'Extracto Bancario Datanet '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(c:8,3)

SetFilaActual(9)

SQL.ADD(" SELECT M.*, E.Nombre, E.Codigo MonedaFPA, V.Descripcion, V.Codigo VehiculoFPA, ")
SQL.ADD(" C.Numero, C.Codigo CuentaFPA, C.Alias3, C.TipoCuenta, B.Codigo BancoFPA, B.RazonSocial, ")
SQL.ADD(" CN.NrOperacion CNNrOperacion, CN.NrMovimiento CNNrMovimiento, CD.Descripcion DescripcionCD, ")
SQL.ADD(" CD.Tipo, TCD.Descripcion DescripcionTCD, D.EstadoAprobacion ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".VEHICULOS V, "~DBO~".CONCILIACIONES CN, "~DBO~".CODIGOSDATANET CD, ")
SQL.ADD(" "~DBO~".TIPOSCODIGODATANET TCD, "~DBO~".DATANET D ")
SQL.ADD(" WHERE M.Moneda    = E.Alias3 ")
SQL.ADD(" AND   M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND   M.Vehiculo  = V.Codigo ")
SQL.ADD(" AND   M.Cuenta    = C.Numero ")
SQL.ADD(" AND   C.Estado    = 'HAB' ")
* 12/11/2004 SQL.ADD(" AND   M.Banco     = B.Alias2   ")
* Esto cambia porque ya no se graba el codigo datanet de banco en la tabla MOVDATANET sino el codigo de cliente FPA.
SQL.ADD(" AND   (M.Banco  = B.Alias2 OR M.Banco = B.Codigo)  ")
SQL.ADD(" AND   C.Comitente = B.Codigo   ")
SQL.ADD(" AND   M.TipoMov   = CD.Codigo   ")
SQL.ADD(" AND   CD.Tipo     = TCD.Codigo  ")
SQL.ADD(" AND   M.NrDatanet = CN.NrDataNet  ")
SQL.ADD(" AND   M.NrMovDatanet = CN.NrMovDataNet  ")
SQL.ADD(" AND   (M.TipoMov   Not IN  ('SAL','DIS','MD') OR M.TipoMov IS NULL)")
SQL.ADD(" AND   M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   M.EstadoConciliacion Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
If Dialogo.Radio3=0
  SQL.ADD(" AND  (D.EstadoAprobacion = 'P' OR D.EstadoAprobacion IS NULL)")
Endif
If Dialogo.Radio3=1
  SQL.ADD(" AND  D.EstadoAprobacion = 'OK' ")
Endif
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND M.TipoMov IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
 Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
     SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
   Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND B.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If Dialogo.Radio1=0
  SQL.ADD(" AND M.DC = 'D' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND M.DC = 'C' ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check2=0
  SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
IF Dialogo.Check1 = 0
  SQL.ADD(" AND M.TipoMov <> 'INI' ")
ENDIF
SQL.ADD(" ORDER BY V.Codigo, B.Codigo, C.Codigo, E.Codigo, M.FechaAcreditacion ")

ACT(va:1,'')
ACT(ba:1,'')
ACT(ea:1,'')
ACT(ca:1,'')

Recorrer SQL
  If Not Eqstr(fbn('VehiculoFPA'),Val(va:1)) o Not Eqstr(fbn('BancoFPA'),Val(ba:1)) o Not Eqstr(fbn('CuentaFPA'),Val(ca:1)) o Not Eqstr(fbn('MonedaFPA'),Val(ea:1))
    If Not Eqstr(Val(va:1),'')
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Descripcion')~'  Banco: '~fbn('RazonSocial'))
    message('_____  Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    ACT(a:fac, 'Banco: '~fbn('RazonSocial'))
    ACT(e:fac, 'Vehiculo: '~fbn('Descripcion'))
    ACT(tc:1, iif(eqstr(fbn('TipoCuenta'),'CC'),'Cuenta Corriente', iif(eqstr(fbn('TipoCuenta'),'CA'),'Caja de Ahorro',iif(eqstr(fbn('TipoCuenta'),'VIS'),'Cuenta Vista',IIF(eqstr(fbn('TipoCuenta'),'CUS'),'Cuenta Custodia')))))
    ACT(a:fac+1, 'Extracto de '~Val(tc:1)~' en '~fbn('Nombre'))
    ACT(a:fac+1, Val(a:fac+1)~' - '~iif(eqstr(fbn('EstadoAprobacion'),'OK'),'Aprobado por Supervisor.','Aprobacion de Supervisor Pendiente.'))
    ACT(e:fac+1, 'Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    SetFont(a:fac..g:fac+1,2)
    AgregarMarco(a:fac..H:fac+1,0,0,RGB(162,222,251))

    SetFilaActual(fac+2)
    ACT(a:fac,   'Concepto')
    ACT(b:fac,   'Tipo')
    ACT(c:fac,   'Fecha')
    ACT(c:fac+1, 'Acreditacion')
    ACT(d:fac,   'Comprobante')
    ACT(e:fac,   'Sucursal')
    ACT(f:fac,   'Importe')
    ACT(g:fac,   'Estado')
    ACT(g:fac+1, 'Conciliacion')
    ACT(h:fac,   'Operacion FPA')
    
    SetFont(a:fac..h:fac+1,2)
    AlinearCeldas(a:fac..h:fac+1,'C')
    AgregarMarco(a:fac..h:fac+1,0,0,RGB(199,207,207))
    ifa
    ifa
  Endif

  ACT(a:fac, fbn('TipoMov')~' - '~fbn('DescripcionCD'))
  ACT(b:fac, fbn('Tipo')~' - '~fbn('DescripcionTCD'))
  ACD(c:fac, fbn('FechaAcreditacion'))
  ACT(d:fac, fbn('Comprobante'))
  ACT(e:fac, fbn('Sucursal'))
  ACN(f:fac, fbn('Importe')*iif(Eqstr(fbn('DC'),'D'),-1,1 ))
  ACT(g:fac, IIF(Eqstr(fbn('EstadoConciliacion'),'OK'),'Conciliado', IIF(eqstr(fbn('EstadoConciliacion'),'P'),'Pendiente',iif(eqstr(fbn('EstadoConciliacion'),'IE'),'Ingreso Ejecutado', 'Ingreso Pendiente'))) )
  ACT(g:fac, IIF(Eqstr(fbn('TipoMov'),'INI'),'Carga Inicial',Val(g:fac)))
  ACT(h:fac, fbn('CNNrOperacion')~' ('~fstr(fbn('CNNrMovimiento'),0,0)~')')

  FormatoCeldas(f:fac, EXE('F2'))
  SetFont(a:fac..h:fac,1)

  ACT(va:1,fbn('VehiculoFPA'))
  ACT(ba:1,fbn('BancoFPA'))
  ACT(ea:1,fbn('MonedaFPA'))
  ACT(ca:1,fbn('CuentaFPA'))
