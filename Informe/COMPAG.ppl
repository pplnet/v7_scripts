*------De esta forma se calcula antes los devengamientos de las comisiones CPI (tipo=3)
*---
*-- Importe devengado acumulado
*IF FBN['FechaVto'] > Dialogo.Fecha3
*   IF FBN['Tipo']<=5
*      IF FBN['Tipo']<=2 O FBN['Tipo']=5 O FBN['Tipo']=4
*         ACN(j:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],Dialogo.Fecha3,,NO)+1)/FBN['Plazo']))
*      else
*       IF FBN['Tipo']=3
*          IF FBN['RB2']=0
*             ACN(j:fac,((FBN['Cantidad']+FBN['TotalComisiones'])*FBN['Tasa1']*(DIFDIAS(FBN['FechaOp'],Dialogo.Fecha3,,NO)+1)/36000))
*          else
*             ACN(j:fac,((FBN['Cantidad']+FBN['TotalComisiones'])*FBN['Tasa1']*(DIFDIAS(FBN['FechaOp'],Dialogo.Fecha3,,NO)+1)/36500))
*          endif
*       endif
*    endif
*   endif
*ELSE
*   IF FBN['Tipo']<=5
*      IF FBN['Tipo']<=2 O FBN['Tipo']=5 O FBN['Tipo']=4
*         ACN(j:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],FBN['FechaVto'],,NO))/FBN['Plazo']))
*      else
