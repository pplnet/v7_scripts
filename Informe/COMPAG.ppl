HOJAVISIBLE(SI)
*ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1    : "Vehiculo"      ;1;1;;;;;;;'TELECOM';;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1     : "Cliente"       ;2;1;;;;;;;;;;
  NrOperacion1 : "Nr.Operacion"  ;3;1;;;;;;;;;;;" TipoOp In ('MMPSC','MMPSI','MMSCMV','MMSIMV','MMCCR','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMFCMV','MMFRN','MMP')"
* El 18/09 se pide eliminar las operaciones ON's  NrOperacion1 : "Nr.Operacion"  ;3;1;;;;;;;;;;;" TipoOp In ('MMON','MMONM','MMPSC','MMPSI','MMSCMV','MMSIMV','MMCCR','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMFCMV','MMFRN','MMP')"
  Label1       : ''              ;1;2;;NO;;;;;'Comisiones'
  Fecha1       : "Desde "        ;2;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;PriDeMes(Fsys,SI);
  Fecha2       : "Hasta "        ;3;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys;
  Fecha3       : "Vigencia"      ;4;2;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha de Vigencia';NO;FSys;

  Especie1     : "Especie"       ;4;1;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una especie monetaria';NO;'ARP';
  Radio1       : "Expresado|ARP  |USD    "  ;5;2;;;;;;;0
*-- esto está en ccrema
  Precio1      : "T.Cambio"      ;5;1;;[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1=1] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1=0];[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1=1] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1=0];[Dialogo.Precio1>0] O [Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1=1] O [Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1=0];'Tipo de Cambio Invalido';NO;;IIF(Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1=1, CotizacionC(Dialogo.Especie1,,,,Fsys,1,SI,Var('MONEEXTR'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONEEXTR')),'INV'),-1,1), IIF(Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1=0, CotizacionC(Dialogo.Especie1,,,,Fsys,1,SI,Var('MONELOCA'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONELOCA')),'INV'),-1,1),1));;;'###,###.########';
  Radio2       : 'TipoOp |Todas|Algunas'  ;6;1;;;;;;;0;
  Radio3       : 'Comisiones |Todas|Algunas'  ;6;2;;;;;;;0;
  Lista1       : "TipoOp"        ;8;1;;Dialogo.Radio2=1;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMPSC','MMPSI','MMSCMV','MMSIMV','MMCCR','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMFCMV','MMFRN','MMP') ");
  Lista2       : "Comisiones"    ;2;2;;Dialogo.Radio3=1;;;;;;;VAR('TCOMISION');
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
ACN(fi1,0)

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)
ACT(j:FAC,'Fecha : '~Var('FECHASYS')~'    Hora: '~HORA(AHORA) )
SetFont(j:FAC..j:FAC,1)

SetFilaActual(4)
ACT(a:FAC,'Comisiones de Prestamo')
SetFont(a:FAC, 3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Cliente : Todos')
endif

ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio1=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
*--ACN(az1,CotizacionC(Dialogo.Especie1,,,,Fsys,1,SI,IIF(Dialogo.Radio1=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )

IF [Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1=1] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1=0]
    ACT(d:FAC+3, 'Expresado en '~Val(mo1)~'  (TC: '~Fstr(Dialogo.Precio1, 0, 8)~')')
ENDIF
*--ACT(d:FAC+3, 'Expresado en '~Val(mo1)~'  (TC: '~Val(az1)~')')

if Dialogo.Radio2 = 0
  ACT(a:FAC+4, 'Operaciones : Todas')
else
  ACT(a:FAC+4, 'Operaciones : '~Dialogo.Lista1)
endif

if Dialogo.Radio3 = 0
  ACT(a:FAC+5, 'Comisiones : Todas')
else
  ACT(a:FAC+5, 'Comisiones : '~Dialogo.Lista2)
endif

ACT(a:FAC+6, 'Comisiones Desde : '~Dialogo.Fecha1)
ACT(d:FAC+6, 'Comisiones Hasta : '~Dialogo.Fecha2)
ACT(i:FAC+6, 'Comisiones Vigentes al: '~Dialogo.Fecha3)

SetFont(a:fac..l:FAC+7,2)

SetFilaActual(FAC+8)

ACN(z11, FAC+1)
ACT(a:FAC,'Numero Op')
ACT(b:FAC,'Tipo Op.')
ACT(c:FAC,'Cliente')
ACT(d:FAC,'Fecha Origen')
ACT(e:FAC,'Fecha Vto.')
ACT(f:FAC,'Pago Comis.')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio1=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(g:FAC,'Tipo')
ACT(h:FAC,'Plazo')
ACT(i:FAC,'Importe')
ACT(j:FAC,'Imp. dev. Acum.')
ACT(k:FAC,'Imp. a devengar')
ACT(l:FAC,'Imp. dev. del mes')

AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(i:FAC..l:FAC,'C')
SetFont(a:fac..l:FAC,2)
AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR'))

act(t1,'')
act(t2,'')
act(t3,'')
BorrarCeldas(w11..w14)
BorrarCeldas(w21..w24)
BorrarCeldas(w31..w34)
BorrarCeldas(w91..w94)

SetFilaActual(13)
ACT(PM1,Dialogo.Lista2)

if NoVacio(Val(PM1))
   *- Obtengo los numeros corresp. a los distintos tipos de comisiones
   ACT(zz1,'FPD|FFC|CDO|CPI|CF|EF')
   ACN(zz2,Elementos(Val(PM1)) )
   ACT(zz5,'')
   Recorrer&i 1,Val(zz2)
     ** recupero el texto del item
     ACT(zz3,ItemLista(Val(PM1),&i) )
     ** recupero la posicion en la Lista Original del item
     ACN(zz4, BuscarLista(Val(zz3),Val(zz1)) )
     ACT(zz5, Val(zz5)~IIF(EqStr(Val(zz5),''),"'",",'")~FStr(Val(zz4)-1,0,0)~"'" )
   Proximo
endif

SQL.ADD(" select * from "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
   SQL.ADD(" WHERE O.NrOperacion=C.NrOperacion ")
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1='"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and C.Especie1='"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD(" and O.FechaOp <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Fecha1 >='"~IdxDate(Dialogo.Fecha1)~"' ")
If Dialogo.Radio2=0
   SQL.ADD(" and O.TipoOp In ('MMPSC','MMPSI','MMSCMV','MMSIMV','MMCCR','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMFCMV','MMFRN','MMP') ")
else
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
*- Por cada operacion recupero las comisiones 
   if NoVacio(Val(PM1))
        SQL.ADD("       and C.Tipo in ("~Val(zz5)~") ")
   endif
SQL.ADD(" ORDER BY C.Especie1,O.Vehiculo1,O.Cliente1,C.Tipo,O.FechaOp,O.FechaVto,C.Fecha1,C.NrOperacion")

Recorrer SQL   
if Eqstr(Val(t1),'') y eqstr(Val(t2),'') y eqstr(Val(t3),'')
   act(t1, fbn('Vehiculo1'))
   act(t2, fbn('TipoOp'))
   act(t3, fbn('Cliente1'))
   act(a:fac,fbn('Vehiculo1'))
   AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
   SetFont(a:fac..l:fac,2)
   ifa
else
*-- Preparo corte de control
  if Not Eqstr(fbn('Vehiculo1'),Val(t1)) y NoVacio(Val(t1))
     act(a:fac,'Total Bco. '~Val(t3))
     acn(i:fac, Val(w31))
     acn(j:fac, Val(w32))
     acn(k:fac, Val(w33))
     acn(l:fac, Val(w34))
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Bco. '~Val(t3)~' en '~Val(mo1) )
     acn(i:fac, Val(w31)*Val(az1))
     acn(j:fac, Val(w32)*Val(az1))
     acn(k:fac, Val(w33)*Val(az1))
     acn(l:fac, Val(w34)*Val(az1))
     BorrarCeldas(w31..w34)
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2))
     acn(i:fac, Val(w21))
     acn(j:fac, Val(w22))
     acn(k:fac, Val(w23))
     acn(l:fac, Val(w24))  
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa  
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
     acn(i:fac, Val(w21)*Val(az1))
     acn(j:fac, Val(w22)*Val(az1))
     acn(k:fac, Val(w23)*Val(az1))
     acn(l:fac, Val(w24)*Val(az1))
     BorrarCeldas(w21..w24)
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1))
     acn(i:fac, Val(w11))
     acn(j:fac, Val(w12))
     acn(k:fac, Val(w13))
     acn(l:fac, Val(w14))
     AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1))
     acn(i:fac, Val(w11)*Val(az1))
     acn(j:fac, Val(w12)*Val(az1))
     acn(k:fac, Val(w13)*Val(az1))
     acn(l:fac, Val(w14)*Val(az1)) 

     SCN(w91, Val(w11))
     SCN(w92, Val(w12))
     SCN(w93, Val(w13))
     SCN(w94, Val(w14))
     
     BorrarCeldas(w11..w14)
     AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..l:fac,2)
     ifa
     act(t1, fbn('Vehiculo1'))
     act(t2, fbn('TipoOp'))
     act(t3, fbn('Cliente1'))
     ifa
     act(a:fac,fbn('Vehiculo1'))
     AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..l:fac,2)
     ifa
  Else 
   If [Not Eqstr(fbn['TipoOp'],Val(t2))] y NoVacio(Val(t2))
        * Cambia El Tipo de Operacion
        act(a:fac,'Total Bco. '~Val(t3))
        acn(i:fac, Val(w31))
        acn(j:fac, Val(w32))
        acn(k:fac, Val(w33))
        acn(l:fac, Val(w34))
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa
        act(a:fac,'Total Bco. '~Val(t3)~' en '~Val(mo1) )
        acn(i:fac, Val(w31)*Val(az1))
        acn(j:fac, Val(w32)*Val(az1))
        acn(k:fac, Val(w33)*Val(az1))
        acn(l:fac, Val(w34)*Val(az1))
        BorrarCeldas(w31..w34)
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa
        act(a:fac,'Total Op.'~Val(t2))
        acn(i:fac, Val(w21))
        acn(j:fac, Val(w22))
        acn(k:fac, Val(w23))
        acn(l:fac, Val(w24))
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa
        act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
        acn(i:fac, Val(w21)*Val(az1))
        acn(j:fac, Val(w22)*Val(az1))
        acn(k:fac, Val(w23)*Val(az1))
        acn(l:fac, Val(w24)*Val(az1))
        BorrarCeldas(w21..w24)
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa
        * Asignar Tipo Operacion
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Cliente1'))
  Else
   If [Not Eqstr(fbn['Cliente1'],Val(t3))] y NoVacio(Val(t3))
*-- Cambia el Cliente1(Bco.)
        act(a:fac,'Total Bco. '~Val(t3))
        acn(i:fac, Val(w31))
        acn(j:fac, Val(w32))
        acn(k:fac, Val(w33))
        acn(l:fac, Val(w34))
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa      
        act(a:fac,'Total Bco. '~Val(t3)~' en '~Val(mo1) )
        acn(i:fac, Val(w31)*Val(az1))
        acn(j:fac, Val(w32)*Val(az1))
        acn(k:fac, Val(w33)*Val(az1))
        acn(l:fac, Val(w34)*Val(az1))
        BorrarCeldas(w31..w34)
        AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..l:fac,2)
        ifa
      * Asignar Especie
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Cliente1'))
   EndIf
  EndIf
 Endif
Endif
      *-- A: NrOperacion 
      *-- B: TipoOP
      *-- C: Cliente
      *-- D: Fecha Origen
      *-- E: Fecha Vto.
      *-- F: Pago Comision    
      *-- G: Tipo de Comision    
      *-- H: Plazo    
      ACT(a:fac,FBN['NrOperacion'])
      ACLO(a:fac,FBN['NrOperacion'])
      ACT(b:fac,FBN['TipoOp'])
      ACT(c:fac,FBN['Cliente1'])
      ACT(d:fac,FBN['FechaOp'])
      ACT(e:fac,FBN['FechaVto'])
      ACT(f:fac,FBN['Fecha1'])
*--- recupero el texto de la comisión según su Tipo
      ACT(zz1,'FPD|FFC|CDO|CPI|CF|EF')
      ACN(zz7,(FBN['Tipo']+1))
      ACT(zz8,ItemLista(Val(zz1),val(zz7)))
      ACT(g:fac,Val(zz8))
      ACT(h:fac,FBN['Plazo'])
 
      *-- i: 'Importe'
      *-- j: 'Importe deveng. Acumulado'
      *-- k: 'Importe a devengar'
      *-- l: 'Importe deveng. del mes'
      *-- Obtengo el calculo de los importes
*-- Importe
ACN(i:fac,FBN['Importe1'])
SCN(w11,val(i:fac))
SCN(w21,val(i:fac))
SCN(w31,val(i:fac))
*-- Importe devengado acumulado
IF FBN['FechaOp'] <= Dialogo.Fecha3
IF FBN['FechaVto'] > Dialogo.Fecha3
   IF FBN['Tipo']<=5
      ACN(j:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],Dialogo.Fecha3,,NO)+1)/FBN['Plazo']))
   endif
ELSE
   IF FBN['Tipo']<=5
      ACN(j:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],FBN['FechaVto'],,NO))/FBN['Plazo']))
   endif
ENDIF
ENDIF
SCN(w12,val(j:fac))
SCN(w22,val(j:fac))
SCN(w32,val(j:fac))

*-- Importe a devengar
ACN(k:fac, Val(i:fac)-Val(j:fac))
SCN(w13,val(k:fac))
SCN(w23,val(k:fac))
SCN(w33,val(k:fac))

*-- Importe devengado del mes
IF FBN['FechaOp'] <= Dialogo.Fecha3
IF FBN['FechaVto'] > Dialogo.Fecha3
   IF FBN['Tipo']<=5
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha3,SI)
         ACN(l:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],Dialogo.Fecha3,,NO)+1)/FBN['Plazo'])) 
      else   
         ACN(l:fac,(FBN['Importe1']*(DIFDIAS(PriDeMes(Dialogo.Fecha3,SI),Dialogo.Fecha3,,NO)+1)/FBN['Plazo']))
      endif
   endif
ELSE
   IF FBN['Tipo']<=5
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha3,SI)
         ACN(l:fac,(FBN['Importe1']*(DIFDIAS(FBN['FechaOp'],FBN['FechaVto'],,NO))/FBN['Plazo'])) 
      else   
         ACN(l:fac,(FBN['Importe1']*(DIFDIAS(PriDeMes(Dialogo.Fecha3,SI),FBN['FechaVto'],,NO))/FBN['Plazo']))
      endif
   endif
ENDIF
ENDIF

SCN(w14,val(l:fac))
SCN(w24,val(l:fac))
SCN(w34,val(l:fac))
SetFont(a:fac..l:fac,1)

SCN(fi1,1)
Proximo
*-- Veo si hay algo para listar
if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
*-- Listo ultimo total
     ifa
     act(a:fac,'Total Bco. '~Val(t3))
     acn(i:fac, Val(w31))
     acn(j:fac, Val(w32))
     acn(k:fac, Val(w33))
     acn(l:fac, Val(w34))
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Bco. '~Val(t3)~' en '~Val(mo1) )
     acn(i:fac, Val(w31)*Val(az1))
     acn(j:fac, Val(w32)*Val(az1))
     acn(k:fac, Val(w33)*Val(az1))
     acn(l:fac, Val(w34)*Val(az1))
     BorrarCeldas(w31..w34)
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2))
     acn(i:fac, Val(w21))
     acn(j:fac, Val(w22))
     acn(k:fac, Val(w23))
     acn(l:fac, Val(w24))
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
     acn(i:fac, Val(w21)*Val(az1))
     acn(j:fac, Val(w22)*Val(az1))
     acn(k:fac, Val(w23)*Val(az1))
     acn(l:fac, Val(w24)*Val(az1))
     BorrarCeldas(w21..w24)
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1))
     acn(i:fac, Val(w11))
     acn(j:fac, Val(w12))
     acn(k:fac, Val(w13))
     acn(l:fac, Val(w14))
     AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..l:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1))
     acn(i:fac, Val(w11)*Val(az1))
     acn(j:fac, Val(w12)*Val(az1))
     acn(k:fac, Val(w13)*Val(az1))
     acn(l:fac, Val(w14)*Val(az1))

     SCN(w91, Val(w11))
     SCN(w92, Val(w12))
     SCN(w93, Val(w13))
     SCN(w94, Val(w14))
     
     BorrarCeldas(w11..w14)
     AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..l:fac,2)
     ifa
     ifa
     act(a:fac,'Total General')
     acn(i:fac, Val(w91))
     acn(j:fac, Val(w92))
     acn(k:fac, Val(w93))
     acn(l:fac, Val(w94))
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,3)
     ifa
     act(a:fac,'Total General')
     acn(i:fac, Val(w91)*Val(az1))
     acn(j:fac, Val(w92)*Val(az1))
     acn(k:fac, Val(w93)*Val(az1))
     acn(l:fac, Val(w94)*Val(az1))

     BorrarCeldas(w91..w94)
     AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..l:fac,3)

FormatoCeldas(e:val(z11)..e:fac,"0")
FormatoCeldas(f:val(z11)..l:fac,Exe('F2'))

ACO(1,8)
ACO(2,8)
ACO(3,15)
ACO(4,8)
ACO(5,8)
ACO(6,7)
ACO(7,3)
ACO(8,3)
ACO(9,12)
ACO(10,10)
ACO(11,10)
ACO(12,10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(l:FAC)
*
*    Esto es lo que agrega Silvia
*
RangoTitulo(a:1..l:FAC, Val(w1))
Endif

