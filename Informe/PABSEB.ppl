ModoReproceso(SinDialogo)

CrearDialogo

  Fecha1   : 'Fecha'    ;;;;;;;;;Fsys;
  Vehiculo1: 'Vehiculo' ;;;;;;;;;;;;;;
  Cliente1 : 'Cliente'  ;;;;;;;;;;;;;;
  Especie1 : 'Especie'  ;;;;;;;;;;;;;;
  
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,'Arial,14,B' )
CrearFont(2,'Arial,12,B' )
CrearFont(3,'Arial,10,' )
CrearFont(4,'Arial,10,B' )

SetFilaActual(3)
ACT(c:fac, 'Informe de Operaciones')
SetFont(c:fac..c:fac, 1)

SetFilaActual(5)
ACT(a:fac, 'Fecha: '~IIf(NoVacio(Dialogo.Fecha1),Dialogo.Fecha1,'Todas'))
ACT(a:fac+1, 'Vehiculo: '~IIf(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
SetFont(a:fac..a:fac+1, 2)

SetFilaActual(9)
ACT(a:fac, 'Especie')
ACT(b:fac, 'TipoOp')
ACT(c:fac, 'NrOperacion')
ACT(d:fac, 'Cantidad')
ACT(e:fac, 'Precio')
ACT(f:fac, 'Cliente')
ACT(g:fac, 'Fecha')
ACT(h:fac, 'Vehiculo')
SetFont(a:fac..h:fac, 2)
AgregarMarco(a:fac..h:fac,2,0,Exe('COLOR'))

ACN(fi:1, fac+1)

SQL.ADD(" Select Especie, TipoOp, NrOperacion, Cantidad, Precio1, Cliente1, FechaOp, Vehiculo1 ")  
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and Vehiculo1='"~Dialogo.Vehiculo1~"'  ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and Cliente1='"~Dialogo.Cliente1~"'  ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and Especie='"~Dialogo.Especie1~"'  ")
Endif
SQL.ADD(" Order By Vehiculo1, Especie ")
Recorrer SQL
