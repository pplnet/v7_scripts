*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1       : 'Fecha'     ;1;1;;;;Dialogo.Fecha1<=FSYS y EsHabil(Dialogo.Fecha1,'ARG');'Fecha de Valuacion Incorrecta';NO;FSys
  NrOperacion1 : 'Operacion' ;2;1;;;;NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMCPM|MMCCR');'Debe indicar una Operacion tipo MMCPM o MMCCR';NO; 
  Radio2       : 'Expresado|Pesos|Dolares' ;3;1;;;;;;;0
  Radio3       : 'Llamo|R.Car.|R.Pos'      ;4;1;;;;;;;0
FinDialogo
If not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACD(fe:1, Dialogo.Fecha1)
ACT(ak:0, 'AK')
ACT(at:0, 'AT')
ACT(fd:0, 'FD')

ACT(ay:1, 'TipoOp')
ACT(ay:2, 'Operacion')
ACT(ay:3, 'Curva')
ACT(ay:4, 'Curva')
ACT(ay:5, 'Max Fecha')
ACT(ay:6, 'Linea OP')
ACT(ay:7, 'Cant Lineas')
ACT(ay:8, 'Plazo 1')
ACT(ay:9, 'Plazo Tot')
ACT(ay:10, 'Plazo Hasta')
ACT(ay:11, 'Divisor')
ACT(ay:12, 'Exp.En')
if Dialogo.Radio2=0
  ACT(az:12, 'ARP')
else
  ACT(az:12, 'USD')
endif
ACT(ay:13, 'TC USD')

ACN(ar:4, 0)
ACN(ar:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
if Val(ar:4)=0
  ACN(ar:5, 1)
else
  ACN(ar:5, VAR('MESINIEJE'))
endif
if Val(ar:5)<1 or Val(ar:5)>12
  ACN(ar:5, 1)
endif
if Mes(Dialogo.Fecha1)>=Val(ar:5)
  ACT(ar:6, '01/'~Pad0(FStr(Val(ar:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1),4,0))
else
  ACT(ar:6, '01/'~Pad0(FStr(Val(ar:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1)-1,4,0))
endif
ACD(ar:7, Fecha(Val(ar:6)))

SetFilaActual(1)
ACT(a:1,'Informe de VALUACIONES Time Deposit para Reporte Cartera')
SetFont(a:1,3)

ACT(a:3, 'Operacion: ')
ACT(c:3, Dialogo.NrOperacion1)
ACT(a:4, 'Expresado en:')
ACT(c:4, IIF(Dialogo.Radio2=0,'Pesos','Dolares') )
ACT(a:5, 'Cot.USD:')
ACN(c:5, Cotizacion('USD',,,,Dialogo.Fecha1-1,1,SI))
ACT(a:6, 'Llado por:')
ACT(c:6, IIF(Dialogo.Radio3=0,'Reporte de Cartera','Reporte de Posicion') )
ACT(a:7, 'Fecha Proceso:')
ACD(c:7, FSys)

SetFont(a:3..c:7,2)
FormatoCeldas(c:5,Exe('F8'))
SetFilaActual(9)

ACT(a:FAC  , 'Vehiculo')
ACT(b:FAC  , 'Tipo')
ACT(b:FAC+1, 'Operacion')
ACT(c:FAC  , 'Especie')

ACT(d:FAC  , 'Monto')
ACT(d:FAC+1, 'Inicial')

ACT(e:FAC  , 'Entidad')

ACT(f:FAC  , 'Tipo')
ACT(f:FAC+1, 'Tasa/Contrato')

ACT(g:FAC  , 'NrOperacion')

ACT(h:FAC  , 'Criterio')
ACT(h:FAC+1, 'Valuac. ')

ACT(i:FAC  , 'Tasa/Precio')

ACT(j:FAC  , 'Pl_Rem Pr/  ')
ACT(j:FAC+1, 'Precio Merc')

ACT(k:FAC  , 'Net_Market')
ACT(k:FAC+1, 'Value')

ACT(l:FAC  , 'P&L  ')
ACT(l:FAC+1, 'A Realizar')

ACT(m:FAC  , 'P&L  ')
ACT(m:FAC+1, 'Realizado ')

ACT(n:FAC  , '               Flujo de Fondos  ')
ACT(n:FAC+1, 'Interes  ')
ACT(o:FAC+1, 'Capital ')

ACT(p:FAC  , '               Valores Actuales   ')
ACT(p:FAC+1, 'Interes  ')
ACT(q:FAC+1, 'Capital ')

ACT(r:FAC  , 'V. Actual')
ACT(r:FAC+1, 'Total')

ACT(s:FAC  , 'Tasas')

ACT(t:FAC  , 'FD(t,j)')
ACT(t:FAC+1, 'VtoSett')

ACT(u:FAC  , 'Vto')
ACT(u:FAC+1, 'Sett')

ACT(v:FAC  , 'Pl_Rem  ')
ACT(v:FAC+1, 'Periodo ')

AgregarMarco(a:fac..m:fac+1,2,2,Exe('COLOR6') )
AgregarMarco(n:fac..o:fac+1,2,0,Exe('COLOR6') )
AgregarMarco(p:fac..q:fac+1,2,0,Exe('COLOR6') )
AgregarMarco(r:fac..v:fac+1,2,2,Exe('COLOR6') )

SetFont(a:fac..v:FAC+1,2)
AlinearCeldas(a:fac..n:fac+1, 'C')
AlinearCeldas(n:fac..p:fac+1, 'I')

SetFilaActual(fac+1)
ACT(az:2,'')

SQL.ADD("Select 1 as Orden,                      O.NrOperacion,                 O.Cantidad as CapIni, O.FechaOp as FechaIni, ")
SQL.ADD("       O.FechaVto as VtoFinal,          O.Cliente1,                    O.Vehiculo1,          O.Especie, ")
SQL.ADD("       C.Fecha2 FechaVto,               C.Fecha1 FechaOp,              O.TipoOp,             C.Cantidad1 Importe, ")
SQL.ADD("       C.Cantidad1+C.Total3 ImporteVto, C.Cantidad2 Cantidad, ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMPCCM' THEN C.Precio4 ELSE O.Spread END Spread, ")
SQL.ADD("       C.Precio2 Tasa, ")
SQL.ADD("       O.RB8, ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMPCCM' THEN  0 ELSE C.Plazo1 END Plazo, ")
SQL.ADD("       O.TipoTasa,                      C.Tasa1 PorAmor, ")
SQL.ADD("       O.PrecioRef,                     C.Cantidad3 as TotalIntereses, O.Plazo AS PlazoTot ")
SQL.ADD("  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.NrOperacion =  C.NrOperacion ")
SQL.ADD("   and O.Cliente1    =  CL.Codigo ")
SQL.ADD("   and TT.Codigo     =  O.TipoTasa ")
SQL.ADD("   and O.PrecioRef   Is Not Null ")
SQL.ADD("   and O.FechaOp     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and C.Fecha2      >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.TipoOp      In ('MMCPM') ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and  O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

SQL.ADD(" UNION ALL ")

SQL.ADD("Select 1 as Orden,             O.NrOperacion,    O.Cantidad as CapIni, O.FechaOp as FechaIni, ")
SQL.ADD("       O.FechaVto as VtoFinal, O.Cliente1,       O.Vehiculo1,          O.Especie, ")
SQL.ADD("       O.FechaVto,             O.FechaOp,        O.TipoOp,             O.Cantidad Importe, ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMCP  ' THEN O.TotalNetoCli1 WHEN 'MMD   ' THEN O.Cantidad WHEN 'MMDCA ' THEN O.Cantidad+O.TotalNetoCli2 ELSE O.TotalBrutoCli1 END ImporteVto,  ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMD   ' THEN 0 ELSE O.Cantidad END Cantidad , ")
SQL.ADD("       O.Spread,               O.Precio1 Tasa, ")
SQL.ADD("       O.RB8,                  O.Plazo,          O.TipoTasa,           100 as PorAmor, ")
SQL.ADD("       O.PrecioRef,            O.TotalIntereses, O.Plazo AS PlazoTot ")
SQL.ADD("  from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT ")
SQL.ADD(" where O.Cliente1  =  CL.Codigo ")
SQL.ADD("   and TT.Codigo   =  O.TipoTasa ")
SQL.ADD("   and O.PrecioRef Is Not Null ")
SQL.ADD("   and O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.TipoOp    In ('MMCCR') ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" and  O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

SQL.ADD("ORDER BY 7,1,2,8,9")
* Vehiculo, Orden, Operacion, Especie, FechaVto
Recorrer SQL
  Message(FBN['NrOperacion']~FBN['PrecioRef']~Fstr(val(az:11),0,0))
  If Not EqSTr(FBN['PrecioRef'],val(gr:1)) 
    *- Cambio de Tipo de Tasa
    ACT(az:3, FBN['PrecioRef']) 
    ACT(az:4, Trim(Mirt(Val(az:3))))
    ACD(fe:1, Dialogo.Fecha1)
    ACD(az:5, Dialogo.Fecha1)
    SQL.ADD("Select Max(TD1.Fecha) AS Max ")
    SQL.ADD("  from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 ")
    SQL.ADD(" Where TD1.TipoTasa  = TT1.Codigo ")
    SQL.ADD("   and TT1.PrecioRef = '"~Val(az:4)~"' ")
    SQL.ADD("   AND TD1.Fecha    <= '"~IdxDate(val(fe:1))~"' ")
    Recorrer SQL
      DFA
      ACD(az:5, FBN['Max'])
    Proximo
  EndIf

  *- Cambia de operacion, sumarizo el valor actual total y traslado a net market value 
  IF Not EqStr(FBN['NrOperacion'],val(az:2)) y NoVacio(val(az:2)) 
    If  Not Incluido(val(h:val(az:6)),'Devengado|MToMarket')
      ACN(n:fac,       Sum(n:val(az:6)..n:fac-1))
      ACN(o:fac,       Sum(o:val(az:6)..o:fac-1))
      ACN(p:fac,       Sum(p:val(az:6)..p:fac-1))
      ACN(q:fac,       Sum(q:val(az:6)..q:fac-1))
      ACN(r:fac,       Sum(r:val(az:6)..r:fac-1))
      ACN(k:val(az:6), val(r:fac))
      ACN(v:fac,       Sum(v:val(az:6)..v:fac-1))
      *l: Pl a Realizar  => Time Deposit= Net market Value (k) - Monto Residual => Prestamos=Monto Residual - Net Market Value 
      ACN(l:val(az:6), val(k:val(az:6)) - val(ak:val(az:6)) )
    EndIf
    SetFont(a:val(az:6)..at:val(az:6),1)
    SetFont(a:fac..v:fac,1)
    FormatoCeldas(v:fac..v:fac, Exe('F0'))
    ifa 
  EndIf

  IF Not EqStr(FBN['NrOperacion'],val(az:2))
    ACN(az:11,0)
    If fbn('RB8')=1
      ACN(az:11,1)
    EndIf
    ACT(az:2,FBN['NrOperacion']) 
    ACT(az:1,FBN['TipoOp']) 
    ACT(a:FAC  , BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Vehiculo1']))
    ACT(b:FAC  , FBN['TipoOp'])
    ACT(c:FAC  , FBN['Especie'])
    ACN(d:FAC  , FBN['CapIni'])
    if Dialogo.Radio3=0
      ACN(ai:FAC , CotizacionC(Val(c:FAC),,,,Dialogo.Fecha1-1,1,SI,Val(az:12)))
    else
      ACN(ai:FAC , 1)
    endif
    *-- ak: Valor Residua
    ACN(aj:FAC , FBN['Cantidad'])
    ACN(ak:FAC , FBN['Cantidad']*Val(ai:FAC))
    ACT(e:FAC  , FBN['Cliente1'])
    ACT(f:FAC  , FBN['TipoTasa'])
    ACT(h:FAC  , 'MToModel')
    ACN(i:FAC  , FBN['Tasa']+FBN['Spread'])
    ACN(j:fac  , FBN['VtoFinal']-FBN['FechaIni'])
    ACT(g:FAC, FBN['NrOperacion'])
    ACLO(g:FAC, FBN['NrOperacion'])
    *- az:7: Contador de Flujos
    ACN(az:7,0)
    ACN(az:6,fac)
    ACN(m:FAC  , 0)
    * az:8 = Plazo / z:9 = PlazoTot
    ACN(az:8, FBN['Plazo'])
    ACN(az:9, FBN['PlazoTot'])
    *- Obtengo el resultado realizado que es el interes de los periodos pasados
    SQL.ADD("SELECT Cantidad3 as Interes, Fecha1, Fecha2 ")
    SQL.ADD("  FROM "~DBO~".CUOTAS ")
    SQL.ADD(" WHERE NrOperacion =  '"~val(g:fac)~"' ")
    SQL.ADD("   and Fecha1      <  '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   and Fecha2      <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("   and Fecha2      >= '"~IdxDate(Val(ar:7))~"' ")
    Recorrer SQL
      dfa
      SCN(ba:1, 1)
      ACN(bb:Val(ba:1), FBN['Interes'])
      ACD(bc:Val(ba:1), FBN['Fecha1'])
      ACD(bd:Val(ba:1), FBN['Fecha2'])
      if Dialogo.Radio3=0
        ACN(be:Val(ba:1), CotizacionC(Val(c:FAC),,,,FBN['Fecha2']-1,1,SI,Val(az:12)))
      else
        ACN(be:Val(ba:1) , 1)
      endif
      ACN(bf:Val(ba:1), Val(bb:Val(ba:1))*Val(be:Val(ba:1)))
      SCN(m:FAC  , Val(bf:Val(ba:1)))
    Proximo
  EndIf

  ACN(az:8, FBN['Plazo'])
  If EqStr(val(h:val(az:6)),'MToModel') 
    SCN(az:7,1)
    ACD(u:FAC, FBN['FechaVto'])
    ACN(v:FAC, FBN['PorAmor']*(FBN['VtoFinal']-Dialogo.Fecha1)/100)
    ACD(fe:2,  FBN['FechaVto'])
    ACN(fe:3,  (val(fe:2)-val(fe:1)) / 365 * 360)
    ACN(az:10,  0)
    ACN(fd:1,  0)
    ACN(fd:2,  0)
    SQL.ADD("Select TD.*,TT.DayCount ")
    SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
    SQL.ADD(" Where TD.TipoTasa   = TT.Codigo ")
    SQL.ADD("   and TT.PrecioRef  = '"~Val(az:4)~"' ")
    SQL.ADD("   and TD.Fecha      = '"~IdxDate(Val(az:5))~"' ")
    SQL.ADD("   and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
    SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
    SQL.ADD("                         Where TD.TipoTasa  = TT.Codigo ")
    SQL.ADD("                           and TT.PrecioRef = '"~Val(az:4)~"' ")
    SQL.ADD("                           and TD.Fecha     = '"~IdxDate(Val(az:5))~"' ")
    SQL.ADD("                           and PlazoHasta  >= "~Fstr(val(fe:3),0,0)~" ")
    SQL.ADD("                       ) ")
    SQL.ADD("Union All ")
    SQL.ADD("Select TD.*,TT.DayCount ")
    SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
    SQL.ADD(" Where TD.TipoTasa   = TT.Codigo  ")
    SQL.ADD("   and TT.PrecioRef  = '"~Val(az:4)~"' ")
    SQL.ADD("   and TD.Fecha      = '"~IdxDate(Val(az:5))~"'  ")
    SQL.ADD("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
    SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
    SQL.ADD("                         Where TD.TipoTasa  = TT.Codigo ")
    SQL.ADD("                           and TT.PrecioRef = '"~Val(az:4)~"' ")
    SQL.ADD("                           and TD.Fecha     = '"~IdxDate(Val(az:5))~"' ")
    SQL.ADD("                           and PlazoHasta   < "~Fstr(val(fe:3),0,0)~" ")
    SQL.ADD("                       ) ")
    SQL.ADD("ORDER BY TD.PlazoHasta  ")
    Recorrer SQL
      dfa
      IF val(az:10)<=val(fe:3) y val(fe:3)<=FBN['PlazoHasta']
        * Este es el plazo a interpolar  
        ACN(fd:3, val(fd:1)/FBN['Valor4'] -1 )
        ACN(fd:4, (val(fd:3)/(FBN['Valor3']-val(fd:2)))*100 )
        ACN(fd:5, (FBN['Valor3']-(val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd:2))*val(fd:1)+((val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd:2))/(FBN['Valor3']-val(fd:2))*FBN['Valor4']) 
      EndIf
      ACN(az:10, FBN['PlazoHasta'])
      ACN(fd:1, FBN['Valor4'])
      ACN(fd:2, FBN['Valor3'])
    Proximo
    ACN(t:fac,val(fd:5)) 
    If EqSTr(FBN['PrecioRef'],'FIJA')
      ACN(t:fac, 1)
    EndIf
    *-- Para calcular la columna n: de Intereses si el tipotasa es variable se usa esta tasa y se recuperan los flujos de fondos
    If Not EqStr(FBN['TipoTasa'],'FIJA')      
      * Devuelve en at: los fd de la tasa de la operacion
      (.'FDTIPOTASA'.)
    ELSE
      ACN(at:fac, val(t:fac))
    EndIf
  EndIf

  If EqStr(val(h:val(az:6)),'MToModel') y Not EqSTr(FBN['PrecioRef'],'FIJA') y [Incluido(FBN['TipoOp'],'MMCP|MMCPM|MMCCR')]
    ACT(as:FAC, '1')
    *- Como estoy a tasa variable, la unica tasa conocida es la del primer periodo para calcular el flujo de fondos de interes de la columna n
    If val(az:7)=1 o EqStr(FBN['TipoTasa'],'FIJA')
      ACN(s:fac,((1/val(t:fac))-1))
      *- Formulas para primer flujo o de los flujos a tasa fija => tasa conocida TasaPactada*Cant. dias transcurridos desde el inicio del sett/plazo del settlemente*capital vigente datos ingresados al sistema'!C5*22/90*'datos ingresados al sistema'!C3
      ACN(n:fac,(FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*val(az:8)/(IIF(val(az:11)=0,36000,36500)) )    
    Else 
      ACN(s:fac,(val(t:fac-1)/val(t:fac))-1)
      ACN(n:fac,FBN['Cantidad']*(( (val(at:fac)/val(at:fac-1))^-1) -1) )
      SCN(n:fac,(FBN['Spread'])*FBN['Cantidad']*val(az:8)/(IIF(val(az:11)=0,36000,36500)) )    
    EndIf
    ACN(n:fac, Val(n:FAC)*Val(ai:Val(az:6)))
    ACN(o:fac, FBN['Importe']*Val(ai:Val(az:6)))
    ACN(p:fac, val(n:fac)*val(t:fac))
    ACN(q:fac, val(o:fac)*val(t:fac))
    ACN(r:fac, val(p:fac)+val(q:fac))
    ACN(s:fac, (val(s:fac)/(val(az:8)/IIF(val(az:11)=0,360,365) ))*100 )  
  EndIf

  If EqStr(val(h:val(az:6)),'MToModel') y EqSTr(FBN['PrecioRef'],'FIJA')  y Incluido(FBN['TipoOp'],'MMCPM') y val(az:9)<=365
    ACT(as:FAC, '2')
    *- Como estoy a tasa Fija, todas las tasas son conocidas para calcular el flujo de fondos de interes de la columna n
    ACN(n:fac, (FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*val(az:8)/(IIF(val(az:11)=0,36000,36500)) )    
    ACN(n:fac, Val(n:FAC)*Val(ai:Val(az:6)))
    ACN(o:fac, FBN['Importe']*Val(ai:Val(az:6)))
    ACN(p:fac, val(n:fac)*val(t:fac))
    ACN(q:fac, val(o:fac)*val(t:fac))
    ACN(r:fac, val(p:fac)+val(q:fac))
    If val(az:7)>1
      ACN(s:fac, (val(t:fac-1)/val(t:fac))-1)
    Else
      ACN(s:fac, ((1/val(t:fac))-1))
    EndIf
    ACN(s:fac,(val(s:fac)/(val(az:8)/IIF(val(az:11)=0,360,365) ))*100  )  
  EndIf

  If EqStr(val(h:val(az:6)),'MToModel') y EqSTr(FBN['PrecioRef'],'FIJA') y EqSTr(FBN['TipoTasa'],'FIJA') y Incluido(FBN['TipoOp'],'MMCCR') y val(az:9)<=365
    ACT(as:FAC, '3')
    *- Como estoy a tasa Fija, todas las tasas son conocidas para calcular el flujo de fondos de interes de la columna n
    ACN(n:fac, (FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*val(az:8)/(IIF(val(az:11)=0,36000,36500)) )    
    ACN(n:fac, Val(n:FAC)*Val(ai:Val(az:6)))
    ACN(o:fac, FBN['Importe']*Val(ai:Val(az:6)))
    ACN(p:fac, val(n:fac)*val(t:fac))
    ACN(q:fac, val(o:fac)*val(t:fac))
    ACN(r:fac, val(p:fac)+val(q:fac))
    If Val(az:7)>1
      ACN(s:fac,(val(t:fac-1)/val(t:fac))-1)
    Else
      ACN(s:fac,((1/val(t:fac))-1))
    EndIf 
    ACN(s:fac,(val(s:fac)/(val(az:8)/IIF(val(az:11)=0,360,365) ))*100  )
  EndIf
  FormatoCeldas(j:val(az:6)..j:val(az:6), Exe('F0'))

  SetFont(a:fac..at:fac,1)
  FormatoCeldas(t:fac..t:fac, Exe('F8'))
  FormatoCeldas(s:fac..s:fac, Exe('F8'))
  FormatoCeldas(v:fac..v:fac, Exe('F0'))
Proximo
Ifa
If Not Incluido(val(h:val(az:6)),'Devengado|MToMarket')
  ACN(n:fac,       Sum(n:val(az:6)..n:fac-1))
  ACN(o:fac,       Sum(o:val(az:6)..o:fac-1))
  ACN(p:fac,       Sum(p:val(az:6)..p:fac-1))
  ACN(q:fac,       Sum(q:val(az:6)..q:fac-1))
  ACN(r:fac,       Sum(r:val(az:6)..r:fac-1))
  ACN(k:val(az:6), val(r:fac))
  ACN(v:fac,       Sum(v:val(az:6)..v:fac-1))
  *l: Pl a Realizar  => Time Deposit= Net market Value (k) - Monto Residual => Prestamos=Monto Residual - Net Market Value 
  ACN(l:val(az:6), val(k:val(az:6)) - val(ak:val(az:6)) )
EndIf

FormatoCeldas(v:fac..v:fac, Exe('F0'))

SetFont(a:val(az:6)..at:val(az:6),1)
FormatoCeldas(r:fac..r:fac, Exe('F2'))
SetFont(a:fac..v:fac,1)

SetFont(ar:1..ar:7,1)
SetFont(ay:1..az:15,1)
