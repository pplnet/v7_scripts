  ACT(g:fac, &CuentaMercado)
  ACT(g:fac+1, &CuentaMercado)
  ACT(g:fac+2, &CuentaMercado)
  ACT(g:fac+3, &CuentaMercado)
  if Incluido(fbn('TipoOp'),'DDC')
 
    ACT(a:fac, '131.718.xxx ')
    ACT(b:fac, 'Documentos descontados')
