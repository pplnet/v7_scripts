CrearDialogo
  Fecha1 : 'Fecha'     ;1;1;;;;;;;Fsys
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'  
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Contabilidad de cheques Cartera Propia')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)

ACT(a4, "Concertacion")
 
ACT(a5,'Rubro')
ACT(b5,'Descripcion')
ACT(c5,'Debito')
ACT(d5,'Credito')
ACT(e5,'Moneda')
ACT(f5,'Sucursal')
ACT(g5,'Cuenta')
ACT(h5,'Boleto')
ACT(i5,'Operacion')
ACT(j5,'Nr.Cheque')

CrearFont(2, "Arial,8,B")
SetFont(a1..j5, 2)
AgregarMarco(a4..j5,1,0,Exe('COLOR2'))

SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and Especie='"~Dialogo.Especie1~"' and Cliente1='BIND' and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' order by TipoOp")

let &Especie '80'
* esto cambia si se operan documentos emitidos en otras monedas, no es lo que opera BIND en esta etapa

let &CuentaMercado Var('CTAMDOCHQ') 

SetFilaActual(5)
recorrer SQL
  ACN(c:fac, fbn('Cantidad'))
  ACN(d:fac+1, fbn('Cantidad'))
  ACT(e:fac, &Especie)
  ACT(e:fac+1, &Especie)
  ACT(f:fac, '1')
  ACT(f:fac+1, '1')
  ACT(h:fac, fbn('NrBoleto'))
  ACT(h:fac+1, fbn('NrBoleto'))
  ACT(i:fac, fbn('NrOperacion'))
  ACLO(i:fac, Val(i:fac))
  ACT(j:fac, fbn('OperacionRef'))
  ACT(j:fac+1, fbn('OperacionRef'))
  ACT(g:fac, &CuentaMercado)
  ACT(g:fac+1, &CuentaMercado)
  if Incluido(fbn('TipoOp'),'DDC')
    ACT(a:fac, '131.718.091')
    ACT(b:fac, 'Documentos descontados-Compra a liq')  
    ACT(a:fac+1, '321.301.xxx')
    ACT(b:fac+1, 'Acreedores no financieros por otras compras al contado a liquidar')  
  else
    ACT(a:fac, '141.187.xxx')
    ACT(b:fac, 'Deudores no Financieros por Otras Ventas al Contado')  
    ACT(a:fac+1, '131.718.092')
    ACT(b:fac+1, 'Documentos descontados-Venta a liq.')  
  endif
  AgregarMarco(a:fac..j:fac+1,1,0)
  SetFilaActual(fac+1)
proximo


setFilaActual(fac+4)
ACT(a:fac, "Liquidacion")
 
ifa
ACT(a:fac,'Rubro')
ACT(b:fac,'Descripcion')
ACT(c:fac,'Debito')
ACT(d:fac,'Credito')
ACT(e:fac,'Moneda')
ACT(f:fac,'Sucursal')
ACT(g:fac,'Cuenta')
ACT(h:fac,'Boleto')
ACT(i:fac,'Operacion')
ACT(j:fac,'Nr.Cheque')

SetFont(a:fac-1..j:fac, 2)
AgregarMarco(a:fac-1..j:fac,1,0,Exe('COLOR2'))


SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and Especie='"~Dialogo.Especie1~"' and Cliente1='"~VAR('VEHICULODE')~"' and FechaOp2 = '"~IdxDate(Dialogo.Fecha1)~"' order by TipoOp")


