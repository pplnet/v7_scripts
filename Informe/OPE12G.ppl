SQL.ADD("SELECT O.* ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.TipoOp In ('MMCPR','MMCPRV') ")
SQL.ADD(" and  O.OperacionRef='' ")

