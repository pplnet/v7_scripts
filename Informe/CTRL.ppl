ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1    : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1       :'F.Desde' ;;;;;;;;;FSys
  Fecha2       :'F.Hasta' ;;;;;;;;;FSys
  Radio1       :'Operaciones|Modificadas|Eliminadas|Observadas' ;;;;;;Dialogo.Radio1>=0;'Ingrese tipo de operacion';no;;
  NrOperacion1 : 'Operacion'  ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif
act(q1,Dialogo.NrOperacion1)

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

IF Dialogo.Radio1=0

  CrearFont(1, 'Arial,8,')
  CrearFont(2, 'Arial,8,B')
  CrearFont(3, 'Arial,12,B')

  SetFilaActual(1)
  ImportarWKS(ba1..bb1,a1..b1,'CIERRE.WKS')

  if Val(bb1)=1
    ACT(h:FAC, 'CIERRE DEL DIA '~Dialogo.Fecha1~'  Nr. '~FStr(Val(ba1),3,0))
    SetFont(h:FAC,3)
  endif


  SetFilaActual(1)
  ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
  SetFont(a:1,2)


  SetFilaActual(4)
  ACT(a:FAC,'Log file de Operaciones')
  ACT(a:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+2,'Fecha Hasta: '~Dialogo.Fecha2)

  if NoVacio(Dialogo.Vehiculo1)
     ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
  else
     ACT(a:FAC+3, 'Vehiculo : Todos')
  endif

  SetFont(a:FAC..a:FAC+3,2)

  SetFilaActual(FAC+5)

  ACT(a:FAC,'Operaciones Modificadas del periodo')

  ACT(a:FAC+2,'Operador')
  ACT(b:FAC+2,'Fecha y hora')
  ACT(d:FAC+2,'# Op/Cuota')
  ACT(e:FAC+2,'Tipo Op')
  ACT(f:FAC+2,'Especie')
  ACT(g:FAC+2,'Fecha Op')
  ACT(i:FAC+1,'Modificacion')
  ACT(h:FAC+2,'Campo')
  ACT(i:FAC+2,'Anterior')
  ACT(j:FAC+2,'Actual')

  SetFont(a:FAC..j:FAC+2,2)
  AgregarMarco(h:FAC+1..j:FAC+1,2,0,Exe('COLOR6'))
  AgregarMarco(a:FAC+2..j:FAC+2,2,0,Exe('COLOR6'))
  SetFilaActual(FAC+2)

  ACN(x1,FAC+1)

  Message('Operaciones del periodo modificadas')

  SQL.ADD(" SELECT Distinct A.Codigo, A.Fecha, A.Operador, Campo, ValorAnterior, ValorActual, ")
  SQL.ADD(" O.TipoOp, O.Especie, O.FechaOp ")
  SQL.ADD(" FROM "~DBO~".PMAUDIT A, "~DBO~".OPERACIONES O  ")
  SQL.ADD(" WHERE A.Accion In ('M','B') and A.Tabla In ('OPERACIONES','CUOTAS','COMISIONES2') ")
  SQL.ADD(" and A.Codigo=O.NrOperacion ")
  SQL.ADD(" and A.Campo Not In ('Direccion','LInstancia') ")
  SQL.ADD(" and ((A.Accion='M' and A.ValorAnterior<>A.ValorActual) or A.Accion='B') and ")
  SQL.ADD(" A.Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2+1)~"' ")
  If NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" and Codigo = '"~Dialogo.NrOperacion1~"' ")
  EndIf
  If NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
  EndIF
  SQL.ADD(" Order by Fecha,Codigo")

  Recorrer SQL

    *-- Verifico que la Operacion sea del Vehiculo Pedido
    ACN(x2,0)

    if Not EqStr(Val(z1), FieldByName['Codigo']~FieldByName['Fecha'])
      ACT(z1,    FieldByName['Codigo']~FieldByName['Fecha'])
      ACT(a:FAC, FieldByName['Operador'])
      ACT(b:FAC, FieldByName['Fecha'])
      ACT(d:FAC, FieldByName['Codigo'])
*      ACT(e:FAC, BuscarCampo('OPERACIONES','TipoOp' , 'NrOperacion', Val(d:fac)))
*      ACT(f:FAC, BuscarCampo('OPERACIONES','Especie', 'NrOperacion', Val(d:fac)))
*      ACT(g:FAC, BuscarCampo('OPERACIONES','FechaOp', 'NrOperacion', Val(d:fac)))
      ACT(e:FAC, FBN['TipoOp'] )
      ACT(f:FAC, FBN['Especie'])
      ACT(g:FAC, FBN['FechaOp'])

   endif

   SCN(x2,1)
   ACT(h:FAC, FieldByName['Campo'])
   ACT(i:FAC, FieldByName['ValorAnterior'])
   ACT(j:FAC, FieldByName['ValorActual'])
  proximo

  SetFont(a:Val(x1)..k:FAC,1)
  FormatoCeldas(i:Val(x1)..j:FAC,Exe('F2'))
  AgregarMarco(a:Val(x1)..k:FAC,1)
  ACT(k:FAC+1, ' ')

  ACO(1,10)
  ACO(2,12)
  ACO(3,1)
  ACO(4,8)
  ACO(5,6)
  ACO(6,6)
  ACO(7,10)
  ACO(8,10)
  ACO(9,15)
  ACO(10,15)

  Impresion(1,2)

  SetFilaActual(FAC+2)
  ACT(a:FAC, 'FIN DEL LISTADO')
  SetFont(a:FAC,2)
  SetFont(g:3,2)
  LimitesVision(k:FAC+1)

*
*    Esto es lo que agrega Silvia
*
  RangoTitulo(a:1..k:FAC+1, 11)

ENDIF

IF Dialogo.Radio1=1
  CrearFont(1, 'Arial,8,')
  CrearFont(2, 'Arial,8,B')
  CrearFont(3, 'Arial,12,B')

  SetFilaActual(1)
  ImportarWKS(ba1..bb1,a1..b1,'CIERRE.WKS')

  if Val(bb1)=1
    ACT(h:FAC, 'CIERRE DEL DIA '~Dialogo.Fecha1~'  Nr. '~FStr(Val(ba1),3,0))
    SetFont(h:FAC,3)
  endif


  SetFilaActual(1)
  ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
  SetFont(a:1,2)

  SetFilaActual(4)
  ACT(a:FAC,'Log file de Operaciones')
  ACT(a:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+2,'Fecha Hasta: '~Dialogo.Fecha2)
  SetFont(a:FAC..a:FAC+2,2)

  SetFont(a:Val(x1)..k:FAC,1)
*  FormatoCeldas(j:Val(x1)..j:FAC,',2')
*  FormatoCeldas(k:Val(x1)..k:FAC,',5')
  AgregarMarco(a:Val(x1)..k:FAC,1)
 
  ACT(k:FAC+1, ' ')

  SetFilaActual(FAC+3)

  ACT(a:FAC,'Operaciones Borradas del Periodo')

  ACT(a:FAC+2,'Operador')
  ACT(b:FAC+2,'Fecha y hora')
  ACT(d:FAC+2,'# Op')
  ACT(e:FAC+2,'Tipo Op')
  ACT(f:FAC+2,'Especie')
  ACT(g:FAC+2,'Fecha Op')
  ACT(h:FAC+2,'Cliente1')
  ACT(i:FAC+2,'Cantidad')
  ACT(j:FAC+2,'Precio')
  ACT(k:fac+2, 'Usr.Baja')

  SetFont(a:FAC..k:FAC+2,2)
  *AlinearCeldas(j:FAC+2..k:FAC+2,'D')
  AgregarMarco(a:FAC+2..k:FAC+2,2,0,Exe('COLOR6'))
  SetFilaActual(FAC+2)
  ACN(x1,FAC+1)

  Message('Operaciones del periodo eliminadas')

  SQL.ADD("Select TipoOp, NrOperacion, FechaOp, FechaVto, Especie, FechaEj, PrecioEj, PaseCB, Cliente1, Cantidad, Precio1, Vehiculo1, Operador, Arbitraje, CB5, FechaDel, UsuarioDel")
  SQL.ADD(" from "~DBO~".BOPERACIONES B where  ")
  SQL.ADD(" B.FechaDel between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2+1)~"' ")
  If NoVacio(Dialogo.Vehiculo1)  
  SQL.ADD(" and B.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
  EndIf
  if NoVacio(Dialogo.NrOperacion1)   
     SQL.ADD(" and NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  endif


  SQL.ADD("order by NrOperacion")

  Recorrer SQL

    ACT(a:fac, fbn('Operador'))
    ACT(b:fac, fbn('FechaDel'))
    ACT(d:fac, fbn('NrOperacion'))
    ACT(e:fac, fbn('TipoOp'))
    ACT(f:fac, fbn('Especie'))
    ACD(g:fac, fbn('FechaOp'))
    ACT(h:fac, fbn('Cliente1'))
    ACN(i:fac, fbn('Cantidad'))
    ACN(j:fac, fbn('Precio1'))
    ACT(k:fac, fbn('UsuarioDel'))
  Proximo

  SetFont(a:Val(x1)..k:FAC,1)
  FormatoCeldas(j:Val(x1)..j:FAC,Exe('F7'))
*  FormatoCeldas(k:Val(x1)..k:FAC,',5')
  AgregarMarco(a:Val(x1)..k:FAC,1)
  ACT(k:FAC+1, ' ')

  ACO(1,10)
  ACO(2,12)
  ACO(3,1)
  ACO(4,6)
  ACO(5,6)
  ACO(6,6)
  ACO(7,10)
  ACO(8,10)
  ACO(9,10)
  ACO(10,10)
 
  Impresion(1,2)
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'FIN DEL LISTADO')
  SetFont(a:FAC,2)
 
  LimitesVision(k:FAC+1)
*
*    Esto es lo que agrega Silvia
*
  RangoTitulo(a:1..k:FAC+1, 9)

ENDIF

if Dialogo.Radio1 = 2
   CrearFont(1,"Arial,8,")
   CrearFont(2,"Arial,8,B")
   CrearFont(3,"Arial,10,B")


   SetFilaActual(1)
   ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
   SetFont(a:1,2)

   SetFilaActual(4)

   ACT(f:2,'Fecha : '~Var('FECHASYS'))
   SetFont(f:2..f:2,1)

   ACT(a:FAC, 'Operaciones Observadas')
   SetFont(a:fac..a:fac,3)

   SetFilaActual(5)
   ACN(w1,FAC)

   ACT(a:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
   ACT(a:FAC+2,'Fecha Hasta: '~Dialogo.Fecha2)
   SetFont(a:FAC..a:FAC+2,2)

   SetFilaActual(fac+5)

   ACT(a:FAC, 'Tipo Op.')
   ACT(b:FAC, 'Numero')
   ACT(c:FAC, 'Especie')
   ACT(d:FAC, 'Cliente')
   ACT(e:FAC, 'Tipo Excepcion')
   ACT(f:FAC, 'Descripcion Excepcion')
   ACT(g:FAC, 'Autorizado')
   ACT(h:FAC, 'F.Excepcion')

   AlinearCeldas(a:FAC..h:FAC,'I')
   SetFont(a:Val(w1)..h:FAC,2)
   AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))

   SQL.ADD("Select O.TipoOp, O.NrOperacion, Especie, Cliente1, Tipo, Fecha, Descripcion, ")
   SQL.ADD(" Autorizado, E.NrOperacion No, O.PrecioEj, O.FechaEj")
   SQL.ADD("From "~DBO~".OPERACIONES O, "~DBO~".EXCEPCIONES E ")
   SQL.ADD("where O.NrOperacion = E.NrOperacion ")
   SQL.ADD("  and E.Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")

   if NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" and  E.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   endif
   if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
   endif
   SQL.ADD(" order by E.Fecha, O.TipoOp, O.NrOperacion, E.Tipo ")

   recorrer SQL

     IF Not EqStr(FBN['NrOperacion'],Val(M1))
        ACT(a:FAC, FBN['TipoOp'])
        ACT(b:FAC, FBN['NrOperacion'])
        SetFont(a:fac..b:FAC,2)
        ACT(c:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
        ACT(d:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
        ACT(m1,FBN['NrOperacion'])
     endif

     ACT(e:FAC, FBN['Tipo'])
     ACT(f:FAC, FBN['Descripcion'])
     ACT(g:FAC, FBN['Autorizado'])
     ACT(h:FAC, FBN['Fecha'])
     SetFont(c:fac..h:fac,1)
   proximo

   ACO(1,6)
   ACO(2,7)
   ACO(3,11)
   ACO(4,16)
   ACO(5,9)
   ACO(6,30)
   ACO(7,10)
   ACO(8,7)

   Impresion(1,2)
   SetFilaActual(FAC+2)
   ACT(a:FAC, 'FIN DEL LISTADO')
   SetFont(a:FAC,2)
   LimitesVision(h:FAC)
*
*    Esto es lo que agrega Silvia
*

   RangoTitulo(a:1..h:FAC, 10)

endif
