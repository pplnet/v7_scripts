** Test de Recalculo de Campos

DialogoVisible(SI)
CrearDialogo
    Cantidad1: 'Cantidad'        ;1;1;1;SI;SI;SI;;SI;10;;;;'#0.00';
    Cantidad2: 'Precio Unitario' ;2;1;1;SI;SI;SI;;SI;100;;;;'#0.00';
    Cantidad3: 'Tasa IVA'        ;3;1;1;SI;SI;SI;;SI;21;;;;'#0.00';
    Cantidad4: 'Subtotal'        ;1;2;1;NO;SI;SI;;SI;;Dialogo.Cantidad1*Dialogo.Cantidad2;;;'#0.00';
    Cantidad5: 'IVA'             ;2;2;1;NO;SI;SI;;SI;;Dialogo.Cantidad4*Dialogo.Cantidad3/100;;;'#0.00';
    Cantidad6: 'Total'           ;3;2;1;NO;SI;SI;;SI;;Dialogo.Cantidad4+Dialogo.Cantidad5;;;'#0.00';
FinDialogo
ACT( a1, Dialogo.Cantidad1)
ACT( a2, Dialogo.Cantidad2)
ACT( a3, Dialogo.Cantidad3)
ACT( b1, Dialogo.Cantidad4)
ACT( b2, Dialogo.Cantidad5)
ACT( b3, Dialogo.Cantidad6)

