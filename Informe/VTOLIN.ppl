ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1 : 'Empresa'   ;
  Cliente1  : 'Banco'     ;;;;;;DesciendeDeCliente(Dialogo.Cliente1,'BANCOS') o Vacio(Dialogo.Cliente1);'Debe Ingresar una Banco';NO;
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites - Vencimiento de Lineas de Credito')
ACT(a:FAC+1, 'Empresa:')
if Vacio(Dialogo.Vehiculo1)
  ACT(b:FAC+1, 'Todas')
else
  ACT(b:FAC+1, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
endif
ACT(a:FAC+2, 'Banco:')
if Vacio(Dialogo.Cliente1)
  ACT(b:FAC+2, 'Todos')
else
  ACT(b:FAC+2, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
endif
SetFont(a:FAC..b:FAC+2,2)

SetFilaActual(FAC+4)
ACT(a:FAC, 'Empresa')
ACT(b:FAC, 'Banco')
ACT(c:FAC, 'Fecha Vto')
ACT(d:FAC, 'Linea')
ACT(e:FAC, 'Observaciones')
SetFont(a:FAC..e:FAC,2)
AlinearCeldas(a:FAC..e:FAC,'C')
AgregarMarco(a:FAC..e:FAC,1,2,Exe('COLOR'))

SetFilaActual(FAC+1)
SQL.ADD("Select * from "~DBO~".LIMASIGNADOS ")
SQL.ADD("where Limite in ('ACLTOT','ACOTOT') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"' ")
else
  SQL.ADD("and Vehiculo is Not NULL ")
endif
SQL.ADD("order by Cliente")
recorrer SQL
  ACT(a:FAC, FBN['Vehiculo'])
  ACT(b:FAC, FBN['Cliente'])
  ACD(c:FAC, FBN['FVencimiento'])
  ACN(d:FAC, FBN['Monto'])
  SetFont(a:FAC..e:FAC,1)
proximo

ACO(1,12)
ACO(2,12)
ACO(3,12)
ACO(4,12)
ACO(5,15)

LimitesVision(e:FAC)
RangoTitulo(a:8..e:FAC,1)
