SetFilaActual(7)
if no
SQL.ADD(" SELECT M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, 0 NrComprob, '  ' Origen, M.Fecha2 FechaOp, ")
SQL.ADD(" B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, M.NrTrans, M.Observaciones ")
SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND    M.Fecha2   >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.Fecha2   <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'ESTIMA' ")
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
endif
SQL.ADD(" SELECT M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, 0 NrComprob, '  ' Origen, ")
SQL.ADD(" M.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, M.NrTrans, M.Observaciones ")
SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND    M.Fecha2   >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.Fecha2   <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'PROYEC' ")
SQL.ADD(" AND    M.RB1       = '0' ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY 4,3,5 ")
