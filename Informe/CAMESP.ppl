SQL.ADD(" Select P.Fecha, P.Especie, P.Cliente, P.Vehiculo, P.NrSaldo, P.CantidadFin From "~DBO~".POSICIONES P ")
SQL.ADD("  Where P.Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("    And P.Cliente in (Select Distinct Codigo From "~DBO~".VEHICULOS) ")
SQL.ADD("    And P.Vehiculo in (Select Distinct Codigo From "~DBO~".VEHICULOS) ")
SQL.ADD("    And P.Fecha = (Select Max(P1.Fecha) ")
SQL.ADD("                     From "~DBO~".POSICIONES P1 ")
SQL.ADD("                    Where P1.Especie=P.Especie ")
SQL.ADD("                      And P1.Cliente=P.Cliente ")
SQL.ADD("                      And P1.Vehiculo=P.Vehiculo ")
SQL.ADD("                      And P1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" Order by P.NrSaldo, P.Fecha ")

Recorrer SQL
  ACD(A:FAC,FBN['Fecha'])
  ACT(B:FAC,FBN['Especie'])
  ACT(C:FAC,FBN['Cliente'])
  ACT(D:FAC,FBN['Vehiculo'])
  ACN(E:FAC,FBN['NrSaldo'])
  ACN(F:FAC,FBN['CantidadFin'])
Proximo

