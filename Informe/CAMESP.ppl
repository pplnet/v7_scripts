SQL.ADD(" Select R.Fecha, R.Especie, R.Vehiculo, R.NrSaldo, R.RZMEYTD From "~DBO~".RESULTADOS2 R ")
SQL.ADD("  Where R.Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("    And R.Vehiculo in (Select Distinct Codigo From "~DBO~".VEHICULOS) ")
SQL.ADD("    And R.Fecha = (Select Max(R1.Fecha) ")
SQL.ADD("                     From "~DBO~".RESULTADOS2 R1 ")
SQL.ADD("                    Where R1.Especie=R.Especie ")
SQL.ADD("                      And R1.Vehiculo=R.Vehiculo ")
SQL.ADD("                      And R1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" Order by R.NrSaldo, R.Fecha ")

