ACT(A:FAC,'SALDOS')
SetFont(A:FAC,3)

ACT(A:FAC+2,'Fecha')
ACT(B:FAC+2,'Especie')
ACT(C:FAC+2,'Cliente')
ACT(D:FAC+2,'EnteCustodia')
ACT(E:FAC+2,'NrSaldo')
ACT(F:FAC+2,'Saldo')
SetFont(A:FAC+2..F:FAC+2,2)
AgregarMarco(A:FAC+2..F:FAC+2,2,0,Exe('COLOR'))

ACN(Z:1,FAC+3)

SetFilaActual(FAC+2)

SQL.ADD(" Select S.Fecha, S.Especie, S.Cliente, S.EnteCustodia, S.NrSaldo, S.Saldo From "~DBO~".SALDOSDIA S ")
SQL.ADD("  Where S.Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("    And S.EnteCustodia in (Select Distinct Codigo From "~DBO~".VEHICULOS) ")
SQL.ADD("    And S.NrSaldo in (1,2) ")
SQL.ADD("    AND S.Fecha = (Select Max(S1.Fecha) ")
SQL.ADD("                   From "~DBO~".SALDOSDIA S1 ")
SQL.ADD("                  Where S1.Especie=S.Especie ")
SQL.ADD("                    And S1.EnteCustodia=S.EnteCustodia ")
SQL.ADD("                    And S1.NrSaldo=S.NrSaldo ")
SQL.ADD("                    And S1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")

SQL.ADD(" Union ")

SQL.ADD(" Select S.Fecha, S.Especie, S.Cliente, S.EnteCustodia, S.NrSaldo, S.Saldo From "~DBO~".SALDOSDIA S ")
SQL.ADD("  Where S.Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("    And S.Cliente in (Select Distinct Codigo From "~DBO~".VEHICULOS) ")
SQL.ADD("    And S.NrSaldo not in (1,2) ")
SQL.ADD("    AND S.Fecha = (Select Max(S2.Fecha) ")
SQL.ADD("                   From "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  Where S2.Especie=S.Especie ")
SQL.ADD("                    And S2.Cliente=S.Cliente ")
SQL.ADD("                    And S2.NrSaldo=S.NrSaldo ")
SQL.ADD("                    And S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")

SQL.ADD(" Order by S.NrSaldo, S.Fecha ")

Recorrer SQL
  ACD(A:FAC,FBN['Fecha'])
  ACT(B:FAC,FBN['Especie'])
  ACT(C:FAC,FBN['Cliente'])
  ACT(D:FAC,FBN['EnteCustodia'])
  ACN(E:FAC,FBN['NrSaldo'])
  ACN(F:FAC,FBN['Saldo'])
Proximo

SetFont(A:Val(Z:1)..F:FAC,1)
FormatoCeldas(E:Val(Z:1)..E:FAC,Exe('F0'))

SetFilaActual(FAC+2)

