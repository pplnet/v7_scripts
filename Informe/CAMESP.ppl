CrearDialogo
  Fecha1:   'Fecha'    ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Especie1: 'Especie'  ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1, "Arial, 8,")
CrearFont(2, "Arial, 8,B,")
CrearFont(3, "Arial, 9,BU,")

*****************************
ACT(A:2,'OPERACIONES')
SetFont(A:2,3)

ACT(A:4,'NrOperacion')
ACT(B:4,'Especie')
SetFont(A:4..B:4,2)
AgregarMarco(A:4..B:4,2,0,Exe('COLOR'))

SetFilaActual(4)
ACN(Z:1,FAC+1)

SQL.ADD(" Select NrOperacion, Especie From "~DBO~".OPERACIONES Where Especie='"~Dialogo.Especie1~"' ")
SQL.ADD(" Order by NrOperacion ")

Recorrer SQL
  ACT(A:FAC,FBN['NrOperacion'])
  ACLO(A:FAC,FBN['NrOperacion'])
  ACT(B:FAC,FBN['Especie'])
Proximo

SetFont(A:Val(Z:1)..B:FAC,1)

SetFilaActual(FAC+2)

