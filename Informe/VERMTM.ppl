* HojaVisible(SI)
CrearDialogo
  Radio1     : 'Tipo|DT|DC'                           ;;;;;;;;;1;;
  String1    : 'Nombre PMG'                           ;;;;;;;;;IIf(Dialogo.Radio1=0,'MARKTA','MARKTM');IIf(Dialogo.Radio1=0,'MARKTA','MARKTM');
  Fecha1     : "Fecha"                                ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha y debe ser un Principio de mes';NO;HABILES(Fsys,-1,'ARG',SI)
  Especie1   : 'Especie'                              ;;;;;;;;;IIf(Dialogo.Radio1=0,VAR('MONEEXTR'),'WTI');IIf(Dialogo.Radio1=0,VAR('MONEEXTR'),'WTI');;;;
  Lista1     : 'Vehiculo'                             ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio2     : 'Tipo|Reales|Simuladas'                ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;;;;0;;
FinDialogo

*- Construyo la Extencion
If Vacio(Dialogo.Lista1)
   ACT(z1,'TODOS')
Else
   ACT(z1,Dialogo.Lista1)
EndIf

ACT(z1,val(z1)~'/'~Dialogo.Fecha1)

ACT(z1,val(z1)~'/'~Dialogo.Especie1)

If Dialogo.Radio1=1
   ACT(z1,val(z1)~"/"~Fstr(Dialogo.Radio2,0,0))
EndIf

if SQL("Select Count(*) from "~DBO~".OBJETOS where Codigo='"~Dialogo.String1~"' and Extension='"~VAL(z1)~"' ")=0
   MessageBox('No existe el Reporte Solicitado '~Dialogo.String1~' '~val(z1))
else
   Message('Recuperando '~Dialogo.String1~' '~val(z1))
   LeerPMG(Dialogo.String1, VAL(z1))
endif

*- z2: Contador de Filas no vacias
acn(z2,0)

Recorrer&j 8,100

   If NoVacio(val(a:&j))
      acn(z2,&j)    
   Else
      Break
   EndIf
Proximo

LimitesVision(f:val(z2)+2)
