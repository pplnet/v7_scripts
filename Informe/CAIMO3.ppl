ACO(9,4)
ACO(10,7)
ACO(11,10)
ACO(12,11)
ACO(13,11)
ACO(14,8)

Impresion(1,2)
SetFilaActual(FAC+2)
SetPrintFit(3,70)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(n:FAC)
