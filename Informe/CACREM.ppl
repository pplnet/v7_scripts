ACT(a:fac,'la suma de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-, en nuestra cuenta corriente en vuestro Banco, Cuenta')
SetFilaActual(fac+1)
ACT(a:fac,'Nro. '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))~', como cuenta remunerada por el plazo de '~val(zh:99)~IIF(num(val(zh:99)) >1,' d'~Chr(237)~'as', ' d'~Chr(237)~'a')~', a una T.N.A. '~val(zj:99)~'%')
SetFont(a:val(zz:99)..a:fac,1)

