ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMCCR');'El TipoOp debe ser MMCCR';NO;;;;;;" TipoOp in ('MMCCR') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1) Y EqStr(Dialogo.String1,Var('FILECACREM'));'Debe ingresar un documento';NO;Var('FILECACREM')
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo,  O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zh:99, fbn['Plazo'])
   ACT(zj:99, PYC(fbn['Precio1'],1,2))
   ACD(zm:99, fbn['FechaOp'])
   
   let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Vehiculo1'])
   let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
   let &simbolo_especie IIF(EqStr(fbn['Especie'],'ARP'),'$',IIF(EqStr(fbn['Especie'],'USD'),'u$s',fbn['Especie'] ) )
   let &numero_cuenta BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])
   let &tna PYC(BuscarCampo('CUOTAS','Precio2','NrOperacion', Dialogo.NrOperacion1),1,2)
   let &fecha_larga FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)
   
   EmitirCartaVisible(Dialogo.Directorio1~Dialogo.String1, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, numero_cuenta = &numero_cuenta, especie = &simbolo_especie, monto = PYC(fbn['Cantidad'],1,2), plazo = fbn['Plazo'], t_n_a = &tna)
   
Proximo


SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')

