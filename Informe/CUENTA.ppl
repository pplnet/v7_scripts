CrearDialogo
  Cliente1: "Cliente";
  Lista1: "Cuentas"  ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS " ~ IF(NOVACIO(CLIENTE1),"WHERE CLIENTE = '" ~ CLIENTE1 ~ "'",""));SI
FiNdialogo

If Not OK 
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Listado de Cuentas Operativas')
ACT(a:FAC+2,'Codigo')
ACT(b:FAC+2,'Nombre')
ACT(c:FAC+2,'Numero')
ACT(d:FAC+2,'Cliente')
ACT(e:FAC+2,'Mercado')
ACT(f:FAC+2,'Especies')
ACT(g:FAC+2,'Tipo')
ACT(h:FAC+2,'CtaContable')
ACT(i:FAC+2,'CBU')
ACT(j:FAC+2,'CtaDefault')
ACT(k:FAC+2,'Codigo Tasa')
ACT(l:FAC+2,'Forma de Calculo')
ACT(m:FAC+2,'Estado')
ACT(n:FAC+2,'Remunerable')
AgregarMarco(a:FAC+2..z:FAC+2,1,0,Exe('COLOR6'))
SetFont(a:FAC..z:FAC+2,2)

SetFilaActual(FAC+2)

SQL.ADD("Select Codigo, Nombre, Numero, Cliente, Mercado, Especies, TipoCuenta, CuentaContable1, CBU, Permanente, CodigoTasa, ISNULL(TEM, 'NO') TEM, Estado, NoRemunerable From "~DBO~".CUENTAS ")
SQL.ADD(" WHERE Codigo is not null ")


IF NOVACIO(CLIENTE1)
   SQL.ADD("AND CLIENTE = '" ~ CLIENTE1 ~ "'")
ENDIF

IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" ORDER BY Codigo ")
Recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN('Codigo'))
  ACT(b:FAC, FBN('Nombre'))
  ACT(c:FAC, FBN('Numero'))
  ACT(d:FAC, FBN('Cliente'))
  ACT(e:FAC, FBN('Mercado'))
  ACT(f:FAC, FBN('Especies'))
  ACT(g:FAC, FBN('TipoCuenta'))
  
  iF Eqstr(FBN('TipoCuenta'), 'CC')
    ACT(g:FAC, 'Cuenta Corriente')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'CA')
    ACT(g:FAC, 'Caja de Ahorro')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'CUS')
    ACT(g:FAC, 'Custodia')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'OTR')
    ACT(g:FAC, 'Otros')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'CCO')
    ACT(g:FAC, 'C.Propias')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'VIS')
    ACT(g:FAC, 'Vista')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'CAJ')
    ACT(g:FAC, 'Caja')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'INV')
    ACT(g:FAC, 'Inversor')
  Endif
  iF Eqstr(FBN('TipoCuenta'), 'FCI')
    ACT(g:FAC, 'F.Comun')
  Endif

  ACT(h:FAC, FBN('CuentaContable1'))
  ACT(i:FAC, FBN('CBU'))
  *ACT(j:FAC, FBN('Permanente'))
   
  if Vacio(FBN('Permanente'))
    ACT(j:FAC, 'NO')
  else
    ACT(j:FAC, FBN('Permanente'))
  Endif
  
  ACT(k:FAC, FBN('CodigoTasa'))
  
  if EqStr(FBN['TEM'],'NO')
      ACT(l:fac,'TNA')
  Else 
      If EqStr(FBN['TEM'], 'SI')
      ACT(l:fac,'TEM')
      Endif
  Endif
  
  if Eqstr(FBN('Estado'), 'HAB')
    ACT(m:FAC, 'Habilitada')
  Endif
  if Eqstr(FBN('Estado'), 'SUS')
    ACT(m:FAC, 'Suspendida')
  Endif
    if Eqstr(FBN('Estado'), 'CER')
    ACT(m:FAC, 'Cerrada')
  Endif
    if Eqstr(FBN('Estado'), 'PEN')
    ACT(m:FAC, 'Pendiente')
  Endif
    if Eqstr(FBN('Estado'), 'BLO')
    ACT(m:FAC, 'Bloqueada')
  Endif
  
  if Eqstr(FBN('NoRemunerable'), 'SI') 
    ACT(n:FAC, 'NO')
  Endif
  if Eqstr(FBN('NoRemunerable'), 'NO') o Vacio(FBN('NoRemunerable'))
    ACT(n:FAC, 'SI')
  Endif
  
  
proximo

*AgregarMarco(a:Val(w1)+3..h:FAC+1,1)
SetFont(a:Val(w1)+3..z:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(1,10)
ACO(2,30)
ACO(3,20)
ACO(6,15)
ACO(7,10)
ACO(8,12)
ACO(9,15)
ACO(12,10)
ACO(13,10)
ACO(14,8)

Impresion(1,2)
Impresion(4,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC, 2)
SetPrintFit(3,80)
AlinearCeldas(c:3,'D')
LimitesVision(n:FAC)
RangoTitulo(a:1..n:FAC,Val(w1)+2)



