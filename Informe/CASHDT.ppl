* CASHDT - Cash Flow Cobertura de Tasa
ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1  : 'Desde'          ;1;1;;;;;;;;Fsys
   Fecha2  : 'Hasta'          ;;;;;;;;;;Fsys
   Lista1  : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))   
FinDialogo
if Not Ok
  Cancelar
endif

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")
CrearFont(5,"Arial,10,B")

ACT(g:1,'Fecha : '~Var('FECHASYS'))
SetFont(c:1..c:1,5)

SetFilaActual(2)

ACT(a:FAC, "Cash Flow Cobertura de Tasa")
SetFont(a:fac..a:fac,5)

SetFilaActual(3)

ACT(a:FAC+1, 'Desde : '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Hasta : '~Dialogo.Fecha2)

if Vacio(val(zz6))
   ACT(a:FAC+3, 'Empresa : Todas ')
else
   ACT(a:FAC+3, 'Empresa : '~val(zz6))
endif

SetFont(a:fac..n:FAC+4,4)
SetFilaActual(7)

SQL.ADD("Select O.Vehiculo1,O.NrOperacion,M.FechaMov,M.Cantidad,M.Especie ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M where ")
SQL.ADD("M.FechaMov>='"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("M.FechaMov<='"~IdxDate(Dialogo.Fecha2)~"' and ")
SQL.ADD("M.NrSaldo=1 and M.Cantidad<>0 and M.Leyenda Not Like '%IVA%' and")
SQL.ADD("M.NrOperacion=O.NrOperacion and O.TipoOp Like 'DT%' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" order by 3,2")

ACT(a:fac,'Fecha')
ACT(b:fac,'Importe')
ACT(c:fac,'Acumulado')
ACT(d:fac,'Nr.Oper')
SetFont(a:fac..d:fac,3)  
AgregarMarco(a:FAC..d:FAC,2,0,Exe('COLOR'))

act(z11,'')
acn(z12,1)
acn(z13,fac)
acn(z1,1)

*- z10: Corte por Operacion y Fecha z11: Corte por Fecha 
*- z12: Nro.Fila de Movimientos y Fechas 
Recorrer SQL

   Message('Recuperando '~FBN['NrOperacion']~' '~FBN['Especie']~' '~FBN['Cantidad'] )

   *-- Corte Por NrOperacion y Fecha Movimiento
   If Not EqStr(val(z10),FBN['NrOperacion']~' '~FBN['FechaMov'])  
      If val(z1)>1
         ACN(c:fac-1,VAL(c:fac-2)+VAL(b:fac-1) )
      EndIf

      ACT(z10,FBN['NrOperacion']~' '~FBN['FechaMov'])
      ACT(d:fac,FBN['NrOperacion'])
      ACLO(d:fac,FBN['NrOperacion'])
      ACT(a:fac,FBN['FechaMov'])

      *-- Corte por Fecha Movimiento
      If Not EqStr(val(z11),FBN['FechaMov'])  
         If val(z1)>1
            ACT(ca:val(z12),val(z11))
            ACN(cb:val(z12),VAL(c:fac-1))
            SCN(z12,1)
         EndIf
         ACT(z11,FBN['FechaMov'])
      EndIf
   Else 
      DFA    
   EndIf

   acn(x:fac,CotizacionC(fbn['Especie'],,,,FBN['FechaMov'],1,SI,VAR('MONEEXTR')) )

   If Val(x:fac)=0
      *- No Encontre cotizacion para la fecha del movimiento
      Cancelar('Falta Cotizacion '~fbn['Especie']~' '~FBN['FechaMov']~' ...')   
   EndIf

   SCN(b:fac,-FBN['Cantidad']*VAL(x:fac) )
   SCN(z2,-FBN['Cantidad']*VAL(x:fac) )
   scn(z1,1)
Proximo

If val(z1)>1
   ACN(c:fac,VAL(c:fac-1)+VAL(b:fac) )

   ACT(ca:val(z12),val(z11))
   ACN(cb:val(z12),VAL(c:fac-1))
EndIf

FormatoCeldas(b:val(z13)..c:fac,Exe('F2'))
SetFont(a:val(z13)..d:fac,3)
Ifa

If val(z2)<>0
   act(e:val(z13)-2,'Grafico por Fecha' )
   SetFont(e:val(z13)-2..e:val(z13)-2,4)
   GraficarCeldas(e:val(z13)..20:fac, Barras|Eachbar|C3D|Showzero,,,,,,,ca:1..ca:val(z12),cb:1..cb:val(z12))

   act(e:fac+2,'Grafico por Fecha/Operacion' )
   SetFont(e:fac+2..e:fac+2,4)
   GraficarCeldas(e:fac+3..20:fac+3+(fac-val(z13)), Barras|Eachbar,,,,,,,a:val(z13)+1..a:fac,b:val(z13)+1..b:fac)
EndIf

SetFilaActual(fac+2+(fac-val(z13))+2)
ACT(a:fac,'FIN DE LISTADO')

ACO(1,8)
ACO(2,10)
ACO(3,8)
Impresion(1,2)
LimitesVision(20:fac)
RangoTitulo(a1..z:fac,9)
