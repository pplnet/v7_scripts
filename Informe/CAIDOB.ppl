ModoReproceso(ConDialogo)
CrearDialogo
  Cliente1   : "Entidad"           ;;;
  Vehiculo1  : "Vehiculo"          ;;;
  Especie1   : "Especie"           ;;;
  TipoOp1    : "Tipo Op."          ;;;
  Fecha1     : "Fecha"             ;;;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+1, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+1, 'Entidad : Todos')
endif
act(a:fac+2,'Fecha : '~Dialogo.Fecha1)
SetFont(a:fac..N:FAC+3,2)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Fecha Op.')
ACT(b:FAC, 'Plazo')
ACT(c:FAC, 'Veh¦culo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Fecha Vto.')
ACT(g:FAC, 'Tipo Op.')
ACT(h:FAC, 'Numero Op.')
SetFont(a:FAC..h:FAC,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp, ")
SQL.ADD(" Vto = C.Fecha2 ,  ")
SQL.ADD(" Cant = C.Cantidad1 ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
  else
   SQL.ADD(" and O.TipoOp In ('MMDC','MMON','MMONM','MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSC','MMSCMV','MMPLME','MMPCCM','MMPCCV','MMPCVM','MMSI','MMSIMV','FXREPO','FXREPV','SEABP','SERA','SERAV') ")
endif
SQL.ADD(" and C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp, ")
SQL.ADD(" Vto = O.FechaVto,  ")
SQL.ADD(" Cant = O.Cantidad+O.TotalIntereses ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion Not In (Select C.NrOperacion from "~DBO~".CUOTAS C where C.NrOperacion = O.NrOperacion) ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
  else
   SQL.ADD(" and O.TipoOp In ('MMDC','MMON','MMONM','MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSC','MMSCMV','MMPLME','MMPCCM','MMPCCV','MMPCVM','MMSI','MMSIMV','FXREPO','FXREPV','SEABP','SERA','SERAV') ")
endif
SQL.ADD(" and  O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("order by O.NrOperacion ")

Recorrer SQL
  acd(a:fac,fbn['FechaOp'])   
  acn(b:fac,fbn['FechaVto']-Fsys)   
  act(c:fac,fbn['vehiculo1'])   
  act(d:fac,fbn['Especie'])   
  acn(e:fac,fbn['Cant'])   
  acd(f:fac,fbn['FechaVto'])
  act(g:fac,fbn['TipoOp'])   
  act(h:fac,fbn['NrOperacion'])   
  aclo(h:fac,fbn['NrOperacion'])   
  SetFont(a:fac..h:fac,1)
proximo

Recorrer&i 1,8
  ACO(&i,10)
proximo

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(h:FAC)
*RangoTitulo(a1..k:8,36)
