ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"                 ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Vehiculo1  : "Vehiculo"              ;;;;;;;
  Lista1     : "Divisiones"            ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Check1     : "Graba"                 
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")

ACT(a1,'Fecha Emision: '~Var('FECHASYS'))

SetFont(a1..a1,3)

*- Momeda Extranjera
ACT(me1, VAR('MONEEXTR'))

*- Especies que no deben listarse 
ACT(en1, VAR('ESPENOPF'))

(.'MARCOPOSFI'.)

(.'COLPOSFIN'.)

(.'VINCULADAS'.)

(.'DEPAPLAZO'.)

scn(c:200,1)
scn(d:200,1)
scn(f:200,2)
scn(g:200,2)

*- FX Terminos y Spot Normal Puesto
SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, ")
SQL.ADD("Sum(O.Cantidad)/1000 Cant, Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  (O.TipoOp In ('FXCT','FXVT') or (O.TipoOp In ('FXCS','FXVS') and  O.FechaVto=O.FechaPago))")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')

Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion 
     ACN(zz2  , CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  if Incluido(fbn['TipoOp'],'FXCT|FXCS')
     scn(val(e:200):val(d:200),fbn['Cant']*Val(zz2))
     scn(val(e:200):val(k:200),fbn['Cant']*Val(zz2))
     scn(b:val(d:200),fbn['Cant']*Val(zz2))
     scn(b:val(k:200),fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     scn(val(e:200):val(f:200),fbn['Monto'])
     scn(val(e:200):val(i:200),fbn['Monto'])
     scn(b:val(f:200),fbn['Monto'])
     scn(b:val(i:200),fbn['Monto'])
     SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)

     *** Regulariza ***
     scn(val(e:200):val(r:200)-1,fbn['Monto'])
     scn(b:val(r:200)-1,fbn['Monto'])
     SetFont(val(e:200):val(r:200)-1..val(e:200):val(r:200)-1,3)
     scn(val(e:200):val(q:200)-1,fbn['Cant']*Val(zz2))
     scn(b:val(q:200)-1,fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(q:200)-1..val(e:200):val(q:200)-1,3)
  else
     scn(val(e:200):val(g:200),fbn['Cant']*Val(zz2))
     scn(val(e:200):val(l:200),fbn['Cant']*Val(zz2))
     scn(b:val(g:200),fbn['Cant']*Val(zz2))
     scn(b:val(l:200),fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     scn(val(e:200):val(c:200),fbn['Monto'])
     scn(val(e:200):val(h:200),fbn['Monto'])
     scn(b:val(c:200),fbn['Monto'])
     scn(b:val(h:200),fbn['Monto'])
     SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)

     *** Regulariza ***
     scn(val(e:200):val(q:200)-1,fbn['Monto'])
     scn(b:val(q:200)-1,fbn['Monto'])
     SetFont(val(e:200):val(q:200)-1..val(e:200):val(q:200)-1,3)
     scn(val(e:200):val(r:200)-1,fbn['Cant']*Val(zz2))
     scn(b:val(r:200)-1,fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(r:200)-1..val(e:200):val(r:200)-1,3)
  endif
proximo

SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, O.Vehiculo2, ")
SQL.ADD("Sum(O.Cantidad)/1000 Cant, Sum(O.TotalBrutoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  (O.TipoOp In ('FXCTV','FXVTV') or (O.TipoOp In ('FXCSV','FXVSV') and  O.FechaVto=O.FechaPago))")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, O.Vehiculo2 ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif
  
  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion 
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  *- Cotizacion

  if Incluido(fbn['TipoOp'],'FXCTV|FXCSV')
     scn(val(e:200):val(d:200),fbn['Cant']*Val(zz2))
     scn(val(e:200):val(k:200),fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(d:200),fbn['Cant']*Val(zz2))
           scn(b:val(k:200),fbn['Cant']*Val(zz2))
        endif
     endif

     scn(val(e:200):val(f:200),fbn['Monto'])
     scn(val(e:200):val(i:200),fbn['Monto'])
     SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(f:200),fbn['Monto'])
           scn(b:val(i:200),fbn['Monto'])
        endif
     endif

     *** Regulariza ***
     scn(val(e:200):val(r:200)-1,fbn['Monto'])
     SetFont(val(e:200):val(r:200)-1..val(e:200):val(r:200)-1,3)
     scn(val(e:200):val(q:200)-1,fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(q:200)-1..val(e:200):val(q:200)-1,3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(r:200)-1,fbn['Monto'])
           scn(b:val(q:200)-1,fbn['Cant']*Val(zz2))
        endif
     endif
    else
     scn(val(e:200):val(g:200),fbn['Cant']*Val(zz2))
     scn(val(e:200):val(l:200),fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(g:200),fbn['Cant']*Val(zz2))
           scn(b:val(l:200),fbn['Cant']*Val(zz2))
        endif
     endif

     scn(val(e:200):val(c:200),fbn['Monto'])
     scn(val(e:200):val(h:200),fbn['Monto'])
     SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(c:200),fbn['Monto'])
           scn(b:val(h:200),fbn['Monto'])
        endif
     endif

     *** Regulariza ***
     scn(val(e:200):val(q:200)-1,fbn['Monto'])
     SetFont(val(e:200):val(q:200)-1..val(e:200):val(q:200)-1,3)
     scn(val(e:200):val(r:200)-1,fbn['Cant']*Val(zz2))
     SetFont(val(e:200):val(r:200)-1..val(e:200):val(r:200)-1,3)
     if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
           scn(b:val(q:200)-1,fbn['Monto'])
           scn(b:val(r:200)-1,fbn['Cant']*Val(zz2))
        endif
     endif
  endif
proximo

(.'SECURITIE1'.)
(.'SECURITIE2'.)
(.'OPCIONES'.)
(.'COBERTURA'.)
(.'PRESTAMOS'.)

*-- calcula totales ***
(.'TOTALPOSF'.)
(.'CONTROLPF'.)

Impresion(1,2)
LimitesVision(val(b:200)+2:130)

if Dialogo.Check1=1
  if Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1, NO, 'ARG')
     GrabarPMG('PFNEW', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
  else
     *- Elimina el AnteUltimo. Calculo el Dia a Eliminar
     acd(e211,HABILES(Dialogo.Fecha1,-2,'ARG',SI))

     SQL.ADD("Delete "~DBO~".OBJETOS Where ")
     SQL.ADD("Codigo='POSFIN' and Extension LIKE '%"~val(e211)~"%' ")
     SQL.NEW
     SQL.EXEC

     *- Graba el Ultimo 
     GrabarPMG('POSFIN', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
  endif
endif
