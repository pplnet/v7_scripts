CrearDialogo
    Radio1 : 'Clientes|Habilitados|DesHab|Todos' ;;;;;;;;;2;
FinDialogo

If Not Ok
   Cancelar
endif   

AgregarBMP(a1,Exe('LOGO'),80)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(e1, 'Fecha: '~Var('FECHASYS'))
SetFont(e:1,2)
if Dialogo.Radio1=0
    ACT(a3, 'Clientes habilitados')
else
    if Dialogo.Radio1=1
        ACT(a3, 'Clientes deshabilitados')
    else
    ACT(a3, 'Clientes habilitados y deshabilitados')
    endif
endif
SetFont(a:3,3)

act(aa1,VAR('JERCLINO'))

SQL.ADD("select Codigo, RazonSocial, ")
SQL.ADD("   case when Jerarquia like '001%' then 'Contraparte' else 'Cliente' end   Tipo, ")
SQL.ADD("   FechaApertura     FechaAlta, Status ")
SQL.ADD("from   "~DBO~".clientes c1 ")
SQL.ADD("where  1 = 1 ")
if Dialogo.Radio1=0
    SQL.ADD("and  Status = 'HAB' ")
else
    if Dialogo.Radio1=1
    SQL.ADD("and  Status = 'DES' ")
    endif    
endif    

Recorrer&i 1, Elementos(val(aa1))
    act(aa2,ItemLista(Val(aa1), &i))
    SQL.ADD("and  Jerarquia not like '"~val(aa2)~"%'")
Proximo
SQL.ADD("order by Jerarquia ")

SetFilaActual(fac+4)
ACT(a:fac,'Codigo')
ACT(b:fac,'Razon Social')
ACT(c:fac,'Tipo')
ACT(d:fac,'Fecha Alta')
if Dialogo.Radio1=2
   ACT(e:fac,'Status')
   AgregarMarco(a:fac..e:fac,2,0,Exe('COLOR'))
else
   AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR'))
endif
SetFont(a:fac..e:fac,2)
acn(w:1,fac+1)
Recorrer SQL
    if EsTerminal(fbn('Codigo'), Cliente)
        ACT(a:fac,FBN['Codigo'])
        ACT(b:fac,FBN['RazonSocial'])
        ACT(c:fac,FBN['Tipo'])
        if Vacio(fbn('FechaAlta'))
           ACT(d:fac,'')
        else
           ACT(d:fac,Fecha(fbn('FechaAlta'),'DD/MM/YYYY'))
        endif                 
        if Dialogo.Radio1=2
            ACT(e:fac,iif(Eqstr(FBN['Status'],'HAB'),'Habilitado',iif(Eqstr(FBN['Status'],'DES'),'Deshabilitado','')))
        endif
    else
        dfa
    endif
Proximo
SetFont(a:val(w:1)..e:fac,1)

ACO(1,10)
ACO(2,65)
ACO(3,10)
ACO(4,10)

IFA
IFA
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:fac..e:fac,2)


Limitesvision(f:fac)