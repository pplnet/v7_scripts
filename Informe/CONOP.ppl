*- Listado de Vencimientos con subtotales por Dia, Semana y Mes
ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  :'Vehiculo'   ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Fecha1     :'Conc.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;HABILES(Fsys,-30,VAR('FERIDEF')) 
  Fecha2     :'Conc.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
  Lista1     :'Tipos Op.'  ;;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo like 'MM%' ") 
  Lista2     :'Especies'   ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE  Tipo='MON' AND Status='HAB' ORDER BY Codigo ");
FinDialogo

if Not OK
  Cancelar
endif
&var:= 0
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
*ACT(1:1, 'SDADA')

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

*ACT(a:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(a2,3)

SetFilaActual(4)

ACT(a:FAC+1, 'Concertaciones De Money Market - Expresado en '~VAR('MONEEXTR'))
SetFont(a:FAC..a:FAC+1,3)

SetFilaActual(FAC+2)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
   ACT(a:FAC+1, 'Vehiculo: Todos')
endif
ACT(a:FAC+2, 'F.Conc.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Conc.Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista2)
   ACT(a:FAC+4, 'Monedas: '~Dialogo.Lista2)
   ACT(le1,Dialogo.Lista2)
else
   ACT(a:FAC+4, 'Monedas: Todas')
   ACT(le1,SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE  Tipo='MON' AND Status='HAB' ORDER BY Codigo "))

endif

ACT(a:FAC+5, 'Seleccion: Capital ')
SetFont(a:FAC+1..a:FAC+5,2)
SetFilaActual(fac+6)

ACN(w1,FAC)
SetFilaActual(FAC+1)
act(a:fac,'Fecha')
act(b:fac,'Plazo')

SetFont(a:FAC..d:FAC,2)
acn(y:400,fac)

SetFilaActual(FAC+1)

*** Arma la tabla de dias ***
Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
   if EsHabil(Dialogo.Fecha1+&i-1)
      acd(a:fac+&i-1, Dialogo.Fecha1+&i-1)
*      act(a:fac+&i+4,'Total Semanal')
      acn(b:fac+&i-1, &i-1)
      SetFont(a:fac+&i-1..b:fac+&i-1,2)
      FormatoCeldas(b:fac+&i-1..b:fac+&i-1, Exe('F0'))
   else
   *AgregarMarco(a:fac+&i-1..a:fac+&i-1,2,0)
   endif
Proximo

ACN(q:400,&i+15)

acn(w:400,fac)
*AgregarMarco(a:1..G:12,2,3,RGB(240,240,240))
ACT(z1, "FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and Especie IN ("~Pipe2Comillas(val(le1))~") ")

SQL.ADD("Select FechaOp Conc,Especie,")
SQL.ADD("-SUM(CASE TipoOp When 'MMDCOB' Then TotalBrutoCli1 When 'MMDIVA' Then -Cantidad When 'MMPF' Then -Cantidad When 'MMPFCE' Then -Cantidad When 'MMPFT' Then -Cantidad When 'MMPFM' Then -Cantidad When 'MMPFTV' Then -Cantidad When 'MMEPTA' Then -Cantidad When 'MMCT' Then -Cantidad When 'MMTO' Then -Cantidad Else Cantidad End) Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS B where ")
SQL.ADD(" O.NrOperacion=B.NrOperacion and B.Valor=0 and B.NrBit=30 and ")
SQL.ADD(" "~Val(z1)~" ")
SQL.ADD(" and O.Vehiculo1 =  '"~Dialogo.Vehiculo1~"'")
SQL.ADD(" and TipoOp Like 'MM%' and TipoOp Not In ('MMONM','MMONR') ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif
SQL.ADD("Group By Especie,FechaOp ")
SQL.ADD("Union ")
SQL.ADD("Select C.Fecha1 Conc,Especie,")
SQL.ADD("-SUM(-Cantidad4) Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS B,"~DBO~".CUOTAS C where ")
SQL.ADD(" O.NrOperacion=B.NrOperacion and B.Valor=0 and B.NrBit=30 and ")
SQL.ADD(" O.NrOperacion=C.NrOperacion and ")
SQL.ADD(" C.Fecha2 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and ")
SQL.ADD(" "~Val(z1)~" ")
SQL.ADD(" and O.Vehiculo1 =  '"~Dialogo.Vehiculo1~"'")
SQL.ADD("  and TipoOp In ('MMONM','MMONR') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
SQL.ADD("Group By Especie,C.Fecha1")
SQL.ADD("Order By Especie,Conc")


*** z:400 valor de la columna ***
acn(z:400,2)
ACT(X:400,' ')

Recorrer SQL

  Message(fbn['Conc']~'  '~fbn['Cant']~' '~fbn['Especie'])

  if Not EqStr(val(x:400),fbn['Especie'])
     scn(z:400,1)
     act(x:400,fbn['Especie'])

     *- Corte por Especies 
     act(val(z:400):val(y:400)-2,fbn['Especie'])

     act(val(z:400):val(y:400),fbn['Especie'])
     SetFont(val(z:400):val(y:400)..val(z:400):val(y:400),2)
     AgregarMarco(val(z:400):val(y:400)..val(z:400)+1:val(y:400),2,0,RGB(240,240,240))
  endif

  scn(val(z:400):val(w:400)+fbn['Conc']-Dialogo.Fecha1,fbn['Cant'])
  SetFont(val(z:400):val(w:400)+fbn['Conc']-Dialogo.Fecha1,1)
  acl(val(z:400):val(w:400)+fbn['Conc']-Dialogo.Fecha1,'OPEVTO',Vehiculo1=Dialogo.Vehiculo1,Fecha1=val(a:val(w:400)+fbn['Conc']-Dialogo.Fecha1),Fecha2=val(a:val(w:400)+fbn['Conc']-Dialogo.Fecha1),Lista1=Dialogo.Lista1,Especie1=val(val(z:400):val(y:400)-2),Radio1=0)
Proximo

*- x:400 Columna Total
ACN(x:400,val(z:400)+1)
act(val(x:400)  :val(w:400)-1,'Total Dia ('~VAR('MONEEXTR')~')') 
act(val(x:400)+1:val(w:400)-1,'Total Mes ')
*x:400 tiene que tener el valor 5

SetFont(val(x:400):val(w:400)-1..val(x:400)+1:val(w:400)-1,2)

FormatoCeldas(val(x:400):val(w:400)-1..val(x:400)+1:val(w:400)-1,Exe('F2'))
AgregarMarco(a:val(w:400)-1..val(x:400)+1:val(w:400)-1,2,0,RGB(240,240,240))

Recorrer&j 3, val(z:400)+1

   *- Recorro las Columnas
   If Not EqStr(val(&j:val(y:400)-2),val(val(x:400):val(y:400)-2)) o val(x:400)=3
      acn(x:401,CotizacionC(val(&j:val(y:400)-2),,,,Fsys,1,SI,VAR('MONEEXTR')))
   EndIf

   Message('Cotizacion '~val(&j:val(y:400)-2)~' '~Fstr(val(x:401),0,2))

   acn(x:402,val(y:400))

   *- x:403 Fila para sumar las semanas
   acn(x:403,val(w:400))

   Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
      *- Recorro las filas 
      If EsHabil(Dialogo.Fecha1+&i-1) y &j<=val(z:400)
         *- Total por Dia
         scn(val(x:400):val(w:400)+&i-1,val(&j:val(w:400)+&i-1)*val(x401))
         SetFont(val(x:400):val(w:400)+&i-1..val(x:400):val(w:400)+&i-1,1)

         *- Total por Vehiculo
         *scn(&j:val(y:400)-1,val(&j:val(w:400)+&i-1))  PARA QUE LOS TOTALES APAREZCAN ARRIBA DE LA TABLA
         scn(&j:val(q:400),val(&j:val(w:400)+&i-1))
         FormatoCeldas(&j:val(q:400)..&j:val(q:400),Exe('F2'))
         *ACT(&j:val(y:400)-1,'RLATGMLKÑN')
         *ACT(&j:val(q:400)+2,'RLATGMLKÑN')
      EndIf
      

      If DiaSem(Dialogo.Fecha1+&i-1)=7 
         acn(&j:val(w:400)+&i-1,Sum(&j:val(x:403)..&j:val(w:400)+&i-2))
         act(a:val(w:400)+&i-1,'TOTAL SEMANAL')
         SetFont(a:val(w:400)+&i-1,2)
** FJL 14/04/16 - Para Corregir Totales del mes
         acn(aa:val(w:400)+&i-1,-Sum(&j:val(x:403)..&j:val(w:400)+&i-2))         
         SetFont(&j:val(w:400)+&i-1..&j:val(w:400)+&i-1,2)
         acn(x:403,val(w:400)+&i)         
      EndIf
   Proximo 
Proximo

Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1

   If FinDeMes(Dialogo.Fecha1+&i-1)=Dialogo.Fecha1+&i-1 o &i=Dialogo.Fecha2-Dialogo.Fecha1+1
      *- Total por Mes
      scn(val(x:400)+1:val(w:400)+&i-1,Sum(val(x:400):val(x402)..val(x:400):val(w:400)+&i-1) )
      ** FJL 14/04/16 - Para Corregir Totales del mes
      scn(val(x:400)+1:val(w:400)+&i-1,Sum(aa:val(x402)..aa:val(w:400)+&i-1) )
      SetFont(val(x:400)+1:val(w:400)+&i-1..val(x:400)+1:val(w:400)+&i-1,2)
      FormatoCeldas(val(x:400)+1:val(w:400)+&i-1..val(x:400)+1:val(w:400)+&i-1,Exe('F2'))

      *- Fila del Mes Anterior 
      acn(x:402,val(w:400)+&i)
   EndIf

Proximo

Recorrer&i 3, val(x:400)+1
  ACO(&i,12)
Proximo

Recorrer&j val(z:400)+1,val(x:400)
   Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
     * Total General
     *scn(&j:val(y:400)-1,val(&j:val(w:400)+&i-1) ) PARA QUE LOS TOTALES APAREZCAN ARRIBA DE LA TABLA
     scn(&j:val(q:400),val(&j:val(w:400)+&i-1) )
     *ACT(&j:val(y:400)-1,'ASDASDASD')
     *ACT(&j:val(q:400)+2,'ASDASDASD')
** FJL 14/04/16 - Para Corregir Total general en USD
     *scn(&j:val(y:400)-1,val(aa:val(w:400)+&i-1) ) PARA QUE LOS TOTALES APAREZCAN ARRIBA DE LA TABLA
     scn(&j:val(q:400),val(aa:val(w:400)+&i-1) )
     
     *FormatoCeldas(&j:val(y:400)-1..&j:val(y:400)-1,Exe('F2')) PARA QUE LOS TOTALES APAREZCAN ARRIBA DE LA TABLA
     FormatoCeldas(&j:val(q:400)..&j:val(q:400),Exe('F2'))
   Proximo
Proximo

SetFont(a:val(y:400)-1..val(x:400):val(y:400)-1,2)
FormatoCeldas(c:val(w:400)..val(x:400):val(w:400)+Dialogo.Fecha2-Dialogo.Fecha1,Exe('F2') )
FormatoCeldas(a:val(y:400)-1..val(x:400):val(y:400)-1,Exe('F2') )
FormatoCeldas(val(x:400):val(w:400)-1..val(x:400)+1:val(w:400)-1,Exe('F2'))

*y:400 vale 13
BorrarCeldas(b:val(y:400)-2..val(x:400):val(y:400)-2)
ACO(1,15)
ACO(2,4)
*Comentar para la demo
 *FijarCol(3)
 *FijarFila(val(w:400))
Impresion(1,2)

SetFilaActual(val(w:400)+Dialogo.Fecha2-Dialogo.Fecha1+2)
ACT(a:FAC, 'TOTALES GENERALES')
AgregarMarco(a:FAC..F:FAC,2,3,RGB(240,240,240))
ACT(a:FAC+2, 'FIN DE LISTADO')
SetFont(a:FAC..a:FAC+2, 2)

*- c12: Datos a linkear desde PGC
AgregarMarco(a:13..a:fac,2,3,RGB(240,240,240))
LimitesVision(F:FAC+5)
*LimitesVision(val(x:400)+1:FAC)
*RangoTitulo(a1..k:8,36)

