ifa
Let &filaInicio FAC
ACT(A:FAC, 'Valor1')
ACN(B:FAC, 10)
ifa
ACT(A:FAC, 'Valor2')
ACN(B:FAC, 25)
ifa
ACT(A:FAC, 'Valor1')
ACN(B:FAC, 90)
ifa
ACT(A:FAC, 'Valor3')
ACN(B:FAC, 50)
let &filaFinal FAC
ifa

Let &nombre ''
let &inicioResultado fac
Recorrer&i &filaInicio, &filaFinal
If Not Incluido(Val(A:&i), &nombre)
    ACT(B:fac, Val(A:&i))
    ACN(C:fac, -Val(B:&i))
    let &nombre &nombre ~ '|'~Val(a:&i)
   ifa 
ELSE
    Recorrer&k &inicioResultado, fac
    IF EqStr(Val(A:&i),Val(B:&k))
        ACN(C:&k, Val(C:&k)+Val(B:&i))
    EndIf
    Proximo
ENDIF
Proximo
AgregarMarco(A:&inicioResultado..C:fac-1, 0, 0)
FormatoCeldas(A:&inicioResultado..C:fac-1, Exe('F2'))



