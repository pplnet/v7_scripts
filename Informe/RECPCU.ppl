CrearDialogo
  NrTrans1: 'Op.CUPON' ;;;;  ;;NoVacio(Dialogo.NrTrans1) y EqStr(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Dialogo.NrTrans1),'CUPON');'Transaccion incorrecta';NO
  Check1  : 'Procesa'  ;;;;NO;;;;;0
FinDialogo
if Not OK
  Cancelar
endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

IF NO
    *--------------- Insertar una transaccion para actualizar el saldo
    SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
    SQL.ADD(" Especie,    Especie2,      Cupon1,   CB5, ")
    SQL.ADD(" Fecha1,     Fecha2,        Cliente1, Cantidad1, ")
    SQL.ADD(" Precio1,    Precio2,       Precio3,  Cambio1, ")
    SQL.ADD(" Cambio2,    Vehiculo1,     TipoTr2,  NrTrans, ")
    SQL.ADD(" Mercado1,   Cuenta2,       Cuenta6,  Cuenta1, ")
    SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, Cupon2, ")
    SQL.ADD(" Cantidad4,  Cambio3,       Ley1 ")
    SQL.ADD(" ) VALUES ( ")
    * Especie
    SQL.ADD(" '"~Val(b2)~"', ")
    * Especie2
    SQL.ADD(" '"~Val(b4)~"', ")
    * Cupon1
    SQL.ADD(" '"~FStr(Val(c2),1,0)~"', ")
    * CB5
    If Round2(Val(e:3),3)=0
      SQL.ADD(" '1', ")
    Else
      SQL.ADD(" '0', ")
    Endif

    * Fecha1
    SQL.ADD(" '"~IdxDate(Val(g2))~"', ")
    * Fecha2
    SQL.ADD(" '"~IdxDate(Val(h:2))~"', ")
    * Cliente1
    SQL.ADD(" '"~Val(a:&i)~"', ")
    * Cantidad1
    SQL.ADD(" "~FStr(Val(g:&i),1,2)~", ")

    * Precio1
    SQL.ADD(" "~FStr(Val(k2),1,8)~", ")    
    * Precio2
    SQL.ADD(" "~FStr(Val(l2),1,8)~", ")
    * Precio3
    SQL.ADD(" "~FStr(Val(m2),1,8)~", ")
    * Cambio1
    SQL.ADD(" "~FStr(Val(e2),1,8)~", ")

    * Cambio2
    SQL.ADD(" "~FStr(Val(e3),1,8)~", ")
    * Vehiculo1
    SQL.ADD(" '"~VAL(j2)~"', ")
    * TipoTr2
    SQL.ADD(" 'CUPON', ")
    * NrTrans
    SQL.ADD(" '"~Val(Y1)~"', ")

    * Mercado1
    SQL.ADD(" '"~Val(d:&i)~"', " )
    * Cuenta2
    SQL.ADD(" '"~Val(f:&i)~"', ")
    * Cuenta6
    SQL.ADD(" '"~Val(f:&i)~"', ")
    * Cuenta1
    SQL.ADD(" '"~Val(m:&i)~"', ")

    * FechaCarga
    SQL.ADD(" "~SQLAhora~", ")
    * FechaCargaSys
    SQL.ADD(" '"~IdxDate(Fsys)~"', ")
    * UsrInput
    SQL.ADD(" '"~UsuarioActivo~"', ")
    * Cupon2
    SQL.ADD(" '"~FStr(Val(c4),1,0)~"', ")

    * Cantidad2
    SQL.ADD(" '"~FStr(Val(h:&i),1,0)~"', ")
    * Cambio3
    SQL.ADD(" "~FStr(Val(in1),1,8)~", ")
    * Ley1
    SQL.ADD(" '"~Val(BK:&i)~"' ")
    SQL.ADD(" ) ")
    SQL.NEW 
ENDIF

SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 ")
SQL.ADD(" where NrTrans = '"~Dialogo.NrTrans1~"' ")
recorrer SQL
  ** a:&i
  ACT(a:2, fbn('Cliente1'))
  ACD(g:2, fbn('Fecha1'))
  ACT(b:2, fbn('Especie'))
  ACN(c:2, fbn('Cupon1'))
  ACT(j:2, fbn('Vehiculo1'))
  ACN(k:2, fbn('Precio1'))
  ACN(l:2, fbn('Precio2'))
  ACN(m:2, fbn('Precio3'))
  ACN(c:3, fbn('Cupon2'))
  ACN(e:3, fbn('Cambio2'))
  ACN(b:4, fbn('Especie2'))
  ACT(Y1, fbn('NrTrans'))
proximo


Message('----- Corte de Posicion Propia')

SetFilaActual(0)
SQL.ADD(" SELECT P.CantidadFin, P.PrecioFin, P.Cliente, P.NrSaldo, P.TipoNegocio, P.NrSaldo, ")
SQL.ADD(" P.Vehiculo, P.Trader, E.Cotiza, E.InteresesC, E.TamanioLote, 'Ejecutado' Estado, P.Fecha FechaMov, ")
SQL.ADD(" P.Especie, P.Cupon, P.Book, P.CantidadIni, P.PrecioIni ")
SQL.ADD(" FROM  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE P.Cliente  = '"~Val(a:2)~"' ")
SQL.ADD(" AND   P.Especie  = E.Codigo ")
SQL.ADD(" AND   P.Fecha    <= '"~IdxDate(Val(g2))~"' ")
SQL.ADD(" AND   P.Vehiculo  = '"~Val(j2)~"' ")
SQL.ADD(" AND   P.Especie   = '"~Val(b2)~"' ")
SQL.ADD(" AND   P.Cupon     = "~FStr(Val(c2),1,0)~" ")
SQL.ADD(" AND   P.NrSaldo   >= 120 and P.NrSaldo < 140 ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES X")
SQL.ADD("                 WHERE  X.Cliente = P.Cliente ")
SQL.ADD("                 AND    X.Especie = P.Especie ")
SQL.ADD("                 AND    (X.TipoNegocio=P.TipoNegocio OR (X.TipoNegocio IS NULL AND P.TipoNegocio IS NULL)) ")
SQL.ADD("                 AND    X.Vehiculo     = P.Vehiculo ") 
SQL.ADD("                 AND    X.NrSaldo      = P.NrSaldo  ") 
*SQL.ADD("                 AND    (X.Trader=P.Trader OR (X.Trader IS NULL AND P.Trader IS NULL))  ") 
SQL.ADD("                 AND    X.Cupon        = P.Cupon    ") 
SQL.ADD("                 AND    X.Fecha       <= '"~IdxDate(Val(g2))~"') ")
SQL.ADD(" ORDER By E.Cotiza, P.Especie, P.Vehiculo, P.Cliente, P.Book, P.NrSaldo, FechaMov ")
Recorrer SQL
  Message('Posiciones ')

  ACD(aa:FAC, fbn('FechaMov'))
  ACT(ab:FAC, fbn('Especie'))
  ACT(ac:FAC, fbn('Cupon'))
  ACT(ad:FAC, fbn('Cliente'))
  ACT(ae:FAC, fbn('Vehiculo'))
  ACT(af:FAC, fbn('Book'))
  ACN(ag:FAC, fbn('CantidadIni'))
  ACN(ah:FAC, fbn('PrecioIni'))
  ACN(ai:FAC, fbn('CantidadFin'))
  ACN(aj:FAC, fbn('PrecioFin'))
  ACN(ak:FAC, SQL(" Select Count(*) from "~DBO~".MOVPOSPEN where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" "))
  ACN(al:FAC, SQL(" Select Count(*) from "~DBO~".MOVPOSEJE where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" "))

  if fbn('CantidadFin')<>0
    ACN(z1, fbn('CantidadFin'))
    ACN(z2, fbn('PrecioFin'))

    * Precio Final actualizado
    if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b2)),'CLE')
      ACN(z4, (Val(l2)+Val(k2)*Val(z2)+Val(m2))/100)
      ACN(z3, Val(z2))
    else
      ACN(z4, (Val(l2) + (Val(k2) * (Val(z2)-Val(l2)/100-Val(m2)/100)) + Val(m2))/100 )
      ACN(z3,  Val(z2) * (1 - Val(k2)/100) )
    endif 

    * Actualizar movimientos de posicion para la especie vieja
    *------ Posicion del Cliente ----------------*
    if Dialogo.Check1=1

      SQL.ADD(" DELETE "~DBO~".MOVPOSPEN where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" ")
      SQL.NEW
      SQL.ADD(" DELETE "~DBO~".MOVPOSEJE where NrOperacion = '"~Val(Y1)~"' and NrSaldo = "~FStr(FBN['NrSaldo'],1,0)~" ")
      SQL.NEW
      SQL.EXEC

      SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
      SQL.ADD("   Especie,  Cantidad,    NrOperacion, ")
      SQL.ADD("   FechaMov, Cliente,     Vehiculo, ")
      SQL.ADD("   NrSaldo,  Precio,      Cupon, ")
      SQL.ADD("   Tipo,     TipoNegocio, Trader, ")
      SQL.ADD("   Book ")
      SQL.ADD(" ) Values ( ")
      * Especie
      SQL.ADD("   '"~Val(b2)~"', ")
      SQL.ADD("   "~Fstr(val(z1)*(-1),1,2)~", ")
      SQL.ADD("   '"~Val(Y1)~"', ")

      SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
      SQL.ADD("   '"~FBN['Cliente']~"', ")
      SQL.ADD("   '"~FBN['Vehiculo']~"', ")

      SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
      SQL.ADD("   "~FStr(Val(z2),1,8)~", ")
      * Cupon
      SQL.ADD("   '"~FStr(Val(c2),1,0)~"', ")

      SQL.ADD("   '1', ")
      SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
      SQL.ADD("   '"~FBN['Trader']~"', ")

      SQL.ADD("   '' ")
      SQL.ADD(" ) ")
      SQL.NEW

      If Round2(Val(e:3),3)<>0
        * Actualizar movimientos de posicion para la especie nueva
        SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,  Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov, Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,  Precio,      Cupon, ")
        SQL.ADD("   Tipo,     TipoNegocio, Trader, ")
        SQL.ADD("   Book ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b2)~"', ")
        SQL.ADD("   "~Fstr(val(z1),1,2)~", ")
        SQL.ADD("   '"~Val(Y1)~"', ")

        SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        SQL.ADD("   "~FStr(Val(z3),1,8)~", ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c3),1,0)~"', ")

        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '' ")
        SQL.ADD(" ) ")
        SQL.NEW
      Endif

      If val(l2)+val(k2)<>0
        * Actualizar movimientos de posicion para el cupon
        SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ( ")
        SQL.ADD("   Especie,  Cantidad,    NrOperacion, ")
        SQL.ADD("   FechaMov, Cliente,     Vehiculo, ")
        SQL.ADD("   NrSaldo,  Precio,      Cupon, ")
        SQL.ADD("   Tipo,     TipoNegocio, Trader, ")
        SQL.ADD("   Book ")
        SQL.ADD(" ) Values ( ")
        * Especie
        SQL.ADD("   '"~Val(b4)~"', ")
        SQL.ADD("   "~Fstr(val(z1),1,2)~", ")
        SQL.ADD("   '"~Val(Y1)~"', ")

        SQL.ADD("   '"~IdxDate(Val(g2))~"', ")
        SQL.ADD("   '"~FBN['Cliente']~"', ")
        SQL.ADD("   '"~FBN['Vehiculo']~"', ")

        SQL.ADD("   "~FStr(FBN['NrSaldo'],1,0)~", ")
        SQL.ADD("   "~FStr(Val(z4),1,8)~",  ")
        * Cupon
        SQL.ADD("   '"~FStr(Val(c2),1,0)~"', ")

        SQL.ADD("   '1', ")
        SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
        SQL.ADD("   '"~FBN['Trader']~"', ")

        SQL.ADD("   '' ")
        SQL.ADD(" ) ")
        SQL.NEW
      endif 
      SQL.EXEC
    endif 
  endif 
Proximo
