ModoReproceso(SinDialogo)
HojaVisible(NO)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'MMO');'El TipoOp debe ser MMO';NO;;;;;;" TipoOp in ('MMO') "
  Directorio1: 'Path carta'        ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1) Y EqStr(Dialogo.String1,Var('FILECACMMO'));'Debe ingresar un documento';NO;Var('FILECACMMO')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo,  O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   
   let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente1'])
   let &fecha_larga FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)
   let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
   let &numero_cuenta BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])
   let &simbolo_especie IIF(fbn['Especie'] = 'ARP','$',IIF(fbn['Especie'] = 'USD','u$s',fbn['Especie']))
   
   EmitirCartaVisible(Dialogo.Directorio1~Dialogo.String1, Copy(Dialogo.String1, 1,Longitud(Dialogo.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, cuenta = &numero_cuenta, especie = &simbolo_especie, monto = PYC(fbn['Cantidad'],1,2), plazo = fbn['Plazo'], t_n_a = fbn['Precio1'])
  
Proximo