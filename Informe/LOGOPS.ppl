CrearDialogo
  Fecha1:'F.Desde';;;;;;;;;FSys
  Fecha2:'F.Hasta';;;;;;;;;FSys
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')

SetFilaActual(1)
ImportarWKS(ba1..bb1,a1..b1,'CIERRE.WKS')
if Val(bb1)=1
  ACT(h:FAC, 'CIERRE DEL DIA '~Dialogo.Fecha1~'  Nr. '~FStr(Val(ba1),3,0))
  SetFont(h:FAC,3)
endif
SetFilaActual(4)
ACT(a:FAC,'Log file de Operaciones')
ACT(a:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+2,'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a:FAC..a:FAC+2,2)

SetFilaActual(FAC+4)
ACT(a:FAC,'Operaciones modificadas anteriores al '~Dialogo.Fecha1)
ACT(a:FAC+2,'Operador')
ACT(b:FAC+2,'Fecha y hora')
ACT(d:FAC+2,'# Op')
ACT(e:FAC+2,'Tipo Op')
ACT(f:FAC+2,'Especie')
ACT(g:FAC+2,'Fecha Op')
ACT(i:FAC+1,'Modificacion')
ACT(h:FAC+2,'Campo')
ACT(i:FAC+2,'Anterior')
ACT(j:FAC+2,'Actual')
SetFont(a:FAC..j:FAC+2,2)
AgregarMarco(h:FAC+1..j:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(a:FAC+2..j:FAC+2,2,0,Exe('COLOR'))
SetFilaActual(FAC+2)
ACN(x1,FAC+1)
Message('Operaciones ant. modificadas')
SQL.ADD("select * from "~DBO~".PMAUDIT A where Fecha > '"~IdxDate(Dialogo.Fecha1)~"' and Fecha < '"~IdxDate(Dialogo.Fecha2+1)~"'")
SQL.ADD(" and Accion = 'M' and Tabla = 'OPERACIONES' and '"~IdxDate(Dialogo.Fecha1)~"' > (Select FechaOp from "~DBO~".OPERACIONES where NrOperacion = A.Codigo) order by Fecha, Codigo")
recorrer SQL
  ACN(x2,0)
  if Not EqStr(Val(z1), FieldByName['Codigo']~FieldByName['Fecha'])
    ACT(z1,    FieldByName['Codigo']~FieldByName['Fecha'])
    ACT(a:FAC, FieldByName['Operador'])
    ACT(b:FAC, FieldByName['Fecha'])
    ACT(d:FAC, FieldByName['Codigo'])
    ACT(e:FAC, BuscarCampo('OPERACIONES','TipoOp' , 'NrOperacion', Val(d:fac)))
    ACT(f:FAC, BuscarCampo('OPERACIONES','Especie', 'NrOperacion', Val(d:fac)))
    ACT(g:FAC, BuscarCampo('OPERACIONES','FechaOp', 'NrOperacion', Val(d:fac)))
  endif
  SCN(x2,1)
  ACT(h:FAC, FieldByName['Campo'])
  ACT(i:FAC, FieldByName['ValorAnterior'])
  ACT(j:FAC, FieldByName['ValorActual'])
proximo
SetFont(a:Val(x1)..j:FAC,1)
AgregarMarco(a:Val(x1)..j:FAC, 1)

ACT(j:FAC+1, ' ')
SetFilaActual(FAC+3)
ACT(a:FAC,'Operaciones modificadas del per¡odo')
ACT(a:FAC+2,'Operador')
ACT(b:FAC+2,'Fecha y hora')
ACT(d:FAC+2,'# Op')
ACT(e:FAC+2,'Tipo Op')
ACT(f:FAC+2,'Especie')
ACT(g:FAC+2,'Fecha Op')
ACT(i:FAC+1,'Modificacion')
ACT(h:FAC+2,'Campo')
ACT(i:FAC+2,'Anterior')
ACT(j:FAC+2,'Actual')
SetFont(a:FAC..j:FAC+2,2)
AgregarMarco(h:FAC+1..j:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(a:FAC+2..j:FAC+2,2,0,Exe('COLOR'))
SetFilaActual(FAC+2)
ACN(x1,FAC+1)
Message('Operaciones del periodo modificadas')
SQL.ADD("select * from "~DBO~".PMAUDIT A where (Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2+1)~"')")
SQL.ADD(" and Accion = 'M' and Tabla = 'OPERACIONES' and Codigo = (Select NrOperacion from "~DBO~".OPERACIONES where NrOperacion = A.Codigo and FechaOp between '"~IdxDate(Dialogo.Fecha1-1)~"' and '"~IdxDate(Dialogo.Fecha2+1)~"') order by Fecha, Codigo")
recorrer SQL
  ACN(x2,0)
  if Not EqStr(Val(z1), FieldByName['Codigo']~FieldByName['Fecha'])
    ACT(z1,    FieldByName['Codigo']~FieldByName['Fecha'])
    ACT(a:FAC, FieldByName['Operador'])
    ACT(b:FAC, FieldByName['Fecha'])
    ACT(d:FAC, FieldByName['Codigo'])
    ACT(e:FAC, BuscarCampo('OPERACIONES','TipoOp' , 'NrOperacion', Val(d:fac)))
    ACT(f:FAC, BuscarCampo('OPERACIONES','Especie', 'NrOperacion', Val(d:fac)))
    ACT(g:FAC, BuscarCampo('OPERACIONES','FechaOp', 'NrOperacion', Val(d:fac)))
  endif
  SCN(x2,1)
  ACT(h:FAC, FieldByName['Campo'])
  ACT(i:FAC, FieldByName['ValorAnterior'])
  ACT(j:FAC, FieldByName['ValorActual'])
proximo
SetFont(a:Val(x1)..j:FAC,1)
AgregarMarco(a:Val(x1)..j:FAC,1)
ACT(j:FAC+1, ' ')

SetFilaActual(FAC+3)
ACT(a:FAC,'Operaciones borradas anteriores al '~Dialogo.Fecha1)
ACT(a:FAC+2,'Operador')
ACT(b:FAC+2,'Fecha y hora')
ACT(d:FAC+2,'# Op')
ACT(e:FAC+2,'Tipo Op')
ACT(f:FAC+2,'Especie')
ACT(g:FAC+2,'Fecha Op')
ACT(h:FAC+2,'Cliente1')
ACT(i:FAC+2,'Cliente2')
ACT(j:FAC+2,'Cantidad')
ACT(k:FAC+2,'Precio1')
SetFont(a:FAC..k:FAC+2,2)
*AlinearCeldas(j:FAC+2..k:FAC+2,'D')
AgregarMarco(a:FAC+2..k:FAC+2,2,0,Exe('COLOR'))
SetFilaActual(FAC+2)
ACN(x1,FAC+1)
Message('Operaciones ant. eliminadas')
SQL.ADD("select ValorAnterior, Codigo, Fecha, Operador from "~DBO~".PMAUDIT where Fecha > '"~IdxDate(Dialogo.Fecha1)~"' and Fecha < '"~IdxDate(Dialogo.Fecha2+1)~"'")
SQL.ADD(" and Accion = 'B' and Tabla = 'OPERACIONES' and Campo = 'FechaOp'")
recorrer SQL
  dfa
  if Fecha(FieldByName['ValorAnterior']) < Dialogo.Fecha1
    ifa
    ACT(a:FAC, FieldByName['Operador'])
    ACT(b:FAC, FieldByName['Fecha'])
    ACT(d:FAC, FieldByName['Codigo'])
    recorrer ("select * from "~DBO~".PMAUDIT where Codigo = '"~Val(d:fac)~"'")
      dfa
      if EqStr(FieldByName['Campo'],'TipoOp')
        ACT(e:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Especie')
        ACT(f:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'FechaOp')
        ACT(g:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cliente1')
        ACT(h:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cliente2')
        ACT(i:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cantidad')
        ACT(j:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Precio1')
        ACT(k:fac, FieldByName['ValorAnterior'])
      endif
    proximo
  endif
proximo
SetFont(a:Val(x1)..k:FAC,1)
FormatoCeldas(j:Val(x1)..j:FAC,',2')
FormatoCeldas(k:Val(x1)..k:FAC,',5')
AgregarMarco(a:Val(x1)..k:FAC,1)
ACT(k:FAC+1, ' ')

SetFilaActual(FAC+3)
ACT(a:FAC,'Operaciones borradas del per¡odo')
ACT(a:FAC+2,'Operador')
ACT(b:FAC+2,'Fecha y hora')
ACT(d:FAC+2,'# Op')
ACT(e:FAC+2,'Tipo Op')
ACT(f:FAC+2,'Especie')
ACT(g:FAC+2,'Fecha Op')
ACT(h:FAC+2,'Cliente1')
ACT(i:FAC+2,'Cliente2')
ACT(j:FAC+2,'Cantidad')
ACT(k:FAC+2,'Precio1')
SetFont(a:FAC..k:FAC+2,2)
*AlinearCeldas(j:FAC+2..k:FAC+2,'D')
AgregarMarco(a:FAC+2..k:FAC+2,2,0,Exe('COLOR'))
SetFilaActual(FAC+2)
ACN(x1,FAC+1)
Message('Operaciones del periodo eliminadas')
SQL.ADD("select ValorAnterior, Codigo, Fecha, Operador from "~DBO~".PMAUDIT where Fecha > '"~IdxDate(Dialogo.Fecha1)~"' and Fecha < '"~IdxDate(Dialogo.Fecha2+1)~"'")
SQL.ADD(" and Accion = 'B' and Tabla = 'OPERACIONES' and Campo = 'FechaOp'")
recorrer SQL
  dfa
  if Fecha(FieldByName['ValorAnterior']) > Dialogo.Fecha1-1 y Fecha(FieldByName['ValorAnterior']) < Dialogo.Fecha2+1
    ifa
    ACT(a:FAC, FieldByName['Operador'])
    ACT(b:FAC, FieldByName['Fecha'])
    ACT(d:FAC, FieldByName['Codigo'])
    recorrer ("select * from "~DBO~".PMAUDIT where Codigo = '"~Val(d:fac)~"'")
      dfa
      if EqStr(FieldByName['Campo'],'TipoOp')
        ACT(e:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Especie')
        ACT(f:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'FechaOp')
        ACT(g:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cliente1')
        ACT(h:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cliente2')
        ACT(i:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Cantidad')
        ACT(j:fac, FieldByName['ValorAnterior'])
      endif
      if EqStr(FieldByName['Campo'],'Precio1')
        ACT(k:fac, FieldByName['ValorAnterior'])
      endif
    proximo
  endif
proximo
SetFont(a:Val(x1)..k:FAC,1)
FormatoCeldas(j:Val(x1)..j:FAC,',2')
FormatoCeldas(k:Val(x1)..k:FAC,',5')
AgregarMarco(a:Val(x1)..k:FAC,1)
ACT(k:FAC+1, ' ')

ACO(1,10)
ACO(2,12)
ACO(3,1)
ACO(4,6)
ACO(5,6)
ACO(6,6)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)

LimitesVision(k:FAC+1)
AgregarBMP(a1, Exe('LOGO'), 20)
