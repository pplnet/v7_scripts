* DESCUB - LISTA ACUERDOS UTILIZADOS EN CC
CrearDialogo
  Vehiculo1  : "Grupo"          ;1;1;;Vacio(Dialogo.Lista2);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista2     : "Vehiculo"       ;1;2;;Vacio(Dialogo.Vehiculo1);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Cliente1   : "Contraparte"    ;2;1;;;;;;;
  Fecha5     : "F.Vigencia"     ;2;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Cuenta1    : "Cta Bancaria"   ;3;1;;;;;;;
  Especie1   : "Moneda"     ;4;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where Jerarquia Like '"~Var('JERMONEDA')~"%' ")
  Fecha1     : "F.Op.Desde" ;5;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;PriDeMes(Fsys, SI);
  Fecha2     : "F.Op.Hasta" ;5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FinDeMes(FSYS, SI);
  Fecha3     : "F.Vto.Desde";6;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;PriDeMes(Fsys, SI);
  Fecha4     : "F.Vto.Hasta";6;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';NO;FinDeMes(FSYS, SI);
  Radio1     : "Consolidado|Si|No";8;1;;;;;;;1
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")

SetFilaActual(1)


ACT(B:1, "Intereses Descubiertos")
SetFont(b:1,3)

SetFilaActual(3)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~' - '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  If NoVacio(Dialogo.Lista2)
    ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Lista2)
  Else 
    ACT(a:FAC+1, 'Vehiculo : Todos')
  EndIf
endif
SetFont(a:Fac+1,2)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cuenta Bancaria : '~Dialogo.Cuenta1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif
SetFont(a:Fac+3,2)

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Contraparte : '~Dialogo.Cliente1)
else
  ACT(a:FAC+4, 'Contraparte : Todas')
endif
SetFont(a:Fac+4,2)

ACT(a:FAC+5, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(c:FAC+5, 'Ope.Hasta : '~Dialogo.Fecha2)
ACT(a:fac+6, 'Vto.Desde : '~Dialogo.Fecha3)
ACT(c:FAC+6, 'Vto.Hasta : '~Dialogo.Fecha4)
SetFont(a:Fac+5..c:Fac+5,2)
SetFont(a:Fac+6..c:Fac+6,2)

ACT(a:FAC+7, 'Consolidado : '~iif(Dialogo.Radio1 = 1,'No','Si'))

SetFont(a:FAC+7, 2)


SetFilaActual(FAC+9)

ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "Contraparte")
ACT(C:FAC, " Cuenta")
ACT(D:FAC, "Monto Pactado")
ACT(E:FAC, "Moneda")
ACT(F:FAC, "Nº MMDPAC")
ACT(G:FAC, "Tasa")
ACT(H:FAC, "Plazo")
ACT(I:FAC, "Nº MMDC")
ACT(J:FAC, "FechaOp")
ACT(K:FAC, "Monto Consumido")
ACT(L:FAC, "Plazo")
ACT(M:FAC, "FechaVto")
ACT(N:FAC, "Int.Total")
ACT(O:FAC, "Int.Devengado")
AlinearCeldas(a:FAC..c:FAC,'I')
AlinearCeldas(d:FAC..d:FAC,'D')
AlinearCeldas(E:FAC..F:FAC,'C')
AlinearCeldas(g:FAC..h:FAC,'D')
AlinearCeldas(I:FAC..J:FAC,'C')
AlinearCeldas(K:FAC..K:FAC,'D')
AlinearCeldas(L:FAC..M:FAC,'C')
AlinearCeldas(N:FAC..O:FAC,'D')
SetFont(a:FAC..O:FAC, 2)
AgregarMarco(a:FAC..O:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)
*************---------- VAL(Z1) ----------***************
if NoVacio(Dialogo.Especie1)
  ACT(z1, "O.Especie = '"~Dialogo.Especie1~"' and ")
endif

if NoVacio(Dialogo.Cliente1)
  ACT(z1, Val(z1)~"O.Cliente1 = '"~Dialogo.Cliente1~"' and ")
endif

if NoVacio(Dialogo.Cuenta1)
  ACT(z1, Val(z1)~"O.Cuenta1 = '"~Dialogo.Cuenta1~"' and ")
endif

if NoVacio(Dialogo.Lista2)
  ACT(z1, Val(z1)~"O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista2)~") and ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    ACT(z1, Val(z1)~"O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")  and ")
  endif
EndIf


ACT(z1, Val(z1)~"O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and ")
ACT(z1, Val(z1)~"((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")
******************************-------------- CONSULTAS -------------------*********************************
***---DECUBIERTO EN CC (MMDC)
If Dialogo.Radio1 = 1
    SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,")
Else
    SQL.ADD("SELECT 'Consolidado' Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,")
EndIf 

SQL.ADD("O.TipoOp,O.Cantidad,O.Cuenta1,O.Plazo,O.NrOperacion, O.TotalIntereses,O.Precio1,O.OperacionRef, ") 
SQL.ADD(" C.Codigo, C. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION T ") 
SQL.ADD(" WHERE  V.Codigo = O.Vehiculo1")
IF NoVacio(Dialogo.Cuenta1)
    SQL.ADD(" AND O.Cuenta1 = '"~Dialogo.Cuenta1~"' ")
ENDIF
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND C.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")
SQL.ADD(" AND O.TipoOp = 'MMDC' ")
*-----------------------------------------------------------------------------****

SQL.ADD(" Order by 1")
ACT(xx:1, '')
Recorrer SQL
  If Not EqStr(FBN['Vehiculo1'], Val(xx:1)) Y Not CeldaVacia(xx:1)  
    SetFilaActual(FAC+1)
    ACT(A:FAC, "Vehiculo")
    ACT(B:FAC, "Contraparte")
    ACT(C:FAC, " Cuenta")
    ACT(D:FAC, "Monto Pactado")
    ACT(E:FAC, "Moneda")
    ACT(F:FAC, "Nº MMDPAC")
    ACT(G:FAC, "Tasa")
    ACT(H:FAC, "Plazo")
    ACT(I:FAC, "Nº MMDC")
    ACT(J:FAC, "FechaOp")
    ACT(K:FAC, "Monto Consumido")
    ACT(L:FAC, "Plazo")
    ACT(M:FAC, "FechaVto")
    ACT(N:FAC, "Int.Total")
    ACT(O:FAC, "Int.Devengado")
    AlinearCeldas(a:FAC..c:FAC,'I')
    AlinearCeldas(d:FAC..d:FAC,'D')
    AlinearCeldas(E:FAC..F:FAC,'C')
    AlinearCeldas(g:FAC..h:FAC,'D')
    AlinearCeldas(I:FAC..I:FAC,'C')
    AlinearCeldas(K:FAC..K:FAC,'D')
    AlinearCeldas(L:FAC..M:FAC,'C')
    AlinearCeldas(J:FAC..J:FAC,'C')
    AlinearCeldas(N:FAC..O:FAC,'D')
    SetFont(a:FAC..O:FAC,2)
    AgregarMarco(a:FAC..O:FAC,2,0,Exe('COLOR'))      
    SetFilaActual(FAC+1)  
  EndIf

  ACT(a:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',FBN['Vehiculo1']),1,25))
  * ACT(b:fac, FBN['Cliente1'])
  ACT(B:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,29))
  ACT(c:fac, FBN['Cuenta1'])
  ACN(d:FAC, BuscarCampo('Operaciones','Cantidad','NrOperacion',FBN['OperacionRef'] ))
  ACT(e:fac, FBN['Especie'])
 
  ACT(F:FAC, FBN['OperacionRef'])
  ACLO(F:FAC, FBN['OperacionRef'])
  ACN(G:FAC, BuscarCampo('Operaciones','Precio1','NrOperacion',FBN['OperacionRef'] ))
  ACT(H:FAC, Copy(BuscarCampo('Operaciones','Plazo','NrOperacion',FBN['OperacionRef'] ),1,6))                                                           
  
  ACT(i:FAC, FBN['NrOperacion'])
  ACLO(i:FAC, FBN['NrOperacion'])
  ACD(J:fac, FBN['FechaOp'])
  ACN(K:fac, FBN['Cantidad'])
  ACT(L:fac, FBN['Plazo']) 
  ACD(M:fac, FBN['FechaVto'])
  ACN(N:fac, FBN['TotalIntereses'])
  ACN(O:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND M.Fecha <='"~IdxDate(Dialogo.Fecha5)~"' AND M.TipoDevengado = 'INTLEN' AND M.NrSaldo = '140'  "))
 
  SCN(Z:7, FBN['Cantidad'])
  SCN(Z:8, FBN['TotalIntereses'])
  SCN(Z:9, val (O:FAC))
  
  SetFont(a:FAC..O:FAC,1)
  AlinearCeldas(a:FAC..c:FAC,'I')
  AlinearCeldas(d:FAC..d:FAC,'D')
  AlinearCeldas(E:FAC..F:FAC,'C')
  AlinearCeldas(g:FAC..g:FAC,'D')
  AlinearCeldas(H:FAC..J:FAC,'C')
  AlinearCeldas(K:FAC..K:FAC,'D')
  AlinearCeldas(L:FAC..M:FAC,'C')
  AlinearCeldas(N:FAC..O:FAC,'D')
 
  FormatoCeldas(D:fac..D:fac,Exe('F2'))
  FormatoCeldas(K:fac..K:fac,Exe('F2'))
  FormatoCeldas(N:fac..O:fac,Exe('F2'))
  ACT(xx:1, FBN['Vehiculo1'])
proximo

SetFilaActual(FAC+2)

* SetFont(a:Val(FI:1)..Q:FAC,1)
FormatoCeldas(K:Val(FI:1)..K:fac,Exe('F2'))

ACO(1,16)
ACO(2,21)
ACO(3, 10) 
ACO(4,10)
ACO(5,5) 
ACO(6,8) 
ACO(7,4) 
ACO(8,6)
ACO(9,8)
ACO(10,6)
ACO(11,11)
ACO(12,5)
ACO(13,6)
ACO(14,9)
ACO(15,9)

Impresion(1,2)

act(a:fac,'Total General Intereses Descubiertos: ')
* ACN(K:fAC, VAL(z:7))
ACN(N:fAC, VAL(z:8))
acn(O:fac, Val(z:9))
AgregarMarco(a:fac..O:fac,1,0,RGB(192,192,192))
SetFont(a:fac..O:fac,2)
AlinearCeldas(N:FAC..O:FAC,'D')
FormatoCeldas(K:fac..O:fac,Exe('F2'))

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,3)

LimitesVision(O:FAC+1)
RangoTitulo(a:1..O:FAC, Val(w1)+9)
SetMargins(0.5, 1.5, 0.5, 2)
SetPrintFit(3, 81)

