ModoReproceso(SINDIALOGO)
CrearDialogo
     Fecha1   :'F.Op.Desde'  ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una F.Op. Desde' ;NO;FSys-30;
     Fecha2   :'F.Op.Hasta'  ; ; ;;;;Dialogo.Fecha2<>0;'Debe Ingresar una F.Op. Hasta' ;NO;FSys;
     Cliente1 : 'Emisor'     ; ; ;;;;;;
     Vehiculo1:'Vehiculo'    ; ; ;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
     Lista1  : 'Especie'     ; ; ;;;;;;;;;SQLSet("Select Codigo from "~DBO~".Especies ")
     Radio1  :  'Operatoria  |Mayorista  |Minorista| Ambos ';2;2;;NO;NO;;;;2;
     Radio2  :  'Tramo |Competitivo   |No Competitivo|Ambos';3;2;;NO;NO;;;;2;
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AgregarBMP(a1,Exe('LOGO'),80)
SetFilaActual(3)

ACT(a:fac,' Emisiones')
SetFont(a:fac,3)

SetFilaActual(fac+2)
if NoVacio(Dialogo.Cliente1)
  ACT(a:fac,'Emisor:')
  ACT(b:fac,'('~Dialogo.Cliente1~') '~COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1),1,25))
else
  ACT(a:fac,'Emisor:')
  ACT(b:fac,'Todos')
endif
SetFont(a:fac..b:fac,2)
ifa

if NoVacio(Dialogo.Lista1)
   ACT(a:fac,'Especie:')
   ACT(b:fac,'('~Dialogo.Lista1~') '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Lista1))
else
   ACT(a:fac,'Especies:')
   ACT(b:fac,'Todas')
endif
SetFont(a:fac..b:fac,2)
ifa

ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..b:fac,2)
ifa

ACT(a:fac,'Instancia')
ACT(b:fac,'Operacion')
ACT(c:fac,'FechaOp')
ACT(d:fac,'FechaVto')
ACT(e:fac,'Emisor')
ACT(f:fac,'Nombre')
ACT(g:fac,'Tramo')
ACT(h:fac,'Operatoria')
ACT(i:fac,'Especie')
ACT(j:fac,'Nombre especie')
ACT(k:fac,'Cantidad')
ACT(l:fac,'Precio/Tasa/')
ACT(l:fac+1,'Margen Dif')
ACT(m:fac,'Precio Fijo')
ACT(n:fac,'Tipo')
ACT(o:fac,'CantAdjudicada') 
ACT(p:fac,'C.Esp.')
ACT(q:fac,'Monto a Liq')
ACT(r:fac,'Vehiculo')
act(s:fac,'F.Susc')
act(s:fac+1,'Desde')
act(t:fac,'F.Susc  ')
act(t:fac+1,'Hasta')
act(u:fac,'Precio')
act(u:fac+1,'RefMin')
act(v:fac,'Precio')
act(v:fac+1,'RefMax')
act(w:fac,'Fecha')
act(w:fac+1,'Adjudic.')
act(x:fac,'Hora')
act(x:fac+1,'Adjudic.')


AlinearCeldas(a:fac..x:fac+1,'C')
SetFont(a:fac..x:fac+1,2)
AgregarMarco(a:fac..x:fac+1,1,0,Exe('COLOR6'))
ifa
ACN(z:1,fac)
SQL.ADD("SELECT R.RB5 as Posturas,R.RB1 As tramo,R.RB6 as Operatoria, Plazo2 as Exposicion, R.TotalNetoCli3, ")
SQL.ADD("R.Observac2 as Destinatarios,R.Observac3 as Sistema,MensajeChequeo as DatosPro, ")
SQL.ADD("R.Especie,R.NrOperacion,R.ContraEspecie,R.Cliente1,R.Lotes,R.Precio4,R.RB8,")
SQL.ADD("R.FechaOp,R.FechaVto,R.FechaOp2 BookBDesde,R.FechaPago BookBHasta,R.Cantidad,I.Nombre NomInst, ")
SQL.ADD("R.Precio2 PrecioRefMin,R.Precio3 PrecioRefMax,R.TipoCambio2 TasaMin,R.TipoCambio3 TasaMin,")
SQL.ADD("R.TotalNetoCli1 CantDisp,R.Precio2,R.TotalBrutoCli1,R.CB10,R.FechaVto2 FAdjudicacion,R.ObservacDoc HAdjudicacion,C.RazonSocial,R.Vehiculo1,B.NrBit")
SQL.ADD("FROM   "~DBO~".OPERACIONES R , "~DBO~".OPERACIONESBITS B,"~DBO~".CLIENTES C, "~DBO~".INSTANCIAS I  ")
SQL.ADD("WHERE  R.NrOperacion = B.NrOperacion ")  
SQL.ADD("and    R.Cliente1  = C.Codigo ")  
if NoVacio(Dialogo.Cliente1)
SQL.ADD("and    R.cliente1 = '"~Dialogo.Cliente1~"'   ")
endif
SQL.ADD("and    R.FechaOp  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD("and    B.Valor = '1'  ")
SQL.ADD("and    B.NrBit = I.NrInstancia  ")
SQL.ADD("and    I.Tabla='OPERACIONES'  ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and    R.Especie='"~Dialogo.Lista1~"'   ")
EndIf 
SQL.ADD("and    R.TipoOp IN ('TCPCEM')    ")
*SQL.ADD("and    R.RB6 = '"~FSTR(Dialogo.Radio1,1,0)~"'   ")   
*SQL.ADD("and    R.RB1 = '"~FSTR(Dialogo.Radio2,1,0)~"'   ")   
SQL.ADD("Order  By R.NrOperacion ")
watch(SQL.BAtch())
acn(aa:1,fac+1)
Recorrer SQL
*  act(a:fac,SQL("Select Nombre from "~DBO~".INSTANCIAS where NrInstancia="~FStr(fbn('NrBit'),1,0)~" AND Tabla='OPERACIONES' "))
  act(a:fac,FBN['NomInst'])
  act(b:fac,FBN['NrOperacion'])
  aclo(b:fac,fbn['NrOperacion'])
  acd(c:fac,FBN['FechaOp'])
  acd(d:fac,FBN['FechaVto'])
  act(e:fac,FBN['Cliente1'])
  act(f:fac,Copy(FBN['RazonSocial'],1,25))
  ACT(g:fac,''~IIF(FBN['Tramo']=0,'Competitivo',IIF(FBN['Tramo'] = 1,'No Competitivo','Ambos')) ) 
  ACT(h:fac,''~IIF(FBN['Operatoria']=0,'Mayorista',IIF(FBN['Operatoria'] = 1,'Minorista','Ambas')) ) 
  act(i:fac,FBN['Especie'])
  ACT(j:fac,BuscarCampo('ESPECIES','Nombre','Codigo',FBN['ESPECIE']))
  If NOVACIO(fbn('TotalNetoCli3')) y fbn('TotalNetoCli3')>FBN['Cantidad']
    acn(k:fac,fbn('TotalNetoCli3'))
  ELSE
    acn(k:fac,FBN['Cantidad'])
  Endif
  acn(l:fac,FBN['Precio2'])
  acn(m:fac,FBN['Precio4'])
  FormatoCeldas(i:fac..j:fac,EXE('F8'))
  act(n:fac,iif(fbn('RB8')=0,'Precio','Tasa') )
  acn(o:fac, fbn('TotalNetoCli3')-FBN['CantDisp'])
  act(p:fac,FBN['ContraEspecie'])
  acn(q:fac,FBN['TotalBrutoCli1'])
  act(r:fac,FBN['Vehiculo1'])
  acd(s:fac,FBN['BookBDesde'])
  acd(t:fac,FBN['BookBHasta'])
  acn(u:fac,FBN['PrecioRefMin'])
  acn(v:fac,FBN['PrecioRefMax'])
  acd(w:fac,FBN['FAdjudicacion'])
  act(x:fac,FBN['HAdjudicacion'])
  SetFont(a:fac..x:fac,1) 
Proximo

