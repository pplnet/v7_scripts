CrearDialogo
  Fecha1     : "Fecha"            ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  NrOperacion: "Partida"          ;2;1;;;;NoVacio(Dialogo.NrOperacion);'Debe ingresar una Partida';NO;;;;;;" TipoOp IN ('PARTID') ";
  Lista1     : "Especies"         ;;;;;;;;;;;SQLSET("Select Codigo from "~DBO~".ESPECIES WHERE "~DBO~".DesciendeDeEspecie(Codigo,'TITULO') = 1");;;;;
  Especie1   : "Moneda Emision" ;;;;;;;;;
  Especie2   : "Moneda Expresion"   ;;;;;;;;;
FinDialogo 


if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,15,B")

*Cintia 240223 Comento este bloque ya que el TC dependerá de la contraespecie de cada TIC/TIV
**---Tipo de Cambio
ACT(EX:1,Dialogo.Especie2)
ACT(EM:1,Dialogo.Especie1)

If EqStr(VAL(EM:1),VAL(EX:1))
    ACN(TC:3,1)
    *    ACT(a:FAC, 'Tipo Cambio : '~val(TC:1))
Else
    ACN(TC:3,CotizacionC(val(EM:1),,,,Dialogo.Fecha1,25,SI,VAL(EX:1)))
    *ACT(a:FAC, 'Tipo Cambio : '~Fstr(CotizacionC(val(EX:1),,,,Dialogo.Fecha1,25,SI,VAL(EM:1)),0,8))
EndIf
*

SetFilaActual(1)
ACT(a:fac, 'Resultado por Ventas de la partida '~Dialogo.NrOperacion~' al día '~Dialogo.Fecha1)
SetFont(a:fac,3)
IFA
IFA
ACT(a:fac,"Precio partida: ")
ACN(b:fac,SQL("SELECT Precio1 FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~Dialogo.NrOperacion~"'")*Val(TC:3))
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
if NoVacio(Dialogo.Lista1)
  ACT(a:FAC, 'Especies : '~Dialogo.Lista1)
else
  ACT(a:FAC, 'Especies : Todos')
endif
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, 'Moneda Expresion : '~Dialogo.Especie2)
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, 'Moneda Emision : '~Dialogo.Especie1)
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, Dialogo.NrOperacion)
ACLO(a:fac, Dialogo.NrOperacion)
FormatoCeldas(b:fac,Exe('F9'))
IFA

FormatoCeldas(b:fac,Exe('F2'))
SetFont(a:FAC..b:FAC,2)
IFA
IFA
ACT(A:FAC, "Nr Operacion")
ACT(b:FAC, "Cantidad")
ACT(c:FAC, "Fecha")
ACT(d:FAC, "Tipo Op")
ACT(e:FAC, "Precio Op")
ACT(f:FAC, "Resultado")
ACT(g:fac, "Res Acumulado")

SetFont(a:FAC..g:FAC,2)
AgregarMarco(a:FAC..g:FAC,2,0,Exe('COLOR'))

SQL.ADD(" Select * FROM "~DBO~".PARTIDAS ")
SQL.ADD(" Where NrPartida = '"~Dialogo.NrOperacion~"' and FechaDesde <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" ORDER By TipoAct, FechaDesde, NrOperacion")
watch(SQL.batch)
ACN(aa:1,0)
**Cintia 240223 - Administracion de Partidas -  Issue 6089
ACT(EX:1,Dialogo.Especie2)
ACT(EM:1,Dialogo.Especie1)
**TC Para Resultado y Res Acumulado
If EqStr(VAL(EX:1),Val(EM:1))
        ACN(TC:2,1)
Else
    ACN(TC:2,CotizacionC(val(EM:1),,,,Dialogo.Fecha1,25,SI,Val(EX:1)))
EndIf
