* ---> Impresion Del Informe De Preliquidacion
ModoReproceso(SinDialogo)
CrearDialogo
   Especie3   :'Especie'  ;1;1;;;;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3,'TITULO') y NOT DesciendeDeEspecie(Dialogo.Especie3,'CUPON');'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' "
   Especie1   :'Esp.Cupon'; ;1;;NO;;NoVacio(Dialogo.Especie3);'Debe Ingresar una Especie Cupon';NO;;BuscarCampo('ESPECIES','Alias9','Codigo',Dialogo.Especie3);;;;"Status = 'HAB' "
   Entero1    :'Nr.Cupon' ; ;1;;  ;;Dialogo.Entero1>=0;'Debe Ingresar el Numero de Cupon';NO;0;Num(BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1))
   Vehiculo1  :"Vehiculo" ; ;1;;  ;;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
FinDialogo
If Not OK
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACO( 1, 8)
ACO( 2, 8)
ACO( 3, 8)
ACO( 4, 17)
ACO( 5, 11)
ACO( 6, 11)
ACO( 7, 9)
ACO( 8, 9)
ACO( 9, 9)
ACO(10, 9)

SetFilaActual(1)
ACT(a:fac, CodigoInforme)
ACT(g:fac,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(a:FAC.. l:fac, 1)

SetFilaActual(3)
ACT(a:fac,'Totales por Especie de Pago de Cupon')
SetFont(a:fac,3)

SetFilaActual(fac+2)
ACT(a:fac,'Especie :  '~Dialogo.Especie3~' - '~BuscarCampo('ESPECIES','Extendido','Codigo',Dialogo.Especie3))
ifa
ACT(a:fac,'Esp.Cupon :  '~Dialogo.Especie1~' - '~BuscarCampo('ESPECIES','Extendido','Codigo',Dialogo.Especie1))
ifa
ACT(a:fac,'Cupon :  '~Fstr(Dialogo.Entero1,0,0))
ifa
ACT(a:fac,'Vehiculo :  '~Dialogo.Vehiculo1)
SetFont(a:5..c:fac,2)


SetFilaActual(fac+2)
acn(w1,fac)
ACT(a:fac,'Numero')
ACT(b:fac,'Tipo')
ACT(c:fac,'Esp.Cupon')
ACT(d:fac,'Nr.Cupon')
ACT(e:fac,'Moneda Cotiza')
ACT(f:fac,'Moneda Pago')
ACT(g:fac,'Precio Cupon')
ACT(h:fac,'Tipo Cambio')
ACT(i:fac,'Fecha Pago')
ACT(j:fac,'Fecha Ingreso')
AgregarMarco(a:fac..j:fac,2,0,Exe('COLOR12'))
SetFont(a:fac..j:fac,2)
AlinearCeldas(a:fac..j:fac,'C')


SQL.ADD("Select T.*, E.Extendido ")
SQL.ADD("  from "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
SQL.ADD(" where T.Especie   = E.Codigo ")
SQL.ADD("   and T.TipoTr2   = 'LCUPON' ")
SQL.ADD("   and T.Especie   = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and T.Cupon1    = '"~Fstr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("   and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" order by NrTrans ")

Recorrer SQL
   act(a:fac, fbn('NrTrans'))
   act(b:fac, fbn('TipoTr2'))
   act(c:fac, fbn('Especie'))
   act(d:fac, fbn('Cupon1'))
   act(e:fac, fbn('Especie4'))
   act(f:fac, fbn('Especie2'))
   acn(g:fac, fbn('Cambio1'))
   acn(h:fac, fbn('Precio4'))
   acd(i:fac, fbn('Fecha1',0))
   acd(j:fac, fbn('FechaCarga',0))
   aclt(a:fac, fbn('NrTrans'))
   AgregarMarco(a:fac..a:fac,2,0,Exe('COLOR6'))
   SetFont(a:fac..j:fac,2)
   FormatoCeldas(g:fac,Exe('F7'))
   ifa

   ACT(b:fac, 'Mercado')
   ACT(c:fac, 'Cliente')
   ACT(d:fac, 'Cuenta')
   ACT(e:fac, 'Titulo/Moneda')
   ACT(f:fac, 'Cant. Cupones')
   ACT(g:fac, 'Efectivo')
   ACT(h:fac, 'Leyenda')


   AgregarMarco (b:fac..j:fac, 2, 1, Exe('COLOR'))
   AlinearCeldas(b:fac..j:fac, 'C')
   SetFont(b:fac..j:fac, 2)
  
   SQL.ADD("SELECT 1 Tipo,M.* ")
   SQL.ADD("FROM   "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("WHERE  M.NrOperacion = '"~fbn('NrTrans')~"'  ")
   SQL.ADD("AND  M.NrSaldo NOT IN (81) ")
   *SQL.ADD("  and  M.NrSaldo     = 101 ")
   SQL.ADD("Union")
   SQL.ADD("SELECT 2 Tipo,M.* ")
   SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("WHERE  M.NrOperacion = '"~fbn('NrTrans')~"' ")
   SQL.ADD("AND  M.NrSaldo NOT IN (81) ")
   *SQL.ADD("  and  M.NrSaldo     = 101 ")
   SQL.ADD("Order by M.Mercado, M.Cliente, M.Cuenta ")  

   acn(y:3,0)
   acn(y:4,0)
   Recorrer SQL
      ACT(b:fac, fbn('Mercado'))
      ACT(c:fac, fbn('Cliente'))
      ACT(d:fac, fbn('Cuenta'))
      ACT(e:fac, fbn('Especie'))
* FJL 26/04/20 - Los Saldos en garantia (102) los mostraba en la columna de Efvo
*      If fbn('NrSaldo') = 101
      If fbn('NrSaldo') >= 101
         ACN(f:fac, fbn('Cantidad'))
      Else
         ACN(g:fac, fbn('Cantidad'))
      Endif
      ACT(h:fac, fbn('Leyenda'))      
      scn(y:3, val(f:fac))
      scn(y:4, val(g:fac))
   
      SetFont(b:fac..g:fac, 1)
      FormatoCeldas(f:fac..g:fac,Exe('F2'))
   Proximo

   ifa
   act(d:fac, 'Totales : ')
   ACN(f:fac, val(y:3))
   ACN(g:fac, val(y:4))
   SetFont(d:fac..g:fac, 2)
   FormatoCeldas(f:fac..g:fac,Exe('F2'))

   ifa
   ifa
Proximo

ifa
ifa
act(a:fac,"FIN DEL LISTADO")
SetFont(a:fac..a:fac,2)

LimitesVision(l:fac)
Impresion(1, 2)
SetPrintFit(3, 71)
