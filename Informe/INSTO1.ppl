CrearDialogo
  Instancia1: 'Instancia'   ;;;;;;NoVacio(Dialogo.Instancia1);;;;;;;; "Tabla = 'OPERACIONES' "
  Fecha1    : 'F.Desde'     ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha2    : 'F.Hasta'     ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;


FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")


***Insertar Logo
let &filaLogo 1
@LOGO

ACN(FI:1, fac)

ACT(a:fac, 'Instancias de Operaciones')

SetFilaActual(5)
ifa

ACT(a:fac, 'F.Desde: '~Dialogo.Fecha1)
ifa
ACT(a:fac, 'F.Hasta: '~Dialogo.Fecha2)
ifa
ACT(a:fac, 'Instancia: '~Dialogo.Instancia1)
ifa
ifa
**Columnas
ACT(a:fac, 'NrOperacion')
ACT(b:fac, 'Fecha Op.')
ACT(c:fac, 'Fecha Vto.')
ACT(d:fac, 'Especie')
ACT(e:fac, 'Tipo Op.')
ACT(f:fac, 'Cliente')
ACT(g:fac, 'Cantidad')
ACT(h:fac, 'Precio/Tasa')
ACT(i:fac, 'Total')
ACT(j:fac, 'Vehiculo')
ACT(k:fac, 'Operador')
SetFont(A:Val(FI:1)..K:fac, 2)
AlinearCeldas(A:fac..K:fac, 'C')
AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR'))

ACN(FI:1, fac)
**Query
SQL.ADD("Select OB.NrBit, TipoOp, O.NrOperacion, FechaOp, FechaVto, Especie, FechaEj, PrecioEj, PaseCB, Cliente1, Cantidad, Precio1, Vehiculo1, Operador, Arbitraje, CB5, 'REAL' as Tipo, TotalAux3, Cantidad, TotalNetoCli1, TotalBrutoCli1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB where O.NrOperacion=OB.NrOperacion AND OB.Valor='1' and ")
SQL.ADD(" OB.NrBit= '"~Dialogo.Instancia1~"' ")

Recorrer SQL

  ACT(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('FechaOp'))
  ACT(c:fac, fbn('FechaVto'))
  if Incluido(Copy(fbn('TipoOp'),1,2), 'DT|DP')
    ACT(c:fac, fbn('FechaEj'))
  endif
  if Incluido(fbn('TipoOp'), 'DSEO|DFXO')
    ACT(c:fac, fbn('FechaEj'))
  endif
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('TipoOp'))
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('PaseCB')=1
    ACT(e:fac, Val(e:fac)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('CB5')=1
    ACT(e:fac, Val(e:fac)~' (Of.)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(e:fac, Val(e:fac)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(e:fac, Val(e:fac)~' x Arb.')
  endif
  ACT(f:fac, fbn('Cliente1'))
  ACN(g:fac, fbn('Cantidad'))
  if Incluido(fbn('TipoOp'), 'DTSFVM|DTSVVM|DTSFFM|DTCAP|DTFLO|')
  ACN(g:fac, fbn('TotalAux3'))
  EndIf
  
    ******Totales

  IF Incluido(FBN['TipoOp'], 'TRANSF')
    ACN(i:FAC, FBN['Cantidad'])
  Else
     IF Incluido(FBN['TipoOp'], 'FCS|FCR')
        ACN(i:FAC, FBN['TotalNetoCli1'])
     Else
        If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'MM')
            ACN(i:FAC, FBN['Cantidad'])
        Else
            ACN(i:FAC, FBN['TotalBrutoCli1'])
        EndIf
     EndIf
  EndIf
  
  ACN(h:fac, fbn('Precio1'))
  ACT(j:fac, fbn('Vehiculo1'))
  ACT(k:fac, fbn('Operador'))
  AlinearCeldas(b:fac..c:fac,'D')
  FormatoCeldas(h:fac..h:fac,Exe('F7'))
  ACLO(a:fac,Val(a:fac))

Proximo

Paginar(Val(FI:1), fac, 20)

ACO(1,14)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,8)
ACO(6,10)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,6)
ACO(11,6)
ACO(12,8)
ACO(13,20)
ACO(14,8)

SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:fac, 2)
LimitesVision(l:fac)