MostrarCuadroDeMensajes
CrearDialogo
    Fecha1   : 'Fecha '  ;;;;;;Dialogo.Fecha1 <= FSYS;'Debe ingresar una Fecha valida';NO;FSys
    Especie1 : 'Moneda'  ;;;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una moneda valida';;;;;;;"Tipo = 'MON' "
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)
ACT(a:fac,'Cotizaciones de Cierres de Banco Nacion')
SetFont(a:fac,3)

ACT(a:fac+1,'Fecha : '~Fecha(Dialogo.Fecha1))
SetFont(a:fac+1..d:fac+2,2)

SetFilaActual(fac+4)
ACT(a:fac,'Moneda')
ACT(b:fac,'Fecha')
ACT(c:fac,'Tipo Comprador')
ACT(d:fac,'Tipo Vendedor')
SetFont(a:fac..d:fac,2)
AgregarMarco(a:fac..d:fac,1,2,Exe('COLOR7'))
AlinearCeldas(b:fac, 'C')
AlinearCeldas(c:fac..d:fac,'D')

ACN(w1,fac+1)

SQL.ADD(" Select E.Codigo,C.Fecha,C.PrecioCompra, C.PrecioVenta,C.PorCada ")
SQL.ADD(" From "~DBO~".CIERREBNA C ,"~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Tipo = 'MON' and E.Codigo <> 'MONEDA'")
SQL.ADD("   and E.Codigo = C.Especie ")
If NoVacio(Dialogo.Especie1)  
  SQL.ADD(" and E.Codigo = '"~Dialogo.Especie1~"'")
Endif
SQL.ADD("   and C.Fecha= (Select Max(C2.Fecha) From "~DBO~".CIERREBNA C2 ")
SQL.ADD("                  Where (C2.Fecha <= "~Idxdate2(Dialogo.Fecha1)~") ")
If NoVacio(Dialogo.Especie1)  
  SQL.ADD("                  and C2.Especie = '"~Dialogo.Especie1~"'")
Endif
SQL.ADD("                    and C2.Especie = C.Especie ")
SQL.ADD("                    and C2.Especie = E.Codigo) ")
SQL.ADD(" Order BY E.Codigo")

Recorrer SQL
  ACT(a:fac,FBN['Codigo'])
  ACT(b:fac,FBN['Fecha'])
  If EqStr(FBN['PorCada'],'100')
    ACN(c:fac,FBN['PrecioCompra']/100)
    ACN(d:fac,FBN['PrecioVenta']/100)
  Else
    ACN(c:fac,FBN['PrecioCompra'])
    ACN(d:fac,FBN['PrecioVenta'])
  EndIf
Proximo
SetFont(a:Val(w1)..d:fac,1)
FormatoCeldas(c:Val(w1)..d:fac+2,EXE('F7'))
AlinearCeldas(b:Val(w1)..b:fac+2,'C')
AgregarMarco(a:Val(w1)..d:fac,1,2)

ACT(a:fac+2,'Fin del Informe')

SetFont(a:fac+2..a:fac+2,2)
LimitesVision(e:fac+3)
Impresion(1,1)
Impresion(4,1)

ACO(1,6)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,2)

RangoTitulo(a:7..e:fac, 1)
