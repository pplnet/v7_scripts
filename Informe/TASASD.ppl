ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1   : 'Desde';1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar Fecha';NO;FSys
  Fecha2   : 'Hasta';2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar Hasta';NO;FSys
  Especie1 : 'Especie';1;2;;;;;;
  Entero1  : 'De_Plazo';3;2;;;;;;;0
  Entero2  : 'A_Plazo' ;4;2;;;;;;;0
FinDialogo

if Not OK
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")

SetFilaActual(3)
ACT(a:fac, 'Tasas dia por rango de fechas')
SetFont(a:fac,3)

SetFilaActual(4)
ACT(a:fac+1, 'Especie : '~Dialogo.Especie1)
ACT(a:fac+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:fac+3, 'F.Hasta: '~Dialogo.Fecha2)
SetFont(a:fac+1..a:fac+3,2)

SetFilaActual(fac+5)
ACT(a:fac,'Fecha')
ACT(b:fac,'Especie')
ACT(c:fac,'TipoTasa')
ACT(d:fac,'Plazo_Desde')
ACT(e:fac,'Plazo_Hasta')
ACT(f:fac,'Valor1')
ACT(g:fac,'Valor2')
ACT(h:fac,'Valor3')
ACT(i:fac,'Valor4')
ACT(j:fac,'Valor5')
AlinearCeldas(a:fac..c:fac,'C')
AlinearCeldas(d:fac..j:fac,'D')
SetFont(a:fac..j:fac,2)
AgregarMarco(a:fac..j:fac,2,0,Exe('COLOR'))

ACN(w1,fac+1)

message('Recuperando TASASDIA....')
SQL.ADD("Select * From "~DBO~".TASASDIA ")
SQL.ADD(" Where Fecha Between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
Endif
*If NoVacio(Dialogo.TipoTasa1)
*  SQL.ADD(" and TipoTasa = '"~Dialogo.TipoTasa1~"' ")
*Endif
If Dialogo.Entero1 > 0
  SQL.ADD(" and PlazoDesde >= "~Fstr(Dialogo.Entero1,0))   
Endif
If Dialogo.Entero2 > 0
  SQL.ADD(" and PlazoHasta <= "~Fstr(Dialogo.Entero2,0))   
Endif
SQL.ADD("Order by TipoTasa,Fecha,Especie,PlazoDesde,PlazoHasta ")

Recorrer SQL
   message('...'~fbn['TipoTasa']~'-'~fbn['Especie'])
   ACD(a:fac,fbn['Fecha'])
   ACT(b:fac,fbn['Especie'])
   ACT(c:fac,fbn['TipoTasa'])
   If NoVacio(fbn['PlazoDesde'])
     ACN(d:fac,fbn['PlazoDesde'])
   Endif
   If NoVacio(fbn['PlazoHasta'])
     ACN(e:fac,fbn['PlazoHasta'])
   Endif
   ACN(f:fac,fbn['Valor1'])
   ACN(g:fac,fbn['Valor2'])
   ACN(h:fac,fbn['Valor3'])
   ACN(i:fac,fbn['Valor4'])
   ACN(j:fac,fbn['Valor5'])
Proximo

SetFont(a:Val(w1)..j:fac,1)
AlinearCeldas(a:Val(w1)..c:fac,'C')

ACO(1,6)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,8)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,8)
ACO(11,1)

Impresion(1,1)

SetFilaActual(fac+2)
ACT(a:fac, 'Fin del informe')
SetFont(a:fac,2)

FormatoCeldas(f:Val(w1)..j:fac, Exe('F8'))
FormatoCeldas(d:Val(w1)..e:fac, Exe('F0'))

LimitesVision(k:fac)

RangoTitulo(a:1..j:fac, Val(w1))
SetPrintFit(3,95)