AgregarMarco(f9..i:fac,1)
AgregarMarco(a:fac+1..i:fac+1,1,0,Exe('COLOR'))

recorrer&i 10, fac
  ACN(c:&i, Val(c:&i)/Val(b:&i))
  ACN(g:&i, Val(g:&i)/Val(f:&i))
  if Val(d:&i) >= 0
    if Val(c:&i)>Val(d:&i)
      ACT(e:&i, 'Excedido')
      ColorCeldas(e:&i,clRED)
    else
      ACT(e:&i, 'OK')
      ColorCeldas(e:&i,clGREEN)
    endif
  endif
  if Val(h:&i) >= 0
    if Val(g:&i)>Val(h:&i)
      ACT(i:&i, 'Excedido')
      ColorCeldas(i:&i,clRED)
    else
      ACT(i:&i, 'OK')
      ColorCeldas(i:&i,clGREEN)
    endif
  endif
proximo

