AgregarMarco(i9..i9,1)


CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z9, 1)

ACT(a10, 'Depositos a plazo')
ACN(d:10, LimAsignado('VINCULADOS', 'DPMATMAXPR', 'ARP'))
ACN(h:10, LimAsignado('VINCULADOS', 'DPMATMAXPR', 'USD'))
AgregarMarco(a10..i10,1,0,RGB(192,192,192))

SetFilaActual(10)

SQL.ADD("Select Especie, Cantidad, NrOperacion, TipoOp, Cliente1, Plazo,FechaOp,FechaVto from "~DBO~".OPERACIONES where ")
SQL.ADD(" TipoOp in ('MMCDIA','MMCDP','MMCP','MMCPM','MMD','MMDCA','MMCCR','MMO')")
SQL.ADD("and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo1 in ("~Val(z11)~")")
endif
SQL.ADD("order by Cliente1")
recorrer SQL
  dfa
  if Incluido(fbn('TipoOp'),'MMCDIA|MMCDP|MMCP|MMCPM|MMO')
     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMCPM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        if Incluido(fbn('Especie'), 'ARP')
           ACN(y1, 0)
        else
           ACN(y1, 1)
        endif
     endif
  endif
  if Incluido(fbn('TipoOp'),'MMDCA|MMCCR')
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        if Incluido(fbn('Especie'), 'ARP')
           ACN(y1, 0)
        else
           ACN(y1, 1)
        endif
     endif
  endif

  if Incluido(fbn('TipoOp'),'MMD')
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        if Incluido(fbn('Especie'), 'ARP')
           ACN(y1, 0)
        else
           ACN(y1, 1)
        endif
     endif
  endif

  acd(ad1,FBN['FechaOp'])
  acd(ad2,FBN['FechaVto'])

  *- Calculo del Plazo Remanente
  If FBN['FechaOp']<Dialogo.Fecha1
     acd(ad1,Dialogo.Fecha1)
  EndIf

  *- ad3: Plazo Remanente
  acn(ad3,val(ad2)-val(ad1))     

  *MessageBox('Plazo Remanente '~fbn('Cliente1')~' '~fstr(val(ad3),0,2))

  if Not EqStr(fbn('Cliente1'), Val(a:fac)) y Val(z3) > 0
     ifa
     ACT(a:fac, fbn('Cliente1'))
     ACN(d:fac, LimAsignado('VINCULADOS', 'DPMATMAX', 'ARP'))
     ACN(h:fac, LimAsignado('VINCULADOS', 'DPMATMAX', 'USD'))
     SCN(2+Val(y1)*4:fac, Val(z3))
     SCN(3+Val(y1)*4:fac, Val(z3)*val(ad3)/365)
     SCN(2+Val(y1)*4:10 , Val(z3))
     SCN(3+Val(y1)*4:10 , Val(z3)*val(ad3)/365)
  else
     SCN(2+Val(y1)*4:fac, Val(z3))
     SCN(3+Val(y1)*4:fac, Val(z3)*val(ad3)/365)
     SCN(2+Val(y1)*4:10 , Val(z3))
     SCN(3+Val(y1)*4:10 , Val(z3)*val(ad3)/365)
  endif

proximo



BorrarCeldas(x1..x1)
ifa
ACT(a:fac, 'Trading / T.Publicos')
ACN(d:fac, LimAsignado('VINCULADOS', 'TRMATMAXPR', 'ARP'))
ACN(h:fac, LimAsignado('VINCULADOS', 'TRMATMAXPR', 'USD'))
AgregarMarco(a:fac..i:fac,1,0,RGB(192,192,192))
ACN(w1, fac)

SQL.ADD("Select Codigo, Cotiza, Fecha from "~DBO~".ESPECIES where Tipo='PUB' order by Codigo")

recorrer SQL

  dfa
  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)

  *- ab1: Nro. Cartera
  ACN(ab1,113)

  (.'LPOSSMATMA'.)
  (.'LPOSFUTURO'.)

  if [Val(z1)>0 o Val(z8)>0] y Val(z1)/1000+Val(z8) > 0
     Message(fbn('Codigo')~' '~FStr(Val(z1),1,0)~' '~FStr(Val(z8),1,0))
     if Not EqStr(fbn('Codigo'), Val(a:fac))
        ifa
        ACT(a:fac, fbn('Codigo'))
    endif
    if EqStr(fbn('Cotiza'), 'ARP') 
       ACN(b:fac, (Val(z8)+Val(z1))*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
       ACN(c:fac, abs(Val(b:fac))*(fbn('Fecha')-Dialogo.Fecha1)/365)
       ACN(d:fac, LimAsignado('VINCULADOS', 'TRMATMAX', 'ARP'))
    else
       ACN(f:fac, (Val(z8)+Val(z1))*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
       ACN(g:fac, abs(Val(f:fac))*(fbn('Fecha')-Dialogo.Fecha1)/365)
       ACN(h:fac, LimAsignado('VINCULADOS', 'TRMATMAX', 'USD'))
    endif
  endif

proximo

ACN(b:Val(w1), SUM(b:Val(w1)+1..b:fac))
ACN(c:Val(w1), SUM(c:Val(w1)+1..c:fac))
ACN(f:Val(w1), SUM(f:Val(w1)+1..f:fac))
ACN(g:Val(w1), SUM(g:Val(w1)+1..g:fac))



