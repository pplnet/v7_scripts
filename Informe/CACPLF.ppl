ModoReproceso(SinDialogo)
HojaVisible(NO)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1), 'MMCPM');'El TipoOp debe ser MMCPM';NO;;;;;;" TipoOp in ('MMCPM') "
  Directorio1: 'Path cartas'   ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1) Y EqStr(Dialogo.String1,Var('FILECACPLF'));'Debe ingresar un documento';NO;Var('FILECACPLF')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)



SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo, O.FechaVto, O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL

   let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Vehiculo1'])
   let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
   let &simbolo_especie IIF(EqStr(fbn['Especie'],'ARP'),'$',IIF(EqStr(fbn['Especie'],'USD'),'u$s',fbn['Especie'] ) )
   let &numero_cuenta BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1'])
   let &fecha_vto fbn['FechaVto']
   let &tna PYC(BuscarCampo('CUOTAS','Precio2','NrOperacion', Dialogo.NrOperacion1),1,2)
   let &fecha_larga FStr(Dia(fbn['FechaOp']),1,0)~' de '~Meses(Mes(fbn['FechaOp']))~' de '~FStr(Anio(fbn['FechaOp']),4,0)
   
   EmitirCartaVisible(Dialogo.Directorio1~Dialogo.String1, Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, numero_cuenta = &numero_cuenta, especie = &simbolo_especie, monto = Fstr(fbn('Cantidad'),1,2), plazo = fbn['Plazo'], fecha_vto = &fecha_vto, t_n_a = &tna)
Proximo
