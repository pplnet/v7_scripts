AgregarMarco(a:val(aa1)..val(aa3)*2+1:val(aa1)+17,1)
AgregarMarco(a:val(aa1)+1..val(aa3)*2+1:val(aa1)+16,1  )

AgregarMarco(a:val(aa1)..val(aa3)*2+1:val(aa1),1,0,EXE('COLOR'))

Recorrer&i 1,18
   ACT(A:val(aa2)+&i-1, val(A:val(aa1)+&i-1))
Proximo

SetFont(a:val(aa2), 1)
SetFont(a:val(aa2)+17, 1)
SetFont(a:val(aa2)+1..a:val(aa2)+16, 2)

AgregarMarco(a:val(aa2)..val(aa3)*2+1:val(aa2)+17,1)
AgregarMarco(a:val(aa2)+1..val(aa3)*2+1:val(aa2)+16,1 )

AgregarMarco(a:val(aa2)..val(aa3)*2+1:val(aa2),1,0,EXE('COLOR'))


Recorrer&i 1,(val(aa5)-1) div (val(aa3) * 2) + 1

   Recorrer&j 1,val(aa3)
      if val(26+(&i-1)*val(aa3)*2+(&j-1)+1:100) >= Dialogo.Fecha1
         ACD(1+&j*2:val(aa1),val(26+(&i-1)*val(aa3)*2+(&j-1)+1:100))

         Recorrer&k 1,17
            ACT(&j*2:&k+val(aa1), '$')
            ACN(1+&j*2:&k+val(aa1), val(26+(&i-1)*val(aa3)*2+(&j-1)+1:100+&k))
            
            If val(1+&j*2:&k+val(aa1))=0
              ACT(1+&j*2:&k+val(aa1), '-')
            EndIf

            If &k+val(aa1) <> 9 y &k+val(aa1) <> 25
              Asignarlink(1+&j*2:&k+val(aa1),'PRCAC1', Vehiculo1=Dialogo.Vehiculo1, Especie1=Dialogo.Especie1, Fecha1=val(1+&j*2:val(aa1)), Fecha2=val(1+&j*2:val(aa1)), Lista1=Dialogo.Lista1, Entero1=100+&k)
            EndIf
         Proximo
      endif

      if val(26+(&i-1)*val(aa3)*2+(&j-1)+val(aa3)+1:100) >= Dialogo.Fecha1
         ACD(1+&j*2:val(aa2),val(26+(&i-1)*val(aa3)*2+(&j-1)+val(aa3)+1:100))

         Recorrer&k 1,17
            ACT(&j*2:&k+val(aa2), '$')
            
            ACN(1+&j*2:&k+val(aa2),     val(26+(&i-1)*val(aa3)*2+(&j-1)+val(aa3)+1:100+&k))
            If val(1+&j*2:&k+val(aa2))=0
              ACT(1+&j*2:&k+val(aa2), '-')
            Endif

            If &k+val(aa2) <> 31 y &k+val(aa2) <> 47 
              Asignarlink(1+&j*2:&k+val(aa2),'PRCAC1', Vehiculo1=Dialogo.Vehiculo1, Especie1=Dialogo.Especie1, Fecha1=val(1+&j*2:val(aa2)), Fecha2=val(1+&j*2:val(aa2)), Lista1=Dialogo.Lista1, Entero1=100+&k)
            EndIf
         Proximo
      endif
   Proximo

   setfont(B:val(aa1)..val(aa3)*2+1:val(aa2)+18, 2)
   AlinearCeldas(B:val(aa1)..val(aa3)*2+1:val(aa2)+18, 'D')
Proximo


