EndIf

*message(val(li:1))

ACN(aa5, DifDias(Dialogo.Fecha1, Dialogo.Fecha2,'ARG', SI)+1)

*****
* COPIADO DE DATOS AL FONDO DE LA PLANILLA
*****

**
** Esta transaccion se generara con un evento al fin de dia
** 
**

********************************************************************************
************* Ajustes No Operativos ********************************************
********************************************************************************

SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad) as Cantidad                               ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.Add(" AND   M.Cuenta  IN ("~val(li:1)~")                                           ")
SQL.ADD(" Group By M.FechaMov                                                         ")
SQL.ADD(" UNION ALL                                                                      ")
SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad) as Cantidad                               ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPENDIENTES M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.Add(" AND   M.Cuenta IN ("~val(li:1)~")                                            ")
SQL.ADD(" Group By M.FechaMov                                                         ")


Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:102, fbn['Cantidad'])
Proximo 

********************************************************************************************
**** Nueva busqueda por SaldosDia
********************************************************************************************

SQL.ADD("SELECT SUM(S1.Saldo) Saldo")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) ")
SQL.ADD("WHERE  S1.Especie = '"~Dialogo.Especie1~"'")
SQL.ADD("  AND  S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  AND  S1.Cliente = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  AND  S1.Cuenta   in ("~val(li:1)~") ")
SQL.ADD("  AND  S1.NrSaldo in (1,5,100)       ")
SQL.ADD("  AND  S1.Fecha = (SELECT MAX(S2.Fecha) FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND                             ")
SQL.ADD("                        S2.Especie = S1.Especie AND                             ")
* FJL 05/12/18 - Las monedas no tienen cupon y no encontraba nada
*SQL.ADD("                        S2.Cupon = S1.Cupon AND                                 ")
* FJL 16/03/26 - Issue 9153 - Dieferncia por cupon Vacio el 31/05/2023
*SQL.ADD("                       (S2.Cupon    = S1.Cupon OR (S2.Cupon  IS NULL AND S1.Cupon IS NULL) ) AND ")
SQL.ADD("                        IsNull(S2.Cupon,'') = IsNull(S1.Cupon,'') AND                                 ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND                   ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND                             ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND                             ")
SQL.ADD("                        S2.Cuenta  = S1.Cuenta AND                               ")
SQL.ADD("                        S2.Fecha   < '"~IdxDate(Dialogo.Fecha1)~"' )              ")
SQL.ADD(" UNION ALL ")
SQL.ADD("SELECT SUM(-S1.Cantidad) Saldo")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES  S1 WITH (NOLOCK),"~DBO~".OPERACIONES O WITH (NOLOCK)")
SQL.ADD("WHERE  S1.NrOperacion=O.NrOperacion and S1.Especie = '"~Dialogo.Especie1~"'")
SQL.ADD("  AND  S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
*--- Seleccion de cuenta del vehiculo por tipo de operacion
SQL.ADD("  AND  ( ")
SQL.ADD("       (O.TipoOp In ('TIC','TIV','TIFC','TIFV','TICO','TICT','TIDE','TIPO','TCOPRI') and O.Cuenta3 IN ("~val(li:1)~")) ")
SQL.ADD("   or  (O.TipoOp In ('FXCT','FXVT') and O.RB10=1 and O.Cuenta2 IN ("~val(li:1)~")) ")
SQL.ADD("   or  (O.Especie=S1.Especie and O.Cuenta1 IN ("~val(li:1)~")) ")
SQL.ADD("   or  (O.ContraEspecie=S1.Especie and O.Cuenta2 IN ("~val(li:1)~")) ")
SQL.ADD("       ) ")
SQL.ADD("  AND  S1.NrSaldo in (1,5,100)                                                      ")
SQL.ADD("  AND  S1.FechaMov = (SELECT MAX(S2.FechaMov)                                       ")
SQL.ADD("                      FROM "~DBO~".MOVPENDIENTES S2 WITH (NOLOCK)                   ") 
SQL.ADD("                      WHERE S2.Cliente  = S1.Cliente AND                             ")
SQL.ADD("                            S2.Especie  = S1.Especie AND                             ")
* FJL 05/12/18 - Las monedas no tienen cupon y no encontraba nada
*SQL.ADD("                            S2.Cupon = S1.Cupon AND                                 ")
* FJL 16/03/26 - Issue 9153 - Dieferncia por cupon Vacio el 31/05/2023
*SQL.ADD("                           (S2.Cupon    = S1.Cupon OR (S2.Cupon  IS NULL AND S1.Cupon IS NULL) ) AND ")
SQL.ADD("                            IsNull(S2.Cupon,'') = IsNull(S1.Cupon,'') AND                                 ")
SQL.ADD("                            S2.EnteCustodia = S1.EnteCustodia AND                   ")
SQL.ADD("                            S2.Mercado  = S1.Mercado AND                             ")
SQL.ADD("                            S2.NrSaldo  = S1.NrSaldo AND                             ")
SQL.ADD("                            S2.Cuenta   = S1.Cuenta AND                               ")
SQL.ADD("                            S2.FechaMov < '"~IdxDate(Dialogo.Fecha1)~"' )           ")
SQL.ADD(" UNION ALL ")
*--- Posicion Inicial de Caja por cuenta1
SQL.Add("SELECT Sum(M.Cantidad) as Cantidad   ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPOSEJE M WITH (NOLOCK)  ")
SQL.Add("WHERE  T2.TipoTr2  = 'POSCAJ' ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion  ")
SQL.Add(" AND   T2.Cuenta1 IN ("~val(li:1)~") ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'  ")
SQL.ADD(" AND   M.FechaMov  = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND   T2.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
watch(SQL.BATCH())
Recorrer SQL
 SCN(AA101, fbn['Saldo'])
Proximo

