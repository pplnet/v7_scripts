SQL.ADD(" Select   Case TipoOp                                   ")
SQL.ADD("          When 'TICO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TICT' then -O.TotalBrutoCli3            ")
** FJL 04/07/22 - Se Agregan Prestamos de Titulos
SQL.ADD("          When 'TIPO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TIDE' then -O.TotalBrutoCli3            ")
SQL.ADD("          END as  Cantidad, O.FechaVto                  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" where O.FechaVto   >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
SQL.ADD(" and   O.FechaVto   <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and   O.ContraEspecie = '"~Dialogo.Especie1~"'         ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion                  ")
SQL.ADD(" and   OB.Valor =  '1'                                  ")
SQL.ADD(" and   OB.NrBit <>  30                                  ")
SQL.ADD(" and   O.Cuenta3 in ("~val(li:1)~")                      ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'              ")
** FJL 04/07/22 - Se Agregan Prestamos de Titulos
*SQL.ADD(" and O.TipoOp in ('TICO','TICT')                        ")
SQL.ADD(" and O.TipoOp in ('TICO','TICT','TIPO','TIDE')                        ")

Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaVto'],'ARG',SI)+1:116, fbn['Cantidad'])
Proximo

*message('4')

****
**** Fallas del dia 
****
SQL.ADD(" Select   Case TipoTr2  ")
SQL.ADD("               When 'COMP' then 0 ")
SQL.ADD("               When 'MATCH' then Cantidad2 ")
SQL.ADD("               Else Cantidad1 ")
SQL.ADD("          END as  Cantidad1,  ")
SQL.ADD(" T2.Cantidad3 as Cantidad3, T2.TipoTr2 ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T2 ")
SQL.ADD(" where (T2.TipoTr2 = 'MATCH' or T2.Fecha3 = '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" and T2.TipoTr2 in ('DEP','RET','COMP','MATCH', 'TRANSP') and (T2.CB9='0' or T2.CB9 is NUll)")
SQL.ADD(" and ((T2.Especie = '"~Dialogo.Especie1~"' and T2.TipoTr2 != 'MATCH') or   ")
SQL.ADD("      (T2.Especie1 = '"~Dialogo.Especie1~"' and T2.TipoTr2 = 'MATCH'))     ")
SQL.ADD(" and  T2.CB3 = '1'   ")
SQL.ADD(" and T2.Cuenta2 in ("~val(li:1)~") ")
SQL.ADD(" and T2.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

Recorrer SQL

   if Vacio(fbn['Cantidad3'])
      if Incluido(fbn['TipoTr2'], 'RET|MATCH')
         SCN(AA115, fbn['Cantidad1'] * -1) 
      else
         SCN(AA115, fbn['Cantidad1'] )
      Endif
   else
      SCN(AA115, fbn['Cantidad3'])
   endif 
Proximo
SCN(AA101, -Val(AA115) )
 
