Recorrer&i 1, val(aa5)
   ACD(26+&i:100, Habiles(Dialogo.Fecha1, &i-1,'ARG', SI))
   if &i > 1
      ACN(26+&i:101, val(26+&i-1:117))      
   endif

   ACN(26+&i:117, sum(26+&i:101..26+&i:116))
Proximo

