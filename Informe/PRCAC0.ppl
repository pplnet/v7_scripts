CrearDialogo
   Vehiculo1 : 'Vehiculo'        ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo' ;NO;var('VEHICULODE')
   Especie1  : 'Especie'         ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;
   Fecha1    : 'Desde Fecha'     ;;;;SI;;DIALOGO.FECHA1 < DIALOGO.FECHA2 y EsHabil(DIALOGO.FECHA1,VAR('FERIDEF'));'La fecha hasta debe ser mayor a la fecha desde y debe ser habil';NO;FSys
   Fecha2    : 'Hasta Fecha'     ;;;;  ;;(DifDias(Dialogo.Fecha1, Dialogo.Fecha2,'ARG', SI)+1) <= 10;'El Plazo no puede superar los 10 dias habiles';NO;Habiles(DIALOGO.FECHA1,9,VAR('FERIDEF'));Habiles(DIALOGO.FECHA1,9,VAR('FERIDEF'))
   Lista1    : "Cuenta"          ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE  Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' ORDER BY Codigo ");
FinDialogo

MostrarCuadroDeMensajes

