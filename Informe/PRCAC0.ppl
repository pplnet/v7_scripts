SQL.ADD("Select  O.TotalBrutoCli1 as Cantidad, O.FechaVto ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" where O.FechaVto   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   O.FechaVto   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   O.Especie    = '"~Dialogo.Especie1~"'        ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion              ")
SQL.ADD(" and   OB.Valor =  '1'                              ")
SQL.ADD(" and   OB.NrBit <>  30                              ")
SQL.ADD(" and   O.Cuenta1 IN ("~val(li:1)~")                   ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'         ")
SQL.ADD(" and   O.TipoOp in ('PMU','PME','MMPICO')            ")
SQL.ADD(" and   O.CB6 = 0                                     ")
SQL.ADD(" and   O.NrOperacion Not in (                        ")
SQL.ADD("              Select  MP.NrOperacion                                 ")
SQL.ADD("              from "~DBO~".MOVPENDIENTES MP                          ")
SQL.ADD("              where MP.NrOperacion = O.NrOperacion                   ")
SQL.ADD("                AND MP.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'      ")
SQL.ADD("                AND MP.NrSaldo = 1 AND MP.NrMov = 30                 ")
SQL.ADD("              UNION ALL                                              ")
SQL.ADD("              Select  MP.NrOperacion                                 ")
SQL.ADD("              from "~DBO~".MOVEJECUTADOS  MP                         ")
SQL.ADD("              where MP.NrOperacion = O.NrOperacion                   ")
SQL.ADD("                AND MP.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'      ")
SQL.ADD("                AND MP.NrSaldo = 1 AND MP.NrMov = 30                 ")
SQL.ADD("                )                                                    ")


Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaVto'],'ARG',SI)+1:108, fbn['Cantidad'])
Proximo



SQL.ADD("Select  -MP.Cantidad as Cantidad, MP.FechaMov           ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O   ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                   ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'   ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'   ")
SQL.ADD(" and   MP.Especie    = '"~Dialogo.Especie1~"'           ")
SQL.ADD(" and   MP.NrSaldo = 1                                   ")
SQL.ADD(" and   MP.NrGrupo <> 1                                  ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'            ")
SQL.ADD(" and   O.TipoOp in ('PMU','PME','MMPICO')               ")
SQL.ADD(" and   ( ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta1 IN ("~val(li:1)~")) ")
SQL.ADD("        ) ")

SQL.ADD(" Union All                                              ")

SQL.ADD("Select  -MP.Cantidad as Cantidad, MP.FechaMov           ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS MP, "~DBO~".OPERACIONES O   ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                   ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'   ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'   ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'          ")
SQL.ADD(" and   MP.NrSaldo = 1                                   ")
SQL.ADD(" and   MP.NrGrupo <> 1                                  ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'            ")
SQL.ADD(" and   O.TipoOp in ('PMU','PME','MMPICO')               ")
SQL.ADD(" and   ( ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta1 IN ("~val(li:1)~")) ")
SQL.ADD("        ) ")

Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:108, fbn['Cantidad'])
Proximo
*message('1')

*--- CAMBIOS
(.'PROCAJPEN'.)
SQL.ADD(" and O.TipoOp in ('FXC','FXV','FXCT','FXVT','FXA','FXAT') ")
SQL.ADD(" and   ( ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta1 IN ("~val(li:1)~")) ")
SQL.ADD("        or  (O.ContraEspecie=MP.Especie and O.Cuenta2 IN ("~val(li:1)~")) ")
SQL.ADD("        ) ")
SQL.ADD(" UNION ALL                                                ")
(.'PROCAJEJE'.)
SQL.ADD(" and O.TipoOp in ('FXC','FXV','FXCT','FXVT','FXA','FXAT') ")

Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:109, fbn['Cantidad'])
Proximo
