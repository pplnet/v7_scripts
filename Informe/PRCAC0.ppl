** Rofex/NDF
SQL.ADD("Select -MP.Cantidad as Cantidad, MP.FechaMov ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O,  "~DBO~".MERCADOS M ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                 ")
SQL.ADD(" AND   O.Mercado4 = M.Codigo                 ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'        ")
SQL.ADD(" and   ( ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta2 IN ("~val(li:1)~")) ")
SQL.ADD("        or  (O.ContraEspecie=MP.Especie and O.Cuenta3 IN ("~val(li:1)~")) ")
SQL.ADD("        or  (O.TasaEspecie=MP.Especie and O.Cuenta3 IN ("~val(li:1)~")) ")
SQL.ADD("        ) ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and MP.NrSaldo = 1 ")
SQL.ADD(" and O.TipoOp in ('FXCF','FXVF') ")
*SQL.ADD(" and O.Mercado4='"~VAR('MERROFEX')~"' ")
SQL.ADD(" and M.TipoNegocio like '%FM|%' ")

SQL.ADD(" Union All ")

SQL.ADD("Select -MP.Cantidad as Cantidad, MP.FechaMov ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS MP, "~DBO~".OPERACIONES O,  "~DBO~".MERCADOS M ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                 ")
SQL.ADD(" AND   O.Mercado4 = M.Codigo                 ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'        ")
SQL.ADD(" and   ( ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta2 IN ("~val(li:1)~")) ")
SQL.ADD("        or  (O.ContraEspecie=MP.Especie and O.Cuenta3 IN ("~val(li:1)~")) ")
SQL.ADD("        or  (O.TasaEspecie=MP.Especie and O.Cuenta3 IN ("~val(li:1)~")) ")
SQL.ADD("        ) ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and MP.NrSaldo = 1 ")
SQL.ADD(" and O.TipoOp in ('FXCF','FXVF') ")
*SQL.ADD(" and O.Mercado4='"~VAR('MERROFEX')~"' ")
SQL.ADD(" and M.TipoNegocio like '%FM|%' ")

**watch(SQL.BATCH())
Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:110, fbn['Cantidad'])
Proximo



