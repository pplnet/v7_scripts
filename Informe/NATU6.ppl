***---Obtengo carteras que valuan por Partida
(.'BOOKPARTID'.)

Recorrer SQL
    DFA
    ACT(BK:1, Val(BK:1)~'|'~fbn('Books'))
Proximo

CrearDialogo
  Fecha1 : 'Fecha'   ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Operacion Desde Incorrecta';NO;FSys
  Book1  : 'Cartera' ;;;;;;IIF(NoVacio(Dialogo.Book1),Incluido(Dialogo.Book1,Val(BK:1)));;;;;;;;" Codigo IN ("~Pipe2Comillas(Val(BK:1))~") ";
FinDialogo

If Not Ok
   Cancelar
Endif

IF NoVacio(Dialogo.Book1)
    let &book Dialogo.Book1
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*- Encabezados
ACT(a2, 'Listado de Operaciones No Asignadas a Partidas') 
SetFont(a2..a2, 3)

ACT(a4, 'Fecha: '~Dialogo.Fecha1)
SetFont(a4..a5, 2)

SetFilaActual(7)

ACT(a:FAC, 'NrOperacion')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'Fecha Op.')
ACT(d:FAC, 'Fecha Vto.')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Cantidad')
ACT(g:FAC, 'Precio')
ACT(h:FAC, 'Book')

SetFont(a:FAC..h:FAC,2)
AlinearCeldas(a:FAC..h:FAC, 'C')
AgregarMarco(a:FAC..h:FAC,2,0,EXE('COLOR'))

SetFilaActual(FAC)
*- Selecciono todas las operaciones con fecha del dia que no tengan asociadas partidas
(.'OPNOASPAR'.)
watch(sql.batch)
Recorrer SQL
   ACT(a:FAC, FBN['Nroperacion'])
   if Incluido('DTP',FBN('TipoOp')) 
      ACLT(a:FAC, FBN('NrOperacion'))
     else
      ACLO(a:FAC, FBN('NrOperacion'))
   endif
   
   ACT(b:FAC, FBN['TipoOp'])
   ACD(c:FAC, FBN['FechaOp'])
   ACD(d:FAC, FBN['FechaVto'])
   ACT(e:FAC, FBN['Especie'])
   ACN(f:FAC, FBN['Cantidad'])
   ACN(g:FAC, FBN['Precio1'])
   ACT(h:FAC, FBN['Book'])
   SetFont(a:FAC..i:FAC,1)
   AlinearCeldas(b:FAC..e:FAC, 'C')
   AlinearCeldas(f:FAC..g:FAC, 'D')
   AlinearCeldas(h:FAC..h:FAC, 'C')
   FormatoCeldas(f:FAC..a:FAC,Exe('F7')) 
   FormatoCeldas(g:FAC..g:FAC,Exe('F9'))     
Proximo

ACO(1, 8)
ACO(2, 7)
ACO(3, 7)
ACO(4, 7)
ACO(5, 7)
ACO(6, 10)
ACo(7, 9)
ACo(8, 7)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC..a:FAC, 2)

LimitesVision(i:FAC)
RangoTitulo(a:1..h:FAC, 6)
