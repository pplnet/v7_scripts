ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'F.Desde';;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;FSys
  Fecha2   : 'F.Hasta';;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Hasta';NO;FSys
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

ACT(a3,'Sistema: FPA')
ACT(c3,'Fecha de Proceso: '~Fecha(FSYS))
ACT(f3,'Filtro: ')
ACT(o3,'Usuario: '~USUARIOACTIVO~'  Server: '~SQL("select @@servername"))
AlinearCeldas(o3..o3,'D')

SetFilaActual(4)

ACT(c:fac,'NrOperacion')
ACT(d:fac,'NrCuota')
ACT(e:fac,'IVA Normal')
ACT(f:fac,'IVA Adicional')
ACT(g:fac,'IVA Percepcion')
ACT(h:fac,'WHT')
ACT(i:fac,'PISE')
ACT(j:fac,'Total')

AlinearCeldas(e:fac..n:fac,'D')

*-------------------------------------------------------------
*--- Operaciones con pagos
*-------------------------------------------------------------

*--- IVA Normal

SQL.ADD("select M.FechaMov as Fecha,M.Cliente,M.NrOperacion,M.NrGrupo2 as NrCuota,'NOR' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (51,61,86,91) and M.FechaMov between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion ")
SQL.ADD("union all ")

SQL.ADD("select (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end)  as Fecha,M.Cliente,M.NrOperacion,1 as NrCuota,'NOR' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (41,81) and (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion and O.TipoOp='PMU' ")
SQL.ADD("union all ")

SQL.ADD("select (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) as Fecha,M.Cliente,M.NrOperacion,NrCuota,'NOR' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUOTAS C ")
SQL.ADD("where M.NrSaldo in (41,81) ")
SQL.ADD("and (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ") 
SQL.ADD("and M.NrOperacion = C.NrOperacion and M.NrGrupo2=C.NrCuota ")
SQL.ADD("union all ")

*--- IVA Adicional

SQL.ADD("select M.FechaMov as Fecha,M.Cliente,M.NrOperacion,M.NrGrupo2 as NrCuota,'ADI' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (52,62,87,92) and M.FechaMov between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion ")
SQL.ADD("union all ")

SQL.ADD("select (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end)  as Fecha,M.Cliente,M.NrOperacion,1 as NrCuota,'ADI' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (42,82) and (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion and O.TipoOp='PMU'")
SQL.ADD("union all ")

SQL.ADD("select (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) as Fecha,M.Cliente,M.NrOperacion,NrCuota,'ADI' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUOTAS C ")
SQL.ADD("where M.NrSaldo in (42,82) ")
SQL.ADD("and (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ") 
SQL.ADD("and M.NrOperacion = C.NrOperacion and M.NrGrupo2=C.NrCuota ")
SQL.ADD("union all ")

*--- IVA Percepcion

SQL.ADD("select M.FechaMov as Fecha,M.Cliente,M.NrOperacion,M.NrGrupo2 as NrCuota,'PER' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (53,63,88,93) and M.FechaMov between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion ")
SQL.ADD("union all ")

SQL.ADD("select (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end)  as Fecha,M.Cliente,M.NrOperacion,1 as NrCuota,'PER' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrSaldo in (43,83) and (case when O.FechaPrecan<O.FechaVto then O.FechaPrecan else O.FechaVto end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and M.NrOperacion = O.NrOperacion and O.TipoOp='PMU' ")
SQL.ADD("union all ")

SQL.ADD("select (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) as Fecha,M.Cliente,M.NrOperacion,NrCuota,'PER' as Impuesto,M.Cantidad as Monto,M.Especie,Convert(double precision, isnull(M.Formula,'1')) as TipoCambio,M.FechaMov,M.NrSaldo  ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUOTAS C ")
SQL.ADD("where M.NrSaldo in (43,83) ")
SQL.ADD("and (case when C.Fecha4<C.Fecha2 and C.Radio6='1' then C.Fecha4 else C.Fecha2 end) between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ") 
SQL.ADD("and M.NrOperacion = C.NrOperacion and M.NrGrupo2=C.NrCuota ")
SQL.ADD("union all ")

*--- WHT y PISE

SQL.ADD("select FechaMov as Fecha,Cliente,NrOperacion,(case when NrGrupo2>0 then NrGrupo2 else 1 end) as NrCuota,'WHT' as Impuesto,Cantidad as Monto,Especie,Convert(double precision, isnull(Formula,'1')) as TipoCambio,FechaMov,NrSaldo ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
SQL.ADD("where NrSaldo in (73,74,77) and Status in ('1','2') ")
SQL.ADD("and FechaMov between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("union all ")

SQL.ADD("select FechaMov as Fecha,Cliente,NrOperacion,(case when NrGrupo2>0 then NrGrupo2 else 1 end) as NrCuota,'PISE' as Impuesto,Cantidad as Monto,Especie,Convert(double precision, isnull(Formula,'1')) as TipoCambio,FechaMov,NrSaldo ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS ")
SQL.ADD("where NrSaldo in (75,76,78) and Status in ('1','2') ")
SQL.ADD("and FechaMov between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("union all ")

*-------------------------------------------------------------
*--- Operaciones sin pagos
*-------------------------------------------------------------

*--- Excluyo INGCURA porque WHT y PISE estan asociados al pago

SQL.ADD("select C.Fecha2 as Fecha,O.Cliente1,C.NrOperacion,C.NrCuota,'REC' as Impuesto,0 as Monto,O.Especie,0 as TipoCambio,null,0 ")
SQL.ADD("from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD("where C.Fecha2 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and C.Fecha4 is null and C.NrOperacion =O.NrOperacion and O.Vehiculo1<>'INGCURA' ")
SQL.ADD("union all ")
SQL.ADD("select FechaVto as Fecha, Cliente1, NrOperacion,1,'REC' as Impuesto,0 as Monto,Especie,0 as TipoCambio,null,0 ")
SQL.ADD("from "~DBO~".OPERACIONES ")
SQL.ADD("where FechaVto between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("and FechaEj is null and TipoOp='PMU' and Vehiculo1<>'INGCURA' ")

SQL.ADD("order by 1,2,3,4 ")

ACT(f3,val(f3)~"Desde: "~Dialogo.Fecha1~" Hasta: "~Dialogo.Fecha2~"  ")


ACT(ac1,'ww')
ACT(ac2,'ww')
ACD(ac4,0)

ACN(pz1,0)
ACN(pz2,0)
ACN(pz4,0)

ACN(z1,1)
ACN(x1,0)
recorrer SQL

if not EQSTR(fbn('NrOperacion'),val(ac1)) o not EQSTR(fbn('Cliente'),val(ac2)) o fbn('Fecha')<>val(ac4)
  if val(pz1)=1
*    ACT(c:fac,'Total Operacion: ')
*    ACN(d:fac,val(t1))        
    dfa
    ACN(t1,sum(c:fac..i:fac))
    SCN(t2,val(t1))
    SCN(t4,val(t1))
    ACN(j:fac,val(t1))        
    ifa    
    ACN(t1,0)
    ACN(z1,1)
  else
    ACN(pz1,1)
  endif
endif

if not EQSTR(fbn('Cliente'),val(ac2)) o fbn('Fecha')<>val(ac4)
  if val(pz2)=1    
    ACT(b:fac,'Total Cliente: ')
    ACN(c:fac,val(t2))    
    ifa
    ACN(t2,0)
    ACN(z1,1)
  else
    ACN(pz2,1)
  endif
endif

if fbn('Fecha')<>val(ac4)
  if val(pz4)=1       
    ACT(a:fac,'Total Fecha: ')
    ACN(b:fac,val(t4))
    AgregarMarco(a:Val(w1)..p:fac,1)
    ifa
    ACN(t4,0)
    ACN(z1,1)
  else
    ACN(pz4,1)
  endif
endif

if fbn('Fecha')<>val(ac4)
  ACT(a:fac,'Fecha: '~fbn('Fecha'))
  ACN(w1,fac)
  ifa 
endif

if not EQSTR(fbn('Cliente'),val(ac2)) o fbn('Fecha')<>val(ac4)  
  ACT(b:fac,'Cliente: '~fbn('Cliente')~' - '~BuscarCampo('CLIENTES','Valor2','Codigo',fbn('Cliente'))~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente'))~' - '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Cliente')))
  ifa
endif

if not EQSTR(fbn('NrOperacion'),val(ac1)) o not EQSTR(fbn('Cliente'),val(ac2)) o fbn('Fecha')<>val(ac4)
  ACT(c:fac,fbn('NrOperacion'))  
  ACT(d:fac,fbn('NrCuota'))  
*  ifa  
endif

if val(z1)=0
 dfa
endif


if EqStr(fbn('Especie'),'ARP')
  ACN(mm1,fbn('Monto'))
  else
  if Incluido(fbn('NrSaldo'),'41|81|42|82|43|83') y fbn('Fecha')<>fbn('FechaMov')
**    ACN(mm1,fbn('Monto')*COTIZACIONC(fbn('Especie'),,,,fbn('Fecha')-1,1,SI,'USD')*COTIZACIONC('USN',,,,fbn('Fecha')-1,1,SI,'ARP'))    
**    Esto cambio por la cotizacion USD de CIERREBNA
      ACN(mm1,fbn('Monto')*COTIZACIONBNA('USD',fbn('Fecha')-1,2,NO,NO) )    
  else
    ACN(mm1,fbn('Monto')*fbn('TipoCambio')) 
  endif
endif

if EQSTR(fbn('Impuesto'),'NOR')
  SCN(e:fac,val(mm1))
  else
  if EQSTR(fbn('Impuesto'),'ADI')
    SCN(f:fac,val(mm1))
  else
    if EQSTR(fbn('Impuesto'),'PER')
      SCN(g:fac,val(mm1))
    else
      if EQSTR(fbn('Impuesto'),'WHT')
        SCN(h:fac,val(mm1))
      else 
        if EQSTR(fbn('Impuesto'),'PISE')
          SCN(i:fac,val(mm1))
        else
          if EQSTR(fbn('Impuesto'),'REC') 

     *--- Recalculo el IVA a FechaVto

     ACN(fa1,fac)
     SCN(x1,1)   

     SQL.ADD("Select (case O.TipoOp when 'PMU' then O.FechaVto else CU.Fecha2 end) as FechaVto, ")
     SQL.ADD(" O.Vehiculo1, ")     
     SQL.ADD(" O.Cliente1, ")
     SQL.ADD(" O.Especie, ")
     SQL.ADD(" (case O.TipoOp when 'PMU' then O.TotalIntereses else CU.Cantidad2 end) as Intereses,  ")
     SQL.ADD(" (case O.TipoOp when 'PMU' then O.TotalComisiones else CU.Total7 end) as Comisiones, ")
     SQL.ADD(" O.MB3, ")
     SQL.ADD(" O.NrOperacion, ")
     SQL.ADD(" C.CondicionIVA, ")
     SQL.ADD(" C.AgPercepcionIVA, ")
     SQL.ADD(" C.ExIVA, ")
     SQL.ADD(" C.PorcExIVA, ")
     SQL.ADD(" C.FDesdeExIVA, ")
     SQL.ADD(" C.FHastaExIVA ")
     *-I
     *SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C,"~DBO~".CUOTAS CU ")
      SQL.ADD("from "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUOTAS CU  ON O.NrOperacion = CU.NrOperacion, "~DBO~".CLIENTES C")
     *-F
     SQL.ADD("where O.Cliente1 = C.Codigo ")
     *-I
     *SQL.ADD("and O.NrOperacion *= CU.NrOperacion ")
     *-F   
     SQL.ADD("and O.NrOperacion='"~fbn('NrOperacion')~"' ")
     SQL.ADD("and (case O.TipoOp when 'PME' then CU.NrCuota else 1 end) ="~fbn('NrCuota')~" ")

     ACN(ha:val(x1),0)
     ACN(hb:val(x1),0)
     ACN(hc:val(x1),0)

     Recorrer SQL      

     *** IVA ****
     if Not[Eqstr(fbn('Vehiculo1'),'INGCURA')]

       ACT(j1,FBN['CondicionIVA'])
       ACT(k1,FBN['AgPercepcionIVA'])
       ACT(l1,FBN['ExIVA'])
       ACN(m1,FBN['PorcExIVA'])
       ACD(n1,FBN['FDesdeExIVA'])
       ACD(o1,FBN['FHastaExIVA'])
       ACT(s1,FBN['MB3'])

       *--- IVA / INTERES NORMAL
       ACN(pm1,fbn('Intereses'))
       ACN(pf1,fbn('FechaVto'))
       ACT(pt1,'INT')
       (.'CANPREIVA'.)
       ACN(ga:val(x1),val(pr1))
       ACN(gb:val(x1),val(pr2))
       ACN(gc:val(x1),val(pr3))
 
       *--- IVA / COMISION
       ACN(pm1,fbn('Comisiones'))
       ACN(pf1,fbn('FechaVto'))
       ACT(pt1,'COM')
       (.'CANPREIVA'.)
       ACN(nb:val(x1),val(pr1))
       ACN(nc:val(x1),val(pr2))
       ACN(nd:val(x1),val(pr3))

       *** TOTAL IVANOR
       ACN(ha:val(x1),Round(val(ga:val(x1))+val(nb:val(x1)),2))
   
       *** TOTAL IVAADI
       ACN(hb:val(x1),Round(val(gb:val(x1))+val(nc:val(x1)),2))

       *** TOTAL IVAPER
       ACN(hc:val(x1),Round(val(gc:val(x1))+val(nd:val(x1)),2))     
       
       * Si IVAPER es menor al Valor Minimo el Impuesto es 0
       if val(hc:val(x1)) < Var('IVAPERMIN')
         ACN(gc:val(x1),0)
         ACN(nd:val(x1),0)
         ACN(hc:val(x1),0)
       endif
     endif   
 
  *--- FIN IVA       

       if EQSTR(fbn('Especie'),'ARP')
         ACN(co1,1)
       else
**         ACN(co1,COTIZACIONC(fbn('Especie'),,,,fbn('FechaVto')-1,1,SI,'USD')*COTIZACIONC('USN',,,,fbn('FechaVto')-1,1,SI,'ARP'))
**         Cambia por la cotizacion del USD del CIERREBNA

           ACN(co1,COTIZACIONBNA('USD',fbn('FechaVto')-1,2,NO,NO) )    
       endif

       Proximo

       SetFilaActual(val(fa1))    
       ACN(e:fac,val(ha:val(x1))*val(co1))
       ACN(f:fac,val(hb:val(x1))*val(co1))
       ACN(g:fac,val(hc:val(x1))*val(co1))

          endif
        endif
      endif
    endif
  endif
endif

  ACD(ac4,fbn('Fecha'))
  ACT(ac2,fbn('Cliente'))
  ACT(ac1,fbn('NrOperacion'))

  ACN(z1,0)
proximo

ACN(t1,sum(c:fac..i:fac))
SCN(t2,val(t1))
SCN(t4,val(t1))

ACN(j:fac,val(t1))
ifa    
ACT(b:fac,'Total Cliente: ')    
ACN(c:fac, val(t2))
ifa
ACT(a:fac,'Total Fecha: ')    
ACN(b:fac, val(t4))

AgregarMarco(a:Val(w1)..p:fac,1)


*-------------------------------------

BorrarCeldas(a1..t1)

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
ACT(o1,VAR('TITULO'))
ACT(o2, 'Listado de IVA')
AlinearCeldas(o1..o2,'D')
SetFont(o1..o2, 1)

*Landscape
Impresion(1,2)
*Fecha
Impresion(2,1)
*Pagina
Impresion(3,1)

ACO(5,8.5)
ACO(6,8.5)
ACO(7,8.5)
ACO(8,8.5)
ACO(9,8.5)
ACO(10,8.5)

* Reduzco el alto de todas las filas
recorrer&i 1,fac+7
  AFI(&i,1)
proximo

*SetPrintFit(3,85)

LimitesVision(o:UFila)

* Encabezado
RangoTitulo(a:1..o:fac+7,4)


