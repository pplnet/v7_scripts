HojaVisible(NO)
CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Radio1   : 'Agrupa por|Contraparte|Fecha';;;;;;;;;0
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
FinDialogo

if not OK
  Cancelar
endif

if Dialogo.Radio1=0
  LinkearHoja('FLULIC',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1)
endif
if Dialogo.Radio1=1
  LinkearHoja('FLULIF',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1)
endif
