  ACT(c:fac+7, '   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
  SetFont(d:fac+7..d:fac+7,1)
  SetFilaActual(FAC+7)

  FormatoCeldas(d:1..f:FAC,Exe('F2'))
  if Val(fa:2)<>0
    FormatoCeldas(d:Val(fa:2)..f:Val(fa:2),"0,.0000;(0,.0000)R")
  endif
  SetFont(x1..z2,1)

  ACO(1,6)
  ACO(2,6)
  ACO(3,4)
