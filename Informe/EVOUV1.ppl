  ACO(5,10)
  ACO(6,10)
  ACO(7,4)
  ACO(8,4)
  ACO(9,6)
  ACO(10,4)

  LimitesVision(j:FAC-1)

  if Dialogo.Check3=1
    ImprimirHoja
  endif
Proximo

If Val(aa1) = 0
