CrearDialogo
  NrTrans1:'Voucher'   ;
  Check1  :'Re-Emision';
  Check3  :'Impresora' ;
  String :'Lista Vouchers';;
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')
CrearFont(5, "Arial,5,")

ACT(a:4,'Fecha :'~Fecha(FSys))
AgregarBMP(A:1,EXE('LOGO'),EXE('ESCALOGO'))
SetFont(a:1..z:4,2)

If Dialogo.Check1 = 0
  ACT(d:1, 'ORIGINAL')
else
* FJL 07/11/18 - Se cambia leyenda - Pto 5 Issue 3351
*  ACT(d:1, 'COPIA')
  ACT(d:1, 'REIMPRESION')
endif
AlinearCeldas(d:1,'C')
SetFont(d:1,3)

SQL.ADD(" Select T.*, E.Nombre, E.CodNumCajaValores, E.ClaseCajaValores, C.RazonSocial, E.VTeorico, E.InteresesC ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E " )
SQL.ADD(" where  T.Cliente1 = C.Codigo ")
SQL.ADD(" and    T.Especie  = E.Codigo ")
SQL.ADD(" and    T.NrTrans  = '"~Dialogo.NrTrans1~"' ")
acn(aa1,0)
Recorrer SQL
  ACT(f:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
  ACT(f:2, 'C.U.I.T. Nº '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Vehiculo1')))    
  *if BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')) > 0
  *ACT(f:3, 'Agente de Mercado Abierto Nº '~BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')))
  *endif
  if BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')) > 0
    ACT(f:4, 'Cuenta en Caja de Valores Nº '~BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')))
  endif
  SetFont(f:1..f:1,2)
  SetFont(f:2..f:4,4)
  
  ACN(xy2,SQL("Select Top(1) PrecioContable From "~DBO~".COTIZACIONES Where Codigo = 'COMA35' AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(fbn['Fecha2'])~"'  AND CallPut = 'CON'  Order By Fecha Desc "))
  
  ACT(zz:1,BuscarCampo('MERCADOS','Descripcion','Codigo',fbn['Mercado1']))
  act(a:3,'Emision Vouchers '~Val(zz:1))

  acn(aa1,1)
  SetFilaActual(FAC+6)
  ACT(a:fac, 'Voucher de liquidacion Nro. : '~fbn['NrTrans'])
  ACT(f:fac, 'Liquidacion del : '~fbn['Fecha2'])
  if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
    ACT(b:FAC+2, 'Titulos por Caja de Valores')
  else
    ACT(b:FAC+2, fbn['Especie']~' por '~Val(zz:1))
  endif

  if EqStr(fbn['TipoTr2'], 'DEP')
    ACT(b:FAC+2, 'Cobrar - '~Val(b:FAC+2))
    ACT(z2, 'Cobrar')
    if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
      ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']) ~' - Cupon N# ' ~ fbn('Cupon1') ~ ' (CV: '~fbn['CodNumCajaValores']~')')
    else
      ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']))
    endif    
    ACT(a:FAC+5, 'Nombre Cta. : ' ~ BuscarCampo('CUENTAS','Nombre'   ,'Codigo',fbn['Cuenta1']))
    ACT(a:FAC+6, 'Numero      : ' ~ BuscarCampo('CUENTAS','Numero'   ,'Codigo',fbn['Cuenta1']))
    ACT(a:FAC+7, 'Depositante : ' ~ BuscarCampo('CUENTAS','Comitente','Codigo',fbn['Cuenta1']))
    ACT(a:FAC+8, 'Comitente   : ' ~ BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta1']))
  else
    if EqStr(fbn['TipoTr2'], 'RET')
      ACT(b:FAC+2, 'Pagar - '~Val(b:FAC+2))
    else
      ACT(b:FAC+2, 'Compensar - '~Val(b:FAC+2))
    endif
    ACT(z2, 'Pagar')
    if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
       ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']) ~' - Cupon N# ' ~ fbn('Cupon1') ~ ' (CV: '~fbn['CodNumCajaValores']~')')
    else
       ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']) )
    endif 
    ACT(a:FAC+5, 'Nombre Cta. : ' ~ BuscarCampo('CUENTAS','Nombre','Codigo',fbn['Cuenta1']))
    ACT(a:FAC+6, 'Numero      : ' ~ BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta1']))
    ACT(a:FAC+7, 'Depositante : ' ~ BuscarCampo('CUENTAS','Comitente','Codigo',fbn['Cuenta1']))
    ACT(a:FAC+8, 'Comitente   : ' ~ BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta1']))
  endif
 
  if Eqstr(FBN['Mercado1'],VAR('MERSWIFT') )
     ACT(a:FAC+9,  'Corresponal : ' ~ BuscarCampo('CUENTAS','Corresponsal','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+10,  'SWIFT / Fedwire : ' ~ BuscarCampo('CUENTAS','Alias3','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+11, 'Cta. Banco : ' ~ BuscarCampo('CUENTAS','Alias1','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+12, 'Subcuenta : ' ~ BuscarCampo('CUENTAS','Alias2','Codigo',fbn['Cuenta1']))
  Endif


  if fbn['CB8']=1    
    *-- equivale a  EqStr(fbn['Status'], 'CONF')---
    ACT(b:FAC+2, Val(b:FAC+2)~' - CONFORMADOS')
  endif
  if fbn['CB6']=1    
    *-- equivale a EqStr(fbn['Status'], 'DVP')---
    ACT(b:FAC+2, Val(b:FAC+2)~' - Contra Acreditacion Cliente (DVP)')
  endif
  if fbn['CB7']=1   
    *-- equivale a EqStr(fbn['Status'], 'RVP')----
    ACT(b:FAC+2, Val(b:FAC+2)~' - Contra Acreditacion Propia (RVP)')
  endif

  AgregarMarco(a:FAC+2..i:FAC+2, 2)
  ACT(a:FAC+3, 'Cliente : '~Copy(FBN['RazonSocial'],1,25))
  SetFilaActual(FAC+13)
  ACN(co:1,FAC-1)
  
  ACT(a:FAC, 'Fecha Op.')
  ACT(b:FAC, 'Nro. Op.')
  ACT(c:FAC, 'T.Op.')
  ACT(d:FAC, 'Descripcion')
  ACT(e:FAC, 'N.Cobros')
  ACT(f:FAC, 'N.Pagos')
  ACT(g:FAC, 'Obs.')
  ACT(h:FAC, 'Confir.')
  ** AA 04-04-22 se visualiza siempre sin importar la especie
  *if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
*    ACT(i:FAC, 'Nº MAE')
    ACN(ii:1, FAC) 
  *Endif  
  AlinearCeldas(e:FAC..f:FAC,'D')

  AgregarMarco(a:FAC..i:FAC, 2,0,Exe('COLOR'))
  IFA
  ACT(aa3,fbn['NrTrans'])
  ACN(jj1,0)

  ACN(to1,0)
  ACN(to2,0)
 
** FJL 17/12/18 - Para Mercados regulados de FX (ROFEX) poner Netos
  ACT(z:5, BuscarCampo('MERCADOS','Regulado','Codigo',fbn['Mercado1']))

  *Se agrega un JOIN para buscar Trans. falladas (CB3 = 1). CAL 23/11/2022
  SQL.ADD("Select M.*, T.Cantidad4 as CantPagada, T.CB3 as CBFallas, O.Mercado4, O.Precio1, O.Cantidad Monto")
  SQL.ADD(" from "~DBO~".MOVEJECUTADOS M FULL OUTER JOIN " ~ DBO ~ ".TRANSACCIONES2 T ON M.NrTrans2 = T.NrTrans")
  SQL.ADD(" inner JOIN OPERACIONES O  ON O.NrOperacion = M.NrOperacion ")
  If Vacio(Dialogo.String)
  SQL.ADD("where NrTrans2 = '"~fbn['NrTrans']~"' ")
  else
  SQL.ADD("Where NrTrans2 in("~Pipe2Comillas(Dialogo.String)~") ")
  endif  
  SQL.ADD("and M.NrOperacion <> '"~fbn['NrTrans']~"' ")
  SQL.ADD("and NrSaldo <> 81 ")
  SQL.ADD("order by M.NrOperacion ")
  watch(SQL.BATCH())
  ACN(xy1,0)
  Recorrer SQL
  
  if val(xy1)=0
     if EqStr(fbn['Mercado4'],VAR('MENEFFX'))
     ACT(d:Val(co:1), 'Cotiz. COMA35. '~PYC(Val(xy2),1,2) )
        ACT(d:Val(co:1)+1,Val(d:Val(co:1)+1)~'     Monto USD    Precio Concert')
        ACN(xy1,1)
     Endif
  endif   
** FJL 17/12/18 - Para Mercados regulados de FX (ROFEX) poner Netos
    if EqStr(Val(z:5),'SI')
      SCN(z:6, 1)
      if Val(z:6)=1
        ** Primner Mov de un voucher de mercado regulado
        if EqStr(fbn('Concepto'),'FM')
          ACN(z:7,1)
          ACT(b:FAC, 'Neto de Operaciones')
          ACN(e:FAC, 0)
          ACN(f:FAC, 0)
        endif
      else
        ** Mercado regulado pero no el primer movimiento
        if Val(z:7)=1
          DFA
        endif
      endif
    endif
    if Val(z:7)=0
      ** No es Mercado regulados de FX (ROFEX)
      ACN(z1, fbn['NrGrupo'])
      ACT(b:FAC, fbn['NrOperacion'])
      if EqStr(fbn['Mercado4'],VAR('MENEFFX'))
      ACT(d:FAC, fbn['Leyenda']~'     '~PYC(fbn['Monto'],1,0)~'     '~PYC(fbn['Precio1'],1,2))
      else
         ACT(d:FAC, fbn['Leyenda'])
      endif
** FJL 07/11/18 - Armo lista de opeaciones
      if Val(ac:1)=0
        ACN(ac:1, 1)
        ACT(ad:Val(ac:1), fbn['NrOperacion'])
      else
        ACN(ac:2, 0)
        recorrer&i 1,Val(ac:1)
          if EqStr(Val(ad:&i),fbn['NrOperacion']) 
          ACN(ac:2, &i)
          endif
        proximo
        if Val(ac:2)=0
          SCN(ac:1, 1)
          ACT(ad:Val(ac:1), fbn['NrOperacion'])
        endif
      endif

      if Incluido(Copy(fbn['NrOperacion'],1,2),'VT|I0|LO')
        ACT(a:FAC, BuscarCampo('TRANSACCIONES2','Fecha2','NrTrans',fbn['NrTrans2']))
        ACT(c:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',fbn['NrTrans2']))
        if fbn('Cantidad')<0
        
        *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(e:fac, fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(e:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
        else
          if Incluido(Copy(fbn['NrOperacion'],1,2),'VT|LO')
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(f:fac, -fbn['CantPagada'])
            Else
                ACN(f:fac, -fbn['Cantidad'])
            EndIf
          else
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(f:fac, fbn['CantPagada'])
            Else
              ACN(f:fac, fbn['Cantidad'])
            EndIf
          endif
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
        endif
      else
        ACT(a:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',fbn['NrOperacion']))
        ACT(c:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion', fbn['NrOperacion']))
        * Compras de Titulos
        IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TIC|TIFC|TIADJ')
          IF Eqstr(fbn('Mercado'), 'CV') o fbn['Cantidad'] <= 0
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(e:fac, fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(e:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
          Else
          
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(f:fac, -fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(f:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
              
          Endif
        Endif
        * Ventas de Titulos
        IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TIV|TIFV|TIRES')
          IF Eqstr(fbn('Mercado'), 'CV') o fbn['Cantidad'] > 0
          
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(f:fac, -fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(f:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
          else
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(e:fac, -fbn['CantPagada'])
                SCN(to:2, ABS(fbn['CantPagada']))
              Else
                ACN(e:fac, -fbn['Cantidad'])
                SCN(to:2, ABS(fbn['Cantidad']))
              EndIf
          Endif
        ENDIF
        * Money Market y FX
        IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TIDE|TIPO|TICO|TICT|MMCO|MMCT|MMPF|MMPFCE|FXA|FXAT|FXV|FXVT|FXC|FXCT|PMU|PME|FXCTC|FXVTC|PICO|PICV|CONU')
          if fbn['Cantidad'] > 0
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(f:fac, -fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(f:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
          ELSE
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(e:fac, fbn['CantPagada'])
                SCN(to:2, ABS(fbn['CantPagada']))
              Else
                ACN(e:fac, -fbn['Cantidad'])
                SCN(to:2, ABS(fbn['Cantidad']))
              EndIf
          ENDIF
        ENDIF
        * Futuros de Moneda
        IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'FXCF|FXVF')
          if fbn['Cantidad'] > 0
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(f:fac, -fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(f:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
          ELSE
            *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(e:fac, fbn['CantPagada'])
                SCN(to:1, ABS(fbn['CantPagada']))
              Else
                ACN(e:fac, -fbn['Cantidad'])
                SCN(to:1, ABS(fbn['Cantidad']))
              EndIf
          ENDIF
        ENDIF
        ***********************
        ACT(g:FAC, fbn('Status'))
        ACT(i:FAC, BuscarCampo('OPERACIONES', 'NroAltaMAE','NrOperacion',fbn['NrOperacion']))
        
        ACT(II:FAC, BuscarCampo('OPERACIONES','MERCADO4','NrOperacion',fbn['NrOperacion']) )
       
       
        if Eqstr(val(ii:fac), VAR('AMBMAE'))
         
            ACT(i:val(ii:1), 'N°MAE')
*            ACT(i:FAC,BuscarCampo('ESPECIES', 'CodMAEContado', 'Codigo', fbn['Especie']))
            ACT(F:3, 'Agente Mercado Abierto ' ~ BuscarCampo('CLIENTES','NrMAE','Codigo', VAR('VEHICULODE')))
        else
             if Eqstr(val(ii:fac), VAR('AMBBYMA'))
                 ACT(i:val(ii:1), 'N°BYMA')
*                 ACT(i:FAC,BuscarCampo('ESPECIES', 'CodAlfCajaValores', 'Codigo', fbn['Especie']))
                 ACT(F:3, 'Agente BYMA ' ~ BuscarCampo('CLIENTES','NrBYMA','Codigo', VAR('VEHICULODE')))
             endif       
        endif
           
*        ACT(i:FAC, IIF(Eqstr(val(ii:fac), VAR('AMBMAE')), ~FBN['NrMAE'],  IIF(Eqstr(FBN['Mercado4'], VAR('AMBBYMA')),' Nro.BYMA '~FBN['NrBYMA'],FBN['Mercado4'])))

        
*        IIF(Eqstr(FBN['Mercado4'], VAR('AMBMAE')), BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',fbn['NrOperacion']), BuscarCampo('OPERACIONES', 'NrBYMA','NrOperacion',fbn['NrOperacion'])))
        
                
        ACT(aa:4,fbn['NrOperacion'])
        if Incluido(Val(c:fac),'TIC|TIV|TIFC|TIFV|FXA|FXAT|FXC|FXCT|FXV|FXVT') y BuscarCampo('Operaciones','PaseCB','NrOperacion',fbn['NrOperacion'])=1
          ACT(d:FAC, Val(d:FAC)~' x Pase')
          ACT(aa:4, BuscarCampo('OPERACIONES','OperacionRef','NrOperacion',fbn['NrOperacion']))
        endif
      endif
    else
      ** Es es Mercado regulados de FX (ROFEX)
      if fbn['Cantidad'] > 0
      
        *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
        If(FBN['CBFallas'] = 1)
            ACN(f:fac, -fbn['CantPagada'])
            SCN(to:2, ABS(fbn['CantPagada']))
        Else
            ACN(f:fac, -fbn['Cantidad'])
            SCN(to:2, ABS(fbn['Cantidad']))
        EndIf
      
   
      ELSE
        *Si es una trans. fallada, se le agrega la cantidad que se pagó, si no el total. CAL 23/11/2022
            If(FBN['CBFallas'] = 1)
              ACN(e:fac, fbn['CantPagada'])
              SCN(to:2, ABS(fbn['CantPagada']))
            Else
              ACN(e:fac, -fbn['Cantidad'])
              SCN(to:2, ABS(fbn['Cantidad']))
            EndIf
      ENDIF
      
    endif

    *--- Esta confirmado si/no?
    ACN(aa:5,0)
    SQL.ADD("Select Distinct * FROM "~DBO~".OPERACIONESBITS B ")
    SQL.ADD("where B.NrOperacion = '"~FBN('NrTrans2')~"' ")
    SQL.ADD("  and B.NrBit In (70) and B.Valor = '1' ")
    Recorrer SQL
      dfa
      ACN(aa5, 1)
    Proximo

    if Val(aa:5) = 1 o Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'PMU|PME')
**      ACT(h:FAC, 'OK')
    else
**      ACT(h:FAC, 'Falta')
      ACN(jj1,1)
    endif

  proximo
  IFA
  IFA
  ACT(a:FAC, 'Total')
  ACN(e:FAC, Sum(e:21..e:FAC-1))
  ACN(f:FAC, Sum(f:21..f:FAC-1))

  *** Agregado el 8.8.2000 por pedido de Cristina Segato
  if fbn['VTeorico'] <> 1
    act(a:fac+1, 'VR')
    ACN(e:FAC+1, Val(e:fac)*fbn['VTeorico'])    
    ACN(f:FAC+1, Val(f:fac)*fbn['VTeorico'])
    ACN(fa:2, FAC+1)
  endif

  ACN(fa1, fac)
  ACN(z3, Val(e:FAC) + Val(f:FAC))
  
  AgregarMarco(g:20..i:FAC, 1)
  AgregarMarco(a:20..i:FAC, 1)
  AgregarMarco(a:FAC..i:FAC, 2,0,Exe('COLOR'))
  SetFilaActual(FAC+3)

  if Incluido(fbn['TipoTr2'],'DEP|RET')
    if Eqstr(fbn['TipoTr2'],'RET')
* FJL 07/11/18 - Se agrega Moneda - Pto 1 Issue 3351
      ACT(f:FAC, fbn['Especie'])
      ACT(d:FAC+1, 'Total a Pagar :')
      ACN(f:FAC+1, ABS(Val(to:2)-Val(to:1)))
    else
* FJL 07/11/18 - Se agrega Moneda - Pto 1 Issue 3351
      ACT(e:FAC, fbn['Especie'])
      ACT(d:FAC+1, 'Total a Cobrar :')
      ACN(e:FAC+1, ABS(Val(to:2)-Val(to:1)))
    endif
    
    AlinearCeldas(e:FAC..f:FAC+1,'D')
    AgregarMarco(c:FAC..f:FAC+2,2,0,Exe('COLOR'))
  endif

  ACT(a:FAC+5, 'Pago Liberado / Completado')
  ACT(f:FAC+9, 'Por '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
  AgregarMarco(a:FAC+5..i:FAC+9,2,0)

** FJL 17/12/18 - No se ponen observaciones si es neto de Mercado regulado de moneda
   if Val(z:7)=0
     ** No es Mercado regulados de FX (ROFEX)
** FJL 07/11/18 - Se agrega datos de confirmacion de operaciones - Pto 4 Issue 3351
    ACT(a:FAC+11, 'Observaciones Confirmacion')
    SetFont(a:FAC+11,3)
    if Val(ac:1)>0
      recorrer&i 1,Val(ac:1)
        SQL.ADD("SELECT Contacto, Fecha, Observaciones, Usuario FROM "~DBO~".CONFIRMACIONESOP WHERE NrOperacion = '"~Val(ad:&i)~"' ")
        Recorrer SQL
          dfa
          ACT(a:FAC+11+&i, fbn('Usuario'))
          ACT(b:FAC+11+&i, Val(ad:&i))
          ACT(c:FAC+11+&i, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Val(ad:&i)))
          ACT(d:FAC+11+&i, fbn('Contacto'))
          ACT(e:FAC+11+&i, Copy(fbn('Observaciones'),1,20))
        Proximo
      Proximo
    endif
    AgregarMarco(a:FAC+11..i:FAC+12+Val(ac:1),2,0)
  endif
  
  ACT(a:FAC+14+Val(ac:1), 'Preparado por : '~BuscarCampo('Usuarios','Nombre','Codigo',USUARIOACTIVO))
  ACT(e:FAC+14+Val(ac:1), ' ')
