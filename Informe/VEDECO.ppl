* HojaVisible(SI)
CrearDialogo
  String1    : 'Nombre PMG'                           ;;;;NO;;;;;'DEVECO';
  Fecha1     : 'Fecha'                                ;;;;;;;;;FinDeMes(PriDeMes(Fsys,SI,'ARG')-1,NO,'ARG')
  Especie1   : 'Especie '                             ;;;;;;NOVACIO(Dialogo.Especie1);'Especie Inexistente';NO;'WTI';;
  Lista1     : 'Vehiculo'                             ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

*- Construyo la Extencion
If Vacio(Dialogo.Lista1)
   ACT(z1,'TODOS')
Else
   ACT(z1,Dialogo.Lista1)
EndIf

ACT(z1,val(z1)~'/'~Dialogo.Fecha1)

ACT(z1,val(z1)~'/'~Dialogo.Especie1)

if SQL("Select Count(*) from "~DBO~".OBJETOS where Codigo='"~Dialogo.String1~"' and Extension='"~VAL(z1)~"' ")=0
   MessageBox('No existe el Reporte Solicitado '~Dialogo.String1~' '~val(z1))
else
   Message('Recuperando '~Dialogo.String1~' '~val(z1))
   LeerPMG(Dialogo.String1, VAL(z1))
endif

Impresion(1,2)
acn(z2,fac)
* LimitesVision(h:fac+2)
