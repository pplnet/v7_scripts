ACT(t:FAC, 'SecuritiesAccountOfCounterparty')
ACT(u:FAC, 'MovementOfSecurities')
ACT(v:FAC, 'TransactionType')
ACT(w:FAC, 'SettlementMethod')
ACT(x:FAC, 'PaymentType')
ACT(y:FAC, 'Status')


AlinearCeldas(a:FAC..h:FAC,'I')
AlinearCeldas(i:FAC..i:FAC,'D')
AlinearCeldas(j:FAC..l:FAC,'I')
SetFont(a5..y:FAC,2)
AgregarMarco(a:FAC..y:FAC,2,0,Exe('COLOR'))

ACN(xy1,FAC)
SetFilaActual(FAC)

SQL.ADD(" SELECT *  from "~DBO~".TRANSFCVA3 T")
**SQL.ADD(" where T.Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" where T.FechaMatch between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.TipoTr1)
   SQL.ADD("  and T.TipoTr2 = '"~Dialogo.TipoTr1~"' ")
else
   SQL.ADD(" AND TipoTr2 IN ('DTP','RTP','DRT') ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("  and T.Especie = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("order by T.Fecha ")
watch(SQL.Batch)
Recorrer SQL
  ACN(in2, fac)
  
