MostrarCuadroDeMensajes
CrearDialogo
  Especie1  :'Especie'       ;  ; ;;  ;  ;Vacio(Dialogo.Especie1) o [NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y NOT DesciendeDeEspecie(Dialogo.Especie1,'CUPON')];'Debe Ingresar una Especie Valida';NO;;;;;;"Status = 'HAB' and Jerarquia Like '002%' and IsNull(EsCupon,'NO')='NO ' "
  Tipotr1    : "Transaccion"  ; ;;;;;Vacio(Dialogo.TipoTr1) o Incluido(Dialogo.TipoTr1,'DTP|RTP|DRT');'Debe Ingresar un Tipo Valido';NO;;;;;;" Codigo in ('DTP','RTP','DRT') "
  Fecha1     : "Fecha Desde"  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2     : "Fecha Hasta"  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(k:2,'Fecha : '~Var('FECHASYS'))
SetFont(k:2..k:2,1)

ACT(a:FAC, "Transferencias CV A3")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)

if NoVacio(Dialogo.Especie1)
   ACT(a:FAC+1, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
   ACT(a:FAC+1, 'Especies : Todas')
endif

if NoVacio(Dialogo.Tipotr1)
    ACT(a:FAC+2, 'Tipo TR : '~Dialogo.Tipotr1)
else
    ACT(a:FAC+2, 'Tipo TR : DTP RTP DRT' )
endif

ACT(a:FAC+3, 'Desde Fecha : '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Hasta Fecha : '~Dialogo.Fecha2)


SetFilaActual(FAC+5)

ACT(a:FAC, 'InstructionReference')
ACT(b:FAC, 'TradeDate')
