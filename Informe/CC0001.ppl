SQL.ADD(" Select distinct O.Cliente1, 'Liq. de Titulos' Tipo ")
*-I
*SQL.ADD(" From "~DBO~".TRANSACCIONES2 T,"~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E, ")
*SQL.ADD(" "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MODELOSASIENTO MA, "~DBO~".TIPOSOPERACION TI, "~DBO~".CUENTAS CTA ")
 SQL.ADD(" From "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN  "~DBO~".CUENTAS CTA ON T.Cuenta1 = CTA.Codigo ,"~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E, ")
 SQL.ADD(" "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".MODELOSASIENTO MA, "~DBO~".TIPOSOPERACION TI ")
 *-F
SQL.ADD(" where ((M.FechaEje = '"~IdxDate(Dialogo.Fecha1)~"' AND M.EnteCustodia not IN ("~Pipe2Comillas(Val(AC:1))~") ) OR (M.FechaEje = '"~IdxDate(Dialogo.Fecha1)~"' AND M.EnteCustodia IN ("~Pipe2Comillas(Val(AC:1))~"))) ")
SQL.ADD("   AND T.Fecha1 >= "~IdxDate2(Habiles(FSYS,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND   (C.NrCuenta IS NULL OR C.NrCuenta= '' OR C.NrCuenta= ' ') ")
SQL.ADD("   and O.TipoOp  = TI.Codigo ")
SQL.ADD("   and (O.TipoOp NOT IN ('TIDE','TICT','TIPO','TICO') OR M.FechaMov <> O.FechaOp ) ")
*-i
*SQL.ADD("   and T.Cuenta1 *= CTA.Codigo ")
*-f
SQL.ADD("   and M.Especie = O.Especie   ")
SQL.ADD("   and E.Codigo  = O.Especie   ")
SQL.ADD("   and T.NrTrans = M.NrTrans2 ")
SQL.ADD("   and M.Cliente = C.Codigo ")
SQL.ADD("   and ((C.Alias1 = 'CP' AND M.Status  = 'CLI') OR O.TipoOp NOT IN ('CTC','CTP','VTC','VTP','LIC') ) ")
SQL.ADD("   and M.NrSaldo = 1 ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
SQL.ADD("   and O.TipoOp      = MA.TipoOp ")
SQL.ADD("   and MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASILT'))~") ")
SQL.ADD("   and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and O.NrOperacion3 Not IN (SELECT NrOperacion3 FROM "~DBO~".OPERACIONES WHERE NrOperacion <> O.NrOperacion AND NrOperacion3 IS NOT NULL ) ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select distinct O.Cliente1, 'Dev. de Intereses' Tipo ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVDEVENGADOS M, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.Especie     = E.Codigo  ")
SQL.ADD(" AND   O.Cliente1    = C.Codigo  ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" AND   O.NrOperacion = M.NrOperacion  ")
SQL.ADD(" AND   O.NrOperacion = OB.NrOperacion ")
SQL.ADD(" AND   (C.NrCuenta IS NULL OR C.NrCuenta= '' OR C.NrCuenta= ' ') ")
SQL.ADD(" AND   OB.NrBit IN (30,31) AND OB.Valor <>'1' ")
SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASDEV'))~") ")
SQL.ADD(" AND   O.FechaOp  <= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD(" AND   O.FechaVto >= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD(" AND (    (M.Fecha="~IdxDate2(Dialogo.Fecha1)~" )   ")
SQL.ADD("       OR (O.FechaOp<O.FechaCargaSys AND O.FechaCargaSys="~IdxDate2(Dialogo.Fecha1)~" AND M.Fecha<="~IdxDate2(Dialogo.Fecha1)~" ) ) ")
* -------------------------------------------------------------------- *
SQL.ADD(" AND   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD(" AND   O.FechaOp >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" Order By 2,1 ")
Recorrer SQL
   ACT(a:fac, fbn('Tipo'))
   ACT(b:fac, fbn('Cliente1'))
