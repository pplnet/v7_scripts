MostrarCuadroDeMensajes
CrearDialogo
  Fecha1: 'Fecha a Generar' ;;;;;;Dialogo.Fecha1<>0;;NO;fsys
  Vehiculo1: 'Vehiculo'     ;;;;;;NOVACIO(Dialogo.Vehiculo1);;NO;VAR('VEHICULODE')
FinDialogo

If NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,9,B')


ACT(a:2, 'Errores en la Contabilidad a Generar - '~Dialogo.Fecha1)
SetFont(a:2, 3)

SetFilaActual(4)

ACD(fe:1, habiles(Dialogo.Fecha1,-1,'ARG'))

act(ac:1, VAR('MERCAACMC'))

* Control de Cotizaciones BNA
(.'CTRLBNA'.)

ACT(a:fac, 'Cuentas por Contraparte Faltantes')
message(Val(a:fac))
SetFont(a:fac, 3)
ifa
ACT(a:fac, 'Tipo de Asiento')
ACT(b:fac, 'Cliente')
AgregarMARCO(a:fac..b:fac, 0,0,exe('COLOR6'))
SetFont(a:fac..Z:FAC, 1)

SQL.ADD(" Select distinct O.Cliente1, 'Concertacion' Tipo ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, ") 
SQL.ADD(" "~DBO~".MODELOSASIENTO MA, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where O.Especie  = E.Codigo ")
SQL.ADD(" AND   O.Cliente1 = C.Codigo ")
SQL.ADD(" AND   (C.NrCuenta IS NULL OR C.NrCuenta= '' OR C.NrCuenta= ' ') ")
SQL.ADD(" AND   O.NrOperacion = OB.NrOperacion ")
SQL.ADD(" AND   OB.NrBit NOT IN (30,31) AND OB.Valor ='1' ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" AND   MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIC'))~") ")
SQL.ADD(" AND   O.FechaCargaSys = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   O.FechaOp  >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select distinct O.Cliente1, 'Dif. de Cambio' Tipo  ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T,"~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO MA, "~DBO~".ESPECIES E2, "~DBO~".CLIENTES C ")
SQL.ADD(" where ((M.FechaEje = '"~IdxDate(Dialogo.Fecha1)~"' AND M.EnteCustodia not IN ("~Pipe2Comillas(Val(AC:1))~") ) OR (M.FechaEje = '"~IdxDate(Dialogo.Fecha1)~"' AND M.EnteCustodia IN ("~Pipe2Comillas(Val(AC:1))~"))) ")
SQL.ADD("   AND T.Fecha1  >= "~IdxDate2(Habiles(FSYS,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND   (C.NrCuenta IS NULL OR C.NrCuenta= '' OR C.NrCuenta= ' ') ")
SQL.ADD("   and M.Especie  = O.ContraEspecie ")
SQL.ADD("   and E.Codigo   = O.ContraEspecie ")
SQL.ADD("   and O.Cliente1 = C.Codigo  ")
SQL.ADD("   and E2.Codigo  = O.Especie ")
SQL.ADD("   and O.TipoOp IN ('TIC','TIFC','TIV','TIFV') ")
SQL.ADD("   and T.NrTrans = M.NrTrans2      ")
SQL.ADD("   and M.Cliente = O.Cliente1      ")
SQL.ADD("   and M.Especie = O.ContraEspecie ")
SQL.ADD("   and O.ContraEspecie <> '"~VAR('MONELOCA')~"' ")
SQL.ADD("   and M.NrSaldo = 1 ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion  ")
SQL.ADD("   and O.TipoOp      = MA.TipoOp      ")
SQL.ADD("   and MA.TipoAsiento IN ("~Pipe2Comillas(VAR('TIPASIDIFC'))~")   ")
SQL.ADD("   and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("  and O.NrOperacion3 Not IN (SELECT NrOperacion3 FROM "~DBO~".OPERACIONES WHERE NrOperacion <> O.NrOperacion AND NrOperacion3 IS NOT NULL ) ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select distinct O.Cliente1, 'Liq. de Fondos' Tipo ")
