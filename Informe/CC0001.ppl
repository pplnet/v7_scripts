SQL.ADD(" SELECT Distinct O.Especie, E.Nombre, E.CodNumCajaValores FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.Especie = E.Codigo ")
SQL.ADD(" AND   O.FechaCargaSys = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   ( (E.CodNumCajaValores is null or E.CodNumCajaValores='' or E.CodNumCajaValores=' ') ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(Dialogo.Fecha1)~")  ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~") ) ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT Distinct O.Especie, E.Nombre, E.CodNumCajaValores FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE O.Especie     = E.Codigo ")
SQL.ADD(" AND   O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND   M.FechaEje    = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   ( (E.CodNumCajaValores is null or E.CodNumCajaValores='' or E.CodNumCajaValores=' ') ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(Dialogo.Fecha1)~" and PrecioContable<>0)  ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" and PrecioContable<>0) ) ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT Distinct O.Especie, E.Nombre, E.CodNumCajaValores FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.Especie = E.Codigo ")
SQL.ADD(" AND   O.FechaOp <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   O.FechaVto > "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   O.TipoOp IN ('TICO','TIPO','TICT','TIDE','TIPP','TIPA') ")
SQL.ADD(" AND   ( (E.CodNumCajaValores is null or E.CodNumCajaValores='' or E.CodNumCajaValores=' ') ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(Dialogo.Fecha1)~" and PrecioContable<>0)  ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" and PrecioContable<>0) ) ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT Distinct O.Especie, E.Nombre, E.CodNumCajaValores FROM "~DBO~".SALDOS O, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.Especie = E.Codigo ")
SQL.ADD(" AND   O.Saldo <> 0 ")
SQL.ADD(" AND   ( (E.CodNumCajaValores is null or E.CodNumCajaValores='' or E.CodNumCajaValores=' ') ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(Dialogo.Fecha1)~" and PrecioContable<>0 )  ")
SQL.ADD("        OR ")
SQL.ADD("       O.Especie NOT IN (SELECT Codigo FROM "~DBO~".COTIZACIONES WHERE Codigo = O.Especie AND Fecha="~idxdate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" and PrecioContable<>0 ) ) ")

Recorrer SQL
   ACT(b:fac, fbn('Especie'))
   ACT(c:fac, fbn('Nombre'))
   ACT(d:fac, fbn('CodNumCajaValores'))
   ACN(e:fac, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo = '"~FBN('Especie')~"' AND Fecha="~idxdate2(Dialogo.Fecha1)~" "))
   ACN(f:fac, SQL("SELECT PrecioContable FROM "~DBO~".COTIZACIONES WHERE Codigo = '"~FBN('Especie')~"' AND Fecha="~idxdate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" "))
   If CeldaVacia(d:fac)
      ACT(a:fac, 'Falta Codigo CV ')
   Endif
   iF Val(e:fac)=0 o  Val(f:fac)=0
      ACT(a:fac, Val(a:fac)~' // Falta Cot.Contable')
   Endif
