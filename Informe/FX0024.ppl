ModoReproceso(ConDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'FechaOp'                       ;;;;;;;;;FSYS
  Especie1:  'Moneda'                        ;;;;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Mercado1:  'Mercado'                       ;3;1;;;;;;;    
  Radio2:    'Posicion|Spot|Forward|Ambos'   ;;;;;;;;;2
  Radio4   : '|C/V|Opciones|Todo'            ;5;;;NO;NO;;;;2
  Radio1:    'Cartera|Trading|General|Ambas' ;5;;;NO;NO;;;;2
  Radio3:    'Tipo|Compras|Ventas|Ambas'         ;;;;;;;;;2
  Vehiculo1 : 'Vehiculo'   ;;;;;;[NoVacio(Dialogo.Vehiculo1)] Y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) O Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;Var('VEHICULODE');;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo))," Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");;;;;
  Book1:      'Book'       ;;;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Fecha2:     'FechaVto'   ;;;;Dialogo.Radio2=1;Dialogo.Radio2=1;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(5)
ACT(a:FAC, 'Fecha: '~Dialogo.Fecha1)
ifa
If NoVacio(Dialogo.Especie1)
  ACT(a:FAC, 'Moneda : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
  ACT(a:FAC, 'Moneda : Todas')
Endif
ifa
If NoVacio(Dialogo.Mercado1)
  ACT(a:FAC, 'Mercado : '~Dialogo.Mercado1)
Else
  ACT(a:FAC, 'Mercados : Todos')
Endif
ifa
If Dialogo.Radio3=0
  ACT(a:FAC, 'Compras')
Else
  If Dialogo.Radio3=1
    ACT(a:FAC, 'Ventas')
  Else 
    ACT(a:FAC, 'Compras y Ventas')
  Endif
Endif
ifa
ACT(a:FAC, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
ifa
IF NoVacio(Dialogo.Book1)
    ACT(A:fac, 'Book: '~Dialogo.Book1)
ELSE
    ACT(A:fac, 'Book: Todos')
ENDIF
SetFilaActual(FAC+2)
ACT(d:fac, "Operaciones Concertadas en el Dia - ")
If Dialogo.Radio2=0
   ACT(d:fac, Val(d:fac)~'Spot' )
Else
   If Dialogo.Radio2=1
     ACT(d:fac, Val(d:fac)~'Forward' )
   Else
     ACT(d:fac, Val(d:fac)~'Spot y Forward' )
   Endif
Endif

SetFont(a:1..a:fac,2)
SetFont(d:fac,3)

SetFilaActual(fac+2)

ACT(a:FAC, "Operacion")
ACT(b:FAC, "TipoOp")
ACT(c:FAC, "Mercado")
ACT(d:FAC, "Cliente")
ACT(e:FAC, "Moneda")
ACT(f:FAC, "Cantidad")
ACT(g:FAC, "Precio")
ACT(h:FAC, "Total")
ACT(i:FAC,   "FechaVto")
ACT(i:FAC+1, "Moneda")
ACT(j:FAC,   "FechaVto")
ACT(j:FAC+1, "Mon. de Pago")
ACT(k:FAC, "Corredor")
ACT(l:FAC, "Comision")


AlinearCeldas(a:FAC..l:FAC+1,'C')
SetFont(a:fac..n:FAC+1,2)
AgregarMarco(a:FAC..l:FAC+1,1,0,Exe('COLOR6'))

ifa

ACN(FI:1, fac)
ACT(ea:1, '')
ACD(fj:1, 0)
ACN(pj:1, 0)
ACT(cp:1, '' )

IF Dialogo.Radio2 = 0 o  Dialogo.Radio2 = 2
  SQL.ADD(" Select * from ")
  SQL.ADD(" (Select Distinct O.NrOperacion, ")
  SQL.ADD("        Especie = Case When M.Cantidad < 0 AND O.TipoOp IN ('FXA','FXAT') Then O.ContraEspecie ")
  SQL.ADD("                       Else O.Especie END, ")
  SQL.ADD(" O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli1, ")
  SQL.ADD(" O.TipoOp, O.FechaVto, O.FechaPago, O.FechaOp, E.Nombre, O.Corredor,")
  SQL.ADD(" O.TotalComisiones, O.SectorRB, O.PaseCB, O.Arbitraje, O.PrecioEj, O.FechaEj, ")
  SQL.ADD(" O.Cotizacion1, O.Cotizacion2, O.ContraEspecie, ")
  SQL.ADD(" FX = Case When M.Cantidad > 0 Then 'Compra' ")
  SQL.ADD("           When M.Cantidad < 0 Then 'Venta' END, ")
  SQL.ADD(" O.Precio3, O.Precio4, O.Plazo, ")
  SQL.ADD(" O.TotalBrutoCli2, O.Precio2, O.TasaBase, O.FechaAltaMAE, O.FechaBajaMAE, M.NrSaldo, ")
  SQL.ADD(" O.TotalBrutoCli3, O.TotalNetoCli3, O.Book1, ")
  SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg ")  
  SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E ")
  SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
  SQL.ADD(" AND E.Codigo    = M.Especie ")
  SQL.ADD(" AND (O.Especie  = M.Especie OR (O.ContraEspecie=M.Especie AND TipoOp IN ('FXA','FXAT')) ) ")
  SQL.ADD(" AND O.FechaOp   = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND M.FechaMov  = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  If Dialogo.Radio2=1 y Dialogo.Fecha2<>0
    * Para los fwd a una fecha determinada
    SQL.ADD(" AND M.FechaEj = "~idxdate2(Dialogo.Fecha2)~" ")
  Endif
  IF NoVacio(Dialogo.Book1)
    SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"' ")
  Endif
  IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND (('"~Dialogo.Especie1~"' = O.Especie AND O.TipoOp Not IN ('FXA','FXAT'))  OR (O.TipoOp IN ('FXA','FXAT') AND ((M.Especie = '"~Dialogo.Especie1~"' AND M.Cantidad > 0) OR (O.ContraEspecie = '"~Dialogo.Especie1~"' AND M.Cantidad < 0)))) ")
  Endif
*IF Dialogo.Radio2 = 0
*   SQL.ADD(" AND (M.NrSaldo = 31 OR M.NrSaldo = 11) ")
*ENDIF
*IF Dialogo.Radio2 = 1
*   SQL.ADD(" AND (M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44 OR M.NrSaldo = 21) ")
*   SQL.ADD(" AND (M.NrSaldo = 21 OR M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44) ")
*ENDIF
*IF Dialogo.Radio2 = 2
*   SQL.ADD(" AND (M.NrSaldo = 31 OR M.NrSaldo = 11 OR M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44 OR M.NrSaldo = 21) ")
*ENDIF
  SQL.ADD(" AND (M.NrSaldo = 31) ")
  IF Dialogo.Radio3 = 0
    SQL.ADD(" AND M.Cantidad > 0 ")
  Endif
  IF Dialogo.Radio3 = 1
    SQL.ADD(" AND M.Cantidad < 0 ")
  Endif
  IF Dialogo.Radio3 = 2
    SQL.ADD(" AND M.Cantidad <> 0 ")
  Endif
  SQL.ADD(" AND M.NrSaldo not in (51,45) ")
endif

IF Dialogo.Radio2 = 2
  SQL.ADD("UNION")
endif

IF Dialogo.Radio2 = 1 o Dialogo.Radio2 = 2
  SQL.ADD(" Select Distinct O.NrOperacion, O.Especie , ")
  SQL.ADD(" O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli1, ")
  SQL.ADD(" O.TipoOp, O.FechaVto, O.FechaPago, O.FechaOp, E.Nombre, O.Corredor,")
  SQL.ADD(" O.TotalComisiones, O.SectorRB, O.PaseCB, O.Arbitraje, O.PrecioEj, O.FechaEj, ")
  SQL.ADD(" O.Cotizacion1, O.Cotizacion2, O.ContraEspecie, ")
  SQL.ADD(" FX = Case When M.Cantidad > 0 Then 'Compra' ")
  SQL.ADD("           When M.Cantidad < 0 Then 'Venta' END, ")
  SQL.ADD(" O.Precio3, O.Precio4, O.Plazo, ")
  SQL.ADD(" O.TotalBrutoCli2, O.Precio2, O.TasaBase, O.FechaAltaMAE, O.FechaBajaMAE, M.NrSaldo, ")
  SQL.ADD(" O.TotalBrutoCli3, O.TotalNetoCli3, O.Book1, ")
  SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg ")
  SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJEFUT M, "~DBO~".ESPECIES E ")
  SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
  SQL.ADD(" AND E.Codigo    = M.Especie ")
  SQL.ADD(" AND O.Especie  = M.Especie  ")
  SQL.ADD(" AND O.FechaOp   = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND M.FechaMov  = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  If Dialogo.Radio2=1 y Dialogo.Fecha2<>0
    * Para los fwd a una fecha determinada
    SQL.ADD(" AND M.FechaEj = "~idxdate2(Dialogo.Fecha2)~" ")
  Endif
  IF NoVacio(Dialogo.Book1)
    SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"' ")
  ENDIF
  IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND '"~Dialogo.Especie1~"' = O.Especie ")
  ENDIF
*IF Dialogo.Radio2 = 0
*   SQL.ADD(" AND (M.NrSaldo = 181 ) ")
*ENDIF
*IF Dialogo.Radio2 = 1
*   SQL.ADD(" AND (M.NrSaldo=191) ")
*ENDIF
*IF Dialogo.Radio2 = 2
*   SQL.ADD(" AND (M.NrSaldo = 181 OR M.NrSaldo = 191) ")
*ENDIF
  SQL.ADD(" AND (M.NrSaldo = 41 OR M.NrSaldo = 42) ")
  IF Dialogo.Radio3 = 0
    SQL.ADD(" AND M.Cantidad > 0 ")
  ENDIF
  IF Dialogo.Radio3 = 1
    SQL.ADD(" AND M.Cantidad < 0 ")
  ENDIF
  IF Dialogo.Radio3 = 2
    SQL.ADD(" AND M.Cantidad <> 0 ")
  ENDIF
endif
SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
*SQL.ADD(" Order By O.Book1, O.Especie, O.FechaVto, O.Cliente1 ")
SQL.ADD(" Order By Book1, 2, FechaVto, Cliente1 ")
watch(sql.batch())
Recorrer SQL
    IF Not Eqstr(fbn('Book1'), Val(BK:1))

       If NoVacio(Val(BK:1))
          ACT(a:fac, 'Total Book --- >')
          ACN(h:fac, SUM(h:fac, h:Val(fi:3)..h:fac) )
          IF Novacio(Dialogo.Especie1)
          ACN(f:fac, SUM(f:fac, f:Val(fi:3)..f:fac) )
          Endif
          SetFont(A:fac..h:fac, 2)
          ifa
       Endif

       ifa
       ACT(A:fac, 'Book: '~fbn('Book1'))
       SetFont(A:fac, 2)
       AgregarMarco(A:fac..l:fac, 0, 0, Exe('COLOR6'))
       ifa
       ACN(FI:2, fac)
       ACN(fi:3, fac)
    ENDIF

    message(fbn('NrOperacion')~'  '~fbn('Especie'))
    ACT(a:fac, fbn('NrOperacion'))
    ACLO(a:fac, fbn('NrOperacion'))
    ACT(b:fac, fbn('TipoOp'))
    ACT(c:fac, fbn('MercNeg'))
    ACT(d:fac, fbn('Cliente1'))
    ACT(e:fac, fbn('Especie'))
    ACN(f:fac, fbn('Cantidad')*IIf(Eqstr(mirt(trim(fbn('FX'))),'Compra'),1,-1))
    ACD(i:fac, fbn('FechaVto'))
    ACD(j:fac, fbn('FechaPago'))
    ACT(k:fac, fbn('Corredor'))
    ACN(l:fac, fbn('TotalComisiones'))

    IF [Incluido(fbn('TipoOp'), 'FXA|FXAT')]
        IF Not Eqstr(mirt(trim(fbn('FX'))), 'Compra')
           ACT(e:fac, fbn('ContraEspecie'))
           ACN(f:fac, -fbn('TotalBrutoCli1'))
           ACN(g:fac, fbn('Precio1'))
           ACN(h:fac, fbn('Cantidad')*IIf(Eqstr(mirt(trim(fbn('FX'))),'Compra'),-1,1))
        ELSE
           ACN(f:fac, fbn('Cantidad'))
           ACN(g:fac, fbn('Precio1'))
           ACN(h:fac, fbn('TotalBrutoCli1')*IIf(Eqstr(mirt(trim(fbn('FX'))),'Compra'),-1,1))
        ENDIF
    ELSE
       ACN(f:fac, fbn('Cantidad')*IIf(Eqstr(mirt(trim(fbn('FX'))),'Compra'),1,-1))
       ACN(g:fac, fbn('Precio1'))
       ACN(h:fac, fbn('TotalBrutoCli1')*IIf(Eqstr(mirt(trim(fbn('FX'))),'Compra'),-1,1))
    ENDIF
    ACT(BK:1, fbn('Book1'))
    SetFont(a:fac..z:fac,1)
Proximo

