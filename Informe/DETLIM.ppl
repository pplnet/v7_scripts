*ModoReproceso(ConDialogo)
CrearDialogo
   Cliente1   : 'Cliente'  ;;;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar un Cliente';NO;
   TipoLimite1: 'Limite'   ;;;;;;NoVacio(Dialogo.TipoLimite1) y EqStr(BuscarCampo('TIPOSLIMITE','Clase','Codigo',Dialogo.TipoLimite1),'C');'Debe ingresar un Tipo de Limite de Credito';NO;
   Fecha1     : 'Fecha'    ;;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
   Check1     : 'Mas 72Hs' ;;;;;;Dialogo.Check1>=0;'Si/No';NO;0;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(a:4, 'Detalle de Limites de Credito')
ACT(a:5, 'Cliente : '~Dialogo.Cliente1)
ACT(a:6, 'Limite : '~Dialogo.TipoLimite1)
ACT(a:7, 'Fecha : '~Dialogo.Fecha1)

ACT(a:9, 'Cliente')
ACT(b:9, 'Limite')
ACT(c:9, 'Fecha')
ACT(d:9, 'Especie')
ACT(e:9, 'Operacion')
ACT(f:9, 'Tipo')
ACT(g:9, 'Cantidad')
ACT(h:9, 'Acumulado')
AgregarMarco(a:9..h:9,1,1,Exe('COLOR'))
SetFont(a:1..h:9,2)

SetFilaActual(9)

** Selecciono los movimientos de limites **
SQL.ADD(" SELECT ML.*, OP.TipoOp, OP.Cliente1 FROM "~DBO~".MOVLIMITES ML, "~DBO~".OPERACIONES OP, "~DBO~".ESPECIES E")
SQL.ADD(" WHERE  ML.NrOperacion = OP.NrOperacion ")
SQL.ADD(" AND    ML.Cliente     = '"~Dialogo.Cliente1~"' ")
SQL.ADD(" AND    ML.Especie     = E.Codigo       ")
SQL.ADD(" AND    E.Tipo         = 'MON'          ")
If Incluido(Dialogo.TipoLimite1,'MAXMONEU|SETTLEMENT|')
   If Dialogo.Check1=0
      SQL.ADD("  AND OP.FechaVto='"~IdxDate(Dialogo.Fecha1)~"' ")
   Else 
      SQL.ADD("  AND OP.FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' ")
   EndIf
Else
   If Incluido(Dialogo.TipoLimite1,'VOLUMENCON')
      SQL.ADD("  AND OP.FechaOp='"~IdxDate(Dialogo.Fecha1)~"' ")
   Else
      SQL.ADD(" AND (OP.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' AND (OP.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' or OP.RB10=0))")
   Endif
EndIf
SQL.ADD("  AND  ML.Bits   = 'P' ")
SQL.ADD("  AND  ML.Limite = '"~Dialogo.TipoLimite1~"' and ML.NrOperacion<>'TRANSPOR' ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT ML.*, 'TRANSPOR' as TipoOp, ML.Cliente Cliente1 FROM "~DBO~".MOVLIMITES ML ")
SQL.ADD(" WHERE  ML.NrOperacion = 'TRANSPOR'                    ")
SQL.ADD(" AND    ML.Cliente     = '"~Dialogo.Cliente1~"'        ")
SQL.ADD(" AND    ML.Bits        = 'P'                           ")
SQL.ADD(" AND    ML.FechaLim    = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND    ML.Limite      = '"~Dialogo.TipoLimite1~"'     ")
SQL.ADD(" ORDER BY ML.Especie, ML.FechaMov ")

Recorrer SQL
  If Not EqStr(val(z1),FBN['Especie']) y NoVacio(val(z1)) y EqStr(Dialogo.TipoLimite1,'SETTLEMENT') 
     If  Val(z2)>0
         ACT(f:fac,'Total ...')
         ACN(h:fac,val(z2))
         SetFont(f:fac..f:fac,2)
         SetFont(h:fac..h:fac,1)
         Ifa
     else
         BorrarCeldas(a:Val(z3)..h:FAC)
         SetFilaActual(Val(z3))
     Endif         
  EndIf

  If Not EqStr(val(z1),FBN['Especie'])
     ACT(z1,FBN['Especie'])
     ACN(z2,0)
     ACN(z3, FAC)
  EndIf

* 26/05/2005 ACT(a:FAC, FBN['Cliente']~' - '~Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,25))
  ACT(a:FAC, FBN['Cliente1']~' - '~Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,25))
  ACT(b:FAC, FBN['Limite'])
  ACT(c:FAC, FBN['FechaMov'])
  ACT(d:FAC, FBN['Especie'])
  ACT(e:FAC, FBN['NrOperacion'])
  If Not EqStr(val(e:fac),'TRANSPOR')
     ACLO(e:FAC, FBN['NrOperacion'])
  EndIf

  ACT(f:FAC, FBN['TipoOp'])
  ACN(g:FAC, FBN['Monto'])

  SCN(z2,val(g:fac))
  ACN(h:FAC, val(z2))

  SetFont(a:fac..h:fac,1)
Proximo

If EqStr(Dialogo.TipoLimite1,'SETTLEMENT') 
   If  Val(z2)<>0
         Ifa
         ACT(f:fac,'Total ...')
         ACN(h:fac,val(z2))
         SetFont(f:fac..f:fac,2)
         SetFont(h:fac..h:fac,1)
     else
         BorrarCeldas(a:Val(z3)..h:FAC)
         SetFilaActual(Val(z3))
     Endif
EndIf

SetFilaActual(FAC+2)
ACT(f:FAC, 'Limite Consumido')

If Not Incluido(Dialogo.TipoLimite1,'SETTLEMENT|VOLUMENCON')
   If EqStr(Dialogo.TipoLimite1,'MAXMONEU')
      ACN(h:fac, LimConsumido(Dialogo.Cliente1,Dialogo.TipoLimite1,VAR('MONEEXTR'),Dialogo.Fecha1,var('VEHICULODE')))
   Else 
      ACN(h:fac, LimConsumido(Dialogo.Cliente1,Dialogo.TipoLimite1,VAR('MONEEXTR'),0,VAR('VEHICULODE'),,,,Dialogo.Fecha1) )
   EndIf
Else 
   If Dialogo.Check1=1
      *- Maxima fecha para limite     
      ACD(ds1,SQL("SELECT Max(FechaLim) FROM "~DBO~".MOVLIMITES  WHERE Limite = '"~Dialogo.TipoLimite1~"'  "))
   Else
      ACD(ds1,Dialogo.Fecha1)
   EndIf

   Recorrer&j Dialogo.Fecha1,val(ds1)
      SCN(h:fac,LimSumado(Dialogo.Cliente1,Dialogo.TipoLimite1,&j,,,,'') )
   Proximo
EndIf

SetFont(f:FAC..h:FAC,2)
FormatoCeldas(g:10..h:FAC,EXE('F2'))

ACO(1,23)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,10)
ACO(8,10)

ACT(a:FAC+1, 'Fin del Informe.')
SetFont(a:FAC+1..h:FAC+1,2)
LimitesVision(h:FAC+1)
RangoTitulo(a:1..h:fac, 9)
 