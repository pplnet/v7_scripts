CrearDialogo   
    Fecha1      :  'Fecha desde:'      ;1;1;;;;Dialogo.Fecha1<>0;'Debe ingresar una fecha';NO;FSYS
    Fecha2      :  'Fecha hasta:'      ; ;1;;;;Dialogo.Fecha2<>0;'Debe ingresar una fecha';NO;FSYS+1
    Usuario1    :  'Usuario:'          ; ;1;;;;;;;
FinDialogo

If not OK
    Cancelar
EndIf

MostrarCuadroDeMensajes

SetFilaActual(1)
AgregarBMP(A:fac,EXE('LOGO'),EXE('ESCALOGO'))


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

SetFont(a:1, 3)
SetFont(a:3, 2)
SetFont(a:4, 2)

ACT(A:fac+3,'Reporte de Ingreso de Usuarios')
ACT(A:fac+5,'Fecha desde: '~Dialogo.Fecha1)
ACT(A:fac+6,'Fecha hasta: '~Dialogo.Fecha2)
ACT(A:fac+7,'Usuario: '~Dialogo.Usuario1)
SetFont(a:fac+3..d:fac+3, 3)
SetFont(a:fac+5..d:fac+7, 2)

SetFilaActual(fac+8)
ACT(A:fac,'Usuario')
ACT(B:fac,'Fecha/Hora')
ACT(C:fac,'Tipo')
ACT(D:fac,'Estacion')
AgregarMarco(a:fac..d:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..d:fac, 2)

SQL.ADD("Select Fecha, Usuario, Tipo, Estacion, Hora from "~DBO~".LOGINGRESOS  ")
SQL.ADD("Where Fecha >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD("and   Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
If NoVacio(Dialogo.Usuario1)
    SQL.ADD("and Usuario = '"~Dialogo.Usuario1~"'                               ")
EndIf

Recorrer SQL
    ACT(A:fac,FBN['Usuario'] )
    ACT(B:fac,FBN['Fecha']   )
    ACT(C:fac,FBN['Tipo']    )
    ACT(D:fac,FBN['Estacion'])
Proximo

ACO(1,10)
ACO(2,20)
ACO(3,10)
ACO(4,10)
ACO(5,1)

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Listado')
SetFont(A:fac, 2)
LimitesVision(e:fac)
