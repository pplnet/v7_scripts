*-- Calcula Resultados por Dividendos de Acciones
CrearDialogo
  Radio2:       'Por|Oper.|Fecha';1;1;;SI;  ;;;;0
  NrOperacion1: 'Nr.Operacion:'   ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 o [NoVacio(Dialogo.NrOperacion1) y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'DIVIDE')];'Debe ingresar una Operacion Tipo DIVIDE';NO;
  Radio1:       'Por|Alta|Baja'   ;2;2;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0
  Fecha1:       'Fecha'           ;2;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Radio2=0 o [Dialogo.Fecha1>0 y Dialogo.Fecha1<=FSys];'Debe ingresar una Fecha Valida';NO;FSys;
  Check1:       'Procesa'         ;3;1;;NO;SI;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(1)
ACT(a:FAC, 'NrOper.')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'Cliente')
ACT(e:FAC, 'Vehiculo')
ACT(f:FAC, 'Book')

ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cupon')
ACT(i:FAC, 'MB4')
ACT(j:FAC, 'CB6')
ACT(k:FAC, 'NrSaldo')
ACT(l:FAC, 'RB1 (Efvo)')
ACT(m:FAC, 'Moneda')
ACT(n:FAC, 'Monto')
ACT(o:FAC, 'RB2 (Acc)')
ACT(p:FAC, 'Cant.Acc.')
ACT(q:FAC, 'Precio')

ACT(aa:FAC, 'DIVEFV')
ACT(ab:FAC, 'DIVACC')
ACT(ac:FAC, 'Monto Efvo')
ACT(ad:FAC, 'Cotizacion')

SetFont(a:FAC..az:FAC,2)

if Dialogo.Radio2=0
  * Por Operacion
  if Dialogo.Radio1=0
    * Por Alta
    SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
  else
    * Por Baja
    SQL.ADD(" Select * from "~DBO~".BOPERACIONES ")
  endif
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  SQL.ADD(" Order By NrOperacion ")
  Recorrer SQL
    if Not Incluido(fbn('TipoOp'),'DIVIDE')
      Cancelar('Error Evento RESDIV. TipoOp incorrecto')
    endif

    ACT(a:FAC, fbn('NrOperacion'))
    ACT(b:FAC, fbn('TipoOp'))
    ACD(c:FAC, fbn('FechaOp'))
    ACT(d:FAC, fbn('Cliente1'))
    ACT(e:FAC, fbn('Vehiculo1'))
    ACT(f:FAC, fbn('Book1'))
    ACT(g:FAC, fbn('Especie'))
    ACT(h:FAC, fbn('Cupon1'))
    ACT(i:FAC, fbn('MB4'))
    ACT(j:FAC, fbn('CB6'))
    ACN(k:FAC, fbn('Tipocambio3'))
    ACN(l:FAC, fbn('RB1'))
    ACT(m:FAC, fbn('ContraEspecie'))
    ACN(n:FAC, fbn('TotalNetoCli1'))
    ACN(o:FAC, fbn('RB2'))
    ACN(p:FAC, fbn('TotalBrutoCli1'))
    ACN(q:FAC, fbn('PrecioMer'))
    if fbn('Tipocambio3')=120
      ACT(r:FAC, 'ARP')
    else
      ACT(r:FAC, 'USD')
    endif

    ACT(z:FAC, 'Orignal')

    * Por Transaccion busco otras transacciones de la misma fecha
    SQL.ADD(" Select * from "~DBO~".OPERACIONES ")
    SQL.ADD(" Where NrOperacion <> '"~Dialogo.NrOperacion1~"' ")
    SQL.ADD("   and TipoOp      in ('DIVIDE') ")
    SQL.ADD("   and FechaOp      = "~IdxDate2(fbn('FechaOp'))~" ")
    SQL.ADD("   and Vehiculo1    = '"~fbn('Vehiculo1')~"' ")
    SQL.ADD("   and Book1        = '"~fbn('Book1')~"' ")
    SQL.ADD("   and Especie      = '"~fbn('Especie')~"' ")
    SQL.ADD("   and TipoCambio3  = "~fbn('TipoCambio3')~" ")
    SQL.ADD(" Order By NrOperacion ")
    Recorrer SQL
      ACT(a:FAC, fbn('NrOperacion'))
      ACT(b:FAC, fbn('TipoOp'))
      ACD(c:FAC, fbn('FechaOp'))
      ACT(d:FAC, fbn('Cliente1'))
      ACT(e:FAC, fbn('Vehiculo1'))
      ACT(f:FAC, fbn('Book1'))
      ACT(g:FAC, fbn('Especie'))
      ACT(h:FAC, fbn('Cupon1'))
      ACT(i:FAC, fbn('MB4'))
      ACT(j:FAC, fbn('CB6'))
      ACN(k:FAC, fbn('Tipocambio3'))
      ACT(l:FAC, fbn('RB1'))
      ACT(m:FAC, fbn('ContraEspecie'))
      ACN(n:FAC, fbn('TotalNetoCli1'))
      ACT(o:FAC, fbn('RB2'))
      ACN(p:FAC, fbn('TotalBrutoCli1'))
      ACN(q:FAC, fbn('PrecioMer'))

      ACT(z:FAC, 'Hermana')
    proximo
  proximo

  if FAC>1
    ACN(az:4, 0)
    ACN(az:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
    if Val(az:4)=0
      ACN(az:5, 1)
    else
      ACN(az:5, VAR('MESINIEJE'))
    endif
    if Val(az:5)<1 or Val(az:5)>12
      ACN(az:5, 1)
    endif
    if Mes(Val(c:2))>=Val(az:5)
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2)),4,0))
    else
      ACT(az:6, '01/'~Pad0(FStr(Val(az:5),1,0),2)~'/'~FStr(Anio(Val(c:2))-1,4,0))
    endif
    ACD(az:7, Fecha(Val(az:6)))

    recorrer&i 2,FAC
      if Dialogo.Radio1=1 y &i=2
        ACN(aa:&i, 0)
        ACN(ab:&i, 0)
      else
        if Val(l:&i)=0
          ACN(aa:&i, 0)
        else
          if EqStr(Val(m:&i),Val(r:&i))
            ACN(aa:&i, Val(n:&i))
          else
            ACN(aa:&i, Val(n:&i)*CotizacionC(Val(m:&i),,,,Val(c:&i)-1,1,SI,Val(r:&i)))
            ACN(ac:&i, Val(n:&i))
            ACN(ad:&i, CotizacionC(Val(m:&i),,,,Val(c:&i)-1,1,SI,Val(r:&i)))
          endif
        endif
        if Val(o:&i)=0
          ACN(ab:&i, 0)
        else
          ACN(ab:&i, Val(p:&i)*Val(q:&i))
        endif
      endif
    proximo

    SetFont(a:2..az:FAC,1)
    FormatoCeldas(k:2..l:FAC, Exe('F0'))
    FormatoCeldas(n:2..n:FAC, Exe('F2'))
    FormatoCeldas(o:2..o:FAC, Exe('F0'))
    FormatoCeldas(p:2..p:FAC, Exe('F2'))
    FormatoCeldas(aa:2..ac:FAC, Exe('F2'))
    FormatoCeldas(q:2..q:FAC, Exe('F8'))
    FormatoCeldas(ad:2..ad:FAC, Exe('F8'))

    ACN(aa:FAC+2, Sum(aa:2..aa:FAC))
    ACN(ab:FAC+2, Sum(ab:2..ab:FAC))

    ACT(ag:1, 'Tipo')
    ACT(ag:2, 'DIVEFV')
    ACT(ag:3, 'DIVACC')
    ACT(ah:1, 'Day')
    ACT(ai:1, 'NrSaldo')
    ACT(aj:1, 'Cant.Reg')
    ACT(ak:1, 'Fecha Res')
    ACT(al:1, 'LastDay')
    ACT(am:1, 'MTD')
    ACT(an:1, 'YTD')
    ACT(ao:1, 'Resultado')
    ACT(ap:1, 'NrSaldo')
    ACT(aq:1, 'Accion')
    SetFont(ag:1..aq:3,2)

    ACN(ah:2, Val(aa:FAC+2))
    ACN(ai:2, Val(k:2))
    ACN(ah:3, Val(ab:FAC+2))
    ACN(ai:3, Val(k:2))
  
    SQL.ADD("Select * from "~DBO~".RESULTADOS R1 ")
    SQL.ADD(" where R1.TipoResultado in ('DIVEFV','DIVACC') ")
    SQL.ADD("   and R1.Especie  =  '"~Val(g:2)~"' ")
    SQL.ADD("   and R1.Vehiculo =  '"~Val(e:2)~"' ")
    SQL.ADD("   and R1.Book     =  '"~Val(f:2)~"' ")
    SQL.ADD("   and R1.NrSaldo  =  "~Val(k:2)~" ")
    SQL.ADD("   and R1.Fecha    >= "~IdxDate2(Val(az:7))~" ")
    SQL.ADD("   and R1.Fecha    = (select Max(Fecha) ")
    SQL.ADD("                       from  "~DBO~".RESULTADOS R2 ")
    SQL.ADD("                       where R2.Especie       =  R1.Especie ")
    SQL.ADD("                        and  R2.Vehiculo      =  R1.Vehiculo ")
    SQL.ADD("                        and  R2.Book          =  R1.Book ")
    SQL.ADD("                        and  R2.NrSaldo       =  R1.NrSaldo ")
    SQL.ADD("                        and  R2.TipoResultado =  R1.TipoResultado ")
    SQL.ADD("                        and  R2.TipoNegocio   =  R1.TipoNegocio ")
    SQL.ADD("                        and  R2.Fecha       <= "~IdxDate2(Val(c:2))~" ) ")
    SQL.ADD(" Order By Fecha ")
    recorrer SQL
      DFA
      if EqStr(fbn('TipoResultado'),'DIVEFV')
        ACN(x1,2)
      else
        ACN(x1,3)
      endif
      SCN(aj:Val(x1), 1)
      ACD(ak:Val(x1), fbn('Fecha'))
      ACN(al:Val(x1), fbn('Day'))
      ACN(am:Val(x1), fbn('MTD'))
      ACN(an:Val(x1), fbn('YTD'))
      ACT(ao:Val(x1), fbn('TipoResultado'))
      ACN(ap:Val(x1), fbn('NrSaldo'))
    proximo

    recorrer&i 2,3

      if Val(aj:&i)=0
        * No existe registro para el ejercicio
        ACT(aq:&i, 'Nuevo')
      else
        if Mes(Val(c:2))=Mes(Val(ak:&i))
          * Mismo Mes
          if Dia(Val(c:2))=Dia(Val(ak:&i))
            * Mismo Dia
            ACT(aq:&i, 'Mismo Dia/Mes')
          else
            * Distinto Dia
            ACT(aq:&i, 'Mismo Mes/Distinto Dia')
          endif
        else
          * Distinto Mes
          ACT(aq:&i, 'Distinto Mes')
        endif
      endif

      if Dialogo.Check1=1
        ACT(aj:&i, 'Procesa')
        SQL.ADD("EXEC "~DBO~".ActualizaResultados ")
        * Maxfecha
        SQL.ADD(" '"~IdxDate(Val(ak:&i))~"',")
        * Fecha
        SQL.ADD(" '"~IdxDate(Val(c:2))~"',")
        * Cliente
        SQL.ADD(" '"~Val(d:2)~"', ")
        * Vehiculo
        SQL.ADD(" '"~Val(e:2)~"', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * NrSaldo
        SQL.ADD(" "~FStr(Val(ai:&i),0,0)~", ")
        * Especie
        SQL.ADD(" '"~Val(g:2)~"', ")
        SQL.ADD(" Null, ")
        SQL.ADD(" Null, ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        SQL.ADD(" '', ")
        * Book
        SQL.ADD(" '"~Val(f:2)~"', ")
        SQL.ADD(" '', ")
        SQL.ADD(" 'SEC', ")
        * TipoResultado
        SQL.ADD(" '"~Val(ag:&i)~"', ")
        SQL.ADD(" "~FStr(Val(ah:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(am:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(an:&i),0,2)~", ")
        SQL.ADD(" "~FStr(Val(al:&i),0,2)~" ")
        SQL.NEW
        SQL.EXEC
      endif
    proximo

    SetFont(ah:2..aq:3,1)
    FormatoCeldas(ah:2..ah:3, Exe('F2'))
    FormatoCeldas(ai:2..aj:3, Exe('F0'))
    FormatoCeldas(al:2..an:3, Exe('F2'))
    SetFont(az:1..az:7,1)

  endif
endif

if Dialogo.Radio2=1
  * Por Fecha
  SQL.ADD(" Select NrOperacion from "~DBO~".OPERACIONES ")
  SQL.ADD("  where FechaOp   = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("    and TipoOp  in ('DIVIDE') ")
  SQL.ADD("    and MB4     = '1' ")
  SQL.ADD("    and CB6     = '1' ")
  SQL.ADD(" Order By NrOperacion ")
  Recorrer SQL
    ACT(a:FAC, fbn('NrOperacion'))
    if Dialogo.Check1=1
      EjecutarEvento('RESDIV',Radio2=0,NrOperacion1=fbn('NrOperacion'),Radio1=0,Fecha1=Dialogo.Fecha1,Check1=Dialogo.Check1)
    endif
  proximo
endif
