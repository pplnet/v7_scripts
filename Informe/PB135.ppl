ACT(va:1,'')
ACT(mo:1,'')
ACT(cu:1,'')
ACT(ba:1,'')

Recorrer SQL
  If Not Eqstr(Val(va:1), fbn('Cliente'))
    If Not Eqstr(Val(va:1), '')
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Cliente'))
    ACT(a:fac, 'Vehiculo: '~fbn('Cliente'))
    ACT(va:1,fbn('Cliente'))
    SetFont(a:fac,2)
    ifa
    (.'PBPTITULOS'.)
    ifa
    ifa
    IFA
    ACT(mo:1,'')
    ACT(cu:1,'')
    ACT(ba:1,'')
  Endif
  If Not Eqstr(Val(mo:1), fbn('Especie'))
    message('Moneda: '~fbn('Especie'))
    ACT(a:fac,'Moneda: '~fbn('Especie'))
    ACT(mo:1,fbn('Especie'))
  Else
    dfa
  Endif

  *Ingresos del Proyectados
  If Incluido(fbn('Tipo'), 'ESTIMA') o [Incluido(fbn('Tipo'), 'PROYEC') y fbn('RB1')=0]
    SCN(b:fac, fbn('Cantidad'))
    AsignarLink(b:fac, 'PB1352',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'))
  Endif

  *Egresos del Proyectados
  If [Incluido(fbn('Tipo'), 'DEVM') y fbn('NrComprob')<>0]  o [Incluido(fbn('Tipo'), 'PROYEC') y fbn('RB1')=1]
    SCN(c:fac, fbn('Cantidad')*IIF(Incluido(fbn('Tipo'), 'PROYEC'),-1,1))
    AsignarLink(c:fac, 'PB1351',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'))
  Endif

  *Depositos Financieros
  If [Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|PROYEC|SALDO|') y fbn('Cantidad')>0] o [Incluido(fbn('Tipo'), 'PROYEC') y Eqstr(fbn('RB1'),'2')]
    SCN(d:fac, fbn('Cantidad'))
    AsignarLink(d:fac, 'PB1353',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Check1=0,Check2=1)
  Endif

  *Egresos Financieros
  If [Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|PROYEC|SALDO|') y fbn('Cantidad')<0]  o [Incluido(fbn('Tipo'), 'PROYEC') y fbn('RB1')=3]
    SCN(e:fac, fbn('Cantidad')*IIF(Incluido(fbn('Tipo'), 'PROYEC'),-1,1))
    AsignarLink(e:fac, 'PB1353',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Check1=0,Check2=0)
  Endif

  *Prestamos Ingresos
  If [Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')>0] o [Incluido(fbn('Tipo'), 'PROYEC') y fbn('RB1')=4]
    SCN(f:fac, fbn('Cantidad'))
    AsignarLink(f:fac, 'PB1353',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Check1=1,Check2=1)
  Endif

  *Prestamos Egresos
  If [Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')<0]  o [Incluido(fbn('Tipo'), 'PROYEC') y fbn('RB1')=5]
    SCN(g:fac, fbn('Cantidad')*IIF(Incluido(fbn('Tipo'), 'PROYEC'),-1,1))
    AsignarLink(g:fac, 'PB1353',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Check1=1,Check2=0)
  Endif

  ACN(h:fac, SUM(b:fac..g:fac))

  FormatoCeldas(b:fac..z:fac, EXE('F2'))
  SetFont(a:fac..z:fac, 7)
