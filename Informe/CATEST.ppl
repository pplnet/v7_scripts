CrearDialogo
  Fecha1           :  'Fecha'               ;1;;;;;;;;FSYS
  Cliente1         :  'Cliente'             ;3;;;;;;;
  Radio1           : 'Moneda Exp.|ARP|USD'  ;4;;;;;;;;0;;
  Lista1           :  'Vehiculo'            ;5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

SetFilaActual(1)
ACT(F:fac, 'Estado de Operaciones Caucion Tomadora')
SetFont(F:fac, 3)
SetFilaActual(fac+2)
ACN(FI:1, fac)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculo/s : '~Dialogo.Lista1) 
ELSE
    ACT(A:fac, 'Vehiculo : Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Cliente: '~Dialogo.Cliente1)
ELSE
    ACT(A:fac, 'Cliente: Todos')
ENDIF
ifa
IF Dialogo.Radio1 = 0
    ACT(MN:1, Var('MONELOCA'))
ELSE
    ACT(MN:1, Var('MONEEXTR'))
ENDIF
ACT(A:fac, 'Expresado en: '~Val(MN:1))
SetFilaActual(fac+2)
ACT(C:fac, 'Operacion')
ACT(D:fac, 'FechaOp')
ACT(E:fac, 'FechaVto')
ACT(F:fac, 'Especie')
ACT(G:fac, 'V.Nominal')
ACT(H:fac, 'PecioOp')
ACT(I:fac, '%Aforo')
ACT(J:fac, 'Pr.Aforado')
ACT(K:fac, 'Imp.Integrado')
ACT(L:fac, 'Precio Hoy')
ACT(M:fac, 'Pr. Hoy Aforado')
ACT(N:fac, 'Valor Hoy Aforado')
ACT(O:fac, 'Imp a Integrar')
SetFont(A:Val(FI:1)..O:fac, 2)
AlinearCeldas(A:fac..O:fac, 'C')
AgregarMarco(A:fac..O:fac, 0, 0, Exe('COLOR'))
ACN(FI:2, fac+1)
SQL.ADD(" Select O.Vehiculo1, C.Especie1, C.Cantidad1, O.NrOperacion, O.FechaOp, O.FechaVto, O.Especie, O.Cliente1, C.Precio1, C.Precio2, ")
SQL.ADD(" C.Precio3, C.Cantidad2 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp = 'SECAT' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Order By O.Vehiculo1, O.Cliente1, O.NrOperacion ")
watch(sql.batch)
Recorrer SQL
    IF Not Eqstr(fbn('Vehiculo1'), Val(VH:1))
        IF Not CeldaVacia(OP:1)
            (.'INTGAR'.)
            ACN(O:fac, Val(TO:1))
            ACT(C:fac, 'Total Operacion '~Val(OP:1))
            SetFont(A:Val(FI:1)..O:fac-1, 1)
            SetFont(C:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(C:fac..O:fac, 0, 0)
            ifa
            ACT(B:fac, 'Total Cliente '~Val(CL:1))
            ACN(O:fac, Val(TC:1))
            SetFont(B:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(B:fac..O:fac, 0, 0, Exe('COLOR6'))
            ifa
            ACT(A:fac, 'Total Vehiculo '~Val(VH:1))
            ACN(O:fac, Val(TV:1))
            SetFont(A:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(A:fac..O:fac, 0, 0, Exe('COLOR8'))
            SetFilaActual(fac+2)
            ACN(TO:1, 0)
            ACN(TC:1, 0)
            ACN(TV:1, 0)
        ENDIF
        ACT(A:fac, fbn('Vehiculo1'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..O:fac, 0, 0, Exe('COLOR8'))
        ifa
    ELSE
    ENDIF
    IF Not Eqstr(fbn('Cliente1'), Val(CL:1)) O Not Eqstr(fbn('Vehiculo1'), Val(VH:1))
        IF Not CeldaVacia(OP:1) Y  Eqstr(fbn('Vehiculo1'), Val(VH:1))
            (.'INTGAR'.)
            ACT(C:fac, 'Total Operacion '~Val(OP:1))
            ACN(O:fac, Val(TO:1))
            SetFont(A:Val(FI:1)..O:fac-1, 1)
            SetFont(C:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(C:fac..O:fac, 0, 0)
            ifa
            ACT(B:fac, 'Total Cliente '~Val(CL:1))
            ACN(O:fac, Val(TC:1))
            SetFont(B:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(B:fac..O:fac, 0, 0, Exe('COLOR6'))
            ACN(TO:1, 0)
            ACN(TC:1, 0)
            SetFilaActual(fac+2)
        ENDIF
        ACT(B:fac, fbn('Cliente1'))
        SetFont(B:fac, 2)
        AgregarMarco(B:fac..O:fac, 0, 0, Exe('COLOR6'))
        ifa
        ACT(C:fac, fbn('NrOperacion'))
        ACLO(C:fac, fbn('NrOperacion'))
        ACD(D:fac, fbn('FechaOp'))
        ACD(E:fac, fbn('FechaVto'))
        ACN(FI:1, fac)
    ELSE
        IF Not Eqstr(fbn('NrOperacion'), Val(OP:1))
            (.'INTGAR'.)
            ACN(O:fac, Val(TO:1))
            ACT(C:fac, 'Total Operacion '~Val(OP:1))
            SetFont(A:Val(FI:1)..O:fac-1, 1)
            SetFont(C:fac, 2)
            SetFont(O:fac, 2)
            AgregarMarco(C:fac..O:fac, 0, 0)
            ACN(TO:1, 0)
            ifa
            ACT(C:fac, fbn('NrOperacion'))
            ACLO(C:fac, fbn('NrOperacion'))
            ACD(D:fac, fbn('FechaOp'))
            ACD(E:fac, fbn('FechaVto'))
            ACN(FI:1, fac)
        ENDIF
    ENDIF
    ACT(F:fac, fbn('Especie1'))
    ACN(G:fac, fbn('Cantidad1'))
    IF Not Eqstr(fbn('Especie'), Val(MN:1))
        ACN(H:fac, fbn('Precio1') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
        ACN(J:fac, fbn('Precio3') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
        ACN(K:fac, fbn('Cantidad2') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
    ELSE
        ACN(H:fac, fbn('Precio1'))
        ACN(J:fac, fbn('Precio3'))
        ACN(K:fac, fbn('Cantidad2'))
    ENDIF
    ACN(I:fac, fbn('Precio2'))
    ACN(L:fac, CotizacionC(fbn('Especie1'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
    ACN(M:fac, Val(L:fac) * Val(I:fac) / 100)
    ACN(N:fac, Val(G:fac) * Val(M:fac))
    ACN(O:fac, Val(K:fac) - Val(N:fac))
    SCN(TO:1, Val(O:fac))
    SCN(TC:1, Val(O:fac))
    SCN(TV:1, Val(O:fac))
    ACT(OP:1, fbn('NrOperacion'))
    ACT(CL:1, fbn('Cliente1'))
    ACT(VH:1, fbn('Vehiculo1'))
Proximo
ifa
(.'INTGAR'.)
ACN(O:fac, Val(TO:1))
ACT(C:fac, 'Total Operacion '~Val(OP:1))
SetFont(C:fac, 2)
SetFont(O:fac, 2)
AgregarMarco(C:fac..O:fac, 0, 0)
ifa
ACT(B:fac, 'Total Cliente '~Val(CL:1))
ACN(O:fac, Val(TC:1))
SetFont(B:fac, 2)
SetFont(O:fac, 2)
AgregarMarco(B:fac..O:fac, 0, 0, Exe('COLOR6'))
ifa
ACT(A:fac, 'Total Vehiculo '~Val(VH:1))
ACN(O:fac, Val(TV:1))
SetFont(A:fac, 2)
SetFont(O:fac, 2)
AgregarMarco(A:fac..O:fac, 0, 0, Exe('COLOR'))
FormatoCeldas(H:Val(FI:2)..H:fac, Exe('F8'))
FormatoCeldas(J:Val(FI:2)..J:fac, Exe('F8'))
FormatoCeldas(L:Val(FI:2)..L:fac, Exe('F8'))
FormatoCeldas(M:Val(FI:2)..M:fac, Exe('F8'))
FormatoCeldas(O:Val(FI:2)..O:fac, Exe('F2'))
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(7, 10)
ACO(11, 12)
ACO(13, 12)
ACO(14, 12)
ACO(15, 12)
