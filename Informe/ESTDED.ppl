MostrarCuadroDeMensajes
ModoReproceso(ConDialogo)
(.'ESTDEDCLI'.)
CrearDialogo
   Fecha1   : "Fecha"                      ;1;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Vehiculo2: "Grupo"                      ;2;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
   Lista1   : "Vehiculo"                   ;3;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
   Lista2   : "Contraparte"                ;-3;2;;;;;;;;;Val(CL:1);;;;;
   Radio2   : "Consolidado|Si|No"          ;-1;1;;;;;;;1
   Radio4   : "Cuotas|Si|No"               ;0;1;;;;;;;1  
   Radio1   : "Agrupar|Productos|Vehiculos";1;1;;Dialogo.Radio2=1;;;;;0;IIF(Dialogo.Radio2=0,0,Dialogo.Radio1)
   Check1   : "P.Financieros"              ;0;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Check2   : "P.Vinculadas"               ; ;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Check3   : "Descubiertos"               ; ;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Check4   : "ONs"                        ; ;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Check5   : "Repos"                      ; ;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Check6   : "Cauciones"                  ; ;2;;Dialogo.Radio3=0;;;;;1;IIF(Dialogo.Radio3=0,0,1)
   Radio3   : "Productos|Seleccionar|Todos"  ;-1;2;;;;;;;;1
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

***Agregado para el cuadro de totales
ACT(aa:2,'')
*acn(x2,0)
acn(vi:55,0)
***Cantidad de vehiculos
ACN(ve:1,0)
***Lista de vehículos ve:2

SetFilaActual(2)
ACT(a:fac,'ESTRUCTURA DE DEUDA DIARIA')
SetFont(a:fac,3)

SetFilaActual(fac+2)
ACT(a:fac,'A Fecha: '~Dialogo.Fecha1)
If NoVacio(Dialogo.Vehiculo2)
   ACT(a:fac+1,'Grupo: '~Dialogo.Vehiculo2)
Else
   ACT(a:fac+1,'Grupo: Todos')
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(a:fac+2,'Vehiculo: ' ~Dialogo.Lista1~' ')
   ACT(VH:1, Dialogo.Lista1)
Else
   ACT(a:fac+2,'Vehiculo: Todos')
   ACT(VH:1, iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'")))
EndIf
If NoVacio(Dialogo.Lista2)
   ACT(a:fac+3,'Contraparte: '~Dialogo.Lista2)
   ACT(CL:1, Dialogo.Lista2)
Else
   ACT(a:fac+3,'Contraparte: Todos')
EndIf
If Dialogo.Radio2=0
   ACT(a:fac+4,'Consolidado: Si')
Else
   ACT(a:fac+4,'Consolidado: No')
EndIf
If Dialogo.Radio4=0
   ACT(a:fac+5,'Muestra Cuotas: Si')
Else
   ACT(a:fac+5,'Muestra Cuotas: No')
EndIf
If Dialogo.Radio1=0
   ACT(a:fac+6,'Agrupado por: Productos')
Else
   ACT(a:fac+6,'Agrupado por: Vehiculos')
EndIf
If Dialogo.Radio3=1
   ACT(a:fac+7,'Productos: Todos')
Else
   ACT(a:fac+7,'Productos: ')
   If Dialogo.Check1 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Prestamos Financieros | ')
   Endif
   If Dialogo.Check2 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Prestamos Vinculadas | ')
   Endif
   If Dialogo.Check3 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Descubiertos | ')
   Endif
   If Dialogo.Check4 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Obligaciones Negociables | ')
   Endif
   If Dialogo.Check5 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Repos | ')
   Endif
   If Dialogo.Check6 = 1
      ACT(a:fac+7, Val(a:fac+7)~'Cauciones | ')
   Endif
EndIf

ACT(p:fac,'Fecha: '~Var('FECHASYS'))
SetFont(a:fac..p:fac+7, 2)

ACT(ml1, Var('MONELOCA'))
ACT(me1, Var('MONEEXTR'))

***+++> Inicia Cant de monedas
ACN(mo1, 0)

***/// GR:1 -> Agrupa por producto = 0
ACN(GR:1, Dialogo.Radio1)

SetFilaActual(fac+7)

If Val(GR:1)=0
   ***/// SE AGRUPA POR PRODUCTO
   If NoVacio(Dialogo.Lista1)
      Message('Vehiculo: ' ~Dialogo.Lista1~' ')
   Else
      Message('Vehiculo: Todos')
   Endif
   **// Query - Muestro Resultados
   (.'ESTDEDQUE'.)
Else
   ***/// SE AGRUPA POR VEHICULO
   Recorrer&i 1,Elementos(Val(VH:1))
      ACT(VH:2, ItemLista(Val(VH:1), &i))
      Message('Vehiculo: '~Val(VH:2))
      SetFilaActual(fac+3)
      ACT(A:FAC, '   '~Val(VH:2)~' - '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Val(VH:2)))
      SetFont(a:fac..a:fac,3)
      AgregarMarco(a:fac..d:fac,2,1,Exe('COLOR'))
      IFA
      (.'ESTDEDCOL'.)
      ACN(FL:1, FAC)
      **// Query - Muestro Resultados
      (.'ESTDEDQUE'.)
      If Val(FL:1)=FAC
         IFA
         IFA
         **ACT(A:fac, 'SIN RESULTADOS')
         **SetFont(a:fac..a:fac,3)
      Else
         **// Cuando se agrupa por vehiculo agrego la nota despues de cada vehiculo
         SetFilaActual(FAC+2) 
         ACT(a:FAC, IIF(Dialogo.Radio2=0,'Consolidado',ItemLista(VAL(ve:2),Val(ve:1))))
         ACT(b:FAC  , 'Pesos')
         ACT(c:FAC  , 'Dolares')
         ACT(d:FAC  , 'Otras')
         ACT(e:FAC  , 'Totales')
         ACT(a:FAC+1, 'Plazo')
         ACT(a:FAC+2, 'Promedio') 
         ACT(a:FAC+3, 'Ponderado')
         */ARP
         ACN(b:FAC+2,  Val(pl:Val(ve:1))/Val(lp:Val(ve:1)))
         */USD
         ACN(C:FAC+2,  Val(pe:Val(ve:1))/Val(ep:Val(ve:1)))
         */OTRO
         ACN(D:FAC+2,  Val(on:Val(ve:1))/Val(dp:Val(ve:1)))
         */TOTAL
         ACN(E:FAC+2,  Val(tn:Val(ve:1))/Val(tt:Val(ve:1)))
         ACT(a:FAC+4, 'Plazo Remanente')
         ACT(a:FAC+5, 'Promedio')
         ACT(a:FAC+6, 'Ponderado')
         */ARP
         ACN(b:FAC+5,  Val(za:Val(ve:1))/Val(zb:Val(ve:1)))
         */USD
         ACN(C:FAC+5,  Val(zc:Val(ve:1))/Val(zd:Val(ve:1)))
         */OTRO
         ACN(D:FAC+5,  Val(ze:Val(ve:1))/Val(zf:Val(ve:1)))
         */TOTAL
         ACN(E:FAC+5,  Val(zu:Val(ve:1))/Val(zn:Val(ve:1)))
         ACT(a:FAC+7, 'Tasa')
         ACT(a:FAC+8, 'Promedio')
         */ARP
         ACN(b:FAC+8,  val(nl:Val(ve:1))/Val(dl:Val(ve:1)))
         */USD
         ACN(c:FAC+8,  val(ne:Val(ve:1))/Val(de:Val(ve:1)))
         */OTRO
         ACN(d:FAC+8,  val(to:Val(ve:1))/Val(do:Val(ve:1)))
         */TOTAL
         ACN(e:FAC+8,  val(nt:Val(ve:1))/Val(dt:Val(ve:1)))

         **FormatoCeldas(b:fac+5..e:fac+5, Exe('F8'))
         SetFont(a:FAC..e:FAC,2)
         SetFont(a:FAC+1..a:FAC+8,1)
         SetFont(b:fac+1..e:fac+8, 1)
         AgregarMarco(a:FAC..e:FAC,2,0,Exe('COLOR'))
         AgregarMarco(a:FAC..e:FAC+3,2,0)
         AgregarMarco(a:FAC..e:FAC+6,2,0)
         AgregarMarco(a:FAC..e:FAC+8,2,0)
         SetFilaActual(FAC+9)
      Endif
   Proximo
   DFA
Endif

*--->T.N.A. % Y T.E.A. %
FormatoCeldas(o:Val(z1)..p:fac, Exe('F8'))
*--->Total a Pagar
FormatoCeldas(n:Val(z1)..n:fac, Exe('F2'))
*--->Plazo
FormatoCeldas(f:Val(z1)..f:fac, Exe('F0'))
ifa
SetFilaActual(fac+2)

**// Si se agrupa por producto, las notas van juntas al final del informe
If Val(GR:1)=0
   ***Cuadro de totales por cada vehículo del informe
   Recorrer&i 1,Val(ve:1)
      */TOTALES
         SetFilaActual(FAC+2) 
         ACT(a:FAC, IIF(Dialogo.Radio2=0,'Consolidado',ItemLista(VAL(ve:2),&i)))
         ACT(b:FAC  , 'Pesos')
         ACT(c:FAC  , 'Dolares')
         ACT(d:FAC  , 'Otras')
         ACT(e:FAC  , 'Totales')
         ACT(a:FAC+1, 'Plazo')
         ACT(a:FAC+2, 'Promedio') 
         ACT(a:FAC+3, 'Ponderado')
         */ARP
         ACN(b:FAC+2,  Val(pl:&i)/Val(lp:&i))
         */USD
         ACN(C:FAC+2,  Val(pe:&i)/Val(ep:&i))
         */OTRO
         ACN(D:FAC+2,  Val(on:&i)/Val(dp:&i))
         */TOTAL
         ACN(E:FAC+2,  Val(tn:&i)/Val(tt:&i))
         ACT(a:FAC+4, 'Plazo Remanente')
         ACT(a:FAC+5, 'Promedio')
         ACT(a:FAC+6, 'Ponderado')
         */ARP
         ACN(b:FAC+5,  Val(za:&i)/Val(zb:&i))
         */USD
         ACN(C:FAC+5,  Val(zc:&i)/Val(zd:&i))
         */OTRO
         ACN(D:FAC+5,  Val(ze:&i)/Val(zf:&i))
         */TOTAL
         ACN(E:FAC+5,  Val(zu:&i)/Val(zn:&i))
         ACT(a:FAC+7, 'Tasa')
         ACT(a:FAC+8, 'Promedio')
         */ARP
         ACN(b:FAC+8,  val(nl:&i)/Val(dl:&i))
         */USD
         ACN(c:FAC+8,  val(ne:&i)/Val(de:&i))
         */OTRO
         ACN(d:FAC+8,  val(to:&i)/Val(do:&i))
         */TOTAL
         ACN(e:FAC+8,  val(nt:&i)/Val(dt:&i))

         *FormatoCeldas(b:fac+5..e:fac+5, Exe('F8'))
         SetFont(a:FAC..e:FAC,2)
         SetFont(a:FAC+1..a:FAC+8,1)
         SetFont(b:fac+1..e:fac+8, 1)
         AgregarMarco(a:FAC..e:FAC,2,0,Exe('COLOR'))
         AgregarMarco(a:FAC..e:FAC+3,2,0)
         AgregarMarco(a:FAC..e:FAC+6,2,0)
         AgregarMarco(a:FAC..e:FAC+8,2,0)
         SetFilaActual(FAC+9)
   Proximo
   IFA
   IFA
Endif

IFA
ACN(zz1, fac)
ACN(ff1, 0)
ACN(x1, 0)

***+++>Cuadro de totales por cada moneda que haya aparecido en el informe
Recorrer&i 1, Val(mo1)
   If [Not Eqstr(Val(mm:&i), Val(me1)) O Val(mo1)>1] 
      ACN(x1, 1)
      ACT(a:fac, 'Total Deuda '~Val(mm:&i))
      ACN(c:fac, Val(mn:&i))
      *ACN(d:fac, Val(mn:&i) / Val(mp:&i))
      ifa
   Endif
   SCN(ff1, Val(mn:&i) / Val(mp:&i))
Proximo
ifa
*ACT(a:fac, 'Total Deuda USD')
ACT(a:fac, 'Total Deuda '~Val(me1))
ACN(c:fac, Val(ff1))
ColorCeldas(a:fac..c:fac, clRED)
FormatoCeldas(c:Val(zz1)..c:fac, Exe('F2'))
ifa
AgregarMarco(a:Val(zz1)..c:fac, 0, 0)

***Agregado por los cuadros que totalizan
ACO(1,12)
ACO(2,7)
ACO(4,6)
ACO(6,5)
ACO(8,8)
ACO(11,7)
ACO(12,8)
ACO(13,5)
ACO(14,5)
ACO(15,7)
ACO(16,5)
ACO(17,5)
ACO(22,6)
ACO(23,12)

SetFilaActual(fac+3)
ACN(zz2, fac)

If Val(x1) <> 0
   ACT(a:fac, 'Cotizaciones en '~Val(me1))
   Ifa
   Recorrer&i 1 , Val(mo1)
      If Val(mp:&i) <> 0 Y Not Eqstr(Val(mm:&i), Val(me1)) 
         Ifa
         ACT(a:fac, Val(mm:&i))
         ACN(b:fac, Val(mp:&i))
      EndIf
   Proximo
   AgregarMarco(a:Val(zz2)..b:fac, 0, 0) 
   SetFilaActual(fac+3)
EndIf

SetFont(a:Val(zz1)..c:fac, 2)
FormatoCeldas(b:Val(zz2)..b:fac, Exe('F8'))

ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac, 2)

*--->T.N.A. % Y T.E.A. %
FormatoCeldas(o:Val(z1)..p:fac, Exe('F2'))

Impresion(1, 2)
SetPrintFit(3, 60)
LimitesVision(w:fac+1)
RangoTitulo(a1..v:fac, 12)