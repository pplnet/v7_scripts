AgregarMarco(a:fac..d:fac,2,2)

ifa

ACT(aa:1,'')
ACN(aa:2,0)
ACT(aa:3,'')
ACN(aa:4,0)
ACN(aa:5,0)
ACN(aa:6,0)

ACT(aa:7, SQL(" SELECT SUBSTRING(Jerarquia,1,5) FROM "~DBO~".CLIENTES WHERE Codigo='"~VAR('NOMJERDIR')~"' ") )

Message(' Saldo Inicial')
SQL.ADD("SELECT S1.Cliente, S1.Especie, '0' Tipo, E.Nombre, S1.Mercado, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion DescEst, ")
SQL.ADD("       EC.Codigo,SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESTADOSCUSTODIA EC ")
SQL.ADD("WHERE S1.Cliente = C.Codigo AND ")
SQL.ADD("      C.Jerarquia LIKE '"~Val(aa:7)~"%' AND ")
SQL.ADD("      E.Codigo = S1.Especie AND ")
SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND ")
SQL.ADD("      Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND ")
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) and ")
SQL.ADD("      (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion, EC.Codigo,E.Alias5, E.InteresesC, Tipo ")
SQL.ADD("ORDER BY S1.Cliente, S1.Especie, Tipo, S1.Mercado, S1.Cuenta, S1.NrSaldo ")
Recorrer SQL
 dfa
 if [Not EqStr(fbn('Cliente'),Val(aa:1))] o [Not EqStr(fbn('Especie'),Val(aa:3))]
  if Not CeldaVacia(aa:3)
     ifa
     ACT(a:fac,Val(aa:3)~' - '~BuscarCampo('Especies','Nombre','Codigo',Val(aa:3)) )
     ACN(b:fac,Val(aa:5))
     FormatoCeldas(b:fac..d:fac,Exe('F2'))
     SetFont(a:fac..d:fac,1)
     AgregarMarco(a:fac..d:fac,0,3)
  endif
  ACT(aa:3,fbn('Especie'))
  ACN(aa:5,0)
 endif

 if Not EqStr(fbn('Cliente'),Val(aa:1))
  if Val(aa:2) = 1
     ifa
  else
     ACN(aa:2,1)
  endif
   ACT(a:fac,fbn('Cliente')~' - '~fbn('RazonSocial'))
  SetFont(a:fac,2)
  AgregarMarco(a:fac..d:fac,0,0)
  ACT(aa:1,fbn('Cliente'))
 endif

 if EqStr(fbn('Tipo'),'0')
    SCN(aa:5,fbn('Saldo'))
 endif

Proximo

if Not CeldaVacia(aa:3)
   ifa
*   ACT(a:fac,Val(aa:3))
   ACT(a:fac,Val(aa:3)~' - '~BuscarCampo('Especies','Nombre','Codigo',Val(aa:3)) )
   ACN(b:fac,Val(aa:5))
   ACN(d:fac,Val(aa:6))
   ACN(c:fac,Val(aa:6)-Val(aa:5))
   FormatoCeldas(b:fac..d:fac,Exe('F2'))
   SetFont(a:fac..d:fac,1)
   AgregarMarco(a:fac..d:fac,0,3)
endif

Message('')

