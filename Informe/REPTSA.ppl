HojaVisible(no)
*Flag para mostrar que eventos se pueden accionar
&REPTSA := 1
(.'DIALOGOPNL'.)

&REPTSA := 0
If Dialogo.Radio1 =0
    LinkearHoja('REPTOP',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3,Radio4 = Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
Else If Dialogo.Radio1 = 1
        LinkearHoja('REPCLI',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3,Radio4= Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
    Else If Dialogo.Radio1 = 2 
            LinkearHoja('REPCLP',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3,Radio4= Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
        Else If Dialogo.Radio1 = 3
                LinkearHoja('REPCLC',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3,Radio4= Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            Else 
                LinkearHoja('REPDET',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2, Radio3 = Dialogo.Radio3,Radio4= Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            EndIf
        EndIf
    EndIf
EndIf