CrearDialogo
   Fecha1     : 'Fecha'                                    ;  1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys  
   Especie1   : 'Especie'                                  ;  1;2;;NO;;;;;'USD'
   Cliente1   : 'Contraparte'                              ;  2;2;;SI;;;;;
   Radio4     : 'Fecha de|Concertacion|Vencimiento|Ambas'  ;  3;1;;;;;;;0
   Fecha2     : 'Con. desde'                               ;  4;1;;Dialogo.Radio4=0 o Dialogo.Radio4=2;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Fecha3     : 'Hasta'                                    ;  4;2;;Dialogo.Radio4=0 o Dialogo.Radio4=2;;Dialogo.Fecha3<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Fecha4     : 'Ven. desde'                               ;  5;1;;Dialogo.Radio4=1 o Dialogo.Radio4=2;;Dialogo.Fecha4<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Fecha5     : 'Hasta'                                    ;  5;2;;Dialogo.Radio4=1 o Dialogo.Radio4=2;;Dialogo.Fecha5<>0;'Debe Ingresar la Fecha Desde';NO;FSys
   Vehiculo2  : 'Grupo'                                    ;  7;1;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
   Lista1     : 'Vehiculo'                                 ;  8;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
   Lista2     : 'Tipos Book'                               ;  9;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
   Lista3     : 'Books'                                    ;  3;2;;;;;;;;SQLSET("Select Codigo From "~DBO~".BOOKS where Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~")");SQLSET("Select Codigo From "~DBO~".BOOKS");
   Radio3     : 'PnL del FY|No|Si'                         ;  4;1;;;;;;;0
   Radio1     : 'Operaciones|Vencidas|No Vencidas|Ambas'   ;  5;1;;;;;;;2
   Radio5     : 'Tipo Op|Forward      |NDF|Futuro |Todos'  ;  6;1;;;;;;;3
   Radio2     : 'Consolidado|No|Si'                        ;  3;1;;;NO;;;;1
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
  ACT(az:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(az:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  else
    ACT(az:1, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' "))
  EndIf
EndIf
If NoVacio(Dialogo.Lista2)
  If NoVacio(Dialogo.Lista3)
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  else
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "))
  endif
Else
  If NoVacio(Dialogo.Lista3)
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  EndIf
EndIf

ACT(ba:0, 'BA')
ACT(bn:0, 'BN')
ACT(bt:0, 'BT')
ACT(ca:0, 'CA')
ACT(cn:0, 'CN')
ACT(ct:0, 'CT')
ACT(da:0, 'DA')
ACT(di:0, 'DI')
ACT(ea:0, 'EA')
ACT(ei:0, 'EI')
ACT(fd:0, 'FD')

SetFilaActual(1)

ACT(a:FAC,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:FAC,2)

IFA
ACT(g:FAC,'Fecha : '~Var('FECHASYS'))
SetFont(g:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, "Reporte de FX Forwards")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)
if NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC, 'Grupo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo2))
else
  if NoVacio(Dialogo.Lista1)
    ACT(a:FAC, 'Vehiculo/s : '~Dialogo.Lista1) 
  else 
    ACT(a:FAC, 'Vehiculo : Todos')
  endif
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+1, 'Especie : Todos')
endif

If NoVacio(Dialogo.Lista2)
  ACT(a:FAC+2, 'Tipos Book: '~Dialogo.Lista2)
else
  ACT(a:FAC+2, 'Tipos Book: Todos')
endif
if NoVacio(Dialogo.Lista3)
  ACT(a:FAC+3, 'Book: '~Dialogo.Lista3)
else
  ACT(a:FAC+3, 'Book: Todos')
endif

*ACT(a:FAC+4, 'Consolidado: NO')

ACT(a:FAC+4, 'Fecha: '~Dialogo.Fecha1)

if Dialogo.Radio3=0
  ACT(a:FAC+5, 'Sin PNL del FY')
else
  ACT(a:FAC+5, 'Con PNL del FY')
endif

if Dialogo.Radio4=0
   ACT(a:FAC+6, 'Fecha de Concertacion desde: '~Dialogo.Fecha2)
   ACT(a:FAC+7, 'Fecha de Concertacion hasta: '~Dialogo.Fecha3)
else
   if Dialogo.Radio4=1
      ACT(a:FAC+6, 'Fecha de Vencimiento desde: '~Dialogo.Fecha4)
      ACT(a:FAC+7, 'Fecha de Vencimiento hasta: '~Dialogo.Fecha5)
   else
      ACT(a:FAC+6, 'Fecha de Concertacion desde: '~Dialogo.Fecha2)
      ACT(a:FAC+7, 'Fecha de Concertacion hasta: '~Dialogo.Fecha3)
      ACT(a:FAC+8, 'Fecha de Vencimiento desde: '~Dialogo.Fecha4)
      ACT(a:FAC+9, 'Fecha de Vencimiento hasta: '~Dialogo.Fecha5)
   endif
endif

if Dialogo.Radio4=2
   if Dialogo.Radio1=0
      ACT(a:FAC+10, 'Operaciones Vencidas')
   else
      if Dialogo.Radio1=1
         ACT(a:FAC+10, 'Operaciones No Vencidas')
      else
         ACT(a:FAC+10, 'Operaciones Vencidas y No Vencidas')
      endif
   endif
   if Dialogo.Radio5=0
      ACT(a:FAC+11, 'Operaciones Forward')
   else
      if Dialogo.Radio5=1
         ACT(a:FAC+11, 'Operaciones NDF')
      else
         if Dialogo.Radio5=2
            ACT(a:FAC+11, 'Operaciones Futuro')
         endif
      endif
   endif
else
   if Dialogo.Radio1=0
      ACT(a:FAC+8, 'Operaciones Vencidas')
   else
      if Dialogo.Radio1=1
         ACT(a:FAC+8, 'Operaciones No Vencidas')
      else
         ACT(a:FAC+8, 'Operaciones Vencidas y No Vencidas')
      endif
   endif
   if Dialogo.Radio5=0
      ACT(a:FAC+9, 'Operaciones Forward')
   else
      if Dialogo.Radio5=1
         ACT(a:FAC+9, 'Operaciones NDF')
      else
         if Dialogo.Radio5=2
            ACT(a:FAC+9, 'Operaciones Futuro')
         endif
      endif
   endif
endif

if Dialogo.Radio4=2
   SetFont(a:fac..N:FAC+11,2)
   
   SetFilaActual(FAC+13)
else
   SetFont(a:fac..N:FAC+9,2)
   
   SetFilaActual(FAC+11)
endif

* TITULOS DEL INFORME
ACT(a:FAC  , 'Fecha de')
ACT(a:FAC+1, 'Concert.')
ACT(b:FAC  , 'Fecha de')
ACT(b:FAC+1, 'Vencim.')
ACT(c:FAC  , 'Nro. de')
ACT(c:FAC+1, 'Operacion')
ACT(d:FAC  , 'Vehiculo')
ACT(e:FAC  , 'Contraparte')
ACT(f:FAC  , 'Book')
ACT(g:FAC  , 'Moneda')
ACT(h:FAC  , 'Nominal')
ACT(i:FAC  , 'Precio')
ACT(i:FAC+1, 'Pactado')
ACT(j:FAC  , 'Precio')
ACT(j:FAC+1, 'Hoy')
ACT(k:FAC  , 'Plazo')
ACT(k:FAC+1, 'Original')
ACT(l:FAC  , 'Plazo')
ACT(l:FAC+1, 'Remanente')
ACT(m:FAC  , 'Tasa')
ACT(m:FAC+1, 'Implicita')
ACT(n:FAC  , 'Net Market')
ACT(n:FAC+1, 'Value')
ACT(o:FAC  , 'P&L en')
ACT(o:FAC+1, 'Pesos')
ACT(p:FAC  , 'Tipo')

SetFont(a:FAC..az:FAC+1,2)
AlinearCeldas(a:FAC..p:FAC+1,'C')
AgregarMarco(a:FAC..p:FAC,1,0,Exe('COLOR'))
AgregarMarco(a:FAC..p:FAC,1,0,Exe('COLOR'))
AgregarMarco(a:FAC+1..p:FAC+1,1,0,Exe('COLOR'))

SetFilaActual(FAC+1)

SQL.ADD("Select O.FechaVto, O.TipoOp,        O.NrOperacion,   O.Vehiculo1, O.Precio2, ")
SQL.ADD("       O.Cliente1, O.Cantidad,      O.Plazo,         O.Especie, O.Precio3, ")
SQL.ADD("       O.FechaOp,  O.ContraEspecie, O.PrecioRef,     O.PrecioRef4, ")
SQL.ADD("       O.Precio1,  O.TipoCambio3,   O.FechaUltCupon, O.Book1, O.TasaPrecan, O.CB8, V.Descripcion, O.CB9 ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B, "~DBO~".VEHICULOS V ")
SQL.ADD(" where ")
if Dialogo.Radio5=0
   *Forward
   SQL.ADD(" O.TipoOp In ('FXCT','FXVT') AND O.CB9 = 0 ")
else
   if Dialogo.Radio5=1
      *NDF
      SQL.ADD(" O.TipoOp In ('FXCT','FXVT') AND O.CB9 = 1 ")
   else
      if Dialogo.Radio5=2
         *Futuro
         SQL.ADD(" O.TipoOp In ('FXCF','FXVF') ")
      else
         SQL.ADD(" O.TipoOp In ('FXCF','FXVF', 'FXCT', 'FXVT') ")
      endif
   endif
endif

SQL.ADD(" and O.Vehiculo1=V.Codigo ")
If Dialogo.Radio4=0
   SQL.ADD(" and O.FechaOp >='"~IdxDate(Dialogo.Fecha2)~"' and O.FechaOp <= '"~IdxDate(Dialogo.Fecha3)~"' ")
else
   If Dialogo.Radio4=1
      SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha4)~"' and O.FechaVto <= '"~IdxDate(Dialogo.Fecha5)~"' ")
   else
      SQL.ADD(" and O.FechaOp >= '"~IdxDate(Dialogo.Fecha2)~"' and O.FechaOp <= '"~IdxDate(Dialogo.Fecha3)~"' ")
      SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha4)~"' and O.FechaVto <= '"~IdxDate(Dialogo.Fecha5)~"' ")
   endif
endif
If Dialogo.Radio1=0
   SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1)~"' ")
else
   If Dialogo.Radio1=1
      SQL.ADD(" and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   endif
endif
SQL.ADD("   and O.Book1    =  B.Codigo ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(Val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD(" order by Vehiculo1,FechaVto,Cliente1,Precio1 ")

ACT(vh:1, '')
ACT(vh:2, '')
ACN(to:1, 0)
ACN(to:2, 0)
ACN(to:3, 0)

Recorrer SQL
  if Not Eqstr(fbn['Vehiculo1'],Val(vh:1)) y Not Eqstr(Val(vh:1),'')
    ACT(a:FAC, 'Vehiculo:')
    SetFont(a:FAC,2)
    ACT(b:FAC, Val(vh:2))
    SetFont(b:FAC,2)
    ACT(c:FAC, 'Total Nominal:')
    SetFont(c:FAC,2)
    ACN(d:FAC, Val(to:1))
    FormatoCeldas(d:FAC,Exe('F2'))
    SetFont(d:FAC,2)
    ACT(e:FAC, 'Total NMV:')
    SetFont(e:FAC,2)
    ACN(f:FAC, Val(to:2))
    FormatoCeldas(f:FAC,Exe('F2'))
    SetFont(f:FAC,2)
    ACT(g:FAC, 'Total P&L:')
    SetFont(g:FAC,2)
    ACN(h:FAC, Val(to:3))
    FormatoCeldas(h:FAC,Exe('F2'))
    SetFont(h:FAC,2)
    ACN(to:1, 0)
    ACN(to:2, 0)
    ACN(to:3, 0)
    IFA
    IFA
  endif  
  * Fecha Concert.
  ACD(a:FAC, fbn('FechaOp'))
  * Fecha Vto        
  ACD(b:FAC, fbn('FechaVto'))
  * Nro Operacion    
  ACT(c:FAC, fbn('NrOperacion'))
  ACLO(c:FAC, fbn('NrOperacion'))
  * Vehiculo         
  ACT(d:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',fbn['Vehiculo1']),1,14))
  * Contraparte      
  ACT(e:FAC, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1']))
  * Book             
  ACT(f:FAC, fbn('Book1'))
  * Moneda           
  ACT(g:FAC, fbn('Especie'))
  * Nominal
  if EqStr(fbn['TipoOp'],'FXCT') O EqStr(fbn['TipoOp'],'FXCF') 
     ACN(h:FAC, fbn('Cantidad'))
  else
     ACN(h:FAC, fbn('Cantidad')*(-1))
  endif
  * Precio Pactado      
  if Dialogo.Radio3=0
    ACN(i:FAC, fbn('Precio1'))
  else
    if fbn('FechaUltCupon')>0 y fbn('FechaUltCupon')<=Dialogo.Fecha1
      ACN(i:FAC, fbn('TipoCambio3'))
    else
      ACN(i:FAC, fbn('Precio1'))
    endif
  endif
  * Precio Hoy  
  if EqStr(fbn['TipoOp'],'FXVF') O EqStr(fbn['TipoOp'],'FXCF')  
     if fbn('FechaVto') <= Dialogo.Fecha1
        ACN(j:FAC, CotizacionC(VAR('USDFUT'),'CON',,,fbn('FechaVto'), 1, ,'ARP',SI))
     else
        ACN(j:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Dialogo.Fecha1, 1, ,'ARP',SI))
     endif
  else
     if fbn('FechaVto') <= Dialogo.Fecha1
        if fbn('CB8')=1 
           ACN(j:FAC, fbn('Precio2'))
        else
           ACN(j:FAC, 0)
        endif
     else
        IF SQL(" Select 1 From "~DBO~".COTIZACIONES where Codigo = 'USD' AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' AND FechaEj= '"~IdxDate(fbn('FechaVto'))~"' AND CallPut = 'FUT' ") = 1
           ACN(j:FAC, CotizacionC(fbn('Especie'),'FUT',fbn('FechaVto'),,Dialogo.Fecha1, 1, SI,'ARP',SI))
        ELSE
           ACN(j:FAC, 0)
        ENDIF
     endif
  endif  
  * Plazo Original   
  ACN(k:FAC, fbn('Plazo'))
  * Plazo Remanente  
  ***---ACN(l:FAC, DifDias(Val(b:FAC), Dialogo.Fecha1, 'ARG', SI))
  ACN(l:FAC, DifDias(Val(b:FAC), Dialogo.Fecha1, '', NO))
  * Tasa Implicita   
  ACN(m:FAC, fbn['TasaPrecan'])
  * Net Market Value 
  if fbn('FechaVto')<Dialogo.Fecha1
     ACN(n:FAC, 0)
  else
     ACN(n:FAC, Val(h:FAC) * Val(j:fac))
  endif
  * P&L en Pesos     (n: Compras / BP: Ventas)
  If EqStr(fbn['TipoOp'],'FXCT') O EqStr(fbn['TipoOp'],'FXVT') 
     if fbn('CB8')=1
        ACN(o:FAC, fbn('Precio3'))
     else
        ACN(o:FAC, Val(h:FAC)*(Val(j:fac)-Val(i:fac)))
     endif
  Else
     ACN(o:FAC,SQL("Select Sum(Precio1) MTM FROM "~DBO~".CUOTAS WHERE NrOperacion= '"~fbn('NrOperacion')~"' "))
  EndIf

  * Tipo de Operacion
  If EqStr(fbn['TipoOp'],'FXCT') O EqStr(fbn['TipoOp'],'FXVT') 
     If fbn['CB9'] = 0
        *Forward
        ACT(p:FAC, 'Forward')
     Else
        ACT(p:FAC, 'NDF')
     EndIf
  Else
     If EqStr(fbn['TipoOp'],'FXCF') O EqStr(fbn['TipoOp'],'FXVF')
        ACT(p:FAC, 'Futuro')
     EndIf
  EndIf

  SCN(to:1, Val(h:FAC))
  SCN(to:2, Val(n:FAC))
  SCN(to:3, Val(o:FAC))
  ACT(vh:1, fbn('Vehiculo1'))
  ACT(vh:2, Val(d:FAC))
Proximo

IFA

ACT(a:FAC, 'Vehiculo:')
SetFont(a:FAC,2)
ACT(b:FAC, Val(vh:2))
SetFont(b:FAC,2)
ACT(c:FAC, 'Total Nominal:')
SetFont(c:FAC,2)
ACN(d:FAC, Val(to:1))
FormatoCeldas(d:FAC,Exe('F2'))
SetFont(d:FAC,2)
ACT(e:FAC, 'Total NMV:')
SetFont(e:FAC,2)
ACN(f:FAC, Val(to:2))
FormatoCeldas(f:FAC,Exe('F2'))
SetFont(f:FAC,2)
ACT(g:FAC, 'Total P&L:')
SetFont(g:FAC,2)
ACN(h:FAC, Val(to:3))
FormatoCeldas(h:FAC,Exe('F2'))
SetFont(h:FAC,2)

* Nominal
FormatoCeldas(h:Val(BX:1)..h:FAC,Exe('F2'))
* Precio Pactado
FormatoCeldas(i:Val(BX:1)..i:FAC,Exe('F7'))
* Precio Hoy
FormatoCeldas(j:Val(BX:1)..j:FAC,Exe('F7'))
* Plazo
FormatoCeldas(k:Val(BX:1)..k:FAC,Exe('F0'))
* Plazo Remanente
FormatoCeldas(l:Val(BX:1)..l:FAC,Exe('F0R'))
* Taza Implicita
FormatoCeldas(m:Val(BX:1)..m:FAC,Exe('F7'))
* Net Market Value
FormatoCeldas(n:Val(BX:1)..n:FAC,Exe('F2'))
* P$L en Pesos
FormatoCeldas(o:Val(BX:1)..o:FAC,Exe('F2'))

ACN(ax:3, 15)
*(.'AUXREPFXF'.)

SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

SetFont(av:1..az:3,1)

