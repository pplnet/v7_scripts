AgregarMarco(e8..g8,1)
AgregarMarco(h8..j8,1)
AgregarMarco(k8..m8,1)
AgregarMarco(n8..p8,1)
AgregarMarco(c8..c8,1)
AgregarMarco(f8..f8,1)
AgregarMarco(i8..i8,1)
AgregarMarco(l8..l8,1)
AgregarMarco(o8..o8,1)

SetFilaActual(8)
SQL.ADD("Select Codigo, RazonSocial from "~DBO~".CLIENTES")
Recorrer SQL

  if DesciendeDeCliente(fbn('Codigo'), 'BANCOS') y EsTerminal(fbn('Codigo'), Cliente)
     ACT(a:fac, fbn('Codigo'))
     ACN(b:fac, LimConsumido(fbn('Codigo'), 'COTOR'     ,'USD',0,,,,,Dialogo.Fecha1))
     ACN(e:fac, LimConsumido(fbn('Codigo'), 'CONTRACT'  ,'USD',0,,,,,Dialogo.Fecha1))
     ACN(h:fac, LimConsumido(fbn('Codigo'), 'PRESETTLEM','USD',0,,,,,Dialogo.Fecha1))
     ACN(k:fac, LimConsumido(fbn('Codigo'), 'CUSTODY'   ,'USD',0,,,,,Dialogo.Fecha1))
     SCN(n:fac, LimConsumido(fbn('Codigo'), 'SETCRE'    ,'USD',0,,,,,Dialogo.Fecha1))

     * Busco Las Sumatorias 
     SQL.ADD("Select Limite,Sum(Monto) Monto from "~DBO~".MOVLIMITES ")
     SQL.ADD("where Cliente = '"~val(a:fac)~"' ")
     SQL.ADD("and FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
     SQL.ADD("and ((Limite In ('SETCRE') and Bits='P')  ")
     SQL.ADD("or Limite In ('COTOR','CONTRACT','PRESETTLEM','CUSTODY')) ")
     SQL.ADD("group by Limite")
     SQL.ADD("order by Limite")

     Recorrer SQL
        dfa 
        Message(val(a:fac)~' '~FBN['Limite']~' '~Fstr(FBN['Monto'],0,2))    

        if EqStr(FBN['Limite'],'COTOR') y FBN['Monto']<>0
           ACN(c:fac,FBN['Monto'])
        endif

        if EqStr(FBN['Limite'],'CONTRACT') y FBN['Monto']<>0
           ACN(f:fac,FBN['Monto'])
        endif

        if EqStr(FBN['Limite'],'PRESETTLEM') y FBN['Monto']<>0
           ACN(i:fac,FBN['Monto'])
        endif

        if EqStr(FBN['Limite'],'CUSTODY') y FBN['Monto']<>0
           ACN(l:fac,FBN['Monto'])
        endif

        if EqStr(FBN['Limite'],'SETCRE') y FBN['Monto']<>0
           ACN(o:fac,FBN['Monto'])
        endif

        ACN(d:fac, Val(b:fac)-Val(c:fac))
        ACN(g:fac, Val(e:fac)-Val(f:fac))
        ACN(j:fac, Val(h:fac)-Val(i:fac))
        ACN(m:fac, Val(k:fac)-Val(l:fac))
        ACN(p:fac, Val(n:fac)-Val(o:fac))
     Proximo 
  else
    dfa
  endif
proximo

AgregarMarco(a9..a:fac,1)
AgregarMarco(b9..d:fac,1)
AgregarMarco(e9..g:fac,1)
AgregarMarco(h9..j:fac,1)
AgregarMarco(k9..m:fac,1)
AgregarMarco(n9..p:fac,1)

SetFont(a1..az:8, 1)
SetFont(a9..az:fac, 2)
FormatoCeldas(b9..p:fac, Exe('F2'))
Impresion(1,2)
LimitesVision(q:fac+1)
