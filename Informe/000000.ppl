CrearFont(2,'Arial,8,')

ACT(a4, 'Verificacion de Limites de Credito/Consumidos ')
ACT(a5, 'Fecha: '~Fecha(Dialogo.Fecha1))

ACT(a7, 'Entidad')
ACT(b7, 'Credito')
ACT(e7, 'Contratos')
ACT(h7, 'Pre-Settlement')
ACT(k7, 'Custody')
ACT(n7, 'Settlement')
ACT(b8, 'Consumido')
ACT(c8, 'Sumatoria')
ACT(d8, 'Diferencia')
ACT(e8, 'Consumido')
ACT(f8, 'Sumatoria')
ACT(g8, 'Diferencia')
ACT(h8, 'Consumido')
ACT(i8, 'Sumatoria')
ACT(j8, 'Diferencia')
ACT(k8, 'Consumido')
ACT(l8, 'Sumatoria')
ACT(m8, 'Diferencia')
ACT(n8, 'Consumido')
ACT(o8, 'Sumatoria')
ACT(p8, 'Disponible')

AgregarMarco(a7..p8,1,0,Exe('COLOR'))
AgregarMarco(b7..d8,1)
AgregarMarco(e7..g8,1)
AgregarMarco(h7..j8,1)
AgregarMarco(k7..m8,1)
AgregarMarco(n7..p8,1)
