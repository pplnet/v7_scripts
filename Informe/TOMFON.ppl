HojaVisible(NO)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Especie1 : 'Especie'           ;;;;;;;;;Var('MONELOCA');;;;;"Tipo='MON' "
  Radio1   : 'Consolidado|Si|No' ;;;;;;;;;0;
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0;
  Precio1  : 'Cotizacion'        ;;;;;Not EqStr(Dialogo.Especie1,Dialogo.Especie2);Dialogo.Precio1<>0 o EqStr(Dialogo.Especie1,Dialogo.Especie2);'Debe ingresar la cotizacion.';NO;
  Especie2 : 'especie '          ;;;;;NO;;;;IIF(Dialogo.Radio2=0,'ARP','USD');IIF(Dialogo.Radio2=0,'ARP','USD');
  Lista1   : 'Vehiculo'          ;6;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
  Lista2   : 'Tipos Op'          ;0;2;;;;;;;'MMPCCV|MMPCCM|MMPCLM|MMPCL|MMPLME|';;'MMFIMV|VIMIND|VIMINM|MMSIMV|MMPSI|MMON|MMONM|MMPEM|MMPIM|MMPOSM|MMFRNP|MMPCOS|MMPE|MMPI|MMPLME|'
FinDialogo

if not OK
  Cancelar
endif

*- Control de Vehiculos Habilitados
ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")) ) 

if Dialogo.Radio1=1
   (.'SELTOMFON'.)
   ACN(ba1,0)
   Recorrer SQL
      SCN(ba1,1)
      LinkearHoja('TOMFO1', Val(ba1), Fecha1=Dialogo.Fecha1, Especie1=Dialogo.Especie1, Radio2=Dialogo.Radio2, Precio1=Dialogo.Precio1, Especie2=Dialogo.Especie2, Lista1=FBN['Vehiculo1'], Lista2=Dialogo.Lista2)
   Proximo

else
   LinkearHoja('TOMFO1',1, Fecha1=Dialogo.Fecha1, Especie1=Dialogo.Especie1, Radio2=Dialogo.Radio2, Precio1=Dialogo.Precio1, Especie2=Dialogo.Especie2, Lista1=IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,Val(zz6)), Lista2=Dialogo.Lista2)
endif