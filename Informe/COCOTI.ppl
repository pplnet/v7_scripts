CrearDialogo
  Fecha1     : "Fecha Desde" ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Fecha2     : "Fecha Hasta" ;2;1;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys
  Cliente1   : "Entidad"     ;3;1;
  Especie1   : "Titulo"      ;4;1;;;;Vacio(Dialogo.Especie1) O DESCIENDEDEESPECIE(Dialogo.Especie1,'TITULO') O DESCIENDEDEESPECIE(Dialogo.Especie1,'LETRA');'La Especie ingresada no es un TITULO o una Letra';NO;;;;;;"dbo.DESCIENDEDEESPECIE(Codigo,'TITULO') = 1 OR dbo.DESCIENDEDEESPECIE(Codigo,'LETRA') = 1";
  Radio2     : 'Filtra Book|SI|NO'    ;5;1;;;;;;;1;
  Lista1     : 'Vehiculos'            ;6;1;;;Dialogo.Radio2=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Vehiculo1  : 'Vehiculo'             ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2     : 'Books'                ;3;1;;;Dialogo.Radio2=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Radio3     : 'Consolida Book|SI|NO' ;4;1;;;;;;;0;
FinDialogo

if Not Ok
  Cancelar
endif

***Si se selecciona Book, uso el mismo código cambiando lista vehiculo por campo vehiculo
IF Dialogo.Radio2 = 0 
  ACT(zz6,Dialogo.Vehiculo1)
  IF NoVacio(Dialogo.Lista2)
    ***ZZ6 es la celda que guarda la variable de vehiculo, seguirla a través del script
    ***ZZ7 Guarda el dato del Book
    ACT(ZZ:7, Dialogo.Lista2)
  ELSE
    ACT(ZZ:7, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' "))
  EndIf
  *** Si no se selecciona Book (el Radio2 es uno) entonces trabaja igual que antes:
ELSE
  * Vehiculos permitidos por el usuario
  If NoVacio(Dialogo.Lista1)
     ACT(zz6,Dialogo.Lista1)
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
    Else
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')")) 
    EndIf
  EndIf
ENDIF


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

***Insertar Logo
let &filaLogo 1
@LOGO

SetFilaActual(fac+5)
ACT(a:fac,'CONTROL CONTABLE')
SetFont(a:fac..a:fac,2)

SetFilaActual(7)
ifa
ACT(c:fac,'Fecha : '~Var('FECHASYS'))
SetFont(c:fac..c:fac,1)
ifa
ifa
ACT(a:FAC, "Titulos")
SetFont(a:fac..a:fac,3)

if NoVacio(VAL(ZZ6))
  ACT(a:FAC+1, 'Vehiculo : '~VAL(ZZ6))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

IF NoVacio(Dialogo.Lista2)
    ACT(A:FAC+2,'Book : ' ~Dialogo.Lista2)
Else
    ACT(A:FAC+2,'Book : Todos')
Endif

ACT(a:FAC+3, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Fecha Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
    ACT(a:FAC+5, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
    ACT(a:FAC+5, 'Entidad : Todas')
endif
if NoVacio(Dialogo.Especie1)
    ACT(a:FAC+6, 'Titulo : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
    ACT(a:FAC+6, 'Titulo : Todos')
endif
SetFont(a:fac+1..a:fac+6,2)

SetFilaActual(FAC+8)

*Me fijo cual va a ser el ultimo fin de mes a colocar
IF Dialogo.Fecha2 = FinDeMes(Dialogo.Fecha2,NO)
    let &ultimoFinMes Dialogo.Fecha2
ELSE
    let &ultimoFinMes FinDeMes(PriDeMes(Dialogo.Fecha1,SI)-1,NO)
ENDIF

*LEVANTO LOS DATOS
*Saldo Inicial
SQL.ADD(" SELECT S.Fecha, 'Saldo Inicial' Operacion, S.Saldo Cantidad, 0 Tip,   ")
SQL.ADD(" 0 PrecioDirty, 0 PrecioClean, 'Saldo Inicial' NrOperacion, E.InteresesC CotizaClean, ")
SQL.ADD(" S.EnteCustodia Vehiculo, S.Especie, E.Cotiza Moneda,   ")
IF Dialogo.Radio3 = 0
    SQL.ADD(" 'Consolidado' Book ")
ELSE
    SQL.ADD(" V.Alias5 Book ")
ENDIF
SQL.ADD(" FROM "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE S.NrSaldo = 1  ")
SQL.ADD(" AND S.Especie = E.Codigo ")
SQL.ADD(" AND S.EnteCustodia = V.Codigo ")
SQL.ADD(" AND S.Saldo <> 0 ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND S.Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND S.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
if NoVacio(VAL(ZZ6))
    SQL.ADD("and S.Cliente  in ("~Pipe2Comillas(val(zz6))~")")
    SQL.ADD("and S.EnteCustodia in ("~Pipe2Comillas(val(zz6))~") ")
endif
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND S.Book IN ("~Pipe2Comillas(val(zz7))~") ")
ENDIF
SQL.ADD(" AND S.Fecha = ( SELECT Max(D.Fecha) FROM "~DBO~".SALDOSDIA D ")
SQL.ADD("               WHERE D.NrSaldo = 1 ")
SQL.ADD("               AND D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("               AND D.Especie = S.Especie ")
SQL.ADD("               AND D.Cliente = S.Cliente ")
SQL.ADD("               AND D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" UNION ")
*Compras y Ventas
SQL.ADD(" SELECT O.FechaVto Fecha, CASE TipoOp WHEN 'SECS' THEN 'Compra' ELSE 'Venta' END Operacion, O.Cantidad, 1 Tip,  ")
SQL.ADD(" O.Spread PrecioDirty, O.Precio6 PrecioClean, O.NrOperacion, E.InteresesC CotizaClean, ")
SQL.ADD(" O.Vehiculo1 Vehiculo, O.Especie, E.Cotiza Moneda,   ")
IF Dialogo.Radio3 = 0
    SQL.ADD(" 'Consolidado' Book ")
ELSE
    SQL.ADD(" O.Book1 Book ")
ENDIF
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE O.TipoOp in ('SECS','SEVS') ")
SQL.ADD(" AND O.Especie = E.Codigo ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
if NoVacio(VAL(zz6))
    SQL.ADD(" AND O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(val(zz7))~") ")
ENDIF
SQL.ADD(" AND O.FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" UNION ")
*Cupones
SQL.ADD(" SELECT T2.Fecha1 Fecha, 'Cupon' Operacion, T2.Cantidad1 Cantidad, 2 Tip, ")
SQL.ADD(" T2.Precio1 PrecioDirty, T2.Precio1 PrecioClean, T2.NrTrans NrOperacion, E.InteresesC CotizaClean, ")
SQL.ADD(" T2.Vehiculo1 Vehiculo, T2.Especie, E.Cotiza Moneda, ")
IF Dialogo.Radio3 = 0
    SQL.ADD(" 'Consolidado' Book ")
ELSE
    SQL.ADD(" T2.Ley1 Book ")
ENDIF
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T2, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE T2.Especie = E.Codigo ")
SQL.ADD(" AND T2.TipoTr2 = 'CUPON' AND T2.Cantidad4 = 2 ")
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND T2.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
if NoVacio(VAL(zz6))
    SQL.ADD(" AND T2.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND T2.Book1 IN ("~Pipe2Comillas(val(zz7))~") ")
ENDIF
SQL.ADD(" AND T2.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Order By 10,9,12,4,1 ")

*Declaro las variables que me hacen falta
let &esPrimerRegistro 0 

let &totalResultadoIntereses 0
let &totalResultadoCapital 0
let &totalResultado 0

let &especieActual ''
let &vehiculoActual ''
let &bookActual ''
let &fechaUltimoRegistroProcesado ''

Recorrer SQL
    *Si cambió la especie, el vehiculo o el book, tengo que empezar un nuevo cuadro
    IF Not Eqstr(fbn('Especie'),&especieActual) O Not Eqstr(fbn('Vehiculo'),&vehiculoActual) O Not Eqstr(fbn('Book'),&bookActual)
        *Me fijo si inclui el fin de mes para el conjunto anterior y si no estoy en primer registro
        IF &esPrimerRegistro <> 0 Y &fechaUltimoRegistroProcesado <= &ultimoFinMes  
            *Tengo que poner el ultimo fin de mes del registro anterior        
        ENDIF
        
        *Pongo los titulos y completo las variables para el registro actual
        let &especieActual fbn('Especie')
        let &vehiculoActual fbn('Vehiculo')
        let &bookActual fbn('Book')
        
        ACT(A:FAC,'Fecha')
        ACT(A:FAC+1,'Liquidacion')
        ACT(B:FAC,'Operacion')
        ACT(C:FAC,'Cantidad')
        ACT(D:FAC,'Precio')
        ACT(D:FAC+1,'Dirty')
        ACT(E:FAC,'Monto')
        ACT(F:FAC,'Precio')
        ACT(F:FAC+1,'Clean')
        ACT(G:FAC,'Nro Operacion')
        ACT(H:FAC,'Res INTERES')
        ACT(H:FAC+1,'en ARP')
        ACT(I:FAC,'Res CAPITAL')
        ACT(I:FAC+1,'en ARP')
        ACT(J:FAC,'Res TOTAL')
        ACT(J:FAC+1,'en ARP')
        SetFont(A:fac..J:fac+1,2)
        AgregarMarco(A:fac..J:fac+1,2,0,Exe('COLOR'))
        IFA
        IFA
    ENDIF
    *Me fijo si tengo que colocar datos de un fin de mes
    IF &esPrimerRegistro <> 0 Y &fechaUltimoRegistroProcesado <= FinDeMes(&fechaUltimoRegistroProcesado,NO) Y fbn('Fecha') > FinDeMes(&fechaUltimoRegistroProcesado,NO)
        *Tengo que poner una linea para el fin de mes
        IFA
    ENDIF
    *Proceso el registro actual
    IF fbn('Tip') = 0
        *SaldoInicial
        ACD(A:FAC,fbn('Fecha'))
        ACT(B:FAC,fbn('Operacion'))
        ACN(C:FAC,fbn('Cantidad'))
        let &precioEspecie Cotizacion(fbn('Especie'),,,,fbn('Fecha'),1,SI,SI)
        let &interesCorrido SQL(" SELECT Intereses FROM "~DBO~".INTERESESCORRIDOS WHERE Especie = '"~fbn('Especie')~"' and Fecha <= '"~IdxDate(fbn('Fecha'))~"' ")
        IF Eqstr(fbn('CotizaClean'),'DIR')
            *Cotiza Dirty
            ACN(D:FAC,&precioEspecie)
            ACN(F:FAC,&precioEspecie+&interesCorrido)
        ELSE
            *Cotiza Clean
            ACN(D:FAC,&precioEspecie-&interesCorrido)
            ACN(F:FAC,&precioEspecie)            
        ENDIF
        ACN(E:FAC,Val(C:FAC)*Val(D:FAC))
        ACT(G:FAC,fbn('NrOperacion'))
        SQL.ADD(" SELECT ")
        SQL.ADD(" FROM "~DBO~".RESULTADOS2 ")
        SQL.ADD("  ")
        Recorrer SQL
            DFA
            ACN()
            ACN()
            ACN()
        Proximo
    ELSE
        IF fbn('Tip') = 1
            *Operacion
        
        ELSE
            *Cupon
        
        ENDIF
    ENDIF
    
    let &esPrimerRegistro 1
    let &fechaUltimoRegistroProcesado fbn('Fecha')
Proximo









