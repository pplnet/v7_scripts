*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   :'Fecha Desde' ;2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar Fecha Desde';NO;FSys
  Fecha2   :'Fecha Hasta' ;3;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar Fecha Hasta';NO;FSys
  Especie1 :'Especie'     ;4;1
  Cliente1 :'Cliente'     ;5;1
  NrTrans1 :'Nro. Trans'  ;6;1
  Mercado1 :'Mercado'     ;7;1  
  Vehiculo1: "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Lista1   : "Tipos Op."  ;1;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION ")  
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:2, 'TRAOPE')
SetFont(a:2..a:2,1)
ACT(m:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(m:2..m:2,1)
AlinearCeldas(m:2..m:2,'D')

SetFilaActual(3)

ACT(a:FAC, 'Transacciones con Detalle de Operaciones')
SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+1)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo :  '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
  else
   ACT(a:FAC+1, 'Vehiculo :  Todos')
endif
ACT(a:FAC+2, 'Fecha Desde:  '~Dialogo.Fecha1)
ACT(c:FAC+2, 'Fecha Hasta:  '~Dialogo.Fecha2)
if NoVacio(Dialogo.especie1)
   ACT(a:FAC+3, 'Especie :  '~BuscarCampo('ESPECIES', 'Nombre','Codigo',Dialogo.Especie1))
  else
   ACT(a:FAC+3, 'Especie :  Todas')
endif
if NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+4,copy( 'Cliente :  '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1),1,40))
  else
   ACT(a:FAC+4, 'Cliente :  Todos')
endif
if NoVacio(Dialogo.NrTrans1)
   ACT(a:FAC+5, 'Transaccion :  '~Dialogo.NrTrans1)
  else
   ACT(a:FAC+5, 'Transaccion :  Todas')
endif
if NoVacio(Dialogo.Mercado1)
   ACT(a:FAC+5, 'Mercado :  '~Dialogo.Mercado1)
  else
  ACT(a:FAC+5, 'Mercado :  Todos')
endif
if NoVacio(Dialogo.Lista1)
  ACT(a:FAC+6, 'Tipo de Operaciones : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(a:FAC+6, 'Tipo de Operaciones : Todos')
endif

SetFilaActual(FAC+8)
ACT(a:FAC, 'Instancia')
ACT(b:FAC, 'Tipo Tr.')
ACT(c:FAC, 'Numero')
ACT(d:FAC, 'Numero Cta.Cl.')
ACT(e:FAC, 'Cta.Propia')
ACT(f:FAC, 'Codigo')
ACT(g:FAC, 'Cliente')
ACT(h:FAC, 'Monto Trans.')
ACT(i:FAC, 'Estado')
ACT(j:fac, 'Fecha')
ACT(k:FAC, 'Tipo Op./Tr.')
ACT(l:FAC, '# Op./Tr.')
ACT(m:FAC, 'Especie2')
ACT(n:FAC, 'Monto Esp2')
ACT(o:FAC, 'Monto Op.')
ACT(p:FAC, 'Concepto')
ACT(q:FAC, 'Fecha Mov.')
ACT(r:FAC, 'Custodia')
acn(vx8,fac)
AlinearCeldas(a:FAC..g:FAC,'I')
AlinearCeldas(h:FAC..h:FAC,'D')
AlinearCeldas(i:FAC..k:FAC,'I')
AlinearCeldas(j:FAC..j:FAC,'D')
AlinearCeldas(l:FAC..o:FAC,'D')
SetFont(a:5..r:FAC,2)
AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD("Select T.*, M.NrOperacion, M.FechaMov, M.Cantidad, O.NrBit, O.Valor, ")
SQL.ADD("I.Nombre, M.Leyenda, P.TipoOp ")
SQL.ADD("From "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O, "~DBO~".INSTANCIAS I, "~DBO~".OPERACIONES P ")
SQL.ADD("where T.NrTrans = M.NrTrans2 ")
SQL.ADD("and O.NrOperacion = T.NrTrans ")
SQL.ADD("and M.NrOperacion <> T.NrTrans ")
SQL.ADD("and O.Valor = '1' ")
SQL.ADD("and O.NrBit = I.NrInstancia ")
SQL.ADD("and I.Tabla = 'TRANSACCIONES2' ")
SQL.ADD("and T.Especie = M.Especie ")
SQL.ADD("and M.NrOperacion = P.NrOperacion ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Fecha1) o NoVacio(Dialogo.Fecha2)
   SQL.ADD("and T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQl.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and T.NrTrans = '"~Dialogo.NrTrans1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
   SQL.ADD("and T.Mercado1 = '"~Dialogo.Mercado1~"'  ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and P.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif

SQL.ADD("union ")                

SQL.ADD("Select T.*, M.NrOperacion, M.FechaMov, M.Cantidad, O.NrBit, O.Valor, ")
SQL.ADD("I.Nombre, M.Leyenda, T2.TipoTr2 TipoOp ")
SQL.ADD("From "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O, "~DBO~".INSTANCIAS I, "~DBO~".TRANSACCIONES2 T2 ")
SQL.ADD("where T.NrTrans = M.NrTrans2 ")
SQL.ADD("and O.NrOperacion = T.NrTrans ")
SQL.ADD("and M.NrOperacion <> T.NrTrans ")
SQL.ADD("and O.Valor = '1' ")
SQL.ADD("and O.NrBit = I.NrInstancia ")
SQL.ADD("and I.Tabla = 'TRANSACCIONES2' ")
SQL.ADD("and T.Especie = M.Especie ")
SQL.ADD("and M.NrOperacion = T2.NrTrans ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Fecha1) o NoVacio(Dialogo.Fecha2)
   SQL.ADD("and T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQl.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and T.NrTrans = '"~Dialogo.NrTrans1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
   SQL.ADD("and T.Mercado1 = '"~Dialogo.Mercado1~"'  ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and T2.TipoTr2 In ('TRANSP')")
endif

SQL.ADD("order by T.Especie, T.Mercado1, T.FechaEj, T.PrecioEj, T.CallPut, T.TipoTr2, T.NrTrans     ")

acn(z4,0)
recorrer SQL

  IF Not EqStr(FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9) o Not EqStr(FBN['tipotr2'], Val(Z10))
     if val(z4) <> 0
        if vacio(val(z9)) o val(z9) = 0
           ACT(g:FAC,'Total '~val(z10)~'  '~val(z2)~' :')
        else
           ACT(g:FAC,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
        endif
        acn(h:fac,val(z3))
        acn(n:fac,val(z5))
        SetFont(a:fac..n:FAC,2)
        FormatoCeldas(h:FAC..o:FAC,exe('F2'))
        ifa
     endif
     ACT(Z10,FBN['tipotr2'])
     acn(z3,0)
     acn(z5,0)
  endif

  if Not EqStr(FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9)
     if vacio(fbn['precioej']) o fbn['precioej'] = 0
        ACT(a:FAC,FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'])
       else
        ACT(a:FAC,FBN['Especie']~' '~FBN['Mercado1']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     endif
     SetFont(a:fac..a:FAC,2)
     ACT(Z2,FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'])
     ACD(Z8,FBN['FechaEj'])
     ACN(z9,FBN['PrecioEj'])
     ifa
  endif
  acn(z4,1)

  IF Not EqStr(FBN['Nrtrans'], Val(Z11))
     ACT(Z11,FBN['Nrtrans'])
     ACT(a:FAC, FBN['Nombre'])
     ColorCeldas(a:fac,clBlue)
     ACT(b:FAC, FBN['TipoTr2'])
     ACT(c:FAC, FBN['NrTrans'])
     ACLT(c:fac,FBN['NrTrans'])
     ACT(d:FAC, BuscarCampo('CUENTAS','Numero','Codigo',FBN['Cuenta1']))
     ACT(e:FAC, FBN['Cuenta2'])
     ACT(f:FAC, FBN['Cliente1'])
     ACT(g:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(az1,val(g:FAC))
     ACN(h:FAC, FBN['Cantidad1'])
     ACT(i:FAC, FBN['Ley1'])
     if Not Eqstr(FBN['Ley1'],'FALL')
        SCN(z3, FBN['Cantidad1'])
     endif
     ACD(j:fac, fbn['Fecha1'])
     AlinearCeldas(j:FAC..j:FAC,'D')
  endif

  ACT(k:FAC, iif(NoVacio(fbn['TipoOp']),fbn['TipoOp'],BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion'])))
  ACT(l:FAC, FBN['NrOperacion'])
  If Eqstr(Copy(Val(l:FAC),1,2),'VT')
    ACLT(l:fac,Val(l:FAC))
  Else
    ACLO(l:fac,Val(l:FAC))
  Endif
  IF Eqstr(FBN['TipoTr2'],'MATCH')
     ACT(m:FAC, FBN['Especie1'])
     ACN(n:FAC, FBN['Cantidad2'])
     SCN(z5, FBN['Cantidad2'])
  ENDIF   
  ACN(o:FAC, FBN['Cantidad']*(-1))
  ACT(p:FAC, FBN['Leyenda']~' '~Val(az1))
  ACD(q:fac, fbn['FechaMov'])
  if Novacio(fbn['NrOperacionRef2'])
       ACT(r:fac, fbn['NrOperacionRef2'])
       ACLT(r:fac, fbn['NrOperacionRef2'])
  endif
  AlinearCeldas(l:FAC..l:FAC,'D')
  FormatoCeldas(h:FAC..h:FAC,exe('F2'))
  FormatoCeldas(n:FAC..o:FAC,exe('F2'))
  SetFont(a:fac..r:FAC,1)

proximo

if val(z4) <> 0
   if vacio(val(z9)) o val(z9) = 0
      ACT(g:FAC+1,'Total '~val(z10)~'  '~val(z2)~' :')
     else
      ACT(g:FAC+1,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
   endif
   acn(h:fac+1,val(z3))
   acn(n:fac+1,val(z5))
   SetFont(a:fac+1..n:FAC+1,2)
   FormatoCeldas(h:FAC..o:FAC,exe('F2'))
   ifa
endif

ACO(1,12)
ACO(2,5)
ACO(3,7)
ACO(4,15)
ACO(5,8)
ACO(6,6)
ACO(7,20)
ACO(8,12)
ACO(9,5)
ACO(10,7)
ACO(11,7)
ACO(12,7)
ACO(13,7)
ACO(14,12)
ACO(15,12)
ACO(16,25)
ACO(17,9)
ACO(18,9)

Impresion(1,2)
SetFilaActual(FAC+3)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(r:FAC)
SetPrintFit(2)
RangoTitulo(a:1..r:fac+1, val(vx8))
