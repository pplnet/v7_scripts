ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")


SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo,  O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zh:99, fbn['Plazo'])
   ACT(zj:99, PYC(fbn['Precio1'],1,2))
   ACD(zm:99, fbn['FechaOp'])
Proximo

If Not EqStr(val(za:99), 'MMO') 
    Cancelar
Endif


SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')

SetFilaActual(fac+3)
ACT(a:fac,'Señores')
SetFont(a:10..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra mayor consideraci'~Chr(243)~'n:')

SetFilaActual(fac+3)
ACT(a:fac,'De acuerdo a los fondos a nuestra disposici'~Chr(243)~'n en nuestra Cuenta Nro.: '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99)))
SetFilaActual(fac+1)
ACT(a:fac,'de vuestro banco por la suma de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-, solicitamos a Uds. tengan a bien aplicar los')
SetFilaActual(fac+1)
ACT(a:fac,'mismos a la operaci'~Chr(243)~'n de Over Night cerrada en el d'~Chr(237)~'a de la fecha con las siguientes condiciones:')

SetFont(a:val(zz:99)..a:fac,1)

SetFilaActual(fac+3)
acn(zz:99, fac)
ACT(a:fac,'Monto: '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-')
SetFilaActual(fac+1)
ACT(a:fac,'Plazo: '~val(zh:99)~IIF(num(val(zh:99))>1,' d'~Chr(237)~'as',' d'~Chr(237)~'a')~'.')
SetFilaActual(fac+1)
ACT(a:fac,'T.N.A.: '~val(zj:99)~'%')
SetFont(a:val(zz:99)..a:fac,2)


SetFilaActual(fac+2)
ACT(a:Fac,'Sin otro particular, saludamos a Uds. atentamente.')
SetFont(a:fac,1)

