*-ACT(d:Fac,'       '~val(zg:99) )
*-SetFont(d:fac,2)

*-SetFilaActual(fac+3)
*-ACT(d:Fac,'APODERADO')
*-ACT(f:Fac,'       '~'APODERADO')
*-SetFont(d:fac..f:fac,4)

AgregarBMP(a:3,Var('PATHLOGO')~val(zg:99)~'.bmp',80)  
Impresion(2, 0) 
Impresion(3, 0)

SetMargins(3, 0, 0, 0)

LimitesVision(m:FAC+1)