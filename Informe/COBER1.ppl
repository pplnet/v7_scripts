ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"      ;;;
  TipoOp1    : "Tipo Op."     ;;;
  Fecha1     : "Fecha Desde"  ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;PriDeMes(Fsys)
  Fecha2     : "Fecha Hasta"  ;;;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;FinDeMes(Fsys)
  Lista1     : 'Precios'      ;;;;;;NoVacio(Dialogo.Lista1);'Precios Incorrectos';NO;;;'17|18|19|20|21|22|';
  Radio1     : 'Vol.|Mensual|Diario ' ;;;;;;;;;1
FinDialogo

if Not Ok
  Cancelar
endif

* message(dialogo.Vehiculo1)
* message(dialogo.Especie1)
* message(dialogo.TipoOp1)
* message(dialogo.Fecha1)
* message(dialogo.Fecha2)
* message(dialogo.Lista1)

* En String1 llegan los otros condicionantes del Group by del llamador
* group by O.UMedida, O.MB1, O.MB4, O.MB3, O.FechaOp2, O.FechaEj, O.FechaEx1, O.FechaPrecan, O.TipoCambio3, O.MB2, O.RB9 

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Planilla de Cobertura - Detalle de Operaciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+2, 'Especie : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+3, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+3, 'Tipo Op. : Todos')
endif
ACT(a:FAC+4, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+6, 'Precios : '~Dialogo.Lista1 )
ACT(a:FAC+7, 'Volumen  '~Iif(Dialogo.Radio1=1,'Diario','Mensual') )

SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

acn(v1,fac)

ACT(a:fac, 'Producto')
ACT(b:fac, 'Nro.Op.')
ACT(c:fac, 'Dealer')
ACT(d:fac, 'Tipo')
ACT(e:fac, 'P.Strike')
ACT(f:fac, 'Volumen')
ACT(g:fac, 'Un.M.')
ACT(h:fac, 'F.Inicio')
ACT(i:fac, 'F.Fin')
ACT(j:fac, 'Vol.Total')

*- Primera Columna para listar el precio 
ACN(pc1,11)
ACN(lc1,fac-1)

Recorrer&i 1,Elementos(Dialogo.Lista1)

   Message('Recorriendo la Lista '~ItemLista(Dialogo.Lista1,&i))

   If Num(ItemLista(Dialogo.Lista1,&i))=0
      Break
   EndIf

   acn(val(pc1):fac-1,Num(ItemLista(Dialogo.Lista1,&i)))       
   FormatoCeldas(val(pc1):fac-1..val(pc1):fac-1, Exe('F7'))

   act(val(pc1):fac,'V.'~IIf(Dialogo.Radio1=1,'Diario','Mensual'))
   aco(val(pc1),10)

   act(val(pc1)+1:fac,'Precio')
   aco(val(pc1)+1,5)

   SetFont(val(pc1):fac-1..val(pc1)+1:fac,2)
   AgregarMarco(val(pc1):fac-1..val(pc1)+1:fac-1,2,0,Exe('COLOR'))
   AgregarMarco(val(pc1):fac..val(pc1)+1:fac,2,2,Exe('COLOR'))

   scn(pc1,2)
Proximo

scn(pc1,-1)
AgregarMarco(a:fac..val(pc1):fac, 2,0,Exe('COLOR'))
SetFont(a:fac-1..val(pc1)+1:fac,2)

*-- Opciones Simples 
SQL.ADD("Select * from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaEj >='"~IdxDate(Dialogo.Fecha1)~"'  and ")
SQL.ADD("      TipoOp In ('DPOS','DPBOS','DPOGS') and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
If NoVacio(Dialogo.TipoOp1)
 SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("Union All ")
SQL.ADD("Select * from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.FechaEj >='"~IdxDate(Dialogo.Fecha1)~"'  and ")
SQL.ADD("       O.FechaOp2 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and  O.TipoOp Like 'DP%' ")
SQL.ADD(" and  O.TipoOp Not In ('DPOS','DPBOS','DPOGS','DPC','DPF','DPSN','DPDSS','DPRS','DPRRS','DPDSO','DPS') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
If NoVacio(Dialogo.TipoOp1)
 SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("Union All ")
SQL.ADD("Select * from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD(" and  O.TipoOp In ('DPRS','DPRRS') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
Endif
If NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("Union All ")
SQL.ADD("Select * from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and  ((O.TipoOp In ('DPDSS') and  (CB8='0' or CB8 IS NULL)) ")
SQL.ADD(" or  O.TipoOp In ('DPDSO','DPS')) ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
Endif
If NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("order by Vehiculo1, TipoOp, NrOperacion")

Recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))

     *-- Cambia Tipo Op.
     if NoVacio(Val(z7))
        act(a:fac,'Total Tipo Op.' )
        acn(j:fac, Val(w5))
        BorrarCeldas(w5..w5)
        AgregarMarco(a:fac..val(pc1):fac,1)
        SetFont(a:fac..val(pc1):fac,2)
        ifa
     Endif

     * cambia empresa
     if NoVacio(Val(z1))
        act(a:fac,'Total Empresa '~Val(z1) )
        acn(j:fac, Val(w1))
     endif

     * Asignar Empresa
     act(z1, fbn('Vehiculo1'))
     act(a:fac,'Empresa '~Val(z1) )
     AgregarMarco(a:fac..val(pc1):fac,1,0,RGB(192,192,192))
     SetFont(a:fac..val(pc1):fac,2)

     *- lc2: Linea de Corte de Control por Empresa
     acn(lc2,fac)

     ifa
     * Asignar Tipo Op.
     act(z7, fbn('TipoOp'))
     act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
     AgregarMarco(a:fac..val(pc1):fac,1)
     SetFont(a:fac..val(pc1):fac,2)

     ifa
  else
     if Not Eqstr(fbn('TipoOp'),Val(z7))
        * cambia Tipo Op.
        if NoVacio(Val(z7))
           act(a:fac,'Total Tipo Op.' )
           acn(j:fac, Val(w5))

           BorrarCeldas(w5..w5)
           AgregarMarco(a:fac..val(pc1):fac,1)
           SetFont(a:fac..val(pc1):fac,2)
           ifa
        endif

        * Asignar Tipo Op.
        act(z7, fbn('TipoOp'))
        act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
        AgregarMarco(a:fac..val(pc1):fac,1)
        SetFont(a:fac..val(pc1):fac,2)
        ifa
     endif
  endif

  Message('Operacion Nro. '~fbn('NrOperacion')~' ...' )

  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))
  act(c:fac, fbn('Cliente1'))

  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
     act(e:fac, fbn('TipoCambio2'))
  else
     if Incluido(fbn('TipoOp'),'DPRC')
        act(e:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
     else
        act(e:fac, fbn('PrecioEj'))
     endif
  endif

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     if fbn('FechaOp') > Dialogo.Fecha1 
        ACD(z2, fbn('FechaOp'))
     else
        ACD(z2, Dialogo.Fecha1)
     endif
  Else 
     if fbn('FechaOp2') > Dialogo.Fecha1 
        ACD(z2, fbn('FechaOp2'))
     else
        ACD(z2, Dialogo.Fecha1)
     endif
  EndIf

  if fbn('FechaEj') <= Dialogo.Fecha2
     ACD(z3, fbn('FechaEj'))
  else
     ACD(z3, Dialogo.Fecha2)
  endif

  * dif dias
  ACN(z4, (Val(z3)-Val(z2))+1)

  * dif meses
  ACN(z6, DifMeses(Val(z3),Val(z2))+1)

  * determinar el signo
  if EqStr(fbn('TipoOp'),'DPFW')
     if EqStr(fbn('MB3'),'1') 
        act(d:fac,'Venta')
        acn(z5,1)
     endif
     if EqStr(fbn('MB3'),'0') 
        act(d:fac,'Compra')
        acn(z5,-1)
     endif
  endif

  if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
     if EqStr(fbn('MB1'),'1')
        act(d:fac,'Producer')
        acn(z5,1)
     else
        act(d:fac,'Consumer')
        acn(z5,-1)
     endif
  endif

   if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
     if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(d:fac,'Compra PUT')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(d:fac,'Venta CALL')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(d:fac,'Venta PUT')
        acn(z5,-1)
     endif
     if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(d:fac,'Compra CALL')
        acn(z5,-1)
     endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
     if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
        act(d:fac,'Compra Producer')
        acn(z5,1)
     endif
     if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(d:fac,'Venta Consumer')
        acn(z5,1)
     endif
     if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
        act(d:fac,'Compra Consumer')
        acn(z5,-1)
     endif
     if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
        act(d:fac,'Venta Producer')
        acn(z5,-1)
     endif
  endif

  acn(f:fac, fbn('Cantidad'))
  act(g:fac, fbn('UMedida'))
 
  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acd(h:fac, fbn('FechaOp'))
     acd(i:fac, fbn('FechaEj'))
     acn(j:fac, val(f:fac)*Val(z5))
  else 
     acd(h:fac, fbn('FechaOp2'))
     acd(i:fac, fbn('FechaEj'))
     acn(j:fac, fbn('TotalAux2')*Val(z5))
  EndIf

  *- Analisis de Cada Operacion Para el Conjunto de Precios 
  (.'DCCOBER'.)

  scn(w1 ,Val(j:fac))
  scn(w5,Val(j:fac))
  SetFont(a:fac..val(pc1):fac,1)
proximo

Ifa
act(a:fac,'Total Tipo Op.' )
acn(j:fac, Val(w5))

BorrarCeldas(w5..w5)
AgregarMarco(a:fac..val(pc1):fac,1)
SetFont(a:fac..val(pc1):fac,2)

ifa

act(a:fac,'Total Empresa '~Val(z1) )
acn(j:fac, Val(w1))

BorrarCeldas(w1..w1)
AgregarMarco(a:fac..val(pc1):fac,1)
SetFont(a:fac..val(pc1):fac,2)

*- Prima Calculada
acn(ld:fac+1,Sum(ld:val(lc1)+2..ld:fac)/Sum(lc:val(lc1)+2..lc:fac))

Act(z1,'')

*- Distribuyo el precio de las primas en las operaciones
Recorrer&j 11,val(pc1)

   *- Columnas
   If Val(&j:val(lc1))<>0   

      Recorrer&i val(lc1)+3,fac
         *- Filas

         If NoVacio(val(a:&i)) y Not Eqstr(val(a:&i),'Total Tipo Op.') y Not Eqstr(val(a:&i),Val(z7)) 
            *- lc3: Linea de Corte de Control por TipoOp
            acn(lc3,&i)
            act(z7,val(a:&i))
         EndIf 

         If Eqstr(val(a:&i),'Total Tipo Op.')
            acn(&j  :&i,val(&j:val(lc3)))
            acn(&j+1:&i,val(&j+1:val(lc3))/val(&j:val(lc3)) )
            BorrarCeldas(&j:val(lc3)..&j+1:val(lc3))
            SetFont(a:&i..val(pc1):&i,2)
         EndIf

         If Vacio(val(a:&i))
            If Val(&j+1:&i)<>0
               If Incluido(Dialogo.Vehiculo1, VAR('VEHIPRODU'))
                  scn(&j+1:&i,-val(ld:fac+1))  
                  Message('Restando Prima '~Fstr(val(&j+1:&i),0,2))
               Else
                  scn(&j+1:&i,val(ld:fac+1))  
                  Message('Sumando Prima '~Fstr(val(&j+1:&i),0,2))
              EndIf
   
              *- lc3: Calculo de Sumatoria de Vol. y Vol*Precio por TipoOp
              scn(&j  :val(lc3),val(&j:&i))
              scn(&j+1:val(lc3),val(&j:&i)*val(&j+1:&i))

              *- lc2: Calculo de Sumatoria de Vol. y Vol*Precio por Empresa
              scn(&j  :val(lc2),val(&j:&i))
              scn(&j+1:val(lc2),val(&j:&i)*val(&j+1:&i))
           EndIf
        EndIf
      Proximo
   EndIf
Proximo 



Recorrer&j 11,val(pc1)
   Message('*- Calculo de Volumenes Promedios y Precios Promedios ')   
   If Val(&j:val(lc1))<>0    
      acn(&j  :fac,val(&j:val(lc2)) )
      acn(&j+1:fac,val(&j+1:val(lc2))/val(&j:val(lc2)) )

      *- Celdas para Linkear la1 lb1 
      acn(la:&j-10,val(&j:fac))
      acn(lb:&j-10,val(&j+1:fac))

      BorrarCeldas(&j:val(lc2)..&j+1:val(lc2))
   EndIf
Proximo

BorrarCeldas(w1..w1)
AgregarMarco(a:fac..val(pc1):fac,1,0,RGB(192,192,192))
SetFont(a:fac..val(pc1):fac,2)
ifa

ACO(1,19)
ACO(3,10)
ACO(4,9)
ACO(5,5)
ACO(6,6)
ACO(7,4)
ACO(8,6)
ACO(9,6)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z:val(v1), 2)

FormatoCeldas(e:val(v1)+1..e:fac, Exe('F7'))
FormatoCeldas(f:val(v1)+1..f:fac, Exe('F2N'))
FormatoCeldas(j:val(v1)+1..val(pc1):fac, Exe('F2N'))
AlinearCeldas(e:val(v1)..f:fac+1,'D')
AlinearCeldas(j:val(v1)..m:fac+1,'D')
LimitesVision(val(pc1):fac+1)
FijarCol(6)
Impresion(1,2)