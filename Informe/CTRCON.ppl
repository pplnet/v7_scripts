
CrearDialogo
  Fecha1   : 'Fecha Desde'               ;1;1;;;;Dialogo.Fecha1>0;'Fecha desde Invalida';NO;FSYS
  Fecha2   : 'Fecha Hasta'               ;1;2;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta Invalida';NO;FSys
  Lista1   : 'Vehiculo'                  ;3;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ") );
  Radio1   : 'Tipo: |Ingreso|Egreso|Ambos' ;4;1;;;;Dialogo.Radio1>=0;'Debe ingresar un Tipo';NO
  Especie1 : 'Moneda'                    ;3;2;;;;;;;;;

  FinDialogo
  If Not Ok
    Cancelar
  Endif
  
CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,12,B')

If Not Dialogo.Radio1 = 2
    **--HEADER--**
    SetFilaActual(1)
    ACT(A:fac, 'Control Contable ')
    IF Dialogo.Radio1 = 0
        ACT(A:fac+1, 'de Ingresos')
        ACT(A:fac+6, 'Tipo: Ingreso')
    Else
        IF Dialogo.Radio1 = 1
            ACT(A:fac+1, 'de Egresos')
            ACT(A:fac+6, 'Tipo: Egreso')
        Endif
    Endif
    ifa
    ifa
    ACT(A:fac, 'Desde Fecha: '~Dialogo.Fecha1)
    ifa
    ACT(A:fac, 'Hasta Fecha: '~Dialogo.Fecha2)
    ifa
    If NoVacio(Dialogo.Lista1)
        ACT(A:fac, 'Vehiculo/s:  '~Dialogo.Lista1)
    Else
        ACT(A:fac, 'Vehiculos:Todos')
    Endif
    ifa
    If NoVacio(Dialogo.Lista1)
        ACT(A:fac, 'Moneda: '~Dialogo.Especie1)
    Else
        ACT(A:fac, 'Moneda:Todas')
    Endif
    ifa
    SetFont(A:1..A:2,3)
    SetFont(A:3..A:fac,2)

    *--Columnas--**
     ifa
    *--Para INGRESO--**
   If Dialogo.Radio1 = 0
        ACT(A:fac,'ID BANCO')
        ACT(B:fac,'Nº CUENTA')
        ACT(C:fac,'ID REFERENCIA')
        ACT(D:fac,'FECHA TRANSACCION')
        ACT(E:fac,'IMPORTE')
        ACT(F:fac,'CODIGO TRANSACCION')
        ACT(G:fac,'DESCRIPCION')
        ACT(H:fac,'PLANTILLA CONTABLE')
        ACT(I:fac,'USUARIO')
        ACT(J:fac,'FIDEICOMISO')

        SetFont(A:fac..J:fac,2)
        AgregarMarco(A:fac..J:fac,2,0,Exe('COLOR'))


        **--Query--**
        
        
        SQL.ADD("SELECT O.TipoOp, O.NrOperacion, O.Operador,O.Book1,  ")
        SQL.ADD("T.NrTrans, T.Fecha2,T.Cantidad1,T.Especie,T.Vehiculo1,T.NrOperacionRef1,T.Cliente1, ")
        SQL.ADD(" C.Alias5, C.Numero,C.Cliente,C.TipoCuenta,C.Especies,C.Alias6 CuentaPS  ")
        SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C ")
        SQL.ADD("where T.NrOperacionRef1 = O.NrOperacion ")
        SQL.ADD("and T.Cuenta2 = C.Codigo  ")
        SQL.ADD("and T.TipoTr2 ='DEP'")
        SQL.ADD("and T.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' and T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD("and C.TipoCuenta NOT IN ('CUS','INV')")
        SQL.ADD("and O.TipoOp IN ("~Pipe2Comillas(Var('TIPOOPCOMP'))~")")
        If NoVacio(Dialogo.Especie1)
            SQL.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
        Endif
        If NoVacio(Dialogo.Lista1)
            SQL.ADD("and T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
        Endif
        
        
        Recorrer SQL

            
            let &leyenda BuscarCampo('MOVEJECUTADOS','Leyenda', 'NrOperacion', fbn('NrOperacion'))
            let &book BuscarCampo('BOOKS','Alias1', 'Codigo', fbn('Book1'))
            let &usrAlias1 BuscarCampo('USUARIOS','Alias1','Codigo',fbn('Operador'))
            let &moneda BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie'))
            
            ACT(A:fac,fbn('Alias5'))
            ACT(B:fac,fbn('Numero'))
            ACT(C:fac,fbn('NrOperacion')~'_'~fbn('NrTrans'))
            ACD(D:fac,fbn('Fecha2'))
            ACN(E:fac,fbn('Cantidad1'))
            ACT(F:fac,'G')
            ACT(G:fac,'FPA '~&leyenda)
            If Incluido(fbn('TipoOp'), 'FCR|SEVS')
                ACT(H:fac,'FC_'~&moneda~'_'~&book)
            Else
                If Eqstr(fbn('TipoOp'),'TRANSF')
                    ACT(H:fac,'TR_'~&moneda~'_'~&book)
                Else
                    If EqStr(fbn('TipoOp'),'MMRPAC') 
                       ACT(H:fac,'REM_'~fbn('CuentaPS'))
                    Else
                        If Eqstr(fbn('TipoOp'), 'MMCPM')
                           ACT(H:fac,'PF_'~&moneda~'_'~&book)
                        Else
                           ACT(H:fac,'NoDefinido')
                        Endif
                    Endif
                Endif
            Endif
            If Not Vacio(&usrAlias1)
                ACT(I:fac,&usrAlias1)
            else
                ACT(I:fac,fbn('Operador'))
            EndIf
            ACT(J:fac,fbn('Vehiculo1'))
         Proximo
         ACO(1,10)
         ACO(2,10)
         ACO(3,15)
         ACO(4,15)
         ACO(5,10)
         ACO(6,18)
         ACO(7,25)
         ACO(8,15)
         ACO(9,10)
         ACO(10,10)
         SetFilaActual(FAC+2)
         ACT(a:FAC, 'FIN DE INFORME')
        SetFont(a:FAC, 2)
        LimitesVision(k:FAC)

        

   Else
    ***--Para EGRESO--**
        If Dialogo.Radio1 = 1
                ACT(A:fac,'Unidad de Negocio')
                ACT(B:fac,'Tipo de Comprobante')
                ACT(C:fac,'Origen Comprobante')
                ACT(D:fac,'Plantilla')
                ACT(E:fac,'Categoria Comprobante')
                ACT(F:fac,'Nro. Factura')
                ACT(G:fac,'Fecha')
                ACT(H:fac,'ID Proveedor')
                ACT(I:fac,'CUIT Proveedor')
                ACT(J:fac,'CAE')
                ACT(K:fac,'CAI')
                ACT(L:fac,'Vencimiento CAE')
                ACT(M:fac,'FLAG CAEA')
                ACT(N:fac,'Numero de Linea')
                ACT(O:fac,'Articulo')
                ACT(P:fac,'Descripcion')
                ACT(Q:fac,'Fideicomiso')
                ACT(R:fac,'Departamento')
                ACT(S:fac,'Moneda')
                ACT(T:fac,'Monto Linea')
                ACT(U:fac,'Cotizacion')
                ACT(V:fac,'Clase de Cambio')
                ACT(W:fac,'Tipo de IVA')
                ACT(X:fac,'IVA')
                ACT(Y:fac,'Regimen Percepcion')
                ACT(Z:fac,'Monto Percepcion')
                ACT(AA:fac,'Condiciones de Pago')
                ACT(AB:fac,'Fecha de Pago')
                ACT(AC:fac,'Banco')
                ACT(AD:fac,'Cuenta Banco')
                ACT(AE:fac,'Metodo de Pago')
                ACT(AF:fac,'CBU Proveedor')
            


                SetFont(A:fac..AF:fac,2)
                AgregarMarco(A:fac..AF:fac,2,0,Exe('COLOR'))
            

            **--Query--**

        SQL.ADD("SELECT O.TipoOp, O.NrOperacion, O.Operador,O.Book1,  ")
        SQL.ADD("T.NrTrans, T.Fecha2,T.Cantidad1, T.Especie,T.Vehiculo1,T.NrOperacionRef1,T.Cliente1,T.Cuenta2, ")
        SQL.ADD(" C.Alias5, C.Numero,C.Cliente,C.TipoCuenta ,C.Especies ")
        SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C ")
        SQL.ADD("where T.NrOperacionRef1 = O.NrOperacion ")
        SQL.ADD("and T.Cuenta2 = C.Codigo  ")
        SQL.ADD("and T.TipoTr2 ='RET'")
        SQL.ADD("and T.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' and T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD("and C.TipoCuenta NOT IN ('CUS','INV')")
        SQL.ADD("and O.TipoOp IN ( "~Pipe2Comillas(Var('TIPOOPCOMP'))~" )")
            If NoVacio(Dialogo.Especie1)
            SQL.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
        Endif
        If NoVacio(Dialogo.Lista1)
            SQL.ADD("and T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
        Endif
        
            
            Recorrer SQL

                let &moneda BuscarCampo('ESPECIES','Alias10','Codigo',fbn('Especie'))
                
                ACT(A:fac,fbn('Vehiculo1'))
                ACT(B:fac,'REG')
                ACT(C:fac,'FPA')
                ACT(D:fac,'INVERSION')
                ACT(E:fac,'CI')
                ACT(F:fac,fbn('NrOperacionRef1')~'_'~fbn('NrTrans'))
                ACD(G:fac,fbn('Fecha2'))
                ACT(H:fac,'')
                ACT(I:fac,BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Cliente1')))
                ACT(J:fac,'')
                ACT(K:fac,'')
                ACT(L:fac,'')
                ACT(M:fac,'N')
                ACN(N:fac,1)
                FormatoCeldas(N:fac..N:fac, Exe('F0'))
                ACT(O:fac,'INVERSION')
                ACT(P:fac,'INVERSION')
                ACT(Q:fac,'')
                If Eqstr(fbn('TipoOp'), 'TRANSF') O Eqstr(fbn('TipoOp'),'MMCPM')
                    ACT(R:fac,'')
                Else
                    If Incluido(fbn('TipoOp'), 'FCS|SECS')
                        ACT(R:fac,fbn('Especie'))
                    Else
                       ACT(R:fac,'') 
                    Endif
                 Endif 
                 ACT(S:fac,&moneda)
                 ACN(T:fac,fbn('Cantidad1'))
                 ACT(U:fac,IIF(Eqstr(fbn('Especie'),Var('MONELOCA')),1,IIF(Incluido(fbn('Vehiculo1'),Var('VEHDOLBI')),COTIZACIONBNA(Var('DOLBILLETE'),fbn('Fecha2'),1,NO,NO),COTIZACIONBNA(fbn('Especie'),fbn('Fecha2'),1,NO,NO))))
                If Eqstr(fbn('Especie'),Var('MONELOCA'))
                    ACT(U:fac,Fstr(Val(U:fac),0,0))
                Else
                    ACT(U:fac,Fstr(Val(U:fac),0,8))
                Endif
                ACT(V:fac,'CRNNT')
                ACT(W:fac,'')
                ACT(X:fac,'0')
                ACT(Y:fac,'')
                ACT(Z:fac,'0')
                ACT(AA:fac,'CTO')
                ACD(AB:fac,fbn('Fecha2'))
                ACT(AC:fac,BuscarCampo('CLIENTES','Alias3','Codigo',BuscarCampo('CUENTAS','Comitente','Codigo',fbn('Cuenta2'))))
                ACT(AD:fac,BuscarCampo('CUENTAS','Alias6','Codigo',fbn('Cuenta2')))
                ACT(AE:fac,'WIR')
                ACT(AF:fac,'')

            Proximo
            
            ACO(1,12)
            ACO(2,12)
            ACO(3,12)
            ACO(4,12)
            ACO(5,15)
            ACO(6,18)
            ACO(7,8)
            ACO(8,8)
            ACO(9,15)
            ACO(10,3)
            ACO(11,3)
            ACO(12,10)
            ACO(13,7)
            ACO(14,10)
            ACO(15,12)
            ACO(16,12)
            ACO(17,12)
            ACO(18,10)
            ACO(19,8)
            ACO(20,15)
            ACO(21,10)
            ACO(22,10)
            ACO(23,8)
            ACO(24,3)
            ACO(25,13)
            ACO(26,10)
            ACO(27,13)
            ACO(28,10)
            ACO(29,8)
            ACO(30,12)
            ACO(31,10)
            ACO(32,10)
            SetFilaActual(FAC+2)
            ACT(a:FAC, 'FIN DE INFORME')
            SetFont(a:FAC, 2)
            LimitesVision(AG:FAC)
      Endif
  Endif
Else
     **--Para Ambos--**
     **--Genero los dos informes--**
     HojaVisible(NO)
     LinkearHoja('CCING',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1,Radio1=0,Especie1=Dialogo.Especie1)
     LinkearHoja('CCEGR',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1,Radio1=1,Especie1=Dialogo.Especie1)
Endif
        


