ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1     : 'Desde'          ;;;;;;;;;;
   Fecha2     : 'F.Medicion'     ;;;;;;;;;;
   Radio1     : 'Clientes|Todos|Vinculados|Terceros';;;;;;;;;0;
   Vehiculo1  : 'Vehiculo'       ;;;;;;;;;;;
   Entero1    : 'Nro.Med'        ;;;;;;;;;1;;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")
CrearFont(5,"Arial,10,B")

ACT(g:1,'Fecha : '~Var('FECHASYS'))
SetFont(c:1..c:1,5)

SetFilaActual(2)

ACT(a:FAC, "Mix de Deuda Fix-Floating ")
SetFont(a:fac..a:fac,5)

SetFilaActual(3)

ACT(a:FAC+1, 'Fecha Medicion : '~Dialogo.Fecha2)
ACT(a:FAC+2, 'Empresa : '~Dialogo.Vehiculo1)
ACT(a:FAC+3, 'Clientes : '~Iif(Dialogo.Radio1=0,'Todos',Iif(Dialogo.Radio1=2,'Terceros','Vinculados')))

SetFont(a:fac..n:FAC+5,4)
SetFilaActual(9)

* ac1: Contador de Columnas
ACT(a:fac,'PERIODOS')
ACT(b:fac,Dialogo.Vehiculo1)
ACT(c:fac,'Fix')
ACT(d:fac,'Float')
ACT(e:fac,'NrOperacion')

SetFont(a:fac..e:FAC,5)  
AgregarMarco(a:fac..b:fac,1,3)

SetFilaActual(fac+2)

acd(a:fac,Dialogo.Fecha2)
SetFont(a:fac..a:FAC,2)  
AgregarMarco(a:fac..a:fac,2,0,Exe('COLOR6'))
AlinearCeldas(a8..a:fac, 'C')
Ifa  
   
(.'MARCOMIX'.)

* 1er.Fila => Total Pasivos
SetFilaActual(val(a200))

*- Money Market 
SQL.ADD("Select O.NrOperacion,T.NrCuota,O.TipoOp,O.TipoTasa,O.FechaVto,O.Cantidad,O.TotalBrutoCli3,O.Especie,")
SQL.ADD("T.* From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS T ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES C")
Endif
*SQL.ADD("where O.NrOperacion *= T.NrOperacion  ")
SQL.ADD("where O.NrOperacion = T.NrOperacion  ")
SQL.ADD(" and O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and T.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and T.Fecha2 > '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.TipoOp In ('MMFRN','MMON','MMPCCV','MMPCL','MMPCOS','MMPE','MMPI','MMPLME','MMPSC','MMFCMV','MMONM','MMPCCM','MMPCLM','MMPOSM','MMPEM','MMPIM','MMSCMV') ")
SQL.ADD(" and O.Vehiculo1 ='"~Dialogo.Vehiculo1~"' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD(" Order By 1, 2")

Recorrer SQL

     ACN(x2,1)

     If Not Eqstr(fbn('Especie'), VAR('MONEEXTR'))
        ACN(x2,CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
     EndIf

     *-- Vale para las Medidiciones cuyo periodo es el mismo que la fecha del informe
     *-- Tasa Fija : TASAS FIJAS o TASAS FLOAT si la 1er. Medicion es Anterior al 1er. Vto: Ej: 1er.Med 31/8 y Vto: 1/9 

     *-- Tasa Float: TASAS FIJAS Vencidas a la Fecha de Medicion: Ej: 1er.Med 31/8 y Vto Total 15/8
     *               TASAS FLOAT si la 1er. Medicion Posterior al 1er. Vto: Ej: 1er.Med 31/8 y Vto: 30/9 
     *               TASAS FIJAS para La Sumatoria del Capital Amortizado hasta la 1er. Medicion.
     *- z1: Capital Vigente  z2: Monto Amortizado Hasta la Fecha z3: Vto. Amort.    
     
     ACN(z1,FBN['Cantidad'])

     If Incluido(FBN['TipoOp'],'MMFCMV|MMFRN')
        *- Valores actuales por la precancelacion
        ACN(z1,FBN['TotalBrutoCli3'])
     EndIf

     ACN(z2,0)
     ACD(z3,FBN['FechaVto'])

     IF Incluido(FBN['TipoOp'],'MMFCMV|MMONM|MMPCCM|MMPCLM|MMPOSM|MMPEM|MMPIM|MMSCMV')
        *- Vn Vigente a la fecha del Informe 
        SQL.ADD("Select NrCuota,Cantidad2 FROM "~DBO~".CUOTAS T ")
        SQL.ADD("where NrOperacion='"~FBN['NrOperacion']~"' ")
        SQL.ADD(" and T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD(" and T.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
        Recorrer SQL
           DFA
           ACN(z1,FBN['Cantidad2'])
           ACN(z5,FBN['NrCuota'])
        Proximo
        
        ACN(z2,val(z1)-FBN['Cantidad2'])
        ACD(z3,FBN['Fecha2']) 
     EndIf

     Message('Recuperando '~Dialogo.Vehiculo1~' '~FBN['TipoOp']~' '~FBN['NrOperacion'])
 
     IF [EqStr(FBN['TipoTasa'],'FIJA') o Vacio(FBN['TipoTasa'])]
        If FBN['FechaVto']<Dialogo.Fecha2
           ACN(d:fac,val(z1)*val(x2))
           ACT(e:fac,FBN['NrOperacion'])

           *--- Vencidas a la Fecha de Medicion => Suma Tasa Flotante
           SCN(b:val(a:200)+3,val(z1)*val(x2))
           SCN(b:val(a:200)  ,val(z1)*val(x2))
        Else 
           *-----------
           IF Incluido(FBN['TipoOp'],'MMFCMV|MMONM|MMPCCM|MMPCLM|MMPOSM|MMPEM|MMPIM|MMSCMV')
              *- Para MV. 
              ACN(c:fac,FBN['Cantidad2']*val(x2))
              ACT(e:fac,FBN['NrOperacion'])

              *--- La Amortizacion Pasada del Capital => Suma Tasa Fija
              SCN(b:val(a:200)+2,FBN['Cantidad2']*val(x2))           
              SCN(b:val(a:200)  ,FBN['Cantidad2']*val(x2))      

              ACN(d:fac,val(z2)*val(x2))
 
              *--- El Resto del Capital => Suma Tasa Flotante
              SCN(b:val(a:200)+3,val(z2)*val(x2))           
              SCN(b:val(a:200)  ,val(z2)*val(x2))           

              *-----------
              If No
                 ACN(c:fac,val(z2)*val(x2))
                 ACT(e:fac,FBN['NrOperacion'])

                 *--- La Amortizacion Pasada del Capital => Suma Tasa Fija
                 SCN(b:val(a:200)+2,val(z2)*val(x2))           
                 SCN(b:val(a:200)  ,val(z2)*val(x2))      

                 ACN(d:fac,FBN['Cantidad2']*val(x2))

                 *--- El Resto del Capital => Suma Tasa Flotante
                 SCN(b:val(a:200)+3,FBN['Cantidad2']*val(x2))           
                 SCN(b:val(a:200)  ,FBN['Cantidad2']*val(x2))           
              EndIf
           Else
              *- Para Unico Vencimiento
              ACN(c:fac,val(z1)*val(x2))
              ACT(e:fac,FBN['NrOperacion'])

              *--- La Amortizacion Pasada del Capital => Suma Tasa Fija
              SCN(b:val(a:200)+2,val(z1)*val(x2))           
              SCN(b:val(a:200)  ,val(z1)*val(x2))      

              ACN(d:fac,val(z2)*val(x2))
 
              *--- El Resto del Capital => Suma Tasa Flotante
              SCN(b:val(a:200)+3,val(z2)*val(x2))           
              SCN(b:val(a:200)  ,val(z2)*val(x2))           
           EndIf
        EndIf        
     EndIf

     IF Not [EqStr(FBN['TipoTasa'],'FIJA') o Vacio(FBN['TipoTasa'])]
        If [FBN['NrCuota']=val(z5) o FBN['NrCuota']=0] y Dialogo.Fecha2<val(z3)
           *- Si la cuota que levanto es la correspondiente a la medicion o 
           *- son operaciones unicos vencimientos
           ACN(c:fac,val(z1)*val(x2))
           ACT(e:fac,FBN['NrOperacion'])

           SCN(b:val(a:200)+2,val(z1)*val(x2))           
           SCN(b:val(a:200)  ,val(z1)*val(x2))           
        Else 
           *- Va todo a Flotante
           ACN(d:fac,val(z1)*val(x2))
           ACT(e:fac,FBN['NrOperacion'])

           SCN(b:val(a:200)+3,val(z1)*val(x2))           
           SCN(b:val(a:200)  ,val(z1)*val(x2))           
        EndIf
     EndIf
     aclo(e:fac,FBN['NrOperacion'])
     SetFont(b:val(a:200)..b:val(a:200)+3,3)
     SetFont(c:fac..e:fac,3)
Proximo


SQL.ADD("Select O.Vehiculo1,O.NrOperacion,O.TipoOp,O.Cantidad,O.TotalBrutoCli1,")
SQL.ADD("O.Especie,O.ContraEspecie,O.RB9,0 NrCuota, 0 Cant1, 0 Cant2 ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES C")
Endif
SQL.ADD("where ")
SQL.ADD(" ((TipoOp IN ('DTSFV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha2)~"')   ")
SQL.ADD(" or (TipoOp IN ('DTO','DTOV') and MB3='0' and MB1='0' and O.FechaEx1<='"~IdxDate(Dialogo.Fecha2)~"' and O.FechaEx2>'"~IdxDate(Dialogo.Fecha2)~"')) ")
SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD("  Union All ")
SQL.ADD("Select O.Vehiculo1,O.NrOperacion,O.TipoOp,O.Cantidad,O.TotalBrutoCli1,") 
SQL.ADD("O.Especie,O.ContraEspecie,O.RB9,C.NrCuota,C.Cantidad1 Cant1,C.Cantidad2 Cant2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES L")
Endif
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and ( (TipoOp IN ('DTK','DTKVI','DTSFVM','DTSFVX') and C.Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("  or (TipoOp IN ('DTOM','DTOMV') and MB3='0' and MB1='0' and C.Fecha5<='"~IdxDate(Dialogo.Fecha2)~"' and C.Fecha6>'"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("  or (TipoOp IN ('DTSNFV') and MB3='0' and C.Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha2)~"')) ")
SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
If Dialogo.Radio1 = 1
   SQL.ADD(" and L.Codigo=O.Cliente1 and SubString(L.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and L.Codigo=O.Cliente1 and SubString(L.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD(" order by 1,3,2 ")

Recorrer SQL

   * If Not [Dialogo.Entero1=1 y FBN['NrCuota']=1]

      Message('Recuperando '~Dialogo.Vehiculo1~' '~FBN['TipoOp']~' '~FBN['NrOperacion'])

      *- Evaluo la Moneda segun el evento
      ACT(x1,FBN['ContraEspecie'])
      If Incluido(FBN['TipoOp'],'DTOMV|DTOM|DTO|DTOV')
         ACT(x1,FBN['Especie'])
      EndIf

      ACN(x2,1)
      If Not Eqstr(VAL(x1), VAR('MONEEXTR'))
         ACN(x2,CotizacionC(VAL(x1),,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
      EndIf

      *- DTK  ,DTKVI,DTSFVM,DTSFVX,DTSNFV Notional de la Contraparte => C.Cantidad2
      *- DTOM ,DTOMV => C.Cantidad1    DTO,DTOV => O.Cantidad
      *- DTSFV,DTSFVV => O.TotalBrutoCli1 
      ACN(z4,0)
       
      IF Incluido(FBN['TipoOp'],'DTK|DTKVI|DTSFVM|DTSFVX|DTSNFV')
         ACN(z4,FBN['Cant2'])
      EndIf
      IF Incluido(FBN['TipoOp'],'DTOM|DTOMV')
         ACN(z4,FBN['Cant1'])
      EndIf
      IF Incluido(FBN['TipoOp'],'DTO|DTOV')
         ACN(z4,FBN['Cantidad'])
      EndIf
      IF Incluido(FBN['TipoOp'],'DTSFV|DTSFVV')
         ACN(z4,FBN['TotalBrutoCli1'])
      EndIf
      IF EqStr(FBN['RB9'],'1')
         * Vehiculo Variable => Decrementa al Pasivos floating       
         ACN(z4,-val(z4))
      EndIf
 
      *--- La Porcion amortizada => Suma Tasa Flotante
      SCN(b:val(c:200),val(z4)*val(x2))           
   
      ACN(c:fac,val(z4)*val(x2))

      ACT(e:fac,FBN['NrOperacion'])
      aclo(e:fac,FBN['NrOperacion']) 
      SetFont(b:val(c:200)..b:val(c:200)+3,3)
      SetFont(c:fac..e:fac,3)
   * EndIf

Proximo


If val(b:val(a:200)+3)<>0
   *-- Pasivos Floating sin Hedge => Pasivos a Tasa Flotante -Pasivos Floating Hedgeados
   ACN(b:val(c:200)+1, val(b:val(a:200)+3) - val(b:val(c:200)) )           

   *-- % Pasivos Floating Sin Hedge => Pasivos Floating sin Hedge/Pasivos a Tasa Flotante 
   ACN(b:val(c:200)+2, val(b:val(c:200)+1)/val(b:val(a:200)+3) )           

   *-- % Pasivos Pasivos a Tasa Fija (Fix+Hedge) => (Pasivos Floating Hedgeados + Pasivos a Tasa Fija)/Total Pasivos 
   ACN(b:val(c:200)+4, (val(b:val(c:200))+val(b:val(a:200)+2))/val(b:val(a:200)) )           
Else
   ACN(b:val(c:200)+1,0)
   ACT(b:val(c:200)+2,'-')
   ACT(b:val(c:200)+4,'-')
EndIf


SetFont(b:val(c:200)+1..b:val(c:200)+4,3)

AlinearCeldas(a8..a:fac, 'I')
FormatoCeldas(b:8..val(ac1):fac,Exe('F2'))

ACO(1,20)
ACO(2,10)
FijarCol(2)
FijarFila(9)
Impresion(1,2)
LimitesVision(e:fac)
*LimitesVision(b:val(c:200)+5)