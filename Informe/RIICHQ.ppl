SQL.ADD("SELECT O.*, C.RazonSocial, C.Direccion as Address, C.CodigoPostal, C.Localidad, C.Codigo, C.CondicionIVA, C.CUIT, C.CodComitente ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ")
SQL.ADD("WHERE  O.FechaOp  = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("       and O.Cliente1 = C.Codigo")

* Se añade sentencia para que solo tome operaciones de MAV: - CAL 28/10/2022
SQL.ADD(" and O.TipoOp IN ('DDC', 'DDV')")


  SetFilaActual(6)

Recorrer SQL
  ACT(a:fac, fbn('RazonSocial'))
  ACT(b:fac, fbn('CUIT'))
  ACT(c:fac, 'CHEQUES') 
  ACT(d:fac, FStr(difdias(fbn('FechaOp'),fbn('FechaOp2'),'ARG',Si),0,0))
