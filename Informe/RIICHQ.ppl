  ACT(e:fac, '$')
  else
  ACT(e:fac, 'US$')
  endif
  if Incluido(fbn('TipoOp'),'DDC')
  ACN(f:fac, fbn('TotalBrutoCli1'))
  ACN(g:fac, fbn('Cantidad')/fbn('TotalBrutoCli1')*100)
  ACN(h:fac, fbn('Cantidad'))
  else
  ACN(i:fac, fbn('TotalBrutoCli1'))
  ACN(j:fac, fbn('Cantidad')/fbn('TotalBrutoCli1')*100)
  ACN(k:fac, fbn('Cantidad'))
  endif
