IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1: 'Fecha'                ;;;;;;;;;FSys
  Lista1: 'Vehiculo'             ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Radio1: 'Consolidado Book|SI|NO'    ;;;;;;;;;0;;
  Radio2: 'Expresado en|ARP|USD' ;;;;;;;;;0
  Radio3: 'Expresado en|Millones|ImporteOri';;;;SI;SI;;;;0;;;;;
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha1-1,1,NO,NO)
let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha1-1,1,NO,NO)
IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
SetFilaActual(1)

let &filaLogo 1
@LOGO
ifa
ifa
ifa
ACT(F:1, 'Informe de POSICIONES')
SetFont(F:1, 3)
SetFilaActual(fac+2)
Let &fi1 fac
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculos: '~Dialogo.Lista1)
    ACT(LS:1, Dialogo.Lista1)
ELSE
    ACT(A:fac, 'Vehiculos: '~Val(LS:1))
ENDIF
ifa
IF Dialogo.Radio1 = 0
    ACT(A:fac, 'Consolidado: SI')
ELSE
    ACT(A:fac, 'Consolidado: NO')
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: ARP')
    ACT(MN:1, '$')
ELSE
    ACT(A:fac, 'Expresado en: USD')
    ACT(MN:1, 'U$S')
ENDIF
SetFont(A:&fi1..A:fac, 2)
ifa
ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
ifa
IF Dialogo.Radio3 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
SetFont(A:&fi1..B:fac, 2)
SetFilaActual(fac+2)
*ACT(C:fac, '                TOTAL '~Val(MN:1))
ACT(B:fac, 'TOTAL '~Val(MN:1))
AlinearCeldas(B:fac, 'D')
SetFont(B:fac, 2)
AgregarMarco(A:fac..N:fac, 0, 0, Exe('COLOR8'))
let &filaTotales fac
ifa
ACT(C:fac, '               Vehiculos Activos')
ACT(G:fac, '  A LA VISTA')
ACT(J:fac, 'INVERTIDO')
let &fi1 fac
AgregarMarco(A:fac..N:fac, 0, 0, Exe('COLOR'))
ifa
ACT(A:fac, 'Vehiculo')
ACT(B:fac, 'CUIT')
ACT(E:fac, 'CC ARP')
ACT(F:fac, 'CC USD')
ACT(G:fac, 'Op. a Liq. ARP')
ACT(H:fac, 'Op. a Liq. USD')
ACT(I:fac, 'Remuneradas')
ACT(J:fac, 'FCI')
ACT(K:fac, 'PF')
ACT(L:fac, 'CAUCION')
ACT(M:fac, 'Total Invertido') 
ACT(N:fac, 'Total Cartera')  
AlinearCeldas(A:fac..N:fac,'C')
AgregarMarco(A:fac..N:fac, 0, 0, Exe('COLOR6'))
SetFont(A:fac-1..N:fac, 2)
Let &filaInicial fac+1
SQL.ADD(" Select V.Codigo Vehiculo, V.Descripcion, V.CUIT, B.Codigo Book ")
SQL.ADD(" From "~DBO~".VEHICULOS V, "~DBO~".BOOKS B ")
SQL.ADD(" Where V.Codigo = B.Vehiculo ")
SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD("  ")
SQL.ADD(" Order By 1, 4 ")
Recorrer SQL
    ***--Orderno todos los vehículos, books
    IF Dialogo.Radio1 = 0
        ***---Consolidado
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac, fbn('Vehiculo'))
            ACT(B:fac, fbn('CUIT'))
            ACT(C:fac, fbn('Descripcion'))
        ELSE
            DFA
        ENDIF
    ELSE
        ***---NO Consolidado
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac, fbn('Vehiculo'))
            ACT(B:fac, fbn('CUIT'))
            ACT(C:fac, fbn('Descripcion'))
            AgregarMarco(A:fac..N:fac, 0, 0)
            ifa
            ACT(D:fac, fbn('Book'))
        ELSE
            ACT(D:fac, fbn('Book'))
        ENDIF
    ENDIF
    ACT(VH:1, fbn('Vehiculo'))
Proximo
Let &filaFinal fac
***---Busco Informacion para completar el informe
***---Ctas a la vista
SQL.ADD(" Select S.SaldoContable/"~Fstr(&unidad, 0, 0)~" SaldoContable, C.Cliente Vehiculo, C.Alias1 BookCta, V.Alias5 BookDafult, C.Especies, S.NrCuenta ")
SQL.ADD("  ")
SQL.ADD(" From "~DBO~".SALDOSBANCARIOS S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where S.NrCuenta = C.Numero ")
SQL.ADD(" AND V.Codigo = C.Cliente ")
SQL.ADD(" AND S.FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Cliente IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD("  ")
SQL.ADD("  ")
SQL.ADD("  ")
Watch(sql.Batch)
Recorrer SQL
    DFA
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Incluido(&monedaInforme, fbn('Especies'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    let &saldoContable fbn('SaldoContable') * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            ***---Chequeo si la cta está remunerada
            let &bd1 0
            let &intRem 0
            SQL.ADD(" Select O.Book1, O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C ")
            SQL.ADD(" Where C.Codigo = O.Cuenta1 ")
            SQL.ADD(" AND O.TipoOp = 'MMRPAC' ")
            SQL.ADD(" AND C.Numero = '"~fbn('NrCuenta')~"' ")
            SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD("  ")
            Recorrer SQL
                DFA
                let &bookCta fbn('Book1')
                let &bd1 1
                SQL.ADD(" Select Sum(Monto)/"~Fstr(&unidad, 0, 0)~" Monto From "~DBO~".MOVDEVENGADOS ")
                SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND NrSaldo = 140 ")
                SQL.ADD(" AND TipoDevengado = 'INTLEN' ")
                SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
                Recorrer SQL
                    DFA
                    let &intRem &intRem + (fbn('Monto') * &tc)
                Proximo
            Proximo
            IF &bd1 = 0
                ***---Cta a la vista
                IF Incluido(&monedaLocal, fbn('Especies'))
                    SCN(E:&k, &saldoContable )
                    *Link a detalle vh
                    ACL(E:&k,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                    let &totalCCARP &totalCCARP + &saldoContable
                    ***---sumo al total cartera de la fila
                    SCN(N:&k, &saldoContable)
                    let &totalCatera &totalCartera + &saldoContable
                    let &col 5
                ELSE
                    SCN(F:&k, &saldoContable)
                    *Link a detalle vh
                    ACL(F:&k,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
                    let &totalCCUSD &totalCCUSD + &saldoContable
                    ***---sumo al total cartera de la fila
                    SCN(N:&k, &saldoContable)
                    let &totalCartera &totalCartera + &saldoContable
                    let &col 6
                ENDIF
                ***---Si la cuenta tiene definido el book, tomamos ese, sino el book default del vehículo
                IF NoVacio(fbn('BookCta'))
                    let &bookCta fbn('BookCta')
                ELSE
                    let &bookCta fbn('BookDafult')
                ENDIF
            ELSE
                ***---Remunerada
                SCN(I:&k, &saldoContable + &intRem)
                **Detalle Remuneradas 
                ACL(I:&k,'POSREM',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Lista1=FBN['Vehiculo'],Book1='')
                let &totalRem &totalRem + &saldoContable + &intRem
                ***---Sumo el Total Invertido y total cartera de la fila
                SCN(M:&k, &saldoContable + &intRem)
                SCN(N:&k, &saldoContable + &intRem)
                let &totalInvertido &totalInvertido + &saldoContable + &intRem
                let &totalCartera &totalCartera + &saldoContable + &intRem
                let &col 9
            ENDIF
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    *pinchaIF Not CeldaVacia(Val(D:&i))
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), &bookCta)
                            SCN(&col:&i, &saldoContable + &intRem)
                            If &col = 9
                                ACL(&col:&i,'POSREM',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Lista1=FBN['Vehiculo'],Book1=&bookCta)
                            Else
                                If &col=6
                                    ACL(&col:&i,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
                                Else
                                    ACL(&col:&i,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                                Endif
                            Endif
                            ***---Sumo el Total Invertido y total cartera de la fila
                            SCN(M:&i, &saldoContable + &intRem)
                            SCN(N:&i, &saldoContable + &intRem)
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ELSE
        ENDIF
    Proximo
Proximo
***---Operaciones a Liquidar
*SQL.ADD(" Select M.Cantidad/"~Fstr(&unidad, 0, 0)~" Cantidad, M.Especie Moneda, M.Book, M.Cliente Vehiculo ")
*SQL.ADD(" From "~DBO~".MOVPENDIENTES M ")
*SQL.ADD(" Where M.FechaMov > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" AND M.NrSaldo = 50 ")
*SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(M.Especie,'MONEDA') = 1 ")
*SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(LS:1))~") ")
*SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(LS:1))~") ")
*SQL.ADD("  ")
***---Tomamos Operaciones porque el reporte puede ejecutarse fecha valor, y los mov ya estar ejecutados
SQL.ADD(" Select O.TotalNetoCli1/"~Fstr(&unidad, 0, 0)~" Cantidad, O.ContraEspecie Moneda, O.Book1 Book, O.Vehiculo1 Vehiculo, O.TipoOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoOp IN ('FCS','FCR') ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
Recorrer SQL
    DFA
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Incluido(fbn('TipoOp'), 'FCR')
        let &movPte fbn('Cantidad') * &tc
    ELSE
        let &movPte (-fbn('Cantidad') * &tc)
    ENDIF
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            IF Eqstr(&monedaLocal, fbn('Moneda'))
                SCN(G:&k, &movPte)
                ACL(G:&k,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                let &totalPteARP &totalPteARP + &movPte
                ***---sumo al total cartera de la fila
                SCN(N:&k, &movPte)
                let &totalCartera &totalCartera + &movPte
                let &col 7
            ELSE
                SCN(H:&k, &movPte)
                ACL(H:&k,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)                
                let &totalPteUSD &totalPteUSD + &movPte
                ***---sumo al total cartera de la fila
                SCN(N:&k, &movPte)
                let &totalCartera &totalCartera + &movPte
                let &col 8
            ENDIF
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book'))
                            SCN(&col:&i, &movPte)
                            If &col = 7
                                let &monedaDPOPLI &monedaLocal
                            Else
                                let &monedaDPOPLI &monedaExtr
                            Endif
                            ACL(&col:&i,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaDPOPLI)                
                            ***---sumo al total cartera de la fila
                            SCN(N:&i, &movPte)
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ENDIF
    Proximo
Proximo
***---FCI
SQL.ADD(" Select P.Especie, P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin, P.Vehiculo, P.Book, E.Cotiza Moneda ")
SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = P.Especie ")
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P.Especie,'FONDOS') = 1 ")
SQL.ADD(" AND P.NrSaldo = 1 ")
SQL.ADD(" AND P.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  ")
SQL.ADD(" Order By 1 ")
Recorrer SQL
    DFA
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Not Eqstr(fbn('Especie'), &especieAnt)
    let &cotEspecie Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    let &posValuadaFCI fbn('CantidadFin') * &cotEspecie * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(J:&k, &posValuadaFCI)
            **Link a Detalle Totales FCI
                ACL(J:&k,'DPOFCI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            **
            let &totalFCI &totalFCI + &posValuadaFCI
            ***---Sumo al total invertido y total cartera de la fila
            SCN(M:&k, &posValuadaFCI)
            SCN(N:&k, &posValuadaFCI)
            let &totalInvertido &totalInvertido + &posValuadaFCI
            let &totalCartera &totalCartera + &posValuadaFCI
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book'))
                            SCN(J:&i, &posValuadaFCI)
                            **Link a Detalle Totales FCI
                                ACL(J:&i,'DPOFCI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                            **
                            ***---Sumo al total invertido y total cartera de la fila
                            SCN(M:&i, &posValuadaFCI)
                            SCN(N:&i, &posValuadaFCI)
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ENDIF
        let &especieAnt fbn('Especie')
    Proximo
Proximo
***---PF
SQL.ADD("Select (Sum(M.Monto)+O.Cantidad)/"~Fstr(&unidad, 0, 0)~" as 'Importe',M.NrOperacion,M.Vehiculo,O.Especie 'Moneda',O.Book1 ")
SQL.ADD("FROM MOVDEVENGADOS M, OPERACIONES O")
SQL.ADD("Where M.NrOperacion=O.NrOperacion and O.TipoOp='MMCPM' and O.FechaOp>'"~IdxDate(Dialogo.Fecha1)~"'") 
SQL.ADD("Group by M.NrOperacion,O.Cantidad,M.Vehiculo,O.Especie,O.Book1")
SQL.ADD("Order By O.Especie")
Recorrer SQL
    DFA
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Not Eqstr(fbn('Moneda'), &especieAnt)
        let &cotEspecie Cotizacion(fbn('Moneda'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    let &importePF fbn('Importe') * &cotEspecie * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(K:&k, &importePF)
            ACL(K:&k,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            let &totalPF &totalPF + &importePF
            IF Dialogo.Radio1 = 1
                *No Consolidado
                Recorrer&i &k+1, &filaFinal
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book1'))
                            SCN(K:&i, &importePF)
                            ACL(K:&i,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book1'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                        ENDIF
                    ELSE
                        Break
                    ENDIF
                Proximo
            ENDIF
        Endif
        let &especieAnt fbn('Moneda')
    Proximo
Proximo
*--CAUCIONES
SQL.ADD("Select (Sum(M.Monto)+O.Cantidad)/"~Fstr(&unidad, 0, 0)~" as 'Importe',M.NrOperacion,M.Vehiculo,O.Especie 'Moneda',O.Book1,O.TipoOp,O.CB1 ")
SQL.ADD("FROM MOVDEVENGADOS M, OPERACIONES O")
SQL.ADD("Where M.NrOperacion=O.NrOperacion and O.TipoOp IN('SECAC','SECAT') ")
SQL.ADD("and O.FechaOp>'"~IdxDate(Dialogo.Fecha1)~"'") 
SQL.ADD("Group by M.NrOperacion,O.Cantidad,M.Vehiculo,O.Especie,O.Book1,O.TipoOp,O.CB1 ")
SQL.ADD("Order By O.Especie")
Recorrer SQL
    DFA
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Not Eqstr(fbn('Moneda'), &especieAnt)
        let &cotEspecie Cotizacion(fbn('Moneda'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    let &signo 1
    IF EqStr(fbn('TipoOp'),'SECAT') y EqStr(fbn('CB1'),'1')
        let &signo (-1)
    ENDIF
    let &importeCaucion fbn('Importe') * &cotEspecie * &tc *&signo
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(L:&k, &importeCaucion)
            ACL(L:&k,'DPOCAU',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            let &totalCaucion &totalCaucion + &importeCaucion
            IF Dialogo.Radio1 = 1
                *No Consolidado
                Recorrer&i &k+1, &filaFinal
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book1'))
                            SCN(L:&i, &importeCaucion)
                            ACL(L:&i,'DPOCAU',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book1'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                        ENDIF
                    ELSE
                        Break
                    ENDIF
                Proximo
            ENDIF
        Endif
        let &especieAnt fbn('Moneda')
    Proximo
Proximo


ACN(E:&filaTotales, &totalCCARP)
**Link a Detalle Ctas. a la Vista ARP
ACL(E:&filaTotales,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
ACN(F:&filaTotales, &totalCCUSD)
**Link a Detalle Ctas. a la Vista USD
ACL(F:&filaTotales,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
ACN(G:&filaTotales, &totalPteARP)
**Link a Detalle Totales Pte. ARP
ACL(G:&filaTotales,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
ACN(H:&filaTotales, &totalPteUSD)
**Link a Detalle Totales Pte. ARP
ACL(H:&filaTotales,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
ACN(I:&filaTotales, &totalRem)
**Detalle Remuneradas 
ACL(I:&filaTotales,'POSREM',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Lista1='',Book1='')
ACN(J:&filaTotales, &totalFCI)
**Link a Detalle Totales FCI
ACL(J:&filaTotales,'DPOFCI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
**Totales PF
ACN(K:&filaTotales, &totalPF)
ACL(K:&filaTotales,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
**Totales Caucion
ACN(L:&filaTotales, &totalCaucion)
ACL(L:&filaTotales,'DPOCAU',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1='',Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
**
ACN(M:&filaTotales, &totalInvertido)
ACN(N:&filaTotales, &totalCartera)
let &totalGeneral &totalCCARP + &totalCCUSD + &totalPteARP + &totalPteUSD + &totalRem + &totalFCI + &totalPF + &totalCaucion
*ACT(C:&filaTotales, Val(C:&filaTotales)~' '~PYC(Fstr(&totalGeneral,0, 2), 0, 2))
ACN(C:&filaTotales, &totalGeneral)
AlinearCeldas(C:&filaTotales, 'I')
SetFont(A:&filaTotales..N:&filaTotales, 3)
*FormatoCeldas(C:&filaTotales, Exe('F2'))
AgregarMarco(A:&fi1..D:fac, 0, 0)
AgregarMarco(E:&fi1..H:fac, 0, 0)
AgregarMarco(I:&fi1..L:fac, 0, 0)
AgregarMarco(M:&fi1..N:fac, 0, 0)
SetFont(A:&filaInicial..N:fac, 1)
FormatoCeldas(E:&filaInicial..N:fac, Exe('F2'))
FormatoCeldas(C:&filaTotales..N:&filaTotales, Exe('F2'))
IF Dialogo.Radio1 = 1
    ***---No Consolidado
    Recorrer&k &filaInicial, &filaFinal
        IF Not CeldaVacia(A:&k)
            SetFont(E:&k..N:&k, 2)
        ENDIF
    Proximo
ENDIF
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(3, 20)
ACO(4,12)
ACO(7, 10)
ACO(8, 10)
ACO(9, 9)
ACO(10, 9)
ACO(11, 9)
ACO(12, 9)
ACO(13, 9)

LimitesVision(O:fac+1)