*GrillaVisible(NO)
*ModoReproceso(ConDialogo)
CrearDialogo:2
  Vehiculo1  : 'Vehiculo'           ;;;;;;;;NO;VAR('VEHICULODE')
  Fecha1     : 'Fecha'              ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(2)
ACN(w1,FAC)

*-
ACT(a:FAC, 'Informe de Vencimientos Titulos')
