*-
ACT(a:FAC, 'Tipo Op. - Especie ' )
ACT(d:FAC, 'Fecha Origen' )
ACT(e:FAC, 'Fecha Vto.' )

ACT(f:FAC, 'Cantidad' )
ACT(g:FAC, 'Neto a Liq' )
ACT(h:FAC, 'Nr.Operacion' )
ACT(i:FAC, 'Custodia' )

ACT(j:FAC, 'Precio Orig.' )
ACT(k:FAC, 'Precio Vto.' )
ACT(l:FAC, 'Intereses en Titulos' )
ACT(M:FAC, 'Moneda' )

AlinearCeldas(a:FAC..M:FAC,'C')

SetFont(a:FAC..M:FAC,2)
AgregarMarco(a:FAC..M:FAC,1,0,Exe('COLOR6'))

SQL.ADD("SELECT C.Sucursal, O.TipoOp,O.Especie,E.Extendido, O.Cliente1,C.RazonSocial,          ")
SQL.ADD("       O.Cantidad, O.Precio3, O.Precio1, O.Precio2, O.TotalBrutoCli1,O.TotalNetoCli1, ")
SQL.ADD("       O.TotalBrutoCli2, O.Book1,O.FechaPago, O.Especie, O.Mercado, O.Plazo,          ")
SQL.ADD("       O.MB1, O.Cartera, O.TotalDerechos, O.TotalAux1, O.PorAforo,E.Cupon,            ")
SQL.ADD("       O.EsAforado,O.NrOperacion, O.TotalGastos, O.FechaOp, O.FechaVto, O.TotalAux3,  ")
SQL.ADD("       O.TotalIVA,O.ContraEspecie                                                     ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                    ")
*SQL.ADD("WHERE O.TipoOp In ('TIV','TIC','TIDE','TIPO','TIPA','TIPP','CTP','VTP','CTC','VTC','CBC','CBT','CFTP','VFTP')   ")
SQL.ADD("WHERE O.TipoOp In ('TIC','TIV','TIFC','TIFV')   ")
SQL.ADD("  and O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"'                                      ")
SQL.ADD("       and O.Cliente1 = C.Codigo                                                      ")
SQL.ADD("       and E.Codigo = O.Especie                                                      ")

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                ")
Endif

SQL.ADD("ORDER BY C.Sucursal,O.Especie,O.TipoOp,O.Cliente1                           ")

ACT(we1,'')
ACT(wt1,'')
ACN(te1,0 )

Recorrer SQL
   
  if Not Eqstr(Val(we1),FBN['Especie'])
     if Not Vacio(Val(we1))
        AgregarMarco(a:FAC..k:FAC,1)
        ACT(e:FAC,'Total Especie : ')
        ACN(f:FAC,Val(te1) )
        ACN(te1,0 )
        SetFont(a:FAC..K:FAC,2)
        ifa
     endif
     
     ifa 
     ACT(a:FAC, BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']) )
     ACT(a:FAC, Val(a:FAC)~' - '~FBN['Especie']~' '~FBN['Cupon']~' '~Trim(FBN['Extendido'])    )
     SetFont(a:FAC,2)
     ACT(we1,FBN['Especie'])
     ACT(wt1,FBN['TipoOp'])

     ifa
  endif

  if Not Eqstr(Val(wt1),FBN['TipoOp'])
     ifa
 
     ACT(a:FAC, BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']) )
     ACT(a:FAC, Val(a:FAC)~' - '~FBN['Especie']~' '~FBN['Cupon']~' '~Trim(FBN['Extendido'])    )
     SetFont(a:FAC,2)
     ACT(wt1,FBN['TipoOp'])

     ifa
  endif


  ACT(a:Fac, FBN['Cliente1']~'  - '~copy(FBN['RazonSocial'],1,25) ) 
  ACT(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaVto'])
  

  if Incluido(FBN['TipoOp'],'TIC|TIFC')
    ACN(f:FAC, FBN['Cantidad'])
    SCN(te1, FBN['Cantidad'])
    ACN(g:FAC, -FBN['TotalNetoCli1'])
  else
    ACN(f:FAC, -FBN['Cantidad'])
    SCN(te1, -FBN['Cantidad'])
    ACN(g:FAC, FBN['TotalNetoCli1'])
  endif

*  if Incluido(FBN['TipoOp'],'CTP|VTP|CTC|VTC|CBC|CBT|CFTP|VFTP')
*     if Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CBT')
*        ACN(g:FAC,FBN['TOTALNETOCLI1']+FBN['TOTALAUX3']+FBN['TOTALIVA'] )
*     else
*        ACN(g:FAC,FBN['TOTALNETOCLI1']-FBN['TOTALAUX3']-FBN['TOTALIVA'] )
*     endif
*  else
*     ACN(g:FAC, FBN['TotalNetoCli1'])
*  endif

  ACT(h:FAC, FBN('NrOperacion'))
  ACLO(h:FAC, FBN('NrOperacion'))

  ACT(i:FAC, BuscarCampo('MERCADOS','Descripcion','Codigo',FBN['Mercado'])  )

  ACN(j:FAC, FBN['Precio1'])
  ACN(k:FAC, Cotizacion(FBN['Especie'],,,,FBN['FechaVto'],1)   )
  ACT(m:FAC,FBN['ContraEspecie'])
  SetFont(a:FAC,1)
proximo

ifa
AgregarMarco(a:FAC..M:FAC,1)
ACT(e:FAC,'Total Especie : ')
ACN(f:FAC,Val(te1) )
SetFont(a:FAC..M:FAC,2)


FormatoCeldas(F:Val(w1)+5..g:FAC,Exe('F2'))
FormatoCeldas(j:Val(w1)+5..m:FAC,Exe('F9'))


ACO(1,30)
