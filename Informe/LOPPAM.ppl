ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1       : "F.Desde"   ;1;1;;;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2       : "F.Hasta"   ; ; ;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta valida';NO;Hoy
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


ACT(f:2,'Fecha : '~Fecha(FSys))
SetFont(f:2..f:2,1)

SetFilaActual(4)
ACT(a:FAC, "Operaciones con Cambios en Parking")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

ACT(a:FAC, 'Fecha Desde:')
ACT(a:FAC+1, 'Fecha Hasta:')

ACD(b:FAC, Dialogo.Fecha1)
ACD(b:FAC+1, Dialogo.Fecha2)
SetFont(a:fac..a:fac+1,2)
SetFont(b:fac..b:fac+1,1)

SetFilaActual(FAC+3)
ACN(w1,FAC)

ACT(a:FAC, 'Nro Op.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'Usuario')
ACT(d:FAC, 'Fecha')
ACT(e:FAC, 'Accion')
ACT(f:FAC, 'Observacion')

SetFont(a:FAC..z:FAC,2)
AgregarMarco(a:FAC..f:FAC,2,0,Exe('COLOR6'))

SQL.ADD("SELECT *  ")  
SQL.ADD("from "~DBO~".LOGPARKING")
SQL.ADD("where Fecha  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and Fecha  < '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD("order by Fecha ")
watch(SQL.BATCH())

Recorrer SQL
  SCN(y:1, 1)
  ACT(a:FAC, fbn('NrOperacion'))  
  ACT(b:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion']))
  ACLO(a:fac, FBN['NrOperacion'])
  ACT(c:FAC, fbn('Usuario'))  
  ACT(d:FAC, fbn('Fecha'))  
  ACT(e:FAC, fbn('Accion'))  
*  ACT(f:FAC, fbn('Observacion'))  
  if EqStr(fbn('Accion'),'DES')
    ACT(f:FAC, 'Anula Afectacion')
  else
    ACT(f:FAC, 'Regenera Afectacion')
  endif
Proximo
    
IF Val(y:1)=0
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Movimientos para la fechas solicitadas')
  SetFont(a:fac,2)
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:fac,2)

ACO(4,15)
ACO(6,20)

LimitesVision(f:FAC)
