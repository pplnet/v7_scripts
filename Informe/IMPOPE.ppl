CrearDialogo
  NrOperacion1 : 'Operacion';;;;;;NoVacio(Dialogo.NrOperacion1);'Operacion Invalida';NO;
  Radio1       : 'WorkFlow|SI|NO'    ;3;;;;;;;;1;
FinDialogo
if not Ok
  Cancelar
endif

***---Listas de Operaciones con Encabezado
ACT(LS:1, 'FXCS|FXVS|FXAS|FXCT|FXVT|FXAT|SECS|SEVS|SECT|SEVT')
ACT(LS:2, 'MMCPM|MMCCR|MMPCLM|MMPOSM|MMDC|MRO|MRF|FCS|FCR|MMDPAC|MMSELN')
ACT(LS:3, 'SECSV|SEVSV|DTSFFM|DTSFVM|DTSVVM|MMPEM|TRANSF|MMPCCM')


SQL.ADD(" Select NrOperacion, TipoOp, TotalAux3, PrecioMer, Plazo, Cantidad, Vehiculo1,Operador, ")
SQL.ADD(" Especie, ContraEspecie, Cliente1, Cantidad, TotalBrutoCli1, TotalNetoCli1, ")
SQL.ADD(" TotalAux1, Contrato, Precio1, PrecioEj, TipoTasa, MB3, Observaciones, ValorRB1, ")
SQL.ADD(" Cuenta1, Cuenta2, Cuenta4, Cuenta5, FechaOp, FechaOp2 ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    ACT(A:1, 'Nro. Operacion:')
    ACT(A:2, 'Tipo de Operacion:')
    ACT(A:3, 'Plazo:')
    ACT(A:4, 'Vehiculo:')
    ACT(A:5, 'Monto USD:')
    ACT(A:6, 'Moneda de la Operacion:')
    ACT(A:7, 'Monto en Moneda Original:')
    ACT(A:8, 'Especie:')
    ACT(A:9, 'Entidad:')
    ACT(A:10, 'Precio/Tipo Tasa/Prima:')
    ACT(A:11, 'Observaciones:')
    ACT(A:12, 'Tasa/Pre.Ejerc.:')
    ACT(A:13, 'Compra/Venta:')
    ACT(A:14, 'Nominal:')
    ACT(A:15, 'De Banco:')
    ACT(A:16, 'De Cuenta:')
    ACT(A:17, 'A Banco:')
    ACT(A:18, 'A Cuenta:')    
    ACT(A:19, 'Fecha de Concertacion')
    ACT(A:20, 'Perfil del Operador')
    ACT(B:20,  BuscarCampo('USUARIOS','Perfil','Codigo',fbn('Operador')))

    ACT(b:1, Dialogo.NrOperacion1)
    ACT(b:2, fbn('TipoOp'))
    ACT(c:2, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
    
    IF Incluido(fbn('TipoOp'), 'FXAS')
        ACT(b:3, fbn('ValorRB1'))
    ELSE
        IF Incluido(fbn('TipoOp'), 'SECS|SEVS')
            ACT(b:3, Fstr(fbn('Plazo')/24, 0, 0))
        ELSE
            ACT(b:3, fbn('Plazo'))
        ENDIF
    ENDIF
    ACT(b:4, fbn('Vehiculo1'))
    ACT(C:4, BuscarCampo('VEHICULOS','Descripcion','Codigo',fbn('Vehiculo1')))
    if Incluido(fbn('TipoOp'), 'DFXO|DSEO')
      ACT(b:5, PyC(fbn('TotalAux3'), 0, 2))
    else
      ACT(b:5, PyC(fbn('PrecioMer'), 0, 2))
    endif
    if Incluido(fbn('TipoOp'), Val(LS:1)) o Incluido(fbn('TipoOp'), Val(LS:2)) O Incluido(fbn('TipoOp'), Val(LS:3))
        if Incluido(fbn('TipoOp'),'FXCS|FXVS|FXAS|FXCT|FXVT|FXAT|SECS|SEVS|SECT|SEVT')
          ACT(b:6, fbn('ContraEspecie'))
          ACT(c:6, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
          ACT(b:7, PyC(fbn('TotalBrutoCli1'),1,2))
          ACT(b:8, fbn('Especie'))
          ACT(c:8, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
          ACT(b:10, FStr(fbn('Precio1'),1,6))
        endif
*        if Incluido(fbn('TipoOp'),'MMCPM|MMCCR|MMPCLM|MMPOSM|MMDC|MMDPAC|TRANSF')
        if Incluido(fbn('TipoOp'),'MMCPM|MMCCR|MMPCLM|MMPOSM|MMDC|MMDPAC|TRANSF|MMPEM|MMPCCM|MMSELN')
          ACT(b:6, fbn('Especie'))
          ACT(c:6, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
          ACT(b:7, PyC(fbn('Cantidad'),1,2))
          ACT(b:10, fbn('TipoTasa'))
          ACT(c:10, BuscarCampo('TIPOSTASA','Nombre','Codigo',fbn('TipoTasa')))
          if Incluido(fbn('TipoOp'),'MMCCR|MMDPAC')
            ACT(b:12, FStr(fbn('Precio1'),1,6))
          endif
        endif
        ***************************01.02.08***************************
        if Incluido(fbn('TipoOp'),'MMPEM|MMPCCM')
          ACT(b:6, fbn('Especie'))
          ACT(b:7, PyC(fbn('Cantidad'),1,2)) 
        endif
        ***************************01.02.08***************************

        if Incluido(fbn('TipoOp'),'MRO|MRF')
          if Incluido(fbn('TipoOp'),'MRO')
            ACT(b:6, fbn('ContraEspecie'))
            ACT(c:6, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
            ACT(b:12, FStr(fbn('PrecioEj'),1,6))
          else
            ACT(b:6, fbn('Especie'))
            ACT(c:6, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
          endif
          ACT(b:7, PyC(fbn('TotalAux1'),1,2))
          ACT(b:8, fbn('Contrato'))
          ACT(c:8, BuscarCampo ('CONTRATOS', 'Descripcion', 'Codigo', fbn ('Contrato')))
          ACT(b:10, FStr(fbn('Precio1'),1,6))
          ACT(b:13, iif(fbn('MB3')=0,'Compra','Venta'))
        endif
        if Incluido(fbn('TipoOp'),'FCS|FCR')
          ACT(b:6, fbn('ContraEspecie'))
          ACT(c:6, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
          ACT(b:7, PyC(fbn('TotalNetoCli1'),1,2))
          ACT(b:8, fbn('Especie'))
          ACT(c:8, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
          ACT(b:10, FStr(fbn('Precio1'),1,6))
        endif
        IF Incluido(fbn('TipoOp'), 'FXAT|FXAS|FCS|FCR|MRO|MRF|SECS|SEVS|SECT|SEVT|FXCS|FXVS|FXCT|FXVT|SECSV|SEVSV')
            ACT(B:14, PyC(fbn('Cantidad'), 1, 2))
        ENDIF
        ***---Debo poner las cuentas Moneda
        IF NoVacio(fbn('ContraEspecie'))
            IF Incluido(fbn('TipoOp'), Var('CARTA1V')) 
            *IF [Incluido(fbn('TipoOp'), Var('CARTA1V'))] o [Incluido(fbn('TipoOp'), Var('CARTA2'))]
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta5')~"' ")
                Recorrer SQL
                    ***---Cuenta Debito
                    ACT(B:15, fbn('Comitente'))
                    ACT(C:15, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:16, fbn('Numero'))
                    ACT(C:16, fbn('Nombre'))
                Proximo
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta2')~"' ")
                Recorrer SQL
                    ***---Cuenta Credito
                    ACT(B:17, fbn('Comitente'))
                    ACT(C:17, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:18, fbn('Numero'))
                    ACT(C:18, fbn('Nombre'))
                Proximo
            ELSE
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta2')~"' ")
                Recorrer SQL
                    ***---Cuenta Debito
                    ACT(B:15, fbn('Comitente'))
                    ACT(C:15, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:16, fbn('Numero'))
                    ACT(C:16, fbn('Nombre'))
                Proximo
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta5')~"' ")
                Recorrer SQL
                    ***---Cuenta Credito
                    ACT(B:17, fbn('Comitente'))
                    ACT(C:17, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:18, fbn('Numero'))
                    ACT(C:18, fbn('Nombre'))
                Proximo
            ENDIF
        ELSE
            IF Incluido(fbn('TipoOp'), Var('CARTA1V'))
 *           IF [Incluido(fbn('TipoOp'), Var('CARTA1V'))] o [Incluido(fbn('TipoOp'), Var('CARTA2'))]
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta1')~"' ")
                Recorrer SQL
                    ***---Cuenta Debito
                    ACT(B:15, fbn('Comitente'))
                    ACT(C:15, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:16, fbn('Numero'))
                    ACT(C:16, fbn('Nombre'))
                Proximo
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta4')~"' ")
                Recorrer SQL
                    ***---Cuenta Credito
                    ACT(B:17, fbn('Comitente'))
                    ACT(C:17, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:18, fbn('Numero'))
                    ACT(C:18, fbn('Nombre'))
                Proximo
            ELSE
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta4')~"' ")
                Recorrer SQL
                    ***---Cuenta Debito
                    ACT(B:15, fbn('Comitente'))
                    ACT(C:15, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:16, fbn('Numero'))
                    ACT(C:16, fbn('Nombre'))
                Proximo
                SQL.ADD(" Select Numero, Comitente, Nombre From "~DBO~".CUENTAS ")
                SQL.ADD(" Where Codigo = '"~fbn('Cuenta1')~"' ")
                Recorrer SQL
                    ***---Cuenta Credito
                    ACT(B:17, fbn('Comitente'))
                    ACT(C:17, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Comitente')))
                    ACT(B:18, fbn('Numero'))
                    ACT(C:18, fbn('Nombre'))
                Proximo
            ENDIF
        ENDIF
        ***---Datos Genericos para todos los TipoOp
        IF Incluido(fbn('TipoOp'), 'TRANSF')
            IF fbn('MB3') = 0
                ACT(b:9, fbn('Vehiculo1'))
                ACT(c:9, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
            ELSE
                ACT(b:9, fbn('Vehiculo2'))
                ACT(c:9, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo2')))
            ENDIF
        ELSE
            ACT(b:9, fbn('Cliente1'))
            ACT(c:9, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente1')))
        ENDIF
        ACT(b:11, fbn('Observaciones')) 
    endif

   IF Incluido(fbn('TipoOp'), 'FXCS|FXVS|FXAS|FXCT|MRO|MRF|FCS|FCR|DTSFFM|DTSFVM|DTSVVM|TRANSF|FXAT|FXVT')
     ACT(B:19, fbn('FechaOp'))
   ELSE
     IF Incluido(fbn('TipoOp'), 'SECS|SEVS|SEVT|SECT|MMCPM|MMCCR|MMPCLM|MMPOSM|MMDPAC|SECSV|SEVSV|MMPEM|MMPCCM|MMSELN') 
       ACT(B:19, fbn('FechaOp2'))
     ENDIF
   ENDIF
   

Proximo

ACT(z:1, Dialogo.NrOperacion1)
ACT(y:2, HORA(AHORA))
ACT(z:2, Copy(Val(y:2),1,2)~Copy(Val(y:2),4,2)~Copy(Val(y:2),7,2))
ACD(y:3, Fsys)
ACT(z:3, Copy(Val(y:3),1,2)~Copy(Val(y:3),4,2)~Copy(Val(y:3),9,2))

SetFilaActual(21)
ImprimirOperacion(Dialogo.NrOperacion1, SI, , , SI, NO, SI)

if Dialogo.Radio1=0
  ExportarXLS(a:1..e:100,a:1..e:100,VAR('PATHWORK')~Val(z:1)~Val(z:3)~Val(z:2)~'.XLS')
  ExportarXLS(a:1..e:100,a:1..e:100,VAR('PATHWOTE')~Val(z:1)~Val(z:3)~Val(z:2)~'.XLS')
endIf

ACO(1, 20)
ACO(2, 15)
ACO(3, 20)

LimitesVision(c:100)
