CrearDialogo
  Fecha1    : 'Fecha';;;;;;;;;FSys
  Vehiculo1 : 'Vehiculo' ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio1    : 'Detalle|Si|No' ;;;;;;;;;0;
FinDialogo

if not Ok 
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif


ACT(a4, 'Limites de Posicion - Issuer')
if NoVacio(Dialogo.Vehiculo1)
  ACT(a5, 'Vehiculo: '~Dialogo.Vehiculo1)
  ACT(z10, Descendientes('Vehiculos', Dialogo.Vehiculo1))
  if NoVacio(Val(z10))
    ACT(z11, "'"~Dialogo.Vehiculo1~"',"~Pipe2Comillas(Val(z10)))
  else
    ACT(z11, "'"~Dialogo.Vehiculo1~"'")
  endif  
else
  ACT(a5, 'Vehiculo: Todos')
endif
ACT(a6, 'Fecha: '~Dialogo.Fecha1)

ACT(a8, 'Activo')
ACT(b8, 'Valor(000s)')
ACT(c8, '% Tot.Grupo')
ACT(d8, '% Max.T.Grupo')
ACT(e8, 'Estado')
ACT(f8, '% Tot.Activo')
AlinearCeldas(b8..d8, 'D')
AlinearCeldas(f8..g8, 'D')

AgregarMarco(a8..f8,1,0,Exe("COLOR"))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z8, 1)

ACT(a9, 'Depositos a plazo')
AgregarMarco(a9..f9,1,0,RGB(192,192,192))

SetFilaActual(9)

SQL.ADD("Select Especie, Cantidad, NrOperacion, TipoOp, Cliente1 from "~DBO~".OPERACIONES where TipoOp in ('MMCDIA','MMCDP','MMCP','MMCPM','MMD','MMDCA','MMCCR','MMO')")
SQL.ADD("and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo1 in ("~Val(z11)~")")
endif
SQL.ADD("order by Cliente1")

recorrer SQL
  dfa
  if Incluido(fbn('TipoOp'),'MMCDIA|MMCDP|MMCP|MMCPM|MMO')
    if Incluido(fbn('Especie'), 'USD|USB') 
      ACN(z3, fbn('Cantidad')/1000)
    else
      ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    endif
  endif
  if Incluido(fbn('TipoOp'),'MMDCA|MMCCR')
    if Incluido(fbn('Especie'), 'USD|USB') 
      ACN(z3, fbn('Cantidad')/1000)
    else
      ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    endif
  endif
  if Incluido(fbn('TipoOp'),'MMD')
    if Incluido(fbn('Especie'), 'USD|USB') 
      ACN(z3, fbn('Cantidad')/1000)
    else
      ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    endif
  endif
  if Not EqStr(fbn('Cliente1'), Val(a:fac)) y Val(z3) > 0
    ifa
    ACT(a:fac, fbn('Cliente1'))
    if Vacio(Dialogo.Vehiculo1)
      ACN(d:fac, LimAsignado(fbn('Cliente1'), 'ISSUER', 'USD'))
      if Val(d:fac)=0
        ACN(d:fac, LimAsignado('BANCOS', 'ISSUER', 'USD'))
      endif
    endif
    SCN(b:fac, Val(z3))
    SCN(b9, Val(z3))
  else
    SCN(b:fac, Val(z3))
    SCN(b9, Val(z3))
  endif
proximo

SQL.ADD("Select Codigo, Cotiza, Alias2, Issuer from "~DBO~".ESPECIES where Tipo='FON'")
recorrer SQL
  dfa
  ACN(z1, 0)
  ACN(z5, 0)
(.'LPOSSPOTFC'.)
*messagebox(fbn('Issuer')~' '~fbn('Codigo')~' '~FStr(Val(z1),1,0))
  if Val(z1) > 0
    if EqStr(fbn('Cotiza'), 'ARP') 
      SCN(z5, Val(z1)*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    else
      SCN(z5, Val(z1)*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    endif
    ACT(x1, fbn('Issuer'))
    if Vacio(Val(x1))
      ACT(x1, 'Otros')
    endif
    ACN(x2, 0)
    recorrer&i 10, fac
      if EqStr(Val(a:&i), Val(x1))
        ACN(x2, &i)
        break
      endif
    proximo
    if Val(x2) > 0
      SCN(b:Val(x2), Val(z5))
    else
      ifa
      ACT(a:fac, Val(x1))
      if Vacio(Dialogo.Vehiculo1)
        ACN(d:fac, LimAsignado(fbn('Issuer'), 'ISSUER', 'USD'))
        if Val(d:fac)=0
          ACN(d:fac, LimAsignado('BANCOS', 'ISSUER', 'USD'))
        endif
      endif
      SCN(b:fac, Val(z5))
    endif
    SCN(b9, Val(z5))
  endif
proximo


BorrarCeldas(x1..x1)
ifa
ACT(a:fac, 'Titulos Publicos')
AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
ACN(w1, fac)

SQL.ADD("Select * from "~DBO~".ESPECIES where Tipo='PUB' order by Issuer")

recorrer SQL
  dfa

  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)

  (.'LPOSSPOTTT'.)
  Message(' Especie Cdo. '~fbn('Codigo')~' '~Fstr(val(z1),0,2) )

  (.'LPOSFUTURO'.)
  Message(' Especie Fut. '~fbn('Codigo')~' '~Fstr(val(z1),0,2) )

  if Val(z1)>0 o Val(z8)>0
    ACT(x1, fbn('Issuer'))
    if Vacio(Val(x1))
       ACT(x1, 'Otros')
    endif
    if Not EqStr(Val(x1), Val(a:fac))
       ifa
       ACT(a:fac, Val(x1))
    endif

    acn(m1,CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD'))

    ACT(ab:fac,FBN['InteresesC'])
    ACN(ac:fac,FBN['VTeorico'])

    if EqStr(Val(ab:fac),'CLE')
       * ensuciar el precio 
       ** calcular la tasa (%) x95:Dif. de dias x96:Especie x97:Fecha de Liquidacion   x98:Tasa Base x99:Tasa 
       ACT(x96,fbn('Codigo'))
       ACD(x97,Dialogo.Fecha1)
       ACN(x98,0)
       ACN(x99,0)

       (.'CALCINT'.)
       *TotalIntereses
       ACN(y98,Val(ac:fac)*(Val(z8)+Val(z1))*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Codigo')),Fsys)/100*Val(x95))
       * Total Neto
       ACN(y99,(Val(ac:fac)*(Val(z8)+Val(z1))*Val(m1))+Val(y98))
       * Precio Sucio
       ACN(m1, Val(y99)/(Val(z8)+Val(z1)))
    endif

    * MessageBox('Cotizacion '~val(m1))    

    SCN(b:fac, ((Val(z8)+Val(z1))*val(m1))/1000)

    if Vacio(Dialogo.Vehiculo1)
       ACN(d:fac, LimAsignado(fbn('Issuer'), 'ISSUER', 'USD'))
       if Val(d:fac)=0
          ACN(d:fac, LimAsignado('BANCOS', 'ISSUER', 'USD'))
       endif
    endif
  endif
proximo

ACN(b:Val(w1), SUM(b:Val(w1)+1..b:fac))

BorrarCeldas(x1..x1)
ifa
ACT(a:fac, 'Titulos Privados')
AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
ACN(w2, fac)

SQL.ADD("Select Codigo, Cotiza, Issuer, Tipo from "~DBO~".ESPECIES where Tipo in ('ONE','PRI') order by Issuer, Tipo")

Recorrer SQL

  Message(fbn('Codigo'))

  dfa
  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)
  ACN(x3, 0)

  (.'LPOSSPOTTT'.)
  (.'LPOSFUTURO'.)

  if Val(z1)>0 o Val(z8)>0
     ACT(x1, fbn('Issuer'))

     if Vacio(Val(x1)) 
       ACT(x1, 'Otros')
     endif

     if EqStr(fbn('Tipo'), 'ONE')
        ACT(x2, 'Bonos')
     else
        ACT(x2, 'Acciones')
     endif
     if Not EqStr(Val(x1)~' '~Val(x2), Val(a:fac))
        ifa
        ACT(a:fac, Val(x1)~' '~Val(x2))
     endif

     if EqStr(fbn('Cotiza'), 'ARP') 
        SCN(b:fac, Val(z8)+Val(z1)*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
     else
        SCN(b:fac, Val(z8)+Val(z1)*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
     endif

     if Vacio(Dialogo.Vehiculo1)
        if EqStr(fbn('Tipo'), 'ONE')
           ACN(d:fac, LimAsignado(fbn('Issuer'), 'ISSONS', 'USD'))
           if Val(d:fac)=0
              ACN(d:fac, LimAsignado('BANCOS', 'ISSONS', 'USD'))
           endif
        else
           ACN(d:fac, LimAsignado(fbn('Issuer'), 'ISSACC', 'USD'))
           if Val(d:fac)=0
              ACN(d:fac, LimAsignado('BANCOS', 'ISSACC', 'USD'))
           endif
        endif
     endif
  endif

proximo


ACN(b:Val(w2), SUM(b:Val(w2)+1..b:fac))

ACT(a:fac+1, 'Total')
ACN(b:fac+1, Val(b9)+Val(b:Val(w1))+Val(b:Val(w2)))
ACN(v1, fac)

ACO(1, 17)
ACO(2, 10)
ACO(3, 10)
ACO(4, 10)
ACO(5, 10)
ACO(6, 10)
ACO(7, 10)
ACO(8, 10)
AgregarMarco(a8..a:fac,1)
AgregarMarco(b8..b:fac,1)
AgregarMarco(c8..e:fac,1)
AgregarMarco(f8..f:fac,1)
AgregarMarco(d8..d8,1)
AgregarMarco(a:fac+1..f:fac+1,1,0,Exe('COLOR'))


recorrer&i 9, fac
  ACN(f:&i, Val(b:&i)/Val(b:fac+1)*100)
  if &i<>9 y &i<>Val(w1) y &i<>Val(w2)
    if &i > Val(w2)
      ACN(c:&i, Val(b:&i)/Val(b:Val(w2))*100)
    else
      if &i > Val(w1)
        ACN(c:&i, Val(b:&i)/Val(b:Val(w1))*100)
      else
        ACN(c:&i, Val(b:&i)/Val(b9)*100)
      endif
    endif
    if Val(d:&i) >= 0 y Vacio(Dialogo.Vehiculo1)
      if Val(c:&i)>Val(d:&i)
        ACT(e:&i, 'Excedido')
        ColorCeldas(e:&i,clRED)
      else
        ACT(e:&i, 'OK')
        ColorCeldas(e:&i,clGREEN)
      endif
    endif
  endif
proximo


SetFont(a9..a:fac+1,1)
SetFont(b9..z:fac+1,2)

SetFilaActual(fac+2)

If Dialogo.Radio1=0
   ACN(w20, fac)
   recorrer ("Select Codigo from "~DBO~".VEHICULOS")
     dfa
     if [DesciendeDeVehiculo(fbn('Codigo'),Dialogo.Vehiculo1) y not EqStr(fbn('Codigo'), Dialogo.Vehiculo1)] o Vacio(Dialogo.Vehiculo1)
        ifa
        ACT(a:fac, fbn('Codigo'))
        AsignarLink(a:fac, 'LPOSI2', Vehiculo1=Val(a:fac), Fecha1=Dialogo.Fecha1, Radio1=0)
     endif
   proximo
   SetFont(a:Val(w20)..z:fac,2)
EndIf

LimitesVision(g:fac+2)
Impresion(1,1)
