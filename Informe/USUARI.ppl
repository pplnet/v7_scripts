ModoReproceso(SinDialogo)
CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)

ACT(f:2,'Fecha : '~Var('FECHASYS'))
SetFont(f:2..g:2,1)

ACT(a:FAC, 'Estado de Usuarios')
ACT(a:FAC+1, 'al : '~Fecha(FSys))
ACT(a:FAC+3, 'C¢digo')
ACT(b:FAC+3, 'Nombre')
ACT(c:FAC+3, 'F. Ultimo Acceso')
ACT(d:FAC+3, 'Perfil')
ACT(e:FAC+3, 'Estado')
ACT(f:FAC+3, 'Int.Fallidos')
ACT(g:FAC+3, 'F. Deshab.')
AgregarMarco(a:FAC+3..g:FAC+3,2,0,Exe('COLOR'))
SetFont(a:FAC..j:FAC+3,2)
SetFilaActual(FAC+3)

SQL.ADD("Select * From "~DBO~".USUARIOS")
SQL.ADD("order by Codigo")

recorrer SQL
  ACT(a:fac, FBN['Codigo'])
  ACT(b:fac, FBN['Nombre'])
  ACT(c:fac, FBN['FAcceso'])
  ACT(d:fac, FBN['Perfil'])
  if FBN['Status'] = 0 
    ACT(e:fac, 'Normal')
  endif
  if FBN['Status'] = 1
    ACT(e:fac, 'Deshab.')
  endif
  if FBN['Status'] = 2 
    ACT(e:fac, 'Suspend.')
  endif
  if FBN['Status'] = 3 
    ACT(e:fac, 'Revocado')
  endif
  ACN(f:fac, FBN['Cantintentos'])
  if FBN['Status'] > 0
    ACT(g:fac, FBN['FDeshabilitacion'])
  endif
proximo

SetFont(a:Val(w1)+4..j:FAC, 1)

ACO(1,7)
ACO(2,15)
ACO(3,14)
ACO(4,14)
ACO(5,7)
ACO(6,7)
ACO(7,7)
ACO(8,7)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
LimitesVision(g:FAC)
RangoTitulo(a:1..j:FAC, Val(w1)+3)

AgregarBMP(a1,Exe('LOGO'),70)
