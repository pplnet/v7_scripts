*ModoReproceso(ConDialogo)
CrearDialogo
  String1:      'D.Cuenta'         ;;;;;;NOVACIO(Dialogo.String1);'Debe ingresar una cuenta valida';NO;'0'
  String2:      'H.Cuenta'         ;;;;;;NOVACIO(Dialogo.String2);'Debe ingresar una cuenta valida';NO;'999999999999'
  Fecha1:       'D.FechaValor'     ;;;;;;NOVACIO(Dialogo.Fecha1) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha2:       'H.FechaValor'     ;;;;;;NOVACIO(Dialogo.Fecha2) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha3:       'D.FechaGeneracion';;;;;;NOVACIO(Dialogo.Fecha3) ;'Debe ingresar una fecha valida' ;NO;;Fecha('01/01/2003')
  Fecha4:       'H.FechaGeneracion';;;;;;NOVACIO(Dialogo.Fecha4) ;'Debe ingresar una fecha valida' ;NO;;FSys+365
  Cliente1:     'Cliente'         
  NrOperacion1: 'Operacion'
  Cuenta1:      'Cuenta'           ;;;;;;;;;;;;;;" TipoCuenta in('CA','CC') ";
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

AgregarBMP(a1,Exe('LOGO'),80)
ACT(a3, 'Asientos Generados por Cuenta y Modelo')
ACT(a4, 'Desde Cuenta: '~Dialogo.String1)
ACT(a5, 'Hasta Cuenta: '~Dialogo.String2)

ACT(d4, 'Desde FechaValor: '~FECHA(Dialogo.Fecha1,'dd/mm/yyyy'))
ACT(d5, 'Hasta FechaValor: '~FECHA(Dialogo.Fecha2,'dd/mm/yyyy'))

ACT(g4, 'Desde FechaGeneracion: '~FECHA(Dialogo.Fecha3,'dd/mm/yyyy'))
ACT(g5, 'Hasta FechaGeneracion: '~FECHA(Dialogo.Fecha4,'dd/mm/yyyy'))

IF NOVACIO(Dialogo.Cliente1)
   ACT(a6, 'Cliente: '~Dialogo.Cliente1)   
ELSE
   ACT(a6, 'Cliente: Todos')
ENDIF
ACT(a7, 'Operacion: '~iif(Novacio(Dialogo.NrOperacion1),Dialogo.NrOperacion1,'Todas'))
ACT(g7, 'Cuenta: '~iif(Novacio(Dialogo.Cuenta1),Dialogo.Cuenta1,'Todas'))

SetFont(a1..k8, 1)
SetFilaActual(8)

SQL.ADD(" SELECT A.Cuenta, A.Especie1, A.Detalle, A.NrUnicoAsiento, A.NrUnicoAsiento, A.DebitoCredito, A.Cantidad1, A.NrOperacion, A.CentroCosto,  ")
SQL.ADD("        O.TipoOp, O.FechaOp, C.FechaValor, C.FechaGeneracion, C.Modelo, M.NrItem, M.Detalle, O.Cliente1, O.FechaVto, O.FechaPago, N.TipoAsiento, C.NrTrans2  ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON1 A RIGHT OUTER JOIN "~DBO~".OPERACIONES O1 ON A.NrOperacion  = O1.NrOperacion,   ")
SQL.ADD("    "~DBO~".ASIENTOSCON C, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO1 M, "~DBO~".MODELOSASIENTO N     ")
SQL.ADD(" WHERE A.Cuenta          >= '"~Dialogo.String1~          "'")
SQL.ADD(" AND   A.Cuenta          <= '"~Dialogo.String2~          "'")
SQL.ADD(" AND   A.NrOperacion      = O.NrOperacion                  ")
SQL.ADD(" AND   A.NrUnicoAsiento   = C.NrUnicoAsiento               ")
SQL.ADD(" AND   C.FechaValor      >= '"~IdxDate(Dialogo.Fecha1)~  "'")
SQL.ADD(" AND   C.FechaValor      <= '"~IdxDate(Dialogo.Fecha2)~  "'")
SQL.ADD(" AND   C.FechaGeneracion >= '"~IdxDate(Dialogo.Fecha3)~  "'")
SQL.ADD(" AND   C.FechaGeneracion <= '"~IdxDate(Dialogo.Fecha4)~  "'")
SQL.ADD(" AND   C.Modelo           = M.Modelo                       ")
SQL.ADD(" AND   M.Modelo           = N.Codigo                       ")
SQL.ADD(" AND   M.NrItem           = A.NrItem                       ")
IF NOVACIO(Dialogo.Cliente1)
   SQL.ADD(" AND   O.Cliente1      = '"~Dialogo.Cliente1~         "'")
ENDIF
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" AND C.NrOperacion = '"~Dialogo.NrOperacion1~"'")
ENDIF
IF NoVacio(Dialogo.Cuenta1)
   SQL.ADD(" AND C.NrTrans2 = '"~Dialogo.Cuenta1~"'")
ENDIF
SQL.ADD(" ORDER BY A.Cuenta, A.Especie1, C.Modelo, C.FechaValor, C.FechaGeneracion, A.NrUnicoAsiento, M.NrItem,  A.DebitoCredito, O.NrOperacion  ")

ACN(pr1,0)
ACN(pr2,0)

Recorrer SQL
  IF [NOT EqStr(fbn('Cuenta'), Val(oa1))] o [NOT EqStr(fbn('Especie1'), Val(ea1))] o [NOT EqStr(fbn('Modelo'), Val(ma1))]
     IF Val(pr1)=1
        ACT(a:fac, 'Totales Modelo ... ')
        ACN(f:fac, SUM(f:Val(fa1)..f:fac))
        ACN(e:fac, SUM(e:Val(fa1)..e:fac))
        SCN(tc1, Val(f:fac))
        SCN(td1, Val(e:fac))
        IF Val(f:fac) > Val(e:fac)
           ACT(g:fac, 'Credito: ')
        ELSE
           ACT(g:fac, 'Debito: ')
        ENDIF
        AlinearCeldas(g:fac..g:fac,'D')
        ACN(h:fac, ABS(Val(e:fac)-Val(f:fac)))
        SetFont(a:val(fa1)..m:fac-1, 2)
        SetFont(a:fac..m:fac, 1)
        ifa
        ifa
     ELSE
       ACN(pr1,1)      
     ENDIF
     IF [NOT EqStr(fbn('Cuenta'), Val(oa1)) o NOT EqStr(fbn('Especie1'), Val(ea1))]  
        IF Val(pr2)=1
         dfa
         ACT(a:fac, 'Total Cuenta: '~Val(oa1)~' en '~Val(ea1))
         ACN(f:fac, Val(tc1))
         ACN(e:fac, Val(td1))
         SCN(cf1, Val(f:fac))
         SCN(df1, Val(e:fac))       
         IF Val(f:fac) > Val(e:fac)
            ACT(g:fac, 'Credito: ')
         ELSE
            ACT(g:fac, 'Debito: ')
         ENDIF
         AlinearCeldas(g:fac..g:fac,'D')
         ACN(h:fac, ABS(Val(e:fac)-Val(f:fac)))      
         SetFont(a:fac..m:fac, 1)
         ACN(tc1, 0)
         ACN(td1, 0)
         ifa
         ifa
        ELSE
         ACN(pr2,1)      
        ENDIF
        message(fbn('Cuenta'))
        ACT(a:fac, 'Cuenta: '~fbn('Cuenta')~'   Descripcion: '~fbn('Detalle')~'   Moneda: '~fbn('Especie1'))
        ACT(oa1, fbn('Cuenta'))
        ACT(ea1, fbn('Especie1'))
        SetFont(a:fac..m:fac, 1)
        AgregarMarco(a:fac..m:fac,1,0,EXE('COLOR'))
        ifa
     ENDIF 
     ACN(fa1, fac)
  ENDIF
  IF NOT EqStr(fbn('Modelo'), Val(ma1)) 
     ACT(dm1, SQL("SELECT Descripcion FROM "~DBO~".MODELOSASIENTO WHERE Codigo = '"~fbn('Modelo')~"'"))
     ACT(a:fac, 'Modelo: '~fbn('Modelo')~' - '~Val(dm1))
     SetFont(a:fac..m:fac, 1)
     AgregarMarco(a:fac..m:fac,1,0)
     ACT(ma1, fbn('Modelo'))
     ifa
        ACT(a:fac, 'NrAsiento')
        ACT(b:fac, 'Item')
        ACT(c:fac, 'FechaValor')
        ACT(d:fac, 'FechaGen.')
        ACT(e:fac, 'Debito')
        ACT(f:fac, 'Credito')
        ACT(g:fac, 'NrOperacion')
        ACT(h:fac, 'Cliente')
        ACT(i:fac, 'FechaOp')
        ACT(j:fac, 'Vto.M.E.')
        ACT(k:fac, 'Vto.M.Pago')
        ACT(l:fac, 'Centro Costo')
        ACT(m:fac, 'Vou./Cuenta')
        AgregarMarco(a:fac..m:fac,1,0)
        SetFont(a:fac..m:fac, 1)
        ifa
       ACN(fa1, fac)
  ENDIF

  ACN(a:fac, fbn('NrUnicoAsiento'))
  ACT(b:fac, Fstr(fbn('NrItem'),1,0))
  ACD(c:fac, fbn('FechaValor'))
  ACD(d:fac, fbn('FechaGeneracion'))
  IF EqStr(fbn('DebitoCredito'), 'CRE')
      ACN(f:fac, fbn('Cantidad1'))
      ACN(e:fac, 0)
  ELSE
      ACN(e:fac, fbn('Cantidad1'))
      ACN(f:fac, 0)
  ENDIF
  ACT(g:fac, fbn('NrOperacion'))
  if Novacio(fbn('NrOperacion')) y Vacio(fbn('Cliente1'))
     ACT(h:fac, SQL("SELECT Cliente FROM "~DBO~".CUENTAS WHERE Codigo='"~FBN['NrOperacion']~"' "))
  else
     ACT(h:fac, fbn('Cliente1'))
     ACLO(g:fac, fbn('NrOperacion'))
  endif
  ACD(i:fac, fbn('FechaOp'))
  ACD(j:fac, fbn('FechaVto'))
  if NoVacio(fbn('FechaPago'))
     ACD(k:fac, fbn('FechaPago'))
  endif
  ACT(l:fac, fbn('CentroCosto'))
  ACT(m:fac, fbn('NrTrans2'))

Proximo
ifa
ACT(a:fac, 'Totales Modelo ... ')
ACN(e:fac, SUM(e:Val(fa1)..e:fac))
ACN(f:fac, SUM(f:Val(fa1)..f:fac))
SCN(tc1, Val(f:fac))
SCN(td1, Val(e:fac))

ACN(h:fac, Val(e:fac)-Val(f:fac))
IF Val(f:fac) > Val(e:fac)
   ACT(g:fac, 'Credito: ')
ELSE
   ACT(g:fac, 'Debito: ')
ENDIF
AlinearCeldas(g:fac..g:fac,'D')

ACT(a:fac+1, 'Total Cuenta: '~Val(oa1)~' en '~Val(ea1))
ACN(f:fac+1, Val(tc1))
ACN(e:fac+1, Val(td1))

SCN(cf1, Val(f:fac+1))
SCN(df1, Val(e:fac+1))       

ACT(a:fac+5, 'Total Final . . . ')

ACN(f:fac+5, Val(cf1))
ACN(e:fac+5, Val(df1))

IF Val(f:fac+1) > Val(e:fac+1)
   ACT(g:fac+1, 'Credito: ')
ELSE
   ACT(g:fac+1, 'Debito: ')
ENDIF

IF Val(f:fac+5) > Val(e:fac+5)
   ACT(g:fac+5, 'Credito: ')
ELSE
   ACT(g:fac+5, 'Debito: ')
ENDIF

AlinearCeldas(g:fac+1..g:fac+5,'D')

ACN(h:fac+1, ABS(Val(e:fac+1)-Val(f:fac+1)))      
ACN(h:fac+5, ABS(Val(e:fac+5)-Val(f:fac+5)))      


AgregarMarco(a:fac+5..m:fac+5,1,0)

SetFont(a:val(fa1)..m:fac-1, 2)

SetFont(a:fac..m:fac+5, 1)

AlinearCeldas(e8..f:fac+5,'D')

FormatoCeldas(a9..a:fac+5,Exe('F0'))
FormatoCeldas(f9..g:fac+5,Exe('F2'))

ACO(2,3)
ACO(7,8)
ACO(12,8)
ACO(13,8)

LimitesVision(n:fac+7)
Impresion(1,2)
