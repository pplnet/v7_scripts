     ACN(g:FAC+1, ABS(Val(to:2)))
  else
     ACN(f:FAC+1, ABS(Val(to:1)))
  endif
   
  ACT(d:FAC+2, 'Total a Cobrar :')
  ACN(g:FAC+2, ABS(Val(es:1)))
  
  **Modificaciones 30/08/23
