  ACT(d:FAC+3, IIF((val(g:FAC+1)+val(f:FAC+1)-val(g:fac+2))>0,'Neto a Pagar :','Neto a Cobrar :'))
  ACN(g:FAC+3, ABS(val(g:FAC+1)+val(f:FAC+1)-val(g:fac+2)))

  AlinearCeldas(e:FAC..g:FAC+4,'D')
