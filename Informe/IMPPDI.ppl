    * ACT(a:FAC+12, 'Subcuenta : ' ~ BuscarCampo('CUENTAS','Alias2','Codigo',fbn['Cuenta1']))
    *Endif
 

    *SetFilaActual(FAC+13)
  SetFilaActual(FAC+10)  
  ACT(a:FAC, 'Fecha Op.')
  ACT(b:FAC, 'Nro. Op.')
  ACT(c:FAC, 'T.Op.')
  ACT(d:FAC, 'Descripcion')
  ACT(e:FAC, 'Porc/Tasas')
  ACT(f:FAC, 'Acciones')
  ACT(g:FAC, 'Moneda')
  *ACT(h:FAC, 'Confir.')
  ACN(ii:1, FAC) 

  AlinearCeldas(e:FAC..g:FAC,'D')

  AgregarMarco(a:FAC..g:FAC, 2,0,Exe('COLOR')) 
  SetFilaActual(fac+1)
  
  ACT(a:FAC, fbn('Fecha2'))
  ACT(b:FAC, fbn['NrTrans'])
  ACLT(b:FAC, fbn['NrTrans'])
  ACT(c:FAC, fbn['TipoTr2'])
  ACT(d:fac,'SALDO '~Mayusculas2(fbn('NomEsp')))
  ACN(f:fac,fbn('Cantidad1'))
