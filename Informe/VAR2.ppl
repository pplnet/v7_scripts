ModoReproceso(ConDialogo)

CrearDialogo:1,'Position|Scope1|Scope2|VarMethodology|'
  
    Radio4      :'TPos|COB|ONL|SIM|'        ; 1;1;1;;;
    Fecha5      :'PositionDate'             ; 2;1;1;;;
    Fecha6      :'MTMPriceDate'             ; 3;1;1;;;
    Check1      :'Automatico'               ; 4;1;1;;;;;;0;

    Check3      :'Gen.Archivo'              ;18;1;1;;;;;;0;
    String10    :'Path'                     ;19;1;1;Dialogo.Check3=1;Dialogo.Check3=1;;;;;
    String11    :'Archivo'                  ;20;1;1;Dialogo.Check3=1;Dialogo.Check3=1;;;;Fecha(FSYS, 'YYYYMMDD')~'-'~Hora(Ahora)~'_'~'VAR';

    Entero5     :'Cod. Corrida'             ;22;1;1;;;
    Entero1     :'Cantidad'                 ;23;1;1;;;
    
    Check5      :'Detalle'                  ;25;1;1;;;

    
    Radio2      :'Historical Period|Days|Between days|' ; 1;1;4;;;
    Entero2     :'Days Back'                            ; 2;1;4;;;
    Fecha3      :'From'                                 ; 2;1;4;;;
    Fecha4      :'To'                                   ; 3;1;4;;;
    Entero3     :'Holding Period'                       ; 5;1;4;;;
    Check2      :'Translation'                          ; 6;1;4;;;
    Especie2    :'TCTranslation'                        ; 6;2;4;;;

FinDialogo
 
if not ok
  cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:fac, CODIGOINFORME)

SetFilaActual(fac+2)

ACT(a:fac, 'Base Reporting:')
ifa
ACT(a:fac, 'Geographic Location:')

ifa
ACT(a:fac, 'Historical Period:')
If Dialogo.Radio2=0
  ACT(b:fac, 'Days')
  ifa
  ACT(a:fac, 'Days Back:')
  ACT(b:fac, Fstr(Dialogo.Entero2,0,0))
Endif
If Dialogo.Radio2=1
  ACT(b:fac, 'Between days')
  ifa
  ACT(a:fac, 'From:')
  ACT(b:fac, Dialogo.Fecha3)
  ifa
  ACT(a:fac, 'To:')
  ACT(b:fac, Dialogo.Fecha4)
Endif
ifa
ACT(a:fac, 'Holding Period')
ACT(b:fac, Fstr(Dialogo.Entero3,0,0))

ifa
ACT(a:fac, 'Translation:')
IF Dialogo.Check2 = 0
  ACT(b:fac, 'NO')
ENDIF
IF Dialogo.Check2 = 1
  ACT(b:fac, 'YES')
  ifa
  ACT(a:fac, 'TC Translation:')
  ACT(b:fac, Dialogo.Especie2)
ENDIF

ifa
ACT(a:fac, 'Confidence Level:')
ACT(b:fac, Fstr(Dialogo.Cantidad4,0,4))
ifa
ACT(a:fac, 'Neg/Pos:')
If Dialogo.Radio3=0
  ACT(b:fac, 'NEG')
Endif
If Dialogo.Radio3=1
  ACT(b:fac, 'POS')
Endif
ifa

ACT(a:fac, 'Type Position:')
If Dialogo.Radio4=0
  ACT(b:fac, 'Close Of Bussiness')
Endif
If Dialogo.Radio4=1
  ACT(b:fac, 'Online')
Endif
If Dialogo.Radio4=2
  ACT(b:fac, 'Simulated')
Endif
ifa

ACT(a:fac, 'PositionDate:')
ACD(b:fac, Dialogo.Fecha5)
ifa
ACT(a:fac, 'MTMPriceDate:')
ACD(b:fac, Dialogo.Fecha6)
ifa
ACT(a:fac, 'Position:')
ACT(b:fac, Dialogo.Posicion1)
ifa

ACT(a:fac, 'TC Dolar:')
ACT(b:fac, Dialogo.Precio1)
ifa

ACT(a:fac, 'Report Currency:')
If Dialogo.Radio5=0
  ACT(b:fac, 'ARS')
Endif
If Dialogo.Radio5=1
  ACT(b:fac, 'USD')
Endif
ifa

If Dialogo.Radio6=1
  ACT(b:fac, 'VAR')
  ifa
  
  ACT(a:fac, 'Row:')
  ACT(b:fac, Dialogo.String1)
  ifa
  ACT(a:fac, 'Column:')
  ACT(b:fac, Dialogo.String2)
  ifa
  
Endif

ACT(a:fac, 'Weigthed per day: ')
ACT(b:fac, 1/Dialogo.Entero1 * 100)

SetFilaActual(fac+2)

ACT(a:fac, 'POSITION')
*ACL(a:fac,'POSGEN', Reporting1 = Dialogo.Reporting1, Radio4 = Dialogo.Radio4, Fecha5 = Dialogo.Fecha5, Posicion1 = Dialogo.Posicion1, Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Lista3 = Dialogo.Lista3, Lista4 = Dialogo.Lista4, Lista5 = Dialogo.Lista5, Lista6 = Dialogo.Lista6, Lista7 = Dialogo.Lista7, Lista8 = Dialogo.Lista8, Lista9 = Dialogo.Lista9, Lista10 = Dialogo.Lista10, Lista11 = Dialogo.Lista11 )

SetFont(a:1..b:fac,2)

SetFilaActual(fac+2)

IF Dialogo.Check1 = 0 
    ACT(a:fac, 'SAVE')
    *   ACL(a:fac,'GUAREP', Radio7 = 0, Reporting1 = Dialogo.Reporting1, Entero5 = Dialogo.Entero5, Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Lista3 = Dialogo.Lista3, Lista4 = Dialogo.Lista4, Lista5 = Dialogo.Lista5, Lista6 = Dialogo.Lista6, Lista7 = Dialogo.Lista7, Lista8 = Dialogo.Lista8, Lista9 = Dialogo.Lista9, Lista10 = Dialogo.Lista10, Lista11 = Dialogo.Lista11, Radio2 = Dialogo.Radio2, Entero2 = Dialogo.Entero2, Fecha3 = Dialogo.Fecha3, Fecha4 = Dialogo.Fecha4, Entero3 = Dialogo.Entero3, Check2 = Dialogo.Check2, Especie2 = Dialogo.Especie2, Cantidad4 = Dialogo.Cantidad4, Radio3 = Dialogo.Radio3, Radio4 = Dialogo.Radio4, Fecha5 = Dialogo.Fecha5, Fecha6 = Dialogo.Fecha6, Posicion1 = Dialogo.Posicion1, Radio5 = Dialogo.Radio5, Radio6 = Dialogo.Radio6, String1 = Dialogo.String1, String2 = Dialogo.String2, Lista20 = '', Radio8 = 0, Especie1 = '')
    SetFont(a:1..b:fac,2)
    SetFilaActual(fac+2)
ENDIF

IF Dialogo.Radio6 = 0
*    (.'VARSTRING'.)
ENDIF
messagebox('hola1')
messagebox(Dialogo.Radio6)
IF Dialogo.Check5 = 1
    ACT(id:1, 'VAR')
        (.'AUXFILCOL'.)    
ENDIF
messagebox('hola2')
*Return -> Val(ca:1) -> Ultima columna utilizada

ACT(Val(ca:1)-1:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(Val(ca:1)-1:2..Val(ca:1)-1:2,1)

SetFilaActual(fac+2)
ACT(a:fac, 'FIN REPORTE')
SetFont(a:FAC, 2)

IF Dialogo.Check1 = 1 Y Dialogo.Check3 = 1

    *Salvar en HREPORTING
    ACN(co:2, Dialogo.Entero5)
    ACD(fe:1, Dialogo.Fecha5)
    *    (.'GUAHREPORT'.)

    ExportarXLS(a:1..Val(ca:1):fac, a:1..Val(ca:1):fac, Dialogo.String10~Dialogo.String11~'.XLS')
    *ExportarPDF(Dialogo.String10~Dialogo.String11~'.PDF')
    
ENDIF

limitesVision(Val(ca:1):fac)