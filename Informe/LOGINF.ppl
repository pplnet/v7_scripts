CrearDialogo
  Fecha1    : 'Fecha';;;;;;;;;FSys
  Operador  : 'Usuario'
FinDialogo


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')

ACT(a:1,'Log de Informes y Eventos Ejecutados')
ACT(a:2,'Fecha : '~Dialogo.Fecha1)
SetFont(a:1..a:2,2)

SetFilaActual(3)

ACT(aa1, "Select * from "~DBO~".LOGINFORMES WHERE Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and Fecha<'"~IdxDate(Dialogo.Fecha1+1)~"'")

Recorrer (Val(aa1))
  if fac=4
    ACN(z1, FieldCount)
    recorrer&i 1, Val(z1)
      ACT(&i:3, FieldNames[&i-1])
    proximo
  endif

  recorrer&i 1, FieldCount
    ACT(&i:fac, Fields[&i-1])  
  proximo
proximo
SetFont(a3..Val(z1):3,2)
SetFont(a4..Val(z1):fac,1)
AgregarMarco(a3..Val(z1):3,2,0,13697023)
AgregarMarco(a4..Val(z1):fac,1)
LimitesVision(Val(z1):fac+2)

