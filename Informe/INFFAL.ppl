CrearDialogo
  Fecha1   : 'Fecha'    ;1;1;;;;Dialogo.Fecha1>0;'Debe Ingresar Fecha valida';NO;Habiles(FSys,-1,'ARG')
  Radio1   : 'Plazo|Hasta 3 dias|Mas 3 dias'; 2;1;;;;;;;0;
  Vehiculo1: 'Vehiculo' ;3;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*******************************
* busco las fallas primero para poder ordenarlas
*******************************
SetFilaActual(1)
ACT(aa:FAC, 'Tipo Op')
ACT(ab:FAC, 'FechaOp')
ACT(ac:FAC, 'F.Vto Ori.')
ACT(ad:FAC, 'Nombre Cliente')
ACT(ae:FAC, 'Especie')
ACT(af:FAC, 'Cantidad')
ACT(ag:FAC, 'Monto')
ACT(ah:FAC, 'Precio')
ACT(ai:FAC, 'Moneda')
ACT(aj:FAC, 'Valor Mercado')
ACT(ak:FAC, 'Nueva F.Liq')
ACT(al:FAC, 'Dias falla')
ACT(am:FAC, 'Desc. Falla')
ACT(an:FAC, 'Nr.Op')
ACT(ao:FAC, 'Tipo Op')
ACT(ap:FAC, 'Cliente')
ACT(aq:FAC, 'Cantidad')
ACT(ar:FAC, 'FechaOp')
ACT(as:FAC, 'FechaVto')
ACT(at:FAC, 'FechaPago')
ACT(au:FAC, 'FechaASExt')
ACT(av:FAC, 'Concepto')
ACT(aw:FAC, 'Cotizacion')
ACT(ax:FAC, 'TipoInf')
ACT(ba:FAC, '# MP')
ACT(bb:FAC, 'Sum MP')
ACT(bc:FAC, '# ME')
ACT(bd:FAC, 'Suma MP')
SetFont(aa:FAC..bz:FAC,2)

SQL.ADD("Select O.* from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES MP ")
SQL.ADD(" where O.TipoOp in ('TIC','TIV') ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("   and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("   and O.FechaVto > O.FechaPago ")
SQL.ADD("   and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.NrOperacion = MP.NrOperacion ")
SQL.ADD("   and MP.NrSaldo = 1 ")
SQL.ADD("   and MP.Especie = O.Especie ")
SQL.ADD(" Union all ")
SQL.ADD("Select O.* from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS ME ")
SQL.ADD(" where O.TipoOp in ('TIC','TIV') ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("   and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("   and O.FechaVto > O.FechaPago ")
SQL.ADD("   and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.NrOperacion = ME.NrOperacion ")
SQL.ADD("   and ME.NrSaldo in (1,31) ")
SQL.ADD("   and ME.Especie = O.Especie ")
SQL.ADD("   and ME.FechaMov>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" order by O.NrOperacion ")
recorrer SQL
  SCN(z:1, 1)
  ACT(ae:FAC, fbn('Especie'))
  ACN(ah:FAC, fbn('Precio1'))
  ACT(ai:FAC, fbn('ContraEspecie'))
  
  ACT(an:FAC, fbn('NrOperacion'))
  ACT(ao:FAC, fbn('TipoOp'))
  ACT(ap:FAC, fbn('Cliente1'))
  ACN(aq:FAC, fbn('Cantidad'))
  ACD(ar:FAC, fbn('FechaOp'))
  ACD(as:FAC, fbn('FechaVto'))
  ACD(at:FAC, fbn('FechaPago'))
  ACD(au:FAC, fbn('FechaAltaSisExterno'))
  ACT(av:FAC, fbn('ConceptoFail'))

  if EqStr(Val(ao:FAC),'TIC')
    ACT(aa:FAC, 'BUY')
  endif  
  if EqStr(Val(ao:FAC),'TIV')
    ACT(aa:FAC, 'SELL')
  endif  
  ACT(ab:FAC, Fecha(Val(ar:FAC),'MM/DD/YY'))
  ACT(ac:FAC, Fecha(Val(at:FAC),'MM/DD/YY'))
  ACT(ad:FAC, BuscarCampo('CLIENTES','RazonSocial','Codigo',Val(ap:FAC)))
  SQL.ADD("Select Cantidad CantidadM from "~DBO~".MOVPENDIENTES ")
  SQL.ADD(" where NrOperacion = '"~Val(an:FAC)~"' ")
  SQL.ADD("   and Especie =  '"~Val(ae:FAC)~"' ")
  SQL.ADD("   and NrSaldo = 1 ")
  recorrer SQL
    DFA
    SCN(af:FAC, ABS(fbn('CantidadM')))
    SCN(ba:FAC, 1)
    SCN(bb:FAC, fbn('CantidadM'))
  proximo
  SQL.ADD("Select Cantidad CantidadM from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD(" where NrOperacion = '"~Val(an:FAC)~"' ")
  SQL.ADD("   and Especie =  '"~Val(ae:FAC)~"' ")
  SQL.ADD("   and NrSaldo in (1,31) ")
  SQL.ADD("   and FechaMov>='"~IdxDate(Dialogo.Fecha1)~"' ")
  recorrer SQL
    DFA
    SCN(af:FAC, ABS(fbn('CantidadM')))
    SCN(bc:FAC, 1)
    SCN(bd:FAC, fbn('CantidadM'))
  proximo
  ACN(af:FAC, Val(af:FAC)/1000000)
  ACN(ag:FAC, Val(af:FAC)*Val(ah:FAC))
  ACN(aw:FAC, CotizacionC(Val(ai:FAC),,,,Dialogo.Fecha1,1,SI,'USD'))
  ACN(aj:FAC, Val(ag:FAC)*Val(aw:FAC))
  ACT(ak:FAC, Fecha(Val(as:FAC),'MM/DD/YY'))
  ACN(al:FAC, Dialogo.Fecha1-Val(at:FAC))
  ACT(am:FAC, BuscarCampo('CONCEPTOSFAILS','Descripcion','Codigo',Val(av:FAC)))

  if Val(al:FAC)<=3
    ACN(ax:FAC, 0)
  else
    ACN(ax:FAC, 1)
  endif
proximo
if Val(z:1)>0
*  OrdenarFilas()
endif


AgregarBMP(a1,Exe('LOGO'),80)
SetFilaActual(4)
ACT(f:FAC, 'Date')
ACT(g:FAC, Fecha(Dialogo.Fecha1,'MM/DD/YY'))
SetFont(f:FAC..g:FAC,1)

SetFilaActual(FAC+2)
if Dialogo.radio1=0
  ACT(a:FAC, 'Fails Report up to three days')
else
  ACT(a:FAC, 'Fails report more than three days')
endif
SetFont(a:FAC,2)

SetFilaActual(FAC+2)
ACT(a:FAC, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))

SetFilaActual(FAC+2)
ACT(a:FAC+1, 'Type Op')
ACT(b:FAC+1, 'Trade Date')
ACT(c:FAC+1, 'S. Date')
ACT(d:FAC+1, 'Client Name')
ACT(e:FAC+1, 'Security')
ACT(f:FAC+1, 'Quantity')
ACT(g:FAC+1, 'Cash Ampount')
ACT(h:FAC+1, 'Price')
ACT(i:FAC,   'Currency')
ACT(i:FAC+1, 'Code')
ACT(j:FAC,   'Marcket')
ACT(j:FAC+1, 'Value')
ACT(k:FAC,   'New Expected')
ACT(k:FAC+1, 'Settlement Date')
ACT(l:FAC  , 'Q. Days failed')
ACT(l:FAC+1, 'Until Today')
ACT(m:FAC+1, 'Comments')
ACT(n:FAC,   'FPA')
ACT(n:FAC+1, 'Trade N')
SetFont(a:FAC..n:FAC+1,2)
AlinearCeldas(n:FAC..n:FAC+1,'C')
AgregarMarco(a:FAC..n:FAC+1,1,0,Exe('COLOR6'))
SetFilaActual(FAC+1)

if val(z:1)>0
  recorrer&i 2,Val(z:1)+1
    if Val(ax:&i)=Dialogo.Radio1
      IFA
      ACT(a:FAC, Val(aa:&i))
      ACT(b:FAC, Val(ab:&i))
      ACT(c:FAC, Val(ac:&i))
      ACT(d:FAC, Val(ad:&i))
      ACT(e:FAC, Val(ae:&i))
      ACN(f:FAC, Val(af:&i))
      ACN(g:FAC, Val(ag:&i))
      ACN(h:FAC, Val(ah:&i))
      ACT(i:FAC, Val(ai:&i))
      ACN(j:FAC, Val(aj:&i))
      ACT(k:FAC, Val(ak:&i))
      ACN(l:FAC, Val(al:&i))
      ACT(m:FAC, Val(am:&i))
      ACT(n:FAC, Val(an:&i))
      FormatoCeldas(l:FAC, Exe('F0'))
    endif
  proximo
endif

SetFilaActual(FAC+2)
ACT(a:FAC, '')

ACO(1,6)
ACO(2,7)
ACO(3,7)
ACO(4,20)
ACO(5,7)
ACO(6,9)
ACO(7,9)
ACO(8,7)
ACO(9,7)
ACO(10,7)
ACO(11,9)
ACO(12,9)
ACO(13,20)
ACO(14,8)

SetFilaActual(FAC+2)

Impresion(1,2)
SetPrintFit(3,65)
LimitesVision(n:FAC)
RangoTitulo(a:1..n:fac+1, 10)
