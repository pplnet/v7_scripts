ACT(a:fac,'ENTIDAD')
ACT(b:fac,'F.INICIO')
ACT(c:fac,'CAPITAL')
ACT(d:fac,'TASA')
ACT(e:fac,'PLAZO')
ACT(f:fac,'VTO Comis')
ACT(g:fac,'          Operacion')
ACT(i:fac,'Vto.Final')
ACT(j:fac,'Ints. Comis.')
ACT(k:fac,'NrOper.')
SetFont(a:fac..k:fac,2)
AlinearCeldas(a:fac..k:fac, 'C')
ACN(fi1,fac)

**- SELECCIONO GARANTIAS (a corto plazo)
SQL.ADD(" Select O.Cliente1, O.Especie, O.FechaEx2 , O.TipoOp, O.NrOperacion, ")
SQL.ADD("  O.FechaOp, O.Precio1, O.Plazo, O.ObservacDoc,O.ImpComMer1, O.ContraEspecie2, ")
SQL.ADD("  O.Cantidad from "~DBO~".OPERACIONES  O ")
SQL.ADD("  Where TipoOp  in ('GA','GAMV') ")
SQL.ADD("  and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  O.FechaVto  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("  order by O.Especie, O.Cliente1, O.FechaOp ")
*- zz1 tiene la suma del Capital (campo Cantidad)
ACN(zz1,0)

** ATENCION: La operacion se expresa en una moneda pero los gastos tienen su propia
**           moneda que puede ser igual a distinta a la de la operacion
Recorrer SQL

   if Not EqStr(fbn['Especie'],Val(zz3))
      * az1: Cotizacion 
      ACN(az1,CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio1=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      if Not EqStr(fbn['Especie'],fbn['ContraEspecie'])
         ** moneda en que se expresan los gastos
         ACN(az2,CotizacionC(fbn['ContraEspecie2'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio1=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      else
            ACN(az2, Val(az1))
      endif
   endif

   ACT(a:fac,FBN['Cliente1'])
   ACT(b:fac,FBN['FechaOp'])
   ACN(c:fac,FBN['Cantidad']*Val(az1))
   ACN(d:fac,FBN['Precio1'])
   ACT(e:fac,FBN['Plazo'])
   ACT(f:fac,FBN['FechaEx2'])
   ACT(g:fac,FBN['ObservacDoc'])
   ACT(i:fac,FBN['FechaEx2'])
   ACN(j:fac,FBN['ImpComMer1']*Val(az2))
   ACT(k:fac,FBN['NrOperacion'])
   ACLO(k:fac,FBN['NrOperacion'])
   SCN(zz1,Val(c:fac))
Proximo
