ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"             ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Invalida';NO;Fsys;
  Cliente1   : "Entidad"           ;;;
  Radio1     : "Expresado|ARP|USD" ;;;;;;;;;0
  Lista1     : 'Vehiculo'          ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".VEHICULOS ");
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)

ACD(FE:2, Dialogo.Fecha1)
ACD(FE:3, FinDeMes(SumarMeses(Fecha(Val(FE:2)), 5, 0), SI))

AgregarMarco(d:fac..f:fac,1,0)
ACT(d:fac, '      DEUDA FINANCIERA')
SetFont(d:fac,3)

ACD(j:fac, Dialogo.Fecha1)

SetFilaActual(fac+2)
AgregarMarco(a:fac..b:fac,1,0,Exe('COLOR6'))
***---ACT(a:fac, '  P.A.E. Branch  ')
SetFont(a:fac,2)

******************************* SECCION TRADE LOANS *****************************
SetFilaActual(fac+2)
ACT(a:fac, '1.-  TRADE LOANS')
SetFont(a:fac,2)
ifa
AgregarMarco(a:fac..k:fac,1,0)
ACT(a:fac,'ENTIDAD')
ACT(b:fac,'F.INICIO')
ACT(c:fac,'CAPITAL')
ACT(d:fac,'TASA')
ACT(e:fac,'PLAZO')
ACT(f:fac,'VTO')
ACT(g:fac,'Tasa Base')
ACT(h:fac,'Local Fee')
ACT(i:fac,'Vto. Final')
ACT(j:fac,'Ints. Vto.')
ACT(k:fac,'NrOper.')
SetFont(a:fac..k:fac,2)
AlinearCeldas(a:fac..k:fac, 'C')
*- Guardo fila actual
ACN(fi1,fac)
ACN(ti1,fac)
ifa
ACT(a:fac, 'Short/Long Term')

** Selecciono prestamos a corto plazo => zx1=0
ACN(zx1,0)
** Selecciono solo prestamos en Pesos
ACN(zx2,1)
(.'PRESTCORTO'.)

*- zz1 tiene la suma del Capital (campo Cant)
ACN(zz1,0)

Recorrer SQL

   if Not EqStr(fbn['Especie'],Val(zz3))
      * az1: Cotizacion 
      ACN(az1,CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio1=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      ACT(zz3,fbn['Especie'])
   endif

   ACT(a:fac,FBN['Cliente1'])
   ACT(b:fac,FBN['FechaOp'])
   ACN(c:fac,FBN['Cant']*Val(az1))
   ACN(d:fac,FBN['Tasa'])
   ACT(e:fac,FBN['Plazo'])
   ACT(f:fac,FBN['FechaVto'])
   ACT(g:fac,FBN['TipoTasa']~' + '~FBN['Spread'] )
   ACN(j:fac,FBN['Interes']*Val(az1))
   ACT(k:fac,FBN['NrOperacion'])
   ACLO(k:fac,FBN['NrOperacion'])
   SCN(zz1,Val(c:fac))
Proximo
AgregarMarco(a:Val(fi1)..k:fac,1,2)
ifa
ACT(b:fac, 'TOTAL')
ACN(c:fac,Val(zz1))
FormatoCeldas(c:Val(fi1)..c:fac,Exe('F2'))
FormatoCeldas(d:Val(fi1)..d:fac,Exe('F7'))
FormatoCeldas(j:Val(fi1)..j:fac,Exe('F2'))
SetFont(a:Val(fi1)+1..k:fac,1)
SetFont(b:fac..c:fac,2)
AgregarMarco(c:fac..c:fac,1,0)


