   ACT(a:fac,FBN['Cliente1'])
   ACT(b:fac,FBN['FechaOp'])
   ACN(c:fac,FBN['Cant']*Val(az1))
   ACN(d:fac,FBN['Tasa'])
   ACT(e:fac,FBN['Plazo'])
   ACT(f:fac,FBN['FechaVto'])
   ACT(h:fac,FBN['TipoOp'] )
