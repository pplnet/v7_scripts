*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     :'D.Concert.' ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2     :'H.Concert.' ; 2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Radio1     :'Estado|Confirmadas|Anuladas|Todas'; 3;1;;;;;;;2;
  Radio2     :'Procesados|Si|No|Todos'; 4;1;;;;;;;2;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AgregarBMP(a1,Exe('LOGO'),80)
SetFilaActual(4)
ACT(a:FAC, 'Operaciones A3 recibidas')
SetFont(a:FAC,3)

ACT(a:FAC+1, 'F.Concertacion Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)

ACT(a:FAC+3,'Estado: '~iif(Dialogo.Radio1=0,'Confirmadas',iif(Dialogo.Radio1=1,'Anuladas','Todas')))
ACT(a:FAC+4,'Procesados: '~iif(Dialogo.Radio2=0,'Si',iif(Dialogo.Radio2=1,'No','Todos')))


SetFilaActual(FAC+5)
ACN(w:1,FAC)

ACT(a:FAC, 'Boleta')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Especie FPA')
ACT(d:FAC, 'Moneda')
ACT(e:FAC, 'SettlCurrency')
ACT(f:FAC, 'TipoOp')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio')
ACT(i:FAC, 'Comitente')
ACT(j:FAC, 'Cliente FPA')
ACT(k:FAC, 'Fecha Op.')
ACT(l:FAC, 'Fecha Vto')
ACT(m:FAC, 'Hora')
ACT(n:FAC, 'Procesado')
ACT(o:FAC, 'Op.Relacionada')
ACT(p:FAC, 'Fec/hora de carga')
ACT(q:FAC, 'Observaciones')


AlinearCeldas(j:FAC..k:FAC,'D')
SetFont(a:5..z:FAC,2)
AgregarMarco(a:FAC..q:FAC,1,0,Exe('COLOR6'))

SQL.ADD("Select O.*,C.Codigo ClienteFPA from "~DBO~".OPA3 O ")
SQL.ADD("             left  join "~DBO~".CLIENTES C ")
SQL.ADD("            on O.IdComitente  = C.NrRofex ")
SQL.ADD("Where  O.Fecha     between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
if Dialogo.Radio1=0
   SQL.ADD(" O.TrdRptStatus=0 ")
else
   if Dialogo.Radio1=1
      SQL.ADD(" O.TrdRptStatus=3 ")
   endif
endif
if Dialogo.Radio2=0
   SQL.ADD("  and O.Procesado=1 ")
else
   if Dialogo.Radio2=1
      SQL.ADD("  and O.Procesado=0 ")
   endif
endif
SQL.ADD(" Order by  Procesado, TrdRptStatus ")
watch(sql.batch)

Recorrer SQL
   
   ACT(a:fac, FBN['Boleta'])
   ACT(b:fac, FBN['Posicion'])
   ACT(c:fac, SQL("Select Especie From "~DBO~".ESPECIESMERCADOS Where Mercado = '"~VAR('AMBMAE')~"' and Codigo = '"~fbn('Posicion')~"' "))
   ACT(d:fac, FBN['Currency'])
   ACT(e:fac, FBN['SettlCurrency'])
   ACT(f:fac, iif(FBN['IdCpraVta']=1,'Compra','Venta'))
   ACN(g:fac, FBN['Cantidad'] )
   ACN(h:fac, FBN['Precio'] )
   ACT(i:fac, FBN['IdComitente'] )
   ACT(j:fac, FBN['ClienteFPA'] )
   ACD(k:FAC, FBN['Fecha'])
   ACD(l:FAC, FBN['Vto'])
   ACT(m:FAC, FBN['Hora'])
   ACT(n:fac, iif(FBN['Procesado']=1,'Si','No'))
   ACT(o:fac, FBN['NrOperacion'])
   ACT(p:fac, FBN['FechaModificacion'])
   ACT(q:fac, FBN['Warning'])
   
Proximo

if FAC=Val(w:1)
  IFA
  ACT(a:FAC, 'No existen registros')
  SetFont(a:fac,2)
else
  SetFont(a:Val(w:1)+1..z:fac,1)
  FormatoCeldas(j:Val(w:1)+1..j:fac,Exe('F2'))
  FormatoCeldas(k:Val(w:1)+1..k:fac,Exe('F9'))
endif

IF NO
SetFilaActual(FAC+2)

ACT(a:FAC, 'Registros de OPSIOPEL que no generaron operaciones')
SetFont(a:FAC,3)

SetFilaActual(FAC+2)
ACN(w:2,FAC)

ACT(a:FAC, 'Tipo Negociacion')
ACT(b:FAC, 'Secuencia')
ACT(c:FAC, 'Fecha Op.')
ACT(d:FAC, 'Plazo')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Rueda')
ACT(h:FAC, 'Agente')
ACT(i:FAC, 'Cliente')
ACT(j:FAC, 'Cantidad')
ACT(k:FAC, 'Precio')
ACT(l:FAC, 'Corredor')

AlinearCeldas(j:FAC..k:FAC,'D')
SetFont(a:FAC..z:FAC,2)
AgregarMarco(a:FAC..l:FAC,1,0,Exe('COLOR6'))
ACT(v:5, VAR('AGESIOP'))

*******************************
* Rueda de Ofertas con agentes
*******************************
SQL.ADD("Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoRegistro in ('0105','0205')  ")
SQL.ADD("    and CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGTIT'))~")  ")
SQL.ADD("    and CodigoRueda Not in ("~Pipe2Comillas(Var('RUELICI'))~") ")
SQL.ADD("    and CodigoRueda Not in ("~Pipe2Comillas(Var('RUECORR'))~") ")
SQL.ADD("    and Fecha       between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("    and Carga        is null                                     ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                            ")
Recorrer SQL
  ACT(a:FAC, 'Rueda Ofertas')
  ACT(b:FAC, fbn('Secuencia'))
  if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05')
    ACT(aa:FAC, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
    ACD(c:FAC, Fecha(Val(aa:FAC)))
  endif
  ACN(d:FAC, Num(fbn('Plazo')))
  ACT(e:FAC, fbn('CodigoTitulo'))
  if EqStr(fbn('Moneda'),'D')
    ACT(f:FAC, 'USD')
  else
    if EqStr(fbn('Moneda'),'$')
      ACT(f:FAC, 'ARP')
    endif
  endif
  ACT(g:FAC, fbn('CodigoRueda'))
  if EqStr(fbn('Agente'),Val(v:5))
    ACT(h:FAC, fbn('AgenteContra'))
  else
    if EqStr(fbn('AgenteContra'),Val(v:5))
      ACT(h:FAC, fbn('Agente'))
    endif
  endif
  ACT(i:FAC, fbn('Cliente'))
  ACN(j:FAC, fbn('Cantidad'))
  ACN(k:FAC, fbn('Precio'))
Proximo

**************************
* Corredores
**************************
SQL.ADD("Select * from "~DBO~".OPSIOPEL ")
SQL.ADD("  where CodigoRegistro in ('0301','0303','0401','0403')       ")
SQL.ADD("    and CodigoNego  in ("~Pipe2Comillas(Var('TIPONEGTIT'))~") ")
SQL.ADD("    and CodigoRueda in ("~Pipe2Comillas(Var('RUECORR'))~")    ")
SQL.ADD("    and Fecha       >= '"~IdxDate(Habiles(Dialogo.Fecha1,-Var('FVALORMAX'),'ARG'))~"' ")
SQL.ADD("    and Fecha       <= '"~IdxDate(Dialogo.Fecha2)~"'                     ")
SQL.ADD("    and Carga        is null                                  ")
SQL.ADD("    and IsNull(Procesado,'0') = '0'                           ")
Recorrer SQL
  ACT(a:FAC, 'Corredores')
  ACT(b:FAC, fbn('Secuencia'))
  if Incluido(Copy(fbn('CodigoRegistro'),3,2),'01|03')
    ACT(aa:FAC, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
    ACD(c:FAC, Fecha(Val(aa:FAC)))
  endif
  ACN(d:FAC, Num(fbn('Plazo')))
  ACT(e:FAC, fbn('CodigoTitulo'))
  if EqStr(fbn('Moneda'),'D')
    ACT(f:FAC, 'USD')
  else
    if EqStr(fbn('Moneda'),'$')
      ACT(f:FAC, 'ARP')
    endif
  endif
  ACT(g:FAC, fbn('CodigoRueda'))
  if EqStr(fbn('Agente'),Val(v:5))
    ACT(h:FAC, fbn('AgenteContra'))
  else
    if EqStr(fbn('AgenteContra'),Val(v:5))
      ACT(h:FAC, fbn('Agente'))
    endif
  endif
  ACT(i:FAC, fbn('Cliente'))
  ACN(j:FAC, fbn('Cantidad'))
  ACN(k:FAC, fbn('Precio'))
  ACT(l:FAC, Copy(fbn('Corredor'),2,3))
Proximo
if FAC=Val(w:2)
  IFA
  ACT(a:FAC, 'No existen registros')
  SetFont(a:fac,2)
else
  SetFont(a:Val(w:2)+1..z:fac,1)
  FormatoCeldas(j:Val(w:2)+1..j:fac,Exe('F2'))
  FormatoCeldas(k:Val(w:2)+1..k:fac,Exe('F9'))
endif
ENDIF

ACO(1,8)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(7,7)
ACO(8,7)
ACO(9,8)
ACO(10,12)
ACO(11,10)
ACO(14,8)
ACO(15,10)
ACO(16,14)
ACO(17,30)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:fac,'FIN DEL INFORME')
SetFont(a:fac,2)
SetPrintFit(3,65)
LimitesVision(q:FAC)
RangoTitulo(a:1..q:fac+1, 10)
