CrearDialogo
  Fecha1: 'Fecha Desde';;;;;;;;;PriDeMes(FSys)
  Fecha2: 'Fecha Hasta';;;;;;;;;FSys
  Vehiculo1: 'Vehiculo'
  Book1: 'Book'
  Especie1: 'Especie'
  Radio1: 'Moneda|ARP|USD|Local|Mesa';;;;;;;;;0
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,BU')
CrearFont(4, 'Arial,9,B')

SetFilaActual(1)

ACT(E:fac, 'Cartera de Inversiones')

SetFont(E:fac, 3)

ACT(a3, 'F.Desde: '~Dialogo.Fecha1)
ACT(a4, 'F.Hasta: '~Dialogo.Fecha2)

SQL.ADD("Select distinct g1.v v, g1.b b, g1.e e, g1.t t, g1.i i, g1.c c from (")
SQL.ADD("select distinct P.Vehiculo v, P.Book b, P.Especie e, P.TipoNegocio t, ")
SQL.ADD("       (case when E.Tipo='FON' then 'FCI' when E.Tipo='PUB' then 'Tit. Pub.' when E.Tipo='PRI' then 'Acciones' when E.Tipo='ONE' then 'ONs' end) i, '' c ")
SQL.ADD("  from "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie=E.Codigo and P.NrSaldo=2 and P.Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and P.Fecha<='"~IdxDate(Dialogo.Fecha2)~"' and P.TipoNegocio<>'FX'")
if NoVacio(Dialogo.Vehiculo1)
  ACT(a5, 'Vehiculo: '~Dialogo.Vehiculo1)
  SQL.ADD("and P.Vehiculo='"~Dialogo.Vehiculo1~"'")
else
  ACT(a5, 'Vehiculo: Todos')
endif
if NoVacio(Dialogo.Book1)
  ACT(a6, 'Book: '~Dialogo.Book1)
  SQL.ADD("and P.Book='"~Dialogo.Book1~"'")
else
  ACT(a6, 'Book: Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a7, 'Especie: '~Dialogo.Especie1)
  SQL.ADD("and P.Especie='"~Dialogo.Especie1~"'")
else
  ACT(a7, 'Especie: Todos')
endif
if Dialogo.Radio1=0
*  ACT(a8, 'Moneda Exp: Fuerte')
*  ACT(ac:3, BuscarCampo('VARIABLES','Valor','Codigo', 'MONEFUERTE'))
  ACT(a8, 'Moneda Exp: ARP Contable')
  ACT(ac:3, 'ARP')
else
  if Dialogo.Radio1=1
*    ACT(a8, 'Moneda Exp: Consolid')
*    ACT(ac:3, BuscarCampo('VARIABLES','Valor','Codigo', 'MONEGRUPO'))
    ACT(a8, 'Moneda Exp: USD')
    ACT(ac:3, 'USD')
  else
    if Dialogo.Radio1=2
      ACT(a8, 'Moneda Exp: Local')
    else
      ACT(a8, 'Moneda Exp: ARP Mesa')
      ACT(ac:3, 'ARP')
    endif
  endif
endif
SQL.ADD("union")
SQL.ADD("Select distinct Vehiculo1 v, Book1 b, 'ZZ' e, 'ZZ' t, 'PF' i, Cliente1 c from "~DBO~".OPERACIONES where TipoOp IN ('MMCPM','MMCP') and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"'")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo1='"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("and Book1='"~Dialogo.Book1~"'")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Especie='"~Dialogo.Especie1~"'")
endif
SQL.ADD(") g1")
SQL.ADD("order by v, b, t, e")
watch(sql.batch)
setFilaActual(10)  
ACT(a:fac, 'Activo')
ACT(b:fac, 'VN Inicial')
ACT(c:fac, 'VN Final')
ACT(d:fac, 'Px Promedio')
ACT(e:fac, 'Monto invertido')
ACT(e:fac+1, 'Mon.Origen')
ACT(f:fac+1, 'Mon.Expr.')
ACT(g:fac, 'Px Mdo.')
ACT(h:fac, 'Ints.Dev.')
ACT(i:fac, 'Valor Mercado')
ACT(i:fac+1, 'Mon.Origen')
ACT(j:fac+1, 'Mon.Expr.')
ACT(k:fac, 'Rdo.Tenencia')
ACT(k:fac+1, 'Realizado')
ACT(l:fac+1, 'No Realizado')
ACT(m:fac, 'Ints/Dividendos')
ACT(m:fac+1, 'Realizado')
ACT(n:fac+1, 'No Realizado')
ACT(o:fac, 'Dif.Cambio')
ACT(o:fac+1, 'Realizado')
ACT(p:fac+1, 'No Realizado')
ACT(q:fac, 'Tot.Realizado')
ACT(r:fac, 'Tot.No Realizado')
ACT(s:fac, 'Total')
ACT(t:fac,' Rdo. Tenencia')
ACT(t:fac+1,'Precio Reset')
ACT(u:fac,' Intereses')
ACT(u:fac+1,'Precio Reset')
ACT(v:fac,'Diferencia Cambio')
ACT(v:fac+1,'Precio Reset')

AgregarMarco(a:fac..v:fac,1,0,Exe('COLOR'))
AgregarMarco(e:fac+1..f:fac+1,1,0,Exe('COLOR'))
AgregarMarco(i:fac+1..j:fac+1,1,0,Exe('COLOR'))
AgregarMarco(k:fac+1..l:fac+1,1,0,Exe('COLOR'))
AgregarMarco(m:fac+1..n:fac+1,1,0,Exe('COLOR'))
AgregarMarco(o:fac+1..p:fac+1,1,0,Exe('COLOR'))
AgregarMarco(t:fac+1..v:fac+1,1,0,Exe('COLOR'))
* extra, volar despues de verificar los calculos
ACT(w:fac, 'TCIni')
ACT(x:fac, 'TCFin')
ACT(y:fac, 'MO')
ACT(z:fac, 'ME')
ACT(aa:fac, 'TCVto')
ACT(ad:fac, 'Rdo.Tenencia (ME)')
ACT(ad:fac+1, 'Realizado')
ACT(ae:fac+1, 'No Realizado')
ACT(af:fac, 'Ints/Dividendos (ME)')
ACT(af:fac+1, 'Realizado')
ACT(ag:fac+1, 'No Realizado')
ACT(ah:fac, 'Dif.Cambio (ME)')
ACT(ah:fac+1, 'Realizado')
ACT(ai:fac+1, 'No Realizado')
AgregarMarco(ad:fac..ai:fac,1,0,Exe('COLOR8'))
AgregarMarco(ad:fac+1..ae:fac+1,1,0,Exe('COLOR8'))
AgregarMarco(af:fac+1..ag:fac+1,1,0,Exe('COLOR8'))
AgregarMarco(ah:fac+1..ai:fac+1,1,0,Exe('COLOR8'))


ACO(1, 15)
ACO(2, 11)
ACO(3, 11)
ACO(4, 11)
ACO(5, 11)
ACO(6, 11)
ACO(7, 11)
ACO(8, 11)
ACO(9, 11)
ACO(10, 11)
ACO(11, 11)
ACO(12, 11)
ACO(13, 11)
ACO(14, 11)
ACO(15, 11)
ACO(16, 11)
ACO(17, 11)
ACO(18, 11)
ACO(19, 11)

**Nuevos totales
ACO(20, 11)
ACO(21, 11)
ACO(22, 11)


* extra, volar despues de verificar los calculos
ACO(30, 11)
ACO(31, 11)
ACO(32, 11)
ACO(33, 11)
ACO(34, 11)
ACO(35, 11)

ACN(co:1,1)
ACN(co:0,0)
ACN(cm:0,0)

setFilaActual(12)
recorrer SQL
  if Vacio(Val(ac:1)) o Vacio(Val(ac:2))
     * pongo inicios
      ACT(ac:1, fbn('v'))
      if Dialogo.Radio1=2
        ACT(ac:3, BuscarCampo('VEHICULOS','Alias4','Codigo', Val(ac:1))) 
      endif
      ACT(a:fac, 'Vehiculo: '~fbn('v'))
      AgregarMarco(a:fac..v:fac,1,0,Exe('COLOR8'))
      ifa
      ACT(ac:2, fbn('b'))
      ACT(a:fac, 'Book: '~fbn('b'))
      AgregarMarco(a:fac..v:fac,1)
      ifa
  else
    if not EqStr(fbn('v'), Val(ac:1)) 
      * pongo totales de book y vehiculo, inicializo book y vehiculo
      ACT(a:fac, 'Total Book')
      ACN(f:fac, Val(ai:1))
      ACN(j:fac, Val(aj:1))
      ACN(k:fac, Val(ak:1))     
      ACN(l:fac, Val(al:1))
      ACN(t:fac,Val(k:fac)+Val(l:fac))
      ACN(m:fac, Val(am:1))
      ACN(n:fac, Val(an:1))
      ACN(u:fac,Val(m:fac)+Val(n:fac))
      ACN(o:fac, Val(ao:1))
      ACN(p:fac, Val(ap:1))
      ACN(v:fac,Val(o:fac)+Val(p:fac))
      ACN(q:fac, Val(aq:1))
      ACN(r:fac, Val(ar:1))
      ACN(s:fac, Val(as:1))
      ACN(ai:1, 0)
      ACN(aj:1, 0)
      ACN(ak:1, 0)
      ACN(al:1, 0)
      ACN(am:1, 0)
      ACN(an:1, 0)
      ACN(ao:1, 0)
      ACN(ap:1, 0)
      ACN(aq:1, 0)
      ACN(ar:1, 0)
      ACN(as:1, 0)
      AgregarMarco(a:fac..v:fac,1)
      ifa
      ACT(a:fac, 'Total Vehiculo')
      ACN(f:fac, Val(ai:2))
      ACN(j:fac, Val(aj:2))
      ACN(k:fac, Val(ak:2))
      ACN(l:fac, Val(al:2))
      ACN(t:fac,Val(k:fac)+Val(l:fac))
      ACN(m:fac, Val(am:2))
      ACN(n:fac, Val(an:2))
      ACN(u:fac,Val(m:fac)+Val(n:fac))
      ACN(o:fac, Val(ao:2))
      ACN(p:fac, Val(ap:2))
      ACN(v:fac,Val(o:fac)+Val(p:fac))
      ACN(q:fac, Val(aq:2))
      ACN(r:fac, Val(ar:2))
      ACN(s:fac, Val(as:2))
      ACN(ai:2, 0)
      ACN(aj:2, 0)
      ACN(ak:2, 0)
      ACN(al:2, 0)
      ACN(am:2, 0)
      ACN(an:2, 0)
      ACN(ao:2, 0)
      ACN(ap:2, 0)
      ACN(aq:2, 0)
      ACN(ar:2, 0)
      ACN(as:2, 0)
      AgregarMarco(a:fac..v:fac,1,0,Exe('COLOR8'))
      ifa
      ifa
      ACT(ac:1, fbn('v'))
      if Dialogo.Radio1=2
        ACT(ac:3, BuscarCampo('VEHICULOS','Alias4','Codigo', Val(ac:1))) 
      endif
      ACT(a:fac, 'Vehiculo: '~fbn('v'))
      AgregarMarco(a:fac..v:fac,1,0,Exe('COLOR8'))
      ifa
      ACT(ac:2, fbn('b'))
      ACT(a:fac, 'Book: '~fbn('b'))
      AgregarMarco(a:fac..v:fac,1)
      ifa
    else
      if not EqStr(fbn('b'), Val(ac:2))
        * pongo totales de book, inicializo book
        ACT(a:fac, 'Total Book')
        ACN(f:fac, Val(ai:1))
        ACN(j:fac, Val(aj:1))
        ACN(k:fac, Val(ak:1))
        ACN(l:fac, Val(al:1))
        ACN(t:fac,Val(k:fac)+Val(l:fac))
        ACN(m:fac, Val(am:1))
        ACN(n:fac, Val(an:1))
        ACN(u:fac,Val(m:fac)+Val(n:fac))
        ACN(o:fac, Val(ao:1))
        ACN(p:fac, Val(ap:1))
        ACN(v:fac,Val(o:fac)+Val(p:fac))
        ACN(q:fac, Val(aq:1))
        ACN(r:fac, Val(ar:1))
        ACN(s:fac, Val(as:1))
        ACN(ai:1, 0)
        ACN(aj:1, 0)
        ACN(ak:1, 0)
        ACN(al:1, 0)
        ACN(am:1, 0)
        ACN(an:1, 0)
        ACN(ao:1, 0)
        ACN(ap:1, 0)
        ACN(aq:1, 0)
        ACN(ar:1, 0)
        ACN(as:1, 0)
        AgregarMarco(a:fac..v:fac,1)
        
        ACT(bk:Val(co:1),Val(ac:2))
        ACN(mo:Val(co:1),Val(j:fac))
        SCN(co:1,1)
        
        ifa
        ACT(ac:2, fbn('b'))
        ACT(a:fac, 'Book: '~fbn('b'))
        AgregarMarco(a:fac..v:fac,1)
        ifa
      endif        
    endif
  endif
  
  ***---aca  SCN(co:0,1)
  ** guardo en celda "at" el Instrumento (campo Tipo de Especies)
***---aca  ACT(at:Val(co:0), fbn('i'))
  ** guardo en celda "au" el cliente1 de los PF
***---aca  ACT(au:Val(co:0), fbn('c'))
  ** guardo en celda "av" la Especie
  ***---acaACT(av:Val(co:0), fbn('e'))
  
  if EqStr(fbn('e'), 'ZZ')
  SCN(zz:0,1)
  SQL.ADD("Select * from "~DBO~".OPERACIONES where TipoOp IN ('MMCPM','MMCP') and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and Vehiculo1='"~fbn('v')~"' and Book1='"~fbn('b')~"'")
    if NoVacio(Dialogo.Especie1)
      SQL.ADD("and Especie='"~Dialogo.Especie1~"'")
    endif
    SQL.ADD(" order by FechaVto")
    recorrer SQL
      dfa
      ACT(a:fac, fbn('Cliente1')~' - '~fbn('FechaVto'))
      ACLO(a:fac, fbn('NrOperacion'))
      ACN(ac:4, fbn('FechaOp'))
      ACN(ac:5, fbn('FechaVto'))
      if Dialogo.Radio1=3
        ACN(ac:7, SQL("select "~DBO~".ConversionMonedaMesa('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Val(ac:3)~"', 1)"))
        ACN(z8, SQL("select "~DBO~".ConversionMonedaMesa('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(ac:3)~"', 1)"))
      else
        ACN(ac:7, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Val(ac:3)~"', 1)"))
        ACN(ac:8, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(ac:3)~"', 1)"))
      endif
      acn(ab:fac, fac)
      acn(w:Fac, val(ac:7))
      acn(x:fac, val(ac:8))
      act(y:fac, fbn('Especie'))
      act(z:fac, Val(ac:3))
      ACT(ac:10, fbn('Especie'))
      
      ** guardo en celda "aw" la Moneda en que cotiza
      SCN(cm:0,1)
      ACT(aw:Val(cm:0), Val(y:fac))
      ACT(XR:1, fbn('Cliente1'))
      SQL.ADD("Select * from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' and Fecha2>='"~IdxDate(Dialogo.Fecha1)~"'")
      recorrer SQL
        dfa
        if fbn('Fecha1')<=Dialogo.Fecha1
          ACN(b:fac, fbn('Cantidad2'))
          ACN(ac:4, Dialogo.Fecha1)
            * estos son los intereses previos al inicio del periodo, que son los que sufren DC, solo hay que multiplicarlos por el TC al fin (realizado)/vto(no realizado) menos TC al inicio
          ACN(ac:6, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha1-fbn('Fecha1')))
          if fbn('Fecha2')>Dialogo.Fecha2
            ACN(ac:9, Val(ac:8))   
            SCN(p:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
            SCN(v:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
          else
            if Dialogo.Radio1=3
              ACN(ac:9, SQL("select "~DBO~".ConversionMonedaMesa('"~Val(ac:10)~"', '"~IdxDate(fbn('Fecha2'))~"', '"~Val(ac:3)~"', 1)"))
            else
              ACN(ac:9, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Val(ac:10)~"', '"~IdxDate(fbn('Fecha2'))~"', '"~Val(ac:3)~"', 1)"))
            endif
            SCN(o:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
            SCN(v:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
          endif
          acn(aa:fac, val(ac:9))
        endif

        if fbn('Fecha2')>=Dialogo.Fecha2
          SCN(c:fac, fbn('Cantidad2'))
          SCN(d:fac, fbn('Precio2'))
          ACN(ac:5, Dialogo.Fecha2)
          SCN(h:fac, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha2-fbn('Fecha1')))
            * convertido por TC
          SCN(n:fac, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha2-Val(ac:4))*Val(ac:8))
          SCN(u:fac, fbn('Cantidad3')/fbn('Plazo1')*(Dialogo.Fecha2-Val(ac:4))*Val(ac:8))
        else
            * convertido por TC
          SCN(m:fac, fbn('Cantidad3')/fbn('Plazo1')*(fbn('Fecha2')-Val(ac:4))*Val(ac:8))
          SCN(u:fac, fbn('Cantidad3')/fbn('Plazo1')*(fbn('Fecha2')-Val(ac:4))*Val(ac:8))
        endif
      proximo
      ACN(e:fac, fbn('Cantidad'))
      ACN(f:fac, Val(E:fac)*Val(ac:8))

      SCN(co:0,1)
  ** guardo en celda "at" el Instrumento (campo Tipo de Especies)
  ACT(at:Val(co:0), 'PF')
  ** guardo en celda "au" el cliente1 de los PF
  ACT(au:Val(co:0), Val(XR:1))
  ** guardo en celda "av" la Especie
  ACT(av:Val(co:0), 'ZZ')
SCN(AX:Val(co:0), Val(F:fac))
***---MessageBox(fbn('i'))

      
      ACN(me:Val(cm:0), Val(f:fac))
      
      ACN(i:fac, Val(c:fac)+Val(h:fac))
      ACN(j:fac, Val(i:fac)*Val(ac:8))
      ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
      ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
      ACN(s:fac, Val(q:fac)+Val(r:fac))
* totalizadores
      SCN(ai:1, Val(f:fac))
      SCN(ai:2, Val(f:fac))
      SCN(ai:3, Val(f:fac))
      SCN(aj:1, Val(j:fac))
      SCN(aj:2, Val(j:fac))
      SCN(aj:3, Val(j:fac))
      SCN(ak:1, Val(k:fac))
      SCN(ak:2, Val(k:fac))
      SCN(ak:3, Val(k:fac))
      SCN(al:1, Val(l:fac))
      SCN(al:2, Val(l:fac))
      SCN(al:3, Val(l:fac))
      SCN(am:1, Val(m:fac))
      SCN(am:2, Val(m:fac))
      SCN(am:3, Val(m:fac))
      SCN(an:1, Val(n:fac))
      SCN(an:2, Val(n:fac))
      SCN(an:3, Val(n:fac))
      SCN(ao:1, Val(o:fac))
      SCN(ao:2, Val(o:fac))
      SCN(ao:3, Val(o:fac))
      SCN(ap:1, Val(p:fac))
      SCN(ap:2, Val(p:fac))
      SCN(ap:3, Val(p:fac))
      SCN(aq:1, Val(q:fac))
      SCN(aq:2, Val(q:fac))
      SCN(aq:3, Val(q:fac))
      SCN(ar:1, Val(r:fac))
      SCN(ar:2, Val(r:fac))
      SCN(ar:3, Val(r:fac))
      SCN(as:1, Val(s:fac))
      SCN(as:2, Val(s:fac))
      SCN(as:3, Val(s:fac))
      ifa
    proximo
  endif
  if not Incluido(fbn('e'), 'ZZ')
    ACT(a:fac, fbn('e'))
    if Dialogo.Radio1=3
      ACN(ac:8, SQL("select "~DBO~".ConversionMonedaMesa('"~Cotizaen(Val(a:fac))~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(ac:3)~"', 1)"))
    else
      ACN(ac:8, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Cotizaen(Val(a:fac))~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(ac:3)~"', 1)"))
    endif
    ACN(b:fac, SQL("Select CantidadIni from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' and NrSaldo=2"))
    ACN(c:fac, SQL("Select CantidadFin from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"' and NrSaldo=2"))    
    ***---Aplico el factor de capitalizacion
    SCN(B:fac, Val(B:fac) * IntsCapitalizados2(Val(A:fac), Dialogo.Fecha1))
    SCN(C:fac, Val(C:fac) * IntsCapitalizados2(Val(A:fac), Dialogo.Fecha2))
    ACN(d:fac, SQL("Select PFHME from POSICIONES2 where Especie='"~Val(a:fac)~"' and Vehiculo='"~fbn('v')~"' and Book='"~fbn('b')~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"' and NrSaldo=2"))
    ACN(e:fac, Val(c:fac)*Val(d:fac))
    ACN(f:fac, Val(e:fac)*Val(ac:8))
    ACN(ac:9, SQL("Select Intereses from "~DBO~".INTERESESCORRIDOS where Especie='"~Val(a:fac)~"' and Fecha='"~IdxDate(Dialogo.Fecha2)~"'"))
    if Not EqStr(BuscarCampo('ESPECIES', 'InteresesC', 'Codigo', Val(a:fac) ), 'CLE')
      ACN(g:fac, Cotizacion(Val(a:fac),,,, Dialogo.Fecha2, 1)-Val(ac:9))
    else
      ACN(g:fac, Cotizacion(Val(a:fac),,,, Dialogo.Fecha2, 1))
    endif
    ACN(h:fac, Val(c:fac)*Val(ac:9))
    **// Busca si la especie tiene incluido el valor residual
    ACN(VL:8, BuscarCampo('ESPECIES','Valor8','Codigo', val(a:fac)))
    IF [DesciendeDeEspecie(val(a:fac), 'PUBLIC') O DesciendeDeEspecie(val(a:fac), 'CORP B') O DesciendeDeEspecie(val(a:fac), 'EXTRAN')] Y Val(VL:8)=0
       **La especie es un titulo publico             
       ACN(i:fac, (Val(c:fac)*Val(g:fac)*ValorTeorico2(val(a:fac),Dialogo.Fecha2))+Val(h:fac))
    Else
       ACN(i:fac, (Val(c:fac)*Val(g:fac))+Val(h:fac))     
    EndIf
* por tipo de cambio
    ACN(j:fac, Val(i:fac)*Val(ac:8))
acn(x:fac, val(ac:8))
act(y:fac, Cotizaen(Val(a:fac)))
act(z:fac, Val(ac:3))

  SCN(co:0,1)
  ** guardo en celda "at" el Instrumento (campo Tipo de Especies)
    ACT(at:Val(co:0), fbn('i'))
  ** guardo en celda "au" el cliente1 de los PF
  ACT(au:Val(co:0), fbn('c'))
  ** guardo en celda "av" la Especie
  ACT(av:Val(co:0), fbn('e'))
    SCN(AX:Val(co:0), Val(J:fac))



  ** guardo en celda "aw" la Moneda en que cotiza
  SCN(cm:0,1)
  ACT(aw:Val(cm:0), Val(y:fac))
  ACN(me:Val(cm:0), Val(j:fac))

    SQL.ADD("Select")
    if Dialogo.Radio1=0
      *SQL.ADD("sum(RZMFDAY) r1, sum(RVMFDAY) r2, sum(IRMFDAY + ICMFDAY + DEMFDAY + DFMFDAY) r3, sum(INMFDAY) r4, sum(IDMFDAY + CIMFDAY + RHMFDAY +KRMFDAY) r5, sum(DKMFDAY +DIMFDAY +RCMFDAY) r6")
