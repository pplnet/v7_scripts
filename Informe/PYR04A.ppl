    else
      if Dialogo.Radio1=1
        *SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(IRMCDAY + ICMCDAY + DEMCDAY + DFMCDAY) r3, sum(INMCDAY) r4, sum(IDMCDAY + CIMCDAY + RHMCDAY +KRMCDAY) r5, sum(DKMCDAY +DIMCDAY +RCMCDAY) r6")
        ***---SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(IRMCDAY + ICMCDAY + DEMCDAY + DFMCDAY) r3, sum(INMCDAY) r4, sum(IDMCDAY + CIMCDAY + KRMCDAY) r5, sum(DKMCDAY +DIMCDAY) r6")
        ***---SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(IRMCDAY + ICMCDAY + DEMCDAY + DFMCDAY) r3, sum(INMCDAY) r4, sum(IDMCDAY + CIMCDAY + KRMCDAY) r5, sum(DKMCDAY) r6")
        ***---SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(IRMCDAY + ICMCDAY + DEMCDAY + DFMCDAY) r3, sum(INMCDAY) r4, sum(IDMCDAY + KRMCDAY) r5, sum(DKMCDAY) r6")
        SQL.ADD("sum(RZMCDAY) r1, sum(RVMCDAY) r2, sum(YRMCDAY + YCMCDAY + DEMCDAY + DFMCDAY) r3, sum(YNMCDAY) r4, sum(IDMCDAY + KRMCDAY) r5, sum(DKMCDAY) r6")
      else
        if Dialogo.Radio1=2
          *SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(IRMLDAY + ICMLDAY + DEMLDAY + DFMLDAY) r3, sum(INMLDAY) r4, sum(IDMLDAY + CIMLDAY + RHMLDAY +KRMLDAY) r5, sum(DKMLDAY +DIMLDAY +RCMLDAY) r6")
          ***---SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(IRMLDAY + ICMLDAY + DEMLDAY + DFMLDAY) r3, sum(INMLDAY) r4, sum(IDMLDAY + CIMLDAY + KRMLDAY) r5, sum(DKMLDAY +DIMLDAY) r6")
          ***---SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(IRMLDAY + ICMLDAY + DEMLDAY + DFMLDAY) r3, sum(INMLDAY) r4, sum(IDMLDAY + CIMLDAY + KRMLDAY) r5, sum(DKMLDAY) r6")
          ***---SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(IRMLDAY + ICMLDAY + DEMLDAY + DFMLDAY) r3, sum(INMLDAY) r4, sum(IDMLDAY + KRMLDAY) r5, sum(DKMLDAY) r6")
          SQL.ADD("sum(RZMLDAY) r1, sum(RVMLDAY) r2, sum(YRMLDAY + YCMLDAY + DEMLDAY + DFMLDAY) r3, sum(YNMLDAY) r4, sum(IDMLDAY + KRMLDAY) r5, sum(DKMLDAY) r6")
        else
          *SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(IRMMDAY + ICMMDAY + DEMMDAY + DFMMDAY) r3, sum(INMMDAY) r4, sum(IDMMDAY + CIMMDAY + RHMMDAY +KRMMDAY) r5, sum(DKMMDAY +DIMMDAY +RCMMDAY) r6")
          ***---SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(IRMMDAY + ICMMDAY + DEMMDAY + DFMMDAY) r3, sum(INMMDAY) r4, sum(IDMMDAY + CIMMDAY + KRMMDAY) r5, sum(DKMMDAY +DIMMDAY) r6")
          ***---SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(IRMMDAY + ICMMDAY + DEMMDAY + DFMMDAY) r3, sum(INMMDAY) r4, sum(IDMMDAY + CIMMDAY + KRMMDAY) r5, sum(DKMMDAY) r6")
          ***---SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(IRMMDAY + ICMMDAY + DEMMDAY + DFMMDAY) r3, sum(INMMDAY) r4, sum(IDMMDAY + KRMMDAY) r5, sum(DKMMDAY) r6")
          SQL.ADD("sum(RZMMDAY) r1, sum(RVMMDAY) r2, sum(YRMMDAY + YCMMDAY + DEMMDAY + DFMMDAY) r3, sum(YNMMDAY) r4, sum(IDMMDAY + KRMMDAY) r5, sum(DKMMDAY) r6")
        endif 
      endif
    endif
* para verlo en ME
    ***---SQL.ADD(", sum(RZMEDAY) r11, sum(RVMEDAY) r12, sum(IRMEDAY + ICMEDAY + DEMEDAY + DFMEDAY) r13, sum(INMEDAY) r14, 0 r15, 0 r16")
    SQL.ADD(", sum(RZMEDAY) r11, sum(RVMEDAY) r12, sum(YRMEDAY + YCMEDAY + DEMEDAY + DFMEDAY) r13, sum(YNMEDAY) r14, 0 r15, 0 r16")

    SQL.ADD("from "~DBO~".RESULTADOS2 where ")
    SQL.ADD("Fecha>='"~IdxDate(Dialogo.Fecha1)~"' and")
    SQL.ADD("Fecha<='"~IdxDate(Dialogo.Fecha2)~"' and")
    SQL.ADD("Vehiculo='"~Val(ac:1)~"' and")
    SQL.ADD("Book='"~Val(ac:2)~"' and")
    SQL.ADD("Especie='"~Val(a:fac)~"'")
    recorrer SQL
      dfa
      ACN(k:fac, fbn('r1'))
      ACN(l:fac, fbn('r2'))
      ACN(t:fac,Val(k:fac)+Val(l:fac))
      ACN(m:fac, fbn('r3'))
      ACN(n:fac, fbn('r4'))
      ACN(u:fac,Val(m:fac)+Val(n:fac))
      ACN(o:fac, fbn('r5'))
      ACN(p:fac, fbn('r6'))
      ACN(v:fac,Val(o:fac)+Val(p:fac))
      ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
      ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
      ACN(s:fac, Val(q:fac)+Val(r:fac))
* para verlo en ME
      ACN(ad:fac, fbn('r11'))
      ACN(ae:fac, fbn('r12'))
      ACN(af:fac, fbn('r13'))
      ACN(ag:fac, fbn('r14'))
      ACN(ah:fac, fbn('r15'))
      ACN(ai:fac, fbn('r16'))


    proximo
* totalizadores
    SCN(ai:1, Val(f:fac))
    SCN(ai:2, Val(f:fac))
    SCN(ai:3, Val(f:fac))
    SCN(aj:1, Val(j:fac))
    SCN(aj:2, Val(j:fac))
    SCN(aj:3, Val(j:fac))
    SCN(ak:1, Val(k:fac))
    SCN(ak:2, Val(k:fac))
    SCN(ak:3, Val(k:fac))
    SCN(al:1, Val(l:fac))
    SCN(al:2, Val(l:fac))
    SCN(al:3, Val(l:fac))
    SCN(am:1, Val(m:fac))
    SCN(am:2, Val(m:fac))
    SCN(am:3, Val(m:fac))
    SCN(an:1, Val(n:fac))
    SCN(an:2, Val(n:fac))
    SCN(an:3, Val(n:fac))
    SCN(ao:1, Val(o:fac))
    SCN(ao:2, Val(o:fac))
    SCN(ao:3, Val(o:fac))
    SCN(ap:1, Val(p:fac))
    SCN(ap:2, Val(p:fac))
    SCN(ap:3, Val(p:fac))
    SCN(aq:1, Val(q:fac))
    SCN(aq:2, Val(q:fac))
    SCN(aq:3, Val(q:fac))
    SCN(ar:1, Val(r:fac))
    SCN(ar:2, Val(r:fac))
    SCN(ar:3, Val(r:fac))
    SCN(as:1, Val(s:fac))
    SCN(as:2, Val(s:fac))
    SCN(as:3, Val(s:fac))

  else
    dfa
  endif



proximo

if NoVacio(Val(ac:1))
  ifa
  ACT(a:fac, 'Total Book')
  ACN(f:fac, Val(ai:1))
  ACN(j:fac, Val(aj:1))
  ACN(k:fac, Val(ak:1))
  ACN(l:fac, Val(al:1))
  ACN(t:fac,Val(k:fac)+Val(l:fac))
  ACN(m:fac, Val(am:1))
  ACN(n:fac, Val(an:1))
  ACN(u:fac,Val(m:fac)+Val(n:fac))
  ACN(o:fac, Val(ao:1))
  ACN(p:fac, Val(ap:1))
  ACN(v:fac,Val(o:fac)+Val(p:fac))
  ACN(q:fac, Val(aq:1))
  ACN(r:fac, Val(ar:1))
  ACN(s:fac, Val(as:1))
  AgregarMarco(a:fac..v:fac,1)
  
  ifa
  ACT(a:fac, 'Total Vehiculo')
  ACT(a:fac, 'Total Vehiculo')
  ACN(f:fac, Val(ai:2))
  ACN(j:fac, Val(aj:2))
  ACN(k:fac, Val(ak:2))
  ACN(l:fac, Val(al:2))
  ACN(t:fac,Val(k:fac)+Val(l:fac))
  ACN(m:fac, Val(am:2))
  ACN(n:fac, Val(an:2))
  ACN(u:fac,Val(m:fac)+Val(n:fac))
  ACN(o:fac, Val(ao:2))
  ACN(p:fac, Val(ap:2))
  ACN(v:fac,Val(o:fac)+Val(p:fac))
  ACN(q:fac, Val(aq:2))
  ACN(r:fac, Val(ar:2))
  ACN(s:fac, Val(as:2))
  AgregarMarco(a:fac..v:fac,1,0,Exe('COLOR8'))
endif

Setfont(a2..as:11, 1)
setfont(a12..az:fac, 2)

FormatoCeldas(d:9..d:fac, Exe('F7'))
FormatoCeldas(g:9..g:fac, Exe('F7'))
FormatoCeldas(w:9..x:fac, Exe('F7'))
FormatoCeldas(aa:9..aa:fac, Exe('F7'))

If Val(co:0)>0
   ** Grafico por Cartera
   ACT(bk:Val(co:1),Val(ac:2))
   ACN(mo:Val(co:1),Val(j:fac))
   
   ***---GraficarCeldas2(a:fac+2..d:fac+12, Torta,bk:1..bk:Val(co:1),mo:1..mo:Val(co:1))
   ***---ACT(b:fac+13,'                  CARTERAS')
   SetFont(b:fac+13, 4)
   
   ** Grafico por Instrumento
   ** Ordeno por Instrumento
   OrdenarFilas(1,Val(co:0),46,'A')
   ACN(co:3,1)
   ACN(co:4,0)
   ACT(ti:1,'*')
   Recorrer&i 1, Val(co:0)
     if not EqStr(Val(at:&i), Val(ti:1)) y not EqStr(Val(ti:1), '*')
        ACT(es:Val(co:3),Val(ti:1))
        ACN(ca:Val(co:3),Val(co:4))
        SCN(co:3,1)
        ACN(co:4,0)
     endif
     ACT(ti:1,Val(at:&i))
     ***---acaSCN(co:4,1)
     SCN(CO:4, Val(AX:&i))
     ***---MessageBox(Fstr(Val(AX:&i), 0, 0))
   Proximo
   
   ACT(es:Val(co:3),Val(ti:1))
   ACN(ca:Val(co:3),Val(co:4))
   ***---acaGraficarCeldas2(d:fac+2..f:fac+12, Torta,es:1..es:Val(co:3),ca:1..ca:Val(co:3))
   GraficarCeldas2(d:fac+2..f:fac+12, Torta,es:1..es:Val(co:3),ca:1..ca:Val(co:3))
   ACT(f:fac+13,' INSTRUMENTOS')
   SetFont(f:fac+13, 4)
   
   ** Ordeno por Moneda en que cotiza
   OrdenarFilas(1,Val(cm:0),49,'A')
   ACN(co:13,1)
   ACN(co:14,0)
   ACT(ei:1,'*')
   Recorrer&k 1, Val(cm:0)
     if not EqStr(Val(aw:&k), Val(ei:1)) y not EqStr(Val(ei:1), '*')
        ACT(mm:Val(co:13),Val(ei:1))
        ACN(mn:Val(co:13),Val(co:14))
        
        SCN(co:13,1)
        ACN(co:14,0)
     endif
     ACT(ei:1,Val(aw:&k))
     SCN(co:14,1)
   Proximo
   
   **Grafico Monedas
   ACT(mm:Val(co:13),Val(ei:1))
   ACN(mn:Val(co:13),Val(co:14))
   ***---   GraficarCeldas2(f:fac+2..h:fac+12, Torta,mm:1..mm:Val(co:13),mn:1..mn:Val(co:13))
   ***---   ACT(i:fac+13,'MONEDA')
   AlinearCeldas(i:fac+13,'C')
   SetFont(i:fac+13, 4)
   
   ** Grafico PF
   If Val(zz:0)>0
      ** Ordeno por Cliente1
      OrdenarFilas(1,Val(co:0),47,'A')
      ACN(co:5,1)
      ACN(co:6,0)
      ACT(ee:1,'*')
      Recorrer&j 1, Val(co:0)
        if not EqStr(Val(au:&j), '')
           if not EqStr(Val(au:&j), Val(ee:1)) y not EqStr(Val(ee:1), '*')
              ACT(en:Val(co:5),Val(ee:1))
              ACN(ce:Val(co:5),Val(co:6))
              
              SCN(co:5,1)
              ACN(co:6,0)
           endif
           ACT(ee:1,Val(au:&j))
           SCN(co:6,1)
        endif
      Proximo
      
      ACT(en:Val(co:5),Val(ee:1))
      ACN(ce:Val(co:5),Val(co:6))
      ***---GraficarCeldas2(h:fac+2..j:fac+12, Torta,en:1..en:Val(co:5),ce:1..ce:Val(co:5))
      ***---ACT(l:fac+13,'PLAZO FIJO')
      AlinearCeldas(l:fac+13,'C')
      SetFont(l:fac+13, 4)
   EndIf
   
   ** Ordeno por Especie
   OrdenarFilas(1,Val(co:0),48,'A')
   ACN(co:7,1)
   ACN(co:8,0)
   ACN(co:9,1)
   ACN(co:10,0)
   ACN(co:11,1)
   ACN(co:12,0)
   ACT(ef:1,'*')
   ACT(eg:1,'*')
   ACT(eh:1,'*')
   Recorrer&k 1, Val(co:0)
     if EqStr(Val(at:&k), 'FCI')
        if not EqStr(Val(av:&k), Val(ef:1)) y not EqStr(Val(ef:1), '*')
           ACT(fo:Val(co:7),Val(ef:1))
           ACN(cf:Val(co:7),Val(co:8))
           
           SCN(co:7,1)
           ACN(co:8,0)
        endif
        ACT(ef:1,Val(av:&k))
        SCN(co:8,1)
     else
        if EqStr(Val(at:&k), 'Acciones')
           if not EqStr(Val(av:&k), Val(eg:1)) y not EqStr(Val(eg:1), '*')
              ACT(fp:Val(co:9),Val(eg:1))
              ACN(cg:Val(co:9),Val(co:10))
              
              SCN(co:9,1)
              ACN(co:10,0)
           endif
           ACT(eg:1,Val(av:&k))
           SCN(co:10,1)
        else
           if EqStr(Val(at:&k), 'Tit. Pub.')
              if not EqStr(Val(av:&k), Val(eh:1)) y not EqStr(Val(eh:1), '*')
                 ACT(fq:Val(co:11),Val(eh:1))
                 ACN(cg:Val(co:11),Val(co:12))
                 
                 SCN(co:11,1)
                 ACN(co:12,0)
              endif
              ACT(eh:1,Val(av:&k))
              SCN(co:12,1)
           endif
        endif
     endif
   Proximo
      
   If Val(co:8)>0
      ** Grafico FCI
      ACT(fo:Val(co:7),Val(ef:1))
      ACN(cf:Val(co:7),Val(co:8))
      ** No hay grafico PF
      If Val(zz:0)=0
         ACN(cc:0,1)
         ACN(ro:1,8)
         ACN(rd:1,10)
         ACN(sf:1,12)
      Else
      ** Hay grafico PF
         ACN(cc:0,2)
         ACN(ro:1,10)
         ACN(rd:1,12)
         ACN(sf:1,15)
      EndIf
      ***---GraficarCeldas2(Val(ro:1):fac+2..Val(rd:1):fac+12, Torta,fo:1..fo:Val(co:7),cf:1..cf:Val(co:7))
      ***---ACT(Val(sf:1):fac+13,'FCI')
      AlinearCeldas(Val(sf:1):fac+13,'C')
      SetFont(Val(sf:1):fac+13, 4)
   EndIf
   
   If Val(co:10)>0
      ** Grafico Acciones
      ACT(fp:Val(co:9),Val(eg:1))
      ACN(cg:Val(co:9),Val(co:10))
      ** No hay grafico PF, hay grafico FCI
      If Val(cc:0)=1
         ACN(ro:1,10)
         ACN(rd:1,12)
         ACN(sf:1,15)
      Else
      ** Hay grafico PF, hay grafico FCI
         If Val(cc:0)=2
            ACN(ro:1,12)
            ACN(rd:1,14)
            ACN(sf:1,18)
         EndIf
      EndIf
      ***---GraficarCeldas2(Val(ro:1):fac+2..Val(rd:1):fac+12, Torta,fp:1..fp:Val(co:9),cg:1..cg:Val(co:9))
      ***---ACT(Val(sf:1):fac+13,'ACCIONES')
      AlinearCeldas(Val(sf:1):fac+13,'C')
      SetFont(Val(sf:1):fac+13, 4)
   EndIf
   
   If Val(co:12)>0
      ** Grafico Tit. Pub.
      ACT(fq:Val(co:11),Val(eh:1))
      ACN(cf:Val(co:11),Val(co:12))
      ** No hay grafico PF, no hay grafico FCI, no hay grafico Acciones
      If Val(zz:0)=0 y Val(co:8)<1 y Val(co:10)<1
         ACN(ro:1,8)
         ACN(rd:1,10)
         ACN(sf:1,12)
      Else
         ** Hay grafico PF, hay grafico FCI, no hay grafico Acciones
         If Val(zz:0)>0 y Val(co:8)>0 y Val(co:10)<1
            ACN(ro:1,12)
            ACN(rd:1,14)
            ACN(sf:1,18)
         Else
            ** Hay grafico PF, no hay grafico FCI, no hay grafico Acciones
            If Val(zz:0)>0 y Val(co:8)<1 y Val(co:10)<1
               ACN(ro:1,10)
               ACN(rd:1,12)
               ACN(sf:1,15)
            Else
               ** No hay grafico PF, hay grafico FCI, no hay grafico Acciones
               If Val(zz:0)=0 y Val(co:8)>0 y Val(co:10)<1
                  ACN(ro:1,10)
                  ACN(rd:1,12)
                  ACN(sf:1,15)
               Else
                  ** No hay grafico PF, no hay grafico FCI, hay grafico Acciones
                  If Val(zz:0)=0 y Val(co:8)<1 y Val(co:10)>0
                     ACN(ro:1,10)
                     ACN(rd:1,12)
                     ACN(sf:1,15)
                  Else
                     ** Hay grafico PF, hay grafico FCI, hay grafico Acciones
                     If Val(zz:0)>0 y Val(co:8)>0 y Val(co:10)>0
                        ACN(ro:1,14)
                        ACN(rd:1,16)
                        ACN(sf:1,21)
                     Else
                        ** Hay grafico PF, no hay grafico FCI, hay grafico Acciones
                        If Val(zz:0)>0 y Val(co:8)<1 y Val(co:10)>0
                           ACN(ro:1,12)
                           ACN(rd:1,14)
                           ACN(sf:1,18)
                        Else
                           ** No hay grafico PF, hay grafico FCI, hay grafico Acciones
                           If Val(zz:0)=0 y Val(co:8)>0 y Val(co:10)>0
                              ACN(ro:1,12)
                              ACN(rd:1,14)
                              ACN(sf:1,18)
                           EndIf
                        EndIf
                     EndIf
                  EndIf
               EndIf
            EndIf
         EndIf
      EndIf
      ***---GraficarCeldas2(Val(ro:1):fac+2..Val(rd:1):fac+12, Torta,fq:1..fq:Val(co:11),cf:1..cf:Val(co:11))
      ***---ACT(Val(sf:1):fac+13,'TITULOS PUBLICOS')
      AlinearCeldas(Val(sf:1):fac+13,'C')
      SetFont(Val(sf:1):fac+13, 4)
   EndIf
   
   LimitesVision(v:fac+14)
Else
   LimitesVision(V:fac+1)
EndIf



*LimitesVision(w:fac+1)
SetPrintFit(3,50)
Impresion(1,2)
Impresion(2,1)
Impresion(4,1)
SetMargins(0,0,0,2)




if NO
    * Logica de la operacion MMCP de unico vencimiento
    SQL.ADD("Select * from "~DBO~".OPERACIONES where TipoOp='MMCP' and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and Vehiculo1='"~fbn('v')~"' and Book1='"~fbn('b')~"' order by FechaVto")
    recorrer SQL
      dfa
      ACT(a:fac, fbn('Cliente1')~' - '~fbn('FechaVto'))
      ACLO(a:fac, fbn('NrOperacion'))
      ACN(ac:4, fbn('FechaOp'))
      ACN(ac:5, fbn('FechaVto'))
      ACN(ac:7, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha1)~"', '"~Val(ac:3)~"', 1)"))
      ACN(ac:8, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~Val(ac:3)~"', 1)"))

      acn(ab:fac, fac)
      acn(w:Fac, val(ac:7))
      acn(x:fac, val(ac:8))
      act(y:fac, fbn('Especie'))
      act(z:fac, Val(ac:3))


      if fbn('FechaOp')<=Dialogo.Fecha1
        ACN(b:fac, fbn('Cantidad'))
        ACN(ac:4, Dialogo.Fecha1)
        * estos son los intereses previos al inicio del periodo, que son los que sufren DC, solo hay que multiplicarlos por el TC al fin (realizado)/vto(no realizado) menos TC al inicio
        ACN(ac:6, fbn('TotalIntereses')/fbn('Plazo')*(Dialogo.Fecha1-fbn('FechaOp')))
        if fbn('FechaVto')>Dialogo.Fecha2
          ACN(ac:9, Val(ac:8))   
          ACN(p:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
        else
          ACN(ac:9, SQL("select "~DBO~".ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~fbn('Especie')~"', '"~IdxDate(fbn('FechaVto'))~"', '"~Val(ac:3)~"', 1)"))
          ACN(o:fac, Val(ac:6)*(Val(ac:9)-Val(ac:7)))
        endif
      ACN(v:fac,Val(o:fac)+Val(p:fac))
      acn(aa:fac, val(ac:9))
      endif
      if fbn('FechaVto')>=Dialogo.Fecha2
        ACN(c:fac, fbn('Cantidad'))
        ACN(d:fac, fbn('Precio1'))
        ACN(ac:5, Dialogo.Fecha2)
        ACN(h:fac, fbn('TotalIntereses')/fbn('Plazo')*(Dialogo.Fecha2-fbn('FechaOp')))
        * convertido por TC
        ACN(n:fac, fbn('TotalIntereses')/fbn('Plazo')*(Dialogo.Fecha2-Val(ac:4))*Val(ac:8))
      else
        * convertido por TC
        ACN(m:fac, fbn('TotalIntereses')/fbn('Plazo')*(fbn('FechaVto')-Val(ac:4))*Val(ac:8))
      endif
      ACN(u:fac,Val(m:fac)+Val(n:fac))
      ACN(f:fac, Val(c:fac)*Val(ac:8))
      ACN(i:fac, Val(c:fac)+Val(h:fac))
      ACN(j:fac, Val(i:fac)*Val(ac:8))
      ACN(e:fac, fbn('Cantidad'))
      ACN(q:fac, Val(k:fac)+Val(m:fac)+Val(o:fac))
      ACN(r:fac, Val(l:fac)+Val(n:fac)+Val(p:fac))
      ACN(s:fac, Val(q:fac)+Val(r:fac))
      * totalizadores
      SCN(ai:1, Val(f:fac))
      SCN(ai:2, Val(f:fac))
      SCN(ai:3, Val(f:fac))
      SCN(aj:1, Val(j:fac))
      SCN(aj:2, Val(j:fac))
      SCN(aj:3, Val(j:fac))
      SCN(ak:1, Val(k:fac))
      SCN(ak:2, Val(k:fac))
      SCN(ak:3, Val(k:fac))
      SCN(al:1, Val(l:fac))
      SCN(al:2, Val(l:fac))
      SCN(al:3, Val(l:fac))
      SCN(am:1, Val(m:fac))
      SCN(am:2, Val(m:fac))
      SCN(am:3, Val(m:fac))
      SCN(an:1, Val(n:fac))
      SCN(an:2, Val(n:fac))
      SCN(an:3, Val(n:fac))
      SCN(ao:1, Val(o:fac))
      SCN(ao:2, Val(o:fac))
      SCN(ao:3, Val(o:fac))
      SCN(ap:1, Val(p:fac))
      SCN(ap:2, Val(p:fac))
      SCN(ap:3, Val(p:fac))
      SCN(aq:1, Val(q:fac))
      SCN(aq:2, Val(q:fac))
      SCN(aq:3, Val(q:fac))
      SCN(ar:1, Val(r:fac))
      SCN(ar:2, Val(r:fac))
      SCN(ar:3, Val(r:fac))
      SCN(as:1, Val(s:fac))
      SCN(as:2, Val(s:fac))
      SCN(as:3, Val(s:fac))
      ifa
    proximo
ENDIF