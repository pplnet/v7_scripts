      ***---SQL.ADD("sum(RZMFDAY) r1, sum(RVMFDAY) r2, sum(IRMFDAY + ICMFDAY + DEMFDAY + DFMFDAY) r3, sum(INMFDAY) r4, sum(IDMFDAY + KRMFDAY) r5, sum(DKMFDAY) r6")
