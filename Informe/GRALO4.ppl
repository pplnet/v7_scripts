ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"    ;1;;;;;;;;Var('VEHICULODE')
  Cliente1   : "Cliente"     ;2;1;;;;;;;
  Especie1   : "Especie"     ;3;;;;;;;;
  Operador   : 'UsrInput'    ;3;2;;;;;;;
  Fecha1     : "Concer_Desde";4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha2     : "Concer_Hasta";4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3     : "Vto_Desde"   ;5;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4     : "Vto_Hasta"   ;5;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+365;
  Lista1     : 'TiposOp'     ;6;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo Like 'FXOCT%' ") 
  Lista2     : "Instancias"  ;0;2;;;;;;;;;SQLSet("Select Nombre from "~DBO~".INSTANCIAS where Tabla = 'OPERACIONES' ")  
  Lista3     : 'Fixing'      ;1;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,10,3)<>'000' AND SUBSTRING(Jerarquia,1,9)= (Select SUBSTRING(Jerarquia,1,9) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")
  Radio1     : "Orden por|Nro.Operacion|Pzo.Remanente" ;2;1;;;;;;;0
FinDialogo
if Not Ok
  Cancelar
endif
**  Check10    : 'Prec.'      ;1;2;;;;;;;0;

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

**AgregarBMP(a1,Exe('LOGO'),60)
ACT(a:2, CodigoInforme)
ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(a:2..g:2,1)

SetFilaActual(4)
ACT(a:FAC, "General de Operaciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(fac+1)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1)
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+2, 'Cliente : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+3, 'Especies : Todas')
endif
if NoVacio(Dialogo.Operador)
  ACT(a:FAC+7, 'UsrInput : '~Dialogo.Operador)
else
  ACT(a:FAC+7, 'UsrInput : Todos')
endif
ACT(a:FAC+4, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(d:FAC+4, 'Ope.Hasta : '~Dialogo.Fecha2)
ACT(a:fac+5, 'Vto.Desde : '~Dialogo.Fecha3)
ACT(d:FAC+5, 'Vto.Hasta : '~Dialogo.Fecha4)
if NoVacio(Dialogo.Lista3)
  ACT(d:FAC+6, 'Fixing : '~Dialogo.Lista3)
else
  ACT(d:FAC+6, 'Fixing : Todas')
endif
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC+6, 'Tipo Op. : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(A:FAC+6, 'Tipo Op. : Todas')
endif
if NoVacio(Dialogo.Lista2)
  ACT(A:FAC+7, 'Instancias : '~Pipe2Comillas(Dialogo.Lista2))
else
  ACT(A:FAC+7, 'Instancias : Todas')
endif
*if dialogo.Check10=1
*  ACT(a:FAC+8, 'Solo precanceladas')
*else
*  ACT(a:FAC+8, 'Sin precancelar')
*endif
ACT(a:FAC+9, "Orden : "~iif(Dialogo.Radio1=0,'NrOperacion','Plazo Remanente'))
SetFilaActual(FAC+11)

ACT(A:FAC, "Vehiculo")
ACT(b:FAC, "Operacion")
ACT(c:FAC, "TipoOp")
ACT(d:FAC, "FechaOp")
ACT(e:FAC, "Vto.Esp.")
ACT(f:FAC, "Vto.CEsp.")
ACT(g:FAC, "Plazo")
ACT(h:FAC, "Cliente")
****ACT(i:fac, "Cod. SFI")
ACT(i:FAC, "Especie ")
ACT(j:FAC, "C.Especie")
ACT(k:FAC, "Contratos")
ACT(l:FAC, "Cantidad")
ACT(m:FAC, "Precio")
**ACT(n:FAC, "Tasa N.A.")
ACT(n:FAC, "Total Bruto")
**ACT(p:FAC, "Intereses")
**ACT(q:FAC, "Total Neto")
ACT(o:FAC, "Book")
**ACT(s:FAC, "Book 2")
**ACT(t:FAC, "Mercado")
ACT(p:FAC, "Mercado")
**ACT(r:FAC, "ClienteSp")
**ACT(s:FAC, "Op.Refer.")
ACT(q:FAC, "Operador")
act(r:fac, "Fecha Alta")
act(s:fac, "Fecha Prec.")
act(t:fac, "Fixing")
act(u:fac, "Instancia")

AlinearCeldas(d:FAC..f:FAC,'D')
AlinearCeldas(g:FAC..g:FAC,'D')
AlinearCeldas(k:FAC..n:FAC,'D')
AlinearCeldas(t:FAC..u:FAC,'C')
ACN(aa1,FAC)
SetFont(a5..z:FAC,2)
AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD(" SELECT E.Alias5,        C.Alias5 ClienteSp, O.Vehiculo1,   O.NrOperacion,  O.Cliente1,            ")
SQL.ADD("        O.Rojo,          O.Cantidad,         O.Precio1,     O.FechaOp,      O.FechaVto,            ")
SQL.ADD("        O.FechaPago,     O.Book1,            O.TipoOp,      O.PaseCB,       O.TotalBrutoCli1,      ")
SQL.ADD("        O.TotalNetoCli1, O.TotalIntereses,   O.Mercado2,    O.NrOperacion3, O.Arbitraje,           ")
SQL.ADD("        O.ContraEspecie, O.ContraEspecie2,   O.FechaPrecan, O.CB6,          O.Plazo,               ")
SQL.ADD("        O.Especie,       O.MB5,              O.RB4,         O.FechaCarga,   I.Nombre as Instancia, ")
SQL.ADD("        B.NrBit,         O.Operador,         O.TotalBrutoCli3 ")
*-i
SQL.ADD(" FROM "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".ESPECIES E ON O.Especie   = E.Codigo  LEFT OUTER JOIN  "~DBO~".CLIENTES C  ON O.Cliente1  = C.Codigo , "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I ")
*SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I, "~DBO~".ESPECIES E ", "~DBO~".CLIENTES C )
*-f
SQL.ADD(" Where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   and O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
*-i
*SQL.ADD("   and O.Especie   *= E.Codigo ")
*SQL.ADD("   and O.Cliente1  *= C.Codigo ")
*-f
SQL.ADD("   and B.NrOperacion = O.NrOperacion ") 
SQL.ADD("   and B.Valor = '1'") 
SQL.ADD("   and I.NrInstancia = B.NrBit ")
SQL.ADD("   and I.Tabla = 'OPERACIONES' ")
SQL.ADD("   and O.TipoOp Like 'FXOCT%' ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if NoVacio(Dialogo.Lista2)
  SQL.ADD("and I.Nombre In ("~Pipe2Comillas(Dialogo.Lista2)~")")
endif
If NoVacio(Dialogo.Lista3)
   SQL.ADD("and O.ContraEspecie2 In ("~Pipe2Comillas(Dialogo.Lista3)~")")
EndIf
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Operador)
  SQL.ADD(" and O.UsrInput = '"~Dialogo.Operador~"' ")
endif
if Dialogo.Radio1 = 0
  SQL.ADD(" order by O.NrOperacion")
 else
  SQL.ADD(" order by FechaVto, O.NrOperacion ")
endif


Recorrer SQL
  message(fbn('NrOperacion'))
  *** Depende el tipo de operacion, las columnas de cantidades van a tener signo positivo o negativo
  If Incluido(fbn['TipoOp'], 'FXOCTV') 
     ACN(Z1, -1) 
  else
     ACN(Z1, 1)
  endif

  if Not EqStr(fbn('NrOperacion'),Val(v:1))
    ACT(a:fac, FBN['Vehiculo1'])
    ACT(b:fac, FBN['NrOperacion'])
    ACLO(b:fac, FBN['NrOperacion'])
    ACT(c:fac, FBN['TipoOp'])
    ACD(d:fac, FBN['FechaOp'])
    ACD(e:fac, FBN['FechaVto'])
    ACD(f:fac, FBN['FechaPago'])
    ACN(g:fac, FBN['Plazo'])
    ACT(h:fac, FBN['Cliente1'])
    ACT(i:fac, fbn('Especie'))
    ACT(j:fac, fbn('ContraEspecie'))
    ACN(k:FAC, FBN['TotalBrutoCli3']*Val(Z1))
    ACN(l:fac, FBN['Cantidad']*Val(Z1))
    ACN(m:fac, FBN['Precio1'])
    ACN(n:FAC, FBN['TotalBrutoCli1']*-Val(Z1))
    ACT(o:fac, fbn('Book1'))
    ACT(p:fac, fbn('Mercado2'))
    ACT(q:fac, fbn('Operador'))
    ACT(r:fac, fbn['FechaCarga'])
    If EqStr(fbn['CB6'],'1')
      ACT(s:fac, fbn['FechaPrecan'])
    EndIf
    ACT(t:fac, BuscarCampo('ESPECIES','Nombre','Codigo',FBN['ContraEspecie2']))
    ACT(v1, fbn('NrOperacion'))
  endif
  ACT(u:fac, fbn['Instancia']~" ("~fbn['NrBit']~")")
  ColorCeldas(u:fac,clBlue)

  FormatoCeldas(g:fac..g:fac,"0")
  FormatoCeldas(k:fac..p:fac,Exe('F2'))
  FormatoCeldas(m:fac..m:fac,Exe('F7'))
  SetFont(a:FAC..u:FAC,1)
proximo

