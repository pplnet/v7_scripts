CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Operaciones Vigentes y Notional Amounts por Empresa')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista1)
  ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:4, 'Vehiculo : Todos')
endif

ACT(a6, 'Nro.Op.')
ACT(b6, 'Dealer')
ACT(c6, 'Producto')
ACT(d6, 'Tipo')
ACT(e6, 'P.Strike')
ACT(f6, 'Volumen')
ACT(g6, 'Un.M.')
ACT(h6, 'F.Inicio')
ACT(i6, 'F.Fin')
ACT(j6, 'Vol. Total')
ACT(k6, 'Vol. Periodo')
ACT(l6, 'Notional Tot.')
ACT(m6, 'Notional Per.')

AgregarMarco(a6..m6, 2,0,Exe('COLOR'))

SetFilaActual(6)

*-- Opciones Simples 
SQL.ADD("Select * from "~DBO~".OPERACIONES ")
SQL.ADD("where FechaEj >='"~IdxDate(Dialogo.Fecha1)~"'  and ")
SQL.ADD("      TipoOp In ('DPOS','DPBOS','DPOGS') and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("Union All ")
SQL.ADD("Select * from "~DBO~".OPERACIONES")
SQL.ADD("where FechaOp2 <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and FechaEj > '"~IdxDate(Dialogo.Fecha1)~"'  ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and (TipoOp in ('DPSS','DPSO','DPFW','DPOGA','DPOGD','DPBOA','DPBOD','DPDSO','DPDSS','DPS','DPOA','DPOAV','DPOD','DPRC','DPRS','DPRRS') ")
SQL.ADD(" or (TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL) ) )")
SQL.ADD("order by Vehiculo1, TipoOp, NrOperacion")

BorrarCeldas(z1..z1)

Recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))
     if NoVacio(Val(z1))
        act(a:fac,'Total Empresa '~Val(z1) )
        acn(j:fac, Val(w1))
        acn(k:fac, Val(w2))
        acn(l:fac, Val(w3))
        acn(m:fac, Val(w4))
        BorrarCeldas(w1..w4)
        AgregarMarco(a:fac..m:fac,1)
        SetFont(a:fac..m:fac,1)
        ifa
     endif
     act(z1, fbn('Vehiculo1'))
     act(a:fac,'Empresa '~Val(z1) )
     AgregarMarco(a:fac..m:fac,1)
     SetFont(a:fac..m:fac,1)
     ifa
  endif


  act(a:fac, fbn('NrOperacion'))
  aclo(a:fac, fbn('NrOperacion'))
  act(b:fac, fbn('Cliente1'))
  act(c:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
    act(e:fac, fbn('TipoCambio2'))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
      act(e:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
    else
      act(e:fac, fbn('PrecioEj'))
    endif
  endif

  if fbn('FechaOp2') > Dialogo.Fecha1
    ACD(z2, fbn('FechaOp2'))
  else
    ACD(z2, Dialogo.Fecha1)
  endif
  if fbn('FechaEj') <= Dialogo.Fecha2
    ACD(z3, fbn('FechaEj'))
  else
    ACD(z3, Dialogo.Fecha2)
  endif
  * dif dias
  ACN(z4, (Val(z3)-Val(z2))+1)
  * dif meses
  ACN(z6, DifMeses(Val(z3),Val(z2))+1)

  * determinar el signo
  if EqStr(fbn('TipoOp'),'DPFW')
     if EqStr(fbn('MB3'),'1') 
        act(d:fac,'Venta')
        acn(z5,1)
     endif
     if EqStr(fbn('MB3'),'0') 
        act(d:fac,'Compra')
        acn(z5,-1)
     endif
  endif

  if Incluido(fbn('TipoOp'),'DPSS|DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(d:fac,'Producer')
      acn(z5,1)
    else
      act(d:fac,'Consumer')
      acn(z5,-1)
    endif
  endif
   if Incluido(fbn('TipoOp'),'DPSO|DPOS|DPOD|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra PUT')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta CALL')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta PUT')
      acn(z5,-1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra CALL')
      acn(z5,-1)
    endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Producer')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta Consumer')
      acn(z5,1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Consumer')
      acn(z5,-1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Venta Producer')
      acn(z5,-1)
    endif
  endif

  acn(f:fac, fbn('Cantidad'))
  act(g:fac, fbn('UMedida'))

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acd(h:fac, fbn('FechaEj'))
     acd(i:fac, fbn('FechaEj'))
     acn(j:fac, val(f:fac)*Val(z5))
     ACN(z4,1)
  else 
     acd(h:fac, fbn('FechaOp2'))
     acd(i:fac, fbn('FechaEj'))
     acn(j:fac, fbn('TotalAux2')*Val(z5))
  EndIf

  if EqStr(fbn('UMedida'),'BBLSD')
    * Barriles por dia
    acn(k:fac, fbn('Cantidad')*Val(z4)*Val(z5))
  else
    if Incluido(fbn('UMedida'),'BBLSM|TN/MES')
      * por meses
      acn(k:fac, fbn('Cantidad')*Val(z6)*Val(z5))
    endif
  endif

  acn(l:fac, fbn('TotalAux1')*Val(z5))

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acn(m:fac, val(l:fac))
  Else 
     acn(m:fac, (fbn('TotalAux1')*ABS(Val(k:fac))/fbn('TotalAux2'))*Val(z5))
  EndIf

  if Incluido(fbn('TipoOp'),'DPSS|DPSO')        
     *- Recupero los valores de las cuotas
     SQL.ADD("Select * from "~DBO~".CUOTAS C where ")
     SQL.ADD("C.NrOperacion='"~FBN['NrOperacion']~"' Order By NrCuota ")    

     *- aa1: Fecha   aa2: Volumen del Periodo aa3: Vol. Total de Periodo aa4: Notional del Periodo
     acd(aa1,fbn('FechaOp2'))
     acn(aa2,0)
     acn(aa3,0)
     acn(aa4,0)

     Recorrer SQL
        dfa
        acd(aa5,fbn('Fecha1'))       
    
        If val(aa1)<Dialogo.Fecha2 y val(aa5)>=Dialogo.Fecha1
           *- Si la cuota esta vigente en el periodo
           scn(aa2,FBN['Cantidad2'])
           scn(aa3,FBN['Cantidad1'])
           scn(aa4,FBN['Cantidad3'])
        EndIf

        acd(aa1,val(aa5))
     Proximo

     acn(f:fac, val(aa2)*Val(z5))
     acn(k:fac, val(aa3)*Val(z5))
     acn(m:fac, val(aa4)*Val(z5))
  EndIf

  scn(w1,Val(j:fac))
  scn(w2,Val(k:fac))
  scn(w3,Val(l:fac))
  scn(w4,Val(m:fac))

  scn(w5,Val(j:fac))
  scn(w6,Val(k:fac))
  scn(w7,Val(l:fac))
  scn(w8,Val(m:fac))

  SetFont(a:fac..m:fac,2)

proximo

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(j:fac, Val(w1))
  acn(k:fac, Val(w2))
  acn(l:fac, Val(w3))
  acn(m:fac, Val(w4))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..m:fac,1)
  SetFont(a:fac..m:fac,1)
endif

* total gral
ifa
acn(j:fac, Val(w5))
acn(k:fac, Val(w6))
acn(l:fac, Val(w7))
acn(m:fac, Val(w8))
BorrarCeldas(w1..w8)
AgregarMarco(a:fac..m:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..m:fac,2)

ACO(2,10)
ACO(3,19)
ACO(4,9)
ACO(5,5)
ACO(6,6)
ACO(7,4)
ACO(8,6)
ACO(9,6)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
FormatoCeldas(e7..e:fac, Exe('F7'))
FormatoCeldas(f7..f:fac, Exe('F2N'))
FormatoCeldas(j7..m:fac, Exe('F2N'))
AlinearCeldas(e:6..f:fac+1,'D')
AlinearCeldas(j:6..m:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)

*CrearFont(6,"Arial,6,B")
*RangoTitulo(a:5..m:FAC, 2)