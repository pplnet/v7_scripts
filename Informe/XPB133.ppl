SQL.ADD(" SELECT M.Especie, Saldo Cantidad, 'SALDO' TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero, M.Fecha FechaMov, ' ' Estado ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA M, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    C.Comitente = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo   = 1 ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
     SQL.ADD(" AND M.Cliente IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
   Endif
Endif
