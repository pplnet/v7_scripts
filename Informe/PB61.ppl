ACT(a:3, 'Proveedores: '~iif(vacio(Dialogo.ListaTabla1),'Todas',Pipe2Comillas(Dialogo.ListaTabla1)))
ACT(a:4, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
SetFont(a:2..a:5,2)

ACT(c:5, 'Cuentas por Proveedor ')
SetFont(c:5,3)

SetFilaActual(7)

ACT(a:fac,   'Codigo')
ACT(b:fac,   'Nombre')
ACT(c:fac,   'Direccion')
ACT(d:fac,   'Localidad')
ACT(e:fac,   'Telefono')
ACT(f:fac,   'Banco')
ACT(g:fac,   'Cuenta')
ACT(h:fac,   'Numero')

AlinearCeldas(a:fac..z:fac+1,'C')
SetFont(a:fac..z:fac+1,2)
AgregarMarco(a:fac..h:fac+1,0,0,EXE('COLOR6'))

SQL.ADD(" Select  PR.Nombre NombreP , PR.Codigo Proveedor, PR.Domicilio, CP.TipoCuenta, CP.Numero,")
SQL.ADD(" PR.Localidad, PR.Telefono , CP.Codigo Codigo,CP.Nombre Nombre , CP.Comitente")
SQL.ADD(" From   "~DBO~".CNCUENTASPROVEEDOR CP, "~DBO~".CNPROVEEDORES PR")
SQL.ADD(" Where ")
*SQL.ADD("     CP.Proveedor *= PR.Codigo  ")
SQL.ADD("     CP.Proveedor = PR.Codigo  ")
If NoVacio(Dialogo.ListaTabla1)
  SQL.ADD(" AND   PR.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   CP.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" Order By PR.Codigo ")

ACT(vh:1,'')
ACT(pb:1,'')

