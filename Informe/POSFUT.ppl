ACT(ME:1, Var('MONEEXTR'))
IF Dialogo.Radio1 = 0
  ACT(EX:1, Val(ML:1))
ELSE
  ACT(EX:1, Val(ME:1))
ENDIF

SetFilaActual(1)

ACT(D:fac, 'Posiciones y Resultados de Futuros')
