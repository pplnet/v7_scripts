ifa
SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, ")
SQL.ADD(" P.PrecioFin, P.Fecha, P.Precio1, P.Precio2, FechaFut, P.Producto, P.Mercado ")
SQL.ADD(" FROM "~DBO~".POSICIONESFUT P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND P.Cliente = '"~Dialogo.Vehiculo1~"' ")
Endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Book IN ( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
IF Dialogo.Radio2 = 0
  IF Dialogo.Radio1 = 0
    ***---Posicion concertada en ARP
    SQL.ADD(" AND P.NrSaldo IN (182) ")
  ELSE
    ***---Posicion concertada en Cotiza
    SQL.ADD(" AND P.NrSaldo IN (181) ")  
  ENDIF
ELSE
    IF Dialogo.Radio1 = 0
    ***---Posicion liquidada en ARP
    SQL.ADD(" AND P.NrSaldo IN (192) ")
  ELSE
  ***---Posicion liquidada en Cotiza
  SQL.ADD(" AND P.NrSaldo IN (191) ")  
  ENDIF
ENDIF
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONESFUT P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Especie, P.Book, P.NrSaldo, E.Tipo ")

ACN(xx:1, 0)
ACN(xx:2, 0)
ACN(xx:3, 0)
ACN(yy:1, 0)
ACN(yy:2, 0)
ACN(yy:3, 0)


ACN(fi:1, fac+1)
Recorrer SQL
   If Eqstr(Val(ES:1),'')
      ACT(ES:2,SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaFut'])~"' and MercadoNegociacion='"~Fbn['Mercado']~"' "))
      ACT(A:Fac,Val(ES:2))
*      ACT(A:Fac,Fbn['Especie'])
      AgregarMarco(a:fac..x:fac,0,0,EXE('COLOR6'))
   EndIf
   If Not Eqstr(Fbn['Especie'],Val(ES:1)) Y Not Eqstr(Val(ES:1),'')
      ***Totales por Book
      ACT(C:Fac,'Total '~Val(CA:1))
      **ACL(C:Fac, 'DPOSFU', Fecha1 =0, Radio1=0)
      ACN(G:Fac,Val(xx:1))
      If Val(G:Fac)>0
      ACL(G:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1=Val(CA:1),Mercado1=Val(av:1))
      EndIf
      ACN(I:Fac,Val(xx:2))
      If Val(I:Fac)>0
         ACL(I:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1=Val(CA:1),Mercado1=Val(av:1))
      EndIf
      ACN(M:Fac,Val(xx:3))
      ACN(xx:1,0)
      ACN(xx:2,0)
      ACN(xx:3,0)
      AgregarMarco(c:fac..x:fac,0,0)
      IFA
      ***Totales por Especie
      ACT(A:Fac,'Total '~Val(ES:2))
      ACN(G:Fac,Val(yy:1))
      ACN(I:Fac,Val(yy:2))
      If Val(G:Fac)>0
         ACL(G:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Val(ES:1),Entero1=Val(NS:1),Book='',Mercado1=Val(av:1))
      EndIf
      If Val(I:Fac)>0
      ACL(I:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1='',Mercado1=Val(av:1))
      EndIf
      ACN(M:Fac,Val(yy:3))
      AgregarMarco(a:fac..x:fac,0,0)
      ACN(yy:1,0)
      ACN(yy:2,0)
      ACN(yy:3,0)
      IFA
      ACT(ES:2,SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaFut'])~"' and MercadoNegociacion='"~Fbn['Mercado']~"' "))
      ACT(A:Fac,Val(ES:2))
*      ACT(A:Fac,Fbn['Especie'])
      AgregarMarco(a:fac..x:fac,0,0,EXE('COLOR6'))
   Else
      If Not Eqstr(Fbn['Book'],Val(CA:1)) Y Not Eqstr(Val(ES:1),'')
         ***Totales por Book
         ACT(C:Fac,'Total '~Val(CA:1))
         **ACL(C:Fac, 'DPOSFU', Fecha1 =0, Radio1=0)
         ACN(G:Fac,Val(xx:1))
         If Val(G:Fac)>0
            ACL(G:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Fbn['Especie'],Entero1=Fbn['NrSaldo'],Book1=Val(CA:1),Mercado1=Val(av:1))
         EndIf
         ACN(I:Fac,Val(xx:2))
         If Val(I:Fac)>0
            ACL(I:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Fbn['Especie'],Entero1=Fbn['NrSaldo'],Book1=Val(CA:1),Mercado1=Val(av:1))
         EndIf
         ACN(M:Fac,Val(xx:3))
         ACN(xx:1,0)
         ACN(xx:2,0)
         ACN(xx:3,0)
         AgregarMarco(c:fac..x:fac,0,0)
      EndIf
   EndIf 
   IF Dialogo.Radio1 = 1 Y Not Eqstr(fbn('Cotiza'), Val(EX:1))
     ***---Expresado en USD y no cotiza en USD => lo paso a USD
     ACN(CT:1,CotizacionC(fbn('Cotiza'),'CON',,,Dialogo.Fecha1,1, Val(EX:1)))
   ELSE
     ACN(CT:1, 1)
   ENDIF
   IFA
   ACT(B:Fac,Fbn['Book'])
   ACD(C:Fac,Fbn['FechaFut'])
   ***---ACN(D:Fac,COTIZACION(fbn('Especie'),'FUT',fbn('FechaFut'),,Habiles(Dialogo.Fecha1,-1,'ARG','SI'),1))      
   ACN(D:fac, SQL(" Select TOP 1 Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' and Fecha < '"~IdxDate(Habiles(Dialogo.Fecha1,-1,'ARG','SI'))~"' and Moneda = '"~Val(EX:1)~"' AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' Order by Fecha desc ") * Val(CT:1))
   If Dialogo.Fecha1=Fbn['Fecha']
      ACN(E:Fac,Fbn['CantidadIni'])
      ACN(F:Fac,Fbn['PrecioIni'] * Val(CT:1))
      ACN(G:Fac,Fbn['Cantidad1'])
      If Val(G:Fac)>0
      ACL(G:Fac, 'MOVOPF',Fecha1 =Val(C:Fac),Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Fbn['Especie'],Entero1=Fbn['NrSaldo'],Book1=Fbn['Book'],Mercado1=Fbn['Mercado'])
      EndIf
      ACN(H:Fac,Fbn['Precio1'] * Val(CT:1))
      ACN(I:Fac,Fbn['Cantidad2'])
      If Val(I:Fac)>0
      ACL(I:Fac, 'MOVOPF',Fecha1 =Val(C:Fac),Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Fbn['Especie'],Entero1=Fbn['NrSaldo'],Book1=Fbn['Book'],Mercado1=Fbn['Mercado'])
      EndIf
      ACN(J:Fac,Fbn['Precio2'] * Val(CT:1))
      ACN(M:Fac,Fbn['CantidadFin'])
      ACN(N:Fac,Fbn['PrecioFin'] * Val(CT:1))
   Else
      ACN(E:Fac,Fbn['CantidadFin'])
      ACN(F:Fac,Fbn['PrecioFin'] * Val(CT:1))
      ACN(G:Fac,0)
      ACN(H:Fac,0)
      ACN(I:Fac,0)
      ACN(J:Fac,0)
      ACN(M:Fac,Fbn['CantidadFin'])
      ACN(N:Fac,Fbn['PrecioFin'] * Val(CT:1))
   EndIf   
   ***---Busco los Resultados
   SQL.ADD(" Select TipoResultado, Day, MTD, YTD ")
   SQL.ADD(" From "~DBO~".RESULTADOSFUT ")
   SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")   
   SQL.ADD(" AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' ")
   SQL.ADD(" AND Mercado = '"~fbn('Mercado')~"' ")
   SQL.ADD(" AND Book = '"~fbn('Book')~"' ")
   SQL.ADD(" AND TipoNegocio IN ("~Pipe2Comillas(Val(PR:1))~") ")
   SQL.ADD(" AND NrSaldo = "~Fstr(fbn('NrSaldo'), 0, 0)~" ")
   Recorrer SQL
     DFA
     IF Eqstr(fbn('TipoResultado'), 'TRADE')
       ACN(P:fac, fbn('Day') * Val(CT:1))
       ACN(Q:fac, fbn('MTD') * Val(CT:1))
       ACN(R:fac, fbn('YTD') * Val(CT:1))
     ELSE
       IF Eqstr(fbn('TipoResultado'), 'REALIZ')
         ACN(S:fac, fbn('Day') * Val(CT:1))
         ACN(T:fac, fbn('MTD') * Val(CT:1))
         ACN(U:fac, fbn('YTD') * Val(CT:1))
       ELSE
         IF Eqstr(fbn('TipoResultado'), 'REVAL')
           ACN(V:fac, fbn('Day') * Val(CT:1))
           ACN(W:fac, fbn('MTD') * Val(CT:1))
           ACN(XU:fac, fbn('YTD') * Val(CT:1))
         ENDIF     
       ENDIF
     ENDIF
   Proximo
   
   ACN(K:Fac,Val(G:Fac)-Val(I:Fac))
   ***PPPNETO
   ***1-PPC*CantidadCompra
   ACN(PP:Fac,Val(G:Fac)*Val(H:Fac))
   ***2-PPV*CantidadVenta
   ACN(PO:Fac,Val(I:Fac)*Val(J:Fac))
   ***(1-2)/CantTotal
   ACN(L:Fac,(Val(PP:Fac)-Val(PO:Fac))/(Val(G:Fac)-Val(I:Fac)))
   ***---ACN(O:Fac,COTIZACION(fbn('Especie'),'FUT',fbn('FechaFut'),,Habiles(Dialogo.Fecha1,0,'ARG','SI'),1)) 
   ACN(O:fac, SQL(" Select TOP 1 Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' and Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' and Moneda = '"~Val(EX:1)~"' AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' Order by Fecha desc ") * Val(CT:1))
   **Cartera
   ACT(CA:1,Fbn['Book'])
   **Especie
   ACT(ES:1,Fbn['Especie'])
   ACT(ES:2,SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaFut'])~"' and MercadoNegociacion='"~Fbn['Mercado']~"' "))
   **NrSaldo
   ACN(NS:1,Fbn['NrSaldo'])
   
   ***Totales
   SCN(xx:1, Val(G:Fac))
   SCN(xx:2, Val(I:Fac))
   SCN(xx:3, Val(M:Fac))
   SCN(yy:1, Val(G:Fac))
   SCN(yy:2, Val(I:Fac))
   SCN(yy:3, Val(M:Fac))
   
Proximo
IFA
***Totales por Book
ACT(C:Fac,'Total '~Val(CA:1))
**ACL(C:Fac, 'DPOSFU', Fecha1 =0, Radio1=0)
ACN(G:Fac,Val(xx:1))
ACN(I:Fac,Val(xx:2))
If Val(G:Fac)>0
   ACL(G:Fac, 'MOVOPF',Fecha1 =0, Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1=Val(CA:1),Mercado1=Val(av:1))
EndIf
ACN(I:Fac,Val(xx:2))
If Val(I:Fac)>0
   ACL(I:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1=Val(CA:1),Mercado1=Val(av:1))
EndIf
ACN(M:Fac,Val(xx:3))
ACN(xx:1,0)
ACN(xx:2,0)
ACN(xx:3,0)
AgregarMarco(c:fac..x:fac,0,0)
IFA
***Totales por Especie
ACT(A:Fac,'Total '~Val(ES:2))
ACN(G:Fac,Val(yy:1))
ACN(I:Fac,Val(yy:2))
If Val(G:Fac)>0
   ACL(G:Fac, 'MOVOPF',Fecha1 =0, Fecha2 =Dialogo.Fecha1, Radio1=0,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1='',Mercado1=Val(av:1))
EndIf
If Val(I:Fac)>0
   ACL(I:Fac, 'MOVOPF',Fecha1 =0,Fecha2 =Dialogo.Fecha1, Radio1=1,Especie1=Val(ES:1),Entero1=Val(NS:1),Book1='',Mercado1=Val(av:1))
EndIf
ACN(M:Fac,Val(yy:3))
ACN(yy:1,0)
ACN(yy:2,0)
ACN(yy:3,0)
AgregarMarco(a:fac..x:fac,0,0)

FormatoCeldas(d:8..d:fac,Exe('F9'))
FormatoCeldas(e:8..e:fac,Exe('F2'))
