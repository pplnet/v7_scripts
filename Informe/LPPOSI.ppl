MostrarCuadroDeMensajes
ModoReproceso(SinDialogo)

CrearDialogo  
  Vehiculo1 : "Vehiculo"                               ;1;1;;  ;  ;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1    : "Fecha"                                  ; ; ;;  ;  ;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Fsys
  Radio1    : 'Tipo|Todos|Posicion|PLoss|Volumen'      ; ; ;;  ;  ;Dialogo.Radio1>=0;'Debe Ingresar Tipo de Limite';NO;0
  Especie1  : 'Especie'                                ; ; ;;  ;  ;  
  Radio3    : 'Volatilidad|BCRA|HO|'                   ; ; ;;NO;NO;Dialogo.Radio3>=0;'Debe Ingresar el Tipo de Volatidad a Aplicar';NO;1
  Radio2    : 'Detalle|NO|SI|'                         ;2;2;;  ;  ;Dialogo.Radio2>=0;'Debe Ingresar con o Sin Detalle';NO;0
FinDialogo


IF Not Ok
  Cancelar
ENDIF

CrearFont(2,"Arial,8,")
CrearFont(1,"Arial,8,I")
CrearFont(3,"Arial,10,B")

If Dialogo.Radio1<>3
   SQL.ADD("SELECT PS1.Especie,'0' as Tipo,PS1.NrSaldo as TCartera,PS1.CantidadFin Cantidad,0 as Monto,PS1.Especie as ContraEspecie,'POSI' as TipoOp,'00000000' as NrOperacion")
   SQL.ADD("FROM "~DBO~".POSICIONES PS1 WITH (NOLOCK) ")
   SQL.ADD("WHERE ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("      PS1.Especie = '"~Dialogo.Especie1~"'            AND ")
   EndIf
   SQL.ADD("      PS1.Vehiculo = '"~Dialogo.Vehiculo1~"'             AND ")
   SQL.ADD("      PS1.Cliente  = PS1.Vehiculo                        AND ")
   SQL.ADD("      PS1.NrSaldo in ('103','104','105','106')           AND ")
   *   SQL.ADD("      PS1.NrSaldo in ('107','108','109','110')         AND ")
   SQL.ADD("      PS1.CantidadFin <> 0                               AND ")
   SQL.ADD("      PS1.Fecha = (SELECT MAX(PS2.Fecha) ")
   SQL.ADD("                   FROM "~DBO~".POSICIONES PS2 WITH (NOLOCK) ")
   SQL.ADD("                   WHERE PS2.Cliente = PS1.Cliente                   AND ")
   SQL.ADD("                         PS2.Especie = PS1.Especie                   AND ")
   SQL.ADD("                         PS2.Vehiculo = PS1.Vehiculo                 AND ")
   SQL.ADD("                         PS2.Sector = PS1.Sector                     AND ")
   SQL.ADD("                         PS2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'  AND ")
   SQL.ADD("                         PS2.Cupon  = PS1.Cupon  AND ")
   SQL.ADD("                         PS2.NrSaldo = PS1.NrSaldo) ")
   If Dialogo.Radio1<>2
      SQL.ADD("Union ALL")
   EndIf
EndIf
If Dialogo.Radio1<>2
   *- Para Limite de Volumen y de Posicion de REPOS se recuperan los Pases Vigentes por el monto de la operacion
   SQL.ADD("SELECT O.Especie,'1' as Tipo,'000' as TCartera,CASE O.TipoOp WHEN 'TIFC' THEN O.Cantidad ELSE -O.Cantidad END Cantidad,O.TotalNetoCli1 as Monto,O.ContraEspecie,O.TipoOp,O.NrOperacion")
   SQL.ADD("FROM "~DBO~".OPERACIONES O WITH (NOLOCK)  ")
   SQL.ADD("WHERE O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' and ")
   SQL.ADD(" O.TipoOp In ('TIFC','TIFV')   AND ")
   SQL.ADD(" O.PaseCB='1' ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
   EndIf
EndIf
If Dialogo.Radio1=0 o Dialogo.Radio1=3
   *- Solo para Limite de Volumen se recuperan las operaciones por monto de contraespecie
   SQL.ADD("Union ALL")
   SQL.ADD("SELECT O.Especie,'2' as Tipo,'000' as TCartera,CASE O.TipoOp WHEN 'TIC' THEN O.Cantidad WHEN 'TIFC' THEN O.Cantidad ELSE -O.Cantidad END Cantidad,O.TotalNetoCli1 as Monto,O.ContraEspecie,O.TipoOp,O.NrOperacion")
   SQL.ADD("FROM "~DBO~".OPERACIONES O WITH (NOLOCK)  ")
   SQL.ADD("WHERE O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' and ")
   SQL.ADD(" O.TipoOp In ('TIC','TIV','TIFC','TIFV')  AND ")
   SQL.ADD(" (O.PaseCB='0' or O.PaseCB Is Null)  ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
   EndIf
   SQL.ADD("Union ALL")
   *- Solo para Limite de Volumen se recuperan los prestamos y depositos por cantidad de nominales + intereses para valuarlas 
   SQL.ADD("SELECT O.Especie,'3' as Tipo,'000' as TCartera,O.Cantidad+O.TotalIntereses Cantidad,O.Cantidad+O.TotalIntereses as Monto,O.Especie as ContraEspecie,O.TipoOp,O.NrOperacion")
*   SQL.ADD("SELECT O.Especie,'3' as Tipo,'000' as TCartera, ")
*   SQL.ADD("       Case O.TipoOp When 'TIPO' Then O.Cantidad+O.TotalIntereses ")
*   SQL.ADD("                     When 'TICO' Then O.Cantidad+O.TotalIntereses ")
*   SQL.ADD("                     Else -(O.Cantidad+O.TotalIntereses) END Cantidad, ")
*   SQL.ADD(" O.Cantidad+O.TotalIntereses as Monto, O.Especie as ContraEspecie, O.TipoOp, ")
*   SQL.ADD(" O.NrOperacion ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O WITH (NOLOCK)  ")
   SQL.ADD("WHERE O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' and (O.CB9=0 OR O.CB9 IS NULL) and ")
   SQL.ADD(" O.TipoOp In ('TICO','TIDE','TIPO','TICT')  ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
   EndIf
EndIf
SQL.ADD("ORDER BY 1,2,3")

ACT(a1, 'Limites '~IIF(Dialogo.Radio1=0,' de Posicion (Todos)',IIF(Dialogo.Radio1=1,'Posicion',IIF(Dialogo.Radio1=2,'Potential Loss',' de Volumen')))~' al '~Dialogo.Fecha1~' '~IIF(Dialogo.Radio2=1,' CON DETALLE '))
If NoVacio(Dialogo.Especie1)
   ACT(a2, 'Especie: '~Dialogo.Especie1)
EndIf
If NoVacio(Dialogo.Radio3)
   ACT(c2, 'Volatidad: '~IIF(Dialogo.Radio3=0, 'BCRA','HO'))
EndIf

SetFont(a1..h2,3)
SetFilaActual(3)

ACT(a:fac, 'Limite')
ACT(b:fac, 'Tipo')
ACT(c:fac, 'Moneda')
ACT(d:fac, 'Pos.Valuada / VAR')
ACT(e:fac, 'LimAsignado')
ACT(f:fac, 'Estado')

ACT(ba:fac, 'Limite')
ACT(bb:fac, 'Tipo')
ACT(bc:fac, 'Moneda')
ACT(bd:fac, 'Valuacion/VAR')
ACT(be:fac, 'LimAsignado')
ACT(bf:fac, 'Estado')
ACT(bg:fac, 'Posicion')
ACT(bh:fac, 'Esp Posic')
ACT(bi:fac, 'TipoOp')
ACT(bj:fac, 'NrOp')
ACT(bk:fac, 'Cotizac')
ACT(bl:fac, 'Volatilidad')

SetFont(a:fac..bl:fac,3)
AgregarMarco(a:fac..bl:fac,1,0,Exe('COLOR'))

ACT(aa:fac, 'Especie')
ACT(ab:fac, 'Limite')
ACT(ac:fac, 'Tipo')
ACT(ad:fac, 'Posicion')
ACT(ae:fac, 'Valuacion/VAR')
ACT(af:fac, 'Ascendentes')
ACT(ag:fac, 'Moneda')
ACT(ah:fac, 'MontoLim')
ACT(ai:fac, 'Cartera')
SetFont(aa:fac..ai:fac,3)

ACT(ml1,VAR('MONELOCA'))
ACT(me1,VAR('MONEEXTR')) 

*- z7: Puntero para Datos de Especie en celdas aa 
*- z6: Puntero para Datos en celdas a
ACN(z7,4)
ACN(z6,4)

Recorrer SQL

 IF Not EqStr(FBN['Especie'],val(z1))
    Message('Recuperando Datos '~FBN['Especie'])

    *- cl1: Cotizacion de la Especie en ARP ce1: Cotizacion de la Especie en ARP
    ACN(cl1, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,val(ml1))) 
    ACN(ce1, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,val(me1))) 
    ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
    ACT(ic1, BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']))
    ACN(cc1, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
    
    *- 21: Volatilidad BCRA 
    *- 26: Volatilidad HO
    If Dialogo.Radio3=0
       ACN(cv1, Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,21)*2.32*(5^0.5))
    Else
       ***---Cotizacion de Volatilidad
       ACN(CT:1, Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,20))
       ACN(cv1, Val(CT:1)*2.33*(10^0.5) )
    EndIf

    ACT(z1,FBN['Especie'])
    ACT(aa:val(z7),FBN['Especie'])

    *- Por cada cambio de especie verifico en que Grupo de Especies se encuentra
    ACT(af:val(z7),Ascendientes('ESPECIES',FBN['Especie']))
    ACT(ag:1,'')

    If NoVacio(val(af:val(z7)))    
       *- Construyo la condicion del Grupo de Especies  ag: Condicion    
       ACN(z2,0)
       ACT(ag:1,'(')
       Recorrer&j 1,Elementos(val(af:val(z7)))
          If val(z2)>0
             ACT(ag:1,val(ag:1)~" OR ")
          EndIf
          ACT(ag:1,val(ag:1)~"G.ListaEspecies Like '%"~ItemLista(val(af:val(z7)),&j)~"%'")
          SCN(z2,1)
       Proximo    
       ACT(ag:1,val(ag:1)~" OR G.ListaEspecies Is Null or G.ListaEspecies='') ")
       *- z3: Linea de comienzo de Limites para esa especie z4: Linea de comienzo de Limites para esa especie
    Else
       ACT(ag:1,"(G.ListaEspecies Like '%"~FBN['Especie']~"%') ")
    EndIf

    ACN(z3,val(z7))
    ACN(z4,val(z7))

    *- Limites por Grupo de Especie
    SQL.ADD("Select L.Limite,L.GrupoEspecie,G.Descripcion,G.ListaEspecies,L.Especie,L.TipoPosicion,Monto,FVencimiento,FAsignacion,FRevision ")
    SQL.ADD("From "~DBO~".LIMASIGNADOS L,"~DBO~".GRUPOSESPECIE G, "~DBO~".TIPOSLIMITE T ")
    SQL.ADD("Where L.Limite=T.Codigo and T.Clase='P' AND L.Status='OPE' AND G.Codigo=L.GrupoEspecie ")
    If NoVacio(val(ag:1))
       SQL.ADD("and  "~val(ag:1))
    EndIf
    If Dialogo.Radio1=1
       SQL.ADD("and  Limite ='POSICION' ")
    EndIf
    If Dialogo.Radio1=2
       SQL.ADD("and  Limite ='PLLOSS' ")
    EndIf
    If Dialogo.Radio1=3
       SQL.ADD("and  Limite ='VOLUMEN' ")
    EndIf
    SQL.ADD(" Union  ")
    *- Limites por Tipos de Posicion para REPOS Y REVERSE REPOS
    SQL.ADD("Select L.Limite,L.GrupoEspecie,P.Descripcion,' ' AS ListaEspecies,L.Especie,L.TipoPosicion,Monto,FVencimiento,FAsignacion,FRevision ")
    SQL.ADD("From "~DBO~".LIMASIGNADOS L, "~DBO~".TIPOSPOSICION P, "~DBO~".TIPOSLIMITE T ")
    SQL.ADD("Where L.Limite=T.Codigo and T.Clase='P' AND L.Status='OPE' AND L.TipoPosicion IS NOT NULL AND L.TipoPosicion=P.Codigo AND (L.GrupoEspecie Is Null or L.GrupoEspecie='') ")
    If Dialogo.Radio1=1
       SQL.ADD("and  Limite ='POSICION' ")
    EndIf
    If Dialogo.Radio1=2
       SQL.ADD("and  Limite ='PLLOSS' ")
    EndIf
    If Dialogo.Radio1=3
       SQL.ADD("and  Limite ='VOLUMEN' ")
    EndIf
    SQL.ADD("Order By 1,2,3,4,5")

    *- z8=1 Encontro limite para esta especie
    ACN(z8,0)
    Recorrer SQL
       ACT(ab:val(z4),FBN['Descripcion'])
       ACT(ac:val(z4),FBN['Limite'])
       ACT(ag:val(z4),FBN['Especie'])
       ACN(ah:val(z4),FBN['Monto'])
       ACT(ai:val(z4),FBN['TipoPosicion'])
       SCN(z4,1)
       ACN(z8,1)
    Proximo

    If val(z4)<>val(z3) 
       SCN(z4,-1)
    EndIf

    *- z6: Puntero para listar limite
    ACN(z7,val(z4)+1)
 EndIf

 If val(z8)=1
    *- la especie que estoy listando tiene algun limite a validar 
    Recorrer&j val(z3),val(z4)
       *- z5: Posicion valida para Limite => 0 => No Valida 1 => Valida 
       ACN(z5,0)

       IF Incluido(FBN['Tipo'],'0') y FBN['TCartera']=103 y [EqStr(val(ai:&j),'TRADIN') o Vacio(val(ai:&j))] y Not Incluido(val(ac:&j),'VOLUMEN|REPOS|')
          *- Trading 
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'0') y FBN['TCartera']=104 y [EqStr(val(ai:&j),'INVEST') o Vacio(val(ai:&j))] y Not Incluido(val(ac:&j),'VOLUMEN|REPOS|')
          *- Investment
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'0') y FBN['TCartera']=105 y [EqStr(val(ai:&j),'OSMEN6') o Vacio(val(ai:&j))] y Not Incluido(val(ac:&j),'VOLUMEN|REPOS|')
          *- Otras Sociedades Menor o Igual a 6 meses
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'0') y FBN['TCartera']=106 y [EqStr(val(ai:&j),'OSMAY6') o Vacio(val(ai:&j))] y Not Incluido(val(ac:&j),'VOLUMEN|REPOS|')
          *- Otras Sociedades Mayor a 6 meses
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'0') y FBN['TCartera']=0 y  Vacio(val(ai:&j)) y Not Incluido(val(ac:&j),'VOLUMEN|REPOS|')
          *- Todas
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'1|2|3|') y EqStr(val(ac:&j),'VOLUMEN')
          *- Para Limite de Volumen, matchea por si son operaciones
          ACN(z5,1)
       EndIf
       IF Incluido(FBN['Tipo'],'1') y EqStr(val(ai:&j),'REPOS')
          *- Para Limite de POSICION, matchea por si son operaciones DE PASES
          ACN(z5,1)
       EndIf

       * Message('Especie '~val(aa:val(z3))~' Posicion '~FBN['TCartera']~' Limite: '~val(ab:&j)~' Tipo Limite '~val(ac:&j)~' Concuerda? '~val(z5))
       If val(z5)=1
          ACT(ba:val(z6), val(ab:&j))
          ACT(bb:val(z6), val(ac:&j))
          ACT(bc:val(z6), val(ag:&j))
          ACN(be:val(z6), val(ah:&j)) 
          ACT(bh:val(z6), FBN['ContraEspecie'])
          ACT(bi:val(z6), FBN['TipoOp'])

          IF Not EqStr(FBN['Tipo'],'0')
             ACT(bj:val(z6), FBN['NrOperacion'])
             
          EndIf

          If Incluido(FBN['Tipo'],'1|2|')
             *- Monto de las operaciones valuadas a moneda del limite 
             ACN(bg:val(z6), FBN['Monto'])
             ACN(bk:val(z6), CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,val(bc:val(z6))) )
             ACN(bd:val(z6), FBN['Monto']*val(bk:val(z6)))
          Else 
             IF Not EqStr(val(bb:val(z6)), 'PLLOSS')
                *- Valuacion
                ACN(bg:val(z6), FBN['Cantidad'])
                If EqStr(val(bc:val(z6)),val(ml1))
                   *- Cotizacion en Moneda Local 
                   ACN(co1,val(cl1))
                Else
                   *- Cotizacion en Moneda Extranjera
                   ACN(co1,val(ce1))
                EndIf

                ACN(bk:val(z6), val(co1)) 
                ACN(ca1, 0)

                IF EqStr(val(ic1),'CLE')
*                  ACN(ca1, InteresEspecie(FBN['Especie'],Dialogo.Fecha1,FBN['Cantidad']) ) 
                   ACN(ca1, InteresEspecie(FBN['Especie'],Dialogo.Fecha1,FBN['Cantidad']*(1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1))  ) )
                EndIf
    
                *- K: Valuacion--> Valor Mercado
                IF EqStr(val(ic1),'CLE')
                   IF Incluido(Val(al4), '1585')
                      ACN(bd:val(z6), FBN['Cantidad']*Val(cc1)*Val(co1)+(Val(ca1)*Val(cc1)))
                   ELSE
                      ACN(bd:val(z6), FBN['Cantidad']*Val(cc1)*Val(co1)+Val(ca1))
                   ENDIF
                ELSE
                   ACN(bd:val(z6), FBN['Cantidad']*Val(co1)+Val(ca1))

                ENDIF
                ***---En Volatilidad solo muestra la cotizacion de volatilidad
                ACN(bl:val(z6), val(CT:1))

             ELSE
                *- Potential Loss
                ACN(bg:val(z6), FBN['Cantidad'])
                If EqStr(val(bc:val(z6)),val(ml1))
                   *- Cotizacion en Moneda Local 
                   ACN(co1,val(cl1))
                Else
                   *- Cotizacion en Moneda Extranjera
                   ACN(co1,val(ce1))
                EndIf
                ACN(bk:val(z6), val(co1)) 
*                ACN(bl:val(z6), val(cv1))
                ***---En Volatilidad solo muestra la cotizacion de volatilidad
                ACN(bl:val(z6), val(CT:1))
                ACN(bd:val(z6), Abs(FBN['Cantidad'])*Val(cv1)*Val(CO:1))
             ENDIF

          ENDIF
          SetFont(a:val(z6)..bz:val(z6), 2)       
          SCN(z6,1)     
       EndIf
       IF &j = Val(Z:4) Y Eqstr(fbn('Tipo'), '1')
           ***---Si es un futuro de pase, se debe sumar a la posicion spot. Tanto en la
           ***---posicion como en la valuacion
           Recorrer&k 4, Val(Z:6)
               ***---Busco las posiciones spot de la especie
               IF Eqstr(Val(BI:&k), 'POSI') Y Eqstr(Val(BH:&k), fbn('Especie'))
                   SCN(BG:&k, fbn('Cantidad'))
                   IF Not EqStr(val(bb:&k), 'PLLOSS')
                      If EqStr(val(bc:&k),val(ml1))
                         *- Cotizacion en Moneda Local 
                         ACN(co1,val(cl1))
                      Else
                         *- Cotizacion en Moneda Extranjera
                         ACN(co1,val(ce1))
                      EndIf
                      ACN(ca1, 0)
                      IF EqStr(val(ic1),'CLE')
*                        ACN(ca1, InteresEspecie(FBN['Especie'],Dialogo.Fecha1,FBN['Cantidad']) ) 
                         ACN(ca1, InteresEspecie(FBN['Especie'],Dialogo.Fecha1,FBN['Cantidad']*(1+IntsCapitalizados2(FBN['Especie'],Dialogo.Fecha1))  ) )
                      EndIf
                      *- K: Valuacion--> Valor Mercado
                      IF EqStr(val(ic1),'CLE')
                         IF Incluido(Val(al4), '1585')
                            ACN(bd:&k, Val(BG:&k)*Val(cc1)*Val(co1)+(Val(ca1)*Val(cc1)))
                         ELSE
                            ACN(bd:&k, Val(BG:&k)*Val(cc1)*Val(co1)+Val(ca1))
                         ENDIF
                      ELSE
                         ACN(bd:&k, Val(BG:&k)*Val(co1)+Val(ca1))
                      ENDIF
                   ELSE
                      *- Potential Loss
                      If EqStr(val(bc:&k),val(ml1))
                         *- Cotizacion en Moneda Local 
                         ACN(co1,val(cl1))
                      Else
                         *- Cotizacion en Moneda Extranjera
                         ACN(co1,val(ce1))
                      EndIf
                      ***---En Volatilidad solo muestra la cotizacion de volatilidad
                      ACN(bd:&k, Abs(Val(BG:&k))*Val(cv1)*Val(CO:1))
                   ENDIF
               ENDIF
           Proximo
       ENDIF
    Proximo
 EndIf
Proximo

*- Resguardo en b2 la cantidad total de filas
ACN(b2,val(z6))

OrdenarFilas(4,Val(z6),53,'A','54:A|')

*- Por Cada cambio de Limite y Tipo (columnas aa+ab) Muestro el estado
*- z10: Puntero para Listar el informe a visualizar
*- z11: Clave a Recorrer
ACN(z10,4)
ACT(z11,'')

Recorrer&i 5,val(b2)

  IF Not EqStr(val(z11),val(ba:&i)~val(bb:&i)) y NoVacio(val(z11))
     *-Comparo el consumido con el asignado y muestro el estado
     IF Not EqStr(val(b:val(z10)), 'PLLOSS')
        If val(d:val(z10))>val(e:val(z10))
           ACT(f:val(z10), 'Excedido')
        Else
           ACT(f:val(z10), 'OK')
        EndIf
     Else
        If val(d:val(z10))<val(e:val(z10))
           ACT(f:val(z10), 'Excedido')
        Else
           ACT(f:val(z10), 'OK')
        EndIf
     EndIf

     SetFont(a:val(z10)..f:val(z10), 2)       
     SCN(z10,1)
  EndIf

  IF Not EqStr(val(z11),val(ba:&i)~val(bb:&i))
     ACT(z11,val(ba:&i)~val(bb:&i))

     ACT(a:val(z10), val(ba:&i))
     ACT(b:val(z10), val(bb:&i))
     ACT(c:val(z10), val(bc:&i))
     ACN(e:val(z10), val(be:&i))
  EndIf

  SCN(d:val(z10), val(bd:&i))
Proximo

*- Comparo el consumido con el asignado y muestro el estado
IF Not EqStr(val(b:val(z10)), 'PLLOSS')
   If val(d:val(z10))>val(e:val(z10))
      ACT(f:val(z10), 'Excedido')
   Else
      ACT(f:val(z10), 'OK')
   EndIf
Else
   If val(d:val(z10))<val(e:val(z10))
      ACT(f:val(z10), 'Excedido')
   Else
      ACT(f:val(z10), 'OK')
   EndIf

EndIf

SetFont(a:val(z10)..f:val(z10), 2)       
SCN(z10,2)

IF Dialogo.Radio2=1
   *- Transalado los Detalles

   ACT(a:val(z10), 'DETALLE')   
   SetFont(a:val(z10)..a:val(z10), 3)       
   SCN(z10,2)

   ACT(a:val(z10), 'Limite')
   ACT(b:val(z10), 'Tipo')
   ACT(c:val(z10), 'Moneda')
   ACT(d:val(z10), 'Valuacion/VAR')
   ACT(e:val(z10), 'LimAsignado')
   ACT(f:val(z10), 'Posicion')
   ACT(g:val(z10), 'Esp Posic')
   ACT(h:val(z10), 'TipoOp')
   ACT(i:val(z10), 'NrOp')
   ACT(j:val(z10), 'Cotizac')
