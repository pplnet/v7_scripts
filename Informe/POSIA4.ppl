MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'                         ;;;;;;;;;fsys
  Especie1 : 'Especie'                       ;;;;;;Vacio(Dialogo.Especie1) O [DesciendeDeEspecie(Dialogo.Especie1,'ACCION') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar una Accion';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','ACCION')~"%' "
  Vehiculo1: 'Vehiculo'
  Radio2   : 'Posicion|Concertada|Liquidada' ;6;;;;;;;;0
  Radio1   : 'Expresado|ARP|USD'             ;8;;;;;;;;0  
  Check1   : 'Incluye $'                     ;10;;;;;;;;0
  Check3   : 'Inc.Resultados'                ;;;;;;;;;1
  Check2   : 'Inc.Pos.0'                     ;1;1;1;NO;NO;;;;0
  Lista1   : 'Book'                          ;0;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))
IF Dialogo.Radio1 = 0
  ACT(EX:1, Val(ML:1))
ELSE
  ACT(EX:1, Val(ME:1))
ENDIF

SetFilaActual(1)

ACT(D:fac, 'Posiciones y Resultados de Acciones')
SetFont(D:fac, 5)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Especie: '~iif(novacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ifa
ACT(A:fac, 'Vehiculo: '~iif(novacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
ifa
ACT(A:fac, iif(Dialogo.Check1=0, 'No incluye Posiciones en Pesos','Incluye Posiciones en Pesos'))
ifa
if NoVacio(Dialogo.Lista1)
   ACT(A:Fac, 'Book : '~Pipe2Comillas(Dialogo.Lista1))
else
   ACT(A:fac, 'Book : Todos')
endif
IF Dialogo.Radio2 = 0
  ACT(A:fac, 'Posicion Concertada')
ELSE
  ACT(A:fac, 'Posicion Liquidada')
ENDIF
ifa
IF Dialogo.Radio1 = 0
  ACT(A:fac, 'Expresado en ARP')
ELSE
  ACT(A:fac, 'Expresado en USD')
ENDIF
SetFont(A:fac-6..A:fac, 2)

SetFilaActual(fac+2)
ACT(a:fac, 'Especie')
