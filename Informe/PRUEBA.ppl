* FJL 27/05/19 - Nuevo Control Isssue EXTBOFA-3637 / BOFAV6-3717
* Informe de Movs No Operativos
act(a:fac,'Movs No operativos en Instancias Intermedias')
SetFont(a:fac,2)
ifa
ACT(a:fac, 'Fecha Tr.')
ACT(b:fac, 'Especie')
ACT(c:fac, 'Nombre')
ACT(d:fac, 'Cantidad')
ACT(e:fac, 'Cuenta')
ACT(f:fac, 'Transaccion')
ACT(g:fac, 'Tipo')
ACT(h:fac, 'Instancia')
SetFont(a:fac..h:fac,3)
AgregarMarco(a:fac..h:fac,2,0,EXE('COLOR6'))
acn(w:1,fac+1)

SQL.ADD("Select T.Especie, T.Cantidad1, T.Cuenta1, T.NrTrans, T.TipoTr2, T.Vehiculo1, T.Cuenta1, T.Cuenta2, T.Book1, T.Fecha1, ")
SQL.ADD("       E.Nombre, B.NrBit, I.Nombre NomInst ")
SQL.ADD("  from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B,"~DBO~".ESPECIES E, "~DBO~".INSTANCIAS I ") 
SQL.ADD(" where T.Especie = E.Codigo      ")
SQL.ADD("   and T.NrTrans = B.NrOperacion ")
SQL.ADD("   and I.NrInstancia = B.NrBit ")
SQL.ADD("   and I.Tabla       = 'TRANSACCIONES2' ")
SQL.ADD("   and T.TipoTr2 in ('DENOP','RENOP','TRNOP') ")
SQL.ADD("   and T.Fecha1 <= "~IdxDate2(FSys)~"  ")
* FJL 19/06/19 - Nuevo Control Isssue EXTBOFA-3637 / BOFAV6-3717 - Ahora puden estar en Anulacion
*SQL.ADD("   and B.NrBit <> 70          ")
SQL.ADD("   and B.NrBit Not in (70,30) ")
SQL.ADD("   and B.Valor = '1'          ")
SQL.ADD(" Order By T.NrTrans,B.NrBit ")
watch(SQL.BATCH())
Recorrer SQL
    * No puede correr la contabilidad
    acn(z:2,1)
    ACD(a:fac, FBN['Fecha1'])
    ACT(b:fac, FBN['Especie'])
    ACT(c:fac, FBN['Nombre'])
    ACN(d:fac, FBN['Cantidad1'])
    ACT(e:fac, FBN['Cuenta1'])
    ACT(f:fac, FBN['NrTrans'])
    ACLT(f:fac, FBN['NrTrans'])
    ACT(g:fac, FBN['TipoTr2'])
    ACT(h:fac, FBN['NrBit']~' - '~FBN['NomInst'])
Proximo

ENDIF

