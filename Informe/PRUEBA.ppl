Message('--- Cobro de Cupon ---')
SQL.ADD(" Select T.NrTrans, T.Especie, T.Vehiculo1, T.Cupon1, T.Fecha1, T.Precio2 PorRenta, T.Precio1+T.Precio3 PorAmort, M.NrSaldo, ")
** FJL 28/08/18 - Tiene que tomar la cueenta del Movimiento
*SQL.ADD(" MA.Codigo CodAsi, T.Especie4 Moneda, M.Cantidad, M.Cliente, C.Jerarquia, T.Cuenta1 ")
SQL.ADD(" MA.Codigo CodAsi, T.Especie4 Moneda, M.Cantidad, M.Cliente, C.Jerarquia, ")
SQL.ADD(" MM.Cuenta ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS MM ")
SQL.ADD(" Where T.TipoTr2 = MA.TipoTr2 ")
SQL.ADD(" AND T.NrTrans = M.NrOperacion ")
SQL.ADD(" AND M.Cliente = C.Codigo ")
SQL.ADD(" AND M.Especie = T.Especie ")
SQL.ADD(" AND T.TipoTr2 = 'LCUPON' ")
SQL.ADD(" AND MA.TipoAsiento = '"~Val(TA:1)~"' ")
SQL.ADD(" AND T.FechaCargaSys = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' ")
SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND MM.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND MM.Cliente = M.Cliente ")
SQL.ADD(" AND MM.Especie = T.Especie4 ")
SQL.ADD(" AND MM.NrGrupo = 1 ")

SQL.ADD(" UNION ")
SQL.ADD(" Select T.NrTrans, T.Especie, T.Vehiculo1, T.Cupon1, T.Fecha1, T.Precio2 PorRenta, T.Precio1+T.Precio3 PorAmort, M.NrSaldo, ")
** FJL 28/08/18 - Tiene que tomar la cueenta del Movimiento
*SQL.ADD(" MA.Codigo CodAsi, T.Especie4 Moneda, M.Cantidad, M.Cliente, C.Jerarquia, T.Cuenta1 ")
SQL.ADD(" MA.Codigo CodAsi, T.Especie4 Moneda, M.Cantidad, M.Cliente, C.Jerarquia,  ")
SQL.ADD(" MM.Cuenta ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO MA, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES MM ")
SQL.ADD(" Where T.TipoTr2 = MA.TipoTr2 ")
SQL.ADD(" AND T.NrTrans = M.NrOperacion ")
SQL.ADD(" AND M.Cliente = C.Codigo ")
SQL.ADD(" AND M.Especie = T.Especie ")
SQL.ADD(" AND T.TipoTr2 = 'LCUPON' ")
SQL.ADD(" AND MA.TipoAsiento = '"~Val(TA:1)~"' ")
SQL.ADD(" AND T.FechaCargaSys = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' ")
SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND MM.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND MM.Cliente = M.Cliente ")
SQL.ADD(" AND MM.Especie = T.Especie4 ")
SQL.ADD(" AND MM.NrGrupo = 1 ")

ACN(XX:2,0)
ACN(XX:1,0)
watch(SQL.Batch)

Recorrer SQL
  ACD(a:FAC, fbn('Fecha1'))
  ACD(b:FAC, Dialogo.Fecha1)
  ACT(v:FAC, fbn('Vehiculo1'))
  ACT(d:FAC, fbn('NrTrans'))
  ACT(e:FAC, fbn('CodAsi'))
  ACN(f:FAC, fbn('PorRenta'))
  ACN(g:FAC, fbn('PorAmort'))
  ACN(h:FAC, fbn('Cantidad'))
  ACN(i:FAC, fbn('Cantidad') * Val(f:fac) / 100)
  ACN(j:FAC, fbn('Cantidad') * Val(g:fac) / 100)
  ACT(k:FAC, fbn('Cuenta'))
IF NO  
    ACD(FV:1, fbn('Fecha1'))
    ACD(FD:1, Dialogo.Fecha1)
    ACT(VH:1, fbn('Vehiculo1'))
    ACT(NR:1, '')
    ACT(NR:2, fbn('NrTrans'))
    ACT(TO:1, fbn('CodAsi'))
    ACT(TI:1, '')
    ACN(RT:1, fbn('PorRenta'))
    ACN(AM:1, fbn('PorAmort'))
    ***---Calculo de Renta
    ACN(RT:2, fbn('Cantidad') * Val(RT:1) / 100)
    ***---Calculo de Amortizacion
    ACN(AM:2, fbn('Cantidad') * Val(AM:1) / 100)    
    **    (.'GENASIENTO'.)     
ENDIF
Proximo

ENDIF

