ACN(b:1, &memoryHelper.AvailablePhysicalMemory())
ACN(b:2, &memoryHelper.AvailableVirtualMemory())
ACN(b:3, &memoryHelper.TotalPhysicalMemory())
ACN(b:4, &memoryHelper.TotalVirtualMemory())

if Val(b:1)<Val(f:1)
  if MessageBox('La memoria disponible ('~PyC(&memoryHelper.AvailablePhysicalMemory(),0,0)~' MB) es menor que la minima recomendada ('~PyC(Val(f:1),0,0)~' MB). Desea Continuar?',3,2)=7
    Cancelar('Evento cancelado')
  else
    ACT(f:2, 'Disponible: '~PyC(&memoryHelper.AvailablePhysicalMemory(),0,0)~' MB')
    ACT(f:3, 'Recomendada: '~PyC(Val(f:1),0,0)~' MB')
  SQL.ADD(" INSERT INTO "~DBO~".PMAUDIT (Operador,Fecha,Accion,Tabla,Codigo,Campo,ValorAnterior,ValorActual) ")
*    SQL.ADD(" VALUES ('"~USUARIOACTIVO~"',GETDATE(), 'E', 'EVENTOS', Codigoinforme, 'Memoria','Disponible: '~PyC(&memoryHelper.AvailablePhysicalMemory(),0,0)~' MB','Recomenedada '~PyC(Val(f:1),0,0)~' MB' ")
    SQL.ADD(" VALUES ('"~USUARIOACTIVO~"',GETDATE(), 'M', 'EVENTOS', '"~Codigoinforme~"', 'Problema de Memoria','"~Val(f:2)~"','"~Val(f:3)~"') ")
    SQL.NEW
    SQL.EXEC
  endif
endif

ACO(1,30)
ENDIF

