SQL.ADD(" SELECT P.* FROM "~DBO~".POSICIONES P ")
SQL.ADD("  where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
SQL.ADD("    AND P.NrSaldo    > 190 and P.NrSaldo < 200 ")
SQL.ADD("    AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES ")
SQL.ADD("                   WHERE  Especie  = P.Especie  ")
SQL.ADD("                   AND    Vehiculo = P.Vehiculo ")
SQL.ADD("                   AND    NrSaldo  = P.NrSaldo  ")
SQL.ADD("                   AND    Cliente  = P.Cliente  ")
SQL.ADD("                   AND    Book     = P.Book     ")
SQL.ADD("                   AND   (Sector   = P.Sector   OR (Sector   IS NULL AND P.Sector   IS NULL) ) ")
SQL.ADD("                   AND   (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
SQL.ADD("                   AND   (Cupon    = P.Cupon    OR (Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
SQL.ADD("                   AND   (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
SQL.ADD("                   AND   (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
SQL.ADD("                   AND   Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
Recorrer SQL

  ACD(a:FAC, fbn('Fecha'))
  ACT(b:FAC, fbn('Cliente'))
  ACT(c:FAC, fbn('Vehiculo'))
  ACT(d:FAC, fbn('Especie'))
  ACN(e:FAC, fbn('NrSaldo'))
  ACN(f:FAC, fbn('CantidadFin'))
  ACN(g:FAC, fbn('PrecioFin'))
  ACN(h:FAC, fbn('PrecioReset'))
  ACN(i:FAC, COTIZACIONC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'ARP'))
  ACN(n:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1))
  ACT(o:FAC, BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
  ACN(p:FAC, COTIZACIONC(Val(o:FAC),,,,Dialogo.Fecha1,25,SI,'ARP'))
  ACN(q:FAC, Val(n:FAC)*Val(p:FAC))
  
  if fbn('CantidadFin') <> 0
    ACT(j:FAC, 'Reset')
    IF Dialogo.Check1=1
      ACT(k:FAC, 'SI')
      
         SQL.ADD("UPDATE "~DBO~".POSICIONES ")
         SQL.ADD("SET   PrecioReset   = "~FStr(Val(i:FAC),0,8)~" ")

         SQL.ADD("WHERE Vehiculo    = '"~FBN['Vehiculo']~"' AND ")
         SQL.ADD("      Cliente     = '"~FBN['Cliente']~"'  AND ")
         SQL.ADD("      Especie     = '"~FBN['Especie']~"'  AND ")
         SQL.ADD("      NrSaldo     = "~FStr(FBN['NrSaldo'],0,0)~"        AND ")
         SQL.ADD("      Book        = '"~FBN['Book']~"'                   AND ")
         SQL.ADD("      Fecha       = '"~IdxDate(Dialogo.Fecha1)~"'       AND ")
         SQL.ADD("      IsNull(TipoNegocio,'') = '"~FBN['TipoNegocio']~"' AND ")
         SQL.ADD("      IsNull(Cupon,'')       = '"~FBN['Cupon']~"'       AND ")
         SQL.ADD("      IsNull(Unidad,'')      = '"~FBN['Unidad']~"'      AND ")
         SQL.ADD("      IsNull(Centro,'')      = '"~FBN['Centro']~"'      AND ")
         SQL.ADD("      IsNull(Sector,'')      = '"~FBN['Sector']~"'      AND ")
         SQL.ADD("      IsNull(Sucursal,'')    = '"~FBN['Sucursal']~"'    AND ")
         SQL.ADD("      IsNull(CallPut,'')     = '"~FBN['CallPut']~"'     AND ")
         SQL.ADD("      IsNull(Estrategia,'')  = '"~FBN['Estrategia']~"'    AND ")
         SQL.ADD("      IsNull(Cartera,'') = '"~FBN['Cartera']~"'           AND ")
         SQL.ADD("      IsNull(Trader,'')  = '"~FBN['Trader']~"'            AND ")
         SQL.ADD("      IsNull(Responsable,'') = '"~FBN['Responsable']~"'   AND ")
         SQL.ADD("      IsNull(TipoPosicion,'') = '"~FBN['TipoPosicion']~"' AND ")
         SQL.ADD("      IsNull(Producto,'') = '"~FBN['Producto']~"'         AND ")
         SQL.ADD("      IsNull(GrupoEspecie,'') = '"~FBN['GrupoEspecie']~"' AND ")
         SQL.ADD("      IsNull(CarteraBCRA,'') = '"~FBN['CarteraBCRA']~"' ")
         SQL.NEW
         SQL.EXEC

    endif
  endif

  ACT(l:FAC,  'Recalc')
  IF Dialogo.Check2=1
    ACT(m:FAC, 'SI')

         SQL.ADD("EXEC "~DBO~".RecalculaPosiciones ")
         SQL.ADD(IdxDate2(Dialogo.Fecha1)~", ")
         SQL.ADD(" '"~FBN['Cliente']~"', ")
         SQL.ADD(" '"~FBN['Vehiculo']~"', ")
         SQL.ADD(" '"~FBN['Unidad']~"', ")
         SQL.ADD(" '"~FBN['Centro']~"', ")
         SQL.ADD(" '"~FBN['Sector']~"', ")
         SQL.ADD(" '"~FBN['Sucursal']~"', ")
         SQL.ADD(" "~Fstr(FBN['NrSaldo'],3,0)~", ")
         SQL.ADD(" '"~FBN['Especie']~"', ")
         SQL.ADD(" NULL,")
         SQL.ADD(" NULL,")
         SQL.ADD(" '"~FBN['CallPut']~"', ")
         SQL.ADD(" '"~FBN['Cupon']~"', ")
         SQL.ADD(" '"~FBN['Estrategia']~"', ")
         SQL.ADD(" '"~FBN['Cartera']~"', ")
         SQL.ADD(" '"~FBN['Book']~"', ")
         SQL.ADD(" '"~FBN['Trader']~"', ")
         SQL.ADD(" '"~FBN['TipoNegocio']~"', ")
         SQL.ADD(" '"~FBN['Responsable']~"', ")
         SQL.ADD(" '"~FBN['TipoPosicion']~"', ")
         SQL.ADD(" '"~FBN['Producto']~"', ")
         SQL.ADD(" '"~FBN['GrupoEspecie']~"', ")
         SQL.ADD(" '"~FBN['CarteraBCRA']~"' ")
         SQL.NEW
         SQL.EXEC

  endif
         
Proximo
ENDIF

