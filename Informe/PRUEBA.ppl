ACT(a:4, 'T0007020')
ACT(a:5, 'T0007021')
ACT(a:6, 'T0007022')
ACT(a:7, 'T0007023')
ACT(a:8, 'T0007024')
recorrer&i 1,20
  if NoVacio(Val(a:&i))
    ACT(b:&i, SQLSet("SELECT Tipo FROM "~DBO~".EXCEPCIONES Where NrOperacion='"~Val(a:&i)~"' "))
    ACT(c:&i, SQLSet("SELECT Tipo FROM "~DBO~".EXCEPCIONES Where NrOperacion='"~Val(a:&i)~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE') "))
    ACT(d:&i, Pipe2Comillas(SQLSet("SELECT Tipo FROM "~DBO~".EXCEPCIONES Where NrOperacion='"~Val(a:&i)~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE') ")))
    ACT(e:&i, Copy(Val(d:&i),2,Longitud(Val(d:&i))-2))
  endif
proximo

ACO(2,40)
ACO(3,30)
ACO(4,30)
ENDIF

