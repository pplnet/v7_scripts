CrearDialogo
  NrOperacion1   : 'Operacion'   ;;;;;;NoVacio(Dialogo.NrOperacion1) O [NoVacio(Dialogo.Fecha1) Y NoVacio(Dialogo.Fecha2)];'Ingrese Operacion o Rango de fecha';NO;;;;;;IIF(Dialogo.Radio1=0 ,"TipoOp IN ('DTSFVM')","TipoOp IN ('DTSFFM')"); 
  Fecha1         :'Fecha Desde'   ;;;;;;;;;Fsys;
  Fecha2         :'Fecha Hasta'   ;;;;;;;;;Fsys;
  Radio1         : 'Tipo|Tasa|Moneda';;;;;;;;;0;
FinDialogo

if not OK
  Cancelar
endif


 

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)


**** PRIMERO HAGO UN SELECT PARA OBTENER LOS DATOS DEL ENCABEZADO ****
***---RB9 lo pongo en 0 (cero) para los Caps/Floor para que tome la parte del vehiculo como fija
***---y la de la contraparte como flotante.
SQL.ADD(" SELECT O.NrOperacion, O.Especie, CASE O.TipoOp WHEN 'DTCAP ' THEN  O.RB8 WHEN 'DTFLO ' THEN  O.RB8 ELSE  O.RB5 END RB5, ")
SQL.ADD(" O.RB8, CASE O.TipoOp WHEN  'DTCAP ' THEN 0 WHEN 'DTFLO ' THEN 0 ELSE  O.RB9 END RB9, ")
SQL.ADD(" CASE O.TipoOp WHEN  'DTCAP ' THEN O.Especie WHEN 'DTFLO ' THEN O.Especie ELSE  O.ContraEspecie END ContraEspecie, ")
SQL.ADD(" O.Vehiculo1, C.Fecha1, C.Fecha2, C.Plazo1, O.FechaOp, O.Cliente1, O.TipoOp ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
IF NOVacio(Dialogo.NrOperacion1)
   SQL.ADD(" WHERE O.NrOperacion='"~Dialogo.NrOperacion1~"' AND O.NrOperacion = C.NrOperacion ")
Else
   SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion AND FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha2)~"'   ")
   IF Dialogo.Radio1 = 0 
      SQL.ADD("AND TipoOp in ('DTSFVM')")
   else
      SQL.ADD("AND TipoOp in ('DTSFFM')")
   EndIF
Endif
*SQL.ADD(" Order by 1, ")
SetFilaActual(2)
ACN(nu1,0)
ACN(in1,0)
ACN(pl1,0)
Recorrer SQL
   if FBN['RB8']=0
      ACT(dc1,'Act Act')
   else
      if FBN['RB8']=1
         ACT(dc1,'Act 365 F')
      else
         if FBN['RB8']=2
            ACT(dc1,'Act 360')
         else
            if FBN['RB8']=3
               ACT(dc1,'360 360')
            else
               if FBN['RB8']=4
                  ACT(dc1,'30E 360')
               endif
            endif
         endif
      endif
   endif

   if FBN['RB5']=0
      ACT(dc2,'Act Act')
   else
      if FBN['RB5']=1
         ACT(dc2,'Act 365 F')
      else
         if FBN['RB5']=2
            ACT(dc2,'Act 360')
         else
            if FBN['RB5']=3
               ACT(dc2,'360 360')
            else
               if FBN['RB5']=4
                  ACT(dc2,'30E 360')
               endif
            endif
         endif
      endif
   endif

   SCN(nu1,1)
   SCN(pl1, FBN['Plazo1'])
   ACN(LG:1, Longitud(fbn('Especie')))
   if Val(nu1)=1
      if EqStr(Copy(FBN['Especie'], 1, Val(LG:1)), Copy(FBN['ContraEspecie'], 1, Val(LG:1)))
          *** Es un swap de tasa de interes o Caps
          ACT(tx1,'TASA DE INTERES')
          ACN(in1,1)
      else
          ACT(tx1,'TIPO DE CAMBIO')
      endif
      IF Eqstr(Copy(fbn('TipoOp'), 1, 5), 'DTSFF')
          ACT(TX:2,'FIJA')
          ACT(TX:3,'FIJA')
      ELSE
          ** Veo como paga el Vehiculo
          if FBN['RB9']=1
              ACT(tx2,'FLOTANTE')
              ACT(tx3,'FIJA')
          else
              ACT(tx2,'FIJA')
              ACT(tx3,'FLOTANTE')
          endif       
      ENDIF
      

         ACT(xx:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
         ACT(mo1, FBN['Especie'])
         ACT(mo2, FBN['ContraEspecie'])
         If NoVacio(dialogo.NrOperacion1)
         ACT(a:fac, 'SWAP DE '~IIF(EqStr(Copy(FBN['Especie'], 1, Val(LG:1)),Copy(FBN['ContraEspecie'], 1, Val(LG:1))),'TASA DE INTERES','TIPO DE CAMBIO'))
         SetFont(a:fac,3)
         SetFilaActual(fac+2)
         ACT(a:fac+2, 'Fecha Inicio: '~FBN['Fecha1'])
         ACT(a:fac,   'MinutaNro: ')      
         ACT(b:5, fbn['NrOperacion'])
         ACLO(b:5, fbn['NrOperacion'])
         ACT(a:fac+1, 'Portafolio: '~FBN['Vehiculo1'])
         ACT(a:fac+5, 'Fecha de Concertacion: '~FBN['FechaOp'])
         ACT(a:fac+6, 'Calculo de interes:        Vehiculo: '~Val(dc1))
         ACT(a:fac+7, '                                    Contraparte: '~Val(dc2))
         ACT(a:fac+8, 'Contraparte: '~FBN['Cliente1'])
         ACT(a:fac+3, 'Fecha Vto: '~FBN['Fecha2'])
         ACT(a:fac+4, 'Plazo de op: '~FStr(Val(pl1),0,0)~' dias')
      else
         ACT(a:fac, 'SWAP DE '~IIF(EqStr(Copy(FBN['Especie'], 1, Val(LG:1)),Copy(FBN['ContraEspecie'], 1, Val(LG:1))),'TASA DE INTERES','TIPO DE CAMBIO'))
         SetFont(a:fac,3)
         SetFilaActual(fac+1)
         ACT(a:fac+1, 'Operacion: Todas ')
         ACT(a:fac+2, 'Fecha desde: '~Dialogo.Fecha1)
         ACT(a:fac+3, 'Fecha hasta: '~Dialogo.Fecha2)
    
      endif   
   endif
   ACT(op1, FBN['TipoOp'] )
   dfa

Proximo


