SQL.ADD(" SELECT O.NrOperacion,O.Cuotas1,C.NrCuota, C.Cantidad6 as VNotional,O.FechaEx1 as NotionalDate, C.Total3 VSpread, C.Total4 CSpread, C.Cantidad3 InteresV, C.Cantidad4 InteresC, ")
SQL.ADD(" C.Fecha1 FInicioV,C.Fecha5 FInicioC,C.Plazo1,C.Plazo2, C.Fecha2 FFinV, C.Fecha6 FFinC, O.TipoTasa, O.TipoTasa2, ")
SQL.ADD(" C.Cantidad1 ResidualV, C.Precio1 TasaV, C.Precio2 TasaC, C.Cantidad2 ResidualC,C.Precio4 DiscFactor, C.Cantidad5 CNotional ")
if Incluido(Val(op1),'DTSFV|DTSFF|DTSVV|DTSFVV')
    SQL.ADD(" ,O.FechaPago ")
else
    SQL.ADD(" ,C.Fecha3 FechaPago ")
endif
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
****Pregunto si es para todas las operaciones
IF NOVacio(Dialogo.NrOperacion1)
   SQL.ADD(" WHERE O.NrOperacion='"~Dialogo.NrOperacion1~"' AND O.NrOperacion = C.NrOperacion ")
Else
   SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion AND FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha2)~"'   ")
   IF Dialogo.Radio1 = 0 
      SQL.ADD("AND TipoOp in ('DTSFVM')")
   else
      SQL.ADD("AND TipoOp in ('DTSFFM')")
   EndIF
EndIF 

Recorrer SQL
   ACN(a:fac, FBN['ResidualV'])
   ACN(b:fac, 0)
   ACD(c:fac, FBN['FInicioV'])
   ACN(d:fac, FBN['Plazo1'])
   ACD(e:fac, FBN['FFinV'])
   ACD(f:fac, FBN['FechaPago'])
   IF Vacio(fbn('TipoTasa'))
       ACT(G:fac, 'FIJA')
   ELSE
       ACT(G:fac, fbn('TipoTasa'))
   ENDIF
   ACN(h:fac, FBN['TasaV']+FBN['VSpread'])
   ACN(i:fac, FBN['InteresV'])
   SCN(I:fac, FBN['CNotional'] )
   ***Si son Todas las operaciones
   IF Vacio(Dialogo.NrOperacion1)
      ACT(j:fac,FBN['NrOperacion'] )
      ACLO(J:fac,FBN['NrOperacion'])
   ENDIF
   *- Le sumo al NPV el V Notional en el periodo que corresponde al FechaEx1
   ***---IF FBN['NotionalDate']>VAL(c:fac) y FBN['NotionalDate']<=VAL(e:fac)
   ***---   SCN(h:fac, FBN['VNotional'] )
   ***---EndIf
   ACN(Val(co1)+1:fac, FBN['ResidualC'])
   ACN(Val(co1)+2:fac, 0)
   ACD(Val(co1)+3:fac, FBN['FInicioC'])
   ACN(Val(co1)+4:fac, FBN['Plazo2'])
   ACD(Val(co1)+5:fac, FBN['FFinC'])
   ACD(Val(co1)+6:fac, FBN['FFinC'])
   IF Vacio(fbn('TipoTasa2'))
       ACT(Val(CO:1)+7:fac, 'FIJA')
   ELSE
       ACT(Val(CO:1)+7:fac, fbn('TipoTasa2'))
   ENDIF
   ACN(Val(co1)+8:fac, FBN['TasaC']+FBN['CSpread'])
   ACN(Val(co1)+9:fac, FBN['InteresC'])
   SCN(Val(co1)+9:fac, FBN['VNotional'] )
   ***---If FBN['NrCuota']=FBN['Cuotas1']
      *- Ultima cuota, sumo el notional al interes de la contraparte
   ***---   SCN(Val(co1)+9:fac, FBN['VNotional'] )
   ***---EndIf 
   If Dialogo.Radio1=0
      ACN(Val(co1)+10:fac, val(Val(co1)+9:fac) - val(i:fac))
   Endif
   ***---ACN(Val(co1)+9:fac, FBN['DiscFactor'])
   ***---ACN(Val(co1)+10:fac, (val(Val(co1)+8:fac)-val(h:fac))*FBN['DiscFactor'])


