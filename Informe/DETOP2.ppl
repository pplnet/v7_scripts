      IF Eqstr(Copy(Val(a:&k), 1, 8), 'Subtotal')
         AgregarMarco(a:Val(fi:2)..b:&k-1, 1, 0)
         AgregarMarco(c:Val(fi:2)..m:&k-1, 1, 0)
         AgregarMarco(m:Val(fi:2)..m:&k-1, 1, 0)
         AgregarMarco(N:Val(fi:2)..w:&k-1, 1, 0)
         AgregarMarco(w:Val(fi:2)..x:&k-1, 1, 0)
         AgregarMarco(y:Val(fi:2)..Z:&k-1, 1, 2)
         AgregarMarco(a:&k..b:&k, 1, 0)
         AgregarMarco(c:&k..m:&k, 1, 0)
         AgregarMarco(m:&k..m:&k, 1, 0)
         AgregarMarco(n:&k..w:&k, 1, 0)
         AgregarMarco(w:&k..x:&k, 1, 0)
         AgregarMarco(y:&k..z:&k, 1, 2)
         SetFont(a:Val(fi:2)..z:&k-1, 10)
         SetFont(a:&k..z:&k, 9)
         ACN(fi:2, &k+1)
      ENDIF
   Proximo
   SetFont(a:Val(fi:2)..z:FAC, 10)
   AgregarMarco(a:Val(fi:2)..b:FAC, 1, 0)
   AgregarMarco(a:Val(fi:2)..m:FAC, 1, 0)
   AgregarMarco(m:Val(fi:2)..m:FAC, 1, 0)
   AgregarMarco(n:Val(fi:2)..w:FAC, 1, 0)
   AgregarMarco(w:Val(fi:2)..x:FAC, 1, 0)
   AgregarMarco(y:Val(fi:2)..z:FAC, 1, 2)
ENDIF

