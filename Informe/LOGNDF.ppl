ModoReproceso(SinDialogo)
MostrarCuadrodeMensajes
CrearDialogo
  Fecha1 :       'Desde'      ;1;1;;;;Dialogo.Fecha1>0;;NO;FSys
  Fecha2  :      'Hasta'      ;2;1;;;;Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha Hasta debe er mayor o igual a Fecha Desde!';NO;FSys
  Radio1  :      'Opcion|Separado|Junto';;;;NO;NO;;;;1;
  Label1  : no sancionada a sancionada/estado sancionada o no sancionada/no informada a sancionada/ no informada a no sancionada/todas
  Lista1  :      'Especies'   ;-2;2;;NO;NO;;;;'EVENTOS|FUNCIONES|INFORMES|TIPOSOPERACION|TIPOSTRANSACCION2|ABMS|FORMULAS';;Dialogo.Lista2
  Operador:      'Usuario'    ;;;;;;;;;
FinDialogo

If not Ok
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')


ACT(d3, 'Log Modificaciones Operaciones NDF')

SetFont(d3,3)

ACT(a5, 'Desde: '~Dialogo.Fecha1~'    Hasta: '~Dialogo.Fecha2)
If NoVacio(Dialogo.NrOperacion1)
   ACT(a6, 'Operacion: '~Dialogo.NrOperacion1)
Endif
ACT(a8, 'Usuario')
ACT(b8, 'Fecha')
ACT(c8, 'Accion')
ACT(d8, 'Tabla')
ACT(e8, 'Codigo')
ACT(f8, 'Campo')
ACT(g8, 'Val.Anterior')
ACT(h8, 'Val.Actual')
AgregarMarco(a8..h8,1,0,Exe('COLOR6'))

SetFont(a5..h8, 1)

SetFilaActual(8)

message('Recuperando auditoria de Script...')
SQL.ADD("Select Codigo,Accion,Fecha,ValorAnterior,ValorActual,Operador,Campo ")
SQL.ADD("  From "~DBO~".PMAUDIT  ")
SQL.ADD(" where Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha <= '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD(" and Tabla = 'OPERACIONES' ")
SQL.ADD(" and Campo in ('FechaVto','FechaVto2','TasaEspecie','Mercado2','ContraEspecie2','Cuenta4','Cuenta3','FechaAltaSisExterno','Arancel4','TipoTasa','Sector1','Sector2','FechaUltCupon','Arancel3') ")
If NoVacio(Dialogo.NrOperacion1)
SQL.ADD(" and Codigo = '"~Dialogo.NrOperacion1 ~"'")
Else
SQL.ADD(" and Codigo IN ( Select NrOperacion ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".MERCADOS M  ")   
SQL.ADD(" WHERE O.Tipoop in('FXCF','FXVF')")   
SQL.ADD("   AND O.Mercado4=M.Codigo ")   
SQL.ADD("   AND M.Regulado='NO') ")
Endif
IF NoVacio(Dialogo.Operador)
   SQL.ADD(" and Operador = '"~Dialogo.Operador ~"' ")
Endif
SQL.ADD("order by Fecha, Codigo, Campo, Accion  ")
Watch(sql.Batch)
Recorrer SQL

  acn(x1, 0)
  
  if Not EqStr(Val(z1), fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(z1,    fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(a:fac, fbn('Operador'))
      ACT(b:fac, fbn('Fecha'))
      ACT(c:fac, fbn('Accion'))
      ACT(e:fac, fbn('Codigo'))
      scn(x1, 1)
    endif
    if [EqStr(fbn('Accion'),'A') y NoVacio(fbn('ValorActual'))] o [EqStr(fbn('Accion'),'M') y Not EqStr(fbn('ValorActual'),fbn('ValorAnterior'))]
      IF EqStr(fbn('Campo'),'FechaVto')
         ACT(f:fac, 'Nva.F.Vto')
      Else
         IF EqStr(fbn('Campo'),'FechaVto2')
            ACT(f:fac, 'Nva.F.FIX')
         Else
            IF EqStr(fbn('Campo'),'TasaEspecie')
               ACT(f:fac, 'Nva.Mon.Liq')
            Else
               IF EqStr(fbn('Campo'),'Mercado2')
                  ACT(f:fac, 'Nvo.Mer.Liq')
               Else
                  IF EqStr(fbn('Campo'),'Cuenta4')
                     ACT(f:fac, 'Nva.Cta.Cli')
                  Else
                     IF EqStr(fbn('Campo'),'Cuenta3')
                        ACT(f:fac, 'Nva.Cta.Veh')
                     Else
                        IF EqStr(fbn('Campo'),'ContraEspecie2')
                           ACT(f:fac, 'Nva.Esp.FIX')
                        Else
                           IF EqStr(fbn('Campo'),'FechaAltaSisExterno')
                              ACT(f:fac, 'F.Vto.Pend')
                           Else
                              IF EqStr(fbn('Campo'),'FechaUltCupon')
                                 ACT(f:fac, 'F.FIX.Pend')
                              Else
                              IF EqStr(fbn('Campo'),'Arancel4')
                              ACT(f:fac, 'Mon.Liq.Pend')
                                 Else
                                    IF EqStr(fbn('Campo'),'TipoTasa')
                                       ACT(f:fac, 'Mer.Liq.Pend')
                                    Else
                                       IF EqStr(fbn('Campo'),'Sector1')
                                          ACT(f:fac, 'Cta.Cli.Pend')
                                       Else
                                          IF EqStr(fbn('Campo'),'Sector2')
                                            ACT(f:fac, 'Cta.Veh.Pend')
                                          Else
                                             IF EqStr(fbn('Campo'),'Arancel3')
                                                ACT(f:fac, 'Esp.FIX.Pend')
                                             Endif
                                          Endif
                                       Endif
                                    Endif
                                 Endif
                              Endif
                           Endif
                        Endif
                     Endif
                  Endif
               Endif
            Endif
         Endif
      Endif
      ACT(g:fac, fbn('ValorAnterior'))
      ACT(h:fac, fbn('ValorActual'))
    else
      if Val(x1) = 0
        dfa
      endif
    endif

Proximo

SetFont(a9..z:fac, 2)


SetFilaActual(fac+2)
ACT(a:fac, 'Fin del Informe')
SetFont(a:fac,1)

RangoTitulo(a1..h:fac, 7)

ACO(1,8)
ACO(3,5)
ACO(4,16)
ACO(5,14)


ACO(2,13)
ACO(6,12)
ACO(7,14)
ACO(8,14)
ACO(9,1)
LimitesVision(i:fac+1)
SetPrintFit(3,80)


