CrearDialogo
    Fecha1 : 'Date'            ;1;1;;;;;;;FSys
    Radio1:  'Prueba|Corchetes|TablaAux' ;3;;;;;;;;0   
    Check1:  'Corchetes' ;5;;;;Radio1=0    
FinDialogo

If Not ok
  Cancelar
Endif
*************
*PRUEBA CORCHETES
*************
If Dialogo.Radio1 = 0
    SQL.ADD(" SELECT * FROM ( ")
    SQL.ADD("             Select   ")
    If Dialogo.Check1 = 1    
        SQL.ADD("                     Estrategia           [Portfolio],                         ")
        SQL.ADD("                       Cotiza               [Sec_Currency],                      ")
    Endif    
    SQL.ADD("                     Especie               Security                           ")
    SQL.ADD("                     from dbo.POSICIONES P    ")
    SQL.ADD("                     inner join dbo.cuentas  CTA  on P.Estrategia = CTA.Codigo    ")
    SQL.ADD("                     inner join dbo.especies ESP  on ESP.Codigo = Especie ")
    SQL.ADD("                     where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~"  and NrSaldo = 121 ) as AUX ")

Else
*************
*PRUEBA AUXILIAR
*************
    SQL.ADD("select * From (      ")
    SQL.ADD("select                                                              ")
    SQL.ADD(" Estrategia           [Portfolio],                         ")
    SQL.ADD("   Cotiza               [Sec_Currency],                      ")
    SQL.ADD("   Especie               Security,                           ")
    SQL.ADD("   sum(Cantidad)        [Face_Value]                        ")
    SQL.ADD(" from (  ")
    ** Empieza el Sub-Select
    SQL.ADD("select                                                              ")
    SQL.ADD(" Estrategia, ")
    SQL.ADD("   Cotiza, ")
    SQL.ADD("   Especie, ")
    SQL.ADD("   CantidadFin Cantidad ")
    SQL.ADD("from "~DBO~".POSICIONES P   ")
    SQL.ADD("      inner join "~DBO~".cuentas  CTA  on P.Estrategia = CTA.Codigo   ")
    SQL.ADD("      inner join "~DBO~".especies ESP  on ESP.Codigo = Especie      ")
    SQL.ADD("where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
    SQL.ADD("and NrSaldo = 121  ")
    SQL.ADD("  and (CantidadFin >= 0.01 or CantidadFin <= -0.01)  ")
    SQL.ADD("  AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES P1 ")
    SQL.ADD("                   WHERE P1.Especie    = P.Especie  ")
    SQL.ADD("                   AND   P1.Vehiculo   = P.Vehiculo ")
    SQL.ADD("                   AND   P1.NrSaldo    = P.NrSaldo  ")
    SQL.ADD("                   AND   P1.Cliente    = P.Cliente  ")
    SQL.ADD("                   AND   P1.Book       = P.Book     ")
    SQL.ADD("                   AND  P1.Fecha      <= "~idxdate2(Dialogo.Fecha1)~" ")
    SQL.ADD("                 ) ")
    SQL.ADD(" ) TABLAAUX ")
    SQL.ADD("group by ")
    SQL.ADD("   Estrategia, ")
    SQL.ADD("   Cotiza, ")
    SQL.ADD("   Especie ")
    SQL.ADD(" ) Aux ")
    SQL.ADD("order by ")
    SQL.ADD("   Portfolio, ")
    SQL.ADD("   Sec_Currency, ")
    SQL.ADD("   Security ")
Endif

Recorrer SQL
    ACT(A:FAC, FBN['Portfolio'])
    ACT(B:FAC, FBN['Sec_Currency'])
    ACT(C:FAC, FBN['Security'])
Proximo



