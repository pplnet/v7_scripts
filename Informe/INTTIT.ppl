CrearDialogo
  Fecha1       :'Fecha Vto.' ;1;1; ;;;Dialogo.Fecha1<=FSys;'Debe Ingresar una Fecha de vencimiento valida';NO;FSys;iF(NoVacio(Dialogo.NrOperacion1),SQL("SELECT FechaVto FROM "~DBO~".OPERACIONES WHERE NrOperacion='"~Dialogo.NrOperacion1~"' "),FSys)
  Cliente1     :'Cliente'    ; ; ; ;;;;
  TipoOp1      :'Tipo Op.'   ; ; ; ;;;;;;;;;;;"Codigo in('TICO','TICT','TIDE','TIPO')"  
  NrOperacion1 :'Operacion'  ; ; ; ;;;;;;;;;;;"TipoOp in('TICO','TICT','TIDE','TIPO') and FechaVto="~IdxDate2(Dialogo.Fecha1)
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT O.TipoOp, O.Cliente1, O.NrOperacion, O.Especie, O.Cantidad, O.Contraespecie, ")
SQL.ADD("       O.Plazo, O.Precio1, O.TotalIntereses, O.Precio2, O.TotalBrutoCli3, C.RazonSocial ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C  ")
SQL.ADD(" WHERE O.Cliente1=C.Codigo ")
IF NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("   AND NrOperacion='"~Dialogo.NrOperacion1~"'")
   SQL.ADD("   AND TipoOp in('TICO','TICT','TIDE','TIPO') ")
ELSE       
   SQL.ADD("   AND FechaVto="~IdxDate2(Dialogo.Fecha1))
   IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("   AND Cliente1='"~Dialogo.Cliente1~"' ")
   ENDIF
   IF NoVacio(Dialogo.TipoOp1)
      SQL.ADD("   AND TipoOp='"~Dialogo.TipoOp1~"' ")
   Else
      SQL.ADD("   AND TipoOp in('TICO','TICT','TIDE','TIPO') ")
   ENDIF
ENDIF
SQL.ADD(" ORDER BY Tipoop, Cliente1 , Contraespecie")

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))
SetFilaActual(4)
ACT(d:Fac, 'Intereses de prestamos/depositos de Titulos')
SetFont(a:fac..d:fac,3)
SetFilaActual(fac+2)
ACT(a:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
If NoVacio(Dialogo.NrOperacion1)
   ACT(a:fac,'Operacion: '~Dialogo.NrOperacion1)
   dfa
else
   ACT(a:fac,'Cliente: '~IIF(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
   ACT(a:fac+1,'TipoOp: '~IIF(NoVacio(Dialogo.TipoOp1),Dialogo.TipoOp1,'TICO - TICT - TIDE - TIPO'))
endif   
SetFont(a:fac-1..a:fac+3,2)

SetFilaActual(fac+3)

ACT(a:fac, 'Tipo Operacion')
ACT(b:fac, 'Cliente')
ACT(c:fac, 'Nro.Operacion')
ACT(d:fac, 'Especie')
ACT(e:fac, 'Moneda')
ACT(f:fac, 'Plazo')
ACT(g:fac, 'Valor Nominal' )
ACT(h:fac, 'Tasa')
ACT(i:fac, 'Ints.VN')
ACT(j:fac, 'Precio Ints.')
ACT(k:fac, 'Ints.Moneda')
AlinearCeldas(f:fac..k:fac,'D')
SetFont(a:fac..k:fac,2)
AgregarMarco(a:fac..k:fac,0,0,Exe('COLOR'))

acn(w:1,FAC+1)
dfa
Recorrer SQL
   If Not Eqstr(FBN['TipoOp'],val(w:2))
      ifa
   endif 
   ACT(w:2,FBN['TipoOp'])  
   ACT(a:fac, fbn['TipoOp'])
   ACT(b:FAC, fbn['Cliente1']~' - '~Copy(fbn['RazonSocial'],1,30))
   ACT(c:fac, fbn['NrOperacion'])
   ACLO(c:fac, fbn['NrOperacion'])
   ACT(d:fac, fbn['Especie'])
   ACT(e:fac, fbn['Contraespecie'])
   ACN(f:fac, fbn['Plazo'])
   ACN(g:fac, fbn['Cantidad'])
   ACN(h:fac, fbn['Precio1'])
   ACN(i:fac, fbn['TotalIntereses'])
   ACN(j:fac, fbn['Precio2'])
   ACN(k:fac, fbn['TotalBrutoCli3'])
Proximo
SetFont(a:val(w:1)..k:fac,1)

ACO(1, 9)
ACO(2,25)
ACO(3, 9)
ACO(4, 8)
ACO(5, 8)
ACO(6, 5)
ACO(7,15)
ACO(8,10)
ACO(9,15)
ACO(10,10)
ACO(11,15)
ACO(12,1)


FormatoCeldas(f:val(w:1)..f:fac,Exe('F0'))
FormatoCeldas(g:val(w:1)..k:fac,Exe('F2'))
FormatoCeldas(h:val(w:1)..j:fac,Exe('F9'))
FormatoCeldas(i:val(w:1)..i:fac,Exe('F8'))
SetFilaActual(fac+2)
ACT(a:fac, 'Fin del Listado ')

LimitesVision(l:fac)
