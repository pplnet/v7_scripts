CrearDialogo
  Fecha1         :  'Fecha Desde'                     ;1;1;;;;Dialogo.Fecha1>0;'Debe agregar una fecha de inicio';NO;FSYS;
  Fecha2         :  'Fecha Hasta'                     ;2;1;;;;Dialogo.Fecha2>Dialogo.Fecha1;'La fecha de fin no puede ser menor a la fecha de inicio';NO;FSYS+1;
  String1        :  'Tipo Especie'                    ;1;2;;Dialogo.CHECK1=0;;IF(Dialogo.Check1=0,NoVacio(Dialogo.String1));'Debe seleccionar un tipo de especie';NO;;IIF(Dialogo.Check1=1,Null,);SQLSet("Select Distinct Tipo from "~DBO~".ESPECIES Where Tipo IN ('PUB','PRI','ONE','FON','MON','OTR','IND')")
  Check1         :  'Todos'                           ;2;2;;;;;;;SI;;;;;;;;;;;;;;
  Lista1         :  'Especies'                        ;3;2;;;;;;;;;IF(Dialogo.CHECK1=1,SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB'"),SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB'and Tipo='"~Dialogo.String1~"'"))
FinDialogo

If Not OK
    Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,12,B")
CrearFont(3,"Arial,8,B")
********************************************************VERIFICACION DE SELECCION DE ESPECIES***************************************************
IF NoVacio(Dialogo.Lista1)
    let &ListaEspecies Dialogo.Lista1 
Else
    IF Dialogo.Check1=1
        let &ListaEspecies SQLSet("Select Distinct Codigo From "~DBO~".ESPECIES Where Status = 'HAB'")
    Else
        let &ListaEspecies SQLSet("Select Distinct Codigo From "~DBO~".ESPECIES Where Tipo = '"~Dialogo.String1~"' and Status = 'HAB'")
    Endif
Endif
******************************************************************TITULOS***************************************************************

ACT(E:1,'EVOLUCION COTIZACIONES DE CIERRE POR FECHA')
SetFont(E:1..E:1,2)
ifa
ifa
ifa
ACT(A:fac,'Desde : '~Dialogo.Fecha1~ ' Hasta : ' ~Dialogo.Fecha2)
SetFont(A:fac..A:fac,3)
ifa
ifa
ifa

****************************************************************SQL**********************************************************************

SQL.ADD("Select Codigo,Fecha,Precio1,1 From "~DBO~".COTIZACIONES ")
SQL.ADD("Where (Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"') and Codigo IN ("~Pipe2Comillas(Val(ZZ:1))~")")
SQL.ADD(" ORDER BY Codigo,Fecha ")

**************************************************************VARIABLES********************************************************************
let &FechaEnCurso Fsys
let &ComienzoEspecies 2
let &ColEspecieEnCurso &ComienzoEspecies
let &ComienzoFechas fac
let &Fecha Dialogo.Fecha1
let &DifDias DifDias(Dialogo.Fecha1,Dialogo.Fecha2,'ARG',NO)
let &LengthEspecies Longitud(&ListaEspecies)

********************************************************************CARGA ESPECIES**********************************************************
Recorrer&i &ComienzoEspecies,1000
    IF Vacio(&ListaEspecies)
        break
    Endif
    ACT(&i:5,Copy(&ListaEspecies,1,Posicion('|',&ListaEspecies)-1))
    let &ListaEspecies Copy(&ListaEspecies,Posicion('|',&ListaEspecies)+1,&LengthEspecies)
    let &LengthEspecies Longitud(&ListaEspecies)
    let &ColEspecieEnCurso &ColEspecieEnCurso+1
    
Proximo
*********************************************************CARGA PRECIOS Y ESPECIES************************************************************
Recorrer&i &ComienzoFechas,&ComienzoFechas+&DifDias
    ACD(A:&i,&Fecha)
    let &Fecha &Fecha+1
    Recorrer&j &ComienzoEspecies,&ColEspecieEnCurso-1
        ACN(&j:&i,Cotizacion(Val(&j:5),,,,Val(A:&i),1))
    Proximo
Proximo
*****************************************************************************************************************************************************
FormatoCeldas(&ComienzoEspecies:&ComienzoFechas..&ColEspecieEnCurso-1:&ComienzoFechas+&DifDias,Exe('F8'))
SetFilaActual(&ComienzoFechas+&DifDias)
ifa
ifa
ACT(A:fac,'Fin del Reporte')
SetFont(A:fac..A:fac,3)
SetFont(&ComienzoEspecies:5..&ColEspecieEnCurso-1:5,3)
SetFont(A:&ComienzoFechas..A:&ComienzoFechas+&DifDias,3)

AgregarMarco(&ComienzoEspecies-1:5..&ColEspecieEnCurso-1:5,2,1,Exe('COLOR6'))
AgregarMarco(A:&ComienzoFechas-1..A:&ComienzoFechas+&DifDias,2,2,Exe('COLOR6'))

let &ColumnaLimite &ColEspecieEnCurso

IF &ColEspecieEnCurso-1<11
    let &ColumnaLimite 11
Endif


LimitesVision(&ColumnaLimite:fac)
