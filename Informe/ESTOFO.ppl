*INFORME
*CODIGO: ESTOFO
*TIPO: FONDOS
*NOMBRE: Estado de Operaciones de Fondos

ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1:'Vehiculo' ;;;;;;;;;Var('VEHICULODE')
  Fecha1   :'F.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha2   :'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")


SetFilaActual(3)


ACT(a:FAC, 'Estado de Operaciones de Fondos')
SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+2)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo: '~Dialogo.Vehiculo1)
  else
   ACT(a:FAC+1, 'Vehiculo: Todos')
endif
ACT(a:FAC+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Instancia')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'Fecha Op.')
ACT(d:FAC, 'Fecha Vto.')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Tipo Op.')
ACT(g:FAC, 'Cliente')
ACT(h:FAC, 'Cantidad')
ACT(i:FAC, 'Precio/Tasa')
ACT(j:FAC, 'Hora Carga')
ACT(k:FAC, 'Operador')



AlinearCeldas(a:FAC..g:FAC,'I')
AlinearCeldas(h:FAC..i:FAC,'D')
AlinearCeldas(j:FAC..n:FAC,'I')
SetFont(a:5..n:FAC,2)
*AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR'))
AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(z1, "Vehiculo1 = '"~Dialogo.Vehiculo1~"' and ")
endif

SQL.ADD("Select TipoOp, NrOperacion, FechaOp, FechaCarga, FechaVto, Especie, FechaEj, PrecioEj, PaseCB, Cliente1, Cantidad, Precio1, Vehiculo1, Operador, Arbitraje, CB5, RB3, ContraEspecie, FechaPrecan, TasaPrecan")
SQL.ADD(" from "~DBO~".OPERACIONES where "~Val(z1) ~"")
SQL.ADD("TipoOp in('FCS','FCR') and ")
SQL.ADD("FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by NrOperacion")

recorrer SQL
  SCN(z2,1)

  ACN(z3, SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~fbn('NrOperacion')~"' and Valor = '1' "))
  ACT(z4, FStr(Val(z3),1,0)~' '~SQL("Select Nombre from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and NrInstancia= "~Val(z3)~" "))
  ACT(A:FAC, Val(z4))

  * color para la instancia
  if Incluido(Fstr(Val(z3),1,0),'5|30|31|40|41|42|43|44|69|75|76')
    ColorCeldas(A:fac,clRED)
  else
    if EqStr(Fstr(Val(z3),1,0),'70')
      ColorCeldas(A:fac,clGREEN)
    else
      ColorCeldas(A:fac,clBLUE)
    endif
  endif
  ACT(b:FAC, FBN['NrOperacion'])
  ACT(c:FAC, FBN['FechaOp'])
  ACT(e:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  if Incluido(fbn('TipoOp'), 'MMDIVA')
    ACT(e:fac, fbn('Especie')~' ('~fbn('ContraEspecie')~')')
  endif
  ACT(f:FAC, FBN['TipoOp'])
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('PaseCB')=1
    ACT(f:FAC, Val(f:FAC)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('RB3')=1
    ACT(f:FAC, Val(f:FAC)~' x Bolsa')
  endif

  if Incluido(fbn('TipoOp'),'TIPA|TIPP|TIC|TIFC|TIV|TIFV') y fbn('CB5')=1
    ACT(f:FAC, Val(f:FAC)~' (Of.)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(f:FAC, Val(f:FAC)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(f:FAC, Val(f:FAC)~' x Arb.')
  endif
  if Incluido(fbn('TipoOp'), 'TCC|TVC|TCP|TVP')
    ACT(e:FAC, FBN['Especie']~' '~FBN['PrecioEj'])
    ACN(z6, 1)
  endif

  if EqStr(fbn('TipoOp'),'MMPFP')
    ACT(d:FAC, FBN['FechaPrecan'])
    ACN(i:FAC, FBN['TasaPrecan'])
  else
    ACT(d:FAC, FBN['FechaVto'])
    ACN(i:FAC, FBN['Precio1'])
  endif

  ACT(g:FAC, FBN['Cliente1'])
  ACN(h:FAC, FBN['Cantidad'])
  ACT(j:fac, Copy(fbn('FechaCarga'),11,10))
 
*  ACT(J:FAC, FBN['Vehiculo1'])
  ACT(k:FAC, FBN['Operador'])
*  ACT(l:fac, SQL("Select Usuario from "~DBO~".INSTANCIASOP where NrOperacion = '"~FBN('NrOperacion')~"' and NrInstancia = 1"))
*  ACT(m:fac, SQL("Select Usuario from "~DBO~".INSTANCIASOP where NrOperacion = '"~FBN('NrOperacion')~"' and NrInstancia = 69"))
*  ACT(n:fac, SQL("Select Usuario from "~DBO~".INSTANCIASOP where NrOperacion = '"~FBN('NrOperacion')~"' and NrInstancia = 61"))
  AlinearCeldas(c:FAC..d:FAC,'D')
  FormatoCeldas(I:fac..I:fac,Exe('F7'))
  ACLO(b:fac, Val(b:fac))
proximo

SetFont(a:Val(w1)+6..n:FAC,1)

ACO(1,14)
ACO(2,7)
ACO(3,7)
ACO(4,7)
if Val(z6)=1
  ACO(5,10)
else
  ACO(5,6)
endif
ACO(6,9)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,6)
ACO(11,6)
ACO(12,8)
ACO(13,8)
ACO(14,8)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
*LimitesVision(n:FAC)
LimitesVision(l:FAC)
*RangoTitulo(a:1..n:FAC, Val(w1)+5)

*AgregarBMP(a1, Exe('LOGO'), Exe('ESCALOGO'))
ACT(a5, 'Cantidad de Operaciones : '~FStr(Val(z2),4,0))
SetFont(a4..a5,2)

CrearFont(6,"Arial,6,B")
*RangoTitulo(a:10..l:FAC, 1)
Impresion(2, 1) 
Impresion(3, 1) 
Impresion(4, 1) 

 