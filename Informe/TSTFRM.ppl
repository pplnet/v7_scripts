CrearDialogo
    Precio1     : 'Precio'   ;1;1;;NO;;Precio1 > 0;"Debe ingresar un precio";No;100;
    Cantidad1   : 'Cantidad' ;1;2;;NO;;Cantidad1 > 0;"Debe ingresar una cantidad";No;200;
    String1     : 'Total'    ;2;1;;NO;;;;;#TMIFRM;
FinDialogo

If Not OK
    Cancelar
EndIf

ACT(A1, 'Precio: ' ~ Dialogo.Precio1)
ACT(A2, 'Cantidad: ' ~ Dialogo.Cantidad1)
ACT(A3, 'Total (formula): ' ~ #TMIFRM)
ACT(A4, 'Total (dialogo): ' ~ Dialogo.String1)
