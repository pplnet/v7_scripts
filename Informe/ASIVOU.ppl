ModoReproceso(ConDialogo)
CrearDialogo
  Radio1      :'Por|Operacion|Voucher';1;1;;;;;;;1;
  NrTrans1    :'Desde_Vouch';2;1;;Dialogo.Radio1=1;;
  NrTrans2    :'Hasta_Vouch';2;2;;Dialogo.Radio1=1;;Eqstr(Dialogo.NrTrans1,Dialogo.NrTrans2) o Gtstr(Dialogo.NrTrans2,Dialogo.NrTrans1);'Error en Rango de Transacciones';NO;Dialogo.NrTrans1;Dialogo.NrTrans1
  NrOperacion1:'Desde_Op';3;1;;Dialogo.Radio1=0;;
  NrOperacion2:'Hasta_Op';3;2;;Dialogo.Radio1=0;;Eqstr(Dialogo.NrOperacion1,Dialogo.NrOperacion2) o Gtstr(Dialogo.NrOperacion2,Dialogo.NrOperacion1);'Error en Rango de Operaciones';NO;Dialogo.NrOperacion1;Dialogo.NrOperacion1
  Fecha1      :'D.FechaValor'     ;4;1;;;;NOVACIO(Dialogo.Fecha1) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha2      :'H.FechaValor'     ;4;2;;;;NOVACIO(Dialogo.Fecha2) ;'Debe ingresar una fecha valida' ;NO;;Dialogo.Fecha1
  Fecha3      :'D.FechaGeneracion';5;1;;;;NOVACIO(Dialogo.Fecha3) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha4      :'H.FechaGeneracion';5;2;;;;NOVACIO(Dialogo.Fecha4) ;'Debe ingresar una fecha valida' ;NO;;Dialogo.Fecha3
  Cliente1    :'Cliente'          ;6;1;;
  TipoAsiento1:'TipoAsiento'      ;7;1;;
  Vehiculo1   :'Vehiculo'         ;8;1;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

AgregarBMP(a1,Exe('LOGO'),50)
If Dialogo.Radio1=0
  ACT(a3, 'Asientos Generados por Operacion')
  ACT(a4, 'Desde Operacion: '~Dialogo.NrOperacion1)
  ACT(a5, 'Hasta Operacion: '~Dialogo.NrOperacion2)
Else
  ACT(a3, 'Asientos Generados por Vouchers')
  ACT(a4, 'Desde Voucher: '~Dialogo.NrTrans1)
  ACT(a5, 'Hasta Voucher: '~Dialogo.NrTrans2)
Endif

ACT(d4, 'Desde FechaValor: '~FECHA(Dialogo.Fecha1,'dd/mm/yyyy'))
ACT(d5, 'Hasta FechaValor: '~FECHA(Dialogo.Fecha2,'dd/mm/yyyy'))

ACT(g4, 'Desde FechaGeneracion: '~FECHA(Dialogo.Fecha3,'dd/mm/yyyy'))
ACT(g5, 'Hasta FechaGeneracion: '~FECHA(Dialogo.Fecha4,'dd/mm/yyyy'))

ACT(a6, 'Cliente: '~IIF(NOVACIO(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))   
ACT(a7, 'Tipo de Asiento: '~IIF(NOVACIO(Dialogo.TipoAsiento1),Dialogo.TipoAsiento1,'Todos'))

SetFont(a:1..l:7, 1)
SetFont(a:3, 3)
SetFilaActual(7)

SQL.ADD(" SELECT A.NrOperacion, A.NrUnicoAsiento, A.Especie1, A.DebitoCredito, ")
SQL.ADD(" A.*, O.TipoOp, O.FechaOp, C.FechaValor, C.FechaGeneracion, C.Modelo, ")
SQL.ADD(" N.TipoAsiento, A.NrItem, M.Detalle, O.Cliente1, O.FechaVto, O.FechaPago, ")
SQL.ADD(" C.NrAsiento, A.Especie1, O.Puesto, O.ValorRB1, A.CentroCosto, T.Nombre, C.Vehiculo ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,  ")
SQL.ADD(" "~DBO~".ASIENTOSCON1 A, "~DBO~".ASIENTOSCON C LEFT OUTER JOIN "~DBO~".MODELOSASIENTO M2 ON C.Modelo=M2.Codigo , ")
SQL.ADD(" "~DBO~".MODELOSASIENTO1 M,  "~DBO~".MODELOSASIENTO N,  "~DBO~".TIPOSOPERACION T")
SQL.ADD(" WHERE A.NrOperacion      = O.NrOperacion                  ")
SQL.ADD(" AND   A.NrUnicoAsiento   = C.NrUnicoAsiento               ")
SQL.ADD(" AND   C.FechaValor      >= '"~IdxDate(Dialogo.Fecha1)~  "'")
SQL.ADD(" AND   C.FechaValor      <= '"~IdxDate(Dialogo.Fecha2)~  "'")
SQL.ADD(" AND   C.FechaGeneracion >= '"~IdxDate(Dialogo.Fecha3)~  "'")
SQL.ADD(" AND   C.FechaGeneracion <= '"~IdxDate(Dialogo.Fecha4)~  "'")
SQL.ADD(" AND   O.TipoOp           = T.Codigo                       ")
SQL.ADD(" AND   C.Modelo           = N.Codigo                       ")


If Dialogo.Radio1=0
  IF NOVACIO(Dialogo.NrOperacion1)
    SQL.ADD(" AND   A.NrOperacion >= '"~Dialogo.NrOperacion1~     "'")
  ENDIF
  IF NOVACIO(Dialogo.NrOperacion2)
    SQL.ADD(" AND   A.NrOperacion <= '"~Dialogo.NrOperacion2~     "'")
  ENDIF
Else
  IF NOVACIO(Dialogo.NrTrans1)
    SQL.ADD(" AND   A.NrTrans2 >= '"~Dialogo.NrTrans1~     "'")
  ENDIF
  IF NOVACIO(Dialogo.NrTrans2)
    SQL.ADD(" AND   A.NrTrans2 <= '"~Dialogo.NrTrans2~     "'")
  ENDIF
Endif

IF NOVACIO(Dialogo.Cliente1)
   SQL.ADD(" AND   O.Cliente1      = '"~Dialogo.Cliente1~         "'")
ENDIF
IF NOVACIO(Dialogo.TipoAsiento1)
   SQL.ADD(" AND   N.TipoAsiento   = '"~Dialogo.TipoAsiento1~"'     ")
ENDIF
If NOVACIO(Dialogo.Vehiculo1)
  SQL.ADD(" AND   C.Vehiculo      = '"~Dialogo.Vehiculo1~         "'")
Endif
SQL.ADD(" UNION ")
SQL.ADD(" SELECT A.NrOperacion, A.NrUnicoAsiento, A.Especie1, A.DebitoCredito, ")
SQL.ADD(" A.*, R.TipoTr2, R.Fecha2, C.FechaValor, C.FechaGeneracion, C.Modelo, ")
SQL.ADD(" N.TipoAsiento, A.NrItem, M.Detalle, R.Cliente1, R.Fecha5, R.Fecha5, ")
SQL.ADD(" C.NrAsiento, A.Especie1, '', '', A.CentroCosto, T.Nombre, C.Vehiculo ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 R, ")
SQL.ADD(" "~DBO~".ASIENTOSCON1 A, "~DBO~".ASIENTOSCON C LEFT OUTER JOIN "~DBO~".MODELOSASIENTO M2 ON C.Modelo=M2.Codigo, ")
SQL.ADD(" "~DBO~".MODELOSASIENTO1 M,  "~DBO~".MODELOSASIENTO N,  "~DBO~".TIPOSTRANSACCION2 T")
SQL.ADD(" WHERE A.NrOperacion      = R.NrTrans                      ")
SQL.ADD(" AND   A.NrUnicoAsiento   = C.NrUnicoAsiento               ")
SQL.ADD(" AND   C.FechaValor      >= '"~IdxDate(Dialogo.Fecha1)~  "'")
SQL.ADD(" AND   C.FechaValor      <= '"~IdxDate(Dialogo.Fecha2)~  "'")
SQL.ADD(" AND   C.FechaGeneracion >= '"~IdxDate(Dialogo.Fecha3)~  "'")
SQL.ADD(" AND   C.FechaGeneracion <= '"~IdxDate(Dialogo.Fecha4)~  "'")
SQL.ADD(" AND   C.Modelo           = N.Codigo                       ")

SQL.ADD(" AND   R.TipoTr2          = T.Codigo                       ")

If Dialogo.Radio1=0
  IF NOVACIO(Dialogo.NrOperacion1)
    SQL.ADD(" AND   A.NrOperacion >= '"~Dialogo.NrOperacion1~     "'")
  ENDIF
  IF NOVACIO(Dialogo.NrOperacion2)
    SQL.ADD(" AND   A.NrOperacion <= '"~Dialogo.NrOperacion2~     "'")
  ENDIF
Else
  IF NOVACIO(Dialogo.NrTrans1)
    SQL.ADD(" AND   A.NrTrans2 >= '"~Dialogo.NrTrans1~     "'")
  ENDIF
  IF NOVACIO(Dialogo.NrTrans2)
    SQL.ADD(" AND   A.NrTrans2 <= '"~Dialogo.NrTrans2~     "'")
  ENDIF
Endif

IF NOVACIO(Dialogo.Cliente1)
   SQL.ADD(" AND   R.Cliente1 = '"~Dialogo.Cliente1~"'")
ENDIF
IF NOVACIO(Dialogo.TipoAsiento1)
   SQL.ADD(" AND   N.TipoAsiento = '"~Dialogo.TipoAsiento1~"'")
ENDIF
If NOVACIO(Dialogo.Vehiculo1)
  SQL.ADD(" AND   C.Vehiculo = '"~Dialogo.Vehiculo1~"'")
Endif
SQL.ADD(" ORDER BY  1,2,3,4")

ACN(pr1,0)
ACN(pr2,0)
ACN(fa1, 9)


Recorrer SQL

  IF NOT EqStr(fbn('NrOperacion'), Val(oa1)) 
     ifa
     SetFont(a:val(fa1)..z:fac-1, 2)
     message(fbn('NrOperacion'))
     ACT(a:fac, fbn('NrOperacion')~'  '~fbn('TipoOp')~' '~fbn('Nombre'))
     ACLO(a:fac, fbn('NrOperacion'))
     ACT(oa1, fbn('NrOperacion'))
     ACT(ea1, fbn('Especie1'))
     SetFont(a:fac..z:fac, 1)
     AgregarMarco(a:fac..r:fac,1,0,EXE('COLOR'))
     ifa
     ACT(a:fac, 'Nro')
     ACT(b:fac, 'Modelo/Item')
     ACT(c:fac, 'Cuenta')        
     ACT(d:fac, 'SubCuenta')        
     ACT(e:fac, 'Rubro')        
     ACT(f:fac, 'FechaValor')
     ACT(g:fac, 'FechaGen.')
     ACT(h:fac, 'Debito')
     ACT(i:fac, 'Credito')
     ACT(j:fac, 'Cliente')
     ACT(k:fac, 'FechaOp')
     ACT(l:fac, 'Tipo Liquid.')   
     ACT(m:fac, 'V.Especie')
     ACT(n:fac, 'V.ContraEsp')
     ACT(o:fac, 'Especie')
     ACT(p:fac, 'Cto.Costo')
     ACT(q:fac, 'Observ.')
     ACT(r:fac, 'AsientoRef')
     AgregarMarco(a:fac..r:fac,1,0)
     SetFont(a:fac..z:fac, 1)
     AlinearCeldas(g:fac..g:fac,'D')
     AlinearCeldas(c:fac..d:fac,'D')
     AlinearCeldas(m:fac..n:fac,'D')
     ifa
     ACN(fa1, fac)
  ENDIF 

  message(fbn('NrUnicoAsiento'))
  ACN(a:fac, fbn('NrUnicoAsiento'))
  ACT(b:fac, fbn('Modelo')~' '~fbn('TipoAsiento')~' - '~fbn('Alias3'))

  ACT(c:fac, fbn('Alias4'))
  ACT(d:fac, fbn('Alias5'))
  ACT(e:fac, fbn('Cuenta')~' - '~fbn('Detalle'))

  ACD(f:fac, fbn('FechaValor'))
  ACD(g:fac, fbn('FechaGeneracion'))
  IF EqStr(fbn('DebitoCredito'), 'CRE')
      ACN(i:fac, fbn('Cantidad1'))
      ACN(h:fac, 0)
  ELSE
      ACN(h:fac, fbn('Cantidad1'))
      ACN(i:fac, 0)
  ENDIF

  ACT(j:fac, fbn('Cliente1'))
  ACD(k:fac, fbn('FechaOp'))
  IF Eqstr(fbn('ValorRB1'), '0')
     ACT(l:fac, 'Hoy ')
  ENDIF
  IF Eqstr(fbn('ValorRB1'), '1')
     ACT(l:fac, 'Normal ')
  ENDIF
  IF Eqstr(fbn('ValorRB1'), '2')
     ACT(l:fac, '48 hs ')
  ENDIF
  IF Eqstr(fbn('ValorRB1'), '3')
     ACT(l:fac, '72 hs ')
  ENDIF
  IF Eqstr(fbn('Puesto'), '0')
     ACT(l:fac, Val(l:fac)~'- No Puesto')
  ENDIF
  IF Eqstr(fbn('Puesto'), '1')
     ACT(l:fac, Val(l:fac)~'- Puesto')
  ENDIF
  IF Not Eqstr(Copy(fbn('NrOperacion'),1,1),'V')
     ACD(m:fac, fbn('FechaVto'))
     ACD(n:fac, fbn('FechaPago'))
  ENDIF

  ACT(o:fac, fbn('Especie1'))
  ACT(p:fac, fbn('CentroCosto'))
  IF Eqstr(Copy(fbn('NrOperacion'),1,1),'V')
     ACT(q:fac, fbn('Alias2'))
  ENDIF
  ACT(r:fac, fbn('NrAsiento'))
  AlinearCeldas(c:fac..d:fac,'D')
Proximo

ifa
ifa

