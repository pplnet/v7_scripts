CrearDialogo
 Fecha1     : "FechaOp"                     ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
 Especie1   : 'Titulo'  ;;;;;;
 Book1      : 'Cartera' ;;;;;;
 String1    : 'Cuenta'  ;;;;;;
 Radio2     : 'Posicion|Concertada|Liquidada' ;6;;;;;;;;0
 Entero1    : 'Posicion Inicial';;;;;;
 Entero2    : 'Precio Inicial'  ;;;;;;
FinDialogo

 
if Not Ok
 Cancelar
endif


ACT(M:1,Dialogo.Fecha1)
ACT(N:1,Dialogo.Especie1)
ACT(O:1,Dialogo.Book1)
ACT(P:1,Dialogo.String1)
ACT(Q:1,Dialogo.Radio2)
ACT(R:1,Dialogo.Entero1)
ACT(S:1,Dialogo.Entero2)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)
 

ACT(a:FAC, "Detalle de Posiciones y Resultado ")
SetFont(a:fac..a:fac,3)
SetFilaActual(FAC+2)

ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Moneda')
ACT(d:FAC, 'Cupon')
ACT(e:FAC, 'FechaOp')
ACT(f:FAC, 'FechaVto')
ACT(g:FAC, 'Compra')
ACT(h:FAC, 'Venta')
ACT(i:FAC, 'Precio')
ACT(j:FAC, 'NrOperacion')
ACT(k:FAC, 'Cartera')
ACT(l:FAC, 'Cuenta')

 

SetFont(a:Fac..l:Fac,2)
AlinearCeldas(a:Fac..l:Fac,'C')
AgregarMarco(a:Fac..l:Fac,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)
ACT(A:Fac, 'Posicion Inicial')
If Dialogo.Entero1>0
   ACN(G:Fac, Dialogo.Entero1)
Else
  ACN(H:Fac, Dialogo.Entero1)
Endif
ACN(I:Fac, Dialogo.Entero2)
AgregarMarco(a:Fac..l:Fac,1,0)
SetFont(a:Fac..K:Fac,2)

SQL.ADD("Select ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.Precio1, O.NrOperacion, O.TipoOp, O.Book1 Book, O.Mercado as Origen, O.ContraEspecie , M.Cupon, M.Estrategia")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE M ")
SQL.ADD("Where O.NrOperacion = M.NrOperacion   ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie= '"~Dialogo.Especie1~"' ")
EndIF
IF Dialogo.Radio2 = 0
   ***---Posicion concertada
  SQL.ADD(" AND M.NrSaldo IN (121)  and O.FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' ")
ELSE
   ***---Posicion liquidada
  SQL.ADD(" AND M.NrSaldo IN (122)   and O.FechaVto= '"~IdxDate(Dialogo.Fecha1)~"'")
ENDIF
If NoVacio(Dialogo.Book1)
  SQL.ADD(" and M.Book= '"~Dialogo.Book1~"' ")
EndIF
If NoVacio(Dialogo.String1)
  SQL.ADD(" and M.Estrategia = '"~Dialogo.String1~"' ")  
EndIf
SQL.ADD(" Union ")

SQL.ADD("Select ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.Precio1, O.NrOperacion, O.TipoOp, O.Book1 Book, O.Mercado as Origen, O.ContraEspecie , M.Cupon, M.Estrategia")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPOSPEN M ")
SQL.ADD("Where O.NrOperacion = M.NrOperacion   ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and O.Especie= '"~Dialogo.Especie1~"' ")
EndIF
IF Dialogo.Radio2 = 0
   ***---Posicion concertada
  SQL.ADD(" AND M.NrSaldo IN (121)  and O.FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' ")
ELSE
   ***---Posicion liquidada
  SQL.ADD(" AND M.NrSaldo IN (122)   and O.FechaVto= '"~IdxDate(Dialogo.Fecha1)~"'")
ENDIF
If NoVacio(Dialogo.Book1)
  SQL.ADD(" and M.Book= '"~Dialogo.Book1~"' ")
EndIF
If NoVacio(Dialogo.String1)
  SQL.ADD(" and M.Estrategia = '"~Dialogo.String1~"' ")  
EndIf
SQL.ADD(" Union ")

SQL.ADD("Select ")
SQL.ADD(" T.Fecha1 FechaOp, T.Fecha2 FechaVto, T.Especie, Cantidad, T.Precio1 , T.NrTrans NrOperacion, T.TipoTr2 TipoOp, ")
SQL.ADD(" Book, T.Mercado1 as Origen, '' as ContraEspecie , M.Cupon as Cupon, M.Estrategia ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPOSEJE M ")
SQL.ADD("Where T.NrTrans = M.NrOperacion   ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and T.Especie= '"~Dialogo.Especie1~"' ")
EndIF
SQL.ADD(" and T.TipoTr2= 'TRPOS' ")
IF Dialogo.Radio2 = 0
   ***---Posicion concertada
  SQL.ADD(" AND M.NrSaldo IN (121) ")
  If Dialogo.Fecha1>0
     SQL.ADD(" and T.Fecha1= '"~IdxDate(Dialogo.Fecha1)~"' ")
  EndIF
ELSE
   ***---Posicion liquidada
  SQL.ADD(" AND M.NrSaldo IN (122) ")
  If Dialogo.Fecha1>0
     SQL.ADD(" and T.Fecha2= '"~IdxDate(Dialogo.Fecha1)~"' ")
  EndIF
ENDIF
 
If NoVacio(Dialogo.Book1)
  SQL.ADD(" and M.Book = '"~Dialogo.Book1~"' ")  
EndIf
If NoVacio(Dialogo.String1)
  SQL.ADD(" and M.Estrategia = '"~Dialogo.String1~"' ")  
EndIf
SQL.ADD(" Order by 1 ")

Recorrer SQL
 ACT(b:Fac, Fbn['Especie'])
 ACT(c:Fac, Fbn['ContraEspecie'])
 ACT(d:Fac, Fbn['Cupon'])
 ACD(e:Fac, Fbn['FechaOp'])
 ACD(f:Fac, Fbn['FechaVto'])
 If EqStr(Fbn['TipoOp'],'TIC')
    ACN(g:Fac, Fbn['Cantidad'])
 Else
    ACN(h:Fac, -Fbn['Cantidad'])
 EndIf
 ACN(i:Fac, Fbn['Precio1'])
 ACT(j:Fac, Fbn['NrOperacion'])
 ACLO(j:Fac, Fbn['NrOperacion'])
 ACT(K:Fac, Fbn['Book'])
 ACT(L:Fac, Fbn['Estrategia'])
 SCN(xx:1, Val(G:Fac))
 SCN(xx:2, Val(H:Fac))
Proximo

SetFilaActual(FAC+1)
ACT(a:Fac,'Posicion Final')
AgregarMarco(a:Fac..l:Fac,1,0)
If Dialogo.Entero1>0
  ACN(G:Fac,val(xx:1)+Dialogo.Entero1)
  ACN(H:Fac,val(xx:2))
Else
  ACN(G:Fac,val(xx:1))
  ACN(H:Fac,val(xx:2)+Dialogo.Entero1)
EndIf

SetFont(a:Fac..l:Fac,2)
FormatoCeldas(G:1..H:fac, EXE('F0R'))
FormatoCeldas(I:1..I:fac, EXE('F9'))

ACO(1,10 )
ACO(2,10 )
ACO(3,10 )
ACO(4,10 )
ACO(5,10 )
ACO(6,10 )
ACO(7,10 )
ACO(8,10 )
ACO(9,10 )
ACO(10,10)
ACO(11,10)
ACO(12,10)

Impresion(1,2)
SetFilaActual(FAC+1)

LimitesVision(l:FAC)
RangoTitulo(a1..k:8,36)
 