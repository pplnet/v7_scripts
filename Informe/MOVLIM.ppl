ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos de Limites por Operacion")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+5)

ACT(a:FAC, 'Tipo Op.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'F.Operacion')
ACT(d:FAC, 'F.Vto.')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio / Tasa N.A.')

ACT(b:FAC+1, 'Limite')
ACT(c:FAC+1, 'F.Mov.')
ACT(d:FAC+1, 'F.Limite')
ACT(e:FAC+1, 'Especie Afectada')
ACT(f:FAC+1, 'Monto Afectado')
ACT(g:FAC+1, 'Leyenda')

AlinearCeldas(a:FAC+1..e:FAC+1,'I')
AlinearCeldas(f:FAC+1..f:FAC+1,'D')
AlinearCeldas(g:FAC+1..g:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..N:FAC+1,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
AgregarMarco(a:FAC+1..h:FAC+1,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

if NoVacio(Dialogo.Vehiculo1)
   ACT(x1, " and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif

SQL.ADD("SELECT O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1, O.Especie, O.Cantidad, ")
SQL.ADD("O.Precio1, O.Vehiculo1, M.NrOperacion, M.Limite, M.FechaMov, M.FechaLim, M.Especie Esp, ")
SQL.ADD("M.Monto, M.Descripcion, M.Bits, O.FechaEj, O.PrecioEj ")  
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVLIMITES M ")
SQL.ADD("where O.NrOperacion = M.NrOperacion ")
SQL.ADD("and O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(Val(X1))
SQL.ADD("order by O.TipoOp, O.NrOperacion, M.Limite, M.FechaMov")

Recorrer SQL

  if Not EqStr(FBN['NrOperacion'], Val(z1))
     ifa
     ACT(z1, FBN['NrOperacion'])
     ACT(a:FAC, FBN['TipoOp'])
     ACT (b:FAC, FBN['NrOperacion'])
     ACLO(b:FAC, FBN['NrOperacion'])
     ACD(c:FAC, FBN['FechaOp'])
     ACD(d:FAC, FBN['FechaVto'])
     ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(f:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     ACN(g:FAC, FBN['Cantidad'])
     ACN(h:FAC, FBN['Precio1'])
     SetFont(a:FAC..h:FAC,2)
     AlinearCeldas(a:FAC..b:FAC,'I')
     AlinearCeldas(c:FAC..d:FAC,'D')
     AlinearCeldas(e:FAC..f:FAC,'I')
     AlinearCeldas(g:FAC..h:FAC,'D')
     ifa
  endif

  ACT(b:FAC, FBN['Limite'])
  ACD(c:FAC, FBN['FechaMov'])
  ACD(d:FAC, FBN['FechaLim'])
  ACT(e:FAC, FBN['Esp'])
  ACN(f:FAC, FBN['Monto'])
  ACT(g:FAC, FBN['Descripcion'])

  if EqStr(FBN['Bits'],'P')
     ACT(a:FAC,"EJEC")
    else
     ACT(a:FAC,"PEND")
     ColorCeldas(a:FAC..h:FAC,clGREEN)
  endif

  SetFont(a:FAC..l:FAC,1)
proximo

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,18)
ACO(6,10)
ACO(7,10)
ACO(8,10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(h:FAC)
RangoTitulo(a:1..k:FAC, Val(w1)+3)
