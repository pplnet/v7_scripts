ACN(b:Val(aj9), Val(b:Val(aj5))+Val(b:Val(fi9)))
ACN(c:Val(aj9), Val(c:Val(aj5))+Val(c:Val(fi9)))
ACN(d:Val(aj9), Val(d:Val(aj5))+Val(d:Val(fi9)))
ACN(g:Val(aj9), Val(g:Val(aj5))+Val(g:Val(fi9)))
ACN(h:Val(aj9), Val(h:Val(aj5))+Val(h:Val(fi9)))
