   (.'DINEROTRAN'.)
ENDIF
(.'AJPOFI'.)

*----------------------------------------------------------
IF NO
*- fin de las filas de Activos y Pasivos respect.
ACN(fa1, Val(fi4)-1)
ACN(fa2, Val(fi8)-1)

**-- Calculo de los tolales generales de Tasa Premedio y Plazo Promedio
**-- Activa
Recorrer&i Val(fi2), Val(fa1)
   SCN(aa1, Val(b:&i)*Val(e:&i))
   SCN(aa2, Val(b:&i)*Val(f:&i))
   SCN(aa3, Val(g:&i)*Val(j:&i))
   SCN(aa4, Val(g:&i)*Val(k:&i))
Proximo
ACN(e:Val(fi4), Val(aa1)/Val(b:Val(fi4)) )
ACN(f:Val(fi4), Val(aa2)/Val(b:Val(fi4)) )
ACN(j:Val(fi4), Val(aa3)/Val(g:Val(fi4)) )
ACN(k:Val(fi4), Val(aa4)/Val(g:Val(fi4)) )

**-- Pasivo
ACN(aa1, 0)
ACN(aa2, 0)
ACN(aa3, 0)
ACN(aa4, 0)

Recorrer&i Val(fi6), Val(fa2)
   SCN(aa1, Val(b:&i)*Val(e:&i))
   SCN(aa2, Val(b:&i)*Val(f:&i))
   SCN(aa3, Val(g:&i)*Val(j:&i))
   SCN(aa4, Val(g:&i)*Val(k:&i))
Proximo
ACN(e:Val(fi8), Val(aa1)/Val(b:Val(fi8)) )
ACN(f:Val(fi8), Val(aa2)/Val(b:Val(fi8)) )
ACN(j:Val(fi8), Val(aa3)/Val(g:Val(fi8)) )
ACN(k:Val(fi8), Val(aa4)/Val(g:Val(fi8)) )
ENDIF
*---------------------------------------------------------- 


**-- Calculo de la Posicion Neta
**-- En Pesos
ACN(b:Val(fi9), Val(b:Val(fi4))-Val(b:Val(fi8)))
ACN(c:Val(fi9), Val(c:Val(fi4))-Val(c:Val(fi8)))
ACN(d:Val(fi9), Val(d:Val(fi4))-Val(d:Val(fi8)))
ACN(g:Val(fi9), Val(g:Val(fi4))-Val(g:Val(fi8))) 
ACN(h:Val(fi9), Val(h:Val(fi4))-Val(h:Val(fi8)))
ACN(i:Val(fi9), Val(i:Val(fi4))-Val(i:Val(fi8)))

ACN(l:Val(fi9), Val(l:Val(fi4))-Val(l:Val(fi8)))
ACN(m:Val(fi9), Val(m:Val(fi4))-Val(m:Val(fi8)))
ACN(n:Val(fi9), Val(n:Val(fi4))-Val(n:Val(fi8)))
ACN(o:Val(fi9), Val(o:Val(fi4))-Val(o:Val(fi8)))
ACN(p:Val(fi9), Val(p:Val(fi4))-Val(p:Val(fi8)))
ACN(q:Val(fi9), Val(q:Val(fi4))-Val(q:Val(fi8)))
FormatoCeldas(b:Val(fi9)..q:Val(fi9), EXE('F2'))


Recorrer&j 2, 17
   If Val(&j:Val(fi4))=0
      ACN(&j:Val(fi4), 0)
   Endif

   If Val(&j:Val(fi8))=0
      ACN(&j:Val(fi8), 0)
   Endif

   If Val(&j:Val(fi9))=0
      ACN(&j:Val(fi9), 0)
   Endif
Proximo
ACT(e:Val(fi4),'')
ACT(f:Val(fi4),'')
ACT(j:Val(fi4),'')
ACT(k:Val(fi4),'')
ACT(e:Val(fi8),'')
ACT(f:Val(fi8),'')
ACT(j:Val(fi8),'')
ACT(k:Val(fi8),'')
ACT(e:Val(fi9),'')
ACT(f:Val(fi9),'')
ACT(j:Val(fi9),'')
ACT(k:Val(fi9),'')

**-----------------------------------------------**

If [Dialogo.Check1=1 y Dialogo.Radio2=2]
   ACT(ga1,Dialogo.Lista1)
   ACT(ga2, IIF(Dialogo.Radio2=0, 'Corto Plazo',IIF(Dialogo.Radio2=1,'Largo Plazo','Corto+Largo Plazo')) )
   ACT(ga3, IIF(Dialogo.Radio1=0, 'NO Consolidado', 'Consolidado'))
   ACT(ga1, val(ga1)~'/'~Dialogo.Fecha1~'/'~Val(ga2)~'/'~Val(ga3))
   GrabarPMG('OPFIAU', val(ga1))
Endif

SetFont(b:Val(fi4)..q:Val(fi4), 2)
