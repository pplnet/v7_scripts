ACT(VH:2, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1  : 'D.FechaPago' ;1 ;1;;;;Dialogo.Fecha1<>0;'Fecha Invalida';NO;FSys-30
  Fecha2  : 'H.FechaPago' ;1 ;2;;;;Dialogo.Fecha2<>0;'Fecha Invalida';NO;FSys
  Lista1:   'Vehiculos' ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:2))
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:2))~") " ) )~"  ");
FinDialogo


IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,BI")
CrearFont(4,"Arial,10,B")

ACT(a:1, 'Bancos:  '~iif(NoVacio(Dialogo.Lista2),Pipe2Comillas(Dialogo.Lista2),'Todos'))
ACT(a:2, 'Cuentas: '~iif(NoVacio(Dialogo.Lista3),Pipe2Comillas(Dialogo.Lista3),'Todas'))
ACT(a:3, 'Vehiculos: '~iif(NoVacio(Dialogo.Lista1),Pipe2Comillas(Dialogo.Lista1),'Todos'))
SetFont(a:1..a:3, 2)

ACT(A:4, 'Reporte de Cheques Emitidos del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2~' y no Debitados')
SetFont(a:4, 4)

SetFilaActual(6)

ACT(a:fac,   'Cuenta')
ACT(a:fac+1, 'Bancaria')
ACT(b:fac,   'Cuenta')
ACT(b:fac+1, 'Contable')
ACT(c:fac,   'Cheque')
ACT(d:fac,   'Fecha de ')
ACT(d:fac+1, 'Emision')
ACT(e:fac,   'Fecha de ')
ACT(e:fac+1, 'Vencimiento')
ACT(f:fac,   'Codigo de')
ACT(f:fac+1, 'Proveedor')
ACT(g:fac,   'Razon Social')
ACT(h:fac,   'Codigo de')
ACT(h:fac+1, 'Beneficiario')
ACT(i:fac,   'Alternativo')
ACT(j:fac,   'Orden del')
ACT(j:fac+1, 'Cheque')
ACT(k:fac,   'Importe en')
ACT(k:fac+1, 'Moneda Local')
ACT(l:fac,   'Importe en')
ACT(l:fac+1, 'Moneda Original')
ACT(m:fac,   'Estado')
AlinearCeldas(a:fac..z:fac+1,'C')
SetFont(a:fac..z:fac+1,2)
AgregarMarco(a:fac..m:fac+1,0,0,EXE('COLOR6'))

SQL.ADD(" Select C.Chequera, C.NrCheque, C.FechaEmision, C.Monto, C.NrComprobante, C.Estado, ")
SQL.ADD(" B.Banco, B.Cuenta, F.Vehiculo1, F.Proveedor, T.Numero NroCta, E.Nombre, C.FechaPago, ")
SQL.ADD(" F.Especie, PR.Nombre NombreP, CON.Codigo CuentaContable")
SQL.ADD(" From "~DBO~".CHEQUES C, "~DBO~".CNCHEQUERASBANCO B, "~DBO~".TRANSACCIONES2 F, ")
SQL.ADD(" "~DBO~".CUENTAS T, "~DBO~".ESPECIES E, "~DBO~".CNPROVEEDORES PR, "~DBO~".CONTABILIDAD CON ")
SQL.ADD(" Where C.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   C.FechaPago <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   B.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   T.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   F.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND F.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" AND   C.Chequera      = B.Chequera ")
SQL.ADD(" AND   C.NrComprobante = F.NrTrans ")
SQL.ADD(" AND   B.Cuenta        = T.Codigo ")
SQL.ADD(" AND   E.Codigo        = F.Especie ")
*SQL.ADD(" AND   F.Proveedor     *= PR.Codigo ")
*SQL.ADD(" AND   B.Cuenta        *= CON.Cuenta ")
SQL.ADD(" AND   F.Proveedor     = PR.Codigo ")
SQL.ADD(" AND   B.Cuenta        = CON.Cuenta ")
SQL.ADD(" AND   C.Estado <> 'PAG' ")
SQL.ADD(" Order By F.Vehiculo1, B.Banco, F.Especie, C.FechaEmision, C.NrCheque ")

ACT(vh:1,'')
ACT(ba:1,'')
ACT(ea:1,'')
dfa

Recorrer SQL
 If Not Eqstr(fbn('Vehiculo1'),Val(vh:1)) o Not Eqstr(fbn('Banco'),Val(ba:1))
   message(fbn('Vehiculo1')~' - '~fbn('Banco'))
   ifa
   ifa
   ACT(a:fac, 'Vehiculo: '~fbn('Vehiculo1')~'   Banco: '~fbn('Banco'))
   SetFont(a:fac..z:fac,3)
   AgregarMarco(a:fac..m:fac,0,0,EXE('COLOR8'))
   ACT(ea:1,'')
 Endif
 If Not Eqstr(fbn('Especie'),Val(ea:1))
   message(fbn('Especie'))
   ifa
   ACT(a:fac, 'Moneda: '~fbn('Nombre'))
   SetFont(a:fac..z:fac,3)
   AgregarMarco(a:fac..m:fac,0,0,0)
   ifa
 Endif

 ACT(a:fac, fbn('Cuenta')~' - '~fbn('NroCta'))
 ACT(b:fac, fbn('CuentaContable'))
 ACT(c:fac, fbn('NrCheque'))
 ACD(d:fac, fbn('FechaEmision'))
 ACD(e:fac, fbn('FechaPago'))
 ACT(f:fac, fbn('Proveedor'))
 ACT(g:fac, fbn('NombreP'))
 ACN(k:fac, fbn('Monto')*CotizacionC(fbn('Especie'),,,,FSYS,1,SI,'ARP'))
 ACN(l:fac, fbn('Monto'))
 If Eqstr(fbn('Estado'), 'ASI')
   ACT(m:fac, 'Asignado')
 Endif
 If Eqstr(fbn('Estado'), 'ENT')
   ACT(m:fac, 'Entregado')
 Endif
 If Eqstr(fbn('Estado'), 'ANU')
   ACT(m:fac, 'Anulado')
 Endif

 ACT(vh:1,fbn('Vehiculo1'))
 ACT(ba:1,fbn('Banco'))
 ACT(ea:1,fbn('Especie'))
Proximo

ifa
ifa
ifa

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac, 2)

ACO(1,15)
ACO(2,10)
ACO(3, 6)
ACO(4, 8)
ACO(5, 8)
ACO(6, 8)
ACO(7, 15)
ACO(8, 10)
ACO(9, 10)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,8)

LimitesVision(m:fac+2)
Impresion(1,2)
Impresion(4,1)
SetPrintFit(3,76)
SetMargins(0,0,0,0)