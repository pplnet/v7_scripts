AlinearCeldas(c:fac..p:fac+1,'C')
AgregarMarco(a:fac..l:fac+1,0,0,Exe('COLOR6'))

ifa
ACT(z:1,'')
ACT(z:2,'')
ACN(z:3,0)

SQL.ADD(" SELECT DISTINCT  T.Mercado1, M.Descripcion NomMer, T.Cliente1, C.RazonSocial, T.NrTrans, T.Fecha1, ")
SQL.ADD(" T.Fecha2, T.CallPut, T.FechaEj, T.PrecioEj, T.Especie2, T.Cantidad2, E2.Nombre NomEsp2, ")
SQL.ADD(" T.Cantidad3, T.Cambio2, T.Especie, E1.Nombre NomEsp, T.Cantidad1, T.Cupon1, CU.Especie1 CUEspecie1,  ")
SQL.ADD(" CU.Cuenta1 CUCuenta1, CU.Cantidad1 CUCantidad1, CU.Mercado1 CUMercado1, CU.Cantidad2 CUCantidad2, CU.Cantidad3 CUCantidad3 ")
SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".MERCADOS M, ")
SQL.ADD(" "~DBO~".ESPECIES E1, "~DBO~".OPERACIONESBITS B, "~DBO~".CUOTAS CU, "~DBO~".ESPECIES E2 ")
SQL.ADD(" WHERE T.TipoTr2   = 'SPINOF' ")
SQL.ADD(" AND   T.Mercado1  = M.Codigo ")
SQL.ADD(" AND   T.Cliente1  = C.Codigo ")
SQL.ADD(" AND   T.Especie   = E1.Codigo ")
SQL.ADD(" AND   CU.Especie1 = E2.Codigo ")
SQL.ADD(" AND   CU.NrOperacion = T.NrTrans ")
SQL.ADD(" AND   B.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND   B.NrBit        <> 40 ")
SQL.ADD(" AND   B.Valor        = '1' ")

if NoVacio(Dialogo.Fecha3)
  SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Dialogo.Fecha3) )
endif
if NoVacio(Dialogo.Fecha4)
  SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha4) )
endif
if NoVacio(Dialogo.Fecha1)
  SQL.ADD("  and  T.Fecha2    >= "~IdxDate2(Dialogo.Fecha1) )
endif
if NoVacio(Dialogo.Fecha2)
  SQL.ADD("  and  T.Fecha2    <= "~IdxDate2(Dialogo.Fecha2) )
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and  T.Especie    = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.CLiente1)
  SQL.ADD("  and  T.Cliente1   = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  T.Mercado1   = '"~Dialogo.Mercado1~"' ")
endif

SQL.ADD("  and  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" order by T.Mercado1, T.Cliente1, T.NrTrans ")


Recorrer SQL

 If not EqStr(fbn('Mercado1'),Val(z:1)) 
   ACT(z:1,fbn('Mercado1'))
   ACT(a:fac, fbn('NomMer'))
   SetFont(a:fac,3)
   ifa
 Endif

 If not EqStr(fbn('Cliente1'),Val(z:2)) 
   ACT(z:2,fbn('Cliente1'))
   ACT(b:fac, fbn('RazonSocial'))
   message(fbn('RazonSocial'))
   ACT(z:3,'')
 Endif

 If not EqStr(fbn('NrTrans'),Val(z:3))
   ACT(z:3,fbn('NrTrans'))
   ACT(c:fac, fbn('NrTrans'))
   ACLT(c:fac, fbn('NrTrans'))
   ACT(d:fac,fbn('Fecha2'))
   ACT(e:fac,fbn('Fecha1'))
   AlinearCeldas(d:fac..e:fac,'C')
   ACT(f:fac, fbn('NomEsp'))
   ACN(g:fac, fbn('Cantidad1'))
   FormatoCeldas(g:fac,Exe('F2'))
 Endif

 ACN(h:fac, fbn('CUCantidad2'))
 ACN(i:fac, fbn('CUCantidad3'))
 ACT(j:fac, fbn('NomEsp2'))
 ACN(k:fac, fbn('CUCantidad1'))

 FormatoCeldas(h:fac..i:fac,Exe('F0'))
 FormatoCeldas(k:fac,Exe('F2'))

 If Num(SQL("select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrTrans')~"' ")) = 0
   ACT(l:fac,'Pendiente')
 Else
   ACT(l:fac,'Confirmado')
 Endif
 SetFont(b:fac..p:fac,4)
