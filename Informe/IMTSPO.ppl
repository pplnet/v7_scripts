 Mercado1 :'Mercado'     ;4;2;;;;;;;
 Vehiculo1:'Vehiculo'    ;5;2;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial,10,B")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,U")
