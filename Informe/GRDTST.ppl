ColorCeldas(a6..a9, RGB(255,0,0))

ABT(a10..b10, 'FIN DEL LISTADO')

SetFilaActual(11)
AlinearCeldas(a:2..b10,'C')
AgregarMarco(a:5..b:9,2,1,RGB(255,255,255))
AgregarMarco(a2..b2,2,1,RGB(255,255,0))
SetFont(a:2..b2,1)
