CrearDialogo
Check1         : 'Check'                                        ;;;;;;;;;
Fecha1         : 'Fecha'                                        ;;;;;;;;;;;;
FechaHora1     : 'Fecha y hora'                                 ;;;;;;;;;;;;
Archivo1       : 'Archivo'                                      ;;;;;;;;;;;;
Directorio1    : 'Directorio'                                   ;;;;;;;;;;;;
Lista1         : 'Lista de especies'                            ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES ");;
String1        : 'String'                                       ;;;;;;;;;TRIM(BuscarCampo("CLIENTES", "RAZONSOCIAL", "CODIGO", "1000000001"))
Precio1        : 'Precio'                                       ;;;;;;;;;;;  
Entero1        : 'Nro. entero'                                  ;;;;;;;;;;;  
Label1         : 'Este es un label o etiqueta'                  ;1;1;2;  ;  ;;;;
Radio1         : 'Combo o radio|Mensual|Anual|Historico|Otro'   ;2;1;2;;;;;;1;
Cliente1       : 'Lookup de clientes'                           ;

FinDialogo

IF NOT OK
  Cancelar
ENDIF

CrearFont(1,'Arial,12,B,S')
CrearFont(2,'Arial,10')

ACO(1,45)
ACO(2,45)

AFI(2, 60)
AFI(3, 40)

ACT(B2, 'Check:')
ACT(B3, Dialogo.Check1)
ACT(A2, 'Fecha:')
ACD(A3, Dialogo.Fecha1)

ACT(C2, 'FechaHora:')
ACD(C3, Dialogo.FechaHora1)

ACT(D2, 'Archivo:')
ACT(D3, Dialogo.Archivo1)

ACT(E2, 'Directorio:')
ACT(E3, Dialogo.Directorio1)


ACT(A5, 'Primer item elegido:')
ACT(A6, Dialogo.Lista1.ItemAt(0))

ACT(B5, 'Segundo item elegido:')
ACT(B6, Dialogo.Lista1.ItemAt(1))

ACT(C5, 'String:')
ACT(C6, Dialogo.String1)

ACT(D5, 'Precio:')
ACN(D6, Dialogo.Precio1)

ACT(E5, 'Nro. entero:')
ACN(E6, Dialogo.Entero1)

ACT(A8, 'Radio o combo:')
ACT(A9, Dialogo.Radio1)

ACT(B8, 'Cliente elegido:')
ACT(B9, Dialogo.Cliente1)

limitesvision(E:12)