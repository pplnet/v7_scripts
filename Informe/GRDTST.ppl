Cliente3       : 'Cliente Unico'                         ;;;;;;;;;;;;;;"WHERE NrCuenta = '000000798520341'"
FinDialogo

IF NOT OK
  Cancelar
ENDIF

CrearFont(1,'Arial,12,B,S')
CrearFont(2,'Arial,10')

ACO(1,45)
ACO(2,45)

AFI(2, 60)
AFI(5, 40)

ABT(a2..b2, 'Listado de Especies')

ACT(C2, 'Fecha:')
ACD(C3, Dialogo.Fecha1)
ACT(D2, 'Check:')
ACD(D3, Dialogo.Check1)

ACT(a5, 'Codigo')
ACT(b5, 'Nombre')

ACT(a6, 'JPRIME')
ACT(b6, 'Juan Carlos Prime')

ACT(a7, 'TAGUIRREZABALA')
ACT(b7, 'Tomás Aguirrezabala')

ACT(a8, 'SLEGUIZAMON')
ACT(b8, 'Sofía Leguizamon')

ACT(a9, 'CLOMAS')
