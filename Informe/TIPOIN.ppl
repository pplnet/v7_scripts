CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Tipos de Informe')
ACT(a:FAC+2,'Codigo')
ACT(b:FAC+2,'Nombre')
AgregarMarco(a:FAC+2..c:FAC+2,2,0,Exe('COLOR'))
SetFont(a:FAC..b:FAC+2,2)

SetFilaActual(FAC+2)
SQL.ADD("Select * From "~DBO~".TIPOSINFORME")
recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN['Codigo'])
  ACT(b:FAC, FBN['Descripcion'])
proximo

AgregarMarco(a:Val(w1)+3..c:FAC+1,1)
SetFont(a:Val(w1)+3..b:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(2,25)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
AgregarBMP(a1,Exe('LOGO'),60)
LimitesVision(c:FAC)
RangoTitulo(a:1..c:FAC,Val(w1)+2)
