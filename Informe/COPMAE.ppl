Recorrer SQL
    IF Not Eqstr(fbn('ContraEspecie'), 'ARP')
        ACN(CT:1, Cotizacion(fbn('ContraEspecie'),,,,fbn('FechaOp'),5,SI))
    ELSE
        ACN(CT:1, 1)
    ENDIF

    IF Not Eqstr(Dialogo.Especie1, 'ARP')
        ACN(CT:2, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    ELSE
        ACN(CT:2, Val(CT:1))
    ENDIF
    ACN(zu1,1)


  if Val(aw1)>36
    ifa
    if Dialogo.Radio1=1
       if Val(aw5)=0
          ACT(aw2, GetNumerador(990))
          ACN(aw3, Num(Val(aw2)))
       else
          SCN(aw3,1)
       endif
       ACT(l:39*val(aw4), 'Folio: '~FStr(Val(aw3),1,0))
       if val(ay1) = 0
          ACN(ay1, Val(aw3))
       endif
    else
       ACT(l:39*val(aw4), 'Provisorio - Pag. '~FStr(Val(aw4),1,0))
    endif

    SaltarHoja    
    SCN(aw4, 1)
    IFA
    ACT(j:FAC+1, val(xx1))
    ACT(j:FAC+2, 'Registro de Operaciones desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
    AlinearCeldas(j:FAC+1..j:FAC+2,'C')

    ACT(q:fac+2, 'Cotizacion USD: '~fstr(Val(xx2),0,8))

    SetFilaActual(fac+4)

    ACT(a:FAC, 'Boleto')
    ACT(b:FAC, 'Nr.Minuta')
    ACT(c:FAC, 'Fecha Op.')
    ACT(d:FAC, 'Fecha Liq.')
    ACT(e:FAC, 'Tipo Op')
    ACT(f:FAC, 'Hora')
    ACT(g:FAC, 'Nro Mercado')
    ACT(h:FAC, 'Comitente')
    ACT(i:fac, 'Especie')
    ACT(j:fac, 'Cantidad VN')
    ACT(k:fac, 'Precio')
    ACT(l:fac, 'Importe Bruto')
    ACT(m:fac, 'Intereses')
    ACT(n:fac, 'Importe Neto')
    ACT(o:fac, 'Comision')
    ACT(p:fac, 'IVA Resp.Insc.')
    ACT(q:fac, 'Comis+IVA')
    ACT( r:fac, 'Monto Total')
    ACT(s:fac, ' Cupon')
    ACT(t:fac, 'Age.')
    ACT( u:fac, 'Oper.')
    ACT(v:fac, 'Contr.')
    ACT(w:fac, 'Moneda')
    ACT(x:fac, 'Baja')
    ACT(y:fac, 'Mercado')

    AlinearCeldas(a:FAC..y:fac,'C')
    AgregarMarco(a:FAC..y:fac,2)
    SetFont(a:FAC..y:fac,2)

    ACN(aw1, Val(aa:1))
    IFA
  endif
  SCN(aw1, 1)
  SCN(vi2,1)    
    
    ACT(a:FAC, IIF(longitud(fbn['NrBoleto'])<=6,fbn['NrBoleto'],Copy(fbn['NrBoleto'],longitud(fbn['NrBoleto'])-5,6)) )
    ACT(b:FAC, Copy(fbn['NrOperacion'],1,8))
    ACLO(b:FAC, Copy(fbn['NrOperacion'],1,8))
    message('Operacion '~Val(b:fac))
    ACD(c:FAC, fbn['FechaOp'])
    ACD(FE:1, fbn('FechaOp'))
    If Eqstr(fbn('Convenio'),'1')
       ACD(d:FAC, fbn['FechaAltaSisExterno'])
    Else
       ACD(d:FAC, fbn['FechaVto'])
    Endif
    If Incluido(fbn['TipoOp'],'TIC')
       ACT(e:FAC, 'Compra')
    EndIf
    If Incluido(fbn['TipoOp'],'TIV')
       ACT(e:FAC, 'Venta')
    Endif
    If Incluido(fbn['TipoOp'],'TIFC')
       ACT(e:FAC, 'Compra Fut')
    EndIf
    If Incluido(fbn['TipoOp'],'TIFV')
       ACT(e:FAC, 'Venta Fut ')
    Endif
    If EqStr(fbn['PaseCB'],'1')
       ACT(e:FAC, val(e:fac)~' Por Pase ')       
    EndIf
IF NO
   * FO 07/11/2006 - Mail Cecilia Font: Hora en COPIATIVO DE BOLETOS.
    IF fbn('CB5') = 1
        ACT(f:FAC, Hora(fbn['FechaAltaMAE']))
    ELSE
        ACT(f:FAC, Hora(fbn['FechaEnvioMAE']))
    ENDIF
ENDIF
    ACT(f:FAC, Hora(fbn['FechaAltaMAE']))
    If Num(fbn['NroAltaMae'])>0
       IF Incluido(fbn('Tipo'),'cBaja')
           ACT(g:FAC, fbn['NroBajaMAE'])
       ELSE
           ACT(g:FAC, fbn['NroAltaMae'])
       ENDIF
       ACT(i:fac,Pad(FBN['CodMAEContado'],5))
    Else
       ACT(g:FAC, 'N/A')
       ACT(i:fac,FBN['Especie'])
       ACT(v:fac, fbn['NroAltaMAE'])
    Endif
    ACT(i:fac, fbn('CodMAEContado')~' - '~Copy(fbn('Nombre'), 1, 15))
    ACT(s:fac, FBN['Cupon'] )
    ACT(H:fac, fbn('Cliente1')~' - '~Copy(fbn('RazonSocial'),1,25))

    ACN(j:fac, fbn['Cantidad'])

    If Eqstr(FBN['Especie'],'FRB') 
       ACN(k:fac, FBN['Precio1']*fbn('VTeorico') )
    Else
       If EqStr(fbn['EsAforado'],'1')
          ACN(k:fac, FBN['TipoCambio2'])
       Else
          ACN(k:fac, FBN['Precio1'])
       Endif
    Endif

    If EqStr(fbn['EsAforado'],'1')  
       ACN(l:fac, fbn['TotalCaucion']-IIF(EqStr(FBN['CotizaMAE'],'CLE'),fbn['TotalIntereses'],0))
    Else
       ACN(l:fac, fbn['TotalBrutoCli1'])
    Endif

    *- Si la especie es Dirty Clean igualmente calculo los intereses
    IF EqStr(FBN['CotizaMAE'],'CLE') y EqStr(FBN('InteresesC'),'DIR')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
           * Precio Clean Aforado
          ACN(k:fac,(fbn['TotalCaucion']-fbn['TotalIntereses'])/fbn['Cantidad'])
           * Bruto Aforado
          ACN(l:fac, fbn['Cantidad']*Val(k:fac)*ValorTeorico2(fbn('Especie'),fbn('FechaVto')) )
       Else
          ACN(k:fac,(fbn['TotalNetoCli1']-fbn['TotalIntereses'])/fbn['Cantidad'])
          ACN(l:fac, fbn['TotalBrutoCli1']-fbn['TotalIntereses'])
       Endif
    EndIf

    * - La especie es CLEAN DIRTY, informo Neto y precio sucio
    IF EqStr(FBN['CotizaMAE'],'DIR') y EqStr(FBN('InteresesC'),'CLE')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
          ACN(k:fac,(fbn['TotalCaucion'])/fbn['Cantidad'])
          ACN(l:fac, fbn['TotalCaucion'])
       Else
          ACN(k:fac,(fbn['TotalNetoCli1'])/fbn['Cantidad'])
          ACN(l:fac, fbn['TotalNetoCli1'])
       Endif
    EndIf

    IF EqStr(FBN['CotizaMAE'],'CLE')
       ACN(m:fac, fbn['TotalIntereses'])
    Else
       ACN(m:fac, 0)
    Endif
    ACN(n:fac, fbn['TotalNetoCli1'])

    If EqStr(fbn['EsAforado'],'1')
*       ACT(e:FAC, val(e:fac)~' Aforado ') 
       ACN(n:fac, fbn['TotalCaucion'])
    EndIf

    If Incluido(fbn['TipoOp'],'TIC|TIV')
       ACN(o:fac, fbn('TotalAux2'))
       ACN(p:fac, fbn('TotalAux4'))
    Endif

    ACN(q:fac, Val(o:fac) + Val(p:fac))
    ACN(r:fac, Val(n:fac) + Val(q:fac))
    ACT(t:fac, Copy(fbn['NrMAE'],1,25) )
    ACT(u:fac, fbn['OpSIOPEL'])
    ACN(cp:1, 0)
    ACN(cp:1, SQL("SELECT 1 FROM "~DBO~".OPERACIONES  WHERE NrOperacion3='"~fbn('NrOperacion3')~"' AND NrOperacion3 is not NULL AND NrOperacion3 <> ''  AND NrOperacion3 <> '00000' AND NrOperacion<>'"~fbn('NrOperacion')~"' "))
    SCN(cp:1, SQL("SELECT 1 FROM "~DBO~".BOPERACIONES WHERE NrOperacion3='"~fbn('NrOperacion3')~"' AND NrOperacion3 is not NULL AND NrOperacion3 <> ''  AND NrOperacion3 <> '00000' AND NrOperacion<>'"~fbn('NrOperacion')~"' "))

**********************************************************************************
**** Esto se trajo del Boleto para que sea exactamente igual MB 22/02/2006
      If SQL("SELECT COUNT(*) FROM "~DBO~".OPERACIONES WHERE NrOperacion3 = '"~fbn('NrOperacion3')~"' AND TipoOp IN ('TIC','TIV') ")=2
         act(CL:1 , SQL("Select Cliente1 From "~DBO~".OPERACIONES Where NrOperacion3 = '"~fbn('NrOperacion3')~"' and CB8 ='1' and NrOperacion <> '"~fbn('NrOperacion')~"'"))
         act(cl3 , SQL("Select CategDepositante From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl4 , SQL("Select AFJP     From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl6 , SQL("Select Alias2   From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl5 , SQL("Select NrCuenta From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))

*****************20/07/2005         If fbn('NrMAE')>0

         If novacio(fbn('NrMAE')) y Not eqstr(fbn('NrMAE'),'000')

            * SOLO SE INDICA EL TIPO DE CONTRAPARTE EN EL BOLETO DEL AGENTE MAE
            IF Eqstr(Val(cl3),'BAN') 
               act(t:fac,'Banco') 
            Endif
            IF Eqstr(Val(cl3),'ABO') 
               act(t:fac,'Soc.Bolsa ') 
            Endif
            IF Eqstr(Val(cl3),'AME') 
               act(t:fac,'Age.MAE ') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y [Vacio(Val(cl4)) o  Eqstr(Val(cl4),'NO')]
               act(t:fac,'FCI') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y Eqstr(Val(cl4),'SI')
               act(t:fac,'AFJP Fondo') 
            Endif
            IF [Not Eqstr(Val(cl3),'FON') o Vacio(val(cl3))] Y Eqstr(Val(cl4),'SI')
               act(t:fac,'AFJP Encaje') 
            Endif
            IF Eqstr(Val(cl3),'OTR')
               act(t:fac,'Otros') 
            Endif
            IF Eqstr(Val(cl3),'OTR') y Eqstr(Val(cl4),'SI')
               act(t:fac,'AFJP') 
            Endif
*            act(t:fac+1,fbn('NrCuenta')) 
*            act(t:fac+1,Val(cl:5))
            ***---Se pone el codigo de la contraparte. Hablado con Cristina Segato 07-02-06
            ***  ACT(t:fac, Val(CL:1))

            *** Modificado por MB  21/2
            act(t:fac,Val(t:fac)~' '~Val(cl:6) )  

         Else
*            act(t:fac,fbn('NrCuenta'))
            act(t:fac,Val(cl:5))
         Endif
      Endif

***********************************************************************************
    IF fbn('CB8') = 1
       IF SQL(" Select 1 FROM "~DBO~".OPERACIONES WHERE NrOperacion3 = '"~fbn('NrOperacion3')~"' AND TipoOp <> '"~fbn('TipoOp')~"' AND TipoOp IN ('TIC','TIV') AND NrOperacion3 <> '00000' AND NrOperacion3 <> '     ' AND NrOperacion3 <> '' AND NrOperacion3 IS NOT NUll AND CB8='1' ")=1
          ACT(v:fac, '3ros.')
       ELSE
          ACT(v:fac, 'C.Propia')
       ENDIF
    ELSE
       ACT(v:fac, 'C.Propia')
    ENDIF
**********************************************************************************

    ACT(w:fac, fbn('ContraEspecie'))
    ACT(ES:1, fbn('ContraEspecie'))

    If Incluido(fbn('Tipo'),'Baja|cBaja')
       If EqStr(fbn['ObsErrorMAE'],'C')
          ACT(x:fac, 'Baja por Carta')
       Else
          ACT(x:fac, 'Baja')
       Endif
    Endif
    ACT(y:fac, fbn('NrOperacion3'))
    scn(tT2,1)
    SetFont(a:FAC..y:fac,1)
    FormatoCeldas(k:fac,Exe('F8'))
    AlinearCeldas(g:FAC..g:FAC,'D')
    AlinearCeldas(u:fac..v:fac,'D')
    AlinearCeldas(e:FAC..e:FAC,'I')

    *-Diarios
    IF Eqstr(fbn('Tipo'), 'Alta')
        SCN(to:1, Val(l:fac))
        SCN(to:2, Val(n:fac))
        SCN(to:3, Val(m:fac))

        SCN(to:5, Val(o:fac))
        SCN(to:6, Val(p:fac))

        SCN(TW:1, Val(q:fac))

        *-Mensuales
        SCN(tm:1, Val(l:fac))
        SCN(tm:2, Val(n:fac))
        SCN(tm:3, Val(m:fac))

        SCN(tm:5, Val(o:fac))
        SCN(tm:6, Val(p:fac))
        SCN(TW:2, Val(q:fac))
    ENDIF

    ACD(fo:1, fbn('FechaOp'))
    ACN(me:1, mes(fbn['FechaOp']))
Proximo 

If Val(vi2) = 0
  SetFilaActual(fac+2)
