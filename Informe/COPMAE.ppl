SQL.ADD(" SELECT 1 TpReg, 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, OP.ObservacDoc, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5, C.NrMAE, ")
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Especie   = E.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OP.Mercado4 not in ('"~VAR('MENEFFX')~"|"~VAR('MENEFTI')~"') AND ")
SQL.ADD("      OPB.NrBit IN (30,31) AND ")
SQL.ADD("      OPB.Valor = 1  ")
* Altas no carga trader ni anulacion
SQL.ADD(" UNION ")
SQL.ADD(" SELECT 1 TpReg, 'Alta' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ") 
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, OP.ObservacDoc, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5, C.NrMAE, ")
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Especie   = E.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OP.Mercado4 not in ('"~VAR('MENEFFX')~"|"~VAR('MENEFTI')~"') AND ")
SQL.ADD("      OPB.NrBit not IN (1,30,31) AND ")
SQL.ADD("      OPB.Valor = 1     ")
