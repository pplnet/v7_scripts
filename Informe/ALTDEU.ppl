HOJAVISIBLE(SI)
ModoReproceso(ConDialogo)
CrearDialogo
*--  Label1       : ''             ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Vehiculo1    : "Vehiculo"     ;1;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1     : "Banco"        ;2;;
  Fecha1       : "F.Desde"      ;3;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2       : "F.Hasta"      ;4;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  NrOperacion1 : "Nr.Operacion" ;5;;;;;;;;;;;
*--  Radio1  : "Listado de|Altas|Vencimientos" ;2;2;;;;;;;0
  Radio2  : "Expresado|ARP  |USD         "  ;5;2;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
messagebox('Dialogo.Vehiculo1')
messagebox(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo 1')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
     * Cancelar('El Operador no esta habilitado para operar con el Vehiculo )
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)
ACN(fi1,0)
ACT(f:2,'Fecha : '~Var('FECHASYS'))
SetFont(f:2..f:2,1)
ACT(a:FAC,'Altas de la deuda del periodo')

ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(a:FAC+1, 'Expresado en '~Val(mo1))
SetFont(a:fac..a:fac+1,3)
SetFilaActual(4)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Banco : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Banco : Todos')
endif

ACT(a:FAC+3, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a:fac..N:FAC+4,2)

SetFilaActual(FAC+6)
ACN(z11, FAC+1)

ACT(a:FAC,'Banco')
ACT(b:FAC,'Tipo Op')
ACT(c:FAC,'Numero Op.')
ACT(d:FAC,'Fecha Op.')
ACT(e:FAc,'Mon.')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(f:FAC,'Importe')

AlinearCeldas(a:FAC..b:FAC,'I')
AlinearCeldas(d:FAC..d:FAC,'I')
AlinearCeldas(c:FAC..c:FAC,'C')
AlinearCeldas(e:FAC..f:FAC,'C')
SetFont(a:fac..f:fac,2)
AgregarMarco(a:FAC..f:fac,2,0,Exe('COLOR'))

act(t1,'')
act(t2,'')
act(t3,'')
BorrarCeldas(w11..w11)
BorrarCeldas(w21..w21)
BorrarCeldas(w31..w31)
BorrarCeldas(w91..w91)

SetFilaActual(10)

SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalBrutoCli1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPCCV','MMPCL','MMPCOS','MMPE','MMFRP','MMPSI','MMFIMV','MMSIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMPLME') ")
SQL.ADD("order by 1,3,5,2,4 ")

Recorrer SQL

if Eqstr(Val(t1),'') y eqstr(Val(t2),'') y eqstr(Val(t3),'')
   act(t1, fbn('Vehiculo1'))
   act(t2, fbn('TipoOp'))
   act(t3, fbn('Especie'))
   act(a:fac,fbn('Vehiculo1'))
   AgregarMarco(a:FAC..f:fac,2,0,Exe('COLOR6'))
   SetFont(a:fac..f:fac,2)
   ifa
else
*-- Preparo corte de control
  if Not Eqstr(fbn('Vehiculo1'),Val(t1)) y NoVacio(Val(t1))
     act(a:fac,'Total Esp. '~Val(t3) )
     act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
     acn(f:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
     acn(f:fac, Val(w21))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
     acn(f:fac, Val(w11))
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..f:fac,2,0,Exe('COLOR6'))
     SetFont(a:fac..f:fac,2)
     ifa
     act(t1, fbn('Vehiculo1'))
     act(t2, fbn('TipoOp'))
     act(t3, fbn('Especie'))
     ifa
     act(a:fac,fbn('Vehiculo1'))
     AgregarMarco(a:FAC..f:fac,2,0,Exe('COLOR6'))
     SetFont(a:fac..f:fac,2)
     ifa
  Else 
   If [Not Eqstr(fbn['TipoOp'],Val(t2))] y NoVacio(Val(t2))
        * Cambia El Tipo de Operacion
        act(a:fac,'Total Esp. '~Val(t3) )
        act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
        acn(f:fac, Val(w31))
        BorrarCeldas(w31..w31)
        AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..f:fac,2)
        ifa
        act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
        acn(f:fac, Val(w21))
        BorrarCeldas(w21..w21)
        AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..f:fac,2)
        ifa
        * Asignar Tipo Operacion
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Especie'))
  Else
   If [Not Eqstr(fbn('Especie'),Val(t3))] y NoVacio(Val(t3))
*-- Cambia el Especie(Moneda)
        act(a:fac,'Total Esp. '~Val(t3) )
        act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
        acn(f:fac, Val(w31))
        BorrarCeldas(w31..w31)
        AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..f:fac,2)
        ifa
        *va desde aca
        act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
        acn(f:fac, Val(w21))
        BorrarCeldas(w21..w21)
        AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..f:fac,2)
        ifa
        *hasta aca
      * Asignar Especie
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Especie'))
   EndIf
  EndIf
 Endif
Endif
      *-- A: Cliente(Banco)
      *-- B: TipoOp
      *-- C: NrOperacion 
      *-- D: Fecha Op.
      *-- E: Especie(Moneda)
      *-- F: Importe Original
      *-- az1: Cotizacion 
      ACT(a:fac,FBN['Cliente1'])  
      ACT(b:fac,FBN['TipoOp'])   
      ACT(c:fac,FBN['NrOperacion'])
      ACLO(c:fac,FBN['NrOperacion'])
      ACT(d:fac,FBN['FechaOp'])
      ACT(e:fac,FBN['Especie'])
      ACN(az1,CotizacionC(fbn['Especie'],,,,Fsys,1,SI, IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR')))^IIF(EqStr(Modo(fbn['Especie'],IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))),'INV'),-1,1))
      ACN(az2,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      ACN(f:fac,FBN['Cantidad'])

