*        SCN(w21,val(f:fac)/VAR('ITLEUR')*IIF(Dialogo.Radio2=0,Cotizacion('APEU',,,,Fsys,1,SI),Cotizacion('APEU',,,,Fsys,1,SI)/Cotizacion('ARP',,,,Fsys,1,SI)))
*        SCN(w31,val(f:fac))
*        SetFont(a:FAC..f:fac,1)
*      Else
*        If Eqstr(fbn['Especie'],'JPY')
*        SCN(w11,IIF(Dialogo.Radio2=0,val(f:fac)*Cotizacion('APJY',,,,Fsys,1,SI)/100,val(f:fac)*Cotizacion('APJY',,,,Fsys,1,SI)/100/Cotizacion('ARP',,,,Fsys,1,SI)))
*        SCN(w21,IIF(Dialogo.Radio2=0,val(f:fac)*Cotizacion('APJY',,,,Fsys,1,SI)/100,val(f:fac)*Cotizacion('APJY',,,,Fsys,1,SI)/100/Cotizacion('ARP',,,,Fsys,1,SI)))
*        SCN(w31,val(f:fac))
*        SetFont(a:FAC..f:fac,1)
*        Else
*          If Eqstr(fbn['Especie'], 'EUR')
*            SCN(w11,val(f:fac)*IIF(Dialogo.Radio2=0,Cotizacion('APEU',,,,Fsys,1,SI),Cotizacion('APEU',,,,Fsys,1,SI)/Cotizacion('ARP',,,,Fsys,1,SI)))
*            SCN(w21,val(f:fac)*IIF(Dialogo.Radio2=0,Cotizacion('APEU',,,,Fsys,1,SI),Cotizacion('APEU',,,,Fsys,1,SI)/Cotizacion('ARP',,,,Fsys,1,SI)))
*            SCN(w31,val(f:fac))
*            SetFont(a:FAC..f:fac,1)
*          Else
            SCN(w11,val(f:fac)*Val(az2))
            SCN(w21,val(f:fac)*Val(az2))
            SCN(w31,val(f:fac))
            SetFont(a:FAC..f:fac,1)
*          EndIf
*        EndIf
*      EndIf
SCN(fi1,1)
Proximo
*-- Veo si hay algo para listar
if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
*-- Listo ultimo total
     ifa
     act(a:fac,'Total Esp. '~Val(t3) )
     act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
     acn(f:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1) )
     acn(f:fac, Val(w21))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
     acn(f:fac, Val(w11))
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..f:fac,2,0,Exe('COLOR6'))
     SetFont(a:fac..f:fac,2)
     ifa
     ifa
     act(a:fac,'Total General en '~Val(mo1))
     acn(f:fac, Val(w91))
     BorrarCeldas(w91..w91)
     AgregarMarco(a:fac..f:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,3)
FormatoCeldas(f:val(z11)..f:fac,Exe('F2'))

ACO(1,10)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,3)
ACO(6,11)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(f:fac)

