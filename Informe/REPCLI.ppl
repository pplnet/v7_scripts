AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
(.'DIALOGOPNL'.)
&DifDias := DifDias(Dialogo.Fecha2,Dialogo.Fecha1,no,no) + 1 
********************************************ANOTACIONES****************************************************************
*AA Saldos
    *AA:1  Saldo para MMCREM a ese dia(pesificado)
    *AA:2  SNC suma de saldos MMCREM
    *AA:3  Promedio de saldos dividido en la cantidad de fechas que 
    *AA:4 Pivote para guardar la cantidad para las operaciones de Tipo MMCO/MMCT/MMPF
*BB P&L
    *BB:1  SNC suma de P&LMMCREM ese dia(pesificado)
*CC Fechas para operaciones de Tipo MMCO/MMCT/MMPF
    *CC:1 FechaDesde
    *CC:2 FechaHasta     
*DD Controles de igualdad
    *DD:1 Valor de FAC donde se guardara el mismo Cliente
    *DD:2 Valor de FAC donde se guardara el mismo Cliente pero diferente Cuenta
*****************************************FIN ANOTACIONES****************************************************************
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

*********************************************ENCABEZADOS****************************************************************
ACT(a:fac+6,'P&L Tasa de Transferencia- Por Cliente')
SetFont(a:fac+6,1)
(.'ENCABEPNL'.)
*****************************************FIN ENCABEZADOS****************************************************************
ACN(w1,FAC)


ACT(a:fac, 'Codigo del Cliente')
ACL(a:Fac, 'REPCLP', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1=Dialogo.Cliente1, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
ACT(b:fac, 'Tipo y numero')
ACT(b:fac+1, 'de documento')
ACT(c:fac, 'Razon social')
ACT(d:fac, 'Capital Promedio')
ACT(e:fac, 'P&L Período')
ACT(f:fac, 'Oficial')
SetFont(a:FAC..f:FAC+1,1)
AgregarMarco(a:FAC..f:FAC+1,1,0,Exe('COLOR6'))
AlinearCeldas(d:FAC..e:fac,'D')

*Recorrer SQL operaciones 
(.'CONSPRETSA'.)
SQL.ADD(" Order by O.Cliente1,O.TipoOp")


IFA
Recorrer SQL
    DFA
    &TipoOp := FBN['TipoOp']
    
    *validacion check
    IF Dialogo.Radio2 = 0
        *PRECIO
        
    ELSE
        &DifDiasMMCREM := &DifDias
        &AuxDia := &DifDiasMMCREM 
        &NumeroCliente := FBN['Cliente1']
        &CodigoCuenta := FBN['Cuenta1'] 
        &TasaOP := Num(FBN['Precio1'])
        *Tasa de transf 
        &TasaTransf := Num(FBN['Precio4'])
        *Fecha Vencimiento de la operacion
        &FechaVto := FBN['FechaVto']
        *Fecha de la Operacion
        &FechaOp := FBN['FechaOp']
        *Saber si el cliente es el mismo
        IF NOT Eqstr(&NumeroCliente, Val(A:Val(DD:1)))
            IFA
            ACT(A:FAC,&NumeroCliente)
            ACN(DD:1,FAC)
            *TASA
            *CodigoCliente
            ACT(A:VAL(DD:1),FBN['Cliente1'])
            ACL(A:VAL(DD:1), 'REPCLP', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1=Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            if EqStri(FBN['CategDepositante'], 'FON')
                ACT(B:VAL(DD:1),FBN['TipoDocum']~" "~FBN['NrDocum'])
            else
                ACT(B:VAL(DD:1),FBN['TipoInscripcion']~" "~FBN['CUIT'])
            endif
            *Razon social
            ACT(C:VAL(DD:1),FBN['RazonSocial'])
            ACT(F:VAL(DD:1),FBN['OficialCuenta']~" - "~SQL("SELECT Descripcion FROM "~DBO~".OFICIALESCUENTA WHERE Codigo ='"~FBN['OficialCuenta']~"'"))
         ENDIF
      
        If EqStri(&TipoOp, 'MMCREM')
            Recorrer&i 0, Num(&DifDiasMMCREM)
                *Capital 
                ACN(AA:5,SQL("SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"') THEN 1 WHEN EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"' AND SALDO < 0) THEN 2 ELSE 3 END AS CodigoResultado;"))
                *Val(AA:5) = 2 El saldo existe pero es negativo
                IF Dialogo.Fecha1+&i >= &FechaOp Y   ((Dialogo.Fecha1+&i) < &FechaVto) Y Dialogo.Fecha1+&i <= Dialogo.Fecha2
                    IF Val(AA:5) = 2
                        &DifDiasMMCREM := &DifDiasMMCREM - 1
                        ELSE IF  DifDias(Dialogo.Fecha1 + &i,FBN['FechaVto'],no,no) = 0
                            *Val(AA:5) = 1 El saldo NO existe para ese dia
                            ELSE IF Val(AA:5) = 1 
                                    If Dialogo.Radio4 =0
                                        ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                    else 
                                        ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                    endif
                                ELSE
                                    *El saldo existe y no es negativo para ese dia
                                    If Dialogo.Radio4 =0
                                        ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2 ,1,,'ARP'))                
                                    else 
                                        ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                    endif
                                ENDIF
                            Endif
                        ENDIF
                    Endif
                SCN(AA:2,Val(AA:1))
                SCN(BB:1,(((&TasaTransf-&TasaOP) / 365 *  Val(AA:1) ))/100)
                ACN(AA:1,0)
            Proximo            
            
            
            ACN(AA:3,(Val(AA:2) / (&AuxDia)))
            SCN(D:Val(DD:1), Val(AA:3))
            SCN(E:Val(DD:1),Val(BB:1))
            *Seteo en 0 los pivotes
            ACN(AA:1,0)
            ACN(AA:2,0)
            ACN(AA:3,0)
            ACN(BB:1,0)
        Else
        (.'FECHAP&L'.)
            *Capital

            If Dialogo.Radio4 =0
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
            else 
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
            endif
            IF  Buscar(&TipoOp, Pipe2Comillas(Var('TIPOOPACTI')))
                *ACTIVO
                SCN(E:Val(DD:1),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100)
            Else 
                *Pasivo
                SCN(E:Val(DD:1),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100)
            EndIf
            ACN(AA:4,Val(AA:4)*&DifDias2)
            SCN(D:Val(DD:1),(Val(AA:4)/(&DifDias)))
         ENDIF   
    EndIF
Proximo

If NoVacio(Val(DD:2))
    SetFilaActual(Val(DD:2))
ENDIF

IFA
IFA
ACT(c:FAC,'TOTALES')
SetFont(c:FAC, 1)
ACN(d:FAC,Sum(d:Val(w1)+1..d:fac))
ACN(e:FAC,Sum(e:Val(w1)+1..e:fac))
FormatoCeldas(E:14..E:FAC,Exe('F2'))
FormatoCeldas(F:14..F:FAC,Exe('F2'))
AgregarMarco(c:FAC..e:FAC,1,0,Exe('COLOR7'))
ACT(a:FAC+1,'FIN DEL INFORME')
SetFont(a:FAC+1, 1)
ACO(1,14)
ACO(2,18)
ACO(3,40)
ACO(4,14)
ACO(5,14)
ACO(6,20)

LimitesVision(G:FAC+2)
RangoTitulo(a:1..f:fac, Val(w1))
SetPrintFit(3, 95)
Impresion(1, 2)
