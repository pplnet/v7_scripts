MostrarCuadroDeMensajes
CrearDialogo
   Fecha1  :  'D.Fecha'   ;1;1;;;;;;;FSYS
   Fecha2  :  'H.Fecha'   ;2;1;;;;;;;FinDeMes(FSYS)
   Especie1:  'Moneda'    ;1;2;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Moneda Invalida';NO;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
   Lista2:   'Bancos'    ; 3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
   Lista3:   'Cuentas'   ;-3;2;;;;;;;;IIF(NOVACIO(Dialogo.Lista2), SQLSet(" Select Codigo From "~DBO~".CUENTAS WHERE Estado='HAB' AND (Especies LIKE '%"~Dialogo.Especie1~"%' OR Especies LIKE '%MONEDA%') AND   Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "),'');SQLSet(" Select Codigo From "~DBO~".CUENTAS WHERE Estado='HAB' AND (Especies LIKE '%"~Dialogo.Especie1~"%' OR Especies LIKE '%MONEDA%') ");
   Lista1:   'Vehiculos' ;  ;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Radio1:   "TipoCta.|Todas|CtaCte";;;;;;;;;1
FinDialogo

If NOT OK
  Cancelar
Endif

CrearFont(1,"Arial,12,BI")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,BI")
CrearFont(4,"Arial,8,BU")
CrearFont(5,"Arial,8,BI")
CrearFont(6,"Arial,8,B")
CrearFont(7,"Arial,8,")


ACT(a:1, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:2, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:3, 'Cuentas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2 )
if Dialogo.Radio1 =1
   ACT(a:5, 'Tipo de Cta: Cta.Cte.')
else
  ACT(a:5, 'Tipo de Cta: Todas')
endif

ACT(c:4, 'Proyeccion de Movimientos en '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
SetFont(a:1..z:5,6)
SetFont(C:4,3)

SetFilaActual(6)

ACT(a:fac,  'Banco')
ACT(b:fac,  'Saldo al')
ACT(b:fac+1, '('~Fecha(Dialogo.Fecha1-1)~')'  )
ACT(c:fac, 'Pendientes al ')
ACT(c:fac+1, '('~Fecha(Dialogo.Fecha1-1)~')'  )

ACN(co:1, 4)

Recorrer&i 0, Dialogo.Fecha2-Dialogo.Fecha1
  ACD(Val(co:1):fac, Dialogo.Fecha1+&i)
  SCN(co:1,1)
Proximo
ACT(Val(co:1):fac, 'Posterior al ')
ACT(Val(co:1):fac+1, Dialogo.Fecha2)
ACT(Val(co:1)+1:fac, 'Total')

SetFont(a:fac..zz:fac+1,3)
AlinearCeldas(a:fac..zz:fac+1,'C')
AgregarMarco(a:fac..Val(co:1)+1:fac+1,0,0,EXE('COLOR6'))

ACN(fi:1, fac)
ifa

SQL.ADD(" SELECT S.Especie, S.Saldo Cantidad, S.EnteCustodia, S.Cuenta, S.Fecha, 'Saldo' Tipo, C.RazonSocial, CU.Numero, CU.Comitente ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU ")
SQL.ADD(" WHERE  S.Especie  = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   CU.TipoCuenta     = 'CC' ")
endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  S.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" AND    CU.Comitente   = C.Codigo ")
SQL.ADD(" AND    S.Cuenta       = CU.Codigo ")
SQL.ADD(" AND    S.Fecha   < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND S.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".SALDOSDIA  ")
SQL.ADD("                 WHERE  Especie      = S.Especie ")
SQL.ADD("                 AND    Cuenta       = S.Cuenta  ")
SQL.ADD("                 AND    Cliente      = S.Cliente ")
SQL.ADD("                 AND    EnteCustodia = S.EnteCustodia ")
SQL.ADD("                 AND    Fecha   < '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT S.Especie, S.Cantidad*(-1) Cantidad, S.EnteCustodia, S.Cuenta, S.FechaMov Fecha, 'Pendiente' Tipo, C.RazonSocial, CU.Numero, CU.Comitente ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU, "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE  S.Especie  = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   CU.TipoCuenta     = 'CC' ")
endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  S.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" AND  CU.Comitente  = C.Codigo ")
SQL.ADD(" AND  S.Cuenta      = CU.Codigo ")
SQL.ADD(" AND  S.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND  S.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT S.Especie, S.Cantidad, S.EnteCustodia, S.Cuenta, S.FechaMov Fecha, 'Pendiente' Tipo, C.RazonSocial, CU.Numero, CU.Comitente ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU, "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE  S.Especie  = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   CU.TipoCuenta     = 'CC' ")
endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  S.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" AND  CU.Comitente  = C.Codigo ")
SQL.ADD(" AND  S.Cuenta      = CU.Codigo ")
SQL.ADD(" AND  S.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND  S.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT S.Especie, S.Cantidad Cantidad, S.EnteCustodia, S.Cuenta, S.FechaMov Fecha, 'Pendiente' Tipo, C.RazonSocial, CU.Numero, CU.Comitente ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU, "~DBO~".TRANSACCIONES2 O ")
SQL.ADD(" WHERE  S.Especie  = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   CU.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    O.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  S.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" AND  CU.Comitente  = C.Codigo ")
SQL.ADD(" AND  S.Cuenta      = CU.Codigo ")
SQL.ADD(" AND  S.NrOperacion = O.NrTrans ")
SQL.ADD(" AND  S.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT S.Especie, S.Cantidad Cantidad, S.EnteCustodia, S.Cuenta, S.FechaMov Fecha, 'Pendiente' Tipo, C.RazonSocial, CU.Numero, CU.Comitente ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS S, "~DBO~".CLIENTES C, "~DBO~".CUENTAS CU, "~DBO~".TRANSACCIONES2 O ")
SQL.ADD(" WHERE  S.Especie  = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   CU.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    O.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  S.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" AND  CU.Comitente  = C.Codigo ")
SQL.ADD(" AND  S.Cuenta      = CU.Codigo ")
SQL.ADD(" AND  S.NrOperacion = O.NrTrans ")
SQL.ADD(" AND  S.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" ORDER By 1, 4 ")

ACT(cu:1, '')
ACT(cc:1, '')
ACD(fe:1, 0)

Recorrer SQL
  IF Not Eqstr(Val(cu:1), fbn('Comitente')) o Not Eqstr(Val(cc:1), fbn('Cuenta'))
     ifa
     message('Banco: '~fbn('RazonSocial')~'. Cuenta:'~fbn('Numero'))
     ACT(a:fac, fbn('RazonSocial')~'. Cuenta:'~fbn('Numero'))
     SetFont(a:fac, 5)
  ELSE
     DFA
  ENDIF
  IF Eqstr(fbn('Tipo'), 'Saldo')
     SCN(b:fac, fbn('Cantidad'))
  ELSE
     IF fbn('Fecha')<Dialogo.Fecha1
        SCN(c:fac, fbn('Cantidad'))
     ELSE
        IF fbn('Fecha')>Dialogo.Fecha2
           SCN(Val(co:1):fac, fbn('Cantidad'))
        ELSE
           Recorrer&i 4, Val(co:1)-1
              * -- Busco la columna que corresponde a la fecha del movimiento.
              If Val(&i:Val(fi:1))=fbn('Fecha')
                SCN(&i:fac, fbn('Cantidad'))
                AsignarLink(&i:fac, 'APB1',Fecha1=fbn('Fecha'),Fecha2=fbn('Fecha'),Radio1=4,Lista2=fbn('Comitente'),Lista1=Dialogo.Lista1,Lista4=fbn('Cuenta'),Lista3=Dialogo.Especie1,Check1=0,Radio2=2)
              Endif
           Proximo          
        ENDIF
     ENDIF
  ENDIF

  * -- Columna de Totales
  SCN(Val(co:1)+1:fac, fbn('Cantidad'))
  ACT(cu:1,  fbn('Comitente'))
  ACT(cc:1, fbn('Cuenta'))
Proximo

ifa
ifa

ACT(a:fac, 'Totales por dia     --> ')
Recorrer&i 2, Val(co:1)+1
  SCN(&i:fac, SUM(&i:Val(fi:1)+1..&i:fac))
Proximo
SetFont(a:fac..Val(co:1)+1:fac,3)
AgregarMarco(a:fac..Val(co:1)+1:fac,0,0,EXE('COLOR6'))

FormatoCeldas(b:Val(fi:1)+1..Val(co:1)+1:fac, EXE('F2'))

Recorrer&i 1, Val(co:1)+1
  ACO(&I, 10)
Proximo
ACO(1, 30)

ACO(Val(co:1), 15)

FijarCol(2)

Impresion(1,2)

LimitesVision(Val(co:1)+1:fac+2)