SetFilaActual(8)
SQL.ADD("Select Codigo, RazonSocial from "~DBO~".CLIENTES WHERE Codigo IN (SELECT Codigo FROM "~DBO~".LIMCONSUMIDOS) ")
Recorrer SQL
  if EsTerminal(fbn('Codigo'), Cliente)

    *ACT(a:fac, fbn('Codigo'))
    ACT(a:fac, Pad(fbn('Codigo'),10)~' - '~fbn('razonsocial'))
    AsignarLink(a:fac,'LCRCON',Fecha1=Dialogo.Fecha1,Cliente1=FBN('Codigo'),Vehiculo1=Dialogo.Vehiculo1)
* FJL 15/8/18 - En V6 no se carga LimOperativo en la tabla LIMASIGNADOS
*    ACN(b:fac, LimOperativo(fbn('Codigo'), 'SETTLEMENT','USD',Dialogo.Vehiculo1))
*    ACN(e:fac, LimOperativo(fbn('Codigo'), 'PRESETTLEM','USD',Dialogo.Vehiculo1))
*    ACN(h:fac, LimOperativo(fbn('Codigo'), 'DFROM'     ,'USD',Dialogo.Vehiculo1))
    ACN(b:fac, LimAsignado(fbn('Codigo'), 'SETTLEMENT','USD',Dialogo.Vehiculo1))
    ACN(e:fac, LimAsignado(fbn('Codigo'), 'PRESETTLEM','USD',Dialogo.Vehiculo1))
    ACN(h:fac, LimAsignado(fbn('Codigo'), 'DFROM'     ,'USD',Dialogo.Vehiculo1))
    ACN(c:fac, LimSumado(   fbn('Codigo'), 'SETTLEMENT',Dialogo.Fecha1,Dialogo.Vehiculo1))
    SCN(c:fac, LimSumado(   fbn('Codigo'), 'SETTFAIL'  ,Dialogo.Fecha1,Dialogo.Vehiculo1))
    ACN(f:fac, LimConsumido(fbn('Codigo'), 'PRESETTLEM','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))
    ACN(i:fac, LimConsumido(fbn('Codigo'), 'DFROM'     ,'USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))


    if Val(c:fac)>0.01 y Val(c:fac)<-0.01
      AsignarLink(c:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),Vehiculo1=Dialogo.Vehiculo1,TipoLimite1='SETTLEMENT')
    endif
    if Val(f:fac)>0.01 y Val(f:fac)<-0.01
      AsignarLink(f:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),Vehiculo1=Dialogo.Vehiculo1,TipoLimite1='PRESETTLEM')
    endif
    if Val(i:fac)>0.01 y Val(i:fac)<-0.01
       AsignarLink(i:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),Vehiculo1=Dialogo.Vehiculo1,TipoLimite1='DFROM')
    endif
    ACN(d:fac, Val(b:fac)-Val(c:fac))
    ACN(g:fac, Val(e:fac)-Val(f:fac))

    ACN(j:fac, Val(h:fac)-Val(i:fac))
**    if Dialogo.Radio1=1 y [Val(b:fac)>-0.01 y Val(b:fac)<0.01] y [Val(e:fac)>-0.01 y Val(e:fac)<0.01] y [Val(k:fac)>-0.01 y Val(k:fac)<0.01] y [Val(h:fac)>-0.01 y Val(h:fac)<0.01] y [Val(n:fac)>-0.01 y Val(n:fac)<0.01]
    if Dialogo.Radio1=1 y [Val(b:fac)>-0.01 y Val(b:fac)<0.01] y [Val(e:fac)>-0.01 y Val(e:fac)<0.01] y [Val(h:fac)>-0.01 y Val(h:fac)<0.01] y [Val(n:fac)>-0.01 y Val(n:fac)<0.01]
       BorrarCeldas(a:FAC..s:FAC)
       DFA
    endif
**    if Dialogo.Radio1=2 y [Val(c:fac)>-0.01 y Val(c:fac)<0.01] y [Val(f:fac)>-0.01 y Val(f:fac)<0.01] y [Val(i:fac)>-0.01 y Val(i:fac)<0.01] y [Val(l:fac)>-0.01 y Val(l:fac)<0.01] y [Val(o:fac)>-0.01 y Val(o:fac)<0.01]
    if Dialogo.Radio1=2 y [Val(c:fac)>-0.01 y Val(c:fac)<0.01] y [Val(f:fac)>-0.01 y Val(f:fac)<0.01] y [Val(i:fac)>-0.01 y Val(i:fac)<0.01] y [Val(o:fac)>-0.01 y Val(o:fac)<0.01]
       BorrarCeldas(a:FAC..s:FAC)
       DFA
    endif
**    if Dialogo.Radio1=3 y Val(d:fac)>=-0.01 y Val(g:fac)>=-0.01 y Val(j:fac)>=-0.01 y Val(m:fac)>=-0.01 y Val(p:fac)>=-0.01
    if Dialogo.Radio1=3 y Val(d:fac)>=-0.01 y Val(g:fac)>=-0.01 y Val(j:fac)>=-0.01 y Val(p:fac)>=-0.01
       BorrarCeldas(a:FAC..s:FAC)
       DFA
    endif
  else
    dfa
  endif
