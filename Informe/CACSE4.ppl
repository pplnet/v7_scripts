ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;Incluido(SQL("Select TipoOp From "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' "),'SEVS|SECS');'El TipoOp debe ser SECS o SEVS';NO;;;;;;"TipoOp in ('SECS','SEVS')";
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1,"Times New Roman,11,")
CrearFont(2,"Times New Roman,11,B")
CrearFont(3,"Arial Black,21,B")
CrearFont(4,'Wingdings 2,14,')

SetFilaActual(1)
SQL.ADD(" Select C.Localidad, C.Fax, C.Telefono, C.Direccion, C.PaisDir, C.CodigoPostal, C.CUIT, O.Vehiculo1 ")
SQL.ADD(" From "~DBO~".CLIENTES C ")
SQL.ADD(" JOIN "~DBO~".OPERACIONES O ")
SQL.ADD(" on C.Codigo = O.Vehiculo1 ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  AgregarBMP(c:fac,Var('PATHLOGO')~fbn('Vehiculo1')~'.bmp',150)
  SetFilaActual(FAC+4)
  ACT(f:fac,fbn('Direccion')~' , CP '~fbn('CodigoPostal'))
  ACT(f:fac+1,fbn('Localidad')~' - '~BuscarCampo('PAISES','Nombre','Codigo',fbn('PaisDir')))
  ACT(f:fac+2,'R.U.T. '~fbn('CUIT'))
  ACT(a:fac+4,'Attn: '~VAR('CONURUSE'))
  ACT(e:fac+4,'Fax: '~fbn('Fax'))
Proximo

setFont(f:fac..f:fac+2,2)
setFont(a:fac+4..f:fac+4,1)
AlinearCeldas(f:fac..f:fac+2,'C')

SQL.ADD(" Select O.TipoOp,O.FormaLiquidacion1,O.ContraEspecie,O.Cantidad,O.Precio1,O.TotalBrutoCli1,O.TotalIntereses,O.FechaOp,O.FechaVto,O.Cliente1,E.Nombre,E.ISIN ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" LEFT JOIN "~DBO~".ESPECIES E ")
SQL.ADD(" on O.Especie=E.Codigo ")
SQL.ADD(" where O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
  *Cuadro1 
  SetFilaActual(Fac+5)
  ACT(A:fac,'Please Check Appropiate Boxes:')
  ACT(A:fac+1,Chr(208))
  SetFont(A:fac+1,4)
  ACT(B:fac+1,'New Instruction')
  ACT(F:fac+1,'Deliver vs. Payment')
  ACT(H:fac+1,'Receive vs. Payment')
  ACT(B:fac+2,'Cancellation')
  ACT(F:fac+2,'Deliver Free')
  ACT(H:fac+2,'Receive Free')
  ACT(B:fac+3,'Amendment')
  SetFont(A:fac,2)
  SetFont(b:fac+1..h:fac+3,1)

  ***DVP***
  If EqStr(fbn('TipoOp'),'SEVS')
    ACT(E:FAC+1,Chr(208))
    SetFont(E:FAC+1,4)
  ***RVP***
  Else
    ACT(G:FAC+1,Chr(208))
    SetFont(G:FAC+1,4)
  Endif

  AlinearCeldas(A:fac+1..A:FAC+3,'C')
  AlinearCeldas(E:fac+1..E:FAC+3,'C')
  AlinearCeldas(G:fac+1..G:FAC+3,'C')
  AgregarMarco(a:fac..h:FAC,2,8)
  AgregarMarco(a:fac+1..a:FAC+3,0,3)
  AgregarMarco(b:fac+1..d:FAC+3,0,1)
  AgregarMarco(e:fac+1..h:FAC+3,0,3)

  *Cuadro2 

  SetFilaActual(Fac+7)
  acn(aa:1,fac)
  ACT(C:fac,'Mandatory Fields')
  ACT(C:fac+1,'Security Description')
  ACT(G:FAC+1,fbn('Nombre'))
  ACT(C:fac+2,'Security No. (ISIN or SEDOL)')
  ACT(G:fac+2,fbn('ISIN'))
  ACT(C:fac+3,'Currency of Security')
  ACT(G:fac+3,fbn('ContraEspecie'))
  ACT(C:fac+4,'Quantity')
  ACT(G:fac+4,PYC(fbn('Cantidad'),0,2))
  ACT(C:fac+5,'Price')
  ACT(G:fac+5,PYC(fbn('Precio1'),0,3))
  ACT(C:fac+6,'Principal Amaunt/Currency')
  ACT(G:fac+6,PYC(fbn('TotalBrutoCli1'),0,2))
  ACT(C:fac+7,'Accrued Interest (if bond)')
  ACT(G:fac+7,PYC(fbn('TotalIntereses'),0,2))
  ACT(C:fac+8,'Commissions, Taxes, Other Charges')
  ACT(C:fac+9,'Net Cash Amount/Currency')
  ACT(G:fac+9,PYC(fbn('TotalBrutoCli1')+fbn('TotalIntereses'),0,2))
  ACT(A:fac+10,'  Carry Value (')
  ACT(B:fac+10,'            FOR FREE RECEIVES')
  ACT(E:fac+10,' )')
  ACT(C:fac+11,'Trade Date')
  ACT(G:FAC+11,fbn('FechaOp'))
  ACT(C:fac+12,'Settlement Date')
  ACT(G:fac+12,fbn('FechaVto'))
  ACT(C:fac+13,'Client Account')
  ACT(G:fac+13,'')
  ACT(C:fac+14,'Broker & City')
  ACT(G:fac+14,BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente1')))
  ACT(C:fac+15,'Reference')
  ACT(C:fac+16,'Settlement Agent & City / Depository #')
  ACT(G:fac+16,'')
Proximo

Recorrer&I 0,17
  AFI(fac+&i,20)
Proximo

setFont(c:fac,2)
setFont(a:fac+1..g:fac+16,1)
SetFont(b:fac+10,2)

AgregarMarco(a:fac..e:FAC,2,0)
AgregarMarco(f:fac..h:FAC,2,0)

AgregarMarco(a:fac+1..e:FAC+16,1,1)
AgregarMarco(f:fac+1..h:FAC+16,1,1)
Alinearceldas(a:val(aa:1)..h:fac+16,'C' )
AlinearCeldas(a:fac+10..c:fac+10,'I')

SetFilaActual(Fac+21)
ACT(F:fac,'________________________________________________________')
ACT(G:fac+1,'German Perez')
SetFont(G:fac+1,2)
AlinearCeldas(G:fac+1,'C')

ACO(1,4)
*ACO(2,18)
*ACO(3,4)
*ACO(4,15)
*ACO(5,4)
*ACO(6,15)
ACO(2,7)
ACO(3,4)
ACO(4,7)
ACO(5,4)
ACO(6,15)
ACO(7,4)
ACO(8,15)

SetMargins(1.5,1,0,1)
LimitesVision(i:FAC+1)
Impresion(2,0)
Impresion(3,0)