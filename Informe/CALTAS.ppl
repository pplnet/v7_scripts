CrearDialogo
   Vehiculo1    : 'Vehiculo'    ;;;;;;[NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIf(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ")))];'Vehiculo Invalido';NO;;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "));;;IIf(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ","(Status='HAB' or Status Is Null or Status='') ");
   Fecha1       : 'Fecha'       ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;Habiles(FSys,1,'ARG');
   TipoOp1      : 'Tipo Op'     ;;;;;;
   NrOperacion1 : 'NrOperacion' ;;;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

If NoVacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   Endif
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Endif
Endif

CrearFont(1, "Arial, 8,")
CrearFont(2, "Arial, 8,B,")
CrearFont(3, "Arial,10,B,")
CrearFont(4, "Arial, 8,BI,")

SetFilaActual(2)

*- Encabezado del informe
ACT(a:FAC, 'AGENDA DE TASAS A INGRESAR')
SetFont(a:FAC, 3)
IFA
IFA

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(a:FAc, 'Vehiculo: Todos')
Endif

ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
If NoVacio(Dialogo.TipoOp1)
   ACT(a:FAC+2, 'Tipo Operacion: '~Dialogo.TipoOp1)
Endif
If NoVacio(Dialogo.NrOperacion1)
   ACT(a:FAC+3, 'NrOperacion: '~Dialogo.NrOperacion1)
Endif
SetFont(a:FAC..a:FAC+3, 2)

SetFilaActual(FAC+5)

*- Selecciono las operaciones de multiple vencimiento
SQL.ADD("SELECT O.NrOperacion, O.Especie, ")
SQL.ADD("FROM ")
SQL.ADD("WHERE ")
SQL.ADD("")
SQL.ADD("")
