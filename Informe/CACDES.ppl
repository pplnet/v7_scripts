SetFilaActual(fac+2)
ACT(a:fac,'Por medio de la presente, confirmamos a Uds. estar tomando un acuerdo en descubierto por la')
SetFilaActual(fac+1)
ACT(a:fac,'suma de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.- '~BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99))~' con Fecha '~FStr(Dia(val(zl:99)),1,0)~' de '~Meses(Mes(val(zl:99)))~' de '~FStr(Anio(val(zl:99)),4,0)~' por '~val(zh:99)~IIF(num(val(zh:99))>1,' d'~Chr(237)~'as',' d'~Chr(237)~'a')~', cuyo')
SetFilaActual(fac+1)
ACT(a:fac,'vencimiento se producir'~Chr(225)~' el '~FStr(Dia(val(zi:99)),1,0)~' de '~Meses(Mes(val(zl:99)))~' de '~FStr(Anio(val(zi:99)),4,0)~' a una T.N.A. de '~val(zj:99)~'%')

SetFilaActual(fac+2)
ACT(a:Fac,'Sin otro particular, saludamos a Uds. muy atte.')
SetFont(a:val(zz:99)..a:fac,1)

