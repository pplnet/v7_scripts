ACN(ax:1, SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'NCAR' "))
if Val(ax:1)>0
   if Dialogo.Radio1=0
      MessageBox('El Libro del '~Dialogo.Fecha1~' ya fue emitido.')
   else
      Cancelar('El Libro del '~Dialogo.Fecha1~' ya fue emitido. Debe utlizar la reimpresion.')
   endif
endif

If Dialogo.Radio1=1
  ACD(t:1,Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCAR' "),1,'ARG',SI))
  if Val(t:1) > Fecha('2000/01/01')
     ACD(t:2,Habiles(FSys,-1,'ARG',SI))
     if Dialogo.Radio2=0
        if Val(t:1) >  Habiles(FSys,-1,'ARG',SI)
           Cancelar('LIBCAS - No hay fechas disponibles para impresión. '~Val(t1)~' - '~Val(t2))
        endif
     else
        if Val(t:1) >  Habiles(FSys,1,'ARG',SI)
           Cancelar('LIBCAS - No hay fechas disponibles para impresión.'~Val(t1)~' - '~Val(t2))
        endif
     endif
     if Val(t:1) <> 0  y Val(t:1) <> Dialogo.Fecha1
        Cancelar('LIBCAS - No se permite saltar fechas habiles.')
     endif
  endif
Endif

