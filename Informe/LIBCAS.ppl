** Control paginado.

ACN(aw6,FAC)
(.'LIBCASTIT'.)

    ACT(me:10,FBN['Mercado'])
    
    *1ra linea    
    ACT(k:fac,fbn['NrOperacion'])
    
    ACT(a:FAC, IIF(longitud(fbn['NrBoleto'])<=6,fbn['NrBoleto'],Copy(fbn['NrBoleto'],longitud(fbn['NrBoleto'])-5,6)) )
    if EqStr(fbn('BYMA'),'NO')
       ACT(b:fac, fbn('Cliente1')~' - '~Copy(fbn('RazonSocial'),1,25))
    else
       ACT(b:fac, Val(xx1))  
    endif
    ACT(c:FAC, fbn['CUIT'])
    ACT(f:FAC, fbn['Especie']~' '~fbn['CodNumCajaValores'])
    ACD(h:FAC, fbn['FechaOp'])
    ACD(i:FAC, fbn('FechaVto'))
    

    If Incluido(fbn['TipoOp'],'TIC')
       ACT(j:FAC, 'Compra')
    EndIf
    If Incluido(fbn['TipoOp'],'TIV')
       ACT(j:FAC, 'Venta')
    Endif
    If Incluido(fbn['TipoOp'],'TIFC')
       ACT(j:FAC, 'Compra Fut')
    EndIf
    If Incluido(fbn['TipoOp'],'TIFV')
       ACT(j:FAC, 'Venta Fut ')
    Endif
    If EqStr(fbn['PaseCB'],'1')
       ACT(j:FAC, val(j:fac)~' Por Pase ')       
    EndIf

    FormatoCeldas(c:fac,Exe('F0'))
    FormatoCeldas(b:fac,Exe('F9'))
    SetFont(a:FAC..y:fac,1)
    
    *2da linea
    IFA
    
    ACT(xy100, fbn['UDN2'])
    ACT(xy2, fbn['NrOrdenAux'])
    ACT(xy4, fbn['NumOpeSENEBI'])

    If (fbn('CB4') = 1 o ((EqStr(fbn('Cliente1'),VAR('VEHICULODE')) o EqStr(fbn('Cliente1'),VAR('CLIENTEMAE'))) y NoVacio(fbn('NrOrden1')) y Not EqStr(fbn['TipoOp'],'TCOPRI'))) y Not EqStr(BuscarCampo('UDNS','SenebiSistaco','Codigo',fbn['UDN2']),'SI')
      SQL.ADD("SELECT * from "~DBO~".EJECUCIONES where NrOperacion = '"~fbn['NrOperacion']~"' ")
      dfa
      Recorrer SQL

         ACN(aw6,fac)
         (.'LIBCASTIT'.)      

         ** AA 05/07/2023 se actualiza Bind modificado 10/07/2023 solo para BYMA
         if Eqstr(Val(me:10),'BYMA')
            ACT(f:fac,'Reg: '~fbn['NrSecuencia']~' Orden: '~iif(Incluido(Val(xy100),'FIX|SDIB'),Val(xy2),iif(Incluido(Val(xy100),VAR('COPIATSNBG')),Val(xy4),fbn['NrSecuencia']))~'  '~fbn['Fecha'] )
         else
           ACT(xy1, Copy(Fstr(Anio(FBN['Fecha']),0,0),3,2)~Pad0(Fstr(Mes(FBN['Fecha']),0,0),2)~Pad0(Fstr(Dia(FBN['Fecha']),0,0),2) )
           ACT(xy2, Copy(Hora(fbn('Fecha')),1,2)~Copy(Hora(fbn('Fecha')),4,2)~Copy(Hora(fbn('Fecha')),7,2))
           if Incluido(Val(xy100),VAR('COPIATSNBG'))
              ACT(xy3, Pad0(Copy(Fstr(val(xy4),0,0),1,6),6))
           else
              ACT(xy3, Pad0(Copy(Fstr(fbn('NrSecuencia'),0,0),1,5),5))
           endif
           ACT(f:fac,fbn['NrEjecucion']~' '~Val(xy1)~Val(xy2)~Val(xy3))
        endif

        ACN(b:fac,fbn['Precio'])
        ACN(c:fac,fbn['Cantidad'])
        ACN(e:fac,fbn['Cantidad']*fbn['Precio'])
        ACN(g:fac, Val(e:fac))
        FormatoCeldas(c:fac,Exe('F0'))
        FormatoCeldas(b:fac,Exe('F9'))
        SetFont(a:FAC..y:fac,1)
        
      Proximo  
  else
    
    ACN(c:fac,fbn['Cantidad'])
    
    If Eqstr(FBN['Especie'],'FRB') 
       ACN(b:fac, FBN['Precio1']*fbn('VTeorico') )
    Else
       If EqStr(fbn['EsAforado'],'1')
          ACN(b:fac, FBN['TipoCambio2'])
       Else
          ACN(b:fac, FBN['Precio1'])
       Endif
    Endif

    If EqStr(fbn['EsAforado'],'1')  
       ACN(e:fac, fbn['TotalCaucion']-IIF(EqStr(FBN['CotizaMAE'],'CLE'),fbn['TotalIntereses'],0))
    Else
       ACN(e:fac, fbn['TotalBrutoCli1'])
    Endif   
       
    ACN(g:fac, fbn['TotalNetoCli1'])
    
    FormatoCeldas(c:fac,Exe('F0'))
    FormatoCeldas(b:fac,Exe('F9'))

    
    if Incluido(Val(xy100),VAR('COPIATSNBG'))
       **ACT(xy3, Pad0(Copy(Fstr(fbn('NroAltaMAE'),0,0),1,5),5))
       ACT(xy3, Pad0(Copy(Fstr(Val(xy4),0,0),1,6),6))
       ACT(f:fac,'Reg: '~Val(xy3)~'   '~fbn('FechaAltaMAE') )       
    else
       ACT(xy3, Pad0(Copy(Fstr(fbn('NroAltaMAE'),0,0),1,5),5))
       IF NoVacio(FBN['NroAltaMAE']) 
          ACT(xy1, Copy(Fstr(Anio(FBN['FechaAltaMAE']),0,0),3,2)~Pad0(Fstr(Mes(FBN['FechaAltaMAE']),0,0),2)~Pad0(Fstr(Dia(FBN['FechaAltaMAE']),0,0),2) )
          ACT(xy2, Copy(Hora(fbn('FechaAltaMAE')),1,2)~Copy(Hora(fbn('FechaAltaMAE')),4,2)~Copy(Hora(fbn('FechaAltaMAE')),7,2))
          ACT(f:fac,Val(xy1)~Val(xy2)~Val(xy3))       
       ENDIF
    endif   
  endif

    *3ra linea
    * Observaciones
    ifa 
    If Incluido(fbn['Tipo'],'5|6')
       ACT(a:fac,'Anulada')
    *else
    *   ACT(a:fac,'Prueba')
    endif

    SetFont(a:Fac-3..j:fac,1)
    
proximo


