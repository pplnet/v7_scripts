SQL.ADD("Select 1 Reg,Especie, Cupon1, TipoOp,FechaVto,Cantidad,O.NrOperacion,O.NrBoleto,O.NrBoleto2,FechaOp,FechaPago,ContraEspecie,TotalNetoCli1, 1 as Tipo, ")
SQL.ADD(" C.RazonSocial, CUIT, 'NO' BYMA, UDN2, NrOrdenAux, NumOpeSENEBI, Cliente1, CodNumCajaValores, Mercado4 Mercado, PASECB, CB4, NrOrden1, NroAltaMAE, FechaAltaMAE, ")
SQL.ADD(" E.CotizaMAE,O.EsAforado,O.TotalCaucion, E.InteresesC,O.TotalBrutoCli1, O.TotalIntereses, Precio1, O.TipoCambio2, ")
SQL.ADD(" Case When OB.Nrbit in (30,31) then 'NO' else 'SI' end Activa, Plazo")
SQL.ADD("  from  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" where O.Especie =  E.Codigo ")
SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.Valor = 1 ")
SQL.ADD("   and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
**SQL.ADD("   and O.FechaOp > '20230101' ")
IF EqStr(VAR('LICILIBROS'),'SI')
   SQL.ADD("   and (O.TipoOp  in ('TIC','TIV','TIFC','TIFV') or (O.TipoOp = 'TCOPRI' and O.Corporate = 1))  ")
ELSE
   SQL.ADD("   and O.TipoOp  in ('TIC','TIV','TIFC','TIFV')  ")
ENDIF
SQL.ADD("   and   (O.Cliente1 <> '"~VAR('VEHICULODE')~"' and O.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('VEHICULODE')~"'=C.Codigo)")
