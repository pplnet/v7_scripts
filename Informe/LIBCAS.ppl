SQL.ADD("select TipoOP, plazo, SUM(Total) cantidad from ( ")
SQL.ADD(" Select Especie,Case when Plazo >= 24 then Plazo/24 else Plazo end Plazo,TotalNetoCli1,Cantidad*precio1 as Total,")
SQL.ADD(" Case when tipoop = 'TIC' and CB4=1 and UDN2='CPC1' then 'TIV' when tipoop = 'TIV' and CB4=1 and UDN2='CPC1' then 'TIC'  ")
SQL.ADD(" when tipoop = 'TIFC'  then 'TIC'  when tipoop = 'TIFV'  then 'TIV' when tipoop = 'TCOPRI'  then 'TIC' else tipoop end TipoOp")
SQL.ADD("  from  "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.Valor = 1  and OB.NrBit not in (30,31)")
SQL.ADD("   and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
IF EqStr(VAR('LICILIBROS'),'SI')
   SQL.ADD("   and (O.TipoOp  in ('TIC','TIV') or (O.TipoOp = 'TCOPRI' and O.Corporate = 1))  ")
ELSE
   SQL.ADD("   and O.TipoOp  in ('TIC','TIV')  ")
ENDIF
