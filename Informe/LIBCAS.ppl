**-- Toma los incrementos y disminucion de cartera propia --**
** FJL 27/10/20 - FechaVto Original - Se agrega FechaPago al Select
** AA 05/04/2024 se agregan transacciones a los movimientos
SQL.ADD("select O.Cliente1, O.TipoOp, O.Especie, O.ContraEspecie, O.Cantidad, O.Precio1, O.TotalNetoCli1, O.FechaOp, O.FechaVto, O.FechaPago ")
SQL.ADD(" from  "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".CLIENTES C ")
SQL.ADD(" where O.Especie = E.Codigo ")
SQL.ADD("  and  O.Cliente1 = C.Codigo ")
SQL.ADD("  and  O.Cliente1 <> '"~Dialogo.Vehiculo1~"' ")
IF EqStr(VAR('LICILIBROS'),'SI')
   SQL.ADD("  and  O.TipoOp IN ('TIC','TIV','TIFC','TIFV','IPO','TCOPRI') ")
ELSE
   SQL.ADD("  and  O.TipoOp IN ('TIC','TIV','TIFC','TIFV','IPO') ")
ENDIF
SQL.ADD("  and  ("~DBO~".desciendedecliente(C.Codigo,'DIRECTORES')=1 or "~DBO~".desciendedecliente(C.Codigo,'VINCULADOS')=1  or C.Vinculado='SI') ")
SQL.ADD("  and  NOT E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' ")
SQL.ADD("  and  O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("UNION ALL ")
SQL.ADD("select  Cliente1, TipoTr2 TipoOp, Especie, Especie3 Contraespecie , Cantidad1 Cantidad, ")
SQL.ADD(" 1 precio1, Cantidad1 TotalnetoCli1, T.Fecha1 FechaOp, T.Fecha2 FechaVto, T.Fecha5 FechaPago ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E  ")
SQL.ADD("  where TipoTr2 in ('DTP','RTP','DEP', 'RET') ")
SQL.ADD("    and Especie = E.Codigo ")
SQL.ADD("    and Cliente1 <> '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and E.Tipo <> 'MON' ")
SQL.ADD("    and (NrOperacionRef1 = '' or NrOperacionRef1 is Null) ")
SQL.ADD("    and Cliente1 = C.Codigo ")
SQL.ADD("    and ("~DBO~".desciendedecliente(C.Codigo,'DIRECTORES')=1 or "~DBO~".desciendedecliente(C.Codigo,'VINCULADOS')=1  or C.Vinculado='SI') ")
SQL.ADD("    and T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("UNION ALL ")
SQL.ADD("select  Cliente1, Case when M.Cantidad > 0 then 'DEP' else 'RET' end TipoOp, M.Especie, Especie3 Contraespecie , abs(Cantidad) Cantidad, ")
SQL.ADD(" 1 precio1, abs(Cantidad) TotalnetoCli1, M.FechaMov FechaOp, T.Fecha2 FechaVto, T.Fecha5 FechaPago ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C , "~DBO~".MOVEJECUTADOS M ")
SQL.ADD("where TipoTr2 in ('CANJE') ")
SQL.ADD("    and M.NrOperacion = T.NrTrans ")
SQL.ADD("    and T.Cambio5 = 101 ")
SQL.ADD("    and T.Cliente1 = C.Codigo ") 
SQL.ADD("    and T.Cliente1 <> '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and ("~DBO~".desciendedecliente(C.Codigo,'DIRECTORES')=1 or "~DBO~".desciendedecliente(C.Codigo,'VINCULADOS')=1  or C.Vinculado='SI') ")
SQL.ADD("    and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("ORDER BY Cliente1, Especie, TipoOp ")
**watch(SQL.BATCH())
recorrer SQL
  if Not EqStr(Val(x:1),fbn('Cliente1'))
     ACT(x:1,fbn('Cliente1'))
     ACT(b:fac,fbn('Cliente1')~' '~BuscarCampo('Clientes','RazonSocial','Codigo',fbn('Cliente1')))
     SetFont(b:fac,2)
     AgregarMarco(b:fac..i:fac,0,0)
     ifa
  endif    

* Anterior 23/04/2015
* ACT(a:fac, iif(Incluido(fbn('TipoOp'),'TIC|TIFC'),'Incremento','Disminucion'))
  ACT(c:fac, iif(Incluido(fbn('TipoOp'),'TIC|TIFC|TCOPRI|DEP|DTP'),'Disminucion','Incremento'))

  ACT(m:fac, BuscarCampo('ESPECIES','CodMAEContado','Codigo',fbn('Especie')))
  if Vacio(Val(m:fac)) o EqStr(Val(m:fac),'0')
     ACT(b:fac, fbn('Especie')~' - '~BuscarCampo('Especies','Nombre','Codigo',fbn('Especie'))  )
  else
     ACT(b:fac, Val(m:fac)~' - '~BuscarCampo('Especies','Nombre','Codigo',fbn('Especie')) )
  endif


* Anterior 23/04/2015
*  ACN(c:fac, iif(Incluido(fbn('TipoOp'),'TIC|TIFC'),fbn('Cantidad'),-fbn('Cantidad')))
  ACN(d:fac, iif(Incluido(fbn('TipoOp'),'TIC|TIFC|TCOPRI'),-fbn('Cantidad'),fbn('Cantidad')))

  ACN(e:fac, fbn('Precio1'))
  FormatoCeldas(d:fac..e:fac,Exe('F2'))
