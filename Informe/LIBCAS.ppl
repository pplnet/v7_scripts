SQL.ADD("   and Cliente1 = C.Codigo ")
SQL.ADD("   and Cuenta1 not in (select Codigo from CUENTAS where  Alias1 like '%TER%' and Cliente=T.Vehiculo1 ) ")
SQL.ADD("   and T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
