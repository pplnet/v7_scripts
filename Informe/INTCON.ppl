* INTCON - Mov. Transferidos a Interfase Contable
HojaVisible(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1       : 'Fecha'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;FSys
  Especie1     : 'Especie'     ;;;;;;;;;
  Vehiculo1    : 'Vehiculo'    ;;;;;;[Vacio(Dialogo.Vehiculo1) Y Dialogo.Entero1 = 0] O [NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Vehiculo Invalido';NO;;;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");
  NrOperacion1 : 'NrOperacion' ;1;2;
  Entero1      : 'NrProceso'   ;2;2;
  Lista2       : 'TipoOp'      ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION") 
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

IF NoVacio(Dialogo.Vehiculo1)
    ACT(VH:10, Dialogo.Vehiculo1)
ELSE
    IF NoVacio(UsrVehiculos(UsuarioActivo))
        ACT(VH:10, UsrVehiculos(UsuarioActivo))
    ELSE
        ACT(VH:10, SQLSet(" Select Codigo From "~DBO~".VEHICULOS "))
    ENDIF
ENDIF

ACT(a1, 'Listado de Movimientos Generados para Interfase Contable')
SetFont(A:1, 3)

SetFilaActual(fac+3)
ACT(a:fac, 'Fecha Proceso: '~IdxDate(Dialogo.Fecha1))
if NoVacio(Dialogo.Lista2)
  ACT(D:fac, 'Tipos de Operacion: '~Dialogo.Lista2)
else
  ACT(D:fac, 'Tipos de Operacion: Todas')
endif
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:fac+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
  ACT(a:fac+1, 'Vehiculo: Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:fac+2, 'Especie: '~Dialogo.Especie1)
else
  ACT(a:fac+2, 'Especie: Todas')
endif
IF Dialogo.Entero1 > 0
    ACT(D:fac+1, 'NrEnvio: '~Fstr(Dialogo.Entero1, 1, 0))
ELSE
    ACT(D:fac+1, 'NrEnvio: Todos')
ENDIF

SetFilaActual(fac+4)

ACT(a:fac,'Vehiculo')
ACT(B:fac,'NrEnvio')
ACT(C:fac,'TipoOp')
ACT(D:fac,'Operacion')
ACT(E:fac,'Especie')
ACT(F:fac,'Concepto')
ACT(G:fac,'Origen')
ACT(H:fac,'Instante')
ACT(I:fac,'SubInst.')
ACT(J:fac,'Importe')
ACT(K:fac,'T.Cambio')
ACT(L:fac,'Imp.Pesos')
ACT(M:fac,'Fecha Contable')
ACT(N:fac,'Cta Origen')
ACT(O:fac,'Cta Destino')

AgregarMarco(a:fac..o:fac,1,0,Exe('COLOR'))
Setfont(a2..o:fac, 1)
AlinearCeldas(A:fac..o:fac, 'C')

SQL.ADD(" Select * from "~DBO~".MOVIMIENTOS ")
SQL.ADD(" Where FechaProceso = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" Where (((Movimiento_Fecha = '"~IdxDate(Dialogo.Fecha1)~"' OR (FechaAnulada = '"~IdxDate(Dialogo.Fecha1)~"' AND Estado = 'ContraAsiento')) ")
*SQL.ADD("        AND Tipo_Operacion_Codigo Not Like 'FC%') ")
*SQL.ADD("        OR (Movimiento_Fecha = '"~IdxDate(Habiles(Dialogo.Fecha1,-1,'ARG',SI))~"' ")
*SQL.ADD("        AND Tipo_Operacion_Codigo Like 'FC%')) ")
IF Dialogo.Entero1 > 0
    SQL.ADD(" AND NrEnvio = '"~LPad(Fstr(Dialogo.Entero1, 0, 0), 3)~"' ")
    SQL.ADD(" AND Compania_Codigo_PC3 = '"~Dialogo.Vehiculo1~"' ")
ELSE
    SQL.ADD(" AND Compania_Codigo_PC3 IN ("~Pipe2Comillas(Val(VH:10))~") ")
ENDIF
If Vacio(Dialogo.NrOperacion1)
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD("and Compania_Codigo_PC3='"~Dialogo.Vehiculo1~"' ")
   Endif
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("and Tipo_Operacion_Codigo In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD(" AND NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and Moneda_Codigo='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD("order by Compania_Codigo_PC3, NrEnvio, NrOperacion , Moneda_Codigo")

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
Recorrer SQL

    If Not EqStr(val(z1),FBN['Compania_Codigo_PC3'])
       If NoVacio(Val(z1))
          act(a:fac,'SubTotal')
          acn(L:fac,val(z2))
          AgregarMarco(a:fac..o:fac,1)
          SetFont(a:fac..o:fac, 1)
          scn(z3,val(z2))
          ifa
       EndIf
       act(z1,FBN['Compania_Codigo_PC3'])
       acn(z2,0)
    EndIf

    ACT(a:fac,FBN['Compania_Codigo_PC3'])
    ACN(B:fac, fbn('NrEnvio'))
    ACT(C:fac,FBN['Tipo_Operacion_Codigo'])
    ACT(D:fac,FBN['NrOperacion'])
    IF Eqstr(fbn('Tipo_Operacion_Codigo'), 'CUPON')
        ACLT(D:fac, fbn('NrOperacion'))
    ELSE
        ACLO(D:fac,FBN['NrOperacion'])
    ENDIF
    ACT(E:fac,FBN['Moneda_Codigo'])
    ACT(F:fac, Copy(fbn('Concepto'), 1, 33)~'  ('~FBN('Estado1')~') ')
    ACT(G:fac, fbn('Origen'))
    ACT(H:fac, fbn('Instante'))
    ACT(I:fac, fbn('SubInstante'))
    ACN(J:fac,FBN['Movimiento_Monto'])
    IF fbn('Tipo_de_Cambio') = 0
        ACN(K:fac, 1)
    ELSE
        ACN(K:fac,FBN['Tipo_de_Cambio'])
    ENDIF
    ACN(L:fac,VAL(J:fac)*VAL(K:fac))
    ACD(M:fac, fbn('FechaContable'))
    ACT(N:fac, fbn('CuentaOrigen'))
    ACT(O:fac, fbn('CuentaDestino'))

    scn(z2,val(L:fac))

    SetFont(a:fac..o:fac, 2)
Proximo
FormatoCeldas(K:Val(FI:1)..K:fac, Exe('F8'))
If NoVacio(Val(z1))
   Ifa 
   act(a:fac,'SubTotal')
   acn(L:fac,val(z2))
   SetFont(a:fac..o:fac, 1)
   AgregarMarco(a:fac..o:fac,1)
   scn(z3,val(z2))
EndIf

Ifa
Ifa
act(a:fac,'TOTAL')
AgregarMarco(a:fac..o:fac,1,0,Exe('COLOR'))
acn(L:fac,val(z3))
SetFont(a:fac..o:fac, 1)

act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)

FormatoCeldas(J:1..J:fac, Exe('F2'))
FormatoCeldas(L:1..L:fac, Exe('F2'))
FormatoCeldas(B:1..B:fac, Exe('F0'))
LimitesVision(o:fac+1)
ACO(2, 4)
ACO(4, 6)
ACO(5, 5)
ACO(6, 30)
ACO(7, 5)
ACO(8, 5)
ACO(9, 5)
ACO(10, 8)
ACO(11, 5)
ACO(12, 8)
ACO(13, 9)
ACO(14, 9)
ACO(15, 9)

SetPrintFit(3, 75)