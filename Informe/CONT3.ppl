MostrarCuadroDeMensajes
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'Fecha'       ;;;;  ;  ;Dialogo.Fecha1>0;'Fecha Invalida';NO;fsys
  ListaTabla1: 'Operaciones' ;;;;NO;NO;;;;;;;;;;'NrOperacion'; 'NrOperacion;Cliente1;FechaOp;Especie;FechaVto'; 'OPERACIONES'
  TipoOp1    : 'TipoOp'      ;;;;NO;NO;;
  Lista1     : 'Vehiculos'   ;;;;NO;NO;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
FinDialogo
If Not Ok
   Cancelar
Endif

message('--- Asientos de Devengados Diarios MM ---')

ACT(US:1, Descendientes('ESPECIES', 'U$S'))

IF NoVacio(Dialogo.ListaTabla1)
    ***---On-Line
    SQL.ADD(" Select O.NrOperacion, M.Codigo CodAsi, O.Vehiculo1, O.TipoOp, O.Especie, V.Valor1, V.Valor2 ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO M, "~DBO~".VEHICULOS V ")
    SQL.ADD(" Where V.Codigo = O.Vehiculo1 ")
    SQL.ADD(" AND O.TipoOp = M.TipoOp ")
    SQL.ADD(" AND O.NrOperacion = '"~Dialogo.ListaTabla1~"' ")
    SQL.ADD(" AND M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEV'))~") ")
    Recorrer SQL
        Recorrer&k Dialogo.Fecha1, Fsys-1
            SQL.ADD(" Select Sum(Monto) Monto, Especie From "~DBO~".MOVDEVENGADOS ")
            SQL.ADD(" Where NrOperacion = '"~Dialogo.ListaTabla1~"' ")
            SQL.ADD(" AND Fecha = '"~IdxDate(&k)~"' ")
            SQL.ADD(" Group By Especie ")
            Recorrer SQL
                ACD(FV:1, &k)
                ACN(DV:1, Abs(fbn('Monto')))
                ACN(DV:2, Val(DV:1) * CotizacionC(fbn('Especie'),,,,Val(FV:1),1,SI,'USD'))
            Proximo
            IF &k = Val(FV:1)
                SQL.GenerarAsientoOp(fbn('CodAsi'), Dialogo.ListaTabla1,'','',810,Val(FV:1),fbn('Vehiculo1'),,,,,,Dialogo.TipoOp1,,,,,,,fsys,Dialogo.Fecha1)
                SQL.EXEC
            ENDIF
        Proximo
    Proximo
ELSE

  ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
  if Val(x1)=1
    ACN(x1, Trunc(Var('DIASCONT'),0))
  endif
  if Val(x1)<1
    ACN(x1, 1)
  endif
  ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))

  * Fecha Proceso
  ACD(v:1, Dialogo.Fecha1)
  * Ultimo Dia Habil mes anterior
  ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
  * Primer Dia Mes Anterior
  ACD(v:3, PriDeMes(Val(v:2),SI))
  * Primer Dia del Mes
  ACD(v:4, PriDeMes(Val(v:1),SI))
  * Lista Vehiculos
  ACT(y:1, Dialogo.Lista1)

  *************************
  *** Vencimientos del DIA
  *************************
IF NO
  SetFilaActual(0)
  SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.TipoOp, O.Especie, MD.Fecha, MD.Monto, MD.Especie EspecieMD ")
  SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS MD ")
  SQL.ADD(" Where O.FechaVto    =  "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("   and O.TipoOp      like 'MM%' ")
  SQL.ADD("   and O.NrOperacion =  MD.NrOperacion ")
  SQL.ADD("   and MD.Fecha      >= "~IdxDate2(Val(v:4))~" ")
  SQL.ADD("   and O.Vehiculo1   IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
  if NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" and O.Vehiculo1 IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  endif
  SQL.ADD(" order by O.TipoOp, O.NrOperacion ")
  Recorrer SQL
    ACT(a:FAC, fbn('TipoOp'))
    ACT(b:FAC, fbn('NrOperacion'))
    ACD(c:FAC, fbn('FechaOp'))
    ACD(d:FAC, fbn('FechaVto'))
    ACT(e:FAC, fbn('Especie'))
    ACD(f:FAC, fbn('Fecha'))
    ACN(g:FAC, fbn('Monto'))
    ACT(h:FAC, fbn('EspecieMD'))
  proximo
ENDIF

  SetFilaActual(0)
  SQL.ADD(" Select O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo CodAsi, Sum(MD.Monto) Devengado")
  SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS MD, "~DBO~".VEHICULOS V, "~DBO~".MODELOSASIENTO M ")
  SQL.ADD(" Where O.FechaVto    =  '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and O.TipoOp      like 'MM%' ")
  SQL.ADD("   and O.NrOperacion =  MD.NrOperacion ")
  SQL.ADD("   and MD.Fecha      >= "~IdxDate2(Val(v:4))~" ")
  SQL.ADD("   and O.Vehiculo1   IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
  if NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" and O.Vehiculo1 IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  endif
  SQL.ADD("   and O.Vehiculo1   =  V.Codigo ")
  SQL.ADD("   and M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEV'))~") ")
  SQL.ADD("   and M.TipoOp      = O.TipoOp ")
  SQL.ADD(" group by O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo ")
  Recorrer SQL
    ACT(aa:FAC, fbn('TipoOp'))
    ACT(ab:FAC, fbn('Vehiculo1'))
    ACN(ac:FAC, fbn('Valor1'))
    ACN(ad:FAC, fbn('Valor2'))
    ACT(ae:FAC, fbn('Especie'))
    ACN(af:FAC, fbn('Devengado'))
    ACT(ag:FAC, fbn('CodAsi'))
    SQL.GenerarAsientoOp(fbn('CodAsi'), ,'','',810,Dialogo.Fecha1,fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
    SQL.EXEC    
  proximo


  *************************
  *** Devengados Fin de Mes
  *************************
  if Dialogo.Fecha1=Val(x2)

IF NO
    SetFilaActual(0)
    SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.TipoOp, O.Especie, MD.Fecha, MD.Monto, MD.Especie EspecieMD ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS MD ")
    SQL.ADD(" Where O.FechaVto    >  "~IdxDate2(Val(v:2))~" ")
    SQL.ADD("   and O.FechaOp     <=  "~IdxDate2(Val(v:2))~" ")
    SQL.ADD("   and O.TipoOp      like 'MM%' ")
    SQL.ADD("   and O.NrOperacion =  MD.NrOperacion ")
    SQL.ADD("   and MD.Fecha      >= "~IdxDate2(Val(v:3))~" ")
    SQL.ADD("   and MD.Fecha      < "~IdxDate2(Val(v:4))~" ")
    SQL.ADD("   and O.Vehiculo1   IN ("~Pipe2Comillas(Var('VLIQUIDA') ~Var('VLIQUIDA2'))~") ")
    if NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
    endif
    SQL.ADD(" order by O.TipoOp, O.NrOperacion ")
    Recorrer SQL
      ACT(j:FAC, fbn('TipoOp'))
      ACT(k:FAC, fbn('NrOperacion'))
      ACD(l:FAC, fbn('FechaOp'))
      ACD(m:FAC, fbn('FechaVto'))
      ACT(n:FAC, fbn('Especie'))
      ACD(o:FAC, fbn('Fecha'))
      ACN(p:FAC, fbn('Monto'))
      ACT(q:FAC, fbn('EspecieMD'))
    proximo
ENDIF

    SetFilaActual(0)
    SQL.ADD(" Select O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo CodAsi, Sum(MD.Monto) Devengado")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS MD, "~DBO~".VEHICULOS V, "~DBO~".MODELOSASIENTO M ")
    SQL.ADD(" Where O.FechaVto    >  "~IdxDate2(Val(v:2))~" ")
    SQL.ADD("   and O.FechaOp     <=  "~IdxDate2(Val(v:2))~" ")
    SQL.ADD("   and O.TipoOp      like 'MM%' ")
    SQL.ADD("   and O.NrOperacion =  MD.NrOperacion ")
    SQL.ADD("   and MD.Fecha      >= "~IdxDate2(Val(v:3))~" ")
    SQL.ADD("   and MD.Fecha      < "~IdxDate2(Val(v:4))~" ")
    SQL.ADD("   and O.Vehiculo1   IN ("~Pipe2Comillas(Var('VLIQUIDA')~Var('VLIQUIDA2'))~") ")
    if NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
    endif
    SQL.ADD("   and O.Vehiculo1   =  V.Codigo ")
    SQL.ADD("   and M.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASIDEV'))~") ")
    SQL.ADD("   and M.TipoOp      = O.TipoOp ")
    SQL.ADD(" group by O.TipoOp, O.Vehiculo1, MD.Especie, V.Valor1, V.Valor2, M.Codigo ")
    Recorrer SQL
      ACT(ba:FAC, fbn('TipoOp'))
      ACT(bb:FAC, fbn('Vehiculo1'))
      ACN(bc:FAC, fbn('Valor1'))
      ACN(bd:FAC, fbn('Valor2'))
      ACT(be:FAC, fbn('Especie'))
      ACN(bf:FAC, fbn('Devengado'))
      ACT(bg:FAC, fbn('CodAsi'))
      SQL.GenerarAsientoOp(fbn('CodAsi'), ,'','',810,Val(v:2),fbn('Vehiculo1'),,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC    
    proximo
  endif
ENDIF
