*- Tomo de Cotizaciones desde el archivo BLOOMBERGS.XLS
*- Bid es compra, Ask es venta, Last el de ayer y close es el ultimo
ACT(a1, 'Cotizaciones desde Bloombergs')
ACT(a3, 'Especie')
ACT(b3, 'Precio1')
ACT(c3, 'PrecioContable')
ACT(d3, 'Moneda')
ACT(e3, 'Plazo Liq')
ACT(F3, 'Mercado')
ACT(G3, 'Fecha')

AlinearCeldas(a3..i3, 'D')

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

AgregarMarco(a3..g3,2,0,Exe('COLOR'))

ACT(yy:2, HORA(AHORA))
ACT(zz:2, Copy(Val(yy:2),1,2)~Copy(Val(yy:2),4,2)~Copy(Val(yy:2),7,2))
ACD(yy:3, Fsys)
ACT(zz:3, Copy(Val(yy:3),1,2)~Copy(Val(yy:3),4,2)~Copy(Val(yy:3),9,2))

*Limite de precios tomados
ACN(x1, VAR('ACTCOTFILA')+1)

**Valida si existe el directorio para crear el txt
If ExisteDirectorio(VAR('PATHLOG'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATHLOG'),Longitud(VAR('PATHLOG')),1),'\')
      ACT(pl:1, VAR('PATHLOG')~'PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   Else
      ACT(pl:1, VAR('PATHLOG')~'\PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   EndIf
   **
Else
    Message('El directorio '~VAR('PATHLOG')~' no existe')
EndIf

**Valida si existe el directorio y el archivo xls para importarlo
If ExisteDirectorio(VAR('PATHBLOPRE'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATHBLOPRE'),Longitud(VAR('PATHBLOPRE')),1),'\')
   ACT(vb:1, VAR('PATHBLOPRE'))
   Else
   ACT(vb:1, VAR('PATHBLOPRE')~'\')
   EndIf
   **
   If Not ExisteArchivo(Val(vb:1)~VAR('BLOOMBER'))
        act(z7,'El Archivo '~VAR('BLOOMBER')~' no existe en el directorio: '~Val(vb:1))
        Cancelar('El Archivo '~VAR('BLOOMBER')~' no existe en el directorio: '~Val(vb:1))
   Else
        ImportarXLS(a:1..J:Val(x1),aa:1..ag:Val(x1),Val(vb:1)~VAR('BLOOMBER'))
        If Not Ok 
            AbrirAscii(Val(pl:1),0)
            EscribirASCII(FECHA(HOY)~' '~HORA(AHORA)~' ACTCOT')
            EscribirASCII('No se pudo abrir la planilla '~Val(vb:1)~VAR('BLOOMBER')~' o se ha importado con errores')
            act(z7,'No se pudo abrir la planilla '~Val(vb:1)~VAR('BLOOMBER')~' o se ha importado con errores')
            CerrarASCII
            MessageBox('No se pudo abrir el archivo '~Val(vb:1)~VAR('BLOOMBER')~' Err:' ~ Reemplazar(GetError(),"'"," "))
            *MessageBox('TEST')
       EndIf
   EndIf
Else
    act(z7,'El directorio '~Val(vb:1)~' no existe')
    Cancelar('El directorio '~Val(vb:1)~' no existe')
EndIf

*- Variables
* z2 : Primera fila con contenido
* z3 : Ultima fila con contenido
* z4 : Primera Celda asignada
* z5 : Ultima Celda asignada
* z6 : Celda corriente
* z7 : Error

ACN(z2,2)
ACN(z3,Val(x1))

SetFilaActual(4)
ACN(z4,fac)
ACN(z5,fac)

*- Recorrer valores
Recorrer&i Val(z2),Val(z3)
   If Vacio(VAL(aa:&i))
      Break
   EndIf

   Message('Especie '~VAL(aa:&i))
   ACT(a:Val(z5), Val(aA:&i))
   
*-- Buscar especie
*   If SQL("SELECT Count(*) FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(aa:&i)~"' ")=1
*      * Calcular el precio
*      If [DesciendeDeEspecie(Val(a:Val(z5)),'PUBLIC') o DesciendeDeEspecie(Val(a:Val(z5)),'CORP B') o Incluido(Val(a:Val(z5)),VAR('BGOBNAC'))]
*         ACN(de1, 1/100) 
*      Endif
*   Endif
   ACN(de1, 1)
   ACN(h:Val(z5), 1)
   ****************Plazo valido
   If novacio(Val(ae:&i))
      If (Val(ae:&i)) >= 0
         ACN(e:Val(z5), Val(ae:&i))
      else
         ACN(e:Val(z5), Val(ae:&i))
      EndIf
   else
      ACT(e:Val(z5), Val(ae:&i))
   endif
   ****************Mercado Valido 
   If novacio(Val(af:&i))
      If (QUERY("select count (*) from "~DBO~".MERCADOS where Codigo =upper('"~Val(af:&i)~"')")) > 0
         ACT(f:Val(z5), Mayusculas2(Val(af:&i)))
      else
         ACT(f:Val(z5), 'NO VALIDO')
      EndIf
   else
      ACT(f:Val(z5), Val(af:&i))
   endif
   
   ****************Cotizacion
   ACN(b:Val(z5), Val(ab:&i)*val(de1))
   ****************PrecioContable
   ACN(c:Val(z5), Val(ac:&i)*val(de1))
   
   ****************Moneda
   If (QUERY("select count (*) from "~DBO~".especies where Codigo =upper('"~Val(ad:&i)~"')")) > 0
      ACT(d:Val(z5), Mayusculas2(Val(ad:&i)))
   EndIf
   
   ***************Fecha
   If NoVacio(Val(ag:&i)) Y Val(ag:&i)>0
      ACD(G:Val(z5), Val(ag:&i))
   Endif
 
   Message('Cotizacion Precio1 '~Val(b:Val(z5))~' Precio Contable:'~Val(c:Val(z5)) )

   SCN(z5,1)
Proximo

CerrarASCII

SetFont(a1..z3, 1)
SetFont(a4..z:Val(z5), 2)
*LimitesVision(h:Val(z5)+2)

FormatoCeldas(b1..F:Val(z5)+2,Exe('F7'))
