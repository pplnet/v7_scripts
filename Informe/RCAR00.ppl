ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : 'Grupo'                                         ; 1;1;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : 'Vehiculos'                                     ; 2;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Lista2     : 'Tipos Book'                                    ; 3;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
  Lista3     : 'Books'                                         ;-3;2;;;;;;;;;iif(Vacio(Dialogo.Lista2),SQLSET("Select Codigo From "~DBO~".BOOKS"),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "));
  Fecha1     : 'Fecha'                                         ;-2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Especie1   : 'Especie'                                       ;-1;1;;
  Radio2     : 'Consolidado |Si|No'                            ; 0;1;;;;;;;0
  Radio3     : 'A nivel|Familias|Intermedio|Detalle'           ; 1;1;;;;;;;2
  Radio1     : 'Expresado   |Pesos|Dolares'                    ; 2;1;;;;;;;0
  Check1     : 'TIR Resumida'                                  ; 3;1;;;;;;;1
  Check2     : 'Borra Renglones'                               ; 4;1;;;;;;;1
  Radio4     : 'Familia|Todas|Titulos|Fondos|Monedas|Time Dep' ; 5;1;;;;;;;0
FinDialogo
if Not Ok
  Cancelar
endif
**  Lista3     : 'Books'                                         ;;;;Vacio(Dialogo.Lista2);;;;;;iif(Vacio(Dialogo.Lista2),Dialogo.Lista3,'');SQLSET("Select Codigo From "~DBO~".BOOKS");

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

If NoVacio(Dialogo.Lista1)
  ACT(a:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(a:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  else
    ACT(a:1, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' "))
  EndIf
EndIf
If NoVacio(Dialogo.Lista2)
  If NoVacio(Dialogo.Lista3)
    ACT(a:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  else
    ACT(a:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "))
  endif
Else
  If NoVacio(Dialogo.Lista3)
    ACT(a:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  EndIf
EndIf

if Dialogo.Radio2=1
  *- Consolidado NO
  if NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("Select Codigo from "~DBO~".VEHICULOS ")
    SQL.ADD(" where Codigo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~") ")
    SQL.ADD("   and TipoVehiculo = 'DIV' ")
    recorrer SQL
      SCN(x1,1)
      LinkearHoja('RCAR01',Val(x1),Vehiculo2='',Lista1=fbn['Codigo'],Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Especie1=Dialogo.Especie1,Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio1=Dialogo.Radio1,Radio4=Dialogo.Radio4,Check1=Dialogo.Check1,Check2=Dialogo.Check2)
    proximo
  else  
    Recorrer&i 1, Elementos(Val(a:1))
      LinkearHoja('RCAR01',&i,Vehiculo2='',Lista1=ItemLista(Val(a:1),&i),Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Especie1=Dialogo.Especie1,Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio1=Dialogo.Radio1,Radio4=Dialogo.Radio4,Check1=Dialogo.Check1,Check2=Dialogo.Check2)
    proximo
  endif
else
  *- Consolidado SI
  LinkearHoja('RCAR01',1,Vehiculo2=Dialogo.Vehiculo2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Especie1=Dialogo.Especie1,Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio1=Dialogo.Radio1,Radio4=Dialogo.Radio4,Check1=Dialogo.Check1,Check2=Dialogo.Check2)
endif
HojaVisible(NO)
