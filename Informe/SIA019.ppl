HojaVisible(SI)

ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo


if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


ACT(a1, 'Transacciones Pendientes de Conciliar')
SetFont(A:1, 3)
SetFilaActual(fac+3)


ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)


SetFilaActual(fac+4)

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)

ACT(a:fac,'Fec.Transacc.')
ACT(b:fac,'Cant.Mov.')

AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
Setfont(a2..j:fac, 1)
AlinearCeldas(A:fac..j:fac, 'C')

SQL.ADD(" Select  t.fecha1, count(*) cantidad   ")
SQL.ADD("             from "~DBO~".transacciones2 T, "~DBO~".OPERACIONESBITS B   ")
SQL.ADD(" Where B.NrOperacion = T.NrTrans ")
SQL.ADD("   and t.Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and t.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   and B.NrBit = 18 AND B.Valor = '1'  ")

SQL.ADD(" group by T.Fecha1  ")
SQL.ADD(" order by T.Fecha1 ")

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
Recorrer SQL

    ACT(a:fac,FBN['Fecha1'])
    ACT(b:fac,FBN['Cantidad'])

    SetFont(a:fac..j:fac, 2)
Proximo
FormatoCeldas(K:Val(FI:1)..K:fac, Exe('F8'))

Ifa
Ifa
AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
SetFont(a:fac..j:fac, 1)

***************************************************


act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)

FormatoCeldas(J:1..J:fac, Exe('F2'))
FormatoCeldas(L:1..L:fac, Exe('F2'))
FormatoCeldas(B:1..B:fac, Exe('F0'))
LimitesVision(j:fac+1)
ACO(2, 6)
