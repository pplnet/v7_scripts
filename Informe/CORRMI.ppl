* 12/03/02
* CORRMI-ADMINI - Correlatividad de Minutas

ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;2;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "));;;;;
  Fecha1     : "F.Op.Desde" ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;PriDeMes(Fsys,SI);
  Fecha2     : "F.Op.Hasta" ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
ACN(fi1,0)

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)

ACT(m:2,'Fecha : '~Var('FECHASYS'))
SetFont(m:2..m:2,1)

ACT(a:FAC, "Correlatividad de Minutas")
SetFont(a:fac..a:fac,3)

SetFilaActual(4)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1)
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

ACT(a:FAC+2, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(d:FAC+2, 'Ope.Hasta : '~Dialogo.Fecha2)
SetFont(a:fac+1..d:fac+2,2)
SetFilaActual(8)

ACT(A:FAC, "Nro.Oper.")
ACT(B:FAC, "Vehiculo")
ACT(C:FAC, "F.Oper.")
ACT(D:FAC, "F.Vto.")
ACT(E:FAC, "Cliente")
ACT(F:FAC, "Especie")
ACT(G:FAC, "CEspecie")
ACT(H:FAC, "Tipo Op.")
ACT(I:FAC, "Cantidad")
ACT(J:FAC, "Precio")
ACT(K:FAC, "Tasa N.A.")
ACT(L:FAC, "Plazo")
ACT(M:FAC, "Total")
ACT(N:FAC, "Op.Ref.")
ACT(O:FAC, "Operador")
ACT(P:fac, 'Autorizantes')

AlinearCeldas(A:FAC..H:FAC,'I')
AlinearCeldas(I:FAC..M:FAC,'C')
AlinearCeldas(N:FAC..P:FAC,'I')
SetFont(A:fac..P:FAC,2)
AgregarMarco(A:FAC..P:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

if NoVacio(Val(z1)) 
    ACT(z1, Val(z1)~" and ")
endif
ACT(z1, Val(z1)~" Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")

if NoVacio(Val(z1))
  ACT(z1, Val(z1)~" and ")
endif

ACT(z1, Val(z1)~"FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")

SQL.ADD("SELECT * from "~DBO~".OPERACIONES where "~Val(z1)~" Order By NrOperacion")

Recorrer SQL
  ACT(a:fac, FBN['NrOperacion'])
  ACLO(a:fac, FBN['NrOperacion'])
  ACT(b:fac, FBN['Vehiculo1'])
  ACT(c:fac, FBN['FechaOp'])
  ACT(d:fac, FBN['FechaVto'])
  ACT(e:fac, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
  ACT(f:fac, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  ACT(g:FAC, FBN['ContraEspecie'])

  ACT(h:fac, FBN['TipoOp'])
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Rojo')=1
    ACT(h:FAC, Val(h:FAC)~' (Rojo)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(h:FAC, Val(h:FAC)~' (x Pase)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(h:FAC, Val(h:FAC)~' (x Arb.)')
  endif

  ACN(i:fac, FBN['Cantidad'])
  IF Not Incluido(FBN['TipoOp'],'COM|COT|CTM|CTT|POM|POT|PTM|PTT|PFM|PFT')
     ACN(j:fac, FBN['Precio1'])
  ENDIF
  IF Incluido(FBN['TipoOp'], 'COM|COT|CTM|CTT|POM|POT|PTM|PTT|PFM|PFT')
     ACN(k:fac, FBN['Precio1'])
  ENDIF
  IF Incluido(FBN['TipoOp'],'PAM|PAT|PPM|PPT|REPO')
     ACN(k:fac, FBN['Precio3'])
  ENDIF

  ACN(l:fac, FBN['Plazo'])
  ACT(N:fac, FBN['OperacionRef'])
  If CeldaVacia(N:FAC)
      ACT(N:fac, '------------')
  EndIf
  ACT(O:fac, FBN['Operador'])
  ACT(P:fac, fbn('Observac5'))
  AlinearCeldas(a:FAC..h:FAC,'I')
  AlinearCeldas(i:FAC..m:FAC,'D')
  AlinearCeldas(n:FAC..P:FAC,'I')
  FormatoCeldas(k:fac..k:fac,"0")
  FormatoCeldas(i:fac..i:fac,Exe('F2'))
  FormatoCeldas(l:fac..l:fac,Exe('F0'))
  SetFont(a:fac..P:FAC,1)
SCN(fi1,1)
proximo
*-- Veo si hay algo para listar
if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else

    SetFont(a:Val(w1)+11..q:FAC,1)

    ACO(1,6)
    ACO(2,6)
    ACO(3,6)
    ACO(4,6)
    ACO(5,17)
    ACO(6,10)
    ACO(7,5)
    ACO(8,6)
    ACO(9,9)
    ACO(10,4)
    ACO(11,5)
    ACO(12,4)
    ACO(13,6)
    ACO(14,6)
    ACO(15,6)
    ACO(16, 20)

    Impresion(1,2)
    SetFilaActual(FAC+2)
    ACT(a:FAC, 'FIN DEL LISTADO')
    SetFont(a:FAC,2)
    SetFont(g:3,2)
    LimitesVision(P:FAC)
    RangoTitulo(a:1..P:FAC, Val(w1)+4)
    SetPrintFit(3, 85)
endif
