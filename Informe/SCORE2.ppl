*HojaVisible(SI)
CrearDialogo
  Fecha1    : 'F.Desde';2;;;;;;;;PriDeMes(FSys)
  Fecha2    : 'F.Hasta';3;;;;;;;;FinDeMes(FSys)
  Radio2    : 'Vehiculos:|Todos|Algunos';2;2;;;;;;;0;
  Radio6    : 'Tipos Esp.:|Todas|Publicas|Privadas|Oblig.Neg.';4;1;;;;;;;0;
  Radio7    : 'Especies:|Todas|Algunas';5;1;;;;;;;0;
  Lista1    : "Vehiculo"     ;7;1;;Dialogo.Radio2=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Lista2    : 'Especies'     ;1;2;;Dialogo.Radio7=1 ;;;;;;;iif(Dialogo.Radio6=0, SQLSet("Select Codigo from "~DBO~".ESPECIES where Tipo in ('PUB','PRI','ONE') "), iif(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".ESPECIES where Tipo='PUB' "),iif(Dialogo.Radio6=2,SQLSet("Select Codigo from "~DBO~".ESPECIES where Tipo='PRI' "),SQLSet("Select Codigo from "~DBO~".ESPECIES where Tipo='ONE' ") )));
FinDialogo

if not Ok
  Cancelar
endif

SetListaClaves(2)

*-- Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else 
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS where (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

(.'TITSCORE2'.)

SQL.ADD("Select S.Cliente, S.Especie, S.Saldo, E.Tipo, E.InteresesC, E.VTeorico, E.Codigo from "~DBO~".ESPECIES E, "~DBO~".SALDOSDIA S  where ")
SQL.ADD("S.Especie = E.Codigo")
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2) 
   SQL.ADD("and E.Codigo In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif
else 
   SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
endif
If NoVacio(val(zz6))
   SQL.ADD("and S.Cliente in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD("and S.NrSaldo =10")
SQL.ADD("and S.Saldo <> 0")
SQL.ADD("and S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D where")
SQL.ADD("D.Cliente = S.Cliente")
SQL.ADD("and D.Especie = S.Especie")
SQL.ADD("and D.NrSaldo = S.NrSaldo")
SQL.ADD("and D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by S.Cliente, S.Especie")

recorrer SQL
  dfa
  ACN(ad:fac+2, fbn('Saldo'))
  ACN(af:fac+2, CotizacionC(fbn('Especie'),,,,Habiles(Dialogo.Fecha1,-1,'ARG',SI),1,SI,'USD'))
  ACN(bf:fac+2, CotizacionC(fbn('Especie'),,,,Habiles(Dialogo.Fecha2,-1,'ARG',SI),1,SI,'USD'))
  if EqStr(fbn('InteresesC'),'CLE')
    * ensuciar el precio para el inicio 
    ** calcular la tasa (%)
    * Variables                    
    * x95 - Dif. de dias           
    * x96 - Especie                  
    * x97 - Fecha de Liquidacion   
    * x98 - Tasa Base              
    * x99 - Tasa                   
    ACT(x96,fbn('Especie'))
    ACD(x97,Dialogo.Fecha1)
    ACN(x98,0)
    ACN(x99,0)
    (.'CALCINT'.)
    *TotalIntereses inicio
    ACN(y98,fbn('VTeorico')*Val(ad:fac+2)*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Especie')),FSYS)/100*Val(x95))
    * Total Neto inicio
    ACN(y99,(fbn('VTeorico')*Val(ad:fac+2)*Val(af:fac+2))+Val(y98))
    * Precio Sucio inicio
    ACN(af:fac+2, Val(y99)/Val(ad:fac+2))

    * ensuciar el precio para el fin
    ** calcular la tasa (%)
    * Variables                    
    * x95 - Dif. de dias           
    * x96 - Especie                  
    * x97 - Fecha de Liquidacion   
    * x98 - Tasa Base              
    * x99 - Tasa                   
    ACT(x96,fbn('Especie'))
    ACD(x97,Dialogo.Fecha2)
    ACN(x98,0)
    ACN(x99,0)
    (.'CALCINT'.)
    *TotalIntereses fin
    ACN(y98,fbn('VTeorico')*Val(ad:fac+2)*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Especie')),FSYS)/100*Val(x95))
    * Total Neto fin
    ACN(y99,(fbn('VTeorico')*Val(ad:fac+2)*Val(bf:fac+2))+Val(y98))
    * Precio Sucio fin
    ACN(bf:fac+2, Val(y99)/Val(ad:fac+2))
  endif
  if Elementos(Dialogo.Lista2)=1
     *- Saldo Inicial
    SCN(d:fac+2, Val(ad:fac+2))
    SCN(f:fac+2, Val(af:fac+2))
  endif
  SCN(g:fac+2, -Val(ad:fac+2)*Val(af:fac+2))
  SCN(bg:fac+2,-Val(ad:fac+2)*Val(bf:fac+2))
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.TotalNetoCli1, O.Precio1, O.FechaVto, O.Cotizacion1, ")
SQL.ADD("O.TipoOp, O.FechaPago, O.ContraEspecie, O.MB4, O.MB3, O.TipoCambio3, O.Cartera, O.FechaOp, ")
SQL.ADD("O.ContraEspecie2, O.TotalBrutoCli1, E.InteresesC, E.VTeorico,O.NrOperacion,O.TipoCambio, E.Tipo ")
SQL.ADD(" from "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O  where ")
SQL.ADD("( ")
SQL.ADD("( ")
SQL.ADD(" TipoOp in ('SEI','SED') and (PaseCB='0' or PaseCB is NULL)")
SQL.ADD("and FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto < '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" ) ")
SQL.ADD("or (TipoOp in ('SECS','SEVS','SECSV','SEVSV','SECT','SEVT','SECTV','SEVTV','DIVIDE','CUPLIQ') and FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaPago < '"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("or (TipoOp in ('CUPON') and MB4='1' and TipoCambio3=10 and FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and (OperacionRef Is Null or (OperacionRef Is Not Null and OperacionRef=")
SQL.ADD(" (Select O1.FechaPago From "~DBO~".OPERACIONES O1 where O1.NrOperacion=O.NrOperacion and O1.FechaPago Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD(" ))) ")
SQL.ADD(" ) ")
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
   SQL.ADD("and (Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") or Especie In ("~Pipe2Comillas(Val(y93))~") ) ")
endif
SQL.ADD("and E.Codigo = O.Especie ")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio6 > 0 
   If Dialogo.Radio6 = 1 
      SQL.ADD("and E.Tipo= 'PUB' ")
   else
      if Dialogo.Radio6 = 2
         SQL.ADD("and E.Tipo= 'PRI' ")
      else
         SQL.ADD("and E.Tipo= 'ONE' ")
      endif
   endif 
else 
   SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD("order by Vehiculo1, Especie")

Recorrer SQL
  Message(fbn('TipoOp')~' '~fbn('NrOperacion')~' .... ')
  dfa
  if incluido(fbn('TipoOp'), 'SECS|SEVS|SECSV|SEVSV|SED|SEI|DIVIDE|CUPLIQ')
     ACN(z3, 0)
  else
     ACN(z3, 1)
  endif
  if incluido(fbn('TipoOp'), 'SEVT|SEVS|SEVTV|SEVSV|SED')
     ACN(z4, -1)
  else
     ACN(z4, 1)
  endif
  if incluido(fbn('TipoOp'), 'DIVIDE|CUPLIQ')
     if EqStr(fbn('MB3'),'1')
        ACN(z4, -1)
     else
        ACN(z4, 1)
     endif
  endif
  if incluido(fbn('TipoOp'), 'SED|SEI')
     ACD(y94,fbn('FechaVto') )
  else
     ACD(y94,fbn('FechaPago') )
  endif

  if Not incluido(fbn('TipoOp'), 'DIVIDE|CUPLIQ')
    ACT(y95,BuscarCampo('ESPECIES','Tipo','Codigo',fbn('Especie')))

    if EqStr(Val(y95),'PRI') o [Not EqStr(Val(y95),'PRI') y Not EqStr(fbn('Cartera'),'0')]

      recorrer&i fac+3, fac+3+Val(z1)
        if Val(a:&i)=Val(y94)
          ACN(z2, &i)
          break
        endif
      proximo
      if Val(z3)=0
        if Elementos(Dialogo.Lista2)=1
          SCN(d:Val(z2), fbn('Cantidad')*Val(z4))
          SCN(e:Val(z2), fbn('Cantidad')*Val(z4)*fbn('Precio1')*(fbn('Cotizacion1')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1)) )
        endif
        SCN(g:Val(z2), fbn('TotalNetoCli1')*(fbn('Cotizacion1')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1))*-Val(z4))
      else
        if fbn('FechaOp')<Dialogo.Fecha1

          * Vencimiento de Futuros concertados antes del inicio del periodo
          if incluido(fbn('TipoOp'), 'SEVT|SEVTV')
            * ventas futuros valuadas a precio inicio
            ACN(z7, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'))
          else
            * compras futuros valuadas a precio fin
            ACN(z7, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD'))
          endif
          ACN(z8, CotizacionC(fbn('Especie'),,,,Val(a:Val(z2)),1,SI,'USD'))
          if Elementos(Dialogo.Lista2)=1
            SCN(d:Val(z2), fbn('Cantidad')*Val(z4))
            SCN(e:Val(z2), fbn('Cantidad')*Val(z7)* Val(z4))
            SCN(n:Val(z2), fbn('Cantidad')*-Val(z4))
            SCN(o:Val(z2), fbn('Cantidad')*-Val(z4)*Val(z8))
          endif
          SCN(g:Val(z2),  fbn('Cantidad')*Val(z7)*-Val(z4))
          SCN(q:Val(z2), fbn('Cantidad')*Val(z8)*Val(z4))
        else
          * Vencimiento de Futuros concertados dentro del  periodo
          if Elementos(Dialogo.Lista2)=1
            SCN(d:Val(z2), fbn('Cantidad')*Val(z4))
            SCN(e:Val(z2), fbn('Cantidad')*fbn('Precio1')*(fbn('Cotizacion1')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1))* Val(z4))
          endif
          SCN(g:Val(z2),  fbn('Cantidad')*fbn('Precio1')*(fbn('Cotizacion1')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1)) *-Val(z4))
        endif  
      endif 
      * ensuciar el precio para el fin
      ACN(bf:Val(z2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD'))
      ACN(ad:Val(z2), fbn('Cantidad')*-Val(z4))
      if EqStr(fbn('InteresesC'),'CLE')
        ** calcular la tasa (%)
        * Variables                    
        * x95 - Dif. de dias           
        * x96 - Especie                  
        * x97 - Fecha de Liquidacion   
        * x98 - Tasa Base              
        * x99 - Tasa                   
        ACT(x96,fbn('Especie'))
        ACD(x97,Dialogo.Fecha2)
        ACN(x98,0)
        ACN(x99,0)
        (.'CALCINT'.)
        *TotalIntereses fin
        ACN(y98,fbn('VTeorico')*Val(ad:Val(z2))*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Especie')),FSYS)/100*Val(x95))
        * Total Neto fin
        ACN(y99,(fbn('VTeorico')*Val(ad:Val(z2))*Val(bf:Val(z2)))+Val(y98))
        * Precio Sucio fin
        ACN(bf:Val(z2), Val(y99)/Val(ad:Val(z2)))
      endif
      SCN(bg:Val(z2), Val(ad:Val(z2))*Val(bf:Val(z2)))
    endif
  else
    * solo dividendos o liq. de cupones por saldo 10 y Spot No Liquidado
    if [EqStr(fbn('TipoOp'),'DIVIDE') y [[EqStr(fbn('MB4'),'3') y fbn('TipoCambio3')=10] o EqStr(fbn('MB4'),'0') ]] o [EqStr(fbn('TipoOp'),'CUPLIQ') y EqStr(fbn('MB4'),'1') y fbn('TipoCambio3')=10]
      recorrer&i fac+3, fac+3+Val(z1)
        if Val(a:&i)=fbn('FechaPago')
          ACN(z2, &i)
          break
        endif
      proximo
      if Elementos(Dialogo.Lista2)=1
        if EqStr(fbn('TipoOp'),'DIVIDE') 
           * Cotizacion de la Especie contra el Dolar para el monto de acciones
           ACN(z7, CotizacionC(fbn('Especie'),,,,Val(a:Val(z2)),1,SI,fbn('ContraEspecie')))
           SCN(d:Val(z2),fbn('TotalBrutoCli1')*Val(z4))
           SCN(e:Val(z2),fbn('TotalBrutoCli1')*Val(z7)*(fbn('Cotizacion1')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1))*Val(z4))
        endif
      endif

      * Cotizacion de la ContraEspecie contra el dolar
      if Not EqStr(fbn('ContraEspecie'),'USD')
        ACN(z7, CotizacionC(fbn('ContraEspecie'),,,,Val(a:Val(z2)),1,SI,'USD'))
      else
        ACN(z7,1)
      endif

      SCN(g:Val(z2), fbn('TotalNetoCli1')*(fbn('TipoCambio')^IIf(EqStr(Modo(FBN['ContraEspecie'],VAR('MONEEXTR')),'DIR'),1,-1))*Val(z4))

      * ensuciar el precio para el fin
      ACN(bf:Val(z2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD'))
      ACN(ad:Val(z2), fbn('TotalBrutoCli1')*-Val(z4))

      if EqStr(fbn('InteresesC'),'CLE')
        ** calcular la tasa (%)
        * Variables                    
        * x95 - Dif. de dias           
        * x96 - Especie                  
        * x97 - Fecha de Liquidacion   
        * x98 - Tasa Base              
        * x99 - Tasa                   
        ACT(x96,fbn('Especie'))
        ACD(x97,Dialogo.Fecha2)
        ACN(x98,0)
        ACN(x99,0)
        (.'CALCINT'.)
        *TotalIntereses fin
        ACN(y98,fbn('VTeorico')*Val(ad:Val(z2))*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Especie')),FSYS)/100*Val(x95))
        * Total Neto fin
        ACN(y99,(fbn('VTeorico')*Val(ad:Val(z2))*Val(bf:Val(z2)))+Val(y98))
        * Precio Sucio fin
        ACN(bf:Val(z2), Val(y99)/Val(ad:Val(z2)))
      endif
      SCN(bg:Val(z2), Val(ad:Val(z2))*Val(bf:Val(z2)))
    endif
  endif
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.MB3, O.MB1, O.TotalAux1, O.Precio1, O.PrecioEj, O.FechaEj, O.FechaVto, O.Cotizacion1, O.TipoOp, O.Precio2, O.CB8, O.FechaPago, O.Precio2, O.Precio4, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where ")
SQL.ADD("TipoOp = 'DSEO'")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp2 < '"~IdxDate(Dialogo.Fecha1)~"'")

recorrer SQL
  dfa
  if fbn('MB1')=1
    ACT(z4, 'P')
    ACN(z5, CotizacionC(fbn('Especie'),'P',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,'USD'))
  else
    ACT(z4, 'C')
    ACN(z5, CotizacionC(fbn('Especie'),'C',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,'USD'))
  endif
  if fbn('MB3')=1
    SCN(l:fac+2, fbn('TotalAux1')*Val(z5)/100)
  else
    SCN(l:fac+2, -fbn('TotalAux1')*Val(z5)/100)
  endif
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.MB3, O.MB1, O.TotalAux1, O.Precio1, O.PrecioEj, O.FechaEj, O.FechaVto, O.Cotizacion1, O.TipoOp, O.Precio2, O.CB8, O.FechaPago, O.Precio2, O.Precio4, O.FechaVto2, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where ")
SQL.ADD("TipoOp = 'DSEO' and (RB10 ='0' or RB10 is Null) and CB8 ='1' ")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
if Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
   SQL.ADD("and E.Tipo= 'PUB' ")
  else
   if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
   else
     SQL.ADD("and E.Tipo= 'ONE' ")
   endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto2 < '"~IdxDate(Dialogo.Fecha2)~"'")

recorrer SQL
  dfa
  recorrer&i fac+3, fac+3+Val(z1)
    if Val(a:&i)=fbn('FechaVto2')
      ACN(z2, &i)
      break
    endif
  proximo
  SCN(l:Val(z2), fbn('Precio4'))
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.MB3, O.MB1, O.TotalAux1, O.Precio1, O.PrecioEj, O.FechaEj, O.FechaVto, O.Cotizacion1, O.TipoOp, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where ")
SQL.ADD("TipoOp = 'DSEO'")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaEj >= '"~IdxDate(Dialogo.Fecha2)~"' and FechaOp2 < '"~IdxDate(Dialogo.Fecha2)~"'")

recorrer SQL
  dfa
  if fbn('MB1')=1
    ACT(z4, 'P')
    ACN(z5, CotizacionC(fbn('Especie'),'P',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha2,1,SI,'USD'))
  else
    ACT(z4, 'C')
    ACN(z5, CotizacionC(fbn('Especie'),'C',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha2,1,SI,'USD'))
  endif
  if fbn('MB3')=1
    ACN(l:fac+3+Val(z1), -fbn('TotalAux1')*Val(z5)/100)
  else
    ACN(l:fac+3+Val(z1), fbn('TotalAux1')*Val(z5)/100)
  endif
proximo

SQL.ADD("Select O.Cantidad, O.MB3, O.MB1, O.TotalAux1, O.Precio1, O.PrecioEj, O.FechaEj, O.FechaVto, O.Cotizacion1, O.TipoOp, O.TotalNetoCli1, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O , "~DBO~".ESPECIES E where ")
SQL.ADD("TipoOp = 'DSEO'")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto < '"~IdxDate(Dialogo.Fecha2)~"'")

recorrer SQL
  dfa
  recorrer&i fac+3, fac+3+Val(z1)
    if Val(a:&i)=fbn('FechaVto')
      ACN(z2, &i)
      break
    endif
  proximo
  if fbn('MB3')=1
    SCN(l:Val(z2), fbn('TotalNetoCli1'))
  else
    SCN(l:Val(z2), -fbn('TotalNetoCli1'))
  endif
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.TotalNetoCli1, O.Precio1, O.FechaVto, O.Cotizacion1, O.TipoOp, O.NrOperacion, O.Cartera, O.FechaPago, O.FechaEx1, O.Vehiculo1, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where")
SQL.ADD("TipoOp in ('SECT','SEVT','SEVTV','SECTV')")
SQL.ADD("and (PaseCB='0' or PaseCB is NULL) ")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp < '"~IdxDate(Dialogo.Fecha1)~"'")

recorrer SQL
  dfa
  ACT(y95,BuscarCampo('ESPECIES','Tipo','Codigo',fbn('Especie')))
  if EqStr(Val(y95),'PRI') o [Not EqStr(Val(y95),'PRI') y Not EqStr(fbn('Cartera'),'0')]
    ACN(z5, CotizacionC(fbn('Especie'),'F',fbn('FechaPago'),,Dialogo.Fecha1,1,SI,'USD'))
    * si hubo un dividendo durante el periodo
    if NoVacio(fbn('FechaEx1')) y fbn('FechaEx1') >= Dialogo.Fecha1 y fbn('FechaEx1') < Dialogo.Fecha2
      * buscar el div. x posiciones que corresponde a esa fecha
      SQL.ADD("Select Precio1, Precio2, TotalBrutoCli1, TotalNetoCli1 ") 
      SQL.ADD("from  "~DBO~".OPERACIONES where TipoOp = '"~DIVIDE~"' ")
      SQL.ADD("and MB4='1' and TipoCambio3 = 201 and Especie = '"~fbn('Especie')~"' ")
      SQL.ADD("and FechaPago = '"~IdxDate(fbn('FechaEx1'))~"' and Vehiculo1 = '"~fbn('Vehiculo1')~"' ")
      Recorrer SQL
        dfa
        * actualizar el precio
        ACN(za1, Val(z5) - (fbn('Precio1')/100))
        ACN(zb1, fbn('Precio2')/100)
        ACN(z5, Val(za1)/(1+Val(zb1)))
      Proximo
    endif
    if incluido(fbn('TipoOp'), 'SEVT|SEVTV')
      ACN(z4, -1)
    else
      ACN(z4, 1)
    endif
    if Elementos(Dialogo.Lista2)=1
      SCN(n:fac+2, fbn('Cantidad')*Val(z4))
      SCN(p:fac+2, fbn('Cantidad')*Val(z5)*Val(z4))
    endif
    SCN(q:fac+2, fbn('Cantidad')*Val(z5)*-Val(z4))
  endif
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.TotalNetoCli1, O.Precio1, O.FechaVto, O.Cotizacion1, O.TipoOp, O.NrOperacion, O.Cartera, O.FechaPago, O.FechaEx1, O.Vehiculo1, E.Tipo, E.Codigo from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where")
SQL.ADD("TipoOp in ('SECT','SEVT','SEVTV','SECTV') ")
SQL.ADD("and (PaseCB='0' or PaseCB is NULL) ")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)  
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Tipo= 'PUB' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Tipo= 'PRI' ")
    else
     SQL.ADD("and E.Tipo= 'ONE' ")
    endif
  endif 
else 
  SQL.ADD("and E.Tipo in ('PUB','PRI','ONE') ")
Endif
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("and FechaPago >= '"~IdxDate(Dialogo.Fecha2)~"' and FechaOp < '"~IdxDate(Dialogo.Fecha2)~"'")
recorrer SQL
  dfa
  ACT(y95,BuscarCampo('ESPECIES','Tipo','Codigo',fbn('Especie')))
  if EqStr(Val(y95),'PRI') o [Not EqStr(Val(y95),'PRI') y Not EqStr(fbn('Cartera'),'0')]
    ACN(z5, CotizacionC(fbn('Especie'),'F',fbn('FechaPago'),,Dialogo.Fecha2,1,SI,'USD'))
    * si hubo un dividendo durante el periodo y no habia valuacion inicial
    if NoVacio(fbn('FechaEx1')) y fbn('FechaEx1') >= Dialogo.Fecha1 y fbn('FechaEx1') < Dialogo.Fecha2 y Val(q:fac+2)=0
      * buscar el div. x posiciones que corresponde a esa fecha
      SQL.ADD("Select Precio1, Precio2, TotalBrutoCli1, TotalNetoCli1 ") 
      SQL.ADD("from  "~DBO~".OPERACIONES where TipoOp = '"~DIVIDE~"' ")
      SQL.ADD("and MB4='1' and TipoCambio3 = 201 and Especie = '"~fbn('Especie')~"' ")
      SQL.ADD("and FechaPago = '"~IdxDate(fbn('FechaEx1'))~"' and Vehiculo1 = '"~fbn('Vehiculo1')~"' ")
      Recorrer SQL
        dfa
        * actualizar el precio
        ACN(za1, Val(z5)- (fbn('Precio1')/100))
        ACN(zb1, fbn('Precio2')/100)
        ACN(z5, Val(za1)/(1+Val(zb1)))
      Proximo
    endif
    if incluido(fbn('TipoOp'), 'SEVT|SEVTV')
      ACN(z4, 1)
    else
      ACN(z4, -1)
    endif
    if Elementos(Dialogo.Lista2)=1
      SCN(n:fac+3+Val(z1), fbn('Cantidad')*Val(z4))
      SCN(p:fac+3+Val(z1), fbn('Cantidad')*Val(z5)*Val(z4))
    endif
    SCN(q:fac+3+Val(z1), fbn('Cantidad')*Val(z5)*-Val(z4))
  endif
proximo

Recorrer&i fac+3, fac+2+Val(z1)
  if Elementos(Dialogo.Lista2)=1
    ACN(e:&i, Val(e:&i)/Val(d:&i))
    ACN(j:&i, Val(j:&i)/Val(i:&i))
    ACN(o:&i, Val(o:&i)/Val(n:&i))
  endif
  ACN(r:&i, Val(q:&i)+Val(l:&i)+Val(g:&i))
  ACN(s:&i, Val(r:&i))
  ACN(t:&i, Dialogo.Fecha2-Dialogo.Fecha1+fac+3-&i)
  ACN(u:&i, Val(s:&i)*Val(t:&i))
proximo

* Buscar inicio de TIR
recorrer&i fac+2, fac+3+Val(z1)
  if Val(g:&i)<>0 y Val(z10)=0
    ACN(z10, &i)
    if EqStr(Val(a:&i),'Inicio')
      acn(xx:&i,Val(a:&i+1))
    else
      acn(xx:&i,Val(a:&i))
    endif
    recorrer&j &i, fac+3+Val(z1)
      if EqStr(Val(a:&j),'Inicio')
        ACN(aw:&j, 0)
      else
        if EqStr(Val(a:&j),'Fin')
           *ACN(aw:&j, (Val(a:&j-1)-Val(a:&i)))
           ACN(aw:&j, (Dialogo.Fecha2-Val(xx:&i)))
        else
           ACN(aw:&j, (Val(a:&j)-Val(xx:&i)+1))
        endif
      endif
    proximo
  endif
  if Val(l:&i)<>0 y Val(z11)=0
    ACN(z11, &i)
    if EqStr(Val(a:&i),'Inicio')
      acn(xx:&i,Val(a:&i+1))
    else
      acn(xx:&i,Val(a:&i))
    endif
    recorrer&j &i, fac+3+Val(z1)
      if EqStr(Val(a:&j),'Inicio')
        ACN(ax:&j, 0)
      else
        if EqStr(Val(a:&j),'Fin')
          *ACN(ax:&j, (Val(a:&j-1)-Val(a:&i)))
          ACN(ax:&j, (Dialogo.Fecha2-Val(xx:&i)))
        else
          ACN(ax:&j, (Val(a:&j)-Val(xx:&i)+1))
        endif
      endif
    proximo
  endif
  if Val(q:&i)<>0 y Val(z12)=0
    ACN(z12, &i)
    if EqStr(Val(a:&i),'Inicio')
      acn(xx:&i,Val(a:&i+1))
    else
      acn(xx:&i,Val(a:&i))
    endif
    recorrer&j &i, fac+3+Val(z1)
      if EqStr(Val(a:&j),'Inicio')
        ACN(ay:&j, 0 )
      else
        if EqStr(Val(a:&j),'Fin')
          *ACN(ay:&j, (Val(a:&j-1)-Val(a:&i)))
          ACN(ay:&j, (Dialogo.Fecha2-Val(xx:&i)))
        else
          ACN(ay:&j, (Val(a:&j)-Val(xx:&i)+1))
        endif
      endif
    proximo
  endif
proximo

* ACN(z13, Min(Val(z10), Val(z11)))
ACN(z13, Val(z10))
if Val(z13)>Val(z11) y Val(z11)>0
  ACN(z13, Val(z11))
endif

if EqStr(Val(a:Val(z13)),'Inicio')
  acn(xx:Val(z13),Val(a:Val(z13)+1))
else
  acn(xx:Val(z13),Val(a:Val(z13)))
endif
recorrer&j Val(z13), fac+3+Val(z1)
  if EqStr(Val(a:&j),'Inicio')
    ACN(az:&j, 0 )
  else
    if EqStr(Val(a:&j),'Fin')
      *ACN(az:&j, (Val(a:&j-1)-Val(a:Val(z13))))
      ACN(az:&j, (Dialogo.Fecha2-Val(xx:Val(z13))))
    else
      ACN(az:&j, (Val(a:&j)-Val(xx:Val(z13)) +1) )
    endif
  endif
proximo

* Fin Spot
ACN(g:fac+3+Val(z1), -Sum(bg1..bg:fac+2+Val(z1)))
if Elementos(Dialogo.Lista2)=1
  ACN(d:fac+3+Val(z1), -Sum(d1..d:fac+2+Val(z1)))
  ACN(f:fac+3+Val(z1), Val(g:fac+3+Val(z1))/Val(d:fac+3+Val(z1)))
endif
* P&L spot
ACN(g:fac+4+Val(z1), Sum(g1..g:fac+3+Val(z1)))
ACN(g:fac+6+Val(z1), Val(aw:fac+3+Val(z1)))

if val(g:fac+4+Val(z1))<>0
   ACN(g:fac+5+Val(z1), ((1+TIR2(aw:val(z10)..aw:fac+3+Val(z1),g:val(z10)..g:fac+3+Val(z1)))^(1/365)-1)*100  )    
   if Val(z10)=0
     ACN(g:fac+5+Val(z1), 0)
   endif

  * Rendimiento promedio spot
  ACN(g:fac+7+Val(z1), (((1+(Val(g:fac+5+Val(z1))/100))^Val(g:fac+6+Val(z1)))-1)/Val(g:fac+6+Val(z1))*365*100)
  * Capital promedio spot
  ACN(g:fac+8+Val(z1),(Val(g:fac+4+Val(z1))*365)/(Val(g:fac+7+Val(z1))/100*Val(z1)))
else
  * TIR diaria spot
  ACN(g:fac+5+Val(z1), 0)
  * Rendimiento promedio spot
  ACN(g:fac+7+Val(z1), 0)
  * Capital promedio spot
  ACN(g:fac+8+Val(z1),0)
endif

* P&L opciones
ACN(l:fac+4+Val(z1), Sum(l1..l:fac+3+Val(z1)))
ACN(l:fac+6+Val(z1), Val(ax:fac+3+Val(z1)))

if val(l:fac+4+Val(z1))<>0
   ACN(l:fac+5+Val(z1), ((1+TIR2(ax:Val(z11)..ax:fac+3+Val(z1), l:Val(z11)..l:fac+3+Val(z1)))^(1/365)-1)*100  )   
   if Val(z11)=0
     ACN(l:fac+5+Val(z1), 0)
   endif
   * Rendimiento promedio opciones
   ACN(l:fac+7+Val(z1), (((1+(Val(l:fac+5+Val(z1))/100))^Val(l:fac+6+Val(z1)))-1)/Val(l:fac+6+Val(z1))*365*100)
   * Capital promedio opciones
   ACN(l:fac+8+Val(z1),(Val(l:fac+4+Val(z1))*365)/(Val(l:fac+7+Val(z1))/100*Val(z1)))
else
   ACN(l:fac+5+Val(z1), 0)
   * Rendimiento promedio opciones
   ACN(l:fac+7+Val(z1),0)
   * Capital promedio opciones
   ACN(l:fac+8+Val(z1),0)
endif
* P&L Futuros
ACN(q:fac+4+Val(z1), Sum(q1..q:fac+3+Val(z1)))
ACN(q:fac+6+Val(z1), Val(ay:fac+3+Val(z1)))

if val(q:fac+4+Val(z1))<>0
   ACN(q:fac+5+Val(z1), ((1+TIR2(ay:Val(z12)..ay:fac+3+Val(z1), q:Val(z12)..q:fac+3+Val(z1)))^(1/365)-1)*100  )   
   if Val(z12)=0
      ACN(q:fac+5+Val(z1), 0)
   endif
   * Rendimiento promedio futuro
   ACN(q:fac+7+Val(z1), (((1+(Val(q:fac+5+Val(z1))/100))^Val(q:fac+6+Val(z1)))-1)/Val(q:fac+6+Val(z1))*365*100)

   * Capital promedio futuro
   ACN(q:fac+8+Val(z1),(Val(q:fac+4+Val(z1))*365)/(Val(q:fac+7+Val(z1))/100*Val(z1)))
   *ACN(r:fac+2, Val(g:fac+2)+Val(l:fac+2)+Val(q:fac+2))
   *ACN(r:fac+3+Val(z1), Val(g:fac+3+Val(z1))+Val(l:fac+3+Val(z1))+Val(q:fac+3+Val(z1)))
   *ACN(r:fac+4+Val(z1), Val(g:fac+4+Val(z1))+Val(l:fac+4+Val(z1))+Val(q:fac+4+Val(z1)))
else
   ACN(q:fac+5+Val(z1), 0)
   * Rendimiento promedio futuro
   ACN(q:fac+7+Val(z1), 0)
   * Capital promedio futuro
   ACN(q:fac+8+Val(z1),0)
endif
ACN(r:fac+2, Val(g:fac+2)+Val(l:fac+2))
ACN(s:fac+2, Val(r:fac+2))
ACN(t:fac+2, Dialogo.Fecha2-Dialogo.Fecha1)
ACN(u:fac+2, Val(s:fac+2)*Val(t:fac+2))
ACN(r:fac+3+Val(z1), Val(g:fac+3+Val(z1))+Val(l:fac+3+Val(z1)))
ACN(s:fac+3+Val(z1), Val(r:fac+3+Val(z1)))
ACN(t:fac+3+Val(z1), 0)
ACN(u:fac+3+Val(z1), Val(s:fac+3+Val(z1))*Val(t:fac+3+Val(z1)))
ACN(u:fac+4+Val(z1), sum(u:fac+2..u:fac+3+Val(z1)))

* P&L Total
ACN(r:fac+4+Val(z1), Val(g:fac+4+Val(z1))+Val(l:fac+4+Val(z1))+Val(q:fac+4+Val(z1)))
ACN(r:fac+6+Val(z1), Val(az:fac+3+Val(z1)))
if val(r:fac+4+Val(z1))<>0
   ACN(r:fac+5+Val(z1), ((1 +TIR2(az:Val(z13)..az:fac+3+Val(z1), r:Val(z13)..r:fac+3+Val(z1)))^(1/365)-1)*100  )   
   if Val(z13)=0
      ACN(r:fac+5+Val(z1), 0)
   endif
   * Rendimiento promedio total
   ACN(r:fac+7+Val(z1), (((1+(Val(r:fac+5+Val(z1))/100))^Val(r:fac+6+Val(z1)))-1)/Val(r:fac+6+Val(z1))*365*100)
   * Capital promedio total
   ACN(r:fac+8+Val(z1),(Val(r:fac+4+Val(z1))*365)/(Val(r:fac+7+Val(z1))/100*Val(z1)))
else
  ACN(r:fac+5+Val(z1), 0)
  * Rendimiento promedio total
  ACN(r:fac+7+Val(z1), 0)
  * Capital promedio total
  ACN(r:fac+8+Val(z1),Val(u:fac+4+Val(z1))/Val(r:fac+6+Val(z1))*-1)
endif
* Para linkear
* capital
ACN(bv:1, Val(r:fac+8+Val(z1)) )
* tasa
ACN(bu:1, Val(r:fac+7+Val(z1)))
* plazo
ACN(bw:1, 0)

SetFont(a1..bz:fac+2,1)
SetFont(a:fac+3..bz:fac+2+val(z1),2)
SetFont(a:fac+3+Val(z1)..bz:fac+8+Val(z1),1)
Impresion(1,2)
FormatoCeldas(c1..d:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(g1..i:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(l1..n:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(q1..s:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(u1..u:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(e1..f:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(j1..k:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(o1..p:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(t1..t:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(x1..x:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(a:fac+5+Val(z1)..u:fac+5+Val(z1), Exe('F7'))
 LimitesVision(v:fac+9+Val(z1))
SetPrintFit(3, 60)