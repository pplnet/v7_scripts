*/Informe que lista los registos de OCT que por algun motivo no ingresaron a FPA.
CrearDialogo
  Fecha1:'F. Desde'  ;;;;;;;;;FSys
  Fecha2:'F. Hasta'  ;;;;;;;;;FSys
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(2)
ACT(a:fac, CodigoInforme)
SetFilaActual(4)
ACT(a:fac, 'Listado de Registros NO procesados OCT')
IFA
ACT(a:fac, 'Fecha Desde '~Dialogo.Fecha1)
IFA
ACT(a:fac, 'Fecha Hasta '~Dialogo.Fecha2)
SetFilaActual(FAC+2)

ACT(a:fac, 'Fecha y Hora')
ACT(b:fac, 'Cod. Reg.')
ACT(c:fac, 'Descripcion')
ACT(d:fac, 'Motivo')
AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR'))
SetFont(a:4..z:fac,2)

ACT(z2, Var('PATHSIOPEL'))
AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
Repetir
  */1234567890
  */0409171049270105Problema de op duplicada                0294057101040824173530133520105ODOLAR    085$C06110100000000200000000000000000030890000055OCOCT1000000000000000000034350000000000000000000M000000000061780000000000000020000000ODOLAR17 NOV $C               1559915600090000000B0571010000000000000                  0000000000000                   
  ACT(ln1, LeerAscii)
  if Vacio(Val(ln1))
    CerrarASCII
    break
  endif
  */Obtengo la Fecha
  ACN(fe:1, Fecha(Copy(Val(ln1),5,2)~'/'~Copy(Val(ln1),3,2)~'/20'~Copy(Val(ln1),1,2))) 
  if Val(fe:1)<=Dialogo.Fecha2  y  Val(fe:1)>=Dialogo.Fecha1
    ifa
    ACT(a:fac, Copy(Val(ln1),5,2)~'/'~Copy(Val(ln1),3,2)~'/20'~Copy(Val(ln1),1,2)) 
    ACT(a:fac, Val(a:fac)~' '~Copy(Val(ln1),7,2)~':'~Copy(Val(ln1),9,2)~':'~Copy(Val(ln1),11,2) )
    ACT(b:fac, Copy(Val(ln1),13,4))
    if Incluido(Val(b:fac),'4416')
      ACT(c:fac, 'MTM OCT')
    endif
    if Incluido(Val(b:fac),'4426')
      ACT(c:fac, 'Detalle MTM OCT')
    endif
    if Incluido(Val(b:fac),'4427')
      ACT(c:fac, 'Cotizaciones OCT')
    endif
    if Incluido(Val(b:fac),'4428')
      ACT(c:fac, 'Garantias OCT')
    endif
    if Incluido(Val(b:fac),'2102')
      ACT(c:fac, 'Plazos OCT')
    endif
    if Incluido(Val(b:fac),'0105|0205')
      ACT(c:fac, 'Alta Operac.OCT')
    endif
    ACT(d:fac, Copy(Val(ln1),17,40)~' / Sec: '~Copy(Val(ln1),79,5))
    IFA
    ACT(a:fac, Copy(Val(ln1),57,100) )
    AgregarMarco(a:fac..d:fac,2,0)
    SetFont(a:fac-1..z:fac,1)
    IFA
  endif
Proximo

SetFilaActual(FAC+3)
LimitesVision(F:fac)

ACO(1,12)
ACO(2,6)
ACO(3,10)
ACO(4,60)
Impresion(1,2)
