*TABLA OPERACIONES - Ult. operacion ingresada de cada TipoOp
*TABLA LOGINFORMES - Codigo, Tipo, Fecha ult ejec. ordenado por Fecha de mayor a menor


*******************************************************************DIALOGO******************************************************
CrearDialogo
    Check1: 'Todos'            ;;;;;;;;;1;
    Check2: 'Informes'         ;;;;Dialogo.Check1=0;;;;;1;IIF(Dialogo.Check1=1,1)
    Check3: 'Eventos'          ;;;;Dialogo.Check1=0;;;;;1;IIF(Dialogo.Check1=1,1)
    Check4: 'Operaciones'      ;;;;Dialogo.Check1=0;;;;;1;IIF(Dialogo.Check1=1,1)
    Check5: 'Transacciones'    ;;;;Dialogo.Check1=0;;;;;1;IIF(Dialogo.Check1=1,1)
    Check6: 'Validacion'       ;;;;;NO;Dialogo.Check6=1;'Debe seleccionar al menos uno';NO;1;IIF(Dialogo.Check1=0 y Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0 y Dialogo.Check5=0,0,1);;;;;;;;;;;;;;
FinDialogo
******************************************************************FINDIALOGO*****************************************************

If not ok
    Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,12,B")
CrearFont(3,"Arial,8,B")


*****************************************************************TITULO - INFORMACION********************************************
SetFilaActual(1)
ACT(F:fac,'Ultimas Ejecuciones')
SetFont(F:fac..F:fac,2)

SetFilaActual(fac+2)

ACT(A:fac,'Datos sobre:')
ACN(FF:1,FAC)

SetFont(A:fac..A:fac,3)
****************************************************************FIN TITULO - INFORMACION******************************************


***************************************************************CONSULTA SELECT Y TITULOS PLANILLA****************************************************
SetFilaActual(fac+2)

ACN(IN:1,FAC)


ACN(CH:1,0)

    IF Dialogo.Check1=1 o Dialogo.Check2=1 o Dialogo.Check3=1
        SQL.ADD(" Select DISTINCT Codigo,Tipo,MAX(Fecha) as Fecha From "~dbo~".LOGINFORMES ")
        SQL.ADD("Where Codigo is Not Null and Fecha is Not Null and Tipo IN (")
        IF Dialogo.Check2=1
            ACT(A:Val(FF:1),Val(A:Val(FF:1))~' Informes.')
            ACN(CH:1,1)
            ACT(B:fac,'INFORMES')
            SQL.ADD(" 'INF' ")
        ENDIF
        IF Dialogo.Check3=1
            ACT(A:Val(FF:1),Val(A:Val(FF:1))~' Eventos.')
            IF Val(CH:1)=1
                ACN(CH:1,2)
                SQL.ADD(" ,'EVE' ")
                ACT(F:fac,'EVENTOS')
            ELSE
                ACN(CH:1,1)
                ACT(B:fac,'EVENTOS')
                SQL.ADD(" 'EVE' ")
            ENDIF
        ENDIF
        SQL.ADD(") GROUP BY Codigo,Tipo ")
    ENDIF
    
    IF Dialogo.Check1=1 o Dialogo.Check4=1
        ACT(A:Val(FF:1),Val(A:Val(FF:1))~' Operaciones.')
        IF Dialogo.Check2=1 o Dialogo.Check3=1
            SQL.ADD(" UNION ")
            IF Val(CH:1)=2
                ACN(CH:1,3)
                ACT(J:fac,'OPERACIONES')
            ELSE
                ACN(CH:1,2)
                ACT(F:fac,'OPERACIONES')

            ENDIF
        ELSE
            ACN(CH:1,1)
            ACT(B:fac,'OPERACIONES')
        ENDIF
    
        SQL.ADD(" Select DISTINCT TipoOp as Codigo,'OP' as Tipo, MAX(FechaCarga) as Fecha From "~dbo~".OPERACIONES ")
        SQL.ADD("Where TipoOp is Not Null and FechaCarga is Not Null ")
        SQL.ADD(" GROUP BY TipoOp ")
    ENDIF
    
    IF Dialogo.Check1=1 O Dialogo.Check5=1
        ACT(A:Val(FF:1),Val(A:Val(FF:1))~' Transacciones.')
        IF Dialogo.Check2=1 o Dialogo.Check3=1 o Dialogo.Check4
            SQL.ADD(" UNION ")
            ***Si están seleccionados los otros 3
            IF Val(CH:1)=3
                ACN(CH:1,4)
                ACT(N:fac,'TRANSACCIONES')
                ELSE
                    ***Si hay 2 seleccionados
                    IF Val(CH:1)=2
                        ACN(CH:1,3)
                        ACT(J:fac,'TRANSACCIONES')
                    ELSE
                        IF Val(CH:1)=1
                        ***Si hay 1 selecionado
                            ACN(CH:1,2)
                            ACT(F:fac,'TRANSACCIONES')
                        ENDIF    
                    ENDIF    
            ENDIF
        ELSE
        ****Si no hay ninguno seleccionado
            ACN(CH:1,1)
            ACT(B:fac,'TRANSACCIONES')
        ENDIF
           SQL.ADD("SELECT DISTINCT TipoTr2 as Codigo, 'TRAN' as Tipo, MAX(FechaCarga) as Fecha  FROM TRANSACCIONES2")
           SQL.ADD("Where TipoTr2 is Not Null and FechaCarga is Not Null ")
           SQL.ADD("GROUP BY TipoTr2 ")
    ENDIF
    
    SQL.ADD(" ORDER BY Tipo,Fecha DESC ")

ifa
***Cuando solo hay un cuadro
ACT(A:fac,'Codigo')
ACT(B:fac,'Nombre/Descr.')
ACT(C:fac,'Ult. Fecha')
AgregarMarco(A:fac-1..C:fac,2,1,Exe('COLOR6'))
ACO(2,22)
SetFont(A:fac-1..c:fac,3)
***Para 2 cuadros
IF Dialogo.Check1=1 O VAL(CH:1)>=2
    ACT(E:fac,'Codigo')
    ACT(F:fac,'Nombre/Descr.')
    ACT(G:fac,'Ult. Fecha')
    AgregarMarco(E:fac-1..G:fac,2,1,Exe('COLOR6'))
    ACO(6,22)
    SetFont(E:fac-1..G:fac,3)
ENDIF
***Para 3 cuadros
IF Dialogo.Check1=1 O VAL(CH:1)>=3 
    ACT(I:fac,'Codigo')
    ACT(J:fac,'Nombre/Descr.')
    ACT(K:fac,'Ult. Fecha')
    AgregarMarco(I:fac-1..K:fac,2,1,Exe('COLOR6'))
    ACO(10,22)
    SetFont(I:fac-1..K:fac,3)
ENDIF
***Para 4 cuadros
IF Dialogo.Check1=1 O VAL(CH:1)=4 
    ACT(M:fac,'Codigo')
    ACT(N:fac,'Nombre/Descr.')
    ACT(O:fac,'Ult. Fecha')
    AgregarMarco(M:fac-1..O:fac,2,1,Exe('COLOR6'))
    ACO(14,22)
    SetFont(M:fac-1..O:fac,3)
ENDIF


***********************************************************FIN CONSULTA SELECT Y TITULOS PLANILLA****************************************************

********************************************************************RECORRER SQL****************************************************

*tipo actual
ACT(TA:1,'')
*Columna 1 Eventos
ACN(EE:1,0)
*Columna 1 Operaciones
ACN(OO:1,0)
*Columna 1 Transacciones
ACN(TR:1,0)
*Inicio Fila Recorrer SQL
ACN(FR:1,FAC+1)
Recorrer SQL
    IF Vacio(Val(TA:1))
        ACN(FA:1,FAC)
        *Contador Informes
        ACN(CI:1,fac)
        *Contador Eventos
        ACN(CE:1,fac)
        *Contador Operaciones
        ACN(CO:1,fac)
        *Contador Transacciones
        ACN(TC:1,fac)
    ENDIF
    IF Not EqStri(Val(TA:1),fbn('Tipo'))
        ACT(TA:1,fbn('Tipo'))
        SetFilaActual(Val(FA:1))
    ENDIF


****INFORMES****
    
***Si se selecciona, ocupa siempre la primera posición
    IF Dialogo.Check2=1
        IF EqStri(fbn('Tipo'),'INF')
            ACT(A:fac,fbn('Codigo'))
            ACT(B:fac,BuscarCampo('INFORMES','Nombre','Codigo',fbn('Codigo')))
            ACD(C:fac,fbn('Fecha'))
            IF Vacio(Val(B:fac))
                ACT(B:fac,'INFORME ELIMINADO')
                ColorCeldas(A:fac..C:fac,EXE('COLOR5'))
            ENDIF
            ACN(CI:1,Val(CI:1)+1)
        ENDIF
    ENDIF

****EVENTOS****

    IF Dialogo.Check3=1
    ***2nda posición
    IF VAL(CH:1)>=2 Y Dialogo.Check2=1
            ACN(EE:1,5)
        ELSE
        ***1era posición
            IF VAL(CH:1)>=2 O VAL(CH:1)=1
                ACN(EE:1,1)
            ENDIF    
        ENDIF
        IF EqStri(fbn('Tipo'),'EVE')
            ACT(Val(EE:1):fac,fbn('Codigo'))
            ACT(Val(EE:1)+1:fac,BuscarCampo('EVENTOS','Nombre','Codigo',fbn('Codigo')))
            ACD(Val(EE:1)+2:fac,fbn('Fecha'))
            IF Vacio(Val(Val(EE:1)+1:fac))
                ACT(Val(EE:1)+1:fac,'EVENTO ELIMINADO')
                ColorCeldas(Val(EE:1):fac..Val(EE:1)+2:fac,EXE('COLOR5'))
            ENDIF
            ACN(CE:1,Val(CE:1)+1)
        ENDIF
    ENDIF
    
****OPERACIONES****
  
    IF Dialogo.Check4=1
       *3era posición (INFO Y EVE adelante)
       IF VAL(CH:1)>=3 Y Dialogo.Check2=1 Y Dialogo.Check3=1
            ACN(OO:1,9)
        ELSE
            *2nda posición (INFO o EVE adelante)
            IF VAL(CH:1)>=2 Y Dialogo.Check2=1 O Dialogo.Check3=1
                ACN(OO:1,5)
            ELSE
            *1era posición
                ACN(OO:1,1)
            ENDIF
        ENDIF
        IF EqStri(fbn('Tipo'),'OP')
            ACT(Val(OO:1):fac,fbn('Codigo'))
            ACT(Val(OO:1)+1:fac,BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('Codigo')))
            ACD(Val(OO:1)+2:fac,fbn('Fecha'))
            IF Vacio(Val(Val(OO:1)+1:fac))
                ACT(Val(OO:1)+1:fac,'TIPO DE OPERACION ELIMINADA')
                ColorCeldas(Val(OO:1):fac..Val(OO:1)+2:fac,EXE('COLOR5'))
            ENDIF
            ACN(CO:1,Val(CO:1)+1)
        ENDIF
    ENDIF
    
****TRANSACCIONES****    

   IF Dialogo.Check5=1
   *4ta posición
   IF Dialogo.Check1=1 o VAL(CH:1)=4
           ACN(TR:1,13)
       ELSE
       *3era posición
           IF VAL(CH:1)=3
               ACN(TR:1,9)
           ELSE    
           *2nda posición
               IF VAL(CH:1)=2
                   ACN(TR:1,5)
               ELSE
               *1era posición
                   ACN(TR:1,1)
               ENDIF   
           ENDIF
       ENDIF
      
        IF EqStri(fbn('Tipo'),'TRAN')
           ACT(Val(TR:1):fac,fbn('Codigo'))
           ACT(Val(TR:1)+1:fac,BuscarCampo('TIPOSTRANSACCION2','Nombre','Codigo',fbn('Codigo')))
           ACD(Val(TR:1)+2:fac,fbn('Fecha'))
           IF Vacio(Val(Val(TR:1)+1:fac))
               ACT(Val(TR:1)+1:fac,'TIPO DE TRANSACCION ELIMINADA')
               ColorCeldas(Val(TR:1):fac..Val(TR:1)+2:fac,EXE('COLOR5'))
           ENDIF
           ACN(TC:1,Val(TC:1)+1)
        ENDIF
    ENDIF
    

Proximo


******************************************************************FIN RECORRER SQL************************************************

******************************************************************MARCOS PARA DATOS***********************************************
IF Val(CI:1)>0
    AgregarMarco(A:Val(FR:1)..C:Val(CI:1)-1,2,0)
ENDIF
IF Val(CE:1)>0
    AgregarMarco(Val(EE:1):Val(FR:1)..Val(EE:1)+2:Val(CE:1)-1,2,0)
ENDIF
IF Val(CO:1)>0
    AgregarMarco(Val(OO:1):Val(FR:1)..Val(OO:1)+2:Val(CO:1)-1,2,0)
ENDIF
IF Val(TC:1)>0
    AgregarMarco(Val(TR:1):Val(FR:1)..Val(TR:1)+2:Val(TC:1)-1,2,0)
ENDIF
*****************************************************************FIN MARCOS PARA DATOS************************************************

ACN(MA:1,MAX(Val(CI:1),Val(CE:1),Val(CO:1),Val(TC:1)))
AlinearCeldas(A:Val(IN:1)..R:Val(MA:1),'C')
SetFilaActual(Val(MA:1))

ifa
ACT(A:fac,'Fin del Informe')
SetFont(A:fac..A:fac,3)

LimitesVision(R:fac)