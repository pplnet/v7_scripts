********************************************************************
*
* Lista los Codigos de Especies
*
*********************************************************************
HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Especie1 : "Especie"  ;;;;;;
FinDialogo

If not Ok
  Cancelar
endif
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(1)
ACT(a:1,'Posicion Bancaria - CONFIDENCIAL')
SetFont(a:1,1)

SetFilaActual(fac+2)
ACT(b:fac, 'Listado de Codigos de Especies')
SetFont(f:fac, 3)

SetFilaActual(fac+1)
If NoVacio(Dialogo.Especie1)
   ACT(a:fac+1, 'Especie: '~Dialogo.Especie1)
else
   ACT(a:fac+1, 'Especie: Todas')
endif

SetFilaActual(fac+2)
ACT(A:fac,'Codigo')
ACT(B:fac,'Nombre')
ACT(C:fac,'Descripcion')
ACT(D:fac,'Cotiza')
ACT(E:fac,'Alias3')
ACT(F:fac,'Tipo')
ACT(G:fac,'Tipo Ec')
ACT(H:fac,'Status')
ACT(I:fac,'Cupon')
ACT(J:fac,'Alias9')
ACT(cd1,'Codigo Sin Tipificar')
AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
Setfont(a2..j:fac, 1)
AlinearCeldas(j:fac..d:fac, 'C')
*--  Select
SQL.ADD(" Select A.Codigo, A.Nombre, A.Extendido, A.Cotiza, A.Alias3, A.Tipo, A.TipoEC, A.Status, A.Cupon, A.Alias9  from "~DBO~".ESPECIES A")
If NoVacio(Dialogo.Especie1)   
   SQL.ADD("   where A.Codigo = '"~Dialogo.Especie1~"' ")
   SQL.ADD("   or A.Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES',Dialogo.Especie1))~")  ")
EndIf
SQL.ADD(" order by A.Jerarquia, A.Codigo")
acn(z3,0)
acn(z2,0)
ACN(FI:1, fac+1)
Recorrer SQL
   ACT(a:fac,FBN['Codigo'])
   ACT(b:fac,FBN['Nombre'])
   ACT(c:fac,FBN['Extendido'])
   ACT(d:fac,FBN['Cotiza'])
   ACT(e:fac,FBN['Alias3'])
   ACT(f:fac,FBN['Tipo'])
   ACT(g:fac,FBN['TipoEC'])
   ACT(h:fac,FBN['Status'])
   ACT(i:fac,FBN['Cupon'])
   ACT(j:fac,FBN['Alias9'])
   SetFont(a:fac..j:fac, 2)
Proximo
Ifa
Ifa
AgregarMarco(a:fac..j:fac,1,0,Exe('COLOR'))
SetFont(a:fac..j:fac, 1)
Impresion(1,1)
act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)
SetFilaActual(fac+1)
LimitesVision(j:fac+1)
ACO(2, 10)
ACO(3, 25)
*ACO(4, 15)
SetPrintFit(3, 75)
RangoTitulo(a:1..j:fac+1, 6)