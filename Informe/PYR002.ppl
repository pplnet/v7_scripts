CrearDialogo
  Fecha1:'Fecha';;;;;;;;;FSys
  Vehiculo1:'Vehiculo'
  Book1:'Book'
  Especie1:'Especie'
  Especie2:'Moneda'
  Radio1: 'Precio|Historico|Reseteado'
FinDialogo

if not OK 
  Cancelar
endif

ACT(a1, 'Resultados por Especie')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)
ACT(a3, 'Especie: Todas')
ACT(a4, 'Vehiculo: Todos')
ACT(a5, 'Book: Todos')
if Dialogo.Radio1=0
  ACT(a6, 'Precio: Historico')
else
  ACT(a6, 'Precio: Reseteado')
endif

CrearFont(1,"Arial,8,B")
CrearFont(2,"Arial,8,")

SetFont(a1..z6, 1)
SetFilaActual(7)
SQL.ADD("Select * from "~DBO~".RESULTADOS2")
SQL.ADD("where Fecha='"~IdxDate(Dialogo.Fecha1)~"'")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"'")  
  ACT(a4, 'Vehiculo: '~Dialogo.Vehiculo1)
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("and Book = '"~Dialogo.Book1~"'")  
  ACT(a5, 'Book: '~Dialogo.Book1)
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Especie = '"~Dialogo.Especie1~"'")  
  ACT(a3, 'Especie: '~Dialogo.Especie1)
endif
SQL.ADD("and NrSaldo = 2")  
SQL.ADD("order by Especie, Vehiculo, Book")
    recorrer SQL
      ACT(a:fac, 'Especie')
      ACT(a:fac+1, 'Vehiculo')
