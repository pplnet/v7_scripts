ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"     ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Vehiculo1  : "Empresa"   ;;;;;;;;;
  Check1     : "Graba"
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")

SetFilaActual(1)
acn(e:210,fac)
act(cz2,Descendientes('Vehiculos',Dialogo.Vehiculo1,NO))

   *** veo si los descendientes son hojas ***
   SQL.ADD("Select Codigo from "~DBO~".VEHICULOS ")
   SQL.ADD("where  Codigo In ("~Pipe2Comillas(val(cz2))~") and ")
   SQL.ADD(" (Status='HAB' or Status Is Null or Status='') ")
   SQL.ADD("and  TipoVehiculo = 'VIN' ")
   SQL.ADD("order by Codigo ")

   Recorrer SQL
     if JNivel('Vehiculos',fbn['Codigo']) = (JNivel('Vehiculos',Dialogo.Vehiculo1)+1)
        act(ca:fac,fbn['Codigo'])
        act(cb:fac,Descendientes('Vehiculos',val(ca:fac),NO))
        acn(cc:fac,fac)
        if Vacio(val(cb:fac))
           LinkearHoja('POSFIN',fac,Fecha1=Dialogo.Fecha1,Vehiculo1=val(ca:fac),Lista1=val(ca:fac)~'|',Check1=Dialogo.Check1)
        endif
        if NoVacio(val(cb:fac))
           *** veo si los descendientes son hojas ***
           SQL.ADD("Select Codigo from "~DBO~".VEHICULOS ")
           SQL.ADD("where  Codigo In ("~Pipe2Comillas(val(cb:fac))~") and ")
           SQL.ADD(" (Status='HAB' or Status Is Null or Status='') ")
           SQL.ADD("order by Codigo ")

           acn(cz1,0)
           Recorrer SQL
             dfa
             if [Not EsTerminal(fbn['Codigo'],VEHICULOS)]
                acn(cz1,1)
             endif
           Proximo

           if val(cz1) = 0
              LinkearHoja('POSFIN',fac,Fecha1=Dialogo.Fecha1,Vehiculo1=val(ca:fac),Lista1=val(cb:fac),Check1=Dialogo.Check1)
           else
              LinkearHoja('PFNEW2',fac,Fecha1=Dialogo.Fecha1,Vehiculo1=val(ca:fac),Check1=Dialogo.Check1)
           endif
        endif
        act(d:210,fbn['Codigo']~'|'~val(d:210))
        scn(e:210,1)
       else
        dfa
     endif
   Proximo

   *** consolida ***
   (.'MARCOPOSFI'.)

   *** Escribo fila de vehiculos ***
   SetFilaActual(2)

   acn(b:200,2)
   act(val(b:200):fac,'CON. '~Dialogo.Vehiculo1)
   ACO(val(b:200),11)

   SQL.ADD("Select Codigo From "~DBO~".VEHICULOS ")
   SQL.ADD("where  Codigo In ("~Pipe2Comillas(val(d:210))~") and ")
   SQL.ADD(" (Status='HAB' or Status Is Null or Status='') ")
   SQL.ADD("order by Codigo")

   Recorrer SQL
     dfa
     scn(b:200,1)
     act(val(b:200):fac,fbn['Codigo'])
     ACO(val(b:200),10)
   Proximo

   SetFont(b:fac..val(b:200):FAC,2)
   AlinearCeldas(b:fac..val(b:200):FAC,'D')
   AgregarMarco(b:FAC..val(b:200):FAC,2,1,Exe('COLOR6'))

   acn(e:200,3)
   Recorrer&i 2, val(e:210)
     Recorrer&j 6, 103
       if LinkH(val(cc:&i),b:&j) <> 0
          acn(val(e:200):&j,LinkH(val(cc:&i),b:&j))                   
       endif
     Proximo
     scn(e:200,1)
   Proximo

   scn(e:210,1)
   act(cz2,Descendientes('Vehiculos',Dialogo.Vehiculo1,NO))

   *** veo si los descendientes son hojas ***
   SQL.ADD("Select Codigo from "~DBO~".VEHICULOS ")
   SQL.ADD("where  Codigo In ("~Pipe2Comillas(val(cz2))~") and ")
   SQL.ADD(" (Status='HAB' or Status Is Null or Status='') ")
   SQL.ADD("order by Codigo ")

   Recorrer SQL
     if Vacio(Descendientes('Vehiculos',fbn['Codigo'],NO))
        act(cz3,fbn['Codigo']~'|'~val(cz3))
     endif
     dfa
   Proximo

   *** trae consolidado vinculadas ***
   LinkearHoja('POSFIN',val(e:210),Fecha1=Dialogo.Fecha1,Vehiculo1=Dialogo.Vehiculo1,Lista1=val(cz3),Check1=Dialogo.Check1)
   if LinkH(val(e:210),b:6) <> 0
      acn(b:6,LinkH(val(e:210),b:6))
      scn(b:val(h:200),val(b:6))
   endif
   if LinkH(val(e:210),b:24) <> 0
      acn(b:24,LinkH(val(e:210),b:24))
      scn(b:val(i:200),val(b:24))
   endif
   if LinkH(val(e:210),b:47) <> 0
      acn(b:47,LinkH(val(e:210),b:47))
      scn(b:val(k:200),val(b:47))
   endif
   if LinkH(val(e:210),b:64) <> 0
      acn(b:64,LinkH(val(e:210),b:64))
      scn(b:val(l:200),val(b:64))
   endif

   *** trae consolidado otras vinculadas ***
   if LinkH(val(e:210),b:9) <> 0
      acn(b:9,LinkH(val(e:210),b:9))
      scn(b:val(h:200),val(b:9))
   endif
   if LinkH(val(e:210),b:26) <> 0
      acn(b:26,LinkH(val(e:210),b:26))
      scn(b:val(i:200),val(b:26))
   endif
   if LinkH(val(e:210),b:12) <> 0
      acn(b:12,LinkH(val(e:210),b:12))
      scn(b:val(h:200),val(b:12))
   endif
   if LinkH(val(e:210),b:27) <> 0
      acn(b:27,LinkH(val(e:210),b:27))
      scn(b:val(i:200),val(b:27))
   endif
   if LinkH(val(e:210),b:13) <> 0
      acn(b:13,LinkH(val(e:210),b:13))
      scn(b:val(h:200),val(b:13))
   endif
   if LinkH(val(e:210),b:28) <> 0
      acn(b:28,LinkH(val(e:210),b:28))
      scn(b:val(i:200),val(b:28))
   endif
   if LinkH(val(e:210),b:50) <> 0
      acn(b:50,LinkH(val(e:210),b:50))
      scn(b:val(k:200),val(b:50))
   endif
   if LinkH(val(e:210),b:66) <> 0
      acn(b:66,LinkH(val(e:210),b:66))
      scn(b:val(l:200),val(b:66))
   endif
   if LinkH(val(e:210),b:53) <> 0
      acn(b:53,LinkH(val(e:210),b:53))
      scn(b:val(k:200),val(b:53))
   endif
   if LinkH(val(e:210),b:67) <> 0
      acn(b:67,LinkH(val(e:210),b:67))
      scn(b:val(l:200),val(b:67))
   endif
   if LinkH(val(e:210),b:54) <> 0
      acn(b:54,LinkH(val(e:210),b:54))
      scn(b:val(k:200),val(b:54))
   endif
   if LinkH(val(e:210),b:68) <> 0
      acn(b:68,LinkH(val(e:210),b:68))
      scn(b:val(l:200),val(b:68))
   endif

   *** trae regularizacion ***
   if LinkH(val(e:210),b:86) <> 0
      acn(b:86,LinkH(val(e:210),b:86))
   endif
   if LinkH(val(e:210),b:93) <> 0
      acn(b:93,LinkH(val(e:210),b:93))
   endif

   if LinkH(val(e:210),b:89) <> 0
      acn(b:89,LinkH(val(e:210),b:89))
   endif
   if LinkH(val(e:210),b:90) <> 0
      acn(b:90,LinkH(val(e:210),b:90))
   endif
   if LinkH(val(e:210),b:96) <> 0
      acn(b:96,LinkH(val(e:210),b:96))
   endif
   if LinkH(val(e:210),b:97) <> 0
      acn(b:97,LinkH(val(e:210),b:97))
   endif
   CerrarLink(val(e:210))

   SetFont(c:6..val(b:200):100,3)

   (.'TOTALPOSF'.)
   (.'CONTROLPF'.)

LimitesVision(val(b:200)+2:130)
Impresion(1,2)

if Dialogo.Check1=1
  if Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1, NO, 'ARG')
     GrabarPMG('PFNEW', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
  else
     *- Elimina el AnteUltimo. Calculo el Dia a Eliminar
     acd(e211,HABILES(Dialogo.Fecha1,-2,'ARG',SI))
     SQL.ADD("Delete "~DBO~".OBJETOS Where ")
     SQL.ADD("Codigo='POSFIN' and Extension LIKE '%"~val(e211)~"%' ")
     SQL.NEW
     SQL.EXEC

     *- Graba el Ultimo 
     GrabarPMG('POSFIN', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
  endif
endif
