ModoReproceso(ConDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1   : 'Desde'         ;;;;;;;;;;FSYS-1
   Fecha2   : 'Hasta'         ;;;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error de Fechas';NO;;FSYS-1
   Vehiculo1: 'Vehiculo'      ;1;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Especie1 : 'Moneda'        ;2;2;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4   : 'Imp.Detallado' ;3;2;;;;;;;;0;
   Check1   : 'Por TipoOp?'   ;3;1;;;;;;;0
   Radio3   : 'Origen:|Todas|Activas|Pasivas'                       ;5;1;;;Dialogo.Check1=0;;;;0;
   Radio1   : 'Terc y Act|Todos|Dep.Pla|Cta.Cte'                    ;6;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio1),-1)
   Radio4   : 'Terc y Pas|Todos|Ob.Neg|Com.Ext|Fin.Lo|Fin.Ex|C.C.'  ;7;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio4),-1)
   Radio2   : 'Vinc y Act|Todos|C.C.Vinc|C.C.Div|Co.Vinc|Co.Div'    ;8;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio2),-1)
   Radio5   : 'Vinc y Pas|Todos|C.C.Vinc|C.C.Div|Pr.Vinc|Pr.Div'    ;9;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio5),-1)
   Lista1   : 'Tipos'                                               ;4;1;;;Dialogo.Check1=1;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo In ('MMCDIA','MMCPM','MMFCMV','MMONM','MMPEM','MMPIM','MMPCLM','MMPOSM','MMSCMV','MMPCCM','MMSIMV','MMFIMV') ");
   Radio7   : 'Especies:|Todas|Algunas'                             ;5;1;;;;;;;0;
   Lista2   : 'Especies'                                            ;5;2;;Dialogo.Radio7=1;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Radio6   : 'Clientes:|Todos|Vinculados|Terceros'                 ;6;1;;;;;;;0;
   Lista3   : 'Clientes'                                            ;6;2;;Dialogo.Radio6<>0;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo
IF NOT OK
   Cancelar
ENDIF

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6,Dialogo.Vehiculo1~'|')
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else 
      *- zz6 Siempre contiene los Vehiculos Habilitados
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*AgregarBMP(a1,Var('LOGO'),Var('ESCALOGO'))

ACT(a:3, 'SISTEMA DE COSTOS Y RENDIMIENTOS - OPERACIONES DE VENCIMIENTO MULTIPLE')
SetFont(a:3..a:3,3)

ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

If NoVacio(VAL(ZZ6))
   ACT(h5, 'Vehiculo : '~VAL(ZZ6))
Else
   ACT(h5, 'Vehiculo : Todos')
EndIf

If Dialogo.Radio6 = 0 
  ACT(h6,'Clientes: TODOS' )   
Else
  If NoVacio(Dialogo.Lista3)
     ACT(h6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
  Else
     If Dialogo.Radio6 = 1
         ACT(h6,'Clientes: VINCULADOS' )   
     Else 
         ACT(h6,'Clientes: TERCEROS' )   
     Endif 
  Endif   
Endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(h7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(h7,'Especies: TODAS' )   
endif

*--- Si eligio Operaciones, No Displaya Radio1 a RAdio5
If Dialogo.Check1=1
   If NoVacio(Dialogo.Lista1)
      ACT(h8,'Operaciones: '~Pipe2coma(Dialogo.Lista1))     
   Else
      ACT(h8,'Operaciones: MMCDIA,MMCPM,MMFCMV,MMONM,MMPEM,MMPIM,MMPCLM,MMPOSM,MMSCMV,MMPCCM,MMSIMV,MMFIMV' )   
   EndIf
EndIf

If Dialogo.Radio3 = 0
   ACT(d6,'Origen: ACTIVAS y PASIVAS ')
Else
   If Dialogo.Radio3 = 1
      ACT(d6,'Origen: ACTIVAS ')
   Else
      ACT(d6,'Origen: PASIVAS ')
   Endif 
Endif

if Dialogo.Radio1=0
  ACT(k4, 'Terc y Act: Todos')
else
  if Dialogo.Radio1=1
    ACT(k4, 'Terc y Act: Dep.Plazo')
  else
    if Dialogo.Radio1=2
      ACT(k4, 'Terc y Act: Cta.CTe.Terceros')
    endif
  endif
endif

if Dialogo.Radio4=0
  ACT(k5, 'Terc y Pas: Todos')
else
  if Dialogo.Radio4=1
    ACT(k5, 'Terc y Pas: Obligaciones Negociables')
  else
    if Dialogo.Radio4=2
      ACT(k5, 'Terc y Pas: Comercio Exterior')
    else
      if Dialogo.Radio4=3
        ACT(k5, 'Terc y Pas: Financiamiento Loc.')
      else
        if Dialogo.Radio4=4
          ACT(k5, 'Terc y Pas: Financiamiento Ext.')
        else
          if Dialogo.Radio4=5
            ACT(k5, 'Terc y Pas: Cta.Cte.Terceros')
          endif
        endif
      endif
    endif
  endif
endif

if Dialogo.Radio2=0
  ACT(k6, 'Vinc y Act: Todos')
else
  if Dialogo.Radio2=1
    ACT(k6, 'Vinc y Act: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio2=2
      ACT(k6, 'Vinc y Act: Cta.Cte.Div.')
    else
      if Dialogo.Radio2=3
        ACT(k6, 'Vinc y Act: Colocaciones Vinc.')
      else
        if Dialogo.Radio2=4
          ACT(k6, 'Vinc y Act: Colocaciones Div.')
        endif
      endif
    endif
  endif
endif

if Dialogo.Radio5=0
  ACT(k7, 'Vinc y Pas: Todos')
else
  if Dialogo.Radio5=1
    ACT(k7, 'Vinc y Pas: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio5=2
      ACT(k7, 'Vinc y Pas: Cta.Cte.Div.')
    else
      if Dialogo.Radio5=3
        ACT(k7, 'Vinc y Pas: Prestamos Vinc.')
      else
        if Dialogo.Radio5=4
          ACT(k7, 'Vinc y Pas: Prestamos Div.')
        endif
      endif
    endif
  endif
endif

SetFont(a0..z7, 2)
SetFilaActual(5)
ACN(bh:1,FAC)


SetFilaActual(FAC+4)

ACT(a:fac,'Empresa')
ACT(b:fac,'TipOp')
ACT(c:fac,'NroOpe')
ACT(d:fac,'Entidad')
ACT(e:fac,'Moneda')
ACT(f:fac,'Cant. Per.')
ACT(g:fac,'F.Origen')
ACT(h:fac,'F.Vto')
ACT(i:fac,'Plazo Tot')
ACT(j:fac,'Cr.')
ACT(k:fac,'Cbio.Origen')
ACT(l:fac,'Cbio.Vto')
