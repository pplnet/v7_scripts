ACT(n:fac,'Cap.P.P.')
ACT(o:fac,'Para clac.k.P.P.')
ACT(p:fac,'Cap.Comput.')
ACT(q:fac,'Plazo Tot')
ACT(r:fac,'Tasa')
ACT(s:fac,'Dias Transc')
ACT(t:fac,'Intereses')
ACT(u:fac,'Capital')
ACT(v:fac,'Capital')
