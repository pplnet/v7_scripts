ModoReproceso(ConDialogo)
CrearDialogo
  Corredor1:'Çorredor'   ;;;;;
  Fecha1   :'F.Desde'    ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar Fecha Desde';NO;PriDeMes(Fsys,NO,'ARG')
  Fecha2   :'F.Hasta'    ;;;;;;NoVacio(Dialogo.Fecha2) y Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar Fecha Hasta valida';NO;FSys
  Vehiculo1: 'Vehiculo'  ;;;;;;;;NO;VAR('VEHICULODE')
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)

ACT(a:FAC, 'Comisiones a Pagar')
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

IF NoVacio(Dialogo.Corredor1)
   ACT(a:FAC, 'Corredor : '~Dialogo.Corredor1)
ELSE
   ACT(a:FAC, 'Corredor : Todos')
ENDIF
ACT(a:FAC+1, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'F.Hasta: '~Dialogo.Fecha2)
ACT(c:FAC+2, 'Cotizacion USD: ')
ACN(d:FAC+2, Cotizacion('USD',,,,FSYS,1))
IF NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1)
ELSE
   ACT(a:FAC+3, 'Vehiculo : Todos')
ENDIF
SetFont(a:FAC..i:FAC+3, 2)

SetFilaActual(FAC+5)

ACT(a:FAC, 'Corredor')
ACT(b:FAC, 'Moneda')
ACT(c:FAC, 'Monto Comision')
ACT(d:FAC, 'Comision Pesos')
AgregarMarco(a:FAC..d:FAC,2,0,Exe('COLOR6'))


AlinearCeldas(a:FAC..B:FAC,'I')
AlinearCeldas(C:FAC..d:FAC,'D')
SetFont(a:FAC..i:FAC, 2)

ACN(M1,0)
ACN(P1,0)
ACN(Q1, Cotizacion('USD',,,,FSYS,1))
ACN(w1,FAC)

SQL.ADD("SELECT  Corredor, ContraEspecie, SUM(TotalComisiones) AS SAL ")
SQL.ADD("FROM    "~DBO~".OPERACIONES ")
SQL.ADD("WHERE   FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("        and ISNULL(Corredor,'')<>'' ")
IF NoVacio(Dialogo.Corredor1)
   SQL.ADD("     and Corredor = '"~Dialogo.Corredor1~"' ")
ENDIF
IF NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("     and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
ENDIF
SQL.ADD("GROUP BY Corredor, ContraEspecie ")
SQL.ADD("ORDER BY Corredor, ContraEspecie ")
Recorrer SQL
  IF Not EqStr(FBN['Corredor'], Val(N1))
     IF Val(M1)<>0
        ACT(c:FAC, 'Total Comisiones:')
        ACN(d:FAC,Val(O1))
        IFA
        ACT(C:FAC, 'IVA  :')
        ACN(d:FAC,Val(O1)*Var('IVA')/100)
        IFA 
        ACT(C:FAC, 'Total a Pagar:')
        ACN(d:FAC,Val(O1)*(1 + Var('IVA')/100))
        IFA
        IFA
     ELSE
        ACN(M1,1) 
     ENDIF
     ACT(N1,FBN['Corredor'])
     ACN(O1,0)
  ENDIF

  ACT(a:FAC, BuscarCampo('Corredores','Nombre','Codigo',FBN['Corredor']))
  ACT(b:FAC, FBN['Contraespecie'])
  ACN(c:FAC, FBN['SAL'])

  IF EqStr(FBN['Contraespecie'],'ARP')
     ACN(d:FAC, Val(c:FAC))
  ELSE
     ACN(d:FAC, Val(c:FAC)*Val(Q1))
  ENDIF
  
  SCN(O1,Val(D:FAC))
  SCN(P1,Val(D:FAC))
  SetFont(a:FAC..D:FAC,1)
Proximo

IF Val(M1)<>0
   IFA
   ACT(c:FAC, 'Total Comisiones:')
   ACN(d:FAC,Val(O1))
   IFA
   ACT(C:FAC, 'IVA  :')
   ACN(d:FAC,Val(O1)*Var('IVA')/100)
   IFA 
   ACT(C:FAC, 'Total a Pagar:')
   ACN(d:FAC,Val(O1)*(1 + Var('IVA')/100))
   AgregarMarco(a:Val(w1)+1..D:FAC,2,0)
   SetFont(a:Val(w1)+1..D:FAC,1)
ENDIF

SetFilaActual(FAC+2)
ACT(b:FAC, 'Total Comision en Pesos: ')
ACN(d:FAC, Val(P1)*(1 + Var('IVA')/100))
SetFont(b:FAC..d:FAC,2)

ACO(1,20)
ACO(2,10)
ACO(3,10)
ACO(4,10)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(e:FAC)
CrearFont(6,"Arial,6,B")
RangoTitulo(a:Val(w1)+1..e:FAC, 8)

