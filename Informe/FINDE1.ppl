CrearDialogo
  Fecha1     : "Fecha"             ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Invalida';NO;Fsys;
  Especie1   : "Especie"           ;;;
  TipoOp1    : "Tipo Op."          ;;;
  Cliente1   : "Entidad"           ;;;
  Check1     : "Capital"           ;1;2;;;;Dialogo.Check1 = 1 O Dialogo.Check2 = 1 O Dialogo.Check3 = 1;'Debe Seleccionar al menos Capital, Intereses O Impuestos';NO;1
  Check2     : "Interes"           ;;;;;;;;;1
  Check3     : "Impuestos"         ;;;;;;;;;1
  Radio4     : "Expresado|ARP|USD" ;5;1;;;;;;;0
  Radio2     : 'Expresado|Miles|Millones'     ;6;1;;;;;;;0
  Vehiculo1  : 'Vehiculo'          ;7;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

IF Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))
*    Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACO(1, 4)
ACO(2, 12)
ACO(3, 6)
ACO(4, 6)
ACO(5, 6)
ACO(6, 6)
ACO(7, 6)
ACO(8, 6)
ACO(9, 6)
ACO(10, 6)
ACO(11, 7)


ACD(FE:2, Dialogo.Fecha1)
ACD(FE:3, FinDeMes(SumarMeses(Fecha(Val(FE:2)), 5, 0), SI))
ACN(BD:1, 0)
ACN(BD:2, 0)
ACT(X:2, '')
ACN(CT:1, 0)
ACT(NR:1, '')

SetFilaActual(2)

ACT(B:fac, 'PAN AMERICAN ENERGY L.L.C')
SetFilaActual(fac+2)
IF Dialogo.Check1 = 1 Y Dialogo.Check2 = 1
    ***---Capital e Intereses
    ACT(E:fac, 'FINANCIAL DEBT')
ELSE
    IF Dialogo.Check1 = 1
        ***---Capital
        ACT(E:fac, 'REPAYMENTS')
    ELSE
        ***---Intereses O Impuestos
        ACT(E:fac, 'INTEREST EXPENSES')
    ENDIF
ENDIF
AgregarMarco(A:2..K:fac, 2, 0)
ifa
Recorrer&k 0, 5
    ACT(&k+5:fac, Copy(Meses(Mes(SumarMeses(Dialogo.Fecha1,&k))), 1, 3)~'-'~IIF(Mes(SumarMeses(Dialogo.Fecha1, &k)) >= Mes(Dialogo.Fecha1), Copy(Fstr(Anio(Dialogo.Fecha1), 0, 0), 3, 2), Copy(Fstr(Anio(Dialogo.Fecha1)+1, 0, 0), 3, 2)))
Proximo
ACT(K:fac, 'TOTAL')
AgregarMarco(B:fac..D:fac, 1, 0)
AgregarMarco(E:fac..L:fac, 1, 2)
IF Dialogo.Check1 = 1
    (.'FINDEB1'.)
ENDIF
IF Dialogo.Check2 = 1
    IF Dialogo.Check1 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'FINDEB2'.)
ENDIF
IF Dialogo.Check3 = 1
    IF Dialogo.Check1 = 1 O Dialogo.Check2 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'FINDEB3'.)
ENDIF

SQL.ADD(" Order By 1, 7, 5, 8 Desc, 10 ")
***---Al subir fila, queda en blanco la insertada
Recorrer SQL
    IF fbn('Importe') <> 0
*MessageBox('5')
        IF Val(BD:1) = 0 Y Val(BD:2) = 0
            ***---Primer Registro significativo
            ACT(B:fac, Mayusculas2(Dialogo.Vehiculo1))
            ifa
            ACT(B:fac, 'LONG TERM LOANS')
            ifa
            ACN(FI:1, fac)
        ENDIF
        IF fbn('Plazo') > 750
            IF Val(BD:1) = 0
                ***---Primer registro LONG TERM
                ACN(BD:1, 1)
            ELSE
                InsertarFila(Val(FI:1)+1)
                SCN(FI:1, 1)
                SCN(FI:2, 1)
                SCN(FI:3, 1)
            ENDIF
            IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
                ACT(NR:1, fbn('NrOperacion'))
                ACT(X:1, fbn('BD1'))
                ACT(X:2, fbn('DescImp'))
*MessageBox(Val(NR:1))
*MessageBox('1')
*MessageBox(Val(X:1))
*MessageBox(Val(X:2))
                SCN(CT:1, 1)
                ACN(A:Val(FI:1), Trunc(Val(CT:1)))
                ACT(B:Val(FI:1), fbn('Cliente1')~' '~Copy(fbn('Observaciones'), 1, 4))
                ACT(C:Val(FI:1), fbn('NrOperacion'))
                ACLO(C:Val(FI:1), fbn('NrOperacion'))
            ELSE
*MessageBox('2')
*MessageBox(Val(X:1))
*MessageBox(Val(X:2))
*MessageBox(fbn('BD1'))
*Cancelar
                IF [Eqstr(fbn('DescImp'), Val(X:2)) Y Eqstr(fbn('BD1'), 'Imp')] O [Not Eqstr(fbn('BD1'), 'Imp') Y Eqstr(Val(X:1), fbn('BD1'))]
                    ***---Escribo en fila anterior y subo una fila el informe
                    EliminarFila(Val(FI:1))
                    ACN(FI:1, Val(FI:1) - 1)
                    DFA
                ELSE
                    ACT(X:1, fbn('BD1'))
                    ACT(X:2, fbn('DescImp'))
                ENDIF
            ENDIF
            IF Eqstr(fbn('BD1'), 'Imp')
                ACT(D:Val(FI:1), fbn('DescImp'))
            ELSE
                ACT(D:Val(FI:1), fbn('BD1'))
            ENDIF
            ***---Determino columna del semestre
            Recorrer&k 0, 5
                IF Mes(fbn('Vto')) = Mes(SumarMeses(Dialogo.Fecha1, &k))
                    ACN(5+&k:Val(FI:1), fbn('Importe'))
                ENDIF
            Proximo
        ELSE
            IF Val(BD:2) = 0
                ***---Primer registro SHORT TERM
                ACT(B:fac, 'TRADE LOANS')
                ACN(BD:2, 1)
                ifa
                ACT(B:fac, 'Short Term')
                ifa
                ACN(FI:2, fac)
                ACN(FI:3, fac)
            ELSE
                SCN(FI:2, 1)
            ENDIF
            IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
                ACT(NR:1, fbn('NrOperacion'))
                ACT(X:3, fbn('BD1'))
                ACT(X:4, fbn('DescImp'))
                ACT(B:Val(FI:2), fbn('Cliente1')~' '~Copy(fbn('Observaciones'), 1, 4))
                ACT(C:Val(FI:2), fbn('NrOperacion'))
                ACLO(C:Val(FI:2), fbn('NrOperacion'))
*MessageBox(Val(NR:1))
*MessageBox(Val(FI:2))
            ELSE
                IF [Eqstr(fbn('DescImp'), Val(X:4)) Y Eqstr(fbn('BD1'), 'Imp')] O [Not Eqstr(fbn('BD1'), 'Imp') Y Eqstr(Val(X:3), fbn('BD1'))]
                    ***---Escribo en fila anterior y subo una linea el informe
                    EliminarFila(Val(FI:2))
                    ACN(FI:2, Val(FI:2) - 1)
                    DFA
                ELSE
                    ACT(X:3, fbn('BD1'))
                    ACT(X:4, fbn('DescImp'))
                ENDIF
            ENDIF
            IF Eqstr(fbn('BD1'), 'Imp')
                ACT(D:Val(FI:2), fbn('DescImp'))
            ELSE
                ACT(D:Val(FI:2), fbn('BD1'))
            ENDIF
            ***---Determino columna del semestre
            Recorrer&k 0, 5
                IF Mes(fbn('Vto')) = Mes(SumarMeses(Dialogo.Fecha1, &k))
                    ACN(5+&k:Val(FI:2), fbn('Importe'))
                ENDIF
            Proximo
        ENDIF
    ELSE
        DFA
    ENDIF
Proximo
***---Numero los registros Short Term
Recorrer&k Val(FI:3), Val(FI:2)
    IF Not CeldaVacia(C:&k)
        SCN(CT:1, 1)
        ACN(A:&k, Trunc(Val(CT:1)))
    ENDIF
Proximo
FormatoCeldas(A:8..A:Val(FI:2), Exe('F0'))

*LimitesVision(K:fac+1)