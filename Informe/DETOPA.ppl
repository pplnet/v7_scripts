ACN(T:FAC, Val(ta:2))
ACN(U:FAC, Val(ta:3))
ACN(W:FAC, Val(ta:4))
ACN(Y:FAC, Val(tg:2))
ACN(Z:FAC, Val(th:2))

*- PARA LINKEAR EN EL RESUMEN DE OPERACIONES FINANCIERAS
ACN(fo1, Val(o:fac))
ACN(fo2, Val(u:fac))

FormatoCeldas(E:Val(fi:1)..E:FAC, Exe('F2'))
FormatoCeldas(F:Val(fi:1)..G:FAC, Exe('F8'))
FormatoCeldas(N:Val(fi:1)..N:FAC, Exe('F8'))
FormatoCeldas(O:Val(fi:1)..O:FAC, Exe('F2'))
FormatoCeldas(H:Val(fi:1)..J:FAC, Exe('F2'))
FormatoCeldas(T:Val(fi:1)..W:FAC, Exe('F2'))
AlinearCeldas(k:Val(fi:1)..n:fac, 'C')
AlinearCeldas(p:Val(fi:1)..s:fac, 'C')
SetFont(A:FAC..ab:FAC, 9)

SetFilaActual(FAC+2)
ACT(A:FAC, 'TOTALES EN USD          Cotizacion: '~PYC(1/val(cu:1),0,6) )

ACN(H:FAC, Val(tb:2) * Val(cu:1))
ACN(I:FAC, Val(tb:3) * Val(cu:1))
ACN(J:FAC, Val(tb:4) * Val(cu:1))
