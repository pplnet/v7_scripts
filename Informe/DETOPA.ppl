CrearDialogo
   Fecha1     : "Fecha Desde"         ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, SI);
   Fecha2     : "Fecha Hasta"         ;1;2;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
   Radio4     : "Consolidado|NO|SI"   ;3;1;;;;;;;0
   Especie1   : "Moneda Oper."        ;4;2;;;;;;;Var('MONEEXTR');;LeerObjeto('Monedas');
   Vehiculo1  : "Vehiculo"            ;5;1;;
   Lista1     : "Lista Vehic"         ;6;1;;
   Lista2     : 'Especie'             ;;;
   Lista3     : 'Fuente'              ;;
   Lista4     : 'Precio'              ;;
   Especie2   : "Titulo"              ;1;1;;NO;NO;;;
FinDialogo
If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")
CrearFont(6,"Arial,8,BU")
CrearFont(7,"Century Gothic,8,B")
CrearFont(8,"Arial,7,")
CrearFont(9,"Arial,8,B")
CrearFont(10,"Arial,8,")

ACN(el:1, Elementos(Dialogo.Lista2))

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)

ACT(a:FAC, 'SITUACION PORTFOLIO DE BONOS')
AgregarMarco(a:FAC..e:FAC, 1, 0, EXE('COLOR6'))
SetFont(a:FAC, 3)
SetFilaActual(FAC+2)

ACT(a:FAC, 'Fecha Desde: '~Dialogo.Fecha1)
If Dialogo.Radio4 = 0
   ACT(d:FAC, 'NO Consolidado')
Else
   ACT(d:FAC, 'Consolidado')
Endif

IFA
ACT(a:FAC, 'Fecha Hasta: '~Dialogo.Fecha2)
If NoVacio(Dialogo.Vehiculo1)
   ACT(d:FAC, 'Vehiculo : '~Dialogo.Vehiculo1)
   ACT(ve1,Dialogo.Vehiculo1)
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(d:fac, 'Vehiculos : '~Dialogo.Lista1)
   ACT(ve1,Dialogo.Lista1)
Endif


SetFilaActual(FAC+2)
(.'ENCADETOPA'.)
SetFilaActual(FAC+2)

SQL.ADD("SELECT 2 Orden,'CUPON' NrOperacion,S.Especie,CONVERT(Char,S.Cupon) as Cupon,S.Fecha FechaVto, ' ' TipoOp, Sum(S.Saldo) Cantidad, ")
SQL.ADD("       0 Precio1, 0 Precio2, 0 TotalBrutoCli1, 0 TotalIntereses, 0 TotalNetoCli1, ")
SQL.ADD("       S.Fecha FechaOp, E.Nombre, S.Fecha Maduracion, E.SType TipoTasa, ")
SQL.ADD("       E.TasaIntVigente, E.InteresesC, Sum(S.Saldo) Saldo, 0 VTeorico,E.EsCupon,E.Alias4,S.EnteCustodia as Cliente1, E.Indice ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  S.NrSaldo = 1  ")
SQL.ADD("AND    E.EsCupon = 'SI' ")
If NoVacio(Dialogo.Especie2)
   SQL.ADD("       AND E.Codigo ='"~Dialogo.Especie2~"' ")
EndIf
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND ('"~Dialogo.Vehiculo1~"'=S.EnteCustodia OR '"~Dialogo.Vehiculo1~"'=S.Cliente ) ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND (S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") OR S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ) ")
Endif
SQL.ADD("       AND E.Codigo = S.Especie ")
SQL.ADD("       AND E.Cotiza = '"~Dialogo.Especie1~"' ")
SQL.ADD("       AND S.Saldo <> 0 ")
SQL.ADD("       AND S.Fecha IN (Select MAX(Fecha) from  "~DBO~".SALDOSDIA ")
SQL.ADD("       WHERE (Mercado = S.Mercado OR (Mercado IS NULL AND S.Mercado IS NULL) ) ")
SQL.ADD("       and  Cuenta       = S.Cuenta  ")
SQL.ADD("       and  Cliente      = S.Cliente ")
SQL.ADD("       and  Especie      = S.Especie ")
SQL.ADD("       and  Cupon        = S.Cupon   ")
SQL.ADD("       and  (EnteCustodia = S.EnteCustodia OR (EnteCustodia IS NULL AND S.EnteCustodia IS NULL) ) ")
SQL.ADD("       and  NrSaldo      = S.NrSaldo ")
SQL.ADD("       and  Fecha       <= "~IdxDate2(Dialogo.Fecha2)~") ")
SQL.ADD("GROUP BY S.Especie, S.Fecha, S.Fecha, E.Nombre, S.Fecha, E.SType, ")
SQL.ADD("       E.TasaIntVigente, E.InteresesC,S.Cupon,E.EsCupon,E.Alias4,S.EnteCustodia, E.Indice ")
SQL.ADD("HAVING Sum(S.Saldo) <> 0 ")
SQL.ADD(" UNION ")
SQL.ADD("SELECT 3 Orden,O.NrOperacion, O.Especie,Convert(Char,E.Cupon) as Cupon,O.FechaVto, O.TipoOp, O.Cantidad, O.Precio1, O.Precio2, ")
SQL.ADD("       O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.FechaOp, E.Nombre, ")
SQL.ADD("       E.Fecha Maduracion, E.SType TipoTasa, E.TasaIntVigente, E.InteresesC, 0 Saldo, E.VTeorico,E.EsCupon,E.Alias4,O.Cliente1, E.Indice ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  O.ContraEspecie = '"~Dialogo.Especie1~"' ")
SQL.ADD("       AND O.Especie = E.Codigo ")
SQL.ADD("       AND O.TipoOp In ('SECS','SECSV','SECT','SECTV','SEVS','SEVSV','SEVT','SEVTV') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("       AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Especie2)
   SQL.ADD("       AND O.Especie ='"~Dialogo.Especie2~"' ")
EndIf
SQL.ADD("       AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" UNION ")
SQL.ADD("SELECT 1 Orden,'SINI' NrOperacion, S.Especie,Convert(Char,E.Cupon) as Cupon,'' FechaVto, ' ' TipoOp, 0 Cantidad, ")
SQL.ADD("       0 Precio1, 0 Precio2, 0 TotalBrutoCli1, 0 TotalIntereses, 0 TotalNetoCli1, ")
SQL.ADD("       '' FechaOp, E.Nombre, '' Maduracion, E.SType TipoTasa, ")
SQL.ADD("       E.TasaIntVigente, E.InteresesC, Sum(S.Saldo) Saldo, 0 VTeorico,E.EsCupon,E.Alias4,S.Cliente as Cliente1, E.Indice ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  S.NrSaldo = 3 ")
SQL.ADD("AND    E.Cotiza = '"~Dialogo.Especie1~"' ")
If NoVacio(Dialogo.Especie2)
   SQL.ADD("       AND E.Codigo ='"~Dialogo.Especie2~"' ")
EndIf
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("       AND S.Cliente = '"~Dialogo.Vehiculo1~"' ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD("       AND E.Codigo = S.Especie ")
SQL.ADD("       AND S.Saldo <> 0 ")
SQL.ADD("       AND S.Fecha = (SELECT Max(D.Fecha) FROM "~DBO~".SALDOSDIA D ")
SQL.ADD("                      WHERE  D.Cliente = S.Cliente ")
SQL.ADD("                             AND D.Especie = S.Especie ")
SQL.ADD("                             AND D.NrSaldo = S.NrSaldo ")
SQL.ADD("                             AND D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("GROUP BY S.Precio1,S.Precio2, S.Especie, E.Nombre, E.InteresesC,E.SType,E.TasaIntVigente,E.Cupon,E.EsCupon,E.Alias4,S.Cliente, E.Indice ")
SQL.ADD("ORDER BY 3,18 Desc,1,13,6 ")

ACT(es:1, '')
ACT(es:2, '')
ACN(fi:1, FAC+1)
ACN(fi:3, FAC+1)

Recorrer&k 1, 9
   ACN(te:&k, 0)
   ACN(tb:&k, 0)
   ACN(ta:&k, 0)
   ACN(tf:&k, 0)
   ACN(tg:&k, 0)
   ACN(th:&k, 0)
Proximo

*- Acumuladores
ACN(bd:1, 0)
ACN(bd:2, 0)
ACN(bd:3, 0)
ACN(cu2, 0)

Recorrer SQL
   *- Corte por Especie
   ACT(IN:3, fbn('Indice'))
   If Not Eqstr(FBN['Especie']~' '~Fstr(FBN['Cupon'],0,0)~' '~FBN['Alias4'], Val(es:1)) Y Not CeldaVacia(es:1)
      InsertarFila(Val(tc:1))
      ACT(a:Val(tc:1), Mayusculas2(Copy(Val(es:2), 1, 14)))
      ACT(b:Val(tc:1), Val(es:5) )
      ACT(c:Val(tc:1), Mayusculas2(Copy(Val(ft:1), 1, 30)))
      ACN(d:Val(tc:1), Val(ct:1))

      SCN(tc:1, 1)
      SCN(fi:1, 1)
      IFA

      *- Si tiene Indice y el indice incluido en el precio
      If NoVacio(val(in3)) 
         ACN(in4,0)
         Recorrer&i val(ti:2),val(ti:1)
            If EqStr(val(g:&i),val(in3))
               ACN(in4,1)
               Break
            EndIf
         Proximo
         If val(in4)=0
            ACT(g:Val(ti:1), Val(in:3))
            ACT(h:Val(ti:1), Mayusculas2(Copy(Val(in2), 1, 30)) )
            ACT(i:Val(ti:1), Val(in:1))
            SCN(ti:1, 1)
         EndIf
      EndIf

      *- Impresion de Subtotales por cambio de especie
      ACT(a:FAC, 'Subtotal  '~Val(es:1))

      ACN(e:FAC, Val(te:1))
      ACN(h:FAC, Val(te:2))
      ACN(i:FAC, Val(te:3))
      ACN(j:FAC, Val(te:4))
      ACN(o:FAC, Val(tf:1))
      ACN(t:FAC, Val(tf:2))
      ACN(u:FAC, Val(tf:3))
      ACN(v:FAC, Val(tf:5))
      ACN(w:FAC, Val(tf:4))
      ACN(y:FAC, Val(tg:1))
      ACN(z:FAC, Val(th:1))

      *- Obtengo el Promedio de las compras 
      ACN(sl1,val(e:fac))
      ACD(fp1,Dialogo.Fecha2+1)
      (.'FIFOTITU'.)      
      ACN(f:fac,val(bc1)/val(ba1))

      If val(cu2)<>0
         *- Precio Para Cupones
         ACN(f:fac,val(cu2))
         ACN(cu2, 0)  
      EndIf
      *- Traslado los VResiduales g: V.Residual de Compra/Venta (Muestro el Ultimo de la Operacion) n:V.R. Actual
      ACN(g:fac, val(vr1))
      ACN(n:fac, val(vr2))
      ACD(p:fac, val(fc1))
      ACD(q:fac, val(fc2))
      ACT(r:fac, val(tt1))
      ACT(s:fac, val(tt2))

      Recorrer&k 1, 4
         SCN(tb:&k, Val(te:&k))
         SCN(ta:&k, Val(tf:&k))
         ACN(te:&k, 0)
         ACN(tf:&k, 0)
      Proximo

      SCN(tg:2, val(tg:1))
      SCN(th:2, val(th:1))

      ACN(tg:1,0) 
      ACN(th:1,0)

      ACD(fc1,0)
      ACD(fc2,0)
      ACT(tt1,' ')
      ACT(tt2,' ')

      ACN(BD:2, 0)
      ACN(BD:3, 0)

      *- ad: Obtengo el resultado por indice
      ACN(ad:fac,Sum(ad:val(bd1)..ad:fac-1)-Sum(bz:val(bd1)..bz:fac-1))
      IFA
   Endif
 
   If Not Eqstr(FBN['Especie']~' '~Fstr(FBN['Cupon'],0,0)~' '~FBN['Alias4'], Val(es:1)) 
      *- Corte por Especie => Inicializo variables + INDICES
      ACN(bd:1, fac)
      ACT(es:1, FBN['Especie'])
      ACT(es:2, FBN['Nombre'])
      Recorrer&j 1, Val(el:1)
         If Eqstr(Val(es:1), ItemLista(Dialogo.Lista2, &j))
            ACN(ct:1, Num(ItemLista(Dialogo.Lista4, &j)))
            ACT(ft:1, ItemLista(Dialogo.Lista3, &j))
         Endif
      Proximo
   
      ACT(es:1, FBN['Especie']~' '~Fstr(FBN['Cupon'],0,0)~' '~FBN['Alias4'])
      ACT(es:5, FBN['Especie']~' '~Fstr(FBN['Cupon'],0,0))
      ACT(es3,FBN('Especie'))
      ACT(es4,FBN('EsCupon'))
      ACT(cc1,Fstr(NrCupon2(FBN['Especie'],Fsys),0,0))
      
      ACN(in1,0)
      ACT(in2,'')
      ACT(in3,'')

      *- Verifico si tiene indice
      SQL.ADD("SELECT E.Indice,E.IndiceEnPrecio  ")
      SQL.ADD("FROM "~DBO~".ESPECIES E WHERE Indice IS NOT NULL ")
      SQL.ADD("and E.Codigo = '"~val(es3)~"'  ")
      SQL.ADD("ORDER BY 1")

      Recorrer SQL
          dfa
          ACT(in3,FBN['Indice'])
          ACT(in5,FBN['IndiceEnPrecio'])
          ACT(ad:fac,FBN['Indice'])

          *- Busco la cotizacion del INDICE del dia 
          Recorrer&j 1, Val(el:1)
              If Eqstr(val(in3), ItemLista(Dialogo.Lista2, &j))
                 *- in1: Cotizacion in2: Fuente
                 ACN(in:1, Num(ItemLista(Dialogo.Lista4, &j)))
                 ACT(in:2, ItemLista(Dialogo.Lista3, &j))
                 Break
              Endif
          Proximo
      Proximo
   EndIf

   SCN(bd:2, 1)

   If Not Incluido(FBN['NrOperacion'],'CUPON|SINI')
      *- Detalle de la operacion
      SCN(bd:3, 1)
      If Val(bd:2) = 1
         *- Primer registro para la especie Registro de Operaciones
         ACT(a:FAC, 'Saldo Inicial')
         ACN(w:FAC, 0)
         ACN(y:FAC, 0)
         ACN(z:FAC, 0)
         Recorrer&k 1, 4
            ACN(te:&k, 0)
            ACN(tf:&k, 0)
         Proximo
         IFA
      Endif
        
      If Val(bd:3) = 1
         ***---Primer Registro de Operaciones
         ACT(a:FAC, Mayusculas2(Copy(FBN['Nombre'], 1, 16))~' '~FBN['Especie'])
         ACN(vt:1, ValorTeorico2(FBN['Especie'],FSys)*100)
      Endif

      ACT(b:FAC, Pad0(Fstr(Dia(FBN['Maduracion']), 0, 0), 2)~'/'~Pad0(Fstr(Mes(FBN['Maduracion']), 0, 0), 2)~'/'~Copy(Fstr(Anio(FBN['Maduracion']), 0, 0), 3, 2))
      ACT(c:FAC, FBN['NrOperacion'])
      ACLO(c:FAC, FBN['NrOperacion'])
 
      If Incluido(FBN['TipoOp'], 'SECS|SECSV|SECT|SECTV')
         ACT(d:FAC, 'Compra')
         ACN(sg:1, 1)
         *- ae: Remanente de la Compra
         ACN(ae:FAC,FBN['Cantidad'] )
      Else 
         ACT(d:FAC, 'Venta')
         ACN(sg:1, -1)
      Endif
    
      *- e: Valor Nominal f: Precio g: Valor Residual h: Inversion Original
      ACN(e:FAC, FBN['Cantidad']*Val(sg:1))        
      SCN(te:1, Val(e:fac))
      ACN(f:FAC, FBN['Precio1'])
      ACN(g:FAC, ValorTeorico2(FBN['Especie'],FBN['FechaVto'])*100)
      SCN(te:7, Val(g:FAC))    
      ACN(h:FAC, FBN['TotalBrutoCli1']*Val(sg:1))
      SCN(te:2, Val(h:FAC))

      *- C.Corrido Pagado Compra
      ACN(i:FAC, FBN['TotalIntereses']*Val(sg:1))
      SCN(te:3, Val(i:FAC))
    
      *- Egresos
      ACN(j:FAC, Val(h:FAC)+Val(i:FAC))
      SCN(te:4, Val(j:FAC))
   
      ACT(k:FAC, FBN['FechaOp'])
      ACT(l:FAC, FBN['FechaVto'])
      ACN(n:FAC, Val(vt:1))
      ACN(o:FAC, (VAL(e:fac)*IIf(EqStr(FBN['InteresesC'],'CLE'),val(n:fac)/100,1)*Val(ct:1)))
*MessageBox(Val(N:fac))
*MessageBox(Val(O:fac))
*MessageBox(Val(CT:1))
      ACD(uc:1, UltCupon2(FBN['Especie'], Fsys)) 
      ACD(pc:1, ProxCupon2(FBN['Especie'], Fsys))
      If val(uc:1) = val(pc:1)
         ACD(uc:1, UltCupon2(FBN['Especie'], Fsys-1))      
      EndIf
      ACD(p:FAC, Val(uc:1))
      ACD(q:FAC, Val(PC:1))
      ACT(r:FAC, FBN['TipoTasa'])
      ACT(s:FAC, Fstr(FBN['TasaIntVigente']*100, 0, 5))

      *- Intereses Totales y Devengados
      ACN(t:FAC, 0)
      ACN(u:FAC, 0)
  
      IF Eqstr(FBN['InteresesC'], 'CLE') y val(q:fac)<>0
         LinkearHoja('INTESP',1,Fecha1=val(q:fac),Cantidad1=FBN['Cantidad'],Lista1=FBN['Especie']~'|',Check1=0)
         ACN(t:FAC,Linkh(1,z1))

         LinkearHoja('INTESP',2,Fecha1=Dialogo.Fecha2+1,Cantidad1=FBN['Cantidad'],Lista1=FBN['Especie']~'|',Check1=0)
         ACN(u:FAC,Linkh(2,z1))
         *CerrarHoja('INTESP',1,Fecha1=val(q:fac),Cantidad1=FBN['Cantidad'],Lista1=FBN['Especie']~'|',Check1=0)
         *CerrarHoja('INTESP',2,Fecha1=Dialogo.Fecha2+1,Cantidad1=FBN['Cantidad'],Lista1=FBN['Especie']~'|',Check1=0)
      EndIf

      *- Variaciones por Indice
      (.'IDXTITU'.)

      SCN(tf:1, Val(o:FAC))
      SCN(tf:2, Val(t:FAC))
      SCN(tf:3, Val(u:FAC))

      *- V.Residual para la ultima linea de subtotales
      ACN(vr1, val(g:fac))
      ACN(vr2, val(n:fac))
      ACD(fc1, val(p:fac))
      ACD(fc2, val(q:fac))
      ACT(tt1, val(r:fac))
      ACT(tt2, val(s:fac))

      If val(sg1)=-1
         ACN(sl1,-FBN['Cantidad'])
         (.'INVORITITU'.)         
      Endif

      *- Para linkear desde CONTABILIDAD
      ACT(EX:fac, fbn('Especie'))
      ACT(EC:fac, fbn('Cliente1'))
      ACN(EP:fac, 0)
      ACT(EI:fac, Dialogo.Especie1)
      ACN(ED:fac, 0)
      ACD(EF:fac, fbn('FechaOp'))
      ACT(EG:fac, '')
      ACN(EH:fac, val(ad:fac))
   Else
      *- Registro con Saldo Inicial 
      ACN(cc:1, CotizacionC(FBN['Especie'],,,,Habiles(Dialogo.Fecha1,-1,'ARG',SI),1,SI,Dialogo.Especie1))

      If Incluido(FBN['NrOperacion'],'CUPON') 
         *- Saldo de Cupon
         If Val(bd:2) > 1
            *- Tiene Saldo Inicial => Decremento fila
            DFA
         Else 
            ACT(a:FAC, 'Saldo Inicial')
            ACN(w:FAC, 0)
         Endif  
    
         ACT(a:FAC, Mayusculas2(Copy(FBN['Nombre'], 1, 16))~' '~FBN['Especie'])
     
         ACN(e:FAC, FBN['Cantidad'])
         SCN(te1, Val(e:fac))

         *- Renta/amortizacion
         ACN(f:FAC, 0)
         ACT(pa1,Padre(ESPECIES,FBN['Especie']))
         ACT(cu1,FBN['Cupon'])

         *- Cupon de Renta y Amortizacion
         SQL.ADD(" SELECT A.IntsCapitalizados,A.PorRenta Precio,'Renta' as Tipo,FechaPago ") 
         SQL.ADD(" FROM "~DBO~".AGENDACUPONES A ")
         SQL.ADD(" WHERE  A.Especie = '"~val(pa1)~"' and A.NrCupon='"~val(cu1)~"' ")
         SQL.ADD(" and A.PorRenta<>0  ")
         SQL.ADD(" Union All ")
         SQL.ADD(" SELECT A.IntsCapitalizados,A.PorAmCapital Precio,'Amortizacion' as Tipo,FechaPago ") 
         SQL.ADD(" FROM "~DBO~".AGENDACUPONES  A ")
         SQL.ADD(" WHERE  A.Especie = '"~val(pa1)~"' and A.NrCupon='"~val(cu1)~"' ")
         SQL.ADD(" and A.PorAmCapital<>0  ")       
         ACN(fo1,fac)
         ACD(fp1,FBN['FechaOp'])

         Recorrer SQL
            dfa
            ACN(in2,1)
            ACT(d:FAC, FBN['Tipo'])       
            If Not EqStr(FBN['Tipo'],'Amortizacion') y NoVacio(val(ad:val(bd1)))
               SQL.ADD("SELECT Cambio3 FROM "~DBO~".TRANSACCIONES2 WHERE 'CUPON'=TipoTr2 AND '"~val(pa1)~"'=Especie and '"~val(cu1)~"'=Cupon1 ")
               Recorrer SQL
                  dfa
                  ACN(in2,FBN['Cambio3'])      
               Proximo
            EndIf           

            ACN(f:FAC, FBN['Precio']/100)                  
            ACN(g:FAC, 100)                  
            ACN(h:FAC, val(f:fac)*val(e:val(fo1)))        
            ACD(k:FAC, val(fp1))        
            ACD(l:FAC, FBN['FechaPago'])   
            ACN(n:FAC, 100)                       
            *- A la valuacion del cupon se multiplica el precio del cupon
            ACN(o:FAC, val(e:FAC)*Val(ct:1)*val(in2)*val(f:fac))                       
            ACN(w:FAC, val(o:FAC))                       
***---MessageBox(Val(O:fac)~' xx')
            SCN(te:2, Val(h:FAC))
            SCN(tf:1, Val(o:FAC))
            SCN(tf:4, Val(w:FAC))

            *- V.Residual para la ultima linea de subtotales
            ACN(vr1, val(g:fac))
            ACN(vr2, val(n:fac))
            ACT(tt1, val(r:fac))
            ACN(cu2, val(f:fac))
            ifa
         Proximo  
      Else
         *- Saldo Inicial
         *- Para Saldo Inicial calculo los valores
         ACT(a:FAC, 'Saldo Inicial')
         ACN(vt:1, ValorTeorico2(FBN['Especie'],Dialogo.Fecha1)*100)
      
         *- Valor Nominal 
         ACN(e:FAC, FBN['Saldo'])
         SCN(te:1, Val(e:fac))
     
         *- Valor Residual
         ACN(g:FAC, Val(vt:1))
         ACN(te:7, FBN['Saldo']*Val(vt:1))

         ACN(VT:2, ValorTeorico2(FBN('Especie'),FSys)*100)    
        
         *- C.Corrido Pagado Compra
         ACN(i:FAC, 0)

         ACN(sl1,val(e:fac))
         ACD(fp1,Dialogo.Fecha1)
         (.'FIFOTITU'.)      

         ACN(f:fac,val(bc1)/val(ba1))
         IF Eqstr(FBN['InteresesC'], 'CLE')
            ACN(i:FAC, val(bb1))
         EndIf
         SCN(te:3, Val(i:FAC))

         *- h:Inv.Original j: Egresos n: Valor Residual o: Valor de Mercado p:Fecha Inicio Cupon q:Fecha Inicio Cupon r/s Tasa: Tipo y %
         ACN(h:FAC, val(e:fac)*val(f:fac)*IIF(Eqstr(FBN['InteresesC'],'CLE'),val(g:fac)/100,1) )
         SCN(te:2, Val(h:FAC) )
         ACN(j:FAC, Val(h:FAC)+Val(i:FAC))
         SCN(te:4, Val(h:FAc)+Val(i:FAC))     
         ACN(n:FAC, Val(vt:2))   
         ACN(o:FAC, (Val(e:FAC)*IIf(EqStr(FBN['InteresesC'],'CLE'),Val(n:FAC)/100,1)*Val(ct:1)))
         ACD(uc:1, UltCupon2(FBN['Especie'], Fsys))
         ACD(pc:1, ProxCupon2(FBN['Especie'], Fsys))
         If val(uc:1) = val(pc:1)
            ACD(uc:1, UltCupon2(FBN['Especie'], Fsys-1))      
         EndIf
         ACD(p:FAC, Val(uc:1))
         ACD(q:FAC, Val(pc:1))  
         ACT(r:FAC, FBN['TipoTasa'])
         ACT(s:FAC, Fstr(FBN['TasaIntVigente']*100, 0, 5))

         *- Intereses: Totales y Devengados
         ACN(t:FAC, 0)
         ACN(u:FAC, 0)
      
         IF Eqstr(FBN['InteresesC'], 'CLE') y val(q:fac)<>0
            LinkearHoja('INTESP',1,Fecha1=val(q:fac),Cantidad1=FBN['Saldo'],Lista1=FBN['Especie']~'|',Check1=0)
            ACN(t:FAC,Linkh(1,z1))

            LinkearHoja('INTESP',2,Fecha1=Dialogo.Fecha2+1,Cantidad1=FBN['Saldo'],Lista1=FBN['Especie']~'|',Check1=0)
            ACN(u:FAC,Linkh(2,z1))
         EndIf

         *- Variaciones por Indice
         (.'IDXTITU'.)

         *- V.Residual para la ultima linea de subtotales
         ACN(vr1, val(g:fac))
         ACN(vr2, val(n:fac))
         ACD(fc1, val(p:fac))
         ACD(fc2, val(q:fac))
         ACT(tt1, val(r:fac))
         ACT(tt2, val(s:fac))

         SCN(tf:1, Val(o:FAC))      
         SCN(tf:2, val(t:fac))
         SCN(tf:3, val(u:fac))    
      Endif
   Endif

   *- Capital ExCupon
   *- A partir de la fecha que se actualiza la especie (72 hs. antes del corte) me tiene que mostrar el cupon de capital
   *- que va a pagar. Una vez que lo pago no lo muestra y este valor pasa a acumularce en cupones recibidos capital (y)
   ACN(nc1,NrCupon2(FBN['Especie'],Fsys))

   SQL.ADD(" SELECT A.Estado,A.PorAmCapital,A.PorRenta,A.FechaPago,A.IntsCapitalizados  FROM "~DBO~".AGENDACUPONES A Where ")
   SQL.ADD(" A.Especie = '"~FBN['Especie']~"' AND A.NrCupon In ('"~FSTR(Val(nc1),0,0)~"','"~FSTR(Val(nc1)-1,0,0)~"') AND ")
   SQL.ADD(" Not Exists  ")
   SQL.ADD(" (SELECT T.NrTrans ")
   SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T ")
   SQL.ADD(" WHERE  T.TipoTr2 IN ('PCUPON', 'CCUPON') ")
   SQL.ADD(" and    T.Especie   = '"~BuscarCampo('ESPECIES','Alias3','Codigo',FBN['Especie'])~"' and T.Cupon1=A.NrCupon  ")
   If NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   EndIf
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD(")")

   Recorrer SQL
      dfa
      IF EqStr(FBN['Estado'],'PRO') 
         *- Se actualizo la especie y no se pago
         ACN(v:FAC, val(e:fac)*(FBN['PorAmCapital']/100)*FBN['IntsCapitalizados'])
         SCN(tf:5, Val(v:FAC))
      EndIf 
   Proximo  
   
   *- Stock: 
   ACN(w:FAC, Val(o:FAC)+Val(u:FAC)+Val(v:FAC))

   If val(sg:1)=1
      *- No calculo el resultado por las vtas porque esta neteado en la bz:
      ACN(ad:fac,val(w:fac)-(val(w:fac)/val(ac:fac)))
   EndIf
   IF Not Eqstr(fbn('Especie'), Val(ES:87))
       SQL.ADD(" SELECT Sum(Cantidad5) as TotalRenta,Sum(Cantidad6) as TotalAmor,TipoTr2 ")
       SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 ")
       SQL.ADD(" WHERE  TipoTr2 IN ('PCUPON', 'CCUPON') ")
       SQL.ADD(" AND    Especie   = '"~BuscarCampo('ESPECIES','Alias3','Codigo',FBN['Especie'])~"'")
       If NoVacio(Dialogo.Vehiculo1)
          SQL.ADD("       AND Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
       EndIf
       If NoVacio(Dialogo.Lista1)
          SQL.ADD(" AND Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
       Endif
       SQL.ADD(" Group By TipoTr2")
       Recorrer SQL
           dfa
           ***---Tiene que salir solo en el total, sino lo suma n veces. Ver de buscar otra variable para y:fac+500
           ***---SCN(y:FAC,IIF(EqStr(FBN['TipoTr2'],'CCUPON'),1,-1)*FBN['TotalAmor'])
           ***---SCN(z:FAC,IIF(EqStr(FBN['TipoTr2'],'CCUPON'),1,-1)*FBN['TotalRenta'])
           SCN(y:FAC+500,IIF(EqStr(FBN['TipoTr2'],'CCUPON'),1,-1)*FBN['TotalAmor'])
           SCN(z:FAC+500,IIF(EqStr(FBN['TipoTr2'],'CCUPON'),1,-1)*FBN['TotalRenta'])
           SCN(tg1, Val(y:fac+500))
           SCN(th1, Val(z:fac+500))
       Proximo  
   ENDIF
   ACT(ES:87, fbn('Especie'))
   SCN(tf:4, Val(w:FAC))
Proximo

IF Val(bd:1) > 0
   InsertarFila(Val(tc:1))
   ACT(a:Val(tc:1), Mayusculas2(Copy(Val(es:2), 1, 14)) )
   ACT(b:Val(tc:1), Val(es:5))
   ACT(c:Val(tc:1), Mayusculas2(Copy(Val(ft:1), 1, 30)) )
   ACN(d:Val(tc:1), Val(ct:1))
   AgregarMarco(a:Val(tc:2)..e:Val(tc:1), 1, 0)
   SetFont(a:Val(tc:2)..d:Val(tc:1), 1)
   FormatoCeldas(d:Val(tc:2)..d:Val(tc:1), Exe('F8'))
   SCN(tc:1, 1)
   SCN(fi:1, 1)

   *- Si tiene Indice
   If NoVacio(val(in3)) 
      ACN(in4,0)
      Recorrer&i val(ti:2),val(ti:1)
        If EqStr(val(g:&i),val(in3))
           ACN(in4,1)
           Break
        EndIf
      Proximo
      If val(in4)=0
         ACT(g:Val(ti:1), Val(in:3))
         ACT(h:Val(ti:1), Mayusculas2(Copy(Val(in2), 1, 30)) )
         ACT(i:Val(ti:1), Val(in:1))
         SCN(ti:1, 1)
      EndIf
   EndIf

   AgregarMarco(g:Val(ti:2)..i:Val(ti:1), 1, 0)
   SetFont(g:Val(ti:2)..i:Val(ti:1), 1)

   FormatoCeldas(a:Val(ti:2)..i:Val(ti:1), Exe('F8'))
   ACN(fi:2, Val(fi:1))
   SetFont(a:Val(tc1)+3..ab:fac+2, 10)

   ifa
   Recorrer&k Val(fi:1), FAC
      IF Eqstr(Copy(Val(a:&k), 1, 8), 'Subtotal')
         AgregarMarco(a:Val(fi:2)..b:&k-1, 1, 0)
         AgregarMarco(c:Val(fi:2)..m:&k-1, 1, 0)
         AgregarMarco(m:Val(fi:2)..m:&k-1, 1, 0)
         AgregarMarco(N:Val(fi:2)..w:&k-1, 1, 0)
         AgregarMarco(w:Val(fi:2)..x:&k-1, 1, 0)
         AgregarMarco(y:Val(fi:2)..z:&k-1, 1, 2)
         AgregarMarco(aa:Val(fi:2)..ab:&k-1, 1, 0)
         AgregarMarco(a:&k..b:&k, 1, 0)
         AgregarMarco(c:&k..m:&k, 1, 0)
         AgregarMarco(m:&k..m:&k, 1, 0)
         AgregarMarco(n:&k..w:&k, 1, 0)
         AgregarMarco(w:&k..x:&k, 1, 0)
         AgregarMarco(aa:&k..ab:&k, 1, 0)
         AgregarMarco(y:&k..z:&k, 1, 2)
         SetFont(a:Val(fi:2)..ab:&k-1, 10)
         SetFont(a:&k..ab:&k, 9)
         ACN(fi:2, &k+1)
      ENDIF
   Proximo
   AgregarMarco(a:Val(fi:2)..b:FAC, 1, 0)
   AgregarMarco(a:Val(fi:2)..m:FAC, 1, 0)
   AgregarMarco(m:Val(fi:2)..m:FAC, 1, 0)
   AgregarMarco(n:Val(fi:2)..w:FAC, 1, 0)
   AgregarMarco(w:Val(fi:2)..x:FAC, 1, 0)
   AgregarMarco(aa:Val(fi:2)..ab:FAC, 1, 0)
   AgregarMarco(y:Val(fi:2)..z:FAC, 1, 2)
ENDIF
*---Marcos del Titulo porque el insertar fila no los baja
AgregarMarco(a:Val(tc:1)+3..e:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(f:Val(tc:1)+3..g:Val(tc:1)+3, 1, 0, Exe('COLOR6'))
AgregarMarco(f:Val(tc:1)+4..g:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(h:Val(tc:1)+3..q:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(r:Val(tc:1)+3..s:Val(tc:1)+3, 1, 0, Exe('COLOR6'))
AgregarMarco(r:Val(tc:1)+4..s:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(t:Val(tc:1)+3..x:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(y:Val(tc:1)+3..z:Val(tc:1)+4, 1, 1, Exe('COLOR6'))
AgregarMarco(y:Val(tc:1)+5..z:Val(tc:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(aa:Val(tc:1)+3..ab:Val(tc:1)+5, 1, 2, Exe('COLOR6'))

SetFont(a:Val(tc:1)+3..ab:Val(tc:1)+5, 9)
AlinearCeldas(a:Val(tc:1)+3..q:Val(tc:1)+5, 'C')
AlinearCeldas(r:Val(tc:1)+3..r:Val(tc:1)+3, 'I')
AlinearCeldas(r:Val(tc:1)+4..r:Val(tc:1)+4, 'C')
AlinearCeldas(s:Val(tc:1)+3..ab:Val(tc:1)+5, 'C')
FormatoCeldas(f:Val(fi:1)..g:FAC, Exe('F8'))
FormatoCeldas(n:Val(fi:1)..n:FAC, Exe('F8'))
FormatoCeldas(o:Val(fi:1)..o:FAC, Exe('F2'))
FormatoCeldas(e:Val(fi:1)..e:FAC, Exe('F2'))
FormatoCeldas(h:Val(fi:1)..j:FAC, Exe('F2'))
FormatoCeldas(t:Val(fi:1)..w:FAC, Exe('F2'))

IF Eqstr(Dialogo.Especie1, Var('MONEEXTR'))
   ACN(cu:1, 1)
ELSE
   ACN(cu:1, CotizacionC(Dialogo.Especie1,,,, Dialogo.Fecha2, 1, SI, Var('MONEEXTR')))
ENDIF

IFA
ACT(a:FAC, 'Subtotal  '~Val(es:1))

ACN(e:FAC, Val(te:1))
ACN(h:FAC, Val(te:2))
ACN(i:FAC, Val(te:3))
ACN(j:FAC, Val(te:4))
ACN(t:FAC, Val(tf:2))
ACN(u:FAC, Val(tf:3))
ACN(o:FAC, Val(tf:1))
ACN(v:FAC, Val(tf:5))
ACN(w:FAC, Val(tf:4))
ACN(y:FAC, Val(tg:1))
ACN(z:FAC, Val(th:1))

SCN(tg:2, val(tg:1))
SCN(th:2, val(th:1))

*- Traslado los VResiduales
*- g: V.Residual de Compra/Venta (Muestro el Ultimo de la Operacion) n:V.R. Actual
ACN(g:fac, val(vr1))
ACN(n:fac, val(vr2))
ACD(p:fac, val(fc1))
ACD(q:fac, val(fc2))
ACT(r:fac, val(tt1))
ACT(s:fac, val(tt2))

*- Obtengo el Promedio de las compras 
ACN(sl1,val(e:fac))
ACD(fp1,Dialogo.Fecha2+1)
(.'FIFOTITU'.)      
ACN(f:fac,val(bc1)/val(ba1))
If val(cu2)<>0
   *- Precio Para Cupones
   ACN(f:fac,val(cu2))
   ACN(cu2, 0)  
EndIf

*- ad: Obtengo el resultado por indice Total
ACN(ad:fac,Sum(ad:val(bd1)..ad:fac-1)-Sum(bz:val(bd1)..bz:fac-1))

*- Resultado de Titulos para linkear desde la contabilidad
ACN(rt1,val(ad:fac))

FormatoCeldas(e:Val(fi:1)..e:FAC, Exe('F2'))
FormatoCeldas(f:Val(fi:1)..g:FAC, Exe('F8'))
FormatoCeldas(n:Val(fi:1)..n:FAC, Exe('F8'))
FormatoCeldas(o:Val(fi:1)..o:FAC, Exe('F2'))
FormatoCeldas(h:Val(fi:1)..j:FAC, Exe('F2'))
FormatoCeldas(t:Val(fi:1)..w:FAC, Exe('F2'))
Recorrer&k 1, 4
   SCN(tb:&k, Val(te:&k))
   SCN(ta:&k, Val(tf:&k))
Proximo

SetFont(A:FAC..ab:FAC, 9)

AgregarMarco(a:FAC..b:FAC, 1, 0)
AgregarMarco(c:FAC..m:FAC, 1, 0)
AgregarMarco(m:FAC..m:FAC, 1, 0)
AgregarMarco(n:FAC..w:FAC, 1, 0)
AgregarMarco(w:FAC..x:FAC, 1, 0)
AgregarMarco(y:FAC..ab:FAC, 1, 2)
ACN(fi:2, FAC)

SetFilaActual(FAC+2)
ACT(A:FAC, 'Subtotal BONOS en '~Dialogo.Especie1)
AgregarMarco(a:Val(fi:2)..b:FAC-1, 1, 0)
AgregarMarco(c:Val(fi:2)..m:FAC-1, 1, 0)
AgregarMarco(m:Val(fi:2)..m:FAC-1, 1, 0)
AgregarMarco(n:Val(fi:2)..w:FAC-1, 1, 0)
AgregarMarco(w:Val(fi:2)..x:FAC-1, 1, 0)
AgregarMarco(y:Val(fi:2)..ab:FAC-1, 1, 2)
AgregarMarco(a:FAC..B:FAC, 1, 0)
AgregarMarco(c:FAC..M:FAC, 1, 0)
AgregarMarco(m:FAC..M:FAC, 1, 0)
AgregarMarco(n:FAC..W:FAC, 1, 0)
AgregarMarco(w:FAC..X:FAC, 1, 0)
AgregarMarco(y:FAC..ab:FAC, 1, 2)
ACN(fi:2, FAC)

ACN(H:FAC, Val(tb:2))
ACN(I:FAC, Val(tb:3))
ACN(J:FAC, Val(tb:4))
