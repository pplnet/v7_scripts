ACN(W:FAC, Val(ta:4) * Val(cu:1))
ACN(Y:FAC, Val(tg:2) * Val(cu:1))
ACN(Z:FAC, Val(th:2) * Val(cu:1))

FormatoCeldas(E:Val(fi:1)..E:FAC, Exe('F2'))
FormatoCeldas(H:Val(fi:1)..J:FAC, Exe('F2'))
