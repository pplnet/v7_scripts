*-Compra y Venta de Títulos
HOJAVISIBLE(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1     : "Fecha Desde"           ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, SI);
  Fecha2     : "Fecha Hasta"           ;1;2;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Lista2     : "Moneda Oper."          ;3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ");
  Radio2     : "Expresado|ARP  |USD  " ;5;1;;;;;;;0
  Especie1   : "Especie "              ;;;;;;Vacio(Dialogo.Especie1) O DesciendeDeEspecie(Dialogo.Especie1,'TITULO') ;'Especie Invalida';NO;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','TITULO'))~") ";                    
  Vehiculo2  : "Grupo"                 ;7;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : "Vehiculo"              ;3;2;;Vacio(Dialogo.Vehiculo2);;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Radio3     : "Consolidado|Si|No"     ;;1;;;;;;;1;  
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACN(fi1,0)

ACT(h:2,'Fecha : '~Var('FECHASYS')~'    Hora: '~HORA(AHORA) )
SetFont(h:2..h:2,1)

SetFilaActual(3)
ACT(a:FAC,'Compra y Venta de Titulos')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(a:FAC+1, 'Expresado en '~Val(mo1))
SetFont(a:fac..a:fac+1,3)

SetFilaActual(6)

ACT(XW:99, Var('TIPORE2NRZ')~Var('TIPORE2RZ'))
ACT(XW:77, Var('TIPORE2DC'))
Recorrer&k 1, Elementos(val(XW:99))
    ***---Quito las DC que no hay en moneda de emision
    IF Not Incluido(ItemLista(Val(XW:99), &k), Val(XW:77))
        ACT(XW:88, ItemLista(Val(XW:99), &k))
    ENDIF
Proximo

If NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC+1, 'Grupo : '~Dialogo.Vehiculo2)
Else
  If NoVacio(Dialogo.Lista1)
    ACT(a:FAC+1, 'Vehiculo/s : '~Dialogo.Lista1) 
  Else
    ACT(a:FAC, 'Vehiculo : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
  EndIf
EndIf

If NoVacio(Dialogo.Lista2)
  ACT(a:FAC+1, 'Moneda Operada : '~Dialogo.Lista2)
Else
  ACT(a:FAC+1, 'Moneda Operada : Todas')
EndIf

ACT(a:FAC+2, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(d:FAC+2, 'Ope.Hasta : '~Dialogo.Fecha2)

If Dialogo.Radio3 = 0
  ACT(a:FAC+3, 'Consolidado: Si')
Else
  ACT(a:FAC+3, 'Consolidado: No')
EndIf
If NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4,'Especie: '~Dialogo.Especie1)
Else
    ACT(a:FAC+4,'Especie: Todas')
EndIf
SetFont(a:fac..d:fac+4,2)
SetFilaActual(11)

ACN(z11, FAC+2)
ACT(a:FAC,'Titulo')
ACT(b:FAC,'Operacion')
ACT(c:FAC,'Numero Op')
ACT(d:FAC,'Moneda')
ACT(g:FAC,'Compra')
ACT(l:FAC,'Venta')
ACT(o:FAC,'Flujo de Caja')
ACT(p:FAC,'Vehiculo')
ACT(q:FAC,'Contraparte')
ACT(r:FAC,'Tipo.Op')
AlinearCeldas(a:FAC..r:FAC,'C')
SetFont(a:fac..r:FAC,2)
AgregarMarco(a:FAC..r:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(a:FAC..d:FAC+1,2,2,Exe('COLOR'))
AgregarMarco(e:FAC..i:FAC,2,0,Exe('COLOR'))
AgregarMarco(j:FAC..n:FAC,2,0,Exe('COLOR'))
AgregarMarco(e:FAC+1..n:FAC+1,2,2,Exe('COLOR'))
AgregarMarco(o:FAC..r:FAC+1,2,2,Exe('COLOR'))
IFA
ACT(e:FAC,'Fecha')
ACT(f:FAC,'Valor Nominal')
ACT(g:FAC,'Precio')
ACT(h:FAC,'Importe')
ACT(i:FAC,'Importe '~Val(mo1))
ACT(j:FAC,'Fecha')
ACT(k:FAC,'Valor Nominal')
ACT(l:FAC,'Precio')
ACT(m:FAC,'Importe')
ACT(n:FAC,'Importe '~Val(mo1))
AlinearCeldas(e:FAC..o:FAC,'C')
SetFont(a:fac..n:FAC,2)

*ACT(en1,Dialogo.Lista2)

*- Corte por t1:Vehiculo, t2:Titulo, t3:Moneda
act(t1,'')
act(t2,'')
act(t3,'')
BorrarCeldas(w11..w15)
BorrarCeldas(w21..w25)
BorrarCeldas(w31..w35)
BorrarCeldas(w91..w95)
acd(da1,0)
acn(re1,0)

SetFilaActual(11)
***---El Tipo de Tasa se guarda en el campo Security Type de la solapa Otros de tabla Especies

IF Dialogo.Radio3 = 1
  SQL.ADD(" Select O.Vehiculo1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaVto, O.TipoOp, O.Cantidad, O.Precio1, O.Precio2, ")
ELSE
  SQL.ADD(" Select 'Consolidado' Vehiculo1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaVto, O.TipoOp, O.Cantidad, O.Precio1, O.Precio2, ")
ENDIF

SQL.ADD(" O.FechaPago,O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.FechaOp, E.Nombre, ")
SQL.ADD(" E.Fecha Maduracion, E.SType TipoTasa, E.TasaIntVigente, E.InteresesC, 0 Saldo, O.Cliente1,O.Vehiculo1 Vehiculo, O.Book1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
*SQL.ADD(" Where O.ContraEspecie = '"~Dialogo.Lista2~"' ")
SQL.ADD(" Where O.Especie = E.Codigo ")
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND O.ContraEspecie IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD(" AND O.TipoOp In ('SECS','SECSV','SECT','SECTV','SEVS','SEVSV','SEVT','SEVTV') ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else 
   If NoVacio(Dialogo.Vehiculo2)    
     SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~") ")    
   EndIf
ENDIF
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
EndIf    

SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")

*- Ordenado por 
SQL.ADD(" Order By O.Vehiculo1,O.Especie,O.ContraEspecie,O.FechaOp,O.TipoOp ")

Recorrer SQL

  if Eqstr(Val(t1),'') y eqstr(Val(t2),'') y eqstr(Val(t3),'')
    act(t1, fbn('Vehiculo1'))
    act(t2, fbn('Especie'))
    act(t3, fbn('ContraEspecie'))
    acd(da1, fbn('FechaOp'))
    act(a:fac,fbn('Vehiculo1'))
    AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR6'))
    SetFont(a:fac..r:fac,2)
    ifa
  else
    *-- Preparo corte de control
    if Not Eqstr(fbn('Vehiculo1'),Val(t1)) y NoVacio(Val(t1))
      *-- Agrego Subtotal por dia para listar Resultado generado
     * act(l:fac,'Resultado Generado al '~Val(da1))
     * acn(o:fac, Val(re1))
     * AgregarMarco(l:fac..o:fac,2,0)
     * SetFont(l:fac..o:fac,2)
     * ifa    
      act(a:fac,'Total Esp. '~Val(t3) )
      act(b:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
      acn(f:fac, Val(w31))
      acn(h:fac, Val(w32))
      acn(k:fac, Val(w33))
      acn(m:fac, Val(w34))
*      acn(o:fac, Val(w35))
      BorrarCeldas(w31..w35)
      AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..r:fac,2)
      ifa
      act(a:fac,'Total Titulo '~Val(t2)~' en '~Val(mo1))
*      acn(f:fac, Val(w21))
      acn(h:fac, Val(w22))
*      acn(k:fac, Val(w23))
      acn(m:fac, Val(w24))
      acn(o:fac, Val(w25))
      BorrarCeldas(w21..w25)
      AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..r:fac,2)
      ifa
      act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
*      acn(f:fac, Val(w11))
      acn(h:fac, Val(w12))
*      acn(k:fac, Val(w13))
      acn(m:fac, Val(w14))
      acn(o:fac, Val(w15))

      SCN(w91, Val(w11))
      SCN(w92, Val(w12))
      SCN(w93, Val(w13))
      SCN(w94, Val(w14))
      SCN(w95, Val(w15))
     
      BorrarCeldas(w11..w15)
      AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR6'))
      SetFont(a:fac..r:fac,2)
      ifa
      act(t1, fbn('Vehiculo1'))
      act(t2, fbn('Especie'))
      act(t3, fbn('ContraEspecie'))
      acd(da1, fbn('FechaOp'))
      ifa
      act(a:fac,fbn('Vehiculo1'))
      AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR6'))
      SetFont(a:fac..r:fac,2)
      ifa
    Else 
      If [Not Eqstr(fbn['Especie'],Val(t2))] y NoVacio(Val(t2))
        * Cambia El Tipo de Operacion
        *-- Agrego Subtotal por dia para listar Resultado generado
       * act(l:fac,'Resultado Generado al '~Val(da1))
       * acn(o:fac, Val(re1))
       * AgregarMarco(l:fac..o:fac,2,0)
       * SetFont(a:FAC..o:FAC,2)
       * ifa    
        act(a:fac,'Total Esp. '~Val(t3) )
        act(b:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
        acn(f:fac, Val(w31))
        acn(h:fac, Val(w32))
        acn(k:fac, Val(w33))
        acn(m:fac, Val(w34))
*        acn(o:fac, Val(w35))
        BorrarCeldas(w31..w35)
        AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..r:fac,2)
        ifa
        act(a:fac,'Total Titulo '~Val(t2)~' en '~Val(mo1))
*        acn(f:fac, Val(w21))
        acn(h:fac, Val(w22))
*        acn(k:fac, Val(w23))
        acn(m:fac, Val(w24))
        acn(o:fac, Val(w25))
        BorrarCeldas(w21..w25)
        AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..r:fac,2)
        ifa
        * Asignar Tipo Operacion
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('Especie'))
        act(t3, fbn('ContraEspecie'))
        acd(da1, fbn('FechaOp'))
      Else
        If [Not Eqstr(fbn['ContraEspecie'],Val(t3))] y NoVacio(Val(t3))
          *-- Cambia el Especie(Moneda)
          *-- Agrego Subtotal por dia para listar Resultado generado
         * act(l:fac,'Resultado Generado al '~Val(da1))
         * acn(o:fac, Val(re1))
         * AgregarMarco(l:fac..o:fac,2,0)
         * SetFont(a:FAC..o:FAC,2)
         * ifa    
          act(a:fac,'Total Esp. '~Val(t3) )
          act(b:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
*          acn(f:fac, Val(w31))
          acn(h:fac, Val(w32))
*          acn(k:fac, Val(w33))
          acn(m:fac, Val(w34))
*          acn(o:fac, Val(w35))
          BorrarCeldas(w31..w35)
          AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
          SetFont(a:fac..r:fac,2)
          ifa
          * Asignar Especie
          act(t1, fbn('Vehiculo1'))
          act(t2, fbn('Especie'))
          act(t3, fbn('ContraEspecie'))
          acd(da1, fbn('FechaOp'))
        EndIf
      EndIf
    Endif
  Endif

  *-- Verifico si hay corte por dia
  if fbn('FechaOp') <> Val(da1) 
    *-- Agrego Subtotal por dia para listar Resultado generado
   * act(l:fac,'Resultado Generado al '~Val(da1))
   * acn(o:fac, Val(re1))
   * AgregarMarco(l:fac..o:fac,2,0)
   * SetFont(a:FAC..o:FAC,2)
   *  acd(da1, fbn('FechaOp'))
   * ifa    
  endif

  ACT(a:fac,FBN['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
  ACT(c:fac,FBN['NrOperacion'])
  ACLO(c:fac,FBN['NrOperacion'])
  ACT(d:fac,FBN['ContraEspecie'])
  ACN(az1,CotizacionC(fbn['ContraEspecie'],,,,fbn('FechaPago'),1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )

  If [Eqstr(fbn['ContraEspecie'],Var('MONELOCA'))] y Dialogo.Radio2=1
    ACT(az2,PYC(1/val(az1),0,8)~' (INV) ')
  ELSE
    ACT(az2,PYC(Val(az1),0,8))
  ENDIF


  *-- Los Tipo de Operaciones de compra son 'SECS','SECSV','SECT','SECTV'
  If Eqstr(FBN['TipoOp'],'SECS') o Eqstr(FBN['TipoOp'],'SECSV') o Eqstr(FBN['TipoOp'],'SECT') o Eqstr(FBN['TipoOp'],'SECTV')  
    ACT(b:fac,'Compra')
    ACT(e:fac,FBN['FechaOp'])
    ACN(f:fac,FBN['Cantidad'])
    ACN(g:fac,FBN['Precio1'])
    ACN(h:fac,FBN['TotalNetoCli1'])
    ACN(i:fac, val(h:fac)*Val(az1))
  else
    ACT(b:fac,'Venta')
    ACT(j:fac,FBN['FechaOp'])
    ACN(k:fac,FBN['Cantidad'])
    ACN(l:fac,FBN['Precio1'])
    ACN(m:fac,FBN['TotalNetoCli1'])
    ACN(n:fac, val(m:fac)*Val(az1))
  endif

  ACN(o:fac, Val(n:fac)-Val(i:fac))

  *- Funcion para recuperar el resultado, recupera en re:1
  ACT(ea:2,FBN['Especie'])
  ACT(va:2,FBN['Vehiculo1'])
  ACD(fa:2,FBN['FechaOp'])
  ACT(tn:2,'SEC')

  ***---(.'RESULTADO'.)
  ACT(TR:1, Val(XW:88))
  ACT(MI:2, 'ME')
  ACT(ES:1, fbn('Especie'))
  ACT(VH:1, fbn('Vehiculo'))
  ACT(BK:1, fbn('Book1'))
  ACN(NR:1, 2)
  ACT(TN:1, 'SEC')
  (.'RESUGENE-2'.)
  ACN(RE:1, Val(RS:1))
  SCN(w11,val(f:fac)*Val(az1))
  SCN(w21,val(f:fac)*Val(az1))
  SCN(w31,val(f:fac))
  SCN(w12,val(h:fac)*Val(az1))
  SCN(w22,val(h:fac)*Val(az1))
  SCN(w32,val(h:fac))
  SCN(w13,val(k:fac)*Val(az1))
  SCN(w23,val(k:fac)*Val(az1))
  SCN(w33,val(k:fac))
  SCN(w14,val(m:fac)*Val(az1))
  SCN(w24,val(m:fac)*Val(az1))
  SCN(w34,val(m:fac))
  SCN(w15,val(o:fac))
  SCN(w25,val(o:fac))
  SCN(w35,val(o:fac))

*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
  ACT(p:FAC, FBN['Vehiculo']~' - '~Copy(BuscarCampo('Vehiculos','Descripcion','Codigo', FBN['Vehiculo']),1,23))
  ACT(q:FAC, FBN['Cliente1']~' - '~Copy(BuscarCampo('Clientes','RazonSocial','Codigo', FBN['Cliente1']),1,23))
  ACT(r:FAC, FBN['TipoOp']~' - '~Copy(BuscarCampo('TiposOperacion','Nombre','Codigo', FBN['TipoOp']),1,23))
  SetFont(a:FAC..o:FAC,1)
  SCN(fi1,1)

Proximo
*-- Veo si hay algo para listar
if Val(fi1)=0
  ** No entro en el select (resultado vacio)
  HojaVisible(no)
  Messagebox('No se encontraron operaciones.')
else
  *-- Listo ultimo total
  ifa
  *-- Agrego Subtotal por dia para listar Resultado generado
 * act(l:fac,'Resultado Generado al '~Val(da1))
 * acn(o:fac, Val(re1))
 * AgregarMarco(l:fac..o:fac,2,0)
 * SetFont(a:FAC..o:FAC,2)
 * ifa
  act(a:fac,'Total Esp. '~Val(t3) )
  act(b:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
  acn(f:fac, Val(w31))
  acn(h:fac, Val(w32))
  acn(k:fac, Val(w33))
  acn(m:fac, Val(w34))
*  acn(o:fac, Val(w35))
  BorrarCeldas(w31..w35)
  AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..r:fac,2)
  ifa
  act(a:fac,'Total Titulo '~Val(t2)~' en '~Val(mo1))
*  acn(f:fac, Val(w21))
  acn(h:fac, Val(w22))
*  acn(k:fac, Val(w23))
  acn(m:fac, Val(w24))
  acn(o:fac, Val(w25))
  BorrarCeldas(w21..w25)
  AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..r:fac,2)
  ifa
  act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
*  acn(f:fac, Val(w11))
  acn(h:fac, Val(w12))
*  acn(k:fac, Val(w13))
  acn(m:fac, Val(w14))
  acn(o:fac, Val(w15))

  SCN(w91, Val(w11))
  SCN(w92, Val(w12))
  SCN(w93, Val(w13))
  SCN(w94, Val(w14))
  SCN(w95, Val(w15))
  BorrarCeldas(w11..w15)
  AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR6'))
  SetFont(a:fac..r:fac,2)
  ifa
  ifa
  act(a:fac,'Total General en '~Val(mo1) )
*  acn(f:fac, Val(w91))
  acn(h:fac, Val(w92))
*  acn(k:fac, Val(w93))
  acn(m:fac, Val(w94))
  acn(o:fac, Val(w95))
  AgregarMarco(a:fac..r:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..r:fac,3)
  FormatoCeldas(e:12..q:fac,Exe('F2'))
  FormatoCeldas(g:12..g:fac,Exe('F6'))
  FormatoCeldas(l:12..l:fac,Exe('F6'))

  ACO(1,14)
  ACO(2,7)
  ACO(3,7)
  ACO(4,5)
  ACO(5,6)
  ACO(6,9)
  ACO(7,8)
  ACO(8,9)
  ACO(9,9)
  ACO(10,6)
  ACO(11,9)
  ACO(12,8)
  ACO(13,9)
  ACO(14,9)
  ACO(15,10)
  ACO(16,15)
  ACO(17,15)
  ACO(18,15)
  Impresion(1,2)
  SetPrintFit(3,56)
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'FIN DE LISTADO')
  SetFont(a:FAC, 2)
  LimitesVision(r:FAC)

*
*    Esto es lo que agrega Silvia
*
  RangoTitulo(a:1..m:FAC, 11)
Endif
