CrearDialogo
  Fecha1    :'F.Desde'      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;PriDeMes(Fsys, SI)
  Fecha2    :'F.Hasta'      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
  Cuenta1   :'Cuenta'       ;;;;;;NoVacio(Dialogo.Cuenta1);'Debe Ingresar una Cuenta';NO;
  Vehiculo1 :'Vehiculo'     ;;;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;;BuscarCampo('CUENTAS','Cliente','Codigo',Dialogo.Cuenta1)
FinDialogo

If Not OK
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(3)
ACT(A:FAC, 'Extractos Bancarios Recibidos')
SetFont(A:FAC,3)

SetFilaActual(FAC+2)

ACT(A:FAC, 'Desde: '~Dialogo.Fecha1)
ACT(A:FAC+1, 'Hasta: '~Dialogo.Fecha2)
ACT(A:FAC+2, 'Cuenta: '~Dialogo.Cuenta1)
ACT(A:FAC+3, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:FAC..A:FAC+3,1)

SetFilaActual(FAC+5)

ACT(A:FAC, 'Fecha')
ACT(B:FAC, 'Saldo')
ACT(C:FAC, 'Procesado')

AgregarMarco(A:FAC..C:FAC,2,2,Exe('COLOR'))
AlinearCeldas(A:FAC..C:FAC,'C')
SetFont(A:FAC..C:FAC,2)

SetFilaActual(FAC)
ACN(Z:1,FAC+1)

SQL.ADD(" Select FechaOp, Cantidad, Case CB5 When 1 Then 'SI' Else 'NO' End as Procesado ")
SQL.ADD(" From "~DBO~".OPSEVENTUALES ")
SQL.ADD(" Where FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND Cuenta1 = '"~Dialogo.Cuenta1~"' ")
SQL.ADD(" AND TipoOp ='MMEVDE' ")

Recorrer SQL
   ACD(A:FAC,FBN['FechaOp'])
   ACN(B:FAC,FBN['Cantidad'])
   ACT(C:FAC,FBN['Procesado'])

   AgregarMarco(A:FAC..C:FAC,1,2,0)
   FormatoCeldas(B:FAC..B:FAC,Exe('F2'))
   SetFont(A:FAC..C:FAC,1)
Proximo

LimitesVision(F:FAC+2)
ACO(1,8)
ACO(2,10)
ACO(3,8)