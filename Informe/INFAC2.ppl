*PRELIQUIDACION AC
ModoReproceso(SinDialogo)

CrearDialogo
    Fecha1:    'Fecha Liq:';1;;;;;NoVacio(Dialogo.Fecha1);'Ingrese una fecha';NO;FSys;
    Vehiculo1: 'Vehiculo:' ;2;;;;;NOVACIO(Dialogo.Vehiculo1);;;VAR('VEHICULODE')
    *    Lista1:'Tipos Op.' ;3;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo in ('TIC','TIV','TIFC','TIFV','TCOPRI','TCPCEM','EQC','EQV') ")  
    Mercado1: 'Mercado' ;;;;;;;;
    Cliente1:  'Cliente'    ;;1;;;;;;;;
    Especie1:  'Especie'    ;;1;;;;;;;
    Mercado2 :'Mercado Neg.';;;;;;;;;;;;;;" EsNegociacion='SI' "
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, "Arial,11,BU")
CrearFont(2, "Arial,9,B"  )
CrearFont(3, "Arial,8,"   )

SetFilaActual(1)

**-- Encabezado --**
ACT(a:FAC, 'Pendientes de liquidacion por Mercado CP')
SetFont(a:1..a:FAC, 1)

ACT(a:FAC+2, 'Fecha Liq.: '~Dialogo.Fecha1)

SetFont(a:FAC+2..b:FAC+3, 2) 


If NoVacio(Dialogo.Mercado1)
   ACT(a:FAC, 'Informe de Preliquidacion '~SQL("Select descripcion from "~DBO~".Mercados where codigo = '"~Dialogo.Mercado1~"'"))
   SetFont(a:1..a:FAC, 1)
   SetFilaActual(FAC+4)
Else
   ACT(a:FAC+4, 'Mercado: Todos')
   SetFont(a:FAC+4..b:FAC+4, 2) 
   SetFilaActual(FAC+5)
Endif
If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+4, 'Cliente: '~SQL("Select RazonSocial from "~DBO~".Clientes where codigo = '"~Dialogo.Cliente1~"'"))
Else
   ACT(a:FAC+4, 'Cliente: Todos')
Endif
If NoVacio(Dialogo.Especie1)
   ACT(a:FAC+5, 'Especie: '~SQL("Select Nombre from "~DBO~".Especies where codigo = '"~Dialogo.Especie1~"'"))
Else
   ACT(a:FAC+5, 'Especie: Todos')
Endif

If NoVacio(Dialogo.Mercado2)
   ACT(a:FAC+6, 'Mercado Negociacion: '~SQL("Select descripcion from "~DBO~".Mercados where codigo = '"~Dialogo.Mercado2~"'"))
Else
   ACT(a:FAC+6, 'Mercado Negociacion: Todos')
Endif


ACN(fa1, FAC+4)

SQL.ADD("select E.Jerarquia, M.Especie, Sum(M.Cantidad) as Cant,E.CodMAEContado, M.Mercado, E.Codigo4, E.CodAlfCajaValores CodBYMA, O.Mercado4 MercaNeg, E.VTeorico ")
SQL.ADD(" from  "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where M.NrOperacion = B.NrOperacion ")
SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
SQL.ADD("  and  M.FechaMov   = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  M.Mercado = '"~Dialogo.Mercado1~"'         ")
Endif
If NoVacio(Dialogo.Mercado2)
   SQL.ADD("  and  O.Mercado4    = '"~Dialogo.Mercado2~"' ")
endif
If NoVacio(Dialogo.Cliente1)   
   SQL.ADD("  and M.Cliente = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and M.Especie = '"~Dialogo.Especie1~"' ")
Endif
SQL.ADD("  and  ((O.TipoOp in('TIC','TIV') and ((IsNull(O.CB4,0)=0)) and (O.Vehiculo1<>O.Cliente1)) or (O.TipoOp IN ('TIDE','TIPO','TICO','TICT','TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV')) )  ")
SQL.ADD("  and  rtrim(ltrim(M.Mercado)) <> '' ")
SQL.ADD("  and  M.Especie     = E.Codigo      ")
SQL.ADD("  and  B.NrBit       = 10            ")
SQL.ADD("  and  B.Valor       = '1'           ")
SQL.ADD("  and  O.TipoOp IN ('TIC','TIV','TIDE','TIPO', 'TICO','TICT','TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV') ")
SQL.ADD(" group by E.Jerarquia, M.Especie,E.CodMAEContado, M.Mercado, E.Codigo4, E.CodAlfCajaValores, O.Mercado4, E.VTeorico")
SQL.ADD(" order by M.Mercado, E.Jerarquia, M.Especie                   ")
watch(SQL.BATCH())

ACN(fl1, fac+1)

Recorrer SQL
    ACT(ce1, FBN['Especie'])
    ACN(cn:1, FBN['Cant'])

    **  Corte de control x Especie
    If Not EqStr(val(fa2),fbn('Mercado'))

       ACT(a:FAC, 'Mercado: '~FBN['Mercado']~' - '~SQL("Select descripcion from "~DBO~".Mercados where codigo = '"~FBN('Mercado')~"'"))
       SetFont(a:FAC, 2)
       ifa

       ACT(a:FAC, 'Nro.Oper.' )
       ACT(b:FAC, 'Tipo Op.'  )
       ACT(c:FAC, 'Boleto'    )
       ACT(d:FAC, 'Cliente'   )
       ACT(e:FAC, 'Fecha Op.' )
       ACT(f:FAC, 'Fecha Vto.')
       ACT(g:FAC, 'Especie'   )
       ACT(h:FAC, 'Cod CV'    )
       ACT(i:fac, 'Cod Mercado')
       ACT(j:FAC, 'Cantidad'  )
       ACT(k:FAC, 'Cont.Esp.' )
       ACT(l:FAC, 'Precio'    )
       ACT(m:FAC, 'Monto'     )
       ACT(n:FAC, 'Int. Corr.') 
       ACT(o:FAC, 'Neto'      )
       ACT(p:FAC, 'V.N.'      )

       SetFont(a:FAc..t:FAC, 2)
       AgregarMarco(a:FAC..t:FAC, 2,0,Exe('COLOR6'))
       AlinearCeldas(a:FAC..d:FAC, 'I')
       AlinearCeldas(h:FAC..h:FAC, 'D')
       AlinearCeldas(e:FAC..g:FAC, 'C')
       AlinearCeldas(k:FAC..k:FAC, 'C')
       AlinearCeldas(l:FAC..p:FAC, 'D')
       ifa

       act(fa2,fbn('Mercado'))
    Endif

    **-- Rotulo de Total por Especie
    If Val(cn:1)>0
      ** ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~' - ML: '~fbn('Codigo4')~') ')
      ACT(a:FAC,'Neto '~FBN['Especie']~  IIF(Eqstr(FBN['MercaNeg'], VAR('AMBMAE')),  ' (MAE: '~FBN['CodMAEContado'],IIF(Eqstr(FBN['MercaNeg'], VAR('AMBBYMA')),  ' (BYMA: '~FBN['CodBYMA'],' ('~FBN['MercaNeg']))~' - Cod.Interno: '~fbn('Codigo4')~') ')     

       ACN(d:FAC, -Val(cn:1))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..p:FAC,2)
    Else
      ** ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~' - ML: '~fbn('Codigo4')~') ')
       ACT(a:FAC,'Neto '~FBN['Especie']~  IIF(Eqstr(FBN['MercaNeg'], VAR('AMBMAE')),  ' (MAE: '~FBN['CodMAEContado'],IIF(Eqstr(FBN['MercaNeg'], VAR('AMBBYMA')),  ' (BYMA: '~FBN['CodBYMA'],' ('~FBN['MercaNeg']))~' - Cod.Interno: '~fbn('Codigo4')~') ')     
      
       ACN(d:FAC, -Val(cn:1))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..p:FAC,2)
    Endif

    ACN(fi1, FAC)

    SQL.ADD("Select O.TipoOp, O.NrOperacion, O.NrBoleto, O.Cliente1, O.FechaOp, coalesce(O.FechaAltaSisExterno,O.FechaVto) FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, O.Precio1, O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.Cuenta1, O.Mercado4 MercaNeg, U.Nombre NomCta, R.Descripcion, C.RazonSocial, E.Jerarquia,E1.InteresesC,C.NrBYMA, C.NrMAE, ")
    SQL.ADD("M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov, M.Mercado,E.CodNumCajaValores,E.CodMAEContado, E.CodAlfCajaValores CodBYMA, M.FechaMov ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo, "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion                    ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion                    ")
    SQL.ADD("  and  M.Mercado     = R.Codigo                         ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo                         ")
    SQL.ADD("  and  M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"'    ")
* FJL 14-06-18 - No encontraba movimientos si Dialogo.Mercado1 estaba vacio
*    SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"'           ")
    SQL.ADD("  and  M.Mercado     = '"~fbn('Mercado')~"'             ")
    SQL.ADD("  and  O.Mercado4    = '"~fbn('MercaNeg')~"'            ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"'                   ")
    SQL.ADD("  and  B.NrBit       = 10                               ")
    SQL.ADD("  and  B.Valor       = '1'                              ")
    SQL.ADD(" and  O.TipoOp IN ('TIC', 'TIV', 'TIDE', 'TIPO', 'TICO', 'TICT', 'TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV') ")
    SQL.ADD("  and  (O.TipoOp<>'TCOPRI' OR O.Cliente1<>'"~Dialogo.Vehiculo1~"')    ")
    SQL.ADD("  and  ((O.TipoOp in('TIC','TIV') and ((IsNull(O.CB4,0)=0)) and (O.Vehiculo1<>O.Cliente1)) or (O.TipoOp IN ('TIDE','TIPO','TICO','TICT', 'TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV')) )  ")
    SQL.ADD(" UNION ")
    SQL.ADD("Select O.TipoOp, O.NrOperacion, O.NrBoleto, O.Cliente1, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, O.Precio1, O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.Cuenta1, O.Mercado4 MercaNeg , U.Nombre NomCta, R.Descripcion, C.RazonSocial, E.Jerarquia,E1.InteresesC, C.NrBYMA, C.NrMAE, ")
    SQL.ADD("- M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov, M.Mercado,E.CodNumCajaValores,E.CodMAEContado, E.CodAlfCajaValores CodBYMA, M.FechaMov ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo, "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie           ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion                              ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion                              ")
    SQL.ADD("  and  M.Mercado     = R.Codigo                                   ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo                                   ")
    SQL.ADD("  and  M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"'              ")
* FJL 14-06-18 - No encontraba movimientos si Dialogo.Mercado1 estaba vacio
*    SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"'           ")
    SQL.ADD("  and  M.Mercado     = '"~fbn('Mercado')~"'                       ")
    SQL.ADD("  and  O.Mercado4    = '"~fbn('MercaNeg')~"'                      ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"'                             ")
    SQL.ADD("  and  B.NrBit       = 10                                         ")
    SQL.ADD("  and  B.Valor       = '1'                                        ")
    SQL.ADD("  and  O.TipoOp='TCOPRI' AND O.Cliente1='"~Dialogo.Vehiculo1~"'   ")
    SQL.ADD(" Order By E.Jerarquia, M.Mercado, O.Especie, O.NrOperacion        ")
    watch(SQL.BATCH())

    Recorrer SQL

        If Not EqStr(val(ck1),FBN['NrOperacion'])
           ACT(ck1, FBN['NrOperacion'])           
        EndIf
        
        **-- Linea de Detalle  
        ACT(a:FAC, FBN['NrOperacion']  )
        ACLO(a:FAC, FBN['NrOperacion'] )
        ACT(b:FAC, FBN['TipoOp']       )
        ACT(c:FAC, FBN['NrBoleto']     )
        *        ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial'] ~IIF(Eqstr(FBN['MercaNeg'], VAR('AMBMAE')),' Nro.MAE '~FBN['NrMAE'],' Nro.BYMA '~FBN['NrBYMA']))
        ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial'] ~IIF(Eqstr(FBN['MercaNeg'], VAR('AMBMAE')),' Nro.MAE '~FBN['NrMAE'],IIF(Eqstr(FBN['MercaNeg'], VAR('AMBBYMA')),' Nro.BYMA '~FBN['NrBYMA'],' ')))
        
        *Anterior:
        *ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial']~' Nro.MAE '~FBN['NrMAE'])
        ACD(e:FAC, FBN['FechaOp']      )
        ACD(f:FAC, FBN['FechaVto']     )
        ACT(g:FAC, FBN['Especie']      )
        *Anterior:
        *ACT(h:fac, FBN['CodMAEContado'])   
        ACT(h:fac, IIF(Eqstr(FBN['MercaNeg'], VAR('AMBMAE')), FBN['CodMAEContado'], IIF(Eqstr(FBN['MercaNeg'], VAR('AMBBYMA')), FBN['CodBYMA'], '')))
        
        ACT(i:fac, FBN['CodNumCajaValores'])
        *        ACN(j:FAC, FBN['CantMov']      )
        ACT(k:FAC, FBN['ContraEspecie'])
        ACN(l:FAC, FBN['Precio1']      )

        if DesciendeDeEspecie(FBN['EspeMov'],'TITULO') o DesciendeDeEspecie(Val(g:FAC),'CUPON')    
           ACN(j:FAC, -FBN['CantMov']      )
        else   
           ACN(m:FAC, -FBN['CantMov']      )
        endif   
        
        If FBN['NrMov']<>1000
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
           *             ACN(m:FAC, FBN['TotalBrutoCli1'])

             IF EqStr(FBN['InteresesC'],'CLE')
                ACN(n:FAC, FBN['TotalIntereses'])
             EndIf

             ACN(o:FAC, -FBN['TotalNetoCli1'])
             ACN(p:FAC,  FBN['Cantidad'])
           Else
           *             ACN(m:FAC, -FBN['TotalBrutoCli1'])

             IF EqStr(FBN['InteresesC'],'CLE')
                ACN(n:FAC, -FBN['TotalIntereses'])
             EndIf

             ACN(o:FAC,  FBN['TotalNetoCli1'])           
             ACN(p:FAC, -FBN['Cantidad'])
           EndIf
        Else 
            ACN(o:FAC, FBN['CantMov'])
        EndIf

        *-                 
        If DesciendedeEspecie(Val(ce1), 'MONEDA')
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)] o [Incluido(FBN['TipoOp'], 'TIDE|TICT') y FBN['FechaMov']=FBN['FechaVto']]
              SCN(tc1, FBN['CantMov'])
           Else
              SCN(tp1, FBN['CantMov'])
           Endif
        Else
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)] o [Incluido(FBN['TipoOp'], 'TIPO|TICO') y FBN['FechaMov']=FBN['FechaVto']] o [Incluido(FBN['TipoOp'], 'TIDE|TICT') y FBN['FechaMov']=FBN['FechaOp']]
              SCN(tc2, FBN['CantMov'])
           Else
              SCN(tp2, FBN['CantMov'])
           Endif
        Endif

        SetFont(a:FAC..s:FAC, 3)
        AlinearCeldas(e:FAC..g:FAC, 'C')
        AlinearCeldas(k:FAC..k:FAC, 'C')                
        FormatoCeldas(j:fac..p:fac, EXE('F2'))
        FormatoCeldas(l:fac..l:fac, EXE('F7'))
     Proximo

     IFA
     *--Impresion de totales por Especie
     If DesciendedeEspecie(Val(ce1), 'MONEDA')
        ACT(g:Val(fi1),'Total a Pagar '~Val(ce1)~': ')
        ACN(j:Val(fi1), Abs(Val(tc1)))
        ACT(l:Val(fi1),'Total a Cobrar '~Val(ce1)~': ')
        ACN(n:Val(fi1), Abs(Val(tp1)))
        ACN(d:Val(fi1), Val(d:Val(fi1)))
     Else
        ACT(g:Val(fi1),'Total a Entregar '~Val(ce1)~': ')
        ACN(j:Val(fi1), Abs(Val(tp2)))
        ACN(k:val(fi1), val(j:val(fi1)) * fbn('VTeorico'))
        ACT(l:Val(fi1),'Total a Recibir '~Val(ce1)~': ')
        ACN(n:Val(fi1), Abs(Val(tc2)))
        ACN(o:val(fi1), val(n:val(fi1)) * fbn('VTeorico'))
*        ACN(d:Val(fi1), Val(d:Val(fi1)))
*        ACN(e:val(fi1), Val(d:Val(fi1)) * fbn('VTeorico'))
     Endif
     FormatoCeldas(a:val(fi1)..p:val(fi1),EXE('F2'))
*     FormatoCeldas(e:val(fi1)..e:val(fi1),EXE('F5'))
*     FormatoCeldas(k:val(fi1)..k:val(fi1),EXE('F5'))
*     FormatoCeldas(o:val(fi1)..o:val(fi1),EXE('F5'))

     SetFont(a:Val(fi1)..q:Val(fi1),2)
     ACN(tc1, 0)
     ACN(tp1, 0)
     ACN(tc2, 0)
     ACN(tp2, 0)
Proximo
FormatoCeldas(c:Val(fl1)..c:fac,Exe('F2'))
IFA

*--Agrego los diferimientos
ACT(a:fac,'Diferimientos Pendientes')
SetFont(a:fac,2)
ifa
ifa
*

ACT(a:fac, 'Nro.Oper.'   )
ACT(b:fac, 'Tipo Op.'    )
ACT(c:fac, 'Fecha Orig.' )
ACT(d:fac, 'Cliente'     )
ACT(e:fac, 'Fecha Dife.'  )
ACT(f:fac, 'Dif. dias'   )
ACT(g:fac, 'Mercado'     )   
ACT(h:fac, 'Especie'     )
ACT(i:fac, 'Cant / Monto Dif.'     )

AgregarMarco(a:FAC..i:FAC, 2,0,Exe('COLOR6'))
SetFont(a:FAc..i:FAC, 2)

SQL.ADD("select O.Mercado, O.Especie, o.contraespecie, O.NrOperacion, O.TipoOp, O.FechaVto, O.FechaAltaSisExterno, O.Cliente1, C.RazonSocial ,o.cantidad cantidad_orig,mp.cantidad cantidad_dif,mp.fechamov,mp.mercado mp_mercado,mp.especie mp_especie,mp.cantidad mp_cantidad")
SQL.ADD("from OPERACIONES O, MOVPENDIENTES MP, "~DBO~".CLIENTES C     ")
SQL.ADD("where O.NrOperacion = MP.NrOperacion                         ")
SQL.ADD("and   O.Cliente1    = C.Codigo                               ")
*SQL.ADD("and   O.Especie     = MP.Especie                             ")
SQL.ADD("and   O.Convenio    = 1                                      ")
SQL.ADD("and   mp.Fechamov  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and   O.FechaAltaSisExterno  = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and   mp.fechamov in (select max(fechamov) from MOVPENDIENTES Mov where mov.nroperacion = O.NrOperacion and Mov.Especie=O.Especie ) ")



Recorrer SQL
        ACT(a:fac, FBN['NrOperacion']        )
        ACLO(a:fac, FBN['NrOperacion']       )
        ACT(b:fac, FBN['TipoOp']             )
        ACD(c:fac, FBN['FechaAltaSisExterno'])
        ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial'])
        *ACD(e:fac, FBN['FechaVto']           )
        ACD(e:fac, FBN['Fechamov']           )
        ACt(f:fac, fstr(DifDias(FBN['FechaVto'],FBN['FechaAltaSisExterno'],'ARG'),1,0))
        ACT(g:fac, FBN['mp_Mercado']            )
        ACT(h:fac, FBN['mp_Especie'])
        ACN(i:fac, (-1)*FBN['mp_cantidad'])
        FormatoCeldas(h:fac..l:fac,Exe('F2'))
Proximo

ifa
ifa
*

Impresion(1,2)
SetPrintFit(3,70)
ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac..a:fac,2)
LimitesVision(p:fac)
RangoTitulo(a:1..p:FAC, 6)

*-- Ajuste de celdas
ACO(1,7)
ACO(2,5)
ACO(3,7)
ACO(4,31)
ACO(5,8)
ACO(6,6)
ACO(7,8)
ACO(8,9)
ACO(9,9)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
