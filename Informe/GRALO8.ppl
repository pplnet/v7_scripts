* GRALOP - OPERAT - General de Operaciones
ModoReproceso(SINDialogo)
CrearDialogo
  Vehiculo2  : "Grupo"      ;1;1;;Vacio(Dialogo.Vehiculo1);;Not EsTerminal(Dialogo.Vehiculo2, Vehiculos);'Debe ingresar un Grupo';NO;;;;;;"TipoVehiculo <> 'DIV'";
  Vehiculo1  : "Vehiculo"   ;1;2;;Vacio(Dialogo.Vehiculo2);;EsTerminal(Dialogo.Vehiculo1, Vehiculos) o Vacio (Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;;;;;;"TipoVehiculo = 'DIV'";;
  Check1     : "Filtrar Book" ;2;2;;;NoVacio(Dialogo.Vehiculo1);;;;;;
  Book1      : "Book"       ;;;;;Dialogo.Check1=1;NoVacio(Dialogo.Book1) o Dialogo.Check1=0;"Debe ingresar un book si desea filtrar por el mismo";NO;;;;;;"Vehiculo Like '%"~Dialogo.Vehiculo1~"%' "
  Cliente1   : "Cliente"    ;2;1;;;;;;;
  Especie1   : "Especie"    ;4;;;;;;;;
  Operador   : 'Operador'   ;4;2;;;;;;;
  Fecha1     : "F.Op.Desde" ;5;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2     : "F.Op.Hasta" ;5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3     : "F.Vto.Desde";6;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4     : "F.Vto.Hasta";6;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  Lista1     : "Tipo Op"    ;7;1;;;;;;;;;SQLSet(" Select Codigo from "~DBO~".TIPOSOPERACION where ClaseOperacion not like 'BACKUP' and Codigo not like 'MMCCR' ")

  NrOperacion1 : 'Operacion';8;2;;;;;;;
***---  ListaClaves: "Orden"      ;9;1;;;;;;;;;Operaciones
  Radio1     : "Consolidado|Si|No";10;1;;;;;;;1
  Radio2     : "Sinteticas|Si|No" ;10;2;;;;;;;1
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz:6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz:6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

***Insertar Logo
let &filaLogo 1
@LOGO

SetFilaActual(FAC+6)
ACT(a:FAC,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:FAC,2)
ifa
ifa
ACT(a:fac, "General de Operaciones")
ACT(h:fac,'Fecha : '~Var('FECHASYS'))
SetFont(a:fac..h:fac,3)

ifa
ifa
ACN(w1,FAC)

if NoVacio (Dialogo.Vehiculo2)
   ACT(a:FAC+1, 'Grupo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
else
   ACT(a:FAC+1, 'Grupo : Todos')
endIf

if NoVacio (Dialogo.Vehiculo1)
   ACT(a:FAC+2, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+2, 'Vehiculo : Todos')
endIf
*--Cintia 15-12
If NoVacio(Dialogo.Book1)
    ACT(A:fac+3,'Book : '~Dialogo.Book1)
Else
    ACT(A:fac+3,'Book : Todos')
Endif
*-------
SetFilaActual(Val(w1)+1)
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+4, 'Especies : Todas')
endif

if NoVacio(Dialogo.NrOperacion1)
   ACT(c:fac+4, 'Nr.Operacion: '~Dialogo.NrOperacion1)
else
   ACT(c:FAC+4, 'NrOperacion : Todas')
endif 
If Dialogo.Radio2=0
   ACT(c:FAC+4, 'NrOperacion : Sinteticas')
endif
if NoVacio(Dialogo.Operador)
  ACT(a:FAC+8, 'Operador : '~Dialogo.Operador)
else
  ACT(a:FAC+8, 'Operador : Todos')
endif

ACT(a:FAC+5, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(c:FAC+5, 'Ope.Hasta : '~Dialogo.Fecha2)
ACT(a:fac+6, 'Vto.Desde : '~Dialogo.Fecha3)
ACT(c:FAC+6, 'Vto.Hasta : '~Dialogo.Fecha4)


if NoVacio(Dialogo.Lista1)
  ACT(A:FAC+7, 'Tipo Op. : '~Dialogo.Lista1)
else
  ACT(A:FAC+7, 'Tipo Op. : Todas')
endif

***---Se quita porque no todos los campos existe en OPERACIONES y cancela.
***---SetListaClaves(1)
***---ACT(a:FAC+9, "Orden : "~Dialogo.ListaClaves)
ACT(a:FAC+10, 'Consolidado '~iif(Dialogo.Radio1 = 1,'No','Si'))

SetFont(a:FAC..a:FAC+10, 2)
SetFont(D:FAC..D:FAC+10, 2)

***---SetListaClaves(2)
SetFilaActual(FAC+12)

ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "Book")
ACT(C:FAC, "FechaOp")
ACT(D:FAC, "F.Vto")
ACT(E:FAC, "Cliente")
ACT(F:FAC, "Especie")
ACT(G:FAC, "CtraEspecie")
ACT(H:FAC, "Tipo Op.")
ACT(I:FAC, "Cantidad")
ACT(J:FAC, "Precio/Tasa")
ACT(K:FAC, "Plazo")
ACT(L:FAC, "Total")
ACT(M:FAC, "Nro.Ope.")
ACT(N:FAC, "Op. Contraria")
ACT(O:FAC, "Ult. Modif.")
ACT(P:FAC, "Instancia")
AlinearCeldas(a:FAC..H:FAC,'I')
AlinearCeldas(I:FAC..L:FAC,'D')
AlinearCeldas(M:FAC..P:FAC,'I')
SetFont(a:FAC..P:FAC, 2)
AgregarMarco(a:FAC..P:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

*************---------- VAL(Z:1) ----------***************
if NoVacio(Dialogo.Especie1)
  ACT(z:1, "O.Especie = '"~Dialogo.Especie1~"' and ")
endif

if NoVacio(Dialogo.NrOperacion1)
  ACT(z:1, "O.NrOperacion = '"~Dialogo.NrOperacion1~"' and ")
endif

if NoVacio(Dialogo.Cliente1)
  ACT(z:1, Val(z:1)~"O.Cliente1 = '"~Dialogo.Cliente1~"' and ")
endif

if NoVacio(Dialogo.Lista1)
  ACT(z:1, Val(z:1)~"O.TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") and ")
endif

if NoVacio(Dialogo.Vehiculo1)
  ACT(z:1, Val(z:1)~"O.Vehiculo1 in ("~Pipe2Comillas(val(zz:6))~") and ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    ACT(z:1, Val(z:1)~"O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")  and ")
  endIf
endif

ACT(z:1, Val(z:1)~"O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and ")
ACT(z:1, Val(z:1)~"((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")
if NoVacio(Dialogo.Operador)
  ACT(z:1, Val(z:1)~" and O.Operador = '"~Dialogo.Operador~"'")
endif

******************************-------------- CONSULTAS -------------------*********************************
***---Unico Vto
SQL.ADD("SELECT O.Vehiculo1, O.Book1, O.FechaOp, O.FechaVto, O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("O.ContraEspecie,O.TipoOp, O.MB3, O.NrOperacion3, O.Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" C.Codigo, C. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, 0 Precio2")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION T ") 
SQL.ADD(" WHERE "~Val(z:1)~" and O.TipoOp Not In ('DTSFFM','MMCCR','DTSFVM','DTSVVM','DTCAP','DTFLO','TRANSF','MMCPM','MMFCMV','MMFIMV','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMONM') ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND C.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")
If Dialogo.Radio2=0
   SQL.ADD(" AND O.CB13 = 1 ")
   SQL.ADD(" AND O.TipoOp In "~VAR('OPESINT')~"  ")
EndIf
*----Cintia 15-12
If Dialogo.Check1=1
   SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"'  ")
EndIf
*-----
*--------------------------------------------------------******

***---Multiplo Vto Vto : Money Market
SQL.ADD("Union All ")
SQL.ADD("SELECT O.Vehiculo1, O.Book1, C.Fecha1 FechaOp, C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("O.ContraEspecie,O.TipoOp, O.MB3,  O.NrOperacion3,   O.Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" L.Codigo, L. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C, "~DBO~".VEHICULOS V,"~DBO~".CLIENTES L, "~DBO~".TIPOSOPERACION T") 
SQL.ADD(" where O.NrOperacion=C.NrOperacion and "~Val(z:1)~" and O.TipoOp In ('MMCPM','MMFCMV','MMFIMV','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMONM') ")
SQL.ADD(" and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND L.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")
If Dialogo.Radio2=0
   SQL.ADD(" AND O.CB13 = 1 ")
   SQL.ADD(" AND O.TipoOp In "~VAR('OPESINT')~" ")
EndIf
*----Cintia 15-12
If Dialogo.Check1=1
   SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"'  ")
EndIf
*-----
*--------------------------------------------------------******

***---Multiplo Vto Vto: Futuros
SQL.ADD("Union All ")
SQL.ADD("SELECT O.Vehiculo1, O.Book1, C.Fecha1 FechaOp,C.Fecha2 FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("O.ContraEspecie,O.TipoOp, O.MB3,  O.NrOperacion3,   O.TotalAux3 as Cantidad,O.Precio1,O.Precio3,O.Plazo,O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, ") 
SQL.ADD(" L.Codigo, L. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5, C.Precio2 ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C, "~DBO~".VEHICULOS V,"~DBO~".CLIENTES L, "~DBO~".TIPOSOPERACION T") 
SQL.ADD(" where O.NrOperacion=C.NrOperacion and "~Val(z:1)~" and O.TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') and O.TipoOp Not IN ('TRANSF')")
SQL.ADD(" and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND L.Codigo = O.Cliente1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")
If Dialogo.Radio2=0
   SQL.ADD(" AND O.CB13 = 1 ")
   SQL.ADD(" AND O.TipoOp In "~VAR('OPESINT')~" ")
EndIf
*----Cintia 15-12
If Dialogo.Check1=1
   SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"'  ")
EndIf
*-----
*----------------------------------------------------------****

***---if NoVacio(Dialogo.ListaClaves)
***---   SQL.ADD(" order by "~Dialogo.ListaClaves)
***---ELSE
   SQL.ADD(" Order by 1, 2, 3 ")
***---endif

ACT(xx:1, '')

Recorrer SQL
  If Dialogo.Radio1 = 1
    If Not EqStr(FBN['Vehiculo1'], Val(xx:1)) Y Not CeldaVacia(xx:1)
      SetFilaActual(FAC+1)
      ACT(A:FAC, "Vehiculo")
      ACT(B:FAC, "Book")
      ACT(C:FAC, "FechaOp")
      ACT(D:FAC, "F.Vto")
      ACT(E:FAC, "Cliente")
      ACT(F:FAC, "Especie")
      ACT(G:FAC, "CtraEspecie")
      ACT(H:FAC, "Tipo Op.")
      ACT(I:FAC, "Cantidad") 
      ACT(J:FAC, "Precio/Tasa")
      ACT(K:FAC, "Plazo")
      ACT(L:FAC, "Total")
      ACT(M:FAC, "Nro.Ope.")
      ACT(N:FAC, "Op. Contraria")
      ACT(O:FAC, "Ult. Modif.")
      ACT(P:FAC, "Instancia")
      AlinearCeldas(a:FAC..H:FAC,'I')
      AlinearCeldas(I:FAC..L:FAC,'D')
      AlinearCeldas(M:FAC..P:FAC,'I')
      SetFont(a:FAC..P:FAC,2)
      AgregarMarco(a:FAC..P:FAC,2,0,Exe('COLOR'))      
      SetFilaActual(FAC+1)  
    EndIf
  EndIf

  ACT(a:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',FBN['Vehiculo1']),1,25))
  ACT(b:FAC, FBN['Book1'])
  ACT(c:fac, FBN['FechaOp'])
  ACT(d:fac, FBN['FechaVto'])
  ACT(e:fac, Copy(FBN['RazonSocial'],1,25))
  ***---ACT(e:fac, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  ACT(F:fac, FBN['Especie'])
  ACT(G:FAC, FBN['ContraEspecie'])
  IF   Eqstr(fbn('TipoOp'),'MMPCCM')
     if Eqstr(fbn('MB3'),'0')
         ACT(H:FAC, 'MMPCCM'~' - '~'Prestamo')
     Else
     ACT(H:FAC, 'MMPCCM'~' - '~'Colocacion')
     EndIf
  Else
  ACT(H:fac, Copy(FBN['TipoOp']~' '~FBN['Nombre'],1,25))
  EndIf
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Rojo')=1
  ACT(H:FAC, Val(G:FAC)~' (Rojo)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
  ACT(H:FAC, Val(G:FAC)~' (x Pase)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
  ACT(H:FAC, Val(G:FAC)~' (x Arb.)')
  endif


  IF Incluido(FBN['TipoOp'],'MMCPM|MMFCMV|MMFIMV|MMPCCM|MMPCLM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMONM')  ************* Multiple Vtos
  ACN(J:fac, FBN['Precio2'])

  Else 
     IF Not Incluido(FBN['TipoOp'],'COM|COT|CTM|CTT|POM|POT|PTM|PTT|PFM|PFT')
     ACN(J:fac, FBN['Precio1'])
     ENDIF 
  ENDIF                                                                 

   ACN(K:fac, FBN['Plazo'])
   ACN(I:fac, FBN['Cantidad'])

  IF EqStrL(FBN['TipoOp'],'DT',2)
     IF Incluido(FBN['TipoOp'],'DTCAP|DTFLO|DTSFFM|DTSFVM|DTSVVM')
      ACN(I:FAC, FBN['TotalAux3'])
     else
        IF Incluido(FBN['TipoOp'],'DTK|DTKVI|DTSFVX|DTSNFF|DTSNVV')
         ACN(I:FAC, BuscarCampo('CUOTAS', 'Cantidad1', 'NrOperacion',FBN['NrOperacion']))
        ENDIF
     ENDIF
     ACN(L:FAC,0)
  ELSE
    IF Incluido(FBN['TipoOp'], 'FCS|FCR')
     ACN(L:FAC, FBN['TotalNetoCli1'])
    Else
      If Eqstr(Copy(fbn('Tipoop'), 1, 2), 'MM')
       ACN(L:FAC, FBN['Cantidad'])
      Else
       ACN(L:FAC, FBN['TotalBrutoCli1'])
      EndIf
    EndIf
  ENDIF

   ACT(M:fac, FBN['NrOperacion'])
   ACLO(M:fac, FBN['NrOperacion'])

   ACT(N:fac, fbn('NrOperacion3'))

**------------------------------------------------------------------------------------------------
*MUESTRA ÚLTIMA FECHA DE MODIFICACIÓN
SQL.ADD("Select Fecha From "~DBO~".EXCEPCIONES Where Tipo = 'MODEVENTO' ")
SQL.ADD("And NrOperacion = '"~FBN['NrOperacion']~"' ")
Recorrer SQL
  DFA
  ACT(O:fac, fbn('Fecha'))
Proximo
**------------------------------------------------------------------------------------------------
*MUESTRA LA OP VINCULADA
  If VACIO(fbn('Observac5'))
   ACT(N:fac, fbn('NrOperacion3') )
   ACLO(N:fac, fbn('NrOperacion3') )
  EndIf

  IF  Eqstr(fbn('TipoOp'),'MMPCCM') Y Eqstr(fbn('MB3'),'0') 
        ACT(N:fac, VAL(M:fac) ~' - '~fbn('NrOperacion3') ) 
        ACLO(N:fac, fbn('NrOperacion3') )
  ENDIF
**-------------------------------------------------------------------------------------------------
  **------------------------------------------------------------------------------------------------
  *INSTANCIA
  SQL.ADD("Select NrBit From "~DBO~".OPERACIONESBITS Where Valor=1 ")
  SQL.ADD("And NrOperacion = '"~FBN['NrOperacion']~"' ")
  Recorrer SQL
     DFA
     ACT(P:fac,SQL("Select Nombre from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and NrInstancia="~FBN['NrBit']~" ") )
  Proximo
  **------------------------------------------------------------------------------------------------
  
  SetFont(a:FAC..q:FAC,1)
  AlinearCeldas(C:FAC..D:FAC,'D')
  FormatoCeldas(K:fac..K:fac,"0")
  FormatoCeldas(J:fac..J:fac,Exe('F6'))
  ACT(xx:1, FBN['Vehiculo1'])
proximo

SetFilaActual(FAC+2)
ACT(a:FAC,'TRANSFERENCIAS')
SetFont(a:FAC..q:FAC,3)

SetFilaActual(FAC+2)
***********------ TRANSFERENCIAS DE CUENTAS ------**************
ACT(A:FAC, 'Vehiculo')
ACT(B:FAC, 'Book')
ACT(C:FAC, 'FechaOp')
ACT(D:FAC, 'Entidad Origen')
ACT(E:FAC, 'CBU - Entidad Origen')
ACT(F:FAC, 'Especie')
ACT(G:FAC, 'CtraEspecie')
ACT(H:FAC, 'Tipo Op.')
ACT(I:FAC, 'Entidad Destino')
ACT(J:FAC, 'CBU - Entidad Destino')
ACT(K:FAC, '')
ACT(L:FAC, 'Total')
ACT(M:FAC, 'Nro. Ope.')
ACT(N:FAC, 'Op. Contraria')
ACT(O:FAC, "Ult. Modif.")
ACT(P:FAC, "Instancia")
SetFont(a:FAC..P:FAC, 2)
AgregarMarco(a:FAC..P:FAC,2,0,Exe('COLOR'))

SQL.ADD(" SELECT O.Vehiculo1, O.Book1, O.FechaOp,O.FechaVto,O.Especie,O.FechaEj,O.Cliente1,O.Cliente2,O.Cuenta4,O.Cuenta1,")
SQL.ADD(" O.TipoOp,O.NrOperacion,O.Operador, O.Cantidad, O.NrOperacion, ") 
SQL.ADD(" V.Codigo, V.Descripcion, T.Nombre, T.Codigo, O.Observac5 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O,"~DBO~".VEHICULOS V,"~DBO~".TIPOSOPERACION T ") 
SQL.ADD(" WHERE O.TipoOp In ('TRANSF') ")
SQL.ADD(" AND V.Codigo = O.Vehiculo1")
SQL.ADD(" AND T.Codigo = O. TipoOp ")
If Dialogo.Radio2=0
   SQL.ADD(" AND O.CB13 = 1 ")
   SQL.ADD(" AND O.TipoOp In "~VAR('OPESINT')~" ")
EndIf

if NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif


if NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
endif

if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND O.Vehiculo1 in ("~Pipe2Comillas(val(zz:6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif 


if NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND O.TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif


SQL.ADD(" AND O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND ((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")

if NoVacio(Dialogo.Operador)
  SQL.ADD(" AND O.Operador = '"~Dialogo.Operador~"'")
endif

ACT(xx:2,'')

ACN(FI:1, fac+1)
Recorrer SQL
  If Not EqStr(FBN['Vehiculo1'], Val(xx:2)) Y Not CeldaVacia(xx:2)  
    SetFont(a:Val(FI:1)..Q:FAC,1)
    FormatoCeldas(K:Val(FI:1)..K:fac,Exe('F2'))
    SetFilaActual(FAC+1)
    ACT(a:FAC, 'Vehiculo')
    ACT(b:FAC, 'Book')
    ACT(c:FAC, 'FechaOp')
    ACT(d:FAC, 'Entidad Origen')
