ModoReproceso(SinDialogo)
CrearDialogo
   Especie1: 'Especie' ;;;;;;NoVacio(Dialogo.Especie1);'Debe Seleccionar una Especie Valida';;;;;
   Cliente1: 'Codigo'  ;;;;;;NoVacio(Dialogo.Cliente1);'Debe Seleccionar un Cliente Valido';;;;;
FinDialogo


If Not Ok
   Cancelar
Endif

CrearFont(1, 'Arial, 10, B')
CrearFont(2, 'Arial, 12, B')

ACT(a:4, 'Especie')
ACT(b:4, 'Codigo')
SetFont(a:4..a:4, 1)
AlinearCeldas(a:4..b:4, 'C')
AgregarMarco(a:4..b:4,2,0,EXE('COLOR'))


SetFilaActual(5)

*ACT(a1, SQL("Select Especie From "~DBO~".AGENDACUPONES Where Especie = 'ARP' ") )


SQL.ADD(" Select Especie, Cliente1 From "~DBO~".OPERACIONES ") 
SQL.ADD(" Where Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")


*If NoVacio(Dialogo.Especie1)
   *SQL.ADD(" and Especie1 = '"~Dialogo.Especie1~"'")   
*Endif

*If NoVacio(Dialogo.Cliente1)
   *SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"'")   
*Endif

Recorrer SQL
  ACT(a:5, fbn('Especie'))
  ACT(b:5, fbn('Cliente1')) 
  ColorCeldas(a:5..b:5, clRED)
Proximo
         
SetFilaActual(10)

Recorrer&i 1, 1

 ACT(c:&i+11, 'SI')

   If EqStr(Dialogo.Especie1,'') 
      AgregarMarco(a:&i+10..b:&i+10,2,0,EXE('COLOR'))
      ACT(a:&i+10, 'Especie')
      ACT(b:&i+10, 'Codigo') 
      ACT(c:&i+11, 'NO')
   else
      AgregarMarco(a:&i+10..b:&i+10,2,0,EXE('COLOR'))
      ACT(a:&i+10, 'Especie')
      ACT(b:&i+10, 'Codigo') 
      ACT(a:&i+11, Val(a:5))
      ACT(b:&i+11, Val(b:5))
      ACT(d:&i+11, Pad0('OK',4)) 
   Endif  

Proximo

     
    
LimitesVision(p:fac)
SetPrintFit(90)

ACT(a:16, 'Fin de Listado')
SetFont(a:16..a:16, 2)