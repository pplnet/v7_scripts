ifa
ifa
SQL.ADD(" Select  * from ( ")
SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, FechaOp, FechaVto, ")
SQL.ADD("  Precio1 as Tasa, TipoTasa as CodTasa, Spread, Especie1 as CodSpread, Plazo, DiasAnio, ")
* FJL 15/01/20 - Se agrega Termsheet ID
*SQL.ADD("  ObservacDoc as TSID,  ")
* FJL 13/11/20 - Por Issue 4523 se cambia el campo del TS y se agrega TipoCONU
* 13/09/24 Se agrega  CB9 para Operaciones bloqueadas
SQL.ADD("  Termsheet as TSID, TipoCONU, O.CB9, ")
SQL.ADD("  Case When DiasAnio = '0' Then 36000 Else 36500 End Divisor,")
SQL.ADD("  (Select "~DBO~".SaldoCONU(O.NrOperacion,"~IdxDate2(Dialogo.Fecha1)~",2)) as Saldo ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" where (FechaVto >= "~IdxDate2(Dialogo.Fecha1)~"  or CB1=1) ")
SQL.ADD("   and FechaOp <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and TipoOp in ('CONU')")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD(" ) as Aux ")
SQL.ADD(" where Cantidad > Saldo ")
** FJL 30/12/19 - En BofA y SQL2014 da error porque no reconoce O. es esta instancia del Query
*SQL.ADD("Order by O.Especie,O.Cliente1,O.NrOperacion, FechaOp ")
SQL.ADD("Order by Especie,Cliente1,NrOperacion, FechaOp ")
watch(SQL.Batch)
acn(w2,fac+1)


Recorrer SQL
    ACT(a:fac,FBN['NrOperacion'])
    ACLO(a:fac,FBN['NrOperacion'])
    ACD(b:fac,FBN['FechaOp'])
    if FBN['FechaVto']>0
       ACD(c:fac,FBN['FechaVto'])
    endif    
    ACT(d:fac,FBN['Cliente1'])
    ACT(e:fac,FBN['TipoOp'])
    ACT(f:fac,FBN['Especie'])
    ACN(g:fac,FBN['Cantidad'])
    ACT(h:fac,FBN['CodTasa'])    
    if Vacio(FBN['CodTasa'])
       ACN(i:fac,FBN['Tasa'])
    Else
       ACN(i:fac,SQL("select Valor1 from "~DBO~".TASASDIA where TipoTasa = '"~FBN['CodTasa']~"' and Especie ='"~FBN['Especie']~"' and Fecha=  (select Max(Fecha) from "~DBO~".TASASDIA where Fecha<= '"~IdxDate(Dialogo.Fecha1)~"' and TipoTasa = '"~FBN['CodTasa']~"' and Especie ='"~FBN['Especie']~"') "))
    Endif
    FormatoCeldas(i:fac,EXE('F8'))
    ACT(j:fac,FBN['CodSpread'])
    if Vacio(FBN['CodSpread'])
       ACN(k:fac,FBN['Spread'])
    Else
       ACN(k:fac,SQL("Select Precio1 from "~DBO~".COTIZACIONES where Codigo = '"~FBN['CodSpread']~"' and Fecha=  (select Max(Fecha) from "~DBO~".COTIZACIONES where Fecha<= '"~IdxDate(Dialogo.Fecha1)~"' and Codigo = '"~FBN['CodSpread']~"') "))
    Endif
    FormatoCeldas(k:fac,EXE('F8'))
    ACN(l:fac,SQL("SELECT SUM(Monto) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha>="~IdxDate2(PriDeMes(Dialogo.Fecha1,SI))~" and Fecha<="~IdxDate2(Dialogo.Fecha1)~" "))
    AsignarLink(l:fac,'ICLDVD',Fecha1=PriDeMes(Dialogo.Fecha1,SI),Fecha2=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'))
* FJL 15/01/20 - Se agrega Termsheet ID
    if EqStr(FBN['TipoOp'],'CONU')
        ACT(n:fac, FBN['TSID'])
* FJL 13/11/20 - Se agrega TipoCONU
        ACT(o:fac, FBN['TipoCONU'])
    endif
* 13/09/24 Se agrega  Operaciones bloqueadas
    if EqStr(FBN['CB9'], '1') 
        ACT(m:fac,'SI')
    else
        ACT(m:fac,'NO')
    endif

