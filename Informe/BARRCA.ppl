CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1 : 'Cliente'     ;;;;;;;;;;;
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Barriles Cubiertos - Operaciones Vigentes y Notional Amounts')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)

if NoVacio(Dialogo.Lista1)
   ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
   ACT(a:4, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
   ACT(a:5, 'Cliente : '~Dialogo.Cliente1)
else
   ACT(a:5, 'Cliente : Todos')
endif

ACT(a6, 'Dealer')
ACT(b6, 'Nro.Op.')
ACT(c6, 'Producto')
ACT(d6, 'Tipo')
ACT(e6, 'P.Strike')
ACT(f6, 'Volumen')
ACT(g6, 'Un.M.')
ACT(h6, 'F.Inicio')
ACT(i6, 'F.Fin')
ACT(j6, 'Vol. Total')
ACT(k6, 'Vol. Periodo')
ACT(l6, 'Notional Tot.')
ACT(m6, 'Notional Per.')

AgregarMarco(a6..m6, 2,0,Exe('COLOR'))

SetFilaActual(6)

SQL.ADD("Select Vehiculo1, NrOperacion, TipoOp, Cliente1, Cantidad, TotalAux2, TotalAux1, FechaOp2, FechaEj, ")
SQL.ADD("PrecioEj, TipoCambio2, TipoCambio3, MB1, MB3, UMedida from "~DBO~".OPERACIONES")
SQL.ADD("where FechaOp2 <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and FechaEj > '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("and (TipoOp in ('DPBOD','DPDSO','DPDSS','DPS','DPOA','DPOD','DPRC','DPRS','DPRRS','DPSO','DPSS') ")
SQL.ADD(" or (TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL) ) )")
SQL.ADD("order by Vehiculo1, Cliente1, TipoOp, NrOperacion")

BorrarCeldas(z1..z1)

Recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))
    * cambia Cliente
    if NoVacio(Val(z7))
      act(a:fac,'Total '~Val(z7) )
      acn(j:fac, Val(w5))
      acn(k:fac, Val(w6))
      acn(l:fac, Val(w7))
      acn(m:fac, Val(w8))
      BorrarCeldas(w5..w8)
      AgregarMarco(a:fac..m:fac,1)
      SetFont(a:fac..m:fac,1)
      ifa
    endif
    * cambia empresa
    if NoVacio(Val(z1))
      act(a:fac,'Total Empresa '~Val(z1) )
      acn(j:fac, Val(w1))
      acn(k:fac, Val(w2))
      acn(l:fac, Val(w3))
      acn(m:fac, Val(w4))
      BorrarCeldas(w1..w4)
      AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..m:fac,1)
      ifa
    endif
    * Asignar Empresa
    act(z1, fbn('Vehiculo1'))
    act(a:fac,'Empresa '~Val(z1) )
    AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..m:fac,1)
    ifa
    * Asignar cliente
    act(z7, fbn('Cliente1'))
    act(a:fac,Val(z7) )
    AgregarMarco(a:fac..m:fac,1)
    SetFont(a:fac..m:fac,1)
    ifa
  else
    if Not EQstr(fbn('Cliente1'),Val(z7))
      * cambia Cliente
      if NoVacio(Val(z7))
        act(a:fac,'Total '~Val(z7) )
        acn(j:fac, Val(w5))
        acn(k:fac, Val(w6))
        acn(l:fac, Val(w7))
        acn(m:fac, Val(w8))
        BorrarCeldas(w5..w8)
        AgregarMarco(a:fac..m:fac,1)
        SetFont(a:fac..m:fac,1)
        ifa
      endif
      * Asignar cliente
      act(z7, fbn('Cliente1'))
      act(a:fac,Val(z7) )
      AgregarMarco(a:fac..m:fac,1)
      SetFont(a:fac..m:fac,1)
      ifa
    endif
  endif
  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))
  act(c:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
    act(e:fac, fbn('TipoCambio2'))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
      act(e:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
    else
      act(e:fac, fbn('PrecioEj'))
    endif
  endif

  if fbn('FechaOp2') > Dialogo.Fecha1
    ACD(z2, fbn('FechaOp2'))
  else
    ACD(z2, Dialogo.Fecha1)
  endif
  if fbn('FechaEj') <= Dialogo.Fecha2
    ACD(z3, fbn('FechaEj'))
  else
    ACD(z3, Dialogo.Fecha2)
  endif

  * dif dias
  ACN(z4, (Val(z3)-Val(z2))+1)

  * dif meses
  ACN(z6, DifMeses(Val(z3),Val(z2))+1)

  * determinar el signo
  if Incluido(fbn('TipoOp'),'DPSS|DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(d:fac,'Producer')
      acn(z5,1)
    else
      act(d:fac,'Consumer')
      acn(z5,-1)
    endif
  endif

  if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPSO|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra PUT')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta CALL')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta PUT')
      acn(z5,-1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra CALL')
      acn(z5,-1)
    endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Producer')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta Consumer')
      acn(z5,1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Consumer')
      acn(z5,-1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Venta Producer')
      acn(z5,-1)
    endif
  endif
  if EqStr(fbn('TipoOp'),'DPFW')
     if EqStr(fbn('MB3'),'1') 
        act(d:fac,'Venta')
        acn(z5,1)
     endif
     if EqStr(fbn('MB3'),'0') 
        act(d:fac,'Compra')
        acn(z5,-1)
     endif
  endif

  acn(f:fac, fbn('Cantidad'))
  act(g:fac, fbn('UMedida'))
  acd(h:fac, fbn('FechaOp2'))
  acd(i:fac, fbn('FechaEj'))
  acn(j:fac, fbn('TotalAux2')*Val(z5))

  if EqStr(fbn('UMedida'),'BBLSD')
     * Barriles por dia
     acn(k:fac, fbn('Cantidad')*Val(z4)*Val(z5))
  else
     if Incluido(fbn('UMedida'),'BBLSM|TN/MES')
        * por meses
        acn(k:fac, fbn('Cantidad')*Val(z6)*Val(z5))
     endif
  endif

  acn(l:fac, fbn('TotalAux1')*Val(z5))
  acn(m:fac, (fbn('TotalAux1')*ABS(Val(k:fac))/fbn('TotalAux2'))*Val(z5))

  if EqStr(fbn('UMedida'),'ONZAS')
     acn(f:fac,0)
     acn(k:fac,0)
     acn(l:fac,0)

     *-- Onzas por Settlement, recupero las cuotas que intervienen en el periodo
     SQL.ADD("Select C.* From  "~DBO~".CUOTAS C ")
     SQL.ADD("where C.NrOperacion='"~FBN['NrOperacion']~"' ")
     SQL.ADD("and C.Fecha1 > '"~IdxDate(Dialogo.Fecha1)~"' Order By C.Fecha1  ")
         
     Recorrer SQL
       dfa
       scn(f:fac, fbn('Cantidad2')*Val(z5))
       scn(k:fac, fbn('Cantidad1')*Val(z5))
       scn(l:fac, fbn('Cantidad3')*Val(z5))
       Break
     Proximo 
  endif

  scn(w1,Val(j:fac))
  scn(w2,Val(k:fac))
  scn(w3,Val(l:fac))
  scn(w4,Val(m:fac))

  scn(w5,Val(j:fac))
  scn(w6,Val(k:fac))
  scn(w7,Val(l:fac))
  scn(w8,Val(m:fac))

  scn(w9,Val(j:fac))
  scn(w10,Val(k:fac))
  scn(w11,Val(l:fac))
  scn(w12,Val(m:fac))

  SetFont(a:fac..m:fac,2)

proximo
* ultimo total cliente
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total '~Val(z7) )
  acn(j:fac, Val(w5))
  acn(k:fac, Val(w6))
  acn(l:fac, Val(w7))
  acn(m:fac, Val(w8))
  BorrarCeldas(w5..w8)
  AgregarMarco(a:fac..m:fac,1)
  SetFont(a:fac..m:fac,1)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(j:fac, Val(w1))
  acn(k:fac, Val(w2))
  acn(l:fac, Val(w3))
  acn(m:fac, Val(w4))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..m:fac,1)
endif

*- bv1: Link con Informe Ppal
acn(bv1,val(k:fac))

* total gral
ifa
acn(j:fac, Val(w9))
acn(k:fac, Val(w10))
acn(l:fac, Val(w11))
acn(m:fac, Val(w12))
BorrarCeldas(w1..w12)
AgregarMarco(a:fac..m:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..m:fac,2)

ACO(1,10)
ACO(3,19)
ACO(4,9)
ACO(5,5)
ACO(6,6)
ACO(7,4)
ACO(8,6)
ACO(9,6)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
FormatoCeldas(e7..e:fac, Exe('F7'))
FormatoCeldas(f7..f:fac, Exe('F2N'))
FormatoCeldas(j7..m:fac, Exe('F2N'))
AlinearCeldas(e:6..f:fac+1,'D')
AlinearCeldas(j:6..m:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)

*CrearFont(6,"Arial,6,B")
*RangoTitulo(a:5..m:FAC, 2)