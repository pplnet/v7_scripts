  ACT(ii:99,BuscarCampo('ESPECIES','Extendido','Codigo',Fbn['Especie']))
  ACT(zz:99,fbn['Vehiculo1'])
  IF Val(xa:99)=0
    ***---Colocacion
    ACT(ab:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
    ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
    ACT(ba:1,fbn['Cuenta5'])  
    ACT(gg:1,fbn['Cuenta2'])    
    ACT(da:1,fbn['Cuenta4'])      
    ACT(ea:1,fbn['Cuenta1']) 
  else
    ***---Toma
    ACT(ab:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
    ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
    ACT(ba:1,fbn['Cuenta2'])
    ACT(gg:1,fbn['Cuenta5']) 
    ACT(da:1,fbn['Cuenta1'])  
    ACT(ea:1,fbn['Cuenta4'])   
  endIf  
   IF EqStr(fbn['TipoOp'],'SEPVMV')
    ACT(aa:1,' DE TITULOS')
    ACT(bb:1,'de Titulos') 
  else
    ACT(aa:1,' EN EFECTIVO')
    ACT(bb:1,'en Efectivo') 
  endif
   **NO MULTIPLE VENCIMIENTO
   IF EqStr(fbn['TipoOp'],'MMPCCV')
    ACN(jj:1,fbn['TotalIntereses'])
    ACN(kk:1,fbn['TotalIntereses']  * VAR('TASACOMPEN')/100 )

    else
   
   ACN(jj:1,fbn['Precio2'])
   ACN(kk:1,fbn['Precio2']  * VAR('TASACOMPEN')/100)

   endif
