SQL.ADD("Select O.TipoOp, O.Cliente1,O.MB3, O.Especie, O.Cuenta1,O.RB3, O.Vehiculo1,O.Cuenta5,O.TotalBrutoCli1,O.Cuenta2,O.Cuenta4, O.Plazo, O.FechaVto, O.Precio1,O.TotalIntereses,")
SQL.ADD(" O.Cantidad, O.FechaOp,O.TotalIntereses, O.TotalRetenciones, ")
SQL.ADD("C.Precio2")
SQL.ADD(" From "~DBO~".OPERACIONES O  ")
SQL.ADD(" LEFT JOIN "~DBO~".CUOTAS C")
SQL.ADD("  ON C.NrOperacion = O.NrOperacion ")
SQL.ADD(" Where O.NrOperacion ='"~Dialogo.NrOperacion1~"'")

Recorrer SQL
  ACT(zd:99, PYC(fbn['Cantidad'],1,2))
  ACN(zd:88, fbn['Cantidad'])
  ACD(zi:99, fbn['FechaVto'])
  ACT(zj:99, PYC(fbn['Precio1'],1,2))
  ACD(zm:99, fbn['FechaOp'])
  ACN(xa:99,fbn['MB3'])
  ACN(ca:99,fbn['Plazo'])
  ACN(da:99,fbn['TotalBrutoCli1'])
  ACT(ee:99,fbn['Especie'])
