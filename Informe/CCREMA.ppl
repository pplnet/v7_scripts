AgregarMarco(A:Val(FI:2)..J:Val(FI:2), 0, 0, Exe('COLOR8'))

***---Guardo Informacion para Resumen Final
SCN(FR:1, 1)
ACT(TA:Val(FR:1), Val(CL:2))
ACN(TB:Val(FR:1), Val(C:Val(FI:2)))
*ACN(TC:Val(FR:1), Val(H:Val(FI:2)))
ACN(TC:Val(FR:1), Val(I:Val(FI:2)))
ACN(TD:Val(FR:1), Val(F:Val(FI:2)) - Val(G:Val(FI:2)))

ACN(TE:Val(FR:1), Val(TP:1))
ACN(TT:Val(FR:1), Val(X:Val(FI:2)))

SCN(FI:2, 2)
SetFilaActual(Val(FI:2))
IF Dialogo.Radio4 = 0
    ACT(A:fac, 'Total General Vehiculo '~Copy(Dialogo.Vehiculo1, 1, 8))
ELSE
    ACT(A:fac, 'Total General')
ENDIF
ACN(C:fac, Val(TO:3))
*-*ACN(D:fac, Val(TO:6))
ACT(E:fac, Fstr(Val(TO:28)/Val(TO:29), 0, 8)~'%')
ACN(F:fac, Val(TO:9))
ACN(H:fac, Val(TO:12))
ACN(I:fac, Val(TO:13))
ACN(J:fac, Val(TO:18))
ACN(G:fac, Val(TO:21))
ACN(X:fac, Val(TO:28)/Val(TO:29))

*- Para linkear con el informe: General Resumen de Ops. Financieras
*- Interes devengados
ACN(fo2, Val(i:FAC))

AgregarMarco(A:Val(FI:2)..J:Val(FI:2), 0, 0, Exe('COLOR'))
AgregarMarco(A:Val(FI:3)..J:fac, 0, 0)
SetFont(A:fac..J:fac, 2)
FormatoCeldas(D:Val(FI:3)..D:fac, Exe('F2'))

***---Resumen Final

SetFilaActual(fac+2)
ACN(FA:1, fac+1)
SetFilaActual(fac+3)
ACT(C:fac, 'CUENTAS CORRIENTES REMUNERADAS')
AgregarMarco(B:fac..G:fac, 0, 0, Exe('COLOR6'))
SetFont(C:fac, 2)
SetFilaActual(fac+2)
ACT(B:fac, 'RESUMEN POR ENTIDAD')
