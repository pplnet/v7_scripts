AlinearCeldas(C:fac..J:fac+1, 'C')
SetFilaActual(fac+3)
ACN(MM:1, fac)

Recorrer&k 1, Val(FR:1)
    ACT(B:fac, Val(TA:&k))
    ACN(E:fac, Val(TB:&k))
    ACN(F:fac, Val(TC:&k))
    ACN(G:fac, Val(TD:&k) * (-1))
    ACN(H:fac, Val(TE:&k) * (-1))
    ACN(I:fac, Sum(E:fac..H:fac))
    ACT(J:fac, Fstr(Val(TT:&k), 0, 8)~'%')
    ifa
