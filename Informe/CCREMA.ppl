ModoReproceso(SinDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "Fecha Desde"         ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, NO, 'ARG');
  Fecha2     : "Fecha Hasta"         ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Cliente1   : "Entidad"             ;;;;;;;;;;;;;
  Especie1   : "Moneda Oper."        ;1;2;;;;;;;Var('MONEEXTR');;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
  Radio4     : "Consolidado|NO|SI"   ;2;2;;;;;;;0
  Radio1     : 'Expresado|'~Var('MONEEXTR')~'|'~Var('MONELOCA');3;2;;;;;;;0;
  Precio1    : 'Tipo de Cambio'      ;4;1;;[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];[Dialogo.Precio1 > 0] O [Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];'Tipo de Cambio Invalido';NO;;IIF(Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0, CotizacionC(Dialogo.Especie1,,,, Fsys, 1, SI, Var('MONEEXTR'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONEEXTR')),'INV'),-1,1), IIF(Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1, CotizacionC(Dialogo.Especie1,,,, Fsys, 1, SI, Var('MONELOCA'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONELOCA')),'INV'),-1,1),1));;;'###,###.########';
  Vehiculo1  : "Vehiculo"            ;5;1;
  Lista1     : 'Lista Vehic.'        ;;;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")
CrearFont(6,"Arial,8,BU")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACD(FE:5, SumarMeses(Dialogo.Fecha2, -1, 1))
ACD(FE:6, FinDeMes(SumarMeses(Dialogo.Fecha2, -1, 1), SI))

SetFilaActual(2)

ACT(A:fac, 'Detalle de Cuentas Corrientes Remuneradas')
SetFont(A:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha Desde: '~Dialogo.Fecha1)
IF NoVacio(Dialogo.Cliente1)
    ACT(D:fac, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
ELSE
    ACT(D:fac, 'Entidad : Todas')
ENDIF
ifa
ACT(A:fac, 'Fecha Hasta: '~Dialogo.Fecha2)
IF Dialogo.Radio4 = 0
    ACT(D:fac, 'NO Consolidado')
ELSE
    ACT(D:fac, 'Consolidado')
ENDIF
ifa
ACT(A:fac, 'Operaciones en '~Dialogo.Especie1)
IF Dialogo.Radio4 = 0
*    ACT(D:fac, 'Vehiculo : '~Dialogo.Vehiculo1)
    ACT(D:fac, 'Vehiculo : '~Dialogo.Lista1)
ELSE
    ACT(D:fac, 'Vehiculos : '~Dialogo.Lista1)
ENDIF
ifa
IF Dialogo.Radio1 = 0
    ACT(A:fac, 'Expresado en '~Var('MONEEXTR'))
ELSE
    ACT(A:fac, 'Expresado en '~Var('MONELOCA'))
ENDIF
IF [Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1]
    ACT(D:fac, 'Tipo de Cambio: '~Fstr(Dialogo.Precio1, 0, 8))
ENDIF

SetFont(A:fac-3..D:fac, 2)

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha')
ACT(B:fac, 'Numero')
ACT(B:fac+1, 'Minuta')
ACT(C:fac, 'Importe')
ACT(C:fac+1, 'Acumulado')
ACT(D:fac, 'Variacion')
ACT(D:fac+1, 'DEL DIA')
ACT(E:fac, 'Tasa')
ACT(F:fac, 'Interes')
ACT(F:fac+1, 'Diario')
ACT(G:fac, 'Inter. Con')
ACT(G:fac+1, 'Ret. Ganan.')
ACT(H:fac, 'Total')
ACT(H:fac+1, 'Interes')
ACT(I:fac, 'Interes Acum.')
ACT(I:fac+1, 'Deveng. del mes')
ACT(J:fac, 'Inter. Cobrados')
ACT(J:fac+1, 'en el Mes')

AgregarMarco(A:fac..J:fac+1, 0, 0, Exe('COLOR'))
SetFont(A:fac..J:fac+1, 2)
AlinearCeldas(A:fac..J:fac+1, 'C')

ACT(A:1000, '')
ACT(CL:1, '')
ACN(FR:1, 0)
ACN(TO:1, 0)
ACN(TO:2, 0)
ACN(TO:3, 0)
ACN(TO:4, 0)
ACN(TO:5, 0)
ACN(TO:6, 0)
ACN(TO:7, 0)
ACN(TO:8, 0)
ACN(TO:9, 0)
ACN(TO:10, 0)
ACN(TO:11, 0)
ACN(TO:12, 0)
ACN(TO:13, 0)
ACN(TO:16, 0)
ACN(TO:17, 0)
ACN(TO:18, 0)
ACN(TO:19, 0)
ACN(TO:20, 0)
ACN(TO:21, 0)
ACN(TO:22, 0)

*- Vuelvo a dejar el precio como originariamente lo trajo el CotizaEn
ACN(CT:1, IIF(Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0, Dialogo.Precio1^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONEEXTR')),'INV'),-1,1), IIF(Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1, Dialogo.Precio1^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONELOCA')),'INV'),-1,1),1)))
*---TO:1, TO:2 y TO:3 = Totalizadores Columna C
***---TO:4, TO:5 y TO:6 = Totalizadores Columna D
***---TO:7, TO:8 y TO:9 = Totalizadores Columna F
***---TO:10, TO:11 y TO:12 = Totalizadores Columna H
***---TO:13 Totalizadores Columna I
***---TO:16, TO:17 y TO:18 = Totalizadores Columna J
***---TO:19, TO:20 y TO:21 = Totalizadores Columna G
***---TO:22 = Totalizadores Columna E

SetFilaActual(fac+2)

***---Llamo a funcion para generar fechas
(.'GENFECCR'.)

SQL.ADD(" Select O.FechaOp, O.OperacionRef, O.Cliente1, O.Cantidad, O.Plazo, O.TotalIntereses, ")
SQL.ADD(" O.Precio1, O.NrOperacion, O.TotalBrutoCli2 Variacion, C.RazonSocial, 'OPE' as BD1, ")
SQL.ADD(" O.TotalRetenciones Ganancias, O.Especie, O.FechaVto, O.PeriodoInts, O.NrOperacion3 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".CLIENTES C ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND B.NrBit <> 8 ")
SQL.ADD(" AND O.TipoOp = 'MMCCR' ")
*IF Dialogo.Radio4 = 0
*    SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
*ELSE
*    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*ENDIF
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF

SQL.ADD(" UNION ")

***---Select para los intereses cobrados
SQL.ADD(" Select O.FechaPago as FechaOp, '' as OperacionRef, O.Cliente1, 0 as Cantidad, ")
SQL.ADD(" 1 as Plazo, Sum(O.TotalIntereses) as TotalIntereses, 0 as Precio1, '' as NrOperacion, ")
SQL.ADD(" 0 as Variacion, C.RazonSocial, 'VTO' as BD1, Sum(O.TotalRetenciones) Ganancias, ")
SQL.ADD(" O.Especie, '' FechaVto, 0 as PeriodoInts, '' as NrOperacion3 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".CLIENTES C, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND M.NrMov = 3 ")
***---Chequeo que el movimiento del impuesto a las ganancias este ejecutado
***---NrMov 3 = Intereses
***---NrMov 6 = Impuesto a las Ganancias
*SQL.ADD(" AND M.NrOperacion IN (Select NrOperacion From "~DBO~".MOVEJECUTADOS E ")
*SQL.ADD("                       Where M.Cliente = E.Cliente ") 
*SQL.ADD("                       AND M.Especie = E.Especie ")
*SQL.ADD("                       AND M.EnteCustodia = E.EnteCustodia ")
*SQL.ADD("                       AND M.Cuenta = E.Cuenta ")
*SQL.ADD("                       AND E.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("                       AND E.NrMov = 6) ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND B.NrBit <> 8 ")
SQL.ADD(" AND O.TipoOp = 'MMCCR' ")
*IF Dialogo.Radio4 = 0
*    SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
*ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*ENDIF
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
*SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
SQL.ADD(" Group By O.Cliente1, O.FechaPago, C.RazonSocial, O.Especie ")

SQL.ADD(" UNION ")

***---Select para los intereses pendientes mes anterior
SQL.ADD(" Select '' as FechaOp, '' as OperacionRef, O.Cliente1, 0 as Cantidad, ")
SQL.ADD(" 1 as Plazo, Sum(O.TotalIntereses) as TotalIntereses, 0 as Precio1, '' as NrOperacion, ")
SQL.ADD(" 0 as Variacion, C.RazonSocial, 'PEN' as BD1, 0 as Ganancias, ")
SQL.ADD(" O.Especie, '' FechaVto, 0 as PeriodoInts, '' as NrOperacion3 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPENDIENTES M, ")
SQL.ADD(" "~DBO~".CLIENTES C ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" AND M.NrMov = 3 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND B.NrBit <> 8 ")
SQL.ADD(" AND O.TipoOp = 'MMCCR' ")
*IF Dialogo.Radio4 = 0
*    SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
*ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*ENDIF
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND M.FechaMov < '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF

SQL.ADD(" Group By O.Cliente1, C.RazonSocial, O.Especie ")

SQL.ADD(" Order By 3, 1 ,11 ")

Recorrer SQL
    IF Eqstr(fbn('BD1'), 'OPE')
        Message('Procesando Minuta: '~fbn('NrOperacion'))
    ENDIF
    IF Eqstr(fbn('BD1'), 'VTO')
        Message('Procesando Intereses Cobrados Cliente: '~fbn('Cliente1'))
    ENDIF
    IF Eqstr(fbn('BD1'), 'PEN')
        Message('Procesando Intereses Pendientes Cliente: '~fbn('Cliente1'))
    ENDIF
    IF Not Eqstr(fbn('Cliente1'), Val(CL:1)) Y NoVacio(Val(CL:1))
        ***---Cambio de Cliente
        ***---Totalizo meses del cliente anterior
        Recorrer&k Val(FI:3)+1, Val(FI:2)
            ***---Sumarizo los intereses acumulados
            ACN(I:&k, Val(F:&k)+Val(I:&k-1)-Val(J:&k))
            IF Eqstr('Total', Copy(Val(A:&k), 1, 5))
                ***---Total mes
                ACN(C:&k, Val(TO:1))
*-*                ACN(D:&k, Val(TO:4))
                ACN(F:&k, Val(TO:7))
                ACN(H:&k, Val(TO:10))
                ACN(J:&k, Val(TO:16))
                ACN(G:&k, Val(TO:19))
                ACT(E:&k, Fstr(Val(TO:22)/Val(TO:25), 0, 8)~'%')
                ACN(X:&k, Val(TO:22)/Val(TO:25))
                SetFont(C:&k..J:&k, 2)
                SCN(TO:5, Val(TO:4))
                SCN(TO:8, Val(TO:7))
                SCN(TO:11, Val(TO:10))
                SCN(TO:14, Val(TO:13))
                SCN(TO:17, Val(TO:16))
                SCN(TO:20, Val(TO:19))
                ACN(TO:1, 0)
                ACN(TO:4, 0)
                ACN(TO:7, 0)
                ACN(TO:10, 0)
                ACN(TO:16, 0)
                ACN(TO:19, 0)
                ACN(TO:22, 0)
                ACN(TO:25, 0)
            ELSE
                IF Val(A:&k) <> Val(FE:1)
                    ***---Queda totalizado para la ultima fecha del mes informada
                    ACN(TO:1, 0)
                    ACN(TO:4, 0)
                ENDIF
                SCN(TO:1, Val(C:&k))
                SCN(TO:4, Val(D:&k))
                SCN(TO:7, Val(F:&k))
                SCN(TO:10, Val(H:&k))
                SCN(TO:16, Val(J:&k))
                SCN(TO:19, Val(G:&k))
                IF Not CeldaVacia(E:&k)
                    SCN(TO:22, Val(T:&k)*Val(C:&k)*Val(PL:&k))
                    SCN(TO:26, Val(T:&k)*Val(C:&k)*Val(PL:&k))
                    SCN(TO:25, Val(C:&k)*Val(PL:&k))
                    SCN(TO:27, Val(C:&k)*Val(PL:&k))
                    SCN(TO:28, Val(T:&k)*Val(C:&k)*Val(PL:&k))
                    SCN(TO:29, Val(C:&k)*Val(PL:&k))
                ENDIF
                ACD(FE:1, Val(A:&k))
            ENDIF
        Proximo
        ACT(A:Val(FI:3), Val(CL:2))
        AgregarMarco(A:Val(FI:3)..J:Val(FI:3), 0, 0, Exe('COLOR8'))
        SetFont(A:Val(FI:3)..A:Val(FI:2), 2)
        SCN(FI:2, 2)
        ACT(A:Val(FI:2), 'Total '~Copy(Val(CL:2), 1, 27))
        ACN(C:Val(FI:2), Val(C:Val(FI:2)-2))
*-*        ACN(D:Val(FI:2), Val(D:Val(FI:2)-2))
        ACT(E:Val(FI:2), Fstr(Val(TO:26)/Val(TO:27), 0, 8)~'%')
        ACN(X:Val(FI:2), Val(TO:26)/Val(TO:27))
        ACN(F:Val(FI:2), Val(TO:8))
        ACN(H:Val(FI:2), Val(TO:11))
        ACN(I:Val(FI:2), Val(I:Val(FI:2)-2))
        ACN(J:Val(FI:2), Val(TO:17))
        ACN(G:Val(FI:2), Val(TO:20))
        SCN(TO:3, Val(C:Val(FI:2)))
        SCN(TO:6, Val(D:Val(FI:2)))
        SCN(TO:9, Val(TO:8))
        SCN(TO:12, Val(TO:11))
        SCN(TO:15, Val(TO:14))
        SCN(TO:18, Val(TO:17))
        SCN(TO:21, Val(TO:20))
        SCN(TO:13, Val(I:Val(FI:2)))
        ACN(TO:2, 0)
        ACN(TO:5, 0)
        ACN(TO:8, 0)
        ACN(TO:11, 0)
        ACN(TO:17, 0)
        ACN(TO:20, 0)
        ACN(TO:23, 0)
        ACN(TO:26, 0)
        ACN(TO:27, 0)
        AgregarMarco(A:Val(FI:2)..J:Val(FI:2), 0, 0, Exe('COLOR8'))
        SetFont(A:Val(FI:2)..J:Val(FI:2), 2)
        ***---Guardo informacion para Resumen Final
        SCN(FR:1, 1)
        ACT(TA:Val(FR:1), Val(CL:2))
        ACN(TB:Val(FR:1), Val(C:Val(FI:2)))
*        ACN(TC:Val(FR:1), Val(H:Val(FI:2)))
        ACN(TC:Val(FR:1), Val(I:Val(FI:2)))

        *- TD: Retencion a las Ganancias del Mes
        ACN(TD:Val(FR:1), Val(F:Val(FI:2)) - Val(G:Val(FI:2)))

        ACN(TE:Val(FR:1), Val(TP:1))
        ACN(TT:Val(FR:1), Val(X:Val(FI:2)))
        ACN(TP:1, 0)
        SCN(FI:2, 2)
        SetFilaActual(Val(FI:2))
        Recorrer&k Val(FI:3), Val(FI:2)-1
            ***---Pongo marcos Total mes del cliente
            IF Eqstr('Total', Copy(Val(A:&k), 1, 5)) Y Not CeldaVacia(A:&k-1)
                AgregarMarco(A:&k..J:&k, 0, 0, Exe('COLOR6'))
            ENDIF
        Proximo
        AgregarMarco(A:Val(FI:3)..J:fac, 0, 0)
        FormatoCeldas(D:Val(FI:3)..D:fac, Exe('F2'))
        (.'GENFECCR'.)
        ACN(TO:1, 0)
        ACN(TO:4, 0)
        ACN(TO:7, 0)
        ACN(TO:10, 0)
        ACN(TO:16, 0)
        ACN(TO:19, 0)
        ACN(TO:22, 0)
    ENDIF
    ACT(CL:1, fbn('Cliente1'))
    ACT(CL:2, fbn('RazonSocial'))


    IF Eqstr(fbn('BD1'), 'PEN')
       Message('***---Guardo los intereses ptes. para resumen final')
       ACN(TP:1, -fbn('TotalIntereses')*Val(CT:1))
    ENDIF
    Recorrer&k 1, fbn('Plazo')
        ***---Tantos registros como dias de plazo
        Recorrer&j Val(FI:1), Val(FI:2)
            IF [Val(A:&j+&k-1) = fbn('FechaOp')+&k-1] Y [Eqstr(fbn('BD1'), 'OPE')] Y [Val(A:&j+&k) = fbn('FechaOp')+&k O Eqstr(Copy(Val(A:&j+&k), 1, 5), 'Total')]
                ***---Corresponde a la fila del informe
                IF NoVacio(Val(B:&j+&k-1))
                    InsertarFila(&j+&k-1)
                    ACD(A:&j+&k-1, fbn('FechaOp')+&k-1)
                    SCN(FI:2, 1)
                ENDIF
                ACT(B:&j+&k-1, fbn('NrOperacion'))
                ACLO(B:&j+&k-1, fbn('NrOperacion'))
                ACN(C:&j+&k-1, fbn('Cantidad') * Val(CT:1))
                ACN(T:&j+&k-1, fbn('Precio1'))
                ACN(PL:&j+&k-1, fbn('Plazo'))
                ACN(F:&j+&k-1, (fbn('TotalIntereses') * Val(CT:1))/fbn('Plazo'))
                ACN(G:&j+&k-1, (fbn('TotalIntereses') - fbn('Ganancias')) * Val(CT:1)/fbn('Plazo'))
                IF &k = 1
                    ACN(D:&j+&k-1, fbn('Variacion') * Val(CT:1))
                    ACT(E:&j+&k-1, Fstr(fbn('Precio1'), 0, 8)~'%')
                    ACN(H:&j+&k-1, fbn('TotalIntereses') * Val(CT:1))
                    ACN(X:&j+&k-1, fbn('Precio1'))
                ENDIF
                IF &k = fbn('Plazo') Y Eqstr(fbn('BD1'), 'OPE') Y Val(A:&j+&k-1) = fbn('FechaOp')+&k-1 Y Eqstr(fbn('NrOperacion'), Val(B:&j+&k-1)) Y Vacio(fbn('NrOperacion3'))
                    ***---Al dia siguiente vence y no se renueva => Saldo la minuta
                    Recorrer&i Val(FI:1), Val(FI:2)
                        IF Val(A:&i) = fbn('FechaVto')
                            IF NoVacio(Val(B:&i))
                               InsertarFila(&i)
                               SCN(FI:2, 1)
                            ENDIF
                            ACD(A:&i, fbn('FechaVto'))
                            ACT(B:&i, fbn('NrOperacion'))
                            ACLO(B:&i, fbn('NrOperacion'))
                            ACN(D:&i, ((fbn('Cantidad') - fbn('PeriodoInts')) * Val(CT:1)) * -1)
                            Break
                        ENDIF
                    Proximo
                ENDIF
                Break
             ELSE
                IF Eqstr(fbn('BD1'), 'VTO')
                   ***---Registro con Intereses Cobrados
                   IF Val(A:&j) = fbn('FechaOp')
                      ACN(J:&j, (fbn('TotalIntereses') - fbn('Ganancias')) * Val(CT:1))
                      ***---Una sola vez, en la primer fila de la fecha
                      Break
                   ENDIF
                ENDIF
            ENDIF
        Proximo
    Proximo
Proximo

***---Totalizo meses del ultimo cliente
Recorrer&k Val(FI:3)+1, Val(FI:2)
    ***---Sumarizo los intereses acumulados
    ACN(I:&k, Val(F:&k)+Val(I:&k-1)-Val(J:&k))
    IF Eqstr('Total', Copy(Val(A:&k), 1, 5))
        ***---Total mes
        ACN(C:&k, Val(TO:1))
*-*        ACN(D:&k, Val(TO:4))
        ACT(E:&k, Fstr(Val(TO:22)/Val(TO:25), 0, 8)~'%')
        ACN(F:&k, Val(TO:7))
        ACN(H:&k, Val(TO:10))
        ACN(J:&k, Val(TO:16))
        ACN(G:&k, Val(TO:19))
        ACN(X:&k, Val(TO:22)/Val(TO:25))
        SetFont(C:&k..J:&k, 2)
        SCN(TO:2, Val(TO:1))
        SCN(TO:5, Val(TO:4))
        SCN(TO:8, Val(TO:7))
        SCN(TO:11, Val(TO:10))
        SCN(TO:17, Val(TO:16))
        SCN(TO:20, Val(TO:19))
        ACN(TO:1, 0)
        ACN(TO:4, 0)
        ACN(TO:7, 0)
        ACN(TO:10, 0)
        ACN(TO:16, 0)
        ACN(TO:19, 0)
        ACN(TO:22, 0)
        ACN(TO:25, 0)
        AgregarMarco(A:&k..J:&k, 0, 0, Exe('COLOR6'))
    ELSE
        IF Val(A:&k) <> Val(FE:1)
            ***---Queda totalizado para la ultima fecha del mes informada
            ACN(TO:1, 0)
            ACN(TO:4, 0)
        ENDIF
        SCN(TO:1, Val(C:&k))
        SCN(TO:4, Val(D:&k))
        SCN(TO:7, Val(F:&k))
        SCN(TO:10, Val(H:&k))
        SCN(TO:16, Val(J:&k))
        SCN(TO:19, Val(G:&k))
        IF Not CeldaVacia(E:&k)
            SCN(TO:22, Val(T:&k)*Val(C:&k)*Val(PL:&k))
            SCN(TO:26, Val(T:&k)*Val(C:&k)*Val(PL:&k))
            SCN(TO:28, Val(T:&k)*Val(C:&k)*Val(PL:&k))
            SCN(TO:29, Val(C:&k)*Val(PL:&k))
            SCN(TO:25, Val(C:&k)*Val(PL:&k))
            SCN(TO:27, Val(C:&k)*Val(PL:&k))
        ENDIF
        ACD(FE:1, Val(A:&k))
    ENDIF
Proximo
