CrearDialogo
   Fecha1   : 'Fecha'                             ;;;;;;;;;FSys;
   Radio1   : 'Vehc. Consol |Si |No'              ;;;;;;;;;0;
   Vehiculo1: 'Vehiculo'                          ;;;;;
   Radio2   : "Cuad. Consol |Pesos |Dolares"      ;;;;;;;;;0;
   Radio10  : "Tasa Simulad |Si |No"              ;;;;;NO;;;;0;
   Radio3   : "Minutas |Reales |Reales-Simuladas" ;;;;;NO;;;;0;
   Radio4   : 'Automatico|SI|NO'                  ;;;;NO;NO;;;;1;;
   Especie1 : 'Moneda'                            ;;;;NO;NO;;;;
   Precio1  : 'Cot USD Cuadro Consolidado'        ;;;;;;;;;4;
   Lista1   : 'Lista Monedas Cotiz'               ;;;;;;;;;;;'EUR|';
   Lista2   : 'Cotizacion Monedas'                ;;;;;;;;;;;'2|';
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1, "Arial, 8,")
CrearFont(2, "Arial, 8,B")
CrearFont(3, "Arial, 9,")
CrearFont(4, "Arial, 9,B")
CrearFont(5, "Arial, 10,B")
CrearFont(6, "Arial, 12,BU")

ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))
ACT(MU:1, Var('MONEEURO'))

***---Para el cuadro en ARP no se usan cotizaciones
***---Para el cuadro en USD, se usan las cotizaciones del cuadro en USD del cashflow
***---Para el cuadro Consolidado, se usa la cotizacion del USD del cuadro consolidado del cashflow

*--> Variable MONELOCA en JDE
ACT(ML:2, BuscarCampo('ESPECIES', 'Alias5', 'Codigo', Var('MONELOCA')) )
ACT(ML:3, BuscarCampo('ESPECIES', 'Alias6', 'Codigo', Var('MONELOCA')) )

*--> Variable MONEEXTR en JDE
ACT(ME:2, BuscarCampo('ESPECIES', 'Alias5', 'Codigo', Var('MONEEXTR')) )
ACT(ME:3, BuscarCampo('ESPECIES', 'Alias6', 'Codigo', Var('MONEEXTR')) )

IF NoVacio(Dialogo.Vehiculo1)
    ***---Obtengo Vehiculo JDE
    ACT(VH:1, Pad0(BuscarCampo('VEHICULOS', 'Valor5', 'Codigo', Dialogo.Vehiculo1), 5))
ENDIF

SetFilaActual(1)
ACT(E:fac, 'Apertura Posicion Bancaria')
SetFont(E:fac, 6)

SetFilaActual(fac+2)
ACN(fa:1, fac)
ACT(a:fac, 'Fecha: '~Dialogo.Fecha1)

ACD(FJ:1, Dialogo.Fecha1)
ACD(FJ:2, Habiles(Dialogo.Fecha1, -1, 'ARG', NO))
ifa
If Vacio(Dialogo.Vehiculo1)
   ACT(a:fac, 'Vehiculo: Todos')
Else
   ACT(a:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
EndIf

ifa
IF Dialogo.Radio1 = 0
   ACT(A:fac, 'Consolidado: SI')
ELSE
   ACT(A:fac, 'Consolidado: NO')
ENDIF

ifa
ACT(a:fac, 'Cuadro Consolidado: '~IIF(Dialogo.Radio2=0, 'Pesos', 'Dolares') )

SetFont(a:Val(fa:1)..j:fac, 4)
ACN(fl:2, fac)

*--> Para acumular el total
ACN(kk:1, 1551)

*--> Columna donde empieza el seteo de las fechas
ACN(vt:1, 4)

***---LM:1-1 = Ultima Columna diaria
***---LM:2-1 = ultima Columna mensual
ACN(BD:1, 0)
ACN(BD:88, 0)
***---Cuadro en ARP
ACN(CZ:2, 3)
(.'APBC1'.)
***---Cuadro en USD
ACN(fl:2, fac-1)
ACN(CZ:2, 4)
(.'APBC1'.)
***---Fila Fechas Cuandro ARP
ACN(FX:1, Val(FI:1))
***---Cuadro Consolidado
ACN(CZ:2, 5)
ACN(fl:2, fac-1)
(.'RCABCUADRO'.)
ifa
IF Val(BD:1) = 0 Y Val(BD:88) = 0
    SetFont(A:Val(PI:1)..Val(LM:2):Val(PI:1)+5, 2)
    SetFont(A:Val(DI:1)..Val(LM:2):Val(DI:1)+5, 2)
    AgregarMarco(A:Val(PI:1)+1..Val(LM:2):Val(PI:1)+1, 0, 0, Exe('COLOR6'))
    AgregarMarco(A:Val(DI:1)+1..Val(LM:2):Val(DI:1)+1, 0, 0, Exe('COLOR6'))
    ifa
    ACT(A:fac, 'TOTAL')
    Recorrer&k 4, Val(LM:2)
        ACN(&k:fac+1, 0)
        ACN(&k:fac+2, 0)
        ACN(&k:fac+3, 0)
        ACN(&k:fac+4, 0)
    Proximo
    ifa
    ACT(A:fac, 'Saldo Real')
    ifa
    ACT(A:fac, 'Cheques Pendientes')
    ifa
    ACT(A:fac, 'Descubierto')
    ifa
    ACT(A:fac, 'A Cubrir')
    SetFont(A:fac-4..Val(LM:2):fac, 2)
    AgregarMarco(A:fac-4..Val(LM:2):fac-4, 0, 0, Exe('COLOR6'))
ELSE
    ***---Fila Inicial Consolidado
    ACN(FI:10, fac)
    IF Val(BD:1) > 0
        ***---Recorro Cuadro en ARP y lo pego
        Recorrer&k Val(PI:1), Val(PF:1)
            Recorrer&j 1, Val(LM:2)
                IF &j <=3
                    ACT(&j:fac, Val(&j:&k))
                ELSE
                    IF CeldaVacia(Val(LM:2)+10:&k)
                        IF Dialogo.Radio2 = 0
                            ACN(&j:fac, Val(&j:&k))
                            ACN(TC:2, 1)
                        ELSE
                            ACN(&j:fac, Val(&j:&k) / Dialogo.Precio1)
                            ACN(TC:2, 1 / Dialogo.Precio1)
                        ENDIF
                    ENDIF
                ENDIF
            Proximo
            ACT(Val(LM:2)+10:fac, Val(Val(LM:2)+10:&k))
            ACT(CX:fac, Val(CX:&k))
            ifa
        Proximo
    ENDIF
    IF Val(BD:88) > 0
        IF Dialogo.Radio2 = 0
            ACN(TC:2, Dialogo.Precio1)
        ELSE
            ACN(TC:2, 1)
        ENDIF
        ACN(FF:10, fac)
        ACN(EX:1, 0)
        ***---Contador Saldo Real Consolidado
        ACN(SR:1, 0)
        ***---Contador Cheques Ptes Consolidado
        ACN(CH:1, 0)
        ***---Fila donde acumula Totales Descubiertos para Consolidado
        ACN(FD:1, 500)
        ***---Fila donde acumula Totales A cubrir para Consolidado
        ACN(FA:1, 501)
        Recorrer&k Val(DI:1), Val(DF:1)
            Recorrer&j Val(FI:10), Val(FF:10)
                IF Not CeldaVacia(Val(LM:2)+10:&k) Y Not CeldaVacia(Val(LM:2)+10:&j)
                    IF Eqstr(Val(Val(LM:2)+10:&k), Val(Val(LM:2)+10:&j))
                        ***---Existe la cuenta en el consolidado
                        ACN(EX:1, 1)
                        ***---Fila donde encuentro la Cuenta
                        ACN(FS:1, &j)
                        Break
                    ELSE
                        ***---No existe la cuenta => la inserto
                        ACN(EX:1, 2)
                    ENDIF
                ENDIF
            Proximo
            IF Val(EX:1) = 1
                ***---Sumo datos de la cuenta encontrada
                Recorrer&i 4, Val(LM:2)
                    SCN(&i:Val(FS:1)+1, Val(&i:&k+1)*Val(TC:2))
                    SCN(&i:Val(FS:1)+2, Val(&i:&k+2)*Val(TC:2))
                    SCN(&i:Val(FS:1)+3, Val(&i:&k+3)*Val(TC:2))
                    SCN(&i:Val(FS:1)+4, Val(&i:&k+4)*Val(TC:2))
                    IF &i = 4
                        SCN(SR:1, Val(&i:Val(FS:1)+1))
                    ELSE
                        IF &i = 5
                            SCN(CH:1, Val(&i:Val(FS:1)+2))
                        ENDIF
                    ENDIF
                    SCN(&i:Val(FD:1), Val(&i:Val(FS:1)+3))
                    SCN(&i:Val(FA:1), Val(&i:Val(FS:1)+4))
                Proximo
                ACN(EX:1, 3)
            ELSE
                IF Val(EX:1) = 2
                    ACT(A:fac, Val(A:&k))
                    ***---Fila donde inserto la cuenta
                    ACN(FC:1, fac)
                    ACN(EX:1, 0)
                ELSE
                    IF Val(EX:1) = 0
                        ***---Pego la linea porque es de una cuenta insertada
                        ifa
                        Recorrer&i 1, Val(LM:2)
                            IF &i > 3
                                IF Val(BD:1) > 0 O Not Buscar('Cuenta', Val(A:fac))
                                    ***---Si no hay cuentas en ARP, para que no ponga en cero las columnas de las filas de las cuentas
                                    ACN(&i:fac, Val(&i:&k)*Val(TC:2))
                                ENDIF
                                IF &i = 4 Y fac = Val(FC:1) + 1
                                    ***---Sumo Saldo Real de la cuenta insertada
                                    SCN(SR:1, Val(&i:&k)*Val(TC:2))
                                ELSE
                                    IF &i = 5 Y fac = Val(FC:1) + 2
                                        ***---Sumo Cheques Ptes de la cuenta insertada
                                        SCN(CH:1, Val(&i:&k)*Val(TC:2))
                                    ENDIF
                                    IF Val(FC:1) + 3 = fac
                                        SCN(&i:Val(FD:1), Val(&i:&k)*Val(TC:2))
                                    ELSE
                                        IF Val(FC:1) + 4 = fac
                                            SCN(&i:Val(FA:1), Val(&i:&k)*Val(TC:2))
                                        ENDIF
                                    ENDIF
                                ENDIF
                            ELSE
                                 ACT(&i:fac, Val(&i:&k))
                            ENDIF
                        Proximo
                    ENDIF
                ENDIF
            ENDIF
        Proximo
    ENDIF
    ifa
    ACT(A:fac, 'TOTAL')
    ifa
    ACT(A:fac, 'Saldo Real')
    Recorrer&k 4, Val(LM:2)
        IF Dialogo.Radio2 = 0
            IF &k = 4
                ACN(D:fac, Val(D:Val(PF:1)+2) + (Val(D:Val(DF:1)+2)*Dialogo.Precio1))
                ACN(D:fac+1, 0)
            ELSE
                IF &k = 5
                    ACN(E:fac+1, Val(E:Val(PF:1)+3) + (Val(E:Val(DF:1)+3)*Dialogo.Precio1))
                ELSE
                    ACN(&k:fac+1, 0)
                ENDIF
                ACN(&k:fac, 0)
            ENDIF
            ACN(&k:fac+2, Val(D:Val(PF:1)+4) + (Val(D:Val(DF:1)+4)*Dialogo.Precio1))
            ACN(&k:fac+3, Val(D:Val(PF:1)+5) + (Val(D:Val(DF:1)+5)*Dialogo.Precio1))
        ELSE
            IF &k = 4
                ACN(D:fac, (Val(D:Val(PF:1)+2)/Dialogo.Precio1) + Val(D:Val(DF:1)+2))
                ACN(D:fac+1, 0)
            ELSE
                IF &k = 5
                    ACN(E:fac+1, (Val(E:Val(PF:1)+3)/Dialogo.Precio1) + Val(E:Val(DF:1)+3))
                ELSE
                    ACN(&k:fac+1, 0)
                ENDIF
                ACN(&k:fac, 0)
            ENDIF
            ACN(&k:fac+2, (Val(D:Val(PF:1)+4)/Dialogo.Precio1) + Val(D:Val(DF:1)+4))
            ACN(&k:fac+3, (Val(D:Val(PF:1)+5)/Dialogo.Precio1) + Val(D:Val(DF:1)+5))
        ENDIF
    Proximo
    ifa
    ACT(A:fac, 'Cheques Pendientes')
    ifa
    ACT(A:fac, 'Descubierto')
    ifa
    ACT(A:fac, 'A cubrir')
    IF Val(BD:1) = 0
        ***---Si no hay cuadro en ARP, copio Totales USD
        Recorrer&k 4, Val(LM:2)
            ***---Saldo Real
            ACN(&k:fac-3, Val(&k:Val(FX:2)+1) * Val(TC:2))
            ***---Cheques Ptes
            ACN(&k:fac-2, Val(&k:Val(FX:2)+2) * Val(TC:2))
            ***---Descubierto
            ACN(&k:fac-1, Val(&k:Val(FX:2)+3) * Val(TC:2))
            ***---A Cubrir
            ACN(&k:fac, Val(&k:Val(FX:2)+4) * Val(TC:2))
            ***---A Cubrir para CashFlow
            ACN(&k:5002, Val(&k:Val(FX:2)+4) * Val(TC:2))
        Proximo
    ENDIF
    IF Val(BD:88) = 0
        ***---Si no hay cuadro en USD, copio Totales ARP
        Recorrer&k 4, Val(LM:2)
            ***---Saldo Real
            ACN(&k:fac-3, Val(&k:Val(FX:3)+1) * Val(TC:2))
            ***---Cheques Ptes
            ACN(&k:fac-2, Val(&k:Val(FX:3)+2) * Val(TC:2))
            ***---Descubierto
            ACN(&k:fac-1, Val(&k:Val(FX3)+3) * Val(TC:2))
            ***---A Cubrir
            ACN(&k:fac, Val(&k:Val(FX:3)+4) * Val(TC:2))
            ***---A Cubrir para CashFlow
            ACN(&k:5002, Val(&k:Val(FX:2)+4) * Val(TC:2))
        Proximo
    ENDIF
    ACN(FF:10, fac)
    ***---Seteo de Formatos
    ***---Cuadro en Pesos
    SetFont(1:Val(PI:1)..3:Val(PF:1), 2)
    SetFont(4:Val(PI:1)..Val(LM:2):Val(PF:1), 1)
    SetFont(1:Val(PF:1)+1..Val(LM:2):Val(PF:1)+5, 2)
    Recorrer&k Val(PI:1), Val(PF:1)
        IF Buscar('cubrir', Val(A:&k))
*            AgregarMarco(A:&k..Val(LM:2):&k, 0, 0, Exe('COLOR6'))
            SetFont(A:&k..Val(LM:2):&k, 2)
        ENDIF
    Proximo
    FormatoCeldas(4:Val(PI:1)..Val(LM:2):Val(PF:1)+5, Exe('F2'))
    AgregarMarco(A:Val(PF:1)+1..Val(LM:2):Val(PF:1)+5, 0, 0, Exe('COLOR'))
***---    AgregarMarco(A:Val(PF:1)+2..Val(LM:2):Val(PF:1)+5, 0, 0)
    ***---Cuadro en USD
    SetFont(1:Val(DI:1)..3:Val(DF:1)+5, 2)
    SetFont(4:Val(DI:1)..Val(LM:2):Val(DF:1), 1)
    SetFont(1:Val(DF:1)+1..Val(LM:2):Val(DF:1)+5, 2)
    Recorrer&k Val(DI:1), Val(DF:1)
        IF Buscar('cubrir', Val(A:&k))
*            AgregarMarco(A:&k..Val(LM:2):&k, 0, 0, Exe('COLOR6'))
            SetFont(A:&k..Val(LM:2):&k, 2)
        ENDIF
    Proximo
    FormatoCeldas(4:Val(DI:1)..Val(LM:2):Val(DF:1)+5, Exe('F2'))
    AgregarMarco(1:Val(DF:1)+1..Val(LM:2):Val(DF:1)+5, 0, 0, Exe('COLOR'))
***---    AgregarMarco(1:Val(DF:1)+2..Val(LM:2):Val(DF:1)+5, 0, 0)
    ***---Cuadro en Consolidado
    SetFont(1:Val(FI:10)..3:Val(FF:10)-5, 2)
    SetFont(4:Val(FI:10)..Val(LM:2):Val(FF:10)-5, 1)
    SetFont(1:Val(FF:10)-4..Val(LM:2):Val(FF:10), 2)
    FormatoCeldas(4:Val(FI:10)..Val(LM:2):Val(FF:10), Exe('F2'))
    AgregarMarco(1:Val(FF:10)-4..Val(LM:2):Val(FF:10), 0, 0, Exe('COLOR'))
***---    AgregarMarco(1:Val(FF:10)-3..Val(LM:2):Val(FF:10), 0, 0)
    Recorrer&k Val(FI:10), Val(FF:10)-4
        IF Buscar('Cuenta:', Val(A:&k))
            AgregarMarco(A:&k..C:&k, 0, 0, Exe('COLOR6'))
        ELSE
            IF Buscar('cubrir', Val(A:&k))
                AgregarMarco(A:&k..Val(LM:2):&k, 0, 0, Exe('COLOR6'))
                SetFont(A:&k..Val(LM:2):&k, 2)
            ENDIF
        ENDIF
    Proximo
ENDIF

SetFilaActual(fac+3)

ACT(a:fac, 'Fin del Informe')
SetFont(a:fac, 4)

FijarCol(4)

ACO(1, 7)
ACO(2, 7)
ACO(3, 30)

SetPrintFit(3,70)
Impresion(1,2)
RangoTitulo(a:1..Val(lm:2):fac,10)
LimitesVision(Val(lm:2)+1:fac+2)
