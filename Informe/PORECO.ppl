CrearDialogo
  Fecha1:    'Fecha'    ;;;;;;;;;
  Especie1:  'Especie'  ;;;;;;;;;
  Vehiculo1: 'Vehiculo' ;;;;;;;;;
  Book1:     'Book'     ;;;;;;;;;
  String1:   'Cupon'    ;;;;;;;;;
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,BU')

ACT(a:2,'Posicion de Revaluo Contable')
SetFont(a:2,3)

SetFilaActual(4)

ACT(a:fac, 'Fecha: '~Dialogo.Fecha1)
ACT(a:fac+2, 'Especie: '~Dialogo.Especie1)
ACT(a:fac+3, 'Book: '~Dialogo.Book1)

SetFont(a:fac..a:fac+3, 2)

SetFilaActual(fac+5)

ACT(a:fac, 'Inicio')
ACT(b:fac, 'Precio Inicio')
ACT(c:fac, 'Cantidad Compra')
ACT(d:fac, 'Precio Compra')
ACT(e:fac, 'Cantidad Venta')
ACT(f:fac, 'Precio Venta')
ACT(g:fac, 'Valor Nominal')

AgregarMarco(a:fac..g:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..g:fac, 2)
AlinearCeldas(a:fac..g:fac, 'C')

SQL.ADD(" Select P.CantidadIni, P.PrecioIni, P.Cantidad1, P.Precio1, P.Cantidad2, P.Precio2, P.CantidadFin ")
SQL.ADD(" From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND P.Cliente = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND P.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND P.CantidadFin <> 0 ")
SQL.ADD(" AND P.Book = '"~Dialogo.Book1~"' ")
SQL.ADD(" AND P.Cupon = '"~Dialogo.String1~"' ")
SQL.ADD(" AND P.NrSaldo = '171' ")
SQL.ADD(" AND P.Fecha IN (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD("      Where P1.Especie = P.Especie ")
SQL.ADD("      AND P1.Vehiculo = P.Vehiculo ")
SQL.ADD("      AND P1.Cliente = P.Cliente ")
SQL.ADD("      AND P1.NrSaldo = P.NrSaldo ")
SQL.ADD("      AND P1.Book = P.Book ")
SQL.ADD("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
SQL.ADD("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
SQL.ADD("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
SQL.ADD("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
SQL.ADD("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
SQL.ADD("      AND P1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
Recorrer SQL
  ACN(a:fac,FBN['CantidadIni'])
  ACN(b:fac,FBN['PrecioIni'])
  ACN(c:fac,FBN['Cantidad1'])
  ACN(d:fac,FBN['Precio1'])
  ACN(e:fac,FBN['Cantidad2'])
  ACN(f:fac,FBN['Precio2'])
  ACN(g:fac,FBN['CantidadFin'])
  
  FormatoCeldas(a:fac, EXE('F2'))
  FormatoCeldas(c:fac, EXE('F2'))
  FormatoCeldas(e:fac, EXE('F2'))
  FormatoCeldas(g:fac, EXE('F2'))
  FormatoCeldas(b:fac, EXE('F8'))
  FormatoCeldas(d:fac, EXE('F8'))
  FormatoCeldas(f:fac, EXE('F8'))
Proximo

LimitesVision(h:fac+1)

ACO(1,10)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
