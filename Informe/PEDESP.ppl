GrillaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Fecha'     ;;;;;;;;;FSys
  Vehiculo1 : 'Vehiculo'  ;;;;;;;;;Var('VEHICULODE')
  Mercado1  : 'Mercado'   ;
  Cliente1  : 'Cliente'   ;
  Especie1  : 'Especie'   ;
  Check1    : 'Titulos'   ;;;;  ;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check13>0;'Debe seleccionar un grupo de operaciones';NO;1;
  Check2    : 'F.Exchange';;;;;;;;;0;
  Check3    : 'M.Market'  ;;;;;;;;;0;
  Check4    : 'Rofex'     ;;;;;;;;;0;
  Check5    : 'OCT'       ;;;;;;;;;0;
  Check13   : 'COM. MAE1' ;;;;;;;;;0;


FinDialogo

if Not OK
  Cancelar
endif

if Incluido(Dialogo.Mercado1,Var('MERCAACMC'))
   Cancelar('El Mercado es Incorrecto.')
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')

SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC,'Pendientes / Detalle por Especie')
ACT(a:FAC+1,'Cliente: '~iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(a:FAC+2,'Especie: '~iif(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todos'))
ACT(a:FAC+3,'Mercado: '~iif(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
ACT(a:FAC+4,'Fecha: '~Dialogo.Fecha1)

ACT(a:FAC+6,'')
ACT(b:FAC+6,'')
ACT(c:FAC+6,'')
ACT(d:FAC+6,'Mercado')
ACT(e:FAC+6,'Boleto')
ACT(f:FAC+6,'Inicio')
ACT(g:FAC+6,'Importe')
ACT(h:FAC+6,'Intereses')
ACT(i:FAC+6,'Monto')
ACT(j:FAC+6,'Observaciones')

AlinearCeldas(g:FAC+6..i:FAC+6,'D')
SetFont(a:FAC..o:FAC+6,2)
AgregarMarco(a:FAC+6..j:FAC+6,1,3,Exe('COLOR'))

SetFilaActual(FAC+6)

SQL.ADD("Select M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, M.NrOperacion, ")
SQL.ADD("M.Status, M.NrMov, O.TipoOp, M.Concepto, M.Mercado, ")
SQL.ADD(" O.ContraEspecie, O.TotalNetoCli1, M.Leyenda, O.FormaLiquidacion1, O.PaseCB, O.FechaOp, ")
SQL.ADD("O.NrBoleto, O.TotalIntereses ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = O.NrOperacion")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.Cliente = O.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check1=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'RF' ")
endif
if Dialogo.Check5=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
endif

if Dialogo.Check13=0
   SQL.ADD("and M.NrGrupo <> 15   ") 
endif


SQL.ADD(" and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and M.Bits IN ('MV','MI') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD(" and M.Mercado not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
*SQL.ADD("and ((M.Status <> 'MATCH' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
SQL.ADD("and B.NrBit in (70,10) ")
SQL.ADD("and B.Valor = '1' ") 
SQL.ADD("Order By 3, 2, 9, 14, 7, 6")

*  W1 : Fila Actual
*  V1 : Fecha de Movimiento
*  V2 : Cliente
*  V3 : Especie
*  V4 : Tipos Operacion
*  V5 : Mercado

*  Z1 : Acumulador de la Cantidad
*  Z2 : Acumulador del TotalNetoCli
*  Z3 : Contador (cant. de registros equivalente al nivel mas interior de corte de control standard)
*  Z4 : Acumulador de TotalIntereses
*

recorrer SQL

   
  if Not EqStr(fbn('Cliente'),Val(v2)) o Not EqStr(fbn('Especie'),Val(v3)) o Not Eqstr(fbn('TipoOp'), val(v4)) o Not Eqstr(fbn('Mercado'), val(v5)) 
    *
    * Si la Especie o Cliente son distintas a su  Valor anterior, o es la primera vez.     
    *

    if FAC>Val(w1)+7 y Val(z3)>0
      *
      * Mostrado de Totales y reseteo de variables?
      * (si hubo al menos un registro) 
      *
       
      ACT(D:FAC, 'Total')
      ACN(G:FAC, Val(z1))
      ACN(H:FAC, Val(Z4))

      ACN(z1,0)
      ACN(z2,0)
      ACN(z3,0)
      ACN(Z4,0)
      SetFont(g:FAC..i:FAC,2)
      SetFilaActual(FAC+2)
    endif
      
    if Not EqStr(fbn('Especie'),Val(v3))
      if FAC>Val(w1)+7
        AgregarMarco(a:FAC..m:FAC,2)
        SetFont(a:FAC,2)
        IFA
      endif
      
      ACT(v3, fbn('Especie'))
      ACT(a:FAC, 'Especie: '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie'))~' - '~BuscarCampo('ESPECIES','Extendido','Codigo',fbn('Especie')))
      SetFont(a:FAC,4)
      ifa
      * Fuerza a que se impriman los titulos de los niveles inferiores de los cortes de control.
      act(v2, '**') 
      act(v4, '**') 
      ACN(v1, -1)
    endif

    if Not Eqstr(fbn('Cliente'), val(v2)) 
       ACT(v2, fbn('Cliente'))
       ACT(v3, '**')
       ACT(b:FAC, 'Cliente: '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')))
       SetFont(b:FAC,3)
       ifa
       act(v4, '**') 
    endif

    if Not Eqstr(fbn('TipoOp'), val(v4)) 
       ACT(v4, fbn('TipoOp'))       
       * Sera necesario poner esta linea?
       ACT(v3, '**')        
       ACT(c:FAC, 'Tipo Operacion: '~BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
       SetFont(c:FAC,2)
       ifa
    endif
                              
    if Not EqStr(fbn('Especie'),Val(v3))
      ACT(v3, fbn('Especie'))
                                 
    endif
                           
    ACT(v5,fbn('Mercado'))
    ACT(d:FAC,Val(v5))
    SetFont(d:FAC,2)
  endif
  ACT(e:FAC, fbn('NrBoleto'))
  ACD(F:FAC, fbn('FechaOp'))
  ACN(G:FAC, -fbn('Cantidad'))
  ACN(H:FAC, -fbn('TotalIntereses'))

  * Por qué tan restrictivo?
  if EqStr(fbn('Status'),'MATCH')
    if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV')
      if Incluido(fbn('TipoOp'),'TIC|TIFC')
        ACN(i:FAC, -fbn('TotalNetoCli1'))
        SCN(z2, -fbn('TotalNetoCli1'))
      else
        ACN(i:FAC, fbn('TotalNetoCli1'))
        SCN(z2, fbn('TotalNetoCli1'))
      endif
    endif
  endif
  ACT(j:FAC, fbn('Leyenda'))
 
  SCN(z4, fbn('TotalIntereses'))
  SCN(z1, -fbn('Cantidad'))
  SCN(z3, 1)

  SetFont(d:FAC..m:FAC,1)

proximo

if FAC > Val(w1)+6 y Val(z3) > 0
  IFA
  ACT(F:FAC, 'Total ')
  ACN(G:FAC, Val(z1))
  ACN(H:FAC, Val(Z4))
  
  SetFont(g:FAC..i:FAC,2)
endif

FormatoCeldas(h:Val(w1)+7..i:FAC,Exe('F2'))

ACO(1,4)
ACO(2,4)
ACO(3,4)
ACO(4,6)
ACO(5,7)
ACO(6,7)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10, 10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
SetFont(c15..c:fac, 2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(l:FAC)
RangoTitulo(a:1..l:FAC, Val(w1)+6)