HojaVisible(NO)
CrearDialogo
   Fecha1    : 'Fecha Vigencia'                         ;1;1;;;;;;;;FSYS
   Radio1    : 'Vehiculos|Todos|Algunos'                ;;;;;;;;;0;
   Lista1    : 'Vehiculo'                               ;;;;Dialogo.Radio1=1 ;;;;;;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Radio2    : 'Consolidado|NO|SI'                      ;;;;;;;;;0;
   Precio1   : 'Cot.USD/ARP'                            ;;;;;;Dialogo.Precio1>0;'La cotizacion del USD contra el peso debe ser mayor a cero';NO;0;
   Radio3    : 'Plazo|Corto|Largo|Corto+Largo|Variacion';;;;NO;NO;;;;2;
FinDialogo

If Not Ok
   Cancelar
Endif

If Dialogo.Radio1=0
   If Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD("SELECT Codigo FROM "~DBO~".VEHICULOS ")
      SQL.ADD("WHERE  (Status='HAB' or Status Is Null or Status='') ")
      
      Recorrer SQL
         ACT(ga1, FBN['Codigo']~'|'~Val(ga1))
      Proximo
   Else 
      SQL.ADD("SELECT U.Vehiculo FROM "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V ")
      SQL.ADD("WHERE  U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo ")
      SQL.ADD("       and (Status='HAB' or Status Is Null or Status='')")

      Recorrer SQL
         ACT(ga1, FBN['Vehiculo']~'|'~Val(ga1))
      Proximo
   Endif
Else
   ACT(ga1, Dialogo.Lista1)
Endif


If Dialogo.Radio2=1
*- Consolidado SI
   *- Corto Plazo
   LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga1),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=0,Check1=0, Radio3 = 1)

   *- Largo Plazo
   LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga1),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=1,Check1=0, Radio3 = 1)

   *- Corto+Largo
   LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga1),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=2,Check1=1, Radio3 = 1)
   
   *- Variacion
   LinkearHoja('VARROF',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga1),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=3)      
Else
*- Consolidado NO
   ACN(ga2, Elementos(Val(ga1)))
   Recorrer&i 1, Val(ga2)
      ACT(ga3, ItemLista(Val(ga1),&i))
      *- Corto Plazo
      LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga3),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=0,Check1=0, Radio3 = 1)

      *- Largo Plazo
      LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga3),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=1,Check1=0, Radio3 = 1)

      *- Corto+Largo
      LinkearHoja('OPFIA2',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga3),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=2,Check1=1, Radio3 = 1)

      *- Variacion
      LinkearHoja('VARROF',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga3),Radio1=Dialogo.Radio2,Precio1=Dialogo.Precio1,Radio2=3)  
   Proximo
Endif

