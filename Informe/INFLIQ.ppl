CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Cliente1 : 'Cliente'     ;;;;;;;;;
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Liquidaciones de Commodities')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
  ACT(a:4, 'Cliente : '~Dialogo.Cliente1)
else
 ACT(a:4, 'Cliente : Todos')
endif
if NoVacio(Dialogo.Lista1)
  ACT(a:5, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:5, 'Vehiculo : Todos')
endif

ACT(a7, 'Dealer')
ACT(b7, 'Nro.Op.')
ACT(c7, 'Producto')
ACT(d7, 'Tipo')
ACT(e7, 'Volumen')
ACT(f7, 'Un.M.')
ACT(g7, 'F.Inicio')
ACT(h7, 'F.Fin')
ACT(i7, 'Vol. Total')
ACT(j7, 'Fixed')
ACT(k7, 'Floating')
ACT(l7, 'Resultado')
ACT(m7, 'A Cobrar / Pagar')
ACT(n7, 'F.Liq')

AgregarMarco(a7..n7, 2,0,Exe('COLOR'))

SetFilaActual(7)

SQL.ADD("Select O.Vehiculo1, O.NrOperacion, O.TipoOp, O.Cliente1, O.Cantidad, O.FechaOp2,  ")
SQL.ADD("O.PrecioEj, O.TipoCambio2, O.TipoCambio3, O.MB1, O.MB3, O.UMedida,")
SQL.ADD("C.NrCuota, C.Fecha1, C.Plazo1, C.Fecha2,C.Precio1, C.Precio2, C.Precio3, C.Precio4,C.Total1,C.Cantidad1,C.Cantidad2,C.Cantidad3 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and (O.TipoOp in ('DPFW','DPOGD','DPOGA','DPBOD','DPBOA','DPDSO','DPDSS','DPS','DPSS','DPSO','DPOA','DPOAV','DPOD','DPRC','DPRS','DPRRS') ")
SQL.ADD("or  (O.TipoOp in ('DPSN') and (CB8='0' or CB8 IS NULL))) ")
SQL.ADD("UNION  ")
SQL.ADD("Select O.Vehiculo1, O.NrOperacion, O.TipoOp, O.Cliente1, O.Cantidad,O.FechaOp FechaOp2,  ")
SQL.ADD("O.PrecioEj, O.TipoCambio2, O.TipoCambio3, O.MB1, O.MB3, O.UMedida,")
SQL.ADD("1 NrCuota, FechaEj Fecha1, Plazo Plazo1, CASE TipoOp WHEN 'DPFW' THEN FechaVto ELSE FechaPago END Fecha2,O.Precio2 Precio1,O.Precio3 Precio2,0 Precio3,0 Precio4,O.Precio4 Total1, ")
SQL.ADD("0 Cantidad1,0 Cantidad2,0 Cantidad3 from "~DBO~".OPERACIONES O")
SQL.ADD("where O.FechaEj>= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaEj<= '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif

SQL.ADD("and TipoOp In ('DPOS','DPBOS','DPOGS','DPFW') ")
SQL.ADD("order by 1, 4, 3, 2")

BorrarCeldas(z1..z1)

recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))
    * cambia Cliente
    if NoVacio(Val(z7))
      act(a:fac,'Total '~Val(z7) )
      acn(m:fac, Val(w8))
      BorrarCeldas(w8..w8)
      AgregarMarco(a:fac..n:fac,1)
      SetFont(a:fac..n:fac,1)
      ifa
    endif
    * cambia empresa
    if NoVacio(Val(z1))
      act(a:fac,'Total Empresa '~Val(z1) )
      acn(m:fac, Val(w4))
      BorrarCeldas(w4..w4)
      AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..n:fac,1)
      ifa
    endif
    * Asignar Empresa
    act(z1, fbn('Vehiculo1'))
    act(a:fac,'Empresa '~Val(z1) )
    AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..n:fac,1)
    ifa
    * Asignar cliente
    act(z7, fbn('Cliente1'))
    act(a:fac,Val(z7) )
    AgregarMarco(a:fac..n:fac,1)
    SetFont(a:fac..n:fac,1)
    ifa
  else
    if Not EQstr(fbn('Cliente1'),Val(z7))
      * cambia Cliente
      if NoVacio(Val(z7))
        act(a:fac,'Total '~Val(z7) )
        acn(m:fac, Val(w8))
        BorrarCeldas(w8..w8)
        AgregarMarco(a:fac..n:fac,1)
        SetFont(a:fac..n:fac,1)
        ifa
      endif
      * Asignar cliente
      act(z7, fbn('Cliente1'))
      act(a:fac,Val(z7) )
      AgregarMarco(a:fac..n:fac,1)
      SetFont(a:fac..n:fac,1)
      ifa
    endif
  endif
  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))
  act(c:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))

  if Not Incluido(fbn('TipoOp'),'DPSS|DPSO')
     acn(i:fac, fbn('Cantidad')*fbn('Plazo1'))
  Else 
     acn(i:fac, fbn('Cantidad1'))
  EndIf
  acn(m:fac, fbn('Total1'))
  

  if Incluido(fbn('TipoOp'),'DPRS|DPRRS|DPBOD|DPOD')
    acn(j:fac, fbn('TipoCambio2'))
    acn(l:fac, Val(m:fac)/Val(i:fac))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
       act(j:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
       acn(l:fac, Val(m:fac)/Val(i:fac))
    else
       if Incluido(fbn('TipoOp'),'DPSS|DPSO')
          acn(j:fac, fbn('Precio3'))
       else 
          acn(j:fac, fbn('PrecioEj'))
       endif
       acn(k:fac, fbn('Precio1'))
       acn(l:fac, fbn('Precio2'))
    endif
  endif

  * determinar el tipo
  if EqStr(fbn('TipoOp'),'DPFW')
     if EqStr(fbn('MB3'),'1') 
        act(d:fac,'Venta')
        acn(z5,1)
     endif
     if EqStr(fbn('MB3'),'0') 
        act(d:fac,'Compra')
        acn(z5,-1)
     endif
  endif

  if Incluido(fbn('TipoOp'),'DPSS|DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(d:fac,'Producer')
    else
      act(d:fac,'Consumer')
    endif
  endif

  if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPOA|DPSO|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
     if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(d:fac,'Compra PUT')
     endif
     if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(d:fac,'Venta CALL')
     endif
     if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
        act(d:fac,'Venta PUT')
     endif
     if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
        act(d:fac,'Compra CALL')
     endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Producer')
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta Consumer')
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Consumer')
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Venta Producer')
    endif
  endif

  if Not Incluido(fbn('TipoOp'),'DPSS|DPSO')
     acn(e:fac, fbn('Cantidad'))
  Else
     acn(e:fac, fbn('Cantidad2'))
  EndIf

  act(f:fac, fbn('UMedida'))

  *-- fecha inicio
  if fbn('NrCuota')=1
     acd(g:fac, fbn('FechaOp2'))
  else
     ACN(ag:fac,fbn('NrCuota')-1)
     acd(g:fac,SQL("Select Fecha1 from "~DBO~".CUOTAS where NrOperacion = '"~fbn('NrOperacion')~"' and NrCuota= "~Val(ag:fac)~" ")+1)
  endif

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS|DPFW')
     *- La Fecha de Inicio es la de Ejercicio
     acd(g:fac, fbn('Fecha1'))
  EndIf

  acd(h:fac, fbn('Fecha1'))
  acd(n:fac, fbn('Fecha2'))

  scn(w4,Val(m:fac))
  scn(w8,Val(m:fac))
  scn(w12,Val(m:fac))

  SetFont(a:fac..n:fac,2)

proximo

* ultimo total cliente
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total '~Val(z7) )
  acn(m:fac, Val(w8))
  BorrarCeldas(w5..w8)
  AgregarMarco(a:fac..n:fac,1)
  SetFont(a:fac..n:fac,1)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(m:fac, Val(w4))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..n:fac,1)
endif

* total gral
ifa
acn(m:fac, Val(w12))
BorrarCeldas(w1..w12)
AgregarMarco(a:fac..n:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..n:fac,2)

ACO(1,10)
ACO(3,19)
ACO(4,9)
ACO(5,6)
ACO(6,4)
ACO(7,6)
ACO(8,6)
ACO(9,8)
ACO(10,5)
ACO(11,5)
ACO(12,8)
ACO(13,10)

SetFont(a1..z7, 1)
SetFont(a8..z:fac, 2)
FormatoCeldas(j8..l:fac, Exe('F4'))
FormatoCeldas(e8..e:fac, Exe('F0'))
FormatoCeldas(i8..i:fac, Exe('F0'))
FormatoCeldas(m8..m:fac, Exe('F2N'))
AlinearCeldas(e:8..e:fac+1,'D')
AlinearCeldas(g:8..m:fac+1,'D')
LimitesVision(o:fac+1)
Impresion(1,2)

