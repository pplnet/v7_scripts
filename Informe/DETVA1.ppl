ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
   Vehiculo1  : "Vehiculo"     ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   TipoOp1    : "Tipo Op."     ;;;;;;NoVacio(Dialogo.TipoOp1);'Debe Ingresar un Tipo de Operacion';NO;
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)


SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Cartera de Operaciones Financieras Vigentes")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)

ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
ACT(a:FAC+2, 'Fecha : '~Dialogo.Fecha1)

If EqStr(Copy(Dialogo.TipoOp1,1,2),'MM')
   *** operaciones money markets ****
   ACT(a:FAC+3, 'Money Markets')
Endif
If Incluido(Dialogo.TipoOp1,'FCR|FCS')
   *** operaciones fondos ****
   ACT(a:FAC+3, 'Fondos')
Endif
If Incluido(Dialogo.TipoOp1,'GA|GAMV')
   *** operaciones garantias ****
   ACT(a:FAC+3, 'Garantias')
Endif
If Incluido(Dialogo.TipoOp1,'CC|CCMV')
   *** operaciones cartas de credito ****
   ACT(a:FAC+3, 'Cartas de Credito')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'SE')
   *** securities ****
   ACT(a:FAC+3, 'Securities')
Endif
If Incluido(Dialogo.TipoOp1,'DFXO|DSEO')
   *** operaciones derivados fx y sec ****
   ACT(a:FAC+3, 'Derivados FX & SEC')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'DT')
   ACT(a:FAC+3, 'Derivados de Tasas')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'DC')
   ACT(a:FAC+3, 'Derivados Comm.')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'FX')
   ACT(a:FAC+3, 'Foreing Exchange')
Endif
If EqStr(Copy(Dialogo.TipoOp1,1,2),'TE')
   ACT(a:FAC+3, 'TERCEROS')
Endif
ACT(a:FAC+4, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
SetFont(a:fac..N:FAC+4,2)

SetFilaActual(FAC+6)

If Incluido(Dialogo.TipoOp1,'MMDC|MMDCA|MMCCR|MMCP|MMCPR|MMCPRV|MMCPV|')
   SQL.ADD("Select O.*, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, C.Cantidad4, C.Cantidad5, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio3 Pr3, C.Cantidad2, C.Total1, C.Total2, C.Precio4 Pr4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion  ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MMCPM|MMCPVM')
   SQL.ADD("Select O.*, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, C.Cantidad4, C.Cantidad5, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio3 Pr3, C.Cantidad2, C.Total1, C.Total2, C.Precio4 Pr4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'FCR|FCS')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'GA|GAMV')
   SQL.ADD("Select O.NrOperacion, O.FechaOp2, O.FechaOp, O.Cliente1, O.RB7, ")
   SQL.ADD(" O.Observac3, O.Observac2, O.ObservacDoc, O.Especie, O.Pais, O.Cantidad, O.FechaVto, ")
   SQL.ADD(" O.Plazo, O.TipoOp, O.FechaEx2, O.ImpGastos2, O.TotalRetenciones, O.Precio1, ")
   SQL.ADD(" O.ImpComMer1, O.PorComMer1, O.Precio4, O.Cliente2, O.TotalAux1, ")
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, ")
   SQL.ADD(" C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Tasa1, C.Total7, C.Total2, ")
   SQL.ADD(" C.Total4, C.Total5, C.Cantidad4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'CC|CCMV')
   SQL.ADD("Select O.NrOperacion, O.FechaOp2, O.FechaOp, O.Cliente1, O.RB7, O.RB9, O.RB10, O.RB5, ")
   SQL.ADD(" O.Observac2, O.ObservacDoc, O.Especie, O.Pais, O.Cantidad, O.FechaVto, ")
   SQL.ADD(" O.Plazo, O.TipoOp, O.FechaEx2, O.TotalRetenciones, O.Precio1, ")
   SQL.ADD(" O.ImpComMer1, O.PorComMer1, O.Cliente2, O.Cliente3, O.Cliente4, ")
   SQL.ADD(" O.Plaza1, O.Plazo2, O.Plazo3, O.Cuotas1, O.ContraEspecie2, ") 
   SQL.ADD(" C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, C.Cantidad3, ")
   SQL.ADD(" C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Tasa1, C.Total7, C.Total2, ")
   SQL.ADD(" C.Total5, C.Cantidad4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'SEABD|SEABP|SERA|SERAV|SECT|SECTV|SEVT|SEVTV|SERP|SERPV')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If Incluido(Dialogo.TipoOp1,'SEABD|SEABP|SECT|SECTV|SEVT|SEVTV')
      SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   Else
      SQL.ADD("  and O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   Endif
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DFXO|DSEO')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DPOS|DPFW|DPBOS')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O  ")
   SQL.ADD("where O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp    = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and O.FechaEj  > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DPBOD|DPOA|DPOAV|DPOD|DPRC|DPRRS|DPRS|DPS|DPBOA|DPC|DPF|DPOGA|DPOGD|DPOGS|DPSF|DPSV')
   SQL.ADD("Select O.*, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Eqstr(Dialogo.TipoOp1,'DPSN')
   SQL.ADD("Select O.*, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (CB8 is Null or CB8='0') ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DPDSO|DPDSS')
   SQL.ADD("Select O.*, C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad2, ")
   SQL.ADD(" C.Precio2 Pr2, C.Precio1 Pr1, C.Total1, C.Plazo2 Pl2, C.Precio3 Pr3, T.Nombre ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C,  "~DBO~".TIPOSOPERACION T ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.TipoOp  = T.Codigo ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'FXAS|FXASV|FXAT|FXATV|FXCT|FXCTV|FXVT|FXVTV')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and ((O.FechaVto >= O.FechaPago and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("   or  (O.FechaPago > O.FechaVto and O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'FXREPO|FXREPV')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and ((O.FechaVto2 >= O.FechaOp2 and O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("   or  (O.FechaOp2 > O.FechaVto2 and O.FechaOp2 > '"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MMCDIA|MMFCMV|MMFIMV|MMONM|MMPCCM|MMPCLM|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMSIMV') 
   SQL.ADD("Select  O.NrOperacion,O.TipoOp,O.FechaOp2,O.Vehiculo1,O.Cantidad,O.Especie,O.TipoTasa,O.Precio1,")
   SQL.ADD("O.Spread,O.FechaOp,O.RB8,O.Cliente1,O.Cliente2,O.Cliente3,O.MB3,")
   SQL.ADD("C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1, C.Cantidad1, C.Cantidad3, C.Cantidad4, C.Cantidad5,C.Precio1 Pr1,")
   SQL.ADD("C.Precio2 Pr2, C.Precio4 Pr4, C.Precio3 Pr3, C.Cantidad2, C.Total1, C.Total2, C.Total3, C.Total7, C.Total4,O.TotalBrutoCli1,O.Plazo2,O.Precio2  ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion, C.NrCuota ")
Endif

If Incluido(Dialogo.TipoOp1,'MMFRN|MMFRNP|MMON|MMPCCV|MMPCL|MMPCOS|MMPE|MMPI|MMPSC|MMPSI|MMP|') 
   SQL.ADD("Select O.*, C.Importe2, C.Importe3")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MMD|MMO|MMPLME') 
   SQL.ADD("Select O.* ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O")
   SQL.ADD(" WHERE O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'MMCDP') 
   SQL.ADD("Select O.* ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O")
   SQL.ADD(" WHERE O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and ((O.Plazo2=0 and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"') or (O.Plazo2>0 and O.FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'VIMIND|VIMINM|TEMIND|TEMINM')
   SQL.ADD("Select O.* ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.MB3, O.Especie, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DTO|DTOV|DTSFV|DTSFF|DTSVV||DTSFVV') 
   SQL.ADD("Select O.*, ")
   SQL.ADD("       C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1 Pl1, C.Fecha3, C.Fecha5, C.Fecha6, C.Fecha7, C.Plazo2 Pl2,  ")
   SQL.ADD("       C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad4, C.Cantidad5, C.Cantidad6, ")
   SQL.ADD("       C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Total1, C.Total3, C.Total4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion *= C.NrOperacion   ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")
Endif

If Incluido(Dialogo.TipoOp1,'DTC|DTF|DTK|DTKVI|DTOM|DTOMV|DTSFFM|DTSFVM|DTSFVX|DTSNFF|DTSNFV|DTSNVV|DTSVVM|DTCAP|DTFLO')
   SQL.ADD("Select O.*,  ") 
   SQL.ADD("       C.NrCuota, C.Fecha1, C.Fecha2, C.Plazo1 Pl1, C.Fecha3, C.Fecha5, C.Fecha6, C.Fecha7, C.Plazo2 Pl2,  ")
   SQL.ADD("       C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad4, C.Cantidad5, C.Cantidad6, ")
   SQL.ADD("       C.Precio1 Pr1, C.Precio2 Pr2, C.Precio3 Pr3, C.Total1, C.Total3, C.Total4, ")
   SQL.ADD("       C.Tasa1 Ts1, C.Total2, C.Fecha4 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   SQL.ADD("  and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   SQL.ADD("  and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
