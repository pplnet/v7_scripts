CrearDialogo
   String1: 'Formula'   ;;;;;;;
   String2: 'String'    ;;;;;;;
FinDialogo

IF NOT OK
   Cancelar
ENDIF

ACT(fo:1,Dialogo.String1)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,10,')

AgregarBMP(a1,Exe('LOGO'),60)


*--- Para ModelosAsientos1 -----
If NoVacio(Dialogo.String1)
    ACT(a3, 'Auditoria de Utilizacion de Formulas ')
    SetFont(a3..a3,3)
    ACT(a4, 'FORMULA:')
    ACT(b4, Dialogo.String1 )
    SetFont(a4..b4,1)


    ACT(a:7, 'Detalle de Modelos de Asientos')
    SetFont(a:7..a:7,4)

    ACT(a:9, 'MODELO')
    ACT(b:9, 'NroItem')
    SetFont(a:9..b:9,1)

    AgregarMarco(a:9..b:9,2,0,Exe('COLOR'))

    SetFilaActual(10)

    SQL.ADD(" SELECT * FROM "~DBO~".MODELOSASIENTO1 where ")
    SQL.ADD(" CuentaContable Like '%#"~Val(fo:1)~"%' or   ")
    SQL.ADD(" FormaCalculo1 Like '%#"~Val(fo:1)~"%' or    ")
    SQL.ADD(" FormaCalculo2 Like '%#"~Val(fo:1)~"%' or    ")
    SQL.ADD(" FormaCalculo3 Like '%#"~Val(fo:1)~"%' or    ")
    SQL.ADD(" CondicionValidez Like '%#"~Val(fo:1)~"%' or ")
    SQL.ADD(" DebitoCredito Like '%#"~Val(fo:1)~"%' or    ")
    SQL.ADD(" Moneda1 Like '%#"~Val(fo:1)~"%' or          ")
    SQL.ADD(" Moneda2 Like '%#"~Val(fo:1)~"%' or          ")
    SQL.ADD(" Moneda3 Like '%#"~Val(fo:1)~"%' or          ")
    SQL.ADD(" Alias1 Like '%#"~Val(fo:1)~"%' or           ")
    SQL.ADD(" Alias2 Like '%#"~Val(fo:1)~"%' or           ")
    SQL.ADD(" Alias3 Like '%#"~Val(fo:1)~"%' or           ")
    SQL.ADD(" Detalle Like '%#"~Val(fo:1)~"%' or          ")
    SQL.ADD(" CentroCosto Like '%#"~Val(fo:1)~"%' or      ")
    SQL.ADD(" Alias4 Like '%#"~Val(fo:1)~"%' or           ")
    SQL.ADD(" Alias5 Like '%#"~Val(fo:1)~"%'              ")
    SQL.ADD(" ORDER BY Modelo,NrItem                      ")

    Recorrer SQL
        ACT(a:fac, fbn('Modelo'))
        ACT(b:fac, fbn('NrItem'))
    Proximo
    
    SetFont(a:10..b:fac,2)

    *------------- Para FORMULAS ----------
    SetFilaActual(fac+4)

    ACT(a:fac, 'Detalle del Archivo de FORMULAS')
    SetFont(a:fac..a:fac,4)

    ACT(a:fac+2, 'Codigo')
    ACT(b:fac+2, 'Descripcion')
    SetFont(a:fac+2..b:fac+2,1)

    AgregarMarco(a:fac+2..b:fac+2,2,0,Exe('COLOR'))


    SetFilaActual(fac+3)
    ACN(fi:1,fac)

    *SQL.ADD(" SELECT * FROM "~DBO~".FORMULAS where Script Like '%#"~Val(fo:1)~"%' ")
    SQL.ADD(" SELECT * FROM "~DBO~".FORMULAS ")
    SQL.ADD(" ORDER BY Codigo ")
    Recorrer SQL
      ACT(e:fac,fbn['Script'])
      If Buscar('#'~Val(fo:1),Val(e:fac)) 
        ACT(a:fac, fbn('Codigo'))
        ACT(b:fac, fbn('Descripcion'))
      else
         Dfa
      Endif
    Proximo

    SetFont(a:Val(fi:1)..b:fac,2)
ENDIF

    *--- Para ModelosAsientos1 -----
If NoVacio(Dialogo.String2)
    SetFilaActual(fac+4)
    ACT(a:fac, 'Auditoria de Utilizacion de Strings ')
    SetFont(a:fac..a:fac,3)

    SetFilaActual(fac+2)
    ACT(a:fac, 'Uso de String: '~Dialogo.String2)
    SetFont(a:fac..a:fac,4)

    ACT(a:fac+2, 'Modelo')
    ACT(b:fac+2, 'NrItem')
    SetFont(a:fac+2..b:fac+2,1)

    AgregarMarco(a:fac+2..b:fac+2,2,0,Exe('COLOR'))

    SetFilaActual(fac+3)
    ACN(fi:1,fac)

    SQL.ADD(" SELECT * FROM "~DBO~".MODELOSASIENTO1 where    ")
    SQL.ADD(" CuentaContable Like '%"~Dialogo.String2~"%' or ")
    SQL.ADD(" FormaCalculo1 Like '%"~Dialogo.String2~"%' or  ")
    SQL.ADD(" FormaCalculo2 Like '%"~Dialogo.String2~"%' or  ")
    SQL.ADD(" FormaCalculo3 Like '%"~Dialogo.String2~"%' or  ")
    SQL.ADD(" CondicionValidez Like '%"~Dialogo.String2~"%' or ")
    SQL.ADD(" DebitoCredito Like '%"~Dialogo.String2~"%' or  ")
    SQL.ADD(" Moneda1 Like '%"~Dialogo.String2~"%' or        ")
    SQL.ADD(" Moneda2 Like '%"~Dialogo.String2~"%' or        ")
    SQL.ADD(" Moneda3 Like '%"~Dialogo.String2~"%' or        ")
    SQL.ADD(" Alias1 Like '%"~Dialogo.String2~"%' or         ")
    SQL.ADD(" Alias2 Like '%"~Dialogo.String2~"%' or         ")
    SQL.ADD(" Alias3 Like '%"~Dialogo.String2~"%' or         ")
    SQL.ADD(" Detalle Like '%"~Dialogo.String2~"%' or        ")
    SQL.ADD(" CentroCosto Like '%"~Dialogo.String2~"%' or    ")
    SQL.ADD(" Alias4 Like '%"~Dialogo.String2~"%' or         ")
    SQL.ADD(" Alias5 Like '%"~Dialogo.String2~"%'            ")
    SQL.ADD(" ORDER BY Modelo,NrItem                         ")

    Recorrer SQL
        ACT(a:fac, fbn('Modelo'))
        ACT(b:fac, fbn('NrItem'))
    Proximo

    SetFont(a:Val(fi:1)..b:fac,2)
ENDIF

ACO(1,10)
ACO(2,40)

LimitesVision(c:fac+3)


