CrearDialogo
   Fecha1    : 'Fecha Ej.' ;;;;;;;;;FSys
   Vehiculo1 : 'Vehiculo'  ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');;;;
   Especie1  : 'Especie'   ;
   Precio1   : 'Precio Ej.';
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Detalle de Posicion de Opciones')
ACT(a2, 'Especie : '~Dialogo.Especie1)
ACT(a3, 'Fecha Ej. : '~Dialogo.Fecha1)
ACT(a4, 'Precio Ej. : '~FStr(Dialogo.Precio1,1,7))

ACT(a6, 'Calls')
SQL.ADD("SELECT  O.TipoOp, O.Cantidad, O.Cliente1, O.Precio1, O.FechaOp, O.NrOperacion, O.FechaEj, O.PrecioEj, O.TipoOpcion ")
SQL.ADD("FROM    "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE   O.NrOperacion=B.NrOperacion and ")
SQL.ADD("        B.Valor=0 and B.NrBit in ('30') and ")
SQL.ADD("        O.TipoOp in ('OCC','OVC') ")
SQL.ADD("        and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("        and O.FechaEj = '"~IdxDate(Dialogo.Fecha1)~"' and O.PrecioEj = "~FStr(Dialogo.Precio1,1,7)~"")
SQL.ADD("        and O.Especie = '"~Dialogo.Especie1~"' and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("ORDER BY O.FechaOp, O.Cliente1, O.TipoOpcion")

ACT(a7, 'Compras')
ACT(a8, 'Nr.Operacion')
ACT(b8, 'Fecha')
ACT(c8, 'Cliente')
ACT(d8, 'Cantidad')
ACT(e8, 'Precio')
ACT(f8, 'Tipo')

ACT(g7, 'Ventas')
ACT(g8, 'Nr.Operacion')
ACT(h8, 'Fecha')
ACT(i8, 'Cliente')
ACT(j8, 'Cantidad')
ACT(k8, 'Precio')
ACT(l8, 'Tipo')

AgregarMarco(a6..l6,1,0,RGB(192,192,192))
AgregarMarco(a7..f8,1,0,Exe('COLOR'))
AgregarMarco(g7..l8,1,0,Exe('COLOR'))

SetFont(a1..m8, 1)

ACN(Z2, 8)
ACN(Z3, 8)
Recorrer SQL
   If Incluido(fbn('TipoOp'), 'OCC|OCP')
      ACN(z1, 0)
      SCN(z2, 1)
      ACN(z4, Val(z2))
   Else
      ACN(z1, 6)
      SCN(z3, 1)
      ACN(z4, Val(z3))
   Endif
   ACT(Val(z1)+1:Val(z4), fbn('NrOperacion'))
   ACLO(Val(z1)+1:Val(z4), fbn('NrOperacion'))
   ACT(Val(z1)+2:Val(z4), fbn('FechaOp'))

   ACT(Val(z1)+3:Val(z4), fbn('Cliente1'))
   ACN(Val(z1)+4:Val(z4), fbn('Cantidad'))
   ACN(Val(z1)+5:Val(z4), fbn('Precio1'))
   If fbn('TipoOpcion')=0
      ACT(Val(z1)+6:Val(z4), 'Americana')
   Else
      ACT(Val(z1)+6:Val(z4), 'Europea')
   Endif
Proximo
If Val(z3) > Val(z2)
   ACN(z5, Val(z3)+1)
Else
  ACN(z5, Val(z2)+1)
Endif
ACT(a:Val(z5), 'Total')
ACN(d:Val(z5), SUM(d8..d:Val(z5)))
ACN(j:Val(z5), SUM(j8..j:Val(z5)))

AgregarMarco(a9..f:Val(z5),1)
AgregarMarco(g9..l:Val(z5),1)
AgregarMarco(a:Val(z5)..l:Val(z5),1,0,Exe('COLOR'))


SetFont(a9..l:Val(z5)-1, 2)
SetFont(a:Val(z5)..l:Val(z5), 1)

ACN(z6, Val(z5)+1)

********

ACT(a:Val(z6)+2, 'Puts')
SQL.ADD("SELECT O.TipoOp, O.Cantidad, O.Cliente1, O.Precio1, O.FechaOp, O.NrOperacion, O.FechaEj, O.PrecioEj, O.TipoOpcion ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
SQL.ADD("       B.Valor=0 and B.NrBit in ('30') and ")
SQL.ADD("       O.TipoOp in ('OCP','OVP')")
SQL.ADD("       and O.FechaEj = '"~IdxDate(Dialogo.Fecha1)~"' and O.PrecioEj = "~FStr(Dialogo.Precio1,1,7)~"")
SQL.ADD("       and O.Especie = '"~Dialogo.Especie1~"' and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("ORDER BY O.FechaOp, O.Cliente1, O.TipoOpcion")

ACT(a:Val(z6)+3, 'Compras')
ACT(a:Val(z6)+4, 'Nr.Operacion')
ACT(b:Val(z6)+4, 'Fecha')
ACT(c:Val(z6)+4, 'Cliente')
ACT(d:Val(z6)+4, 'Cantidad')
ACT(e:Val(z6)+4, 'Precio')
ACT(f:Val(z6)+4, 'Tipo')

ACT(g:Val(z6)+4, 'Ventas')
ACT(g:Val(z6)+4, 'Nr.Operacion')          
ACT(h:Val(z6)+4, 'Fecha')
ACT(i:Val(z6)+4, 'Cliente')
ACT(j:Val(z6)+4, 'Cantidad')
ACT(k:Val(z6)+4, 'Precio')
ACT(l:Val(z6)+4, 'Tipo')

AgregarMarco(a:Val(z6)+2..l:Val(z6)+2,1,0,RGB(192,192,192))
AgregarMarco(a:Val(z6)+3..f:Val(z6)+4,1,0,Exe('COLOR'))
AgregarMarco(g:Val(z6)+3..l:Val(z6)+4,1,0,Exe('COLOR'))

SetFont(a:Val(z6)..m:Val(z6)+4, 1)

ACN(Z2, Val(z6)+4)
ACN(Z3, Val(z6)+4)
Recorrer SQL
   If Incluido(fbn('TipoOp'), 'OCC|OCP')
      ACN(z1, 0)
      SCN(z2, 1)
      ACN(z4, Val(z2))
   Else
      ACN(z1, 6)
      SCN(z3, 1)
      ACN(z4, Val(z3))
   Endif
   ACT(Val(z1)+1:Val(z4), fbn('NrOperacion'))
   ACLO(Val(z1)+1:Val(z4), fbn('NrOperacion'))
   ACT(Val(z1)+2:Val(z4), fbn('FechaOp'))

   ACT(Val(z1)+3:Val(z4), fbn('Cliente1'))
   ACN(Val(z1)+4:Val(z4), fbn('Cantidad'))
   ACN(Val(z1)+5:Val(z4), fbn('Precio1'))
   If fbn('TipoOpcion')=0
      ACT(Val(z1)+6:Val(z4), 'Americana')
   Else
      ACT(Val(z1)+6:Val(z4), 'Europea')
   Endif
Proximo

If Val(z3) > Val(z2)
   ACN(z5, Val(z3)+1)
Else
   ACN(z5, Val(z2)+1)
Endif
ACT(a:Val(z5), 'Total')
ACN(d:Val(z5), SUM(d:Val(z6)+4..d:Val(z5)))
ACN(j:Val(z5), SUM(j:Val(z6)+4..j:Val(z5)))

AgregarMarco(a:Val(z6)+5..f:Val(z5),1)
AgregarMarco(g:Val(z6)+5..l:Val(z5),1)
AgregarMarco(a:Val(z5)..l:Val(z5),1,0,Exe('COLOR'))

SetFont(a:Val(z6)+5..l:Val(z5)-1, 2)
SetFont(a:Val(z5)..l:Val(z5), 1)

********

FormatoCeldas(d8..d:Val(z5), Exe('F2'))
FormatoCeldas(e8..e:Val(z5), Exe('F6'))
FormatoCeldas(j8..j:Val(z5), Exe('F2'))
FormatoCeldas(k8..k:Val(z5), Exe('F6'))
ACT(a:Val(z5)+1, 'FIN DEL LISTADO')
SetFont(a:Val(z5)+1..l:Val(z5)+1, 1)
LimitesVision(m:Val(z5)+2)
RangoTitulo(a:1..m:Val(z5)+2, 4)

ACO(1,9)
ACO(7,9)
