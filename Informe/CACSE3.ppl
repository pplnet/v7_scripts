ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.ContraEspecie,O.Cuenta1, O.Vehiculo1, O.TotalBrutoCli1, O.Precio1, ")
SQL.ADD("O.Cantidad, O.FechaOp, Cuenta1, O.ImpComMer1 , O.TotalComisiones, O.ImpComCor1, O.TotalGastos, O.TotalIVA, O.Plazo, O.RB5 ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['ContraEspecie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACT(ze:99, fbn['Especie'])
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zj:99, PYC(fbn['Precio1'],1,2))
   ACD(zm:99, fbn['FechaOp'])
   ACT(zn:99, PYC(fbn['TotalBrutoCli1'],1,2))

if Incluido(Val(za:99), 'SECT|SEVT|SECTV|SEVTV|') 
   ACN(zo:99, Fbn['Plazo'] )
else
   ACN(zo:99, Fbn['RB5'] )
endif

   ACN(zx:99, Fbn['ImpComMer1'] + Fbn['TotalComisiones'] + Fbn['ImpComCor1'] + Fbn['TotalGastos'] + Fbn['TotalIVA'] )
   ACT(zp:99, PYC(val(zx:99),1,2))
Proximo

If Not Incluido(val(za:99), 'SECS|SEVS|SECSV|SEVSV|SECT|SEVT|SECTV|SEVTV|')
    Cancelar 
Endif

SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')

SetFilaActual(fac+3)
ACT(a:fac,'Señores')
SetFont(a:fac-3..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)) )
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra mayor consideraci'~Chr(243)~'n:')
SetFilaActual(fac+2)

If Incluido(val(za:99), 'SECS|SECSV|SECT|SECTV|')
   If Val(zo:99) > 0
      ACT(TX:1,'Por medio de la presente, confirmamos a Uds. estar comprando a '~PYC(val(zo:99),1,0)~IIF(num(val(zo:99)) >1,' d'~Chr(237)~'as', ' d'~Chr(237)~'a')~' la suma de VN '~val(zd:99)~' '~val(ze:99)~' a un precio de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zj:99)~'.- lo que hace un monto de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zn:99)~'.')

      ACN(CR:1, 80)
         (.'LINEAS'.)
      **--   Forma de usar a esta funcion desde donde se la llame
      Recorrer&k 1, Val(FI:2)
          ifa
          ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Proximo

   Else 
      ACT(a:fac,'Por medio de la presente, confirmamos a Uds. la liquidaci'~Chr(243)~'n de VN  '~val(zd:99)~' '~val(ze:99))
      SetFilaActual(fac+1)
      ACT(a:fac,'a un precio de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zj:99)~'.- lo que hace un monto de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zn:99)~'.-, cuya compra fue pactada el d'~Chr(237)~'a')
      SetFilaActual(fac+1)
      ACT(a:fac,FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~', que autorizamos debitar de nuestra cuenta # '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99)) )
      SetFilaActual(fac+1)
      ACT(a:fac,'en vuestra Entidad.')
   EndIf 
Else
   If Val(zo:99) > 0
      ACT(TX:1,'Por medio de la presente, confirmamos a Uds. estar vendiendo '~PYC(val(zo:99),1,0)~IIF(num(val(zo:99)) >1,' d'~Chr(237)~'as', ' d'~Chr(237)~'a')~' la suma de VN '~val(zd:99)~' '~val(ze:99)~' a un precio de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zj:99)~'.- lo que hace un monto de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zn:99)~'.')

      ACN(CR:1, 80)
         (.'LINEAS'.)
      **--   Forma de usar a esta funcion desde donde se la llame
      Recorrer&k 1, Val(FI:2)
          ifa
          ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Proximo
   Else 
      ACT(a:fac,'Por medio de la presente, y de acuerdo a las acciones a nuestra disposici'~Chr(243)~'n confirmamos la liquidaci'~Chr(243)~'n')
      SetFilaActual(fac+1)
      ACT(a:fac,'de VN  '~val(zd:99)~' '~val(ze:99)~' a un precio de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zj:99)~'.- lo que hace un monto total de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99)))~' '~val(zn:99)~'.-' ) 
      SetFilaActual(fac+1)
      ACT(a:fac,'cuya venta fue pactada el d'~Chr(237)~'a '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~' que solicitamos a Uds. acreditar en nuestra cuenta') 
      SetFilaActual(fac+1)
      ACT(a:fac,'# '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))~' en vuestra Entidad.')
   EndIf
EndIf

If Val(zo:99) <= 0
   SetFilaActual(fac+2)
   ACT(a:fac,'Asimismo, y de acuerdo a los gastos de arancel, imp. / der. e IVA S/ Arancel por un monto total de')
   SetFilaActual(fac+1)
   ACT(a:fac,IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zp:99)~'.-autorizamos a debitar los mismos de nuestra cuenta comitente # '~BuscarCampo('CLIENTES','CodComitente','Codigo',val(zb:99))) 
EndIf 

SetFilaActual(fac+2)
ACT(a:Fac,'Sin otro particular, lo saludamos a Uds. muy atentamente')
SetFont(a:val(zz:99)..a:fac,1)

*-SetFilaActual(fac+3)
*-ACT(d:Fac,'       '~val(zg:99) )
*-SetFont(d:fac,2)

*-SetFilaActual(fac+3)
*-ACT(d:Fac,'APODERADO')
*-ACT(f:Fac,'       '~'APODERADO')
*-SetFont(d:fac..f:fac,4)

AgregarBMP(a:3,Var('PATHLOGO')~val(zg:99)~'.bmp',80)  
Impresion(2, 0) 
Impresion(3, 0)

SetMargins(3, 0, 0, 0)

LimitesVision(m:FAC+1)
