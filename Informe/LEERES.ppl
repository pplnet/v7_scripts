HojaVisible(SI)
CrearDialogo
   String1 : 'Nombre PMG'         ;;;;;;;;;'OPFIAU';;
   Fecha1  : 'Fecha'              ;;;;;;;;;FSys;
   Lista1  : 'Vehiculo'           ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Radio1  : 'Consolidado|NO|SI'  ;;;;;;;;;1;
   Radio2  : 'Tipo|Corto|Largo|Corto+Largo' ;;;;;;;;;2;           
   Check1  : 'Hoja Visible|NO|SI' ;;;;;;;;;0;
FinDialogo

*- Construyo la Exstencion
ACT(ga1, copy(Dialogo.Lista1,1,Longitud(Dialogo.Lista1)))

ACT(ga2, IIF(Dialogo.Radio2=0, 'Corto Plazo',IIF(Dialogo.Radio2=1,'Largo Plazo','Corto+Largo Plazo')) )
ACT(ga3, IIF(Dialogo.Radio1=0, 'NO Consolidado', 'Consolidado'))
ACT(ga1, Val(ga1)~'/'~Dialogo.Fecha1~'/'~Val(ga2)~'/'~Val(ga3))

If SQL("Select Count(*) from "~DBO~".OBJETOS where Codigo='"~Dialogo.String1~"' and Extension='"~Val(ga1)~"' ")=0
   ACN(ga4, MessageBox('No existe el Reporte Solicitado '~Dialogo.String1~' '~Val(ga1),0,0))
Else
   Message('Recuperando '~Dialogo.String1~' '~Val(ga1))
   LeerPMG(Dialogo.String1, Val(ga1))
Endif

LimitesVision(r:200)