SetFont(b:11..val(b:200):val(i:200),3)
SetFont(b:val(h:200)..val(b:200):val(h:200),4)
SetFont(b:val(i:200)..val(b:200):val(i:200),4)
SetFont(b:val(j:200)..val(b:200):val(l:200),2)
if Dialogo.Radio2 = 0
   SetFont(val(q:200):val(d:200)..val(z:200)+1:val(d:200),3)
   SetFont(val(q:200):val(g:200)..val(z:200)+1:val(g:200)+1,3)
   SetFont(val(r:200):val(d:200)..val(r:200):val(d:200),4)
   SetFont(val(r:200):val(g:200)..val(r:200):val(g:200)+1,4)
   SetFont(val(w:200):val(d:200)..val(w:200):val(d:200),4)
   SetFont(val(w:200):val(g:200)..val(w:200):val(g:200)+1,4)
   SetFont(val(s:200):val(d:200)..val(t:200):val(d:200),2)
   SetFont(val(s:200):val(g:200)..val(t:200):val(g:200)+1,2)
   SetFont(val(x:200):val(d:200)..val(z:200)+1:val(d:200),2)
   SetFont(val(x:200):val(g:200)..val(z:200)+1:val(g:200)+1,2)

   SetFont(val(d:200):11..val(d:200):val(k:200)-2,4)
   SetFont(val(g:200):11..val(g:200)+1:val(k:200)-2,4)

   SetFont(val(d:200):val(q:200)-1..val(d:200):val(v:200)-6,4)
   SetFont(val(g:200):val(q:200)-1..val(g:200)+1:val(v:200)-6,4)
   SetFont(val(d:200):val(v:200)+1..val(d:200):val(z:200)-4,4)
   SetFont(val(g:200):val(v:200)+1..val(g:200)+1:val(z:200)-4,4)
  else
   SetFont(val(q:200):val(n:200)+1..val(z:200)+1:val(n:200)+1,3)
   SetFont(val(q:200):val(p:200)+2..val(z:200)+1:val(p:200)+2,3)
   SetFont(val(q:200):val(g:200)+1..val(z:200)+1:val(g:200)+1,3)
   SetFont(val(r:200):val(n:200)+1..val(r:200):val(n:200)+1,4)
   SetFont(val(r:200):val(p:200)+2..val(r:200):val(p:200)+2,4)
   SetFont(val(r:200):val(g:200)+1..val(r:200):val(g:200)+1,4)
   SetFont(val(w:200):val(n:200)+1..val(w:200):val(n:200)+1,4)
   SetFont(val(w:200):val(p:200)+2..val(w:200):val(p:200)+2,4)
   SetFont(val(w:200):val(g:200)+1..val(w:200):val(g:200)+1,4)
   SetFont(val(s:200):val(n:200)+1..val(t:200):val(n:200)+1,4)
   SetFont(val(s:200):val(p:200)+2..val(t:200):val(p:200)+2,4)
   SetFont(val(s:200):val(g:200)+1..val(t:200):val(g:200)+1,4)
   SetFont(val(x:200):val(n:200)+1..val(z:200)+1:val(n:200)+1,4)
   SetFont(val(x:200):val(p:200)+2..val(z:200)+1:val(p:200)+2,4)
   SetFont(val(x:200):val(g:200)+1..val(z:200)+1:val(g:200)+1,4)

   SetFont(val(n:200)+1:11..val(n:200)+1:val(k:200)-2,4)
   SetFont(val(g:200)+1:11..val(g:200)+1:val(k:200)-2,4)
   SetFont(val(p:200)+2:11..val(p:200)+2:val(k:200)-2,4)

   SetFont(val(n:200)+1:val(q:200)-1..val(n:200)+1:val(v:200)-6,4)
   SetFont(val(g:200)+1:val(q:200)-1..val(g:200)+1:val(v:200)-6,4)
   SetFont(val(p:200)+2:val(q:200)-1..val(p:200)+2:val(v:200)-6,4)
   SetFont(val(n:200)+1:val(v:200)+1..val(n:200)+1:val(z:200)-4,4)
   SetFont(val(g:200)+1:val(v:200)+1..val(g:200)+1:val(z:200)-4,4)
   SetFont(val(p:200)+2:val(v:200)+1..val(p:200)+2:val(z:200)-4,4)
endif
AgregarMarco(b:val(a:200)..val(b:200):val(i:200),1,3)
