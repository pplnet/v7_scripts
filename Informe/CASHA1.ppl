ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1     : "Fecha"                     ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Radio2     : "Tipo|Diario|Mensual-Anual" ;;;;;;;;;0
  Radio1     : "|Consolidado|Vehiculo"     ;;;;;;;;;0
  Vehiculo1  : "Empresa"                   ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
  Radio3     : "Minutas|Reales|Reales-Simuladas";;;;;;;;;0
  Check1     : "Capital"                   ;;;;;;;;;1
  Check2     : "Interes"                   ;;;;;;;;;1
  Check3     : "Impuestos"                 ;;;;;;;;;1
  Radio10    : "TasaSimulada|NO|SI"        ;;;;;;;;;1
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con Todos los Vehiculos ')
   endif
endif

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")
CrearFont(5,"Arial,10,B")

SetFilaActual(3)

ACT(c:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,3)

ACT(a:FAC, "Informe de Cash Flows "~iif(Dialogo.Radio2=0,'Diario','Mensual-Anual'))
SetFont(a:fac..a:fac,5)

SetFilaActual(4)

ACT(a:FAC+1, 'Fecha Analisis : '~Dialogo.Fecha1)
if Dialogo.Radio1=0
  ACT(a:FAC+2, 'Empresa : Consolidado')
 else
  ACT(a:FAC+2, 'Empresa : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
endif
ACT(a:FAC+3, 'Minutas : '~iif(Dialogo.Radio3=0,'Reales','Reales y Simuladas'))
ACT(d:FAC+3, 'Los Importes se Informan en Miles')
SetFont(a:fac..n:FAC+4,4)

(.'MARCOCASH'.)
