* Para hacer auditoria de novedades.
HOJAVISIBLE(NO)
CrearDialogo
  Fecha1 : 'Desde';1;1;;;;Dialogo.Fecha1>0;;NO;FSys
  Fecha2 : 'Hasta';2;1;;;;Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha Hasta debe er mayor o igual a Fecha Desde!';NO;FSys
  String1: 'Tabla';3;1;;SI;SI
  String2: 'Codigo';;;;SI;SI
  String:  'Campo';;;;NO;NO
  Operador: 'Usuario';;;;;
  Check1  : 'Resumido'  ;;;;;;;;;1;
  Radio1  : 'Mostrar|Separado|Junto';;;;;;;;;1;
  Lista2  : 'Todas_las_tablas';4;2;;NO;NO;;;;'ARANCELES|EVENTOS|FILTROS|FORMULAS|FUNCIONES|GASTOS|INFORMES|INSTANCIAS|LINEASPRESTAMO|MODELOSASIENTO|MODELOSASIENTO1|PERFILES2|PRODUCTOS|TIPOSARANCEL|TIPOSEVENTO|TIPOSEXCEPCION|TIPOSFACTURA|TIPOSGASTO|TIPOSIMPUESTO|TIPOSIMPUESTO1|TIPOSINFORME|TIPOSMINUTABOLSA|TIPOSOPERACION|TIPOSORDEN|TIPOSPOSICION|TIPOSTASA|TIPOSTRANSACCION2|VARIABLES|ABMS|RELACIONCUENTA';
  Lista1  : 'Tablas:'   ;-2;2;;;;;;;'EVENTOS|FUNCIONES|INFORMES|TIPOSOPERACION|TIPOSTRANSACCION2|TIPOSORDEN|ABMS|FORMULAS|MODELOSASIENTO|MODELOSASIENTO1|RELACIONCUENTA';;Dialogo.Lista2
  Check2  : 'Exporta PDF' ;;1;;NO;NO;;;;0;
FinDialogo

if not Ok
  Cancelar
endif

If Dialogo.Radio1=1
  LinkearHoja('LOGTOT',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,String1=Dialogo.String1  ,String2=Dialogo.String2,String=Dialogo.String,Operador=Dialogo.Operador,Check1=Dialogo.Check1,Radio1=Dialogo.Radio1,Lista2=Dialogo.Lista2,Lista1=Dialogo.Lista1,Check2=Dialogo.Check2,String3='NOVEDA')
Else
  Recorrer&i 1,Elementos(Dialogo.Lista1)
     LinkearHoja('LOGTOT',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,String1=ItemLista(Dialogo.Lista1,&i),String2=Dialogo.String2,String=Dialogo.String,Operador=Dialogo.Operador,Check1=Dialogo.Check1,Radio1=Dialogo.Radio1,Lista2=Dialogo.Lista2,Lista1=Dialogo.Lista1,Check2=Dialogo.Check2,String3='NOVEDA')
  Proximo
Endif