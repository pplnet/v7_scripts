HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  Lista2     : "TipoOp"              ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION  ")
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


  SetFilaActual(1)
  ACT(a:1,'SIAF Auditoria Operaciones - CONFIDENCIAL')
  SetFont(a:1,1)


SetFilaActual(fac+2)
ACT(b:fac, 'Listado de # Lista de Operaciones por Tipo Op.')
SetFont(b:fac, 3)

SetFilaActual(fac+1)

  ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+2, 'Fecha Hasta: '~Dialogo.Fecha2)
  ACT(a:fac+4, 'Tipos de Operacion:  '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))

  SetFilaActual(fac+5)

*--  Vehiculos permitidos por el usuario
ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
ACT(VH:3, UsrVehiculos(UsuarioActivo))

  ACT(a:fac,'Tabla Operaciones')
  SetFont(a:fac,1)
  SetFilaActual(fac+1)
  ACT(A:fac,'Nro.Operacion')
  ACT(B:fac,'Especie')
  ACT(C:fac,'Tipo Op.')
  ACT(D:fac,'Cantidad')
  ACT(E:fac,'Precio')
  ACT(F:fac,'Fecha Op.')
  ACT(G:fac,'Fecha Carga')
  ACT(H:fac,'Entidad')
  ACT(i:fac,'Observaciones')
  AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))
  Setfont(a:fac..i:fac, 1)
  AlinearCeldas(A:fac..i:fac, 'C')
  SetFilaActual(fac+1)

  SQL.ADD(" Select  a.*  " )
  SQL.ADD("   from   "~DBO~".Operaciones a " )
  SQL.ADD(" where  a.nroperacion = a.nroperacion ")
  IF NoVacio(Dialogo.Lista2)
      SQL.ADD("   and  a.tipoop IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  endif
  SQL.ADD("   and  a.fechaop >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
  SQL.ADD("   and  a.fechaop <= '"~IdxDate(Dialogo.Fecha2)~"' ")
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND a.vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
  Endif
  SQL.ADD("order by a.nroperacion ")


Recorrer SQL
      ACT(a:fac,FBN['Nroperacion'])
      ACLO(a:fac,Val(a:fac))
      ACT(b:fac,FBN['Especie'])
      ACT(c:fac,FBN['TipoOp'])
      ACN(d:fac,FBN['Cantidad'])
      ACN(e:fac,FBN['Precio1'])
      ACT(f:fac,FBN['FechaOP'])
      ACT(g:fac,FBN['FechaCarga'])
      ACT(h:fac,FBN['Cliente1'])
      ACT(i:fac,FBN['Observaciones'])
    ACT(az:fac,FBN['Nroperacion'])
Proximo

