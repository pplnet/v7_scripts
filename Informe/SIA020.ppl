  SetFilaActual(fac+1)
  AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))

  SetFont(a:fac..i:fac, 1)
  Impresion(1,2)
  act(a:fac+2,'FIN DE LISTADO')
  SetFont(a:fac..a:fac, 1)

  LimitesVision(U:fac+2)

  ACO(3, 10)
  ACO(4, 10)
  ACO(5, 10)
  ACO(6, 10)
  ACO(7, 15)
  ACO(8, 18)
  ACO(9, 18)

  SetPrintFit(3, 75)
  RangoTitulo(a:1..i:fac+2, 9)
