CrearDialogo
Check1         : 'CHECK'                       ;3;1;1;Vacio(Dialogo.String1);;;;;
Fecha1         : 'fecha'                       ;2;1;1;;NoVacio(Dialogo.String1);;;;;;;;;;;;;
Informe1       : 'Informe'                     ;1;1;1;;;;;;;;;;;;;;
Lista1         : 'Lista'                       ;1;1;2;;;;;;;;;NO;
Mercado1       : 'Mercados'                    ;1;2;2;;;;;;;;  
Precio1        : 'PRECIO'                      ;1;3;2;;;;;;;;  
Radio1         : 'Resultado|Mensual|Anual|Otro';4;1;1;;;;;;0;
String1        : 'String'                      ;5;1;1;
FinDialogo


IF NOT OK
  Cancelar
ENDIF
*ENCABEZADO DE TABLA*
ACT(a4, 'Check')
ACT(b4, 'Fecha')
ACT(c4, 'Informe')
ACT(d4, 'Lista')
ACT(e4, 'Mercado')
ACT(f4, 'Precio')
ACT(g4, 'Radio')
ACT(h4, '-')

*DATOS MOCKEADOS*
If Dialogo.Check1=0
    ACT( a5, 'Falso')
    ACT( a6, 'Falso')
    ACT( a7, 'Falso')
Else 
   ACT( a5, 'Verdadero')
   ACT( a6, 'Verdadero')
   ACT( a7, 'Verdadero')
EndIf

ACT( b5, Dialogo.Fecha1)
ACT( b6, Dialogo.Fecha1)
ACT( b7, Dialogo.Fecha1)


ACT( c5, Dialogo.Informe1)
ACT( c6, Dialogo.Informe1)
ACT( c7, Dialogo.Informe1)

ACT( D5, Dialogo.Lista1)
ACT( D6, Dialogo.Lista1)
ACT( D7, Dialogo.Lista1)

ACT( E5, Dialogo.Mercado1)
ACT( E6, Dialogo.Mercado1)
ACT( E7, Dialogo.Mercado1)

ACT( F5, Dialogo.Precio1)
ACT( F6, Dialogo.Precio1)
ACT( F7, Dialogo.Precio1)

IF Dialogo.radio1 = 0
ACT( G5, 'Mensual')
ACT( G6, 'Mensual')
ACT( G7, 'Mensual')
else
ACT( G5, 'Anual')
ACT( G6, 'Anual')
ACT( G7, 'Anual')
endif

**ESTILOS DE LA TABLA*
AgregarMarco(A:4..h:4,2,1,RGB(255,255,0))
AgregarMarco(a:5..h:7,0,0)


