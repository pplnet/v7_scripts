**-- VIMINL: Minuta Diaria de Cuenta Corriente Vinculadas POR LOTES
* HOJAVISIBLE(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Vehiculo1  : "Vehiculo1"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Vehiculo2  : "Vehiculo2"     ;;;;;;;;;;;
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo1 ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(e:2,'Fecha : '~Var('FECHASYS'))
SetFont(e:2..f:2,1)

SetFilaActual(4)

ACT(a:FAC, "Estado Actual de Cuentas Vinculadas al "~Dialogo.Fecha1)

SetFont(a:fac..a:fac,3)
SetFilaActual(6)
ACN(w1,FAC)

ACT(a:FAC, 'Vehiculo 1')
ACT(b:FAC, 'Vehiculo 2')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Ref.Veh1')
ACT(e:FAC, 'Saldo')
ACT(f:FAC, 'Tasa (TNA)')

AlinearCeldas(a:FAC..e:FAC,'I')
SetFont(a:fac..f:FAC,2)
AgregarMarco(a:FAC..f:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)

ACT(a:FAC, "A C T I V O S")
SetFont(a:fac..a:fac,3)


ACD(AF1,Dialogo.Fecha1)

* H2 Contador de Sin Saldo
ACN(H2,1)

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

SQL.ADD("SELECT  P.Vehiculo1,P.Vehiculo2,P.ListaEspecies FROM  "~DBO~".PARESVEHICULO P ")
SQL.ADD("Where Estado='HAB' ")

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and P.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and P.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD(" and P.Vehiculo2='"~Dialogo.Vehiculo2~"' ")
EndIf

SQL.ADD("Order By P.Vehiculo1,P.Vehiculo2")

Recorrer SQL

   DFA  
   Message('Pares de Vehiculos: '~FBN['Vehiculo1']~'/'~FBN['Vehiculo2']~'  ...')

   ACT(AV1,FBN['Vehiculo1'])
   ACT(AV2,FBN['Vehiculo2'])

   * Recupero las Especies contenidas en Pares de Vehiculo
   SQL.ADD("SELECT Codigo FROM  "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(FBN['ListaEspecies'])~") ") 

   * Displayo una vez cada Par de Vehiculos
   Recorrer SQL
      * H1=1 Si esta duplicado 
      ACN(H1,0)

      * Para que no se repita el par Activos
      Recorrer&i  1,FAC-1
        IF EqStr(VAL(A:&i),VAL(AV2)) y EqStr(VAL(B:&i),VAL(AV1)) y EqStr(FBN['Codigo'],VAL(C:&i))
           * Encontre el Par Buscado
           ACN(H1,1)
           Break 
        ENDIF
      Proximo

      * Para que no se repita el par No Activos
      Recorrer&i  1,VAL(H2)
        IF EqStr(VAL(za:&i),VAL(AV2)) y EqStr(VAL(zb:&i),VAL(AV1)) y EqStr(FBN['Codigo'],VAL(zc:&i))
           * Encontre el Par Buscado
           ACN(H1,1)
           Break 
        ENDIF
      Proximo

      IF VAL(H1)=0

         ACT(a:fac, VAL(AV1))
         ACT(b:fac, VAL(AV2))
         ACT(c:fac, fbn['Codigo'])   

         ACD(AH1,0)

         * Verifico que tenga Minutas Diarias y no Minutas Mensuales
         *-- Parametros de la Funcion AV1: Vehiculo1 AV2: Vehiculo2 AF1: Fecha AE1: Especie
         SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.Vehiculo2,O.Especie  ")
         SQL.ADD("from "~DBO~".OPERACIONES O")
         SQL.ADD("where ((O.TipoOp='VIMD' and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"') or (O.TipoOp='VIMIND' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"' ) or (O.TipoOp='VIMINM' and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"' )) ")
         SQL.ADD("and O.Vehiculo1='"~VAL(AV1)~"'  and O.Vehiculo2='"~VAL(AV2)~"' ")
         SQL.ADD("and O.Especie='"~FBN['Codigo']~"' ")
         SQL.ADD(" AND NOT EXISTS ")
         SQL.ADD(" (SELECT * ")
         SQL.ADD("from "~DBO~".OPERACIONES Op ")
         SQL.ADD("where Op.TipoOp='VIMIND' and Op.FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
         SQL.ADD("      and Op.Vehiculo1=O.Vehiculo1 and Op.Vehiculo2=O.Vehiculo2  and Op.Especie=O.Especie) ")
         SQL.ADD("Order By O.Vehiculo1,O.Vehiculo2,O.Especie ")
    
         Recorrer SQL       
            DFA
            ACN(AH1,1)

            ACT(AV1,FBN['Vehiculo1'])
            ACT(AV2,FBN['Vehiculo2'])

            Message('Saldos Vehiculo: '~FBN['Vehiculo1']~' Veh. ContraParte '~FBN['Vehiculo2']~' Especie:'~FBN['Especie']~' ...')

            *-- Parametros de la Funcion AV1: Vehiculo1 AV2: Vehiculo2 AF1: Fecha AE1: Especie
            ACT(AE1,FBN['Especie'])
 
            (.'SALDIAVINC'.)

            IF Round(VAL(Z1),2)<>0
               ACN(e:fac, VAL(Z1))
               ACT(d:fac, IIF(Round(VAL(e:fac),2)=0,'SIN  SALDO',IIF(VAL(e:fac)<0,'COLOCA','TOMA')))
               ACN(e:fac, IIF(VAL(Z1)<0,-VAL(Z1),VAL(Z1)))
               ACN(f:fac, SQL("SELECT Tasa    from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~VAL(AV1)~"' and Vehiculo2='"~VAL(AV2)~"') or (Vehiculo1='"~VAL(AV2)~"' and Vehiculo2='"~VAL(AV1)~"')) and Especie ='"~FBN['Especie']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
               SetFont(a:fac..f:fac,1)
               FormatoCeldas(e:fac..f:fac,EXE('F2'))
            Else
               ACN(AH1,0)
            EndIf
         Proximo

         * No encontro el Mov. Diario => Busco el Mov. Mensual
         IF VAL(AH1)=0
            SQL.ADD("SELECT * ")
            SQL.ADD("from "~DBO~".OPERACIONES ")
            SQL.ADD("where TipoOp='VIMIND'  and Vehiculo1='"~VAL(AV1)~"'  and Vehiculo2='"~VAL(AV2)~"' ")
            SQL.ADD("and Especie='"~FBN['Codigo']~"' ")
            SQL.ADD("and FechaOp='"~IdxDate(Dialogo.Fecha1)~"'  ")
            SQL.ADD("Order By Vehiculo1,Vehiculo2,Especie ")

            Recorrer SQL
               DFA
               ACT(d:fac, IIF(FBN['MB3']=0,'COLOCA','TOMA'))
               ACN(e:fac, FBN['Cantidad'])
               ACN(f:fac, FBN['Precio1'])
               ACN(g:fac, 0)
               SetFont(a:fac..f:fac,1)
               FormatoCeldas(e:fac..f:fac,EXE('F2'))
               ACN(AH1,1)
            Proximo
         EndIf

         IF VAL(AH1)=0
            * Sin Saldo
            ACT(za:VAL(h2), VAL(AV1))
            ACT(zb:VAL(h2), VAL(AV2))
            ACT(zc:VAL(h2), fbn['Codigo'])   
            ACN(ze:VAL(h2), 0)
            ACT(zd:VAL(h2), 'Sin SALDO')
            ACN(zf:VAL(h2), SQL("SELECT Tasa    from "~DBO~".TASASVEHICULO where ((Vehiculo1='"~VAL(AV1)~"' and Vehiculo2='"~VAL(AV2)~"') or (Vehiculo1='"~VAL(AV2)~"' and Vehiculo2='"~VAL(AV1)~"')) and Especie ='"~FBN['Codigo']~"' and Fecha='"~IdxDate(Dialogo.Fecha1)~"' "))
            ACN(zg:VAL(h2), 1)
            SCN(h2,1)
            
            BorrarCeldas(a:fac..c:fac)
            DFA
         ENDIF
      Else
         DFA
      EndIf
   Proximo
Proximo

SetFilaActual(FAC+2)
ACT(a:FAC, "N O    A C T I V O S")
SetFont(a:fac..a:fac,3)
SetFilaActual(FAC+2)


Recorrer&j 1,VAL(H2)-1
   ifa
   ACT(a:fac, VAL(za:&j))
   ACT(b:fac, VAL(zb:&j))
   ACT(c:fac, VAL(zc:&j))   
   ACN(e:fac, VAL(ze:&j))
   ACT(d:fac, VAL(zd:&j))
   ACN(f:fac, VAL(zf:&j))
   ACN(g:fac, VAL(zg:&j))

   SetFont(a:fac..f:fac,1)
   FormatoCeldas(e:fac..f:fac,EXE('F2'))

Proximo

ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,7)
ACO(8,7)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(f:FAC)
*RangoTitulo(a1..k:8,36)



