*ModoReproceso(ConDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'    ;1;1;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;Fsys
  Especie1 : 'Especie'  ;2;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1, 'TITULO') o DesciendeDeEspecie(Dialogo.Especie1, 'CUPON');'Especie invalida';NO
  Vehiculo1: 'Vehiculo' ;3;1;;;;Vacio(Dialogo.Vehiculo1) o Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")));'Debe Ingresar un Vehiculo Valido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Lista3   : 'Books'    ;4;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".BOOKS");
FinDialogo
if NOT OK
 Cancelar
endif

CrearFont(1,"Arial,12,BI")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,")
CrearFont(4,"Arial,8,BU")
CrearFont(5,"Arial,8,BI")
CrearFont(6,"Arial,8,B")
CrearFont(7,"Arial,8,")

If NoVacio(Dialogo.Vehiculo1)
  ACT(az:6, Dialogo.Vehiculo1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(az:6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Else
    ACT(az:6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
  EndIf
Endif

SetFilaActual(1)
ACT(a:fac,'Posicion por Especie para Valuacion')
SetFont(a:fac,1)

SetFilaActual(fac+2)
ACT(a:fac  ,'Fecha:')
ACT(b:fac  ,Dialogo.Fecha1)
ACT(a:fac+1,'Especie:')
if NoVacio(Dialogo.Especie1)
  ACT(b:fac+1, Dialogo.Especie1~' - '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(b:fac+1,'Todas')
endif
ACT(a:fac+2, 'Vehiculo:')
If NoVacio(Dialogo.Vehiculo1) O NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(b:fac+2, Val(az:6))
ELSE
    ACT(b:fac+2, 'Todos')
Endif
ACT(a:fac+3, 'Book:')
if NoVacio(Dialogo.Lista3)
  ACT(b:fac+3, Dialogo.Lista3)
else
  ACT(b:fac+3,'Todos')
endif
SetFont(a:fac..a:fac+3,3)
SetFont(b:fac..b:fac+3,2)

SetFilaActual(fac+5)
ACT(a:fac  , 'Especie')
ACT(b:fac  , 'Cupon')
ACT(c:fac  , 'Cotiza')
ACT(d:fac  , 'Book')
ACT(j:fac  , 'Expresado en ARP')
ACT(e:fac+1, 'Saldo')
ACT(f:fac+1, 'Fecha.Pos')
ACT(g:fac+1, 'Pos.Inicial')
ACT(h:fac+1, 'PP Inicial')
ACT(i:fac+1, 'Cant.Com.')
ACT(j:fac+1, 'PP Compras')
ACT(k:fac+1, 'Cant.Ven.')
ACT(l:fac+1, 'PP Ventas')
ACT(m:fac+1, 'Pos.Final')
ACT(n:fac+1, 'PP Final')
ACT(o:fac+1, 'Cotizacion')
ACT(p:fac+1, 'Pos.Val.')

ACT(v:fac  , 'Expresado en USD')
ACT(q:fac+1, 'Saldo')
ACT(r:fac+1, 'Fecha.Pos')
ACT(s:fac+1, 'Pos.Inicial')
ACT(t:fac+1, 'PP Inicial')
ACT(u:fac+1, 'Cant.Com.')
ACT(v:fac+1, 'PP Compras')
ACT(w:fac+1, 'Cant.Ven.')
ACT(x:fac+1, 'PP Ventas')
ACT(y:fac+1, 'Pos.Final')
ACT(z:fac+1, 'PP Final')
ACT(aa:fac+1, 'Cotizacion')
ACT(ab:fac+1, 'Pos.Val.')

SetFont(a:fac..ab:fac+1,6)
AlinearCeldas(a:fac..d:fac+1,'I')
AlinearCeldas(e:fac..ab:fac,'C')
AlinearCeldas(e:fac+1..e:fac+1,'I')
AlinearCeldas(f:fac+1..p:fac+1,'D')
AlinearCeldas(q:fac+1..q:fac+1,'I')
AlinearCeldas(r:fac+1..ab:fac+1,'D')
AgregarMarco(a:fac..d:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(e:fac..p:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(q:fac..ab:fac,0,0,EXE('COLOR6'))
AgregarMarco(a:fac+1..ab:fac+1,0,0,EXE('COLOR6'))

IFA
ACN(aw:1, FAC+2)
ACN(aw:2, FAC+2)
ACT(az:1,'')



SQL.ADD("Select P.Vehiculo, V.Descripcion, P.Book, P.Especie, E.Nombre, E.Cotiza, E.InteresesC, ")
SQL.ADD("       P.Cupon, P.Fecha, P.NrSaldo, ")
SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
SQL.ADD("       P.Cantidad1, P.Precio1, ")
SQL.ADD("       P.Cantidad2, P.Precio2, ")
SQL.ADD("       P.CantidadFin, P.PrecioFin ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" where P.Especie      =  E.Codigo ")
SQL.ADD("   and P.Vehiculo     =  V.Codigo ")
SQL.ADD("   and NrSaldo        in (120,130) ")
SQL.ADD("   and P.TipoNegocio  =  'SEC' ")
SQL.ADD("   and P.Vehiculo In  ("~Pipe2Comillas(val(az6))~") ")
SQL.ADD("   and (P.CantidadIni <> 0 ")
SQL.ADD("     or P.Cantidad1 <> 0 ")
SQL.ADD("     or P.Cantidad2 <> 0 ")
SQL.ADD("     or P.CantidadFin <> 0 ")
SQL.ADD("       ) ")
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie    = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Lista3)
  SQL.ADD(" and P.Book   in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P.Fecha     = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES ")
SQL.ADD("                       where Especie     =  P.Especie ")
SQL.ADD("                        and  (Cupon = P.Cupon or (Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                        and  NrSaldo     =  P.NrSaldo ")
SQL.ADD("                        and  Vehiculo    =  P.Vehiculo ")
SQL.ADD("                        and  IsNull(Book,'') =  IsNull(P.Book,'') ")
SQL.ADD("                        and  TipoNegocio =  P.TipoNegocio ")
SQL.ADD("                        and  Fecha       <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("                     ) ")
SQL.ADD(" order by P.Vehiculo, P.Especie, P.Book, IsNull(P.Cupon,''), P.NrSaldo ")
Recorrer SQL
  message(fbn('Vehiculo'))
  If Not EqStr(fbn('Vehiculo'),Val(az:1))
    SetFont(a:Val(aw:2)..ax:fac,7)
    ifa
    ACT(az:1,fbn('Vehiculo'))
    ACT(az:2,'')
    ACT(az:3,'')
    ACT(az:7,'')
    ACT(a:fac, 'Vehiculo: '~fbn('Vehiculo')~' - '~fbn('Descripcion'))
    SetFont(a:fac,4)
    ifa
    ACN(aw:2, FAC)
  Endif

  if EqStr(fbn('Especie'),Val(az:2)) y EqStr(fbn('Cupon'),Val(az:3)) y EqStr(fbn('Book'),Val(az:7))
    DFA
  else
    ACT(a:fac, fbn('Especie')~' '~fbn('Nombre'))
    ACT(b:fac, fbn('Cupon'))
    ACT(c:fac, fbn('Cotiza'))
    ACT(d:fac, fbn('Book'))
    ACT(az:2, fbn('Especie'))
    ACT(az:3, fbn('Cupon'))
    ACT(az:7, fbn('Book'))
  endif

  if fbn('Nrsaldo')=120
    SCN(ad:FAC, 1)
    ACN(az:4, 5)
    ACT(az:5, 'ARP')
  else
    SCN(ae:FAC, 1)
    ACN(az:4, 17)
    ACT(az:5, 'USD')
  endif

  ACT(Val(az:4):fac, Fstr(fbn('NrSaldo'),3,0))
  ACD(Val(az:4)+1:fac, fbn('Fecha'))
  if fbn('Fecha')=Dialogo.Fecha1
    ACN(Val(az:4)+2:fac, fbn('CantidadIni'))
    ACN(Val(az:4)+3:fac, fbn('PrecioIni'))
    ACN(Val(az:4)+4:fac, fbn('Cantidad1'))
    ACN(Val(az:4)+5:fac, fbn('Precio1'))
    ACN(Val(az:4)+6:fac, fbn('Cantidad2'))
    ACN(Val(az:4)+7:fac, fbn('Precio2'))
  else
    ACN(Val(az:4)+2:fac, fbn('CantidadFin'))
    ACN(Val(az:4)+3:fac, fbn('PrecioFin'))
    ACN(Val(az:4)+4:fac, 0)
    ACN(Val(az:4)+5:fac, 0)
    ACN(Val(az:4)+6:fac, 0)
    ACN(Val(az:4)+7:fac, 0)
  endif
  ACN(Val(az:4)+8:fac, fbn('CantidadFin'))
  ACN(Val(az:4)+9:fac, fbn('PrecioFin'))
  ACN(Val(az:4)+10:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(az:5)))
  ACN(Val(az:4)+11:fac, Val(Val(az:4)+8:fac)*Val(Val(az:4)+10:fac)*iif(Eqstr(fbn('InteresesC'),'CLE'),ValorTeorico(fbn('Especie')),1))

Proximo

SetFont(a:Val(aw:2)..ax:fac,7)

if FAC>Val(aw:1)
  recorrer&i Val(aw:1),FAC
    ACT(af:&i, 'Analizado')
    if Val(g:&i)=0 y Val(i:&i)=0 y Val(k:&i)=0 y Val(m:&i)=0 y Val(s:&i)=0 y Val(u:&i)=0 y Val(w:&i)=0 y Val(y:&i)=0
      if Novacio(Val(c:&i))
        ACT(ag:&i, 'Borrar')
      endif
    endif
  proximo
endif
ACN(au:1, FAC)
ACN(au:2, Val(aw:1)-1)
recorrer&i Val(aw:1),Val(au:1)
  SCN(au:2, 1)
  ACT(ai:Val(au:2), 'Visto')
  if EqStr(Val(ag:Val(au:2)),'Borrar')
    ACT(ah:Val(au:2), 'Eliminado')
    ***---EliminarFila(Val(au:2))
    BorrarFilas(Val(au:2), Val(au:2), SI)
    SCN(au:2, -1)
    DFA
  endif
proximo
ACN(au:3, FAC)

SetFont(au:1..az:10,7)

FormatoCeldas(g:Val(aw:1)..p:fac,Exe('F2'))
FormatoCeldas(s:Val(aw:1)..ab:fac,Exe('F2'))
FormatoCeldas(h:Val(aw:1)..h:fac,Exe('F8'))
FormatoCeldas(j:Val(aw:1)..j:fac,Exe('F8'))
FormatoCeldas(l:Val(aw:1)..l:fac,Exe('F8'))
FormatoCeldas(n:Val(aw:1)..o:fac,Exe('F8'))
FormatoCeldas(t:Val(aw:1)..t:fac,Exe('F8'))
FormatoCeldas(v:Val(aw:1)..v:fac,Exe('F8'))
FormatoCeldas(x:Val(aw:1)..x:fac,Exe('F8'))
FormatoCeldas(z:Val(aw:1)..aa:fac,Exe('F8'))

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC,6)

ACO( 1,12)
ACO( 2, 5)
ACO( 3, 5)
ACO( 4, 5)
ACO( 5, 4)
