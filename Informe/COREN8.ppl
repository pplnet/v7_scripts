ModoReproceso(ConDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1   : 'Desde';;;;;;;;;;FSYS-1
   Fecha2   : 'Hasta';;;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error de Fechas';NO;;FSYS-1
   Vehiculo1: "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Radio3   : 'Origen:|Todas|Activas|Pasivas';;;;NO;;;;;1;
   Radio6   : 'Clientes:|Todos|Vinculados|Terceros';;;;NO;;;;;2;
   Radio1   : 'Terc y Act|Todos|Dep.Pla|Cta.Cte';;;;NO;;;;;1;
   Radio7   : 'Especies:|Todas|Algunas';;;;;;;;;0;
   Especie1 : 'Moneda:';;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4   : 'Imp.Detallado' ;;;;;;;;;;0;
   Lista2   : 'Especies'     ;;;;Dialogo.Radio7=1;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Lista3   : 'Clientes'     ;4;2;;Dialogo.Radio6<>0;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6,Dialogo.Vehiculo1~'|')
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else 
      *- zz6 Siempre contiene los Vehiculos Habilitados
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*AgregarBMP(a1,Var('LOGO'),Var('ESCALOGO'))

ACT(a:3, 'SISTEMA DE COSTOS Y RENDIMIENTOS - OPERACIONES DE CAJA DE AHORRO')
SetFont(a:3..a:3,3)

ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

If NoVacio(val(zz6))
   ACT(h5,'Vehiculos: '~val(zz6))   
Else 
   ACT(h5,'Vehiculos: Todos')   
EndIf

If Dialogo.Radio6 = 0 
  ACT(h6,'Clientes: TODOS' )   
Else
  If NoVacio(Dialogo.Lista3)
     ACT(h6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
  Else
     If Dialogo.Radio6 = 1
         ACT(h6,'Clientes: VINCULADOS' )   
     Else 
         ACT(h6,'Clientes: TERCEROS' )   
     Endif 
  Endif   
Endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(h7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(h7,'Especies: TODAS' )   
endif

If Dialogo.Radio3 = 0
   ACT(d6,'Origen: ACTIVAS y PASIVAS ')
Else
   If Dialogo.Radio3 = 1
      ACT(d6,'Origen: ACTIVAS ')
   Else
      ACT(d6,'Origen: PASIVAS ')
   Endif 
Endif

if Dialogo.Radio1=0
  ACT(k5, 'Terc y Act: Todos')
else
  if Dialogo.Radio1=1
    ACT(k5, 'Terc y Act: Dep.Plazo')
  else
    if Dialogo.Radio1=2
      ACT(k5, 'Terc y Act: Cta.CTe.Terceros')
    endif
  endif
endif


SetFont(a0..z7, 2)




SetFilaActual(5)
ACN(bh:1,FAC)


SetFilaActual(FAC+4)


ACT(a:fac,'Empresa')
ACT(b:fac,'TipOp')
ACT(c:fac,'NroOp')
ACT(d:fac,'Entidad')
ACT(e:fac,'Moneda')
ACT(f:fac,'F.Origen')
ACT(g:fac,'F.Vto')
ACT(h:fac,'F.Pago Int.')
ACT(i:fac,'Cbio.Origen')
ACT(j:fac,'Cbio.Vto.K')
ACT(k:fac,'Cbio.Vto.Int')
ACT(l:fac,'Cbio.Desde')
ACT(m:fac,'Cbio.Hasta')
ACT(n:fac,'Capital')
ACT(o:fac,'K.Aplic.Cap.')
ACT(p:fac,'K.Aplic.Int')
ACT(q:fac,'Tasa')
ACT(r:fac,'Tasa Aplic.')
ACT(s:fac,'Plazo K.')
ACT(t:fac,'Plazo Int.')
ACT(u:fac,'Dias Transc. K')
ACT(v:fac,'Dias Transc.Int.')
ACT(w:fac,'Int.Total')
ACT(x:fac,'Intereses')
ACT(y:fac,'Cap.Origen')
ACT(z:fac,'Cap.Vto.')
ACT(aa:fac,'Int.Dev.')
ACT(ab:fac,'Int.Pag.')
ACT(ac:fac,'Intereses')
ACT(ad:fac,'Tasa Implic.')
ACT(ae:fac,'C*DT*T')
ACT(af:fac,'C*DT')
ACT(ag:fac,'C*P')
ACT(ah:fac,'DiasEnd K')
ACT(ai:fac,'DiasEnd Int.')
ACT(aj:fac,'Int.Tot.')
ACT(ak:fac,'Intereses')
ACT(al:fac,'Cap.Origen')
ACT(am:fac,'Cap.Vto.')
ACT(an:fac,'Int.Dev.')
ACT(ao:fac,'Int.Pag.')
ACT(ap:fac,'Intereses')
ACT(aq:fac,'Tasa Implic.')
ACT(ar:fac,'C*DT*T')
ACT(as:fac,'C*DT')

AlinearCeldas(c:FAC..c:FAC,'D')
AlinearCeldas(i:FAC..as:FAC,'D')

SetFont(a:Val(bh:1)..as:FAC,2)
AgregarMarco(a:FAC..as:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)


*----- Armado de consulta ----------------------------------------------
SQL.ADD("SELECT NrOperacion,TipoOp,Cliente1,Vehiculo1,FechaOp,FechaVto,Especie, ")
SQL.ADD("       Cotizacion1,FechaPago,Cantidad,Precio1,Spread ")
SQL.ADD(" FROM "~DBO~".OPERACIONES ")
If Dialogo.Radio6 > 0 
   SQL.ADD("O ,"~DBO~".CLIENTES C ")
Endif
SQL.ADD(" WHERE ")

if NoVacio(VAL(zz6))
   SQL.ADD(" Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Else
   SQL.ADD(" Vehiculo1=Vehiculo1  ")
Endif

If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1
    SQL.ADD(" and C.Codigo = O.Cliente1 and SubString(C.Jerarquia,1,3) = '"~VAR('JERVINCUL')~"' ")
  Else
    SQL.ADD(" and C.Codigo = O.Cliente1 and SubString(C.Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' ")
  Endif
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("    and Cliente1 In ("~Pipe2Comillas(Dialogo.Lista3)~") ")   
Endif
SQL.ADD("       and FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and FechaOp < '"~IdxDate(Dialogo.Fecha2)~"'    ")
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
   SQL.ADD("    and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
*-- Para Todo o Deposito a Plazo
if Dialogo.Radio1=0 o Dialogo.Radio1=1
  SQL.ADD("       and TipoOp in ('MMDCA','MMCCR') ")
endif
SQL.ADD(" ORDER BY NrOperacion ")
*-----------------------------------------------------------

     
ACN(cd:1, Fac +1)
ACN(ce:1, Fac )

Recorrer SQL
     ACT(a:fac,FBN['Vehiculo1'])  
     ACT(b:fac,FBN['TipoOp'])
     ACT(c:fac,FBN['NrOperacion'])
     ACLO(c:fac,FBN['NrOperacion'])
     ACT(d:fac,FBN['Cliente1'])
     ACT(e:fac,FBN['Especie'])
     ACD(f:fac,FBN['FechaOp'])
     ACD(g:fac,FBN['FechaVto'])
     ACD(h:fac,FBN['FechaPago']) 


     If Eqstr(FBN['Especie'],Dialogo.Especie1)
        ACN(i:fac,1)
        ACN(j:fac,1)
        ACN(k:fac,1)
        ACN(l:fac,1)
        ACN(m:fac,1)
        ACN(xi:fac,1)
        ACN(xj:fac,1)
        ACN(xk:fac,1)
        ACN(xl:fac,1)
        ACN(xm:fac,1)
     Else
        If Eqstr(Var('MONEEXTR'),Dialogo.Especie1)

           If FBN['Cotizacion1'] <> 0 
              ACN(i:fac,FBN['Cotizacion1'])
              if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                ACN(xi:fac,1/Val(i:fac))
              else
                ACN(xi:fac,Val(i:fac))
              endif
           Else
              ACN(xi:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaOp']-1, 1,SI,Dialogo.Especie1) )
              if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                ACN(i:fac,1/Val(xi:fac))
              else
                ACN(i:fac,Val(xi:fac))
              endif
           Endif 
        Else
           ACN(xi:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaVto']-1, 1,SI,Dialogo.Especie1) )
           if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
             ACN(i:fac,1/Val(xi:fac))
           else
             ACN(i:fac,Val(xi:fac))
           endif
        Endif

        If FBN['FechaVto'] < Fsys  
           ACN(xj:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaVto']-1, 1,SI,Dialogo.Especie1))
           if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
             ACN(j:fac,1/Val(xj:fac))
           else
             ACN(j:fac,Val(xj:fac))
           endif
        Else 
           ACN(j:fac, 0 )
           ACN(xj:fac, 0 )
        Endif 

        If FBN['FechaPago'] < Fsys  
           ACN(xk:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaPago']-1, 1,SI,Dialogo.Especie1))
           if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
             ACN(k:fac,1/Val(xk:fac))
           else
             ACN(k:fac,Val(xk:fac))
           endif
        Else 
           ACN(k:fac, 0 )
           ACN(xk:fac, 0 )
        Endif

        ACN(xl:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1 -1, 1,SI,Dialogo.Especie1) ) 
        ACN(xm:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2 -1, 1,SI,Dialogo.Especie1) )
        if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~fbn('Especie')~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
          ACN(l:fac,1/Val(xl:fac))
          ACN(m:fac,1/Val(xm:fac))
        else
          ACN(l:fac,Val(xl:fac))
          ACN(m:fac,Val(xm:fac))
        endif
     Endif


     ACN(n:fac,FBN['Cantidad'])

     *-- K.Aplic.Capital ---
     If FBN['FechaVto'] > Dialogo.Fecha1
        ACN(o:fac,Val(n:fac))  
     Else
        ACN(o:fac, 0 ) 
     Endif
  

     ACN(q:fac,FBN['Precio1']+FBN['Spread'])  

     *--Plazo k---
     ACN(s:fac,DifDias(FBN['FechaVto'],FBN['FechaOp'],'ARG',NO) )
     *--Plazo Int.---
     ACN(t:fac,DifDias(FBN['FechaPago'],FBN['FechaVto'],'ARG',NO) )

     *----  Dias Transcurridos Int ---------
     If FBN['FechaVto'] >= Dialogo.Fecha2
         ACN(v:fac, 0 )
     Else
         If FBN['FechaVto'] <= Dialogo.Fecha1 
            IF FBN['FechaPago'] < Dialogo.Fecha2  
		If FBN['FechaPago'] > Dialogo.Fecha1
                   ACN(v:fac, DifDias(FBN['FechaPago'],Dialogo.Fecha1,'ARG',NO) )
                Else  
                   ACN(v:fac, 0 )
                Endif 
	    Else	
                ACN(v:fac, DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) )
	    Endif	
         Else
            IF FBN['FechaPago'] < Dialogo.Fecha2              
               ACN(v:fac, DifDias(FBN['FechaPago'],FBN['FechaVto'],'ARG',NO) )
            Else
               ACN(v:fac, DifDias(Dialogo.Fecha2,FBN['FechaVto'],'ARG',NO) )
            Endif
         Endif  
     Endif

     ACN(w:fac, Val(n:fac)*Val(q:fac)*Val(s:fac)/36500  ) 

     *-- K.Aplic.Inter. ---
     If FBN['FechaPago'] > Dialogo.Fecha1 y  FBN['FechaVto'] < Dialogo.Fecha2 
        ACN(p:fac,Val(w:fac))  
     Else
        ACN(p:fac, 0 ) 
     Endif


     *-- Si hay capital aplicado-----
     If Val(o:fac) > 0 
        ACN(r:fac, Val(q:fac) )   

        *----  Dias Transcurridos k ---------
        If FBN['FechaVto'] <= Dialogo.Fecha1
           ACN(u:fac, 0 )
        Else
           If FBN['FechaVto'] < Dialogo.Fecha2 
             If FBN['FechaOp'] <= Dialogo.Fecha1
                ACN(u:fac, DifDias(FBN['FechaVto'],Dialogo.Fecha1,'ARG',NO) )
             Else
                ACN(u:fac, DifDias(FBN['FechaVto'],FBN['FechaOp'],'ARG',NO) )
             Endif
           Else            
             If FBN['FechaOp'] > Dialogo.Fecha1 y FBN['FechaOp'] < Dialogo.Fecha2
                ACN(u:fac, DifDias(FBN['FechaVto'],FBN['FechaOp'],'ARG',NO) )
             Else
                ACN(u:fac, DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) )
             Endif
           Endif  
        Endif

        ACN(x:fac, Val(o:fac)*Val(q:fac)*Val(u:fac)/36500  )  

        *-- Capital al Origen ---
        If FBN['FechaOp'] <= Dialogo.Fecha1
           ACN(y:fac, Val(n:fac)*Val(xl:fac)  ) 
        Else
           ACN(y:fac, Val(n:fac)*Val(xi:fac)  ) 
        Endif

        *-- Capital al Vto ---
        If FBN['FechaVto'] <= Dialogo.Fecha1
            ACN(z:fac, 0 )
        Else 
          If FBN['FechaOp'] < Dialogo.Fecha2 
             If FBN['FechaVto'] >= Dialogo.Fecha2
                ACN(z:fac, Val(n:fac)*Val(xm:fac)  )    
             Else
                If FBN['FechaVto'] > Dialogo.Fecha1   
                   ACN(z:fac, Val(n:fac)*Val(xj:fac)  )    
                Endif
             Endif
          Endif 
        Endif

     Else
        ACN(r:fac, 0)
        ACN(u:fac, 0)
        ACN(x:fac, 0)
        ACN(y:fac, 0)
        ACN(z:fac, 0)
     Endif 

     *--- Intereses Devengados ---
     If FBN['FechaVto'] > Dialogo.Fecha1    
        ACN(aa:fac, 0 )
     Else
        ACN(aa:fac, Val(p:fac)*Val(xl:fac) )
     Endif 

     *--- Intereses Pagados ---
     If FBN['FechaVto'] <= Dialogo.Fecha1    
         If FBN['FechaPago'] < Dialogo.Fecha2       
           If FBN['FechaPago'] > Dialogo.Fecha1 
             ACN(ab:fac,Val(w:fac)*Val(xk:fac))
           Endif
         Else	
            ACN(ab:fac,Val(w:fac)*Val(xm:fac))
         Endif
     Else
         If FBN['FechaPago'] < Dialogo.Fecha2       
            ACN(ab:fac,Val(x:fac)*Val(xk:fac))
         Else	
            ACN(ab:fac,Val(x:fac)*Val(xm:fac))
         Endif
     Endif


     *-- Si hay capital aplicado-----
     If Val(o:fac) > 0 
        ACN(ac:fac,-Val(y:fac)+Val(z:fac)-Val(aa:fac)+Val(ab:fac))
     Else
        ACN(ac:fac, 0)
     Endif 


     *-- Tasa Implicita ----
     If Val(u:fac) <> 0
        ACN(ad:fac, (Val(ac:fac)*36500) / ((Val(y:fac)+Val(aa:fac)) * Val(u:fac) ) ) 
        ACN(ae:fac, Val(y:fac)*Val(u:fac)*Val(ad:fac) /100 )
        ACN(af:fac, Val(y:fac)*Val(u:fac) ) 
        ACN(ag:fac, Val(y:fac)*Val(s:fac) ) 
     Else
        ACN(ad:fac, (Val(ac:fac)*36500) / ((Val(y:fac)+Val(aa:fac)) * Val(v:fac) ) ) 
        ACN(ae:fac, Val(aa:fac)*Val(v:fac)*Val(ad:fac) /100 )
        ACN(af:fac, Val(aa:fac)*Val(v:fac) ) 
        ACN(ag:fac, Val(aa:fac)*Val(t:fac) ) 
     Endif   


     *--- Dias a End K ---
     If FBN['FechaVto'] < Dialogo.Fecha2
         ACN(ah:fac, 0 ) 
     Else
         ACN(ah:fac, DifDias(FBN['FechaVto'],Dialogo.Fecha2,'ARG',NO) )
     Endif  	

     *---Dias End Int. ----
     If FBN['FechaPago'] <=  Dialogo.Fecha2
        ACN(ai:fac, 0 ) 
     Else
        If FBN['FechaVto'] <  Dialogo.Fecha2
           ACN(ai:fac, DifDias(FBN['FechaPago'],Dialogo.Fecha2,'ARG',NO) ) 
        Else
           ACN(ai:fac, DifDias(FBN['FechaPago'],FBN['FechaVto'],'ARG',NO) )
        Endif
     Endif

     *---Intereses tot. End---
     If Val(ah:fac) = 0 y  Val(ai:fac) = 0 
	 ACN(aj:fac, 0 ) 
     Else
	 ACN(aj:fac,Val(w:fac)  ) 
     Endif


     If Val(ah:fac) = 0 
	 ACN(ak:fac, 0 ) 
         ACN(al:fac, 0 ) 
         ACN(am:fac, 0 ) 
     Else
         ACN(ak:fac, (Val(n:fac)*Val(ah:fac)*Val(q:fac)/36500) )
         ACN(al:fac, Val(n:fac)*Val(xm:fac) ) 
         ACN(am:fac, Val(n:fac)*Val(xj:fac) ) 
     Endif

     *--- Intereses Devengados ---
     If FBN['FechaVto'] > Dialogo.Fecha2
         ACN(an:fac, 0 ) 
     Else
         ACN(an:fac, Val(aj:fac)*Val(xm:fac) )         
     Endif  	

     *--- Intereses Pagados ---
     If FBN['FechaPago'] > Dialogo.Fecha2 
        IF FBN['FechaVto'] <= Dialogo.Fecha2
          If Val(xk:fac) <> 0  
             ACN(ao:fac, Val(aj:fac)*Val(xk:fac) )
          Else
             ACN(ao:fac, Val(aj:fac)*Val(xm:fac) )
          Endif   
        Else
          If Val(xk:fac) <> 0  
             ACN(ao:fac, Val(ak:fac)*Val(xk:fac) )
          Else
             ACN(ao:fac, Val(ak:fac)*Val(xm:fac) )
          Endif   
        Endif  
     Else
        ACN(ao:fac, 0 )
     Endif

     ACN(ap:fac, -Val(al:fac)+Val(am:fac)-Val(an:fac)+Val(ao:fac) )

     *-- Tasa Implicita ----
     If Val(ah:fac) = 0  
       If Val(ai:fac) = 0 
	  ACN(aq:fac, 0 ) 
       Else
          ACN(aq:fac, (Val(ap:fac)*36500) / ((Val(al:fac)+Val(an:fac)) * Val(ai:fac))  ) 
       Endif 
     Else
         ACN(aq:fac, (Val(ap:fac)*36500) / ((Val(al:fac)+Val(an:fac)) * Val(ah:fac) ) ) 
     Endif

     If Val(ah:fac) = 0 
         ACN(ar:fac, Val(an:fac)*Val(aq:fac)*Val(ai:fac) /100  )
         ACN(as:fac, Val(an:fac)*Val(ai:fac) )
     Else
         ACN(ar:fac, Val(al:fac)*Val(aq:fac)*Val(ah:fac) /100  )
         ACN(as:fac, Val(al:fac)*Val(ah:fac) )
     Endif  

Proximo

SetFont(a:10..as:fac,1)

*--posicion de la ultima cuota barrida de todas las Operaciones
ACN(ce:1, Fac )

FormatoCeldas(i:Val(cd:1)..m:fac, EXE('F7'))
FormatoCeldas(s:Val(cd:1)..s:fac, EXE('F0'))
FormatoCeldas(t:Val(cd:1)..t:fac, EXE('F0'))
FormatoCeldas(q:Val(cd:1)..q:fac, EXE('F5'))
FormatoCeldas(r:Val(cd:1)..r:fac, EXE('F5'))
FormatoCeldas(ad:Val(cd:1)..ad:fac, EXE('F5'))
FormatoCeldas(aq:Val(cd:1)..aq:fac, EXE('F5'))

SetFilaActual(Fac+2)



If Val(cd:1) <= Val(ce:1)
    *--- Hago las sumatorias ---
    ACN(n:fac , SUM(n:Val(cd:1)..n:Val(ce:1)) )
    ACN(w:fac , SUM(w:Val(cd:1)..w:Val(ce:1)) )
    ACN(x:fac , SUM(x:Val(cd:1)..x:Val(ce:1)) )
    ACN(y:fac , SUM(y:Val(cd:1)..y:Val(ce:1)) )
    ACN(aa:fac , SUM(aa:Val(cd:1)..aa:Val(ce:1)) )
    ACN(ae:fac , SUM(ae:Val(cd:1)..ae:Val(ce:1)) )
    ACN(af:fac , SUM(af:Val(cd:1)..af:Val(ce:1)) )
    ACN(ag:fac , SUM(ag:Val(cd:1)..ag:Val(ce:1)) )
    ACN(al:fac , SUM(al:Val(cd:1)..al:Val(ce:1)) )
    ACN(an:fac , SUM(an:Val(cd:1)..an:Val(ce:1)) )
    ACN(ap:fac , SUM(ap:Val(cd:1)..ap:Val(ce:1)) )
    ACN(ar:fac , SUM(ar:Val(cd:1)..ar:Val(ce:1)) )
    ACN(as:fac , SUM(as:Val(cd:1)..as:Val(ce:1)) )


    *--- Saco resultados definitivos ---

    *--Tasa media anual
    ACN(bu:1,Val(ae:fac)/Val(af:fac)*100 )  
    *--Capital Promedio
    ACN(bv:1, Val(af:fac) / (Dialogo.Fecha2 - Dialogo.Fecha1) )
    *--Plazo Promedio
    ACN(bw:1, Val(ag:fac) / (Val(y:fac)+Val(aa:fac))  )

    *--Tasa media anual Ahead
    ACN(bx:1,Val(ar:fac)/Val(as:fac)*100 )  
    *--Capital promedio Ahead
    ACN(by:1,  Val(as:fac) / ( Val(as:fac) / (Val(al:fac)+Val(an:fac))  )  )  
    *--Plazo Promedio Ahead
    ACN(bz:1,  Val(as:fac) / ( Val(al:fac)+Val(an:fac)) )  


Else
    ACN(bu:1,0)
    ACN(bv:1,0)
    ACN(bw:1,0)
    ACN(bx:1,0)
    ACN(by:1,0)
    ACN(bz:1,0)
Endif

SetFont(a:fac..as:fac,2)

SetFilaActual(fac+2)

ACT(h:fac ,'Tasa media anual')
ACT(h:fac+1,'Capital Promedio')
ACT(h:fac+2,'Plazo Promedio')
ACT(h:fac+4,'AHEAD:')
ACT(h:fac+5,'    Tasa media anual')
ACT(h:fac+6,'    Capital promedio')
ACT(h:fac+7,'    Duration')

ACN(j:fac  ,Val(bu1))
ACN(j:fac+1,Val(bv1))
ACN(j:fac+2,Val(bw1))
ACN(j:fac+5,Val(bx1))
ACN(j:fac+6,Val(by1))
ACN(j:fac+7,Val(bz1))

SetFont(h:fac..j:fac+7,2)

SetFilaActual(fac+9)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac..a:fac,2)
Impresion(1,2)
LimitesVision(at:fac+2)

If Dialogo.Check4 = 1 
  ImprimirHoja(NO)
Endif 




