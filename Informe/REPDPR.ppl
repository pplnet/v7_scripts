*Verificar si funciona desde y hasta
let &DiaAnteriorDelProximoHabil Habiles(Dialogo.Fecha1, 1, 'ARG', SI) - 1
let &finDeMesHoy FinDeMes(Dialogo.Fecha1, SI)
IF &DiaAnteriorDelProximoHabil > &finDeMesHoy
    let &fechaDevengadoDesde Dialogo.Fecha1    
    let &fechaDevengadoHasta &finDeMesHoy
   
ELSE 
    IF EsHabil(Dialogo.Fecha1 -1,'ARG') 
        let &fechaDevengadoDesde  Dialogo.Fecha1
    else
        IF Mes(Dialogo.Fecha1) = Mes(Habiles(Dialogo.Fecha1,-1,'ARG'))
            let &fechaDevengadoDesde Dialogo.Fecha1
        ELSE
            let &fechaDevengadoDesde  PriDeMes(Dialogo.Fecha1, SI)
        ENDIF
        
    ENDIF
    let &fechaDevengadoHasta &DiaAnteriorDelProximoHabil
    
ENDIF
*hasta aca 
(.'CONSPRETSA'.)
*Verificar dif dias
let &DifDias DifDia(&fechaDevengadoHasta,&fechaDevengadoDesde) + 1
let &MMCREMMultiplesDias 0
Recorrer SQL
    let &TipoOp  FBN['TipoOp']

