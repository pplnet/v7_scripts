   SQL.ADD("                                EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1,"~DBO~".MOVPENDIENTES MP1 ")
   SQL.ADD("                                      WHERE T.NrTrans  = M.NrTrans2        ")
   SQL.ADD("                                      AND   T1.NrTrans = T.NrOperacionRef2 ")
   SQL.ADD("                                      AND   T1.NrTrans = MP1.NrOperacion   ")
   SQL.ADD("                                      AND   O.Especie  = MP1.Especie       ")
   SQL.ADD("                                      AND   MP1.NrSaldo = 101)             ")
   SQL.ADD("                              ) AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 7 o Dialogo.Cantidad1 = 11 o Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 19
** FJL 08-06-18 - Se incorporan TCOPRi de Cartera Propia
*      SQL.ADD("      O.TipoOp IN ('TIC','TIFC') ")
** FJL 18-07-22 - Excluidr Operaciones Cta y Orden
*      SQL.ADD("      (O.TipoOp IN ('TIC','TIFC') or (O.TipoOp IN ('TCOPRI') and O.Corporate=1)) ")
** FJL 06/09/2022 Las patas de pases solo van a la colomna de 'Pases a liquidar'
*      SQL.ADD("      ((O.TipoOp IN ('TIC','TIFC') and IsNull(CB4,0)=0) or (O.TipoOp IN ('TCOPRI') and O.Corporate=1)) ")
      SQL.ADD("      ((O.TipoOp IN ('TIC','TIFC') and IsNull(CB4,0)=0 and IsNull(O.PaseCB,0)=0) or (O.TipoOp IN ('TCOPRI') and O.Corporate=1)) ")
   ELSE
** FJL 18-07-22 - Excluidr Operaciones Cta y Orden
*      SQL.ADD("      O.TipoOp IN ('TIV','TIFV','TIBCRA') ")
** FJL 06/09/2022 Las patas de pases solo van a la colomna de 'Pases a liquidar'
*      SQL.ADD("      ((O.TipoOp IN ('TIV','TIFV') and IsNull(CB4,0)=0) or O.TipoOp IN ('TIBCRA')) ")
      SQL.ADD("      ((O.TipoOp IN ('TIV','TIFV') and IsNull(CB4,0)=0 and IsNull(O.PaseCB,0)=0) or O.TipoOp IN ('TIBCRA')) ")
   ENDIF

ELSE
*MessageBox('Nuevo')

   SQL.ADD("SELECT O.NrOperacion, O.TipoOp, Abs(MOV.Cantidad) Cantidad, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, ")
   SQL.ADD("       O.FechaOp, O.FechaVto, O.ContraEspecie, O.Cupon1 Cupon, Mercado4 MerNeg, UDN2 ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES MOV ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")

   SQL.ADD("      MOV.NrOperacion=O.NrOperacion and ")
   SQL.ADD("      MOV.NrSaldo=1 and ")
   SQL.ADD("      MOV.Especie=O.Especie and ")

   SQL.ADD("      E.Codigo = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Mercado = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      IsNull(O.Cartera,0) >= 0 AND ") 
   SQL.ADD("      O.Cupon1 = "~Dialogo.String1~" AND ") 
   *SQL.ADD("      E.Cupon  = "~Dialogo.String1~" AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 4
      SQL.ADD("      MOV.FechaMov <= '"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 7 o Dialogo.Cantidad1 = 8
      SQL.ADD("      MOV.FechaMov = '"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 11 o Dialogo.Cantidad1 = 12
      SQL.ADD("      MOV.FechaMov = '"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 16
      SQL.ADD("      MOV.FechaMov = '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 19 o Dialogo.Cantidad1 = 20
      SQL.ADD("      MOV.FechaMov > '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   SQL.ADD("      O.NrOperacion IN (SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie ")
   SQL.ADD("                        UNION ")
   SQL.ADD("                        SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie AND ")
   SQL.ADD("                                EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1,"~DBO~".MOVPENDIENTES MP1 ")
   SQL.ADD("                                      WHERE T.NrTrans  = M.NrTrans2        ")
   SQL.ADD("                                      AND   T1.NrTrans = T.NrOperacionRef2 ")
   SQL.ADD("                                      AND   T1.NrTrans = MP1.NrOperacion   ")
   SQL.ADD("                                      AND   O.Especie  = MP1.Especie       ")
   SQL.ADD("                                      AND   MP1.NrSaldo = 101)             ")
   SQL.ADD("                              ) AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 7 o Dialogo.Cantidad1 = 11 o Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 19
      SQL.ADD("      ((O.TipoOp IN ('TIC','TIFC') and IsNull(CB4,0)=0 and IsNull(O.PaseCB,0)=0) or (O.TipoOp IN ('TCOPRI') and O.Corporate=1)) ")
   ELSE
      SQL.ADD("      ((O.TipoOp IN ('TIV','TIFV') and IsNull(CB4,0)=0 and IsNull(O.PaseCB,0)=0) or O.TipoOp IN ('TIBCRA')) ")
   ENDIF
   
