   SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Cantidad, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, ")
   SQL.ADD("       O.FechaOp, O.FechaVto, O.ContraEspecie, O.Cupon1 Cupon, Mercado4 MerNeg, '' UDN2 ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      O.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      O.Mercado = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      O.Cupon1 = "~Dialogo.String1~" AND ") 
   SQL.ADD("      IsNull(O.Cartera,0) >= 0 AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   *---------------------------
   * Ingresos
   IF Dialogo.Cantidad1=3 
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=7 
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF   
   IF Dialogo.Cantidad1=11 
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=15
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=19
      SQL.ADD("      ((O.FechaOp>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   *---------------------------
   * Egresos
   IF Dialogo.Cantidad1=4 
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=8
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=12
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=16
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=20
      SQL.ADD("      ((O.FechaVto>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   SQL.ADD(" and O.TipoOp IN ('TIDE','TIPO','TICO','TICT')  ")
   ************************
ENDIF
Watch(SQL.Batch())
Recorrer SQL

   ACT(cv1,'')
   ACN(mc1,0)
   ACN(mv1,0)

   IF Incluido(FBN['TipoOp'], 'TIDE|TICT|TIPO|TICO') 
      * Chequeo Por Concertacion 
      * cv1: marca de concertacion o Vto
      ACT(cv1,'V')
      *---------------------------
      * Ingresos
      IF [Dialogo.Cantidad1=3 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT') ] 
         ACT(cv1,'C')
      EndIf
      If [Dialogo.Cantidad1=7 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF   
      IF [Dialogo.Cantidad1=11 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=15 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
          ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=19 y FBN['FechaOp']>HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF
      *---------------------------
      * Egresos
      IF [Dialogo.Cantidad1=4 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=8 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=12 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=16 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=20 y FBN['FechaOp']>HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
   
      If EqStr(val(cv1),'C')
         Message('*- Chequeo si tiene algun movimiento ejecutado a la concertacion '~FBN['NrOperacion'])
         SQL.ADD("SELECT DISTINCT M.NrOperacion ")
         SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M ")
         SQL.ADD(" WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("   AND M.Especie     = '"~Dialogo.Especie1~"' ")
         SQL.ADD("   AND M.FechaMov    = '"~IdxDate(FBN['FechaOp'])~"' ")
         SQL.ADD("   AND EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
         SQL.ADD("                WHERE T.NrTrans=M.NrTrans2 ")
         SQL.ADD("                  and T1.NrTrans=T.NrOperacionRef2 ")
         SQL.ADD("                  AND T1.RB2=1")
         SQL.ADD("              ) ")
         Recorrer SQL
            dfa
            ACN(mc1,1)
         Proximo  
      EndIf

      If EqStr(val(cv1),'V')
         Message('*- Chequeo si tiene algun movimiento ejecutado  al vto '~FBN['NrOperacion'])
         SQL.ADD("SELECT DISTINCT M.NrOperacion ")
         SQL.ADD("  FROM "~DBO~".MOVEJECUTADOS M ")
         SQL.ADD(" WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' ")
         SQL.ADD("   AND M.Especie='"~Dialogo.Especie1~"' ")
         SQL.ADD("   AND M.FechaMov='"~IdxDate(FBN['FechaVto'])~"' ")
         SQL.ADD("   AND EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
         SQL.ADD("                WHERE T.NrTrans=M.NrTrans2 ")
         SQL.ADD("                  and T1.NrTrans=T.NrOperacionRef2 ")
         SQL.ADD("                  AND T1.RB2=1")
         SQL.ADD("              ) ")
         

         Recorrer SQL
            dfa
            ACN(mv1,1)
         Proximo      
      EndIf

      Message(FBN['NrOperacion']~' mc1 '~val(mc1)~' mv1 '~val(mv1))

      ACT(k:FAC, Val(cv1))
      ACN(l:FAC, Val(mv1))
      ACN(m:FAC, Val(cv1))

      If [EqStr(val(cv1),'V') y val(mv1)=0] o [EqStr(val(cv1),'C') y val(mc1)=0]
         * Indice para pasar un monto de una moneda a otra
         ACN(in1, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mn1)))

         ACT(a:fac, fbn('NrOperacion'))
         ACLO(a:fac, fbn('NrOperacion'))
  
         ACT(b:fac, fbn('TipoOp'))
         if EqStr(Val(cv1),'V')
           ACT(b:fac, Val(b:fac)~' (Vto)')
         endif
         ACD(c:fac, fbn('FechaOp'))
         ACD(d:fac, fbn('FechaVto'))   
         ACN(e:fac, fbn('Cantidad'))
         ** FJL 06/07/22 - Issue 5693 -Mostrar 0 en columna 7983
*         ACN(f:fac, fbn('TotalBrutoCli1'))
         ACN(f:fac, 0)
         ACN(g:fac, fbn('TotalDerechos'))
         ACN(h:fac, fbn('TotalNetoCli1'))
** FJL 06/09/22 - Isssue 5741
         ACT(i:fac, fbn('MerNeg'))

         SetFont(a:fac.. i:fac, 2)
         FormatoCeldas(e:fac..i:fac, Exe('F2'))
      Else 
         dfa
      EndIf
  Else 
     ************************************
     ** No es de Call/Prestamo de Titulos
     ************************************
     * Indice para pasar un monto de una moneda a otra
     ACN(in1, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mn1)))

     If Incluido(fbn('TipoOp'), 'DTP|RTP|DRT')
     
        ACT(a:fac, fbn('NrOperacion'))
        ACLT(a:fac, fbn('NrOperacion')) 
     Else
        ACT(a:fac, fbn('NrOperacion'))
        ACLO(a:fac, fbn('NrOperacion'))
     Endif
     ACT(b:fac, fbn('TipoOp'))
     ACD(c:fac, fbn('FechaOp'))
     ACD(d:fac, fbn('FechaVto'))   
     ACN(e:fac, fbn('Cantidad'))
     ACN(f:fac, fbn('TotalBrutoCli1'))
     If Incluido(fbn('TipoOp'), 'TIC|TCOPRI|TIV|CTP|VTP|TIBCRA|TIFC|TIFV')
        ACN(g:fac, fbn('TotalIntereses'))
     Else
        ACN(g:fac, fbn('TotalDerechos'))
     Endif
     ACN(h:fac, fbn('TotalNetoCli1'))
** FJL 25/08/22 - Isssue 5741
     ACT(i:fac, fbn('MerNeg'))
     if EqStr(fbn('MerNeg'),'BYMA')
       ACT(i:fac, Val(i:fac)~' - '~fbn('UDN2'))
     endif
     SetFont(a:fac.. i:fac, 2)
     FormatoCeldas(e:fac..h:fac, Exe('F2'))
  EndIf
Proximo
ifa
ifa

*- Sumatoria de la Valuacion y de la Cantidad
act(a:fac, 'Total ... ')
acn(e:fac, Sum(e:5..e:fac-1) )
