*-Compra y Venta de Fondos
HOJAVISIBLE(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1     :  "Fecha Desde"                ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, SI);
  Fecha2     :  "Fecha Hasta"                ;1;2;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Especie1   :  "Moneda Oper."               ;3;1;;;;NoVacio(Dialogo.Especie1);'Moneda Oper. invalida';NO;Var('MONEEXTR');;LeerObjeto('Monedas');
  Especie2   :  "Especie"                    ;;;;;;;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~") and Status = 'HAB'";;
  Radio2     :  "Expresado|ARP  |USD      "  ;5;1;;;;;;;0
  Vehiculo1  :  "Grupo"                      ;7;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'"; 
  Lista1     :  "Vehiculo"                   ;3;2;;Vacio(Dialogo.Vehiculo1);;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ") );
  Radio3     :  "Consolidado|SI|NO"          ;;1;;;;;;;1;;;;  
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACN(fi1,0)

ACT(h:2,'Fecha : '~Var('FECHASYS')~'    Hora: '~HORA(AHORA) )
SetFont(h:2..h:2,1)

SetFilaActual(3)
ACT(a:FAC,'Compra y Venta de Fondos')
SetFont(a:fac..a:fac,3)
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ifa
ifa
ACT(a:FAC, 'Expresado en '~Val(mo1))
ifa
if NoVacio(Dialogo.Lista1)
  ACT(a:FAC, 'Vehiculo : '~Dialogo.Lista1)
else
  If NoVacio(Dialogo.Vehiculo1)
    ACT(a:FAC, 'Grupo : '~Dialogo.Vehiculo1)
  Else 
    ACT(a:FAC, 'Vehiculo : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
  EndIF
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+1, 'Moneda Operada : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+1, 'Moneda Operada : Todas')
endif

if NoVacio(Dialogo.Especie2)
  ACT(a:FAC+1, 'Especie Operada : '~Dialogo.Especie2~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie2))
else
  ACT(a:FAC+1, 'Especie Operada : Todas')
endif


ACT(a:FAC+2, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(d:FAC+2, 'Ope.Hasta : '~Dialogo.Fecha2)

If Dialogo.Radio3 = 0
  ACT(a:FAC+3, 'Consolidado : Si')
Else
  ACT(a:FAC+3, 'Consolidado : No')
EndIf

SetFont(a:fac-1..d:fac+3,2)

SetFilaActual(11)

ACN(z11, FAC+2)
ACT(a:FAC,'Fondo')
ACT(b:FAC,'Tipo Op.')
ACT(c:FAC,'Numero Op')
ACT(d:FAC,'Moneda')
ACT(g:FAC,'Compra')
ACT(k:FAC,'Venta')
*ACT(m:FAC,'Resultado')
ACT(M:fac, 'Saldo')
AlinearCeldas(a:FAC..d:FAC,'C')
AlinearCeldas(e:FAC..l:FAC,'I')
AlinearCeldas(m:FAC..m:FAC,'C')
SetFont(a:fac..m:FAC,2)
AgregarMarco(a:FAC..m:FAC+1,2,0,Exe('COLOR'))
***---AgregarMarco(a:FAC..l:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(a:FAC..d:FAC+1,2,2,Exe('COLOR'))
AgregarMarco(e:FAC..h:FAC,2,0,Exe('COLOR'))
AgregarMarco(i:FAC..l:FAC,2,0,Exe('COLOR'))
AgregarMarco(e:FAC+1..l:FAC+1,2,2,Exe('COLOR'))
ifa

ACT(f:FAC,'Valor Nominal')
ACT(e:FAC,'Fecha')
ACT(g:FAC,'Precio')
ACT(h:FAC,'Importe')
ACT(j:FAC,'Valor Nominal')
ACT(i:FAC,'Fecha')
ACT(k:FAC,'Precio')
ACT(l:FAC,'Importe')
AlinearCeldas(e:FAC..l:FAC,'C')
SetFont(a:fac..m:FAC,2)

ACT(en1,Dialogo.Especie1)

*- Corte por t1:Vehiculo, t2:Fondo, t3:Moneda
act(t1,'')
act(t2,'')
act(t3,'')
BorrarCeldas(w11..w15)
BorrarCeldas(w21..w25)
BorrarCeldas(w31..w35)
BorrarCeldas(w91..w95)
acd(da1,0)
acn(re1,0)

SetFilaActual(12)

IF Dialogo.Radio2 = 0
    ACT(MN:1, Var('MONELOCA'))
ELSE
    ACT(MN:1, Var('MONEEXTR'))
ENDIF

ACN(TT:1, 0)

** SELECCIONO LAS OPERACIONES DE FONDOS
If Dialogo.Radio3 = 1
  SQL.ADD(" Select O.Vehiculo1, O.Especie, O.ContraEspecie, O.FechaVto AS FechaOp, ")
  SQL.ADD(" O.TipoOp, O.NrOperacion,O.MB3, O.Cantidad, O.Precio1 , O.TotalBrutoCli1, ")
  SQL.ADD(" O.TotalNetoCli1, 0 BD1 ")
Else
  SQL.ADD(" Select 'Consolidado' Vehiculo1, O.Especie, O.ContraEspecie, O.FechaVto AS FechaOp, ")
  SQL.ADD(" O.TipoOp, O.NrOperacion,O.MB3, O.Cantidad, O.Precio1, O.TotalBrutoCli1, O.TotalNetoCli1, 0 BD1 ")
EndIf
SQL.ADD(" FROM "~DBO~".OPERACIONES O  ")
SQL.ADD(" WHERE TipoOp in ('FCS','FCR','SEPVMV','SEPTMV','FCCPV','FCVPV') ")
SQL.ADD(" and ((FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' AND TipoOp Not IN ('SEPTMV','SEPVMV')) ")
SQL.ADD("      OR (FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' AND TipoOp IN ('SEPTMV','SEPVMV'))) ")
IF NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  EndIf
ENDIF
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.ContraEspecie = '"~val(en1)~"' ")
endif
if NoVacio(Dialogo.Especie2)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie2~"' ")
endif

SQL.ADD(" UNION ")

***/// Levanto DIVIDENDOS
If Dialogo.Radio3 = 1
  SQL.ADD(" Select O.Vehiculo1, O.Especie, O.ContraEspecie, O.FechaPago AS FechaOp, ")
  SQL.ADD(" O.TipoOp, O.NrOperacion,O.MB3, O.TotalBrutoCli1 AS Cantidad, O.Spread AS Precio1, O.TotalBrutoCli1, ")
  SQL.ADD(" O.TotalNetoCli1, 0 BD1 ")
Else
  SQL.ADD(" Select 'Consolidado' Vehiculo1, O.Especie, O.ContraEspecie, O.FechaPago AS FechaOp, ")
  SQL.ADD(" O.TipoOp, O.NrOperacion,O.MB3, O.TotalBrutoCli1 AS Cantidad, O.Spread AS Precio1, O.TotalBrutoCli1, O.TotalNetoCli1, 0 BD1 ")
EndIf
SQL.ADD(" FROM "~DBO~".OPERACIONES O  ")
SQL.ADD(" WHERE TipoOp in ('DIVIDE') ")
SQL.ADD(" and FechaPago between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  EndIf
ENDIF
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.ContraEspecie = '"~val(en1)~"' ")
endif
if NoVacio(Dialogo.Especie2)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie2~"' ")
endif

SQL.ADD(" AND CB7=1 AND MB4=1 AND TipoCambio3=101 ")

SQL.ADD(" UNION ")

***---Vto de los Prestamos
If Dialogo.Radio3 = 1
  SQL.ADD(" Select O.Vehiculo1, O.Especie, O.ContraEspecie, C.Fecha2 FechaOp, O.TipoOp, O.NrOperacion,O.MB3, O.Cantidad, O.Precio1, O.TotalBrutoCli1, ")
  SQL.ADD(" O.TotalNetoCli1, 1 BD1 ")
Else
  SQL.ADD(" Select 'Consolidado' Vehiculo1, O.Especie, O.ContraEspecie, C.Fecha2 FechaOp, O.TipoOp, O.NrOperacion,O.MB3, O.Cantidad, O.Precio1, ")
  SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, 1 BD1 ")
EndIf
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C  ")
SQL.ADD(" WHERE TipoOp in ('SEPVMV','SEPTMV') ")
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Fecha2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' AND TipoOp IN ('SEPTMV','SEPVMV') ")
IF NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  EndIf
ENDIF
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.ContraEspecie = '"~val(en1)~"' ")
endif
if NoVacio(Dialogo.Especie2)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie2~"' ")
endif

***// QUERY para traer saldos anteriores

SQL.ADD(" UNION ")

If Dialogo.Radio3 = 1
  SQL.ADD(" Select distinct S.Cliente Vehiculo1, ")
Else
  SQL.ADD(" Select distinct 'Consolidado' Vehiculo1, ")
Endif
SQL.ADD(" S.Especie, E.Cotiza ContraEspecie , null FechaOp, null TipoOp, null NrOperacion, null MB3, null Cantidad, null Precio1, null TotalBrutoCli1, null TotalNetoCli1, 2 BD1 ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE S.Fecha < '"~IdxDate(Dialogo.Fecha1)~"'  AND S.NrSaldo = 1 ")
SQL.ADD(" and (S.CallPut IS NULL OR S.CallPut = ' ' OR S.CallPut = 'CON')  ")
SQL.ADD(" and (S.PrecioEj IS NULL OR S.PrecioEj = 0)  and S.FechaEj IS NULL  ")
SQL.ADD(" and S.Cliente = S.EnteCustodia ")
SQL.ADD(" and ROUND(S.Saldo,0) <> 0 ")
SQL.ADD(" and S.Fecha in (select Max(R.Fecha) from "~DBO~".SALDOSDIA R  ")
SQL.ADD(" where R.Fecha < '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and R.NrSaldo = 1 and R.NrSaldo = S.NrSaldo  ")
SQL.ADD(" and R.Cliente = S.Cliente and R.Especie = S.Especie  ")
SQL.ADD(" and ((R.Mercado Is Null and S.Mercado Is null) or R.Mercado=S.Mercado)  ")
SQL.ADD(" and ((R.EnteCustodia Is Null and S.EnteCustodia Is null) or R.EnteCustodia=S.EnteCustodia)  ")
SQL.ADD(" and ((R.Cuenta Is Null and S.Cuenta Is null) or R.Cuenta=S.Cuenta)  ")
SQL.ADD(" and ((R.Cupon Is Null and S.Cupon Is null) or R.Cupon=S.Cupon)  ")
SQL.ADD(" and ((R.Book Is Null and S.Book Is null) or R.Book=S.Book)  ")
SQL.ADD(" and ((R.Vehiculo Is Null and S.Vehiculo Is null) or R.Vehiculo=S.Vehiculo)  ")
SQL.ADD(" and ((R.CallPut Is Null and S.CallPut Is null) or R.CallPut=S.CallPut)  ")
SQL.ADD(" and ((R.FechaEj Is Null and S.FechaEj Is null) or R.FechaEj=S.FechaEj) ) ")

SQL.ADD(" and S.Especie = E.Codigo ")
SQL.ADD(" and E.Tipo = 'FON' ")
IF NoVacio(Dialogo.Lista1) 
  SQL.ADD(" AND S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and S.Cliente in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~") ")
  EndIf
ENDIF
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and E.Cotiza = '"~val(en1)~"' ")
endif
if NoVacio(Dialogo.Especie2)
   SQL.ADD(" and E.Codigo = '"~Dialogo.Especie2~"' ")
endif

SQL.ADD(" Order By Vehiculo1,Especie,ContraEspecie,FechaOp,TipoOp ")
watch(sql.batch)
Recorrer SQL
   if Eqstr(Val(t1),'') y eqstr(Val(t2),'') y eqstr(Val(t3),'')
      act(t1, fbn('Vehiculo1'))
      act(t2, fbn('Especie'))
      act(t3, fbn('ContraEspecie'))
      acd(da1, fbn('FechaOp'))
      act(a:fac,fbn('Vehiculo1'))
      AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR6'))
      SetFont(a:fac..m:fac,2)
      ifa
      ACT(DS:1, BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
      ***---ACN(SD:1, Saldo(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),1,Dialogo.Fecha1-1))
      If Dialogo.Radio3 = 0
         (.'FONDCVSAL'.)
      Else
         ACN(SD:1, SaldoD2(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),,1,Dialogo.Fecha1-1))
      Endif
      ***---Obtengo Posicion
      ACT(ES:105, fbn('Especie'))
      ACT(CL:105, fbn('Vehiculo1'))
      ACT(VH:105, fbn('Vehiculo1'))
      ACN(SL:105, 101)
      ACT(NG:105, 'FC')
      ***---(.'POSICIONES'.)
      ***---ACN(SD:1, Val(CF:105))
      ACT(A:fac, 'Saldo Inicial '~fbn('Especie')~' '~Val(DS:1)~': '~Fstr(Val(SD:1), 0, 2))
      ACN(M:FAC, Val(SD:1))
      SetFont(m:FAC..m:FAC,1)
      SetFont(A:fac, 2)
      AgregarMarco(A:fac..M:fac, 0, 0)
      ifa
   ELSE
      *-- Preparo corte de control
      if Not Eqstr(fbn('Vehiculo1'),Val(t1)) y NoVacio(Val(t1))
         *-- Agrego Subtotal por dia para listar Resultado generado
         *act(j:fac,'Resultado Generado al '~Val(da1))
         *acn(m:fac, Val(re1))
         *AgregarMarco(j:fac..m:fac,1,0)
         *ifa
         ACN(M:fac-1, Val(TT:1) + Val(SD:1))
         SetFont(M:fac-1, 1)
         ACN(TT:1, 0)
         act(a:fac,'Total Esp. '~Val(t3) )
         ACN(CT:1, Cotizacion(Val(T:2),,,,Dialogo.Fecha2,1,SI))
         ACT(B:fac,'Cotizacion '~Val(T:2)~' : '~Val(CT:1))
         ACN(M:fac, Val(M:fac-1) * Val(CT:1))
         acn(f:fac, Val(w31))
         acn(h:fac, Val(w32))
         acn(j:fac, Val(w33))
         acn(l:fac, Val(w34))
         *acn(m:fac, Val(w35))
         BorrarCeldas(w31..w35)
         AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..m:fac,2)
         ifa
         act(a:fac,'Total Fondo '~Val(t2)~' en '~Val(mo1))
         act(b:fac,'      Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(f:fac, Val(w21))
         acn(h:fac, Val(w22))
         acn(j:fac, Val(w23))
         acn(l:fac, Val(w24))
         *acn(m:fac, Val(w25))
         ACN(CT:2, CotizacionC(Val(T:2),,,,Dialogo.Fecha2,1,SI, Val(MN:1)))
         ACN(M:fac, Val(M:fac-2) * Val(CT:2))
         SCN(TM:1, Val(M:fac))
         BorrarCeldas(w21..w25)
         AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..m:fac,2)
         ifa
         act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
         ***---acn(f:fac, Val(w11))
         acn(h:fac, Val(w12))
         ***---acn(j:fac, Val(w13))
         acn(l:fac, Val(w14))
         *acn(m:fac, Val(w15))
         ACN(M:fac, Val(TM:1))
         SCN(TM:2, Val(M:fac))
         ACN(TM:1, 0)
         SCN(w91, Val(w11))
         SCN(w92, Val(w12))
         SCN(w93, Val(w13))
         SCN(w94, Val(w14))
         SCN(w95, Val(w15))
         BorrarCeldas(w11..w15)
         AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR6'))
         SetFont(a:fac..m:fac,2)
         ifa
         act(t1, fbn('Vehiculo1'))
         act(t2, fbn('Especie'))
         act(t3, fbn('ContraEspecie'))
         acd(da1, fbn('FechaOp'))
         ifa
         act(a:fac,fbn('Vehiculo1'))
         AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR6'))
         SetFont(a:fac..m:fac,2)
         ifa
         ACT(DS:1, BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
         If Dialogo.Radio3 = 0
            (.'FONDCVSAL'.)
         Else
            ACN(SD:1, SaldoD2(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),,1,Dialogo.Fecha1-1))
         Endif
         ***---Obtengo Posicion
         ACT(ES:105, fbn('Especie'))
         ACT(CL:105, fbn('Vehiculo1'))
         ACT(VH:105, fbn('Vehiculo1'))
         ACN(SL:105, 101)
         ACT(NG:105, 'FC')
         (.'POSICIONES'.)
         *ACN(SD:1, Val(CF:105))
         ACT(A:fac, 'Saldo Inicial '~fbn('Especie')~' '~Val(DS:1)~': '~Fstr(Val(SD:1), 0, 2))
         ACN(M:FAC, Val(SD:1))
         SetFont(m:FAC..m:FAC,1)
         SetFont(A:fac, 2)
         AgregarMarco(A:fac..M:fac, 0, 0)
         ifa
      Else 
         If [Not Eqstr(fbn['Especie'],Val(t2))] y NoVacio(Val(t2))
            * Cambia El Tipo de Operacion
            *-- Agrego Subtotal por dia para listar Resultado generado
            *act(j:fac,'Resultado Generado al '~Val(da1))
            *acn(m:fac, Val(re1))
            *AgregarMarco(j:fac..l:fac,2,0)
            SetFont(a:FAC..M:FAC,2)
            *ifa
            ACN(M:fac-1, Val(TT:1) + Val(SD:1))
            SetFont(M:fac-1, 1)
            ACN(TT:1, 0)
            act(a:fac,'Total Esp. '~Val(t3) )
            ACN(CT:1, Cotizacion(Val(T:2),,,,Dialogo.Fecha2,1,SI))
            ACT(B:fac,'Cotizacion '~Val(T:2)~' : '~Val(CT:1))
            ACN(M:fac, Val(M:fac-1) * Val(CT:1))
            acn(f:fac, Val(w31))
            acn(h:fac, Val(w32))
            acn(j:fac, Val(w33))
            acn(l:fac, Val(w34))
            *acn(m:fac, Val(w35))
            BorrarCeldas(w31..w35)
            AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
            SetFont(a:fac..m:fac,2)
            ifa
            act(a:fac,'Total Fondo '~Val(t2)~' en '~Val(mo1))
            act(b:fac,'      Cotizacion en '~Val(mo1)~' : '~Val(az2))
            acn(f:fac, Val(w21))
            acn(h:fac, Val(w22))
            acn(j:fac, Val(w23))
            acn(l:fac, Val(w24))
            *acn(m:fac, Val(w25))
            ACN(CT:2, CotizacionC(Val(T:2),,,,Dialogo.Fecha2,1,SI, Val(MN:1)))
            ACN(M:fac, Val(M:fac-2) * Val(CT:2))
            SCN(TM:1, Val(M:fac))
            BorrarCeldas(w21..w25)
            AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
            SetFont(a:fac..m:fac,2)
            ifa
            * Asignar Tipo Operacion
            act(t1, fbn('Vehiculo1'))
            act(t2, fbn('Especie'))
            act(t3, fbn('ContraEspecie'))
            acd(da1, fbn('FechaOp'))
            ifa
            ACT(DS:1, BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
            ***---ACN(SD:1, Saldo(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),1,Dialogo.Fecha1-1))
            If Dialogo.Radio3 = 0
               (.'FONDCVSAL'.)
            Else
               ACN(SD:1, SaldoD2(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),,1,Dialogo.Fecha1-1))
            Endif
            ***---Obtengo Posicion
            ACT(ES:105, fbn('Especie'))
            ACT(CL:105, fbn('Vehiculo1'))
            ACT(VH:105, fbn('Vehiculo1'))
            ACN(SL:105, 101)
            ACT(NG:105, 'FC')
            (.'POSICIONES'.)
            ***---ACN(SD:1, Val(CF:105))
            ACT(A:fac, 'Saldo Inicial '~fbn('Especie')~' '~Val(DS:1)~': '~Fstr(Val(SD:1), 0, 2))
            ACN(M:FAC, Val(SD:1))
            SetFont(m:FAC..m:FAC,1)
            SetFont(A:fac, 2)
            AgregarMarco(A:fac..M:fac, 0, 0)
            ifa
         Else
            If [Not Eqstr(fbn['ContraEspecie'],Val(t3))] y NoVacio(Val(t3))
               *-- Cambia el Especie(Moneda)
               *-- Agrego Subtotal por dia para listar Resultado generado
               *act(j:fac,'Resultado Generado al '~Val(da1))
               *acn(m:fac, Val(re1))
               *AgregarMarco(j:fac..m:fac,2,0)
               *SetFont(a:FAC..m:FAC,2)
               *AgregarMarco(j:fac..l:fac,2,0)
               SetFont(a:FAC..M:FAC,2)
               *ifa
               ACN(M:fac-1, Val(TT:1) + Val(SD:1))
               SetFont(M:fac-1, 1)
               ACN(TT:1, 0)
               act(a:fac,'Total Esp. '~Val(t3) )
               ACN(CT:1, Cotizacion(Val(T:2),,,,Dialogo.Fecha2,1,SI))
               ACT(B:fac,'Cotizacion '~Val(T:2)~' : '~Val(CT:1))
               ACN(M:fac, Val(M:fac-1) * Val(CT:1))
               ***---acn(f:fac, Val(w31))
               acn(h:fac, Val(w32))
               ***---acn(j:fac, Val(w33))
               acn(l:fac, Val(w34))
               *acn(m:fac, Val(w35))
               BorrarCeldas(w31..w35)
               AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
               SetFont(a:fac..m:fac,2)
               ifa
               * Asignar Especie
               act(b:fac,'      Cotizacion en '~Val(mo1)~' : '~Val(az2))
               act(t1, fbn('Vehiculo1'))
               act(t2, fbn('Especie'))
               act(t3, fbn('ContraEspecie'))
               acd(da1, fbn('FechaOp'))
               ACT(DS:1, BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
               ***---ACN(SD:1, Saldo(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),1,Dialogo.Fecha1-1))
               If Dialogo.Radio3 = 0
                  (.'FONDCVSAL'.)
               Else
                  ACN(SD:1, SaldoD2(fbn('Vehiculo1'), fbn('Especie'),,,,,fbn('Vehiculo1'),,1,Dialogo.Fecha1-1))
               Endif
               ***---Obtengo Posicion
               ACT(ES:105, fbn('Especie'))
               ACT(CL:105, fbn('Vehiculo1'))
               ACT(VH:105, fbn('Vehiculo1'))
               ACN(SL:105, 101)
               ACT(NG:105, 'FC')
               (.'POSICIONES'.)
               ***---ACN(SD:1, Val(CF:105))
               ACT(A:fac, 'Saldo Inicial '~fbn('Especie')~' '~Val(DS:1)~': '~Fstr(Val(SD:1), 0, 2))
               ACN(M:FAC, Val(SD:1))
               SetFont(m:FAC..m:FAC,1)
               SetFont(A:fac, 2)
               AgregarMarco(A:fac..M:fac, 0, 0)
               ifa
            ELSE
               IF fbn('FechaOp') <> Val(FE:1)
                  ACT(M:fac-1, 'y')
                  ACN(M:fac-1, Val(SD:1) + Val(TT:1))
                  SetFont(M:fac-1, 1)
               ENDIF
            EndIf
         EndIf
      Endif
   Endif
   *-- Verifico si hay corte por dia
   if fbn('FechaOp') <> Val(da1) 
       *-- Agrego Subtotal por dia para listar Resultado generado
       *act(j:fac,'Resultado Generado al '~Val(da1))
       *acn(m:fac, Val(re1))
       *AgregarMarco(j:fac..m:fac,2,0)
       *SetFont(a:FAC..m:FAC,2)
       *AgregarMarco(j:fac..l:fac,2,0)
       SetFont(a:FAC..M:FAC,2)
       acd(da1, fbn('FechaOp'))
       *ifa
    endif

    ***// Si la fila anterior era por saldos anteriores, la piso
    If Val(zz:fac-1)=1
       DFA
       ACN(zz:fac, 0)
    Endif

If fbn('BD1') <> 2
    ***---ACT(a:fac,FBN['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
    ACT(a:fac,FBN['Especie']~'  '~Val(DS:1))
    ACT(c:fac,FBN['NrOperacion'])
    ACLO(c:fac,FBN['NrOperacion'])
    ACT(d:fac,FBN['ContraEspecie']) 
    ***---ACN(az1,CotizacionC(fbn['ContraEspecie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
    ACN(az1,CotizacionC(fbn['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
    If [Eqstr(fbn['ContraEspecie'],Var('MONELOCA'))] y Dialogo.Radio2=1
       ACT(az2,PYC(1/val(az1),0,8)~' (INV) ')
    ELSE
       ACT(az2,PYC(Val(az1),0,8))
    ENDIF

    If [Incluido(FBN['TipoOp'],'FCS|FCCPV')] O [Incluido(Fbn('TipoOp'), 'SEPTMV|SEPVMV|DIVIDE') Y [[fbn('MB3')=0 Y fbn('BD1')=0] O [fbn('MB3')=1 Y fbn('BD1')=1]]]
      IF Eqstr(fbn('TipoOp'), 'FCS')
          ACT(b:fac, fbn('TipoOp')~' - Compra')
      ELSE
          IF Eqstr(fbn('TipoOp'), 'FCCPV')
              ACT(b:fac, fbn('TipoOp')~' - Compra Sint. x Prest.')
          ELSE
              IF Incluido(Fbn('TipoOp'), 'SEPTMV|SEPVMV')
                  IF fbn('BD1') = 0
                     ACT(b:fac, fbn('TipoOp')~' - Alta Toma x Prest.')
                  ELSE
                     ACT(b:fac, fbn('TipoOp')~' - Vto Colocacion x Prest.')
                  ENDIF
               ELSE
                  ACT(b:fac, fbn('TipoOp')~' - Cobro de dividendos')
               ENDIF
          ENDIF
      ENDIF
      ACT(e:fac,FBN['FechaOp'])
      ACN(f:fac,FBN['Cantidad'])
      If Eqstr(FBN('TipoOp'),'DIVIDE')
          ACN(g:fac, Cotizacion(FBN('Especie'),,,,FBN('FechaOp'),1,SI))
      ELSE
          ACN(g:fac,FBN['Precio1'])
      ENDIF
      IF Incluido(Fbn('TipoOp'), 'SEPTMV|SEPVMV')
          ACN(h:fac,FBN['TotalBrutoCli1'])
      ELSE
          If Eqstr(FBN('TipoOp'),'DIVIDE')          
             ACN(h:fac, Val(f:fac)*Val(g:fac))
          ELSE
             ACN(h:fac,FBN['TotalNetoCli1'])
          ENDIF
      ENDIF
      SCN(TT:1, fbn('Cantidad'))
    ELSE
       IF Eqstr(fbn('TipoOp'), 'FCR')
          ACT(b:fac, fbn('TipoOp')~' - Venta')
       ELSE
          IF Eqstr(fbn('TipoOp'), 'FCVPV')
             ACT(b:fac, fbn('TipoOp')~' - Venta Sint. x Prest.')
          ELSE
             IF Incluido(Fbn('TipoOp'), 'SEPTMV|SEPVMV')
                IF fbn('BD1') = 0
                   ACT(b:fac, fbn('TipoOp')~' - Alta Colocacion x Prest.')
                ELSE
                   ACT(b:fac, fbn('TipoOp')~' - Vto Alta x Prest.')
                ENDIF
             ELSE
                If fbn('BD1') = 2
                   ACT(b:fac, 'Saldo Anterior')
                   ACN(zz:fac, 1)
                Else
                   ACT(b:fac, fbn('TipoOp')~' - Pago de dividendos')
                Endif
             ENDIF
          ENDIF
       ENDIF
       
       ACN(j:fac,FBN['Cantidad'])
       ACT(i:fac,FBN['FechaOp'])
       If Eqstr(FBN('TipoOp'),'DIVIDE')
          ACN(k:fac, Cotizacion(FBN('Especie'),,,,FBN('FechaOp'),1,SI))
       ELSE
          ACN(k:fac,FBN['Precio1'])
       ENDIF
       IF Incluido(Fbn('TipoOp'), 'SEPTMV|SEPVMV')
          ACN(l:fac,FBN['TotalBrutoCli1'])
       ELSE
          If Eqstr(FBN('TipoOp'),'DIVIDE')          
             ACN(l:fac, Val(j:fac)*Val(k:fac))
          ELSE
             ACN(l:fac,FBN['TotalNetoCli1'])
          ENDIF
       ENDIF
       SCN(TT:1, -fbn('Cantidad'))
    ENDIF
    SetFont(a:FAC..m:FAC,1)
ELSE
   DFA
   SetFont(m:FAC..m:FAC,1)
ENDIF
    *--ACN(m:fac, Val(l:fac)-Val(h:fac))

    *- Funcion para recuperar el resultado, recupera en re:1
    ACT(ea:2,FBN['Especie'])
    ACT(va:2,FBN['Vehiculo1'])
    ACD(fa:2,FBN['FechaOp'])
    ACT(tn:2,'FC')

    ***---(.'RESULTADO'.)

    SCN(w11,val(f:fac)*Val(az1))
    SCN(w21,val(f:fac)*Val(az1))
    SCN(w31,val(f:fac))
    SCN(w12,val(h:fac)*Val(az1))
    SCN(w22,val(h:fac)*Val(az1))
    SCN(w32,val(h:fac))
    SCN(w13,val(j:fac)*Val(az1))
    SCN(w23,val(j:fac)*Val(az1))
    SCN(w33,val(j:fac))
    SCN(w14,val(l:fac)*Val(az1))
    SCN(w24,val(l:fac)*Val(az1))
    SCN(w34,val(l:fac))
    *SCN(w15,val(m:fac)*Val(az1))
    *SCN(w25,val(m:fac)*Val(az1))
    *SCN(w35,val(m:fac))
    SCN(fi1,1)
    ACD(FE:1, fbn('FechaOp'))
Proximo


*-- Veo si hay algo para listar
if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
ELSE
   *-- Listo ultimo total
   ifa
   *-- Agrego Subtotal por dia para listar Resultado generado
   *act(j:fac,'Resultado Generado al '~Val(da1))
   *acn(m:fac, Val(re1))
   *AgregarMarco(j:fac..m:fac,2,0)
   *SetFont(a:FAC..m:FAC,2)
   *AgregarMarco(j:fac..l:fac,2,0)
   SetFont(a:FAC..M:FAC,2)
   *ifa
   ACN(M:fac-1, Val(TT:1) + Val(SD:1))
   SetFont(M:fac-1, 1)
   ACN(TT:1, 0)
   act(a:fac,'Total Esp. '~Val(t3) )
   ACN(CT:1, Cotizacion(Val(T:2),,,,Dialogo.Fecha2,1,SI))
   ACT(B:fac,'Cotizacion '~Val(T:2)~' : '~Val(CT:1))
   ACN(M:fac, Val(M:fac-1) * Val(CT:1))
   acn(f:fac, Val(w31))
   acn(h:fac, Val(w32))
   acn(j:fac, Val(w33))
   acn(l:fac, Val(w34))
   *acn(m:fac, Val(w35))
   BorrarCeldas(w31..w35)
   AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..m:fac,2)
   ifa
   act(a:fac,'Total Fondo '~Val(t2)~' en '~Val(mo1))
   act(b:fac,'      Cotizacion en '~Val(mo1)~' : '~Val(az2))
   acn(f:fac, Val(w21))
   acn(h:fac, Val(w22))
   acn(j:fac, Val(w23))
   acn(l:fac, Val(w24))
   *acn(m:fac, Val(w25))
   ACN(CT:2, CotizacionC(Val(T:2),,,,Dialogo.Fecha2,1,SI, Val(MN:1)))
   ACN(M:fac, Val(M:fac-2) * Val(CT:2))
   SCN(TM:1, Val(M:fac))
   BorrarCeldas(w21..w25)
   AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..m:fac,2)
   ifa
   act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
   ***---acn(f:fac, Val(w11))
   acn(h:fac, Val(w12))
   ***---acn(j:fac, Val(w13))
   acn(l:fac, Val(w14))
   ACN(M:fac, Val(TM:1))
   SCN(TM:2, Val(M:fac))
   ACN(TM:1, 0)
   SCN(w91, Val(w11))
   SCN(w92, Val(w12))
   SCN(w93, Val(w13))
   SCN(w94, Val(w14))
   SCN(w95, Val(w15))
   BorrarCeldas(w11..w15)
   AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR6'))
   SetFont(a:fac..m:fac,2)
   ifa
   ifa
   act(a:fac,'Total General en '~Val(mo1) )
   ***---acn(f:fac, Val(w91))
   acn(h:fac, Val(w92))
   ***---acn(j:fac, Val(w93))
   acn(l:fac, Val(w94))
   ACN(M:fac, Val(TM:2))
   AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..m:fac,3)
   FormatoCeldas(e:12..m:fac,Exe('F6'))

   ACO(1,15)
   ACO(2,18)
   ACO(3,8)
   ACO(4,5)
   ACO(5,6)
   ACO(6,12)
   ACO(7,8)
   ACO(8,12)
   ACO(9,6)
   ACO(10,12)
   ACO(11,8)
   ACO(12,12)

   Impresion(1,2)
   SetPrintFit(3, 75)
   SetFilaActual(FAC+2)
   ACT(a:FAC, 'Fin del Informe')
   SetFont(a:FAC, 2)
   LimitesVision(m:FAC)
   RangoTitulo(a:1..m:FAC, 10)

Endif