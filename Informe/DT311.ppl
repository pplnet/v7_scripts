MostrarCuadroDeMensajes

ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
 Fecha1 : 'D.FechaAcr';1;1;;;;;;;fsys
 Fecha2 : 'H.FechaAcr';1;2;;;;;;;fsys
 Especie1: 'Moneda'   ;2;1;;;;;;;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
 Radio3 : 'Estado Aprobacion|Pendientes|OK|Todos'         ;3;1;;;;;;;2
 Radio2 : 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;4;1;;;;;;;4
 Check1:  'Incluye Pagadoras';5;1;;;;;;;1
 Lista2:   'Vehiculos'; 6;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista3:   'Bancos'   ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
 Lista1:   'Cuentas'  ; 1;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista3)~") "~IIF(NOVACIO(Dialogo.Lista2)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
 Radio1 : 'INF|ING|ING/EGR|GAST';1;1;1;NO;NO;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial, 8,BI")
If Dialogo.Radio1=0
  ACT(a:1, 'Ingresos por Moneda y por Banco - Datanet')
Endif
If Dialogo.Radio1=1
  ACT(a:1, 'Ingresos y Egresos por Moneda y por Banco - Datanet')
Endif
If Dialogo.Radio1=2
  ACT(a:1, 'Gastos por Moneda y por Banco - Datanet')
Endif
ACT(a:3, 'Desde: '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
ACT(a:4, 'Moneda: '~IIF(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(a:5, 'Bancos:   '~iif(vacio(Dialogo.Lista3),'Todos',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:6, 'Cuentas:   '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:7, 'Vehiculos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
If Dialogo.Radio2=0
  ACT(a:8, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:8, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:8, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:8, 'Tipo de Cta: Caja de Ahorro')
Endif
If Dialogo.Radio2=4
  ACT(a:8, 'Tipo de Cta: Todas')
Endif
If Dialogo.Check1=0
  ACT(a:8, Val(a:8)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:8, Val(a:8)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:1,3)
SetFont(a:3..a:8,2)

SetFilaActual(9)

ACT(a:fac,   'Concepto')
ACT(b:fac,   'Cuenta')
ACT(c:fac,   'Moneda')
ACT(d:fac,   'Importe')
ACT(e:fac,   'Codigo de ')
ACT(e:fac+1, 'Operacion')
ACT(f:fac,   'Tipo')
ACT(g:fac,   'Fecha')
ACT(g:fac+1, 'Ingreso')
ACT(h:fac,   'Fecha')
ACT(h:fac+1, 'Valor')
ACT(i:fac,   'Comprobante')
ACT(j:fac,   'Estado')
ACT(k:fac,   'Transaccion')
ACT(l:fac,   'Fecha')
ACT(l:fac+1, 'Conciliacion')
ACT(m:fac,   'Banco')
ACT(m:fac+1,   'FPA')
ACT(n:fac,   'Cuenta')
ACT(n:fac+1,   'FPA')
ACT(o:fac,   'Importe')
ACT(o:fac+1,   'FPA')
SetFont(a:fac..z:fac+1,2)
AlinearCeldas(a:fac..z:fac+1,'C')
AgregarMarco(a:fac..o:fac+1,0,0,RGB(162,222,251))
dfa

SQL.ADD(" SELECT M.*, D.Archivo, D.Estado, V.Codigo CodigoV, C.NrOperacion NrOperacionC, B.RazonSocial, ")
SQL.ADD(" C.NrMovimiento NrMovC, C.Fecha FechaC, ME.Cuenta CuentaM, CU.Comitente, CU.Numero, ")
SQL.ADD(" ME.Cantidad, CD.Descripcion DescripcionCD, CD.Tipo, TCD.Descripcion DescripcionTipo, D.EstadoAprobacion ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES B, ")
SQL.ADD(" "~DBO~".CONCILIACIONES C, "~DBO~".MOVEJECUTADOS ME, "~DBO~".CUENTAS CU, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TCD ")
SQL.ADD(" WHERE M.NrDataNet    = D.NrDataNet ")
SQL.ADD(" AND   M.Vehiculo     = V.Codigo    ")
SQL.ADD(" AND   M.NrDataNet    *= C.NrDataNet    ")
SQL.ADD(" AND   M.NrMovDataNet *= C.NrMovDataNet  ")
SQL.ADD(" AND   C.NrOperacion  *= ME.NrOperacion  ")
SQL.ADD(" AND   C.NrMovimiento *= ME.NrMov   ")
SQL.ADD(" AND   M.Cuenta       *= CU.Numero  ")
SQL.ADD(" AND   M.Moneda       *= E.Alias3   ")
SQL.ADD(" AND   CU.Comitente   *= B.Codigo   ")
SQL.ADD(" AND   CU.Estado      = 'HAB' ")
SQL.ADD(" AND   M.TipoMov      = CD.Codigo ")
SQL.ADD(" AND   CD.Tipo        = TCD.Codigo ")
If Dialogo.Radio3=0
  SQL.ADD(" AND  (D.EstadoAprobacion = 'P' OR D.EstadoAprobacion IS NULL)")
Endif
If Dialogo.Radio3=1
  SQL.ADD(" AND  D.EstadoAprobacion = 'OK' ")
Endif
If Dialogo.Radio1=0
 SQL.ADD(" AND   M.DC = 'C' ")
Endif
If Dialogo.Radio1=2
 SQL.ADD(" AND   M.DC = 'D' ")
 SQL.ADD(" AND   M.EstadoConciliacion = 'IE' ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND CU.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND CU.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND CU.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND CU.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
  SQL.ADD(" AND (CU.Pagadora <>'SI' OR CU.Pagadora IS NULL) ")
Endif
SQL.ADD(" AND   M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND E.Codigo  = 'ARP' ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  CU.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND  CU.Comitente IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
SQL.ADD(" ORDER BY M.Vehiculo, CU.Comitente, D.Archivo, M.NrDatanet, M.TipoMov, M.Cuenta, M.Moneda ")

ACT(va:1, '')
ACT(aa:1, '')
ACT(ba:1, '')

Recorrer SQL
 If Not Eqstr(fbn('CodigoV'), Val(va:1))
   ifa
   ifa
   Message('Vehiculo: '~fbn('CodigoV'))
   ACT(a:fac, fbn('CodigoV'))
   ACT(ba:1, '')
   ACT(aa:1, '')
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,RGB(221,242,255))
 Endif

 If Not Eqstr(fbn('Comitente'), Val(ba:1))
   ifa
   Message('Banco: '~fbn('Banco')~' - '~fbn('RazonSocial'))
   ACT(a:fac, 'Banco: '~fbn('Banco')~' - '~fbn('RazonSocial'))
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,RGB(232,232,232))
   ACT(aa:1, '')
   ACT(aa:2, '')
   ifa
 Endif

 If Not Eqstr(fbn('Archivo'), Val(aa:1)) o Not Eqstr(fbn('NrDatanet'), Val(aa:2))
   ifa
   Message('Archivo: '~fbn('Archivo')~' ('~fbn('NrDatanet')~')'~' - Estado: '~IIF(Eqstr(fbn('Estado'),'A'),'Abierto','Cerrado') )
   ACT(a:fac, 'Archivo: '~fbn('Archivo')~' ('~fbn('NrDatanet')~')'~' - Estado: '~IIF(Eqstr(fbn('Estado'),'A'),'Abierto','Cerrado') )
   ACT(a:fac, Val(a:fac)~' - '~iif(eqstr(fbn('EstadoAprobacion'),'OK'),'Aprobado por Supervisor.','Aprobacion de Supervisor Pendiente.') )
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,0)
   ifa
 Endif
 ACT(a:fac, fbn('TipoMov'))
 ACT(b:fac, fbn('Cuenta'))
 ACT(c:fac, fbn('Moneda'))
 ACN(d:fac, fbn('Importe')*IIF(Eqstr(fbn('DC'),'C'),1,-1))
 ACT(e:fac, fbn('TipoMov')~'-'~fbn('DescripcionCD'))
 ACT(f:fac, fbn('Tipo')~'-'~fbn('DescripcionTipo'))
 ACD(g:fac, fbn('FechaIngreso'))
 ACD(h:fac, fbn('FechaAcreditacion'))
 ACT(i:fac, fbn('Comprobante'))
 ACT(j:fac, fbn('EstadoConciliacion'))
 If Eqstr(Val(j:fac), 'OK')
   ColorCeldas(j:fac,clGREEN)
 Endif
 If Eqstr(Val(j:fac), 'P')
   ColorCeldas(j:fac,clRED)
 Endif
 If Incluido(Val(j:fac), 'IE|IP')
   ColorCeldas(j:fac,clBLUE)
 Endif

 ACT(k:fac, fbn('NrOperacionC'))
 ACLT(k:fac, fbn('NrOperacionC'))
 ACD(l:fac, fbn('FechaC'))
 ACT(m:fac, fbn('Comitente'))
 ACT(n:fac, fbn('CuentaM')~'-'~fbn('Numero'))
 ACN(o:fac, fbn('Cantidad'))

 SetFont(a:fac..z:fac,1)
 FormatoCeldas(d:fac,EXE('F2'))
 FormatoCeldas(o:fac,EXE('F2'))
 
 ACT(va:1, fbn('CodigoV'))
 ACT(aa:1, fbn('Archivo'))
 ACT(aa:2, fbn('NrDatanet'))
 ACT(ba:1, fbn('Comitente'))
