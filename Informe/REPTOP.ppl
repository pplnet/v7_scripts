HojaVisible(SI)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
(.'DIALOGOPNL'.)
&DifDias := DifDias(Dialogo.Fecha2,Dialogo.Fecha1,no,no) + 1
********************************************ANOTACIONES****************************************************************
*AA Saldos
    *AA:1  Saldo para MMCREM a ese dia(pesificado)
    *AA:2  SNC suma de saldos MMCREM
    *AA:3  Promedio de saldos dividido en la cantidad de fechas que 
    *AA:4 Pivote para guardar la cantidad para las operaciones de Tipo MMCO/MMCT/MMPF
*BB P&L
    *BB:1  SNC suma de P&LMMCREM ese dia(pesificado)
*CC Fechas para operaciones de Tipo MMCO/MMCT/MMPF
    *CC:1 FechaDesde
    *CC:2 FechaHasta     
*DD
    *DD:1 Valor de FAC donde se guardara las mismas operaciones
*****************************************FIN ANOTACIONES****************************************************************
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')
*********************************************ENCABEZADOS****************************************************************
ACT(a:fac+6,'P&L Tasa de Transferencia- Por Tipo Operación')
SetFont(a:fac+6,1)
(.'ENCABEPNL'.)
*****************************************FIN ENCABEZADOS****************************************************************

*SetFilaActual(13)
ACN(w1,FAC)

ACT(a:fac, 'Tipo de operacion')
ACL(a:Fac, 'REPCLI', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1=Dialogo.Cliente1, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
ACT(b:fac, 'Capital Promedio')
ACT(c:fac, 'P&L Período')
SetFont(a:fac..c:FAC,1)
AgregarMarco(a:FAC..c:FAC,1,0,Exe('COLOR6'))
AlinearCeldas(b:FAC..c:fac,'D')

(.'CONSPRETSA'.)
SQL.ADD(" Order by O.TipoOp ")
Recorrer SQL
    &DifDiasMMCREM := &DifDias
    &AuxDia :=&DifDiasMMCREM 
    DFA
    *Tipo de operacion 
    &TipoOp := FBN['TipoOp']
    *validacion check
    IF Dialogo.Radio2 = 0
    *PRECIO
        
    ELSE
        *TASA
        *Tasa de la op
        &TasaOP := Num(FBN['Precio1'])
        *Tasa de transf 
        &TasaTransf := Num(FBN['Precio4'])
        *Fecha Vencimiento de la operacion
        &FechaVto := FBN['FechaVto']
        *Fecha de la Operacion
        &FechaOp := FBN['FechaOp']
        *CAPITAL
        *Tasa MMCREM Y MAS DE UN DIA
        If Not Eqstr(&TipoOp, Val(A:FAC))
            IFA
            ACT(A:FAC,&TipoOp)
            *CLICK QUE TE LLEVA A P&L CLIENTE
            ACL(A:Fac, 'REPCLI', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=&TipoOp,Cliente1=Dialogo.Cliente1, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            ACN(DD:1,FAC)
        EndIf

        If EqStri(&TipoOp, 'MMCREM')
            If DifDias(Dialogo.Fecha1,FBN['FechaVto'],no,no) = 0
            ELSE
                Recorrer&i 0, Num(&DifDiasMMCREM) 
                    *Capital 
                    ACN(AA:5,SQL("SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"') THEN 1 WHEN EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"' AND SALDO < 0) THEN 2 ELSE 3 END AS CodigoResultado;"))
                    *Val(AA:5) = 2 El saldo existe pero es negativo
                    IF Dialogo.Fecha1+&i >= &FechaOp Y   ((Dialogo.Fecha1+&i) < &FechaVto) Y Dialogo.Fecha1+&i <= Dialogo.Fecha2
                            IF Val(AA:5) = 2
                                &DifDiasMMCREM := &DifDiasMMCREM - 1
*                                &AuxDia := &AuxDia + 1
                            ELSE IF  DifDias(Dialogo.Fecha1 + &i,FBN['FechaVto'],no,no) = 0
*                                &AuxDia := &AuxDia + 1
                            *Val(AA:5) = 1 El saldo NO existe para ese dia
                                ELSE IF Val(AA:5) = 1
                                    *Moneda Emision
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2 ,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif

                                    ELSE
                                        *El saldo existe y no es negativo para ese dia
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif
                                endif
                            endif
                        ENDIF
                    ENDIF               
                    SCN(AA:2,Val(AA:1))
                    SCN(BB:1,(((&TasaTransf-&TasaOP) / 365 *  Val(AA:1) ))/100)
                    ACN(AA:1,0)
                Proximo            
                ACN(AA:3,(Val(AA:2) / (&AuxDia)))
                SCN(B:Val(DD:1), Val(AA:3))
                SCN(C:Val(DD:1),Val(BB:1))
                *Seteo en 0 los pivotes
                ACN(AA:1,0)
                ACN(AA:2,0)
                ACN(AA:3,0)
                ACN(BB:1,0)
                Endif
        Else
        (.'FECHAP&L'.)
        *Capital Moneda
            If Dialogo.Radio4 =0
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
            else 
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
            endif
                
            IF  Buscar(&TipoOp, Pipe2Comillas(Var('TIPOOPACTI')))
                *ACTIVO
                SCN(C:Val(DD:1),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            Else 
                *Pasivo
                SCN(C:Val(DD:1),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            EndIf
            
            ACN(AA:4,Val(AA:4)* &DifDias2)
            SCN(B:Val(DD:1),(Val(AA:4)/(&DifDias)))
        EndIf
    EndIF
Proximo
If NoVacio(Val(DD:1))
    SetFilaActual(Val(DD:1))
ENDIF



ACO(1,15)
ACO(2,15)
ACO(3,15)
ACO(4,15)
SetFilaActual(FAC+2)
ACT(a:FAC,'TOTALES')
SetFont(a:FAC, 1)
ACN(b:FAC,Sum(b:Val(w1)+1..b:fac))
ACN(c:FAC,Sum(c:Val(w1)+1..c:fac))
FormatoCeldas(B:15..B:fac,Exe('F2'))
FormatoCeldas(C:15..C:fac,Exe('F2'))
AgregarMarco(a:FAC..c:FAC,1,0,Exe('COLOR7'))

SetFilaActual(FAC+2)
ACT(a:FAC,'FIN DEL INFORME')
SetFont(a:FAC..c:FAC, 1)
LimitesVision(D:FAC+1)


SetPrintFit(3, 110)
Impresion(1, 2)