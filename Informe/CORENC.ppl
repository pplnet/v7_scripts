CrearDialogo
   Fecha1  : 'Desde';1;1;;;;;;;;FSYS-1
   Fecha2  : 'Hasta';2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;FSYS-1
   Radio3  : 'Origen:|Todas|Activo|Pasivo';3;1;;;;;;;0;
   Radio6  : 'Clientes:|Todos|Vinc.|Terc.';4;1;;;;;;;0;

   Radio1  : 'Terc y Act|Todos|Dep.Pla|Cta.Cte';5;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];;;;;0;IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio1)
   Radio4  : 'Terc y Pas|Todos|Ob.Neg|Com.Ext|Fin.Lo|Fin.Ex|C.C.';;;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];;;;;0;IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio4)
   Radio2  : 'Vinc y Act|Todos|C.C.Vinc|C.C.Div|Co.Vinc|Co.Div';;;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];;;;;0;IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio2)
   Radio5  : 'Vinc y Pas|Todos|C.C.Vinc|C.C.Div|Pr.Vinc|Pr.Div';;;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];;;;;0;IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio5)

   Radio14 : 'Tipo Operac:|Todas|V.Simple|V.Mult.|C.Ahorro';9;1;;;;;;;0;
   Especie1: 'Moneda:';12;1;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4  : 'Imp.Detallado' ;13;1;;;;;;;;0;

   Radio8  : 'Informacion:|Periodo|AHEAD';1;2;;;;;;;0;
   Radio10 : 'Operaciones:|Todas|A Tasa|Securities';2;2;;;;;;;0;
   Radio12 : 'Vehiculos:|Todos|Algunos';3;2;;;;;;;0;
   Radio7  : 'Especies:|Todas|Algunas';4;2;;;;;;;0;

   Lista1  : 'Vehiculo'     ;10;2;;Dialogo.Radio12=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Lista2  : 'Especies'     ;11;1;;Dialogo.Radio7=1 ;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Lista3  : 'Clientes'     ;5;2;;Dialogo.Radio6<>0;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

* Datos del encabezado
(.'CORECABC'.)

* Nombre de Filas 
SetFilaActual(13)
ACT(A:fac,'POSICION TOTAL NETA')
ACT(A:fac+02,'    Posicion Terceros Neta')	
ACT(A:fac+03,'    Posicion Vinculadas Neta')  

ACT(A:fac+05,'Total Activo') 

ACT(B:fac+07,'Total Terceros')
ACT(C:fac+08,'SubTot Terc.')
ACT(D:fac+09,'Dep a Plazo')
ACT(D:fac+10,'Cta.Cte.Terc.')
ACT(D:fac+11,'Titulos Publicos') 
ACT(D:fac+12,'Titulos Privados')
ACT(C:fac+13,'Acciones')  

ACT(B:fac+15,'Total Vinculadas')
ACT(D:fac+16,'Cta.Cte.Vinc.')
ACT(D:fac+17,'Cta.Cte.Div.')
ACT(D:fac+18,'Coloc.Vinc.')
ACT(D:fac+19,'Coloc.Div.')

ACT(A:fac+21,'Total Pasivo')
ACT(B:fac+23,'Total Terceros')  
ACT(D:fac+24,'Oblig.Neg.')
ACT(D:fac+25,'Com.Ext.')
ACT(D:fac+26,'Financ.Loc.') 
ACT(D:fac+27,'Financ.Ext.')
ACT(D:fac+28,'Cta.Cte.Terc.')
ACT(B:fac+30,'Total Vinculadas')  
ACT(D:fac+31,'Cta.Cte.Vinc.')
ACT(D:fac+32,'Cta.Cte.Div.')
ACT(D:fac+33,'Prest.Vinc.')
ACT(D:fac+34,'Prest.Div.')

SetFont(a:fac..c:fac+34, 2)

SQL.ADD(" SELECT Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(val(zz6))
   SQL.ADD(" Where Codigo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD(" ORDER BY Codigo ")

SetFilaActual(9)

ACN(fa1, fac+1)
ACN(fa2, fac+1)
ACN(zz1, 1)

Recorrer SQL  

  SetFont(Val(zz1):Val(fa1)..Val(zz1)+2:fac,1)   
  SetFilaActual(Val(fa2))
  SCN(zz1,4)
  ACT(Val(zz1)+1:fac, fbn('Codigo'))
  AgregarMarco(Val(zz1):fac..Val(zz1)+2:fac,1,0,EXE('COLOR'))
  ifa

  ACT(Val(zz1):fac, 'CAP.PROM.')
  ACT(Val(zz1)+1:fac, 'TASA')
  ACT(Val(zz1)+2:fac, 'PLAZO')
    
  SetFont(Val(zz1):fac-1..Val(zz1)+2:fac,2)
  AlinearCeldas(Val(zz1):fac..Val(zz1)+2:fac,'C')
   
  AgregarMarco(Val(zz1):fac..Val(zz1):fac,1,0,0)
  AgregarMarco(Val(zz1)+1:fac..Val(zz1)+1:fac,1,0,0)
  AgregarMarco(Val(zz1)+2:fac..Val(zz1)+2:fac,1,0,0)    

  *-- Operaciones Activas
  If Dialogo.Radio3=0  o  Dialogo.Radio3=1
    *--- Terceros
    If Dialogo.Radio6=0  o  Dialogo.Radio6=2
      *-- Dep. a plazo
      If [Dialogo.Radio1=0  o  Dialogo.Radio1=1] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(22)  
        BorrarCeldas(w1..w42)
        (.'DEPOPLAZO'.)
        ** armar totales para Dep a plazo
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2)+Val(w3)+Val(w4))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)+Val(w3)*Val(w32)+Val(w4)*Val(w42)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)+Val(w3)*Val(w31)+Val(w4)*Val(w41)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)+Val(w3)*Val(w32)*Val(w31)+Val(w4)*Val(w42)*Val(w41)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)+Val(w3)*Val(w32)+Val(w4)*Val(w42)) )
        endif
      Endif

      *-- cta.cte.terc.
      If [Dialogo.Radio1=0  o  Dialogo.Radio1=2] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(23)  
        BorrarCeldas(w1..w42)
        (.'CTACTE3AC'.)
        ** armar totales para Cta.Cte.Terceros activos
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif

      *-- Securities
      If Dialogo.Radio10=0  o  Dialogo.Radio10=2
        *-- Titulos Publicos
        SetFilaActual(24)  
        BorrarCeldas(w1..w42)
        (.'TITPUB'.)
        ** armar totales para Titulos Publicos
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, 0 )
        * tasa
        ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )

        *-- Titulos Privados
        SetFilaActual(25)  
        BorrarCeldas(w1..w42)
        (.'TITPRI'.)
        ** armar totales para Titulos privados
        * capital promedio
        ACN(Val(zz1):fac, Val(w1))
        * plazo
        ACN(Val(zz1)+2:fac, 0 )
        * tasa
        ACN(Val(zz1)+1:fac, Val(w11))

        *-- Acciones
        * ojo columna B
        SetFilaActual(26)  
        BorrarCeldas(w1..w42)
        (.'ACCIONES'.)
        ** armar totales para Titulos privados
        * capital promedio
        ACN(Val(zz1):fac, Val(w1))
        * plazo
        ACN(Val(zz1)+2:fac, 0 )
        * tasa
        ACN(Val(zz1)+1:fac, Val(w11))
      Endif
      
      *-- Subtotal Terceros Activos
      SetFilaActual(21)
      BorrarCeldas(w1..w42)
      *Buscar si hay algun ajuste
      ACN(v1,0)
      (.'AJUSUBTOT3'.)
      if Val(v1)=1
        * hay ajuste
        * Capital
        ACN(Val(zz1):fac, Val(w1)) 
        * tasa
        ACN(Val(zz1)+1:fac, Val(w11))
        * plazo
        ACN(Val(zz1)+2:fac, Val(w12))
      else
        * capital promedio
        ACN(Val(zz1):fac, Val(Val(zz1):22)+Val(Val(zz1):23)+Val(Val(zz1):24)+Val(Val(zz1):25) )
        * plazo
        if Dialogo.Radio10=1
          ACN(Val(zz1)+2:fac, (Val(Val(zz1):22)*Val(Val(zz1)+2:22)+Val(Val(zz1):23)*Val(Val(zz1)+2:23)+Val(Val(zz1):24)*Val(Val(zz1)+2:24)+Val(Val(zz1):25)*Val(Val(zz1)+2:25)) / Val(Val(zz1):fac) )
        else
          ACN(Val(zz1)+2:fac, 0)
        endif
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(Val(zz1):22)*Val(Val(zz1)+1:22)+Val(Val(zz1):23)*Val(Val(zz1)+1:23)+Val(Val(zz1):24)*Val(Val(zz1)+1:24)+Val(Val(zz1):25)*Val(Val(zz1)+1:25)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(Val(zz1):22)*Val(Val(zz1)+2:22)*Val(Val(zz1)+1:22)+Val(Val(zz1):23)*Val(Val(zz1)+2:23)*Val(Val(zz1)+1:23)+(Val(Val(zz1):24)*Val(Val(zz1)+2:24)*Val(Val(zz1)+1:24)+Val(Val(zz1):25)*Val(Val(zz1)+2:25)*Val(Val(zz1)+1:25)) / (Val(Val(zz1):22)*Val(Val(zz1)+2:22)+Val(Val(zz1):23)*Val(Val(zz1)+2:23)+Val(Val(zz1):24)*Val(Val(zz1)+2:24)+Val(Val(zz1):25)*Val(Val(zz1)+2:25)) ))
        endif
      endif

      *-- Total Terceros Activos
      SetFilaActual(20)
      * capital promedio
      ACN(Val(zz1):fac, Val(Val(zz1):21)+Val(Val(zz1):26))
      * plazo
      if Dialogo.Radio10=1
        ACN(Val(zz1)+2:fac, (Val(Val(zz1):21)*Val(Val(zz1)+2:21)+Val(Val(zz1):26)*Val(Val(zz1)+2:26)) / Val(Val(zz1):fac) )
      else
        ACN(Val(zz1)+2:fac, 0)
      endif
      * tasa
      if Dialogo.Radio8 = 0
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):21)*Val(Val(zz1)+1:21)+Val(Val(zz1):26)*Val(Val(zz1)+1:26)) / Val(Val(zz1):fac)  )
      else
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):21)*Val(Val(zz1)+2:21)*Val(Val(zz1)+1:21)+Val(Val(zz1):26)*Val(Val(zz1)+2:26)*Val(Val(zz1)+1:26)) / (Val(Val(zz1):21)*Val(Val(zz1)+2:21)+Val(Val(zz1):26)*Val(Val(zz1)+2:26)) )
      endif
    Endif

    *--- Vinculados
    If Dialogo.Radio6=0  o  Dialogo.Radio6=1
      *-- cta.cte.vinculados
      If [Dialogo.Radio2=0  o  Dialogo.Radio2=1] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(29)  
        BorrarCeldas(w1..w42)   
        (.'CTACTEVIAC'.)
         ** armar totales para Cta.Cte.Vinculados
         * capital promedio
         ACN(Val(zz1):fac, Val(w1)+Val(w2))
         * plazo
         ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
         * tasa
         if Dialogo.Radio8 = 0
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
         else
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
         endif
      Endif
 
      *-- cta.cte.divisiones
      If [Dialogo.Radio2=0  o  Dialogo.Radio2=2] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(30)  
        BorrarCeldas(w1..w42)   
        (.'CTACTEDIAC'.)
         ** armar totales para Cta.Cte.Divisiones
         * capital promedio
         ACN(Val(zz1):fac, Val(w1)+Val(w2))
         * plazo
         ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
         * tasa
         if Dialogo.Radio8 = 0
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
         else
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
         endif
      Endif
 
      *-- Colocaciones Vinculadas
      If [Dialogo.Radio2=0  o  Dialogo.Radio2=3] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(31)  
        BorrarCeldas(w1..w42)   

        (.'COLOCVIN'.)
         ** armar totales para Colocaciones Vinculadas
         * capital promedio
         ACN(Val(zz1):fac, Val(w1)+Val(w2))
         *plazo
         ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
         * tasa
         if Dialogo.Radio8 = 0
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
         else
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
         endif
      Endif
 
      *-- Colocaciones Divisiones
      If [Dialogo.Radio2=0  o  Dialogo.Radio2=4] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(32)  
        BorrarCeldas(w1..w42)   
        (.'COLOCDIV'.)
        ** armar totales para Colocaciones Divisiones
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif

      *-- Total Vinculadas Activos
      SetFilaActual(28)
      * capital promedio
      ACN(Val(zz1):fac, Val(Val(zz1):29)+Val(Val(zz1):30)+Val(Val(zz1):31)+Val(Val(zz1):32) )
      * plazo
      ACN(Val(zz1)+2:fac, (Val(Val(zz1):29)*Val(Val(zz1)+2:29)+Val(Val(zz1):30)*Val(Val(zz1)+2:30)+Val(Val(zz1):31)*Val(Val(zz1)+2:31)+Val(Val(zz1):32)*Val(Val(zz1)+2:32)) / Val(Val(zz1):fac) )
      * tasa
      if Dialogo.Radio8 = 0
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):29)*Val(Val(zz1)+1:29)+Val(Val(zz1):30)*Val(Val(zz1)+1:30)+Val(Val(zz1):31)*Val(Val(zz1)+1:31)+Val(Val(zz1):32)*Val(Val(zz1)+1:32)) / Val(Val(zz1):fac)  )
      else
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):29)*Val(Val(zz1)+2:29)*Val(Val(zz1)+1:29)+Val(Val(zz1):30)*Val(Val(zz1)+2:30)*Val(Val(zz1)+1:30)+Val(Val(zz1):31)*Val(Val(zz1)+2:31)*Val(Val(zz1)+1:31)+Val(Val(zz1):32)*Val(Val(zz1)+2:32)*Val(Val(zz1)+1:32)) / (Val(Val(zz1):29)*Val(Val(zz1)+2:29)+Val(Val(zz1):30)*Val(Val(zz1)+2:30)+Val(Val(zz1):31)*Val(Val(zz1)+2:31)+Val(Val(zz1):32)*Val(Val(zz1)+2:32)) )
      endif

    Endif
    *-- Total Activos
    SetFilaActual(18)
    * capital promedio
    ACN(Val(zz1):fac, Val(Val(zz1):20)+Val(Val(zz1):28) )
    * plazo
    if Dialogo.Radio10=1
      ACN(Val(zz1)+2:fac, (Val(Val(zz1):20)*Val(Val(zz1)+2:20)+Val(Val(zz1):28)*Val(Val(zz1)+2:28)) / Val(Val(zz1):fac) )
    else
      ACN(Val(zz1)+2:fac, 0)  
    endif
    * tasa
    if Dialogo.Radio8 = 0
      ACN(Val(zz1)+1:fac, (Val(Val(zz1):20)*Val(Val(zz1)+1:20)+Val(Val(zz1):28)*Val(Val(zz1)+1:28)) / Val(Val(zz1):fac)  )
    else
      ACN(Val(zz1)+1:fac,(Val(Val(zz1):20)*Val(Val(zz1)+2:20)*Val(Val(zz1)+1:20)+Val(Val(zz1):28)*Val(Val(zz1)+2:28))*Val(Val(zz1)+1:28) / (Val(Val(zz1):20)*Val(Val(zz1)+2:20))+Val(Val(zz1):28)*Val(Val(zz1)+2:28))
    endif
  Endif

  *-- Operaciones Pasivas
  If Dialogo.Radio3=0  o  Dialogo.Radio3=2
    *--- Terceros
    If [Dialogo.Radio6=0  o  Dialogo.Radio6=2] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
      *-- Obligaciones Negociables 
      If Dialogo.Radio4=0  o  Dialogo.Radio4=1
        SetFilaActual(37)  
        BorrarCeldas(w1..w42)
        (.'OBLIGNEG'.)
        ** armar totales para Obligaciones Negociables
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- Comercio Exterior
      If [Dialogo.Radio4=0  o  Dialogo.Radio4=2] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(38)  
        BorrarCeldas(w1..w42)
        (.'COMEXT'.)
        ** armar totales para Comercio Exterior
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- Financiaciones Locales
      If [Dialogo.Radio4=0  o  Dialogo.Radio4=3] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(39)  
        BorrarCeldas(w1..w42)
        (.'FINLOC'.)
        ** armar totales para Financiaciones Locales
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- Financiaciones del Exterior
      If [Dialogo.Radio4=0  o  Dialogo.Radio4=4] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(40)  
        BorrarCeldas(w1..w42)
        (.'FINEXT'.)
        ** armar totales para Obligaciones Negociables
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- cta.cte. terceros pasivos
      If [Dialogo.Radio4=0  o  Dialogo.Radio4=5] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(41)  
        BorrarCeldas(w1..w42)
        (.'CTACTE3PA'.)
        ** armar totales para cta.cte. terceros pasivos
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
           ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
      *-- Total Terceros Pasivos
      SetFilaActual(36)
      * capital promedio
      ACN(Val(zz1):fac, Val(Val(zz1):37)+Val(Val(zz1):38)+Val(Val(zz1):39)+Val(Val(zz1):40)+Val(Val(zz1):41) )
      * plazo
      ACN(Val(zz1)+2:fac, (Val(Val(zz1):37)*Val(Val(zz1)+2:37)+Val(Val(zz1):38)*Val(Val(zz1)+2:38)+Val(Val(zz1):39)*Val(Val(zz1)+2:39)+Val(Val(zz1):40)*Val(Val(zz1)+2:40)+Val(Val(zz1):41)*Val(Val(zz1)+2:41)) / Val(Val(zz1):fac) )
      * tasa
      if Dialogo.Radio8 = 0
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):37)*Val(Val(zz1)+1:37)+Val(Val(zz1):38)*Val(Val(zz1)+1:38)+Val(Val(zz1):39)*Val(Val(zz1)+1:39)+Val(Val(zz1):40)*Val(Val(zz1)+1:40)+Val(Val(zz1):41)*Val(Val(zz1)+1:41)) / Val(Val(zz1):fac)  )
      else
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):37)*Val(Val(zz1)+2:37)*Val(Val(zz1)+1:37)+Val(Val(zz1):38)*Val(Val(zz1)+2:38)*Val(Val(zz1)+1:38)+Val(Val(zz1):39)*Val(Val(zz1)+2:39)*Val(Val(zz1)+1:39)+Val(Val(zz1):40)*Val(Val(zz1)+2:40)*Val(Val(zz1)+1:40)+Val(Val(zz1):41)*Val(Val(zz1)+2:41)*Val(Val(zz1)+1:41)) / (Val(Val(zz1):37)*Val(Val(zz1)+2:37)+Val(Val(zz1):38)*Val(Val(zz1)+2:38)+Val(Val(zz1):39)*Val(Val(zz1)+2:39)+Val(Val(zz1):40)*Val(Val(zz1)+2:40)+Val(Val(zz1):41)*Val(Val(zz1)+2:41)) )
      endif
    Endif

    *--- Vinculados 
    If Dialogo.Radio6=0  o  Dialogo.Radio6=1
      *-- cta.cte. vinculados pasivas
      If [Dialogo.Radio5=0  o  Dialogo.Radio5=1] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(44)  
        BorrarCeldas(w1..w42)
        (.'CTACTEVIPA'.)
        ** armar totales para cta.cte. vinculadas pasivas
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- cta.cte. divisiones pasivas
      If [Dialogo.Radio5=0  o  Dialogo.Radio5=2] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(45)  
        BorrarCeldas(w1..w42)
        (.'CTACTEDIPA'.)
        ** armar totales para cta.cte. divisiones pasivas
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- Prestamos Vinculados
      If [Dialogo.Radio5=0  o  Dialogo.Radio5=3] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(46)  
        BorrarCeldas(w1..w42)
        (.'PRESTVIN'.)
        ** armar totales para prestamos vinculados
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
       *-- Prestamos Divisiones
      If [Dialogo.Radio5=0  o  Dialogo.Radio5=4] y [Dialogo.Radio10=0  o  Dialogo.Radio10=1]
        SetFilaActual(47)  
        BorrarCeldas(w1..w42)
        (.'PRESTDIV'.)
        ** armar totales para prestamos divisiones
        * capital promedio
        ACN(Val(zz1):fac, Val(w1)+Val(w2))
        * plazo
        ACN(Val(zz1)+2:fac, (Val(w1)*Val(w12)+Val(w2)*Val(w22)) / Val(Val(zz1):fac) )
        * tasa
        if Dialogo.Radio8 = 0
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w11)+Val(w2)*Val(w21)) / Val(Val(zz1):fac)  )
        else
          ACN(Val(zz1)+1:fac, (Val(w1)*Val(w12)*Val(w11)+Val(w2)*Val(w22)*Val(w21)) / (Val(w1)*Val(w12)+Val(w2)*Val(w22)) )
        endif
      Endif
      *-- Total Vinculados Pasivos
      SetFilaActual(43)
      * capital promedio
      ACN(Val(zz1):fac, Val(Val(zz1):44)+Val(Val(zz1):45)+Val(Val(zz1):46)+Val(Val(zz1):47) )
      * plazo
      ACN(Val(zz1)+2:fac, (Val(Val(zz1):44)*Val(Val(zz1)+2:44)+Val(Val(zz1):45)*Val(Val(zz1)+2:45)+Val(Val(zz1):46)*Val(Val(zz1)+2:46)+Val(Val(zz1):47)*Val(Val(zz1)+2:47)) / Val(Val(zz1):fac) )
      * tasa
      if Dialogo.Radio8 = 0
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):44)*Val(Val(zz1)+1:44)+Val(Val(zz1):45)*Val(Val(zz1)+1:45)+Val(Val(zz1):46)*Val(Val(zz1)+1:46)+Val(Val(zz1):47)*Val(Val(zz1)+1:47)) / Val(Val(zz1):fac)  )
      else
        ACN(Val(zz1)+1:fac, (Val(Val(zz1):44)*Val(Val(zz1)+2:44)*Val(Val(zz1)+1:44)+Val(Val(zz1):45)*Val(Val(zz1)+2:45)*Val(Val(zz1)+1:45)+Val(Val(zz1):46)*Val(Val(zz1)+2:46)*Val(Val(zz1)+1:46)+Val(Val(zz1):47)*Val(Val(zz1)+2:47)*Val(Val(zz1)+1:47)) / (Val(Val(zz1):44)*Val(Val(zz1)+2:44)+Val(Val(zz1):45)*Val(Val(zz1)+2:45)+Val(Val(zz1):46)*Val(Val(zz1)+2:46)+Val(Val(zz1):47)*Val(Val(zz1)+2:47)) )
      endif
    Endif
    *-- Total Pasivos
    SetFilaActual(34)
    * capital promedio
    ACN(Val(zz1):fac, Val(Val(zz1):36)+Val(Val(zz1):43) )
    * plazo
    ACN(Val(zz1)+2:fac, (Val(Val(zz1):36)*Val(Val(zz1)+2:36)+Val(Val(zz1):43)*Val(Val(zz1)+2:43)) / Val(Val(zz1):fac) )
    * tasa
    if Dialogo.Radio8 = 0
      ACN(Val(zz1)+1:fac, (Val(Val(zz1):36)*Val(Val(zz1)+1:36)+Val(Val(zz1):43)*Val(Val(zz1)+1:43)) / Val(Val(zz1):fac)  )
    else
      ACN(Val(zz1)+1:fac, (Val(Val(zz1):36)*Val(Val(zz1)+2:36)*Val(Val(zz1)+1:36)+Val(Val(zz1):43)*Val(Val(zz1)+2:43))*Val(Val(zz1)+1:43) / (Val(Val(zz1):36)*Val(Val(zz1)+2:36))+Val(Val(zz1):43)*Val(Val(zz1)+2:43))
    endif
  Endif
  *-- Posicion de Terceros Neta
  SetFilaActual(15)
  * capital promedio
  ACN(Val(zz1):fac, Val(Val(zz1):20)-Val(Val(zz1):36) )
  * plazo
  if Dialogo.Radio10=1
    ACN(Val(zz1)+2:fac, (Val(Val(zz1):20)*Val(Val(zz1)+2:20)-Val(Val(zz1):36)*Val(Val(zz1)+2:36)) / Val(Val(zz1):fac) )
  else
    ACN(Val(zz1)+2:fac, 0)
  endif
  * tasa
  if Dialogo.Radio8 = 0
    ACN(Val(zz1)+1:fac, (Val(Val(zz1):20)*Val(Val(zz1)+1:20)-Val(Val(zz1):36)*Val(Val(zz1)+1:36)) / Val(Val(zz1):fac)  )
  else
    ACN(Val(zz1)+1:fac, (Val(Val(zz1):20)*Val(Val(zz1)+2:20)*Val(Val(zz1)+1:20)-Val(Val(zz1):36)*Val(Val(zz1)+2:36))*Val(Val(zz1)+1:36) / Val(Val(zz1):20)*Val(Val(zz1)+2:20)-Val(Val(zz1):36)*Val(Val(zz1)+2:36))
  endif

  *-- Posicion de Vinculados Neta
  SetFilaActual(16)
  * capital promedio
  ACN(Val(zz1):fac, Val(Val(zz1):28)-Val(Val(zz1):43) )
  * plazo
  ACN(Val(zz1)+2:fac, (Val(Val(zz1):28)*Val(Val(zz1)+2:28)-Val(Val(zz1):43)*Val(Val(zz1)+2:43)) / Val(Val(zz1):fac) )
  * tasa
  if Dialogo.Radio8 = 0
    ACN(Val(zz1)+1:fac, (Val(Val(zz1):28)*Val(Val(zz1)+1:28)-Val(Val(zz1):43)*Val(Val(zz1)+1:43)) / Val(Val(zz1):fac)  )
  else
    ACN(Val(zz1)+1:fac, (Val(Val(zz1):28)*Val(Val(zz1)+2:28)*Val(Val(zz1)+1:28)-Val(Val(zz1):43)*Val(Val(zz1)+2:43))*Val(Val(zz1)+1:43) / (Val(Val(zz1):28)*Val(Val(zz1)+2:28))-Val(Val(zz1):43)*Val(Val(zz1)+2:43))
  endif

  * Posicion Total Neta
  SetFilaActual(13)
  * capital promedio
  ACN(Val(zz1):fac, Val(Val(zz1):18)-Val(Val(zz1):34) )
  * plazo
  if Dialogo.Radio10=1
     ACN(Val(zz1)+2:fac, (Val(Val(zz1):18)*Val(Val(zz1)+2:18)-Val(Val(zz1):34)*Val(Val(zz1)+2:34)) / Val(Val(zz1):fac) )
  else
     ACN(Val(zz1)+2:fac,0)
  endif
  * tasa
  if Dialogo.Radio8 = 0
     ACN(Val(zz1)+1:fac, (Val(Val(zz1):18)*Val(Val(zz1)+1:18)-Val(Val(zz1):34)*Val(Val(zz1)+1:34)) / Val(Val(zz1):fac)  )
  else
     ACN(Val(zz1)+1:fac, (Val(Val(zz1):18)*Val(Val(zz1)+2:18)*Val(Val(zz1)+1:18)-Val(Val(zz1):34)*Val(Val(zz1)+2:34))*Val(Val(zz1)+1:34) / (Val(Val(zz1):18)*Val(Val(zz1)+2:18))-Val(Val(zz1):34)*Val(Val(zz1)+2:34))
  endif
Proximo

* Consolidados 
SetFont(Val(zz1):Val(fa1)..Val(zz1)+2:fac,1)   
SetFilaActual(Val(fa2))
SCN(zz1,3)
ACT(Val(zz1)+1:fac, 'CONSOLIDADO')
AgregarMarco(Val(zz1):fac..Val(zz1)+2:fac,1,0,EXE('COLOR'))
ifa

ACT(Val(zz1):fac, 'CAP.PROM.')
ACT(Val(zz1)+1:fac, 'TASA')
ACT(Val(zz1)+2:fac, 'PLAZO')
    
SetFont(Val(zz1):fac-1..Val(zz1)+2:fac,2)
AlinearCeldas(Val(zz1):fac..Val(zz1)+2:fac,'C')
    
AgregarMarco(Val(zz1):fac..Val(zz1):fac,1,0,0)
AgregarMarco(Val(zz1)+1:fac..Val(zz1)+1:fac,1,0,0)
AgregarMarco(Val(zz1)+2:fac..Val(zz1)+2:fac,1,0,0)    
ifa
ACN(fa1, fac)
*-- Recorro los niviles basicos (las columnas D:) 
Recorrer&j 13,47
  If &j<>14 y &j<>17 y &j<>19 y &j<>27 y &j<>33 y &j<>35 y &j<>42 
    *-- Recorro los vehiculos ---   
    ACN(da2,0)
    ACN(da3,0)
    ACN(da4,0)
    ACN(da5,0)
    Recorrer&i 5, Val(zz1)-1
      *--- 1ra columna de cada grupo perteneciente al capital ---       
      If 1 = (&i MOD 4)
        *--Sumatoria de Capitales ---
        SCN(da2, Val(&i:&j) )       
        *--Sumatoria de Capital * Plazo ---
        SCN(da3, (Val(&i:&j) * Val(&i+2:&j))   )       
        *--Sumatoria de Capital * tasa ---
        SCN(da4, (Val(&i:&j) * Val(&i+1:&j))  )       
        *--Sumatoria de Capital * Plazo *tasa ---
        SCN(da5, (Val(&i:&j) * Val(&i+2:&j) * Val(&i+1:&j))  )       
      Endif
    proximo
     
    * capital promedio
    ACN(Val(zz1):&j  , Val(da2) )
    * tasa
    if Dialogo.Radio8 = 0
      ACN(Val(zz1)+1:&j, Val(da4) / Val(da2) )    
    else
      ACN(Val(zz1)+1:&j, Val(da5) / Val(da3) )    
    endif
    * plazo
    ACN(Val(zz1)+2:&j, Val(da3) / Val(da2) )    
  Endif
Proximo

* Impresion
ACO(3,9)
ACO(4,9)
SetFont(d:13..Val(zz1)+2:50,1)   

*---Agregar los marcos---
Recorrer&j 13,47
  If &j<>14 y &j<>17 y &j<>19 y &j<>27 y &j<>33 y &j<>35 y &j<>42 
    AgregarMarco(4:&j..Val(zz1)+2:&j,1,3,0)
  Endif
Proximo

SetFilaActual(50)
Impresion(1,2)
LimitesVision(val(zz1)+6:fac+2)



