CrearDialogo     
    Fecha1         :'Fecha :'             ;;;;NO;;;;;FSYS     
    Check1:        'TEST DE PROCESO'      ;;;;NO;NO;  
FinDialogo
    
If Not Ok     
    Cancelar  
EndIf 
   
**** El proceso de CIERRE se ejecuta solo si la Variable INTASIENTO esta en NO (Proceso SAP no Operativo)   
IF Eqstr(Var('INTASIENTO'), 'SI')      
    MESSAGEbOX ('Se esta ejecutando el proceso contable con SAP...Por favor intente en unos minutos',2,0)         
    Cancelar  
ELSE      

    SQL.ADD(" Update "~DBO~".VARIABLES Set Valor='NO' Where Codigo='ABIERTO' ")      
    SQL.NEW     
    SQL.EXEC  

ENDIF    

 *- Reseteo de Tasas Estimadas  
 ***---EjecutarEvento('REPTAF',Radio1=1,Entero1=2,Fecha1=Dialogo.Fecha1,NrOperacion1='',Radio2=0,Radio3=1,Lista2='',Lista1='')    
 
 ***---Interface Bloomberg Cotizaciones BNA  
 EjecutarEvento('ACTBNA')   
 
 ***/// Procesa Descubiertos Automaticos  
 EjecutarEvento('DESAUT', Fecha1=Dialogo.Fecha1, Cuenta1='', Check1=1)    

 ***/// Actualiza movimientos para las MMDPAC que tengan saldos procesados para el dia  
 EjecutarEvento('ACTDES', Fecha1=Dialogo.Fecha1)    

 ***---Genera Contabilidad automatica para los dias anteriores con MMDC generadas automaticamente hoy  
 SQL.ADD(" Select FechaVto, NrOperacion From "~DBO~".OPERACIONES ")  
 SQL.ADD(" Where TipoOp = 'MMDC' ")
 SQL.ADD(" AND FechaCargaSys = '"~IdxDate(Dialogo.Fecha1)~"' ")
 SQL.ADD(" AND FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' ")  
 SQL.ADD(" Order By FechaVto, NrOperacion ") 
 
 Recorrer SQL    
     ***---Anulacion de Asientos    
     EjecutarEvento('ANUASI', Fecha1=FBN('FechaVto'), Fecha2=FBN('FechaVto'), Lista2='', Lista1='', ListaTabla1=FBN('NrOperacion'))     
     ***---Asientos de Devengados de Descubiertos     
     EjecutarEvento('CONT32', Fecha1=FBN('FechaVto'), Lista1='', ListaTabla1=FBN('NrOperacion'), TipoOp1='', Check1=1)  
 Proximo    

 ***---IF FinDeMes(Dialogo.Fecha1, NO, 'ARG') = Dialogo.Fecha1  
 ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))  

 if Val(x1)=1     
    ACN(x1, Trunc(Var('DIASCONT'),0)) 
 endif 
 
 if Val(x1)<1    
    ACN(x1, 1)  
 endif  
 
 ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG')) 
 ACD(x3, PriDeMes(Dialogo.Fecha1,SI)-1)
 ACD(x4, PriDeMes(Val(x3),SI))
 
 if Dialogo.Fecha1=Val(x2)     
    ***---Regenero Posiciones del mes    
    EjecutarEvento('REGEPO', Fecha1=Val(x4), Vehiculo1='', Especie1='', String1='')  
 EndIf    
 
 *-Tengo que saber si la fecha del dialogo son los dias del mes de la variable (DIASCONT)  
 if Dialogo.Fecha1=Val(x2)      
    ***---Fin de Mes, del mes anterior, de Lunes a Viernes aunque sea feriado => Reseteo los Precios en Posiciones2      
    If DiaSem(PriDeMes(Dialogo.Fecha1,SI)-1) = 1         
        *-Domingo         
        ACD(FE:1,PriDeMes(Dialogo.Fecha1,SI)-3)      
    ELSE         
        If DiaSem(PriDeMes(Dialogo.Fecha1,SI)-1) = 7           
            *-Sabado           
            ACD(FE:1,PriDeMes(Dialogo.Fecha1,SI)-2)        
        Else            
            ACD(FE:1,PriDeMes(Dialogo.Fecha1,SI)-1)         
        EndIf      
    EndIf      
    EjecutarEvento('RESET3', Fecha1=val(FE:1), Vehiculo1='', Book1='', Especie1='', Radio1=0)  
 endif    
 
 ***---Generacion de Asientos Contables  
 EjecutarEvento('CONT0', Fecha1=Dialogo.Fecha1, Lista1='')    
 
 ***---Reseteo Anual de Precios  
 ACT(y1, 'Fin de Mes')
 ACT(y2, 'OK')
 ACT(y4, 'Mes Inicio')
 ACT(y5, 'Mes Cierre')
 
 * Fin de mes del mes actual  
 ACD(z:1, FinDeMes(Dialogo.Fecha1,NO,'ARG'))    
 ACT(z:2, 'SI')  
 
 if Val(z:1)<>Dialogo.Fecha1     
    * La fecha no es fin de mes    
    ACT(z:2, 'NO')  
 endif    
 
 IF EqStr(Val(z:2),'SI')    
    ACN(z:4, 0)    
    ACN(z:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))    
    
    if Val(z:4)=0      
        ACN(z:5, 12)    
    else      
        ACN(z:5, VAR('MESINIEJE')-1)    
    endif    
 
    if Val(z:5)<1 or Val(z:5)>12      
        ACN(z:5, 12)    
    endif    
 
    if Mes(Dialogo.Fecha1)<>Val(z:5)      
        * El mes no es el ultimo del ejercicio     
        ACT(z:2, 'NO')    
    endif  
 endif    
 
 if EqStr(Val(z:2),'SI')    
    EjecutarEvento('RESET1', Fecha1=Dialogo.Fecha1, Especie1='', Check1=1)  
 endif      
 
 ***---Intereses Corridos para los proximos 3 dias, pero solo de lunes a viernes  
 ACN(DS:1, DiaSem(Dialogo.Fecha1))  
 
 IF Val(DS:1) = 2 o Val(DS:1) = 3     
    ***---Lunes o Martes     
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+1, Especie1='')     
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+2, Especie1='')      
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+3, Especie1='')     
    ***---Copiar Posiciones Inicio del dia siguiente      
    EjecutarEvento('COPPOS', Fecha1=Dialogo.Fecha1+1, Especie1='')  
 ELSE      
    IF Val(DS:1) = 4          
    ***---Miercoles          
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+1, Especie1='')          
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+2, Especie1='')         
    EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+5, Especie1='')         
    ***---Copiar Posiciones Inicio del dia siguiente          
    EjecutarEvento('COPPOS', Fecha1=Dialogo.Fecha1+1, Especie1='')     
    ELSE          
        IF Val(DS:1) = 5              
            ***---Jueves              
            EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+1, Especie1='')              
            EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+4, Especie1='')              
            EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+5, Especie1='')              
            ***---Copiar Posiciones Inicio del dia siguiente              
            EjecutarEvento('COPPOS', Fecha1=Dialogo.Fecha1+1, Especie1='')          
        ELSE              
            IF Val(DS:1) = 6                  
                ***---Viernes                  
                EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+3, Especie1='')                  
                EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+4, Especie1='')                  
                EjecutarEvento('INT001', Fecha1=Dialogo.Fecha1+5, Especie1='')                  
                ***---Copiar Posiciones Inicio del dia siguiente                  
                EjecutarEvento('COPPOS', Fecha1=Dialogo.Fecha1+3, Especie1='')              
            ENDIF          
        ENDIF      
    ENDIF  
 ENDIF      
 
 ***---Recalculo Precios MovPosPen de Monedas  
 EjecutarEvento('RPREMM', Fecha1=Dialogo.Fecha1, Check1=1)    
 
 ***---Vencimiento de Cupones  
 LinkearHoja('VTOCUP', 1, Fecha1=Dialogo.Fecha1, Radio1=2)    
 
 ***---Movimientos pendientes de liquidar  
 LinkearHoja('ALIQUI', 2, Cliente1='', Especie1='', Vehiculo1='', Fecha1=Fsys, Check1=1, Lista1='')    
 
 HojaVisible(NO)  