SQL.ADD("Select S.Especie, E.Nombre, S.Mercado, S.Saldo as VN, ")
*SQL.ADD(" (Select Top(1) Precio1 From "~DBO~".COTIZACIONES C Where Codigo = S.Especie AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) as PrecioARP ")
SQL.ADD(" (Select Top(1) PrecioContable From "~DBO~".COTIZACIONES C Where Codigo = S.Especie AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) as PrecioARP ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E where S.Especie=E.Codigo  ")
SQL.ADD("and  Cuenta in (select Codigo from "~DBO~".CUENTAS where Comitente='"~VAR('VEHICULODE')~"' and TipoCuenta = 'CUS' and Cliente = '"~Dialogo.Cliente1~"') ")
SQL.ADD("and S.Fecha = (select Top(1) Fecha from SALDOSDIA S1 Where S1.Cuenta=S.Cuenta and Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' Order By Fecha Desc) ")
SQL.ADD("and E.Jerarquia like '"~VAR('JERTITULOS')~"%' ")
SQL.ADD("and NrSaldo in ('101','207') ")
watch(sql.batch)

ACN(fi1,fac)
ACN(xy1,0)
Recorrer SQL
   if Val(xy1)=0
      ACT(a:fac, "BONOS")
      SetFont(a:fac, 3)
      ACN(fi1,fac)
      ifa
      ACT(a:fac,'Especie')
      ACT(b:fac,'Nombre')
      ACT(c:fac,'Custodia')
      ACT(d:fac,'V.N.')
      ACT(e:fac,'Precio')
      ACT(f:fac,'Valor ARP')
      ACT(g:fac,'Valor USD')
      SetFont(a:fac..g:fac, 2)      
      ACN(xy1,1)
      ifa
   endif
   
   ACT(a:fac,FBN['Especie'])
   ACT(b:fac,FBN['Nombre'])
   ACT(c:fac,FBN['Mercado']) 
   ACT(d:fac,PYC(FBN['VN'], 0, 2))
   ACT(e:fac,PYC(FBN['PrecioARP'], 0, 5))
   ACT(f:fac,PYC((FBN['VN']*FBN['PrecioARP']), 0, 2))
   ACT(g:fac,PYC(((FBN['VN']*FBN['PrecioARP'])/Val(co1)), 0, 2))
   
Proximo
