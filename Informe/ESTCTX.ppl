      ifa
      ACT(a:fac,'Fecha Op.')
      ACT(b:fac,'Fecha Liq.')
      ACT(c:fac,'Tipo Op.')
      ACT(d:fac,'Especie')
      ACT(e:fac,'Moneda')
      ACT(f:fac,'V.N.') 
      ACT(g:fac,'Precio')
      ACT(h:fac,'Monto Bruto')
      ACT(i:fac,'Comisiones')
      ACT(j:fac,'I.V.A.')
      ACT(k:fac,'Monto Neto')
      ACT(l:fac,'Nro.Op.')
      ACT(m:fac,'Saldo Final')

      SetFont(a:fac..m:fac, 2)      
      ACN(xy1,1)
      ifa
   endif
   
   ACT(a:fac,FBN['FechaOp'])
   ACT(b:fac,FBN['FechaVto'])
   ACT(c:fac,FBN['TipoOper']) 
   ACT(d:fac,FBN['Especie'])
   ACT(e:fac,FBN['ContraEspecie'])
   ACT(f:fac,PYC(FBN['Cantidad'], 0, 2))
