HOJAVISIBLE(SI)
CrearDialogo
  Cliente1    : "Cliente"         ;;;;;;NoVacio(Dialogo.Cliente1);'Ingrese un Cliente';;;
  Fecha1      :'Fecha Desde'      ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 <= Fsys;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      :'Fecha Hasta'      ;;;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1 y Dialogo.Fecha2 <= Fsys;'Debe Ingresar una Fecha Hasta valida';NO;FSys
  Radio1      : "|Pantalla|PDF"   ;;;;;;;;;1;;;;;
FinDialogo

If Not Ok
  Cancelar
Endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,8,BI')
 
act(cu:1,'Dialogo.Cliente1')
act(ar:1,VAR('PATHCONFI')~'Estado_Cliente_'~Val(cu:1)~'.pdf')


let &lugarFecha "Buenos Aires "~Fecha(FSYS)

ACN(co1,CotizacionC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))
ACN(co2,CotizacionC(VAR('MONEEXTR'),,,,Dialogo.Fecha2,25,SI,VAR('MONELOCA')))

** Caratula

SQL.ADD("Select RazonSocial,CUIT,CodComitente as Depositante ")
SQL.ADD("FROM "~DBO~".CLIENTES  ")
SQL.ADD("Where Codigo = '"~Dialogo.Cliente1~"' ")
watch(sql.batch)

Recorrer SQL
   ACT(aa1,FBN['RazonSocial'])
   ACT(aa2,FBN['Depositante'])
   ACT(aa3,FBN['CUIT'])   
Proximo


ACT(aa4, FECHA(Dialogo.Fecha1))
ACT(aa5, FECHA(Dialogo.Fecha2 ))
ACT(aa6, FECHA(FSYS))

SQL.ADD("Select RazonSocial,Direccion,CodigoPostal,Localidad, ")
SQL.ADD(" P.Nombre as Pais, Telefono, Fax ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".PAISES P ")
SQL.ADD(" Where C.Codigo = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("   and P.Codigo = C.Pais ")
watch(sql.batch)

Recorrer SQL
   ACT(aa7,FBN['RazonSocial'])
   ACT(aa8,FBN['Direccion'])
   ACT(aa9,FBN['CodigoPostal'])
   ACT(aa10,FBN['Localidad'])   
   ACT(aa11,FBN['Pais'])   
   ACT(aa12,'T '~FBN['Telefono'])   
   ACT(aa13,'F '~FBN['Fax']) 
Proximo

