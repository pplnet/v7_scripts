SQL.ADD("Select FechaOp, FechaVto, Especie, ContraEspecie, Cantidad, Precio1, TotalBrutoCli1, Comision, TotalIVA, TotalNetoCli1, NrOperacion, ")
SQL.ADD("  Case When TipoOp = 'TIC' then 'Venta' else 'Compra' end TipoOper, TotalNetoCli1 as SaldoFinal ")
SQL.ADD(" from dbo.OPERACIONES O, dbo.ESPECIES E where O.Especie=E.Codigo  ")
SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and TipoOp in ('TIC','TIV') ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and E.Jerarquia like '"~VAR('JERTITULOS')~"%' ")

