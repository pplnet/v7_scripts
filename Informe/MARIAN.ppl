CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1 ;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2 ;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11=0;FSYS;
@VEHITO
Operador        :                              ;  ;2;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Entidad'                    ;4 ;1;;NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;TotalIntereses=TotalIntereses; TotalIntereses=TotalIntereses;
Observac2       : 'Op.Contraparte'             ;4 ;2;;;;NOVACIO(OBSERVAC2);'El Operador CONTRAPARTE es INVALIDO';NO;;;
Especie         : 'Moneda'                     ;6 ;1;;NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda ';NO;;;;LeerObjeto('Monedas')
Cantidad        : 'Valor Nominal'              ;  ;;;NOT EV;;CANTIDAD>0;'El Valor Nominal DEBE SER POSITIVO';NO;;;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;6 ;2;;;;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
Plazo           : 'Plazo'                      ;  ;2;;;;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
Spread          :                              ;  ;2;;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
FechaVto        : 'Fecha_Vto'                  ;9 ;2;;NO;;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11=0;;FECHAOP+PLAZO
Precio1         : 'Tasa (%)'                   ;8 ;1;;;;PRECIO1>0;'La Tasa Debe ser positiva';NO;;;;;;;'###,###.######'
TotalIntereses  : 'Interes'                    ;9 ;1;;EV;;NOT EV o [TotalIntereses <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000),0),CANTIDAD*(PRECIO1+SPREAD)*PLAZO/IF(RB8=1,36500,36000));;;;;'###,###,###,###,###.##'
TotalNetoCli2   : 'Int_Neto'                   ;10;1;;NO;;;;;;TOTALINTERESES-TOTALRETENCIONES;;;;;'###,###,###,###,###.##'
TotalBrutoCli1  : 'Monto'                      ;11;1;;NO;;;;;;CANTIDAD+TOTALINTERESES;;;;;'###,###,###,###,###.##'
TotalNetoCli1   : 'Monto_Neto'                 ;12;1;;NO;;;;;;TOTALBRUTOCLI1-TOTALRETENCIONES;;;;;'###,###,###,###,###.##'
ImpGastos1      : 'Alicuota Imp.'              ;14;1;;DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;VAR('ALICIMPU');IF(MODI,IMPGASTOS1,IF(EqStr(VAR('MONELOCA'),ESPECIE),VAR('ALICIMPU'),0))
TotalRetenciones: 'Imp.Impuesto'               ;15;1;;EV;DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EV o [TotalRetenciones<= ROUND(VCAN5*(1+Var('PORVAR')/100),2) y TotalRetenciones >= ROUND(VCAN5*(1-Var('PORVAR')/100),2)];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(VCAN5*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN5*(1+Var('PORVAR')/100),2),0,2);NO;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),TOTALINTERESES*IMPGASTOS1/100,0);;;;;'###,###,###,###,###.##'
ImpGastos2      : 'Tasa IVA'                   ;14;1;;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));;;;VAR('TASAIVA');;;;;;'###,###.######'
TotalAux1       : 'Imp_IVA'                    ;15;1;;EV;NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EV o [TotalAux1<= ROUND(VCAN8*(1+Var('PORVAR')/100),2) y TotalAux1 >= ROUND(VCAN8*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~FSTR(ROUND(VCAN8*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN8*(1+Var('PORVAR')/100),2),0,2);NO;0;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),(TOTALINTERESES*IMPGASTOS2)/100,0);;;;;'###,###,###,###,###.##'

DeltaTasa       : '%Imp.DB/CR'                 ;  ; ;;;;[Incluido(Fstr(DELTATASA,2,2),VAR('IMPCHEQUE'))];'El Valor de TASA Impuesto CHEQUE Es Erroneo: '~VAR('IMPCHEQUE')~' ...';NO;0;;;;;;'###,###.######'
PeriodoInts     : 'Imp.DB/CR'                  ;  ; ;;EV;;NOT EV o [PERIODOINTS   <= ROUND(VPRE3*(1+Var('PORVAR')/100),2) y PERIODOINTS>= ROUND(VPRE3*(1-Var('PORVAR')/100),2)];'Impuesto al Cheque CR Fuera de Rango: '~FSTR(ROUND(VPRE3*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VPRE3*(1+Var('PORVAR')/100),2),0,2);NO;;CANTIDAD*(DELTATASA/100);;;;;'###,###,###,###,###.##'
