Cuenta4 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito A','Debito  En')  ;19;1;2;;;[CLIENTECUENTA(VEHICULO1,CUENTA4) y ESPECIECUENTA(ESPECIE,CUENTA4) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA4),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA4),'SUS')] y NOVACIO(CUENTA4);"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito A','Debito  En')~"' "~ESPECIE;SI;CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'SUS');CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'SUS');;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null)  and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT15,Elementos(VTXT15))~"%')"     
Cuenta5 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  En','Credito A')  ;19;2;2;NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE);Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA5) y [[CLIENTECUENTA(VEHICULO1,CUENTA5) y ESPECIECUENTA(CONTRAESPECIE,CUENTA5) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA5),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA5),'SUS')]]];"Error en Cuenta de '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito  En','Credito A')~"' "~CONTRAESPECIE;SI;CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'SUS');CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'SUS');;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null)  and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT16,Elementos(VTXT16))~"%')"     
