Cuenta1 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')       ;18;1;2;;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA1),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA1),'SUS')] y NOVACIO(CUENTA1);"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Debito en','Credito a')~"' "~ESPECIE;SI;CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'SUS');CUENTACLIENTE(VEHICULO1,ESPECIE,CLIENTE1,,TIPOOP,'SUS');;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null) and (Especies Like '%"~Especie~"%' or Especies Like '%"~ItemLista(VTXT11,Elementos(VTXT11))~"%')"     
Cuenta2 : If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')       ;18;2;2;NoVacio(CONTRAESPECIE);NoVacio(CONTRAESPECIE);Vacio(CONTRAESPECIE) o [NOVACIO(CUENTA2) y [[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqSTr(BuscarCampo('CUENTAS','Numero','Codigo',CUENTA2),'') y EqSTr(BuscarCampo('CUENTAS','Estado','Codigo',CUENTA2),'SUS')]]];"Error en Cuenta '"~If(Incluido(TIPOOP,EXE('CARTA1V')),'Credito a','Debito en')~"' "~CONTRAESPECIE;SI;CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'SUS');CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,CLIENTE1,,TIPOOP,'SUS');;;;;;"Cliente='"~VEHICULO1~"' and Estado = 'SUS' and (Numero='' or Numero Is Null)  and (Especies Like '%"~ContraEspecie~"%' or Especies Like '%"~ItemLista(VTXT12,Elementos(VTXT12))~"%')"     
