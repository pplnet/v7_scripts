*Realizo un Query para obtener los datos que me interesan en base a los valores de entrada que recibo
SQL.ADD("Select NrOperacion, FechaOp, Plazo2, FechaVto, Plazo, FechaVto2, Cliente1, Cliente2, RB1, Especie, ContraEspecie, Cantidad, Precio1, TotalIntereses, TotalNetoCli1, TotalNetoCli2 from "~DBO~".OPERACIONES ")
SQL.ADD("Where TipoOp = 'DTODO2'")
SQL.ADD("AND FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("AND FechaVto <='"~IdxDate(Dialogo.Fecha2)~"' ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACD(B:fac, fbn('FechaOp'))
    ACN(PL:2, fbn('Plazo2'))
    ACT(C:fac, Fstr(Val(PL:2), 0, 0))
    ACD(D:fac, fbn('FechaVto'))
    ACN(PL:1, fbn('Plazo'))
    ACT(E:fac, Fstr(Val(PL:1), 0, 0))
    ACD(F:fac, fbn('FechaVto2'))
    ACT(G:fac, fbn('Cliente1'))
    ACT(H:fac, fbn('Cliente2'))
    ACN(RB:1, fbn('RB1'))
    IF Val(RB:1) = 0
        ACT(I:fac, "Compra")
    ELSE
        ACT(I:fac, "Venta")
    ENDIF
    ACT(J:fac, fbn('Especie'))
    ACT(K:fac, fbn('ContraEspecie'))
    ACN(L:fac, fbn('Cantidad'))
    ACN(TA:1, fbn('Precio1'))
    ACT(M:fac, Fstr(Val(TA:1), 0, 8))
    ACN(N:fac, fbn('TotalIntereses'))
    ACN(O:fac, fbn('TotalNetoCli1'))
    ACN(P:fac, fbn('TotalNetoCli2'))
    AgregarMarco(A:fac..P:fac,2,3,Exe('COLOR7'))
