CrearDialogo
  Cliente1  : 'Cliente'
  Especie1  : 'Especie'
  Vehiculo1 : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "));NO
  Fecha1    : 'Fecha';;;;;;;;;FSys
  Check1    : 'Anteriores'
  Lista1    : 'Instancias'  ;1;2;;;;;;;;;SQLSET("Select Nombre from "~DBO~".INSTANCIAS Where Tabla='OPERACIONES' Order By Nombre ")
FinDialogo
If Not OK
   Cancelar
EndIf

SetListaClaves(2)

ACT(a8, 'Fecha: '~Dialogo.Fecha1)

If NoVacio(Dialogo.Lista1)
   ACT(a9, 'Instancias: '~Dialogo.Lista1 )
Else
   ACT(a9, 'Cualquier Instancia')
EndIf

ACT(aa1, '')

SQL.ADD("Select NrInstancia from "~DBO~".INSTANCIAS Where Tabla='OPERACIONES' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and Nombre In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD(" Order By NrInstancia ")

Recorrer Sql
   ACT(aa1, FBN['NrInstancia']~'|'~val(aa1))
Proximo

If NoVacio(UsrVehiculos(UsuarioActivo))
   ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
Else
   ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
EndIf


SQL.ADD(" Select M.FechaMov, M.NrOperacion, M.Cliente, M.Especie, M.EnteCustodia, M.Cantidad, ")
SQL.ADD(" M.Leyenda, O.NrBit ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES M ,"~DBO~".OPERACIONESBITS O where M.NrSaldo=1")
SQL.ADD("and M.NrOperacion=O.NrOperacion and Valor='1' and NrBit In ("~Pipe2Comillas(val(aa1))~") ")
SQL.ADD("and M.EnteCustodia In ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"'")
  ACT(a5, 'Cliente: '~Dialogo.Cliente1)
else
  ACT(a5, 'Cliente: Todos')
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"'")
  ACT(a6, 'Especie: '~Dialogo.Especie1)
else
  ACT(a6, 'Especie: Todas')
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
   ACT(a7, 'Vehiculo: '~Dialogo.Vehiculo1)
else
   ACT(a7, 'Vehiculo: Todos')
endif
if Dialogo.Check1 = 0
  SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'")
  ACT(a8, Val(a8)~' (No incluye fechas anteriores)')
else
  SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"'")
  ACT(a8, Val(a8)~' (Incluye fechas anteriores)')
endif
SQL.ADD("order by M.FechaMov, M.EnteCustodia")

ACT(a4, 'Movimientos pendientes de liquidar')
ACT(a11, 'Fecha')
ACT(b11, 'Nr.Operacion')
ACT(c11, 'Cliente')
ACT(d11, 'Especie')
ACT(e11, 'Vehiculo')
ACT(f11, 'Cantidad')
ACT(g11, 'Descripcion')
ACT(h11, 'Instancia')

acn(l2,0)
SetFilaActual(11)
Recorrer SQL
  ACT(a:fac, fbn('FechaMov'))  
  ACT(b:fac, fbn('NrOperacion'))  
  ACLO(b:fac, fbn('NrOperacion'))  
  ACT(c:fac, fbn('Cliente'))  
  ACT(d:fac, fbn('Especie'))  
  ACT(e:fac, fbn('EnteCustodia'))  
  ACN(f:fac, -fbn('Cantidad'))  
  ACT(g:fac, fbn('Leyenda'))

  ACT(h:fac,SQL("Select Nombre from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and NrInstancia ='"~FBN['NrBit']~"' ") )

Proximo

Ifa

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z11, 1)
SetFont(a12..z:fac, 2)
AgregarMarco(a11..h11,1,0, Exe('COLOR'))
ACO(2, 10)
ACO(7, 20)
ACO(8, 20)
FormatoCeldas(f1..f:fac, Exe('F2'))
LimitesVision(h:fac)
