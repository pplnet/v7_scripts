**Cintia 240624 
(.'BOOKPARTID'.)
Recorrer SQL
    DFA
    let &BValuaPartida &BValuaPartida~'|'~fbn('Books')
Proximo
**

SetFilaActual(FAC)
SQL.ADD(" Select * from ")
SQL.ADD(" (SELECT Distinct O.*, T.Nombre, C.RazonSocial, E.TamanioLote, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg, E.Cotiza, ")
SQL.ADD(" CASE WHEN O.TipoOp IN ('TICT','TIDE','TICO','TIPO') THEN O.Precio4 ELSE O.Precio1 END PrecioOp, ")
SQL.ADD(" O.PorDerechoMercado as PrecioOpEnARP ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, ")
SQL.ADD(" "~DBO~".TIPOSOPERACION T, "~DBO~".ESPECIES E, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND   O.Especie  = E.Codigo ")
SQL.ADD(" AND   O.Cliente1 = C.Codigo ")
SQL.ADD(" AND   O.TipoOp   = T.Codigo ")
**-----Cintia 240624
**Casos en los cuales levantará las op (No debe mostrarlas los dias que tienen book de investment)
**Caso1 BookActual es TRADING y (el reporte se tira para la fecha del cambio (o posterior) OR no hubo cambio de book OR La op se cargó el mismo dia del cambio (para casos fecha valor))
SQL.ADD(" AND ((O.Book1 not IN ("~Pipe2Comillas(&BValuaPartida)~") and ('"~IdxDate(Dialogo.Fecha1)~"'>=O.FechaCambioBook or O.FechaCambioBook is null or O.FechaCargaSys=O.FechaCambioBook))")
**Caso2 BookAnterior es TRADING y (el reporte se tira para una fecha anterior al cambio de book y la op no es a fechaValor)
SQL.ADD(" OR (O.BookAnterior not IN ("~Pipe2Comillas(&BValuaPartida)~") and ('"~IdxDate(Dialogo.Fecha1)~"'<O.FechaCambioBook and O.FechaCargaSys=O.FechaOp)) OR ")
**Caso3 BookAnterior es TRADING pero bookActual tambien es TRADING
SQL.ADD(" (O.Book1 not IN ("~Pipe2Comillas(&BValuaPartida)~") and O.BookAnterior not IN ("~Pipe2Comillas(&BValuaPartida)~")))")
***---
**
IF NoVacio(Dialogo.NrOperacion)
    SQL.ADD("and O.NrOperacion = '"~Dialogo.NrOperacion~"' ")
Else
    IF NoVacio(Dialogo.Cliente1)
        SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
    ENDIF
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD("and O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    Else
        SQL.ADD("and O.TipoOp in ('TIC','TIV','TICO','TICT','TIDE','TIPO','TIPA','TIPO')")
    ENDIF
ENDIF
SQL.ADD("and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and B.NrOperacion = O.NrOperacion ")
SQL.ADD("and B.Valor = '1' ")
SQL.ADD("and B.NrBit not in (30,31) ")
SQL.ADD(" ) as Aux")
SQL.ADD("ORDER BY TipoOp, MercNeg, FechaVto, Especie, Cliente1")

recorrer SQL
    IF Not EqStr(FBN['TipoOp']~FBN['MercNeg'], Val(Z2))
       IFA
       AgregarMarco(a:FAC..R:FAC,1,0, Exe('COLOR6'))
       ACT(a:FAC, FBN['TipoOp'])
       ACT(b:fac, fbn("Nombre"))
       ACT(c:fac, 'Mercado')
       ACT(d:fac, FBN['MercNeg'])
       message(Val(a:fac)~' - '~fbn("Nombre"))
       SetFont(a:FAC..R:FAC,2)
       IFA
       ACT(Z2,FBN['TipoOp']~FBN['MercNeg'])
    ENDIF

    message(fbn('NrOperacion'))
    ACT(A:FAC, FBN['FechaVto'])
    ACT(B:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
    ACT(C:FAC, FBN['MercNeg'])
    ACT(D:FAC, Copy(fbn('RazonSocial'),1,25))

    **Operaciones con Revaluo
    **TIC,TIV, TICO,TICT,TIDE,TIPO,TIPA,TIPO
    IF Incluido(FBN['TipoOp'],'TIDE|TICT|')
       ACN(E:FAC, FBN['Cantidad'])
    ELSE
       ACN(E:FAC, FBN['Cantidad']*(-1))
    ENDIF
*    IF Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICT|TICO') 
*       ACN(F:fac, FBN['Precio1'])
*    ENDIF    
    IF Incluido(FBN['TipoOp'],'TIDE|TICT|')
        ACN(z5, -1)
    else
        ACN(z5, 1)
    endif
*    IF Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICT|TICO') 
*        ACN(G:fac, FBN['TotalIntereses']*Val(z:5))
*    endif
    IF Not Incluido(FBN['TipoOp'],'TIDE|TIPO|TICT|TICO') 
        ACN(F:fac, FBN['Precio1'])
    ENDIF
    
    ACT(G:FAC, FBN['Contraespecie'])

    ACN(H:fac, FBN['TotalBrutoCli1']*Val(z:5))

    ACN(I:FAC, 0)
    
    If Incluido(FBN['TipoOp'],'TIC|TIFC|TIFV|TIPA|TIPP|TIV|')
       ACN(J:FAC, FBN['TotalComisiones'])
    EndIf
    ACN(J:FAC, Val(J:FAC)*(-1))

    ACN(K:fac, FBN['TotalNetoCli1'])

    ACT(L:FAC, FBN['NrOperacion'])
    ACLO(L:fac, fbn('NrOperacion'))
    ACT(M:FAC, FBN['FechaOp'])
    ACT(N:FAC, FBN['Operador'])
    
    **Revaluo
    let &fechaRevaluo Dialogo.Fecha1
    let &fechaOp fbn('FechaOp')
    let &precioOp fbn('PrecioOp')
    let &especie fbn('Especie')
    let &book fbn('Book1')
    let &cantidad fbn('Cantidad')
    let &monedaDelCotizador fbn('Cotiza')
    let &monedaPrecioOp fbn('ContraEspecie')
    let &monedaDelRevaluo val(ML:1)
    let &plazo fbn('Plazo')
    let &cotiza fbn('Cotiza')   
    let &revalOpVig 'SI'
    let &precioOpEnARP fbn('PrecioOpEnARP')    
    (.'REVALOP'.)
    ACN(O:FAC,&precioOp)
    ACN(P:FAC,&precioAyer)
    ACN(Q:FAC,&precioHoy)
    ACN(R:FAC,&revaluoEnMonReval)
    
    AlinearCeldas(a:FAC..a:FAC,'D')
    AlinearCeldas(M:FAC..M:FAC,'D')
proximo

