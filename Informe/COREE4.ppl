ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1  : 'Desde'          ;1;1;;;;Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI);'La Fecha Desde debe ser un Principio de Mes';NO;;PriDeMes(Fecha('01/01/'~FStr(Anio(Fsys),4,0)), SI)
   Fecha2  : 'Hasta'          ;2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;PriDeMes(FSYS-1,SI)
   Especie1: 'Moneda'         ;;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Radio3  : 'Origen|Todos|Activo|Pasivo';;;;;;;;;0;
   Radio6  : 'Clientes|Todos|Vinculados|Terceros';;;;;;;;;0;
   Lista1  : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-- Datos del encabezado para Activos
*-- aa1: Activos o Pasivos
ACT(aa1,Iif(Dialogo.Radio3=1,'ACTIVOS',Iif(Dialogo.Radio3=2,'PASIVOS','TOTALES')))

ACT(a2, 'EVOLUTIVO '~VAL(aa1)~' TOTALES -Hoja 4-')
ACT(a3, Iif(Dialogo.Radio6=0,'        Clientes TERCEROS y VINCULADOS',Iif(Dialogo.Radio6=2,'        Clientes TERCEROS','        Clientes VINCULADOS')))
SetFont(a2..a3, 3)

ACT(a5, 'Desde: '~Dialogo.Fecha1)
ACT(a6, 'Hasta: '~Dialogo.Fecha2)
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )
SetFont(a4..z7, 2)

SetFilaActual(9)

*-- Para todas las fechas entre la Fecha Valor y la del Sistema
ACT(a:fac,'VEHICULO')

* 1er. Columa de Meses: bb1
ACN(bb1,3)
ACD(bb2,Dialogo.Fecha1)
ACN(bb14,DifMes(Dialogo.Fecha2,Dialogo.Fecha1))

ACN(bb14,DifMeses(Dialogo.Fecha2,Dialogo.Fecha1))

ACN(bb10,0)

Recorrer&j 1,DifMeses(Dialogo.Fecha2,Dialogo.Fecha1)
    SetFilaActual(9)

    *- Fila 8->1er. dia del mes
    ACD(val(bb1):fac-1,VAL(bb2))

    ACN(bb5,1) 

    If val(bb14)>1   
       ACN(bb5,DiasM(1,val(val(bb1):fac-1)) )        
    EndIf
    SCN(bb10,val(bb5))    

    If Mes(VAL(bb2))=1
       ACT(val(bb1):fac,'Enero')       
    EndIf
    If Mes(VAL(bb2))=2
       ACT(val(bb1):fac,'Febrero')       
    EndIf
    If Mes(VAL(bb2))=3
       ACT(val(bb1):fac,'Marzo')       
    EndIf
    If Mes(VAL(bb2))=4
       ACT(val(bb1):fac,'Abril')       
    EndIf
    If Mes(VAL(bb2))=5
       ACT(val(bb1):fac,'Mayo')       
    EndIf
    If Mes(VAL(bb2))=6
       ACT(val(bb1):fac,'Junio')       
    EndIf
    If Mes(VAL(bb2))=7
       ACT(val(bb1):fac,'Julio')       
    EndIf
    If Mes(VAL(bb2))=8
       ACT(val(bb1):fac,'Agosto')       
    EndIf
    If Mes(VAL(bb2))=9
       ACT(val(bb1):fac,'Septiembre')       
    EndIf
    If Mes(VAL(bb2))=10
       ACT(val(bb1):fac,'Octubre')       
    EndIf
    If Mes(VAL(bb2))=11
       ACT(val(bb1):fac,'Noviembre')       
    EndIf
    If Mes(VAL(bb2))=12
       ACT(val(bb1):fac,'Diciembre')       
    EndIf

    *--
    *-- Por Cada Mes Obtengo el CORENA para Un Vehiculo/Mes/Moneda y Tipo de Cliente
    SQL.ADD(" SELECT Codigo FROM "~DBO~".VEHICULOS ")
    If NoVacio(val(zz6))
       SQL.ADD(" Where Codigo in ("~Pipe2Comillas(val(zz6))~") ")
    EndIf
    SQL.ADD(" ORDER BY Codigo ")
    *--
    Recorrer SQL  
      ACT(a:fac, fbn('Codigo'))
      ACT(b:fac,'Cap.Prom')
      ACT(b:fac+1,'Tasa')
      Message(val(bb2))
      LinkearHoja('LEEPMG',1,String1='CORENA',Fecha1=VAL(bb2),Especie1=Dialogo.Especie1,Radio6=Dialogo.Radio6,Radio3=0,Lista1=val(a:fac)~'|')
    
      SetFont(a:fac..b:fac+2, 2)
      If Dialogo.Radio3=1
         * Activos
         ACN(val(bb1):fac  , LinkH(1, b11))
         ACN(val(bb1):fac+1, LinkH(1, c11))
      Else
         * Pasivos
         ACN(val(bb1):fac  , LinkH(1, d11))
         ACN(val(bb1):fac+1, LinkH(1, e11))
      EndIf

      *CerrarHoja('LEEPMG',1,String1='CORENA',Fecha1=VAL(bb2),Especie1=Dialogo.Especie1,Radio6=Dialogo.Radio6,Radio3=0,Lista1=val(a:fac)~'|')
      *CerrarLink(1)

      ** Capital*Tasa*Plazo
      ACN(val(bb1):fac+2, VAL(val(bb1):fac)*VAL(val(bb1):fac+1)*val(bb5))             

      SetFont(val(bb1):fac..val(bb1):fac+2, 2)
      SetFilaActual(fac+2)
    Proximo

    *----
    Recorrer&i 1,35
      ACD(bb3,PrideMes(HABILES(val(bb2),&i,'ARG',SI),SI))    
      If Mes(val(bb3))>Mes(val(bb2))
         ACD(bb2,Val(bb3))  
         Break
      EndIf
    Proximo

    ACO(val(bb1),9)
    SCN(bb1,1)
Proximo

AgregarMarco(a:9..val(bb1):9,1,0,EXE('COLOR'))
SetFont(a:9..val(bb1):9, 2)

*-- Calculo los Totales para Las Empresas
ACT(val(bb1):9,'Total')       

*-- Calculo los Totales para Los Meses
* bb4: Cantidad de Vehiculos

ACN(bb4,0)
ACT(a:fac+2,'CONSOLIDADO')      
ACT(b:fac+2,'Cap.Prom')      
ACT(b:fac+3,'Tasa')      

Recorrer&i 10,fac  
   Message('Calculando Totales por Vehiculo '~VAL(a:&i))

   If NoVacio(VAL(a:&i)) y EqStr(Val(b:&i),'Cap.Prom')
      *- Acumulo en la Ultima Fila de Totales para sacar el Total por Mes
      Recorrer&j 3,Val(bb1)-1
         ACN(bb5,1) 

         If val(bb14)>1          
            ACN(bb5,DiasM(1,val(&j:8)) )               
         EndIf

         SCN(&j:fac+2,VAL(&j:&i))      

         *- En la ultima Columna Calculo Capital*Plazo
         SCN(val(bb1)+1:&i,VAL(&j:&i)*val(bb5))      
      Proximo

      SCN(bb4,1)
   EndIf

   If EqStr(Val(b:&i),'Tasa')

      *-- Tasa: Cap*Tasa*Plazo/Cap*Plazo
      ACN(val(bb1):&i,SUM(c:&i+1..val(bb1)-1:&i+1))
      ACN(val(bb1):&i,val(val(bb1):&i)/val(val(bb1)+1:&i-1))

      *-- Capital: Cap*Plazo/Sum Plazo
      ACN(val(bb1):&i-1,val(val(bb1)+1:&i-1)/val(bb10))

      *-- Calculo para La ultima columna Cap*Tasa 
      ACN(val(bb1):&i+1,val(val(bb1):&i-1)*val(val(bb1):&i))          

      * Conjuncion de Total y Consolidado
      SCN(val(bb1):fac+2,VAL(val(bb1):&i-1) ) 
                  
      *- Acumulo en la Ultima Fila de Totales para sacar el Total por Mes
      Recorrer&j 3,Val(bb1)
         SCN(&j:fac+3,VAL(&j:&i)*VAL(&j:&i-1))      
      Proximo
   EndIf
   If Vacio(Val(b:&i)) y Vacio(Val(a:&i))
      BorrarCeldas(a:&i ..val(bb1):&i)
   EndIf
Proximo
AgregarMarco(val(bb1):10..val(bb1):fac+3,1,0)

ACT(b:fac+2,'Cap.Prom')      
ACT(b:fac+3,'Tasa')      
AgregarMarco(a:fac+2..val(bb1):fac+3,1,0)

*- Acumulo en la Ultima Fila de Totales para sacar el Total por Mes
Recorrer&j 3,Val(bb1)
   ACN(&j:fac+3,VAL(&j:fac+3)/VAL(&j:fac+2))      
Proximo

BorrarCeldas(a:8 ..val(bb1):8)

SetFont(a:9..val(bb1):fac+3,2)
ACO(1,12)
ACO(val(bb1),9)

SetFilaActual(FAC+5)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)

LimitesVision(val(bb1):fac)
Impresion(1,2)



