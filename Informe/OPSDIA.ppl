CrearDialogo
  Fecha1 : 'F.Desde';;;;;;;;;FSys-60
  Fecha2 : 'F.Hasta';;;;;;;;;FSys
  Operador : 
FinDialogo

if not Ok
  Cancelar
endif

ACT(a1, 'Cantidad de Operaciones por Dia')
ACT(a2, 'D.Fecha : '~Dialogo.Fecha1)
ACT(a3, 'H.Fecha : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Operador)
  ACT(a4, 'Operador : '~Dialogo.Operador)
else
  ACT(a4, 'Operador : Todos')
endif

ACT(a6, 'Fecha')
ACT(b6, 'Cantidad')
SetFilaActual(6)
AgregarMarco(a6..b6,2,0,Exe('COLOR'))

SQL.ADD("Select FechaOp from "~DBO~".OPERACIONES where TipoOp in ('TIC','TIV','TIPA','TIPP','TIFC','TIFV')")
SQL.ADD("and FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
if NoVacio(Dialogo.Operador)
  SQL.ADD("and Operador = '"~Dialogo.Operador~"'")
endif
SQL.ADD("order by FechaOp")
recorrer SQL
  dfa
  if Val(z1) < fbn('FechaOp')
    ifa
    ACN(z1, fbn('FechaOp'))
    ACD(a:fac, fbn('FechaOp'))
  endif
  SCN(b:fac, 1)
proximo
ACT(a:fac+1, 'Total')
ACN(b:fac+1, Sum(b7..b:fac))
AgregarMarco(a:fac+1..b:fac+1,2,0,Exe('COLOR'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z6,1)
SetFont(a7..z:fac, 2)
SetFont(a:fac+1..z:fac+1, 1)

FormatoCeldas(b6..b:fac+1, Exe('F0'))
LimitesVision(c:fac+2)