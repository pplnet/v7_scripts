CrearDialogo
  Fecha1     : "Fecha"                 ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1,NO,'ARG');'Debe Ingresar una Fecha y debe ser un fin de mes';NO;
  Radio1     : "Tipo|Total|Vinculadas" ;;;;;;;;;0
  Vehiculo1  : "Empresa"               ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
FinDialogo

if Dialogo.Radio1=0
  if Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1, NO, 'ARG')
    if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='PFNEW' and Extension='TODOS/"~Dialogo.Fecha1~"'")=0
      Cancelar('No existe el reporte solicitado')
    else
      LeerPMG('PFNEW', 'TODOS/'~Dialogo.Fecha1)
    endif
  else
    Cancelar('Debe pedirse para un fin de mes')
  endif
else
  if Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1, NO, 'ARG')
    if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='PFNEW' and Extension='"~Dialogo.Vehiculo1~"/"~Dialogo.Fecha1~"'")=0
      Cancelar('No existe el reporte solicitado')
    else
      LeerPMG('PFNEW', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
    endif
  else
    Cancelar('Debe pedirse para un fin de mes')
  endif
endif
Impresion(1,2)
LimitesVision(val(b:200)+2:130)
