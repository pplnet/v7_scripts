CrearDialogo
  NrOperacion1: 'NrOperacion';1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.Nroperacion1),'MMONM|MMPCCM|MMPCLM|MMPOSM');'Tipo de Operacion invalido';NO;
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,'Arial,9,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Arial,8,B')

SetFilaActual(2)
***Guardo la fila inicial***
ACN(ce:1,fac)

***Titulos***
ACT(a:fac, 'Periodo')
ACT(b:fac, 'Fecha Reset')
ACT(c:fac, 'Fecha Pago')
ACT(d:fac, 'Capital Remanente')
ACT(e:fac, 'Amort.')
ACT(g:fac, 'Tasa Badlar BP prom. 5 días hábiles anteriores')
ACT(i:fac, 'Spread')
ACT(j:fac, 'Tasa Final')
ACT(k:fac, 'Dias')
ACT(l:fac, 'Intereses')
ACT(m:fac, 'Pagos')
AlinearCeldas(a:fac..m:fac,'C')
SetFont(a:fac..m:fac,1)
AgregarMarco(a:fac..m:fac,1,0,EXE('COLOR'))

***Consulta de las cuotas de la operacion***
SQL.ADD(" Select C.NrCuota, C.Fecha1 FechaIni, C.Fecha2 FechaReset, C.Fecha3 FechaPago, C.Cantidad2 Remanente, C.Cantidad4 Amort, C.Precio2 Interes, C.Precio4 Spread ")
SQL.ADD(" From "~DBO~".CUOTAS C")
SQL.ADD(" where C.NrOperacion = '"~Dialogo.NrOperacion1~"' ")

Recorrer SQL
  ACT(a:fac,fbn('NrCuota'))
  ACD(b:fac,fbn('FechaReset'))
  ACD(c:fac,fbn('FechaPago'))
  ACN(d:fac,fbn('Remanente'))
  ACN(e:fac,fbn('Amort'))
  ACN(i:fac,fbn('Spread'))
  If EqStr(SQL("Select TipoTasa From "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' "),'FIJA')
  Endif
  ACN(k:fac,fbn('FechaReset')-fbn('FechaIni'))
Proximo

AlinearCeldas(a:3..c:fac,'C')
SetFont(a:3..m:fac,2)
SetFont(a:3..a:fac,3)
SetFont(c:3..c:fac,3)

***Ajusto el ancho de las columnas***
ACO(1,7)
ACO(2,9)
ACO(3,9)
ACO(4,12)
ACO(5,12)
ACO(6,9)
ACO(7,8)
ACO(8,8)
ACO(12,9)
ACO(13,9)