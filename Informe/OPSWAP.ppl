*- Dada una Operacion de mm verifica si tiene swap asociados, 
*- nc1: Capital Original nc2: Capital Swapeado
*- id1: Interes Devengado Original  id2: Interes Devengado Swapeado
*- na1: Cap.Amortizado Original na2: Capital Amortizado Swap
HojaVisible(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1      : "Fecha Vigencia"    ;1;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  NrOperacion1: "Operacion"         ; ; ;;;;NoVacio(Dialogo.NrOperacion1);'Error en Nro.Operacion';NO;;;;;;" TipoOp In ('MMONM','MMON','MMSIMV','MMPSI')"
  Fecha2      : "Fecha Desde"       ; ; ;;;;Dialogo.Fecha2<>0;'Fecha Desde Invalida';NO;Fsys; 
  Fecha3      : "Fecha Hasta"       ; ; ;;;;Dialogo.Fecha3<>0 y Dialogo.Fecha3>=Dialogo.Fecha2;'Fecha Hasta Invalida';NO;Fsys; 
FinDialogo

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)

*- Titulos del Informe
ACT(a:fac  ,'Detalle de Operaciones Swapeadas al '~Dialogo.Fecha1~'. Rango='~Dialogo.Fecha2~' '~Dialogo.Fecha3)
SetFont(a:fac..h:fac,2)

Ifa
*- Totales de las cuotas vigentes
ACT(a:fac  ,'Datos Swapeado')
ACT(a:fac+1,'  Capital')
ACT(a:fac+2,'  Int.Dev')
ACT(a:fac+3,'  Imp.Ende.Dev')
ACT(a:fac+4,'  Wht Dev')

SetFont(a:fac..h:fac+4,2)

SetFilaActual(fac+6)
ACN(fi1,fac)
ACT(a:fac,'O P E R A C I O N       O R I G I N A L')
AgregarMarco(a:fac..l:fac,2,0)
SetFont(a:fac..h:fac,2)
ifa
ACT(a:fac,'NrOperacion')
ACT(b:fac,'NrCuota')
ACT(c:fac,'Inicio')
ACT(d:fac,'Vto')
ACT(e:fac,'Imp.Amort')
ACT(f:fac,'V.Residual')
ACT(g:fac,'Interes')
ACT(h:fac,'Int.Deveng.')
ACT(i:fac,'Imp.End ')
ACT(j:fac,'Imp.End Dev')
ACT(k:fac,'WHT ')
ACT(l:fac,'WHT Dev')

AgregarMarco(a:fac..l:fac,2,2)
SetFont(a:fac..l:fac,2)

*- co1: Columna a Listar  mf1: Maxima fila cuando termine de listar uc1: Ultimo Capital uc2: Interes devengado
*- tc1: Tipo de cambio del swap
ACN(mf1,0)
ACN(co1,13)
ACN(uc1,0)
ACN(uc2,0)
ACN(tc1,1)

SQL.ADD("Select O.Vehiculo1,O.NrOperacion,O.FechaOp,O.TipoOp,O.Cliente1,O.Cliente2, O.Especie,O.PrecioEj VResidual,")
SQL.ADD("O.RB8,O.FechaVto,O.FechaVto2,O.TipoTasa,O.PrecioRef,O.Spread ,O.Precio1 Tasa,O.Precio4 TTN, ")
SQL.ADD("O.TotalIntereses,O.TotalNetoCli2 IntNeto,O.TotalBrutoCli1 Monto,O.ImpGastos2 TasaIva,O.TotalIVA ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("O.TotalAux3 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt, ")
SQL.ADD(" 0 ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota  ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD("and TipoOp In ('MMPSI','MMON') ")
SQL.ADD("and O.FechaOp <='"~IdxDate(Dialogo.Fecha3)~"' and O.FechaVto>'"~IdxDate(Dialogo.Fecha2)~"' and O.FechaOp<> '"~IdxDate(Dialogo.Fecha3)~"' ")
SQL.ADD("Union All ")
SQL.ADD("Select O.Vehiculo1,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2, O.Especie,C.Cantidad2 VResidual,")
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaVto2,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Precio3 ImpWH,C.Total1 MontoNeto,C.Tasa3 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad4 ImpAmort,O.Cotizacion1,O.Cantidad,NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and O.TipoOp In ('MMSIMV','MMONM') ")
SQL.ADD("  and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD("  and C.Fecha1 <= '"~IdxDate(Dialogo.Fecha3)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha2)~"' and C.Fecha1<>'"~IdxDate(Dialogo.Fecha3)~"' ")

Recorrer SQL
   *- 
   ACT(a:fac,FBN['NrOperacion'])
   ACLO(a:fac,FBN['NrOperacion'])
   ACN(b:fac,FBN['NrCuota'])
   ACD(c:fac,FBN['FechaOp'])
   ACD(d:fac,FBN['FechaVto'])
   ACN(e:fac,FBN['ImpAmort'])
   ACN(f:fac,FBN['VResidual'])
   ACN(g:fac,FBN['TotalIntereses'])
   
   If FBN['FechaOp']<=Dialogo.Fecha1 y Dialogo.Fecha1<=FBN['FechaVto']
      ACN(h:fac,FBN['VResidual']*((FBN['Spread']+FBN['Tasa'])/100)*FACTORDIAS(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1))
   EndIf

   *- Imp.Interes
   ACN(i:fac,FBN['ImpInt'])
   ACN(j:fac,val(i:fac)*(Dialogo.Fecha1+1-FBN['FechaOp'])/(val(d:fac)-val(c:fac)) )

   *- WHT
   ACN(k:fac,FBN['ImpWH'])
   ACN(l:fac,val(k:fac)*(Dialogo.Fecha1+1-FBN['FechaOp'])/(val(d:fac)-val(c:fac)) )

   If FBN['FechaOp']>Dialogo.Fecha1 
      ACN(h:fac,0)
      ACN(j:fac,0)
      ACN(l:fac,0)
   EndIf

   If FBN['FechaVto']<Dialogo.Fecha1 
      ACN(h:fac,val(g:fac))
      ACN(j:fac,val(i:fac))
      ACN(l:fac,val(k:fac))
   EndIf
   
   SetFont(a:fac..l:fac,1)
   FormatoCeldas(b:fac..b:fac, Exe('F0'))

   *- Verifico las operaciones relacionadas
   SQL.ADD("Select O.FechaOp,O.*,O.Cantidad VResidual,O.Precio3 Tasa,O.Spread Spread1,O.FechaOp2 Fecha1,O.TotalBrutoCli1 Cantidad2,")
   SQL.ADD("O.TotalGanancias Tasa2,O.TotalNetoCli2 Spread2,O.FechaOp2 Fecha5,0 Cantidad6,0 Cantidad5,0 NrCuota,O.FechaOp Fecha2,O.FechaVto Fecha6,O.TipoOp,O.TotalIntereses Cantidad3")
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.OperacionRef='"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and TipoOp In ('DTSFF','DTSFV','DTSVV') ")
   SQL.ADD("Union All ")
   SQL.ADD("Select O.FechaOp,O.*, C.Cantidad1 VResidual,C.Precio1 Tasa,C.Total3 Spread1,C.Fecha1,C.Cantidad2, ")
   SQL.ADD("C.Precio2 Tasa2,C.Total4 Spread2,C.Fecha5,C.Cantidad6,C.Cantidad5,C.NrCuota,C.Fecha2,C.Fecha6,O.TipoOp,C.Cantidad3 ")
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion  ")
   SQL.ADD("and O.OperacionRef = '"~Dialogo.NrOperacion1~"' ")
   SQL.ADD("and TipoOp In ('DTSFFM','DTSFVM','DTSVVM') ")
   SQL.ADD("and C.Fecha1 <='"~IdxDate(Dialogo.Fecha3)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha2)~"' and C.Fecha1<>'"~IdxDate(Dialogo.Fecha3)~"' ")
   SQL.ADD("Order By 1")      

   ACT(no3,'')
   ACN(id2, 0)
   ACN(id3, 0)

   *- fi2: Fila de la Cabecera de la operacion  cc1: Cantidad de Operaciones Relacionadas
   ACN(fi2,fac)
   ACN(cc1,0)

   Recorrer SQL
     If Not EqStr(val(no3),FBN['NrOperacion'])  y NoVacio(val(no3))
        ACN(mf1,IIf(val(mf1)<fac,fac,val(mf1)) )
        SCN(co1,15)     
     EndIf

     If Not EqStr(val(no3),FBN['NrOperacion'])  
        dfa
        *- V.Residual Swap del Primer periodo listado 
        IF Not EqStr(FBN['Especie'],FBN['ContraEspecie'])
           SCN(nc2, FBN['VResidual'])
        EndIf
        ACT(no3,FBN['NrOperacion'])
        SCN(cc1,1)

        ACT(val(co1):val(fi1),' Op. Relacionada '~FBN['NrOperacion']~' Especie: '~FBN['Especie']~' ContraEspecie: '~FBN['ContraEspecie'] )
        AgregarMarco(val(co1):val(fi1)..val(co1)+14:val(fi1),2,0)
        SetFont(val(co1):val(fi1),2)

        ACT(val(co1)  :val(fi1)+1,'NrOperacion')
        ACT(val(co1)+1:val(fi1)+1,'NrCuota')
        ACT(val(co1)+2:val(fi1)+1,'V_Inicio')
        ACT(val(co1)+3:val(fi1)+1,'V_Vto')
        ACT(val(co1)+4:val(fi1)+1,'V_ImpAm')
        ACT(val(co1)+5:val(fi1)+1,'V_VResi')
        ACT(val(co1)+6:val(fi1)+1,'V_Inte')
        ACT(val(co1)+7:val(fi1)+1,'V_IntDev')
        ACT(val(co1)+8:val(fi1)+1,'NrCuota')
        ACT(val(co1)+9:val(fi1)+1,'C_Inicio')
        ACT(val(co1)+10:val(fi1)+1,'C_Vto')
        ACT(val(co1)+11:val(fi1)+1,'C_ImpAm')
        ACT(val(co1)+12:val(fi1)+1,'C_VResi')
        ACT(val(co1)+13:val(fi1)+1,'C_Inte')
        ACT(val(co1)+14:val(fi1)+1,'C_IntDev')

        AgregarMarco(val(co1):val(fi1)+1..val(co1)+14:val(fi1)+1,2,2)
        SetFont(val(co1):val(fi1)+1..val(co1)+14:val(fi1)+1,2)
        SetFilaActual(val(fi2)+1)
     EndIf

     ACT(val(co1):fac,FBN['NrOperacion'])
     ACLO(val(co1):fac,FBN['NrOperacion'])
     ACN(val(co1)+1:fac,FBN['NrCuota'])
     FormatoCeldas(val(co1)+1:fac, Exe('F0'))
     ACD(val(co1)+2:fac,FBN['Fecha1'])
     ACD(val(co1)+3:fac,FBN['Fecha2'])
     ACN(val(co1)+4:fac,FBN['Cantidad6'])
     ACN(val(co1)+5:fac,FBN['VResidual'])
     ACN(val(co1)+6:fac,FBN['Cantidad3'])
   
     If FBN['Fecha1']<=Dialogo.Fecha1 y FBN['Fecha2']>=Dialogo.Fecha1
        ACN(val(co1)+7:fac,FBN['VResidual']*((FBN['Spread1']+FBN['Tasa'])/100)*FACTORDIAS(FBN['Fecha1'],Dialogo.Fecha1+1,FBN['RB8']+1))

        *- Marco la cuota vigente con colores
        AgregarMarco(val(co1):fac..val(co1)+7:fac,2,0,Exe('COLOR6'))

        ACN(uc1,val(val(co1)+5:fac))
        SCN(uc2,val(val(co1)+7:fac))
     EndIf

     If FBN['Fecha1']>Dialogo.Fecha1 
        ACN(val(co1)+7:fac,0)
     EndIf

     If FBN['Fecha2']<Dialogo.Fecha1 
        ACN(val(co1)+7:fac,val(val(co1)+6:fac))
     EndIf

     SetFont(val(co1):fac..val(co1)+13:fac,1)

     ACD(fc1,FBN['Fecha1'])
     ACD(fc2,FBN['Fecha2'])

     ACN(x1,0)

     *- Recupero las cuotas de la contraparte
     SQL.ADD("Select O.FechaOp,O.*, C.Cantidad2, ")
     SQL.ADD("C.Precio2 Tasa2,C.Total4,C.Cantidad4,C.Cantidad5,C.NrCuota,C.Fecha5,C.Fecha6,C.Cantidad1")
     SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
     SQL.ADD("where O.NrOperacion = C.NrOperacion ")
     SQL.ADD("and O.NrOperacion = '"~FBN['NrOperacion']~"' ")
     SQL.ADD("and C.Fecha5 <='"~IdxDate(val(fc2))~"' and C.Fecha6> '"~IdxDate(val(fc1))~"' and C.Fecha5<>'"~IdxDate(Dialogo.Fecha3)~"' ")
     SQL.ADD("and C.Plazo2 >0")
           
     Recorrer SQL          
        ACN(mf1,IIf(val(mf1)<fac,fac,val(mf1)) )
        SCN(x1,1)
        If val(x1)=1
           dfa
        EndIf

        ACN(val(co1)+8:fac ,FBN['NrCuota'])
        FormatoCeldas(val(co1)+8:fac, Exe('F0'))
        ACD(val(co1)+9:fac ,FBN['Fecha5'])
        ACD(val(co1)+10:fac ,FBN['Fecha6'])
        ACN(val(co1)+11:fac,FBN['Cantidad5'])
        ACN(val(co1)+12:fac,FBN['Cantidad2'])
        ACN(val(co1)+13:fac,FBN['Cantidad4'])

        ACD(fd1,FBN['Fecha5'])
        ACD(fd2,FBN['Fecha6'])

        *- Chequeo las fechas del vehiculo respecto de las de la contraparte
        IF val(fc1)>=FBN['Fecha5'] 
           ACD(fd1,val(fc1))
        EndIf

        IF val(fc2)<=FBN['Fecha6']
           ACD(fd2,val(fc2))
        EndIf

        IF val(fc2)>Dialogo.Fecha1+1
           ACD(fd2,Dialogo.Fecha1+1)

           *- Marco la cuota vigente con colores
           AgregarMarco(val(co1)+8:fac..val(co1)+14:fac,2,0,Exe('COLOR6'))
        EndIf

        ACN(val(co1)+14:fac,((FBN['Cantidad2']*(FBN['Tasa2']+FBN['Total4']))/100)*FACTORDIAS(val(fd1),val(fd2),FBN['RB5']+1) )

        If val(fd1)>Dialogo.Fecha1 
           ACN(val(co1)+14:fac,0)
        EndIf

        If EqStr(FBN['Especie'],FBN['ContraEspecie']) y val(fc2)>Dialogo.Fecha1+1
           SCN(uc2,-val(val(co1)+14:fac))
        EndIf

        If Not EqStr(FBN['Especie'],FBN['ContraEspecie']) y val(fc2)>Dialogo.Fecha1+1
           *- Inicializo el Tipo de Cambio del swap
           ACN(tc1,IIF(EqStr(Modo(FBN['Especie'],FBN['ContraEspecie']),'DIR'),FBN['Cantidad2']/FBN['Cantidad1'],FBN['Cantidad1']/FBN['Cantidad2']) )
        EndIf
      
        SetFont(val(co1)+8:fac..val(co1)+14:fac,1)
     Proximo

     *- Fin de listar datos de contraparte
   Proximo 
Proximo
ACN(mf1,IIf(val(mf1)<fac,fac,val(mf1)) )

SetFilaActual(val(mf1))

Ifa

ACT(a:fac,'Totales ....')
SetFont(a:fac,2)

*- Total para la operacion ppal
ACN(e:fac,val(e:val(fi2)))
ACN(f:fac,val(f:val(fi2)))
ACN(g:fac,val(g:val(fi2)))
ACN(h:fac,val(h:val(fi2)))
ACN(i:fac,val(i:val(fi2)))
ACN(j:fac,val(j:val(fi2)))
ACN(k:fac,val(k:val(fi2)))
ACN(l:fac,val(l:val(fi2)))
SetFont(e:fac..l:fac,2)

If val(uc1)=0 
   *- No habia swap relacionados
   ACN(uc1,val(f:fac))
   ACN(uc2,val(h:fac))
EndIf

*- Paso a fila 4 los datos imp.Endeudamiento devengado y WH devengado de la Op.PPal 
*- y capital + int. devengado del ultimo swap
ACN(b:4 ,val(uc1))
ACN(b:4+1,val(uc2))
ACN(b:4+2,val(j:fac)*val(tc1))
ACN(b:4+3,val(l:fac)*val(tc1))

SetFont(b:4..b:4+3,2)


Recorrer&j 1,val(cc1)  
  *- Totales para La Operacion que acabamos de listar 
  ACN(17+(&j-1)*15:fac,Sum(17+(&j-1)*15:val(fi2)..17+(&j-1)*15:fac-1))
  ACN(19+(&j-1)*15:fac,Sum(19+(&j-1)*15:val(fi2)..19+(&j-1)*15:fac-1))
  ACN(20+(&j-1)*15:fac,Sum(20+(&j-1)*15:val(fi2)..20+(&j-1)*15:fac-1))
  ACN(24+(&j-1)*15:fac,Sum(24+(&j-1)*15:val(fi2)..24+(&j-1)*15:fac-1))
  ACN(26+(&j-1)*15:fac,Sum(26+(&j-1)*15:val(fi2)..26+(&j-1)*15:fac-1))
  ACN(27+(&j-1)*15:fac,Sum(27+(&j-1)*15:val(fi2)..27+(&j-1)*15:fac-1))

  *- VR El Ultimo Valor
  Recorrer&i 1,val(fi2)
     If val(18+(&j-1)*15:fac-&i)<>0
        ACN(18+(&j-1)*15:fac, val(18+(&j-1)*15:fac-&i))
        Break
     EndIf
  Proximo

  Recorrer&i 1,val(fi2)
     If val(25+(&j-1)*15:fac-&i)<>0
        ACN(25+(&j-1)*15:fac, val(25+(&j-1)*15:fac-&i))
        Break
     EndIf
  Proximo

  SetFont(17+(&j-1)*15:fac..27+(&j-1)*15:fac,2)
Proximo


Recorrer&i 1,20
 ACO(&i,7)
Proximo

Impresion(1,2)
LimitesVision(27+(val(cc1)-1)*15:fac)
