ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'Vto.Desde';;;;;;;;;FSys
  Fecha2     : 'Vto.Hasta';;;;;;;;;FSYS
  Cliente1   : 'Cliente'  ;
  Especie1   : 'Especie'  ;
  Lista1     : 'Tipos Op.';;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where (Codigo LIKE 'SE%' or Codigo = 'DSEO') and Codigo<>'SEO' ")  
  Lista2     : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo
if not Ok
  Cancelar('')
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

SQL.ADD(" Select Vehiculo1, TipoOp, NrOperacion, FechaOp, FechaVto, Especie, Cliente1, ")
SQL.ADD(" Cantidad, Precio1, TotalBrutoCli1, TotalNetoCli1, FechaEj, PrecioEj, MB3, MB1, ")
SQL.ADD(" PaseCB, ContraEspecie, ImpGastos1, TotalIntereses, Plazo, OperacionRef, Observaciones, 0 Tip ")
SQL.ADD(" from "~DBO~".OPERACIONES ")
SQL.ADD(" where FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Cliente1)
   SQl.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQl.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
endif
if Vacio(Dialogo.Lista1)
   *-- Veo todos los tipos de operaci¦n si la seleccion es nula
   SetListaClaves(1)
   SQL.ADD(" and (TipoOp LIKE 'SE%' or TipoOp = 'DSEO') and TipoOp <> 'SEO' ")
  else
   SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQl.ADD("Union ")
SQL.ADD(" Select Vehiculo1, TipoOp, NrOperacion, FechaOp, FechaVto2 as FechaVto, Especie, Cliente1, ")
SQL.ADD(" Cantidad, Precio1, TotalBrutoCli2 as TotalBrutoCli1, TotalNetoCli2 as TotalNetoCli1, FechaEj, PrecioEj, MB3, MB1, ")
SQL.ADD(" PaseCB, ContraEspecie, ImpGastos1, TotalIntereses, Plazo, OperacionRef, Observaciones, 1 Tip ")
SQL.ADD(" from "~DBO~".OPERACIONES ")
SQL.ADD(" where FechaVto2 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Cliente1)
   SQl.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQl.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
endif
if Vacio(Dialogo.Lista1)
   *-- Veo todos los tipos de operaci¦n si la seleccion es nula
   SetListaClaves(1)
   SQL.ADD(" and (TipoOp LIKE 'SE%' or TipoOp = 'DSEO') and TipoOp <> 'SEO' ")
  else
   SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD(" and TipoOp In ('SERA','SERAV','SERP','SERPV') ")
SQl.ADD("Order by 5, 2, 1 ")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC,'Agenda de Vencimientos de Operaciones de Security')

if NoVacio(Dialogo.Cliente1)
  Buscar(Clientes,Dialogo.Cliente1)
  ACT(a:FAC+1, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+1, 'Cliente : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+2, 'Especie : Todas')
endif

if NoVacio(Pipe2Comillas(Dialogo.Lista1))
   ACT(A:FAC+3, 'Tipo Op. : '~Pipe2Comillas(Dialogo.Lista1))
  else
   ACT(A:FAC+3, 'Tipo Op. : Todas')
endif

if NoVacio(Pipe2Comillas(Dialogo.Lista2))
   ACT(A:FAC+4, 'Vehiculo : '~Pipe2Comillas(Dialogo.Lista2))
  else
   ACT(A:FAC+4, 'Vehiculo : Todos')
endif

ACT(a:FAC+5, 'Vto.Desde : '~Dialogo.Fecha1)
ACT(a:FAC+6, 'Vto.Hasta : '~Dialogo.Fecha2)

SetFilaActual(FAC+8)
ACT(a:FAC, 'Vehiculo')
ACT(b:FAC, 'Operacion')
ACT(c:FAC, 'Fecha')
ACT(d:FAC, 'Tipo Op.')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio')
ACT(i:FAC, 'Moneda')
ACT(j:FAC, 'Imp.Bruto')
ACT(k:FAC, 'Gastos')
ACT(l:FAC, 'Intereses')
ACT(m:FAC, 'Imp.Neto')
ACT(n:FAC, 'Plazo')
ACT(o:FAC, 'Op.Ref')
ACT(p:FAC, 'Observaciones')

AlinearCeldas(c:FAC,'D')
AlinearCeldas(g:FAC..h:FAC,'D')
AlinearCeldas(j:FAC..m:FAC,'D')

AgregarMarco(a:FAC..p:FAC+1,2,0,Exe('COLOR'))

SetFont(a:Val(w1)..q:FAC,2)

Recorrer SQL
  ACN(x1, FBN['FechaVto'])

  if Val(x1)<>Val(v1) o Not EqStr(FBN['TipoOp'],Val(v2))
     if Val(x1)<>Val(v1)
        if FAC>Val(w1)+7
           IFA
           AgregarMarco(a:FAC..q:FAC,2)
        endif
        ACT(a:FAC, 'Vencimientos al: '~Fecha(Val(x1)))
        SetFont(a:FAC,2)
        SetFilaActual(FAC+2)
     endif

     ACT(a:FAC, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',FBN['TipoOp']))
     SetFont(a:FAC,2)
     IFA
     ACN(v1, Val(x1))
     ACT(v2, FBN['TipoOp'])

     ACN(z3,0)
  endif

  ACT(a:FAC, FBN['Vehiculo1'])
  ACT(b:FAC, FBN['NrOperacion'])
  ACLO(b:FAC, FBN['NrOperacion'])
  ACD(c:FAC, FBN['FechaOp'])
  ACT(d:FAC, FBN['TipoOp'])

  if FBN['PaseCB']=1
     ACT(d:FAC, Val(c:FAC)~' Repo')
  endif

  ACT(e:FAC, FBN['Cliente1'])
  ACT(f:FAC, FBN['Especie'])

  if Incluido(FBN['TipoOp'],'DSEO')
     ACT(f:FAC, VAL(e:FAC)~' '~FBN['FechaEj']~' '~Fstr(FBN['PrecioEj'],0,7))
  endif

  if fbn['Tip'] = 0
     if Incluido(fbn['TipoOp'],'DSEO')
        if fbn['MB3'] = 0
           ACN(g:FAC, FBN['Cantidad'])
           ACN(j:FAC,-FBN['TotalNetoCli1'])
           ACN(m:FAC,-FBN['TotalNetoCli1'])
          else
           ACN(g:FAC,-FBN['Cantidad'])
           ACN(j:FAC, FBN['TotalNetoCli1'])
           ACN(m:FAC, FBN['TotalNetoCli1'])
        endif
       else
        if Incluido(fbn['TipoOp'],'SERP|SERPV|SEABD|SECS|SECSV|SECT|SECTV|SEI|')
           ACN(g:FAC, FBN['Cantidad'])
           ACN(j:FAC,-FBN['TotalBrutoCli1'])
           ACN(m:FAC,-FBN['TotalNetoCli1'])
           ACN(l:FAC,-FBN['TotalIntereses'])
          else
           ACN(g:FAC,-FBN['Cantidad'])
           ACN(j:FAC, FBN['TotalBrutoCli1'])
           ACN(m:FAC, FBN['TotalNetoCli1'])
           ACN(l:FAC, FBN['TotalIntereses'])
        endif
     endif
    else
     if Incluido(fbn['TipoOp'],'SERP|SERPV')
        ACN(g:FAC,-FBN['Cantidad'])
        ACN(j:FAC, FBN['TotalBrutoCli1'])
        ACN(m:FAC, FBN['TotalNetoCli1'])
        ACN(l:FAC, FBN['TotalIntereses'])
       else
        ACN(g:FAC, FBN['Cantidad'])
        ACN(j:FAC,-FBN['TotalBrutoCli1'])
        ACN(m:FAC,-FBN['TotalNetoCli1'])
        ACN(l:FAC,-FBN['TotalIntereses'])
     endif
  endif

  ACN(h:FAC, FBN['Precio1'])
  ACT(i:FAC, FBN['Contraespecie'])
  ACN(k:FAC,-FBN['ImpGastos1'])
  ACN(n:FAC, FBN['Plazo'])
  ACT(o:FAC, FBN['OperacionRef'])
  ACT(p:FAC, FBN['Observaciones'])
  if Incluido(fbn['TipoOp'],'DSEO')
     if fbn['MB3'] = 0
        ACT(p:FAC, 'Compra')
       else
        ACT(p:FAC, 'Venta')
     endif
     if fbn['MB1'] = 0
        ACT(p:FAC, val(p:fac)~'  Call')
       else
        ACT(p:FAC, val(p:fac)~'  Put')
     endif
  endif

  SetFont(a:FAC..q:FAC,1)
  FormatoCeldas(g:fac..g:FAC,Exe('F2'))
  FormatoCeldas(j:fac..m:FAC,Exe('F2'))
  FormatoCeldas(h:fac..h:FAC,Exe('F7'))
proximo 

*FormatoCeldas(b:Val(w1)+7..b:FAC,'D1') 
*FormatoCeldas(f:Val(w1)+7..l:FAC,Exe('F2R'))
*FormatoCeldas(g:Val(w1)+7..g:FAC,Exe('F5R'))
FormatoCeldas(n:Val(w1)+7..n:FAC,Exe('F0'))
*FormatoCeldas(k:Val(w1)+7..k:FAC,'D1')

SetFont(w1..z3,1)

ACO(1,7)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,8)
ACO(6,15)
ACO(7,10)
ACO(8,7)
ACO(9,5)
ACO(10,10)
ACO(11,7)
ACO(12,7)
ACO(13,9)
ACO(14,3)
ACO(15,7)
ACO(16,15)
ACO(17,15)
Impresion(1,2)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
SetFont(p:3  ,2)
LimitesVision(p:FAC)
RangoTitulo(a:1..p:FAC, Val(w1)+9)




