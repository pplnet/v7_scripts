SQL.ADD("Select * From "~DBO~".VARIABLES")
SQL.ADD("order By Codigo")

Recorrer SQL

   ACN(Z1,SQL("Select COUNT(*) as Cantidad From "~DBO~".EVENTOS Where Script LIKE '%"~FBN['Codigo']~"%' "))
   ACN(Z1,VAL(Z1)+SQL("Select COUNT(*) as Cantidad From "~DBO~".INFORMES Where Script LIKE '%"~FBN['Codigo']~"%' "))
   ACN(Z1,VAL(Z1)+SQL("Select COUNT(*) as Cantidad From "~DBO~".FUNCIONES Where Script LIKE '%"~FBN['Codigo']~"%' "))

   IF VAL(Z1)>0
      ACT(a:FAC,FBN['Codigo'])
      ACT(b:FAC,FBN['Nombre'])
      ACT(c:FAC,FBN['Valor'])
   ELSE 
      DFA
   ENDIF

   SetFont(a:FAC..c:FAC,1)
