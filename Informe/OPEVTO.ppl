*- Listado de Vencimientos con subtotales por Dia, Semana y Mes
ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  :'Vehiculo'            ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Fecha1     :'Desde'               ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha2     :'Hasta'               ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
  Lista1     :'Tipos Op.'           ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo like 'MM%' ") 
  Especie1   :'Especie'             ;;;;;;;;;;;
  Radio1     :'Tipo|Concertadas|Vencidas|'    ;;;;;;;;;0;;
FinDialogo

if Not OK
  Cancelar
endif
AgregarBMP(a1,EXE('LOGO'),EXE('ESCALOGO'))

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*ACT(a:3,'OPEVTO')

ACT(j:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(j:2..j:2,1)

If Dialogo.Radio1=0
   *- Concertadas
   ACT(a:FAC, 'Operaciones Concertadas')
Else 
   *- Vencidas
   ACT(a:FAC, 'Operaciones al Vencimiento')
EndIf

SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+2)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
   ACT(a:FAC+1, 'Vehiculo: Todos')
endif
ACT(a:FAC+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+6)
ACT(a:FAC, 'Numero')
ACT(b:FAC, 'Fecha Op.')
ACT(c:FAC, 'Fecha Vto.')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Tipo Op.')
ACT(f:FAC, 'Cliente')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Interes')
ACT(i:FAC, 'Importe Neto')
ACT(j:FAC, 'Plazo')
ACT(k:FAC, 'Tasa.N.A.')
*ACT(l:FAC, 'Tasa.E.M.')
*ACT(m:FAC, "Custodia")
*ACT(n:FAC, "Inversor")

AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..k:FAC,'D')

SetFont(a:5..n:FAC,2)

AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

If Not Vacio(Dialogo.Vehiculo1)
   ACT(z1, Val(z1)~" and O.Vehiculo1 =  '"~Dialogo.Vehiculo1~"'")
EndIf

SQL.ADD("Select O.*,C.Fecha1,C.Fecha2,C.Cantidad4,C.Cantidad3,C.Total2,C.Plazo1,C.Precio3,cl.RazonSocial  from "~DBO~".OPERACIONES O join clientes cl on O.Cliente1 = cl.Codigo ,"~DBO~".OPERACIONESBITS B,"~DBO~".CUOTAS C  where ")
SQL.ADD(" O.NrOperacion=B.NrOperacion and B.Valor=0 and B.NrBit=30 ")
SQL.ADD(" and O.NrOperacion=C.NrOperacion ")
SQL.ADD(" "~Val(z1)~" ")
SQL.ADD(" and TipoOp<>'MMPFM' and (TipoOp In ('MMONR','MMONM') ")
If Dialogo.Radio1=1
   *- Vencidas
   SQL.ADD(" and C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2<='"~IdxDate(Dialogo.Fecha2)~"') ")
Else 
   *- Concertadas
   SQL.ADD(" and C.Fecha1 >='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha1<='"~IdxDate(Dialogo.Fecha2)~"') ")
EndIf
SQL.ADD(" and (O.TipoOp Like 'MM%')")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD("Union")
SQL.ADD("Select O.*,'' Fecha1,'' Fecha2,0 Cantidad4,0 Cantidad3,0 Total2,0 Plazo1,0 Precio3,cl.RazonSocial  from "~DBO~".OPERACIONES O  join clientes cl on O.Cliente1 = cl.Codigo ,"~DBO~".OPERACIONESBITS B where ")
SQL.ADD(" O.NrOperacion=B.NrOperacion and B.Valor=0 and B.NrBit=30 ")
SQL.ADD(" "~Val(z1)~" ")
SQL.ADD(" and TipoOp Not In ('MMONR','MMONM')  ")
If Dialogo.Radio1=1
   *- Vencidas
   SQL.ADD(" and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha2)~"' ")
Else 
   *- Concertadas
   SQL.ADD(" and O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ")
EndIf

SQL.ADD(" and (O.TipoOp Like 'MM%') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and (O.Especie='"~Dialogo.Especie1~"' or (O.ContraEspecie='"~Dialogo.Especie1~"' AND O.Especie Not IN ("~Pipe2Comillas(DESCENDIENTES('ESPECIES','MONEDA'))~")))")
Endif
SQL.ADD("order by O.FechaVto,O.Cliente1,O.TipoOp,O.NrOperacion")


Recorrer SQL
  SCN(z2,1)
  ACT(z3, ' ')

  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:fac,FBN['NrOperacion'])
  ACT(b:FAC, FBN['FechaOp'])
  ACT(c:FAC, FBN['FechaVto'])
  ACT(d:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])

  if Incluido(fbn('TipoOp'), 'MMDIVA')
     ACT(d:fac, fbn('Especie')~' ('~fbn('ContraEspecie')~')')
  endif
  ACT(e:FAC, FBN['TipoOp'])
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(e:FAC, Val(f:FAC)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(e:FAC, Val(f:FAC)~' x Arb.')
  endif
  ACT(f:FAC, FBN['Cliente1']~' - ' ~Copy(FBN['RazonSocial'],1,25))
  ACN(g:FAC, FBN['Cantidad'])
  ACN(h:FAC, FBN['TotalIntereses'])

  IF Incluido(FBN['TipoOp'], 'TIC|TIV|TIFC|TIFV|') 
     If fbn['TotalCaucion']<>0
        ACN(i:fac,fbn['TotalCaucion'])
     Else
        ACN(i:fac,fbn['TotalNetoCli1'])
    EndIf
  Else 
     ACN(i:fac,FBN['Cantidad']+FBN['TotalIntereses'])
  EndIf

  ACT(j:FAC, FBN['Plazo'])
  ACN(k:fac, FBN['Precio1'])

  IF Incluido(FBN['TipoOp'], 'COM|COT|CTM|CTT|POM|POT|PTM|PTT|PFM|PFT')
     ACN(k:fac, FBN['Precio1'])
  ENDIF

  IF Incluido(FBN['TipoOp'],'PAM|PAT|PPM|PPT|REPO')
     ACN(k:fac, FBN['Precio3'])
  ENDIF 
*  ACT(l:FAC, FBN['Precio2'])
*  
*  If NoVacio(fbn('Cuenta1'))
*     ACN(n:fac, fbn('Cuenta1'))
*  endif

*  **Custodia
*  If FBN('MB4') =0 
*     ACT(m:fac,'Cliente')
*  endif
*  If FBN('MB4') =1 
*     ACT(m:fac,'BKB')
*  endif
*  If FBN('MB4') =2 
*     ACT(m:fac,'Robo/Extravio')
*  endif
*  If FBN('MB4') =3 
*     ACT(m:fac,'Garantias')
*  endif

  If Incluido(fbn('TipoOp'),'MMONM|MMONR')
     ACD(b:FAC, FBN['Fecha1'])
     ACD(c:FAC, FBN['Fecha2'])
     ACN(g:FAC, FBN['Cantidad4'])
     ACN(h:FAC, FBN['Cantidad3'])
     ACN(i:fac, fbn['Total2'])
     ACT(j:FAC, FBN['Plazo1'])
     ACN(k:fac, FBN['Precio3'])
  EndIf  

  AlinearCeldas(b:FAC..c:FAC,'D')
  AlinearCeldas(g:FAC..l:FAC,'D')
  FormatoCeldas(n:fac..n:fac,Exe('F0'))  
  FormatoCeldas(g:fac..i:fac,Exe('F3'))
  FormatoCeldas(j:fac..j:fac,"0")
  FormatoCeldas(k:fac..l:fac,Exe('F7'))

proximo

SetFont(a:Val(w1)+6..z:FAC,1)

ACO(1,7)
ACO(2,7)
ACO(3,7)
if Val(z6)=1
  ACO(4,10)
else
  ACO(4,8)
endif

ACO(5,6)
ACO(6,25)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,6)
ACO(11,8)
ACO(12,8)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(n:FAC)
RangoTitulo(a:1..o:FAC, Val(w1)+5)
IF Dialogo.Radio1 = 0
    ACT(A:5, 'Cantidad de Operaciones Concertadas: '~FStr(Val(z2),4,0))
ELSE
    ACT(a5, 'Cantidad de Operaciones Vencidas: '~FStr(Val(z2),4,0))
ENDIF
SetFont(a5..a5,2)
SetPrintFit(2)