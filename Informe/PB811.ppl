MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:  'D.Fecha'   ;1;1;;;;;;;FSYS
   Lista1:   'Vehiculos' ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
   Lista2:   'Especies'  ;-1;2;;;;;;;;;SQLSET(" Select Codigo from "~DBO~".ESPECIES WHERE (JERARQUIA > '004021000000000' and JERARQUIA < '004022000000000') or (JERARQUIA > '004023000000000' and JERARQUIA < '004024000000000')");
FinDialogo

If NOT OK
  Cancelar
Endif

ACO(1,12)
ACO(2,12)
ACO(3,12)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")
CrearFont(6,"Arial,8,BU")

SetFilaActual(1)
ACT(a:1,'Posicion Bancaria CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(2)
ACT(A:fac, 'Informe de Saldos de Titulos Publicos (Cuasi Monedas)')
SetFont(A:fac,3)
SetFilaActual(fac+2)

ACT(a:fac, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
SetFont(a:fac,2)
ifa
ACT(a:fac, 'Monedas: '~iif(vacio(Dialogo.Lista2),'Todas',Pipe2Comillas(Dialogo.Lista2)))
SetFont(a:fac,2)
ifa
ACT(a:fac, 'Fecha: '~Dialogo.Fecha1 )
SetFont(a:fac,2)
ifa
ACN(az:1,2)

SetFilaActual(fac+2)

ACT(a:fac, 'Especie')
ACT(b:fac, 'Cotizacion')

AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR'))
SetFont(A:fac..c:fac, 2)
AlinearCeldas(A:fac..c:fac, 'C')
SetFilaActual(fac+1)
AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR8'))
If NoVacio(Dialogo.Lista2)
  SQL.ADD ("SELECT CODIGO, NOMBRE FROM "~DBO~".ESPECIES WHERE CODIGO IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
else
  SQL.ADD ("SELECT CODIGO, NOMBRE FROM "~DBO~".ESPECIES WHERE CODIGO IN (Select Codigo from "~DBO~".ESPECIES WHERE (JERARQUIA > '004021000000000' and JERARQUIA < '004022000000000') or (JERARQUIA > '004023000000000' and JERARQUIA < '004024000000000')) ")
EndIf

Recorrer SQL
  ACT(a:fac, FBN['NOMBRE'])
  ACN(b:fac,Cotizacion(FBN['CODIGO'],,,,Fsys,1,SI))
  ACT(aa:1, val(aa:1)~FBN['CODIGO']~'|')
  ACT(aa:val(az:1),FBN['CODIGO'])
  SCN(az:1,1)
  SetFont(a:fac,2)
  FormatoCeldas(b:fac,Exe('F5'))
Proximo
SetFilaActual(fac+1)
AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR8'))

SetFilaActual(fac+2)
AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR'))
ACT(a:fac, 'Titulo')
ACT(b:fac, 'Valor Nominal')
ACT(c:fac, 'Valor de Mercado')
SetFont(A:fac..c:fac, 2)
AlinearCeldas(A:fac..c:fac, 'C')
SetFilaActual(fac+1)
AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR8'))
SetFilaActual(fac+1)

BorrarCeldas(w11..w12)
LinkearHoja('PB134',1,Fecha1=Dialogo.Fecha1,Radio2=5,Check1=1,Lista1=Dialogo.Lista1,Lista2='',Lista3='',Lista4=val(aa:1))
ACN(az:2,fac)

Recorrer&i 1, LinkH(1,ac1)
  SQL.ADD ("SELECT CODIGO, NOMBRE FROM "~DBO~".ESPECIES WHERE CODIGO='"~LinkH(1,aa:&i)~"'")
  Recorrer SQL
    Recorrer&j 2, val(az:1)
      If Eqstr(val(aa:&j), FBN['CODIGO'])
        ACN(ab:&j, val(ab:&j)+LinkH(1,ab:&i))
        ACT(ac:&j, FBN['NOMBRE'])
        ACN(ad:&j, Cotizacion(LinkH(1,aa:&i),,,,Fsys,1,SI))
      EndIf
    Proximo
  Proximo
Proximo

Recorrer&i 2, val(az:1)
  If NoVacio(val(ab:&i))
    ACT(a:val(az:2), val(ac:&i))
    ACN(b:val(az:2), val(ab:&i))
    ACN(c:val(az:2), val(ab:&i)*val(ad:&i))
*--    ACN(d:val(az:2), Cotizacion(val(ac:&i),,,,Fsys,1,SI))
    SetFont(A:val(az:2), 1)
    SCN(az:2,1)
    SCN(w11,val(ab:&i))
    SCN(w12,val(ab:&i)*val(ad:&i))
  EndIf
Proximo

SetFilaActual(val(az:2))
act(a:fac,'Total Especies')
acn(b:fac, Val(w11))
acn(c:fac, Val(w12))

AgregarMarco(A:fac..c:fac, 0, 0, Exe('COLOR8'))
SetFont(A:fac..c:fac, 2)


CerrarHoja('PB134',1,Fecha1=Dialogo.Fecha1,Radio2=5,Check1=1,Lista1=Dialogo.Lista1,Lista2='',Lista3='',Lista4=val(aa:1))


LimitesVision(d:fac+1)