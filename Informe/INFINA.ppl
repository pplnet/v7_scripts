*-Intereses PostFinanciacion de Importaciones 
*-Llama al reporteador FINPRE
HOJAVISIBLE(NO)
ModoReproceso(SinDialogo)
CrearDialogo
*--  Label1      : ''         ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Fecha1      : "F.Vigencia"  ;1;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Especie1    : "Especie"     ;2;1;;;;;;;;;
  Cliente1    : "Entidad"     ;1;2;;;;;;;;;
  NrOperacion1: "Operacion"   ;;;;;;;;;;;;;" TipoOp In ('MMPIM','MMPI')"
  Radio2      : "Expresado|ARP  |USD      ";3;1;;;;;;;0
 * Vehiculo1   : "Grupo"       ;;;;;;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Vehiculo1   : "Grupo"        ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1      : "Vehiculo"    ;5;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
  Lista2      : "TipoOp"      ;-1;2;;;;NoVacio(Dialogo.Lista2);'Seleccione al menos un Tipo de Operacion';NO;'MMPIM|MMPI|';;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMPIM','MMPI') ")
  Radio3       : "Consolidado|SI|NO"    ;;1;;No;No;;;;1;
FinDialogo

if Not Ok
  Cancelar
endif

if NoVacio(Dialogo.Lista2)
   ACT(op1,Dialogo.Lista2)
else
   ACT(op1,"MMPIM|MMPI")
endif

*  LinkearHoja("FINPRE",1,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Cliente1=Dialogo.Cliente1,NrOperacion1=Dialogo.NrOperacion1,Lista1=Dialogo.Lista1,Lista2=Val(op1),Radio1=0,Radio2=Dialogo.Radio2)
  LinkearHoja("FINPRE",1,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Cliente1=Dialogo.Cliente1,NrOperacion1=Dialogo.NrOperacion1,Lista1=Dialogo.Lista1,Lista2=Val(op1),Radio1=0,Radio2=Dialogo.Radio2, Vehiculo1=Dialogo.Vehiculo1,Radio3=0)