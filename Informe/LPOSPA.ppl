AgregarMarco(a8..a:fac,1)
AgregarMarco(b8..c:fac+3,1)
AgregarMarco(d8..e:fac+3,1)
AgregarMarco(f8..g:fac+3,1)
AgregarMarco(h8..i:fac+3,1)
AgregarMarco(j8..k:fac+3,1)
AgregarMarco(l8..m:fac+3,1)
AgregarMarco(n8..p:fac+1,1,2)
AgregarMarco(b9..k9,1,2)
AgregarMarco(a:fac+1..p:fac+1,1,0,Exe('COLOR'))
AgregarMarco(a:fac+2..m:fac+2,1)
AgregarMarco(a:fac+3..m:fac+3,1)


Recorrer&i 10, fac+1
  ACN(c:&i, Val(b:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(e:&i, Val(d:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(g:&i, Val(f:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(i:&i, Val(h:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(k:&i, Val(j:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(l:&i, Val(t:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(m:&i, Val(u:&i)/(Val(t:&i)+Val(u:&i))*100)
  ACN(n:&i, Val(t:&i)+Val(u:&i))
Proximo

If Val(c:fac+1) > Val(c:fac+2)
  ACT(c:fac+3, 'Excedido')
  ColorCeldas(c:fac+3,clRED)
Else
  ACT(c:fac+3, 'OK')
  ColorCeldas(c:fac+3,clGREEN)
endif
if Val(e:fac+1) > Val(e:fac+2)
  ACT(e:fac+3, 'Excedido')
  ColorCeldas(e:fac+3,clRED)
else
  ACT(e:fac+3, 'OK')
  ColorCeldas(e:fac+3,clGREEN)
endif
if Val(g:fac+1) > Val(g:fac+2)
  ACT(g:fac+3, 'Excedido')
  ColorCeldas(g:fac+3,clRED)
else
  ACT(g:fac+3, 'OK')
  ColorCeldas(g:fac+3,clGREEN)
