else
  ACT(i:fac+3, 'OK')
  ColorCeldas(i:fac+3,clGREEN)
endif
if Val(k:fac+1) > Val(k:fac+2)
  ACT(k:fac+3, 'Excedido')
  ColorCeldas(k:fac+3,clRED)
