ACN(t:fac+1, sum(t10..t:fac))
ACN(u:fac+1, sum(u10..u:fac))
ACN(n:fac+1, sum(n10..n:fac))

ACT(a:fac+2, 'Limite')
ACT(w1, 'VINCULADOS')
ACN(c:fac+2, LimAsignado(Val(w1), 'PORPRLOCAL', 'USD'))
ACN(e:fac+2, LimAsignado(Val(w1), 'PORPROFFSH', 'USD'))
ACN(g:fac+2, LimAsignado(Val(w1), 'PORPRTRADE', 'USD'))
