ACT(p8, 'Vinculadas')
ACT(p9, 'No control')

AlinearCeldas(p8..r8, 'D')
AlinearCeldas(b9..r9, 'D')

AgregarMarco(a8..p9,1,0,Exe("COLOR"))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z9, 1)


SetFilaActual(9)

SQL.ADD("Select Especie, Cantidad, NrOperacion, TipoOp, Vehiculo1, MB3, Vehiculo2 from "~DBO~".OPERACIONES Where ")
SQL.ADD("FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and ((TipoOp in ('MMFRP','MMFIMV','MMON','MMONM','MMPCL','MMPCLM','MMPLME','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSI','MMSIMV','MMPCCM','MMPCCV')")
SQL.ADD("and FechaVto>'"~IdxDate(Dialogo.Fecha1)~"')")
SQL.ADD("or (TipoOp in ('MMFRNP','MMFIMV','MMPSI','MMSIMV') and FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" ) ")
SQL.ADD(" and ((NrOperacion2 IS NULL or NrOperacion2='')  ")
SQL.ADD(" or NrOperacion2 NOT IN ")
SQL.ADD(" (")
SQL.ADD("Select NrOperacion from "~DBO~".OPERACIONES where ")
SQL.ADD("FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and ((TipoOp in ('MMFRP','MMFIMV','MMON','MMONM','MMPCL','MMPCLM','MMPLME','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPSI','MMSIMV','MMPCCM','MMPCCV')")
SQL.ADD("and FechaVto>'"~IdxDate(Dialogo.Fecha1)~"')")
SQL.ADD("or (TipoOp in ('MMFRNP','MMFCMV','MMPSI','MMSCMV') and FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"'))  ")
SQL.ADD(" )) ")
SQL.ADD(" Union All ")
*- Selecciono los Vehiculos de Vinculados para Recuperar el Saldo
SQL.ADD(" Select DISTINCT '' Especie,0 Cantidad,'' NrOperacion,'VINC' TipoOp,Vehiculo1,' ' MB3,' ' Vehiculo2 FROM "~DBO~".PARESVEHICULO ")
SQL.ADD(" Where Estado='HAB' ")
SQL.ADD(" Union All ")
*- Selecciono los Vehiculos de Terceros para Recuperar el Saldo
SQL.ADD(" Select DISTINCT '' Especie,0 Cantidad,'' NrOperacion,'TERC' TipoOp,Vehiculo ,' ' MB3,' ' Vehiculo2 FROM  "~DBO~".IMPTERCEROS ")
SQL.ADD(" Where Estado='HAB' ")
SQL.ADD("order by Vehiculo1, TipoOp")

Recorrer SQL

  Message(fbn['TipoOp']~' '~fbn['NrOperacion'])
  dfa
  ACN(z3, 0)

  if Not EqStr(Val(a:fac), fbn('Vehiculo1'))   
     ifa
     ACT(a:fac, fbn('Vehiculo1'))

     *- Recupero el saldo de las Vinculadas y Terceros
     *- Vinculados en o:fac
     (.'LPOSVIMIND'.)

     *- Terceros en p:fac
     (.'LPOSTEMIND'.)
  endif

  if Incluido(fbn('TipoOp'),'MMPCL|MMPLME|MMPCLM')
     ACN(z3, fbn('Cantidad'))     

     if Incluido(fbn('TipoOp'),'MMPCLM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
    endif
    SCN(b:fac, Val(z3))
    SCN(20+Val(y1):fac,  Val(z3))
  endif

  if Incluido(fbn('TipoOp'),'MMPCOS|MMPOSM')
     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMPOSM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf
     
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif

     SCN(d:fac, Val(z3))
     SCN(20+Val(y1):fac,  Val(z3))
  endif

  if Incluido(fbn('TipoOp'),'MMPE|MMPEM|MMPI|MMPIM')     
     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMPEM|MMPIM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

*If EqStr(FBN['Vehiculo1'],'PASA')
*   Message(val(z3))
*EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, VAL(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif

*If EqStr(FBN['Vehiculo1'],'PASA')
*   MessageBox(val(z3))
*EndIf

     SCN(f:fac, Val(z3))
     SCN(20+Val(y1):fac,  Val(z3))
  endif

  if Incluido(fbn('TipoOp'),'MMON|MMONM')
     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMONM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     SCN(h:fac, Val(z3))
     SCN(20+Val(y1):fac,  Val(z3))
  endif

  if Incluido(fbn('TipoOp'),'MMPSI|MMSIMV|MMFRNP|MMFIMV')

     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMSIMV|MMFIMV')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     SCN(j:fac, Val(z3))
     SCN(20+Val(y1):fac,  Val(z3))
  endif

  *- Vinculadas
  if Incluido(fbn('TipoOp'),'MMPCCM|MMPCCV') y fbn('MB3')=0
     ACN(z3, fbn('Cantidad'))

     if Incluido(fbn('TipoOp'),'MMPCCM')
        ACN(z3, SQL("Select Cantidad2 from "~DBO~".CUOTAS where NrOperacion='"~fbn('NrOperacion')~"' and Fecha1<= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'"))
     EndIf

     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, val(z3)/1000)
        ACN(y1, 1)
     else
        ACN(z3, val(z3)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif

     SCN(o:fac, Val(z3)) 
  endif

Proximo

ACT(a:fac+1, 'Total')
ACN(b:fac+1, sum(b10..b:fac))
ACN(d:fac+1, sum(d10..d:fac))
ACN(f:fac+1, sum(f10..f:fac))
ACN(h:fac+1, sum(h10..h:fac))
ACN(j:fac+1, sum(j10..j:fac))
ACN(o:fac+1, sum(o10..o:fac))
