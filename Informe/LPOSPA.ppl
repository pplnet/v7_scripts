CrearDialogo
 Fecha1 : 'Fecha';;;;;;;;;FSys
FinDialogo

if not Ok 
  Cancelar
endif

ACT(a4, 'Limites de Posicion - Pasivos por Vehiculo')
ACT(a5, 'Fecha : '~Dialogo.Fecha1)

ACT(a8, 'Vehiculo')
ACT(b8, 'Pr.Locales')
