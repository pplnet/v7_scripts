*ACN(p:fac+2, LimAsignado(Val(w1), 'PORNOCONTR', 'USD'))
ACN(l:fac+2, LimAsignado(Val(w1), 'PORPASMON', 'ARP'))
ACN(m:fac+2, LimAsignado(Val(w1), 'PORPASMON', 'USD'))
ACT(a:fac+3, 'Estado')
ACN(v1, fac+3)

ACO(1, 17)
