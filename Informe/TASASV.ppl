CrearDialogo
  Vehiculo1:'V.Desde'
  Vehiculo2:'V.Hacia'
  Especie1 :'Especie'
  Fecha1   :'F.Desde';;;;;;;;;FSys
  Fecha2   :'F.Hasta';;;;;;;;;FSys
FinDialogo

if not OK
  Cancelar
endif

ACT(a1, 'Listado de Tasas de Interes Vinculadas')

SQL.ADD("Select * from "~dbo~".TASASVEHICULO")
SQL.ADD("where Fecha >= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'")
if NoVacio(Dialogo.Vehiculo1)
  ACT(a2, 'V.Desde: '~Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
else
  ACT(a2, 'V.Desde: Todos')
endif
if NoVacio(Dialogo.Vehiculo2)
  ACT(a3, 'V.Hacia: '~Dialogo.Vehiculo2)
  SQL.ADD("and Vehiculo2 = '"~Dialogo.Vehiculo2~"'")
else
  ACT(a3, 'V.Hacia: Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a4, 'Especie: '~Dialogo.Especie1)
  SQL.ADD("and Especie = '"~Dialogo.Especie1~"'")
else
  ACT(a4, 'Especie: Todas')
endif
ACT(a5, 'D.Fecha: '~Dialogo.Fecha1)
ACT(a6, 'H.Fecha: '~Dialogo.Fecha2)
ACT(a8, 'Fecha')
ACT(b8, 'V.Desde')
ACT(c8, 'V.Hacia')
ACT(d8, 'Especie')
ACT(e8, 'Tasa')
AgregarMarco(a8..e8,1,0,Exe('COLOR'))

SQL.ADD("order by Fecha, Vehiculo1, Vehiculo2, Especie")


SetFilaActual(8)
recorrer SQL
  ACT(a:fac, fbn('Fecha'))
  ACT(b:fac, fbn('Vehiculo1'))
  ACT(c:fac, fbn('Vehiculo2'))
  ACT(d:fac, fbn('Especie'))
  ACN(e:fac, fbn('Tasa'))
proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
Setfont(a1..z8, 1)
SetFont(a9..z:fac, 2)
FormatoCeldas(e1..e:fac, Exe('F7'))
LimitesVision(f:fac+1)
