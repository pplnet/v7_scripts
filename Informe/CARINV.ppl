            ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
            ACN(G:fac, Sum(G:Val(FI:1)..G:fac-1))
            ACN(H:fac, Sum(H:Val(FI:1)..H:fac-1))
            ACN(I:fac, Sum(I:Val(FI:1)..I:fac-1))
            ACN(J:fac, Sum(J:Val(FI:1)..J:fac-1))
            ACN(K:fac, Sum(K:Val(FI:1)..K:fac-1))
            ACN(L:fac, Sum(L:Val(FI:1)..L:fac-1))
            ACN(M:fac, Sum(M:Val(FI:1)..M:fac-1))
            ***---Total Cartera
            SCN(TD:1, Val(D:fac))
            SCN(TG:1, Val(G:fac))
            SCN(TH:1, Val(H:fac))
            SCN(TI:1, Val(I:fac))
            SCN(TJ:1, Val(J:fac))
            SCN(TK:1, Val(K:fac))
            SCN(TL:1, Val(L:fac))
            SCN(TM:1, Val(M:fac))
            SetFont(C:fac..M:fac, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            ifa
        ENDIF
    ENDIF
    ***---Plazos Fijos.
    ***---IMPORTE = Capital de las operaciones vigentes a fecha hasta, o sea que no hayan vencido durante el periodo + los devengados a fecha Hasta
    ***---de las mismas operaciones. No hay DC
    ***---VARIOS = Devengados del periodo de las mismas operaciones de columna Importe + DC por los devengados al inicio del periodo de las mismas operaciones +
    ***---+ DC capital al inicio del periodo, de las mismas operaciones
    ***---VENTAS = Devengados del periodo de las operaciones que vencieron durante el periodo al TC al vto de cada operacion + DC de los devengados
    ***---anteriores al inicio, de las mismas operaciones. DC entre FVTO y Fecha Inicio del periodo + DC capital de las operaciones que se inican antes
    ***---del periodo y vencen en el mismo, DC entre FechaVto y Fecha Inicio
    ACN(BD:9, 0)
    ***---Operaciones vigentes a Fecha Hasta
    (.'CARINV3-R2'.)
    ACN(FI:1, fac+1)
    ACN(BD:4, 0)
    Recorrer SQL
        ACN(BD:4, 1)
        IF Not Eqstr(fbn('Especie'), Val(ES:5))
            IF Not CeldaVacia(ES:5)
                DFA
                ACN(I:fac, Val(G:fac) + Val(H:fac))
                ***---Capital Expuesto (Cantidad * Dias de Vigencia)
                (.'CARINV7'.)
                ACN(M:fac, Val(M:fac) / Val(DS:1))
                ACN(J:fac, Val(G:fac) / Val(M:fac) * 100)
                ACN(L:fac, Val(J:fac))
                ***---Total Cartera
                SCN(TD:1, Val(D:fac))
                SCN(TG:1, Val(G:fac))
                SCN(TH:1, Val(H:fac))
                SCN(TI:1, Val(I:fac))
                SCN(TJ:1, Val(J:fac))
                SCN(TL:1, Val(L:fac))
                SCN(TM:1, Val(M:fac))
                ifa
            ENDIF
            ACT(A:fac, 'Plazo Fijo en '~fbn('Especie'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            AgregarMarco(G:Val(FI:1)..I:fac, 0, 0)
            AgregarMarco(J:Val(FI:1)..L:fac, 0, 0)
            IF Eqstr(fbn('Especie'), Val(MI:1))
                ACN(CT:1, 1)
            ELSE
                IF Not Eqstr(fbn('Especie'), Val(MU:1))
                    ACN(CT:1, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,Val(MI:1)))
                ELSE
                    IF Eqstr(Val(MI:1), Val(ML:1))
                        ACN(CT:1, 1/CotizacionBNABCU(Val(ME:1),Dialogo.Fecha2,1,NO,NO))
                    ELSE
                        ACN(CT:1, 1/CotizacionBCU(Val(MI:1),Dialogo.Fecha2,1,NO,NO))
                    ENDIF
                ENDIF
            ENDIF
        ELSE
            DFA
        ENDIF
        IF fbn('FechaVto') > Dialogo.Fecha2
            ***---IMPORTE
            SCN(D:fac, fbn('Cantidad') * Val(CT:1))
            ***---Sumo los devengados de la operacion a Fecha Hasta
            ACT(ES:5, fbn('Especie'))
            SQL.ADD(" Select Sum(M.Monto) Monto ")
            SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
            SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
            SQL.ADD(" AND M.NrSaldo = 140 ")
            SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
            Recorrer SQL
                DFA
                SCN(D:fac, fbn('Monto') * Val(CT:1))
            Proximo
            ***---VARIOS
            ***---Devengados del periodo
            SQL.ADD(" Select Sum(M.Monto) Monto ")
            SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
            SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
            SQL.ADD(" AND M.NrSaldo = 140 ")
            SQL.ADD(" AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
            Recorrer SQL
                DFA
                SCN(G:fac, fbn('Monto') * Val(CT:1))
            Proximo
            IF Not Eqstr(Val(MI:1), fbn('Especie'))
                ***---No es Moneda del informe => hay DC
                ***---DC de cambio de los devengados al inicio
                SQL.ADD(" Select Sum(M.Monto) Monto, Especie ")
                SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
                SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
                SQL.ADD(" AND M.NrSaldo = 140 ")
                SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
                SQL.ADD(" Group By Especie ")
                Recorrer SQL
                    DFA
                    ACT(ES:99, fbn('Especie'))
                    ACD(FE:50, Dialogo.Fecha1)
                    ACD(FE:60, Dialogo.Fecha2)
                    ACN(MN:1, fbn('Monto'))
                    (.'CARINV9-R2'.)
                    SCN(G:fac, Val(DC:88))
                Proximo
                ***---DC de cambio Capital al inicio del periodo
                ACT(ES:99, fbn('Especie'))
                ACD(FE:50, fbn('FechaOp'))
                ACD(FE:60, Dialogo.Fecha2)
                ACN(MN:1, fbn('Cantidad'))
                (.'CARINV9-R2'.)
                SCN(G:fac, Val(DC:88))
            ENDIF
        ELSE
*MessageBox(fbn('NrOperacion'))
            ***---VENTAS
            ***---Operaciones que vencen durante el periodo
            ACN(BD:9, 1)
            ACD(FE:77, fbn('FechaVto'))
            ***---Devengados
            SQL.ADD(" Select Sum(M.Monto) Monto, Especie ")
            SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
            SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
            SQL.ADD(" AND M.NrSaldo = 140 ")
            SQL.ADD(" AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
            SQL.ADD(" Group By Especie ")
            Recorrer SQL
                DFA
                IF Eqstr(fbn('Especie'), Val(MI:1))
                    ACN(CT:2, 1)
                ELSE
                    IF Not Eqstr(fbn('Especie'), Val(MU:1))
                        ACN(CT:2, CotizacionC(fbn('Especie'),,,,Val(FE:77),1,SI,Val(MI:1)))
                    ELSE
                        IF Eqstr(Val(MI:1), Val(ML:1))
                            ACN(CT:2, 1/CotizacionBNABCU(Val(ME:1),Val(FE:77),1,NO,NO))
*MessageBox(Val(CT:2))
                        ELSE
                            ACN(CT:2, 1/CotizacionBCU(Val(MI:1),Val(FE:77),1,NO,NO))
                        ENDIF
                    ENDIF
                ENDIF
*              MessageBox('antes: '~Val(H:fac))
                SCN(H:fac, fbn('Monto') * Val(CT:2))
*              MessageBox('Desp: '~Val(H:fac))
            Proximo
             IF Incluido(fbn('NrOperacion'), '50000077|50000079')
*              MessageBox(Val(H:fac))
             ENDIF
            IF Not Eqstr(Val(MI:1), fbn('Especie'))
                ***---No es Moneda del informe => hay DC
                ***---DC de cambio de los devengados al inicio
                SQL.ADD(" Select Sum(M.Monto) Monto, Especie ")
                SQL.ADD(" From "~DBO~".MOVDEVENGADOS M ")
                SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
                SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
                SQL.ADD(" AND M.NrSaldo = 140 ")
                SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
                SQL.ADD(" Group By Especie ")
                Recorrer SQL
                    DFA
                    ACT(ES:99, fbn('Especie'))
                    ACD(FE:50, Dialogo.Fecha1)
                    ACD(FE:60, Val(FE:77))
                    ACN(MN:1, fbn('Monto'))
                    (.'CARINV9-R2'.)
                    SCN(H:fac, Val(DC:88))
*              MessageBox('suma DC In: '~Val(DC:88))
                Proximo
                ***---DC de cambio Capital al inicio
                ACT(ES:99, fbn('Especie'))
                ACD(FE:50, fbn('FechaOp'))
                ACD(FE:60, Val(FE:77))
                ACN(MN:1, fbn('Cantidad'))
                (.'CARINV9-R2'.)
                SCN(H:fac, Val(DC:88))
*              MessageBox('suma DC Cap: '~Val(DC:88))
            ENDIF
        ENDIF
        ACT(ES:5, fbn('Especie'))
    Proximo
    IF Val(BD:4) = 1
        ACN(I:fac, Val(G:fac) +  Val(H:fac))
        ***---Capital Expuesto (Cantidad * Dias de Vigencia)
        (.'CARINV7'.)
        ACN(M:fac, Val(M:fac) / Val(DS:1))
        ACN(J:fac, Val(G:fac) / Val(M:fac) * 100)
        ACN(L:fac, Val(J:fac))
        ***---Total Cartera
        SCN(TD:1, Val(D:fac))
        SCN(TG:1, Val(G:fac))
        SCN(TH:1, Val(H:fac))
        SCN(TI:1, Val(I:fac))
        SCN(TJ:1, Val(J:fac))
        SCN(TL:1, Val(L:fac))
        SCN(TM:1, Val(M:fac))
    ENDIF
    SetFont(A:Val(FI:1)..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    IF Val(BD:4) = 1
        ifa
    ENDIF
    ***---FCI Moneda
    ACN(TP:1, 6)
    ACT(AL:2, '0')
    (.'CARINV11'.)
    ACN(BD:1, 0)
    ACN(BD:2, 0)
    ACT(CZ:1, '')
    Recorrer SQL
        (.'CARINV2-R2'.)
        ACN(BD:1, 1)
        IF Val(BD:2) = 1
            DFA
        ENDIF
    Proximo
    IF Val(BD:1) = 1
        SetFont(A:Val(FI:1)..M:fac, 1)
        FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
        FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
        FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
        FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
        FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
        ifa
        IF Not CeldaVacia(CZ:1)
            SetFont(A:Val(FI:1)..M:fac, 1)
            ifa
            ACT(C:fac, 'Total')
            AgregarMarco(G:Val(FI:1)..I:fac, 0, 0)
            AgregarMarco(J:Val(FI:1)..L:fac, 0, 0)
            ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
            ACN(G:fac, Sum(G:Val(FI:1)..G:fac-1))
            ACN(H:fac, Sum(H:Val(FI:1)..H:fac-1))
            ACN(I:fac, Sum(I:Val(FI:1)..I:fac-1))
            ACN(J:fac, Sum(J:Val(FI:1)..J:fac-1))
            ACN(K:fac, Sum(K:Val(FI:1)..K:fac-1))
            ACN(L:fac, Sum(L:Val(FI:1)..L:fac-1))
            ACN(M:fac, Sum(M:Val(FI:1)..M:fac-1))
            ***---Total Cartera
            SCN(TD:1, Val(D:fac))
            SCN(TG:1, Val(G:fac))
            SCN(TH:1, Val(H:fac))
            SCN(TI:1, Val(I:fac))
            SCN(TJ:1, Val(J:fac))
            SCN(TK:1, Val(K:fac))
            SCN(TL:1, Val(L:fac))
            SCN(TM:1, Val(M:fac))
            SetFont(C:fac..M:fac, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            ifa
        ENDIF
    ENDIF
    IF Dialogo.Radio2 = 0
        ACT(A:fac, 'Total Cartera')
    ELSE
        ACT(A:fac, 'Total Cartera '~Val(LV:4))
    ENDIF
    ACN(D:fac, Val(TD:1))
    ACN(G:fac, Val(TG:1))
    ACN(H:fac, Val(TH:1))
    ACN(I:fac, Val(TI:1))
    ACN(J:fac, Val(TJ:1))
    ACN(K:fac, Val(TK:1))
    ACN(L:fac, Val(TL:1))
    ACN(M:fac, Val(TM:1))
    SCN(TD:2, Val(TD:1))
    SCN(TG:2, Val(TG:1))
    SCN(TH:2, Val(TH:1))
    SCN(TI:2, Val(TI:1))
    SCN(TJ:2, Val(TJ:1))
    SCN(TK:2, Val(TK:1))
    SCN(TL:2, Val(TL:1))
    SCN(TM:2, Val(TM:1))
    SetFont(A:fac..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR'))
    AgregarMarco(G:fac..I:fac, 0, 0)
    AgregarMarco(J:fac..L:fac, 0, 0)
Proximo
IF Dialogo.Radio2 = 1
    SetFilaActual(fac+2)
    ACT(A:fac, 'Total Cartera General')
    ACN(D:fac, Val(TD:2))
    ACN(G:fac, Val(TG:2))
    ACN(H:fac, Val(TH:2))
    ACN(I:fac, Val(TI:2))
    ACN(J:fac, Val(TJ:2))
    ACN(K:fac, Val(TK:2))
    ACN(L:fac, Val(TL:2))
    ACN(M:fac, Val(TM:2))
    SetFont(A:fac..M:fac, 2)
    FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
    FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
    FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
    FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
    FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
    AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR'))
    AgregarMarco(G:fac..I:fac, 0, 0)
    AgregarMarco(J:fac..L:fac, 0, 0)
ENDIF
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(1, 10)
ACO(2, 15)
ACO(3, 10)
ACO(4, 10)
ACO(5, 10)
ACO(6, 10)
ACO(13, 15)
SetMargins(1, 1, 1, 1)
Impresion(1, 2)
SetPrintFit(3, 77)
LimitesVision(M:fac+1)