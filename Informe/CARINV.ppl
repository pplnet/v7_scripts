ACT(LV:1, SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "))
ACT(LV:2, SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
CrearDialogo
   Fecha1     : 'F.Desde'               ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha Desde Invalida';NO;Fsys
   Fecha2     : 'F.Hasta'               ;;;;;;Dialogo.Fecha2<=Fsys Y Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys
   Radio2     : 'Consolidado|SI|NO'     ;4;;;;;;;;0 
   Radio1     : 'Expresado|ARP|USD'     ;6;;;;;;;;0 
   Lista1     : 'Vehiculo'              ;1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LV:1), Val(LV:2))
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")

SetFilaActual(1)
ACT(C:fac, 'Cartera de Inversiones')
SetFont(C:fac, 3)

SetFilaActual(fac+2)
ACT(A:fac,'Desde: '~Dialogo.Fecha1)
ifa
ACT(A:fac,'Hasta: '~Dialogo.Fecha2)
ifa
***---LV:3 = Lista de Vehiculos a considerar
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculos: '~Dialogo.Lista1)
    ACT(LV:3, Dialogo.Lista1)
ELSE
    ACT(A:fac, 'Vehiculos: Todos')
    IF Vacio(UsrVehiculos(UsuarioActivo))
        ACT(LV:3, Val(LV:1))
    ELSE
        ACT(LV:3, Val(LV:2))
    ENDIF
ENDIF
ifa
ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))
ACT(MU:1, Var('MONEURU'))
***---Lista de Tipos de Resultados Realizados
ACT(RZ:1, Var('TIPORE2RZ'))
***---Lista de Tipos de Resultados NO Realizados
ACT(NR:3, Var('TIPORE2NRZ'))
***---Fecha Hasta para DC
*ACD(FE:66, PriDeMes(Dialogo.Fecha2,SI)-1)
ACN(DS:1, Dialogo.Fecha2 - Dialogo.Fecha1)
IF Dialogo.Radio1 = 0
    ACT(A:fac, 'Expresado en: ARP')
    ACT(MI:1, Val(ML:1))
    ACT(MI:2, 'ML')
ELSE
    ACT(A:fac, 'Expresado en: USD')
    ACT(MI:1, Val(ME:1))
    ACT(MI:2, 'MC')
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Consolidado: SI')
ELSE
    ACT(A:fac, 'Consolidado: NO')
ENDIF
SetFont(A:fac-4..A:fac, 2)
ifa
***---Cantidad de Vehiculos
IF Dialogo.Radio2 = 0
    ACN(CV:1, 1)
ELSE
    ACN(CV:1, Elementos(Val(LV:3)))
ENDIF
ACT(LS:1, Descendientes('ESPECIES','PUBLIC'))
ACT(LS:2, Descendientes('ESPECIES','PREGAR'))
ACT(LS:3, Descendientes('ESPECIES','NOTLET'))
ACT(LS:4, Descendientes('ESPECIES','CORP B'))
ACT(LS:5, Descendientes('ESPECIES','ACCION'))
ACT(LS:6, Descendientes('ESPECIES','FONDOS'))
ACT(LS:7, Descendientes('ESPECIES','FIDEIC'))
Recorrer&k 1, Val(CV:1)
    ifa
    ifa
    ACT(ES:5, '')
    ACN(TD:1, 0)
    ACN(TG:1, 0)
    ACN(TH:1, 0)
    ACN(TI:1, 0)
    ACN(TJ:1, 0)
    ACN(TK:1, 0)
    ACN(TL:1, 0)
    ACN(TM:1, 0)
    ***---Vehiculo/s a considerar en cada ciclo
    IF Dialogo.Radio2 = 0
        ACT(LV:4, Val(LV:3))
    ELSE
        IF &k > 1
            ***---SetFont(A:Val(FI:1)..M:fac, 1)
            SetFilaActual(fac+2)
        ENDIF
        ACT(LV:4, ItemLista(Val(LV:3), &k))
    ENDIF
    ACT(A:fac, 'Vehiculo/s: '~Val(LV:4))
    SetFont(A:fac, 2)
    ifa
    ACT(G:fac, '             Importe Resultados')
    ACT(J:fac, '   Resultados s/ Capital Expuesto')
    SetFont(G:fac..L:fac, 2)
    AgregarMarco(G:fac..L:fac, 0, 0, Exe('COLOR'))
    AgregarMarco(G:fac..I:fac, 0, 0)
    AgregarMarco(J:fac..L:fac, 0, 0)
