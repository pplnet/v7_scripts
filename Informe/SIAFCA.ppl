HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo

   Radio1     : "Transacciones|Ya Transmitidas|Sin Transmitir"     ;;;;;;;;;0
   Fecha2     : "F.Desde"              ;;;;;;Vacio(Dialogo.Fecha2) o Dialogo.Fecha2<=Dialogo.Fecha1;'Fecha Desde Vacia o Inferior a Fecha Hasta';NO;;
   Fecha1     : "F.Hasta"              ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha Hasta';NO;FSys;
   Vehiculo1  : 'Vehiculo'    ;;;;;;[Vacio(Dialogo.Vehiculo1) ] O [NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Vehiculo Invalido';NO;;;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");


FinDialogo

if not Ok
  Cancelar
endif


CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


  SetFilaActual(1)
  ACT(a:1,'Posicion Bancaria - CONFIDENCIAL')
  SetFont(a:1,1)


SetFilaActual(fac+2)
ACT(b:fac, 'Listado de Transferencias a CAP')
SetFont(f:fac, 3)

SetFilaActual(fac+1)
If Dialogo.Radio1=0
     ACT(a:fac+1, 'Ya Transmitido')
else
     ACT(a:fac+1, 'Sin Transmitir')
endif

if Dialogo.Fecha2 > 0
  SetFilaActual(fac+1)
  ACT(a:fac+1, 'Fecha Desde: '~Dialogo.Fecha2)
endif

SetFilaActual(fac+1)
ACT(a:fac+1, 'Fecha Hasta: '~Dialogo.Fecha1)

IF NoVacio(Dialogo.Vehiculo1)
    ACT(VH:10, Dialogo.Vehiculo1)
ELSE
    IF NoVacio(UsrVehiculos(UsuarioActivo))
        ACT(VH:10, UsrVehiculos(UsuarioActivo))
    ELSE
        ACT(VH:10, SQLSet(" Select Codigo From "~DBO~".VEHICULOS "))
    ENDIF
ENDIF

SetFilaActual(fac+1)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:fac+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
  ACT(a:fac+1, 'Vehiculo: Todos')
endif


SetFilaActual(fac+2)

ACT(A:fac,'Nro.Transaccion')
ACT(B:fac,'Tipo')
ACT(C:fac,'Moneda')
ACT(D:fac,'Desde Banco')
ACT(E:fac,'Desde Cuenta')
ACT(F:fac,'Hacia Banco')
ACT(G:fac,'Hacia Cuenta')
ACT(H:fac,'Importe')
ACT(I:fac,'Fecha Carga')
ACT(J:fac,'Fecha Acred')
ACT(K:fac,'CB2')
ACT(L:fac,'CB4')
ACT(M:fac,'Instancia')
ACT(N:fac,'Vehiculo')
ACT(O:fac,'Atomatico')
ACT(P:fac,'Ajustado')
ACT(Q:fac,'F.Ajuste')
ACT(R:fac,'F.Transm.')
ACT(S:fac,'CB10')
ACT(T:fac,'ID Cuenta Hacia')

ACT(cd1,'Trans. Sin Transmitir')

AgregarMarco(a:fac..t:fac,1,0,Exe('COLOR'))
Setfont(a2..t:fac, 1)
AlinearCeldas(A:fac..t:fac, 'C')


*--  Select

If Dialogo.Radio1=0
   *- Transmitidas ->
     SQL.ADD(" Select A.*, O.Nrbit, I.Fecha Fecha , C.codigo CTA, C.Alias7 from "~DBO~".Transacciones2 A ,")
     SQL.ADD("      "~DBO~".OPERACIONESBITS O ")
     SQL.ADD("   ,  "~DBO~".INSTANCIASOP I ")
     SQL.ADD("   ,  "~DBO~".CUENTAS C ")
     SQL.ADD("   where A.CB4 = '1' ")
*     SQL.ADD("     and (A.TipoTr2 like 'RET%' ) ")
     SQL.ADD("   and A.CB10 = '1' ")
     SQL.ADD("   AND A.NrTrans = O.NrOperacion ")
     SQL.ADD("   AND A.NrTrans = I.NrOperacion ")
     SQL.ADD("   AND A.Cuenta2 = C.Codigo ")
     SQL.ADD("   AND O.Valor = '1' ")
     SQL.ADD("   AND (I.Mensaje like 'IN0009%' or I.Mensaje like 'IN0011%') ") 
    if Dialogo.Fecha2 > 0
         SQL.ADD ("   and A.Fecha2 >= '"~Idxdate(Dialogo.Fecha2)~"' ")
     endif
     SQL.ADD ("   and A.Fecha2 <= '"~Idxdate(Dialogo.Fecha1)~"'  ")
     If NoVacio(Dialogo.Vehiculo1)
        SQL.ADD("and A.Vehiculo1 ='"~Dialogo.Vehiculo1~"' ")
     Endif

Else 
   *- No Transmitidas ->
     SQL.ADD(" Select A.*, O.Nrbit, '00' Fecha from "~DBO~".Transacciones2 A ,")
     SQL.ADD("      "~DBO~".OPERACIONESBITS O ")
     SQL.ADD("   where (A.CB4 <> '1' or A.CB4 is null) ")
     SQL.ADD("   AND A.NrTrans = O.NrOperacion ")
     SQL.ADD("   AND ((A.CB2 = '1' AND O.NrBit IN (17,18,20,50)) OR (A.CB2 = '0' AND O.NrBit >= 1) ) ") 
     SQL.ADD("   AND O.Valor = '1' ")
     SQL.ADD("     and (A.TipoTr2 like 'RET%' or A.TipoTr2 like 'CRVM%' or A.TipoTr2 like 'DEVM%'  ) ")
*     SQL.ADD("     and (A.TipoTr2 like 'RET%' or A.TipoTr2 like 'DEP%' ) ")
     SQL.ADD("   and A.CB10 = '1' ")

     if Dialogo.Fecha2 > 0
         SQL.ADD ("   and A.Fecha2 >= '"~Idxdate(Dialogo.Fecha2)~"' ")
     endif
     SQL.ADD ("   and A.Fecha2 <= '"~Idxdate(Dialogo.Fecha1)~"'  ")
     If NoVacio(Dialogo.Vehiculo1)
        SQL.ADD("and A.Vehiculo1 ='"~Dialogo.Vehiculo1~"' ")
     Endif

EndIf

SQL.ADD("order by A.Fecha2, A.NrTrans, A.TipoTr2")

acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
ACT(Z4,'0')
Recorrer SQL
    IF eqstr(val(Z4),FBN['Nrtrans'])
       dfa
    else
       ACT(a:fac,FBN['Nrtrans'])
       ACLT(a:fac,Val(a:fac))
       ACT(b:fac,FBN['Tipotr2'])
       ACT(c:fac,FBN['Especie'])
       ACT(d:fac,FBN['Cliente1'])
       ACT(e:fac,FBN['Cuenta1'])
       ACT(f:fac,FBN['Cliente2'])
       ACT(g:fac,FBN['Cuenta2'])
       ACN(h:fac,FBN['Cantidad1'])
       ACD(i:fac,FBN['Fecha1'])
       ACD(j:fac,FBN['Fecha2'])
       ACT(k:fac,FBN['CB2'])
       ACT(l:fac,FBN['CB4'])
       ACT(m:fac,FBN['Nrbit'])
       ACT(n:fac,FBN['Vehiculo1'])
       IF eqstr('1',FBN['CB6'])
          ACT(o:fac,'SI')
       endif
       ACT(p:fac,FBN['CB8'])
       if NoVacio(FBN['Fecha5'])
          ACD(q:fac,FBN['Fecha5'])
       endif
       IF eqstr('1',FBN['CB4'])
          ACD(r:fac,FBN['Fecha'])
       endif
       ACT(z4,FBN['Nrtrans'])
    endif
       IF eqstr('1',FBN['CB10'])
            ACT(s:fac,'SI')
       endif
       IF eqstr('1',FBN['CB4'])
            ACT(t:fac,FBN['Alias7'])
       endif

    SetFont(a:fac..t:fac, 2)
Proximo
Ifa
Ifa

AgregarMarco(a:fac..t:fac,1,0,Exe('COLOR'))

SetFont(a:fac..r:fac, 1)
Impresion(1,2)
act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)
SetFilaActual(fac+2)


LimitesVision(t:fac+1)
