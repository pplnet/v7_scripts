ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Vehiculo2  : "ContraParte" ;;;;;;;;;;;
  Especie1   : "Especie"     ;;;
  Fecha1     : "F.Desde"     ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"     ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos entre Vinculadas")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   if Vacio(UsrVehiculos(UsuarioActivo))
      ACT(a:FAC+1, 'Vehiculo : Todos')
   else   
      ACT(a:FAC+1, 'Vehiculo : '~val(zz6))
   endif
endif

if NoVacio(Dialogo.Vehiculo2)
   ACT(a:FAC+2, 'ContraParte : '~Dialogo.Vehiculo2~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
else
   ACT(a:FAC+2, 'ContraParte : Todas')
endif

if NoVacio(Dialogo.Especie1)
   ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
   ACT(a:FAC+3, 'Especie : Todos')
endif

ACT(a:FAC+4, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a:fac..N:FAC+5,2)

SetFilaActual(FAC+7)

ACT(a:FAC, 'Vehiculo 1')
ACT(b:FAC, 'Vehiculo 2')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Número Op.')
ACT(e:FAC, 'TipoOp.Veh1')
ACT(f:FAC, 'Fecha')
ACT(g:FAC, 'Movimiento')

AlinearCeldas(a:FAC..i:FAC,'I')
SetFont(a:fac..g:FAC,2)
AgregarMarco(a:FAC..g:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)

SQL.ADD("Select O.* from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp = 'VIMD' ")

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD(" and O.Vehiculo2='"~Dialogo.Vehiculo2~"' ")
EndIf

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If Vacio(Dialogo.Vehiculo1) y Vacio(Dialogo.Vehiculo2)
   SQL.ADD(" and  Vehiculo1+Vehiculo2  <= Vehiculo2+Vehiculo1 ")
EndIf

SQL.ADD("order by O.Vehiculo1, O.Vehiculo2, O.Especie, O.FechaOp ")

ACT(X1,' ')
ACT(X3,' ')
ACT(X4,' ')
acn(x2,0)
acn(x5,0)
acn(x6,0)
acn(x7,0)
acn(x9,0)

