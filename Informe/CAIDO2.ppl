ModoReproceso(ConDialogo)
CrearDialogo
  Cliente1   : "Entidad"           ;;;
  Vehiculo1  : "Vehiculo"          ;;;
  Especie1   : "Especie"           ;;;
  TipoOp1    : "Tipo Op."          ;;;
  Fecha1     : "Fecha"             ;;;
  Especie2   : "Equivalente"       ;;;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+1, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+1, 'Entidad : Todos')
endif
act(a:fac+2,'Fecha : '~Dialogo.Fecha1)
SetFont(a:fac..N:FAC+3,2)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Fecha Op.')
ACT(b:FAC, 'Plazo')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Fecha Vto.')
ACT(g:FAC, 'Tipo Op.')
ACT(h:FAC, 'Numero Op.')
ACT(i:FAC, 'Cliente')
SetFont(a:FAC..i:FAC,2)
AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" C.Fecha3 Vto ,  ")
SQL.ADD(" C.Total1 Cant, 'CUO' as Tipo ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
else
   SQL.ADD(" and O.TipoOp In ('MMON','MMONM','MMFRNP','MMFIMV') ")
endif
SQL.ADD(" and C.Fecha3 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
*----------------------------------------------------------
SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" C.Fecha2 Vto,  ")
SQL.ADD(" C.Total1 Cant, 'CUO' as Tipo ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
else
   SQL.ADD(" and O.TipoOp In ('MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPLME','MMPSI','MMSIMV') ")
endif
SQL.ADD(" and C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
*----------------------------------------------------------
* Operaciones con FechaVto y TotalNetoCli1
* 
SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" O.FechaVto Vto,  ")
SQL.ADD(" O.TotalNetoCli1 Cant, 'OPE' as Tipo ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMON','MMPCL','MMPCOS','MMPE','MMPI','MMPSI','MMFRNP') ")

if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif

SQL.ADD(" and O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
*----------------------------------------------------------
* Operaciones con FechaVto y TotalNetoCli1
* 
SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" O.FechaVto2 Vto,  ")
SQL.ADD(" O.TotalNetoCli1 Cant, 'OPE' as Tipo ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMON','MMFRNP') ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif
SQL.ADD(" and O.FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
*----------------------------------------------------------
* Operaciones con FechaVto y TotalBrutoCli1
* 
SQL.ADD("Select O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" O.FechaVto Vto,  ")
SQL.ADD(" O.TotalBrutoCli1 Cant, 'OPE' as Tipo ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMPLME') ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif
SQL.ADD(" and O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Union ")
*----------------------------------------------------------
SQL.ADD("Select All O.NrOperacion, O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie, O.TipoOp,O.Cliente1, ")
SQL.ADD(" C.Fecha1 Vto,  ")
SQL.ADD(" C.Importe4 Cant,Tipo  ")
SQL.ADD(" from "~DBO~".COMISIONES2 C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
else
   SQL.ADD(" and (O.TipoOp In ('MMON','MMONM','MMPCL','MMPCLM','MMPCOS','MMPE','MMPEM','MMPI','MMPIM','MMPOSM','MMPLME','MMFRNP','MMFIMV''MMPSI','MMSIMV') ")
   SQL.ADD(" or ( O.TipoOp In ('MMP') and Tipo='4')) ")
endif
SQL.ADD(" and  C.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("order by 1, 3 ")

* Z1: Acumulador
acn(z1,0)

Recorrer SQL
  acd(a:fac,fbn['FechaOp'])   
  acn(b:fac,fbn['FechaVto']-Fsys)   
  act(c:fac,fbn['vehiculo1'])   
  act(d:fac,fbn['Especie'])   
  acn(e:fac,fbn['Cant']*CotizacionC(fbn['Especie'],,,,Fsys,1,SI,Dialogo.Especie2))   
  scn(z1,val(e:fac))
  acd(f:fac,fbn['FechaVto'])
  act(g:fac,fbn['TipoOp'])   
  act(h:fac,fbn['NrOperacion'])   
  aclo(h:fac,fbn['NrOperacion'])  
  act(i:fac,fbn['Cliente1'])    
  SetFont(a:fac..i:fac,1)
  FormatoCeldas(b:fac..b:fac, Exe('F0'))
proximo

ACT(a:fac+1,'Total en '~Dialogo.Especie2~' ...')
ACN(e:fac+1,VAL(z1))

SetFont(a:fac+1..i:fac+1,1)
AgregarMarco(a:FAC+1..i:FAC+1,2,0)

Recorrer&i 1,8
  ACO(&i,10)
proximo

Impresion(1,2)

SetFilaActual(fac+3)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(i:FAC)
*RangoTitulo(a1..k:8,36)
