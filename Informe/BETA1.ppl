ModoReproceso(SinDialogo)
CrearDialogo
  Operador     : "Op"       ;;;;NO;NO;;;;;
  String       : "d"        ;;;;NO;NO;;;;;
  Fecha1       : "F"        ;;;;NO;NO;;;;;
FinDialogo

if Not Ok
  Cancelar
endif

acn(i1,0)
acn(i2,0)

CrearFont(1,"Arial,14,B")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")

SetFilaActual(2)

SetFont(a:2..b:2,1)

ACT(a:FAC, Dialogo.String~Dialogo.Operador)
SetFont(a:fac..a:fac,1)

SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC, 'Numero de Operacion')
ACT(b:FAC, 'Atributo Cantidad')

AlinearCeldas(a:FAC+1..f:FAC+1,'I')
AlinearCeldas(g:FAC+1..g:FAC+1,'D')
AlinearCeldas(h:FAC+1..l:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..z:FAC+1,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+2)

ACT(a:FAC, 'TIPOS: MMDC,MMDCA,MMCCR,MMCP,MMCPR,MMCPRV, MMCPV')
SetFilaActual(FAC+1)
*message('Modificando posibles MMDC,MMDCA,MMCP,MMCPR,MMCPRV, MMCPV')
   SQL.ADD("Select O.NrOperacion, O.Cantidad ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("  where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto is Null) ")
   SQL.ADD("  and O.TipoOp In ('MMDC','MMDCA','MMCCR','MMCP','MMCPR','MMCPRV','MMCPV') ")
   SQL.ADD("  and O.Operador = '"~Dialogo.Operador~"' ")
   SQL.ADD("Order by O.NrOperacion ")
   Recorrer SQL
*messagebox('1')
       ACT(a:FAC, FBN['NrOperacion'])
       ACT(b:FAC, FBN['Cantidad'])
       SetFont(a:FAC..b:FAC,2)
       acn(i1,val(i1)+1)
       acn(i2,val(i2)+fbn['Cantidad'])

*acn(d1,val(d1)+1)
   Proximo
*messagebox('Grupo 1  '~val(d1))

SetFilaActual(FAC+2)
