CrearDialogo
  Fecha1     : "FechaFut"             ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "FechaOp"              ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Radio1     : '|Compra|Venta|Ambos'  ;;;;;;
  Especie1   : 'Titulo'               ;;;;;;
  Entero1    : 'NrSaldo'              ;;;;;;
  Book1      : 'Cartera'              ;;;;;;
  Mercado1   : 'Mercado'              ;;;;;;;;;;;;;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)

ACT(a:FAC, "Movimientos de Posicion")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)
ACT(a:fac, 'Fecha Futuro: '~IIF(Dialogo.Fecha1>0,Dialogo.Fecha1,'Todas'))
ifa
ACT(a:fac, 'Fecha Ops: '~Dialogo.Fecha2)
ifa
*ACT(A:fac, 'Tipos Op: '~IIF(Dialogo.Radio1=0,'Compras',IIF(Dialogo.Radio1=1,'Ventas','Todas')))
ACT(A:fac, 'Tipos Movs: '~IIF(Dialogo.Radio1=0,'Ingresos',IIF(Dialogo.Radio1=1,'Egresos','Todos')))
ifa
ACT(A:fac, 'Especie: '~IIF(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ifa
ACT(A:fac, 'Book: '~IIF(NoVacio(Dialogo.Book1),Dialogo.Book1,'Todos'))
SetFont(a:fac-4..a:fac,2)


SetFilaActual(FAC+2)
ACT(a:FAC, 'Descripcion')
ACT(b:FAC, 'Fecha Op')
ACT(c:FAC, 'Fecha Vto.')
ACT(d:FAC, 'Espcie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Precio')
ACT(g:FAC, 'Operacion')
ACT(h:FAC, 'Tipo')
ACT(i:FAC, 'Cartera')
ACT(j:FAC, 'Origen')
SetFont(a:Fac..J:Fac,2)
AgregarMarco(a:Fac..J:Fac,2,0,Exe('COLOR6'))

ACN(w:1, FAC+1)

SQL.ADD("Select ")
** FJL 19/12/18 - Va fecha y cantidad del movimiento
SQL.ADD(" O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.Precio1, O.NrOperacion, O.TipoOp, O.Book1, O.Mercado as Origen, M.FechaMov, M.Cantidad CantMov ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJEFUT M ")
SQL.ADD("Where O.NrOperacion = M.NrOperacion   ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie= '"~Dialogo.Especie1~"' ")
* FJL 16/11/18 - Duplicaba lineas porque hay tambien movimientos por ARP
   SQL.ADD(" and M.Especie= '"~Dialogo.Especie1~"' ")
EndIF
If Dialogo.Fecha1>0
  SQL.ADD(" and O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
EndIF
If Dialogo.Fecha2>0
** FJL 14/12/18 - Mostraba dos movimientos xq ya tenia los dos ejecutados (Concertacion y Vto)
** Agrego esta validacion
** FJL 19/12/18 - Cambio la validacion
*   SQL.ADD(" and O.FechaOp = '"~IdxDate(Dialogo.Fecha2)~"' ")
   SQL.ADD(" and M.FechaMov = '"~IdxDate(Dialogo.Fecha2)~"'")
EndIF
** FJL 19/12/18 - Cambio la validacion
*If Dialogo.Radio1=0 
*  SQL.ADD(" and O.TipoOp in ('TICF','FXCF') ")
*EndIf
*If Dialogo.Radio1=1
*  SQL.ADD(" and O.TipoOp in ('TIVF','FXVF') ")   
*EndIf
SQL.ADD(" and O.TipoOp in ('TICF','FXCF','TIVF','FXVF') ")
If Dialogo.Radio1=0 
  SQL.ADD(" and M.Cantidad>0 ")
EndIf
If Dialogo.Radio1=1
  SQL.ADD(" and M.Cantidad<0 ")
EndIf
If NoVacio(Dialogo.Entero1)
   SQL.ADD(" and M.NrSaldo = '"~Dialogo.Entero1~"' ")
EndIF
If NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1= '"~Dialogo.Book1~"' ")
EndIF
** AGREGO FILTRO POR MERCADO
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and O.Mercado= '"~Dialogo.Mercado1~"' ")
EndIF
SQL.ADD(" Order by O.FechaOp ")
Recorrer SQL
*  if Fbn['FechaMov']=Fbn['FechaOp']
*    ACT(a:Fac, 'Alta de Operacion')
*  endif
*  if Fbn['FechaMov']=Fbn['FechaVto']
*    ACT(a:Fac, 'Vto de Operacion')
*  endif
  if [Incluido(fbn('TipoOp'),'TICF|FXCF') y fbn('CantMov')>0] o [Incluido(fbn('TipoOp'),'TIVF|FXVF') y fbn('CantMov')<0]
    ACT(a:Fac, 'Alta de Operacion')
  else
    ACT(a:Fac, 'Vto de Operacion')
  endif
  ACD(b:Fac, Fbn['FechaOp'])
  ACD(c:Fac, Fbn['FechaVto'])
  ACT(d:Fac, Fbn['Especie'])
  ACT(ab:FAC, SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaVto'])~"' and MercadoNegociacion='"~Fbn['Origen']~"' "))
  if EqStr(Fbn['Origen'],'ROFEX')
    ACT(d:Fac, Val(d:FAC)~' - '~Val(ab:FAC))
  endif
** FJL 19/12/18 - Va cantidad del movimiento
*  ACN(e:Fac, Fbn['Cantidad'])
  ACN(e:Fac, Fbn['CantMov'])
  ACN(f:Fac, Fbn['Precio1'])
  ACT(g:Fac, Fbn['NrOperacion']) 
  ACLO(g:Fac, Fbn['NrOperacion'])
  ACT(h:Fac, Fbn['TipoOp'])
  ACT(i:Fac, Fbn['Book1'])
  ACT(j:Fac, Fbn['Origen'])
  SCN(xx:1, Val(E:Fac))
  SCN(xx:2, Val(E:Fac)*Val(F:Fac))
Proximo 
SetFilaActual(FAC+2)
ACT(a:Fac,'Total')
ACN(e:Fac,val(xx:1))
ACN(f:Fac,val(xx:2)/val(xx:1))
SetFont(a:FAC..f:FAC, 2)

FormatoCeldas(e:Val(w:1)..e:fac,Exe('F2'))
FormatoCeldas(f:Val(w:1)..f:fac,Exe('F7'))

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)

