CrearDialogo
    Radio1     : 'Color|Rojo|Azul|Amarillo|Verde' ;1;1;;;;;;;
    Fecha1     : 'Fecha de informe'               ;1;2;;;;;;;FSYS;
    Cliente1   : 'Cliente a modificar'            ;4;1;;;;NoVacio(Cliente1);"Debe ingresar un cliente";NO;;
    String1    : 'Nueva Razon Social'             ;5;1;;;;NoVacio(String1);"Debe ingresar una nueva razon social";NO;
FinDialogo

IF NOT OK
    Cancelar
ENDIF

(.'TOMI'.)





*Determinar color segun seleccion del combo Radio1
If Dialogo.Radio1 = 0
    &colorFondo := RGB(255,0,0)
EndIf
If Dialogo.Radio1 = 1
    &colorFondo := RGB(0,0,255)
EndIf
If Dialogo.Radio1 = 2
    &colorFondo := RGB(255,255,0)
EndIf
If Dialogo.Radio1 = 3
    &colorFondo := RGB(0,128,0)
EndIf

*Configurar anchos de columna
ACO(1,15)
ACO(2,30)
ACO(3,15)
ACO(4,15)
ACO(5,15)
AFI(3,45)
AFI(6,35)

*Crear fuentes
CrearFont(1,'Arial,12,B')
CrearFont(2,'Arial,10')

*Poner la fecha del dia tomada del dialogo
SetFilaActual(1)
ACT(A:1, 'Fecha elegida: ')
ACD(B:1, Dialogo.Fecha1)

*Poner titulo mergeado con ABT y color de fondo
SetFilaActual(3)
ABT(A:3..E:3, 'Informe para demo')
ColorCeldas(A:3..E:3, &colorFondo)
AgregarMarco(A:3..E:3, 2, 1, RGB(222,222,222))
SetFont(A:3..E:3, 1)
AlinearCeldas(A:3..E:3, 'C')

*Consultar tabla Clientes
SQL.ADD("Select TOP(100) * From Clientes Order By RazonSocial")

*Encabezado de la grilla
SetFilaActual(5)
ABT(A:FAC..E:FAC, "100 Registros traídos de la tabla Clientes (ordenados por RazonSocial)")
IFA
ACT(A:FAC, 'Codigo')
ACT(B:FAC, 'RazonSocial')
ACT(C:FAC, 'NrCuenta')
SetFont(A:FAC, 1)
AgregarMarco(A:FAC..C:FAC, 2, 1, &colorFondo)

*Recorrer SQL y completar grilla con columna RazonSocial
Recorrer SQL
    ACT(A:FAC, FBN["Codigo"])
    ACT(B:FAC, FBN["RazonSocial"])
    ACT(C:FAC, FBN["NrCuenta"])
Proximo

*Fin del listado
IFA
ACT(A:FAC, 'FIN DEL LISTADO')
SetFont(A:FAC, 1)

LimitesVision(E:FAC)
