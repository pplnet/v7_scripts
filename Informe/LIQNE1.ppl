CrearDialogo
    Fecha1 :   'Fecha'     ;;;;;;;;;FSYS
    Cliente1:  'Banco'     ;2;1;;;;Vacio(Dialogo.Cliente1) o Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN');'Banco invalido';NO;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES', 'BANCOS'))~") "
    Especie1:  'Especie'   ;3;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1,'TITULO') o DesciendeDeEspecie(Dialogo.Especie1,'FONDOS');'Especie Invalida';NO;;;;;;" (Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','TITULO'))~") OR Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','FONDOS'))~")) and Status = 'HAB'";
    Book1:     'Cartera'   ;4;1;;;;;;;;;;;;;
    Lista2:    'Vehiculos' ;5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') and TipoVehiculo <> 'NOC' "),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V where U.Vehiculo=V.Codigo and U.Codigo = '"~UsuarioActivo~"' and V.TipoVehiculo <> 'NOC' "))
    Lista1:    'Cuentas'   ;-1;2;;;;;;;;;IIF(NoVacio(Dialogo.Lista2), SQLSet(" Select Codigo From "~DBO~".CUENTAS Where TipoCuenta = 'CUS' AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NoVacio(Dialogo.Cliente1), " AND Comitente = '"~Dialogo.Cliente1~"' ")))
FinDialogo

If Not Ok
    Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,12,B")

SetFilaActual(1)

ACT(C:FAC, 'Liquidaciones del día Neteadas')
SetFont(C:FAC, 4)
ifa
ifa
ACN(NN:1, FAC)
IF NoVacio(Dialogo.Lista2)
    ACT(A:FAC,'Vehículos: '~Dialogo.Lista2)
ELSE
    ACT(A:FAC,'Vehículos: Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:FAC,'Banco: '~Dialogo.Cliente1)
ELSE
    ACT(A:FAC,'Bancos: Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Especie1)
    ACT(A:FAC,'Especie: '~Dialogo.Especie1)
ELSE
    ACT(A:FAC,'Especies: Todas')
ENDIF
ifa
IF NoVacio(Dialogo.Book1)
    ACT(A:FAC,'Book: '~Dialogo.Book1)
ELSE
    ACT(A:FAC,'Books: Todos')
ENDIF
IF NoVacio(Dialogo.Lista1)
    ACT(A:FAC,'Cuentas: '~Dialogo.Lista1)
ELSE
    ACT(A:FAC,'Cuentas: Todas')
ENDIF
SetFont(A:Val(NN:1) .. A:FAC, 2)

SetFilaActual(FAC+2)

ACT(A:FAC, 'Vehiculo')
ACT(B:FAC, 'Banco')
ACT(C:FAC, 'Especie')
ACT(D:FAC, 'Cuenta')
ACT(E:FAC, 'Book')
ACT(F:FAC, 'Importe')
SetFont(A:FAC .. F:FAC, 2)
AgregarMarco(A:FAC .. F:FAC, 2, 2, EXE('COLOR6'))
AlinearCeldas(A:FAC .. F:FAC, 'C')

SQL.ADD("Select C.Cliente as Vehiculo, M.Cuenta, C.Comitente, M.Especie, M.Book, ") 
SQL.ADD("Sum(M.Cantidad) as Importe from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C ")
SQL.ADD("Where M.Cuenta = C.Codigo And M.NrSaldo = 10 And M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD("And C.Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    SQL.ADD("And C.Cliente IN ("~Pipe2Comillas(SQLSet("select Codigo From "~DBO~".VEHICULOS"))~") ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD("And M.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD("And C.Comitente = '"~Dialogo.Cliente1~"' ")
ENDIF
If Novacio(Dialogo.Lista1)
  SQL.ADD("And C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD("Group by C.Cliente, M.Cuenta, C.Comitente, M.Especie, M.Book")

ACN(CN:1, FAC+1)
Recorrer SQL
    ACT(A:FAC, FBN('Vehiculo'))
    ACT(B:FAC, FBN('Comitente'))
    ACT(C:FAC, FBN('Especie'))
    ACT(D:FAC, FBN('Cuenta'))
    ACT(E:FAC, FBN('Book'))
    ACN(F:FAC, FBN('Importe'))
    ACL(F:FAC, 'DETNET', Fecha1 = Dialogo.Fecha1, Vehiculo1 = Val(A:FAC), Cliente1 = Val(B:FAC), Especie1 = Val(C:FAC), Cuenta1 = Val(D:FAC), Book1 = Val(E:FAC))
Proximo
SetFont(A:Val(CN:1) .. F:FAC, 1)
AgregarMarco(A:Val(CN:1) .. F:FAC, 1, 2)
FormatoCeldas(F:Val(CN:1) .. F:FAC, EXE('F2'))

SetFilaActual(FAC+2)
ACT(A:FAC, 'Fin del Informe.')
SetFont(A:FAC, 2)

ACO(1, 10)
ACO(2, 10)
ACO(4, 10)
ACO(5, 10)
ACO(6, 10)

LimitesVision(G:FAC+1)
