MostrarCuadroDeMensajes
CrearDialogo
  Radio1  :'Objeto|Informe|Evento|Funcion|'   ;2;1;;;;Dialogo.Radio1 >= 0;'Seleccion Objeto Invalida';NO;0 
  Radio2  :'Ordenamiento|Codigo|Descrip.|'    ;3;1;;;;Dialogo.Radio2 >= 0;'Seleccion Ordenamiento Invalida';NO;0
  Lista1  : "Lista Objetos"                   ;;;;;;;;;;;IIF(Dialogo.Radio1=0,SQLSet("SELECT Codigo FROM "~DBO~".INFORMES "),IIF(Dialogo.Radio1=1,SQLSet("SELECT Codigo FROM "~DBO~".EVENTOS "),SQLSet("SELECT Codigo FROM "~DBO~".FUNCIONES ")));SI
FiNdialogo



if Not OK
  Cancelar
endif

*(.'ABCDARIO'.)
*(.'NUMERARIO'.)

** Fonts
CrearFont(1,'Tahoma,14,B,S')
CrearFont(3,'Arial,9,B')
CrearFont(2,'Arial,9,B,S')
CrearFont(4,'Arial,8,')
CrearFont(5,'Arial,8,B,S')

ACN(xz40,0)

** Titulos
AgregarBMP(a1,Exe('LOGO'),80)
ACT(xy11,iif(Dialogo.Radio1=0,'Informe',iif(Dialogo.Radio1=1,'Evento','Funcion')))
ACT(c:2, 'Objetos Contenidos en '~Val(xy11))

if Dialogo.Radio2=0
   ACT(c:3,'Ordenado por Codigo de '~Val(xy11))
Else
   ACT(c:3,'Ordenado por Descripcion del '~Val(xy11))
Endif

AlinearCeldas(c:2..c:3,'C')

SetFont(c:2, 1)
SetFilaActual(5)
ACT(a:fac-1,'Fecha :  '~VAR('FECHASYS'))
SetFont(a:FAC-1, 3)

SetFont(a:Fac, 2)

SetFilaActual(fac+2)

act(a:fac, "Codigo")
act(b:fac, "Nombre")
act(c:fac, "Menu")
act(d:fac, "Descripcion")

SetFont(a:fac..d:fac,3)
AgregarMarco(a:fac..g:fac,2,0,RGB(254,228,126))

ACN(xy1,fac)

ACN(vx1,Val(xy1))
Message('Recuperando Informacion.....')

If Dialogo.Radio1=0
   ACT(xy2,'INFORMES')
   SQL.ADD("select Codigo, Nombre ")
   SQL.ADD("from "~DBO~".INFORMES   ")   
   IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" Where Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   ENDIF
Else
   If Dialogo.Radio1=1
      ACT(xy2,'EVENTOS')
      SQL.ADD("select Codigo, Nombre ")
      SQL.ADD("from "~DBO~".EVENTOS   ")   
*      SQL.ADD(" Where Codigo = 'ONLMAE' ")
      IF NoVacio(Dialogo.Lista1)
         SQL.ADD(" Where Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
      ENDIF
   Else
      ACT(xy2,'FUNCIONES')
      SQL.ADD("select Codigo, Descripcion Nombre ")
      SQL.ADD("from "~DBO~".FUNCIONES   ")
      IF NoVacio(Dialogo.Lista1)
         SQL.ADD(" Where Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
      ENDIF   
   Endif
Endif

If Dialogo.Radio2=0
   SQL.ADD(" Order By Codigo  ")
Else
   SQL.ADD(" Order By Nombre  ")
Endif

** recorrer Seleccion de objetos
Recorrer SQL

  SCN(xz40,1)

  ACT(aa1, BuscarLinkearHojas(Val(xy2), FBN['Codigo']))

  SCN(xy1,1)
  ACT(a:val(xy1), FBN['Codigo'] ) 
  ACT(b:val(xy1), FBN['Nombre'] ) 
  SetFont(a:val(xy1)..a:val(xy1), 3)

  if NoVacio(Val(aa1))
     SCN(xy1,1)
     ACT(b:val(xy1), 'Informes Contenidos')
     SetFont(b:val(xy1)..b:val(xy1), 3)
  
     ACN(xy44,Elementos(Val(aa1)))
     SCN(xz40,Val(xy44))
     ACN(xy50,0)
    
     Recorrer&i 1,Val(xy44)
       
        SCN(xy50,1)     
        Message('Informes '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy44),1,0))
      
        SCN(xy1,1)
        ACT(t1,Mirt(Trim (ItemLista(Val(aa1), &i))))
        ACT(b:val(xy1), val(t1))
       
        SQL.ADD("select I.Tipo, I.Nombre, T.Descripcion ")
        SQL.ADD("from "~DBO~".INFORMES I, "~DBO~".TIPOSINFORME T  ")   
        SQL.ADD("where I.Codigo = '"~Val(t1)~"'  ")
        SQL.ADD(" and T.Codigo= I.Tipo ")
       
        Recorrer SQL
        
          act(b:val(xy1),Val(b:val(xy1))~' - '~fbn('Nombre'))
          act(c:val(xy1),fbn('Tipo'))
          act(d:val(xy1),fbn('Descripcion'))

          ACT(aa10, BuscarLinkearHojas('INFORMES', Val(t1)))
          if NoVacio(Val(aa10))
             act(b:val(xy1)+1,'Incluye Informe')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa10)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa10), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'INFORMES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa20, BuscarEjecutarEventos('INFORMES', Val(t1)))
          if NoVacio(Val(aa20))
             act(b:val(xy1)+1,'Incluye Evento')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa20)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa20), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'EVENTOS')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa30, BuscarFunciones('INFORMES', Val(t1)))
          if NoVacio(Val(aa30))
             act(b:val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa30)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa30), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'FUNCIONES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif
           
        Proximo
      
     Proximo
  
  Endif

  ACT(aa2, BuscarEjecutarEventos(Val(xy2), FBN['Codigo']))
  if NoVacio(Val(aa2))
     SCN(xy1,1)
     ACT(b:val(xy1), 'Eventos Contenidos')
     SetFont(b:val(xy1)..b:val(xy1), 3)
     ACN(xy44,Elementos(Val(aa2)))
     SCN(xz40,Val(xy44))
     ACN(xy50,0)
     Recorrer&i 1,Val(xy44)
        SCN(xy50,1)     
        Message('Eventos '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy44),1,0))

        SCN(xy1,1)
        ACT(t1,Mirt(Trim (ItemLista(Val(aa2), &i))))
        ACT(b:val(xy1), val(t1))

        SQL.ADD("select E.Tipo, E.Nombre, T.Descripcion ")
        SQL.ADD("from "~DBO~".EVENTOS E, "~DBO~".TIPOSEVENTO T  ")   
        SQL.ADD("where E.Codigo = '"~Val(t1)~"'  ")
        SQL.ADD(" and T.Codigo= E.Tipo ")

        Recorrer SQL
          act(b:val(xy1),Val(b:val(xy1))~' - '~fbn('Nombre'))
          act(c:val(xy1),fbn('Tipo'))
          act(d:val(xy1),fbn('Descripcion'))

          ACT(aa10, BuscarLinkearHojas('EVENTOS', Val(t1)))
          if NoVacio(Val(aa10))
             act(b:val(xy1)+1,'Incluye Informe')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa10)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa10), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'INFORMES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa20, BuscarEjecutarEventos('EVENTOS', Val(t1)))
          if NoVacio(Val(aa20))
             act(b:val(xy1)+1,'Incluye Evento')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa20)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa20), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'EVENTOS')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa30, BuscarFunciones('EVENTOS', Val(t1)))
          if NoVacio(Val(aa30))
             act(b:val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa30)))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa30), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'FUNCIONES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif
           
        Proximo


   Proximo    
  Endif

  ACT(aa3, BuscarFunciones(Val(xy2), FBN['Codigo']))
  if NoVacio(Val(aa3))
     SCN(xy1,1)
     ACT(b:val(xy1), 'Funciones Contenidas')
     SetFont(b:val(xy1)..b:val(xy1), 3)

     ACN(xy44,Elementos(Val(aa3)))
     **messagebox('1 - '~val(xy99)~' - '~val(aa3))
     SCN(xz40,Val(xy44))
     ACN(xy50,0)
     Recorrer&i 1,Val(xy44)
       SCN(xy50,1)     
       Message('Funciones '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy44),1,0))

       SCN(xy1,1)
       ACT(t1,Mirt(Trim (ItemLista(Val(aa3), &i))))
       ACT(b:val(xy1), val(t1))
       ACT(b:val(xy1), Val(b:val(xy1))~' - '~Sql("Select Descripcion from "~DBO~".FUNCIONES where Codigo='"~Val(t1)~"' "))

          ACT(aa10, BuscarLinkearHojas('FUNCIONES', Val(t1)))
          if NoVacio(Val(aa10))
             act(b:val(xy1)+1,'Incluye Informe')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa10)))
             **messagebox('2 - '~val(xy99)~' - '~val(aa10))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa10), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'INFORMES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa20, BuscarEjecutarEventos('FUNCIONES', Val(t1)))
          if NoVacio(Val(aa20))
             act(b:val(xy1)+1,'Incluye Evento')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa20)))
             **messagebox('3 - '~val(xy99)~' - '~val(aa1))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa20), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'EVENTOS')
                ACT(xx2,Val(t10))
                ACN(xx3,2)
                (.'PDPFUNC1'.)
             proximo
          Endif

          ACT(aa30, BuscarFunciones('FUNCIONES', Val(t1)))
          if NoVacio(Val(aa30))
             act(b:val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(b:val(xy1)+1,'D')
             SetFont(b:val(xy1)+1, 5)
             ACN(xy55,Elementos(Val(aa30)))
             **messagebox('4 - '~val(xy77)~' - '~val(aa1))
             SCN(xz40,Val(xy55))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy55)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa30), &j))))
                ACT(c:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xx1,'FUNCIONES')
                ACT(xx2,Val(t10))
                ACN(xx3,3)
                (.'PDPFUNC1'.)
             proximo
          Endif

     Proximo
  endif

  ** Fin Seleccion de Objetos
Proximo 


if Val(xy1) <= 7
   SCN(xy1,3)   
   ACT(b:Val(xy1),'No hay objetos para esta seleccion')
endif


ACO(1, 8)
ACO(2, 28)
ACO(3, 10)
ACO(4, 12)
ACO(5, 12)
ACO(6, 12)
ACO(7, 45)
ACO(8, 1)

setfilaactual(val(xy1)+2)

ACT(b:fac, 'Se han Informado '~PYC(Val(xz40),1,0)~' Objetos')
SetFont(b:fac, 2)

setfilaactual(fac+2)

ACT(a:fac, 'FIN DEL LISTADO')
SetFont(A:fac, 2)
*if NoVacio(Val(aa15)) O NoVacio(Val(aa25)) O NoVacio(Val(aa35))
*messagebox('YYYYY')
  Impresion(1,2)
  SetPrintFit(3, 80)
*else
*  Impresion(1,1)
*  SetPrintFit(3, 90)
*Endif
Impresion(4,1)
LimitesVision(h:fac+1)
SetMargins(0.5,0.5,0.5,1.5)
RangoTitulo(a:1..f:fac+1, val(vx1))