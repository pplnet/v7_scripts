ModoReproceso(SinDialogo)
CrearDialogo
  Cliente1         : "Cliente"       ;;;;;;;;;;;;;;"Codigo IN (Select Distinct Cliente1 from "~DBO~".TRANSACCIONES2)";
  Vehiculo2        : "Vehiculo"      ;;;;;;EsTerminal(Dialogo.Vehiculo2, Vehiculos) o Vacio (Dialogo.Vehiculo2);'Debe ingresar un Vehiculo';NO;;;;;;"TipoVehiculo = 'DIV' and Codigo IN (Select Distinct Vehiculo1 from "~DBO~".TRANSACCIONES2)";;
  Especie1         : "Especie"       ;;;;;;Vacio(Dialogo.Especie1) o DesciendedeEspecie(Dialogo.Especie1, 'TITULO');'Especie invalida';NO;;;;;;"Codigo IN (Select Distinct Especie from "~DBO~".TRANSACCIONES2)";
  Operador1        : "Operador"      ;;;;;;;;;UsuarioActivo;;;;;"Codigo IN (Select Distinct UsrInput from "~DBO~".TRANSACCIONES2)";
  Fecha1           : "F.Tr.Desde"    ;;;;;;Dialogo.Fecha1<>0;'FechaDesde invalida';NO;FSys-30;
  Fecha2           : "F.Tr.Hasta"    ;;;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2>=Dialogo.Fecha1;'FechaHasta invalida';NO;FSys;
  TipoTr1          : "TipoTr"        ;;;;;;;;;;;;;;"Codigo IN (Select Distinct TipoTr2 from "~DBO~".TRANSACCIONES2)";
  NrOperacionRef1  : "NrOperacion"   ;;;;;;;;;;;;;;"NrOperacion IN (Select Distinct NrOperacionRef1 from "~DBO~".TRANSACCIONES2)";
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo2)
   If Not Incluido(Dialogo.Vehiculo2, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz:6,Dialogo.Vehiculo2~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz:6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)

ACT(a:1, "General de Transacciones")
ACT(d:1,'Fecha: '~Var('FECHASYS'))
SetFont(a:1,3)
SetFont(d:1,2)

SetFilaActual(3)

if NoVacio(Dialogo.Cliente1)
  ACT(a:fac+1, 'Cliente: '~Dialogo.Cliente1)
else
  ACT(a:fac+1, 'Cliente: Todos')
endif

if NoVacio (Dialogo.Vehiculo2)
   ACT(a:fac+2, 'Vehiculo: '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
else
   ACT(a:fac+2, 'Vehiculo: Todos')
endIf

if NoVacio(Dialogo.Especie1)
  ACT(a:fac+3, 'Especie: '~Dialogo.Especie1)
else
  ACT(a:fac+3, 'Especie: Todas')
endif

if NoVacio(Dialogo.Operador1)
  ACT(a:fac+4, 'Operador: '~Dialogo.Operador1)
else
  ACT(a:fac+4, 'Operador: Todos')
endif

ACT(a:fac+5, 'F.Tr.Desde: '~Dialogo.Fecha1)
ACT(a:fac+6, 'F.Tr.Hasta: '~Dialogo.Fecha2)

if NoVacio(Dialogo.TipoTr1)
  ACT(a:fac+7, 'TipoTr: '~Dialogo.TipoTr1)
else
  ACT(a:fac+7, 'TipoTr: Todas')
endif

if NoVacio(Dialogo.NrOperacionRef1)
  ACT(a:fac+7, 'NrOperacion: '~Dialogo.NrOperacionRef1)
else
  ACT(a:fac+7, 'NrOperacion: Todas')
endif

SetFont(a:fac+1..a:fac+7,2)

SetFilaActual(fac+9)

ACT(a:fac, "Vehiculo")
ACT(b:fac, "Fecha")
ACT(c:fac, "Cliente")
ACT(d:fac, "Especie")
ACT(e:fac, "Tipo Tr.")
ACT(f:fac, "Cantidad")
ACT(g:fac, "NrTransaccion")
ACT(h:fac, "NrOperacion")
AlinearCeldas(a:fac..h:fac,'I')
SetFont(a:fac..h:fac,2)
AgregarMarco(a:fac..h:fac,2,0,Exe('COLOR'))

SQL.ADD (" Select  Vehiculo1, Fecha1, Fecha2, Cliente1, Especie, TipoTr2, Cantidad1, NrTrans, NrOperacionRef1")
SQL.ADD (" from  "~DBO~".TRANSACCIONES2 ")
SQL.ADD ("where ((Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' and TipoTr2 in ('DEP','RET')) ")
SQL.ADD ("or (Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' and TipoTr2 Not In ('DEP','RET')))")

If NoVacio(Dialogo.Vehiculo2)
  SQL.ADD ("and Vehiculo1 = '"~Dialogo.Vehiculo2~"'  ")
EndIf

If NoVacio(Dialogo.Especie1)
  SQL.ADD ("and Especie = '"~Dialogo.Especie1~"' ")
EndIf

If NoVacio(Dialogo.Cliente1)
  SQL.ADD ("and Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf  

If NoVacio(Dialogo.TipoTr1)
  SQL.ADD ("and TipoTr2 = '"~Dialogo.TipoTr1~"'  ")
EndIf

If NoVacio(Dialogo.NrOperacionRef1)
  SQL.ADD ("and NrOperacionRef1 = '"~Dialogo.NrOperacionRef1~"'  ")
EndIf

SQL.ADD (" order by Fecha1, Fecha2 ")

Recorrer SQL
  ACT(a:fac, fbn('Vehiculo1')~" - "~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo',fbn('Vehiculo1')))
  If EqStr('DEP',fbn('TipoTr2')) o EqStr('RET',fbn('TipoTr2'))   
    ACT(b:fac, fbn('Fecha2'))
  else
    ACT(b:fac, fbn('Fecha1'))
  endif 
  ACT(c:fac, fbn('Cliente1')~" - "~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo',fbn('Cliente1')))
  ACT(d:fac, fbn('Especie'))
  ACT(e:fac, fbn('TipoTr2'))
  ACT(f:fac, fbn('Cantidad1')) 
  ACT(g:fac, fbn('NrTrans'))
  ACLT(g:fac, fbn('NrTrans'))
  ACT(h:fac, fbn('NrOperacionRef1'))
  ACLO(h:fac, fbn('NrOperacionRef1'))
  AlinearCeldas(a:fac..h:fac,'I')
  AlinearCeldas(f:fac,'D')
  SetFont(a:fac..h:fac,1)
Proximo

ACT(a:fac+2, 'FIN DEL LISTADO')
SetFont(a:fac+2,2)

SetPrintFit(3,72)
SetMargins(0,1,0,1)
ACO(1,30)
ACO(3,32)
ACO(4,5)
ACO(5,5)
ACO(6,8)
ACO(7,9)
ACO(8,8)
