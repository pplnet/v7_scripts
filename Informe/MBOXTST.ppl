**********************************
* Test de Messagebox - 5 sets de botones (paridad v6)
* No depende de BD ni de otros scripts.
**********************************

ACT(a1, 'Test de Messagebox con 3 parametros')
ACT(a2, 'Cada fila muestra el codigo retornado por cada set de botones.')
ACT(a3, '----------------------------------------------------------')

&r0 := Messagebox('Set 0 (Info): solo Aceptar', 0, 0)
ACT(a5, 'Set 0 (Info, OK):')
ACN(b5, &r0)

&r1 := Messagebox('Set 1 (Warning): Aceptar o Cancelar', 1, 1)
ACT(a6, 'Set 1 (Warning, OK/Cancel):')
ACN(b6, &r1)

&r2 := Messagebox('Set 2 (Error): Si o No', 2, 2)
ACT(a7, 'Set 2 (Error, Yes/No):')
ACN(b7, &r2)

&r3 := Messagebox('Set 3 (Question): Si / No / Cancelar', 3, 3)
ACT(a8, 'Set 3 (Question, Yes/No/Cancel):')
ACN(b8, &r3)

&r4 := Messagebox('Set 4 (Warning): Reintentar / Ignorar / Cancelar', 1, 4)
ACT(a9, 'Set 4 (Warning, Retry/Ignore/Cancel):')
ACN(b9, &r4)

ACT(a11, 'Codigos V6: 1=OK, 2=Cancel, 4=Retry, 5=Ignore, 6=Yes, 7=No')

ACO(1, 40)
ACO(2, 10)
