CrearDialogo
   Especie1  : 'Especie'   ;;;;;;NoVacio(Dialogo.Especie1);'Especie Invalida';NO;
   Entero1   : 'Nr. Cupon' ;;;;;;[NoVacio(Dialogo.Entero1)] Y [ Incluido(Fstr(Dialogo.Entero1, 0, 0), SQLSet(" Select NrCupon From "~DBO~".AGENDACUPONES Where Especie = '"~Dialogo.Especie1~"' "))  O   EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1))] ;'Nr. de Cupon Invalido';NO;;IIF(Dialogo.Entero2 < 0, 0, Dialogo.Entero2);
   Vehiculo1 : 'Vehiculo'  ;;;;;;[NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Debe Ingresar un Vehiculo Valido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Entero2   : 'NrCupon'   ;;2;;NO;NO;;;;;IIF(Novacio(Dialogo.Especie1), SQL(" Select Cupon From "~DBO~".ESPECIES Where Codigo = '"~Dialogo.Especie1~"' ")-1, 0);;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")
CrearFont(5,"Arial,14,B")

ACO( 1, 7)
ACO( 2, 7)
ACO( 3, 6)
ACO( 4, 7)
ACO( 5, 9)
ACO( 6, 8)
ACO( 7, 6)
ACO( 8, 7)
ACO( 9, 8)
ACO( 10, 8)

SetFilaActual(2)
ACT(D:fac, 'CORTE DE CUPON')
SetFont(D:fac, 2)
SetFilaActual(fac+2)
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
ACT(A:fac, Dialogo.Especie1~' - '~Fstr(Dialogo.Entero1, 0, 0))
SetFont(A:fac-1..A:fac, 2)

ifa
***---Select para los titulos
SQL.ADD(" Select A.FechaCorte, A.FechaPago, A.PorRenta, A.PorAmCapital PorAmort, A.PorAmIntCap, ")
SQL.ADD(" A.PrecioCupon, E.VTeorico Actual, A.VTeoricoAnt, E.Alias3 ")
SQL.ADD(" From "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD(" Where A.Especie = E.Codigo ")
SQL.ADD(" AND A.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND A.NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ")

IF EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1))
   SQL.ADD(" Union ALL ")
   SQL.ADD(" Select E.Fecha as FechaCorte, E.Fecha as FechaPago, 0 AS PorRenta, 0 AS PorAmort, 100 as PorAmIntCap, ")
   SQL.ADD(" 0 AS PrecioCupon, E.VTeorico Actual, 0 AS VTeoricoAnt, E.Alias3 ")
   SQL.ADD(" From  "~DBO~".ESPECIES E ")
   SQL.ADD(" Where E.Codigo = '"~Dialogo.Especie1~"' ")
Endif
Recorrer SQL
    ACT(A:fac, 'Fecha Corte')
    ACT(B:fac, 'Fecha Pago')
    ACT(C:fac, '% Renta')
    ACT(D:fac, '% Amort.')
    ACT(E:fac, '% Amort.Int.Cap.')
    ACT(F:fac, 'Precio Cupon')
    ACT(G:fac, 'VT Actual')
    ACT(H:fac, 'VT Anterior')
    ifa
    ACT(A:fac, fbn('FechaCorte'))
    ACT(B:fac, fbn('FechaPago'))
    ACN(C:fac, fbn('PorRenta'))
    ACN(D:fac, fbn('PorAmort'))
    ACN(E:fac, fbn('PorAmIntCap'))
    ACN(F:fac, fbn('PrecioCupon'))
    ACN(G:fac, fbn('Actual'))
    ACN(H:fac, fbn('VTeoricoAnt'))
    ACT(EC:1, fbn('Alias3'))
    SetFont(A:fac..H:fac, 1)
Proximo

FormatoCeldas(C:fac..H:fac, Exe('F6'))
AgregarMarco(A:fac-1..H:fac-1, 0, 0, Exe('COLOR'))
AgregarMarco(A:fac..H:fac,0,0)
AlinearCeldas(A:fac-1..H:fac-1,'C')
SetFont(A:fac-1..H:fac-1, 2)
SetFilaActual(fac+2)


***---Comienzo de transacciones
***---Titulos de Columnas
ACT(A:fac, 'Nr. Trans')
ACT(B:fac, 'Cliente')
ACT(C:fac, 'Mercado')
ACT(D:fac, 'Cuenta')
ACT(D:fac+1, 'Especie')
ACT(E:fac, 'Saldo')
ACT(F:fac, 'Pendiente')
ACT(G:fac, 'Opcion')

SetFont(A:fac..G:fac+1, 2)
AlinearCeldas(A:fac..G:fac+1,'C')
AgregarMarco(A:fac..G:fac+1,0,0,Exe('COLOR6'))
SetFilaActual(fac+2)
ACN(FI:1, fac)

If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6, Dialogo.Vehiculo1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else
      ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
Endif
SQL.ADD(" Select T.NrTrans, T.Cliente1, T.Mercado1, T.Cuenta2, T.Cantidad1, T.CB2, T.CB3 ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where T.TipoTr2 IN ('CUPON') ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND T.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND T.Cupon1 = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ")
SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND T.Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
SQL.ADD(" Order By T.Cliente1, T.Mercado1 ")
Recorrer SQL
    ACT(A:fac, fbn('NrTrans'))
    ACLT(A:fac, fbn('NrTrans'))
    ACT(B:fac, fbn('Cliente1'))
    ACT(C:fac, fbn('Mercado1'))
    ACT(D:fac, fbn('Cuenta2'))
    ACN(E:fac, fbn('Cantidad1'))
    IF Eqstr(fbn('CB2'), '1')
        ACT(F:fac, 'SI')
    ELSE
        ACT(F:fac, 'NO')
    ENDIF
    IF Eqstr(fbn('CB3'), '1')
        ACT(G:fac, 'SI')
    ELSE
        ACT(G:fac, 'NO')
    ENDIF
    SetFont(A:fac..H:fac, 1)
Proximo
AlinearCeldas(F:Val(FI:1)..G:fac, 'C')
AgregarMarco(A:Val(FI:1)..G:fac,0,0)
ifa
ifa
ifa
ACT(A:fac, 'Fin del Informe.')
SetFont(A:fac, 2)
LimitesVision(I:fac+2)
