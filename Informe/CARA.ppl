HojaVisible(NO)
CrearDialogo
   Fecha1    : 'Fecha Vigencia'                         ;1;1;;;;;;;;FSYS
   Radio1    : 'Vehiculos|Todos|Algunos'                ;;;;;;;;;0;
   Lista1    : 'Vehiculo'                               ;;;;Dialogo.Radio1=1;;;;;;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Radio2    : 'Consolidado|NO|SI'                      ;;;;;;;;;0;
   Precio1   : 'Cot.USD/ARP'                            ;;;;;;Dialogo.Precio1>0;'La cotizacion del USD contra el peso debe ser mayor a cero';NO;0;
   Radio3    : "Expresado|ARP|USD"                      ;;;;;;;;;1
   Vehiculo1 : 'Grupo'                                  ;;;;NO;NO;;;;;;;;;"TipoVehiculo <> 'DIV'";
FinDialogo

If Not Ok
   Cancelar
Endif

ACT(ga1,Dialogo.Lista1)

If Vacio(val(ga1))
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(ga1,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else
      ACT(ga1,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
EndIf

If Dialogo.Radio2=1
   *- Llamo al Informe de CORTO + LARGO con todos los vehiculos CONSOLIDADO
   LinkearHoja('CARA1',1,Fecha1=Dialogo.Fecha1,Lista1=Val(ga1),Precio1=Dialogo.Precio1,Radio1=1,Radio3=Dialogo.Radio3,Vehiculo1=Dialogo.Vehiculo1)
Else 
   ACN(ga2, Elementos(Val(ga1)))

   Recorrer&i 1, Val(ga2)
      LinkearHoja('CARA1',1,Fecha1=Dialogo.Fecha1,Lista1=ItemLista(Val(ga1),&i),Precio1=Dialogo.Precio1,Radio1=0,Radio3=Dialogo.Radio3,Vehiculo1=Dialogo.Vehiculo1)
   Proximo
Endif
