ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1        : "Vto Desde"         ;1;1;;;;Dialogo.Fecha1<>0;'Fecha de Vto Desde Invalida';NO;PriDeMes(Fsys,NO);
   Fecha2        : "Vto Hasta"         ; ; ;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha de Vto Desde Invalida';NO;Fsys;
   Especie1      : "Especie"           ;;;;;;;;;;;;;
   Cliente1      : "Entidad"           ;1;2;;;;;;;;;;;
   NrOperacion1  : "Operacion"         ; ; ;;;;;;;;;;;;" TipoOp In ('MMONM','MMON','MMSIMV','MMPSI','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME')"
   Lista1        : "Vehiculo"          ;5;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet("Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
   Lista2        : "TipoOp"            ;6;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMON','MMONM','MMPSI','MMSIMV','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME','MMPCCV','MMPCCM','MMP','DTSFF','DTSFV','DTSVV','DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','FXCT','FXVT','FXAT','SECT','SEVT','TEMD') ")
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(5,"Arial,8,BI")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,2)

ACT(a:FAC  ,"Reporte Diario de Vencimiento de Deuda ")
ACT(a:FAC+1,"Desde el "~Dialogo.Fecha1~" Hasta el "~Dialogo.Fecha2~" "  )
SetFont(a:fac..a:fac+1,3)

SetFilaActual(3)

If NoVacio(Dialogo.Lista1)
   ACT(zz6, Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else
      ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
Endif

If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+1, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:FAC+1, 'Entidad : Todos')
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Lista1)
Else
   ACT(a:FAC+2, 'Vehiculo : '~IIf(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
EndIf
If NoVacio(Dialogo.Especie1)
   ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(a:FAC+3, 'Especie : Todas')
EndIf
If NoVacio(Dialogo.Lista2)
   ACT(g:FAC+1, 'Tipo Op.: '~Dialogo.Lista2)
Else
   ACT(g:FAC+1, 'Tipo Op.: Todas')
endIf
If NoVacio(Dialogo.NrOperacion1)
   ACT(g:FAC+2, 'NrOperacion: '~Dialogo.NrOperacion1)
Else
   ACT(g:FAC+2, 'NrOperacion: Todas')
EndIf
SetFont(a:fac..N:FAC+3,2)
SetFilaActual(FAC+4)
(.'TITVTODEUD'.)

*- Select de Operaciones Ordenado por FechaVto, Cliente, Especie y TipoOp
(.'VTODEUDAS'.)
SQL.ADD("Union All ")
(.'VTODEUDA2'.)
SQL.ADD("Union All ")
(.'VTODEUDA3'.)
SQL.ADD("order by 12,6,9,5")

*** b:400 valor de la columna ***
acn(zz:400,2)
ACT(xx:400,' ')
ACN(lv1,0)

Recorrer SQL
     Message(fbn['NrOperacion']~' '~fbn['FechaVto']~'  '~FBN['VResidual']~' '~fbn['TipoOp']~' '~FBN['Grupo']~' '~FBN['Especie'])

     *- Totales por Fecha, Cliente, Especie y TipoOp
     If Not EqStr(val(va2)~val(va3)~val(va4)~val(va5),FBN['FechaSett']~FBN['Cliente1']~FBN['Especie']~FBN['TipoOp']) y NoVacio(val(va2))
        Ifa
        ACT(a:fac,'Total '~val(va2)~' '~val(va3)~' '~val(va4)~' '~val(va5))

        ACN(g:fac,SUM(g:val(lc1)..g:fac-1) )
        ACN(J:fac,SUM(J:val(lc1)..J:fac-1) )
        ACN(K:fac,SUM(K:val(lc1)..K:fac-1) )

        ACN(S:fac,SUM(S:val(lc1)..S:fac-1) )
        ACN(T:fac,SUM(T:val(lc1)..T:fac-1) )
        ACN(U:fac,SUM(U:val(lc1)..U:fac-1) )
        ACN(V:fac,SUM(V:val(lc1)..V:fac-1) )
        ACN(W:fac,SUM(W:val(lc1)..W:fac-1) )
        ACN(X:fac,SUM(X:val(lc1)..X:fac-1) )
        ACN(Y:fac,SUM(Y:val(lc1)..Y:fac-1) )
        ACN(Z:fac,SUM(Z:val(lc1)..Z:fac-1) )

        SCN(g:1,val(g:fac) )
        SCN(J:1,val(J:fac) )
        SCN(K:1,val(K:fac) )
        SCN(S:1,val(S:fac) )
        SCN(T:1,val(T:fac) )
        SCN(U:1,val(U:fac) )
        SCN(V:1,val(V:fac) )
        SCN(W:1,val(W:fac) )
        SCN(X:1,val(X:fac) )
        SCN(Y:1,val(Y:fac) )
        SCN(Z:1,val(Z:fac) )

        SetFont(a:fac..Z:fac,2) 
        AgregarMarco(a:fac..AF:fac,0,0)       
        Ifa
     EndIf

     *- Totales por Fecha, Cliente, Especie 
     If Not EqStr(val(va2)~val(va3)~val(va4),FBN['FechaSett']~FBN['Cliente1']~FBN['Especie']) y NoVacio(val(va2))
        Ifa
        ACT(a:fac,'Total '~val(va2)~' '~val(va3)~' '~val(va4))
        ACN(g:fac,val(g:1) )
        ACN(J:fac,val(J:1) )
        ACN(K:fac,val(K:1) )
        ACN(S:fac,val(S:1) )
        ACN(T:fac,val(T:1) )
        ACN(U:fac,val(U:1) )
        ACN(V:fac,val(V:1) )
        ACN(W:fac,val(W:1) )
        ACN(X:fac,val(X:1) )
        ACN(Y:fac,val(Y:1) )
        ACN(Z:fac,val(Z:1) )

        SetFont(a:fac..Z:fac,2) 
        AgregarMarco(a:fac..AF:fac,0,0,Exe('COLOR6'))       

        ACN(g:1,0)
        ACN(J:1,0)
        ACN(K:1,0)
        ACN(S:1,0)
        ACN(T:1,0)
        ACN(U:1,0)
        ACN(V:1,0)
        ACN(W:1,0)
        ACN(X:1,0)
        ACN(Y:1,0)
        ACN(Z:1,0)
        Ifa
     EndIf

     * Corte de Control por Fecha, Cliente, Especie y TipoOp
     If Not EqStr(val(va2)~val(va3)~val(va4)~val(va5),FBN['FechaSett']~FBN['Cliente1']~FBN['Especie']~FBN['TipoOp']) 
        ACT(va2,FBN['FechaSett']) 
        ACT(va3,FBN['Cliente1']) 
        ACT(va4,FBN['Especie']) 
        ACT(va5,FBN['TipoOp']) 

        ACT(a:fac,val(va2)~' '~val(va3)~' '~val(va4)~' '~val(va5))
        SetFont(a:fac..a:fac,5)
        AgregarMarco(a:fac..AF:fac,0,0)       
        Ifa
        ACN(lc1,fac)

        ACT(b:fac , FBN['Cliente1'])  
        If EqStr(FBN['Grupo'],'FRN')
           ACT(b:fac , VAL(b:fac)~' - '~FBN['Cliente2'])
        EndIf

        ACT(c:fac , FBN['Especie'])
        SetFont(a:fac..Z:fac,2) 

        ACD(d:fac, FBN['FInicio'])
        ACD(e:fac, FBN['FFin'])
        ACD(f:fac, FBN['FechaSett'])
     EndIf

     ACT(a:fac , FBN['NrOperacion'])
     ACLO(a:fac, FBN['NrOperacion'])
     ACT(b:fac , FBN['Cliente1'])  
     ACT(c:fac , FBN['Especie'])
     ACD(d:fac, FBN['FInicio'])
     ACD(e:fac, FBN['FFin'])
     ACD(f:fac, FBN['FechaSett'])
     If Not Incluido(FBN['Grupo'],'Comisiones|CEC|CEN')
        ACN(g:fac, FBN['Cantidad'])
        If FBN['CantidadOri']<>0
           ACN(g:fac, FBN['CantidadOri'])
        EndIf
        ACT(H:fac, Fstr(fbn('NrCuota'), 0, 0))
        ACN(J:fac, FBN['ImpAmort'])
        ACN(I:fac, (val(J:fac)/val(g:fac))*100)
        ACN(K:fac, FBN['VResidual'])
        ACD(M:fac, FBN['FechaOp'])
        ACD(N:fac, FBN['FechaVto'])
        ACT(L:fac, Fstr(Val(N:fac)-Val(M:fac), 0, 0))
        ACT(O:fac, FBN['TipoTasa'])
        ACN(P:fac, FBN['Tasa'])
        ACN(Q:fac, FBN['Spread'])
        ACN(R:fac, FBN['Tasa']+FBN['Spread'])

        ACN(S:fac,FBN['TotalIntereses'])        
        ACN(T:fac,FBN['ImpWH'] )        
        ACN(U:fac,FBN['ImpIVA'])    
        ACN(V:fac,FBN['ImpInt'])    
        AlinearCeldas(H:fac, 'D')
        AlinearCeldas(L:fac, 'D')
        ***---Busco Fechas Liquidacion
        IF Val(J:fac) <> 0
            ***---Capital
            ACN(LG:1, Longitud(Val(J:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(J:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AA:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(J:fac), 0, 6)~"' "))
            IF Val(AA:fac) = 0
                BorrarCeldas(AA:fac..AA:fac)
            ENDIF
        ENDIF
        IF Val(S:fac) <> 0
            ***---Interes
            ACN(LG:1, Longitud(Val(S:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(S:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AB:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(S:fac), 0, 6)~"' "))
            IF Val(AB:fac) = 0
                BorrarCeldas(AB:fac..AB:fac)
            ENDIF
        ENDIF
        IF Val(T:fac) <> 0
            ***---WH
            ACN(LG:1, Longitud(Val(T:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(T:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AC:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(T:fac), 0, 6)~"' "))
            IF Val(AC:fac) = 0
                BorrarCeldas(AC:fac..AC:fac)
            ENDIF
        ENDIF
        IF Val(U:fac) <> 0
            ***---IVA
            ACN(LG:1, Longitud(Val(U:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(U:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AD:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(U:fac), 0, 6)~"' "))
            IF Val(AD:fac) = 0
                BorrarCeldas(AD:fac..AD:fac)
            ENDIF
        ENDIF
        IF Val(V:fac) <> 0
            ***---Impuesto al Endeudamiento
            ACN(LG:1, Longitud(Val(V:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(V:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AE:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(V:fac), 0, 6)~"' "))
            IF Val(AE:fac) = 0
                BorrarCeldas(AE:fac..AE:fac)
            ENDIF
        ENDIF
        IF Val(g:fac) <> 0 y Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',val(a:fac)),'SECT|SEVT|FXAT|FXCT|FXVT|TEMD')
            ***---Capital
            ACN(LG:1, Longitud(Val(G:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(G:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AA:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(a:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~")= '"~Fstr(Val(g:fac), 0, 6)~"' "))
            IF Val(AA:fac) = 0
                BorrarCeldas(AA:fac..AA:fac)
            ENDIF
        ENDIF
     Else
        ACN(W:fac,FBN['Cantidad'])    
        ACN(X:fac,FBN['ImpIVA'])    
        ACN(Y:fac,FBN['ImpWH'])
        ACN(Z:fac,FBN['ImpInt'])    
        ***---Busco Fecha Liquidacion
        IF Val(W:fac) <> 0
            ***---Comisiones
            ACN(LG:1, Longitud(Val(W:fac)))
            ACN(DC:1, 0)
            ACN(DC:2, 0)
            Recorrer&k 1, Val(LG:1)
                ***---Determino cantidad de decimales
                IF Eqstr(Copy(Val(W:fac), &k, 1), '.')
                    ACN(DC:1, 0)
                    ACN(DC:2, 1)
                ELSE
                    SCN(DC:1, 1)
                ENDIF
                IF Val(DC:2) = 0
                    ***---No tiene decimales
                    ACN(DC:1, 0)
                ENDIF
            Proximo
            ACD(AF:fac, SQL(" Select FechaEje From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~Val(A:fac)~"' AND Substring(Convert(Char,Round(Cantidad, "~FStr(Val(DC:1), 1, 0)~")), 1, "~FStr(Val(LG:1), 1, 0)~") = '"~Fstr(Val(W:fac), 0, 6)~"' "))
            IF Val(AF:fac) = 0
                BorrarCeldas(AF:fac..AF:fac)
            ENDIF
        ENDIF
     EndIf
     SetFont(a:fac..af:fac,1)
     FormatoCeldas(P:fac..R:fac, EXE('F5'))
Proximo
Ifa

Ifa
ACT(a:fac,'Total '~val(va2)~' '~val(va3)~' '~val(va4)~' '~val(va5))

ACN(g:fac,SUM(g:val(lc1)..g:fac-1) )
ACN(J:fac,SUM(J:val(lc1)..J:fac-1) )
ACN(K:fac,SUM(K:val(lc1)..K:fac-1) )

ACN(S:fac,SUM(S:val(lc1)..S:fac-1) )
ACN(T:fac,SUM(T:val(lc1)..T:fac-1) )
ACN(U:fac,SUM(U:val(lc1)..U:fac-1) )
ACN(V:fac,SUM(V:val(lc1)..V:fac-1) )
ACN(W:fac,SUM(W:val(lc1)..W:fac-1) )
ACN(X:fac,SUM(X:val(lc1)..X:fac-1) )
ACN(Y:fac,SUM(Y:val(lc1)..Y:fac-1) )
ACN(Z:fac,SUM(Z:val(lc1)..Z:fac-1) )

SCN(g:1,val(g:fac) )
SCN(J:1,val(J:fac) )
SCN(K:1,val(K:fac) )
SCN(S:1,val(S:fac) )
SCN(T:1,val(T:fac) )
SCN(U:1,val(U:fac) )
SCN(V:1,val(V:fac) )
SCN(W:1,val(W:fac) )
SCN(X:1,val(X:fac) )
SCN(Y:1,val(Y:fac) )
SCN(Z:1,val(Z:fac) )

SetFont(a:fac..Z:fac,2) 
AgregarMarco(a:fac..AF:fac,0,0)       
Ifa

ACT(a:fac,'Total '~val(va2)~' '~val(va3)~' '~val(va4))
ACN(g:fac,val(g:1) )
ACN(J:fac,val(J:1) )
ACN(K:fac,val(K:1) )
ACN(S:fac,val(S:1) )
ACN(T:fac,val(T:1) )
ACN(U:fac,val(U:1) )
ACN(V:fac,val(V:1) )
ACN(W:fac,val(W:1) )
ACN(X:fac,val(X:1) )
ACN(Y:fac,val(Y:1) )
ACN(Z:fac,val(Z:1) )

SetFont(a:fac..Z:fac,2) 
AgregarMarco(a:fac..AF:fac,0,0,Exe('COLOR6'))       


Ifa 
Ifa 
ACT(a:fac,'FIN DEL INFORME')
SetFont(a:fac..aa:fac,2)

Recorrer&j 1,17
   ACO(&j,8)
Proximo
ACO(8, 6)
ACO(12, 5)
ACO(32, 7)
BorrarCeldas(g:1..Z:1)
LimitesVision(AG:fac+1)
