CrearDialogo
Check1         : 'CHECK'    ;;;;;;;;;
Fecha1         : 'fecha'   ;;;;;;;;;;;;;;;;;;
Informe1       : 'INFORME' ;;;;;;;;;;;;;;;;;
*Lista1         : 'lista' ;;;;;;;;;;;SQLSet("Select Codigo From "DBO".VARIABLES ");NO;
Mercado1       : 'Mercados' ;1;2;;;;;;;;;  
Precio1        : 'PRECIO' ;;;;;;;;;;;  
Radio1         : 'Resultado|Mensual|Anual|Historico|Otro';5;1;;;;;;;0;
Label1         :  ;8;1;;  ;  ;;;;'Ingrese las cotizaciones de MTM'
FinDialogo
IF NOT OK
  Cancelar
ENDIF

If Dialogo.Radio1=0
    ACT( a1, 'Resultado')
    ACT( a2, 'Resultado')
    ACT( a3, 'Resultado')
Else 
   ACT( a1, 'Otro')
   ACT( a2, 'Otro')
   ACT( a3, 'Otro')
EndIf

If Dialogo.Check1=0
    ACT( b1, 'Resultado')
    ACT( b2, 'Resultado')
    ACT( b3, 'Resultado')
Else 
   ACT( b1, 'Otro')
   ACT( b2, 'Otro')
   ACT( b3, 'Otro')
EndIf

If Dialogo.Fecha1=0
    ACT( c1, 'Resultado')
    ACT( c2, 'Resultado')
    ACT( c3, 'Resultado')
Else 
   ACT( c1, 'Otro')
   ACT( c2, 'Otro')
   ACT( c3, 'Otro')
EndIf