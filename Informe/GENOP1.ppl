* GRALOP - OPERAT - General de Operaciones
ModoReproceso(ConDialogo)

CrearDialogo
  Vehiculo1  : "Vehiculo"   ;;;;;;[Vacio(Dialogo.Vehiculo1)] O [NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIf(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ")))];'Vehiculo Invalido';NO;;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "));;;IIf(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ","(Status='HAB' or Status Is Null or Status='') ");
  Cliente1   : "Cliente"    ;2;;;;;;;;
  Especie1   : "Especie"    ;3;;;;;;;;
  Operador   : 'Operador'   ;3;2;;;;;;;UsuarioActivo
  Fecha1     : "F.Op.Desde" ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2     : "F.Op.Hasta" ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3     : "F.Vto.Desde";5;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4     : "F.Vto.Hasta";5;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  TipoOp1    : "Tipo Op"    ;6;1;;;;;;;
  TipoOp2    : " "          ;7;1;;;;;;;
  TipoOp3    : " "          ;8;1;;;;;;;
  TipoOp4    : "Tipo Op"    ;6;2;;;;;;;
  TipoOp5    : " "          ;7;2;;;;;;;
  ListaClaves: "Orden"      ;9;1;;;;;;;;;Operaciones
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   Endif
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Endif
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "General de Operaciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)
If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1)
Else
   ACT(a:FAC+1, 'Vehiculo : Todos')
Endif
If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1)
Else
   ACT(a:FAC+2, 'Cliente : Todos')
Endif
If NoVacio(Dialogo.Especie1)
   ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1)
Else
   ACT(a:FAC+3, 'Especies : Todas')
Endif

ACT(a:FAC+4, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(c:FAC+4, 'Ope.Hasta : '~Dialogo.Fecha2)
ACT(a:fac+5, 'Vto.Desde : '~Dialogo.Fecha3)
ACT(c:FAC+5, 'Vto.Hasta : '~Dialogo.Fecha4)

If NoVacio(Dialogo.TipoOp1~Dialogo.TipoOp2~Dialogo.TipoOp3~Dialogo.TipoOp4~Dialogo.TipoOp5)
  ACT(A:FAC+6, 'Tipo Op. : '~Dialogo.TipoOp1~' '~Dialogo.TipoOp2~' '~Dialogo.TipoOp3~' '~Dialogo.TipoOp4~' '~Dialogo.TipoOp5)
Else
  ACT(A:FAC+6, 'Tipo Op. : Todas')
Endif
If NoVacio(Dialogo.Operador)
   ACT(a:FAC+7, 'Operador : '~Dialogo.Operador)
Else
   ACT(a:FAC+7, 'Operador : Todos')
Endif

SetListaClaves(1)
ACT(a:FAC+8, "Orden : "~Dialogo.ListaClaves)

SetListaClaves(2)
SetFilaActual(FAC+10)

ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "F.Operacion")
ACT(C:FAC, "F.Vto")
ACT(D:FAC, "Cliente")
ACT(E:FAC, "Especie")
ACT(F:FAC, "ContraEspecie")
ACT(G:FAC, "Tipo Op.")
ACT(H:FAC, "Cantidad")
ACT(I:FAC, "Precio")
ACT(J:FAC, "Tasa N.A.")
ACT(K:FAC, "Plazo")
ACT(L:FAC, "Total")
ACT(M:FAC, "Nro.Operacion")
ACT(N:FAC, "Op.Referencia")
ACT(O:FAC, "Operador")

AlinearCeldas(a:FAC..G:FAC,'I')
AlinearCeldas(H:FAC..L:FAC,'D')
AlinearCeldas(M:FAC..O:FAC,'I')
SetFont(a5..o:FAC,2)
AgregarMarco(a:FAC..O:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

If NoVacio(Dialogo.Especie1)
   ACT(z1, "O.Especie = '"~Dialogo.Especie1~"' and ")
Endif

If NoVacio(Dialogo.Cliente1)
   ACT(z1, Val(z1)~"O.Cliente1 = '"~Dialogo.Cliente1~"' and ")
Endif

If NoVacio(Dialogo.TipoOp1~Dialogo.TipoOp2~Dialogo.TipoOp3~Dialogo.TipoOp4~Dialogo.TipoOp5)
   ACT(z1, Val(z1)~"O.TipoOp in ('"~Dialogo.TipoOp1~"','"~Dialogo.TipoOp2~"','"~Dialogo.TipoOp3~"','"~Dialogo.TipoOp4~"','"~Dialogo.TipoOp5~"') and ")
Endif

If NoVacio(Dialogo.Vehiculo1)
   ACT(z1, Val(z1)~"O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") and ")
Endif


ACT(z1, Val(z1)~"O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and ")
ACT(z1, Val(z1)~"((O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"') or FechaVto Is Null)")
If NoVacio(Dialogo.Operador)
   ACT(z1, Val(z1)~" and O.Operador = '"~Dialogo.Operador~"'")
Endif



SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("       O.ContraEspecie,O.TipoOp,O.Cantidad,O.Precio1 Precio,O.Precio3,O.Plazo,O.TotalNetoCli1,")
SQL.ADD("       O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, 0 Tasa ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O WHERE "~Val(z1)~" and (O.TipoOp Not In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("       and (O.TipoOp like 'FX%' or O.TipoOp like 'SE%' or O.TipoOp like 'FC%') ")
SQL.ADD("       and (O.TipoOp Not In ('MMPCM','MMONM','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMFIMV','MMFCMV')) )")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("       O.ContraEspecie,O.TipoOp,O.Cantidad,0 Precio,O.Precio3,O.Plazo,O.TotalNetoCli1,")
SQL.ADD("       O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, O.Precio1 Tasa ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O WHERE "~Val(z1)~" and (O.TipoOp Not In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("       and (O.TipoOp Not like 'FX%' and O.TipoOp Not like 'SE%' and O.TipoOp Not like 'FC%') ")
SQL.ADD("       and (O.TipoOp Not In ('MMPCM','MMONM','MMPCCM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMFIMV','MMFCMV')) )")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("       O.ContraEspecie,O.TipoOp,O.TotalAux3 as Cantidad,0 Precio,O.Precio3,O.Plazo,")
SQL.ADD("       O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, C.Precio1 Tasa ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion=C.NrOperacion and "~Val(z1)~" and O.TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("       and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT DISTINCT O.Vehiculo1,O.FechaOp,O.FechaVto,O.Cliente1,O.Especie,O.FechaEj,O.PrecioEj,O.TotalAux3,")
SQL.ADD("       O.ContraEspecie,O.TipoOp,O.Cantidad,0 Precio,O.Precio3,O.Plazo,")
SQL.ADD("       O.TotalNetoCli1,O.TotalBrutoCli1,O.NrOperacion,O.OperacionRef,O.Operador,O.Rojo,O.PaseCB,O.Arbitraje, C.Precio2  Tasa ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion=C.NrOperacion and "~Val(z1)~" and O.TipoOp Not In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("       and C.Fecha2 Between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
If NoVacio(Dialogo.ListaClaves)
   SQL.ADD("ORDER BY  "~Dialogo.ListaClaves)
Endif
*SQL.ADD(",")

Recorrer SQL
  ACT(a:FAC, FBN['Vehiculo1'])
  ACT(b:FAC, FBN['FechaOp'])
  ACT(c:FAC, FBN['FechaVto'])
  ACT(d:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
  ACT(e:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  ACT(f:FAC, FBN['ContraEspecie'])

  ACT(g:FAC, FBN['TipoOp'])
  If Incluido(FBN['TipoOp'],'FXC|FXV|FXCT|FXVT') y FBN['Rojo']=1
     ACT(g:FAC, Val(g:FAC)~' (Rojo)')
  Endif
  If Incluido(FBN['TipoOp'],'FXC|FXV|FXCT|FXVT|FXA|FXAT') y FBN['PaseCB']=1
     ACT(g:FAC, Val(g:FAC)~' (x Pase)')
  Endif
  If Incluido(FBN['TipoOp'],'FXC|FXV|FXCT|FXVT') y FBN['Arbitraje']=1
     ACT(g:FAC, Val(g:FAC)~' (x Arb.)')
  Endif

  ACN(i:FAC, FBN['Precio'])

  If Incluido(FBN['TipoOp'],'DTSFF|DTSFV|DTSFVV|DTSVV')
     ACN(j:FAC, FBN['Precio3'])
  Else
     ACN(j:FAC, FBN['Tasa'])
  Endif

  ACN(k:FAC, FBN['Plazo'])
  ACN(h:FAC, FBN['Cantidad'])
  If EqStrL(FBN['TipoOp'],'DT',2)
     If Incluido(FBN['TipoOp'],'DTCAP|DTFLO|DTSFFM|DTSFVM|DTSVVM')
        ACN(h:FAC, FBN['TotalAux3'])
     Else
        If Incluido(FBN['TipoOp'],'DTK|DTKVI|DTSFVX|DTSNFF|DTSNVV')
           ACN(h:FAC, BuscarCampo('CUOTAS', 'Cantidad1', 'NrOperacion',FBN['NrOperacion']))
        Endif
     Endif
     ACN(l:FAC,0)
  Else
     ACN(l:FAC, FBN['TotalBrutoCli1'])
  Endif

  ACT(m:FAC, FBN['NrOperacion'])
  ACLO(m:FAC, FBN['NrOperacion'])
  ACT(n:FAC, FBN['OperacionRef'])
  ACLO(n:FAC, FBN['OperacionRef'])
  If CeldaVacia(n:FAC)
     ACT(n:FAC, '------------')
  Endif
  ACT(O:FAC, FBN['Operador'])
  AlinearCeldas(b:FAC..c:FAC,'D')
  FormatoCeldas(k:FAC..k:FAC,"0")
  FormatoCeldas(i:FAC..i:FAC,Exe('F6'))
Proximo

SetFont(a:Val(w1)+11..q:FAC,1)
ACO(1,6)
ACO(2,7)
ACO(3,7)
ACO(4,16)
ACO(5,10)
ACO(6,9)
ACO(7,8)
ACO(8,8)
ACO(9,7)
ACO(10,6)
ACO(11,5)
ACO(12,8)
ACO(13,9)
ACO(14,9)
ACO(15,9)
ACO(16,6)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
SetFont(g:3,2)
LimitesVision(P:FAC)
RangoTitulo(a:1..O:FAC, Val(w1)+5)
SetPrintFit(3, 77)