
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
CrearDialogo
  Fecha1 : 'Desde'       ;;;;;;Dialogo.Fecha1>0 and Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha desde debe de ser menor a la fecha hasta';NO;FSYS;
  Fecha2 : 'Hasta'       ;;;;;;Dialogo.Fecha2 <= FSYS;'Fecha Hasta debe ser menor a la fecha actual!';NO;FSys
  Cuenta1: 'Cuenta'      ;;;;;;;;;;;
  GrupoEconomico: 'Grupo Economico' ;;;;;;;;;;;;;;
  Radio1 : 'Orden|Cuenta|Fecha';;;;;;;;;;1;
  ListaTabla1: 'Clientes'   ;1;2;;;;;;;;;;;;;'Codigo' ; 'Codigo;RazonSocial' ;'CLIENTES'
Findialogo

If not OK 
    Cancelar
EndIf

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')


ACT(a:fac+5, 'Detalle de Saldos de Cuentas Remuneradas')
SetFont(a:fac+5, 3)

ACT(a:fac+6, 'Fecha Desde: '~Dialogo.Fecha1)
SetFont(a:fac+6, 1)

ACT(a:fac+7, 'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a:fac+7, 1)


If Dialogo.Radio1 = 0
    ACT(a:fac+8, 'Orden por Cuenta')
Else
    ACT(a:fac+8, 'Orden por Fecha')
EndIf


If Vacio(Dialogo.Cuenta1) 
    ACT(d:fac+6,'Cuenta: Todas')
Else
    ACT(d:fac+6,'Cuenta: '~Dialogo.Cuenta1)
Endif

If Vacio(Dialogo.ListaTabla1) 
    ACT(d:fac+7,'Cliente: Todos')
Else
    ACT(d:fac+7,'Cliente: '~Dialogo.ListaTabla1)
Endif

If Vacio(Dialogo.GrupoEconomico) 
    ACT(d:fac+8,'Grupo Economico: Todos')
Else
    ACT(d:fac+8,'Grupo Economico: '~Dialogo.GrupoEconomico)
Endif

SetFilaActual(9)

ACT(a:fac, 'Fecha')
ACT(b:fac, 'Cuenta')
ACT(c:fac, 'Detalle')
ACT(d:fac, 'Tipo Tasa')
ACT(e:fac, 'Moneda')
ACT(f:fac, 'Interes acumulado')
ACT(g:fac, 'Saldo')
ACT(h:fac, 'NrOperacion')
ACT(i:fac, 'Cliente')
ACT(j:fac, 'Tasa')

AlinearCeldas(f:fac..g:fac,'D')
SetFont(a:6..j:FAC,1)
AgregarMarco(a:FAC..j:FAC,1,0,Exe('COLOR6'))

SQL.ADD("SELECT S.Fecha, S.Cuenta, S.Moneda, ISNULL(Cta.TEM, 'NO') TEM, Cta.Nombre, Cta.CodigoTasa, S.Interes, S.Saldo, S.NrOperacion, O.Precio1, Cte.Codigo, Cte.RazonSocial, GE.Controlante ")
SQL.ADD("  FROM "~DBO~".SALDOSREM S ")
SQL.ADD("  JOIN "~DBO~".CUENTAS Cta ON S.Cuenta = Cta.Codigo ")
SQL.ADD("  JOIN "~DBO~".CLIENTES Cte ON Cta.Cliente = Cte.Codigo ")
SQL.ADD("  LEFT JOIN "~DBO~".GRUPOSECONOMICOS GE ON Cte.Codigo = GE.Cliente ")
SQL.ADD("  LEFT JOIN "~DBO~".OPERACIONES O ON S.NrOperacion = O.NrOperacion ")
SQL.ADD("  WHERE  S.Fecha BETWEEN '"~IDxDate(Dialogo.Fecha1)~"' AND '"~IDxDate(Dialogo.Fecha2)~"' ")

If NoVacio(Dialogo.Cuenta1)
   SQL.ADD("   AND S.Cuenta = '"~Dialogo.Cuenta1~"' ")
Endif

If NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("   AND Cte.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
Endif

If NoVacio(Dialogo.GrupoEconomico)
   SQL.ADD("   AND GE.Controlante = '"~Dialogo.GrupoEconomico~"'  ")
Endif

If Dialogo.Radio1 = 0  
  SQL.ADD(" ORDER BY S.Cuenta,S.Moneda, S.Fecha")
Endif
If Dialogo.Radio1 = 1
  SQL.ADD(" ORDER BY S.Fecha, S.Moneda, S.Cuenta")
Endif

Recorrer SQL
  ACT(a:fac,FBN['Fecha'])
  ACT(b:fac,FBN['Cuenta'])
  ACT(c:fac,FBN['Nombre'])
  if EqStr(FBN['TEM'],'NO')
      ACT(d:fac,'TNA')
  Else 
      If EqStr(FBN['TEM'], 'SI')
      ACT(d:fac,'TEM')
      Endif
  Endif
  ACT(e:fac,FBN['Moneda'])
  ACN(f:fac,FBN['Interes'])
  ACN(g:fac,FBN['Saldo'])
  ACT(h:fac,FBN['NrOperacion'])
  ACLO(h:fac,FBN['NrOperacion'])
  ACT(i:fac,FBN['Codigo']~' - '~FBN['RazonSocial'])
  ACN(j:fac,FBN['Precio1'])

Proximo

************************************
ACT(a:fac+2,'Fin del Informe')
SetFont(a:fac+2, 1)
LimitesVision(j:fac)
Impresion(1,1)
Impresion(4,1)
FormatoCeldas(j:Val(w1)+1..j:fac,Exe('F7'))


ACO(1,7)
ACO(2,10)
ACO(3,23)
ACO(4,7)
ACO(5,5)
ACO(6,15)
ACO(7,15)
ACO(8,9)
ACO(9,25)
ACO(10,15)

RangoTitulo(a:7..j:fac, 1)
