ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:   'D.Fecha'   ;1;1;;;;;;;fsys
  Radio1:   'Tipo|Debitos|Creditos|Ambos' ;2;1;;;;;;;2
  Radio2 : 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;3;1;;;;;;;4
  Check1:  'Incluye Pagadoras';4;1;;;;;;;1
  Lista3:   'Monedas'   ; 5;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES WHERE Tipo='MON' ");
  Lista1:   'Vehiculos' ;-1;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista4:   'Cuentas'   ;-6;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")


ACT(a:1, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:2, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:3, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:4, 'Cuentas: '~iif(vacio(Dialogo.Lista4),'Todas',Pipe2Comillas(Dialogo.Lista4)))
If Dialogo.Radio1=0
  ACT(a:5, 'Solo Debitos')
Endif
If Dialogo.Radio1=1
  ACT(a:5, 'Solo Creditos')
Endif
If Dialogo.Radio1=2
  ACT(a:5, 'Debitos y Creditos')
Endif
If Dialogo.Radio2=0
  ACT(a:6, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:6, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:6, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:6, 'Tipo de Cta: Caja de Ahorro')
Endif
If Dialogo.Radio2=4
  ACT(a:6, 'Tipo de Cta: Todas')
Endif
If Dialogo.Check1=0
  ACT(a:6, Val(a:6)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:6, Val(a:6)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:1..a:6,2)

ACT(b:7, 'Movimientos del Dia '~Dialogo.Fecha1)
SetFont(b:7,3)

SetFilaActual(8)

SQL.ADD(" SELECT M.*, E.Nombre, E.Codigo MonedaFPA, V.Descripcion, V.Codigo VehiculoFPA, ")
SQL.ADD(" C.Numero, C.Codigo CuentaFPA, C.Alias3, C.TipoCuenta, B.Codigo BancoFPA, B.RazonSocial, CD.Descripcion CDDescripcion ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".ESPECIES E, "~DBO~".CLIENTES B, ")
SQL.ADD(" "~DBO~".VEHICULOS V, "~DBO~".DATANET D, "~DBO~".CUENTAS C, "~DBO~".CODIGOSDATANET CD ")
SQL.ADD(" WHERE M.Moneda    = E.Alias3 ")
SQL.ADD(" AND   M.Vehiculo  = V.Codigo ")
SQL.ADD(" AND   M.Cuenta    = C.Numero ")
SQL.ADD(" AND   M.Banco     = B.Alias2 ")
SQL.ADD(" AND   C.Comitente = B.Codigo ")
SQL.ADD(" AND   D.NrDatanet = M.NrDatanet ")
SQL.ADD(" AND   M.TipoMov   *= CD.Codigo ")
SQL.ADD(" AND   D.Archivo IN ('DNCCHY','DNCAHY','DNCDHY','DNADHY')  ")
SQL.ADD(" AND   D.FechaDesde = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   D.FechaHasta = "~IdxDate2(Dialogo.Fecha1)~" ")
If Dialogo.radio1=1
  SQL.ADD(" AND M.DC = 'C' ")
Endif
If Dialogo.radio1=0
 SQL.ADD(" AND M.DC = 'D' ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND B.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
  SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
SQL.ADD(" ORDER BY V.Codigo, B.Codigo, C.Codigo, E.Codigo ")

ACT(va:1,'')
ACT(ba:1,'')
ACT(ea:1,'')
ACT(ca:1,'')

Recorrer SQL
  If Not Eqstr(fbn('VehiculoFPA'),Val(va:1)) o Not Eqstr(fbn('BancoFPA'),Val(ba:1)) o Not Eqstr(fbn('CuentaFPA'),Val(ca:1)) o Not Eqstr(fbn('MonedaFPA'),Val(ea:1))
    If Not Eqstr(Val(va:1),'')
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Descripcion')~'  Banco: '~fbn('RazonSocial'))
    message('_____  Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    ACT(a:fac, 'Banco: '~fbn('RazonSocial'))
    ACT(c:fac, 'Vehiculo: '~fbn('Descripcion'))
    ACT(tc:1, iif(eqstr(fbn('TipoCuenta'),'CC'),'Cuenta Corriente', iif(eqstr(fbn('TipoCuenta'),'CA'),'Caja de Ahorro',iif(eqstr(fbn('TipoCuenta'),'VIS'),'Cuenta Vista',IIF(eqstr(fbn('TipoCuenta'),'CUS'),'Cuenta Custodia')))))
    ACT(a:fac+1, 'Movimientos del Dia en '~fbn('Nombre'))
    ACT(c:fac+1, 'Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    SetFont(a:fac..g:fac+1,2)
    AgregarMarco(a:fac..d:fac+1,0,0,RGB(162,222,251))

    SetFilaActual(fac+2)
    ACT(a:fac,   'Cod.Operacion')
    ACT(b:fac,   'Comprobante')
    ACT(c:fac,   'Sucursal')
    ACT(d:fac,   'Importe')
    
    SetFont(a:fac..g:fac+1,2)
    AlinearCeldas(a:fac..g:fac+1,'C')
    AgregarMarco(a:fac..d:fac+1,0,0,RGB(199,207,207))
    ifa
    ifa
  Endif

  ACT(a:fac, fbn('TipoMov')~' - '~fbn('CDDescripcion'))
  ACT(b:fac, fbn('Comprobante'))
  ACT(c:fac, fbn('Sucursal'))
  ACN(d:fac, fbn('Importe')*iif(Eqstr(fbn('DC'),'D'),-1,1 ))

  FormatoCeldas(d:fac, EXE('F2'))
  SetFont(a:fac..g:fac,1)

  ACT(va:1,fbn('VehiculoFPA'))
  ACT(ba:1,fbn('BancoFPA'))
  ACT(ea:1,fbn('MonedaFPA'))
  ACT(ca:1,fbn('CuentaFPA'))
