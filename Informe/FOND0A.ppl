ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha Desde" ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Fecha2     : "Fecha Hasta" ;2;1;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys
  Cliente1   : "Entidad"     ;3;1;
  Especie2   : "Moneda"      ;4;1;
  Especie1   : "Fondo"       ;5;1;
  Radio1     : "Tipo|Money Markets|Securities|Todos" ;6;1;;;;;;;2
  Radio2     : 'Filtra Book|SI|NO'    ;7;1;;;;;;;1;
  Lista1     : 'Vehiculos'            ;8;1;;;Dialogo.Radio2=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Vehiculo1  : 'Vehiculo'             ;2;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2     : 'Books'                ;3;1;;;Dialogo.Radio2=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Radio3     : 'Consolida Book|SI|NO' ;4;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;;;;0;
FinDialogo

if Not Ok
  Cancelar
endif

***Si se selecciona Book, uso el mismo código cambiando lista vehiculo por campo vehiculo
IF Dialogo.Radio2 = 0 
  ACT(zz6,Dialogo.Vehiculo1)
  IF NoVacio(Dialogo.Lista2)
    ***ZZ6 es la celda que guarda la variable de vehiculo, seguirla a través del script
    ***ZZ7 Guarda el dato del Book
    ACT(ZZ:7, Dialogo.Lista2)
  ELSE
    ACT(ZZ:7, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' "))
  EndIf
  *** Si no se selecciona Book (el Radio2 es uno) entonces trabaja igual que antes:
ELSE
  * Vehiculos permitidos por el usuario
  If NoVacio(Dialogo.Lista1)
     ACT(zz6,Dialogo.Lista1)
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
    Else
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')")) 
    EndIf
    EndIf
ENDIF


CrearFont(1,"Arial,8,")
