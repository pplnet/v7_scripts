acn(cz1,0)

Recorrer SQL
  if Not EqStr(val(ca4),fbn['EnteCustodia']) o Not EqStr(val(ca2),fbn['Issuer']) o Not EqStr(val(ca1),fbn['Cotiza']) o Not EqStr(val(ca3),fbn['Especie']) o (Dialogo.Radio3=1 y Not EqStr(Val(ca5),fbn['Book']))
    ACT(ca5,fbn['Book'])
    if val(cz1) > 0
        acd(a:fac,Dialogo.Fecha2)
        acn(g:fac,val(g:fac-1))
        acn(h:fac,val(g:fac-1)*Cotizacion(val(ca3),,,,Habiles(Dialogo.Fecha2,0,'ARG',SI),1))
        SetFont(a:fac..h:fac,2)
        AgregarMarco(a:fac..i:fac,2,0)
        ifa
        ifa
        ifa
     endif
     act(a:fac,'Vehiculo : '~fbn['EnteCustodia']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['EnteCustodia']))
     act(ca4,fbn['EnteCustodia'])
     If Dialogo.Radio3=1
     *act(a:fac+1,'Book : '~fbn['Book']  )
     act(a:fac+1,Val(a:fac+1)~'| ' ~fbn['Book']  )
        act(ca5,fbn['Book'])
     Else
        act(a:fac+1,'Book : Todos ')
        act(ca5,fbn['Book'])
     Endif
     act(a:fac+2,'Entidad : '~fbn['Issuer']~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',fbn['Issuer']))
     act(ca2,fbn['Issuer'])
     act(a:fac+3,'Moneda : '~fbn['Cotiza']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Cotiza']))
     act(ca1,fbn['Cotiza'])
     act(a:fac+4,'Fondo: '~fbn['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
     act(ca3,fbn['Especie'])
     act(a:fac+5,'Valor Cuotaparte: ')
     acn(c:fac+5,Cotizacion(fbn['Especie'],,,,Habiles(Dialogo.Fecha2,0,'ARG',SI),1))
     FormatoCeldas(c:fac+5..c:fac+5,Exe('F7'))
     SetFont(a:fac..r:fac+5,2)

     SetFilaActual(fac+7)
     act(a:fac,'Fecha Origen')
     act(b:fac,'Valor Cuotaparte')
     act(c:fac,'Debito')
     act(e:fac,'Credito')
     act(g:fac,'Saldo')
     act(i:fac,'Nro.Operacion')
     act(c:fac+1,'Cuota')
     act(d:fac+1,'Monto')
     act(e:fac+1,'Cuota')
     act(f:fac+1,'Monto')
     act(g:fac+1,'Cuota')
     act(h:fac+1,'Monto')
     SetFont(a:fac..i:fac+1,2)
     AgregarMarco(a:fac..b:fac+1,2,0,Exe('COLOR'))
     AgregarMarco(c:fac..d:fac,2,0,Exe('COLOR'))
     AgregarMarco(e:fac..f:fac,2,0,Exe('COLOR'))
     AgregarMarco(g:fac..h:fac,2,0,Exe('COLOR'))
     AgregarMarco(c:fac+1..h:fac+1,2,2,Exe('COLOR'))
     AgregarMarco(i:fac..i:fac+1,2,0,Exe('COLOR'))
     ifa
     ifa
  endif
  acd(a:fac,fbn['Fecha'])
  If fbn['Tip'] = 1
     If Eqstr(FBN('TipoOp'), 'DIVIDE')
        acn(b:fac, Cotizacion(fbn['Especie'],,,,val(a:fac),1,SI))
     Else
        acn(b:fac,fbn['Precio1'])
     Endif
     act(i:fac,fbn['NrOperacion'])
     aclo(i:fac,fbn['NrOperacion'])
  Else
     acn(b:fac,Cotizacion(fbn['Especie'],,,,Habiles(val(a:fac),1,'ARG',SI),1))
     act(i:fac,'Inicial')
  Endif
  if fbn['Cantidad'] < 0
     acn(c:fac,fbn['Cantidad']*(-1))
     acn(d:fac,fbn['Cantidad']*val(b:fac)*(-1))
  else    
     acn(e:fac,fbn['Cantidad'])
     acn(f:fac,fbn['Cantidad']*val(b:fac))
  endif
  if val(cz1) = 0
     acn(g:fac,fbn['Cantidad'])
     acn(h:fac,fbn['Cantidad']*val(b:fac))
    else
     acn(g:fac,val(g:fac-1)+fbn['Cantidad'])
     acn(h:fac,(val(g:fac-1)+fbn['Cantidad'])*val(b:fac))
  endif
  SetFont(a:fac..i:fac,1)
  FormatoCeldas(b:fac..b:fac,Exe('F7'))
  FormatoCeldas(C:fac..H:fac,Exe('F2'))
  acn(cz1,1)
proximo

