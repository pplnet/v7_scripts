if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+5, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
 else
 ACT(a:FAC+5, 'Entidad : Todas')
endif
if NoVacio(Dialogo.Especie2)
  ACT(a:FAC+6, 'Moneda : '~Dialogo.Especie2~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie2))
 else
 ACT(a:FAC+6, 'Moneda : Todas')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+7, 'Fondo : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
 ACT(a:FAC+7, 'Fondo : Todos')
endif
ACT(a:FAC+8, 'Tipo Fondo : '~iif(Dialogo.Radio1=2,'Todos',iif(Dialogo.Radio1=1,'Securities','Money Markets')))
