   Ifa 


   *- Total General
   ACT(a:fac,'TOTAL GENERAL En '~val(mo1))
 
   ACN(d:fac,val(ad:2) )
   ACN(h:fac,val(ah:2) )
   ACN(i:fac,val(ai:2) )
   ACN(j:fac,val(aj:2) )
   ACN(k:fac,val(ak:2) )
   ACN(m:fac,val(am:2) )
   ACN(n:fac,val(an:2) )
   ACN(o:fac,val(ao:2) )
   ACN(p:fac,val(ap:2) )
   ACN(r:fac,val(ar:2) )
   ACN(s:fac,val(as:2) )
   ACN(t:fac,val(at:2) )
   ACN(u:fac,val(au:2) )
   ACN(v:fac,val(av:2) )
   ACN(w:fac,val(aw:2) )
   ACN(x:fac,val(ax:2) )
   ACN(y:fac,val(ay:2) )
   ACN(bc:fac,val(az:2) )

   SetFont(a:fac..y:fac,2)
   AgregarMarco(a:fac..ag:fac,0,0,Exe('COLOR'))       

endif
