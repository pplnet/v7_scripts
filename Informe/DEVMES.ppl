SCN(ai:1,Round(val(i:fac),2) )
SCN(aj:1,Round(val(j:fac),2) )
SCN(ak:1,Round(val(k:fac),2) )
SCN(am:1,Round(val(m:fac),2) )
SCN(an:1,Round(val(n:fac),2) )
SCN(ao:1,Round(val(o:fac),2) )
SCN(ap:1,Round(val(p:fac),2) )
SCN(ar:1,Round(val(r:fac),2) )
SCN(as:1,Round(val(s:fac),2) )
SCN(at:1,Round(val(t:fac),2) )
SCN(au:1,Round(val(u:fac),2) )
SCN(av:1,Round(val(v:fac),2) )
