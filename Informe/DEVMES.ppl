Recorrer&k 1, Val(EL:1)
    IF Not Incluido(ItemLista(Val(ES:1), &k), Val(ES:2))
        ACT(ES:2, Val(ES:2)~ItemLista(Val(ES:1), &k)~'|')
    ENDIF
Proximo

