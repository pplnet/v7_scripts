* Informe de Devengamientos del Mes 
*- Debo recuperar las operaciones vigentes al primer dia del mes
ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1      : "Fecha Vigencia"    ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Vigencia Invalida';NO;FinDeMes(Fsys,SI);
   Cliente1    : "Entidad"           ;;;;;;;;;;;;;
   Especie1    : "Especie"           ;;;;;;;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;
   NrOperacion1: "NrOperacion"       ;;;;;;;;;;;;;;" TipoOp In ('MMON','MMONM','MMPSC','MMPSI','MMSCMV','MMSIMV','MMO','MMCCR','MMDCA','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPLME','MMPCCV','DTSFF','DTSFV','DTSVV','DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','MMCPM','SERA','SERAV','MMCAUA','MMCAUP','SERP','SERPV','MMDC')"
   Check1      : "Interes"           ;;;;;;;;;1
   Check2      : "Imp.Interes"       ;;;;;;;;;1
   Check5      : "Imp.WH"            ;;;;;;;;;1
*  Check3      : "ComisionEF"        ;;;;;;;;;1
   Check4      : "Prima/Dto ON"      ;;;;;;;;;1
   Radio1      : "Expresado|"~Var('MONELOCA')~"|"~Var('MONEEXTR')~"|Moneda Original" ;;;;;;;;;2
   Lista2      : "TipoOp"            ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMON','MMONM','MMPSC','MMPSI','MMSCMV','MMSIMV','MMO','MMCP','MMCCR','MMDCA','MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME','MMPCCV','DTSFF','DTSFV','DTSVV','DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO','MMCPM','SERA','SERAV','MMCAUA','MMCAUP','SERP','SERPV','MMDC') ")   
   Lista1      : "Vehiculo"          ;-5;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
   Lista3      : "Comisiones"        ;-2;2;;;;;;;;;VAR('TCOMISION')
   Check6      : 'Visible'           ;;;;NO;NO;;;;0;
   Radio3      : "Consolidado|SI|NO" ;;;;SI;SI;;
   Vehiculo1   : "Grupo"             ;;;;NO;NO;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(5,"Arial,8,BI")

SetFilaActual(1)
ACT(d:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(d:1,2)

ACD(PM1,Dialogo.Fecha1)
ACT(PM2,Dialogo.Cliente1)
ACT(PM3,Dialogo.NrOperacion1)
ACN(PM4,Dialogo.Radio1)
ACN(PM5,Dialogo.Check1)
ACN(PM6,Dialogo.Check2)
*ACN(PM7,Dialogo.Check3)
ACN(PM8,Dialogo.Check4)
ACN(PM9,Dialogo.Check5)
ACT(PM10,Dialogo.Lista2)
ACT(PM11,Dialogo.Especie1)
ACT(PM12,Dialogo.Lista1)
ACT(PM13,Dialogo.Lista3)
ACT(PM14,IIF(Dialogo.Radio1=0,Var('MONELOCA'),IIF(Dialogo.Radio1=1,Var('MONEEXTR'),Dialogo.Especie1)) )
ACN(PM15, Dialogo.Radio3)
ACT(PM16, Dialogo.Vehiculo1)

if Dialogo.Radio1<>2 
   *- Si no esta expresado en moneda original 
   ***---ACT(LS:3, LeerObjeto('Monedas'))
   ACT(LS:3, SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB' "))
   IF Vacio(Dialogo.Especie1)
      ACN(EL:3, Elementos(Val(LS:3)))
   ELSE
      ACN(EL:3, Elementos(Dialogo.Especie1))
   ENDIF

   Recorrer&k 1, Val(EL:3)
      ACN(BD:2, 1)
      ACN(BD:1, 1)
      ifa
      IF Vacio(Dialogo.Especie1)
          ACT(A:fac, ItemLista(Val(LS:3), &k))
          ACN(B:fac, CotizacionC(ItemLista(Val(LS:3), &k),,,,Fsys,1,SI,Val(PM14)))
      ELSE
          ACT(A:fac, ItemLista(Dialogo.Especie1, &k))
          ACN(B:fac, CotizacionC(ItemLista(Dialogo.Especie1, &k),,,,Fsys,1,SI,Val(PM14)))
      ENDIF
   Proximo

   CrearDialogo
       Fecha1     : "Fecha Vig."   ;1;1;;NO;  ;;;;val(pm1);
       Especie1   : "Especie"          ;-14;1;;NO;NO;;;;val(pm11)
       Cliente1   : "Entidad"          ;-12;1;;NO;NO;;;;val(pm2);;;;
       NrOperacion1: "NrOperacion"     ;-12;1;;NO;NO;;;;val(pm3)
       Lista1      : "Vehiculo"        ;-11;1;;NO;NO;;;;val(pm12)
       Lista2      : "TipoOp"          ;-10;1;;NO;NO;;;;val(pm10)
       Radio3      : "Consolidado"          ;-10;1;;NO;NO;;;;val(pm15)
       Radio1      : "Expresado"          ;-10;1;;NO;NO;;;;val(pm4)
       Vehiculo1   : "Grupo"          ;-12;1;;NO;NO;;;;val(pm16);;;;
       ListBox; 'Arial,8,N';500;400
         'Especie'            ;A:2..A:fac;NO;;;;80;STRING
         'Cotizacion'         ;B:2..B:fac;SI;Val(B:FLB) > 0;'Cotizacion Invalida';;100;NUMERO;'###,###,###.########';
        FinListBox
   FinDialogo

   IF Not Ok
      Cancelar
   ENDIF

   Recorrer&k 2, fac
      ACT(LM:1, Val(LM:1)~Val(A:&k)~'|')
      ACT(LP:1, Val(LP:1)~Val(B:&k)~'|')
   Proximo

   if Val(BD:1) = 1
      ***---Se incluye moneda local. Pongo la cotizacion ingresada en el dialogo
      ACT(LM:1, Val(LM:1)~Var('MONELOCA')~'|')
      ACT(LP:1, Val(LP:1)~Fstr(1/Val(PR:2), 0, 8)~'|')
   endif

   ACN(EL:1, Elementos(Val(LM:1)))
endif

BorrarCeldas(a1..b:Val(EL:3)+10)

*- Control de vehiculos habilitados
ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")) )

SetFilaActual(3)
**-- ENCABEZADO
ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,2)

ACT(a:FAC  ,'Informe de Devengamientos del Mes de '~Meses(Val(PM1)))
SetFont(a:fac..a:fac+1,3)

SetFilaActual(4)

If NoVacio(Val(PM2))
   ACT(a:FAC+1, 'Entidad : '~Val(PM2)~' - '~BuscarCampo('Clientes','RazonSocial','Codigo',Val(PM2)))
Else
   ACT(a:FAC+1, 'Entidad : Todos')
Endif
if NoVacio(Val(PM13))
   ACT(a:FAC+2, 'Comisiones : '~Pipe2Comillas(Val(PM13)) )
Else
   ACT(a:FAC+2, 'Comisiones : Todas')
Endif
if NoVacio(Val(PM11))
   ACT(a:FAC+3, 'Especie : '~Pipe2Comillas(Val(PM11)) )
Else
   ACT(a:FAC+3, 'Especie : Todas')
Endif
If NoVacio(Val(PM3))
   ACT(a:FAC+4, 'NrOperacion: '~Val(PM3))
Else
   ACT(a:FAC+4, 'NrOperacion: Todas')
Endif
If NoVacio(Val(PM10))
   ACT(a:FAC+5, 'Tipo Op.: '~Val(PM10))
Else
   ACT(a:FAC+5, 'Tipo Op.: Todas')
Endif
ACT(a:FAC+7,'Expresado en  '~IIF(Val(PM4)=0,'Pesos',IIF(Val(PM4)=1,'Dolares','Moneda Original')))

ACN(fi1, FAC+1)
If Val(PM5)=1
   ACT(g:Val(fi1), ' Devenga Intereses')
   SCN(fi1, 1)
Endif
If Val(PM6)=1
   ACT(g:Val(fi1), ' Devenga Impuesto al Intereses')
   SCN(fi1, 1)
Endif
If NoVacio(Val(PM12))
   ACT(a:FAC+6, 'Vehiculo : '~Val(PM12))
Else
   ACT(a:FAC+6, 'Vehiculo : '~IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
Endif
If Val(PM8)=1
   ACT(g:Val(fi1), ' Devenga Primas y Descuentos de Emision de ON')
   SCN(fi1, 1)
Endif
If Val(PM9)=1
   ACT(g:Val(fi1), ' Devenga WHT ')
   SCN(fi1, 1)
Endif

SetFont(a:fac..N:FAC+7,2)
SetFilaActual(FAC+10)
**-------------------------------------------------------------------**
*- ma1: Fin del mes anterior
ACD(ma1,FinDeMes(PriDeMes(Dialogo.Fecha1,SI)-1, NO, 'ARG'))

*- Titulos
(.'TITDEVENG'.)

*- Expreasado en Moneda Extranjera
ACT(mo1,VAR('MONEEXTR'))
If Val(PM4)=0
   *- Expreasado en Moneda Local
   ACT(mo1,VAR('MONELOCA'))
EndIf

*- Select de Prestamos y de ON/P.Sindicados => Solamente los vigentes ese mes y los que 
*- vencieron ese mes
ACN(vf1,1)
ACN(vi1,1)

(.'PFPRESFINA'.)
SQL.ADD("Union All ")
(.'PFONPSI'.)
SQL.ADD("Union All ")
(.'DEVSWAPS'.)
SQL.ADD("Union All ")
(.'PFCOLOPF'.)
SQL.ADD("Union All ")
(.'PFDESCUB'.)
SQL.ADD("Union All ")
(.'PFREPOS'.)
*- Ordenado por Vehiculo,Grupo,Especie,NrOperacion
SQL.ADD(" Order By 1,2,9,3")

*- va1: Vehiculo va2: Grupo va3: Especie
ACT(va1, '')
ACT(va2, '')
ACT(va3, '')
ACN(co1, 0)

Recorrer SQL
     ***---Guardo lista de especies para tomarlo en interface contable
     ACT(ES:1, Val(ES:1)~fbn('Especie')~'|')

     Message(fbn['NrOperacion']~' '~fbn['FechaVto']~'  '~FBN['VResidual']~' '~fbn['TipoOp']~' '~FBN['Grupo']~' '~FBN['Especie'])

     * Fin de Corte
     If [Not EqStr(val(va2)~val(va3),FBN['Grupo']~FBN['Especie']) o Not EqStr(val(va1),FBN['Vehiculo1'])] y NoVacio(val(va3))
        ACT(a:fac,'Total '~val(va2)~' En '~val(va3))
   
        ACN(d:fac,SUM(d:val(lc1)..d:fac-1) )
        ACN(h:fac,SUM(h:val(lc1)..h:fac-1) )
        ACN(i:fac,SUM(i:val(lc1)..i:fac-1) )
        ACN(j:fac,SUM(j:val(lc1)..j:fac-1) )
        ACN(k:fac,SUM(k:val(lc1)..k:fac-1) )

        ACN(m:fac,SUM(m:val(lc1)..m:fac-1) )
        ACN(n:fac,SUM(n:val(lc1)..n:fac-1) )
        ACN(o:fac,SUM(o:val(lc1)..o:fac-1) )
        ACN(p:fac,SUM(p:val(lc1)..p:fac-1) )

        ACN(r:fac,SUM(r:val(lc1)..r:fac-1) )
        ACN(s:fac,SUM(s:val(lc1)..s:fac-1) )
        ACN(t:fac,SUM(t:val(lc1)..t:fac-1) )
        ACN(u:fac,SUM(u:val(lc1)..u:fac-1) )

        ACN(w:fac,SUM(w:val(lc1)..w:fac-1) )
        ACN(x:fac,SUM(x:val(lc1)..x:fac-1) )
        ACN(y:fac,SUM(y:val(lc1)..y:fac-1) )

        *- Indexacion 
        ACN(bc:fac,SUM(bc:val(lc1)..bc:fac-1) )

        SCN(BY:1,Round(val(d:fac),2))
        SCN(ah:1,Round(val(h:fac),2))
        SCN(ai:1,Round(val(i:fac),2))
        SCN(aj:1,Round(val(j:fac),2))
        SCN(ak:1,Round(val(k:fac),2))
        SCN(am:1,Round(val(m:fac),2))
        SCN(an:1,Round(val(n:fac),2))
        SCN(ao:1,Round(val(o:fac),2))
        SCN(ap:1,Round(val(p:fac),2))
        SCN(ar:1,Round(val(r:fac),2))
        SCN(as:1,Round(val(s:fac),2))
        SCN(at:1,Round(val(t:fac),2))
        SCN(au:1,Round(val(u:fac),2))
        SCN(av:1,Round(val(v:fac),2))
        SCN(aw:1,Round(val(w:fac),2))
        SCN(ax:1,Round(val(x:fac),2))
        SCN(ay:1,Round(val(y:fac),2))
        SCN(az:1,Round(val(bc:fac),2))

        SetFont(a:fac..bz:fac,5)
        AgregarMarco(a:val(lc1)..bz:fac,0,0)       
        ifa 
     EndIf

     If Not EqStr(val(va1),FBN['Vehiculo1']) y NoVacio(val(va1)) y Val(PM4)<>2
        Ifa
        *- Total Por Vehiculo
        ACT(a:fac,'TOTAL de '~val(va1)~' En '~val(mo1))

        ACN(d:fac,val(BY:1) )
        ACN(h:fac,val(ah:1) )
        ACN(i:fac,val(ai:1) )
        ACN(j:fac,val(aj:1) )
        ACN(k:fac,val(ak:1) )
        ACN(m:fac,val(am:1) )
        ACN(n:fac,val(an:1) )
        ACN(o:fac,val(ao:1) )
        ACN(p:fac,val(ap:1) )
        ACN(r:fac,val(ar:1) )
        ACN(s:fac,val(as:1) )
        ACN(t:fac,val(at:1) )
        ACN(u:fac,val(au:1) )
        ACN(v:fac,val(av:1) )
        ACN(w:fac,val(aw:1) )
        ACN(x:fac,val(ax:1) )
        ACN(y:fac,val(ay:1) )

        SCN(ad:2,val(d:fac) )
        SCN(ah:2,val(h:fac) )
        SCN(ai:2,val(i:fac) )
        SCN(aj:2,val(j:fac) )
        SCN(ak:2,val(k:fac) )
        SCN(am:2,val(m:fac) )
        SCN(an:2,val(n:fac) )
        SCN(ao:2,val(o:fac) )
        SCN(ap:2,val(p:fac) )
        SCN(ar:2,val(r:fac) )
        SCN(as:2,val(s:fac) )
        SCN(at:2,val(t:fac) )
        SCN(au:2,val(u:fac) )
        SCN(av:2,val(v:fac) )
        SCN(aw:2,val(w:fac) )
        SCN(ax:2,val(x:fac) )
        SCN(ay:2,val(y:fac) )
        SCN(az:2,val(bc:fac) )

        ACN(BY:1,0)
        ACN(ah:1,0)
        ACN(ai:1,0)
        ACN(aj:1,0)
        ACN(ak:1,0)
        ACN(am:1,0)
        ACN(an:1,0)
        ACN(ao:1,0)
        ACN(ap:1,0)
        ACN(ar:1,0)
        ACN(as:1,0)
        ACN(at:1,0)
        ACN(au:1,0)
        ACN(av:1,0)
        ACN(aw:1,0)
        ACN(ax:1,0)
        ACN(ay:1,0)
        ACN(az:1,0)

        SetFont(a:fac..ad:fac,2)
        AgregarMarco(a:fac..bz:fac,0,0,Exe('COLOR'))       
        Ifa 
     EndIf

     If Not EqStr(val(va1),FBN['Vehiculo1']) 
        ACT(a:fac,FBN['Vehiculo1'])
        SetFont(a:fac..a:fac,3)

        AgregarMarco(a:fac..bz:fac,0,0,Exe('COLOR'))       
        Ifa 
     EndIf

     * Corte de Control por Grupo 
     If Not EqStr(val(va2)~val(va3),FBN['Grupo']~FBN['Especie']) o Not EqStr(val(va1),FBN['Vehiculo1'])
        ACT(a:fac,FBN['Grupo']~' En '~FBN['Especie'])
        SetFont(a:fac..f:fac,5)
        acn(lc1,fac)

        Ifa
        ACT(va2,FBN['Grupo']) 
        ACT(va3,FBN['Especie']) 
        ifa     

        if Val(PM4)<>2 
           ACN(co1, BuscarLista(fbn['Especie'],Val(LM:1)) )
           ACN(co1, Num(ItemLista(Val(LP:1), Val(co1))) )
        else
           ACN(co1,1)
        endif
        if Not EqStr(val(va1),FBN['Vehiculo1'])
           ACT(va1,FBN['Vehiculo1'])
        endif
     EndIf

     ACT(a:fac , FBN['NrOperacion'])
     ACLO(a:fac, FBN['NrOperacion'])
     ACT(b:fac , FBN['TipoOp'])
     ACT(c:fac , FBN['Cliente1'])
     ACN(d:fac , FBN['VResidual']*val(co1) )
     ACD(e:fac, FBN['FechaOp'])
     ACD(f:fac, FBN['FechaVto'])

     IF Incluido(fbn('TipoOp'), 'MMON|MMONM')
         ***---Para ONs se informa Nr. de Serie de Emision
         ACT(EZ:fac, fbn('Observac3'))
     ENDIF

     ACT(EX:fac, fbn('Especie'))
     ACT(EC:fac, fbn('Cliente1'))
     ACN(EP:fac, fbn('Tasa'))
     ACT(EI:fac, fbn('ContraEspecie'))
     ACN(ED:fac, fbn('Spread'))
     ACD(EF:fac, fbn('FechaCargaSys'))
     ACT(EG:fac, fbn('Swap'))

     *- hd1: Hasta donde Devengar
     ACD(hd1,Val(PM1)+1)

     If val(f:fac)<val(hd1)
        ACD(hd1,val(f:fac))
     EndIf


     If Val(PM5)=1
        ACN(g:fac,FBN['Tasa']+FBN['Spread'])
        ACN(h:fac,FBN['TotalIntereses']*val(co1) )

        *- Intereses -> Dev.Acumulado, Dev.Mes, a Devengar
        */IF Incluido(fbn('TipoOp'), 'CC|CCMV|FXREPO|FXREPV|GA|GAMV|MMCCR|MMCDIA|MMCDP|MMCP|MMCPM|MMD|MMDC|MMDCA|MMO|SEABD|SEABP|SERA|SERAV|SERP|SERPV|TEMIND|TEMINM|VIMIND|VIMINM')
        */    ACN(pe1,0)
        */    IF Incluido(fbn('TipoOp'), 'MMCCR')
        */       ACN(pe1,BuscarCampo('OPERACIONES','PeriodoInts','NrOperacion',val(a:fac)) )
        */    EndIf
        */    ***---El Day Account de la operacion es 360 o 365 => se aplica calculo de la operacion
        */    ***---CANTIDAD*(SPREAD+PRECIO1)*PLAZO/IF(RB8=1,36500,36000)
        */    ACN(I:fac, (fbn('Cantidad') -val(pe1))* (fbn('Spread') + fbn('Tasa')) * (Val(HD:1)-Val(E:fac))            /IIF(fbn('RB8') = 1, 36500, 36000))
        */    ACN(J:fac, (fbn('Cantidad') -val(pe1))* (fbn('Spread') + fbn('Tasa')) * (Val(HD:1)-PriDeMes(Val(PM1),SI)) /IIF(fbn('RB8') = 1, 36500, 36000))
        */ELSE
        */    ACN(i:fac,val(d:fac)*(val(g:fac)/100)*FACTORDIAS(val(e:fac),val(hd1),FBN['RB8']+1))
        */    ACN(j:fac,val(d:fac)*(val(g:fac)/100)*FACTORDIAS(PriDeMes(Val(PM1),SI),val(hd1),FBN['RB8']+1))
        */ENDIF
        */If val(e:fac)>PriDeMes(Fecha(Val(PM1)),SI)
        */   ACN(j:fac,val(i:fac))
        */EndIf
        */ACN(k:fac,val(h:fac)-val(i:fac))

        **//Calculo de Colmunas I J K (Dev de Intereses)
        ACT(XX:99, 'INTLEN')
        (.'CALCDEV'.)
     EndIf

     *- Imp.Endeudamiento -> Dev.Acumulado, Dev.Mes, a Devengar
     *- Dias transcurridos del periodo para calcular devengados
     ACN(bd:fac,FactorDias2(val(e:fac),val(hd1),FBN['RB8']+1) )

     *- Dias transcurridos del mes para calcular devengados
     ACN(be:fac,FactorDias2(PriDeMes(Val(PM1),SI),val(hd1),FBN['RB8']+1) )

     If val(e:fac)>PriDeMes(Val(PM1),SI)
        ACN(be:fac,val(bd:fac))
     EndIf     

     If Val(PM6)=1
        ACN(l:fac,FBN['TasaImpInt'])
        ACN(m:fac,FBN['ImpInt']*val(co1) )
        ACN(n:fac,val(m:fac)*val(bd:fac)/(val(f:fac)-val(e:fac)))
        ACN(o:fac,val(m:fac)*val(be:fac)/(val(f:fac)-val(e:fac)))
        ACN(p:fac,val(m:fac)-val(n:fac))
     EndIf

     If Val(PM9)=1
        *- Imp.WH -> Dev.Acumulado, Dev.Mes, a Devengar
        ACN(q:fac,FBN['TasaWH'])
        ACN(r:fac,FBN['ImpWH']*Val(co1))
        */ACN(s:fac,val(r:fac)*val(bd:fac)/(val(f:fac)-val(e:fac)))
        */ACN(t:fac,val(r:fac)*val(be:fac)/(val(f:fac)-val(e:fac)))
        */ACN(u:fac,val(r:fac)-val(s:fac))
        *-Calculo de Colmunas S T U (Dev de WH)
        ACT(XX:99, 'INTWHT')
        (.'CALCDEV'.)
     EndIf

     *- Dias transcurridos Totales para calcular devengados de comisiones /Plazo de la Operacion
     ACN(ah:fac,FactorDias2(FBN['FInicio'],val(hd1),FBN['RB8']+1) /FBN['Plazo'])

     ACN(ai:fac,FactorDias2(PriDeMes(Val(PM1),SI),val(hd1),FBN['RB8']+1) /FBN['Plazo'])

     If FBN['FInicio']>PriDeMes(Val(PM1),SI)
        ACN(ai:fac,val(ah:fac))
     EndIf     

     If Val(PM8)=1
        ACN(v:fac,0)
        ACN(w:fac,0)
        ACN(x:fac,0)
        ACN(y:fac,0)

        If Incluido(FBN['TipoOp'],'MMON|MMONM')
           *- Prima o Descuento de Emision en ON -> Dev.Acumulado, Dev.Mes, a Devengar
           SQL.ADD(" Select MB3,TotalGastos,TotalDerechos FROM "~DBO~".OPERACIONES WHERE ")
           SQL.ADD(" MB3>0 and NrOperacion='"~FBN['NrOperacion']~"' ")
           Recorrer SQL
              dfa 
              ACN(v:fac,1-FBN['TotalGastos'] )
              FormatoCeldas(v:fac,EXE('F5'))
              ACN(w:fac,FBN['TotalDerechos'] )
              ACN(x:fac,val(w:fac)*val(ah:fac) )
              ACN(y:fac,val(w:fac)*val(ai:fac) )
              ACN(z:fac,val(w:fac)-val(x:fac))

              IF FBN['MB3']=2
                 *- Dto de Emision
                 ACN(w:fac,-val(w:fac))
                 ACN(x:fac,-val(x:fac))
                 ACN(y:fac,-val(y:fac))
                 ACN(z:fac,-val(z:fac))
              EndIf

              ACN(w:fac, Val(w:fac)*Val(co1) )
              ACN(x:fac, Val(x:fac)*Val(co1) )
              ACN(y:fac, Val(y:fac)*Val(co1) )
              ACN(z:fac, Val(z:fac)*Val(co1) )

           Proximo
        EndIf
     EndIf

     *- Recupero el resultado de Indexacion
     ACT(op1,val(a:fac))

     (.'IDXDEVMES'.)

     acn(co2,0)
     acn(lc2,fac)
     act(aa:fac,'')
     acn(ab:fac,0)
     acd(ac:fac,0)
     acn(ad:fac,0)
     acn(ae:fac,0)
     acn(af:fac,0)

     if NoVacio(Val(PM13))
        *- Obtengo los numeros corresp. a los distintos tipos de comisiones
        ACT(zz1,'FPD|FFC|CDO|CPI|CF|EF')
        ACN(zz2,Elementos(Val(PM13)) )
        ACT(zz5,'')
        Recorrer&i 1,Val(zz2)
          ** recupero el texto del item
          ACT(zz3,ItemLista(Val(PM13),&i) )
          ** recupero la posicion en la Lista Original del item
          ACN(zz4, BuscarLista(Val(zz3),Val(zz1)) )
          ACT(zz5, Val(zz5)~IIF(EqStr(Val(zz5),''),"'",",'")~FStr(Val(zz4)-1,0,0)~"'" )
        Proximo
     endif
     ACN(xx1, 0)


     *- dd1: Desde donde devengar
     ACD(dd1,PriDeMes(Val(PM1),SI))
     If val(e:fac)>=PriDeMes(Val(PM1),SI)
        ACD(dd1,val(e:fac))
     EndIf

     *- hd2: Hasta donde Devengar Comisiones (Fin de la operacion, no de la cuota)
     ACD(hd2,Val(PM1)+1)
     If FBN['FFin']<val(hd2)
        ACD(hd2,FBN['FFin'])
     EndIf

     *- dc1: Devengado para comisiones
     ACN(dc1,DIFDIAS(val(dd1),val(hd2),,NO)/FBN['Plazo'] )


     *- Por cada operacion recupero las comisiones 
     SQL.ADD("SELECT C.* FROM "~DBO~".COMISIONES2 C ")
     SQL.ADD("WHERE  C.NrOperacion='"~val(a:fac)~"' ")
     IF Not CeldaVacia(SS:1)
         ***---Si se repite la operacion, no calcula devengado comision
         SQL.ADD(" AND C.NrOperacion <> '"~Val(SS:1)~"' ")
     ENDIF
     if NoVacio(Val(PM13))
        SQL.ADD("       and C.Tipo in ("~Val(zz5)~") ")
     endif
     *SQL.ADD("       and C.Fecha1>='"~IdxDate(Val(e:fac))~"' and C.Fecha1<='"~IdxDate(Val(f:fac))~"' ")
     SQL.ADD("ORDER BY C.Fecha1 ")
     Recorrer SQL   
        If val(co2)=0
           dfa
           acn(co2,1)
        EndIf
        If EqStr(FBN['Tipo'], '0')
           ACT(aa:fac,'FPD') 
        Endif       
        If EqStr(FBN['Tipo'], '1')
           ACT(aa:fac,'FFC') 
        Endif       
        If EqStr(FBN['Tipo'], '2')
           ACT(aa:fac,'CDO') 
        Endif       
        If EqStr(FBN['Tipo'], '3')
           ACT(aa:fac,'CPI') 
        Endif    
        If EqStr(FBN['Tipo'], '4')
           ACT(aa:fac,'CF') 
        Endif       
        If EqStr(FBN['Tipo'], '5')
           ACT(aa:fac,'EF') 
        Endif          

        ACN(ab:fac,FBN['Tasa1']) 
        ACD(ac:fac,FBN['Fecha1'])   
        ACN(ad:fac,FBN['Importe1']*Val(co1))    

        *- Devengado => Misma formula que comisiones por prestamos
        *- Claudia 30.10.2002
        *If EqStr(FBN['Tipo'],'2')
        *   *- CDO Desde el inicio de la operacion
        *   ACN(ae:fac,FBN['Importe1']*val(ah:val(lc2))*Val(co1) )     
        *Else
        *   *- CDO Desde el inicio del periodo de interes
        *   ACN(ae:fac,FBN['Importe1']*val(bd:val(lc2))*Val(co1)/(val(f:fac)-val(e:fac)) )     
        *EndIf

        ACN(ae:fac,FBN['Importe1']*Val(co1)*val(dc1) ) 


        *- Iva
        ACN(af:fac,FBN['Importe2']*Val(co1))    

        *- Wh 
        ACN(ag:fac,FBN['Importe3']*Val(co1)*val(dc1) )    
        SetFont(a:fac..bz:fac,1)
        SCN(xx1, 1)
        ACT(SS:1, fbn('NrOperacion'))
        ACT(AZ:fac, fbn('NrOperacion'))
    Proximo            
    SetFont(a:fac..bz:fac,1)


    (.'COMCENCEC'.)
    
    Recorrer SQL
       If Val(xx1)=0
          dfa
          ACN(xx1, 1)  
       Endif
       ACT(aa:fac, FBN['Tipo'])
       ACN(ab:fac,FBN['Tasa'])
       ACD(ac:fac, FBN['Fecha']) 

       ***---Se devenga por cuota.
       ***---AQ:1 = Fecha Desde
       ***---AQ:2 = Fecha Hasta
       ***---AQ:3 = Cantidad de dias a devengar
       ***---AQ:4 = Dias totales del periodo
       IF fbn('FInicio') > PriDeMes(Dialogo.Fecha1, SI)
           ACD(AQ:1, fbn('FInicio'))
       ELSE
           ACD(AQ:1, PriDeMes(Dialogo.Fecha1, SI))
       ENDIF
       IF fbn('FFin') > Dialogo.Fecha1+1
           ACD(AQ:2, Dialogo.Fecha1+1)
       ELSE
           ACD(AQ:2, fbn('FFin'))
       ENDIF
       ACN(AQ:3, Val(AQ:2) - Val(AQ:1))
       ACN(AQ:4, fbn('FFin') - fbn('FInicio'))
   
       IF Val(PM:4) = 2
           ACN(ad:fac,FBN['Importe'])

           *- Devengado 
           ACN(ae:fac,val(ad:fac) / Val(AQ:4) * Val(AQ:3))
           *- Iva
           ACN(af:fac,FBN['Iva'])
       ELSE
           ACN(co1, BuscarLista(Trim(fbn('Especie1')),Val(LM:1)))
           ACN(co1, Num(ItemLista(Val(LP:1), Val(co1))) )
           ACN(ad:fac,FBN['Importe'] * Val(CO:1))

           *- Devengado 
           ACN(ae:fac,val(ad:fac) / Val(AQ:4) * Val(AQ:3))

           *- Iva
           ACN(af:fac,FBN['Iva'] * Val(CO:1))
       ENDIF

       SetFont(a:fac..bz:fac,1)
       ACT(AZ:fac, Val(A:Val(LC:2)))
    Proximo      
    
    **//Comisiones de Mercado y corredor para Cauciones
    If Incluido(FBN('TipoOp'),'MMCAUA|MMCAUP|')
       If NoVacio(FBN('Mercado'))
          If NoVacio(Val(aa:fac))
             IFA
          Endif
          ACT(aa:fac, 'Mercado')
          ACN(ab:fac, FBN('PorComMer1'))
          ACD(ac:fac, FBN('FechaVto')) 
          ACN(ad:fac, FBN('ImpComMer1')*Val(co1))
          ACN(ae:fac, FBN('ImpComMer1')*Val(co1)*val(dc1))
          ACN(af:fac, 0)
          ACN(ag:fac, 0)
          SetFont(a:fac..bz:fac,1)
       Endif
       If NoVacio(FBN('Corredor'))
          If NoVacio(Val(aa:fac))
             IFA
          Endif
          ACT(aa:fac, 'Corredor')
          ACN(ab:fac, FBN('PorComCor1'))
          ACD(ac:fac, FBN('FechaVto')) 
          ACN(ad:fac, FBN('ImpComCor1')*Val(co1))
          ACN(ae:fac, FBN('ImpComCor1')*Val(co1)*val(dc1))
          ACN(af:fac, FBN('IVAComCor'))
          ACN(ag:fac, 0)
          SetFont(a:fac..bz:fac,1)
       Endif
    Endif
Proximo
Ifa

ACT(a:fac,'Total '~val(va2)~' En '~val(va3) )
   
ACN(d:fac,SUM(d:val(lc1)..d:fac-1) )
ACN(h:fac,SUM(h:val(lc1)..h:fac-1) )
ACN(i:fac,SUM(i:val(lc1)..i:fac-1) )
ACN(j:fac,SUM(j:val(lc1)..j:fac-1) )
ACN(k:fac,SUM(k:val(lc1)..k:fac-1) )

ACN(m:fac,SUM(m:val(lc1)..m:fac-1) )
ACN(n:fac,SUM(n:val(lc1)..n:fac-1) )
ACN(o:fac,SUM(o:val(lc1)..o:fac-1) )
ACN(p:fac,SUM(p:val(lc1)..p:fac-1) )

ACN(r:fac,SUM(r:val(lc1)..r:fac-1) )
ACN(s:fac,SUM(s:val(lc1)..s:fac-1) )
