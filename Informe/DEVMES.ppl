SCN(az:1,Round(val(bc:fac),2) )

SetFont(a:fac..bz:fac,5)
AgregarMarco(a:val(lc1)..bz:fac,0,0)       
ifa 

if Val(PM4)<>2
   Ifa
   *- Total Por Vehiculo
   ACT(a:fac,'TOTAL de '~val(va1)~' En '~val(mo1))

   ACN(d:fac,val(BY:1) )
   ACN(h:fac,val(ah:1) )
   ACN(i:fac,val(ai:1) )
   ACN(j:fac,val(aj:1) )
   ACN(k:fac,val(ak:1) )
   ACN(m:fac,val(am:1) )
   ACN(n:fac,val(an:1) )
   ACN(o:fac,val(ao:1) )
   ACN(p:fac,val(ap:1) )
   ACN(r:fac,val(ar:1) )
   ACN(s:fac,val(as:1) )
   ACN(t:fac,val(at:1) )
   ACN(u:fac,val(au:1) )
