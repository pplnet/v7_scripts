   SCN(aj:2,val(j:fac) )
   SCN(ak:2,val(k:fac) )
   SCN(am:2,val(m:fac) )
   SCN(an:2,val(n:fac) )
   SCN(ao:2,val(o:fac) )
   SCN(ap:2,val(p:fac) )
   SCN(ar:2,val(r:fac) )
   SCN(as:2,val(s:fac) )
   SCN(at:2,val(t:fac) )
   SCN(au:2,val(u:fac) )
