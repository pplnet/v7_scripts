CrearDialogo
  Fecha1     : 'F.Valor D'      ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Valor Desde Invalida';NO;PriDeMes(Fsys, SI);
  Fecha2     : 'F.Valor H'      ;1;2;;;;Dialogo.Fecha2<>0;'Fecha Valor Hasta Invalida';NO;FinDeMes(Fsys, SI);
  Especie1   : 'Moneda'         ;3;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where Jerarquia Like '"~Var('JERMONEDA')~"%' ")
  Vehiculo1  : 'Grupo'          ;5;1;;Vacio(Dialogo.Lista2);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista2     : 'Vehiculo'       ;7;1;;Vacio(Dialogo.Vehiculo1);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,12,B")
CrearFont(4,"Arial,10,B")
SetFilaActual(1)

ACT(b:1, 'Movimientos Cuentas Vista')
SetFont(b:1, 3)

SetFilaActual(2)
ACN(w:1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~' - '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  If NoVacio(Dialogo.Lista2)
    ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Lista2)
  Else 
    ACT(a:FAC+1, 'Vehiculo : Todos')
  EndIf
endif
SetFont(a:Fac+1,2)

if NoVacio(Dialogo.Especie1)
  ACT(C:FAC+1, 'Especie : '~Dialogo.Especie1)
else
  ACT(C:FAC+1, 'Especies : Todas')
endif
SetFont(c:Fac+1,2)

ACT(a:FAC+2, 'Ope.Desde : '~Dialogo.Fecha1)
ACT(c:FAC+2, 'Ope.Hasta : '~Dialogo.Fecha2)
SetFont(a:FAC+2..c:FAC+2,2)

SetFilaActual(FAC+5)

ACT(A:FAC, "Codigo SAP")
ACT(B:FAC, "Vehiculo")
ACT(C:FAC, " Documento")
ACT(D:FAC, "Detalle Docum")
ACT(E:FAC, "Fec.Carga")
ACT(F:FAC, "Fec.Docum")
ACT(G:FAC, "Fec.Valor")
ACT(H:FAC, "Cta Contable")
ACT(I:FAC, "Moneda")
ACT(J:FAC, "Importe Mon.Local")
ACT(K:FAC, "Importe Mon.Doc")
ACT(L:FAC, "Sistema Origen") 

AlinearCeldas(I:FAC..K:FAC,'C')
SetFont(a:FAC..L:FAC, 2)
AgregarMarco(a:FAC..L:FAC,2,0,Exe('COLOR'))

SQL.ADD(" SELECT M.CodigoSAP,M.Documento,M.DetalleDoc,M.FechaDoc, M.CuentaContable,M.FechaValor, ") 
SQL.ADD(" M.Vehiculo,M.Moneda,M.ImporteMonedaLocal,M.FechaCarga,M.ImporteMonedaDoc,M.SistemaOrigen  ")
SQL.ADD(" From "~DBO~".MOVCTAVISTA M ") 
SQL.ADD(" Where M.FechaValor >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND M.FechaValor <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND M.Moneda = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ELSE
    IF NoVacio(Dialogo.Vehiculo1)
        SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~") ")
    ENDIF
ENDIF
*-----------------------------------------------------------------------------****

SQL.ADD(" Order by M.CodigoSAP ")
ACT(xx:1, '')

Recorrer SQL
  If Not EqStr(FBN['Vehiculo'], Val(xx:1)) Y Not CeldaVacia(xx:1)  
    SetFilaActual(FAC+1)
    ACT(A:FAC, 'Codigo SAP')
    ACT(B:FAC, 'Vehiculo')
    ACT(C:FAC, 'Documento')
    ACT(D:FAC, 'Detalle Docum')
    ACT(E:FAC, 'Fec.Carga')
    ACT(F:FAC, 'Fec.Docum')
    ACT(G:FAC, 'Fec.Valor')
    ACT(H:FAC, 'Cta Contable')
    ACT(I:FAC, 'Moneda')
    ACT(J:FAC, 'Importe Mon.Local')
    ACT(K:FAC, 'Importe Mon.Doc')
    ACT(L:FAC, 'Sistema Origen')
   
    AlinearCeldas(I:FAC..L:FAC,'C')
 
    SetFont(a:FAC..l:FAC,2)
    AgregarMarco(a:FAC..O:FAC,2,0,Exe('COLOR'))      
    SetFilaActual(FAC+1)  
  EndIf

 
  ACT(A:fac, fbn('CodigoSAP'))
  ACT(B:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo',fbn('Vehiculo']),1,10))
  ACT(C:fac, fbn('Documento'))
  ACT(D:fac, fbn('DetalleDoc'))
  ACD(E:fac, fbn('FechaCarga'))
  ACD(F:fac, fbn('FechaDoc'))
  ACD(G:fac, fbn('FechaValor'))
  ACT(H:FAC, fbn('CuentaContable'))
  ACT(I:fac, fbn('Moneda'))
  ACN(J:fac, fbn('ImporteMonedaLocal'))
  ACN(K:fac, fbn('ImporteMonedaDoc'))
  ACT(L:FAC, fbn('SistemaOrigen'))
    
  SCN(Z:7, fbn('ImporteMonedaLocal'))
  SCN(Z:8, fbn('ImporteMonedaDoc'))
  
  SetFont(a:FAC..O:FAC,1)
  AlinearCeldas(a:FAC..d:FAC,'I')
  AlinearCeldas(e:FAC..f:FAC,'C')
  AlinearCeldas(E:FAC..G:FAC,'C')
  AlinearCeldas(g:FAC..g:FAC,'D')
  AlinearCeldas(H:FAC..H:FAC,'I')
  AlinearCeldas(I:FAC..I:FAC,'C')
  AlinearCeldas(J:FAC..K:FAC,'D')
  AlinearCeldas(L:FAC..L:FAC,'C')
 
  FormatoCeldas(D:fac..D:fac,Exe('F2'))
  FormatoCeldas(J:fac..K:fac,Exe('F2'))
  ACT(xx:1, fbn('Vehiculo'))
proximo

