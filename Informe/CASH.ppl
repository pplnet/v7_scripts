HojaVisible(NO)
ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1     : "Fecha"                     ;1;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
   Radio2     : "Tipo|Diario|Mensual-Anual" ;;;;;;;;;0
   Radio1     : "|Consolidado|Vehiculo"     ;;;;;;;;;0
   Radio3     : "Minutas|Reales|Reales-Simuladas";;;;;;;;;0
   Check1     : "Capital"                   ;;;;;;;;;1
   Check2     : "Interes"                   ;;;;;;;;;1
   Check3     : "Impuestos"                 ;;;;;;;;;1
   Radio10    : "TasaSimulada|NO|SI"        ;;;;;;;;;1
   Lista1     : "Vehiculo"                  ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Lista1);'Debe Ingresar una Empresa';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Radio4     : "Expresado|Pesos|Dolares"   ;;;;;;;;;0
FinDialogo

If Not Ok
   Cancelar
Endif

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

If Dialogo.Radio1=0
   *- Consolidado ->
   LinkearHoja('CASHAU',1,Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1='',Radio3=Dialogo.Radio3,Check1=Dialogo.Check1,Check2=Dialogo.Check2,Check3=Dialogo.Check3, Radio10 = Dialogo.Radio10, Radio4=Dialogo.Radio4)
Else 
   *- Selecciono los vehiculos de la Lista
   SQL.ADD("Select Codigo FROM "~DBO~".VEHICULOS where ")
   If NoVacio(Val(zz6))
      SQL.ADD(" Codigo in ("~Pipe2Comillas(val(zz6))~") ")
   Endif
   
   Recorrer SQL
       Message('Procesando Cash Flow Vehiculo '~FBN['Codigo'])
       LinkearHoja('CASHAU',1,Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=FBN['Codigo'],Radio3=Dialogo.Radio3,Check1=Dialogo.Check1,Check2=Dialogo.Check2,Check3=Dialogo.Check3, Radio10 = Dialogo.Radio10, Radio4=Dialogo.Radio4)
   Proximo 
EndIf
