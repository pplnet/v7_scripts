*ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : 'Grupo'                   ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : 'Vehiculos'               ;;;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Especie1   : 'Especie'                 ;;;;  ;;NoVacio(Dialogo.Especie1) y Incluido(Dialogo.Especie1,'ARP|USD');'La especie debe ser ARP o USD';NO;
  Fecha1     : 'Fecha'                   ;;;;  ;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Book1      : 'Book'                    ;;;;  ;;
  Radio1     : 'Expresado|Pesos|Dolares' ;;;;  ;;;;;0;
  Radio2     : 'Tipo Op|Todas|PF|Rem'    ;;;;  ;;;;;0;
  Check1     : 'Link'                    ;;;;NO;;;;;0;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
  ACT(r:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(r:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  EndIf
EndIf

if Dialogo.Radio1=0
  ACT(r:2, 'ARP')
else
  ACT(r:2, 'USD')
endif

ACN(r:4, 0)
ACN(r:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
if Val(r:4)=0
  ACN(r:5, 1)
else
  ACN(r:5, VAR('MESINIEJE'))
endif
if Val(r:5)<1 or Val(r:5)>12
  ACN(r:5, 1)
endif
if Mes(Dialogo.Fecha1)>=Val(r:5)
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1),4,0))
else
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1)-1,4,0))
endif
ACD(r:7, Fecha(Val(r:6)))

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)
SetFilaActual(FAC+3)

ACT(i:2,'Fecha : '~Var('FECHASYS'))
SetFont(i:2..i:2,1)

ACT(a:FAC, "Calculo TIR Time Deposits Reporte de Cartera")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

if NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC, 'Grupo :')
  ACT(b:FAC, Pipe2Comillas(Dialogo.Vehiculo2))
else
  if NoVacio(Dialogo.Lista1)
    ACT(a:FAC, 'Vehiculo/s :') 
    ACT(b:FAC, Dialogo.Lista1) 
  else 
    ACT(a:FAC, 'Vehiculos :')
    ACT(b:FAC, 'Todos')
  endif
endif

ACT(a:FAC+1, 'Especies :')
ACT(b:FAC+1, Dialogo.Especie1)

ACT(a:FAC+2, 'Book :')
if NoVacio(Dialogo.Book1)
  ACT(b:FAC+2, Dialogo.Book1)
else
  ACT(b:FAC+2, 'Todos')
endif

ACT(a:FAC+3, 'Expresado en :')
ACT(b:FAC+3, IIF(Dialogo.Radio1=0,'Pesos','Dolares'))

ACT(a:FAC+4, 'Fecha :')
ACT(b:FAC+4, Dialogo.Fecha1)

ACT(a:FAC+5, 'Tipo Op :')
ACT(b:FAC+5, iif(Dialogo.Radio2=0,'P.Fijos y Remuneradas',iif(Dialogo.Radio2=1,'P.Fijos','Remuneradas')))
SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Vehiculo')
ACT(c:FAC, 'Book')
ACT(d:FAC, 'Especie')
ACT(e:FAC, '# Oper.')
ACT(f:FAC, 'Concepto')
ACT(g:FAC, 'Importe')

ACT(k:FAC, 'Fecha Num')
ACT(l:FAC, '# Oper.')
ACT(m:FAC, 'Tipo Op.')
ACT(n:FAC, 'Linea Ini')
ACT(o:FAC, 'Cant.Vtos')

SetFont(a:FAC..s:FAC,2)
AgregarMarco(a:FAC..g:FAC,1,2,Exe('COLOR'))

ACN(w1, FAC)

SQL.ADD("Select NrOperacion, TipoOp,   Especie,  FechaOp,   ")
SQL.ADD("       FechaVto,    Cantidad, Cliente1, Vehiculo1, Book1, ")
SQL.ADD("       CASE Especie When 'ARP'   Then '0' Else '1' End Tipo1, ")
SQL.ADD("       CASE TipoOp  When 'MMCPM' Then '0' Else '1' End Tipo2, ")
SQL.ADD("       '0' Tipo3 ")
SQL.ADD(" from "~DBO~".OPERACIONES ")
SQL.ADD(" where FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and FechaVto  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
if Dialogo.Radio2=0
  SQL.ADD("   and TipoOp    In ('MMCPM','MMCCR') ")
else
  if Dialogo.Radio2=1
    SQL.ADD("   and TipoOp  = 'MMCPM' ")
  else
    SQL.ADD("   and TipoOp  = 'MMCCR' ")
  endif
endif
SQL.ADD("   and Especie   = '"~Dialogo.Especie1~"' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("  and  Book1      = '"~Dialogo.Book1~"' ")
endif
SQL.ADD(" order by Tipo1, Tipo2, Tipo3, NrOperacion ")

recorrer SQL
  ACD(a:FAC, Dialogo.Fecha1)
  ACN(k:FAC, Dialogo.Fecha1)
  ACT(b:FAC, fbn('Vehiculo1'))
  ACT(c:FAC, fbn('Book1'))
  ACT(d:FAC, fbn('Especie'))
  ACT(e:FAC, fbn('NrOperacion'))
  ACT(f:FAC, 'NMV Actual')
  ACT(l:FAC, fbn('NrOperacion'))
  ACT(m:FAC, fbn('TipoOp'))

  LinkearHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
  ACN(n:FAC, LinkH(1,az:6))
  ACN(o:FAC, LinkH(1,az:7))
  ACN(p:FAC, LinkH(1,d:Val(n:FAC)))
  ACN(q:FAC, LinkH(1,o:Val(n:FAC)+Val(o:FAC)))
  ACN(w:2, Val(n:FAC)+Val(o:FAC)-1)
*  ACN(g:FAC, -(Val(q:FAC)))
  ACN(g:FAC, -LinkH(1,k:Val(n:FAC)))
  recorrer&i Val(n:FAC),Val(w:2)
    IFA
    ACD(a:FAC, LinkH(1,u:&i))
    ACN(k:FAC, Val(a:FAC))
    ACT(b:FAC, fbn('Vehiculo1'))
    ACT(c:FAC, fbn('Book1'))
    ACT(d:FAC, fbn('Especie'))
    ACT(e:FAC, fbn('NrOperacion'))
    if &i=Val(w:2)
      ACT(f:FAC, 'Vto Final')
    else
      ACT(f:FAC, 'Vto Cuota')
    endif
*    ACN(g:FAC, linkH(1,r:&i))
    ACN(g:FAC, linkH(1,n:&i)+linkH(1,o:&i))
    ACT(l:FAC, fbn('NrOperacion'))
  proximo

  if Dialogo.Radio2>0 o Dialogo.Check1=0
    CerrarHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
  endif
proximo

ACT(h:FAC+2, 'T.I.R.')
if FAC>Val(w1)
  OrdenarFilas(Val(w1)+1,FAC,1,'A')
  SetFont(a:Val(w1)+1..o:FAC, 1)
  FormatoCeldas(g:Val(w1)+1..g:FAC, Exe('F2'))
  FormatoCeldas(n:Val(w1)+1..o:FAC, Exe('F0'))
  ACN(g:FAC+2, Tir2(k:Val(w1)+1..k:FAC,g:Val(w1)+1..g:FAC)*100)
else
  ACN(g:FAC+2, 0)
endif
SetFont(g:FAC+2, 2)
FormatoCeldas(i:FAC+2..i:FAC+2, Exe('F7'))
ACN(z:1, Val(g:FAC+2))

SetFilaActual(FAC+4)
ACT(a:FAC, 'Fin del listado')
SetFont(a:FAC,2)

SetFont(r:1..z:7, 1)

ACO(1,9)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,8)
ACO(6,12)
ACO(7,9)
ACO(8,8)
ACO(9,10)

LimitesVision(g:FAC)
Impresion(1,1)
SetMargins(1,1,0.5,1)
