ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Veh¦culo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"      ;;;
  TipoOp1    : "Tipo Op."     ;;;
  Fecha1     : "Fecha Desde"  ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Fecha2     : "Fecha Hasta"  ;;;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys+365
  Entero1    : 'Anio'         ;;;;;;
  String1    : 'Condicion'    ;;;;;;
  String2    : 'Condicion2'    ;;;;;;
FinDialogo
if Not Ok
  Cancelar
endif


* En String1 llegan los otros condicionantes del Group by del llamador
* group by O.UMedida, O.MB1, O.MB4, O.MB3, O.FechaOp2, O.FechaEj, O.FechaEx1, O.FechaPrecan, O.TipoCambio3, O.MB2, O.RB9 
ACT(x1,Dialogo.String1)
ACT(x2,Dialogo.String2)

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Detalle de Operaciones Realizadas con Apertura por Producto")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+2, 'Especie : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+3, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+3, 'Tipo Op. : Todos')
endif
ACT(a:FAC+4, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+6, 'Anio : '~Fstr(Dialogo.Entero1,4,0))
SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

   ACT(a:FAC,Fstr(Dialogo.Entero1,4,0))

   Message('Listando anio '~val(a:fac))
   
   acn(v1,fac)
 
   ACT(a:fac, 'Producto')
   ACT(b:fac, 'Nro.Op.')
   ACT(c:fac, 'Dealer')
   ACT(d:fac, 'Tipo')
   ACT(e:fac, 'P.Strike')
   ACT(f:fac, 'Volumen')
   ACT(g:fac, 'Un.M.')
   ACT(h:fac, 'F.Inicio')
   ACT(i:fac, 'F.Fin')
   ACT(j:fac, 'Vol. Total')
   ACT(k:fac, 'Vol. Periodo')
   ACT(l:fac, 'Notional Tot.')
   ACT(m:fac, 'Notional Per.')


   AgregarMarco(a:fac..m:fac, 2,0,Exe('COLOR'))

   SQL.ADD("Select Vehiculo1, NrOperacion, TipoOp, Cliente1, Cantidad, TotalAux2, TotalAux1, FechaOp,FechaOp2, FechaEj, ")
   SQL.ADD("PrecioEj, TipoCambio2, TipoCambio3, MB1, MB3, UMedida from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' and ")
   SQL.ADD(" ((O.TipoOp In ('DPOS','DPOGS') and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and DATEPART(YEAR,O.FechaEj)>="~Fstr(Dialogo.Entero1,0,0)~" and DATEPART(YEAR,O.FechaOp)<="~Fstr(Dialogo.Entero1,0,0)~") ")
   SQL.ADD("   or (O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"' and DATEPART(YEAR,O.FechaEj)>="~Fstr(Dialogo.Entero1,0,0)~" and DATEPART(YEAR,O.FechaOp2)<="~Fstr(Dialogo.Entero1,0,0)~" )) ")
   SQL.ADD(" and  O.TipoOp Like 'DP%' ")
   SQL.ADD(" and  O.TipoOp Not In ('DPRS','DPRRS','DPSN','DPDSS','DPDSO','DPS') ")
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   endif
   SQL.ADD(" and "~val(x1)~" ")
   SQL.ADD(" "~val(x2)~" ")
   SQL.ADD("Union All ")
   SQL.ADD("Select Vehiculo1, NrOperacion, TipoOp, Cliente1, Cantidad, TotalAux2, TotalAux1, FechaOp,FechaOp2, FechaEj, ")
   SQL.ADD("PrecioEj, TipoCambio2, TipoCambio3, MB1, MB3, UMedida from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"'  ")
   SQL.ADD(" and  O.TipoOp In ('DPRS','DPRRS') ")
   SQL.ADD(" and  (DATEPART(YEAR,O.FechaEj)>="~Fstr(Dialogo.Entero1,0,0)~" and DATEPART(YEAR,O.FechaOp2)<="~Fstr(Dialogo.Entero1,0,0)~") ")

   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   endif
   SQL.ADD(" and "~val(x1)~" ")
   SQL.ADD(" "~val(x2)~" ")
   SQL.ADD("Union All ")
   SQL.ADD("Select Vehiculo1, NrOperacion, TipoOp, Cliente1, Cantidad, TotalAux2, TotalAux1, FechaOp,FechaOp2, FechaEj, ")
   SQL.ADD("PrecioEj, TipoCambio2, TipoCambio3, MB1, MB3, UMedida from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"' ")
   SQL.ADD(" and  ((O.TipoOp In ('DPSN','DPDSS') and  (CB8='0' or CB8 IS NULL)) ")
   SQL.ADD(" or  O.TipoOp In ('DPDSO','DPS')) ")
   SQL.ADD(" and  (DATEPART(YEAR,O.FechaEj)>="~Fstr(Dialogo.Entero1,0,0)~" and DATEPART(YEAR,O.FechaOp2)<="~Fstr(Dialogo.Entero1,0,0)~") ")
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   endif
   SQL.ADD(" and "~val(x1)~" ")
   SQL.ADD(" "~val(x2)~" ")
*   SQL.ADD("order by Vehiculo1, TipoOp, NrOperacion")
   SQL.ADD(" Order by 1, 3, 2 ")
Recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))

    * cambia Tipo Op.
    if NoVacio(Val(z7))
      act(a:fac,'Total Tipo Op.' )
      acn(j:fac, Val(w5))
      acn(k:fac, Val(w6))
      acn(l:fac, Val(w7))
      acn(m:fac, Val(w8))
      BorrarCeldas(w5..w8)
      AgregarMarco(a:fac..m:fac,1)
      SetFont(a:fac..m:fac,2)
      ifa
    endif
    * cambia empresa
    if NoVacio(Val(z1))
      act(a:fac,'Total Empresa '~Val(z1) )
      acn(j:fac, Val(w1))
      acn(k:fac, Val(w2))
      acn(l:fac, Val(w3))
      acn(m:fac, Val(w4))
      BorrarCeldas(w1..w4)
      AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..m:fac,2)
      ifa
    endif
    * Asignar Empresa
    act(z1, fbn('Vehiculo1'))
    act(a:fac,'Empresa '~Val(z1) )
    AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..m:fac,2)
    ifa
    * Asignar Tipo Op.
    act(z7, fbn('TipoOp'))
    act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
    AgregarMarco(a:fac..m:fac,1)
    SetFont(a:fac..m:fac,2)
    ifa
  else
    if Not EQstr(fbn('TipoOp'),Val(z7))
      * cambia Tipo Op.
      if NoVacio(Val(z7))
        act(a:fac,'Total Tipo Op.' )
        acn(j:fac, Val(w5))
        acn(k:fac, Val(w6))
        acn(l:fac, Val(w7))
        acn(m:fac, Val(w8))
        BorrarCeldas(w5..w8)
        AgregarMarco(a:fac..m:fac,1)
        SetFont(a:fac..m:fac,2)
        ifa
      endif
      * Asignar Tipo Op.
      act(z7, fbn('TipoOp'))
      act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
      AgregarMarco(a:fac..m:fac,1)
      SetFont(a:fac..m:fac,2)
      ifa
    endif
  endif
  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))
  act(c:fac, fbn('Cliente1'))
  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
    act(e:fac, fbn('TipoCambio2'))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
      act(e:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
    else
      act(e:fac, fbn('PrecioEj'))
    endif
  endif

  If Not Incluido(FBN['TipoOp'],'DPOS|DPOGS')
     if fbn('FechaOp2') > Dialogo.Fecha1
        ACD(z2, fbn('FechaOp2'))
     else
        ACD(z2, Dialogo.Fecha1)
     endif
  Else 
     if fbn('FechaOp') > Dialogo.Fecha1
        ACD(z2, fbn('FechaOp'))
     else
        ACD(z2, Dialogo.Fecha1)
     endif
  EndIf

  if fbn('FechaEj') <= Dialogo.Fecha2
    ACD(z3, fbn('FechaEj'))
  else
    ACD(z3, Dialogo.Fecha2)
  endif

  * dif dias
  ACN(z4, (Val(z3)-Val(z2))+1)
  * dif meses
  ACN(z6, DifMeses(Val(z3),Val(z2))+1)

  acn(z5,1)

  * determinar el signo
  if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(d:fac,'Producer')
      acn(z5,1)
    else
      act(d:fac,'Consumer')
      acn(z5,-1)
    endif
  endif
  if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPBOS|DPBOD|DPBOA|DPOA|DPOAV')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra PUT')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta CALL')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta PUT')
      acn(z5,-1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra CALL')
      acn(z5,-1)
    endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Producer')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta Consumer')
      acn(z5,1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Consumer')
      acn(z5,-1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Venta Producer')
      acn(z5,-1)
    endif
  endif

  acn(f:fac, fbn('Cantidad'))
  act(g:fac, fbn('UMedida'))

  If Not Incluido(FBN['TipoOp'],'DPOS|DPOGS')
     acd(h:fac, fbn('FechaOp2'))
  Else 
     acd(h:fac, fbn('FechaOp'))
  EndIf
  acd(i:fac, fbn('FechaEj'))
  acn(j:fac, fbn('TotalAux2')*Val(z5))

  if EqStr(fbn('UMedida'),'BBLSD')
    * Barriles por dia
    acn(k:fac, fbn('Cantidad')*Val(z4)*Val(z5))
  else
    if Incluido(fbn('UMedida'),'BBLSM|TN/MES')
      * por meses
      acn(k:fac, fbn('Cantidad')*Val(z6)*Val(z5))
    endif
  endif
  acn(l:fac, fbn('TotalAux1')*Val(z5))
  acn(m:fac, (fbn('TotalAux1')*ABS(Val(k:fac))/fbn('TotalAux2'))*Val(z5))

  scn(w1,Val(j:fac))
  scn(w2,Val(k:fac))
  scn(w3,Val(l:fac))
  scn(w4,Val(m:fac))

  scn(w5,Val(j:fac))
  scn(w6,Val(k:fac))
  scn(w7,Val(l:fac))
  scn(w8,Val(m:fac))

  scn(w9,Val(j:fac))
  scn(w10,Val(k:fac))
  scn(w11,Val(l:fac))
  scn(w12,Val(m:fac))

  SetFont(a:fac..m:fac,1)
proximo

* ultimo total tipo Op.
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total Tipo Op.' )
  acn(j:fac, Val(w5))
  acn(k:fac, Val(w6))
  acn(l:fac, Val(w7))
  acn(m:fac, Val(w8))
  BorrarCeldas(w5..w8)
  AgregarMarco(a:fac..m:fac,1)
  SetFont(a:fac..m:fac,2)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(j:fac, Val(w1))
  acn(k:fac, Val(w2))
  acn(l:fac, Val(w3))
  acn(m:fac, Val(w4))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..m:fac,2)
endif

* total gral
ifa
acn(j:fac, Val(w9))
acn(k:fac, Val(w10))
acn(l:fac, Val(w11))
acn(m:fac, Val(w12))
BorrarCeldas(w1..w12)
AgregarMarco(a:fac..m:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..m:fac,2)

ACO(1,19)
ACO(3,10)
ACO(4,9)
ACO(5,5)
ACO(6,6)
ACO(7,4)
ACO(8,6)
ACO(9,6)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z:val(v1), 2)

FormatoCeldas(e:val(v1)+1..e:fac, Exe('F7'))
FormatoCeldas(f:val(v1)+1..f:fac, Exe('F2N'))
FormatoCeldas(j:val(v1)+1..m:fac, Exe('F2N'))
AlinearCeldas(e:val(v1)..f:fac+1,'D')
AlinearCeldas(j:val(v1)..m:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)
