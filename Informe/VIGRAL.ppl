HojaVisible(NO)
CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Radio1   : 'Agrupa por|Empresa|Contraparte|Tipo Op.';;;;;;;;;0
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not OK
  Cancelar
endif

if Dialogo.Radio1=0
  LinkearHoja('VIGEAM',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1)
endif
if Dialogo.Radio1=1
  LinkearHoja('VIGECO',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1)
endif
if Dialogo.Radio1=2
  LinkearHoja('VIGETI',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Lista1=Dialogo.Lista1)
endif
