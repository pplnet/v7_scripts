CrearDialogo
  Fecha1 : 'Fecha'     ;1;1;;;;;;;Fsys
  Cliente1:'Cliente'     ;2;2;;;;;;;
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Liquidacion de Clientes')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)
ACT(a3, 'Especie:'~Dialogo.Especie1)



ACT(a6, 'Cliente')
ACT(b6, '#Comitente')
ACT(c6, '#Bantotal')
ACT(d6, 'TipoOp')
ACT(e6, '#Operacion')
ACT(f6, '#Boleto')
ACT(g6, 'F.Conc.')
ACT(h6, 'F.Liq.')
ACT(i6, 'F.Acred.')
ACT(j6, 'Capital')
ACT(k6, 'Derechos')
ACT(l6, 'Aranceles')
ACT(m6, 'Gastos')
ACT(n6, 'IVA')
ACT(o6, 'RG1603')
ACT(p6, 'Monto')
ACT(q6, 'Liquida')
ACT(r6, 'Total Cliente')


SQL.ADD("SELECT O.*, C.Codigo, C.CodComitente, C.AliasBT FROM   "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and ")
SQL.ADD("(FechaOp2 = '"~IdxDate(Dialogo.Fecha1)~"' or")
SQL.ADD("FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"')")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
SQL.ADD(" and Cliente1 = C.Codigo and Cliente1<>'"~VAR('VEHICULODE')~"'")

if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" order by Cliente1")

SetFilaActual(6)

Let &TotalCliente 0

recorrer SQL
  if Not EqStr(fbn('Cliente1'), &Cliente)
    ACT(a:fac, fbn('Cliente1'))
    ACT(b:fac, fbn('CodComitente'))
    ACT(c:fac, fbn('AliasBT'))
    if NoVacio(&Cliente)
    ACN(r:fac-1, &TotalCliente)
    endif
    Let &TotalCliente 0
    Let &Cliente fbn('Cliente1')
  endif
  
  ACT(d:fac, fbn('TipoOp'))
  ACT(e:fac, fbn('NrOperacion'))
  ACLO(e:fac, fbn('NrOperacion'))
  ACT(f:fac, fbn('NrBoleto'))
  ACD(g:fac, fbn('FechaOp'))
  ACD(h:fac, fbn('FechaOp2'))
  ACD(i:fac, fbn('FechaVto2'))
  if fbn('FechaOp2')=Dialogo.Fecha1 
  ACN(j:fac, fbn('Cantidad'))
  ACN(k:fac, fbn('TotalDerechos'))
  ACN(l:fac, fbn('ImpGastos1'))
  ACN(m:fac, fbn('TotalGastos'))
  ACN(n:fac, fbn('TotalIVA')+fbn('ImpGastos2')+fbn('TotalAux1'))
  ACN(o:fac, fbn('TotalRetenciones'))
  If Incluido(fbn('TipoOp'),'DDC')
    ACN(q:fac, -Val(j:fac)-Val(k:fac)-Val(l:fac)-Val(m:fac)-Val(n:fac)-Val(o:fac))
  else
    ACN(q:fac, Val(j:fac)-Val(k:fac)-Val(l:fac)-Val(m:fac)-Val(n:fac)-Val(o:fac))
  endif
   
*    SCN(d+&Delta:&Fila, fbn('TotalDerechos'))
*    SCN(e+&Delta:&Fila, fbn('TotalIVA'))
  endif
  if fbn('FechaVto2')=Dialogo.Fecha1
    If Incluido(fbn('TipoOp'),'DDC')
      ACN(p:fac, fbn('TotalBrutoCli1'))
       ACN(q:fac, fbn('TotalBrutoCli1'))
    endif
  endif  
  Let &TotalCliente &TotalCliente+Val(q:fac)
proximo

    if NoVacio(&Cliente)
    ACN(r:fac, &TotalCliente)
    endif


CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,14,B")
CrearFont(4, "Arial,6,")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")
CrearFont(7, "Arial,10,")

setfont(a1..z:fac, 1)
*SetFont(a6..z6, 2)
SetFont(a1..z6, 2)

* ColorCeldas(a23..c23,Var('COLOR2'))
  FormatoCeldas(j7..r:fac+1, EXE('F2'))
  *  FormatoCeldas(g7..g:fac+1, EXE('F9'))
  * FormatoCeldas(j7..j:fac+1, EXE('F9'))
  AgregarMarco(a6..r6,1,0,Exe('COLOR2'))
*  AgregarMarco(h6..m6,1,0,Exe('COLOR3'))
*  AgregarMarco(b5..g5,1,0,Exe('COLOR2'))
*  AgregarMarco(h5..m5,1,0,Exe('COLOR3'))
*  AgregarMarco(n6..n6,1,0,Exe('COLOR6'))
*  AgregarMarco(a6..a6,1,0,Exe('COLOR6'))
**  AgregarMarco(d13..g16,2,0)
*  AgregarMarco(a19..g21,1,0)
*  AgregarMarco(a23..g33,1,0)
*  AgregarMarco(a23..g26,1,0)
*  AgregarMarco(a23..g23,1,0,Exe('COLOR2'))
  AlinearCeldas(j6..r6,'D')


  LimitesVision(s:fac+2)  


Autofit(si)

