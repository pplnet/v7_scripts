*** SQL ***

SQL.ADD("select 'Prestamos desembolsados sin liquidar' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp,")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ")
SQL.ADD("O.Especie, ")
SQL.ADD("M.FechaMov as Fecha, ")
SQL.ADD("T.NrTrans, ")
SQL.ADD(" M.Cantidad ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ")

SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")

SQL.ADD("and O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=1 ")
SQL.ADD("and O.NrOperacion = T.NrOperacionRef1 and T.TipoTr2='CUPDES' ")
SQL.ADD("and T.NrTrans=(select Max(NrTrans) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1=O.NrOperacion and TipoTr2='CUPDES') ")
SQL.ADD("union all ")
SQL.ADD("select 'Prestamos sin desembolsar' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp, ")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ")
SQL.ADD("O.Especie, ")
SQL.ADD("null as Fecha, ")
SQL.ADD("null as NrTrans, ")
SQL.ADD(" O.Cantidad ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ")
SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVPENDIENTES M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=1) ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVEJECUTADOS M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=1) ")
SQL.ADD("union all ")
SQL.ADD("select 'Prestamos con Desembolso anulado' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp, ")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ")
SQL.ADD("O.Especie, ")
SQL.ADD("T.Fecha1 as Fecha, ")
SQL.ADD("T.NrTrans as NrTrans, ")
SQL.ADD(" O.Cantidad ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ")
SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")
SQL.ADD("and O.NrOperacion = T.NrOperacionRef1 and T.TipoTr2='CUPADE' ")
SQL.ADD("and T.NrTrans=(select Max(NrTrans) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1=O.NrOperacion and TipoTr2='CUPADE') ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVPENDIENTES M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=1) ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVEJECUTADOS M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=1) ")

SQL.ADD("union all ")

SQL.ADD("select 'Comision cancelada sin liquidar' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp, ")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ")
SQL.ADD("O.Especie, ")
SQL.ADD("M.FechaMov as Fecha, ")
SQL.ADD("T.NrTrans, ")
SQL.ADD(" -M.Cantidad ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ")
SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")
SQL.ADD("and O.RB9='1' ")
SQL.ADD("and O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and NrGrupo=80 ")
SQL.ADD("and O.NrOperacion = T.NrOperacionRef1 and T.TipoTr2='CUPPAG' ")
SQL.ADD("and T.NrTrans=(select Max(NrTrans) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1=O.NrOperacion and TipoTr2='CUPPAG') ")
SQL.ADD("union all ")
SQL.ADD("select 'Comision sin cancelar' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp, ")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ")
SQL.ADD("O.Especie, ")
SQL.ADD("null as Fecha, ") 
SQL.ADD("null as NrTrans, ")
SQL.ADD(" O.TotalComisiones ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ")
SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")
SQL.ADD("and O.RB9='1' ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVPENDIENTES M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=80) ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVEJECUTADOS M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=80) ")
SQL.ADD("union all ")
SQL.ADD("select 'Anulacion de Pago de Comision' as Tipo, ")
SQL.ADD("O.Vehiculo1, ")
SQL.ADD("O.TipoOp, ")
SQL.ADD("O.NrOperacion, ")
SQL.ADD("O.Cliente1, ") 
SQL.ADD("O.Especie, ") 
SQL.ADD("T.Fecha1 as Fecha, ")
SQL.ADD("T.NrTrans as NrTrans, ")
SQL.ADD(" O.TotalComisiones ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where O.TipoOp in ('PMU','PME') ")
SQL.ADD("and O.NrOperacion =  OB.NrOperacion ") 
SQL.ADD("and OB.NrBit in ('70','10') and OB.Valor='1' ")
SQL.ADD("and O.RB9='1' ")
SQL.ADD("and O.NrOperacion = T.NrOperacionRef1 and T.TipoTr2='ANUPAG' ")
SQL.ADD("and T.NrTrans=(select Max(NrTrans) from "~DBO~".TRANSACCIONES2 where NrOperacionRef1=O.NrOperacion and TipoTr2='ANUPAG') ")
SQL.ADD("and not exists (select 1 from "~DBO~".MOVPENDIENTES M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=80) ") 
SQL.ADD("and not exists (select 1 from "~DBO~".MOVEJECUTADOS M where O.NrOperacion = M.NrOperacion and M.NrSaldo=1 and M.NrGrupo=80) ")

SQL.ADD("order by 1,2,6 ")

