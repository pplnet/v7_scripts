* 26/8
* OPEELI - AADEFI - Operaciones Eliminadas
ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1     :'F.Desde'  ;;;;;;Dialogo.Fecha1<>0 y NoVacio(Dialogo.Fecha1) y Dialogo.Fecha1<=Dialogo.Fecha2 y Dialogo.Fecha1<=Fsys;'Debe Ingresar una Fecha Valida';NO;FSys
  Fecha2     :'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0 y NoVacio(Dialogo.Fecha2) y Dialogo.Fecha1<=Dialogo.Fecha2 y Dialogo.Fecha2<=Fsys;'Debe Ingresar una Fecha Valida';NO;FSys
FinDialogo

If Not OK
  Cancelar
EndIf

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')

SetFilaActual(4)
ACT(A:FAC,'Operaciones Eliminadas del Periodo')
ACT(A:FAC+1,'Periodo : desde '~Fecha(Dialogo.Fecha1)~' hasta '~Fecha(Dialogo.Fecha2))
ACT(a:FAC+2, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
SetFont(A:FAC..B:FAC+2,2)

ACT(A:FAC+2,'Nro. Operacion')
ACT(B:FAC+2,'Fecha Elim.')
ACT(C:FAC+2,'Operador')
ACT(D:FAC+2,'Eliminacion')
ACT(E:FAC+2,'Tipo Op')
ACT(F:FAC+2,'Especie')
ACT(G:FAC+2,'Fecha Op')
ACT(H:FAC+2,'Cliente')
ACT(I:FAC+2,'Cantidad')
ACT(J:FAC+2,'Precio')
ACT(K:FAC+2,'Monto')
SetFont(A:FAC..K:FAC+2,2)
AlinearCeldas(I:FAC+2..K:FAC+2,'D')
AgregarMarco(A:FAC+2..K:FAC+2,2,0,Exe('COLOR'))
SetFilaActual(FAC+2)
ACN(X1,FAC+1)
Message('Operaciones del Per¦odo Eliminadas')

SQL.ADD("Select P.ValorAnterior, P.Codigo, P.Fecha, P.Operador from "~DBO~".PMAUDIT P,BOPERACIONES B where ")
SQL.ADD(" P.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' and P.Fecha < '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD(" and P.Accion = 'B' and P.Tabla = 'OPERACIONES' and P.Campo = 'FechaOp' ")
SQL.ADD(" and P.Codigo=B.NrOperacion ")
SQL.ADD(" and B.Vehiculo1='"~Dialogo.Vehiculo1~"' order by Codigo")

Recorrer SQL

*  dfa
*  if Fecha(FieldByName['ValorAnterior']) > Dialogo.Fecha1-1 y Fecha(FieldByName['ValorAnterior']) < Dialogo.Fecha2+1
*    ifa

    ACT(A:FAC, FBN['Codigo'])
    ACT(B:FAC, Fecha(FieldByName['Fecha']))
    ACT(C:FAC, FieldByName['Operador'])
    SQL.ADD("Select Campo,ValorAnterior from "~DBO~".PMAUDIT where Codigo = '"~Val(a:fac)~"' ")
    SQL.ADD(" and Campo in ('LInstancia','TipoOp','Especie','FechaOp','Cliente1','Cantidad','Precio1') ")
    Recorrer SQL
      DFA
      If EqStr(FieldByName['Campo'],'LInstancia')
         ACN(X:FAC, FieldByName['ValorAnterior'])
         If Val(X:Fac)=31
             ACT(D:FAC, 'Automatica')
           Else
             ACT(D:FAC, 'Manual')
         EndIf
      EndIf
      If EqStr(FieldByName['Campo'],'TipoOp')
         ACT(E:FAC, FieldByName['ValorAnterior'])
      EndIf
      If EqStr(FieldByName['Campo'],'Especie')
        ACT(F:FAC, FieldByName['ValorAnterior'])
      EndIf
      If EqStr(FieldByName['Campo'],'FechaOp')
        ACT(G:FAC,Copy(FieldByName['ValorAnterior'],1,11))
      EndIf
      If EqStr(FieldByName['Campo'],'Cliente1')
        ACT(H:FAC, FieldByName['ValorAnterior'])
      EndIf
      If EqStr(FieldByName['Campo'],'Cantidad')
        ACN(I:FAC, FieldByName['ValorAnterior'])
      EndIf
      If EqStr(FieldByName['Campo'],'Precio1')
        ACN(J:FAC, FieldByName['ValorAnterior'])
      EndIf
      ACN(K:FAC, Val(I:FAC)*Val(J:FAC) )   
    Proximo

*  endif
Proximo
SetFont(A:Val(x1)..K:FAC,1)
FormatoCeldas(J:Val(x1)..J:FAC,Exe('F6'))
FormatoCeldas(K:Val(x1)..K:FAC,Exe('F2'))
AgregarMarco(A:Val(x1)..K:FAC,1)
ACT(A:FAC+1,'Fin del Listado')
SetFont(A:FAC+1..B:FAC+2,2)
Impresion(1,2)

ACO(1,9)
ACO(2,8)
ACO(3,8)
ACO(4,9)
ACO(5,6)
ACO(6,6)
ACO(7,8)
ACO(8,7)
ACO(9,10)
ACO(10,7)
ACO(11,10)
LimitesVision(L:FAC+1)