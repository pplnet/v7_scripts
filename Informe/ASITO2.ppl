ACT(k:fac+1, 'Emision')
IF NO
ACT(l:fac,   'Debito')
ACT(m:fac,   'Credito')
ACT(n:fac,   'Moneda')
ACT(n:fac+1, 'Local')
ENDIF
ACT(o:fac,   'Modelo')
ACT(p:fac,   'Asiento')
ACT(q:fac,   'Item')
ACT(r:fac,   'Operacion')
ACT(s:fac,   'F.Envio')
ACT(t:fac,   'Cot.FValor')
ACT(u:fac,   'Cot.FValor-1')

SetFont(a:fac..z:fac+1, 2)
AgregarMarco(a:fac..u:fac+1,1,0,EXE('COLOR6'))
AlinearCeldas(a:fac..z:fac+1, 'C')
SetFilaActual(fac+1)
ACN(z:1,fac)

message('Recuperando Asientos...')
SQL.ADD(" SELECT A1.*, A.FechaGeneracion, A.FechaValor, A.Modelo, E.Cotiza, A.NrOperacion, A.NrAsiento,")
SQL.ADD(" M.TipoAsiento,M.TipoOp,CE.PrecioContable PreEspecie, CM.PrecioContable PreMoneda, A.Fecha1, A.Estado, A.Fecha2 ")
*-i
*SQL.ADD(" FROM  "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A,"~DBO~".ESPECIES E, "~DBO~".MODELOSASIENTO M, ")
*SQL.ADD("       "~DBO~".COTIZACIONES CE,"~DBO~".COTIZACIONES CM ")
*SQL.ADD(" WHERE A1.NrUnicoAsiento = A.NrUnicoAsiento ")
*SQL.ADD("   and A1.Alias5   *= E.Codigo ")
*-f

*-i
SQL.ADD("  FROM   "~DBO~".MODELOSASIENTO M, "~DBO~".ASIENTOSCON1 A1")
 SQL.ADD("LEFT OUTER JOIN ESPECIES E ON A1.Alias5   = E.Codigo")
 SQL.ADD("LEFT OUTER JOIN  "~DBO~".COTIZACIONES CM  ON A1.Especie1  = CM.Codigo") 
 SQL.ADD("LEFT OUTER JOIN  "~DBO~".ASIENTOSCON A ON A.FechaGeneracion =CM.Fecha")
 SQL.ADD("LEFT OUTER JOIN  "~DBO~".COTIZACIONES CE ON  A1.Alias5    = CE.Codigo  and A.FechaValor = CE.Fecha ")
 SQL.ADD(" WHERE A1.NrUnicoAsiento = A.NrUnicoAsiento ")
*-f
SQL.ADD("   and A.Modelo     = M.Codigo ")
IF Dialogo.Radio1=0
       SQL.ADD("   and (A.Estado = 'OK' OR A.Estado = '' OR A.Estado IS NULL) ")
Endif
IF Dialogo.Radio1=1
   SQL.ADD("   and A.Estado in ('SC','NB') ")
Endif

IF Dialogo.Radio2 = 2
    SQL.ADD("   and A.FechaGeneracion>= "~IdxDate2(Dialogo.Fecha1))
    SQL.ADD("   and A.FechaGeneracion<= "~IdxDate2(Dialogo.Fecha2))
    SQL.ADD("   and A.FechaValor>= "~IdxDate2(Dialogo.Fecha3))
    SQL.ADD("   and A.FechaValor<= "~IdxDate2(Dialogo.Fecha4))
    If Dialogo.Check1=1
      SQL.ADD("   and A.Fecha1>= "~IdxDate2(Dialogo.Fecha5))
      SQL.ADD("   and A.Fecha1<= "~IdxDate2(Dialogo.Fecha6))
    Endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD(" and  M.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
ENDIF
IF Dialogo.Radio2 = 0
    IF Dialogo.Check2 = 0
        SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    ELSE
        SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrBOperacion~"' ")
    ENDIF
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and  M.TipoAsiento IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
*i
*SQL.ADD("   and A1.Especie1       *= CM.Codigo")
*SQL.ADD("   and A.FechaGeneracion *=CM.Fecha  ")
*f
SQL.ADD("   and CM.CallPut         = 'CON'    ")
SQL.ADD("   and CM.PrecioContable <> 0        ")
*i
*SQL.ADD("   and A1.Alias5    *= CE.Codigo  ")
*SQL.ADD("   and A.FechaValor *= CE.Fecha   ")
*f
SQL.ADD("   and CE.CallPut    = 'CON'      ")
SQL.ADD("   and CM.PrecioContable <> 0     ")
*SQL.ADD("   ORDER By M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.Alias3 ")
SQL.ADD("   ORDER By M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.DebitoCredito desc ")
ACN(fi:1,fac+1)

Recorrer SQL

  *--Totales por asiento-----------------------------------------------
  If Not Eqstr(fbn('NrUnicoAsiento'),Val(aa:1)) 

    If NoVacio(Val(aa:1))
       (.'ASITO21'.) 
    Endif

    *-- Corte por Tipo de Asiento -----
    IF Not EqStr(fbn('TipoAsiento'), Val(ma1))
       message(' Tipo Asiento= '~fbn('TipoAsiento')) 
       SetFilaActual(fac+2)  
       ACT(a:fac, 'Tipo: '~fbn('TipoAsiento')~'-'~BuscarCampo('TIPOSASIENTO','Descripcion','Codigo',fbn['TipoAsiento']))
       SetFont(a:fac, 4)
       AgregarMarco(a:fac..u:fac,1,0,EXE('COLOR6'))
       ACT(ma:1,fbn['TipoAsiento'])
       SetFilaActual(fac+2)  
       ACN(fi:1, fac)
    Endif

    *-Estado asiento 'ERROR' u 'OK' ---- 
    ACT(aa:2, 'OK')
    *-Bimonetario 'SI' o especie ---- 
    ACT(aa:3, fbn('Especie1'))
    message('   '~fbn('NrUnicoAsiento'))
  Endif

  *-- Por cada Item asiento -------------------------------------------------
  
  *--Falta Cuenta---
  ACT(aa:2, iif(Vacio(fbn('Cuenta')),'ERROR','OK') )
  *--Bimonetario? 
  ACT(aa:3, IIf(Not Eqstr(Val(aa:3),fbn('Especie1')) y Not Eqstr(Val(aa:3),'BI'), 'BI',Val(aa:3)) )
  ACT(a:fac, FECHA(fbn('FechaGeneracion'))~' - '~FECHA(fbn('Fecha1')))
  ACD(b:fac, fbn('FechaValor'))

* obtengo el nombre de la formula que se usa para cuenta.
  ACT(fr:1, SQL("SELECT CuentaContable FROM "~DBO~".MODELOSASIENTO1 WHERE Modelo = '"~fbn('Modelo')~"' AND NrItem = "~fstr(fbn('Alias3'),0,0)~" ") )
  ACT(fr:1, COPY(Val(fr:1),2,Longitud(Val(fr:1)) ) )
   
**  ACT(c:fac, fbn('Cuenta')~' ('~fbn('Alias4')~')')
  If Incluido(Val(fr:1), 'COMGANADAS|CONTRAPART|CONTRAPFC2|CONTRFALLA|CTACONTCOM|CTACONTRAP')     
      ACT(c:fac,Val(c:fac)~' - '~SQL("SELECT C.RazonSocial from "~DBO~".CLIENTES C, "~DBO~".OPERACIONES O WHERE C.Codigo=O.Cliente1 AND O.NrOperacion='"~fbn('NrOperacion') ~"' ") )
  Endif

  ACT(d:fac, fbn('Especie1'))
  If Eqstr(fbn('DebitoCredito'),'DEB')
    ACT(c:fac, fbn('Cuenta')~' - '~fbn('Alias1'))
    ACN(e:fac, fbn('Cantidad1'))
  Else
    ACT(c:fac, '     '~fbn('Cuenta')~' - '~fbn('Alias1'))
    ACN(f:fac, fbn('Cantidad1'))
  Endif
  ACT(g:fac, fbn('Alias5'))
  ACT(h:fac, fbn('Alias1'))
  ACT(i:fac, fbn('CentroCosto'))
  ACN(j:fac, CotizacionBNA(fbn('Cotiza'),Dialogo.Fecha1,2,SI,SI) )
  ACT(k:fac, fbn('Cotiza'))
  IF fbn('FechaValor') < Habiles(fbn('FechaGeneracion'),-Var('CONTVALOR2'),'ARG')
      ACN(QQ:fac, 1)
      ColorCeldas(A:fac..B:fac, clRED)
  ELSE
      ACN(QQ:fac, 0)
  ENDIF

IF NO
  If Eqstr(Val(d:fac),VAR('MONELOCA')) 
    If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(l:fac, fbn('Cantidad1'))
    Else
      ACN(m:fac, fbn('Cantidad1'))
    Endif
  Else
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(l:fac, fbn('Cantidad1')*iif( Eqstr(Modo(VAR('MONELOCA'),Val(d:fac)),'DIR'),  1/Val(j:fac) ,Val(j:fac)))
    Else
      ACN(m:fac, fbn('Cantidad1')*iif( Eqstr(Modo(VAR('MONELOCA'),Val(d:fac)),'DIR'),  1/Val(j:fac) ,Val(j:fac)))
    Endif
  Endif
  ACT(n:fac, VAR('MONELOCA'))
ENDIF

  ACT(o:fac, fbn('Modelo'))
  ACL(o:fac, 'INV005',String=fbn('Modelo'))
  ACT(p:fac, fbn('NrUnicoAsiento'))
  If Eqstr(fbn('Detalle'),'Contrasiento')
     ACL(p:fac, 'INV007', NrUnicoAsiento1=fbn('NrAsiento'),Check1=1)
     ACT(o:fac, Val(o:fac)~' (C)')
  Endif
  If Eqstr(fbn('Detalle'),'BajaFalla')
     ACL(p:fac, 'INV007', NrUnicoAsiento1=fbn('NrAsiento'),Check1=1)
     ACT(o:fac, Val(o:fac)~' (BF)')
  Endif
  
  ACT(q:fac, fbn('Alias3'))
  ACT(r:fac, fbn('NrOperacion'))
  ACLO(r:fac, fbn('NrOperacion'))
  ACD(s:fac, fbn('Fecha2'))
  If Eqstr(Val(g:fac),Val(g:fac-1))
     ACN(t:fac, Val(t:fac-1))
     ACN(u:fac, Val(u:fac-1))
  Else
     ACN(t:fac, fbn('PreEspecie'))
     ACN(u:fac, Cotizacion(fbn('Alias5'),,,,fbn['FechaValor']-1,25,NO) )
  Endif
  If Eqstr(fbn('TipoAsiento'),'DIFC')
     ACT(ce:1, BuscarCampo('OPERACIONES','ContraEspecie','NrOperacion',Val(r:fac)) )
     ACN(t:fac, CotizacionBNA(Val(ce:1),Val(b:fac),2,SI,SI))
     ACN(u:fac, CotizacionBNA(Val(ce:1),Val(b:fac)-1,2,SI,SI))
  Endif

  ACT(aa:1, fbn('NrUnicoAsiento') )
  SetFont(a:fac..z:fac, 1)
  FormatoCeldas(e:fac..f:fac, EXE('F2'))
*  FormatoCeldas(l:fac..m:fac, EXE('F2'))
  FormatoCeldas(j:fac, EXE('F9'))
  FormatoCeldas(t:fac..u:fac, EXE('F9'))
Proximo
