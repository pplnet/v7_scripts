ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1      : 'D.Fec.Gener' ;1;;;;Dialogo.Radio2 = 2;;;;FSYS
  Fecha2      : 'H.Fec.Gener' ;2;;;;Dialogo.Radio2 = 2;;;;FSYS
  Fecha3      : 'D.Fec.Valor' ;4;;;;Dialogo.Radio2 = 2;;;;HABILES(FSYS,-Var('CONTVALOR'),'ARG')
  Fecha4      : 'H.Fec.Valor' ;5;;;;Dialogo.Radio2 = 2;;;;FSYS
  Check1      : 'Filtra F.Ejec';1;2;;;Dialogo.Radio2 = 2;;;;0
  Fecha5      : 'D.Fec.Ejec'  ;2;2;;;Dialogo.Check1=1 Y Dialogo.Radio2 = 2;;;;FSYS
  Fecha6      : 'H.Fec.Ejec'  ;3;2;;;Dialogo.Check1=1 Y Dialogo.Radio2 = 2;;;;FSYS
  Radio2      : 'Filtra|Oper|Asi|Ninguno';;;;;;;;;2;
  NrOperacion1: 'NrOperacion'  ;5;2;;Dialogo.Radio2 = 0 Y Dialogo.Check2 = 0;Dialogo.Radio2 = 0 Y Dialogo.Check2 = 0;Dialogo.Radio2 <> 0 O NoVacio(Dialogo.NrOperacion1) O Dialogo.Check2 = 1;'Numero de Operacion Invalido';NO;
  NrBOperacion: 'NrOperacion'  ;5;2;;Dialogo.Radio2 = 0 Y Dialogo.Check2 = 1;Dialogo.Radio2 = 0 Y Dialogo.Check2 = 1;Dialogo.Radio2 <> 0 O NoVacio(Dialogo.NrBOperacion) O Dialogo.Check2 = 0;'Numero de Operacion Anulada Invalido';NO;
  NrUnicoAsiento1: 'NrAsiento' ;5;2;;Dialogo.Radio2 = 1;Dialogo.Radio2 = 1;Dialogo.Radio2 <> 1 O NoVacio(Dialogo.NrUnicoAsiento1);'Numero de Asiento Invalido';NO;
  Check2      : 'Anulada'      ;6;2;;;Dialogo.Radio2 = 0;;;;0
  Radio1      : 'Asientos|OK|Erroneos|Todos|' ;7;1;;;;;;;2
  Lista1      : 'Tipos_Asientos' ;9;1;;;Dialogo.Radio2 <> 1;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSASIENTO Order By Codigo ");
  Lista2      : 'Tipos_Operacion';3;2;;;Dialogo.Radio2 = 2;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Order By Codigo ");
FinDialogo

If Not Ok 
  Cancelar
Endif
AgregarBMP(a1,Exe('LOGO'),80)
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

IF Dialogo.Radio2 = 2
    ACT(a:3, 'Asientos Generados por Fecha' )
    ACT(a:5, 'Desde Fecha Generacion: '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
    ACT(a:6, 'Desde Fecha Ejecucion: '~Dialogo.Fecha5~' al '~Dialogo.Fecha6)
    ACT(a:7, 'Desde Fecha Valor: '~Dialogo.Fecha3~' al '~Dialogo.Fecha4)
    ACT(a:8, 'Asientos: '~IIF(Dialogo.Radio1=0,'Solo OK',IIF(Dialogo.Radio1=1,'Solo Erroneos','Balanceados y Erroneos')) ) 
    ACT(e:5, 'Tipos de Asientos   : '~IIF(NoVacio(Dialogo.Lista1),Pipe2Coma(Copy(Dialogo.Lista1,1,Longitud(Dialogo.Lista1)-1)) ,'Todos'))
    ACT(e:6, 'Tipos de Operaciones: '~IIF(NoVacio(Dialogo.Lista2),Pipe2Coma(Copy(Dialogo.Lista2,1,Longitud(Dialogo.Lista2)-1)) ,'Todas'))
ENDIF
IF Dialogo.Radio2 = 0
    IF Dialogo.Check2 = 0
    ACT(a:3, 'Asientos Generados por Operacion: '~Dialogo.NrOperacion1 )
    ELSE
    ACT(a:3, 'Asientos Generados por Operacion Anulada: '~Dialogo.NrBOperacion )
    ENDIF
    ACT(a:4, 'Asientos: '~IIF(Dialogo.Radio1=0,'Solo OK',IIF(Dialogo.Radio1=1,'Solo Erroneos','Balanceados y Erroneos')) ) 
    ACT(A:5, 'Tipos de Asientos   : '~IIF(NoVacio(Dialogo.Lista1),Pipe2Coma(Copy(Dialogo.Lista1,1,Longitud(Dialogo.Lista1)-1)) ,'Todos'))
ENDIF
IF Dialogo.Radio2 = 1
    ACT(a:3, 'Asientos Generados por Asiento: '~Dialogo.NrunicoAsiento1 )
    ACT(a:4, 'Asientos: '~IIF(Dialogo.Radio1=0,'Solo OK',IIF(Dialogo.Radio1=1,'Solo Erroneos','Balanceados y Erroneos')) ) 
ENDIF

SetFont(a:3, 3)
SetFont(a:2..f:8, 2)

IF Dialogo.Radio2 = 2
    SetFilaActual(10)
ELSE
    SetFilaActual(7)
ENDIF
ACT(a:fac,   'Fecha')
ACT(a:fac+1, 'Generac/Ejecucion')
ACT(b:fac,   'Fecha')
ACT(b:fac+1, 'Valor')
ACT(c:fac,   'Cuenta')
