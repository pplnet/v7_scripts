CrearDialogo
  Check1: 'F.Generacion'  ;1;1;;SI;SI;Dialogo.Check1=1 O Dialogo.Check2=1 O NOVACIO(Dialogo.NrOperacion1);"Debe seleccionar al menos un rango de fechas o #Op";NO;;1
  Fecha1: 'Desde'         ;2;1;;Dialogo.Check1=1;Dialogo.Check1=1;;;;Habiles(FSys,-1,"ARG")
  Fecha2: 'Hasta'         ;3;1;;Dialogo.Check1=1;Dialogo.Check1=1;;;;Habiles(FSys,0,"ARG")
  Check2: 'F.Valor'       ;1;2;;;;;;;0
  Fecha3: 'Desde'         ;2;2;;Dialogo.Check2=1;Dialogo.Check2=1;;;;Habiles(FSys,-5,"ARG")
  Fecha4: 'Hasta'         ;3;2;;Dialogo.Check2=1;Dialogo.Check2=1;;;;Habiles(FSys,-1,"ARG")
  NrOperacion1: '#Op'     ;4;1;;;;;;;;;
  Especie1:     'Especie' ;2;2;;;;;;;;;
*  Lista1: 'Campos'        ;6;1;;;;NoVacio(Dialogo.Lista1);'Debe seleccionar por lo menos un campo';NO;;;'NrOp|NrAsiento|FGeneracion|FValor|Especie|Cta|Modelo|TipoCont|CtaTipo|CtaCategoria|Leyenda'
  Lista2: 'Ctas'          ;6;1;;;;;;;;;SQLSET('Select Codigo from CONTABILIDAD')
  Check5: 'Excluir Puente';7;1;;;;;;;1
FinDialogo

If not OK
  Cancelar
endif

CrearFont(1,'Arial,10,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')
CrearFont(4,'Arial,7,B')

SQL.ADD("Select  NrOp, NrAsiento, FGeneracion, FValor, Especie, Cta, Modelo, TipoCont, CtaTipo, Leyenda, ")
SQL.ADD("sum(DB) DB, sum(CR) CR, sum(Neto) Neto FROM                             ")
SQL.ADD("(Select                                                                 ")
SQL.ADD("   cab.NrOperacion    NrOp,                                             ")
SQL.ADD("   Det.NrUnicoAsiento NrAsiento,                                        ")
SQL.ADD("   FechaGeneracion FGeneracion,                                         ")
SQL.ADD("   FechaValor      FValor,                                              ")
SQL.ADD("   ALIAS5          Especie,                                             ")
SQL.ADD("   rtrim(det.Cuenta) + ' - ' + cc.Nombre  Cta,                          ")
SQL.ADD("   MOD.Codigo  Modelo,                                                  ")
SQL.ADD("   TIP.Descripcion TipoCont,                                            ")
SQL.ADD("   cc.Tipo     CtaTipo,                                                 ")
*SQL.ADD("   cc.Categoria    CtaCategoria,                                       ")
SQL.ADD("   det.Alias4      Leyenda,                                             ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else 0 end * Cantidad1 DB,   ")
SQL.ADD("   case when debitocredito = 'CRE' then  1 else 0 end * Cantidad1 CR,   ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else -1 end * Cantidad1 NETO ")
SQL.ADD("From   "~DBO~".asientoscon cab                                          ")
SQL.ADD("       inner join "~DBO~".asientoscon1 det                              ")
SQL.ADD("           on  cab.NrUnicoAsiento  = det.nrUnicoAsiento                 ")
SQL.ADD("       left  join "~DBO~".modelosasiento mod                            ")
SQL.ADD("           on  cab.Modelo      = mod.codigo                             ")
SQL.ADD("       left  join "~DBO~".tiposasiento tip                              ")
SQL.ADD("           on  tip.codigo      = mod.tipoasiento                        ")
SQL.ADD("       left  join "~DBO~".contabilidad cc                               ")
SQL.ADD("           on  cc.codigo       = det.Cuenta                             ")
SQL.ADD("where  1=1                                                              ")
if Dialogo.Check1=1
  SQL.ADD("and FechaGeneracion between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Check2=1
  SQL.ADD("and FechaValor between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"'      ")
endif
if NoVacio(Dialogo.Lista2)
  SQL.ADD("and det.Cuenta in ("~Pipe2Comillas(Dialogo.Lista2)~")                                       ")
endif
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("and cab.NrOperacion = '"~Dialogo.NrOperacion1~"'                                            ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Alias5 = '"~Dialogo.Especie1~"'                                                         ")
endif
if Dialogo.Check5 = 1
  SQL.ADD("and rtrim(det.Cuenta) != '999.99.99'                                                        ")
endif
SQL.ADD(") AS AUX                                                                                      ")
SQL.ADD("Group by NrOp, NrAsiento, FGeneracion, FValor, Especie, Cta, Modelo, TipoCont, CtaTipo,       ")
SQL.ADD(" Leyenda        with rollup                                                                   ")

ACT(a1,'Contabilidad - Totales por Cuenta')

SetFilaActual(3)


if Dialogo.Check1=1
  if Dialogo.Fecha1 = Dialogo.Fecha2
    ACT(a:fac,'Fecha Generacion: '~Dialogo.Fecha1)
  else
    ACT(a:fac,'Fecha Generacion: '~Dialogo.Fecha1~" hasta "~Dialogo.Fecha2)
  endif
  ifa
endif
if Dialogo.Check2=1
  if Dialogo.Fecha3 = Dialogo.Fecha4
    ACT(a:fac,'Fecha Valor: '~Dialogo.Fecha3)
  else
    ACT(a:fac,'Fecha Valor: '~Dialogo.Fecha3~" hasta "~Dialogo.Fecha4)
  endif
  ifa
endif
If NoVacio(Dialogo.Lista2)
  ACT(a:fac,'Ctas: '~Pipe2Comillas(Dialogo.Lista2))
  ifa
endif
If NoVacio(Dialogo.NrOperacion1)
  ACT(a:fac,'#Operacion: '~Dialogo.NrOperacion1)
  ifa
endif
If NoVacio(Dialogo.Especie1)
  ACT(a:fac,'Especie: '~Dialogo.Especie1)
  ifa
endif

SetFilaActual(5)

ACT(a:fac, 'Nro. Operacion') 
ACT(b:fac, 'Nro. Asiento'  )
ACT(c:fac, 'F. Generacion' )
ACT(d:fac, 'F. Valor'      )
ACT(e:fac, 'Especie'       )
ACT(f:fac, 'Cuenta'        )
ACT(g:fac, 'Modelo'        )
ACT(h:fac, 'Tipo Cont.'    )
ACT(i:fac, 'Cta. Tipo'     )
ACT(j:fac, 'Cta. Categoria')
ACT(k:fac, 'Leyenda'       )

SetFilaActual(fac+1)

Recorrer SQL
    ACT(a:fac, fbn('NrOp')) 
    ACT(b:fac, fbn('NrAsiento'))
    ACT(c:fac, fbn('FGeneracion'))
    ACT(d:fac, fbn('FValor'))
    ACT(e:fac, fbn('Especie'))
    ACT(f:fac, fbn('Cta'))
    ACT(g:fac, fbn('Modelo'))
    ACT(h:fac, fbn('TipoCont'))
    ACT(i:fac, fbn('CtaTipo'))
    ACT(j:fac, fbn('CtaCategoria'))
    ACT(k:fac, fbn('Leyenda'))
Proximo

AgregarMarco(a:5..k:5,0,0,RGB(255,255,255))
SetFont(a1,1)
SetFont(a:5..k:5,2)
SetFont(a:6..k:fac,3)

ACO(1,9)
ACO(2,9)
ACO(3,9)
ACO(4,9)
ACO(5,9)
ACO(6,9)
ACO(10,9)

ACT(a:fac+1,"End of Report")
