ACO(4,45)
Recorrer SQL
IF EqStri(fbn('Usuario'), "CLOMAS")
ACT(a:fac, fbn("NrOperacion"))
ACN(b:fac,FAC)
ACT(C:fac,FBN("Mensaje"))
ACT(d:fac, fbn("Fecha"))
IFA
