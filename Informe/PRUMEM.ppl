IF(EqStr(FBN('Direccion'),"2"))

    SQL.ADD("UPDATE "~DBO~".INSTANCIASOP ")
    SQL.ADD("SET MENSAJE = 'MENSAJE NUEVO' ")
    SQL.ADD("WHERE NrOperacion = '"~FBN("NrOperacion")~"' ")
    SQL.ADD("And Usuario = '"~FBN("Usuario")~"' ")
    SQL.ADD("And Fecha = '"~IDXDATE(FBN("Fecha"))~"' ")
    SQL.ADD("And Mensaje = '"~FBN("Mensaje")~"' ")
    SQL.ADD("And Direccion = '"~FBN("Direccion")~"' ")
    SQL.ADD("And NrInstancia = '"~FBN("NrInstancia")~"' ")
    SQL.NEW
    SQL.EXEC
    SQL.ActualizarMovimientos2(FBN['NrOperacion'],SI,NO,NO,NO)
    SQL.EXEC
    
