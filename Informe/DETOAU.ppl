CrearDialogo
  Fecha1     : "Fecha Desde"         ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, SI);
  Fecha2     : "Fecha Hasta"         ;1;2;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Radio4     : "Consolidado|NO|SI"   ;3;1;;;;;;;0
  Especie1   : "Moneda Oper."        ;3;2;;;;;;;Var('MONEEXTR');;;
  Vehiculo1  : "Vehiculo"            ;5;1;;
  Lista1     : "Lista Vehic"         ;5;1;;
  Lista2     : 'Especie'             ;;;
  Lista3     : 'Fuente'              ;;
  Lista4     : 'Precio'              ;;
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")
CrearFont(6,"Arial,8,BU")
CrearFont(7,"Arial,7,B")
CrearFont(8,"Arial,7,")
CrearFont(9,"Arial,8,B")
CrearFont(10,"Arial,8,")

ACN(EL:1, Elementos(Dialogo.Lista2))

SetFilaActual(2)

ACT(A:fac, 'SITUACION PORTFOLIO DE BONOS')
AgregarMarco(A:fac..E:fac, 1, 0, Exe('COLOR6'))
SetFont(A:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha Desde: '~Dialogo.Fecha1)
IF Dialogo.Radio4 = 0
    ACT(D:fac, 'NO Consolidado')
ELSE
    ACT(D:fac, 'Consolidado')
ENDIF
ifa
ACT(A:fac, 'Fecha Hasta: '~Dialogo.Fecha2)
IF Dialogo.Radio4 = 0
    ACT(D:fac, 'Vehiculo : '~Dialogo.Vehiculo1)
ELSE
    ACT(D:fac, 'Vehiculos : '~Dialogo.Lista1)
ENDIF

SetFilaActual(fac+2)
ACT(A:fac, 'TITULO')
ACT(C:fac, 'FUENTE')
ACT(D:fac, 'PRECIO MERCADO')
AgregarMarco(A:fac..E:fac, 1, 0, Exe('COLOR6'))
AlinearCeldas(A:fac, 'C')
ACN(TC:1, fac+1)
ACN(TC:2, fac+1)

SetFont(A:fac-4..D:fac, 2)

SetFilaActual(fac+2)

ACT(K:fac, 'OPERACIONES VIGENTES EN '~Mayusculas2(BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1)))
SetFont(K:fac, 2)

SetFilaActual(fac+2)

ACT(A:fac, 'Titulo')
ACT(B:fac, 'Vto')
ACT(C:fac, 'Minuta')
ACT(C:fac+1, 'de')
ACT(C:fac+2, 'Compra')
ACT(D:fac, 'Tipo')
ACT(D:fac+1, 'de')
ACT(D:fac+2, 'Oper.')
ACT(E:fac, 'Valor')
ACT(E:fac+2, 'Nominal')
ACT(F:fac, '           Cpra/Vta')
ACT(F:fac+1, 'Precio')
ACT(G:fac+1, 'Valor')
ACT(G:fac+2, 'Residual')
ACT(H:fac, 'Inversion')
ACT(H:fac+1, 'Original')
ACT(H:fac+2, '(Bruta)')
ACT(I:fac, 'C. Corrido')
ACT(I:fac+1, 'Pagado')
ACT(I:fac+2, 'Compra')
ACT(J:fac, 'Egresos')
ACT(J:fac+1, '(Total')
ACT(J:fac+2, 'Inversion)')
ACT(K:fac, 'Fecha')
ACT(K:fac+1, 'de la')
ACT(K:fac+2, 'Oper.')
ACT(L:fac, 'Fecha')
ACT(L:fac+1, 'de')
ACT(L:fac+2, 'Liq.')
ACT(N:fac, 'Valor')
ACT(N:fac+1, 'Residual')
ACT(N:fac+2, 'Act.')
ACT(O:fac, 'Valor de')
ACT(O:fac+1, 'Mercado')
ACT(O:fac+2, '(A)')
ACT(P:fac, 'F. Inicio')
ACT(P:fac+1, 'Cupon')
ACT(P:fac+2, 'Act.')
ACT(Q:fac, 'Fecha Fin')
ACT(Q:fac+1, 'Cupon')
ACT(Q:fac+2, 'Act.')
ACT(R:fac, '  Tasa Cupon Act.')
ACT(R:fac+1, 'Tipo')
ACT(S:fac+1, '%')
ACT(T:fac, 'Intereses')
ACT(T:fac+1, 'Totales')
ACT(T:fac+2, 'Cupon Act.')
ACT(U:fac, 'Int. Deveng.')
ACT(U:fac+1, 'Cupon Act.')
ACT(U:fac+2, '(B)')
ACT(V:fac, 'Capital')
ACT(V:fac+1, 'Ex-Cupon')
ACT(V:fac+2, '(C)')
ACT(W:fac, 'STOCK AL')
ACT(W:fac+1, Fstr(Dia(Fsys), 2, 0)~'-'~Copy(Meses(Mes(Fsys)), 1, 3)~'-'~Copy(Fstr(Anio(Fsys), 2, 0), 3, 2))
ACT(W:fac+2, '(A)+(B)+(C)')
ACT(Y:fac, '                     Desde Inicio Inversion')
ACT(Y:fac+1, '                    Cupones recibidos')
ACT(Y:fac+2, 'Capital')
ACT(Z:fac+2, 'Intereses')

SetFilaActual(fac+2)

***---El Tipo de Tasa se guarda en el campo Security Type de la solapa Otros de tabla Especies
SQL.ADD(" Select O.NrOperacion, O.Especie, O.FechaVto, O.TipoOp, O.Cantidad, O.Precio1, O.Precio2, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.FechaOp, E.Nombre, ")
SQL.ADD(" E.Fecha Maduracion, E.SType TipoTasa, E.TasaIntVigente, E.InteresesC, 0 Saldo, E.VTeorico ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where O.ContraEspecie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.Especie = E.Codigo ")
SQL.ADD(" AND O.TipoOp In ('SECS','SECSV','SECT','SECTV','SEVS','SEVSV','SEVT','SEVTV') ")
IF Dialogo.Radio4 = 0
    SQL.ADD(" AND O.Vehiculo1 = "~Dialogo.Vehiculo1~" ")
ELSE
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD(" UNION ")

***---Select para Saldo Inicial de la Especie
SQL.ADD(" Select '' NrOperacion, S. Especie, '' FechaVto, '' TipoOp, 0 Cantidad, ")
SQL.ADD(" 0 Precio1, 0 Precio2, 0 TotalBrutoCli1, 0 TotalIntereses, 0 TotalNetoCli1, ")
SQL.ADD(" '' FechaOp, E.Nombre, '' Maduracion, '' TipoTasa, ")
SQL.ADD(" 0 TasaIntVigente, E.InteresesC, Sum(S.Saldo) Saldo, 0 VTeorico ")
SQL.ADD(" From "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD(" Where S.NrSaldo = 10 ")
IF Dialogo.Radio4 = 0
    SQL.ADD(" AND S.Cliente = "~Dialogo.Vehiculo1~" ")
ELSE
    SQL.ADD(" AND S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" AND E.Codigo = S.Especie ")
SQL.ADD(" AND S.Saldo <> 0 ")
SQL.ADD(" AND S.Fecha = (Select Max(D.Fecha) From "~DBO~".SALDOSDIA D ")
SQL.ADD("                Where D.Cliente = S.Cliente ")
SQL.ADD("                AND D.Especie = S.Especie ")
SQL.ADD("                AND D.NrSaldo = S.NrSaldo ")
SQL.ADD("                AND D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" Group By S.Precio1, S.Precio2, S.Especie, E.Nombre, E.InteresesC ")

SQL.ADD(" UNION ")

***---Select para Saldo Inicial de Cupones
SQL.ADD(" Select '' NrOperacion, Especie, '' FechaVto, '' TipoOp, ")
SQL.ADD(" Sum(Cantidad*Precio1) Cantidad, 0 Precio1, Sum(Cantidad*Precio2) Precio2, ")
SQL.ADD(" 0 TotalBrutoCli1, 0 TotalIntereses, 0 TotalNetoCli1, '' FechaOp, ")
SQL.ADD(" E.Nombre, '' Maduracion, '' TipoTasa, 0 TasaIntVigente, E.InteresesC, ")
SQL.ADD(" 0 Saldo, 0 VTeorico ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where TipoOp = 'CUPON' ")
SQL.ADD(" AND E.Codigo = O.Especie ")
SQL.ADD(" AND MB4='3' ")
SQL.ADD(" AND TipoCambio3 = 10 ")
SQL.ADD(" AND FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND (OperacionRef Is Null OR (OperacionRef Is Not Null AND OperacionRef = '')) ")
SQL.ADD(" AND ContraEspecie = '"~Dialogo.Especie1~"' ")
IF Dialogo.Radio4 = 0
    SQL.ADD(" AND Vehiculo1 = "~Dialogo.Vehiculo1~" ")
ELSE
    SQL.ADD(" AND Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" Group By O.Especie, E.Nombre, E.InteresesC ")

SQL.ADD(" Order By 2, 17 Desc, 1 Desc ")

ACT(ES:1, '')
ACN(FI:1, fac+1)
ACN(FI:3, fac+1)
Recorrer&k 1, 7
    ACN(TE:&k, 0)
    ACN(TB:&k, 0)
Proximo
ACN(TF:1, 0)
ACN(TF:2, 0)
ACN(TF:3, 0)
ACN(TG:1, 0)
ACN(TG:2, 0)
ACN(TG:3, 0)
ACN(BD:1, 0)
ACN(BD:2, 0)
ACN(BD:3, 0)

Recorrer SQL
    IF Not Eqstr(fbn('Especie'), Val(ES:1)) Y Not CeldaVacia(ES:1)
        ***---Cambio de Especie
        InsertarFila(Val(TC:1))
        ACT(A:Val(TC:1), Mayusculas2(Copy(Val(ES:2), 1, 1))~Minusculas2(Copy(Val(ES:2), 2, 14)))
        ACT(B:Val(TC:1), Copy(Val(ES:1), 1, 6))
        ACT(C:Val(TC:1), Mayusculas2(Copy(Val(FT:1), 1, 1))~Minusculas2(Copy(Val(FT:1), 2, 10)))
        ACN(D:Val(TC:1), Val(CT:1))
        SCN(TC:1, 1)
        SCN(FI:1, 1)
        ifa
        ACT(A:fac, 'Subtotal  '~Val(ES:1))
        ACN(E:fac, Val(TE:1))
        ACN(H:fac, Val(TE:2))
        ACN(I:fac, Val(TE:3))
        ACN(J:fac, Val(TE:4))
        ACN(T:fac, Val(TE:5))
        ACN(U:fac, Val(TE:6))
        ACN(G:fac, Val(TE:7))
        ACN(N:fac, Val(TG:2))
        ACN(O:fac, Val(TG:1))
        ACN(W:fac, Val(TG:3))
        Recorrer&k 1, 8
            SCN(TB:&k, Val(TE:&k))
            ACN(TE:&k, 0)
        Proximo
        SCN(TF:1, Val(TG:1))
        SCN(TF:2, Val(TG:2))
        SCN(TF:3, Val(TG:3))
        ACN(TG:1, 0)
        ACN(TG:2, 0)
        ACN(TG:3, 0)
        ACN(BD:2, 0)
        ACN(BD:3, 0)
        ifa
    ENDIF
    ACN(BD:1, 1)
    ACT(ES:1, fbn('Especie'))
    ACT(ES:2, fbn('Nombre'))
    Recorrer&j 1, Val(EL:1)
        IF Eqstr(Val(ES:1), ItemLista(Dialogo.Lista2, &j))
            ACN(CT:1, Num(ItemLista(Dialogo.Lista4, &j)))
            ACT(FT:1, ItemLista(Dialogo.Lista3, &j))
        ENDIF
    Proximo
    SCN(BD:2, 1)
    IF NoVacio(fbn('NrOperacion'))
        SCN(BD:3, 1)
        IF Val(BD:2) = 1
            ***---Primer registro para la especie
            ***---Registro de Operaciones
            ACT(A:fac, 'Saldo Inicial')
            ACN(W:fac, 0)
            ACN(Y:fac, 0)
            ACN(Z:fac, 0)
            ACN(TE:1, 0)
            ACN(TE:7, 0)
            ACN(TE:5, 0)
            ACN(TE:6, 0)
            ACN(TG:1, 0)
            ACN(TG:2, 0)
            ifa
        ENDIF
        IF Val(BD:3) = 1
            ***---Primer Registro de Operaciones
            ACT(A:fac, Mayusculas2(Copy(fbn('Nombre'), 1, 1))~Minusculas2(Copy(fbn('Nombre'), 2, 13))~' '~fbn('Especie'))
*            IF Eqstr(fbn('InteresesC'), 'CLE')
                ACN(VT:1, ValorTeorico(fbn('Especie')))
*            ELSE
*                ACN(VT:1, 1)
*            ENDIF
        ENDIF
        ACT(B:fac, Pad0(Fstr(Dia(fbn('Maduracion')), 0, 0), 2)~'/'~Pad0(Fstr(Mes(fbn('Maduracion')), 0, 0), 2)~'/'~Copy(Fstr(Anio(fbn('Maduracion')), 0, 0), 3, 2))
        ACT(C:fac, fbn('NrOperacion'))
        ACLO(C:fac, fbn('NrOperacion'))
        IF Incluido(fbn('TipoOp'), 'SECS|SECSV|SECT|SECTV')
            ACT(D:fac, 'Compra')
            ACN(SG:1, 1)
        ELSE
            ACT(D:fac, 'Venta')
            ACN(SG:1, -1)
        ENDIF
        ACN(E:fac, fbn('Cantidad')*Val(SG:1))
        ACN(F:fac, fbn('Precio1'))
*        ACN(G:fac, Val(E:fac)*fbn('Precio2'))
        ACN(G:fac, Val(E:fac)*fbn('VTeorico'))
        ACN(H:fac, fbn('TotalBrutoCli1')*Val(SG:1))
        ACN(I:fac, fbn('TotalIntereses')*Val(SG:1))
        ACN(J:fac, fbn('TotalNetoCli1')*Val(SG:1))
        ACT(K:fac, Pad0(Fstr(Dia(fbn('FechaOp')), 0, 0), 2)~'/'~Pad0(Fstr(Mes(fbn('FechaOp')), 0, 0), 2)~'/'~Copy(Fstr(Anio(fbn('FechaOp')), 0, 0), 3, 2))
        ACT(L:fac, Pad0(Fstr(Dia(fbn('FechaVto')), 0, 0), 2)~'/'~Pad0(Fstr(Mes(fbn('FechaVto')), 0, 0), 2)~'/'~Copy(Fstr(Anio(fbn('FechaVto')), 0, 0), 3, 2))
        ACN(N:fac, Val(E:fac)*Val(VT:1))
        ACN(O:fac, Val(N:fac)*Val(CT:1))
        ACD(UC:1, UltCupon(fbn('Especie'), Fsys))
        ACT(P:fac, Pad0(Fstr(Dia(Val(UC:1)), 0, 0), 2)~'/'~Pad0(Fstr(Mes(Val(UC:1)), 0, 0), 2)~'/'~Copy(Fstr(Anio(Val(UC:1)), 0, 0), 3, 2))
        ACD(PC:1, ProxCupon(fbn('Especie'), Fsys))
        ACT(Q:fac, Pad0(Fstr(Dia(Val(PC:1)), 0, 0), 2)~'/'~Pad0(Fstr(Mes(Val(PC:1)), 0, 0), 2)~'/'~Copy(Fstr(Anio(Val(PC:1)), 0, 0), 3, 2))
        ACT(R:fac, fbn('TipoTasa'))
        ACT(S:fac, Fstr(fbn('TasaIntVigente')*100, 0, 6)~'%')
        ACN(T:fac, InteresEspecie(fbn('Especie'), Val(Q:fac), fbn('Cantidad'))*Val(SG:1))
        ACN(U:fac, InteresEspecie(fbn('Especie'), Fsys, fbn('Cantidad'))*Val(SG:1))
        ACN(V:fac, 0)
        ACN(W:fac, Val(O:fac)+Val(U:fac)+Val(V:fac))
        SCN(TE:1, fbn('Cantidad')*Val(SG:1))
        SCN(TE:2, fbn('TotalBrutoCli1')*Val(SG:1))
        SCN(TE:3, fbn('TotalIntereses')*Val(SG:1))
        SCN(TE:4, fbn('TotalNetoCli1')*Val(SG:1))
        SCN(TE:5, Val(T:fac))
        SCN(TE:6, Val(U:fac))
        SCN(TE:7, Val(G:fac))
        SCN(TG:2, Val(N:fac))
        SCN(TG:1, Val(O:fac))
        SCN(TG:3, Val(W:fac))
    ELSE
        ***---Registro con Saldo Inicial O de Cupones
        ACN(CC:1, CotizacionC(fbn('Especie'),,,,Habiles(Dialogo.Fecha1,-1,'ARG',SI),1,SI,Dialogo.Especie1))
        IF fbn('Saldo') = 0
            ***---Cupon
            IF Val(BD:2) > 1
                ***---Tiene Saldo Inicial, => Decremento fila
                DFA
            ELSE
                ACT(A:fac, 'Saldo Inicial')
                ACN(W:fac, 0)
            ENDIF
            ACN(Y:fac, fbn('Cantidad')*Val(CC:1))
            ACN(Z:fac, fbn('Precio2')*Val(CC:1))
        ELSE
            ***---Saldo Inicial
            ***---Para Saldo Inicial calculo los valores
            ACT(A:fac, 'Saldo Inicial')
            ACN(VT:1, BuscarCampo('ESPECIES','VTeorico','Codigo', fbn('Especie')))
            ACN(E:fac, fbn('Saldo'))
            ACN(G:fac, fbn('Saldo')*Val(VT:1))
            SCN(TE:1, fbn('Saldo'))
            ACN(TE:7, fbn('Saldo')*Val(VT:1))
            ***---Busco el PPP de Posiciones
            SQL.ADD(" Select P.CantidadFin, P.PrecioFin From "~DBO~".POSICIONES P ")
            SQL.ADD(" Where P.Especie = '"~fbn('Especie')~"' ")
            SQL.ADD(" AND P.NrSaldo IN ('101','201') ")
            IF Dialogo.Radio4 = 0
                SQL.ADD(" AND P.Cliente = "~Dialogo.Vehiculo1~" ")
            ELSE
                SQL.ADD(" AND P.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
            ENDIF
            SQL.ADD(" AND P.Fecha = (Select Max(D.Fecha) From "~DBO~".POSICIONES D ")
            SQL.ADD("                Where D.Cliente = P.Cliente ")
            SQL.ADD("                AND D.Especie = P.Especie ")
            SQL.ADD("                AND D.NrSaldo = P.NrSaldo ")
            SQL.ADD("                AND D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
                Recorrer SQL
                    DFA
                    SCN(CP:1, fbn('CantidadFin'))
                    SCN(CP:2, fbn('CantidadFin')*fbn('PrecioFin'))
                Proximo
            ACN(PP:1, Val(CP:2)/Val(CP:1))
            IF Eqstr(fbn('InteresesC'), 'CLE')
                ACN(H:fac, Val(PP:1)*fbn('Saldo')*Val(VT:2))
                SCN(TE:2, Val(PP:1)*fbn('Saldo')*Val(VT:2))
            ELSE
                ACN(H:fac, Val(PP:1)*fbn('Saldo'))
                SCN(TE:2, Val(PP:1)*fbn('Saldo'))
            ENDIF
            ACN(F:fac, Val(PP:1))
            ACN(I:fac, InteresEspecie(fbn('Especie'), Habiles(Dialogo.Fecha1,+2,'ARG',SI), fbn('Saldo')))
            SCN(TE:3, InteresEspecie(fbn('Especie'), Habiles(Dialogo.Fecha1,+2,'ARG',SI), fbn('Saldo')))
            ACN(VT:2, ValorTeorico(fbn('Especie')))
            ACN(N:fac, fbn('Saldo')*Val(VT:2))
            ACN(O:fac, Val(N:fac)*Val(CT:1))
            SCN(TG:2, fbn('Saldo')*Val(VT:2))
            SCN(TG:1, Val(N:fac)*Val(CT:1))
            ACD(UC:1, UltCupon(fbn('Especie'), Fsys))
            ACT(P:fac, Pad0(Fstr(Dia(Val(UC:1)), 0, 0), 2)~'/'~Pad0(Fstr(Mes(Val(UC:1)), 0, 0), 2)~'/'~Copy(Fstr(Anio(Val(UC:1)), 0, 0), 3, 2))
            ACD(PC:1, ProxCupon(fbn('Especie'), Fsys))
            ACT(Q:fac, Pad0(Fstr(Dia(Val(PC:1)), 0, 0), 2)~'/'~Pad0(Fstr(Mes(Val(PC:1)), 0, 0), 2)~'/'~Copy(Fstr(Anio(Val(PC:1)), 0, 0), 3, 2))
            ACN(T:fac, InteresEspecie(fbn('Especie'), Val(TX:1), fbn('Saldo')))
            SCN(TE:5, InteresEspecie(fbn('Especie'), Val(TX:1), fbn('Saldo')))
            ACN(U:fac, InteresEspecie(fbn('Especie'), Fsys, fbn('Saldo')))
            SCN(TE:6, InteresEspecie(fbn('Especie'), Fsys, fbn('Saldo')))
            ACN(W:fac, Val(O:fac)+Val(U:fac)+Val(V:fac))
            SCN(TG:3, Val(W:fac))
        ENDIF
    ENDIF
Proximo
IF Val(BD:1) = 1
    InsertarFila(Val(TC:1))
    ACT(A:Val(TC:1), Mayusculas2(Copy(Val(ES:2), 1, 1))~Minusculas2(Copy(Val(ES:2), 2, 14)))
    ACT(B:Val(TC:1), Copy(Val(ES:1), 1, 6))
    ACT(C:Val(TC:1), Mayusculas2(Copy(Val(FT:1), 1, 1))~Minusculas2(Copy(Val(FT:1), 2, 10)))
    ACN(D:Val(TC:1), Val(CT:1))
    AgregarMarco(A:Val(TC:2)..E:Val(TC:1), 1, 0)
    SetFont(A:Val(TC:2)..D:Val(TC:1), 1)
    FormatoCeldas(D:Val(TC:2)..D:Val(TC:1), Exe('F8'))
    SCN(TC:1, 1)
    SCN(FI:1, 1)
    ACN(FI:2, Val(FI:1))
    ifa
    Recorrer&k Val(FI:1), fac
        IF Eqstr(Copy(Val(A:&k), 1, 8), 'Subtotal')
            AgregarMarco(A:Val(FI:2)..B:&k-1, 1, 0)
            AgregarMarco(C:Val(FI:2)..M:&k-1, 1, 0)
            AgregarMarco(M:Val(FI:2)..M:&k-1, 1, 0)
            AgregarMarco(N:Val(FI:2)..W:&k-1, 1, 0)
            AgregarMarco(W:Val(FI:2)..X:&k-1, 1, 0)
            AgregarMarco(Y:Val(FI:2)..Z:&k-1, 1, 2)
            AgregarMarco(A:&k..B:&k, 1, 0)
            AgregarMarco(C:&k..M:&k, 1, 0)
            AgregarMarco(M:&k..M:&k, 1, 0)
            AgregarMarco(N:&k..W:&k, 1, 0)
            AgregarMarco(W:&k..X:&k, 1, 0)
            AgregarMarco(Y:&k..Z:&k, 1, 2)
            SetFont(A:Val(FI:2)..Z:&k-1, 10)
            SetFont(A:&k..Z:&k, 9)
            ACN(FI:2, &k+1)
        ENDIF
    Proximo
    SetFont(A:Val(FI:2)..Z:fac, 10)
    AgregarMarco(A:Val(FI:2)..B:fac, 1, 0)
    AgregarMarco(C:Val(FI:2)..M:fac, 1, 0)
    AgregarMarco(M:Val(FI:2)..M:fac, 1, 0)
    AgregarMarco(N:Val(FI:2)..W:fac, 1, 0)
    AgregarMarco(W:Val(FI:2)..X:fac, 1, 0)
    AgregarMarco(Y:Val(FI:2)..Z:fac, 1, 2)
ENDIF
***---Marcos del Titulo porque el insertar fila no los baja
AgregarMarco(A:Val(TC:1)+3..E:Val(TC:1)+5, 1, 2, Exe('COLOR6'))
AgregarMarco(F:Val(TC:1)+3..G:Val(TC:1)+3, 1, 0, Exe('COLOR6'))
AgregarMarco(F:Val(TC:1)+4..G:Val(TC:1)+5, 1, 2, Exe('COLOR6'))
