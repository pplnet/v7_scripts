CrearDialogo
  Fecha1 : 'Fecha';;;;;;;;;FSys
FinDialogo


ACT(a1, 'Operaciones realizadas en el dia')
ACT(a2, 'Fecha : '~Dialogo.Fecha1)
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SQL.ADD("Select * from "~DBO~".OPERACIONES where TipoOp in ('MMAD','MMCA','MMCO','MMCT','MMDES','MMPF','MMPFCE','MMPO','MMOVN')")
SQL.ADD("and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("order by NrOperacion")

ACT(a4, 'Tipo')
ACT(b4, 'Moneda')
ACT(c4, 'Cliente')
ACT(d4, 'Cantidad')
ACT(e4, 'Tasa')
ACT(f4, 'Tasa Base')
ACT(g4, 'Tipo T.Base')
ACT(h4, 'Plazo')
ACT(i4, 'Fecha Vto.')
ACT(j4, 'Intereses')
ACT(k4, 'Impuestos')
ACT(l4, 'Total')
ACT(m4, 'Operador')
ACT(n4, 'Origen')
ACT(o4, 'Nr.Operacion')
AlinearCeldas(d4..f4, 'D')
AlinearCeldas(h4..h4, 'D')
AlinearCeldas(j4..l4, 'D')
AgregarMarco(a4..o4,2,0,Exe('COLOR'))
SetFont(a1..p4, 1)
SetFilaActual(4)
recorrer SQL
  ACT(a:fac, fbn('TipoOp'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  if Incluido(fbn('TipoOp'), 'MMAD|MMDES|MMPO')
    ACN(f:fac, fbn('Precio4'))
    if fbn('RB5')=0
      ACT(g:fac, 'Transfer.')
    else
      ACT(g:fac, 'Call')
    endif
  endif
  ACN(h:fac, fbn('Plazo'))
  ACT(i:fac, fbn('FechaVto'))
  ACN(j:fac, fbn('TotalIntereses'))
  ACN(k:fac, fbn('TotalImpuestos'))
  ACN(l:fac, fbn('TotalBrutoCli1'))
  ACT(m:fac, fbn('Operador'))
  if fbn('Corporate')=0
    ACT(n:fac, 'Mesa')
  else
    ACT(n:fac, 'Sales')
  endif
  ACT(o:fac, fbn('NrOperacion'))
  ACLO(o:fac, fbn('NrOperacion'))
proximo

FormatoCeldas(e:5..f:fac, Exe('F7'))
FormatoCeldas(h:5..h:fac, Exe('F0'))
SetFont(a5..o:fac, 2)
Impresion(1,2)
