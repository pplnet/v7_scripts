CrearDialogo
   Especie1   : 'Esp.Cupon' ;;;;  ;;[NoVacio(Dialogo.Especie1)] Y [DesciendeDeEspecie(Dialogo.Especie1, 'TITULO') Y EqStr(BuscarCampo('ESPECIES','EsCupon', 'Codigo', Dialogo.Especie1),'SI')];'Especie de Cupon Invalida';NO;;;;;;" EsCupon = 'SI' ";
   Entero1    : 'NrCupon'   ;;;;si;;;;;;BuscarCampo('ESPECIES','Cupon','Codigo',Dialogo.Especie1)
   Fecha1     : 'F. Pago'   ;;;;  ;;Dialogo.Fecha1<>0;'Fecha de Pago Invalida';NO;FSYS;Dialogo.Fecha2
   Vehiculo1  : 'Vehiculo'  ;;;;;;[NoVacio(Dialogo.Vehiculo1) Y Incluido(Dialogo.Vehiculo1, IIF(NoVacio(UsrVehiculos(UsuarioActivo)), UsrVehiculos(UsuarioActivo), SQLSet(" Select Codigo From "~DBO~".VEHICULOS ")))];'Debe Ingresar un Vehiculo Valido';NO;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Fecha2     : 'F. Pago'   ;;;;NO;NO;;;;;SQL(" Select A.FechaPago From "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E Where E.Codigo = A.Especie AND E.Alias3 = '"~Dialogo.Especie1~"' AND A.NrCupon = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ");
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")
CrearFont(5,"Arial,14,B")

SetFilaActual(2)
ACT(f:FAC, 'COBRO Y PAGO DE CUPONES')
SetFont(f:FAC, 2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Especie Cupon: '~Dialogo.Especie1)
IFA
ACT(a:FAC, 'Cupon: '~Fstr(Dialogo.Entero1, 0, 0))
IFA
ACT(a:FAC, 'Fecha de Pago: '~Dialogo.Fecha1)
IFA
IFA
SetFont(a:FAC-4..a:FAC-1, 2)

***---Titulos de Columnas
ACT(a:FAC, 'NrTrans')
ACT(b:FAC, 'Tipo')
ACT(b:FAC+1, 'Transaccion')
ACT(c:FAC, 'Saldo')
ACT(d:FAC, 'Cuenta')
ACT(e:FAC, 'Precio')
ACT(e:FAC+1, 'Cupon')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Importe')
ACT(h:FAC, 'Cuenta')
ACT(h:FAC+1, 'Moneda')
ACT(i:FAC, 'Custodio')
ACT(j:FAC, '% Renta')
ACT(k:FAC, 'Total')
ACT(k:FAC+1, 'Renta')
ACT(l:FAC, '% Amort')
ACT(m:FAC, 'Total')
ACT(m:FAC+1, 'Amort')
ACT(n:FAC, 'Pendiente')

SetFont(a:FAC..o:FAC+1, 2)
AlinearCeldas(a:FAC..o:FAC+1,'C')
AgregarMarco(a:FAC..o:FAC+1,0,0,Exe('COLOR'))
SetFilaActual(FAC+2)

ACN(fi:1, FAC)

If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6, Dialogo.Vehiculo1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else
      ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
Endif

SQL.ADD("SELECT T.Cantidad1, T.Cuenta2, T.Cuenta6, T.Precio1, T.Especie1, ")
SQL.ADD("       T.Cantidad2, T.Cliente2, T.Precio2, T.Cantidad5, T.Precio3, T.Cantidad6, T.CB2, ")
SQL.ADD("       T.Cliente1, T.NrTrans, T.TipoTr2 ")
SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE  T.TipoTr2 IN ('CCUPON','PCUPON') ")
SQL.ADD("       AND B.NrOperacion = T.NrTrans ")
SQL.ADD("       AND B.NrBit <> 25 ")
SQL.ADD("       AND B.Valor = '1' ")
SQL.ADD("       AND T.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("       AND T.Cupon1 = '"~Fstr(Dialogo.Entero1, 0, 0)~"' ")
SQL.ADD("       AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and T.Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
SQL.ADD("  ")
SQL.ADD("ORDER BY T.Cliente1 ")

Recorrer SQL
   ACT(a:FAC, FBN['NrTrans'])
   ACLT(a:FAC, FBN['NrTrans'])
   ACT(b:FAC, FBN['TipoTr2'])
   ACN(c:FAC, FBN['Cantidad1'])
   ACT(d:FAC, FBN['Cuenta6'])
   ACN(e:FAC, FBN['Precio1'])
   ACT(f:FAC, FBN['Especie1'])
   ACN(g:FAC, FBN['Cantidad2'])
   ACT(h:FAC, FBN['Cuenta2'])
   ACT(i:FAC, FBN['Cliente2'])
   ACN(j:FAC, FBN['Precio2'])
   ACN(k:FAC, FBN['Cantidad5'])
   ACN(l:FAC, FBN['Precio3'])
   ACN(m:FAC, FBN['Cantidad6'])
   If Eqstr(FBN['CB2'], '1')
      ACT(n:FAC, 'SI')
   Else
      ACT(n:FAC, 'NO')
   Endif
   SetFont(a:fac..n:fac, 1)
Proximo

