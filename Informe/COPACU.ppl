AlinearCeldas(O:Val(FI:1)..O:FAC, 'C')
AgregarMarco(A:Val(FI:1)..O:FAC,0,0)
IFA
IFA
IFA
ACT(A:FAC, 'Fin del Informe.')
SetFont(A:FAC, 2)

