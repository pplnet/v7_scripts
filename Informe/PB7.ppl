MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1: 'Vehiculo'    ; 1;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Especie1:  'Moneda'      ; 2;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Moneda Invalida';NO;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
  Fecha1:    'D.FechaAcred'; 3;1;;;;;;;fsys
  Fecha2:    'H.FechaAcred'; 4;1;;;;;;;fsys
  Fecha3:    'D.FechaIngre'; 5;1;;;;;;;fsys
  Fecha4:    'H.FechaIngre'; 6;1;;;;;;;fsys
  Entero1:   'Desde Nro.'  ; 7;1;;;;;;;;;;;'############'; 
  Entero2:   'Hasta Nro.'  ; 7;2;;;;Dialogo.Entero2>0;'El Nro. de Comprobante Hasta debe ser mayor a cero';NO;;;;;'############';
  Radio1 : 'Tipo Cuenta|Cta.Cte|Intermedia|Recaudadora|Todos' ;8;1;;;;;;;3
  Lista1 :   'Bancos'      ; 9;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN'")
  Lista2:    'Cuentas'     ;3;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ");
FinDialogo


If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,BI")
CrearFont(4,"Arial,10,B")


ACT(a:1, 'Vehiculo: '~Dialogo.Vehiculo1)
ACT(a:2, 'Moneda: '~Dialogo.Especie1)
ACT(a:3, 'Desde Comprobante: '~fstr(Dialogo.Entero1,0,0)~' al '~fstr(Dialogo.Entero2,0,0))
ACT(a:4, 'Bancos:  '~iif(NoVacio(Dialogo.Lista1),Pipe2Comillas(Dialogo.Lista1),'Todos'))
ACT(a:5, 'Cuentas: '~iif(NoVacio(Dialogo.Lista2),Pipe2Comillas(Dialogo.Lista2),'Todas'))
SetFont(a:1..a:5,2)

ACT(b:6, 'Recaudaciones por Nro. de Comprobante '~iif(dialogo.Radio1=0,'en Cuentas Corrientes',iif(Dialogo.radio1=1,' en Cuentas Intermedias',iif(Dialogo.radio1=2,'en Cuentas Recaudadoras'))))
SetFont(b:6,4)

SetFilaActual(8)

ACT(a:fac,   'Cuenta')
ACT(b:fac,   'Numero')
ACT(c:fac,   'Importe')
ACT(d:fac,   'Fecha')
ACT(d:fac+1, 'Acreditacion')
ACT(e:fac,   'Fecha')
ACT(e:fac+1, 'Ingreso')
ACT(f:fac,   'Transaccion')

SetFont(a:fac..f:fac+1,2)
AlinearCeldas(a:fac..f:fac+1,'C')
AgregarMarco(a:fac..f:fac+1,0,0,EXE('COLOR6'))


SQL.ADD(" SELECT T.Fecha1, T.Fecha2, T.NrTrans, T.Cuenta2, T.Cantidad1, T.Cambio1, ")
SQL.ADD(" C.Numero, C.Comitente, B.RazonSocial, B.Alias2 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES B, "~DBO~".CUENTAS C ")
SQL.ADD(" WHERE T.Cuenta2   = C.Codigo ")
SQL.ADD(" AND   C.Comitente = B.Codigo ")
SQL.ADD(" AND   T.TipoTr2 = 'CRVM' ")
SQL.ADD(" AND   T.CB1     = '1' ")
SQL.ADD(" AND   T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   T.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND   T.Fecha1 >= '"~IdxDate(Dialogo.Fecha3)~"' ")
SQL.ADD(" AND   T.Fecha1 <= '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD(" AND   ((T.Cambio1 >= "~fstr(Dialogo.Entero1,0,0)~" ")
SQL.ADD("        AND   T.Cambio1 <= "~fstr(Dialogo.Entero2,0,0)~") OR T.Cambio1 IS NULL )")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Novacio(Dialogo.Especie1)
  SQL.ADD(" AND T.Especie = '"~Dialogo.Especie1~"' ")
Endif
If Dialogo.Radio1=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
SQL.ADD(" ORDER BY T.Cambio1, C.Comitente, T.Cuenta2 ")

ACN(cp:1,0)
ACT(ba:1,'')
ACT(ca:1,'')


