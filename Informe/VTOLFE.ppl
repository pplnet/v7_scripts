ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1 : 'Empresa'   ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
  Fecha1    : 'Vto. al'   ;;;;;;Dialogo.Fecha1>0;;;FSys
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites - Vencimiento de Lineas de Credito al: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Empresa:')
ACT(b:FAC+2, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
SetFont(a:FAC..b:FAC+2,2)

SetFilaActual(FAC+4)
ACT(a:FAC, 'Banco')
ACT(b:FAC, 'Fecha Vto')
ACT(c:FAC, 'Linea')
ACT(d:FAC, 'Observaciones')
SetFont(a:FAC..d:FAC,2)
AlinearCeldas(a:FAC..d:FAC,'C')
AgregarMarco(a:FAC..d:FAC,1,2,Exe('COLOR'))

SetFilaActual(FAC+1)
SQL.ADD("Select * from "~DBO~".LIMASIGNADOS where Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and Limite in ('ACLTOT','ACOTOT') ")
SQL.ADD("and FVencimiento = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("order by Cliente")
recorrer SQL
  ACT(a:FAC, FBN['Cliente'])
  ACD(b:FAC, FBN['FVencimiento'])
  ACN(c:FAC, FBN['Monto'])
  SetFont(a:FAC..d:FAC,1)
proximo

ACO(1,12)
ACO(2,10)
ACO(3,10)
ACO(4,15)

LimitesVision(d:FAC)
RangoTitulo(a:8..d:FAC,1)
