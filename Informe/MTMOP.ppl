CrearDialogo
  Fecha1   : 'Fecha Desde'              ;1;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha Desde invalida';NO;FSys;
  Fecha2   : 'Fecha Hasta'              ;2;1;;;;EsHabil(Dialogo.Fecha2,'ARG') y Dialogo.Fecha2>0;'Fecha Hasta invalida';NO;FSys;
  Vehiculo1: 'Vehiculo'                 ;3;1;;;;
  Cliente1 : 'Cliente'                  ;4;1;;;;
  Radio1   : 'Fecha Futuro|Uno|Todos|'  ;5;1;;;;;;;1
  Radio2   : 'Fecha |MTM|Liquida|'      ;6;1;;;;;;;0
  Fecha3   : 'Futuro'                   ;5;2;;;Dialogo.Radio1=0;EsHabil(Dialogo.Fecha3,'ARG') y Dialogo.Fecha3>0;'Fecha Futuro invalida';NO;FSys;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

ACT(A:2,'Informe MTM Diario por Operacion')
SetFont(A:2,1)

SetFilaActual(4)

ACT(A:FAC,'Fecha Desde: '~Dialogo.Fecha1)
ACT(A:FAC+1,'Fecha Hasta: '~Dialogo.Fecha2)
If NoVacio(Dialogo.Vehiculo1)
   ACT(A:FAC+2,'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(A:FAC+2,'Vehiculo: Todos')
EndIf
If NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+3,'Cliente: '~Dialogo.Cliente1)
Else
   ACT(A:FAC+3,'Cliente: Todos')
EndIf
If Dialogo.Radio1=0
   ACT(A:FAC+4,'Fecha Futuro: '~Dialogo.Fecha3)
Else
   ACT(A:FAC+4,'Fecha Futuro: Todos')
EndIf

If Dialogo.Radio2=0
   ACT(A:FAC+5,'Fecha : MTM')
Else
   ACT(A:FAC+5,'Fecha : Liquida')
EndIf

SetFont(A:FAC..A:FAC+5,2)

SetFilaActual(FAC+7)

ACT(A:FAC,'Fecha')
ACT(B:FAC,'Futuro')
ACT(C:FAC,'Cliente')
ACT(D:FAC,'Vehiculo')
ACT(E:FAC,'Nr Operacion')
ACT(F:FAC,'Nominal')
ACT(G:FAC,'MTM')
AlinearCeldas(A:FAC..G:FAC,'C')
AgregarMarco(A:FAC..G:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..G:FAC,2)

Recorrer&I Dialogo.Fecha1, Dialogo.Fecha2
  ACD(FE:&I,&I)
  If EsHabil(Val(FE:&I),'ARG')
     SQL.ADD(" Select O.FechaVto, O.Cliente1, O.Vehiculo1, SUM(CASE O.TipoOp WHEN 'FXCF' THEN O.Cantidad ELSE -O.Cantidad END) Cantidad, O.NrOperacion ")
     SQL.ADD("   From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
     SQL.ADD("  Where O.NrOperacion = OB.NrOperacion ")
     SQL.ADD("    And O.TipoOp in ('FXCF','FXVF') ")
     SQL.ADD("    And O.FechaOp <= '"~IdxDate(Val(FE:&I))~"' ")
     If Dialogo.Radio1=0
        SQL.ADD("    And O.FechaVto = '"~IdxDate(Dialogo.Fecha3)~"' ")
     Else
        If Dialogo.Radio2 = 0
           SQL.ADD("    And O.FechaVto >= '"~IdxDate(Val(FE:&I))~"' ")
        Else
           SQL.ADD("    And O.FechaVto >= '"~IdxDate(Habiles(Val(FE:&I),-1,'ARG'))~"' ")
        EndIf
     EndIf
     If NoVacio(Dialogo.Vehiculo1)
        SQL.ADD(" And O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
     EndIf
     If NoVacio(Dialogo.Cliente1)
        SQL.ADD(" And O.Cliente1 = '"~Dialogo.Cliente1~"' ")
     EndIf
     SQL.ADD(" And OB.NrBit >= 19 ")
     SQL.ADD(" And OB.Valor = '1' ")
     SQL.ADD(" Group By O.FechaVto, O.Cliente1, O.Vehiculo1, O.NrOperacion ")
     SQL.ADD(" Order By O.FechaVto, O.Cliente1, O.Vehiculo1, O.NrOperacion ")
     
     ACN(Z:1,0)
     
     Recorrer SQL
       If Val(Z:1)=0
          ACD(A:FAC,Val(FE:&I))
          ACN(Z:1,1)
       EndIf
       
       If Dialogo.Radio1=0
          ACD(B:FAC,Dialogo.Fecha3)
       Else
          ACD(B:FAC,FBN['FechaVto'])
       EndIf
       
       ACT(CC:FAC,FBN['Cliente1'])
       ACT(C:FAC,BuscarCampo('CLIENTES','RazonSocial','Codigo',val(CC:FAC)))
       ACT(DD:FAC,FBN['Vehiculo1'])
       ACT(D:FAC,BuscarCampo('VEHICULOS','Descripcion','Codigo',val(DD:FAC)))

       ACT(E:FAC,FBN['NrOperacion'])
       ACLO(E:FAC,FBN['NrOperacion'])
       ACN(F:FAC,FBN['Cantidad'])

       *** MTM
       SQL.ADD(" Select Sum(C.Precio1) MTM ")
       SQL.ADD("   From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
       SQL.ADD("  Where C.NrOperacion=O.NrOperacion ")
       SQL.ADD("    and O.TipoOp in ('FXCF','FXVF') ")
       SQL.ADD("    And O.FechaOp <= '"~IdxDate(Val(FE:&I))~"' ")
       SQL.ADD("    And O.FechaVto = '"~IdxDate(Val(B:FAC))~"' ")
       If Dialogo.Radio2 = 0
          SQL.ADD("    And C.Fecha1 = '"~IdxDate(Val(FE:&I))~"' ")
       Else
          SQL.ADD("    And C.Fecha3 = '"~IdxDate(Val(FE:&I))~"' ")
       EndIf
       SQL.ADD(" And O.NrOperacion = '"~val(E:FAC)~"' ")
       SQL.ADD(" And O.Vehiculo1 = '"~val(DD:FAC)~"' ")
       SQL.ADD(" And O.Cliente1 = '"~val(CC:FAC)~"' ")
       
       Recorrer SQL
         DFA
         ACN(G:FAC, FBN['MTM'])
         *ACL(G:FAC, 'MTMDET', Fecha1=Val(B:FAC),Fecha2=Val(FE:&i),Cliente1=val(CC:FAC),Vehiculo1=val(DD:FAC))  
       Proximo   
       FormatoCeldas(F:FAC..G:FAC, Exe('F2')) 
       SCN(TO:1,Val(G:FAC))
     Proximo
     
     IFA
     ACT(A:FAC,'Total '~Val(FE:&I))
     ACN(G:FAC,Val(TO:1))
     FormatoCeldas(F:FAC..G:FAC, Exe('F2'))
     
     AgregarMarco(A:FAC..G:FAC,1,0,Exe('COLOR8'))
     SetFont(A:FAC..G:FAC,2)
     
     SCN(TO:2,Val(G:FAC))
     ACN(TO:1,0)
  EndIf
Proximo

IFA

ACT(A:FAC,'Total General')
ACN(G:FAC,Val(TO:2))
AgregarMarco(A:FAC..G:FAC,1,0,Exe('COLOR'))
FormatoCeldas(G:FAC, Exe('F2'))
SetFont(A:FAC..H:FAC,2)

LimitesVision(H:FAC+1)

ACO(1,8)
ACO(2,8)
ACO(3,25)
ACO(4,15)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
