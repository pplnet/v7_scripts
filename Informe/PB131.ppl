CrearDialogo
  Fecha1:   'D.Fecha'   ;1;1;;;;;;;fsys
  Fecha2:   'H.Fecha'   ;1;2;;;;;;;fsys
  Lista2:   'Bancos'    ; 3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Monedas'   ;-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES WHERE Tipo='MON' ");
  Lista1:   'Vehiculos' ;  ;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio1   :"TipoCta.|Todas|CtaCte";;;;;;;;;1
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(a:3, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:5, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
if Dialogo.Radio1 =1
   ACT(a:2, 'Tipo de Cta: Cta.Cte.')
else
  ACT(a:2, 'Tipo de Cta: Todas')
endif
SetFont(a:2..a:5,2)

ACT(c:6, 'Posicion Bancaria por Cuenta del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(c:6,3)

SetFilaActual(7)

ACT(ea:1,'')
ACT(ba:1,'')
ACT(ca:1,'')

ACN(to:1,0 )
ACN(to:2,0 )
ACN(to:3,0 )
ACN(to:4,0 )
ACN(to:5,0 )
ACN(to:6,0 )

SQL.ADD(" SELECT M.Especie, Saldo Cantidad, 'SALDO' TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA M, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    C.Comitente = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo   = 1 ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   C.TipoCuenta     = 'CC' ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" AND    M.Fecha     <= "~IdxDate2(Dialogo.Fecha1-1)~"  ")
SQL.ADD(" AND    M.Fecha    IN ( SELECT MAX (Fecha) FROM "~DBO~".SALDOSDIA ")
SQL.ADD("                        WHERE  Cuenta  = M.Cuenta ")
SQL.ADD("                        AND    Especie = M.Especie ")
SQL.ADD("                        AND    EnteCustodia = M.EnteCustodia ")
SQL.ADD("                        AND    NrSaldo = 1 ")
SQL.ADD("                        AND    Fecha  <= "~IdxDate2(Dialogo.Fecha1-1)~" )  ")

SQL.ADD(" UNION ALL ")

SQL.ADD(" SELECT M.Especie, SUM(M.Cantidad)*(-1) Cantidad, O.TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
SQL.ADD(" AND    M.Especie     = E.Codigo ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   C.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" GROUP BY M.Especie, O.TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" UNION ALL ")

SQL.ADD(" SELECT M.Especie, SUM(M.Cantidad) Cantidad, O.TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
SQL.ADD(" AND    M.Especie     = E.Codigo ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   C.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" GROUP BY M.Especie, O.TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT M.Especie, SUM(M.Cantidad) Cantidad, O.TipoTr2 TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.NrOperacion = O.NrTrans ")
SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
SQL.ADD(" AND    M.Especie     = E.Codigo ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   C.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    O.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" GROUP BY M.Especie, O.TipoTr2, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero  ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT M.Especie, SUM(M.Cantidad) Cantidad, O.TipoTr2 TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  M.NrOperacion = O.NrTrans ")
SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
SQL.ADD(" AND    M.Especie     = E.Codigo ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1 =1
   SQL.ADD(" AND   C.TipoCuenta     = 'CC' ")
endif
SQL.ADD(" AND    O.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" GROUP BY M.Especie, O.TipoTr2, C.Comitente, E.Nombre, CL.RazonSocial, M.Cuenta, C.Numero ")
SQL.ADD(" ORDER BY 1, 4, 7, 3 ")

Recorrer SQL
 If Not Eqstr(fbn('Especie'), Val(ea:1))
    message('Moneda: '~fbn('Nombre'))

    If Not Eqstr(Val(ea:1),'')
      ACT(a:fac, 'Total Banco -> ')
      ACN(b:fac, SUM(b:Val(fi:1)..b:fac) )
      ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      ACN(e:fac, SUM(e:Val(fi:1)..e:fac) )
      ACN(f:fac, SUM(f:Val(fi:1)..f:fac) )
      ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
      SetFont(a:fac..g:fac,5) 
      FormatoCeldas(b:fac..g:fac,EXE('F2')) 
      AgregarMarco(a:fac..g:fac,0,0,0)
      SCN(to:1, Val(b:fac) )
      SCN(to:2, Val(c:fac) )
      SCN(to:3, Val(d:fac) )
      SCN(to:4, Val(e:fac) )
      SCN(to:5, Val(f:fac) )
      SCN(to:6, Val(g:fac) )

      ifa
      ifa
      ACT(a:fac, 'Total Moneda -> ')
      ACN(b:fac, Val(to:1) )
      ACN(c:fac, Val(to:2) )
      ACN(d:fac, Val(to:3) )
      ACN(e:fac, Val(to:4) )
      ACN(f:fac, Val(to:5) )
      ACN(g:fac, Val(to:6) )
      SetFont(a:fac..g:fac,5) 
      AgregarMarco(a:fac..g:fac,0,0,EXE('COLOR8'))

      ACN(to:1,0 )
      ACN(to:2,0 )
      ACN(to:3,0 )
      ACN(to:4,0 )
      ACN(to:5,0 )
      ACN(to:6,0 )
      ifa
      SaltarHoja
    Endif

    ifa
    ACT(a:fac, 'Moneda: '~fbn('Nombre'))
    SetFont(a:fac,5)
    ifa
    ACT(a:fac, 'Banco // Cuenta ')
    ACT(b:fac, 'Saldo Inicial')
    ACT(b:fac+1, '('~Fecha(Dialogo.Fecha1-1)~')'  )
    ACT(c:fac, 'Ingresos')
    ACT(d:fac, 'Egresos')
    ACT(e:fac, 'Operaciones')
    ACT(e:fac+1, 'Financieras')
    ACT(f:fac, 'Transferencias')
    ACT(g:fac, 'Saldo Final')
    ACT(g:fac+1, '('~Fecha(Dialogo.Fecha2)~')'  )
    AlinearCeldas(b:fac..g:fac+1, 'C')
    SetFont(a:fac..g:fac+1,2)
    AgregarMarco(a:fac..g:fac+1,0,0,EXE('COLOR6'))
    ifa
    ifa
   
    ACT(ba:1, '')
    ACT(ca:1, '')
 Endif

 If Not Eqstr(fbn('Comitente'), Val(ba:1))
    If Not Eqstr(Val(ba:1),'')
      ACT(a:fac, 'Total Banco -> ')
      ACN(b:fac, SUM(b:Val(fi:1)..b:fac) )
      ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      ACN(e:fac, SUM(e:Val(fi:1)..e:fac) )
      ACN(f:fac, SUM(f:Val(fi:1)..f:fac) )
      ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
      SetFont(a:fac..g:fac,5) 
      FormatoCeldas(b:fac..g:fac,EXE('F2')) 
      AgregarMarco(a:fac..g:fac,0,0,0)

      SCN(to:1, Val(b:fac) )
      SCN(to:2, Val(c:fac) )
      SCN(to:3, Val(d:fac) )
      SCN(to:4, Val(e:fac) )
      SCN(to:5, Val(f:fac) )
      SCN(to:6, Val(g:fac) )
      ifa
    Endif
    ifa
    message('Banco: '~fbn('Comitente'))
    ACT(a:fac, fbn('RazonSocial'))
    SetFont(a:fac,5)
    ACT(ca:1,'')
    ifa
    ACN(fi:1, fac)
 Endif

 If Not Eqstr(fbn('Cuenta'), Val(ca:1))
    message('Cuenta: '~fbn('Numero'))
    ACT(a:fac, fbn('Cuenta')~' - '~fbn('Numero'))
    SetFont(a:fac,5)
 Else
    dfa
 Endif


 If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'SALDO')
    SCN(b:fac, fbn('Cantidad'))
 Else
    If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'CRVM')
       SCN(c:fac, fbn('Cantidad'))
       AsignarLink(c:fac, 'APB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=0,Lista4=fbn('Cuenta'),Check1=0,Radio2=2)
    Else
       If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'DEVM')
         SCN(d:fac, fbn('Cantidad'))
         AsignarLink(d:fac, 'APB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=1,Lista4=fbn('Cuenta'),Check1=0,Radio2=2)
       Else
         If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'TRANSF')
           SCN(f:fac, fbn('Cantidad'))
           AsignarLink(f:fac, 'APB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=2,Lista4=fbn('Cuenta'),Check1=0,Radio2=2)
         Else
           SCN(e:fac, fbn('Cantidad'))
           AsignarLink(e:fac, 'APB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=3,Lista4=fbn('Cuenta'),Check1=0,Radio2=2)
         Endif
       Endif
    Endif
 Endif

 ACN(g:fac, SUM(b:fac..f:fac))
 SetFont(b:fac..g:fac,1) 
 FormatoCeldas(b:fac..g:fac,EXE('F2')) 

 ACT(ea:1, fbn('Especie'))
 ACT(ba:1, fbn('Comitente'))
 ACT(ca:1, fbn('Cuenta'))
Proximo

ifa
ACT(a:fac, 'Total Banco -> ')
ACN(b:fac, SUM(b:Val(fi:1)..b:fac) )
ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
ACN(e:fac, SUM(e:Val(fi:1)..e:fac) )
ACN(f:fac, SUM(f:Val(fi:1)..f:fac) )
ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
SetFont(a:fac..g:fac,5) 
FormatoCeldas(b:fac..g:fac,EXE('F2')) 
AgregarMarco(a:fac..g:fac,0,0,0)
SCN(to:1, Val(b:fac) )
SCN(to:2, Val(c:fac) )
SCN(to:3, Val(d:fac) )
SCN(to:4, Val(e:fac) )
SCN(to:5, Val(f:fac) )
SCN(to:6, Val(g:fac) )

ifa
ifa

ACT(a:fac, 'Total Moneda -> ')
ACN(b:fac, Val(to:1) )
ACN(c:fac, Val(to:2) )
ACN(d:fac, Val(to:3) )
ACN(e:fac, Val(to:4) )
ACN(f:fac, Val(to:5) )
ACN(g:fac, Val(to:6) )
SetFont(a:fac..g:fac,5) 
FormatoCeldas(b:fac..g:fac,EXE('F2')) 
AgregarMarco(a:fac..g:fac,0,0,EXE('COLOR8'))


ifa
ifa
ifa

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac,2)

ACO(1,20)
ACO(2,12)
ACO(3,12)
ACO(4,12)
ACO(5,12)
ACO(6,12)
ACO(7,12)

Impresion(1,2)
Impresion(4,1)
LimitesVision(h:fac+2)
SetMargins(0,0,0,2)