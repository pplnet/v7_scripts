Recorrer SQL
 If Not Eqstr(fbn('Especie'), Val(ea:1))
    message('Moneda: '~fbn('Nombre'))
    If Not Eqstr(Val(ea:1),'')
      ACN(b:fac, SUM(b:Val(fi:1)..b:fac) )
      ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      ACN(e:fac, SUM(e:Val(fi:1)..e:fac) )
      ACN(f:fac, SUM(f:Val(fi:1)..f:fac) )
      ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
      SetFont(b:fac..g:fac,5) 
      FormatoCeldas(b:fac..g:fac,EXE('F2')) 
      ifa
      SaltarHoja
    Endif
    ifa
    ACT(a:fac, 'Moneda: '~fbn('Nombre'))
    SetFont(a:fac,5)
    ifa
    ACT(a:fac, 'Banco')
    ACT(b:fac, 'Saldo Inicial')
    ACT(b:fac+1, '('~Fecha(Dialogo.Fecha1-1)~')'  )
    ACT(c:fac,   'Ajustes de')
    ACT(c:fac+1, 'Ingresos (F.Valor)')
    ACT(d:fac,   'Ajustes de')
    ACT(d:fac+1, 'Egresos (F.Valor)')
    ACT(e:fac, 'Ingresos')
    ACT(f:fac, 'Egresos')
    ACT(g:fac, 'Operaciones')
    ACT(g:fac+1, 'Financieras')
    ACT(h:fac, 'Transferencias')
    ACT(i:fac, 'Pendientes')
    ACT(j:fac, 'Estimaciones')
    ACT(k:fac, 'Saldo Final')
    ACT(k:fac+1, '('~Fecha(Dialogo.Fecha2)~')'  )

    AlinearCeldas(b:fac..k:fac+1, 'C')
    SetFont(a:fac..k:fac+1,2)
    AgregarMarco(a:fac..k:fac+1,0,0,EXE('COLOR6'))
    ifa
    ifa
    IFA
    ACN(fi:1, fac)
 Endif
 If Not Eqstr(fbn('Comitente'), Val(ba:1))
   ACT(a:fac, fbn('RazonSocial'))
   AsignarLink(a:fac, 'XPB133', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=Dialogo.Radio1,Lista4='')
   SetFont(a:fac,5)
 Else
   dfa
 Endif

 If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'SALDO')
    SCN(b:fac, fbn('Cantidad'))
 Else
   If Eqstr(fbn('Estado'),'Ejecutado')
     If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'CRVM')
        If fbn('FechaMov')<Dialogo.Fecha1
          SCN(c:fac, fbn('Cantidad'))
          SCN(b:fac, -fbn('Cantidad'))
          AsignarLink(c:fac, 'XAPB1',Fecha1=Dialogo.Fecha1-60, Fecha2=Dialogo.Fecha1,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=0,Lista4='',Check1=1,Radio2=1,Radio3=Dialogo.Radio1)
        Else
          SCN(e:fac, fbn('Cantidad'))
          AsignarLink(e:fac, 'XAPB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=0,Lista4='',Check1=0,Radio2=1,Radio3=Dialogo.Radio1)
        Endif
     Else
        If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'DEVM')
          If fbn('FechaMov')<Dialogo.Fecha1
            SCN(d:fac, fbn('Cantidad'))
            SCN(b:fac, -fbn('Cantidad'))
            AsignarLink(d:fac, 'XAPB1',Fecha1=Dialogo.Fecha1-60, Fecha2=Dialogo.Fecha1,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=1,Lista4='',Check1=1,Radio2=1,Radio3=Dialogo.Radio1)
          Else
            SCN(f:fac, fbn('Cantidad'))
            AsignarLink(f:fac, 'XAPB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=1,Lista4='',Check1=0,Radio2=1,Radio3=Dialogo.Radio1)
          Endif
        Else
          If Eqstr(MIRT(TRIM(fbn('TipoOp'))), 'TRANSF')
            SCN(h:fac, fbn('Cantidad'))
            AsignarLink(h:fac, 'XAPB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=2,Lista4='',Check1=0,Radio2=1,Radio3=Dialogo.Radio1)
          Else
            SCN(g:fac, fbn('Cantidad'))
            AsignarLink(g:fac, 'XAPB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=3,Lista4='',Radio2=1,Radio3=Dialogo.Radio1)
          Endif
        Endif
     Endif
   Else
     If Eqstr(fbn('Estado'),'Pendiente')
       SCN(i:fac, fbn('Cantidad'))
       AsignarLink(i:fac, 'XAPB1',Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2,Lista2=fbn('Comitente'), Lista3=Dialogo.Lista3, Lista1=Dialogo.Lista1,Radio1=4,Lista4='',Check1=0,Radio2=0,Radio3=Dialogo.Radio1)
     Else
       SCN(j:fac, fbn('Cantidad'))
     Endif
   Endif
 Endif

 ACN(k:fac, SUM(b:fac..j:fac))
 SetFont(b:fac..k:fac,1) 
 FormatoCeldas(b:fac..k:fac,EXE('F2')) 

 ACT(ea:1, fbn('Especie'))
 ACT(ba:1, fbn('Comitente'))

