ACT(bc:FAC+2, 'ARG')

ACT(ba:FAC+3, 'USD')
ACT(bb:FAC+3, 'CAB')
ACT(bc:FAC+3, 'EXT')

recorrer&i 2,13
  recorrer&j 1,4
    ACN(y:1, 0)
    ACN(y:1, Query("Select Count(*) from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(aa:&i)~"' and MonedaCpra='"~Val(ac:&i)~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(ad:&i)~"','') and JurisCpra='"~Val(ae:&i)~"' and MonedaVta='"~Val(ba:&j)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(bb:&j)~"','') and JurisVta='"~Val(bc:&j)~"' "))
    if Val(y:1)>0
      ACN((33+4*(&j-1)):&i, Val(y:1))
      ACN((33+4*(&j-1))+1:&i, Query("Select Top(1) DiasParking from "~DBO~".PLAZOSPARKING where MonedaEmision='"~Val(aa:&i)~"' and MonedaCpra='"~Val(ac:&i)~"' and IsNull(TipoUSDCpra,'')=IsNull('"~Val(ad:&i)~"','') and JurisCpra='"~Val(ae:&i)~"' and MonedaVta='"~Val(ba:&j)~"' and IsnUll(TipoUSDVta,'')=IsnUll('"~Val(bb:&j)~"','') and JurisVta='"~Val(bc:&j)~"' "))
*      ACD((33+4*(&j-1))+2:&i, Habiles(Dialogo.Fecha1,-Val((33+4*(&j-1))+1:&i),'ARG'))
    endif
    ACD((33+4*(&j-1))+2:&i, Habiles(Dialogo.Fecha1,-Val((33+4*(&j-1))+1:&i),'ARG'))
  proximo
proximo

ACT(bg:FAC, 'Saldo Hoy')

