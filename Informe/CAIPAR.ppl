ACT(a:fac+16, '   Disp. P/Neg Vs USD Cable Exterior')
ACT(a:fac+17, '   Disp. P/Neg Vs USD Cable LM')
ACT(a:fac+18, '   Disp. P/Neg Vs USD MEP LM')
ACT(a:fac+20, 'SubTotal P/Neg Vs USD')
ACT(a:fac+22, 'Total Posicion')

SetFont(a:fac..a:fac+22,2)

SQL.ADD("Select Distinct Codigo from "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo in ( ")
SQL.ADD("    SELECT Especie ")
SQL.ADD("      FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("     WHERE (S1.NrSaldo>130 and S1.NrSaldo<140)  ")
IF NoVacio(Dialogo.Especie1)
  SQL.ADD("     and S1.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
*SQL.ADD("       and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and S1.Cliente      = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and S1.Saldo <> 0 ")
SQL.ADD("       and S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                      FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                     WHERE IsNull(S2.Cliente,'')      = IsNull(S1.Cliente,'') ")
SQL.ADD("                       and IsNull(S2.EnteCustodia,'') = IsNull(S1.EnteCustodia,'') ")
SQL.ADD("                       and IsNull(S2.Especie,'') = IsNull(S1.Especie,'')  ")
SQL.ADD("                       and IsNull(S2.Mercado,'') = IsNull(S1.Mercado,'') ")
SQL.ADD("                       and S2.NrSaldo = S1.NrSaldo ")
SQL.ADD("                       and S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' ) ")

SQL.ADD("    UNION ")

SQL.ADD("    SELECT Especie ")
SQL.ADD("      FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD("     WHERE (NrSaldo>130 and NrSaldo<140)  ")
IF NoVacio(Dialogo.Especie1)
  SQL.ADD("     and Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD("       and Cliente      = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")

*SQL.ADD("    UNION ")
*
*SQL.ADD("    SELECT Especie ")
*SQL.ADD("      FROM "~DBO~".MOVPENDIENTES ")
*SQL.ADD("     WHERE (NrSaldo>130 and NrSaldo<140)  ")
*IF NoVacio(Dialogo.Especie1)
*  SQL.ADD("     and Especie = '"~Dialogo.Especie1~"' ")
*ENDIF
*SQL.ADD("       and Cliente      = '"~Dialogo.Vehiculo1~"' ")
*SQL.ADD("       and FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' ")

SQL.ADD("  ) ")
watch(SQL.BATCH())

ACN(x:1,1)
Recorrer SQL
  DFA
  SCN(x:1, 1)
  ACT(Val(x:1):FAC, fbn('Codigo'))
  ACN(Val(x:1):FAC+1, 0)
  Message('Especie '~fbn('Codigo')~' - Columna '~FStr(Val(x:1),1,0))
  * Moneda de Emision
  ACT(y:2, BuscarCampo('ESPECIES','MonedaEmision','Codigo',fbn('Codigo')))
  
  * Saldo Inicial
  SQL.ADD("    SELECT * ")
  SQL.ADD("      FROM "~DBO~".SALDOSDIA S1 ")
  SQL.ADD("     WHERE (S1.NrSaldo>130 and S1.NrSaldo<140)  ")
  SQL.ADD("       and S1.Especie = '"~fbn('Codigo')~"' ")
*  SQL.ADD("       and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("       and S1.Cliente      = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("       and S1.Saldo <> 0 ")
  SQL.ADD("       and S1.Fecha = (SELECT MAX(S2.Fecha) ")
  SQL.ADD("                      FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
  SQL.ADD("                     WHERE IsNull(S2.Cliente,'')      = IsNull(S1.Cliente,'') ")
  SQL.ADD("                       and IsNull(S2.EnteCustodia,'') = IsNull(S1.EnteCustodia,'') ")
  SQL.ADD("                       and IsNull(S2.Especie,'') = IsNull(S1.Especie,'')  ")
  SQL.ADD("                       and IsNull(S2.Mercado,'') = IsNull(S1.Mercado,'') ")
  SQL.ADD("                       and S2.NrSaldo = S1.NrSaldo ")
  SQL.ADD("                       and S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' ) ")
  Recorrer SQL
    DFA
    SCN(x:2, 1)
    ACN(ca:Val(x:2), Val(x:1))
    ACT(cb:Val(x:2), fbn('Especie'))
    ACT(cc:Val(x:2), fbn('Cliente'))
    ACN(cd:Val(x:2), fbn('NrSaldo'))
    ACN(ce:Val(x:2), fbn('Saldo'))
    ACD(cf:Val(x:2), fbn('Fecha'))
    if fbn('NrSaldo')=131
      ACT(cg:Val(x:2), 'ARP')
    endif
    if fbn('NrSaldo')=132
      ACT(cg:Val(x:2), 'USD')
      ACT(ch:Val(x:2), 'MEP')
    endif
    if fbn('NrSaldo')=133
      ACT(cg:Val(x:2), 'USD')
      ACT(ch:Val(x:2), 'CAB')
    endif
    ACT(ci:Val(x:2), fbn('Mercado'))
    ACT(cj:Val(x:2), Val(y:2))

    SCN(Val(x:1):FAC+1, fbn('Saldo'))
  Proximo  
  
  * Movs del dia
  SQL.ADD("    SELECT * ")
  SQL.ADD("      FROM "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("     WHERE (NrSaldo>130 and NrSaldo<140)  ")
  SQL.ADD("       and Especie = '"~fbn('Codigo')~"' ")
  SQL.ADD("       and Cliente      = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("       and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
  Recorrer SQL
    DFA
    SCN(x:3, 1)
    ACN(da:Val(x:3), Val(x:1))
    ACT(db:Val(x:3), fbn('Especie'))
    ACT(dc:Val(x:3), fbn('Cliente'))
    ACN(dd:Val(x:3), fbn('NrSaldo'))
    ACN(de:Val(x:3), fbn('Cantidad'))
    ACD(df:Val(x:3), fbn('FechaMov'))
    if fbn('NrSaldo')=131
      ACT(dg:Val(x:3), 'ARP')
    endif
    if fbn('NrSaldo')=132
      ACT(dg:Val(x:3), 'USD')
      ACT(dh:Val(x:3), 'MEP')
    endif
    if fbn('NrSaldo')=133
      ACT(dg:Val(x:3), 'USD')
      ACT(dh:Val(x:3), 'CAB')
    endif
    ACT(di:Val(x:3), fbn('Mercado'))
    ACT(dj:Val(x:3), Val(y:2))
    ACT(dk:Val(x:3), fbn('NrOperacion'))
    
    if fbn('Cantidad')> 0
      * Compras del dia
      if fbn('NrSaldo')=131
        * ARP
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 9)
        endif
      endif
      if fbn('NrSaldo')=133
        * USD Cable
        if EqStr(fbn('Mercado'),'EXT')
          ACN(dl:Val(x:3), 10)
        endif
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 11)
        endif
      endif
      if fbn('NrSaldo')=132
        * USD MEP
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 12)
        endif
      endif
      if Val(dl:Val(x:3))=0
        ACT(dm:Val(x:3), 'Error')
      else
        * Ubico fila
        SCN(Val(x:1):FAC+Val(dl:Val(x:3)), fbn('Cantidad'))
      endif
    else  
      * Ventas del dia
      if fbn('NrSaldo')=131
        * ARP
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 4)
        endif
      endif
      if fbn('NrSaldo')=133
        * USD Cable
        if EqStr(fbn('Mercado'),'EXT')
          ACN(dl:Val(x:3), 5)
        endif
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 6)
        endif
      endif
      if fbn('NrSaldo')=132
        * USD MEP
        if EqStr(fbn('Mercado'),'ARG')
          ACN(dl:Val(x:3), 7)
        endif
      endif
      if Val(dl:Val(x:3))=0
        ACT(dm:Val(x:3), 'Error')
      else
        * Ubico fila
        SCN(Val(x:1):FAC+Val(dl:Val(x:3)), fbn('Cantidad'))
      endif
    endif
  proximo
    
  * Calculos de Disponiobles
  BorrarCeldas(bg:2..bz:20)

  if EqStr(Val(y:2),'ARP')
    ACN(bx:1, 0)
  else
    ACN(bx:1, 6)
  endif
  recorrer&i 2,7
*    ACN(bg:&i, SaldoC(Vehiculo,especie,,,,Mercado,,,NrSaldo,Fecha))
    ACN(bg:&i, SaldoC(Dialogo.Vehiculo1,fbn('Codigo'),,,,Val(ae:&i+Val(bx:1)),,,Val(ab:&i+Val(bx:1)),Dialogo.Fecha1))
    recorrer&j 1,4
      ACD((58+(&j*3)):&i, Val((31+(&j*4)):&i+Val(bx:1)))
      ACN((59+(&j*3)):&i, SaldoC(Dialogo.Vehiculo1,fbn('Codigo'),,,,Val(ae:&i+Val(bx:1)),,,Val(ab:&i+Val(bx:1)),Val((58+(&j*3)):&i)))
      if Val((59+(&j*3)):&i)>Val(bg:&i)
        ACN((59+(&j*3)):&i, Val(bg:&i))
      endif
    proximo
    ACN(bt:&i, Val(bm:&i)+Val(bp:&i)+Val(bs:&i))
    if Val(bt:&i)>Val(bg:&i)
      ACN(bt:&i, Val(bg:&i))
    endif
    ACN(bu:&i, Val(bg:&i)-Val(bt:&i))
  proximo


  ACN(bj:9, Sum(bj:2..bj:7))
  ACN(bm:9, Sum(bm:2..bm:7))
  ACN(bp:9, Sum(bp:2..bp:7))
  ACN(bs:9, Sum(bs:2..bs:7))
  * Tot USD
  ACN(bt:9, Sum(bt:2..bt:7))
  * Solo ARP
  ACN(bu:9, Sum(bu:2..bu:7))

  if Val(bu:9)>0
    ACN(Val(x:1):FAC+15, Val(bu:9))
  endif
  if Val(bs:9)>0
    ACN(Val(x:1):FAC+16, Val(bs:9))
  endif
  if Val(bp:9)>0
    ACN(Val(x:1):FAC+17, Val(bp:9))  
  endif
  if Val(bm:9)>0
    ACN(Val(x:1):FAC+18, Val(bm:9))  
  endif
  
  * Total disponible Vs USD
  ACN(Val(x:1):FAC+20, 0)
  if Val(bt:9)>0
    ACN(Val(x:1):FAC+20, Val(bt:9))
  endif

  * Total Posicion
  ACN(Val(x:1):FAC+22, Val(Val(x:1):FAC+1)+Sum(Val(x:1):FAC+4..Val(x:1):FAC+12))

  AgregarMarco(Val(x:1):FAC..Val(x:1):FAC,3,0)
  AgregarMarco(Val(x:1):FAC+1..Val(x:1):FAC+21,1,0)
  AgregarMarco(Val(x:1):FAC+1..Val(x:1):FAC+1,2,0)
  AgregarMarco(Val(x:1):FAC+1..Val(x:1):FAC+1,1,0)
  AgregarMarco(Val(x:1):FAC+4..Val(x:1):FAC+8,1,0)
  AgregarMarco(Val(x:1):FAC+14..Val(x:1):FAC+19,1,0)
  AgregarMarco(Val(x:1):FAC+22..Val(x:1):FAC+22,2,0)
  AlinearCeldas(Val(x:1):FAC,'C')
  SetFont(Val(x:1):FAC,2)
  
  recorrer&i 2,9
    if &i=2
      ACT(ef:(Val(x:1)-2)*10+&i-1, Val(Val(x:1):FAC))
    endif
    ACT(ef:(Val(x:1)-2)*10+&i, Val(bf:&i))
    if &i<8
      ACN(eg:(Val(x:1)-2)*10+&i, Val(bg:&i))
      ACD(ei:(Val(x:1)-2)*10+&i, Val(bi:&i))
      ACN(ej:(Val(x:1)-2)*10+&i, Val(bj:&i))
      ACD(el:(Val(x:1)-2)*10+&i, Val(bl:&i))
      ACN(em:(Val(x:1)-2)*10+&i, Val(bm:&i))
      ACD(eo:(Val(x:1)-2)*10+&i, Val(bo:&i))
      ACN(ep:(Val(x:1)-2)*10+&i, Val(bp:&i))
      ACD(er:(Val(x:1)-2)*10+&i, Val(br:&i))
      ACN(es:(Val(x:1)-2)*10+&i, Val(bs:&i))
      ACN(et:(Val(x:1)-2)*10+&i, Val(bt:&i))
      ACN(eu:(Val(x:1)-2)*10+&i, Val(bu:&i))
    endif
    if &i=9
      ACN(ej:(Val(x:1)-2)*10+&i, Val(bj:&i))
      ACN(em:(Val(x:1)-2)*10+&i, Val(bm:&i))
      ACN(ep:(Val(x:1)-2)*10+&i, Val(bp:&i))
      ACN(es:(Val(x:1)-2)*10+&i, Val(bs:&i))
      ACN(et:(Val(x:1)-2)*10+&i, Val(bt:&i))
      ACN(eu:(Val(x:1)-2)*10+&i, Val(bu:&i))
      ACN(x:4, (Val(x:1)-2)*10+&i)
    endif
  proximo
    
Proximo

ACT(Val(x:1):4, 'Fecha Sys: '~Fecha(Fsys))

SetFilaActual(FAC+24)

*FormatoCeldas(j:11..j:Val(fi1),Exe('F8'))
if Val(x:1)=1
  ACT(a:FAC, 'No exiten especies con saldos de Parking')
  SetFilaActual(FAC+2)
  * Para forzar el LimiteVision
  ACN(x:1, 3)
else
  FormatoCeldas(2:FAC-24..Val(x:1):FAC-2,Exe('F2'))
  recorrer&i 2,Val(x:1)
    ACO(&i, 14)
  proximo
  FormatoCeldas(bg:2..bu:9,Exe('F2'))
  if Val(x:4)>1
    FormatoCeldas(eg:2..eu:Val(x:4),Exe('F2'))
  endif
endif

ACT(a:FAC, 'Fin del Listado ')
ACO(1, 20)
ACO(58, 15)
ACO(59, 10)
ACO(62, 10)
ACO(65, 10)
ACO(68, 10)
ACO(71, 10)
ACO(72, 10)
ACO(73, 10)
ACO(136, 15)
ACO(150, 10)
ACO(151, 10)

ACT(z:2, Hora(Ahora))

LimitesVision(Val(x:1):FAC)
