CrearDialogo
  Fecha1   : 'Fecha Futuro'   ;1;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha Desde invalida';NO;FSys;
  Fecha2   : 'Fecha Hoy'      ;2;1;;;;EsHabil(Dialogo.Fecha2,'ARG') y Dialogo.Fecha2>0;'Fecha Hasta invalida';NO;FSys;
  Vehiculo1: 'Vehiculo'       ;3;1;;;;
  Cliente1 : 'Cliente'        ;4;1;;;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

ACT(A:2,'Detalle MTM Diario')
SetFont(A:2,1)

SetFilaActual(4)

ACT(A:FAC, 'Fecha:')
ACT(B:FAC, Dialogo.Fecha2)

ACT(A:FAC+1,'Fecha Futuro: ')
If Dialogo.Fecha1>0
   ACT(B:FAC+1, Dialogo.Fecha1)
Else
   ACT(B:FAC+1,'Todos')
EndIf

ACT(A:FAC+2,'Cliente: ')
If NoVacio (Dialogo.Cliente1)
   ACT(B:FAC+2, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(B:FAC+2,'Todos')
EndIf

ACT(A:FAC+3,'Vehiculo: ')
If NoVacio (Dialogo.Vehiculo1)
   ACT(B:FAC+3, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
   ACT(B:FAC+3,'Todos')
EndIf

SetFont(A:FAC..B:FAC+3,2)

SetFilaActual(9)

ACT(A:FAC,'Operacion')
ACT(B:FAC,'TipoOp')
ACT(C:FAC,'Vehiculo')
ACT(D:FAC,'Cliente')
ACT(E:FAC,'FechaOp')
ACT(F:FAC,'FechaFut')
ACT(G:FAC,'Precio Hoy')
ACT(H:FAC,'Precio Ayer')
ACT(I:FAC,'Cantidad')
ACT(J:FAC,'MTM')
ACT(K:FAC,'MTM x OP')
AlinearCeldas(A:FAC..K:FAC,'C')
AgregarMarco(A:FAC..K:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..K:FAC,2)

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.FechaOp, O.FechaVto, O.Cliente1, CASE O.TipoOp WHEN 'FXCF' THEN O.Cantidad ELSE -O.Cantidad END Cantidad, C.Precio1, C.Cotizacion1, C.Cotizacion2 ")
SQL.ADD(" ,O.Vehiculo1, O.Cliente1 ")
SQL.ADD("   from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD("  Where C.NrOperacion=O.NrOperacion ")
SQL.ADD("    and O.TipoOp in ('FXCF','FXVF') ")
SQL.ADD("    And O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If Dialogo.Fecha1>0
   SQL.ADD("    And O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
Else
   SQL.ADD("    And O.FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' ")
EndIf
SQL.ADD("    And C.Fecha1 = '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" And O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" And O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD(" Order by O.FechaOp, O.Vehiculo1, O.Cliente1, O.FechaVto ")
ACN(Z:1,FAC+1)
  
Recorrer SQL
  ACT(A:FAC,FBN['NrOperacion'])
  ACLO(A:FAC,FBN['NrOperacion'])
  ACT(B:FAC,FBN['TipoOp'])
  ACT(C:FAC,BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Vehiculo1']))
  ACT(D:FAC,BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']))
  ACD(E:FAC,FBN['FechaOp'])
  ACD(F:FAC,FBN['FechaVto'])
  ACN(G:FAC,FBN['Cotizacion1'])
  ACN(H:FAC,FBN['Cotizacion2'])
  ACN(I:FAC,FBN['Cantidad'])
  ACN(J:FAC,FBN['Precio1'])
  ACT(K:FAC,FBN['NrOperacion'])

  *ACL(K:FAC, 'MTMCUO', NrOperacion1=Val(A:FAC))       
  LinkearHoja ('MTMCUO',1, NrOperacion1=Val(A:FAC))
  ACN(K:FAC,LinkH(1,TO:1))
  CerrarHoja('MTMCUO',1, NrOperacion1=Val(A:FAC) )   
  ACL(K:FAC, 'MTMCUO', NrOperacion1=Val(A:FAC))
  
  SCN(TO:1,Val(I:FAC))
  SCN(TO:2,Val(J:FAC))
Proximo

FormatoCeldas(G:Val(Z:1)..K:FAC, Exe('F8'))
FormatoCeldas(G:Val(Z:1)..K:FAC, Exe('F2'))
SetFont(A:Val(Z:1)..F:FAC,3)
  
IFA
ACT(A:FAC,'Total')
ACN(I:FAC,Val(TO:1))
ACN(J:FAC,Val(TO:2))
FormatoCeldas(I:FAC..K:FAC, Exe('F2'))
AgregarMarco(A:FAC..K:FAC,1,0,Exe('COLOR8'))
SetFont(A:FAC..K:FAC,2)

LimitesVision(K:FAC+1)


ACO(1,10)
ACO(2,8)
ACO(3,15)
ACO(4,15)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)
ACO(11,10)
