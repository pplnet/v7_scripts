CrearDialogo
   Fecha1  : 'Desde';1;1;;;;;;;;FSYS-1
   Fecha2  : 'Hasta';2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;FSYS-1
   Radio3  : 'Origen:|Todos|Activo|Pasivo';3;1;;NO;;;;;0;
   Radio6  : 'Clientes:|Todos|Vinculados|Terceros';4;1;;;;;;;0;

   Radio1  : 'Terc y Act|Todos|Dep.Pla|Cta.Cte';5;1;;NO;;;;;;0
   Radio4  : 'Terc y Pas|Todos|Ob.Neg|Com.Ext|Fin.Lo|Fin.Ex|C.C.';;;;NO;;;;;;0
   Radio2  : 'Vinc y Act|Todos|C.C.Vinc|C.C.Div|Co.Vinc|Co.Div';;;;NO;;;;;;0
   Radio5  : 'Vinc y Pas|Todos|C.C.Vinc|C.C.Div|Pr.Vinc|Pr.Div';;;;NO;;;;;;0

   Radio14 : 'Tipo Operac:|Todas|V.Simple|V.Mult.|C.Ahorro';9;1;;NO;;;;;0;
   Especie1: 'Moneda:';12;1;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4  : 'Imp.Detallado' ;13;1;;;;;;;;0;
   Check1  : "Graba"         ;;;;Dialogo.Radio1+Dialogo.Radio2+Dialogo.Radio3+Dialogo.Radio4+Dialogo.Radio5+Dialogo.Radio10+Dialogo.Radio7=0 y Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,NO,'ARG');Dialogo.Radio1+Dialogo.Radio2+Dialogo.Radio3+Dialogo.Radio4+Dialogo.Radio5+Dialogo.Radio10+Dialogo.Radio7=0 y Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI);;;;0
   Radio8  : 'Informacion:|Periodo|AHEAD';1;2;;;;;;;0;
   Radio10 : 'Operaciones:|Todas|A Tasa|Securities';2;2;;NO;;;;;0;
   Radio12 : 'Vehiculos:|Todos|Algunos';3;2;;;;;;;0;
   Radio7  : 'Especies:|Todas|Algunas';4;2;;;;;;;0;

   Lista1  : 'Vehiculo'     ;10;2;;Dialogo.Radio12=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Lista2  : 'Especies'     ;11;1;;Dialogo.Radio7=1  ;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Lista3  : 'Clientes'     ;05;2;;Dialogo.Radio6<>0 ;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

* Datos del encabezado
(.'CORECABA'.)

* Nombre de Filas 
SetFilaActual(9)

ACT(a:fac,'VEHICULO')
ACT(b:fac,'ACTIVOS')
ACT(d:fac,'PASIVOS')
ACT(F:fac,'TOTAL')

ACT(b:fac+1,'Cap.Prom')
ACT(c:fac+1,'Tasa')
ACT(d:fac+1,'Cap.Prom')
ACT(e:fac+1,'Tasa')
ACT(f:fac+1,'Cap.Prom')
ACT(g:fac+1,'Tasa')

AgregarMarco(a:fac..g:fac+1,1,0,EXE('COLOR'))
AgregarMarco(a:fac..a:fac+1,1)
AgregarMarco(b:fac..c:fac+1,1)
AgregarMarco(d:fac..e:fac+1,1)
SetFont(a:fac..g:fac+1, 2)

SQL.ADD("SELECT Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(val(zz6))
   SQL.ADD(" Where Codigo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD(" ORDER BY Codigo ")

SetFilaActual(10)
Recorrer SQL  
  ACT(a:fac, fbn('Codigo'))

  *-- Operaciones Activas de  Terceros
  If Dialogo.Radio6=0 o Dialogo.Radio6=2 
     LinkearHoja('CORENB',40,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=1,Radio1=0,Radio4=-1,Radio2=-1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     * Capital
     ACN(i:fac, LinkH(40,  yv:1))
     * Tasa
     ACN(j:fac, LinkH(40, yu:1))
     * Plazo
     ACN(k:fac, LinkH(40, yw:1))
     *CerrarHoja('CORENB',40,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=1,Radio1=0,Radio4=-1,Radio2=-1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     *CerrarLink(40)
  Endif
  
  *-- Operaciones Activas de  Vinculados
  If Dialogo.Radio6=0 o Dialogo.Radio6=1
     LinkearHoja('CORENB',41,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=0,Radio1=-1,Radio4=-1,Radio2=0 ,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     * Capital
     ACN(l:fac, LinkH(41,  yv:1))
     * Tasa
     ACN(m:fac, LinkH(41, yu:1))
     * Plazo
     ACN(n:fac, LinkH(41, yw:1))
     *CerrarHoja('CORENB',41,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=0,Radio1=-1,Radio4=-1,Radio2=0 ,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     * CerrarLink(41)
  Endif
  
  ** Total de Activas
  * capital promedio
  ACN(b:fac, Val(i:fac)+Val(l:fac)  )
  SCN(xb1, Val(b:fac))
  * Tasa
  if Dialogo.Radio8 = 0
    ACN(c:fac, (Val(i:fac)*Val(j:fac)+Val(l:fac)*Val(m:fac)) / Val(b:fac)  )
    SCN(xc1, (Val(i:fac)*Val(j:fac)+Val(l:fac)*Val(m:fac)) )
  else
    ACN(c:fac, (Val(i:fac)*Val(k:fac)*Val(j:fac)+Val(l:fac)*Val(n:fac)*Val(m:fac)) / (Val(i:fac)*Val(k:fac)+Val(l:fac)*Val(n:fac)) )
    SCN(xc1, (Val(i:fac)*Val(k:fac)*Val(j:fac)+Val(l:fac)*Val(n:fac)*Val(m:fac)))
  endif
  * Plazo
  ACN(ac:fac, (Val(i:fac)*Val(k:fac)+Val(l:fac)*Val(n:fac)) / Val(b:fac)  )
  SCN(ac1, (Val(i:fac)*Val(k:fac)+Val(l:fac)*Val(n:fac)) )
  
  *-- Operaciones Pasivas de  Terceros
  If Dialogo.Radio6=0 o Dialogo.Radio6=2
    LinkearHoja('CORENB',42,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=1,Radio1=-1,Radio4=0 ,Radio2=-1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    * Capital
    ACN(o:fac, LinkH(42,  yv:1))
    * Tasa
    ACN(p:fac, LinkH(42, yu:1))
    * Plazo
    ACN(q:fac, LinkH(42, yw:1))
    *CerrarHoja('CORENB',42,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=1,Radio1=-1,Radio4=0 ,Radio2=-1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(42)
  Endif
  
  *-- Operaciones Pasivas de  Vinculados
  If Dialogo.Radio6=0 o Dialogo.Radio6=1
     LinkearHoja('CORENB',43,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=0,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=0,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     * Capital
     ACN(r:fac, LinkH(43,  yv:1))
     * Tasa
     ACN(s:fac, LinkH(43, yu:1))
     * Plazo
     ACN(t:fac, LinkH(43, yw:1))
     *CerrarHoja('CORENB',43,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=0,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=0,Radio14=0,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio8=Dialogo.Radio8,Radio10=0,Radio12=Dialogo.Radio12,Radio7=Dialogo.Radio7,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     *CerrarLink(43)
  Endif
  
  ** Total de Pasivas
  * capital promedio
  ACN(d:fac, Val(o:fac)+Val(r:fac)  )
  SCN(xd1, Val(d:fac))
  * Tasa
  if Dialogo.Radio8 = 0
    ACN(e:fac, (Val(o:fac)*Val(p:fac)+Val(r:fac)*Val(s:fac)) / Val(d:fac)  )
    SCN(xe1, (Val(o:fac)*Val(p:fac)+Val(r:fac)*Val(s:fac)) )
  else
    ACN(e:fac, (Val(o:fac)*Val(q:fac)*Val(p:fac)+Val(r:fac)*Val(t:fac)*Val(s:fac)) / (Val(o:fac)*Val(q:fac)+Val(r:fac)*Val(t:fac)) )
    SCN(xe1, (Val(o:fac)*Val(q:fac)*Val(p:fac)+Val(r:fac)*Val(t:fac)*Val(s:fac)))
  endif
  * plazo
  ACN(ae:fac, (Val(o:fac)*Val(q:fac)+Val(r:fac)*Val(t:fac)) / Val(d:fac)  )
  SCN(ae1, (Val(o:fac)*Val(q:fac)+Val(r:fac)*Val(t:fac)) )
  
  *** Total Neto
  * capital promedio
  ACN(f:fac, Val(b:fac)-Val(d:fac)  )
  SCN(xf1, Val(f:fac))
  * Tasa
  if Dialogo.Radio8 = 0
    ACN(g:fac, (Val(b:fac)*Val(c:fac)-Val(d:fac)*Val(e:fac)) / Val(f:fac)  )
    SCN(xg1, (Val(b:fac)*Val(c:fac)-Val(d:fac)*Val(e:fac))  )
  else
    ACN(g:fac, (Val(b:fac)*Val(ac:fac)*Val(c:fac)-Val(d:fac)*Val(ae:fac)*Val(e:fac)) / (Val(f:fac)*Val(q:fac)+Val(r:fac)*Val(t:fac)) )
    SCN(xg1, (Val(b:fac)*Val(ac:fac)*Val(c:fac)-Val(d:fac)*Val(ae:fac)*Val(e:fac)) )
  endif
  * plazo
  ACN(ag:fac, (Val(b:fac)*Val(ac:fac)-Val(d:fac)*Val(ae:fac)) / Val(f:fac)  )
  SCN(ag1, (Val(b:fac)*Val(ac:fac)-Val(d:fac)*Val(ae:fac)) )
Proximo


* Consolidados 
SetFont(a:11..g:fac, 1)
ifa
ACT(a:fac, 'CONSOLIDADO')
ACN(b:fac, Val(xb1))
if Dialogo.Radio8 = 0
  ACN(c:fac,Val(xc1)/Val(xb1))
else
  ACN(c:fac,Val(xc1)/Val(ac1))
endif
ACN(d:fac, Val(xd1))
if Dialogo.Radio8 = 0
  ACN(e:fac,Val(xe1)/Val(xd1))
else
 ACN(e:fac,Val(xe1)/Val(ae1))
endif
ACN(f:fac,Val(xf1))
if Dialogo.Radio8 = 0
  ACN(g:fac,Val(xg1)/Val(xf1))
else
  ACN(g:fac,Val(xg1)/Val(ag1))
endif

AgregarMarco(a:fac..g:fac,1,0,EXE('COLOR'))
AgregarMarco(a:fac..a:fac,1)
AgregarMarco(b:fac..c:fac,1)
AgregarMarco(d:fac..e:fac,1)
SetFont(a:fac..g:fac, 2)
ACO(1,9)
LimitesVision(h:fac+2)

if Dialogo.Check1=1
   ACT(z1,Dialogo.Lista1)
   If Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1, SI)
      ACT(z1,val(z1)~'/'~Dialogo.Fecha1)
   EndIf
   ACT(z1,val(z1)~'/'~Dialogo.Especie1~'/'~Dialogo.Radio6~'/'~Dialogo.Radio3)
   GrabarPMG('CORENA', val(z1))
Endif
Impresion(1,2)

