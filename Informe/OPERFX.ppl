*ModoReproceso(ConDialogo)

if Vacio(UsrVehiculos(UsuarioActivo))
  ACT(V:1, SQLSET("Select VH.Codigo from "~DBO~".VEHICULOS VH Where (VH.Status='HAB' or VH.Status Is Null or VH.Status='') order by VH.Codigo "))
else
  ACT(V:1, SQLSET("Select VH.Codigo From "~DBO~".USRVEHICULO UV, "~DBO~".VEHICULOS VH Where UV.Codigo = '"~UsuarioActivo~"' AND UV.Vehiculo = VH.Codigo AND (VH.Status='HAB' or VH.Status Is Null or VH.Status='') order by VH.Codigo ") )
endif

CrearDialogo
   Fecha1     : 'F.Desde'          ; ; ;;;;Dialogo.Fecha1<=Fsys;'Fecha Desde Invalida';NO;PriDeMes(Fsys,SI)
   Fecha2     : 'F.Hasta'          ; ; ;;;;Dialogo.Fecha2<=Fsys Y Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys
   Especie1   : 'Moneda'           ; ; ;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Debe ingresar una moneda';NO;'USD';
   Lista1     : 'Vehiculo'         ;1;2;;;;;;;;;Val(V:1)
   Radio1     : 'Consolidado|NO|SI'; ; ;;;;;;;0 
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,9,B")
CrearFont(4,"Arial,12,B")

ACT(s:1, 'ENERO')
ACT(s:2, 'FEBRERO')
ACT(s:3, 'MARZO')
ACT(s:4, 'ABRIL')
ACT(s:5, 'MAYO')
ACT(s:6, 'JUNIO')
ACT(s:7, 'JULIO')
ACT(s:8, 'AGOSTO')
ACT(s:9, 'SETIEMBRE')
ACT(s:10, 'OCTUBRE')
ACT(s:11, 'NOVIEMBRE')
ACT(s:12, 'DICIEMBRE')

SetFilaActual(1)
ACT(A:fac, 'Operaciones de FX No Comerciales')
SetFont(A:fac, 4)

SetFilaActual(fac+2)
ACT(A:fac,'Desde: '~Dialogo.Fecha1)

IFA
ACT(A:fac,'Hasta: '~Dialogo.Fecha2)

IFA
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC, 'Moneda : '~Dialogo.Especie1 )
else
  ACT(a:FAC, 'Moneda : Todos')
endif

IFA
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC, 'Vehiculos: '~Dialogo.Lista1)    
else 
  ACT(A:fac, 'Vehiculos: Todos')
endif

IFA
if Dialogo.Radio1=0
  ACT(a:FAC, 'Consolidado: NO')
else
  ACT(a:FAC, 'Consolidado: SI')
endif

IFA
ACN(x:1, COTIZACIONC(Dialogo.Especie1,,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')))
ACT(a:FAC, 'Spot: '~FStr(Val(x:1),1,4))
SetFont(A:fac-5..A:fac, 2)

* Vehiculos a listar
If NoVacio(Dialogo.Lista1)
  ACT(V:2, Dialogo.Lista1)
Else
  ACT(V:2, Val(v:1))
EndIf

* determino periodos a mostrar
ACT(aa:1, 'Fecha Inicio')
ACT(ab:1, 'Fecha Fin')
ACT(ac:1, 'Prim.Linea')
ACT(ad:1, 'Ult.Linea')
ACT(ae:1, 'Cpras')
ACT(af:1, 'Cant. Cpra')
ACT(ag:1, 'Monto Cpra')
ACT(ah:1, 'Vtas')
ACT(ai:1, 'Cant. Vta')
ACT(aj:1, 'Monto Vta')
SetFont(aa:1..az:1,2)

ACN(z:1, 2)
ACD(aa:Val(z:1), Dialogo.Fecha1)
ACD(ab:Val(z:1), FinDeMes(Dialogo.Fecha1,SI))
recorrer&i Dialogo.Fecha1,Dialogo.Fecha2
  if &i>Val(ab:Val(z:1))
    SCN(z:1, 1)
    ACD(aa:Val(z:1), &i)
    ACD(ab:Val(z:1), FinDeMes(&i,SI))
  endif
  if Dialogo.Fecha2<=Val(ab:Val(z:1))
    ACD(ab:Val(z:1), Dialogo.Fecha2)
    break
  endif
proximo

** Tabla por Operacion
ACT(ba:1, 'Linea Per')
ACT(bb:1, 'Vehiculo')
ACT(bc:1, 'Tipo')
ACT(bd:1, 'NrOperacion')
ACT(be:1, 'TipoOp')
ACT(bf:1, 'Especie')
ACT(bg:1, 'CEspecie')
ACT(bh:1, 'Cliente')
ACT(bi:1, 'Cantidad')
ACT(bj:1, 'Precio1')
ACT(bk:1, 'Concepto')
ACT(bl:1, 'FechaOp')
ACT(bm:1, 'Com.NO C.')
ACT(bn:1, 'Vta.No C.')
ACT(bo:1, 'No Comer.')
ACT(bp:1, 'Linea')
SetFont(ba:1..bz:1,2)
ACN(z:2, 1)

** Tabla por Cliente
ACT(ca:1, 'Cliente')
ACT(cb:1, 'Cpras No')
ACT(cc:1, 'Cpras Comer')
ACT(cd:1, 'Ventas No')
ACT(ce:1, 'Ventas Comer')
SetFont(ca:1..cz:1,2)
ACN(z:3, 1)

recorrer&i 2,Val(z:1)
  if Dialogo.Radio1=0
    SQL.ADD("SELECT O.Vehiculo1, ")
  else
    SQL.ADD("SELECT 'Consolidado' Vehiculo1, ")
  endif
  SQL.ADD("       CASE when O.TipoOp in ('FXCS','FXCT') then 'COMPRA' else 'VENTA' end as Tipo, ")
  SQL.ADD("       O.NrOperacion, ")
  SQL.ADD("       O.TipoOp, ")
  SQL.ADD("       O.Especie, ")
  SQL.ADD("       O.ContraEspecie, ")
  SQL.ADD("       O.Cliente1, ")
  SQL.ADD("       O.Cantidad, ")
  SQL.ADD("       O.Precio1, ")
  SQL.ADD("       O.ConceptoBCRA, ")
  SQL.ADD("       O.FechaOp ")
  SQL.ADD("  from "~DBO~".OPERACIONES O ")
  SQL.ADD(" where O.Especie = '"~Dialogo.Especie1~"' ")
  SQL.ADD("   and (TipoOp in ('FXCS','FXVS') or (TipoOp in ('FXCT','FXVT') and IsNull(O.CB9,0) = 0)) ")
  SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(Val(V:2))~") ") 
  SQL.ADD("   and O.FechaOp Between '"~IdxDate(Val(aa:&i))~"' and '"~IdxDate(Val(ab:&i))~"' ")
  SQL.ADD(" order by O.Vehiculo1, O.TipoOp, O.NrOperacion ")

  recorrer SQL
    DFA
    SCN(z:2, 1)
    ACN(ba:Val(z:2), &i)
    ACT(bb:Val(z:2), fbn('Vehiculo1'))
    ACT(bc:Val(z:2), fbn('Tipo'))
    ACT(bd:Val(z:2), fbn('NrOperacion'))
    ACT(be:Val(z:2), fbn('TipoOp'))
    ACT(bf:Val(z:2), fbn('Especie'))
    ACT(bg:Val(z:2), fbn('ContraEspecie'))
    ACT(bh:Val(z:2), fbn('Cliente1'))
    ACN(bi:Val(z:2), fbn('Cantidad'))
    ACN(bj:Val(z:2), fbn('Precio1'))
    ACT(bk:Val(z:2), fbn('ConceptoBCRA'))
    ACD(bl:Val(z:2), fbn('FechaOp'))

    if EqStr(fbn('Tipo'),'COMPRA') y Incluido(fbn('ConceptoBCRA'),Var('BCRAATE'))
      ACT(bm:Val(z:2), 'SI')
      ACT(bo:Val(z:2), 'SI')
    endif
    if EqStr(fbn('Tipo'),'VENTA') y Incluido(fbn('ConceptoBCRA'),Var('BCRAREP'))
      ACT(bn:Val(z:2), 'SI')
      ACT(bo:Val(z:2), 'SI')
    endif
    if EqStr(Val(bo:Val(z:2)),'SI')
      if Val(y:1)=0
        * Primer pediodo con opeaciones
        ACN(y:1, 1)
        SetFilaActual(FAC+2)
        ACT(a:FAC+1, 'Vehiculo')
        ACT(d:FAC, 'Compras')
        ACT(h:FAC, 'Ventas')
        ACT(b:FAC+1, 'Cantidad '~Dialogo.Especie1)
        ACT(c:FAC+1, 'Precio')
        ACT(d:FAC+1, 'Pesos')
        ACT(e:FAC+1, 'Res. vs. Spot')
        ACT(f:FAC+1, 'Res. / Cant.')
        ACT(g:FAC+1, 'Cantidad '~Dialogo.Especie1)
        ACT(h:FAC+1, 'Precio')
        ACT(i:FAC+1, 'Pesos')
        SetFont(a:FAC..j:FAC+1,2)
        AlinearCeldas(b:FAC..j:FAC,'C')
        AlinearCeldas(b:FAC+1..j:FAC+1,'D')
        AgregarMarco(b:FAC..f:FAC,2,0,Exe('COLOR6'))
        AgregarMarco(g:FAC..i:FAC,2,0,Exe('COLOR6'))
        AgregarMarco(a:FAC+1..j:FAC+1,2,2,Exe('COLOR6'))
        SetFilaActual(FAC+2)
      endif
      if &i<>Val(w:1)
        * Nuevo periodo
        if NoVacio(Val(w:1))
          * Totales periodo anterior
          if Val(ad:&i-1)>=Val(ac:&i-1)
            recorrer&j Val(ac:&i-1),Val(ad:&i-1)
             if Val(l:&j)>0
                ACN(c:&j, Val(d:&j)/Val(b:&j))
                ACN(e:&j, (Val(x:1)-Val(c:&j))*Val(b:&j))
              endif
              if Val(m:&j)>0
                ACN(h:&j, Val(i:&j)/Val(g:&j))
              endif
              if Val(l:&j)>0 y Val(m:&j)>0
                ACN(j:&j, (Val(h:&j)/Val(c:&j)-1)*100)
              endif
            proximo
            SetFont(a:Val(ac:&i-1)..m:Val(ad:Val(y:2)),1)
            FormatoCeldas(b:Val(ac:&i-1)..b:Val(ad:&i-1), Exe('F2'))
            FormatoCeldas(c:Val(ac:&i-1)..c:Val(ad:&i-1), Exe('F5'))
            FormatoCeldas(d:Val(ac:&i-1)..g:Val(ad:&i-1), Exe('F2'))
            FormatoCeldas(h:Val(ac:&i-1)..h:Val(ad:&i-1), Exe('F5'))
            FormatoCeldas(i:Val(ac:&i-1)..i:Val(ad:&i-1), Exe('F2'))
            FormatoCeldas(j:Val(ac:&i-1)..j:Val(ad:&i-1), Exe('F2%'))
          endif
          IFA
          ACT(a:FAC, 'Totales')
          ACN(b:FAC, Val(af:&i-1))
          ACN(d:FAC, Val(ag:&i-1))
          ACN(c:FAC, Val(d:FAC)/Val(b:FAC))
          ACN(e:FAC, (Val(x:1)-Val(c:FAC))*Val(b:FAC))
          ACN(f:FAC, Val(e:FAC)/Val(d:FAC))

          ACN(g:FAC, Val(ai:&i-1))
          ACN(i:FAC, Val(aj:&i-1))
          ACN(h:FAC, Val(i:FAC)/Val(g:FAC))
          if Val(ae:&i-1)>0 y Val(ah:&i-1)>0
            ACN(j:FAC, (Val(h:FAC)/Val(c:FAC)-1)*100)
          endif
          SetFont(a:FAC..j:FAC,2)
          FormatoCeldas(b:FAC..b:FAC, Exe('F2'))
          FormatoCeldas(c:FAC..c:FAC, Exe('F5'))
          FormatoCeldas(d:FAC..e:FAC, Exe('F2'))
          FormatoCeldas(f:FAC..f:FAC, Exe('F0%'))
          FormatoCeldas(g:FAC..g:FAC, Exe('F2'))
          FormatoCeldas(h:FAC..h:FAC, Exe('F5'))
          FormatoCeldas(i:FAC..i:FAC, Exe('F2'))
          FormatoCeldas(j:FAC..j:FAC, Exe('F2%'))
          IFA
        endif
        IFA
        ACT(a:FAC, Val(s:Mes(Val(aa:&i))))
        SetFont(a:FAC,2)
        ACN(w:1, &i)
        BorrarCeldas(w:2..w:2)
        IFA
        ACN(ac:&i, FAC)
      endif
      if Not EqStr(fbn('Vehiculo1'),Val(w:2))
        if NoVacio(Val(w:2))
          IFA
        endif
        ACN(ad:&i, FAC)
        ACT(a:FAC, fbn('Vehiculo1'))
        ACT(w:2, fbn('Vehiculo1'))
      endif
      if EqStr(Val(bm:Val(z:2)),'SI')
        SCN(b:FAC, fbn('Cantidad'))
        SCN(d:FAC, fbn('Cantidad')*fbn('Precio1'))
        SCN(l:FAC, 1)
        SCN(ae:&i, 1)
        SCN(af:&i, fbn('Cantidad'))
        SCN(ag:&i, fbn('Cantidad')*fbn('Precio1'))
      endif
      if EqStr(Val(bn:Val(z:2)),'SI')
        SCN(g:FAC, fbn('Cantidad'))
        SCN(i:FAC, fbn('Cantidad')*fbn('Precio1'))
        SCN(m:FAC, 1)
        SCN(ah:&i, 1)
        SCN(ai:&i, fbn('Cantidad'))
        SCN(aj:&i, fbn('Cantidad')*fbn('Precio1'))
      endif
      ACN(bp:Val(z:2), FAC)
      ACN(y:2, &i)
    endif

    * Totales por CLiente
    ACN(z:4, 0)
    if Val(z:3)>1
      recorrer&j 2,Val(z:3)
        if EqStr(fbn('Cliente1'),Val(ca:&j))
          ACN(z:4, &j)
          Break
        endif
      proximo
      if Val(z:4)=0
        SCN(z:3, 1)
        ACN(z:4, Val(z:3))
        ACT(ca:Val(z:4), fbn('Cliente1'))
      endif
    else
      SCN(z:3, 1)
      ACN(z:4, Val(z:3))
      ACT(ca:Val(z:4), fbn('Cliente1'))
    endif
    if EqStr(fbn('Tipo'),'COMPRA')
      if Incluido(fbn('ConceptoBCRA'),Var('BCRAATE'))
        SCN(cb:Val(z:4), fbn('Cantidad'))
      else
        SCN(cc:Val(z:4), fbn('Cantidad'))
      endif
    else
      * Es VENTA
      if Incluido(fbn('ConceptoBCRA'),Var('BCRAREP'))
        SCN(cd:Val(z:4), fbn('Cantidad'))
      else
        SCN(ce:Val(z:4), fbn('Cantidad'))
      endif
    endif

  proximo
proximo

if Val(y:1)=1
  if Val(ad:Val(y:2))>=Val(ac:Val(y:2))
    recorrer&j Val(ac:Val(y:2)),Val(ad:Val(y:2))
      if Val(l:&j)>0
        ACN(c:&j, Val(d:&j)/Val(b:&j))
        ACN(e:&j, (Val(x:1)-Val(c:&j))*Val(b:&j))
      endif
      if Val(m:&j)>0
        ACN(h:&j, Val(i:&j)/Val(g:&j))
      endif
      if Val(l:&j)>0 y Val(m:&j)>0
        ACN(j:&j, (Val(h:&j)/Val(c:&j)-1)*100)
      endif
    proximo
    SetFont(a:Val(ac:Val(y:2))..m:Val(ad:Val(y:2)),1)
    FormatoCeldas(b:Val(ac:Val(y:2))..i:Val(ad:Val(y:2)), Exe('F2'))
    FormatoCeldas(c:Val(ac:Val(y:2))..c:Val(ad:Val(y:2)), Exe('F5'))
    FormatoCeldas(h:Val(ac:Val(y:2))..h:Val(ad:Val(y:2)), Exe('F5'))
  endif
  IFA
  ACT(a:FAC, 'Totales')
  ACN(b:FAC, Val(af:Val(y:2)))
  ACN(d:FAC, Val(ag:Val(y:2)))
  ACN(c:FAC, Val(d:FAC)/Val(b:FAC))
  ACN(e:FAC, (Val(x:1)-Val(c:FAC))*Val(b:FAC))
  ACN(f:FAC, Val(e:FAC)/Val(d:FAC))

  ACN(g:FAC, Val(ai:Val(y:2)))
  ACN(i:FAC, Val(aj:Val(y:2)))
  ACN(h:FAC, Val(i:FAC)/Val(g:FAC))
  if Val(ae:Val(y:2))>0 y Val(ah:Val(y:2))>0
    ACN(j:FAC, (Val(h:FAC)/Val(c:FAC)-1)*100)
  endif

  SetFont(a:FAC..j:FAC,2)
  FormatoCeldas(b:FAC..b:FAC, Exe('F2'))
  FormatoCeldas(c:FAC..c:FAC, Exe('F5'))
  FormatoCeldas(d:FAC..e:FAC, Exe('F2'))
  FormatoCeldas(f:FAC..f:FAC, Exe('F0%'))
  FormatoCeldas(g:FAC..g:FAC, Exe('F2'))
  FormatoCeldas(h:FAC..h:FAC, Exe('F5'))
  FormatoCeldas(i:FAC..i:FAC, Exe('F2'))
  FormatoCeldas(j:FAC..j:FAC, Exe('F2%'))

  ** Totales en tabla x periodos
  ACN(ae:Val(z:1)+2, sum(ae:2..ae:Val(z:1)))
  ACN(af:Val(z:1)+2, sum(af:2..af:Val(z:1)))
  ACN(ag:Val(z:1)+2, sum(ag:2..ag:Val(z:1)))
  ACN(ah:Val(z:1)+2, sum(ah:2..ah:Val(z:1)))
  ACN(ai:Val(z:1)+2, sum(ai:2..ai:Val(z:1)))
  ACN(aj:Val(z:1)+2, sum(aj:2..aj:Val(z:1)))
  ACN(ai:Val(z:1)+3, Val(af:Val(z:1)+2)-Val(ai:Val(z:1)+2))
  ACN(aj:Val(z:1)+3, -Val(ag:Val(z:1)+2)+Val(aj:Val(z:1)+2))

  SetFilaActual(FAC+2)
  ACT(a:FAC, 'Total General')

  ACN(b:FAC, Val(af:Val(z:1)+2))
  ACN(d:FAC, Val(ag:Val(z:1)+2))
  ACN(c:FAC, Val(d:FAC)/Val(b:FAC))
  ACN(x:2, Val(c:FAC))
  ACN(e:FAC, (Val(x:1)-Val(c:FAC))*Val(b:FAC))
  ACN(f:FAC, Val(e:FAC)/Val(d:FAC))

  ACN(g:FAC, Val(ai:Val(z:1)+2))
  ACN(i:FAC, Val(aj:Val(z:1)+2))
  ACN(h:FAC, Val(i:FAC)/Val(g:FAC))
  ACN(x:3, Val(h:FAC))
  if Val(ae:Val(z:1)+2)>0 y Val(ah:Val(z:1)+2)>0
    ACN(j:FAC, (Val(h:FAC)/Val(c:FAC)-1)*100)
  endif

  SetFont(a:FAC..j:FAC,3)
  FormatoCeldas(b:FAC..b:FAC, Exe('F2'))
  FormatoCeldas(c:FAC..c:FAC, Exe('F5'))
  FormatoCeldas(d:FAC..e:FAC, Exe('F2'))
  FormatoCeldas(f:FAC..f:FAC, Exe('F0%'))
  FormatoCeldas(g:FAC..g:FAC, Exe('F2'))
  FormatoCeldas(h:FAC..h:FAC, Exe('F5'))
  FormatoCeldas(i:FAC..i:FAC, Exe('F2'))
  FormatoCeldas(j:FAC..j:FAC, Exe('F2%'))

  SetFont(aa:2..az:Val(z:1),1)
  SetFont(aa:Val(z:1)+2..az:Val(z:1)+3,2)
  FormatoCeldas(ac:2..ae:Val(z:1)+3, Exe('F0'))
  FormatoCeldas(af:2..ag:Val(z:1)+3, Exe('F2'))
  FormatoCeldas(ah:2..ah:Val(z:1)+3, Exe('F0'))
  FormatoCeldas(ai:2..aj:Val(z:1)+3, Exe('F2'))

  SetFilaActual(FAC+2)
endif

if Val(z:2)>1
  SetFont(ba:2..bz:Val(z:2),1)

  FormatoCeldas(bj:2..bj:Val(z:2),Exe('F6'))

  ACN(bi:Val(z:2)+2, Sum(bi:2..bi:Val(z:2)))

  SetFont(bi:Val(z:2)+2,2)
  FormatoCeldas(bi:2..bi:Val(z:2)+2,Exe('F2'))
endif
if Val(z:3)>1
  SetFont(ca:2..cz:Val(z:3),1)

  ** Totales en tabla x cliente
  ACN(cb:Val(z:3)+2, Sum(cb:2..cb:Val(z:3)))
  ACN(cc:Val(z:3)+2, Sum(cc:2..cc:Val(z:3)))
  ACN(cd:Val(z:3)+2, Sum(cd:2..cd:Val(z:3)))
  ACN(ce:Val(z:3)+2, Sum(ce:2..ce:Val(z:3)))
  ACN(cd:Val(z:3)+3, Val(cb:Val(z:3)+2)-Val(cd:Val(z:3)+2))
  ACN(ce:Val(z:3)+3, Val(cc:Val(z:3)+2)-Val(ce:Val(z:3)+2))
  ACN(cd:Val(z:3)+4, Val(cb:Val(z:3)+2)+Val(cd:Val(z:3)+2))
  ACN(ce:Val(z:3)+4, Val(cc:Val(z:3)+2)+Val(ce:Val(z:3)+2))
  ACN(ce:Val(z:3)+5, Sum(cb:Val(z:3)+2..ce:Val(z:3)+2))

  SetFont(cb:Val(z:3)+2..ce:Val(z:3)+5,2)
  FormatoCeldas(cb:2..ce:Val(z:3)+5,Exe('F2'))

  IFA
  ACT(a:FAC, 'Volumen Operado por banco')  
  SetFont(a:FAC,3)
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'Banco')  
  ACT(b:FAC, 'Op. NO Comerc.')
  ACT(c:FAC, '% Part.')  
  ACT(d:FAC, 'Op. Comerc.')  
  ACT(e:FAC, 'Total')  
  ACT(f:FAC, '% Part.')  
  SetFont(a:FAC..f:FAC,2)
  AlinearCeldas(b:FAC..f:FAC,'D')
  AgregarMarco(a:FAC..f:FAC,2,2,Exe('COLOR6'))
  recorrer&i 2,Val(z:3)  
    IFA
    ACT(a:FAC, Val(ca:&i))
    ACN(b:FAC, Val(cb:&i)+Val(cd:&i))
    ACN(c:FAC, Val(b:FAC)/Val(cd:Val(z:3)+4)*100)
    ACN(d:FAC, Val(cc:&i)+Val(ce:&i))
    ACN(e:FAC, Val(b:FAC)+Val(d:FAC))
    ACN(f:FAC, Val(e:FAC)/Val(ce:Val(z:3)+5)*100)
  proximo
  SetFont(a:FAC-Val(z:3)+2..f:FAC,1)
  FormatoCeldas(b:FAC-Val(z:3)+2..b:FAC,Exe('F2'))
  FormatoCeldas(c:FAC-Val(z:3)+2..c:FAC,Exe('F0%'))
  FormatoCeldas(d:FAC-Val(z:3)+2..e:FAC,Exe('F2'))
  FormatoCeldas(f:FAC-Val(z:3)+2..f:FAC,Exe('F0%'))
  IFA
  ACT(a:FAC, 'Total')  
  ACN(b:FAC, Val(cd:Val(z:3)+4))
  ACN(c:FAC, 100)
  ACN(d:FAC, Val(ce:Val(z:3)+4))
  ACN(e:FAC, Val(b:FAC)+Val(d:FAC))
  ACN(f:FAC, 100)

  SetFont(a:FAC..f:FAC,2)
  FormatoCeldas(b:FAC..b:FAC,Exe('F2'))
  FormatoCeldas(c:FAC..c:FAC,Exe('F0%'))
  FormatoCeldas(d:FAC..e:FAC,Exe('F2'))
  FormatoCeldas(f:FAC..f:FAC,Exe('F0%'))

  SetFilaActual(FAC+3)
  ACT(a:FAC, 'Resultados')
  SetFont(a:FAC,3)
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'Var.Posicion')
  ACT(a:FAC+1, 'Volumen')
  ACT(a:FAC+3, 'Res.Realizado')
  ACT(a:FAC+4, 'Res.No Realizado')
  ACT(a:FAC+5, 'Res. total')

  ACN(b:FAC, Val(af:Val(z:1)+2)-Val(ai:Val(z:1)+2))
  ACN(b:FAC+1, Val(af:Val(z:1)+2)+Val(ai:Val(z:1)+2))
  ACN(b:FAC+3, Val(ai:Val(z:1)+2)*(Val(x:3)-Val(x:2)))
  ACN(b:FAC+4, Val(b:FAC)*(Val(x:1)-Val(x:2)))
  ACN(b:FAC+5, Val(b:FAC+3)+Val(b:FAC+4))

  ACN(c:FAC+5, (Val(b:FAC+5)/Val(x:2))/Val(b:FAC+1)*100)

  SetFont(a:FAC..a:FAC+5,2)
  SetFont(b:FAC..c:FAC+5,1)
  FormatoCeldas(b:FAC..b:FAC+5,Exe('F2'))
  FormatoCeldas(c:FAC+5..c:FAC+5,Exe('F2%'))

  SetFilaActual(FAC+5)
endif

SetFilaActual(FAC+3)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC,2)

