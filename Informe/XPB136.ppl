ACT(va:1,'')
ACT(ba:1,'')
ACT(ea:1,'')
ACT(ca:1,'')

Recorrer SQL

  If Not Eqstr(fbn('VehiculoFPA'),Val(va:1)) o Not Eqstr(fbn('BancoFPA'),Val(ba:1)) o Not Eqstr(fbn('CuentaFPA'),Val(ca:1)) o Not Eqstr(fbn('MonedaFPA'),Val(ea:1))
    If Not Eqstr(Val(va:1),'')
      ACT(a:fac, 'Saldo Final -->')
      ACN(f:fac,  SUM(f:Val(fi:1)..f:fac))
      SetFont(a:fac..g:fac,5)
      FormatoCeldas(f:fac, EXE('F2'))
      ifa
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Descripcion')~'  Banco: '~fbn('RazonSocial'))
    message('_____  Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    ACT(a:fac, 'Banco: '~fbn('RazonSocial'))
    ACT(e:fac, 'Vehiculo: '~fbn('Descripcion'))
    ACT(tc:1, iif(eqstr(fbn('TipoCuenta'),'CC'),'Cuenta Corriente', iif(eqstr(fbn('TipoCuenta'),'CA'),'Caja de Ahorro',iif(eqstr(fbn('TipoCuenta'),'VIS'),'Cuenta Vista',IIF(eqstr(fbn('TipoCuenta'),'CUS'),'Cuenta Custodia')))))
    ACT(a:fac+1, 'Extracto de '~Val(tc:1)~' en '~fbn('Nombre'))
    ACT(e:fac+1, 'Cuenta: '~fbn('Alias3')~' Numero: '~fbn('Numero')~'  (FPA: '~fbn('CuentaFPA')~')')
    SetFont(a:fac..g:fac+1,2)
    AgregarMarco(a:fac..h:fac+1,0,0,Exe('COLOR6'))
    SetFilaActual(fac+2)

    ACT(a:fac,   'Transaccion')
    ACT(b:fac,   'Tipo')
    ACT(b:fac+1, 'Transaccion')

    ACT(c:fac,   'Concepto')
    ACT(d:fac,   'Fecha')
    ACT(d:fac+1, 'Valor')
    ACT(e:fac,   'Comprobante')
    ACT(f:fac,   'Importe')
    ACT(g:fac,   'Mov Datanet')
    ACT(h:fac,   'Estado')
    SetFont(a:fac..g:fac+1,2)
    AlinearCeldas(a:fac..g:fac+1,'C')
    AgregarMarco(a:fac..h:fac+1,0,0,Exe('COLOR8'))
    ifa
    ifa
    ACT(a:fac, 'Saldo Inicial -->')
    ACN(f:fac,  SaldoD(fbn('VehiculoFPA'),fbn('MonedaFPA'),,,,,,fbn('CuentaFPA'),1,Dialogo.Fecha1-1) )
    SetFont(a:fac..g:fac,5)
    FormatoCeldas(f:fac, EXE('F2'))
    ACN(fi:1,fac)
    ifa
  Endif

   ACT(a:fac, fbn('NrTrans'))

   If fbn('Op') =0
      ACLT(a:fac, fbn('NrTrans'))
   Else
      ACLO(a:fac, fbn('NrTrans'))
   Endif

   ACT(b:fac, fbn('TipoTr2'))

   if Incluido(fbn('DescripcionC'),'DEVM|CRVM|TRANSF')
       ACT(c:fac, fbn('DescripcionC'))
   else
      ACT(c:fac, 'Liquidacion de Operaciones')
   endif

   ACT(c:fac, fbn('DescripcionC'))
   ACD(d:fac, fbn('FechaMov'))
   ACN(e:fac, fbn('NrComprob'))
   ACN(f:fac, fbn('Cantidad'))
   ACT(g:fac, fbn('NrDatanet')~' ('~fstr(fbn('NrMovDatanet'),0,0)~')' )
   ACT(h:fac, fbn('Estado'))

  FormatoCeldas(e:fac, EXE('F0'))
  FormatoCeldas(f:fac, EXE('F2'))
  SetFont(a:fac..g:fac,1)
  ACT(va:1,fbn('VehiculoFPA'))
  ACT(ba:1,fbn('BancoFPA'))
  ACT(ea:1,fbn('MonedaFPA'))
  ACT(ca:1,fbn('CuentaFPA'))
Proximo

ifa
ACT(a:fac, 'Saldo Final -->')
ACN(f:fac,  SUM(f:Val(fi:1)..f:fac))
SetFont(a:fac..g:fac,5)
FormatoCeldas(f:fac, EXE('F2'))

ifa
ifa

