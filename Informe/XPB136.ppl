*/Pendientes Y Operaciones.

SQL.ADD("  SELECT /*+ RULE */ M.FechaMov, V.Codigo VehiculoFPA, C.Numero, C.Codigo CuentaFPA, C.Alias3, C.TipoCuenta,1 Op,")
