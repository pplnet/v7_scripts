SQL.ADD("  AND   M.Especie     = E.Codigo ")
SQL.ADD("  AND   C.Comitente   = B.Codigo ")
SQL.ADD("  AND   M.Cuenta      = C.Codigo            ")
SQL.ADD("  AND   M.Nroperacion = CO.NrOperacion (+)")
SQL.ADD("  AND   M.EnteCustodia= V.Codigo ")
