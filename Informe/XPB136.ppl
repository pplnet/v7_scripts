ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:   'D.Fecha'   ;1;1;;;;;;;PRIDEMES(fsys)
  Fecha2:   'H.Fecha'   ;1;2;;;;;;;fsys
  Radio1:  'Tipo|Debitos|Creditos|Ambos' ;2;1;;;;;;;2
  Radio2:  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;3;1;;;;;;;4
  Check1:  'Incluye Pagadoras';4;1;;;;;;;1
  Lista1:   'Vehiculos' ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ; 0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(a:1, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:2, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:3, 'Cuentas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Tipo de Movimientos: '~iif(Dialogo.Radio1=0,'Debitos',iif(Dialogo.radio1=1,'Creditos','Debitos y Creditos')))
ACT(a:5, 'Tipo de Cuenta: '~iif(Dialogo.Radio2=0,'Cuenta Corriente',iif(Dialogo.radio2=1,'Intermedia',iif(Dialogo.Radio2=2,'Recaudadora',iif(Dialogo.Radio2=3,'C.Ahorro','Todas')))))
If Dialogo.Check1=0
  ACT(a:5, Val(a:5)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:5, Val(a:5)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:1..a:5,2)
ACT(c:6, 'Extracto Bancario FPA '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(c:6,3)

SetFilaActual(7)
************************************************************************************************************************
SQL.ADD("  SELECT /*+ RULE */ FechaMov,VehiculoFPA, Numero, CuentaFPA, Alias3, TipoCuenta,Op,")
SQL.ADD("  BancoFPA, RazonSocial, Nombre,  MonedaFPA ,Descripcion, NrTrans, Tipotr2, ")
SQL.ADD("  DescripcionC, NrComprob ,Cantidad, NrDatanet, NrMovDatanet, Estado from (")

SQL.ADD("  SELECT /*+ RULE */ M.FechaMov, V.Codigo VehiculoFPA, C.Numero, C.Codigo CuentaFPA, C.Alias3, C.TipoCuenta,0 Op,")
SQL.ADD("  B.Codigo BancoFPA, B.RazonSocial, E.Nombre, E.Codigo MonedaFPA, V.Descripcion, T.NrTrans, ")
SQL.ADD("  T.TipoTr2, CN.Descripcion DescripcionC, M.NrComprob, M.Cantidad, CO.NrDatanet, CO.NrMovDatanet, 'Pendiente' Estado ")
SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C, "~DBO~".CONCILIACIONES CO, ")
SQL.ADD("  "~DBO~".CNCONCEPTOSPAGOCOBRO CN , "~DBO~".VEHICULOS V, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
SQL.ADD("  WHERE M.NrOperacion = T.NrTrans")
SQL.ADD("  AND   M.Especie     = E.Codigo ")
SQL.ADD("  AND   C.Comitente   = B.Codigo ")
SQL.ADD("  AND   M.Cuenta      = C.Codigo ")
SQL.ADD("  AND   M.Nroperacion  = CO.NrOperacion (+)")
SQL.ADD("  AND   T.ConceptoPago = CN.Codigo (+)")
SQL.ADD("  AND   T.Vehiculo1    = V.Codigo ")
SQL.ADD("  AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("  AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("  AND   E.Tipo         = 'MON' ")
SQL.ADD("  AND   T.TipoTr2    IN ('CRVM','DEVM','TRANSF')  ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND B.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If Dialogo.Radio1=0
  SQL.ADD(" AND M.Cantidad < 0 ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND M.Cantidad > 0 ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
  SQL.ADD(" AND C.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check1=0
  SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
Endif
SQL.ADD("  UNION all")

