SQL.ADD("  FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES T, "~DBO~".CUENTAS C, "~DBO~".CONCILIACIONES CO, ")
SQL.ADD("  "~DBO~".VEHICULOS V, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
