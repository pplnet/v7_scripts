SQL.ADD("  AND   T.Vehiculo1    = V.Codigo ")
SQL.ADD("  AND   M.NrMov        = CO.NrMovimiento (+) ")
SQL.ADD("  AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("  AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("  AND   T.TipoTr2    IN ('CRVM','DEVM','TRANSF')  ")
SQL.ADD("  AND   E.Tipo         = 'MON' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND B.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
