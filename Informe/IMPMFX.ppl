CrearDialogo
  NrOperacion1:'Operacion'
  Check1:      'Impresora'
FinDialogo

If Not OK
   Cancelar
Endif

SetFilaActual(1)
SQL.ADD("Select O.*, T.Nombre TNom, C.RazonSocial, C.CUIT, E.Extendido, E.DiasAnio EDiasAnio ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".TIPOSOPERACION T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and   O.TipoOp      = T.Codigo ")
SQL.ADD(" and   O.Especie     = E.Codigo ")
SQL.ADD(" and   O.Cliente1    = C.Codigo ")
Recorrer SQL
  SQL.ADD("SELECT Contacto, Fecha, Observaciones, Usuario FROM "~DBO~".CONFIRMACIONESOP WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
  Recorrer SQL
    dfa
    ACT(cf:1, fbn('Contacto'))
    ACD(cf:2, fbn('Fecha'))
    ACT(cf:3, fbn('Observaciones'))
    ACT(cf:4, fbn('Usuario'))
  Proximo


  * Marco
  AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
  ACT(A3, BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo', FBN['Vehiculo1']))
  SetFont(a:fac..a:fac+1,2)
  CrearFont(4, "Arial,7,")
  *  ACT(d:fac-1, 'Sr./es:    '~BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']))
  ACT(b:fac+4,'Minuta de '~fbn['TNom'])

  ***********
  * GENERALES
  ***********

  ACT(a:fac+6, 'Fecha Operacion')
  ACD(b:fac+6, FBN['FechaOp'])

  ACT(a:fac+7, 'Fecha Impresion')
  ACD(b:fac+7, FSYS)

  ACT(a:fac+8, 'Hora Operacion')
  ACT(b:fac+8, hora(fbn['FechaCarga']))

  ACT(a:fac+9, 'Operador')
  ACT(b:fac+9, BuscarCampo('USUARIOS','Nombre','Codigo',Fbn['Operador']))

  *-----
  ACT(d:fac+6, 'Hora de Confirmacion')
  ACT(e:fac+6, hora(Val(cf:2)))

  ACT(d:fac+7, 'Realizada por')
  ACT(e:fac+7, BuscarCampo('USUARIOS','Nombre','Codigo',Val(cf:4)))

  ACT(d:fac+8, 'Hora Impresion')
  ACT(e:fac+8, hora(AHORA))

  ACT(d:fac+9, 'Operador')
  ACT(e:fac+9, BuscarCampo('USUARIOS','Nombre','Codigo', USUARIOACTIVO))

  if Not Vacio(SQL("Select Usuario from "~DBO~".INSTANCIASOP Where NrInstancia = 3 and NrOperacion = '"~Dialogo.NrOperacion1~"' ")) 
     ACT(d:fac+10, 'Autorizada por')
     ACT(e:fac+10, SQL("Select Usuario from "~DBO~".INSTANCIASOP Where NrInstancia = 3 and NrOperacion = '"~Dialogo.NrOperacion1~"' "))
  endif

  *--------------------------

*********
* Datos de la operacion
*********
  ACT(a:fac+11, 'Cliente :')
  ACT(b:fac+11, BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']))

  ACT(a:fac+12, 'CUIT : ')
  ACT(b:fac+12, Copy(FBN['CUIT'],1,2)~'-'~Copy(fbn['CUIT'],3,8)~'-'~Copy(fbn['CUIT'],11,1))


  ACT(a:fac+11+3, 'Operacion Nro. :')
  ACT(b:fac+11+3, Fbn['NrOperacion'])

  ACT(a:fac+12+3, 'Especie : ')
  ACT(b:fac+12+3, FBN['Especie']~' / '~Copy(fbn['Extendido'],1,45))

  ACT(a:fac+13+3,'Fecha de Liquidacion : ')
  ACD(b:fac+13+3,FBN['FechaVto'])

  ACT(a:fac+14+3,'Cantidad Nominal :')
  ACN(b:fac+14+3, Fbn['Cantidad'])

  ACT(a:fac+15+3,'Precio :')
  ACN(b:fac+15+3, Fbn['Precio1'])

  ACT(a:fac+16+3,'Contra Especie :')
  ACT(b:fac+16+3, Fbn['ContraEspecie'])

  ACT(a:fac+17+3,'Liquid. Contra Especie :')
  ACD(b:fac+17+3, Fbn['FechaVto'])

  ACT(a:fac+18+3,'Confirmada con :')
  ACT(b:fac+18+3, Val(cf:1))

  ACT(a:fac+19+3, 'Equivalente :')
  If Incluido(Fbn['TipoOp'],'FXA|FXAT')
    ACN(b:fac+19+3, Fbn['TotalBrutoCli1'] )
  Else
    ACN(b:fac+19+3, Fbn['Precio1'] * Fbn['Cantidad'])
  Endif


  ACN(aa20, 0)
  if not vacio(fbn['Corredor'])
     ACT(a:fac+21+3,'Corredor :')
     ACT(b:fac+21+3, Fbn['Corredor'])

     ACT(a:fac+22+3,'Comision :')
     ACN(b:fac+22+3, Fbn['Comision'])
     * Habr¡a que darle formato de porcentaje.

     ACT(a:fac+23+3,'Importe :')
     ACN(b:fac+23+3, Fbn['Comision'] * Fbn['Cantidad'])
     ACN(aa20, 4)
  endif

*  ACT(a:fac+21+3+val(aa20) ,'Interes :')
*  ACN(b:fac+21+3+val(aa20), Fbn['TotalIntereses'])

*  ACT(a:fac+22+3+val(aa20),'Base de Interes :')
*  if fbn['TotalIntereses'] > 0
*     ACT(b:fac+22+3+val(aa20), Fbn['EDiasAnio'])
*  endif

  if Incluido(fbn['TipoOp'], 'FXCT|FXVT|FXAT')
     ACT(a:fac+23+3+val(aa20), 'Dias :')
     ACN(b:fac+23+3+val(aa20), fbn['Plazo'])
  endif

  ACT(AA15, SQL("Select NrBoleto from "~DBO~".OPERACIONES Where OperacionRef = '"~fbn['NrOperacion']~"'"))
  if not Eqstr(trim(mirt(val(AA15))), '')
     AgregarMarco(D:fac+15+3..E:fac+16+3,2,0)
     ACT(D:fac+15+3, 'Boleto Asociado :')
     ACT(E:fac+15+3, val(AA15))
     ** dato redundante (operador)
     ACT(D:fac+16+3, 'Fue renovada por :')
     ACT(E:fac+16+3, val(b:fac+9))
  endif

*********
* Forma de liquidacion
*********

  ACT(a:fac+25+3+val(aa20), 'LIQUIDACION Instruccion Especie')
  SQL.ADD(" Select Mercado, Nombre, Numero, Alias1 from "~DBO~".CUENTAS Where Codigo = '"~iif(incluido(fbn['TipoOp'], 'FXV|FXVT'), fbn['Cuenta3'], fbn['Cuenta1'])~"'")
  Recorrer SQL
     ACT(a:fac+26+3+val(aa20), 'Forma de liquidacion :')
     ACT(b:fac+26+3+val(aa20), FBN['Mercado'])

     ACT(a:fac+27+3+val(aa20), 'Nombre :')
     ACT(b:fac+27+3+val(aa20), Copy(FBN['Nombre'],1,20))

     ACT(a:fac+28+3+val(aa20), 'Nro. de Cuenta :')
     ACT(b:fac+28+3+val(aa20), FBN['Numero'])

     ACT(a:fac+29+3+val(aa20), 'Cod. Swift :')
     ACT(b:fac+29+3+val(aa20), FBN['Alias1'])
     dfa
  Proximo

  ACT(d:fac+25+3+val(aa20), 'LIQUIDACION Instruccion ContraEspecie')
  SQL.ADD(" Select Mercado, Nombre, Numero, Alias3, Corresponsal from "~DBO~".CUENTAS Where Codigo = '"~iif(incluido(fbn['TipoOp'], 'FXV|FXVT'), fbn['Cuenta2'], fbn['Cuenta4'])~"'")
  Recorrer SQL
     ACT(d:fac+26+3+val(aa20), 'Forma de liquidacion :')
     ACT(e:fac+26+3+val(aa20), FBN['Mercado']~' - '~fbn('Corresponsal'))

     ACT(d:fac+27+3+val(aa20), 'Nombre :')
     ACT(e:fac+27+3+val(aa20), Copy(FBN['Nombre'],1,20))

     ACT(d:fac+28+3+val(aa20), 'Nro. de Cuenta :')
     ACT(e:fac+28+3+val(aa20), FBN['Numero'])

     ACT(d:fac+29+3+val(aa20), 'Cod. Swift :')
     ACT(e:fac+29+3+val(aa20), FBN['Alias3'])
     dfa
  Proximo


  ACT(a:fac+32+3+val(aa20), 'Observ. Back Office')
  ACT(b:fac+32+3+val(aa20), Val(cf:3))

  CrearFont(1, 'Arial,10,B')
  CrearFont(2, 'Arial,10,')
  CrearFont(3, 'Arial,14,B')

  SetFont(a:fac..a:fac+30+3+val(aa20),1)
  SetFont(b:fac..b:fac+30+3+val(aa20),2)
  SetFont(d:fac..d:fac+30+3+val(aa20),1)
  SetFont(e:fac..e:fac+30+3+val(aa20),2)
  SetFont(b:fac+4,3)

  ColorCeldas(b:fac+4,1)
  ColorCeldas(a:fac+29+3+val(aa20),1)
  ColorCeldas(a:fac+32+3+val(aa20),1)

  FormatoCeldas(b:fac+15+3,exe('F9'))
  AgregarMarco(a:fac+6..f:fac+32+3+val(aa20),2,0)
  AgregarMarco(a:fac+11..f:fac+32+3+val(aa20),2,0)
  AgregarMarco(a:fac+24+3+val(aa20)..f:fac+32+3+val(aa20),2,0)
  AlinearCeldas(a:fac+6..a:fac+32+3+val(aa20),'I')
  AlinearCeldas(b:fac+6..b:fac+32+3+val(aa20),'I')
  AlinearCeldas(d:fac+6..e:fac+32+3+val(aa20),'I')
  AlinearCeldas(e:fac+6..f:fac+32+3+val(aa20),'I')

  ACO(1,16)
  ACO(2,12)
  ACO(3,5)
  ACO(4,15)
  ACO(5,8)
  ACO(6,9)

  LimitesVision(h:fac+50)

  IF Dialogo.Check1=1
     ImprimirHoja
  ENDIF
Proximo

