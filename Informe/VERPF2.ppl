CrearDialogo  
  Fecha1     : 'Fecha'                 ;;;;;;;;;HABILES(Fsys,-1,'ARG',SI)
  Radio1     : "Tipo|Total|Vinculadas" ;;;;;;;;;0
  Vehiculo1  : "Empresa"               ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
  
FinDialogo

*- Elimina el AnteUltimo. Calculo el Dia a Eliminar
If Dialogo.Radio1=0
  if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='POSFIN' and Extension='TODOS/"~Dialogo.Fecha1~"' ")=0
     Cancelar('No existe el reporte solicitado')
  else
     LeerPMG('POSFIN', 'TODOS/'~Dialogo.Fecha1)
  endif
else
  if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='POSFIN' and Extension='"~Dialogo.Vehiculo1~'/'~Dialogo.Fecha1~"' ")=0
    Cancelar('No existe el reporte solicitado')
  else
    LeerPMG('POSFIN', Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
  endif
endif
Impresion(1,2)
LimitesVision(val(b:200)+2:130)


