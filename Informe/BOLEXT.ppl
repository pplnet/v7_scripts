ACT(ar:1,VAR('PATHCONFI')~'Boleto_Cliente_'~Val(ar:5)~'_'~Val(op:1)~'_'~Dialogo.String~'.pdf')

*Email
ACT(em:3, BuscarCampo('OPERACIONES', 'Cliente1','NrOperacion', Dialogo.NrOperacion1))
ACT(em:1, BuscarCampo('Clientes', 'DireccionEmail', 'Codigo', Val(em:3)))

*Leyendas
ABT(AA:10..AA:20, LeerLeyenda('','','','MBOLETOASU'), 1)
ABT(ZK:1..ZK:4, LeerLeyenda('','','','MBOLETODET'), 1)


LimitesVision(K:FAC)
SetPrintFit(3,81)
Impresion(1,0)
Impresion(2,0)
