If Dialogo.Radio2 = 0
   ImprimirHoja(SI)
Else
   If Dialogo.Radio2 = 2
      HojaVisible(NO)
      SetPrintFit(4)
      ExportarPdfLite(val(ar:1))
   Else
       If Dialogo.Radio2 = 3  
         HojaVisible(NO)
         SetPrintFit(4)
         ExportarPdfLite(val(ar:1))
         SendMail(Val(em:1),val(AA:10),val(ZK:1),SI,,,val(ar:1),,SI)
      Endif 
   endif
