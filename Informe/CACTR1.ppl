HojaVisible(Si)
ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion' ;;;;;;;;;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('CACTRA'))~") "; 
  Fecha1      : 'Fecha'     ;;;;;;;;;Fsys 
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1, "Arial,10,")
CrearFont(2, "Arial,10,B")
CrearFont(3, "Arial,8,")
CrearFont(4, "Arial,8,B")
CrearFont(5, "Arial,6,")

ACT(aa:1,'Enero')
ACT(aa:2,'Febrero')
ACT(aa:3,'Marzo')
ACT(aa:4,'Abril')
ACT(aa:5,'Mayo')
ACT(aa:6,'Junio')
ACT(aa:7,'julio')
ACT(aa:8,'Agosto')
ACT(aa:9,'Septiembre')
ACT(aa:10,'Octubre')
ACT(aa:11,'Noviembre')
ACT(aa:12,'Diciembre')

Recorrer&i 1, 2
   SQL.ADD("Select NrOperacion,TipoOp,Vehiculo1,Especie,Cantidad,FechaOp,FechaVto,ContraEspecie,FechaPago,Precio1,Cliente1,Cliente2,Cuenta4,Cuenta1 from "~DBO~".OPERACIONES")
   SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"'")
   Recorrer SQL
      IF &i = 2
         SetFilaActual(49)
      Endif 
      ACT(X:1, BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']))  
      ACT(X:6, BuscarCampo('Vehiculos','Descripcion','Codigo',FBN['Vehiculo1']))
      ACT(zz:99,fbn['Vehiculo1'])
      If &i=1
         ACT(X:2, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1']))
         ACT(X:4, BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta4'])) 
         ACT(X:5, BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta1'])) 
         ACT(X:7, BuscarCampo('CLIENTES','CodComitente','Codigo',fbn['Cliente1']))
         ACT(a:FAC+11, BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente1'])~', '~FStr(Dia(Dialogo.Fecha1),1,0)~' de '~Val(aa:Mes(Dialogo.Fecha1))~' de '~FStr(Anio(Dialogo.Fecha1),4,0)~'.')
      Else
         ACT(X:2, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente2']))
         ACT(X:4, BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta1'])) 
         ACT(X:5, BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta4'])) 
         ACT(X:7, BuscarCampo('CLIENTES','CodComitente','Codigo',fbn['Cliente2']))
         ACT(a:FAC+11, BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente2'])~', '~FStr(Dia(Dialogo.Fecha1),1,0)~' de '~Val(aa:Mes(Dialogo.Fecha1))~' de '~FStr(Anio(Dialogo.Fecha1),4,0)~'.')     
      ENDIF
      AlinearCeldas(a:FAC+11,'i')
      AgregarBMP(a:FAC+4,Var('PATHLOGO')~val(zz:99)~'.bmp',80)       
      ACT(a:FAC+13, 'Señores:')
      ACT(a:FAC+14, val(X:2) )
      SetFont(a:FAC+14..e:FAC+14,2)
      ACT(a:FAC+15, 'PRESENTE')
      ACT(a:FAC+17, 'De nuestra mayor consideraci'~Chr(243)~'n:')
      ACT(a:FAC+20, 'Por medio de la presente, solicitamos a UDS, transferir la cantidad de VN '~fbn['Cantidad']~' '~val(X:1) ) 
      IF &i = 2
         ACT(a:FAC+20, 'Por medio de la presente, confirmamos a UDS, haberles transferido la cantidad de VN '~fbn['Cantidad']~' '~val(X:1) )  
      ENDIF
      ACT(a:FAC+21, 'v'~Chr(237)~'a Euroclear / Caja de Valores, cuenta  '~val(X:7)~' Titular: '~val(X:2)         )
      ACT(a:FAC+22, 'a favor de '~Val(X:6)~', cuenta: '~val(X:4)        )
      ACT(a:FAC+26, 'Sin otro particular, los saludamos a UDs Atte. '       )
      ACT(e:FAC+28, val(X:6)        )
      ACT(e:FAC+31, 'Apoderado                                         Apoderado'      )
      ACT(zz:99,fbn['Vehiculo1'])
   Proximo 
Proximo

SetPrintFit(3,110)
Impresion(2, 0) 
Impresion(3, 0)
LimitesVision(h:FAC+40)
SetMargins(3, 0, 0, 0)

