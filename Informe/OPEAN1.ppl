      ACT(j:fac, iif(fbn('ValorRB1')=0,'Hoy',iif(fbn('ValorRB1')=1,'Normal',iif(fbn('ValorRB1')=2,'48Hs.','72Hs.')))~' '~IIF(fbn['Puesto']=0, 'No Pto.','Puesto'))
    else
