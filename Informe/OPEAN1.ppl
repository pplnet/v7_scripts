    ACT(c:FAC, FBN['Fecha'])
    ACT(d:FAC, FBN['Cliente1'])
    ACT(e:FAC, FBN['TipoOp'])
    ACN(f:FAC, FBN['Cantidad'])
    ACT(g:FAC, FBN['Especie'])
    ACT(h:FAC, FBN['ContraEspecie'])
    ACN(i:FAC, FBN['Plazo'])

