  endif
  if NoVacio(Dialogo.Book1)
    SQL.ADD("and O.Book1 = '"~Dialogo.Book1~"' ")
  endif
  if NoVacio(Dialogo.Operador1)
    SQL.ADD("and O.Operador = '"~Dialogo.Operador1~"' ") 
  endif
  if NoVacio(Dialogo.Lista1)
    SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
  endif

  SQL.ADD(" Union ")

  SQL.ADD("Select Fecha, O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  SQL.ADD("O.Especie, O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli1, O.Vehiculo1, ")
  SQL.ADD("O.Operador, O.Observac2, 2 Tipo, I.Usuario ")
  SQL.ADD(" from "~DBO~".BOPERACIONES O, "~DBO~".INSTANCIASOP I ")
