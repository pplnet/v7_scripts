  SQL.ADD(" Union ")
  
  SQL.ADD("Select O.FechaDel Fecha, O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  *SQL.ADD("Select Fecha, O.NrSisExterno,O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  SQL.ADD("O.Especie, O.ContraEspecie, O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli2, O.Vehiculo1, O.OficialCuenta, O.Plazo, ")
  SQL.ADD("O.Operador, O.Observac2, O.ValorRB1, O.Puesto, O.Book1, O.Corredor, O.Comision, O.Cotizacion2, O.TipoCambio3, O.Precio2, 2 Tipo, O.Operador Usuario,  C.Codigo, C.Equipo, O.MB6, O.NrSisExterno, O.FechaCarga ")
  SQL.ADD(" from "~DBO~".BOPERACIONES O ,"~DBO~".CLIENTES C")
  SQL.ADD(" where  O.NrOperacion Not In (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrOperacion = O.NrOperacion ) ")
  SQL.ADD("   and  O.FechaDel >= '"~IdxDate(Dialogo.Fecha5)~"' and O.FechaDel <= '"~IdxDate(Dialogo.Fecha6+1)~"' ")
  SQL.ADD("   and  O.FechaOp  between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
  SQL.ADD("   and  O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
  SQL.ADD("   and  O.Cliente1 = C.Codigo ")  
  SQL.ADD("   and  O.TipoOp like 'FX%'   ")
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
  endif
  if NoVacio(Dialogo.Especie1)
    SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
