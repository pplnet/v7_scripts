  *
  
  SQL.ADD("Select I.Fecha, O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  SQL.ADD("O.Especie, O.ContraEspecie, O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli2, O.Vehiculo1, O.OficialCuenta,O.Plazo, O.TotalBrutoCli1, O.PorImpuestoBolsa, O.PorDerechoBolsa, O.NroBajaMAE, ")
  SQL.ADD("O.Operador, O.Observac2, O.ValorRB1, O.Puesto, O.Book1, O.Corredor, O.Comision, O.Cotizacion2, O.TipoCambio3, O.Precio2,1 Tipo, I.Usuario, C.Codigo, C.Equipo, O.MB6, O.NroAltaMae, O.FechaCarga")
  SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIASOP I, "~DBO~".CLIENTES C")
  SQL.ADD(" where  O.NrOperacion = B.NrOperacion  ")
  SQL.ADD("   and  B.NrBit = 30 and B.Valor = '1' ")
  SQL.ADD("   and  O.TipoOp like 'T%'             ")
  SQL.ADD("   and  I.NrOperacion = O.NrOperacion  ")
  SQL.ADD("   and  I.Fecha  = (Select Max(Fecha) From "~DBO~".INSTANCIASOP P where P.NrOperacion = O.NrOperacion) ")
  
  *SQL.ADD("   and  I.Fecha  = (Select Max(Convert(Char,Fecha,109)) From "~DBO~".INSTANCIASOP P where P.NrOperacion = O.NrOperacion) ")
  SQL.ADD("   and  I.Fecha >= '"~IdxDate(Dialogo.Fecha5)~"' and I.Fecha <= '"~IdxDate(Dialogo.Fecha6+1)~"'  ")
  SQL.ADD("   and  O.FechaOp  between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
  SQL.ADD("   and  O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
  SQL.ADD("   and  O.Cliente1 = C.Codigo ")
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
  endif
  if NoVacio(Dialogo.Especie1)
    SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
  endif
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
  endif
  if NoVacio(Dialogo.Book1)
    SQL.ADD("and O.Book1 = '"~Dialogo.Book1~"' ")
  endif
  if NoVacio(Dialogo.Operador1)
    SQL.ADD("and O.Operador = '"~Dialogo.Operador1~"' ")
  endif
  if NoVacio(Dialogo.Lista1)
    SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
  endif
  
  SQL.ADD(" Union ")
  
  SQL.ADD("Select I.Fecha, O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  SQL.ADD("O.Especie, O.ContraEspecie, O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli2, O.Vehiculo1, O.OficialCuenta, O.Plazo, O.TotalBrutoCli1, O.PorImpuestoBolsa, O.PorDerechoBolsa, O.NroBajaMAE, ")
  SQL.ADD("O.Operador, O.Observac2, O.ValorRB1, O.Puesto, O.Book1, O.Corredor, O.Comision, O.Cotizacion2, O.TipoCambio3, O.Precio2, 2 Tipo, I.Usuario, C.Codigo, C.Equipo, O.MB6, O.NroAltaMae, O.FechaCarga")
  SQL.ADD(" from "~DBO~".BOPERACIONES O, "~DBO~".INSTANCIASOP I ,"~DBO~".CLIENTES C")
  SQL.ADD(" where  I.NrOperacion = O.NrOperacion ")
  SQL.ADD("   and  I.Fecha  = (Select Max(Fecha) From "~DBO~".INSTANCIASOP P where P.NrOperacion = O.NrOperacion) ")
  SQL.ADD("   and  I.Fecha >= '"~IdxDate(Dialogo.Fecha5)~"' and I.Fecha <= '"~IdxDate(Dialogo.Fecha6+1)~"'  ")
  SQL.ADD("   and  O.TipoOp like 'T%'            ")
  SQL.ADD("   and  O.FechaOp  between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
  SQL.ADD("   and  O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
  SQL.ADD("   and  O.Cliente1 = C.Codigo ")
  if NoVacio(Dialogo.Vehiculo1)
     SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
  endif
  if NoVacio(Dialogo.Especie1)
     SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"'    ")
  endif
  if NoVacio(Dialogo.Cliente1)
     SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"'   ")
  endif
  if NoVacio(Dialogo.Book1)
     SQL.ADD("and O.Book1 = '"~Dialogo.Book1~"'         ")
  endif 
  if NoVacio(Dialogo.Operador1)
     SQL.ADD("and O.Operador = '"~Dialogo.Operador1~"'  ")
  endif
  if NoVacio(Dialogo.Lista1)
    SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
  endif
  
  SQL.ADD(" Union ")
  
  SQL.ADD("Select O.FechaDel Fecha, O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, ")
  SQL.ADD("O.Especie, O.ContraEspecie, O.Cliente1, O.Cantidad, O.Precio1, O.TotalBrutoCli2, O.Vehiculo1, O.OficialCuenta, O.Plazo, O.TotalBrutoCli1, O.PorImpuestoBolsa, O.PorDerechoBolsa, O.NroBajaMAE, ")
  SQL.ADD("O.Operador, O.Observac2, O.ValorRB1, O.Puesto, O.Book1, O.Corredor, O.Comision, O.Cotizacion2, O.TipoCambio3, O.Precio2, 2 Tipo, O.Operador Usuario,  C.Codigo, C.Equipo, O.MB6, O.NroAltaMae, O.FechaCarga ")
  SQL.ADD(" from "~DBO~".BOPERACIONES O ,"~DBO~".CLIENTES C")
  SQL.ADD(" where  O.NrOperacion Not In (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrOperacion = O.NrOperacion ) ")
  SQL.ADD("   and  O.FechaDel >= '"~IdxDate(Dialogo.Fecha5)~"' and O.FechaDel <= '"~IdxDate(Dialogo.Fecha6+1)~"' ")
  SQL.ADD("   and  O.FechaOp  between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
  SQL.ADD("   and  O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
  SQL.ADD("   and  O.Cliente1 = C.Codigo ")  
  SQL.ADD("   and  O.TipoOp like 'T%'    ")
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
  endif
  if NoVacio(Dialogo.Especie1)
    SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
  endif
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
  endif
  if NoVacio(Dialogo.Book1)
    SQL.ADD("and O.Book1 = '"~Dialogo.Book1~"' ")
  endif
  if NoVacio(Dialogo.Operador1)
    SQL.ADD("and O.Operador = '"~Dialogo.Operador1~"' ")
  endif
  if NoVacio(Dialogo.Lista1)
    SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
  endif

  SQL.ADD("order by O.NrOperacion")
*
  Recorrer SQL

  if Not EqStr(Val(xx5), fbn['NrOperacion'])

    ACT(a:FAC, FBN['FechaOp'])
    ACT(b:FAC, FBN['FechaVto'])
    ACT(c:FAC, FBN['Fecha'])
    ACT(d:FAC, FBN['Cliente1'])
    ACT(e:FAC, FBN['TipoOp'])
    ACN(f:FAC, FBN['Cantidad'])
    ACT(g:FAC, FBN['Especie'])
    ACT(h:FAC, FBN['ContraEspecie'])
    ACN(i:FAC, FBN['Plazo'])
    ACN(j:FAC, FBN['TotalBrutoCli1'])

    ACT(k:FAC, FBN['Book1'])
    ACT(l:FAC, FBN['Corredor'])

    If Incluido(FBN['TipoOp'],'TCPCEM')
        ACN(n:FAC, FBN['Precio2'])
    Else
        ACN(n:FAC, FBN['Precio1'])
    Endif
    
    if NoVacio(Val(n:fac))
      ACN(m:FAC, FBN['Comision'])
    endif
    
    ACT(o:FAC, FBN['NrOperacion'])

    if EqStr(fbn['Tipo'],'1')
      ACLO(o:FAC, FBN['NrOperacion'])
    else
    ACLBO(o:FAC, FBN['NrOperacion'])
    endif

    ACT(p:FAC, FBN['Operador'])    

    if fbn['Tipo'] = 1
       act(r:fac,'Anulación')
    endif

    if fbn['MB6']=3 o fbn['MB6']=4
      ACT(s:FAC, FBN['NroAltaMae'])
      ACT(t:fac, fbn['NroBajaMAE'])
    endif

