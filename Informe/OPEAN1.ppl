CrearDialogo
  Vehiculo1   : "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Cliente1    : "Cliente"    ;2;1;
  Book1       : "Book"       ;2;2;;;;;;;iif(Dialogo.Radio1=0,'TRADFX','');     
  Especie1    : "Moneda Base";3;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where Jerarquia like '001%' and Jerarquia Not Like '001007%' and Codigo <>'MONEDA'")
  Operador1   : "Operador"   ;3;2;
  Fecha5      : 'F.Anul.Dde' ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha6      : 'F.Anul.Hta' ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
  Fecha1      : "F.Op.Desde" ;5;1; ;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha2      : "F.Op.Hasta" ;5;2; ;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3      : "F.Vto.Desde";6;1; ;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4      : "F.Vto.Hasta";6;2; ;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  Radio1      : "Tipo.Prod.|FX|MM|T";8;1;;;;;;;2
  Lista1      : 'Tipos Op.'   ;10;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo like 'FX%' or Codigo like 'MM%' or Codigo like 'T%' ")  
  Check2      : 'Exporta PDF' ;;;;NO;NO;;;;0;
FinDialogo

