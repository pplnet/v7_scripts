*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  :  'Fecha Desde';;;;;;Dialogo.Fecha1 >= 0;'Fecha Desde Invalida';NO;FSys
  Fecha2  :  'Fecha Hasta';;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;FSys
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(A:2, Codigoinforme)
SetFilaActual(4)
ACT(a:FAC, 'Detalle Mark to Market OCT del MAE')
ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
if Dialogo.Fecha2>Dialogo.Fecha1
  ACT(a:FAC+1, Val(a:FAC+1)~' hasta '~Dialogo.Fecha2)
endif
SetFont(a:FAC..a:FAC+1,2)

SetFilaActual(FAC+3)
ACT(a:FAC, 'Fecha Porc.')
ACT(b:FAC, 'Tipo')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Fecha Op')
ACT(e:FAC, 'Nro MAE')
ACT(f:FAC, 'Cliente')
ACT(g:FAC, 'Tipo Op')
ACT(h:FAC, 'Cantidad')
ACT(i:FAC, 'Precio')
ACT(j:FAC, 'Met.Fix.')
ACT(k:FAC, 'Fecha Vto')
ACT(l:FAC, 'MTM')
ACT(m:FAC, 'Pr.MTM Hoy')
ACT(n:FAC, 'Pr.MTM Ayer')
SetFont(a:fac..n:FAC,2)
AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select * from "~DBO~".MTMDETOCT ")
SQL.ADD("where FechaProc between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by FechaProc,TipoNegociacion,Especie,FechaOp,NroAltaMAE ")
Recorrer SQL
  ACD(a:FAC, FBN['FechaProc'])
  ACT(b:FAC, FBN['TipoNegociacion'])
  ACT(c:FAC, FBN['Especie'])
  ACD(d:FAC, FBN['FechaOp'])
  ACT(e:FAC, FBN['NroAltaMAE'])
  ACT(f:FAC, FBN['Cliente'])
  ACT(g:FAC, FBN['TipoOp'])
  ACN(h:FAC, FBN['Cantidad'])
  ACN(i:FAC, FBN['Precio1'])
  ACT(j:FAC, FBN['MetodoFix'])
  ACD(k:FAC, FBN['FechaVto'])
  ACN(l:FAC, FBN['Monto'])
  ACN(m:FAC, FBN['PrecioMTMH'])
  ACN(n:FAC, FBN['PrecioMTMA'])
  FormatoCeldas(h:fac..h:fac,Exe('F2'))
  FormatoCeldas(i:fac..i:fac,Exe('F6'))
  FormatoCeldas(l:fac..l:fac,Exe('F2'))
  FormatoCeldas(m:fac..n:fac,Exe('F6'))
  SetFont(a:fac..n:FAC,1)
Proximo

ACO(1,8)
ACO(2,4)
ACO(3,6)
ACO(4,8)
ACO(5,6)
ACO(6,6)
ACO(7,6)
ACO(8,10)
ACO(9,8)
ACO(10,5)
ACO(11,8)
ACO(12,10)
ACO(13,8)
ACO(14,8)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(n:FAC)
