SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, P.PrecioIni, ")
SQL.ADD(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin, P.Fecha, P.Precio1, P.Precio2  ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
*If Dialogo.Check1=0
*   SQL.ADD(" AND   P.Especie <> '"~VAR('MONELOCA')~"' ")
*Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
*If NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD(" AND   P.Cliente = '"~Dialogo.Vehiculo1~"'  ")
*Endif
*if NoVacio(Dialogo.Lista1)
*  SQL.ADD(" and P.Book =( "~Pipe2Comillas(Dialogo.Lista1)~") ")
*endif
SQL.ADD(" AND   P.NrSaldo IN (181) ")
*SQL.ADD(" AND   P.Fecha = "~IdxDate2(Dialogo.Fecha1)~"  ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Book,P.PrecioEj, P.NrSaldo, E.Tipo, P.Especie ")

ACN(xx:1, 0)
ACN(xx:2, 0)
ACN(xx:3, 0)
ACN(yy:1, 0)
ACN(yy:2, 0)
ACN(yy:3, 0)


ACN(fi:1, fac+1)
Recorrer SQL
If Not Eqstr(Fbn['Especie'],Val(ES:1)) Y Not Eqstr(Val(ES:1),'')
      ***Totales por Book
      ACT(C:Fac,'Total '~Val(CA:1))
      **ACL(C:Fac, 'DPOSFU', Fecha1 =0, Radio1=0)
      ACN(G:Fac,Val(xx:1))
      ACN(I:Fac,Val(xx:2))
      ACN(M:Fac,Val(xx:3))
      ACN(xx:1,0)
      ACN(xx:2,0)
      ACN(xx:3,0)
      AgregarMarco(c:fac..x:fac,0,0)
      IFA
      ***Totales por Especie
      ACT(B:Fac,'Total '~Val(ES:1))
      ACN(G:Fac,Val(yy:1))
      ACN(I:Fac,Val(yy:2))
      ACN(M:Fac,Val(yy:3))
      AgregarMarco(a:fac..x:fac,0,0)
      ACN(yy:1,0)
      ACN(yy:2,0)
      ACN(yy:3,0)
      IFA
   Else
   If Not Eqstr(Fbn['Book'],Val(CA:1)) Y Not Eqstr(Val(ES:1),'')
         ***Totales por Book
         ACT(C:Fac,'Total '~Val(CA:1))
         **ACL(C:Fac, 'DPOSFU', Fecha1 =0, Radio1=0)
         ACN(G:Fac,Val(xx:1))
         ACN(I:Fac,Val(xx:2))
         ACN(M:Fac,Val(xx:3))
         ACN(xx:1,0)
         ACN(xx:2,0)
         ACN(xx:3,0)
         AgregarMarco(c:fac..x:fac,0,0)
         IFA
      EndIf
   EndIf 
   ACT(A:Fac,Fbn['Especie'])
   AgregarMarco(a:fac..x:fac,0,0,EXE('COLOR6'))
   IFA
   ACT(B:Fac,Fbn['Book'])
   ACD(C:Fac,Fbn['FechaEj'])
   ** ACL(C:Fac, 'DPOSFU', Fecha1 =Val(C:Fac), Radio1=0)
   ACN(D:Fac,COTIZACION(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1-1,1,NO))
   If Dialogo.Fecha1=Fbn['Fecha']
      ACN(E:Fac,Fbn['CantidadIni'])
      ACN(F:Fac,Fbn['PrecioIni'])
      ACN(G:Fac,Fbn['Cantidad1'])
      If Val(G:Fac)>0
        ACL(G:Fac, 'MOVOPF',Fecha1 =Val(C:Fac), Radio1=0, Book1= '', Mercado1= '')
      EndIf
      ACN(H:Fac,Fbn['Precio1'])
      ACN(I:Fac,Fbn['Cantidad2'])
      If Val(I:Fac)>0
        ACL(I:Fac, 'MOVOPF',Fecha1 =Val(C:Fac), Radio1=1, Book1= '', Mercado1= '')
      EndIf
      ACN(J:Fac,Fbn['Precio2'])
      ACN(M:Fac,Fbn['CantidadFin'])
      ACN(N:Fac,Fbn['PrecioFin'])
   Else
      ACN(E:Fac,Fbn['CantidadFin'])
      ACN(F:Fac,Fbn['PrecioFin'])
      ACN(G:Fac,0)
      ACN(H:Fac,0)
      ACN(I:Fac,0)
      ACN(J:Fac,0)
      ACN(M:Fac,Fbn['CantidadFin'])
      ACN(N:Fac,Fbn['PrecioFin'])
   EndIf   
      
   ACN(K:Fac,Val(J:Fac)-Val(H:Fac))
   ***PPPNETO
   ***1-PPC*CantidadCompra
   ACN(PP:Fac,Val(G:Fac)*Val(H:Fac))
   ***2-PPV*CantidadVenta
   ACN(PO:Fac,Val(I:Fac)*Val(J:Fac))
   ***(1-2)/CantTotal
   ACN(L:Fac,(Val(PP:Fac)-Val(PO:Fac))/(Val(G:Fac)-Val(I:Fac)))

   ACN(O:Fac,COTIZACION(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1,1,NO))
   **Cartera
   ACT(CA:1,Fbn['Book'])
   **Especie
   ACT(ES:1,Fbn['Especie'])
   
   ***Totales
   SCN(xx:1, Val(G:Fac))
   SCN(xx:2, Val(I:Fac))
   SCN(xx:3, Val(M:Fac))
   SCN(yy:1, Val(G:Fac))
   SCN(yy:2, Val(I:Fac))
   SCN(yy:3, Val(M:Fac))
   
