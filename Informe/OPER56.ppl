    SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
  EndIf

  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf



   if NoVacio(Dialogo.Cliente1)
      SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
   endif
   if NoVacio(Dialogo.Especie1)
      SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
   endif
   SQL.ADD(" and  (O.TipoOp Like 'VI%' ")
   SQL.ADD(" or  O.TipoOp Like 'TE%') ")
   SQL.ADD(" and  O.TipoOp Not In ('VIMD') ")
   SQL.ADD(" and  O.TipoOp Not In ('TEMD') ")
   if NoVacio(Dialogo.TipoOp1)
      SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
   endif
   SQL.ADD("order by O.TipoOp, O.NrOperacion ")

   acn(ca1,0)
   Recorrer SQL
     if val(ca1) = 0
        SetFilaActual(FAC+3)
 
        ACT(a:FAC, 'Operaciones Vinculadas')
        SetFont(a:fac..b:FAC,2)
        AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

        SetFilaActual(FAC+1)
        ACT(a:FAC, 'Numero Op.')
        ACT(b:FAC, 'Tipo Op.')
        ACT(c:FAC, 'F.Carga')
        ACT(d:FAC, 'F.Inicio')
        ACT(e:FAC, 'F.Concert.')
        ACT(f:FAC, 'Plazo')
        ACT(g:FAC, 'F.Vto.')
        ACT(h:FAC, 'Vehiculo')
        ACT(i:FAC, 'V.Contrap.')
        ACT(j:FAC, 'Saldo')
        ACT(k:FAC, 'Especie')
        ACT(l:FAC, 'Tasa') 
        ACT(m:FAC, 'Observaciones') 

        SetFont(a:fac..m:FAC,2)
        AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
 
        ifa
     endif
     acn(ca1,1)
     ACT(a:FAC, FBN['NrOperacion'])
     ACLO(a:FAC, FBN['NrOperacion'])
     ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
     ACD(c:FAC, FBN['FechaCargaSys'])
     ACD(d:FAC, FBN['FechaOp'])
     IF FBN['FechaOp2']=0
        ACD(e:FAC, FBN['FechaOp'])
     ELSE 
        ACD(e:FAC, FBN['FechaOp2'])
     ENDIF
     ACN(f:FAC, FBN['Plazo'])
     IF FBN['FechaVto']=0
        ACD(g:FAC, FBN['FechaOp'])
     ELSE 
        ACD(g:FAC, FBN['Fechavto'])
     ENDIF
     ACT(h:FAC, FBN['Vehiculo1'])
     ACT(i:FAC, FBN['Vehiculo2'])
     ACN(j:FAC, FBN['Cantidad'])
     ACT(k:FAC, FBN['Especie'])
     ACN(l:FAC, FBN['Precio1'])
     ACT(m:FAC, FBN['Observaciones'])

     SetFont(a:FAC..m:FAC,1)
     FormatoCeldas(f:fac..f:fac,"0")
     FormatoCeldas(i:fac..i:fac,Exe('F2'))
   proximo
EndIf

