   SQL.ADD(" and  O.TipoOp In ('SECSV','SECTV','SEVSV','SEVTV','SERAV','SERPV') ")

endif

SQL.ADD("order by O.TipoOp, O.NrOperacion ")

acn(ca1,0)
Recorrer SQL
  if val(ca1) = 0
     SetFilaActual(FAC+3)

     ACT(a:FAC, 'Titulos')
     SetFont(a:fac..b:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

     SetFilaActual(FAC+1)
     ACT(a:FAC, 'Numero Op.')
     ACT(b:FAC, 'Tipo Op.')
     ACT(c:FAC, 'F.Carga')
     ACT(d:FAC, 'F.Inicio')
     ACT(e:FAC, 'F.Concert.')
     ACT(f:FAC, 'Vehiculo')
     ACT(g:FAC, 'Especie')
     ACT(h:FAC, 'ContraEspecie')
     ACT(i:FAC, 'V.Nominal')
     ACT(j:FAC, 'Precio')
     ACT(k:FAC, 'F.Liquidacion')
     ACT(l:FAC, 'Plazo')
     ACT(m:FAC, 'Entidad')
     ACT(n:FAC, 'Observaciones')
     SetFont(a:fac..n:FAC,2)
     AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR'))
     ifa
  endif
  acn(ca1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaOp2'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Especie'])
  ACT(h:FAC, FBN['ContraEspecie'])
  ACN(i:FAC, FBN['Cantidad'])
  ACN(j:FAC, FBN['Precio1'])
  ACD(k:FAC, FBN['Fechavto'])
  ACN(l:FAC, FBN['Plazo'])

  IF Incluido(FBN['TipoOp'],'SECS|SECSV|SEVS|SEVSV')
     ACN(l:FAC,FBN['Plazo']/24)
  EndIf

  ACT(m:FAC, FBN['Cliente1'])
  ACT(n:FAC, FBN['Observaciones'])

  SetFont(a:FAC..m:FAC,1)
  FormatoCeldas(l:fac..l:fac,Exe('F0'))
  FormatoCeldas(i:fac..i:fac,Exe('F2'))
