ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo2  : "Grupo"     ;;;;Vacio(Dialogo.Vehiculo1);;Not EsTerminal(Dialogo.Vehiculo2, Vehiculos);'Debe ingresar un Grupo';NO;;;;;;"TipoVehiculo <> 'DIV'";
  Vehiculo1  : "Vehiculo"  ;;;;Vacio(Dialogo.Vehiculo2);;EsTerminal(Dialogo.Vehiculo1, Vehiculos) o Vacio (Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;;;;;;"TipoVehiculo = 'DIV'";;
  Cliente1   : "Entidad"      ;;;
  Especie1   : "Especie"      ;;;
  TipoOp1    : "Tipo Op."     ;;;
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  Radio1     : "Fecha|Carga|Inicio|Concertacion" ;;;;;;;;;0
  Radio2     : "Grupo|Todas|Terceros|Vinculadas" ;;;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

act(aa6,iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' ")) )

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)


SetFilaActual(4)
ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)
ACT(a:FAC, "Operaciones Concertadas en un Periodo")
SetFont(a:fac..a:fac,3)
SetFilaActual(5)
ACN(w1,FAC)

*if NoVacio(Dialogo.Vehiculo1)
*  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
*else
*  ACT(a:FAC+1, 'Vehiculo : Todos')
*endif

if NoVacio (Dialogo.Vehiculo2)
   ACT(a:FAC+1, 'Grupo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo2))
else
   ACT(a:FAC+1, 'Grupo : Todos')
endIf


if NoVacio (Dialogo.Vehiculo1)
   ACT(a:FAC+2, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+2, 'Vehiculo : Todos')
endIf


if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+3, 'Entidad : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+4, 'Especie : Todos')
endif

if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+5, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+5, 'Tipo Op. : Todos')
endif

ACT(a:FAC+6, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+7, 'Fecha Hasta: '~Dialogo.Fecha2)
act(a:fac+8, 'Fecha  '~iif(Dialogo.Radio1=0,'Carga',iif(Dialogo.Radio1=1,'Inicio','Concertacion')))
act(a:fac+9, 'Grupo  '~iif(Dialogo.Radio2=0,'Terceros y Vinculadas',iif(Dialogo.Radio2=1,'Terceros','Vinculadas')))

SetFont(a:fac..N:FAC+9,2)

SetFilaActual(FAC+10)

SQL.ADD(" Select NrOperacion,TipoOp,FechaCargaSys,FechaOp,FechaOp2,Vehiculo1,Especie, ")
SQL.ADD(" Cantidad,Plazo,FechaVto,Precio1,TotalNetoCli1,TotalBrutoCli1,Plazo3,Cliente1,MB3, ")
SQL.ADD(" FechaVto2,Precio2,TotalAux3, Observaciones ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" Where Vehiculo1 In ("~Pipe2Comillas(val(aa6))~") ")
if Dialogo.Radio1 = 0
   SQL.ADD("and O.FechaCargaSys between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD("and O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 2
   SQL.ADD("and O.FechaOp2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
*if NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
*endif


If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
EndIf


if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif

SQL.ADD(" and  O.TipoOp Like 'MM%' ")
SQL.ADD(" and  O.TipoOp Not In ('MMCPR','MMCPRV') ")

if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif

if Dialogo.Radio2=1
   SQL.ADD(" and  O.TipoOp Not In ('MMPCCM','MMPCCV','MMPV') ")
endif

if Dialogo.Radio2=2
   SQL.ADD(" and  O.TipoOp In ('MMPCCM','MMPCCV','MMPV') ")
endif
SQL.ADD("order by O.TipoOp, O.NrOperacion ")

acn(ca1,0)
Recorrer SQL
  if val(ca1) = 0
     ACT(a:FAC, 'Financieras a Plazo')
     SetFont(a:fac..b:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

     SetFilaActual(FAC+1)
     ACT(a:FAC, 'Numero Op.')
     ACT(b:FAC, 'Tipo Op.')
     ACT(c:FAC, 'F.Carga')
     ACT(d:FAC, 'F.Inicio')
     ACT(e:FAC, 'F.Concert.')
     ACT(f:FAC, 'Vehiculo')
     ACT(g:FAC, 'Especie')
     ACT(h:FAC, 'Capital')
     ACT(i:FAC, 'Plazo')
     ACT(j:FAC, 'F.Vto.')
     ACT(k:FAC, 'Tasa')
     ACT(l:FAC, 'Monto')
     ACT(m:FAC, 'Entidad')
     ACT(n:FAC, 'Toma/Coloc.')
     ACT(o:FAC, 'Observaciones')

     SetFont(a:fac..o:FAC,2)
     AgregarMarco(a:FAC..o:FAC,2,0,Exe('COLOR'))

     ifa
  endif
  acn(ca1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaOp2'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Especie'])
  ACN(h:FAC, FBN['Cantidad'])
  ACN(i:FAC, FBN['Plazo'])
  ACD(j:FAC, FBN['FechaVto'])
  ACN(k:FAC, FBN['Precio1'])
  ACT(o:FAC, FBN['Observaciones'])

  IF Incluido(FBN['TipoOp'],'MMONM|MMPCCM')
     * Tasa + Spread de la Primer Cuota
     ACN(k:fac,SQL("Select Precio4+Precio2 FROM "~DBO~".CUOTAS Where NrOperacion='"~FBN['NrOperacion']~"' AND NrCuota=1 "))
  EndIf

  ACN(l:FAC, FBN['TotalNetoCli1'])

  IF Incluido(FBN['TipoOp'],'MMCDP|MMCDIA|MMO|MMCCR')
     ACN(l:FAC, FBN['TotalBrutoCli1'])
  EndIf

  IF Incluido(FBN['TipoOp'],'MMPCCM')
     * Tasa + Spread de la Primer Cuota
     ACN(l:fac,SQL("Select Sum(Total1) FROM "~DBO~".CUOTAS Where NrOperacion='"~FBN['NrOperacion']~"' "))
  EndIf

  ACT(m:FAC, FBN['Cliente1'])

  if Incluido(FBN['TipoOp'],'MMPCCV|MMPCCM')
     ACT(n:FAC, iif(FBN['MB3']=0,'Prestamo','Colocacion'))
  endif

  IF Incluido(FBN['TipoOp'],'MMCDP') y NoVacio(FBN['FechaVto2'])
     ACD(j:FAC, FBN['FechaVto2'])
     ACN(k:FAC, FBN['Precio2'])
     ACN(l:FAC, FBN['TotalAux3'])
  EndIf

  SetFont(a:FAC..n:FAC,1)
  FormatoCeldas(i:fac..i:fac,"0")
  FormatoCeldas(h:fac..h:fac,Exe('F2'))
  FormatoCeldas(k:fac..k:fac,Exe('F7'))
  FormatoCeldas(l:fac..l:fac,Exe('F2'))
proximo

SQL.ADD("Select O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
if Dialogo.Radio1 = 0
   SQL.ADD("where O.FechaCargaSys between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 2
   SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif

*if NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
*endif

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
EndIf


if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.TipoOp Like 'FX%' ")

if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif

If Dialogo.Radio2=1
   SQL.ADD(" and  O.TipoOp Not In ('FXASV','FXATV','FXCSV','FXCTV','FXREPV','FXVSV','FXVTV') ")
endif

if Dialogo.Radio2=2
   SQL.ADD(" and  O.TipoOp In ('FXASV','FXATV','FXCSV','FXCTV','FXREPV','FXVSV','FXVTV') ")
endif

SQL.ADD("order by O.TipoOp, O.NrOperacion ")

acn(ca1,0)
Recorrer SQL

  if val(ca1) = 0
     SetFilaActual(FAC+3)

     ACT(a:FAC, 'Foreign Exchange')
     SetFont(a:fac..b:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

     SetFilaActual(FAC+1)
     ACT(a:FAC, 'Numero Op.')
     ACT(b:FAC, 'Tipo Op.')
     ACT(c:FAC, 'F.Carga')
     ACT(d:FAC, 'F.Inicio')
     ACT(e:FAC, 'F.Concert.')
     ACT(f:FAC, 'Vehiculo')
     ACT(g:FAC, 'Especie')
     ACT(h:FAC, 'Cantidad')
     ACT(i:FAC, 'Plazo')
     ACT(j:FAC, 'Precio')
     ACT(k:FAC, 'Monto')
     ACT(l:FAC, 'ContraEspecie')
     ACT(m:FAC, 'Entidad')
     ACT(n:FAC, 'Contrap.')
     ACT(o:FAC, 'Observaciones')

     SetFont(a:fac..o:FAC,2)
     AgregarMarco(a:FAC..o:FAC,2,0,Exe('COLOR'))
     ifa
  endif

  acn(ca1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaOp'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Especie'])
  if Incluido(FBN['TipoOp'],'FXREPO|FXREPV')
     if fbn['RB6'] = 0
        ACN(h:FAC, FBN['Cantidad'])
       else
        ACN(h:FAC, FBN['TotalBrutoCli1'])
     endif
     ACN(i:FAC, FBN['Plazo3'])
    else
     ACN(h:FAC, FBN['Cantidad'])
     ACN(i:FAC, FBN['Plazo'])
  endif
  ACN(j:FAC, FBN['Precio1'])

  ACN(k:FAC, FBN['TotalNetoCli1'])

  If Incluido(FBN['TipoOp'],'FXASV|FXATV|FXCSV|FXVSV|FXCTV|FXVTV')
      ACN(k:FAC, FBN['TotalBrutoCli1'])
  EndIf

  ACT(l:FAC, FBN['ContraEspecie'])
  ACT(m:FAC, FBN['Cliente1'])
  ACT(n:FAC, FBN['Observac2'])
  ACT(o:FAC, FBN['Observaciones'])

  SetFont(a:FAC..o:FAC,1)
  FormatoCeldas(i:fac..i:fac,"0")
  FormatoCeldas(h:fac..h:fac,Exe('F2'))
  FormatoCeldas(k:fac..k:fac,Exe('F2'))
  FormatoCeldas(j:fac..j:fac,Exe('F7'))
proximo

SQL.ADD("Select O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
if Dialogo.Radio1 = 0
   SQL.ADD("where O.FechaCargaSys between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 2
   SQL.ADD("where O.FechaOp2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
*if NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
*endif

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
EndIf



if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.TipoOp Like 'DP%' ")

if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif

if Dialogo.Radio2=1
   SQL.ADD(" and  O.TipoOp Not In ('DPSV') ")
endif

if Dialogo.Radio2=2
   SQL.ADD(" and  O.TipoOp In ('DPSV') ")
endif

SQL.ADD("order by O.TipoOp, O.NrOperacion ")

acn(ca1,0)
Recorrer SQL
  if val(ca1) = 0
     SetFilaActual(FAC+3)

     ACT(a:FAC, 'Derivados Comodities')
     SetFont(a:fac..b:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

     SetFilaActual(FAC+1)
     ACT(a:FAC, 'Numero Op.')
     ACT(b:FAC, 'Tipo Op.')
     ACT(c:FAC, 'F.Carga')
     ACT(d:FAC, 'F.Inicio')
     ACT(e:FAC, 'F.Concert.')
     ACT(f:FAC, 'Vehiculo')
     ACT(g:FAC, 'Entidad')
     ACT(h:FAC, 'Comodity')
     ACT(i:FAC, 'Volumen')
     ACT(j:FAC, 'Unidad')
     ACT(k:FAC, 'Precio')
     ACT(l:FAC, 'F.Vto.')
     ACT(m:FAC, 'Notional')
     ACT(n:FAC, 'Observaciones')

     SetFont(a:fac..n:FAC,2)
     AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR'))

     ifa
  endif
  acn(ca1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp2'])
  ACD(e:FAC, FBN['FechaOp'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Cliente1'])
  ACT(h:FAC, FBN['Especie'])
  ACN(i:FAC, FBN['Cantidad'])
  ACT(j:FAC, FBN['Umedida'])

  if Incluido(FBN['TipoOp'],'DPRRS|DPRS')
     ACN(k:FAC, FBN['TipoCambio2'])
    else
     if Incluido(FBN['TipoOp'],'DPRC')
        ACT(k:FAC, Fstr(FBN['TipoCambio2'],0,2)~' / '~Fstr(FBN['TipoCambio3'],0,2))
       else
        if FBN['PrecioEj'] = 0
           ACN(k:FAC, FBN['TipoCambio2'])
          else
           ACN(k:FAC, FBN['PrecioEj'])
        endif
     endif
  endif

  ACD(l:FAC, FBN['FechaEj'])
  ACN(m:FAC, FBN['TotalAux1'])
  ACT(n:FAC, FBN['Observaciones'])

  SetFont(a:FAC..n:FAC,1)
  FormatoCeldas(i:fac..i:fac,Exe('F2'))
  FormatoCeldas(m:fac..m:fac,Exe('F2'))
proximo

SQL.ADD("Select O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
if Dialogo.Radio1 = 0
   SQL.ADD("where O.FechaCargaSys between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if Dialogo.Radio1 = 2
   SQL.ADD("where O.FechaOp2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
*if NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
*endif

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
EndIf



if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
