SQL.ADD("group by O.TipoOp, O.NrOperacion, O.Cantidad, O.Especie, O.FechaCargaSys, O.FechaOp, ")
SQL.ADD(" O.PrecioEj, O.Precio1, O.FechaEj, O.Cliente1, O.Precio3, TotalAux3, O.Observaciones ")
SQL.ADD("order by 1, 2 ")

acn(ca1,0)
Recorrer SQL
  if val(ca1) = 0
     SetFilaActual(FAC+3)

     ACT(a:FAC, 'Derivados Tasa')
     SetFont(a:fac..b:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

     SetFilaActual(FAC+1)
     ACT(a:FAC, 'Numero Op.')
     ACT(b:FAC, 'Tipo Op.')
     ACT(c:FAC, 'F.Carga')
     ACT(d:FAC, 'F.Inicio')
     ACT(e:FAC, 'F.Concert.')
     ACT(f:FAC, 'Contratos')
     ACT(g:FAC, 'Notional')
     ACT(h:FAC, 'Precio')
     ACT(i:FAC, 'Plazo')
     ACT(j:FAC, 'Prima')
     ACT(k:FAC, 'Fecha Exp.')
     ACT(l:FAC, 'Entidad')
     ACT(m:FAC, 'Observaciones')

     SetFont(a:fac..m:FAC,2)
     AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
     ifa
  endif
  acn(ca1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp2'])
  ACD(e:FAC, FBN['FechaOp'])
  ACT(f:FAC, FBN['Especie'])
  if Incluido(FBN['TipoOp'],'DTSFVM|DTSFFM|DTSVVM|DTCAP|DTFLO|')
     ACN(g:FAC, FBN['TotalAux3'])
     ACN(i:FAC, SQL("Select Sum(Plazo1) from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' "))
     ACD(k:FAC, SQL("Select Max(Fecha2) from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' "))
     ACD(d:FAC, SQL("Select Fecha1 from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' and NrCuota = 1 "))
  else
     if Incluido(FBN['TipoOp'],'DTK|DTKVI|DTSFVX|DTSNFF|DTSNVV|')
        ACN(g:FAC, SQL("Select Cantidad1 from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' and NrCuota = 1 "))
        ACN(i:FAC, SQL("Select Sum(Plazo1) from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' "))
        ACD(k:FAC, SQL("Select Max(Fecha2) from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' "))
     else
        ACN(g:FAC, FBN['Cantidad'])
        ACN(i:FAC, FBN['Plazo'])
        ACD(k:FAC, FBN['FechaEj'])
     endif
  endif

  if Incluido(FBN['TipoOp'],'DTOM|DTOMV')
     ACN(h:FAC, SQL("Select Precio1 from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' and NrCuota = 1 "))
    else
     if Incluido(FBN['TipoOp'],'DTSFV|DTSFF|DTSVV|DTSFVV')
        ACN(h:FAC, FBN['Precio3'])
       else
        if Incluido(FBN['TipoOp'],'DTSFVM|DTSFFM|DTSVVM|DTK|DTKVI|DTC|DTF|DTSFVX')
           ACN(h:FAC, SQL("Select Precio1 from "~DBO~".CUOTAS Where NrOperacion = '"~fbn['NrOperacion']~"' and NrCuota = 1 "))
          else
           ACN(h:FAC, FBN['PrecioEj'])
        endif
     endif
  endif
  ACN(j:FAC, FBN['Precio1'])
  ACT(l:FAC, FBN['Cliente1'])
  ACT(m:FAC, FBN['Observaciones'])

  SetFont(a:FAC..m:FAC,1)
  FormatoCeldas(i:fac..i:fac,"0")
  FormatoCeldas(i:fac..i:fac,Exe('F2'))
proximo

