* CONCOT - Conversion de Cotizaciones
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'  ; ; ; ;  ;  ;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;Fecha('23/05/2008')
  Check1   : 'Procesa'; ; ; ;NO;SI;;;;0;
FinDialogo
If Not Ok
   Cancelar
Endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:FAC, 'Fecha:')
ACT(b:FAC, Dialogo.Fecha1)
SetFont(a:FAC..b:FAC,3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'CallPut')
ACT(d:FAC, 'FechaEj')
ACT(e:FAC, 'PrecioEj')
ACT(f:FAC, 'Precio1')
ACT(g:FAC, 'Precio2')
ACT(h:FAC, 'Precio3')
ACT(i:FAC, 'Precio4')
ACT(j:FAC, 'Precio5')
ACT(k:FAC, 'Precio6')
ACT(l:FAC, 'Precio7')
ACT(m:FAC, 'Cotiza en')
ACT(n:FAC, 'Estado')
ACT(o:FAC, 'CotBNABCU')
ACT(p:FAC, 'CotBCU')

ACT(r:FAC, 'PreFue '~Var('MONEFUERTE'))
ACT(s:FAC, 'PreGru '~Var('MONEGRUPO'))
ACT(t:FAC, 'PreUru '~Var('MONEURU'))
ACT(u:FAC, 'Cant.')


SetFont(a:FAC..az:FAC,2)
ACN(w:1, FAC)

SQL.ADD(" Select C.*, E.Cotiza ")
SQL.ADD("   from "~DBO~".COTIZACIONES C, "~DBO~".ESPECIES E ")
SQL.ADD("  where C.Codigo = E.Codigo ")
SQL.ADD("    and C.Fecha  = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("Order by C.CallPut, C.FechaEj, C.Codigo ")
recorrer SQL
   SCN(x:1, 1)
   ACD(a:FAC, fbn('Fecha'))
   ACT(b:FAC, fbn('Codigo'))
   ACT(c:FAC, fbn('CallPut'))
   ACD(d:FAC, fbn('FechaEj'))
   ACN(e:FAC, fbn('PrecioEj'))
   ACN(f:FAC, fbn('Precio1'))
   ACN(g:FAC, fbn('Precio2'))
   ACN(h:FAC, fbn('Precio3'))
   ACN(i:FAC, fbn('Precio4'))
   ACN(j:FAC, fbn('Precio5'))
   ACN(k:FAC, fbn('Precio6'))
   ACN(l:FAC, fbn('Precio7'))
   ACT(m:FAC, fbn('Cotiza'))
proximo

if Val(x:1)>0
  ** Calculo de Cotizaciones
  recorrer&i Val(w:1)+1,Val(x:1)+3

    ACT(n:&i, 'OK')
    if DesciendeDeEspecie(Val(b:&i),'INDICE')
      ACT(n:&i, 'ERROR')
    endif

    if EqStr(Val(n:&i),'OK')
      ACN(r:&i, CotizacionC(Val(b:&i),,,,Dialogo.Fecha1,1,SI,VAR('MONEFUERTE')))
      ACN(s:&i, CotizacionC(Val(b:&i),,,,Dialogo.Fecha1,1,SI,VAR('MONEGRUPO')))
      if EqStr(Val(m:&i),'ARP')
        ACN(o:&i, CotizacionBNABCU('USD',Dialogo.Fecha1,1,SI,NO))
        ACN(t:&i, Val(f:&i)*CotizacionBNABCU('USD',Dialogo.Fecha1,1,SI,NO))
      else
        ACN(p:&i, CotizacionBCU(Val(m:&i),Dialogo.Fecha1,1,SI,NO))
        ACN(t:&i, Val(f:&i)*CotizacionBCU(Val(m:&i),Dialogo.Fecha1,1,SI,NO))
      endif
    endif

    if EqStr(Val(n:&i),'OK')
      SQL.ADD("Select Count(*) as Cant ")
      SQL.ADD("  from "~DBO~".COTIZACIONES ")
      SQL.ADD(" where Fecha  = '"~IdxDate(Val(a:&i))~"' ")
      SQL.ADD("   and Codigo = '"~Val(b:&i)~"'  ")
      SQL.ADD("   and IsNull(CallPut,'') = '"~Val(c:&i)~"' ")
      SQL.ADD("   and IsNull(FechaEj,0)  = '"~IdxDate(Val(d:&i))~"' ")
      SQL.ADD("   and IsNull(PrecioEj,0) = "~FStr(Val(e:&i),1,8)~" ")
      recorrer SQL
        DFA
        ACN(u:&i, fbn('Cant'))
      proximo
      if Val(u:&i)<>1
        ACT(v:&i, 'Error buscando update')
      else
        ACT(v:&i, 'Update')
        if Dialogo.Check1=1
          SQL.ADD("Update "~DBO~".COTIZACIONES ")
          SQL.ADD("   Set Precio5  = "~FStr(Val(r:&i),1,8)~", ")
          SQL.ADD("       Precio6  = "~FStr(Val(s:&i),1,8)~", ")
          SQL.ADD("       Precio7  = "~FStr(Val(t:&i),1,8)~" ")
          SQL.ADD(" where Fecha    = '"~IdxDate(Val(a:&i))~"' ")
          SQL.ADD("   and Codigo   = '"~Val(b:&i)~"'  ")
          SQL.ADD("   and IsNull(CallPut,'') = '"~Val(c:&i)~"' ")
          SQL.ADD("   and IsNull(FechaEj,0)  = '"~IdxDate(Val(d:&i))~"' ")
          SQL.ADD("   and IsNull(PrecioEj,0) = "~FStr(Val(e:&i),1,8)~" ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
    endif

  proximo
  FormatoCeldas(e:Val(w:1)+1..l:FAC, Exe('F6'))
  FormatoCeldas(o:Val(w:1)+1..p:FAC, Exe('F6'))
  FormatoCeldas(r:Val(w:1)+1..t:FAC, Exe('F6'))
  FormatoCeldas(u:Val(w:1)+1..u:FAC, Exe('F0'))
  SetFont(a:Val(w:1)+1..z:FAC, 1)
endif

SetFont(v:1..x:1, 1)
