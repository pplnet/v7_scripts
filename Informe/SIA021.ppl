**************   OPERACIONES  ***********************

*--  Select


  SQL.ADD(" Select  a.*  " )
  SQL.ADD("   from   "~DBO~".Operaciones a " )
*  SQL.ADD(" where  a.nroperacion = a.nroperacion ")
