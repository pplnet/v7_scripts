  SQL.ADD("   and  a.fechaCarga >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
*  SQL.ADD("   and  a.fechaCarga <= '"~IdxDate(Dialogo.Fecha2)~"' ")
  SQL.ADD("   and  a.fechaCarga < '"~IdxDate(Dialogo.Fecha2 + 1)~"'  ")
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND a.vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
  Endif
  SQL.ADD("order by a.nroperacion ")


