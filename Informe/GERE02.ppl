*ModoReproceso(ConDialogo)
CrearDialogo
  Lista1     : "Vehiculo"                      ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio3     : "Consolidado|No|Si"             ;;;;;;;;;0
  Radio1     : "Tipo|Todos|Rta.Fija|Rta.Vble." ;;;;;;;;;0
  Especie1   : "Especie"                       ;;;
  Fecha3     : "F.Posicion"                    ;;;;;;Dialogo.Fecha3<>0;'Fecha Incorrecta';NO;Fsys
  Fecha1     : "F.Desde"                       ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys-1
  Fecha2     : "F.Hasta"                       ;;;;NO;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys;Dialogo.Fecha3
  Radio4     : "Fecha|Concert.|Vencimiento"    ;;;;NO;;;;;1
  Radio2     : "Posc.|Spot|Spot+Termino"       ;;;;;;;;;0
  Precio1    : "Costo_Oportunidad"             ;;;;;;Dialogo.Precio1>0;'Debe Indicar el Costo de Oportunidad';NO;Var('COSTOOP')
FinDialogo
if not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Cartera de Titulos Publicos y Privados")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio3=1
   ACT(a:FAC+2, 'Vehiculo : CONSOLIDADO' )
Endif

If Dialogo.Radio2=0
   ACT(a:FAC+3, 'Operaciones Spot ' )
Else   
   ACT(a:FAC+3, 'Operaciones Spot y Termino' )
Endif

ACT(a:FAC+4, 'Tipo Especie : '~iif(Dialogo.Radio1=0,'Todos',iif(Dialogo.Radio1=1,'Renta Fija','Renta Variable')))

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+5, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+5, 'Especie : Todos')
endif

ACT(a:FAC+6, 'Fecha Posicion : '~Dialogo.Fecha3)
ACT(a:FAC+7, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+8, 'Fecha Hasta : '~Dialogo.Fecha2)
act(d:fac+9,'Tasa para Costo de Oportunidad')
act(f:fac+9,Dialogo.Precio1)

SetFont(a:fac..N:FAC+9,2)

SetFilaActual(FAC+9)


**--------------------------------------------------------------
**- Calculo del VN. de la Posicion, Precio Promedio y Precio de Mercado
**--------------------------------------------------------------
SQL.ADD(" Select E.Cotiza,")
IF Dialogo.Radio3=0
   SQL.ADD(" S.Vehiculo, S.Cliente, ")
ELSE
   SQL.ADD(" 'Consolidado' Vehiculo, S.Cliente, ")
EndIf
SQL.ADD("CASE E.Tipo WHEN 'PUB' THEN 'F' WHEN 'ONE' THEN 'F' WHEN 'PRI' THEN 'V' ELSE 'V' END Tip,E.InteresesC, S.Especie,")
SQL.ADD(" Sum(S.CantidadFin) CantidadFin, Sum(S.PrecioFin) PrecioFin, ")
SQL.ADD(" Sum(S.CantidadIni) CantidadIni, Sum(S.CantidadIni*S.PrecioIni) MontoIni, ")
SQL.ADD(" Sum(S.Cantidad1) Cantidad1, Sum(S.Cantidad1*S.Precio1) Monto1, ")
SQL.ADD(" Sum(S.Cantidad2) Cantidad2, Sum(S.Cantidad2*S.Precio2) Monto2, ")
SQL.ADD("CASE E.Tipo WHEN 'PUB' THEN 'F' WHEN 'ONE' THEN 'F' WHEN 'PRI' THEN 'V' ELSE 'V' END Tip ")
SQL.ADD("from "~DBO~".POSICIONES S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  and (E.EsCupon<>'SI' or E.EsCupon Is Null)")
SQL.ADD(" and E.Tipo In ('PUB','ONE','PRI') ")
If Dialogo.Radio1=1
   SQL.ADD(" and E.Tipo In ('PUB','ONE') ")
endif
if Dialogo.Radio1=2
   SQL.ADD(" and E.Tipo In ('PRI') ")
endif
if Dialogo.Radio2=1
   SQL.ADD(" and (S.NrSaldo=101 or S.NrSaldo=201) ")
Else
   SQL.ADD(" and S.NrSaldo=101 ")
Endif
If NoVacio(val(zz6))
   SQL.ADD(" and S.Vehiculo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and S.Especie = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("and S.Vehiculo =S.Cliente ")
SQL.ADD("and (S.CallPut is Null or S.CallPut = ' ') ")
SQL.ADD("and S.Fecha = (Select Max(D.Fecha) from "~DBO~".POSICIONES D ")
SQL.ADD("              where D.Vehiculo = S.Vehiculo ")
SQL.ADD("              and   D.Especie = S.Especie  ")
SQL.ADD("              and   D.NrSaldo=S.NrSaldo ")
SQL.ADD("              and   (D.CallPut is Null or D.CallPut = ' ') ")
SQL.ADD("              and   D.Cliente = S.Cliente  ")
SQL.ADD("              and   D.Fecha <= '"~IdxDate(Dialogo.Fecha3)~"' ) ")
IF Dialogo.Radio3=1
   SQL.ADD("Group by E.Cotiza,E.InteresesC,S.Especie,E.Tipo, S.Cliente ")
   SQL.ADD("Order by E.Cotiza,E.Tipo,S.Especie ")
Else   
   SQL.ADD("Group by E.Cotiza, S.Vehiculo, S.Cliente, E.InteresesC,S.Especie,E.Tipo ")
   SQL.ADD("Order by E.Cotiza, S.Vehiculo, S.Cliente, E.Tipo,S.Especie")
EndIf

acn(x1,0)
act(v1,' ')
act(v2,' ')
act(v3,' ')
acn(ba1,0)

* Para Cada Saldo Recupero la Posicion y los Repo
Recorrer SQL
   Message('Comienzo del informe')  
   ACT(p1,FBN['Especie'])

   IF Dialogo.Radio3=0
      ACT(p2,FBN['Vehiculo'])
   EndIf

   Message('Recuperando Saldos '~VAL(p1)~' '~VAL(p2))

   if Not EqStr(val(v1),fbn['Cotiza'])
      ifa
      ifa
      act(a:fac,'Moneda de la Especie: '~BuscarCampo('Especies','Nombre','Codigo',fbn['Cotiza']))
      act(v1,fbn['Cotiza'])
      SetFont(a:fac..r:FAC,3)
      ifa
      ifa
      If Dialogo.Radio3=0
         act(a:fac,'Vehiculo: '~fbn['Vehiculo']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['Vehiculo']))
         act(v2,fbn['Vehiculo'])
      EndIf

      SetFont(a:fac..r:FAC,2)
      ifa
      ifa
      (.'TITGERE02'.)
      ifa
      ifa
      ifa

      act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
      act(v3,fbn['Tip'])
      SetFont(a:fac..r:FAC,2)
   endif

   if Dialogo.Radio3=0 
      if Not EqStr(val(v2),fbn['Vehiculo'])
         ifa
         ifa
         act(a:fac,'Vehiculo: '~fbn['Vehiculo']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['Vehiculo']))
         act(v2,fbn['Vehiculo'])
         SetFont(a:fac..r:FAC,2)
         ifa
         ifa
         (.'TITGERE02'.)
         ifa
         ifa
         ifa
         act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
         act(v3,fbn['Tip'])
         SetFont(a:fac..r:FAC,2)
      endif
   endif

   if Not EqStr(val(v3),fbn['Tip'])
      ifa
      act(a:fac,iif(EqStr(fbn['Tip'],'F'),'Renta Fija','Renta Variable'))
      act(v3,fbn['Tip'])
      SetFont(a:fac..r:FAC,2)
   endif

   ACN(y3,0)

   act(a:fac, fbn['Especie'])
   acn(b:fac, fbn['CantidadFin'])

   IF VAL(b:fac)<>0
      * Formula de Precio Promedio => 
      * (Cant.Inic*PrecioInic+(Cant.Compra*PPCompra)-(Cant.Vta*PPVta))/(Cant.Inicial+ Cant.Compra-Cant.Vta)
      acn(c:fac, (fbn['MontoIni']+fbn['Monto1']-fbn['Monto2'])/(fbn['CantidadIni']+fbn['Cantidad1']-fbn['Cantidad2']))
   Else
      acn(c:fac, 0)
   EndIf
  
   If EqStr(fbn['InteresesC'],'DIR')
      acn(d:fac,Cotizacion(fbn['Especie'],,,,Dialogo.Fecha3,1))
      acn(x:fac,0)
   Else
      *** calcula precio sucio ***
      act(ca:fac,fbn['Especie'])
      acd(ck:fac,Dialogo.Fecha3)
 
      (.'SUCIO'.)
      acn(d:fac,val(ci:fac)*(Cotizacion(fbn['Especie'],,,,Dialogo.Fecha3,1)+val(cj:fac))) 
      acn(x:fac,val(ci:fac)*fbn['CantidadFin']*val(cj:fac)) 
   EndIf

   ****
   SCN(ba1,1)
   LinkearHoja('GERE03',val(ba1),Lista1=FBN['Vehiculo'],Radio5=Dialogo.Radio3,Radio1=Dialogo.Radio1,Especie1=FBN['Especie'],Cliente1='',Radio3=0,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2+1,Radio4=Dialogo.Radio4,Radio2=Dialogo.Radio2)

   **
   * Cap.Promedio y CostoOp
   acn(e:fac, LINKH(Val(ba1),o3) )
   acn(f:fac,val(e:fac)*Dialogo.Precio1*(Dialogo.Fecha2-Dialogo.Fecha1+1)/36500)

   acn(g:fac, LINKH(Val(ba1),p3))
   acn(h:fac,val(g:fac)*Dialogo.Precio1*(Dialogo.Fecha2-Fecha('01/01/'~Copy(Dialogo.Fecha1,7,4))+1)/36500)

   * P/L y Rendimiento Tenencia
   acn(i:fac, LINKH(Val(ba1),o1))
   acn(j:fac, LINKH(Val(ba1),o2))

   acn(k:fac, LINKH(Val(ba1),p1))
   acn(l:fac, LINKH(Val(ba1),p2))

   SetFont(a:FAC..l:FAC,1)
   FormatoCeldas(c:fac..d:fac,Exe('F6'))
   FormatoCeldas(b:fac..b:fac,Exe('F2'))
   FormatoCeldas(e:fac..i:fac,Exe('F2'))
   FormatoCeldas(k:fac..k:fac,Exe('F2'))

   *-- y3: Posicion de Especie
   ACN(y3,VAL(b:fac))

   *--------------------------------------------------------------------------
   *-- Apertura por Cartera.
   Message('Desdoblo la Posicion en HM, SA, AS y TR')
   *--------------------------------------------------------------------------
   ACN(nc1,110)

   Recorrer&i 0,3
      ACT(nc3,FBN['Especie'])
  
      If Dialogo.Radio3=0   
         ACT(nc4,FBN['Vehiculo'])
         ACT(nc5,FBN['Cliente'])
      EndIf
      (.'CASHAPERCA'.)
      If VAL(nc2)<>0 
         ifa
         If val(nc1)=110 
            act(a:fac, ' ... HM' )
         EndIf
         If val(nc1)=111 
            act(a:fac, ' ... SA' )
         EndIf
         If val(nc1)=112 
            act(a:fac, ' ... AS' )
         EndIf
         If val(nc1)=113 
            act(a:fac, ' ... TR' )
         EndIf
         acn(b:fac,VAL(nc2))        
         SetFont(a:FAC..l:FAC,1)
         FormatoCeldas(c:fac..d:fac,Exe('F6'))
         FormatoCeldas(b:fac..b:fac,Exe('F2'))
      EndIf
      SCN(nc1,1)
   Proximo

   Message('Display de Repos Activos y Pasivos')

   **-- Selecciono aquellos repos que alguna pata esta activa
   SQL.ADD("Select O.*  ")  
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where ")
   IF Dialogo.Radio3=0
      SQL.ADD("Vehiculo1= '"~VAL(p2)~"' and ")
   EndIf
   SQL.ADD("      Especie = '"~VAL(p1)~"' ")
   SQL.ADD(" and  FechaOp2<= '"~IdxDate(Dialogo.Fecha3)~"' ")
   SQL.ADD(" and  (FechaVto>= '"~IdxDate(Dialogo.Fecha3)~"' or FechaVto2>='"~IdxDate(Dialogo.Fecha3)~"') ")
   SQL.ADD(" and  TipoOp In ('SERA','SERAV','SERP','SERPV') ") 
   SQL.ADD(" Order By FechaVto ")
 
   ACN(y1,0)

   Recorrer SQL
     Message('Dentro de Repo')  

     IF VAL(y1)=0
        *-- Titulos
        ACT(a:FAC, 'NrOperacion')
        ACT(b:FAC, 'Tipo')
        ACT(c:FAC, 'Cantidad')
        ACT(d:FAC, 'Fecha Op.')
        ACT(e:FAC, 'F.Liq.Spot')
        ACT(f:FAC, 'F.Liq.Fut')
        ACT(g:fac, 'V.N. Disp.')
 
        SetFont(a:fac..l:FAC+2,2)
        AgregarMarco(a:FAC..g:FAC,2,0,Exe('COLOR6'))
        ACN(y2,fac)
        IFA
     EndIf

     ACT(a:FAC, FBN['NrOperacion'])
     ACT(b:FAC, FBN['TipoOp'])
     ACN(c:FAC, IIF(Incluido(FBN['TipoOp'],'SERA|SERAV'),-FBN['Cantidad'],FBN['Cantidad']))
     ACD(d:FAC, FBN['FechaOp2'])
     ACD(e:FAC, FBN['FechaVto'])
     ACD(f:FAC, FBN['FechaVto2'])

     * link con consulta de operaciones
     ACLO(a:fac,Val(a:fac))

     IF VAL(e:fac) > Dialogo.Fecha3
        SetFont(a:FAC..g:FAC,2)
     Else
        ACN(g:fac, VAL(y1)+VAL(c:fac)+VAL(y3) )
        SCN(y1,VAL(c:fac))
        SetFont(a:FAC..g:FAC,1)
     EndIf

     FormatoCeldas(g:fac..g:fac,Exe('F2'))
     FormatoCeldas(c:fac..c:fac,Exe('F2'))    
  Proximo
  Message('Al final del Informe')  
  If VAL(Y1)<>0
     AgregarMarco(a:val(y2)..g:FAC,2,0)
     ifa
  EndIf
Proximo

ACO(1,8)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)
ACO(11,10)
ACO(12,10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(l:FAC)
*
*    Esto es lo que agrega Silvia
*
RangoTitulo(a:1..l:FAC, 14)
