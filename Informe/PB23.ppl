ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:   'D.FechaMov' ;1;1;;;;;;;fsys
  Fecha2:   'H.FechaMov' ;1;2;;;;;;;fsys
  Radio1:   'Tipo|Depositos|Retiros|Ambos';2;1;;;;;;;2
  Radio3:   'Estado|Ejecutado|Pendiente|Todos';3;1;;;;;;;2
  Radio2 : 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;4;1;;;;;;;4
  Check1:  'Incluye Pagadoras';5;1;;;;;;;1
  Lista1:   'Vehiculos' ; 6;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista4:   'Conceptos' ; 0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CNCONCEPTOSPAGOCOBRO ");
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ;-5;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(a:2, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:3, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:4, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:5, 'Conceptos: '~iif(vacio(Dialogo.Lista4),'Todos',Pipe2Comillas(Dialogo.Lista4)))
If Dialogo.Radio2=0
  ACT(a:6, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:6, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:6, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:6, 'Tipo de Cta: Caja de Ahorro')
Endif
If Dialogo.Radio2=4
  ACT(a:6, 'Tipo de Cta: Todas')
Endif
If Dialogo.Check1=0
  ACT(a:6, Val(a:6)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:6, Val(a:6)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:2..a:6,2)

ACT(c:7, 'Movimientos por Concepto del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
