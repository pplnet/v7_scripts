IFA
IF Dialogo.Radio3=1 o Dialogo.Radio3=2
  SQL.ADD(" SELECT M.Especie, M.Cuenta, M.FechaMov, M.Cantidad, M.NrOperacion, M.Leyenda, ")
  SQL.ADD(" T.Cambio1, T.Cantidad2, CL.RazonSocial, C.Numero, E.Nombre, 'Pendiente' Estado, ")
  SQL.ADD(" T.Proveedor, T.Vehiculo1, CP.Descripcion, T.ConceptoPago, C.Comitente, FP.Tipo, ")
  SQL.ADD("  T.CodigoDatanet1, CD.Descripcion DescripcionCD, CD.Tipo TipoCD, TC.Descripcion DescripcionTC ")
  SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES CL, "~DBO~".ESPECIES E, ")
  SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, "~DBO~".CNCONCEPTOSPAGOCOBRO CP, ")
  SQL.ADD(" "~DBO~".CNFORMASPAGOCOBRO FP, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TC ")
  SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
  SQL.ADD(" AND   C.Comitente= CL.Codigo ")
  SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
  SQL.ADD(" AND   M.Especie  = E.Codigo ")
  SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
  *SQL.ADD(" AND   T.CNFormaPago  *= FP.Codigo  ")
  *SQL.ADD(" AND   T.CodigoDatanet1 *= CD.Codigo  ")
  *SQL.ADD(" AND   CD.Tipo          *= TC.Codigo  ")
  SQL.ADD(" AND   T.CNFormaPago  = FP.Codigo  ")
  SQL.ADD(" AND   T.CodigoDatanet1 = CD.Codigo  ")
  SQL.ADD(" AND   CD.Tipo          = TC.Codigo  ")
  If Dialogo.Radio1=0
    SQL.ADD(" AND   (T.TipoTr2 IN ('CRVM') OR  (T.TipoTr2 IN ('TRANSF') AND M.Cantidad >0) ) ")
  Endif
  If Dialogo.Radio1=1
    SQL.ADD(" AND   (T.TipoTr2 IN ('DEVM') OR  (T.TipoTr2 IN ('TRANSF') AND M.Cantidad <0) ) ")
  Endif
  If Dialogo.Radio1=2
    SQL.ADD(" AND   T.TipoTr2  IN ('DEVM','CRVM','TRANSF') ")
  Endif
  SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
  If NoVacio(Dialogo.Lista4)
    SQL.ADD(" AND   CP.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
  Endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  Endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  Endif
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  If Dialogo.Radio2=0
    SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
  Endif
  If Dialogo.Radio2=1
    SQL.ADD(" AND C.TipoCuenta IN ('INT')")
  Endif
  If Dialogo.Radio2=2
    SQL.ADD(" AND C.TipoCuenta IN ('REC')")
  Endif
  If Dialogo.Radio2=3
    SQL.ADD(" AND C.TipoCuenta IN ('CA')")
  Endif
  If Dialogo.Check1=0
    SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
  Endif
Endif
IF Dialogo.Radio3=2
  SQL.ADD(" UNION ALL ")
Endif
IF Dialogo.Radio3=0 o Dialogo.Radio3=2
  SQL.ADD(" SELECT M.Especie, M.Cuenta, M.FechaMov, M.Cantidad, M.NrOperacion, M.Leyenda, ")
  SQL.ADD(" T.Cambio1, T.Cantidad2, CL.RazonSocial, C.Numero, E.Nombre, 'Ejecutado' Estado, ")
  SQL.ADD(" T.Proveedor, T.Vehiculo1, CP.Descripcion, T.ConceptoPago, C.Comitente, FP.Tipo, ")
  SQL.ADD(" T.CodigoDatanet1, CD.Descripcion DescripcionCD, CD.Tipo TipoCD, TC.Descripcion DescripcionTC ")
  SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES CL, "~DBO~".ESPECIES E, ")
  SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, "~DBO~".CNCONCEPTOSPAGOCOBRO CP, ")
  SQL.ADD(" "~DBO~".CNFORMASPAGOCOBRO FP, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TC ")
  SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
  SQL.ADD(" AND   C.Comitente= CL.Codigo ")
  SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
  SQL.ADD(" AND   M.Especie  = E.Codigo ")
  SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
  *SQL.ADD(" AND   T.CNFormaPago  *= FP.Codigo  ")
  *SQL.ADD(" AND   T.CodigoDatanet1 *= CD.Codigo  ")
  *SQL.ADD(" AND   CD.Tipo          *= TC.Codigo  ")
  SQL.ADD(" AND   T.CNFormaPago  = FP.Codigo  ")
  SQL.ADD(" AND   T.CodigoDatanet1 = CD.Codigo  ")
  SQL.ADD(" AND   CD.Tipo          = TC.Codigo  ")
  If Dialogo.Radio1=0
    SQL.ADD(" AND   (T.TipoTr2 IN ('CRVM') OR  (T.TipoTr2 IN ('TRANSF') AND M.Cantidad >0) ) ")
  Endif
  If Dialogo.Radio1=1
    SQL.ADD(" AND   (T.TipoTr2 IN ('DEVM') OR  (T.TipoTr2 IN ('TRANSF') AND M.Cantidad <0) ) ")
  Endif
  If Dialogo.Radio1=2
    SQL.ADD(" AND   T.TipoTr2  IN ('DEVM','CRVM','TRANSF') ")
  Endif
  SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
  If NoVacio(Dialogo.Lista4)
    SQL.ADD(" AND   CP.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
  Endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  Endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  Endif
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  If Dialogo.Radio2=0
    SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
  Endif
  If Dialogo.Radio2=1
    SQL.ADD(" AND C.TipoCuenta IN ('INT')")
  Endif
  If Dialogo.Radio2=2
    SQL.ADD(" AND C.TipoCuenta IN ('REC')")
  Endif
  If Dialogo.Radio2=3
    SQL.ADD(" AND C.TipoCuenta IN ('CA')")
  Endif
  If Dialogo.Check1=0
    SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
  Endif
Endif
SQL.ADD(" ORDER BY 16,17,1 ")

ACT(cp:1, '')
