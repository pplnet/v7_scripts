dfa
Recorrer SQL
  If Not eqstr(fbn('ConceptoPago'),Val(cp:1)) o Not eqstr(fbn('Especie'),Val(ea:1)) 
    If Not Eqstr(Val(cp:1),'')
      ACT(a:fac, 'Total '~Val(ba:2)~' ---> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      SCN(to:1, Val(d:fac))
      ifa
      ifa
      ACT(a:fac, 'Total '~Val(cp:2)~' en '~Val(ea:2)~' ---> ')
      ACN(d:fac, Val(to:1))
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      AgregarMarco(a:fac..k:fac,0,0,EXE('COLOR8'))
      ifa
    Endif

    ifa
    ifa
    ACT(a:fac, 'Concepto: '~fbn('Descripcion')~'   -   Moneda: '~fbn('Nombre'))
    AgregarMarco(a:fac..k:fac,0,0,EXE('COLOR8'))
    SetFont(a:fac,5)
    ACT(ba:1, '')
    ACN(to:1, 0)
  Endif

  If Not eqstr(fbn('Comitente'),Val(ba:1))
    If Not Eqstr(Val(ba:1),'')
      ACT(a:fac, 'Total '~Val(ba:2)~' ---> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      SCN(to:1, Val(d:fac))
    Endif
    ifa
    ifa
    ACT(a:fac, 'Banco: '~fbn('RazonSocial'))
    message('Banco: '~fbn('RazonSocial'))
    AgregarMarco(a:fac..k:fac,0,0,0)
    SetFont(a:fac,5)
    ifa
    ACN(fi:1,fac)
  Endif

  ACT(a:fac, fbn('Cuenta')~' - '~fbn('Numero'))
  ACT(b:fac, fbn('Vehiculo1'))
  ACD(c:fac, fbn('FechaMov'))
  ACN(d:fac, fbn('Cantidad'))
  ACT(e:fac, fbn('Proveedor'))
  If Eqstr(fbn('Tipo'),'CHE')
    ACT(f:fac, 'CH: '~FSTR(fbn('Cantidad2'),0,0))
  Else
    ACT(f:fac, FSTR(fbn('Cambio1'),0,0))
  Endif
  ACT(g:fac, fbn('NrOperacion'))
  ACLT(g:fac, fbn('NrOperacion'))
  ACT(h:fac, fbn('Leyenda'))
  ACT(i:fac, fbn('Estado'))
  IF Eqstr(fbn('Estado'), 'Pendiente')
    ColorCeldas(i:fac,clBlue)
  ELSE
    ColorCeldas(i:fac,clGreen)
  ENDIF
  ACT(j:fac, fbn('CodigoDatanet1')~'-'~fbn('DescripcionCD'))
  ACT(k:fac, fbn('TipoCD')~'-'~fbn('DescripcionTC'))

  SetFont(b:fac..i:fac,1)
  FormatoCeldas(d:fac, EXE('F2'))

  ACT(ea:1, fbn('Especie'))
  ACT(ea:2, fbn('Nombre'))
  ACT(ba:1, fbn('Comitente'))
  ACT(ba:2, fbn('RazonSocial'))
  ACT(cp:1, fbn('ConceptoPago'))
  ACT(cp:2, fbn('Descripcion'))
Proximo

