** R1 - ** Dialogo para solicitar Nro de Operacion
*-         
HojaVisible(Si)
Impresion(1,2)

ACN(WR:1,0)  * Contador Registros de Impuestos
ACN(WF:1,0)  * Contador de facturas   
ACN(WB:1,0)  * Contador de registros Exentos de Impuestos (Campo Sucursal)
ACN(LN:1,0) * Contador de Linea de Movim.
ACN(WK1,0)  * Acumulador de Registros Procesados 
ACT(CL:1, '5') * Workarea de clientes
ACT(cu:1, '')  
ACT(EX:1, 'Exento') 

CrearDialogo   
  NrOperacion1 : 'Operacion'   ;2;1;;;;;;;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('OPEIMPUEST'))~") ";  
  String1      : 'NrFactura'   ;;;;;NO;;;;;;;;; 
FinDialogo

If Not Ok
   Cancelar
Endif

** R2 - Construye la planilla de salida (Informe de Asignacion de Impuestos) 
*----------   

MostrarCuadroDeMensajes
CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,12,")
CrearFont(5,"Arial,11,B")
SetFilaActual(2)
ACT(a:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC, 'Asignacion de Impuestos')
SetFont(a:FAC, 5)
ifa
ACT(a:FAC+1,'Operacion:')
ACT(B:fac+1, Dialogo.NrOperacion1)
ACLO(B:fac+1, Dialogo.NrOperacion1)
If NoVacio(Dialogo.String1)
  ACT(a:FAC+2,'Nro. Factura: '~Dialogo.String1)
EndIf
SetFont(a:FAC+1..l:FAC+2, 5)

*SetFilaActual(FAC+1)
SetFilaActual(FAC+4)

ACT(A:FAC,'Factura')
ACT(B:FAC,'Fec.Fact')
ACT(C:FAC,'Vehiculo')
ACT(D:FAC,'Especie')
ACT(E:FAC,'Proveedor')
ACT(F:FAC,'Concepto')
ACT(G:FAC,'Fecha Mov')
ACT(H:FAC,'         ')
ACT(I:FAC,'Impuestos')
ACT(J:FAC,'         ')
ACT(K:fAC,'   Retenciones')
ACT(L:fAC,'  ')
ACT(M:fac, 'Cantidad')
ACT(N:fac, 'Usuario')
ACT(O:fac, 'Total Factura')

ACT(H:FAC+1,'Tipo' )
ACT(I:FAC+1,'      % ')
ACT(J:FAC+1,' Total')
ACT(K:fAC+1,'Tipo')
ACT(L:fAC+1,'Indicador')

SetFont(a:FAC..o:FAC+1,2)
AlinearCeldas(a:FAC..l:FAC+1,'C')
AlinearCeldas(h:FAC+1,'i')
AlinearCeldas(i:FAC+1,'D')
AlinearCeldas(j:FAC+1,'D')
AlinearCeldas(k:FAC+1,'i')
AlinearCeldas(l:FAC+1,'i')
AgregarMarco(a:FAC..o:FAC+1,0,0,Exe('COLOR'))
ifa

** R3 - Accede a la Base de Datos en busca de informacion (Impuestos)
*--------
ACN(FI:1, fac+1)
SQL.ADD(" SELECT *  ")
SQL.ADD(" FROM   "~DBO~".IMPUESTOS ")
SQL.ADD(" WHERE  NrOperacion  = '"~Dialogo.NrOperacion1~"'  ")
SQL.ADD(" AND (Check2 = 0 Or Check2 = Null)")
SQL.ADD(" AND (Check3 = 0 Or Check3 = Null)")

If NoVacio(Dialogo.String1)
  SQL.ADD(" AND NrSisExterno ='"~Dialogo.String1~"' ")
EndIf

SQL.ADD(" ORDER BY NrSisExterno, Vehiculo1 ")

Recorrer SQL
        ***** R5 - Formateo del Informe ********************* Parte fIJA *******          
        ifa
        ACT(A:fac, fbn('NrSisExterno'))
        ACt(C:fac, BuscarCampo('Vehiculos','Descripcion','Codigo',fbn('Vehiculo1')))    
        ACT(D:fac, fbn('Especie1'))
        ACT(E:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',fbn('Cliente1')),1,26))
        ACT(F:fac, Copy(fbn('String22'),1,27))
        ACT(B:fac, Fecha(fbn('Fecha1'),'dd-mm-yyyy'))
        ACT(G:fac, Fecha(fbn('Fecha2'),'dd-mm-yyyy'))
        ACN(M:fac, FBN['Cantidad1'])
        ACT(N:fac, FBN['String23'])
        ACN(O:fac, FBN['Cantidad2'])
        FormatoCeldas(m:fac..o:fac,Exe('F2'))
        **************************************** Formateo del detalle (Loop)
        IF Eqstr(fbn('Check1'), '1')
           ACT(H:fac, fbn('Sucursal'))
        ENDif
        ACN(FI:1, fac)
        Recorrer&i 1, 10
           IF NoVacio(fbn('String'~Fstr(&i+10, 0, 0) ))
                      ********* Detalle de Impuestos
             IF &i > 1
                ifa
             ENDIF
             ACT(WK:1, FBN('String'~Fstr(&i+10, 0, 0)))
             ACT(H:FAC,val(WK:1)~'-'~BuscarCampo('TiposImpuesto','Descripcion','Codigo',Val(WK:1)))
             ACN(I:fac, FBN('Precio'~Fstr(&i, 0, 0)))
             ACN(J:fac, fbn('Total'~Fstr(&i, 0, 0)))          
           EndIF 
        Proximo
        Recorrer&i 1, 10
           IF NoVacio(fbn('String'~Fstr(&i, 0, 0) ))
                                      ********* Detalle de Retenciones
              ACT(ST:1, ItemLista(FBN('String'~Fstr(&i, 0, 0)),1))        
              ACT(ST:2, ItemLista(fbn('String'~Fstr(&i, 0, 0)),2)) 
              SQL.ADD(" Select Indicador,TipoRetencion,DescripcionIndicador From "~DBO~".RETENCIONES ")
              SQL.ADD(" Where TipoRetencion = '"~Val(ST:1)~"' ")
              SQL.ADD(" and   Indicador     = '"~Val(ST:2)~"' ")
              Recorrer SQL
                 DFA
                 ACT(WK:2, fbn('TipoRetencion'))
                 ACT(K:Val(FI:1) + &i-1,val(WK:2)~'-'~BuscarCampo('TiposRetencion','Descripcion','Codigo',Val(WK:2)))
                 ACT(L:Val(FI:1) + &i-1,val(ST:2)~'-'~fbn('DescripcionIndicador')) 
              Proximo
              IF Val(FI:1) + &i-1 >= fac
                 SetFilaActual(Val(FI:1) + &i)
              ENDIF
            ENDIF
       Proximo
Proximo

** R7 -  ENVIA MESAGEBOX  (VISUAL E IMPRESAS)
*-------
LimitesVision(o:Fac)

SetFont(A:Val(FI:1)..N:fac, 3)

ACO(1,9)    * Factura. 
ACO(2,7)     * FecFectura
ACO(3,9)    * Vehiculo
ACO(4,5)     * Especie
ACO(5,14)    * Provedor
ACO(6,15)    * Concepto
ACO(7,7)     * Fecha Mov
ACO(8,16)     * TIPO iMPUESTO
ACO(9,4)     * % COBRADO  
ACO(10,7)   * TOTAL IMPUESTO 
ACO(11,14)    * TIPO RETENCION
ACO(12,9)    * INDICADOR
ACO(15,8)
ifa
* MessageBox('  Fin Proceso ASIIMP  '~Dialogo. NrOperacion1)


SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 5)
SetPrintFit(3, 73)
SetMargins(0,1,0,1)