CrearDialogo
  String1: 'Cuenta'            ;;;;;;;;;;;SQLSet("Select Distinct Cuenta from "~DBO~".RELACIONCUENTA ")
  String2: 'Tipo de Cuenta'    ;;;;;;;;;;;SQLSet("Select Distinct Tabla from "~DBO~".RELACIONCUENTA ")
  Vehiculo1:   'Vehiculo'      ;;;;;;;;;Var('VEHICON')
  Book1:   'Book'              ;;;
  Check1: 'Cod numerico?'      ;;;;;;;;;0
FinDialogo

IF Not OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,BU')

ACT(a:2,'Detalle Relación Cuenta')
SetFont(a:2,3)

SetFilaActual(4)

ACT(a:fac, 'Cuenta: '~IIF(NoVacio(Dialogo.String1),Dialogo.String1,'Todas'))
ACT(a:fac+1, 'Tipo de Cuenta: '~IIF(NoVacio(Dialogo.String2),Dialogo.String2,'Todas'))
ACT(A:fac+2, 'Vehiculo: '~IIF(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todas'))

SetFont(a:fac..a:fac+4, 2)

SetFilaActual(fac+6)

ACT(a:fac, 'Codigo')
ACT(b:fac, 'TiposOperacion')
ACT(c:fac, 'Residente')
ACT(d:fac, 'BCRA')
ACT(e:fac, 'Sector')
ACT(f:fac, 'Especies')
ACT(g:fac, 'Cuenta')
ACT(h:fac, 'Tipo de Cuenta')
ACT(i:fac, 'Vehiculos')
ACT(j:fac, 'TiposGrupoEsp')
ACT(k:fac, 'TiposLiquidacion')
ACT(l:fac, 'Book')
ACT(m:fac, 'Moneda')
ACT(n:fac, 'Mercado')
ACT(o:fac, 'PlazoDesde')
ACT(p:fac, 'PlazoHasta')
ACT(q:fac, 'Custodia')
ACT(r:fac, 'Concepto')


AgregarMarco(a:fac..r:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..r:fac, 2)
AlinearCeldas(a:fac..r:fac, 'C')

SQL.ADD(" Select Codigo,TiposOperacion,Residente,Vinculado,Sector,Especies,Cuenta,Tabla,Vehiculos,TiposGrupoEsp,TiposLiquidacion,Book, ")
SQL.ADD(" Moneda,Mercado,PlazoDesde,PlazoHasta,Custodia,Concepto ")
SQL.ADD(" From "~DBO~".RELACIONCUENTA ")
if Dialogo.Check1 = 1
    SQL.ADD(" where isNumeric(Codigo)<>0 ")
else
    SQL.ADD(" where 1=1 ")
EndIf
If NoVacio(Dialogo.String1)
   SQL.ADD(" AND Cuenta = '"~Dialogo.String1~"' ")
EndIf
If NoVacio(Dialogo.String2)
   SQL.ADD(" and Tabla = '"~Dialogo.String2~"' ")
EndIf
IF NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and Vehiculos like '%"~Dialogo.Vehiculo1~"%' ")
ENDIF
If NoVacio(Dialogo.Book1)
   SQL.ADD(" and Book like '%"~Dialogo.Book1~"%' ")
EndIf
if Dialogo.Check1 = 1
    SQL.ADD(" ORDER BY CAST(Codigo as Int)  ")
else
    SQL.ADD("ORDER BY Codigo")
EndIf
watch(sql.batch)

