ACT(A1,'CT1')
ACN(B1,SQL("Select Precio1 From dbo.COTIZACIONESFUT Where Codigo = 'USD' AND Moneda = 'ARP' AND FechaFut = '2019-01-31' AND Mercado = 'ROFEX' AND CallPut = 'FUT' AND Fecha = '2019-01-09' "))
ACT(A2,'CT2')
ACN(B2,SQL("Select Precio1 From dbo.COTIZACIONESFUT Where Codigo = 'USD' AND Moneda = 'ARP' AND FechaFut = '2019-02-28' AND Mercado = 'ROFEX' AND CallPut = 'FUT' AND Fecha = '2019-01-09' "))
ACT(A3,'E: Fecha 1')
ACD(B3,Fecha('31/01/2019'))
ACT(A4,'F: Fecha 2')
ACD(B4,Fecha('28/02/2019'))
ACT(A5,'G: Dif360(E,F)')
ACN(B5,Dif360(Val(B3),Val(B4)))
ACT(A6,'H: Dif360(F,F)')
ACN(B6,Dif360(Val(B4),Val(B4)))
ACT(A7,'I: CT2-CT1')
ACN(B7,Val(B2)-Val(B1))
ACT(A8,'J: G*H')
ACN(B8,Val(B5)*Val(B6))
ACT(A9,'(CT2-CT1)/G*H')
ACN(B9,(Val(B2)-Val(B1))/Val(B5)*Val(B6))
ACT(C9,'I / J')
ACN(D9,(Val(B7))/Val(B8))
ACT(A10,'(CT2-CT1)/G*H con mas decimales')
ACT(B10,Fstr((Val(B2)-Val(B1))/Val(B5)*Val(B6),0,9))
ACT(C10,'I / J con mas decimales')
ACT(D10,Fstr((Val(B7))/Val(B8),0,9))
ACT(A11,'((CT2-CT1)/G*H) + CT2')
ACN(B11,((Val(B2)-Val(B1))/Val(B5)*Val(B6))+Val(B2))
ACT(C11,'(I / J) + CT2')
ACN(D11,(Val(B7)/Val(B8))+Val(B2))
ACT(A12,'((CT2-CT1)/G*H)+CT2 con mas decimales')
ACT(B12,Fstr(((Val(B2)-Val(B1))/Val(B5)*Val(B6))+Val(B2),0,9))
ACT(C12,'(I / J) + CT2 con mas decimales')
ACT(D12,Fstr((Val(B7)/Val(B8))+Val(B2),0,9))


ACO(1,25)
ACO(2,10)
ACO(3,18)
ACO(4,10)