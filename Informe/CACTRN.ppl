ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

ACT(ml:99, var('MONELOCA'))
ACT(me:99, var('MONEEXTR'))

SQL.ADD(" Select O.TipoOp, O.FechaOp, O.Especie, O.Cliente1, O.Cuenta4, O.Cantidad, O.Vehiculo1, O.Cliente2, O.Cuenta1, ")
SQL.ADD(" C1.Cliente ClienteCta1, C4.Cliente ClienteCta4, C1.CBU CBUCta1, C4.CBU CBUCta4, C1.Numero NumeroCta1, C4.Numero NumeroCta4 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C1, "~DBO~".CUENTAS C4 ")
SQL.ADD(" where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND C1.Codigo = O.Cuenta1 ")
SQL.ADD(" AND C4.Codigo = O.Cuenta4 ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Cuenta4'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACN(zd:98, fbn['Cantidad'])
   ACT(ze:99, fbn['Vehiculo1'])
   ACT(zf:99, fbn['Cliente2'])
   ACN(zg:99, fbn['Cuenta1'])
   ACT(zh:99, fbn['ClienteCta1'])
   ACN(zi:99, fbn['ClienteCta4'])
   ACT(zj:99, fbn['CBUCta1'])
   ACT(zk:99, fbn['CBUCta4'])
   ACT(zl:99, fbn['NumeroCta1'])
   ACT(zm:99, fbn['NumeroCta4'])
   ACD(zn:99, fbn['FechaOp'])
   ACT(zo:99, fbn['Especie'])
Proximo


If Eqstr(val(za:99), 'TRANMM')

   If EqStr(val(zo:99),val(ml:99))
    act(mo:99, 'Pesos')
   else
    act(mo:99, 'Dolares')
   Endif

   If EqStr(val(zo:99),val(ml:99))
      act(ms:99, '$')
   else
      act(ms:99, 'u$s')
   Endif

***---Carta Concertacion Transf. MEP

   SetFilaActual(11)
   ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zn:99)),1,0)~' de '~Meses(Mes(val(zn:99)))~' de '~FStr(Anio(val(zn:99)),4,0)~'.')

   SetFilaActual(fac+3)
   ACT(a:fac,'Señores')
   SetFont(a:11..a:fac,1)

   SetFilaActual(fac+1)
   ACT(a:fac, 'BANCO '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
   SetFont(a:fac,2)

   SetFilaActual(fac+1)
   ACT(a:fac,'Presente.')
   SetFont(a:fac,3)

   SetFilaActual(fac+3)
   acn(zz:99,fac)
   ACT(a:fac,'De nuestra consideracion:')
   SetFilaActual(fac+1)

   ACT(TX:1,'Declaro bajo juramento que la emision de la transferencia via MEP por '~IIF(EqStr(val(zo:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zo:99),val(me:99)),val(ms:99),val(zo:99)))~' '~val(zd:99)~' que por medio de la presente solicitamos que sea realizada en el dia de la fecha, desde la cuenta corriente nro. '~val(zm:99)~', CBU: '~val(zk:99)~', abierta en esta entidad, perteneciente a '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(ze:99))~', C.U.I.T. '~BuscarCampo('CLIENTES','CUIT','Codigo',val(ze:99))~', tiene como destino la cuenta corriente Nº '~val(zl:99)~', CBU '~val(zj:99)~', de '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zf:99))~', a nombre de '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(ze:99))~', C.U.I.T. '~BuscarCampo('CLIENTES','CUIT','Codigo',val(ze:99))~', previo credito en la cuenta en el B.C.R.A Nº '~BuscarCampo('CLIENTES','CodigoBCRA','Codigo',val(zf:99))~' de dicho Banco, bajo el concepto transferencia entre cuentas del mismo titular.')
   ACN(CR:1, 80)
   (.'LINEAS'.)
**--   Forma de usar a esta funcion desde donde se la llame
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo

   SetFilaActual(fac+1)

   ACT(TX:1,'Con el mismo caracter declaramos que las cuentas intervinientes en esta transferencia no se hallan abiertas a la orden de mas de una persona juridica.')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ifa
      ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo

   SetFilaActual(fac+1)

   ACT(TX:1,'Me doy por notificado que esta declaracion jurada queda en poder de la entidad financiera para ser puesta a disposicion de la Administracion Federal de Ingresos Publicos en caso de requerirla dicho organismo.')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ifa
      ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo 

   SetFilaActual(fac+1)
   ACT(a:Fac,'Sin otro particular, lo saludamos a Uds. muy atte.')
   SetFont(a:val(zz:99)..a:fac,1)

*-   SetFilaActual(fac+3)
*-   ACT(d:Fac,'            '~val(ze:99) )
*-   SetFont(d:fac,2)

*-   SetFilaActual(fac+3)
*-   ACT(d:Fac,'APODERADO')
*-   ACT(f:Fac,'       '~'APODERADO')
*-   SetFont(d:fac..f:fac,4)

SaltarHoja

***---Carta Concertacion Transf. MEP Recepcion

   SetFilaActual(fac+10)
   ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zn:99)),1,0)~' de '~Meses(Mes(val(zn:99)))~' de '~FStr(Anio(val(zn:99)),4,0)~'.')
   SetFont(a:fac,1)

   SetFilaActual(fac+3)
   ACT(a:fac,'Señores')
   SetFont(a:fac,1)

   SetFilaActual(fac+1)
   ACT(a:fac, 'BANCO '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zf:99)))
   SetFont(a:fac,2)

   SetFilaActual(fac+1)
   ACT(a:fac,'Presente.')
   SetFont(a:fac,3)

   SetFilaActual(fac+3)
   acn(zz:99,fac)
   ACT(a:fac,'De nuestra consideracion:')
   SetFilaActual(fac+1)

   ACT(TX:1,'Por medio de la presente informamos a Uds. que hemos solicitado al '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99))~' la emision de una transferencia via MEP por '~IIF(EqStr(val(zo:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zo:99),val(me:99)),val(ms:99),val(zo:99)))~' '~val(zd:99)~' con credito a Vuestra cuenta en el B.C.R.A Nº '~BuscarCampo('CLIENTES','CodigoBCRA','Codigo',val(zf:99))~' los fondos anteriormente informados seran debitados de la cuenta corriente en '~val(mo:99)~' nro. '~val(zm:99)~', CBU: '~val(zk:99)~', Titular: '~BuscarCampo('CLIENTES','RazonSocial','Codigo',val(ze:99))~', C.U.I.T. nro. '~BuscarCampo('CLIENTES','CUIT','Codigo',val(ze:99))~', del mencionado Banco.')
   ACN(CR:1, 80)
   (.'LINEAS'.)
**--   Forma de usar a esta funcion desde donde se la llame
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo

   SetFilaActual(fac+2)

   ACT(TX:1,'En tal sentido, les solicitamos sirvanse acreditar dichos fondos en nuestra Cuenta Corriente Nº '~val(zl:99)~', CBU: '~val(zj:99)~', la suma de '~IIF(EqStr(val(zo:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zo:99),val(me:99)),val(ms:99),val(zo:99)))~' '~val(zd:99)~'.')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo

   SetFilaActual(fac+1)
   ACT(a:Fac,'Sin otro particular, lo saludamos a Uds. muy atte.')
   SetFont(a:val(zz:99)..a:fac,1)

*-   SetFilaActual(fac+3)
*-   ACT(d:Fac,'            '~val(ze:99) )
*-   SetFont(d:fac,2)

*-   SetFilaActual(fac+3)
*-   ACT(d:Fac,'APODERADO')
*-   ACT(f:Fac,'       '~'APODERADO')
*-   SetFont(d:fac..f:fac,4)

ENDIF

Impresion(2, 0) 
Impresion(3, 0)

SetMargins(3, 0, 0, 0)

LimitesVision(m:FAC+1)