MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'          ;1;1;;;;;;;fsys  
  Mercado1 : 'Mercado'        ;2;1;;;;Vacio(Dialogo.Mercado1) o Incluido('FM',BuscarCampo('MERCADOS','TipoNegocio','Codigo',Dialogo.Mercado1));'Debe ingresar un Mercado de Futuros de Moneda';NO;;;;;;" TipoNegocio Like '%FM%' "
  Radio1   : "Totales por |Fecha Fixing|Fixing y Vencimiento";;;;;;Dialogo.Radio1=0 o Dialogo.Radio1=1;"Debe seleccionar una opcion";NO;0
  Lista1   : 'Books'          ;0;2; ;NO;NO;;;;;IIF(Vacio(Dialogo.Mercado1),SQLSet("select distinct Book from "~DBO~".POSICIONESFUT where NrSaldo = 47 "),SQLSet("select distinct Book from "~DBO~".POSICIONESFUT where NrSaldo = 47 And Mercado = '"~Dialogo.Mercado1~"' "))
  
FinDialogo
IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,9,B')
CrearFont(5, 'Arial,12,B')

ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(3)

ACT(d:fac, 'Neto Fixing Monedas x Book')
SetFont(d:fac, 5)
AlinearCeldas(d:fac,'C')

If Dialogo.Radio1=1
   ACT(d:fac+1,"Por Fecha Fixing y Vencimiento")
Else
   ACT(d:fac+1,"Por Fecha Fixing")
Endif
AlinearCeldas(d:fac+1,'C')

SetFilaActual(fac+2)

ACN(CO:1, CotizacionC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,25,SI,VAR('MONELOCA')))


ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Mercado: '~IIF(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
ACT(d:fac,'Cotizacion '~VAR('MONEEXTR')~' '~PYC(Val(CO:1),0,4))


SetFont(a:4..z:7, 2)

SetFilaActual(fac+2)

ACN(xx1,FAC+1)
ACN(xx3,FAC+2)
ACN(VX1,fac+1)

act(a:val(xx1),'Fecha Fixing')
If Dialogo.Radio1=1
   act(b:val(xx1),'Fecha Vto')
Endif   

act(c:val(xx1)-1,'Books')

ACN(xx5,0)

Recorrer&i 1,Elementos(Dialogo.Lista1)
    If NoVacio(ItemLista(Dialogo.Lista1,&i))
       ACT(Val(xx5)+3:val(xx1),ItemLista(Dialogo.Lista1,&i))
       ACN(xx2,Val(xx5)+3)
       SCN(xx5,1)
    Endif
Proximo

ACT(Val(xx5)+3:val(xx1), 'Total USD')
ACN(xx2,Val(xx5)+3)

SetFont(a:Val(xx1)-1..z:Val(xx1),2)
AgregarMarco(c:Val(xx1)-1..val(xx2)-1:Val(xx1)-1,2,1,Exe('COLOR'))
AgregarMarco(a:Val(xx1)..val(xx2):Val(xx1),2,1,Exe('COLOR'))
ifa

** AA 04/06/20 - Se informa posicion invertida para el control con sistema externo (Es el Neto de Fixing no la Posicion)
**SQL.ADD(" SELECT  Sum(P.CantidadFin)*-1 PosNeta, P.Book, P.Especie, FechaFut FechaFix, FechaEj FechaPago")
If Dialogo.Radio1=1
   SQL.ADD(" SELECT  Sum(P.CantidadFin)*-1 PosNeta, P.Book, P.Especie, FechaFut FechaPago, FechaEj FechaFix")
Else
   SQL.ADD(" SELECT  Sum(P.CantidadFin)*-1 PosNeta, P.Book, P.Especie, FechaEj FechaFix")
Endif
SQL.ADD(" FROM "~DBO~".POSICIONESFUT P, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Cliente = V.Codigo")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   P.FechaFut >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" AND P.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
SQL.ADD(" AND P.NrSaldo IN (47) ")
SQL.ADD(" AND   P.Fecha = (SELECT MAX(Fecha) FROM "~DBO~".POSICIONESFUT P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaFut = P.FechaFut OR ((P1.FechaFut IS NULL OR P1.FechaFut='' OR P1.FechaFut=' ') AND (P.FechaFut IS NULL OR P.FechaFut='' OR P.FechaFut=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  AND   (P1.CantidadIni <> 0 or P1.Cantidad1 <> 0 or P1.Cantidad2 <> 0 or P1.CantidadFin <> 0) ")
SQL.ADD("                  ) ")
If Dialogo.Radio1=1
   SQL.ADD(" Group by Book, Especie, FechaFut, FechaEj ")
   SQL.ADD(" ORDER BY FechaFix, FechaPago, Book ")
Else
   SQL.ADD(" Group by Book, Especie, FechaEj ")
   SQL.ADD(" ORDER BY FechaEj, Book ")
Endif   

watch(SQL.Batch)
ACT(fe:1,'FECHA')
ACD(fe:10,Fecha('01/01/1900'))
ACD(fe:11,Fecha('01/01/1900'))

Recorrer SQL
If Dialogo.Radio1=1
  if Val(fe:10)<>Fbn['FechaFix'] o Val(fe:11)<>Fbn['FechaPago']
     if Val(fe:10)=fecha('01/01/1900')
         ACN(fi:1,FAC)
         ACD(fe:10,Fbn['FechaFix'])
         ACD(fe:11,Fbn['FechaPago'])
     Else
        *** Totales por Fix Books
        ACN(Val(xx2):fac-1, Val(TO:1))
        ACN(to:1,0)
        ACD(fe:10,Fbn['FechaFix'])
        ACD(fe:11,Fbn['FechaPago'])
     Endif
  Else
    Dfa
  Endif
 
  ACT(b:Fac, Fbn['FechaPago'])
Else
  if Val(fe:10)<>Fbn['FechaFix']
     if Val(fe:10)=fecha('01/01/1900')
         ACN(fi:1,FAC)
         ACD(fe:10,Fbn['FechaFix'])
     Else
     *** Totales por Vto Books
        ACN(Val(xx2):fac-1, Val(TO:1))
        ACN(to:1,0)
        ACD(fe:10,Fbn['FechaFix'])
     Endif
  Else
    Dfa
  Endif
Endif  
 ACT(a:Fac, Fbn['Fechafix'])
  
  Recorrer&i 3,Val(xx2)-1
    ACN(ce:1,&i)
    If Eqstr(Val(val(ce:1):val(xx1)),Fbn['Book'])
       ACN(val(ce:1):Fac,Fbn['PosNeta'])
       if EqStr(Fbn['PosNeta'],VAR('MONELOCA'))
          SCN(to:1, Fbn['PosNeta']/Val(CO:1))
          SCN(to:2, Fbn['PosNeta']/Val(CO:1))
       Else
          SCN(to:1, Fbn['PosNeta'])       
          SCN(to:2, Fbn['PosNeta'])       
       Endif
    Endif  
  Proximo
   
Proximo

if Val(fe:10)<>fecha('01/01/1900')
  *** Totales por Fix Books
  ACN(Val(xx2):fac, Val(TO:1))
endif
  

IFA
ACT(Val(xx2)-1:fac, 'Neto USD  --->')
ACN(Val(xx2):fac, Val(TO:2))
SetFont(Val(xx2)-1:fac..Val(xx2):fac,4)
FormatoCeldas(c:10..Val(xx2):fac,Exe('F0R'))

IFA
IFA
ACT(A:Fac,'Fin del Informe')
SetFont(a:1..b:Fac,2)

