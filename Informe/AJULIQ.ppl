CrearDialogo
  Vehiculo1 : "Vehiculo"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1    : 'D.Fecha' ;;;;;;;;;FSys
  Fecha2    : 'H.Fecha' ;;;;;;;;;FSys
FinDialogo

if not Ok 
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)


If NoVacio(Dialogo.Vehiculo1)
   ACT(a3, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
   if Vacio(UsrVehiculos(UsuarioActivo))
      ACT(a3, 'Vehiculo : Todos ')
   else
      ACT(a3, 'Vehiculo : '~val(zz6))
   endif
EndIf
ACT(a4, 'Fecha : '~Dialogo.Fecha1)

ACT(a6, 'NrOperacion')
ACT(b6, 'Especie')
ACT(c6, 'Cliente')
ACT(d6, 'Vehiculo')
ACT(e6, 'Monto Aj.')
ACT(f6, 'TipoOp')
ACT(g6, 'Monto Ant.')
ACT(h6, 'F.Ajuste')
ACT(i6, 'F.Liquid.')
ACT(j6, 'Descripcion')

AgregarMarco(a6..j6,1,0,Exe('COLOR'))
SetFilaActual(6)


SQL.ADD("Select * from "~DBO~".MOVAJUSTE where FechaGen >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaGen <= '"~IdxDate(Dialogo.Fecha2)~"'")

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and Vehiculo='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and Vehiculo IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf

SQL.ADD("order by NrOperacion")

recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente'))
  ACT(d:fac, fbn('Vehiculo'))
  ACN(e:fac, fbn('Cantidad'))
  ACT(f:fac, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion')))
  ACT(h:fac, fbn('FechaGen'))
  SQL.ADD("Select * from "~DBO~".MOVEJECUTADOS")
  SQL.ADD("where NrOperacion = '"~fbn('NrOperacion')~"' and")
  SQL.ADD("NrMov = "~fbn('NrMov')~" and")
  SQL.ADD("NrSaldo = 1")
  recorrer SQL
    dfa
    ACN(g:fac, fbn('Cantidad'))
    ACT(i:fac, fbn('FechaEje'))
    ACT(j:fac, fbn('Leyenda'))
  proximo
proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z4, 1)
SetFont(a5..z:fac, 2)
ACO(10, 20)
FormatoCeldas(e5..g:fac,Exe('F2')) 

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

LimitesVision(k:fac+1)
Impresion(1,2)
*
*    Esto es lo que agrega Silvia
*

RangoTitulo(a:1..k:fac+1, 6)



