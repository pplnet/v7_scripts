    Fecha1  :'Desde'    ;1;1;;;;;;;FSys
    String3 :'D.Hora'   ;1;2;;;;NoVacio(Dialogo.String3) y HoraValida(Dialogo.String3);'Debe especificar una Hora Desde Valida';NO;'00:00';;;;'##:##'
    Fecha2  :'Hasta'    ;2;1;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha Hasta debe ser mayor o igual a Fecha Desde';NO;FSys;FSys
    String4 :'H.Hora'   ;2;2;;;;NoVacio(Dialogo.String4) y HoraValida(Dialogo.String4);'Debe especificar una Hora Hasta Valida';NO;'23:59';;;;'##:##'
    Fecha3  :'Sdo Desde'    ;3;1;;;;;;;FSys
    Fecha4  :'Sdo Hasta'    ;4;1;;;;Dialogo.Fecha4>=Dialogo.Fecha3;'Fecha Saldo Hasta debe ser mayor o igual a Fecha Saldo Desde';NO;FSys;
    Radio1  :'Tipo|Titulo|Lineas|Todas|' ;5;1;;NO;NO;;;;1;
    Radio2  :'Tipo|ROFEX|CV|Todas|' ;6;1;;NO;NO;;;;1;

FinDialogo

