   ACN(d:FAC, FBN['Linea'])
   ACT(e:FAC, FBN['Cliente'])
   ACT(f:FAC, FBN['Especie'])
   ACT(g:FAC, FBN['EstadosCustodia'])
   ACT(h:FAC, FBN['Detalle'])
