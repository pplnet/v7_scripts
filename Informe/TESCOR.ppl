******************
**  GRILLA  **
******************
acn(w1,fac+1)
*acd(xa:1,Fecha(VAR('ULTDEPUR')))
SQL.ADD("SELECT Fecha, Codigo, Tipo, Linea, Detalle, Cliente, Especie, EstadosCustodia ")
*IF Dialogo.Fecha4<=Val(xa:1)
*    SQL.ADD("  FROM "~DBO~".TESTIGOCORRIDASHIST ")
*ELSE
    SQL.ADD("  FROM "~DBO~".AUDITINTERFASES ")
*ENDIF
SQL.ADD(" WHERE Fecha BETWEEN  '"~Fecha(Dialogo.Fecha1,'YYYYMMDD')~" "~Dialogo.String3~"' AND  '"~Fecha(Dialogo.Fecha2,'YYYYMMDD')~" "~Dialogo.String4~"' ")
SQL.ADD(" AND FechaSaldo BETWEEN  '"~Fecha(Dialogo.Fecha3,'YYYYMMDD')~"' AND  '"~Fecha(Dialogo.Fecha4,'YYYYMMDD')~"' ")
IF Dialogo.Radio1=0
   SQL.ADD("   AND Tipo='TIT' ")
else
   IF Dialogo.Radio1=1
      SQL.ADD("   AND Tipo='LIN' ")
   endif
endif

If Dialogo.Radio2=0
   SQL.ADD("   AND Codigo='CGTIAD' ")
else
   If Dialogo.Radio2=1
      SQL.ADD("   AND Codigo='CSDOD' ")
   endif
endif


if NO
if Novacio(Dialogo.Lista1)
   SQL.ADD(" AND ( ")
   Recorrer&i 1, Elementos(Dialogo.Lista1)
      SQL.ADD(" Fecha ='"~Fecha(Dialogo.Fecha1,'YYYYMMDD')~" "~ItemLista(Dialogo.Lista1,&i)~"'  ")
      if &i<Elementos(Dialogo.Lista1)
         SQL.ADD(" OR  ")
      else
         SQL.ADD(" )  ")
      endif
   Proximo
endif
ENDIF

SQL.ADD(" ORDER BY Fecha, Codigo, Linea ")
RECORRER SQL
   Message(FBN['Codigo']~' '~FBN['Tipo']~' '~FBN['Linea'])
   ACT(a:FAC, FBN['Fecha'])
   ACT(b:FAC, FBN['Codigo'])
