ModoReproceso(SINDIALOGO)
CrearDialogo
 Fecha1   :'F.Op.Desde'  ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una F.Op. Desde' ;NO;FSys-30;
 Fecha2   :'F.Op.Hasta'  ; ;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una F.Op. Hasta' ;NO;FSys;
 Vehiculo1:'Vehiculo'    ; ;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
 Especie1 :'Especie'     ; ;1;;;;;;
 Cliente1 :'Cliente'     ;1;2;;;;;;
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(4)
ACT(a:fac,'Manifestaciones de Interes')
SetFont(a:fac,3)

SetFilaActual(fac+2)
if NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
endif
SetFont(a:fac..b:fac,2)
ifa

if NoVacio(Dialogo.Especie1)
   ACT(a:fac,'Especie:')
   ACT(b:fac,'('~Dialogo.Especie1~') '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
   ACT(a:fac,'Especies:')
   ACT(b:fac,'Todas')
endif
SetFont(a:fac..b:fac,2)
ifa

ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..b:fac,2)
ifa


ACT(a:fac,'Instancia')
ACT(b:fac,'Nro')
ACT(b:fac+1,'Manifestacion')
ACT(c:fac,'Fecha')
ACT(c:fac+1,'Operacion')
ACT(d:fac,'Fecha')
ACT(d:fac+1,'Vencimiento')
ACT(e:fac,'Cliente - Razon Social')
ACT(f:fac,'Nro')
ACT(f:fac+1,'Emision')
ACT(g:fac,'Especie')
ACT(h:fac,'Nombre especie')
ACT(i:fac,'Cantidad')
ACT(i:fac+1,'Ofertada')
ACT(j:fac,'Precio /Tasa /')
ACT(j:fac+1,'Margen ofertado')
ACT(k:fac,'Cantidad')
ACT(k:fac+1,'Adjudicada')
ACT(l:fac,'Precio /Tasa /')
ACT(l:fac+1,'Margen adjudicado')
ACT(m:fac,'Tipo')
ACT(n:fac,'C.Esp.')
ACT(o:fac,'Vehiculo')
ACT(p:fac,'Fecha')
ACT(p:fac+1,'Carga')
ACT(q:fac,'Hora')
ACT(q:fac+1,'Carga')
ACT(r:fac,'Fecha')
ACT(r:fac+1,'CargaSys')
ACT(s:fac, 'Nro Alta')
ACT(s:fac+1, VAR('AMBMAE'))
ACT(t:fac,'Total')




AlinearCeldas(a:fac..h:fac+1,'I')
AlinearCeldas(i:fac..k:fac+1,'D')
AlinearCeldas(L:fac..r:fac+1,'I')
AlinearCeldas(t:fac,'D')
SetFont(a:fac..t:fac+1,2)
AgregarMarco(a:fac..t:fac+1,1,0,Exe('COLOR6'))
ifa
ACN(z:1,fac)

SQL.ADD("SELECT ES.NOMBRE, R.RB7,R.FechaOrden,R.NrOrden,R.CantidadTotalOrden,R.CantidadCompletada,R.CantidadTotalOrden,")
SQL.ADD("R.FechaLimite,R.Especie,R.ContraEspecie,R.Cliente,R.RB7 as Cumplimiento,")
SQL.ADD("R.PrecioLimite,R.HoraOrden,R.FechaVto,R.Vehiculo,R.RB5,R.PrecioReal,")
SQL.ADD("R.Estado,R.Mercado,R.CantidadEnProceso as MontoNeto,R.Lotes,B.NrBit,R.NrOperacion1,")
SQL.ADD("R.FechaVto,C.RazonSocial,R.FechaCarga,R.FechaCargaSys,R.HoraOrden")
SQL.ADD("FROM   "~DBO~".ORDENES R,"~DBO~".CLIENTES C,"~DBO~".OPERACIONESBITS B ")
SQL.ADD(","~DBO~".ESPECIES ES ")
SQL.ADD("WHERE  R.NrOrden = B.NrOperacion and R.Cliente=C.Codigo ") 
SQL.ADD(" and   R.Especie = ES.Codigo  ")
SQL.ADD("and    R.FechaOrden  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD("and    B.Valor    = '1'  ")
SQL.ADD("and    R.TipoOrden IN ('TMANIF') ")
SQL.ADD("and    R.Vehiculo   = '"~Dialogo.Vehiculo1~"' ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and   R.Especie = '"~Dialogo.Especie1~"' ")
endif
*-Cliente
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and   R.Cliente    = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("Order  By R.NrOrden ")

acn(ii1,1)

Recorrer SQL
  act(a:fac,SQL("select Nombre from "~DBO~".INSTANCIAS where NrInstancia="~FStr(fbn('NrBit'),1,0)~" AND Tabla='ORDENES' "))
  act(b:fac,FBN['NrOrden'])
  ACLR(b:fac,fbn['NrOrden'])
  acd(c:fac,FBN['FechaOrden'])
  acd(d:fac,FBN['FechaVto'])
  act(e:fac,FBN['Cliente']~' - '~copy(FBN['RazonSocial'],1,25))
  act(f:fac,FBN['NrOperacion1'])
  aclo(f:fac,FBN['NrOperacion1'])
  act(g:fac,FBN['Especie'])
  acn(i:fac,FBN['CantidadTotalOrden'])
  acn(j:fac,FBN['PrecioLimite'])
  acn(k:fac,FBN['CantidadCompletada'])
  act(m:fac,iif(FBN['RB5']=0,'Precio','Tasa'))

  act(n:fac,FBN['ContraEspecie'])
  act(o:fac,FBN['Vehiculo'])
  ACT(p:fac,Copy(fbn('FechaCarga'),1,10))
  ACT(q:fac,fbn('HoraOrden'))
  ACT(r:fac, fbn('FechaCargaSys'))
  ACT(h:fac, fbn('NOMBRE'))
  sql.add("SELECT Precio1, NroAltaMAE, TotalNetoCli1 FROM "~DBO~".OPERACIONES WHERE NrOrden1='"~Val(b:fac)~"' AND TipoOp='TCOPRI' ")
  Recorrer SQL
    dfa
    ACT(s:fac, fbn('NroAltaMAE'))
    ACN(t:fac,FBN['TotalNetoCli1'])
    ACN(l:fac, fbn('Precio1'))
  Proximo
   FormatoCeldas(j:FAC,Exe('F9')) 
    FormatoCeldas(l:FAC,Exe('F9')) 
   SetFont(a:fac..t:fac,1)
Proximo
ifa
SetFilaActual(fac+2)
ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac,2)

