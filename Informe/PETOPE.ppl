AlinearCeldas(a:fac..l:fac,'C')
AgregarMarco(a:fac..l:fac,2,3,Exe('COLOR'))

AlinearCeldas(a:fac+1..g:fac,'I')
AlinearCeldas(h:fac+1..i:fac,'D')
AlinearCeldas(j:fac+1..n:fac,'C')
AlinearCeldas(k:fac+1..n:fac,'I')
SetFont(a:5..n:fac,2)
AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR'))

if NoVacio(Dialogo.Vehiculo1)
  ACT(z1, "Vehiculo1 = '"~Dialogo.Vehiculo1~"' and ")
endif

   SQL.ADD("Select TipoOp, NrOperacion, FechaOp, FechaVto, Especie, TotalBrutoCli1 , Cliente1, Cantidad, Precio1, Vehiculo1, Operador  ")
   SQL.ADD(" from "~DBO~".OPERACIONES where ")
   If NoVacio(Dialogo.NrOperacion1)
      SQL.ADD(" NrOperacion='"~Dialogo.NrOperacion1~"'")
   Else 
      SQL.ADD(" "~Val(z1) ~" ")
      SQL.ADD("FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
   Endif

SQL.ADD("order by NrOperacion")


Recorrer SQL
  SCN(z2,1)
  ACT(z3, ' ')
  ACT(z3,  SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~fbn('NrOperacion')~"' and Valor = '1'"))
  ACT(In1, SQL("Select Nombre from "~DBO~".INSTANCIAS where NrInstancia = '"~Val(z3)~"' and Tabla = 'OPERACIONES'"))
  act(a:fac,Val(In1))
  

 
  ACT(b:fac, fbn('NrOperacion'))
  ACD(c:fac, fbn('FechaOp'))
  ACD(d:fac, fbn('FechaVto'))
  ACT(e:fac, fbn('Especie'))
  ACT(f:fac, fbn('TipoOp'))
  ACT(g:fac, fbn('Cliente1'))
  ACN(h:fac, fbn('Cantidad'))
  ACN(i:fac, fbn('Precio1'))
  ACN(j:fac, fbn('TotalBrutoCli1'))
  ACT(k:fac, fbn('Vehiculo1'))
  ACT(l:fac, fbn('Operador'))
 


  FormatoCeldas(h:fac..h:fac,Exe('F0'))
  FormatoCeldas(i:fac..i:fac,Exe('F7'))
  FormatoCeldas(j:fac..j:fac,Exe('F2'))
  
  ACLO(b:fac,Val(b:fac))

