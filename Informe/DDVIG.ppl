CrearDialogo
  Fecha1 : 'Vigencia'    ;1;1;;;;;;;Fsys
  Cliente1:'Cliente'     ;2;2;
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
  Radio1: 'Operaciones|Todas|Compras|Ventas|';;;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)
ACT(a:Fac, 'Cartera de descuento de docuementos')
SetFont(a:FAC..a:FAC,3)
ACT(a:Fac+1, 'Vigencia: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Cliente1)
   ACT(a:Fac+2, 'Cliente: '~Dialogo.Cliente1)
else
   ACT(a:Fac+2, 'Cliente: Todos')
endif
ACT(a:fac+3, 'Especie:'~Dialogo.Especie1)
if Dialogo.Radio1=0
   ACT(a:fac+4, 'Operaciones: Todas')
else
   if Dialogo.Radio1=1
      ACT(a:fac+4, 'Operaciones: Compras')
   else
      ACT(a:fac+4, 'Operaciones: Ventas')
   endif   
endif   

SetFilaActual(fac+4)
ACT(a:FAC, 'NrOperacion')
ACT(b:FAC, 'TipoOp')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Fecha Op.')
ACT(e:FAC, 'Fecha Liq.')
ACT(f:FAC, 'Pl.Liq')
ACT(g:FAC, 'F.Acred.')
ACT(h:FAC, 'Pl.Vto')
ACT(i:FAC, 'Monto')
ACT(j:FAC, 'Interes')
ACT(k:FAC, 'Capital')
ACT(l:FAC, 'Derechos')
ACT(m:FAC, 'Aranceles')
ACT(n:FAC, 'Gastos')
ACT(o:FAC, 'IVA')
ACT(p:FAC, 'RG1603')
ACT(q:FAC, 'Nr.Boleto')
AgregarMarco(a:FAC..q:FAC,1,0,Exe('COLOR2'))
SetFont(a:5..aa:FAC,2)
ACN(w1,FAC)

if Dialogo.Radio1=1
  let &TipoOp 'DDC'
endif

if Dialogo.Radio1=2 
  let &TipoOp 'DDV'
endif

SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD(" WHERE Especie = '"~Dialogo.Especie1~"'")

if Dialogo.Radio1 = 1 o Dialogo.Radio1=2
    SQL.ADD(" and TipoOp = '"~&TipoOp~"' ")
Endif
SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD(" and '"~IdxDate(Dialogo.Fecha1)~"' <= FechaVto2")

if NoVacio(Dialogo.Cliente1)
    SQL.ADD("    and Cliente1 = '"~Dialogo.Cliente1~"' ")
*else
*    SQL.ADD("    and Cliente1 <> '"~VAR('VEHICULODE')~"'")
endif

*SetFilaActual(fac+2)

Recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, Val(a:fac))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1'))
  ACD(d:fac, fbn('FechaOp'))
  ACD(e:fac, fbn('FechaOp2'))
  ACT(f:fac, fbn('Plazo2'))
  ACD(g:fac, fbn('FechaVto2'))
  ACT(h:fac, fbn('Plazo'))
  ACN(i:fac, fbn('TotalBrutoCli1'))
  let &TotalMonto &TotalMonto+fbn('TotalBrutoCli1')
  ACN(j:fac, fbn('TotalIntereses'))
  ACN(k:fac, fbn('Cantidad'))
  let &TotalCapital &TotalCapital+fbn('Cantidad')
  ACN(l:fac, fbn('TotalDerechos'))
  ACN(m:fac, fbn('ImpGastos1'))
  let &TotalComisiones &TotalComisiones+fbn('ImpGastos1')
  ACN(n:fac, fbn('TotalGastos'))
  ACN(o:fac, fbn('TotalIVA')+fbn('ImpGastos2')+fbn('TotalAux1'))
  ACN(p:fac, fbn('TotalRetenciones'))
  ACT(q:fac, fbn('NrBoleto'))
proximo
ACT(a:fac+1, 'Totales')
ACN(k:fac+1, &TotalCapital)
ACN(m:fac+1, &TotalComisiones)
if Dialogo.Radio1>4
  ACN(i:fac+1, &TotalMonto)
endif

let &AnchoColFina 6
let &AnchoColumna 8
ACO(2,&AnchoColFina)
ACO(3,&AnchoColFina)
ACO(4,&AnchoColumna)
ACO(5,&AnchoColumna)
ACO(6,&AnchoColFina)
ACO(7,&AnchoColumna)
ACO(8,&AnchoColFina)
ACO(9,&AnchoColumna)
ACO(10,&AnchoColumna)
ACO(11,&AnchoColumna)
ACO(12,&AnchoColumna)
ACO(13,&AnchoColumna)
ACO(14,&AnchoColumna)
ACO(15,&AnchoColumna)
ACO(16,&AnchoColumna)

*CrearFont(1, "Arial,8,")
*CrearFont(2, "Arial,8,B")
*CrearFont(3, "Arial,14,B")
*CrearFont(4, "Arial,6,")
*CrearFont(5, "Arial,10,BU")
*CrearFont(6, "Arial,10,B")
*CrearFont(7, "Arial,10,")

SetFont(a:Val(w1)+1..aa:fac,1)
SetFont(a:FAC..aa:FAC,2)

FormatoCeldas(i7..p:fac+1, EXE('F2'))
AgregarMarco(a:fac+1..q:fac+1,1,0,Exe('COLOR2'))
AlinearCeldas(i6..p6,'D')
LimitesVision(q:fac+2)  
Autofit(si)
