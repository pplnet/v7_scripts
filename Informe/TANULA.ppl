*ModoReproceso(ConDialogo)
CrearDialogo
   Vehiculo1  : "Vehiculo"     ;1;;;;;;;;
   Cliente1   : "Cliente"      ;2;;;;;;;;
   Especie1   : "Especie"      ;3;;;;;;;;
   Fecha1     : "F.Desde"      ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
   Fecha2     : "F.Hasta"      ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
   Fecha3     : "F.AnulDesde"  ;5;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
   Fecha4     : "FAnulHasta"   ;5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
   Lista1     : "Tipos Tr."    ;;1;;;;;;;;;SQLSET("Select Codigo from "~DBO~".TIPOSTRANSACCION2 ")
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(r:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Transacciones Anuladas")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
   ACT(a:FAC+1, 'Vehiculo : Todos')
Endif
If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:FAC+2, 'Cliente : Todos')
Endif
If NoVacio(Dialogo.Especie1)
   ACT(a:FAC+3, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
   ACT(a:FAC+3, 'Especies : Todas')
Endif
ACT(a:FAC+4, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(e:FAC+4, 'Fecha Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+5, 'Fecha Anulacion Desde : '~Dialogo.Fecha3)
ACT(e:FAC+5, 'Fecha Anualacion Hasta : '~Dialogo.Fecha4)

If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+6, 'Tipo Tr. : '~Pipe2coma(Dialogo.Lista1))
Else
   ACT(a:FAC+6, 'Tipo Tr. : Todas')
Endif

SetFilaActual(FAC+9)

ACT(a:FAC, "Vehiculo")
ACT(b:FAC, "Numero")
ACT(c:FAC, "Tipo Tr.")
ACT(d:FAC, "FechaTr ")
ACT(e:FAC, "Tran.(T)")
ACT(f:FAC, 'Int.(I)')
ACT(g:FAC, "CodClte1")
ACT(h:FAC, "NombreCliente1")
ACT(i:FAC, "Cuenta1")
ACT(j:FAC, "CodClte2")
ACT(k:FAC, "NombreCliente2")
ACT(l:FAC, "Cuenta2")
ACT(m:FAC, "Especie")
ACT(n:FAC, "Cantidad")
ACT(o:FAC, "Concepto")
ACT(p:FAC, "Estado")
ACT(q:FAC, "Instancia")
ACT(r:FAC, "F.Carga")
ACT(s:FAC, "F.Anula")
ACT(t:FAC, "Usr.Anula")

AlinearCeldas(a:FAC..t:FAC,'I')
AlinearCeldas(n:FAC..n:FAC,'D')
SetFont(a5..t:FAC,2)
AgregarMarco(a:FAC..t:FAC,2,0,Exe('COLOR'))

ACN(w1,FAC)
SetFilaActual(FAC)

SQL.ADD("SELECT T.Vehiculo1, T.Fecha1, T.Cliente1, T.Cliente2, T.Cuenta1, T.Cuenta2, T.PrecioEj, ")
SQL.ADD("       T.Especie, T.FechaEj, T.TipoTr2, T.Cantidad1, T.NrTrans, T.ConceptoCA, T.Ley1, T.Fecha2, ")
SQL.ADD("       T.FechaCargaSys, 2 Tip, T.CB1, T.CB2, T.FechaDel, T.UsuarioDel  ")
SQL.ADD("FROM   "~DBO~".BTRANSACCIONES2 T")
SQL.ADD("WHERE  T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and T.Especie = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("order by T.Fecha1 ")


Recorrer SQL
   SCN(z2,1)
   ACT(z3, ' ')
   
   ACT(a:FAC, FBN['Vehiculo1'])
   ACT(b:FAC, FBN['NrTrans'])
   ACLBT(b:FAC, FBN['NrTrans'])
   ACT(c:FAC, FBN['TipoTr2'])
   ACD(d:FAC, FBN['Fecha1'])
   If FBN['CB1'] = 1
      ACT(e:FAC, 'T')
      AlinearCeldas(e:FAC,'C')
   Endif
   If FBN['CB2'] = 1
      ACT(f:FAC, 'I')
      AlinearCeldas(f:FAC,'C')
   Endif
   ACT(g:FAC, FBN['Cliente1'])
   ACT(h:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
   ACT(i:FAC, FBN['Cuenta1'])
   ACT(j:FAC, FBN['Cliente2'])
   ACT(k:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente2']),1,30))
   ACT(l:FAC, FBN['Cuenta2'])
   ACT(m:FAC, FBN['Especie'])
   ACN(n:FAC, FBN['Cantidad1'])
   ACT(o:FAC, Copy(BuscarCampo('ConceptosCA','Descripcion','Codigo',FBN['ConceptoCA']),1,20))
   ACT(p:FAC, FBN['Ley1'])
   ACD(r:FAC, FBN['FechaCargaSys'])
   ACD(s:FAC, FBN['FechaDEL'])
   ACT(t:FAC, FBN['UsuarioDEL'])

   SQL.ADD("SELECT I.NrInstancia, I.Nombre ")
   SQL.ADD("FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I ")
   SQL.ADD("WHERE OB.NrOperacion = '"~Val(b:fac)~"' AND ")
   SQL.ADD("      OB.Valor = '1' AND ")
   SQL.ADD("      I.Tabla = 'TRANSACCIONES2' AND ")
   SQL.ADD("      OB.NrBit = I.NrInstancia ")
   SQL.ADD("ORDER BY NrInstancia ")

   ACT(in1, 'SI')
   Recorrer SQL
      IF EqStr(Val(in1), 'SI')
         dfa
      ENDIF
      ACT(q:fac, FBN['Nombre'])
      ACT(in1, 'NO')
   Proximo
   IF EqStr(Val(in1), 'SI')
      dfa
   ENDIF
   SetFont(a:FAC..t:FAC, 1)
Proximo

SetFont(a:Val(w1)+6..q:FAC,1)

ACO(1,7)
ACO(2,7)
ACO(3,5)
ACO(4,6)
ACO(5,5)
ACO(6,5)
ACO(7,6)
ACO(8,15)
ACO(9,8)
ACO(10,6)
ACO(11,15)
ACO(12,8)
ACO(13,5)
ACO(14,8)
ACO(15,8)
ACO(16,7)
ACO(17,10)
ACO(18,6)
ACO(19,6)
ACO(20,8)



Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(t:FAC)
RangoTitulo(a:1..l:FAC, Val(w1)+5)
SetFont(a4..a5,2)
SetPrintFit(3,65)
