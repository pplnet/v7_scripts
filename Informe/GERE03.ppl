ModoReproceso(SinDialogo)
CrearDialogo
  Lista1     : "Vehiculo"                   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio5     : "Consolidado|No|Si"          ;1;2;;;;;;;0
  Radio1     : "Tipo|Todos|Rta.Fija|Rta.Vble." ;2;1;;;;;;;0
  Especie1   : "Especie"                    ;;;
  Cliente1   : "Contraparte"                ;;;
  Radio3     : "Oper.|Todos|Compra|Venta"   ;;;;;;;;;0
  Fecha1     : "F.Desde"                    ;;;;;;Dialogo.Fecha1<>0;'Fecha Desde Invalida';NO;Fsys
  Fecha2     : "F.Hasta"                    ;;;;;;Dialogo.Fecha2 > Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Habiles(Fsys, 1)
  Radio4     : "Fecha|Concert.|Vencimiento" ;;;;NO;;;;;1
  Radio2     : "Posc.|Spot|Spot+Termino"    ;;;;;;;;;0
FinDialogo

if not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Operaciones con Titulos Publicos o Privados")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

ACT(a:FAC+2, 'Tipo Especie : '~iif(Dialogo.Radio1=0,'Todos',iif(Dialogo.Radio1=1,'Renta Fija','Renta Variable')))

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+3, 'Especie : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+4, 'Contraparte : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+4, 'Contraparte : Todos')
endif

ACT(a:FAC+5, 'Operacion : '~iif(Dialogo.Radio3=0,'Todos',iif(Dialogo.Radio3=1,'Compra','Venta')))
ACT(a:FAC+6, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+7, 'Fecha Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+8, 'Fecha Ordenamiento : '~iif(Dialogo.Radio4=0,'Concertacion','Liquidacion'))
ACT(a:FAC+9, 'Posiciones : '~iif(Dialogo.Radio2=0,'Spot','Spot y a Termino'))
ACT(a:FAC+10, iif(Dialogo.Radio5=1,'Consolidado por Vehiculo '))

SetFont(a:fac..N:FAC+10,2)
SetFilaActual(FAC+12)

*--- Calculo el primer dia del año
ACD(ZZ5,Fecha('01/01/'~FStr(Anio(Dialogo.Fecha1),4,0)) )

* Armar una lista con los cupones asociados a las especies elegidas
If NoVacio(Dialogo.Especie1)
   ACT(y93, Descendientes('ESPECIES',Dialogo.Especie1))    
Endif

act(v1,' ')
acn(z7,0)

SQL.ADD("Select Distinct E.Cotiza,CASE E.Tipo WHEN 'PUB' THEN 'F' WHEN 'ONE' THEN 'F' WHEN  'PRI' THEN 'V' ELSE 'V' END Tip,E.Codigo,")
IF Dialogo.Radio5=0
   SQL.ADD(" S.Vehiculo as Vehiculo1, S.Cliente, ")
EndIf
SQL.ADD("E.InteresesC,E.VTeorico,E.Nombre,E.Jerarquia")
SQL.ADD("from "~DBO~".POSICIONES S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  and (E.EsCupon<>'SI' or E.EsCupon is Null)")
SQL.ADD(" and E.Tipo In ('PUB','ONE','PRI') ")
If Dialogo.Radio1=1
   SQL.ADD(" and E.Tipo In ('PUB','ONE') ")
endif
if Dialogo.Radio1=2
   SQL.ADD(" and E.Tipo In ('PRI') ")
endif
if Dialogo.Radio2=1
   SQL.ADD(" and (S.NrSaldo=101 or S.NrSaldo=201) ")
Else
   SQL.ADD(" and S.NrSaldo=101 ")
Endif
If NoVacio(val(zz6))
   SQL.ADD(" and S.Vehiculo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and Jerarquia In (")
   SQL.ADD(" Select Min(Jerarquia) from "~DBO~".ESPECIES E1 where E1.Codigo='"~Dialogo.Especie1~"' ")
   If NoVacio(val(y93))
      SQL.ADD(" or E1.Codigo In ("~Pipe2Comillas(Val(y93))~") ")
   EndIf
   SQL.ADD(" )")
EndIf
SQL.ADD("and S.Vehiculo =S.Cliente ")
SQL.ADD("and (S.CallPut is Null or S.CallPut = ' ') ")
SQL.ADD("and S.Fecha = (Select Max(D.Fecha) from "~DBO~".POSICIONES D ")
SQL.ADD("              where D.Vehiculo = S.Vehiculo ")
SQL.ADD("              and   D.Especie = S.Especie  ")
SQL.ADD("              and   D.NrSaldo=S.NrSaldo ")
SQL.ADD("              and   (D.CallPut is Null or D.CallPut = ' ') ")
SQL.ADD("              and   D.Cliente = S.Cliente  ")
SQL.ADD("              and   D.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ) ")
IF Dialogo.Radio5=1
   SQL.ADD("Order by E.Cotiza,Tip,E.Codigo,E.InteresesC,E.VTeorico,E.Nombre,E.Jerarquia")
Else   
   SQL.ADD("Order by E.Cotiza,Tip,E.Codigo,S.Vehiculo, S.Cliente,E.InteresesC,E.VTeorico,E.Nombre,E.Jerarquia")
EndIf

acn(x1,0)
act(v2,' ')
act(v3,' ')

Recorrer SQL
    Message('Recuperando Posiciones '~fbn['Codigo'])

    *-- Inicializo los Valores de la Especie a Listar 
    ACT(ee1,FBN['Cotiza'])
    ACT(ee2,FBN['Tip'])
    ACT(ee3,FBN['Codigo'])
    ACT(ee4,FBN['Nombre'])
    ACT(ee5,FBN['InteresesC'])
    ACT(ee6,'')

    If Dialogo.Radio5=0
       ACT(ee6,FBN['Vehiculo1'])
    EndIf
    ACT(y93,'')

    * Armar una lista con los cupones asociados a las especies elegidas
    ACT(y93, Descendientes('ESPECIES',val(ee3)))    

    if Dialogo.Radio5=0       
       act(a:fac,'Vehiculo: '~fbn['Vehiculo1']~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',fbn['Vehiculo1']))
       act(v2,fbn['Vehiculo1'])
       SetFont(a:fac..r:FAC,2)
       ifa
    EndIf

    act(a:fac,'Moneda de la Especie: '~BuscarCampo('Especies','Nombre','Codigo',val(ee1)))
    act(v1,val(ee1))
    SetFont(a:fac..r:FAC,3)
    ifa
    act(a:fac,iif(EqStr(val(ee2),'F'),'Renta Fija','Renta Variable'))
    act(v3,val(ee2))
    SetFont(a:fac..r:FAC,2)
    ifa
    act(a:fac,'Especie: '~val(ee3)~'  '~val(ee4))
    act(v4,val(ee3))
    act(v5,val(ee5))

    acn(bb1,0)
    SetFont(a:fac..r:FAC,2)
    ifa
    acn(x1,1)
    ifa

    acn(bb3,0)
    (.'TITGERE03'.)

    *-- Variables para recalculo de Resultados
    * va1: Vol.Comprado va2: Vol.Vendido fa1: Flujo.Comprado fa2: Flujo.Vendido 
    * pp1: Precio Promedio Compra pp2: PP Venta 
    * da1: Volumen de Dividendo en Acciones

    *---- Recupero las Operaciones desde el ppio del año para sacar el acumulado anual y el Flujo de 
    *---- Fondos del periodo
    SQL.ADD(" Select  O.Vehiculo1,O.FechaOp, ")
    SQL.ADD(" CASE TipoOp WHEN 'SEI' THEN FechaVto WHEN 'SED' THEN FechaVto ELSE O.FechaPago END FechaVto,O.Cantidad, ")
    SQL.ADD(" O.TotalNetoCli1, O.Precio1,O.Precio2,O.Cotizacion1, ")
    SQL.ADD(" O.TipoOp,O.ContraEspecie,O.MB4,O.MB3, O.TipoCambio3, O.Cartera,  O.ContraEspecie2, O.TotalBrutoCli1 as Monto,  ")
    SQL.ADD(" O.TotalBrutoCli1+O.TotalIntereses as Flujo,O.Cliente1,O.NrOperacion,O.Especie ")
    SQL.ADD(" from "~DBO~".OPERACIONES O where ")
    If NoVacio(val(y93))
       SQL.ADD("  (O.Especie='"~val(ee3)~"' or O.Especie In ("~Pipe2Comillas(Val(y93))~") ) ")   
    Else 
       SQL.ADD("  O.Especie='"~val(ee3)~"'  ")   
    EndIf
    if Dialogo.Radio2 = 0
       SQL.ADD(" and CASE TipoOp WHEN 'SEI' THEN FechaVto WHEN 'SED' THEN FechaVto ELSE O.FechaPago END <='"~IdxDate(Fsys)~"' ")
    endif
    if NoVacio(Dialogo.Cliente1)
       SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
    endif
    if Dialogo.Radio3=1
       SQL.ADD(" and  O.TipoOp In ('SECS','SECSV','SECT','SECTV','SEI') ")
    endif
    if Dialogo.Radio3=2
       SQL.ADD(" and  O.TipoOp In ('SEVS','SEVSV','SEVT','SEVTV','SED') ")
    endif
    If NoVacio(val(ee6))
       SQL.ADD(" and O.Vehiculo1='"~val(ee6)~"' ")
    EndIf
    SQL.ADD(" and ( ")
    SQL.ADD(" (TipoOp in ('SEI','SED') and FechaVto Between '"~IdxDate(val(zz5))~"' and '"~IdxDate(Dialogo.Fecha2-1)~"') ")
    SQL.ADD(" or ")
    SQL.ADD(" ((TipoOp in ('SECS','SEVS','SECSV','SEVSV','SECT','SEVT','SECTV','SEVTV') or (TipoOp='DIVIDE' and (MB4='0' or (TipoCambio3=10 and MB4='3'))) or (TipoOp='CUPLIQ' and TipoCambio3=10 and MB4='1')) ")
    SQL.ADD(" and FechaPago Between '"~IdxDate(val(zz5))~"' and '"~IdxDate(Dialogo.Fecha2-1)~"') ")
    SQL.ADD(" ) ")
    If Dialogo.Radio5=0
       SQL.ADD(" order by 1,2 ")
    Else 
       SQL.ADD(" order by 2,1 ")
    EndIf
 
    Recorrer SQL

       Message('Recuperando Operaciones '~fbn['NrOperacion'])

       If FBN['FechaVto']>=Dialogo.Fecha1
          If Val(x1)=1
             dfa
             *-- Calculo de Flujo de Fondos del Periodo
             IF Not Incluido(FBN['TipoOp'],'SEI|SED')
                ACD(fp1,FBN['FechaOp'])
             Else 
                ACD(fp1,FBN['FechaVto'])
             EndIf

             ACD(fp2,Dialogo.Fecha1)

             (.'GERE3POSIC'.)

             acn(g:fac,val(vs1))
             acn(h:fac,val(vs1))
             acn(e:fac,val(pc1))
             acn(f:fac,val(pd1))
             acn(i:fac,val(vs1)*val(f:fac)*(-1))
   
             *-- Numerales
             ACN(m:fac,VAL(i:fac)*val(l:fac))
       
             acn(z:fac,0)

             If val(bb3)=0
                acn(bb3,fac)
             EndIf

             
             acn(w1,0)
  
             *-- w1: Inicio de Flujo para Tir
             acn(w2,0) 

             If VAL(i:fac)<>0
                acn(w1,val(bb3))    

                *--- Lista de Parametros1 para Tir
                acn(n:fac,0)
                acn(w2,val(l:fac))
             EndIf

             SetFont(e:fac..m:FAC,1)
             FormatoCeldas(g:fac..j:fac,Exe('F2'))
             FormatoCeldas(e:fac..f:fac,Exe('F6'))
             Ifa 
          EndIf

          *------
          * Listo la Operacion Total
          acd(a:fac,fbn['FechaOp'])
          ACD(b:FAC, fbn['FechaVto'])
 
          act(c:fac, fbn['Cliente1'])
          act(d:fac, fbn['TipoOp'])

          act(k:fac,FBN['NrOperacion']) 

          *-- Link con consulta de operaciones
          ACLO(k:fac,Val(k:fac))

          If Not Incluido(fbn['TipoOp'],'DIVIDE|CUPLIQ')
             acn(e:fac,Abs(fbn['Monto']/fbn['Cantidad']))
             acn(f:fac,Abs(fbn['Flujo']/fbn['Cantidad']))

             * va1: Vol.Comprado va2: Vol.Vendido
             If Incluido(FBN['TipoOp'],'SECS|SECSV|SECT|SECTV|SEI' )
                acn(g:fac,fbn['Cantidad'])
                scn(va1,val(g:fac))
             Else
                acn(g:fac,-fbn['Cantidad'])
                scn(va2,-val(g:fac))
             EndIf

             *-- va1: Vol.Comprado va2: Vol.Vendido pp1: Precio Promedio Compra pp2: PP Venta
             acn(h:fac,val(h:fac-1)+val(g:fac))
             acn(i:fac,Abs(FBN['Flujo']))

             *-- Flujo de Fondos-> Negativo para Compras  y  Positivo para Ventas
             If Incluido(FBN['TipoOp'],'SECS|SECSV|SECT|SECTV|SEI' )
                scn(fa1,val(i:fac)) 
                acn(i:fac,-val(i:fac))
             Else 
                scn(fa2,val(i:fac)) 
             EndIf       

             acn(j:fac,val(i:fac)+val(j:fac-1))        

             acn(l:fac,Dialogo.Fecha2-val(b:fac))
             acn(m:fac,VAL(i:fac)*val(l:fac))

             * w1: Inicio de Flujo para Tir
             If VAL(i:fac)<>0 y val(w1)=0
                acn(w1,fac)   
             EndIf

             * Lista de Parametros1 para Tir para Periodo
             acn(n:fac,val(b:fac)-Dialogo.Fecha1)

             * Max. de Dias para valuar la Tir del Periodo
             If val(w2)=0
                acn(w2,val(l:fac))
             EndIf

             * Valores para Parametro de TIR para Anual
             ACN(val(bb4):val(bb3)  ,FBN['FechaVto']-val(zz5))
             ACN(val(bb4):val(bb3)+1,VAL(i:fac))
  
             * 1er. Valor de Columna para Tir de Acumulado Año
             If val(val(bb4):val(bb3)+1)<>0 y val(w4)=0
                acn(w4,val(bb4))    
             EndIf
             SCN(bb4,1)
  
             * Max. de Dias para valuar la Tir del Acumulado
             If val(w3)=0
                acn(w3,val(l:fac))
             EndIf

             scn(bb1,val(i:fac)*(Dialogo.Fecha2-fbn['FechaVto'])/365)
             acn(z:fac,(fbn['FechaVto']-Dialogo.Fecha1)/365)
          Else  
             *** calcula precio sucio ***
             act(ca:fac,FBN['Especie'])
             acd(ck:fac,fbn['FechaOp'])
  
             * Efectivo
             If fbn['TotalNetoCli1']<>0
                act(d:fac, VAL(d:fac)~' Efectivo ')     
                acn(e:fac  ,fbn['Precio1']/100)
                acn(g:fac  ,0)
                acn(h:fac,val(h:fac-1)+val(g:fac))
                acn(i:fac  ,fbn['TotalNetoCli1'])
 
                (.'SUCIO'.)
     
                acn(f:fac,val(ci:fac)*(val(e:fac)+val(cj:fac)))            
                acn(j:fac,val(i:fac)+val(j:fac-1))        
    
                SetFont(a:FAC..m:FAC,1)
                FormatoCeldas(g:fac..j:fac,Exe('F2'))
                FormatoCeldas(m:fac..m:fac,Exe('F2'))
                FormatoCeldas(e:fac..f:fac,Exe('F7'))
      
                acn(l:fac,Dialogo.Fecha2-val(b:fac))
                acn(m:fac,VAL(i:fac)*val(l:fac))

                * w1: Inicio de Flujo para Tir
                If VAL(i:fac)<>0 y val(w1)=0
                   acn(w1,fac)   
                EndIf
 
                * Lista de Parametros1 para Tir para Periodo
                acn(n:fac,val(b:fac)-Dialogo.Fecha1)

                * Max. de Dias para valuar la Tir del Periodo
                If val(w2)=0
                   acn(w2,val(l:fac))
                EndIf

                * Valores para Parametro de TIR para Anual
                ACN(val(bb4):val(bb3)  ,FBN['FechaVto']-val(zz5))
                ACN(val(bb4):val(bb3)+1,VAL(i:fac))
  
                * 1er. Valor de Columna para Tir de Acumulado Año
                If val(val(bb4):val(bb3)+1)<>0 y val(w4)=0
                   acn(w4,val(bb4))    
                EndIf
                SCN(bb4,1)
  
                * Max. de Dias para valuar la Tir del Acumulado
                If val(w3)=0
                   acn(w3,val(l:fac))
                EndIf

                scn(bb1,val(i:fac)*(Dialogo.Fecha2-fbn['FechaVto'])/365)
                acn(z:fac,(fbn['FechaVto']-val(zz5))/365)
         
                SetFont(a:FAC..m:FAC,1)
                FormatoCeldas(g:fac..j:fac,Exe('F2'))
                FormatoCeldas(e:fac..f:fac,Exe('F7'))
             Else 
                dfa   
             EndIf
 
             If fbn['Monto']<>0
                ifa
                acd(a:fac,fbn['FechaOp'])
                ACD(b:FAC, fbn['FechaVto'])
                act(c:fac, fbn['Cliente1'])
                act(d:fac, fbn['TipoOp'])

                act(d:fac, VAL(d:fac)~' Acciones ')     

                * Acciones
                * acn(e:fac,fbn['Precio2'])
                acn(g:fac,fbn['Monto'])        

                scn(da1,val(g:fac))
                acn(h:fac,val(h:fac-1)+val(g:fac))
                acn(i:fac  ,0)
                (.'SUCIO'.)

                acn(f:fac,val(ci:fac)*(val(e:fac)+val(cj:fac))) 
                acn(j:fac,val(i:fac)+val(j:fac-1))        
  
                SetFont(a:FAC..m:FAC,1)
                FormatoCeldas(g:fac..j:fac,Exe('F2'))
                FormatoCeldas(e:fac..f:fac,Exe('F7'))

                acn(l:fac,Dialogo.Fecha2-val(b:fac))
                acn(m:fac,VAL(i:fac)*val(l:fac))

                * w1: Inicio de Flujo para Tir
                If VAL(i:fac)<>0 y val(w1)=0
                   acn(w1,fac)   
                EndIf

                * Lista de Parametros1 para Tir para Periodo
                acn(n:fac,val(b:fac)-Dialogo.Fecha1)

                * Max. de Dias para valuar la Tir del Periodo
                If val(w2)=0
                   acn(w2,val(l:fac))
                EndIf

                * Valores para Parametro de TIR para Anual
                ACN(val(bb4):val(bb3)  ,VAL(b:fac)-val(zz5))
                ACN(val(bb4):val(bb3)+1,VAL(i:fac))
  
                * 1er. Valor de Columna para Tir de Acumulado Año
                If val(val(bb4):val(bb3)+1)<>0 y val(w4)=0
                   acn(w4,val(bb4))    
                EndIf
                SCN(bb4,1)
  
                * Max. de Dias para valuar la Tir del Acumulado
                If val(w3)=0
                   acn(w3,val(l:fac))
                EndIf

                scn(bb1,val(i:fac)*(Dialogo.Fecha2-fbn['FechaVto'])/365)
                acn(z:fac,(fbn['FechaVto']-val(zz5))/365)
             EndIf
          EndIf
          scn(x1,1) 
       Else
          dfa    
          If val(bb3)=0
             acn(bb3,fac)
          EndIf

          *---- Valores para Parametro de TIR
          ACN(val(bb4):val(bb3),FBN['FechaVto']-val(zz5))
     
          * Son Minutas que pasan a formar parte del Acumulado del Año
          If Incluido(FBN['TipoOp'],'SECS|SECSV|SECT|SECTV|SEI')
             SCN(j:fac,-FBN['Flujo'])
             ACN(val(bb4):val(bb3)+1,-FBN['Flujo'])
          EndIf
      
          If Incluido(FBN['TipoOp'],'SEVS|SEVSV|SEVT|SEVTV|SED')
             SCN(j:fac, FBN['Flujo'])
             ACN(val(bb4):val(bb3)+1,FBN['Flujo'])
          EndIf
      
          If Incluido(FBN['TipoOp'],'DIVIDE')
             SCN(j:fac,FBN['Monto'])
             ACN(val(bb4):val(bb3)+1,FBN['Monto'])
          EndIf

          If Incluido(FBN['TipoOp'],'CUPLIQ')
             SCN(j:fac,FBN['TotalNetoCli1'])
             ACN(val(bb4):val(bb3)+1,FBN['TotalNetoCli1'])
          EndIf

          * Max. de Dias para valuar la Tir del Acumulado
          If val(w3)=0 y val(val(bb4):val(bb3)+1)<>0
             acn(w3,Dialogo.Fecha2-FBN['FechaVto'])
          EndIf

          *- Guardo en w5 el ultimo valor para restar si no hay operaciones del periodo
          If val(w5)>(Dialogo.Fecha2-FBN['FechaVto']) o val(w5)=0
              acn(w5,Dialogo.Fecha2-FBN['FechaVto'])
          EndIf         

          * 1er. Valor de Columna para Tir de Acumulado Año
          If val(val(bb4):val(bb3)+1)<>0 y val(w4)=0
             acn(w4,val(bb4))    
          EndIf

          SCN(bb4,1)

          *-- Calculo de Numerales
          ACN(m:fac,VAL(i:fac)*val(l:fac))
       EndIf

       SetFont(a:FAC..m:FAC,1)
       FormatoCeldas(g:fac..j:fac,Exe('F2'))
       FormatoCeldas(e:fac..f:fac,Exe('F7'))
    Proximo

    *- No recupero ninguna operacion del periodo
    If val(x1)=1

       *-- Calculo de Flujo de Fondos del Periodo
       ACD(fp1,Dialogo.Fecha1)
       ACD(fp2,Dialogo.Fecha1)

       (.'GERE3POSIC'.)

       acn(g:fac,val(vs1))
       acn(h:fac,val(vs1))
       acn(e:fac,val(pc1))
       acn(f:fac,val(pd1))
       acn(i:fac,val(vs1)*val(f:fac)*(-1))
   
       *-- Numerales
       ACN(m:fac,VAL(i:fac)*val(l:fac))
       
       acn(z:fac,0)
       acn(bb3,fac)
       acn(w1,0)
  
       *-- w1: Inicio de Flujo para Tir
       acn(w2,0) 
       If VAL(i:fac)<>0
          acn(w1,val(bb3))    

          *--- Lista de Parametros1 para Tir
          acn(n:fac,0)
          acn(w2,val(l:fac))
       EndIf
       SetFont(e:fac..m:FAC,1)
       FormatoCeldas(g:fac..j:fac,Exe('F2'))
       FormatoCeldas(e:fac..f:fac,Exe('F6'))
    EndIf

    if val(x1) >= 1
       ifa
       (.'TOTGERE03'.)
       ifa
    endif
