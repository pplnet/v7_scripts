CrearDialogo
  Vehiculo1  : "Grupo"                                 ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : "Vehiculo"                              ;;;;Vacio(Dialogo.Vehiculo1);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Book1      : "Book"                                  ;;; 
  Especie1   : "Moneda"                                ;;;;;;;;;;;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA'))~") and Status = 'HAB'";;
  Fecha1     : "F.Desde"                               ;5;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"                               ;5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys + VAR('DIASIMPUES')
  Radio1     : "Impuestos|Aplicado|No Aplicado|Ambos " ;6;1;;;;;;;2
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1,"Arial,8,B")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,8,")

SetFilaActual(1)
ACT(a:1,'Movimientos Con Impuestos')
SetFont(a:1, 2)

SetFilaActual(2)

ACT(xx:3, Dialogo.Lista1)

If NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Grupo : '~Dialogo.Vehiculo1)
Else
  If NoVacio(Dialogo.Lista1)
    ACT(a:FAC+1, 'Vehiculo/s : '~Dialogo.Lista1) 
  Else 
    ACT(a:FAC+1, 'Vehiculo : Todos')
  Endif
Endif

If NoVacio(Dialogo.Book1)
  ACT(a:FAC+2, 'Book : '~Dialogo.Book1~' '~BuscarCampo('Books','Descripcion','Codigo',Dialogo.Book1))
Else
  ACT(a:FAC+2, 'Book : Todos')
EndIf

If Dialogo.Radio1 = 0
  ACT(a:FAC+3, 'Impuestos : Aplicados')
Else
  If Dialogo.Radio1 = 1
    ACT(a:FAC+3, 'Impuestos : No aplicados')
  Else
    ACT(a:FAC+3, 'Impuestos : Ambos')
  EndIf
EndIf

If NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Moneda : '~Dialogo.Especie1~' '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
  ACT(a:FAC+4, 'Moneda : Todas')
EndIf

ACT(a:FAC+5, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+6, 'Fecha Hasta: '~Dialogo.Fecha2)

SetFont(a:FAC+1..a:FAC+6, 1)

SetFilaActual(FAC+8)

ACT(a:FAC, 'Operacion')
ACT(b:FAC, 'Fecha Mov')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Moneda')
ACT(e:FAC, 'Vehiculo')
ACT(f:FAC, 'Cantidad')
ACT(g:FAC, 'Concepto')
ACT(h:FAC, 'Impuestos')
ACT(i:FAC, 'Fecha Asig')
ACT(j:FAC, 'Usuario')

ACN(FI:1, fac+1)

SetFont(a:FAC..j:FAC, 1)
AgregarMarco(a:FAC..j:FAC,2,0,exe('COLOR'))

If Dialogo.Radio1 = 2
  (.'CONCONIMP'.)
  SQL.ADD(" UNION ")
  (.'CONSINIMP'.)
ELSE
  If Dialogo.Radio1 = 1
    (.'CONSINIMP'.)
  Else
    (.'CONCONIMP'.)
  EndIf
EndIF

SQL.ADD(" ORDER BY 5, 4 ")
ACT(z:1, '')

Recorrer SQL
