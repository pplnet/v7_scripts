CrearDialogo
  Fecha1  : 'D.FechaPago' ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30
  Fecha2  : 'H.FechaPago' ;1;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys
  Vehiculo1: 'Vehiculo'   ;2;1;;;;NOVACIO(Dialogo.Vehiculo1) y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(USUARIOACTIVO)) o Vacio(UsrVehiculos(UsuarioActivo))] ;'Vehiculo Invalido';NO;BuscarCampo('USRVEHICULO','Vehiculo','Codigo',USUARIOACTIVO);;;;;iif(NoVacio(UsrVehiculos(UsuarioActivo)), " Codigo in (Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"') ")
  Radio2  :'Estado|Asignado|Entregado|Pagado|Todos';3 ;1;;;;;;;3;
  Lista1:    'Bancos'      ; ;1;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista2:    'Cuentas'    ;-2;2;1;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Cliente = '"~Dialogo.Vehiculo1~"' AND Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ");
  Entero1 :  'Cheq. Desde' ; ;1;;;;;'Numero de Cheque Desde Invalido';NO;              ;;;;'##############';;
  Entero2 :  'Cheq. Hasta' ; ;1;;;;;'Numero de Cheque Hasta Invalido';NO;99999999999999;;;;'##############';;
  
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,14,B")
CrearFont(2,"Arial,12,")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,")
CrearFont(6,"Arial,8,B")

IF Dialogo.Radio2=0
    ACT(ES:1, 'Asignado')
ENDIF
IF Dialogo.Radio2=1
    ACT(ES:1, 'Entregado')
ENDIF
IF Dialogo.Radio2=2
    ACT(ES:1, 'Pagado')
ENDIF
IF Dialogo.Radio2=3
    ACT(ES:1, 'Todos')
ENDIF

SetFilaActual(2)
ACT(A:fac, 'Informe General de Cheques')
SetFont(A:fac, 1)
ifa
ifa
ACT(A:fac, 'Desde : '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Hasta : '~Dialogo.Fecha2)
ifa
ACT(A:fac, 'Estado: '~Val(ES:1))
ifa
IF vacio(Dialogo.Lista1)
  ACT(A:fac, 'Bancos: Todos')
ELSE
  ACT(A:fac, 'Bancos: '~Pipe2Comillas(Dialogo.Lista1))
ENDIF
ifa
IF vacio(Dialogo.Lista2)
  ACT(A:fac, 'Cuentas: Todas')
ELSE
  ACT(A:fac, 'Cuentas: '~Pipe2Comillas(Dialogo.Lista2))
ENDIF
ifa
ACT(A:fac, 'Vehiculo : '~Dialogo.Vehiculo1)
SetFont(A:fac-5..A:fac, 3)

SetFilaActual(11)

ACT(A:fac, 'Numero de')
ACT(A:fac+1, 'Chequera')
ACT(B:fac, 'Numero de')
ACT(B:fac+1, 'Cheque')
ACT(C:fac, 'Fecha de')
ACT(C:fac+1, 'Emision')
ACT(d:fac, 'Fecha de')
ACT(d:fac+1, 'Vto/Pago')
ACT(e:fac, 'Proveedor')
ACT(f:fac, 'Banco')
ACT(g:fac, 'Cuenta')
ACT(h:fac, 'Monto')
ACT(i:fac, 'Numero de')
ACT(i:fac+1, 'Transaccion')
ACT(j:fac, 'Estado')

ifa
AlinearCeldas(A:fac-1..j:fac, 'C')
SetFont(A:fac-1..j:fac, 3)
AgregarMarco(A:fac-1..j:fac,2,0,EXE('COLOR6'))

SQL.ADD(" Select /*+ RULE */ C.Chequera, C.NrCheque, C.FechaEmision, C.Monto, C.NrComprobante, ")
SQL.ADD(" C.Estado, C.FechaPago, B.Banco, B.Cuenta, F.Proveedor, P.Nombre NombreP, F.Especie, ")
SQL.ADD(" T.Numero NroCta, E.Nombre ")
SQL.ADD(" From "~DBO~".CHEQUES C, "~DBO~".CNCHEQUERASBANCO B, "~DBO~".TRANSACCIONES2 F, ")
SQL.ADD(" "~DBO~".CUENTAS T, "~DBO~".ESPECIES E, "~DBO~".CNPROVEEDORES P ")
SQL.ADD(" Where C.Chequera = B.Chequera ")
SQL.ADD(" AND   B.Cuenta = T.Codigo ")
SQL.ADD(" AND   E.Codigo = F.Especie  ")
SQL.ADD(" AND F.Proveedor  *= P.Codigo   ")
SQL.ADD(" AND C.NrComprobante *= F.NrTrans  ")
SQL.ADD(" AND C.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   C.FechaPago <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND   F.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
If novacio(Dialogo.Lista2)
  SQL.ADD(" AND   B.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If novacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Comitente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
IF Dialogo.Entero1 > 0 Y Dialogo.Entero2 > 0
  SQL.ADD(" AND C.NrCheque >= "~Dialogo.Entero1~"  ")
  SQL.ADD(" AND C.NrCheque <= "~Dialogo.Entero2~"  ")
ENDIF
IF Dialogo.Radio2=0
  SQL.ADD(" AND C.Estado = 'ASI' ")
ENDIF
IF Dialogo.Radio2=1
  SQL.ADD(" AND C.Estado = 'ENT' ")
ENDIF
IF Dialogo.Radio2=2
  SQL.ADD(" AND C.Estado = 'PAG' ")
ENDIF
SQL.ADD(" Order By F.Especie, C.Chequera, C.NrCheque, C.FechaEmision ")

ACN(FI:1, fac+1)
ACN(BD:1, 0)
ACT(ES:2, '')
ACN(TO:1, 0)

Recorrer SQL
    message(fbn('Banco')~' - '~fbn('NrComprobante'))
    ACN(BD:1, 1)
    IF Not Eqstr(fbn('Especie'), Val(ES:2))
        IF Not CeldaVacia(ES:2)
            ACT(A:fac, 'Total Especie '~Val(ES:3))
            ACN(h:fac, Val(TO:1))
            AgregarMarco(A:fac..j:fac, 0, 0, 0)
            SetFont(A:fac..h:fac, 6)
            ACN(TO:1, 0)
            SetFilaActual(fac+2)
        ENDIF
        ACT(A:fac, 'Especie: '~fbn('Nombre'))
        AgregarMarco(A:fac..j:fac, 0, 0, Exe('COLOR8'))
        SetFont(A:fac, 6)
        ifa
    ENDIF
    ACT(ES:2, fbn('Especie'))
    ACT(ES:3, fbn('Nombre'))
    ACT(A:fac, fbn('Chequera'))
    ACN(B:fac, fbn('NrCheque'))
    ACT(C:fac, fbn('FechaEmision'))
    ACT(d:fac, fbn('FechaPago'))
    ACT(e:fac, fbn('Proveedor')~'-'~fbn('NombreP'))
    ACT(f:fac, fbn('Banco'))
    ACT(g:fac, fbn('Cuenta')~' - '~fbn('NroCta'))
    ACN(h:fac, fbn('Monto'))
    ACT(i:fac, fbn('NrComprobante'))
    ACLT(i:fac, fbn('NrComprobante'))
    IF Eqstr(fbn('Estado'), 'ASI')
      ACT(j:fac, 'Asignado')
    ENDIF
    IF Eqstr(fbn('Estado'), 'PEN')
      ACT(j:fac, 'Pendiente')
    ENDIF
    IF Eqstr(fbn('Estado'), 'ANU')
      ACT(j:fac, 'Anulado')
    ENDIF
    IF Eqstr(fbn('Estado'), 'ENT')
      ACT(j:fac, 'Entregado')
    ENDIF
    IF Eqstr(fbn('Estado'), 'PAG')
      ACT(j:fac, 'Pagado')
    ENDIF
    SCN(TO:1, fbn('Monto'))
    AlinearCeldas(A:fac..A:fac, 'C')
Proximo

IF Val(BD:1)=0 Y Elementos(Dialogo.Lista1)=1
    IF Dialogo.Entero1 = Dialogo.Entero2 Y Dialogo.Entero1 > 0
      Cancelar('El Numero de Cheque Ingresado no fue Emitido entre el '~Dialogo.Fecha1~' y el '~Dialogo.Fecha2)
    ELSE
      Cancelar('Los Numeros de Cheque Ingresados no fueron Emitidos entre el '~Dialogo.Fecha1~' y el '~Dialogo.Fecha2)
    ENDIF
ENDIF

IF Val(BD:1) = 1
  ifa
  ACT(A:fac, 'Total Especie '~Val(ES:3))
  ACN(h:fac, Val(TO:1))
  AgregarMarco(A:fac..j:fac, 0, 0, 0)
  SetFont(A:fac..h:fac, 6)
ENDIF
ifa
FormatoCeldas(B:Val(FI:1)..B:fac, Exe('F0'))
AlinearCeldas(i:Val(FI:1)..j:fac, 'C')
AgregarMarco(A:Val(FI:1)..j:fac,2,0)
ifa
ifa
ACT(A:fac, 'Fin del Informe.')
SetFont(A:fac, 3)

ACO(1, 8)
ACO(2, 8)
ACO(3, 8)
ACO(4, 8)
ACO(5, 20)
ACO(6, 7)
ACO(7, 15)
ACO(8, 8)
ACO(9, 8)
ACO(10, 6)

*SetPrintFit(3, 90)
Impresion(1,2)
Impresion(4,1)
LimitesVision(k:fac+1)
