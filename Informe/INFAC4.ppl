ModoReproceso(SinDialogo)
CrearDialogo
    Fecha1:    'Fecha Liq:';1;;;;;NoVacio(Dialogo.Fecha1);'Ingrese una fecha';NO;FSys;
    Vehiculo1: 'Vehiculo:' ;2;;;;;NOVACIO(Dialogo.Vehiculo1);;;VAR('VEHICULODE')
    Lista1:'Tipos Op.' ;3;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo in ('TIC','TIV','TIFC','TIFV','TCOPRI','TCPCEM','EQC','EQV') ")  
    Mercado1: 'Mercado' ;;;;;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, "Arial,11,BU")
CrearFont(2, "Arial,9,B"  )
CrearFont(3, "Arial,8,"   )
CrearFont(4, "Arial,9,BU"  )

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

SetFilaActual(3)

**-- Encabezado --**
ACT(a:FAC, 'Informe de Preliquidacion x Mercado Liquidacion Especie')
SetFont(a:1..a:FAC, 1)

ACT(a:FAC+2, 'Fecha Liq.: '~Dialogo.Fecha1)

If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+3, 'Tipo Op: '~Pipe2Comillas(Dialogo.Lista1))
Else
   ACT(a:FAC+3, 'Tipo Op: Todas')
Endif

SetFont(a:FAC+2..b:FAC+3, 2) 


If NoVacio(Dialogo.Mercado1)
   ACT(a:FAC, 'Informe de Preliquidacion Mercado : '~Dialogo.Mercado1~' - '~SQL("Select descripcion from "~DBO~".Mercados where codigo = '"~Dialogo.Mercado1~"'"))
   SetFont(a:1..a:FAC, 1)
   SetFilaActual(FAC+4)
Else
   ACT(a:FAC+4, 'Mercado: Todos')
   SetFont(a:FAC+4..b:FAC+4, 2) 
   SetFilaActual(FAC+5)
Endif

ACN(fa1, FAC+4)

ACN(xy1,0)

SQL.ADD("select E.Jerarquia, M.Especie, Sum(M.Cantidad) as Cant,E.CodMAEContado, O.Mercado, ")
SQL.ADD("       CASE WHEN M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END Cuenta, ")
SQL.ADD("       E.Codigo4, E.VTeorico, M.Mercado+CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END Clave ")
SQL.ADD(" from  "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B     ")
SQL.ADD(" where M.NrOperacion = B.NrOperacion ")
SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
SQL.ADD("  and  M.FechaMov   = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  O.Mercado = '"~Dialogo.Mercado1~"'         ")
Endif
SQL.ADD("  and  rtrim(ltrim(M.Mercado)) <> '' ")
SQL.ADD("  and  M.Especie     = E.Codigo      ")
SQL.ADD("  and  B.NrBit       = 10            ")
SQL.ADD("  and  B.Valor       = '1'           ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("  and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV') ")
Endif
SQL.ADD(" group by E.Jerarquia, M.Especie,E.CodMAEContado,O.Mercado,M.Mercado,CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END,E.Codigo4,E.VTeorico ")
SQL.ADD(" order by O.Mercado, Substring (E.Jerarquia,1,3), CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END, M.Especie                   ")
Watch(sql.batch)

ACN(fl1, fac+1)

Recorrer SQL

    ACN(xy1,1)
    ACT(ce1, FBN['Especie'])
    ACN(cn:1, FBN['Cant'])

    **  Corte de control x Especie
    If Not EqStr(val(fa2),fbn('Clave'))

    ACT(a:FAC, 'Mercado Liq: '~FBN['Mercado']~' - '~SQL("Select Descripcion from "~DBO~".MERCADOS where codigo = '"~FBN('Mercado')~"'")~' - Mercado Mov: '~Copy(FBN['Clave'],1,6)~' - Cuenta: '~fbn('Cuenta')~' - '~SQL("Select Nombre from "~DBO~".CUENTAS where codigo = '"~FBN('Cuenta')~"'")~' - Nro: '    ~SQL("Select Numero from "~DBO~".CUENTAS where codigo = '"~FBN('Cuenta')~"' "))
       SetFont(a:FAC, 2)
       ifa

       ACT(a:FAC, 'Nro.Oper.' )
       ACT(b:FAC, 'Tipo Op.'  )
       ACT(c:FAC, 'Boleto'    )
       ACT(d:FAC, 'Cliente'   )
       ACT(e:FAC, 'Fecha Op.' )
       ACT(f:FAC, 'Fecha Vto.')
       ACT(g:FAC, 'Especie'   )
       ACT(h:FAC, 'Cod CV'    )
       ACT(i:fac, 'Cod MAE'   )
       ACT(j:FAC, 'Cantidad'  )
       ACT(k:FAC, 'Cont.Esp.' )
       ACT(l:FAC, 'Precio'    )
       ACT(m:FAC, 'Monto'     )
       ACT(n:FAC, 'Int. Corr.')
       ACT(o:FAC, 'Neto'      )

       SetFont(a:FAc..t:FAC, 2)
       AgregarMarco(a:FAC..t:FAC, 2,0,Exe('COLOR6'))
       AlinearCeldas(a:FAC..d:FAC, 'I')
       AlinearCeldas(h:FAC..h:FAC, 'D')
       AlinearCeldas(e:FAC..g:FAC, 'C')
       AlinearCeldas(k:FAC..k:FAC, 'C')
       AlinearCeldas(l:FAC..o:FAC, 'D')
       ifa

*       act(fa2,fbn('Mercado'))
       act(fa2,fbn('Clave'))
    Endif

    **-- Rotulo de Total por Especie
    If Val(cn:1)>0
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~' - ML: '~fbn('Codigo4')~') ')
       ACN(d:FAC, -Val(cn:1))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Else
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~' - ML: '~fbn('Codigo4')~') ')
       ACN(d:FAC, -Val(cn:1))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Endif

    ACN(fi1, FAC)

    SQL.ADD("Select O.TipoOp,              O.NrOperacion,        O.NrBoleto,      O.Cliente1,    O.FechaOp, ")
    SQL.ADD("       coalesce(O.FechaAltaSisExterno,O.FechaVto) FechaVto,          O.Especie,     O.Cantidad, O.ContraEspecie, O.Precio1, ")
    SQL.ADD("       O.TotalBrutoCli1,      O.TotalIntereses,     O.TotalNetoCli1, O.Cuenta1,     U.Nombre NomCta, ")
    SQL.ADD("       R.Descripcion,         C.RazonSocial,        E.Jerarquia,     E1.InteresesC, C.NrMAE, ")
    SQL.ADD("       M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov,         M.Mercado,     CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END Cuenta, ")
    SQL.ADD("       E.CodNumCajaValores,   E.CodMAEContado,      O.Convenio,      O.FechaPago ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo, "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion                    ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion                    ")
    SQL.ADD("  and  M.Mercado     = R.Codigo                         ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo                         ")
    SQL.ADD("  and  M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"'    ")
    SQL.ADD("  and  M.Mercado+CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END = '"~fbn('Clave')~"'           ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"'                   ")
    SQL.ADD("  and  B.NrBit       = 10                               ")
    SQL.ADD("  and  B.Valor       = '1'                              ")
    If NoVacio(Dialogo.Lista1)
       SQL.ADD(" and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
    Else
       SQL.ADD(" and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV','TCOPRI','TCPCEM','EQC','EQV') ")
    Endif
    SQL.ADD("  and  (O.TipoOp<>'TCOPRI' OR O.Cliente1<>'"~Dialogo.Vehiculo1~"')    ")
    SQL.ADD(" UNION ")
    SQL.ADD("Select O.TipoOp,              O.NrOperacion,        O.NrBoleto,      O.Cliente1,      O.FechaOp, ")
    SQL.ADD("       O.FechaVto,            O.Especie,            O.Cantidad,      O.ContraEspecie, O.Precio1, ")
    SQL.ADD("       O.TotalBrutoCli1,      O.TotalIntereses,     O.TotalNetoCli1, O.Cuenta1,       U.Nombre NomCta, ")
    SQL.ADD("       R.Descripcion,         C.RazonSocial,        E.Jerarquia,     E1.InteresesC,   C.NrMAE, ")
    SQL.ADD("-      M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov,         M.Mercado,       CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END Cuenta, ")
    SQL.ADD("       E.CodNumCajaValores,   E.CodMAEContado,      O.Convenio,      O.FechaPago  ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo, "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie           ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion                              ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion                              ")
    SQL.ADD("  and  M.Mercado     = R.Codigo                                   ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo                                   ")
    SQL.ADD("  and  M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"'              ")
    SQL.ADD("  and  M.Mercado+CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END = '"~fbn('Clave')~"' ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"'                             ")
    SQL.ADD("  and  B.NrBit       = 10                                         ")
    SQL.ADD("  and  B.Valor       = '1'                                        ")
    SQL.ADD("  and  O.TipoOp      = 'TCOPRI' ")
    SQL.ADD("  AND  O.Cliente1    = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD(" Order By E.Jerarquia, M.Mercado, CASE WHEN  M.Especie=O.Especie THEN O.Cuenta2 ELSE O.Cuenta3 END, O.Especie, O.NrOperacion        ")

    watch(SQL.Batch())

    Recorrer SQL

        If Not EqStr(val(ck1),FBN['NrOperacion'])
           ACT(ck1, FBN['NrOperacion'])           
        EndIf
        
        **-- Linea de Detalle  
        ACT(a:FAC, FBN['NrOperacion']  )
        ACLO(a:FAC, FBN['NrOperacion'] )
        ACT(b:FAC, FBN['TipoOp']       )
        ACT(c:FAC, FBN['NrBoleto']     )
        ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial']~' Nro.MAE '~FBN['NrMAE'])
        ACD(e:FAC, FBN['FechaOp']      )
        if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|TCOPRI')
          if FBN['Convenio']=1
            * Operaciones Diferidas
            ACD(f:FAC, FBN['FechaPago'])
          else
            ACD(f:FAC, FBN['FechaVto'])
          endif
        else
          ACD(f:FAC, FBN['FechaVto'])
        endif
        ACT(g:FAC, FBN['Especie']      )
        ACT(h:fac, FBN['CodMAEContado'])            
        ACT(i:fac, FBN['CodNumCajaValores'])
        ACN(j:FAC, FBN['CantMov']      )
        ACT(k:FAC, FBN['ContraEspecie'])
        ACN(l:FAC, FBN['Precio1']      )
        
        If FBN['NrMov']<>1000
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
             ACN(m:FAC, FBN['TotalBrutoCli1'])

             IF EqStr(FBN['InteresesC'],'CLE')
                ACN(n:FAC, FBN['TotalIntereses'])
             EndIf

             ACN(o:FAC, FBN['TotalNetoCli1'])
           Else
             ACN(m:FAC, -FBN['TotalBrutoCli1'])

             IF EqStr(FBN['InteresesC'],'CLE')
                ACN(n:FAC, -FBN['TotalIntereses'])
             EndIf

             ACN(o:FAC, -FBN['TotalNetoCli1'])           
           EndIf
        Else 
            ACN(o:FAC, FBN['CantMov'])
        EndIf

        *-                 
        If DesciendedeEspecie(Val(ce1), 'MONEDA')
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
              SCN(tc1, FBN['CantMov'])
           Else
              SCN(tp1, FBN['CantMov'])
           Endif
        Else
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
              SCN(tc2, FBN['CantMov'])
           Else
              SCN(tp2, FBN['CantMov'])
           Endif
        Endif

        SetFont(a:FAC..s:FAC, 3)
        AlinearCeldas(e:FAC..g:FAC, 'C')
        AlinearCeldas(k:FAC..k:FAC, 'C')                
        FormatoCeldas(j:fac..o:fac, EXE('F2'))
        FormatoCeldas(l:fac..l:fac, EXE('F6'))

     Proximo

     IFA
     *--Impresion de totales por Especie
     If DesciendedeEspecie(Val(ce1), 'MONEDA')
        ACT(g:Val(fi1),'Total a Pagar '~Val(ce1)~': ')
        ACN(j:Val(fi1), Abs(Val(tc1)))
        ACT(l:Val(fi1),'Total a Cobrar '~Val(ce1)~': ')
        ACN(n:Val(fi1), Abs(Val(tp1)))
        ACN(d:Val(fi1), Val(d:Val(fi1)))
     Else
        ACT(g:Val(fi1),'Total a Entregar '~Val(ce1)~': ')
        ACN(j:Val(fi1), Abs(Val(tp2)))
        ACN(k:val(fi1), val(j:val(fi1)) * fbn('VTeorico'))
        ACT(l:Val(fi1),'Total a Recibir '~Val(ce1)~': ')
        ACN(n:Val(fi1), Abs(Val(tc2)))
        ACN(o:val(fi1), val(n:val(fi1)) * fbn('VTeorico'))
*        ACN(d:Val(fi1), Val(d:Val(fi1)))
        ACN(e:val(fi1), Val(d:Val(fi1)) * fbn('VTeorico'))
     Endif
     FormatoCeldas(a:val(fi1)..p:val(fi1),EXE('F2'))

     SetFont(a:Val(fi1)..q:Val(fi1),2)
     ACN(tc1, 0)
     ACN(tp1, 0)
     ACN(tc2, 0)
     ACN(tp2, 0)
Proximo
FormatoCeldas(c:Val(fl1)..c:fac,Exe('F2'))
IFA

If Val(xy1)=0
   ACT(b:fac, 'Sin Movimientos a Liquidar')
   SetFont(b:fac,2)
   ifa
   ifa
Endif

*--Agrego los diferimientos
ACT(a:fac,'Diferimientos')
SetFont(a:fac,1)
ifa
ifa
*
ACN(xy1,0)

SQL.ADD("select O.Mercado, O.Especie, o.contraespecie, O.NrOperacion, O.TipoOp, O.FechaVto, O.FechaAltaSisExterno, O.Cliente1, C.RazonSocial ,o.cantidad cantidad_orig,mp.cantidad cantidad_dif,mp.fechamov,mp.mercado mp_mercado,mp.especie mp_especie,mp.cantidad mp_cantidad")
SQL.ADD("from OPERACIONES O, MOVPENDIENTES MP, "~DBO~".CLIENTES C     ")
SQL.ADD("where O.NrOperacion = MP.NrOperacion                         ")
SQL.ADD("and   O.Cliente1    = C.Codigo                               ")
*SQL.ADD("and   O.Especie     = MP.Especie                             ")
SQL.ADD("and   O.Convenio    = 1                                      ")
SQL.ADD("and   mp.Fechamov  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and   O.FechaAltaSisExterno  = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and   mp.fechamov in (select max(fechamov) from MOVPENDIENTES Mov where mov.nroperacion = O.NrOperacion and Mov.Especie=O.Especie ) ")

Recorrer SQL

   If Val(xy1)=0
      ACN(xy1,1)
      ACT(a:fac, 'Nro.Oper.'   )
      ACT(b:fac, 'Tipo Op.'    )
      ACT(c:fac, 'Fecha Orig.' )
      ACT(d:fac, 'Cliente'     )
      ACT(e:fac, 'Fecha Dife.'  )
      ACT(f:fac, 'Dif. dias'   )
      ACT(g:fac, 'Mercado'     )   
      ACT(h:fac, 'Especie'     )
      ACT(i:fac, 'Cant / Monto Dif.'     )

      AgregarMarco(a:FAC..i:FAC, 2,0,Exe('COLOR6'))
      SetFont(a:FAc..i:FAC, 2)
      ifa
   Endif

   ACT(a:fac, FBN['NrOperacion']        )
   ACLO(a:fac, FBN['NrOperacion']       )
   ACT(b:fac, FBN['TipoOp']             )
   ACD(c:fac, FBN['FechaAltaSisExterno'])
   ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial'])
   *ACD(e:fac, FBN['FechaVto']           )
   ACD(e:fac, FBN['Fechamov']           )
   ACt(f:fac, fstr(DifDias(FBN['FechaVto'],FBN['FechaAltaSisExterno'],'ARG'),1,0))
   ACT(g:fac, FBN['mp_Mercado']            )
   ACT(h:fac, FBN['mp_Especie'])
   ACN(i:fac, (-1)*FBN['mp_cantidad'])
   FormatoCeldas(h:fac..l:fac,Exe('F2'))
Proximo

If Val(xy1)=0
   ACT(b:fac, 'Sin Movimientos Diferidos')
   SetFont(b:fac,2)
Endif
   
ifa
ifa
*

Impresion(1,2)
SetPrintFit(3,70)
ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac..a:fac,2)
LimitesVision(o:fac)
RangoTitulo(a:1..o:FAC, 6)

*-- Ajuste de celdas
ACO(1,7)
ACO(2,5)
ACO(3,7)
ACO(4,31)
ACO(5,8)
ACO(6,6)
ACO(7,8)
ACO(8,9)
ACO(9,9)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)