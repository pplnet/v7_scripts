***---ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'F.Desde'                ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO; FSys
  Fecha2   : 'F.Hasta'                ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO; FSys
  Especie1 : 'Especie'                ;;;;;;[[Dialogo.Radio1 = 1 O Dialogo.Radio1 = 2] Y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA')] O Dialogo.Radio1 = 0 O Vacio(Dialogo.Especie1);'Especie inválida';NO;;;;;;IIF(Dialogo.Radio1 = 1 O Dialogo.Radio1 = 2," Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ");
  Radio1   : 'Fuente|Mercado|BNA'     ;;;;;;;;;0;
  *Identificador : "Leyenda" ;Num Fila;Num Columna;Num Pantalla;Editable;Displayable;Validacion;Warning;Restriccion;Formula Default;Formula Calculo;;;Edicion Numer;Where;
  Radio2   : 'Tipo|Contado|Futuro|Opciones|Todas' ;;;;Dialogo.Radio1 = 0;Dialogo.Radio1 = 0;;;;0;
  Check1   : 'Futuro'                 ;6;1;;Dialogo.Radio2 = 1 Y Dialogo.Radio1 = 0;Dialogo.Radio2 = 1 Y Dialogo.Radio1 = 0;;;;
  Fecha3   : 'Fecha Fut'              ;6;2;;Dialogo.Check1 = 1 Y Dialogo.Radio2 = 1 Y Dialogo.Radio1 = 0; Dialogo.Check1 = 1 Y Dialogo.Radio2 = 1 Y Dialogo.Radio1 = 0;Dialogo.Fecha3<>0;'Debe Ingresar la Fecha';NO;FinDeMes(Fsys+1,NO,'ARG')
  Check2   : 'Opcion'                 ;7;1;;Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;;;;;
  Precio1  : 'Precio Ej'              ;8;1;;Dialogo.Check2 = 1 Y Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;Dialogo.Check2 = 1 Y Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;;;;;;;;'########.########';;
  Fecha4   : 'Fecha Ej'               ;8;2;;Dialogo.Check2 = 1 Y Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;Dialogo.Check2 = 1 Y Dialogo.Radio2 = 2 Y Dialogo.Radio1 = 0;Dialogo.Fecha4<>0;'Debe Ingresar la Fecha';NO; FSys
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)
SetFilaActual(4)
ifa
ACT(a:FAC, 'Fecha desde: '~Dialogo.Fecha1)
ifa
ACT(a:FAC, 'Fecha hasta: '~Dialogo.Fecha2)
If Vacio(Dialogo.Especie1) 
  ifa
  ACT(a:FAC, 'Especie:Todas ')
Else
  ifa
  ACT(a:FAC,'Especie: '~Dialogo.Especie1)
EndIf
IF Dialogo.Radio1 = 0
    ifa
    ACT(a:FAC, 'Fuente: Mercado')
    IF Dialogo.Radio2 = 0
        ifa
        ACT(A:FAC, 'Tipo: Contado')
    ELSE
        IF Dialogo.Radio2 = 1
            ifa
            ACT(A:FAC, 'Tipo: Futuro')
            ifa
            IF Dialogo.Check1 = 1
                ACT(A:FAC, 'Fecha Futuro: '~Dialogo.Fecha3)
            ELSE
                ACT(A:FAC, 'Futuro: Todos')
            ENDIF
        ELSE
            IF Dialogo.Radio2 = 2
                ifa
                ACT(A:FAC, 'Tipo: Opciones')
                IF  Dialogo.Check2 = 1
                    ifa
                    ACT(A:FAC, 'Precio Ejercicio: '~Dialogo.Precio1)
                    ifa
                    ACT(A:FAC, 'Fecha Ejercicio: '~Dialogo.Fecha4)
                ELSE
                    ifa
                    ACT(A:FAC, 'Opciones: Todas')
                ENDIF
            ELSE
                ifa
                ACT(A:FAC, 'Tipo: Todas')
            ENDIF
        ENDIF
    ENDIF
ELSE
    ifa
     ACT(a:FAC, 'Fuente: BNA')
ENDIF


SetFont(A:5..A:FAC, 2)

SetFilaActual(FAC+2)

***----------------------INICIO MERCADO------------------------
IF Dialogo.Radio1 = 0

ACT(F:3, '        Cotizaciones de Mercado por Fecha')
SetFont(F:3, 3)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Fecha')
ACT(c:FAC, 'Tipo')
IF Dialogo.Radio2 = 0 O Dialogo.Radio2 = 3
    ACT(d:FAC, 'Fecha Fut./Ej.')
ELSE
    IF Dialogo.Radio2 = 1
        ACT(d:FAC, 'Fecha Fut.')
    ENDIF
    IF Dialogo.Radio2 = 2
    ACT(d:FAC, 'Fecha Ej.') 
    ENDIF
ENDIF

ACT(e:FAC, 'Precio Ej.')
ACT(f:FAC, 'Close')
ACT(g:FAC, 'Ask')
ACT(h:FAC, 'Bid')
ACT(i:FAC, 'Last')
ACT(j:FAC, 'Clean')
ACT(k:FAC, 'Dirty')
SetFont(A:FAC..K:FAC,2)
*ACT(j:FAC, 'ARP')
*ACT(k:FAC, 'USD')
*ACT(l:FAC, 'UYU')

SetFont(a1..z:FAC,2)

AlinearCeldas(a:FAC..k:FAC, 'C')
AgregarMarco(a:FAC..k:fac,1,0,Exe('COLOR'))
ACN(vv:1,FAC)

SQL.ADD("Select Precio1,Precio2,Precio3,Precio4,Codigo,CallPut,FechaEj,PrecioEj,Fecha,Precio5,Precio6,Precio7 ")
SQL.ADD("from "~DBO~".COTIZACIONES where ")
IF Dialogo.Radio2 = 0
    SQL.ADD("CallPut = 'CON' AND")
ELSE
    IF Dialogo.Radio2 = 1
        SQL.ADD("CallPut = 'FUT' AND")
    ELSE
        IF Dialogo.Radio2 = 2
            SQL.ADD("(CallPut = 'CAL' OR CallPut = 'PUT') AND")
        ENDIF
    ENDIF
ENDIF
IF Dialogo.Check1 = 1 O Dialogo.Check2 = 1
    IF Dialogo.Check1 = 1 
        SQL.ADD("FechaEj = '"~IdxDate(Dialogo.Fecha3)~"' AND")
    ENDIF
    IF Dialogo.Check2 = 1
        SQL.ADD("FechaEj = '"~IdxDate(Dialogo.Fecha4)~"' AND PrecioEj = "~Fstr(Dialogo.Precio1, 0, 8)~" AND")
    ENDIF
ENDIF
SQL.ADD("Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and Codigo like  '"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD("and not (Codigo in ('"~VAR('MONELOCA')~"'))")
SQL.ADD("order by Codigo,Fecha")

Recorrer SQL
    ACT(a:fac, fbn('Codigo'))
    ACD(b:fac, fbn('Fecha'))
    ACT(c:fac, 'Contado')
    If Incluido(fbn('CallPut'),'CAL')
      ACT(c:fac, 'Call')
      ACT(d:fac, fbn('FechaEj'))
      ACN(e:fac, fbn('PrecioEj'))
    EndIf
    If Incluido(fbn('CallPut'),'PUT')
      ACT(c:fac, 'Put')
      ACT(d:fac, fbn('FechaEj'))
      ACN(e:fac, fbn('PrecioEj'))
    EndIf
    If Incluido(fbn('CallPut'),'FUT')
      ACT(c:fac, 'Futuro')
      ACT(d:fac, fbn('FechaEj'))
    EndIf
    ACN(f:fac, fbn('Precio1'))
    ACN(g:fac, fbn('Precio2'))
    ACN(h:fac, fbn('Precio3'))
    ACN(i:fac, fbn('Precio4'))

    IF DesciendeDeEspecie(fbn('Codigo'), 'PUBLIC') O DesciendeDeEspecie(fbn('Codigo'), 'CORP B') O DesciendeDeEspecie(fbn('Codigo'), 'EXTRAN')
        ACN(aa:fac,SQL("Select Intereses from "~DBO~".INTERESESCORRIDOS where Fecha = '"~IdxDate(val(b:fac))~"' and Especie ='"~fbn('Codigo')~"' "))
        If Incluido(BuscarCampo('Especies','InteresesC','Codigo',fbn('Codigo')),'CLE')
            ACN(j:fac, val(f:fac))
            ACN(k:fac, val(f:fac)-val(aa:fac))
        Else
            ACN(j:fac, val(f:fac)-val(aa:fac))
            ACN(k:fac, val(f:fac))
        EndIf
    ENDIF
    
*    ACN(j:fac, fbn('Precio5'))
*    ACN(k:fac, fbn('Precio6'))
*    ACN(l:fac, fbn('Precio7'))
Proximo

*SetFont(a10..z:FAC,1)
*SetFont(a12..z:FAC,1)
ACO(1,7)
ACO(4,8)
ACO(5,8)
ACO(6,8)
ACO(7,8)
ACO(8,8)
ACO(9,8)
*ACO(10,8)
*ACO(11,8)
*ACO(12,8)
SetFilaActual(FAC+1)
FormatoCeldas(e:Val(vv:1).. k:FAC,EXE('F8'))
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(k:FAC+1)
RangoTitulo(a:1..k:FAC+1, 9)
SetPrintFit(3, 75.5)

***----------------------FINAL MERCADO------------------------

Else

***----------------------INICIO BNA/BCU-----------------------

If Dialogo.Radio1 = 1 O Dialogo.Radio1 = 2

If Dialogo.Radio1 = 1
  ACT(B:3, '            BNA por Fecha')
  SetFont(B:3, 3)
Else
  ACT(B:3, '            BCU por Fecha')
  SetFont(B:3, 3)
EndIf
ACT(a:FAC,'Especie')
SetFont(A:FAC..A:FAC,2)
ACT(b:FAC,'Fecha')
SetFont(B:FAC..B:FAC,2)
ACT(c:FAC,'Precio Compra')
SetFont(C:FAC..C:FAC,2)
ACT(d:FAC,'Precio Venta')
SetFont(D:FAC..D:FAC,2)

SetFont(a1..z:FAC,2)
SetFont(A:FAC..D:FAC,2)
AlinearCeldas(a:FAC..d:FAC, 'C')
AgregarMarco(a:FAC..d:fac,1,0,Exe('COLOR'))
ACN(vv:1,FAC)

SQL.ADD("Select Especie, Fecha, PrecioCompra, PrecioVenta ")
If Dialogo.Radio1 = 1
  SQL.ADD("from "~DBO~".CIERREBNA where ")
Else
  SQL.ADD("from "~DBO~".CIERREBCU where ")
EndIf
SQL.ADD("Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and Especie like  '"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD("and not (Especie in ('"~VAR('MONELOCA')~"'))")
SQL.ADD("order by Especie, Fecha")

Recorrer SQL
  ACT(a:FAC, fbn('Especie'))
  ACT(b:FAC, fbn('Fecha'))
  ACN(c:FAC, fbn('PrecioCompra'))
  ACN(d:FAC, fbn('PrecioVenta'))
Proximo

*SetFont(a10..z:FAC,1)
ACO(1,7)
ACO(3,9)
ACO(4,9)
SetFilaActual(FAC+1)
FormatoCeldas(c:Val(vv:1).. d:FAC,EXE('F8'))
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(d:FAC+1)
RangoTitulo(a:1..d:FAC+1, 9)
SetPrintFit(3, 100)

EndIf
***----------------------FINAL BNA/BCU------------------------

EndIf

Impresion(1,1)