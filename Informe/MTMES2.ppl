CrearDialogo
  Fecha1:   'Fecha'    ;1;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha invalida';NO;FSys;
  Cliente1: 'Cliente'  ;2;1;;;;
  Mercado1: 'Mercado'  ;3;1;;;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

ACT(A:2,'Calculo de MTM por Especie')
SetFont(A:2,1)

SetFilaActual(4)

ACT(A:FAC,'Fecha: '~Dialogo.Fecha1)
If NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+1,'Cliente: '~Dialogo.Cliente1)
Else
   ACT(A:FAC+1,'Cliente: Todos')
EndIf
If NoVacio(Dialogo.Mercado1)
   ACT(A:FAC+2,'Origen: '~Dialogo.Mercado1)
Else
   ACT(A:FAC+2,'Origen: Todos')
EndIf

SetFont(A:FAC..A:FAC+2,2)

SetFilaActual(FAC+4)

ACT(A:FAC,'Especie')
*ACT(B:FAC,'Operatoria')
ACT(B:FAC,'Mercado')
ACT(C:FAC,'Cliente')
ACT(D:FAC,'Compras')
ACT(E:FAC,'Ventas')
ACT(F:FAC,'Valor MTM')
ACT(G:FAC,'Acumulado MTM')
ACT(H:FAC,'Valor MTM Especie')
ACT(I:FAC,'Acum. MTM Especie')
AlinearCeldas(A:FAC..I:FAC,'C')
AgregarMarco(A:FAC..I:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..I:FAC,2)

SQL.ADD(" Select O.Especie, O.Mercado, O.Cliente1, O.TipoOp, SUM(O.Cantidad) Cantidad, SUM(M.MTM) ValorMTM, SUM(M.MTMEspecie) ValorMTMEspecie,")
SQL.ADD(" (Select SUM(M1.MTM) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.Mercado = O.Mercado and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcumuladoMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.Mercado = O.Mercado and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcuMTMEspecie ")
SQL.ADD("   From "~DBO~".OPERACIONES O, "~DBO~".MTMDIARIO M   ")
SQL.ADD("  Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("    And O.TipoOp in ('TICF','TIVF','FXCF','FXVF')     ")
SQL.ADD("    And M.Fecha= '"~IdxDate(Dialogo.Fecha1)~"'       ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" And O.Cliente1= '"~Dialogo.Cliente1~"'           ")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" And O.Mercado= '"~Dialogo.Mercado1~"'            ")
EndIf
SQL.ADD(" Group By O.Especie, O.Mercado, O.Cliente1, O.TipoOp ")
SQL.ADD(" Order By O.Especie, O.Mercado, O.Cliente1, O.TipoOp ")
watch(sql.batch())
ACN(Z:1,FAC+1)

Recorrer SQL
  If Eqstr(Val(ES:1),'')
     ACT(A:FAC,FBN['Especie'])
     SetFont(A:FAC,2)
     IFA
  EndIf
  
  If Not Eqstr(Fbn['Especie'],Val(ES:1)) Y Not Eqstr(Val(ES:1),'')
     ACT(B:FAC,'Total '~Val(ME:1))
     ACN(F:FAC,Val(TO:2))
     ACN(G:FAC,Val(TO:4))
     SCN(TO:5,Val(F:FAC))
     SCN(TO:6,Val(G:FAC))
    
     ACN(H:FAC,Val(TO:42))
     ACN(I:FAC,Val(TO:44))
     SCN(TO:45,Val(H:FAC))
     SCN(TO:46,Val(I:FAC))

     ACN(TO:2,0)
     ACN(TO:4,0)
     ACN(TO:42,0)
     ACN(TO:44,0)

     AgregarMarco(B:FAC..I:FAC,0,0)
     SetFont(B:FAC..I:FAC,2)

     IFA
     ACT(A:FAC,'Total '~Val(ES:1))
     ACN(F:FAC,Val(TO:1))
     ACN(G:FAC,Val(TO:3))
     ACN(H:FAC,Val(TO:41))
     ACN(I:FAC,Val(TO:43))
     ACN(TO:1,0)
     ACN(TO:2,0)
     ACN(TO:3,0)
     ACN(TO:4,0)
     ACN(TO:41,0)
     ACN(TO:42,0)
     ACN(TO:43,0)
     ACN(TO:44,0)
     AgregarMarco(A:FAC..I:FAC,0,0)
     SetFont(A:FAC..I:FAC,2)
     IFA
     IFA
     ACT(A:FAC,FBN['Especie'])
     SetFont(A:FAC,2)
     IFA
  Else
     If Not Eqstr(Fbn['Mercado'],Val(ME:1)) Y Not Eqstr(Val(ES:1),'')
        ACT(B:FAC,'Total '~Val(ME:1))
        ACL(B:FAC,'MTMDCL', Fecha1=Dialogo.Fecha1, Cliente1='', Mercado1=Val(ME:1), Especie1=Val(ES:1))     
        ACN(F:FAC,Val(TO:2))
        ACN(G:FAC,Val(TO:4))
        ACN(H:FAC,Val(TO:42))
        ACN(I:FAC,Val(TO:44))

        ACN(TO:2,0)
        ACN(TO:4,0)
        ACN(TO:42,0)
        ACN(TO:44,0)
        AgregarMarco(B:FAC..I:FAC,0,0)
        SetFont(B:FAC..I:FAC,2)
        IFA
        IFA        
     EndIf
  EndIf
  
  IF Eqstr(Fbn['Cliente1'],Val(CL:1)) Y Eqstr(Fbn['Especie'],Val(ES:1))
     DFA
     SCN(TO:1,FBN['ValorMTM'])
     SCN(TO:2,FBN['ValorMTM'])
     SCN(TO:7,FBN['ValorMTM'])
     SCN(TO:41,FBN['ValorMTMEspecie'])
     SCN(TO:42,FBN['ValorMTMEspecie'])
     SCN(TO:47,FBN['ValorMTMEspecie'])
     
     ACN(F:FAC,Val(TO:7))
     ACN(H:FAC,Val(TO:47))
     SetFont(F:FAC,3)
     SetFont(H:FAC,3)
  Else
     ACN(TO:7,0)
     ACN(TO:47,0)     
     If Not Eqstr(Fbn['Mercado'],Val(ME:1))
     ACT(B:FAC,FBN['Mercado'])
     SetFont(B:FAC,2)
     IFA
     endif
     ACT(C:FAC,FBN['Cliente1'])
     ACL(C:FAC,'MTMDCL', Fecha1=Dialogo.Fecha1, Cliente1=FBN['Cliente1'], Mercado1=FBN['Mercado'], Especie1=FBN['Especie'])     
     ACN(F:FAC,FBN['ValorMTM'])
     ACN(G:FAC,FBN['AcumuladoMTM'])
     ACN(H:FAC,FBN['ValorMTMEspecie'])
     ACN(I:FAC,FBN['AcuMTMEspecie'])
     
     SCN(TO:1,FBN['ValorMTM'])
     SCN(TO:2,FBN['ValorMTM'])
     SCN(TO:7,FBN['ValorMTM'])
     SCN(TO:41,FBN['ValorMTMEspecie'])
     SCN(TO:42,FBN['ValorMTMEspecie'])
     SCN(TO:47,FBN['ValorMTMEspecie'])

     SCN(TO:3,Val(G:FAC))
     SCN(TO:4,Val(G:FAC))
     SCN(TO:43,Val(I:FAC))
     SCN(TO:44,Val(I:FAC))
     
     SetFont(B:FAC..I:FAC,3)
  EndIf
  
  If Incluido(Fbn['TipoOp'],('TICF|FXCF'))
     ACN(D:FAC,FBN['Cantidad'])
  Else
     ACN(E:FAC,FBN['Cantidad'])
  EndIf
  
  ACT(ES:1,FBN['Especie'])
  ACT(ME:1,FBN['Mercado'])
  ACT(CL:1,FBN['Cliente1'])
Proximo

