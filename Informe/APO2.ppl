ModoReproceso(ConDialogo)
CrearDialogo
  CentrosCosto1    : "Division 1"     ;;;;;;;;;
  CentrosCosto2    : "Division 2"     ;;;;;;;;;
  Especie1   : "Especie"      ;;;;;;;;;
  Fecha1     :'F.Desde'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar Fecha Desde';NO;FSys-Dia(FSys)+1
  Fecha2     :'F.Hasta'       ;;;;;;NoVacio(Dialogo.Fecha2);'Debe Ingresar Fecha Hasta';NO;FinDeMes(FSys,SI,'ARG')
  Radio1     :'Tipo|Todos|Colocacion|Toma' ;;;;NO;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Operaciones de Aporte")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Codigo from "~DBO~".CENTROSCOSTO"))

If NoVacio(Dialogo.CentrosCosto1)
   ACT(a:FAC+1, 'Division : '~BuscarCampo('CENTROSCOSTO','Descripcion','Codigo',Dialogo.CentrosCosto1))
Else
      ACT(a:FAC+1, 'Division : '~val(zz6))

EndIf

If NoVacio(Dialogo.CentrosCosto2)
   ACT(a:FAC+2, 'Division : '~BuscarCampo('CENTROSCOSTO','Descripcion','Codigo',Dialogo.CentrosCosto2))
else
   ACT(a:FAC+2, 'Division : Todos ')
EndIf

acd(zz7,HABILES(Dialogo.Fecha1,-1, VAR('FERIADODEF')))

ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
ACT(a:FAC+4, 'Fecha Desde: '~val(zz7))
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)

if Dialogo.Radio1=0
   ACT(a:FAC+6, 'Tipo de Movimiento : Todos ')
else
   if Dialogo.Radio1=1
      ACT(a:FAC+6, 'Tipo de Movimiento : Colocaciones ')
   else
      ACT(a:FAC+6, 'Tipo de Movimiento : Tomas ')
   endif
endif

SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

act(a:fac, 'Nro Op')
ACT(b:FAC, 'Fecha')
ACT(c:FAC, 'Division 1')
ACT(d:FAC, 'Division 2')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Cantidad')
ACT(g:FAC, 'Operador')
ACT(h:FAC, 'Desembolso')
ACT(i:FAC, 'Op Rel')

AlinearCeldas(a:FAC..i:FAC,'I')
**AlinearCeldas(f:FAC..j:FAC,'D')
SetFont(a:fac..i:FAC,2)
AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)

* Recupero las VIMIND que no son FechasValor
SQL.ADD("Select CASE DateDiff(day,FechaOp,FechaCarga) WHEN 0 THEN 'A' ELSE 'B' End Tip,")
SQL.ADD("O.* from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp IN ('APORTE') ")
If NoVacio(Dialogo.CentrosCosto1)
   SQL.ADD(" and O.Centro1='"~Dialogo.CentrosCosto1~"' ")
Else
      SQL.ADD(" and O.Centro1 IN ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If NoVacio(Dialogo.CentrosCosto2)
   SQL.ADD(" and O.Centro2='"~Dialogo.CentrosCosto2~"' ")
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  ( ")
SQL.ADD(" (O.FechaOp  >= '"~IdxDate(val(zz7))~"' and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ) ")
SQL.ADD(" or ")
SQL.ADD(" (TipoOp='APORTE' and DateDiff(day,FechaOp,FechaCarga)>0 and FechaVto>='"~IdxDate(val(zz7))~"' and FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD(" ) ")

If Dialogo.Radio1=1
   * Coloca
   SQL.ADD(" and MB3 ='0' ")
EndIf
If Dialogo.Radio1=2
   * Toma
   SQL.ADD(" and MB3 ='1' ")
EndIf
SQL.ADD("order by O.Centro1,O.Centro2, O.Especie,O.MB3, Tip, O.FechaOp")

ACT(X1,' ')
ACT(X3,' ')
ACT(X4,' ')
act(x5,' ')
acn(x2,0)

* Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
acn(x7,0)
acn(x8,0)
acn(x9,0)

* Suma Total de x7: Mov.Diarios x8: Capital x9: Interes
acn(x17,0)
acn(x18,0)
acn(x19,0)
acn(zf1,0)

Recorrer SQL
  if Not EqStr(val(x3),fbn['Centro1']~' '~Iif(EqStr(FBN['MB3'],'0'),' Coloca ',' Toma ')~' '~fbn['Centro2']~' '~fbn['Especie']~' '~Iif(EqStr(FBN['Tip'],'B'),' Fecha Valor '))

     * Total de operaciones del cuerpo principal
     If Val(x2)<>0 y EqStr(VAL(x4),'A')
        ifa
        ACT(a:FAC, 'Total ')
        
        SetFont(a:FAC..i:FAC,2)
        FormatoCeldas(f:fac..i:fac,Exe('F2'))
        ifa
        ifa
        * Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
        acn(x7,0)
        acn(x8,0)
        acn(x9,0)
     EndIf

     If Not EqStr(val(x5),fbn['Especie'])
        acn(x17,0)
        acn(x18,0)
        acn(x19,0)
     EndIf

     act(x3,fbn['Centro1']~' '~Iif(EqStr(FBN['MB3'],'0'),' Coloca ',' Toma ')~' '~fbn['Centro2']~' '~fbn['Especie']~' '~Iif(EqStr(FBN['Tip'],'B'),' Fecha Valor '))

     act(x4,fbn['Tip'])

     ACT(a:FAC, val(x3) )

     If  EqStr(val(x4),'A')
         AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))
     Else
         AgregarMarco(a:FAC..d:FAC,1,0)
     EndIf

     SetFont(a:FAC..c:FAC,2)
     ifa
     ifa
     acn(x2,0)
  endif


  acn(x6,0)

  If EqStr(fbn['Tip'],'A') y Not EqStr(fbn['TipoOp'],'VIMINM') 
     *-- Selecciono los Movimientos del Dia.
     SQL.ADD("Select O.Centro1, O.Centro2, O.Especie, ")
     SQL.ADD(" Sum(CASE WHEN O.MB3 = '0' THEN - O.Cantidad ELSE O.Cantidad END) Cant ")
     SQL.ADD("from "~DBO~".OPERACIONES  O ")
     SQL.ADD("where O.TipoOp = 'APORTE' ")
     SQL.ADD(" and O.Centro1 = '"~fbn['Centro1']~"'")
     SQL.ADD(" and O.Centro2 = '"~fbn['Centro2']~"'")
     SQL.ADD(" and O.Especie = '"~fbn['Especie']~"'")
     SQL.ADD(" and  O.FechaOp  = '"~IdxDate(fbn['FechaOp'])~"' ")
     SQL.ADD("group by O.Centro1, O.Centro2, O.Especie ")

     Recorrer SQL

       dfa
       acn(x6,fbn['Cant'])
     Proximo
  EndIf

  act(a:fac,fbn['NrOperacion'])
  aclo(a:fac,fbn['NrOperacion'])
  acd(b:fac,fbn['FechaOp'])
  act(c:fac,fbn['Centro1'])
  act(d:fac,fbn['Centro2'])
  act(e:fac,fbn['Especie'])
  acn(f:fac,fbn['Cantidad'])
  act(g:fac,fbn['Operador'])
  act(h:fac,IIF(EqStr(FBN['CB7'],'0'),'Si','No'))
  act(i:fac,fbn['NrOperacion3'])


  **** Suma Cantidades
  acn(zf1,val(zf1)+fbn['Cantidad'])

  acn(x2,1)
  SetFont(a:FAC..i:FAC,1)
  FormatoCeldas(e:fac..e:fac, EXE('F0'))
  FormatoCeldas(f:fac..i:fac,Exe('F2'))
  FormatoCeldas(i:fac..i:fac,Exe('F6'))
proximo


* Total de operaciones del cuerpo principal
If Val(x2)<>0 y EqStr(VAL(x4),'A')
   ifa
   ifa
   ACT(a:FAC, 'Total ')
   acn(f:fac,val(zf1))

        
   SetFont(a:FAC..i:FAC,2)
   FormatoCeldas(f:fac..i:fac,Exe('F2'))
   ifa
   ifa

   * Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
   acn(x7,0)
   acn(x8,0)
   acn(x9,0)
EndIf

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,5)
ACO(5,5)
ACO(6,12)
ACO(7,12)
ACO(8,12)
ACO(9,8)
ACO(10,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(i:FAC)

*RangoTitulo(a1..i:8,36)