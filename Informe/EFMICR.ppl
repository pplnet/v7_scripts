MostrarCuadroDeMensajes
CrearDialogo
    Fecha1           :  'Fecha' ;;;;;;;;;FSys
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(a:1, "Informe Efectivo Mínimo Cryl")
SetFont(a:1,3)

let &fechaIncorporacion Dialogo.Fecha1

ACT(a:3, "Fecha Incorporacion: "~&fechaIncorporacion)
SetFont(c:1..c:3,2)

ACT(a:5, "Fecha Valor")
ACT(b:5, "Especie")
ACT(c:5, "CuentaContable")
ACT(d:5, "Tipo Registro")
ACT(e:5, "Valor Residual")
ACT(f:5, "Valor Contable")
ACT(g:5, "Valor Cont Valuado")
ACT(h:5, "Nr Operacion")

*AlinearCeldas(a4..h4,'C')
SetFont(a5..h5,2)
AgregarMarco(a5..h5,2,0,Exe('COLOR'))

SQL.ADD("SELECT * FROM "~DBO~".EFECTIVOMINIMOCRYL WHERE FecIncorporacion = '"~IdxDate(&fechaIncorporacion)~"' ")
SQL.ADD("Order By Fecha, Especie, CuentaContable, TipoRegistro ")

let &zz 6

Recorrer SQL
    ACD(a:&zz, fbn('Fecha'))
    ACT(b:&zz, fbn('Especie'))
    ACT(c:&zz, fbn('CuentaContable'))
    ACT(d:&zz, fbn('TipoRegistro'))
    ACN(e:&zz, fbn('ValorResidual'))
    ACN(f:&zz, fbn('ValorContable'))
    ACN(g:&zz, fbn('ValorContValuado'))
    ACT(h:&zz, fbn('NrOperacion'))
    ACLO(h:&zz, fbn('NrOperacion'))
    let &zz &zz+1
Proximo

