SetFilaActual(1)
Let &PrecioNIIF CotizacionNIIF('AL30', FSys-1, 'AFS')
IF Vacio(&PrecioNIIF)
  ACN(a:FAC, 0)
  ACT(b:FAC, 'NIIF cero')
ELSE
  ACN(a:FAC, &PrecioNIIF.PrecioCotizacionDeterminada)
ENDIF

SetFilaActual(FAC+2)
ACN(a:FAC, CotizacionNIIF('AL30', FSys-1, 'AFS').PrecioCotizacionDeterminada)

    IF NO
ModoReproceso(ConDialogo)
CrearDialogo  
  String1 : 'Doc (FE/ND)'     ;3;1;1;SI;SI;;'Debe ingresar una Factura valida.';NO;;;;;'9999-99999999'
FinDialogo
If Not OK
   Cancelar
EndIf
ACT(a1, Dialogo.String1)
if Vacio(Dialogo.String1)
  MessageBox('Vacio')
else
  MessageBox('NO Vacio')
endif
if EqStr(Dialogo.String1,'    -        ')
  MessageBox('Igual (    -        )')
else
  MessageBox('Distino (    -        )')
endif
ENDIF

