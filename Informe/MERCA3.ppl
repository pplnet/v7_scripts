SetFilaActual(5)
SQL.ADD(" SELECT E.Nombre, O.Especie, O.Cliente1, O.Cantidad, O.Precio1, O.FechaVto , O.TotalNetoCli1,             ")
SQL.ADD("        O.TipoOp, O.Mercado, O.NroAltaMAE, O.NrOperacion,                                                 ")
SQL.ADD("        O.ContraEspecie, O.TotalBrutoCli1, E.TamanioLote                                                  ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E                                                           ")
SQL.ADD(" WHERE O.Especie = E.Codigo                                                                               ")
SQL.ADD("   AND O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'                                                          ")
SQL.ADD("   AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                              ")
SQL.ADD("   AND (   (O.TipoOp IN ('TIC','TIV','TIFC','TIFV','FXC','FXCT','FXV','FXVT') and O.PaseCB='0' )          ")
SQL.ADD("        OR (O.TipoOp IN ('TIC','TIV','TIFC','TIFV') and O.PaseCB='1' )                                    ")
SQL.ADD("        OR  O.TipoOp IN ('TIRES','TIADJ','FXA','FXAT','FXCTC','FXVTC','FXOCTC','FXOCTV','TICO','TICT')  ) ")
SQL.ADD(" ORDER BY O.Especie, ContraEspecie, FechaVto, O.NrOperacion                                               ")

