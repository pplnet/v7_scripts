ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:   'D.FechaMov' ;1;1;;;;;;;fsys
  Fecha2:   'H.FechaMov' ;1;2;;;;;;;fsys
  Radio2 : 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;4;1;;;;;;;4
  Check1:  'Incluye Pagadoras';5;1;;;;;;;1
  Lista1:   'Vehiculos' ; 6;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista2:   'Bancos'    ; 0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(a:2, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:3, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:4, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))

If Dialogo.Radio2=0
  ACT(a:6, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:6, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:6, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:6, 'Tipo de Cta: Caja de Ahorro')
Endif
If Dialogo.Radio2=4
  ACT(a:6, 'Tipo de Cta: Todas')
Endif
If Dialogo.Check1=0
  ACT(a:6, Val(a:6)~' - No incluye Cuentas Pagadoras.')
Else
  ACT(a:6, Val(a:6)~' - Incluye Cuentas Pagadoras.')
Endif
SetFont(a:2..a:6,2)

ACT(c:7, 'Movimientos que componen el Saldo del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(c:7,3)

SetFilaActual(9)

ACT(a:fac,   'Cuenta')
ACT(b:fac,   'Vehiculo')
ACT(c:fac,   'Fecha')
ACT(d:fac,   'Importe')
ACT(e:fac,   'Transaccion')
ACT(f:fac,   'Observaciones')
ACT(g:fac,   'Operacion')

AlinearCeldas(a:fac..z:fac+1,'C')
SetFont(a:fac..z:fac+1,2)
AgregarMarco(a:fac..g:fac+1,0,0,EXE('COLOR6'))

IFA
  SQL.ADD(" SELECT /*+ RULE */ M.Especie, M.Cuenta, M.FechaMov, M.Cantidad, M.NrOperacion, M.Leyenda, ")
  SQL.ADD(" T.Cambio1, T.Cantidad2, CL.RazonSocial, C.Numero, E.Nombre, 'Ejecutado' Estado, ")
  SQL.ADD(" T.Proveedor, T.Vehiculo1, CP.Descripcion, T.ConceptoPago, C.Comitente, ")
  SQL.ADD(" T.CodigoDatanet1, CD.Descripcion DescripcionCD, CD.Tipo TipoCD, T.NrOperacionRef1 ")
  SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES CL, "~DBO~".ESPECIES E, ")
  SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, "~DBO~".CNCONCEPTOSPAGOCOBRO CP, ")
  SQL.ADD(" "~DBO~".CODIGOSDATANET CD ")
  SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
  SQL.ADD(" AND   C.Comitente= CL.Codigo ")
  SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
  SQL.ADD(" AND   M.Especie  = E.Codigo ")
  *SQL.ADD(" AND   T.ConceptoPago *= CP.Codigo  ")
  *SQL.ADD(" AND   T.CodigoDatanet1 *= CD.Codigo  ")
  SQL.ADD(" AND   T.ConceptoPago = CP.Codigo  ")
  SQL.ADD(" AND   T.CodigoDatanet1 = CD.Codigo  ")
  SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
  If NoVacio(Dialogo.Lista3)
    SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  Endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  Endif
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  If Dialogo.Radio2=0
    SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
  Endif
  If Dialogo.Radio2=1
    SQL.ADD(" AND C.TipoCuenta IN ('INT')")
  Endif
  If Dialogo.Radio2=2
    SQL.ADD(" AND C.TipoCuenta IN ('REC')")
  Endif
  If Dialogo.Radio2=3
    SQL.ADD(" AND C.TipoCuenta IN ('CA')")
  Endif
  If Dialogo.Check1=0
    SQL.ADD(" AND (C.Pagadora <>'SI' OR C.Pagadora IS NULL) ")
  Endif
SQL.ADD(" ORDER BY M.FechaMov ")

ACT(cp:1, '')
ACT(ea:1, '')
ACT(ba:1, '')

dfa
Recorrer SQL
  If Not eqstr(fbn('Especie'),Val(ea:1)) 
    If Not Eqstr(Val(cp:1),'')
      ACT(a:fac, 'Total '~Val(ba:2)~' ---> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      SCN(to:1, Val(d:fac))
      ifa
      ifa
      ACT(a:fac, 'Total '~Val(cp:2)~' en '~Val(ea:2)~' ---> ')
      ACN(d:fac, Val(to:1))
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      AgregarMarco(a:fac..g:fac,0,0,EXE('COLOR8'))
      ifa
    Endif
    ifa
