    ACN(to:1, 0)
  Endif
  If Not eqstr(fbn('Comitente'),Val(ba:1))
    If Not Eqstr(Val(ba:1),'')
      ACT(a:fac, 'Total '~Val(ba:2)~' ---> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..z:fac,5)
      FormatoCeldas(d:fac, EXE('F2'))
      SCN(to:1, Val(d:fac))
    Endif
    ifa
    ifa
    ACT(a:fac, 'Banco: '~fbn('RazonSocial'))
    message('Banco: '~fbn('RazonSocial'))
    AgregarMarco(a:fac..g:fac,0,0,0)
    SetFont(a:fac,5)
    ifa
    ACN(fi:1,fac)
  Endif
  ACT(a:fac, fbn('Cuenta')~' - '~fbn('Numero'))
  ACT(b:fac, fbn('Vehiculo1'))
  ACD(c:fac, fbn('FechaMov'))
  ACN(d:fac, fbn('Cantidad'))
  ACT(e:fac, fbn('NrOperacion'))
  ACLT(e:fac, fbn('NrOperacion'))
  ACT(f:fac, fbn('Leyenda'))
  ACT(g:fac, fbn('NrOperacionRef1'))
  ACLO(g:fac, fbn('NrOperacionRef1'))

  SetFont(b:fac..i:fac,1)
  FormatoCeldas(d:fac, EXE('F2'))

  ACT(ea:1, fbn('Especie'))
  ACT(ea:2, fbn('Nombre'))
  ACT(ba:1, fbn('Comitente'))
  ACT(ba:2, fbn('RazonSocial'))
  ACT(cp:2, fbn('Descripcion'))
Proximo

