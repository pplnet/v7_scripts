CrearDialogo
  Fecha1           :  'Fecha'               ;1;;;;;NoVacio(Fecha1);'Debe ingresar una fecha';NO;FSYS
  Especie1         :  'Especie'             ;2;;;;;NoVacio(Especie1);'Debe ingresar un cliente';NO
  Vehiculo1        :  'Vehiculo'            ;3;;;;;NoVacio(Vehiculo1);'Debe ingresar un vehiculo';NO
  Especie2         :  'Moneda'              ;3;;;;;NoVacio(Especie2);'Debe ingresar una moneda';NO
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

SetFilaActual(1)
ACT(C:fac, 'Detalle de Titulos Caucionados')
SetFont(C:fac, 3)
SetFilaActual(fac+2)
ACN(FI:1, fac)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Vehiculo1)
    ACT(A:fac, 'Vehiculo : '~Dialogo.Vehiculo1) 
ELSE
    ACT(A:fac, 'Vehiculo/s : Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Especie1)
    ACT(A:fac, 'Especie: '~Dialogo.Especie1)
ELSE
    ACT(A:fac, 'Especie: Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Especie2)
    ACT(A:fac, 'Expresado en: '~Dialogo.Especie2)
ENDIF
ifa

SetFilaActual(fac+2)
ACT(A:fac, 'Nr Operacion')
ACT(B:fac, 'Fecha Op')
ACT(C:fac, 'Fecha Vto')
ACT(D:fac, 'Cantidad')
ACT(E:fac, 'Precio')
ACT(F:fac, '% Aforo')
ACT(G:fac, 'Pr.Aforado')
ACT(H:fac, 'Imp.Cobrado')
ACT(I:fac, 'Cuenta')
ACT(J:fac, 'Pr Mercado')
ACT(K:fac, 'Valuacion a la Fecha')
SetFont(A:Val(FI:1)..K:fac, 2)
AlinearCeldas(A:fac..K:fac, 'C')
AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR'))
ACN(FI:1, fac+1)
SQL.ADD(" Select O.NrOperacion,O.FechaOp,O.FechaVto,C.Cantidad1,C.Precio1, ")
SQL.ADD(" C.Precio2 PorAforo,C.Precio3 PrAforado,C.Cantidad2 ImpCobrar,C.Cuenta1 DebitoEn ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp = 'SECAT' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND C.Especie1 = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Order By C.Especie1, O.Vehiculo1 ")
watch(sql.batch)
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACD(B:fac, fbn('FechaOp'))
    ACD(C:fac, fbn('FechaVto'))
    SCN(D:fac, fbn('Cantidad1'))
    ACN(E:fac, fbn('Precio1'))
    ACN(F:fac, fbn('PorAforo'))
    ACN(G:fac, fbn('PrAforado'))
    ACN(H:fac, fbn('ImpCobrar'))
    ACT(I:fac, fbn('DebitoEn'))
    ACN(J:fac, CotizacionC(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,Dialogo.Especie2))
    ACN(K:fac, Val(D:fac) * Val(J:fac))
Proximo
SetFont(A:Val(FI:1)..K:fac, 1)
FormatoCeldas(G:Val(FI:1)..G:fac, Exe('F8'))
FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
FormatoCeldas(I:Val(FI:1)..I:fac, Exe('F8'))
AgregarMarco(A:Val(FI:1)..K:fac, 0, 0)
ifa
ACT(A:fac, 'Total')
FormatoCeldas(J:Val(FI:1)..J:fac, Exe('F8'))
ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
ACN(K:fac, Sum(K:Val(FI:1)..K:fac-1))
ACN(H:fac, Sum(H:Val(FI:1)..H:fac-1))
SetFont(A:fac, 2)
SetFont(D:fac, 2)
SetFont(K:fac, 2)
SetFont(H:fac, 2)
AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR'))
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(2, 8)
ACO(3, 8)
ACO(4, 10)
ACO(5, 10)
ACO(7, 10)
ACO(8, 10)
ACO(9, 15)
ACO(10, 10)
ACO(11, 15)