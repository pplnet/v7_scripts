IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF
CrearDialogo
  Fecha1:       'Fecha'                                 ;;;;;;;;;
  Vehiculo1:    'Vehiculo'                              ;;;;;;;;;
  Book1:        'Book'                                  ;;;;;;;;;
  Radio1:       'Expresado en|ARP|USD'                  ;;;;;;;;;
  Radio2:       'Expresado en|Millones|ImporteOri'      ;;;;;;;;;
  Precio1:      'CotDolDivisa'                          ;;;;;;;;;
  Precio2:      'CotDolBillete'                         ;;;;;;;;;
  Lista1:       'Vehiculo'                              ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

*****************************************************************VAR MONEDAS****************************************************
let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa Dialogo.Precio1
let &cotDolBillete Dialogo.Precio2
*let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha1-1,1,NO,NO)
*let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha1-1,1,NO,NO)
IF Dialogo.Radio1 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF

*****************************************************************ENCABEZADO***************************************************
SetFilaActual(1)
ACT(A:fac,'Posicion de FCI')
ifa
ACT(B:fac,'Apertura por vehiculo y books')
SetFont(A:fac-2..E:fac, 3)
ifa
ifa

let &ComienzoTitulos fac

ACT(A:fac,'Fecha: '  ~Dialogo.Fecha1)
ifa

ACT(A:fac,'Especies: ')
let &filafondo fac
ifa
IF Vacio(Dialogo.Vehiculo1)
    IF Vacio(Dialogo.Lista1)
        let &Vehiculos 'Todos'
    ELSE
        let &Vehiculos Dialogo.Lista1
    ENDIF
ELSE
    let &Vehiculos Dialogo.Vehiculo1
ENDIF
ACT(A:fac,'Vehiculo: '~ &Vehiculos)
ifa

IF Vacio(Dialogo.Book1)
    let &Books 'Todos'
ELSE
    let &Books Dialogo.Book1
ENDIF
ACT(A:fac,'Books: '~ &Books)
ifa


IF Dialogo.Radio1 = 0
    let &expresion 'ARP'
ELSE
    let &expresion 'USD'
ENDIF

ACT(A:fac,'Expresado en : '~ &expresion)
ifa
ACT(A:fac, 'TC Divisa: '~Fstr(&cotDolDivisa,0,2))x
ifa
ACT(A:fac, 'TC Billete: '~Fstr(&cotDolBillete,0,2))
ifa

IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
ifa
ifa
ACT(A:fac,'Especie')
ACT(B:fac,'Moneda')
ACT(C:fac,'Posicion')
ACT(D:fac,'Cotizacion')
ACT(E:fac,'Pos.Val.')

AgregarMarco(A:fac..E:fac, 0, 3, Exe('COLOR'))
AlinearCeldas(A:fac-1..E:fac,'C')
SetFont(A:&ComienzoTitulos..I:fac, 2)

ifa
ifa
******************************************************************SQL**************************************************************************
SQL.ADD("Select P.Especie, P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin, P.Vehiculo,P.Book,P.Fecha, E.Cotiza Moneda ")
SQL.ADD("From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD("Where E.Codigo = P.Especie ")
SQL.ADD("AND "~DBO~".DESCIENDEDEESPECIE(P.Especie,'FONDOS') = 1 ")
SQL.ADD("AND P.NrSaldo = 1 ")
SQL.ADD("AND P.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND P.Vehiculo= '"~Dialogo.Vehiculo1~"' ")
Else
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ELSE
        SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Val(LS:1))~") ")
    ENDIF
Endif
If NoVacio(Dialogo.Book1)
    SQL.ADD("AND P.Book= '"~Dialogo.Book1~"' ")
Endif   
SQL.ADD("Order By P.Vehiculo,P.Book")
 

dfa
dfa
let &comienzoDatos fac
Recorrer SQL
    IF Not Eqstr(fbn('Book'), Val(BO:1)) y NoVacio(Val(BO:1)) o [Not Eqstr(fbn('Vehiculo'), Val(VH:1)) y NoVacio(Val(VH:1))]
        ACT(A:fac,'Total Cartera: '~ Val(BO:1))
        ACN(E:fac,Val(TB:1))
        SetFont(A:fac..E:fac,2)
        AgregarMarco(A:fac..E:fac,1,0,)
        ACN(TB:1,0)
        ifa
        ifa
    Endif
    If Vacio(Dialogo.Book1)
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1)) y NoVacio(Val(VH:1))
        ACT(A:fac,'Total Vehiculo: '~ Val(VH:1))
            ACN(E:fac,Val(TV:1))
            SetFont(A:fac..E:fac,2)
            AgregarMarco(A:fac..E:fac,1,0,EXE('COLOR6'))
            ACN(TV:1,0)
            ifa
            ifa
        Endif
        If  Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac,'VEHICULO: '~FBN['Vehiculo'])
            AgregarMarco(A:fac..E:fac,1,0,EXE('COLOR6'))
            SetFont(A:fac..A:fac,2)
            ifa
        Endif
    Endif
    If  Not Eqstr(fbn('Book'), Val(BO:1)) o Not Eqstr(fbn('Vehiculo'), Val(VH:1))
        ACT(A:fac,'CARTERA: '~FBN['Book'])
        SetFont(A:fac..A:fac,2)
        ACT(BO:1,FBN['Book'])
        ifa
    ENDIF
    ACT(VH:1,FBN['Vehiculo'])
    ACT(A:fac, fbn('Especie') ~' - '~ BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
    ACT(B:fac, fbn('Moneda'))
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Not Eqstr(fbn('Especie'), &especieAnt)
        let &cotEspecie COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    *POSICION
    ACN(C:fac,fbn['CantidadFin'] )
    *COTIZACION
    ACN(D:fac,&cotEspecie)
    *POS. VALUADA
    ACN(E:fac,Val(C:fac)*Val(D:fac)* &tc)
   
    ACN(TV:1,Val(TV:1)+Val(E:fac))
    ACN(TB:1,Val(TB:1)+Val(E:fac))
    If Not Incluido(FBN['Especie'],Val(A:&FilaFondo))
        ACT(A:&FilaFondo,Val(A:&FilaFondo)~FBN['Especie']~'|') 
    Endif
Proximo 
ifa
If NoVacio(Val(A:&comienzoDatos+1))
    ACT(A:fac,'Total Cartera: '~ Val(BO:1))
    ACN(E:fac,Val(TB:1))
    SetFont(A:fac..E:fac,2)
    AgregarMarco(A:fac..E:fac,1,0,)
    ifa
    If Vacio(Dialogo.Book1)
        ifa
        ACT(A:fac,'Total Vehiculo'~ Val(VH:1))
        ACN(E:fac,Val(TV:1))
        SetFont(A:fac..E:fac,2)
        AgregarMarco(A:fac..E:fac,1,0,EXE('COLOR6'))
    Endif
Else
    Cancelar('No se encontraron posiciones para los datos seleccionados')
Endif
let &ultimoRegistro fac
FormatoCeldas(C:&comienzoDatos..E:&ultimoregistro,EXE('F2'))
FormatoCeldas(D:&comienzoDatos..D:&ultimoregistro,EXE('F8'))
AgregarMarco(A:&comienzoDatos..E:&ultimoRegistro,1,2,)
ACO(1,20)
ACO(2,12)
ACO(3,10)
ACO(4,12)

SetFilaActual(&ultimoRegistro)
ifa
ifa
ACT(A:fac,'Fin del Reporte')
SetFont(A:fac..A:fac,2)
ifa
LimitesVision(F:fac)
