CrearDialogo
 NrTrans1:'Operacion' ;;;;;;NOVACIO(Dialogo.NrTrans1);;NO;;;;;;"TipoTr2 = 'STOCK' "
FinDialogo

if Not Ok
 Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')
CrearFont(5, "Arial,5,")

ACO(1,32)
ACO(2,13)
ACO(3,13)
ACO(4,15)

ACN(BD:1,0)

SQL.ADD(" Select C.Codigo, C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CondicionIVA, C.CUIT, P.Nombre Pais,")
SQL.ADD("T.Fecha1, T.TipoTr2, T.NrTrans, T.Especie, E.Nombre NomEsp, T.Cantidad1, T.Cantidad2, T.Precio1, T.RB8,T.Cantidad10,")
SQL.ADD("T.Cantidad3, T.Cantidad11, T.Cantidad12, T.Cantidad13, T.Cantidad14, T.Cantidad15, T.Especie4, T.Vehiculo1 ")
SQL.ADD(" from  "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".PAISES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where C.Codigo   = T.Cliente1 ")
SQL.ADD("  and  T.NrTrans  = '"~Dialogo.NrTrans1~"' ")
*SQL.ADD("  and  C.PaisDir  = P.Codigo ")
SQL.ADD("  and  C.Pais  = P.Codigo ")
SQL.ADD("  and  T.Especie  = E.Codigo ")

recorrer SQL
 ACN(BD:1,1)
 IF Eqstr(fbn('Especie4'), Var('MONELOCA'))
     ACT(MA:1, '$')
 ELSE
     ACT(MA:1, 'U$S')
 ENDIF

 * ORIGINAL -------------------------------------------------------------------------------- *


 
IF Not Eqstr(fbn('RB8'), '0') Y NoVacio(fbn('RB8'))
    ACT(D:1, 'REIMP. ORIGINAL')
ELSE
    ACT(D:1, 'ORIGINAL')
ENDIF

SetFont(d:1, 2)
AlinearCeldas(d:1, 'C')

ACT(f:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
ACT(f:2, 'C.U.I.T. Nº '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Vehiculo1')))    

if BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')) > 0
    ACT(f:4, 'Cuenta en Caja de Valores Nº '~BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')))
endif

SetFont(f:1..f:4,2)
  

SetFilaActual(3)

ACT(A:fac, "Emision de voucher Stock Split")
ACT(A:fac+1, "Fecha: " ~Fecha(FSYS))
ACT(a:fac+4,"Voucher Nro.: " ~ fbn('NrTrans'))
ACT(f:fac+4,"Comprobante de Stock del: "~fbn('Fecha1'))
SetFont(a:fac..f:fac+4,2)

SetFilaActual(fac+6)
ACT(D:fac, 'Comprobante de Stock Split')
SetFont(a:fac..g:fac, 4)
AlinearCeldas(a:fac..g:fac, 'C')
AgregarMarco(a:fac..g:fac, 2,0)


IFA 
ACT(a:fac,'Sres.: '~fbn('RazonSocial'))
ACT(a:fac+1,"Direccion: " ~fbn('Direccion'))
ACT(a:fac+2,"Cliente: "~fbn('Codigo'))
ACT(a:fac+3,'('~fbn('CodigoPostal')~') '~fbn('Localidad')~' - '~fbn('Pais'))
ACT(a:fac+4,BuscarCampo('TIPOSIMPUESTO','Descripcion','Codigo',fbn('CondicionIVA')))
ACT(a:fac+5,'CUIT: '~fbn('CUIT'))
SetFont(a:fac..a:fac+5, 2)

***********************************
*TABLA DE VALORES
***********************************

SetFilaActual(fac+7) 


*Titulos:

ACT(a:fac,'Fecha Op.')
ACT(b:fac,'Nr.Op.')
ACT(c:fac,'T.Op.')
ACT(d:fac,'Descripcion')
ACT(e:fac,'Importes')
ACT(f:fac,'Stock anterior')
ACT(g:fac,'Stock nuevo')

SetFont(a:fac..g:fac,2)
AgregarMarco(a:fac..g:fac, 2,0,Exe('COLOR')) 

*Valores:
ifa
ACT(a:fac,fbn('Fecha1'))
ACT(b:fac,fbn('NrTrans'))
ACLT(b:FAC, fbn['NrTrans'])
ACT(c:fac,fbn('TipoTr2'))
ACT(d:fac, Mayusculas2(fbn('NomEsp')))
ACN(f:fac,fbn('Cantidad1'))
ACT(d:fac+1,Mayusculas2(fbn('NomEsp')))
ACN(g:fac+1,fbn('Cantidad3'))
SetFont(a:fac..g:fac+1, 2) 

***********************************
*Puesta de valores Cant10 a Cant15
***********************************

SETfILAACTUAL(FAC + 2)
ACN(ZZ:1,0)

IF fbn('Cantidad10') > 0
 ifa
 ACT(D:fac, 'Comision')
 ACN(e:fac, fbn('Cantidad10'))
 
 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad10'))
 
 FormatoCeldas(d:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF
IF fbn('Cantidad11') > 0
 ifa
 ACT(D:fac, 'IVA')
 ACN(E:fac, fbn('Cantidad11'))
 ALINEARCELDAS(E:FAC,"D")

 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad11'))
 
 FormatoCeldas(E:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF
IF fbn('Cantidad12') > 0
 ifa
 ACT(D:fac, 'Com. CV CP')
 ACN(E:fac, fbn('Cantidad12'))
 ALINEARCELDAS(E:FAC,"D")

 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad12'))
 
 FormatoCeldas(E:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF

IF fbn('Cantidad13') > 0
 ifa
 ACT(D:fac, 'IVA s/Com.CV CP')
 ACN(E:fac, fbn('Cantidad13'))
 ALINEARCELDAS(E:FAC,"D")

 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad13'))
 
 FormatoCeldas(E:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF

IF fbn('Cantidad14') > 0
 ifa
 ACT(D:fac, 'Com. CV 3ros')
 ACN(E:fac, fbn('Cantidad14'))
 ALINEARCELDAS(E:FAC,"D")

 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad14'))
 
 FormatoCeldas(E:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF
IF fbn('Cantidad15') > 0
 ifa
 ACT(D:fac, 'IVA s/Com.CV 3ros')
 ACN(E:fac, fbn('Cantidad15'))
 ALINEARCELDAS(E:FAC,"D")

 *Sumamos a la celda zz:1 el valor de cada campo
 SCN(ZZ:1, fbn('Cantidad15'))
 
 FormatoCeldas(E:fac,Exe('F2'))
 SetFont(D:fac..E:fac, 2)
ENDIF

IF(VAL(ZZ:1) > 0)
   IFA
   ACT(D:FAC,"Total Gastos e Impuestos")
   ACN(E:FAC,Val(ZZ:1))
   FormatoCeldas(E:fac,Exe('F2'))
   ALINEARCELDAS(E:FAC,"D")
   SetFont(D:fac..E:fac, 2)
   SetFilaActual(fac+4)
   ELSE
   SetFilaActual(fac+2)
ENDIF



*************************************
*CUADRO RESUMEN (CON FONDO AMARILLO)
*************************************

*Saldo anterior
ACT(d:fac,Mayusculas2(fbn('NomEsp')))
ACN(f:fac,(-1)*fbn('Cantidad1'))
SetFont(d:fac..g:fac,3)
FormatoCeldas(f:fac,Exe('F2'))

*Saldo nuevo
ACT(d:fac+1,Mayusculas2(fbn('NomEsp')))
ACN(g:fac+1,fbn('Cantidad3'))
SetFont(d:fac+1..g:fac+1,3)
FormatoCeldas(g:fac+1,Exe('F2'))

AgregarMarco(c:fac-1..g:fac+2, 2,0,Exe('COLOR')) 

*************************************
*CUADRO DESCRIPTIVO FINAL
*************************************
 
SetFilaActual(fac+4)

ACT(a:fac, 'Descripcion')
ACT(a:fac+1,'Incremento del '~FStr(fbn('Precio1'),0,2)~'% en el Valor Nominal de las acciones de '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie'))~' por cambios en su cotización.')
ACT(a:fac+2,'Total: '~FStr(fbn('Cantidad2'),0,2)~' acciones.')
SetFont(a:fac..a:fac+2,3)
SetFont(a:fac+1..a:fac+2,2)
AgregarMarco(a:fac..g:fac+2,2,0)

*************************************
*CUADRO OBSERVACIONES
*************************************
SetFilaActual(fac+4)
ACT(a:fac, 'Observaciones / Confirmacion')
SetFont(a:fac,3)
AgregarMarco(a:fac..g:fac+2,2,0)

*Se aumenta la fila para aumentar el límite visión
SetFilaActual(fac+4)

proximo

