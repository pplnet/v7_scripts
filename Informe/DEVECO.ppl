* DEVECO - Informe de Devengados - Commodities
CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;FinDeMes(PriDeMes(Fsys,SI,'ARG')-1,NO,'ARG')
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1 : 'Especie '    ;;;;;;NOVACIO(Dialogo.Especie1);'Especie Inexistente';NO;'WTI';;
  Check1   : "Graba"       ;;;;;;;;;0
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, ' Informe de Devengados - Commodities')
ACT(a2, 'Fecha : '~Dialogo.Fecha1)

if NoVacio(Dialogo.Lista1)
  ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:4, 'Vehiculo : Todos')
endif

ACT(a5, 'Operacion')
ACT(b5, 'TipoOp')
ACT(c5, 'ContraParte')
ACT(d5, 'Bbls/Dia')
ACT(e5, '  Devengamiento')
ACT(g5, 'Swap Rate')
ACT(h5, 'Devengado Acum.')
ACT(i5, 'Prima Devengada')
ACT(j5, 'Precio Real')
ACT(k5, 'Tipo')
ACT(e6, 'Desde')
ACT(f6, 'Hasta')
ACT(g6, 'o Strike')
ACT(h6, 'Compensaciones')
ACT(i6, 'Por Opcines')
ACT(j6, 'Calculado')


ACO(1,9)
ACO(2,20)
ACO(3,10)
ACO(4,10)
ACO(7,12)
ACO(8,12)
ACO(9,12)
ACO(10,7)
ACO(11,15)

SetFont(a1..z7, 1)

AgregarMarco(a5..k6, 2,0,Exe('COLOR'))
AgregarMarco(e5..f5, 2,0,Exe('COLOR'))
AgregarMarco(e6..f6, 2,3,Exe('COLOR'))
AgregarMarco(a5..d6, 2,2,Exe('COLOR'))
AgregarMarco(g5..k6, 2,2,Exe('COLOR'))

SetFilaActual(7)

SQL.ADD("Select O.*, ")
SQL.ADD("C.Fecha1, C.Fecha2,C.Plazo1, C.Cantidad1,C.Cantidad2,C.Precio1 Pr1,C.Precio2 Pr2,C.Precio3 Pr3,C.Precio4 Pr4,C.Total1,C.NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and O.FechaOp2<= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
   *SQL.ADD("and O.NrOperacion = 'BO000038' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and (O.TipoOp in ('DPDSO','DPBOD','DPOA','DPOD','DPRC','DPRRS','DPRS','DPS','DPBOA','DPC','DPF','DPOGA','DPOGD','DPSV') ")
SQL.ADD(" or (O.TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL)) or O.TipoOp in ('DPDSS')) ")
SQL.ADD("Union ")
SQL.ADD("Select O.*, ")
SQL.ADD(" '' Fecha1, '' Fecha2, 0 Plazo1, 0 Cantidad1,0 Cantidad2,0 Pr1,0 Pr2 ,0 Pr3,0 Pr4,0 Total1,1 NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES O")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TipoOp In ('DPFW','DPOS','DPBOS','DPOGS') and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
   *SQL.ADD("and O.NrOperacion = 'BO000038' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("order by O.Vehiculo1, O.TipoOp,O.NrOperacion ")

BorrarCeldas(t1..t2)

Recorrer SQL

  if Not Eqstr(fbn('Vehiculo1'),Val(t1)) 
     if NoVacio(Val(t1))
        act(a:fac,'Total Tipo Operacion '~Val(t2) )
        acn(h:fac, Val(w11))
        acn(i:fac, Val(w12))

        BorrarCeldas(w11..w12)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,1)
        ifa

        act(a:fac,'Total Empresa '~Val(t1) )

        acn(h:fac, Val(w1))
        acn(i:fac, Val(w2))

        BorrarCeldas(w1..w2)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,1)
        ifa
     endif

     act(t1, fbn('Vehiculo1'))

     act(a:fac,'Empresa '~Val(t1) )
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..f:fac,1)
     ifa

     * Asignar Tipo Operacion
     act(t2, fbn('TipoOp'))

     act(a:fac,'Tipo Operacion '~Val(t2) )
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,1)
     ifa
  Else 
     If Not Eqstr(fbn('TipoOp'),Val(t2))
        * Cambia El Tipo de Producto
        if NoVacio(Val(t2))
           act(a:fac,'Total Tipo Operacion '~Val(t2) )
           acn(h:fac, Val(w11))
           acn(i:fac, Val(w12))

           BorrarCeldas(w11..w12)
           AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
           SetFont(a:fac..k:fac,1)
           ifa
        endif

        * Asignar Tipo Operacion
        act(t2, fbn('TipoOp'))
        act(a:fac,'Tipo Operacion '~Val(t2) )
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,1)
        ifa
     EndIf
  endif

  IF EqStr(fbn('NrOperacion'),val(a:fac-1))
     *- Listo solo la 1er. cuota por nro. operacion
     dfa
  Else 
     Message(fbn('TipoOp')~' '~fbn('NrOperacion'))

     ACT (a:fac, fbn('NrOperacion'))
     ACLO(a:fac, fbn('NrOperacion'))

     *- Caracteristicas de la Operacion.
     * determinar el signo
     if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
        if EqStr(fbn('MB1'),'1')
           act(k:fac,'Producer')
        else
           act(k:fac,'Consumer')
        endif
     endif

     if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
        if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
           act(k:fac,'Compra PUT')
        endif
        if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
           act(k:fac,'Venta CALL')
        endif
        if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
           act(k:fac,'Venta PUT')
        endif
        if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
           act(k:fac,'Compra CALL')
        endif
     endif
     if EqStr(fbn('TipoOp'),'DPSN')
        if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
           act(k:fac,'Compra Producer')
        endif
        if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
           act(k:fac,'Venta Consumer')
        endif
        if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
           act(k:fac,'Compra Consumer')
        endif
        if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
           act(k:fac,'Venta Producer')
        endif
     endif

     If EqStr(fbn('TipoOp'),'DPFW')
        if EqStr(fbn('MB3'),'1') 
           act(k:fac,'Venta')
        endif
        if EqStr(fbn('MB3'),'0') 
           act(k:fac,'Compra')
        endif
     Endif

     If Incluido(fbn('TipoOp'),'DPRC|DPRRS|DPRS')    
        If Incluido(FBN['RB9'],'0')
           act(k:fac,val(k:fac)~' Diaria ')
        Else
           act(k:fac,val(k:fac)~' Mensual ') 
        EndIf
     EndIf

     *-----
     ACT(b:fac, fbn('TipoOp')~' '~BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
     ACT(c:fac, fbn('Cliente1'))

     *- Fechas
     If Incluido(fbn('TipoOp'),'DPOS|DPOGS|DPBOS|DPFW')
        * ACD(e:fac,FBN['FechaEj'])    
        ACD(e:fac,Dialogo.Fecha1)    
     Else
        ACD(e:fac,FBN['FechaOp2'])    
  
        IF FBN['NrCuota']>1
           ACD(e:fac,SQL("Select Fecha1 from "~DBO~".CUOTAS C where C.NrOperacion='"~FBN['NrOperacion']~"' and NrCuota="~Fstr(FBN['NrCuota']-1,0,0)~" ")+1)    
        EndIf
     EndIf
     ACD(f:fac,Dialogo.Fecha1)    

     *- Volumen Diario      
     ACN(d:fac, FBN['Cantidad'])

     If Incluido(fbn('TipoOp'),'DPOS|DPOGS|DPBOS|DPFW')
        ACN(h:fac,val(d:fac))
     Else 
        If Incluido(fbn('TipoOp'),'DPBOD|DPOD|DPRC|DPOGD|DPRRS|DPRS') o [Incluido(fbn('TipoOp'),'DPC|DPF') y EqStr(FBN['MB2'],'1')]           
           *- Volumen Teorico Diario
           ACN(d:fac, FBN['Cantidad1'])
           ACN(h:fac,val(d:fac))
        Else 
           If Incluido(FBN['UMedida'],'BBLSD|BARRIL')
              ACN(h:fac,val(d:fac)*(val(f:fac)-val(e:fac)+1) )
           Else
              *- Sumo 1 a los meses porque la fecha desde es 1ero. de mes  y no fin de mes
              ACN(h:fac,val(d:fac)*DIFM(val(f:fac),val(e:fac)-1))
           EndIf 
        EndIf 
     EndIf

     If Incluido(fbn('TipoOp'),'DPSN')
        ACN(h:fac,0)
     EndIf

     *- Resultados 
     If Incluido(fbn('TipoOp'),'DPBOS|DPFW|DPOS|DPOGS')    
        ACN(re1,FBN['Precio4'])
     Else 
        *- Multiples Vto
        ACN(re1,FBN['Total1'])
     EndIf

     *- Swap Rate o Strike 
     If Incluido(fbn('TipoOp'),'DPRS|DPRRS')    
        ACN(g:fac,FBN['TipoCambio2'])
     Else 
        ACN(g:fac,FBN['PrecioEj'])
     EndIf


     *- Precio Real Calculado
     acd(aa1, val(e:fac))
     acd(aa2, val(f:fac))
     act(aa4, Dialogo.Especie1)

     (.'DCCURVA'.)

     Message('Precio de la Curva '~FBN('NrOperacion')~' '~Fstr(val(ab1),0,3) )

     ACN(j:fac,Round(val(ab1),3))

     *- Fc. de Calculo de Resultados-> h:fac
     *- Calculo del Devengado Acumulado Compensaciones
     If Incluido(fbn('TipoOp'),'DPBOA|DPBOS')    
        If val(re1)=0
           acn(ab1,0)

           *- ab1 Resultado de Barrier Option Asiatica 
           (.'DEVEBOA'.)

           *--- Calculo el Resultado TOTAL
           ACN(h:fac,val(ab1)*val(h:fac))
        Else            
           ACN(h:fac,val(re1))
        EndIf
     EndIf

     If Incluido(fbn('TipoOp'),'DPBOD|DPOD')    
        If val(re1)=0
           acn(ab1,0)
           acn(ab2,0)

           *- Precio Promedio y Cant. Dias Promedio de Barrier Option Diaria
           (.'DEVEODIA'.)
  
           *- Calculo del Resultado
           (.'DEVEBOA'.)
 
           If Not Incluido(FBN['UMedida'],'BBLSD|BARRIL')
              acn(ab2,DIFM(val(f:fac),val(e:fac)-1))
           EndIf
       
           *--- Calculo el Resultado TOTAL, ab2: Promedio de Dias que se Ejercio
           ACN(h:fac,val(ab1)*val(h:fac)*val(ab2))
        Else
           ACN(h:fac,val(re1))
        EndIf
     EndIf

     If Incluido(fbn('TipoOp'),'DPDSO')    
        If val(re1)=0    
           acn(ab1,0)
           ACN(ab2,0)
           IF Num(FBN['MB1'])=0 
              ACN(ab1,(val(j:fac)-FBN['PrecioEj']))
              ACN(ab2,1)
              IF val(j:fac)<FBN['PrecioEj']
                 ACN(ab2,2)
              ENDIF 
           ELSE 
              ACN(ab1,(FBN['PrecioEj']-val(j:fac)))
              ACN(ab2,1)
              IF val(j:fac)>FBN['PrecioEj']
                 ACN(ab2,2)
              ENDIF 
           ENDIF 

           * La Ejerce
           ACN(h:fac,VAL(ab1)*val(h:fac)*VAL(ab2))
        Else
           ACN(h:fac,val(re1))
        EndIf      
     EndIf

     If Incluido(fbn('TipoOp'),'DPDSS')    
        If val(re1)=0  
           acn(ab1,0)
    
           *- Si la Ejerce duplica el volumen
           IF Num(FBN['MB1'])=0 
              ACN(ab1,(val(j:fac)-FBN['PrecioEj']))
           ELSE 
              ACN(ab1,(FBN['PrecioEj']-val(j:fac)))
           ENDIF 
           * La Ejerce
           ACN(h:fac,VAL(ab1)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf      
     EndIf

     If Incluido(fbn('TipoOp'),'DPFW')    
        If val(re1)=0  
           acn(ab1,0)
           IF Num(FBN['MB3'])=0 
              ACN(ab1,val(j:fac)-FBN['PrecioEj'])
           ELSE 
              ACN(ab1,FBN['PrecioEj']-val(j:fac))
           ENDIF 
           * La Ejerce
           ACN(h:fac,VAL(ab1)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf      
     EndIf

     If Incluido(fbn('TipoOp'),'DPOA|DPOAV|DPOS')    
        If val(re1)=0  
           acn(ab1,0)
           IF [Num(FBN['MB1'])=0 y val(j:fac)>=val(g:fac)] o [Num(FBN['MB1'])=1 y val(j:fac)<=val(g:fac)]
              *-- Calculo el Resultado por Unidad    
              IF Num(FBN['MB1'])=0 
                 *---- Call: (Floating Price-PrecioEjercicio)
                 ACN(ab1,(val(j:fac)-val(g:fac)))
              ELSE 
                 *---- Put: (Floating Price-PrecioEjercicio)
                 ACN(ab1,(val(g:fac)-val(j:fac)))
              ENDIF
       
              IF Num(FBN['MB3'])=1
                 * Si es Venta Multiplico por -1
                 ACN(ab1,-VAL(ab1))
              ENDIF
           EndIf
           *** Calculo el Resultado TOTAL
           ACN(h:fac,VAL(ab1)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf      
     EndIf

     If Incluido(fbn('TipoOp'),'DPOGA|DPOGS')    
        If val(re1)=0  
           acn(ab1,0)
           IF [Num(FBN['MB1'])=0 y val(j:fac)>=val(g:fac)] o [Num(FBN['MB1'])=1 y val(j:fac)<=val(g:fac)]
              *-- Resultado por Unidad= Pay Off
              ACN(ab1,FBN['PrecioMer'])
              IF Num(FBN['MB3'])=1
                 * Si es Venta Multiplico por -1
                 ACN(ab1,-VAL(ab1))
              ENDIF
           EndIf
           *** Calculo el Resultado TOTAL
           ACN(h:fac,VAL(ab1)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf             
     EndIf

     If Incluido(fbn('TipoOp'),'DPOGD|')    
        If val(re1)=0  
           acn(ab1,0)
           acn(ab2,0)
  
           *- Precio Promedio y Cant. Dias Promedio, j:fac=PrecioPromedio ab2: Dias Ejercio
           (.'DEVEODIA'.)

           IF [Num(FBN['MB1'])=0 y val(j:fac)>=val(g:fac)] o [Num(FBN['MB1'])=1 y val(j:fac)<=val(g:fac)]
              *-- Resultado por Unidad= Pay Off
              ACN(ab1,FBN['PrecioMer'])
 
              IF Num(FBN['MB3'])=1
                 * Si es Venta Multiplico por -1
                 ACN(ab1,-VAL(ab1))
              ENDIF
      
              If Not Incluido(FBN['UMedida'],'BBLSD|BARRIL')
                 acn(ab2,DIFM(val(f:fac),val(e:fac)-1))
              EndIf
           EndIf
           *** Calculo el Resultado TOTAL
           ACN(h:fac,VAL(ab1)*val(h:fac)*val(ab2))
        Else
           ACN(h:fac,val(re1))
        EndIf        
     EndIf

     *- Variables usadas en las funciones
     act(z8,FBN['MB1'])
     acn(z9,FBN['PrecioEj'])
     act(z10,FBN['MB3'])
     acn(z11,FBN['PrecioMer'])
     acn(z12,FBN['TipoCambio2'])
     acn(z13,FBN['TipoCambio3'])
     act(z14,FBN['MB4'])
     act(z15,FBN['CB8'])
     act(z16,FBN['UMedida'])
     act(aa3,FBN['PrecioRef'])

     If Incluido(fbn('TipoOp'),'DPRC|')    
        *- Claudia 14.09.1999 - Falta chequeo del Usuario y desarrollar la fc. de valuacion mensual
        If val(re1)=0  
           acn(z2,0)
           (.'DCRECOLLAR'.)

           *** Calculo el Resultado TOTAL
           ACN(h:fac,VAL(z2)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf       
     EndIf

     If Incluido(fbn('TipoOp'),'DPRRS')
        If val(re1)=0  
      
           Message('Volumen Diario '~Fstr(val(d:fac),0,2))

           acn(z2,0)

           If Incluido(FBN['RB9'],'0')
              *- Valuacion Diaria 
              (.'DCRERESETR'.)

              *** Calculo el Resultado TOTAL
              ACN(h:fac,VAL(z2)*val(h:fac))
           Else 
              *- Valuacion Mensual
              (.'DCRRSMENSU'.)
           EndIf
        Else
           ACN(h:fac,val(re1))
        EndIf       
     EndIf

     If Incluido(fbn('TipoOp'),'DPRS')   

        If val(re1)=0  
           If Incluido(FBN['RB9'],'0')
              *- Valuacion Diaria 

              acn(ab1,0)
              acn(ab2,0)
              acn(z3,0)
              *- 
              (.'DEVERANGES'.)       
      
              ACN(j:fac,val(ab1)) 
       
              IF [val(j:fac)>=val(g:fac) y Num(FBN['MB1'])=1] o [val(j:fac)<=val(g:fac) y Num(FBN['MB1'])=0]
    
                 *-- Calculo el Resultado por Unidad    
                 IF Num(FBN['MB1'])=0 
                    ACN(Z3,(val(j:fac)-FBN['TipoCambio2']))
                 ELSE 
                    ACN(Z3,(FBN['TipoCambio2']-val(j:fac)))
                 ENDIF
              EndIf
              *** Calculo el Resultado TOTAL
              ACN(h:fac,VAL(Z3)*val(h:fac)*val(ab2))
           Else 
              *- Valuacion Mensual
              (.'DCRSMENSUA'.)
           EndIf

        Else
           ACN(h:fac,val(re1))
        EndIf          
     EndIf

     If Incluido(fbn('TipoOp'),'DPS|DPSV')   
        If val(re1)=0  
           acn(z3,0)

           *-- Calculo el Resultado por Unidad    
           IF Num(FBN['MB1'])=1 
              ACN(Z3,(val(g:fac)-val(j:fac)))
           ELSE 
              ACN(Z3,(val(j:fac)-val(g:fac)))
           ENDIF
           *** Calculo el Resultado TOTAL
           ACN(h:fac,VAL(Z3)*val(h:fac))
        Else
           ACN(h:fac,val(re1))
        EndIf       
     EndIf

     *- Calculo de Prima devengada
     If Not Incluido(fbn('TipoOp'),'DPOS|DPOGS|DPBOS|DPFW')
        If Incluido(FBN['UMedida'],'BBLSD|BARRIL')
           ACN(i:fac,FBN['TotalNetoCli1']*(val(f:fac)-FBN['FechaOp2']+1)/FBN['Plazo'] )
        Else
           *- Sumo 1 a los meses porque la fecha desde es 1ero. de mes  y no fin de mes
           ACN(i:fac,FBN['TotalNetoCli1']*DIFM(val(f:fac),FBN['FechaOp2']-1)/FBN['Plazo'] )
        EndIf 
     Else 
        If Dialogo.Fecha1=FBN['FechaVto']   
           *- Fecha de Liquidacion de Prima para Opciones Simples
           ACN(i:fac,FBN['TotalNetoCli1'])
        Else 
           ACN(i:fac,0)
        EndIf
     EndIf

     IF EqStr(FBN['MB3'],'0')
        ACN(i:fac,-val(i:fac))
     EndIf

     scn(w1,Val(h:fac))
     scn(w2,Val(i:fac))

     scn(w11, Val(h:fac))
     scn(w12, Val(i:fac))

     SetFont(a:fac..k:fac,2)
  EndIf

proximo

ifa

if NoVacio(Val(t1))
   act(a:fac,'Total Tipo Operacion '~Val(t2) )
   acn(h:fac, Val(w11))
   acn(i:fac, Val(w12))

   BorrarCeldas(w11..w12)
   AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..k:fac,1)
   ifa
   act(a:fac,'Total Empresa '~Val(t1) )

   acn(h:fac, Val(w1))
   acn(i:fac, Val(w2))

   BorrarCeldas(w1..w2)
   AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..k:fac,1)
   ifa
endif

FormatoCeldas(h7..k:fac, Exe('F2N'))
FormatoCeldas(j7..j:fac, Exe('F4'))
LimitesVision(k:fac+1)

if Dialogo.Check1=1 
   If Vacio(Dialogo.Lista1)
      GrabarPMG('DEVECO', 'TODOS/'~Dialogo.Fecha1~'/'~Dialogo.Especie1)
   Else 
      GrabarPMG('DEVECO', Dialogo.Lista1~'/'~Dialogo.Fecha1~'/'~Dialogo.Especie1)
   EndIf
endif


Impresion(1,2)
