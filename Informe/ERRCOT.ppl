HojaVisible(SI)
CrearDialogo 
   String1: 'TXT';;;;;;;
   Radio1 : 'Evento |ACTCOT|ACTBNA|ACTTAS';;;;;;
FinDialogo

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AbrirAscii(Dialogo.String1,0)

SetFilaActual(1)
act(AA:2, LeerAscii)
act(FE:1,Copy(Val(AA:2),1,10))
If Dialogo.Radio1=0 
   ACT(A:Fac,'Reporte de Errores de Cotizaciones de Mercado')
Else
   If Dialogo.Radio1=1
      ACT(A:Fac,'Reporte de Errores de Cotizaciones BNA desde Bloomberg')
   Else
      ACT(A:Fac,'Reporte de Errores de Tasas desde Bloomberg')
   EndIf
EndIf

ACT(A:Fac+1, 'Fecha: '~Val(FE:1))
ACT(A:Fac+3,'Errores')
AgregarMarco(a:Fac+3..D:Fac+3,2,0,Exe('COLOR'))

SetFont(A:Fac,3)
SetFont(A:Fac+1..A:Fac+3,2)

SetFilaActual(Fac+3)
ACN(zz:1,Fac)
IFA
Recorrer&I 1,1000000000
   act(a:Fac, LeerAscii)
   If Not Ok 
      Break
   Endif   
   IFA
Proximo

SetFont(A:Val(zz:1)+1..A:Fac,1)
SetFilaActual(Fac+1)
ACT(A:Fac,'Fin del Listado')
SetFont(A:Fac,2)
ACO(1,30)
LimitesVision(F:Fac+2)