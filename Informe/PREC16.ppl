ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  Cliente1   : "Entidad"      ;;;
  Especie1   : "Especie"      ;;;
  TipoOp1    : "Tipo Op."     ;;;
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Operaciones Precancelables de Money Markets")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+4, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+4, 'Entidad : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+5, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+5, 'Especie : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+6, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+6, 'Tipo Op. : Todos')
endif
SetFont(a:fac..N:FAC+7,2)

SetFilaActual(FAC+9)
ACT(a:FAC, 'Numero Op.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'F.Concert.')
ACT(d:FAC, 'F.Vto.')
ACT(e:FAC, 'Vehiculo')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Capital')
ACT(h:FAC, 'Plazo')
ACT(i:FAC, 'Tasa')
ACT(j:FAC, 'Monto')
ACT(k:FAC, 'Entidad')

SetFont(a:fac..m:FAC,2)
AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)
  
SQL.ADD("Select O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.TipoOp Like 'MM%' and (O.RB10 = '0' or TipoOp In ('MMCDIA','MMCDP') ) ")
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif
SQL.ADD("order by O.TipoOp, O.NrOperacion ")

Recorrer SQL
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp'])
  ACD(c:FAC, FBN['FechaOp'])
  ACD(d:FAC, iif(NoVacio(fbn['FechaVto']),FBN['FechaVto'],FBN['FechaVto2']))
  ACT(e:FAC, FBN['Vehiculo1'])
  ACT(f:FAC, FBN['Especie'])
  ACN(g:FAC, FBN['Cantidad'])
  ACN(h:FAC, FBN['Plazo'])
  ACN(i:FAC, FBN['Precio1'])
  ACN(j:FAC, FBN['TotalNetoCli1'])

  If val(j:fac)=0
     ACN(j:FAC, FBN['TotalBrutoCli1'])
  EndIf

  ACT(k:FAC, FBN['Cliente1'])

  If EqStr(FBN['TipoOp'],'MMCDP') y FBN['Plazo2']>0
     *- Se Precancelo
     ACD(d:FAC, FBN['FechaVto2'])
     ACN(i:FAC, FBN['Precio2'])
     ACN(j:FAC, FBN['TotalAux3'])
  EndIf

  SetFont(a:FAC..m:FAC,1)
  FormatoCeldas(h:fac..h:fac,"0")
  FormatoCeldas(g:fac..g:fac,Exe('F2'))
  FormatoCeldas(j:fac..j:fac,Exe('F2'))
proximo

ACO(1,8)
ACO(2,8)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,8)
ACO(7,8)
ACO(8,11)
ACO(9,11)
ACO(10,7)
ACO(11,11)
ACO(12,11)
ACO(13,8)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
*RangoTitulo(a1..k:8,36)
RangoTitulo(a1..k:FAC,14)
