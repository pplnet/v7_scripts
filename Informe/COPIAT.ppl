** COPIAT ** Boletos del MAE

Hojavisible(SI)
*ModoReproceso(ConDialogo)
CrearDialogo
#ifdef MLASA
   Fecha1     :'Fecha '                 ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSYS
   Radio1     :'|Provisorio|Definitivo' ;;;;NO;NO;;;;;0
   Fecha2     :'Hasta Fecha'            ;;;;NO;NO;;;;Dialogo.Fecha1;Dialogo.Fecha1
   Check1     :'MAE/BYMA'               ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMB'),'SI'),1,0);
   Check2     :'ROFEX/NDF'                  ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATROF'),'SI'),1,0);
   Check3     :'MAV'                    ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMAV'),'SI'),1,0);
   Vehiculo1  : 'Vehiculo'              ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Radio2     :'|Manual|Evento'         ;;;;NO;NO;;;;;0
   Especie1   :'Moneda Totales'         ;;;;NO;NO;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";   
#else
   Fecha1     :'Fecha'                  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCOP' "),1,'ARG',SI)
   Radio1     :'|Provisorio|Definitivo' ;;;;  ;  ;;;;;0
   Fecha2     :'Hasta Fecha'            ;;;;NO;NO;;;;Dialogo.Fecha1;Dialogo.Fecha1
   Check1     :'MAE/BYMA'               ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMB'),'SI'),1,0);
   Check2     :'ROFEX/NDF'              ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATROF'),'SI'),1,0);
   Check3     :'MAV'                    ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMAV'),'SI'),1,0);
   Vehiculo1  : 'Vehiculo'              ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')   
   Radio2     :'|Manual|Evento'         ;;;;NO;NO;;;;;0
   Especie1   :'Moneda Totales'         ;;;;NO;NO;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";   
#endif


FinDialogo

If not Ok
   Cancelar
endif

#ifdef MLASA
#else
ACN(ab:1, SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'NCOP' "))
if Val(ab:1)>0
   if Dialogo.Radio1=0
      MessageBox('El Copiativo del '~Dialogo.Fecha1~' ya fue emitido.')
   else
      Cancelar('El Copiativo del '~Dialogo.Fecha1~' ya fue emitido. Debe utlizar la reimpresion.')
   endif
endif

if Dialogo.Radio1=1
  ACD(t:1,Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCOP' "),1,'ARG',SI))
  if Val(t:1) > Fecha('2000/01/01')
     if Val(t:1) >  Fecha(Habiles(FSys,-1,'ARG',SI))
        Cancelar('COPIAT - No hay fechas disponibles para impresión.')
     endif
     if Val(t:1) <> Dialogo.Fecha1
        Cancelar('COPIAT - No se permite saltar fechas habiles.')
     endif
  endif
endif
#endif
ACN(aw5,0)

(.'AUXCOPIAT'.)
