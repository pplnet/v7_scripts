ModoReproceso(SINDIALOGO)
CrearDialogo
  Cliente1 : 'Cliente'       ;1;1;;;;;;
  Fecha1   : 'Fecha'         ; ; ;;;;Dialogo.Fecha1<>0 Y Dialogo.Fecha1<=Fsys;'Debe Ingresar una Fecha Valida' ;NO;Habiles(FSys,-1,var('FERIDEF'),SI);
  Lista1   : 'Books'         ; ; ;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS")  
  Check1   : 'Precancelados' ; ; ;;;;;;;0;
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))
ACD(pm:1,PrideMes(Dialogo.Fecha1,SI))
SetFilaActual(4)
ACT(h:fac,'ICL - Intereses devengados')
SetFont(h:fac,3)
SetFilaActual(fac+2)
If NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Fecha:')
ACT(b:fac,Dialogo.Fecha1)
SetFont(a:fac..b:fac,2)
IFA
ACT(a:fac,'Books:')
If NoVacio(Dialogo.Lista1)
   ACT(b:fac,Dialogo.Lista1)
Else
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA
ACT(a:fac,'Precancelados:')
If Dialogo.Check1=1
   ACT(b:fac,'SI')
else   
   ACT(b:fac,'NO')
endif
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,  'Operacion')
ACT(b:fac,  'Fecha Op.')
ACT(c:fac,  'Fecha Vto.')
ACT(c:fac+1,'Final')
ACT(d:fac  ,'Tipo Op.')
ACT(e:fac  ,'Entidad')
ACT(f:fac  ,'Especie')
ACT(g:fac  ,'Saldo')
ACT(h:fac  ,'Tasa')
ACT(i:fac  ,'Tasa Base')
ACT(j:fac  ,'Spread')
ACT(k:fac  ,'Tasa')
ACT(k:fac+1,'Spread')
ACT(l:fac  ,'Plazo Total')
ACT(m:fac  ,'Dias Trans.')
ACT(n:fac  ,'Intereses')
ACT(n:fac+1,'Deveng.Mes')
ACT(o:fac  ,'Intereses')
ACT(o:fac+1,'Deveng.Fecha')
ACT(p:fac  ,'Book')
* FJL 15/01/20 - Se agrega Termsheet ID
ACT(q:FAC, 'TermSheet ID')
*13/09/24 Se agrega  OPERACIONES CB9
ACT(r:FAC, ' Bloqueada')
ACT(r:FAC+1,'SI/NO')
* FJL 07/11/20 - Se agrega TipoCONU
ACT(s:FAC, 'Tipo CONU')

AlinearCeldas(a:fac..yx:fac+1,'C')
SetFont(a:fac..y:fac+1,2)
AgregarMarco(a:fac..s:fac+1,2,0,EXE('COLOR'))
ifa
ifa
acn(w:1,fac+1)
acn(ag:1,0)
acn(an:1,0)
acn(ao:1,0)
SQL.ADD(" SELECT * FROM ( ")
SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, ")
SQL.ADD("  O.Precio1 as Tasa, O.TipoTasa as CodTasa, O.Spread, O.Especie1 as CodSpread, O.Plazo, O.DiasAnio, O.Book1, O.CB1, O.CB9, ")
* FJL 15/01/20 - Se agrega Termsheet ID
*SQL.ADD("  ObservacDoc as TSID,  ")
* FJL 07/11/20 - Por Issue 4523 se cambia el campo del TS y se agrega TipoCONU
* 13/09/24 se agrega el campo CB9 para  operaciones bloqueada 
SQL.ADD("  O.Termsheet as TSID, O.TipoCONU,  ")
SQL.ADD(" (Select "~DBO~".SaldoCONU(NrOperacion,'"~IdxDate(Dialogo.Fecha1)~"',2)) SaldoHoy, O.MB1 TipoTasa, O.MB2 TipoSpread ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" where (FechaVto >= "~IdxDate2(Dialogo.Fecha1)~"  or CB1=1 ) ")
* FJL 13/11/20 - Para mi las del dia del informe debe tomarlas xq el reporte se pide para el dia anterior
*SQL.ADD("   and FechaOp < "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   and FechaOp <= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   and TipoOp in ('CONU')")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Book1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD(" ) Int ")
SQL.ADD(" WHERE ((FechaVto >= "~IdxDate2(Dialogo.Fecha1)~")  or (SaldoHoy>0) ") 
if Dialogo.Check1=1
   SQL.ADD(" or (CB1=1 and Exists(SELECT 1 FROM "~DBO~".CUOTAS C WHERE C.NrOperacion=Int.NrOperacion and C.Radio1=4 and C.Fecha1>="~IdxDate2(val(pm:1))~" and C.Fecha1<="~IdxDate2(Dialogo.Fecha1)~"   )  ) ") 
endif
SQL.ADD(" ) ORDER BY Book1, NrOperacion ")
watch(SQL.Batch)
Recorrer SQL
        if Not Eqstr(fbn['Book1'],val(bo:1))
           if Novacio(val(bo:1))
               act(a:fac,'Total')
               acn(g:fac,val(ag:1))
               acn(n:fac,val(an:1))
               acn(o:fac,val(ao:1))
               SetFont(a:fac..z:fac,2)
               AgregarMarco(a:fac..p:fac,1,0)   
               acn(ag:1,0)
               acn(an:1,0)
               acn(ao:1,0)
               ifa
               ifa
           ENDIF    
           act(a:fac,'Book: '~fbn['Book1']~' - '~BuscarCampo('BOOKS','Descripcion','Codigo',fbn['Book1']))
           SetFont(a:fac..z:fac,2)
           AgregarMarco(a:fac..p:fac,1,0)   
           ifa
        endif
        Message(FBN['NrOperacion'])
        
        ACT(a:fac,FBN['NrOperacion'])
        ACLO(a:fac,FBN['NrOperacion'])
        ACD(b:fac,FBN['FechaOp'])
        ACD(ar:fac,FindeMes(Dialogo.Fecha1,SI))

        if FBN['FechaVto']>0
           ACD(c:fac,FBN['FechaVto'])
           if val(ar:fac)>val(c:fac)
              ACD(ar:fac,val(c:fac))
           endif
        endif    
        ACT(d:fac,FBN['TipoOp'])
        ACT(e:fac,FBN['Cliente1'])
        ACT(f:fac,FBN['Especie'])
        ACN(g:fac, FBN['SaldoHoy'])
        if FBN['TipoTasa']=1
           if Dialogo.Fecha1<FSys
              acd(fe:3,Dialogo.Fecha1)
           else
              acd(fe:3,FSys)
           endif
           acn(h:fac, SQL("SELECT Tasa1 From "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha=(SELECT Max(FECHA) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha<="~IdxDate2(val(fe:3))~") "))   
        else   
           ACN(h:fac,FBN['Tasa'])
        endif
        ACT(i:fac,FBN['CodTasa'])
        if FBN['TipoSpread']=1
           if Dialogo.Fecha1<FSys
              acd(fe:3,Dialogo.Fecha1)
           else
              acd(fe:3,FSys)
           endif
           acn(j:fac, SQL("SELECT Tasa2 From "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha=(SELECT Max(FECHA) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha<="~IdxDate2(val(fe:3))~") "))   
        else   
* FJL 28/12/19 - Reportado en UAT. Cuando es Spread fijo se toma el valor de la operacion
*           ACN(j:fac,FBN['Tasa'])
           ACN(j:fac,FBN['Spread'])
        endif
        ACT(k:fac,FBN['CodSpread'])
        if FBN['FechaVto']>0
           ACN(l:fac,FBN['FechaVto']-FBN['FechaOp'])
        endif    
        *  ACN(m:fac,Dialogo.Fecha1-FBN['FechaOp']+1)
        *  Los dias transcurridos deben ser hasta el ultimo cierre AA 23/01/20
        if Dialogo.Fecha1 < Fsys
           ACN(m:fac,Dialogo.Fecha1-FBN['FechaOp']+1)
        Else
           ACN(m:fac,Dialogo.Fecha1-FBN['FechaOp'])
        Endif
        ACN(n:fac,SQL("SELECT SUM(Monto) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha>="~IdxDate2(val(pm:1))~" and Fecha<="~IdxDate2(Dialogo.Fecha1)))
        ACN(o:fac,SQL("SELECT SUM(Monto) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha="~IdxDate2(Dialogo.Fecha1)))
        ACT(p:fac,fbn['Book1'])
* FJL 15/01/20 - Se agrega Termsheet ID
        if EqStr(FBN['TipoOp'],'CONU')
          ACT(q:fac, FBN['TSID'])
* FJL 07/11/20 - Se agrega TipoCONU
          ACT(s:fac, FBN['TipoCONU'])
        endif
* 13/09/24
        if EqStr(FBN['CB9'], '1') 
            ACT(r:fac,'SI')
        else
            ACT(r:fac,'NO')
        endif
        ACT(bo:1,fbn['Book1'])
        SCN(ag:1,val(g:fac))
        SCN(an:1,val(n:fac))
        SCN(ao:1,val(o:fac))
Proximo
ifa
act(a:fac,'Total')
acn(g:fac,val(ag:1))
acn(n:fac,val(an:1))
acn(o:fac,val(ao:1))
SetFont(a:fac..z:fac,2)
