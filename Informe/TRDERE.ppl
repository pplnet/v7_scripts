ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))

CrearDialogo
  Vehiculo1  : "Vehiculo"     ;1;;;;;;;;VAR('VEHICULODE')
  Mercado1   : "Mercado"      ;2;;;;;;;;
  Fecha1     : "F.Desde"      ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2     : "F.Hasta"      ;5;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Radio1     : 'Moneda|'~Val(ML:1)~'|'~Val(ME:1)~'|Ambas'  ;;;;;;;;;2;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos No Operativos")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
ACT(a:FAC+2, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta : '~Dialogo.Fecha2)


SetListaClaves(1)

SetFilaActual(FAC+5)

ACT(A:FAC, "TRANSACCION")
ACT(g:FAC, "DEPOSITO")
ACT(k:FAC, "RETIRO")
*ACT(o:FAC, "CONCEPTO PAGO")

AgregarMarco(a:FAC..f:FAC,2,1,Exe('COLOR'))
AgregarMarco(g:FAC..j:FAC,2,1,Exe('COLOR'))
AgregarMarco(k:FAC..n:FAC,2,1,Exe('COLOR'))
AgregarMarco(o:FAC..p:FAC,2,1,Exe('COLOR'))

SetFilaActual(FAC+1)

*Transaccion
ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "Especie")
ACT(c:FAC, "Cantidad")
ACT(d:FAC, "Fecha OP")
ACT(e:FAC, "Fecha VAL")
ACT(f:FAC, "Tipo Tr.")

*Deposito
ACT(g:FAC, "Mercado")
ACT(h:FAC, "Cliente")
ACT(i:FAC, "Cuenta")
ACT(j:FAC, "Cta Contable")

*Retiro
ACT(k:FAC, "Mercado")
ACT(l:FAC, "Cliente")
ACT(m:FAC, "Cuenta")
ACT(n:FAC, "Cuenta Contable")

*Concepto Pago

ACT(o:FAC, "Concepto")
ACT(p:FAC, "Book")

SetFont(a5..o:FAC,2)
AgregarMarco(a:FAC..f:FAC,2,1,Exe('COLOR6'))
AgregarMarco(g:FAC..j:FAC,2,1,Exe('COLOR6'))
AgregarMarco(k:FAC..n:FAC,2,1,Exe('COLOR6'))
AgregarMarco(o:FAC..p:FAC,2,1,Exe('COLOR6'))

SQL.ADD("SELECT  T.NrTrans, T.Vehiculo1, T.Especie, T.Cantidad1, T.Fecha1, T.Fecha2, T.TipoTr2 ")
SQL.ADD(", T.Mercado1, T.Cliente1, T.Cuenta1, T.CuentaContable1 ")
SQL.ADD(", T.Mercado2, T.Cliente2, T.Cuenta2, T.CuentaContable2 ")
SQL.ADD(", T.ConceptoPago, T.Book1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T")
SQL.ADD(" WHERE T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  AND  (T.TipoTr2='DENOP' or T.TipoTr2='RENOP' or T.TipoTr2='TRNOP') ")
if NoVacio(Dialogo.Mercado1)
   SQL.ADD("  and (T.Mercado1 = '"~Dialogo.Mercado1~"' or T.Mercado2 = '"~Dialogo.Mercado1~"') ")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif

IF Dialogo.Radio1 = 0
   SQL.ADD(" AND T.Especie = '"~Val(ML:1)~"' ")
ENDIF
IF Dialogo.Radio1 = 1
   SQL.ADD(" AND T.Especie = '"~Val(ME:1)~"' ")
ENDIF

SQL.ADD("ORDER BY NrTrans ")

ACN(w1,FAC)
SetFilaActual(FAC)


recorrer SQL
  *Transaccion
  ACT(a:fac, FBN['Vehiculo1'])
  ACT(b:fac, FBN['Especie'])
  ACN(c:fac, FBN['Cantidad1'])
  ACD(d:fac, FBN['Fecha1'])
  ACD(e:fac, FBN['Fecha2'])
  ACT(f:fac, FBN['TipoTr2'])
  
  *Deposito
  IF incluido(FBN['TipoTr2'], "DENOP")
   ACT(g:fac, FBN['Mercado1'])
   ACT(h:fac, BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']))
   ACT(i:fac, FBN['Cuenta1'])
   ACT(j:fac, FBN['CuentaContable1'])
  ENDIF

  *Retiro
  IF incluido(FBN['TipoTr2'], "RENOP")
   ACT(k:fac, FBN['Mercado1'])
   ACT(l:fac, BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']))
   ACT(m:fac, FBN['Cuenta1'])
   ACT(n:fac, FBN['CuentaContable1'])
  ENDIF
  
  *Transaccion
  IF incluido(FBN['TipoTr2'], "TRNOP")
   ACT(g:fac, FBN['Mercado1'])
   ACT(h:fac, BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']))
   ACT(i:fac, FBN['Cuenta1'])
   ACT(j:fac, FBN['CuentaContable1'])
   ACT(k:fac, FBN['Mercado2'])
   ACT(l:fac, BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente2']))
   ACT(m:fac, FBN['Cuenta2'])
   ACT(n:fac, FBN['CuentaContable2'])
  ENDIF

  *Concepto Pago
  ACT(o:fac, FBN['ConceptoPago'])
  ACT(p:fac, FBN['Book1'])

proximo


SetFont(a:Val(w1)..p:FAC,1)
