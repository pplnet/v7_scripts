ACO(10,7)
ACO(11,6)
ACO(12,9)
ACO(13,7)
ACO(14,7)
ACO(15,8)
ACO(16,8)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)

LimitesVision(p:FAC)
RangoTitulo(a:1..n:FAC, Val(w1))
SetPrintFit(3,86)
