IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1: 'Fecha'                ;;;;;;;;;FSys
  Lista1: 'Vehiculo'             ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Book1: 'Book'            ;;;;;;;;;
  Radio2: 'Expresado en|ARP|USD' ;;;;;;;;;0
  Radio3: 'Expresado en|Millones|ImporteOri';;;;SI;SI;;;;0;;;;;
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha1-1,1,NO,NO)
let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha1-1,1,NO,NO)
SetFilaActual(1)
ACT(A:fac, 'Detalle de Operaciones Remuneradas')
SetFont(A:fac, 3)
SetFilaActual(fac+2)
IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
**Si se selecciona total general, sin vehiculo, debo mostrar para todos los vehiculos
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculos: '~Dialogo.Lista1)
    ACT(LS:1, Dialogo.Lista1)
ELSE
    ACT(A:fac, 'Vehiculos: Todos')
ENDIF
ifa
ACT(A:fac, 'Tipo Op.: MMRPAC')
ifa
ACT(A:fac, 'Fecha : '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Book : '~Dialogo.Book1)
Else
    ACT(A:fac, 'Book : Todos')
EndIf
ifa
IF Dialogo.Radio3 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: ARP')
    ACT(MN:1, '$')
ELSE
    ACT(A:fac, 'Expresado en: USD')
    ACT(MN:1, 'U$S')
ENDIF
SetFont(A:3..A:fac, 2)
SetFilaActual(fac+2)

let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha1-1,1,NO,NO)
let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha1-1,1,NO,NO)
IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
let &vehiculo ''
let &book ''
let &TotBookCap 0
let &TotBookInt 0
let &TotVehCap 0
let &TotVehInt 0
let &TotalVeh 0
let &TotalBook 0
let &TotCap 0
let &TotInt 0
let &Total 0
**Levanto MMRPAC por vehiculo y cartera 
SQL.ADD(" Select O.NrOperacion, O.Vehiculo1, O.Cliente1, O.Book1, O.Especie Mon, ")
SQL.ADD(" O.FechaOp FechaOri, O.FechaVto FechaVto, O.Precio1 Tasa, O.Plazo, O.Cantidad/"~Fstr(&unidad, 0, 0)~" Cantidad ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp = 'MMRPAC' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~")  ")
IF NoVacio(Dialogo.Book1)
    SQL.ADD(" AND O.Book1 = '" ~Dialogo.Book1~ "' ")
EndIf
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Order by O.Vehiculo1, O.Book1")

Recorrer SQL
    **Tipo de Cambio
    IF Incluido(fbn('Vehiculo1'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    IF Incluido(&monedaInforme, fbn('Mon'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    
    let &intRem 0
    let &NrOp fbn('NrOperacion')
    If Vacio(&vehiculo) O Not EqStr(&vehiculo,fbn('Vehiculo1'))
        If NoVacio(&vehiculo) 
            If NoVacio(&Book) Y (&TotBookCap <>0 O &TotBookInt <>0)
                ACT(A:Fac, 'Total del Book '~&book~' :')  
                SetFont(A:FAC, 2)
                ACN(H:FAC, &TotBookCap)
                ACN(I:FAC, &TotBookInt)  
                ACN(J:FAC, &TotalBook)              
                AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR6'))    
                ifa
                let &TotVehCap &TotVehCap + &TotBookCap
                let &TotVehInt &TotVehInt + &TotBookInt 
                let &TotalVeh &TotalVeh + &TotalBook 
                let &TotBookCap 0
                let &TotBookInt 0 
                let &TotalBook 0               
            endif        
            **Solo cambio de vehiculo, no es el primero
            ACT(A:Fac, 'Total Cia '~ BuscarCampo('VEHICULOS','Descripcion','Codigo',&vehiculo) ~ ' en '~fbn('Mon'))
            SetFont(A:FAC, 2)
            ACN(H:FAC, &TotVehCap)
            ACN(I:FAC, &TotVehInt)
            ACN(J:FAC, &TotalVeh)
            AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR8'))    
            ifa
            let &TotCap &TotCap + &TotVehCap
            let &TotInt &TotInt + &TotVehInt 
            let &Total &Total + &TotalVeh
            let &TotVehCap 0
            let &TotVehInt 0   
            let &TotalVeh 0             
        endif    
        let &vehiculo fbn('Vehiculo1')
        **let &Book fbn('Book1')
        ACT(A:fac, BuscarCampo('VEHICULOS','Descripcion','Codigo',&vehiculo))    
        ACT(B:fac, 'Cliente')
        ACT(C:fac, 'Fecha Orig.')
        ACT(D:fac, 'Fecha Vto.')
        ACT(E:fac, 'Mon.')
        ACT(F:fac, 'Tasa Coloc.')
        ACT(G:fac, 'Plazo')
        ACT(H:fac, 'Saldo Diario Prom')
        *ACT(I:fac, 'Capital Colocado')
        ACT(I:FAC, 'Int. Generado')
        ACT(J:FAC, 'Total')
        AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR'))  
        SetFont(A:FAC..J:FAC, 2)
        ifa        
    EndIf
    If Vacio(&book) O Not EqStr(&Book,fbn('Book1'))
        If NoVacio(&Book) Y (&TotBookCap <>0 O &TotBookInt <>0)
            ACT(A:Fac, 'Total del Book '~&book~' :')  
            SetFont(A:FAC, 2)
            ACN(H:FAC, &TotBookCap)
            ACN(I:FAC, &TotBookInt)
            ACN(J:FAC, &TotalBook)            
            AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR6'))    
            let &TotVehCap &TotVehCap + &TotBookCap
            let &TotVehInt &TotVehInt + &TotBookInt 
            let &TotalVeh &TotalVeh + &TotalBook 
            let &TotBookCap 0
            let &TotBookInt 0 
            let &TotalBook 0            
        endif
        let &book fbn('Book1')    
    EndIf    
    SQL.ADD(" Select Sum(Monto) Monto From "~DBO~".MOVDEVENGADOS ")
    SQL.ADD(" Where NrOperacion = '"~&NrOp~"' ")
    SQL.ADD(" AND NrSaldo = 140 ")
    SQL.ADD(" AND TipoDevengado = 'INTLEN' ")
    SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    Recorrer SQL
        dfa
        let &intRem &intRem + fbn('Monto')
    Proximo
    let &Mon fbn('Mon')
    **Numero Op
    ACT(A:Fac, &NrOp)
    **Cliente
    ACT(B:Fac, fbn('Cliente1'))
    **Fecha Origen
    ACT(C:Fac, fbn('FechaOri'))
    **Fecha Vto
    ACT(D:Fac, fbn('FechaVto'))
    **Moneda
    ACT(E:Fac, &Mon)
    **Tasa
    ACN(F:Fac, fbn('Tasa'))
    **Plazo
    ACN(G:Fac, fbn('Plazo'))
    FormatoCeldas(G:Fac, Exe('F0'))
    **Saldo Diario
    ACN(H:Fac, SQL("Select Cantidad1/"~Fstr(&unidad, 0, 0)~" from "~DBO~".CUOTAS where NrOperacion = '"~&NrOp~"' AND Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ") * &tc)
    **Capital Colocado
    **ACN(I:Fac, fbn('Cantidad')* &tc)
    **Interes Generado
    ACN(I:FAC, &intRem * &tc / &unidad)
    **Total
    ACN(J:FAC, val(H:fac)+val(I:FAC))
    
    let &TotBookCap &TotBookCap + val(H:fac)
    let &TotBookInt &TotBookInt + val(I:Fac)  
    let &TotalBook &TotalBook + val(J:FAC)
Proximo

ifa
If NoVacio(&Book) Y (&TotBookCap <>0 O &TotBookInt <>0)
    ACT(A:Fac, 'Total del Book '~&book~' :')  
    SetFont(A:FAC, 2)
    ACN(H:FAC, &TotBookCap)
    ACN(I:Fac, &TotBookInt)
    ACN(J:FAC, &TotalBook)
    AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR6'))    
    ifa
    let &TotVehCap &TotVehCap + &TotBookCap
    let &TotVehInt &TotVehInt + &TotBookInt 
    let &TotalVeh &TotalVeh + &TotalBook    
EndIf
If Dialogo.Radio2 = 0
    let &Mon 'ARP'
Else
    let &Mon 'USD'
EndIf
ACT(A:Fac, 'Total Cia '~ BuscarCampo('VEHICULOS','Descripcion','Codigo',&vehiculo) ~ ' en '~&Mon)
SetFont(A:FAC, 2)
ACN(H:FAC, &TotVehCap)
ACN(I:FAC, &TotVehInt)
ACN(J:FAC,&TotalVeh)
AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR8'))    
ifa
let &TotCap &TotCap + &TotVehCap
let &TotInt &TotInt + &TotVehInt 
let &Total &Total + &TotalVeh
ACT(A:Fac, 'Total General en '~&Mon)
SetFont(A:FAC, 2)
ACN(H:fac,&TotCap)
ACN(I:FAC,&TotInt)
ACN(J:FAC,&Total)
AgregarMarco(A:fac..J:FAC, 0, 0, Exe('COLOR2')) 
ifa
ifa
ACT(A:fac,'Fin del Reporte')
SetFont(A:FAC, 2)
ACO(1, 10)
ACO(2, 15)
ACO(3, 8)
ACO(4, 8)
ACO(5, 5)
ACO(8, 12)
ACO(9, 12)
ACO(9, 12)
ACO(10, 12)
LimitesVision(J:FAC+1)
