*ESTIMACIONES
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, '0' NrComprob, '  ' Origen, M.Fecha2 FechaOp, B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, 'E' Estado, '9' CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".TRANSACCIONES2 M, ")
SQL.ADD(" "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    M.Fecha2    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'ESTIMA' ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

*DISPONIBILIDADES  - INGRESOS 
SQL.ADD(" SELECT /*+ RULE */ (M.Importe8+M.Importe9+M.Importe10+M.Importe11) Cantidad, ")
SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
SQL.ADD(" C.Codigo Cuenta, 'DISPOI' Tipo, '0' NrComprob, '  ' Origen, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, 'E' Estado, '9' CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVDATANET M, ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    C.Numero    = M.Cuenta ")
SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    D.EstadoAprobacion = 'OK' ")
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
SQL.ADD(" AND    M.EstadoConciliacion Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

* DISPONIBILIDADES  - EGRESOS
SQL.ADD(" SELECT /*+ RULE */ (M.Importe4+M.Importe5+M.Importe6+M.Importe7)*(-1) Cantidad, ")
SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
SQL.ADD(" C.Codigo Cuenta, 'DISPOE' Tipo, '0' NrComprob, '  ' Origen, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, 'E' Estado, '9' CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVDATANET M, ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    C.Numero    = M.Cuenta ")
SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    D.EstadoAprobacion = 'OK' ")
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
SQL.ADD(" AND    M.EstadoConciliacion Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
(.'PBSELECT'.)
SQL.ADD(" ORDER BY 4,13,2,5 ")
*VEHICULO BANCO MONEDA CUENTA

ACT(va:1,'')
ACT(mo:1,'')
ACT(cu:1,'')
ACT(ba:1,'')

*- Sumo Saldos de la misma especie para CARA
ACN(ca1,0)
ACN(BD:1, 0)

Recorrer SQL
  ACN(BD:1, 1)
  If Not Eqstr(Val(va:1), fbn('Cliente'))
    If Not Eqstr(Val(va:1), '')
      (.'PBTOTALES'.)
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Cliente'))
    ACT(a:fac, 'Vehiculo: '~fbn('Cliente'))
    ACT(va:1,fbn('Cliente'))
    SetFont(a:fac,2)
    ifa
    (.'PBTITULOS'.)
    ifa
    ifa
    ACT(mo:1,'')
    ACT(cu:1,'')
    ACT(ba:1,'')
  Endif
  If Not Eqstr(Val(ba:1), fbn('Banco'))
    If Not Eqstr(Val(mo:1), '')
      (.'PBTOTALES'.)
    Endif
    ifa
    message('Banco: '~fbn('Banco'))
    ACT(a:fac,'Banco: '~fbn('Banco'))
    ACT(ba:1,fbn('Banco'))
    SetFont(a:fac,4)
    AgregarMarco(a:fac..n:fac,0,0,EXE('COLOR8'))
    AgregarMarco(p:fac..p:fac,0,0,EXE('COLOR8'))
    ACT(mo:1,'')
    ACT(cu:1,'')
  Endif

  If Not Eqstr(Val(mo:1), fbn('Especie'))
    If Not Eqstr(Val(mo:1), '')
      (.'PBTOTALES'.)
    Endif
    ifa
    message('Moneda: '~fbn('Especie'))
    ACT(a:fac,'Moneda: '~fbn('Especie'))
    ACT(mo:1,fbn('Especie'))
    SetFont(a:fac,5)
    AgregarMarco(a:fac..n:fac,0,0,0)
    AgregarMarco(p:fac..p:fac,0,0,0)
    ACT(cu:1,'')
    ACN(fm:1,fac)
    ifa

    *- En los rangos ba: Especie bb:  Saldo 
    *- Para tomar desde CARA
    ACT(ba:val(ca1),val(mo1))
  Endif

  If Eqstr(Val(cu:1), fbn('Cuenta'))
    dfa
  Else
    message('Cuenta:   '~fbn('Cuenta'))
    ACT(a:fac,fbn('Cuenta')~'- '~fbn('Numero'))
    ACT(cu:1,fbn('Cuenta'))
  Endif

  *Saldo
  If Incluido(fbn('Tipo'), 'SALDO')
    SCN(b:fac, fbn('Cantidad'))
  Endif

  *Ajustes Manuales
  If Incluido(fbn('Tipo'), 'CRVM|DEVM') y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp') y Incluido(fbn('Estado'), 'E')
    SCN(c:fac, fbn('Cantidad'))
    AsignarLink(c:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=0,Check1=Dialogo.Check1)
    ACN(b:fac, Val(b:fac)-fbn('Cantidad'))
  Endif

  *Ajustes de Ingresos
*  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),VAR('ZPB11')) o [Incluido(fbn('CodigoDatanet'),VAR('ZPB12')) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),VAR('ZPB13')) y fbn('Cantidad')<0] ] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),Val(BZ:11)) o [Incluido(fbn('CodigoDatanet'),Val(BZ:12)) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),Val(BZ:13)) y fbn('Cantidad')<0] ] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
    SCN(d:fac, fbn('Cantidad'))
    AsignarLink(d:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=1,Check1=Dialogo.Check1)
    ACN(b:fac, Val(b:fac)-fbn('Cantidad'))
  Endif

  *Ajustes de Egresos
*  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),VAR('ZPB21')) o [Incluido(fbn('CodigoDatanet'),VAR('ZPB22')) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),VAR('ZPB23')) y fbn('Cantidad')<0] ] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),Val(BZ:21)) o [Incluido(fbn('CodigoDatanet'),Val(BZ:22)) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),Val(BZ:23)) y fbn('Cantidad')<0] ] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
    SCN(e:fac, fbn('Cantidad'))
    AsignarLink(e:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=2,Check1=Dialogo.Check1)
    ACN(b:fac, Val(b:fac)-fbn('Cantidad'))
  Endif

  *Ingresos del Dia
  If [Incluido(fbn('Tipo'), 'DISPOI') y fbn('Cantidad')<>0] o [Incluido(fbn('Tipo'), 'ESTIMA') y fbn('Cantidad')>0] o [Incluido(fbn('Tipo'), 'CRVM') y fbn('FechaMov')=Dialogo.Fecha1 y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE')] o [Incluido(fbn('Tipo'), 'TRANSF') y Eqstr(MIRT(TRIM(fbn('CB6'))),'1') y fbn('Cantidad')>0 y fbn('FechaMov')=Dialogo.Fecha1]
    SCN(f:fac, fbn('Cantidad'))
    AsignarLink(f:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=3,Check1=Dialogo.Check1)
  Endif

  *Egresos del Dia
  If [Incluido(fbn('Tipo'), 'DISPOE') y fbn('Cantidad')<>0] o [Incluido(fbn('Tipo'), 'ESTIMA') y fbn('Cantidad')<0] o [Incluido(fbn('Tipo'), 'DEVM') y fbn('FechaMov')=Dialogo.Fecha1 y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y Eqstr(fbn('NrComprob'),'0') ] o [Incluido(fbn('Tipo'), 'TRANSF') y Eqstr(MIRT(TRIM(fbn('CB6'))),'1') y fbn('Cantidad')<0 y [fbn('FechaMov')=Dialogo.Fecha1 o Eqstr(fbn('Estado'),'P')]]
*messagebox(fbn('Tipo')~'  '~fbn('Cantidad'))
    SCN(g:fac, fbn('Cantidad'))
    AsignarLink(g:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=4,Check1=Dialogo.Check1)
  Endif

  *Gastos
*  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),VAR('ZPB31')) o [Incluido(fbn('CodigoDatanet'),VAR('ZPB32')) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),VAR('ZPB33')) y fbn('Cantidad')<0] ] y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
  If Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('CodigoDatanet'),Val(BZ:31)) o [Incluido(fbn('CodigoDatanet'),Val(BZ:32)) y fbn('Cantidad')>0 ] o [Incluido(fbn('CodigoDatanet'),Val(BZ:33)) y fbn('Cantidad')<0] ] y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=Val(FE:1)] y fbn('FechaMov')<fbn('FechaOp')
    SCN(h:fac, fbn('Cantidad'))
    AsignarLink(h:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=5,Check1=Dialogo.Check1)
    ACN(b:fac, Val(b:fac)-fbn('Cantidad'))
  Endif

  *Traslados
  If Incluido(fbn('Tipo'), 'TRANSF') y Not Eqstr(MIRT(TRIM(fbn('CB6'))),'1') y [Eqstr(fbn('Estado'),'P') o fbn('FechaMov')=Dialogo.Fecha1]
    SCN(i:fac, fbn('Cantidad'))
    AsignarLink(i:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=6,Check1=Dialogo.Check1)
  Endif

  *Depositos Financieros
  If Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|ESTIMA|SALDO|') y fbn('Cantidad')>0
    SCN(j:fac, fbn('Cantidad'))
    AsignarLink(j:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=7,Check1=Dialogo.Check1)
  Endif

  *Egresos Financieros
  If Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|ESTIMA|SALDO|') y fbn('Cantidad')<0
    SCN(k:fac, fbn('Cantidad'))
    AsignarLink(k:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=8,Check1=Dialogo.Check1)
  Endif

  *Prestamos Ingresos
  If Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')>0
    SCN(l:fac, fbn('Cantidad'))
    AsignarLink(l:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=9,Check1=Dialogo.Check1)
  Endif

  *Prestamos Egresos
  If Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')<0
    SCN(m:fac, fbn('Cantidad'))
    AsignarLink(m:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=10,Check1=Dialogo.Check1)
  Endif

  ACN(n:fac, SUM(b:fac..m:fac))

  *Cheques Pendientes
*  If fbn('NrComprob')<>0
  If Not Eqstr(fbn('NrComprob'),'0')
    SCN(p:fac, fbn('Cantidad'))
    AsignarLink(p:fac, 'APB134',Fecha1=Dialogo.Fecha1,Lista4=fbn('Especie'),Radio2=Dialogo.Radio2,Lista1=fbn('Cliente'),Lista2=fbn('Codigo'),Lista3=fbn('Cuenta'),Radio3=11,Check1=Dialogo.Check1)
  Endif

  FormatoCeldas(b:fac..z:fac, EXE('F2'))
  SetFont(a:fac..z:fac, 7)
Proximo
