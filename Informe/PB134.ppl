SQL.ADD(" UNION ALL ")

*MOVIMIENTOS PENDIENTES DE TRANSACCIONES  - Cheques 
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" Case M.NrComprob when NULL then '0' else M.NrComprob end NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, CD.Tipo CodigoDatanet, B.Codigo, 'P' Estado, T.CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, ")
SQL.ADD(" "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".CHEQUES CH ")
SQL.ADD(" WHERE  M.Cuenta      = C.Codigo  ")
SQL.ADD(" AND    C.Comitente   = B.Codigo  ")
SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
SQL.ADD(" AND    M.Especie     = E.Codigo  ")
SQL.ADD(" AND    CD.Tipo       = TD.Codigo  ")
SQL.ADD(" AND    T.Cantidad2 = CH.NrCheque ")
SQL.ADD(" AND    T.Chequera1 = CH.Chequera ")
SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo  ")
SQL.ADD(" AND    T.TipoTr2 IN ('DEVM') ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
*-SQL.ADD(" AND    TD.Codigo Not IN ("~Pipe2Comillas(Val(CN:1))~") ")
*-SQL.ADD(" AND    ((M.NrComprob <> 0 OR M.NrComprob IS NOT NULL) AND T.TipoTr2='DEVM') ")
SQL.ADD("  AND T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~"  ")
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

*MOVIMIENTOS PENDIENTES DE TRANSACCIONES  - Traslados
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" case M.NrComprob when NULL then '0' else M.NrComprob end NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, CD.Tipo CodigoDatanet, B.Codigo, 'P' Estado, T.CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, ")
SQL.ADD(" "~DBO~".TIPOSCODIGODATANET TD ")
SQL.ADD(" WHERE  M.Cuenta      = C.Codigo  ")
SQL.ADD(" AND    C.Comitente   = B.Codigo  ")
SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
SQL.ADD(" AND    M.Especie     = E.Codigo  ")
SQL.ADD(" AND    CD.Tipo       = TD.Codigo  ")
SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo  ")
SQL.ADD(" AND    T.TipoTr2 IN ('TRANSF') ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
SQL.ADD(" AND    TD.Codigo Not IN ("~Pipe2Comillas(Val(CN:1))~") ")
SQL.ADD("  AND T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~"  ")
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

*MOVIMIENTOS EJECUTADOS DE TRANSACCIONES 
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" '0' NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, CD.Tipo CodigoDatanet, B.Codigo, 'E' Estado, T.CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD ")
SQL.ADD(" WHERE  M.Cuenta      = C.Codigo ")
SQL.ADD(" AND    C.Comitente   = B.Codigo ")
SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
SQL.ADD(" AND    M.Especie     = E.Codigo ")
SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo  ")
SQL.ADD(" AND    T.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    M.NrSaldo     = 1     ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" AND    (M.NrComprob  ='0' OR M.NrComprob is null OR M.NrComprob='' )  ")
SQL.ADD(" AND    CD.Tipo Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
SQL.ADD(" AND    (T.Fecha1    = "~IdxDate2(Dialogo.Fecha1)~" OR T.Fecha1 = "~IdxDate2(Val(FE:1))~" ) ")
SQL.ADD(" AND      T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~" ")
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

*MOVIMIENTOS EJECUTADOS DE OPERACIONES LIQUIDADAS
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoOp Tipo, ")
SQL.ADD(" '0' NrComprob, '  ' Origen, T.FechaOp, B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo, 'E' Estado, '9' CB6 ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, ")
SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".TRANSACCIONES2 TR, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.NrOperacion = TR.NrTrans ")
SQL.ADD(" AND    T.NrOperacion = TR.NrOperacionRef1 ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
If NoVAcio(Dialogo.Lista4)
  SQL.ADD(" AND    M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND   (   (M.NrSaldo =1 AND M.FechaMov = "~IdxDate2(Dialogo.Fecha1)~")  ")
SQL.ADD("        OR (M.NrSaldo =99 AND M.FechaEje > "~IdxDate2(Dialogo.Fecha1)~") ) ")
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
(.'PBSELECT'.)

SQL.ADD(" UNION ALL ")

