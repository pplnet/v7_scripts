*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  :  'Fecha Desde';;;;;;Dialogo.Fecha1 >= 0;'Fecha Desde Invalida';NO;FSys
  Fecha2  :  'Fecha Hasta';;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;FSys
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(A:2, CodigoInforme)
SetFilaActual(4)

ACT(a:FAC, 'Flags de OCT')
ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
if Dialogo.Fecha2>Dialogo.Fecha1
  ACT(a:FAC+1, Val(a:FAC+1)~' hasta '~Dialogo.Fecha2)
endif
SetFont(a:FAC..a:FAC+1,2)

SetFilaActual(FAC+3)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Registro')
ACT(c:FAC, 'Cant.Reg.')
ACT(d:FAC, 'Paso')
ACT(e:FAC, 'Fecha')
ACT(f:FAC, 'Hora')
ACT(g:FAC, 'Secuencia')
ACT(h:FAC, 'Estado')
ACT(i:FAC, 'Descripcion')
SetFont(a:fac..i:FAC,2)
AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select * from "~DBO~".FLAGSOCT ")
SQL.ADD("where Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
*SQL.ADD("order by Fecha,Registro,Paso ")
SQL.ADD("order by Fecha,FechaMAE,HoraMAE ")
Recorrer SQL
  ACD(a:FAC, FBN['Fecha'])
  ACT(b:FAC, FBN['Registro'])
  ACN(c:FAC, FBN['Cantidad'])
  ACN(d:FAC, FBN['Paso'])
  if NoVacio(FBN['FechaMAE'])
    ACT(e:FAC, Copy(FBN['FechaMAE'],5,2)~'/'~Copy(FBN['FechaMAE'],3,2)~'/'~Copy(FBN['FechaMAE'],1,2))
  endif
  if NoVacio(FBN['HoraMAE'])
    ACT(f:FAC, Copy(FBN['HoraMAE'],1,2)~':'~Copy(FBN['HoraMAE'],3,2)~':'~Copy(FBN['HoraMAE'],5,2))
  endif
  ACT(g:FAC, FBN['Secuencia'])
  ACT(h:FAC, FBN['Estado'])
  if EqStr(FBN['Registro'],'4416')
    ACT(i:FAC, 'Recepcion Paso MTM (MAE)')
  endif
  if EqStr(FBN['Registro'],'4426')
    ACT(i:FAC, 'Recepcion Detalle MTM (MAE)')
  endif
  if EqStr(FBN['Registro'],'4427')
    ACT(i:FAC, 'Recepcion Cotizaciones (MAE)')
  endif
  if EqStr(FBN['Registro'],'MTMD')
    ACT(i:FAC, 'Calculo MTM (FPA)')
  endif
  if EqStr(FBN['Registro'],'CONC')
    ACT(i:FAC, 'Concialiacion FPA-MAE (FPA)')
  endif
  if EqStr(FBN['Registro'],'FIND')
    ACT(i:FAC, 'Fin del dia (MAE)')
  endif
  if EqStr(FBN['Registro'],'CIED')
    ACT(i:FAC, 'Cierre de dia OCT (FPA)')
  endif
  FormatoCeldas(c:fac..c:fac,Exe('F0'))
  FormatoCeldas(d:fac..d:fac,Exe('F0'))
  SetFont(a:fac..i:FAC,1)
Proximo

ACO(1,7)
ACO(2,6)
ACO(3,7)
ACO(4,4)
ACO(5,7)
ACO(6,7)
ACO(7,7)
ACO(8,4)
ACO(9,16)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(i:FAC)
