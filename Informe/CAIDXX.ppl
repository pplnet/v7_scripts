***---ModoReproceso(ConDialogo)
CrearDialogo
  Lista1     : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"      ;;;
  Fecha1     : "F.Desde"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"        ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys+365
  Radio1     : "|Pesos|Dolares" ;;;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Caida de Depositos a Plazo")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(VAL(ZZ6))
  ACT(a:FAC+1, 'Vehiculo : '~VAL(ZZ6))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+2, 'Especie : Todos')
endif
ACT(a:FAC+3, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+5, 'Expresado en '~iif(Dialogo.Radio1=0,'Pesos','Dolares'))
SetFont(a:fac..N:FAC+5,2)

SetFilaActual(FAC+7)

ACT(a:FAC, 'Vehiculo')
ACT(b:FAC, 'Cliente')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Monto Colocado en')
ACT(e:FAC, 'Tasa') *-------------
ACT(f:FAC, 'Tipo de Tasa') *----
ACT(g:FAC, 'Fecha')
