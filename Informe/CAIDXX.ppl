ACT(i:FAC, 'Plazo')
ACT(j:FAC, 'Monto Final Colocado')
ACT(k:FAC, 'Total por dia')
ACT(l:FAC, 'Tipo')
ACT(m:FAC, 'Numero')

ACT(d:FAC+1, 'en Moneda Original')
ACT(g:FAC+1, 'Operacion')
ACT(h:FAC+1, 'Vencimiento')
ACT(i:FAC+1, 'Remanente')
ACT(j:FAC+1, 'en Moneda Original')
ACT(k:FAC+1, 'en Pesos')
ACT(l:FAC+1, 'Operacion')
ACT(m:FAC+1, 'Operacion')

AlinearCeldas(a:FAC..m:FAC+1,'I')
SetFont(a:fac..m:FAC+1,2)
AgregarMarco(a:FAC..m:FAC+1,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)

*- A FechaVto->Capital 
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
SQL.ADD(" O.FechaVto Vto,  ")
SQL.ADD(" O.Cantidad Cant ")
SQL.ADD(" from  "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDIA') ")
If NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All")
*- A Fecha2 -> Intereses
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
SQL.ADD(" C.Fecha2 Vto,  ")
SQL.ADD(" Sum(C.Cantidad3) Cant ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.TipoOp In ('MMCDIA') ")
If NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" group by O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion,O.Cliente1, C.Fecha2 ")
*---- 
*- MMCDP 
SQL.ADD(" Union All")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, O.Cliente1, ")
SQL.ADD(" CASE Plazo2 When 0 Then O.FechaVto Else O.FechaVto2 End Vto, ")
SQL.ADD(" CASE Plazo2 When 0 Then O.TotalBrutoCli1 Else O.TotalAux3 End Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDP') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("     or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha2)~"')) ")
*-------
SQL.ADD(" Union All")
