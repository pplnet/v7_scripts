*AlinearCeldas(a1..f:fac,'I')

*-- Hay datos para mostrar
CrearDialogo
  Fecha1     :'F.Posicion' ; 1;1;;NO;;;;;VAL(bz:1);
  Fecha2     :'F.Pago'     ; 1;2;;NO;;;;;VAL(bz:2);
  Especie1   :'Especie'    ; 2;1;;NO;;;;;VAL(bz:3);
  Check1     :'Div.Efec.'  ; 3;1;;NO;;;;;VAL(bz:4);
  Precio1    :'Porc.'      ; 3;2;;NO;Dialogo.Check1=1;;;;VAL(bz:5);
  Especie2   :'Moneda'     ; 4;2;;NO;Dialogo.Check1=1;;;;VAL(bz:6);
  Precio7    :'Cotizacion' ; 5;1;;NO;Dialogo.Check1=1;;;;VAL(bz:10)
  Precio5    :'Tipo Cambio'; 5;1;;NO;Dialogo.Check1=1;;;;VAL(bz:9);
  Check2     :'Div.Acc.'   ; 6;1;;NO;;;;;VAL(bz:7);
  Precio2    :'Porc.'      ; 6;2;;NO;Dialogo.Check2=1;;;;VAL(bz:8);
  Precio6    :'Prec.Accion'; 7;2;;NO;Dialogo.Check2=1;;;;Val(bz:11);
  Check3     :'Revaluo'    ; 8;1;;NO;NO
  Precio9    :'Porc.'      ; 8;2;;NO;NO;Dialogo.Precio9>=0;'El Porcentaje debe ser Positivo';NO;
  Check4     :'Canje'      ; 9;1;;NO;NO
  Precio10   :'Porc.'      ; 9;2;;NO;NO;Dialogo.Precio10>=0;'El Porcentaje debe ser Positivo';NO;
  Precio3    :'Fraccion'   ;10;1;;NO;NO;Dialogo.Precio3>=0;'La Fraccion debe ser Positiva';NO;
  Precio4    :'Precio Fr.' ;10;2;;NO;NO;Dialogo.Precio4>=0;'El Precio de Fraccion debe ser Positivo';NO;
  Check5     :'Procesa'    ;11;1;;NO;  ;;;;Val(bz:12);
  Vehiculo1  :'Vehiculo'   ;11;2;;NO;NO;
  Cuenta1    :'C.Efectivo' ;11;1;;NO;NO;
  Cuenta2    :'C.Especie'  ;11;1;;NO;NO;
  ListBox; 'Arial,8,N'; 460; 300
     'Cliente'       ;a1..a:FAC;NO;;;;60;STRING
     'Concepto'      ;b1..b:FAC;NO;;;;60;STRING
     'Vehiculo'      ;c1..c:FAC;NO;;;;60;STRING
     'Book'          ;l1..l:FAC;NO;;;;60;STRING
     'Cantidad'      ;d1..d:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Div.Eftvo'     ;e1..e:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Div.Acc.'      ;f1..f:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Precio'        ;g1..g:FAC;NO;;;;80;NUMERO;'###,###.#####'
     'Monto Op.'     ;h1..h:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Imp.Liq.Fut'   ;i1..i:FAC;NO;;;;80;NUMERO;'###,###,###.##'
     'Cant.Orig'     ;j1..j:FAC;NO;;;;80;NUMERO;'###,###,###.##'   
     'Nro.Op.'       ;k1..h:FAC;NO;;;;60;STRING
  FinListBox  
FinDialogo
IF Not OK
  Cancelar
EndIf

Recorrer&k 1,FAC
  ACN(w1,&k)

  if Dialogo.Check5=1
    IF Incluido(Copy(Val(b:Val(w1)),1,4),'SPOT')
      *** genera transaccion de dividendo
      (.'GENDIVIDEN'.)
    EndIf

    IF Incluido(Copy(Val(b:Val(w1)),1,3),'SAL')
      * Actualiza la Posicion
      ACT(w2,VAL(w2)~",'"~Val(c:Val(w1))~"' " )
      *** genera transaccion de dividendo
      (.'GENDIVIDEN'.)
    EndIf

    IF Incluido(Val(b:Val(w1)),'DSEO')
      Message('Actualiza Opciones ....')

      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set Cantidad      = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
      SQL.ADD("    PrecioEj      = "~Fstr(Val(g:Val(w1)),0,7)~", ")
      SQL.ADD("    TotalAux1     = "~Fstr(Val(h:Val(w1)),0,2)~" ")
      SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
      SQL.NEW

      * Recupero los Valores para guardar la historia     
      ACN(ab1,BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Val(k:Val(w1)) ))
      ACN(ab2,BuscarCampo('OPERACIONES','PrecioEj','NrOperacion',Val(k:Val(w1)) ))
      ACN(ab3,BuscarCampo('OPERACIONES','TotalAux1','NrOperacion',Val(k:Val(w1)) ))
      ACN(ab4,1+SQL("SELECT Max(NrCuota) FROM "~DBO~".CUOTAS Where NrOperacion='"~Val(k:Val(w1))~"' ") )

      SQL.ADD(" INSERT "~DBO~".CUOTAS (NrOperacion,NrCuota,Fecha1,Plazo1,Cantidad1,Precio1,Cantidad2) ")
      SQL.ADD(" Values ")
      SQL.ADD(" ('"~Val(k:Val(w1))~"',"~Fstr(Val(ab4),0,0)~",'"~IdxDate(Dialogo.Fecha1)~"',0,"~Fstr(Val(ab1),0,2)~","~Fstr(Val(ab2),0,7)~","~Fstr(Val(ab3),0,2)~") ")
      SQL.NEW
      SQL.EXEC

      ACT(i3,Val(k:Val(w1)))

      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)    
    ENDIF

    IF Incluido(Val(b:Val(w1)),'SERA|SERP|SERAV|SERPV')
      Message('Actualiza Opciones ....')
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set TotalRetenciones="~Fstr(Val(j:Val(w1)),0,2)~",")
      SQL.ADD("    Cantidad      = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
      SQL.ADD("    Precio2       = "~Fstr(Val(g:Val(w1)),0,7)~", ")
      SQL.ADD("    TotalBrutoCli2= "~Fstr(Val(h:Val(w1)),0,2)~", ")
      SQL.ADD("    TotalNetoCli2 = "~Fstr(Val(i:Val(w1)),0,2)~" ")
      SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
      SQL.NEW
      SQL.EXEC

      IF EqStr(VAL(x:Val(w1)),'0')
        *** genera transaccion de dividendo
        (.'GENDIVIDEN'.)
      ENDIF

      ACT(i3,Val(k:Val(w1)))
      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)    

      SQL.ActualizarMovimientos2(Val(k:Val(w1)),SI,NO,NO,SI)
      SQL.EXEC
    EndIf

    IF Incluido(Val(b:Val(w1)),'SECT|SECTV|SEVT|SEVTV')
      Message('Actualiza Operaciones a Termino')

      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("Set Cantidad       = "~Fstr(Val(d:Val(w1))+Val(f:Val(w1)),0,2)~", ")
      SQL.ADD("    Precio1        = "~Fstr(Val(g:Val(w1)),0,7)~", ")
      SQL.ADD("    TotalBrutoCli1 = "~Fstr(Val(h:Val(w1)),0,2)~", ")
      SQL.ADD("    FechaEx1       ='"~IdxDate(Val(bz:2))~"', ")
      SQL.ADD("    TotalNetoCli1  = "~Fstr(Val(i:Val(w1)),0,2)~" ")
      SQL.ADD("where  NrOperacion = '"~Val(k:Val(w1))~"' ")
      SQL.NEW
      SQL.EXEC  

      ACT(i3,Val(k:Val(w1)))

      * Actualizo la Instancia de la Operacion a Supervision
      (.'MODIINSTAN'.)    

      SQL.ActualizarMovimientos2(Val(k:Val(w1)),SI,NO,NO,SI)
      SQL.EXEC

      *** NO GENERA TRANSACCION DE DIVIDENDOS por los TERMINOS
    ENDIF
  endif
Proximo

