* Compras/Ventas futuras. Modifica Operacion y Actualiza Mov. Posiciones y Saldos.
* Compras/Ventas Spot no Vencidas. Genera una Transaccion de Dividendos
* Repos: Idem Compras/Ventas futuras 
* Posiciones: Genera una Transaccion de Dividendos
* Efectivo Total: Genera una Transaccion de Dividendos
CrearDialogo
  Fecha1     :'F.Posicion' ; 1;1;;  ;  ;Dialogo.Fecha1<>0 y Dialogo.Fecha1 <= Fsys ;'Debe Ingresar una Fecha';NO;FSys
  Fecha2     :'F.Pago'     ; 1;2;;  ;  ;Dialogo.Fecha2<>0 y Dialogo.Fecha2 <= Fsys y Dialogo.Fecha1 <= Dialogo.Fecha2 ;'Debe Ingresar una Fecha';NO;FSys
  Especie1   :'Especie'    ; 2;1;;  ;  ;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y DesciendeDeEspecie(Dialogo.Especie1,'PRIVA');'Debe Ingresar una Especie (Titulo Privado)';NO;
  Check1     :'Div.Efec.'  ; 3;1;;  ;  ;
  Precio1    :'Porc.'      ; 3;2;;Dialogo.Check1=1;;Dialogo.Precio1>0 O Dialogo.Check1=0;'El Porcentaje en Efectivo debe ser Positivo';NO;;iif(Dialogo.Check1=0,0,Dialogo.Precio1)
  Especie2   :'Moneda'     ; 4;2;;Dialogo.Check1=1;;Vacio(Dialogo.Especie2) o DesciendeDeEspecie(Dialogo.Especie2,'MONEDA');'Debe Ingresar una Moneda';NO;
  Precio7    :'Cotizacion' ; 5;1;;NO;Dialogo.Check1=1;;;;;IIF(eqstr(SQL(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Dialogo.Especie2~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP')/COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP'),COTIZACIONC(Dialogo.Especie2,,,,Fsys,1,SI,'ARP')/COTIZACIONC(VAR('MONEEXTR'),,,,Fsys,1,SI,'ARP'))
  Precio5    :'Tipo Cambio'; 5;2;;Dialogo.Check1=1;Dialogo.Check1=1 y Not Eqstr(Dialogo.Especie2,VAR('MONEEXTR'));Eqstr(Dialogo.Especie2,VAR('MONEEXTR')) o [Dialogo.Precio5<=Dialogo.Precio7*(1+VAR('RPRECIO2')/100) Y Dialogo.Precio5>=Dialogo.Precio7*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Fuera de Rango: '~FSTR(Dialogo.Precio7*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(Dialogo.Precio7*(1+VAR('RPRECIO2')/100),1,7);NO;
  Check2     :'Div.Acc.'   ; 6;1;;  ;  ;Dialogo.Check1+Dialogo.Check2>0;'Debe seleccion al menos un tipo de Diviendos (Efectivo o Acciones)';NO;
  Precio2    :'Porc.'      ; 6;2;;Dialogo.Check2=1;;Dialogo.Precio2>0 O Dialogo.Check2=0;'El Porcentaje en Acciones debe ser Positivo';NO;;iif(Dialogo.Check2=0,0,Dialogo.Precio2)
  Precio6    :'Prec.Accion'; 7;2;;Dialogo.Check2=1;;Dialogo.Precio6>0 O Dialogo.Check2=0;'El Precio de la Accion debe ser positivo';NO;;iif(Dialogo.Check2=0,0,iif(MODI,Dialogo.Precio6,Cotizacion(Dialogo.Especie1,,,,Dialogo.Fecha1-1,1,SI)/(1+Dialogo.Precio2/100)));
  Check3     :'Revaluo'    ; 8;1;;NO;NO
  Precio9    :'Porc.'      ; 8;2;;NO;NO;Dialogo.Precio9>=0;'El Porcentaje debe ser Positivo';NO;
  Check4     :'Canje'      ; 9;1;;NO;NO
  Precio10   :'Porc.'      ; 9;2;;NO;NO;Dialogo.Precio10>=0;'El Porcentaje debe ser Positivo';NO;
  Precio3    :'Fraccion'   ;10;1;;NO;NO;Dialogo.Precio3>=0;'La Fraccion debe ser Positiva';NO;
  Precio4    :'Precio Fr.' ;10;2;;NO;NO;Dialogo.Precio4>=0;'El Precio de Fraccion debe ser Positivo';NO;
  Check5     :'Procesa'    ;11;1;;NO;  ;;;;0
  Vehiculo1  :'Vehiculo'   ;11;2;;NO;NO;
  Cuenta1    :'C.Efectivo' ;11;1;;NO;NO;
  Cuenta2    :'C.Especie'  ;11;1;;NO;NO;
FinDialogo
if Not Ok
  Cancelar
endif

if Dialogo.Check5=0
  HojaVisible(SI)
endif

ACT(aa:0, 'AA')
ACT(ba:0, 'BA')
ACT(ca:0, 'CA')

acn(by:1,0)
SQL.ADD(" Select 1 from "~DBO~".OPERACIONES ")
SQL.ADD(" where TipoOp = 'DIVIDE' ")
SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")   
Recorrer SQL
  acn(by:1,1)
Proximo
IF Val(by:1)>0
  Cancelar ('El proceso de Dividendos ya fue ejecutado para el '~Dialogo.Fecha1~', Especie '~Dialogo.Especie1~' ')
Endif

If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
  Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
endif

