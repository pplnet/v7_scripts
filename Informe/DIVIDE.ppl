acn(z1,0)
SQL.ADD("Select 1 FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where T.Especie   = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and T.NrTrans   = B.NrOperacion ")
SQL.ADD("   and B.NrBit     = 7 ")
SQL.ADD("   and B.Valor     = '0' ") 
Recorrer SQL
  acn(z1,1)
Proximo

if Val(z1)>0
  Cancelar('La Especie '~Dialogo.Especie1~' tiene Vouchers Pendientes de Confirmacion')
endif

acn(z1,0)

Message('**-- Verificando la Instancia de las Operaciones ...')

acn(z1,0)

SQL.ADD("SELECT O.NrOperacion,B.NrBit ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where O.Especie     =  '"~Dialogo.Especie1~"' ")
SQL.ADD("   and O.TipoOp      In ('SECT','SECTV','SEVT','SEVTV') ")
SQL.ADD("   and O.FechaOp     <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("   and O.FechaVto    >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("   and O.NrOperacion =  B.NrOperacion ")
SQL.ADD("   and (B.NrBit      <> 20 and B.NrBit <> 50) ")
SQL.ADD("   and B.Valor       =  '1' ")
Recorrer SQL
   acn(z1, FBN['NrBit'])
   Message('La Operacion '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(Z1),0,0)~" AND Tabla='OPERACIONES'") )
   Break
Proximo

If val(z1)=0
   SQL.ADD("SELECT O.NrOperacion,B.NrBit  ")
   SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD(" Where O.Especie     =  '"~Dialogo.Especie1~"' ")
   SQL.ADD("   and O.TipoOp      In ('DSEO') ")
   SQL.ADD("   and O.FechaEj     >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD("   and (O.CB8        is Null or O.CB8 = '0' ) ")
   SQL.ADD("   and O.NrOperacion =  B.NrOperacion ")
   SQL.ADD("   and (B.NrBit      <> 20 and B.NrBit <> 50) ")
   SQL.ADD("   and B.Valor       =  '1' ")
   Recorrer SQL
      acn(z1, FBN['NrBit'])
      Message('La Operacion '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(Z1),0,0)~" AND Tabla='OPERACIONES'") )
      Break
   Proximo
EndIf

If val(z1)=0
   SQL.ADD("SELECT O.NrOperacion,B.NrBit ")
   SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD(" Where O.Especie     =  '"~Dialogo.Especie1~"' ")
   SQL.ADD("   and O.TipoOp      In ('SERA','SERP','SERAV','SERPV') ")
   SQL.ADD("   and O.FechaOp     <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD("   and O.FechaVto2   >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD("   and O.NrOperacion =  B.NrOperacion ")
   SQL.ADD("   and (B.NrBit      <> 20 and B.NrBit <> 50) ")
   SQL.ADD("   and B.Valor       =  '1' ")
   Recorrer SQL
     acn(z1,FBN['NrBit'])
     Message('La Operacion '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(Z1),0,0)~" AND Tabla='OPERACIONES'") )
     Break
   Proximo  
EndIf

If val(z1)=0
   SQL.ADD("SELECT O.NrOperacion,B.NrBit  ")
   SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD(" Where O.Especie     =  '"~Dialogo.Especie1~"' ")
   SQL.ADD("   and O.TipoOp      In ('SECS','SECSV','SEVS','SEVSV') ")
   SQL.ADD("   and O.FechaOp     <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD("   and O.FechaVto    >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
   SQL.ADD("   and O.NrOperacion =  B.NrOperacion ")
   SQL.ADD("   and (B.NrBit      <> 20 and B.NrBit <> 50) ")
   SQL.ADD("   and B.Valor       =  '1' ")
   Recorrer SQL
     acn(z1,FBN['NrBit'])
     Message('La Operacion '~FBN['NrOperacion']~' Debe estar en BackOffice o Terminal. Instancia Actual='~SQL("Select Nombre FROM "~DBO~".INSTANCIAS  Where NrInstancia="~Fstr(VAL(Z1),0,0)~" AND Tabla='OPERACIONES'") )
     Break
   Proximo  
EndIf

If val(z1)<>0
   Cancelar('Proceso Cancelado. Todas las Operaciones deben estar en BackOffice o Terminal !!!')
EndIf

