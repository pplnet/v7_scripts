CrearDialogo
  Fecha1   : 'Fecha'       ;;;;;;;;;PriDeMes(FSys,SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1 : 'ContraParte' ;;;;;;;;;;;
  Especie1 : 'Especie '    ;;;;;;NOVACIO(Dialogo.Especie1);'Especie Inexistente';NO;;;
  Radio1   : 'Tipo|Reales|Simuladas' ;;;;;;;;;0;;
  String1  : 'Path'        ;;;;;;;;;VAR('DIRDEFAULT')
  String2  : 'Arch. Texto' ;;;;NO;;;;;;'CURVASIM.WKS';
FinDialogo

if not OK
  Cancelar
endif

If Dialogo.Radio1=1
   * Linkeo la Curva de Futuros Simulada
   ImportarWKS(a500..c2500,a1..c2000,Dialogo.String1~Dialogo.String2)

   If Vacio(val(a500))
      Cancelar('No se pudo recuperar la Curva de Futuros Simulada '~Dialogo.String2) 
   EndIf
EndIf

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

If Dialogo.Radio1=0
   ACT(a1, 'Mark to Market - Detalle de Operaciones Vigentes por Contraparte')
Else
   ACT(a1, 'Riesgo Crediticio - Detalle de Operaciones Vigentes por Contraparte')
EndIf

ACT(a2, 'Fecha : '~Dialogo.Fecha1)

if NoVacio(Dialogo.Lista1)
  ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:4, 'Vehiculo : Todos')
endif

ACT(a6, 'ContraParte')
ACT(b6, 'Numero')
ACT(c6, 'Producto')
ACT(d6, 'Tipo')
ACT(e6, 'Fecha')
ACT(f6, 'Fecha')
ACT(g6, 'Volumen')
ACT(h6, 'Volumen')
ACT(i6, 'Pr.Concert.')
ACT(j6, 'Prima')
ACT(k6, 'Precio')
ACT(l6, 'Resultado')
ACT(m6, 'Rdo. Oper ')
ACT(n6, 'Fecha')

ACT(b7, 'Operacion')
ACT(e7, 'Inicio')
ACT(f7, 'Fin')
ACT(h7, 'Total')
ACT(k7, 'Actual')
ACT(l7, 'Barril')
ACT(m7, 'No Cobr')
ACT(n7, 'Liquidacion')
*-----------------------------------------
*--- No mover columnas m y n porque se utiliza para linkear
*-----------------------------------------

AgregarMarco(a6..n7, 2,0,Exe('COLOR'))

SetFilaActual(7)

SQL.ADD("Select O.Vehiculo1,C.Fecha2 ,O.*, ")
SQL.ADD("C.Fecha1, C.Fecha2,C.Plazo1, C.Cantidad1,C.Cantidad2,C.Precio1 Pr1,C.Precio2 Pr2,C.Precio3 Pr3,C.Precio4 Pr4,C.Total1,C.NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and O.FechaOp  <= "~SqlFecha(Dialogo.Fecha1)~" ")
SQL.ADD("and C.Fecha2>"~SqlFecha(Dialogo.Fecha1)~" ")
SQL.ADD("and O.CB9='1' ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and (O.TipoOp in ('DPDSO','DPDSS','DPBOD','DPOA','DPOD','DPRC','DPRRS','DPRS','DPS','DPBOA','DPC','DPF','DPFW','DPOGA','DPOGD','DPSV') ")
SQL.ADD(" or (O.TipoOp in ('DPSN') and  (CB8='0' or CB8 IS NULL) ) )")
SQL.ADD("Union ")
SQL.ADD("Select  O.Vehiculo1, FechaPago Fecha2 ,O.*, ")
SQL.ADD(" "~SqlFecha(Dialogo.Fecha1)~" Fecha1, "~SqlFecha(Dialogo.Fecha1)~" Fecha2, 0 Plazo1, 0 Cantidad1,0 Cantidad2,0 Pr1,0 Pr2 ,0 Pr3,0 Pr4,0 Total1,0 NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES O")
SQL.ADD("where O.FechaOp  <= "~SqlFecha(Dialogo.Fecha1)~" ")
SQL.ADD("and O.CB9='1' ")
SQL.ADD("and TipoOp In ('DPOS','DPBOS','DPOGS') and O.FechaEj>"~SqlFecha(Dialogo.Fecha1)~" ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie  = '"~Dialogo.Especie1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("order by 1,20,4")

BorrarCeldas(z1..z1)

*- bv2: Fila desde donde se listan los datos 
*- bv3: Fila hasta donde se listan los datos 
acn(bv2,8)

Recorrer SQL

  if Not EQstr(fbn('Vehiculo1'),Val(z1))
     * cambia Cliente
     if NoVacio(Val(z7))
        act(a:fac,'Total '~Val(z7) )
        acn(m:fac, Val(w2))

        BorrarCeldas(w2..w2)
        AgregarMarco(a:fac..m:fac,1)
        SetFont(a:fac..m:fac,1)
        ifa
     endif

     * cambia empresa
     if NoVacio(Val(z1))
        act(a:fac,'Total Empresa '~Val(z1) )
        acn(m:fac, Val(w1))

        BorrarCeldas(w1..w1)
        AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..n:fac,1)
        ifa
     endif

     * Asignar Empresa
     act(z1, fbn('Vehiculo1'))
     act(a:fac,'Empresa '~Val(z1) )
     AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..n:fac,1)
     ifa

     * Asignar cliente
     act(z7, fbn('Cliente1'))
     act(a:fac,Val(z7) )
     AgregarMarco(a:fac..n:fac,1)
     SetFont(a:fac..n:fac,1)
     ifa
  else
     if Not EQstr(fbn('Cliente1'),Val(z7))
        * cambia Cliente
        if NoVacio(Val(z7))
           act(a:fac,'Total '~Val(z7) )
           acn(m:fac, Val(w2))

           BorrarCeldas(w2..w2)
           AgregarMarco(a:fac..n:fac,1)
           SetFont(a:fac..n:fac,1)
           ifa
        endif
        * Asignar cliente
        act(z7, fbn('Cliente1'))
        act(a:fac,Val(z7) )
        AgregarMarco(a:fac..n:fac,1)
        SetFont(a:fac..n:fac,1)
        ifa
     endif
  endif

  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))

  act(c:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))

  * determinar el signo
  if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
    if EqStr(fbn('MB1'),'1')
      act(d:fac,'Producer')
      acn(z5,1)
    else
      act(d:fac,'Consumer')
      acn(z5,-1)
    endif
  endif

   if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra PUT')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta CALL')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta PUT')
      acn(z5,-1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Compra CALL')
      acn(z5,-1)
    endif
  endif
  if EqStr(fbn('TipoOp'),'DPSN')
    if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Producer')
      acn(z5,1)
    endif
    if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
      act(d:fac,'Venta Consumer')
      acn(z5,1)
    endif
    if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Compra Consumer')
      acn(z5,-1)
    endif
    if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')] 
      act(d:fac,'Venta Producer')
      acn(z5,-1)
    endif
  endif

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acd(e:fac, fbn('FechaOp'))
     acd(f:fac, fbn('FechaEj'))
  Else 
     If Incluido(FBN['UMedida'],'BBLSM|TN/MES')
        *- Recupero la Fecha de La Cuota Anterior
        If FBN['NrCuota']=1
           acd(z8,FBN['FechaOp2'])
        Else
           acd(z8,SQL("Select C.Fecha1 from "~DBO~".CUOTAS C where C.NrOperacion='"~FBN['NrOperacion']~"' and C.NrCuota="~Fstr(FBN['NrCuota']-1,0,0)~" "))    
        EndIf
        acd(e:fac, val(z8)+1)
     Else
        acd(e:fac, fbn('Fecha1')-fbn('Plazo1')+1)
     EndIf
     acd(f:fac, fbn('Fecha1'))
  EndIf
  If EqStr(fbn('TipoOp'),'DPFW')
     if EqStr(fbn('MB3'),'1') 
        act(d:fac,'Venta')
        acn(z5,1)
     endif
     if EqStr(fbn('MB3'),'0') 
        act(d:fac,'Compra')
        acn(z5,-1)
     endif
  Endif

  acn(g:fac, fbn('Cantidad'))
  acn(h:fac, fbn('Cantidad1'))

  If Incluido(fbn['TipoOp'],'DPBOD|DPOA|DPOD|DPRC|DPRRS|DPRS|DPOGA|DPOGD')
     ACN(h:FAC, FBN['Plazo1']*FBN['Cantidad'])
  EndIf
  if Incluido(fbn['TipoOp'],'DPDSO|DPDSS|DPS|DPSN|DPBOA|DPBOS|DPC|DPF')
     acn(h:fac, fbn('Cantidad1'))
  EndIf

  If val(h:fac)=0
     acn(h:fac, val(g:fac))
  EndIf

  if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
    acn(i:fac, fbn('TipoCambio2'))
  else
    if Incluido(fbn('TipoOp'),'DPRC')
       act(i:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
    else
       acn(i:fac, fbn('PrecioEj'))
    endif
  endif

  * Prima se muestra desde el origen hasta la fecha de pago de prima
  If NoVacio(FBN['FechaVto']) y FBN['FechaVto']>Dialogo.Fecha1
     acn(j:fac, fbn('TotalNetoCli1'))
  EndIf

  *--- Precio Actual Solo para Swap de Petroleo: Nafta solamente Primas
  *--- Busco el Precio con el promedio de precios de dias habiles 
  *--- Segun el valor de los contratos 
  If EqStr(FBN['TipoOp'],'DPS') 
     *- Parametros para la Fc. Curva y CurvaSim aa1: Fecha1, aa2: Fecha2, aa3: Fuente Referencia, aa4: Especie
     *- ab1: Resultado 

     acd(aa1,val(e:fac))
     acd(aa2,val(f:fac))
     act(aa3,FBN['PrecioRef'])
     act(aa4,Dialogo.Especie1)

     If Dialogo.Radio1=1
        *- Simulada  Linkeo la Hoja de la Planilla Simulada 
        (.'DCCURVASIM'.)
     Else    
        (.'DCCURVA'.)
     EndIf
     ACN(k:fac,val(ab1))  
  EndIf


  * Resultado por Barril
  If EqStr(FBN['TipoOp'],'DPS') 
     If EqStr(FBN['MB1'],'1')
        acn(l:fac,-val(k:fac)+val(i:fac))
     Else 
        acn(l:fac,val(k:fac)-val(i:fac))
     EndIf
  Else
     * Obtengo de las Operaciones en Resultado de Prima ingresado por Evento o Es la Resta de B-A
     If Dialogo.Radio1=0 
        acn(l:fac, fbn('TCComCor1'))
     Else
        acn(l:fac, fbn('TCComCor2'))
     EndIf
  EndIf

  * Resultado Operacion No Cobrado
  * Verifico si la operacion ya asigno resultado y si este aun no fue liquidado
  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     If fbn('FechaPago')>Dialogo.Fecha1       
        acn(m:fac, fbn('Precio4'))
     EndIf
  Else 
     If fbn('Fecha2')>Dialogo.Fecha1       
        acn(m:fac, fbn('Total1'))
     EndIf
  EndIf 
  
  If val(m:fac)=0
     * No calculado con anterioridad => VolTotal*Rdo. Bll - Prima
     acn(m:fac,val(h:fac)*val(l:fac)-val(j:fac))
  EndIf

  acd(n:fac,FBN['Fecha2'] )

  If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
     acd(n:fac,FBN['FechaPago'] )
  EndIf

  If Incluido(FBN['TipoOp'],'DPFW|')
     acd(n:fac,FBN['FechaVto'] )
  EndIf

  scn(w1,Val(m:fac))
  scn(w2,Val(m:fac))
  scn(w3,Val(m:fac))

  SetFont(a:fac..n:fac,2)
proximo
acn(bv3,fac)

* ultimo total cliente
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total '~Val(z7) )

  acn(m:fac, Val(w3))

  *- Guardo en bv1 Resultado para Linkear por Mark to Market Ppal
  ACN(bv1,val(m:fac))
  *----

  BorrarCeldas(w3..w3)
  AgregarMarco(a:fac..n:fac,1)
  SetFont(a:fac..n:fac,1)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
   act(a:fac,'Total Empresa '~Val(z1) )

   acn(m:fac, Val(w1))
   BorrarCeldas(w1..w1)
   AgregarMarco(a:fac..n:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..n:fac,1)
endif


BorrarCeldas(w1..w12)
AgregarMarco(a:fac..n:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..n:fac,2)

ACO(1,10)
ACO(3,19)
ACO(4,9)
ACO(5,6)
ACO(6,6)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z7, 1)
SetFont(a8..z:fac, 2)
FormatoCeldas(i7..i:fac, Exe('F7'))
FormatoCeldas(k7..l:fac, Exe('F7'))
FormatoCeldas(g7..h:fac, Exe('F2N'))
*AlinearCeldas(e:6..f:fac+1,'D')
*AlinearCeldas(j:6..m:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)

