CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites - Patrimonio Neto Bancos')
ACT(a:FAC+2, 'Fecha:')
ACD(b:FAC+2, FSys)

SetFont(a:FAC..j:FAC+2,2)

SetFilaActual(FAC+4)
ACT(a:FAC, 'Banco')
ACT(b:FAC, 'Fecha Cierre Bce.')
ACT(c:FAC, 'Pat. Neto Local')
ACT(d:FAC, 'Pat. Neto Off-Shore')
ACT(e:FAC, 'Fecha Carga')
SetFont(a:FAC..e:FAC,2)
AlinearCeldas(a:FAC..e:FAC,'C')
AgregarMarco(a:FAC..d:FAC,1,2,Exe('COLOR'))

SetFilaActual(FAC+1)
SQL.ADD("Select Codigo, RazonSocial, FechaBal, Patrimonio from "~DBO~".CLIENTES ")
recorrer SQL
  if EsTerminal(FBN['Codigo'],CLIENTE) y DesciendeDeCliente(FBN['Codigo'],'BANCOS')
    ACT(a:FAC, FBN['RazonSocial'])
    ACD(b:FAC, FBN['FechaBal'])
    if EqStr(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Codigo']),'ARG') o Vacio(BuscarCampo('CLIENTES','PaisDir','Codigo',FBN['Codigo']))
      ACN(c:FAC, FBN['Patrimonio'])
    else
      ACN(d:FAC, FBN['Patrimonio'])
    endif
    SetFont(a:FAC..d:FAC,1)
    FormatoCeldas(c:FAC..d:FAC,Exe('F0'))
  else
    DFA
  endif
proximo


ACO(1,20)
ACO(2,12)
ACO(3,12)
ACO(4,12)
ACO(5,12)

LimitesVision(d:FAC)
RangoTitulo(a:8..d:FAC,1)
