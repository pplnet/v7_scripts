    AgregarMarco(Val(co1):fac..Val(co1)+2:fac,1,0,EXE('COLOR'))
    ifa

    ACT(Val(co1):fac, 'CAP.PROM.')
    ACT(Val(co1)+1:fac, 'TASA')
    ACT(Val(co1)+2:fac, 'PLAZO')
    
    SetFont(Val(co1):fac-1..Val(co1)+2:fac,2)
    AlinearCeldas(Val(co1):fac..Val(co1)+2:fac,'C')
    
    AgregarMarco(Val(co1):fac..Val(co1):fac,1,0,0)
    AgregarMarco(Val(co1)+1:fac..Val(co1)+1:fac,1,0,0)
    AgregarMarco(Val(co1)+2:fac..Val(co1)+2:fac,1,0,0)    
    ifa
    ACN(fa1, fac)


    *-- Realizo los calculos de Consolidados ----------------------------------

    *-- Recorro los niviles basicos (las columnas C:) ---   
    Recorrer&j 23,39

      If [&j>=23 y &j<=25] o [&j>=28 y &j<=29]  o [&j>=34 y &j<=35]  o [&j>=38 y &j<=39]

       *-- Recorro los vehiculos ---   
       ACN(da2,0)
       ACN(da3,0)
       ACN(da4,0)
       ACN(da5,0)

       Recorrer&i 4, Val(co1)-1
          *--- 1ra columna de cada grupo perteneciente al capital ---       
          If 1 = (&i MOD 3)
            *--Sumatoria de Capitales ---
            SCN(da2, Val(&i:&j) )       
            *--Sumatoria de Capital * Plazo ---
            SCN(da3, (Val(&i:&j) * Val(&i+2:&j))   )       
            *--Sumatoria de Capital * tasa ---
            SCN(da4, (Val(&i:&j) * Val(&i+1:&j))  )       
            *--Sumatoria de Capital * Plazo *tasa ---
            SCN(da5, (Val(&i:&j) * Val(&i+2:&j) * Val(&i+1:&j))  )       

          Endif
       proximo

       ACN(Val(co1):&j  , Val(da2) )
       if Dialogo.Radio8 = 0
         ACN(Val(co1)+1:&j, Val(da4) / Val(da2) )    
       else
         ACN(Val(co1)+1:&j, Val(da5) / Val(da3) )    
       endif

       ACN(Val(co1)+2:&j, Val(da3) / Val(da2) )    

     Endif
   Proximo
   (.'CONSOLIDA'.) 
*-------------------------

ACO(3,9)


SetFont(d:13..Val(co1)+2:39,1)   


*---Agregar los marcos---
Recorrer&j 13,39
  If &j<>14 y &j<>17 y &j<>19 y &j<>21 y &j<>26 y &j<>30 y &j<>32 y &j<>36
    AgregarMarco(4:&j..Val(co1)+2:&j,1,3,0)
  Endif
Proximo

SetFilaActual(41)
Impresion(1,2)
LimitesVision(val(co1)+3:fac+2)
