CrearDialogo

   Fecha1: 'Desde';;;;;;;;;;FSYS-1
   Fecha2: 'Hasta';;;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error en Fechas';NO;;FSYS-1
   Radio8: 'Informacion:|Periodo|AHEAD';1;2;;;;;;;0;
   Radio1: 'Operaciones:|Todas|A Tasa|Securities';;2;;;;;;;0;
   Radio2: 'Vehiculos:|Todos|Algunos';;2;;;;;;;0;
   Radio6: 'Clientes:|Todos|Vinculados|Terceros';;2;;;;;;;0;
   Radio7: 'Especies:|Todas|Algunas';;;;;;;;;0;
   Especie1: 'Moneda:';;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "

   Check4: 'Imp.Detallado' ;;;;;;;;;;0;
   Radio3: 'Origen:|Todas|Activo|Pasivo';3;1;;;;;;;0;
   Radio4: 'Tipo Operac:|Todas|Algunos';4;1;;;;;;;0;
   Check1: 'Vto.Simple'   ;;;;Dialogo.Radio4=1;;Dialogo.Radio4=0 o [Dialogo.Radio4=1 y (Dialogo.Check1+Dialogo.Check2+Dialogo.Check3)>0];'Debe seleccionar Tipo de Informe';NO;0;
   Check2: 'Vto.Multiple' ;;;;Dialogo.Radio4=1;;;;;;0;
   Check3: 'Caja Ahorro'  ;;;;Dialogo.Radio4=1;;;;;;0;

   Lista1: "Vehiculo"     ;8;1;;Dialogo.Radio2=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Lista2: 'Especies'     ;9;1;;Dialogo.Radio7=1 ;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Lista3: 'Clientes'     ;3;2;;Dialogo.Radio6<>0;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-------------- Datos del encabezado ---------------

*AgregarBMP(a1,Var('LOGO'),Var('ESCALOGO'))

IF Dialogo.Radio8 = 0
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS') 
ELSE
   ACT(a3, 'INFORME DE COSTOS Y RENDIMIENTOS AHEAD')   
ENDIF
SetFont(a3..a3, 3)


ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))


If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio6 = 1 y NoVacio(Dialogo.Lista3)
  ACT(h6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
Else
  ACT(h6,'Clientes: TODOS' )   
endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(h7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(h7,'Especies: TODAS' )   
endif

If Dialogo.Radio1 = 0
  ACT(d5,'Operaciones: A TASA y SECURITIES ')
Else
   If Dialogo.Radio1 = 1
       ACT(d5,'Operaciones: A TASA ')
   Else
       ACT(d5,'Operaciones: SECURITIES ')
   Endif 
Endif

If Dialogo.Radio3 = 0
   ACT(d6,'Origen: ACTIVAS y PASIVAS ')
Else
   If Dialogo.Radio3 = 1
      ACT(d6,'Origen: ACTIVAS ')
   Else
      ACT(d6,'Origen: PASIVAS ')
   Endif 
Endif

If Dialogo.Radio4 = 0
   ACT(d7,'Tipo Operacion: TODAS ')
Else
   ACT(d7,'Tipo Operacion: ')
   If Dialogo.Check1 = 1
      ACT(d7, Val(d7)~'Vto.Simple - ' )
   Endif 
   If Dialogo.Check2 = 1
      ACT(d7, Val(d7)~'Vto.Multiple - ' )
   Endif 
   If Dialogo.Check3 = 1
      ACT(d7, Val(d7)~' Caja de Ahorro ' )
   Endif 
Endif

SetFont(a4..h7, 2)



*------ Nombre de Filas -------
SetFilaActual(13)
ACT(A:fac,'POSICION TOTAL NETA')
ACT(A:fac+2,'    Posicion Terceros Neta')	
ACT(A:fac+3,'    Posicion Vinculadas Neta')  
ACT(A:fac+5,'Total Activo') 
ACT(B:fac+7,'Securities') 
ACT(B:fac+9,'Totales Dep de terceros')
ACT(C:fac+10,'Multiple Vto')
ACT(C:fac+11,'Vto Unico')
ACT(C:fac+12,'Caja de Ahorro')
ACT(B:fac+14,'Totales Dep. En vinculadas')
ACT(C:fac+15,'Multiple Vto')
ACT(C:fac+16,'Vto Unico')
ACT(A:fac+18,'Total Pasivo')
ACT(B:fac+20,'Totales Dep de terceros')  
ACT(C:fac+21,'Multiple Vto')
ACT(C:fac+22,'Vto.Unico')
ACT(B:fac+24,'Totales Dep. En vinculadas') 
ACT(C:fac+25,'Multiple Vto')
ACT(C:fac+26,'Vto.Unico')
SetFont(a:fac..c:fac+26, 2)

SQL.ADD(" SELECT Codigo FROM "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ")
If NoVacio(val(zz6))
   SQL.ADD(" and Codigo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD(" ORDER BY Codigo ")

SetFilaActual(9)

ACN(fa1, fac+1)
ACN(fa2, fac+1)
ACN(co1, 1)

Recorrer SQL  

    SetFont(Val(co1):Val(fa1)..Val(co1)+2:fac,1)   
    SetFilaActual(Val(fa2))
    SCN(co1,3)
    ACT(Val(co1)+1:fac, fbn('Codigo'))
    AgregarMarco(Val(co1):fac..Val(co1)+2:fac,1,0,EXE('COLOR'))
    ifa

    ACT(Val(co1):fac, 'CAP.PROM.')
    ACT(Val(co1)+1:fac, 'TASA')
    ACT(Val(co1)+2:fac, 'PLAZO')
    
    SetFont(Val(co1):fac-1..Val(co1)+2:fac,2)
    AlinearCeldas(Val(co1):fac..Val(co1)+2:fac,'C')
    
    AgregarMarco(Val(co1):fac..Val(co1):fac,1,0,0)
    AgregarMarco(Val(co1)+1:fac..Val(co1)+1:fac,1,0,0)
    AgregarMarco(Val(co1)+2:fac..Val(co1)+2:fac,1,0,0)    

    *-- Operaciones Activas ---- 
    If Dialogo.Radio3=0  o  Dialogo.Radio3=1
       *--- Terceros ----
       If Dialogo.Radio6=0  o  Dialogo.Radio6=2
          *-- Vto. Multiple ---
          SetFilaActual(23)

          If Dialogo.Radio4=0  o Dialogo.Check2=1 

             LinkearHoja('COREN6',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
             If Dialogo.Radio8 = 0 
                 ACN(Val(co1):fac, LinkH(1, bv:1))
                 ACN(Val(co1)+1:fac, LinkH(1, bu:1))
                 ACN(Val(co1)+2:fac, LinkH(1, bw:1))
              Else
                 ACN(Val(co1):fac, LinkH(1, by:1))
                 ACN(Val(co1)+1:fac, LinkH(1, bx:1))
                 ACN(Val(co1)+2:fac, LinkH(1, bz:1))
              Endif   
              *CerrarHoja('COREN6',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
              *CerrarLink(1)
          Else 
              ACN(Val(co1):fac, 0)
              ACN(Val(co1)+1:fac,0)
              ACN(Val(co1)+2:fac, 0)
          Endif  

          *-- Vto. Simple --
          SetFilaActual(24)
          If Dialogo.Radio4=0  o Dialogo.Check1=1 
             LinkearHoja('COREN4',2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Radio6=2,Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)

              If Dialogo.Radio8 = 0 
                 ACN(Val(co1):fac, LinkH(2, bv:1))
                 ACN(Val(co1)+1:fac, LinkH(2, bu:1))
                 ACN(Val(co1)+2:fac, LinkH(2, bw:1))
              Else
                 ACN(Val(co1):fac, LinkH(2, by:1))
                 ACN(Val(co1)+1:fac, LinkH(2, bx:1))
                 ACN(Val(co1)+2:fac, LinkH(2, bz:1))
              Endif   
              *CerrarHoja('COREN4',2,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
              *CerrarLink(2)
          Else 
              ACN(Val(co1):fac, 0)
              ACN(Val(co1)+1:fac,0)
              ACN(Val(co1)+2:fac, 0)
          Endif  

          *-- Ajuste a tasa Ops de Vto.Simple con FXVT en USD --
          SetFilaActual(24)
          * Todos los T.Op o Vto.simple
          If Dialogo.Radio4=0  o Dialogo.Check1=1 
            * Por Periodo
            If Dialogo.Radio8 = 0 
              * Todas Ops. o a Tasa
              If Dialogo.Radio1=0  o Dialogo.Radio1=1 
                * Todas las especies o USD
                If Dialogo.Radio7=0  o EqStr(Pipe2Coma(Dialogo.Lista2),'USD,') 
                  LinkearHoja('COREN9',10,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Check4=Dialogo.Check4)
                  ACN(xx98, LinkH(10, x:98))
                  ACN(xx99, LinkH(10, x:99))
                  ACN(xx97, (((Val(Val(co1):fac)-Val(xx98))*Val(Val(co1)+1:fac))+(Val(xx98)*(Val(Val(co1)+1:fac)+Val(xx99))))/Val(Val(co1):fac)   )
                  ACN(Val(co1)+1:fac, Val(xx97))
                  *CerrarHoja('COREN9',10,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Check4=Dialogo.Check4)
                  *CerrarLink(10)
                Endif
              Endif
            Endif
          Endif  

          *-- Caja de Ahorro --
          SetFilaActual(25)
          If Dialogo.Radio4=0  o Dialogo.Check3=1 
             LinkearHoja('COREN8',3,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
             If Dialogo.Radio8 = 0 
                ACN(Val(co1):fac, LinkH(3, bv:1))
                 ACN(Val(co1)+1:fac, LinkH(3, bu:1))
                 ACN(Val(co1)+2:fac, LinkH(3, bw:1))
              Else
                 ACN(Val(co1):fac, LinkH(3, by:1))
                 ACN(Val(co1)+1:fac, LinkH(3, bx:1))
                 ACN(Val(co1)+2:fac, LinkH(3, bz:1))
              Endif   
              *CerrarHoja('COREN8',3,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
              *CerrarLink(3)
          Else 
              ACN(Val(co1):fac, 0)
              ACN(Val(co1)+1:fac,0)
              ACN(Val(co1)+2:fac, 0)
          Endif  
       Endif


       *--- Vinculados ----
       If Dialogo.Radio6=0  o  Dialogo.Radio6=1
          *-- Vto. Multiple ---
          SetFilaActual(28)
          If Dialogo.Radio4=0  o Dialogo.Check2=1 
             LinkearHoja('COREN6',4,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3) 
             If Dialogo.Radio8 = 0 
                 ACN(Val(co1):fac, LinkH(4, bv:1))
                 ACN(Val(co1)+1:fac, LinkH(4, bu:1))
                 ACN(Val(co1)+2:fac, LinkH(4, bw:1))
