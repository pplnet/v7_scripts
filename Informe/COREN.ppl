              *CerrarLink(4)
          Else 
              ACN(Val(co1):fac, 0)
              ACN(Val(co1)+1:fac,0)
              ACN(Val(co1)+2:fac, 0)
          Endif  

          *-- Vto. Simple --
          SetFilaActual(29)
          If Dialogo.Radio4=0  o Dialogo.Check1=1     
              LinkearHoja('COREN4',5,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
              If Dialogo.Radio8 = 0 
                 ACN(Val(co1):fac, LinkH(5, bv:1))
                 ACN(Val(co1)+1:fac, LinkH(5, bu:1))
                 ACN(Val(co1)+2:fac, LinkH(5, bw:1))
