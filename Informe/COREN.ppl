              *CerrarLink(5)
          Else 
              ACN(Val(co1):fac, 0)
              ACN(Val(co1)+1:fac,0)
              ACN(Val(co1)+2:fac, 0)
          Endif  
       Endif

    Endif


    *-- Operaciones Pasivas ---- 
    If Dialogo.Radio3=0  o  Dialogo.Radio3=2
       *--- Terceros ----
       If Dialogo.Radio6=0  o  Dialogo.Radio6=2
          *-- Vto. Multiple ---
          SetFilaActual(34)
          If Dialogo.Radio4=0  o Dialogo.Check2=1     
              LinkearHoja('COREN6',6,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=2,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
              If Dialogo.Radio8 = 0 
