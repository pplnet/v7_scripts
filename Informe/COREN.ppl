              LinkearHoja('COREN4',7,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio6=2,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Radio3=2,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
