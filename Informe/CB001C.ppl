        ACT(A:2, 'Asiento Nro: '~Dialogo.NrUnicoAsiento1)
    ELSE
        ACT(a:2, 'Asientos Generados por Fecha' )
        ACT(a:4, 'Desde Fecha Generacion: '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
        ACT(a:5, 'Desde Fecha Ejecucion: '~Dialogo.Fecha5~' al '~Dialogo.Fecha6)
        ACT(a:6, 'Desde Fecha Valor: '~Dialogo.Fecha3~' al '~Dialogo.Fecha4)
        act(A:7, 'Asiento Modelo: ' ~Dialogo.ModeloAsiento1 )  
    ENDIF
ENDIF


