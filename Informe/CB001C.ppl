message('Recuperando Asientos...')

SQL.ADD(" SELECT A1.NrUnicoAsiento,A1.Especie1, A1.Cantidad1,A1.Especie2, A1.Cantidad2, A1.Especie3, A1.Cantidad3, A1.Alias2, A1.NrItem, A1.Alias4, A1.Alias5, A1.Alias6, ")
SQL.ADD(" A1.Alias7, A1.Valor1, A1.Valor3, A1.Cuenta, A1.DebitoCredito, ")
SQL.ADD(" A.FechaGeneracion, A.Libro, A.FechaValor, A.Modelo, E.Cotiza, A.NrOperacion, A.NrAsiento, M.TipoAsiento,M.TipoOp TipOp, ")
***///SQL.ADD(" A.Fecha1, A.Estado, A.Fecha2, M.Descripcion, A.Vehiculo, M.Codigo, C.Codigo, C.PaisDir ")
SQL.ADD(" A.Fecha1, A.Estado, A.Fecha2, M.Descripcion, A.Vehiculo, M.Codigo, C.Codigo, C.PaisDir, CAST(A1.NrItem as INT) NrItem ")
SQL.ADD(" FROM  "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A,"~DBO~".ESPECIES E, "~DBO~".MODELOSASIENTO M, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE A1.NrUnicoAsiento = A.NrUnicoAsiento ")


SQL.ADD("   and A1.Alias7   = E.Codigo ")
SQL.ADD("   and A.Modelo    = M.Codigo ")
SQL.ADD("   and A1.Alias2   = C.Codigo ")
IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    IF NoVacio(Dialogo.NrUnicoAsiento1)
       SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
    ENDif 
ELSE
    IF NoVacio(Dialogo.NrUnicoAsiento1)
       SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
    ELSE
       SQL.ADD("   and A.FechaGeneracion>= "~IdxDate2(Dialogo.Fecha1))
       SQL.ADD("   and A.FechaGeneracion<= "~IdxDate2(Dialogo.Fecha2))
       SQL.ADD("   and A.FechaValor>= "~IdxDate2(Dialogo.Fecha3))
       SQL.ADD("   and A.FechaValor<= "~IdxDate2(Dialogo.Fecha4))
           If Dialogo.Check1=1
               SQL.ADD("   and A.Fecha1>= "~IdxDate2(Dialogo.Fecha5))
               SQL.ADD("   and A.Fecha1<= "~IdxDate2(Dialogo.Fecha6))
           Endif
     ENDIF
ENDIF
IF NoVacio(Dialogo.ModeloAsiento1)
  SQL.ADD(" and A.Modelo     =  '"~Dialogo.ModeloAsiento1~"' ")  
ENDIF
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and A.Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   If NoVacio(Dialogo.Vehiculo1)
       SQL.ADD("and A.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~") ")
   EndIf
EndIf
If NoVacio(Dialogo.CuentaContable1)
  SQL.ADD("and A1.Cuenta =  '"~Dialogo.CuentaContable1~"' ")
Endif
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" and (A1.Alias7 IN ("~Pipe2Comillas(Descendientes('ESPECIES', Dialogo.Especie1))~") OR A1.Alias7 = '"~Dialogo.Especie1~"') AND A1.Alias7 <> '' ") 
EndIf
If NoVacio(Dialogo.TipoOp1)
  SQL.ADD(" and M.TipoOp = '"~Dialogo.TipoOp1~"'")
EndIf
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and A1.Alias2 = '"~Dialogo.Cliente1~"'")
EndIf
If Dialogo.Radio2 = 0
  SQL.ADD(" and C.PaisDir = 'ARG' ")
Else
  If Dialogo.Radio2 = 1
    SQL.ADD(" and C.PaisDir <> 'ARG' ")
  EndIf
EndIf
IF Dialogo.Radio1 = 0
    SQL.ADD(" AND A.Estado IN ('E','COE','NCE','REE') ")
ELSE
    IF Dialogo.Radio1 = 1
        SQL.ADD(" AND (A.Estado Not IN ('E','COE','NCE','REE') OR A.Estado Is Null OR A.Estado = '' OR A.Estado = ' ') ")
    ENDIF
ENDIF
***///SQL.ADD(" ORDER By A.FechaGeneracion, M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.Alias3, A1.Especie1 ")
SQL.ADD(" ORDER By A.FechaGeneracion, M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.NrItem, A1.Especie1 ")

ACT(as:1, '')
ACT(mn:1, '')
ACN(fi:1, fac)

Recorrer SQL
   IF fbn('FechaGeneracion') <> Val(FE:1)
      IF Val(FE:1) > 0
          ACT(A:fac, 'Cantidad de Asientos: '~Fstr(Val(TF:1), 0, 0))
          AgregarMarco(A:fac..Z:fac, 0, 0, Exe('COLOR8'))
          SetFont(A:fac, 2)
          SetFilaActual(fac+2)
      ENDIF
      ACT(A:fac, 'FechaGeneracion: '~Fecha(fbn('FechaGeneracion')))
      SetFont(A:fac, 2)
      AgregarMarco(A:fac..Z:fac, 0, 0, Exe('COLOR8'))
      ACN(TF:1, 0)
   ENDIF
   If Not Eqstr(Val(as:1), fbn('NrUnicoAsiento'))
      ifa
      ACT(a:fac, fbn('Descripcion'))
      IF Vacio(fbn('Estado'))
          ACT(A:fac, Val(A:fac)~' - (Asiento Sin Enviar)')
           IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF
                  ENDIF
              ENDIF
           ENDIF
      ENDIF
      IF Eqstr(fbn('Estado'), 'E')
          ACT(A:fac, Val(A:fac)~' - (Asiento Enviado)')
          IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF 
                  ENDIF
              ENDIF
          ENDIF
      ENDIF 
      IF Eqstr(fbn('Estado'), 'COT')
          ACT(A:fac, Val(A:fac)~' - (ContraAsiento Sin Enviar del Asiento '~fbn('NrAsiento')~')')
      ELSE
          IF Eqstr(fbn('Estado'), 'COE')
              ACT(A:fac, Val(A:fac)~' - (ContraAsiento Enviado del Asiento '~fbn('NrAsiento')~')')
          ELSE
              IF Eqstr(fbn('Estado'), 'NC')
                  ACT(A:fac, Val(A:fac)~' - (Nota de Credito sin Enviar del Asiento '~fbn('NrAsiento')~')')
              ELSE
                  IF Eqstr(fbn('Estado'), 'NCE')
                      ACT(A:fac, Val(A:fac)~' - (Nota de Credito Enviada del Asiento '~fbn('NrAsiento')~')')
                  ELSE
                      IF Eqstr(fbn('Estado'), 'REV')
                          ACT(A:fac, Val(A:fac)~' - (Reversa Sin Enviar del Asiento '~fbn('NrAsiento')~')')
                      ELSE
                          IF Eqstr(fbn('Estado'), 'REE')
                              ACT(A:fac, Val(A:fac)~' - (Reversa Enviada del Asiento '~fbn('NrAsiento')~')')
                          ENDIF
                      ENDIF
                  ENDIF
              ENDIF
          ENDIF
      ENDIF
      SetFont(a:fac..z:fac, 2)
      IFA
      SCN(TF:1, 1)
   Endif

   ACT(a:fac, FECHA(fbn('FechaGeneracion'))~' - '~FECHA(fbn('Fecha1')))
   ACD(b:fac, fbn('FechaValor'))
   ACT(c:fac, fbn('Cuenta')~' - '~BuscarCampo('CONTABILIDAD','Nombre','Codigo', fbn('Cuenta')))

   ACT(d:fac, fbn('Especie1'))
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(e:fac, fbn('Cantidad1'))
   Else
      ACN(f:fac, fbn('Cantidad1'))
   Endif

   ACT(g:fac, fbn('Especie2'))
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(h:fac, fbn('Cantidad2'))
   Else
      ACN(i:fac, fbn('Cantidad2'))
   Endif
   
   ACT(j:fac, fbn('Especie3'))
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(k:fac, fbn('Cantidad3'))
   Else
      ACN(l:fac, fbn('Cantidad3'))
   Endif

   ACT(m:fac,  fbn('Alias6'))
   ACN(n:fac,  fbn('Valor1'))
 
   ACT(o:fac,  fbn('Modelo'))
   ACL(o:fac, 'INV005',String=fbn('Modelo'))
   ACT(p:fac,  fbn('NrUnicoAsiento'))
   ACT(q:fac,  fbn('NrItem'))
   ACT(r:fac,  fbn('NrOperacion'))
   ACLO(r:fac, fbn('NrOperacion'))

   ACT(s:fac,  fbn('Libro'))
   ACT(t:fac,  fbn('Alias4'))
   ACT(u:fac,  fbn('Alias2'))   
   ACT(v:fac,  FBN['TipOp'])   
   ACT(w:fac,  IIF(Eqstr(BuscarCampo('CLIENTES','PaisDir','Codigo', fbn('Alias2')), 'ARG'), 'SI', 'NO') )
   ACT(x:fac,  FBN['Alias7'])
   ACT(y:fac,  FBN['Vehiculo'])
   ACT(z:fac,  FBN['Valor3'])

   If NoVacio(Dialogo.CuentaContable1)
     SCN(dt:1, Val(e:fac))
     SCN(ct:1, Val(f:fac))
     SCN(dt:2, Val(h:fac))
     SCN(ct:2, Val(i:fac))
     SCN(dt:3, Val(k:fac))
     SCN(ct:3, Val(l:fac))       
     ACN(bd:2, 1)
   EndIf

   ACT(as:1, fbn('NrUnicoAsiento'))
   ACT(mn:1, fbn('Especie1'))
   ACD(FE:1, fbn('FechaGeneracion'))
   SetFont(a:fac..z:fac, 1)
   AlinearCeldas(D:fac..Z:fac+1, 'C')
