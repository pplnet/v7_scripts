MostrarCuadrodeMensajes
CrearDialogo
   Fecha1:    'Fecha Pago'   ;1;;;;;;;;fsys
   Especie1:  'Especie'      ;2;;;;;;;;
   Entero1:   'Cupon'        ;3;;;;;;;;0
   Especie2:  'Moneda'       ;4;;;;;Vacio(Dialogo.Especie2) o [DesciendeDeEspecie(Dialogo.Especie2, 'MONEDA') y EsTerminal(Dialogo.Especie2, Especie)];'Moneda Invalida';NO;;;;;;"Status = 'HAB' AND Tipo = 'MON' "
   Vehiculo1: 'Vehiculo'     ;1;2;;;;;;;VAR('VEHICULODE')
FinDialogo

IF NOT OK
   Cancelar
Endif
 
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:2, 'Depositos de Fondos en Cuentas Custodia - '~Dialogo.Fecha1)
ACT(a:4, 'Especie:  '~iif(novacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(a:5, 'Cupon:    '~iif(Dialogo.Entero1>0,fstr(Dialogo.Entero1,0,0),'Todos'))
ACT(a:6, 'Moneda:   '~iif(novacio(Dialogo.Especie2),Dialogo.Especie2,'Todas'))
ACT(a:7, 'Vehiculo: '~iif(novacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
SetFont(a:4..a:7,2)
SetFont(a:2,3)

SetFilaActual(9)


ACT(a:fac, 'Cliente')
ACT(b:fac, 'Especie')
ACT(b:fac+1, 'Corte')
ACT(c:fac, 'Cupon')
ACT(d:fac, 'Fecha')
ACT(d:fac+1, 'Movimiento')
ACT(e:fac, 'Cuenta')
ACT(f:fac, 'Cantidad')
ACT(g:fac, 'Deposito')
ACT(h:fac, 'Pago de ')
ACT(h:fac+1, 'Cupon')
ACT(i:fac+1, 'Vehiculo')
SEtFont(a:fac..z:fac+1, 2)
AlinearCeldas(a:fac..z:fac+1, 'C')
AgregarMarco(a:fac..i:fac+1,1,0,EXE('COLOR6'))

SQL.ADD(" SELECT T.Cantidad1, T.Cliente1, C.RazonSocial, T.Especie Moneda, T.Cuenta1, T.Vehiculo1, T.Fecha1, ")
SQL.ADD(" TC.NrTrans TransCupon, T.NrTrans, T.TipoTr2, TC.Especie, TC.Cupon1, E.Nombre    ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T,  "~DBO~".TRANSACCIONES2 TC, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  T.NrOperacionRef2 = TC.NrTrans ")
SQL.ADD(" AND    T.Cliente1        = C.Codigo   ")
SQL.ADD(" AND    TC.Especie        = E.Alias9   ")
SQL.ADD(" AND    TC.TipoTr2        = 'LCUPON'   ")
SQL.ADD(" AND    T.Fecha1          = "~Idxdate2(Dialogo.Fecha1)~" ")
IF Dialogo.Entero1>0
   SQL.ADD(" AND  TC.Cupon1 = "~fstr(Dialogo.Entero1,0,0)~" ")
Endif
IF NOVACIO(Dialogo.Especie2)
   SQL.ADD(" AND  T.Especie = '"~Dialogo.Especie2~"' ")
Endif
IF NOVACIO(Dialogo.Especie1)
   SQL.ADD(" AND  E.Codigo  = '"~Dialogo.Especie1~"' ")
Endif
IF NOVACIO(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
sql.add(" ORDER BY T.Especie, T.Cliente1, T.Fecha1, TC.Especie, TC.Cupon1 ")
ACT(ma:1, '')
ACT(cl:1, '')
Recorrer SQL
  If NOT EQSTR(fbn('Moneda'), Val(ma:1))
     ifa
     ACT(a:fac, 'Moneda: '~fbn('Moneda'))
     message(Val(a:fac))
     SEtFont(a:fac..z:fac, 2)
     AgregarMarco(a:fac..i:fac,1,1)
     ifa
  Endif
  ACT(a:fac, Copy(fbn('RazonSocial'),1,25))
  ACT(b:fac, fbn('Nombre'))
  ACN(c:fac, fbn('Cupon1'))
  ACD(d:fac, fbn('Fecha1'))
  ACT(e:fac, fbn('Cuenta1'))
  ACN(f:fac, fbn('Cantidad1'))
  ACT(g:fac, fbn('NrTrans'))
  ACLT(g:fac, fbn('NrTrans'))
  ACT(h:fac, fbn('TransCupon'))
  ACLT(h:fac, fbn('TransCupon'))
  ACT(i:fac, fbn('Vehiculo1'))

  ACT(ma:1, fbn('Moneda'))
  ACT(cl:1, fbn('Cliente1'))
  SEtFont(a:fac..z:fac, 1)
Proximo

FormatoCeldas(f:9..f:fac, EXE('F2'))
FormatoCeldas(c:9..c:fac, EXE('F0'))

IFA
IFA
IFA
ACT(a:fac, 'Fin del Informe.')
SEtFont(a:fac, 2)

ACO(1,15)
ACO(2,8)
ACO(3,5)
ACO(4,8)
ACO(5,8)
ACO(6,8)
ACO(7,8)
ACO(8,8)
ACO(9,8)

SetPrintFit(3,90)
LimitesVision(i:fac+2)
SetMargins(0,0,0,2)
Impresion(4,1)
