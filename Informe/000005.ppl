*- Dada una tasa de referencia existente en tipos tasas Ej: LIUS1Y Libor en usd de 
*- un año calculo 
*- ESTA INTERPOLACION ES PARA PLAZOS MENORES A UN ANIO
ModoReproceso(SinDialogo)
CrearDialogo
 String1  : 'PrecioRef' ;;;;;;;;;'LIBO';;;;;;;;;;;;
 Fecha1   : 'Fecha'     ;;;;;;Dialogo.Fecha1<>0;'Ingrese una fecha de valuacion';NO;Fsys;
 Fecha2   : 'aInterpolar'   ;;;;;;Dialogo.Fecha1<>0;'Ingrese una fecha de valuacion';NO;Fsys+69;
FinDialogo

If no ok
   Cancelar
EndIf

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')


ACT(a1, 'INTERPOLACION DE TASAS (Corto Plazo) al '~Dialogo.Fecha1~' de '~Dialogo.String1)

ACT(a3, 'TipoTasa')
ACT(b3, 'Fecha ')
ACT(c3, 'ti(0,s)')
ACT(d3, 's ')
ACT(e3, 'FD(t,s)')
ACT(f3, 'FD ('~Dialogo.Fecha2~')')
ACT(g3, 'FDt-1/FDt -1')
ACT(h3, 'TasaImplicita')


SetFont(a1..z3,1)
AlinearCeldas(a3..h3, 'C')
AgregarMarco(a3..h3,2,0,Exe('COLOR6'))

SQL.ADD("Select TD.*,TT.DayCount from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT Where ")
SQL.ADD("TD.TipoTasa=TT.Codigo  and TT.PrecioRef='"~Trim(Mirt(Dialogo.String1))~"' AND")
SQL.ADD("TD.Fecha IN ")
SQL.ADD("( ")
SQL.ADD("Select Max(TD1.Fecha) from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 Where ")
SQL.ADD("TD1.TipoTasa=TT1.Codigo  and TT1.PrecioRef='"~Trim(Mirt(Dialogo.String1))~"' AND")
SQL.ADD("TD1.Fecha<='"~IdxDate(Dialogo.Fecha1)~"' AND TD1.TipoTasa=TD.TipoTasa AND")
SQL.ADD("TD1.PlazoHasta=TD.PlazoHasta AND TD1.PlazoDesde=TD.PlazoDesde and TD1.Especie=TD.Especie and TD1.PlazoHasta<=365")
SQL.ADD("GROUP BY TD1.TipoTasa  ")
SQL.ADD(") ORDER BY TD.PlazoHasta")
ACN(x1,0)

SetFilaActual(4)

ACN(z3,3)

ACT(a:fac,'Hoy')
ACD(b:fac,Dialogo.Fecha1)
SetFont(a:fac..b:fac,1)

*-- Recorrer valores
Recorrer SQL
   SCN(x1,1)

   ACT(a:fac,FBN['TipoTasa'])

   Message(val(a:fac))
  
   IF EqStr(FBN['DayCount'],'ACT')
      acn(dc1,0)
   EndIf
   IF EqStr(FBN['DayCount'],'365')
      acn(dc1,1)
   EndIf
   IF EqStr(FBN['DayCount'],'36A')
      acn(dc1,2)
   EndIf
   IF EqStr(FBN['DayCount'],'360')
      acn(dc1,3)
   EndIf
   IF EqStr(FBN['DayCount'],'30E')
      acn(dc1,4)
   EndIf

   *- Segun el plazo, fijo la fecha de vto
   IF Dia(Dialogo.Fecha1+FBN['PlazoHasta'])=Dia(Dialogo.Fecha1) o FBN['PlazoHasta']<=14
      ACD(fl2,Dialogo.Fecha1+FBN['PlazoHasta'] )
   Else    

      acn(di1,Dia(Dialogo.Fecha1))
      acn(me1,Mes(Dialogo.Fecha1+FBN['PlazoHasta']))
      acn(an1,Anio(Dialogo.Fecha1+FBN['PlazoHasta']))

      Repetir 
         ACT(fl1,Pad0(FSTR(val(di1),0,0),2)~'/'~Pad0(FSTR(val(me1),0,0),2)~'/'~Pad0(FSTR(val(an1),0,0),2) )
         ACD(fl2,Fecha(val(fl1)) )
         ACT(fl3,val(fl2))

         IF EqSTr(Copy(val(fl3),1,2),'00')
            *- Fecha invalida, busco el siguiente dia 
            scn(di1,1)
            If val(di1)>31
               acn(di1,1)               
               scn(me1,1)               
            EndIf
            If val(me1)>12            
               acn(me1,1)               
               scn(an1,1)               
            EndIf
         Else 
            Break
         EndIf
      Proximo
   EndIf

   ACD(b:fac,val(fl2))
   ACN(c:fac,FBN['Valor1'])

   *- s: Fecha de Vto - FechadeVAluacion/DayCount
   ACN(d:fac,(val(b:fac)-Dialogo.Fecha1)/IIF(val(dc1)>1,360,365))

   *- Cálculo de factores de descuentos para plazos con cotización => Verificar cual de las dos usar
   *- Dejo la del excel para que den igual los calculos 
   *---e:fac segun formula de Carolina
   ACN(e:fac,(1+(val(c:fac)/100))^-val(d:fac))

   *---e:fac segun formula del excel de ejemplo FD(t,s1/12) : =+(1+'datos ingresados al sistema'!E14*'datos ingresados al sistema'!D14)^-1
   ACN(e:fac,(1+val(c:fac)*val(d:fac)/100)^-1)


   If val(x1)>1
      ACN(g:fac,val(e:fac-1)/val(e:fac) -1 )
      ACN(h:fac,(val(g:fac)/(val(d:fac)-val(d:fac-1)))*100 )
   EndIf
   *- Para la fecha 2 calculo los factores de descuentes intermedios
   IF Dialogo.Fecha2>val(b:fac-1) y Dialogo.Fecha2<=val(b:fac)  
      ACN(f:fac,(val(d:fac)-(Dialogo.Fecha2-Dialogo.Fecha1)/IIF(val(dc1)>1,360,365))/(val(d:fac)-val(d:fac-1))*val(e:fac-1)+((Dialogo.Fecha2-Dialogo.Fecha1)/360-val(d:fac-1))/(val(d:fac)-val(d:fac-1))*val(e:fac)) 


      *- z1: Para linkear valor
      ACN(z1,val(f:fac))
      *- z2: Para linkear tasa implicita
      ACN(z2,val(h:fac))
   EndIf


   SetFont(a:fac..h:fac,2)
Proximo
FormatoCeldas(c1..h:fac, Exe('F8'))
FormatoCeldas(h1..h:fac, Exe('F2'))

ACO(1,10)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
*- Primer y Ultima Fila a Listar
ACN(aa1,4)
ACN(aa2,fac)
LimitesVision(h:fac)


