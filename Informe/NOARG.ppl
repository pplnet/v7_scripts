ModoReproceso(SinDialogo)

CrearDialogo
    Fecha1:'Fecha Liq:';1;;;;;NoVacio(Dialogo.Fecha1);'Ingrese una fecha';NO;FSys;
    Lista1:'Tipos Op.' ;3;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo in ('TIC','TIV','TIFC','TIFV') ")
    Mercado1 :'Mercado'    ; ;;;;;NoVacio(Dialogo.Mercado1);'Debe ingresar un Mercado';NO;VAR('MERNETEODE');;;;;" NETEA='SI' " 
FinDialogo

If Not Ok
 Cancelar
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)

**-- Encabezado --**
ACT(a:FAC, 'Neteo - Operaciones No Confirmadas '~Dialogo.Mercado1)
SetFont(a:1..a:FAC, 3)

ACT(a:FAC+2, 'Fecha Liq.: '~Dialogo.Fecha1)

If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+3, 'Tipo Op: '~Pipe2Comillas(Dialogo.Lista1))
Else
   ACT(a:FAC+3, 'Tipo Op: Todas')
Endif

ACN(fa1, FAC+4)

SetFont(a:FAC+2..b:FAC+4, 2) 
SetFilaActual(6)

ACT(a:FAC, 'Nro.Oper.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'Boleto')
ACT(d:FAC, 'Cliente')
ACT(e:FAC, 'Fecha Op.')
ACT(f:FAC, 'Fecha Vto.')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cantidad')
ACT(i:FAC, 'Cont.Esp.')
ACT(j:FAC, 'Precio')
ACT(k:FAC, 'Monto')
ACT(l:FAC, 'Int. Corr.')
ACT(m:FAC, 'Neto')
ACT(n:FAC, 'Pendiente')

SetFont(a:FAc..t:FAC, 2)
AgregarMarco(a:FAC..t:FAC, 2,0,Exe('COLOR6'))
AlinearCeldas(a:FAC..d:FAC, 'I')
AlinearCeldas(h:FAC..h:FAC, 'D')
AlinearCeldas(e:FAC..g:FAC, 'C')
AlinearCeldas(i:FAC..i:FAC, 'C')
AlinearCeldas(j:FAC..n:FAC, 'D')

SetFilaActual(FAC)

SQL.ADD("select E.Jerarquia, M.Especie, Sum(M.Cantidad) as Cant,E.CodMAEContado ")
SQL.ADD(" from  "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where M.NrOperacion = O.NrOperacion ")
SQL.ADD("  and  M.NrOperacion = B.NrOperacion ")
SQL.ADD("  and  M.Cliente     = O.Cliente1 ")
SQL.ADD("  and  M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"'                             ")  
SQL.ADD("  and  M.NrSaldo     = 31 ")
SQL.ADD("  and  E.Codigo      = M.Especie ")
SQL.ADD("  and  B.Valor       = '1' ")
if NoVacio(Dialogo.Lista1)
 SQL.ADD("  and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
else
 SQL.ADD("  and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV') ")
endif
SQL.ADD("group by E.Jerarquia, M.Especie,E.CodMAEContado ")
SQL.ADD("order by E.Jerarquia, M.Especie ")

Recorrer SQL
    ACT(ce1, FBN['Especie'])
    **-- Rotulo de Total por Especie
    If FBN['Cant'] > 0
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~') :')
       ACN(c:FAC, ABS(FBN['Cant']))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Else
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~') :')
       ACN(c:FAC, ABS(FBN['Cant']))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Endif
    ACN(fi1, FAC)
    FormatoCeldas(c:fac..c:fac,EXE('F2'))

    **-- Seleccion de las operaciones que involucran el total, segun los parametros --**
    SQL.ADD("select O.TipoOp, O.NrOperacion, O.NrBoleto, O.Cliente1, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, O.Precio1, O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.Cuenta1, U.Nombre NomCta, R.Descripcion, C.RazonSocial, E.Jerarquia, ")
    SQL.ADD("C.NrMAE,M.Cantidad as CantMov, M.Especie as EspeMov,M.NrMov,E1.InteresesC ")
    SQL.ADD(" from  "~DBO~".ESPECIES E, "~DBO~".ESPECIES E1,"~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O left outer join "~DBO~".CUENTAS U on O.Cuenta1  = U.Codigo, "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo ")
    SQL.ADD("  and  O.Especie     = E1.Codigo ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
    SQL.ADD("  and  O.Mercado     = R.Codigo ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo ")
    SQL.ADD("  and  M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"'  ")  
    SQL.ADD("  and  M.NrSaldo     = 31")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"' ")
*   Ahora las operaciones ya no están en liquidación, sino en terminal (instancia 70).    
*   SQL.ADD("  and  B.NrBit       = 10 ")
    SQL.ADD("  and  B.Valor       = '1' ")
    if NoVacio(Dialogo.Lista1)
     SQL.ADD("  and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    else
     SQL.ADD("  and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV') ")
    endif
    SQL.ADD("order by E.Jerarquia, O.Mercado, O.Especie, O.NrOperacion ")

    Recorrer SQL
        ACT(a:Val(fa1), 'Cuenta: '~FBN['Cuenta1']~' - '~FBN['NomCta'])
        SetFont(a:Val(fa1)..b:Val(fa1), 2)
 
        **-- Linea de Detalle  
        ACT(a:FAC, FBN['NrOperacion'])
        ACLO(a:FAC, FBN['NrOperacion'])
        ACT(b:FAC, FBN['TipoOp'])
        ACT(c:FAC, FBN['NrBoleto'])
        ACT(d:FAC, FBN['Cliente1']~' - '~Copy(FBN['RazonSocial'],1,25)~' Nro.MAE '~FBN['NrMAE'])
        ACD(e:FAC, FBN['FechaOp'])
        ACD(f:FAC, FBN['FechaVto'])
        ACT(g:FAC, FBN['Especie'])
        ACN(h:FAC, FBN['Cantidad'])
        ACT(i:FAC, FBN['ContraEspecie'])
        ACN(j:FAC, FBN['Precio1'])


        If FBN['NrMov']<>1000
           ACN(k:FAC, FBN['TotalBrutoCli1'])

           IF EqStr(FBN['InteresesC'],'CLE')
              ACN(l:FAC, FBN['TotalIntereses'])
           EndIf

           ACN(m:FAC, FBN['TotalNetoCli1'])
        Else 
            ACN(m:FAC, FBN['CantMov'])
        EndIf
        ACN(n:FAC, -FBN['CantMov'])
                
        If DesciendedeEspecie(Val(ce1), 'MONEDA')
           If Incluido(FBN['TipoOp'], 'TIC|TIFC')
              *SCN(tc1, VAL(m:fac))
              SCN(tc1, VAL(n:fac))
           Else
              *SCN(tp1, VAL(m:fac))
              SCN(tp1, VAL(n:fac))
           Endif
        Else
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') 
              *SCN(tc2, VAL(h:fac))
              SCN(tc2, VAL(n:fac))
           Else
              *SCN(tp2, VAL(h:fac))
              SCN(tp2, VAL(n:fac))
           Endif
        Endif

        SetFont(a:FAC..m:FAC, 1)
        SetFont(n:FAC..n:FAC, 2)
        AlinearCeldas(e:FAC..g:FAC, 'C')
        AlinearCeldas(i:FAC..i:FAC, 'C')
        FormatoCeldas(h:fac..h:fac,EXE('F2'))
        FormatoCeldas(k:fac..n:fac,EXE('F2'))
        FormatoCeldas(j:fac..j:fac,EXE('F6'))
     Proximo
     IFA
     *--Impresion de totales por Especie
     If DesciendedeEspecie(Val(ce1), 'MONEDA')
        ACT(e:Val(fi1),'Total a Pagar '~Val(ce1)~': ')
        ACN(h:Val(fi1), Val(tc1))
        ACT(j:Val(fi1),'Total a Cobrar '~Val(ce1)~': ')
        ACN(l:Val(fi1), Val(tp1))
     Else
        ACT(e:Val(fi1),'Total a Entregar '~Val(ce1)~': ')
        ACN(h:Val(fi1), Val(tp2))
        ACT(j:Val(fi1),'Total a Recibir '~Val(ce1)~': ')
        ACN(l:Val(fi1), Val(tc2))
     Endif

     SetFont(a:Val(fi1)..o:Val(fi1),2)
     FormatoCeldas(h:Val(fi1)..h:Val(fi1),EXE('F2'))
     FormatoCeldas(h:Val(fi1)..l:Val(fi1),EXE('F2'))
     
     ACN(tc1, 0)
     ACN(tp1, 0)
     ACN(tc2, 0)
     ACN(tp2, 0)
Proximo
IFA

*-- Ajuste de celdas
ACO(1,7)
ACO(2,5)
ACO(3,9)
ACO(4,50)
ACO(5,6)
ACO(6,6)
ACO(7,5)
ACO(8,10)
ACO(9,5)
ACO(10,7)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)

Impresion(1,2)
SetPrintFit(3,80)
SetFilaActual(FAC+3)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(n:fac)
RangoTitulo(a:1..n:FAC, 6)






