ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  : 'Fecha Desde'   ;;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;PriDeMes(FSys,SI);PriDeMes(DIALOGO.FECHA2,SI)
  Fecha2  : 'Fecha Hasta'   ;;;;;;NoVacio(Dialogo.Fecha2);'Debe ingresar la Fecha Hasta';NO;FinDeMes(FSys,SI);FinDeMes(DIALOGO.FECHA1,SI)
  Cliente1: 'Cliente'       ; ;;;;;Vacio(Dialogo.Cliente1) o EsTerminal(Dialogo.Cliente1,Clientes);'Cliente incorrecto';NO;;;;;;;;;
FinDialogo
if Not OK
  Cancelar
endif

if NoVacio(Dialogo.Cliente1)
  if EsTerminal(Dialogo.Cliente1,Clientes)
    ACT(v1, Dialogo.Cliente1)
  else
    Cancelar('Cliente no vßlido')
  endif 
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')


SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC, 'Control de Limites de Fraccionamiento (BCRA) - Mensual')
ACT(a:FAC+2, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif

SetFont(a:FAC..n:FAC+3,2)

ACT(s:FAC, 'Control de Limites de Fraccionamiento (BCRA) - Mensual')
ACT(s:FAC+2, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
  ACT(s:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(s:FAC+3, 'Cliente : Todos')
endif

SetFont(s:FAC..s:FAC+3,2)


ACN(al:fac, BuscarCampo('CLIENTES','RPC','Codigo',Var('VEHICULODE')))
ACT(am:fac, 'BCFRANGVAC')
ACT(am:fac+1, 'BCFRAGVAC')
ACT(am:fac+2, 'BCFRANGVIN')
ACT(am:fac+3, 'BCFRAGVIN')
ACT(am:fac+4, 'BCFRANGCIG')
ACT(am:fac+5, 'BCFRAGCIG')
ACT(am:fac+6, 'BCFRANGNIG')
ACT(am:fac+7, 'BCFRAGNIG')
ACT(am:fac+8, 'BCFRANGF')
ACT(am:fac+9, 'BCFRAGF')
ACT(am:fac+10, 'BCFRANGNF')
ACT(am:fac+11, 'BCFRAGNF')

ACN(an:fac, VAR('BCFRANGVAC'))
ACN(an:fac+1, VAR('BCFRAGVAC'))
ACN(an:fac+2, VAR('BCFRANGVIN'))
ACN(an:fac+3, VAR('BCFRAGVIN'))
ACN(an:fac+4, VAR('BCFRANGCIG'))
ACN(an:fac+5, VAR('BCFRAGCIG'))
ACN(an:fac+6, VAR('BCFRANGNIG'))
ACN(an:fac+7, VAR('BCFRAGNIG'))
ACN(an:fac+8, VAR('BCFRANGF'))
ACN(an:fac+9, VAR('BCFRAGF'))
ACN(an:fac+10, VAR('BCFRANGNF'))
ACN(an:fac+11, VAR('BCFRAGNF'))

ACT(r:FAC+2, 'RPC')
ACN(r:FAC+3, BuscarCampo('CLIENTES','RPC','Codigo',Var('VEHICULODE')))

ACT(ah:FAC+2, 'RPC')
ACN(ah:FAC+3, BuscarCampo('CLIENTES','RPC','Codigo',Var('VEHICULODE')))


SetFilaActual(FAC+5)
acn(w3,fac)
ACD(z2, Dialogo.Fecha1)
ACD(z4, Dialogo.Fecha2)

ACT(a:fac,'Cliente')
ACT(b:fac,'Grupo Econ.')
Recorrer&i 1,31
  ACN(&i+2:fac, &i)
Proximo
AgregarMarco(1:fac..36:fac,2,2,EXE('COLOR10'))
FormatoCeldas(3:fac..36:fac,Exe('F0')) 


(.'PMOAUXCLFM'.)

ACN(cc1,36)
** Recorrer desde s dia 17 hasta 34 dia 31
recorrer&i 19,34
  recorrer&j val(w3),fac
    if val(val(cc1)-2:&j)>=0 y not [EqStr(val(a:&j),'Total Grupo') y EqStr(val(b:&j),'')]
      ACN(val(cc1):&j, val(val(cc1)-2:&j))          
    else
      ACT(val(cc1):&j, '')          
    endif
  proximo
  SCN(cc1,-1)
proximo

ACT(s:val(w3),'Cliente')
ACT(t:val(w3),'Grupo Econ.')

recorrer&j val(w3)+1,fac
  ACT(s:&j,val(a:&j))
  ACT(t:&j,val(b:&j))
**  if EqStr(val(s:&j),'Total Grupo')
  if EqStr(Copy(val(a:&j),1,5),'Total')
    SetFont(s:&j..36:&j,2)  
    ACT(al:&j, 'Tot')
    ACT(bb:&j, 'Tot')
  endif
proximo

ACT(36:val(w3),'Total')
ACT(36:fac,'')

FormatoCeldas(3:val(w3)..36:val(w3),Exe('F0')) 

ACO(1,8)
ACO(2,8)
recorrer&k 3,33
  ACO(&k, 8)
proximo

ACO(19,8)
ACO(20,8)
recorrer&k 21,35
  ACO(&k, 8)
proximo

BorrarCeldas(t:1..ag:5)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC,2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

AgregarBMP(s1,Exe('LOGO'),Exe('ESCALOGO'))

RangoTitulo(a:1..ah:FAC, 9)
SetMargins(0,0,0,1.5)
SetPrintFit(3,72)

LimitesVision(aj:FAC)
