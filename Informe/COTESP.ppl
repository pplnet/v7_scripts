ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha"     ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Lista1     : "Especies"  ;1;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES ORDER BY Codigo ");
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))
SetFilaActual(4)
ACT(a:FAC, 'Ultima cotizacion por especie')
SetFont(a:fac,3)

SetFilaActual(6)

ACT(a:FAC, 'Especies : '~IIF(NoVacio(Dialogo.Lista1), Pipe2Coma(Dialogo.Lista1), 'Todas') )
ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1 )
SetFont(a:fac..a:fac+1,2)

SetFilaActual(FAC+3)

ACT(a:fac, 'Especie')
ACT(b:fac, 'Fecha')
ACT(c:fac, 'Nombre')
ACT(d:fac, 'Cotizacion')
ACT(e:fac, 'Fecha Ej.')
ACT(f:fac, 'Precio Ej.')
ACT(g:fac, 'Tipo')
ACT(h:fac, 'Moneda')
ACT(i:fac, 'Plazo Liq.')
ACT(j:fac, 'Mercado')
ACN(w1,fac)

SetFont(a:FAC..j:FAC,2)
AgregarMarco(a:FAC..j:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD("SELECT C1.Fecha, C1.Codigo, C1.Precio1, E.Nombre, C1.FechaEj, C1.PrecioEj, C1.CallPut,C1.Moneda, ")
SQL.ADD(" Case C1.PlazoLiq When '0' then 'Contado' When '24' then '24Hs' When '48' then '48Hs' Else 'Todos' End Plazo,c1.mercado ")
SQL.ADD("FROM "~DBO~".COTIZACIONES C1, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE C1.Codigo = E.Codigo AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      C1.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      C1.Fecha = (SELECT MAX(Fecha) ")
SQL.ADD("                  FROM "~DBO~".COTIZACIONES C2 ")
SQL.ADD("                  WHERE C2.Codigo = C1.Codigo AND ")
SQL.ADD("                        C2.CallPut = C1.CallPut AND ")
SQL.ADD("                        C2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("ORDER BY C1.Codigo, C1.Fecha ")

Recorrer SQL
   ACT(a:fac, FBN['Codigo'])
   ACD(b:fac, FBN['Fecha'])
   ACT(c:fac, FBN['Nombre'])
   ACN(d:fac, FBN['Precio1'])
   IF NoVacio(FBN['FechaEj'])
      ACD(e:fac, FBN['FechaEj'])
   ENDIF
   IF FBN['PrecioEj'] <> 0
   ACN(f:fac, FBN['PrecioEj'])5 
   ENDIF
   ACT(g:fac, FBN['CallPut'])
   ACT(h:fac, FBN['Moneda'])
   ACT(i:fac, FBN['Plazo'])
   ACT(j:fac, FBN['Mercado'])
Proximo

ACO(1,5)
ACO(2,7)
ACO(3,15)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,5)

SetFilaActual(fac+3)

Impresion(1,1)
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC,2)
FormatoCeldas(d:Val(w1)+1..d:fac, Exe('F9'))
FormatoCeldas(f:Val(w1)+1..f:fac, Exe('F9'))
LimitesVision(j:FAC)
RangoTitulo(a:1..j:FAC, Val(w1) )

