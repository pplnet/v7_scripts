CrearDialogo
  Fecha1           :  'Fecha'               ;1;;;;;;;;FSYS
  Cliente1         :  'Cliente'             ;2;;;;;;;
  Radio1           : 'Moneda Exp.|ARP|USD'  ;4;;;;NO;;;;0;;
  Radio2           :  'Filtra Book|SI|NO'   ;3;;;;;;;;1;
  Vehiculo1        :  'Vehiculo'            ;5;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Radio2=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2           :  'Books'               ;6;1;;;Dialogo.Radio2=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Lista1           :  'Vehiculo'            ;-1;1;;;Dialogo.Radio2=1;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,14,B')
CrearFont(4, 'Arial,10,BI')
*> <

SetFilaActual(1)
ACT(E:fac, 'Cauciones Vigentes')
SetFont(E:fac, 3)
SetFilaActual(fac+2)
ACN(FI:1, fac)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Cliente: '~Dialogo.Cliente1)
ELSE
    ACT(A:fac, 'Cliente: Todos')
ENDIF
ifa
IF Dialogo.Radio2 = 0
    IF NoVacio(Dialogo.Lista2)
        ACT(A:fac, 'Book/s: '~Dialogo.Lista2)
        ifa
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Vehiculo1)
    ELSE
        ACT(A:fac, 'Book/s: Todos')
        ifa
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Vehiculo1)
    ENDIF
ELSE 
    IF NoVacio(Dialogo.Lista1)
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Lista1)
    ELSE
        ACT(A:fac, 'Vehiculo/s: Todos')
    ENDIF
ENDIF
IF Dialogo.Radio1 = 0
    ACT(MN:1, Var('MONELOCA'))
ELSE
    ACT(MN:1, Var('MONEEXTR'))
ENDIF
*ACT(A:fac, 'Expresado en: '~Val(MN:1))
SetFilaActual(fac+2)
ACT(A:fac, 'Operacion')
ACT(B:fac, 'Cliente')
ACT(C:fac, 'FechaOp')
ACT(D:fac, 'Book')
ACT(E:fac, 'Plazo')
ACT(F:fac, 'FechaVto')
ACT(G:fac, 'Capital')
ACT(H:fac, 'Intereses')
ACT(I:fac, 'Plazo')
ACT(I:fac+1, 'Remanente')
ACT(J:fac, 'Intereses')
ACT(J:fac+1, 'Devengados')
ACT(K:fac, 'Intereses a')
ACT(K:fac+1, 'Devengar')
ifa
SetFont(A:Val(FI:1)..K:fac, 2)
AlinearCeldas(A:fac-1..K:fac, 'C')
AgregarMarco(A:fac-1..K:fac, 0, 0, Exe('COLOR'))

SQL.ADD(" Select O.Cantidad, O.Vehiculo1, O.Especie Moneda, O.Cliente1, O.TotalIntereses, O.FechaOp, O.FechaVto, O.Plazo, O.NrOperacion, O.TipoOp, O.Book1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('SECAC','SECAT') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
IF Dialogo.Radio2 = 0
    IF NoVacio(Dialogo.Lista2)
        SQL.ADD(" AND O.Book1 IN("~Pipe2Comillas(Dialogo.Lista2)~") ")
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ELSE
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ENDIF
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
SQL.ADD(" Order By O.Vehiculo1, O.Especie,O.Book1 ")
Recorrer SQL
    let &coninfo 1
    IF Not Eqstr(fbn('Vehiculo1'), Val(VH:1)) Y Not CeldaVacia(VH:1)
        ACT(A:fac, 'Total Moneda')
        ACN(G:fac, Val(TF:1))
        ACN(H:fac, Val (TI:1))
        ACN(J:fac, Val (TI:2))
        ACN(K:fac, Val (TI:3))
        SetFont(A:fac..K:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
        FormatoCeldas(G:fac..K:fac,Exe('F2'))
        ACT(MN:1, fbn('Moneda'))
        ACN(TF:1, 0)
        ACN(TI:1, 0)
        ACN(TI:2, 0)
        ACN(TI:3, 0)
        ifa
        *ACT(A:fac, 'Total Vehiculo')
        *ACN(F:fac, Val(TF:2))
        ACT(VH:1, fbn('Vehiculo1'))
        ACN(TF:2, 0)
        ifa
        ACT(A:fac, 'Vehiculo: '~fbn('Vehiculo1'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR6'))
        ifa
        ACT(A:fac, 'Moneda: '~fbn('Moneda'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
        ifa
    ELSE
        IF Not Eqstr(fbn('Moneda'), Val(MN:1)) Y Not CeldaVacia(MN:1)
            ACT(A:fac, 'Total Moneda')
            ACN(G:fac, Val(TF:1))
            ACN(H:fac, Val (TI:1))
            ACN(J:fac, Val (TI:2))
            ACN(K:fac, Val (TI:3))
            SetFont(A:fac..K:fac, 2)
            AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
            FormatoCeldas(G:fac..K:fac,Exe('F2'))
            ACT(MN:1, fbn('Moneda'))
            ACN(TF:1, 0)            
            ACN(TI:1, 0)            
            ACN(TI:2, 0)            
            ACN(TI:3, 0)            
            ifa
            ifa
            ACT(A:fac, 'Moneda: '~fbn('Moneda'))
            SetFont(A:fac, 2)
            AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
            ifa
        ENDIF
    ENDIF
    IF CeldaVacia(VH:1)
        ACT(A:fac, 'Vehiculo: '~fbn('Vehiculo1'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR6'))
        ifa
        ACT(A:fac, 'Moneda: '~fbn('Moneda'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
        ifa
    ENDIF
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('Cliente1'))
    ACD(C:fac, fbn('FechaOp'))
    ACT(D:fac, fbn('Book1'))
    ACN(E:fac, fbn('Plazo'))
    FormatoCeldas(E:fac..E:fac,Exe('F0'))
    ACD(F:fac, fbn('FechaVto'))
    ACN(G:fac, fbn('Cantidad'))
    ACN(H:fac, fbn('TotalIntereses'))
    ACN(I:fac, fbn('FechaVto') - Dialogo.Fecha1)
    SQL.ADD(" Select Sum(M.Monto) Monto From "~DBO~".MOVDEVENGADOS M ")
    SQL.ADD(" Where M.NrOperacion = '"~fbn('NrOperacion')~"' ")
    SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND M.NrSaldo = 140 ")
    SQL.ADD(" AND M.TipoDevengado = 'INTLEN' ")
    Recorrer SQL
        DFA
        ACN(J:fac, fbn('Monto'))
        ACN(K:fac, Val(H:fac) - Val(J:fac))
        ACN(ID:1, -fbn('Monto'))
        ACN(ID:2, -(Val(H:fac) - Val(J:fac)))
    Proximo
    ACT(VH:1, fbn('Vehiculo1'))
    ACT(MN:1, fbn('Moneda'))
     IF Eqstr(fbn['TipoOp'],'SECAT')
        ACN(G:fac, -fbn('Cantidad'))
        ACN(H:fac, -fbn('TotalIntereses'))
        ACN(J:fac, Val(ID:1))
        ACN(K:fac, Val(ID:2))
        FormatoCeldas(G:fac..K:fac,Exe('F2'))
    ENDIF
    SCN(TF:1, Val(G:fac))
    SCN(TF:2, Val(G:fac))
    SCN(TI:1, Val(H:fac))
    SCN(TI:2, Val(J:fac))
    SCN(TI:3, Val(K:fac))
    FormatoCeldas(I:fac..I:fac,Exe('F0'))
Proximo
ifa
If &conInfo = 1
    ACT(A:fac, 'Total Moneda ')
    AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR7'))
    ACN(G:fac, Val(TF:1))
    ACN(H:fac, Val (TI:1))
    ACN(J:fac, Val (TI:2))
    ACN(K:fac, Val (TI:3))
    SetFont(A:fac..K:fac, 2)
    FormatoCeldas(G:fac..K:fac,Exe('F2'))
    ifa
*    ifa
*    ACT(A:fac, 'Total Vehiculo '~Val(VH:1))
*    ACN(G:fac, Val(TF:2))
*    FormatoCeldas(G:fac..K:fac,Exe('F2R'))
ENDIF
ACO(7, 10)
ACO(8, 10)
ACO(9, 10)
ACO(10, 10)
ifa
ifa
ifa
ACT(A:fac,'Fin del Informe')
SetFont(A:fac,4)
LimitesVision(L:fac+1)