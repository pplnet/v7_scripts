CrearDialogo
  Fecha1    : 'Desde'    ;;;;;;;;;PriDeMes(Fsys, SI)
  Fecha2    : 'Hasta'    ;;;;;;;;;FinDeMes(Fsys, SI)
  Cuenta1   : 'Cuenta D'   ;;;;;;;;
  Cuenta2   : 'Cuenta H'   ;;;;;;;;
FinDialogo

If Not OK
   Cancelar
EndIf

SetFilaActual(1)
ACT(A:fac, 'Operaciones Eventuales')

SetFilaActual(fac+2)
ACT(A:fac, 'Desde '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Hasta '~Dialogo.Fecha2)
ifa
ACT(A:fac, 'Desde '~Dialogo.Cuenta1)
ifa
ACT(A:fac, 'Hasta '~Dialogo.Cuenta2)

SetFilaActual(fac+2)

ACT(A:fac, 'NrOperacion')
ACT(B:fac, 'FechaOp')
ACT(C:fac, 'Cantidad')
ACT(D:fac, 'Cuenta')
ACT(E:fac, 'Moneda')
ACT(F:fac, 'Referencia')

SQL.ADD(" Select NrOperacion, FechaOp, Cantidad, Cuenta1, Especie, Observac3 ")
SQL.ADD(" From "~DBO~".OPSEVENTUALES ")
SQL.ADD(" Where FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Cuenta1)
    SQL.ADD(" AND Cuenta1 >= '"~Dialogo.Cuenta1~"' ")
ENDIF
IF NoVacio(Dialogo.Cuenta2)
    SQL.ADD(" AND Cuenta2 <= '"~Dialogo.Cuenta1~"' ")
ENDIF
SQL.ADD(" Order By Cuenta1, NrOperacion, FechaOp ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLV(A:fac, fbn('NrOperacion'))
    ACD(B:fac, fbn('FechaOp'))
    ACN(C:fac, fbn('Cantidad'))
    ACT(D:fac, fbn('Cuenta1'))
    ACT(E:fac, fbn('Especie'))
    ACT(F:fac, fbn('Observac3'))
Proximo

ACO(2, 10)
ACO(3, 13)
ACO(4, 20)