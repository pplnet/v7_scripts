CrearDialogo
  Fecha1     : "FechaOp"              ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Radio1     : '|Compra|Venta|Ambos'  ;;;;;;
  Especie1   : 'Titulo'               ;;;;;;
  Book1      : 'Cartera'              ;;;;;;
  Radio2     : 'Posicion|Concertada|Liquidada' ;6;;;;;;;;0
  Radio3     : 'Expresado|ARP|USD'             ;8;;;;;;;;0    
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)



ACT(a:FAC, "Detalle de Posiciones y Resultado de Acciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

*ACT(a:FAC, 'Descripcion')
ACT(b:FAC, 'Fecha')
ACT(c:FAC, 'Fecha Vto.')
ACT(d:FAC, 'Titulo')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Precio')
ACT(g:FAC, 'Operacion')
ACT(h:FAC, 'Tipo')
ACT(i:FAC, 'Cartera')
ACT(j:FAC, 'Origen')

SetFont(a:Fac..J:Fac,2)
AgregarMarco(a:Fac..J:Fac,2,0,Exe('COLOR6'))

SetFilaActual(FAC)

SQL.ADD("Select ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.Precio1, O.NrOperacion, O.TipoOp, O.Book1, O.Mercado as Origen ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE M ")
SQL.ADD("Where O.NrOperacion = M.NrOperacion   ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie= '"~Dialogo.Especie1~"' ")
EndIF
If Dialogo.Fecha1>0
   SQL.ADD(" and O.FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' ")
EndIF
If Dialogo.Radio1=0 
   SQL.ADD(" and O.TipoOp= 'EQC' ")
Else
   If Dialogo.Radio1=1
     SQL.ADD(" and O.TipoOp= 'EQV' ")   
   EndIf
EndIf
IF Dialogo.Radio2 = 0
  IF Dialogo.Radio3 = 0
    ***---Posicion concertada en ARP
    SQL.ADD(" and M.NrSaldo IN (102) ")
  ELSE
    ***---Posicion concertada en Cotiza
    SQL.ADD(" AND M.NrSaldo IN (101) ")  
  ENDIF
ELSE
    IF Dialogo.Radio1 = 0
    ***---Posicion liquidada en ARP
    SQL.ADD(" AND M.NrSaldo IN (112) ")
  ELSE
  ***---Posicion liquidada en Cotiza
  SQL.ADD(" AND M.NrSaldo IN (111) ")  
  ENDIF
ENDIF

If NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1= '"~Dialogo.Book1~"' ")
EndIF
SQL.ADD(" Order by O.FechaOp ")
Recorrer SQL
  ACD(b:Fac, Fbn['FechaOp'])
  ACD(c:Fac, Fbn['FechaVto'])
  ACT(d:Fac, Fbn['Especie'])
  ACN(e:Fac, Fbn['Cantidad'])
  ACN(f:Fac, Fbn['Precio1'])
  ACT(g:Fac, Fbn['NrOperacion']) 
  ACLO(g:Fac, Fbn['NrOperacion'])
  ACT(h:Fac, Fbn['TipoOp'])
  ACT(i:Fac, Fbn['Book1'])
  ACT(j:Fac, Fbn['Origen'])
  SCN(xx:1, Val(E:Fac))
  SCN(xx:2, Val(E:Fac)*Val(F:Fac))
Proximo 
SetFilaActual(FAC+1)
ACT(a:Fac,'Total')
ACN(e:Fac,val(xx:1))
ACN(f:Fac,val(xx:2)/val(xx:1))
SetFont(a:FAC, 2)

ACO(1,15 )
ACO(2,15 )
ACO(3,15 )
ACO(4,15 )
ACO(5,15 )
ACO(6,15 )
ACO(7,15 )
ACO(8,15 )
ACO(9,15 )
ACO(10,15)
ACO(11,15)
ACO(12,15)

Impresion(1,2)
SetFilaActual(FAC+1)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
RangoTitulo(a1..k:8,36)