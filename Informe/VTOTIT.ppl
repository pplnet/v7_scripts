IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
    Fecha1: 'Fecha Desde'          ;;;;;;;;;FSys
    Fecha2: 'Fecha Hasta'          ;;;;;;;;;FSys
    Radio1: 'Filtra Book|SI|NO'    ;3;;;;;;;;1;
    Vehiculo1: 'Vehiculo'          ;5;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
    Lista2: 'Books'                ;6;1;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
    Lista1: 'Vehiculos'            ;-1;1;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
    Especie1: 'Especie'            ;1;1;;;;Vacio(Dialogo.Especie1) O DesciendeDeEspecie(Dialogo.Especie1,'TITULO');'La especie debe ser un titulo';NO;;;;;;" dbo.DESCIENDEDEESPECIE(Codigo,'TITULO') = 1 ";;;
    Fecha3: 'Fecha Ejecucion'      ;;;;NO;NO;;;;FSys
FinDialogo

IF Not OK
  Cancelar
ENDIF

let &filaLogo 1
@LOGO

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(C:1,'Vencimiento de Titulos')
SetFont(C:1,3)

SetFilaActual(5)

let &Inicio FAC
ACT(A:FAC,'Fecha Desde: '~Dialogo.Fecha1)
IFA
ACT(A:FAC,'Fecha Hasta: '~Dialogo.Fecha2)
IFA
IF Dialogo.Radio1 = 0
    ACT(A:FAC,'Filtra Book: SI')
    IFA
    ACT(A:FAC,'Vehiculo: '~Dialogo.Vehiculo1)
    IFA
    IF NoVacio(Dialogo.Lista2)
        ACT(A:FAC,'Books: '~Dialogo.Lista2)
    ELSE
        ACT(A:FAC,'Book: Todos')
    ENDIF
ELSE
    ACT(A:FAC,'Filtra Book: NO')
    IFA
    IF NoVacio(Dialogo.Lista1)
        ACT(A:FAC,'Vehiculos: '~Dialogo.Lista1)
    ELSE
        ACT(A:FAC,'Vehiculos: Todos')
    ENDIF
ENDIF
IFA
IF NoVacio(Dialogo.Especie1)
    ACT(A:FAC,'Especie: '~Dialogo.Especie1)
ELSE
    ACT(A:FAC,'Especie: TODAS')
ENDIF
IFA
ACT(A:FAC,'Fecha Ejecucion: '~Dialogo.Fecha3)
SetFont(A:&Inicio..A:FAC,2)

IFA
IFA

ACT(A:FAC,'Codigo')
ACT(B:FAC,'Cartera')
ACT(C:FAC,'Especie')
ACT(D:FAC,'Moneda')
ACT(E:FAC,'Vto Original')
ACT(F:FAC,'Valor Mercado')
ACT(G:FAC,'Valor Nominal')
ACT(H:FAC,'Valuacion')
SetFont(A:FAC..H:FAC,2)
AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR'))

SQL.ADD(" SELECT P2.Vehiculo,E.Fecha,P2.Especie,P2.Book,P2.CantidadFin, E.Alias6, ")
SQL.ADD(" E.Cotiza,E.InteresesC,P2.NrSaldo,B.Descripcion,E.Nombre,E.MonedaEmision ")
SQL.ADD(" FROM "~DBO~".POSICIONES2 P2, "~DBO~".ESPECIES E, "~DBO~".BOOKS B ")
SQL.ADD(" WHERE E.Codigo = P2.Especie ")
SQL.ADD(" AND P2.Book = B.Codigo ")
SQL.ADD(" AND P2.NrSaldo = 1 ")
SQL.ADD(" AND E.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND E.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
*Se muestra una línea por la Posicion final del titulo
SQL.ADD(" AND P2.Fecha in (SELECT Max(Fecha) FROM POSICIONES2 WHERE Especie = P2.Especie AND Book = P2.Book AND NrSaldo = 1) ")
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND P2.Especie = '"~Dialogo.Especie1~"' ")
ELSE
    SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P2.Especie,'TITULO') = 1 ")
ENDIF
IF Dialogo.Radio1 = 0
    SQL.ADD(" AND P2.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
    IF NoVacio(Dialogo.Lista2)
        SQL.ADD(" AND P2.Book in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    ENDIF
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND P2.Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
ENDIF
SQL.ADD(" ORDER BY P2.Book,E.MonedaEmision,P2.Fecha ")

let &SubtotalMonedaActual 0
let &MonedaActual ''
let &TotalARP 0
let &TotalUSD 0
let &BookActual ''
let &PrimerRegistro 0
let &MonedaLocal Var('MONELOCA')
let &MonedaExtranjera Var('MONEEXTR')

Recorrer SQL
    IF &PrimerRegistro = 0
        let &PrimerRegistro 1
        let &BookActual fbn('Book')
        let &MonedaActual fbn('MonedaEmision')            
    ENDIF
    IF Not Eqstr(fbn('Book'),&BookActual)
        ACT(B:FAC,'Sub Total '~&BookActual~' en '~&MonedaActual)
        ACN(H:FAC,&SubtotalMonedaActual)
        AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR6'))
        FormatoCeldas(H:FAC, Exe('F2'))
        SetFont(A:FAC..H:FAC,2)
        IFA
        IFA
        let &SubtotalMonedaActual 0
        let &BookActual fbn('Book')
        let &MonedaActual fbn('MonedaEmision')
    ENDIF
    IF Not Eqstr(fbn('MonedaEmision'),&MonedaActual)
        ACT(B:FAC,'Sub Total '~&BookActual~' en '~&MonedaActual)
        ACN(H:FAC,&SubtotalMonedaActual)
        AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR6'))
        FormatoCeldas(H:FAC, Exe('F2'))
        SetFont(A:FAC..H:FAC,2)
        IFA        
        let &MonedaActual fbn('MonedaEmision')
        let &SubtotalMonedaActual 0
    ENDIF
    *Codigo del Vehiculo
    ACT(A:FAC,fbn('Vehiculo'))
    *Codigo del Book
    ACT(B:FAC,fbn('Book'))
    *Especie
    ACT(C:FAC,fbn('Especie')~' - '~fbn('Nombre'))
    *Moneda Emision
    ACT(D:FAC,fbn('MonedaEmision'))
    *Fecha de Maduracion
    ACD(E:FAC,fbn('Fecha'))
    *Valor de Mercado: Cotizacion de la Especie + Intereses Corridos (si Cotiza Clean)
    *MonedaEmision = USD y Cotiza = ARP, la moneda de pago es USD. Tomar el precio del Alias6 de la especie
    IF Eqstr(fbn('MonedaEmision'),&MonedaExtranjera) Y Eqstr(fbn('Cotiza'),&MonedaLocal)
        let &Cotizacion Cotizacion(FBN['Alias6'],,,,Dialogo.Fecha3,1,SI)
    ELSE
        let &Cotizacion Cotizacion(FBN['Especie'],,,,Dialogo.Fecha3,1,SI)
    ENDIF
    IF Eqstr(fbn('InteresesC'),'CLE') 
        SQL.ADD(" SELECT I.Intereses FROM "~DBO~".INTERESESCORRIDOS I ")
        SQL.ADD(" WHERE I.Especie = '"~fbn('Especie')~"' ")
        SQL.ADD(" AND I.Fecha = (SELECT MAX(Fecha) FROM "~DBO~".INTERESESCORRIDOS WHERE Especie = I.Especie AND Fecha <= '"~IdxDate(Dialogo.Fecha3)~"') ")
        Recorrer SQL
            DFA
            let &InteresesCorridos fbn('Intereses')
        Proximo
    ELSE
        let &InteresesCorridos 0
    ENDIF
    ACN(F:FAC,Round(&Cotizacion+&InteresesCorridos,2))
    FormatoCeldas(F:FAC..F:fac, Exe('F8'))
    *Valor Nominal
    ACN(G:FAC,fbn('CantidadFin'))
    *Valuacion: Valor Nominal * Valor Mercado
    ACN(H:FAC,Val(G:FAC)*Val(F:FAC))
    let &SubtotalMonedaActual &SubtotalMonedaActual+Val(H:FAC)
    IF Eqstr(fbn('MonedaEmision'),&MonedaLocal)
        let &TotalARP &TotalARP+Val(H:FAC)
    ELSE
        IF Eqstr(fbn('MonedaEmision'),&MonedaExtranjera)
            let &TotalUSD &TotalUSD+Val(H:FAC)
        ENDIF
    ENDIF
    FormatoCeldas(G:FAC..H:FAC, Exe('F2'))
Proximo
IFA
*Subtotales de ultima moneda y ultimo Book
ACT(B:FAC,'Sub Total '~&BookActual~' en '~&MonedaActual)
ACN(H:FAC,&SubtotalMonedaActual)
SetFont(A:FAC..H:FAC,2)
FormatoCeldas(H:FAC, Exe('F2'))
AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR6'))
IFA
IFA
ACT(B:FAC,'Total '~&MonedaLocal)
ACN(H:FAC,&TotalARP)
SetFont(A:FAC..H:FAC,2)
FormatoCeldas(H:FAC, Exe('F2'))
AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR'))
IFA
ACT(B:FAC,'Total '~&MonedaExtranjera)
ACN(H:FAC,&TotalUSD)
SetFont(A:FAC..H:FAC,2)
FormatoCeldas(H:FAC, Exe('F2'))
AgregarMarco(A:FAC..H:FAC,1,0,Exe('COLOR'))

IFA
ACT(A:FAC+1,'Fin del informe')
SetFont(A:FAC+1,2)

