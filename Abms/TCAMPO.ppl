#**********************************************************************
def abm 'FIELDTYPES'
    def grid ID:,SCRIPTTYPE:,NOMBRECAMPO:,TIPOCAMPO:
    end
    def key ID:,SCRIPTTYPE:,NOMBRECAMPO:,TIPOCAMPO:
    end
    def dialog
    #**********************************************************************
        tab 'General'
            column  
                ID:          ,'ID'          , numeric, '###'
                SCRIPTTYPE:  ,'Tipo Script' , text
                NOMBRECAMPO: ,'Nombre campo', large_text
                TIPOCAMPO:   ,'Tipo Campo'  , extra_large_text
    #**********************************************************************
    end
    
    required_fields:
    SCRIPTTYPE:,NOMBRECAMPO:,TIPOCAMPO:
    
    validates_uniqueness_of_set:
    ID:,SCRIPTTYPE:,NOMBRECAMPO:,TIPOCAMPO:
    
    disable:
    ID:
    
    before_show_dialog:  do
        if $.Alta()
            $.hide(ID:)
        else
            $.show(ID:)
        endif
    end
    
end