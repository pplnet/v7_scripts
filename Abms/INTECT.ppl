%%ifdef CMF
    set ds_TipoDocum    = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO' ")
    set ds_TipoPoder    = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'ONLPER' AND Atributo = 'TIPOPODERF' ")
%%else
    set ds_TipoDocum    = ":|CI:CI|DNI:DNI|LE:LE|LC:LC|PAS:Pasaporte|CIP:C.I.Provincial|CUI:CUIT|GCE:Grupo Crediticio/Economico|OTR:Otro|"
    set ds_TipoPoder    = ":|TIT:Titular|CTI:Co Titular|AUT:Autorizado|APO:Apoderado|"
%%endif

def abm "INTEGRANTESCTA"
    def grid
        Cliente:,
        TipoDocumento:,
        NrDocumento:,
        TipoPoder:,
        Codigo:        
    end
    def filter
        "Codigo = '" + $.parent('Codigo') + "' "
    end
    def key
        Codigo:,Cliente:,TipoDocumento:, NrDocumento:
    end    
    def dialog
        #**************************************************************************
        tab "General"
            column    
              Codigo:
              Cliente:,       'Cliente'       ,  text
              TipoDocumento:, 'Tipo Documento',  combo,ds_TipoDocum
              NrDocumento:,   'Nr Documento',text
              TipoPoder:,     'Tipo Poder',      combo,ds_TipoPoder

    end    
    disable_fields: Codigo:
    validates_max_length_of:
       Cliente:,10,true; 
       NrDocumento:,15,true;
    before_show_create_dialog: do
        $.set_field  (Codigo:, $.parent("Codigo"))     
    end
end