def abm 'RelacionCuenta'
   def grid
   Codigo:, Tabla: as 'Tipo Cuenta', Cuenta:, Book:, TiposGrupoEsp:, PlazoDesde:, PlazoHasta:,
   TipoImporte:, CentroCosto:, Sector:, TiposOperacion:, Especies:, Custodia:, Concepto:,
   Residente:, Vinculado:, EstadoCustodia:, Moneda:, Mercado:, Vehiculos:
   end      
   def key
      Codigo: 
   end  
   def dialog_size
       1150,750  
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             %%ifdef MLASA
                Tabla: , 'Tabla', text
             %%else
                Tabla:,'Tipo Cuenta', autocomplete, 'TIPOCTACONT', 'Codigo,Nombre'
             %%endif   
             Cuenta: , 'Cuenta Contable', autocomplete, 'Contabilidad', 'Codigo,Nombre'             
             Book: , 'Book',  autocomplete_ar_list, 'BOOKS', 'Codigo,Descripcion'            
             TiposGrupoEsp: ,'Tipo Especie',  autocomplete_ar_list, 'TIPOESPECIE', 'Codigo,Descripcion'
             Vehiculos:,   , autocomplete_ar_list, 'Vehiculos', 'Codigo,Descripcion'  
             PlazoDesde:  ,'Plazo Desde (dias)', numeric,'#####0'
             PlazoHasta:  ,'Plazo Hasta (dias)', numeric,'#####0'         
          column
             Label1: ,       ,label
             TipoImporte: , 'Tipo Importe', autocomplete, 'TiposImporte', 'Codigo,Descripcion'
             CentroCosto: , 'Centro Costo', autocomplete, 'CentrosCosto', 'Codigo,Descripcion'
             %%ifdef MLASA
                CodigoRelacion: , 'Relacion Book', small_text
             %%endif           
             Sector: ,          , autocomplete_ar_list, 'SectorCli', 'Codigo,Descripcion'
             TiposOperacion: ,    , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
             Especies: ,          , autocomplete_ar_list, 'Especies', 'Codigo,Nombre'
             Custodia:, 'Cta Custodia'   , autocomplete, 'Cuentas', 'Codigo,Nombre',, "TipoCuenta = 'CUS'"
             Concepto: ,,autocomplete, 'CNConceptosPagoCobro', 'Codigo,Descripcion'
          column   
             Label2: ,       ,label
             Residente: ,  , check
             Vinculado: ,'BCRA', check 
             EstadoCustodia: ,    , autocomplete_ar_list, 'ESTADOSCUSTODIA', 'Codigo,Descripcion',, "Codigo in ('GAME1','GROFEX')"
             Moneda: ,    , autocomplete_ar_list, 'Especies', 'Codigo,Nombre',''," "+dbo+".desciendedeespecie(Codigo,'MONEDA') = 1 "
             Mercado:,    , autocomplete_ar_list, 'Mercados', 'Codigo,Descripcion'
             
       #**************************************************************************
   end
   before_save:  do
      If $.val(Residente:) <> 'SI'
         $.set_field (Residente:, 'NO')
      end
      If $.val(Vinculado:) <> 'SI'
         $.set_field (Vinculado:, 'NO')
      end
      
      true
   end  
   
   validates_uniqueness_of: Codigo:
   upper_case_fields: Codigo:, Tabla:
end