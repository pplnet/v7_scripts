#*********************************************************************************
#combos data sources.
set ds_CallPut             = "CON:Contado|CAL:O.Compra|PUT:O.Venta|FUT:Futuro|"
set ds_Origen              = "MAN:Manual|SIB:SIB|REU:Reuters|OTR:Otros|"
set ds_PlazoLiq            = ": |0:Contado|24:24Hs|48:48Hs|"
set fsys = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+Dbo+".VARIABLES where Codigo='FECHASYS' ") 
set today = db.get_scalar("Select GetDate()") 
#*********************************************************************************
def abm 'Cotizaciones'
   def grid
       Fecha:, Codigo:, FechaEj:, PrecioEj:, CallPut:, Precio1:, Precio2:, Precio3:, Precio4:, Precio5:, Moneda:, PlazoLiq:, Mercado: 
   end
   def user_filter
       "Del dia", "Fecha = FECHASYS"
   end
   def key
       Fecha:, Codigo:, FechaEj:, PrecioEj:, CallPut:, Moneda:, PlazoLiq:, Mercado:
   end
   
   def dialog_size
       800, 460
   end    
   
   def context_menu
       "Generar cotizaciones", do 
           $.GenerarCotizacionesDialog()  
           $.RefreshGrid()
       end 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Fecha:   , 'Fecha Cotizacion', date 
             Codigo:  , 'Cod. Especie', autocomplete, 'Especies', 'Codigo,Nombre'
             FechaEj: , 'Fecha Ej', date
             PrecioEj:, 'Precio Ej', numeric,'#######0.0000000000'
             Precio1: , 'Precio Mercado', numeric,'#######0.0000000000'
             PrecioContable: , 'P.Contable', numeric,'#######0.0000000000'
             #             Precio2: , 'Futuro Corto,20', numeric,'#######0.0000000000'
             #             Precio3: , 'Futuro Largo,20', numeric,'#######0.0000000000'
             #             Precio4: , 'Maximo,12.5', numeric,'#######0.0000000000'
             #             Precio5: , 'Minimo,12.5', numeric,'#######0.0000000000'
             Fuente:  , 'Fuente', small_text
             FechaActualizacion: , 'Ultima actualizacion', date
          column
             CallPut: ,          , combo, ds_CallPut
             Moneda:  , 'Moneda', autocomplete, 'Especies', 'Codigo,Nombre',''," "+dbo+".desciendedeespecie(Codigo,'MONEDA') = 1 "
             PlazoLiq:, 'Plazo', combo,ds_PlazoLiq
             Mercado: , 'Mercado', autocomplete, 'Mercados', 'Codigo,Descripcion'
       #**************************************************************************
       %%ifdef MLASA
         tab 'Adicional'
            column                
               Volumen: ,          , numeric,'##,###,###,##0.00'
               VolumenPromedio: , 'Profundidad', numeric,'##,###,###,##0.00'
               IndiceInts: , 'Indice Ints', numeric,'#######0.0000000000'
               PrecioReuters: , 'P.Reuters', numeric,'#######0.0000000000'
               PrecioBloomberg: , 'Bloomberg', numeric,'#######0.0000000000'
               PrecioTelerate: , 'Valor Realizacion', numeric,'#######0.0000000000'
               PrecioMAE: , 'Precio MAE', numeric,'#######0.0000000000'
               VolatilidadHistorica: , 'Volat BCRA', numeric,'#######0.0000000000'
               PrecioCartera: , 'P.Cartera', numeric,'#######0.0000000000'
               VolatilidadMercado: , 'Volatilidad HO', numeric,'#######0.0000000000'
            column
               Zona: , 'Zona', numeric,'####0'
       %%endif      
   end
   upper_case_fields: Codigo:
   before_show_create_dialog: do 
      $.set_field(CallPut:,'CON')
      $.set_field(PlazoLiq:,' ')
      $.set_field(Fecha:, fsys)
      $.set_field(Fuente:,'Manual')
      $.disable(FechaEj:,PrecioEj:,Fuente:,FechaActualizacion:)
   end
   
   before_save: do 
      $.set_field(FechaActualizacion:, today)
   end
   validates_uniqueness_of_set: Fecha:, Codigo:, FechaEj:, PrecioEj:, CallPut:, Moneda:, PlazoLiq:, Mercado:
   
   required_fields: Codigo:, Moneda:
   
   when_change: CallPut: do 
       #reset 
       $.disable(FechaActualizacion:)
       $.disable(Fuente:)
       $.enable FechaEj:, PrecioEj:
       #
       if($.val (CallPut:) = 'CON')
          $.disable(FechaEj:,PrecioEj:)
       end
       if($.val (CallPut:) = 'FUT')
            $.disable(PrecioEj:)
       end
   end 
   
   validates_max_length_of:
        Codigo:, 6,true
end