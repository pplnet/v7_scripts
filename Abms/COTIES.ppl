#*********************************************************************************
#combos data sources.
set variable =  db.get_scalar("SELECT Valor from "+dbo+".VARIABLES where Codigo='TIPOVALMER' ")
#*********************************************************************************
def abm 'CotizacionesEsp'
   def grid
   Fecha:, CodigoValuacion:, Especie:, Moneda:, Cotizacion: 
   end
   def key
   Fecha:, Especie:, Moneda:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          Fecha: , 'Fecha', date
          CodigoValuacion: , 'Tipo Valuacion', autocomplete, 'TiposValuacion',  'Codigo,Descripcion'
          Especie: , 'Especie', autocomplete, 'Especies', 'Codigo,Nombre'
          Cotizacion: , 'Cotizacion', numeric,'#######0.00000000'
          Moneda:  , 'Moneda', autocomplete, 'Especies', 'Codigo,Nombre',''," "+dbo+".desciendedeespecie(Codigo,'MONEDA') = 1 "
   end
   validations: 
   Fecha:, $.val(Fecha:)>0, 'Debe ingresar una fecha.','error';
   CodigoValuacion:, ppl.NoVacio($.val(CodigoValuacion:)), 'Debe ingresar un tipo de valuacion.', 'error';
   Especie:, ppl.NoVacio($.val(Especie:)), 'Debe ingresar una especie.', 'error';
   Cotizacion:, $.val(Cotizacion:)>0, 'Debe ingresar la cotizacion.', 'error';
   Moneda:, $.val(Moneda:)>0, 'Debe ingresar la moneda.', 'error';
   validates_max_length_of:
   CodigoValuacion:, 6,true;
   Especie:, 6,true;
   Moneda:, 6,true;
   before_show_create_dialog: do
    $.set_field(CodigoValuacion:, variable)
   end
end