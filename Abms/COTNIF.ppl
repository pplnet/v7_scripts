def abm 'CotizadorNiif'
   def grid
      Fecha:, Especie:, Cartera:, TipoValuacion:, Precio:, TipoValuacionAnt:, ModeloNegocio:
   end
   def key
      Fecha:, Especie:, Cartera:
   end
   def dialog
      #**************************************************************************
      tab 'General'
         column
            Fecha:, 'Fecha', date
            Especie:, 'Especie', autocomplete, 'Especies', 'Codigo,Nombre'
            Cartera: , 'Cartera', autocomplete, 'Books', 'Codigo,Descripcion'
            TipoValuacion: , 'Tipo Valuacion', autocomplete, 'TiposValuacion', 'Codigo,Descripcion'
            Precio: , 'Precio', numeric,'#######0.0000000000'
            TipoValuacionAnt: , 'Tipo Valua. Ant.', autocomplete, 'TiposValuacion', 'Codigo,Descripcion'
            ModeloNegocio: , 'Modelo Negocio', autocomplete, 'ModelosNegocio', 'Codigo,Descripcion'
   end
   
   required_fields: Fecha:, Especie:, Cartera:, TipoValuacion:, Precio:
   
   validations: 
     Fecha:, $.val(Fecha:)>0, 'Debe ingresar una Fecha';
     Especie:, ppl.NoVacio($.val(Especie:)), 'Debe ingresar la Especie';
     Cartera:, ppl.NoVacio($.val(Cartera:)), 'Debe ingresar la Cartera';
     TipoValuacion:, ppl.NoVacio($.val(TipoValuacion:)), 'Debe ingresar Tipo de Valuacion';   
     Precio:, $.val(Precio:)>0, 'El precio debe ser positivo';
   
   validates_uniqueness_of_set: Fecha:, Especie:, Cartera:
end