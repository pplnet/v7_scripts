def abm 'EstadosCustodia'
   def grid
       Jerarquia:, Codigo:, Descripcion:, Habilitado: 
   end
   def key
       Jerarquia: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia:  , 'Jerarquia', 
             Codigo:     , 'Codigo'  , small_text
             Descripcion:,           , extra_large_text
             NrSaldo:    , 'NrSaldo' , numeric,'#########0'
          column
             Bcuelga: , 'Depende del Anterior' , check
             Habilitado: ,           , check
   end
   
   upper_case_fields: Codigo:
   
   disable:
        Jerarquia:,1=1;
        NrSaldo:,1=1;
        
   do_not_map: 
       Bcuelga:;
       
   when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESTADOSCUSTODIA', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   before_show_create_dialog:  do
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESTADOSCUSTODIA', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   hide_fields: 
       Bcuelga:;
       
   validates_max_length_of:
       Codigo:, 6,true;
       Descripcion:, 50,true;
       
   validates_uniqueness_of: Jerarquia:, Codigo:
end