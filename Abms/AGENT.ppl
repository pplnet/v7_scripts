#*********************************************************************************
#combos data sources.
set ds_CondicionIVA        = "INS:Inscipto|NOI:No Inscr.|NOR:No Resp.|EXE:Exento|GRA:Gran Con.|OTR:Otro|"
set ds_CondicionGanancias  = "INS:Inscripto|NOI:No Inscr.|EXE:Exento|NOR:No Resid.|OTR:Otro|"
 
#*********************************************************************************
def abm 'Agentes'
   def grid
       Codigo:, Nombre: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', extra_small_text
             Nombre: ,          , extra_large_text
             Direccion: ,          , extra_large_text
             Localidad: ,          , large_text
             CodigoPostal: , 'Codigo Postal', small_text
             Telefono: ,          , large_text
             Fax: ,          , 
       #**************************************************************************
       tab 'Valores'
          column
             CUIT: ,          , 
             NrIngBrutos: , 'Nr Ing. Brutos', 
             NrDNRP: , 'Nr DNRP', 
             ImpuestosInternos: , 'Imp. Internos', 
             CondicionIVA: , 'Condicion', combo, ds_CondicionIVA
             CondicionGanancias: , 'Ganancias', combo, ds_CondicionGanancias
             Alias1: ,          , 
             Observaciones: ,          , full_tab_text
   end
   upper_case_fields: Codigo:
end