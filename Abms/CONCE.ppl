def abm 'Conceptos'
   def grid
       Jerarquia:, Codigo:, Nombre:, Debito: 
   end
   def key
       Jerarquia: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia: , 'Jerarquia', 
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Observaciones: ,          , full_tab_text
             Debito: ,          , check
#             Bcuelga: ,          , check
   end
   upper_case_fields: Codigo:
end