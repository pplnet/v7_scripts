
set fsys = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+Dbo+".VARIABLES where Codigo='FECHASYS' ") 

def abm 'PARAMETROSVAR' 
    def grid
    Fecha:, Tipo:, Profundidad:, UsuarioCarga:, FechaCarga: 
    end
    def key
       Fecha:, Tipo:, Profundidad:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
            Fecha:                     ,, date,
            Tipo:                      ,, small_text,'XXXXXX'
            Profundidad:               ,, numeric,'######0.########'
            column
            UsuarioCarga:              , 'Usuario', autocomplete, 'Usuarios', 'Codigo,Nombre'
            FechaCarga:                ,'Fecha Carga', date,fsys
    end
    upper_case_fields: Tipo:
    before_show_create_dialog: do 
       $.disable(UsuarioCarga:, FechaCarga: )
       $.set_field(Fecha:, fsys)
       $.set_field(FechaCarga:, fsys)
       $.set_field(UsuarioCarga:, ppl.UsuarioActivo)
    end 
    validates_uniqueness_of:  Fecha:, Tipo:, Profundidad:
    validates_max_length_of:
       Tipo:  , 6,true;                   
end

