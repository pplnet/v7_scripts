 
#*********************************************************************************
#combos data sources.
set ds_Tipo                = "MON:Monto|PRE:Precio|"
 
#*********************************************************************************
def abm 'TiposMeta'
   def grid
       Codigo:, Descripcion: , Tipo:
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , extra_large_text
             Tipo: ,          , combo, ds_Tipo
   end
   upper_case_fields: Codigo:
end