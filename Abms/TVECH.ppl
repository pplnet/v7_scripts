 
#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'TasasVehiculo'
   def grid
       Vehiculo1:, Vehiculo2:, Especie:, Tipo:, Fecha:, Tasa: 
   end
   def key
       Vehiculo1:, Vehiculo2:, Especie:, Fecha:, Tipo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Tipo: ,          , small_text
             Fecha: ,          , 
             Vehiculo1: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             Vehiculo2: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             Tasa: ,          , numeric
   end
   upper_case_fields: Vehiculo1:, Vehiculo2:, Especie:
end