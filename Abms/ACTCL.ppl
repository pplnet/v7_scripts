#*********************************************************************************
#combos data sources.
set ds_TipoAcuerdo         = "SOB:Sobre Giro|REM:Remunerada|"
 
#*********************************************************************************
def abm 'AcuerdosTiposCliente'
   def grid
       Producto: , TipoAcuerdo:, TipoCliente:, FechaAlta:, FechaFin: 
   end
   def key
       Producto:, TipoAcuerdo:, TipoCliente:, FechaAlta: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Producto: ,          , autocomplete, 'Productos', 'Codigo,Descripcion'
             TipoAcuerdo: ,          , combo, ds_TipoAcuerdo
             FechaAlta: , 'FechaAlta ', 
             FechaFin: , 'FechaFin ', 
             TipoCliente: ,          , autocomplete, 'TiposCliente', 'Codigo,Descripcion'
       #**************************************************************************
       tab 'Valores'
          column
             Monto1: ,         , numeric
             Monto2: ,         , numeric
             Monto3: ,         , numeric
             Monto4: ,         , numeric
             Monto5: ,         , numeric
             Tasa5: ,          , numeric
             Tasa4: ,          , numeric
             Tasa3: ,          , numeric
             Tasa2: ,          , numeric
             Tasa1: ,          , numeric
   end
   upper_case_fields: Producto:
end