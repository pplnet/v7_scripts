def abm 'ModelosNegocio'
    def grid
        Codigo:, Descripcion:, Observaciones:, Books:, RankingTiposValuacion:, ValuaCarteraPartida:, ValuaORICartera:
    end
    def key
        Codigo:
    end
   def dialog
        tab 'General' 
          column
             Codigo:                , 'Codigo:', small_text,'XXXXXX'
             Descripcion:           , 'Descripcion:', text
             Observaciones:         , 'Observaciones:', large_text
             Books:                 , 'Carteras', autocomplete_ar_list, 'Books', 'Codigo,Descripcion'
             RankingTiposValuacion: , 'Rankings Tipos Valuacion'  , autocomplete_ar_list, 'RankingsTiposValuacion', 'Codigo,Descripcion'
          column
             ValuaCarteraPartida: ,'Valúa Cartera por Partida', check
             ValuaORICartera: ,'Valúa ORI por Partida', check
   end
   upper_case_fields: Codigo:
   
   validations: 
       Codigo:, ppl.Vacio(ppl.SQL("Select 1 from ModelosNegocio where Codigo = '"+$.val(Codigo:)+"'")) OR __action__ <> "A", 'Clave duplicada';
       Codigo:, ppl.NoVacio($.val(Codigo:)), 'El codigo no puede ser vacio';       
       Descripcion:, ppl.NoVacio($.val(Descripcion:)), 'El codigo no puede ser vacio';            
       
   validates_max_length_of:
       Codigo:,8,true; 
       Descripcion:,40,true;
       Observaciones:,40,true;
       Books:,700,true;
       RankingTiposValuacion:,700,true;

   before_delete: do
        If $.Baja() 
            If ppl.NoVacio($.val(Books:))
                $.Alert('No se pueden eliminar Modelos de negocio con carteras asociadas.')
                false
            else
                If ppl.NoVacio($.val(RankingTiposValuacion:))
                   $.Alert('No se pueden eliminar Modelos de negocio con Ranking Tipo Valuación asociados.')
                   false
                else
                   true
                EndIf   
            EndIf
        else
            true
        EndIf    
   end
   after_save:  do 
        set book = $.val(Books:)
        set codigo = $.val(Codigo:)
        $.EjecutarEvento('MOBOOK', {Lista1:book,String1:codigo})
   end   
   validates_uniqueness_of: Codigo:
   
end