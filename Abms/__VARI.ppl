def abm 'Variables' 
    def grid
        Codigo:, Nombre:, Valor:
    end
    def key
        Codigo:
    end
    def dialog_size
        520,250
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
            Codigo: ,, small_text,'XXXXXXXXXX'
            Nombre: ,,large_text,'XXXXXXXXXXXXXXXXXXXXXXXXX'
                Valor: ,, extra_large_text
    end
    upper_case_fields: Codigo:
    before_save:  do
        if $.HasPermissionOnVariable (sender.Codigo) <> true
            $.Alert('No tiene permisos sobre la variable '+$.val(Codigo:))
            false
        else    
            true
        end
   end
   validates_uniqueness_of: Codigo:
end