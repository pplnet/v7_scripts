def abm 'Provincias'      
    def grid
    Codigo:, Nombre:, Alias1:, AliasAfip:,AliasCore:
    end
    def key
        Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'       
            column          
                Codigo: ,,    small_text
                Nombre: ,,    large_text
                NomExterno:     ,'Nombre UIF', large_text                
                Alias1: ,,    small_text                            
                AliasAfip:,,   small_text
                AliasCore:,,   small_text

                end
    upper_case_fields: Codigo:
    validates_max_length_of:
       Codigo:, 6,true;
       Nombre:, 30,true;
       Alias1:, 6,true;
       AliasAfip:, 2,true;
       AliasCore:, 2,true;
    validates_uniqueness_of: Codigo:
end