def abm 'TiposTasa'
   def grid
   Codigo:, Nombre:, EspecieValida:, TiposOperacion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text,'XXXXXX'
             Nombre: ,          , large_text
             EspecieValida: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             Base: , 'Base', small_text
             CodigoExterno: , 'Cod. Tasa Ext.'
             TiposOperacion: ,     , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
   end
   upper_case_fields: Codigo:
end