#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'Corresponsales'
   def grid
       Codigo:, Nombre:
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Telefono: ,          , large_text
             CodPostal: , 'Codigo Postal', small_text
             Localidad: ,          , 
             Direccion: , 'Direccion', extra_large_text
             DireccionEmail: , 'Direccion EMail', extra_large_text
             Fax: ,          , large_text
             Pais: ,          , autocomplete, 'Paises', 'Codigo,Nombre'
#             Provincia: , 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'
       #**************************************************************************
       tab 'Datos'
          column
             Contacto:     ,  , extra_large_text
             SWIFTAddress: ,  , text
             ABA:          ,  , large_text
             CHIP:         ,  , large_text
             Fedwire:      ,  , large_text
             Alias1:       ,  , large_text
             Alias2:       ,  , large_text
             Alias3:       ,  , large_text
   end
   upper_case_fields: Codigo:
end