#*********************************************************************************
#combos data sources.
set ds_Tipo                = "ANU:Anual|MEN:Mensual|"
set ds_ActPas              = "ACT:Activo|PAS:Pasivo|"
 
#*********************************************************************************
def abm 'PresupuestosMeta'
   def grid
       FechaPresupuesto:, TipoMeta:, Tipo:, FechaDesde:, FechaHasta:, Vehiculo:, Book:, TipoNegocio:, GrupoProducto: 
   end
   def key
       NrAutomatico: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             GrupoEspecie: , 'GruposEspecie', autocomplete, 'GruposEspecie', 'Codigo,Descripcion'
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             SubGrupoEspecie: ,          , autocomplete, 'SubGruposEspecie', 'Codigo,Descripcion'
             FechaPresupuesto: , 'Fecha Presupuesto', 
             FechaHasta: , 'Fecha Hasta', 
             FechaDesde: , 'Fecha Desde', 
             TipoMeta: , 'Tipo Meta', autocomplete, 'TiposMeta', 'Codigo,Descripcion'
             Tipo: ,          , combo, ds_Tipo
             Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             Book: ,          , autocomplete, 'Books', 'Codigo,Descripcion'
             TipoNegocio: , 'Tipo Negocio', autocomplete, 'TiposNegocio', 'Codigo,Descripcion'
             GrupoProducto: ,          , autocomplete, 'GruposProducto', 'Codigo,Descripcion'
#             SubGrupoProducto: , 'SubGrupoProducto', autocomplete, 'SubGruposProducto', 'Codigo,Descripcion'
             Producto: ,          , autocomplete, 'Productos', 'Codigo,Descripcion'
             ActPas: , 'Activo', combo, ds_ActPas
             TipoCliente: , 'Tipo Cliente', autocomplete, 'TiposCliente', 'Codigo,Descripcion'
             Responsable: ,          , autocomplete, 'Responsables', 'Codigo,Descripcion'
             Equipo: ,          , autocomplete, 'Equipos', 'Codigo,Nombre'
             Operador: ,          , autocomplete, 'Usuarios', 'Codigo,Nombre'
             Valor: ,          , numeric
   end
   
end