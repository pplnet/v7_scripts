#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'Gastos'
   def grid
       Codigo:, Descripcion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: , 'Descripcion', extra_large_text
             TipoGasto: , 'Tipo Gasto', autocomplete, 'TiposGasto', 'Codigo,Descripcion'
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             CuentaContable: ,          , autocomplete, 'Contabilidad', 'Codigo,Nombre'
             TiposOperacion: ,    , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
             Mercado: ,          , autocomplete, 'MERCADOS', 'Codigo,Descripcion'
          column
             IVA: ,          , check
       tab 'Valores'
          column
             Porcentaje: ,          , numeric,'#######0.0000000000'
             Minimo: ,          , numeric,'#######0.0000000000'
             Fijo: ,          , numeric,'#######0.0000000000'
             BasePorcentaje: , 'Base Porcentaje', numeric,'#######0.0000000000'
             DesdeMonto: , 'Desde Monto', numeric,'#######0.0000000000'
             HastaMonto: , 'Hasta Monto', numeric,'#######0.0000000000'
             PorcentajeBonif: , 'PorcentajeBonif', numeric,'#######0.0000000000'
   end
   before_show_create_dialog: do
      if $.Alta()
        $.set_field(Porcentaje:, 0)
        $.set_field(Minimo:, 0)
        $.set_field(Fijo:, 0)
        $.set_field(BasePorcentaje:, 0)
        $.set_field(DesdeMonto:, 0)
        $.set_field(HastaMonto:, 0)
        $.set_field(PorcentajeBonif:, 0)
      endif
   end
    validates_max_length_of:
        Codigo:,6 ,true;
        Descripcion:,30,true;
        TipoGasto:,6,true;
        Especie:,6,true;
        Vehiculo:,10,true;
        CuentaContable:,20,true;
        TiposOperacion:,80,true;
        Porcentaje:,30,true;
        Minimo:,30,true;
        Fijo:,30,true;
        BasePorcentaje:,30,true;
        DesdeMonto:,30,true;
        HastaMonto:,30,true;
        PorcentajeBonif:,30,true; 
  
   validates_uniqueness_of: Codigo:
   upper_case_fields: Codigo:
   
end