#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'Autocotizacion'
   def grid
       FechaDesde:, FechaHasta:, Especie:, MontoDesde:, MontoHasta:, TipoNegocio: ,Vehiculo: 
   end
   def key
       Especie:, FechaDesde: , MontoDesde: , TipoNegocio:, Vehiculo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             FechaDesde: , 'Fecha Desde', 
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             FechaHasta: , 'Fecha Hasta', 
             MontoDesde: , 'Monto Desde', numeric
             MontoHasta: , 'Monto Hasta', numeric
             PrecioCompra: , 'Precio Compra', numeric
             PrecioVenta: , 'Precio Venta', numeric
             TipoNegocio: ,          , autocomplete, 'TiposNegocio', 'Codigo,Descripcion'
             Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
       #**************************************************************************
       tab 'Adicional'
          column
             Precio1: , 'Tolerancia Compra', numeric
             Precio2: , 'Tolerancia Venta', numeric
             Precio3: ,          , numeric
             Precio5: ,          , numeric
             Precio4: ,          , numeric
   end
   upper_case_fields: Especie:
end