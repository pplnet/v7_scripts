def abm 'MENSAJES_CANALES'
   def grid
       Id:, Nombre: as 'Codigo', Descripcion:
   end
   def key
       Id: 
   end
   def dialog_size
       500,250
   end   
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Id: , , numeric,'#########0'
             Nombre: , 'Codigo', small_text
             Descripcion: ,,large_text
       #**************************************************************************
   end
   validates_uniqueness_of: Id:
   upper_case_fields: Nombre:

end

