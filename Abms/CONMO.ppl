   def grid
       Codigo:, Descripcion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: , 'Descripcion', extra_large_text
             Impuesto: ,          , check
             DebitaSiempre: ,          , check
             IVA: ,          , check
             Impuesto1: ,          , check
             Impuesto2: ,          , check
             Impuesto3: ,          , check
             CuentaContable1: , 'CuentaContable1 ', autocomplete, 'CNPlanCuentas', 'Codigo,Descripcion'
#             EsComision: ,          , check
