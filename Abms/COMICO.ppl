#*********************************************************************************
#combos data sources.
set ds_Agresor             = "AGE:Agresor|AGI:Agredido|AMB:Ambos|"
set ds_TipoCli             = "BRO:Broker|CEX:Cpte.Ext|CLO:Cpte.Local|BAN:Banco Local|"
set ds_TipoVal             = "PPR:% s/Precio|PMO:% s/Monto|BPS:BPS|MON:Monto Fijo|"
# FJL 24/5/19 - Por nuevo criterios de Comisiones
set ds_BaseCalculoSobre    = "VNO:Val.Nominal|MON:Monto|TAS:Tasa|"
set ds_RangoSobre          = "SIN:Sin Rango|VNO:Val.Nominal|MON:Monto|TAS:Tasa|PRE:Precio|"
set ds_AplicaPlazo         = "SI:Aplica|NO:No APlica|"

#*********************************************************************************
def abm "COMISIONESCORREDOR"
    def grid
        Corredor:, ListaEspecies:, ListaTipoOp:, MonedaOperada:, Agresor:, TipoValor:, RangoSobre:, RangoDesde:, RangoHasta:, AplicaPlazo:, PlazoDesde:, PlazoHasta:
    end
    def key
        Corredor:, ListaEspecies:, ListaTipoOp:, MonedaOperada:, Agresor:, TipoValor:, RangoSobre:, RangoDesde:, RangoHasta:, AplicaPlazo:, PlazoDesde:, PlazoHasta:
    end
    def dialog
        tab "General"
            column
                Corredor:         ,, autocomplete, 'CORREDORES', 'Codigo,Nombre'
                ListaEspecies:    ,, autocomplete_ar_list, 'ESPECIES', 'Codigo,Nombre'
                TipoValor:        ,, combo, ds_TipoVal
                BaseCalculoSobre: ,, combo, ds_BaseCalculoSobre
                RangoSobre:       ,, combo, ds_RangoSobre
                RangoDesde:       ,'Desde', numeric, '###,###,##0.0000'
                AplicaPlazo:      ,, combo, ds_AplicaPlazo
                PlazoDesde:       ,'Plazo Desde', numeric, '####0'
                ValMinimo:        ,'Val.Minimo', numeric, '###,###,##0.0000'
                TipoCliente:      ,, combo, ds_TipoCli
            column
                Agresor:        ,, combo, ds_Agresor
                ListaTipoOp:    ,    , autocomplete_ar_list, 'TIPOSOPERACION', 'Codigo,Nombre'
                Valor:          ,, numeric, '###,###,##0.0000'
                BaseCalculo:    ,, numeric, '###,###,##0.0000'
                Label21:        ,'',label
                RangoHasta:     ,'Hasta', numeric, '###,###,##0.0000'
                PorcentajePlazo:,'% a aplicar', numeric, '##0.0000'
                PlazoHasta:     ,'Plazo Hasta', numeric, '####0'
                ValMaximo:      ,'Val.Maximo', numeric, '###,###,##0.0000'
            column
                Label31:     ,'',label
                MonedaOperada:  ,'Mon.Operada', autocomplete, 'ESPECIES'  , 'Codigo,Nombre',''," "+dbo+".desciendedeespecie(Codigo,'MONEDA') = 1 "
                
    end
#    validates_uniqueness_of_set: Corredor:, ListaEspecies:, ListaTipoOp:, Agresor:, TipoCliente:
    validates_uniqueness_of_set: Corredor:, ListaEspecies:, ListaTipoOp:, Agresor:, TipoCliente:, TipoValor:, RangoSobre:, RangoDesde:, RangoHasta:, AplicaPlazo:, PlazoDesde:, PlazoHasta:

    
    before_show_create_dialog: do 
        $.hide(TipoCliente:)
        if $.Alta()
            #Combos que vienen con default
            $.set_field Agresor:, 'AMB'
            $.set_field TipoCliente:, 'BRO'
            $.set_field TipoValor:, 'POR'
            $.set_field BaseCalculoSobre:, 'VNO'
            $.set_field RangoSobre:, 'SIN'
            $.set_field RangoDesde:, 0
            $.set_field RangoHasta:, 0
            $.set_field AplicaPlazo:, 'NO'
            $.set_field PlazoDesde:, 0
            $.set_field PlazoHasta:, 0
        endif
    end

    before_show_dialog: do 
        $.hide(TipoCliente:)
    end
    
    when_change: AplicaPlazo: do
        If $.val AplicaPlazo: = 'SI'
            $.show(PlazoDesde:)
            $.show(PlazoHasta:)
            $.show(PorcentajePlazo:)
        else
            $.hide(PlazoDesde:)
            $.set_field PlazoDesde:, 0
            $.hide(PlazoHasta:)
            $.set_field PlazoHasta:, 0
            $.hide(PorcentajePlazo:)
            $.set_field PorcentajePlazo:, 0
        end
    end    
    
    when_change: RangoSobre: do
        If $.val RangoSobre: = 'SIN'
            $.hide(RangoDesde:)
            $.set_field RangoDesde:, 0
            $.hide(RangoHasta:)
            $.set_field RangoHasta:, 0
        else
            $.show(RangoDesde:)
            $.show(RangoHasta:)
        end
    end    
    
end
