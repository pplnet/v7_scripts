 
#*********************************************************************************
#combos data sources.
set ds_CallPut             = "CON:Contado|CAL:Call|PUT:Put|FUT:Futuro|"
 
#*********************************************************************************
def abm 'ReuterRics'
   def grid
       Codigo:, Descripcion: , Especie:, ContraEspecie:
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             FechaEj: , 'Fecha Ej', 
             PrecioEj: , 'Precio Ej', numeric
             CallPut: ,          , combo, ds_CallPut
             ContraEspecie: , 'Contraespecie', autocomplete, 'Especies', 'Codigo,Nombre'
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , extra_large_text
             RIC: ,          , large_text
             Tipo: , 'Tipo ', small_text
             Status: ,          , extra_small_text
             Cupon: ,          , extra_small_text
             FIDs: ,          , extra_large_text
   end
   upper_case_fields: Codigo:, Especie:
end