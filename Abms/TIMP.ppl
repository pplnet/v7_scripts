def abm 'TiposImpuesto'
   def grid
       Codigo:, Descripcion:, Cuenta: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , extra_large_text
             Cuenta: , 'Cuenta Contable', autocomplete, 'Contabilidad', 'Codigo,Nombre'
       #**************************************************************************
       tab 'Item'
          column
            Item:,,embeded_abm,"TIIMP1"
   end
   upper_case_fields: Codigo:
end