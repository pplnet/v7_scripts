set ds_TITOFIN            = "SI:SI|NO:NO"

def abm 'Contabilidad'
   def grid
       Jerarquia:, Codigo:, Nombre:,Tipo:, Vehiculo:, Moneda:, Especie:, TipoOp:, CuentaAjuste: 
   end
   def key
       Jerarquia: 
   end
   def dialog_size
        700,550
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia:   , 'Jerarquia', 
             Codigo:      , 'Codigo', large_text
             Nombre:      ,          , extra_large_text
             Titofin:  ,          , combo, ds_TITOFIN,40
             RubroContable: , 'Rubro', text
             Moneda:      ,          , autocomplete, 'Especies', 'Codigo,Nombre',''," "+dbo+".desciendedeespecie(Codigo,'MONEDA') = 1 "
             
             #Los siguientes campos del tab 'General' permanecen ocultos: CAL 27/10/2022
             
             Tipo:        , 'Tipo'   , small_text,'XXXX'
             Cliente:     ,          , autocomplete, 'CLIENTES', 'Codigo,RazonSocial'
             Vehiculo:    ,          , autocomplete, 'VEHICULOS', 'Codigo,Descripcion,Cliente'
             Especie:     ,          , autocomplete, 'ESPECIES', 'Codigo,Nombre'
             TipoOp:      , 'Tipo Operac.', autocomplete, 'TIPOSOPERACION', 'Codigo,Nombre'
             Cuenta:      ,          , autocomplete, 'Cuentas', 'Codigo,Nombre'
             CuentaAjuste:, 'Cuenta Ajuste', check 
                          
          column
             Bcuelga: , 'Depende del anterior' , check
             
       tab 'Adicional'
          column
             Sector:      ,          , small_text
             Alias:       ,          , extra_large_text
             Alias2:      ,          , extra_large_text
             Alias3:      ,          , extra_large_text
   end
    do_not_map: 
        Bcuelga:;
   disable:
        Jerarquia:;        
    before_show_create_dialog:  do
        if $.Alta()
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CONTABILIDAD', jerRef, $.val Bcuelga: = 'SI')
        endif
        if ppl.EqStr(ppl.Trim($.val Vehiculo:),'-1')
            $.set_field Vehiculo:, ppl.Var('VEHICON')
        endif
    end     
    before_show_dialog:  do
        if ppl.EqStr(ppl.Trim($.val Vehiculo:),'-1')
            $.set_field Vehiculo:, ppl.Var('VEHICON')
        endif 
    end    
    when_change: Vehiculo: do
        if ppl.EqStr(ppl.Trim($.val Vehiculo:),'-1')
            $.set_field Vehiculo:, ppl.Var('VEHICON')        
        endif         
    end
    when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CONTABILIDAD', jerRef, $.val Bcuelga: = 'SI')
        endif
    end      
    when_change: Codigo: do
        if $.Alta()
           $.set_field RubroContable: , ppl.Copy($.val(Codigo:),1,6);
        endif   
     end

       before_save:  do
       If $.val(Titofin:) = 'SI' and $.val(RubroContable:) = null
           $.Alert('Debe completar el Rubro Contable para Titofin!')
           false
       else
           true
       end
       
    If $.val(CuentaAjuste:) <> 'SI'
         $.set_field (CuentaAjuste:, 'NO')
       end
       true
      
       If $.val(Titofin:) <> 'SI'
         $.set_field (Titofin:, 'NO')
       end
       true
    end
    hide_fields: 
        Bcuelga:, Tipo:, Cliente:, Especie:, TipoOp:, Cuenta:, CuentaAjuste:;    
    validates_uniqueness_of: Codigo:, Jerarquia:
    upper_case_fields: Codigo:
   
    validates_max_length_of:
    RubroContable:, 6,true;
end

   