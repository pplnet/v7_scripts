#*********************************************************************************
#combos data sources.
set ds_Plazo = "Todos:Todos|0:Contado|24:24Hs|48:48Hs"
#*********************************************************************************
def abm 'ValuacionPorPlazo'
   def grid
      Codigo:, Descripcion:, TipoValuacion:, Plazo:
   end
   def key
      Codigo:, Plazo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          Codigo: , 'Codigo', small_text
          Descripcion: , 'Descripcion', large_text
          TipoValuacion:, 'Tipo Valuacion', autocomplete, 'TIPOSVALUACION', 'Codigo,Descripcion'
          Plazo:, 'Plazo', combo, ds_Plazo
   end
   
   upper_case_fields: Codigo:
   validations: 
     Codigo:, ppl.NoVacio($.val(Codigo:)), 'Debe ingresar un codigo valido.', 'error';
   validates_max_length_of:
     Codigo:, 10,true;
     Descripcion:, 40,true;
   validates_uniqueness_of: Codigo:
end