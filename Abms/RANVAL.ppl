def abm 'RankingsTiposValuacion'
   def grid
        Codigo:, Descripcion:, Especies:, TiposValuacion: 
   end
   def key
        Codigo:
   end
   def dialog
        tab 'General' 
          column
             Codigo:        , 'Codigo:', small_text,'XXXXXXXX'
             Descripcion:   , 'Descripcion:', text
             Especies:       ,'Jerarquia Especie', autocomplete_ar_list, 'ESPECIES','Codigo,Nombre'
             TiposValuacion: ,'Tipo Valuacion'  , autocomplete_ar_list, 'TIPOSVALUACION', 'Codigo,Descripcion'             
   end
   
   upper_case_fields: Codigo:
   validates_max_length_of:
       Codigo:,8,true; 
       Descripcion:,40,true;
       Especies:,700,true;
       TiposValuacion:,700,true;

#    when_change: Especies: do
#        set especie = $.val(Especies:)
#        set codigo = $.val(Codigo:)
#        $.EjecutarEvento('RAESPE', {Lista1:especie,String1:codigo})
#    end  
    
   validations: 
        Codigo:, ppl.Vacio(ppl.SQL("Select 1 from RankingsTiposValuacion where Codigo = '"+$.val(Codigo:)+"'")) OR __action__ <> "A", 'Clave duplicada';
        Codigo:, ppl.NoVacio($.val(Codigo:)), 'El codigo no puede ser vacio';
        Descripcion:, ppl.NoVacio($.val(Descripcion:)), 'La descripcion no puede ser vacia';
        
   before_delete: do
        If $.Baja() 
            If ppl.Incluido (ppl.SQLSet('Select Codigo from ModelosNegocio'),$.val(Codigo:))
                #$.Alert('No puede borrarse el ranking por estar asociado a algun modelo de negocio.')
                set codigo = $.val(Codigo:)
                $.EjecutarEvento('RAMONE', {String1:codigo})
                false
            else
                true
            EndIf
        else
            true
        EndIf
   end
   
   after_save:  do 
        set especie = $.val(Especies:)
        set codigo = $.val(Codigo:)
# Probar si se puede no validar repeticion de especies        
#        $.val($.EjecutarEvento('RAESPE', {Lista1:especie,String1:codigo}))
   end
   
   validates_uniqueness_of: Codigo:
end