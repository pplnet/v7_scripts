#*********************************************************************************
#combos data sources.
set ds_Status              = "HAB:Habilitado|DES:Deshabilitado|"
set ds_CondicionIVA        = "INS:Inscipto|NOI:No Inscr.|NOR:No Resp.|EXE:Exento|GRA:Gran Con.|OTR:Otro|"
set ds_CondicionGanancias  = "INS:Inscripto|NOI:No Inscr.|EXE:Exento|NOR:No Resid.|OTR:Otro|"
 
#*********************************************************************************
def abm 'Corredores'
   def grid
       Codigo:, Nombre:, Direccion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Direccion: ,          , extra_large_text
             Localidad: ,          , large_text
             CodPostal: ,          , small_text
             Telefono: ,          , large_text
             Fax: ,          , large_text
             Pais: ,          , autocomplete, 'Paises', 'Codigo,Nombre'
          Column
             Status: , 'Status', combo, ds_Status
       #**************************************************************************
       tab 'Codigos'
          column
             CUIT: , 'Comision 1', 
             NrIngBrutos: , 'Nr Ing Brutos', 
             NrDNRP: , 'Nr DNRP', 
             ImpuestosInternos: , 'Imp Internos', 
             CondicionIVA: , 'Condicion', combo, ds_CondicionIVA
             CondicionGanancias: , 'Ganancias', combo, ds_CondicionGanancias
       tab 'Defaults'             
       column
             ComisionDefault1: , 'Comision 1', numeric
             ComisionDefault2: , 'Comision 2', numeric
             ComisionDefault3: , 'Comision 3', numeric
             ComisionDefault4: , 'Comision 4', numeric
             ComisionDefault5: , 'Comision 5', numeric
             ComisionDefault6: , 'Comision 6', numeric
             ComisionDefault7: , 'Comision 7', numeric
             ComisionDefault8: , 'Comision 8', numeric
             ComisionDefault9: , 'Comision 9', numeric
             ComisionDefault10: , '% Tope s/Monto', numeric
         column
             Alias1: , 'Codigo MAE',,'XXX'
             Alias2: , 'Alias2', large_text
             Alias3: , 'Alias3', large_text
             Alias4: , 'Alias4', large_text
             Alias5: , 'Alias5', large_text
             Alias6: , 'Alias6', large_text
             Alias7: , 'Alias7', large_text
             Alias8: , 'Alias8', large_text
             Alias9: , 'Alias9', large_text
             Alias10: , 'Alias10', large_text
   end
   upper_case_fields: Codigo:
   validates_max_length_of:
   Codigo:, 10,true;
   Nombre:, 50,true;
   Direccion:, 40,true;
   Localidad:, 20,true;
   CodPostal:, 10,true;
   Telefono:, 20,true;
   Fax:, 20,true;
   CUIT:, 15,true;
   NrIngBrutos:, 15,true;
   NrDNRP:, 15,true;
   ImpuestosInternos:, 15,true;
   Alias1:, 3,true; 
   Alias2:, 3,true; 
   Alias3:, 3,true; 
   Alias4:, 3,true; 
   Alias5:, 3,true; 
   Alias6:, 3,true; 
   Alias7:, 3,true; 
   Alias8:, 3,true; 
   Alias9:, 3,true; 
   Alias10:, 3,true;
   validates_uniqueness_of: Codigo:
end