#*********************************************************************************
#combos data sources.
set ds_AfectaPorDefecto  = "Limites:Limites|Saldos:Saldos|"
set ds_SiNo               = "SI:SI|NO:NO|"
#*********************************************************************************
def abm 'Canales'
   def grid
   Codigo: , Descripcion: , AfectaPorDefecto:, EditarAfectacion:
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: ,, small_text
             Descripcion: ,,large_text
             AfectaPorDefecto: ,, combo, ds_AfectaPorDefecto
             EditarAfectacion: ,, combo, ds_SiNo
   end
   upper_case_fields: Codigo:
end