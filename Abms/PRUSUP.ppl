def abm 'ABM_PADRE'
   
   def grid
   Nombre:, DNI:
   end
   def key
    DNI:
   end
   def dialog
        tab "General"
        column
        Codigo:, 'Codigo', numeric
        DNI: , 'DNI', small_text
        Nombre: , 'Nombre'   , small_text
        
        tab 'Embebido'
        column
        Embebido:, 'Embebido' ,embeded_abm_large,"PRSUP2"
    end
    
    validates_uniqueness_of: DNI:

end