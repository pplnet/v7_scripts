#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'ArancelesCliente'
   def grid
       Arancel: , Cliente: 
   end
   def key
       Arancel: , Cliente: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Arancel: ,          , autocomplete, 'Aranceles', 'Codigo,Descripcion'
             Cliente: , 'Cliente', autocomplete, 'Clientes', 'Codigo,RazonSocial'
       #**************************************************************************
       tab 'Valores'
          column
# FJL 11/01/22 - Cambio mascaras
#             Porcentaje: ,  , numeric, '#######0.000000000'
#             Minimo: , , numeric, '#######0.000000000'
#             Fijo: , , numeric, '#######0.000000000'
#             BasePorcentaje: , 'Base Porcentaje', numeric, '#######0.000000000'
#             Maximo: , 'Maximo', numeric, '#######0.000000000'
             Porcentaje: ,  , numeric, '##,###,##0.0000'
             Minimo: , , numeric, '##,###,##0.00'
             Fijo: , , numeric, '##,###,##0.00'
             BasePorcentaje: , 'Base Porcentaje', numeric, '##,###,##0.0000'
             Maximo: , 'Maximo', numeric, '##,###,##0.00'
   end
   before_show_create_dialog: do
      if $.Alta()
        $.set_field(Porcentaje:, 0)
        $.set_field(Minimo:, 0)
        $.set_field(Fijo:, 0)
        $.set_field(BasePorcentaje:, 0)
        $.set_field(Maximo:, 0)
      endif
   end
   upper_case_fields: Arancel:
end