#combos data sources.
 
#*********************************************************************************
def abm 'GruposEconomicos'
   def grid
       Cliente:, Controlante:, Porcentaje:, TipoGrupo: 
   end
   def key
       Cliente:, Controlante: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Cliente: , 'Cliente', autocomplete, 'Clientes', 'Codigo,RazonSocial'
             Controlante: ,          , autocomplete, 'Controlantes', 'Codigo,RazonSocial'
             Porcentaje:,,numeric
             TipoGrupo: , 'TipoGrupo', autocomplete, 'TiposGrupo', 'Codigo,Descripcion'
   end
   validates_max_length_of:
   Cliente:, 10,true;  
   Controlante:, 10,true;
   validates_uniqueness_of_set: Cliente:, Controlante:
   upper_case_fields: Cliente:
end