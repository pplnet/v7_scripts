def abm "CLIENTESDOCUMENTACION"
    def grid
        Codigo:,
        Documento:,
        Fecha:,
        Recibido:,
        NrCOPERS:
    end
%%ifndef MLASA
    def filter
        "Codigo = '" + $.parent('Codigo') + "'"
    end
%%endif
    def key
        Codigo:, Documento:
    end
    def dialog
        #**************************************************************************
        tab "General"
            column
                Codigo:,, autocomplete, 'Clientes', 'Codigo,RazonSocial'
                Documento: ,, text
                Fecha:, , date
                Recibido:,, check
                NrCOPERS:, , text

    end

    validates_max_length_of:
       Codigo:,10,true; 

    validates_uniqueness_of_set: Codigo:, Documento:
    
%%ifdef MLASA
    validations:
    NrCOPERS:, $.val(NrCOPERS:)<>'', 'NrCOPERS debe Completarse','error'
%%endif    
    
end
