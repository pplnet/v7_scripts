   required_fields: Codigo:, MonedaEmision:, Cotiza:, MercadoDef:
   upper_case_fields: Codigo:, Alias9:
   %%ifdef MLASA
      disable: Jerarquia:,NombreJerarquia:,EstadoOperativo:,1=1;
   %%else
      disable: Jerarquia:,NombreJerarquia:,1=1;
   %%endif
   
   # Esto hace que no el campo no se grabe.
   do_not_map: Bcuelga:, NombreJerarquia:;
   
   when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESPECIES', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   when_change: Marketability: do
    If $.val Marketability: = 'SI' and $.val Alias9: = null
        $.Alert('Debe completar el nombre del cupón en variable!') 
    end
   end
   
   # Este callback se ejecuta despues de grabar un registro.
   # (El evento necesita que ya exista la especie en la tabla)
   after_save:  do

      If ppl.DesciendeDeEspecie($.val(Codigo3:) ,'TITULO')
         # Cuando es Alta de registro...
         If __action__ = "A"
            # GenerarCupon = SI
            If $.val Marketability: = 'SI'
               If $.val Alias9: = null
                   $.Alert('Debe completar el nombre del cupón en variable!')
                   false
                else
                   set especie = $.val(Codigo:);
                   $.EjecutarEvento('GENCUP', {especie1:especie})
               end
            end
         end   
      end
     
      If __action__ = "A"
         If $.val ZeroCoupon: = 'SI'
            #$.Alert('Hay que generar cupon!')
            set especie = $.val(Codigo:);
            $.EjecutarEvento('GENZER', {especie1:especie})
         end
         if $.val (CodAlfCajaValores:) <> ''
            set especie = $.val(Codigo:)
            set EspMerc1 = $.val(CodAlfCajaValores:);
            $.EjecutarEvento('GESPME', {especie1:especie,string1:EspMerc1,string2:'M',string3:'',string4:'',Cantidad1:0})
         endif
         if $.val (CodMAEContado:) <> ''
            set especie2 = $.val(Codigo:)
            set EspMerc2 = $.val(CodMAEContado:);
            set mercadoDef1 = $.val(MercadoDef:)
            $.EjecutarEvento('GESPME', {especie1:especie2,string1:EspMerc2,string2:'M',string3:'',string4:mercadoDef1,Cantidad1:1})   

         endif 

      endif
   endif
   
    
    when_change: Indexado: do
        If $.val Indexado: = 'SI'
            $.show(Indice:)
        else
            $.hide(Indice:)
            $.set_field Indice:, ''
        end
    end

    when_change: TasaCER: do
        If $.val TasaCER: = 'FLO'
            $.show(TiposTasas:)
            $.show(Spread:)
# FJL 06/03/20 - Nueva opcion calculo tasa variable
            If $.val Alias7: = 'SI'
                $.hide(Diasprom:)
                $.set_field Diasprom:, 0
                $.hide(TasaalVto:)
                $.set_field TasaalVto:, 'NO'
            else
                $.show(Diasprom:)
                $.show(TasaalVto:)
            endif
            $.show(Diasatras:)
            $.show(TasaMax:)
            $.show(TasaMin:)
# FJL 06/03/20 - Nueva opcion calculo tasa variable
            $.show(Alias7:)
            $.set_field TasaalVto:, true 
        else
            $.hide(TiposTasas:)
            $.set_field TiposTasas:, ''
            $.hide(Spread:)
            $.set_field Spread:, 0
            $.hide(Diasprom:)
            $.set_field Diasprom:, 0
            $.hide(Diasatras:)
            $.set_field Diasatras:, 0
            $.hide(TasaalVto:)
            $.set_field TasaalVto:, 'NO'
            $.hide(TasaMax:)
            $.set_field TasaMax:, 0
            $.hide(TasaMin:)
            $.set_field TasaMin:, 0
# FJL 06/03/20 - Nueva opcion calculo tasa variable
            $.hide(Alias7:)
            $.set_field Alias7:, 'NO'
        end
    end    

    before_show_dialog: do 
      $.set_field Stype:, $.val(CodAlfCajaValores:)
      
      #$.hide(Stype:)
      if $.Alta()
         $.set_field ZeroCoupon:, false
         $.Enable(Cupon:)
      endif
    end

   before_save:  do
   If ppl.DesciendeDeEspecie($.val (sender.Codigo),'TITULO') 
        If __action__ = "A"
           If $.val Issuer: = null
              $.Alert('Debe completar el campo Issuer antes de guardar ')
              false
           endif
          If $.val PaisOrigen: = null 
             $.Alert('Debe completar el campo PaisOrigen antes de guardar ')
             false

          endif
         endif
        If $.val ZeroCoupon: = 'SI'
           If $.val Cupon: > 1
              $.Alert('La especie es ZeroCoupon y el # cupon es > 1.')
              false
#              RespMessage = 2
#              set RespMessage =  ppl.MessageBox('La especie es ZeroCoupon y el # cupon NO es 0. Confirma?',1,1)
#              ppl.MessageBox(RespMessage)
#              if ppl.MessageBox('La especie es ZeroCoupon y el # cupon NO es 0. Confirma?',1,2) = 6
#                 true
#              else
#                 false
#              end
           endif
        else
           If $.val Cupon: = 0
              $.Alert('El # cupon es 0 y la especie NO es ZeroCoupon.')
              false

           endif
    endif
endif    

 If __action__ <> "B"
        # AA 30/12/2021 actualizacion EspeciesMercados
        If $.Modificacion()
                
                set especie = $.val(Codigo:)
                set EspMerc1 = $.val(CodAlfCajaValores:)
                set EspMerc2 = $.val(Stype:);  
                set CodAlfCajaValores = $.val(CodAlfCajaValores:)
                set existeCodAlfCaja = ppl.SQL("Select 1 from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodAlfCajaValores+"' ")
                set especieCodAlfCaja = ppl.SQL("Select especie from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodAlfCajaValores+"' ")
                set mercadoBYMA = ppl.SQL("Select mercado from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodAlfCajaValores+"' and Mercado = 'BYMA'")
                
                If ppl.NoVacio(CodAlfCajaValores) and ppl.EqStr(existeCodAlfCaja, '1') and ppl.NoVacio(mercadoBYMA)
                    If Especie<>especieCodAlfCaja
                        #$.Alert('CodigoBYMA ARP :'+EspMerc1+' ya utilizado por :'+especieCodAlfCaja)
                        $.set_field CodAlfCajaValores:, $.val(Stype:)
                        false
                    Else
                        true
                    End
                Else
                    $.EjecutarEvento('GESPME', {especie1:especie,string1:EspMerc1,string2:'M',string3:EspMerc2,string4:'',Cantidad1:0})
                    true
                End
                
                set Especie = $.val(Codigo:)
                set CodMAEContado = $.val(CodMAEContado:)
                set mercadoDef1 = $.val(MercadoDef:)
                set existeCodMAE = ppl.SQL("Select 1 from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
                set especieCodMAE = ppl.SQL("Select Codigo from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
                set mercadoA3 = ppl.SQL("Select mercado from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodMAEContado+"' and Mercado = 'A3'")
                
                if ppl.NoVacio(especieCodMAE)
                
                    If ppl.NoVacio(CodMAEContado) and ppl.EqStr(existeCodMAE, '1') 
                        If Especie<>especieCodMAE
                            $.Alert('Codigo MAE existente')
                            false
                        Else
                            $.EjecutarEvento('GESPME', {especie1:Especie,string1:CodMAEContado,string2:'M',string3:'',string4:mercadoDef1,Cantidad1:1})
                            true
                        End
                    Else
                        true
                    End
                Else
                    $.EjecutarEvento('GESPME', {especie1:Especie,string1:CodMAEContado,string2:'M',string3:'',string4:mercadoDef1,Cantidad1:1})
                    true
                   
                End
            
                set Especie = $.val(Codigo:)
                set CodMAEContado = $.val(CodMAEContado:)
                set mercadoDef1 = $.val(MercadoDef:)
                set existeCodMAE = ppl.SQL("Select 1 from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
                set especieCodMAE = ppl.SQL("Select Codigo from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
                set mercadoA3 = ppl.SQL("Select mercado from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodMAEContado+"' and Mercado = 'A3'")
                
                if ppl.NoVacio(especieCodMAE)                    
                    If ppl.NoVacio(CodMAEContado) and ppl.EqStr(existeCodMAE, '1') and ppl.NoVacio(MercadoA3)
                        If Especie<>especieCodMAE
                            $.Alert('Codigo MAE existente')
                            false
                        Else
                            If $.val (CodMAEContado:) <> $.val(Stype:)
                                $.EjecutarEvento('GESPME', {especie1:Especie,string1:CodMAEContado,string2:'M',string3:'',string4:mercadoDef1,Cantidad1:1})
                                false
                            else
                                true
                            end
                        End
                    Else
                        true
                    End
                Else
                    $.EjecutarEvento('GESPME', {especie1:Especie,string1:CodMAEContado,string2:'M',string3:'',string4:mercadoDef1,Cantidad1:1})
                    true
                   
                End
            
        end

        set Especie = $.val(Codigo:)
        set CodMAEContado = $.val(CodMAEContado:)
        set mercadoDef1 = $.val(MercadoDef:)
        set existeCodMAE = ppl.SQL("Select 1 from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
        set especieCodMAE = ppl.SQL("Select Codigo from "+DBO+".ESPECIES where CodMAEContado = '"+CodMAEContado+"' ")
        set mercadoA3 = ppl.SQL("Select mercado from "+DBO+".ESPECIESMERCADOS where Codigo = '"+CodMAEContado+"' and Mercado = 'A3'")
        
        if ppl.NoVacio(CodMAEContado)
            If ppl.NoVacio(CodMAEContado) and ppl.EqStr(existeCodMAE, '1') and ppl.NoVacio(MercadoA3)
                If Especie<>especieCodMAE
                    $.Alert('Codigo MAE existente')
                    false
                Else
                    $.EjecutarEvento('GESPME', {especie1:Especie,string1:CodMAEContado,string2:'M',string3:'',Cantidad1:1})
                    true
                End
            Else
                true
            End
        Else
            true
        End
    Else
        true
    End
  
end

   
   before_show_create_dialog: do 
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('ESPECIES', jerRef, $.val Bcuelga: = 'SI')
            #Combos que vienen con default
            $.set_field DiasMes:, 'REA'
            $.set_field DiasAnio:, 'REA'
            $.set_field TasaMin:, 0
            $.set_field TasaMax:, 0
            # Codigo de la especie sender (a partir de la cual se genero la jerarquia)
            $.set_field Codigo3:, $.val(sender.CODIGO)
            $.set_field ZeroCoupon:, false
            $.Enable(Cupon:)
        endif
   end
      
# FJL 06/03/20 - Nueva opcion calculo tasa variable
    when_change: Alias7: do
        If $.val Alias7: = 'SI'
            $.hide(Diasprom:)
            $.set_field Diasprom:, 0
            $.hide(TasaalVto:)
            $.set_field TasaalVto:, 'NO'
        else
            $.show(Diasprom:)
            $.show(TasaalVto:)
        end
    end


   
   when_change: Jerarquia: do
    #$.Alert('Recalculando el padre de ' + $.val(Jerarquia:))
     if($.val(Jerarquia:) <> null)
        $.set_field(NombreJerarquia:, 
        ppl.BuscarCampo('ESPECIES', 'Codigo', 'Jerarquia', ppl.PadreJerarquia('ESPECIES', $.val(Jerarquia:))))
     endif
   end




   hide_fields: 
   Bcuelga:, Indice:,Spread:,Diasprom:,Diasatras:,TiposTasas:, TasaalVto:, Codigo3:;
   
   validations: 
   TasaMin:, (0 + $.val(TasaMin: )) <= (0 + $.val(TasaMax: )),'La tasa mínima no puede ser mayor a la máxima.'
        
