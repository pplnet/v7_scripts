#*********************************************************************************
#combos data sources.
set ds_Status              = "HAB:Habilitada|DES:Deshabilitada|"
set ds_InteresesC          = "DIR:Dirty|CLE:Clean|"
set ds_CotizaMAE           = "DIR:Dirty|CLE:Clean|"
set ds_DiasMes             = "30:30|REA:Real|30E:30E|31E:30E+1|"
set ds_DiasAnio            = "360:360|365:365|REA:Real|"
#set ds_Tipo                = "PUB:Publico|PRI:Privado|ONE:O.N.|FON:Fondo|MON:Moneda|OTR:Otro|"
set ds_Tipo                = ppl.SQLSet("SELECT  rtrim(Codigo)+':'+rtrim(Descripcion) from "+dbo+".TIPOESPECIE ")
set ds_TipoEC              = "ESC:Escritural|CAR:Cartular|"
set ds_TipoCartera         = "CON:Conservadora|MOD:Moderada|AGR:Agresiva|"
set ds_Modo                = "NOR:Normal|CAL:Called|PUT:Put|DEF:Default|"
set ds_IVA                 = "EXE:Exento|IVA:IVA|RNI:IVA RNI|"
set ds_FormaCalculoInts    = "IND:Indice|TAS:Tasa|"
set ds_PIKs                = "NO:No|SIE:Siempre|OPT:Optativo|"
set ds_Security            =  "0:I|1:II|2:III|3:Otro|" 
set ds_Tasa                =  "| |FIJ:Fija|FLO:Variable|"
set ds_DvTasa              =  "|COR:Fecha Corte|PAG:Fecha Pago|PAO:Fecha Pago Original|"
set CodBYMA                = ppl.SQLSet("SELECT CodAlfCajaValores from "+dbo+".ESPECIES ")
## EstadoOperativo Se utiliza en BOFA
set ds_EstadoOperativo     =  "SI:Sancionada|NO:No Sancionada|NE:No Informada"
# FJL 25/1/19 - Es campo Custon de Bofa
set ds_TipoTitulo          =  ":|LL:Lebac|TL:Titulo local|NL:Nobac|BP:Bopreal|"  
#set RespMessage = 10

#*********************************************************************************
def abm 'Especies'
   def grid
       Jerarquia:, Codigo:, Nombre:, Extendido:, ISIN: 
   end
   def key
       Jerarquia:, Codigo:
   end
   
    def context_menu
        "Copiar Especie", do
        set especie = sender.Codigo; 
        $.EjecutarEvento('COPESP', {especie1:especie})
        $.RefreshGrid()
       end 
   end
   
   def dialog

