#*********************************************************************************
#combos data sources.
set ds_Status              = "0:Activo|1:Baja|2:Bloqueado|"
set ds_DiasHabiles         = "HAB:Habiles|TOD:Todos|"
set Fechadia = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+dbo+".VARIABLES where Codigo='FECHASYS' ")
#*********************************************************************************
def abm 'Usuarios'
   def grid
       Jerarquia:, Codigo:, Nombre:, Perfil: 
   end
   def key
       Jerarquia: , Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia: , 'Jerarquia', 
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Perfil: , 'Perfil', autocomplete, 'PERFILES2', 'Codigo,Nombre'
             NroSIOPEL: ,          , number, '#####'
             OpROFEX: ,          , small_text, 'XXXXXXXXXXXXXXXXXXXXXXXXX'
          Column
             Bcuelga: , 'Depende del Anterior' , check
             Status: ,          , combo, ds_Status
           Column
             FDeshabilitacion: , 'Fecha des.'  , date
       #**************************************************************************
       tab 'Adicional'
          column
             Alias1: , , large_text
             Alias2: , , large_text
             Alias3: , , large_text
             HoraDesde: , ,time
             HoraHasta: , ,time
             UsuarioUltAct: ,'Usuario Activo' , large_text
          column
             DiasHabiles: , 'Dias', combo, ds_DiasHabiles
       #**************************************************************************
       tab 'Correo (Internet)'
          column
             PopAccount: , 'Cuenta' , extra_large_text
             RealName: , 'Nombre' , extra_large_text
             SMTP: ,          , extra_large_text
             ReturnAddress: , 'Remitente' , extra_large_text
       #**************************************************************************
       tab 'Firma'
          column
            Firma: ,          , full_tab_text
       #**************************************************************************
       tab 'Vehiculos'
          column
            Vehiculos:,,embeded_abm,"VEHEMB"
       #**************************************************************************
   end
   
   upper_case_fields: Codigo:
   
   disable:
    Jerarquia:,1=1;
    Firma:,1=1;
    FDeshabilitacion:,1=1;
   required_fields:
     Codigo:;
     Nombre:;
     Perfil:;
     
   do_not_map: 
     Bcuelga:,UsuarioUltAct:;
   
   when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('USUARIOS', jerRef, $.val Bcuelga: = 'SI')
        endif
    end

    before_show_create_dialog:  do
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('USUARIOS', jerRef, $.val Bcuelga: = 'SI')
        endif
    end
    
    hide_fields: 
        Bcuelga:;
        
    validates_max_length_of:
        Jerarquia:, 15,true;
        Codigo:, 10 ,true;
        Nombre:, 30 ,true;
        Perfil:, 10 ,true;
        NroSIOPEL:, 5 ,true;
        Alias1:, 20 ,true;
        Alias2:, 20 ,true;
        Alias3:, 20 ,true;
        PopAccount: ,40 ,true;
        RealName: ,40,true;
        SMTP:  ,40,true;
        ReturnAddress:,40,true;
        OpROFEX:, 25 ,true;
        
    validates_uniqueness_of: Jerarquia:, Codigo:
    
    before_save:  do
        $.set_field(UsuarioUltAct:, ppl.UsuarioActivo)
        If $.val(Codigo:) = $.val(UsuarioUltAct:)
            $.Alert('No puede modificar su propio usuario!')
            false
        else
            true
        endif
    end
    when_change: Status: do
    If $.val Status: = 1 or $.val Status: = 2
    $.set_field(FDeshabilitacion:, Fechadia)
    else 
      $.set_field(FDeshabilitacion:, ' ')
    end
    END
# FJL 14/04/20 - Se agrega OpRofex
#   if true  
#    do_not_map:
#        OpROFEX:;
#    hide_fields: 
#        OpROFEX:;
#   endif
   

end