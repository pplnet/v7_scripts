       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', extra_small_text
             Descripcion: , 'Descripicon', large_text
#             Usuario: , 'Usuario', autocomplete, 'Usuarios', 'Codigo,Nombre'
             Operador: ,          , numeric
             Nivel: ,          , numeric
