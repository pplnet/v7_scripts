
#*********************************************************************************
def abm 'Equipos'
   def grid
       Codigo:, Nombre:, Responsable: 
   end
   def key
       Codigo:, Responsable: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Responsable: ,          , autocomplete, 'Responsables', 'Codigo,Descripcion'
             Usuario: , 'Usuario', autocomplete, 'Usuarios', 'Codigo,Nombre'

   end
   upper_case_fields: Codigo:
end