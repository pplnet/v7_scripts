def abm 'Interfases'
   def grid
       Codigo:, Tipo:, Persona:, Lugar: 
   end
   def key
       Codigo:, Tipo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', large_text
             Persona: ,          , extra_large_text
             Tipo: ,          , autocomplete, 'TiposInterfaz', 'Codigo,Descripcion'
             Lugar: ,          , extra_large_text
             Fecha: ,          , 
             FechaDesde: , 'Fecha Desde', 
             FechaHasta: , 'Fecha Hasta', 
       #**************************************************************************
       tab 'GroupBox1'
          column
             Observaciones: ,          , full_tab_text
   end
   upper_case_fields: Codigo:
end