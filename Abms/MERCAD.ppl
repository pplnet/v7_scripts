#*********************************************************************************
#combos data sources.
set ds_Netea      = "SI:SI|NO:NO|"
set ds_Regulado   = "SI:SI|NO:NO|"
set ds_MTM        = "0:No aplica|1:Automatico (Liquida)|2:Manual (No liquida)|"
set ds_LiquidaMTM = "0:Diario|1:Mensual|2:Vto|3:No liquida|"
set ds_HabCor     = "HAB:Habiles|COR:Corridos|"
set ds_EsNegociacion  = "SI:SI|NO:NO|"
set ds_EsLiquidacion  = "SI:SI|NO:NO|"
set ds_AfectaCustodia = "SI:SI|NO:NO|"

#*********************************************************************************
def abm 'Mercados'
    def grid
    Codigo:, Descripcion:, Observaciones:, MercadoCotizacion: as 'Mercado Cot.' ,TipoNegocio:, Netea:, Regulado:
    end
    def key
       Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
                Codigo: ,, small_text
                Descripcion: ,,large_text
                Observaciones: ,, large_text
                TipoNegocio: ,'Producto', autocomplete_ar_list, 'TiposNegocio', 'Codigo,Descripcion'
                Cliente1: , 'Cliente' , autocomplete, 'Clientes', 'Codigo,RazonSocial'
                CodCNVInf: ,'CodCNV Inform.',small_text
                DescUIF: ,'Descripcion UIF',small_text
                PaisUIF: , 'Pais UIF', autocomplete, 'Paises', 'Codigo,Nombre' 
            column
                Netea: ,, combo, ds_Netea
                Regulado: ,, combo, ds_Regulado
                MTM: ,'MTM', combo, ds_MTM
                LiquidaMTM: ,'Freq.Liq.MTM', combo, ds_LiquidaMTM
                EspecieFix: ,, autocomplete, 'Especies', 'Codigo,Nombre'
                DiasAnt:     , 'Cant Dia Cotiz', numeric, '####0'
                HabCorr:    ,'Tipo Dia Cotiz', combo, ds_HabCor 
                TamanioLote: , 'Tamaño del Lote', numeric,'###########0.00000'
                TablaFeriados: ,'Feriados', autocomplete, 'Feriados', 'Codigo,Descripcion'
                CodigoExterno1: ,'Cod.Sist.Ext.', small_text
                EsNegociacion: ,, combo, ds_EsNegociacion
                EsLiquidacion: ,, combo, ds_EsLiquidacion
                AfectaCustodia: , 'Custodia', combo, ds_AfectaCustodia
           column
                MercadoCotizacion: , 'Mercado Cot.', autocomplete, 'MERCADOS', 'Codigo,Descripcion',''," tiponegocio like '%T%' or tiponegocio Like '%FT%'  "
    end
    before_show_create_dialog: do
        $.set_field Netea:, 'NO'
    end
     before_show_dialog: do
        If $.val Netea: = '' OR ppl.Vacio($.val(Netea:))
            $.set_field Netea:, 'NO'
        end
        If $.val Netea: = 'SI'
          $.Enable(AfectaCustodia:);
        else
          $.set_field AfectaCustodia:, ''
          $.Disable(AfectaCustodia:);
        end
    end

    upper_case_fields: Codigo:
    when_change: Regulado:, MTM: do
       If $.val Regulado: = 'SI' and $.val MTM: = 1
       
          $.Enable(LiquidaMTM:);
       else
          $.Disable(LiquidaMTM:);
       end
    end
    when_change: Regulado: do
       If $.val Regulado: = 'NO'
          $.Enable(DiasAnt:);
          $.Enable(HabCorr:);          
       else
          $.Disable(DiasAnt:);
          $.Disable(HabCorr:);
       endif
    end
    when_change: MTM: do
       If $.val MTM: = 2
          $.Disable(LiquidaMTM:);
          ##$.set_field LiquidaMTM:, 3
       else
       ## If $.val LiquidaMTM: = 3
          ##$.set_field LiquidaMTM:, 0
          ## end
          $.Enable(LiquidaMTM:);
       end
    end
    when_change: Netea: do
       If $.val Netea: = 'SI'
          $.Enable(AfectaCustodia:);
       else
          $.set_field AfectaCustodia:, 'NO' 
          $.Disable(AfectaCustodia:);
       end
    end
    validations: 
        Cliente1:, __action__ <> "A" and __action__ <> "M" or $.val(Netea:) <> 'SI' or $.val(Cliente1:) <> '', 'Debe completar el campo Cliente antes de guardar'
    
    validates_max_length_of:
       Codigo:, 6,true;
       Descripcion:, 40,true;
    validates_uniqueness_of: Codigo:   
end
