#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'TasasDia'
   def grid
       Fecha:, Especie:, TipoTasa:, PlazoDesde:, PlazoHasta:, Valor1: 
   end
   def key
       Fecha:, Especie:, TipoTasa:, PlazoDesde: 
   end
   def dialog_size
       650,350
   end  
 
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Fecha: ,          , date
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             TipoTasa: , 'Tipo Tasa', autocomplete, 'TiposTasa', 'Codigo,Nombre'
             PlazoDesde: , 'Plazo Desde', numeric ,'###0'
             PlazoHasta: , 'Plazo Hasta', numeric ,'###0'
             
       #**************************************************************************
       tab 'Valores'
          column
          Valor1: , 'Valor 1', numeric ,'###0.000000'
          Valor2: , 'Valor 2', numeric ,'###0.000000'
          Valor3: , 'Valor 3', numeric ,'###0.000000'
          Valor4: , 'Valor 4', numeric ,'###0.000000'
          Valor5: , 'Valor 5', numeric ,'###0.000000'
   end
   before_show_create_dialog: do
      set today = db.get_scalar("Select GetDate()")
      if $.Alta()
         $.set_field(Fecha:, today)
      endif
   end
   upper_case_fields: Especie:, TipoTasa:
   validates_uniqueness_of_set: Fecha:, Especie:, TipoTasa:, PlazoDesde:
end