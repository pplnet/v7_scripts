#*********************************************************************************
#combos data sources.
set ds_Habilitado            = "SI:SI|NO:NO"
#*********************************************************************************
def abm 'MODELOSASIENTO'
    def grid
        Codigo:, Descripcion:, Vehiculo:, Libro:, Book:  ,TipoAsiento:
    end
    def key
        Codigo:
    end
    def dialog
        tab 'General'
            column
                Codigo: , 'Codigo', small_text
                Descripcion: , 'Nombre', large_text
                #Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
                Libro: ,          , autocomplete, 'Libros', 'Codigo,Descripcion'
                Book: ,          , autocomplete, 'Books', 'Codigo,Descripcion'
                UDN: ,          , autocomplete, 'UDNS', 'Codigo,Descripcion'
                Centro: ,          , autocomplete, 'CentrosCosto', 'Codigo,Descripcion'
                Sector: ,          , autocomplete, 'Sectores', 'Codigo,Descripcion'
                TipoOp: ,          , autocomplete, 'TiposOperacion', 'Codigo,Nombre'
                TipoTr2: ,          , autocomplete, 'TiposTransaccion2', 'Codigo,Nombre'
                TipoAsiento: ,          , autocomplete, 'TiposAsiento', 'Codigo,Descripcion'
                #ClaseDocumento: ,          , autocomplete, 'ClasesDocumento', 'Codigo,Descripcion'
             column
                Habilitado:  ,'Habilitado', combo, ds_Habilitado
                Vehiculo: ,    , autocomplete_ar_list, 'Vehiculos', 'Codigo,Descripcion'                   
                
        tab 'Items'
            column
                Items:, 'Items' ,embeded_abm_large,"__MAS1"
    end

    do_not_map: 
        Items:
        
    validates_max_length_of:
        Codigo:, 10,true;
        Descripcion:, 40,true;

    validates_uniqueness_of: Codigo:
    upper_case_fields: Codigo:
end