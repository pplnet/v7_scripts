#*********************************************************************************
#combos data sources.
set ds_Tipo                = "DEB:Debito|CRE:Credito|"
 
#*********************************************************************************
def abm 'ConceptosCA'
   def grid
       Codigo:, Descripcion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , extra_large_text
             Tipo: ,          , combo, ds_Tipo
       #**************************************************************************
       tab 'Caja'
          column
             Alias3: , 'Cod BCRA', small_text
             Alias1: ,          , check
             Alias2: , 'Alicuota ', autocomplete, 'TiposAlicuota', 'Codigo,Descripcion'

   end
   upper_case_fields: Codigo:
end