set ds_SiNo              =  "|SI:Si|NO:No"
set fsys = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+Dbo+".VARIABLES where Codigo='FECHASYS' ") 

def abm 'METODOSVOLATILIDAD' 
    def grid
    Codigo:,Tipo:, Descripcion:, Vigente:, RuedasMax:, RuedasMin:, FactorRiesgo:, Formula:, Manual:,  FechaVigencia:, NivelConfianza:  
    end
    def key
    Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
            Codigo:                    ,, small_text,'XXXXXX'
            Descripcion:               ,,large_text,'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
            RuedasMax:                 ,, numeric,'##0'
            RuedasMin:                 ,, numeric,'##0'
            FactorRiesgo:              ,, numeric,'##0.########'
            Formula:                   ,, small_text,'XXXXXX'
            Manual:                    ,, combo, ds_SiNo
            FactorK:                   ,'I', numeric,'##0'

            Column
            FechaVigencia:             ,, date,
            Vigente:                   ,, combo, ds_SiNo
            Tipo:                    , , autocomplete, 'TIPOSVAR', 'Codigo,Descripcion,BCRA'
            ResidualEspecie:            ,, numeric,'######0'
            DiasDesarmeMenorResidual:  ,, numeric,'##0'
            DiasDesarmeMayorResidual:  ,, numeric,'##0'
            NivelConfianza:            ,, numeric,'#0.#'
            
            column
            UsuarioCarga:              , 'Usuario', autocomplete, 'Usuarios', 'Codigo,Nombre'
            FechaCarga:                ,'Fecha Carga', date,fsys
    end
    upper_case_fields: Codigo:,FechaCarga:
    before_show_create_dialog: do 
       $.disable(UsuarioCarga:,FechaCarga:)
       $.set_field(FechaVigencia:, fsys)
       $.set_field(FechaCarga:, fsys)
       $.set_field(UsuarioCarga:, ppl.UsuarioActivo)
    end 
    validates_uniqueness_of: Codigo:
    validates_max_length_of:
       Codigo:, 6,true;
       Descripcion:, 30 ,true;
       Formula:  , 30 ,true;    
       Manual:  , 3 ,true;
       Vigente:  , 3,true;               
       Tipo:  , 6,true;                   
end

