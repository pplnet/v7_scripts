#*********************************************************************************
def abm 'EspeciesMercados'
    def grid
       Mercado:, Codigo:, Especie:, Moneda:, MercadoE:, MercadoM:, MercadoT:, UnidadPrecio:
    end
    def key
       Mercado:, Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
                Mercado:  ,'Mercados'        , autocomplete, 'MERCADOS', 'Codigo,Descripcion'
                Codigo:   ,,small_text
                Especie:  ,'Especies'        , autocomplete, 'ESPECIES' , 'Codigo,Nombre,Extendido', ,"Status = 'HAB' AND " +dbo+".DesciendeDeEspecie(Codigo,'TITULO') = 1 "
                Moneda:   ,'Moneda'          , autocomplete, 'ESPECIES' , 'Codigo,Nombre', ,"Status = 'HAB' AND " +dbo+".DesciendeDeEspecie(Codigo,'MONEDA') = 1 "
                MercadoE: ,'Mercado Especie' , autocomplete, 'MERCADOS' , 'Codigo,Descripcion'
                MercadoM: ,'Mercado Mone.' , autocomplete, 'MERCADOS' , 'Codigo,Descripcion'
                MercadoT: ,'Mercado 3ros'    , autocomplete, 'MERCADOS' , 'Codigo,Descripcion'
                UnidadPrecio:, 'Unidad Precio' , numeric, '##0'
    end 
    upper_case_fields: Codigo:
    required_fields: Codigo:, Mercado:, Especie:
    
    before_show_dialog: do
      if __action__ = "M"
         $.Disable(Mercado:)
         $.Disable(Codigo:)
      else
        if __action__ = "A"
            $.Enable(Mercado:)
            $.Enable(Codigo:)
        endif
      endif
    end
    
    before_save: do
       If __action__ <> "B"
          If $.val(UnidadPrecio:)<0
             $.Alert('La Unidad de Precio debe ser Positiva')
             false
          Else
             true
          End
       Else
          true
       End
    End
    
    validates_max_length_of:
        Mercado:  , 6,true;
        Codigo:   ,10,true;
        Especie:  , 6,true;
        Moneda:   , 6,true;
        MercadoE: , 6,true;
        MercadoM: , 6,true; 
        MercadoT: , 6,true; 
    validates_uniqueness_of_set: Codigo:, Mercado:
end