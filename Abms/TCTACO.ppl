set value = ""
set queryTitofin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 WHERE TablaRC = '" + value + "')"
set queryEfectivoMinPF = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 WHERE TablaRC = '" + value + "')"
set queryCapitalMin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 WHERE TablaRC = '" + value + "')"

def abm 'TIPOCTACONT'     
    def grid
    Codigo:, Nombre:, EsDeInteres:, InformaTitoFin:, EfectivoMinPF: as 'Informa Ef.MinPF', CapitalMin: as 'Informa CapitalMin'
    end
    def key
        Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'     
            column 
                Codigo:                 ,,small_text,'XXXXXXXXXX'
                Nombre:                 ,,large_text
                EsDeInteres:            ,,check,
                InformaTitofin:         ,,check,
                Modelos:                ,'Mod Titofin',autocomplete_ar_list, 'MODELOSASIENTO', 'Codigo,Descripcion','',queryTitofin,
            column                
                EfectivoMinPF:          ,'Informa Ef.MinPF',check,
                ModelosEfectivoMinPF:   ,'Mod Ef.MinPF',autocomplete_ar_list, 'MODELOSASIENTO', 'Codigo,Descripcion','',queryEfectivoMinPF,
                CapitalMin:             ,'Informa CapitalMin',check,
                ModelosCapitalMin:      ,'Mod CapitalMin',autocomplete_ar_list, 'MODELOSASIENTO', 'Codigo,Descripcion','',queryCapitalMin,                
    end

    before_save:  do
        #TITOFIN
        If $.val(InformaTitofin:) <> 'SI'
            $.SetFields(Modelos:,'')
        EndIf     
        If $.val(InformaTitofin:) == 'SI' AND ppl.Vacio($.val(Modelos:))
            $.Alert('Debe seleccionar algun modelo para informar a Titofin')
            false
        Else
            #Efectivo Minimo PF
            If $.val(EfectivoMinPF:) <> 'SI'
                $.SetFields(ModelosEfectivoMinPF:,'')
            EndIf     
            If $.val(EfectivoMinPF:) == 'SI' AND ppl.Vacio($.val(ModelosEfectivoMinPF:))
                $.Alert('Debe seleccionar algun modelo para informar a Efectivo Minimo PF')
                false
            Else
                #Capital Minimo
                If $.val(CapitalMin:) <> 'SI'
                    $.SetFields(ModelosCapitalMin:,'')
                EndIf     
                If $.val(CapitalMin:) == 'SI' AND ppl.Vacio($.val(ModelosCapitalMin:))
                    $.Alert('Debe seleccionar algun modelo para informar a Capital Minimo')
                    false
                Else
                    true
                end 
            end 
        end   
    end  

    before_show_create_dialog:  do
        $.val(InformaTitofin:) = 'NO'
        $.hide(Modelos:)
        $.val(EfectivoMinPF:) = 'NO'
        $.hide(ModelosEfectivoMinPF:)  
        $.val(CapitalMin:) = 'NO'
        $.hide(ModelosCapitalMin:)         
        set codigo = $.val Codigo:
    end
    
    before_show_dialog: do    
        set codigo = $.val Codigo:
        
        #TITOFIN
        If $.val(InformaTitofin:) == 'SI'
            $.show(Modelos:)
        else
            $.hide(Modelos:)
        EndIf
        
        set queryTitofin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + codigo + "')"
        $.Set_where(Modelos:, queryTitofin)
        
        #Efectivo Minimo PF
        If $.val(EfectivoMinPF:) == 'SI'
            $.show(ModelosEfectivoMinPF:)
        else
            $.hide(ModelosEfectivoMinPF:)
        EndIf
        
        set queryEfectivoMinPF = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + codigo + "')"
        $.Set_where(ModelosEfectivoMinPF:, queryEfectivoMinPF)        
        
        #Capital Minimo
        If $.val(CapitalMin:) == 'SI'
            $.show(ModelosCapitalMin:)
        else
            $.hide(ModelosCapitalMin:)
        EndIf
        
        set queryCapitalMin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + codigo + "')"
        $.Set_where(ModelosCapitalMin:, queryCapitalMin)        
    end

    when_change: Codigo: do
        set value = $.val(Codigo:)

        #TITOFIN
        set queryTitofin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + value + "')"
        $.Set_where(Modelos:, queryTitofin)

        #Efectivo Minimo PF
        set queryEfectivoMinPF = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + value + "')"
        $.Set_where(ModelosEfectivoMinPF:, queryEfectivoMinPF)    
    
        #Capital Minimo
        set queryCapitalMin = "Codigo in (Select Modelo from "+dbo+".MODELOSASIENTO1 Where TablaRC = '" + value + "')"
        $.Set_where(ModelosCapitalMin:, queryCapitalMin)
    end
    
    when_change: InformaTitofin: do
        #TITOFIN
        If $.val(InformaTitofin:) == 'SI'
            $.show(Modelos:)
        else
            $.hide(Modelos:)
            #$.SetField(Modelos:,'')
        EndIf              
    end
    
    when_change: EfectivoMinPF: do
        #Efectivo Minimo PF
        If $.val(EfectivoMinPF:) == 'SI'
            $.show(ModelosEfectivoMinPF:)
        else
            $.hide(ModelosEfectivoMinPF:)
        EndIf      
    end

    when_change: CapitalMin: do
        #Capital Minimo
        If $.val(CapitalMin:) == 'SI'
            $.show(ModelosCapitalMin:)
        else
            $.hide(ModelosCapitalMin:)
        EndIf      
    end
    
    upper_case_fields: Codigo:
end