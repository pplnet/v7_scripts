#*********************************************************************************
#combos data sources.
set ds_Netea      = "SI:SI|NO:NO|"
set ds_Regulado   = "SI:SI|NO:NO|"
set ds_MTM        = "0:No Aplica|1:Liquida|2:No Liquida|"
set ds_LiquidaMTM = "0:Diario|1:Mensual|2:Vencimiento|"

#*********************************************************************************
def abm 'PlazosMercado'
    def grid
    MercadoNegociacion:, FechaVto:, Especie:, CodigoMercado:, Plazo: as 'Tam.Lote', NombreExtendido:
    end
    def key
       FechaVto:, Especie:, MercadoNegociacion:
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
                MercadoNegociacion: , 'Mercado Negociacion', autocomplete, 'Mercados', 'Codigo,Descripcion'
                FechaVto: , 'Fecha Vto', date
                Especie: , 'Especie', autocomplete, 'Especies', 'Codigo,Nombre'
                CodigoMercado: ,, text
                Plazo: ,'Tam.Lote',  numeric,'#########0'
                NombreExtendido: ,, extra_large_text 
    end
    upper_case_fields: MercadoNegociacion:
    validates_max_length_of:
       CodigoMercado:, 15,true;
       NombreExtendido:, 100 ,true;
end
