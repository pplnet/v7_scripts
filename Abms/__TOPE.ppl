def abm 'TiposOperacion'     
    def grid
        Codigo:, Nombre:, Inversa:
    end
    def key
        Codigo:
    end
    def dialog
        tab 'General'       
            column          
                Codigo: ,, small_text
                Nombre: ,, large_text
                Inversa: , 'Inversa', autocomplete, 'TIPOSOPERACION', 'Codigo,Nombre'
                TipoNegocio: ,'Tipo Negocio', autocomplete, 'TIPOSNEGOCIO', 'Codigo,Descripcion'
                ClaseOperacion: ,'Clase Operacion', autocomplete, 'CLASESOPERACION', 'Codigo,Descripcion'
         tab 'Script'
            column
                Script: ,          , full_tab_text
    end
    validates_uniqueness_of: Codigo: 
    upper_case_fields: Codigo:
    required_fields:
    Codigo:; 
    disable:
    Script:
end