#*********************************************************************************
#combos data sources.
set ds_PlazoLiq            = ":Todos|0:Contado|24:24Hs|48:48Hs|"
#*********************************************************************************
def abm 'TiposValuacion'
   def grid
      Codigo:, Descripcion:
   end
   def key
      Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          Codigo: , 'Codigo', small_text
          Descripcion: , 'Descripcion', large_text
#          ValDif: , 'Val. Dif.', check
#          PlazoLiq:, 'Plazo', combo, ds_PlazoLiq
   end
   
   upper_case_fields: Codigo:
#   before_show_create_dialog: do 
#      $.set_field(PlazoLiq:,' ')
#   end
   
   validations: 
     Codigo:, ppl.NoVacio($.val(Codigo:)), 'Debe ingresar un codigo valido.', 'error';
   validates_max_length_of:
     Codigo:, 6,true;
     Descripcion:, 40,true;
   validates_uniqueness_of: Codigo:
end