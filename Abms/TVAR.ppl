set ds_SiNo              =  "|SI:Si|NO:No"

def abm 'TIPOSVAR' 
    def grid
    Codigo:, Descripcion:, BCRA:
    end
    def key
        Codigo:
    end
    def dialog_size
        520,250
    end
    def dialog
        #**************************************************************************
        tab 'General'
            column
            Codigo: ,, small_text,'XXXXXX'
            Descripcion: ,,large_text,'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
            BCRA: , 'BCRA', combo, ds_SiNo
    end
   validates_max_length_of:
   Codigo:, 6,true;
   Descripcion:, 30 ,true;
   upper_case_fields: Codigo:

   validates_uniqueness_of: Codigo:
end