#*********************************************************************************
#combos data sources.
set ds_Jurisdiccion   = "ARG:Argentina|EXT:Exterior|"
set ds_TipoUSD        = "MEP:MEP|CAB:Cable|"
#*********************************************************************************
def abm 'PlazosParking'
   def grid
   MonedaEmision:,MonedaCpra:,TipoUSDCpra:,JurisCpra:,MonedaVta:,TipoUSDVta:,JurisVta:,DiasParking:
   end
   def key
   MonedaEmision:,MonedaCpra:,TipoUSDCpra:,JurisCpra:,MonedaVta:,TipoUSDVta:,JurisVta:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
            MonedaCpra: , 'Mon.Cpra', autocomplete, 'Especies', 'Codigo,Nombre'
            JurisCpra: , 'Juris.Cpra.', combo, ds_Jurisdiccion
            MonedaVta: , 'Mon.Vta', autocomplete, 'Especies', 'Codigo,Nombre'
            JurisVta: , 'Juri.sVta.', combo, ds_Jurisdiccion
            MonedaEmision: , 'Mon.Emision', autocomplete, 'Especies', 'Codigo,Nombre'
            DiasParking: , 'Dias Parking', numeric,'#########0'
          column
            TipoUSDCpra: , 'USD.Cpra.', combo, ds_TipoUSD
            Label1:,'',label
            TipoUSDVta: , 'USD.Vta.', combo, ds_TipoUSD
   end
   upper_case_fields: MonedaCpra:,MonedaVta:
   when_change: MonedaCpra: do
      If $.val MonedaCpra: = 'USD'
         $.show(TipoUSDCpra:)
      else
         $.hide(TipoUSDCpra:)
         $.set_field TipoUSDCpra:, ''
      end
   end
   when_change: MonedaVta: do
      If $.val MonedaVta: = 'USD'
         $.show(TipoUSDVta:)
      else
         $.hide(TipoUSDVta:)
         $.set_field TipoUSDVta:, ''
      end
   end

   before_save:  do
     If $.val MonedaCpra: = 'USD'
        If $.val TipoUSDCpra: = ''
           $.Alert('Debe ingresar Tipo USD Cpra.')
           false
        else
           true
        end
     else
        true
     end
  end

#  validates_uniqueness_of: MonedaCpra:,TipoUSDCpra:,JurisCpra:,MonedaVta:,TipoUSDVta:,JurisVta:,MonedaEmision:

   
end
