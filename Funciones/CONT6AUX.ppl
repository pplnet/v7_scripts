SQL.ADD("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, S.NrSaldo, C.RazonSocial, ")
SQL.ADD("       S.CallPut, S.FechaEj, S.PrecioEj, C.RecibePreaviso, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes,S.NrSaldo as NumSalOri, '"~fbn('Moneda')~"' Moneda, E.VTeorico VT, E.Issuer ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  S.NrSaldo in ("~Pipe2Comillas(Val(SL:5))~") ")
SQL.ADD("       AND S.Cliente = C.Codigo ")
SQL.ADD("       AND S.Especie='"~fbn('Especie')~"' and S.Cupon= '"~FSTR(fbn('Cupon1'),1,0)~"' ")
SQL.ADD("       AND S.Especie = E.Codigo ")
SQL.ADD("       AND S.Saldo <> 0 ")
*If NoVacio(Dialogo.Lista1)
   *SQL.ADD("       AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
   *SQL.ADD("       AND S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("       AND S.EnteCustodia = '"~VAL(VH:1)~"'")
*EndIf
SQL.ADD("       AND isnull(S.CallPut,'') In ('CALL','PUT') ")
SQL.ADD("       AND S.Fecha=( ")
SQL.ADD("                    SELECT Max(S1.Fecha)  ")
SQL.ADD("                    FROM   "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE  S1.Cliente = S.Cliente ")
SQL.ADD("                           AND   S1.Especie = S.Especie ")
SQL.ADD("                           AND   S1.Mercado = S.Mercado ")
SQL.ADD("                           AND   S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                           AND   S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                           AND   S1.Cupon = S.Cupon  ")
SQL.ADD("                           AND   S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                           AND   (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null) or (S1.CallPut='' and S.CallPut=''))")
SQL.ADD("                           AND   (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null) or (S1.FechaEj='' and S.FechaEj=''))")
SQL.ADD("                           AND   (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null) or (S1.PrecioEj='' and S.PrecioEj=''))")
SQL.ADD("                           AND   S1.Fecha <= '"~IdxDate(Val(FV:1))~"') ")
SQL.ADD("ORDER BY 6, 1, 2, 8, 9, 10, 5, 3, 4 ")
watch(SQL.batch)
Recorrer SQL
   *- Por Nro.Saldo + Cliente Sumarizo el monto del saldo
   *- Dejando Separados los montos + saldos originales (Para agrupar el libre disponibilidad 101 y 207 en 101)
   If Not EqStr(val(x2),Fstr(fbn('NrSaldo'),0,0)~fbn('Cliente')~FBN('Mercado')~FBN('Cuenta')) y val(z1)<>0 
      *- Escribo la linea del listbox
      IF Round(Val(x1),2)<>0
         ACN(g:val(w1), Val(x:1))

         *- Si quiere cobrar el cupon y no es un saldo bloqueado por caja de valores 
         If val(jo1)=6 y Not Incluido(Fstr(val(m:val(w1)),0,0),Val(dz6))

            *- Guardo los datos de la liquidacion '
            *- lb: Cuenta Efectivo lc:Precio ld: Monto en Efectivo
    
            *- Seleccion de la cuenta de efectivo
            ACT(lb:val(w1),'')
    
* 29/07/2004 SQL.ADD("SELECT Codigo,Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:val(w1))~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB'  ") 

            SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:val(w1))~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB' AND (Mercado IS NULL OR Mercado='' OR Mercado='BCRA' OR Mercado='"~Val(d:val(w1))~"') ") 
            Recorrer SQL
               dfa
               *If Vacio(val(lb:val(w1))) y [Incluido(FBN['Especies'],Dialogo.Especie2) o Incluido(FBN['Especies'],'MONEDA') ] 
               *   ACT(lb:val(w1),FBN['Codigo'])
               *EndIf
            Proximo
            If Vacio(val(lb:val(w1))) 
               ACT(lb:val(w1),Val(dz3))
            EndIf
            ACN(lc:val(w1), val(aa5))
            ACN(ld:val(w1), Val(x:1)*Val(lc:val(w1)))
            ACT(le:val(w1), fbn('Moneda'))
         EndIf
         SCN(w1,1)
      Else 
         BorrarCeldas(a:val(w1)..r:val(w1))
      ENDIF
   EndIf

   If Not EqStr(val(x2),Fstr(fbn('NrSaldo'),0,0)~fbn('Cliente')~fbn('Mercado')~FBN('Cuenta'))  
      ACT(x2,Fstr(fbn('NrSaldo'),0,0)~fbn('Cliente')~fbn('Mercado')~FBN('Cuenta'))
      ACN(x1,0)  

      Message(fbn('Cliente')~' '~VAL(b2)~' '~FBN['Mercado']~' '~FBN['Cuenta']~' '~Fstr(val(x1),0,2)  )

      ACT(a:val(w1), fbn('Cliente'))
      ACT(b:val(w1), Val(b2))
      ACT(c:val(w1), FStr(VAL(c2),1,0))
      ACT(d:val(w1), fbn('Mercado'))
      ACT(f:val(w1), fbn('Cuenta'))

      ACN(k:val(w1), 1)
      ACT(l:val(w1), '')
      ACN(m:val(w1), FBN['NrSaldo'])
  
      ACT(bl:val(w1), FBN['TipoCliente'])
      ACT(bm:val(w1), FBN['CondicionGan'])
      ACT(bn:val(w1), FBN['CondicionIVA'])
      ACT(bo:val(w1), FBN['Res3125'])
      ACT(bp:val(w1), FBN['InteresesC'])
      ACT(bq:val(w1), FBN['Cotiza'])
      ACN(br:val(w1), FBN['TasaIntVigente'])
      ACD(bs:val(w1), FBN['FechaCambioTasa'])
      ACT(bt:val(w1), FBN['Valor10'])
      ACN(bu:val(w1), FBN['TasaIntAnterior'])
      ACT(bv:val(w1), FBN['Valor9'])
      ACT(bw:val(w1), FBN['DiasAnio'])
      ACT(bx:val(w1), FBN['DiasMes'])
     
      ACT(o:val(w1), fbn('CallPut'))
      ACD(p:val(w1), fbn('FechaEj'))
      ACN(q:val(w1), fbn('PrecioEj'))
    
      IF Not Incluido(Val(o:val(w1)), 'CAL|PUT')
         ACN(r:val(w1), 1)
      ENDIF
    
      ACT(lb:val(w1),'')
      ACN(lc:val(w1), 0)
      ACN(ld:val(w1), 0)
      ACT(le:val(w1), fbn('Moneda'))
      ACN(VT:val(w1), fbn('VT'))
   EndIf

   SCN(x1,fbn('Saldo'))

   *- En t: Ubico los 101 puros y en u: ubico los 207 puros
   If FBN['NrSaldo']=101 y FBN['NumSalOri']=101
      ACN(t:val(w1),fbn('Saldo')) 
   EndIf
   If FBN['NrSaldo']=101 y FBN['NumSalOri']=207
      ACN(u:val(w1),fbn('Saldo')) 
   EndIf
   ACN(z:1, 1)
Proximo
IF Round(Val(x1),2)<>0
   ACN(g:val(w1), Val(x:1))

   *- Si quiere cobrar el cupon y no es un saldo bloqueado por caja de valores 
   If val(jo1)=6 y Not Incluido(Fstr(val(m:val(w1)),0,0),Val(dz6))
      *- Guardo los datos de la liquidacion '
      *- lb: Cuenta Efectivo lc:Precio ld: Monto en Efectivo
    
      *- Seleccion de la cuenta de efectivo
      ACT(lb:val(w1),'')
*29/07/2004      SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:val(w1))~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB'  ") 
      SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(a:val(w1))~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB' AND (Mercado IS NULL OR Mercado='' OR Mercado='BCRA' OR Mercado='"~Val(d:val(w1))~"') ") 
      Recorrer SQL
         dfa
         *If Vacio(val(lb:val(w1))) y [Incluido(FBN['Especies'],Dialogo.Especie2) o Incluido(FBN['Especies'],'MONEDA') ] 
         *   ACT(lb:val(w1),FBN['Codigo'])
         *EndIf
      Proximo
      If Vacio(val(lb:val(w1))) 
         ACT(lb:val(w1),Val(dz3))
      EndIf
      ACN(lc:val(w1), val(aa5))
      ACN(ld:val(w1), Val(x:1)*Val(lc:val(w1)))
      ACT(le:val(w1), fbn('Moneda'))
      ACN(VT:val(w1), fbn('VT'))
   EndIf
Else 
   BorrarCeldas(a:val(w1)..r:val(w1))
   SCN(w1,-1)
ENDIF

IF Val(z:1)<>0
   ***** Val(ha1) contiene desde donde estan los registros de custodia *****
*MessageBox(Val(AA:5))
*MessageBox(Val(LC:Val(HA:1)))
 If NO
   CrearListBox ; 'Arial,8,';'Saldos.'
       'OK'              ;k :Val(ha1)..k:val(w1);SI;;;40;CHECK
       'Cliente'         ;a :Val(ha1)..a:val(w1);NO;;;70;STRING
       'Especie'         ;b :Val(ha1)..b:val(w1);NO;;;60;STRING
       'Cupon'           ;c :Val(ha1)..c:val(w1);NO;;;40;STRING
       'Casa Cust.'      ;d :Val(ha1)..d:val(w1);NO;;;60;STRING
       'Cuenta'          ;f :Val(ha1)..f:val(w1);NO;;;100;STRING
       'Cantidad'        ;g :Val(ha1)..g:val(w1);NO;;;100;NUMERO;'###,###,###.##'
       'NrSaldo'         ;m :Val(ha1)..m:val(w1);NO;;;100;NUMERO;'###'
       'Precio del Cupon';lc:Val(ha1)..lc:val(w1);NO;;;90;NUMERO;'###.######'
       'Moneda'          ;le:Val(ha1)..le:val(w1);NO;;;50;STRING
       'Efectivo'        ;ld:Val(ha1)..ld:val(w1);NO;;;100;NUMERO;'###,###,###.##'
*       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(l:FLB)~"' AND Estado = 'HAB' AND TipoCuenta IN ('CC','CA','CUS') AND (Especies LIKE '%"~val(m:FLB)~"%' OR Especies LIKE '%"~IIf(EqStr(val(m:FLB),Val(dz1)),Val(dz2),Val(dz1))~"%')  "
       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(A:FLB+Val(ha1)-1)~"' AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS') AND (Especies LIKE '%"~val(le:FLB+Val(ha1)-1)~"%' OR Especies LIKE '%"~IIf(EqStr(val(le:FLB+Val(ha1)-1),Val(dz1)),Val(dz2),Val(dz1))~"%')  "
*       'CallPut'         ;o :Val(ha1)..o:val(w1);NO;;;40;STRING
*       'FechaEj'         ;p :Val(ha1)..p:val(w1);NO;;;50;FECHA
*       'PrecioEj'        ;q :Val(ha1)..q:val(w1);NO;;;60;NUMERO;'###.########'
   FinListBox

   IF NOT OK 
      Cancelar
   ENDIF
 ENDIF 
   Recorrer&i Val(HA:1),val(w1)
       ***---Calculo de la Renta por cada NrSaldo
       ACN(RT:2, Val(G:&i) * Val(RT:1) / 100)
       ***---Calculo de la Amort por cada NrSaldo       
       ACN(AM:2, Val(G:&i) * Val(AM:1) / 100)
       ***---NrSaldo
       ***---messagebox(val(M:&i))     
       IF Val(M:&i) = Var('BLOQMAE')
         ACT(SL:1, 'GTIAMAE')
       ELSE
       IF Val(M:&i) = Var('BLOQGROFEX')
           ACT(SL:1, 'GTIAROFEX')
         ELSE
           ACT(SL:1, 'CARTERA')
         ENDIF
       ENDIF
       SQL.ADD(" Select Codigo CodAsi, '"~Val(LE:&i)~"' Moneda, '"~Val(A:&i)~"' Cliente, '"~Val(ES:1)~"' Especie, 'TIC' TipoOp, "~Val(VT:&i)~" VT ")
       SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
       SQL.ADD(" Where TipoAsiento = '"~Val(TA:1)~"' ")
       SQL.ADD(" AND '|'+RTrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
       SQL.ADD(" AND Habilitado = 'SI' ")
       watch(sql.batch)
       Recorrer SQL 
         DFA
         ACN(CK:1, 0)
         IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select NrUnicoAsiento From "~DBO~".ASIENTOSCON Where NrTrans2 = '"~val(NR:2)~"' AND Modelo = '"~val(TA:1)~"' AND Estado IN ('E','A') AND (NrAsiento Is Null OR NrAsiento = '' OR NrAsiento = ' ') AND FechaValor = '"~IdxDate(Val(FV:1))~"' AND Vehiculo = '"~Val(VH:1)~"' "))
                ACN(CK:1, 0)
            ENDIF
         ENDIF
         ACT(MN:99, fbn('Moneda'))
         IF Val(CK:1) = 0
             If NoVacio(VAL(NR:1))
               Message(val(NR:1)~' - Modelo: '~val(TA:1))
             Else
               Message(val(NR:2)~' - Modelo: '~val(TA:1))
             EndIf
             SQL.GenerarAsientoOp(fbn('CodAsi'), val(NR:1),'','',Val(NA:1),Val(FV:1),Val(VH:1),,,,,,val(TI:1),,val(NR:2),,,,,fsys,Dialogo.Fecha1)              
             SQL.EXEC
         ENDIF
       Proximo
   Proximo
ELSE
   Message('No hay SALDOS para cortar.')
ENDIF
