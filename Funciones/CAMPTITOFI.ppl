**-Cargo datos para insertar en DETITOFIN-**
**-VALOR RESIDUAL-**
SQL.ADD(" Select  Codigo,MonedaEmision, Tipo TipoEspecie, Issuer, Alias1 as EspBanTotal, VTeorico as VTeorico, Cotiza ")
SQL.ADD(" From "~DBO~".ESPECIES ")
SQL.ADD(" Where Codigo = '"~&especie~"' ")
Recorrer SQL
    ACN(VT:1,fbn('VTeorico'))
proximo

let &cotiNiif CotizacionNIIF(&especie, val(FV:1), &book)

IF Vacio(&cotiNiif)
   let &precioNiif 0
ELSE
   let &precioNiif &cotiNiif.PrecioCotizacionDeterminada
ENDIF
**--Si no hay cotizacion NIIF hacemos lo mismo que POSICO
ACN(CO:1,COTIZACION(&especie,,,,val(FV:1),1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',&especie),,,,val(FV:1),25,SI,'ARP'))

if  &precioNiif=0
  let &precioNiif Val(CO:1)
endif

IF Not EqStr(&monedaAsiento,var('MONELOCA'))
    **-Datos para TC Contable reval
    let &revalOpVig 'NO'
    let &fechaRevaluo val(FV:1)
    let &monedaAConvertir &monedaAsiento
    let &monedaExpresion var('MONELOCA')
    let &valorContableValuado  &importeAcumuladoAsiento * #TCCONTABREVAL
ELSE
    let &valorContableValuado &importeAcumuladoAsiento
ENDIF
   
**-Busco si el dia anterior existe registro para esa Cuenta,NrOperacion, para sumarselo al importe acumulado del asiento-**
let &importeAsientoAnterior SQL("Select ValorContValuado FROM "~DBO~"."~&tablaInformada~" WHERE Fecha = '"~IdxDate(Habiles(val(FV:1),-1,'ARG',SI))~"' AND NrOperacion = '"~&nrOperacion~"' and CuentaContable = '"~&cuentaContable~"' and TipoRegistro ='A' ")

let &valorContableValuado &valorContableValuado + &importeAsientoAnterior

**-VALOR CONTABLE-**
If &valorContableValuado >= 0
     let &valorContable &cantidadDeOperacion
Else
    let &valorContable &cantidadDeOperacion *-1
EndIf       

**-VALOR RESIDUAL-**  
let &valorResidual iif(Val(VT:1) <> 0, Val(VT:1),1) * &valorContable
    
**-TIPO CUPON-**
let &nrCupon NrCupon2(&especie,val(fv:1))
let &tipoCupon SQL("Select TipoCupon from "~DBO~".AGENDACUPONES where NrCupon = '"~Fstr(&nrCupon, 0, 0)~"' AND Especie = '"~&especie~"' ") 
**1=Amort, 2 = Renta, 3 = Amort e renta, 0= Otros
If EqStr(&tipoCupon,'AMO')
   let &tipoCupon 1
Else
   If EqStr(&tipoCupon,'REN')
      let &tipoCupon 2
   Else
      If EqStr(&tipoCupon,'RYA')
         let &tipoCupon 3
      Else
         let &tipoCupon 0
      EndIf        
   EndIf
EndIf 

