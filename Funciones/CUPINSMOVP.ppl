*- Segun Corte Saldos o Movimientos las Fechas varian -> 
*- fv1: Fecha Valida para Movimiento del Corte 

*- mp1: Nro. Transaccion 
*- mp2: Fecha Movimiento  
*- mp3: Cliente 
*- mp4: Especie  
*- mp5: CallPut  
*- mp6: FechaEj  
*- mp7: PrecioEj  
*- mp8: Mercado
*- mp9: EnteCustodia  
*- mp10: Cantidad  
*- mp11: Formula  
*- mp12: Leyenda  
*- mp13: Bits  
*- mp14: NrSaldo   
*- mp15: NrGrupo
*- mp19: Cuenta 
*- mp20: NrGrupo2
*- mp22: Nro. de Movimiento   
*- mp27: Cupon

*--------------------------------------------------------------
*- Movimiento por la Especie Bajando el Cupon Anterior
* NrOperacion
ACT(mp:1, val(y:1))
* Fecha
ACD(mp:2, Dialogo.Fecha1)
* Cliente
ACT(mp:3, val(a:FAC))
* Especie
ACT(mp:4, Val(b:FAC))
* Mercado
ACT(mp:8, Val(c:FAC))
* EnteCustodia
ACT(mp:9 , Val(e:FAC))
* Importe
ACN(mp:10, -Val(g:FAC) )
* Leyenda
ACT(mp:12,'Corte de Cupon de '~val(mp:4)~' Cup. '~FStr(Val(c:2),0,0))
*- Seteo el tipo de movimiento Automatico-Manual
ACT(mp13,'AV' )
* NrSaldo
ACN(mp:14, Val(f:FAC))
* mp15: NrGrupo
ACN(mp:15, 0)
* Cuenta
ACT(mp:19, Val(d:FAC) )
*- mp20: NrGrupo2 
ACN(mp:20, 0)
* NrMov (Empieza con el numero de la primera fila)
ACN(mp:22, Val(z:1)+Val(x:4)*2-1)
* Cupon
ACT(mp:27, FStr(Val(c:2),0,0))

(."IMMOVPEND".)

IF Val(C:3) > 0
  *- Movimiento por la Especie Subiendo el Cupon Nuevo
  * Cantidad
  ACN(mp:10, Val(g:FAC) )
  * NrMov
  ACN(mp:22, Val(z:1)+Val(x:4)*2)
  * Cupon
  ACT(mp:27, FStr(Val(c:3),0,0))
  (."IMMOVPEND".)

endif
*--------------------------------------------------------------
