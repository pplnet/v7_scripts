***********************************************
* IN0002E - CANCELACION DE MOVIMIENTO         *
*                                             *
*            ORDEN DE PAGO                    *
*                                             *
* Invocada por el IN0002 - Interfase CAP-SIAF *
*                                             *
***********************************************

message( "ALTA MOV. c/O.PAGO" )

** -- Busco el estado de la O. Pago
ACT(zz:&i,SQL("SELECT /*+ RULE */ NrTrans FROM "~DBO~".TRANSACCIONES2 WHERE Vehiculo1 ='"~VAL(xa:&i)~"' AND Cantidad4 = "~Fstr(VAL(xd:&i),0,0) ) )

** -- Si no encontr¢ O. Pago ... aviso de advertencia
If Vacio(VAL(zz:&i))
   ACT(p:val(zd:1), "AVISO: no hallo O. Pago para cancelar" )
   ACN(zj:1, 1)
Else        
*   ACN(zx:&i, SQL(" SELECT COUNT(*) FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~TRIM(MIRT(VAL(zz:&i)))~"' ") )
   ACN(zx:&i, SQL(" SELECT /*+ RULE */ 1 FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~TRIM(MIRT(VAL(zz:&i)))~"' ") )
   ** -- La encontr¢ y no est  pagada
   If VAL(zx:&i) = 1
      ** -- Borro movimientos relacionados en MOVPENDIENTES
      message( 'Borrando MOVPENDIENTES ...' )
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".MOVPENDIENTES   WHERE NrOperacion='"~VAL(zz:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ** -- Borro movimientos relacionados en OPERACIONESBITS
      message( 'Borrando OPERACIONESBITS ...' )
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~VAL(zz:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      message( 'Borrando TRANSACCIONES2 ...' )
      ** -- Borro la transaccion en TRANSACCIONES2
      SQL.ADD("DELETE /*+ RULE */ "~DBO~".TRANSACCIONES2  WHERE NrTrans='"~VAL(zz:&i)~"' ")           
      SQL.NEW
      SQL.EXEC
      ACT(p:val(zd:1), "Registro procesado con exito !!!"  )
      SetFont(p:val(zd:1)..p:val(zd:1), 3)
   Else
   ** -- No encontr¢ y est  pagada ... aviso de advertencia
      ACT(p:val(zd:1), "AVISO: O. Pago ya esta pagado o anulado" )               
      ACN(zj:1, 1)
   EndIf
EndIf