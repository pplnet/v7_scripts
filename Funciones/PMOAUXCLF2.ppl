SQL.ADD("SELECT GE.Controlante, C.Codigo, C.RazonSocial, C.Sector, C.Alias7, C.ActComplementarias ")
*-I
*SQL.ADD("FROM "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS GE ")
*SQL.ADD("WHERE GE.Cliente =* C.Codigo and GE.TipoGrupo='BCRA' ")
SQL.ADD("FROM "~DBO~".CLIENTES C RIGHT OUTER JOIN  "~DBO~".GRUPOSECONOMICOS GE  ON GE.Cliente =* C.Codigo")
SQL.ADD("WHERE GE.TipoGrupo='BCRA' ")
*-F
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and C.Codigo='"~val(v1)~"' ")
endif
SQL.ADD("and exists(select 1 from LIMCONSUMIDOS where Limite in ('BCRAN','ACIDN','ACCON','BCRAG','ACIDG','ACCOG','ACMAN') and Cliente=C.Codigo) ")
SQL.ADD("ORDER BY 1,2 ")

ACN(af1,100)
ACN(ag1,100)
ACN(pp1,fac)

ACT(jj1,'ww')
ACN(pz1,0)

recorrer&k 3,19
 ACN(tt:&k, 0)
proximo

Recorrer SQL 
  if EsTerminal(fbn['Codigo'],Clientes)   

    ACT(z1, fbn['Codigo'])

    if not EqStr(fbn['Controlante'],val(jj1))

    if val(pz1)=1

      AgregarMarco(a:val(pp1)..r:fac-1,1,3)
      ACT(a:FAC, 'Total Grupo') 
      ACT(b:FAC, val(jj1))

    recorrer&j val(z2),val(z4)

      ACN(v:fac, val(af1))
      ACN(x:fac, val(ag1))
      ACN(w:fac, val(aa:val(w1))*val(v:fac)/100)
      ACN(y:fac, val(aa:val(w1))*val(x:fac)/100)

      *ah Total Exposicion No Garantizado diario
      *ai Total Exposicion Garantizado diario

      ACN(ah:fac, val(aj:&j-val(z2)+1))
      ACN(ai:fac, val(ak:&j-val(z2)+1))

      if val(ai:fac)>val(y:fac)
        ACN(bl:fac, val(ai:fac)-val(y:fac))
      endif
      if val(ah:fac)>val(w:fac)
        ACN(bk:fac, val(ah:fac)-val(w:fac))
      endif      

      *Muestro el Exceso Garantizado, sino el No Garantizado
      if val(bl:fac)>0
        ACN(&j-val(z2)+3:fac,val(bl:fac))
      else
        ACN(&j-val(z2)+3:fac,val(bk:fac))
      endif

    proximo

      ACN(af1,100)
      ACN(ag1,100)    

      recorrer&j 1,16
        ACN(aj:&j,0)
        ACN(ak:&j,0)
      proximo  

      recorrer&k 3,19
        SCN(tt:&k, val(&k:fac))
      proximo
      AgregarMarco(a:FAC..r:FAC,2,1)  
      SetFont(a:fac..r:fac,2)
      ifa
      ACN(pp1, fac)

    else
      ACN(pz1,1)
    endif

    endif   

    ACT(a:FAC, val(z1))
    ACT(b:fac, fbn['Controlante'])

    recorrer&j val(z2),val(z4)
  
    ACN(bc:FAC, LimConsumido(val(z1),'BCRAN','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(bd:FAC, LimConsumido(val(z1),'ACIDN','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(be:FAC, LimConsumido(val(z1),'ACCON','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(bf:FAC, LimConsumido(val(z1),'BCRAG','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(bg:FAC, LimConsumido(val(z1),'ACIDG','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(bh:FAC, LimConsumido(val(z1),'ACCOG','ARP',0,VAR('VEHICULODE'),,,,&j))
    ACN(bi:FAC, LimConsumido(val(z1),'ACMAN','ARP',0,VAR('VEHICULODE'),,,,&j))

    ACN(bj:FAC, Sum(bc:FAC..bi:FAC))

    if EqStr(fbn['ActComplementarias'],'VAC')
      * Vinculados con Act. Complementarias
      ACT(u:fac,'VAC')
      ACN(v:fac, val(ac:val(w1)))
      ACN(x:fac, val(ac:val(w1)+1))
    else
      if EqStr(fbn['ActComplementarias'],'VIN')
        * Vinculados sin Act. Complementarias
        ACT(u:fac,'VIN')
        ACN(v:fac, val(ac:val(w1)+2))
        ACN(x:fac, val(ac:val(w1)+3))
      else
        if EqStr(fbn['Alias7'],'CIG')
          * Corresponsales IGG
          ACT(u:fac,'CIG')
          ACN(v:fac, val(ac:val(w1)+4))
          ACN(x:fac, val(ac:val(w1)+5))
        else
          if EqStr(fbn['Alias7'],'CNIG')
            * Corresponsales NO IGG
            ACT(u:fac,'NIG')
            ACN(v:fac, val(ac:val(w1)+6))
            ACN(x:fac, val(ac:val(w1)+7))          
          else
            if EqStr(fbn['Sector'],'BAN') 
              * Financiero
              ACT(u:fac,'F')
              ACN(v:fac, val(ac:val(w1)+8))
              ACN(x:fac, val(ac:val(w1)+9))
            else
              * No Financiero
              ACT(u:fac,'NF')
              ACN(v:fac, val(ac:val(w1)+10))
              ACN(x:fac, val(ac:val(w1)+11))
            endif
          endif
        endif
      endif
    endif

    ACN(w:fac, val(aa:val(w1))*val(v:fac)/100)
    ACN(y:fac, val(aa:val(w1))*val(x:fac)/100)

    if val(bj:fac)>val(y:fac)
      ACN(bl:fac, val(bj:fac)-val(y:fac))
    endif
    SCN(ak:&j-val(z2)+1,val(bj:fac))

    if Sum(bc:fac..be:fac)+val(bi:fac)>val(w:fac)
      ACN(bk:fac, Sum(bc:fac..be:fac)+val(bi:fac)-val(w:fac))
    endif    
    SCN(aj:&j-val(z2)+1,Sum(bc:fac..be:fac)+val(bi:fac))     

    *Muestro el Exceso Garantizado, sino el No Garantizado
    if val(bl:fac)>0
      ACN(&j-val(z2)+3:fac,val(bl:fac))
    else
      ACN(&j-val(z2)+3:fac,val(bk:fac))
    endif

    proximo

    if val(v:fac)<val(af1)
      ACN(af1,val(v:fac))
    endif

    if val(x:fac)<val(ag1)
      ACN(ag1,val(x:fac))
    endif  
  
  ACT(jj1,fbn['Controlante'])     
  else
    dfa
  endif
   
proximo

  ifa
  AgregarMarco(a:val(pp1)..r:fac-1,1,3)         

  ACT(a:FAC, 'Total Grupo') 
  ACT(b:FAC, val(jj1))    

  recorrer&j val(z2),val(z4)

  ACN(v:fac, val(af1))
  ACN(x:fac, val(ag1))
  ACN(w:fac, val(aa:val(w1))*val(v:fac)/100)
  ACN(y:fac, val(aa:val(w1))*val(x:fac)/100)

  ACN(ah:fac, sum(bc:val(pp1)..be:fac-1)+sum(bi:val(pp1)..bi:fac-1))
  ACN(ai:fac, sum(bj:val(pp1)..bj:fac-1))

  if val(ai:fac)>val(y:fac)
    ACN(bl:fac, val(ai:fac)-val(y:fac))    
  endif
  if val(ah:fac)>val(w:fac)
    ACN(bk:fac, val(ah:fac)-val(w:fac))
  endif

  *Muestro el Exceso Garantizado, sino el No Garantizado
  if val(bl:fac)>0
    ACN(&j-val(z2)+3:fac,val(bl:fac))
  else
    ACN(&j-val(z2)+3:fac,val(bk:fac))
  endif

  proximo 

  recorrer&k 3,19
    SCN(tt:&k, val(&k:fac))
  proximo

  AgregarMarco(a:FAC..r:FAC,2,1)
  SetFont(a:fac..r:fac,2)


if FAC>=Val(w3)
  SetFilaActual(FAC+1)
  ACN(w4,FAC)
  ACT(a:fac, 'Totales')

  recorrer&k 3,19
    ACN(&k:fac, val(tt:&k))
  proximo

  SetFont(a:fac..r:fac,2)
  FormatoCeldas(c:fac..r:fac,Exe('F0R'))
  AgregarMarco(a:fac..r:fac,1,2,0)
endif 
