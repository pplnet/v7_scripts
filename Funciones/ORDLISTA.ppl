* Parámetros:
* O1: Longitud
* O2: Lista
*

Recorrer&i 1, Longitud(val(o:2)) / (val(o:1) + 1) 
   Recorrer&j 1, Longitud(val(O2)) / (val(o:1) + 1) - 1
      if GtStr(Copy(val(o:2), (&j-1)*(val(o:1)+1)+1, val(o:1)+1), Copy(val(o:2), &j*(val(o:1)+1)+1, val(o:1)+1) )
         ACT(o:2, Copy(val(o:2), 1, (&j-1)*(val(o:1)+1) ) ~ Copy(val(o:2), &j    *(val(o:1)+1)+1, val(o:1)+1) ~ Copy(val(o:2), (&j-1)*(val(o:1)+1)+1, val(o:1)+1) ~ Copy(val(o:2), &j*(val(o:1)+1)+val(o:1)+2, longitud(val(o:2))-&j*(val(o:1)+1)+val(o:1)+1)  )
      endif
   Proximo
Proximo

