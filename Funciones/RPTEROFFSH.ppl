Endif

SQL.ADD("order by 1,2,4,6 ")

RECORRER SQL

   If Val(bb:2010) = 0
      ACT(c:fac, "Prestamos terceros (Off-Shore)")
      SetFont(c:fac, 2)
      ACN(bb:2010, 1)
      SCN(f:2000, 1)
           
      *--> Seteo en cero la fila
      RECORRER&i Val(VT:1), Val(cc:1990)
         ACN(&i:fac, 0)
      PROXIMO

      SCN(fl:2, 1)
   EndIf

   ACN(mt:1001, FBN['Cant'])
   ACN(mt:2002, FBN['Int'])
   ACN(mt:3003, FBN['Imp'])
    
   If FBN['Precio2']=0 y Dialogo.Radio10=0
      ACT(NT:1000, fbn('NrOperacion'))
      *--> Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
      (.'RMONTOTOMV'.)
   Endif
   
   ACN(mt:1100, 0)    
   SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )
 
   *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
   If Val(cz:2) = 0
      ACN(mt:1200,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)) )
   Else
      ACN(mt:1200,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)) )
   EndIf

   If EqStr(FBN['Tipo'],'Cap')
      RECORRER&i Val(VT:1), Val(lm:1)
         If FBN['Fecha'] = Val(&i:Val(xx:2000))
            ACN(&i:Val(af:2000), Round(Val(&i:Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      PROXIMO

      RECORRER&i Val(lm:1)+1, Val(lm:2)-1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            ACN(&i:Val(af:2000), Round(Val(&i:Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      PROXIMO

      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         ACN(Val(lm:2):Val(af:2000), Round(Val(Val(lm:2):Val(af:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      EndIf

      *--> af2010: Nro. de Operacion que Mostro Capital
      ACT(af:2010,FBN['NrOperacion'])
   Else

      RECORRER&i Val(VT:1), Val(lm:1)
         If FBN['Fecha'] = Val(&i:Val(xx:2000))
            ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      PROXIMO
   
      RECORRER&i Val(lm:1)+1, Val(lm:2)-1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            ACN(&i:Val(f:2000), Round(Val(&i:Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
            ACN(&i:Val(i:2000), Round(Val(&i:Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         Endif
      PROXIMO

      *--> Para la ultima columna de meses
      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         ACN(Val(lm:2):Val(f:2000), Round(Val(Val(lm:2):Val(f:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(Val(lm:2):Val(i:2000), Round(Val(Val(lm:2):Val(i:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      EndIf
   EndIf
PROXIMO

