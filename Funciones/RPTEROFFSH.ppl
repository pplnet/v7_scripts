Message('Prestamos Terceros (off-shore) ')

SetFilaActual(Val(fl:2))
ACN(bb:2010,0)

SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo,")
*SQL.ADD(" DECODE(TipoOp, 'MMPOSM', C.Cantidad1, C.Cantidad4) /1000 Cant, DECODE(TipoOp, 'MMPOSM', C.Cantidad3, C.Cantidad5) /1000 Int, ")
*SQL.ADD(" DECODE(TipoOp, 'MMPOSM', C.Total3-C.Cantidad3, C.Cantidad5-C.Cantidad3) /1000 Imp,  ")
SQL.ADD(" (CASE WHEN TipoOp='MMPOSM' THEN C.Cantidad1 ELSE C.Cantidad4 END) /1000 Cant, (CASE WHEN TipoOp='MMPOSM' THEN C.Cantidad3 ELSE C.Cantidad5 END) /1000 Int, ")
SQL.ADD(" (CASE WHEN TipoOp='MMPOSM' THEN C.Total3-C.Cantidad3 ELSE C.Cantidad5-C.Cantidad3 END) /1000 Imp,  ")
SQL.ADD(" C.Cantidad1/1000 ImpAm,")
SQL.ADD(" C.Precio2,C.NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD(" Union All ")

*--> Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
*SQL.ADD("DECODE(TipoOp, 'MMPOSM', O.Cantidad, 0) /1000 Cant, 0 Int, DECODE(TipoOp, 'MMPOSM', O.TotalComisiones, 0) /1000 Imp,0 ImpAm, ")
SQL.ADD("(CASE WHEN TipoOp='MMPOSM' THEN O.Cantidad ELSE 0 END) /1000 Cant, 0 Int, (CASE WHEN TipoOp='MMPOSM' THEN O.TotalComisiones ELSE 0 END) /1000 Imp,0 ImpAm, ")
SQL.ADD("1 Precio2,C.NrCuota ")
SQL.ADD("from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD(" Union All ")

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo,")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp ,PrecioEj/1000 ImpAm,")
SQL.ADD(" 1 Precio2,0 NrCuota")
SQL.ADD("from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

*--> Capital si FechaInicio <> FechaConcertacion
SQL.ADD(" Union All ")

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
*SQL.ADD("DECODE(TipoOp, 'MMPCOS', O.Cantidad, 0) /1000 Cant, 0 Int, DECODE(TipoOp, 'MMPCOS', O.TotalComisiones, 0) /1000 Imp ,0 ImpAm,")
SQL.ADD("(CASE WHEN TipoOp='MMPCOS' THEN O.Cantidad ELSE 0 END) /1000 Cant, 0 Int, (CASE WHEN TipoOp='MMPCOS' THEN O.TotalComisiones ELSE 0 END) /1000 Imp ,0 ImpAm,")
SQL.ADD("1 Precio2, 0 NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
