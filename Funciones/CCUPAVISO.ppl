*-------- CCUPAVISO: Corte de Cupon - Aviso De Preliquidacion --------*

ACN(X:2, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU')))

SQL.Add("SELECT DISTINCT S.Cuenta, S.Mercado, S.EnteCustodia, S.CallPut, S.FechaEj, S.PrecioEj, S.Cliente, S.NrSaldo, C.RazonSocial, C.Direccion, C.CodigoPostal, C.Localidad, C.RecibePreaviso ")
SQL.Add("FROM "~DBO~".SALDOS S, "~DBO~".CLIENTES C ")
SQL.Add("WHERE S.EnteCustodia   = '"~Val(J:2)~"' ")
SQL.Add("AND   S.Especie        = '"~Dialogo.Especie1~"' ")
SQL.Add("AND   S.Cupon          = '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
SQL.Add("AND   S.NrSaldo        = '"~FStr(Val(X:2), 1, 0)~"' ")
SQL.Add("AND   S.Cliente        = C.Codigo ")
SQL.Add("AND   C.RecibePreaviso = 'SI' ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD("    AND S.Mercado = '"~Dialogo.Mercado1~"'")
EndIf


Recorrer SQL

    ACN(X:1, SaldoD(FBN['Cliente'], Val(B:2), FBN['CallPut'], FBN['FechaEj'], FBN['PrecioEj'], FBN['Mercado'], FBN['EnteCustodia'], FBN['Cuenta'], FBN['NrSaldo'], Val(G:2), FStr(Val(C:2), 1, 0)))

    Message(' Impresion de Preliquidacion '~fbn('Cliente')~' Saldo '~Fstr(val(x1),0,0))
    If [Val(X:1) <> 0]
       LinkearHoja('EMICCU', 1, Cliente1 = FBN['Cliente'], Especie1 = Val(B:2), Fecha1 = Val(G:2), Entero1 = Val(C:2), Precio1 = Val(K:2), Precio2 = Val(L:2), Precio5 = Val(E:3), Vehiculo1 = Val(J:2),Mercado1=Dialogo.Mercado1,Precio6=Val(p:2))
    EndIf       

