
* -----> Eliminacion De Blancos Redundantes

* ZB:01 ==> Valor A Controlar
* ZB:02 ==> Marca De Estado
* ZB:03 ==> Valor Devuelto

ACN(ZB:02, 0)
ACT(ZB:03, '')

If [NoVacio(Val(ZB:01))]

   Recorrer&i 1, Longitud(Val(ZB:01))

      If [EqStr(Copy(Val(ZB:01), &i, 1), ' ')]
         If [Val(ZB:02) = 0]
            ACN(ZB:02, 1)
         Else
            ACN(ZB:02, 2)
         EndIf
      Else
         ACN(ZB:02, 0)
      EndIf
      If [Val(ZB:02) < 2]
         ACT(ZB:03, Val(ZB:03) ~ Copy(Val(ZB:01), &i, 1)) 
      EndIf

   Proximo

EndIf