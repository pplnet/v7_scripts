ParkJuris:    'Juris.Park.'   ;18;3;1;NO;NO;;;;;if(Incluido(MERCADO,Var('MERPAREXT')),'EXT',if(Incluido(MERCADO,Var('MERPARLOC')),'ARG'))
ParkNrSaldo:  'Nr Saldo Park.';19;1;1;NO;NO;;;;;if(EqStr(CONTRAESPECIE,'ARP'),131,if(EqStr(CONTRAESPECIE,'USD'),if(EqStr(ParkTipoDol,'MEP'),132,if(EqStr(ParkTipoDol,'CAB'),133,0)),0))
