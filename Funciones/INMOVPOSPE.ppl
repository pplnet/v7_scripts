*- Recibe los datos en la celdas pp1 .. pp25
If EqStr(val(mp13),'AV')
   SQL.ADD("INSERT INTO "~DBO~".MOVPOSEJE (")
Else
   SQL.ADD("INSERT INTO "~DBO~".MOVPOSPEN (")
EndIf

SQL.ADD("FechaMov,Cliente,")
SQL.ADD("Vehiculo,Unidad,")
SQL.ADD("Centro,Sector,")
SQL.ADD("Sucursal,NrSaldo,")
SQL.ADD("Especie,")
SQL.ADD("CallPut,")
IF Incluido(val(pp5), 'CAL|PUT') 
   SQL.ADD("PrecioEj,FechaEj,")         
EndIf
SQL.ADD("Cantidad,Precio,")
SQL.ADD("Estrategia,Cartera,")
SQL.ADD("Book,Trader,")
SQL.ADD("TipoNegocio,NrOperacion,")
SQL.ADD("Cupon,Tipo,")
SQL.ADD("Responsable,TipoPosicion,")
SQL.ADD("Producto,GrupoEspecie,")
SQL.ADD("CarteraBCRA")

SQL.ADD(") Values (")

SQL.ADD(" '"~IdxDate(val(pp1))~"','"~val(pp2)~"',")
SQL.ADD(" '"~val(pp3)~"', '"~val(pp4)~"',")
SQL.ADD(" '"~val(pp5)~"', '"~val(pp6)~"',")
SQL.ADD(" '"~val(pp7)~"',"~Fstr(val(pp8),0,0)~",")
SQL.ADD(" '"~val(pp9)~"',")
SQL.ADD(" '"~val(pp12)~"', ")

IF Incluido(val(pp10), 'CAL|PUT') 
   SQL.ADD(" '"~Fstr(val(pp10),0,6)~"','"~IdxDate(val(pp11))~"', ")
EndIf

SQL.ADD(" "~Fstr(val(pp13),0,2)~", "~Fstr(val(pp14),0,9)~",")
SQL.ADD(" '"~val(pp15)~"','"~val(pp16)~"',")
SQL.ADD(" '"~val(pp17)~"','"~val(pp18)~"',")
SQL.ADD(" '"~val(pp19)~"','"~val(pp20)~"',")
SQL.ADD(" '"~val(pp21)~"','"~val(pp22)~"',")
SQL.ADD(" '"~val(pp23)~"','"~val(pp24)~"',")
SQL.ADD(" '"~val(pp25)~"','"~val(pp26)~"',")
SQL.ADD(" '"~val(pp27)~"' ")
SQL.ADD(" )")
SQL.NEW
SQL.EXEC
