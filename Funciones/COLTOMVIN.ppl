Recorrer&k 1, 15
   ACN(AA:&k, 0)
Proximo

ACN(fi11, 0)

*- Filas de Colocaciones Vinculadas
ACN(fa1, Val(fi2)+6)
ACN(fa2, Val(fi4))

*-- Colocaciones para el bloque INVERSIONES
SQL.ADD("SELECT O.Especie,O.Cliente1,O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       O.Plazo, O.Precio1 Tasa, O.Spread, O.Cantidad Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and ((O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
SQL.ADD("             or  (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0')) ")
SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("UNION ALL")
SQL.ADD("SELECT O.Especie, O.Cliente1, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       C.Plazo1 Plazo, C.Precio2 Tasa, C.Precio4 Spread, Sum(C.Cantidad1) Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCM') ")
SQL.ADD("       and  O.MB3 = '1' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*SQL.ADD("       and O.Especie in  ("~Pipe2Comillas(Val(ea1))~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("GROUP BY O.NrOperacion, O.Especie,O.Cliente1, O.FechaVto, O.TipoOp, C.Plazo1, C.Precio2, C.Precio4 ")

*- Para que me traiga todos intereses en el Corto Plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie,O.Cliente1,O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       O.Plazo, O.Precio1 Tasa, O.Spread, 0 Cant ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
   SQL.ADD("       and ((O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
   SQL.ADD("             or  (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0')) ")
   SQL.ADD("       and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie,O.Cliente1,O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       C.Plazo1 Plazo, C.Precio2 Tasa, C.Precio4 Spread, 0 Cant ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   > '"~IdxDate(Val(ea1))~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCCM') ")
   SQL.ADD("       and  O.MB3 = '1' ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
*   SQL.ADD("       and O.Especie in  ("~Pipe2Comillas(Val(ea1))~") ")
   SQL.ADD("GROUP BY O.NrOperacion, O.Especie,O.Cliente1, O.FechaVto, O.TipoOp, C.Plazo1, C.Precio2, C.Precio4 ")
Endif
SQL.ADD("ORDER BY 1,2 ")

*- az1  Contador de posiciones para linkear CARA
acn(az1,0)
acn(az3,1)
act(ea3,'')

Recorrer SQL

   *- Escribo en las columnas ba: Cliente bb: Capital en USD bc: Interes Devengado en USD para 
   *- Linkear desde CARA
   If Not EqStr(Val(ea3),FBN['Cliente1'])
      *- Verifico si no lo escribi antes para otra especie
      acn(az2,0)
      Recorrer&i 0,val(az1)
          If EqStr(val(ba:&i),FBN['Cliente1'])
             acn(az2,&i)                            
          EndIf
      Proximo

      If val(az2)<>0          
         acn(az1,val(az2))
      Else 
         scn(az1,1)
      EndIf
       
      *- Cotizacion
      ACT(ba:val(az1), FBN['Cliente1'] )
      ACT(ea3, FBN['Cliente1'] )     
   Endif

   If Not EqStr(Val(ea2),FBN['Especie'])
      *- Cotizacion
      ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONEEXTR')))
      ACT(ea2, FBN['Especie'] ) 
   Endif
   
   ACN(eb10, 0)

   If Dialogo.Radio2<>1
      **-- Calculo de Intereses Devengados
      ACT(eb1, FBN['TipoOp'])
      ACT(eb2, FBN['NrOperacion'])     
      (.'INTERESDEV'.)
   Endif

   *- Tasa: Tasa de Interes+Spread
   ACN(aa50, FBN['Tasa']+FBN['Spread'])   
 
   IF EqStr(FBN['Especie'],Var('MONELOCA'))
      *- Capital
      ACN(aa1, FBN['Cant'])
      *- Intereses Devengados
      ACN(aa2, Val(eb10))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, FBN['Cant']+Val(eb10))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa10, FBN['Cant']*Val(aa50)*FBN['Plazo'])
         ACN(aa11, FBN['Cant']*Val(aa50))
         ACN(aa12, FBN['Cant']*FBN['Plazo'])
      Endif
   Else
      *- Capital
      ACN(aa1, FBN['Cant']*Val(ea5))
      *- Intereses Devengados
      ACN(aa2, Val(eb10)*Val(ea5))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, (FBN['Cant']+Val(eb10))*Val(ea5))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa13, FBN['Cant']*Val(ea5)*Val(aa50)*FBN['Plazo'])
         ACN(aa14, FBN['Cant']*Val(ea5)*Val(aa50))
         ACN(aa15, FBN['Cant']*Val(ea5)*FBN['Plazo'])
      Endif
   Endif   

   If EqStr(FBN['Especie'],VAR('MONELOCA'))
      **- Colocaciones Vinculadas
      *- En Pesos
      SCN(b:Val(fa1), Val(aa1))
      SCN(c:Val(fa1), Val(aa2))
      SCN(d:Val(fa1), Val(aa3))
      *- Tasa Promedio
      SCN(e:Val(fa1), Val(aa10)/Val(aa12))
      *- Plazo Promedio
      SCN(f:Val(fa1), Val(aa10)/Val(aa11))
      
      *- Total en Pesos
      SCN(l:Val(fa1), Val(aa1))
      SCN(m:Val(fa1), Val(aa2))
      SCN(n:Val(fa1), Val(aa3))

      *- Total en Dolares
      SCN(o:Val(fa1), Val(aa1)/Dialogo.Precio1)
      SCN(p:Val(fa1), Val(aa2)/Dialogo.Precio1)
      SCN(q:Val(fa1), Val(aa3)/Dialogo.Precio1)

      *- Para Linkear al CARA 
      SCN(bb:val(az1), Val(aa1)/Dialogo.Precio1)
      SCN(bc:val(az1), Val(aa2)/Dialogo.Precio1)

      *- Total Activo
      SCN(b:Val(fa2), Val(aa1))
      SCN(c:Val(fa2), Val(aa2))
      SCN(d:Val(fa2), Val(aa3))
      SCN(l:Val(fa2), Val(aa1))
      SCN(m:Val(fa2), Val(aa2))
      SCN(n:Val(fa2), Val(aa3))
      SCN(o:Val(fa2), Val(aa1)/Dialogo.Precio1)
      SCN(p:Val(fa2), Val(aa2)/Dialogo.Precio1)
      SCN(q:Val(fa2), Val(aa3)/Dialogo.Precio1)
   Else
      *- En moneda extranjera expresado en dolares
      SCN(g:Val(fa1), Val(aa1))
      SCN(h:Val(fa1), Val(aa2))
      SCN(i:Val(fa1), Val(aa3))
      *- Tasa Promedio
      SCN(j:Val(fa1), Val(aa13)/Val(aa15))
      *- Plazo Promedio
      SCN(k:Val(fa1), Val(aa13)/Val(aa14))
        
      *- Total en Pesos
      SCN(l:Val(fa1), Val(aa1)*Dialogo.Precio1)
      SCN(m:Val(fa1), Val(aa2)*Dialogo.Precio1)
      SCN(n:Val(fa1), Val(aa3)*Dialogo.Precio1)

      *- Total en Dolares
      SCN(o:Val(fa1), Val(aa1))
      SCN(p:Val(fa1), Val(aa2))
      SCN(q:Val(fa1), Val(aa3))

      *- Para Linkear al CARA 
      SCN(bb:val(az1), Val(aa1))
      SCN(bc:val(az1), Val(aa2))
      
      *- Total Activo
      SCN(g:Val(fa2), Val(aa1))
      SCN(h:Val(fa2), Val(aa2))
      SCN(i:Val(fa2), Val(aa3))
      SCN(l:Val(fa2), Val(aa1)*Dialogo.Precio1)
      SCN(m:Val(fa2), Val(aa2)*Dialogo.Precio1)
      SCN(n:Val(fa2), Val(aa3)*Dialogo.Precio1)
      SCN(o:Val(fa2), Val(aa1))
      SCN(p:Val(fa2), Val(aa2))
      SCN(q:Val(fa2), Val(aa3))
   Endif
Proximo

SetFont(b:Val(fa1)..q:Val(fa1), 1)
SetFont(b:Val(fa2)..q:Val(fa2), 1)
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))

Recorrer&k 1, 15
   ACN(AA:&k, 0)
Proximo

*-- Filas de las Tomas Vinculadas en el Grupo PASIVAS
ACN(fa1, Val(fi6)+4)
ACN(fa2, Val(fi8))

*-- Tomas Vinculadas 
SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
SQL.ADD("       O.Plazo, O.Precio1 Tasa, O.Spread, O.Cantidad Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  (O.TipoOp In ('TEMIND') and  O.MB3 = '1') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("ORDER BY  1 ")

Recorrer SQL
   If Not EqStr(Val(ea2),FBN['Especie'])
      *- Cotizacion
      ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONEEXTR')))
      ACT(ea2, FBN['Especie'] ) 
   Endif

   ACN(eb10, 0)

   If Dialogo.Radio2<>1
      **-- Calculo de Intereses Devengados
      ACT(eb1, FBN['TipoOp'])
      ACT(eb2, FBN['NrOperacion'])

      (.'INTERESDEV'.)
   Endif

   *- Tasa: Tasa de Interes+Spread
   ACN(aa50, FBN['Tasa']+FBN['Spread'])   
   
   IF EqStr(FBN['Especie'],Var('MONELOCA'))
      *- Capital
      ACN(aa1, FBN['Cant'])
      *- Intereses Devengados
      ACN(aa2, Val(eb10))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, FBN['Cant']+Val(eb10))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa10, FBN['Cant']*Val(aa50)*FBN['Plazo'])
         ACN(aa11, FBN['Cant']*Val(aa50))
         ACN(aa12, FBN['Cant']*FBN['Plazo'])
      Endif
   Else
      *- Capital
      ACN(aa1, FBN['Cant']*Val(ea5))
      *- Intereses Devengados
      ACN(aa2, Val(eb10)*Val(ea5))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, (FBN['Cant']+Val(eb10))*Val(ea5))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa13, FBN['Cant']*Val(ea5)*Val(aa50)*FBN['Plazo'])
         ACN(aa14, FBN['Cant']*Val(ea5)*Val(aa50))
         ACN(aa15, FBN['Cant']*Val(ea5)*FBN['Plazo'])
      Endif
   Endif   
   
   If Incluido(FBN['Especie'],VAR('MONELOCA'))
      If DesciendeDeCliente(FBN['Cliente1'],'EMPRESAS')
         **- Tomas Vinculadas
         SCN(b:Val(fa1), Val(aa1))
         SCN(c:Val(fa1), Val(aa2))
         SCN(d:Val(fa1), Val(aa3))
         *- Tasa Promedio
         SCN(e:Val(fa1), Val(aa10)/Val(aa12))
         *- Plazo Promedio
         SCN(f:Val(fa1), Val(aa10)/Val(aa11))
         
         *- Total en Pesos
         SCN(l:Val(fa1), Val(aa1))
         SCN(m:Val(fa1), Val(aa2))
         SCN(n:Val(fa1), Val(aa3))
         
         *- Total en Dolares
         SCN(o:Val(fa1), Val(aa1)/Dialogo.Precio1)
         SCN(p:Val(fa1), Val(aa2)/Dialogo.Precio1)
         SCN(q:Val(fa1), Val(aa3)/Dialogo.Precio1)
          
         *- Total Pasivo
         SCN(b:Val(fa2), Val(aa1))
         SCN(c:Val(fa2), Val(aa2))
         SCN(d:Val(fa2), Val(aa3))
         SCN(l:Val(fa2), Val(aa1))
         SCN(m:Val(fa2), Val(aa2))
         SCN(n:Val(fa2), Val(aa3))
         SCN(o:Val(fa2), Val(aa1)/Dialogo.Precio1)
         SCN(p:Val(fa2), Val(aa2)/Dialogo.Precio1)
         SCN(q:Val(fa2), Val(aa3)/Dialogo.Precio1)
      Endif
   Else
      *- En momeda extranjera expresada en dolares
      If DesciendeDeCliente(FBN['Cliente1'],'EMPRESAS')
         SCN(g:Val(fa1), Val(aa1))
	 SCN(h:Val(fa1), Val(aa2))
	 SCN(i:Val(fa1), Val(aa3))
         *- Tasa Promedio
         SCN(j:Val(fa1), Val(aa13)/Val(aa15))
         *- Plazo Promedio
         SCN(k:Val(fa1), Val(aa13)/Val(aa14))
	          
         *- Total en Pesos
         SCN(l:Val(fa1), Val(aa1)*Dialogo.Precio1)
         SCN(m:Val(fa1), Val(aa2)*Dialogo.Precio1)
         SCN(n:Val(fa1), Val(aa3)*Dialogo.Precio1)
      
         *- Total en Dolares
         SCN(o:Val(fa1), Val(aa1))
         SCN(p:Val(fa1), Val(aa2))
         SCN(q:Val(fa1), Val(aa3))

         *- Total Activo
         SCN(g:Val(fa2), Val(aa1))
	 SCN(h:Val(fa2), Val(aa2))
         SCN(i:Val(fa2), Val(aa3))
         SCN(l:Val(fa2), Val(aa1)*Dialogo.Precio1)
         SCN(m:Val(fa2), Val(aa2)*Dialogo.Precio1)
         SCN(n:Val(fa2), Val(aa3)*Dialogo.Precio1)
         SCN(o:Val(fa2), Val(aa1))
         SCN(p:Val(fa2), Val(aa2))
         SCN(q:Val(fa2), Val(aa3))
      Endif
   Endif
Proximo

SetFont(b:Val(fa1)..q:Val(fa1), 1)
SetFont(b:Val(fa2)..q:Val(fa2), 1)
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))

Recorrer&k 1, 15
    ACN(AA:&k, 0)
Proximo

*- Filas tomas Vinculadas en el Grupo PASIVAS
ACN(fa1, Val(fi6)+4)
ACN(fa2, Val(fi8))

*- Tomas Vinculadas
SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       O.Plazo, O.Precio1 Tasa, O.Spread, O.Cantidad Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('VIMIND','VIMINM') ")
SQL.ADD("       and  O.MB3 = '1' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("UNION ALL")
SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       O.Plazo, O.Precio1 Tasa, 0 Spread, O.Cantidad Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("UNION ALL")
SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       C.Plazo1 Plazo, C.Precio2 Tasa, C.Precio4 Spread,  Sum(C.Cantidad1) Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCM')  ")
SQL.ADD("       and  O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("GROUP BY O.NrOperacion, O.Especie, O.FechaVto, O.TipoOp,C.Plazo1, C.Precio2 , C.Precio4 ")
*- Para que traiga todos los intereses en el Corto Plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       O.Plazo, O.Precio1 Tasa, 0 Spread, 0 Cant ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       C.Plazo1 Plazo, C.Precio2 Tasa, C.Precio4 Spread,  0 Cant ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   > '"~IdxDate(Val(ea1))~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCCM')  ")
   SQL.ADD("       and  O.MB3 = '0' ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD("GROUP BY O.NrOperacion, O.Especie, O.FechaVto, O.TipoOp,C.Plazo1, C.Precio2 , C.Precio4 ")
Endif
SQL.ADD("ORDER BY 1 ")

Recorrer SQL

   If Not EqStr(Val(ea2),FBN['Especie'])
      *- Cotizacion
      ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONEEXTR')))
      ACT(ea2, FBN['Especie'] ) 
   Endif
   
   ACN(eb10, 0)
   
   If Dialogo.Radio2<>1   
      **-- Calculo de Intereses Devengados
      ACT(eb1, FBN['TipoOp'])
      ACT(eb2, FBN['NrOperacion'])
      
      (.'INTERESDEV'.)
   Endif
   
   *- Tasa: Tasa de Interes+Spread
   ACN(aa50, FBN['Tasa']+FBN['Spread'])   
   
   IF EqStr(FBN['Especie'],Var('MONELOCA'))
      *- Capital
      ACN(aa1, FBN['Cant'])
      *- Intereses Devengados
      ACN(aa2, Val(eb10))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, FBN['Cant']+Val(eb10))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa10, FBN['Cant']*Val(aa50)*FBN['Plazo'])
         ACN(aa11, FBN['Cant']*Val(aa50))
         ACN(aa12, FBN['Cant']*FBN['Plazo'])
      Endif
   Else
      *- Capital
      ACN(aa1, FBN['Cant']*Val(ea5))
      *- Intereses Devengados
      ACN(aa2, Val(eb10)*Val(ea5))
      *- Total: Capital+Intereses Devengados
      ACN(aa3, (FBN['Cant']+Val(eb10))*Val(ea5))
      If Dialogo.Radio2=2
         *- Calculos para hallar la Tasa y el Plazo Promedio
         ACN(aa13, FBN['Cant']*Val(ea5)*Val(aa50)*FBN['Plazo'])
         ACN(aa14, FBN['Cant']*Val(ea5)*Val(aa50))
         ACN(aa15, FBN['Cant']*Val(ea5)*FBN['Plazo'])
      Endif
   Endif   
    
   If EqStr(FBN['Especie'], Var('MONELOCA'))
      *- Tomas Vinculadas
      *- En Pesos
      SCN(b:Val(fa1), Val(aa1))
      SCN(c:Val(fa1), Val(aa2))
      SCN(d:Val(fa1), Val(aa3))
      *- Tasa Promedio
      SCN(e:Val(fa1), Val(aa10)/Val(aa12))
      *- Plazo Promedio
      SCN(f:Val(fa1), Val(aa10)/Val(aa11))

      *- Total en Pesos
      SCN(l:Val(fa1), Val(aa1))
      SCN(m:Val(fa1), Val(aa2))
      SCN(n:Val(fa1), Val(aa3))
         
      *- Total en Dolares
      SCN(o:Val(fa1), Val(aa1)/Dialogo.Precio1)
      SCN(p:Val(fa1), Val(aa2)/Dialogo.Precio1)
      SCN(q:Val(fa1), Val(aa3)/Dialogo.Precio1)
      
      *- Total Activo
      SCN(b:Val(fa2), Val(aa1))
      SCN(c:Val(fa2), Val(aa2))
      SCN(d:Val(fa2), Val(aa3))
      SCN(l:Val(fa2), Val(aa1))
      SCN(m:Val(fa2), Val(aa2))
      SCN(n:Val(fa2), Val(aa3))
      SCN(o:Val(fa2), Val(aa1)/Dialogo.Precio1)
      SCN(p:Val(fa2), Val(aa2)/Dialogo.Precio1)
      SCN(q:Val(fa2), Val(aa3)/Dialogo.Precio1)
   Else
      *- En moneda extranjera expresado en dolares
      SCN(g:Val(fa1), Val(aa1))
      SCN(h:Val(fa1), Val(aa2))
      SCN(i:Val(fa1), Val(aa3))
      *- Tasa Promedio
      SCN(j:Val(fa1), Val(aa13)/Val(aa15))
      *- Plazo Promedio
      SCN(k:Val(fa1), Val(aa13)/Val(aa14))

      *- Total en Pesos
      SCN(l:Val(fa1), Val(aa1)*Dialogo.Precio1)
      SCN(m:Val(fa1), Val(aa2)*Dialogo.Precio1)
      SCN(n:Val(fa1), Val(aa3)*Dialogo.Precio1)
      
      *- Total en Dolares
      SCN(o:Val(fa1), Val(aa1))
      SCN(p:Val(fa1), Val(aa2))
      SCN(q:Val(fa1), Val(aa3))

      *- Total Pasivo
      SCN(g:Val(fa2), Val(aa1))
      SCN(h:Val(fa2), Val(aa2))
      SCN(i:Val(fa2), Val(aa3))     
      SCN(l:Val(fa2), Val(aa1)*Dialogo.Precio1)
      SCN(m:Val(fa2), Val(aa2)*Dialogo.Precio1)
      SCN(n:Val(fa2), Val(aa3)*Dialogo.Precio1)
      SCN(o:Val(fa2), Val(aa1))
      SCN(p:Val(fa2), Val(aa2))
      SCN(q:Val(fa2), Val(aa3))
   Endif
Proximo

SetFont(b:Val(fa1)..q:Val(fa1), 1)
SetFont(b:Val(fa2)..q:Val(fa2), 1)
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))

Recorrer&k 1, 15
    ACN(AA:&k, 0)
Proximo

*- posicion de Inicio del collateral
ACN(fa1, Val(fi18)-1)
ACN(fa2, Val(fi4))


*- fc1: Fila de Clientes  fe1: Fila de Empresa
ACN(fc1,val(fa1)  )
ACN(fe1,val(fi2)+6)

*- Colocaciones Vinculadas - Collateral Operaciones Derivadas
*- Operacion Vigente -> Tengo que sacar el devengado
SQL.ADD("SELECT O.Especie, O.FechaVto Fecha, O.Cliente1, O.TipoOp,O.NrOperacion,")
SQL.ADD("       O.Cantidad Cant, O.Plazo, O.Precio1 Tasa, O.Spread, RB8")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('TEMIND') ")
SQL.ADD("       and  O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD("ORDER BY 1, 3 ")

ACT(ea2,'')
ACT(ea6,'')

Recorrer SQL

   If Not EqStr(Val(ea2),FBN['Especie']) y NoVacio(val(ea2))
      Message('Entrando a TotalResu2')
      (.'TOTALRESU2'.)
   Endif

   If Not EqStr(Val(ea2),FBN['Especie'])
      If EqStr(FBN['Especie'],Var('MONELOCA'))
         ACN(ra2,0)
         ACN(ea5, 1)
      Else
         ACN(ra2,1)
         ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Var('MONEEXTR')))
      Endif
      ACT(ea2, FBN['Especie'] ) 
   Endif

   If Not EqStr(Val(ea6),FBN['Cliente1']) y Not DesciendeDeCliente(FBN['Cliente1'],'EMPRESAS')
      *- Cambio de Cliente que no sea empresa para collateral
      SCN(fc1, 1)
      ACT(a:val(fc1), BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', FBN['Cliente1']))
      SetFont(a:val(fc1), 2)
      ACT(ea6, FBN['Cliente1'])
   Endif

   *- Si son Empresas va a colocaciones vinculadas
   *- Si son Clientes van a Collateral
   If DesciendeDeCliente(FBN['Cliente1'],'EMPRESAS')
      ACN(fa1,val(fe1))
      Message(fbn('Cliente1')~' Empresas '~val(fa1))
   Else 
      ACN(fa1,val(fc1))
      Message(fbn('Cliente1')~' Clientes '~val(fa1))
   EndIf

   ACN(eb10, 0)

   If Dialogo.Radio2<>1
      **-- Calculo de Intereses Devengados hasta hoy
      ACT(eb1, FBN['TipoOp'])
      ACT(eb2, FBN['NrOperacion'])      
      (.'INTERESDEV'.)

      Message('*- Llamo a la funcion que me recupere los intereses devengado '~val(eb10))
      ACD(eb0, Dialogo.Fecha1)
      ACT(eb1, FBN['Especie'])
      ACT(eb2, Dialogo.Lista1)
      ACT(eb3, Val(ea6))
          
      (.'INTCOLLATE'.)
      Message('*- Llamo a la funcion que me recupere los intereses acumulados '~val(eb10))
   Endif

   message(fbn('NrOperacion')~' '~val(eb10))
   *- Tasa: Tasa de Interes+Spread
   ACN(aa50, FBN['Tasa']+FBN['Spread'])   

   *- Capital   
   ACN(fo1, FBN['Cant']*val(ea5))

   *- Intereses Devengados
   ACN(fo2, VAL(eb10)*val(ea5))

   If Dialogo.Radio2=2
      *- Calculos para hallar la Tasa y el Plazo Promedio
      ACN(fo5, val(fo1)*Val(aa50)*FBN['Plazo'])
      ACN(fo6, val(fo1)*Val(aa50))
      ACN(fo7, val(fo1)*FBN['Plazo'])
   Endif   
  
   (.'TOTALRESU'.)
Proximo

If NoVacio(val(ea2))
   (.'TOTALRESU2'.)
EndIf


