SQL.ADD("select * from ( ")
SQL.ADD("SELECT S1.Especie, E.Nombre, SUM(S1.Saldo) saldo ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK)  ")
SQL.ADD("     INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("           ON E.Codigo = S1.Especie ")
SQL.ADD("     INNER JOIN "~DBO~".CUENTAS CU WITH (NOLOCK) ")
SQL.ADD("           ON CU.Codigo = S1.Cuenta ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("           ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND (S1.NrSaldo not in(121,227)) AND ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
SQL.ADD("WHERE ")
** AA 02-10-2024 Bind Control especies Monedas y Especies titulos a descartar
SQL.ADD("   E.Jerarquia like ('"~VAR('JERTITULOS')~"%')  and E.Codigo not in ("~Pipe2Comillas(VAR('ESPNOCNV'))~") AND ")
SQL.ADD("   S1.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("   S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(HABILES(Dialogo.Fecha1,-1,'ARG'))~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre ")
SQL.ADD("  ) S3")
SQL.ADD("  where Round(S3.Saldo,2) <> 0 ")
SQL.ADD("  ORDER BY S3.Especie")
watch(SQL.BATCH())