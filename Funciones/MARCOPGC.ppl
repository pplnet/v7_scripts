*- Selecciono las transaccion POSIO del dia.
SQL.ADD("SELECT Precio1 as  AuPGCporDepLoc,Precio2 as  DisPGCporDepLoc,Precio3 as  AuRetiroMonExt,Cambio1 as  DisDeposMonExt, ")
SQL.ADD(" Precio4 as  DisDesmbCredLocal,Precio5 as  AuTenenBilletes,Cambio2 as  DisTenenBilletes,")
SQL.ADD(" Cambio3 as  TransferalBCRA,PrecioEj  as  TransferdelBCRA,Cambio4 as  AuPGCVarTipoPase,")
SQL.ADD(" Cambio5 as  DisPGCVarTipoPase,Cantidad19 as  OtrosAu,Cantidad1 as  OtrosDis ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T WHERE ")
SQL.ADD(" Fecha1='"~IDXDATE(Dialogo.Fecha1)~"' AND TipoTr2='PGC' and Vehiculo1='"~Dialogo.Vehiculo1~"' ")

Recorrer SQL
