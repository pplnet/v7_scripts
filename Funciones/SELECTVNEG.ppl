   SQL.ADD("       B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("       O.Especie = '"~FBN['Codigo']~"' AND ")
   SQL.ADD("       O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("       (O.Cartera = 1 or (O.Cartera=-1 AND O.CanPosInv1>0)) AND ") 
   SQL.ADD("       ((O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("         (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("        ) OR ")
