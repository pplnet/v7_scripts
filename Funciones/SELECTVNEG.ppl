ACT(cz5, CotizaEn(FBN['Codigo']))

**- OPERACIONES DE TRADING Cartera=0 o (Cartera=-1 y CanPosTrad>0)
If Dialogo.Radio1=0 o Dialogo.Radio1=1
   SQL.ADD("SELECT O.TipoOp, O.ContraEspecie ContraEspecie, O.Cantidad, O.CanPosTrad as Cant1, (O.TotalNetoCli1*O.CanPosTrad)/O.Cantidad as TotalNetoCli1, ")
   SQL.ADD("       (O.TotalBrutoCli1*O.CanPosTrad)/O.Cantidad as TotalBrutoCli1, (O.TotalDerechos*O.CanPosTrad)/O.Cantidad as TotalDerechos, O.FechaVto  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("       B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("       O.Especie = '"~FBN['Codigo']~"' AND ")
   SQL.ADD("       O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("       (O.Cartera = 0 or (O.Cartera=-1 AND O.CanPosTrad>0)) AND ") 
   SQL.ADD("       ((O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("         (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("        ) OR ")
   SQL.ADD("        (O.FechaPago <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.TipoOp IN ('TIPA','TIPP', 'TIBCRA') ")
   SQL.ADD("       )) ")
   SQL.ADD(" UNION  ALL")
   SQL.ADD("SELECT O.TipoOp, O.ContraEspecie ContraEspecie, O.Cantidad, O.CanPosTrad as Cant1, ((O.TotalNetoCli1+O.TotalAux3+O.TotalIVA)*O.CanPosTrad)/O.Cantidad as TotalNetoCli1, ") 
   SQL.ADD("       (O.TotalBrutoCli1*O.CanPosTrad)/O.Cantidad as TotalBrutoCli1, (O.TotalDerechos*O.CanPosTrad)/O.Cantidad as TotalDerechos, O.FechaVto ") 
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("       B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("       O.Especie = '"~FBN['Codigo']~"' AND ")
   SQL.ADD("       O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("       (O.Cartera = 0 or (O.Cartera=-1 AND O.CanPosTrad>0)) AND ") 
   SQL.ADD("       O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
   SQL.ADD("       (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
Endif

**- OPERACIONES DE INVESTMENT <=6 Cartera=1 o (Cartera=-1 y CanPosInv1>0)
If Dialogo.Radio1=0 o Dialogo.Radio1=2
   If Dialogo.Radio1=0
      SQL.ADD(" UNION  ALL")
   Endif
   SQL.ADD("SELECT O.TipoOp, O.ContraEspecie ContraEspecie, O.Cantidad, O.CanPosInv1 as Cant1, (O.TotalNetoCli1*O.CanPosInv1)/O.Cantidad as TotalNetoCli1,")
   SQL.ADD("       (O.TotalBrutoCli1*O.CanPosInv1)/O.Cantidad as TotalBrutoCli1, (O.TotalDerechos*O.CanPosInv1)/O.Cantidad as TotalDerechos, O.FechaVto  ")
