   If Dialogo.Radio1=0
      SQL.ADD(" UNION  ALL")
   Endif
   SQL.ADD("SELECT O.TipoOp, O.ContraEspecie ContraEspecie, O.Cantidad, O.CanPosOSoc as Cant1,(O.TotalNetoCli1*O.CanPosOSoc)/O.Cantidad as TotalNetoCli1, ")
